    "info": {
        "id": "curantalk_ch01_01_001"
    },
    "entry":
    [
        { "location": "1/BGM"  , "narrator": "", "text": "M09"},
        { "location": "2/TALK" , "narrator": "前衛教育委員会", "text": "大事なのは個性だ！"},
        { "location": "3/TALK" , "narrator": "前衛教育委員会", "text": "そして、きみたちは個性がかぶっている！"},
        { "location": "4/TALK" , "narrator": "ルビィマセマティカ", "text": "なんだって？"},
        { "location": "5/TALK" , "narrator": "雷帝ディアナ", "text": "どこがかぶっているというのかしら"},
        { "location": "6/TALK" , "narrator": "前衛教育委員会", "text": "雷を出すところだよ！"},
        { "location": "7/TALK" , "narrator": "前衛教育委員会", "text": "両方とも雷系クランとしてキャラがかぶっているんだ！"},
        { "location": "8/TALK" , "narrator": "前衛教育委員会", "text": "だから、二人ともプラスアルファで何か個性がほしいよね"},
        { "location": "9/TALK" , "narrator": "前衛教育委員会", "text": "さあ、新たな個性を見つけよう！"},
        { "location": "10/TALK", "narrator": "ルビィマセマティカ", "text": "いや、雷といってもいろいろあるしさ"},
        { "location": "11/TALK", "narrator": "雷帝ディアナ", "text": "そうだよ、一概に一緒というわけではないんだよ"},
        { "location": "12/TALK", "narrator": "前衛教育委員会", "text": "どう違うのさ？"},
        { "location": "13/TALK", "narrator": "雷帝ディアナ", "text": "電流が流れたときの感覚とかだね"},
        { "location": "14/TALK", "narrator": "ルビィマセマティカ", "text": "そうそう、雷を落とす人によって結構違うんだよ"},
        { "location": "15/TALK", "narrator": "ルビィマセマティカ", "text": "ためしに雷をくらってみるかい？"},
        { "location": "16/TALK", "narrator": "雷帝ディアナ", "text": "それがいいね。　二人の雷をくらべてみよう"},
        { "location": "17/TALK", "narrator": "前衛教育委員会", "text": "え？　え？"},
        { "location": "18/TALK", "narrator": "雷帝ディアナ", "text": "よーし、それーっ！"},
        { "location": "19/TALK", "narrator": "前衛教育委員会", "text": "ぐ、ぐえぇぇぇぇぇ！！！"},
        { "location": "20/TALK", "narrator": "ルビィマセマティカ", "text": "よし、次はアタシだよ！"},
        { "location": "21/TALK", "narrator": "前衛教育委員会", "text": "オ、オアァァァァ！！"},
        { "location": "22/TALK", "narrator": "ルビィマセマティカ", "text": "どうだい？　違いがわかったかい？"},
        { "location": "23/TALK", "narrator": "前衛教育委員会", "text": "い、いや……まったく……"},
        { "location": "24/TALK", "narrator": "雷帝ディアナ", "text": "それじゃあもういっかい……"},
        { "location": "25/TALK", "narrator": "前衛教育委員会", "text": "ストーップ！　ストーップ！"},
        { "location": "26/TALK", "narrator": "前衛教育委員会", "text": "わかったわかった！　雷にもいろいろあるんだね！"},
        { "location": "27/TALK", "narrator": "前衛教育委員会", "text": "きみたちはそれぞれ違う個性がある……！"},
        { "location": "28/TALK", "narrator": "ルビィマセマティカ", "text": "そういうことさ"},
        { "location": "29/TALK", "narrator": "雷帝ディアナ", "text": "で、どっちのほうがいい雷だった？"},
        { "location": "30/TALK", "narrator": "前衛教育委員会", "text": "え……？　いやどっちも、ただただシビれるだけで……"},
        { "location": "31/TALK", "narrator": "雷帝ディアナ", "text": "そんなはずはないわ！　私の雷のほうが強いに決まってる！"},
        { "location": "32/TALK", "narrator": "ルビィマセマティカ", "text": "いや、アタシの雷のほうがビリビリするに決まってるよ！"},
        { "location": "33/TALK", "narrator": "ルビィマセマティカ", "text": "よし、もう一回受けてみな！"},
        { "location": "34/TALK", "narrator": "前衛教育委員会", "text": "え、ちょっと……"},
        { "location": "35/TALK", "narrator": "前衛教育委員会", "text": "ギャアァァァァーー！"},
        { "location": "36/TALK", "narrator": "雷帝ディアナ", "text": "私も行くわ！　えい！"},
        { "location": "37/TALK", "narrator": "前衛教育委員会", "text": "あばばばばばば！！"},
        { "location": "38/TALK", "narrator": "前衛教育委員会", "text": "（や、やっぱり二人とも似てるよ……）"}
    ]
}
