{
    "dir": "curantalk",
    "type": "curan_talk",
    "info": {
        "id": "curantalk_ch01_05_015"
    },
    "entry":
    [
        { "location": "1/BGM"  , "narrator": "", "text": "M09"},
        { "location": "2/TALK" , "narrator": "らんちゅうさん", "text": "今日も朝からゆったりおさんぽ……"},
        { "location": "3/TALK" , "narrator": "らんちゅうさん", "text": "ん……何か居る……？"},
        { "location": "4/TALK" , "narrator": "らんちゅうさん", "text": "…………"},
        { "location": "5/TALK" , "narrator": "らんちゅうさん", "text": "あぁぁぁぁぁ！！　猫だァァァァ！！"},
        { "location": "6/TALK" , "narrator": "らんちゅうさん", "text": "猫が……ッ！　寝転んでいる……ッ！！"},
        { "location": "7/TALK" , "narrator": "らんちゅうさん", "text": "こ、殺されるっ……！"},
        { "location": "8/TALK" , "narrator": "大豊＠ちー太", "text": "何か大きな声が聞こえたけどどうし……"},
        { "location": "9/TALK" , "narrator": "大豊＠ちー太", "text": "チューーーー！！　猫でチューーーっ！！"},
        { "location": "10/TALK", "narrator": "らんちゅうさん", "text": "ひ、ひぃぃぃ……"},
        { "location": "11/TALK", "narrator": "大豊＠ちー太", "text": "も、もう駄目でチュ……おしまいでチュ……"},
        { "location": "12/TALK", "narrator": "かおりん", "text": "何か大きな声が聞こえましたがどうしましたの？"},
        { "location": "13/TALK", "narrator": "かおりん", "text": "あら、可愛い猫ですわね"},
        { "location": "14/TALK", "narrator": "らんちゅうさん", "text": "か、可愛い……？"},
        { "location": "15/TALK", "narrator": "大豊＠ちー太", "text": "猫を可愛いと……？　狂気……！　狂気でチュ……！"},
        { "location": "16/TALK", "narrator": "かおりん", "text": "ふふ、ごろーんってしてる姿に癒されますわ"},
        { "location": "17/TALK", "narrator": "らんちゅうさん", "text": "手を出しちゃ……危ない……"},
        { "location": "18/TALK", "narrator": "大豊＠ちー太", "text": "あれは罠でチュ。　だらけてるように見せて油断させる気でチュ"},
        { "location": "19/TALK", "narrator": "かおりん", "text": "罠だなんて、そんなことないですわ"},
        { "location": "20/TALK", "narrator": "らんちゅうさん", "text": "猫を抱え上げた……！"},
        { "location": "21/TALK", "narrator": "大豊＠ちー太", "text": "あの猛獣を……！？　恐るべしでチュ……"},
        { "location": "22/TALK", "narrator": "かおりん", "text": "ふふ、ゴロゴロ言ってますわ"},
        { "location": "23/TALK", "narrator": "かおりん", "text": "頭を撫でちゃいましょう"},
        { "location": "24/TALK", "narrator": "かおりん", "text": "あらっ"},
        { "location": "25/TALK", "narrator": "大豊＠ちー太", "text": "ああっ！　猫がかおりんの手を"},
        { "location": "26/TALK", "narrator": "らんちゅうさん", "text": "噛んだ……！"},
        { "location": "27/TALK", "narrator": "かおりん", "text": "甘噛みですわ。　痛くありませんのよ"},
        { "location": "28/TALK", "narrator": "らんちゅうさん", "text": "やっぱり……恐ろしい生き物……！"},
        { "location": "29/TALK", "narrator": "大豊＠ちー太", "text": "全ては相手を油断させるための演技だったでチュ！"},
        { "location": "30/TALK", "narrator": "らんちゅうさん", "text": "やっぱり猫にはかかわるべきじゃない……！"},
        { "location": "31/TALK", "narrator": "かおりん", "text": "二人ともおおげさですわね"},
        { "location": "32/TALK", "narrator": "らんちゅうさん", "text": "手を噛まれてなお、この余裕……"},
        { "location": "33/TALK", "narrator": "らんちゅうさん", "text": "かおりんは……地上最強の存在かも……"},
        { "location": "34/TALK", "narrator": "大豊＠ちー太", "text": "か、かおりんには逆らえないでチュね"},
        { "location": "35/TALK", "narrator": "かおりん", "text": "二人とも触ってみるといいですわ"},
        { "location": "36/TALK", "narrator": "らんちゅうさん", "text": "わああ、近づけないで～"},
        { "location": "37/TALK", "narrator": "大豊＠ちー太", "text": "ぎゃあああ"},
        { "location": "38/TALK", "narrator": "かおりん", "text": "きっと猫の良さがわかりますのよ"},
        { "location": "39/TALK", "narrator": "らんちゅうさん", "text": "あ……ああ……"},
        { "location": "40/TALK", "narrator": "大豊＠ちー太", "text": "ら、らんちゅうさんが気絶したでチュ！"}
    ]
}
