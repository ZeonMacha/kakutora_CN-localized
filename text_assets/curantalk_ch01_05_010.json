{
    "dir": "curantalk",
    "type": "curan_talk",
    "info": {
        "id": "curantalk_ch01_05_010"
    },
    "entry":
    [
        { "location": "1/BGM"  , "narrator": "", "text": "M09"},
        { "location": "2/TALK" , "narrator": "シャムシニア", "text": "……ふう、今日はこれくらいでいいかしら"},
        { "location": "3/TALK" , "narrator": "ミーア・フリム", "text": "すごいすごい！"},
        { "location": "4/TALK" , "narrator": "ミーア・フリム", "text": "私もそれくらい剣がうまく使えたらなぁ"},
        { "location": "5/TALK" , "narrator": "シャムシニア", "text": "あら、見ていたのね"},
        { "location": "6/TALK" , "narrator": "ミーア・フリム", "text": "すっごくかっこよかったよ！　まるでダンスみたいな華麗な動きだね！"},
        { "location": "7/TALK" , "narrator": "ミーア・フリム", "text": "私も剣を持ってるんだけど、全然うまく使えなくて……"},
        { "location": "8/TALK" , "narrator": "シャムシニア", "text": "あなたも剣を使えるようになりたいのね"},
        { "location": "9/TALK" , "narrator": "シャムシニア", "text": "もしよければ、私がすこしなら教えてあげるわよ"},
        { "location": "10/TALK", "narrator": "ミーア・フリム", "text": "え！？　いいの！？"},
        { "location": "11/TALK", "narrator": "シャムシニア", "text": "基礎的な動きならすぐに出来る様になるはずよ"},
        { "location": "12/TALK", "narrator": "ミーア・フリム", "text": "やったー！　ぜひお願いするよ！"},
        { "location": "13/TALK", "narrator": "シャムシニア", "text": "それじゃ、さっそく始めるわね"},
        { "location": "14/TALK", "narrator": "ミーア・フリム", "text": "よーし、頑張るぞ！"},
        { "location": "15/TALK", "narrator": "シャムシニア", "text": "ではまずこう動いて――"},
        { "location": "16/TALK", "narrator": "シャムシニア", "text": "そして、剣を振るッ！"},
        { "location": "17/TALK", "narrator": "ミーア・フリム", "text": "おお……"},
        { "location": "18/TALK", "narrator": "シャムシニア", "text": "さぁ、やってみて"},
        { "location": "19/TALK", "narrator": "ミーア・フリム", "text": "こう動いて……"},
        { "location": "20/BGM" , "narrator": "", "text": "▼SE：剣が飛んでいく音"},
        { "location": "21/TALK", "narrator": "シャムシニア", "text": "きゃあ！"},
        { "location": "22/TALK", "narrator": "ミーア・フリム", "text": "わわっ、手が滑っちゃった！"},
        { "location": "23/TALK", "narrator": "シャムシニア", "text": "危うく突き刺さるところだったわ"},
        { "location": "24/TALK", "narrator": "ミーア・フリム", "text": "ごめんなさい……もう一回やるね"},
        { "location": "25/TALK", "narrator": "ミーア・フリム", "text": "こう動いて――"},
        { "location": "26/BGM" , "narrator": "", "text": "▼SE：剣が飛んでいく音"},
        { "location": "27/TALK", "narrator": "シャムシニア", "text": "さっきとは違うタイミングで飛ばしてくるとは……やるわね"},
        { "location": "28/TALK", "narrator": "ミーア・フリム", "text": "ご、ごめんなさい"},
        { "location": "29/TALK", "narrator": "シャムシニア", "text": "あなたはまだ剣を持つには早いわね"},
        { "location": "30/TALK", "narrator": "ミーア・フリム", "text": "そ、そんな～"},
        { "location": "31/TALK", "narrator": "シャムシニア", "text": "まずは体を動かすことに慣れるために"},
        { "location": "32/TALK", "narrator": "シャムシニア", "text": "あなたにダンスを教えてあげる！"},
        { "location": "33/TALK", "narrator": "ミーア・フリム", "text": "え～、私は剣が上手くなりたいのに"},
        { "location": "34/TALK", "narrator": "シャムシニア", "text": "急がば回れ、よ。　さぁ、始めましょう"},
        { "location": "35/TALK", "narrator": "システム", "text": "～一週間後～"},
        { "location": "36/TALK", "narrator": "ミーア・フリム", "text": "はっ！　せいっ！　やっ！"},
        { "location": "37/TALK", "narrator": "九条カルレ", "text": "なんて美しいダンスなの！"},
        { "location": "38/TALK", "narrator": "頑固親父", "text": "ミーアちゃんのダンスはたまんねぇな！"},
        { "location": "39/TALK", "narrator": "シャムシニア", "text": "あなたは立派なダンサーになったわ……頑張ったわね"},
        { "location": "40/TALK", "narrator": "ミーア・フリム", "text": "はい！　先生！"},
        { "location": "41/TALK", "narrator": "ミーア・フリム", "text": "（あれ～？　何か忘れてる気がする……）"}
    ]
}
