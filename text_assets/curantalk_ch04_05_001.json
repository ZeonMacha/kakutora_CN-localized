{
    "dir": "curantalk",
    "type": "curan_talk",
    "info": {
        "id": "curantalk_ch04_05_001"
    },
    "entry":
    [
        { "location": "1/TALK" , "narrator": "プレイヤー", "text": "<color=red>β2用のサンプルイベントです</color>"},
        { "location": "2/TALK" , "narrator": "プレイヤー", "text": "<color=red>同一チャプターでは全て同じイベントが発生します</color>"},
        { "location": "3/TALK" , "narrator": "プレイヤー", "text": "<color=red>予めご了承ください</color>"},
        { "location": "4/TALK" , "narrator": "スタリオン", "text": "人生とはギャンブル！"},
        { "location": "5/TALK" , "narrator": "スタリオン", "text": "伸るか反るかの大博打よ！"},
        { "location": "6/TALK" , "narrator": "ディスミリオネア", "text": "ほう…お前も勝負の世界に生きる者か"},
        { "location": "7/TALK" , "narrator": "スタリオン", "text": "おうよ！"},
        { "location": "8/TALK" , "narrator": "スタリオン", "text": "負けると思えば負ける、勝つと思えば勝つ――"},
        { "location": "9/TALK" , "narrator": "スタリオン", "text": "昔の偉い人は良く言ったもんだ！"},
        { "location": "10/TALK", "narrator": "ディスミリオネア", "text": "勝利の味に酔いしれることが出来るのは"},
        { "location": "11/TALK", "narrator": "ディスミリオネア", "text": "己の勝ちを信じた者だけだ"},
        { "location": "12/TALK", "narrator": "ディスミリオネア", "text": "リスクのないゲームなど微塵の価値もない"},
        { "location": "13/TALK", "narrator": "スタリオン", "text": "お前さんいい事言うな！\n俺っちと馬が合いそうだ！"},
        { "location": "14/TALK", "narrator": "スタリオン", "text": "「馬だけに」ってな！"},
        { "location": "15/TALK", "narrator": "ディスミリオネア", "text": "俺は命を削るような勝負がしたいだけだ"},
        { "location": "16/TALK", "narrator": "ディスミリオネア", "text": "群れるつもりはない"},
        { "location": "17/TALK", "narrator": "スタリオン", "text": "これも何かの縁だ！"},
        { "location": "18/TALK", "narrator": "スタリオン", "text": "ここはいっちょ男同士、アソビにでも行くか！"},
        { "location": "19/TALK", "narrator": "ディスミリオネア", "text": "まずお前は人の話を聞け"},
        { "location": "20/TALK", "narrator": "スタリオン", "text": "まぁそう固い事言うなよ\n俺たち似た者同士だろ？"},
        { "location": "21/TALK", "narrator": "ディスミリオネア", "text": "俺は馬ではない…"},
        { "location": "22/TALK", "narrator": "ディスミリオネア", "text": "勝負の場で頼れるのは自分だけだ"},
        { "location": "23/TALK", "narrator": "ディスミリオネア", "text": "誰かに気を許せば足元を掬われるぞ"},
        { "location": "24/TALK", "narrator": "スタリオン", "text": "いやぁー仲間ってのはいいねぇ～！"},
        { "location": "25/TALK", "narrator": "スタリオン", "text": "今日の出会いに乾杯！"},
        { "location": "26/TALK", "narrator": "ディスミリオネア", "text": "だめだこいつ…話が通じん…"},
        { "location": "27/TALK", "narrator": "スタリオン", "text": "よっしゃ、行くぞー！\n出走だー！"},
        { "location": "28/TALK", "narrator": "ディスミリオネア", "text": "おい！\nちっ…少しだけ付き合ってやるか…"}
    ]
}
