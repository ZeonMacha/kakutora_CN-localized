    "dir": "curantalk",
    "type": "curan_talk",
    "info": {
        "id": "curantalk_ch01_05_011"
    },
    "entry":
    [
        { "location": "1/BGM"  , "narrator": "", "text": "M09"},
        { "location": "2/TALK" , "narrator": "ハンドレッドアイズ", "text": "…………"},
        { "location": "3/TALK" , "narrator": "D　・　H　・　A", "text": "あのマスクの下の素顔が気になる……"},
        { "location": "4/TALK" , "narrator": "ディオーネ", "text": "確かにどんな顔なのか気になりますね"},
        { "location": "5/TALK" , "narrator": "D　・　H　・　A", "text": "何とかして見ることが出来ないかしら……"},
        { "location": "6/TALK" , "narrator": "ディオーネ", "text": "奇襲して無理矢理剥がすというのはどうでしょう"},
        { "location": "7/TALK" , "narrator": "D　・　H　・　A", "text": "うーん……難しそうだけど……"},
        { "location": "8/TALK" , "narrator": "ドロップノッカー", "text": "あたしがハンマーであいつの仮面を吹っ飛ばしてあげるよ！！"},
        { "location": "9/TALK" , "narrator": "D　・　H　・　A", "text": "あっ、まずは策を練らないと……！"},
        { "location": "10/TALK", "narrator": "ドロップノッカー", "text": "そりゃあぁぁぁ～～～！！"},
        { "location": "11/TALK", "narrator": "ハンドレッドアイズ", "text": "……何奴！"},
        { "location": "12/TALK", "narrator": "ドロップノッカー", "text": "があぁぁぁっ！"},
        { "location": "13/TALK", "narrator": "D　・　H　・　A", "text": "頭をわしづかみにっ！？"},
        { "location": "14/TALK", "narrator": "ハンドレッドアイズ", "text": "……ふんっ！！"},
        { "location": "15/TALK", "narrator": "ドロップノッカー", "text": "ギャアアァァァ！"},
        { "location": "16/TALK", "narrator": "D　・　H　・　A", "text": "……なんということなの"},
        { "location": "17/TALK", "narrator": "D　・　H　・　A", "text": "ドロップノッカーが地面に埋められてしまった……"},
        { "location": "18/TALK", "narrator": "ディオーネ", "text": "恐ろしいパワーです……"},
        { "location": "19/TALK", "narrator": "D　・　H　・　A", "text": "無理矢理に剥がそうとするのは自分たちの命が危ないわね"},
        { "location": "20/TALK", "narrator": "パティスリア", "text": "じゃあ美味しいお菓子を渡して、食べる為に外させるというのはどうかしら！"},
        { "location": "21/TALK", "narrator": "D　・　H　・　A", "text": "それは良い作戦ね！"},
        { "location": "22/TALK", "narrator": "パティスリア", "text": "よーし、私の一番の自信作を持って行くよ"},
        { "location": "23/TALK", "narrator": "D　・　H　・　A", "text": "あのお菓子を食べる時に素顔が見れるはず……"},
        { "location": "24/TALK", "narrator": "パティスリア", "text": "ハンドレッドアイズさん～、お茶の時間にしましょう～"},
        { "location": "25/TALK", "narrator": "ハンドレッドアイズ", "text": "不要だ"},
        { "location": "26/TALK", "narrator": "パティスリア", "text": "えー、美味しいのに"},
        { "location": "27/TALK", "narrator": "ハンドレッドアイズ", "text": "私はそんなものに興味はない"},
        { "location": "28/TALK", "narrator": "ハンドレッドアイズ", "text": "私が求めるのは圧倒的な力のみ……"},
        { "location": "29/TALK", "narrator": "パティスリア", "text": "むむむ……"},
        { "location": "30/TALK", "narrator": "D　・　H　・　A", "text": "やはり一筋縄ではいかないわね"},
        { "location": "31/TALK", "narrator": "パティスリア", "text": "（こうなったらやはり強硬手段ね）"},
        { "location": "32/TALK", "narrator": "パティスリア", "text": "あ！？　あれは何！？"},
        { "location": "33/TALK", "narrator": "ハンドレッドアイズ", "text": "む……？"},
        { "location": "34/TALK", "narrator": "パティスリア", "text": "今だっ！　仮面を取るわ！"},
        { "location": "35/TALK", "narrator": "ハンドレッドアイズ", "text": "くっ、お前も仮面を狙ってくるか！"},
        { "location": "36/TALK", "narrator": "パティスリア", "text": "あぁぁれぇぇぇぇ～～……"},
        { "location": "37/TALK", "narrator": "ハンドレッドアイズ", "text": "……何なのだあいつらは……"},
        { "location": "38/TALK", "narrator": "D　・　H　・　A", "text": "素顔を見るのはあきらめた方がよさそうね……"},
        { "location": "39/TALK", "narrator": "ドロップノッカー", "text": "（誰か引っ張り出して……）"}
    ]
}
