{
    "dir": "curantalk",
    "type": "curan_talk",
    "info": {
        "id": "curantalk_ch01_05_017"
    },
    "entry":
    [
        { "location": "1/BGM"  , "narrator": "", "text": "M09"},
        { "location": "2/TALK" , "narrator": "ＮＮＭ４５", "text": "なんだなんだ！？"},
        { "location": "3/TALK" , "narrator": "ドロップノッカー", "text": "爆発！？"},
        { "location": "4/TALK" , "narrator": "りりえった", "text": "調合をしてたら失敗しちゃった～！"},
        { "location": "5/TALK" , "narrator": "ＮＮＭ４５", "text": "すごい煙が出てる！　やばいぞ！"},
        { "location": "6/TALK" , "narrator": "ドロップノッカー", "text": "これ吸うと絶対にヤバイやつだよー！"},
        { "location": "7/TALK" , "narrator": "ＮＮＭ４５", "text": "りりえった、早くなんとかしろ！"},
        { "location": "8/TALK" , "narrator": "りりえった", "text": "危険な煙が出ているので近づくことができないの～！"},
        { "location": "9/TALK" , "narrator": "ドロップノッカー", "text": "もう駄目だ、ここに居るみんなおしまいだ～！"},
        { "location": "10/TALK", "narrator": "ＮＮＭ４５", "text": "ん？　あそこにいるのは……"},
        { "location": "11/TALK", "narrator": "exec・cord", "text": "…………"},
        { "location": "12/TALK", "narrator": "ドロップノッカー", "text": "あのガスマスクなら……"},
        { "location": "13/TALK", "narrator": "りりえった", "text": "あの薬品の放つ煙にも耐えられるかも！"},
        { "location": "14/TALK", "narrator": "りりえった", "text": "おねがい！　あの薬品を処理してきて！"},
        { "location": "15/TALK", "narrator": "exec・cord", "text": "なんで私が……"},
        { "location": "16/TALK", "narrator": "ＮＮＭ４５", "text": "今近くにいるガスマスクをつけたクランはあんたしかいないんだ！"},
        { "location": "17/TALK", "narrator": "ドロップノッカー", "text": "そもそもガスマスクつけてる人がそんなにいないよ"},
        { "location": "18/TALK", "narrator": "りりえった", "text": "このままじゃここにいるみんなが危険なの！"},
        { "location": "19/TALK", "narrator": "exec・cord", "text": "仕方がない……今回は特別にいってあげる"},
        { "location": "20/TALK", "narrator": "りりえった", "text": "ありがとう！"},
        { "location": "21/TALK", "narrator": "ＮＮＭ４５", "text": "今回は特別っていうか、二度とこんな事態があってほしくないよ"},
        { "location": "22/TALK", "narrator": "ドロップノッカー", "text": "確かにそうだね……"},
        { "location": "23/TALK", "narrator": "exec・cord", "text": "じゃあ、行ってくる……"},
        { "location": "24/TALK", "narrator": "exec・cord", "text": "…………"},
        { "location": "25/TALK", "narrator": "exec・cord", "text": "まったく、人騒がせなやつだ……バラバラにしてやろうか"},
        { "location": "26/TALK", "narrator": "exec・cord", "text": "ん……・あそこで煙を出しているのが問題の薬品か"},
        { "location": "27/TALK", "narrator": "exec・cord", "text": "……来たのはいいけど、肝心の処理の仕方を聞いていない"},
        { "location": "28/TALK", "narrator": "exec・cord", "text": "一度戻るか、いや、またあいつらと話すのも面倒だ"},
        { "location": "29/TALK", "narrator": "exec・cord", "text": "さっと何かにつっこんでしまおう"},
        { "location": "30/TALK", "narrator": "exec・cord", "text": "よし、持ちあげる……"},
        { "location": "31/TALK", "narrator": "exec・cord", "text": "きゃああぁぁっ！！"},
        { "location": "32/TALK", "narrator": "りりえった", "text": "ん？今の声は……"},
        { "location": "33/TALK", "narrator": "ＮＮＭ４５", "text": "もしかして……exec・cord？"},
        { "location": "34/TALK", "narrator": "ドロップノッカー", "text": "すごいかわいい声だったよ？"},
        { "location": "35/TALK", "narrator": "ＮＮＭ４５", "text": "あんな恰好してるのに、なんか意外だな"},
        { "location": "36/TALK", "narrator": "ドロップノッカー", "text": "かわいいところあるんだね～"},
        { "location": "37/TALK", "narrator": "りりえった", "text": "新発見だね～！"},
        { "location": "38/TALK", "narrator": "exec・cord", "text": "お前達……人をあんな目に遭わせておいて随分楽しそうだな？"},
        { "location": "39/TALK", "narrator": "りりえった", "text": "ひ、ひええ～！　いつの間に！"},
        { "location": "40/TALK", "narrator": "ＮＮＭ４５", "text": "あ、いやその……"},
        { "location": "41/TALK", "narrator": "ドロップノッカー", "text": "逃げろ～！！"},
        { "location": "42/TALK", "narrator": "exec・cord", "text": "全員、八つ裂きにしてやる……ッ！"}
    ]
}
