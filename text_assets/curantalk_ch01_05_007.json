    "dir": "curantalk",
    "type": "curan_talk",
    "info": {
        "id": "curantalk_ch01_05_007"
    },
    "entry":
    [
        { "location": "1/BGM"  , "narrator": "", "text": "M09"},
        { "location": "2/TALK" , "narrator": "パティスリア", "text": "何をしているの？"},
        { "location": "3/TALK" , "narrator": "妖刀花梨白式", "text": "刀の美しさを保つために手入れしてるのさ"},
        { "location": "4/TALK" , "narrator": "妖刀花梨白式", "text": "これは毎日の日課なんだよ"},
        { "location": "5/TALK" , "narrator": "☆蔵人☆", "text": "武器ってのは自分の半身みたいなモノだからなぁ"},
        { "location": "6/TALK" , "narrator": "パティスリア", "text": "へー、大変なんだね。　でもお手入れをしっかりしてるだけあって凄く斬れそう……"},
        { "location": "7/TALK" , "narrator": "パティスリア", "text": "（そうだ、この刀なら柔らかーいケーキやお菓子も綺麗に切れるかも！）"},
        { "location": "8/TALK" , "narrator": "パティスリア", "text": "……ねぇ、その刀をちょっと貸してくれないかしら？"},
        { "location": "9/TALK" , "narrator": "妖刀花梨白式", "text": "ん？誰か斬りたい奴でも居るのかい？"},
        { "location": "10/TALK", "narrator": "パティスリア", "text": "人じゃなくてお菓子なんだけど……"},
        { "location": "11/TALK", "narrator": "妖刀花梨白式", "text": "お菓子作りにこの刀を使うって！？"},
        { "location": "12/TALK", "narrator": "☆蔵人☆", "text": "正気かよパティスリア！？"},
        { "location": "13/TALK", "narrator": "☆蔵人☆", "text": "刀を何だと思ってるんだよ！"},
        { "location": "14/TALK", "narrator": "パティスリア", "text": "いいじゃんー、刃物って点では包丁も刀も変わらないよ"},
        { "location": "15/TALK", "narrator": "☆蔵人☆", "text": "刃物って点以外は何もかもが違うけどな……"},
        { "location": "16/TALK", "narrator": "パティスリア", "text": "ちゃんと洗って返すから、おねがい！"},
        { "location": "17/TALK", "narrator": "☆蔵人☆", "text": "刀を食器用洗剤で洗う気か……"},
        { "location": "18/TALK", "narrator": "妖刀花梨白式", "text": "これは刀……それも妖刀なんだよ"},
        { "location": "19/TALK", "narrator": "妖刀花梨白式", "text": "お菓子作りに使うなんて聞いたこともないね"},
        { "location": "20/TALK", "narrator": "パティスリア", "text": "じゃあ私がその先駆者になるよ"},
        { "location": "21/TALK", "narrator": "☆蔵人☆", "text": "そんなものを先駆けてどうするんだよ"},
        { "location": "22/TALK", "narrator": "パティスリア", "text": "私に続いて大勢の妖刀パティシエが誕生していくんだよ"},
        { "location": "23/TALK", "narrator": "☆蔵人☆", "text": "ヤだよそんな職人が出てくるの……"},
        { "location": "24/TALK", "narrator": "パティスリア", "text": "ここで妖刀パティシエという道が切り開かれないのは"},
        { "location": "25/TALK", "narrator": "パティスリア", "text": "お菓子作りの発展にとって損失になるよ！"},
        { "location": "26/TALK", "narrator": "パティスリア", "text": "ほら、試しに私が作ったお菓子を一つ食べてみて"},
        { "location": "27/TALK", "narrator": "妖刀花梨白式", "text": "ふん……まあ、試しに食べてみるだけだよ"},
        { "location": "28/TALK", "narrator": "パティスリア", "text": "はい、どうぞ"},
        { "location": "29/TALK", "narrator": "妖刀花梨白式", "text": "…………こ、これは"},
        { "location": "30/TALK", "narrator": "妖刀花梨白式", "text": "美味しい……"},
        { "location": "31/TALK", "narrator": "パティスリア", "text": "でしょー！"},
        { "location": "32/TALK", "narrator": "パティスリア", "text": "その刀を貸してくれたらもっと沢山食べさせてあげるよ！"},
        { "location": "33/TALK", "narrator": "妖刀花梨白式", "text": "む、むう……"},
        { "location": "34/TALK", "narrator": "☆蔵人☆", "text": "ふん、その程度で大事な武器を貸すはずが……"},
        { "location": "35/TALK", "narrator": "妖刀花梨白式", "text": "わ、わかったよ……少しだけ貸そう……"},
        { "location": "36/TALK", "narrator": "パティスリア", "text": "やったー！"},
        { "location": "37/TALK", "narrator": "☆蔵人☆", "text": "落ちるのはええ！　ちょろすぎだろ！"},
        { "location": "38/TALK", "narrator": "妖刀花梨白式", "text": "べ、別にお菓子が美味しいと思ったわけじゃないよ！"},
        { "location": "39/TALK", "narrator": "妖刀花梨白式", "text": "こいつがあんまりにもうるさいから"},
        { "location": "40/TALK", "narrator": "妖刀花梨白式", "text": "さぁ……持って行きな"},
        { "location": "41/TALK", "narrator": "パティスリア", "text": "うん！　ありがとう！"},
        { "location": "42/TALK", "narrator": "妖刀花梨白式", "text": "（甘いお菓子なんてアタシには似合わないけど……）"},
        { "location": "43/TALK", "narrator": "妖刀花梨白式", "text": "（まぁ、たまにはいいかね）"}
    ]
}
