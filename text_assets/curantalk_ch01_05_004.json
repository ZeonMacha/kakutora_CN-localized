{
    "dir": "curantalk",
    "type": "curan_talk",
    "info": {
        "id": "curantalk_ch01_05_004"
    },
    "entry":
    [
        { "location": "1/BGM"  , "narrator": "", "text": "M09"},
        { "location": "2/TALK" , "narrator": "グラスハート", "text": "私のせいで心が壊れてしまった人もいました"},
        { "location": "3/TALK" , "narrator": "グラスハート", "text": "今となっては反省しています……"},
        { "location": "4/TALK" , "narrator": "グラスハート", "text": "ですので、今度は私が他のクランの心を救ってみせます"},
        { "location": "5/TALK" , "narrator": "グラスハート", "text": "『グラスハートお悩み相談室』開設です！"},
        { "location": "6/TALK" , "narrator": "グラスハート", "text": "さて、どんな悩めるクランが来るのやら……"},
        { "location": "7/TALK" , "narrator": "写楽亭宝矢", "text": "む……お悩み相談室……？"},
        { "location": "8/TALK" , "narrator": "グラスハート", "text": "さっそく相談者第一号が来たようですね"},
        { "location": "9/TALK" , "narrator": "写楽亭宝矢", "text": "相談に乗ってくれるというのなら話してみよう……"},
        { "location": "10/TALK", "narrator": "写楽亭宝矢", "text": "私は探偵をしているのだが、なぜか行く先々で確実に事件が発生するのだ"},
        { "location": "11/TALK", "narrator": "写楽亭宝矢", "text": "このままでは自分が外で出ると人を不幸にしているような気がしてしまう……"},
        { "location": "12/TALK", "narrator": "写楽亭宝矢", "text": "何かいい方法はないだろうか"},
        { "location": "13/TALK", "narrator": "グラスハート", "text": "なるほど……"},
        { "location": "14/TALK", "narrator": "グラスハート", "text": "そうですね、外に出ないというのはどうでしょうか"},
        { "location": "15/TALK", "narrator": "写楽亭宝矢", "text": "いや……それだと私が何もできないのだが"},
        { "location": "16/TALK", "narrator": "グラスハート", "text": "ですがそうすれば事件は起きないはずです"},
        { "location": "17/TALK", "narrator": "グラスハート", "text": "あなたは部屋から出ないでください"},
        { "location": "18/TALK", "narrator": "写楽亭宝矢", "text": "いや、しかし……"},
        { "location": "19/TALK", "narrator": "グラスハート", "text": "これにて解決ですね"},
        { "location": "20/TALK", "narrator": "写楽亭宝矢", "text": "何も根本的な解決にはなっていない……"},
        { "location": "21/TALK", "narrator": "グラスハート", "text": "さて、次の相談者は誰でしょう"},
        { "location": "22/TALK", "narrator": "シルキーちゃん", "text": "はあ……どうしたらいいのかな……"},
        { "location": "23/TALK", "narrator": "シルキーちゃん", "text": "ん……？お悩み相談室？"},
        { "location": "24/TALK", "narrator": "グラスハート", "text": "あら、相談員第二号ですね"},
        { "location": "25/TALK", "narrator": "シルキーちゃん", "text": "それじゃあせっかくだし……"},
        { "location": "26/TALK", "narrator": "シルキーちゃん", "text": "虫が苦手な人とどうすれば仲良くなれるのかを悩んでいるの～"},
        { "location": "27/TALK", "narrator": "シルキーちゃん", "text": "近づくだけで避けられちゃって……"},
        { "location": "28/TALK", "narrator": "グラスハート", "text": "ふむふむなるほど……"},
        { "location": "29/TALK", "narrator": "グラスハート", "text": "苦手なものが近づいて来たら避けるのは当然です"},
        { "location": "30/TALK", "narrator": "グラスハート", "text": "近づこうとするから余計に苦手に想われるのでは？"},
        { "location": "31/TALK", "narrator": "シルキーちゃん", "text": "そ、そこをなんとかしたいなぁ～って"},
        { "location": "32/TALK", "narrator": "グラスハート", "text": "相手は別に仲良くしたいなんて思っていませんよ"},
        { "location": "33/TALK", "narrator": "グラスハート", "text": "だから……諦めましょう！"},
        { "location": "34/TALK", "narrator": "シルキーちゃん", "text": "えー……"},
        { "location": "35/TALK", "narrator": "シルキーちゃん", "text": "仲良くしたいっていう悩みなのに、全然解決してないよ～"},
        { "location": "36/TALK", "narrator": "グラスハート", "text": "初めから考えなければ悩むこともありませんよ"},
        { "location": "37/TALK", "narrator": "シルキーちゃん", "text": "そ、そんな～何も解決になってないよ～"},
        { "location": "38/TALK", "narrator": "グラスハート", "text": "これで悩みは無くなったわね"},
        { "location": "39/TALK", "narrator": "写楽亭宝矢", "text": "彼女はクランとしての能力関係無しに心をへし折るのだな……"}
    ]
}
