    "info": {
        "id": "curantalk_ch01_05_020"
    },
    "entry":
    [
        { "location": "1/BGM"  , "narrator": "", "text": "M09"},
        { "location": "2/TALK" , "narrator": "緋之十鳥・程悠", "text": "今日は！　金曜日！"},
        { "location": "3/TALK" , "narrator": "緋之十鳥・程悠", "text": "明日は土曜日！　明後日は日曜日！"},
        { "location": "4/TALK" , "narrator": "緋之十鳥・程悠", "text": "さあ今から楽しい花金タイムだよー！！"},
        { "location": "5/TALK" , "narrator": "緋之十鳥・程悠", "text": "この時のために月曜日から頑張ってきたようなものだよ～"},
        { "location": "6/TALK" , "narrator": "緋之十鳥・程悠", "text": "さて、一緒に盛り上がるクランを探そうかな～"},
        { "location": "7/TALK" , "narrator": "緋之十鳥・程悠", "text": "パーッといっちゃうよ～！"},
        { "location": "8/TALK" , "narrator": "チュートリエル", "text": "そこのお前っ！"},
        { "location": "9/TALK" , "narrator": "緋之十鳥・程悠", "text": "なにやつっ！？"},
        { "location": "10/TALK", "narrator": "チュートリエル", "text": "週末だからといって浮かれるのは許さんっ！！"},
        { "location": "11/TALK", "narrator": "チュートリエル", "text": "そうやってハメを外すやつがいると風紀が乱れ――"},
        { "location": "12/TALK", "narrator": "チュートリエル", "text": "やがては学級崩壊に繋がるんだ！"},
        { "location": "13/TALK", "narrator": "緋之十鳥・程悠", "text": "べつにここ、学級じゃないよ！"},
        { "location": "14/TALK", "narrator": "チュートリエル", "text": "集団行動という点では同じだ"},
        { "location": "15/TALK", "narrator": "緋之十鳥・程悠", "text": "休みのときはゆっくり休むことも――"},
        { "location": "16/TALK", "narrator": "緋之十鳥・程悠", "text": "日々を頑張るうえで大事なことだよ！"},
        { "location": "17/TALK", "narrator": "チュートリエル", "text": "いいや！　そういうときにこそ"},
        { "location": "18/TALK", "narrator": "チュートリエル", "text": "気を引き締めて普段の生活を振り返るべきだ！"},
        { "location": "19/TALK", "narrator": "緋之十鳥・程悠", "text": "そんな風に気を張り詰めっぱなしだと"},
        { "location": "20/TALK", "narrator": "緋之十鳥・程悠", "text": "疲れちゃって実力も発揮出来なくなっちゃうよ"},
        { "location": "21/TALK", "narrator": "緋之十鳥・程悠", "text": "だからこうやって、金曜の夜から日曜の夜までの間に"},
        { "location": "22/TALK", "narrator": "緋之十鳥・程悠", "text": "月曜日から頑張れるだけのエネルギーを蓄えるんだよ！"},
        { "location": "23/TALK", "narrator": "チュートリエル", "text": "ええい……屁理屈を！"},
        { "location": "24/TALK", "narrator": "チュートリエル", "text": "とにかく！　風紀を乱す可能性をある行為を"},
        { "location": "25/TALK", "narrator": "チュートリエル", "text": "認めるわけにはいかない！"},
        { "location": "26/TALK", "narrator": "緋之十鳥・程悠", "text": "むう～！　このわからず屋め！"},
        { "location": "27/TALK", "narrator": "白騎士さん", "text": "あのー、盛り上がっているところ失礼しますが……"},
        { "location": "28/TALK", "narrator": "白騎士さん", "text": "私たちはクランなので仕事も学校もないですし"},
        { "location": "29/TALK", "narrator": "白騎士さん", "text": "曜日を気にする必要はないのでは？"},
        { "location": "30/TALK", "narrator": "緋之十鳥・程悠", "text": "た、確かに……！"},
        { "location": "31/TALK", "narrator": "緋之十鳥・程悠", "text": "土日というだけで浮かれた気分になっていたけど"},
        { "location": "32/TALK", "narrator": "緋之十鳥・程悠", "text": "普段と何も変わることないや……"},
        { "location": "33/TALK", "narrator": "チュートリエル", "text": "そうだな……戦闘のときは"},
        { "location": "34/TALK", "narrator": "チュートリエル", "text": "土日でも関係なく戦うことになるしな……"},
        { "location": "35/TALK", "narrator": "チュートリエル", "text": "確かに我々に曜日は関係ない"},
        { "location": "36/TALK", "narrator": "緋之十鳥・程悠", "text": "んー、それはそれでメリハリがなくて楽しみがないなあ"},
        { "location": "37/TALK", "narrator": "チュートリエル", "text": "曜日が曖昧だからこそ常に気を引き締めなければ！"},
        { "location": "38/TALK", "narrator": "緋之十鳥・程悠", "text": "いや、ハッキリと土日みたいなパーッとする日を設けるべきだよ！"},
        { "location": "39/TALK", "narrator": "白騎士さん", "text": "あらら……結局言い争いは終わらないのですね"}
    ]
}
