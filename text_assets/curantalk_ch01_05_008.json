    "dir": "curantalk",
    "type": "curan_talk",
    "info": {
        "id": "curantalk_ch01_05_008"
    },
    "entry":
    [
        { "location": "1/BGM"  , "narrator": "", "text": "M09"},
        { "location": "2/TALK" , "narrator": "スタリオン", "text": "やっぱ競馬は最終コーナーからの直線が最高に面白いぜ！"},
        { "location": "3/TALK" , "narrator": "スタリオン", "text": "……しかし外れたか。　まさか６着とはな"},
        { "location": "4/TALK" , "narrator": "スタリオン", "text": "いや、今回は運が悪かっただけだ。　狙いは間違っていなかった"},
        { "location": "5/TALK" , "narrator": "スタリオン", "text": "さて……次のレースは……"},
        { "location": "6/TALK" , "narrator": "ディスミリオネア", "text": "おまえも飽きないな"},
        { "location": "7/TALK" , "narrator": "スタリオン", "text": "アンタは……ディスミリオネアか"},
        { "location": "8/TALK" , "narrator": "スタリオン", "text": "たしかアンタもギャンブラーだったよな"},
        { "location": "9/TALK" , "narrator": "スタリオン", "text": "ギャンブル好き同士仲良くやろうぜ！"},
        { "location": "10/TALK", "narrator": "ディスミリオネア", "text": "失礼な……俺がやってたのは為替取引……『投資』だ！"},
        { "location": "11/TALK", "narrator": "ディスミリオネア", "text": "ギャンブルなんかと一緒にしないでくれ"},
        { "location": "12/TALK", "narrator": "スタリオン", "text": "金を賭けて、予想が当たれば金が増えるんだろ？"},
        { "location": "13/TALK", "narrator": "スタリオン", "text": "一緒だよ、一緒！"},
        { "location": "14/TALK", "narrator": "ディスミリオネア", "text": "違うッ！！"},
        { "location": "15/TALK", "narrator": "ディスミリオネア", "text": "俺がやっていたことは過去のデータや傾向を検証すれば取るべき手法がみえてくる『投資術』だ！"},
        { "location": "16/TALK", "narrator": "スタリオン", "text": "でも結局それで無一文になったんだろ？　ハズれたら失敗ってところもギャンブルといっしょじゃないか"},
        { "location": "17/TALK", "narrator": "ディスミリオネア", "text": "結果的にはそうなったが……！"},
        { "location": "18/TALK", "narrator": "ディスミリオネア", "text": "お前がやっているただの運勝負とは違うのだ！"},
        { "location": "19/TALK", "narrator": "スタリオン", "text": "何だって……？　競馬をただの運勝負だと？"},
        { "location": "20/TALK", "narrator": "スタリオン", "text": "競馬こそ過去のレースの成績や血統などを検証して勝ちを予想する高尚な趣味だ！"},
        { "location": "21/TALK", "narrator": "スタリオン", "text": "決してただの運勝負などではない！"},
        { "location": "22/TALK", "narrator": "ディスミリオネア", "text": "ならどちらが予想がうまいのか勝負しようじゃないか"},
        { "location": "23/TALK", "narrator": "スタリオン", "text": "おもしれぇ！　競馬で培った俺の力を見せてやる"},
        { "location": "24/TALK", "narrator": "ディスミリオネア", "text": "フン、所詮はただの運勝負……"},
        { "location": "25/TALK", "narrator": "ディスミリオネア", "text": "そんなモノで鍛えられた力がどれほどのものか"},
        { "location": "26/TALK", "narrator": "スタリオン", "text": "あとで吠え面をかくなよ！"},
        { "location": "27/TALK", "narrator": "ディスミリオネア", "text": "俺がお前に真の予想というものを見せてやる"},
        { "location": "28/TALK", "narrator": "シスターフール", "text": "でもふたりとも似た者同士だよねー"},
        { "location": "29/TALK", "narrator": "スタリオン", "text": "なっ、何を……！"},
        { "location": "30/TALK", "narrator": "ディスミリオネア", "text": "似た者同士だと……！？"},
        { "location": "31/TALK", "narrator": "ディスミリオネア", "text": "こんな奴と一緒にするなっ！　というか、突然話に入ってくるな"},
        { "location": "32/TALK", "narrator": "シスターフール", "text": "二人とも予想を外して人生大失敗したって所は一緒じゃんー"},
        { "location": "33/TALK", "narrator": "スタリオン", "text": "じんせい……"},
        { "location": "34/TALK", "narrator": "ディスミリオネア", "text": "だいしっぱい……"},
        { "location": "35/TALK", "narrator": "シスターフール", "text": "似た者同士仲良くしなよー。　じゃーねー"},
        { "location": "36/TALK", "narrator": "ディスミリオネア", "text": "…………"},
        { "location": "37/TALK", "narrator": "スタリオン", "text": "……俺達には夢があった。　そうだよな？"},
        { "location": "38/TALK", "narrator": "ディスミリオネア", "text": "……ああ"},
        { "location": "39/TALK", "narrator": "スタリオン", "text": "今日は飲もうぜ"},
        { "location": "40/TALK", "narrator": "ディスミリオネア", "text": "そうだな、付き合おう……"}
    ]
}
