    "entry":
    [
        { "location": "1/TALK" , "narrator": "プレイヤー", "text": "<color=red>β2用のサンプルイベントです</color>"},
        { "location": "2/TALK" , "narrator": "プレイヤー", "text": "<color=red>同一チャプターでは全て同じイベントが発生します</color>"},
        { "location": "3/TALK" , "narrator": "プレイヤー", "text": "<color=red>予めご了承ください</color>"},
        { "location": "4/TALK" , "narrator": "能面ピエロ", "text": "あ～、くっそだりぃ～"},
        { "location": "5/TALK" , "narrator": "能面ピエロ", "text": "愛されキャラを演じるのも楽じゃねーぜ"},
        { "location": "6/TALK" , "narrator": "影姫", "text": "おや？"},
        { "location": "7/TALK" , "narrator": "能面ピエロ", "text": "……ッ！"},
        { "location": "8/TALK" , "narrator": "能面ピエロ", "text": "ぽんぽーん♪　やあ影姫ちゃん、なんか用か～い？"},
        { "location": "9/TALK" , "narrator": "影姫", "text": "いや、ちょっとゲームの休憩に散歩してたら"},
        { "location": "10/TALK", "narrator": "影姫", "text": "君の意外な一面が見れただけだよ"},
        { "location": "11/TALK", "narrator": "能面ピエロ", "text": "あちゃ～、見られちゃったか～"},
        { "location": "12/TALK", "narrator": "影姫", "text": "どうしてそんな風にキャラを演じるんだい？"},
        { "location": "13/TALK", "narrator": "能面ピエロ", "text": "素を出すよりもこうしてた方が人付き合いが上手くいくんだよ～"},
        { "location": "14/TALK", "narrator": "影姫", "text": "ま、誰しも少なからず別の顔ってのはあるよね"},
        { "location": "15/TALK", "narrator": "能面ピエロ", "text": "トライナリー隊員のみやびも、一見不思議ちゃんだけど～"},
        { "location": "16/TALK", "narrator": "能面ピエロ", "text": "スゴ腕のハッカーって一面もあるしね～"},
        { "location": "17/TALK", "narrator": "影姫", "text": "部屋は散らかってて女子力無さそうなのに和食作るのは上手かったりね"},
        { "location": "18/TALK", "narrator": "能面ピエロ", "text": "そんな感じで私も本性を隠してるんだよ～♪"},
        { "location": "19/TALK", "narrator": "影姫", "text": "そんな感じなのかなぁ……"},
        { "location": "20/TALK", "narrator": "能面ピエロ", "text": "影姫ちゃんは何か裏の顔とかないの～？"},
        { "location": "21/TALK", "narrator": "影姫", "text": "私は表も裏もただのゲーム好きのクランだよ"},
        { "location": "22/TALK", "narrator": "影姫", "text": "私は一人でゆっくりゲームが出来ていればそれでいいのさー"},
        { "location": "23/TALK", "narrator": "能面ピエロ", "text": "マイペースだね～"},
        { "location": "24/TALK", "narrator": "影姫", "text": "能面ピエロも素を曝け出して気楽に生きようよ"},
        { "location": "25/TALK", "narrator": "能面ピエロ", "text": "私は本性なんて見せたら誰も寄ってこなくなってピエロなんて出来ないよ～"},
        { "location": "26/TALK", "narrator": "能面ピエロ", "text": "人に好かれるように自分を偽るのも上手く生きる術の一つだよ～♪"},
        { "location": "27/TALK", "narrator": "影姫", "text": "確かにその姿からは裏の顔は想像出来ないね"},
        { "location": "28/TALK", "narrator": "能面ピエロ", "text": "一応ピエロやってる以上は愛されるキャラじゃないと駄目だからね～"},
        { "location": "29/TALK", "narrator": "影姫", "text": "他人との関係のためにキャラを演じるという点に置いて"},
        { "location": "30/TALK", "narrator": "影姫", "text": "君とみやびは似ているけど"},
        { "location": "31/TALK", "narrator": "影姫", "text": "君の場合は本性を知ってもギャップ萌えは無いね"},
        { "location": "32/TALK", "narrator": "能面ピエロ", "text": "うるせぇ、別に萌えさせる為にやってんじゃねぇよ"},
        { "location": "33/TALK", "narrator": "影姫", "text": "素が出ちゃってるよ"}
    ]
}
