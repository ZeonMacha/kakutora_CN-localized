    "dir": "curantalk",
    "type": "curan_talk",
    "info": {
        "id": "curantalk_ch03_03_001"
    },
    "entry":
    [
        { "location": "1/TALK" , "narrator": "プレイヤー", "text": "<color=red>β2用のサンプルイベントです</color>"},
        { "location": "2/TALK" , "narrator": "プレイヤー", "text": "<color=red>同一チャプターでは全て同じイベントが発生します</color>"},
        { "location": "3/TALK" , "narrator": "プレイヤー", "text": "<color=red>予めご了承ください</color>"},
        { "location": "4/TALK" , "narrator": "ハングドール", "text": "何の音……？"},
        { "location": "5/TALK" , "narrator": "ライフリアン", "text": "驚かせてしまったか、銃の調整をしたから試し撃ちをしていたんだ"},
        { "location": "6/TALK" , "narrator": "ハングドール", "text": "そう……"},
        { "location": "7/TALK" , "narrator": "ハングドール", "text": "銃は使ったことがないからよくわからないの……"},
        { "location": "8/TALK" , "narrator": "ハングドール", "text": "当てるのは難しいの？"},
        { "location": "9/TALK" , "narrator": "ライフリアン", "text": "相手の動きと、風や距離、自分のコンディションなど、色々な要素が絡み合うからな"},
        { "location": "10/TALK", "narrator": "ライフリアン", "text": "一発の弾丸を放つのには、かなりの集中力を使う"},
        { "location": "11/TALK", "narrator": "ハングドール", "text": "鎖で相手を叩くより大変そうね……"},
        { "location": "12/TALK", "narrator": "ライフリアン", "text": "俺からすれば、それはそれで難しそうだけどな"},
        { "location": "13/TALK", "narrator": "ライフリアン", "text": "銃というのは自分の身体の一部でもあり、相棒でもある"},
        { "location": "14/TALK", "narrator": "ライフリアン", "text": "だからこうして、整備を怠ることはないのさ"},
        { "location": "15/TALK", "narrator": "ハングドール", "text": "あなたとガブリエラ、どちらの方が射撃が上手なのかしら……"},
        { "location": "16/TALK", "narrator": "ライフリアン", "text": "いつか勝負してみたいな"},
        { "location": "17/TALK", "narrator": "ハングドール", "text": "彼女は負けず嫌いだから勝負を持ち掛けたら応じてくれそうね……"},
        { "location": "18/TALK", "narrator": "ライフリアン", "text": "ガブリエラの腕前も相当なものだからな"},
        { "location": "19/TALK", "narrator": "ライフリアン", "text": "勝負がどうなるかは、やってみないとわからない"},
        { "location": "20/TALK", "narrator": "ハングドール", "text": "まだ１４歳なのに凄いわね……"},
        { "location": "21/TALK", "narrator": "ライフリアン", "text": "対決の時に備えて、俺も腕を磨くとしよう"},
        { "location": "22/TALK", "narrator": "ライフリアン", "text": "ガブリエラほどの能力なら"},
        { "location": "23/TALK", "narrator": "ライフリアン", "text": "その実力さえしっかり発揮することが出来れば"},
        { "location": "24/TALK", "narrator": "ライフリアン", "text": "戦闘でも狙いを外すことはないだろう"},
        { "location": "25/TALK", "narrator": "ハングドール", "text": "そうだわ……"},
        { "location": "26/TALK", "narrator": "ハングドール", "text": "鎖を巻き付けて相手を動けなくすれば"},
        { "location": "27/TALK", "narrator": "ハングドール", "text": "攻撃を外す心配も無いわ……"},
        { "location": "28/TALK", "narrator": "ライフリアン", "text": "見た目に反して荒っぽい事を言うんだな"},
        { "location": "29/TALK", "narrator": "ハングドール", "text": "私が相手を縛って、あなたが撃つ……"},
        { "location": "30/TALK", "narrator": "ハングドール", "text": "今度試してみましょう"},
        { "location": "31/TALK", "narrator": "ライフリアン", "text": "それは良い戦法だな"},
        { "location": "32/TALK", "narrator": "ハングドール", "text": "最強タッグの結成ね……"}
    ]
}
