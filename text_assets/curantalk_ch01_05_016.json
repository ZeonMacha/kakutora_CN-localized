    "dir": "curantalk",
    "type": "curan_talk",
    "info": {
        "id": "curantalk_ch01_05_016"
    },
    "entry":
    [
        { "location": "1/BGM"  , "narrator": "", "text": "M09"},
        { "location": "2/TALK" , "narrator": "ピオナ", "text": "あのクラン、どう見ても悪霊よね……"},
        { "location": "3/TALK" , "narrator": "ピオナ", "text": "悪霊を見過ごすわけにはいかない。私が祓ってみせるわ"},
        { "location": "4/TALK" , "narrator": "ピオナ", "text": "そこのあなた！　おとなしく成仏しなさい！"},
        { "location": "5/TALK" , "narrator": "月影らせん", "text": "え……？　急になんなの……"},
        { "location": "6/TALK" , "narrator": "ピオナ", "text": "覚悟ッ！！"},
        { "location": "7/TALK" , "narrator": "月影らせん", "text": "ひ、ひぃっ……"},
        { "location": "8/TALK" , "narrator": "ピオナ", "text": "…………"},
        { "location": "9/TALK" , "narrator": "月影らせん", "text": "…………？"},
        { "location": "10/TALK", "narrator": "ピオナ", "text": "私は洋風な退魔師だから"},
        { "location": "11/TALK", "narrator": "ピオナ", "text": "和風タイプの霊の祓い方がわからないわ……"},
        { "location": "12/TALK", "narrator": "月影らせん", "text": "そう言われても……"},
        { "location": "13/TALK", "narrator": "戸隠ダンゾウ", "text": "何の騒ぎかとおもってきてみれば……何してるの"},
        { "location": "14/TALK", "narrator": "戸隠ダンゾウ", "text": "っていうか霊じゃなくてクランだし……"},
        { "location": "15/TALK", "narrator": "戸隠ダンゾウ", "text": "お祓いはできないんじゃない？"},
        { "location": "16/TALK", "narrator": "ピオナ", "text": "でもどう見ても霊だし……霊が近くにいるのは落ち着かないわ"},
        { "location": "17/TALK", "narrator": "戸隠ダンゾウ", "text": "あなたはあなたでどう見ても退魔師だしね"},
        { "location": "18/TALK", "narrator": "ピオナ", "text": "そう、私は退魔師……だからこそ霊や悪魔には負けられないの"},
        { "location": "19/TALK", "narrator": "ピオナ", "text": "和風な除霊といえば――"},
        { "location": "20/TALK", "narrator": "ピオナ", "text": "そうだ、塩！　塩があった！"},
        { "location": "21/TALK", "narrator": "システム", "text": "～１時間後～"},
        { "location": "22/TALK", "narrator": "ピオナ", "text": "よし、大量の塩を用意したわ！"},
        { "location": "23/TALK", "narrator": "戸隠ダンゾウ", "text": "やめといたほうがいいよ"},
        { "location": "24/TALK", "narrator": "ピオナ", "text": "この私に退治出来ない霊や悪魔はいないの！"},
        { "location": "25/TALK", "narrator": "戸隠ダンゾウ", "text": "どうなっても知らないわよ"},
        { "location": "26/TALK", "narrator": "ピオナ", "text": "大丈夫、これだけあれば、反撃の余裕もあたえないわ"},
        { "location": "27/TALK", "narrator": "ピオナ", "text": "これで一撃よッ！"},
        { "location": "28/TALK", "narrator": "月影らせん", "text": "ちょ……！"},
        { "location": "29/TALK", "narrator": "月影らせん", "text": "…………"},
        { "location": "30/TALK", "narrator": "ピオナ", "text": "あ、あれ……？　効いてない？"},
        { "location": "31/TALK", "narrator": "月影らせん", "text": "私は霊じゃなくてクランなの……！"},
        { "location": "32/TALK", "narrator": "月影らせん", "text": "さすがにここまでされちゃ、そのまま返すわけにはいかないわ……！"},
        { "location": "33/TALK", "narrator": "ピオナ", "text": "あ、あー……やっぱ怒ってる？"},
        { "location": "34/TALK", "narrator": "戸隠ダンゾウ", "text": "そりゃ誰だって怒るよ……いきなり塩まみれにされたら"},
        { "location": "35/TALK", "narrator": "月影らせん", "text": "吹っ飛びなさい……！"},
        { "location": "36/TALK", "narrator": "ピオナ", "text": "きゃああぁぁぁぁ～～～！！"},
        { "location": "37/TALK", "narrator": "戸隠ダンゾウ", "text": "うわあ、すごい勢いで吹っ飛ばされていく……"},
        { "location": "38/TALK", "narrator": "月影らせん", "text": "ポルターガイスト現象よ……！"},
        { "location": "39/TALK", "narrator": "戸隠ダンゾウ", "text": "見た目和風なのにやることは洋風なのね"},
        { "location": "40/TALK", "narrator": "システム", "text": "一方、吹っ飛んだピオナは……"},
        { "location": "41/TALK", "narrator": "ピオナ", "text": "……ぐぬぬ"},
        { "location": "42/TALK", "narrator": "ピオナ", "text": "絶対にいつの日か成仏させてみせるわ……！"}
    ]
}
