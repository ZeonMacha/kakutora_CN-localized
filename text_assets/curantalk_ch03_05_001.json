    "dir": "curantalk",
    "type": "curan_talk",
    "info": {
        "id": "curantalk_ch03_05_001"
    },
    "entry":
    [
        { "location": "1/TALK" , "narrator": "プレイヤー", "text": "<color=red>β2用のサンプルイベントです</color>"},
        { "location": "2/TALK" , "narrator": "プレイヤー", "text": "<color=red>同一チャプターでは全て同じイベントが発生します</color>"},
        { "location": "3/TALK" , "narrator": "プレイヤー", "text": "<color=red>予めご了承ください</color>"},
        { "location": "4/TALK" , "narrator": "ウルトラドスコイ", "text": "ササササッ…"},
        { "location": "5/TALK" , "narrator": "ウルトラドスコイ", "text": "拙者はとある者から追われる身"},
        { "location": "6/TALK" , "narrator": "ウルトラドスコイ", "text": "人付き合いが苦手ゆえ今日も闇に紛れて影を潜めるでござる…"},
        { "location": "7/TALK" , "narrator": "ウルトラドスコイ", "text": "とは言え、ここは拙者だけの絶対安心プレイス"},
        { "location": "8/TALK" , "narrator": "ウルトラドスコイ", "text": "安息を邪魔されることはないでござる"},
        { "location": "9/TALK" , "narrator": "戸隠ダンゾウ", "text": "ササササッ…"},
        { "location": "10/TALK", "narrator": "戸隠ダンゾウ", "text": "この気配は！\nあの人が近くにいるわ！"},
        { "location": "11/TALK", "narrator": "戸隠ダンゾウ", "text": "今日こそあの人に振り向いてもらうんだから！"},
        { "location": "12/TALK", "narrator": "ウルトラドスコイ", "text": "ブルブル…なぜかは分からないけどなんとも言えない悪寒が…"},
        { "location": "13/TALK", "narrator": "ウルトラドスコイ", "text": "これはまさか、あの人がここまで…？"},
        { "location": "14/TALK", "narrator": "戸隠ダンゾウ", "text": "愛しのあの人はどこー！"},
        { "location": "15/TALK", "narrator": "戸隠ダンゾウ", "text": "見つけ次第今日も全力アタックよ！"},
        { "location": "16/TALK", "narrator": "ウルトラドスコイ", "text": "えええぇ…！"},
        { "location": "17/TALK", "narrator": "ウルトラドスコイ", "text": "拙者の絶対安心プレイスになんであの人が……"},
        { "location": "18/TALK", "narrator": "ウルトラドスコイ", "text": "そうだ、こうしてはいられない早く逃げるでござる…"},
        { "location": "19/TALK", "narrator": "戸隠ダンゾウ", "text": "恋する乙女パワーの前には多少の障害なんてなんのその！"},
        { "location": "20/TALK", "narrator": "戸隠ダンゾウ", "text": "あっ、あの後ろ姿は！"},
        { "location": "21/TALK", "narrator": "ウルトラドスコイ", "text": "ひぃっ…もう見つかった…"},
        { "location": "22/TALK", "narrator": "戸隠ダンゾウ", "text": "私の全力アタック受け取ってくださーい！！"},
        { "location": "23/TALK", "narrator": "ウルトラドスコイ", "text": "こ、こうなったら分身の術で凌ぐでござる…"},
        { "location": "24/TALK", "narrator": "戸隠ダンゾウ", "text": "あぁ！\nあの人がいっぱい！\n素敵！"},
        { "location": "25/TALK", "narrator": "ウルトラドスコイ", "text": "拙者はこの隙に逃げるでござる…"},
        { "location": "26/TALK", "narrator": "ウルトラドスコイ", "text": "ん？"},
        { "location": "27/TALK", "narrator": "戸隠ダンゾウ", "text": "あなたの熱い想い感じたわ！"},
        { "location": "28/TALK", "narrator": "戸隠ダンゾウ", "text": "私もそれに応えなきゃ！"},
        { "location": "29/TALK", "narrator": "ウルトラドスコイ", "text": "ひえぇ…！\nふ、増えてる…！"},
        { "location": "30/TALK", "narrator": "ウルトラドスコイ", "text": "勘弁してくだされ～～"},
        { "location": "31/TALK", "narrator": "戸隠ダンゾウ", "text": "あ、行っちゃった！"},
        { "location": "32/TALK", "narrator": "戸隠ダンゾウ", "text": "でも私、まだまだ諦めないわよーー！"}
    ]
}
