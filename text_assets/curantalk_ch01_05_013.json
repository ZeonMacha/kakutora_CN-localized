{
    "dir": "curantalk",
    "type": "curan_talk",
    "info": {
        "id": "curantalk_ch01_05_013"
    },
    "entry":
    [
        { "location": "1/BGM"  , "narrator": "", "text": "M09"},
        { "location": "2/TALK" , "narrator": "ファイアリリー", "text": "新しい花火がアイデアが思い浮かばないねぇ"},
        { "location": "3/TALK" , "narrator": "りりえった", "text": "何をしてるんですか？"},
        { "location": "4/TALK" , "narrator": "ファイアリリー", "text": "おや、りりえったかい。　新作の花火を考えているんだよ"},
        { "location": "5/TALK" , "narrator": "りりえった", "text": "へー、何か思いつきそうですか？"},
        { "location": "6/TALK" , "narrator": "ファイアリリー", "text": "んー、それがうまくいかないんだよねぇ"},
        { "location": "7/TALK" , "narrator": "ファイアリリー", "text": "変わった色や形の花火とかが作れればいいんだけどねぇ"},
        { "location": "8/TALK" , "narrator": "りりえった", "text": "それなら私の調合品を試してみますか？"},
        { "location": "9/TALK" , "narrator": "りりえった", "text": "不思議な光を出す薬品などもありますよ"},
        { "location": "10/TALK", "narrator": "ファイアリリー", "text": "おお、それは興味深いね"},
        { "location": "11/TALK", "narrator": "ファイアリリー", "text": "是非お願いしようかね"},
        { "location": "12/TALK", "narrator": "りりえった", "text": "わかりました！　それじゃあ作ってきますね！"},
        { "location": "13/TALK", "narrator": "ファイアリリー", "text": "ふふ、どんな花火が出来るか楽しみだな"},
        { "location": "14/TALK", "narrator": "システム", "text": "～翌日～"},
        { "location": "15/TALK", "narrator": "りりえった", "text": "出来ました！"},
        { "location": "16/TALK", "narrator": "ファイアリリー", "text": "おお、さっそく試してみよう"},
        { "location": "17/TALK", "narrator": "りりえった", "text": "では花火玉の中にこの薬品を入れてください"},
        { "location": "18/TALK", "narrator": "ファイアリリー", "text": "わかったよ！"},
        { "location": "19/TALK", "narrator": "ファイアリリー", "text": "よーし、新作の完成だ―！"},
        { "location": "20/TALK", "narrator": "りりえった", "text": "さあ、飛ばしてみましょう"},
        { "location": "21/TALK", "narrator": "ファイアリリー", "text": "いくぞー、それっ！！"},
        { "location": "22/TALK", "narrator": "りりえった", "text": "…………"},
        { "location": "23/TALK", "narrator": "りりえった", "text": "あれ？　飛ばない？"},
        { "location": "24/TALK", "narrator": "ファイアリリー", "text": "おかしいな……ちょっと様子を見てみよ――"},
        { "location": "25/TALK", "narrator": "ファイアリリー", "text": "わああぁぁ！！"},
        { "location": "26/TALK", "narrator": "りりえった", "text": "ぼ、暴発！？"},
        { "location": "27/TALK", "narrator": "ファイアリリー", "text": "なんか妙な液体が飛び散った！！"},
        { "location": "28/TALK", "narrator": "ファイアリリー", "text": "ひぇっ、当たった所が溶けてるよ"},
        { "location": "29/TALK", "narrator": "ファイアリリー", "text": "いったいどんな薬品を使ったんだい！？"},
        { "location": "30/TALK", "narrator": "りりえった", "text": "え、えへへー……"},
        { "location": "31/TALK", "narrator": "りりえった", "text": "実はまだ試したことがなかった調合品なの……"},
        { "location": "32/TALK", "narrator": "ファイアリリー", "text": "そんなものを使わせるんじゃないよ……"},
        { "location": "33/TALK", "narrator": "シルキーちゃん", "text": "ちょっと～！　羽が焦げちゃったじゃない。　何してるの！"},
        { "location": "34/TALK", "narrator": "ファイアリリー", "text": "ちょっと新作の花火を試していただけで……"},
        { "location": "35/TALK", "narrator": "シルキーちゃん", "text": "危ないからもう花火禁止！！"},
        { "location": "36/TALK", "narrator": "ファイアリリー", "text": "ええ～……これから何を生きがいに生きればいいんだ～！"}
    ]
}
