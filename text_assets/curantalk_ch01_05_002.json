{
    "dir": "curantalk",
    "type": "curan_talk",
    "info": {
        "id": "curantalk_ch01_05_002"
    },
    "entry":
    [
        { "location": "1/BGM"  , "narrator": "", "text": "M09"},
        { "location": "2/TALK" , "narrator": "プリンセスサーヴ", "text": "すろうべりぃさん、見つけましたよ"},
        { "location": "3/TALK" , "narrator": "すろうべりぃ", "text": "何か用……？わたしは今からダラダラするから忙しいんだけど"},
        { "location": "4/TALK" , "narrator": "プリンセスサーヴ", "text": "そんなに寝てばかりでは不健康になりますよ！　私と一緒に運動しましょう！"},
        { "location": "5/TALK" , "narrator": "すろうべりぃ", "text": "わたしは運動したほうが不健康になるからこのままでだいじょうぶ……"},
        { "location": "6/TALK" , "narrator": "プリンセスサーヴ", "text": "そういうわけにはいきません！　私も日頃からすろうべりぃさんのダラダラ加減は見るにたえないと思っていました"},
        { "location": "7/TALK" , "narrator": "すろうべりぃ", "text": "ひどい言われよう……"},
        { "location": "8/TALK" , "narrator": "プリンセスサーヴ", "text": "クランとはいえ、あまりにもダラダラしすぎなのは問題です！"},
        { "location": "9/TALK" , "narrator": "プリンセスサーヴ", "text": "さあ、トレーニングを始めましょう！"},
        { "location": "10/TALK", "narrator": "すろうべりぃ", "text": "やるとはいってないよ……"},
        { "location": "11/TALK", "narrator": "プリンセスサーヴ", "text": "私が放つボールをレシーブしてください！"},
        { "location": "12/TALK", "narrator": "すろうべりぃ", "text": "いきなりハードすぎだよ"},
        { "location": "13/TALK", "narrator": "すろうべりぃ", "text": "あなたのボールなんかうけたら腕が爆発するよ……"},
        { "location": "14/TALK", "narrator": "すろうべりぃ", "text": "もうちょっと基礎的な運動があるでしょ普通……いきなりそんなのはムリだよ"},
        { "location": "15/TALK", "narrator": "プリンセスサーヴ", "text": "諦めなければ何だってできます！"},
        { "location": "16/TALK", "narrator": "すろうべりぃ", "text": "ああ……なんだかめんどくさいテンションに……"},
        { "location": "17/TALK", "narrator": "プリンセスサーヴ", "text": "その生活習慣を改善させるには一度、徹底的にやるしかありません！"},
        { "location": "18/TALK", "narrator": "すろうべりぃ", "text": "そもそも『体を動かさないことが悪』という風習は正しいの？"},
        { "location": "19/TALK", "narrator": "すろうべりぃ", "text": "体育会系の認識で世の中の善悪を決めるのはどうかと思うよ……"},
        { "location": "20/TALK", "narrator": "プリンセスサーヴ", "text": "体を動かさないとますます動くのが面倒になりますよ！"},
        { "location": "21/TALK", "narrator": "すろうべりぃ", "text": "むう……この場を逃れるにはあの熱血体育会系をなんとか冷やすしかないかな……"},
        { "location": "22/TALK", "narrator": "すろうべりぃ", "text": "お、あそこにいるのは……"},
        { "location": "23/TALK", "narrator": "すろうべりぃ", "text": "タナトス……こっちに来て……"},
        { "location": "24/TALK", "narrator": "氷帝タナトス", "text": "あら？　珍しい組み合わせね"},
        { "location": "25/TALK", "narrator": "すろうべりぃ", "text": "ちょっとそこの熱血を凍らせて……"},
        { "location": "26/TALK", "narrator": "氷帝タナトス", "text": "ほかのクランを氷漬けにするような頼みをいきなりいわれても困るわ"},
        { "location": "27/TALK", "narrator": "すろうべりぃ", "text": "むりやり運動をさせてくる恐ろしい奴なの……"},
        { "location": "28/TALK", "narrator": "プリンセスサーヴ", "text": "タナトスさんからも少しは体を動かすようにいってください"},
        { "location": "29/TALK", "narrator": "氷帝タナトス", "text": "まったく運動しないというのは、私もどうかと思うわ"},
        { "location": "30/TALK", "narrator": "すろうべりぃ", "text": "あなたも熱血の仲間なのね……ファッションクールだったのね……"},
        { "location": "31/TALK", "narrator": "氷帝タナトス", "text": "何よファッションクールって……"},
        { "location": "32/TALK", "narrator": "プリンセスサーヴ", "text": "さあ、２対１で運動する派の勝利ですね"},
        { "location": "33/TALK", "narrator": "すろうべりぃ", "text": "ほかに……ほかにダラダラ派の力になってくれるようなクランは……"},
        { "location": "34/TALK", "narrator": "氷帝タナトス", "text": "運動を頑張ったらあとで私がかき氷を作ってあげるわ"},
        { "location": "35/TALK", "narrator": "すろうべりぃ", "text": "そんなものでわたしを釣ろうとしたって……"},
        { "location": "36/TALK", "narrator": "プリンセスサーヴ", "text": "体を動かして暑い時に食べるかき氷はきっと美味しいですよ"},
        { "location": "37/TALK", "narrator": "プリンセスサーヴ", "text": "それは運動をした者だけが味わえる快感……"},
        { "location": "38/TALK", "narrator": "すろうべりぃ", "text": "むむ……それは魅力的……"},
        { "location": "39/TALK", "narrator": "すろうべりぃ", "text": "わかったよ……。　少しだけなら付き合う……"},
        { "location": "40/TALK", "narrator": "プリンセスサーヴ", "text": "その言葉を待っていました！　早速やりましょう！"},
        { "location": "41/TALK", "narrator": "すろうべりぃ", "text": "終わったらかき氷を食べながら全力でゴロゴロするよ……"}
    ]
}
