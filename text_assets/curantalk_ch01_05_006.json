{
    "dir": "curantalk",
    "type": "curan_talk",
    "info": {
        "id": "curantalk_ch01_05_006"
    },
    "entry":
    [
        { "location": "1/BGM"  , "narrator": "", "text": "M09"},
        { "location": "2/TALK" , "narrator": "オーシャンティ", "text": "ふははは、流石は余だ。　ついに世界征服も実現するかもしれんな"},
        { "location": "3/TALK" , "narrator": "星詠", "text": "でもすこしのことで運気が逆転するから油断は禁物とも出ているわね"},
        { "location": "4/TALK" , "narrator": "オーシャンティ", "text": "ぬ、ぬう……用心しておくか……"},
        { "location": "5/TALK" , "narrator": "りりえった", "text": "星詠さんの占いは当たるって評判ですからね！"},
        { "location": "6/TALK" , "narrator": "ダメンズナース", "text": "あら、みなさん何をしているんですか？"},
        { "location": "7/TALK" , "narrator": "オーシャンティ", "text": "む、ダメンズナースか。　星詠に占いとやらをしてもらっていたのだ"},
        { "location": "8/TALK" , "narrator": "星詠", "text": "よかったらあなたも占ってみる？"},
        { "location": "9/TALK" , "narrator": "ダメンズナース", "text": "ぜひお願いします！"},
        { "location": "10/TALK", "narrator": "りりえった", "text": "ダメンズナースさんはやっぱり恋愛運が気になりますか？"},
        { "location": "11/TALK", "narrator": "ダメンズナース", "text": "そうね……私が求める真実の愛に辿りつけるかどうかを占ってもらおうかしら"},
        { "location": "12/TALK", "narrator": "星詠", "text": "真実の愛……ね。　わかったわ。　占ってみましょう"},
        { "location": "13/TALK", "narrator": "ダメンズナース", "text": "お願いします！"},
        { "location": "14/TALK", "narrator": "りりえった", "text": "（真実の愛ってそもそも何なんだろう……）"},
        { "location": "15/TALK", "narrator": "オーシャンティ", "text": "ふん、愛など下らん。　大事なのは圧倒的な力だ！"},
        { "location": "16/TALK", "narrator": "ダメンズナース", "text": "愛の無い人生なんて寂しいだけです！"},
        { "location": "17/TALK", "narrator": "星詠", "text": "……集中できないから少し静かにしてもらえるかしら"},
        { "location": "18/TALK", "narrator": "ダメンズナース", "text": "ご、ごめんなさい"},
        { "location": "19/TALK", "narrator": "りりえった", "text": "いったいどんな結果が出るんでしょう……"},
        { "location": "20/TALK", "narrator": "星詠", "text": "むむむ……"},
        { "location": "21/TALK", "narrator": "ダメンズナース", "text": "…………"},
        { "location": "22/TALK", "narrator": "星詠", "text": "結果が出たわ"},
        { "location": "23/TALK", "narrator": "星詠", "text": "無理ね"},
        { "location": "24/TALK", "narrator": "ダメンズナース", "text": "えっ……"},
        { "location": "25/TALK", "narrator": "星詠", "text": "あなたは真実の愛には辿り着けない……"},
        { "location": "26/TALK", "narrator": "星詠", "text": "独り孤独に朽ち果てていく……そんな運命"},
        { "location": "27/TALK", "narrator": "ダメンズナース", "text": "そ、そんな～"},
        { "location": "28/TALK", "narrator": "オーシャンティ", "text": "流石にそれは悲しい運命だな"},
        { "location": "29/TALK", "narrator": "りりえった", "text": "かわいそうなダメンズナースさん……あれ？"},
        { "location": "30/TALK", "narrator": "りりえった", "text": "ここに落ちているカードは何でしょう"},
        { "location": "31/TALK", "narrator": "星詠", "text": "あら、それはこの占いに使うカードね……"},
        { "location": "32/TALK", "narrator": "オーシャンティ", "text": "気づかぬうちに落としていたようだな"},
        { "location": "33/TALK", "narrator": "ダメンズナース", "text": "ということは……！"},
        { "location": "34/TALK", "narrator": "星詠", "text": "ええ、先ほどの占いの結果は正しいものではないわね"},
        { "location": "35/TALK", "narrator": "ダメンズナース", "text": "じゃあ真実の愛に辿りつけないというのは間違いなのね！"},
        { "location": "36/TALK", "narrator": "星詠", "text": "もう一度やり直すわね"},
        { "location": "37/TALK", "narrator": "ダメンズナース", "text": "いえ……恐らくこれは真実の愛へは自分の力だけで辿り着けという天のお告げ……"},
        { "location": "38/TALK", "narrator": "ダメンズナース", "text": "私は自分の力で頑張るわ！　ありがとう！"},
        { "location": "39/TALK", "narrator": "りりえった", "text": "行っちゃった……"},
        { "location": "40/TALK", "narrator": "星詠", "text": "彼女ならきっといい未来にたどり着けるに違いないわ"},
        { "location": "41/TALK", "narrator": "りりえった", "text": "占い師として何か見えるのですか？"},
        { "location": "42/TALK", "narrator": "星詠", "text": "いいえ、女のカンよ"},
        { "location": "43/TALK", "narrator": "りりえった", "text": "カンなんだ……"}
    ]
}
