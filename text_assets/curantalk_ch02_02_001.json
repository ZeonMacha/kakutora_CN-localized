{
    "dir": "curantalk",
    "type": "curan_talk",
    "info": {
        "id": "curantalk_ch02_02_001"
    },
    "entry":
    [
        { "location": "1/TALK" , "narrator": "プレイヤー", "text": "<color=red>β2用のサンプルイベントです</color>"},
        { "location": "2/TALK" , "narrator": "プレイヤー", "text": "<color=red>同一チャプターでは全て同じイベントが発生します</color>"},
        { "location": "3/TALK" , "narrator": "プレイヤー", "text": "<color=red>予めご了承ください</color>"},
        { "location": "4/TALK" , "narrator": "月影らせん", "text": "今日は誰を呪おうかしら…"},
        { "location": "5/TALK" , "narrator": "シスターフール", "text": "ふんふん…これをあぁして…"},
        { "location": "6/TALK" , "narrator": "シスターフール", "text": "そっか、これなら新しい発明品が作れそう！"},
        { "location": "7/TALK" , "narrator": "月影らせん", "text": "…なんだか楽しそうで恨めしいわ"},
        { "location": "8/TALK" , "narrator": "月影らせん", "text": "あの子にしましょう"},
        { "location": "9/TALK" , "narrator": "シスターフール", "text": "よーし！"},
        { "location": "10/TALK", "narrator": "シスターフール", "text": "そうと決まれば早速始めなきゃ…って、あら？"},
        { "location": "11/TALK", "narrator": "月影らせん", "text": "こんにちは"},
        { "location": "12/TALK", "narrator": "月影らせん", "text": "残念だけどあなたには恐怖と苦しみを味わってもらうわ"},
        { "location": "13/TALK", "narrator": "シスターフール", "text": "え？その出で立ちにその言動…"},
        { "location": "14/TALK", "narrator": "シスターフール", "text": "まさかあなた幽霊！？"},
        { "location": "15/TALK", "narrator": "月影らせん", "text": "そうよ、私は幽霊あなたを呪いにき――"},
        { "location": "16/TALK", "narrator": "シスターフール", "text": "すごいすごい！\n本物の幽霊と会話出来るなんて！"},
        { "location": "17/TALK", "narrator": "月影らせん", "text": "えっ…"},
        { "location": "18/TALK", "narrator": "シスターフール", "text": "あ、そうだ！"},
        { "location": "19/TALK", "narrator": "シスターフール", "text": "せっかくだから色々とデータを取らせてもらえる？"},
        { "location": "20/TALK", "narrator": "シスターフール", "text": "こんな機会滅多にないもんね！今後の発明に役立つよ！"},
        { "location": "21/TALK", "narrator": "月影らせん", "text": "……あなた、私が怖くないの？"},
        { "location": "22/TALK", "narrator": "シスターフール", "text": "なんで？\n怖くないよ？"},
        { "location": "23/TALK", "narrator": "月影らせん", "text": "普通の人はおばけを怖がるものなのだけど…"},
        { "location": "24/TALK", "narrator": "シスターフール", "text": "あ～、そういえば綾ちゃんもおばけ苦手だったっけー"},
        { "location": "25/TALK", "narrator": "シスターフール", "text": "家柄の関係で昔から悪霊とか呪いとか日常茶飯事だったから"},
        { "location": "26/TALK", "narrator": "シスターフール", "text": "すっかりおばけ嫌いになっちゃったんだよね～"},
        { "location": "27/TALK", "narrator": "シスターフール", "text": "私は自分で発明した「ノロイキエールくん1号」があるから平気だけど！"},
        { "location": "28/TALK", "narrator": "月影らせん", "text": "そ、そう…あなたって変わり者ね…"},
        { "location": "29/TALK", "narrator": "シスターフール", "text": "そんなことないよ～"},
        { "location": "30/TALK", "narrator": "シスターフール", "text": "それより、データ取らせてもらっていいかな？"},
        { "location": "31/TALK", "narrator": "月影らせん", "text": "…ある意味、あなたっておばけより怖いかもしれないわね…"},
        { "location": "32/TALK", "narrator": "月影らせん", "text": "実験台にされない内に逃げようかしら…"},
        { "location": "33/TALK", "narrator": "月影らせん", "text": "それじゃ…"},
        { "location": "34/TALK", "narrator": "シスターフール", "text": "まずはプラズマの計測から…って、あれ？ま、待って～！"}
    ]
}
