{
    "dir": "curantalk",
    "type": "curan_talk",
    "info": {
        "id": "curantalk_ch02_05_001"
    },
    "entry":
    [
        { "location": "1/TALK" , "narrator": "プレイヤー", "text": "<color=red>β2用のサンプルイベントです</color>"},
        { "location": "2/TALK" , "narrator": "プレイヤー", "text": "<color=red>同一チャプターでは全て同じイベントが発生します</color>"},
        { "location": "3/TALK" , "narrator": "プレイヤー", "text": "<color=red>予めご了承ください</color>"},
        { "location": "4/TALK" , "narrator": "ヴィルベルヴィンド", "text": "ひえー！　聞きたくないって！"},
        { "location": "5/TALK" , "narrator": "シルキーちゃん", "text": "え～？　他にもたくさんあるよ～"},
        { "location": "6/TALK" , "narrator": "ガネーシャ", "text": "何の話をしているの？"},
        { "location": "7/TALK" , "narrator": "シルキーちゃん", "text": "あれ～？　ガネーシャちゃん、何でこんなところに？"},
        { "location": "8/TALK" , "narrator": "ガネーシャ", "text": "ヴィルベルヴィンドに借りていた戦車の本を返しに来たのよ"},
        { "location": "9/TALK" , "narrator": "ヴィルベルヴィンド", "text": "読み終わったのね。どうだった？"},
        { "location": "10/TALK", "narrator": "ガネーシャ", "text": "色々な戦車の逸話が載っていて興味深かったわ"},
        { "location": "11/TALK", "narrator": "シルキーちゃん", "text": "虫にも色々な話があるんだよ～"},
        { "location": "12/TALK", "narrator": "ヴィルベルヴィンド", "text": "だから聞きたくないって！"},
        { "location": "13/TALK", "narrator": "ガネーシャ", "text": "虫のことも知りたいわ。良かったら聞かせてくれるかしら"},
        { "location": "14/TALK", "narrator": "ヴィルベルヴィンド", "text": "やめておいた方がいいのに……"},
        { "location": "15/TALK", "narrator": "シルキーちゃん", "text": "そうこなくっちゃ～"},
        { "location": "16/TALK", "narrator": "ヴィルベルヴィンド", "text": "絶対後悔することになるから……"},
        { "location": "17/TALK", "narrator": "ガネーシャ", "text": "何故ヴィルベルヴィンドは話を聞いていたの？"},
        { "location": "18/TALK", "narrator": "ヴィルベルヴィンド", "text": "聞きたくないのにずっと話しかけてくるのよ！"},
        { "location": "19/TALK", "narrator": "シルキーちゃん", "text": "虫の素晴らしさを知ってもらおうと思ってね～"},
        { "location": "20/TALK", "narrator": "シルキーちゃん", "text": "意外なところで色々な虫が大活躍してるんだよ～"},
        { "location": "21/TALK", "narrator": "ガネーシャ", "text": "そう……是非知っておきたいわ"},
        { "location": "22/TALK", "narrator": "ヴィルベルヴィンド", "text": "大体知らなきゃ良かったことばっかりよ……"},
        { "location": "23/TALK", "narrator": "シルキーちゃん", "text": "ガネーシャちゃんは勉強熱心だね～"},
        { "location": "24/TALK", "narrator": "シルキーちゃん", "text": "まあ、これでも飲みながらゆっくり聞いてよ～"},
        { "location": "25/TALK", "narrator": "ガネーシャ", "text": "……イチゴミルクね"},
        { "location": "26/TALK", "narrator": "ヴィルベルヴィンド", "text": "イチゴは嫌いじゃないし、頂くわ"},
        { "location": "27/TALK", "narrator": "シルキーちゃん", "text": "イチゴミルクの赤い色は"},
        { "location": "28/TALK", "narrator": "シルキーちゃん", "text": "虫から作られた色素なのよ～"},
        { "location": "29/TALK", "narrator": "ヴィルベルヴィンド", "text": "ぶへっ！"},
        { "location": "30/TALK", "narrator": "ヴィルベルヴィンド", "text": "何なの！？　嫌がらせなの！？"},
        { "location": "31/TALK", "narrator": "ガネーシャ", "text": "…………"},
        { "location": "32/TALK", "narrator": "シルキーちゃん", "text": "実際に見てもらった方がわかりやすいかと思って～"},
        { "location": "33/TALK", "narrator": "ヴィルベルヴィンド", "text": "も、もう飲めない……"},
        { "location": "34/TALK", "narrator": "ガネーシャ", "text": "世の中には、知らなければ良かったという事もあることを知ったわ……"}
    ]
}
