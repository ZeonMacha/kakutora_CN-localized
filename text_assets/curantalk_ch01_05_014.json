{
    "dir": "curantalk",
    "type": "curan_talk",
    "info": {
        "id": "curantalk_ch01_05_014"
    },
    "entry":
    [
        { "location": "1/BGM"  , "narrator": "", "text": "M09"},
        { "location": "2/TALK" , "narrator": "ドクトル・ヘルムート", "text": "我々で協力して大規模な盗みをしないか？"},
        { "location": "3/TALK" , "narrator": "魔王ユゥミ☆", "text": "俺は暴れられたら何でもいいぜ、その話に乗ろうじゃないか"},
        { "location": "4/TALK" , "narrator": "ディヴィー", "text": "盗った物は皆で山分けよ！"},
        { "location": "5/TALK" , "narrator": "ドクトル・ヘルムート", "text": "話が早くて助かる。　ではさっそく作戦会議だ"},
        { "location": "6/TALK" , "narrator": "魔王ユゥミ☆", "text": "作戦なんていらねぇ、突っ込んで全員やっちまえばいいのさ"},
        { "location": "7/TALK" , "narrator": "ドクトル・ヘルムート", "text": "それではあまりに効率が悪すぎる"},
        { "location": "8/TALK" , "narrator": "ドクトル・ヘルムート", "text": "美しく計画的に遂行すべきだ"},
        { "location": "9/TALK" , "narrator": "ディヴィー", "text": "まーまー、良い感じにやろうよ"},
        { "location": "10/TALK", "narrator": "シェリフ・あーぷ", "text": "そこまでだ、悪党どもー！！"},
        { "location": "11/TALK", "narrator": "シェリフ・あーぷ", "text": "一気にこのガトリング砲で片づけてやる！"},
        { "location": "12/TALK", "narrator": "魔王ユゥミ☆", "text": "お、おい！　入ってくるなり突然撃ってきたぞ！"},
        { "location": "13/TALK", "narrator": "ドクトル・ヘルムート", "text": "な、何者だ！？"},
        { "location": "14/TALK", "narrator": "シェリフ・あーぷ", "text": "アタシの名前はシェリフ・あーぷ！"},
        { "location": "15/TALK", "narrator": "シェリフ・あーぷ", "text": "この世の悪党は全て滅ぼす！　正義の保安官だ！！"},
        { "location": "16/TALK", "narrator": "シェリフ・あーぷ", "text": "ガトリング砲をくらえー！"},
        { "location": "17/TALK", "narrator": "魔王ユゥミ☆", "text": "自己紹介を終えた瞬間に撃ってきたぞ！！"},
        { "location": "18/TALK", "narrator": "ディヴィー", "text": "ちょ、ちょっと！　危ないでしょ！"},
        { "location": "19/TALK", "narrator": "システム", "text": "～５分後～"},
        { "location": "20/TALK", "narrator": "銀河パトロール玖号", "text": "銀河パトロールただいま到着！"},
        { "location": "21/TALK", "narrator": "銀河パトロール玖号", "text": "銃声が聞こえるっていうから駆けつけてみたけど……"},
        { "location": "22/TALK", "narrator": "魔王ユゥミ☆", "text": "おわぁぁぁ～～！"},
        { "location": "23/TALK", "narrator": "ドクトル・ヘルムート", "text": "このままでは蜂の巣にされてしまう！"},
        { "location": "24/TALK", "narrator": "銀河パトロール玖号", "text": "あそこに居るのは悪党クラン共……！"},
        { "location": "25/TALK", "narrator": "銀河パトロール玖号", "text": "そしてそれを襲っているのは……"},
        { "location": "26/TALK", "narrator": "シェリフ・あーぷ", "text": "ははははは！　怯えろ悪党どもー！"},
        { "location": "27/TALK", "narrator": "銀河パトロール玖号", "text": "……私が逮捕すべきはどっちなのかしら？"},
        { "location": "28/TALK", "narrator": "ディヴィー", "text": "た、たすけて～"},
        { "location": "29/TALK", "narrator": "シェリフ・あーぷ", "text": "このガトリングの弾が切れるまで無事でいられるかな！？"},
        { "location": "30/TALK", "narrator": "銀河パトロール玖号", "text": "もはやあっちの方が悪人に見えるわね……"},
        { "location": "31/TALK", "narrator": "シェリフ・あーぷ", "text": "ふはははー！　踊れ踊れェー！！"},
        { "location": "32/TALK", "narrator": "銀河パトロール玖号", "text": "だんだんノってきてるわね"},
        { "location": "33/TALK", "narrator": "ドクトル・ヘルムート", "text": "も、もう悪事からは足を洗おうか……"},
        { "location": "34/TALK", "narrator": "魔王ユゥミ☆", "text": "こんな奴が居たらやってられないよ……"},
        { "location": "35/TALK", "narrator": "ディヴィー", "text": "正義って怖い……"}
    ]
}
