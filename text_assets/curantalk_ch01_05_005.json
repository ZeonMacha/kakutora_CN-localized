    "dir": "curantalk",
    "type": "curan_talk",
    "info": {
        "id": "curantalk_ch01_05_005"
    },
    "entry":
    [
        { "location": "1/BGM"  , "narrator": "", "text": "M09"},
        { "location": "2/TALK" , "narrator": "劇団ボッチ", "text": "いいよー、なにしてあそぶ？"},
        { "location": "3/TALK" , "narrator": "グランドブロウ", "text": "オイラの怪獣を使って何かやろうよ"},
        { "location": "4/TALK" , "narrator": "劇団ボッチ", "text": "わぁ！　それたのしそう！"},
        { "location": "5/TALK" , "narrator": "劇団ボッチ", "text": "かいじゅうでだれかをおそっちゃおう！"},
        { "location": "6/TALK" , "narrator": "グランドブロウ", "text": "んー、襲うのはさすがにマズイから驚かせたりしようよ"},
        { "location": "7/TALK" , "narrator": "劇団ボッチ", "text": "じゃあそうしよう！"},
        { "location": "8/TALK" , "narrator": "グランドブロウ", "text": "誰かが通りがかったら、劇団ボッチが声をかけて"},
        { "location": "9/TALK" , "narrator": "グランドブロウ", "text": "その隙にオイラが後ろから驚かせるよ"},
        { "location": "10/TALK", "narrator": "劇団ボッチ", "text": "わかったー！"},
        { "location": "11/TALK", "narrator": "グランドブロウ", "text": "お、ちょうど誰か来たぞー"},
        { "location": "12/TALK", "narrator": "劇団ボッチ", "text": "さくせんかいしだー"},
        { "location": "13/TALK", "narrator": "黒松林キョウ", "text": "この盆栽は最高の自信作だ……"},
        { "location": "14/TALK", "narrator": "黒松林キョウ", "text": "これは皆に自慢しにいかないと！"},
        { "location": "15/TALK", "narrator": "劇団ボッチ", "text": "ねーねー、それなーに？"},
        { "location": "16/TALK", "narrator": "黒松林キョウ", "text": "これは盆栽といってね、それはそれは素晴らしい物なんだよ"},
        { "location": "17/TALK", "narrator": "劇団ボッチ", "text": "へー、おもしろいねー"},
        { "location": "18/TALK", "narrator": "グランドブロウ", "text": "がおーーーーー！！"},
        { "location": "19/TALK", "narrator": "黒松林キョウ", "text": "わあああああ！！　バケモノだーーー！！"},
        { "location": "20/TALK", "narrator": "グランドブロウ", "text": "わははははは！"},
        { "location": "21/TALK", "narrator": "劇団ボッチ", "text": "わーいわーい！"},
        { "location": "22/TALK", "narrator": "黒松林キョウ", "text": "あああ……僕の……自信作が……"},
        { "location": "23/TALK", "narrator": "黒松林キョウ", "text": "…………"},
        { "location": "24/TALK", "narrator": "グランドブロウ", "text": "ビックリ大成功だー！"},
        { "location": "25/TALK", "narrator": "劇団ボッチ", "text": "やったやったー！"},
        { "location": "26/TALK", "narrator": "黒松林キョウ", "text": "ゆ……許さん"},
        { "location": "27/TALK", "narrator": "黒松林キョウ", "text": "許さんぞぉぉぉ！　子供のしたこととはいえこれは許さん！"},
        { "location": "28/TALK", "narrator": "黒松林キョウ", "text": "お、お前達をBONSAIにシテヤル……！"},
        { "location": "29/TALK", "narrator": "劇団ボッチ", "text": "ひ、ひえーー！"},
        { "location": "30/TALK", "narrator": "グランドブロウ", "text": "めちゃくちゃ怒ってる！"},
        { "location": "31/TALK", "narrator": "劇団ボッチ", "text": "こ、これはあやまったほうがいいよ！　ぼんさいにされちゃうよ"},
        { "location": "32/TALK", "narrator": "グランドブロウ", "text": "ご、ごめんよ！　まさかそんなに大事な物を持ってたとは……"},
        { "location": "33/TALK", "narrator": "劇団ボッチ", "text": "ごめんなさい……"},
        { "location": "34/TALK", "narrator": "黒松林キョウ", "text": "僕の盆栽をどうしてくれるんだい……"},
        { "location": "35/TALK", "narrator": "グランドブロウ", "text": "そ、そうだ！　オイラが怪獣を使ってすごく大きな盆栽を作ってあげるよ！"},
        { "location": "36/TALK", "narrator": "黒松林キョウ", "text": "巨大盆栽……？それは新しい！　新たなジャンルを切り開けるぞ！"},
        { "location": "37/TALK", "narrator": "黒松林キョウ", "text": "では、さっそく作業に取り掛かるぞ！"},
        { "location": "38/TALK", "narrator": "グランドブロウ", "text": "（これからは怪獣を悪いことに使うのはやめよう……）"},
        { "location": "39/TALK", "narrator": "劇団ボッチ", "text": "（……あれ？　おっきいぼんさいってただの き じゃない？）"}
    ]
}
