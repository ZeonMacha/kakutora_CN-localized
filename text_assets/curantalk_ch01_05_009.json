    "dir": "curantalk",
    "type": "curan_talk",
    "info": {
        "id": "curantalk_ch01_05_009"
    },
    "entry":
    [
        { "location": "1/BGM"  , "narrator": "", "text": "M09"},
        { "location": "2/TALK" , "narrator": "霊幻坊", "text": "喝！　喝！　かぁーつ！"},
        { "location": "3/TALK" , "narrator": "サナトリウム", "text": "…………"},
        { "location": "4/TALK" , "narrator": "黒騎士さん", "text": "アンタよりアタシの方が絶対強いね！"},
        { "location": "5/TALK" , "narrator": "呂なんとか", "text": "なんだと！？　俺より強い奴なんているはずがねぇ！"},
        { "location": "6/TALK" , "narrator": "黒騎士さん", "text": "やるか！？　この！！"},
        { "location": "7/TALK" , "narrator": "サナトリウム", "text": "…………騒がしい"},
        { "location": "8/TALK" , "narrator": "サナトリウム", "text": "どうしてこうも、うるさいクランが多いのかしら……"},
        { "location": "9/TALK" , "narrator": "サナトリウム", "text": "私はもう少し静かに暮らしたいのだけど……"},
        { "location": "10/TALK", "narrator": "呂なんとか", "text": "よし！　勝負だ！！　どっちが強いか決めるぜ！"},
        { "location": "11/TALK", "narrator": "黒騎士さん", "text": "望むところだよ！　うおぉぉぉぉぉ！！"},
        { "location": "12/TALK", "narrator": "サナトリウム", "text": "あなた達、もっと静かにしてもらえないかしら"},
        { "location": "13/TALK", "narrator": "呂なんとか", "text": "お？　なんだよ！"},
        { "location": "14/TALK", "narrator": "黒騎士さん", "text": "邪魔しようってのかい！？"},
        { "location": "15/TALK", "narrator": "サナトリウム", "text": "あなた達のどっちが強いかなんてどうでもいいから、静かにしなさい"},
        { "location": "16/TALK", "narrator": "呂なんとか", "text": "どうでもいいとはなんだ！"},
        { "location": "17/TALK", "narrator": "黒騎士さん", "text": "むしろアンタが少し静かすぎるんじゃないかい？"},
        { "location": "18/TALK", "narrator": "呂なんとか", "text": "そうだぜ。　もっと熱くならねぇとつまんねぇぜ！？"},
        { "location": "19/TALK", "narrator": "サナトリウム", "text": "別につまらなくてもいいから私はゆっくり静かに過ごしたいの"},
        { "location": "20/TALK", "narrator": "サナトリウム", "text": "……そういうわけだから、もう少し落ち着いて頂戴"},
        { "location": "21/TALK", "narrator": "呂なんとか", "text": "なんだよ……まったく"},
        { "location": "22/TALK", "narrator": "黒騎士さん", "text": "ほっとけばいいさ。　さあ、勝負の続きだよ"},
        { "location": "23/TALK", "narrator": "呂なんとか", "text": "おう、気を取り直して行くぜ！"},
        { "location": "24/TALK", "narrator": "黒騎士さん", "text": "おりゃあぁぁぁぁ！！"},
        { "location": "25/TALK", "narrator": "呂なんとか", "text": "せやあぁぁぁぁ！！"},
        { "location": "26/TALK", "narrator": "サナトリウム", "text": "…………！"},
        { "location": "27/TALK", "narrator": "サナトリウム", "text": "ええーい！　うるさぁぁぁぁぁぁぁい！！！"},
        { "location": "28/TALK", "narrator": "サナトリウム", "text": "ホントなんなの！？騒がないと死ぬの！？"},
        { "location": "29/TALK", "narrator": "サナトリウム", "text": "いい加減にしないとこの鎌で頭を斬り落とすわよ！？"},
        { "location": "30/TALK", "narrator": "黒騎士さん", "text": "ひ、ひぃ"},
        { "location": "31/TALK", "narrator": "呂なんとか", "text": "サ、サナトリウムがブチ切れた……！？"},
        { "location": "32/TALK", "narrator": "サナトリウム", "text": "そうね、首を斬ってしまえば静かになるわね……！"},
        { "location": "33/TALK", "narrator": "呂なんとか", "text": "お、落ち着けよ……悪かった、少し騒ぎ過ぎたぜ"},
        { "location": "34/TALK", "narrator": "黒騎士さん", "text": "これからは迷惑にならないようにするよ……"},
        { "location": "35/TALK", "narrator": "サナトリウム", "text": "またうるさくしたら頭と体が離れることになるわ……覚えておきなさい"},
        { "location": "36/TALK", "narrator": "黒騎士さん", "text": "は、はい……"},
        { "location": "37/TALK", "narrator": "呂なんとか", "text": "行っちまった……"},
        { "location": "38/TALK", "narrator": "黒騎士さん", "text": "今後サナトリウムの前では静かにしような……"},
        { "location": "39/TALK", "narrator": "呂なんとか", "text": "まさかキレるとあんなことになるとは……"},
        { "location": "40/TALK", "narrator": "サナトリウム", "text": "（さて……これで静かに過ごせるわね）"}
    ]
}
