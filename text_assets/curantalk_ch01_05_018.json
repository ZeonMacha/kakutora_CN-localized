    "dir": "curantalk",
    "type": "curan_talk",
    "info": {
        "id": "curantalk_ch01_05_018"
    },
    "entry":
    [
        { "location": "1/BGM"  , "narrator": "", "text": "M09"},
        { "location": "2/TALK" , "narrator": "ギアス・オーダー", "text": "……むう"},
        { "location": "3/TALK" , "narrator": "ギアス・オーダー", "text": "もう昼だというのにだらだらと……"},
        { "location": "4/TALK" , "narrator": "ギアス・オーダー", "text": "人の心の問題から生まれたクラン達だが――"},
        { "location": "5/TALK" , "narrator": "ギアス・オーダー", "text": "皆、その葛藤から解放されたせいか"},
        { "location": "6/TALK" , "narrator": "ギアス・オーダー", "text": "あまりにも気が抜けすぎているのではないか……？"},
        { "location": "7/TALK" , "narrator": "ギアス・オーダー", "text": "さすがにこのままでは、集団としての統率をとれなくなる"},
        { "location": "8/TALK" , "narrator": "ギアス・オーダー", "text": "一度、皆の気合を入れなおすか……"},
        { "location": "9/TALK" , "narrator": "システム", "text": "～１時間後～"},
        { "location": "10/TALK", "narrator": "ギアス・オーダー", "text": "というわけで、これより特訓を開始する！"},
        { "location": "11/TALK", "narrator": "すろうべりぃ", "text": "拒否する……"},
        { "location": "12/TALK", "narrator": "ギアス・オーダー", "text": "そうはいかん、特にお前には頑張ってもらうぞ"},
        { "location": "13/TALK", "narrator": "ケロ山ケロ美", "text": "たまたま近くにいただけで強制参加……理不尽ケロ"},
        { "location": "14/TALK", "narrator": "デスピリット", "text": "堅苦しいことは言わねぇでもっと自由に生きようぜ？"},
        { "location": "15/TALK", "narrator": "ギアス・オーダー", "text": "全員が自由にやっているだけでは世はなりたたんのだ"},
        { "location": "16/TALK", "narrator": "ギアス・オーダー", "text": "普段から気合をいれておかないと実戦での作戦行動にも影響が出る！"},
        { "location": "17/TALK", "narrator": "ギアス・オーダー", "text": "さあ、まずは腕立て伏せだ！"},
        { "location": "18/TALK", "narrator": "すろうべりぃ", "text": "ええ～……"},
        { "location": "19/TALK", "narrator": "デスピリット", "text": "マジかよ……"},
        { "location": "20/TALK", "narrator": "ギアス・オーダー", "text": "では……スタート！"},
        { "location": "21/TALK", "narrator": "ケロ山ケロ美", "text": "ひ、ひぃぃ……"},
        { "location": "22/TALK", "narrator": "デスピリット", "text": "くそっ、やるしかないか……！"},
        { "location": "23/TALK", "narrator": "すろうべりぃ", "text": "ぐええ……もう駄目……"},
        { "location": "24/TALK", "narrator": "デスピリット", "text": "いくらなんでも脱落早すぎるだろ！！"},
        { "location": "25/TALK", "narrator": "ギアス・オーダー", "text": "体を動かすという行為への拒否反応で気を失ったか"},
        { "location": "26/TALK", "narrator": "ギアス・オーダー", "text": "まさかここまで酷いとは"},
        { "location": "27/TALK", "narrator": "ギアス・オーダー", "text": "残り１００回！　ペースが遅いぞ！"},
        { "location": "28/TALK", "narrator": "ケロ山ケロ美", "text": "こ、これ以上は無理ケロ……"},
        { "location": "29/TALK", "narrator": "デスピリット", "text": "ケロ美がひからびたカエルみたいになっちまった……！"},
        { "location": "30/TALK", "narrator": "ギアス・オーダー", "text": "この程度で倒れてしまうとは情けない……"},
        { "location": "31/TALK", "narrator": "ギアス・オーダー", "text": "こうなったら徹底的にスパルタにやる必要があるかもしれないな"},
        { "location": "32/TALK", "narrator": "すろうべりぃ", "text": "うう……このままでは命の危機……"},
        { "location": "33/TALK", "narrator": "すろうべりぃ", "text": "全ての力を振り絞って全力で逃げる……ッ！"},
        { "location": "34/TALK", "narrator": "ケロ山ケロ美", "text": "あっ、ずるいケロ！　私も逃げるケロ！"},
        { "location": "35/TALK", "narrator": "デスピリット", "text": "くそっ、こうなったら俺もだっ！"},
        { "location": "36/TALK", "narrator": "ギアス・オーダー", "text": "こら、お前達……！　って、凄い速さで走っているな……"},
        { "location": "37/TALK", "narrator": "ギアス・オーダー", "text": "あいつらもやるときはやるじゃないか"},
        { "location": "38/TALK", "narrator": "ギアス・オーダー", "text": "あれだけの体力があるなら次の訓練メニューは――"},
        { "location": "39/TALK", "narrator": "ギアス・オーダー", "text": "もっときつくてもいいかもしれないな"}
    ]
}
