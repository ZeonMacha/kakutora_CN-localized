    "dir": "curantalk",
    "type": "curan_talk",
    "info": {
        "id": "curantalk_ch01_05_012"
    },
    "entry":
    [
        { "location": "1/BGM"  , "narrator": "", "text": "M09"},
        { "location": "2/TALK" , "narrator": "マリン・ザ・リード", "text": "やっぱり魔法使いはこうじゃなきゃ"},
        { "location": "3/TALK" , "narrator": "劇団ボッチ", "text": "わー、まほうつかいだー"},
        { "location": "4/TALK" , "narrator": "劇団ボッチ", "text": "ねーねー、まほうつかってー！"},
        { "location": "5/TALK" , "narrator": "マリン・ザ・リード", "text": "……えーとね、これは魔法使いのかっこうをしているだけで"},
        { "location": "6/TALK" , "narrator": "マリン・ザ・リード", "text": "お姉ちゃんは本当は魔法使いじゃないの"},
        { "location": "7/TALK" , "narrator": "劇団ボッチ", "text": "えー……まほうつかいのぼうしかぶってるのに……"},
        { "location": "8/TALK" , "narrator": "マリン・ザ・リード", "text": "（すごく残念そう……)"},
        { "location": "9/TALK" , "narrator": "マリン・ザ・リード", "text": "…………"},
        { "location": "10/TALK", "narrator": "マリン・ザ・リード", "text": "というのは世を忍ぶ仮の姿！！"},
        { "location": "11/TALK", "narrator": "マリン・ザ・リード", "text": "本当は世界中に名を馳せるすっごい魔法使いなのよ！"},
        { "location": "12/TALK", "narrator": "劇団ボッチ", "text": "ほんとう！？"},
        { "location": "13/TALK", "narrator": "劇団ボッチ", "text": "じゃあまほうみせてみせてー！"},
        { "location": "14/TALK", "narrator": "マリン・ザ・リード", "text": "（とは言ったものの、どうしよう……)"},
        { "location": "15/TALK", "narrator": "マリン・ザ・リード", "text": "そうね、それじゃあ魔法の準備をするから"},
        { "location": "16/TALK", "narrator": "マリン・ザ・リード", "text": "１時間くらい待ってもらえるかしら？"},
        { "location": "17/TALK", "narrator": "劇団ボッチ", "text": "わかったー！"},
        { "location": "18/TALK", "narrator": "システム", "text": "～１時間後～"},
        { "location": "19/TALK", "narrator": "リーヴィア・プラト", "text": "……で、本物の魔法使いの私に手伝わせようっていうのね"},
        { "location": "20/TALK", "narrator": "マリン・ザ・リード", "text": "あとで何かあげるからお願い！"},
        { "location": "21/TALK", "narrator": "リーヴィア・プラト", "text": "仕方ないわね……"},
        { "location": "22/TALK", "narrator": "リーヴィア・プラト", "text": "私が炎を出すから、それに合わせて魔法を使うフリをするのよ"},
        { "location": "23/TALK", "narrator": "マリン・ザ・リード", "text": "ありがとう！"},
        { "location": "24/TALK", "narrator": "マリン・ザ・リード", "text": "よーし、それじゃあ始めるよ"},
        { "location": "25/TALK", "narrator": "劇団ボッチ", "text": "わーい！"},
        { "location": "26/TALK", "narrator": "マリン・ザ・リード", "text": "それ、炎よ出ろ～！"},
        { "location": "27/TALK", "narrator": "リーヴィア・プラト", "text": "（もうちょっと格好いい出し方しなさいよ）"},
        { "location": "28/TALK", "narrator": "劇団ボッチ", "text": "すごいすごい！"},
        { "location": "29/TALK", "narrator": "マリン・ザ・リード", "text": "（いい感じね、楽しくなってきたわ！)"},
        { "location": "30/TALK", "narrator": "マリン・ザ・リード", "text": "よし、次は炎で渦を描くよ！"},
        { "location": "31/TALK", "narrator": "リーヴィア・プラト", "text": "（ちょっと、勝手なこと言わないで！）"},
        { "location": "32/TALK", "narrator": "マリン・ザ・リード", "text": "それ～！　さらに４方向に同時に出すよー！"},
        { "location": "33/TALK", "narrator": "リーヴィア・プラト", "text": "（仕方ない……合わせるしかないわね）"},
        { "location": "34/TALK", "narrator": "マリン・ザ・リード", "text": "次は……って、ん？"},
        { "location": "35/TALK", "narrator": "マリン・ザ・リード", "text": "わぁぁぁ！　壁に燃え移ってる！！"},
        { "location": "36/TALK", "narrator": "リーヴィア・プラト", "text": "しまった！　制御しきれなかったわ！"},
        { "location": "37/TALK", "narrator": "劇団ボッチ", "text": "かじだー！！"},
        { "location": "38/TALK", "narrator": "リーヴィア・プラト", "text": "水の魔法で消火するわ！！"},
        { "location": "39/TALK", "narrator": "劇団ボッチ", "text": "わ、わぁ。　まほうつかいがもうひとり……"},
        { "location": "40/TALK", "narrator": "マリン・ザ・リード", "text": "あー……実はさっきのはウソで、本当の魔法使いはこの人なの……"},
        { "location": "41/TALK", "narrator": "劇団ボッチ", "text": "えぇ～……"},
        { "location": "42/TALK", "narrator": "リーヴィア・プラト", "text": "出来ないことは無理するべきじゃないわね"},
        { "location": "43/TALK", "narrator": "マリン・ザ・リード", "text": "そうだね……"}
    ]
}
