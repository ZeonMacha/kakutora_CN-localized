{
    "dir": "BattleSerif",
    "type": "ui_dll",
    "info": {
    },
    "entry":
    [
        { "location": "342/DLL", "narrator": "", "text": "お母さんのこと\n心配じゃないの？"},
        { "location": "343/DLL", "narrator": "", "text": "心配だよ！\nだから悩んでるの！"},
        { "location": "344/DLL", "narrator": "", "text": "ひどい娘ね。\n自分のことばっかり"},
        { "location": "345/DLL", "narrator": "", "text": "そんなこと…\nないもん…！"},
        { "location": "346/DLL", "narrator": "", "text": "心配している\nフリかしら？"},
        { "location": "347/DLL", "narrator": "", "text": "違うもん…！"},
        { "location": "348/DLL", "narrator": "", "text": "これだけ言っても\n行くんだ…"},
        { "location": "349/DLL", "narrator": "", "text": "行かなきゃいけない\n理由があるの！"},
        { "location": "350/DLL", "narrator": "", "text": "大丈夫！\n私を信じて！！"},
        { "location": "351/DLL", "narrator": "", "text": "私がついてるよ！"},
        { "location": "352/DLL", "narrator": "", "text": "そんなわけ\nないでしょ！"},
        { "location": "353/DLL", "narrator": "", "text": "止まってたら\n何も変わらない！"},
        { "location": "354/DLL", "narrator": "", "text": "大丈夫\nゆっくり進も？"},
        { "location": "355/DLL", "narrator": "", "text": "私のこと嫌いなの？"},
        { "location": "356/DLL", "narrator": "", "text": "みんな\nわかってくれない！"},
        { "location": "357/DLL", "narrator": "", "text": "怖くても\n負けたりしない！"},
        { "location": "358/DLL", "narrator": "", "text": "もっとみんなのこと\n信じてよ！！"},
        { "location": "359/DLL", "narrator": "", "text": "そんなことない。\nきっと楽しいよ"},
        { "location": "360/DLL", "narrator": "", "text": "みんな一緒だから\n大丈夫だよ！"},
        { "location": "361/DLL", "narrator": "", "text": "ちょっとくらい\n怖くても頑張れるよ！"},
        { "location": "362/DLL", "narrator": "", "text": "決め付けないで！\n怖くなんてない！"},
        { "location": "363/DLL", "narrator": "", "text": "寮の周りは安全だよ"},
        { "location": "364/DLL", "narrator": "", "text": "少しずつ知っていけば\nいいんだよ"},
        { "location": "365/DLL", "narrator": "", "text": "みんなで\n不安を吹っ飛ばせ～！"},
        { "location": "366/DLL", "narrator": "", "text": "みんな\n大変でも頑張ってるし"},
        { "location": "367/DLL", "narrator": "", "text": "正直、帰りたいって、\nよく思うよ"},
        { "location": "368/DLL", "narrator": "", "text": "みんなで過ごせば\n絶対楽しいよ！"},
        { "location": "369/DLL", "narrator": "", "text": "自由気ままに\n暮らせるよ！"},
        { "location": "370/DLL", "narrator": "", "text": "もういい大人\nじゃない！"},
        { "location": "371/DLL", "narrator": "", "text": "不安なのは\nわかるけど…"},
        { "location": "372/DLL", "narrator": "", "text": "同じ日本の中だし\n大丈夫よ"},
        { "location": "373/DLL", "narrator": "", "text": "寂しいよ。\nけど、自分で決めたの！"},
        { "location": "374/DLL", "narrator": "", "text": "甘えたこと\n言わないでよ！"},
        { "location": "375/DLL", "narrator": "", "text": "わかるよ…でも、\nそれじゃダメなの"},
        { "location": "376/DLL", "narrator": "", "text": "もっと新しいこと\n探してみようよ"},
        { "location": "377/DLL", "narrator": "", "text": "私たちと一緒じゃ…\nダメ？"},
        { "location": "378/DLL", "narrator": "", "text": "仲良しごっこ\nなんかじゃない！"},
        { "location": "379/DLL", "narrator": "", "text": "みんなのこと\nもっと信じようよ"},
        { "location": "380/DLL", "narrator": "", "text": "そんな寂しいこと\n思ってない！"},
        { "location": "381/DLL", "narrator": "", "text": "やってみなきゃ\n分からないよ"},
        { "location": "382/DLL", "narrator": "", "text": "いまだけじゃない！\nもっと楽しくするの！"},
        { "location": "383/DLL", "narrator": "", "text": "そうだね。でも、\n大切なことだと思う"},
        { "location": "384/DLL", "narrator": "", "text": "そうかもしれないね。\nでもそれは悪いこと？"},
        { "location": "385/DLL", "narrator": "", "text": "楽しい事\n一杯できるよ！"},
        { "location": "386/DLL", "narrator": "", "text": "意味なんて関係ない！\n一緒にいたいの！"},
        { "location": "387/DLL", "narrator": "", "text": "そんな悲しいこと\n言わないで！"},
        { "location": "388/DLL", "narrator": "", "text": "みんなとだと楽しい。\n意味なんてそれで十分"},
        { "location": "389/DLL", "narrator": "", "text": "辛いときもあるよ…。\nでも乗り越えなきゃ！"},
        { "location": "390/DLL", "narrator": "", "text": "そろそろ\n独り立ちしないと！"},
        { "location": "391/DLL", "narrator": "", "text": "辛いことから\n逃げたくない…"},
        { "location": "392/DLL", "narrator": "", "text": "辛いのなんて\nいまだけだよ"},
        { "location": "393/DLL", "narrator": "", "text": "みんなだって家族だよ！"},
        { "location": "394/DLL", "narrator": "", "text": "もう親離れしないと！"},
        { "location": "395/DLL", "narrator": "", "text": "親元を離れるのは\n辛いよね…"},
        { "location": "396/DLL", "narrator": "", "text": "みんなと離れて\n平気なの？"},
        { "location": "397/DLL", "narrator": "", "text": "寂しいなら\n一緒にいようよ！"},
        { "location": "398/DLL", "narrator": "", "text": "誰だって寂しくて…\n大変でも頑張ってる！"},
        { "location": "399/DLL", "narrator": "", "text": "不安だろうけどいまは\n楽しい事考えよう？"},
        { "location": "400/DLL", "narrator": "", "text": "わたしはでも、\nみんなと離れたくない"},
        { "location": "401/DLL", "narrator": "", "text": "少しずつでも自分の\n世界を広げてみたい！"},
        { "location": "402/DLL", "narrator": "", "text": "嫌なことから逃げて\nいるだけじゃない！"},
        { "location": "403/DLL", "narrator": "", "text": "わかるよ。お父さんと\n離れたくなんてない…"},
        { "location": "404/DLL", "narrator": "", "text": "逃げてたら\n前に進めない！"},
        { "location": "405/DLL", "narrator": "", "text": "大丈夫。それは\nわたしが保証するよ！"},
        { "location": "406/DLL", "narrator": "", "text": "いまだって\nすごく楽しいよ！"},
        { "location": "407/DLL", "narrator": "", "text": "それだけじゃないかも\nでも負けたくない"},
        { "location": "408/DLL", "narrator": "", "text": "みんなといれば\n楽しいよ！"},
        { "location": "409/DLL", "narrator": "", "text": "みんなと一緒なら\nきっと頑張れるよ"},
        { "location": "410/DLL", "narrator": "", "text": "絶対大丈夫！\nきっと何とかなるよ！"},
        { "location": "411/DLL", "narrator": "", "text": "辛くても悲しくても\n一緒に頑張ろうよ"},
        { "location": "412/DLL", "narrator": "", "text": "そう。難しく考える\n必要なんてないの"},
        { "location": "413/DLL", "narrator": "", "text": "楽しいこと、\nもっともっと探そう"},
        { "location": "414/DLL", "narrator": "", "text": "ちょっとじゃない！\nすっごく楽しいんだから！"},
        { "location": "415/DLL", "narrator": "", "text": "楽しい思い出を\nたくさん作りたいね"},
        { "location": "416/DLL", "narrator": "", "text": "みんなといれば\n絶対楽しいよ！"},
        { "location": "417/DLL", "narrator": "", "text": "お父さんなら\nわかってくれる！"},
        { "location": "418/DLL", "narrator": "", "text": "お父さんを理由にして\n逃げてない？"},
        { "location": "419/DLL", "narrator": "", "text": "心配させちゃうと思う\nでも…！"},
        { "location": "420/DLL", "narrator": "", "text": "離れてたって\n大切な家族だよ！"},
        { "location": "421/DLL", "narrator": "", "text": "そうやって\nみんな敵になるんだ！"},
        { "location": "422/DLL", "narrator": "", "text": "こないで！\n放っておいて！"},
        { "location": "423/DLL", "narrator": "", "text": "大丈夫だって！"},
        { "location": "424/DLL", "narrator": "", "text": "気にしすぎだよ！"},
        { "location": "425/DLL", "narrator": "", "text": "気楽にいこう？"},
        { "location": "426/DLL", "narrator": "", "text": "みんながついてる！"},
        { "location": "427/DLL", "narrator": "", "text": "助け合おうよ"},
        { "location": "428/DLL", "narrator": "", "text": "へっちゃらだって～"},
        { "location": "429/DLL", "narrator": "", "text": "問題ないっス"},
        { "location": "430/DLL", "narrator": "", "text": "楽しんでいこう？"},
        { "location": "431/DLL", "narrator": "", "text": "気張りなさい！"},
        { "location": "432/DLL", "narrator": "", "text": "シャキッとする！"},
        { "location": "433/DLL", "narrator": "", "text": "まだまだだね"},
        { "location": "434/DLL", "narrator": "", "text": "そんなんじゃダメよ"},
        { "location": "435/DLL", "narrator": "", "text": "無理は禁物だぜ"},
        { "location": "436/DLL", "narrator": "", "text": "俺がついてるよ"},
        { "location": "437/DLL", "narrator": "", "text": "それがどうした！"},
        { "location": "438/DLL", "narrator": "", "text": "頭なでなでしよか？"},
        { "location": "439/DLL", "narrator": "", "text": "悩むのは良いことよ"},
        { "location": "440/DLL", "narrator": "", "text": "一緒に考えよ？"},
        { "location": "441/DLL", "narrator": "", "text": "私もがんばるから！"},
        { "location": "442/DLL", "narrator": "", "text": "遊んで忘れようー"},
        { "location": "443/DLL", "narrator": "", "text": "リラックスしようぜ"},
        { "location": "444/DLL", "narrator": "", "text": "どうってことないさ"},
        { "location": "445/DLL", "narrator": "", "text": "気にしすぎｘ２"},
        { "location": "446/DLL", "narrator": "", "text": "私も…同じことある"},
        { "location": "447/DLL", "narrator": "", "text": "パーっとやろう！"},
        { "location": "448/DLL", "narrator": "", "text": "楽しまなきゃね"},
        { "location": "449/DLL", "narrator": "", "text": "いい加減にしろ！"},
        { "location": "450/DLL", "narrator": "", "text": "考えすぎなんだよ！"},
        { "location": "451/DLL", "narrator": "", "text": "いいこ、いいこ"},
        { "location": "452/DLL", "narrator": "", "text": "全部話してみなよ？"},
        { "location": "453/DLL", "narrator": "", "text": "アゲていこうぜー"},
        { "location": "454/DLL", "narrator": "", "text": "考えてもしゃーない"},
        { "location": "455/DLL", "narrator": "", "text": "みんな心配してるよ"},
        { "location": "456/DLL", "narrator": "", "text": "クヨクヨしすぎ"},
        { "location": "457/DLL", "narrator": "", "text": "悩んでどうなるん？"},
        { "location": "458/DLL", "narrator": "", "text": "よしよし"},
        { "location": "459/DLL", "narrator": "", "text": "ノープロブレム！"},
        { "location": "460/DLL", "narrator": "", "text": "私も悲しい"},
        { "location": "461/DLL", "narrator": "", "text": "もうやだー"},
        { "location": "462/DLL", "narrator": "", "text": "シャンとしんさい！"},
        { "location": "463/DLL", "narrator": "", "text": "もうマヂムリ…"},
        { "location": "464/DLL", "narrator": "", "text": "ストレス発散しよ？"},
        { "location": "465/DLL", "narrator": "", "text": "悩みすぎイクナイ！"},
        { "location": "466/DLL", "narrator": "", "text": "気にしぃだなぁ"},
        { "location": "467/DLL", "narrator": "", "text": "ウケルｗｗ"},
        { "location": "468/DLL", "narrator": "", "text": "元気だそうよー"},
        { "location": "469/DLL", "narrator": "", "text": "辛くなんてないよ"},
        { "location": "470/DLL", "narrator": "", "text": "みんないるじゃん？"},
        { "location": "471/DLL", "narrator": "", "text": "相談相手になるぜ？"},
        { "location": "472/DLL", "narrator": "", "text": "メソメソすんなって"},
        { "location": "473/DLL", "narrator": "", "text": "そんな時はカラオケ"},
        { "location": "474/DLL", "narrator": "", "text": "遊んで忘れよう～"},
        { "location": "475/DLL", "narrator": "", "text": "怖がらないで"},
        { "location": "476/DLL", "narrator": "", "text": "あたしがいるよ！"}
    ]
}
