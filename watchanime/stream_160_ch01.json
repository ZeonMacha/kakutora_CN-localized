{
    "dir": "stream_160_ch01.json",
    "type": "watchanime",
    "info": {
    },
    "entry":
    [
        { "location": "2853/Talk", "narrator": "アーヤ", "text": "それもいいんだけれど\n少しは健康的な生活も\n心懸けた方がいいわ。"},
        { "location": "2854/Talk", "narrator": "みやび", "text": "アーヤ、いきなり\nおかんモードやね。\n母性を感じるわ。"},
        { "location": "2855/Talk", "narrator": "アーヤ", "text": "や、やだ、そんな、\n褒めないでよ。\nてれるわ……。"},
        { "location": "2856/Talk", "narrator": "ガブリエラ", "text": "ていうか、それ褒めてる\nことになるんだ……。"},
        { "location": "2857/Talk", "narrator": "つばめ", "text": "さすがアーヤさん。\n母性も満々ですねっ！"},
        { "location": "2858/Talk", "narrator": "ガブリエラ", "text": "何それ、ちょっと\n具体的に説明して\nくれない？"},
        { "location": "2859/Talk", "narrator": "みやび", "text": "ガブちゃん、ボケにマジ\nレスは酷やよ。"},
        { "location": "2860/Talk", "narrator": "つばめ", "text": "つまり、カレー好きって\nことですね？"},
        { "location": "2861/Talk", "narrator": "アーヤ", "text": "もしくはインド風の\nエキゾチックな趣味とか？"},
        { "location": "2862/Talk", "narrator": "ガブリエラ", "text": "とりあえず、つばめも\nアーヤもフォローに\nなってないから。"},
        { "location": "2863/Talk", "narrator": "ガブリエラ", "text": "……どうやら\n図星だったみたいね。"},
        { "location": "2864/Talk", "narrator": "みやび", "text": "何一人で勝手なこと\nしちょるん？\nうちにもピザよこし！"},
        { "location": "2865/Talk", "narrator": "ガブリエラ", "text": "どうやって\n受け取るのよ？"},
        { "location": "2866/Talk", "narrator": "みやび", "text": "アップローダーの\nＵＲＬ教えるきに\nそこによろしゅう。"},
        { "location": "2867/Talk", "narrator": "アーヤ", "text": "……３Ｄプリンタで\n出力でもするつもり？"},
        { "location": "2868/Talk", "narrator": "みやび", "text": "正装＝全裸？"},
        { "location": "2869/Talk", "narrator": "ガブリエラ", "text": "こ、このヘンタイっ！\nヘンタイヘンタイっ！\nヘンタイィーーっ！！"},
        { "location": "2870/Talk", "narrator": "アーヤ", "text": "落ち着いてギャヴィ。\n勝手な憶測で人を\n罵倒してはダメよ。"},
        { "location": "2871/Talk", "narrator": "みやび", "text": "むしろ本当だった場合\n美少女の罵倒は\nただのご褒美やき。"},
        { "location": "2872/Talk", "narrator": "つばめ", "text": "よくわからないけど\n燃やしちゃった方が\nよくないですか？"},
        { "location": "2873/Talk", "narrator": "みやび", "text": "一番過激なんは\nつばめちゃんかい！"},
        { "location": "2874/Talk", "narrator": "つばめ", "text": "えぇーっ！？\nいきなり何を\n言い出すんですかっ！"},
        { "location": "2875/Talk", "narrator": "みやび", "text": "つばめちゃん、\n責めたらいかんよ。"},
        { "location": "2876/Talk", "narrator": "みやび", "text": "これぞ紳士の正しい\nリアクションぞね。"},
        { "location": "2877/Talk", "narrator": "つばめ", "text": "あの、どこらへんが\n紳士なのかさっぱり\nわかりませんけど。"},
        { "location": "2878/Talk", "narrator": "ガブリエラ", "text": "むしろそれは\n一生わからなくても\nいいことだから！"},
        { "location": "2879/Talk", "narrator": "みやび", "text": "ほほぅ……おぬし、\nうちの予想以上に\nできるようやな。"},
        { "location": "2880/Talk", "narrator": "つばめ", "text": "よくわかりませんけど\nわかっちゃいけない\n気がします。"},
        { "location": "2881/Talk", "narrator": "アーヤ", "text": "正しい判断よ。\nみやびはもう手遅れ\nだから仕方ないわ。"},
        { "location": "2882/Talk", "narrator": "みやび", "text": "うち、アーヤに\n見放されてもうた！"},
        { "location": "2883/Talk", "narrator": "ガブリエラ", "text": "えっ？\n……今さら？"},
        { "location": "2884/Talk", "narrator": "アーヤ", "text": "……念の為確認したい\nのだけれど、貰って\nどうするつもり？"},
        { "location": "2885/Talk", "narrator": "ガブリエラ", "text": "……ねぇ、知ってる？\n冗談にも限度があるって？"},
        { "location": "2886/Talk", "narrator": "つばめ", "text": "えー？　わたしは\n可愛いのなら\n着てもいいけどなぁ。"},
        { "location": "2887/Talk", "narrator": "みやび", "text": "うちは、泣くほど\n土下座で頼まれたら\n考えるけどな。"},
        { "location": "2888/Talk", "narrator": "アーヤ", "text": "私も時と場合と衣装に\nよっては考えるわ。"},
        { "location": "2889/Talk", "narrator": "ガブリエラ", "text": "えぇっ！？\n……何かみんな\nコイツに甘くない？"},
        { "location": "2890/Talk", "narrator": "ガブリエラ", "text": "通報するから\nそこを動くな。"},
        { "location": "2891/Talk", "narrator": "みやび", "text": "ガブちゃん、待ち。\nうちが写真に撮って\nからにしたって。"},
        { "location": "2892/Talk", "narrator": "ガブリエラ", "text": "精神攻撃アイテムの\n素材にでも使う気？"},
        { "location": "2893/Talk", "narrator": "アーヤ", "text": "……意外と可愛いかも\n知れないわよ？"},
        { "location": "2894/Talk", "narrator": "ガブリエラ", "text": "……アーヤ？"},
        { "location": "2895/Talk", "narrator": "アーヤ", "text": "ご、ごめんなさい。\n忘れてちょうだい。"},
        { "location": "2896/Talk", "narrator": "ガブリエラ", "text": "へぇ？　意外ね。\nアンタこういうの\n好きかと思ってたわ。"},
        { "location": "2897/Talk", "narrator": "みやび", "text": "ガブちゃん油断したら\nいかんぞね。"},
        { "location": "2898/Talk", "narrator": "みやび", "text": "こだわりがあるが故に\n他人の趣味が気に\n入らないちうことやき。"},
        { "location": "2899/Talk", "narrator": "つばめ", "text": "もっともーっと悪趣味かも\n知れないってこと？"},
        { "location": "2900/Talk", "narrator": "ガブリエラ", "text": "うわっ、褒めて損した。\n近寄らないでっ。"},
        { "location": "2901/Talk", "narrator": "アーヤ", "text": "こらギャヴィ、\nいくらなんでも\n言い過ぎよ……。"},
        { "location": "2902/Talk", "narrator": "みやび", "text": "つばめちゃん堪忍な。"},
        { "location": "2903/Talk", "narrator": "みやび", "text": "せやけどうちらには\n感傷に浸ってる時間は\n無い。"},
        { "location": "2904/Talk", "narrator": "みやび", "text": "常に前進し続けて\n鑑賞するのみや。"},
        { "location": "2905/Talk", "narrator": "ガブリエラ", "text": "えっ？\nもしかして上手いこと\n言ったつもり？"},
        { "location": "2906/Talk", "narrator": "みやび", "text": "滑るのを気にせん\n勇気は大事やき。"},
        { "location": "2907/Talk", "narrator": "つばめ", "text": "みやびさん、\n少しは気にして\nくださいっ！"},
        { "location": "2908/Talk", "narrator": "アーヤ", "text": "ええ、これには私も\nつばめに同意ね。"},
        { "location": "2909/Talk", "narrator": "みやび", "text": "アーヤ最近うちへの態度が\nぞんざいと違う？"},
        { "location": "2910/Talk", "narrator": "みやび", "text": "うちかてアーヤから\n見たら妹系やき、\n可愛がってや。"},
        { "location": "2911/Talk", "narrator": "アーヤ", "text": "……考えておくわ。"},
        { "location": "2912/Talk", "narrator": "みやび", "text": "したら再生環境の\n不具合と違うん？"},
        { "location": "2913/Talk", "narrator": "ガブリエラ", "text": "不具合のタイミング、\n誰かさんにとって\n都合が良すぎない？"},
        { "location": "2914/Talk", "narrator": "アーヤ", "text": "でも何もやってないと\n言うのなら私たちも\n信じるしかないわね。"},
        { "location": "2915/Talk", "narrator": "ガブリエラ", "text": "さすがアーヤ、\n静かにプレッシャーを\nかけてるわ……。"},
        { "location": "2916/Talk", "narrator": "ガブリエラ", "text": "みんなじゃなくて、\nアンタ一人だけの\n想いだから……。"},
        { "location": "2917/Talk", "narrator": "みやび", "text": "想いの力でそないな\nことまで出来るよう\nなるとはさすがやね。"},
        { "location": "2918/Talk", "narrator": "アーヤ", "text": "念の為に\n言っておくけど、\n褒めてないわよ？"},
        { "location": "2919/Talk", "narrator": "つばめ", "text": "アーヤさん、\n地味にこわいですっ！"},
        { "location": "2920/Talk", "narrator": "みやび", "text": "ほほぅ？\n君は結婚するなら\n神楽がええんき？"},
        { "location": "2921/Talk", "narrator": "つばめ", "text": "だったらまずは卯月さんの\n気持ちが第一ですから！"},
        { "location": "2922/Talk", "narrator": "ガブリエラ", "text": "じゃあ卯月がＯＫなら\nつばめは認めるわけ？"},
        { "location": "2923/Talk", "narrator": "つばめ", "text": "えっ……そ、それは、\nその……何て言うか、\nわたしとしては……。"},
        { "location": "2924/Talk", "narrator": "みやび", "text": "つばめちゃん、\n墓穴掘ってもうたな。"},
        { "location": "2925/Talk", "narrator": "つばめ", "text": "も、もうっ！\nからかわないで\nくださいっ！"},
        { "location": "2926/Talk", "narrator": "ガブリエラ", "text": "じゃあ誰と\n結婚したいのよ！？"},
        { "location": "2927/Talk", "narrator": "アーヤ", "text": "ギャヴィ落ち着いて。\nそれ以上追及したら\n不味い気がするわ。"},
        { "location": "2928/Talk", "narrator": "みやび", "text": "せやで。そこで\nガブちゃん言われたら\nどうする気や？"},
        { "location": "2929/Talk", "narrator": "ガブリエラ", "text": "ど、どうするって\nどうもしないし！\n全然しないからっ！！"},
        { "location": "2930/Talk", "narrator": "つばめ", "text": "ふぇぇっ！？\n卯月さんのお父さん\nだったんですかっ！？"},
        { "location": "2931/Talk", "narrator": "アーヤ", "text": "つばめ、それはそういう\n意味じゃないから……。"},
        { "location": "2932/Talk", "narrator": "ガブリエラ", "text": "でも言い方はともかく\n異議があるって点は\n褒めてあげるわ。"},
        { "location": "2933/Talk", "narrator": "みやび", "text": "まぁ、ついつい親心\n言うんが芽生える\n気持ちはわかる。"},
        { "location": "2934/Talk", "narrator": "ガブリエラ", "text": "みやびはさすがに\nどうかと思うけど。"},
        { "location": "2935/Talk", "narrator": "みやび", "text": "あー、ちょい待ち。\nうちから大事な\nお知らせがあるき。"},
        { "location": "2936/Talk", "narrator": "みやび", "text": "うち、次回のこれは\n休むきに勘弁したって。"},
        { "location": "2937/Talk", "narrator": "みやび", "text": "理由？\nそれは君の想像と妄想に\nおまかせするわ。"},
        { "location": "2938/Talk", "narrator": "ガブリエラ", "text": "うぅっ、何だか一刻も早く\nシャワー浴びたい！"},
        { "location": "2939/Talk", "narrator": "ガブリエラ", "text": "ホントああいう\nぬるぬる系だけは\n苦手なのよね。"},
        { "location": "2940/Talk", "narrator": "ガブリエラ", "text": "ていうか得意な女の子\nなんていないでしょ？"},
        { "location": "2941/Talk", "narrator": "つばめ", "text": "卯月さん、こんなところで\n続きなんてつらいだろうな。"},
        { "location": "2942/Talk", "narrator": "つばめ", "text": "でも次回はわたしが絶対に\n卯月さんを助けるから！"},
        { "location": "2943/Talk", "narrator": "つばめ", "text": "どんなことがあっても\nわたしたち……。"},
        { "location": "2944/Talk", "narrator": "つばめ", "text": "え、えーと……実は\n皆さんに残念な\nお知らせがあります。"},
        { "location": "2945/Talk", "narrator": "ガブリエラ", "text": "まぁ、何となく\n予想はつくから、早く\n言っちゃいなさいよ。"},
        { "location": "2946/Talk", "narrator": "みやび", "text": "何か最近このパターン\n多くない？\nマンネリは敵やぞ。"},
        { "location": "2947/Talk", "narrator": "アーヤ", "text": "とにかく聞きましょうか。\nつばめ？"},
        { "location": "2948/Talk", "narrator": "つばめ", "text": "あ、あの、卯月さんが\n今回のこれは\nお休みしたいって。"},
        { "location": "2949/Talk", "narrator": "ガブリエラ", "text": "何？\n前回はしゃぎ過ぎて\n疲れでもしたわけ？"},
        { "location": "2950/Talk", "narrator": "つばめ", "text": "そ、そうなのかな？\nわたしは全然何とも\nないけど……。"},
        { "location": "2951/Talk", "narrator": "みやび", "text": "まぁ、うちらは前回\n休んだようなもんやき\nあんま言えんし。"},
        { "location": "2952/Talk", "narrator": "ガブリエラ", "text": "何ならつばめも\n今回は卯月と一緒に\n休んでてもいいけど？"},
        { "location": "2953/Talk", "narrator": "つばめ", "text": "こうなったら、\nわたしは卯月さんの分も\nがんばりますからっ！"},
        { "location": "2954/Talk", "narrator": "みやび", "text": "ここはつばめちゃんが\n一肌脱ぐっちゅう\nわけやね。"},
        { "location": "2955/Talk", "narrator": "ガブリエラ", "text": "じゃあ、あたしたちは\n今回もつばめに任せて\n楽しようかしら。"},
        { "location": "2956/Talk", "narrator": "つばめ", "text": "それは全国２０７人の\nガブちゃんファンが\n可哀相かなぁ。"},
        { "location": "2957/Talk", "narrator": "ガブリエラ", "text": "ちょっと！　あたしの\nファン、妙にリアルに\n少なすぎないっ！？"},
        { "location": "2958/Talk", "narrator": "アーヤ", "text": "とにかくこうなったら\n今回は私たち４人で\n盛り上げましょう。"},
        { "location": "2959/Talk", "narrator": "みやび", "text": "まぁ、滑った時は\nつばめちゃんが脱いで\nくれる言うてるし。"},
        { "location": "2960/Talk", "narrator": "つばめ", "text": "……何の話かな？"},
        { "location": "2961/Talk", "narrator": "アーヤ", "text": "さて、いきなりだけど\nフェノメノンの現場に\nいる状況みたいね。"},
        { "location": "2962/Talk", "narrator": "ガブリエラ", "text": "つばめと神楽は\n秋葉原から電車で\n直行したんでしょ？"},
        { "location": "2963/Talk", "narrator": "つばめ", "text": "あー……はい……、\n卯月さんが乗り継ぎに\n詳しかったので……。"},
        { "location": "2964/Talk", "narrator": "アーヤ", "text": "交通費の請求は\n後できちんと館長に\n出しておくのよ？"},
        { "location": "2965/Talk", "narrator": "ガブリエラ", "text": "忘れがちだけど、\nあたしら国家公務員\nだからね。"},
        { "location": "2966/Talk", "narrator": "みやび", "text": "まぁ、それは置いといて、\nいよいよゲームスタート\nやよ。"},
        { "location": "2967/Talk", "narrator": "ガブリエラ", "text": "ていうか、ゲームって\n聞いてたから、もっと\n凄いのかと思ってた。"},
        { "location": "2968/Talk", "narrator": "つばめ", "text": "すごろく？\nみたいですよね？"},
        { "location": "2969/Talk", "narrator": "みやび", "text": "アマチュアが頑張って\n作ったんやき、そこは\n生温い目で見たって。"},
        { "location": "2970/Talk", "narrator": "ガブリエラ", "text": "発症者の才能というか\n想像力の問題なんでしょ。"},
        { "location": "2971/Talk", "narrator": "みやび", "text": "ガブちゃん辛辣やわー。\n心折りに来てるわー。"},
        { "location": "2972/Talk", "narrator": "ガブリエラ", "text": "さっきから何で発症者に\n肩入れしてるのよ……。"},
        { "location": "2973/Talk", "narrator": "つばめ", "text": "ところで、意外にも\nみやびさんはゲームに\n参加しないんですね。"},
        { "location": "2974/Talk", "narrator": "ガブリエラ", "text": "確かに、こういうの\n好きそうな感じだもんね。"},
        { "location": "2975/Talk", "narrator": "みやび", "text": "それは勘違いぞね。\nこう見えてもうちは\nインドア派やき。"},
        { "location": "2976/Talk", "narrator": "アーヤ", "text": "つまり、体を動かす\nゲームにはそれほど\n興味が無いと。"},
        { "location": "2977/Talk", "narrator": "みやび", "text": "ちなみに画面の向こうの\n君はどっち派なん？"},
        { "location": "2978/Talk", "narrator": "ガブリエラ", "text": "何いきなり\n間の抜けた声を\n出してるのよ。"},
        { "location": "2979/Talk", "narrator": "つばめ", "text": "えっ？　ちょっと\n驚いただけなんだけど\nそんな変な声だった？"},
        { "location": "2980/Talk", "narrator": "アーヤ", "text": "べつに可愛いから\nいいんじゃないかしら。"},
        { "location": "2981/Talk", "narrator": "ガブリエラ", "text": "アーヤ……。"},
        { "location": "2982/Talk", "narrator": "ガブリエラ", "text": "ねぇ、つばめ、\nこれ何でわざわざ\n神楽に声かけたの？"},
        { "location": "2983/Talk", "narrator": "つばめ", "text": "この時の卯月さんは\n何だか普段と違ってた\n気がして……。"},
        { "location": "2984/Talk", "narrator": "アーヤ", "text": "ええ、確かに、\n何か焦っている感じでは\nあったわね。"},
        { "location": "2985/Talk", "narrator": "みやび", "text": "ここでエンカウント！\n双六だけちゅう\nわけにはいかんきね。"},
        { "location": "2986/Talk", "narrator": "ガブリエラ", "text": "みやびはゲームの外だった\nから気楽でいいわよね。"},
        { "location": "2987/Talk", "narrator": "みやび", "text": "うちはうちでこれでも\n頑張ってたんやき、\nそこは堪忍や。"},
        { "location": "2988/Talk", "narrator": "つばめ", "text": "ふぇっ？　虎の子？\n……猛獣使い？"},
        { "location": "2989/Talk", "narrator": "アーヤ", "text": "つばめ、それはそのままの\n意味じゃなくて……。"},
        { "location": "2990/Talk", "narrator": "みやび", "text": "ええよつばめちゃん。\n隙あらばボケる姿勢。\nそれでこそや。"},
        { "location": "2991/Talk", "narrator": "つばめ", "text": "ふえっ？\n……よくわからないけど、\n褒められたのかな？"},
        { "location": "2992/Talk", "narrator": "ガブリエラ", "text": "……まぁ、\nそう思っておけば\nいいんじゃない？"},
        { "location": "2993/Talk", "narrator": "つばめ", "text": "あっ、今回はガブちゃんも\n大活躍だねっ。"},
        { "location": "2994/Talk", "narrator": "ガブリエラ", "text": "今回「も」でしょ！\n正しい日本語を\n使いなさいよ！"},
        { "location": "2995/Talk", "narrator": "つばめ", "text": "あぁっ！！\nそんなことより\n卯月さんがっ！！"},
        { "location": "2996/Talk", "narrator": "ガブリエラ", "text": "……まぁ、いいけど、\nこの時の神楽はホント\nおかしかったわよね。"},
        { "location": "2997/Talk", "narrator": "アーヤ", "text": "相手にルールを掌握\nされている状況での\n無茶は禁物ね。"},
        { "location": "2998/Talk", "narrator": "つばめ", "text": "これってみやびさんが\nさっきまほさんに\n頼んでたやつですか？"},
        { "location": "2999/Talk", "narrator": "みやび", "text": "そうや。\n迅速な配達御苦労様やき。\n感謝感謝や。"},
        { "location": "3000/Talk", "narrator": "ガブリエラ", "text": "ていうか何でわざわざ\n現場まで持って来させ\nてるわけ？"},
        { "location": "3001/Talk", "narrator": "ガブリエラ", "text": "スパコンくらいネット回線\n経由で使えるでしょ？"},
        { "location": "3002/Talk", "narrator": "みやび", "text": "フェノメノンの現場で\nセンサーと繋げんと\n意味無いんや。"},
        { "location": "3003/Talk", "narrator": "みやび", "text": "僅かな伝送損失や\n遅延、ノイズも\n命取りになるんやよ。"},
        { "location": "3004/Talk", "narrator": "つばめ", "text": "ていうか何でわたしが\n名指しなの！？"},
        { "location": "3005/Talk", "narrator": "ガブリエラ", "text": "あんたの日頃の\n行いなんじゃない？"},
        { "location": "3006/Talk", "narrator": "つばめ", "text": "そ、そう言われると\n心当たりがあるような\n気がしてきた……。"},
        { "location": "3007/Talk", "narrator": "みやび", "text": "あるんかい！\n（定例ツッコミ）"},
        { "location": "3008/Talk", "narrator": "アーヤ", "text": "特に意味は無いんじゃ\nないかしら？　単に\n呼びやすかったとか。"},
        { "location": "3009/Talk", "narrator": "つばめ", "text": "あぁっ！\n卯月さん、一人で行っちゃ\nだめぇーっ！！"},
        { "location": "3010/Talk", "narrator": "アーヤ", "text": "時間制限にまんまと\n釣られてしまったと\nいうことかしら。"},
        { "location": "3011/Talk", "narrator": "つばめ", "text": "あの、そんな冷静に分析し\nてる場合じゃなくて……。"},
        { "location": "3012/Talk", "narrator": "ガブリエラ", "text": "って言っても、これ事象を\n客観視してるだけだし。"},
        { "location": "3013/Talk", "narrator": "みやび", "text": "ガブちゃん、それは\n裏設定好きが騒ぐから\n言うたらいかんち。"},
        { "location": "3014/Talk", "narrator": "アーヤ", "text": "映画館で観た作品を\n再度ビデオで見ている\nようなものなのかと。"},
        { "location": "3015/Talk", "narrator": "つばめ", "text": "わたし、何だか急に\nポテチと炭酸系が\n欲しくなりました！"},
        { "location": "3016/Talk", "narrator": "みやび", "text": "宅配ピザ頼むのも\n忘れんといてやー。"},
        { "location": "3017/Talk", "narrator": "ガブリエラ", "text": "そういうのは画面の\n向こうの誰かさんが\nやってるんじゃない？"},
        { "location": "3018/Talk", "narrator": "アーヤ", "text": "素人の作ったゲームは\nセキュリティが甘いと\n言うことかしら。"},
        { "location": "3019/Talk", "narrator": "ガブリエラ", "text": "甘いというか、そんなの\n後回しなんじゃない？"},
        { "location": "3020/Talk", "narrator": "つばめ", "text": "ほえー、あの敵の手って\nバラバラになるんですねー。"},
        { "location": "3021/Talk", "narrator": "みやび", "text": "つばめちゃん、\nそのリアクションは\nＮＯ　ＧＯＯＤや。"},
        { "location": "3022/Talk", "narrator": "つばめ", "text": "ふぇっ！？"},
        { "location": "3023/Talk", "narrator": "ガブリエラ", "text": "こんなのただ「キモっ」で\nいいじゃない……。"},
        { "location": "3024/Talk", "narrator": "みやび", "text": "画面の向こうの君、\n正しいリアクション\n見せてやってや。"},
        { "location": "3025/Talk", "narrator": "つばめ", "text": "ひょわぁぁっ！？\nこれはわかります！\nさすがにキモいです！"},
        { "location": "3026/Talk", "narrator": "ガブリエラ", "text": "……何か今、見ては\nいけない物が流れてた\n気がするんだけど！？"},
        { "location": "3027/Talk", "narrator": "みやび", "text": "ゲーム廃人の\nマニアックな趣味的に\nスク水は外せんやき。"},
        { "location": "3028/Talk", "narrator": "ガブリエラ", "text": "何でみやびが\nそんなことに理解を\n示してるのよ……。"},
        { "location": "3029/Talk", "narrator": "つばめ", "text": "あれっ？\nあの衣装って\nどこかで……？"},
        { "location": "3030/Talk", "narrator": "つばめ", "text": "すとぉぉぉっぷっ！！\nここだめっ！\nこれ以上はだめっ！！"},
        { "location": "3031/Talk", "narrator": "つばめ", "text": "だめったら\nだめぇーっ！！"},
        { "location": "3032/Talk", "narrator": "つばめ", "text": "って！\n何ですぐ止まったのっ！？\n誰ですかっ！？"},
        { "location": "3033/Talk", "narrator": "ガブリエラ", "text": "誰って言われても\nあたしじゃないわよ？"},
        { "location": "3034/Talk", "narrator": "アーヤ", "text": "念の為に答えるけど\n私でもないわ。"},
        { "location": "3035/Talk", "narrator": "つばめ", "text": "となると、やっぱり……。"},
        { "location": "3036/Talk", "narrator": "みやび", "text": "うちも違うぞね！\n濡れ衣は勘弁や。"},
        { "location": "3037/Talk", "narrator": "つばめ", "text": "えっ……じゃあ、\nもしかして……、\n$handle$さん？"},
        { "location": "3038/Talk", "narrator": "みやび", "text": "なるほど。\nみんな行動ポイント\n０で動けんわけね。"},
        { "location": "3039/Talk", "narrator": "ガブリエラ", "text": "全く忌々しいったら\nなかったわよ。\nこんな変なルール。"},
        { "location": "3040/Talk", "narrator": "アーヤ", "text": "ここまでやっておいて\nわきまえてるなんて\nよく言えるわね。"},
        { "location": "3041/Talk", "narrator": "みやび", "text": "でも、あやうく発禁に\nなるとこだったぞね。\n世界の危機やった。"},
        { "location": "3042/Talk", "narrator": "つばめ", "text": "こういうのはスタイル\n抜群なみやびさんの\n役目じゃないですか？"},
        { "location": "3043/Talk", "narrator": "みやび", "text": "つばめちゃん、\nそれ褒めてるようで\n微妙に酷いで……。"},
        { "location": "3044/Talk", "narrator": "ガブリエラ", "text": "まさかみやび、\nこれを予想して後方に\nいたんじゃ……。"},
        { "location": "3045/Talk", "narrator": "みやび", "text": "それは濡れ衣や！\nうちならこれはこれで\n美味しい展開やき。"},
        { "location": "3046/Talk", "narrator": "アーヤ", "text": "さぁ、そんなことより\nいよいよこっちの\n反撃ターンよ！"},
        { "location": "3047/Talk", "narrator": "ガブリエラ", "text": "何でここで神楽のこと\nメノウって呼んだの？\nこっちも混乱したわ。"},
        { "location": "3048/Talk", "narrator": "つばめ", "text": "これは、その、本気で\nメノウちゃんだって\n思ってたんじゃなくて"},
        { "location": "3049/Talk", "narrator": "つばめ", "text": "ドームの時のことを\n急に思い出しちゃって\nつい……。"},
        { "location": "3050/Talk", "narrator": "アーヤ", "text": "あの時の光景がリフレイン\nされたせいだったのね。"},
        { "location": "3051/Talk", "narrator": "つばめ", "text": "あの時メノウちゃんを\n助けられなかったから\n今度こそ助けたいって"},
        { "location": "3052/Talk", "narrator": "つばめ", "text": "卯月さんを同じ目に\n遭わせたくないって\n思ったからなのかも。"},
        { "location": "3053/Talk", "narrator": "ガブリエラ", "text": "なるほど、そういう\nことだったのね。\n勘違いしてたわ。"},
        { "location": "3054/Talk", "narrator": "みやび", "text": "うちもてっきり\nつばめちゃんの\n不思議パワーかと。"},
        { "location": "3055/Talk", "narrator": "みやび", "text": "つばめちゃん\n言い切りよった！\nここかっこいいわ。"},
        { "location": "3056/Talk", "narrator": "アーヤ", "text": "でも何か含みが\nありそうなセリフでは\nあったわね。"},
        { "location": "3057/Talk", "narrator": "ガブリエラ", "text": "つばめがそこまで\n考えて言ってるとは\nとても思えないけど。"},
        { "location": "3058/Talk", "narrator": "つばめ", "text": "わたしだってすっごく\nたまに少しは考えて\n言ってるもんっ！"},
        { "location": "3059/Talk", "narrator": "ガブリエラ", "text": "うわっ、ダメっ！\nキモ過ぎて鳥肌立った！"},
        { "location": "3060/Talk", "narrator": "みやび", "text": "ウナギやと思えば\n少しは我慢できるんと違う？"},
        { "location": "3061/Talk", "narrator": "ガブリエラ", "text": "どうしてそんなので\n我慢できるのよ！？"},
        { "location": "3062/Talk", "narrator": "ガブリエラ", "text": "ていうか、つばめ、\nファン失格って\n言われてるけど？"},
        { "location": "3063/Talk", "narrator": "つばめ", "text": "そう言われちゃっても\n仕方ないかも\n知れないけど……。"},
        { "location": "3064/Talk", "narrator": "ガブリエラ", "text": "みやび、それ、\nこんな最中に短時間で\n調べたわけ？"},
        { "location": "3065/Talk", "narrator": "みやび", "text": "この程度の個人情報、\nうちにかかれば\n簡単過ぎぞね。"},
        { "location": "3066/Talk", "narrator": "つばめ", "text": "じゃあ何で今まで\n突き止めてなかったん\nですか？"},
        { "location": "3067/Talk", "narrator": "みやび", "text": "興味無い言うんは疑う\n以前に事象そのものが\n存在せんきに。"},
        { "location": "3068/Talk", "narrator": "つばめ", "text": "え、えーと……、\n何だかわかったような\nわからないような？"},
        { "location": "3069/Talk", "narrator": "アーヤ", "text": "あっ、一応館長の為に\n補足しておくけど、\nここ勘違いしないで。"},
        { "location": "3070/Talk", "narrator": "アーヤ", "text": "これって館長が卯月の\n正体を隠そうとして\nいるわけじゃないの。"},
        { "location": "3071/Talk", "narrator": "アーヤ", "text": "館長も卯月がメノウと\n同一人物だってことは\n知らなかったのよ。"},
        { "location": "3072/Talk", "narrator": "みやび", "text": "作戦に支障が出そうな\n会話をしてるなってこと\nやったんやね。"},
        { "location": "3073/Talk", "narrator": "つばめ", "text": "えっ、わたしてっきり\n真幌さんが隠してたのかと。"},
        { "location": "3074/Talk", "narrator": "ガブリエラ", "text": "ていうか、それここで\nバラしちゃって\n大丈夫なわけ？"},
        { "location": "3075/Talk", "narrator": "アーヤ", "text": "ええ、館長が、絶対に\n悪人だと思われたって\n気にしてたから……。"},
        { "location": "3076/Talk", "narrator": "ガブリエラ", "text": "まほ……、意外と\nメンタル弱いわよね。"},
        { "location": "3077/Talk", "narrator": "つばめ", "text": "ま、真幌さん、\nごめんなさい……。"},
        { "location": "3078/Talk", "narrator": "アーヤ", "text": "とりあえず館長の疑惑が\n晴れてよかったわ。"},
        { "location": "3079/Talk", "narrator": "アーヤ", "text": "とは言っても、楽観できる\n状況じゃないわね。"},
        { "location": "3080/Talk", "narrator": "アーヤ", "text": "次回も私たち自身が\n暗くならないように\n気をつけないとね。"}
    ]
}
