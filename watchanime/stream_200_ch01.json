{
    "dir": "stream_200_ch01.json",
    "type": "watchanime",
    "info": {
    },
    "entry":
    [
        { "location": "4026/Talk", "narrator": "ガブリエラ", "text": "え！？\nあ、ああ、これ…？"},
        { "location": "4027/Talk", "narrator": "ガブリエラ", "text": "これはその、あれよ…\n$handle$が\n喜ぶかなと思って……"},
        { "location": "4028/Talk", "narrator": "ガブリエラ", "text": "せっかくだし、\nちょっとだけ羽目\n外しちゃおうかなって！"},
        { "location": "4029/Talk", "narrator": "ガブリエラ", "text": "ていうか、こんな事\nやったなんて、絶対\nみんなに内緒だからね？"},
        { "location": "4030/Talk", "narrator": "ガブリエラ", "text": "いい？\nわかった！？"},
        { "location": "4031/Talk", "narrator": "ガブリエラ", "text": "まあいいわ。\nそんなことより、\n映像見るんでしょ？"},
        { "location": "4032/Talk", "narrator": "ガブリエラ", "text": "まったく、\n$handle$のせいで\n全然進まないんだから。"},
        { "location": "4033/Talk", "narrator": "ガブリエラ", "text": "ふふ、よかった。"},
        { "location": "4034/Talk", "narrator": "ガブリエラ", "text": "はぁ！？"},
        { "location": "4035/Talk", "narrator": "ガブリエラ", "text": "わけわからないこと\n言わないの！"},
        { "location": "4036/Talk", "narrator": "ガブリエラ", "text": "そ、そうね！\n二人だけの秘密！"},
        { "location": "4037/Talk", "narrator": "ガブリエラ", "text": "だから絶対秘密よ！？"},
        { "location": "4038/Talk", "narrator": "ガブリエラ", "text": "ちょ、ちょっとやめてよ！"},
        { "location": "4039/Talk", "narrator": "ガブリエラ", "text": "言ったらホントに\n許さないんだからぁっ！"},
        { "location": "4040/Talk", "narrator": "ガブリエラ", "text": "…ホントにもう。"},
        { "location": "4041/Talk", "narrator": "ガブリエラ", "text": "あら。なんか\nパッとしない返事ね。"},
        { "location": "4042/Talk", "narrator": "ガブリエラ", "text": "まあいいわ。"},
        { "location": "4043/Talk", "narrator": "ガブリエラ", "text": "あんたがどう思おうとも、\n今回は他の子たちは\n来ないんだし。"},
        { "location": "4044/Talk", "narrator": "ガブリエラ", "text": "ま、観念して\nあたしと二人で\n見ることになさい。"},
        { "location": "4045/Talk", "narrator": "ガブリエラ", "text": "ちょっと違うかしら。"},
        { "location": "4046/Talk", "narrator": "ガブリエラ", "text": "まあ、自分でバラすのも\n恥ずかしいし、気になる\nなら映像見返してみれば？"},
        { "location": "4047/Talk", "narrator": "ガブリエラ", "text": "うっ……。\n鋭いわね。"},
        { "location": "4048/Talk", "narrator": "ガブリエラ", "text": "まったく、つばめったら\n本当にデリカシー\n無い子よね。"},
        { "location": "4049/Talk", "narrator": "ガブリエラ", "text": "あたしがみっちり\n教えてあげなくちゃ\nだわよ。"},
        { "location": "4050/Talk", "narrator": "ガブリエラ", "text": "え？\nあー、それはね……"},
        { "location": "4051/Talk", "narrator": "ガブリエラ", "text": "はあっ？"},
        { "location": "4052/Talk", "narrator": "ガブリエラ", "text": "そんなのが\n可愛いわけないじゃん…。"},
        { "location": "4053/Talk", "narrator": "ガブリエラ", "text": "第一、この悩みは\nあたしの中ではすごく\n重大な悩みなのよ。"},
        { "location": "4054/Talk", "narrator": "ガブリエラ", "text": "そ、そうかしら？"},
        { "location": "4055/Talk", "narrator": "ガブリエラ", "text": "これくらいの表現\n別に誰だって出来るわよ。"},
        { "location": "4056/Talk", "narrator": "ガブリエラ", "text": "なんでも可愛いで\n済ませようとするの、\nどうかと思うのよ。"},
        { "location": "4057/Talk", "narrator": "ガブリエラ", "text": "なっ！！"},
        { "location": "4058/Talk", "narrator": "ガブリエラ", "text": "なんでも可愛いで\n済まされると思ったら\n大間違いなんだから！"},
        { "location": "4059/Talk", "narrator": "ガブリエラ", "text": "っていうか、\n何よこの映像！"},
        { "location": "4060/Talk", "narrator": "ガブリエラ", "text": "勝手に人の寝姿を\n撮影するなんて！\n盗撮じゃない盗撮！"},
        { "location": "4061/Talk", "narrator": "ガブリエラ", "text": "全くもう！\n……まあ。"},
        { "location": "4062/Talk", "narrator": "ガブリエラ", "text": "$handle$が\n可愛いって言ってるし\n別にいいんだけど！"},
        { "location": "4063/Talk", "narrator": "ガブリエラ", "text": "そ、そうかしら！？"},
        { "location": "4064/Talk", "narrator": "ガブリエラ", "text": "ま、別にこんなの、\n何の変哲もない日常の\n姿でしかないんだけど。"},
        { "location": "4065/Talk", "narrator": "ガブリエラ", "text": "もっとレディな姿だって\nいっぱいあるのに、なんで\nこのシーンなのかしらね。"},
        { "location": "4066/Talk", "narrator": "ガブリエラ", "text": "あっ、そっか。\n$handle$にとって\n刺激が強すぎるからよね。"},
        { "location": "4067/Talk", "narrator": "ガブリエラ", "text": "ほんと、\n$handle$ったら\nお子ちゃまなんだから。"},
        { "location": "4068/Talk", "narrator": "ガブリエラ", "text": "ちょ、ちょっと！"},
        { "location": "4069/Talk", "narrator": "ガブリエラ", "text": "お子ちゃまなのは\nあたしじゃなくて\n$handle$の方よ！"},
        { "location": "4070/Talk", "narrator": "ガブリエラ", "text": "まったく、\n失礼しちゃうわね。"},
        { "location": "4071/Talk", "narrator": "ガブリエラ", "text": "え……えええっ！？"},
        { "location": "4072/Talk", "narrator": "ガブリエラ", "text": "じゃなくて…"},
        { "location": "4073/Talk", "narrator": "ガブリエラ", "text": "そ、そうね！\nあたしは全然\n構わないわよ？"},
        { "location": "4074/Talk", "narrator": "ガブリエラ", "text": "でも、\n$handle$にはまだ\n刺激が強すぎると思うの。"},
        { "location": "4075/Talk", "narrator": "ガブリエラ", "text": "だから、また\nいずれ時期が来たら\n見せてあげるわ。"},
        { "location": "4076/Talk", "narrator": "ガブリエラ", "text": "ああ、この辺の\nポーランド語？"},
        { "location": "4077/Talk", "narrator": "ガブリエラ", "text": "ここは全然大した事\n言ってないんだけど……"},
        { "location": "4078/Talk", "narrator": "ガブリエラ", "text": "『美しい白は\n炊きたてご飯の白』って\n言ってるのよ。"},
        { "location": "4079/Talk", "narrator": "ガブリエラ", "text": "はい、ここまで！"},
        { "location": "4080/Talk", "narrator": "ガブリエラ", "text": "正解は、日本と\nポーランドの国旗。"},
        { "location": "4081/Talk", "narrator": "ガブリエラ", "text": "両方とも赤と白だけで\n作られてるでしょ？"},
        { "location": "4082/Talk", "narrator": "ガブリエラ", "text": "だから、ふたつの国が\n使ってる白と赤って、\n素敵よね♪　って歌なの。"},
        { "location": "4083/Talk", "narrator": "ガブリエラ", "text": "教えてあげてもいいけど、\nまずはクイズにして\nみようかしら。"},
        { "location": "4084/Talk", "narrator": "ガブリエラ", "text": "ここから先の歌詞を\n聴いて、ある共通の\n法則を見いだしてみて？"},
        { "location": "4085/Talk", "narrator": "ガブリエラ", "text": "白と言えば！？"},
        { "location": "4086/Talk", "narrator": "ガブリエラ", "text": "ヒントはここから先の\n歌詞にあるわよ。"},
        { "location": "4087/Talk", "narrator": "ガブリエラ", "text": "もう少し聴いて、\nある共通の法則を\n見いだしてみて？"},
        { "location": "4088/Talk", "narrator": "ガブリエラ", "text": "あらら……。"},
        { "location": "4089/Talk", "narrator": "ガブリエラ", "text": "もうっ！\nそういうのはいいから！"},
        { "location": "4090/Talk", "narrator": "ガブリエラ", "text": "ちょっ！！\nいきなり何を\n言い出すのよ！"},
        { "location": "4091/Talk", "narrator": "ガブリエラ", "text": "あたしなんて、全然\n純白なんかじゃないし…。"},
        { "location": "4092/Talk", "narrator": "ガブリエラ", "text": "……って、そんなこと\nどうでもいいのよ。\nとにかくハズレよ。"},
        { "location": "4093/Talk", "narrator": "ガブリエラ", "text": "残念！\nワインは関係ないわね。"},
        { "location": "4094/Talk", "narrator": "ガブリエラ", "text": "あたり！\nすごいわね！"},
        { "location": "4095/Talk", "narrator": "ガブリエラ", "text": "ちょ、ちょっと！\nあまりそういう所に\n目を向けないの！"},
        { "location": "4096/Talk", "narrator": "ガブリエラ", "text": "乙女の私生活を見られる\nだけでも素晴らしい\nことなのよ？"},
        { "location": "4097/Talk", "narrator": "ガブリエラ", "text": "だから、こういう時は\n感謝しつつ黙って\n見るものなの。いい？"},
        { "location": "4098/Talk", "narrator": "ガブリエラ", "text": "素直で素敵ね。"},
        { "location": "4099/Talk", "narrator": "ガブリエラ", "text": "え！？\nご褒美！？"},
        { "location": "4100/Talk", "narrator": "ガブリエラ", "text": "正直、喜ばれるとは\n思わなかったわね。"},
        { "location": "4101/Talk", "narrator": "ガブリエラ", "text": "あ、あら、そう？"},
        { "location": "4102/Talk", "narrator": "ガブリエラ", "text": "まったく、\n$handle$ったら！"},
        { "location": "4103/Talk", "narrator": "ガブリエラ", "text": "にしてもこの映像、もっと\nレディな姿を選りすぐって\n欲しかったわね……。"},
        { "location": "4104/Talk", "narrator": "ガブリエラ", "text": "まったくもう。\n油断も隙も無いんだから。"},
        { "location": "4105/Talk", "narrator": "ガブリエラ", "text": "な、なによもーーっ！！"},
        { "location": "4106/Talk", "narrator": "ガブリエラ", "text": "悪い！？\nいいじゃない別に！！"},
        { "location": "4107/Talk", "narrator": "ガブリエラ", "text": "な、なによーーっ！！"},
        { "location": "4108/Talk", "narrator": "ガブリエラ", "text": "そんな言い方されたら\n怒るに怒れないじゃない…\nもうっ！！"},
        { "location": "4109/Talk", "narrator": "ガブリエラ", "text": "あら、意見が合うわね。"},
        { "location": "4110/Talk", "narrator": "ガブリエラ", "text": "いろんな味があって\n全然飽きないのよね。"},
        { "location": "4111/Talk", "narrator": "ガブリエラ", "text": "あたしが一番好きなのは\nツナマヨなのよ。面白みが\n無いって言われるけど。"},
        { "location": "4112/Talk", "narrator": "ガブリエラ", "text": "ああっ！\nわかってくれる？\nお仲間ね♪"},
        { "location": "4113/Talk", "narrator": "ガブリエラ", "text": "ご飯とツナって本当に\nよく合うわよね！"},
        { "location": "4114/Talk", "narrator": "ガブリエラ", "text": "ええっ！？\n$handle$も\n邪道派なの！？"},
        { "location": "4115/Talk", "narrator": "ガブリエラ", "text": "前にみやびにも\n同じ事を言われたわ。"},
        { "location": "4116/Talk", "narrator": "ガブリエラ", "text": "おにぎりと言えば\n梅干しか昆布か\nおかかだって。"},
        { "location": "4117/Talk", "narrator": "ガブリエラ", "text": "梅干しとかも、\n別に嫌いじゃないのよ？"},
        { "location": "4118/Talk", "narrator": "ガブリエラ", "text": "でも、美味しいんだから\n正道も邪道も\n無いと思うの！"},
        { "location": "4119/Talk", "narrator": "ガブリエラ", "text": "…なによ、その\n無理矢理な公式は。"},
        { "location": "4120/Talk", "narrator": "ガブリエラ", "text": "やっぱり「かわいい」って\n言いたいだけなんじゃ\nないの？"},
        { "location": "4121/Talk", "narrator": "ガブリエラ", "text": "そりゃ、かわいいって\n言われたら……嬉しく\nなくはないけど――"},
        { "location": "4122/Talk", "narrator": "ガブリエラ", "text": "でも、たまには\n他の言葉も欲しいわね…。"},
        { "location": "4123/Talk", "narrator": "ガブリエラ", "text": "あ、それ\nちょっといい……"},
        { "location": "4124/Talk", "narrator": "ガブリエラ", "text": "って、やっぱり\nカワイイって\nことじゃない！"},
        { "location": "4125/Talk", "narrator": "ガブリエラ", "text": "撃つわよ！"},
        { "location": "4126/Talk", "narrator": "ガブリエラ", "text": "「みたい」じゃなくて\nあたしは\nソルジャーだから！"},
        { "location": "4127/Talk", "narrator": "ガブリエラ", "text": "まったく、\n失礼しちゃうわね。"},
        { "location": "4128/Talk", "narrator": "ガブリエラ", "text": "いいこと？\nこれが普段のあたしなの。\nわかったかしら？"},
        { "location": "4129/Talk", "narrator": "ガブリエラ", "text": "ち、ちがうわ――"},
        { "location": "4130/Talk", "narrator": "ガブリエラ", "text": "……そうよ？\nビターでしょ？"},
        { "location": "4131/Talk", "narrator": "ガブリエラ", "text": "ちょっ…やめてよ！\nただのお菓子よ！！"},
        { "location": "4132/Talk", "narrator": "ガブリエラ", "text": "あ、いけない…。"},
        { "location": "4133/Talk", "narrator": "ガブリエラ", "text": "もーっ！\n$handle$ってば\n意地悪すぎよ！！"},
        { "location": "4134/Talk", "narrator": "ガブリエラ", "text": "ち、違うわよ！\n失礼しちゃうわね！"},
        { "location": "4135/Talk", "narrator": "ガブリエラ", "text": "こうして見ると\nなかなかオトナな感じが\nしてこないかしら？"},
        { "location": "4136/Talk", "narrator": "ガブリエラ", "text": "はぁ、もういいわ。"},
        { "location": "4137/Talk", "narrator": "ガブリエラ", "text": "な、なあに？\nそのぎこちない返事は？"},
        { "location": "4138/Talk", "narrator": "ガブリエラ", "text": "なんでそうなるのよ……。"},
        { "location": "4139/Talk", "narrator": "ガブリエラ", "text": "は！？"},
        { "location": "4140/Talk", "narrator": "ガブリエラ", "text": "いつもじゃないから！\nたまたまよ、たまたま！"},
        { "location": "4141/Talk", "narrator": "ガブリエラ", "text": "そ、そう？"},
        { "location": "4142/Talk", "narrator": "ガブリエラ", "text": "…って、そんな所ばかり\n見て、ちょっと\n不埒なんじゃないかしら！"},
        { "location": "4143/Talk", "narrator": "ガブリエラ", "text": "えっ？\nな、なんか\n素直すぎじゃない？"},
        { "location": "4144/Talk", "narrator": "ガブリエラ", "text": "ま、まあ別にいいのよ？\nエッチな気持ちで見ている\nのでなければ全然。"},
        { "location": "4145/Talk", "narrator": "ガブリエラ", "text": "ええええっ！？"},
        { "location": "4146/Talk", "narrator": "ガブリエラ", "text": "ちょ、ちょっと何よ！\nなんでここでそんな\n大胆発言！？"},
        { "location": "4147/Talk", "narrator": "ガブリエラ", "text": "そんなこと言われたら\n怒れなくなっちゃうし…\nず、ずるいわよ！？"},
        { "location": "4148/Talk", "narrator": "ガブリエラ", "text": "あ、そうね。\n確かにちょっとわからない\nかもしれないわよね。"},
        { "location": "4149/Talk", "narrator": "ガブリエラ", "text": "いいわ、教えてあげる。"},
        { "location": "4150/Talk", "narrator": "ガブリエラ", "text": "今のここまでの\nポーランド語は――"},
        { "location": "4151/Talk", "narrator": "ガブリエラ", "text": "『プラツキとドラヤキ\n　どっちが美味しいか\n　なんて愚問よ』ね。"},
        { "location": "4152/Talk", "narrator": "ガブリエラ", "text": "次のセンテンスからは\n聴きながら翻訳して\nいくわね。"},
        { "location": "4153/Talk", "narrator": "ガブリエラ", "text": "『どっちにもキュートな\n　エッセンスが盛り\n　込まれているもの』"},
        { "location": "4154/Talk", "narrator": "ガブリエラ", "text": "『そう、恋と同じで\n　個性も魅力も十人十色』"},
        { "location": "4155/Talk", "narrator": "ガブリエラ", "text": "『どっちもあたしの\n　一番好きなモノ』"},
        { "location": "4156/Talk", "narrator": "ガブリエラ", "text": "…とまあ、\nこんな感じかしらね。"},
        { "location": "4157/Talk", "narrator": "ガブリエラ", "text": "はいはい、ありがと。"},
        { "location": "4158/Talk", "narrator": "ガブリエラ", "text": "でも、実はちょっと\nここの振り付け\n気に入ってるのよね。"},
        { "location": "4159/Talk", "narrator": "ガブリエラ", "text": "だから嬉しいかも。"},
        { "location": "4160/Talk", "narrator": "ガブリエラ", "text": "今度一緒に\n踊ってみない？"},
        { "location": "4161/Talk", "narrator": "ガブリエラ", "text": "ふふ。そうね！"},
        { "location": "4162/Talk", "narrator": "ガブリエラ", "text": "$handle$と\n一緒に踊れたら\nちょっと素敵かも。"},
        { "location": "4163/Talk", "narrator": "ガブリエラ", "text": "あーあ、\n早くそんな日が\n来ればいいのになぁ。"},
        { "location": "4164/Talk", "narrator": "ガブリエラ", "text": "あ、ここはね、"},
        { "location": "4165/Talk", "narrator": "ガブリエラ", "text": "『両国の末永い\n　繁栄と友好を願って』\nって言ってるのよ。"},
        { "location": "4166/Talk", "narrator": "ガブリエラ", "text": "あたし、\n日本もポーランドも\nどっちも好き。"},
        { "location": "4167/Talk", "narrator": "ガブリエラ", "text": "だから、ちょっと\n入れてみたかったのよ。"},
        { "location": "4168/Talk", "narrator": "ガブリエラ", "text": "ええっ！？\nそ、そこなの？"},
        { "location": "4169/Talk", "narrator": "ガブリエラ", "text": "別に誰でもないわよ。\n知らない人だってば。"},
        { "location": "4170/Talk", "narrator": "ガブリエラ", "text": "……もう。"},
        { "location": "4171/Talk", "narrator": "ガブリエラ", "text": "あたしが男の人と\nマトモに喋れないの\n知ってるくせに。"},
        { "location": "4172/Talk", "narrator": "ガブリエラ", "text": "えへへ、良かった♪"},
        { "location": "4173/Talk", "narrator": "ガブリエラ", "text": "もう！\nまたそれ！？"},
        { "location": "4174/Talk", "narrator": "ガブリエラ", "text": "まあでも……別に\n嫌とかじゃないけど……"},
        { "location": "4175/Talk", "narrator": "ガブリエラ", "text": "ふわっ。"},
        { "location": "4176/Talk", "narrator": "ガブリエラ", "text": "ふふ。よかった。\nあたしもよ？"},
        { "location": "4177/Talk", "narrator": "ガブリエラ", "text": "ちょ、ちょっと！\nなんかだんだん大げさに\nなってない？"},
        { "location": "4178/Talk", "narrator": "ガブリエラ", "text": "嬉しいけど、天使って\nあたしにとってはすごく\n威厳があるものなのよ。"},
        { "location": "4179/Talk", "narrator": "ガブリエラ", "text": "だから、ちょっと\nあたしには似合わない\nってうか……"},
        { "location": "4180/Talk", "narrator": "ガブリエラ", "text": "役者不足なんじゃ\nないかしらね…なんて。"},
        { "location": "4181/Stay", "narrator": "", "text": "ピュアホワイトサマー"},
        { "location": "4182/Talk", "narrator": "ガブリエラ", "text": "こんにちは、\n$handle$。"},
        { "location": "4183/Talk", "narrator": "ガブリエラ", "text": "今回はなんか、\nあたしとあんただけ\nみたいなのよね。"},
        { "location": "4184/Talk", "narrator": "ガブリエラ", "text": "別に、あたしは\n他のみんながいても\n全然よかったんだけど。"},
        { "location": "4185/Talk", "narrator": "ガブリエラ", "text": "なんかみんな遠慮するし？\n仕方ないからあたし一人で\nつき合うことにするわ。"},
        { "location": "4186/Talk", "narrator": "ガブリエラ", "text": "それじゃ、\n始めるわよ？"},
        { "location": "4187/Talk", "narrator": "ガブリエラ", "text": "ああ……\nまさかこの日の記録を\n使われるなんて。"},
        { "location": "4188/Talk", "narrator": "ガブリエラ", "text": "まあ、そんなことは\nどうでもいいんだけど。\n大事なのはこのお店よ！"},
        { "location": "4189/Talk", "narrator": "ガブリエラ", "text": "ここ、あたしの\n一番のお気に入りの\n隠れ家なの。"},
        { "location": "4190/Talk", "narrator": "ガブリエラ", "text": "おまんじうと日本家屋の\n２つを一気に楽しめる\n素敵な場所なのよね。"},
        { "location": "4191/Talk", "narrator": "ガブリエラ", "text": "なんて言ってるうちに、\n歌が始まっちゃったわね。"},
        { "location": "4192/Talk", "narrator": "ガブリエラ", "text": "ちょっとレトロな感じが\n素敵でしょ？"},
        { "location": "4193/Talk", "narrator": "ガブリエラ", "text": "って、あたし実は\nレコードって実物は殆ど\n見たこと無かったのよね。"},
        { "location": "4194/Talk", "narrator": "ガブリエラ", "text": "だからすごい\n新鮮だったわ。"},
        { "location": "4195/Talk", "narrator": "ガブリエラ", "text": "トースターっていうのは\nポーランドの主食パンを\n焼くものでしょ？"},
        { "location": "4196/Talk", "narrator": "ガブリエラ", "text": "炊飯器はご飯を炊く\n日本人の魂よね。"},
        { "location": "4197/Talk", "narrator": "ガブリエラ", "text": "だから、\n恋しい故郷の思い出を\n大切にしながら暮らすか―"},
        { "location": "4198/Talk", "narrator": "ガブリエラ", "text": "大好きな日本の文化を\n存分に味わって暮らすか。"},
        { "location": "4199/Talk", "narrator": "ガブリエラ", "text": "どっちの方が幸せなの\nかしらね？　っていうのを\nモノで表現してみたのよ。"},
        { "location": "4200/Talk", "narrator": "ガブリエラ", "text": "この辺はパッパッって\n言ってるだけだから、\n特に話すこと無いわね。"},
        { "location": "4201/Talk", "narrator": "ガブリエラ", "text": "…なんて。"},
        { "location": "4202/Talk", "narrator": "ガブリエラ", "text": "でも、$handle$と\n一緒にいろんなこと\nしたいのは本当。"},
        { "location": "4203/Talk", "narrator": "ガブリエラ", "text": "そのときは、日本と\nポーランドを一緒に\n旅して回りたいな。"},
        { "location": "4204/Talk", "narrator": "ガブリエラ", "text": "ポーランドに来たら\n素敵なところを沢山\n紹介してあげるわね。"},
        { "location": "4205/Talk", "narrator": "ガブリエラ", "text": "と、こんな感じで\n歌はこれでおしまい。"},
        { "location": "4206/Talk", "narrator": "ガブリエラ", "text": "どうだった？\n上手に…\n歌えてた…かしらね？"},
        { "location": "4207/Talk", "narrator": "ガブリエラ", "text": "あ、ちなみに。\nここの独り言は\n聞かなくていいから。"},
        { "location": "4208/Talk", "narrator": "ガブリエラ", "text": "まあ、あれよね。\n早く普通に男の子と\n喋れるようになりたい。"},
        { "location": "4209/Talk", "narrator": "ガブリエラ", "text": "でもきっと出来るように\nなるって信じてるわ。"},
        { "location": "4210/Talk", "narrator": "ガブリエラ", "text": "だって、\n$handle$が\nいるもん。"},
        { "location": "4211/Talk", "narrator": "ガブリエラ", "text": "$handle$だったら\nきっと何とかしてくれる。"},
        { "location": "4212/Talk", "narrator": "ガブリエラ", "text": "だって、\n$handle$は\nあたしの魔法使いだもん。"},
        { "location": "4213/Talk", "narrator": "ガブリエラ", "text": "…あのね。\n今、ちょっとナデナデして\n欲しいなって思ってるの。"},
        { "location": "4214/Talk", "narrator": "ガブリエラ", "text": "らしくないかも\nしれないけど、なんか今\n甘えたい気分なのよね…。"},
        { "location": "4215/Talk", "narrator": "ガブリエラ", "text": "……ねえ、\nはやくー…。"},
        { "location": "4216/Talk", "narrator": "ガブリエラ", "text": "…ふふ、ありがと。\n嬉しいかも。"},
        { "location": "4217/Talk", "narrator": "ガブリエラ", "text": "二人きりだと、\nちょっとだけ素直に\nなれるから、好き。"},
        { "location": "4218/Talk", "narrator": "ガブリエラ", "text": "いつも意地ばっかり\n張ってると、やっぱり\n疲れちゃうから。"},
        { "location": "4219/Talk", "narrator": "ガブリエラ", "text": "…映像、\n終わっちゃったわね。"},
        { "location": "4220/Talk", "narrator": "ガブリエラ", "text": "$handle$とは\nもう随分長い付き合いの\nような気がするの。"},
        { "location": "4221/Talk", "narrator": "ガブリエラ", "text": "まだまだ、\nお互いを知るのは\nこれからだけど――"},
        { "location": "4222/Talk", "narrator": "ガブリエラ", "text": "でも、今は無理でも\nいつかあたしの全部を\n見せられそうな気がする。"},
        { "location": "4223/Talk", "narrator": "ガブリエラ", "text": "その時は\n$handle$に、\nあたしの全部をあげるから"},
        { "location": "4224/Talk", "narrator": "ガブリエラ", "text": "だから、\nずっと一緒にいてよね？"},
        { "location": "4225/Talk", "narrator": "ガブリエラ", "text": "なんてね！"},
        { "location": "4226/Talk", "narrator": "ガブリエラ", "text": "というわけで、\n今日はこれでお終い。"},
        { "location": "4227/Talk", "narrator": "ガブリエラ", "text": "最後まで\n一緒に見てくれて\nありがと！"}
    ]
}
