{
    "dir": "stream_190_ch01.json",
    "type": "watchanime",
    "info": {
    },
    "entry":
    [
        { "location": "3842/Talk", "narrator": "ガブリエラ", "text": "は？　……もしかして\nあたしの水着のこと\n言ってる？"},
        { "location": "3843/Talk", "narrator": "ガブリエラ", "text": "言っとくけどこれは\n自分で買ったんじゃ\nないんだからね？"},
        { "location": "3844/Talk", "narrator": "ガブリエラ", "text": "まほが、あたしには\nこれが一番似合う\nからって……。"},
        { "location": "3845/Talk", "narrator": "アーヤ", "text": "ギャヴィ、心配なんて\n無用よ。とても\n似合っているわ。"},
        { "location": "3846/Talk", "narrator": "ガブリエラ", "text": "そ、そう？　あたしも\n実はまんざらでも\nないんだけどね。"},
        { "location": "3847/Talk", "narrator": "ガブリエラ", "text": "え？　何？\nいきなり拝み出したの？\nどうしちゃったわけ？"},
        { "location": "3848/Talk", "narrator": "アーヤ", "text": "可愛いものは尊い。\nその気持ち、\nわかるわ……。"},
        { "location": "3849/Talk", "narrator": "ガブリエラ", "text": "アーヤまでっ！？"},
        { "location": "3850/Talk", "narrator": "ガブリエラ", "text": "と、とりあえず\nくすぐったいから\n二人ともやめて……。"},
        { "location": "3851/Talk", "narrator": "アーヤ", "text": "そんなことないと\n思うわよ？　ほら、\nもっとちゃんと見て？"},
        { "location": "3852/Talk", "narrator": "神楽", "text": "アーヤさん……。"},
        { "location": "3853/Talk", "narrator": "ガブリエラ", "text": "……アーヤ、\n話をそらそうとして\n必死過ぎ。"},
        { "location": "3854/Talk", "narrator": "アーヤ", "text": "そそそそんなこと\n全然無いんじゃ\nないかしら？"},
        { "location": "3855/Talk", "narrator": "アーヤ", "text": "でしょ？　私より\nみやびの方が\nセクシーで……。"},
        { "location": "3856/Talk", "narrator": "ガブリエラ", "text": "自分ですすめといて\n不機嫌になって\nどうするのよ。"},
        { "location": "3857/Talk", "narrator": "神楽", "text": "複雑な乙女心\nですよね。"},
        { "location": "3858/Talk", "narrator": "アーヤ", "text": "えぇっ！？\nそんなことないわ。\n気のせいよ？"},
        { "location": "3859/Talk", "narrator": "神楽", "text": "あら、随分と無難な\n回答ですね。悪い気は\nしませんけど。"},
        { "location": "3860/Talk", "narrator": "ガブリエラ", "text": "神楽ってどうしてアイツには\n手厳しいのよ？"},
        { "location": "3861/Talk", "narrator": "神楽", "text": "えっ？\n……気のせいですよ？"},
        { "location": "3862/Talk", "narrator": "アーヤ", "text": "あら、エロ担当を\n取られてしまったわ。"},
        { "location": "3863/Talk", "narrator": "神楽", "text": "はぅあっ！？\nお、おぬしら、\n謀りおったなっ！？"},
        { "location": "3864/Talk", "narrator": "ガブリエラ", "text": "何その武将口調……。"},
        { "location": "3865/Talk", "narrator": "神楽", "text": "あら、貴方って、\n「そっち」の趣味が\nあるんですか？"},
        { "location": "3866/Talk", "narrator": "神楽", "text": "ご所望でしたら\n考えなくも\nないですけど？"},
        { "location": "3867/Talk", "narrator": "ガブリエラ", "text": "いや、無理だってば。"},
        { "location": "3868/Talk", "narrator": "神楽", "text": "それは勿論、\n色んなモノをですよ？"},
        { "location": "3869/Talk", "narrator": "神楽", "text": "人間の壊せるモノは\n一つだけじゃ\nないですからね。"},
        { "location": "3870/Talk", "narrator": "ガブリエラ", "text": "え？　何？\nサイコ展開\nまだ続いてたわけ？"},
        { "location": "3871/Talk", "narrator": "神楽", "text": "やっぱり貴方は\n変態さんの素質が\nあるようですね。"},
        { "location": "3872/Talk", "narrator": "神楽", "text": "貴方ってやっぱり\n変態さんだったん\nですね。"},
        { "location": "3873/Talk", "narrator": "神楽", "text": "ええ、わかります。\n変態さんは足が好き\nですもんね。"},
        { "location": "3874/Talk", "narrator": "神楽", "text": "私もつばめさんの足が\n大好きなんですよ♪"},
        { "location": "3875/Talk", "narrator": "ガブリエラ", "text": "……要するに\nあんたたちって、\nいいコンビなのね。"},
        { "location": "3876/Talk", "narrator": "アーヤ", "text": "トライガジェットよ。\nそれを付けていたから\n水着でいられたの。"},
        { "location": "3877/Talk", "narrator": "神楽", "text": "今後は私以外は\nずっと水着でいいと\n思います！"},
        { "location": "3878/Talk", "narrator": "ガブリエラ", "text": "よくないわよっ！！"},
        { "location": "3879/Talk", "narrator": "アーヤ", "text": "色々と勉強になる\n回だったわ。"},
        { "location": "3880/Talk", "narrator": "アーヤ", "text": "ところで念のため\n確認しておきたい\nんだけれど……。"},
        { "location": "3881/Talk", "narrator": "アーヤ", "text": "私がエロ担当ってのは\n卯月の冗談よね？\n私エロくないわよね？"},
        { "location": "3882/Talk", "narrator": "ガブリエラ", "text": "なーんか久々で\n疲れたわ……。"},
        { "location": "3883/Talk", "narrator": "ガブリエラ", "text": "みやびって実は話の\n流れを読んで適度に\nボケてたのね。"},
        { "location": "3884/Talk", "narrator": "ガブリエラ", "text": "いないから何だけど\nちょっと見直したかも\n知れないわね。"},
        { "location": "3885/Talk", "narrator": "アーヤ", "text": "お久しぶり、\nと言った方が\nいいのかしら？"},
        { "location": "3886/Talk", "narrator": "ガブリエラ", "text": "ほんと誰かさんたちの\nせいで出番が\n無かったせいよね。"},
        { "location": "3887/Talk", "narrator": "つばめ", "text": "え、えーと、それは\nたくさん謝ったじゃ\nないですか～。"},
        { "location": "3888/Talk", "narrator": "神楽", "text": "謝ればいいという\n問題じゃないと\n思いますけどね。"},
        { "location": "3889/Talk", "narrator": "ガブリエラ", "text": "神楽が言うなっ！"},
        { "location": "3890/Talk", "narrator": "神楽", "text": "あぁ、そのツッコミも\nなつかしくて\n心に染み入ります。"},
        { "location": "3891/Talk", "narrator": "ガブリエラ", "text": "えっ？\nな、何よ神楽ちょっと\n気持ち悪いんだけど？"},
        { "location": "3892/Talk", "narrator": "つばめ", "text": "とにかく前回のことは\n忘れて、いつも通りに\nいきましょう！"},
        { "location": "3893/Talk", "narrator": "ガブリエラ", "text": "いや、それも正に\nつばめが言うな！\nなんだけど。"},
        { "location": "3894/Talk", "narrator": "つばめ", "text": "実は今回はとっても\n楽しみにしてたんだ。"},
        { "location": "3895/Talk", "narrator": "つばめ", "text": "だってメノウちゃんの\nファーストアルバムの\n曲が聴けちゃうから！"},
        { "location": "3896/Talk", "narrator": "神楽", "text": "つばめさん、少しは\n空気読みましょうよ？"},
        { "location": "3897/Talk", "narrator": "つばめ", "text": "いいのー。\n今まで通りやるから\n聞こえないよーっ。"},
        { "location": "3898/Talk", "narrator": "ガブリエラ", "text": "アンタ、そんな\n傍若無人なキャラじゃ\nなかったでしょ……。"},
        { "location": "3899/Talk", "narrator": "アーヤ", "text": "まぁ、つばめがそうしたい\nのなら、すればいいわ。"},
        { "location": "3900/Talk", "narrator": "アーヤ", "text": "さぁ、そろそろ本編が\n始まるわよ。"},
        { "location": "3901/Talk", "narrator": "つばめ", "text": "みんなーっ！\n準備はいいーっ？"},
        { "location": "3902/Talk", "narrator": "ガブリエラ", "text": "……だから、\n落ち着きなさいって。"},
        { "location": "3903/Talk", "narrator": "つばめ", "text": "キャーーーーッ！！\nメノウちゃーーん！！"},
        { "location": "3904/Talk", "narrator": "つばめ", "text": "これはメノウちゃんの\nファーストアルバムの\n１曲目で、"},
        { "location": "3905/Talk", "narrator": "つばめ", "text": "記念すべき\nデビューシングルでも\nあるんですよっ！！"},
        { "location": "3906/Talk", "narrator": "つばめ", "text": "メノウちゃんの曲には\n世界があって\n必ず楽曲に合わせて"},
        { "location": "3907/Talk", "narrator": "つばめ", "text": "語りが差し込まれて\n舞台演出もその曲の\n世界観を表現してて"},
        { "location": "3908/Talk", "narrator": "つばめ", "text": "ちょっと補足すると\nメノウちゃんの曲は\nそのアルバム自体が"},
        { "location": "3909/Talk", "narrator": "つばめ", "text": "１つの世界になってて\n１曲目から最後までの\n流れがまるで物語で、"},
        { "location": "3910/Talk", "narrator": "つばめ", "text": "起承転結をそれぞれの\n楽曲が担当しているん\nだけど――"},
        { "location": "3911/Talk", "narrator": "つばめ", "text": "お話もものすごく素敵で、\nとっても綺麗な世界なんだ\nよね。"},
        { "location": "3912/Talk", "narrator": "つばめ", "text": "でも、当時は純粋に\n綺麗で素敵なお花畑\n世界だったけど、"},
        { "location": "3913/Talk", "narrator": "つばめ", "text": "最近の曲は内容が割と\n絶望的で、それは\nそれで好きなんだけど"},
        { "location": "3914/Talk", "narrator": "つばめ", "text": "本当に好きなんだけど\nちょっと怖いって言うか、"},
        { "location": "3915/Talk", "narrator": "つばめ", "text": "って、あれっ？\nここってこんな演出\n入ったっけ？"},
        { "location": "3916/Talk", "narrator": "つばめ", "text": "まだここは旅立ちのシーン\nで――"},
        { "location": "3917/Talk", "narrator": "つばめ", "text": "いきなり世界が壊れるよう\nなことは起きなかったと\n思うんだけど？"},
        { "location": "3918/Talk", "narrator": "ガブリエラ", "text": "これって神楽の\n回想だからじゃない？"},
        { "location": "3919/Talk", "narrator": "神楽", "text": "つばめさん違います！\nこれこそが\nファーストアルバム"},
        { "location": "3920/Talk", "narrator": "神楽", "text": "「イシュリール」の\nリメイク版の\n全貌なんです！"},
        { "location": "3921/Talk", "narrator": "神楽", "text": "やっぱり今の時代、\nフワフワしただけの\nお話なんて"},
        { "location": "3922/Talk", "narrator": "神楽", "text": "流行りませんからね！\nアニメで言うなら\n開始１０秒で視聴者に"},
        { "location": "3923/Talk", "narrator": "神楽", "text": "衝撃が走らなければ、\n１０秒切りなんて言葉\nもあるくらいですし。"},
        { "location": "3924/Talk", "narrator": "アーヤ", "text": "それを言うなら\n「３話切り」じゃ\nないかしら？"},
        { "location": "3925/Talk", "narrator": "ガブリエラ", "text": "なんでそんなことアーヤが\n知ってるのよ……。"},
        { "location": "3926/Talk", "narrator": "神楽", "text": "とにかくメノウとしても\nこの地位を死守するため\nには――"},
        { "location": "3927/Talk", "narrator": "神楽", "text": "時代を先取りしなければ\nならないんです！"},
        { "location": "3928/Talk", "narrator": "つばめ", "text": "メノウちゃんは\nそんなことしなくても\nいいんだよー！"},
        { "location": "3929/Talk", "narrator": "神楽", "text": "つばめさん、\nわかってないですね。"},
        { "location": "3930/Talk", "narrator": "神楽", "text": "私はもう昔のメノウ\nじゃないんですよ？"},
        { "location": "3931/Talk", "narrator": "神楽", "text": "わかり合えない二人に\nなってしまった\nつばめとぴょんこ。"},
        { "location": "3932/Talk", "narrator": "神楽", "text": "さようなら……、\nつばめさん……。"},
        { "location": "3933/Talk", "narrator": "つばめ", "text": "あああっ！\n神楽ちゃん！\n待ってーっ！"},
        { "location": "3934/Talk", "narrator": "ガブリエラ", "text": "……何なのあの二人は？"},
        { "location": "3935/Talk", "narrator": "アーヤ", "text": "とりあえず仲が良いなら、\nいいんじゃないかしら。"},
        { "location": "3936/Talk", "narrator": "ガブリエラ", "text": "微妙によくない気がして\nならないんだけど。"},
        { "location": "3937/Talk", "narrator": "ガブリエラ", "text": "って二人の薀蓄合戦が\n終わったと思ったら\nいきなり模擬戦っ！？"},
        { "location": "3938/Talk", "narrator": "ガブリエラ", "text": "脈絡が無いと言うか\n構成どうなってるの？"},
        { "location": "3939/Talk", "narrator": "ガブリエラ", "text": "て言うか、そもそも\n水着で模擬戦するのが\nおかしくない？"},
        { "location": "3940/Talk", "narrator": "アーヤ", "text": "それは館長にだって\n色んな思惑があるし\n何とも言えないわ。"},
        { "location": "3941/Talk", "narrator": "アーヤ", "text": "ただ敢えて言うのなら\n装備に頼らない戦いに\n慣れておくためとか？"},
        { "location": "3942/Talk", "narrator": "ガブリエラ", "text": "それはそれで\nかなり無理がある\n解釈よね……。"},
        { "location": "3943/Talk", "narrator": "アーヤ", "text": "じゃあ単純に\nサービスシーンとか？"},
        { "location": "3944/Talk", "narrator": "ガブリエラ", "text": "それはそれでいきなり\nぶっちゃけ過ぎじゃ\nないかな？"},
        { "location": "3945/Talk", "narrator": "アーヤ", "text": "ところでギャヴィ、\n実は気になって\nいたんだけれど……。"},
        { "location": "3946/Talk", "narrator": "ガブリエラ", "text": "えっ？　改まって何？\n何かまずいことでも\nあったの？"},
        { "location": "3947/Talk", "narrator": "アーヤ", "text": "ええ、私とギャヴィの\n二人だけだと、こう、\n盛り上げづらくない？"},
        { "location": "3948/Talk", "narrator": "ガブリエラ", "text": "んー……確かに\nボケ担当がいないと\nちょっとね……。"},
        { "location": "3949/Talk", "narrator": "神楽", "text": "アーヤさんの絶妙に\nエロスなアングル\nキターッ！！"},
        { "location": "3950/Talk", "narrator": "アーヤ", "text": "って、卯月\nいつの間に！？"},
        { "location": "3951/Talk", "narrator": "神楽", "text": "トライナリーの\nエロ担当としての\n地位はやっぱり"},
        { "location": "3952/Talk", "narrator": "神楽", "text": "アーヤさんで\n揺るぎないですよね！"},
        { "location": "3953/Talk", "narrator": "神楽", "text": "いやー、一時は\nみやびさんと\n競ってましたけど"},
        { "location": "3954/Talk", "narrator": "神楽", "text": "やっぱりアーヤさんが\n一番エロいですっ！"},
        { "location": "3955/Talk", "narrator": "アーヤ", "text": "や、やめてよっ！\nたまたま水着が\nちょっと、こう……"},
        { "location": "3956/Talk", "narrator": "アーヤ", "text": "アダルティー？\nだっただけでしょ？"},
        { "location": "3957/Talk", "narrator": "ガブリエラ", "text": "言われて気づいたけど\n今日みやびって\n来てないわよね？"},
        { "location": "3958/Talk", "narrator": "アーヤ", "text": "私も事情までは\n聞いてないけど\n休むって言ってたわ。"},
        { "location": "3959/Talk", "narrator": "アーヤ", "text": "って、今はそれどころ\nじゃなくてエロ担当は\nやめちょうだい……。"},
        { "location": "3960/Talk", "narrator": "ガブリエラ", "text": "ていうかアーヤの\n水着すごくない？"},
        { "location": "3961/Talk", "narrator": "ガブリエラ", "text": "これ全部、前の結んで\nあるのを解いたら\n脱げちゃうわけ？"},
        { "location": "3962/Talk", "narrator": "神楽", "text": "そうです！\nそれなんですよ！"},
        { "location": "3963/Talk", "narrator": "神楽", "text": "アーヤさんの心の奥の\n欲求がダダ漏れしてる\n水着ですよね！"},
        { "location": "3964/Talk", "narrator": "アーヤ", "text": "もーっ！　二人とも\n好き勝手言って\nからかわないでっ！"},
        { "location": "3965/Talk", "narrator": "神楽", "text": "貴方もアーヤさんが\nエロ担当だって\n思いますよね？"},
        { "location": "3966/Talk", "narrator": "アーヤ", "text": "わ、私のことは\nいいからっ！"},
        { "location": "3967/Talk", "narrator": "アーヤ", "text": "そ、それより、\nみやびのこの水着は\nどう思う？"},
        { "location": "3968/Talk", "narrator": "神楽", "text": "ていうか私に\nコメントさせて\nください！"},
        { "location": "3969/Talk", "narrator": "神楽", "text": "みやびさんの水着、\n私は全然ダメダメだと\n思います！"},
        { "location": "3970/Talk", "narrator": "ガブリエラ", "text": "うわ、本人がいない\nからって、そこまで\n言っちゃう？"},
        { "location": "3971/Talk", "narrator": "神楽", "text": "何故ならみやびさんは\nマイクロビキニこそ\n最高に似合うのでっ！"},
        { "location": "3972/Talk", "narrator": "ガブリエラ", "text": "えっ……。"},
        { "location": "3973/Talk", "narrator": "神楽", "text": "いつか何とか頼んで\n言いくるめて\n着てもらいたいっ！"},
        { "location": "3974/Talk", "narrator": "ガブリエラ", "text": "神楽、あんた今日は\nちょっとはっちゃけ\n過ぎじゃない？"},
        { "location": "3975/Talk", "narrator": "神楽", "text": "じゃあ続いては\nガブちゃんの\n白スクについて"},
        { "location": "3976/Talk", "narrator": "ガブリエラ", "text": "言わなくていいから！"},
        { "location": "3977/Talk", "narrator": "神楽", "text": "おぉーっと！？\nって、なんだ、私の\nシャワーシーンか。"},
        { "location": "3978/Talk", "narrator": "ガブリエラ", "text": "あからさまに\nガッカリし過ぎ\nでしょ……。"},
        { "location": "3979/Talk", "narrator": "アーヤ", "text": "じゃあ次はこの\nシャワーシーンに\nついて一言お願い。"},
        { "location": "3980/Talk", "narrator": "ガブリエラ", "text": "アーヤも、そんなに\n無理に仕切らなくても\nいいってば。"},
        { "location": "3981/Talk", "narrator": "アーヤ", "text": "そう言えば卯月だけ\n戻って来て、つばめは\nどうしたの？"},
        { "location": "3982/Talk", "narrator": "神楽", "text": "つばめさんなら\n控え室でぐったり\nしてますよ。"},
        { "location": "3983/Talk", "narrator": "ガブリエラ", "text": "ぐったり？　なんで？\n何かあったの？"},
        { "location": "3984/Talk", "narrator": "神楽", "text": "ぐふふふふっ♪\n知りたいですか？\n知りたいんですかぁ？"},
        { "location": "3985/Talk", "narrator": "ガブリエラ", "text": "あっ、うん、べつに\n興味無いから、\nどうでもいいわ……。"},
        { "location": "3986/Talk", "narrator": "アーヤ", "text": "（興味があるとは\n言いづらい流れね）"},
        { "location": "3987/Talk", "narrator": "ガブリエラ", "text": "これ「あんなの」って\n何よ？　あたしにも\n教えなさいよ！"},
        { "location": "3988/Talk", "narrator": "神楽", "text": "「お母さんのこと」\nって今言いましたけど？"},
        { "location": "3989/Talk", "narrator": "ガブリエラ", "text": "それだけなの？\n……仕方ないわね。\nじゃあもういいわ。"},
        { "location": "3990/Talk", "narrator": "ガブリエラ", "text": "それよりここの\nつばめのセリフ\nちょっと怖いわね。"},
        { "location": "3991/Talk", "narrator": "アーヤ", "text": "サスペンスと言うか\n少しサイコっぽい\nセリフではあるわね。"},
        { "location": "3992/Talk", "narrator": "ガブリエラ", "text": "これつばめと神楽の\nどっちがサイコなのか\nわからない展開ね。"},
        { "location": "3993/Talk", "narrator": "神楽", "text": "どっちか、じゃなくて\nどっちも、だったら\nどうしますかぁ？"},
        { "location": "3994/Talk", "narrator": "ガブリエラ", "text": "そうね、最終的に\nどっちが生き残るかは\n興味あるわ。"},
        { "location": "3995/Talk", "narrator": "アーヤ", "text": "ギャヴィ、話がかなり\n脱線してるわよ？"},
        { "location": "3996/Talk", "narrator": "神楽", "text": "はい！\nここで壁ドン\nいただきましたっ！"},
        { "location": "3997/Talk", "narrator": "神楽", "text": "私、一度やって\nみたかったんですよ\n壁ドン！"},
        { "location": "3998/Talk", "narrator": "神楽", "text": "つばめさんに\n壁ドン出来て\n本当に幸せでしたっ！"},
        { "location": "3999/Talk", "narrator": "ガブリエラ", "text": "それより問題は\nその後の神楽のセリフ\nだと思うんだけど。"},
        { "location": "4000/Talk", "narrator": "神楽", "text": "壊してもいいんですか\n……ですか？"},
        { "location": "4001/Talk", "narrator": "アーヤ", "text": "……とりあえず\n進めていいかしら？"},
        { "location": "4002/Talk", "narrator": "アーヤ", "text": "って、またいきなり\n止められたの！？"},
        { "location": "4003/Talk", "narrator": "神楽", "text": "いいですよ、いずれ\nもし私と連れ添う\nことになったら"},
        { "location": "4004/Talk", "narrator": "神楽", "text": "毎日やって\nあげますから。"},
        { "location": "4005/Talk", "narrator": "神楽", "text": "泣いちゃっても\n容赦なんて\nしませんからね？"},
        { "location": "4006/Talk", "narrator": "ガブリエラ", "text": "ごめん、なんか\n今回は色々と\nついて行けないわ。"},
        { "location": "4007/Talk", "narrator": "アーヤ", "text": "色々と目まぐるしくは\nあるわね……。"},
        { "location": "4008/Talk", "narrator": "神楽", "text": "あぁ……つばめさんの\n可愛い顔が\nこんなに近くに……。"},
        { "location": "4009/Talk", "narrator": "神楽", "text": "こんな状況で\n我慢できてる私って\nすごくないですか？"},
        { "location": "4010/Talk", "narrator": "ガブリエラ", "text": "我慢できてない気が\nするんだけど……。"},
        { "location": "4011/Talk", "narrator": "アーヤ", "text": "……ちょっと近過ぎじゃ\nないかしら？"},
        { "location": "4012/Talk", "narrator": "神楽", "text": "いえいえ、まだです。\nあと３センチ！\nさぁ、行ってっ！！"},
        { "location": "4013/Talk", "narrator": "ガブリエラ", "text": "いや、画面に言っても\n無駄だから……。"},
        { "location": "4014/Talk", "narrator": "神楽", "text": "わかってますけど\n気持ちの問題ですっ。"},
        { "location": "4015/Talk", "narrator": "ガブリエラ", "text": "酷い子だったらって\nここ意味深過ぎる\nセリフでしょ！"},
        { "location": "4016/Talk", "narrator": "神楽", "text": "いえ、つばめさんが\nスレてる子だったら\nなんの躊躇も無く"},
        { "location": "4017/Talk", "narrator": "神楽", "text": "お仕置きという名目で\n押し倒したのにって\n言いたかっただけで"},
        { "location": "4018/Talk", "narrator": "神楽", "text": "深読みし過ぎですよ？"},
        { "location": "4019/Talk", "narrator": "ガブリエラ", "text": "……うん、深読みして\n勘違いしてた方が\nマシだったわ。"},
        { "location": "4020/Talk", "narrator": "アーヤ", "text": "……なるほど。\nやっぱりボケ担当が\nいると話が弾むわね。"},
        { "location": "4021/Talk", "narrator": "ガブリエラ", "text": "ていうかその話、まだ\n引っ張ってたの！？"},
        { "location": "4022/Talk", "narrator": "神楽", "text": "そして逃げるように\n走り去る私でした。\nつづく。"},
        { "location": "4023/Talk", "narrator": "神楽", "text": "このシチュエーション\n私ヒロインみたいじゃ\nありません？"},
        { "location": "4024/Talk", "narrator": "神楽", "text": "マイヒロインは\nつばめさん\nなんですけどね。"},
        { "location": "4025/Talk", "narrator": "神楽", "text": "でも今回はちょっと\n意地悪し過ぎちゃった\nかなぁ？"}
    ]
}
