{
    "dir": "stream_140_ch01.json",
    "type": "watchanime",
    "info": {
    },
    "entry":
    [
        { "location": "2370/Talk", "narrator": "アーヤ", "text": "密室かどうかは\nわからないけど……\nまあ二人きりよね。"},
        { "location": "2371/Talk", "narrator": "アーヤ", "text": "ええっ？\nそういう解釈に\nなっちゃうの？"},
        { "location": "2372/Talk", "narrator": "アーヤ", "text": "んー…そうね。\nでも。"},
        { "location": "2373/Talk", "narrator": "アーヤ", "text": "前向きに検討するのも\n悪くないかな。"},
        { "location": "2374/Talk", "narrator": "アーヤ", "text": "なんで！"},
        { "location": "2375/Talk", "narrator": "アーヤ", "text": "もう、しらない。"},
        { "location": "2376/Talk", "narrator": "アーヤ", "text": "ふふ、冗談よ。"},
        { "location": "2377/Talk", "narrator": "アーヤ", "text": "それじゃ、始めましょ？"},
        { "location": "2378/Talk", "narrator": "アーヤ", "text": "なにそれ。\nそんな言葉で\nお茶を濁すつもり？"},
        { "location": "2379/Talk", "narrator": "アーヤ", "text": "でも、まあいいかな。\n今回は許してあげる。\n…なんてね。"},
        { "location": "2380/Talk", "narrator": "アーヤ", "text": "さあ、始めましょ？"},
        { "location": "2381/Talk", "narrator": "アーヤ", "text": "え？\nえっと…"},
        { "location": "2382/Talk", "narrator": "アーヤ", "text": "そりゃ、ね。\n恥ずかしいわよ。"},
        { "location": "2383/Talk", "narrator": "アーヤ", "text": "こういうのって、\n同僚とか友達に見られるの\n恥ずかしいわよね。"},
        { "location": "2384/Talk", "narrator": "アーヤ", "text": "逆に、貴方とは全然…\nっていうか寧ろ見て――"},
        { "location": "2385/Talk", "narrator": "アーヤ", "text": "って、なんでもない、\nなんでもないから。"},
        { "location": "2386/Talk", "narrator": "アーヤ", "text": "さあ、始めましょ？"},
        { "location": "2387/Talk", "narrator": "アーヤ", "text": "ちょ、ちょっと、\n何言ってるの！？"},
        { "location": "2388/Talk", "narrator": "アーヤ", "text": "恥ずかしいシーンが\nあったら強制的に\n消しますからね。"},
        { "location": "2389/Talk", "narrator": "アーヤ", "text": "情報管理庁だけど？"},
        { "location": "2390/Talk", "narrator": "アーヤ", "text": "そもそも顔バレ厳禁なのに\nなんで作る必要があるの\nかしらね。"},
        { "location": "2391/Talk", "narrator": "アーヤ", "text": "ええっ！\nそれってちょっと\n怖くない？"},
        { "location": "2392/Talk", "narrator": "アーヤ", "text": "私的なことに\n公費使ってるわけでしょ？"},
        { "location": "2393/Talk", "narrator": "アーヤ", "text": "うーん、良くないわ。\nすごく良くない。"},
        { "location": "2394/Talk", "narrator": "アーヤ", "text": "今度館長に\n進言しておかなくちゃ。"},
        { "location": "2395/Talk", "narrator": "アーヤ", "text": "え？\nまさか。"},
        { "location": "2396/Talk", "narrator": "アーヤ", "text": "貴方には、私が今\nこうやってコッソリ\n見せているだけだもの。"},
        { "location": "2397/Talk", "narrator": "アーヤ", "text": "私が貴方と二人だけで\nビデオ見てたことは、\nみんなにはヒミツよ？"},
        { "location": "2398/Talk", "narrator": "アーヤ", "text": "ええっ？\nそうなの！？"},
        { "location": "2399/Talk", "narrator": "アーヤ", "text": "私はちょっと、\n恥ずかしいかな……。\nなんか情けない顔してる。"},
        { "location": "2400/Talk", "narrator": "アーヤ", "text": "私の運命を変えた電話。"},
        { "location": "2401/Talk", "narrator": "アーヤ", "text": "この世にトライナリーって\nいう存在が生まれようと\nしている瞬間、かな。"},
        { "location": "2402/Talk", "narrator": "アーヤ", "text": "……ごめん。\nちょっと\n誇張しすぎたかも。"},
        { "location": "2403/Talk", "narrator": "アーヤ", "text": "…ああ、そうね。"},
        { "location": "2404/Talk", "narrator": "アーヤ", "text": "それより、\nここから歌が始まるのよ。\nこれも随分苦労したけど。"},
        { "location": "2405/Talk", "narrator": "アーヤ", "text": "…ああ、ええ、まあ。\nこの時は、…そう、\nたまたまよ。"},
        { "location": "2406/Talk", "narrator": "アーヤ", "text": "あぁ、そうそう！\nここから歌が始まるのよ。\nこれも随分苦労したけど。"},
        { "location": "2407/Talk", "narrator": "アーヤ", "text": "ほんと？\nありがと。"},
        { "location": "2408/Talk", "narrator": "アーヤ", "text": "改めて言われると\nなんだか恥ずかしいけど、\nちょっと嬉しいかも。"},
        { "location": "2409/Talk", "narrator": "アーヤ", "text": "いつか、貴方のためだけの\n歌も作ってみたい……"},
        { "location": "2410/Talk", "narrator": "アーヤ", "text": "…って、私\n何言ってるのかしら！\n今のは忘れて？"},
        { "location": "2411/Talk", "narrator": "アーヤ", "text": "ほんと？\n嬉しい。"},
        { "location": "2412/Talk", "narrator": "アーヤ", "text": "これ、お気に入りなのよ。"},
        { "location": "2413/Talk", "narrator": "アーヤ", "text": "出動の時に使ってるものは\n実用主義だけど、こっちは\n形が好きで買ったもの。"},
        { "location": "2414/Talk", "narrator": "アーヤ", "text": "他にもいくつか\nあるのよ？"},
        { "location": "2415/Talk", "narrator": "アーヤ", "text": "わぁ、ほんと？"},
        { "location": "2416/Talk", "narrator": "アーヤ", "text": "そういうの解ってくれる人\n全然いなかったから、\nすごく嬉しい！"},
        { "location": "2417/Talk", "narrator": "アーヤ", "text": "なんか、もっと沢山\n$handle$とお話\nしたいな。"},
        { "location": "2418/Talk", "narrator": "アーヤ", "text": "ふふ、そうね。\n夜のドライブってちょっと\nドキドキするわよね。"},
        { "location": "2419/Talk", "narrator": "アーヤ", "text": "暗い車の中は、二人きりの\n密室空間。交わす会話も\nいつもと違う雰囲気に。"},
        { "location": "2420/Talk", "narrator": "アーヤ", "text": "$handle$と一緒に\nそんな空間にいたら、\n私どうなっちゃうのかな。"},
        { "location": "2421/Talk", "narrator": "アーヤ", "text": "そんなこと考えてると、\nなんだかちょっと\nドキドキしてきちゃう。"},
        { "location": "2422/Talk", "narrator": "アーヤ", "text": "な…なんてね！\nちょっと\n飛躍しすぎたかも。"},
        { "location": "2423/Talk", "narrator": "アーヤ", "text": "ほ、ほんとに？？"},
        { "location": "2424/Talk", "narrator": "アーヤ", "text": "じゃあ、先に進めるわよ？\nいいわね？"},
        { "location": "2425/Talk", "narrator": "アーヤ", "text": "何よその\nラッキースケベって。"},
        { "location": "2426/Talk", "narrator": "アーヤ", "text": "何でもいいけど、\nとにかく先に進めるわよ？"},
        { "location": "2427/Talk", "narrator": "アーヤ", "text": "もうっ！\n見ればわかるから、\nいちいち言わないで！"},
        { "location": "2428/Talk", "narrator": "アーヤ", "text": "そ、そんなわけ…"},
        { "location": "2429/Talk", "narrator": "アーヤ", "text": "し、仕方ないでしょ？\nそういう指示がっ！"},
        { "location": "2430/Talk", "narrator": "アーヤ", "text": "でも、だからといって\n採用してもいいなんて\n一言も言ってないわよ！？"},
        { "location": "2431/Talk", "narrator": "アーヤ", "text": "そ、それはそうだけど……"},
        { "location": "2432/Talk", "narrator": "アーヤ", "text": "でも、こんなシーンが\nあるなんて…"},
        { "location": "2433/Talk", "narrator": "アーヤ", "text": "知らなかったわけじゃ\nないけど……でもやっぱり\n恥ずかしいし！"},
        { "location": "2434/Talk", "narrator": "アーヤ", "text": "そ、そんな\nダダこねられたって……"},
        { "location": "2435/Talk", "narrator": "アーヤ", "text": "だいたい、\nこんなシーンが\nあるなんて……"},
        { "location": "2436/Talk", "narrator": "アーヤ", "text": "知らなかったわけじゃ\nないけど……でもやっぱり\n恥ずかしいし！"},
        { "location": "2437/Talk", "narrator": "アーヤ", "text": "なぁに、そのエッチな\nカメラマンみたいな反応。"},
        { "location": "2438/Talk", "narrator": "アーヤ", "text": "もうっ！\nグッ！　じゃなくて！"},
        { "location": "2439/Talk", "narrator": "アーヤ", "text": "はいはい、ありがと。"},
        { "location": "2440/Talk", "narrator": "アーヤ", "text": "え？\nえっと……"},
        { "location": "2441/Talk", "narrator": "アーヤ", "text": "いつもはもっと……\nいや、そうでもないか…\nって何言ってるのかしら！"},
        { "location": "2442/Talk", "narrator": "アーヤ", "text": "い、色々よ、\nい・ろ・い・ろ！"},
        { "location": "2443/Talk", "narrator": "アーヤ", "text": "えっ……\nそ、そうなの？"},
        { "location": "2444/Talk", "narrator": "アーヤ", "text": "ホントに\n触れられたら\n良かったのにね。"},
        { "location": "2445/Talk", "narrator": "アーヤ", "text": "……んー…"},
        { "location": "2446/Talk", "narrator": "アーヤ", "text": "今度ちょっとだけ\n試してみよっか。"},
        { "location": "2447/Talk", "narrator": "アーヤ", "text": "ふふ、そうね。\n$handle$とのお茶\nちょっと楽しそう。"},
        { "location": "2448/Talk", "narrator": "アーヤ", "text": "いつか出来る日が来るのを\n楽しみにしてるわ。"},
        { "location": "2449/Talk", "narrator": "アーヤ", "text": "…っ！"},
        { "location": "2450/Talk", "narrator": "アーヤ", "text": "……ありがと。\n嬉しい。"},
        { "location": "2451/Talk", "narrator": "アーヤ", "text": "なんだか少しだけ\n元気出たかも。"},
        { "location": "2452/Talk", "narrator": "アーヤ", "text": "ふふ、ありがと。\n本当に嬉しい。"},
        { "location": "2453/Talk", "narrator": "アーヤ", "text": "私ももっと、\n$handle$の事を\n知りたいと思ってる。"},
        { "location": "2454/Talk", "narrator": "アーヤ", "text": "だから、\nこれからもよろしくね。"},
        { "location": "2455/Talk", "narrator": "アーヤ", "text": "もちろんよ。\n単なる私の\nワガママだもの。"},
        { "location": "2456/Talk", "narrator": "アーヤ", "text": "けど、もしよかったら、\nまた私の愚痴を\n聞いてくれると嬉しいな。"},
        { "location": "2457/Talk", "narrator": "アーヤ", "text": "良かった！\n私と同じね、ふふ。"},
        { "location": "2458/Talk", "narrator": "アーヤ", "text": "もうっ！\n次はポロリは\nありませんからね？"},
        { "location": "2459/Talk", "narrator": "アーヤ", "text": "なんて。\nでも貴方なら\n別にいいか…な。"},
        { "location": "2460/Talk", "narrator": "アーヤ", "text": "こんにちは、\n$handle$。"},
        { "location": "2461/Talk", "narrator": "アーヤ", "text": "今回はね、\n色々考えたんだけど――"},
        { "location": "2462/Talk", "narrator": "アーヤ", "text": "みんなには外してもらって\n$handle$とだけ\nお話することにしたの。"},
        { "location": "2463/Talk", "narrator": "アーヤ", "text": "でもビックリしちゃった。\n急に「MV風の映像作る」\nって言われて。"},
        { "location": "2464/Talk", "narrator": "アーヤ", "text": "まあ、それ自体は\nいいんだけど、恥ずかしい\nシーンが無いか心配。"},
        { "location": "2465/Talk", "narrator": "アーヤ", "text": "それにしても、\n何でこの時の映像が\n入ってるのかしら。"},
        { "location": "2466/Talk", "narrator": "アーヤ", "text": "まあ確かに、管理庁に\nとっては記念すべき瞬間\nなのかもしれないけど。"},
        { "location": "2467/Talk", "narrator": "アーヤ", "text": "でもこの時は\n本当にビックリしたわ。"},
        { "location": "2468/Talk", "narrator": "アーヤ", "text": "つばめの時もそうだった\nけど、この時も管理庁は\nすごく性急だったし。"},
        { "location": "2469/Talk", "narrator": "アーヤ", "text": "全然体質変わってない――"},
        { "location": "2470/Talk", "narrator": "アーヤ", "text": "頑張って歌ったから、\n良ければ最後まで\n聴いていってほしいかな。"},
        { "location": "2471/Talk", "narrator": "アーヤ", "text": "この歌の詞は、私らしい\n感じを出せたらと思って\n書いてみたんだけど……"},
        { "location": "2472/Talk", "narrator": "アーヤ", "text": "なんか、出来上がって\nみたら、ダメな自分を\n戒める歌になっちゃった。"},
        { "location": "2473/Talk", "narrator": "アーヤ", "text": "私の心の葛藤を\n首都高クルーズで\n表現してみたのよ。"},
        { "location": "2474/Talk", "narrator": "アーヤ", "text": "辛いときとか、バイクで\n環状線を走りにいったり\nするんだけど――"},
        { "location": "2475/Talk", "narrator": "アーヤ", "text": "そんなときはだいたい、\nこの歌みたいなことを\n考えてるかな。"},
        { "location": "2476/Talk", "narrator": "アーヤ", "text": "あと、普段は車には\nあまり乗らないんだけど、\n今回は車で飛ばしてみた。"},
        { "location": "2477/Talk", "narrator": "アーヤ", "text": "そうだ、\nちょっとくだらない話、\nしてもいい？"},
        { "location": "2478/Talk", "narrator": "アーヤ", "text": "首都高ってすごいトラップ\nだらけなのよね。"},
        { "location": "2479/Talk", "narrator": "アーヤ", "text": "例えば、全てのICに\n必ずしも入口と出口が\nあるわけじゃなかったり。"},
        { "location": "2480/Talk", "narrator": "アーヤ", "text": "ICによっては、降りる道が\n右側にあったり。"},
        { "location": "2481/Talk", "narrator": "アーヤ", "text": "交差してる首都高同士でも\nそっちの道に乗り換える\nJCTが無かったり。"},
        { "location": "2482/Talk", "narrator": "アーヤ", "text": "長野から出てきた頃なんて\nちょっと一周のつもりが\n大旅行になったりしたわ。"},
        { "location": "2483/Talk", "narrator": "アーヤ", "text": "でもね、\n話をちょっと戻すと――"},
        { "location": "2484/Talk", "narrator": "アーヤ", "text": "最近ちょっと\n感じてることがあるの。\n貴方との関係のことで。"},
        { "location": "2485/Talk", "narrator": "アーヤ", "text": "私、結構一人で考え過ぎて\n悩んじゃう方なんだけど、\n貴方と話すようになっ――"},
        { "location": "2486/Talk", "narrator": "アーヤ", "text": "え！？"},
        { "location": "2487/Talk", "narrator": "アーヤ", "text": "ちょ、ちょっと何これ！\nなんでここで\n止めるわけ！？"},
        { "location": "2488/Talk", "narrator": "アーヤ", "text": "もーっ！\n早く進めてー！"},
        { "location": "2489/Talk", "narrator": "アーヤ", "text": "ふぅ…本当にもう……"},
        { "location": "2490/Talk", "narrator": "アーヤ", "text": "はいはい、おしまい！\nビデオ鑑賞会は\nこれにてお開き！"},
        { "location": "2491/Talk", "narrator": "アーヤ", "text": "ホントにもう、\n何なのかしら、\nこの羞恥プレイ…。"},
        { "location": "2492/Talk", "narrator": "アーヤ", "text": "少しはあるって\n聞いてたけど――"},
        { "location": "2493/Talk", "narrator": "アーヤ", "text": "はい、どんどん進む！"},
        { "location": "2494/Talk", "narrator": "アーヤ", "text": "いや、やっぱだめ！\nホントにもうダメ！"},
        { "location": "2495/Talk", "narrator": "アーヤ", "text": "はーい、\nお疲れさまでした！"},
        { "location": "2496/Talk", "narrator": "アーヤ", "text": "楽しかったわね。\n早くテレビを消して。"},
        { "location": "2497/Talk", "narrator": "アーヤ", "text": "あーん、もう\nホント無理だからー！"},
        { "location": "2498/Talk", "narrator": "アーヤ", "text": "貴方に見られるの\nちょっと恥ずかしすぎ！"},
        { "location": "2499/Talk", "narrator": "アーヤ", "text": "わかりました。\nもういいわ、好きなだけ\n見ればいいのよ。"},
        { "location": "2500/Talk", "narrator": "アーヤ", "text": "そのかわり、ちゃんと\n責任取ってもらうから。"},
        { "location": "2501/Talk", "narrator": "アーヤ", "text": "ふぅ……\nこれでやっと\n終わりみたいね。"},
        { "location": "2502/Talk", "narrator": "アーヤ", "text": "まったく！\n$handle$、今日は\nちょっと羽目外しすぎ。"},
        { "location": "2503/Talk", "narrator": "アーヤ", "text": "でも、\nまあ……"},
        { "location": "2504/Talk", "narrator": "アーヤ", "text": "別に、嫌ってことじゃ\nないから。"},
        { "location": "2505/Talk", "narrator": "アーヤ", "text": "ただちょっと、ドキドキ\nして疲れちゃうから、\n程々にね、ってことで。"},
        { "location": "2506/Talk", "narrator": "アーヤ", "text": "この日も、\n色々あったのよね。"},
        { "location": "2507/Talk", "narrator": "アーヤ", "text": "……お姉ちゃんが。"},
        { "location": "2508/Talk", "narrator": "アーヤ", "text": "…珍しく連絡取ってきて。"},
        { "location": "2509/Talk", "narrator": "アーヤ", "text": "ちょうど良かったから、\n相談に乗ってもらおう\nかなって思って……。"},
        { "location": "2510/Talk", "narrator": "アーヤ", "text": "フェノメノンと\n戦うべきなのか、それとも\n辞退した方がいいのか。"},
        { "location": "2511/Talk", "narrator": "アーヤ", "text": "でも、やっぱり\nこの日も結局、\n来てくれなかった。"},
        { "location": "2512/Talk", "narrator": "アーヤ", "text": "わかってた\nことなのに。"},
        { "location": "2513/Talk", "narrator": "アーヤ", "text": "ねえ。\nちょっとだけ、\n甘えてもいい？"},
        { "location": "2514/Talk", "narrator": "アーヤ", "text": "撫でて欲しいかも。\nよしよしって……"},
        { "location": "2515/Talk", "narrator": "アーヤ", "text": "…って、\nなんか言ってて\n恥ずかしい。"},
        { "location": "2516/Talk", "narrator": "アーヤ", "text": "けど、なんだかちょっと\n甘えたくなっちゃって。"},
        { "location": "2517/Talk", "narrator": "アーヤ", "text": "…お姉ちゃんのことは\n嫌いじゃ…ないのよ。"},
        { "location": "2518/Talk", "narrator": "アーヤ", "text": "けど、\n色々あって。"},
        { "location": "2519/Talk", "narrator": "アーヤ", "text": "本当にいろんな\nことがあって。"},
        { "location": "2520/Talk", "narrator": "アーヤ", "text": "なんだか\nよく解らなく\nなっちゃって。"},
        { "location": "2521/Talk", "narrator": "アーヤ", "text": "正直に言うと、\n逃げてる感じ。"},
        { "location": "2522/Talk", "narrator": "アーヤ", "text": "けど、貴方と出逢って、\n少しずつモノの考え方が\n変わってきて――"},
        { "location": "2523/Talk", "narrator": "アーヤ", "text": "今なら少しだけ\n変われそうな気がするの。"},
        { "location": "2524/Talk", "narrator": "アーヤ", "text": "そう…貴方が一緒なら、\n変われそうな気がする。"},
        { "location": "2525/Talk", "narrator": "アーヤ", "text": "自分のことを\n本当に好きになれる私に。"},
        { "location": "2526/Talk", "narrator": "アーヤ", "text": "だから、\nこれからもずっと、\n一緒にいて欲しいかな。"},
        { "location": "2527/Talk", "narrator": "アーヤ", "text": "ワガママなお願いだけど、\n言うだけなら、\n許してくれるわよね。"},
        { "location": "2528/Talk", "narrator": "アーヤ", "text": "というわけで、\n今回の上映会は\nおしまい。"},
        { "location": "2529/Talk", "narrator": "アーヤ", "text": "途中色々あったけど、\n私は楽しかったかな。\n貴方はどうだった？"},
        { "location": "2530/Talk", "narrator": "アーヤ", "text": "それじゃ、今回はこれで。\n最後までつき合ってくれて\nありがと。"},
        { "location": "2531/Talk", "narrator": "アーヤ", "text": "またいろんな所で\n会いましょ。\n楽しみにしてるから。"},
