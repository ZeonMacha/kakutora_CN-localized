{
    "dir": "stream_150_ch011ACTOnCancel2ACTOnCancel3ACTOnCancel4ACTOnCancel.json",
    "type": "watchanime",
    "info": {
    },
    "entry":
    [
        { "location": "2693/Talk", "narrator": "アーヤ", "text": "いきなりで悪いけど、\n実は残念なお知らせが\nあるの。"},
        { "location": "2694/Talk", "narrator": "ガブリエラ", "text": "まぁ、とりあえず\n聞くけど、何？"},
        { "location": "2695/Talk", "narrator": "みやび", "text": "うちとしては残念でも\n美味しいネタやったら\n構わんぞね。"},
        { "location": "2696/Talk", "narrator": "アーヤ", "text": "ええ、実は卯月から\nとてもとても強く強く\nお願いされて……。"},
        { "location": "2697/Talk", "narrator": "ガブリエラ", "text": "あっ、何かもう、\nその時点で聞きたく\nなくなってきたわ。"},
        { "location": "2698/Talk", "narrator": "みやび", "text": "もう卯月のお願い\nっちゅー時点で\n怪しさ爆発ぞね。"},
        { "location": "2699/Talk", "narrator": "アーヤ", "text": "それで、今回の\nこのコーナーのこと\nなんだけど……。"},
        { "location": "2700/Talk", "narrator": "アーヤ", "text": "つばめと二人だけで\nやりたいから、私たち\nは遠慮して欲しいと。"},
        { "location": "2701/Talk", "narrator": "ガブリエラ", "text": "ええと……？\nなんなのかしら……。"},
        { "location": "2702/Talk", "narrator": "みやび", "text": "まさかこない早う\n強攻手段に出るとは\n思わんかったぞね。"},
        { "location": "2703/Talk", "narrator": "アーヤ", "text": "そんなわけで私たちの\n出番はＯＰが終わる\nまでってことなのよ。"},
        { "location": "2704/Talk", "narrator": "ガブリエラ", "text": "……アーヤがそれで\nいいならまあ\nいいけど……。"},
        { "location": "2705/Talk", "narrator": "みやび", "text": "うちもええけんど\nガブちゃんやアーヤの\nファンが可哀相ぞね。"},
        { "location": "2706/Talk", "narrator": "みやび", "text": "ここ観るんは何ぞ\nアイテムとか\n使うろう？"},
        { "location": "2707/Talk", "narrator": "アーヤ", "text": "この埋め合わせは\nいずれ必ずするから\n許してちょうだい。"},
        { "location": "2708/Talk", "narrator": "ガブリエラ", "text": "少しくらいオアズケ\nさせるのも、たまには\nいいんじゃない？"},
        { "location": "2709/Talk", "narrator": "みやび", "text": "その分次回は\nガブちゃんのサービス\n３倍増しやきね。"},
        { "location": "2710/Talk", "narrator": "ガブリエラ", "text": "聞いてないし、\nやらないわよっ！？"},
        { "location": "2711/Talk", "narrator": "神楽", "text": "というわけで今回は\n私とつばめさんの\n二人だけですよっ！！"},
        { "location": "2712/Talk", "narrator": "つばめ", "text": "えぇぇぇっ！？\nふ、二人だけで\n大丈夫なのっ！？"},
        { "location": "2713/Talk", "narrator": "神楽", "text": "私に身も心も全て\n委ねてくれれば\n大丈夫ですっ！！"},
        { "location": "2714/Talk", "narrator": "つばめ", "text": "そ、それはそれで、\n何だかダメな気が\nするんだけど……。"},
        { "location": "2715/Talk", "narrator": "つばめ", "text": "やっぱりみんなを\n呼んで来た方が\nいいんじゃ……。"},
        { "location": "2716/Talk", "narrator": "神楽", "text": "そんな心配より映像を\n見ながらイチャイチャ\nしましょう♪"},
        { "location": "2717/Talk", "narrator": "つばめ", "text": "いきなり目的が\n違ってる気が\nするよっ！？"},
        { "location": "2718/Talk", "narrator": "神楽", "text": "気のせいですよっ。\n気のせいっ♪"},
        { "location": "2719/Talk", "narrator": "つばめ", "text": "ふえっ？　確かに\n美少女ですけど、\n残念って何がですか？"},
        { "location": "2720/Talk", "narrator": "神楽", "text": "つばめさん、\nありがとうアンド\n愛してるラビンユー。"},
        { "location": "2721/Talk", "narrator": "つばめ", "text": "ふえぇぇぇっ！？"},
        { "location": "2722/Talk", "narrator": "神楽", "text": "それはそれとして\n残念美少女とは私を\n少々見誤ってますね。"},
        { "location": "2723/Talk", "narrator": "神楽", "text": "私は最早、更に上の\n『無念美少女』の域に\n達してますよ！！"},
        { "location": "2724/Talk", "narrator": "つばめ", "text": "全然わからないけど\nすごいよ卯月さん！！"},
        { "location": "2725/Talk", "narrator": "神楽", "text": "あぁ、もっと褒めて。\nそして二人は幸せな\nキスを……。"},
        { "location": "2726/Talk", "narrator": "つばめ", "text": "えっえっ！？！？！？"},
        { "location": "2727/Talk", "narrator": "神楽", "text": "はっ！？\nもしかしてあなたは\n組織からの刺客っ！？"},
        { "location": "2728/Talk", "narrator": "つばめ", "text": "えぇっ！？\nな、何？　組織って\nどういうこと？"},
        { "location": "2729/Talk", "narrator": "神楽", "text": "それを話すとなると\n１クール分くらいの回想\nシーンに入りますけど…。"},
        { "location": "2730/Talk", "narrator": "神楽", "text": "覚悟はいいですか？"},
        { "location": "2731/Talk", "narrator": "つばめ", "text": "えっとえっと……\nがんばって聞くね！？"},
        { "location": "2732/Talk", "narrator": "神楽", "text": "私が毎晩ベッドの中で\n寝物語として話します\nから大丈夫ですよ♪"},
        { "location": "2733/Talk", "narrator": "つばめ", "text": "あれ！？\n今する話じゃ\nないのかな！？！？"},
        { "location": "2734/Talk", "narrator": "神楽", "text": "それより、せっかく\n秋葉原に来たんだから\n濃い話をします？"},
        { "location": "2735/Talk", "narrator": "つばめ", "text": "濃い話……？\nそれってわたしが\nついていける話？"},
        { "location": "2736/Talk", "narrator": "神楽", "text": "つばめさんもいずれは\nついて来て追い越す\nくらいの勢いで！"},
        { "location": "2737/Talk", "narrator": "つばめ", "text": "というか、この時の\n体験だけでもわたしは\n充分濃く感じたよ～。"},
        { "location": "2738/Talk", "narrator": "神楽", "text": "何言ってるんですか。\nこの時の私は一割も\n本気出してませんよ？"},
        { "location": "2739/Talk", "narrator": "つばめ", "text": "わたし、卯月さんが\nわからなくなって\nきたよ……。"},
        { "location": "2740/Talk", "narrator": "つばめ", "text": "さっきも何だか\n変な声で笑ってたし\n変なオーラ出てたし。"},
        { "location": "2741/Talk", "narrator": "神楽", "text": "つばめさん、それは\n幻聴アンド幻覚です。\n忘れてください。"},
        { "location": "2742/Talk", "narrator": "神楽", "text": "ぐふふふふふふっ♪\n気になりますか？\n知りたいですかぁ？"},
        { "location": "2743/Talk", "narrator": "つばめ", "text": "わわわわわっ、ダ、\nダメだよ卯月さんっ、\nあの本のことはっ。"},
        { "location": "2744/Talk", "narrator": "神楽", "text": "んん～？　どうして\n本について教えたら\nダメなんですか～？"},
        { "location": "2745/Talk", "narrator": "つばめ", "text": "だ、だって、\nあの本って、アレが\nソレで、え～と……。"},
        { "location": "2746/Talk", "narrator": "神楽", "text": "アレとかソレじゃ\nわかりませんよ～？\nもっとちゃんと～？"},
        { "location": "2747/Talk", "narrator": "つばめ", "text": "あぁーっんっ！！\n卯月さんの\n意地悪ぅっ！！"},
        { "location": "2748/Talk", "narrator": "神楽", "text": "確かに物理的に薄い\nですけど、何を\n言いたいんですか？"},
        { "location": "2749/Talk", "narrator": "つばめ", "text": "……ソノ話ハ\nヤメマショウ。"},
        { "location": "2750/Talk", "narrator": "神楽", "text": "唐突につばめさんが\n心の無いロボットの\nようにっ！？"},
        { "location": "2751/Talk", "narrator": "つばめ", "text": "ワタシハ何モ\n見テナイヨー。\n見テナイカラネー。"},
        { "location": "2752/Talk", "narrator": "神楽", "text": "つばめさんのプリンを\n食べたことは謝ります\nから帰ってきてっ！"},
        { "location": "2753/Talk", "narrator": "つばめ", "text": "何でみんなわたしの\n大切なプリンを\n食べちゃうのっ！？"},
        { "location": "2754/Talk", "narrator": "神楽", "text": "と、まぁ、\nそんなわけで、\n好奇心はほどほどに♪"},
        { "location": "2755/Talk", "narrator": "つばめ", "text": "見せられたわたしの\n立場はっ！？"},
        { "location": "2756/Talk", "narrator": "神楽", "text": "……何だかイラッと\nきました。"},
        { "location": "2757/Talk", "narrator": "つばめ", "text": "あっ、うん、\nき、気持ちは\nわかるよ……。"},
        { "location": "2758/Talk", "narrator": "神楽", "text": "待ってください。\nその認識は少し\n間違っています。"},
        { "location": "2759/Talk", "narrator": "神楽", "text": "実はつばめさんは\n着痩せするタイプ\nなんです！"},
        { "location": "2760/Talk", "narrator": "つばめ", "text": "ふえぇぇぇっ！？"},
        { "location": "2761/Talk", "narrator": "神楽", "text": "自虐的なリアクション\nしてますけど、\n結構大きいです！"},
        { "location": "2762/Talk", "narrator": "つばめ", "text": "わわわわわっ！？\nいいいいいきなり何を\n言い出すのっ！？"},
        { "location": "2763/Talk", "narrator": "神楽", "text": "この前一緒にお風呂に\n入った時もどさくさで\n観察しまくりました！"},
        { "location": "2764/Talk", "narrator": "つばめ", "text": "卯月さん、そんなこと\nしてたのっ！？"},
        { "location": "2765/Talk", "narrator": "神楽", "text": "ちなみに私の\n目視による\n推定サイズは……。"},
        { "location": "2766/Talk", "narrator": "つばめ", "text": "ストップ！\nストップっ！！\nストォーーップっ！！"},
        { "location": "2767/Talk", "narrator": "つばめ", "text": "ふえぇぇぇっ！？"},
        { "location": "2768/Talk", "narrator": "神楽", "text": "……なーんでそれを\n知ってるんですかー？"},
        { "location": "2769/Talk", "narrator": "つばめ", "text": "き、気のせいですっ！\nわ、わたしなんて\nささやかなものでっ！"},
        { "location": "2770/Talk", "narrator": "神楽", "text": "黙らっしゃい！\n今はそれどころじゃ\nありませんっ！"},
        { "location": "2771/Talk", "narrator": "つばめ", "text": "う、卯月さんっ！？"},
        { "location": "2772/Talk", "narrator": "神楽", "text": "これは私しか知らない\nつばめさんの極秘事項\nなはずですよ？"},
        { "location": "2773/Talk", "narrator": "神楽", "text": "つばめさんの部屋に\n遊びに行った時に\nブラも確認済みです！"},
        { "location": "2774/Talk", "narrator": "つばめ", "text": "えっ！？\n聞いてくれたら\n教えたよ？"},
        { "location": "2775/Talk", "narrator": "神楽", "text": "つばめさん！？\n普通に言ってますが\n爆弾発言すぎますよ！？"},
        { "location": "2776/Talk", "narrator": "神楽", "text": "とにかくつばめさんを\n不埒な目で見るのは\n禁止ですっ！！"},
        { "location": "2777/Talk", "narrator": "つばめ", "text": "……卯月さんったら。\nそんな人いないから\n大丈夫だよ？"},
        { "location": "2778/Talk", "narrator": "神楽", "text": "天然すぎるのも\nいい加減にしてください\nもう！"},
        { "location": "2779/Talk", "narrator": "つばめ", "text": "でも人形ってどうして\nあんなに色んな所を\n強調してるんだろ？"},
        { "location": "2780/Talk", "narrator": "神楽", "text": "それは勿論、男性の\n夢と希望とロマンが\n詰まってるからです。"},
        { "location": "2781/Talk", "narrator": "つばめ", "text": "それにしたって\nちょっと詰めすぎじゃ\nないかなー？"},
        { "location": "2782/Talk", "narrator": "神楽", "text": "それはさておき、\nここは私が大好きな\nお店なんですよっ！"},
        { "location": "2783/Talk", "narrator": "つばめ", "text": "うん、雰囲気が\n落ち着いてて、\nいい感じだよね。"},
        { "location": "2784/Talk", "narrator": "つばめ", "text": "でも何で店員さんが\nメイドさん？\nの格好してるの？"},
        { "location": "2785/Talk", "narrator": "神楽", "text": "このお店も分類的には\nメイドカフェに\nなりますから。"},
        { "location": "2786/Talk", "narrator": "つばめ", "text": "えっ？　でも、\nメイドカフェって\nもっと、こう……。"},
        { "location": "2787/Talk", "narrator": "つばめ", "text": "美味しくなーれ♪\nみたいな？\nち、違ったかな？"},
        { "location": "2788/Talk", "narrator": "神楽", "text": "いえ、メイドカフェと\n言えば普通はそっちを\n連想しますよね。"},
        { "location": "2789/Talk", "narrator": "つばめ", "text": "うん、ＴＶとかで\n見たことしか\nなかったから……。"},
        { "location": "2790/Talk", "narrator": "神楽", "text": "いえ、それはそれで\n私は好きですから\n大丈夫ですよっ。"},
        { "location": "2791/Talk", "narrator": "神楽", "text": "そういうメイドカフェ\nにも今度一緒に\n行きましょうねっ♪"},
        { "location": "2792/Talk", "narrator": "つばめ", "text": "う、うん、そうだね。\n実際に行ってみたら\nきっと楽しいよね？"},
        { "location": "2793/Talk", "narrator": "神楽", "text": "ええ、美味しくなる\n魔法をかけてくれる\nお店もいいですけど。"},
        { "location": "2794/Talk", "narrator": "神楽", "text": "でも、ゆっくりと\nくつろぎたい時は\nここなんです。"},
        { "location": "2795/Talk", "narrator": "つばめ", "text": "うん、ハーブティーも\n美味しいし、読書とか\nするのによさそう♪"},
        { "location": "2796/Talk", "narrator": "神楽", "text": "そう言って貰えて\n安心しました。\n引かれちゃうかと。"},
        { "location": "2797/Talk", "narrator": "つばめ", "text": "そんなことないよ。\nまた卯月さんと\n来たいな。"},
        { "location": "2798/Talk", "narrator": "神楽", "text": "つばめさん……。"},
        { "location": "2799/Talk", "narrator": "神楽", "text": "私、つばめさんに\n隠していることが\nあるんです……。"},
        { "location": "2800/Talk", "narrator": "つばめ", "text": "あっ、わかった！\n今度は、どこのお姫様\nって言い出すつもり？"},
        { "location": "2801/Talk", "narrator": "神楽", "text": "実は私は異世界から\nお嫁さんを探しに来た\n王女なんだぴょん♪"},
        { "location": "2802/Talk", "narrator": "つばめ", "text": "えっと！？\n何言ってるか\nわからないよ！？"},
        { "location": "2803/Talk", "narrator": "神楽", "text": "異世界の常識、現実の\n非常識。お嫁さん捕獲\n当たり前の儀式。"},
        { "location": "2804/Talk", "narrator": "つばめ", "text": "卯月さん！？\n卯月さん！？！？！？"},
        { "location": "2805/Talk", "narrator": "神楽", "text": "つばめさんは身も心も\n私に委ねてくれれば\nそれでいいんですよ♪"},
        { "location": "2806/Talk", "narrator": "つばめ", "text": "こ、こんな時は、\nみやびさん直伝の……\nな、なんでやねんっ！"},
        { "location": "2807/Talk", "narrator": "神楽", "text": "みやびさんは関西人\nじゃありませんから\n直伝は偽りアリです！"},
        { "location": "2808/Talk", "narrator": "つばめ", "text": "そうなの？\n似たようなものだと\n思うんだけど？"},
        { "location": "2809/Talk", "narrator": "神楽", "text": "その発言は本気で命に\n関わるので、二度と\n口にしない方が……。"},
        { "location": "2810/Talk", "narrator": "つばめ", "text": "ふえぇぇぇっ！？"},
        { "location": "2811/Talk", "narrator": "つばめ", "text": "そ、それは、だって、\n何だか恥ずかしく\nなっちゃって……。"},
        { "location": "2812/Talk", "narrator": "神楽", "text": "それは私を\n意識しちゃったって\nことですか？"},
        { "location": "2813/Talk", "narrator": "つばめ", "text": "そ、そういうわけじゃ\nなくて！"},
        { "location": "2814/Talk", "narrator": "神楽", "text": "あらー……、\nばっさりと斬り捨てら\nれちゃいました……。"},
        { "location": "2815/Talk", "narrator": "つばめ", "text": "あああっ、え、えーと\nだから、その、わたし\nこういうのっていうか"},
        { "location": "2816/Talk", "narrator": "つばめ", "text": "友だちとこういうの\n撮ったことなくて、\nだからっ……。"},
        { "location": "2817/Talk", "narrator": "神楽", "text": "なるほど、つまり私が\nつばめさんの初めての\n相手ってことですね！"},
        { "location": "2818/Talk", "narrator": "つばめ", "text": "そうなんだけど……。\n改めて言われると\nちょっと恥ずかしいな。"},
        { "location": "2819/Talk", "narrator": "神楽", "text": "今回は私のわがままを\n聞いてもらって\n感謝しています。"},
        { "location": "2820/Talk", "narrator": "神楽", "text": "でも、次回は\nもしかしたら\nもう私は……。"},
        { "location": "2821/Talk", "narrator": "神楽", "text": "……あっ、いえ、\n何でもありません。\nそれでは、また……。"},
        { "location": "2822/Talk", "narrator": "神楽", "text": "ほほぅ？\n見返りは何でしょう？"},
        { "location": "2823/Talk", "narrator": "神楽", "text": "そもそも、何に使う\nつもりなんですかぁ？"},
        { "location": "2824/Talk", "narrator": "神楽", "text": "私以外が悪用するのは\n許しませんよ？"},
        { "location": "2825/Talk", "narrator": "つばめ", "text": "卯月さんは\nどんなことに\n悪用してるのっ！？"},
        { "location": "2826/Talk", "narrator": "神楽", "text": "冗談ですってば。\n人には言えないことに\n使ってるだけですよ♪"},
        { "location": "2827/Talk", "narrator": "つばめ", "text": "えっ！？"},
        { "location": "2828/Talk", "narrator": "神楽", "text": "なんて。\n冗談ですよ\n冗談♪"},
        { "location": "2829/Talk", "narrator": "つばめ", "text": "そうなの？\nもー。"},
        { "location": "2830/Talk", "narrator": "神楽", "text": "つばめさんから\n純朴な笑顔が\n失われていく……。"},
        { "location": "2831/Talk", "narrator": "神楽", "text": "それはそれで\nいいものですよね♪"},
        { "location": "2832/Talk", "narrator": "つばめ", "text": "大体、これって一体\n何だったの！？\nい、いきなり……。"},
        { "location": "2833/Talk", "narrator": "神楽", "text": "何だと言われても……\n本能？　衝動？\n野性の目覚め？"},
        { "location": "2834/Talk", "narrator": "つばめ", "text": "何を言ってるのか\nわかんないよ！？"},
        { "location": "2835/Talk", "narrator": "神楽", "text": "こう、穴があるとつい\n指を入れてみたくなる\nような感覚？"},
        { "location": "2836/Talk", "narrator": "つばめ", "text": "微妙に理解したくない\n例えだねそれ……。"},
        { "location": "2837/Talk", "narrator": "神楽", "text": "あっ！　つばめさんの\n笑顔をまた曇らせて\nいるのは誰っ！？"},
        { "location": "2838/Talk", "narrator": "つばめ", "text": "じぃ～～～～……っ。"},
        { "location": "2839/Talk", "narrator": "神楽", "text": "つばめさん、その視線\nちょっと痛くて\n切なくなりますっ！"},
        { "location": "2840/Talk", "narrator": "神楽", "text": "でもこれはこれで\nくせになって\nしまいそう……。"},
        { "location": "2841/Talk", "narrator": "つばめ", "text": "とかふざけてるから\nいきなりアラートが\n来ちゃったよ！"},
        { "location": "2842/Talk", "narrator": "神楽", "text": "楽しくて幸せな時間は\n突然終わってしまう\nものなんですね……。"},
        { "location": "2843/Talk", "narrator": "つばめ", "text": "でも、これもお仕事？\nだから仕方ないよね。"},
        { "location": "2844/Talk", "narrator": "つばめ", "text": "って、卯月さん、\n何だか顔色が……？\n大丈夫？"},
        { "location": "2845/Talk", "narrator": "神楽", "text": "え、ええ、\n大丈夫ですよ？"},
        { "location": "2846/Talk", "narrator": "神楽", "text": "今回はつばめさんと\n二人きりだったから"},
        { "location": "2847/Talk", "narrator": "神楽", "text": "はしゃぎ過ぎ\nちゃったのかも\nしれないですね。"},
        { "location": "2848/Talk", "narrator": "つばめ", "text": "そう？　じゃあ次は\nまたみんなで楽しく\n観ようね♪"},
        { "location": "2849/Talk", "narrator": "神楽", "text": "……そうですね……。"},
        { "location": "2850/Talk", "narrator": "つばめ", "text": "はぁ～っ……やっぱり\n二人きりで話すのは\n緊張するね……。"},
        { "location": "2851/Talk", "narrator": "つばめ", "text": "ていうか、わたし\n卯月さんに振り回され\nでばっかだったし。"},
        { "location": "2852/Talk", "narrator": "つばめ", "text": "卯月さんもやっぱり\n張り切り過ぎて\n疲れちゃったのかな？"}
