{
    "dir": "stream_170_ch011ACTOnCancel2ACTOnCancel3ACTOnCancel4ACTOnCancel5ACTOnCancel6ACTOnCancel7ACTOnCancel.json",
    "type": "watchanime",
    "info": {
    },
    "entry":
    [
        { "location": "3482/Talk", "narrator": "アーヤ", "text": "知っている人もいる\nと思うけれど、今回は\nみやびが欠席なの。"},
        { "location": "3483/Talk", "narrator": "ガブリエラ", "text": "休むなら休むでいいん\nだけど、理由は秘密\nとかふざけてるわね。"},
        { "location": "3484/Talk", "narrator": "つばめ", "text": "きっとみやびさんは\nまた裏で何やかんや\nしてるんですよ。"},
        { "location": "3485/Talk", "narrator": "ガブリエラ", "text": "その言い方だと\nロクでもないこと\nしてるみたいよ？"},
        { "location": "3486/Talk", "narrator": "つばめ", "text": "……あの、ところで\n卯月さんは？"},
        { "location": "3487/Talk", "narrator": "アーヤ", "text": "今回、卯月から\n欠席の連絡は\n来てないけれど……。"},
        { "location": "3488/Talk", "narrator": "ガブリエラ", "text": "前回の今回じゃ\n来なくても\n仕方ないわよね。"},
        { "location": "3489/Talk", "narrator": "つばめ", "text": "そ、そんな、卯月さん\nこのままずっと来ない\nなんてないですよね？"},
        { "location": "3490/Talk", "narrator": "アーヤ", "text": "……ええ、そうね。\nだから卯月がいつでも\n戻って来られるように"},
        { "location": "3491/Talk", "narrator": "アーヤ", "text": "私たちまで暗い顔を\nしていてはダメ。\nわかった？"},
        { "location": "3492/Talk", "narrator": "つばめ", "text": "アーヤさん……。"},
        { "location": "3493/Talk", "narrator": "ガブリエラ", "text": "まずいわね。ボケたり\n茶化してくれる\nみやびがいないだけで"},
        { "location": "3494/Talk", "narrator": "ガブリエラ", "text": "何だか空気が\n違うんだけど。"},
        { "location": "3495/Talk", "narrator": "つばめ", "text": "じゃあ今回はわたしが\nみやびさんの分まで\nボケまくります！"},
        { "location": "3496/Talk", "narrator": "ガブリエラ", "text": "つばめは普段から\n天然ボケ\n入れまくってるし。"},
        { "location": "3497/Talk", "narrator": "つばめ", "text": "ふえぇっ！？\nそ、そうだったの？"},
        { "location": "3498/Talk", "narrator": "アーヤ", "text": "無自覚であるが故の\n天然なんだから\n仕方ないわね。"},
        { "location": "3499/Talk", "narrator": "つばめ", "text": "アーヤさんまで！？"},
        { "location": "3500/Talk", "narrator": "つばめ", "text": "じゃ、じゃあ今回は\nわたし絶対に\nボケないんだから！"},
        { "location": "3501/Talk", "narrator": "ガブリエラ", "text": "決意変えるの\n早過ぎない？"},
        { "location": "3502/Talk", "narrator": "つばめ", "text": "あの、みやびさんは\n突然何を\n言い出したんですか？"},
        { "location": "3503/Talk", "narrator": "アーヤ", "text": "この疑似ゲーム世界の\n攻略法を私たちに\n伝えているのよ。"},
        { "location": "3504/Talk", "narrator": "ガブリエラ", "text": "伊達に裏で動いてた\nわけじゃなかったって\nことね。"},
        { "location": "3505/Talk", "narrator": "つばめ", "text": "ふむふむなるほど。\n何が何やらさっぱり\nわかりません！"},
        { "location": "3506/Talk", "narrator": "つばめ", "text": "あっ、ガブちゃんが\nすっごくいいこと\n言ってるから注目！"},
        { "location": "3507/Talk", "narrator": "ガブリエラ", "text": "お、大袈裟ね。\n当たり前のこと\n言ってるだけでしょ。"},
        { "location": "3508/Talk", "narrator": "アーヤ", "text": "でもギャヴィのお陰で\n私も動揺し過ぎないで\n済んだわ。"},
        { "location": "3509/Talk", "narrator": "つばめ", "text": "プライベート通信って\n何で普段は\n使ってないんですか？"},
        { "location": "3510/Talk", "narrator": "アーヤ", "text": "確かに盗聴防止能力は\n高いけれど、\n音声メインになるし、"},
        { "location": "3511/Talk", "narrator": "アーヤ", "text": "聞こえづらい時も\nあるから常用には\n向かないのよ。"},
        { "location": "3512/Talk", "narrator": "アーヤ", "text": "普通のクランなら\n通常通信が傍受される\nことはまず無いし。"},
        { "location": "3513/Talk", "narrator": "つばめ", "text": "なるほど～。\n一長一短って\nわけなんですね。"},
        { "location": "3514/Talk", "narrator": "ガブリエラ", "text": "待って！　もしかして\nつばめが四文字熟語を\n使った！？"},
        { "location": "3515/Talk", "narrator": "つばめ", "text": "ガブちゃん、それ、\n驚くポイント\nおかしいよね！？"},
        { "location": "3516/Talk", "narrator": "アーヤ", "text": "少しわかりづらかった\nかしら？"},
        { "location": "3517/Talk", "narrator": "アーヤ", "text": "じゃあ順を追って\n説明するわね。"},
        { "location": "3518/Talk", "narrator": "アーヤ", "text": "その言い方だと\n何をするのかは\nわかっているようね。"},
        { "location": "3519/Talk", "narrator": "アーヤ", "text": "でも一応順を追って\n説明するわね。"},
        { "location": "3520/Talk", "narrator": "アーヤ", "text": "まずは私が囮になって\n暴れるの。"},
        { "location": "3521/Talk", "narrator": "ガブリエラ", "text": "で、その隙にあたしが\nバックドアを撃つと。"},
        { "location": "3522/Talk", "narrator": "ガブリエラ", "text": "でもセキュリティに\n防がれて、向こうは\nいい気になってるけど"},
        { "location": "3523/Talk", "narrator": "ガブリエラ", "text": "セキュリティホールが\nあることには気づいて\nないから、"},
        { "location": "3524/Talk", "narrator": "つばめ", "text": "その小さな穴を\nわたしが──"},
        { "location": "3525/Talk", "narrator": "つばめ", "text": "とどめのどーん！\nでフィニッシュ！！\nって流れでしたっ♪"},
        { "location": "3526/Talk", "narrator": "ガブリエラ", "text": "つばめも\nぶっつけ本番にしては\n上出来だったわね。"},
        { "location": "3527/Talk", "narrator": "つばめ", "text": "えへへっ♪\nわたしって本番に\n強いタイプなのかも？"},
        { "location": "3528/Talk", "narrator": "ガブリエラ", "text": "あんた、それ以上\n言ったらこのアプリが\n消えるわよ……。"},
        { "location": "3529/Talk", "narrator": "アーヤ", "text": "ギャヴィのその\nメタっぽい発言も\n微妙よ……。"},
        { "location": "3530/Talk", "narrator": "つばめ", "text": "ガブちゃんがメタル？\nギャヴィメタル？\nギャヴィメタ！？"},
        { "location": "3531/Talk", "narrator": "ガブリエラ", "text": "みやびの分まで\nそんなに無理に\nボケなくていいから。"},
        { "location": "3532/Talk", "narrator": "つばめ", "text": "ボケてないよっ！？"},
        { "location": "3533/Talk", "narrator": "ガブリエラ", "text": "何かそれ\n安っぽいアニメの\nタイトルみたいね。"},
        { "location": "3534/Talk", "narrator": "つばめ", "text": "安っぽいは\n余計だよっ！"},
        { "location": "3535/Talk", "narrator": "アーヤ", "text": "……つばめ、\nもしかして\n気に入ったの？"},
        { "location": "3536/Talk", "narrator": "つばめ", "text": "そ、それほどでも\nな、ないですけど？"},
        { "location": "3537/Talk", "narrator": "ガブリエラ", "text": "気に入ったのね……。"},
        { "location": "3538/Talk", "narrator": "アーヤ", "text": "ナイスキャッチよ、\nつばめ。"},
        { "location": "3539/Talk", "narrator": "ガブリエラ", "text": "ていうか、\nこのラブコメっぽい\n展開は何なの？"},
        { "location": "3540/Talk", "narrator": "ガブリエラ", "text": "しかも「神楽ちゃん」\nって、どういう心境の\n変化なわけ？"},
        { "location": "3541/Talk", "narrator": "つばめ", "text": "えっ……どういうって\n言われても、自然に\n口から出ちゃって。"},
        { "location": "3542/Talk", "narrator": "アーヤ", "text": "きっと、つばめの\n素直な気持ちが言葉に\nなって出たのね。"},
        { "location": "3543/Talk", "narrator": "つばめ", "text": "でも今改めて見ると\n何だかすっごく\n恥ずかしいよぉ～。"},
        { "location": "3544/Talk", "narrator": "ガブリエラ", "text": "けど今でもつばめ、\n「神楽ちゃん」呼びの\nままよね？"},
        { "location": "3545/Talk", "narrator": "つばめ", "text": "また「卯月さん」に\n戻すのは戻すので\n何だか恥ずかしくて。"},
        { "location": "3546/Talk", "narrator": "アーヤ", "text": "でもＷＡＶＥでは\nまだ「卯月さん」って\n書いてたような？"},
        { "location": "3547/Talk", "narrator": "つばめ", "text": "「神楽ちゃん」って\n字で打つのは何だか\nこそばゆくて……。"},
        { "location": "3548/Talk", "narrator": "ガブリエラ", "text": "何か意味わかんなく\nなってきたんだけど。"},
        { "location": "3549/Talk", "narrator": "つばめ", "text": "ふぇぇっ！？\nち、違うよっ！\n違うってばーっ！"},
        { "location": "3550/Talk", "narrator": "ガブリエラ", "text": "ううん、恋でしょ。"},
        { "location": "3551/Talk", "narrator": "つばめ", "text": "やだ、ガブちゃん、\nここぞとばかりに\nからかわないでよっ。"},
        { "location": "3552/Talk", "narrator": "アーヤ", "text": "私も、多分恋じゃ\nないかなって\n思っていたところよ。"},
        { "location": "3553/Talk", "narrator": "つばめ", "text": "ア、アーヤさんまで\nそんな、わ、わたし、\n恥ずかしいよぉ……。"},
        { "location": "3554/Talk", "narrator": "つばめ", "text": "あっ、何か今わたし、\n超すごいみたいな\n感じじゃないですか？"},
        { "location": "3555/Talk", "narrator": "ガブリエラ", "text": "褒められてるわけじゃ\nないと思うんだけど。"},
        { "location": "3556/Talk", "narrator": "つばめ", "text": "そうかな？　だって\n時空だよ？　時空！\n空から降って来そう！"},
        { "location": "3557/Talk", "narrator": "アーヤ", "text": "それはそれで\n何だか物騒\nなのだけれど……。"},
        { "location": "3558/Talk", "narrator": "ガブリエラ", "text": "そういえば神楽の方は\n「つばめさん」の\nままよね。"},
        { "location": "3559/Talk", "narrator": "ガブリエラ", "text": "これって神楽は\nつばめのことを大して\n好きでもなくて、"},
        { "location": "3560/Talk", "narrator": "ガブリエラ", "text": "何とも思ってないまま\n心境の変化は無かった\nってことじゃない？"},
        { "location": "3561/Talk", "narrator": "つばめ", "text": "ガブちゃんってば、\nそ、そんなこと\nないよぉ～っ。"},
        { "location": "3562/Talk", "narrator": "つばめ", "text": "……あっ、でも、\nやっぱりあるかも？\nそんな気がしてきた。"},
        { "location": "3563/Talk", "narrator": "つばめ", "text": "うぅっ、自信無いっ。\n今回も神楽ちゃん\nいないし……。"},
        { "location": "3564/Talk", "narrator": "神楽", "text": "一体いつから\n私がいないと\n錯覚してました？"},
        { "location": "3565/Talk", "narrator": "つばめ", "text": "ふえぇっ！？\n神楽ちゃんっ！？"},
        { "location": "3566/Talk", "narrator": "ガブリエラ", "text": "神楽、あんた\nいつの間にっ！？"},
        { "location": "3567/Talk", "narrator": "アーヤ", "text": "全く気配を\n感じなかったわ……。"},
        { "location": "3568/Talk", "narrator": "つばめ", "text": "神楽ちゃん、\n急に来たりして\n一体どうしたの！？"},
        { "location": "3569/Talk", "narrator": "神楽", "text": "ええ、とりあえず、\n映像の続きを\n再開してください。"},
        { "location": "3570/Talk", "narrator": "神楽", "text": "実はこのシーンだけは\n改めてもう一度\n見ておきたかったの。"},
        { "location": "3571/Talk", "narrator": "ガブリエラ", "text": "確かに神楽の\n見せ場ではあったけど\nわざわざ来るほど？"},
        { "location": "3572/Talk", "narrator": "神楽", "text": "こいつホントにクソ！\n何度見てもやっぱり\n吐き気がするわっ！"},
        { "location": "3573/Talk", "narrator": "つばめ", "text": "か、神楽ちゃん、\nキャラがすっごく\n変わっちゃってるよ？"},
        { "location": "3574/Talk", "narrator": "ガブリエラ", "text": "変わったっていうか\nそれが素じゃない？"},
        { "location": "3575/Talk", "narrator": "神楽", "text": "違いますーっ。今は\nチョイ悪ワイルドな\n気分なんですーっ。"},
        { "location": "3576/Talk", "narrator": "アーヤ", "text": "むしろストレス発散？\nそれもアリだとは\n思うけれど。"},
        { "location": "3577/Talk", "narrator": "神楽", "text": "はい、その通り、\nこれでやっと\nスッキリしました！"},
        { "location": "3578/Talk", "narrator": "神楽", "text": "皆さんに今さら言う\n必要なんて無いと\n思いますけど、"},
        { "location": "3579/Talk", "narrator": "神楽", "text": "ゲームはルールと\nマナーを守って\n楽しみましょうねっ♪"},
        { "location": "3580/Talk", "narrator": "つばめ", "text": "確かゲームは\n一日一時間まで\nなんだっけ？"},
        { "location": "3581/Talk", "narrator": "ガブリエラ", "text": "……あんたそれ\nいつの時代の話よ？"},
        { "location": "3582/Talk", "narrator": "つばめ", "text": "ふわぁ～……。\n神楽ちゃん、\nかっこいい……。"},
        { "location": "3583/Talk", "narrator": "神楽", "text": "……いきなり何を\n言ってるんですか？"},
        { "location": "3584/Talk", "narrator": "つばめ", "text": "クズ野郎な人を\n倒してくれて\nありがとうってこと？"},
        { "location": "3585/Talk", "narrator": "アーヤ", "text": "つばめ、それ以上\n深く考えない方が\nいいわ。"},
        { "location": "3586/Talk", "narrator": "つばめ", "text": "えっ？　えっ？"},
        { "location": "3587/Talk", "narrator": "ガブリエラ", "text": "天然記念物は\n天然のままが\nいいってことよ。"},
        { "location": "3588/Talk", "narrator": "つばめ", "text": "ガブちゃん、\n意地悪しないで\n教えてっ！"},
        { "location": "3589/Talk", "narrator": "神楽", "text": "……子豚ちゃん業界の\n方から来んですか？"},
        { "location": "3590/Talk", "narrator": "つばめ", "text": "何だか可愛いね！"},
        { "location": "3591/Talk", "narrator": "ガブリエラ", "text": "いや、絶対にあんたが\n想像してるのと\n違うから。"},
        { "location": "3592/Talk", "narrator": "つばめ", "text": "子豚はとっても\n美味しそうで\n可愛いよ？"},
        { "location": "3593/Talk", "narrator": "ガブリエラ", "text": "あんたの規準は\nそこなの！？"},
        { "location": "3594/Talk", "narrator": "神楽", "text": "それじゃあ私は\nここまででっ！"},
        { "location": "3595/Talk", "narrator": "つばめ", "text": "えっ？　もう少しで\n終わりなのに\n何でっ！？"},
        { "location": "3596/Talk", "narrator": "ガブリエラ", "text": "そりゃ自分が怒られる\nシーンを見たいわけ\nないでしょ。"},
        { "location": "3597/Talk", "narrator": "つばめ", "text": "あっ……。\nだ、だって、\nそれは……。"},
        { "location": "3598/Talk", "narrator": "ガブリエラ", "text": "責めてたおまえたちが\n言うなって\n感じでしょうけど、"},
        { "location": "3599/Talk", "narrator": "ガブリエラ", "text": "神楽の家だったなんて\n知らなかったんだし、\n仕方無いじゃない。"},
        { "location": "3600/Talk", "narrator": "ガブリエラ", "text": "そもそもメノウの\nことだってあったし。"},
        { "location": "3601/Talk", "narrator": "ガブリエラ", "text": "事情を知ってたら\nあんな言い方は\nしないってば。"},
        { "location": "3602/Talk", "narrator": "アーヤ", "text": "そうね。でもこの場で\n責めるべきでは\nなかったとは思うわ。"},
        { "location": "3603/Talk", "narrator": "アーヤ", "text": "私も少し軽率だった。\nごめんなさい、\nつばめ。"},
        { "location": "3604/Talk", "narrator": "つばめ", "text": "いえ、わたしも\n責めてるわけじゃ\nないですから……。"},
        { "location": "3605/Talk", "narrator": "アーヤ", "text": "それにしても、\nここのつばめ、\nまるで天使みたいね。"},
        { "location": "3606/Talk", "narrator": "つばめ", "text": "ふえぇっ！？\nい、いきなりどうした\nんですかっ！？"},
        { "location": "3607/Talk", "narrator": "アーヤ", "text": "妹のような\nあどけなさの中に\n母性を感じるわ。"},
        { "location": "3608/Talk", "narrator": "ガブリエラ", "text": "……アーヤ、何か\n悪い物でも食べた？"},
        { "location": "3609/Talk", "narrator": "ガブリエラ", "text": "言ってることが画面の\n向こうの誰かさんに\nそっくりなんだけど？"},
        { "location": "3610/Talk", "narrator": "アーヤ", "text": "そ、そんな大袈裟な\n意味じゃないわ。\nき、気のせいよ？"},
        { "location": "3611/Talk", "narrator": "つばめ", "text": "ところで、\nこの後ろのガブちゃん\n何を言ってるの？"},
        { "location": "3612/Talk", "narrator": "ガブリエラ", "text": "さ、さぁ？\n音声解析でもしたら\nわかるんじゃない？"},
        { "location": "3613/Talk", "narrator": "つばめ", "text": "え～？\n教えてよ、\nガブちゃ～ん。"},
        { "location": "3614/Talk", "narrator": "ガブリエラ", "text": "だから、気やすく\nガブちゃんって\n呼ばないでってばっ！"},
        { "location": "3615/Talk", "narrator": "つばめ", "text": "じゃあ、ガブさん？\nガブ様？　ガブ殿？"},
        { "location": "3616/Talk", "narrator": "ガブリエラ", "text": "……うん、\nガブちゃんで\nいいわ……。"},
        { "location": "3617/Talk", "narrator": "つばめ", "text": "……あれ？\nでもこの子って、\nどこかで見たような？"},
        { "location": "3618/Talk", "narrator": "ガブリエラ", "text": "冷静な反応で\nスルーするなんて\nつばめもやるわね。"},
        { "location": "3619/Talk", "narrator": "つばめ", "text": "ふぇっ！？\nそ、そんなつもり\n……無いですよ？"},
        { "location": "3620/Talk", "narrator": "アーヤ", "text": "その微妙な間が\n逆に気になって\nしまうわね。"},
        { "location": "3621/Talk", "narrator": "つばめ", "text": "ラスボス？\nつまりわたしたちの\n敵ってことですか？"},
        { "location": "3622/Talk", "narrator": "ガブリエラ", "text": "だとしたら神楽は\n敵に内通してるって\nことになるけど？"},
        { "location": "3623/Talk", "narrator": "つばめ", "text": "あぁっ！\nナシナシ！\n今のはナシでっ！！"},
        { "location": "3624/Talk", "narrator": "アーヤ", "text": "貴方もあまり人聞きの\n悪いことは言わないで\nちょうだいね。"},
        { "location": "3625/Talk", "narrator": "つばめ", "text": "よくわかんないけど、\nこんなの神楽ちゃんが\n可哀相だよ。"},
        { "location": "3626/Talk", "narrator": "つばめ", "text": "それに、何だか、\nこの白い子、\n鬼みたいな感じ……。"},
        { "location": "3627/Talk", "narrator": "つばめ", "text": "えっ？\nこの白い子、\nちはるって言うの？"},
        { "location": "3628/Talk", "narrator": "つばめ", "text": "えっ！？　もしかして\n本当にこの人、\n鬼だったりするの！？"},
        { "location": "3629/Talk", "narrator": "ガブリエラ", "text": "ていうか何でアンタが\n名前知ってるわけ？\nもしかしてグル？"},
        { "location": "3630/Talk", "narrator": "アーヤ", "text": "私たちは全員、\n見たことも無いのに\n怪しいわね。"},
        { "location": "3631/Talk", "narrator": "ガブリエラ", "text": "いいからさっさと\nコイツの正体を\n白状しなさいっ！！"},
        { "location": "3632/Talk", "narrator": "ガブリエラ", "text": "チュートリアルで\n戯れてる？\n意味わかんないっ！"},
        { "location": "3633/Talk", "narrator": "アーヤ", "text": "卯月のことは私たちも\nしっかりフォローする\nべきよね。"},
        { "location": "3634/Talk", "narrator": "アーヤ", "text": "つばめにばかり\n心配かけさせていたら\nリーダー失格だわ。"},
        { "location": "3635/Talk", "narrator": "アーヤ", "text": "つばめ一人だけに\n辛い思いなんて\n絶対にさせないわ。"},
        { "location": "3636/Talk", "narrator": "ガブリエラ", "text": "みんなちょっと\n一人で抱え込もうと\nし過ぎじゃない？"},
        { "location": "3637/Talk", "narrator": "ガブリエラ", "text": "なーんてあたしが\n言っても説得力が\n無いかもね。"},
        { "location": "3638/Talk", "narrator": "ガブリエラ", "text": "少しみやびを見習って\nちゃらんぽらん風に\n生きてみようかしら？"},
        { "location": "3639/Talk", "narrator": "ガブリエラ", "text": "……その頭、撃ったら\n少しはマトモな人間に\nなるかしら？"},
        { "location": "3640/Talk", "narrator": "アーヤ", "text": "聞くだけ色々と\n無駄だったってことは\nわかったわ。"},
        { "location": "3641/Talk", "narrator": "ガブリエラ", "text": "とにかくつばめは\n神楽の心配してる\n場合じゃないでしょ！"},
        { "location": "3642/Talk", "narrator": "アーヤ", "text": "ええ、何だか急に\nきな臭くなって\nきたわね……。"},
        { "location": "3643/Talk", "narrator": "つばめ", "text": "わたしのことより\n神楽ちゃんの方が\n心配だよっ！"},
        { "location": "3644/Talk", "narrator": "つばめ", "text": "でも、みんなが心配\nするから、わたしも\nしっかりしなきゃ！"},
        { "location": "3645/Talk", "narrator": "つばめ", "text": "だからこれからも\nちゃんと見守ってて\nくださいね？"}
    ]
}
