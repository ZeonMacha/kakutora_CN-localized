{
    "dir": "stream_290_ch011ACTOnCancel2ACTOnCancel.json",
    "type": "watchanime",
    "info": {
    },
    "entry":
    [
        { "location": "5706/Talk", "narrator": "みやび", "text": "画面の前のみんな、\nお待たせーっ！"},
        { "location": "5707/Talk", "narrator": "ガブリエラ", "text": "って！\nいきなり変なキャラで\n出ないでよ！"},
        { "location": "5708/Talk", "narrator": "みやび", "text": "意外性こそが\n女の魅力を\n上げるぞね。"},
        { "location": "5709/Talk", "narrator": "ガブリエラ", "text": "意外性の塊が言っても\n説得力無いし。"},
        { "location": "5710/Talk", "narrator": "みやび", "text": "うちには魅力が\n無いっちゅうこと！？"},
        { "location": "5711/Talk", "narrator": "みやび", "text": "うぅ……ガブちゃんに\nお嫁に行けん体に\nされてもうた……。"},
        { "location": "5712/Talk", "narrator": "ガブリエラ", "text": "何それ……。"},
        { "location": "5713/Talk", "narrator": "アーヤ", "text": "みやびの場合はむしろ\n黙っていた方が魅力が\nある気もするけど。"},
        { "location": "5714/Talk", "narrator": "みやび", "text": "せやけど\n黙っているうちなど\nうちではないきに。"},
        { "location": "5715/Talk", "narrator": "つばめ", "text": "えーと、なんの話を\nしてるんですか？\nみやびさんの嫁入り？"},
        { "location": "5716/Talk", "narrator": "みやび", "text": "誰が、いきおくれや！"},
        { "location": "5717/Talk", "narrator": "つばめ", "text": "言ってないですし、\nそれを言ったらアーヤ\nさんの方が年上です！"},
        { "location": "5718/Talk", "narrator": "アーヤ", "text": "つばめ、ひどいわ。\n私が一番気にしいてる\nことを……しくしく。"},
        { "location": "5719/Talk", "narrator": "ガブリエラ", "text": "さっきから\nこの小芝居は\nなんなの？"},
        { "location": "5720/Talk", "narrator": "つばめ", "text": "なんなんでしょう？"},
        { "location": "5721/Talk", "narrator": "ガブリエラ", "text": "アンタも\n乗っかってたでしょ！"},
        { "location": "5722/Talk", "narrator": "みやび", "text": "もう、うちは\n付き合い切れんわ。"},
        { "location": "5723/Talk", "narrator": "みやび", "text": "アンタが言うなっ！"},
        { "location": "5724/Talk", "narrator": "ガブリエラ", "text": "ていうか、この電話！\nもしかして、これが\n出オチってヤツ？"},
        { "location": "5725/Talk", "narrator": "みやび", "text": "さすがはアーヤの家。\n１００年は過去に\n生きちょる。"},
        { "location": "5726/Talk", "narrator": "アーヤ", "text": "失礼ね！　せいぜい\n１０年ってところ\nでしょ？"},
        { "location": "5727/Talk", "narrator": "つばめ", "text": "１０年前でも、こんな\n電話は無かったと\n思いますよ……。"},
        { "location": "5728/Talk", "narrator": "みやび", "text": "この繋ぎ方知っちょる\n人って絶対４０歳以上\nのおじさんやね。"},
        { "location": "5729/Talk", "narrator": "アーヤ", "text": "パソコン通信でも、\n３００ボーとかの時代\nの人だけかもね。"},
        { "location": "5730/Talk", "narrator": "つばめ", "text": "３００ボー？\nって、なんですか？"},
        { "location": "5731/Talk", "narrator": "みやび", "text": "３００ｂｐｓのこと。\nちなみに今の光回線は\n１Ｇｂｐｓとかや。"},
        { "location": "5732/Talk", "narrator": "ガブリエラ", "text": "何倍っていうか\n何分の一なのよ\nその遅さは……。"},
        { "location": "5733/Talk", "narrator": "ガブリエラ", "text": "へー、「昔」そういう\n体験してきたんだ。"},
        { "location": "5734/Talk", "narrator": "アーヤ", "text": "こらギャヴィ、\nそういうデリケートな\n問題はやめなさい。"},
        { "location": "5735/Talk", "narrator": "みやび", "text": "もしかしてキミ、\nうちの親と\n同じくらいの……。"},
        { "location": "5736/Talk", "narrator": "アーヤ", "text": "こら。アーヤもよ。"},
        { "location": "5737/Talk", "narrator": "みやび", "text": "なんやテレホタイムも\n知らんクチ？"},
        { "location": "5738/Talk", "narrator": "ガブリエラ", "text": "何それ？"},
        { "location": "5739/Talk", "narrator": "みやび", "text": "んー、それを説明する\nのは意外と面倒いから\n検索してや。"},
        { "location": "5740/Talk", "narrator": "ガブリエラ", "text": "もう！\nこういう時だけ\n手を抜くんだから。"},
        { "location": "5741/Talk", "narrator": "みやび", "text": "キャーッ！\nエリカさーん！"},
        { "location": "5742/Talk", "narrator": "ガブリエラ", "text": "ていうか、ここどこ？"},
        { "location": "5743/Talk", "narrator": "つばめ", "text": "この部屋の押し入れ\nだったら、今期の\nお笑いＭＶＰですね！"},
        { "location": "5744/Talk", "narrator": "アーヤ", "text": "ちなみにこれケイマン\n諸島の映像だからって\n姉がケイマン諸島に"},
        { "location": "5745/Talk", "narrator": "アーヤ", "text": "いるわけじゃないから\n騙されないでね。"},
        { "location": "5746/Talk", "narrator": "みやび", "text": "情報操作の基本やね。\nうちも情報管理基礎Ⅰ\nで習ったわ。"},
        { "location": "5747/Talk", "narrator": "ガブリエラ", "text": "そういえばＦＡＸって\nもう日本でしか使われ\nてないのよね。"},
        { "location": "5748/Talk", "narrator": "みやび", "text": "逆に言えば未だに\n使える環境を維持して\nるいうことや。"},
        { "location": "5749/Talk", "narrator": "ガブリエラ", "text": "いやだからそれって\n無駄じゃないの？\n海外でも笑い話よ？"},
        { "location": "5750/Talk", "narrator": "アーヤ", "text": "確かに無駄だけれど\n未だにガラケーの人も\n結構いるわけだし。"},
        { "location": "5751/Talk", "narrator": "みやび", "text": "ガラケーじゃうちらと\n会えんぞね！？"},
        { "location": "5752/Talk", "narrator": "ガブリエラ", "text": "べつにガラケーしか\n持って無いってわけ\nじゃないでしょ。"},
        { "location": "5753/Talk", "narrator": "つばめ", "text": "あのー……ところで、\n前回吊るされてた\nわたしのその後は？"},
        { "location": "5754/Talk", "narrator": "ガブリエラ", "text": "まだ吊るされたまんま\nなんじゃない？"},
        { "location": "5755/Talk", "narrator": "みやび", "text": "あのまま燻製に\nされちょるかも\n知れんぞね。"},
        { "location": "5756/Talk", "narrator": "つばめ", "text": "スモークつばめアンド\n神楽ちゃん！？"},
        { "location": "5757/Talk", "narrator": "ガブリエラ", "text": "全く美味しそうに\n思えない響きが\nすごいわね……。"},
        { "location": "5758/Talk", "narrator": "みやび", "text": "な、\nなんだってーーー！？\n（お約束）"},
        { "location": "5759/Talk", "narrator": "みやび", "text": "いやー、\nつばめちゃん、\nパナいわー。"},
        { "location": "5760/Talk", "narrator": "つばめ", "text": "そんな褒められても\n何も出ませんよー。\nえへへっ♪"},
        { "location": "5761/Talk", "narrator": "ガブリエラ", "text": "でもさ、フェノメノン\nなのに何でこんな\n常識的な世界なの？"},
        { "location": "5762/Talk", "narrator": "アーヤ", "text": "いえ、その考え方が\n既に間違っているの\nかも知れないわよ。"},
        { "location": "5763/Talk", "narrator": "ガブリエラ", "text": "どーゆーこと！？"},
        { "location": "5764/Talk", "narrator": "アーヤ", "text": "私たちはこれが常識的\nだと思い込まされてる\nだけなのかも……。"},
        { "location": "5765/Talk", "narrator": "みやび", "text": "断絶された未開文明\nとか、そんな感じかも\n知れんぞね。"},
        { "location": "5766/Talk", "narrator": "つばめ", "text": "てことは例えば外では\n鼻からケーキを食べる\nのが常識だったり？"},
        { "location": "5767/Talk", "narrator": "ガブリエラ", "text": "このフェノメノンを\n絶対に死守しなくちゃ\nならないじゃないの！"},
        { "location": "5768/Talk", "narrator": "みやび", "text": "ガブちゃんが言うのも\nわかるけど、さすがに\n神様やないたみいや。"},
        { "location": "5769/Talk", "narrator": "アーヤ", "text": "つまり、つばめが創造\nしてるのではなく配役\nしてるってことね。"},
        { "location": "5770/Talk", "narrator": "ガブリエラ", "text": "もしかして、そもそも\nあたしが日本にいるの\nも改変なのかも……。"},
        { "location": "5771/Talk", "narrator": "アーヤ", "text": "無から造り出せはしな\nいけれど、容姿とかの\n改変は出来るわけね。"},
        { "location": "5772/Talk", "narrator": "みやび", "text": "しっかしこうやって\n横に並ぶとちち比べが\nわかりやすいわぁ。"},
        { "location": "5773/Talk", "narrator": "ガブリエラ", "text": "ちち比べ言うなぁっ！\nていうかこのアーヤ、\n盛ってない？"},
        { "location": "5774/Talk", "narrator": "みやび", "text": "いんや。これはうちが\n小さく見える工作を\nしてるだけぞね。"},
        { "location": "5775/Talk", "narrator": "ガブリエラ", "text": "なんなのよ、その\nイヤミたっぷりな\nな工作は……。"},
        { "location": "5776/Talk", "narrator": "みやび", "text": "脱いだらすごいちゅう\nインパクトの為の\n下準備や。"},
        { "location": "5777/Talk", "narrator": "つばめ", "text": "でも海での水着回\nもうやっちゃいました\nけど？"},
        { "location": "5778/Talk", "narrator": "ガブリエラ", "text": "……ねぇ、ところで\nつばめ、ちょっと\n話があるんだけど。"},
        { "location": "5779/Talk", "narrator": "つばめ", "text": "ガブちゃん、なんか\nよからぬこと\nたくらんでない！？"},
        { "location": "5780/Talk", "narrator": "ガブリエラ", "text": "は、はぁ？\n言っとくけどあたしは\n神楽よりはあるから！"},
        { "location": "5781/Talk", "narrator": "アーヤ", "text": "ギャヴィ、そんなに\n気にすることじゃない\nから落ち着きなさい。"},
        { "location": "5782/Talk", "narrator": "みやび", "text": "ところでキミは\n大中小、どれが\nお好みなんや？"},
        { "location": "5783/Talk", "narrator": "みやび", "text": "てことみたいやよ。\nアーヤ、がんばりや。"},
        { "location": "5784/Talk", "narrator": "アーヤ", "text": "自分を棚に上げといて\n私に振るわけ！？"},
        { "location": "5785/Talk", "narrator": "アーヤ", "text": "わ、私はべつに、\nだからどうって\nわけじゃなくて……。"},
        { "location": "5786/Talk", "narrator": "ガブリエラ", "text": "あ、あたしだって\n成長期なわけだし\nこのままじゃないし！"},
        { "location": "5787/Talk", "narrator": "つばめ", "text": "あぁっ！　ガブちゃん\n置いていかないで、\n見捨てないで！"},
        { "location": "5788/Talk", "narrator": "つばめ", "text": "そして捨てられた子犬\nのように空を見上げる\nわたし……。"},
        { "location": "5789/Talk", "narrator": "つばめ", "text": "とか言ってる場合じゃ\nなくなってきた\nのかなぁ？"},
        { "location": "5790/Talk", "narrator": "神楽", "text": "ややっ？　早速\nガブちゃんに\n浮気ですか？"},
        { "location": "5791/Talk", "narrator": "神楽", "text": "私は嫉妬深いので\n浮気はＮＧですよ！？"},
        { "location": "5792/Talk", "narrator": "神楽", "text": "……いやでもこれは\nガブちゃんも同時に\nゲットのチャンス？"},
        { "location": "5793/Talk", "narrator": "みやび", "text": "神楽の怒濤のボケ\nうちもツッコミ\nたかったわー。"},
        { "location": "5794/Talk", "narrator": "みやび", "text": "というか、このモード\nそもそも何で四人しか\n出られんぞね？"},
        { "location": "5795/Talk", "narrator": "みやび", "text": "え？　そこに触れたら\n消される？\nまた禁断ワードかい！"},
        { "location": "5796/Talk", "narrator": "アーヤ", "text": "えーと……コメントに\n困る展開だったわね。"},
        { "location": "5797/Talk", "narrator": "アーヤ", "text": "でも、まぁ、卯月の\nお陰で深刻にならずに\n済んだのかしら？"},
        { "location": "5798/Talk", "narrator": "アーヤ", "text": "でもだからって、\nやっぱりあのボケは\nナイわよねぇ……。"},
        { "location": "5799/Talk", "narrator": "みやび", "text": "なんや、何でも\nええっちゅう\nことかい？"},
        { "location": "5800/Talk", "narrator": "アーヤ", "text": "みやび、気を遣って\nもらったって\n気づきなさい。"},
        { "location": "5801/Talk", "narrator": "みやび", "text": "いやむしろ本当に\n何でもオッケーの\n本音やも知れんき。"},
        { "location": "5802/Talk", "narrator": "つばめ", "text": "趣味の幅が\n広いんですね！"},
        { "location": "5803/Talk", "narrator": "ガブリエラ", "text": "その褒め方は\nちょっと違うと\n思うんだけど……。"},
        { "location": "5804/Talk", "narrator": "みやび", "text": "このエリカさんの\n言い方からするに――"},
        { "location": "5805/Talk", "narrator": "みやび", "text": "つばめちゃんからクランを\n抽出したんはエリカさん\nちゅうことなんかね？"},
        { "location": "5806/Talk", "narrator": "アーヤ", "text": "ええ、順当に状況証拠\nから考えれば、自然と\nそうなるわね……。"},
        { "location": "5807/Talk", "narrator": "つばめ", "text": "つまりわたしって\nアーヤさんのお姉さん\nに改造された！？"},
        { "location": "5808/Talk", "narrator": "ガブリエラ", "text": "されたというか、\nつばめが自ら希望した\n可能性もあるけどね。"},
        { "location": "5809/Talk", "narrator": "みやび", "text": "突然やけどここから\n千羽鶴の真意を\nトトカルチョや！"},
        { "location": "5810/Talk", "narrator": "アーヤ", "text": "みやび、不謹慎よ。\n私はつばめが聖女って\n方だと思うけど。"},
        { "location": "5811/Talk", "narrator": "みやび", "text": "結局乗るんかい！\nうちは抽出したクラン\n利用の方やな。"},
        { "location": "5812/Talk", "narrator": "ガブリエラ", "text": "あたしもみやびと\n同じ方に張っとくわ。"},
        { "location": "5813/Talk", "narrator": "つばめ", "text": "えっ？　じゃあわたし\nわたしが聖女って方に\nしなきゃいけないの？"},
        { "location": "5814/Talk", "narrator": "ガブリエラ", "text": "いや、べつにそこで\n空気読まなくても。"},
        { "location": "5815/Talk", "narrator": "みやび", "text": "って、トトカルチョ\nまだ終わってないん\nやけんど！"},
        { "location": "5816/Talk", "narrator": "アーヤ", "text": "だってら画面を止めて\nおけばよかったのに。"},
        { "location": "5817/Talk", "narrator": "みやび", "text": "つーか「時間がない」\nって何？　物理？\nメタ？　尺の都合！？"},
        { "location": "5818/Talk", "narrator": "アーヤ", "text": "みやび、落ち着いて。\nそれ以上はいけない。\n消されるわよ。"},
        { "location": "5819/Talk", "narrator": "ガブリエラ", "text": "つばめの「特異点の\n資質」ってのについて\nもう一度やれば？"},
        { "location": "5820/Talk", "narrator": "みやび", "text": "それについては\nトトカルチョじゃ\nなくて考察ぞね……。"},
        { "location": "5821/Talk", "narrator": "つばめ", "text": "えぇっ！？　わたし\nやっばり現実でも\n入院してるの！？"},
        { "location": "5822/Talk", "narrator": "アーヤ", "text": "と言うよりは入院を\n強制されている状況\nみたいね。"},
        { "location": "5823/Talk", "narrator": "つばめ", "text": "わたし改造人間から\n実験動物に格下げ\nされてるよ！？"},
        { "location": "5824/Talk", "narrator": "みやび", "text": "第１号言われちょるん\nなら、バイク乗る的な\n改造人間やね。"},
        { "location": "5825/Talk", "narrator": "アーヤ", "text": "えっ……？\n千羽鶴が、つばめの\nクラン……？"},
        { "location": "5826/Talk", "narrator": "ガブリエラ", "text": "でもクランと本体って\nフェノメノンの中で\n同時出現できるわけ？"},
        { "location": "5827/Talk", "narrator": "みやび", "text": "今までの法則やと\n同時は無理やけど、\nそもそもこの世界は"},
        { "location": "5828/Talk", "narrator": "みやび", "text": "つばめちゃんが\n創った世界なんやし、\nチート的な？"},
        { "location": "5829/Talk", "narrator": "ガブリエラ", "text": "もしくは、そこにいる\nつばめは実は生身じゃ\nないとか？"},
        { "location": "5830/Talk", "narrator": "つばめ", "text": "今度はわたし、幽霊？\nそれともロボ？\n一体何なの！？"},
        { "location": "5831/Talk", "narrator": "神楽", "text": "何って、つばめさんは\n天使に決まってるじゃ\nないですかっ！"},
        { "location": "5832/Talk", "narrator": "つばめ", "text": "神楽ちゃんっ！？\nまさかここで！？"},
        { "location": "5833/Talk", "narrator": "神楽", "text": "もう終わりだからって\n油断しましたね？\nつばめさん甘いです。"},
        { "location": "5834/Talk", "narrator": "ガブリエラ", "text": "ていうか、アンタ\n割と初期からやり放題\nだったわよね。"},
        { "location": "5835/Talk", "narrator": "神楽", "text": "トリックスター的な\n立ち位置、\n美味しいです♪"},
        { "location": "5836/Talk", "narrator": "神楽", "text": "って、そんなことより\nつばめさん！\nこれは一大事です！！"},
        { "location": "5837/Talk", "narrator": "つばめ", "text": "う、うん、わたしたち\n今回もまだ吊るされた\nままで大変だよね。"},
        { "location": "5838/Talk", "narrator": "神楽", "text": "そうじゃなくて！\nさっきの話ですよ！"},
        { "location": "5839/Talk", "narrator": "つばめ", "text": "さっきの？\n千羽鶴長官がわたしの\nクランだってこと？"},
        { "location": "5840/Talk", "narrator": "神楽", "text": "メノウ、つまり私の\n歌の影響で千羽鶴が\n生まれたことです！\n"},
        { "location": "5841/Talk", "narrator": "ガブリエラ", "text": "メノウの歌のお陰で\n洗脳は回避したって\n話じゃなかった？"},
        { "location": "5842/Talk", "narrator": "アーヤ", "text": "そして生きる希望も\n与えられての結果が\n巨大フェノメノンね。"},
        { "location": "5843/Talk", "narrator": "つばめ", "text": "つまりメノウちゃんの\n歌が、この世界の\n産みの親なんだね。"},
        { "location": "5844/Talk", "narrator": "神楽", "text": "そこです！　つまり、\nつまりですよ！"},
        { "location": "5845/Talk", "narrator": "神楽", "text": "この世界は私とつばめ\nさんの正に愛の結晶！"},
        { "location": "5846/Talk", "narrator": "神楽", "text": "私とつばめさんの\n子供ということ\nなんですよ！"},
        { "location": "5847/Talk", "narrator": "ガブリエラ", "text": "……は？"},
        { "location": "5848/Talk", "narrator": "つばめ", "text": "えぇっ……。"},
        { "location": "5849/Talk", "narrator": "神楽", "text": "あ！　てことは\n千羽鶴は私と\nつばめさんの子供！？"},
        { "location": "5850/Talk", "narrator": "神楽", "text": "私、自分の子供に\n酷いことされてたって\nこと？"},
        { "location": "5851/Talk", "narrator": "神楽", "text": "これはつまり、私は\n潜在的にドＭだった\n可能性が！？"},
        { "location": "5852/Talk", "narrator": "神楽", "text": "これはドキドキして\nきました！\nむしろ大興奮です！"},
        { "location": "5853/Talk", "narrator": "ガブリエラ", "text": "……その代わり\nこっちは頭が痛く\nなってきたんだけど。"},
        { "location": "5854/Talk", "narrator": "つばめ", "text": "わたし、神楽ちゃんが\nここまでアレとは\n思ってなかったよ。"},
        { "location": "5855/Talk", "narrator": "アーヤ", "text": "せっかく良い話っぽい\n流れだったのに\n全部台無しね……。"},
        { "location": "5856/Talk", "narrator": "神楽", "text": "つばめさん、今から\n式場を予約して\nおきませんか？"},
        { "location": "5857/Talk", "narrator": "つばめ", "text": "この世界の日本でも\n女同士は結婚できない\nんだよ？"},
        { "location": "5858/Talk", "narrator": "神楽", "text": "むしろそこは今すぐ\n改変してください！\nつばめさんの力で！"},
        { "location": "5859/Talk", "narrator": "ガブリエラ", "text": "……お幸せに。"},
        { "location": "5860/Talk", "narrator": "アーヤ", "text": "仕方ないけれど、\nここは卯月に譲る\n流れみたいね。"},
        { "location": "5861/Talk", "narrator": "つばめ", "text": "面倒臭いからって\nわたしを見捨てようと\nしてませんか！？"},
        { "location": "5862/Talk", "narrator": "ガブリエラ", "text": "正に、\nその発想は無かった\nってヤツよね……。"},
        { "location": "5863/Talk", "narrator": "ガブリエラ", "text": "常識人のあたしからは\n神楽の思考は想像が\nつかないわ。"},
        { "location": "5864/Talk", "narrator": "ガブリエラ", "text": "じゃあ式の日取りが\n決まったら\n連絡ちょうだい。"}
    ]
}
