{
    "dir": "stream_030_ch01.json",
    "type": "watchanime",
    "info": {
    },
    "entry":
    [
        { "location": "497/Talk", "narrator": "みやび", "text": "うむ、男の子らしい\n真っ直ぐな回答に\nうちの好感度アップ。"},
        { "location": "498/Talk", "narrator": "ガブリエラ", "text": "みやび以外の好感度は\n下がったけどね……。"},
        { "location": "499/Talk", "narrator": "みやび", "text": "いや、うちもそこまで\n正直になれとは\n言ってないけんど。"},
        { "location": "500/Talk", "narrator": "みやび", "text": "なんや、うちだけじゃ\n不満なんかねえ？"},
        { "location": "501/Talk", "narrator": "みやび", "text": "正直に言うたら、\nここの動画データ\nあげるで？"},
        { "location": "502/Talk", "narrator": "つばめ", "text": "わたしも\n欲しいですっ！"},
        { "location": "503/Talk", "narrator": "ガブリエラ", "text": "あんたたち……。"},
        { "location": "504/Talk", "narrator": "みやび", "text": "我慢のし過ぎは\nよくないで。"},
        { "location": "505/Talk", "narrator": "ガブリエラ", "text": "引くわー……。"},
        { "location": "506/Talk", "narrator": "つばめ", "text": "すごーい！\n何なんですか？\n教えてくださいっ！"},
        { "location": "507/Talk", "narrator": "つばめ", "text": "……もしかして、\n本当は\n知らないんじゃ？"},
        { "location": "508/Talk", "narrator": "みやび", "text": "つばめちゃん、そこは\n気づかんフリして\nやるもんぞね。"},
        { "location": "509/Talk", "narrator": "つばめ", "text": "えぇーっ！？\nそんなの\nずるいですよぉーっ！"},
        { "location": "510/Talk", "narrator": "みやび", "text": "つばめちゃんも、\nはよう大人に\nならんとねー。"},
        { "location": "511/Talk", "narrator": "みやび", "text": "いやいや、それは\n知っててとぼけてる\n口調やき。"},
        { "location": "512/Talk", "narrator": "つばめ", "text": "えーっ？　どうして\nそんないじわる\nするんですか～。"},
        { "location": "513/Talk", "narrator": "つばめ", "text": "うぅ～、\n怪しいです～。"},
        { "location": "514/Talk", "narrator": "つばめ", "text": "うぅ～、\nいじわるです～。"},
        { "location": "515/Talk", "narrator": "ガブリエラ", "text": "つばめってば\n相変わらず冗談を\n真に受けちゃって。"},
        { "location": "516/Talk", "narrator": "ガブリエラ", "text": "ん？　あたしも\n追い出すの？\nはいはい。"},
        { "location": "517/Talk", "narrator": "ガブリエラ", "text": "わかってるってば。\n押さないでよ、\nもうっ。"},
        { "location": "518/Talk", "narrator": "みやび", "text": "つばめちゃんいじりも\n楽しいけどたまに鋭い\nツッコミ来るんよね。"},
        { "location": "519/Talk", "narrator": "みやび", "text": "いや、むしろうちが\nつばめちゃんを\n育ててる？"},
        { "location": "520/Talk", "narrator": "みやび", "text": "こりゃいずれは\n立派な芸人さんに\nなるぞね。"},
        { "location": "521/Talk", "narrator": "アーヤ", "text": "もう、みやびたちは\nふざけすぎよ。\nそう思わない？"},
        { "location": "522/Talk", "narrator": "アーヤ", "text": "私はリーダーとしての\n節度を守ってるわよ？"},
        { "location": "523/Talk", "narrator": "アーヤ", "text": "守ってるでしょ？\n守ってるわよね！？"},
        { "location": "524/Talk", "narrator": "みやび", "text": "…ふむ。\nうちだけか。"},
        { "location": "525/Talk", "narrator": "みやび", "text": "こうゆうことも\nあるもんなんやね。\nそれにしても……。"},
        { "location": "526/Talk", "narrator": "みやび", "text": "毎回健気にこのOPを\n見てくれている諸氏は\n本当にえいやつや。"},
        { "location": "527/Talk", "narrator": "みやび", "text": "そんなえいやつ君の\nために、うちが暇つぶし\n講座を開いちゃろう。"},
        { "location": "528/Talk", "narrator": "みやび", "text": "これは、うちが勝手に\nこのOPを考察した時の\nものなんやけんど――"},
        { "location": "529/Talk", "narrator": "みやび", "text": "これは、あれやね。\n暗喩の塊や。"},
        { "location": "530/Talk", "narrator": "つばめ", "text": "あ！　それ、\nわたしが子供の頃\n好きだったおやつです！"},
        { "location": "531/Talk", "narrator": "みやび", "text": "つばめちゃん、\nそれ多分、暗喩やなくて\n肝油やないか？"},
        { "location": "532/Talk", "narrator": "つばめ", "text": "ああっ！\nそうです、それです！"},
        { "location": "533/Talk", "narrator": "アーヤ", "text": "え？　なぁに？\n肝油の話？"},
        { "location": "534/Talk", "narrator": "アーヤ", "text": "私もあれ、昔大好き\nだったのよね。"},
        { "location": "535/Talk", "narrator": "アーヤ", "text": "肝油くれるなら\nなんでも言うこと\n聞いたし。"},
        { "location": "536/Talk", "narrator": "みやび", "text": "諸君。\nえいこと聞いたね。"},
        { "location": "537/Talk", "narrator": "アーヤ", "text": "今は違うわよ！"},
        { "location": "538/Talk", "narrator": "ガブリエラ", "text": "相変わらずくだらない\n話をしてるわね。"},
        { "location": "539/Talk", "narrator": "みやび", "text": "お、毎度揺るぐことなく\nアンカーポジションを\nキープするガブちゃん。"},
        { "location": "540/Talk", "narrator": "ガブリエラ", "text": "無駄なことで\n時間を浪費しない\n主義なの。"},
        { "location": "541/Talk", "narrator": "みやび", "text": "しかしこれからは\nこの時間も無駄では\n無くなるぞね。"},
        { "location": "542/Talk", "narrator": "ガブリエラ", "text": "なんでよ。"},
        { "location": "543/Talk", "narrator": "みやび", "text": "このOPの音楽と映像に\n隠された裏の意味を\n暴く時間になるちや。"},
        { "location": "544/Talk", "narrator": "ガブリエラ", "text": "裏の意味！？\nそんなのあるの！？"},
        { "location": "545/Talk", "narrator": "アーヤ", "text": "ほら、もう始まるわよ。\n無駄話はお終い。"},
        { "location": "546/Talk", "narrator": "みやび", "text": "あらら。\n結局今回は何一つ\n考察できんかったね……。"},
        { "location": "547/Talk", "narrator": "つばめ", "text": "この剣をぶんぶんって\n振り回すの、\n恐かったです……。"},
        { "location": "548/Talk", "narrator": "つばめ", "text": "……何の意味が\nあったんだろ？"},
        { "location": "549/Talk", "narrator": "ガブリエラ", "text": "ただの肩慣らし\nじゃない？"},
        { "location": "550/Talk", "narrator": "ガブリエラ", "text": "アーヤも\n剣道する前とかに\nよくやってるし。"},
        { "location": "551/Talk", "narrator": "アーヤ", "text": "してないわよっ！\n……たまにしか。"},
        { "location": "552/Talk", "narrator": "アーヤ", "text": "それにしても今回の\nフェノメノンは\n大規模だったわね。"},
        { "location": "553/Talk", "narrator": "みやび", "text": "ドーム丸ごと一丁っ！\nやきね～。"},
        { "location": "554/Talk", "narrator": "つばめ", "text": "アーヤさんって\nいつも冷静で\nすごいです！"},
        { "location": "555/Talk", "narrator": "アーヤ", "text": "そんなことないわよ。\nこれでも内心は\n結構焦ってるもの。"},
        { "location": "556/Talk", "narrator": "みやび", "text": "つばめちゃんこそ\n随分冷静やないか。"},
        { "location": "557/Talk", "narrator": "みやび", "text": "普通やったら\nおろおろして\n動けないんと違う？"},
        { "location": "558/Talk", "narrator": "つばめ", "text": "この時は、とにかく\nメノウちゃんを\n助けなきゃって。"},
        { "location": "559/Talk", "narrator": "つばめ", "text": "もうそれだけで\n勝手に足が動いてて。"},
        { "location": "560/Talk", "narrator": "ガブリエラ", "text": "どれだけ\nメノウ好きなのよ、\nあんた……。"},
        { "location": "561/Talk", "narrator": "つばめ", "text": "えへへっ♪"},
        { "location": "562/Talk", "narrator": "つばめ", "text": "そういえばクランって\n普段はどこに\nいるんですか？"},
        { "location": "563/Talk", "narrator": "アーヤ", "text": "魂だけの存在だから、\n普段はデータとして\nサーバーにいるけど。"},
        { "location": "564/Talk", "narrator": "アーヤ", "text": "……まぁ、\nいずれわかるわ。"},
        { "location": "565/Talk", "narrator": "つばめ", "text": "えぇーっ！？"},
        { "location": "566/Talk", "narrator": "アーヤ", "text": "あぁっ！！\nは、はい今回は\nここまでーっ！"},
        { "location": "567/Talk", "narrator": "アーヤ", "text": "み、皆さん、\nお疲れさまでしたーっ！"},
        { "location": "568/Talk", "narrator": "みやび", "text": "……アーヤ、\nそれ前回も\nやったき。"},
        { "location": "569/Talk", "narrator": "アーヤ", "text": "そ、そういう問題じゃ\nなくてっ！"},
        { "location": "570/Talk", "narrator": "ガブリエラ", "text": "これぞアーヤ見せ場！\nっとトコなんだから\nべつにいいじゃない。"},
        { "location": "571/Talk", "narrator": "ガブリエラ", "text": "ねぇ、あんただって\nそう思うでしょ？"},
        { "location": "572/Talk", "narrator": "つばめ", "text": "はぁ～、アーヤさん、\nカッコイイです！"},
        { "location": "573/Talk", "narrator": "アーヤ", "text": "あ、ありがとう、\n逢瀬さん……。"},
        { "location": "574/Talk", "narrator": "アーヤ", "text": "でも何でいつも\n私ばっかり……。"},
        { "location": "575/Talk", "narrator": "ガブリエラ", "text": "あたしたちのだって\n映ってたでしょ。"},
        { "location": "576/Talk", "narrator": "アーヤ", "text": "その前のシーンがっ！\n肝心なシーンが\n私だけっ！"},
        { "location": "577/Talk", "narrator": "みやび", "text": "うちらはリーダーの\nアーヤに独占放映権を\n譲ってるわけでして。"},
        { "location": "578/Talk", "narrator": "アーヤ", "text": "そんなの\nいらないわよ……。"},
        { "location": "579/Talk", "narrator": "ガブリエラ", "text": "新人も結構\n思い切ったこと\nするわよね。"},
        { "location": "580/Talk", "narrator": "ガブリエラ", "text": "自分の命が\n危ないんだから\n逃げとけばいいのに。"},
        { "location": "581/Talk", "narrator": "つばめ", "text": "この時は、どうしても\nメノウちゃんを\n助けたくて。"},
        { "location": "582/Talk", "narrator": "つばめ", "text": "自分のことを\n考えてる余裕なんて\n無くて。"},
        { "location": "583/Talk", "narrator": "ガブリエラ", "text": "逃げてくれてれば\nあたしたちの仕事も\n楽だったのに。"},
        { "location": "584/Talk", "narrator": "つばめ", "text": "あうぅぅ～、\nごめんなさぁ～いっ。"},
        { "location": "585/Talk", "narrator": "みやび", "text": "まぁ、そのお陰で\nガブちゃんの見せ場も\nあったわけやし。"},
        { "location": "586/Talk", "narrator": "アーヤ", "text": "逢瀬さんが発症者を\n引きつけてくれてたら\n準備を整えられたし。"},
        { "location": "587/Talk", "narrator": "つばめ", "text": "そういえば何でわたし\n追いかけられて\nたんだろ？"},
        { "location": "588/Talk", "narrator": "ガブリエラ", "text": "さぁ？\n美味しそうな匂いでも\nさせてたんじゃない？"},
        { "location": "589/Talk", "narrator": "つばめ", "text": "えっ？　この時は\n食べ物なんて\n持って無かったけど？"},
        { "location": "590/Talk", "narrator": "アーヤ", "text": "そういう意味じゃ\nないと思うわ……。"},
        { "location": "591/Talk", "narrator": "つばめ", "text": "あとこの「同化」って\n言葉は、一体何の\nことなんですか？"},
        { "location": "592/Talk", "narrator": "アーヤ", "text": "ああ、それは──"},
        { "location": "593/Talk", "narrator": "みやび", "text": "せっかくやしここは\n$handle$に\n聞いてみたら？"},
        { "location": "594/Talk", "narrator": "つばめ", "text": "$handle$さんは\n知ってるんですか？"},
        { "location": "595/Talk", "narrator": "ガブリエラ", "text": "さぁ、気を取り直して\n続き行きましょ！"},
        { "location": "596/Talk", "narrator": "みやび", "text": "フッ、それはおまえが\n可愛いからさ。"},
        { "location": "597/Talk", "narrator": "つばめ", "text": "えぇーっ！？"},
        { "location": "598/Talk", "narrator": "ガブリエラ", "text": "はいここ！\n撃ったあたしに\n感謝してよね。"},
        { "location": "599/Talk", "narrator": "アーヤ", "text": "さすがギャヴィね。\nお手柄だったわ。"},
        { "location": "600/Talk", "narrator": "つばめ", "text": "うん、ガブちゃん、\nすごかったよ。\nありがとう！"},
        { "location": "601/Talk", "narrator": "ガブリエラ", "text": "えへへっ♪\nこれくらい当たり前\nだけどねーっ♪"},
        { "location": "602/Talk", "narrator": "みやび", "text": "さぁ、ガブちゃんの\n射撃に続きましては\nアーヤの剣舞！"},
        { "location": "603/Talk", "narrator": "みやび", "text": "きゃーっ！\nかっこいーっ！！"},
        { "location": "604/Talk", "narrator": "アーヤ", "text": "……わざとらしい。"},
        { "location": "605/Talk", "narrator": "つばめ", "text": "ホントに\nかっこいいですよっ！"},
        { "location": "606/Talk", "narrator": "アーヤ", "text": "そ、そう？\nありがとう、逢瀬さん。"},
        { "location": "607/Talk", "narrator": "みやび", "text": "何やうちへの態度と\n違い過ぎない？"},
        { "location": "608/Talk", "narrator": "アーヤ", "text": "気のせいよ……。"},
        { "location": "609/Talk", "narrator": "アーヤ", "text": "ここでやっと発症者の\n特定ね。いつもより\n時間がかかったわ。"},
        { "location": "610/Talk", "narrator": "みやび", "text": "いつもやったらうちが\nスキャンする前には\n情報があるもんね。"},
        { "location": "611/Talk", "narrator": "ガブリエラ", "text": "これは管理庁か、\nまほの怠慢ね。"},
        { "location": "612/Talk", "narrator": "みやび", "text": "まほさん、\nガブちゃんが\nこう言うちょる。"},
        { "location": "613/Talk", "narrator": "ガブリエラ", "text": "ちょっと！"},
        { "location": "614/Talk", "narrator": "つばめ", "text": "ところで、せんぱいの\n両サイドにある箱、\n何かすごそうですね。"},
        { "location": "615/Talk", "narrator": "ガブリエラ", "text": "箱って言うな！\nすごそうじゃなくて、\nすごいの！"},
        { "location": "616/Talk", "narrator": "ガブリエラ", "text": "ありとあらゆる銃器が\n入ってる超高性能な\nカートリッジよ！"},
        { "location": "617/Talk", "narrator": "みやび", "text": "うむ。吹き矢から\n誘導弾は勿論のこと、\n対空砲まで何でもや。"},
        { "location": "618/Talk", "narrator": "つばめ", "text": "ふぇ～っ！\nすっご～いっ！"},
        { "location": "619/Talk", "narrator": "ガブリエラ", "text": "いや、入ってるわけ\nないでしょ……。"},
        { "location": "620/Talk", "narrator": "つばめ", "text": "ところでみやびさんは\nずっと空を飛んでる\nだけなんですか？"},
        { "location": "621/Talk", "narrator": "みやび", "text": "あいたたたたっ！\n厳しいトコ\n攻めてきゆう。"},
        { "location": "622/Talk", "narrator": "つばめ", "text": "でも空を飛べるのって\nみやびさんだけ\nなんですよね？"},
        { "location": "623/Talk", "narrator": "みやび", "text": "うむ、うちは\nレアキャラやき。\nありがたがって～。"},
        { "location": "624/Talk", "narrator": "アーヤ", "text": "とにかく、ここから\n戦いは本番に入るわ。"},
        { "location": "625/Talk", "narrator": "ガブリエラ", "text": "そして次回では、\nつばめが遂に\nあ～んなことに！"},
        { "location": "626/Talk", "narrator": "つばめ", "text": "ふぇぇっ！？\nど、どうなっちゃうん\nですかぁ～っ！？"},
        { "location": "627/Talk", "narrator": "みやび", "text": "そりゃ勿論、\nあ～んなことや、\nこ～んなことに。"},
        { "location": "628/Talk", "narrator": "つばめ", "text": "いやぁ～～～っ！！"},
        { "location": "629/Talk", "narrator": "アーヤ", "text": "みやび、変な方向に\n期待を持たせすぎ。"},
        { "location": "630/Talk", "narrator": "つばめ", "text": "あっ！　自分だけで\nこっそり続きを\n観る気ですね！？"},
        { "location": "631/Talk", "narrator": "つばめ", "text": "そ、そうは\nさせないんだからっ！"},
        { "location": "632/Talk", "narrator": "つばめ", "text": "あぁ～ん、\nそんなぁ～……。"}
    ]
}
