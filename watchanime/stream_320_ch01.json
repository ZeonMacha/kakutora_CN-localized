{
    "dir": "stream_320_ch01.json",
    "type": "watchanime",
    "info": {
    },
    "entry":
    [
        { "location": "6284/Talk", "narrator": "神楽", "text": "またまた～？\n本当はお好きなんで\nしょ～？"},
        { "location": "6285/Talk", "narrator": "ガブリエラ", "text": "いや、なんか本気で\nノーサンキューみたい\nだけど。"},
        { "location": "6286/Talk", "narrator": "神楽", "text": "クククッ、みんな最初はそう\n言うんですよ……。"},
        { "location": "6287/Talk", "narrator": "ガブリエラ", "text": "つか、アンタのその\nキャラにドン引きよ！"},
        { "location": "6288/Talk", "narrator": "神楽", "text": "クククッ、放り込んでしま\nえばこっちのもんよ……。"},
        { "location": "6289/Talk", "narrator": "ガブリエラ", "text": "何そのキャラ……。"},
        { "location": "6290/Talk", "narrator": "みやび", "text": "他人が沼にはまってもがく\n様子見るんは楽しいやき\nねぇ。"},
        { "location": "6291/Talk", "narrator": "ガブリエラ", "text": "アンタも何様！？"},
        { "location": "6292/Talk", "narrator": "みやび", "text": "何でもお金で解決\nできる思わんといて！"},
        { "location": "6293/Talk", "narrator": "みやび", "text": "とりあえずうちの\n口座は教えとくけど。"},
        { "location": "6294/Talk", "narrator": "つばめ", "text": "画面越しでの金銭の\n授受は禁止されています！"},
        { "location": "6295/Talk", "narrator": "ガブリエラ", "text": "むしろ出来るのならお布施\nさせろとか言われそうね。"},
        { "location": "6296/Talk", "narrator": "アーヤ", "text": "よく訓練された者たち\nってやつかしら？"},
        { "location": "6297/Talk", "narrator": "みやび", "text": "それは企業秘密やき\n答えられんなぁ。"},
        { "location": "6298/Talk", "narrator": "ガブリエラ", "text": "おまわりさん、\nここに危険な変態がいます。"},
        { "location": "6299/Talk", "narrator": "みやび", "text": "くっ、捕まる前に\nガブちゃんのデータも\n流出させちゃる。"},
        { "location": "6300/Talk", "narrator": "ガブリエラ", "text": "ホント勘弁して！"},
        { "location": "6301/Talk", "narrator": "神楽", "text": "うふふっ♪\nまさか、ね？"},
        { "location": "6302/Talk", "narrator": "神楽", "text": "うふふっ♪\nまさか、ね？"},
        { "location": "6303/Talk", "narrator": "つばめ", "text": "じゃじゃーん！\n久しぶりにトップで\n登場ですよ！"},
        { "location": "6304/Talk", "narrator": "ガブリエラ", "text": "というかいつも最初に\n出る人、無駄にテンション\n高過ぎ。"},
        { "location": "6305/Talk", "narrator": "つばめ", "text": "ツカミは大事ですからっ！"},
        { "location": "6306/Talk", "narrator": "アーヤ", "text": "そんなに芸人的なサービス\n精神に染まらなくても。"},
        { "location": "6307/Talk", "narrator": "みやび", "text": "これはつばめちゃんの\nアイデンティティーの\n問題やき。"},
        { "location": "6308/Talk", "narrator": "つばめ", "text": "そこまで大ごとじゃ\nないですよっ！？"},
        { "location": "6309/Talk", "narrator": "つばめ", "text": "$handle$さんだって\nみんなが元気な方が\nきっと嬉しいですし。"},
        { "location": "6310/Talk", "narrator": "ガブリエラ", "text": "基本、不機嫌ツッコミ\n風なキャラのあたしは\nどうするのよ。"},
        { "location": "6311/Talk", "narrator": "つばめ", "text": "ガブちゃんは可愛いから\n大丈夫なんじゃないか\nなぁ？"},
        { "location": "6312/Talk", "narrator": "みやび", "text": "つばめちゃんかて\n「黙ってたら美少女」\nやと思うよ？"},
        { "location": "6313/Talk", "narrator": "つばめ", "text": "むしろわたしもうそこまで\n落ちてるんですか！？"},
        { "location": "6314/Talk", "narrator": "みやび", "text": "落ちるとは失礼な！\n残念美少女の元祖は\nうちや！"},
        { "location": "6315/Talk", "narrator": "ガブリエラ", "text": "それ、ドヤ顔で言うこと\nじゃないから。"},
        { "location": "6316/Talk", "narrator": "アーヤ", "text": "でもそれでキャラが\n立ってるのなら良い\nことじゃないかしら。"},
        { "location": "6317/Talk", "narrator": "みやび", "text": "アーヤからうちへの\n雑なフォローが\n心に染み入るわー。"},
        { "location": "6318/Talk", "narrator": "つばめ", "text": "ダ、ダメですよ！\nテンションアゲアゲで\nいきましょう！"},
        { "location": "6319/Talk", "narrator": "みやび", "text": "フッ、その元気、\nいつまで持つかな？"},
        { "location": "6320/Talk", "narrator": "つばめ", "text": "不穏な方向に\n振ってきた！？"},
        { "location": "6321/Talk", "narrator": "みやび", "text": "こちらは、うちらの\n元アジト。\n今は見る陰も無い惨状や。"},
        { "location": "6322/Talk", "narrator": "ガブリエラ", "text": "単に立ち入り禁止に\nされてるだけじゃないの。"},
        { "location": "6323/Talk", "narrator": "みやび", "text": "そこに現われたるは\n青春を謳歌する若人が\n二人。"},
        { "location": "6324/Talk", "narrator": "アーヤ", "text": "夜中に暗視ゴーグルも\n無しに忍び込むなんて\n無茶してるわね。"},
        { "location": "6325/Talk", "narrator": "ガブリエラ", "text": "こいつら思ってたより\n骨があるわね。\nちょっと感心したわ。"},
        { "location": "6326/Talk", "narrator": "つばめ", "text": "でもこんな夜中に\n忍び込んで、何をする\nつもりなんだろ？"},
        { "location": "6327/Talk", "narrator": "みやび", "text": "うそっ！　これ普通の\nミドルタワーＰＣや！\nスパコン違うんかい！"},
        { "location": "6328/Talk", "narrator": "ガブリエラ", "text": "……もしかして、\nうちらの予算って割と\n少なかったの？"},
        { "location": "6329/Talk", "narrator": "アーヤ", "text": "これは館長が個人で\n秘密裏に用意していた\n物だから。"},
        { "location": "6330/Talk", "narrator": "つばめ", "text": "自腹ってことですか？\nだとすると結構\nかかってそう……。"},
        { "location": "6331/Talk", "narrator": "ガブリエラ", "text": "こいつらってつばめを\n匿った件で、謹慎処分\n食らってたのね。"},
        { "location": "6332/Talk", "narrator": "アーヤ", "text": "下手したら共犯扱い\nなんだから、むしろ\n軽すぎるくらいね。"},
        { "location": "6333/Talk", "narrator": "みやび", "text": "そして情報管理庁の\nその甘さが今回は\n仇になったと。"},
        { "location": "6334/Talk", "narrator": "つばめ", "text": "この辺見てるとなんか\nドキドキしません？\nなんて言うか……。"},
        { "location": "6335/Talk", "narrator": "ガブリエラ", "text": "この二人って結構\n距離近過ぎ言うか、\nベタベタやきね。"},
        { "location": "6336/Talk", "narrator": "ガブリエラ", "text": "子犬同士がじゃれてる\nみたいな可愛さが\nあるかもね。"},
        { "location": "6337/Talk", "narrator": "神楽", "text": "うぇるかむようこそ\n禁断の腐女子道へ！！"},
        { "location": "6338/Talk", "narrator": "神楽", "text": "皆さんをイケナイ沼に\n引きずり込みに来ました！"},
        { "location": "6339/Talk", "narrator": "神楽", "text": "ちなみに、つばめさん\n一筋の私に腐属性は\nありません。"},
        { "location": "6340/Talk", "narrator": "神楽", "text": "単に沼の縁で皆さんを\n放り投げるだけです！"},
        { "location": "6341/Talk", "narrator": "神楽", "text": "こう見えても知識は\n十分にありますから\n安心してくださいね！"},
        { "location": "6342/Talk", "narrator": "みやび", "text": "うわ、一番タチ悪いのが\n来ちょったわ。"},
        { "location": "6343/Talk", "narrator": "ガブリエラ", "text": "……だそうだけど、\nアンタは沼ってのに\n放り込まれたい？"},
        { "location": "6344/Talk", "narrator": "神楽", "text": "それでは皆さん、\nごきげんよう～。"},
        { "location": "6345/Talk", "narrator": "神楽", "text": "つばめさ～ん、\n愛してま～す♪"},
        { "location": "6346/Talk", "narrator": "アーヤ", "text": "……今のは一体\n何だったのかしら？"},
        { "location": "6347/Talk", "narrator": "ガブリエラ", "text": "……愛されてて\nよかったわね……。"},
        { "location": "6348/Talk", "narrator": "つばめ", "text": "あ、あはははは……。"},
        { "location": "6349/Talk", "narrator": "みやび", "text": "お、ＰＣ立ち上がった\nみたいやね。ＯＳは\n何使ってるんやろ。"},
        { "location": "6350/Talk", "narrator": "つばめ", "text": "このカメラみたいなの\nなんなんですか？"},
        { "location": "6351/Talk", "narrator": "みやび", "text": "Ｎシステムやね。\n車のナンバーを自動で\n読み取る装置や。"},
        { "location": "6352/Talk", "narrator": "つばめ", "text": "つまりこれって、あの\nパソコンでシステムを\n妨害したってこと"},
        { "location": "6353/Talk", "narrator": "みやび", "text": "つばめちゃん、\n質問風解説グッジョブや。"},
        { "location": "6354/Talk", "narrator": "ガブリエラ", "text": "これ大惨事じゃない？\n事故起きてても不思議\nじゃないんだけど。"},
        { "location": "6355/Talk", "narrator": "みやび", "text": "海外だったら一瞬で\nヒャッハーッ！状態\nだったところやき。"},
        { "location": "6356/Talk", "narrator": "アーヤ", "text": "核が落ちた後の世紀末\nじゃないんだから、\nそれは言い過ぎよ。"},
        { "location": "6357/Talk", "narrator": "つばめ", "text": "なんとかシステムで\nわたしの頭も\nモヒカンに！？"},
        { "location": "6358/Talk", "narrator": "ガブリエラ", "text": "つばめが下手に想像\nすると現実になりそう\nだから、やめて！"},
        { "location": "6359/Talk", "narrator": "みやび", "text": "ガブちゃんモヒカンが\n似合いそうなのに\n残念やな。"},
        { "location": "6360/Talk", "narrator": "ガブリエラ", "text": "そう言って想像されるの\nすらイヤなんですけど！"},
        { "location": "6361/Talk", "narrator": "つばめ", "text": "とか言ってる間に\nわたしすごいことに\nなってるよ！？"},
        { "location": "6362/Talk", "narrator": "ガブリエラ", "text": "つばめを前にして\nこんな死んだ目してる\n神楽は始めてね。"},
        { "location": "6363/Talk", "narrator": "アーヤ", "text": "ええ、いつもは常に\n猛禽類の目でつばめを\n狙ってるのに……。"},
        { "location": "6364/Talk", "narrator": "つばめ", "text": "みんなの中の神楽ちゃんの\nイメージって……。"},
        { "location": "6365/Talk", "narrator": "みやび", "text": "しかしクランから\n私の本体言われるんも\nえらい構図やき。"},
        { "location": "6366/Talk", "narrator": "みやび", "text": "一つになりましょう\n言い出しそうで\nドキドキしちょった。"},
        { "location": "6367/Talk", "narrator": "ガブリエラ", "text": "つまり、そこに邪魔に入る\nアーヤって構図ね。"},
        { "location": "6368/Talk", "narrator": "アーヤ", "text": "間違ってはいないけど\n何かが間違っている\n気がするわ……。"},
        { "location": "6369/Talk", "narrator": "ガブリエラ", "text": "これ車内から言ってた\nわけ？　想像すると\n微妙にゆるいわね。"},
        { "location": "6370/Talk", "narrator": "みやび", "text": "そのシーンは特典映像\nに付けるかも知れん\n言うちょったき。"},
        { "location": "6371/Talk", "narrator": "アーヤ", "text": "また勝手にそんなこと\n言ってると偉い人に\n怒られるわよ……。"},
        { "location": "6372/Talk", "narrator": "ガブリエラ", "text": "ＡＤ２０１６って出て\nるけど、これって\nおかしくない？"},
        { "location": "6373/Talk", "narrator": "ガブリエラ", "text": "つばめのフェノメノン\nが発症したのって\nＡＤ２０３１でしょ？"},
        { "location": "6374/Talk", "narrator": "みやび", "text": "これはプレゼン用に\nわかりやすく作った\n映像ちゅう感じやき。"},
        { "location": "6375/Talk", "narrator": "みやび", "text": "この２０１６年世界を\n剥ぎ取ったら現実は\nこんなでしたー言う。"},
        { "location": "6376/Talk", "narrator": "つばめ", "text": "わかりやすいのか\nまぎらわしいのか\nよくわかりませんね。"},
        { "location": "6377/Talk", "narrator": "ガブリエラ", "text": "何かの情報操作\nなんじゃないかって\n勘繰っちゃったわ。"},
        { "location": "6378/Talk", "narrator": "アーヤ", "text": "附属学園での教育に\nよる賜物と言うか、\n一種の職業病ね。"},
        { "location": "6379/Talk", "narrator": "つばめ", "text": "ところでこの映像って\nいつ作ったんですか？"},
        { "location": "6380/Talk", "narrator": "みやび", "text": "うちが車内の機材で\n必死にエンコードまで\nしてたんや。察して。"},
        { "location": "6381/Talk", "narrator": "みやび", "text": "それからドームの放送\n機器を掌握してと正に\n大忙しやったき。"},
        { "location": "6382/Talk", "narrator": "みやび", "text": "そして祝！\nつばめちゃん、\n電撃ヌード映像発表！"},
        { "location": "6383/Talk", "narrator": "つばめ", "text": "え、えーと……、\nわたし、脱いだ方が\n凄いんです？"},
        { "location": "6384/Talk", "narrator": "ガブリエラ", "text": "で、なんですまきに\nされてたわけ？\nそういうプレイ？"},
        { "location": "6385/Talk", "narrator": "みやび", "text": "アーヤがどうしても\n全裸すまき映像が\n見たい言うから。"},
        { "location": "6386/Talk", "narrator": "ガブリエラ", "text": "そんなの知りません！\nって、全裸映像を否定\nしてるみたいよね。"},
        { "location": "6387/Talk", "narrator": "みやび", "text": "全然売れてない頃に\n脱いだ動画が流出した\nみたいなもんやね。"},
        { "location": "6388/Talk", "narrator": "アーヤ", "text": "「禁断のジュニア\nアイドル逢瀬つばめ」\nとか？"},
        { "location": "6389/Talk", "narrator": "つばめ", "text": "アーヤさんまで\n一緒になって何を\n言ってるんですかっ！？"},
        { "location": "6390/Talk", "narrator": "つばめ", "text": "そもそもこの映像って\nみやびさんが作ったん\nですよね！？"},
        { "location": "6391/Talk", "narrator": "つばめ", "text": "いつの間にわたしの\n裸をっ！？"},
        { "location": "6392/Talk", "narrator": "みやび", "text": "安心しいや。\nこれは実写やなく\nＣＧやき。"},
        { "location": "6393/Talk", "narrator": "ガブリエラ", "text": "それにしてはつばめの\nモデルデータが妙に\n生々しいんだけど？"},
        { "location": "6394/Talk", "narrator": "みやび", "text": "そこはちゃんとリアル\nつばめちゃんデータに\n基づいちょるから。"},
        { "location": "6395/Talk", "narrator": "つばめ", "text": "だからいつの間に\nそんなデータを\n採ったんですか！？"},
        { "location": "6396/Talk", "narrator": "つばめ", "text": "結局わたしの盗撮？\n問題は解決して\nないですよね！？"},
        { "location": "6397/Talk", "narrator": "アーヤ", "text": "人生は不可解で\n充ちているのね。"},
        { "location": "6398/Talk", "narrator": "ガブリエラ", "text": "無理にきれいにまとめよう\nとしなくていいから……。"},
        { "location": "6399/Talk", "narrator": "みやび", "text": "そして遂に\nうちらがキター！！"},
        { "location": "6400/Talk", "narrator": "アーヤ", "text": "来たと言うか絶望的な\n状況から見ても正に\n特攻よね。"},
        { "location": "6401/Talk", "narrator": "ガブリエラ", "text": "縁起でもないこと\n言わないでよ……。"},
        { "location": "6402/Talk", "narrator": "つばめ", "text": "でも正に\nヒーロー参上！　って\n感じでドキドキです！"},
        { "location": "6403/Talk", "narrator": "みやび", "text": "そして爆発ッ！！"},
        { "location": "6404/Talk", "narrator": "つばめ", "text": "えええぇーーーっ！？"},
        { "location": "6405/Talk", "narrator": "みやび", "text": "はい終了～。\nお疲れさ～ん。"},
        { "location": "6406/Talk", "narrator": "ガブリエラ", "text": "盛り上げといて\n最後は意外と\nあっけなかったわね。"},
        { "location": "6407/Talk", "narrator": "みやび", "text": "まあうちら所詮は\n不思議能力とか無い\nパンピーやしな。"},
        { "location": "6408/Talk", "narrator": "アーヤ", "text": "死亡フラグを立てて\nそのまま逝くとは\n予想の斜め上ね。"},
        { "location": "6409/Talk", "narrator": "つばめ", "text": "むしろ本当にこれで\n終わったら伝説になる\nと思いますけど……。"},
        { "location": "6410/Talk", "narrator": "みやび", "text": "じゃあこれにて解散\nちゅうことで、\nいつかまたどこかで～。"},
        { "location": "6411/Talk", "narrator": "つばめ", "text": "えっ！？\nみやびさんっ！？"},
        { "location": "6412/Talk", "narrator": "ガブリエラ", "text": "とりあえず帰って\nお風呂入って\n今日はもう寝るわ。"},
        { "location": "6413/Talk", "narrator": "つばめ", "text": "あ、あの、\n勝手に帰っちゃって\nいいの！？"},
        { "location": "6414/Talk", "narrator": "アーヤ", "text": "打ち上げは後日\n改めてってことで\n連絡するわね。"},
        { "location": "6415/Talk", "narrator": "つばめ", "text": "え、えーと……、\nそういうこと\nみたいなので……？"},
        { "location": "6416/Talk", "narrator": "つばめ", "text": "$handle$さんも\nあまり夜更かし\nしないようにね？"},
        { "location": "6417/Talk", "narrator": "つばめ", "text": "おやすみなさい♪"}
    ]
}
