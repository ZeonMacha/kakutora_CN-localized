{
    "dir": "stream_370_ch01.json",
    "type": "watchanime",
    "info": {
    },
    "entry":
    [
        { "location": "7155/Talk", "narrator": "ガブリエラ", "text": "あたしが聞いた話だと\n甘くて酸っぱいらしい\nわよ？"},
        { "location": "7156/Talk", "narrator": "つばめ", "text": "わたしは、ほろ苦い\nビターチョコ味だって\n聞きました。"},
        { "location": "7157/Talk", "narrator": "みやび", "text": "うちは洋菓子やったら\nオールラウンドに好き\nやよ？"},
        { "location": "7158/Talk", "narrator": "ガブリエラ", "text": "いや、好きな食べ物の\n話じゃないし。"},
        { "location": "7159/Talk", "narrator": "ガブリエラ", "text": "あたしは、たこ焼きが\n好きなのは、当然\n知ってると思うし！"},
        { "location": "7160/Talk", "narrator": "みやび", "text": "また一部の人にしか\nわからん危険球を\n返して来よったな。"},
        { "location": "7161/Talk", "narrator": "ガブリエラ", "text": "よくわからないけど、\n要するに縁が無かった\nってことなのね？"},
        { "location": "7162/Talk", "narrator": "つばめ", "text": "ガブちゃんが強引に\n青春未体験仲間を\n増やそうとしてる！"},
        { "location": "7163/Talk", "narrator": "ガブリエラ", "text": "結局は数の多い方が\n勝つんだから、\n当たり前でしょ？"},
        { "location": "7164/Talk", "narrator": "アーヤ", "text": "ギャヴィは一体、\n何と戦ってるの……。"},
        { "location": "7165/Talk", "narrator": "神楽", "text": "わかりきってることを\nなんでわざわざ聞くん\nですか？"},
        { "location": "7166/Talk", "narrator": "みやび", "text": "予想はついちょるけど\n確かめたいこともあるきに。"},
        { "location": "7167/Talk", "narrator": "ガブリエラ", "text": "あたしはむしろ\n知りたくないけど。"},
        { "location": "7168/Talk", "narrator": "つばめ", "text": "わたしは気になるよ！\n神楽ちゃん、何する\nつもりなの！？"},
        { "location": "7169/Talk", "narrator": "神楽", "text": "不本意ですがそれを\n説明すると配信停止に\nなってしまうんです。"},
        { "location": "7170/Talk", "narrator": "みやび", "text": "どんだけや！"},
        { "location": "7171/Talk", "narrator": "神楽", "text": "わかってくれると\n信じてましたよ。\n若干キモいですけど。"},
        { "location": "7172/Talk", "narrator": "みやび", "text": "相変わらずあちらさんには\n厳しいなぁ。"},
        { "location": "7173/Talk", "narrator": "神楽", "text": "ええ、ライバルは\n切磋琢磨し合いそして\n蹴落とす物ですから。"},
        { "location": "7174/Talk", "narrator": "ガブリエラ", "text": "まぁ、好きにして。"},
        { "location": "7175/Talk", "narrator": "神楽", "text": "じゃあガブちゃんに\n押し付けちゃおうかな♪"},
        { "location": "7176/Talk", "narrator": "ガブリエラ", "text": "なんでそうなるのよ……。"},
        { "location": "7177/Talk", "narrator": "アーヤ", "text": "前向きに考えるよりは\nもしもの時の心構えが\n必要よね。"},
        { "location": "7178/Talk", "narrator": "アーヤ", "text": "て言うと、\n悲観主義者だって\n言われるのよね。"},
        { "location": "7179/Talk", "narrator": "アーヤ", "text": "備えあれば憂いなし！\nでしょ？"},
        { "location": "7180/Talk", "narrator": "ガブリエラ", "text": "あたしとしては\nグッドエンドなら\nまぁ、いいけど。"},
        { "location": "7181/Talk", "narrator": "ガブリエラ", "text": "あたし個人のハッピー\nとか、そこまで贅沢は\n言う気無いし。"},
        { "location": "7182/Talk", "narrator": "ガブリエラ", "text": "そういう役回りだって納得\nするしかないでしょ？"},
        { "location": "7183/Talk", "narrator": "つばめ", "text": "ま、まずい！\nなんだかみんなが\n諦めモードに！？"},
        { "location": "7184/Talk", "narrator": "つばめ", "text": "ここは主人公のわたしが\nなんとかしないと！"},
        { "location": "7185/Talk", "narrator": "つばめ", "text": "……でも、どうしたら\nいいのかな？"},
        { "location": "7186/Talk", "narrator": "神楽", "text": "あの素晴らしい\n楽園をもう一度！\nそれが私の願いです。"},
        { "location": "7187/Talk", "narrator": "神楽", "text": "まぁ、ついでに貴方の\n幸せを祈ってあげても\nいいですけど。"},
        { "location": "7188/Talk", "narrator": "神楽", "text": "私は私の欲望のままに\n生き、そして悔いなく\n終わりますから！"},
        { "location": "7189/Talk", "narrator": "ガブリエラ", "text": "ここ最近置いてけぼり\n展開なんだけど、\nこれいつまで続くわけ？"},
        { "location": "7190/Talk", "narrator": "つばめ", "text": "ガブちゃん出だしから\nいきなりキツくない？"},
        { "location": "7191/Talk", "narrator": "アーヤ", "text": "でもギャヴィの\n気持ちもわかるわ。\nだって……。"},
        { "location": "7192/Talk", "narrator": "みやび", "text": "まぁ、クライマックス\nちゅうことやし、\nしゃーなしや。"},
        { "location": "7193/Talk", "narrator": "ガブリエラ", "text": "そこ、おかしくない？\nクライマックスなら\n全員目立たないと！"},
        { "location": "7194/Talk", "narrator": "みやび", "text": "今回から美味しい展開\nかも知れんき。"},
        { "location": "7195/Talk", "narrator": "ガブリエラ", "text": "とてもそんな楽観視は\nできないんだけど。"},
        { "location": "7196/Talk", "narrator": "アーヤ", "text": "私もギャヴィに賛成。\n落ち着いてる場合じゃ\nないのよ？"},
        { "location": "7197/Talk", "narrator": "みやび", "text": "なんやさっきから\n勿体つけた言い方やな。"},
        { "location": "7198/Talk", "narrator": "アーヤ", "text": "それは、まぁ、\n後で話すけれど……。"},
        { "location": "7199/Talk", "narrator": "つばめ", "text": "えーと、とりあえず\n前回のおさらいを\nしときましょうか。"},
        { "location": "7200/Talk", "narrator": "ガブリエラ", "text": "前回って不思議空間で\nイチャイチャしてた\nだけじゃない。"},
        { "location": "7201/Talk", "narrator": "つばめ", "text": "イチャイチャしてた\nわけじゃないんだけど\nなぁ……。"},
        { "location": "7202/Talk", "narrator": "みやび", "text": "卯月的には天国やった\nみたいやけんどな。"},
        { "location": "7203/Talk", "narrator": "アーヤ", "text": "前回は卯月だけが得してた\n感じではあるわね。"},
        { "location": "7204/Talk", "narrator": "神楽", "text": "隙ありっ！\nガブちゃんの席、\n強奪ですっ！"},
        { "location": "7205/Talk", "narrator": "神楽", "text": "画面の前のアナタ！\n萌えすぎて身悶えする\n準備はＯＫですか？"},
        { "location": "7206/Talk", "narrator": "神楽", "text": "私とつばめさんとの\n楽園が舞台の物語は\n始まったばかりです！"},
        { "location": "7207/Talk", "narrator": "神楽", "text": "楽園日常ラブコメ、\n２クール全２４話で\nお送りしますので！"},
        { "location": "7208/Talk", "narrator": "みやび", "text": "噂してたら現われて、\n初っぱなからいきなり\n大ぼら吹きよったっ！"},
        { "location": "7209/Talk", "narrator": "つばめ", "text": "そうだよ、わたしが\n一生懸命語ってるのに\n茶化すなんて酷いよ！"},
        { "location": "7210/Talk", "narrator": "つばめ", "text": "メノウちゃんの凄さや\n可愛さをもっともっと\n伝えたいのに！"},
        { "location": "7211/Talk", "narrator": "神楽", "text": "いえ、あの……だから\n耐えられずに茶化して\nるんですけどね……。"},
        { "location": "7212/Talk", "narrator": "神楽", "text": "というわけで早々に\n一旦退散です。"},
        { "location": "7213/Talk", "narrator": "ガブリエラ", "text": "なんだったのよ、\nもう……。"},
        { "location": "7214/Talk", "narrator": "みやび", "text": "このつばめちゃんの\n闘病生活の話、\n一体何度目やろ。"},
        { "location": "7215/Talk", "narrator": "アーヤ", "text": "反復学習ね。こうして\n繰り返し伝えることで\n記憶に刷り込むのよ。"},
        { "location": "7216/Talk", "narrator": "ガブリエラ", "text": "それって洗脳じゃない？"},
        { "location": "7217/Talk", "narrator": "ガブリエラ", "text": "ていうか、それを刷り込ん\nで誰得なわけ？"},
        { "location": "7218/Talk", "narrator": "アーヤ", "text": "そんなことより、\nちょっと待って！"},
        { "location": "7219/Talk", "narrator": "アーヤ", "text": "相変わらずｇｄｇｄな\n話ばかりしてるけど、\n本当にわかってるの？"},
        { "location": "7220/Talk", "narrator": "つばめ", "text": "アーヤさん、いきなり\nそんな本気の真顔で\nどうしたんですか？"},
        { "location": "7221/Talk", "narrator": "アーヤ", "text": "ええ、真剣よ。\nだって今回って、\n最終回の一つ前なのよ！？"},
        { "location": "7222/Talk", "narrator": "つばめ", "text": "ええええぇぇぇっ！？"},
        { "location": "7223/Talk", "narrator": "みやび", "text": "つばめちゃん、律儀に\nそないなリアクション\nせんでもええんよ？"},
        { "location": "7224/Talk", "narrator": "アーヤ", "text": "今回入れてあと２回で\nこうやって話すのも\n終わりなのよ！？"},
        { "location": "7225/Talk", "narrator": "ガブリエラ", "text": "ていうか、いきなり\nここでそれバラして\nよかったの？"},
        { "location": "7226/Talk", "narrator": "アーヤ", "text": "本当にこれでいいの？\n後で後悔しない？\nもう最後なのよ？"},
        { "location": "7227/Talk", "narrator": "アーヤ", "text": "大事な思い出をもっと\n語ったり感謝の言葉を\n伝えたりしないの？"},
        { "location": "7228/Talk", "narrator": "ガブリエラ", "text": "うわ……。\nあたしのツッコミ、\n完全にスルーだ、これ。"},
        { "location": "7229/Talk", "narrator": "みやび", "text": "アーヤの体育会系が\n火を噴いてるぞな。\n青春まっただ中や。"},
        { "location": "7230/Talk", "narrator": "ガブリエラ", "text": "ていうか、アーヤ以外\n誰も青春を謳歌して\n無さそうじゃない？"},
        { "location": "7231/Talk", "narrator": "みやび", "text": "ガブちゃん、そこは気づい\nたらあかんとこやよ……。"},
        { "location": "7232/Talk", "narrator": "つばめ", "text": "わたしたちって、実は\nかなりヤバくないですか？"},
        { "location": "7233/Talk", "narrator": "みやび", "text": "う、うちらまだ若いし\nここからやし、\n大丈夫やし……。"},
        { "location": "7234/Talk", "narrator": "ガブリエラ", "text": "ていうか、みやびも\n意外とそういうトコは\n気にしてたのね。"},
        { "location": "7235/Talk", "narrator": "ガブリエラ", "text": "ちなみにアンタは青春を\n謳歌しちゃってたりする\nわけ？"},
        { "location": "7236/Talk", "narrator": "ガブリエラ", "text": "なんにしろアンタも\n青春には縁が無かった\nってわけよね。"},
        { "location": "7237/Talk", "narrator": "ガブリエラ", "text": "可哀相だからあたしたちの\n仲間にしてあげるわ。"},
        { "location": "7238/Talk", "narrator": "つばめ", "text": "それって、かなりむなしい\n集まりですよね……。"},
        { "location": "7239/Talk", "narrator": "みやび", "text": "「神楽ちゃんは私に\nとっての奇跡」とは、\nこれまた美味しい。"},
        { "location": "7240/Talk", "narrator": "アーヤ", "text": "なかなか面と向かって言え\nる言葉じゃないわよね。"},
        { "location": "7241/Talk", "narrator": "ガブリエラ", "text": "つばめは天然ジゴロって\nヤツなんじゃない？"},
        { "location": "7242/Talk", "narrator": "みやび", "text": "サラッと大好きとか\n言うてるし、女泣かせ\nやわ、つばめちゃん。"},
        { "location": "7243/Talk", "narrator": "つばめ", "text": "いや、わたしは\nそんなつもりじゃ……"},
        { "location": "7244/Talk", "narrator": "みやび", "text": "そしてつばめちゃんの\n天然プレイガールさに\n音羽がキレたと。"},
        { "location": "7245/Talk", "narrator": "アーヤ", "text": "なるほど、それでつばめと\n神楽の楽園が崩壊したのね。"},
        { "location": "7246/Talk", "narrator": "つばめ", "text": "アーヤさんまで変な理屈に\n納得しないででください！"},
        { "location": "7247/Talk", "narrator": "神楽", "text": "ああっ！\n私とつばめさんの\n桃源郷がっ……。"},
        { "location": "7248/Talk", "narrator": "みやび", "text": "いよいよ現実逃避も\n終わりってことやね。"},
        { "location": "7249/Talk", "narrator": "ガブリエラ", "text": "それにしてもここって\nどういうことなの？"},
        { "location": "7250/Talk", "narrator": "ガブリエラ", "text": "音羽が身投げして\nフュージョンクランを\nぶっ壊すってこと？"},
        { "location": "7251/Talk", "narrator": "みやび", "text": "それはあれやね、鬱ＳＦに\nよくあるパターンや。"},
        { "location": "7252/Talk", "narrator": "みやび", "text": "暴走してる動力炉を\n止めるために一人\n身を呈して向かう！"},
        { "location": "7253/Talk", "narrator": "みやび", "text": "みたいな、お約束の\nシチュエーションやね。"},
        { "location": "7254/Talk", "narrator": "ガブリエラ", "text": "ああ、最初から死亡フラグ\n立ってるヤツよね。"},
        { "location": "7255/Talk", "narrator": "みやび", "text": "ちょい待ち。ここは\n絶対解説必要だって。\nつばめちゃんどぞー。"},
        { "location": "7256/Talk", "narrator": "つばめ", "text": "ええ！？\nわたし！？"},
        { "location": "7257/Talk", "narrator": "みやび", "text": "ここでなんでつばめちゃん\nの電源が切れたん？"},
        { "location": "7258/Talk", "narrator": "つばめ", "text": "わたしロボットですか！？"},
        { "location": "7259/Talk", "narrator": "神楽", "text": "これは、音羽の世界が\n完全に終わったから\nですよ。"},
        { "location": "7260/Talk", "narrator": "神楽", "text": "このつばめさんは元々\n音羽が作り出したもの\nですから。"},
        { "location": "7261/Talk", "narrator": "神楽", "text": "そのまま電源切らずに\n置いといて欲しかった\nですけど！"},
        { "location": "7262/Talk", "narrator": "神楽", "text": "……さ、さーて今週も\nまたまたやって参りました！"},
        { "location": "7263/Talk", "narrator": "神楽", "text": "読者参加型企画、\nクイズでどーん！"},
        { "location": "7264/Talk", "narrator": "神楽", "text": "司会は私卯月神楽と！\nはい、つばめさん！"},
        { "location": "7265/Talk", "narrator": "つばめ", "text": "えっ？　わたしっ？\nお、逢瀬つばめです！"},
        { "location": "7266/Talk", "narrator": "みやび", "text": "つばめちゃん、\nなにノセられてるの。"},
        { "location": "7267/Talk", "narrator": "ガブリエラ", "text": "ていうかテレくさい\nシーンだから無茶振り\nしてるんでしょ。"},
        { "location": "7268/Talk", "narrator": "神楽", "text": "バレるの早っ！"},
        { "location": "7269/Talk", "narrator": "つばめ", "text": "このシーンはみんなに\n真剣に見てもらった\n方がいいと思うよ？"},
        { "location": "7270/Talk", "narrator": "みやび", "text": "レアな物ほど神々しい\nゆうし正にこの卯月は\n後光差すまぶしさや。"},
        { "location": "7271/Talk", "narrator": "神楽", "text": "皆さんを見ていると、\n見えます。\n見えますよ……。"},
        { "location": "7272/Talk", "narrator": "神楽", "text": "女子的なねちっとした\nどす黒いコールタールの\nような心の底が。"},
        { "location": "7273/Talk", "narrator": "つばめ", "text": "ああっ！！\n何かが還っていったよ！"},
        { "location": "7274/Talk", "narrator": "ガブリエラ", "text": "あたしたちの魂？"},
        { "location": "7275/Talk", "narrator": "みやび", "text": "よかった。\nこれでうちらやっと\n生き返れるんやね。"},
        { "location": "7276/Talk", "narrator": "ガブリエラ", "text": "まぁ、結果オーライなら、\nいいけど。"},
        { "location": "7277/Talk", "narrator": "みやび", "text": "ここからうちらの\n大逆転モード！？"},
        { "location": "7278/Talk", "narrator": "ガブリエラ", "text": "だといいんだけど。"},
        { "location": "7279/Talk", "narrator": "つばめ", "text": "ちょ、ちょっと待って！！"},
        { "location": "7280/Talk", "narrator": "ガブリエラ", "text": "なんなのよ、つばめ？"},
        { "location": "7281/Talk", "narrator": "つばめ", "text": "今、わたしだけ\nヒューって青いのが\n戻らなくなかった？"},
        { "location": "7282/Talk", "narrator": "神楽", "text": "き、きっと\n気のせいですよ？"},
        { "location": "7283/Talk", "narrator": "みやび", "text": "ほら、つばめちゃんは\n特別やし……。"},
        { "location": "7284/Talk", "narrator": "ガブリエラ", "text": "も、もう、そんなこと\n気にしてないで\nさっさと先に進むわよ！"},
        { "location": "7285/Talk", "narrator": "つばめ", "text": "ええええええ……。"},
        { "location": "7286/Talk", "narrator": "神楽", "text": "最後にスペシャルな\n展開があるかも\n知れませんし！"},
        { "location": "7287/Talk", "narrator": "つばめ", "text": "とてもそうには\n見えないんだけど。"},
        { "location": "7288/Talk", "narrator": "つばめ", "text": "やっぱりわたしだけ\n死んだままじゃ\nないですかーっ！！"},
        { "location": "7289/Talk", "narrator": "みやび", "text": "いや、さっきうちも\n殆ど虫の息やったし、\n同じや、同じ。"},
        { "location": "7290/Talk", "narrator": "つばめ", "text": "すっごく大きな違いです\nよっ！"},
        { "location": "7291/Talk", "narrator": "ガブリエラ", "text": "ほんとフェノメノンの\n主って何でもアリね。"},
        { "location": "7292/Talk", "narrator": "ガブリエラ", "text": "ていうか今回のを見ていて\n一つ思ったことがあるんだ\nけど。"},
        { "location": "7293/Talk", "narrator": "ガブリエラ", "text": "フェノメノンで\nフェノメノンを喰ったり\nできるわけでしょ？"},
        { "location": "7294/Talk", "narrator": "ガブリエラ", "text": "そしたらあたしたちも\n敵のフェノメノンの中\nで戦う時に──"},
        { "location": "7295/Talk", "narrator": "ガブリエラ", "text": "あたしたちの誰かが\nフェノメノン発症して\n世界改ざんして──"},
        { "location": "7296/Talk", "narrator": "ガブリエラ", "text": "それで、あたしたちが\nシナリオ作って倒せば\n絶対無敵じゃない？"},
        { "location": "7297/Talk", "narrator": "みやび", "text": "問題は、じゃあ誰が\n発症するってことやね。"},
        { "location": "7298/Talk", "narrator": "つばめ", "text": "ジャンケン？"},
        { "location": "7299/Talk", "narrator": "ガブリエラ", "text": "いや、そんな簡単に\n決めていいことじゃ\nないし……。"},
        { "location": "7300/Talk", "narrator": "ガブリエラ", "text": "やっぱこの方法は\n無理があったか。"},
        { "location": "7301/Talk", "narrator": "みやび", "text": "ミッション\nアンコンプリート\n言われてもなあ。"},
        { "location": "7302/Talk", "narrator": "ガブリエラ", "text": "淡々とドヤゼリフを\n言われてて、なんか\nむかつくわよね。"},
        { "location": "7303/Talk", "narrator": "神楽", "text": "ラスボスってこういうもの\nですし、仕方ありません。"},
        { "location": "7304/Talk", "narrator": "みやび", "text": "ラスボスに負けてたら\nうちらバッドエンド\n直行やん！"},
        { "location": "7305/Talk", "narrator": "ガブリエラ", "text": "みやびってとりあえず\n最初はバッドエンド\n見とくタイプでしょ？"},
        { "location": "7306/Talk", "narrator": "みやび", "text": "ガブちゃん、なんで\n知っちょるん！？"},
        { "location": "7307/Talk", "narrator": "みやび", "text": "キャーッ！\nまほさーん！"},
        { "location": "7308/Talk", "narrator": "つばめ", "text": "えっと、それって\n牛丼だっけ？"},
        { "location": "7309/Talk", "narrator": "神楽", "text": "「天丼」ですよ。"},
        { "location": "7310/Talk", "narrator": "ガブリエラ", "text": "日本語って難しいわね。"},
        { "location": "7311/Talk", "narrator": "神楽", "text": "でも天丼の意味\n知ってるのって、\n関西の人だけですよ？"},
        { "location": "7312/Talk", "narrator": "ガブリエラ", "text": "じゃあ知ってなくて\n当たり前ってことね。"},
        { "location": "7313/Talk", "narrator": "つばめ", "text": "じゃあわたしが\n知らなかったのは\n静岡出身だからだね。"},
        { "location": "7314/Talk", "narrator": "みやび", "text": "私も知らないわね。\n（アーヤの真似）"},
        { "location": "7315/Talk", "narrator": "みやび", "text": "うむ、やはりアーヤの\nキメポーズやないと\nしっくりこんな。"},
        { "location": "7316/Talk", "narrator": "ガブリエラ", "text": "真似するくらいなら\nアーヤと代わって\nあげなさいよ……。"},
        { "location": "7317/Talk", "narrator": "つばめ", "text": "ていうか神楽ちゃんも\n東京出身だよね？"},
        { "location": "7318/Talk", "narrator": "ガブリエラ", "text": "神楽は芸人だし。"},
        { "location": "7319/Talk", "narrator": "神楽", "text": "ガブちゃん、微妙に\n否定しづらいボケを\nしないでください。"},
        { "location": "7320/Talk", "narrator": "みやび", "text": "さて、最後くらいは\n真面目にまとめよう\nではないか諸君。"},
        { "location": "7321/Talk", "narrator": "みやび", "text": "そもそも今回の一件、\nどういう状況なのか？"},
        { "location": "7322/Talk", "narrator": "アーヤ", "text": "千羽鶴はフュージョン\nクランを作って神楽に\nコネクトさせた。"},
        { "location": "7323/Talk", "narrator": "アーヤ", "text": "そして神楽が私たちの\n魂をも使ってフェノメ\nノンを巨大化させる。"},
        { "location": "7324/Talk", "narrator": "アーヤ", "text": "それで日本を覆うって\n流れでしょ？"},
        { "location": "7325/Talk", "narrator": "ガブリエラ", "text": "で、どういう世界に\nするかは千羽鶴が\n決めようとしてたと。"},
        { "location": "7326/Talk", "narrator": "みやび", "text": "でもその原子炉たる\nフュージョンクランに\n音羽が──"},
        { "location": "7327/Talk", "narrator": "みやび", "text": "「アイルビーバック」\nしたんで原子炉爆発！"},
        { "location": "7328/Talk", "narrator": "みやび", "text": "うちらはちりぢりに\nなって、千羽鶴の計画は\n頓挫したと。"},
        { "location": "7329/Talk", "narrator": "ガブリエラ", "text": "ん？　音羽を死守する\nように指示してたのは\n結局エリカよね？"},
        { "location": "7330/Talk", "narrator": "ガブリエラ", "text": "でも、そもそも音羽を\nずっと劇場に確保して\nたのは管理庁でしょ？"},
        { "location": "7331/Talk", "narrator": "ガブリエラ", "text": "結局誰が何を考えて、\n何をどう配置したのか\nよく解らないわね。"},
        { "location": "7332/Talk", "narrator": "アーヤ", "text": "ええ、姉がどこまで\n誰に関与してたのかも\n含めてね……。"},
        { "location": "7333/Talk", "narrator": "みやび", "text": "こうゆうカオス状態を\n作り出すことこそ、\n正しい黒幕の動き方ぞね。"},
        { "location": "7334/Talk", "narrator": "みやび", "text": "クックックッ……。"},
        { "location": "7335/Talk", "narrator": "アーヤ", "text": "またそうやって\n更に場をひっかき回す\nようなことを言う。"},
        { "location": "7336/Talk", "narrator": "つばめ", "text": "（どうしよう。全く\n話についていけない）"},
        { "location": "7337/Talk", "narrator": "みやび", "text": "ああっ！！　つばめ\nちゃんがまた死んだ！"},
        { "location": "7338/Talk", "narrator": "つばめ", "text": "わたしっ！？\nち、違いますよっ！！"},
        { "location": "7339/Talk", "narrator": "みやび", "text": "いや、\n千羽鶴＝つばめちゃん\nやし。"},
        { "location": "7340/Talk", "narrator": "つばめ", "text": "あー、そっかー。"},
        { "location": "7341/Talk", "narrator": "つばめ", "text": "でもそうするとわたし、\n普通の人の２倍、死に\nやすいってことじゃ？"},
        { "location": "7342/Talk", "narrator": "ガブリエラ", "text": "なんでそうなるのよ。"},
        { "location": "7343/Talk", "narrator": "みやび", "text": "つばめちゃんが混乱し\nちょるところアレやけ\nど本当に次で終わり？"},
        { "location": "7344/Talk", "narrator": "アーヤ", "text": "ええ、どんなラストに\nなるのかしらね……。"},
        { "location": "7345/Talk", "narrator": "つばめ", "text": "そ、その前にわたしの\nＭＶもありますから！\nお、お楽しみにっ！"},
        { "location": "7346/Talk", "narrator": "みやび", "text": "んー、ほんまに終わり\nなんかなー？　なんや\n裏がありそうやない？"},
        { "location": "7347/Talk", "narrator": "みやび", "text": "ここの運営は\n何を企んじょるんか\n油断ならんき。"},
        { "location": "7348/Talk", "narrator": "みやび", "text": "と、考察班を煽ってみたり\nしちょるわけや。"}
    ]
}
