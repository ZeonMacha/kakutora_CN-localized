{
    "dir": "stream_010_ch01TOUCHSELgabriellaOnFlick1.json",
    "type": "watchanime",
    "info": {
    },
    "entry":
    [
        { "location": "137/Stay", "narrator": "", "text": "スプリングフィル"},
        { "location": "138/Talk", "narrator": "神楽", "text": "さぁ、それでは今回も\n頑張って\nいっちゃいますよっ。"},
        { "location": "139/Talk", "narrator": "つばめ", "text": "でも今さらかもだけど\n何をがんばれば\nいいのかな？"},
        { "location": "140/Talk", "narrator": "みやび", "text": "そんなん面白おかしい\nトークをするんに\n決まっとるき。"},
        { "location": "141/Talk", "narrator": "アーヤ", "text": "それも違うと思うけど\nあまり暴走しなければ\nいいわ……。"},
        { "location": "142/Talk", "narrator": "みやび", "text": "そんでこれは前回\nいじられたすぐ後\nみたいやね。"},
        { "location": "143/Talk", "narrator": "神楽", "text": "でも、つばめさんを\nからかったわけじゃ\nありませんからね？"},
        { "location": "144/Talk", "narrator": "つばめ", "text": "それはわかってるけど\n何かちょっと悔しいと\n言うか何と言うか。"},
        { "location": "145/Talk", "narrator": "アーヤ", "text": "ところで二人の\nお弁当は\n自分で作ったの？"},
        { "location": "146/Talk", "narrator": "つばめ", "text": "あっ、はい、わたし、\n家事は慣れてるので。"},
        { "location": "147/Talk", "narrator": "みやび", "text": "お約束やけど、これは\nいいお嫁さんに\nなれるわぁ～。"},
        { "location": "148/Talk", "narrator": "つばめ", "text": "ふえぇっ！？"},
        { "location": "149/Talk", "narrator": "神楽", "text": "それはー、\nトップシークレット\nでーすっ。"},
        { "location": "150/Talk", "narrator": "みやび", "text": "あっ（察し）"},
        { "location": "151/Talk", "narrator": "みやび", "text": "ところで君は\nお弁当に好き嫌い\nとかあるん？"},
        { "location": "152/Talk", "narrator": "神楽", "text": "そんなことより、\nいよいよガブちゃんの\n登場ですよ♪"},
        { "location": "153/Talk", "narrator": "みやび", "text": "またいらんモブまで\n来よったし。"},
        { "location": "154/Talk", "narrator": "アーヤ", "text": "じゃあギャヴィと\n替わるわね。"},
        { "location": "155/Talk", "narrator": "ガブリエラ", "text": "わわわっ！？\nいきなり\n連れ出さないでよっ！"},
        { "location": "156/Talk", "narrator": "みやび", "text": "おやおや～？\n何やガブちゃんの\n様子がおかしいなぁ？"},
        { "location": "157/Talk", "narrator": "ガブリエラ", "text": "こ、ここ、これはっ、\nあたし、中等部だし、\nだからっ……。"},
        { "location": "158/Talk", "narrator": "つばめ", "text": "あっ、わかるよ。\n先輩と話すのって\n緊張するもんね。"},
        { "location": "159/Talk", "narrator": "ガブリエラ", "text": "そ、そう！\nそれよっ！！"},
        { "location": "160/Talk", "narrator": "みやび", "text": "ガブちゃん、いつから\nそないしおらしい\nキャラになったん？"},
        { "location": "161/Talk", "narrator": "ガブリエラ", "text": "だ、だから、ほら、\nちょっと通りかかった\nだけだってばっ！"},
        { "location": "162/Talk", "narrator": "つばめ", "text": "あっ、せんぱいが\n逃げちゃった。"},
        { "location": "163/Talk", "narrator": "ガブリエラ", "text": "に、逃げてないっ！\n急用を思い出した\nだけなんだからっ！"},
        { "location": "164/Talk", "narrator": "みやび", "text": "そんで卯月は\nマイペースで黙々と\nお弁当食べちょるね。"},
        { "location": "165/Talk", "narrator": "神楽", "text": "はい、ご飯は\nよく噛んで食べないと\nいけませんから。"},
        { "location": "166/Talk", "narrator": "ガブリエラ", "text": "じゃ、じゃあ、\nそういうことで、\n誤解しないでよっ！"},
        { "location": "167/Talk", "narrator": "アーヤ", "text": "あら？　ギャヴィ、\nもう替わっていいの？"},
        { "location": "168/Talk", "narrator": "みやび", "text": "何やほんま\n逃げるように\n出て行ってもうた。"},
        { "location": "169/Talk", "narrator": "つばめ", "text": "確かに、このせんぱい\nちょっとおざなりな\nお掃除ですね。"},
        { "location": "170/Talk", "narrator": "神楽", "text": "腰が入ってませんね。\n腕だけだと力が効率\n良く伝わりません。"},
        { "location": "171/Talk", "narrator": "アーヤ", "text": "ホウキの使い方を\nそんな冷静に\n考察しなくても……。"},
        { "location": "172/Talk", "narrator": "神楽", "text": "はい、私、ホウキの\n使い方にはちょっと\nうるさいですからっ。"},
        { "location": "173/Talk", "narrator": "つばめ", "text": "あっ、そう言えば\n卯月さんの武器、\nホウキだよね。"},
        { "location": "174/Talk", "narrator": "神楽", "text": "どっちがいいですか？\nつばめさんが決めて\nいいですよ？"},
        { "location": "175/Talk", "narrator": "つばめ", "text": "え～？　わたしが～？\nそう言われると何だか\n責任重大で……。"},
        { "location": "176/Talk", "narrator": "みやび", "text": "ちょい待ち！　うちの\n怪しいシーンを\nスルーせんといて！"},
        { "location": "177/Talk", "narrator": "アーヤ", "text": "自分で怪しいって\n言って\nどうするのよ……。"},
        { "location": "178/Talk", "narrator": "つばめ", "text": "ていうか、みやびさん\nいつも怪しいから\n気にならなくて。"},
        { "location": "179/Talk", "narrator": "みやび", "text": "そんな、まるでうちが\n普段から\nキョドっちょると！？"},
        { "location": "180/Talk", "narrator": "アーヤ", "text": "それよりここ、\n大事な話をしてる\nみたいだけど？"},
        { "location": "181/Talk", "narrator": "つばめ", "text": "何だか探偵物の\n推理シーン\nみたいですね。"},
        { "location": "182/Talk", "narrator": "神楽", "text": "犯人は私だっ！"},
        { "location": "183/Talk", "narrator": "つばめ", "text": "スピード解決過ぎっ！"},
        { "location": "184/Talk", "narrator": "みやび", "text": "そして二人は\n恋に落ちたわけやね。"},
        { "location": "185/Talk", "narrator": "アーヤ", "text": "あなたたち、ちょっと\nノリと思いつきで\n会話をし過ぎよ……。"},
        { "location": "186/Talk", "narrator": "つばめ", "text": "ところでみやびさんも\nわたしたちと同じ\n制服着てるんですね。"},
        { "location": "187/Talk", "narrator": "みやび", "text": "何、改めてつっこんで\nうちを一体何歳やと\n思っちょるん？"},
        { "location": "188/Talk", "narrator": "つばめ", "text": "あっ、わたしこれ結局\nまだ見てないです。\nスマホで見られます？"},
        { "location": "189/Talk", "narrator": "みやび", "text": "んー、あまりに\nわざとらしゅう古臭く\n作っちょるからなぁ。"},
        { "location": "190/Talk", "narrator": "つばめ", "text": "ダメなんですか？"},
        { "location": "191/Talk", "narrator": "みやび", "text": "普通ならダメやないん\nやけど、わざとダメに\n作っちょるかもなぁ。"},
        { "location": "192/Talk", "narrator": "アーヤ", "text": "人的リソースの配分が\nおかしい気が\nするわね……。"},
        { "location": "193/Talk", "narrator": "みやび", "text": "きっと日頃の\nストレス解消も\n兼ねちょるんよ。"},
        { "location": "194/Talk", "narrator": "アーヤ", "text": "それはそれで\nどうなのかしら。"},
        { "location": "195/Talk", "narrator": "みやび", "text": "お、ガブちゃん、\nお帰り～。"},
        { "location": "196/Talk", "narrator": "ガブリエラ", "text": "な、何よ、\n用も無いのに\n呼ばないでよね。"},
        { "location": "197/Talk", "narrator": "神楽", "text": "いえいえ、これも\nお仕事ですよ？"},
        { "location": "198/Talk", "narrator": "つばめ", "text": "でも、このサイト、\nここまでする必要が\nあるのかなぁ？"},
        { "location": "199/Talk", "narrator": "ガブリエラ", "text": "当たり前でしょ。\n身バレした時のこと\n想像してみなさいよ。"},
        { "location": "200/Talk", "narrator": "つばめ", "text": "えーと……ファンに\n押しかけられて大変、\nとか？"},
        { "location": "201/Talk", "narrator": "神楽", "text": "つばめさんなら\n大人気間違い無し！\nですからねっ。"},
        { "location": "202/Talk", "narrator": "みやび", "text": "まぁ、それもあるかも\nやけど、お役所的にも\nバレたらいかんきに。"},
        { "location": "203/Talk", "narrator": "ガブリエラ", "text": "未成年を危険な任務に\n就かせてるなんてバレ\nたらマズいもんね。"},
        { "location": "204/Talk", "narrator": "神楽", "text": "それもありますけど、\nもしフェノメノンが\n人為的なものだったら"},
        { "location": "205/Talk", "narrator": "つばめ", "text": "はぇ～……。\n何か色々と大変\nなんですねぇ……。"},
        { "location": "206/Talk", "narrator": "みやび", "text": "って、つばめちゃん、\n他人事ちゃうから！"},
        { "location": "207/Talk", "narrator": "神楽", "text": "ところで、私を\nお嫁さんにしたい人は\nいないんですか？"},
        { "location": "208/Talk", "narrator": "つばめ", "text": "あっ！　わ、わたしも\nき、気になりますっ！"},
        { "location": "209/Talk", "narrator": "みやび", "text": "まぁ、それはおいおい\n見てもらっとけば\nいいとして、"},
        { "location": "210/Talk", "narrator": "ガブリエラ", "text": "べつにそんなつもり\n全然無かったし、\n大きなお世話ね！"},
        { "location": "211/Talk", "narrator": "みやび", "text": "ロマンチック大作戦\nｉｎ七夕まつり。\n状況開始や！"},
        { "location": "212/Talk", "narrator": "つばめ", "text": "面倒臭がってたのに\nいきなりノリノリ\nですね、みやびさん。"},
        { "location": "213/Talk", "narrator": "みやび", "text": "やるからには\n楽しんだ者勝ちやき。"},
        { "location": "214/Talk", "narrator": "みやび", "text": "ほんでつばめちゃん、\nクラスの友だちは\n呼ばんかったん？"},
        { "location": "215/Talk", "narrator": "つばめ", "text": "実は誘ったんですけど\n繭ちゃんはバイトが\n抜けられなくて、"},
        { "location": "216/Talk", "narrator": "ガブリエラ", "text": "それって女子高生的に\nどうなの……？"},
        { "location": "217/Talk", "narrator": "みやび", "text": "ほい、そしたらここで\nうちらの浴衣姿の感想\n言ってみよか？"},
        { "location": "218/Talk", "narrator": "みやび", "text": "それにしてもこのモブ\nキザやわ～。腹黒いに\n決まっちょる。"},
        { "location": "219/Talk", "narrator": "ガブリエラ", "text": "……何よ？　あたしに\nリアクションさせよう\nって企んでる？"},
        { "location": "220/Talk", "narrator": "つばめ", "text": "ガブちゃんせんぱい、\n顔が真っ赤っかで\n可愛いですね。"},
        { "location": "221/Talk", "narrator": "ガブリエラ", "text": "う、うるさいっ！\nあんたの記憶を\n消すわよ！？"},
        { "location": "222/Talk", "narrator": "つばめ", "text": "何でですかぁっ！？"},
        { "location": "223/Talk", "narrator": "神楽", "text": "それでは皆さん、\n次回もお楽しみに♪"},
        { "location": "224/Talk", "narrator": "ガブリエラ", "text": "ねぇ、もうこれ今回で\n終わりにしない？"},
        { "location": "225/Talk", "narrator": "ガブリエラ", "text": "それは言い過ぎか。\nでもこの後二回くらい\nとばしてもいいわよ。"},
        { "location": "226/Talk", "narrator": "ガブリエラ", "text": "き、貴重なアイテムは\n温存しないとでしょ？\nね？　ね？"},
        { "location": "227/Talk", "narrator": "みやび", "text": "ほほぅ？\nほんまに何でも？\nうちの手作りでも？"},
        { "location": "228/Talk", "narrator": "つばめ", "text": "みやびさんって\nお料理できますよね？\nそう聞いてたような？"},
        { "location": "229/Talk", "narrator": "みやび", "text": "確かにできる。\nでも「何でも」作れる\nとは言うてないで？"},
        { "location": "230/Talk", "narrator": "神楽", "text": "何でもは作れない。\n作れるものだけ。\nですね？"},
        { "location": "231/Talk", "narrator": "アーヤ", "text": "何だかどこかで\n聞いたような\nセリフね。"},
        { "location": "232/Talk", "narrator": "つばめ", "text": "……あの、結局、\nどっちなんですか？"},
        { "location": "233/Talk", "narrator": "みやび", "text": "せやったら今度\nつばめちゃんに\n作って来ちょるわ。"},
        { "location": "234/Talk", "narrator": "神楽", "text": "正に、その身をもって\n味わうがいい！\nってことですねっ。"},
        { "location": "235/Talk", "narrator": "つばめ", "text": "わ、わぁ～……、\nうれしいなぁ～……。"},
        { "location": "236/Talk", "narrator": "みやび", "text": "それ単に好き嫌いが\n激しい言うちょる\nだけやき。"},
        { "location": "237/Talk", "narrator": "つばめ", "text": "好き嫌いばかり\n言ってたら\n大きくなれませんよ！"},
        { "location": "238/Talk", "narrator": "みやび", "text": "ちなみに\nつばめちゃんは何が\n嫌いやの？"},
        { "location": "239/Talk", "narrator": "つばめ", "text": "わたし、食べ物では\n特に苦手だったり\n嫌いな物は無いかな？"},
        { "location": "240/Talk", "narrator": "みやび", "text": "ほほぅ、そのお陰で\n意外と立派な物を\n持っとるんやね。"},
        { "location": "241/Talk", "narrator": "つばめ", "text": "ど、どこ見て言って\nるんですかっ！？"},
        { "location": "242/Talk", "narrator": "神楽", "text": "……私も好き嫌い\n無くそうかなぁ。"},
        { "location": "243/Talk", "narrator": "つばめ", "text": "えっ？"},
        { "location": "244/Talk", "narrator": "神楽", "text": "あっ、ううん、\n何でもないですよ？"},
        { "location": "245/Talk", "narrator": "みやび", "text": "うんうん、男子なら\n誰でも気になるよな\nそれ。"},
        { "location": "246/Talk", "narrator": "ガブリエラ", "text": "何でみやびが\n男子の気持ちを\n知ってるのよ……。"},
        { "location": "247/Talk", "narrator": "みやび", "text": "そらうちは言うたら\nおっぱいの付いた\n女の子やき。"},
        { "location": "248/Talk", "narrator": "つばめ", "text": "……あの、それ普通に\n女の子ですよね？"},
        { "location": "249/Talk", "narrator": "神楽", "text": "さて、それでは私が\nその疑問にズバリ\nお答えしましょう！"},
        { "location": "250/Talk", "narrator": "ガブリエラ", "text": "神楽は余計なこと\n言わないで\n黙ってて！"},
        { "location": "251/Talk", "narrator": "みやび", "text": "そないな時は一言、\n「尊い」って\n言うんや。"},
        { "location": "252/Talk", "narrator": "神楽", "text": "尊い……。"},
        { "location": "253/Talk", "narrator": "ガブリエラ", "text": "あんたが言って\nどうするのよ……。"},
        { "location": "254/Talk", "narrator": "つばめ", "text": "ガブちゃんせんぱい、\n尊い……です……。"},
        { "location": "255/Talk", "narrator": "ガブリエラ", "text": "やめなさいってば！\nあたしが可愛いのは\n当然だし？"},
        { "location": "256/Talk", "narrator": "みやび", "text": "お、ガブちゃん、\nやっと調子が\n戻ってきたき？"},
        { "location": "257/Talk", "narrator": "ガブリエラ", "text": "な、なーんのこと\nかしら？　意味が\nわからないんだけど？"},
        { "location": "258/Talk", "narrator": "神楽", "text": "あっという間の\n一時間でしたね！"},
        { "location": "259/Talk", "narrator": "神楽", "text": "あっ、ボケですから\nここはつっこむ所\nですよ？"},
        { "location": "260/Talk", "narrator": "神楽", "text": "さぁさぁ、\nどこからでもかかって\n来てくださいっ！"},
        { "location": "261/Talk", "narrator": "みやび", "text": "ロマンチック大作戦の\n発動でこれは次回が\n待ち切れんち。"},
        { "location": "262/Talk", "narrator": "みやび", "text": "ラブコメ展開は不安？\n大丈夫や。\nうちに任せとき。"},
        { "location": "263/Talk", "narrator": "みやび", "text": "ガブちゃんの\nいいシーン、\nバッチリ見せちゃる。"},
        { "location": "264/Talk", "narrator": "つばめ", "text": "わ、わたしも\n言い出しっぺですし\nがんばりますよっ！"},
        { "location": "265/Talk", "narrator": "つばめ", "text": "い、いえ、わたしの\nロマンチックは\nべつにいいです。"},
        { "location": "266/Talk", "narrator": "つばめ", "text": "そんなの、だって、\nは、恥ずかしいしっ！"},
        { "location": "267/Talk", "narrator": "アーヤ", "text": "もうギャヴィったら\n何を言い出すかと\n思えば……。"},
        { "location": "268/Talk", "narrator": "アーヤ", "text": "と、ところで、\n私の浴衣どうだった？\n……変じゃなかった？"},
        { "location": "269/Talk", "narrator": "アーヤ", "text": "よくわからなかったら\n次回はちゃんと\n見ておいてね。"}
    ]
}
