{
    "dir": "stream_180_ch01.json",
    "type": "watchanime",
    "info": {
    },
    "entry":
    [
        { "location": "3646/Talk", "narrator": "つばめ", "text": "……そうだよね。\nみんな知らなかった\nみたいだし……。"},
        { "location": "3647/Talk", "narrator": "つばめ", "text": "そっかぁ……。\nなのにわたしったら\n全然ダメで……。"},
        { "location": "3648/Talk", "narrator": "つばめ", "text": "そう……だよね……。\nもう手遅れだね……。"},
        { "location": "3649/Talk", "narrator": "つばめ", "text": "そう……かな……？\nまだ間に合うのかな？"},
        { "location": "3650/Talk", "narrator": "つばめ", "text": "そ……そうかも知れない\nけど、だって……。"},
        { "location": "3651/Talk", "narrator": "つばめ", "text": "でも、だとしたって、\nつらいのはつらいし\nどうすればいいの？"},
        { "location": "3652/Talk", "narrator": "つばめ", "text": "わたしが……？\n神楽ちゃんのために？"},
        { "location": "3653/Talk", "narrator": "つばめ", "text": "でも、何の助けにも\nなってなかったら\n意味無いよ……。"},
        { "location": "3654/Talk", "narrator": "つばめ", "text": "本当にあったのかな？\nわたしには全然そうは\n思えなくて……。"},
        { "location": "3655/Talk", "narrator": "つばめ", "text": "意味があるとかじゃ\n無いってこと？\nでも……。"},
        { "location": "3656/Talk", "narrator": "つばめ", "text": "わたしだってそう思いたい\nけどだけど……。"},
        { "location": "3657/Talk", "narrator": "つばめ", "text": "わたしだって\n諦めたくない……。\nないよ……。"},
        { "location": "3658/Talk", "narrator": "神楽", "text": "あっ、上手いこと\n言いますね！\n座布団１０枚です！"},
        { "location": "3659/Talk", "narrator": "神楽", "text": "つまりこれも愛の\n一種だということは\n認めるんですね？"},
        { "location": "3660/Talk", "narrator": "神楽", "text": "ですよね！\nこれが普通に母と子の\n日常的な姿ですよ！"},
        { "location": "3661/Talk", "narrator": "神楽", "text": "母から子への愛は\nパンチの強さで決まる\nって言いますし。"},
        { "location": "3662/Talk", "narrator": "神楽", "text": "愛の強い母ほど笑顔は\n優しくて、パンチは\n厳しいものなんです。"},
        { "location": "3663/Talk", "narrator": "神楽", "text": "えーっ！\nしないんですか？\nおかしいですねっ。"},
        { "location": "3664/Talk", "narrator": "神楽", "text": "母から子への愛は\nパンチの強さで決まる\nって言いますから、"},
        { "location": "3665/Talk", "narrator": "神楽", "text": "それはきっと愛されて\nないんですよ。\n気をつけてください。"},
        { "location": "3666/Talk", "narrator": "神楽", "text": "パンチの強さは愛の\n強さって、自分で\n言ってて馬鹿みたい。"},
        { "location": "3667/Talk", "narrator": "神楽", "text": "戯言とか超越してる\nレベルで救いようが\n無いですよね……。"},
        { "location": "3668/Talk", "narrator": "神楽", "text": "って！　なんで\n撫でるんですか？\nやめてくださいよっ！"},
        { "location": "3669/Talk", "narrator": "神楽", "text": "私は撫でられるような\n良い子じゃなくて\n悪い子なんですから。"},
        { "location": "3670/Talk", "narrator": "神楽", "text": "……でも、なぜか\n落ち着くので今だけは\n感謝しておきますね。"},
        { "location": "3671/Talk", "narrator": "神楽", "text": "……ありがとう。"},
        { "location": "3672/Talk", "narrator": "神楽", "text": "もしかしたら貴方が\n私と共に歩む日が\n来るかも知れません。"},
        { "location": "3673/Talk", "narrator": "神楽", "text": "そうなることを私は\n願っています……。"},
        { "location": "3674/Talk", "narrator": "神楽", "text": "本当ですよ？"},
        { "location": "3675/Talk", "narrator": "つばめ", "text": "…………あっ、\nご、ごめんなさいっ！"},
        { "location": "3676/Talk", "narrator": "つばめ", "text": "なんて言っていいのか\nまとまらなくて……。"},
        { "location": "3677/Talk", "narrator": "つばめ", "text": "だから思ってること\nそのまま言わせて\nもらいますね……。"},
        { "location": "3678/Talk", "narrator": "つばめ", "text": "あ、あのですね、\n最初におことわり\nさせてくださいっ！"},
        { "location": "3679/Talk", "narrator": "つばめ", "text": "あ、いえ、何かを\n断るんじゃなくて、\nお知らせというか。"},
        { "location": "3680/Talk", "narrator": "つばめ", "text": "えーとですね……。"},
        { "location": "3681/Talk", "narrator": "つばめ", "text": "今回だけはわたし一人だけ\nで観たかったから――"},
        { "location": "3682/Talk", "narrator": "つばめ", "text": "みんなにはごめんなさい\nしてもらいました。"},
        { "location": "3683/Talk", "narrator": "つばめ", "text": "だから、その、\nみんなと見たかった\nあなたにも――"},
        { "location": "3684/Talk", "narrator": "つばめ", "text": "ほ、本当に、本当に\nごめんなさいっ！"},
        { "location": "3685/Talk", "narrator": "つばめ", "text": "え、えーと、じゃあ、\n二人きりですけど\n見ましょうか？"},
        { "location": "3686/Talk", "narrator": "つばめ", "text": "あっ、ごめんなさい。\n黙ったままで。\nでも……。"},
        { "location": "3687/Talk", "narrator": "つばめ", "text": "……ううん、\nわたしだけなんだから\nちゃんとしないと。"},
        { "location": "3688/Talk", "narrator": "つばめ", "text": "神楽ちゃん、わたしが\n知らない所で色々と\nつらいこと抱えていた。"},
        { "location": "3689/Talk", "narrator": "つばめ", "text": "どうして気づいて\nあげられなかった\nのかな……。"},
        { "location": "3690/Talk", "narrator": "つばめ", "text": "$handle$さんは\n知ってたの？"},
        { "location": "3691/Talk", "narrator": "つばめ", "text": "でも、気づいてても\n何も出来なかったかも\n知れないし……。"},
        { "location": "3692/Talk", "narrator": "つばめ", "text": "やっぱりわたしって\nダメだなぁ……。"},
        { "location": "3693/Talk", "narrator": "つばめ", "text": "メノウちゃんだったことも\n知らなかったし。"},
        { "location": "3694/Talk", "narrator": "つばめ", "text": "もちろん神楽ちゃんが\n言いたくなかったって\nことはわかってるけど"},
        { "location": "3695/Talk", "narrator": "つばめ", "text": "でもやっぱりわたしが\n気づけなかったのが\nダメなんだよね……。"},
        { "location": "3696/Talk", "narrator": "つばめ", "text": "わたし、いつも鈍くて\nだからお友達だって\nできなくて。"},
        { "location": "3697/Talk", "narrator": "つばめ", "text": "神楽ちゃんとも\nもうこれで、おしまい\nなのかなぁ……。"},
        { "location": "3698/Talk", "narrator": "つばめ", "text": "$handle$さんは\nどう思う？"},
        { "location": "3699/Talk", "narrator": "つばめ", "text": "でもやっぱりわたしが\nもっとしっかりしてれば"},
        { "location": "3700/Talk", "narrator": "つばめ", "text": "神楽ちゃんがあんな目には\nあわなかったのかもって。"},
        { "location": "3701/Talk", "narrator": "つばめ", "text": "やっぱりわたしじゃなんの\n力にもなれないよ……。"},
        { "location": "3702/Talk", "narrator": "つばめ", "text": "だから\n$handle$さん\nお願い。"},
        { "location": "3703/Talk", "narrator": "つばめ", "text": "私の代わりに神楽ちゃんを\n助けてあげて。"},
        { "location": "3704/Talk", "narrator": "つばめ", "text": "わたしじゃ\nダメだから……。"},
        { "location": "3705/Talk", "narrator": "つばめ", "text": "わたしじゃ\n何もできないから……。"},
        { "location": "3706/Talk", "narrator": "神楽", "text": "つ～ばめさんっ♪"},
        { "location": "3707/Talk", "narrator": "つばめ", "text": "か、神楽ちゃんっ！？"},
        { "location": "3708/Talk", "narrator": "神楽", "text": "も～。一人でコッソリ\n鑑賞してるなんて\n酷いですっ。"},
        { "location": "3709/Talk", "narrator": "神楽", "text": "どうして私を誘ってくれ\nなかったんですか？"},
        { "location": "3710/Talk", "narrator": "つばめ", "text": "えっ、で、でも、\nだって今回は……。"},
        { "location": "3711/Talk", "narrator": "神楽", "text": "でもここからは\n二人っきりで鑑賞会\nできて嬉しいです♪"},
        { "location": "3712/Talk", "narrator": "神楽", "text": "ええ、画面の向こうの\n誰かさんも「ここ」には\nいませんからね！"},
        { "location": "3713/Talk", "narrator": "神楽", "text": "あ、一応紹介します。\nこれうちの母ですけど\n興味無いですよね？"},
        { "location": "3714/Talk", "narrator": "つばめ", "text": "神楽ちゃん、ここから\n大変だったのになんで\nそんな脳天気に……。"},
        { "location": "3715/Talk", "narrator": "神楽", "text": "うちの母、なかなか\nワイルドですよね！"},
        { "location": "3716/Talk", "narrator": "つばめ", "text": "ワイルドなんてレベルじゃ\nないと思うんだけど……。"},
        { "location": "3717/Talk", "narrator": "神楽", "text": "愛ですよ。母の愛。\nかなりイカした\n愛し方ですよね？"},
        { "location": "3718/Talk", "narrator": "つばめ", "text": "神楽ちゃん……。"},
        { "location": "3719/Talk", "narrator": "神楽", "text": "さぁ、ここからが\nイイ所ですよ。心の\n準備はいいですか？"},
        { "location": "3720/Talk", "narrator": "神楽", "text": "おおっと美佐子選手\nいきなりの張り手攻撃！"},
        { "location": "3721/Talk", "narrator": "神楽", "text": "神楽選手どうした？\nどうして反撃に\n出ないのかーっ！？"},
        { "location": "3722/Talk", "narrator": "神楽", "text": "おおっと、\nここで神楽選手、\n遂に吐血かぁーっ！？"},
        { "location": "3723/Talk", "narrator": "神楽", "text": "どうしてまだ反撃\nしないのか、\nこれはで一方的だっ。"},
        { "location": "3724/Talk", "narrator": "神楽", "text": "神楽選手に一体何が\n起こっているのか\n目が離せないーっ！"},
        { "location": "3725/Talk", "narrator": "神楽", "text": "おおっと！？\n目が離せないどころか\n見せられない展開か？"},
        { "location": "3726/Talk", "narrator": "神楽", "text": "どうやら腹にキツい\n一発が入ったようだ。\n神楽選手、大丈夫か？"},
        { "location": "3727/Talk", "narrator": "神楽", "text": "つばめさん何でこの時\n早く帰れって言ったか\n真実を教えましょう！"},
        { "location": "3728/Talk", "narrator": "神楽", "text": "実はこれはプロレスで\n続きを観るにはＳ席の\nチケットが要ります。"},
        { "location": "3729/Talk", "narrator": "神楽", "text": "Ｓ席は１７５００円も\nするからつばめさん\nにはキツいかなーと。"},
        { "location": "3730/Talk", "narrator": "神楽", "text": "でも、これって\n普通ですよね？"},
        { "location": "3731/Talk", "narrator": "神楽", "text": "皆さんのお母さんも\n時々みぞおち決めたり\nしますよね？"},
        { "location": "3732/Talk", "narrator": "つばめ", "text": "あの、神楽ちゃん、\nもうそのくらいで\nいいから……。"},
        { "location": "3733/Talk", "narrator": "神楽", "text": "プロレスで本気で泣く\nなんて、つばめさんは\n本当に天然さんです♪"},
        { "location": "3734/Talk", "narrator": "神楽", "text": "もう、そんなところも\n可愛くて可愛くて\n私は大好きですよっ！"},
        { "location": "3735/Talk", "narrator": "つばめ", "text": "あ、ありがとう……。\nでもね――"},
        { "location": "3736/Talk", "narrator": "神楽", "text": "あっ！　ここからは\n真幌さんのカッコイイ\nシーンですねっ！"},
        { "location": "3737/Talk", "narrator": "神楽", "text": "やる時はやる真幌さん\nとてもカッコイイので\n私も見習いたいです！"},
        { "location": "3738/Talk", "narrator": "神楽", "text": "「殺る」書いて\n「やる」と読むって\n意味でも。"},
        { "location": "3739/Talk", "narrator": "つばめ", "text": "神楽ちゃんっ！？"},
        { "location": "3740/Talk", "narrator": "つばめ", "text": "え、えーと、なんだか\nとんでもないことに\nなっちゃいましたね。"},
        { "location": "3741/Talk", "narrator": "つばめ", "text": "でも神楽ちゃんが\n閉じこもらなくて\nよかったのかな？"},
        { "location": "3742/Talk", "narrator": "つばめ", "text": "これも怪我の功名？\nんー……なんか意味が\n違う気がする？"}
    ]
}
