{
    "dir": "stream_040_ch01.json",
    "type": "watchanime",
    "info": {
    },
    "entry":
    [
        { "location": "633/Talk", "narrator": "つばめ", "text": "そ、そんな、\nわたしなんて\n全然ですよ～～…。"},
        { "location": "634/Talk", "narrator": "みやび", "text": "つばめちゃん、\nここは素直に\n喜んどき。"},
        { "location": "635/Talk", "narrator": "つばめ", "text": "あ、\nありがたき幸せですっ…！"},
        { "location": "636/Talk", "narrator": "ガブリエラ", "text": "何なの、\nその喜び方……。"},
        { "location": "637/Talk", "narrator": "みやび", "text": "おぉーっと、\nそこに気づくとはー。"},
        { "location": "638/Talk", "narrator": "つばめ", "text": "プライムって\n何ですか？"},
        { "location": "639/Talk", "narrator": "ガブリエラ", "text": "はぁ？　いきなり\n何言ってんのあんた？"},
        { "location": "640/Talk", "narrator": "ガブリエラ", "text": "それくらいの英単語、\n知っときなさいよ！"},
        { "location": "641/Talk", "narrator": "みやび", "text": "そうやろ？\nやり過ぎくらいの方が\nいいんよ。"},
        { "location": "642/Talk", "narrator": "みやび", "text": "インパクトちゅーんは\n大事やき。"},
        { "location": "643/Talk", "narrator": "ガブリエラ", "text": "インパクトがあれば\nいいってもんじゃ\nないんだけど。"},
        { "location": "644/Talk", "narrator": "つばめ", "text": "わたしはこういう\nドキドキする展開、\n好きですよ！"},
        { "location": "645/Talk", "narrator": "ガブリエラ", "text": "あんたが言うなっ！"},
        { "location": "646/Talk", "narrator": "ガブリエラ", "text": "あー、いわゆる\n野球回ってやつねー。\nあるある。"},
        { "location": "647/Talk", "narrator": "つばめ", "text": "ありませんよっ！"},
        { "location": "648/Talk", "narrator": "アーヤ", "text": "逢瀬さん、今のは\nいいツッコミ\nだったわよ。"},
        { "location": "649/Talk", "narrator": "つばめ", "text": "そうですか？\nえへへっ♪"},
        { "location": "650/Talk", "narrator": "アーヤ", "text": "サービスって……。\nもう、みやびったら。"},
        { "location": "651/Talk", "narrator": "アーヤ", "text": "わ、私としては\n代わって貰えたら\nありがたいけど。"},
        { "location": "652/Talk", "narrator": "アーヤ", "text": "でもリーダーとして\nそういう考えも\nどうかと……。"},
        { "location": "653/Talk", "narrator": "ガブリエラ", "text": "言っとくけど\nあたしにそういうの\n期待しないでよ？"},
        { "location": "654/Talk", "narrator": "ガブリエラ", "text": "あんたに見せてあげる\nつもりなんて\n全然無いから！"},
        { "location": "655/Talk", "narrator": "ガブリエラ", "text": "えっ？　……いや、\nそんなに本気で\n落ち込まなくても。"},
        { "location": "656/Talk", "narrator": "つばめ", "text": "うぅぅ～、今回は\n皆さんにいっぱい\n迷惑かけちゃった。"},
        { "location": "657/Talk", "narrator": "つばめ", "text": "お詫びとして次回は\nわたしがサービスを。\nって、しませんよっ！"},
        { "location": "658/Talk", "narrator": "つばめ", "text": "わ、わたしなんて全然\nサービスにならなくて\nダメですってば！"},
        { "location": "659/Talk", "narrator": "みやび", "text": "コイガサキ参上。"},
        { "location": "660/Talk", "narrator": "みやび", "text": "OP映像の考察をしようと\n思い立った日から、俄然\nやる気がマシマシや。"},
        { "location": "661/Talk", "narrator": "つばめ", "text": "みやびさん、\n今回は早いですね！"},
        { "location": "662/Talk", "narrator": "みやび", "text": "人生長く生きちゅうと、\nそうゆうこともあるき。"},
        { "location": "663/Talk", "narrator": "みやび", "text": "ところでつばめちゃん。\nこの歌なんやけんど…。"},
        { "location": "664/Talk", "narrator": "つばめ", "text": "はい？"},
        { "location": "665/Talk", "narrator": "みやび", "text": "ズバリ、イチゴの\nミルフィーユとはなんぞ。"},
        { "location": "666/Talk", "narrator": "ガブリエラ", "text": "甘くて美味しいお菓子に\n決まってるじゃない。"},
        { "location": "667/Talk", "narrator": "みやび", "text": "おっ！　万年千秋楽を\n決めていたガブちゃんが\n颯爽と登場したぞね！"},
        { "location": "668/Talk", "narrator": "ガブリエラ", "text": "誰が千秋楽よ！\n人生長く生きていれば\n違うときだってあるわよ。"},
        { "location": "669/Talk", "narrator": "つばめ", "text": "それ聞いたの、\n今回二度目のような……"},
        { "location": "670/Talk", "narrator": "みやび", "text": "話を元に戻すと、まあ\n甘いケーキなのは\nそうなんやけんど……。"},
        { "location": "671/Talk", "narrator": "みやび", "text": "そもそも、歌の繋がりが\n変やないか？"},
        { "location": "672/Talk", "narrator": "ガブリエラ", "text": "え？　何で？"},
        { "location": "673/Talk", "narrator": "みやび", "text": "なんで、って……\n最初はノイズ交じりの\nディスプレイやぞ？"},
        { "location": "674/Talk", "narrator": "みやび", "text": "どう話が繋がったら\nイチゴのミルフィーユに\n到達するんや。"},
        { "location": "675/Talk", "narrator": "アーヤ", "text": "なんか難しいこと\n話してるわね。"},
        { "location": "676/Talk", "narrator": "つばめ", "text": "アーヤさんは、\nどう思いますか？"},
        { "location": "677/Talk", "narrator": "アーヤ", "text": "うーん、そうねぇ。"},
        { "location": "678/Talk", "narrator": "アーヤ", "text": "パソコンの画面が\n壊れちゃって\nイラッとしたから……"},
        { "location": "679/Talk", "narrator": "アーヤ", "text": "ケーキ食べて、幸せな\n気持ちになりましょ！\nっていうことじゃない？"},
        { "location": "680/Talk", "narrator": "みやび", "text": "まんまやないか。"},
        { "location": "681/Talk", "narrator": "ガブリエラ", "text": "ほら、もう\n始まっちゃうわよ？"},
        { "location": "682/Talk", "narrator": "つばめ", "text": "発症者って\n元の姿と髪の長さとか\n違うんですね。"},
        { "location": "683/Talk", "narrator": "みやび", "text": "胸も気持ち\n増量されちゅうろう？"},
        { "location": "684/Talk", "narrator": "アーヤ", "text": "こら、みやび。"},
        { "location": "685/Talk", "narrator": "つばめ", "text": "あーん、メノウちゃん\n可哀想ーっ。"},
        { "location": "686/Talk", "narrator": "ガブリエラ", "text": "前回のおさらいだと\n改めてつっこむこと\n無くて退屈ね。"},
        { "location": "687/Talk", "narrator": "みやび", "text": "そこを面白おかしく\nいじるんが、うちら\n芸人の務めやき。"},
        { "location": "688/Talk", "narrator": "ガブリエラ", "text": "お笑い系は\nみやびに任せるわ。"},
        { "location": "689/Talk", "narrator": "みやび", "text": "ほいたらガブちゃんは\n何系なん？\nまさかアイドル系？"},
        { "location": "690/Talk", "narrator": "ガブリエラ", "text": "な、何よ？\n悪いの？"},
        { "location": "691/Talk", "narrator": "つばめ", "text": "せんぱいって\n歌は上手いんですか？\n聞いてみたいな♪"},
        { "location": "692/Talk", "narrator": "ガブリエラ", "text": "……嫌よ。"},
        { "location": "693/Talk", "narrator": "つばめ", "text": "えぇーっ！？\n何でぇーっ！？"},
        { "location": "694/Talk", "narrator": "アーヤ", "text": "はい、無駄なお喋りは\nそれくらいでね。"},
        { "location": "695/Talk", "narrator": "みやび", "text": "そしたら、\nやりますか。"},
        { "location": "696/Talk", "narrator": "アーヤ", "text": "逢瀬さんは、この時に\n何で言われた通りに\n逃げなかったの？"},
        { "location": "697/Talk", "narrator": "つばめ", "text": "えっ？\nお、怒ってますか？"},
        { "location": "698/Talk", "narrator": "ガブリエラ", "text": "そりゃ、厄介ごとを\n増やしてくれた\nわけだしね。"},
        { "location": "699/Talk", "narrator": "つばめ", "text": "ご、ごめんなさいっ！\nで、でもっ！"},
        { "location": "700/Talk", "narrator": "アーヤ", "text": "怒ってないわよ。\nただ、理由を\n聞きたかっただけ。"},
        { "location": "701/Talk", "narrator": "つばめ", "text": "はぁ～……。\nそ、そうですか～。"},
        { "location": "702/Talk", "narrator": "ガブリエラ", "text": "なるほど、つばめが\n普通じゃないって\nここで確信したわけね。"},
        { "location": "703/Talk", "narrator": "みやび", "text": "話してみんことには\n洗脳されてるかどうか\nわからんき。"},
        { "location": "704/Talk", "narrator": "みやび", "text": "もしかしたら\n操られてるのかも\n知れんきね。"},
        { "location": "705/Talk", "narrator": "つばめ", "text": "でも何で洗脳\nされなかったんだろ。"},
        { "location": "706/Talk", "narrator": "つばめ", "text": "わたし、すっごく\n普通の子だった\nはずなんだけど……。"},
        { "location": "707/Talk", "narrator": "みやび", "text": "画面の向こうの君なら\n知ってるんと違う？"},
        { "location": "708/Talk", "narrator": "ガブリエラ", "text": "結局、聞くだけ\n時間の無駄\nだったわね。"},
        { "location": "709/Talk", "narrator": "つばめ", "text": "そ、そうでも\nなかったかも？\nえ、えへへっ……♪"},
        { "location": "710/Talk", "narrator": "みやび", "text": "はい、ガブちゃん、\nここで退場ー。"},
        { "location": "711/Talk", "narrator": "ガブリエラ", "text": "縁起でもないこと\n言わないでよ！"},
        { "location": "712/Talk", "narrator": "ガブリエラ", "text": "この程度、あたしなら\nかわして当然だし。"},
        { "location": "713/Talk", "narrator": "つばめ", "text": "その割には\n観念したみたいな表情\nしてたけど？"},
        { "location": "714/Talk", "narrator": "ガブリエラ", "text": "あんた、\nそういうとこだけは、\nよく見てるのね……。"},
        { "location": "715/Talk", "narrator": "ガブリエラ", "text": "ちなみに衣装は\n物質じゃないから\n弁償とか必要無いわ。"},
        { "location": "716/Talk", "narrator": "ガブリエラ", "text": "ほらウィットに富んだ\nトークをするくらいの\n余裕はあるでしょ？"},
        { "location": "717/Talk", "narrator": "アーヤ", "text": "そんなことより、\n問題はここからよ。"},
        { "location": "718/Talk", "narrator": "アーヤ", "text": "みやび、何で逢瀬さんを\n避難させなかったの？"},
        { "location": "719/Talk", "narrator": "アーヤ", "text": "しかもターゲットの\nど真ん中に\n連れて行くなんて。"},
        { "location": "720/Talk", "narrator": "みやび", "text": "いやー、ここは\nつばめちゃんに\n賭けてみたき。"},
        { "location": "721/Talk", "narrator": "みやび", "text": "ごっついミラクル\n起こせちゃあ\nせんかいね？　って。"},
        { "location": "722/Talk", "narrator": "つばめ", "text": "わたし、無茶振り\nされてたっ！？"},
        { "location": "723/Talk", "narrator": "みやび", "text": "はい、ここで大きく\n振りかぶってー。"},
        { "location": "724/Talk", "narrator": "みやび", "text": "って、こんなん\n予想つくわけ\nないやか！"},
        { "location": "725/Talk", "narrator": "みやび", "text": "おんしも予想外\nやったやろ？"},
        { "location": "726/Talk", "narrator": "アーヤ", "text": "そうだ。\nごめんなさい、\n逢瀬さん。"},
        { "location": "727/Talk", "narrator": "つばめ", "text": "ふえ？\n何のことですか？"},
        { "location": "728/Talk", "narrator": "つばめ", "text": "……まさかわたしが\n気づかない内に\nいたずらを……？"},
        { "location": "729/Talk", "narrator": "アーヤ", "text": "違うわよっ！"},
        { "location": "730/Talk", "narrator": "アーヤ", "text": "この時、逢瀬さんを\n助けに行けなくて\n本当にごめんなさい。"},
        { "location": "731/Talk", "narrator": "ガブリエラ", "text": "でも、こんな状況で\n助けに行けるのって\nみやびくらいだし。"},
        { "location": "732/Talk", "narrator": "みやび", "text": "おぉーっと、\nうちに飛び火した？"},
        { "location": "733/Talk", "narrator": "みやび", "text": "うちが飛べる言うても\n視界が確保できない\n状況やとねぇ……。"},
        { "location": "734/Talk", "narrator": "つばめ", "text": "いえ、こんな状況じゃ\n誰も悪くなかったと\n思います。"},
        { "location": "735/Talk", "narrator": "つばめ", "text": "わたしなんて\nメノウちゃんに痛い\n思いさせちゃったし。"},
        { "location": "736/Talk", "narrator": "ガブリエラ", "text": "新人、あんな高い所\nから豪快に落ちて\n大丈夫だったわけ？"},
        { "location": "737/Talk", "narrator": "つばめ", "text": "ん～……わたしって結構\n丈夫だったんですかね？"},
        { "location": "738/Talk", "narrator": "みやび", "text": "プライムなわけやし、\n多少はあるかもなぁ。\nどうなんやろね。"},
        { "location": "739/Talk", "narrator": "アーヤ", "text": "とにかく\n大した怪我が無くて\nよかったわ。"},
        { "location": "740/Talk", "narrator": "みやび", "text": "はい、ここ！\nドーンっ！！"},
        { "location": "741/Talk", "narrator": "つばめ", "text": "わわわわわっ！\nここで止めないで\nくださいよっ！"},
        { "location": "742/Talk", "narrator": "つばめ", "text": "思い出しただけで\n痛くなって\nきちゃいます……。"},
        { "location": "743/Talk", "narrator": "ガブリエラ", "text": "むしろ、痛い程度で\n済んでるのねって\n感じなんだけど。"},
        { "location": "744/Talk", "narrator": "みやび", "text": "せやで。\nこれ絶対死んでる\nパターンやよ。"},
        { "location": "745/Talk", "narrator": "つばめ", "text": "うぅぅ～……。"},
        { "location": "746/Talk", "narrator": "アーヤ", "text": "はい、続けましょう。"},
        { "location": "747/Talk", "narrator": "つばめ", "text": "え、え～と……一応、\n語っておいた方が\nいいですか？"},
        { "location": "748/Talk", "narrator": "つばめ", "text": "あんまりハッキリとは\n憶えてないけど、\nすっごい痛かったよ？"},
        { "location": "749/Talk", "narrator": "ガブリエラ", "text": "そりゃそうでしょ。"},
        { "location": "750/Talk", "narrator": "つばめ", "text": "それで、意識が段々と\n霞んでいって……。\n後は憶えてなくて。"},
        { "location": "751/Talk", "narrator": "みやび", "text": "そんな中でも\nまだメノウのこと\n心配とるんやねえ。"},
        { "location": "752/Talk", "narrator": "みやび", "text": "ほんまどんだけ\nメノウ好きなんや。"},
        { "location": "753/Talk", "narrator": "つばめ", "text": "えへへ～♪"},
        { "location": "754/Talk", "narrator": "ガブリエラ", "text": "いやそこ\nテレるトコじゃ\nないから。"},
        { "location": "755/Talk", "narrator": "つばめ", "text": "ああ～っ……。\nわたし、ここに死す！\nってのですか、これ？"},
        { "location": "756/Talk", "narrator": "アーヤ", "text": "逢瀬さんも今になって\n自分で茶化せるくらい\nになったからいいけど。"},
        { "location": "757/Talk", "narrator": "アーヤ", "text": "こっちとしては正に\n戦慄が走ったわ。"},
        { "location": "758/Talk", "narrator": "みやび", "text": "作戦で人死にが出ると\n調書やら始末書やら\nどーんと増えるきね。"},
        { "location": "759/Talk", "narrator": "アーヤ", "text": "そういう問題じゃ\nなくて！"},
        { "location": "760/Talk", "narrator": "アーヤ", "text": "だから一刻も早く\n収束させないとって\n本当に必死だったの。"},
        { "location": "761/Talk", "narrator": "みやび", "text": "つまり、この発症者の\n強さは桁外れだった\nわけやね。"},
        { "location": "762/Talk", "narrator": "みやび", "text": "ここでうちらが\n本気モードにならんと\nあかんくらいには。"},
        { "location": "763/Talk", "narrator": "ガブリエラ", "text": "ところでみやびは\nこういうの見せても\n何ともないの？"},
        { "location": "764/Talk", "narrator": "みやび", "text": "減るモンやないし、\nよう見たってやって\nくらいや。"},
        { "location": "765/Talk", "narrator": "みやび", "text": "それに、ここでうちが\nシールド張らんと\nみんな終了やったき。"},
        { "location": "766/Talk", "narrator": "アーヤ", "text": "確かに。私もちょっと\nこの時は焦りから\n無鉄砲過ぎたわ。"},
        { "location": "767/Talk", "narrator": "アーヤ", "text": "体を張ってくれた\nみやびに\n感謝しなきゃね。"},
        { "location": "768/Talk", "narrator": "みやび", "text": "うちのサービスシーン\nどうやった？"},
        { "location": "769/Talk", "narrator": "みやび", "text": "なんなら毎回\nサービスしたっても\nええんよ？"},
        { "location": "770/Talk", "narrator": "みやび", "text": "期待しとっとき～。"}
    ]
}
