{
    "dir": "stream_180_ch016ACTOnCancel.json",
    "type": "watchanime",
    "info": {
    },
    "entry":
    [
        { "location": "3743/Talk", "narrator": "つばめ", "text": "…………あっ、\nご、ごめんなさいっ！"},
        { "location": "3744/Talk", "narrator": "つばめ", "text": "なんて言っていいのか\nまとまらなくて……。"},
        { "location": "3745/Talk", "narrator": "つばめ", "text": "だから思ってること\nそのまま言わせて\nもらいますね……。"},
        { "location": "3746/Talk", "narrator": "つばめ", "text": "あ、あのですね、\n最初におことわり\nさせてくださいっ！"},
        { "location": "3747/Talk", "narrator": "つばめ", "text": "あ、いえ、何かを\n断るんじゃなくて、\nお知らせというか。"},
        { "location": "3748/Talk", "narrator": "つばめ", "text": "えーとですね……。"},
        { "location": "3749/Talk", "narrator": "つばめ", "text": "今回だけはわたし\n一人だけで\n観たかったから、"},
        { "location": "3750/Talk", "narrator": "つばめ", "text": "みんなには\nごめんなさいして\nもらいました。"},
        { "location": "3751/Talk", "narrator": "つばめ", "text": "だから、その、\nみんなと見たかった\nあなたにも、"},
        { "location": "3752/Talk", "narrator": "つばめ", "text": "ほ、本当に、本当に\nごめんなさいっ！"},
        { "location": "3753/Talk", "narrator": "つばめ", "text": "え、えーと、じゃあ、\n二人きりですけど\n見ましょうか？"},
        { "location": "3754/Talk", "narrator": "つばめ", "text": "あっ、ごめんなさい。\n黙ったままで。\nでも……。"},
        { "location": "3755/Talk", "narrator": "つばめ", "text": "……ううん、\nわたしだけなんだから\nちゃんとしないと。"},
        { "location": "3756/Talk", "narrator": "つばめ", "text": "神楽ちゃん、わたしが\n知らない所で色々と\nつらいこと抱えていた。"},
        { "location": "3757/Talk", "narrator": "つばめ", "text": "どうして気づいて\nあげられなかった\nのかな……。"},
        { "location": "3758/Talk", "narrator": "つばめ", "text": "$handle$さんは\n知ってたの？"},
        { "location": "3759/Talk", "narrator": "つばめ", "text": "でも、気づいてても\n何も出来なかったかも\n知れないし……。"},
        { "location": "3760/Talk", "narrator": "つばめ", "text": "やっぱりわたしって\nダメだなぁ……。"},
        { "location": "3761/Talk", "narrator": "つばめ", "text": "メノウちゃん\nだったことも\n知らなかったし。"},
        { "location": "3762/Talk", "narrator": "つばめ", "text": "もちろん神楽ちゃんが\n言いたくなかったって\nことはわかってるけど"},
        { "location": "3763/Talk", "narrator": "つばめ", "text": "でもやっぱりわたしが\n気づけなかったのが\nダメなんだよね……。"},
        { "location": "3764/Talk", "narrator": "つばめ", "text": "わたし、いつも鈍くて\nだからお友達だって\nできなくて。"},
        { "location": "3765/Talk", "narrator": "つばめ", "text": "神楽ちゃんとも\nもうこれで、おしまい\nなのかなぁ……。"},
        { "location": "3766/Talk", "narrator": "つばめ", "text": "$handle$さんは\nどう思う？"},
        { "location": "3767/Talk", "narrator": "つばめ", "text": "でもやっぱり\nわたしがもっと\nしっかりしてれば"},
        { "location": "3768/Talk", "narrator": "つばめ", "text": "神楽ちゃんがあんな\n目にはあわなかった\nのかもって。"},
        { "location": "3769/Talk", "narrator": "つばめ", "text": "やっぱりわたしじゃ\nなんの力にも\nなれないよ……。"},
        { "location": "3770/Talk", "narrator": "つばめ", "text": "だから\n$handle$さん\nお願い。"},
        { "location": "3771/Talk", "narrator": "つばめ", "text": "私の代わりに\n神楽ちゃんを\n助けてあげて。"},
        { "location": "3772/Talk", "narrator": "つばめ", "text": "わたしじゃ\nダメだから……。"},
        { "location": "3773/Talk", "narrator": "つばめ", "text": "わたしじゃ何も\nできないから……。"},
        { "location": "3774/Talk", "narrator": "つばめ", "text": "……そうだよね。\nみんな知らなかった\nみたいだし……。"},
        { "location": "3775/Talk", "narrator": "つばめ", "text": "そっかぁ……。\nなのにわたしったら\n全然ダメで……。"},
        { "location": "3776/Talk", "narrator": "つばめ", "text": "そう……だよね……。\nもう手遅れだね……。"},
        { "location": "3777/Talk", "narrator": "つばめ", "text": "そう……かな……？\nまだ間に合うのかな？"},
        { "location": "3778/Talk", "narrator": "つばめ", "text": "そ……そうかも\n知れないけど、\nだって……。"},
        { "location": "3779/Talk", "narrator": "つばめ", "text": "でも、だとしたって、\nつらいのはつらいし\nどうすればいいの？"},
        { "location": "3780/Talk", "narrator": "つばめ", "text": "わたしが……？\n神楽ちゃんのために？"},
        { "location": "3781/Talk", "narrator": "つばめ", "text": "でも、何の助けにも\nなってなかったら\n意味無いよ……。"},
        { "location": "3782/Talk", "narrator": "つばめ", "text": "本当にあったのかな？\nわたしには全然そうは\n思えなくて……。"},
        { "location": "3783/Talk", "narrator": "つばめ", "text": "意味があるとかじゃ\n無いってこと？\nでも……。"},
        { "location": "3784/Talk", "narrator": "つばめ", "text": "わたしだって\nそう思いたいけど\nだけど……。"},
        { "location": "3785/Talk", "narrator": "神楽", "text": "あっ、上手いこと\n言いますね！\n座布団１０枚です！"},
        { "location": "3786/Talk", "narrator": "神楽", "text": "つまりこれも愛の\n一種だということは\n認めるんですね？"},
        { "location": "3787/Talk", "narrator": "神楽", "text": "ですよね！\nこれが普通に母と子の\n日常的な姿ですよ！"},
        { "location": "3788/Talk", "narrator": "神楽", "text": "母から子への愛は\nパンチの強さで決まる\nって言いますし。"},
        { "location": "3789/Talk", "narrator": "神楽", "text": "愛の強い母ほど笑顔は\n優しくて、パンチは\n厳しいものなんです。"},
        { "location": "3790/Talk", "narrator": "神楽", "text": "えーっ！\nしないんですか？\nおかしいですねっ。"},
        { "location": "3791/Talk", "narrator": "神楽", "text": "母から子への愛は\nパンチの強さで決まる\nって言いますから、"},
        { "location": "3792/Talk", "narrator": "神楽", "text": "それはきっと愛されて\nないんですよ。\n気をつけてください。"},
        { "location": "3793/Talk", "narrator": "神楽", "text": "パンチの強さは愛の\n強さって、自分で\n言ってて馬鹿みたい。"},
        { "location": "3794/Talk", "narrator": "神楽", "text": "戯言とか超越してる\nレベルで救いようが\n無いですよね……。"},
        { "location": "3795/Talk", "narrator": "神楽", "text": "って！　なんで\n撫でるんですか？\nやめてくださいよっ！"},
        { "location": "3796/Talk", "narrator": "神楽", "text": "私は撫でられるような\n良い子じゃなくて\n悪い子なんですから。"},
        { "location": "3797/Talk", "narrator": "神楽", "text": "……でも、なぜか\n落ち着くので今だけは\n感謝しておきますね。"},
        { "location": "3798/Talk", "narrator": "神楽", "text": "……ありがとう。"},
        { "location": "3799/Talk", "narrator": "神楽", "text": "りみった"},
        { "location": "3800/Talk", "narrator": "神楽", "text": "もしかしたら貴方が\n私と共に歩む日が\n来るかも知れません。"},
        { "location": "3801/Talk", "narrator": "神楽", "text": "そうなることを私は\n願っています……。"},
        { "location": "3802/Talk", "narrator": "神楽", "text": "本当ですよ？"},
        { "location": "3803/Talk", "narrator": "つばめ", "text": "わたしだって\n諦めたくない……。\nないよ……。"},
        { "location": "3804/Talk", "narrator": "神楽", "text": "つ～ばめさんっ♪"},
        { "location": "3805/Talk", "narrator": "つばめ", "text": "か、神楽ちゃんっ！？"},
        { "location": "3806/Talk", "narrator": "神楽", "text": "も～。一人でコッソリ\n鑑賞してるなんて\n酷いですっ。"},
        { "location": "3807/Talk", "narrator": "神楽", "text": "どうして私を\n誘ってくれなかった\nんですか？"},
        { "location": "3808/Talk", "narrator": "つばめ", "text": "えっ、で、でも、\nだって今回は……。"},
        { "location": "3809/Talk", "narrator": "神楽", "text": "でもここからは\n二人っきりで鑑賞会\nできて嬉しいです♪"},
        { "location": "3810/Talk", "narrator": "神楽", "text": "ええ、画面の向こうの\n誰かさんも「ここ」\nにはいませんからね！"},
        { "location": "3811/Talk", "narrator": "神楽", "text": "あ、一応紹介します。\nこれうちの母ですけど\n興味無いですよね？"},
        { "location": "3812/Talk", "narrator": "つばめ", "text": "神楽ちゃん、ここから\n大変だったのになんで\nそんな脳天気に……。"},
        { "location": "3813/Talk", "narrator": "神楽", "text": "うちの母、なかなか\nワイルドですよね！"},
        { "location": "3814/Talk", "narrator": "つばめ", "text": "ワイルドなんてレベル\nじゃないと\n思うんだけど……。"},
        { "location": "3815/Talk", "narrator": "神楽", "text": "愛ですよ。母の愛。\nかなりイカした\n愛し方ですよね？"},
        { "location": "3816/Talk", "narrator": "つばめ", "text": "神楽ちゃん……。"},
        { "location": "3817/Talk", "narrator": "神楽", "text": "さぁ、ここからが\nイイ所ですよ。心の\n準備はいいですか？"},
        { "location": "3818/Talk", "narrator": "神楽", "text": "おおっと美佐子選手\nいきなりの\n張り手攻撃！"},
        { "location": "3819/Talk", "narrator": "神楽", "text": "神楽選手どうした？\nどうして反撃に\n出ないのかーっ！？"},
        { "location": "3820/Talk", "narrator": "神楽", "text": "おおっと、ここで\n神楽選手、遂に\n吐血かぁーっ！？"},
        { "location": "3821/Talk", "narrator": "神楽", "text": "どうしてまだ反撃\nしないのか、\nこれはで一方的だっ。"},
        { "location": "3822/Talk", "narrator": "神楽", "text": "神楽選手に一体何が\n起こっているのか\n目が離せないーっ！"},
        { "location": "3823/Talk", "narrator": "神楽", "text": "おおっと！？\n目が離せないどころか\n見せられない展開か？"},
        { "location": "3824/Talk", "narrator": "神楽", "text": "どうやら腹にキツい\n一発が入ったようだ。\n神楽選手、大丈夫か？"},
        { "location": "3825/Talk", "narrator": "神楽", "text": "つばめさん何でこの時\n早く帰れって言ったか\n真実を教えましょう！"},
        { "location": "3826/Talk", "narrator": "神楽", "text": "実はこれはプロレスで\n続きを観るにはＳ席の\nチケットが要ります。"},
        { "location": "3827/Talk", "narrator": "神楽", "text": "Ｓ席は１７５００円も\nするからつばめさん\nにはキツいかなーと。"},
        { "location": "3828/Talk", "narrator": "神楽", "text": "でも、これって\n普通ですよね？"},
        { "location": "3829/Talk", "narrator": "神楽", "text": "皆さんのお母さんも\n時々みぞおち決めたり\nしますよね？"},
        { "location": "3830/Talk", "narrator": "つばめ", "text": "あの、神楽ちゃん、\nもうそのくらいで\nいいから……。"},
        { "location": "3831/Talk", "narrator": "神楽", "text": "プロレスで本気で泣く\nなんて、つばめさんは\n本当に天然さんです♪"},
        { "location": "3832/Talk", "narrator": "神楽", "text": "もう、そんなところも\n可愛くて可愛くて\n私は大好きですよっ！"},
        { "location": "3833/Talk", "narrator": "つばめ", "text": "あ、ありがとう……。\nでもね、"},
        { "location": "3834/Talk", "narrator": "神楽", "text": "あっ！　ここからは\n真幌さんのカッコイイ\nシーンですねっ！"},
        { "location": "3835/Talk", "narrator": "神楽", "text": "やる時はやる真幌さん\nとてもカッコイイので\n私も見習いたいです！"},
        { "location": "3836/Talk", "narrator": "神楽", "text": "「殺る」書いて\n「やる」と読むって\n意味でも。"},
        { "location": "3837/Talk", "narrator": "つばめ", "text": "神楽ちゃんっ！？"},
        { "location": "3838/Talk", "narrator": "つばめ", "text": "え、えーと、なんだか\nとんでもないことに\nなっちゃいましたね。"},
        { "location": "3839/Talk", "narrator": "つばめ", "text": "でも神楽ちゃんが\n閉じこもらなくて\nよかったのかな？"},
        { "location": "3840/Talk", "narrator": "つばめ", "text": "これも怪我の功名？\nんー……なんか意味が\n違う気がする？"},
        { "location": "3841/Talk", "narrator": "つばめ", "text": "りみった"}
    ]
}
