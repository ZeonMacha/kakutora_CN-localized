{
    "dir": "stream_390_ch01.json",
    "type": "watchanime",
    "info": {
    },
    "entry":
    [
        { "location": "7693/Talk", "narrator": "神楽", "text": "つまり私と同盟を\n結びたいと？"},
        { "location": "7694/Talk", "narrator": "つばめ", "text": "一体なんの同盟なの！？"},
        { "location": "7695/Talk", "narrator": "神楽", "text": "それはですね！"},
        { "location": "7696/Talk", "narrator": "つばめ", "text": "あ、やっぱり聞きたくない\nから、いいや。"},
        { "location": "7697/Talk", "narrator": "神楽", "text": "放置プレイ！？"},
        { "location": "7698/Talk", "narrator": "神楽", "text": "それはつまり\n宣戦布告ですね？"},
        { "location": "7699/Talk", "narrator": "神楽", "text": "いいでしょう。貴方は\n元々敵でしたけど、\n今から完全に敵です！"},
        { "location": "7700/Talk", "narrator": "つばめ", "text": "わたし蚊帳の外なんだけど、\nいいのかな？"},
        { "location": "7701/Talk", "narrator": "ガブリエラ", "text": "いいわけないでしょ……。"},
        { "location": "7702/Talk", "narrator": "ガブリエラ", "text": "確かに、あたしたちの\nスキルが上がったから\nって考えもあるわね。"},
        { "location": "7703/Talk", "narrator": "つばめ", "text": "今までは本気で対処し\nていたフェノメノンが\n今では遊びのように？"},
        { "location": "7704/Talk", "narrator": "みやび", "text": "せや、かるーくプチィ\nできるようになった\nとも考えられる。"},
        { "location": "7705/Talk", "narrator": "アーヤ", "text": "そんなつもりは無くて\nただ疑問を投げかけた\nだけだってば。"},
        { "location": "7706/Talk", "narrator": "みやび", "text": "せや、アーヤみたいに\n常に疑心暗鬼なんも\n必要やき。"},
        { "location": "7707/Talk", "narrator": "アーヤ", "text": "必要悪みたいな言い方\nしないでよ！"},
        { "location": "7708/Talk", "narrator": "ガブリエラ", "text": "ていうかリーダーは\nそれでいいんじゃない？"},
        { "location": "7709/Talk", "narrator": "つばめ", "text": "皆さんに大変悲しい\nお知らせがあります。"},
        { "location": "7710/Talk", "narrator": "つばめ", "text": "なんと今回でこの和気\nあいあいとした時間は\n終了なんです。"},
        { "location": "7711/Talk", "narrator": "ガブリエラ", "text": "いや、それ前回で\nもう言ってるし。"},
        { "location": "7712/Talk", "narrator": "つばめ", "text": "最後ぐらい感動的な\n対談で締めようでは\nありませんか。"},
        { "location": "7713/Talk", "narrator": "つばめ", "text": "さぁ、\nトライナリー諸君よ！"},
        { "location": "7714/Talk", "narrator": "ガブリエラ", "text": "あんた誰よ！？"},
        { "location": "7715/Talk", "narrator": "ガブリエラ", "text": "ていうか、せめて全員出て\n来てから言いなさいよ。"},
        { "location": "7716/Talk", "narrator": "みやび", "text": "なんやうちら出ちょらん内\nに楽しそうな話しちょるや\nん。"},
        { "location": "7717/Talk", "narrator": "神楽", "text": "と言うかガブちゃんと\nつばめさんって\n仲良過ぎません？"},
        { "location": "7718/Talk", "narrator": "神楽", "text": "思わず消したく\nなっちゃいますよ？"},
        { "location": "7719/Talk", "narrator": "ガブリエラ", "text": "何を！？"},
        { "location": "7720/Talk", "narrator": "みやび", "text": "ちゅうか卯月、初っ端から\n出ちょっててええんか？"},
        { "location": "7721/Talk", "narrator": "神楽", "text": "はい、アーヤさんなら\n既に始末…いえ、話は\nつけてありますから。"},
        { "location": "7722/Talk", "narrator": "ガブリエラ", "text": "最終回だってのに\nいきなりイヤな予感\nしかしない……。"},
        { "location": "7723/Talk", "narrator": "神楽", "text": "最後だからってあまり\n意識し過ぎるのも\nよくないですよ。"},
        { "location": "7724/Talk", "narrator": "神楽", "text": "勿論、私は最後なので\nやりたい放題やらせて\nもらいますけど。"},
        { "location": "7725/Talk", "narrator": "ガブリエラ", "text": "自然体で\nダメなヤツだーっ！！"},
        { "location": "7726/Talk", "narrator": "みやび", "text": "うちかて負ける気は\nさらさら無いで？"},
        { "location": "7727/Talk", "narrator": "ガブリエラ", "text": "うん、真面目な最終回は\n諦めた方がいいみたいね\n……。"},
        { "location": "7728/Talk", "narrator": "みやび", "text": "ちゅうか知ってても\nいきなりここからって\nいうのは心臓に悪い。"},
        { "location": "7729/Talk", "narrator": "ガブリエラ", "text": "これ、千羽鶴は何が\n言いたかったんだろ。"},
        { "location": "7730/Talk", "narrator": "神楽", "text": "正解は、はい！\nつばめさん！"},
        { "location": "7731/Talk", "narrator": "つばめ", "text": "ええっ！？\nなんで、わたしーっ？"},
        { "location": "7732/Talk", "narrator": "ガブリエラ", "text": "だって千羽鶴って\nつばめから生まれた\nクランでしょ！"},
        { "location": "7733/Talk", "narrator": "つばめ", "text": "そんなこと言われても\nわたし生んだ憶え無いよー。"},
        { "location": "7734/Talk", "narrator": "神楽", "text": "つばめさん大丈夫。\n私は認知しますよ。"},
        { "location": "7735/Talk", "narrator": "みやび", "text": "旦那気取りかい！"},
        { "location": "7736/Talk", "narrator": "みやび", "text": "ここビックリしたわ。\nまほさんガチで殺る気\nマンマンやったのに。"},
        { "location": "7737/Talk", "narrator": "つばめ", "text": "全然違う人が\n撃ってたんですね。"},
        { "location": "7738/Talk", "narrator": "アーヤ", "text": "ほら！　やっぱり\nあの人、ぶっちした！\nぶっち大魔王なのよ！"},
        { "location": "7739/Talk", "narrator": "アーヤ", "text": "これで館長も私が普段\n言ってる事をわかって\nくれるようになるわ！"},
        { "location": "7740/Talk", "narrator": "みやび", "text": "アーヤ、普段まほさんに\nその件スルーされてて、\nよほど寂しかったんやね。"},
        { "location": "7741/Talk", "narrator": "ガブリエラ", "text": "べつにまほはアーヤの\n言うことを無視してた\nわけじゃないでしょ。"},
        { "location": "7742/Talk", "narrator": "ガブリエラ", "text": "そんなこと言われなく\nてもわかってた、って\nことじゃない？"},
        { "location": "7743/Talk", "narrator": "アーヤ", "text": "わ、私が寂しん坊の\n駄々っ子みたいに\n言わないでよっ！"},
        { "location": "7744/Talk", "narrator": "アーヤ", "text": "と、とにかく、安易に\nあの人を信じちゃ\nダメだから！　以上！"},
        { "location": "7745/Talk", "narrator": "神楽", "text": "よくわからないので\n先に進めましょうか。"},
        { "location": "7746/Talk", "narrator": "神楽", "text": "さぁ、今回も\nやって参りましたよ！"},
        { "location": "7747/Talk", "narrator": "神楽", "text": "クイズ！　どっちの\nイントロでドーン！"},
        { "location": "7748/Talk", "narrator": "みやび", "text": "まーた恥ずかしさ\n誤魔化すために話逸ら\nそうと必死過ぎやき。"},
        { "location": "7749/Talk", "narrator": "みやび", "text": "そもそも何のクイズか\n全然わからんよそれ。"},
        { "location": "7750/Talk", "narrator": "つばめ", "text": "でもわたし神楽ちゃんの\nこの想いを聞いて、\nとっても嬉しかった。"},
        { "location": "7751/Talk", "narrator": "つばめ", "text": "やっぱり神楽ちゃんは\nわたしの大切な友達\nだなぁって思ったよ。"},
        { "location": "7752/Talk", "narrator": "ガブリエラ", "text": "なんていうか、とっても\n強い絆を感じたんだ。"},
        { "location": "7753/Talk", "narrator": "みやび", "text": "……卯月？\n呆然としてどうしたん？"},
        { "location": "7754/Talk", "narrator": "ガブリエラ", "text": "まさか、あまりの恥ずか\nしさに放心してる！？"},
        { "location": "7755/Talk", "narrator": "ガブリエラ", "text": "……卯月って、案外\nそういう耐性は無いのね。"},
        { "location": "7756/Talk", "narrator": "みやび", "text": "いや、卯月のそういう\n気持ち、うちはようわかる！"},
        { "location": "7757/Talk", "narrator": "みやび", "text": "これでうちと卯月は\n完全に同じ人種やと\nハッキリしたきに！"},
        { "location": "7758/Talk", "narrator": "ガブリエラ", "text": "どうでもいいけど、\n体つきに関しては\n全く別の生き物よね。"},
        { "location": "7759/Talk", "narrator": "神楽", "text": "それをガブちゃんが\n言いますか！？"},
        { "location": "7760/Talk", "narrator": "神楽", "text": "一つか二つカップが\n上だからって\n調子こいてますね！"},
        { "location": "7761/Talk", "narrator": "みやび", "text": "うちがナイスバディ\n過ぎるせいで卯月が\n辛い思いを……。"},
        { "location": "7762/Talk", "narrator": "神楽", "text": "みやびさんも、それ\nさりげなく追い討ち\nですから……。"},
        { "location": "7763/Talk", "narrator": "みやび", "text": "これ目を閉じさせてる\nけど、要するに完全に\nつばめちゃん終了？"},
        { "location": "7764/Talk", "narrator": "つばめ", "text": "じゃあ今ここにいる\nわたしは一体\n何者なんですか！？"},
        { "location": "7765/Talk", "narrator": "ガブリエラ", "text": "ていうか神楽、珍しく\n真面目な顔してるじゃない。"},
        { "location": "7766/Talk", "narrator": "ガブリエラ", "text": "いつもならつばめさん\nお持ち帰りーとか\n言ってる頃なのに。"},
        { "location": "7767/Talk", "narrator": "神楽", "text": "私を何だと\n思ってるんですか！"},
        { "location": "7768/Talk", "narrator": "神楽", "text": "わたしだって決める時は\nキメるんです！"},
        { "location": "7769/Talk", "narrator": "神楽", "text": "大体このシーンは\nつばめさんが\n死んでるんですよ？"},
        { "location": "7770/Talk", "narrator": "神楽", "text": "そんな時に茶化せる\nほどフザケタ人生は\n送ってませんから！"},
        { "location": "7771/Talk", "narrator": "神楽", "text": "ああ、つばめさん、\nつばめさんが死んだら\n私、生きていけない…"},
        { "location": "7772/Talk", "narrator": "つばめ", "text": "あの……さっきから\nわたし死んだことに\nなってるんだけど……"},
        { "location": "7773/Talk", "narrator": "みやび", "text": "まぁ、それ言うたら\nつばめちゃん死ぬんは\nもう二度目やし。"},
        { "location": "7774/Talk", "narrator": "ガブリエラ", "text": "つまり神楽も、\n二度死ぬってこと？"},
        { "location": "7775/Talk", "narrator": "神楽", "text": "ああ、これが私と\nつばめさんとの永遠に\n続く輪転のさだめ……"},
        { "location": "7776/Talk", "narrator": "つばめ", "text": "……もう神楽ちゃんは\n放っておいていいんじゃ\nないかな？"},
        { "location": "7777/Talk", "narrator": "ガブリエラ", "text": "……ええ、そうみたいね。"},
        { "location": "7778/Talk", "narrator": "みやび", "text": "……奇遇やな。\nうちも賛成や。"},
        { "location": "7779/Talk", "narrator": "神楽", "text": "ああっ！\nここでつばめさんが\n元気だったら！"},
        { "location": "7780/Talk", "narrator": "つばめ", "text": "だったら？"},
        { "location": "7781/Talk", "narrator": "神楽", "text": "こうしてギュッと\n熱い抱擁をしたまま\nお持ち帰りするのに！"},
        { "location": "7782/Talk", "narrator": "ガブリエラ", "text": "やっぱり全然\n変わってないし！"},
        { "location": "7783/Talk", "narrator": "みやび", "text": "それにしても、この\nシーンを見てると感慨\n深いものがある。"},
        { "location": "7784/Talk", "narrator": "つばめ", "text": "本当に終わりなんだ\nなぁって寂しくなって\nくるよね……。"},
        { "location": "7785/Talk", "narrator": "ガブリエラ", "text": "神楽の朗読もなんだか\nグッとくるわね。"},
        { "location": "7786/Talk", "narrator": "神楽", "text": "いやそこは\nスルー推奨ですよ？"},
        { "location": "7787/Talk", "narrator": "アーヤ", "text": "感情移入した映画とか\nだと完全に脳が別世界\nに飛んでくわよね。"},
        { "location": "7788/Talk", "narrator": "アーヤ", "text": "特に、こんな風なエン\nディング付近になると。"},
        { "location": "7789/Talk", "narrator": "アーヤ", "text": "映画館から出ると音も\n風も光も全てが新鮮で\n輝いてるっていうか。"},
        { "location": "7790/Talk", "narrator": "みやび", "text": "それは「綺麗な私」\nってやつやね。"},
        { "location": "7791/Talk", "narrator": "アーヤ", "text": "そう、綺麗な私になれるの。"},
        { "location": "7792/Talk", "narrator": "アーヤ", "text": "なんかそんな不思議な\n感覚がない？　映画って。"},
        { "location": "7793/Talk", "narrator": "ガブリエラ", "text": "同意はするけど、唐突に\n出て来て語り出してどう\nしたの？"},
        { "location": "7794/Talk", "narrator": "アーヤ", "text": "最後なんだから\n私にだって語らせて！"},
        { "location": "7795/Talk", "narrator": "アーヤ", "text": "そもそも何でこれ\n同時に四人までしか\n出られないの？"},
        { "location": "7796/Talk", "narrator": "アーヤ", "text": "仕様書いた責任者に\n出て来て釈明して\n欲しいわよね。"},
        { "location": "7797/Talk", "narrator": "ガブリエラ", "text": "そんなこと最後になって\n言われても……。"},
        { "location": "7798/Talk", "narrator": "みやび", "text": "むしろ最後やから溜め\n込んどったのぶちまけ\nてるんと違う？"},
        { "location": "7799/Talk", "narrator": "アーヤ", "text": "そういうわけで\nまた一旦下がるわね。"},
        { "location": "7800/Talk", "narrator": "神楽", "text": "なんですかここは！？\n桃源郷ですか！？"},
        { "location": "7801/Talk", "narrator": "ガブリエラ", "text": "神楽は神楽で最後まで\n相変わらずよね……。"},
        { "location": "7802/Talk", "narrator": "みやび", "text": "まさか最終回までその\nネタを出してくるとは\n思わんかったわ。"},
        { "location": "7803/Talk", "narrator": "神楽", "text": "何言ってるんですか、\nここ、この作品で最も\n尊いシーンですよ！"},
        { "location": "7804/Talk", "narrator": "みやび", "text": "まぁ、確かに、ここの\nシーンは尊い。"},
        { "location": "7805/Talk", "narrator": "みやび", "text": "特に詩の内容が\nもうホント尊過ぎる。"},
        { "location": "7806/Talk", "narrator": "神楽", "text": "ですよね！！"},
        { "location": "7807/Talk", "narrator": "つばめ", "text": "どうしよう、結局\n最後までこのノリには\nついていけない……。"},
        { "location": "7808/Talk", "narrator": "ガブリエラ", "text": "むしろそれが正常だから、\n気にしたら負けよ。"},
        { "location": "7809/Talk", "narrator": "神楽", "text": "キターーーーーッ！！"},
        { "location": "7810/Talk", "narrator": "神楽", "text": "って、あああああっ！\n何やってるんですか\n私ッ！"},
        { "location": "7811/Talk", "narrator": "神楽", "text": "どうしてそこで止まるのか\n理解出来ません！！"},
        { "location": "7812/Talk", "narrator": "つばめ", "text": "わたしは神楽ちゃんが\n何を言ってるのか\n理解したくないよ！"},
        { "location": "7813/Talk", "narrator": "みやび", "text": "ここ、つばめちゃんに\n神楽がキスするんやと\n期待しちょったのに。"},
        { "location": "7814/Talk", "narrator": "ガブリエラ", "text": "ええ、正直、見てて\nヒヤヒヤしたわ。"},
        { "location": "7815/Talk", "narrator": "神楽", "text": "ひやひやって表現、\n間違ってませんか？\nドキドキですよね？"},
        { "location": "7816/Talk", "narrator": "神楽", "text": "おっと、貴方に\n構ってる場合では\nありませんでした！"},
        { "location": "7817/Talk", "narrator": "神楽", "text": "今からでも遅くありま\nせん。ファイト神楽！\nファイトーーっ！！"},
        { "location": "7818/Talk", "narrator": "神楽", "text": "あと１０ｃｍ！\nあと１０ｃｍ！\nあと１０ｃｍ！"},
        { "location": "7819/Talk", "narrator": "つばめ", "text": "えーと……本当に今回が\n最終回なの？"},
        { "location": "7820/Talk", "narrator": "つばめ", "text": "最終回だとしても\nこれでいいの？"},
        { "location": "7821/Talk", "narrator": "みやび", "text": "遂につばめちゃんが\nマジレスを！？"},
        { "location": "7822/Talk", "narrator": "神楽", "text": "きゃーーーっ！\nつばめさん大胆です！"},
        { "location": "7823/Talk", "narrator": "ガブリエラ", "text": "つばめの方が神楽より\n一枚上手だったって\nことかしら。"},
        { "location": "7824/Talk", "narrator": "みやび", "text": "むしろ卯月って実は\n口だけのヘタレなの\nでは疑惑発生。"},
        { "location": "7825/Talk", "narrator": "神楽", "text": "うっ……。\nそ、そんなこと\nありませんよ？"},
        { "location": "7826/Talk", "narrator": "ガブリエラ", "text": "でも割といつもつばめの\n方が積極的じゃない？"},
        { "location": "7827/Talk", "narrator": "みやび", "text": "それな。正論。"},
        { "location": "7828/Talk", "narrator": "みやび", "text": "衝撃！\n実は「かぐつば」じゃなく\n「つばかぐ」だった！"},
        { "location": "7829/Talk", "narrator": "みやび", "text": "ちゅうこっちゃね。"},
        { "location": "7830/Talk", "narrator": "神楽", "text": "私はそれでも一向に\n構いませんし、むしろ\nイイくらいですよ？"},
        { "location": "7831/Talk", "narrator": "つばめ", "text": "さっきからみんなが\n何を言ってるのか全然\n理解したくないよ！"},
        { "location": "7832/Talk", "narrator": "みやび", "text": "しっかし頭貫いても\n生きてられるとは\n人間やないな。"},
        { "location": "7833/Talk", "narrator": "ガブリエラ", "text": "ていうか千羽鶴は元々\n人間じゃないし。"},
        { "location": "7834/Talk", "narrator": "みやび", "text": "しかしこれ、本当に\nまほさんが言う通りの\n理由なのかね。"},
        { "location": "7835/Talk", "narrator": "神楽", "text": "良い話っぽいこと\n言ってるけど割と\nぶん投げてますよね。"},
        { "location": "7836/Talk", "narrator": "つばめ", "text": "え？　え？\nすごく良いこと言ってると\n思ってたのに。"},
        { "location": "7837/Talk", "narrator": "神楽", "text": "あ、ここ真面目に\n聞かなくていいです。\n的外れな解説です。"},
        { "location": "7838/Talk", "narrator": "みやび", "text": "恥ずかしくなると\n神楽はすぐそうやって\n誤魔化すんやな。"},
        { "location": "7839/Talk", "narrator": "ガブリエラ", "text": "そうよね。\n結局、何も解決してない。"},
        { "location": "7840/Talk", "narrator": "ガブリエラ", "text": "スタート地点に\n戻っただけでしょ？"},
        { "location": "7841/Talk", "narrator": "ガブリエラ", "text": "これからどうなるんだろ。"},
        { "location": "7842/Talk", "narrator": "みやび", "text": "つまり本当の黒幕は\nまだいる言うことか。"},
        { "location": "7843/Talk", "narrator": "ガブリエラ", "text": "千羽鶴を撃ったのだって、\nどうせそいつの差し金で\nしょ？"},
        { "location": "7844/Talk", "narrator": "みやび", "text": "おぉ、こわっ。\nうちら消されんで\nよかったわ～。"},
        { "location": "7845/Talk", "narrator": "ガブリエラ", "text": "そのかわり一度死んでたり\nしたけどねー。"},
        { "location": "7846/Talk", "narrator": "みやび", "text": "うむ、臨死体験について、\nちゃんと記録しとけばよ\nかったぞね。"},
        { "location": "7847/Talk", "narrator": "つばめ", "text": "きゃーっ！\nメノウちゃーんっ！！"},
        { "location": "7848/Talk", "narrator": "ガブリエラ", "text": "まぁ……、\n今回だけは許そっか。"},
        { "location": "7849/Talk", "narrator": "みやび", "text": "もうこれエンディング\nやしね。"},
        { "location": "7850/Talk", "narrator": "神楽", "text": "んー、逆に何か\n調子狂いますね……。\nちょっと交代します。"},
        { "location": "7851/Talk", "narrator": "アーヤ", "text": "もう卯月ったら、\n恥ずかしくなると\nすぐ交代するんだから。"},
        { "location": "7852/Talk", "narrator": "ガブリエラ", "text": "みやびも大変ね。"},
        { "location": "7853/Talk", "narrator": "ガブリエラ", "text": "ああっ！\nここは飛ばして飛ばして！"},
        { "location": "7854/Talk", "narrator": "つばめ", "text": "いいじゃない。\nよく似合ってるよ、\nガブちゃんの人形劇。"},
        { "location": "7855/Talk", "narrator": "みやび", "text": "そやそや。\nそない恥ずかし\nがらんでもなぁ。"},
        { "location": "7856/Talk", "narrator": "みやび", "text": "恥ずかしがるんも若い\n内だけやき。歳とると\n気にしなくなるんや。"},
        { "location": "7857/Talk", "narrator": "アーヤ", "text": "それってもしかして\n私のこと言ってる！？"},
        { "location": "7858/Talk", "narrator": "みやび", "text": "そういえばこの男共は\nいつの間にかナチュラ\nルにモブ化しとるな。"},
        { "location": "7859/Talk", "narrator": "アーヤ", "text": "って思うでしょ？\nでも最後に……。"},
        { "location": "7860/Talk", "narrator": "みやび", "text": "え？　最後に何！？\n死亡フラグ！？"},
        { "location": "7861/Talk", "narrator": "アーヤ", "text": "それはＣＭの後で！"},
        { "location": "7862/Talk", "narrator": "みやび", "text": "えーっ、しょっぱいわー。"},
        { "location": "7863/Talk", "narrator": "ガブリエラ", "text": "って、みやびが\n掃除してる！？"},
        { "location": "7864/Talk", "narrator": "ガブリエラ", "text": "今回は一体何を\nやらかしたの！？"},
        { "location": "7865/Talk", "narrator": "みやび", "text": "なんでそういう解釈に\nなる！？　短絡的過ぎや。"},
        { "location": "7866/Talk", "narrator": "ガブリエラ", "text": "だってこれって\n罰掃除でしょ？"},
        { "location": "7867/Talk", "narrator": "みやび", "text": "他の可能性は考えないの\nかねチミは。"},
        { "location": "7868/Talk", "narrator": "ガブリエラ", "text": "みやびじゃ無理ね。"},
        { "location": "7869/Talk", "narrator": "みやび", "text": "ぬぅ……今回は事実やき、\n勘弁しちょいたるわ。"},
        { "location": "7870/Talk", "narrator": "つばめ", "text": "やっぱり罰掃除じゃない\nですか！"},
        { "location": "7871/Talk", "narrator": "アーヤ", "text": "というか、やっぱり\nフェノメノンは発生\nするのよね。"},
        { "location": "7872/Talk", "narrator": "アーヤ", "text": "つまり千羽鶴が発生させ\nてたわけじゃないってこ\nとね。"},
        { "location": "7873/Talk", "narrator": "ガブリエラ", "text": "歴史は繰り返すって？\nこれじゃ結局解決して\nないじゃないの。"},
        { "location": "7874/Talk", "narrator": "みやび", "text": "うちら真面目に婆に\nなるまでトライナリー\nやるのかもしれん。"},
        { "location": "7875/Talk", "narrator": "アーヤ", "text": "でもあれよね、冷静な\nツッコミ入れていい？"},
        { "location": "7876/Talk", "narrator": "みやび", "text": "嫌な予感しかしないけんど\nどうぞどうぞ。"},
        { "location": "7877/Talk", "narrator": "アーヤ", "text": "今までの記録映像だと\nフェノメノンは緊迫し\nた状況だったわよね？"},
        { "location": "7878/Talk", "narrator": "アーヤ", "text": "……まぁ、例外的な時も\nあったことはあったけど\n……。"},
        { "location": "7879/Talk", "narrator": "つばめ", "text": "アーヤさんたちが魔法少女\nになった時ですね！"},
        { "location": "7880/Talk", "narrator": "アーヤ", "text": "え、ええ、とりあえず\nそれは置いといて……。"},
        { "location": "7881/Talk", "narrator": "アーヤ", "text": "この映像、フェノメノンで\n出動するのに遊びにでも\n行くようなノリでしょ？"},
        { "location": "7882/Talk", "narrator": "アーヤ", "text": "これってフェノメノン\nが普通に日常化してる\nってことじゃない？"},
        { "location": "7883/Talk", "narrator": "アーヤ", "text": "つまり状況は過酷に\nなってるってこと\nなんじゃないの？"},
        { "location": "7884/Talk", "narrator": "アーヤ", "text": "何だかこれじゃあ私が\n揚げ足取りしてる\nみたいじゃない……。"},
        { "location": "7885/Talk", "narrator": "みやび", "text": "え？　なに！？\nちょっと男子ー！"},
        { "location": "7886/Talk", "narrator": "みやび", "text": "もしかして一緒に\nフェノメノンに入れる\nようになったんか？"},
        { "location": "7887/Talk", "narrator": "つばめ", "text": "これってすごくないですか？"},
        { "location": "7888/Talk", "narrator": "アーヤ", "text": "ええ、これが先刻の\n伏線だったわけね。\n正に大出世だわ。"},
        { "location": "7889/Talk", "narrator": "みやび", "text": "まさかまさかのＥＤロール\n中に新たな展開！"},
        { "location": "7890/Talk", "narrator": "みやび", "text": "どこまで引っ張る\nこのストーリー！"},
        { "location": "7891/Talk", "narrator": "ガブリエラ", "text": "楽しそうで何よりね、\nみやび……。"},
        { "location": "7892/Talk", "narrator": "みやび", "text": "とか冷めた風に言うて\nホントはガブちゃん\n嬉しいくせに～。"},
        { "location": "7893/Talk", "narrator": "ガブリエラ", "text": "そそそ、そんなわけ\nないでしょっ！"},
        { "location": "7894/Talk", "narrator": "つばめ", "text": "さすがガブちゃん、\n正統派のツンデレだね♪"},
        { "location": "7895/Talk", "narrator": "みやび", "text": "そしてこの「うちらの\n戦いはこれからだ！」\n感！　すごいっすわ。"},
        { "location": "7896/Talk", "narrator": "アーヤ", "text": "ちょっと、みやび！\nそれ言っていいこと\nなの！？"},
        { "location": "7897/Talk", "narrator": "ガブリエラ", "text": "ていうか最後の最後\nまで結局このコーナー\nｇｄｇｄよね。"},
        { "location": "7898/Talk", "narrator": "つばめ", "text": "はい、このコーナーの\n存在意義が\n大ピンチです！"},
        { "location": "7899/Talk", "narrator": "みやび", "text": "言うてももうこれで\n最終回やし。"},
        { "location": "7900/Talk", "narrator": "アーヤ", "text": "ダメよ、みやび。\n終わりよければ\n全てよし。"},
        { "location": "7901/Talk", "narrator": "アーヤ", "text": "逆に言えば終わりが\nダメだと全部ご破算よ。\n最後はシメないと。"},
        { "location": "7902/Talk", "narrator": "みやび", "text": "そしたら最後くらいは\n最後らしく、一人ずつ\nキチッと締めてこか。"},
        { "location": "7903/Talk", "narrator": "みやび", "text": "まずはうちからいこかね。"},
        { "location": "7904/Talk", "narrator": "みやび", "text": "最後や言うちょるけど\n他の媒体とかでまた\n会うに決まっちょる。"},
        { "location": "7905/Talk", "narrator": "みやび", "text": "だから悲しんだら\nいかんし、希望は\n持ち続けるんやよー。"},
        { "location": "7906/Talk", "narrator": "ガブリエラ", "text": "初っ端からぶっ込んで\nきたわね……。"},
        { "location": "7907/Talk", "narrator": "みやび", "text": "インパクトは最初が肝心。\n早いもん勝ちやきね。"},
        { "location": "7908/Talk", "narrator": "ガブリエラ", "text": "仕方ないわね。\nじゃあ、次はあたしね。"},
        { "location": "7909/Talk", "narrator": "ガブリエラ", "text": "うん、みやびも言ってたけ\nど、きっとまた会うでしょ。"},
        { "location": "7910/Talk", "narrator": "ガブリエラ", "text": "ていうか、これでバイバイ\nとか認めないから！"},
        { "location": "7911/Talk", "narrator": "ガブリエラ", "text": "だから、まぁ、待ってたら\nイイことあるかもね？"},
        { "location": "7912/Talk", "narrator": "ガブリエラ", "text": "終わりっ！"},
        { "location": "7913/Talk", "narrator": "アーヤ", "text": "んー、結局みんな\n同じようなことに\nなってしまうわね。"},
        { "location": "7914/Talk", "narrator": "アーヤ", "text": "でも私たちとしても希望は\n持ち続けていたいし。"},
        { "location": "7915/Talk", "narrator": "アーヤ", "text": "忘れないでいて欲しいのは\n紛れもなく本心なの。"},
        { "location": "7916/Talk", "narrator": "アーヤ", "text": "だから何て言うか、\nうん、きっと大丈夫。"},
        { "location": "7917/Talk", "narrator": "アーヤ", "text": "例え違う形になっても\n必ず見つけてくれると\n信じてるわ。"},
        { "location": "7918/Talk", "narrator": "アーヤ", "text": "……ありがとう。"},
        { "location": "7919/Talk", "narrator": "神楽", "text": "つばめさんはトリなので\nここは私ですね。"},
        { "location": "7920/Talk", "narrator": "神楽", "text": "とは言え私は貴方に\n特に今さら言うような\nことも無いですけど。"},
        { "location": "7921/Talk", "narrator": "神楽", "text": "こんな私にでもまた\n会いたいと願ってくれ\nるのなら……。"},
        { "location": "7922/Talk", "narrator": "神楽", "text": "ええ、貴方がそんな\n物好きさんだとしたら\nちょっと嬉しいかな。"},
        { "location": "7923/Talk", "narrator": "神楽", "text": "これだけですよっ。"},
        { "location": "7924/Talk", "narrator": "神楽", "text": "はい、つばめさん、\n満を持して、どうぞ！"},
        { "location": "7925/Talk", "narrator": "つばめ", "text": "え、えーと、主人公の\n逢瀬つばめです。"},
        { "location": "7926/Talk", "narrator": "つばめ", "text": "今まで短い間でしたが\nお付き合いいただいて\nいただいて……。"},
        { "location": "7927/Talk", "narrator": "つばめ", "text": "……やだよ。"},
        { "location": "7928/Talk", "narrator": "つばめ", "text": "これでもうお別れなん\nて、いやだよ……。"},
        { "location": "7929/Talk", "narrator": "つばめ", "text": "みんなともあなたとも\nもっとずっとずっと\n一緒にいたいよ……。"},
        { "location": "7930/Talk", "narrator": "ガブリエラ", "text": "つばめ、そんなこと\n言ったらアイツだって\n困るでしょ。"},
        { "location": "7931/Talk", "narrator": "つばめ", "text": "だって、わたしまだ、\n全然、主人公っぽい\nトコ見せてないし。"},
        { "location": "7932/Talk", "narrator": "ガブリエラ", "text": "……はい？"},
        { "location": "7933/Talk", "narrator": "つばめ", "text": "もっとカッコよく\n活躍したかったのに\n終わりだなんて……。"},
        { "location": "7934/Talk", "narrator": "つばめ", "text": "これじゃわたし、\nただのドジっ子だよ！"},
        { "location": "7935/Talk", "narrator": "つばめ", "text": "もっと活躍したかった\nのに死んで生き返った\nだけだよ……。"},
        { "location": "7936/Talk", "narrator": "みやび", "text": "間違っちょらんけど\nそう言うと身も蓋も\n無いなぁ……。"},
        { "location": "7937/Talk", "narrator": "ガブリエラ", "text": "神楽、アンタ、\n慰めてやったら？"},
        { "location": "7938/Talk", "narrator": "神楽", "text": "つばめさんの泣き顔を\n心のビデオにＲＥＣす\nるのに忙しいので！"},
        { "location": "7939/Talk", "narrator": "ガブリエラ", "text": "うん、最後までアンタ\nダメ過ぎるわ。"},
        { "location": "7940/Talk", "narrator": "みやび", "text": "最後の挨拶もええ感じ\nのｇｄｇｄっぷりや。\nさすがうちら。"},
        { "location": "7941/Talk", "narrator": "みやび", "text": "そしたら、そろそろ\nこの辺で……。"},
        { "location": "7942/Talk", "narrator": "みやび", "text": "……あれ？\nちょっと待ち！！"},
        { "location": "7943/Talk", "narrator": "ガブリエラ", "text": "え？　なに？　もう\n終わりなんだけど？"},
        { "location": "7944/Talk", "narrator": "みやび", "text": "今回、いつもの\nキワドイＥＤのアレ、\n無いんか！？"},
        { "location": "7945/Talk", "narrator": "ガブリエラ", "text": "え？　ええ、もう映像\n止まっちゃってるし。"},
        { "location": "7946/Talk", "narrator": "みやび", "text": "あっちゃーっ、\nみすったわー……。"},
        { "location": "7947/Talk", "narrator": "つばめ", "text": "みやびさん、\n何かするつもり\nだったんですか？"},
        { "location": "7948/Talk", "narrator": "みやび", "text": "いや、毎回うちら\nそそくさと追い出され\nちょったやろ？"},
        { "location": "7949/Talk", "narrator": "みやび", "text": "せやから最後くらいは\n相棒と一緒に見ようと\n思っちょったんやけんど。"},
        { "location": "7950/Talk", "narrator": "ガブリエラ", "text": "……悪趣味過ぎない？"},
        { "location": "7951/Talk", "narrator": "みやび", "text": "うちのボデーについて\n熱く語り合おうと\n思っちょったのに！！"},
        { "location": "7952/Talk", "narrator": "ガブリエラ", "text": "うん、悪趣味って\n言うか変態の域ね。"},
        { "location": "7953/Talk", "narrator": "みやび", "text": "まさか今回に限って\nあの映像が無いなんて\nどういうこっちゃ！？"},
        { "location": "7954/Talk", "narrator": "ガブリエラ", "text": "あーそれはざんねんだった\nわねー（棒）"},
        { "location": "7955/Talk", "narrator": "アーヤ", "text": "みやびは最後の最後ま\nでｇｄｇｄに磨きを\nかけたわね。"},
        { "location": "7956/Talk", "narrator": "アーヤ", "text": "文句無しのＭＶＰよ。"},
        { "location": "7957/Talk", "narrator": "アーヤ", "text": "そんなわけで、\n本当に最後の最後まで\nお粗末様でした。"},
        { "location": "7958/Talk", "narrator": "つばめ", "text": "こんなくだらないダベリを\n最後まで見てくれて、\nありがとね。"},
        { "location": "7959/Talk", "narrator": "つばめ", "text": "またどこかで何かの\n映像を見つけたら、\nまた一緒に見ようね！"},
        { "location": "7960/Talk", "narrator": "つばめ", "text": "その日まで、\nばいばーい♪"}
    ]
}
