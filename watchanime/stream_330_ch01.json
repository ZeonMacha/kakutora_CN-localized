{
    "dir": "stream_330_ch01.json",
    "type": "watchanime",
    "info": {
    },
    "entry":
    [
        { "location": "6418/Talk", "narrator": "みやび", "text": "さすが朋友！\n魂で繋がりし我が片翼\nやわ。"},
        { "location": "6419/Talk", "narrator": "神楽", "text": "なんだか急に中二病っぽく\nなりましたね？"},
        { "location": "6420/Talk", "narrator": "みやび", "text": "うちもそろそろ\nこのキャラ飽きられて\nきたかも知れんし。"},
        { "location": "6421/Talk", "narrator": "神楽", "text": "なんという生存戦略！\nただ胸が大きいことに\n甘んじてないなんて！"},
        { "location": "6422/Talk", "narrator": "みやび", "text": "そもそもうちの胸、\nそない強い武器に\nなってるやろか？"},
        { "location": "6423/Talk", "narrator": "神楽", "text": "「持ってる人」は\nすぐそう言うん\nですよね……。"},
        { "location": "6424/Talk", "narrator": "みやび", "text": "またまた、そない\nイケズなこと言うて\nじらしプレイ？"},
        { "location": "6425/Talk", "narrator": "神楽", "text": "ツンでもなく平静を\n装いつつのドＳ。\nさすがですね。"},
        { "location": "6426/Talk", "narrator": "つばめ", "text": "……違うんじゃ\nないかなぁ？"},
        { "location": "6427/Talk", "narrator": "アーヤ", "text": "落ち着いて、つばめ。\n冷静さを欠くとペース\nに巻き込まれるわよ？"},
        { "location": "6428/Talk", "narrator": "みやび", "text": "なんでそんなあっさり\nわかったんや！？"},
        { "location": "6429/Talk", "narrator": "ガブリエラ", "text": "そりゃ「自費でハワイ旅行」\nなんていう人、一人しかい\nないし。"},
        { "location": "6430/Talk", "narrator": "つばめ", "text": "ちゃんとゲームを\nプレイしてた人なら\nカンタンですよね。"},
        { "location": "6431/Talk", "narrator": "みやび", "text": "しもたぁ……ここで\nメタな解答方法を\n使われるとは……。"},
        { "location": "6432/Talk", "narrator": "アーヤ", "text": "メタ視点の質問をしてる\n時点で当たり前でしょ……。"},
        { "location": "6433/Talk", "narrator": "みやび", "text": "ほんじゃ、そういうわけで\nハワイ旅行、楽しんで来て\nやー。"},
        { "location": "6434/Talk", "narrator": "つばめ", "text": "もう一人増えたら\nここも入れ替わりが\n大変になりますね。"},
        { "location": "6435/Talk", "narrator": "みやび", "text": "むしろそこは仕様変えて\n全員出るようにしたって\n言うとこやき。"},
        { "location": "6436/Talk", "narrator": "ガブリエラ", "text": "ていうか、\n増えないから！"},
        { "location": "6437/Talk", "narrator": "アーヤ", "text": "ギャヴィ、断言して\n大丈夫なの？"},
        { "location": "6438/Talk", "narrator": "ガブリエラ", "text": "そ、そんなことより\nなんでこんな問題を\n外すのよ！？"},
        { "location": "6439/Talk", "narrator": "みやび", "text": "まぁ、不正解でも\nええわ。ハワイ旅行、\n楽しんで来てやー。"},
        { "location": "6440/Talk", "narrator": "つばめ", "text": "あっ、みやびさん\n誤解です。今回は\nツッコミ練習で。"},
        { "location": "6441/Talk", "narrator": "つばめ", "text": "……ツッコミ？\nむしろイジリ？\nお笑いは深いです。"},
        { "location": "6442/Talk", "narrator": "つばめ", "text": "って、なんでわたし\nいつの間にか、お笑い\n目指してるの！？"},
        { "location": "6443/Talk", "narrator": "アーヤ", "text": "みやびもつばめも\n今になってキャラが\nぶれるのは困るわね。"},
        { "location": "6444/Talk", "narrator": "アーヤ", "text": "また偉い人に\n怒られちゃうかも\n知れないのに。"},
        { "location": "6445/Talk", "narrator": "アーヤ", "text": "フェノメノンのせい\nってことで誤魔化せ\nないかしら？"},
        { "location": "6446/Talk", "narrator": "ガブリエラ", "text": "べつに今回はサボってた\nわけじゃないから！"},
        { "location": "6447/Talk", "narrator": "ガブリエラ", "text": "ただ、なんていうか\n戻りづらいノリだった\nっていうか……。"},
        { "location": "6448/Talk", "narrator": "ガブリエラ", "text": "ほら、あたしってば\n空気読み過ぎるから？\n難しいのよねー。"},
        { "location": "6449/Talk", "narrator": "神楽", "text": "はいはーい、すっかり\nシメ役が板につきつつ\nある私ですよー。"},
        { "location": "6450/Talk", "narrator": "神楽", "text": "物語はいよいよ核心で\n次回が超楽しみですよね！"},
        { "location": "6451/Talk", "narrator": "神楽", "text": "次回こそきっと私と\nつばめさんの結婚式が……\nきゃっ♪"},
        { "location": "6452/Talk", "narrator": "つばめ", "text": "ここ最近、ずっと\n真面目な話が続いて\n大丈夫ですか？"},
        { "location": "6453/Talk", "narrator": "ガブリエラ", "text": "開口一番\n何を言い出すのよ？"},
        { "location": "6454/Talk", "narrator": "ガブリエラ", "text": "むしろ最初からずっと\n真面目な話だったでしょ？"},
        { "location": "6455/Talk", "narrator": "つばめ", "text": "んー、そうなんだけど\nなんて言うか前よりも\nボケづらいと言うか。"},
        { "location": "6456/Talk", "narrator": "ガブリエラ", "text": "計算されたボケは誰も\nつばめには期待して\nないから。"},
        { "location": "6457/Talk", "narrator": "つばめ", "text": "でもわたしだって早く\n立派なボケカマシストに\nなりたいよ！？"},
        { "location": "6458/Talk", "narrator": "ガブリエラ", "text": "……ごめん。\n何言ってるのか全然\nわかんない。"},
        { "location": "6459/Talk", "narrator": "みやび", "text": "つばめちゃん、ボケは\n一日にしてならず。\n精進あるのみや。"},
        { "location": "6460/Talk", "narrator": "つばめ", "text": "師匠っ！！"},
        { "location": "6461/Talk", "narrator": "アーヤ", "text": "それなら差し詰め私は\nマネージャーといった\nところかしら？"},
        { "location": "6462/Talk", "narrator": "ガブリエラ", "text": "えーと、ごめん、\n今日ってそんな台本\nもらってたっけ？"},
        { "location": "6463/Talk", "narrator": "みやび", "text": "これくらいアドリブで\n流せんようでは\nまだまだやき。"},
        { "location": "6464/Talk", "narrator": "ガブリエラ", "text": "とりあえずあたしは\n芸人目指してないから\n巻き込まないで！"},
        { "location": "6465/Talk", "narrator": "アーヤ", "text": "そうね。ギャヴィは\nどちらかと言うと\nアイドル枠よね。"},
        { "location": "6466/Talk", "narrator": "ガブリエラ", "text": "この流れだと素直に\n喜んでいいのか判断に\n迷うわ……。"},
        { "location": "6467/Talk", "narrator": "みやび", "text": "なるほど！\nいずれは音ゲーになる\nっちゅうことやね？"},
        { "location": "6468/Talk", "narrator": "ガブリエラ", "text": "初っ端から飛ばし過ぎ！！\n自重して！"},
        { "location": "6469/Talk", "narrator": "ガブリエラ", "text": "ていうか始まる前から\n早くも疲れ始めてるん\nですけど……。"},
        { "location": "6470/Talk", "narrator": "みやび", "text": "前回までのあらすじ！"},
        { "location": "6471/Talk", "narrator": "みやび", "text": "うちらがぶわーっ！\nっと突っ込んでー、"},
        { "location": "6472/Talk", "narrator": "みやび", "text": "んで死亡。ジエンド！\nそんでも物語は続く\nもんなんやねぇ。"},
        { "location": "6473/Talk", "narrator": "ガブリエラ", "text": "そりゃ、主人公のつばめが\nまだ無事なんだし。"},
        { "location": "6474/Talk", "narrator": "みやび", "text": "うちらの生死は物語の\n終結には関係無いいう\nことかい！？"},
        { "location": "6475/Talk", "narrator": "みやび", "text": "これで次回から\n新キャラ三人出たら\nやるせないわー。"},
        { "location": "6476/Talk", "narrator": "ガブリエラ", "text": "どうやらまだワンチャン\nあるみたいだけど？"},
        { "location": "6477/Talk", "narrator": "みやび", "text": "うちら、上手いこと\n脱出して、この中に\n潜んでるいうこと？"},
        { "location": "6478/Talk", "narrator": "アーヤ", "text": "だけどすぐ囲まれて\nしまったから、顔を\n出したら蜂の巣ね。"},
        { "location": "6479/Talk", "narrator": "みやび", "text": "引きこもるんにかけて\nうちに敵うとでも\n思っちょるんか？"},
        { "location": "6480/Talk", "narrator": "ガブリエラ", "text": "それを言うなら\n引きこもりじゃなくて\n立てこもり……。"},
        { "location": "6481/Talk", "narrator": "ガブリエラ", "text": "ところでつばめ、\nこの時、ぼーっとした\n顔で何考えてたのよ？"},
        { "location": "6482/Talk", "narrator": "ガブリエラ", "text": "あー死んじゃったかー\nでも仕方ないなー\nって顔してない？"},
        { "location": "6483/Talk", "narrator": "つばめ", "text": "そそそそんな気のせい\nですよ？　この時は\n理解が追いつかなくて"},
        { "location": "6484/Talk", "narrator": "つばめ", "text": "むしろ何も考えてない\nというか考えられない\nというか。"},
        { "location": "6485/Talk", "narrator": "つばめ", "text": "そ、それより画面に\n集中しましょう。\n集中ぅ～っ！"},
        { "location": "6486/Talk", "narrator": "みやび", "text": "さて、ここまで\n小難しい話をされて\n退屈だった諸君、"},
        { "location": "6487/Talk", "narrator": "みやび", "text": "まだまだ小難しい話は\n続くけんど――"},
        { "location": "6488/Talk", "narrator": "みやび", "text": "ここでは「もう一つの見\n方」をして見たいと\n思うちょるんや。"},
        { "location": "6489/Talk", "narrator": "ガブリエラ", "text": "イヤな予感しかしない\nんだけど、止めるのも\n面倒だから続けて。"},
        { "location": "6490/Talk", "narrator": "みやび", "text": "うむ、許可も出た\nことだし続けるけんど\nそれはズバリ！"},
        { "location": "6491/Talk", "narrator": "みやび", "text": "これが痴情のもつれに\nよる三角関係の修羅場\nシーンだったら？"},
        { "location": "6492/Talk", "narrator": "みやび", "text": "…という視点でこれを\n見たらどうなるか？　や！"},
        { "location": "6493/Talk", "narrator": "ガブリエラ", "text": "……あたしちょっと\nノドが渇いたから、\nテキトーにやってて。"},
        { "location": "6494/Talk", "narrator": "神楽", "text": "そしてわたしが来た！\nガブちゃん、\nナイスアシストです！"},
        { "location": "6495/Talk", "narrator": "つばめ", "text": "ていうか神楽ちゃん\nこういう時だけ出て\n来るんだね……。"},
        { "location": "6496/Talk", "narrator": "神楽", "text": "はい、つばめさんと\n同じ空間に居続けると\n理性が崩壊するので。"},
        { "location": "6497/Talk", "narrator": "神楽", "text": "いわゆる自主規制と\nいうやつです。\n迷惑ダメ！　絶対！"},
        { "location": "6498/Talk", "narrator": "つばめ", "text": "そ、そうなんだ……。\nき、気遣いは\n大事だもんね……。"},
        { "location": "6499/Talk", "narrator": "みやび", "text": "さて、そないなわけで\nちょっとだけ進めるんよ。"},
        { "location": "6500/Talk", "narrator": "みやび", "text": "逢瀬つばめ選手、\nこれはいいスタートを\n切り出しましたね。"},
        { "location": "6501/Talk", "narrator": "みやび", "text": "逢瀬つばめは、痴情の\nもつれで嫉妬の憎悪に\n包まれた千羽鶴に"},
        { "location": "6502/Talk", "narrator": "みやび", "text": "監禁されていた。\nそして対面しての\n第一声がこれとは"},
        { "location": "6503/Talk", "narrator": "みやび", "text": "クオリティ高い！\nかなりの高得点です！"},
        { "location": "6504/Talk", "narrator": "つばめ", "text": "あのー……、\nその変な実況風味、\n必要なんですか？"},
        { "location": "6505/Talk", "narrator": "神楽", "text": "よくわかりませんが\n高揚することは確かです！"},
        { "location": "6506/Talk", "narrator": "みやび", "text": "うむ、卯月はわかって\nくれると信じちょったよ！"},
        { "location": "6507/Talk", "narrator": "みやび", "text": "キミもきっとわかって\nくれちょるんよね？"},
        { "location": "6508/Talk", "narrator": "つばめ", "text": "ていうか、変な友情を\n育んでいないで、\n先に進めてください。"},
        { "location": "6509/Talk", "narrator": "みやび", "text": "つばめちゃんが\nいつになく\n辛辣や！？"},
        { "location": "6510/Talk", "narrator": "神楽", "text": "ああ、やっぱりあの時\n押し倒さなくちゃいけ\nなかったんですね！"},
        { "location": "6511/Talk", "narrator": "神楽", "text": "今からでも遅くは\nありませんから、\n是非私の部屋に！"},
        { "location": "6512/Talk", "narrator": "つばめ", "text": "か、神楽ちゃんが\n野獣のような目で\nわたしを見てるっ！？"},
        { "location": "6513/Talk", "narrator": "みやび", "text": "何これ、かぐｘつば\nかと思ってたら、\nちはｘかぐ　なん！？"},
        { "location": "6514/Talk", "narrator": "アーヤ", "text": "しかも管理するって、\nこういうの何て言うん\nだっけ？　監禁もの？"},
        { "location": "6515/Talk", "narrator": "神楽", "text": "ちょっと違います。\nかなりマニアックな\nジャンルですね。"},
        { "location": "6516/Talk", "narrator": "みやび", "text": "何にしろ神楽は\n千羽鶴に色々と管理\nされちゃうわけや。"},
        { "location": "6517/Talk", "narrator": "神楽", "text": "何をどう管理され\nちゃうんでしょう！？\nドキドキしますっ！！"},
        { "location": "6518/Talk", "narrator": "アーヤ", "text": "もしかして卯月って\n本当に壊れてしまって\nいるんじゃ……。"},
        { "location": "6519/Talk", "narrator": "神楽", "text": "アーヤさん、私で変な\n妄想を膨らませないで\nくださいよ～。"},
        { "location": "6520/Talk", "narrator": "つばめ", "text": "とか言いつつ、\nなんでそんなに\n嬉しそうなのっ！？"},
        { "location": "6521/Talk", "narrator": "神楽", "text": "そうです！　私たちは\nただお互い愛し合って\nいただけなのに！！"},
        { "location": "6522/Talk", "narrator": "アーヤ", "text": "何だか、こっちが\n本当の流れみたいに\n思えてきたわ……。"},
        { "location": "6523/Talk", "narrator": "神楽", "text": "ああっ！　つまり\nつばめさんの初めては\n私が奪っていたと！"},
        { "location": "6524/Talk", "narrator": "神楽", "text": "だから千羽鶴は\nあんなに執拗に嫉妬の\n炎を燃やしてると！"},
        { "location": "6525/Talk", "narrator": "神楽", "text": "全ては私とつばめさん\nとの愛が深すぎたせい\nだったなんて……。"},
        { "location": "6526/Talk", "narrator": "アーヤ", "text": "……つばめ、\n訂正させなくていいの？"},
        { "location": "6527/Talk", "narrator": "つばめ", "text": "はい、なんか下手に\n触っちゃうと余計に\nマズイかなって……。"},
        { "location": "6528/Talk", "narrator": "みやび", "text": "つばめちゃんも高度な\n放置プレイを使うまで\nに成長しちょるとは。"},
        { "location": "6529/Talk", "narrator": "みやび", "text": "これってあれか、\n千羽鶴は部下のつばめ\nのことが好きだけど"},
        { "location": "6530/Talk", "narrator": "みやび", "text": "つばめは同僚の神楽が\n好きで、それに耐えら\nれない千羽鶴は"},
        { "location": "6531/Talk", "narrator": "みやび", "text": "上官特権のパワハラで\nつばめに色々強要して\nそれでもつばめは"},
        { "location": "6532/Talk", "narrator": "みやび", "text": "長官の愛と嫉妬に\n気づかず――"},
        { "location": "6533/Talk", "narrator": "みやび", "text": "どうして私だけこんなに\nいじめられるのかと\n泣いていたら――"},
        { "location": "6534/Talk", "narrator": "みやび", "text": "その衝撃の真実が……"},
        { "location": "6535/Talk", "narrator": "みやび", "text": "なーんて話してる内に\nフェノメノンの話に\nなったから終了ー。"},
        { "location": "6536/Talk", "narrator": "つばめ", "text": "むしろ言いたいこと\n全部言い切ってた気が\nするんですけど……。"},
        { "location": "6537/Talk", "narrator": "神楽", "text": "つばめさんと私の\n子供説・立証、\nキターーーーーッ！！"},
        { "location": "6538/Talk", "narrator": "神楽", "text": "やっぱりつばめさんが\nママだったんですね！"},
        { "location": "6539/Talk", "narrator": "つばめ", "text": "んん？\nそれって神楽ちゃんが\nパパってこと？"},
        { "location": "6540/Talk", "narrator": "つばめ", "text": "もしかして神楽ちゃんって\n男の子だったの！？"},
        { "location": "6541/Talk", "narrator": "アーヤ", "text": "つばめ、落ち着いて。\n一々真に受けていては\nダメよ。"},
        { "location": "6542/Talk", "narrator": "神楽", "text": "あっ、そろそろ私、\nガブちゃんと交代\nしまーす！"},
        { "location": "6543/Talk", "narrator": "ガブリエラ", "text": "やっぱりあたしが\nきっちりつっこんで\nいかないとダメね。"},
        { "location": "6544/Talk", "narrator": "つばめ", "text": "おぉ……ガブちゃんが\n頼もしく見えるよ。"},
        { "location": "6545/Talk", "narrator": "みやび", "text": "遂にここで嫉妬に狂った\n長官がつばめと心中！"},
        { "location": "6546/Talk", "narrator": "みやび", "text": "「貴方の愛が私に向かない\nなら、貴方を殺して私も\n死ぬ！」"},
        { "location": "6547/Talk", "narrator": "ガブリエラ", "text": "……早速だけどそのネタ、\nまだ引っ張ってるの？"},
        { "location": "6548/Talk", "narrator": "アーヤ", "text": "みやび、そろそろ真面目に\n本題に戻りましょう？"},
        { "location": "6549/Talk", "narrator": "みやび", "text": "ほんま、こんな昼ドラみた\nいなネタ振ったんは誰や？"},
        { "location": "6550/Talk", "narrator": "ガブリエラ", "text": "……つっこんで\nあげないから。"},
        { "location": "6551/Talk", "narrator": "つばめ", "text": "キャーッ！\nメノウちゃーん！！"},
        { "location": "6552/Talk", "narrator": "ガブリエラ", "text": "え？　これって単なる\nＢＧＭじゃないの？"},
        { "location": "6553/Talk", "narrator": "つばめ", "text": "違うよ！\nこれはメノウちゃんの\n歌だよ！"},
        { "location": "6554/Talk", "narrator": "つばめ", "text": "それも、わたしを壊す\nためだけに作られた、\nオリジナル曲だよ！"},
        { "location": "6555/Talk", "narrator": "つばめ", "text": "この時はココロが\nかき乱される感じで\nすごい苦しかったけど"},
        { "location": "6556/Talk", "narrator": "つばめ", "text": "きっとこれ今思えば\nあの世界的スターの\nメノウちゃんが"},
        { "location": "6557/Talk", "narrator": "つばめ", "text": "わたしだけに描き下ろして\nしかも誰もいない所で"},
        { "location": "6558/Talk", "narrator": "つばめ", "text": "わたしの為だけに\n歌ってくれたという\nことから来る感動で、"},
        { "location": "6559/Talk", "narrator": "つばめ", "text": "あまりに感動しすぎて\n胸が苦しくなって\nいたんだよね……。"},
        { "location": "6560/Talk", "narrator": "アーヤ", "text": "つばめ、現実逃避にも\n限度があるわよ。\nそれくらいにね？"},
        { "location": "6561/Talk", "narrator": "つばめ", "text": "え？　わたし、\nかなり本気で思って\nたんだけどなぁ……？"},
        { "location": "6562/Talk", "narrator": "アーヤ", "text": "そ、そうだったの？\nでも、ほどほどにね。"},
        { "location": "6563/Talk", "narrator": "みやび", "text": "きゃーっ！\nまほさーん！！"},
        { "location": "6564/Talk", "narrator": "ガブリエラ", "text": "みやびもそのネタ\n何度引っ張り出せば\n気が済むのよ！？"},
        { "location": "6565/Talk", "narrator": "みやび", "text": "いやこれは天丼言うて\n繰り返し積み重ねる\nギャグの基本やき。"},
        { "location": "6566/Talk", "narrator": "ガブリエラ", "text": "そういう割には\n滑ってるんだけど？"},
        { "location": "6567/Talk", "narrator": "つばめ", "text": "あぁっ、ガブちゃんの\n無慈悲なツンドラが\nみやびさんを襲う！"},
        { "location": "6568/Talk", "narrator": "みやび", "text": "でもうち負けないっ！\nだってここでいよいよ\nうちらの出番やし！"},
        { "location": "6569/Talk", "narrator": "みやび", "text": "てなわけで、ここで\n視聴者プレゼントの\nコーナーです！"},
        { "location": "6570/Talk", "narrator": "ガブリエラ", "text": "相変わらず脈絡も無く\n唐突過ぎるんだけど。"},
        { "location": "6571/Talk", "narrator": "アーヤ", "text": "でも長くなるのも\n不味いから、ここは\n静観しましょう。"},
        { "location": "6572/Talk", "narrator": "つばめ", "text": "アーヤさん、さすがと\n言うか、お疲れ様と\n言うか……。"},
        { "location": "6573/Talk", "narrator": "みやび", "text": "なんや呆れられちょる\n気もするけんど構わず\n続けちゃるよ！"},
        { "location": "6574/Talk", "narrator": "みやび", "text": "今回のラストで\nつばめちゃんの手首の\n枷が斬られましたが、"},
        { "location": "6575/Talk", "narrator": "みやび", "text": "あれを斬ったのは一体誰\nだったのでしょう！？"},
        { "location": "6576/Talk", "narrator": "みやび", "text": "１：アーヤ\n２：ガブちゃん\n３：みやびちゃん"},
        { "location": "6577/Talk", "narrator": "みやび", "text": "４：$handle$\n当選した方には\n斬った本人より、"},
        { "location": "6578/Talk", "narrator": "みやび", "text": "自費でハワイ旅行一週間が\nプレゼントされます！"},
        { "location": "6579/Talk", "narrator": "ガブリエラ", "text": "え……、それって\nもう誰なのかバレバレ\nじゃないの……。"},
        { "location": "6580/Talk", "narrator": "みやび", "text": "何でや！？　今回の\nクイズはノーヒント\n難易度Ｓやのに！？"},
        { "location": "6581/Talk", "narrator": "ガブリエラ", "text": "とりあえずアンタに\n答えさせてあげるから\n外さないでよね？"},
        { "location": "6582/Talk", "narrator": "ガブリエラ", "text": "そんなこと言って、\nホントに行ったら\nどうするのよ……。"},
        { "location": "6583/Talk", "narrator": "みやび", "text": "ハワイでガチャると\n神引きするって知らんの？"},
        { "location": "6584/Talk", "narrator": "アーヤ", "text": "微塵も根拠の無い\nデマを流すと、\n本当に消されるわよ？"},
        { "location": "6585/Talk", "narrator": "みやび", "text": "ヒィィッ！　\nお、お代官様、\nどうか御慈悲を～っ。"},
        { "location": "6586/Talk", "narrator": "つばめ", "text": "あの、長いので\nそろそろ終わりに\nしませんか？"},
        { "location": "6587/Talk", "narrator": "みやび", "text": "つばめちゃんから\n巻きが入った！？"},
        { "location": "6588/Talk", "narrator": "アーヤ", "text": "偉いわよ、つばめ。\n成長したわね。"},
        { "location": "6589/Talk", "narrator": "ガブリエラ", "text": "成長したと言うか\nみやびの扱いに慣れて\nきたと言うか。"},
        { "location": "6590/Talk", "narrator": "みやび", "text": "それ単にうちの扱いが\nぞんざいになった\nだけと違うん？"},
        { "location": "6591/Talk", "narrator": "つばめ", "text": "みなさん、今日は\nおつかれさまでした！"},
        { "location": "6592/Talk", "narrator": "みやび", "text": "メチャメチャ強引に\nシメられたっ！！"},
        { "location": "6593/Talk", "narrator": "みやび", "text": "うぅっ……可愛い\nつばめちゃんが\nうちをいじめる……。"},
        { "location": "6594/Talk", "narrator": "みやび", "text": "いや、きっとこれも\n新しい愛の形なんやね\nきっと……。"},
        { "location": "6595/Talk", "narrator": "みやび", "text": "などとポジティブに\n自分を励ます\nうちであった！"}
    ]
}
