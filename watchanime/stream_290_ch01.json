{
    "dir": "stream_290_ch01.json",
    "type": "watchanime",
    "info": {
    },
    "entry":
    [
        { "location": "5546/Talk", "narrator": "ガブリエラ", "text": "へー、「昔」そういう\n体験してきたんだ。"},
        { "location": "5547/Talk", "narrator": "アーヤ", "text": "こらギャヴィ、\nそういうデリケートな\n問題はやめなさい。"},
        { "location": "5548/Talk", "narrator": "みやび", "text": "もしかしてキミ、\nうちの親と\n同じくらいの……。"},
        { "location": "5549/Talk", "narrator": "アーヤ", "text": "こら。アーヤもよ。"},
        { "location": "5550/Talk", "narrator": "みやび", "text": "なんやテレホタイムも\n知らんクチ？"},
        { "location": "5551/Talk", "narrator": "ガブリエラ", "text": "何それ？"},
        { "location": "5552/Talk", "narrator": "みやび", "text": "んー、それを説明する\nのは意外と面倒いから\n検索してや。"},
        { "location": "5553/Talk", "narrator": "ガブリエラ", "text": "もう！\nこういう時だけ\n手を抜くんだから。"},
        { "location": "5554/Talk", "narrator": "みやび", "text": "てことみたいやよ。\nアーヤ、がんばりや。"},
        { "location": "5555/Talk", "narrator": "アーヤ", "text": "自分を棚に上げといて\n私に振るわけ！？"},
        { "location": "5556/Talk", "narrator": "アーヤ", "text": "わ、私はべつに、\nだからどうって\nわけじゃなくて……。"},
        { "location": "5557/Talk", "narrator": "ガブリエラ", "text": "あ、あたしだって\n成長期なわけだし\nこのままじゃないし！"},
        { "location": "5558/Talk", "narrator": "みやび", "text": "なんや、何でもええっちゅう\nことかい？"},
        { "location": "5559/Talk", "narrator": "アーヤ", "text": "みやび、気を遣って\nもらったって気づきなさい。"},
        { "location": "5560/Talk", "narrator": "みやび", "text": "いやむしろ本当に\n何でもオッケーの\n本音やも知れんき。"},
        { "location": "5561/Talk", "narrator": "つばめ", "text": "趣味の幅が広いんですね！"},
        { "location": "5562/Talk", "narrator": "ガブリエラ", "text": "その褒め方はちょっと違うと\n思うんだけど……。"},
        { "location": "5563/Talk", "narrator": "つばめ", "text": "あぁっ！　ガブちゃん\n置いていかないで、\n見捨てないで！"},
        { "location": "5564/Talk", "narrator": "つばめ", "text": "そして捨てられた子犬\nのように空を見上げる\nわたし……。"},
        { "location": "5565/Talk", "narrator": "つばめ", "text": "とか言ってる場合じゃ\nなくなってきた\nのかなぁ？"},
        { "location": "5566/Talk", "narrator": "神楽", "text": "ややっ？\n早速ガブちゃんに\n浮気ですか？"},
        { "location": "5567/Talk", "narrator": "神楽", "text": "私は嫉妬深いので\n浮気はＮＧですよ！？"},
        { "location": "5568/Talk", "narrator": "神楽", "text": "……いやでもこれは\nガブちゃんも同時に\nゲットのチャンス？"},
        { "location": "5569/Talk", "narrator": "みやび", "text": "神楽の怒濤のボケ\nうちもツッコミ\nたかったわー。"},
        { "location": "5570/Talk", "narrator": "みやび", "text": "というか、このモード\nそもそも何で四人しか\n出られんぞね？"},
        { "location": "5571/Talk", "narrator": "みやび", "text": "え？\nそこに触れたら消される？\nまた禁断ワードかい！"},
        { "location": "5572/Talk", "narrator": "アーヤ", "text": "えーと……コメントに\n困る展開だったわね。"},
        { "location": "5573/Talk", "narrator": "アーヤ", "text": "でも、まぁ、卯月の\nお陰で深刻にならずに\n済んだのかしら？"},
        { "location": "5574/Talk", "narrator": "アーヤ", "text": "でもだからって、\nやっぱりあのボケは\nナイわよねぇ……。"},
        { "location": "5575/Talk", "narrator": "みやび", "text": "画面の前のみんな、\nお待たせーっ！"},
        { "location": "5576/Talk", "narrator": "ガブリエラ", "text": "って！\nいきなり変なキャラで\n出ないでよ！"},
        { "location": "5577/Talk", "narrator": "みやび", "text": "意外性こそが女の魅力を\n上げるぞね。"},
        { "location": "5578/Talk", "narrator": "ガブリエラ", "text": "意外性の塊が言っても\n説得力無いし。"},
        { "location": "5579/Talk", "narrator": "みやび", "text": "うちには魅力が\n無いっちゅうこと！？"},
        { "location": "5580/Talk", "narrator": "みやび", "text": "うぅ……ガブちゃんに\nお嫁に行けん体に\nされてもうた……。"},
        { "location": "5581/Talk", "narrator": "ガブリエラ", "text": "何それ……。"},
        { "location": "5582/Talk", "narrator": "アーヤ", "text": "みやびの場合はむしろ\n黙っていた方が魅力が\nある気もするけど。"},
        { "location": "5583/Talk", "narrator": "みやび", "text": "せやけど\n黙っているうちなど\nうちではないきに。"},
        { "location": "5584/Talk", "narrator": "つばめ", "text": "えーと、なんの話を\nしてるんですか？\nみやびさんの嫁入り？"},
        { "location": "5585/Talk", "narrator": "みやび", "text": "誰が、いきおくれや！"},
        { "location": "5586/Talk", "narrator": "つばめ", "text": "言ってないですし、\nそれを言ったらアーヤ\nさんの方が年上です！"},
        { "location": "5587/Talk", "narrator": "アーヤ", "text": "つばめ、ひどいわ。\n私が一番気にしいてる\nことを……しくしく。"},
        { "location": "5588/Talk", "narrator": "ガブリエラ", "text": "さっきからこの小芝居は\nなんなの？"},
        { "location": "5589/Talk", "narrator": "つばめ", "text": "なんなんでしょう？"},
        { "location": "5590/Talk", "narrator": "ガブリエラ", "text": "アンタも\n乗っかってたでしょ！"},
        { "location": "5591/Talk", "narrator": "みやび", "text": "もう、うちは\n付き合い切れんわ。"},
        { "location": "5592/Talk", "narrator": "ガブリエラ", "text": "アンタが言うなっ！"},
        { "location": "5593/Talk", "narrator": "ガブリエラ", "text": "ていうか、この電話！\nもしかして、これが\n出オチってヤツ？"},
        { "location": "5594/Talk", "narrator": "みやび", "text": "さすがはアーヤの家。\n１００年は過去に\n生きちょる。"},
        { "location": "5595/Talk", "narrator": "アーヤ", "text": "失礼ね！\nせいぜい１０年ってところ\nでしょ？"},
        { "location": "5596/Talk", "narrator": "つばめ", "text": "１０年前でも、\nこんな電話は無かったと\n思いますよ……。"},
        { "location": "5597/Talk", "narrator": "みやび", "text": "この繋ぎ方知っちょる\n人って絶対４０歳以上\nのおじさんやね。"},
        { "location": "5598/Talk", "narrator": "アーヤ", "text": "パソコン通信でも、\n３００ボーとかの時代\nの人だけかもね。"},
        { "location": "5599/Talk", "narrator": "つばめ", "text": "３００ボー？\nって、なんですか？"},
        { "location": "5600/Talk", "narrator": "みやび", "text": "３００ｂｐｓのこと。\nちなみに今の光回線は\n１Ｇｂｐｓとかや。"},
        { "location": "5601/Talk", "narrator": "ガブリエラ", "text": "何倍っていうか\n何分の一なのよ\nその遅さは……。"},
        { "location": "5602/Talk", "narrator": "みやび", "text": "キャーッ！\nエリカさーん！"},
        { "location": "5603/Talk", "narrator": "ガブリエラ", "text": "ていうか、ここどこ？"},
        { "location": "5604/Talk", "narrator": "つばめ", "text": "この部屋の押し入れ\nだったら、今期の\nお笑いＭＶＰですね！"},
        { "location": "5605/Talk", "narrator": "アーヤ", "text": "ちなみにこれケイマン\n諸島の映像だからって\n姉がケイマン諸島に"},
        { "location": "5606/Talk", "narrator": "アーヤ", "text": "いるわけじゃないから\n騙されないでね。"},
        { "location": "5607/Talk", "narrator": "みやび", "text": "情報操作の基本やね。\nうちも情報管理基礎Ⅰ\nで習ったわ。"},
        { "location": "5608/Talk", "narrator": "ガブリエラ", "text": "そういえばＦＡＸって\nもう日本でしか使われ\nてないのよね。"},
        { "location": "5609/Talk", "narrator": "みやび", "text": "逆に言えば未だに\n使える環境を維持して\nるいうことや。"},
        { "location": "5610/Talk", "narrator": "ガブリエラ", "text": "いやだからそれって\n無駄じゃないの？\n海外でも笑い話よ？"},
        { "location": "5611/Talk", "narrator": "アーヤ", "text": "確かに無駄だけれど\n未だにガラケーの人も\n結構いるわけだし。"},
        { "location": "5612/Talk", "narrator": "みやび", "text": "ガラケーじゃうちらと\n会えんぞね！？"},
        { "location": "5613/Talk", "narrator": "ガブリエラ", "text": "べつにガラケーしか\n持って無いってわけ\nじゃないでしょ。"},
        { "location": "5614/Talk", "narrator": "つばめ", "text": "あのー……ところで、\n前回吊るされてた\nわたしのその後は？"},
        { "location": "5615/Talk", "narrator": "ガブリエラ", "text": "まだ吊るされたまんま\nなんじゃない？"},
        { "location": "5616/Talk", "narrator": "みやび", "text": "あのまま燻製にされちょ\nるかも知れんぞね。"},
        { "location": "5617/Talk", "narrator": "つばめ", "text": "スモークつばめアンド\n神楽ちゃん！？"},
        { "location": "5618/Talk", "narrator": "ガブリエラ", "text": "全く美味しそうに思えない\n響きがすごいわね……。"},
        { "location": "5619/Talk", "narrator": "みやび", "text": "な、なんだってーーー！？\n（お約束）"},
        { "location": "5620/Talk", "narrator": "みやび", "text": "いやー、つばめちゃん、\nパナいわー。"},
        { "location": "5621/Talk", "narrator": "つばめ", "text": "そんな褒められても\n何も出ませんよー。\nえへへっ♪"},
        { "location": "5622/Talk", "narrator": "ガブリエラ", "text": "でもさ、フェノメノン\nなのに何でこんな\n常識的な世界なの？"},
        { "location": "5623/Talk", "narrator": "アーヤ", "text": "いえ、その考え方が\n既に間違っているの\nかも知れないわよ。"},
        { "location": "5624/Talk", "narrator": "ガブリエラ", "text": "どーゆーこと！？"},
        { "location": "5625/Talk", "narrator": "アーヤ", "text": "私たちはこれが常識的\nだと思い込まされてる\nだけなのかも……。"},
        { "location": "5626/Talk", "narrator": "みやび", "text": "断絶された未開文明\nとか、そんな感じかも\n知れんぞね。"},
        { "location": "5627/Talk", "narrator": "つばめ", "text": "てことは例えば外では\n鼻からケーキを食べる\nのが常識だったり？"},
        { "location": "5628/Talk", "narrator": "ガブリエラ", "text": "このフェノメノンを\n絶対に死守しなくちゃ\nならないじゃないの！"},
        { "location": "5629/Talk", "narrator": "みやび", "text": "ガブちゃんが言うのも\nわかるけど、さすがに\n神様やないみたいやね。"},
        { "location": "5630/Talk", "narrator": "アーヤ", "text": "つまり、つばめが創造\nしてるのではなく配役\nしてるってことね。"},
        { "location": "5631/Talk", "narrator": "ガブリエラ", "text": "もしかして、そもそも\nあたしが日本にいるの\nも改変なのかも……。"},
        { "location": "5632/Talk", "narrator": "アーヤ", "text": "無から造り出せはしな\nいけれど、容姿とかの\n改変は出来るわけね。"},
        { "location": "5633/Talk", "narrator": "みやび", "text": "しっかしこうやって\n横に並ぶとちち比べが\nわかりやすいわぁ。"},
        { "location": "5634/Talk", "narrator": "ガブリエラ", "text": "ちち比べ言うなぁっ！\nていうかこのアーヤ、\n盛ってない？"},
        { "location": "5635/Talk", "narrator": "みやび", "text": "いんや。これはうちが\n小さく見える工作を\nしてるだけぞね。"},
        { "location": "5636/Talk", "narrator": "ガブリエラ", "text": "なんなのよ、そのイヤミ\nたっぷりな工作は……。"},
        { "location": "5637/Talk", "narrator": "みやび", "text": "脱いだらすごいちゅう\nインパクトの為の\n下準備や。"},
        { "location": "5638/Talk", "narrator": "つばめ", "text": "でも海での水着回\nもうやっちゃいました\nけど？"},
        { "location": "5639/Talk", "narrator": "ガブリエラ", "text": "……ねぇ、ところで\nつばめ、ちょっと\n話があるんだけど。"},
        { "location": "5640/Talk", "narrator": "つばめ", "text": "ガブちゃん、\nなんかよからぬこと\nたくらんでない！？"},
        { "location": "5641/Talk", "narrator": "ガブリエラ", "text": "は、はぁ？\n言っとくけどあたしは\n神楽よりはあるから！"},
        { "location": "5642/Talk", "narrator": "アーヤ", "text": "ギャヴィ、そんなに\n気にすることじゃない\nから落ち着きなさい。"},
        { "location": "5643/Talk", "narrator": "みやび", "text": "ところでキミは大中小、\nどれがお好みなんや？"},
        { "location": "5644/Talk", "narrator": "みやび", "text": "このエリカさんの\n言い方からするに――"},
        { "location": "5645/Talk", "narrator": "みやび", "text": "つばめちゃんからクランを\n抽出したんはエリカさん\nちゅうことなんかね？"},
        { "location": "5646/Talk", "narrator": "アーヤ", "text": "ええ、順当に状況証拠\nから考えれば、自然と\nそうなるわね……。"},
        { "location": "5647/Talk", "narrator": "つばめ", "text": "つまりわたしって\nアーヤさんのお姉さん\nに改造された！？"},
        { "location": "5648/Talk", "narrator": "ガブリエラ", "text": "されたというか、\nつばめが自ら希望した\n可能性もあるけどね。"},
        { "location": "5649/Talk", "narrator": "みやび", "text": "突然やけどここから\n千羽鶴の真意を\nトトカルチョや！"},
        { "location": "5650/Talk", "narrator": "アーヤ", "text": "みやび、不謹慎よ。\n私はつばめが聖女って\n方だと思うけど。"},
        { "location": "5651/Talk", "narrator": "みやび", "text": "結局乗るんかい！\nうちは抽出したクラン\n利用の方やな。"},
        { "location": "5652/Talk", "narrator": "ガブリエラ", "text": "あたしもみやびと\n同じ方に張っとくわ。"},
        { "location": "5653/Talk", "narrator": "つばめ", "text": "えっ？　じゃあわたし\nわたしが聖女って方に\nしなきゃいけないの？"},
        { "location": "5654/Talk", "narrator": "ガブリエラ", "text": "いや、べつにそこで\n空気読まなくても。"},
        { "location": "5655/Talk", "narrator": "みやび", "text": "って、トトカルチョ\nまだ終わってないん\nやけんど！"},
        { "location": "5656/Talk", "narrator": "アーヤ", "text": "だったら画面を止めて\nおけばよかったのに。"},
        { "location": "5657/Talk", "narrator": "みやび", "text": "つーか「時間がない」\nって何？　物理？\nメタ？　尺の都合！？"},
        { "location": "5658/Talk", "narrator": "アーヤ", "text": "みやび、落ち着いて。\nそれ以上はいけない。\n消されるわよ。"},
        { "location": "5659/Talk", "narrator": "ガブリエラ", "text": "つばめの「特異点の\n資質」ってのについて\nもう一度やれば？"},
        { "location": "5660/Talk", "narrator": "みやび", "text": "それについては\nトトカルチョじゃ\nなくて考察ぞね……。"},
        { "location": "5661/Talk", "narrator": "つばめ", "text": "えぇっ！？　わたし\nやっばり現実でも\n入院してるの！？"},
        { "location": "5662/Talk", "narrator": "アーヤ", "text": "と言うよりは入院を\n強制されている状況\nみたいね。"},
        { "location": "5663/Talk", "narrator": "つばめ", "text": "わたし改造人間から\n実験動物に格下げ\nされてるよ！？"},
        { "location": "5664/Talk", "narrator": "みやび", "text": "第１号言われちょるん\nなら、バイク乗る的な\n改造人間やね。"},
        { "location": "5665/Talk", "narrator": "アーヤ", "text": "えっ……？\n千羽鶴が、つばめの\nクラン……？"},
        { "location": "5666/Talk", "narrator": "ガブリエラ", "text": "でもクランと本体って\nフェノメノンの中で\n同時出現できるわけ？"},
        { "location": "5667/Talk", "narrator": "みやび", "text": "今までの法則やと\n同時は無理やけど――"},
        { "location": "5668/Talk", "narrator": "みやび", "text": "そもそもこの世界は\nつばめちゃんが\n創った世界なんやし――"},
        { "location": "5669/Talk", "narrator": "みやび", "text": "チート的な？"},
        { "location": "5670/Talk", "narrator": "ガブリエラ", "text": "もしくは、そこにいる\nつばめは実は生身じゃ\nないとか？"},
        { "location": "5671/Talk", "narrator": "つばめ", "text": "今度はわたし幽霊？\nそれともロボ？\n一体何なの！？"},
        { "location": "5672/Talk", "narrator": "神楽", "text": "何って、つばめさんは\n天使に決まってるじゃ\nないですかっ！"},
        { "location": "5673/Talk", "narrator": "つばめ", "text": "神楽ちゃんっ！？\nまさかここで！？"},
        { "location": "5674/Talk", "narrator": "神楽", "text": "もう終わりだからって\n油断しましたね？\nつばめさん甘いです。"},
        { "location": "5675/Talk", "narrator": "ガブリエラ", "text": "ていうか、アンタ\n割と初期からやり放題\nだったわよね。"},
        { "location": "5676/Talk", "narrator": "神楽", "text": "トリックスター的な\n立ち位置、美味しいです♪"},
        { "location": "5677/Talk", "narrator": "神楽", "text": "って、そんなことより\nつばめさん！\nこれは一大事です！！"},
        { "location": "5678/Talk", "narrator": "つばめ", "text": "う、うん、わたしたち\n今回もまだ吊るされた\nままで大変だよね。"},
        { "location": "5679/Talk", "narrator": "神楽", "text": "そうじゃなくて！\nさっきの話ですよ！"},
        { "location": "5680/Talk", "narrator": "つばめ", "text": "さっきの？\n千羽鶴長官がわたしの\nクランだってこと？"},
        { "location": "5681/Talk", "narrator": "神楽", "text": "メノウ、つまり私の\n歌の影響で今の日本が\n生まれたことです！"},
        { "location": "5682/Talk", "narrator": "ガブリエラ", "text": "メノウの歌のお陰で\n洗脳は回避したって\n話じゃなかった？"},
        { "location": "5683/Talk", "narrator": "アーヤ", "text": "そして生きる希望も\n与えられての結果が\n巨大フェノメノンね。"},
        { "location": "5684/Talk", "narrator": "つばめ", "text": "つまりメノウちゃんの\n歌が、この世界の\n産みの親なんだね。"},
        { "location": "5685/Talk", "narrator": "神楽", "text": "そこです！\nつまり、つまりですよ！"},
        { "location": "5686/Talk", "narrator": "神楽", "text": "この世界は私とつばめ\nさんの正に愛の結晶！"},
        { "location": "5687/Talk", "narrator": "神楽", "text": "私とつばめさんの\n子供ということなんですよ！"},
        { "location": "5688/Talk", "narrator": "ガブリエラ", "text": "……は？"},
        { "location": "5689/Talk", "narrator": "つばめ", "text": "えぇっ……。"},
        { "location": "5690/Talk", "narrator": "神楽", "text": "あ！\nてことは千羽鶴も私と\nつばめさんの子供！？"},
        { "location": "5691/Talk", "narrator": "神楽", "text": "私、自分の子供に\n酷いことされてるって\nことですか？"},
        { "location": "5692/Talk", "narrator": "神楽", "text": "これはつまり、私は潜在的に\nドＭだった可能性が！？"},
        { "location": "5693/Talk", "narrator": "神楽", "text": "これはドキドキしてきまし\nた！　むしろ大興奮です！"},
        { "location": "5694/Talk", "narrator": "ガブリエラ", "text": "……その代わり\nこっちは頭が痛く\nなってきたんだけど。"},
        { "location": "5695/Talk", "narrator": "つばめ", "text": "わたし、神楽ちゃんが\nここまでアレとは\n思ってなかったよ。"},
        { "location": "5696/Talk", "narrator": "アーヤ", "text": "せっかく良い話っぽい\n流れだったのに\n全部台無しね……。"},
        { "location": "5697/Talk", "narrator": "神楽", "text": "つばめさん、今から式場を\n予約しておきませんか？"},
        { "location": "5698/Talk", "narrator": "つばめ", "text": "この世界の日本でも女同士\nは結婚できないんだよ？"},
        { "location": "5699/Talk", "narrator": "神楽", "text": "むしろそこは今すぐ\n改変してください！\nつばめさんの力で！"},
        { "location": "5700/Talk", "narrator": "ガブリエラ", "text": "……お幸せに。"},
        { "location": "5701/Talk", "narrator": "アーヤ", "text": "仕方ないけれど、\nここは卯月に譲る\n流れみたいね。"},
        { "location": "5702/Talk", "narrator": "つばめ", "text": "面倒臭いからって\nわたしを見捨てようと\nしてませんか！？"},
        { "location": "5703/Talk", "narrator": "ガブリエラ", "text": "正に、その発想は無かった\nってヤツよね……。"},
        { "location": "5704/Talk", "narrator": "ガブリエラ", "text": "常識人のあたしからは\n神楽の思考は想像が\nつかないわ。"},
        { "location": "5705/Talk", "narrator": "ガブリエラ", "text": "じゃあ式の日取りが\n決まったら\n連絡ちょうだい。"}
    ]
}
