{
    "dir": "stream_270_ch01.json",
    "type": "watchanime",
    "info": {
    },
    "entry":
    [
        { "location": "5274/Talk", "narrator": "みやび", "text": "それやと、うちが紫で\n後から遅れて登場する\n追加キャラみたいや。"},
        { "location": "5275/Talk", "narrator": "ガブリエラ", "text": "アーヤはピッタリの\n青だからいいけど、\nあたしは冴えない緑？"},
        { "location": "5276/Talk", "narrator": "アーヤ", "text": "あと、黄色が卯月ね。\nカレー好きには\n見えないけど。"},
        { "location": "5277/Talk", "narrator": "つばめ", "text": "やっぱりわたしたち\n戦隊だったんですね！"},
        { "location": "5278/Talk", "narrator": "ガブリエラ", "text": "意図したって言うより\n要はテンプレよね。"},
        { "location": "5279/Talk", "narrator": "みやび", "text": "キミはリセットボタン\n押す猫かいな。"},
        { "location": "5280/Talk", "narrator": "ガブリエラ", "text": "猫がリセットボタン？\nどういうこと？"},
        { "location": "5281/Talk", "narrator": "アーヤ", "text": "昔のゲーム機は猫が\n踏みやすい位置に\nリセットがあったのよ。"},
        { "location": "5282/Talk", "narrator": "ガブリエラ", "text": "……なんでそれをアーヤや\nみやびが知ってるのよ？"},
        { "location": "5283/Talk", "narrator": "みやび", "text": "果物やトマトとかで\nやるやつやな。"},
        { "location": "5284/Talk", "narrator": "みやび", "text": "実の数を減らして\n養分を調整することで\n美味しい実がなると。"},
        { "location": "5285/Talk", "narrator": "つばめ", "text": "摘まないで育ててたら\n美味しくなるかも\n知れないのに？"},
        { "location": "5286/Talk", "narrator": "ガブリエラ", "text": "「かも知れない」に\n余計なコストを\nかけたくないわけよ。"},
        { "location": "5287/Talk", "narrator": "みやび", "text": "コストは有限やき\n無駄を省く言うんは\nわかるけんどね。"},
        { "location": "5288/Talk", "narrator": "つばめ", "text": "飼い殺し？　って\nどういうことですか？"},
        { "location": "5289/Talk", "narrator": "アーヤ", "text": "競合事務所に移られて\n人気が出てしまったら\n困るでしょ？"},
        { "location": "5290/Talk", "narrator": "アーヤ", "text": "だから、デビューを\nちらつかせながら\n引き留め続けるのよ。"},
        { "location": "5291/Talk", "narrator": "つばめ", "text": "それって結局ずっと\nデビューできないって\nことですか？"},
        { "location": "5292/Talk", "narrator": "ガブリエラ", "text": "ええ、だから文字通り\n「飼い殺し」"},
        { "location": "5293/Talk", "narrator": "みやび", "text": "人っちゅうんは金の為\nならえげつなくなれる\nもんやき。"},
        { "location": "5294/Talk", "narrator": "アーヤ", "text": "お金が欲しくて、\n結局お金に支配されてる\nってことよね。"},
        { "location": "5295/Talk", "narrator": "アーヤ", "text": "つばめは心配だけど\n最後の小包がとても\n気になるわね。"},
        { "location": "5296/Talk", "narrator": "アーヤ", "text": "あの姉がわざわざ送り\nつけて来た物となると\n一波乱ありそうね。"},
        { "location": "5297/Talk", "narrator": "アーヤ", "text": "期待とは違う意味で\n次回を早く観たい\n気持ちが高まるわ。"},
        { "location": "5298/Talk", "narrator": "みやび", "text": "薄々感づいちょったと\n思うけど、映像の中の\n世界は不可解やね。"},
        { "location": "5299/Talk", "narrator": "みやび", "text": "パラレルちゅうよりは\n「一周目の世界」とか\nなんかね？"},
        { "location": "5300/Talk", "narrator": "みやび", "text": "そうやとしたら\nこっちのうちらは\n何週目なんやろな？"},
        { "location": "5301/Talk", "narrator": "ガブリエラ", "text": "クライマックス感が\n出て来たじゃないの。\n上等よ。"},
        { "location": "5302/Talk", "narrator": "ガブリエラ", "text": "わけわかんないことに\n振り回されるだけじゃ\nつまんないし。"},
        { "location": "5303/Talk", "narrator": "ガブリエラ", "text": "ハッピーエンドは\n必ずあたしが\n射止めてみせるから。"},
        { "location": "5304/Talk", "narrator": "つばめ", "text": "遂に始まりましたよ！\nわたし続きが気になり\n過ぎてドキドキです！"},
        { "location": "5305/Talk", "narrator": "ガブリエラ", "text": "あー……。\nごめん、つばめ。"},
        { "location": "5306/Talk", "narrator": "つばめ", "text": "ふえっ？"},
        { "location": "5307/Talk", "narrator": "ガブリエラ", "text": "聞いた話だと、\n今回つばめの出番は\nないみたいよ。"},
        { "location": "5308/Talk", "narrator": "つばめ", "text": "えぇーっ！？\nそれっておかしくない！？"},
        { "location": "5309/Talk", "narrator": "つばめ", "text": "わたし、あの後、一体\nどうなっちゃったのか\n気になり過ぎだよ！？"},
        { "location": "5310/Talk", "narrator": "つばめ", "text": "ていうか出番ないなら\nわたしどうしてここに\n呼ばれたの！？"},
        { "location": "5311/Talk", "narrator": "つばめ", "text": "神楽ちゃんは\n呼ばれないのに……。"},
        { "location": "5312/Talk", "narrator": "アーヤ", "text": "つばめ、主人公が\nそんなことを\n言ったらダメよ。"},
        { "location": "5313/Talk", "narrator": "みやび", "text": "アーヤもいきなり\nメタなところから\n入りよったな。"},
        { "location": "5314/Talk", "narrator": "みやび", "text": "まぁ、うちら三人だけ\nやとしまらんきに、\nそこは勘弁したって。"},
        { "location": "5315/Talk", "narrator": "ガブリエラ", "text": "あら、あたしは\nあたし一人でも\n構わないんだけど？"},
        { "location": "5316/Talk", "narrator": "みやび", "text": "ガブちゃん強がりは\nほどほどにな。\nまた枕を涙で濡らすぞね。"},
        { "location": "5317/Talk", "narrator": "ガブリエラ", "text": "濡らしたことなんて\nないわよっ！！"},
        { "location": "5318/Talk", "narrator": "アーヤ", "text": "つばめ、卯月の分も\n頑張るんだって\n意気込んでたでしょ？"},
        { "location": "5319/Talk", "narrator": "つばめ", "text": "そ、そうですよね！\n主人公のわたしが\nがんばらないと！"},
        { "location": "5320/Talk", "narrator": "ガブリエラ", "text": "主人公がどうとかは\nこの際置いといて\n欲しいんだけど……。"},
        { "location": "5321/Talk", "narrator": "つばめ", "text": "あっ、だからわたしの\nトライガジェットって\n赤かったんですね！"},
        { "location": "5322/Talk", "narrator": "アーヤ", "text": "……本当に\nそんな理由だったら、\nどうしよう……。"},
        { "location": "5323/Talk", "narrator": "みやび", "text": "おや？　\n今回は止めるんがやたら\n早いんと違う？"},
        { "location": "5324/Talk", "narrator": "ガブリエラ", "text": "まだ始まってもいない\nところで止められても\n話すことないわよ？"},
        { "location": "5325/Talk", "narrator": "つばめ", "text": "あっ、わかった。\nなんで止めたかクイズ\nですね？"},
        { "location": "5326/Talk", "narrator": "みやび", "text": "案外、この先の映像は\n出来てない言うオチかも\nしれんよ？"},
        { "location": "5327/Talk", "narrator": "アーヤ", "text": "みやび、微妙にシャレに\nなっていない話はやめな\nさい……。"},
        { "location": "5328/Talk", "narrator": "みやび", "text": "とか言ってたら\n始まったぞね。"},
        { "location": "5329/Talk", "narrator": "つばめ", "text": "関越自動車道・下りの\n上里サービスエリア？"},
        { "location": "5330/Talk", "narrator": "ガブリエラ", "text": "停まってるのは、まほが\n乗ってる車みたいね。"},
        { "location": "5331/Talk", "narrator": "みやび", "text": "まほさん、うちらを\n中央自動車道で\n遠回りさせておいて"},
        { "location": "5332/Talk", "narrator": "みやび", "text": "自分は関越自動車道で\n向かってたんやね。"},
        { "location": "5333/Talk", "narrator": "ガブリエラ", "text": "ていうかなんか何気に\nすごいこと言われてない？"},
        { "location": "5334/Talk", "narrator": "ガブリエラ", "text": "まほは清々しくても\nあたしは腹立たしいわよ！"},
        { "location": "5335/Talk", "narrator": "つばめ", "text": "ていうか、この白い子\n一体誰なの？\nすごく偉そうにしてるし。"},
        { "location": "5336/Talk", "narrator": "みやび", "text": "まほさんの上司的な\n立場っぽいけんど\nどうなんやろ？"},
        { "location": "5337/Talk", "narrator": "アーヤ", "text": "上司と言うよりは\n情報管理庁の\n長官っぽいわね。"},
        { "location": "5338/Talk", "narrator": "みやび", "text": "うちらをかばって\nそないな相手にケンカ\n売るなんて流石やね。"},
        { "location": "5339/Talk", "narrator": "ガブリエラ", "text": "ねぇ、首都圏って\n言ってるけど上里ＳＡ\nの時点で──"},
        { "location": "5340/Talk", "narrator": "アーヤ", "text": "ギャヴィ、そこまで！\n埼玉県は首都圏よ。\n首都圏だから。"},
        { "location": "5341/Talk", "narrator": "つばめ", "text": "ア、アーヤさん……？"},
        { "location": "5342/Talk", "narrator": "みやび", "text": "デリケートな問題には\n全力フォロー。\nリーダーの鏡ぞね。"},
        { "location": "5343/Talk", "narrator": "つばめ", "text": "ところでわたしって、\nトロいの一言だけで\n置いてけぼり！？"},
        { "location": "5344/Talk", "narrator": "ガブリエラ", "text": "つばめの犠牲は決して無駄\nにはしないわ。安心して。"},
        { "location": "5345/Talk", "narrator": "つばめ", "text": "やだやだ！\nわたし犠牲になんて\nなりたくないよぉ！"},
        { "location": "5346/Talk", "narrator": "アーヤ", "text": "そうは言われても\nこの映像だとつばめの\n状況はわからないし。"},
        { "location": "5347/Talk", "narrator": "ガブリエラ", "text": "わかったところで\nあたしたちにどうしろと。"},
        { "location": "5348/Talk", "narrator": "みやび", "text": "きっと画面に向かって\n応援すると、窮地を\n脱する仕組みぞね。"},
        { "location": "5349/Talk", "narrator": "つばめ", "text": "わたし、がんばって！\n早く出て来て！\nがんばれ、がんばれ！"},
        { "location": "5350/Talk", "narrator": "ガブリエラ", "text": "まるで日曜朝の\nＴＶにかじりついてる\n子供ね……。"},
        { "location": "5351/Talk", "narrator": "つばめ", "text": "……はうっ！\nちょっと待って！\n何かの予感が！"},
        { "location": "5352/Talk", "narrator": "アーヤ", "text": "これは、音羽の\n回想シーンかしら？"},
        { "location": "5353/Talk", "narrator": "ガブリエラ", "text": "あっ、神楽。"},
        { "location": "5354/Talk", "narrator": "つばめ", "text": "神楽ちゃん来たーっ！\nてことは？\nことはーっ！？"},
        { "location": "5355/Talk", "narrator": "アーヤ", "text": "ちょ、ちょっと\n落ち着いて、つばめ。"},
        { "location": "5356/Talk", "narrator": "みやび", "text": "それは無理ぞね。\nこれってメノウの\n誕生秘話的なのやろ？"},
        { "location": "5357/Talk", "narrator": "つばめ", "text": "きゃーっ！！\n神楽ちゃーん！！\nメノウちゃーん！！"},
        { "location": "5358/Talk", "narrator": "ガブリエラ", "text": "無理って言うか\nもう手遅れって\n感じね……。"},
        { "location": "5359/Talk", "narrator": "つばめ", "text": "わたし、これだけでも\n今日ここに来た価値が\nあったよ！"},
        { "location": "5360/Talk", "narrator": "アーヤ", "text": "そ、そう……？\nよかったわね……。"},
        { "location": "5361/Talk", "narrator": "つばめ", "text": "……ステキだなぁ。\n二人はライバルであり\n親友だったんだ……。"},
        { "location": "5362/Talk", "narrator": "ガブリエラ", "text": "でも音羽って結局発症\nしたんだから、鬱憤も\n溜まってたわけよね？"},
        { "location": "5363/Talk", "narrator": "つばめ", "text": "うぅっ……。\nでも確かにこことか、\nどういうことなのかな？"},
        { "location": "5364/Talk", "narrator": "つばめ", "text": "このまま二人一緒に\nデビューしてたら\nステキだったのに。"},
        { "location": "5365/Talk", "narrator": "アーヤ", "text": "……さて、いよいよ\n私たちの逃走劇も\n本格的に始まるわよ。"},
        { "location": "5366/Talk", "narrator": "ガブリエラ", "text": "ていうか、まだ八王子\nって、まほに比べて\n遅れすぎてない？"},
        { "location": "5367/Talk", "narrator": "みやび", "text": "うちらは立て籠もり\nしろ言われてたところ\nからやし仕方ない。"},
        { "location": "5368/Talk", "narrator": "つばめ", "text": "あのー、その逃走劇、\n大事な誰かさんを\n忘れてませんかー？"},
        { "location": "5369/Talk", "narrator": "みやび", "text": "つばめちゃんは置いて\n来た。この闘いには\nついていけない。"},
        { "location": "5370/Talk", "narrator": "つばめ", "text": "わたしってもしかして\nみんなを逃がすための\nおとり？　生け贄！？"},
        { "location": "5371/Talk", "narrator": "アーヤ", "text": "ところでそろそろ\n松代アピールタイムの\nようね。"},
        { "location": "5372/Talk", "narrator": "ガブリエラ", "text": "……は？"},
        { "location": "5373/Talk", "narrator": "アーヤ", "text": "松代と言えば近年は\n某大河ドラマの影響で\n知名度が上がったけど"},
        { "location": "5374/Talk", "narrator": "アーヤ", "text": "戦史マニアには\n松代大本営の方が\n有名かしら？"},
        { "location": "5375/Talk", "narrator": "みやび", "text": "うちは松代言うたら\n日本のピラミッドやな。"},
        { "location": "5376/Talk", "narrator": "ガブリエラ", "text": "何それ？\n日本にピラミッドが\nあったの？"},
        { "location": "5377/Talk", "narrator": "アーヤ", "text": "皆神山のことね。\n松代大本営の地下坑道\nがあったのもそこよ。"},
        { "location": "5378/Talk", "narrator": "みやび", "text": "松代よりもここからは\nうちがＮシステムに\nついて解説するぞね。"},
        { "location": "5379/Talk", "narrator": "アーヤ", "text": "みやび、勝手なことは\nしないで。まだ松代の\n魅力の１％も──"},
        { "location": "5380/Talk", "narrator": "ガブリエラ", "text": "Ｎシステムより裏ロム\nについて語ってるじゃ\nないのよ。"},
        { "location": "5381/Talk", "narrator": "つばめ", "text": "きゃーっ！\nメノウちゃんの\nライブーっ！！"},
        { "location": "5382/Talk", "narrator": "ガブリエラ", "text": "つばめ、話に入れない\nからって強引過ぎ。"},
        { "location": "5383/Talk", "narrator": "つばめ", "text": "その通りだけど、\nわたしだって\nお話したいよぉ～。"},
        { "location": "5384/Talk", "narrator": "アーヤ", "text": "大丈夫。次回はきっと\nつばめが輝くから\n今回は我慢するのよ。"},
        { "location": "5385/Talk", "narrator": "つばめ", "text": "うぅ～……。\n本当ですかぁ～？"},
        { "location": "5386/Talk", "narrator": "ガブリエラ", "text": "切ってって言うなんて\n誰からだと思ったの？\nアーヤのお姉さん？"},
        { "location": "5387/Talk", "narrator": "みやび", "text": "そらエリカさんでもないと\nこんな芸当出来んやき。"},
        { "location": "5388/Talk", "narrator": "みやび", "text": "それにしても、\n何でこの映像のうちは\nエリカさん知らんち？"},
        { "location": "5389/Talk", "narrator": "アーヤ", "text": "異世界程じゃないけど\n似て非なる世界って\nことなのかしら？"},
        { "location": "5390/Talk", "narrator": "みやび", "text": "けんど、なんでわざわざ\nそんな異世界版の映像を\n見せるがね？"},
        { "location": "5391/Talk", "narrator": "アーヤ", "text": "何となくだけど、映像だけ\n見てる人って、姉の名前、\nここが初出じゃない？"},
        { "location": "5392/Talk", "narrator": "みやび", "text": "おお、確かに。映像だけ組\nやと、エリカさん知ってる\n前提やとおいてきぼりや。"},
        { "location": "5393/Talk", "narrator": "つばめ", "text": "あの、すみません。\nさっきから何の話\nなのかさっぱりで。"},
        { "location": "5394/Talk", "narrator": "ガブリエラ", "text": "だからぁ、どんな視聴者も\nちゃんと楽しめるように\n配慮してるってことよ。"},
        { "location": "5395/Talk", "narrator": "ガブリエラ", "text": "なんであたしがつばめに\n解説してあげなくちゃ\nいけないのよ…もう。"},
        { "location": "5396/Talk", "narrator": "みやび", "text": "文句言いつつも、ちゃんと\nつばめちゃんをエスコート\nするガブちゃんラヴや。"},
        { "location": "5397/Talk", "narrator": "アーヤ", "text": "ギャヴィは後輩思いの\n優しい子なんだから\n当然よ？"},
        { "location": "5398/Talk", "narrator": "つばめ", "text": "ていうかガブちゃんの\n冗談かと思ってたら\n本当に出番なかった！"},
        { "location": "5399/Talk", "narrator": "つばめ", "text": "わたし本当にこれでも\n主人公なんですか？\nどうなんですか？"},
        { "location": "5400/Talk", "narrator": "つばめ", "text": "……もしかして\n『真の主人公』が\n別にいるとか……？"}
    ]
}
