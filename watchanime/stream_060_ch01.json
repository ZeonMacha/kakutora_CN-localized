{
    "dir": "stream_060_ch01.json",
    "type": "watchanime",
    "info": {
    },
    "entry":
    [
        { "location": "911/Talk" , "narrator": "みやび", "text": "そう、\nフラグが立つまで\n焦りは禁物やき。"},
        { "location": "912/Talk" , "narrator": "ガブリエラ", "text": "好感度も\n足りてないしね。"},
        { "location": "913/Talk" , "narrator": "つばめ", "text": "なるほどっ！"},
        { "location": "914/Talk" , "narrator": "アーヤ", "text": "人を恋愛ゲームの\n攻略ヒロインみたいに\n言わないでよ……。"},
        { "location": "915/Talk" , "narrator": "つばめ", "text": "そ、そうですねっ！"},
        { "location": "916/Talk" , "narrator": "つばめ", "text": "あ、あのっ、それで、\nアーヤさんのおね、\nおね、おね……。"},
        { "location": "917/Talk" , "narrator": "アーヤ", "text": "何かしら？"},
        { "location": "918/Talk" , "narrator": "つばめ", "text": "お、おね……、\nお……お姉ちゃんって\n呼んでもいいですか？"},
        { "location": "919/Talk" , "narrator": "アーヤ", "text": "……か、\n考えとくわ……。"},
        { "location": "920/Talk" , "narrator": "アーヤ", "text": "べ、べつに\n期待されたって\n何も無いわよ？"},
        { "location": "921/Talk" , "narrator": "アーヤ", "text": "ただの励ましだって\n言ったでしょ？"},
        { "location": "922/Talk" , "narrator": "みやび", "text": "でも火の無い所に\n煙は立たん言うき、\n多少はな？"},
        { "location": "923/Talk" , "narrator": "ガブリエラ", "text": "……何か面白くない。"},
        { "location": "924/Talk" , "narrator": "みやび", "text": "おぉっ？　さっそく\n三角関係やな。\nええよええよ～。"},
        { "location": "925/Talk" , "narrator": "アーヤ", "text": "こら、みやびっ！"},
        { "location": "926/Talk" , "narrator": "ガブリエラ", "text": "それ、知ってるわ。\n昔のマンガで\nよくあるやつよね。"},
        { "location": "927/Talk" , "narrator": "ガブリエラ", "text": "二人見つめ合って\nポワワワワンって\nなるの。"},
        { "location": "928/Talk" , "narrator": "アーヤ", "text": "どこでそんな物を\n見たのよ……。"},
        { "location": "929/Talk" , "narrator": "つばめ", "text": "せんぱい、漫画に\n詳しいんですね。\n今度何か貸してください！"},
        { "location": "930/Talk" , "narrator": "ガブリエラ", "text": "あたしが持ってるのは\n英語とかフランス語の\nだけど、いいの？"},
        { "location": "931/Talk" , "narrator": "つばめ", "text": "えっ……。\nあ、あはははは……。"},
        { "location": "932/Talk" , "narrator": "アーヤ", "text": "……ちなみにだけど、\n私はキャラ付け？的に\n何に分類されるの？"},
        { "location": "933/Talk" , "narrator": "アーヤ", "text": "……クーデレ？\nよくわからないけど\n何か違う気がするわ。"},
        { "location": "934/Talk" , "narrator": "アーヤ", "text": "あっ、待って！\nまだ考えがっ！"},
        { "location": "935/Talk" , "narrator": "みやび", "text": "うちはまぁ、\nにぎやかし？\nちゅうやつ？"},
        { "location": "936/Talk" , "narrator": "みやび", "text": "お色気担当でも\nええんよ？"},
        { "location": "937/Talk" , "narrator": "みやび", "text": "君の好みに\n合わせちゃるけん、\n言うてみ？"},
        { "location": "938/Talk" , "narrator": "ガブリエラ", "text": "とにかく、あたしを\nツンデレって\n決めつけるなっ！"},
        { "location": "939/Talk" , "narrator": "ガブリエラ", "text": "そ、それに、べつに\nツンツンなんて\nしてないし？"},
        { "location": "940/Talk" , "narrator": "ガブリエラ", "text": "あっ、な、何、\n笑ってんのよ、\nこらぁっ！"},
        { "location": "941/Talk" , "narrator": "つばめ", "text": "こんにちは、つばめです。\n毎回グダグダな感じで\nごめんなさい…。"},
        { "location": "942/Talk" , "narrator": "つばめ", "text": "でも今回は、ちゃんと\n真面目にやろうと思って\n早く来ました！"},
        { "location": "943/Talk" , "narrator": "つばめ", "text": "わたしもみやびさんと\n同じで、OPの歌と絵が\n気になってるから――"},
        { "location": "944/Talk" , "narrator": "つばめ", "text": "わたしなりに、\n色々と考察してみたいと\n思います！"},
        { "location": "945/Talk" , "narrator": "みやび", "text": "おおっ！　つばめちゃん！\nついにアンダーグラウンド\nに目覚めたんやね。"},
        { "location": "946/Talk" , "narrator": "みやび", "text": "ほんだら今回は、\nつばめちゃんの考察を\n聞いてみる事にするぞね。"},
        { "location": "947/Talk" , "narrator": "つばめ", "text": "はいっ！"},
        { "location": "948/Talk" , "narrator": "つばめ", "text": "わたしが一番\n気になってるのは――"},
        { "location": "949/Talk" , "narrator": "つばめ", "text": "サビの最後の方にある\n『もう何でもいいの\n嘘もホントも』です！"},
        { "location": "950/Talk" , "narrator": "みやび", "text": "ふむふむ。\nその理由は？"},
        { "location": "951/Talk" , "narrator": "つばめ", "text": "わたし、いつも\nそうなんですよね。"},
        { "location": "952/Talk" , "narrator": "みやび", "text": "なにが？"},
        { "location": "953/Talk" , "narrator": "つばめ", "text": "イチゴのミルフィーユが\n大好物だから、もらえると\n何でもよくなっちゃって！"},
        { "location": "954/Talk" , "narrator": "つばめ", "text": "わたしの悪口言ってる子が\nいたりしても、その子が\nごちそうしてくれたら――"},
        { "location": "955/Talk" , "narrator": "つばめ", "text": "もう、ホントに悪口言って\nたとしても、どうでもいい\nやって思っちゃうんです！"},
        { "location": "956/Talk" , "narrator": "みやび", "text": "つばめちゃん、\nちょろ……"},
        { "location": "957/Talk" , "narrator": "つばめ", "text": "え？"},
        { "location": "958/Talk" , "narrator": "みやび", "text": "いや、まっこと\nピュアでおぼこい子やね。"},
        { "location": "959/Talk" , "narrator": "ガブリエラ", "text": "またくだらない話でも\nしてたのかしら？"},
        { "location": "960/Talk" , "narrator": "つばめ", "text": "あ、せんぱい！\nちがいますよ、わたしが\nOP考察をしてたんです！"},
        { "location": "961/Talk" , "narrator": "アーヤ", "text": "へぇ、そうなの。\n何か新しい発見でも\nあった？"},
        { "location": "962/Talk" , "narrator": "みやび", "text": "ん？\nうむ、まあ……\n割と参考になったね。"},
        { "location": "963/Talk" , "narrator": "ガブリエラ", "text": "へぇ、意外ね。"},
        { "location": "964/Talk" , "narrator": "みやび", "text": "おお、ほれ、\n今回も始まったぞね。"},
        { "location": "965/Talk" , "narrator": "みやび", "text": "あの素晴らしい\n拉致を\nもう一度～♪"},
        { "location": "966/Talk" , "narrator": "アーヤ", "text": "犯罪みたいに\n言わないで\nちょうだい。"},
        { "location": "967/Talk" , "narrator": "アーヤ", "text": "仕事、いえ、\n任務なんだから。"},
        { "location": "968/Talk" , "narrator": "みやび", "text": "それやったら、\nうちのことも\n迎えに来ちゃあせんかね。"},
        { "location": "969/Talk" , "narrator": "アーヤ", "text": "……任せたわ、\nギャヴィ。"},
        { "location": "970/Talk" , "narrator": "ガブリエラ", "text": "何であたしっ！？"},
        { "location": "971/Talk" , "narrator": "ガブリエラ", "text": "それにしてもここ、\n急いでるからって\n運転荒すぎ！"},
        { "location": "972/Talk" , "narrator": "アーヤ", "text": "緊急時走行だから\nスピードは出てたけど\n荒くはないでしょ？"},
        { "location": "973/Talk" , "narrator": "アーヤ", "text": "シートベルトを\nちゃんとしていない\nからよ。"},
        { "location": "974/Talk" , "narrator": "みやび", "text": "よい子のみんなは\n後席でもちゃんと\nシートベルトしよな。"},
        { "location": "975/Talk" , "narrator": "ガブリエラ", "text": "何か公共ＣＭみたいに\nなってるんだけど！？"},
        { "location": "976/Talk" , "narrator": "みやび", "text": "はい、ここから\n解説モードやき\n静聴ーっ。"},
        { "location": "977/Talk" , "narrator": "ガブリエラ", "text": "何か基本的なことしか\n言ってないけど。"},
        { "location": "978/Talk" , "narrator": "アーヤ", "text": "逢瀬さんに\n教えてるんだから\n当たり前でしょ。"},
        { "location": "979/Talk" , "narrator": "みやび", "text": "６日前の入隊で\nいきなり現場に\n連れて来たんやきね。"},
        { "location": "980/Talk" , "narrator": "アーヤ", "text": "本来なら最低限の\n教練は受させたかった\nところだしね。"},
        { "location": "981/Talk" , "narrator": "アーヤ", "text": "最低でも二週間は\nみっちりと\n朝から晩まで、ね。"},
        { "location": "982/Talk" , "narrator": "つばめ", "text": "ひ、ひえっ！？"},
        { "location": "983/Talk" , "narrator": "つばめ", "text": "ぶ、ぶっつけ本番も\n悪くないんじゃ\nないですかね～……？"},
        { "location": "984/Talk" , "narrator": "ガブリエラ", "text": "で、まだ説明続くの？\n長くない？"},
        { "location": "985/Talk" , "narrator": "アーヤ", "text": "これでも、逢瀬さんが\nすぐ飲み込めるように\n要点だけ話してるわ。"},
        { "location": "986/Talk" , "narrator": "みやび", "text": "つばめちゃん、\nようわかった？"},
        { "location": "987/Talk" , "narrator": "つばめ", "text": "え、えーと……。\nあはは……。"},
        { "location": "988/Talk" , "narrator": "アーヤ", "text": "どうやら、後で\n補習が必要なようね。"},
        { "location": "989/Talk" , "narrator": "つばめ", "text": "ひぇぇぇ～……。\nうっ、で、でも確かに\n理解してないと……。"},
        { "location": "990/Talk" , "narrator": "つばめ", "text": "でも補習はぁ～……。"},
        { "location": "991/Talk" , "narrator": "みやび", "text": "まぁ、言うてる通り、\nチームプレイやき、\n何とかなるぞね。"},
        { "location": "992/Talk" , "narrator": "つばめ", "text": "でも、謎の力とか\n言われちゃって\nますけど……。"},
        { "location": "993/Talk" , "narrator": "ガブリエラ", "text": "そりゃ昨日の今日で\n仲間って言われても\n連携取りづらいし。"},
        { "location": "994/Talk" , "narrator": "みやび", "text": "つばめちゃん、\n気にすること\n無いって。"},
        { "location": "995/Talk" , "narrator": "みやび", "text": "最初はちょっと\nギスギス感あるのも\nお約束やき。"},
        { "location": "996/Talk" , "narrator": "ガブリエラ", "text": "あたしを\nツンデレみたいに\n言わないでよっ！"},
        { "location": "997/Talk" , "narrator": "つばめ", "text": "ところでアーヤさんの\nお姉さんって、\nどんな人なんですか？"},
        { "location": "998/Talk" , "narrator": "アーヤ", "text": "姉……と呼べる人\nなんていないわ。\nそう言ったでしょ？"},
        { "location": "999/Talk" , "narrator": "つばめ", "text": "え、えーと……。"},
        { "location": "1000/Talk", "narrator": "みやび", "text": "まぁ、そこは\n慌てんとき。"},
        { "location": "1001/Talk", "narrator": "ガブリエラ", "text": "地雷っぽいしね。"},
        { "location": "1002/Talk", "narrator": "アーヤ", "text": "あのねぇ……。"},
        { "location": "1003/Talk", "narrator": "つばめ", "text": "ドームの次は\n学校……。"},
        { "location": "1004/Talk", "narrator": "つばめ", "text": "フェノメノンって\n人が多い所で\n起きるんですか？"},
        { "location": "1005/Talk", "narrator": "アーヤ", "text": "そうとは限らないわ。"},
        { "location": "1006/Talk", "narrator": "ガブリエラ", "text": "人が多ければそれだけ\n発症する確率も上がる\nってだけのことよね。"},
        { "location": "1007/Talk", "narrator": "つばめ", "text": "この、チュートリアル\nステージってのは？"},
        { "location": "1008/Talk", "narrator": "ガブリエラ", "text": "ただちょっと\nゲームっぽく\n言ってみただけよ。"},
        { "location": "1009/Talk", "narrator": "ガブリエラ", "text": "べつに他意なんて\n無いんだから\n気にしないでよね！"},
        { "location": "1010/Talk", "narrator": "みやび", "text": "ほらな？\nツンデレやろ？"},
        { "location": "1011/Talk", "narrator": "ガブリエラ", "text": "違うからっ！"},
        { "location": "1012/Talk", "narrator": "アーヤ", "text": "さぁ、現場に\n到着したわよ。"},
        { "location": "1013/Talk", "narrator": "みやび", "text": "右も左もわからぬまま\n戦場に放り込まれた\n少女の運命や如何に。"},
        { "location": "1014/Talk", "narrator": "つばめ", "text": "あっ、\n正にそんな感じです。\nこの時のわたし。"},
        { "location": "1015/Talk", "narrator": "ガブリエラ", "text": "思うんだけど、これ\n毎回整列して出迎え\nしなくてもよくない？"},
        { "location": "1016/Talk", "narrator": "アーヤ", "text": "それだけ\n私たちの任務が\n重要ってことよ。"},
        { "location": "1017/Talk", "narrator": "つばめ", "text": "あれ？　今回は隊員の\n人たち、背中を向けて\n整列してませんよね？"},
        { "location": "1018/Talk", "narrator": "ガブリエラ", "text": "そこに\n気づくとは……。"},
        { "location": "1019/Talk", "narrator": "アーヤ", "text": "そ、それは……、\n現場の隊長の\n判断と言うことでっ。"},
        { "location": "1020/Talk", "narrator": "みやび", "text": "それより、何なんこの\nキャッキャウフフな\nシーンは？"},
        { "location": "1021/Talk", "narrator": "みやび", "text": "見ちゅうこっちが\n恥ずかしなるき。"},
        { "location": "1022/Talk", "narrator": "アーヤ", "text": "こ、これは、\n逢瀬さんの緊張を\nほぐすためでっ。"},
        { "location": "1023/Talk", "narrator": "つばめ", "text": "でも確かにこの時は\nアーヤさんに太鼓判を\n押されて、"},
        { "location": "1024/Talk", "narrator": "つばめ", "text": "ちょっと嬉しくて\n舞い上がっちゃって\nました。"},
        { "location": "1025/Talk", "narrator": "みやび", "text": "そんですぐ現実の\n厳しさを知るっちゅう\nこっちゃな。"},
        { "location": "1026/Talk", "narrator": "つばめ", "text": "はい、短い\n嬉しさでした……。"},
        { "location": "1027/Talk", "narrator": "ガブリエラ", "text": "もう、しゃっきり\nしなさいよっ！"},
        { "location": "1028/Talk", "narrator": "ガブリエラ", "text": "前回は頑張るどころか\n暴走しまくってたじゃ\nないの。"},
        { "location": "1029/Talk", "narrator": "つばめ", "text": "あれはメノウちゃんを\n助けるため\nだったから……。"},
        { "location": "1030/Talk", "narrator": "ガブリエラ", "text": "あんたってニンジンが\n無いと頑張れない\nタイプなの？"},
        { "location": "1031/Talk", "narrator": "ガブリエラ", "text": "ま、こっちの足を\n引っ張らない限りは\nいいけど。"},
        { "location": "1032/Talk", "narrator": "ガブリエラ", "text": "……って、\nツンデレじゃ\nないからっ！"},
        { "location": "1033/Talk", "narrator": "みやび", "text": "うわ、先手\n打たれちょったわ。"},
        { "location": "1034/Talk", "narrator": "ガブリエラ", "text": "新人、この時って\nまだそういうの教えて\nもらってなかったの？"},
        { "location": "1035/Talk", "narrator": "つばめ", "text": "ううん、装備をアクティ…\nなんとかした時に、\n説明は聞いてたんだけど。"},
        { "location": "1036/Talk", "narrator": "つばめ", "text": "でも気が動転して\n頭の中が真っ白に\nなっちゃって……。"},
        { "location": "1037/Talk", "narrator": "ガブリエラ", "text": "まぁ、いきなりの\n実戦だったし、\n一応同情はするけど。"},
        { "location": "1038/Talk", "narrator": "アーヤ", "text": "私ももっと落ち着いて\n対応すべきだったわ。\n反省ね。"},
        { "location": "1039/Talk", "narrator": "ガブリエラ", "text": "で、この時って、また\nこの前みたいに\n当たったけど無傷？"},
        { "location": "1040/Talk", "narrator": "つばめ", "text": "あっ、これはそんな\n謎っぽい力じゃなくて"},
        { "location": "1041/Talk", "narrator": "つばめ", "text": "当たる寸前に横から\n何かが飛んで来て、"},
        { "location": "1042/Talk", "narrator": "つばめ", "text": "それとあれとが\nドーン！\nってなって。"},
        { "location": "1043/Talk", "narrator": "みやび", "text": "卯月が何かを飛ばして\nつばめちゃんを助けた\nっちゅうわけやね。"},
        { "location": "1044/Talk", "narrator": "アーヤ", "text": "それは本人に聞いて\nみるのが一番ね。"},
        { "location": "1045/Talk", "narrator": "ガブリエラ", "text": "というわけで次回から\nこの思わせぶりに\n登場した謎の女、"},
        { "location": "1046/Talk", "narrator": "ガブリエラ", "text": "神楽が本格参戦する\nみたいだから、\n楽しみにしてたら？"},
        { "location": "1047/Talk", "narrator": "みやび", "text": "ガブちゃん、ほがな\nあからさまに嫌そうに\n言わんでも。"},
        { "location": "1048/Talk", "narrator": "ガブリエラ", "text": "だって美味しいトコ\n持ってかれるのは\nシャクじゃないの！"},
        { "location": "1049/Talk", "narrator": "ガブリエラ", "text": "べつに嫌ってる\nとかじゃないけど、\nそんな感じ！"},
        { "location": "1050/Talk", "narrator": "つばめ", "text": "あっ、やっぱり\nツンデレなんですね。"},
        { "location": "1051/Talk", "narrator": "みやび", "text": "ツンデレやね。"},
        { "location": "1052/Talk", "narrator": "アーヤ", "text": "なるほど。\nこれがツンデレと\nいうものなのね。"},
        { "location": "1053/Talk", "narrator": "ガブリエラ", "text": "違うってばっ！\nツンデレって\n言うなぁーっ！！"},
        { "location": "1054/Talk", "narrator": "つばめ", "text": "せんぱいと仲良く\nなるにはどうしたら\nいいのかな？"},
        { "location": "1055/Talk", "narrator": "つばめ", "text": "せんぱい、漫画とか\nゲーム好きそうだけど\nわたし詳しくなくて。"},
        { "location": "1056/Talk", "narrator": "つばめ", "text": "今度、色々\n教えてくださいね？"}
    ]
}
