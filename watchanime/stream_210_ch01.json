{
    "dir": "stream_210_ch01.json",
    "type": "watchanime",
    "info": {
    },
    "entry":
    [
        { "location": "4228/Talk", "narrator": "ガブリエラ", "text": "ちょっと待ちなさい！\nじゃあなんでみやびの\n時だけ止めるのよ？"},
        { "location": "4229/Talk", "narrator": "つばめ", "text": "みやびさんがお色気\n担当だからじゃ\nないんですか？"},
        { "location": "4230/Talk", "narrator": "ガブリエラ", "text": "だとしても！　ここは\n全員順々に止めて見る\nところでしょ！"},
        { "location": "4231/Talk", "narrator": "アーヤ", "text": "ええ、同意するわ。\n私はともかくつばめや\nギャヴィや卯月の"},
        { "location": "4232/Talk", "narrator": "アーヤ", "text": "可愛らしい水着姿も\nじっくり鑑賞するのが\n当然の義務よね。"},
        { "location": "4233/Talk", "narrator": "つばめ", "text": "えっ、わたしはべつに\nそこまでしなくても\nいいんですけど……。"},
        { "location": "4234/Talk", "narrator": "みやび", "text": "競泳用ちゅうか\nこれは学校の授業で\n使ってるのやき。"},
        { "location": "4235/Talk", "narrator": "みやび", "text": "合宿の為にわざわざ\n新調するのも\n面倒臭かったきに。"},
        { "location": "4236/Talk", "narrator": "つばめ", "text": "……みやびさん、\n意外とあざといですね。"},
        { "location": "4237/Talk", "narrator": "みやび", "text": "ようわからんきに\nつばめちゃんに\nあざとい言われるんは"},
        { "location": "4238/Talk", "narrator": "みやび", "text": "なんや納得がいかんち！"},
        { "location": "4239/Talk", "narrator": "つばめ", "text": "……みやびさんの中の\nわたしのイメージ\nひどくないですか？"},
        { "location": "4240/Talk", "narrator": "みやび", "text": "ふっふっふっ。\n気づいてもうたね。"},
        { "location": "4241/Talk", "narrator": "みやび", "text": "それはブルーレイ版の\n特典映像やき\n期待しちょってな。"},
        { "location": "4242/Talk", "narrator": "つばめ", "text": "それは、あざといを\n通り越してえげつないです！"},
        { "location": "4243/Talk", "narrator": "みやび", "text": "いややわ～。\nせめて商売上手\n言うてや～。"},
        { "location": "4244/Talk", "narrator": "ガブリエラ", "text": "ていうかそれ、ちゃんと\n冗談ですって言わないと\n収拾つかなくなるわよ。"},
        { "location": "4245/Talk", "narrator": "アーヤ", "text": "そうね。\nみやびの戯れ言だから、\n本気にしないでね？"},
        { "location": "4246/Talk", "narrator": "つばめ", "text": "パンツって\n宙を舞うんですね。\n初めて見ました！"},
        { "location": "4247/Talk", "narrator": "ガブリエラ", "text": "この「あ～れ～」って\nセリフはなんなのよ？"},
        { "location": "4248/Talk", "narrator": "みやび", "text": "それはあれや、\nよいではないか～的な\nお約束ちゅうやつで。"},
        { "location": "4249/Talk", "narrator": "アーヤ", "text": "つまりそれを私が\n言うべきだったのね。\n失態だったわ。"},
        { "location": "4250/Talk", "narrator": "みやび", "text": "うちを無理矢理に\nひん剥いたこと自体が\n失態ぞね……。"},
        { "location": "4251/Talk", "narrator": "アーヤ", "text": "やっぱり一朝一夕には\nいかないものね。\nお笑いは難しいわ。"},
        { "location": "4252/Talk", "narrator": "アーヤ", "text": "でも場を和やかに\n楽しくする技術は\n大切だと思うの。"},
        { "location": "4253/Talk", "narrator": "アーヤ", "text": "……ううん、\n技術じゃなくて\n気持ちの問題よね？"},
        { "location": "4254/Talk", "narrator": "ガブリエラ", "text": "アーヤは何でも\n真面目に考え過ぎる\nのが難点ね。"},
        { "location": "4255/Talk", "narrator": "ガブリエラ", "text": "もっと気楽にやれば\nいいのにって言っても\nダメみたいだし。"},
        { "location": "4256/Talk", "narrator": "ガブリエラ", "text": "でも、そういう所が\nアーヤらしくて\n良いと思うわよね？"},
        { "location": "4257/Talk", "narrator": "みやび", "text": "話がシリアスやと\nつっこむのも\n難しいやき。"},
        { "location": "4258/Talk", "narrator": "みやび", "text": "けど次回はうちに\nビッグウェーブが\n来る予感がするきに。"},
        { "location": "4259/Talk", "narrator": "みやび", "text": "正座待機しとくんよ。\nいや服は着たままで\nええから。"},
        { "location": "4260/Talk", "narrator": "アーヤ", "text": "ねぇ、ギャヴィ、\n聞いてくれない？\n最近思うのだけれど。"},
        { "location": "4261/Talk", "narrator": "ガブリエラ", "text": "えっ？　聞くけど\nアーヤにしては唐突ね。"},
        { "location": "4262/Talk", "narrator": "アーヤ", "text": "最近の私たち、\n明るさが欠けてると\n思わない？"},
        { "location": "4263/Talk", "narrator": "ガブリエラ", "text": "ここでの話よね？\nシリアスな話が続いてたし\n仕方ないような？"},
        { "location": "4264/Talk", "narrator": "アーヤ", "text": "でも、そういう時こそ\n楽しい雰囲気にする\nべきじゃないかしら。"},
        { "location": "4265/Talk", "narrator": "ガブリエラ", "text": "アーヤがそう考えて\nそう行動する分には\n止めないけど。"},
        { "location": "4266/Talk", "narrator": "アーヤ", "text": "止めないじゃなくて\n協力してくれないの！？"},
        { "location": "4267/Talk", "narrator": "ガブリエラ", "text": "あたしにそのテのスキルを\n期待しないでよ！"},
        { "location": "4268/Talk", "narrator": "アーヤ", "text": "うぅっ……ギャヴィ\nならわかってくれると\n思ったのに……。"},
        { "location": "4269/Talk", "narrator": "ガブリエラ", "text": "理解は示したけど\n無理なものは無理だし。"},
        { "location": "4270/Talk", "narrator": "アーヤ", "text": "……むぎまる２の\nマンヂウ三つでどう？"},
        { "location": "4271/Talk", "narrator": "ガブリエラ", "text": "アーヤが買収とかどんだけ\n切羽詰まってるのよ……。"},
        { "location": "4272/Talk", "narrator": "ガブリエラ", "text": "まぁでも、四つなら\n手を打ってもいいわ。"},
        { "location": "4273/Talk", "narrator": "アーヤ", "text": "……決まりね。\n今回は徹底的に明るく\nいくわよ！"},
        { "location": "4274/Talk", "narrator": "ガブリエラ", "text": "もしかして、これは\n乗ってはいけない\n流れだったのでは？"},
        { "location": "4275/Talk", "narrator": "つばめ", "text": "あれ？\n二人とも早かったんだね。\nどうしたの？"},
        { "location": "4276/Talk", "narrator": "みやび", "text": "今回は何や面白いこと\nになるみたいやき\nうちらは期待しとこ。"},
        { "location": "4277/Talk", "narrator": "つばめ", "text": "ついにアーヤさんと\nガブちゃんが\n漫才コンビ結成？"},
        { "location": "4278/Talk", "narrator": "ガブリエラ", "text": "ちゃ、ちゃうねん。"},
        { "location": "4279/Talk", "narrator": "アーヤ", "text": "ギャヴィ、まだテレが\nあるようね……。"},
        { "location": "4280/Talk", "narrator": "ガブリエラ", "text": "ていうか、\nやっぱあたしには無理！"},
        { "location": "4281/Talk", "narrator": "ガブリエラ", "text": "みやびが来たんだから\n任せとけばいいじゃ\nないの！"},
        { "location": "4282/Talk", "narrator": "みやび", "text": "大体の話の流れは\n想像つくんやけど\nうちに期待し過ぎや。"},
        { "location": "4283/Talk", "narrator": "みやび", "text": "うちはトライナリーの\nお笑い担当やなくて\nお色気担当やき。"},
        { "location": "4284/Talk", "narrator": "つばめ", "text": "あ、うわさをすれば、\nもうすぐみやびさんの\nセクシーシーンですよ！"},
        { "location": "4285/Talk", "narrator": "つばめ", "text": "あー、いいですよ。\nセクシーですよ。\nみやびさん！"},
        { "location": "4286/Talk", "narrator": "みやび", "text": "つばめちゃんの\nわざとらしいナレは\nともかくとして"},
        { "location": "4287/Talk", "narrator": "みやび", "text": "キミまで一緒になって\nこないな所で止めんで\nええんよ？"},
        { "location": "4288/Talk", "narrator": "ガブリエラ", "text": "それはともかく\nみやびがセクシーって\nなんか違うわよね。"},
        { "location": "4289/Talk", "narrator": "アーヤ", "text": "ええ、スタイルが\nいいのは認めるけど\nセクシーかしら？"},
        { "location": "4290/Talk", "narrator": "みやび", "text": "な、何やのその\n引きこもりのくせに\n体だけは一人前やなー"},
        { "location": "4291/Talk", "narrator": "みやび", "text": "みたいな冷めた反応？\nここはもっと乗っとく\nところやき？"},
        { "location": "4292/Talk", "narrator": "アーヤ", "text": "はっ！　いけない。\n今回はお笑い的な\n流れにしなくちゃ！"},
        { "location": "4293/Talk", "narrator": "アーヤ", "text": "ね、ねーちゃん、\nなかなかイイモノ\n持っとるやないか。"},
        { "location": "4294/Talk", "narrator": "みやび", "text": "それただのエロオヤジ\nやき！　しかも何で\nエセ関西弁！？"},
        { "location": "4295/Talk", "narrator": "ガブリエラ", "text": "アーヤ……、\n努力は認めるけど\n空回りし過ぎ。"},
        { "location": "4296/Talk", "narrator": "アーヤ", "text": "……そうね。\n少し頭を冷やした方が\nいいみたい……。"},
        { "location": "4297/Talk", "narrator": "つばめ", "text": "あっ！　キャーッ！！\nメノウちゃーん！！"},
        { "location": "4298/Talk", "narrator": "ガブリエラ", "text": "って、何ごと！？\nもしかしてＢＧＭに\n反応してるわけ！？"},
        { "location": "4299/Talk", "narrator": "つばめ", "text": "だってこれわたしが\n一番好きな曲で"},
        { "location": "4300/Talk", "narrator": "つばめ", "text": "アースタシアって\n言う曲なんだけど、"},
        { "location": "4301/Talk", "narrator": "つばめ", "text": "エルカドールっていう\n世界のカレンっていう\n魔法使いの子が唱う"},
        { "location": "4302/Talk", "narrator": "つばめ", "text": "不治の病に冒された\nお母さんを助ける\nための魔法の歌なの。"},
        { "location": "4303/Talk", "narrator": "つばめ", "text": "だからホントにホントに\n大好きなんだ。"},
        { "location": "4304/Talk", "narrator": "つばめ", "text": "物語の中で主人公の\nカレンちゃんはずっと\n長い旅をするの。"},
        { "location": "4305/Talk", "narrator": "つばめ", "text": "途中で何度も辛い目に\nあったり大変な事件が\n起きたりするんだけど"},
        { "location": "4306/Talk", "narrator": "つばめ", "text": "それでもめげずに、\n伝説の街イシュリールに\n遂に辿り着くの！"},
        { "location": "4307/Talk", "narrator": "つばめ", "text": "そこで得られる歌は\n魔法の力を持っていて"},
        { "location": "4308/Talk", "narrator": "つばめ", "text": "なんでも願いが叶うって\n言われてるから。"},
        { "location": "4309/Talk", "narrator": "つばめ", "text": "でも、本当はそうじゃ\nなかったんだ。"},
        { "location": "4310/Talk", "narrator": "つばめ", "text": "イシュリールの街は\nカレンを優しく支えて\nくれたんだけど、"},
        { "location": "4311/Talk", "narrator": "つばめ", "text": "でも結局、魔法を紡ぐのは\nカレン自身なんだよ。"},
        { "location": "4312/Talk", "narrator": "つばめ", "text": "カレンが自分の力で\n紡いだ詩こそが\n本当の魔法なんだよ。"},
        { "location": "4313/Talk", "narrator": "つばめ", "text": "すっごく素敵な\nお話しだよねぇ……。"},
        { "location": "4314/Talk", "narrator": "つばめ", "text": "わたしはこの曲にすっごく\n助けてもらった。"},
        { "location": "4315/Talk", "narrator": "つばめ", "text": "今生きていられるのは\nこの曲のお陰だって\n言ってもいいくらい。"},
        { "location": "4316/Talk", "narrator": "つばめ", "text": "だからこの曲が\n聞こえるともう\n感情がぶわーって。"},
        { "location": "4317/Talk", "narrator": "つばめ", "text": "……って、あれ？\n……みんな？"},
        { "location": "4318/Talk", "narrator": "ガブリエラ", "text": "あ、もう終わった？"},
        { "location": "4319/Talk", "narrator": "アーヤ", "text": "以前もあったけど、\n今回はいつにも増して\n長かったわね。"},
        { "location": "4320/Talk", "narrator": "つばめ", "text": "ご、ごめんなさい！\nわたしメノウちゃんの\nことになるとっ。"},
        { "location": "4321/Talk", "narrator": "みやび", "text": "まぁ、つばめちゃんが\n暴走したくなる\n気持ちもわかるき。"},
        { "location": "4322/Talk", "narrator": "つばめ", "text": "ふぇっ？"},
        { "location": "4323/Talk", "narrator": "みやび", "text": "つばめちゃんにとって\nここってめっちゃ\n恥ずかしい所やき。"},
        { "location": "4324/Talk", "narrator": "みやび", "text": "語って誤魔化して\n流したかったんと違うん？"},
        { "location": "4325/Talk", "narrator": "つばめ", "text": "はうっ！？"},
        { "location": "4326/Talk", "narrator": "ガブリエラ", "text": "あー、なるほど。\nつばめってば\nそういうことね。"},
        { "location": "4327/Talk", "narrator": "ガブリエラ", "text": "お陰で見てみなさいよ\nここのあたしたち。"},
        { "location": "4328/Talk", "narrator": "ガブリエラ", "text": "リアクションに困って\nフリーズしてるじゃ\nないの。"},
        { "location": "4329/Talk", "narrator": "つばめ", "text": "…………てへっ♪"},
        { "location": "4330/Talk", "narrator": "アーヤ", "text": "今さら可愛く誤魔化\nそうとしても私にしか\n効かないわよ。"},
        { "location": "4331/Talk", "narrator": "みやび", "text": "むしろアーヤには\n効いとるんかい！"},
        { "location": "4332/Talk", "narrator": "みやび", "text": "と、そんなアーヤの\n豹変がここから\n楽しめるんやけど。"},
        { "location": "4333/Talk", "narrator": "つばめ", "text": "豹変って言うか\n本性を現したって\n言うか……。"},
        { "location": "4334/Talk", "narrator": "アーヤ", "text": "……つばめ、\n何か言ったかしら？"},
        { "location": "4335/Talk", "narrator": "つばめ", "text": "ア、アーヤさんは\nいつでも裏表の無い\n素敵な人ですよねっ！"},
        { "location": "4336/Talk", "narrator": "ガブリエラ", "text": "棒読み過ぎ……。"},
        { "location": "4337/Talk", "narrator": "みやび", "text": "ていうかここのつばめ\nちゃんとガブちゃん\n完全に悪の手下やき。"},
        { "location": "4338/Talk", "narrator": "つばめ", "text": "ガブちゃんとわたしは\n手は出してないです！\nアーヤさんだけです！"},
        { "location": "4339/Talk", "narrator": "ガブリエラ", "text": "ていうかあたしたちも\nドン引きしてるの\nわかるでしょ？"},
        { "location": "4340/Talk", "narrator": "みやび", "text": "うちはアーヤの\nストレスのはけ口や\nないぞねーっ！"},
        { "location": "4341/Talk", "narrator": "アーヤ", "text": "人聞きが悪いわね。\n私はリーダーとして\nおどけてただけよ？"},
        { "location": "4342/Talk", "narrator": "ガブリエラ", "text": "どこがどうリーダーとして\nなのよ……。"},
        { "location": "4343/Talk", "narrator": "みやび", "text": "まぁ、なんやかんや\n結局楽しんだ言う\nオチなんやけどな。"},
        { "location": "4344/Talk", "narrator": "つばめ", "text": "こんな楽しい日が\nずっと続けば\nよかったのに……。"},
        { "location": "4345/Talk", "narrator": "ガブリエラ", "text": "こら、つばめ！\nネタバレ禁止っ！"},
        { "location": "4346/Talk", "narrator": "つばめ", "text": "あぁっ！？\nご、ごめんなさいっ！"},
        { "location": "4347/Talk", "narrator": "みやび", "text": "そんなわけで次回は\n必見やき見逃さん\nといてや♪"},
        { "location": "4348/Talk", "narrator": "つばめ", "text": "えーと、あの、\n楽しんでたのに\nごめんなさいっ。"},
        { "location": "4349/Talk", "narrator": "つばめ", "text": "でもわたし、次は\n頑張れるか\n自信無いなぁ……。"},
        { "location": "4350/Talk", "narrator": "つばめ", "text": "って、ダメだよね、\nこんなんじゃ！\nが、頑張りますっ！"}
    ]
}
