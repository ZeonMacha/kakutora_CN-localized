{
    "dir": "stream_070_ch01.json",
    "type": "watchanime",
    "info": {
    },
    "entry":
    [
        { "location": "1057/Talk", "narrator": "ガブリエラ", "text": "な、何よ！\n文句ある？"},
        { "location": "1058/Talk", "narrator": "ガブリエラ", "text": "なあに？\nあたしが早く来ちゃ\nいけないの？"},
        { "location": "1059/Talk", "narrator": "ガブリエラ", "text": "べ、別に\n何もないわよ。"},
        { "location": "1060/Talk", "narrator": "ガブリエラ", "text": "ぜ、全然違うわよ！"},
        { "location": "1061/Talk", "narrator": "ガブリエラ", "text": "まったく、自惚れないで\nちょうだい。"},
        { "location": "1062/Talk", "narrator": "つばめ", "text": "えぇぇぇぇ～っ！？\nじょ、冗談、\n……ですよねっ！？"},
        { "location": "1063/Talk", "narrator": "みやび", "text": "つばめちゃんの体に\n流れる血の色はもう\n赤くはなくて……。"},
        { "location": "1064/Talk", "narrator": "ガブリエラ", "text": "青とか？　私としては\n緑の方が面白いかしら？"},
        { "location": "1065/Talk", "narrator": "つばめ", "text": "あ、赤いですよ！\n赤いに決まって\nますからっ！"},
        { "location": "1066/Talk", "narrator": "つばめ", "text": "ちょ、ちょっと待って\nください。今から\n献血に行ってき──"},
        { "location": "1067/Talk", "narrator": "アーヤ", "text": "こらこら、\nあまり冗談を\n本気にしないの。"},
        { "location": "1068/Talk", "narrator": "つばめ", "text": "だ、だってぇ～……。"},
        { "location": "1069/Talk", "narrator": "つばめ", "text": "なるほど！　あれって\n体にピッタリフィット\nしますもんね。"},
        { "location": "1070/Talk", "narrator": "みやび", "text": "そして君は、\nその計測値を\nこっそり覗き見たと。"},
        { "location": "1071/Talk", "narrator": "つばめ", "text": "えぇぇぇぇ～っ！？"},
        { "location": "1072/Talk", "narrator": "ガブリエラ", "text": "べつにそれくらい\nどうってこと\nないでしょ。"},
        { "location": "1073/Talk", "narrator": "みやび", "text": "ほならガブちゃんの\n見られたら？"},
        { "location": "1074/Talk", "narrator": "ガブリエラ", "text": "その程度、ただ、\n即、息の根を\n止めるだけよ。"},
        { "location": "1075/Talk", "narrator": "アーヤ", "text": "はい、みんな、\n冗談は\nそれくらいにね。"},
        { "location": "1076/Talk", "narrator": "つばめ", "text": "えっ？\n冗談だったんですか？\nよかったぁ～……。"},
        { "location": "1077/Talk", "narrator": "つばめ", "text": "確かに色合いが\nカボチャっぽいです！"},
        { "location": "1078/Talk", "narrator": "みやび", "text": "つばめちゃん、それ\n卯月には言わん方が\nええかもね？"},
        { "location": "1079/Talk", "narrator": "つばめ", "text": "えっ？　だって、\n可愛いですよね？"},
        { "location": "1080/Talk", "narrator": "アーヤ", "text": "つばめの赤と白の\nトライガジェットも\n似合ってて可愛いわ。"},
        { "location": "1081/Talk", "narrator": "つばめ", "text": "う、嬉しいですけど、\nそういう問題じゃ\nない気が……。"},
        { "location": "1082/Talk", "narrator": "ガブリエラ", "text": "ちょっと待って！"},
        { "location": "1083/Talk", "narrator": "ガブリエラ", "text": "その話なら魔女っ娘と\n魔法少女との違いから\n詰めないとね。"},
        { "location": "1084/Talk", "narrator": "つばめ", "text": "ガブちゃん、何か目が\n真剣なんだけど……。"},
        { "location": "1085/Talk", "narrator": "ガブリエラ", "text": "き、気のせいよ！"},
        { "location": "1086/Talk", "narrator": "ガブリエラ", "text": "あたしはそういうトコ\nハッキリさせないと\n気が済まないだけで！"},
        { "location": "1087/Talk", "narrator": "みやび", "text": "ガブちゃん、それは\n後で二人でじっくり\n詰めたらええぞね。"},
        { "location": "1088/Talk", "narrator": "ガブリエラ", "text": "そ、それねそうね。\nじゃあそういう事で！\nつばめも一緒によ！"},
        { "location": "1089/Talk", "narrator": "つばめ", "text": "ふえぇっ！？\nもしかしてヤブヘビ\n突いちゃったかも？"},
        { "location": "1090/Talk", "narrator": "ガブリエラ", "text": "ええ、だからこそよ。"},
        { "location": "1091/Talk", "narrator": "ガブリエラ", "text": "ナチュラルボーンに\nあざといなんて、\n手強いわ……。"},
        { "location": "1092/Talk", "narrator": "つばめ", "text": "手強いって、\n一体何が……。"},
        { "location": "1093/Talk", "narrator": "みやび", "text": "ほほぅ？　おぬし、\nそこに気づくとは。"},
        { "location": "1094/Talk", "narrator": "アーヤ", "text": "こらこら、卯月の\nいない所で言うのは\nほどほどにね。"},
        { "location": "1095/Talk", "narrator": "ガブリエラ", "text": "あたしは神楽が\n目の前にいても\n言うけど。"},
        { "location": "1096/Talk", "narrator": "つばめ", "text": "そ、それも、\nどうなのかなぁ……。"},
        { "location": "1097/Talk", "narrator": "みやび", "text": "次はうちなんやね。"},
        { "location": "1098/Talk", "narrator": "みやび", "text": "いつも思うんやけど、\n何で、いつもここで\n追い出されるん？"},
        { "location": "1099/Talk", "narrator": "みやび", "text": "なーんて、\nわざとらしく\n聞いてみたり？"},
        { "location": "1100/Talk", "narrator": "つばめ", "text": "あっ、いつも\nお疲れ様です！"},
        { "location": "1101/Talk", "narrator": "つばめ", "text": "えーと……わたしも\nお片付け\n手伝いますよ？"},
        { "location": "1102/Talk", "narrator": "つばめ", "text": "って、あぁっ！\nこの手も\nダメかぁ～……。"},
        { "location": "1103/Talk", "narrator": "アーヤ", "text": "じゃあ、次回も\nよろしくお願いね。"},
        { "location": "1104/Talk", "narrator": "アーヤ", "text": "ええ、わかってる。\n私たちはここで\n退場でしょ？"},
        { "location": "1105/Talk", "narrator": "アーヤ", "text": "あんっ、もうっ、\nわかってるってばっ。"},
        { "location": "1106/Talk", "narrator": "神楽", "text": "えっと……\nこっちだって聞いて\n来たんですけど……？"},
        { "location": "1107/Talk", "narrator": "神楽", "text": "みなさん、どこに\n行ったんですか？"},
        { "location": "1108/Talk", "narrator": "神楽", "text": "ところで、あなたは\n誰でしたっけ？"},
        { "location": "1109/Talk", "narrator": "ガブリエラ", "text": "まったく。たまにやる気\n出して早く来てあげれば\nこれだもの。"},
        { "location": "1110/Talk", "narrator": "ガブリエラ", "text": "単にちょっと暇つぶしに\nあたしも考察なんかして\nみようかと思っただけよ。"},
        { "location": "1111/Talk", "narrator": "ガブリエラ", "text": "前回つばめが考察して\nいたからとか、全然\n関係ないんだからね？"},
        { "location": "1112/Talk", "narrator": "みやび", "text": "うむうむ。\n今回も見事なツンデレ。\n立派なものやね。"},
        { "location": "1113/Talk", "narrator": "ガブリエラ", "text": "だからツンデレ言うな！"},
        { "location": "1114/Talk", "narrator": "つばめ", "text": "わぁ、せんぱい今日は\nすごい早かったですね！"},
        { "location": "1115/Talk", "narrator": "ガブリエラ", "text": "そこまで驚かれると\nさすがに凹むわ。"},
        { "location": "1116/Talk", "narrator": "アーヤ", "text": "えっ、ギャヴィ！\n今日はどうしたの！？"},
        { "location": "1117/Talk", "narrator": "ガブリエラ", "text": "わざとでしょ。\n絶対わかってて\nわざと驚いてるでしょ！"},
        { "location": "1118/Talk", "narrator": "みやび", "text": "それはそうと、\nガブちゃんの考察が\nどんなんか聞かせてや。"},
        { "location": "1119/Talk", "narrator": "ガブリエラ", "text": "え？　え、ええ。\nもちろんいいわよ？"},
        { "location": "1120/Talk", "narrator": "ガブリエラ", "text": "あたしが引っかかってる\nのは最初の『ぱっぱらっ\nぱっぱっぱ』ってとこ。"},
        { "location": "1121/Talk", "narrator": "アーヤ", "text": "そこって歌詞なの？\n単なる意味の無い\nかけ声とかじゃなくて？"},
        { "location": "1122/Talk", "narrator": "ガブリエラ", "text": "違うでしょ！"},
        { "location": "1123/Talk", "narrator": "ガブリエラ", "text": "だって日本語には確か、\n「パッパラパー」って\n言葉があるわよね？"},
        { "location": "1124/Talk", "narrator": "つばめ", "text": "…せんぱい。\nパッパラパーの意味、\n分かってて言ってますか？"},
        { "location": "1125/Talk", "narrator": "ガブリエラ", "text": "え？　もちろんよ。\nラップダンスの事でしょ？"},
        { "location": "1126/Talk", "narrator": "みやび", "text": "その通りや！"},
        { "location": "1127/Talk", "narrator": "アーヤ", "text": "みやび！"},
        { "location": "1128/Talk", "narrator": "みやび", "text": "ほんだら早速ガブちゃんも\nラップダンスを極めて\nパッパラパーになるぞね！"},
        { "location": "1129/Talk", "narrator": "ガブリエラ", "text": "それも悪くないわね。\nエレガントに踊って一流\nパッパラパーになるわ。"},
        { "location": "1130/Talk", "narrator": "アーヤ", "text": "あぁ……っ、\nもう私フォロー\nしないわよ？"},
        { "location": "1131/Talk", "narrator": "つばめ", "text": "ああっ！\n始まってる始まってる！"},
        { "location": "1132/Talk", "narrator": "アーヤ", "text": "あら？　卯月が登場\nしたところの続き\nからじゃないのね？"},
        { "location": "1133/Talk", "narrator": "つばめ", "text": "え～っ！？\nこれ、わたしっ！？"},
        { "location": "1134/Talk", "narrator": "つばめ", "text": "……あっ、\nもしかしてこれって、\n最初の時の……。"},
        { "location": "1135/Talk", "narrator": "アーヤ", "text": "ドームでの事件の後で\n治療室に収容された\n時の映像ね。"},
        { "location": "1136/Talk", "narrator": "ガブリエラ", "text": "あれっ？　まほが眼鏡\nかけてるの初めて見た\nんだけど変装か何か？"},
        { "location": "1137/Talk", "narrator": "みやび", "text": "変装ちゅうか演出や。\n雰囲気は大事やき、\nようわかっちゅう。"},
        { "location": "1138/Talk", "narrator": "ガブリエラ", "text": "まほってば変な所に\n凝るのね。それとも\n趣味なのかしら。"},
        { "location": "1139/Talk", "narrator": "アーヤ", "text": "趣味……もあるかも\n知れないわね……。"},
        { "location": "1140/Talk", "narrator": "ガブリエラ", "text": "ところでここの\n「開始します」って、\n改造手術とか？"},
        { "location": "1141/Talk", "narrator": "つばめ", "text": "ち、違いますよぉ！\nただの治療です。\n……よね？"},
        { "location": "1142/Talk", "narrator": "アーヤ", "text": "でも治療自体は\nもう終わっていた\nみたいだけれど。"},
        { "location": "1143/Talk", "narrator": "みやび", "text": "やっぱり、\n知らぬは本人だけ、\nってことやね。"},
        { "location": "1144/Talk", "narrator": "つばめ", "text": "えぇぇぇぇ～っ！？"},
        { "location": "1145/Talk", "narrator": "つばめ", "text": "$handle$さん！\nわたしホントに改造\nされちゃったの！？"},
        { "location": "1146/Talk", "narrator": "ガブリエラ", "text": "とか話してたら、\nあっさり\n終わっちゃった。"},
        { "location": "1147/Talk", "narrator": "みやび", "text": "結局、深い意味は\n無いシーンだった\nってことやね。"},
        { "location": "1148/Talk", "narrator": "つばめ", "text": "もう！　だから\n言ったじゃ\nないですかぁ～。"},
        { "location": "1149/Talk", "narrator": "ガブリエラ", "text": "で、トライナリーに\n引きずり込もうと\nしてるってわけね。"},
        { "location": "1150/Talk", "narrator": "つばめ", "text": "あの、そんな、まるで\n悪の組織みたいな\n言い方は……。"},
        { "location": "1151/Talk", "narrator": "ガブリエラ", "text": "ところでこのあたりの\nシーンて某アニメで\n見たこと無い？"},
        { "location": "1152/Talk", "narrator": "みやび", "text": "ガブちゃん、そこは\nつっこんだらいかん\nところやき。"},
        { "location": "1153/Talk", "narrator": "アーヤ", "text": "オ、オマージュとか\nリスペクトでしょ？\nも、問題無いわ。"},
        { "location": "1154/Talk", "narrator": "つばめ", "text": "ふえ？　みんな\n何のことを\n言ってるんですか？"},
        { "location": "1155/Talk", "narrator": "アーヤ", "text": "つばめは気にしなくて\n大丈夫よ……。"},
        { "location": "1156/Talk", "narrator": "みやび", "text": "「前向きな回答を\n期待する」（キリッ）"},
        { "location": "1157/Talk", "narrator": "みやび", "text": "とか言いつつ、\n強制してますよなぁ。"},
        { "location": "1158/Talk", "narrator": "アーヤ", "text": "こ、こらっ、\nみやびっ！"},
        { "location": "1159/Talk", "narrator": "つばめ", "text": "ところで皆さんは\nどんな経緯で\n入隊したんですか？"},
        { "location": "1160/Talk", "narrator": "アーヤ", "text": "私の場合は入隊したと\n言うより、私を一人目\nとして発足したから。"},
        { "location": "1161/Talk", "narrator": "ガブリエラ", "text": "あたしは交換留学が\n目的で、その条件が\n入隊だっただけよ。"},
        { "location": "1162/Talk", "narrator": "みやび", "text": "うちは自分のこの力を\n活かすためよのため\n自ら志願しちゅうよ。"},
        { "location": "1163/Talk", "narrator": "つばめ", "text": "わぁ～っ！\nみんな何だかとっても\n立派ですごいです！"},
        { "location": "1164/Talk", "narrator": "ガブリエラ", "text": "……一人、すごく\n胡散臭いのがいた\n気がしたんだけど。"},
        { "location": "1165/Talk", "narrator": "みやび", "text": "気のせいや♪"},
        { "location": "1166/Talk", "narrator": "ガブリエラ", "text": "まほ、つばめの返答を\n待たずにどんどん話を\n進めてるわよね。"},
        { "location": "1167/Talk", "narrator": "みやび", "text": "まぁまぁ、そうやき\nここでアーヤの進言が\n生きてくるわけで。"},
        { "location": "1168/Talk", "narrator": "ガブリエラ", "text": "さすがリーダー。\nまほのペースに\n流されない慎重派ね。"},
        { "location": "1169/Talk", "narrator": "アーヤ", "text": "慎重と言うか、\nここは、ただ\nつばめが心配で……。"},
        { "location": "1170/Talk", "narrator": "ガブリエラ", "text": "「あたしたち」が\n助けたんだけどね。"},
        { "location": "1171/Talk", "narrator": "つばめ", "text": "わ、わかってますよぉ。\n私のモノローグに\nツッコミ入れないで～。"},
        { "location": "1172/Talk", "narrator": "みやび", "text": "と言うよりここは\n「何でモノローグまで\n映像にされてるの！？」"},
        { "location": "1173/Talk", "narrator": "みやび", "text": "って、\nつっこむところやよ？"},
        { "location": "1174/Talk", "narrator": "つばめ", "text": "そ、そういうもの\nなんですか？"},
        { "location": "1175/Talk", "narrator": "つばめ", "text": "ところでこのコード、\nどこからどこに\n繋がってるんですか？"},
        { "location": "1176/Talk", "narrator": "ガブリエラ", "text": "あー……、\nここでそれ\n聞いちゃう？"},
        { "location": "1177/Talk", "narrator": "つばめ", "text": "えっ？　……聞いたら\nまずいことだったの？"},
        { "location": "1178/Talk", "narrator": "みやび", "text": "つばめちゃんも、\nそういうことに\n興味津々だったか～。"},
        { "location": "1179/Talk", "narrator": "つばめ", "text": "えぇーっ！？\nそれって、どういう\n意味ですかっ！？"},
        { "location": "1180/Talk", "narrator": "アーヤ", "text": "早く音羽も私たちの\n力になってくれると\nありがたいわね。"},
        { "location": "1181/Talk", "narrator": "ガブリエラ", "text": "あっ、強引に話を\n断ち切った。"},
        { "location": "1182/Talk", "narrator": "アーヤ", "text": "つばめをからかうのは\nほどほどにね。"},
        { "location": "1183/Talk", "narrator": "つばめ", "text": "う～っ、結局、\n何だったんですかぁ？"},
        { "location": "1184/Talk", "narrator": "みやび", "text": "「いい答えを待って\nいるよ」（ただし\n拒否権は無い）"},
        { "location": "1185/Talk", "narrator": "アーヤ", "text": "もうっ、みやびっ！"},
        { "location": "1186/Talk", "narrator": "みやび", "text": "ごめんごめん。だって\nここのまほさん、\nかっこつけ過ぎてて、"},
        { "location": "1187/Talk", "narrator": "みやび", "text": "つっこんでないと\n笑ってしまうやか。"},
        { "location": "1188/Talk", "narrator": "アーヤ", "text": "だからって言い過ぎ。\nまほが聞いたら\n落ち込むわよ？"},
        { "location": "1189/Talk", "narrator": "つばめ", "text": "あはははは……。"},
        { "location": "1190/Talk", "narrator": "つばめ", "text": "あっ！\n前回の続きですよ。\n卯月さん登場ですっ！"},
        { "location": "1191/Talk", "narrator": "ガブリエラ", "text": "はいはい、\n見ればわかるから、\nはしゃがないの。"},
        { "location": "1192/Talk", "narrator": "つばめ", "text": "卯月さんの\nトライガジェットって\n魔女っ娘みたいです。"},
        { "location": "1193/Talk", "narrator": "つばめ", "text": "$handle$さんも\nそう思いませんかっ？"},
        { "location": "1194/Talk", "narrator": "ガブリエラ", "text": "助っ人って言うか、\n完全に出るタイミング\n見計らってたでしょ？"},
        { "location": "1195/Talk", "narrator": "みやび", "text": "そこはお約束ぞね。\nつっこんだら\n野暮やき。"},
        { "location": "1196/Talk", "narrator": "みやび", "text": "あっ、来るで、\n来るでー。"},
        { "location": "1197/Talk", "narrator": "つばめ", "text": "はい？"},
        { "location": "1198/Talk", "narrator": "みやび", "text": "はい、来たー。\nドジっ子アピール、\nいただきましたー。"},
        { "location": "1199/Talk", "narrator": "ガブリエラ", "text": "ほんっと、\nあざといわよね……。"},
        { "location": "1200/Talk", "narrator": "つばめ", "text": "そ、そんな、卯月さん\nだって、わざと\n転んだわけじゃ……。"},
        { "location": "1201/Talk", "narrator": "つばめ", "text": "$handle$さんは\nどう思います？"},
        { "location": "1202/Talk", "narrator": "ガブリエラ", "text": "そう言えば何で神楽\nここに来てないの？"},
        { "location": "1203/Talk", "narrator": "みやび", "text": "１．呼んでない\n２．忘れて寝てる\n３．ただ今、迷子中"},
        { "location": "1204/Talk", "narrator": "アーヤ", "text": "私は来るように\nきちんと念を押して\n伝えたわよ？"},
        { "location": "1205/Talk", "narrator": "ガブリエラ", "text": "じゃあきっと迷子ね。\nだったら放っといても\nいいんじゃない？"},
        { "location": "1206/Talk", "narrator": "つばめ", "text": "いいんですか、\nそれ……。"},
        { "location": "1207/Talk", "narrator": "みやび", "text": "ええんよ。\nよくあることやき\n気にせんとき。"},
        { "location": "1208/Talk", "narrator": "ガブリエラ", "text": "ていうか、ここ！\n二人で見つめ合ってる\n場合じゃないでしょ！"},
        { "location": "1209/Talk", "narrator": "ガブリエラ", "text": "あたしたちがどんだけ\nカバーしてたと\n思ってるの！？"},
        { "location": "1210/Talk", "narrator": "つばめ", "text": "ご、ごめんなさいっ！"},
        { "location": "1211/Talk", "narrator": "みやび", "text": "そうやけど、この二人\nじゃ、のんびりも\nやむなしってとこかね。"},
        { "location": "1212/Talk", "narrator": "ガブリエラ", "text": "けどアーヤもしっかり\n注意しといた方が\nよくない？"},
        { "location": "1213/Talk", "narrator": "アーヤ", "text": "……べつに、つばめは\n可愛いから\n構わないと思うわ。"},
        { "location": "1214/Talk", "narrator": "ガブリエラ", "text": "何、それ……。"},
        { "location": "1215/Talk", "narrator": "みやび", "text": "つばめちゃん、ここの\n「何これ」って\n何を見て言うたん？"},
        { "location": "1216/Talk", "narrator": "つばめ", "text": "あ、ここはですね、\nカードからオーラ？\nみたいなのが出てて。"},
        { "location": "1217/Talk", "narrator": "ガブリエラ", "text": "カード？"},
        { "location": "1218/Talk", "narrator": "アーヤ", "text": "これね。メラメラと\n赤い邪悪な雰囲気が\nにじみ出てるわ。"},
        { "location": "1219/Talk", "narrator": "ガブリエラ", "text": "こんなの要するに\n襲って来る前フリ\nみたいなものでしょ。"},
        { "location": "1220/Talk", "narrator": "みやび", "text": "つばめちゃんはまだ\n初心者やき、敵さんも\n親切なんやなぁ。"},
        { "location": "1221/Talk", "narrator": "つばめ", "text": "それにしても、\nこういうイジメって\nイヤですよねぇ……。"},
        { "location": "1222/Talk", "narrator": "みやび", "text": "ガブちゃんは\nイジメられたこととか\nあるん？"},
        { "location": "1223/Talk", "narrator": "ガブリエラ", "text": "イジメと言うか、\n嫉妬なら昔から結構\nされてたかもね。"},
        { "location": "1224/Talk", "narrator": "ガブリエラ", "text": "好きにしたら？\nって感じで相手に\nしてなかったけど。"},
        { "location": "1225/Talk", "narrator": "つばめ", "text": "ガブちゃん、\nかっこいい……。"},
        { "location": "1226/Talk", "narrator": "ガブリエラ", "text": "で、ここでやっと\n神楽・本気モード、\nってわけね。"},
        { "location": "1227/Talk", "narrator": "みやび", "text": "ドジっ子とは思えない\nくらい、まるっきり\n別人やねぇ。"},
        { "location": "1228/Talk", "narrator": "つばめ", "text": "やる時はやる！\n卯月さん、すごいっ！\n私も見習います！"},
        { "location": "1229/Talk", "narrator": "ガブリエラ", "text": "まぁ、それぐらいなら\n見習ってもいいけど。"},
        { "location": "1230/Talk", "narrator": "アーヤ", "text": "ギャヴィ、卯月が\nいないからって\nちょっと言い過ぎよ。"},
        { "location": "1231/Talk", "narrator": "ガブリエラ", "text": "て言うか、神楽ってば\n結局終わりまで\n来ないじゃないの！？"},
        { "location": "1232/Talk", "narrator": "みやび", "text": "迷子になっとったら\n後で皆で捜さんと\nいかんきねぇ……。"},
        { "location": "1233/Talk", "narrator": "つばめ", "text": "あぁっ、いい所で\n終わっちゃった～。"},
        { "location": "1234/Talk", "narrator": "ガブリエラ", "text": "今回はここまでね。\nまぁ、いつもの\nことだけど。"},
        { "location": "1235/Talk", "narrator": "みやび", "text": "引きは大事やきねぇ。"},
        { "location": "1236/Talk", "narrator": "アーヤ", "text": "と言うわけで、\nいつものように解散。\n皆、お疲れ様。"},
        { "location": "1237/Talk", "narrator": "ガブリエラ", "text": "神楽の件は\nどうするの？"},
        { "location": "1238/Talk", "narrator": "アーヤ", "text": "……とりあえず\n連絡してみるわ。"},
        { "location": "1239/Talk", "narrator": "ガブリエラ", "text": "あれ？\nあたしから？"},
        { "location": "1240/Talk", "narrator": "ガブリエラ", "text": "ちょっと待って。\nそんなに\nせっつかないでよ。"},
        { "location": "1241/Talk", "narrator": "ガブリエラ", "text": "はいはい、\nそれじゃあ、\nまた後でね。"}
    ]
}
