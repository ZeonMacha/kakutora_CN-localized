{
    "dir": "stream_170_ch01.json",
    "type": "watchanime",
    "info": {
    },
    "entry":
    [
        { "location": "3318/Talk", "narrator": "アーヤ", "text": "少しわかりづらかった\nかしら？"},
        { "location": "3319/Talk", "narrator": "アーヤ", "text": "じゃあ順を追って\n説明するわね。"},
        { "location": "3320/Talk", "narrator": "アーヤ", "text": "その言い方だと何をするか\nはわかっているようね。"},
        { "location": "3321/Talk", "narrator": "アーヤ", "text": "でも一応順を追って\n説明するわね。"},
        { "location": "3322/Talk", "narrator": "ガブリエラ", "text": "あんた、それ以上\n言ったらこのアプリが\n消えるわよ……。"},
        { "location": "3323/Talk", "narrator": "アーヤ", "text": "ギャヴィのそのメタっぽい\n発言も微妙よ……。"},
        { "location": "3324/Talk", "narrator": "つばめ", "text": "ガブちゃんがメタル？\nギャヴィメタル？\nギャヴィメタ！？"},
        { "location": "3325/Talk", "narrator": "ガブリエラ", "text": "みやびの分まで\nそんなに無理に\nボケなくていいから。"},
        { "location": "3326/Talk", "narrator": "つばめ", "text": "ボケてないよっ！？"},
        { "location": "3327/Talk", "narrator": "ガブリエラ", "text": "何かそれ安っぽいアニメの\nタイトルみたいね。"},
        { "location": "3328/Talk", "narrator": "つばめ", "text": "安っぽいは余計だよっ！"},
        { "location": "3329/Talk", "narrator": "アーヤ", "text": "……つばめ、もしかして\n気に入ったの？"},
        { "location": "3330/Talk", "narrator": "つばめ", "text": "そ、それほどでも\nな、ないですけど？"},
        { "location": "3331/Talk", "narrator": "ガブリエラ", "text": "気に入ったのね……。"},
        { "location": "3332/Talk", "narrator": "つばめ", "text": "ふぇぇっ！？\nち、違うよっ！\n違うってばーっ！"},
        { "location": "3333/Talk", "narrator": "ガブリエラ", "text": "ううん、恋でしょ。"},
        { "location": "3334/Talk", "narrator": "つばめ", "text": "やだ、ガブちゃん、\nここぞとばかりに\nからかわないでよっ。"},
        { "location": "3335/Talk", "narrator": "アーヤ", "text": "私も、多分恋じゃないかな\nって思っていたところよ。"},
        { "location": "3336/Talk", "narrator": "つばめ", "text": "ア、アーヤさんまで\nそんな、わ、わたし、\n恥ずかしいよぉ……。"},
        { "location": "3337/Talk", "narrator": "つばめ", "text": "あっ、何か今わたし、\n超すごいみたいな\n感じじゃないですか？"},
        { "location": "3338/Talk", "narrator": "ガブリエラ", "text": "褒められてるわけじゃ\nないと思うんだけど。"},
        { "location": "3339/Talk", "narrator": "つばめ", "text": "そうかな？　だって\n時空だよ？　時空！\n空から降って来そう！"},
        { "location": "3340/Talk", "narrator": "アーヤ", "text": "それはそれで何だか物騒\nなのだけれど……。"},
        { "location": "3341/Talk", "narrator": "神楽", "text": "……いきなり何を\n言ってるんですか？"},
        { "location": "3342/Talk", "narrator": "つばめ", "text": "クズ野郎な人を倒してくれ\nてありがとうってこと？"},
        { "location": "3343/Talk", "narrator": "アーヤ", "text": "つばめ、それ以上深く考え\nない方がいいわ。"},
        { "location": "3344/Talk", "narrator": "つばめ", "text": "えっ？　えっ？"},
        { "location": "3345/Talk", "narrator": "ガブリエラ", "text": "天然記念物は天然のままが\nいいってことよ。"},
        { "location": "3346/Talk", "narrator": "つばめ", "text": "ガブちゃん、意地悪しない\nで教えてっ！"},
        { "location": "3347/Talk", "narrator": "神楽", "text": "……子豚ちゃん業界の\n方から来んですか？"},
        { "location": "3348/Talk", "narrator": "つばめ", "text": "何だか可愛いね！"},
        { "location": "3349/Talk", "narrator": "ガブリエラ", "text": "いや、絶対にあんたが\n想像してるのと違うから。"},
        { "location": "3350/Talk", "narrator": "つばめ", "text": "子豚はとっても美味しそう\nで可愛いよ？"},
        { "location": "3351/Talk", "narrator": "ガブリエラ", "text": "あんたの規準は\nそこなの！？"},
        { "location": "3352/Talk", "narrator": "つばめ", "text": "……あれ？\nでもこの子って、\nどこかで見たような？"},
        { "location": "3353/Talk", "narrator": "ガブリエラ", "text": "冷静な反応で\nスルーするなんて\nつばめもやるわね。"},
        { "location": "3354/Talk", "narrator": "つばめ", "text": "ふぇっ！？\nそ、そんなつもり\n……無いですよ？"},
        { "location": "3355/Talk", "narrator": "アーヤ", "text": "その微妙な間が逆に気に\nなってしまうわね。"},
        { "location": "3356/Talk", "narrator": "つばめ", "text": "ラスボス？\nつまりわたしたちの\n敵ってことですか？"},
        { "location": "3357/Talk", "narrator": "ガブリエラ", "text": "だとしたら神楽は\n敵に内通してるって\nことになるけど？"},
        { "location": "3358/Talk", "narrator": "つばめ", "text": "あぁっ！\nナシナシ！\n今のはナシでっ！！"},
        { "location": "3359/Talk", "narrator": "アーヤ", "text": "貴方もあまり人聞きの\n悪いことは言わないで\nちょうだいね。"},
        { "location": "3360/Talk", "narrator": "つばめ", "text": "えっ？\nこの白い子、\nちはるって言うの？"},
        { "location": "3361/Talk", "narrator": "つばめ", "text": "えっ！？\nもしかして本当にこの人、\n鬼だったりするの！？"},
        { "location": "3362/Talk", "narrator": "ガブリエラ", "text": "チュートリアルで\n戯れてる？\n意味わかんないっ！"},
        { "location": "3363/Talk", "narrator": "ガブリエラ", "text": "……その頭、撃ったら\n少しはマトモな人間に\nなるかしら？"},
        { "location": "3364/Talk", "narrator": "アーヤ", "text": "卯月のことは私たちも\nしっかりフォローする\nべきよね。"},
        { "location": "3365/Talk", "narrator": "アーヤ", "text": "つばめにばかり\n心配かけさせていたら\nリーダー失格だわ。"},
        { "location": "3366/Talk", "narrator": "アーヤ", "text": "つばめ一人だけに\n辛い思いなんて\n絶対にさせないわ。"},
        { "location": "3367/Talk", "narrator": "ガブリエラ", "text": "みんなちょっと\n一人で抱え込もうと\nし過ぎじゃない？"},
        { "location": "3368/Talk", "narrator": "ガブリエラ", "text": "なーんてあたしが\n言っても説得力が\n無いかもね。"},
        { "location": "3369/Talk", "narrator": "ガブリエラ", "text": "少しみやびを見習って\nちゃらんぽらん風に\n生きてみようかしら？"},
        { "location": "3370/Talk", "narrator": "アーヤ", "text": "知っている人もいる\nと思うけれど、今回は\nみやびが欠席なの。"},
        { "location": "3371/Talk", "narrator": "ガブリエラ", "text": "休むなら休むでいいん\nだけど、理由は秘密\nとかふざけてるわね。"},
        { "location": "3372/Talk", "narrator": "つばめ", "text": "きっとみやびさんは\nまた裏で何やかんや\nしてるんですよ。"},
        { "location": "3373/Talk", "narrator": "ガブリエラ", "text": "その言い方だと\nロクでもないこと\nしてるみたいよ？"},
        { "location": "3374/Talk", "narrator": "つばめ", "text": "……あの、ところで\n卯月さんは？"},
        { "location": "3375/Talk", "narrator": "アーヤ", "text": "今回、卯月から欠席の連絡\nは来てないけれど……。"},
        { "location": "3376/Talk", "narrator": "ガブリエラ", "text": "前回の今回じゃ\n来なくても\n仕方ないわよね。"},
        { "location": "3377/Talk", "narrator": "つばめ", "text": "そ、そんな、卯月さん\nこのままずっと来ない\nなんてないですよね？"},
        { "location": "3378/Talk", "narrator": "アーヤ", "text": "……ええ、そうね。\nだから卯月がいつでも\n戻って来られるように"},
        { "location": "3379/Talk", "narrator": "アーヤ", "text": "私たちまで暗い顔を\nしていてはダメ。\nわかった？"},
        { "location": "3380/Talk", "narrator": "つばめ", "text": "アーヤさん……。"},
        { "location": "3381/Talk", "narrator": "ガブリエラ", "text": "まずいわね。\nボケたり茶化してくれる\nみやびがいないだけで"},
        { "location": "3382/Talk", "narrator": "ガブリエラ", "text": "何だか空気が違うんだけど。"},
        { "location": "3383/Talk", "narrator": "つばめ", "text": "じゃあ今回はわたしが\nみやびさんの分まで\nボケまくります！"},
        { "location": "3384/Talk", "narrator": "ガブリエラ", "text": "つばめは普段から天然ボケ\n入れまくってるし。"},
        { "location": "3385/Talk", "narrator": "つばめ", "text": "ふえぇっ！？\nそ、そうだったの？"},
        { "location": "3386/Talk", "narrator": "アーヤ", "text": "無自覚であるが故の\n天然なんだから\n仕方ないわね。"},
        { "location": "3387/Talk", "narrator": "つばめ", "text": "アーヤさんまで！？"},
        { "location": "3388/Talk", "narrator": "つばめ", "text": "じゃ、じゃあ今回はわたし\n絶対にボケないんだから！"},
        { "location": "3389/Talk", "narrator": "ガブリエラ", "text": "決意変えるの\n早過ぎない？"},
        { "location": "3390/Talk", "narrator": "つばめ", "text": "あの、みやびさんは突然\n何を言い出したんですか？"},
        { "location": "3391/Talk", "narrator": "アーヤ", "text": "この疑似ゲーム世界の\n攻略法を私たちに\n伝えているのよ。"},
        { "location": "3392/Talk", "narrator": "ガブリエラ", "text": "伊達に裏で動いてたわけ\nじゃなかったってことね。"},
        { "location": "3393/Talk", "narrator": "つばめ", "text": "ふむふむなるほど。\n何が何やらさっぱり\nわかりません！"},
        { "location": "3394/Talk", "narrator": "つばめ", "text": "あっ、ガブちゃんが\nすっごくいいこと\n言ってるから注目！"},
        { "location": "3395/Talk", "narrator": "ガブリエラ", "text": "お、大袈裟ね。\n当たり前のこと\n言ってるだけでしょ。"},
        { "location": "3396/Talk", "narrator": "アーヤ", "text": "でもギャヴィのお陰で\n私も動揺し過ぎないで\n済んだわ。"},
        { "location": "3397/Talk", "narrator": "つばめ", "text": "プライベート通信って\n何で普段は使ってないん\nですか？"},
        { "location": "3398/Talk", "narrator": "アーヤ", "text": "確かに盗聴防止能力は\n高いけれど、\n音声メインになるし――"},
        { "location": "3399/Talk", "narrator": "アーヤ", "text": "聞こえづらい時も\nあるから常用には\n向かないのよ。"},
        { "location": "3400/Talk", "narrator": "アーヤ", "text": "普通のクランなら\n通常通信が傍受される\nことはまず無いし。"},
        { "location": "3401/Talk", "narrator": "つばめ", "text": "なるほど～。\n一長一短って\nわけなんですね。"},
        { "location": "3402/Talk", "narrator": "ガブリエラ", "text": "待って！\nもしかしてつばめが\n四字熟語を使った！？"},
        { "location": "3403/Talk", "narrator": "つばめ", "text": "驚くポイント\nおかしいよね！？"},
        { "location": "3404/Talk", "narrator": "アーヤ", "text": "まずは私が囮になって\n暴れるの。"},
        { "location": "3405/Talk", "narrator": "ガブリエラ", "text": "で、その隙にあたしが\nバックドアを撃つと。"},
        { "location": "3406/Talk", "narrator": "ガブリエラ", "text": "でもセキュリティに\n防がれて、向こうは\nいい気になってるけど"},
        { "location": "3407/Talk", "narrator": "ガブリエラ", "text": "セキュリティホールが\nあることには気づいて\nないから――"},
        { "location": "3408/Talk", "narrator": "つばめ", "text": "その小さな穴を\nわたしが──"},
        { "location": "3409/Talk", "narrator": "つばめ", "text": "とどめのどーん！\nでフィニッシュ！！\nって流れでしたっ♪"},
        { "location": "3410/Talk", "narrator": "ガブリエラ", "text": "つばめもぶっつけ本番に\nしては上出来だったわね。"},
        { "location": "3411/Talk", "narrator": "つばめ", "text": "えへへっ♪\nわたしって本番に\n強いタイプなのかも？"},
        { "location": "3412/Talk", "narrator": "アーヤ", "text": "ナイスキャッチよ、\nつばめ。"},
        { "location": "3413/Talk", "narrator": "ガブリエラ", "text": "ていうか、\nこのラブコメっぽい\n展開は何なの？"},
        { "location": "3414/Talk", "narrator": "ガブリエラ", "text": "しかも「神楽ちゃん」\nって、どういう心境の\n変化なわけ？"},
        { "location": "3415/Talk", "narrator": "つばめ", "text": "えっ……どういうって\n言われても、自然に\n口から出ちゃって。"},
        { "location": "3416/Talk", "narrator": "アーヤ", "text": "きっと、つばめの\n素直な気持ちが言葉に\nなって出たのね。"},
        { "location": "3417/Talk", "narrator": "つばめ", "text": "でも今改めて見ると\n何だかすっごく\n恥ずかしいよぉ～。"},
        { "location": "3418/Talk", "narrator": "ガブリエラ", "text": "けど今でもつばめ、\n「神楽ちゃん」呼びの\nままよね？"},
        { "location": "3419/Talk", "narrator": "つばめ", "text": "また「卯月さん」に\n戻すのは戻すので\n何だか恥ずかしくて。"},
        { "location": "3420/Talk", "narrator": "アーヤ", "text": "でもＷＡＶＥでは\nまだ「卯月さん」って\n書いてたような？"},
        { "location": "3421/Talk", "narrator": "つばめ", "text": "「神楽ちゃん」って\n字で打つのは何だか\nこそばゆくて……。"},
        { "location": "3422/Talk", "narrator": "ガブリエラ", "text": "何か意味わかんなく\nなってきたんだけど。"},
        { "location": "3423/Talk", "narrator": "ガブリエラ", "text": "そういえば神楽の方は\n「つばめさん」のまま\nよね。"},
        { "location": "3424/Talk", "narrator": "ガブリエラ", "text": "これって神楽は\nつばめのことを大して\n好きでもなくて、"},
        { "location": "3425/Talk", "narrator": "ガブリエラ", "text": "何とも思ってないまま\n心境の変化は無かった\nってことじゃない？"},
        { "location": "3426/Talk", "narrator": "つばめ", "text": "ガブちゃんってば、\nそ、そんなこと\nないよぉ～っ。"},
        { "location": "3427/Talk", "narrator": "つばめ", "text": "……あっ、でも、\nやっぱりあるかも？\nそんな気がしてきた。"},
        { "location": "3428/Talk", "narrator": "つばめ", "text": "うぅっ、自信無いっ。\n今回も神楽ちゃん\nいないし……。"},
        { "location": "3429/Talk", "narrator": "神楽", "text": "一体いつから私がいないと\n錯覚してました？"},
        { "location": "3430/Talk", "narrator": "つばめ", "text": "ふえぇっ！？\n神楽ちゃんっ！？"},
        { "location": "3431/Talk", "narrator": "ガブリエラ", "text": "神楽、あんた\nいつの間にっ！？"},
        { "location": "3432/Talk", "narrator": "アーヤ", "text": "全く気配を\n感じなかったわ……。"},
        { "location": "3433/Talk", "narrator": "つばめ", "text": "神楽ちゃん、\n急に来たりして\n一体どうしたの！？"},
        { "location": "3434/Talk", "narrator": "神楽", "text": "ええ、とりあえず、\n映像の続きを\n再開してください。"},
        { "location": "3435/Talk", "narrator": "神楽", "text": "実はこのシーンだけは\n改めてもう一度\n見ておきたかったの。"},
        { "location": "3436/Talk", "narrator": "ガブリエラ", "text": "確かに神楽の\n見せ場ではあったけど\nわざわざ来るほど？"},
        { "location": "3437/Talk", "narrator": "神楽", "text": "こいつホントにクソ！\n何度見てもやっぱり\n吐き気がするわっ！"},
        { "location": "3438/Talk", "narrator": "つばめ", "text": "か、神楽ちゃん、\nキャラがすっごく\n変わっちゃってるよ？"},
        { "location": "3439/Talk", "narrator": "ガブリエラ", "text": "変わったっていうか\nそれが素じゃない？"},
        { "location": "3440/Talk", "narrator": "神楽", "text": "違いますーっ。\n今はチョイ悪ワイルドな\n気分なんですーっ。"},
        { "location": "3441/Talk", "narrator": "アーヤ", "text": "むしろストレス発散？\nそれもアリだとは思う\nけれど。"},
        { "location": "3442/Talk", "narrator": "神楽", "text": "はい、その通り、\nこれでやっと\nスッキリしました！"},
        { "location": "3443/Talk", "narrator": "神楽", "text": "皆さんに今さら言う\n必要なんて無いと\n思いますけど、"},
        { "location": "3444/Talk", "narrator": "神楽", "text": "ゲームはルールと\nマナーを守って\n楽しみましょうねっ♪"},
        { "location": "3445/Talk", "narrator": "つばめ", "text": "確かゲームは\n一日一時間まで\nなんだっけ？"},
        { "location": "3446/Talk", "narrator": "ガブリエラ", "text": "……あんたそれ\nいつの時代の話よ？"},
        { "location": "3447/Talk", "narrator": "つばめ", "text": "ふわぁ～……。\n神楽ちゃん、\nかっこいい……。"},
        { "location": "3448/Talk", "narrator": "神楽", "text": "それじゃあ私は\nここまででっ！"},
        { "location": "3449/Talk", "narrator": "つばめ", "text": "えっ？\nもう少しで終わりなのに\n何でっ！？"},
        { "location": "3450/Talk", "narrator": "ガブリエラ", "text": "そりゃ自分が怒られる\nシーンを見たいわけ\nないでしょ。"},
        { "location": "3451/Talk", "narrator": "つばめ", "text": "あっ……。\nだ、だって、それは……。"},
        { "location": "3452/Talk", "narrator": "ガブリエラ", "text": "責めてたおまえたちが\n言うなって感じでしょう\nけど――"},
        { "location": "3453/Talk", "narrator": "ガブリエラ", "text": "神楽の家だったなんて\n知らなかったんだし、\n仕方無いじゃない。"},
        { "location": "3454/Talk", "narrator": "ガブリエラ", "text": "そもそもメノウの\nことだってあったし。"},
        { "location": "3455/Talk", "narrator": "ガブリエラ", "text": "事情を知ってたらあんな\n言い方はしないってば。"},
        { "location": "3456/Talk", "narrator": "アーヤ", "text": "そうね。でもこの場で\n責めるべきでは\nなかったとは思うわ。"},
        { "location": "3457/Talk", "narrator": "アーヤ", "text": "私も少し軽率だった。\nごめんなさい、つばめ。"},
        { "location": "3458/Talk", "narrator": "つばめ", "text": "いえ、わたしも責めてる\nわけじゃないですから……。"},
        { "location": "3459/Talk", "narrator": "アーヤ", "text": "それにしても、\nここのつばめ、\nまるで天使みたいね。"},
        { "location": "3460/Talk", "narrator": "つばめ", "text": "ふえぇっ！？\nい、いきなりどうした\nんですかっ！？"},
        { "location": "3461/Talk", "narrator": "アーヤ", "text": "妹のような\nあどけなさの中に\n母性を感じるわ。"},
        { "location": "3462/Talk", "narrator": "ガブリエラ", "text": "……アーヤ、何か\n悪い物でも食べた？"},
        { "location": "3463/Talk", "narrator": "ガブリエラ", "text": "言ってることが画面の\n向こうの誰かさんに\nそっくりなんだけど？"},
        { "location": "3464/Talk", "narrator": "アーヤ", "text": "そ、そんな大袈裟な\n意味じゃないわ。\nき、気のせいよ？"},
        { "location": "3465/Talk", "narrator": "つばめ", "text": "ところで、\nこの後ろのガブちゃん\n何を言ってるの？"},
        { "location": "3466/Talk", "narrator": "ガブリエラ", "text": "さ、さぁ？\n音声解析でもしたら\nわかるんじゃない？"},
        { "location": "3467/Talk", "narrator": "つばめ", "text": "え～？\n教えてよ、ガブちゃ～ん。"},
        { "location": "3468/Talk", "narrator": "ガブリエラ", "text": "だから、気やすく\nガブちゃんって\n呼ばないでってばっ！"},
        { "location": "3469/Talk", "narrator": "つばめ", "text": "じゃあ、ガブさん？\nガブ様？　ガブ殿？"},
        { "location": "3470/Talk", "narrator": "ガブリエラ", "text": "……うん、\nガブちゃんでいいわ……。"},
        { "location": "3471/Talk", "narrator": "つばめ", "text": "よくわかんないけど、\nこんなの神楽ちゃんが\n可哀相だよ。"},
        { "location": "3472/Talk", "narrator": "つばめ", "text": "それに、何だか、\nこの白い子、\n鬼みたいな感じ……。"},
        { "location": "3473/Talk", "narrator": "ガブリエラ", "text": "ていうか何でアンタが\n名前知ってるわけ？\nもしかしてグル？"},
        { "location": "3474/Talk", "narrator": "アーヤ", "text": "私たちは全員、\n見たことも無いのに\n怪しいわね。"},
        { "location": "3475/Talk", "narrator": "ガブリエラ", "text": "いいからさっさと\nコイツの正体を\n白状しなさいっ！！"},
        { "location": "3476/Talk", "narrator": "アーヤ", "text": "聞くだけ色々と\n無駄だったってことは\nわかったわ。"},
        { "location": "3477/Talk", "narrator": "ガブリエラ", "text": "とにかくつばめは\n神楽の心配してる\n場合じゃないでしょ！"},
        { "location": "3478/Talk", "narrator": "アーヤ", "text": "ええ、何だか急に\nきな臭くなって\nきたわね……。"},
        { "location": "3479/Talk", "narrator": "つばめ", "text": "わたしのことより\n神楽ちゃんの方が\n心配だよっ！"},
        { "location": "3480/Talk", "narrator": "つばめ", "text": "でも、みんなが心配\nするから、わたしも\nしっかりしなきゃ！"},
        { "location": "3481/Talk", "narrator": "つばめ", "text": "だからこれからも\nちゃんと見守ってて\nくださいね？"}
    ]
}
