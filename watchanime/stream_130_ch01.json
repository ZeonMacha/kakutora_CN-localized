        { "location": "2202/Talk", "narrator": "ガブリエラ", "text": "みんなして\nなんなのもう……。"},
        { "location": "2203/Talk", "narrator": "アーヤ", "text": "ごめんね。\n話を戻しましょうか。"},
        { "location": "2204/Talk", "narrator": "つばめ", "text": "はーい♪"},
        { "location": "2205/Talk", "narrator": "ガブリエラ", "text": "なんかまた変なこと\n言い出したわ。"},
        { "location": "2206/Talk", "narrator": "アーヤ", "text": "べ、べつにそんな\n意味じゃないわよね？"},
        { "location": "2207/Talk", "narrator": "ガブリエラ", "text": "そんな意味よ。\nコイツ絶対アーヤのこと\n狙ってるから。"},
        { "location": "2208/Talk", "narrator": "アーヤ", "text": "……そ、それはそれで\n話し合う余地が\nあったりなかったり？"},
        { "location": "2209/Talk", "narrator": "ガブリエラ", "text": "アーヤしっかりして！"},
        { "location": "2210/Talk", "narrator": "つばめ", "text": "$handle$さん、\n本気ならわたし\n外しますよ？"},
        { "location": "2211/Talk", "narrator": "ガブリエラ", "text": "とにかく、アーヤを\n口説くつもりなら\n順序があるから！"},
        { "location": "2212/Talk", "narrator": "ガブリエラ", "text": "まずはあたしに\n認められてからに\nしてちょうだいっ！"},
        { "location": "2213/Talk", "narrator": "つばめ", "text": "ふえっ？"},
        { "location": "2214/Talk", "narrator": "神楽", "text": "あれれっ？"},
        { "location": "2215/Talk", "narrator": "アーヤ", "text": "ギャヴィ……、\nそれは……。"},
        { "location": "2216/Talk", "narrator": "ガブリエラ", "text": "えっ？　あたし何か\n変なこと…………、\nあぁっ！！！！"},
        { "location": "2217/Talk", "narrator": "ガブリエラ", "text": "ち、違うから！\nそういう意味じゃ\nないからっ！！"},
        { "location": "2218/Talk", "narrator": "つばめ", "text": "そういう意味って\nどういう意味なの？"},
        { "location": "2219/Talk", "narrator": "ガブリエラ", "text": "だから、\nあんたが入ると\nややこしくなるのよ！"},
        { "location": "2220/Talk", "narrator": "アーヤ", "text": "そ、それじゃあ鑑賞に\n戻りましょうか……。"},
        { "location": "2221/Talk", "narrator": "神楽", "text": "そ、そんなこと\n急に言われたら\nテレるぴょん……。"},
        { "location": "2222/Talk", "narrator": "ガブリエラ", "text": "アンタのことじゃ\nないでしょ！！"},
        { "location": "2223/Talk", "narrator": "つばめ", "text": "えっえっ！？\n今の何だったの！？"},
        { "location": "2224/Talk", "narrator": "アーヤ", "text": "リアクションに\n困ってたから\nありがたいけど……。"},
        { "location": "2225/Talk", "narrator": "ガブリエラ", "text": "とにかく、アーヤを\n口説くつもりなら\n順序があるから！"},
        { "location": "2226/Talk", "narrator": "ガブリエラ", "text": "まずはあたしに\n認められてからに\nしてちょうだいっ！"},
        { "location": "2227/Talk", "narrator": "つばめ", "text": "ふえっ？"},
        { "location": "2228/Talk", "narrator": "神楽", "text": "あれれっ？"},
        { "location": "2229/Talk", "narrator": "アーヤ", "text": "ギャヴィ……、\nそれは……。"},
        { "location": "2230/Talk", "narrator": "ガブリエラ", "text": "えっ？　あたし何か\n変なこと…………、\nあぁっ！！！！"},
        { "location": "2231/Talk", "narrator": "ガブリエラ", "text": "ち、違うから！\nそういう意味じゃ\nないからっ！！"},
        { "location": "2232/Talk", "narrator": "つばめ", "text": "そういう意味って\nどういう意味なの？"},
