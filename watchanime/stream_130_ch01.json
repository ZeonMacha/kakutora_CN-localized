    "entry":
    [
        { "location": "2082/Talk", "narrator": "みやび", "text": "うちもそんな気は\nするけんど、これ\nつっこみづらいちや。"},
        { "location": "2083/Talk", "narrator": "アーヤ", "text": "何よ？　言いたい\nことがあったら、\n言った方がいいわよ？"},
        { "location": "2084/Talk", "narrator": "ガブリエラ", "text": "棒読み過ぎィっ！！"},
        { "location": "2085/Talk", "narrator": "つばめ", "text": "アーヤさん、とっても\n可愛いですね！"},
        { "location": "2086/Talk", "narrator": "みやび", "text": "つばめちゃん、\nよう心にも無いこと\n言うねえ。"},
        { "location": "2087/Talk", "narrator": "つばめ", "text": "えっ！？\nかわいいですよね！？"},
        { "location": "2088/Talk", "narrator": "ガブリエラ", "text": "天然はこれだから……。"},
        { "location": "2089/Talk", "narrator": "アーヤ", "text": "つばめったら、\nいいのよ別に。"},
        { "location": "2090/Talk", "narrator": "アーヤ", "text": "自分でもちょっと\nアレかなって\n思ってたし。"},
        { "location": "2091/Talk", "narrator": "アーヤ", "text": "じゃ、そろそろ\n先に進めましょうか♪"},
        { "location": "2092/Talk", "narrator": "つばめ", "text": "はい！"},
        { "location": "2093/Talk", "narrator": "みやび", "text": "アーヤ、\nキャラ変わっちょらん\nかねえ……。"},
        { "location": "2094/Talk", "narrator": "ガブリエラ", "text": "意外と気に入ってた\nみたいね……。"},
        { "location": "2095/Talk", "narrator": "アーヤ", "text": "あなたたちには\n血も涙もないのっ！？"},
        { "location": "2096/Talk", "narrator": "ガブリエラ", "text": "そこまでじゃ\nないわよね……。"},
        { "location": "2097/Talk", "narrator": "みやび", "text": "何や素で美味しい\n流れになっちょる。\nちっくと悔しいぞね。"},
        { "location": "2098/Talk", "narrator": "つばめ", "text": "アーヤさん、とっても\n可愛いですね！"},
        { "location": "2099/Talk", "narrator": "みやび", "text": "つばめちゃん、\nよう心にも無いこと\n言うねえ。"},
        { "location": "2100/Talk", "narrator": "つばめ", "text": "えっ！？\nかわいいですよね！？"},
        { "location": "2101/Talk", "narrator": "ガブリエラ", "text": "天然はこれだから……。"},
        { "location": "2102/Talk", "narrator": "アーヤ", "text": "つばめったら、\nいいのよ別に。"},
        { "location": "2103/Talk", "narrator": "アーヤ", "text": "自分でもちょっと\nアレかなって\n思ってたし。"},
        { "location": "2104/Talk", "narrator": "アーヤ", "text": "じゃ、そろそろ\n先に進めましょうか♪"},
        { "location": "2105/Talk", "narrator": "つばめ", "text": "はい！"},
        { "location": "2106/Talk", "narrator": "みやび", "text": "アーヤ、キャラ変わっちょ\nらんかねえ……。"},
        { "location": "2107/Talk", "narrator": "ガブリエラ", "text": "意外と気に入ってた\nみたいね……。"},
        { "location": "2108/Talk", "narrator": "つばめ", "text": "これって今放送してる\nやつですよね？"},
        { "location": "2109/Talk", "narrator": "みやび", "text": "正確には\n今放送しちょるのは\n新シリーズやね。"},
        { "location": "2110/Talk", "narrator": "みやび", "text": "これの元ネタは\n前のシリーズのやと\n思うぞね。"},
        { "location": "2111/Talk", "narrator": "ガブリエラ", "text": "みやび、\n妙に詳しいわね？"},
        { "location": "2112/Talk", "narrator": "みやび", "text": "ああ。今、この映像\nそのまんま撮って\n検索しただけやき。"},
        { "location": "2113/Talk", "narrator": "ガブリエラ", "text": "ちょっと！　そんな\n危ないことして、流出\nしたらどうするのよ！"},
        { "location": "2114/Talk", "narrator": "みやび", "text": "うちがそんな\n下手なことするわけ\nないろう。"},
        { "location": "2115/Talk", "narrator": "ガブリエラ", "text": "……まぁ、もう\n終わったし、いいわ。\n先、行けば？"},
        { "location": "2116/Talk", "narrator": "みやび", "text": "ガブちゃん、甘いねえ。\n本当に恥ずかしいのは\nこれからやろう？"},
        { "location": "2117/Talk", "narrator": "ガブリエラ", "text": "えっちょっと\nそんなはずは……！"},
        { "location": "2118/Talk", "narrator": "ガブリエラ", "text": "何いきなり\nワシが育てた的なこと\n言ってるのよ。"},
        { "location": "2119/Talk", "narrator": "アーヤ", "text": "なるほど。陰ながら\n支えて貰っていた\nわけなのね。"},
        { "location": "2120/Talk", "narrator": "ガブリエラ", "text": "そして何でアーヤは\n納得しちゃってるわけ！？"},
        { "location": "2121/Talk", "narrator": "つばめ", "text": "あっ、わたしそれ\n知ってる！\n確か枕の下に──"},
        { "location": "2122/Talk", "narrator": "ガブリエラ", "text": "睡眠学習なんて\n今どき誰も知らないから。"},
        { "location": "2123/Talk", "narrator": "みやび", "text": "むしろ何でガブちゃんが\n知っちゅうかね。"},
        { "location": "2124/Talk", "narrator": "ガブリエラ", "text": "……まぁ、もう\n終わったし、いいわ。\n先、行けば？"},
        { "location": "2125/Talk", "narrator": "みやび", "text": "ガブちゃん、甘いねえ。\n本当に恥ずかしいのは\nこれからやろう？"},
        { "location": "2126/Talk", "narrator": "ガブリエラ", "text": "えっちょっと\nそんなはずは……！"},
        { "location": "2127/Talk", "narrator": "アーヤ", "text": "だから\n隠してたのよね。"},
        { "location": "2128/Talk", "narrator": "アーヤ", "text": "そう？\nならいいんだけど。"},
        { "location": "2129/Talk", "narrator": "アーヤ", "text": "なんでそんな話に\nなるの！？"},
        { "location": "2130/Talk", "narrator": "ガブリエラ", "text": "……えーと。いつまで\n二人だけの世界を\n続けるつもり？"},
        { "location": "2131/Talk", "narrator": "アーヤ", "text": "そういうわけじゃ\nないんだけどね！？"},
        { "location": "2132/Talk", "narrator": "つばめ", "text": "二人の世界って\nいい響きですね。"},
        { "location": "2133/Talk", "narrator": "ガブリエラ", "text": "あんた本当\nポジティブよね……。"},
        { "location": "2134/Talk", "narrator": "神楽", "text": "それがつばめさんの\nいいところですよ♪"},
        { "location": "2135/Talk", "narrator": "ガブリエラ", "text": "みんなして\nなんなのもう……。"},
        { "location": "2136/Talk", "narrator": "アーヤ", "text": "ごめんね。\n話を戻しましょうか。"},
        { "location": "2137/Talk", "narrator": "つばめ", "text": "はーい♪"},
        { "location": "2138/Talk", "narrator": "アーヤ", "text": "すぐそういうこと\n言うんだから。"},
