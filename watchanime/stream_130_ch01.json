        { "location": "2234/Talk", "narrator": "アーヤ", "text": "そ、それじゃあ鑑賞に\n戻りましょうか……。"},
        { "location": "2235/Talk", "narrator": "神楽", "text": "むふふふふふふ……。"},
        { "location": "2236/Talk", "narrator": "神楽", "text": "…………じゅるり。"},
        { "location": "2237/Talk", "narrator": "神楽", "text": "つばめさん、お祈りは\n済ませましたか？\n準備はＯＫ？"},
        { "location": "2238/Talk", "narrator": "ガブリエラ", "text": "はぁ……あたしが\nいじられるのはもう\nこれっきりにしてね。"},
        { "location": "2239/Talk", "narrator": "ガブリエラ", "text": "べつにアンタのことが\n好きとか嫌いとかそう\nいうんじゃないし。"},
        { "location": "2240/Talk", "narrator": "ガブリエラ", "text": "どっちかと言うと？\nそんなこと聞くな、\nばかっ！"},
        { "location": "2241/Talk", "narrator": "アーヤ", "text": "あーあ、何だか今回は\n私もたくさん\nいじられちゃったな。"},
        { "location": "2242/Talk", "narrator": "アーヤ", "text": "でも楽しかったから\nたまにはこういうのも\n悪くないわね。"},
        { "location": "2243/Talk", "narrator": "アーヤ", "text": "社交辞令でも\n嬉しかったわ。\n……ありがとう♪"},
        { "location": "2244/Talk", "narrator": "みやび", "text": "何やラブラブすぎて\n出る機会のうなった。"},
        { "location": "2245/Talk", "narrator": "みやび", "text": "ところでうちとの\nフラグは\nどうなっちゅうかね？"},
        { "location": "2246/Talk", "narrator": "みやび", "text": "今ならサービス満載で\nお得やき\n攻略しとうせ。"},
        { "location": "2247/Talk", "narrator": "つばめ", "text": "今回から新しい\nお話なんですよね？\n楽しみですねっ。"},
        { "location": "2248/Talk", "narrator": "ガブリエラ", "text": "って言っても\n前回のラストからの\n続きじゃないの？"},
        { "location": "2249/Talk", "narrator": "アーヤ", "text": "つばめと卯月が二人で\n出かけて、その帰りに\n呼び出された続き？"},
        { "location": "2250/Talk", "narrator": "みやび", "text": "何やら怪しげな雲行き\nやったし、うちも\n気になっちょった。"},
        { "location": "2251/Talk", "narrator": "つばめ", "text": "べつに、あの後は\n普通に出動して無事に\n解決してましたよね？"},
        { "location": "2252/Talk", "narrator": "みやび", "text": "つばめちゃん、\n油断しちょったら\nいかんよ。"},
        { "location": "2253/Talk", "narrator": "みやび", "text": "つばめちゃんの\nサービスカットが\nそろそろ来る頃やき。"},
        { "location": "2254/Talk", "narrator": "つばめ", "text": "ええぇーっ！？\nそ、そんな、お風呂は\nもうやったし……。"},
        { "location": "2255/Talk", "narrator": "ガブリエラ", "text": "じゃあ、それより凄い\nことなんじゃない？"},
        { "location": "2256/Talk", "narrator": "つばめ", "text": "わわわたしなんかより\nガブちゃんのサービスを\nお願いしますっ！"},
        { "location": "2257/Talk", "narrator": "ガブリエラ", "text": "ちょっと！\nそういうのは\n新人の仕事じゃない？"},
        { "location": "2258/Talk", "narrator": "みやび", "text": "何言うちょるんかね。\nガブちゃんも\nマニアックに人気ぞね。"},
        { "location": "2259/Talk", "narrator": "ガブリエラ", "text": "マニアックって\nなんなのよ！？"},
        { "location": "2260/Talk", "narrator": "つばめ", "text": "わたしはガブちゃんが\nヒラヒラ可愛い服を\n着たのが見たいな♪"},
        { "location": "2261/Talk", "narrator": "ガブリエラ", "text": "…まあそういうのは\n嫌いじゃないけど…。"},
        { "location": "2262/Talk", "narrator": "つばめ", "text": "うんうん\n似合うもんね、\nガブちゃん。"},
        { "location": "2263/Talk", "narrator": "ガブリエラ", "text": "……ガブちゃんは\nやめてよね……。"},
        { "location": "2264/Talk", "narrator": "アーヤ", "text": "ガブちゃんも\n可愛いと思うん\nだけどね。"},
        { "location": "2265/Talk", "narrator": "みやび", "text": "ガブちゃんはうちら\nトライナリーの\nマスコットやき。"},
        { "location": "2266/Talk", "narrator": "ガブリエラ", "text": "みやびに言われるのは\n別にいいけど……。"},
        { "location": "2267/Talk", "narrator": "つばめ", "text": "そんなわけで、\n今回も\n始まりますよーっ♪"},
        { "location": "2268/Talk", "narrator": "つばめ", "text": "あれ？　これって前回\nの最後で呼び出された\n出動とは違う時？"},
        { "location": "2269/Talk", "narrator": "ガブリエラ", "text": "えっ？\n……あぁっ！\nや、やばっ……。"},
        { "location": "2270/Talk", "narrator": "アーヤ", "text": "あら？　これって、\nもしかして……。"},
        { "location": "2271/Talk", "narrator": "つばめ", "text": "あっ！\n何か出て来た！"},
        { "location": "2272/Talk", "narrator": "ガブリエラ", "text": "ストォォォォォォォォ\nップッ！！！！！！！"},
        { "location": "2273/Talk", "narrator": "ガブリエラ", "text": "こ、こらぁ～、\nスタッフ～っ！\n映像が違うわよ～？"},
        { "location": "2274/Talk", "narrator": "ガブリエラ", "text": "仕方ないから今日は\nもう解散するしか\nないわねっ！"},
        { "location": "2275/Talk", "narrator": "みやび", "text": "スタッフさん、\n間違うちょらん\n言うちょるけんど？"},
        { "location": "2276/Talk", "narrator": "ガブリエラ", "text": "そ、そうなの？\nじゃ、じゃああたしが\n確認して来るわっ。"},
        { "location": "2277/Talk", "narrator": "つばめ", "text": "とりあえず、\nちょっとだけ進めて\nみましょう。"},
        { "location": "2278/Talk", "narrator": "ガブリエラ", "text": "あっ！？\nちょ、ちょっと！！"},
        { "location": "2279/Talk", "narrator": "ガブリエラ", "text": "ストップ！\nストップ！！\nストォォォップッ！！"},
        { "location": "2280/Talk", "narrator": "つばめ", "text": "あっ、止まった。"},
        { "location": "2281/Talk", "narrator": "ガブリエラ", "text": "って！\nよりによってここで\n止めないでよっ！！"},
        { "location": "2282/Talk", "narrator": "つばめ", "text": "止めちゃ\nダメだったかな？"},
        { "location": "2283/Talk", "narrator": "ガブリエラ", "text": "ていうか、つばめ、\nアンタわかってて\nとぼけてるでしょ！？"},
        { "location": "2284/Talk", "narrator": "つばめ", "text": "え…？\nわかっててって？"},
        { "location": "2285/Talk", "narrator": "つばめ", "text": "それより\nこのガブちゃん、\nとっても可愛いね♪"},
        { "location": "2286/Talk", "narrator": "ガブリエラ", "text": "つ～ば～め～っ！！"},
        { "location": "2287/Talk", "narrator": "アーヤ", "text": "はぁ……。\n仕方ないわね。\n映像を進めましょう。"},
        { "location": "2288/Talk", "narrator": "アーヤ", "text": "はい、ストップ。"},
        { "location": "2289/Talk", "narrator": "ガブリエラ", "text": "何で止めるのっ！？"},
        { "location": "2290/Talk", "narrator": "アーヤ", "text": "何でって、\nそれは……。\nだって……。"},
        { "location": "2291/Talk", "narrator": "つばめ", "text": "……ア、アーヤさん？"},
        { "location": "2292/Talk", "narrator": "アーヤ", "text": "………………………。\n（チラッ、チラッ）"},
        { "location": "2293/Talk", "narrator": "つばめ", "text": "あっ！　わ、わたし\nこれ知ってますよ！\n確か日曜の朝に……。"},
        { "location": "2294/Talk", "narrator": "つばめ", "text": "……そうそう！\nトリプルメルティーズ！"},
        { "location": "2295/Talk", "narrator": "ガブリエラ", "text": "はい、もうストップ！\n今日はここで\n終わりだから！！"},
        { "location": "2296/Talk", "narrator": "つばめ", "text": "二人とも\nかわいいですね！\nいいなー。"},
        { "location": "2297/Talk", "narrator": "ガブリエラ", "text": "ア、アーヤも\n黙ってないで\n何とか言ってよ！"},
        { "location": "2298/Talk", "narrator": "アーヤ", "text": "本当は恥ずかしかった\nけどね？"},
        { "location": "2299/Talk", "narrator": "ガブリエラ", "text": "本当なのかしら……。"},
        { "location": "2300/Talk", "narrator": "つばめ", "text": "あっ！　すごーい！\n勝ちましたよ！\n三人？　の勝利ですね！"},
        { "location": "2301/Talk", "narrator": "みやび", "text": "最後のキメポーズも\nばっちり息が\n合うちょるねぇ。"},
        { "location": "2302/Talk", "narrator": "ガブリエラ", "text": "だ、だから、\nこれはっ……。"},
        { "location": "2303/Talk", "narrator": "つばめ", "text": "あっ！\nもしかしてこの子が\nフェノメノンの元凶？"},
        { "location": "2304/Talk", "narrator": "みやび", "text": "でもリアル幼女やったん\nやね。ホッとした。"},
        { "location": "2305/Talk", "narrator": "つばめ", "text": "どういうことですか？"},
        { "location": "2306/Talk", "narrator": "みやび", "text": "変身解けたらごっつい\nおっさんやったら\nどうなる？"},
        { "location": "2307/Talk", "narrator": "つばめ", "text": "あー……。\nそれは……。"},
        { "location": "2308/Talk", "narrator": "つばめ", "text": "とにかくこれで\n一件落着ですね！"},
        { "location": "2309/Talk", "narrator": "ガブリエラ", "text": "はぁ～……。\nやっと終わった……。"},
        { "location": "2310/Talk", "narrator": "みやび", "text": "ほな、うちは\n楽しみ疲れたんで、\n一旦下がるきね。"},
        { "location": "2311/Talk", "narrator": "神楽", "text": "ていうかー、\n交代するの\n遅いですよ～っ！！"},
        { "location": "2312/Talk", "narrator": "神楽", "text": "せっかくの魔法少女\nだったのにーっ！"},
        { "location": "2313/Talk", "narrator": "神楽", "text": "色々と細かい設定とか\n検証したかった\nのにぃ～っ！"},
        { "location": "2314/Talk", "narrator": "ガブリエラ", "text": "うん、アンタいなくて\nホントよかった……。"},
        { "location": "2315/Talk", "narrator": "ガブリエラ", "text": "そうそう、ちなみに\nここのお店、あたしの\nお気に入りだから。"},
        { "location": "2316/Talk", "narrator": "つばめ", "text": "このお店の看板猫が\nとっても人懐っこくて\nかわいいんだよね。"},
        { "location": "2317/Talk", "narrator": "アーヤ", "text": "このよもぎマンヂウも\nとっても美味しくて\n大好きよ。"},
        { "location": "2318/Talk", "narrator": "ガブリエラ", "text": "ていうか、\nアーヤは食べ過ぎ。"},
        { "location": "2319/Talk", "narrator": "アーヤ", "text": "ええっ！？"},
        { "location": "2320/Talk", "narrator": "つばめ", "text": "あっ、アーヤさんの\nバイクだ。\nかっこいいですね。"},
        { "location": "2321/Talk", "narrator": "アーヤ", "text": "ありがとう。\nお気に入りの愛車よ。"},
        { "location": "2322/Talk", "narrator": "つばめ", "text": "かっこいいなぁ。\nわたしもバイクに\n乗ってみたいなぁ。"},
        { "location": "2323/Talk", "narrator": "アーヤ", "text": "つばめも１６歳に\nなれば免許は取れるわよ？"},
        { "location": "2324/Talk", "narrator": "つばめ", "text": "あうぅ～、でもわたし\n免許取るのとかきっと\n苦手そう～……。"},
        { "location": "2325/Talk", "narrator": "神楽", "text": "それでアーヤさんは\nどちらにお出かけ\nするんですか？"},
        { "location": "2326/Talk", "narrator": "ガブリエラ", "text": "それは見てれば\nすぐにわかるでしょ。"},
        { "location": "2327/Talk", "narrator": "神楽", "text": "と言いつつ、どこに\n行くか気にしてたのは\nガブちゃんですよね？"},
        { "location": "2328/Talk", "narrator": "ガブリエラ", "text": "べ、べつに、ただ、\n会話の流れ的に\n聞いてただけよっ。"},
        { "location": "2329/Talk", "narrator": "ガブリエラ", "text": "あたしも出かけようと\n思ってたし、だったら\nついでにって。"},
        { "location": "2330/Talk", "narrator": "つばめ", "text": "あれっ？\nガブちゃん\nもしかして尾行？"},
        { "location": "2331/Talk", "narrator": "神楽", "text": "みたいですねー。\nやっぱり気になります\nもんねっ♪"},
        { "location": "2332/Talk", "narrator": "ガブリエラ", "text": "あたしはただ\n心配して……。"},
        { "location": "2333/Talk", "narrator": "アーヤ", "text": "ギャヴィ、後をつけて\n来たことには\n変わらないわよ……。"},
        { "location": "2334/Talk", "narrator": "ガブリエラ", "text": "知らないわ。"},
        { "location": "2335/Talk", "narrator": "神楽", "text": "あららっ、ガブちゃん\n子供たちに\n見つかっちゃったね。"},
        { "location": "2336/Talk", "narrator": "ガブリエラ", "text": "別に悪いことしてたわけ\nじゃないから！"},
        { "location": "2337/Talk", "narrator": "つばめ", "text": "あっ、今度はアーヤさんに\n連行されましたね。"},
        { "location": "2338/Talk", "narrator": "ガブリエラ", "text": "だから犯罪者みたいに\n言わないで！！"},
        { "location": "2339/Talk", "narrator": "つばめ", "text": "あれ？　さっき一緒に\n人形劇をやってた人は\nどこに行ったの？"},
        { "location": "2340/Talk", "narrator": "アーヤ", "text": "たまたま画面に映って\nいないだけだから\n気にしないで……。"},
        { "location": "2341/Talk", "narrator": "ガブリエラ", "text": "つばめってそういう\nところだけは\n目ざといのよね。"},
        { "location": "2342/Talk", "narrator": "つばめ", "text": "ガブちゃんに\n褒められた……。"},
        { "location": "2343/Talk", "narrator": "神楽", "text": "私はいつでもつばめさんを\n全肯定しますよ♪"},
        { "location": "2344/Talk", "narrator": "つばめ", "text": "それはそれで\n恥ずかしいかも……。"},
        { "location": "2345/Talk", "narrator": "神楽", "text": "あっ、今アーヤさんが\n大事なことを言いましたよ。"},
        { "location": "2346/Talk", "narrator": "つばめ", "text": "アーヤさん、やっぱり\n保育士や小学校の先生\nになりたいんですね。"},
        { "location": "2347/Talk", "narrator": "つばめ", "text": "とってもアーヤさんに\n似合ってると思います！"},
        { "location": "2348/Talk", "narrator": "アーヤ", "text": "ありがとう。\nそう言ってもらえると\n嬉しいわ。"},
        { "location": "2349/Talk", "narrator": "ガブリエラ", "text": "あ、あたしも\nそう思うわよ。"},
        { "location": "2350/Talk", "narrator": "アーヤ", "text": "そう？\nギャヴィもありがとう。"},
        { "location": "2351/Talk", "narrator": "アーヤ", "text": "あら？\nこんな所で止めて、\n一体どうしたの？"},
        { "location": "2352/Talk", "narrator": "つばめ", "text": "でもいきなり人形劇\nできちゃうなんて\nさすがガブちゃん！"},
        { "location": "2353/Talk", "narrator": "ガブリエラ", "text": "別に普通よ\nこのくらい。"},
        { "location": "2354/Talk", "narrator": "つばめ", "text": "あっ、これって\n今回の最初の\n戦いの時のですね。"},
        { "location": "2355/Talk", "narrator": "ガブリエラ", "text": "ええ、園の子供たちも\nみんなこのアニメが\n大好きだから。"},
        { "location": "2356/Talk", "narrator": "神楽", "text": "私だって大好きだから\nあの戦いに参加\nしたかったのにぃ～。"},
        { "location": "2357/Talk", "narrator": "アーヤ", "text": "次にまたこういう\nフェノメノンが\n現われたら、ね……。"},
        { "location": "2358/Talk", "narrator": "神楽", "text": "ですって！\n楽しみですね、\nつばめさん！"},
        { "location": "2359/Talk", "narrator": "つばめ", "text": "えっ？　あたしは\nべつに、どっちでも\nいいんだけど……。"},
        { "location": "2360/Talk", "narrator": "神楽", "text": "どっちでもいいなら\n問題なしですねっ！"},
        { "location": "2361/Talk", "narrator": "神楽", "text": "というわけで次回は\n私とつばめさんとの\nデート回ですよっ！"},
        { "location": "2362/Talk", "narrator": "つばめ", "text": "そうだったっけ？"},
        { "location": "2363/Talk", "narrator": "つばめ", "text": "デートだなんて\n大袈裟だよ～。"},
        { "location": "2364/Talk", "narrator": "ガブリエラ", "text": "……ま、がんばって。"},
        { "location": "2365/Talk", "narrator": "アーヤ", "text": "……楽しめると\nいいわね。"},
        { "location": "2366/Talk", "narrator": "つばめ", "text": "えぇーっ！？\nどうして二人とも\n引いてるんですか！？"},
        { "location": "2367/Talk", "narrator": "つばめ", "text": "$handle$さん、\n次回のわたし、\n大丈夫ですよね！？"},
        { "location": "2368/Talk", "narrator": "つばめ", "text": "何だかすっごく不安に\nなってきたんだけど、\nどうしよう！？"},
        { "location": "2369/Talk", "narrator": "つばめ", "text": "もしかして\nもしかすると\nもしかしちゃうの！？"}
    ]
}
