    "dir": "stream_020_ch01TOUCHSELayamiOnFlick.json",
    "type": "watchanime",
    "info": {
    },
    "entry":
    [
        { "location": "403/Stay", "narrator": "", "text": "スプリングフィル"},
        { "location": "404/Talk", "narrator": "ガブリエラ", "text": "いよいよ戦闘開始ね。\nあたしたちの活躍を\n見せてあげ──"},
        { "location": "405/Talk", "narrator": "つばめ", "text": "きゃーっ！\nメノウちゃーんっ！！"},
        { "location": "406/Talk", "narrator": "ガブリエラ", "text": "ちょっと、つばめ！\n割り込まないでよっ！"},
        { "location": "407/Talk", "narrator": "つばめ", "text": "だってメノウちゃんが\nメノウちゃんが\nメノウちゃんがっ！"},
        { "location": "408/Talk", "narrator": "ガブリエラ", "text": "わかったから黙って！"},
        { "location": "409/Talk", "narrator": "アーヤ", "text": "つばめ、この時、\nあなたに一体何が\n起こってたの？"},
        { "location": "410/Talk", "narrator": "つばめ", "text": "実は、この時のことは\nよく憶えていなくて。"},
        { "location": "411/Talk", "narrator": "つばめ", "text": "突然すっごい目眩が\n襲ってきて……。"},
        { "location": "412/Talk", "narrator": "つばめ", "text": "気づいたら世界が\n変わってたって\n感じで……。"},
        { "location": "413/Talk", "narrator": "ガブリエラ", "text": "！？\n背後から誰かに\n撃たれたの？"},
        { "location": "414/Talk", "narrator": "みやび", "text": "それってガブちゃんや\nなかったん？"},
        { "location": "415/Talk", "narrator": "ガブリエラ", "text": "失礼ね！　あたしなら\n正面から堂々と\nつばめを撃つわよ。"},
        { "location": "416/Talk", "narrator": "つばめ", "text": "撃たないでーっ！！"},
        { "location": "417/Talk", "narrator": "みやび", "text": "まぁ、演出やね。"},
        { "location": "418/Talk", "narrator": "つばめ", "text": "そういえば、わたしが\nここで睨まれたのって\n何でなんだろ？"},
        { "location": "419/Talk", "narrator": "みやび", "text": "そんなところやろな。\n発症者には\nすぐにわかるき。"},
        { "location": "420/Talk", "narrator": "アーヤ", "text": "ちなみに周辺一帯は\n完全に封鎖されていて\n人の往来は無いわ。"},
        { "location": "421/Talk", "narrator": "みやび", "text": "毎度迅速な対応、\n現場の皆さん\nご苦労様々やね。"},
        { "location": "422/Talk", "narrator": "つばめ", "text": "あぁーっ！\nみんなでこんな賭けを\nしてたんですか！？"},
        { "location": "423/Talk", "narrator": "ガブリエラ", "text": "そんなこと言われても\nつばめはまだこっちに\nいなかったし。"},
        { "location": "424/Talk", "narrator": "アーヤ", "text": "私は賭けに乗らないで\n注意してるでしょ？"},
        { "location": "425/Talk", "narrator": "アーヤ", "text": "これは通常攻撃隊ね。\nいつも私たちを支えて\nくれる味方よ。"},
        { "location": "426/Talk", "narrator": "つばめ", "text": "はぁ～。縁の下の\n力こぶさんですね！"},
        { "location": "427/Talk", "narrator": "アーヤ", "text": "……つっこんだ方が\nいいのかしら？"},
        { "location": "428/Talk", "narrator": "ガブリエラ", "text": "いよいよあたしたち\n「特別」攻撃隊の\n出番よ！　「特別」！"},
        { "location": "429/Talk", "narrator": "みやび", "text": "そない強調せんでも。"},
        { "location": "430/Talk", "narrator": "つばめ", "text": "あれれっ？\n通常攻撃隊の皆さん、\n何か変ですよね？"},
        { "location": "431/Talk", "narrator": "みやび", "text": "ほほぅ。\nそこに気づくとは。"},
        { "location": "432/Talk", "narrator": "アーヤ", "text": "原則として私たちは\n顔バレしたら\nいけないのよ。"},
        { "location": "433/Talk", "narrator": "つばめ", "text": "トップシークレット\nってことですか！？"},
        { "location": "434/Talk", "narrator": "みやび", "text": "そうちや。\n機密隠蔽の為に\n皆、色々してるんよ？"},
        { "location": "435/Talk", "narrator": "みやび", "text": "まぁ、そのうちなー。\nうちは毎日見ちょるき\n結構面白いで。"},
        { "location": "436/Talk", "narrator": "アーヤ", "text": "こら、みやび。\nそんな風に\n言うもんじゃないわ。"},
        { "location": "437/Talk", "narrator": "ガブリエラ", "text": "ていうか、あれって\n絶対に面白がって\n作ってる気がする。"},
        { "location": "438/Talk", "narrator": "アーヤ", "text": "あああっ！！\nちょっと待って！\nここで止めてっ！"},
        { "location": "439/Talk", "narrator": "アーヤ", "text": "こ、心の準備がっ！"},
        { "location": "440/Talk", "narrator": "ガブリエラ", "text": "……は？　いきなり\n何言ってるわけ？"},
        { "location": "441/Talk", "narrator": "つばめ", "text": "さすがに、かなり\n引きました……。"},
        { "location": "442/Talk", "narrator": "みやび", "text": "唐突にそない高度な\n嗜好を暴露されても\nついていかれへんわ。"},
        { "location": "443/Talk", "narrator": "アーヤ", "text": "そういう問題じゃ\nないでしょ……。"},
        { "location": "444/Talk", "narrator": "みやび", "text": "んー？\n何かやらしいコトでも\n考えてたん？"},
        { "location": "445/Talk", "narrator": "ガブリエラ", "text": "うわ、サイテー……。"},
        { "location": "446/Talk", "narrator": "つばめ", "text": "そ、そんな、\n決めつけるのは、\nよくないですよっ！"},
        { "location": "447/Talk", "narrator": "アーヤ", "text": "ええ、とりあえず\nこの場で追及するのは\nやめましょう。"},
        { "location": "448/Talk", "narrator": "アーヤ", "text": "そこつっこまない！"},
        { "location": "449/Talk", "narrator": "みやび", "text": "その為にアーヤは\n古今東西のお笑いに\n通じてるぞね。"},
        { "location": "450/Talk", "narrator": "つばめ", "text": "ほわぁ～、\nさすがアーヤさん！\n尊敬しちゃいますっ。"},
        { "location": "451/Talk", "narrator": "アーヤ", "text": "え、えーと……。"},
        { "location": "452/Talk", "narrator": "アーヤ", "text": "何か言いたそうね？\n遠慮しないで言っても\nいいのよ？"},
        { "location": "453/Talk", "narrator": "みやび", "text": "ただし、それが\n貴様の辞世の句に\nなるけどな！"},
        { "location": "454/Talk", "narrator": "つばめ", "text": "……アーヤさん、\n苦しまないように\n一撃でお願いします。"},
        { "location": "455/Talk", "narrator": "アーヤ", "text": "人聞きの悪いことを\n言わないでよっ！"},
        { "location": "456/Talk", "narrator": "つばめ", "text": "ほぇ～。\nわたしも見たいです！"},
        { "location": "457/Talk", "narrator": "みやび", "text": "どうしよかな～。\nつばめちゃんには、\n刺激が強いかもな～。"},
        { "location": "458/Talk", "narrator": "つばめ", "text": "えぇっ！？\n……そ、そんなに\nなんですか？"},
        { "location": "459/Talk", "narrator": "ガブリエラ", "text": "そんなにって、\nどんなのを\n想像してるのよ……。"},
        { "location": "460/Talk", "narrator": "みやび", "text": "興味無いフリして\n後でこっそり検索する\nつもりやな？"},
        { "location": "461/Talk", "narrator": "つばめ", "text": "わたしは見たいです！"},
        { "location": "462/Talk", "narrator": "アーヤ", "text": "……つばめは\n見ない方が\n良いと思うわ。"},
        { "location": "463/Talk", "narrator": "つばめ", "text": "えぇっ！？\nそんな風に言われたら\n気になりますよぉ～。"},
        { "location": "464/Talk", "narrator": "みやび", "text": "そうそう、\nアーヤの過保護には\n気ぃつけとき。"},
        { "location": "465/Talk", "narrator": "みやび", "text": "あー、うちのことは\n気にせんと。"},
        { "location": "466/Talk", "narrator": "みやび", "text": "ほんなら、またなー。"},
        { "location": "467/Talk", "narrator": "みやび", "text": "りみった"},
        { "location": "468/Talk", "narrator": "つばめ", "text": "えっ、あの、\nそのっ……。"},
        { "location": "469/Talk", "narrator": "つばめ", "text": "ちょ、ちょっと\n待ってくださいっ。"},
        { "location": "470/Talk", "narrator": "つばめ", "text": "お……、\nお疲れ様でしたーっ！"},
        { "location": "471/Talk", "narrator": "つばめ", "text": "りみった"},
        { "location": "472/Talk", "narrator": "ガブリエラ", "text": "えっ？　最後に\nあたしだけ残して\n何する気？"},
        { "location": "473/Talk", "narrator": "ガブリエラ", "text": "まさか、あんた、\nあたしに……。"},
        { "location": "474/Talk", "narrator": "ガブリエラ", "text": "あははっ、\n冗談だってばっ。\nバイバイっ♪"},
        { "location": "475/Talk", "narrator": "ガブリエラ", "text": "りみった"},
        { "location": "476/Talk", "narrator": "ガブリエラ", "text": "さぁ、アーヤの\n魅惑的な太もも\n鑑賞会よ！"},
        { "location": "477/Talk", "narrator": "アーヤ", "text": "いやぁーっ！！"},
        { "location": "478/Talk", "narrator": "つばめ", "text": "でも起動しても\nまだ制服のまま\nなんですね。"},
        { "location": "479/Talk", "narrator": "みやび", "text": "空気を読まない冷静な\nつっこみやね。まぁ、\n勿体つけるのは基本。"},
        { "location": "480/Talk", "narrator": "アーヤ", "text": "そこは\n気にすることじゃ\nないわよ……。"},
        { "location": "481/Talk", "narrator": "つばめ", "text": "あっ、ここから\nわたしピンチです！"},
        { "location": "482/Talk", "narrator": "ガブリエラ", "text": "走ったって言うか、\nよじ登ってるし。"},
        { "location": "483/Talk", "narrator": "つばめ", "text": "そこは何て言うか、\n今、冷静に考えると\n罠だったのかな？"},
        { "location": "484/Talk", "narrator": "ガブリエラ", "text": "冷静に考えなくても\n普通に罠でしょ。"},
        { "location": "485/Talk", "narrator": "みやび", "text": "まんまと不利な状況に\n追い込まれてた\nわけやねぇ。"},
        { "location": "486/Talk", "narrator": "つばめ", "text": "ううっ、\nごめんなさぁい……。"},
        { "location": "487/Talk", "narrator": "アーヤ", "text": "そんなに気にすること\nないわよ。\nつばめ。"},
        { "location": "488/Talk", "narrator": "みやび", "text": "おおーっ、\nホラーな引きやね。"},
        { "location": "489/Talk", "narrator": "ガブリエラ", "text": "つばめの運命や\n如何に！？"},
        { "location": "490/Talk", "narrator": "つばめ", "text": "そんなぁ……。\nわたし、すっごく\n怖かったですよ……。"},
        { "location": "491/Talk", "narrator": "アーヤ", "text": "私たちがついてるから\n怖くないわよ。\n安心して。つばめ。"},
        { "location": "492/Talk", "narrator": "つばめ", "text": "アーヤさん……。"},
        { "location": "493/Talk", "narrator": "アーヤ", "text": "ちょっと待って。\n今、つばめを\nなぐさめて……。"},
        { "location": "494/Talk", "narrator": "アーヤ", "text": "いえ、これは\nリーダーとしての\n務めで。"},
        { "location": "495/Talk", "narrator": "アーヤ", "text": "わかったわよ。\nもう……。"},
        { "location": "496/Talk", "narrator": "アーヤ", "text": "りみった"}
    ]
}
