{
    "dir": "stream_380_ch011ACTOnCancel2ACTOnCancel3ACTOnCancel4ACTOnCancel5ACTOnCancel6ACTOnCancel.json",
    "type": "watchanime",
    "info": {
    },
    "entry":
    [
        { "location": "7615/Talk", "narrator": "逢瀬つばめ", "text": "いらっしゃい、\n$handle$さん。"},
        { "location": "7616/Talk", "narrator": "逢瀬つばめ", "text": "ここに来てくれて\nありがとうございます。\nとっても嬉しいです。"},
        { "location": "7617/Talk", "narrator": "逢瀬つばめ", "text": "今回ここで\nご覧いただく映像は――"},
        { "location": "7618/Talk", "narrator": "逢瀬つばめ", "text": "前にお伝えしたように、\n$handle$さんと\n出逢った頃のものです。"},
        { "location": "7619/Talk", "narrator": "逢瀬つばめ", "text": "他のみんなに比べて\nなんだか見劣りしちゃうし\nつまらないし――"},
        { "location": "7620/Talk", "narrator": "逢瀬つばめ", "text": "よくわからない動画だけど\n最後まで一緒に見ていって\n欲しいです！"},
        { "location": "7621/Talk", "narrator": "つばめ", "text": "短い時間ですけど、\nよろしくお願いします！"},
        { "location": "7622/Talk", "narrator": "つばめ", "text": "……って、\nいきなりここなんだ。"},
        { "location": "7623/Talk", "narrator": "つばめ", "text": "そうだ。\nなんか懐かしくなって\nきちゃったから――"},
        { "location": "7624/Talk", "narrator": "つばめ", "text": "ちょっと遠州弁で\n喋ってみようかなぁ。"},
        { "location": "7625/Talk", "narrator": "つばめ", "text": "歌はとってもカフェっ\nぽくてオシャレなのに、\nちょっとアレだけど……"},
        { "location": "7626/Talk", "narrator": "つばめ", "text": "そういえばこの時、\nかなり後悔したんだよね。"},
        { "location": "7627/Talk", "narrator": "つばめ", "text": "新幹線に乗っていけば、\n最初からメノウちゃんの\nライブ見れたのになぁ。"},
        { "location": "7628/Talk", "narrator": "つばめ", "text": "あっ！\n歌が始まった……に？"},
        { "location": "7629/Talk", "narrator": "つばめ", "text": "きゃーーー！\n恥ずかしいぃぃぃ！"},
        { "location": "7630/Talk", "narrator": "つばめ", "text": "って、こんな事してちゃあ\nいつまで経っても\nお話し進まないら。"},
        { "location": "7631/Talk", "narrator": "つばめ", "text": "これじゃあ\n$handle$さんに\n申し訳無いで――"},
        { "location": "7632/Talk", "narrator": "つばめ", "text": "もう開き直って行くでね！"},
        { "location": "7633/Talk", "narrator": "つばめ", "text": "思い返しゃ、こん時が\n$handle$さんとの\n出逢いだったぁよね。"},
        { "location": "7634/Talk", "narrator": "つばめ", "text": "こん時ゃまだ、\n今みたくになるなんて\n思いもせんかったけぇが。"},
        { "location": "7635/Talk", "narrator": "つばめ", "text": "はぁぁ……。"},
        { "location": "7636/Talk", "narrator": "つばめ", "text": "もうやめやめ！\n方言で会話するのは\nここまでーっ！！"},
        { "location": "7637/Talk", "narrator": "つばめ", "text": "ガブちゃんや神楽ちゃんの\n方が全然可愛いし。"},
        { "location": "7638/Talk", "narrator": "つばめ", "text": "みやびさんやアーヤさんは\nすごい美人だし。"},
        { "location": "7639/Talk", "narrator": "つばめ", "text": "わたしだけ、なんか\n全然ダメだなぁって\nいつも思っちゃって。"},
        { "location": "7640/Talk", "narrator": "つばめ", "text": "勉強も運動もホントに\nみんな凄いよね。わたしは\nどっちもダメだけど――"},
        { "location": "7641/Talk", "narrator": "つばめ", "text": "へ……？"},
        { "location": "7642/Talk", "narrator": "つばめ", "text": "ひゃあああああ！！\nなんでここで、\nこんな映像が！？"},
        { "location": "7643/Talk", "narrator": "つばめ", "text": "ストップストップ！"},
        { "location": "7644/Talk", "narrator": "つばめ", "text": "やっぱ止めちゃダメ！"},
        { "location": "7645/Talk", "narrator": "つばめ", "text": "ああっ！\nやっぱりストップー！"},
        { "location": "7646/Talk", "narrator": "つばめ", "text": "ふえええ……。"},
        { "location": "7647/Talk", "narrator": "つばめ", "text": "全然尊くなんか\nないよぅ……。"},
        { "location": "7648/Talk", "narrator": "つばめ", "text": "で、でも、\nアレかなぁ……。"},
        { "location": "7649/Talk", "narrator": "つばめ", "text": "こういうのも、きっと\n大人の階段登るって\nやつなんだよね！"},
        { "location": "7650/Talk", "narrator": "つばめ", "text": "恥ずかしいけど\nここは頑張って\n涼しい顔しなくちゃ……"},
        { "location": "7651/Talk", "narrator": "つばめ", "text": "って！\nやっぱり無理ー！！"},
        { "location": "7652/Talk", "narrator": "つばめ", "text": "あっ！\n終わった！！\nよかったぁ～……。"},
        { "location": "7653/Talk", "narrator": "つばめ", "text": "残念じゃ\nないよぅ……。"},
        { "location": "7654/Talk", "narrator": "つばめ", "text": "ええっ！？\nまた――？"},
        { "location": "7655/Talk", "narrator": "つばめ", "text": "えっと、嫌じゃないけど\nやっぱりドキドキするし。"},
        { "location": "7656/Talk", "narrator": "つばめ", "text": "もうちょっと、\n頑張って練習したら\nにしよう？　ね？"},
        { "location": "7657/Talk", "narrator": "つばめ", "text": "ふぅ……。"},
        { "location": "7658/Talk", "narrator": "つばめ", "text": "きっともう大丈夫。\nはぁ、ビックリしたぁ。"},
        { "location": "7659/Talk", "narrator": "つばめ", "text": "この時はホントに\nメノウちゃんのことで\n頭いっぱいだったなぁ。"},
        { "location": "7660/Talk", "narrator": "つばめ", "text": "今は、\n$handle$さんで\n頭いっぱいだけど……。"},
        { "location": "7661/Talk", "narrator": "つばめ", "text": "$handle$さん。\n本当に今の今までずっと、\nありがとうございます。"},
        { "location": "7662/Talk", "narrator": "つばめ", "text": "わたし、\n$handle$さんが\nいたから今があると思う。"},
        { "location": "7663/Talk", "narrator": "つばめ", "text": "いつもわたしのことを\n見守ってくれていて――"},
        { "location": "7664/Talk", "narrator": "つばめ", "text": "今日も、\n二人で見るって思って、\nすごく緊張したけど！"},
        { "location": "7665/Talk", "narrator": "つばめ", "text": "$handle$さん、\nいつもみたいに優しくて\nとても楽しかったよ。"},
        { "location": "7666/Talk", "narrator": "つばめ", "text": "わたしの方が、\n途中で落ち込んだりして\nごめんね？"},
        { "location": "7667/Talk", "narrator": "つばめ", "text": "でも、ああいうの\nあまり人に\n見せないから――"},
        { "location": "7668/Talk", "narrator": "つばめ", "text": "…ううん。\n$handle$さんにしか\n見せたことないや。"},
        { "location": "7669/Talk", "narrator": "つばめ", "text": "だから今日は、\nとっても嬉しかったです。"},
        { "location": "7670/Talk", "narrator": "つばめ", "text": "$handle$さんには\n弱いところ見せても\n大丈夫だって思えたし。"},
        { "location": "7671/Talk", "narrator": "つばめ", "text": "えへへ、ありがとう。"},
        { "location": "7672/Talk", "narrator": "つばめ", "text": "あはは……。\nそれだけが\n取り柄だもんね。"},
        { "location": "7673/Talk", "narrator": "つばめ", "text": "だから、\n何度も同じ事\n言っちゃうかもだけど――"},
        { "location": "7674/Talk", "narrator": "つばめ", "text": "わたしは、\n$handle$さんが\n大好きです！"},
        { "location": "7675/Talk", "narrator": "つばめ", "text": "ずっとずっと、\n一緒にいたいです……。"},
        { "location": "7676/Talk", "narrator": "つばめ", "text": "ずっと、…ずっと……。"},
        { "location": "7677/Talk", "narrator": "つばめ", "text": "$handle$さんっ！"},
        { "location": "7678/Talk", "narrator": "つばめ", "text": "はあっ……\n名前で呼ばれると、\nなんか夫婦みたいですね。"},
        { "location": "7679/Talk", "narrator": "つばめ", "text": "えっと……"},
        { "location": "7680/Talk", "narrator": "つばめ", "text": "これからもずっと、\nわたしの隣に\nいてくださいね。"},
        { "location": "7681/Talk", "narrator": "つばめ", "text": "あはっ！\n嬉しいです！"},
        { "location": "7682/Talk", "narrator": "つばめ", "text": "ずっとずっと\n一緒なんだ～！\nえへへ……。"},
        { "location": "7683/Talk", "narrator": "つばめ", "text": "ああっ、もちろん\n全然それで構わないです！"},
        { "location": "7684/Talk", "narrator": "つばめ", "text": "その子のことを\nずっとずっと、大事に\nしてあげてください！"},
        { "location": "7685/Talk", "narrator": "つばめ", "text": "でも、わたしがまた\n落ち込んだりしたとき――"},
        { "location": "7686/Talk", "narrator": "つばめ", "text": "ちょっとだけ、\nお話聞いてくれると\nとっても嬉しいです！"},
        { "location": "7687/Talk", "narrator": "つばめ", "text": "映像終わったのに、\n長話しちゃいましたね。"},
        { "location": "7688/Talk", "narrator": "つばめ", "text": "今日はそろそろ\nお終いにしなくちゃ。"},
        { "location": "7689/Talk", "narrator": "つばめ", "text": "$handle$さん。\n今日はほんとに\nありがとうございました。"},
        { "location": "7690/Talk", "narrator": "つばめ", "text": "また、これからも\nよろしくお願いします！"},
        { "location": "7691/Talk", "narrator": "つばめ", "text": "$handle$さんと\nわたしに、\n素敵なココロの旅を！"},
        { "location": "7692/Talk", "narrator": "つばめ", "text": "ばいばい！"}
    ]
}
