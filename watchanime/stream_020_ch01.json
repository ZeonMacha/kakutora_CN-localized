{
    "dir": "stream_020_ch01.json",
    "type": "watchanime",
    "info": {
    },
    "entry":
    [
        { "location": "270/Talk", "narrator": "ガブリエラ", "text": "……は？　いきなり\n何言ってるわけ？"},
        { "location": "271/Talk", "narrator": "つばめ", "text": "さすがに、ちょっと\n引きました……。"},
        { "location": "272/Talk", "narrator": "みやび", "text": "唐突にそんな高度な\n嗜好を暴露されたら\nどん引きぞね。"},
        { "location": "273/Talk", "narrator": "アーヤ", "text": "そういう問題じゃ\nないでしょ……。"},
        { "location": "274/Talk", "narrator": "みやび", "text": "んー？\n何かえずいコトでも\n考えとった感じ？"},
        { "location": "275/Talk", "narrator": "ガブリエラ", "text": "うわ、サイテー……。"},
        { "location": "276/Talk", "narrator": "つばめ", "text": "そ、そんな、\n決めつけるのは、\nよくないですよっ！"},
        { "location": "277/Talk", "narrator": "アーヤ", "text": "ええ、とりあえず\nこの場で追及するのは\nやめましょう。"},
        { "location": "278/Talk", "narrator": "アーヤ", "text": "そこつっこまない！"},
        { "location": "279/Talk", "narrator": "アーヤ", "text": "……い、一応あれよ、\n緊張を解きほぐすのも\nリーダーの務めよ？"},
        { "location": "280/Talk", "narrator": "みやび", "text": "その為にアーヤは\n古今東西のお笑いに\n通じちゅう。"},
        { "location": "281/Talk", "narrator": "つばめ", "text": "うわぁ～、\nさすがアーヤさん！\n尊敬しちゃいますっ。"},
        { "location": "282/Talk", "narrator": "アーヤ", "text": "え、えーと……。"},
        { "location": "283/Talk", "narrator": "アーヤ", "text": "何か言いたそうね？\n遠慮しないで言っても\nいいのよ？"},
        { "location": "284/Talk", "narrator": "みやび", "text": "ただし、それが\n貴様の辞世の句に\nなるけどな！"},
        { "location": "285/Talk", "narrator": "つばめ", "text": "……アーヤさん、\n苦しまないように\n一撃でお願いします。"},
        { "location": "286/Talk", "narrator": "アーヤ", "text": "人聞きの悪いことを\n言わないでよっ！"},
        { "location": "287/Talk", "narrator": "アーヤ", "text": "……冗談だから、\n本気にしないでね？"},
        { "location": "288/Talk", "narrator": "つばめ", "text": "わぁっ！\nわたしも見たいです！"},
        { "location": "289/Talk", "narrator": "みやび", "text": "どうしよかな～。\nつばめちゃんには、\n刺激が強いかもな～。"},
        { "location": "290/Talk", "narrator": "つばめ", "text": "えぇっ！？\n……そ、そんなに\nなんですか？"},
        { "location": "291/Talk", "narrator": "ガブリエラ", "text": "そんなにって、\nどんなのを\n想像してるのよ……。"},
        { "location": "292/Talk", "narrator": "みやび", "text": "興味無いフリして\n後でこっそり検索する\nつもりやな？"},
        { "location": "293/Talk", "narrator": "みやび", "text": "正直に見たい言えば\nええのに。"},
        { "location": "294/Talk", "narrator": "つばめ", "text": "わたしは見たいです！"},
        { "location": "295/Talk", "narrator": "アーヤ", "text": "……逢瀬さんは\n見ない方が\n良いと思うわ。"},
        { "location": "296/Talk", "narrator": "つばめ", "text": "えぇっ！？\nそんな風に言われたら\n気になりますよぉ～。"},
        { "location": "297/Talk", "narrator": "みやび", "text": "そうそう、\nアーヤの過保護には\n気ぃつけとき。"},
        { "location": "298/Talk", "narrator": "みやび", "text": "あー、うちのことは\n気にせんと。"},
        { "location": "299/Talk", "narrator": "みやび", "text": "ほんなら、またなー。"},
        { "location": "300/Talk", "narrator": "つばめ", "text": "えっ、あの、\nそのっ……。"},
        { "location": "301/Talk", "narrator": "つばめ", "text": "ちょ、ちょっと\n待ってくださいっ。"},
        { "location": "302/Talk", "narrator": "つばめ", "text": "お……、\nお疲れ様でしたーっ！"},
        { "location": "303/Talk", "narrator": "ガブリエラ", "text": "えっ？　最後に\nあたしだけ残して\n何する気？"},
        { "location": "304/Talk", "narrator": "ガブリエラ", "text": "まさか、あんた、\nあたしに……。"},
        { "location": "305/Talk", "narrator": "ガブリエラ", "text": "あははっ、\n冗談だってばっ。\nバイバイっ♪"},
        { "location": "306/Talk", "narrator": "アーヤ", "text": "こんにちは、\n綾水です。"},
        { "location": "307/Talk", "narrator": "アーヤ", "text": "今回は私が\nトップバッターなのね。"},
        { "location": "308/Talk", "narrator": "みやび", "text": "コイガサキ参上。"},
        { "location": "309/Talk", "narrator": "アーヤ", "text": "あら、早かったわね。"},
        { "location": "310/Talk", "narrator": "みやび", "text": "まだ来ちゅうんは\nアーヤだけか。"},
        { "location": "311/Talk", "narrator": "みやび", "text": "何とも言えん\nカップリングに\nなったね。"},
        { "location": "312/Talk", "narrator": "アーヤ", "text": "それ、どういう意味？"},
        { "location": "313/Talk", "narrator": "みやび", "text": "年増コンビ。"},
        { "location": "314/Talk", "narrator": "アーヤ", "text": "失礼ね！　と言いたい\n所だけど、自爆してる\nところがみやびらしい。"},
        { "location": "315/Talk", "narrator": "つばめ", "text": "お、遅くなりましたぁ！"},
        { "location": "316/Talk", "narrator": "アーヤ", "text": "遅いわよ。"},
        { "location": "317/Talk", "narrator": "つばめ", "text": "ごめんなさい……っ。\n……って、あれ？\nせんぱいは？"},
        { "location": "318/Talk", "narrator": "ガブリエラ", "text": "ちゃんと来てるわよ。"},
        { "location": "319/Talk", "narrator": "みやび", "text": "来ちょったんやったら\nちゃんと顔出しぃや。"},
        { "location": "320/Talk", "narrator": "ガブリエラ", "text": "だって、どうせまた\n同じ映像と\n同じ音楽でしょ？"},
        { "location": "321/Talk", "narrator": "ガブリエラ", "text": "話す事なんて\n何も無いじゃない。"},
        { "location": "322/Talk", "narrator": "アーヤ", "text": "まあそうだけど……。"},
        { "location": "323/Talk", "narrator": "みやび", "text": "ほんだらEpisode2から\n見始めよった人の為に\nもう１回説明するかね。"},
        { "location": "324/Talk", "narrator": "ガブリエラ", "text": "そんなひと\nいないわよ。"},
        { "location": "325/Talk", "narrator": "アーヤ", "text": "推理小説を２巻から\n読むようなものだものね。"},
        { "location": "326/Talk", "narrator": "ガブリエラ", "text": "それならマンガの方が\n分かりやすくない？"},
        { "location": "327/Talk", "narrator": "つばめ", "text": "ああっ！\nそろそろ始まりますよ！"},
        { "location": "328/Talk", "narrator": "みやび", "text": "なんやかんやで\n間が持ったね。"},
        { "location": "329/Talk", "narrator": "ガブリエラ", "text": "いよいよ戦闘開始ね。\nあたしたちの活躍を\n見せてあげ──"},
        { "location": "330/Talk", "narrator": "つばめ", "text": "きゃーっ！\nメノウちゃーんっ！！"},
        { "location": "331/Talk", "narrator": "ガブリエラ", "text": "ちょっと、新人！\n割り込まないでよっ！"},
        { "location": "332/Talk", "narrator": "つばめ", "text": "だってメノウちゃんが\nメノウちゃんが\nメノウちゃんがっ！"},
        { "location": "333/Talk", "narrator": "ガブリエラ", "text": "わかったから黙って！"},
        { "location": "334/Talk", "narrator": "アーヤ", "text": "逢瀬さん、この時、\nあなたに一体何が\n起こってたの？"},
        { "location": "335/Talk", "narrator": "つばめ", "text": "実は、この時のことは\nよく憶えていなくて。"},
        { "location": "336/Talk", "narrator": "つばめ", "text": "突然すっごい目眩が\n襲ってきて……。"},
        { "location": "337/Talk", "narrator": "つばめ", "text": "気づいたら世界が\n変わってたって\n感じで……。"},
        { "location": "338/Talk", "narrator": "ガブリエラ", "text": "！？\n背後から誰かに\n撃たれたの？"},
        { "location": "339/Talk", "narrator": "みやび", "text": "それってガブちゃんや\nなかったん？"},
        { "location": "340/Talk", "narrator": "ガブリエラ", "text": "失礼ね！　あたしなら\n正面から堂々と\n新人を撃つわよ。"},
        { "location": "341/Talk", "narrator": "つばめ", "text": "撃たないでーっ！！"},
        { "location": "342/Talk", "narrator": "つばめ", "text": "撃たれたみたいな\n衝撃が走ったって\nことですよ。多分。"},
        { "location": "343/Talk", "narrator": "みやび", "text": "まぁ、演出やね。"},
        { "location": "344/Talk", "narrator": "つばめ", "text": "そういえば、わたしが\nここで睨まれたのって\n何でなんだろ？"},
        { "location": "345/Talk", "narrator": "つばめ", "text": "みんなみたいに洗脳？\nみたいなのに\nかからなかったから？"},
        { "location": "346/Talk", "narrator": "みやび", "text": "そんなところかねえ。\n発症者には\nすぐにわかるき。"},
        { "location": "347/Talk", "narrator": "みやび", "text": "そう、うちらみたいな\n「異物」はね。"},
        { "location": "348/Talk", "narrator": "アーヤ", "text": "ちなみに周辺一帯は\n完全に封鎖されていて\n人の往来は無いわ。"},
        { "location": "349/Talk", "narrator": "みやび", "text": "毎度迅速な対応、\n現場の皆さん\nご苦労様々やね。"},
        { "location": "350/Talk", "narrator": "つばめ", "text": "あぁーっ！\nみんなでこんな賭けを\nしてたんですか！？"},
        { "location": "351/Talk", "narrator": "つばめ", "text": "わたしだけ\nのけものにして、\nずるーい！"},
        { "location": "352/Talk", "narrator": "ガブリエラ", "text": "そんなこと言われても\nあんたはまだこっちに\nいなかったし。"},
        { "location": "353/Talk", "narrator": "アーヤ", "text": "私は賭けに乗らないで\n注意してるでしょ？"},
        { "location": "354/Talk", "narrator": "アーヤ", "text": "これは通常攻撃隊ね。\nいつも私たちを支えて\nくれる味方よ。"},
        { "location": "355/Talk", "narrator": "アーヤ", "text": "彼らがいるからこそ\n私たちは任務を円滑に\n遂行できるんだから。"},
        { "location": "356/Talk", "narrator": "つばめ", "text": "はぁ～。縁の下の\n力こぶさんですね！"},
        { "location": "357/Talk", "narrator": "アーヤ", "text": "……つっこんだ方が\nいいのかしら？"},
        { "location": "358/Talk", "narrator": "ガブリエラ", "text": "いよいよあたしたち\n「特別」攻撃隊の\n出番よ！　「特別」！"},
        { "location": "359/Talk", "narrator": "みやび", "text": "そない強調せんでも。"},
        { "location": "360/Talk", "narrator": "つばめ", "text": "あれれっ？\n通常攻撃隊の皆さん、\n何か変ですよね？"},
        { "location": "361/Talk", "narrator": "つばめ", "text": "何でアーヤさんたちに\n背を向けて\n整列してるんだろ？"},
        { "location": "362/Talk", "narrator": "みやび", "text": "ほほぅ。\nそこに気づくとは。"},
        { "location": "363/Talk", "narrator": "アーヤ", "text": "原則として私たちは\n顔バレしたら\nいけないのよ。"},
        { "location": "364/Talk", "narrator": "アーヤ", "text": "それが関係者相手でも\n可能な限り、ね。"},
        { "location": "365/Talk", "narrator": "つばめ", "text": "トップシークレット\nってことですか！？"},
        { "location": "366/Talk", "narrator": "みやび", "text": "そう。\n機密隠蔽の為に\n皆、色々しちょるんよ？"},
        { "location": "367/Talk", "narrator": "みやび", "text": "管理庁が面白すぎる\nねつ造サイトを\n作ってるくらいやき。"},
        { "location": "368/Talk", "narrator": "みやび", "text": "まぁ、そのうちなー。\nうちは毎日見ちょるき\n結構面白いで。"},
        { "location": "369/Talk", "narrator": "みやび", "text": "特にうちらの正体に\nついての記事なんて、\nかなり笑えるき。"},
        { "location": "370/Talk", "narrator": "みやび", "text": "某有名アイドルの\n裏の姿だとか、\n実はオッサンやとか。"},
        { "location": "371/Talk", "narrator": "みやび", "text": "そんな記事を管理庁が\n至極真面目に作っとる\nっちゅーのが一番笑える。"},
        { "location": "372/Talk", "narrator": "アーヤ", "text": "こら、みやび。\nそんな風に\n言うもんじゃないわ。"},
        { "location": "373/Talk", "narrator": "ガブリエラ", "text": "ていうか、あれって\n絶対に面白がって\n作ってる気がする。"},
        { "location": "374/Talk", "narrator": "アーヤ", "text": "あああっ！！\nちょっと待って！\nここで止めてっ！"},
        { "location": "375/Talk", "narrator": "アーヤ", "text": "て言うか、\nここでおしまいっ！\n解散っ！！"},
        { "location": "376/Talk", "narrator": "ガブリエラ", "text": "ちょっとアーヤ\n勝手に止めないでよ。"},
        { "location": "377/Talk", "narrator": "アーヤ", "text": "こ、心の準備がっ！"},
        { "location": "378/Talk", "narrator": "みやび", "text": "ふむ、ここは\n$handle$先生の\n出番やね。"},
        { "location": "379/Talk", "narrator": "ガブリエラ", "text": "さぁ、アーヤの\n魅惑的な太もも\n鑑賞会よ！"},
        { "location": "380/Talk", "narrator": "アーヤ", "text": "いやぁーっ！！"},
        { "location": "381/Talk", "narrator": "つばめ", "text": "でも起動しても\nまだ制服のまま\nなんですね。"},
        { "location": "382/Talk", "narrator": "みやび", "text": "空気を読まない冷静な\nつっこみやね。まぁ、\n勿体つけるのは基本。"},
        { "location": "383/Talk", "narrator": "アーヤ", "text": "そこは\n気にすることじゃ\nないわよ……。"},
        { "location": "384/Talk", "narrator": "つばめ", "text": "あっ、ここから\nわたしピンチです！"},
        { "location": "385/Talk", "narrator": "つばめ", "text": "こんな風に出口を\nふさがれちゃって、\nパニクっちゃって。"},
        { "location": "386/Talk", "narrator": "つばめ", "text": "逃げなくちゃって、\nメノウちゃんの方に\n走ったんだけど……。"},
        { "location": "387/Talk", "narrator": "ガブリエラ", "text": "走ったって言うか、\nよじ登ってるし。"},
        { "location": "388/Talk", "narrator": "つばめ", "text": "そこは何て言うか、\n今、冷静に考えると\n罠だったのかな？"},
        { "location": "389/Talk", "narrator": "ガブリエラ", "text": "冷静に考えなくても\n普通に罠でしょ。"},
        { "location": "390/Talk", "narrator": "みやび", "text": "まんまと不利な状況に\n追い込まれてたゆう\nわけやねぇ。"},
        { "location": "391/Talk", "narrator": "つばめ", "text": "ううっ、\nごめんなさぁい……。"},
        { "location": "392/Talk", "narrator": "アーヤ", "text": "そんなに気にすること\nないわよ。\n逢瀬さん。"},
        { "location": "393/Talk", "narrator": "アーヤ", "text": "フェノメノンに\n遭遇したのも\n初めてなんだもの。"},
        { "location": "394/Talk", "narrator": "みやび", "text": "おおーっ、\nホラーな引きやね。"},
        { "location": "395/Talk", "narrator": "ガブリエラ", "text": "つばめの運命や\n如何に！？"},
        { "location": "396/Talk", "narrator": "ガブリエラ", "text": "って感じで次回に\n引っ張っちゃうわけ？\n勿体ぶるわね。"},
        { "location": "397/Talk", "narrator": "つばめ", "text": "そんなぁ……。\nわたし、すっごく\n怖かったですよ……。"},
        { "location": "398/Talk", "narrator": "アーヤ", "text": "私たちがついてるから\n怖くないわよ。\n安心して。つばめ。"},
        { "location": "399/Talk", "narrator": "つばめ", "text": "アーヤさん……。"},
        { "location": "400/Talk", "narrator": "アーヤ", "text": "ちょっと待って。\n今、つばめを\nなぐさめて……。"},
        { "location": "401/Talk", "narrator": "アーヤ", "text": "いえ、これは\nリーダーとしての\n務めで。"},
        { "location": "402/Talk", "narrator": "アーヤ", "text": "わかったわよ。\nもう……。"}
    ]
}
