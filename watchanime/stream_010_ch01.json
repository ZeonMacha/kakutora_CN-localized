{
    "dir": "stream_010_ch01.json",
    "type": "watchanime",
    "info": {
    },
    "entry":
    [
        { "location": "1/Talk"  , "narrator": "つばめ", "text": "あれって？"},
        { "location": "2/Talk"  , "narrator": "つばめ", "text": "なーんだ。"},
        { "location": "3/Talk"  , "narrator": "みやび", "text": "適当なことを言った\n罪は重いぞね。"},
        { "location": "4/Talk"  , "narrator": "アーヤ", "text": "こらこら。\n脅かさないの。"},
        { "location": "5/Talk"  , "narrator": "つばめ", "text": "そういうものなんだ。"},
        { "location": "6/Talk"  , "narrator": "ガブリエラ", "text": "いやいや、\nそれボケてるのよ。\nちゃんと受けて！"},
        { "location": "7/Talk"  , "narrator": "つばめ", "text": "え？\nどういうことですか？"},
        { "location": "8/Talk"  , "narrator": "みやび", "text": "人には向き不向きが\nあろう。"},
        { "location": "9/Talk"  , "narrator": "ガブリエラ", "text": "そうね。\n新人には無理な相談\nだったわね。"},
        { "location": "10/Talk" , "narrator": "つばめ", "text": "えー……。"},
        { "location": "11/Talk" , "narrator": "つばめ", "text": "やっぱり\nわからないよね。"},
        { "location": "12/Talk" , "narrator": "みやび", "text": "ううむ……。\n意外と使えんやつめ。"},
        { "location": "13/Talk" , "narrator": "つばめ", "text": "みやびさんは\n何だと思いますか？"},
        { "location": "14/Talk" , "narrator": "みやび", "text": "うちの見解を話すのは\nやぶさかではない。"},
        { "location": "15/Talk" , "narrator": "みやび", "text": "しかし見解を\n話すことにより\nこの世界は……。"},
        { "location": "16/Talk" , "narrator": "つばめ", "text": "何が\n起こるんですか！？"},
        { "location": "17/Talk" , "narrator": "みやび", "text": "通常運行ぞね。"},
        { "location": "18/Talk" , "narrator": "つばめ", "text": "えーー！？"},
        { "location": "19/Talk" , "narrator": "アーヤ", "text": "あんまり\nからかわないの。"},
        { "location": "20/Talk" , "narrator": "ガブリエラ", "text": "ってことは違うのね。"},
        { "location": "21/Talk" , "narrator": "ガブリエラ", "text": "じゃあ$handle$も\n２０１６年にいるのね。"},
        { "location": "22/Talk" , "narrator": "みやび", "text": "なかなかＳＦチックな\n発想やねえ。"},
        { "location": "23/Talk" , "narrator": "みやび", "text": "そういうの\n嫌いじゃないけんど。"},
        { "location": "24/Talk" , "narrator": "ガブリエラ", "text": "そういうわけじゃ\nないのね。"},
        { "location": "25/Talk" , "narrator": "アーヤ", "text": "時空を超えた人との会話。"},
        { "location": "26/Talk" , "narrator": "アーヤ", "text": "話としては面白いけど\nまあ、さすがにそんな\nことは無かったか。"},
        { "location": "27/Talk" , "narrator": "みやび", "text": "まほさんがズボラやき\n切らせちょったぞね。"},
        { "location": "28/Talk" , "narrator": "みやび", "text": "まほさんのズボラは\n聞きたくないっちゅう\n反応やね。"},
        { "location": "29/Talk" , "narrator": "つばめ", "text": "あれ？　なんだか\nイマイチな\n反応だね……。"},
        { "location": "30/Talk" , "narrator": "ガブリエラ", "text": "普通はそうよ。"},
        { "location": "31/Talk" , "narrator": "つばめ", "text": "普通だったら\nキャー！　って\nなると思うよ。"},
        { "location": "32/Talk" , "narrator": "ガブリエラ", "text": "なんでこんなに\n会話がかみあわないの\nかしら……。"},
        { "location": "33/Talk" , "narrator": "つばめ", "text": "そうだよね！"},
        { "location": "34/Talk" , "narrator": "ガブリエラ", "text": "わたしには\nわからないけど。"},
        { "location": "35/Talk" , "narrator": "つばめ", "text": "わかってくれる人が\nいるからいいですー！"},
        { "location": "36/Talk" , "narrator": "つばめ", "text": "ああっ！\nアーヤさん！"},
        { "location": "37/Talk" , "narrator": "つばめ", "text": "こ、これ以上は\n見せられないよ！"},
        { "location": "38/Talk" , "narrator": "ガブリエラ", "text": "な、なによ！\nあたしを追い出す気！？"},
        { "location": "39/Talk" , "narrator": "ガブリエラ", "text": "そんなことやって、\n後でどうなっても\n知らないんだから！"},
        { "location": "40/Talk" , "narrator": "みやび", "text": "ふむ。\n最後はうちか。"},
        { "location": "41/Talk" , "narrator": "みやび", "text": "まあ、うちは\nどうでもえいけんど。"},
        { "location": "42/Talk" , "narrator": "みやび", "text": "まあせっかくやし、\n様式美っちゅうもんを\n大事にしてみる。"},
        { "location": "43/Talk" , "narrator": "つばめ", "text": "こ、こんにちは！\n逢瀬つばめです！"},
        { "location": "44/Talk" , "narrator": "アーヤ", "text": "綾水です。"},
        { "location": "45/Talk" , "narrator": "つばめ", "text": "アーヤさん！\n今から見る映像って、\nどんなものなんですか？"},
        { "location": "46/Talk" , "narrator": "アーヤ", "text": "んー、そうね。\n簡単に言えば、私たちの\n行動記録…かな？"},
        { "location": "47/Talk" , "narrator": "つばめ", "text": "えっ…それって\nちょっとプライバシーの\n侵害なんじゃ…。"},
        { "location": "48/Talk" , "narrator": "アーヤ", "text": "大丈夫よ。\n見てるのは私たちと、\nあとは…"},
        { "location": "49/Talk" , "narrator": "みやび", "text": "うちらの相棒さん\nだけやきね。"},
        { "location": "50/Talk" , "narrator": "つばめ", "text": "あ、みやびさんも\n来てたんですね！"},
        { "location": "51/Talk" , "narrator": "みやび", "text": "当然や。こんな\n面白そうなイベントは\n外せんぞね。"},
        { "location": "52/Talk" , "narrator": "ガブリエラ", "text": "ちょっと、なあに？\nこのぶっ壊れたデータ\nみたいな音楽は。"},
        { "location": "53/Talk" , "narrator": "アーヤ", "text": "ギャヴィ遅いわよ。"},
        { "location": "54/Talk" , "narrator": "ガブリエラ", "text": "うるさいわね。\nいろいろあったのよ。"},
        { "location": "55/Talk" , "narrator": "ガブリエラ", "text": "っていうか、\n正直この集まりって\nどうかと思うのよ。"},
        { "location": "56/Talk" , "narrator": "つばめ", "text": "どうして？"},
        { "location": "57/Talk" , "narrator": "ガブリエラ", "text": "そもそもこの映像の\n出所はどこなのよ。"},
        { "location": "58/Talk" , "narrator": "みやび", "text": "まあ確かに、誰が\nいつ撮ったかわからん\n映像やきね。"},
        { "location": "59/Talk" , "narrator": "みやび", "text": "もしかすると、\nガブちゃんの秘密も\n赤裸々に……"},
        { "location": "60/Talk" , "narrator": "ガブリエラ", "text": "ちょ、ちょっと！\n冗談でも馬鹿なこと\n言わないでよ！"},
        { "location": "61/Talk" , "narrator": "ガブリエラ", "text": "そんなのが出てきたら\n一瞬で映像を撃ち抜いて\nやるんだから。"},
        { "location": "62/Talk" , "narrator": "みやび", "text": "なんてゆっちょる間に\n始まりそうやね。"},
        { "location": "63/Talk" , "narrator": "つばめ", "text": "えっ！？\nこれって、わたしんち！？"},
        { "location": "64/Talk" , "narrator": "ガブリエラ", "text": "へえ、新人の家って\nこんななんだ。"},
        { "location": "65/Talk" , "narrator": "つばめ", "text": "な、なんか\n恥ずかしいよ……。"},
        { "location": "66/Talk" , "narrator": "みやび", "text": "まあ、自分の家が\n晒されるんは、あれよ。"},
        { "location": "67/Talk" , "narrator": "みやび", "text": "公開処刑\nみたいなもんやしな。"},
        { "location": "68/Talk" , "narrator": "ガブリエラ", "text": "それにしても\n本当にメノウが\n好きなのね。"},
        { "location": "69/Talk" , "narrator": "つばめ", "text": "えへへ、まあね。"},
        { "location": "70/Talk" , "narrator": "アーヤ", "text": "お父さんに\n手紙を書くとはまめね。"},
        { "location": "71/Talk" , "narrator": "つばめ", "text": "そうですかね。"},
        { "location": "72/Talk" , "narrator": "つばめ", "text": "でもわたし、お父さんに\nいつも「もっと連絡しろ」\nって怒られるんですよ。"},
        { "location": "73/Talk" , "narrator": "ガブリエラ", "text": "あんたの家も\n大変ね……。"},
        { "location": "74/Talk" , "narrator": "つばめ", "text": "あ、ここ。\nここって何だろう？"},
        { "location": "75/Talk" , "narrator": "ガブリエラ", "text": "何これ？\nわからないわ？"},
        { "location": "76/Talk" , "narrator": "つばめ", "text": "$handle$さん\n知ってる？"},
        { "location": "77/Talk" , "narrator": "みやび", "text": "んー……\nLinux系OSなのかね？"},
        { "location": "78/Talk" , "narrator": "つばめ", "text": "ここからだよね、\n本題は。"},
        { "location": "79/Talk" , "narrator": "ガブリエラ", "text": "えっと……記録映像？"},
        { "location": "80/Talk" , "narrator": "ガブリエラ", "text": "なにこれ、\nアーヤなの？"},
        { "location": "81/Talk" , "narrator": "アーヤ", "text": "確かにちょっと\n私っぽく見えるけど。"},
        { "location": "82/Talk" , "narrator": "アーヤ", "text": "でも私、\n知らないわよ。"},
        { "location": "83/Talk" , "narrator": "みやび", "text": "よく見てみい。\nガジェット見ると\n２０３１となっとる。"},
        { "location": "84/Talk" , "narrator": "つばめ", "text": "今２０１６だから……\n１５年後？"},
        { "location": "85/Talk" , "narrator": "ガブリエラ", "text": "ねえ。ひょっとして\n$handle$は\n２０３１年の人なの？"},
        { "location": "86/Talk" , "narrator": "つばめ", "text": "あ、戻った。"},
        { "location": "87/Talk" , "narrator": "つばめ", "text": "ていうかなんで\nわたしの旅の間に\nこんな映像が？"},
        { "location": "88/Talk" , "narrator": "アーヤ", "text": "静岡からだと\n３時間くらいよね。"},
        { "location": "89/Talk" , "narrator": "アーヤ", "text": "疲れなかった？"},
        { "location": "90/Talk" , "narrator": "つばめ", "text": "えっと……\n思ったより大変でした。"},
        { "location": "91/Talk" , "narrator": "つばめ", "text": "ああここ！"},
        { "location": "92/Talk" , "narrator": "つばめ", "text": "この時わたし、\n超絶望したんだった！"},
        { "location": "93/Talk" , "narrator": "ガブリエラ", "text": "アラート出た時よね。"},
        { "location": "94/Talk" , "narrator": "ガブリエラ", "text": "へえ。管理庁、\n仕事早いわね。"},
        { "location": "95/Talk" , "narrator": "みやび", "text": "この時うちら\n何しとったっけ？"},
        { "location": "96/Talk" , "narrator": "ガブリエラ", "text": "洗剤を買いに\n行ってたわ。\nまほに頼まれて。"},
        { "location": "97/Talk" , "narrator": "みやび", "text": "そうやった、\nあれ重かったなあ。"},
        { "location": "98/Talk" , "narrator": "つばめ", "text": "そっか。他の電車も\n全部止まってたんだね。"},
        { "location": "99/Talk" , "narrator": "みやび", "text": "電車だけじゃないで。"},
        { "location": "100/Talk", "narrator": "アーヤ", "text": "そうね。"},
        { "location": "101/Talk", "narrator": "アーヤ", "text": "フェノメノンが\n発生すれば全ての\n交通機関を止める。"},
        { "location": "102/Talk", "narrator": "アーヤ", "text": "情報管理庁には\nその権限があるの。"},
        { "location": "103/Talk", "narrator": "ガブリエラ", "text": "あ、まほ！"},
        { "location": "104/Talk", "narrator": "みやび", "text": "おー。\n珍しく真面目に\n仕事しちゅう。"},
        { "location": "105/Talk", "narrator": "つばめ", "text": "真幌さん\nカッコイイですねー。"},
        { "location": "106/Talk", "narrator": "みやび", "text": "確かに。"},
        { "location": "107/Talk", "narrator": "みやび", "text": "人生の９割を占める\n普段の昼寝タイムとは\n別人やね。"},
        { "location": "108/Talk", "narrator": "つばめ", "text": "きゃー\nメノウちゃーーん！！"},
        { "location": "109/Talk", "narrator": "ガブリエラ", "text": "は？\nメノウの何がいいわけ？"},
        { "location": "110/Talk", "narrator": "つばめ", "text": "何って全部だよ。\n歌とか世界とか、\nあとかわいい！"},
        { "location": "111/Talk", "narrator": "つばめ", "text": "$handle$さんも\nそう思うよね？"},
        { "location": "112/Talk", "narrator": "つばめ", "text": "ああっ、メノウちゃん、\n超かわいい～～～っ！！"},
        { "location": "113/Talk", "narrator": "つばめ", "text": "と、とにかく！\nメノウちゃんはわたしの\n命の恩人なんです。"},
        { "location": "114/Talk", "narrator": "アーヤ", "text": "そういえば\nよくドームまで\nたどり着けたわね。"},
        { "location": "115/Talk", "narrator": "ガブリエラ", "text": "あ、ストップして。"},
        { "location": "116/Talk", "narrator": "ガブリエラ", "text": "これ、\n発症ダイアログ\nじゃない。"},
        { "location": "117/Talk", "narrator": "つばめ", "text": "なんですかそれ？"},
        { "location": "118/Talk", "narrator": "ガブリエラ", "text": "フェノメノンが実際に\n顕在するときに\n出るものよ。"},
        { "location": "119/Talk", "narrator": "つばめ", "text": "この瞬間までは\n普通だったってこと？"},
        { "location": "120/Talk", "narrator": "ガブリエラ", "text": "そうね。"},
        { "location": "121/Talk", "narrator": "ガブリエラ", "text": "まだフェノメノンは\n出てなかったって\nことになるわ。"},
        { "location": "122/Talk", "narrator": "つばめ", "text": "てことは、"},
        { "location": "123/Talk", "narrator": "つばめ", "text": "ここでメノウちゃんが\nおかしく\nなったのは……。"},
        { "location": "124/Talk", "narrator": "みやび", "text": "ここで音羽が\n発症したっちゅー\nことぞね。"},
        { "location": "125/Talk", "narrator": "つばめ", "text": "そっか……。\nそれでお客さんが\nおかしかったんだ。"},
        { "location": "126/Talk", "narrator": "つばめ", "text": "怖かった……。"},
        { "location": "127/Talk", "narrator": "つばめ", "text": "この時、\n超ビックリ\nしたんだよー！"},
        { "location": "128/Talk", "narrator": "つばめ", "text": "それにまた\n頭痛出ちゃうし……。"},
        { "location": "129/Talk", "narrator": "アーヤ", "text": "また、って\n頭痛持ちなの？"},
        { "location": "130/Talk", "narrator": "つばめ", "text": "あ、えと……\nその……。"},
        { "location": "131/Talk", "narrator": "つばめ", "text": "ちょっと大きな病気\nしてて……。"},
        { "location": "132/Talk", "narrator": "つばめ", "text": "でも、\nもう全然平気です！"},
        { "location": "133/Talk", "narrator": "つばめ", "text": "ああっ！！\nここで終わりに\nしましょう！！！"},
        { "location": "134/Talk", "narrator": "アーヤ", "text": "はい、ストップ！！\nおつかれさまでしたー。"},
        { "location": "135/Talk", "narrator": "アーヤ", "text": "とても面白かったわね。"},
        { "location": "136/Talk", "narrator": "アーヤ", "text": "……もう解散だから。"}
    ]
}
