{
    "dir": "stream_100_ch01.json",
    "type": "watchanime",
    "info": {
    },
    "entry":
    [
        { "location": "1628/Talk", "narrator": "みやび", "text": "ほほぅ？\nほんまに何でも？\nうちの手作りでも？"},
        { "location": "1629/Talk", "narrator": "つばめ", "text": "みやびさんって\nお料理できますよね？\nそう聞いてたような？"},
        { "location": "1630/Talk", "narrator": "みやび", "text": "確かにできる。\nでも「何でも」作れる\nとは言うちょらん。"},
        { "location": "1631/Talk", "narrator": "神楽", "text": "何でもは作れない。\n作れるものだけ。\nですね？"},
        { "location": "1632/Talk", "narrator": "アーヤ", "text": "何だかどこかで\n聞いたような\nセリフね。"},
        { "location": "1633/Talk", "narrator": "つばめ", "text": "……あの、結局、\nどっちなんですか？"},
        { "location": "1634/Talk", "narrator": "みやび", "text": "そうやねえ。今度\nつばめちゃんに\n作って来ちゃろうね。"},
        { "location": "1635/Talk", "narrator": "神楽", "text": "正に、その身をもって\n味わうがいい！\nってことですねっ。"},
        { "location": "1636/Talk", "narrator": "つばめ", "text": "わ、わぁ～……、\nうれしいなぁ～……。"},
        { "location": "1637/Talk", "narrator": "みやび", "text": "それ単に好き嫌いが\n激しい言うちょる\nだけやき。"},
        { "location": "1638/Talk", "narrator": "つばめ", "text": "好き嫌いばかり\n言ってたら\n大きくなれませんよ！"},
        { "location": "1639/Talk", "narrator": "みやび", "text": "ちなみに\nつばめちゃんは何が\n嫌いやの？"},
        { "location": "1640/Talk", "narrator": "つばめ", "text": "わたし、食べ物では\n特に苦手だったり\n嫌いな物は無いかな？"},
        { "location": "1641/Talk", "narrator": "みやび", "text": "ほほぅ、そのお陰で\n意外と立派な物を\n持っとるんやね。"},
        { "location": "1642/Talk", "narrator": "つばめ", "text": "ど、どこ見て言って\nるんですかっ！？"},
        { "location": "1643/Talk", "narrator": "神楽", "text": "……私も好き嫌い\n無くさなくちゃです……。"},
        { "location": "1644/Talk", "narrator": "つばめ", "text": "えっ？"},
        { "location": "1645/Talk", "narrator": "神楽", "text": "あっ、ううん、\n何でもないですよ？"},
        { "location": "1646/Talk", "narrator": "みやび", "text": "うんうん、男女問わず\n他人の下着がどんなもん\nかには興味あるきね。"},
        { "location": "1647/Talk", "narrator": "ガブリエラ", "text": "んなわけないでしょ！！\n女の子の下着に興味あるの\nなんて男の子だけよ。"},
        { "location": "1648/Talk", "narrator": "みやび", "text": "ほうか。ほんだら\nうちはおっぱいの付いた\n男の子やき。"},
        { "location": "1649/Talk", "narrator": "つばめ", "text": "……あの、それ普通に\n男の子ですよね？"},
        { "location": "1650/Talk", "narrator": "神楽", "text": "つばめさん甘いですよっ！\nその疑問には私がズバリ\nお答えしましょう！"},
        { "location": "1651/Talk", "narrator": "ガブリエラ", "text": "神楽は余計なこと\n言わないで\n黙ってて！"},
        { "location": "1652/Talk", "narrator": "みやび", "text": "その時は一言、\n「尊い」って\n言うたらええ。"},
        { "location": "1653/Talk", "narrator": "神楽", "text": "尊い……。"},
        { "location": "1654/Talk", "narrator": "ガブリエラ", "text": "あんたが言って\nどうするのよ……。"},
        { "location": "1655/Talk", "narrator": "つばめ", "text": "せんぱい、\n尊い……です……。"},
        { "location": "1656/Talk", "narrator": "ガブリエラ", "text": "やめなさいってば！\nあたしが可愛いのは\n当然だし？"},
        { "location": "1657/Talk", "narrator": "みやび", "text": "お、ガブちゃん、\nやっと調子が\n戻ってきたき？"},
        { "location": "1658/Talk", "narrator": "ガブリエラ", "text": "な、なんのこと\nかしら？　意味が\nわからないんだけど？"},
        { "location": "1659/Talk", "narrator": "アーヤ", "text": "もうギャヴィったら\n何を言い出すかと\n思えば……。"},
        { "location": "1660/Talk", "narrator": "アーヤ", "text": "と、ところで、\n私の浴衣どうだった？\n……変じゃなかった？"},
        { "location": "1661/Talk", "narrator": "アーヤ", "text": "よくわからなかったら\n次回はちゃんと\n見ておいてね。"},
        { "location": "1662/Talk", "narrator": "神楽", "text": "あっという間の\n一時間でしたね！"},
        { "location": "1663/Talk", "narrator": "神楽", "text": "あっ、ボケですから\nここはつっこむ所\nですよ？"},
        { "location": "1664/Talk", "narrator": "神楽", "text": "さぁさぁ、\nどこからでもかかって\n来てくださいっ！"},
        { "location": "1665/Talk", "narrator": "みやび", "text": "ロマンチック大作戦の\n発動でこれは次回が\n待ち切れんち。"},
        { "location": "1666/Talk", "narrator": "みやび", "text": "ラブコメ展開は不安？\n大丈夫や。\nうちに任せとき。"},
        { "location": "1667/Talk", "narrator": "みやび", "text": "ガブちゃんの\nいいシーン、\nバッチリ見せちゃるき。"},
        { "location": "1668/Talk", "narrator": "つばめ", "text": "わ、わたしも\n言い出しっぺですし\nがんばりますよっ！"},
        { "location": "1669/Talk", "narrator": "つばめ", "text": "い、いえ、わたしの\nロマンチックは\nべつにいいです。"},
        { "location": "1670/Talk", "narrator": "つばめ", "text": "そんなの、だって、\nは、恥ずかしいしっ！"},
        { "location": "1671/Talk", "narrator": "神楽", "text": "さぁ、それでは今回も\n頑張って\nいっちゃいますよっ。"},
        { "location": "1672/Talk", "narrator": "つばめ", "text": "でも今さらかもだけど\n何をがんばれば\nいいのかな？"},
        { "location": "1673/Talk", "narrator": "みやび", "text": "そんなん面白おかしい\nトークをすることに\n決まっちゅうろう。"},
        { "location": "1674/Talk", "narrator": "アーヤ", "text": "それも違うと思うけど。\n今回も暴走は程々にね。"},
        { "location": "1675/Talk", "narrator": "神楽", "text": "ところでみやびさん、\n検証はどうしますか？"},
        { "location": "1676/Talk", "narrator": "みやび", "text": "おっと、そのフリ、\n待っちょったぞね。\n検証は……。"},
        { "location": "1677/Talk", "narrator": "みやび", "text": "敢えて流す！！\n（ドヤァ！！）"},
        { "location": "1678/Talk", "narrator": "アーヤ", "text": "……何か悪い物でも\n食べたのかしら？"},
        { "location": "1679/Talk", "narrator": "みやび", "text": "子供かい！　って。\nそうでのうて、\n敢えてやき。敢えて。"},
        { "location": "1680/Talk", "narrator": "みやび", "text": "何や、うちに検証\nさせちょうない力が\n働いてるみたいやき。"},
        { "location": "1681/Talk", "narrator": "みやび", "text": "敢えてスルーして\n反応を見ちゃろうって\n作戦ぞね。"},
        { "location": "1682/Talk", "narrator": "神楽", "text": "それ、言っちゃったら\n意味無くないですか？"},
        { "location": "1683/Talk", "narrator": "みやび", "text": "いやあ、それも計算の内\nやきね……。"},
        { "location": "1684/Talk", "narrator": "つばめ", "text": "ところで、\nせんぱいはどこに？"},
        { "location": "1685/Talk", "narrator": "アーヤ", "text": "先に始めててって\n言って出て行ったわ。"},
        { "location": "1686/Talk", "narrator": "みやび", "text": "あれよ。\nいじられるのが嫌で\n逃げちゃったろう。"},
        { "location": "1687/Talk", "narrator": "神楽", "text": "そんなまるで私たちが\n意地悪するみたいじゃ\nないですかー。"},
        { "location": "1688/Talk", "narrator": "アーヤ", "text": "ある意味、正しい判断かも\n知れないけど……。"},
        { "location": "1689/Talk", "narrator": "つばめ", "text": "でもきっと、\nお腹がすいたら\n出てきますよね。"},
        { "location": "1690/Talk", "narrator": "みやび", "text": "ガブちゃんは野生動物か\n何かかね。"},
        { "location": "1691/Talk", "narrator": "つばめ", "text": "あっ、何かちょっと\nアライグマっぽいかも\n知れないですね。"},
        { "location": "1692/Talk", "narrator": "神楽", "text": "つばめさん、\nそれって害獣じゃ……。"},
        { "location": "1693/Talk", "narrator": "つばめ", "text": "ええっ！\nそうなのっ！？"},
        { "location": "1694/Talk", "narrator": "神楽", "text": "あっ、もう本編が\n始まってますよっ！\n集中、集中っ。"},
        { "location": "1695/Talk", "narrator": "みやび", "text": "そんでこれは前回\nいじられたすぐ後\nみたいやね。"},
        { "location": "1696/Talk", "narrator": "神楽", "text": "でも、つばめさんを\nからかったわけじゃ\nありませんからね？"},
        { "location": "1697/Talk", "narrator": "つばめ", "text": "それはわかってるけど\n何かちょっと悔しいと\nいうか何というか…。"},
        { "location": "1698/Talk", "narrator": "アーヤ", "text": "ところで二人のお弁当は\n自分で作ったの？"},
        { "location": "1699/Talk", "narrator": "つばめ", "text": "あっ、えっとこれは…\n卯月さんが作ってくれた\nもので……えへへ。"},
        { "location": "1700/Talk", "narrator": "みやび", "text": "なんと！　\n卯月が……"},
        { "location": "1701/Talk", "narrator": "神楽", "text": "とっても美味しそうで\nしょう？\nつばめさんの為に――"},
        { "location": "1702/Talk", "narrator": "みやび", "text": "つばめちゃん、\n身体大丈夫か？\n今ゾンビやったりせんか？"},
        { "location": "1703/Talk", "narrator": "つばめ", "text": "ええっ！？"},
        { "location": "1704/Talk", "narrator": "神楽", "text": "それは\nどういう意味ですかっ！"},
        { "location": "1705/Talk", "narrator": "みやび", "text": "言葉通りの\n意味やけんど――"},
        { "location": "1706/Talk", "narrator": "みやび", "text": "ところで君は\nお弁当に好き嫌い\nとかあるかいね？"},
        { "location": "1707/Talk", "narrator": "神楽", "text": "そんなことより、\nいよいよガブちゃんの\n登場ですよ♪"},
        { "location": "1708/Talk", "narrator": "みやび", "text": "またいらんモブまで\n来ちょるねえ。"},
        { "location": "1709/Talk", "narrator": "アーヤ", "text": "じゃあギャヴィと\n替わるわね。"},
        { "location": "1710/Talk", "narrator": "ガブリエラ", "text": "ちょっとっ！？\nいきなり\n連れ出さないでよっ！"},
        { "location": "1711/Talk", "narrator": "ガブリエラ", "text": "べつにまだ替わって\nくれなくても\nよ、よかったのに。"},
        { "location": "1712/Talk", "narrator": "みやび", "text": "おやおや～？\n何やガブちゃんの\n様子がおかしいねぇ？"},
        { "location": "1713/Talk", "narrator": "ガブリエラ", "text": "こ、ここ、これはっ、\nあたし、中等部だし、\nだからっ……。"},
        { "location": "1714/Talk", "narrator": "つばめ", "text": "あっ、わかるよ。\n先輩と話すのって\n緊張するもんね。"},
        { "location": "1715/Talk", "narrator": "ガブリエラ", "text": "そ、そう！\nそれよっ！！"},
        { "location": "1716/Talk", "narrator": "みやび", "text": "ガブちゃん、いつから\nそないしおらしい\nキャラになったん？"},
        { "location": "1717/Talk", "narrator": "ガブリエラ", "text": "だ、だから、ほら、\nちょっと通りかかった\nだけだってばっ！"},
        { "location": "1718/Talk", "narrator": "つばめ", "text": "あっ、せんぱいが\n逃げちゃった。"},
        { "location": "1719/Talk", "narrator": "ガブリエラ", "text": "に、逃げてないっ！\n急用を思い出した\nだけなんだからっ！"},
        { "location": "1720/Talk", "narrator": "ガブリエラ", "text": "じゃ、じゃあ、\nそういうことで、\n誤解しないでよっ！"},
        { "location": "1721/Talk", "narrator": "アーヤ", "text": "あら？　ギャヴィ、\nもう替わっていいの？"},
        { "location": "1722/Talk", "narrator": "みやび", "text": "まっこと逃げるように\n出ていきよったねぇ。"},
        { "location": "1723/Talk", "narrator": "みやび", "text": "まぁ、こんな\n気の抜けたシーン、\n見たくないろうねえ。"},
        { "location": "1724/Talk", "narrator": "神楽", "text": "腰が入ってませんね。\n腕だけだと力が効率\n良く伝わりません。"},
        { "location": "1725/Talk", "narrator": "アーヤ", "text": "ホウキの使い方を\nそんな冷静に\n考察しなくても……。"},
        { "location": "1726/Talk", "narrator": "神楽", "text": "はい、私、ホウキの\n使い方にはちょっと\nうるさいですからっ。"},
        { "location": "1727/Talk", "narrator": "つばめ", "text": "あっ、そう言えば\n卯月さんの武器、\nホウキだよね。"},
        { "location": "1728/Talk", "narrator": "つばめ", "text": "……ん？　あれって\nホウキと鎌、どっちが\n基本型なの？"},
        { "location": "1729/Talk", "narrator": "神楽", "text": "どっちがいいですか？\nつばめさんが決めて\nいいですよ？"},
        { "location": "1730/Talk", "narrator": "みやび", "text": "ちょい待ち！\nうちの怪しいシーンを\nスルーせんといて！"},
        { "location": "1731/Talk", "narrator": "アーヤ", "text": "自分で怪しいって\n言ってどうするのよ……。"},
        { "location": "1732/Talk", "narrator": "つばめ", "text": "ていうか、みやびさん\nいつも怪しいから\n気にならなくて。"},
        { "location": "1733/Talk", "narrator": "アーヤ", "text": "それよりここ、\n大事な話をしてる\nみたいだけど？"},
        { "location": "1734/Talk", "narrator": "つばめ", "text": "何だか探偵物の推理シーン\nみたいですね。"},
        { "location": "1735/Talk", "narrator": "神楽", "text": "犯人は私だっ！"},
        { "location": "1736/Talk", "narrator": "つばめ", "text": "スピード解決過ぎっ！"},
        { "location": "1737/Talk", "narrator": "アーヤ", "text": "あなたたち、ちょっと\nノリと思いつきで\n会話をし過ぎよ……。"},
        { "location": "1738/Talk", "narrator": "みやび", "text": "それより、ここ！\n面白サイトについて\nつっこんで。ほら。"},
        { "location": "1739/Talk", "narrator": "つばめ", "text": "あっ、わたしこれ結局\nまだ見てないです。\nスマホで見られます？"},
        { "location": "1740/Talk", "narrator": "みやび", "text": "んー、あまりに\nわざとらしゅう古臭く\n作っちょるからなぁ。"},
        { "location": "1741/Talk", "narrator": "つばめ", "text": "えっ？\nもしかして古すぎて\nスマホで見られないとか？"},
        { "location": "1742/Talk", "narrator": "みやび", "text": "普通ならダメやないん\nやけど、わざとダメに\n作っちょるかもなぁ。"},
        { "location": "1743/Talk", "narrator": "みやび", "text": "まっこと妙な所に\n無駄に高い技術で\n凝りまくっちょるきね。"},
        { "location": "1744/Talk", "narrator": "みやび", "text": "きっと日頃のストレス解消\nも兼ねちょるんよ。"},
        { "location": "1745/Talk", "narrator": "アーヤ", "text": "それはそれで\nどうなのかしら。"},
        { "location": "1746/Talk", "narrator": "アーヤ", "text": "……さて、そろそろ。"},
        { "location": "1747/Talk", "narrator": "みやび", "text": "お、ガブちゃん、\nお帰り～。"},
        { "location": "1748/Talk", "narrator": "ガブリエラ", "text": "な、何よ、用も無いのに\n呼ばないでよね。"},
        { "location": "1749/Talk", "narrator": "神楽", "text": "いえいえ、\nこれもお仕事ですよ？"},
        { "location": "1750/Talk", "narrator": "つばめ", "text": "でも、このサイト、\nここまでする必要が\nあるのかなぁ？"},
        { "location": "1751/Talk", "narrator": "ガブリエラ", "text": "当たり前でしょ。\n身バレした時のこと\n想像してみなさいよ。"},
        { "location": "1752/Talk", "narrator": "ガブリエラ", "text": "未成年を危険な任務に\n就かせてるなんてバレ\nたらマズいもんね。"},
        { "location": "1753/Talk", "narrator": "神楽", "text": "それもありますけど、\nもしフェノメノンが\n人為的なものだったら"},
        { "location": "1754/Talk", "narrator": "神楽", "text": "その首謀者たちから\n私たちが直接狙われる\n可能性もありますし。"},
        { "location": "1755/Talk", "narrator": "つばめ", "text": "はぇ～……。\n何か色々と大変\nなんですねぇ……。"},
        { "location": "1756/Talk", "narrator": "みやび", "text": "って、つばめちゃん、\n他人事やないぞね！"},
        { "location": "1757/Talk", "narrator": "神楽", "text": "ところで、私を\nお嫁さんにしたい人は\nいないんですか？"},
        { "location": "1758/Talk", "narrator": "つばめ", "text": "あっ！　わ、わたしも\nき、気になりますっ！"},
        { "location": "1759/Talk", "narrator": "みやび", "text": "まぁ、それはおいおい\n見てもらっとけば\nいいとして、"},
        { "location": "1760/Talk", "narrator": "みやび", "text": "ガブちゃん、\n恥ずかしい話がスルー\nできてよかったなぁ。"},
        { "location": "1761/Talk", "narrator": "ガブリエラ", "text": "べつにそんなつもり\n全然無かったし、\n大きなお世話ね！"},
        { "location": "1762/Talk", "narrator": "みやび", "text": "ロマンチック大作戦\nｉｎ七夕まつり。\n実況開始ぞね！"},
        { "location": "1763/Talk", "narrator": "つばめ", "text": "面倒臭がってたのに\nいきなりノリノリ\nですね、みやびさん。"},
        { "location": "1764/Talk", "narrator": "みやび", "text": "やるからには\n楽しんだ者勝ちやき。"},
        { "location": "1765/Talk", "narrator": "みやび", "text": "ほんでつばめちゃん、\nクラスの友だちは\n呼ばんかったん？"},
        { "location": "1766/Talk", "narrator": "つばめ", "text": "実は誘ったんですけど\n繭ちゃんはバイトが\n抜けられなくて、"},
        { "location": "1767/Talk", "narrator": "つばめ", "text": "雛ちゃんは鉄道番組を\nリアルタイムで\n観たいからパスって。"},
        { "location": "1768/Talk", "narrator": "ガブリエラ", "text": "それって女子高生的に\nどうなの……？"},
        { "location": "1769/Talk", "narrator": "みやび", "text": "ほい、ほんだらここで\nうちらの浴衣姿の感想\n言ってみよか？"},
        { "location": "1770/Talk", "narrator": "みやび", "text": "それにしてもこのモブ\nキザやわ～。腹黒いに\n決まっちょる。"},
        { "location": "1771/Talk", "narrator": "ガブリエラ", "text": "……何よ？　あたしに\nリアクションさせよう\nって企んでる？"},
        { "location": "1772/Talk", "narrator": "つばめ", "text": "せんぱい、\n顔が真っ赤っかで\n可愛いですね。"},
        { "location": "1773/Talk", "narrator": "ガブリエラ", "text": "う、うるさいっ！\nあんたの記憶を\n消すわよ！？"},
        { "location": "1774/Talk", "narrator": "つばめ", "text": "何でですかぁっ！？"},
        { "location": "1775/Talk", "narrator": "神楽", "text": "それでは皆さん、\n次回もお楽しみに♪"},
        { "location": "1776/Talk", "narrator": "ガブリエラ", "text": "ねぇ、もうこれ今回で\n終わりにしない？"},
        { "location": "1777/Talk", "narrator": "ガブリエラ", "text": "それは言い過ぎか。\nでもこの後二回くらい\nとばしてもいいわよ。"},
        { "location": "1778/Talk", "narrator": "ガブリエラ", "text": "き、貴重なポイントは\n温存しないとでしょ？\nね？　ね？"}
    ]
}
