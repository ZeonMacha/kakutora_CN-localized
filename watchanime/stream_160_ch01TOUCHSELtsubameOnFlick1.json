{
    "dir": "stream_160_ch01TOUCHSELtsubameOnFlick1.json",
    "type": "watchanime",
    "info": {
    },
    "entry":
    [
        { "location": "3081/Talk", "narrator": "つばめ", "text": "え、えーと……実は\n皆さんに残念な\nお知らせがあります。"},
        { "location": "3082/Talk", "narrator": "ガブリエラ", "text": "まぁ、何となく\n予想はつくから、早く\n言っちゃいなさいよ。"},
        { "location": "3083/Talk", "narrator": "みやび", "text": "何か最近このパターン\n多くない？\nマンネリは敵やぞ。"},
        { "location": "3084/Talk", "narrator": "アーヤ", "text": "とにかく\n聞きましょうか。\nつばめ？"},
        { "location": "3085/Talk", "narrator": "つばめ", "text": "あ、あの、卯月さんが\n今回のこれは\nお休みしたいって。"},
        { "location": "3086/Talk", "narrator": "ガブリエラ", "text": "何？\n前回はしゃぎ過ぎて\n疲れでもしたわけ？"},
        { "location": "3087/Talk", "narrator": "つばめ", "text": "そ、そうなのかな？\nわたしは全然何とも\nないけど……。"},
        { "location": "3088/Talk", "narrator": "みやび", "text": "まぁ、うちらは前回\n休んだようなもんやき\nあんま言えんし。"},
        { "location": "3089/Talk", "narrator": "ガブリエラ", "text": "何ならつばめも\n今回は卯月と一緒に\n休んでてもいいけど？"},
        { "location": "3090/Talk", "narrator": "つばめ", "text": "わたしはこうなったら\n卯月さんの分も\nがんばりますからっ！"},
        { "location": "3091/Talk", "narrator": "みやび", "text": "ここはつばめちゃんが\n一肌脱ぐっちゅう\nわけやね。"},
        { "location": "3092/Talk", "narrator": "ガブリエラ", "text": "じゃあ、あたしたちは\n今回もつばめに任せて\n楽しようかしら。"},
        { "location": "3093/Talk", "narrator": "つばめ", "text": "それは全国２０７人の\nガブちゃんファンが\n可哀相かなぁ。"},
        { "location": "3094/Talk", "narrator": "ガブリエラ", "text": "ちょっと！　あたしの\nファン、妙にリアルに\n少なすぎないっ！？"},
        { "location": "3095/Talk", "narrator": "アーヤ", "text": "とにかくこうなったら\n今回は私たち４人で\n盛り上げましょう。"},
        { "location": "3096/Talk", "narrator": "みやび", "text": "まぁ、滑った時は\nつばめちゃんが脱いで\nくれる言うてるし。"},
        { "location": "3097/Talk", "narrator": "つばめ", "text": "……何の話かな？"},
        { "location": "3098/Talk", "narrator": "アーヤ", "text": "さて、いきなりだけど\nフェノメノンの現場に\nいる状況みたいね。"},
        { "location": "3099/Talk", "narrator": "ガブリエラ", "text": "つばめと神楽は\n秋葉原から電車で\n直行したんでしょ？"},
        { "location": "3100/Talk", "narrator": "つばめ", "text": "あー……はい……、\n卯月さんが乗り継ぎに\n詳しかったので……。"},
        { "location": "3101/Talk", "narrator": "アーヤ", "text": "交通費の請求は\n後できちんと館長に\n出しておくのよ？"},
        { "location": "3102/Talk", "narrator": "ガブリエラ", "text": "忘れがちだけど、\nあたしら国家公務員\nだからね。"},
        { "location": "3103/Talk", "narrator": "みやび", "text": "まぁ、それは\n置いといて、いよいよ\nゲームスタートやよ。"},
        { "location": "3104/Talk", "narrator": "ガブリエラ", "text": "ていうか、ゲームって\n聞いてたから、もっと\n凄いのかと思ってた。"},
        { "location": "3105/Talk", "narrator": "つばめ", "text": "すごろく？\nみたいですよね？"},
        { "location": "3106/Talk", "narrator": "みやび", "text": "アマチュアが頑張って\n作ったんやき、そこは\n生温い目で見たって。"},
        { "location": "3107/Talk", "narrator": "ガブリエラ", "text": "発症者の才能というか\n想像力の問題\nなんでしょ。"},
        { "location": "3108/Talk", "narrator": "みやび", "text": "ガブちゃん\n辛辣やわー。\n心折りに来てるわー。"},
        { "location": "3109/Talk", "narrator": "ガブリエラ", "text": "さっきから何で\n発症者に肩入れ\nしてるのよ……。"},
        { "location": "3110/Talk", "narrator": "つばめ", "text": "ところで、意外にも\nみやびさんはゲームに\n参加しないんですね。"},
        { "location": "3111/Talk", "narrator": "ガブリエラ", "text": "確かに、こういうの\n好きそうな感じ\nだもんね。"},
        { "location": "3112/Talk", "narrator": "みやび", "text": "それは勘違いぞね。\nこう見えてもうちは\nインドア派やき。"},
        { "location": "3113/Talk", "narrator": "アーヤ", "text": "つまり、体を動かす\nゲームにはそれほど\n興味が無いと。"},
        { "location": "3114/Talk", "narrator": "みやび", "text": "ちなみに\n画面の向こうの君は\nどっち派なん？"},
        { "location": "3115/Talk", "narrator": "ガブリエラ", "text": "何いきなり\n間の抜けた声を\n出してるのよ。"},
        { "location": "3116/Talk", "narrator": "つばめ", "text": "えっ？　ちょっと\n驚いただけなんだけど\nそんな変な声だった？"},
        { "location": "3117/Talk", "narrator": "アーヤ", "text": "べつに可愛いから\nいいんじゃないかしら。"},
        { "location": "3118/Talk", "narrator": "ガブリエラ", "text": "アーヤ……。"},
        { "location": "3119/Talk", "narrator": "ガブリエラ", "text": "て言うか何で\nこんな所で画面が\n止まってるわけ？"},
        { "location": "3120/Talk", "narrator": "つばめ", "text": "あっ！\nわかっちゃった！\nはいっ！"},
        { "location": "3121/Talk", "narrator": "アーヤ", "text": "何かしら、つばめ？"},
        { "location": "3122/Talk", "narrator": "つばめ", "text": "ガブちゃんの名前が\n何でＧａｂｒｉｅｌに\nなってるのかなって。"},
        { "location": "3123/Talk", "narrator": "みやび", "text": "それはきっと\nこのゲームの\n文字数制限やね。"},
        { "location": "3124/Talk", "narrator": "ガブリエラ", "text": "何それ失礼しちゃう！\nあたしに合わせて\n作りなさいよ！"},
        { "location": "3125/Talk", "narrator": "みやび", "text": "ガブちゃん自身が\n気づかんかったんやし\nええんと違うかな。"},
        { "location": "3126/Talk", "narrator": "ガブリエラ", "text": "それとこれとは\n話が別よ！"},
        { "location": "3127/Talk", "narrator": "アーヤ", "text": "じゃあそろそろ\n再開しましょうか。"},
        { "location": "3128/Talk", "narrator": "ガブリエラ", "text": "ねぇ、つばめ、\nこれ何でわざわざ\n神楽に声かけたの？"},
        { "location": "3129/Talk", "narrator": "つばめ", "text": "この時の卯月さんは\n何だか普段と違ってた\n気がして……。"},
        { "location": "3130/Talk", "narrator": "アーヤ", "text": "ええ、確かに、\n何か焦っている感じ\nではあったわね。"},
        { "location": "3131/Talk", "narrator": "みやび", "text": "ここでエンカウント！\n双六だけちゅう\nわけにはいかんきね。"},
        { "location": "3132/Talk", "narrator": "ガブリエラ", "text": "みやびはゲームの外\nだったから\n気楽でいいわよね。"},
        { "location": "3133/Talk", "narrator": "みやび", "text": "うちはうちでこれでも\n頑張ってたんやき、\nそこは堪忍や。"},
        { "location": "3134/Talk", "narrator": "つばめ", "text": "ふぇっ？　虎の子？\n……猛獣使い？"},
        { "location": "3135/Talk", "narrator": "アーヤ", "text": "つばめ、それは\nそのままの意味じゃ\nなくて……。"},
        { "location": "3136/Talk", "narrator": "みやび", "text": "ええよつばめちゃん。\n隙あらばボケる姿勢。\nそれでこそや。"},
        { "location": "3137/Talk", "narrator": "つばめ", "text": "ふえっ？　……よく\nわからないけど、\n褒められたのかな？"},
        { "location": "3138/Talk", "narrator": "ガブリエラ", "text": "……まぁ、\nそう思っておけば\nいいんじゃない？"},
        { "location": "3139/Talk", "narrator": "つばめ", "text": "あっ、今回は\nガブちゃんも\n大活躍だねっ。"},
        { "location": "3140/Talk", "narrator": "ガブリエラ", "text": "今回「も」でしょ！\n正しい日本語を\n使いなさいよ！"},
        { "location": "3141/Talk", "narrator": "つばめ", "text": "あぁっ！！\nそんなことより\n卯月さんがっ！！"},
        { "location": "3142/Talk", "narrator": "ガブリエラ", "text": "……まぁ、いいけど、\nこの時の神楽はホント\nおかしかったわよね。"},
        { "location": "3143/Talk", "narrator": "アーヤ", "text": "相手にルールを掌握\nされている状況での\n無茶は禁物ね。"},
        { "location": "3144/Talk", "narrator": "つばめ", "text": "これってみやびさんが\nさっきまほさんに\n頼んでたやつですか？"},
        { "location": "3145/Talk", "narrator": "みやび", "text": "そうや。迅速な配達\n御苦労様やき。\n感謝感謝や。"},
        { "location": "3146/Talk", "narrator": "ガブリエラ", "text": "ていうか何でわざわざ\n現場まで持って来させ\nてるわけ？"},
        { "location": "3147/Talk", "narrator": "ガブリエラ", "text": "スパコンくらい\nネット回線経由で\n使えるでしょ？"},
        { "location": "3148/Talk", "narrator": "みやび", "text": "フェノメノンの現場で\nセンサーと繋げんと\n意味無いんや。"},
        { "location": "3149/Talk", "narrator": "みやび", "text": "僅かな伝送損失や\n遅延、ノイズも\n命取りになるんやよ。"},
        { "location": "3150/Talk", "narrator": "つばめ", "text": "ていうか何でわたしが\n名指しなの！？"},
        { "location": "3151/Talk", "narrator": "ガブリエラ", "text": "あんたの日頃の\n行いなんじゃない？"},
        { "location": "3152/Talk", "narrator": "つばめ", "text": "そ、そう言われると\n心当たりがあるような\n気がしてきた……。"},
        { "location": "3153/Talk", "narrator": "みやび", "text": "あるんかい！\n（定例ツッコミ）"},
        { "location": "3154/Talk", "narrator": "アーヤ", "text": "特に意味は無いんじゃ\nないかしら？　単に\n呼びやすかったとか。"},
        { "location": "3155/Talk", "narrator": "つばめ", "text": "あぁっ！　卯月さん、\n一人で行っちゃ\nだめぇーっ！！"},
        { "location": "3156/Talk", "narrator": "アーヤ", "text": "時間制限にまんまと\n釣られてしまったと\nいうことかしら。"},
        { "location": "3157/Talk", "narrator": "つばめ", "text": "あの、そんな冷静に\n分析してる場合じゃ\nなくて……。"},
        { "location": "3158/Talk", "narrator": "ガブリエラ", "text": "って言っても、これ\n事象を客観視してる\nだけだし。"},
        { "location": "3159/Talk", "narrator": "みやび", "text": "ガブちゃん、それは\n裏設定好きが騒ぐから\n言うたらいかんち。"},
        { "location": "3160/Talk", "narrator": "アーヤ", "text": "映画館で観た作品を\n再度ビデオで見ている\nようなものなのかと。"},
        { "location": "3161/Talk", "narrator": "つばめ", "text": "わたし、何だか急に\nポテチと炭酸系が\n欲しくなりました！"},
        { "location": "3162/Talk", "narrator": "みやび", "text": "宅配ピザ頼むのも\n忘れんといてやー。"},
        { "location": "3163/Talk", "narrator": "ガブリエラ", "text": "そういうのは画面の\n向こうの誰かさんが\nやってるんじゃない？"},
        { "location": "3164/Talk", "narrator": "アーヤ", "text": "素人の作ったゲームは\nセキュリティが甘いと\n言うことかしら。"},
        { "location": "3165/Talk", "narrator": "ガブリエラ", "text": "甘いというか\nそんなの後回し\nなんじゃない？"},
        { "location": "3166/Talk", "narrator": "つばめ", "text": "ほえー、あの敵の\n手ってバラバラに\nなるんですねー。"},
        { "location": "3167/Talk", "narrator": "みやび", "text": "つばめちゃん、\nそのリアクションは\nＮＯ　ＧＯＯＤや。"},
        { "location": "3168/Talk", "narrator": "つばめ", "text": "ふぇっ！？"},
        { "location": "3169/Talk", "narrator": "ガブリエラ", "text": "こんなの\nただ「キモっ」で\nいいじゃない……。"},
        { "location": "3170/Talk", "narrator": "みやび", "text": "画面の向こうの君、\n正しいリアクション\n見せてやってや。"},
        { "location": "3171/Talk", "narrator": "つばめ", "text": "ひょわぁぁっ！？\nこれはわかります！\nさすがにキモいです！"},
        { "location": "3172/Talk", "narrator": "ガブリエラ", "text": "……何か今、見ては\nいけない物が流れてた\n気がするんだけど！？"},
        { "location": "3173/Talk", "narrator": "みやび", "text": "ゲーム廃人の\nマニアックな趣味的に\nスク水は外せんやき。"},
        { "location": "3174/Talk", "narrator": "ガブリエラ", "text": "何でみやびが\nそんなことに理解を\n示してるのよ……。"},
        { "location": "3175/Talk", "narrator": "つばめ", "text": "あれっ？\nあの衣装って\nどこかで……？"},
        { "location": "3176/Talk", "narrator": "つばめ", "text": "すとぉぉぉっぷっ！！\nここだめっ！\nこれ以上はだめっ！！"},
        { "location": "3177/Talk", "narrator": "つばめ", "text": "だめったら\nだめぇーっ！！"},
        { "location": "3178/Talk", "narrator": "アーヤ", "text": "それもいいんだけれど\n少しは健康的な生活も\n心懸けた方がいいわ。"},
        { "location": "3179/Talk", "narrator": "みやび", "text": "アーヤ、いきなり\nおかんモードやね。\n母性を感じるわ。"},
        { "location": "3180/Talk", "narrator": "アーヤ", "text": "や、やだ、そんな、\n褒めないでよ。\nてれるわ……。"},
        { "location": "3181/Talk", "narrator": "ガブリエラ", "text": "ていうか、それ\n褒めてることに\nなるんだ……。"},
        { "location": "3182/Talk", "narrator": "つばめ", "text": "さすがアーヤさん。\n母性も満々ですねっ！"},
        { "location": "3183/Talk", "narrator": "ガブリエラ", "text": "何それ、ちょっと\n具体的に説明して\nくれない？"},
        { "location": "3184/Talk", "narrator": "みやび", "text": "ガブちゃん、\nボケにマジレスは\n酷やよ。"},
        { "location": "3185/Talk", "narrator": "つばめ", "text": "つまり、\nカレー好きって\nことですね？"},
        { "location": "3186/Talk", "narrator": "アーヤ", "text": "もしくはインド風の\nエキゾチックな\n趣味とか？"},
        { "location": "3187/Talk", "narrator": "ガブリエラ", "text": "とりあえず、つばめも\nアーヤもフォローに\nなってないから。"},
        { "location": "3188/Talk", "narrator": "ガブリエラ", "text": "……どうやら\n図星だったみたいね。"},
        { "location": "3189/Talk", "narrator": "みやび", "text": "何一人で勝手なこと\nしちょるん？\nうちにもピザよこし！"},
        { "location": "3190/Talk", "narrator": "ガブリエラ", "text": "どうやって\n受け取るのよ？"},
        { "location": "3191/Talk", "narrator": "みやび", "text": "アップローダーの\nＵＲＬ教えるきに\nそこによろしゅう。"},
        { "location": "3192/Talk", "narrator": "アーヤ", "text": "……３Ｄプリンタで\n出力でもするつもり？"},
        { "location": "3193/Talk", "narrator": "みやび", "text": "正装＝全裸？"},
        { "location": "3194/Talk", "narrator": "ガブリエラ", "text": "こ、このヘンタイっ！\nヘンタイヘンタイっ！\nヘンタイィーーっ！！"},
        { "location": "3195/Talk", "narrator": "アーヤ", "text": "落ち着いてギャヴィ。\n勝手な憶測で人を\n罵倒してはダメよ。"},
        { "location": "3196/Talk", "narrator": "みやび", "text": "むしろ本当だった場合\n美少女の罵倒は\nただのご褒美やき。"},
        { "location": "3197/Talk", "narrator": "つばめ", "text": "よくわからないけど\n燃やしちゃった方が\nよくないですか？"},
        { "location": "3198/Talk", "narrator": "みやび", "text": "一番過激なんは\nつばめちゃんかい！"},
        { "location": "3199/Talk", "narrator": "つばめ", "text": "えぇーっ！？\nいきなり何を\n言い出すんですかっ！"},
        { "location": "3200/Talk", "narrator": "みやび", "text": "つばめちゃん、\n責めたらいかんよ。"},
        { "location": "3201/Talk", "narrator": "みやび", "text": "これぞ紳士の正しい\nリアクションぞね。"},
        { "location": "3202/Talk", "narrator": "つばめ", "text": "あの、どこらへんが\n紳士なのかさっぱり\nわかりませんけど。"},
        { "location": "3203/Talk", "narrator": "ガブリエラ", "text": "むしろそれは\n一生わからなくても\nいいことだから！"},
        { "location": "3204/Talk", "narrator": "みやび", "text": "ほほぅ……おぬし、\nうちの予想以上に\nできるようやな。"},
        { "location": "3205/Talk", "narrator": "つばめ", "text": "よくわかりませんけど\nわかっちゃいけない\n気がします。"},
        { "location": "3206/Talk", "narrator": "アーヤ", "text": "正しい判断よ。\nみやびはもう手遅れ\nだから仕方ないわ。"},
        { "location": "3207/Talk", "narrator": "みやび", "text": "うち、アーヤに\n見放されてもうた！"},
        { "location": "3208/Talk", "narrator": "ガブリエラ", "text": "えっ？\n……今さら？"},
        { "location": "3209/Talk", "narrator": "アーヤ", "text": "……念の為確認したい\nのだけれど、貰って\nどうするつもり？"},
        { "location": "3210/Talk", "narrator": "ガブリエラ", "text": "……ねぇ、知ってる？\n冗談にも限度が\nあるって？"},
        { "location": "3211/Talk", "narrator": "つばめ", "text": "えー？　わたしは\n可愛いのなら\n着てもいいけどなぁ。"},
        { "location": "3212/Talk", "narrator": "みやび", "text": "うちは、泣くほど\n土下座で頼まれたら\n考えるけどな。"},
        { "location": "3213/Talk", "narrator": "アーヤ", "text": "私も時と場合と衣装に\nよっては考えるわ。"},
        { "location": "3214/Talk", "narrator": "ガブリエラ", "text": "えぇっ！？\n……何かみんな\nコイツに甘くない？"},
        { "location": "3215/Talk", "narrator": "ガブリエラ", "text": "通報するから\nそこを動くな。"},
        { "location": "3216/Talk", "narrator": "みやび", "text": "ガブちゃん、待ち。\nうちが写真に撮って\nからにしたって。"},
        { "location": "3217/Talk", "narrator": "ガブリエラ", "text": "精神攻撃アイテムの\n素材にでも使う気？"},
        { "location": "3218/Talk", "narrator": "アーヤ", "text": "……意外と可愛いかも\n知れないわよ？"},
        { "location": "3219/Talk", "narrator": "ガブリエラ", "text": "……アーヤ？"},
        { "location": "3220/Talk", "narrator": "アーヤ", "text": "ご、ごめんなさい。\n忘れてちょうだい。"},
        { "location": "3221/Talk", "narrator": "ガブリエラ", "text": "へぇ？　意外ね。\nアンタこういうの\n好きかと思ってたわ。"},
        { "location": "3222/Talk", "narrator": "みやび", "text": "ガブちゃん油断したら\nいかんぞね。"},
        { "location": "3223/Talk", "narrator": "みやび", "text": "こだわりがあるが故に\n他人の趣味が気に\n入らないちうことやき。"},
        { "location": "3224/Talk", "narrator": "つばめ", "text": "もっともーっと\n悪趣味かも知れない\nってこと？"},
        { "location": "3225/Talk", "narrator": "ガブリエラ", "text": "うわっ、\n褒めて損した。\n近寄らないでっ。"},
        { "location": "3226/Talk", "narrator": "アーヤ", "text": "こらギャヴィ、\nいくらなんでも\n言い過ぎよ……。"},
        { "location": "3227/Talk", "narrator": "みやび", "text": "したら再生環境の\n不具合と違うん？"},
        { "location": "3228/Talk", "narrator": "ガブリエラ", "text": "不具合のタイミング、\n誰かさんにとって\n都合が良すぎない？"},
        { "location": "3229/Talk", "narrator": "アーヤ", "text": "でも何もやってないと\n言うのなら私たちも\n信じるしかないわね。"},
        { "location": "3230/Talk", "narrator": "ガブリエラ", "text": "さすがアーヤ、\n静かにプレッシャーを\nかけてるわ……。"},
        { "location": "3231/Talk", "narrator": "ガブリエラ", "text": "みんなじゃなくて、\nアンタ一人だけの\n想いだから……。"},
        { "location": "3232/Talk", "narrator": "みやび", "text": "想いの力でそないな\nことまで出来るよう\nなるとはさすがやね。"},
        { "location": "3233/Talk", "narrator": "アーヤ", "text": "念の為に\n言っておくけど、\n褒めてないわよ？"},
        { "location": "3234/Talk", "narrator": "つばめ", "text": "アーヤさん、\n地味にこわいですっ！"},
        { "location": "3235/Talk", "narrator": "みやび", "text": "ほほぅ？\n君は結婚するなら\n神楽がええんき？"},
        { "location": "3236/Talk", "narrator": "つばめ", "text": "だったらまずは\n卯月さんの気持ちが\n第一ですから！"},
        { "location": "3237/Talk", "narrator": "ガブリエラ", "text": "じゃあ卯月がＯＫなら\nつばめは認めるわけ？"},
        { "location": "3238/Talk", "narrator": "つばめ", "text": "えっ……そ、それは、\nその……何て言うか、\nわたしとしては……。"},
        { "location": "3239/Talk", "narrator": "みやび", "text": "つばめちゃん、\n墓穴掘ってもうたな。"},
        { "location": "3240/Talk", "narrator": "つばめ", "text": "も、もうっ！\nからかわないで\nくださいっ！"},
        { "location": "3241/Talk", "narrator": "ガブリエラ", "text": "じゃあ誰と\n結婚したいのよ！？"},
        { "location": "3242/Talk", "narrator": "アーヤ", "text": "ギャヴィ落ち着いて。\nそれ以上追及したら\n不味い気がするわ。"},
        { "location": "3243/Talk", "narrator": "みやび", "text": "せやで。そこで\nガブちゃん言われたら\nどうする気や？"},
        { "location": "3244/Talk", "narrator": "ガブリエラ", "text": "ど、どうするって\nどうもしないし！\n全然しないからっ！！"},
        { "location": "3245/Talk", "narrator": "つばめ", "text": "ふぇぇっ！？\n卯月さんのお父さん\nだったんですかっ！？"},
        { "location": "3246/Talk", "narrator": "アーヤ", "text": "つばめ、それは\nそういう意味じゃ\nないから……。"},
        { "location": "3247/Talk", "narrator": "ガブリエラ", "text": "でも言い方はともかく\n異議があるって点は\n褒めてあげるわ。"},
        { "location": "3248/Talk", "narrator": "みやび", "text": "まぁ、ついつい親心\n言うんが芽生える\n気持ちはわかる。"},
        { "location": "3249/Talk", "narrator": "ガブリエラ", "text": "みやびはさすがに\nどうかと思うけど。"},
        { "location": "3250/Talk", "narrator": "みやび", "text": "あー、ちょい待ち。\nうちから大事な\nお知らせがあるき。"},
        { "location": "3251/Talk", "narrator": "みやび", "text": "うち、次回のこれは\n休むきに\n勘弁したって。"},
        { "location": "3252/Talk", "narrator": "みやび", "text": "理由？　それは君の\n想像と妄想に\nおまかせするわ。"},
        { "location": "3253/Talk", "narrator": "ガブリエラ", "text": "うぅっ、何だか\n一刻も早く\nシャワー浴びたい！"},
        { "location": "3254/Talk", "narrator": "ガブリエラ", "text": "ホントああいう\nぬるぬる系だけは\n苦手なのよね。"},
        { "location": "3255/Talk", "narrator": "ガブリエラ", "text": "ていうか得意な\n女の子なんて\nいないでしょ？"},
        { "location": "3256/Talk", "narrator": "つばめ", "text": "卯月さん、こんな\nところで続きなんて\nつらいだろうな。"},
        { "location": "3257/Talk", "narrator": "つばめ", "text": "でも次回はわたしが\n絶対に卯月さんを\n助けるから！"},
        { "location": "3258/Talk", "narrator": "つばめ", "text": "どんなことがあっても\nわたしたち……。"},
        { "location": "3259/Talk", "narrator": "みやび", "text": "つばめちゃん堪忍な。"},
        { "location": "3260/Talk", "narrator": "みやび", "text": "せやけどうちらには\n感傷に浸ってる時間は\n無い。"},
        { "location": "3261/Talk", "narrator": "みやび", "text": "常に前進し続けて\n鑑賞するのみや。"},
        { "location": "3262/Talk", "narrator": "ガブリエラ", "text": "えっ？　もしかして\n上手いこと言った\nつもり？"},
        { "location": "3263/Talk", "narrator": "みやび", "text": "滑るのを気にせん\n勇気は大事やき。"},
        { "location": "3264/Talk", "narrator": "つばめ", "text": "みやびさん、\n少しは気にして\nくださいっ！"},
        { "location": "3265/Talk", "narrator": "アーヤ", "text": "ええ、これには私も\nつばめに同意ね。"},
        { "location": "3266/Talk", "narrator": "みやび", "text": "アーヤ最近\nうちへの態度が\nぞんざいと違う？"},
        { "location": "3267/Talk", "narrator": "みやび", "text": "うちかてアーヤから\n見たら妹系やき、\n可愛がってや。"},
        { "location": "3268/Talk", "narrator": "アーヤ", "text": "……考えておくわ。"},
        { "location": "3269/Talk", "narrator": "つばめ", "text": "って！　何ですぐ\n止まったのっ！？\n誰ですかっ！？"},
        { "location": "3270/Talk", "narrator": "ガブリエラ", "text": "誰って言われても\nあたしじゃないわよ？"},
        { "location": "3271/Talk", "narrator": "アーヤ", "text": "念の為に答えるけど\n私でもないわ。"},
        { "location": "3272/Talk", "narrator": "つばめ", "text": "となると、\nやっぱり……。"},
        { "location": "3273/Talk", "narrator": "みやび", "text": "うちも違うぞね！\n濡れ衣は勘弁や。"},
        { "location": "3274/Talk", "narrator": "つばめ", "text": "えっ……じゃあ、\nもしかして……、\n$handle$さん？"},
        { "location": "3275/Talk", "narrator": "みやび", "text": "なるほど。\nみんな行動ポイント\n０で動けんわけね。"},
        { "location": "3276/Talk", "narrator": "ガブリエラ", "text": "全く忌々しいったら\nなかったわよ。\nこんな変なルール。"},
        { "location": "3277/Talk", "narrator": "アーヤ", "text": "ここまでやっておいて\nわきまえてるなんて\nよく言えるわね。"},
        { "location": "3278/Talk", "narrator": "みやび", "text": "でも、あやうく発禁に\nなるとこだったぞね。\n世界の危機やった。"},
        { "location": "3279/Talk", "narrator": "つばめ", "text": "こういうのはスタイル\n抜群なみやびさんの\n役目じゃないですか？"},
        { "location": "3280/Talk", "narrator": "みやび", "text": "つばめちゃん、\nそれ褒めてるようで\n微妙に酷いで……。"},
        { "location": "3281/Talk", "narrator": "ガブリエラ", "text": "まさかみやび、\nこれを予想して後方に\nいたんじゃ……。"},
        { "location": "3282/Talk", "narrator": "みやび", "text": "それは濡れ衣や！\nうちならこれはこれで\n美味しい展開やき。"},
        { "location": "3283/Talk", "narrator": "アーヤ", "text": "さぁ、そんなことより\nいよいよこっちの\n反撃ターンよ！"},
        { "location": "3284/Talk", "narrator": "ガブリエラ", "text": "何でここで神楽のこと\nメノウって呼んだの？\nこっちも混乱したわ。"},
        { "location": "3285/Talk", "narrator": "つばめ", "text": "これは、その、本気で\nメノウちゃんだって\n思ってたんじゃなくて"},
        { "location": "3286/Talk", "narrator": "つばめ", "text": "ドームの時のことを\n急に思い出しちゃって\nつい……。"},
        { "location": "3287/Talk", "narrator": "アーヤ", "text": "あの時の光景が\nリフレインされた\nせいだったのね。"},
        { "location": "3288/Talk", "narrator": "つばめ", "text": "あの時メノウちゃんを\n助けられなかったから\n今度こそ助けたいって"},
        { "location": "3289/Talk", "narrator": "つばめ", "text": "卯月さんを同じ目に\n遭わせたくないって\n思ったからなのかも。"},
        { "location": "3290/Talk", "narrator": "ガブリエラ", "text": "なるほど、そういう\nことだったのね。\n勘違いしてたわ。"},
        { "location": "3291/Talk", "narrator": "みやび", "text": "うちもてっきり\nつばめちゃんの\n不思議パワーかと。"},
        { "location": "3292/Talk", "narrator": "みやび", "text": "つばめちゃん\n言い切りよった！\nここかっこいいわ。"},
        { "location": "3293/Talk", "narrator": "アーヤ", "text": "でも何か含みが\nありそうなセリフでは\nあったわね。"},
        { "location": "3294/Talk", "narrator": "ガブリエラ", "text": "つばめがそこまで\n考えて言ってるとは\nとても思えないけど。"},
        { "location": "3295/Talk", "narrator": "つばめ", "text": "わたしだってすっごく\nたまに少しは考えて\n言ってるもんっ！"},
        { "location": "3296/Talk", "narrator": "ガブリエラ", "text": "うわっ、ダメっ！\nキモ過ぎて\n鳥肌立った！"},
        { "location": "3297/Talk", "narrator": "みやび", "text": "ウナギやと思えば\n少しは我慢できるんと\n違う？"},
        { "location": "3298/Talk", "narrator": "ガブリエラ", "text": "どうしてそんなので\n我慢できるのよ！？"},
        { "location": "3299/Talk", "narrator": "ガブリエラ", "text": "ていうか、つばめ、\nファン失格って\n言われてるけど？"},
        { "location": "3300/Talk", "narrator": "つばめ", "text": "そう言われちゃっても\n仕方ないかも\n知れないけど……。"},
        { "location": "3301/Talk", "narrator": "ガブリエラ", "text": "みやび、それ、\nこんな最中に短時間で\n調べたわけ？"},
        { "location": "3302/Talk", "narrator": "みやび", "text": "この程度の個人情報\nうちにかかれば\n簡単過ぎぞね。"},
        { "location": "3303/Talk", "narrator": "つばめ", "text": "じゃあ何で今まで\n突き止めてなかったん\nですか？"},
        { "location": "3304/Talk", "narrator": "みやび", "text": "興味無い言うんは疑う\n以前に事象そのものが\n存在せんきに。"},
        { "location": "3305/Talk", "narrator": "つばめ", "text": "え、えーと……、\n何だかわかったような\nわからないような？"},
        { "location": "3306/Talk", "narrator": "アーヤ", "text": "あっ、一応館長の為に\n捕捉しておくけど、\nここ勘違いしないで。"},
        { "location": "3307/Talk", "narrator": "アーヤ", "text": "これって館長が卯月の\n正体を隠そうとして\nいるわけじゃないの。"},
        { "location": "3308/Talk", "narrator": "アーヤ", "text": "館長も卯月がメノウと\n同一人物だってことは\n知らなかったのよ。"},
        { "location": "3309/Talk", "narrator": "みやび", "text": "作戦に支障が出そうな\n会話をしてるなって\nことやったんやね。"},
        { "location": "3310/Talk", "narrator": "つばめ", "text": "えっ、わたしてっきり\n真幌さんが\n隠してたのかと。"},
        { "location": "3311/Talk", "narrator": "ガブリエラ", "text": "ていうか、それここで\nバラしちゃって\n大丈夫なわけ？"},
        { "location": "3312/Talk", "narrator": "アーヤ", "text": "ええ、館長が、絶対に\n悪人だと思われたって\n気にしてたから……。"},
        { "location": "3313/Talk", "narrator": "ガブリエラ", "text": "まほ……、意外と\nメンタル弱いわよね。"},
        { "location": "3314/Talk", "narrator": "つばめ", "text": "ま、真幌さん、\nごめんなさい……。"},
        { "location": "3315/Talk", "narrator": "アーヤ", "text": "とりあえず館長の\n疑惑が晴れて\nよかったわ。"},
        { "location": "3316/Talk", "narrator": "アーヤ", "text": "とは言っても\n楽観できる状況じゃ\nないわね。"},
        { "location": "3317/Talk", "narrator": "アーヤ", "text": "次回も私たち自身が\n暗くならないように\n気をつけないとね。"}
    ]
}
