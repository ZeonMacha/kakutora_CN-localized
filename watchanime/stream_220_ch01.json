{
    "dir": "stream_220_ch01.json",
    "type": "watchanime",
    "info": {
    },
    "entry":
    [
        { "location": "4351/Talk", "narrator": "みやび", "text": "よう見ちゅうね。\n少しだけ感心して\nもうたわ。"},
        { "location": "4352/Talk", "narrator": "みやび", "text": "それとも地味な服に\n着替えおってからに\nいう不満？"},
        { "location": "4353/Talk", "narrator": "みやび", "text": "あれは脱がされやすい\nきに、一応警戒して\n着替えたんよ。"},
        { "location": "4354/Talk", "narrator": "つばめ", "text": "さすがにそんなに\n何度もひん剥かないと\n思うけど……。"},
        { "location": "4355/Talk", "narrator": "つばめ", "text": "それはガブちゃんの\n寝相が悪いせいですよね。"},
        { "location": "4356/Talk", "narrator": "ガブリエラ", "text": "さりげなく断言するの\nやめてくれない？"},
        { "location": "4357/Talk", "narrator": "アーヤ", "text": "待って。ギャヴィが\n入って来てたの、私\n知らなかった……。"},
        { "location": "4358/Talk", "narrator": "ガブリエラ", "text": "だって朝には気づいて\n自分の布団に戻ってたし。"},
        { "location": "4359/Talk", "narrator": "アーヤ", "text": "勝手に戻らないでよ！"},
        { "location": "4360/Talk", "narrator": "ガブリエラ", "text": "えぇっ！？\nなんでっ！？"},
        { "location": "4361/Talk", "narrator": "神楽", "text": "それはただの\n気のせいですよ？"},
        { "location": "4362/Talk", "narrator": "神楽", "text": "気のせいだと\n認めないならゲームの\nデータを消しますよ？"},
        { "location": "4363/Talk", "narrator": "みやび", "text": "ほんま今日の卯月、\nやりたい放題やな！"},
        { "location": "4364/Talk", "narrator": "神楽", "text": "今すぐこのアプリを\n端末から消して欲しい\nようですね？"},
        { "location": "4365/Talk", "narrator": "みやび", "text": "それ、かなりシャレに\nなってないきに、\nあかんち！"},
        { "location": "4366/Talk", "narrator": "みやび", "text": "下手したら次回から\n卯月だけ存在を\n消されかねんよ？"},
        { "location": "4367/Talk", "narrator": "神楽", "text": "まぁ、消えるなら\nもろともですけど。"},
        { "location": "4368/Talk", "narrator": "ガブリエラ", "text": "あんた、こいつに\n胸のこと言われると\nキレるのね……。"},
        { "location": "4369/Talk", "narrator": "神楽", "text": "うふふっ♪\n怖がらなくても大丈夫\nですよ、つばめさん。"},
        { "location": "4370/Talk", "narrator": "神楽", "text": "なーんて、そろそろ\nこんな茶番やってる\n場合じゃないですね。"},
        { "location": "4371/Talk", "narrator": "神楽", "text": "だから、もう少しだけ\n私のことを見ていて\nくださいね……。"},
        { "location": "4372/Talk", "narrator": "ガブリエラ", "text": "……もう次回は\nつばめと神楽だけで\nいいんじゃない？"},
        { "location": "4373/Talk", "narrator": "ガブリエラ", "text": "まぁ、どうしても\nあたしに会いたいなら\n考えてもいいけど？"},
        { "location": "4374/Talk", "narrator": "ガブリエラ", "text": "ほら、だから早く\n言いなさいよ！\nほらぁっ！"},
        { "location": "4375/Talk", "narrator": "みやび", "text": "なんやわやくちゃに\nなってもうて\n堪忍な？"},
        { "location": "4376/Talk", "narrator": "みやび", "text": "でもわかるんよ。\nつらい時ちゅうんは\nおどけたくなるんは。"},
        { "location": "4377/Talk", "narrator": "みやび", "text": "うちは空気は読む\nええ女やき。\n覚えといてや～。"},
        { "location": "4378/Talk", "narrator": "アーヤ", "text": "交代したはいいけど\n再度出る機会を\n失ってしまったわ。"},
        { "location": "4379/Talk", "narrator": "アーヤ", "text": "ごめんなさいね。\nあの子たち好き勝手に\nやってたみたいで。"},
        { "location": "4380/Talk", "narrator": "アーヤ", "text": "次回は私がきっちり！\n……ううん、自然な\n流れに任せましょう。"},
        { "location": "4381/Talk", "narrator": "つばめ", "text": "……今回もまた\n神楽ちゃんは\n欠席なのかなぁ？"},
        { "location": "4382/Talk", "narrator": "ガブリエラ", "text": "来ないものは\n仕方ないでしょ？\n元気出しなさいよ。"},
        { "location": "4383/Talk", "narrator": "つばめ", "text": "……うん、ガブちゃん\n心配してくれて\nありがとう。"},
        { "location": "4384/Talk", "narrator": "ガブリエラ", "text": "心配とかじゃないし！\nあたしも調子狂うから\n言ってるだけだし！"},
        { "location": "4385/Talk", "narrator": "みやび", "text": "いきなりツンデレとは\nお約束過ぎてうちは\n感動しちょるぞね。"},
        { "location": "4386/Talk", "narrator": "アーヤ", "text": "でもお約束は大事ね。\n直球を極めてこその\n変化球ですもの。"},
        { "location": "4387/Talk", "narrator": "ガブリエラ", "text": "だからツンデレじゃ\nないって毎度毎度\n言ってるでしょ！"},
        { "location": "4388/Talk", "narrator": "みやび", "text": "ちゅうわけで、\n今回はうちのターンやき、\n仕切らせてもらうき。"},
        { "location": "4389/Talk", "narrator": "ガブリエラ", "text": "今回って、べつに\nみやびは目立った\n活躍してなくない？"},
        { "location": "4390/Talk", "narrator": "みやび", "text": "出番に関係無く仕切るんが\nうちの流儀やき。"},
        { "location": "4391/Talk", "narrator": "ガブリエラ", "text": "よくわかんないけど\n珍しくやる気あるなら\n好きにすれば。"},
        { "location": "4392/Talk", "narrator": "つばめ", "text": "アーヤさん、本当に\nいいんですか？"},
        { "location": "4393/Talk", "narrator": "アーヤ", "text": "いざとなったら全力で\n仕留め……いえ、\n止めるだけのことよ。"},
        { "location": "4394/Talk", "narrator": "みやび", "text": "不穏当な相談は\nうちの聞こえん所で\nやっといて！"},
        { "location": "4395/Talk", "narrator": "みやび", "text": "うちとしてはただ\n最近出番が少なかった\nことへのお詫びぞね。"},
        { "location": "4396/Talk", "narrator": "みやび", "text": "画面の向こうのキミ、\n寂しい思いさせて堪忍な。"},
        { "location": "4397/Talk", "narrator": "ガブリエラ", "text": "もしかしてこのみやびって\n偽者？"},
        { "location": "4398/Talk", "narrator": "アーヤ", "text": "ええ、私もそれを\n疑い始めていたところよ。"},
        { "location": "4399/Talk", "narrator": "つばめ", "text": "とりあえずギャグが\n滑るかどうかまで\n様子を見ましょう。"},
        { "location": "4400/Talk", "narrator": "みやび", "text": "あんたら、うちに何か\n恨みでもあるんかい？\n言いたい放題やな！"},
        { "location": "4401/Talk", "narrator": "みやび", "text": "けど、うちがこんな\nことでへこたれるとは\n思わんといてや。"},
        { "location": "4402/Talk", "narrator": "みやび", "text": "今日のうちはピカピカに\n輝くイイ女やき！"},
        { "location": "4403/Talk", "narrator": "ガブリエラ", "text": "……熱を計った方が\nいいんじゃない？"},
        { "location": "4404/Talk", "narrator": "みやび", "text": "真顔での心配、\n切ないほど嬉しいち。"},
        { "location": "4405/Talk", "narrator": "つばめ", "text": "あっ、\nもう始まってますよ。\n集中集中っ！"},
        { "location": "4406/Talk", "narrator": "ガブリエラ", "text": "そんなに日焼けしてる\nようには見えないんだ\nけど？"},
        { "location": "4407/Talk", "narrator": "みやび", "text": "うちの肌は特別に\nデリケートやき、\n紫外線に弱いんよ。"},
        { "location": "4408/Talk", "narrator": "つばめ", "text": "それってもしかして\n引きこも──"},
        { "location": "4409/Talk", "narrator": "アーヤ", "text": "つばめ、ストップ。\n引きこもりに\n引きこもりは禁句よ。"},
        { "location": "4410/Talk", "narrator": "みやび", "text": "言うてるから！\nむしろトドメ\n刺しちょうから！"},
        { "location": "4411/Talk", "narrator": "ガブリエラ", "text": "みやびは夜型というか\n夜行性だから、\nいつものことでしょ。"},
        { "location": "4412/Talk", "narrator": "みやび", "text": "ガブちゃん、うちも\n同じ学生ちゅうこと\n忘れてない？"},
        { "location": "4413/Talk", "narrator": "アーヤ", "text": "それって一ヶ月くらい\n前に私に教えてくれた\nことよね？"},
        { "location": "4414/Talk", "narrator": "みやび", "text": "やき、そこからずっと\n調べちょったけんど、"},
        { "location": "4415/Talk", "narrator": "みやび", "text": "ようやく実家にある\nスパコン不可思議ちゃんに\n触れたき――"},
        { "location": "4416/Talk", "narrator": "みやび", "text": "俄然モチベ上がって\n進行しちょっただけや。"},
        { "location": "4417/Talk", "narrator": "アーヤ", "text": "寝なくちゃいけない\nのに寝られない興奮、\nあるわよね。"},
        { "location": "4418/Talk", "narrator": "ガブリエラ", "text": "アーヤでもそんなこと\nあるの？　きっちりと\n毎日寝てそうだけど。"},
        { "location": "4419/Talk", "narrator": "アーヤ", "text": "私はべつに、そんなに\n完璧な人間じゃないわよ？"},
        { "location": "4420/Talk", "narrator": "つばめ", "text": "アーヤさんも寝坊する\nことがあるなんて\n親近感わきました。"},
        { "location": "4421/Talk", "narrator": "アーヤ", "text": "いえ、朝寝坊をしたことは\n無いのだけれど。"},
        { "location": "4422/Talk", "narrator": "つばめ", "text": "わたしの親近感が\n一瞬で粉みじんに！"},
        { "location": "4423/Talk", "narrator": "ガブリエラ", "text": "これって割と酷いこと\n言ってるわよね、つばめ。"},
        { "location": "4424/Talk", "narrator": "みやび", "text": "うちは気にせんき、\nええけんど。"},
        { "location": "4425/Talk", "narrator": "つばめ", "text": "あっ……神楽ちゃん、\n起きてたんだ……。"},
        { "location": "4426/Talk", "narrator": "ガブリエラ", "text": "つばめも不用心ね。\n本当に寝てるのか\n確認しときなさいよ。"},
        { "location": "4427/Talk", "narrator": "つばめ", "text": "確認……って、\nどうやってすれば\nよかったの？"},
        { "location": "4428/Talk", "narrator": "みやび", "text": "こちょこちょ～言うて\nくすぐってみたら\nええんと違う？"},
        { "location": "4429/Talk", "narrator": "つばめ", "text": "そんなことして\nもし起きてたら\nどうするんですか！？"},
        { "location": "4430/Talk", "narrator": "みやび", "text": "女の子同士なら犯罪に\nならんき大丈夫や。"},
        { "location": "4431/Talk", "narrator": "ガブリエラ", "text": "いや、なるってば。"},
        { "location": "4432/Talk", "narrator": "みやび", "text": "さよか？\nうちよくガブちゃんに\nいたずらしちょるよ？"},
        { "location": "4433/Talk", "narrator": "ガブリエラ", "text": "おまわりさん、\nこの女です！"},
        { "location": "4434/Talk", "narrator": "アーヤ", "text": "ご、ごめんなさい！\nつい出来心で……。"},
        { "location": "4435/Talk", "narrator": "ガブリエラ", "text": "なんでアーヤまで！？"},
        { "location": "4436/Talk", "narrator": "みやび", "text": "ちょい待つぞね！\nここ、うちがええこと\n言ってるところやき。"},
        { "location": "4437/Talk", "narrator": "ガブリエラ", "text": "確かに二度と\n見られないシーンかもね。"},
        { "location": "4438/Talk", "narrator": "みやび", "text": "せや。さすがにうちも\nここではボケ入れる\n隙が無かったきに。"},
        { "location": "4439/Talk", "narrator": "アーヤ", "text": "隙あらばボケようという\n意思はあったのね……。"},
        { "location": "4440/Talk", "narrator": "ガブリエラ", "text": "でもつばめが相手だと\nボケても気づかれ\nなかったかもよ？"},
        { "location": "4441/Talk", "narrator": "みやび", "text": "天然がボケ殺しなんは\n承知の上でのことやき。"},
        { "location": "4442/Talk", "narrator": "アーヤ", "text": "さすがはみやびね。\nプロフェッショナルの\n心意気を感じるわ。"},
        { "location": "4443/Talk", "narrator": "ガブリエラ", "text": "なんのプロフェッショナル\nなのよ……。"},
        { "location": "4444/Talk", "narrator": "神楽", "text": "あっ！　私がいない！\nどうしたんでしょう。\n事件の匂いがします！"},
        { "location": "4445/Talk", "narrator": "つばめ", "text": "えっ！？\nか、神楽ちゃんっ！？"},
        { "location": "4446/Talk", "narrator": "神楽", "text": "つばめさんは\nどうして私の居場所が\nすぐにわかるの！？"},
        { "location": "4447/Talk", "narrator": "つばめ", "text": "なんでって言われても\nえーと……勘かなぁ？"},
        { "location": "4448/Talk", "narrator": "神楽", "text": "さては私の体内に\nＧＰＳ発信器を\n仕込みましたね！？"},
        { "location": "4449/Talk", "narrator": "神楽", "text": "ひどいです！\n早速つばめさんの口づけで\n吸い出してください！"},
        { "location": "4450/Talk", "narrator": "つばめ", "text": "ふえぇぇっ！？"},
        { "location": "4451/Talk", "narrator": "神楽", "text": "さぁ、ちゅーっと。\n今すぐここで、\nちゅちゅー♪　っと！"},
        { "location": "4452/Talk", "narrator": "みやび", "text": "映像と生身の神楽の\nギャップが酷すぎて\n意味がわからんき。"},
        { "location": "4453/Talk", "narrator": "ガブリエラ", "text": "ていうか、さすがに\nそろそろ真面目に\n解説していかないと"},
        { "location": "4454/Talk", "narrator": "ガブリエラ", "text": "画面の向こうの\n誰かさんたちが\nキレるんじゃない？"},
        { "location": "4455/Talk", "narrator": "神楽", "text": "でもここで解説なんて\n始めたりしらきっと\nトラウマになって、"},
        { "location": "4456/Talk", "narrator": "神楽", "text": "運営さんが謝罪と賠償と\n慰謝料を要求されることに\nなってしまいますから――"},
        { "location": "4457/Talk", "narrator": "神楽", "text": "私はトライナリーの\n運営さんの味方です！"},
        { "location": "4458/Talk", "narrator": "ガブリエラ", "text": "ていうかさ、つばめに\nずっと言いたかったん\nだけど、"},
        { "location": "4459/Talk", "narrator": "つばめ", "text": "えっ？　ガブちゃん？\n……い、いきなり\n何かな？"},
        { "location": "4460/Talk", "narrator": "ガブリエラ", "text": "ここ最近の回でずっと\n神楽が唯一の友達とか\n他にいなかったとか"},
        { "location": "4461/Talk", "narrator": "ガブリエラ", "text": "言ってるけど、じゃあ\nあたしはどうなのよ？\nあたしは！？"},
        { "location": "4462/Talk", "narrator": "つばめ", "text": "ももももも、モチロン\nガブちゃんも\nと、友達だよぅ？"},
        { "location": "4463/Talk", "narrator": "神楽", "text": "じゃあ私に\n言ってくれたことは\n嘘だったんですね！？"},
        { "location": "4464/Talk", "narrator": "つばめ", "text": "えーと、だからそれも\n嘘じゃないけど、\nないんだけど……。"},
        { "location": "4465/Talk", "narrator": "みやび", "text": "なんやの、この\n泥沼三角関係みたいな\n流れは……。"},
        { "location": "4466/Talk", "narrator": "ガブリエラ", "text": "ハッキリしないのが\n嫌いなだけだから\n勘違いしないでよ！"},
        { "location": "4467/Talk", "narrator": "つばめ", "text": "ガブちゃんがそこまで\nこだわるのは、正直\n意外だったよ……。"},
        { "location": "4468/Talk", "narrator": "みやび", "text": "これわかるわー。\nとりあえず話してみて\n言うちょっても"},
        { "location": "4469/Talk", "narrator": "みやび", "text": "聞くだけ聞いて\n何もしないいうヤツなー。"},
        { "location": "4470/Talk", "narrator": "みやび", "text": "聞いたなら\n何かしてくれ！"},
        { "location": "4471/Talk", "narrator": "みやび", "text": "同情するなら\n金をくれ！"},
        { "location": "4472/Talk", "narrator": "みやび", "text": "正に、ほんこれ！！"},
        { "location": "4473/Talk", "narrator": "ガブリエラ", "text": "ちょっとみやび、\nそれは酷くない！？\nこれは愛よ、愛！"},
        { "location": "4474/Talk", "narrator": "ガブリエラ", "text": "一緒に悲しみを\n共有したりするのが\n友の愛じゃないの。"},
        { "location": "4475/Talk", "narrator": "ガブリエラ", "text": "そういうのみやびは\nわからないわけ？"},
        { "location": "4476/Talk", "narrator": "つばめ", "text": "あれ？　なんだか\n今回はガブちゃんが\n頼もしいよ？"},
        { "location": "4477/Talk", "narrator": "神楽", "text": "さては私のいない隙に\nつばめさんを\n狙ってましたね？"},
        { "location": "4478/Talk", "narrator": "ガブリエラ", "text": "なんで、\nそうなるのよ……。"},
        { "location": "4479/Talk", "narrator": "みやび", "text": "そんで、二人は\nうちとガブちゃん、\nどっちの味方なん？"},
        { "location": "4480/Talk", "narrator": "つばめ", "text": "わ、わたしは\nみやびさんの意見に\n賛成かなぁ？"},
        { "location": "4481/Talk", "narrator": "神楽", "text": "私は勿論、ガブちゃんに\n賛成ですよっ。"},
        { "location": "4482/Talk", "narrator": "みやび", "text": "いやいや、聞いといて\nなんやけど、\n二人とも逆やろっ！？"},
        { "location": "4483/Talk", "narrator": "つばめ", "text": "いえ、わたしは\nみやびさんの言葉で\n目が覚めたというか、"},
        { "location": "4484/Talk", "narrator": "つばめ", "text": "自分のことばっかりで\n神楽ちゃんの気持ちを\n考えてたのかなって。"},
        { "location": "4485/Talk", "narrator": "つばめ", "text": "とにかくわたしは、\n反省する必要が\nあるって思えたから。"},
        { "location": "4486/Talk", "narrator": "みやび", "text": "うちとしてはそない\n重く言うたつもりは\n無かったんやけど。"},
        { "location": "4487/Talk", "narrator": "神楽", "text": "私はガブちゃんの\n純粋さにクラッと\n来たんです！"},
        { "location": "4488/Talk", "narrator": "神楽", "text": "この汚れない思いを\n私も守りたいって！"},
        { "location": "4489/Talk", "narrator": "ガブリエラ", "text": "何だが茶化されてる\nみたいな気が\nするんだけど……。"},
        { "location": "4490/Talk", "narrator": "みやび", "text": "そしたら今から\nこのシーンをもう一度\nやってみたらどうや？"},
        { "location": "4491/Talk", "narrator": "みやび", "text": "さっきとは全然違う展開に\nなるんと違う？"},
        { "location": "4492/Talk", "narrator": "ガブリエラ", "text": "それ、面白そうね。\nつばめ、神楽、\nやってみなさいよ。"},
        { "location": "4493/Talk", "narrator": "神楽", "text": "わかりました。\nそれでは早速……。"},
        { "location": "4494/Talk", "narrator": "神楽", "text": "つばめさん、私の悩みを\n聞いてください！"},
        { "location": "4495/Talk", "narrator": "つばめ", "text": "わたし、聞くだけで\n何もできないから、\n言わなくてもいいよ？"},
        { "location": "4496/Talk", "narrator": "神楽", "text": "酷い！　つばめさん\nいつもそう言って\n逃げてばっかり！"},
        { "location": "4497/Talk", "narrator": "神楽", "text": "話を聞いてないから\n知らなかったって\n言い訳作りですか？"},
        { "location": "4498/Talk", "narrator": "つばめ", "text": "そ、そういうことじゃ\nなくて……えーと、\n困ったなぁ……。"},
        { "location": "4499/Talk", "narrator": "みやび", "text": "結局どっちでも\n同じ結末なんやね。"},
        { "location": "4500/Talk", "narrator": "ガブリエラ", "text": "ええ、どっちにしろ\nあんたたちダメだわ。"},
        { "location": "4501/Talk", "narrator": "つばめ", "text": "ガブちゃん、見捨てるの\n早過ぎない！？"},
        { "location": "4502/Talk", "narrator": "みやび", "text": "ちゅうか、これって\n火曜サスペンス劇場\nとかの不倫話やね。"},
        { "location": "4503/Talk", "narrator": "神楽", "text": "じゃあ私とつばめさんは\n不倫関係なんですね！"},
        { "location": "4504/Talk", "narrator": "神楽", "text": "禁断の愛！　そう思って\n視点を変えてみると、\n超燃えますね！！"},
        { "location": "4505/Talk", "narrator": "神楽", "text": "きゃー！　軽蔑しても\nいいんですよ！とか\n言ってますよこの子！"},
        { "location": "4506/Talk", "narrator": "神楽", "text": "その気も無いのに、\nこういうのサソイウケ\nっていうんですよね！"},
        { "location": "4507/Talk", "narrator": "つばめ", "text": "あわわわわっ、\n神楽ちゃんが\n暴走してる……。"},
        { "location": "4508/Talk", "narrator": "ガブリエラ", "text": "暴走じゃなくて\n妄想してるだけだから\n放置しときなさい。"},
        { "location": "4509/Talk", "narrator": "みやび", "text": "それはそれで\nあかんことになる気が\nしちょるけんど……。"},
        { "location": "4510/Talk", "narrator": "神楽", "text": "つばめさん、私たちに\n足りなかったものが\nやっとわかりました！"},
        { "location": "4511/Talk", "narrator": "神楽", "text": "それは禁断の愛！\n私たちはマンネリ\nだったんですよ！"},
        { "location": "4512/Talk", "narrator": "つばめ", "text": "そ、そうかなぁ？\nわたしは平凡な毎日が\nいいんだけど……。"},
        { "location": "4513/Talk", "narrator": "神楽", "text": "甘過ぎです！\n正にカラクのような\n甘さですよっ！"},
        { "location": "4514/Talk", "narrator": "神楽", "text": "サスペンスが、\n非日常こそが、愛を\n燃焼させるんです！"},
        { "location": "4515/Talk", "narrator": "神楽", "text": "さぁ、ガブちゃん！\nつばめさんを\n奪ってください！"},
        { "location": "4516/Talk", "narrator": "ガブリエラ", "text": "……は？\nなんで、あたしが？"},
        { "location": "4517/Talk", "narrator": "神楽", "text": "何故ならみやびさんは\n胸が大きいからＮＧです！"},
        { "location": "4518/Talk", "narrator": "ガブリエラ", "text": "どこにどう\n関係してるのよ、\nその理由は！？"},
        { "location": "4519/Talk", "narrator": "神楽", "text": "だって、みやびさんや\nアーヤさんじゃ\n勝ち目ありませんし。"},
        { "location": "4520/Talk", "narrator": "神楽", "text": "最初から勝ち目が\n無かったらドラマに\nなりませんし。"},
        { "location": "4521/Talk", "narrator": "ガブリエラ", "text": "だからなんでそれを胸の\n大小で判断するのよっ！？"},
        { "location": "4522/Talk", "narrator": "ガブリエラ", "text": "それに胸にしたって、\nあたしは神楽よりは\n大きいから！"},
        { "location": "4523/Talk", "narrator": "神楽", "text": "でもガブちゃんなら\n僅差ですから\n追いつける可能性が。"},
        { "location": "4524/Talk", "narrator": "ガブリエラ", "text": "あたしの方が成長期だし、\n追いつかせないから！"},
        { "location": "4525/Talk", "narrator": "みやび", "text": "なんや本当に不倫騒動\nみたいになって\nきよっちゃね。"},
        { "location": "4526/Talk", "narrator": "ガブリエラ", "text": "ちょっと！\nそれあたしまで\n含まれてない！？"},
        { "location": "4527/Talk", "narrator": "神楽", "text": "あっ、これはもしや！\nつばめさんの\nお節介すぎる愛で"},
        { "location": "4528/Talk", "narrator": "神楽", "text": "遂に限界突破！？\nＵＲ神楽ちゃんが\n爆誕しちゃうっ！？"},
        { "location": "4529/Talk", "narrator": "みやび", "text": "もうメタなネタも\nお構いなしやな。\n手がつけられん……。"},
        { "location": "4530/Talk", "narrator": "ガブリエラ", "text": "ん？\n……これってアレでしょ？\nフェノメノン。"},
        { "location": "4531/Talk", "narrator": "みやび", "text": "そうやけど、\nガブちゃん、なんで\nそない冷静なん？"},
        { "location": "4532/Talk", "narrator": "ガブリエラ", "text": "こんな派手な発症は\nこの稼業始めて以来、\n初めて見たけど。"},
        { "location": "4533/Talk", "narrator": "ガブリエラ", "text": "でもフェノメノンの\n割には特にヘンな世界\nでも何でもないわね。"},
        { "location": "4534/Talk", "narrator": "ガブリエラ", "text": "神楽だったらもっと、\nつばめを触手で\nビリィィィィ！　とか"},
        { "location": "4535/Talk", "narrator": "ガブリエラ", "text": "つばめと甘々な結婚生活を\nしてる世界とか"},
        { "location": "4536/Talk", "narrator": "ガブリエラ", "text": "そういう頭おかしい\n感じのだと\n思ってたんだけど？"},
        { "location": "4537/Talk", "narrator": "神楽", "text": "ちょっとガブちゃんの\n中の私のイメージに\nついて問い詰めたい。"},
        { "location": "4538/Talk", "narrator": "神楽", "text": "それはともかく\n私的にはつばめさんと\n仲良く一緒に――"},
        { "location": "4539/Talk", "narrator": "神楽", "text": "魔法少女トリプルメルティ\nーズをやってる世界が\n良かったですね。"},
        { "location": "4540/Talk", "narrator": "神楽", "text": "勿論、愛と友情の\nむふふな展開アリで。"},
        { "location": "4541/Talk", "narrator": "ガブリエラ", "text": "自分で作ったのなら\nなんとかできなかったの？"},
        { "location": "4542/Talk", "narrator": "つばめ", "text": "あのー……、\nなんとかされても\n困るんだけど？"},
        { "location": "4543/Talk", "narrator": "神楽", "text": "残念ながら\n世界観は自分では\n制御できないんです。"},
        { "location": "4544/Talk", "narrator": "神楽", "text": "多分無意識が勝手に\n創ってるからだと\n思うんですけど。"},
        { "location": "4545/Talk", "narrator": "神楽", "text": "ガブちゃんも\n一度やってみれば\nわかりますよ？"},
        { "location": "4546/Talk", "narrator": "ガブリエラ", "text": "一生わからなくて\n結構よっ！"},
        { "location": "4547/Talk", "narrator": "みやび", "text": "ちょい待ち。\nそれより卯月の後ろに\nいるんはなんぞね？"},
        { "location": "4548/Talk", "narrator": "神楽", "text": "あー、気づいちゃい\nましたかー。\nでも秘密ですっ！！"},
        { "location": "4549/Talk", "narrator": "神楽", "text": "ですって！\nこれはやっぱり、\nつばめさんに――"},
        { "location": "4550/Talk", "narrator": "神楽", "text": "一生責任取って\nもらわないと\nいけませんね。"},
        { "location": "4551/Talk", "narrator": "神楽", "text": "つばめさん、\n早速お式の準備を。\nむしろ式場が来い！"},
        { "location": "4552/Talk", "narrator": "つばめ", "text": "うん、なんかもう驚くのも\n馬鹿らしいかなって。"},
        { "location": "4553/Talk", "narrator": "神楽", "text": "あぁっ！？\n純朴なつばめさんの瞳を\n曇らせたのは誰っ！？"},
        { "location": "4554/Talk", "narrator": "ガブリエラ", "text": "つっこまないから。"},
        { "location": "4555/Talk", "narrator": "みやび", "text": "なんや今回はうち無双\nやと思っちょったのに\n上手くいかんもんや。"},
        { "location": "4556/Talk", "narrator": "ガブリエラ", "text": "それはそれでどうかと\n思うんだけど……。"},
        { "location": "4557/Talk", "narrator": "つばめ", "text": "えーと、とりあえず\n神楽ちゃんが戻って\n来てよかったです。"},
        { "location": "4558/Talk", "narrator": "つばめ", "text": "でもこんなので次回は\nどうなっちゃうん\nだろ……。"},
        { "location": "4559/Talk", "narrator": "つばめ", "text": "不安て言うか、怖くなって\nきちゃった……。"}
    ]
}
