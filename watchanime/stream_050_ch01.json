{
    "dir": "stream_050_ch01.json",
    "type": "watchanime",
    "info": {
    },
    "entry":
    [
        { "location": "771/Talk", "narrator": "みやび", "text": "目が泳いどるで？"},
        { "location": "772/Talk", "narrator": "ガブリエラ", "text": "誤魔化すのが下手ね。"},
        { "location": "773/Talk", "narrator": "つばめ", "text": "えーっ？\n誰なんですか？\n教えてくださいよ～。"},
        { "location": "774/Talk", "narrator": "みやび", "text": "ま、内緒なら内緒で\n後々のお楽しみに\nとっとくき。"},
        { "location": "775/Talk", "narrator": "つばめ", "text": "なるほど！　つまり、\n後で仲間になる子\nですね？"},
        { "location": "776/Talk", "narrator": "アーヤ", "text": "それは違う子が……。\nいえ、何でもないわ。"},
        { "location": "777/Talk", "narrator": "つばめ", "text": "？\nアーヤさんも何か\n隠してます？"},
        { "location": "778/Talk", "narrator": "アーヤ", "text": "き、気のせいよ。\n本当に\n誰なのかしらね。"},
        { "location": "779/Talk", "narrator": "ガブリエラ", "text": "リーダー、新人たちが\nあたしのこと\nいじめます。"},
        { "location": "780/Talk", "narrator": "みやび", "text": "ナメられたらあかん。\nここはビシィッと\n厳しくシメとき。"},
        { "location": "781/Talk", "narrator": "ガブリエラ", "text": "そうね。……新人、\n悪く思わないで\nちょうだい。"},
        { "location": "782/Talk", "narrator": "つばめ", "text": "ふえぇぇぇ～っ！？"},
        { "location": "783/Talk", "narrator": "ガブリエラ", "text": "あんた、実はあたしが\n忍者の末裔だって\n気づいたようね……。"},
        { "location": "784/Talk", "narrator": "みやび", "text": "ほほぅ、これが噂の\nポーランド忍者！"},
        { "location": "785/Talk", "narrator": "ガブリエラ", "text": "知られたからには\n生かしておけないわ！\nあんたも。"},
        { "location": "786/Talk", "narrator": "つばめ", "text": "何でわたしもっ！？"},
        { "location": "787/Talk", "narrator": "つばめ", "text": "せんぱい、そんなに\n背のこと気にしなくて\nいいのに。"},
        { "location": "788/Talk", "narrator": "つばめ", "text": "だってわたしは、\nそんなせんぱいも\n可愛くて好きですよ！"},
        { "location": "789/Talk", "narrator": "つばめ", "text": "ね？\nそう思うでしょ？"},
        { "location": "790/Talk", "narrator": "アーヤ", "text": "ふふっ、二人とも\n可愛いわね。"},
        { "location": "791/Talk", "narrator": "アーヤ", "text": "そ、その、あくまでも\nチームの一員として\n可愛いってことよっ。"},
        { "location": "792/Talk", "narrator": "アーヤ", "text": "チームの一員として\nってのも変な話ね。\nごめん今のナシ……。"},
        { "location": "793/Talk", "narrator": "みやび", "text": "何やアーヤ\n自爆かね。"},
        { "location": "794/Talk", "narrator": "みやび", "text": "可愛らしいなら\n可愛らしい言えば\nええだけぞね。"},
        { "location": "795/Talk", "narrator": "みやび", "text": "ま、そんなアーヤも\n可愛らしいけんど。"},
        { "location": "796/Talk", "narrator": "アーヤ", "text": "バトルも佳境に入って\nいよいよ目が離せなく\nなってきたわね！"},
        { "location": "797/Talk", "narrator": "みやび", "text": "まあ、画面の向こうの\nアーヤやうちのことなぞ\n正直どうでもえいけどな。"},
        { "location": "798/Talk", "narrator": "みやび", "text": "それより、OPの考察を\n続けるぞね。"},
        { "location": "799/Talk", "narrator": "ガブリエラ", "text": "自分のことなのに\nどうでもいいって\nどういうことよ！"},
        { "location": "800/Talk", "narrator": "みやび", "text": "おお、ガブちゃん。\nどうゆうことって、\n言葉通りやけんど。"},
        { "location": "801/Talk", "narrator": "みやび", "text": "過去やろが未来やろが\n今の自分以外の自分は\n別の存在やき。"},
        { "location": "802/Talk", "narrator": "ガブリエラ", "text": "また無駄に難しいこと\n言っちゃって…。"},
        { "location": "803/Talk", "narrator": "つばめ", "text": "ひーん、\n遅くなりました。"},
        { "location": "804/Talk", "narrator": "ガブリエラ", "text": "遅いわよ、新人！"},
        { "location": "805/Talk", "narrator": "つばめ", "text": "ご、ごめんなさい。"},
        { "location": "806/Talk", "narrator": "みやび", "text": "例えば今遅れたつばめ\nちゃんに、身体で分から\nせる折檻をしたとして。"},
        { "location": "807/Talk", "narrator": "みやび", "text": "しかしこの映像の中の\nつばめちゃんには、何の\n変化もないわけやないか。"},
        { "location": "808/Talk", "narrator": "つばめ", "text": "えええ……っ…。\nわたし、折檻されちゃうん\nですか……？"},
        { "location": "809/Talk", "narrator": "アーヤ", "text": "単なる例えだから\n大丈夫よ。"},
        { "location": "810/Talk", "narrator": "ガブリエラ", "text": "で？\nそれとOPと、どんな\n関係があるのよ。"},
        { "location": "811/Talk", "narrator": "みやび", "text": "このOPの歌詞を聴くと\n何度か出てくる単語が\nある。それは――"},
        { "location": "812/Talk", "narrator": "ガブリエラ", "text": "『嘘』？"},
        { "location": "813/Talk", "narrator": "みやび", "text": "そうやね。しかしこの\n嘘という言葉を、額面\n通りに捉えて良いのか。"},
        { "location": "814/Talk", "narrator": "アーヤ", "text": "そもそも、『嘘で固めた\nミルフィーユの中』って\n時点でアレよね。"},
        { "location": "815/Talk", "narrator": "みやび", "text": "うむ、その通りや。"},
        { "location": "816/Talk", "narrator": "みやび", "text": "しかし残念ながら、\n今回ももうOPが終わって\nしまうちや。"},
        { "location": "817/Talk", "narrator": "つばめ", "text": "ああぁっ！\nほんとだ！"},
        { "location": "818/Talk", "narrator": "ガブリエラ", "text": "次回こそは、ちゃんとした\n考察ができるといいわね。"},
        { "location": "819/Talk", "narrator": "つばめ", "text": "はい、皆さん。今回も\n始まりましたっ。\n楽しくいきましょう！"},
        { "location": "820/Talk", "narrator": "つばめ", "text": "どんどんぱふぱふぱふ\nぷ～っ♪"},
        { "location": "821/Talk", "narrator": "ガブリエラ", "text": "何か変に\nテンション\n高いわね……。"},
        { "location": "822/Talk", "narrator": "つばめ", "text": "えーと、今回で物語が\n一段落するから\nシメていこうかと？"},
        { "location": "823/Talk", "narrator": "アーヤ", "text": "いい心がけね、\n逢瀬さん。"},
        { "location": "824/Talk", "narrator": "ガブリエラ", "text": "とか言ってホントは\nあんた的につらい\nシーン続きだから"},
        { "location": "825/Talk", "narrator": "ガブリエラ", "text": "さっさと終わらせたい\nだけだったりして？"},
        { "location": "826/Talk", "narrator": "つばめ", "text": "えっ！？　えっと、\n……あ、あはは……。"},
        { "location": "827/Talk", "narrator": "ガブリエラ", "text": "で、みやびがシールド\n張ってくれても結局\n吹っ飛ばされてるし。"},
        { "location": "828/Talk", "narrator": "みやび", "text": "でもうちのシールドの\nお陰で、この程度で\n済んだんやけどね。"},
        { "location": "829/Talk", "narrator": "アーヤ", "text": "そうね。みやびの\nお陰で大したキズも\n無かったし。"},
        { "location": "830/Talk", "narrator": "アーヤ", "text": "受けたダメージも\n１／１０くらいには\nなったはずよ。"},
        { "location": "831/Talk", "narrator": "つばめ", "text": "すごいです、\nみやびさん！"},
        { "location": "832/Talk", "narrator": "みやび", "text": "ふっふっふっ、\nもっともっと\n褒め讃えてええんよ？"},
        { "location": "833/Talk", "narrator": "ガブリエラ", "text": "はい、次いこ、次。"},
        { "location": "834/Talk", "narrator": "みやび", "text": "この言葉、\n何か引っかからんか？"},
        { "location": "835/Talk", "narrator": "ガブリエラ", "text": "フェノメノンのことを\n中二病っぽく\n言ってるだけでしょ？"},
        { "location": "836/Talk", "narrator": "みやび", "text": "中二病言われたら\n身も蓋も無いなぁ。"},
        { "location": "837/Talk", "narrator": "みやび", "text": "まぁ、ええか。\n先行っといて。"},
        { "location": "838/Talk", "narrator": "アーヤ", "text": "さぁ、来たわよ。\n問題のシーン。"},
        { "location": "839/Talk", "narrator": "ガブリエラ", "text": "何かもう、\nゾンビみたいね。"},
        { "location": "840/Talk", "narrator": "つばめ", "text": "ひぇぇ～、\n恐いこと言わないで\nくださいよ～。"},
        { "location": "841/Talk", "narrator": "つばめ", "text": "生きてます！\nわたし、\n生きてますからっ！"},
        { "location": "842/Talk", "narrator": "みやび", "text": "それにしてもここの\nつばめちゃんの\n強キャラ感すごいわ～。"},
        { "location": "843/Talk", "narrator": "みやび", "text": "もしかして今回の\nうちらって当て馬？"},
        { "location": "844/Talk", "narrator": "つばめ", "text": "えっ、そ、そんな、\nわたしなんてっ。"},
        { "location": "845/Talk", "narrator": "アーヤ", "text": "からかわないの。\n私たちはいつも通り\n対応しただけよ。"},
        { "location": "846/Talk", "narrator": "つばめ", "text": "うわぁぁぁっ！！\nな、何ですかこれ！？\nこ、こわいよぉ～……。"},
        { "location": "847/Talk", "narrator": "ガブリエラ", "text": "自分で不気味な声\n出しといて\n怖いって言うな！"},
        { "location": "848/Talk", "narrator": "つばめ", "text": "わ、わたしの声じゃ\nないですよ！？"},
        { "location": "849/Talk", "narrator": "つばめ", "text": "こんな声、\n真似しようとしても\n無理ですってば！"},
        { "location": "850/Talk", "narrator": "みやび", "text": "ヒント：\nヘリウムガス。"},
        { "location": "851/Talk", "narrator": "アーヤ", "text": "それは\n声が高くなる\n方でしょ……。"},
        { "location": "852/Talk", "narrator": "つばめ", "text": "これって、クランを\n引き抜いたって\nことですよね？"},
        { "location": "853/Talk", "narrator": "アーヤ", "text": "ええ、発症者から\n強引にその力の源を\n引き抜いたわけね。"},
        { "location": "854/Talk", "narrator": "つばめ", "text": "えーと……。\nこの発症者の人は\n大丈夫なんですか？"},
        { "location": "855/Talk", "narrator": "みやび", "text": "つばめちゃん、\nヒトの心配してる\n場合やないよ。"},
        { "location": "856/Talk", "narrator": "つばめ", "text": "そ、\nそうですけど……。"},
        { "location": "857/Talk", "narrator": "ガブリエラ", "text": "これでやっと\nフェノメノンの\n収束ね。"},
        { "location": "858/Talk", "narrator": "ガブリエラ", "text": "結局、発症者は\nメノウ以外は眼中に\n無かったってことで"},
        { "location": "859/Talk", "narrator": "ガブリエラ", "text": "観客たちは\n石にされただけで\nいい迷惑だったわね。"},
        { "location": "860/Talk", "narrator": "みやび", "text": "最初はメノウが目当て\nだったんやろけど\n実際に狙われとったの"},
        { "location": "861/Talk", "narrator": "みやび", "text": "つばめちゃんやったし\nターゲット変更\nしちょったかね。"},
        { "location": "862/Talk", "narrator": "つばめ", "text": "でもとりあえず石に\nされてた人たちが\n無事でよかったです。"},
        { "location": "863/Talk", "narrator": "ガブリエラ", "text": "戦いに巻き込まれて\n割れてたりしてたら\n解除されてから……。"},
        { "location": "864/Talk", "narrator": "つばめ", "text": "あっ、わたし、\nそういうのダメです。\nこの話はナシでっ！"},
        { "location": "865/Talk", "narrator": "ガブリエラ", "text": "あんたが\n振ったんでしょ……。"},
        { "location": "866/Talk", "narrator": "アーヤ", "text": "今回の任務も終了した\nわけだけど、いつも\n最後は後味が悪いわ。"},
        { "location": "867/Talk", "narrator": "ガブリエラ", "text": "発症者を倒せば\n万事解決！　ってわけ\nにはいかないからね。"},
        { "location": "868/Talk", "narrator": "みやび", "text": "しかも今回は、\nややこしい物件が\n出て来たきねえ。"},
        { "location": "869/Talk", "narrator": "つばめ", "text": "えっ？　もしかして\nそれってわたしの\nことだったり？"},
        { "location": "870/Talk", "narrator": "みやび", "text": "さぁ？\nどうやろなー？"},
        { "location": "871/Talk", "narrator": "つばめ", "text": "あ～ん、そんなこと\n言わないで\nくださいよぉ～っ！"},
        { "location": "872/Talk", "narrator": "アーヤ", "text": "大丈夫よ、逢瀬さん。\n確かにややこしいこと\nにはなったけど"},
        { "location": "873/Talk", "narrator": "アーヤ", "text": "逢瀬さんの面倒は\n私たちが\nきちんと見るわ。"},
        { "location": "874/Talk", "narrator": "ガブリエラ", "text": "それ、フォローに\nなってるの？"},
        { "location": "875/Talk", "narrator": "つばめ", "text": "あれっ？\n誰かいますよ？\nこの子も関係者？"},
        { "location": "876/Talk", "narrator": "アーヤ", "text": "……私は\n見たこと無い子ね。"},
        { "location": "877/Talk", "narrator": "ガブリエラ", "text": "いや、もう\nあからさまに\n怪しいんですけど。"},
        { "location": "878/Talk", "narrator": "みやび", "text": "ここは君に意見を\n聞くべきとこやろ。\nな？"},
        { "location": "879/Talk", "narrator": "つばめ", "text": "あっ、行っちゃった。"},
        { "location": "880/Talk", "narrator": "みやび", "text": "そして時は流れ、\nあの日フェノメノンに\n巻き込まれた少女は、"},
        { "location": "881/Talk", "narrator": "みやび", "text": "新たな巣立ちの日を\n迎えたのだったー。"},
        { "location": "882/Talk", "narrator": "ガブリエラ", "text": "何そのわざとらしい\nナレーション。"},
        { "location": "883/Talk", "narrator": "つばめ", "text": "時は流れって、でも\nこれってまだ６日くらい\nしか経ってないですよね。"},
        { "location": "884/Talk", "narrator": "ガブリエラ", "text": "噛んでるし。"},
        { "location": "885/Talk", "narrator": "つばめ", "text": "だって、すっごく\n緊張してたから……。"},
        { "location": "886/Talk", "narrator": "みやび", "text": "つばめちゃんは\nいっつも\n緊張しぃやね。"},
        { "location": "887/Talk", "narrator": "ガブリエラ", "text": "ちょっとストップ！"},
        { "location": "888/Talk", "narrator": "つばめ", "text": "ふぇっ！？　な、何で\nこんな所で\n止めるのっ！？"},
        { "location": "889/Talk", "narrator": "ガブリエラ", "text": "こういう時の挨拶で\n「ふつつか者」って\n普通言わないでしょ。"},
        { "location": "890/Talk", "narrator": "ガブリエラ", "text": "何でも何も、\nあんた本当に日本人？"},
        { "location": "891/Talk", "narrator": "つばめ", "text": "はうぅ～、外国人の\nガブちゃんに日本語の\n指摘をされたぁ～。"},
        { "location": "892/Talk", "narrator": "みやび", "text": "そういえばこの時、\n担任の先生って\nどこ行ってたん？"},
        { "location": "893/Talk", "narrator": "つばめ", "text": "ちゃんと教壇に\nいましたよ。"},
        { "location": "894/Talk", "narrator": "つばめ", "text": "背が小さくて\n映ってないだけで。"},
        { "location": "895/Talk", "narrator": "ガブリエラ", "text": "どんだけよ！"},
        { "location": "896/Talk", "narrator": "つばめ", "text": "ん～？　せんぱいと\n同じくらいかなぁ？"},
        { "location": "897/Talk", "narrator": "ガブリエラ", "text": "冗談はともかく、\nほら見なさい。"},
        { "location": "898/Talk", "narrator": "ガブリエラ", "text": "他の生徒からも\nつっこまれてるじゃ\nないの。"},
        { "location": "899/Talk", "narrator": "みやび", "text": "普通の子ぉ言われとる\nけど、これ普通と\n思っとらんやろ。"},
        { "location": "900/Talk", "narrator": "つばめ", "text": "あうぅ～……。\n恥ずかしい～……。"},
        { "location": "901/Talk", "narrator": "みやび", "text": "さぁ、ここで颯爽と\n白馬に乗ったアーヤの\nお出ましぞね！"},
        { "location": "902/Talk", "narrator": "ガブリエラ", "text": "そして有無を言わさぬ\n強制連行。"},
        { "location": "903/Talk", "narrator": "アーヤ", "text": "転入早々、突然で\nごめんなさいね。"},
        { "location": "904/Talk", "narrator": "アーヤ", "text": "でもこんな立て続けの\nフェノメノンなんて\nこっちも想定外だったの。"},
        { "location": "905/Talk", "narrator": "ガブリエラ", "text": "普段は月に\n一、二回程度だしね。"},
        { "location": "906/Talk", "narrator": "みやび", "text": "というわけで、\nつばめちゃん拉致される！"},
        { "location": "907/Talk", "narrator": "みやび", "text": "どうなる次回！\n刮目して待てっ！"},
        { "location": "908/Talk", "narrator": "ガブリエラ", "text": "あっ、まさか\n背の順で追い出そうと\nしてない！？"},
        { "location": "909/Talk", "narrator": "ガブリエラ", "text": "そうだったらあんたの\n背も縮む呪いを\nかけてやるからっ！"},
        { "location": "910/Talk", "narrator": "ガブリエラ", "text": "縮め、縮め、\nどんどん縮め～。"}
    ]
}
