{
    "dir": "stream_300_ch01.json",
    "type": "watchanime",
    "info": {
    },
    "entry":
    [
        { "location": "5865/Talk", "narrator": "潜在みやび", "text": "まあ、ビックリするのも\nわからんでもない。"},
        { "location": "5866/Talk", "narrator": "潜在みやび", "text": "なぜなら、うち自身も\nビックリやからぞね。"},
        { "location": "5867/Talk", "narrator": "潜在みやび", "text": "うちか？\n通りすがりの\nコイガサキの人格や。"},
        { "location": "5868/Talk", "narrator": "潜在みやび", "text": "お前さんがうちに\n興味あるなら、どこかで\n逢っちゅうかもね。"},
        { "location": "5869/Talk", "narrator": "潜在みやび", "text": "ふむ、なるほど。\nではしばし待たれよ。"},
        { "location": "5870/Talk", "narrator": "潜在みやび", "text": "なるほど。では…"},
        { "location": "5871/Talk", "narrator": "潜在みやび", "text": "いつもの自分を\n脱ぎ捨てたい？"},
        { "location": "5872/Talk", "narrator": "潜在みやび", "text": "うむ、わかった。\nしばし待たれよ。"},
        { "location": "5873/Talk", "narrator": "潜在みやび", "text": "ふむふむ。それでは…"},
        { "location": "5874/Talk", "narrator": "潜在みやび", "text": "胸なんぞは――"},
        { "location": "5875/Talk", "narrator": "潜在みやび", "text": "わかった。\nまっこと、えい答えちや。"},
        { "location": "5876/Talk", "narrator": "潜在みやび", "text": "ほんだら、\nしばし待たれよ。"},
        { "location": "5877/Talk", "narrator": "潜在みやび", "text": "なるほど。\nなんか面倒に\nなってきた。"},
        { "location": "5878/Talk", "narrator": "潜在みやび", "text": "…もうこれでえいか。\nしばし待たれよ。"},
        { "location": "5879/Talk", "narrator": "みやび", "text": "なにをまた\nわけのわからんことを\n言っちゅう？"},
        { "location": "5880/Talk", "narrator": "みやび", "text": "まあえいよ。\n相棒が謎発言しゆうは\nいつものことやき。"},
        { "location": "5881/Talk", "narrator": "潜在みやび", "text": "相棒、相棒。"},
        { "location": "5882/Talk", "narrator": "潜在みやび", "text": "うちはお前さんにしか\n見えちょらんき。"},
        { "location": "5883/Talk", "narrator": "潜在みやび", "text": "今回、うちとお前さんの\n通訳を買って出ちゃる\nことにしたんよ。"},
        { "location": "5884/Talk", "narrator": "潜在みやび", "text": "まっこと、現実のうちは\n素直やないきね。"},
        { "location": "5885/Talk", "narrator": "みやび", "text": "ん？\nああ、これか。"},
        { "location": "5886/Talk", "narrator": "みやび", "text": "なんか\nよくわからんのやけんど―"},
        { "location": "5887/Talk", "narrator": "みやび", "text": "今日の視聴はお前さんと\n二人きりや思うたら、\n急にドキドキしてきてな。"},
        { "location": "5888/Talk", "narrator": "みやび", "text": "気づいたら、この服を\n選んぢょったが。"},
        { "location": "5889/Talk", "narrator": "みやび", "text": "初っぱなから\n飛ばしゆうね。"},
        { "location": "5890/Talk", "narrator": "みやび", "text": "まあ、嫌な気分かゆうたら\nそんなことはないけんど。"},
        { "location": "5891/Talk", "narrator": "潜在みやび", "text": "いやいや！\nもっともっと\n言ってもえいんやぞ？"},
        { "location": "5892/Talk", "narrator": "潜在みやび", "text": "今回、うちとお前さんの\n通訳を買って出ちゃる\nことにしたんよ。"},
        { "location": "5893/Talk", "narrator": "潜在みやび", "text": "まっこと、現実のうちは\n素直やないきね。"},
        { "location": "5894/Talk", "narrator": "潜在みやび", "text": "うちはお前さんにしか\n見えちょらんき。"},
        { "location": "5895/Talk", "narrator": "潜在みやび", "text": "お、さすが相棒。\n頭がえいね。"},
        { "location": "5896/Talk", "narrator": "みやび", "text": "なんぞ、その\nいごうちゃんゆうのは？"},
        { "location": "5897/Talk", "narrator": "潜在みやび", "text": "相棒、相棒。"},
        { "location": "5898/Talk", "narrator": "潜在みやび", "text": "うちはお前さんにしか\n見えちょらんき。"},
        { "location": "5899/Talk", "narrator": "潜在みやび", "text": "今回、うちとお前さんの\n通訳を買って出ちゃる\nことにしたんよ。"},
        { "location": "5900/Talk", "narrator": "潜在みやび", "text": "まっこと、現実のうちは\n素直やないきね。"},
        { "location": "5901/Talk", "narrator": "みやび", "text": "まあえいか。\nいちいち気にしちょったら\n全然先へ進まんきね。"},
        { "location": "5902/Talk", "narrator": "みやび", "text": "いやいや、\nえー言われてもなぁ。"},
        { "location": "5903/Talk", "narrator": "潜在みやび", "text": "ほれほれ、\nもっと盛り上げるちや！"},
        { "location": "5904/Talk", "narrator": "みやび", "text": "そんなこと言われても、\nうちに可愛い所なんぞ\nひとっつもないけんどな。"},
        { "location": "5905/Talk", "narrator": "潜在みやび", "text": "えいぞえいぞ！"},
        { "location": "5906/Talk", "narrator": "みやび", "text": "ま、だがお前さんは\n変わり者やき、案外\n合ってるかもしれんね。"},
        { "location": "5907/Talk", "narrator": "みやび", "text": "なんぞ、エロ目的か。"},
        { "location": "5908/Talk", "narrator": "潜在みやび", "text": "あちゃー、嬉しいけんど\nダイレクトすぎや。"},
        { "location": "5909/Talk", "narrator": "みやび", "text": "まあえいよ。\nお前さんがそういう輩だと\nいうことは判っちゅうき。"},
        { "location": "5910/Talk", "narrator": "潜在みやび", "text": "ナイス返しや！"},
        { "location": "5911/Talk", "narrator": "みやび", "text": "またそんな、\n歯が浮くような事を\nいけしゃあしゃあと。"},
        { "location": "5912/Talk", "narrator": "みやび", "text": "けんど、見て失望しても\nうちは責任とらんぞね。"},
        { "location": "5913/Talk", "narrator": "みやび", "text": "あー、まあそうやね。"},
        { "location": "5914/Talk", "narrator": "みやび", "text": "けんどなあ、難しいか否か\nゆうんは、自分の分野か\n否かでしかないんよ。"},
        { "location": "5915/Talk", "narrator": "みやび", "text": "うちから言わせてもらえば\n服飾ブランド用語の方が、\n遙かにハイレベルやき。"},
        { "location": "5916/Talk", "narrator": "みやび", "text": "は？"},
        { "location": "5917/Talk", "narrator": "みやび", "text": "な、何を寝ぼけたことを\n言っちゅう。"},
        { "location": "5918/Talk", "narrator": "みやび", "text": "うちは、ハッキング中は\n必ず一人になって、集中\nしてやると決めちゅうき。"},
        { "location": "5919/Talk", "narrator": "みやび", "text": "……まあ、けんど、何も\n喋らず単に後ろから手を\n回すだけゆうなら――"},
        { "location": "5920/Talk", "narrator": "みやび", "text": "考えなくもないけんどな。"},
        { "location": "5921/Talk", "narrator": "みやび", "text": "お前さんは、本当に\nそれしか言わんね。"},
        { "location": "5922/Talk", "narrator": "みやび", "text": "バイザーは、\n高性能なHMDに\nなっちゅうんよ。"},
        { "location": "5923/Talk", "narrator": "潜在みやび", "text": "それに、目隠しされた\n色っぽい格好の少女って\nちくっとそそるやろ？"},
        { "location": "5924/Talk", "narrator": "みやび", "text": "いや、うちに聞かれても。"},
        { "location": "5925/Talk", "narrator": "みやび", "text": "そういうんは、\nデザインした変態さんに\n聞いてや。"},
        { "location": "5926/Talk", "narrator": "潜在みやび", "text": "それは、私です！"},
        { "location": "5927/Talk", "narrator": "潜在みやび", "text": "そして、\nお前自身なんだけどなー、\n現実ちゃん。"},
        { "location": "5928/Talk", "narrator": "みやび", "text": "否！\nヘッドセットを\nつけちゅう。"},
        { "location": "5929/Talk", "narrator": "みやび", "text": "しかも結線されちゅうき、\n全然生まれたままの姿\nではない。"},
        { "location": "5930/Talk", "narrator": "潜在みやび", "text": "相変わらず\n照れ隠しの屁理屈が\n冴え渡るね。"},
        { "location": "5931/Talk", "narrator": "みやび", "text": "とゆうか、お前さんは\n結線された状態で\n生まれてきたのか。"},
        { "location": "5932/Talk", "narrator": "みやび", "text": "もしや貴様、人類を\n滅ぼすべく未来から\nやってきた人造人間か！"},
        { "location": "5933/Talk", "narrator": "みやび", "text": "なるほど。\n闇とゆうよりかは、\n願望やね。"},
        { "location": "5934/Talk", "narrator": "潜在みやび", "text": "うちの全てを見て！\nゆう願望やよ？"},
        { "location": "5935/Talk", "narrator": "みやび", "text": "あれよ、ほら、全部結線\nされちょったら、身体\n動かさんでもえいやんか。"},
        { "location": "5936/Talk", "narrator": "潜在みやび", "text": "恥ずかしいけど、\nこのドキドキは嫌やない。"},
        { "location": "5937/Talk", "narrator": "みやび", "text": "頭の中だけで現実を生きる\nゆうのが、うちの夢や。"},
        { "location": "5938/Talk", "narrator": "みやび", "text": "究極のヒッキーやね。"},
        { "location": "5939/Talk", "narrator": "みやび", "text": "む？"},
        { "location": "5940/Talk", "narrator": "潜在みやび", "text": "してやったり。"},
        { "location": "5941/Talk", "narrator": "みやび", "text": "もしかして、うちの\nソースコードが汚すぎて\n見てられんが？"},
        { "location": "5942/Talk", "narrator": "みやび", "text": "けんど、何も考えナシに\nこのコード記述にしちゅう\nわけやない。"},
        { "location": "5943/Talk", "narrator": "潜在みやび", "text": "うち、かわええな。\nわかっちょって\n照れ隠ししゆう。"},
        { "location": "5944/Talk", "narrator": "みやび", "text": "まだお前さんには、\n理解出来ぬ境地よな。"},
        { "location": "5945/Talk", "narrator": "みやび", "text": "ふむ、なるほど。"},
        { "location": "5946/Talk", "narrator": "潜在みやび", "text": "おおおっ！\nこれはどういう反応を\n示すか、興味あるぞね！"},
        { "location": "5947/Talk", "narrator": "みやび", "text": "相棒の脳内の99.9%が\nエロで満たされちゅう\nことがわかった。"},
        { "location": "5948/Talk", "narrator": "みやび", "text": "けんど…そんなことはもう\nとうの昔に\n判っちょったぞね。"},
        { "location": "5949/Talk", "narrator": "みやび", "text": "まあ、そうやね……"},
        { "location": "5950/Talk", "narrator": "みやび", "text": "もし本当にそういう仲に\nなったら、手もパージ\nされるやもしれんがね？"},
        { "location": "5951/Talk", "narrator": "潜在みやび", "text": "爆弾発言\nキマシタワー！"},
        { "location": "5952/Talk", "narrator": "みやび", "text": "けんど、今はまだ\nお預けやよ？"},
        { "location": "5953/Talk", "narrator": "みやび", "text": "ふむ。"},
        { "location": "5954/Talk", "narrator": "潜在みやび", "text": "引っかかったぞね！"},
        { "location": "5955/Talk", "narrator": "みやび", "text": "お前さんの気持ちが\n実にふしだらであると\nゆうことがわかった。"},
        { "location": "5956/Talk", "narrator": "みやび", "text": "うちの神聖なる\nバトルスーツを見て\n「おしり」とは……。"},
        { "location": "5957/Talk", "narrator": "みやび", "text": "まっこと、\nこまった相棒やね。"},
        { "location": "5958/Talk", "narrator": "潜在みやび", "text": "さあ、\n更に追い打ちを\n掛けるぞね！"},
        { "location": "5959/Talk", "narrator": "みやび", "text": "まあ、えいよ。\n相棒がそういう輩だとゆう\nことは判っちゅうき。"},
        { "location": "5960/Talk", "narrator": "みやび", "text": "ふむ。\nまっこと立派な紳士ぞね。"},
        { "location": "5961/Talk", "narrator": "みやび", "text": "そこまでキリッと\n言われると、うちまで\n自信が湧いてくる。"},
        { "location": "5962/Talk", "narrator": "みやび", "text": "けんど、正直\nでかすぎやないか？\nうちの尻は。"},
        { "location": "5963/Talk", "narrator": "みやび", "text": "お前さんの理屈だと、\n１００ｋｇ超のアメリカン\nサイズがえい事になるな。"},
        { "location": "5964/Talk", "narrator": "潜在みやび", "text": "あちゃー…。"},
        { "location": "5965/Talk", "narrator": "みやび", "text": "なるほど。まあ確かに\nバランスは大事やね。"},
        { "location": "5966/Talk", "narrator": "みやび", "text": "本当は、胸も削った上で\n尻も削りたいがやけんど。"},
        { "location": "5967/Talk", "narrator": "みやび", "text": "まあ、お前さんが\n自信をもってお薦めして\nくれゆうき、えいとする。"},
        { "location": "5968/Talk", "narrator": "潜在みやび", "text": "よくやったぞね！\nお前さんの株\nダダあがりや。"},
        { "location": "5969/Talk", "narrator": "みやび", "text": "相棒のくせに\n理解しゆうとは生意気な。"},
        { "location": "5970/Talk", "narrator": "潜在みやび", "text": "なーんて\n言っちゅうけんど！"},
        { "location": "5971/Talk", "narrator": "潜在みやび", "text": "実は対等な話し相手が\n欲しいき、この返答は\nまっこと嬉しいぞね！"},
        { "location": "5972/Talk", "narrator": "みやび", "text": "では聞くが、見えない\n戦争とは、例えば具体的に\nどうゆうものか？"},
        { "location": "5973/Talk", "narrator": "みやび", "text": "うむうむ、\nそうや、その通りちや。"},
        { "location": "5974/Talk", "narrator": "みやび", "text": "相棒はまっこと\n話がわかるやつやねえ。"},
        { "location": "5975/Talk", "narrator": "潜在みやび", "text": "いやいや、\nここはボケたら\nいかんちや……。"},
        { "location": "5976/Talk", "narrator": "みやび", "text": "次いこか。"},
        { "location": "5977/Talk", "narrator": "みやび", "text": "そうかぁ。"},
        { "location": "5978/Talk", "narrator": "みやび", "text": "やったら、うちは\n向かんかもしれんなぁ。"},
        { "location": "5979/Talk", "narrator": "みやび", "text": "やっぱりうちは、\nPC叩いて何かに挑戦\nしちゅうんが一番やよ。"},
        { "location": "5980/Talk", "narrator": "みやび", "text": "もちろん、お前さんと\nイチャコラしゆうがも\n嫌いやないよ？"},
        { "location": "5981/Talk", "narrator": "潜在みやび", "text": "むしろ毎日\n楽しみにしちゅうよ？"},
        { "location": "5982/Talk", "narrator": "みやび", "text": "けんど、そうゆう甘々なの\nずっとは続けられんきね。"},
        { "location": "5983/Talk", "narrator": "みやび", "text": "それがうちの正直な\n気持ちぞね。"},
        { "location": "5984/Talk", "narrator": "潜在みやび", "text": "けんど、今となっては\nお前さんと疎遠になるのも\n嫌やき、悩ましい。"},
        { "location": "5985/Talk", "narrator": "潜在みやび", "text": "かといって、ずっと\nイチャイチャばかりでは\nこちらが持たん。"},
        { "location": "5986/Talk", "narrator": "潜在みやび", "text": "乙女の辛い悩みやね。"},
        { "location": "5987/Talk", "narrator": "みやび", "text": "なかなか一朝一夕では\n難しいと思うがね。"},
        { "location": "5988/Talk", "narrator": "みやび", "text": "けんど、その気持ちが\n嬉しいちや。"},
        { "location": "5989/Talk", "narrator": "みやび", "text": "ありがとね。"},
        { "location": "5990/Talk", "narrator": "みやび", "text": "まるでうちの妻みたいな\n感じやね。"},
        { "location": "5991/Talk", "narrator": "みやび", "text": "けんど、そうゆうのも\nうちにとっては癒しに\nなりそうやし、えいね。"},
        { "location": "5992/Talk", "narrator": "みやび", "text": "おおっ、\nそれはえいね！"},
        { "location": "5993/Talk", "narrator": "みやび", "text": "うちもな、\nそういう茶飲み友だちが\n欲しくてなぁ。"},
        { "location": "5994/Talk", "narrator": "みやび", "text": "お前さんがそれに\n志願してくれるのなら\n万々歳や。"},
        { "location": "5995/Talk", "narrator": "みやび", "text": "けんど、真剣に議論しゆう\n間は、イチャコラは\n出来んが、大丈夫やか？"},
        { "location": "5996/Talk", "narrator": "潜在みやび", "text": "うちはメリハリのある\n人生を大事にする派や。"},
        { "location": "5997/Talk", "narrator": "みやび", "text": "そうかそうか、\nそれならこちらも\n気兼ねない。"},
        { "location": "5998/Talk", "narrator": "みやび", "text": "真剣に話すときは真剣に\nやって、イチャるときは\nイチャに集中する！"},
        { "location": "5999/Talk", "narrator": "みやび", "text": "これぞまっこと、\n最高効率の人生ぞね。"},
        { "location": "6000/Talk", "narrator": "みやび", "text": "そうかー。\nそれは心苦しいなぁ。"},
        { "location": "6001/Talk", "narrator": "みやび", "text": "うちは、イチャる時は\nイチャることに全力投球\nしたいクチやけんど――"},
        { "location": "6002/Talk", "narrator": "みやび", "text": "PCやっちゅうときや、\n議論かわしちゅう時は\nそれに全力なんよ。"},
        { "location": "6003/Talk", "narrator": "みやび", "text": "やき、あまりお前さんの\n相手をしてやれんかも\nしれんきね。"},
        { "location": "6004/Talk", "narrator": "みやび", "text": "けんど、むしろ専門的な\n議論をしたいのが、\nお前さんのメインやろ。"},
        { "location": "6005/Talk", "narrator": "みやび", "text": "やったら、\n大丈夫かね。"},
        { "location": "6006/Talk", "narrator": "みやび", "text": "はは、そうやね。"},
        { "location": "6007/Talk", "narrator": "みやび", "text": "そうやって、背中を\n預けられる相棒っちゅう\nのは、とてもえいね。"},
        { "location": "6008/Talk", "narrator": "みやび", "text": "この世は全方位に目を\n光らせて生きていかんと、\nすぐに幸せを奪われる。"},
        { "location": "6009/Talk", "narrator": "みやび", "text": "やき、お前さんとうちで\n180度ずつ分担しあって\n互いを護るのはえい。"},
        { "location": "6010/Talk", "narrator": "みやび", "text": "……けんど、アレやね。"},
        { "location": "6011/Talk", "narrator": "みやび", "text": "24時間365日、\n背中にしか温もりを\n感じられんのは寂しい。"},
        { "location": "6012/Talk", "narrator": "みやび", "text": "そんなのがずっと続けば\nいずれ、愛なんて幻だった\nとか言い始めるやもな。"},
        { "location": "6013/Talk", "narrator": "みやび", "text": "なんちゅうワガママで\n二律背反な発言やろね。"},
        { "location": "6014/Talk", "narrator": "みやび", "text": "そんな風に\n生きられたらっちゅうんは\nよく考えはするよ。"},
        { "location": "6015/Talk", "narrator": "みやび", "text": "毎日今日の夕飯のことと、\nどうやって愛し合おうかを\n考えて生きる。"},
        { "location": "6016/Talk", "narrator": "みやび", "text": "そんなトキメキだらけの\nラブラブ生活で幸せに\nなれたら、最高やきね。"},
        { "location": "6017/Talk", "narrator": "みやび", "text": "けんど、やはり周囲の\n物事に目を光らせんと、\nこの世界は生き抜けん。"},
        { "location": "6018/Talk", "narrator": "みやび", "text": "外からそのトキメキと\nラブラブは、いとも簡単に\n破壊されてしまうき。"},
        { "location": "6019/Talk", "narrator": "みやび", "text": "……うちは考えすぎか？"},
        { "location": "6020/Talk", "narrator": "みやび", "text": "…っ！"},
        { "location": "6021/Talk", "narrator": "みやび", "text": "何を言っちゅうが。"},
        { "location": "6022/Talk", "narrator": "みやび", "text": "お前さんは、うちの\nデカイ胸がえいだけやろ！"},
        { "location": "6023/Talk", "narrator": "みやび", "text": "おおっ！\n言い切った！"},
        { "location": "6024/Talk", "narrator": "みやび", "text": "じゃあ、うちの\n何がえい？"},
        { "location": "6025/Talk", "narrator": "みやび", "text": "やはりそうか！\nオッパイ星人め！！"},
        { "location": "6026/Talk", "narrator": "みやび", "text": "そんなにデカイ胸が\nえいなら、まほさんとでも\nいればえいよ。"},
        { "location": "6027/Talk", "narrator": "みやび", "text": "ほほう？\n例えば、どんな？"},
        { "location": "6028/Talk", "narrator": "みやび", "text": "ふむ。\nならば本当はどうゆう\nところがえいのか？"},
        { "location": "6029/Talk", "narrator": "みやび", "text": "何も特別なことや\nないと思うけんどなぁ。"},
        { "location": "6030/Talk", "narrator": "みやび", "text": "友だちが困っちょったら\n何もせんなんてこと、\nできんやか。"},
        { "location": "6031/Talk", "narrator": "みやび", "text": "まあ、ぶっちゃけ面倒では\nあるし、そんな事、無い\n方がえいに決まっちゅう。"},
        { "location": "6032/Talk", "narrator": "みやび", "text": "けんど、その子の方が\nよっぽど面倒なことで\n苦しみゆうわけやき――"},
        { "location": "6033/Talk", "narrator": "みやび", "text": "うちが少しおこぼれ\nもらったら、片付けた後は\nみんなでハッピーや。"},
        { "location": "6034/Talk", "narrator": "みやび", "text": "そう思わんか？"},
        { "location": "6035/Talk", "narrator": "みやび", "text": "な、何をゆうかと思えば。"},
        { "location": "6036/Talk", "narrator": "みやび", "text": "結婚には色んな準備が\nひつようやき、\nおちつけ相棒。"},
        { "location": "6037/Talk", "narrator": "みやび", "text": "まあ何にせよ、うちは\n相棒もそうゆうヤツやと\n思っちゅう。"},
        { "location": "6038/Talk", "narrator": "みやび", "text": "でなければ、こんな面倒な\nうちなんかとは、つき合っ\nちょらんやろうしね。"},
        { "location": "6039/Talk", "narrator": "みやび", "text": "やき、ありがとね。\nうちのこと、いつも\n支えてくれて。"},
        { "location": "6040/Talk", "narrator": "みやび", "text": "早く逢いたいね…。"},
        { "location": "6041/Talk", "narrator": "みやび", "text": "そうやもしれんね。\n否定はせんよ？"},
        { "location": "6042/Talk", "narrator": "みやび", "text": "けんど、打算でやっちゅう\nわけやないき、役に立てば\n純粋に嬉しいちや。"},
        { "location": "6043/Talk", "narrator": "みやび", "text": "まあ、それすらも\n単なる自己満足やも\nしれんけんどね。"},
        { "location": "6044/Talk", "narrator": "みやび", "text": "まあ、結論から言えば、\nうちのことやき、\nうちがよければえいんよ。"},
        { "location": "6045/Talk", "narrator": "みやび", "text": "ほうかほうか。\nこの、ばかちんが。"},
        { "location": "6046/Talk", "narrator": "みやび", "text": "そんなの全然\nえいことやないぞね。"},
        { "location": "6047/Talk", "narrator": "みやび", "text": "そら、うちかて、\n年頃の娘さんやき……"},
        { "location": "6048/Talk", "narrator": "みやび", "text": "そうゆうことを、\n考えないこともない。"},
        { "location": "6049/Talk", "narrator": "みやび", "text": "けんど、それがうちの\n魅力ゆうなら、うちと\nしてはちと寂しいぞね。"},
        { "location": "6050/Talk", "narrator": "みやび", "text": "まあ、えいけんどな。\nそれは裏を返せば――"},
        { "location": "6051/Talk", "narrator": "みやび", "text": "うちが見せたい思っちゅう\n部分をまだ見せられて\nいない、うちの責任やき。"},
        { "location": "6052/Talk", "narrator": "みやび", "text": "そんな状態でも、\nうちの面倒みちょって\nくれゆうわけや。"},
        { "location": "6053/Talk", "narrator": "みやび", "text": "ありがたいことぞね。"},
        { "location": "6054/Talk", "narrator": "みやび", "text": "そうかー…。\nまあ、そうよな。"},
        { "location": "6055/Talk", "narrator": "みやび", "text": "なるほど。\n正直に言ってくれて\nありがとね。"},
        { "location": "6056/Talk", "narrator": "みやび", "text": "それと、そんな中で\nうちとこれだけ相手を\nしてくれてることも。"},
        { "location": "6057/Talk", "narrator": "みやび", "text": "まあ、もしよければ、\nこれからも話し相手に\nなってや。"},
        { "location": "6058/Talk", "narrator": "みやび", "text": "なかなか濃い話を\n言いたい放題言えるヤツは\nまわりにおらんきね。"},
        { "location": "6059/Talk", "narrator": "みやび", "text": "あ、もちろん、\nその誰かさんとの恋愛も、\nうちの安心保証つきや。"},
        { "location": "6060/Talk", "narrator": "みやび", "text": "全力でバックアップするし\nもしその子がうちとの仲に\n嫉妬したなら――"},
        { "location": "6061/Talk", "narrator": "みやび", "text": "全力で炎上させた上で\n手厚くトリートメント\nしちゃる。"},
        { "location": "6062/Talk", "narrator": "みやび", "text": "雨降って地固まるってな。"},
        { "location": "6063/Talk", "narrator": "みやび", "text": "結果的にはラブラブが\n深まるはずやき、\n覚悟しとき？"},
        { "location": "6064/Talk", "narrator": "みやび", "text": "$handle$のくせに、\nえいこと言うね。"},
        { "location": "6065/Talk", "narrator": "みやび", "text": "悔しいけんど、\n一本とられたちや。"},
        { "location": "6066/Talk", "narrator": "みやび", "text": "お前さんの言う通りぞね。"},
        { "location": "6067/Talk", "narrator": "みやび", "text": "愛は\n与えられるものやない。\n二人で育むものや。"},
        { "location": "6068/Talk", "narrator": "みやび", "text": "しっかしまあ、\nなんか、こう……"},
        { "location": "6069/Talk", "narrator": "みやび", "text": "ちくっと、\n恥ずかしいな。"},
        { "location": "6070/Talk", "narrator": "みやび", "text": "お前さんに、うちより\nもっとえいこと言われると\nドキドキしゆう。"},
        { "location": "6071/Talk", "narrator": "みやび", "text": "こういうのが、\n本当に本当の、\n愛なのやもしれんね。"},
        { "location": "6072/Talk", "narrator": "みやび", "text": "えーやない。"},
        { "location": "6073/Talk", "narrator": "みやび", "text": "ションボリされてもなぁ。"},
        { "location": "6074/Talk", "narrator": "潜在みやび", "text": "お久し振り。\n「伊」号やよ。"},
        { "location": "6075/Talk", "narrator": "潜在みやび", "text": "ほんで、なぜうちが\nここにいられるかは\n置いておいて――"},
        { "location": "6076/Talk", "narrator": "潜在みやび", "text": "なぜうちが\nここにいるかの\n説明をするちや。"},
        { "location": "6077/Talk", "narrator": "潜在みやび", "text": "それはコイガサキ本人が\n面と向かって質問できん\nことを質問する為ぞね。"},
        { "location": "6078/Talk", "narrator": "潜在みやび", "text": "というわけで、無駄に\n時間とるのもアレやき、\nすっと質問するぞね。"},
        { "location": "6079/Talk", "narrator": "潜在みやび", "text": "質問。今日は\nフォーマルな気分である。"},
        { "location": "6080/Talk", "narrator": "みやび", "text": "おお、相棒。\n元気にしちゅうが？"},
        { "location": "6081/Talk", "narrator": "みやび", "text": "ところで。"},
        { "location": "6082/Talk", "narrator": "みやび", "text": "うち、４番目に\nなってもうたな。"},
        { "location": "6083/Talk", "narrator": "みやび", "text": "これ、あれやぞ。"},
        { "location": "6084/Talk", "narrator": "みやび", "text": "新体操とかで、前の選手に\n９．９９出されまくった\n後の初心者選手の気分や。"},
        { "location": "6085/Talk", "narrator": "みやび", "text": "ハードルの高さは\nなんと４００ｍ！"},
        { "location": "6086/Talk", "narrator": "みやび", "text": "だがしかし！！\nこの差し迫った危機を\n回避する方法が１つある！"},
        { "location": "6087/Talk", "narrator": "みやび", "text": "それは、\n今回のMV試聴会を\n中止にすることや！"},
        { "location": "6088/Talk", "narrator": "みやび", "text": "というわけで、\nおつかれしたー！"},
        { "location": "6089/Talk", "narrator": "みやび", "text": "ほんだら、\nちゃっちゃと見て\n終わりにするかね。"},
        { "location": "6090/Talk", "narrator": "みやび", "text": "ふむ、ここやったか。"},
        { "location": "6091/Talk", "narrator": "みやび", "text": "なんも面白いシーンでも\nなかろうに。"},
        { "location": "6092/Talk", "narrator": "みやび", "text": "こんなシーンを出さざるを\n得ない程、うちの\nライブラリはゼロかね？"},
        { "location": "6093/Talk", "narrator": "潜在みやび", "text": "見てや見てや！　相棒！\nうちのこのキリッとした\n仕事風景！"},
        { "location": "6094/Talk", "narrator": "潜在みやび", "text": "こんな時に後ろから\n優しく包み込んでくれたら\nうちクラクラやき。"},
        { "location": "6095/Talk", "narrator": "潜在みやび", "text": "頼むで、\n未来の旦那様。"},
        { "location": "6096/Talk", "narrator": "みやび", "text": "けんど、この時は\nまっこと骨が折れたちや。"},
        { "location": "6097/Talk", "narrator": "みやび", "text": "まあ、その分\n突破した時の達成感は\n半端なかったけんどな。"},
        { "location": "6098/Talk", "narrator": "みやび", "text": "……お前さんがいれば、\n一緒に分かち合ったがや\nけんど。"},
        { "location": "6099/Talk", "narrator": "みやび", "text": "何て言っちゅう間に、\n歌が始まってもうた。"},
        { "location": "6100/Talk", "narrator": "みやび", "text": "いきなり空だけで数秒とか\nさすがうちの心情を\nよう表しちゅうね。"},
        { "location": "6101/Talk", "narrator": "潜在みやび", "text": "ちなみに、このスーツは\nうち自身がデザインした\nものなんよ？"},
        { "location": "6102/Talk", "narrator": "みやび", "text": "なんてくだらんこと\n言っちゅうき、全然\nすすまんちや。"},
        { "location": "6103/Talk", "narrator": "みやび", "text": "そういえばお前さん、\nこの歌詞でうちが何を\n言いたいかわかるが？"},
        { "location": "6104/Talk", "narrator": "みやび", "text": "うちらの周りは一見\n平和そうに見えて――"},
        { "location": "6105/Talk", "narrator": "みやび", "text": "まあ、そんなことは\nどうでもえい。"},
        { "location": "6106/Talk", "narrator": "みやび", "text": "話を戻すとな、世の中には\n身体に傷はつかずとも、\n戦争は五万と起こりゆう。"},
        { "location": "6107/Talk", "narrator": "みやび", "text": "そのことを、お前さんは\n理解しちゅうか？\nという謎かけや。"},
        { "location": "6108/Talk", "narrator": "潜在みやび", "text": "おしり。"},
        { "location": "6109/Talk", "narrator": "みやび", "text": "しかしあれやな、\nやっぱりお前さんは、\nその、なんぞね……"},
        { "location": "6110/Talk", "narrator": "みやび", "text": "やっぱ、うちとイチャ\nラブしたいゆう一心で\nつき合っちゅうが？"},
        { "location": "6111/Talk", "narrator": "みやび", "text": "なんて話しゆう理由は、\nうち自身が一番\nわかっちょらんき。"},
        { "location": "6112/Talk", "narrator": "潜在みやび", "text": "さて、そろそろえいか。"},
        { "location": "6113/Talk", "narrator": "潜在みやび", "text": "ほんだら、\nうちはこの辺で。"},
        { "location": "6114/Talk", "narrator": "潜在みやび", "text": "あとは二人で\n仲良くな。"},
        { "location": "6115/Talk", "narrator": "みやび", "text": "まあ、単純に\n色々考えすぎなのかも\nしれんね。"},
        { "location": "6116/Talk", "narrator": "みやび", "text": "けんど、人間は\n考える葦やき。"},
        { "location": "6117/Talk", "narrator": "みやび", "text": "考えるのをやめたら、\n単なるひ弱な葦に\nなってまう。"},
        { "location": "6118/Talk", "narrator": "みやび", "text": "セーブデータも\nコンティニューもない\nこのクソゲー社会で、"},
        { "location": "6119/Talk", "narrator": "みやび", "text": "残機１のまま80年\n生きようとしたら、\n考えるしかないんよ。"},
        { "location": "6120/Talk", "narrator": "みやび", "text": "謎を謎のままにしといたら\n別の誰かが、その謎から\n強力な武器を手に入れる。"},
        { "location": "6121/Talk", "narrator": "みやび", "text": "見えない戦争は、\n日々どこでも起きゆう。"},
        { "location": "6122/Talk", "narrator": "みやび", "text": "そんな中、一人でも危うい\nゆうのに、二人になったら\nもっと重圧は増える。"},
        { "location": "6123/Talk", "narrator": "みやび", "text": "ちくっと、\n爆弾発言するやも\nしれんけんど。"},
        { "location": "6124/Talk", "narrator": "みやび", "text": "やっぱりうちは、\n恋はできんやもしれん。"},
        { "location": "6125/Talk", "narrator": "みやび", "text": "普段からチュッチュ\nのろけたりしゆうは、半分\nレクリエーションやき。"},
        { "location": "6126/Talk", "narrator": "みやび", "text": "もちろん、好きでなければ\nそんなことはせんよ？"},
        { "location": "6127/Talk", "narrator": "みやび", "text": "けんど、それがしたいと\nゆうよりかは――"},
        { "location": "6128/Talk", "narrator": "みやび", "text": "それをすることで、相棒が\n喜んでくれることを\n楽しんでる感じやね。"},
        { "location": "6129/Talk", "narrator": "みやび", "text": "うちが本当に欲しいのは、\nその先にあるものや。"},
        { "location": "6130/Talk", "narrator": "みやび", "text": "言葉では説明しにくい\nけんど……なんや、"},
        { "location": "6131/Talk", "narrator": "みやび", "text": "何の心配もいらん、\n本当の！"},
        { "location": "6132/Talk", "narrator": "みやび", "text": "包まれるような！"},
        { "location": "6133/Talk", "narrator": "みやび", "text": "……あ"},
        { "location": "6134/Talk", "narrator": "みやび", "text": "<size=10>愛が…欲しいだけぞね。</size>"},
        { "location": "6135/Talk", "narrator": "みやび", "text": "な、ななな\nなんぞ！！"},
        { "location": "6136/Talk", "narrator": "みやび", "text": "うちは一体\n何言っちゅうが！"},
        { "location": "6137/Talk", "narrator": "みやび", "text": "100年分の\n真面目モードを一瞬で\n使い果たしたちや！"},
        { "location": "6138/Talk", "narrator": "みやび", "text": "ホントに、\nお前さんと話しちょると、\n驚きの連続やき。"},
        { "location": "6139/Talk", "narrator": "みやび", "text": "今のうちの気持ちは、\nまさにこれやね。"},
        { "location": "6140/Talk", "narrator": "みやび", "text": "とゆうわけや。"},
        { "location": "6141/Talk", "narrator": "みやび", "text": "うちからすれば、\nお前さんは\n驚異的な存在や。"},
        { "location": "6142/Talk", "narrator": "みやび", "text": "それは、えい意味でも\n悪い意味でもな。"},
        { "location": "6143/Talk", "narrator": "みやび", "text": "そうゆう所も含めて、\nうちは、お前さんのこと\n好きやよ？"},
        { "location": "6144/Talk", "narrator": "みやび", "text": "やき、これからも\n程々によろしゅう\nお願いします。"},
        { "location": "6145/Talk", "narrator": "みやび", "text": "……って。"},
        { "location": "6146/Talk", "narrator": "みやび", "text": "はあー、真面目モード\n1日3分の筈が、どんだけ\nやりゆうか、うちは！！"},
        { "location": "6147/Talk", "narrator": "みやび", "text": "もはや10年分は\n使い果たしたぞね。"},
        { "location": "6148/Talk", "narrator": "みやび", "text": "よって、あと10年は\n真面目モードナシな。"},
        { "location": "6149/Talk", "narrator": "みやび", "text": "まあ、そうやね、\nほんだら――"},
        { "location": "6150/Talk", "narrator": "みやび", "text": "お前さん分の真面目\nモードは、１万年ローンの\nツケでやっちゃる。"},
        { "location": "6151/Talk", "narrator": "みやび", "text": "生きちゅう間に\n払いきれん分のツケは、\n魂になった後でえいよ。"},
        { "location": "6152/Talk", "narrator": "みやび", "text": "その間の9900年ほどは、\nフザケタコイガサキが\n延々相手しちゃるきね。"},
        { "location": "6153/Talk", "narrator": "みやび", "text": "……そんなとこかね。"},
        { "location": "6154/Talk", "narrator": "みやび", "text": "お後がよろしいようで。"},
        { "location": "6155/Talk", "narrator": "みやび", "text": "まだちくっとだけあるき、\n最後まで見たってや。"},
        { "location": "6156/Talk", "narrator": "みやび", "text": "ほななー。"}
    ]
}
