{
    "dir": "stream_350_ch01.json",
    "type": "watchanime",
    "info": {
    },
    "entry":
    [
        { "location": "6773/Talk", "narrator": "みやび", "text": "なんと！\nうちはお前さんのことを\n買いかぶっていたようだ。"},
        { "location": "6774/Talk", "narrator": "ガブリエラ", "text": "良かったわね。\n変態買いかぶりの\n犠牲にならなくて。"},
        { "location": "6775/Talk", "narrator": "神楽", "text": "でもガブちゃんが\n裸で寝てたらきっと\n絵になると思いますよ？"},
        { "location": "6776/Talk", "narrator": "ガブリエラ", "text": "神楽に言われると\nヨコシマな気を感じて\n寒気がするんだけど！"},
        { "location": "6777/Talk", "narrator": "みやび", "text": "あー、わかるわかる。\n冷え性やと足が寒くて\n寝つけんからね。"},
        { "location": "6778/Talk", "narrator": "ガブリエラ", "text": "だからって履いてたら\n悪循環なんじゃない？"},
        { "location": "6779/Talk", "narrator": "みやび", "text": "風邪ひくよりはマシ\n理論やき。"},
        { "location": "6780/Talk", "narrator": "つばめ", "text": "ていうかなんで誰も\n靴下「だけ」ってトコ\nつっこまないの？"},
        { "location": "6781/Talk", "narrator": "みやび", "text": "そこは変態同士スルーし\n合うのが礼儀やき。"},
        { "location": "6782/Talk", "narrator": "ガブリエラ", "text": "そんな礼儀は\n滅んじゃいなさい！"},
        { "location": "6783/Talk", "narrator": "ガブリエラ", "text": "珍しく気が合うわね。"},
        { "location": "6784/Talk", "narrator": "みやび", "text": "そこはついて来るいう\n意思を示さんと\nいかんとこやき！"},
        { "location": "6785/Talk", "narrator": "ガブリエラ", "text": "いや、ついて行きたく\nないんですけど。"},
        { "location": "6786/Talk", "narrator": "ガブリエラ", "text": "なるほど。\nスルーして放置が\n一番ってわけね。"},
        { "location": "6787/Talk", "narrator": "みやび", "text": "そんなうがった見方\nせんといて！"},
        { "location": "6788/Talk", "narrator": "みやび", "text": "けんどそれがきっと\n正解やきね！"},
        { "location": "6789/Talk", "narrator": "アーヤ", "text": "私も頑張ろうかと\n思っていたのだけれど\n超展開過ぎて……。"},
        { "location": "6790/Talk", "narrator": "アーヤ", "text": "いえ、リーダーとして\nこれではダメね。次は\nしっかりやらないと。"},
        { "location": "6791/Talk", "narrator": "アーヤ", "text": "ついつい空気を読んで\nしまって、ボケとか\n出来ないのよね……。"},
        { "location": "6792/Talk", "narrator": "ガブリエラ", "text": "今回はみやびに\n全部持っていかれたわね。"},
        { "location": "6793/Talk", "narrator": "ガブリエラ", "text": "やっぱりこういう時は、\nみやびに任せるのが\n一番よね。"},
        { "location": "6794/Talk", "narrator": "ガブリエラ", "text": "もうちょっと可愛い系の\n展開になったら、\nあたしも活躍するわよ？"},
        { "location": "6795/Talk", "narrator": "つばめ", "text": "ところで今回の\n新曲のアルバムって、\nいつ出るんですか？"},
        { "location": "6796/Talk", "narrator": "つばめ", "text": "早く神楽ちゃんと\n音羽さんのデュエットを\nエンドレスで聴きたい！"},
        { "location": "6797/Talk", "narrator": "つばめ", "text": "あ、わたしの歌のことは\n気にしないで！\nむしろ忘れていいです。"},
        { "location": "6798/Talk", "narrator": "神楽", "text": "皆さん、コンニチワ。\nぼっちラスト定位置の\n卯月神楽です。"},
        { "location": "6799/Talk", "narrator": "神楽", "text": "もしかして私ずっと\nイジメられてました？\n今気づきましたけど。"},
        { "location": "6800/Talk", "narrator": "神楽", "text": "私をイジメていいのは、\n“悪意の無い天然の”\nつばめさんだけですよ？"},
        { "location": "6801/Talk", "narrator": "神楽", "text": "……あ、でも。\n$handle$さんにも\nそのうち許しちゃうかも。"},
        { "location": "6802/Talk", "narrator": "神楽", "text": "その後の\n１０倍返し付きで。"},
        { "location": "6803/Talk", "narrator": "神楽", "text": "早く楽しいこと、\nいっぱいしたいです♪"},
        { "location": "6804/Talk", "narrator": "みやび", "text": "みやびはちからを\nためている。"},
        { "location": "6805/Talk", "narrator": "ガブリエラ", "text": "アンタまたいきなり\n危ないネタから入るの\nやめなさいよ！"},
        { "location": "6806/Talk", "narrator": "つばめ", "text": "今回はみやびさんが解説し\nまくっちゃうんですよね？"},
        { "location": "6807/Talk", "narrator": "みやび", "text": "せやから今から力を\n蓄えちょるんよ。"},
        { "location": "6808/Talk", "narrator": "ガブリエラ", "text": "いや、そういうのは始める\n前に済ませて来てよ。"},
        { "location": "6809/Talk", "narrator": "アーヤ", "text": "みやびは夏休みの\n宿題を最終日まで\nしないタイプかしら？"},
        { "location": "6810/Talk", "narrator": "みやび", "text": "ちゅうか宿題なんて\nハナからしないいう感じ？"},
        { "location": "6811/Talk", "narrator": "つばめ", "text": "うわぁ！　みやびさん\n勇気ありますね。\n叱られませんでした？"},
        { "location": "6812/Talk", "narrator": "みやび", "text": "そこは担任の弱味さえ\n握ってしまえば\nこっちのもんやき。"},
        { "location": "6813/Talk", "narrator": "つばめ", "text": "そ、そうですか……。"},
        { "location": "6814/Talk", "narrator": "アーヤ", "text": "みやび、\nそれくらいに……。"},
        { "location": "6815/Talk", "narrator": "みやび", "text": "大事なもんネットに\n繋がる所に置いたら\nうちの餌食やきな。"},
        { "location": "6816/Talk", "narrator": "ガブリエラ", "text": "ていうか小学生とかの\n時からそれなの？"},
        { "location": "6817/Talk", "narrator": "みやび", "text": "むしろあの頃の方が\n無防備に個人情報\n晒しちょったからな。"},
        { "location": "6818/Talk", "narrator": "アーヤ", "text": "連絡網の名簿とか\n普通に全校生徒のが\nあったものね。"},
        { "location": "6819/Talk", "narrator": "ガブリエラ", "text": "いや、さすがにそれは\nナイでしょ。"},
        { "location": "6820/Talk", "narrator": "アーヤ", "text": "えっ！？\nもしかして私の地元が\n田舎だっただけとか！？"},
        { "location": "6821/Talk", "narrator": "みやび", "text": "まあうちの地元も\nたいがい田舎やけんど。"},
        { "location": "6822/Talk", "narrator": "ガブリエラ", "text": "なんにしろ昔から能力の\n悪用をしてたってことね。"},
        { "location": "6823/Talk", "narrator": "みやび", "text": "しかし日常系ゆるふわ\nアニメだったはずが、\n遂に悪魔まで登場とは。"},
        { "location": "6824/Talk", "narrator": "みやび", "text": "世の中ほんに何が\n起こるかわからんき。"},
        { "location": "6825/Talk", "narrator": "つばめ", "text": "キャーッ！\n音羽さーん！"},
        { "location": "6826/Talk", "narrator": "ガブリエラ", "text": "あの妄信的ファンが\nメノウじゃない子に\n反応するなんて。"},
        { "location": "6827/Talk", "narrator": "みやび", "text": "でもほんまに声質は\nよう似ちょるんやな。"},
        { "location": "6828/Talk", "narrator": "アーヤ", "text": "もし音楽会社が卯月\nじゃなくて音羽を採用\nしてたら――"},
        { "location": "6829/Talk", "narrator": "アーヤ", "text": "ここに来ていたのも\n卯月じゃなくて\n音羽だったってことよね。"},
        { "location": "6830/Talk", "narrator": "ガブリエラ", "text": "そう考えるとその方が\n平和だったんじゃない？"},
        { "location": "6831/Talk", "narrator": "みやび", "text": "まあ、卯月に比べたら音羽\nの方が常識人っぽいし――"},
        { "location": "6832/Talk", "narrator": "みやび", "text": "つばめちゃんを毒牙に\nかけようなんてしない\nやろし。"},
        { "location": "6833/Talk", "narrator": "つばめ", "text": "音羽さん、尊い……。"},
        { "location": "6834/Talk", "narrator": "アーヤ", "text": "声は似てても卯月とは\n全然違う魅力を\n持っているわね。"},
        { "location": "6835/Talk", "narrator": "神楽", "text": "皆さん酷いですよ！\n言いたい放題だし音羽\nばっかりアゲアゲで！"},
        { "location": "6836/Talk", "narrator": "神楽", "text": "お陰で私の人気は急降下！"},
        { "location": "6837/Talk", "narrator": "神楽", "text": "ついに脱がないと食べて\nいけなくなっちゃったじゃ\nないですか！"},
        { "location": "6838/Talk", "narrator": "ガブリエラ", "text": "それにしたって\nいきなり全裸ってのは\nやり過ぎでしょ。"},
        { "location": "6839/Talk", "narrator": "みやび", "text": "順番ちゅうか段取りは\n大事やね。普通の水着\nからスタートして――"},
        { "location": "6840/Talk", "narrator": "みやび", "text": "徐々に布地面積を\n減らしていって、\n最後は手だけで……。"},
        { "location": "6841/Talk", "narrator": "神楽", "text": "そんな手順を踏んでたら、\n何のアニメだ！\nって怒られますから！"},
        { "location": "6842/Talk", "narrator": "つばめ", "text": "ていうか神楽ちゃんの\n場合、手で隠してすら\nいないんだけど……。"},
        { "location": "6843/Talk", "narrator": "ガブリエラ", "text": "大胆グラビアどころか\nただの痴女よね。"},
        { "location": "6844/Talk", "narrator": "神楽", "text": "言われるとは思ってた\nけど本当に言われると\n傷つきますよ！"},
        { "location": "6845/Talk", "narrator": "みやび", "text": "ところで、うちらなんで\n十字になって浮いちょるん？"},
        { "location": "6846/Talk", "narrator": "つばめ", "text": "もしかして黒魔術の\n生け贄とか？"},
        { "location": "6847/Talk", "narrator": "みやび", "text": "なんやこうやって\n一人ずつ顔をアップに\nされちょると――"},
        { "location": "6848/Talk", "narrator": "みやび", "text": "うちら本当に\nお亡くなりになったん\nやなぁと感慨深いね。"},
        { "location": "6849/Talk", "narrator": "つばめ", "text": "何言ってるんですか！\nまだ死んでないですっ\nてば！"},
        { "location": "6850/Talk", "narrator": "ガブリエラ", "text": "だったらこれどういう\nシチュエーションなのよ！？"},
        { "location": "6851/Talk", "narrator": "みやび", "text": "まあまあ落ち着きや。\nヒント：\nフェノメノンの中。"},
        { "location": "6852/Talk", "narrator": "ガブリエラ", "text": "それくらい解ってるから！"},
        { "location": "6853/Talk", "narrator": "ガブリエラ", "text": "だからってデタラメに\n何でもアリってのは\nナシでしょ？"},
        { "location": "6854/Talk", "narrator": "ガブリエラ", "text": "ちゃんとそれなりの意図\nってものが必要じゃない？"},
        { "location": "6855/Talk", "narrator": "つばめ", "text": "そもそもこれって誰の\nフェノメノンなんだっけ？"},
        { "location": "6856/Talk", "narrator": "神楽", "text": "はい！　はい！\n私でーす！"},
        { "location": "6857/Talk", "narrator": "ガブリエラ", "text": "ああ、だから\n黒魔術っぽいのね。\n納得しちゃった。"},
        { "location": "6858/Talk", "narrator": "神楽", "text": "納得しないでくださいっ！"},
        { "location": "6859/Talk", "narrator": "神楽", "text": "これは単なる舞台設定\nです！"},
        { "location": "6860/Talk", "narrator": "神楽", "text": "演劇でもライブでも舞台\n演出は要なんですよ！"},
        { "location": "6861/Talk", "narrator": "神楽", "text": "ただ音羽が歌ってる\nだけじゃ、カラオケと\n変わりませんよ！"},
        { "location": "6862/Talk", "narrator": "神楽", "text": "だから皆さんを使っての\n演出なんです！"},
        { "location": "6863/Talk", "narrator": "みやび", "text": "うちらは\n大道具かい！！"},
        { "location": "6864/Talk", "narrator": "つばめ", "text": "ああっ！\nなんだか大変なことに\nなってきたよ！"},
        { "location": "6865/Talk", "narrator": "ガブリエラ", "text": "あれ？\nなんか音声おかしくない？"},
        { "location": "6866/Talk", "narrator": "神楽", "text": "ガブちゃん。\nこれは演出ですよ。\nオシャレな演出。"},
        { "location": "6867/Talk", "narrator": "つばめ", "text": "キャーッ！\nメノウちゃんの\n新曲キターッ！！"},
        { "location": "6868/Talk", "narrator": "ガブリエラ", "text": "つばめって死の淵にいても\nメノウの新曲があれば\n生きて行けそうよね。"},
        { "location": "6869/Talk", "narrator": "みやび", "text": "これにはさすがの\n黒幕オジサン達も\n予想外やったに違いない。"},
        { "location": "6870/Talk", "narrator": "ガブリエラ", "text": "きっと今頃はつばめの\nメノウヲタっぷりに\n頭抱えてるわよね。"},
        { "location": "6871/Talk", "narrator": "神楽", "text": "アイドルヲタクに\n振り回される国家って\nなんか笑えますね。"},
        { "location": "6872/Talk", "narrator": "ガブリエラ", "text": "いや、アンタがそれ\n言うのだけは\nやめときなさいって。"},
        { "location": "6873/Talk", "narrator": "みやび", "text": "卯月、相変わらず\nマッパやけど、\n露出願望でもあるん？"},
        { "location": "6874/Talk", "narrator": "神楽", "text": "あーっ、\nバレちゃいましたか！"},
        { "location": "6875/Talk", "narrator": "つばめ", "text": "えぇっ！？\nか、神楽ちゃんっ！？"},
        { "location": "6876/Talk", "narrator": "神楽", "text": "こう見えても私、\n脱ぐのが好きなんです！"},
        { "location": "6877/Talk", "narrator": "ガブリエラ", "text": "卯月、いくら道化に\n徹するって言っても\n限度があるわよ？"},
        { "location": "6878/Talk", "narrator": "神楽", "text": "え？　だって夜とか\n普通に裸で寝てたり\nしますけど？"},
        { "location": "6879/Talk", "narrator": "みやび", "text": "まあ、それはうちも\nちょくちょくあるけんど。"},
        { "location": "6880/Talk", "narrator": "ガブリエラ", "text": "ちょっと、なんで急に\nカミングアウト大会な\n流れになってるの！？"},
        { "location": "6881/Talk", "narrator": "みやび", "text": "何言うてるん？\nガブちゃんかて\n普通にあるやろ？"},
        { "location": "6882/Talk", "narrator": "ガブリエラ", "text": "無いから！！"},
        { "location": "6883/Talk", "narrator": "みやび", "text": "なら一度やってみ。\n世界が変わるき。"},
        { "location": "6884/Talk", "narrator": "ガブリエラ", "text": "なんで引きずり込もう\nとしてるのよ！？"},
        { "location": "6885/Talk", "narrator": "つばめ", "text": "っていうか、わたしは？"},
        { "location": "6886/Talk", "narrator": "神楽", "text": "つばめさんが裸で\n寝てたりしたら\n即、襲いますけど？"},
        { "location": "6887/Talk", "narrator": "つばめ", "text": "う、うん、わたしは\n風邪ひきそうだし\nやめとくよ……。"},
        { "location": "6888/Talk", "narrator": "みやび", "text": "ちなみにキミはどうなん？"},
        { "location": "6889/Talk", "narrator": "みやび", "text": "祝・つばめちゃん\n歌謡デビュー！"},
        { "location": "6890/Talk", "narrator": "ガブリエラ", "text": "でもデビューシーンが\n死亡しながら歌うって\nいうのも衝撃的よね。"},
        { "location": "6891/Talk", "narrator": "つばめ", "text": "生きてるうちに\n歌いたかったよぉ……。"},
        { "location": "6892/Talk", "narrator": "みやび", "text": "お？\nここでクラン復活？\n燃える展開来ちゃう？"},
        { "location": "6893/Talk", "narrator": "ガブリエラ", "text": "あれ？　クランって\n全部合体して神楽に\nくっついてなかった？"},
        { "location": "6894/Talk", "narrator": "つばめ", "text": "何言ってるんですか。\nちゃんと物語追ってて\nくださいよ。"},
        { "location": "6895/Talk", "narrator": "つばめ", "text": "音羽さんですよ！\nテレポシコメです！"},
        { "location": "6896/Talk", "narrator": "ガブリエラ", "text": "いや、テルプシコラ\nだから！　その間違い\n恥ずかしいから！"},
        { "location": "6897/Talk", "narrator": "神楽", "text": "音羽が聞いてたら\n恥ずかしさのあまり\n自殺するかも……。"},
        { "location": "6898/Talk", "narrator": "みやび", "text": "にしても、ここら辺て\n歌で会話しちょらん？\nすごくない？"},
        { "location": "6899/Talk", "narrator": "神楽", "text": "全然普通ですよ。\n最早私とつばめさんは\n歌で会話する仲……。"},
        { "location": "6900/Talk", "narrator": "神楽", "text": "二人の愛の前には言葉\nなんて不要なんです！"},
        { "location": "6901/Talk", "narrator": "つばめ", "text": "卯月さん……あんまり\n適当なことばかり言うと\nわたしも怒りますから。"},
        { "location": "6902/Talk", "narrator": "神楽", "text": "つばめさんの冷たい視線、\nこれはこれでご褒美かも\nです。"},
        { "location": "6903/Talk", "narrator": "ガブリエラ", "text": "うん、やっぱりもう\n神楽は手遅れだわ。"},
        { "location": "6904/Talk", "narrator": "アーヤ", "text": "やっと私たちの\n出番みたいね。"},
        { "location": "6905/Talk", "narrator": "アーヤ", "text": "と思ったら、私たちも\n歌で会話してる！？"},
        { "location": "6906/Talk", "narrator": "みやび", "text": "卯月のフェノメノンに、\nつばめちゃんとうちらが\nダイレクトアタック？"},
        { "location": "6907/Talk", "narrator": "ガブリエラ", "text": "あたしらの歌を聴いた\n神楽が確かに苦しそう\nにしてはいるけど。"},
        { "location": "6908/Talk", "narrator": "みやび", "text": "まあ、美少女をぶん殴って\nぶっ倒すいうのは、\n絵面的によろしくない。"},
        { "location": "6909/Talk", "narrator": "みやび", "text": "よって、歌による\n精神攻撃の方が綺麗では\nあると思うが、どうか？"},
        { "location": "6910/Talk", "narrator": "ガブリエラ", "text": "精神攻撃とか言葉にする\nと生々しくて気持ち悪い\nわね。"},
        { "location": "6911/Talk", "narrator": "ガブリエラ", "text": "まだ殴られた方が\nマシなんじゃない？\nって思っちゃうけど。"},
        { "location": "6912/Talk", "narrator": "つばめ", "text": "えー……わたしは\n痛いのはイヤだなぁ。"},
        { "location": "6913/Talk", "narrator": "ガブリエラ", "text": "精神攻撃もそれはそれで\n心が痛いんだけどね。"},
        { "location": "6914/Talk", "narrator": "アーヤ", "text": "そうね。\n心の傷の方が治りが\n遅かったりもするものね。"},
        { "location": "6915/Talk", "narrator": "みやび", "text": "しかし、やたらとイメージ\nビデオみたいのが入ってき\nよるね。"},
        { "location": "6916/Talk", "narrator": "みやび", "text": "これは一体なんぞ。\n卯月の趣味なんか？"},
        { "location": "6917/Talk", "narrator": "アーヤ", "text": "いきなり自分の手を縄で\n縛るなんて、相当訓練さ\nれてるわよね。"},
        { "location": "6918/Talk", "narrator": "つばめ", "text": "わわわっ！？\n遂に宇宙に飛び出し\nちゃったよ！？"},
        { "location": "6919/Talk", "narrator": "ガブリエラ", "text": "もうツッコミどころだけで\n構成されてるから、\nツッコミ切れないわ！"},
        { "location": "6920/Talk", "narrator": "みやび", "text": "それや！　それこそが\nフェノメノンの真髄！\n今、悟ったわ！"},
        { "location": "6921/Talk", "narrator": "みやび", "text": "フェノメノンは毎回\nツッコミ処しか\nなかったんやけど――"},
        { "location": "6922/Talk", "narrator": "みやび", "text": "全部ツッコミ処イコール\n相対的に見ればツッコミ\n処ではない！"},
        { "location": "6923/Talk", "narrator": "みやび", "text": "ツッコミどころゆうんは\n要するに、常識的な事象に\n対し違和感がある場所。"},
        { "location": "6924/Talk", "narrator": "みやび", "text": "けんど、全てが違和感で\n構成されちょったら、\nそこではそれが全て常識！"},
        { "location": "6925/Talk", "narrator": "みやび", "text": "もはやツッコミ処では\nなくなるのだ！！"},
        { "location": "6926/Talk", "narrator": "つばめ", "text": "みやびさん、すごい！\n宇宙の真理を遂に会得\nしちゃいましたね！"},
        { "location": "6927/Talk", "narrator": "アーヤ", "text": "……どうつっこんだら\nいいものやら……。"},
        { "location": "6928/Talk", "narrator": "ガブリエラ", "text": "アンタもボーッと\n黙って聞いてないで\nなんか言いなさいよ！"},
        { "location": "6929/Talk", "narrator": "ガブリエラ", "text": "うん、アンタに振った\nあたしも悪かったわ。\nこの件は流しましょ。"},
        { "location": "6930/Talk", "narrator": "つばめ", "text": "なんて宇宙の真理を\n解き明かしている内に\n太陽ですよ、太陽！！"},
        { "location": "6931/Talk", "narrator": "みやび", "text": "そんでな、そろそろ\n本気でつっこんでも\nいいかね？"},
        { "location": "6932/Talk", "narrator": "アーヤ", "text": "ええ、遠慮無く\nいつものみやびらしく\n好きにしていいわよ。"},
        { "location": "6933/Talk", "narrator": "みやび", "text": "うちら、これ、卯月と\n戦ってるんやよね？"},
        { "location": "6934/Talk", "narrator": "つばめ", "text": "確か、そうだったと\n思うけど……。"},
        { "location": "6935/Talk", "narrator": "みやび", "text": "なら結局これ、\n卯月は何がしたくて、\nうちらはどうしたいん？"},
        { "location": "6936/Talk", "narrator": "つばめ", "text": "うーん、それは……。"},
        { "location": "6937/Talk", "narrator": "ガブリエラ", "text": "えっ？　もしかして\n誰もわからないで\n戦ってるわけ？"},
        { "location": "6938/Talk", "narrator": "みやび", "text": "いや、ほら、うちら\n死んでたわけで。"},
        { "location": "6939/Talk", "narrator": "みやび", "text": "つばめちゃんの超パワー\n（仮説）によるゾンビの\nようなもんやろ。"},
        { "location": "6940/Talk", "narrator": "みやび", "text": "やき、うちらには\n目的も意志もなくても\n仕方ないわけで。"},
        { "location": "6941/Talk", "narrator": "ガブリエラ", "text": "だいたいこれって、\nかなり派手で綺麗な\n演出入れてるけど――"},
        { "location": "6942/Talk", "narrator": "ガブリエラ", "text": "やってる事って、神楽を\n体育館裏に呼びつけて、\nボコってる感じでしょ？"},
        { "location": "6943/Talk", "narrator": "ガブリエラ", "text": "「話し合い（意味深）で\n解決しましょ」ってヤツ？"},
        { "location": "6944/Talk", "narrator": "アーヤ", "text": "なるほど。殴りこそ\nしないけれど、言葉で\nネチネチ責めると。"},
        { "location": "6945/Talk", "narrator": "つばめ", "text": "なるほど！\nやっぱりわたしたち\n女の子だもんねっ♪"},
        { "location": "6946/Talk", "narrator": "ガブリエラ", "text": "つばめ…。\nあんたに他意はないかも\nしれないけど……"},
        { "location": "6947/Talk", "narrator": "ガブリエラ", "text": "それってめっちゃ\n陰湿なヤツだから。"},
        { "location": "6948/Talk", "narrator": "つばめ", "text": "ええっ！？\nわたしたち、神楽ちゃんを\nイジメてたの！？"},
        { "location": "6949/Talk", "narrator": "みやび", "text": "んなことしちょらんよ。\n穿った見方をすると\nそうも見えるゆうだけや。"},
        { "location": "6950/Talk", "narrator": "みやび", "text": "いろいろあったけんど、\nこの時は既に、卯月のこと\n受け入れちゅうきね。"},
        { "location": "6951/Talk", "narrator": "ガブリエラ", "text": "そうよね。つばめには\nちょっと冗談の刺激が\n強すぎたかしら。"},
        { "location": "6952/Talk", "narrator": "みやび", "text": "ほら、そないなこと\n言うちょるうちに、\n円満解決や！"},
        { "location": "6953/Talk", "narrator": "つばめ", "text": "みんなの笑顔が\nまぶしいよ！"},
        { "location": "6954/Talk", "narrator": "アーヤ", "text": "あら？　何かしら？"},
        { "location": "6955/Talk", "narrator": "つばめ", "text": "ああっ！\n空から何かが\n降って来たよ！？"},
        { "location": "6956/Talk", "narrator": "ガブリエラ", "text": "そんなの見てれば\nわかるから。"},
        { "location": "6957/Talk", "narrator": "みやび", "text": "なんやこの、せっかくの\nハッピーエンドを台無しに\nする終わり方は！"},
        { "location": "6958/Talk", "narrator": "みやび", "text": "衝撃的な引きにすれば\nええっちゅうことやない\nぞね！？"},
        { "location": "6959/Talk", "narrator": "アーヤ", "text": "でも待って。あれが敵とは\n限らないのでは？"},
        { "location": "6960/Talk", "narrator": "みやび", "text": "まあ、そうやね。\n次回刮目して待て！\nっちゅうことや。"},
        { "location": "6961/Talk", "narrator": "みやび", "text": "そないなわけで、\nお疲れさまー。"},
        { "location": "6962/Talk", "narrator": "ガブリエラ", "text": "ええ、お疲れさま。"},
        { "location": "6963/Talk", "narrator": "つばめ", "text": "ちょっと待って！\nこれ何かなし崩し的に\n終わってますけど――"},
        { "location": "6964/Talk", "narrator": "つばめ", "text": "結局、何がどうなったのか\n全然解らないんですけど！"},
        { "location": "6965/Talk", "narrator": "みやび", "text": "ああ、そこはサラッと\n流しとくところやよ。"},
        { "location": "6966/Talk", "narrator": "みやび", "text": "深く考えると黒服に\nつれて行かれるき。"},
        { "location": "6967/Talk", "narrator": "つばめ", "text": "お……\nおつかれさまでしたっ！"},
        { "location": "6968/Talk", "narrator": "みやび", "text": "でも、つばめちゃんのため\nにちくっとだけ話を合わせ\nちゃるとな。"},
        { "location": "6969/Talk", "narrator": "みやび", "text": "これっちゅうんは\nフェノメノン戦やないか。"},
        { "location": "6970/Talk", "narrator": "みやび", "text": "相手が卯月だとしても\nフェノメノン戦やよ？"},
        { "location": "6971/Talk", "narrator": "みやび", "text": "フェノメノン戦ちゅうは、\n毎回かなり無茶な世界が\n展開されて来よった。"},
        { "location": "6972/Talk", "narrator": "みやび", "text": "例えば、アーヤと\nガブちゃんとで\n魔法少女やったし。"},
        { "location": "6973/Talk", "narrator": "みやび", "text": "ゲームのキャラで\nビリィィィィ！\nされたり――"},
        { "location": "6974/Talk", "narrator": "みやび", "text": "相手がテキストＵＩ\nだったり色々あったけんど\nそれと同じやよ。"},
        { "location": "6975/Talk", "narrator": "みやび", "text": "スケールがデカイのは\n卯月の妄想力の賜物か、\n想いの力の強さか。"},
        { "location": "6976/Talk", "narrator": "みやび", "text": "歌で戦うなんてのも、\n卯月らしさ――"},
        { "location": "6977/Talk", "narrator": "みやび", "text": "いや、何かの\nメッセージなのかも\nしれんね。"},
        { "location": "6978/Talk", "narrator": "つばめ", "text": "なるほど！\nなんとなくわかった\n気がしてきました！"},
        { "location": "6979/Talk", "narrator": "ガブリエラ", "text": "ていうか今回は\n徹底考察するって\n言ってたのに――"},
        { "location": "6980/Talk", "narrator": "ガブリエラ", "text": "結局マトモに考察したの、\n全部終わってからの今が\n初めてじゃない？"},
        { "location": "6981/Talk", "narrator": "みやび", "text": "スタッフロールが\n終わるまで席を立つな\nゆう教訓やき。"},
        { "location": "6982/Talk", "narrator": "アーヤ", "text": "それ自体は私も賛同する\nけど、今回の件については\nこじつけだと思うわね。"},
        { "location": "6983/Talk", "narrator": "ガブリエラ", "text": "まあ、もう\nどうでもいいけど。"},
        { "location": "6984/Talk", "narrator": "みやび", "text": "今回は語りに語ったき、\n大満足や！\n考察？　最後にしたよ？"},
        { "location": "6985/Talk", "narrator": "みやび", "text": "どや？　えいんよ？\nうちのことタップリ\n褒めてもえいんよ？"},
        { "location": "6986/Talk", "narrator": "みやび", "text": "ちゅうかむしろ褒めて！\nうちにしては頑張ったと\n思わんが！？"}
    ]
}
