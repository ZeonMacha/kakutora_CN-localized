{
    "dir": "stream_250_ch01.json",
    "type": "watchanime",
    "info": {
    },
    "entry":
    [
        { "location": "4848/Talk", "narrator": "ガブリエラ", "text": "そうそう、\nそれが普通の\n反応よね。"},
        { "location": "4849/Talk", "narrator": "みやび", "text": "この手のオカルト系が\n好きやと睨んだのに\nはずしたか。"},
        { "location": "4850/Talk", "narrator": "つばめ", "text": "えっ？　オカルトっ？\nこ、こわい話は\nやめましょうよ……。"},
        { "location": "4851/Talk", "narrator": "ガブリエラ", "text": "今さら気づいたの！？"},
        { "location": "4852/Talk", "narrator": "みやび", "text": "えっ？　何ぞね？\n暗にお色気サービスでも\n要求しちゅうが？"},
        { "location": "4853/Talk", "narrator": "みやび", "text": "うちも脱ぐ時は脱ぐ女\nやき、脱いだら凄いの\n見せちゃるよ？"},
        { "location": "4854/Talk", "narrator": "ガブリエラ", "text": "誰も脱いでくれとか\n言ってないし……。"},
        { "location": "4855/Talk", "narrator": "アーヤ", "text": "あら、つばめだって\n脱いだら意外と\n凄いのよ？"},
        { "location": "4856/Talk", "narrator": "つばめ", "text": "アーヤさん！\nその情報、今言う必要\nないですよね！？"},
        { "location": "4857/Talk", "narrator": "みやび", "text": "確かにまほさんは\nかなり怒ってる\nみたいやけど。"},
        { "location": "4858/Talk", "narrator": "ガブリエラ", "text": "でもそれだと\n０２０５でしょ？\n０が一つ余るのは無視？"},
        { "location": "4859/Talk", "narrator": "つばめ", "text": "オニオーオコ？\n鬼さん大激怒？"},
        { "location": "4860/Talk", "narrator": "アーヤ", "text": "さすがに無理がある\n語呂合わせね。"},
        { "location": "4861/Talk", "narrator": "つばめ", "text": "えーっ！？\nそんな時間だとわたし\nお腹ぐーぐーだよー。"},
        { "location": "4862/Talk", "narrator": "ガブリエラ", "text": "つばめのお腹は\n１７時頃には\nなってるじゃないの。"},
        { "location": "4863/Talk", "narrator": "つばめ", "text": "ガブちゃん、\n気づいてたの！？"},
        { "location": "4864/Talk", "narrator": "ガブリエラ", "text": "むしろどうして\n気づかれてないと\n思ってたのよ……。"},
        { "location": "4865/Talk", "narrator": "ガブリエラ", "text": "前半で無駄話し過ぎた\nせいなのか後半は何か\n普通だったわね。"},
        { "location": "4866/Talk", "narrator": "ガブリエラ", "text": "あたしたちがピンチな\nことには変わりないん\nだけど。"},
        { "location": "4867/Talk", "narrator": "ガブリエラ", "text": "とりあえず、つばめが\nあそこからどうするの\nかは見ものかもね。"},
        { "location": "4868/Talk", "narrator": "アーヤ", "text": "いよいよ姉が\n出てくるのかしらね。"},
        { "location": "4869/Talk", "narrator": "アーヤ", "text": "…ううん、別に言うほど\n嫌いってわけでも\n無いんだけど…ホントは。"},
        { "location": "4870/Talk", "narrator": "アーヤ", "text": "ただ、ほら……ね…。\nわかって、\nもらえるかしら。"},
        { "location": "4871/Talk", "narrator": "つばめ", "text": "わたしが大ピンチで\n次回に続きだなんて\nドッキドキですよね！"},
        { "location": "4872/Talk", "narrator": "つばめ", "text": "ピンチと言う割には\nちょっとおまぬけな\n感じではあるけど。"},
        { "location": "4873/Talk", "narrator": "つばめ", "text": "次回はきっとわたしの\nターンからだから\nがんばります！"},
        { "location": "4874/Talk", "narrator": "つばめ", "text": "こ、今回って前回の続き\nからなんですよね？"},
        { "location": "4875/Talk", "narrator": "ガブリエラ", "text": "変にヒネった構成でもない\n限りはそうなんじゃない？"},
        { "location": "4876/Talk", "narrator": "つばめ", "text": "ううぅ～……、\nわ、わたし、緊張して\nきちゃったよぉ～。"},
        { "location": "4877/Talk", "narrator": "ガブリエラ", "text": "……それって、\n割といつもの\nことじゃない？"},
        { "location": "4878/Talk", "narrator": "つばめ", "text": "いつもの三倍増しで\n緊張してるんだよぉ～っ！"},
        { "location": "4879/Talk", "narrator": "アーヤ", "text": "落ち着いて、つばめ。\nゆっくりと深呼吸する\nのよ。"},
        { "location": "4880/Talk", "narrator": "つばめ", "text": "すー……はーっ……。\nすー……はーっ……。\nすー……はーっ……。"},
        { "location": "4881/Talk", "narrator": "つばめ", "text": "な、なんだかいつもの\n四倍緊張してきちゃい\nました！"},
        { "location": "4882/Talk", "narrator": "みやび", "text": "何で増えちゅうが！"},
        { "location": "4883/Talk", "narrator": "つばめ", "text": "あっ、みやびさんの\nツッコミでちょっと\n落ち着いてきたかも？"},
        { "location": "4884/Talk", "narrator": "ガブリエラ", "text": "意味わかんないん\nだけど……。"},
        { "location": "4885/Talk", "narrator": "つばめ", "text": "あっ、もう大丈夫。\nお騒がせしました。\nやれます、いけます！"},
        { "location": "4886/Talk", "narrator": "アーヤ", "text": "無理はしないで\n気持ち悪くなったら、\nすぐ言うのよ？"},
        { "location": "4887/Talk", "narrator": "みやび", "text": "ここは遠足の\nバスの中かね。"},
        { "location": "4888/Talk", "narrator": "ガブリエラ", "text": "つまりアーヤは引率の\n先生ってわけね。"},
        { "location": "4889/Talk", "narrator": "つばめ", "text": "ガブちゃん、日本の\n学校の遠足事情に\n妙に詳しくない？"},
        { "location": "4890/Talk", "narrator": "ガブリエラ", "text": "そ、それ、今気にする\nことじゃないでしょ？"},
        { "location": "4891/Talk", "narrator": "つばめ", "text": "え～っ？\n気になるよぉ～？"},
        { "location": "4892/Talk", "narrator": "アーヤ", "text": "始まったわね。\n暫く集中して\n見ましょうか。"},
        { "location": "4893/Talk", "narrator": "ガブリエラ", "text": "でも、あたしらが\n黙っちゃってたら、\n意味なくない？"},
        { "location": "4894/Talk", "narrator": "つばめ", "text": "って……あれ？\n急に薄暗くなってる？\n何だか不気味かも。"},
        { "location": "4895/Talk", "narrator": "みやび", "text": "これって単に天気とかや\nなさそうやな。\n何かがおかしいちや。"},
        { "location": "4896/Talk", "narrator": "アーヤ", "text": "前回からの続きで、\n回想シーンとかでは\nないみたいよね？"},
        { "location": "4897/Talk", "narrator": "つばめ", "text": "うぅ～っ……なんか\nよくわからないけど、\n不安になる～……。"},
        { "location": "4898/Talk", "narrator": "みやび", "text": "わかった！　これは\nあれや！　異世界に\n行っちゃった系や！"},
        { "location": "4899/Talk", "narrator": "ガブリエラ", "text": "異世界って、トラックに\nはねられて転生して\nチート使えるやつ？"},
        { "location": "4900/Talk", "narrator": "みやび", "text": "それやなくて、ちくっと\n前にネットで流行ってた\nやつぞね。"},
        { "location": "4901/Talk", "narrator": "みやび", "text": "この現実と似ちゅうけんど\n違う世界に迷い込んだ\nちゅうネタ話のアレ。"},
        { "location": "4902/Talk", "narrator": "アーヤ", "text": "ああ、一時期流行った\nわね。憶えているわ。"},
        { "location": "4903/Talk", "narrator": "ガブリエラ", "text": "情報管理庁タワー！？\nいつの間にあんな物が\n出来てたわけ？"},
        { "location": "4904/Talk", "narrator": "みやび", "text": "いやもうこれ異世界\n確定やき！　まほさん\n戻って来られるんか？"},
        { "location": "4905/Talk", "narrator": "アーヤ", "text": "異世界と言うよりは\nディストピアね。\n秩序ある灰色の未来。"},
        { "location": "4906/Talk", "narrator": "つばめ", "text": "ちなみにこの世界の\n名物料理とかって\nなんなんだろ？"},
        { "location": "4907/Talk", "narrator": "ガブリエラ", "text": "食事は錠剤とかで済ませて\nそうな雰囲気よね。"},
        { "location": "4908/Talk", "narrator": "つばめ", "text": "やだやだ！　そんな\n世界だったら、わたし\n３秒といたくないよ！"},
        { "location": "4909/Talk", "narrator": "みやび", "text": "うちは色々と興味が\nあるき一ヶ月くらいは\nいてもＯＫやけんど。"},
        { "location": "4910/Talk", "narrator": "アーヤ", "text": "興味はあるけど、\n自分が行きたいとは\n微塵も思わないわね。"},
        { "location": "4911/Talk", "narrator": "ガブリエラ", "text": "て言うか、こんな所に\n行ってみたい人なんて\nみやびくらいよ。"},
        { "location": "4912/Talk", "narrator": "みやび", "text": "変人扱いは慣れちゅう\nけんど、仲間はずれは\nさびしいぞね。"},
        { "location": "4913/Talk", "narrator": "みやび", "text": "相棒は、うちと一緒に\n行ってみたいやろ？"},
        { "location": "4914/Talk", "narrator": "ガブリエラ", "text": "て言うか、これって\nフェノメノンなんじゃ\nないの？"},
        { "location": "4915/Talk", "narrator": "アーヤ", "text": "だったら館長が\n活動できているのは\nおかしいわね。"},
        { "location": "4916/Talk", "narrator": "アーヤ", "text": "だからと言って、\nただオカルト系で済ます\nわけにもいないけど。"},
        { "location": "4917/Talk", "narrator": "みやび", "text": "何ぞ理由があって\n引きずり込まれた\nちゅうことやね。"},
        { "location": "4918/Talk", "narrator": "アーヤ", "text": "もしくは、そういう\n幻影を見せられている\nということかも。"},
        { "location": "4919/Talk", "narrator": "アーヤ", "text": "得体の知れない\n何者かによって……。"},
        { "location": "4920/Talk", "narrator": "つばめ", "text": "やっぱり無理！\nわたしこういうの\n映画とかでも無理です！"},
        { "location": "4921/Talk", "narrator": "アーヤ", "text": "そう言えば、こんな\n感じの映画に見覚えが\nあったような……？"},
        { "location": "4922/Talk", "narrator": "みやび", "text": "確か１９なんちゃら\n言うのやった気が\nするなぁ？"},
        { "location": "4923/Talk", "narrator": "ガブリエラ", "text": "もしかしたらこれって\n情報管理庁の精神攻撃\nとかなのかもね。"},
        { "location": "4924/Talk", "narrator": "つばめ", "text": "うわあぁっ！？\n真幌さん！\n危なーいっ！！"},
        { "location": "4925/Talk", "narrator": "つばめ", "text": "……え？\n……あれ？\n……戻った……の？"},
        { "location": "4926/Talk", "narrator": "みやび", "text": "まほさん帰って来れて\nほんによかったなー。"},
        { "location": "4927/Talk", "narrator": "ガブリエラ", "text": "車を降りてたって\n事実は同じなのね。\nますますわかんない。"},
        { "location": "4928/Talk", "narrator": "アーヤ", "text": "幻影を見せられていた\nって説明が一番\nしっくりくるかもね。"},
        { "location": "4929/Talk", "narrator": "つばめ", "text": "それにしても、\n真幌さん赤信号なのに\n堂々としてますね。"},
        { "location": "4930/Talk", "narrator": "みやび", "text": "キャーッ！！\nキタァーッ！！\nエリカさぁーん！！"},
        { "location": "4931/Talk", "narrator": "ガブリエラ", "text": "えぇ……まさかこんな\nミーハーなみやびを\n見られるなんて……。"},
        { "location": "4932/Talk", "narrator": "つばめ", "text": "ところで、\nそのエリカさんって\n誰なんですか？"},
        { "location": "4933/Talk", "narrator": "アーヤ", "text": "あまり\n気にしなくてもいいのよ？"},
        { "location": "4934/Talk", "narrator": "みやび", "text": "おおっ！\nアーヤが姉に\n嫉妬しちゅう！"},
        { "location": "4935/Talk", "narrator": "アーヤ", "text": "そ、そういうのじゃ\nないから！"},
        { "location": "4936/Talk", "narrator": "アーヤ", "text": "全くもう。\nみやびと姉が知り合いじゃ\nなくてホントに良かった。"},
        { "location": "4937/Talk", "narrator": "ガブリエラ", "text": "でもこの急な作戦変更には\n正直驚いたわよね。"},
        { "location": "4938/Talk", "narrator": "つばめ", "text": "ストライキしろって\n話をされたと思ったら\n逃げろだもんね。"},
        { "location": "4939/Talk", "narrator": "みやび", "text": "でも車から電話してて\n変な世界に少し行って\n戻ったらこれやろ？"},
        { "location": "4940/Talk", "narrator": "みやび", "text": "異世界の空気に\nアテられたとかいう\nたぐいやろかね？"},
        { "location": "4941/Talk", "narrator": "アーヤ", "text": "もしくは、もうこの\n館長は今までとは\n違う館長……とか？"},
        { "location": "4942/Talk", "narrator": "ガブリエラ", "text": "アーヤってホントは\nそっち系の話が\n好きなんじゃない？"},
        { "location": "4943/Talk", "narrator": "アーヤ", "text": "え、ええ！？\nまさ……いえ、好きでは\nないけど怖くはないわ！"},
        { "location": "4944/Talk", "narrator": "ガブリエラ", "text": "言ってることが\nめちゃくちゃね。"},
        { "location": "4945/Talk", "narrator": "つばめ", "text": "そういえば、\nアーヤさんって\n怖がりなんでしたっけ？"},
        { "location": "4946/Talk", "narrator": "アーヤ", "text": "もうその話はいいから…。\n映像に戻りましょ？"},
        { "location": "4947/Talk", "narrator": "アーヤ", "text": "それにしても、籠城戦の\n準備をしていたのが途端に\n逃亡準備になるなんてね。"},
        { "location": "4948/Talk", "narrator": "つばめ", "text": "ところでコード０２０\n０５って、どういう\n意味でしたっけ？"},
        { "location": "4949/Talk", "narrator": "ガブリエラ", "text": "今さらそれ聞く！？\n……もしかしてわからな\nいのに使ってたの？"},
        { "location": "4950/Talk", "narrator": "つばめ", "text": "と、とりあえず、緊急\n事態なんだなーっての\nはわかったから……。"},
        { "location": "4951/Talk", "narrator": "つばめ", "text": "ところで正解の発表は\nしないんですか？"},
        { "location": "4952/Talk", "narrator": "みやび", "text": "まぁ、雰囲気物やし、\n解答は各自の胸の中に\nあるちゅうことで。"},
        { "location": "4953/Talk", "narrator": "アーヤ", "text": "べつに隠すほどのことでも\nないのだけれど……。"},
        { "location": "4954/Talk", "narrator": "みやび", "text": "きっと設定資料集とか\n出たら載ってるから\n必ず買うんやよ？"},
        { "location": "4955/Talk", "narrator": "ガブリエラ", "text": "うわぁ、久々にえげつない\nみやびを見たわ……。"},
        { "location": "4956/Talk", "narrator": "みやび", "text": "しかし、お役所仕事ぉ\n言うのに、こういう時\nだけは爆速なんね。"},
        { "location": "4957/Talk", "narrator": "ガブリエラ", "text": "きっと普段の鬱憤が\n溜まってたんじゃない？"},
        { "location": "4958/Talk", "narrator": "ガブリエラ", "text": "例えば、後ろ向きで\n整列しなきゃいけない\nストレスとか。"},
        { "location": "4959/Talk", "narrator": "アーヤ", "text": "この時はつばめに悪い\n事したわ。クランの\n誘導って大変よね。"},
        { "location": "4960/Talk", "narrator": "つばめ", "text": "クランを地下室に\n連れて行ってどうする\nんでしたっけ？"},
        { "location": "4961/Talk", "narrator": "みやび", "text": "クランは地下室で\nサーバーにアーカイブ\nするんや。"},
        { "location": "4962/Talk", "narrator": "つばめ", "text": "んー？　クランって\nデータ？　とかなの？"},
        { "location": "4963/Talk", "narrator": "ガブリエラ", "text": "今さら何言ってんの？\nとか言いつつあたしも\n忘れてたけどさ。"},
        { "location": "4964/Talk", "narrator": "つばめ", "text": "ところで、研修生なのに\n先行させるって、ちょっと\n危なくないですか？"},
        { "location": "4965/Talk", "narrator": "みやび", "text": "危ないどころか\n死亡フラグが\n立っちゅうぞね。"},
        { "location": "4966/Talk", "narrator": "ガブリエラ", "text": "え、縁起でもないこと\n言わないでよっ！！"},
        { "location": "4967/Talk", "narrator": "アーヤ", "text": "ここのつばめがとても\n可愛くて、お持ち帰り\nしたいわぁ……。"},
        { "location": "4968/Talk", "narrator": "ガブリエラ", "text": "アーヤ……そういう\n本音は外に漏らさない\nでちょうだい……。"},
        { "location": "4969/Talk", "narrator": "みやび", "text": "このつばめちゃんの\nフィギュア作ったら\n需要ありそうやな。"},
        { "location": "4970/Talk", "narrator": "アーヤ", "text": "とりあえず１０個\n予約するわ！"},
        { "location": "4971/Talk", "narrator": "ガブリエラ", "text": "はいはい、地味に\nリアリティのある発言は\n控えてくださーい！"},
        { "location": "4972/Talk", "narrator": "つばめ", "text": "またあの白い子だ！\nこの子ホントに\n何なんだろ？"},
        { "location": "4973/Talk", "narrator": "みやび", "text": "ホントはエリカさんに\nついて、もっと語りた\nかったんやけどな。"},
        { "location": "4974/Talk", "narrator": "みやび", "text": "アーヤの視線がちくっと\n刺さるき、今回は見送りに\nしたぞね。"},
        { "location": "4975/Talk", "narrator": "みやび", "text": "まぁ、そんな面倒臭さ\nが実にアーヤらしいん\nやけどな。"}
    ]
}
