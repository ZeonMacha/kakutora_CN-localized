{
    "dir": "stream_240_ch01.json",
    "type": "watchanime",
    "info": {
    },
    "entry":
    [
        { "location": "4729/Talk", "narrator": "アーヤ", "text": "安心してギャヴィ。\nマスコット度なら\n負けてないわよ。"},
        { "location": "4730/Talk", "narrator": "ガブリエラ", "text": "そんなこといきなり\n言われても逆に\n困るんだけど！？"},
        { "location": "4731/Talk", "narrator": "みやび", "text": "アーヤ、八方美人は\nあかんよ～。"},
        { "location": "4732/Talk", "narrator": "ガブリエラ", "text": "でも意外とアーヤも\nポンコツな所が\nあるわよね？"},
        { "location": "4733/Talk", "narrator": "アーヤ", "text": "そ、そうかしら？"},
        { "location": "4734/Talk", "narrator": "つばめ", "text": "じゃあわたしは\nポンコツ未満の\nガラクタなの！？"},
        { "location": "4735/Talk", "narrator": "つばめ", "text": "何が勿論\nなんですかぁ！？"},
        { "location": "4736/Talk", "narrator": "ガブリエラ", "text": "まぁ、そういう\n趣味ってこと\nなんじゃない？"},
        { "location": "4737/Talk", "narrator": "つばめ", "text": "そんな趣味は今すぐ\nやめましょうよ？"},
        { "location": "4738/Talk", "narrator": "みやび", "text": "つばめちゃん、意外と\n無茶振りするんやね。"},
        { "location": "4739/Talk", "narrator": "アーヤ", "text": "さすがね。あなたなら\nそう言ってくれると\n思ってたわ。"},
        { "location": "4740/Talk", "narrator": "ガブリエラ", "text": "何で通じ合ってるの、\nそこ！？"},
        { "location": "4741/Talk", "narrator": "みやび", "text": "アーヤはもう\n色々と手遅れかも\n知れんね……。"},
        { "location": "4742/Talk", "narrator": "アーヤ", "text": "少し困ったわね。\nつばめは気にすること\nなんてないのに。"},
        { "location": "4743/Talk", "narrator": "アーヤ", "text": "適材適所。つばめには\nつばめが輝ける時が\n必ずあるのだから。"},
        { "location": "4744/Talk", "narrator": "アーヤ", "text": "でも悩ましいことに\n落ち込んだつばめも\n可愛いのよね……。"},
        { "location": "4745/Talk", "narrator": "みやび", "text": "ほんにアーヤは\nつばめちゃんに\n甘いんやきねぇ。"},
        { "location": "4746/Talk", "narrator": "みやび", "text": "うちのことも\nもう少しは可愛がって\nくれんかね？"},
        { "location": "4747/Talk", "narrator": "みやび", "text": "今度アーヤの前で\nつばめちゃんの\n真似してみよか？"},
        { "location": "4748/Talk", "narrator": "ガブリエラ", "text": "まぁ、今回は\n考察好きへのサービス\nみたいなものよ。"},
        { "location": "4749/Talk", "narrator": "ガブリエラ", "text": "あとは、まぁ、あんな\n神楽でもにぎやかし\nにはなってたのねと。"},
        { "location": "4750/Talk", "narrator": "ガブリエラ", "text": "ボケが少ないとあたし\nとしてもツッコミがい\nがなくてさびしいわ。"},
        { "location": "4751/Talk", "narrator": "つばめ", "text": "えーと、最初にちゃんと\n言っておきます。"},
        { "location": "4752/Talk", "narrator": "つばめ", "text": "ごめんなさい。\n今回、神楽ちゃんは\nお休みです。"},
        { "location": "4753/Talk", "narrator": "ガブリエラ", "text": "今回はって言うか\nいつ来られるか\nわかんないけど。"},
        { "location": "4754/Talk", "narrator": "つばめ", "text": "で、でも、きっと、\nううん、絶対、\n帰って来るから！"},
        { "location": "4755/Talk", "narrator": "みやび", "text": "ちゅうか、あの卯月が\n簡単につばめのことを\n諦めるとは思えんち。"},
        { "location": "4756/Talk", "narrator": "つばめ", "text": "そのあたりはむしろ\n諦めて欲しかったり\n欲しくなかったり。"},
        { "location": "4757/Talk", "narrator": "ガブリエラ", "text": "そういう中途半端な\n態度がストーカーには\n一番よくないのよ？"},
        { "location": "4758/Talk", "narrator": "つばめ", "text": "あの、さすがにストーカー\nは言い過ぎじゃ……。"},
        { "location": "4759/Talk", "narrator": "アーヤ", "text": "そうね。同じような\nものだからと言っても\nイコールではないわ。"},
        { "location": "4760/Talk", "narrator": "つばめ", "text": "アーヤさん、それも地味に\n辛辣です！"},
        { "location": "4761/Talk", "narrator": "ガブリエラ", "text": "まったく、本人が\nいないのをいいことに\n言いたい放題よね。"},
        { "location": "4762/Talk", "narrator": "つばめ", "text": "えっ……それをガブちゃん\nが言っちゃうの？"},
        { "location": "4763/Talk", "narrator": "ガブリエラ", "text": "あたしは本人が目の前に\nいたって言うから！"},
        { "location": "4764/Talk", "narrator": "つばめ", "text": "それはそれで\nどうなのかなぁ……。"},
        { "location": "4765/Talk", "narrator": "アーヤ", "text": "さぁ、そろそろ始まる\nわよ。覚悟はいい？"},
        { "location": "4766/Talk", "narrator": "みやび", "text": "今回そんなしんどい\n内容やったっけ？"},
        { "location": "4767/Talk", "narrator": "ガブリエラ", "text": "あたしたちがコメントに\n困る回ではあると思うわ。"},
        { "location": "4768/Talk", "narrator": "つばめ", "text": "でも神楽ちゃんの分も\nがんばりますっ！"},
        { "location": "4769/Talk", "narrator": "つばめ", "text": "ということで早速です\nけど、このシーン、\nどう思いますか？"},
        { "location": "4770/Talk", "narrator": "アーヤ", "text": "ヘリが情報管理庁の物な\nのは疑いようがないわ。"},
        { "location": "4771/Talk", "narrator": "みやび", "text": "そんでフェノメノンを\n突き破って\n世界を繋げるなんて"},
        { "location": "4772/Talk", "narrator": "みやび", "text": "ネトゲで言うたら\nゲームマスターにしか\n出来ないことやき。"},
        { "location": "4773/Talk", "narrator": "ガブリエラ", "text": "管理庁は黒。\nもうその疑いは\n晴れっこないわ。"},
        { "location": "4774/Talk", "narrator": "つばめ", "text": "あれ？　なんか今回\nみんなすっごく\n真面目考察モード！？"},
        { "location": "4775/Talk", "narrator": "ガブリエラ", "text": "まほがこんなに真剣な\n顔するなんて珍しいし\n察しなさいよ。"},
        { "location": "4776/Talk", "narrator": "みやび", "text": "まほさんは昔戦場に\nいたらしいから、\nハナが効くんよね。"},
        { "location": "4777/Talk", "narrator": "みやび", "text": "だからまほさんが\nダラ～っとしてる時は\n全然大丈夫やし、"},
        { "location": "4778/Talk", "narrator": "みやび", "text": "キビキビ働いちょる\n時は要注意。アラート\nみたいなもんやき。"},
        { "location": "4779/Talk", "narrator": "みやび", "text": "んで、うちらも珍しく\n真面目な集まりを\nしてるちゅう流れや。"},
        { "location": "4780/Talk", "narrator": "アーヤ", "text": "ここでつばめが\n声を荒げたのも\n分からなくはないわ。"},
        { "location": "4781/Talk", "narrator": "アーヤ", "text": "でもそれは私たちが\nつばめの視点で\n見てきたものを"},
        { "location": "4782/Talk", "narrator": "アーヤ", "text": "共有してきたからで\nあって、映像の中の\n私たちには難しいわ。"},
        { "location": "4783/Talk", "narrator": "みやび", "text": "正に、今だから語れる\nちゅうやつやね。"},
        { "location": "4784/Talk", "narrator": "ガブリエラ", "text": "メタフィクションが\n入り混じるとまた考察\n好きが混乱するわよ。"},
        { "location": "4785/Talk", "narrator": "みやび", "text": "混乱するんが快感なんやき\n気にせんでええよ。"},
        { "location": "4786/Talk", "narrator": "つばめ", "text": "あっ、はい、わたし\nそれ知ってます！\nＭな人ですよね？"},
        { "location": "4787/Talk", "narrator": "アーヤ", "text": "つばめ、人の趣味は\n千差万別よ。決めつけ\nはよくないわ。"},
        { "location": "4788/Talk", "narrator": "ガブリエラ", "text": "ところでここのアーヤ\n地味に静かに深く\n本気で怒ってない？"},
        { "location": "4789/Talk", "narrator": "アーヤ", "text": "ええ、当然よ。\nつばめを蹂躙した\n罪だけは許せないわ。"},
        { "location": "4790/Talk", "narrator": "みやび", "text": "こら卯月がもし復帰\nしても一悶着ありそう\nな雰囲気やなぁ。"},
        { "location": "4791/Talk", "narrator": "アーヤ", "text": "こら、みやび！\n変な期待はしないの！"},
        { "location": "4792/Talk", "narrator": "ガブリエラ", "text": "ところでこのみやびの\n決めつけってどうなの？"},
        { "location": "4793/Talk", "narrator": "アーヤ", "text": "確かに現状では\n管理庁が黒幕という\n可能性が高いけど、"},
        { "location": "4794/Talk", "narrator": "アーヤ", "text": "もしかしたらそれは\nそう思わせるための\n作戦かも知れないわ。"},
        { "location": "4795/Talk", "narrator": "ガブリエラ", "text": "確かにこの映像だって\n管理庁を悪者っぽく\n編集してるのかもね。"},
        { "location": "4796/Talk", "narrator": "みやび", "text": "実際、映像による\n情報操作ちゅうんは\n一番簡単やき。"},
        { "location": "4797/Talk", "narrator": "みやび", "text": "インタビューとかでも\n都合のいい所だけを\n切り取って編集すれば"},
        { "location": "4798/Talk", "narrator": "みやび", "text": "全く正反対の内容にも\n出来たりするんやき。"},
        { "location": "4799/Talk", "narrator": "ガブリエラ", "text": "プロパガンダ映像って\nそうやって作られたり\nするのよね。"},
        { "location": "4800/Talk", "narrator": "みやび", "text": "編集者が扇動者に\nなりうる危険を映像は\n常に孕んどるわけや。"},
        { "location": "4801/Talk", "narrator": "つばめ", "text": "うぅ……映像の空気が\n重過ぎてコメント\nしづらいよぉ……。"},
        { "location": "4802/Talk", "narrator": "みやび", "text": "ここらでつばめちゃん\n渾身の一発ギャグを\n決めてもええんよ？"},
        { "location": "4803/Talk", "narrator": "つばめ", "text": "みやびさん、さすがに\nそれは無茶振り過ぎ。"},
        { "location": "4804/Talk", "narrator": "ガブリエラ", "text": "あれ？\nこの歌って何だったっけ？\n聞いた憶えが……。"},
        { "location": "4805/Talk", "narrator": "つばめ", "text": "これはメノウちゃんの\n唄だよ！"},
        { "location": "4806/Talk", "narrator": "つばめ", "text": "でもどうして\n音羽さんが……。"},
        { "location": "4807/Talk", "narrator": "つばめ", "text": "あっ！　音羽さんも\nメノウちゃんの\nファンだったからか！"},
        { "location": "4808/Talk", "narrator": "みやび", "text": "発症者情報によれば\n音羽は元々\n卯月の友達やき。"},
        { "location": "4809/Talk", "narrator": "みやび", "text": "もしかしたら\nこの唄とも何か縁が\nあるのかも知れんね。"},
        { "location": "4810/Talk", "narrator": "つばめ", "text": "みやびさん、\nちょっと待った！"},
        { "location": "4811/Talk", "narrator": "つばめ", "text": "その神楽ちゃんと\n音羽さんとの関係に\nついて詳しく！"},
        { "location": "4812/Talk", "narrator": "みやび", "text": "意外に強い食いつきに\nうちがびっくりや。"},
        { "location": "4813/Talk", "narrator": "つばめ", "text": "詳しく～っ！！"},
        { "location": "4814/Talk", "narrator": "ガブリエラ", "text": "つばめ、さすがに\nがっつき過ぎ……。"},
        { "location": "4815/Talk", "narrator": "みやび", "text": "ここ、リーダーは\n感情優先で動けんきに\nつらいやねぇ。"},
        { "location": "4816/Talk", "narrator": "アーヤ", "text": "そうでもないわよ？\n私もまだまだ未熟者\nだから。"},
        { "location": "4817/Talk", "narrator": "つばめ", "text": "アーヤさんが\n未熟者だったらわたし\nなんて一体……。"},
        { "location": "4818/Talk", "narrator": "アーヤ", "text": "何であれ、つばめは\n可愛いから心配は\n要らないわ。"},
        { "location": "4819/Talk", "narrator": "つばめ", "text": "そうですか？\nこれでいいんですね。\nえへへっ♪"},
        { "location": "4820/Talk", "narrator": "ガブリエラ", "text": "いいわけが\nないでしょ……。"},
        { "location": "4821/Talk", "narrator": "つばめ", "text": "ところで、この映像は\nなんなんですか？"},
        { "location": "4822/Talk", "narrator": "ガブリエラ", "text": "これってアーヤが\n一人で戦った最初の\nフェノメノンでしょ？"},
        { "location": "4823/Talk", "narrator": "アーヤ", "text": "ええ、焼夷弾が\nばらまかれた時ね。"},
        { "location": "4824/Talk", "narrator": "アーヤ", "text": "あの時は本気で\nトライナリーになった\nことを後悔したわ。"},
        { "location": "4825/Talk", "narrator": "みやび", "text": "これは意図的な編集で\n無駄に危機感を煽っ\nちょる映像やけどね。"},
        { "location": "4826/Talk", "narrator": "みやび", "text": "しっかしアーヤの\n姉嫌いは徹底しとる。\nこれ本気なん？"},
        { "location": "4827/Talk", "narrator": "アーヤ", "text": "答える気にもならない\nから、好きに想像して\nもらって構わないわ。"},
        { "location": "4828/Talk", "narrator": "みやび", "text": "うわ、これは取り付く\n島なし言うよりは\n最早地雷やね。"},
        { "location": "4829/Talk", "narrator": "アーヤ", "text": "でもみやびがこんなに\n慌てた顔をするなんて\n珍しいわね。"},
        { "location": "4830/Talk", "narrator": "みやび", "text": "何やうちの隠れた\n魅力に気づいて\n惚れ直したん？"},
        { "location": "4831/Talk", "narrator": "アーヤ", "text": "……ご想像に\nお任せするわ。"},
        { "location": "4832/Talk", "narrator": "みやび", "text": "うわ、うちのボケに\n乗っかってくれんとか\nつらいわぁ～。"},
        { "location": "4833/Talk", "narrator": "みやび", "text": "閑話休題やけどココの\nシーンだけ切り取って"},
        { "location": "4834/Talk", "narrator": "みやび", "text": "音を全部なくすと\nあら不思議！"},
        { "location": "4835/Talk", "narrator": "みやび", "text": "つばめちゃんが音羽に\nキスを迫ってるように\n見える！"},
        { "location": "4836/Talk", "narrator": "みやび", "text": "さぁ、みんなも今すぐ\nやってみよう！"},
        { "location": "4837/Talk", "narrator": "つばめ", "text": "や、やらなくて\nいいですってば！"},
        { "location": "4838/Talk", "narrator": "アーヤ", "text": "ええ、それに何だか\n不思議と\nムカムカするわ。"},
        { "location": "4839/Talk", "narrator": "ガブリエラ", "text": "アーヤ……。"},
        { "location": "4840/Talk", "narrator": "みやび", "text": "てなわけで、\nキミはやってみたん？"},
        { "location": "4841/Talk", "narrator": "みやび", "text": "まぁ、そんなわけで\n脇道それた無駄話は\nここまでや。"},
        { "location": "4842/Talk", "narrator": "ガブリエラ", "text": "そらしたのは\nみやびだけどね……。"},
        { "location": "4843/Talk", "narrator": "ガブリエラ", "text": "でもいよいよここから\nあたしたちの反撃開始\nってわけよね。"},
        { "location": "4844/Talk", "narrator": "つばめ", "text": "うん、次回はホントに\n先が読めなくて\nドキドキだよ～。"},
        { "location": "4845/Talk", "narrator": "つばめ", "text": "はぁ……今回は\n頑張ろうと思ったのに\n全然喋れなかった。"},
        { "location": "4846/Talk", "narrator": "つばめ", "text": "ていうか、みんな急に\n真面目過ぎだよ～。\nついて行けないよ～。"},
        { "location": "4847/Talk", "narrator": "つばめ", "text": "うぅっ……次回も\nなんだか大変そうで\nどうしよう……。"}
    ]
}
