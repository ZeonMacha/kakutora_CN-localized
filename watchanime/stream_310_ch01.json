{
    "dir": "stream_310_ch01.json",
    "type": "watchanime",
    "info": {
    },
    "entry":
    [
        { "location": "6157/Talk", "narrator": "ガブリエラ", "text": "いつから学園ラブコメ\n路線だったの！？"},
        { "location": "6158/Talk", "narrator": "みやび", "text": "いつから学園ラブコメ\nでないと錯覚し──"},
        { "location": "6159/Talk", "narrator": "アーヤ", "text": "はい、ストップ。\nまた配信中止の危機に\n向かおうとしないで。"},
        { "location": "6160/Talk", "narrator": "つばめ", "text": "んー……それだと\nもしかしてわたし、\n攻略される側？"},
        { "location": "6161/Talk", "narrator": "ガブリエラ", "text": "疑問抱くの\nそこなんだ……。"},
        { "location": "6162/Talk", "narrator": "ガブリエラ", "text": "それはアーヤの方が\n合ってるんじゃない？\n武器が刀だし。"},
        { "location": "6163/Talk", "narrator": "みやび", "text": "黒セーラー服も似合い\nそうやけど問題なんは\n歳が……。"},
        { "location": "6164/Talk", "narrator": "アーヤ", "text": "みやびが高校生で\n通ってるのだから\n問題無いわね。"},
        { "location": "6165/Talk", "narrator": "みやび", "text": "歳の判断基準に\n精神的に枯れちょるかは\n関係ないから！"},
        { "location": "6166/Talk", "narrator": "みやび", "text": "つまり、この\nつばめちゃんも……。"},
        { "location": "6167/Talk", "narrator": "つばめ", "text": "ストップ！\nそれ以上いけない。\n禁則事項です！"},
        { "location": "6168/Talk", "narrator": "ガブリエラ", "text": "むしろマズいこと\n口走ってるのは\nアンタだから！"},
        { "location": "6169/Talk", "narrator": "アーヤ", "text": "……今度の検診で私も\n試してみようかしら。"},
        { "location": "6170/Talk", "narrator": "みやび", "text": "履いてなければ透ける心配も\n無用やき！"},
        { "location": "6171/Talk", "narrator": "アーヤ", "text": "色んな意味で別の心配が\n増えるけど……。"},
        { "location": "6172/Talk", "narrator": "ガブリエラ", "text": "ついでに脳も診てもらえば\nいいんじゃない？"},
        { "location": "6173/Talk", "narrator": "つばめ", "text": "あの……、どういう\n流れなんですか、\nこれ……。"},
        { "location": "6174/Talk", "narrator": "アーヤ", "text": "どちらにせよいよいよ\n次から大きく話が\n動きそうね。"},
        { "location": "6175/Talk", "narrator": "アーヤ", "text": "期待に応えられるよう\n今まで以上に\n頑張るつもりよ。"},
        { "location": "6176/Talk", "narrator": "アーヤ", "text": "えっ？　へ、変な期待\nには、ちょっと\n応えられないかも……"},
        { "location": "6177/Talk", "narrator": "ガブリエラ", "text": "ていうか、いい加減\n体動かしたいのよね。"},
        { "location": "6178/Talk", "narrator": "ガブリエラ", "text": "え？　あたしと映像の\n中のあたしは別人？\n……メタツッコミね。"},
        { "location": "6179/Talk", "narrator": "ガブリエラ", "text": "アクション映画を見て\nスカッとしたいのと\n同じようなものよ。"},
        { "location": "6180/Talk", "narrator": "つばめ", "text": "なんかみんなだけ\n盛り上がってて\nやっばり蚊帳の外……"},
        { "location": "6181/Talk", "narrator": "つばめ", "text": "わたし主役ですよね？\n前にも聞いたけど\n本当に主役ですよね？"},
        { "location": "6182/Talk", "narrator": "つばめ", "text": "次回こそ主役ビーム\nとか撃てたりします？\nしますよね？"},
        { "location": "6183/Talk", "narrator": "神楽", "text": "あのー……教会で\n待ってたのに誰も\n来ないんですけどー。"},
        { "location": "6184/Talk", "narrator": "神楽", "text": "これってイジメ？\n私、ハブられてる？\nむしろマングース？"},
        { "location": "6185/Talk", "narrator": "神楽", "text": "こうなったら次回こそ\n絶対につばめさんとの\n結婚式を……。"},
        { "location": "6186/Talk", "narrator": "神楽", "text": "画面の前の\nよい子のみんなー、\nおっ待たせーっ♪"},
        { "location": "6187/Talk", "narrator": "ガブリエラ", "text": "……それ、前回も\nやってなかった？"},
        { "location": "6188/Talk", "narrator": "神楽", "text": "前回のは、みやびさん\nですよ。そして今回は\n私！　そう、私です！"},
        { "location": "6189/Talk", "narrator": "ガブリエラ", "text": "そういえば卯月が\nいきなり出て来るとか\nおかしいわね。"},
        { "location": "6190/Talk", "narrator": "ガブリエラ", "text": "ていうか、そこ、\nつばめの定位置じゃ\nなかった？"},
        { "location": "6191/Talk", "narrator": "神楽", "text": "はい！　正に今、私は\nつばめさんの残り香に\n包まれて、あぁ……。"},
        { "location": "6192/Talk", "narrator": "ガブリエラ", "text": "すみません。\nここに変態がいるので\n捕獲してください。"},
        { "location": "6193/Talk", "narrator": "神楽", "text": "猟友会に通報しないで\nくださいっ！"},
        { "location": "6194/Talk", "narrator": "みやび", "text": "なんや今日は\nうちが出る前から\n騒がしなぁ。"},
        { "location": "6195/Talk", "narrator": "アーヤ", "text": "にぎやかしの自覚は\nあったわけね。"},
        { "location": "6196/Talk", "narrator": "みやび", "text": "酷いっ！\nうちのこと\n芸人枠やなんて！"},
        { "location": "6197/Talk", "narrator": "アーヤ", "text": "思ってはいたけれど\n口に出しては\nいないでしょ？"},
        { "location": "6198/Talk", "narrator": "ガブリエラ", "text": "出してる、出してる。"},
        { "location": "6199/Talk", "narrator": "神楽", "text": "というわけで、\nつばめさんは監禁、いえ、\n控えてもらってるので"},
        { "location": "6200/Talk", "narrator": "神楽", "text": "まずは私たちで\nこの場を盛り上げて\nいきましょーっ♪"},
        { "location": "6201/Talk", "narrator": "ガブリエラ", "text": "なんだろう……、\nイヤな予感しか\nしないんだけど……。"},
        { "location": "6202/Talk", "narrator": "アーヤ", "text": "毎回そんな感じでは\nあるのだけれど。"},
        { "location": "6203/Talk", "narrator": "神楽", "text": "それでは本編、\nスタートぉ～♪"},
        { "location": "6204/Talk", "narrator": "ガブリエラ", "text": "つばめの力の源が\n卯月の歌ってトコからの\n続きだっけ？"},
        { "location": "6205/Talk", "narrator": "みやび", "text": "その歌のお陰で\n今の「この現実」が\nあるちゅうわけや。"},
        { "location": "6206/Talk", "narrator": "アーヤ", "text": "特殊なわけじゃなくて\nつばめにとって特別な\n歌だったってことね。"},
        { "location": "6207/Talk", "narrator": "アーヤ", "text": "その大きな支えだった\n歌が今は千羽鶴に悪用\nされようとしてると。"},
        { "location": "6208/Talk", "narrator": "ガブリエラ", "text": "神楽の歌がつばめの\nココロを鷲掴みにして\nいたってこと？"},
        { "location": "6209/Talk", "narrator": "アーヤ", "text": "自分が好きな音楽は\n永く心の中に残るから\n気持ちはわかるわ。"},
        { "location": "6210/Talk", "narrator": "みやび", "text": "メノウの曲は世界観\n込みやから現実逃避\nにはもってこいやき。"},
        { "location": "6211/Talk", "narrator": "アーヤ", "text": "辛い現実から妄想へと\n逃避して生きるには\n最高のコンテンツね。"},
        { "location": "6212/Talk", "narrator": "ガブリエラ", "text": "つばめにこの平和な\n「現実」という名の\nフェノメノンを――"},
        { "location": "6213/Talk", "narrator": "ガブリエラ", "text": "作らせるに至った\nメノウの曲のパワーは\nすごいわね。"},
        { "location": "6214/Talk", "narrator": "神楽", "text": "そうそう、だから\nつばめと卯月の二人は\nもう結婚しちゃえよ！"},
        { "location": "6215/Talk", "narrator": "ガブリエラ", "text": "自分で言うな！"},
        { "location": "6216/Talk", "narrator": "アーヤ", "text": "でも本当の黒幕以上に\n強烈な洗脳をしていた\nとも言えるわけね。"},
        { "location": "6217/Talk", "narrator": "みやび", "text": "ここから洗脳されて\n敵として出て来るいう\nのがお約束やけんど。"},
        { "location": "6218/Talk", "narrator": "ガブリエラ", "text": "つばめのフェノメノン\n世界なんだから、\nなるわけ無いわよね。"},
        { "location": "6219/Talk", "narrator": "アーヤ", "text": "でもつばめ自身が\nそれを望むのなら\nあり得るわよ？"},
        { "location": "6220/Talk", "narrator": "みやび", "text": "つばめちゃん！\nうちらズッ友の誓いを\n交わしたよね！？"},
        { "location": "6221/Talk", "narrator": "神楽", "text": "私なんてもう婚姻届も\n用意してますよ！"},
        { "location": "6222/Talk", "narrator": "ガブリエラ", "text": "卯月はもう教会にでも\n行ってて！\nはい、つばめと交代！"},
        { "location": "6223/Talk", "narrator": "つばめ", "text": "ていうか、わたし\nディスられまくって\nなかった！？"},
        { "location": "6224/Talk", "narrator": "アーヤ", "text": "気のせいよ、つばめ。\nする必要が無いし、\nする気も無いわ。"},
        { "location": "6225/Talk", "narrator": "みやび", "text": "それにしても、あん時\nそんな世界の危機的な\n状況やったんやな。"},
        { "location": "6226/Talk", "narrator": "みやび", "text": "ただの水着サービス回\nやと油断しちょった。"},
        { "location": "6227/Talk", "narrator": "アーヤ", "text": "館長が視たあの殺伐と\nした世界に、どうして\nしたいのかしらね。"},
        { "location": "6228/Talk", "narrator": "みやび", "text": "正に価値観の相違いう\nやつで、あれこそ理想\nの秩序やも知れんし。"},
        { "location": "6229/Talk", "narrator": "アーヤ", "text": "それにしても、あの世界を\n見て思うんだけど、今の\n世界ってかなり普通よね。"},
        { "location": "6230/Talk", "narrator": "ガブリエラ", "text": "確かにフェノメノンだって\nことを考えると、つばめの\n世界なのに普通よね。"},
        { "location": "6231/Talk", "narrator": "つばめ", "text": "わ、わたしの世界なのに\nって、また酷いこと言わ\nれてない？"},
        { "location": "6232/Talk", "narrator": "ガブリエラ", "text": "だって、普段のつばめを\n見ていれば……うーん、\nどうなるのかしら。"},
        { "location": "6233/Talk", "narrator": "つばめ", "text": "わたしだったら、争いの\n無い、みんな幸せな世界\nがいいなぁ。"},
        { "location": "6234/Talk", "narrator": "ガブリエラ", "text": "千羽鶴の作り出したい\n世界ってあの独裁政権\nみたいな世界？"},
        { "location": "6235/Talk", "narrator": "みやび", "text": "ガブちゃんストップ。\nフィクションで政治的\n思想話は危険や。"},
        { "location": "6236/Talk", "narrator": "ガブリエラ", "text": "つばめフェノメノンと\nメタな話とで、もう\nわけわかんない……。"},
        { "location": "6237/Talk", "narrator": "ガブリエラ", "text": "ところで新しい世界に\n全て書き換わるってことは\nもしかしてあたしたち――"},
        { "location": "6238/Talk", "narrator": "ガブリエラ", "text": "既につばめに\nキャラメイクされてる\n可能性があるわけ？"},
        { "location": "6239/Talk", "narrator": "アーヤ", "text": "ええ、本当の自分との\n違いがどの程度なのか\n気になるわね。"},
        { "location": "6240/Talk", "narrator": "みやび", "text": "ここは前向きに、\n次はどういう設定にして\n欲しいか考えてみよ。"},
        { "location": "6241/Talk", "narrator": "みやび", "text": "ちなみにうちは次回は\nモブＡでおなしゃす。\n痛いのはナシで。"},
        { "location": "6242/Talk", "narrator": "ガブリエラ", "text": "あたしはお姫様ね。\n白くて大きなお城に\n住んでるの。"},
        { "location": "6243/Talk", "narrator": "アーヤ", "text": "私は……うーん……\n何がいいかしら……。\nいざとなると迷うわ。"},
        { "location": "6244/Talk", "narrator": "つばめ", "text": "あの～、わたしの希望と\nいうか設定はどうすれば？"},
        { "location": "6245/Talk", "narrator": "ガブリエラ", "text": "とりあえず、そっちのヤツ\nに希望でも聞いてみたら？"},
        { "location": "6246/Talk", "narrator": "ガブリエラ", "text": "そういえば、\nなんで音羽は\n否定できるわけ？"},
        { "location": "6247/Talk", "narrator": "みやび", "text": "そらあれや。\n卯月の前夫なわけやし。"},
        { "location": "6248/Talk", "narrator": "アーヤ", "text": "……歌を止める音羽と\n歌って欲しいつばめとの\n愛憎のバトル？"},
        { "location": "6249/Talk", "narrator": "つばめ", "text": "アーヤさん、真面目な顔で\nボケないでください！"},
        { "location": "6250/Talk", "narrator": "みやび", "text": "あ、まほさんの総括で\nついて来られんかった\n人もこれで安心や。"},
        { "location": "6251/Talk", "narrator": "ガブリエラ", "text": "なんか、これでやっと\n話が先に進むって感じね。"},
        { "location": "6252/Talk", "narrator": "みやび", "text": "ずっと部屋で話し込んでる\n展開いうのも限度があるき\nに。"},
        { "location": "6253/Talk", "narrator": "つばめ", "text": "やっとわたしが活躍できる\nシーンがくるってこと！？"},
        { "location": "6254/Talk", "narrator": "みやび", "text": "つばめちゃんはもうちっと\n座って待っときや。"},
        { "location": "6255/Talk", "narrator": "つばめ", "text": "わたしここ数話ずっと\nそれですよね！？"},
        { "location": "6256/Talk", "narrator": "ガブリエラ", "text": "いいじゃないの。\nつばめは囚われの\nお姫様役ってことで。"},
        { "location": "6257/Talk", "narrator": "つばめ", "text": "ガブちゃん、この役\n代わってあげるよ？\nほらお姫様だし。"},
        { "location": "6258/Talk", "narrator": "みやび", "text": "ていうか、この辺、\n説明口調で反復し過ぎ\nやない？"},
        { "location": "6259/Talk", "narrator": "アーヤ", "text": "それだけ重要な\nシーンってことね。\n今後の展開上で。"},
        { "location": "6260/Talk", "narrator": "つばめ", "text": "アーヤさん、身も蓋も無く\nメタ過ぎです！"},
        { "location": "6261/Talk", "narrator": "ガブリエラ", "text": "とりあえずこれは、\n細けぇことはいいんだよ\nって流れ？"},
        { "location": "6262/Talk", "narrator": "つばめ", "text": "わたしとしても\n細かいことはいいから\nわたしの活躍を……。"},
        { "location": "6263/Talk", "narrator": "つばめ", "text": "って、どんどんわたし\nだけ蚊帳の外感が\n加速してる気が！？"},
        { "location": "6264/Talk", "narrator": "アーヤ", "text": "つばめはお姫様らしく\n待っててちょうだい。\n必ず助け出すから。"},
        { "location": "6265/Talk", "narrator": "みやび", "text": "と王子様も言うちょるき、\n慌てない慌てない。"},
        { "location": "6266/Talk", "narrator": "みやび", "text": "って、ちょい待った！\nつばめちゃんの着替え\nシーンとばされとる！"},
        { "location": "6267/Talk", "narrator": "ガブリエラ", "text": "検診衣の下って\nパンツ一枚だけ\nなんだっけ？"},
        { "location": "6268/Talk", "narrator": "つばめ", "text": "そんなことより\nわたしの置かれた状況\nに注目して……。"},
        { "location": "6269/Talk", "narrator": "アーヤ", "text": "つばめの脱いだ服が\n悪用されていないかが\n心配ね……。"},
        { "location": "6270/Talk", "narrator": "つばめ", "text": "だからアーヤさんまで\n真面目な顔でボケに\n乗らないでください！"},
        { "location": "6271/Talk", "narrator": "ガブリエラ", "text": "つばめが卯月の心配\nばかりしてるのが\n妬けるんじゃない？"},
        { "location": "6272/Talk", "narrator": "アーヤ", "text": "ギャヴィ、誤解よ。\nつばめ×卯月\nも私としてはアリだから。"},
        { "location": "6273/Talk", "narrator": "つばめ", "text": "もしかしてボケじゃ\nなかったらどうしよう\nという恐怖が……。"},
        { "location": "6274/Talk", "narrator": "みやび", "text": "ん？\n今、何でもするって\n言うた？"},
        { "location": "6275/Talk", "narrator": "ガブリエラ", "text": "ここって松代大本営が\nあった場所だっけ？"},
        { "location": "6276/Talk", "narrator": "アーヤ", "text": "象山壕にあった秘密の\n場所ね。って地元の人\nしかわからないか。"},
        { "location": "6277/Talk", "narrator": "みやび", "text": "聖地巡礼いつでも\n来たってやいう\n運営のメッセージやね。"},
        { "location": "6278/Talk", "narrator": "つばめ", "text": "ちょっと違うと\n思いますけど……。"},
        { "location": "6279/Talk", "narrator": "みやび", "text": "次回、音羽復活！\nつばめとの正妻戦争\n勃発や！"},
        { "location": "6280/Talk", "narrator": "つばめ", "text": "あの～……、語呂が\nいいだけのウソ予告は\nやめましょうよ……。"},
        { "location": "6281/Talk", "narrator": "みやび", "text": "じゃあ、次回、\nつばめ結婚す！\nとかは、どない？"},
        { "location": "6282/Talk", "narrator": "みやび", "text": "ん？　キミとしては\n面白くないいう顔\nしちょらん？"},
        { "location": "6283/Talk", "narrator": "みやび", "text": "むしろ女同士最高？\nまぁ、うちとしては\nどっちもアリやね。"}
    ]
}
