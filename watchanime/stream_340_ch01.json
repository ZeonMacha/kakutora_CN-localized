{
    "dir": "stream_340_ch01.json",
    "type": "watchanime",
    "info": {
    },
    "entry":
    [
        { "location": "6596/Talk", "narrator": "つばめ", "text": "で、ですよねー！"},
        { "location": "6597/Talk", "narrator": "みやび", "text": "確かにここ最近\nキャッキャウフフ度が\n低すぎる気がする。"},
        { "location": "6598/Talk", "narrator": "ガブリエラ", "text": "むしろそれ低くない時が\nあったの？"},
        { "location": "6599/Talk", "narrator": "アーヤ", "text": "海に行った時とか？"},
        { "location": "6600/Talk", "narrator": "みやび", "text": "あれも結局は一瞬の輝き\nやったな。虚しい……。"},
        { "location": "6601/Talk", "narrator": "ガブリエラ", "text": "自分で言っといてそれ！？"},
        { "location": "6602/Talk", "narrator": "つばめ", "text": "ええっ！？　そ、そんな、\nひどいです……。"},
        { "location": "6603/Talk", "narrator": "アーヤ", "text": "つばめをいじめるのは\n見過ごせないわね。"},
        { "location": "6604/Talk", "narrator": "みやび", "text": "アーヤがモンペ化した！？"},
        { "location": "6605/Talk", "narrator": "アーヤ", "text": "失礼ね。\nこれは純粋な庇護欲よ。"},
        { "location": "6606/Talk", "narrator": "ガブリエラ", "text": "それ口に出しちゃうのも、\nどうなのよ。"},
        { "location": "6607/Talk", "narrator": "みやび", "text": "んー……それはちょい\n安易な選択と違うん？"},
        { "location": "6608/Talk", "narrator": "神楽", "text": "でも髪型からして\n怪しいと思いますよ？"},
        { "location": "6609/Talk", "narrator": "アーヤ", "text": "確かに、いい歳をして\nあの髪型はね……。"},
        { "location": "6610/Talk", "narrator": "みやび", "text": "エリカさん、身内に\n裏切られちょる！"},
        { "location": "6611/Talk", "narrator": "みやび", "text": "うむ、さすがここまで\n付き合ってきちょった\nだけのことはあるな。"},
        { "location": "6612/Talk", "narrator": "アーヤ", "text": "べつに姉が実は良い人\nだという描写は\n全く無かったけれど。"},
        { "location": "6613/Talk", "narrator": "みやび", "text": "直接的な描写やなく\n見たことそのまんま\n信じないココロやき。"},
        { "location": "6614/Talk", "narrator": "神楽", "text": "つばめさんは見たまんまの\n可愛さですけどね。"},
        { "location": "6615/Talk", "narrator": "つばめ", "text": "そ、そんなこと\nないと思うけど……。"},
        { "location": "6616/Talk", "narrator": "つばめ", "text": "あぁっ、わたしが更に\nツッコミづらい状況に！"},
        { "location": "6617/Talk", "narrator": "つばめ", "text": "これで画面見ながら\n色々喋るなんて\n難しいよぉ……。"},
        { "location": "6618/Talk", "narrator": "つばめ", "text": "うぅ……でも、\nそれじゃダメだし、\nがんばります……。"},
        { "location": "6619/Talk", "narrator": "アーヤ", "text": "今回は久しぶり？\n初めて？　に熱く\n喋り過ぎたようね。"},
        { "location": "6620/Talk", "narrator": "アーヤ", "text": "べつに姉のことは\nどうでもいいんだけど\nつい語りたくなって。"},
        { "location": "6621/Talk", "narrator": "アーヤ", "text": "そういう時もあるんだ\nくらいに思っておいて\nちょうだい。"},
        { "location": "6622/Talk", "narrator": "みやび", "text": "なんや次回もうちが\n喋りまくりーな\n流れみたいやな。"},
        { "location": "6623/Talk", "narrator": "みやび", "text": "これでもギャラは\n同じやき、世知辛いなぁ。"},
        { "location": "6624/Talk", "narrator": "みやび", "text": "キミが個人的にご褒美を\nうちにくれてもええんよ？"},
        { "location": "6625/Talk", "narrator": "神楽", "text": "もうすっかりラストの\nぼっちトークが\n定位置の私です……。"},
        { "location": "6626/Talk", "narrator": "神楽", "text": "まあでも、\n状況が状況ですし、\n仕方ありませんよね。"},
        { "location": "6627/Talk", "narrator": "神楽", "text": "早く$handle$さんと\n色んなお話したいです。"},
        { "location": "6628/Talk", "narrator": "みやび", "text": "うちが来た！"},
        { "location": "6629/Talk", "narrator": "アーヤ", "text": "……それ、前にも\nやってなかった？"},
        { "location": "6630/Talk", "narrator": "みやび", "text": "それはきっと神楽や。\nん？　でもしたら\nうち二番煎じやね。"},
        { "location": "6631/Talk", "narrator": "アーヤ", "text": "芸人失格ね。"},
        { "location": "6632/Talk", "narrator": "みやび", "text": "やってもうたーっ！\nって、誰が芸人や！"},
        { "location": "6633/Talk", "narrator": "ガブリエラ", "text": "その前説、\nいつまで続ける気？"},
        { "location": "6634/Talk", "narrator": "みやび", "text": "うちら、場をあっため\nといただけやし。"},
        { "location": "6635/Talk", "narrator": "アーヤ", "text": "とりあえず私を\n一緒にしないで。"},
        { "location": "6636/Talk", "narrator": "つばめ", "text": "お待たせしましたー。\n今日もがんばるぞっ。"},
        { "location": "6637/Talk", "narrator": "ガブリエラ", "text": "ていうか、つばめ、\nアンタ最近ずっと\n低調じゃない？"},
        { "location": "6638/Talk", "narrator": "つばめ", "text": "だ、だってわたしが\nあんなことになってる\nシーン続きで。"},
        { "location": "6639/Talk", "narrator": "みやび", "text": "確かに自分で自分に\nつっこむいうのも\nキツイなぁ。"},
        { "location": "6640/Talk", "narrator": "つばめ", "text": "ですよね！"},
        { "location": "6641/Talk", "narrator": "ガブリエラ", "text": "ですよね…\nじゃないでしょ！\nあまえない！"},
        { "location": "6642/Talk", "narrator": "つばめ", "text": "す、すみません、\nガブちゃんコーチ。"},
        { "location": "6643/Talk", "narrator": "みやび", "text": "ところでキミは\n最近の展開、\nどう思っちょるん？"},
        { "location": "6644/Talk", "narrator": "つばめ", "text": "まさかのここで\n対話コーナー！？"},
        { "location": "6645/Talk", "narrator": "アーヤ", "text": "とか話していたらＯＰが\n終わりそうね。"},
        { "location": "6646/Talk", "narrator": "ガブリエラ", "text": "じゃあ、始めましょうか。"},
        { "location": "6647/Talk", "narrator": "つばめ", "text": "本編スタートです！"},
        { "location": "6648/Talk", "narrator": "みやび", "text": "さーて、いよいよ\nうちらの活躍シーンの\n開幕や。"},
        { "location": "6649/Talk", "narrator": "みやび", "text": "ヒャッハァーッ！！"},
        { "location": "6650/Talk", "narrator": "アーヤ", "text": "……その奇声はスルー\nするから、早く話を\n進めてちょうだい。"},
        { "location": "6651/Talk", "narrator": "みやび", "text": "というわけで、前回の\n読者プレゼントの\n答えはみやびでした。"},
        { "location": "6652/Talk", "narrator": "みやび", "text": "ココロの中で少しでも\n「みやびじゃね？」\nとか思った人は"},
        { "location": "6653/Talk", "narrator": "みやび", "text": "正直に自費で１週間ハワイ\n旅行に行くように！"},
        { "location": "6654/Talk", "narrator": "アーヤ", "text": "気づかない人の方が\n少ないと思うんだけど。"},
        { "location": "6655/Talk", "narrator": "ガブリエラ", "text": "むしろ、それくらい\n気づかないヤツは\n強制ハワイ送りよ。"},
        { "location": "6656/Talk", "narrator": "つばめ", "text": "あの、ハワイに行くの\n自体は罰ゲームじゃ\nないかと……。"},
        { "location": "6657/Talk", "narrator": "ガブリエラ", "text": "ていうか、あたしたち\nつばめのせいで行きたく\nても行けないし！"},
        { "location": "6658/Talk", "narrator": "つばめ", "text": "しまった！\nヤブヘビだったよ！？"},
        { "location": "6659/Talk", "narrator": "つばめ", "text": "ていうか、本物の銃で\n撃たれてるのに、\nみんな冷静だね……。"},
        { "location": "6660/Talk", "narrator": "ガブリエラ", "text": "そりゃ、これくらい\n想定して突っ込んで\n来たわけだし。"},
        { "location": "6661/Talk", "narrator": "アーヤ", "text": "むしろ冷静に\nならざるをえない状況\nってところかしら。"},
        { "location": "6662/Talk", "narrator": "みやび", "text": "当たらなければ\nどうちゅうこと\nないしな！"},
        { "location": "6663/Talk", "narrator": "つばめ", "text": "あー、まぁ、\nそうなりますよねー。"},
        { "location": "6664/Talk", "narrator": "ガブリエラ", "text": "ていうかフェノメノンの\n創造主が特権乱用しすぎ！"},
        { "location": "6665/Talk", "narrator": "みやび", "text": "相手は言うたらゲームの\n運営様みたいなもんやき。"},
        { "location": "6666/Talk", "narrator": "みやび", "text": "そして宴が始まる。\nちゅう流れやき。"},
        { "location": "6667/Talk", "narrator": "ガブリエラ", "text": "ていうか、なんでクランが\nこんなに沢山集まってる\nわけ？"},
        { "location": "6668/Talk", "narrator": "アーヤ", "text": "それが千羽鶴の\n狙いだったんでしょ？"},
        { "location": "6669/Talk", "narrator": "ガブリエラ", "text": "要するに、あたしらが\n突っ込んだのも\n千羽鶴の計画通り？"},
        { "location": "6670/Talk", "narrator": "みやび", "text": "そら想定してたから人員\n配置してたわけやしね。"},
        { "location": "6671/Talk", "narrator": "ガブリエラ", "text": "掌の上みたいで面白くない\nわね。何様よ！"},
        { "location": "6672/Talk", "narrator": "ガブリエラ", "text": "ところで、なんで\nみやびはここで合体\nするってわかったの？"},
        { "location": "6673/Talk", "narrator": "みやび", "text": "ただのテキトーな\n当てずっぽうや。"},
        { "location": "6674/Talk", "narrator": "ガブリエラ", "text": "真顔で、それ！？"},
        { "location": "6675/Talk", "narrator": "みやび", "text": "こういう時は真顔で\n言ったモン勝ちや。"},
        { "location": "6676/Talk", "narrator": "みやび", "text": "どうせ誰もわからんし\n有事のことやから\nもし間違ってても"},
        { "location": "6677/Talk", "narrator": "みやび", "text": "後で文句言われる\nことも無いし。"},
        { "location": "6678/Talk", "narrator": "ガブリエラ", "text": "これからはみやびの\n真顔は信じないように\n気をつけるわ。"},
        { "location": "6679/Talk", "narrator": "みやび", "text": "というのは冗談で、エリカ\nさんから貰った資料からの\n割と精度の高い推測やよ。"},
        { "location": "6680/Talk", "narrator": "アーヤ", "text": "おちゃらけてないで\nそういうことは\n最初に言いなさい。"},
        { "location": "6681/Talk", "narrator": "つばめ", "text": "神楽ちゃんっ！！"},
        { "location": "6682/Talk", "narrator": "みやび", "text": "なんやろや、この\nメロドラマみたいな\n演出いうか構図は。"},
        { "location": "6683/Talk", "narrator": "神楽", "text": "演出もなにも、\nこれは壮大な神聖なる\nメロドラマですから！"},
        { "location": "6684/Talk", "narrator": "つばめ", "text": "あ、やっぱり\n出て来ちゃったんだ。"},
        { "location": "6685/Talk", "narrator": "神楽", "text": "つばめさん、その\n微妙に冷めた目も\n愛らしいですよ！"},
        { "location": "6686/Talk", "narrator": "みやび", "text": "しっかし、それやと\nメロドラマの末に\n世界崩壊かい。"},
        { "location": "6687/Talk", "narrator": "神楽", "text": "愛は地球より、いえ、\n赤色巨星よりも\n重いんです！"},
        { "location": "6688/Talk", "narrator": "アーヤ", "text": "天体レベルなら\n世界が崩壊するのも\n仕方ないわね。"},
        { "location": "6689/Talk", "narrator": "みやび", "text": "お？　これはもしや\n外界なのでは！？\nＳＳＲな映像やな。"},
        { "location": "6690/Talk", "narrator": "アーヤ", "text": "これは一体何が\n起こっているの？"},
        { "location": "6691/Talk", "narrator": "みやび", "text": "フェノメノンが\n増大してるんやね。"},
        { "location": "6692/Talk", "narrator": "神楽", "text": "正に私とつばめさんの\n愛が日本のみならず\n世界まで包もうと！"},
        { "location": "6693/Talk", "narrator": "つばめ", "text": "えーと……包んで\nどうするのかな？"},
        { "location": "6694/Talk", "narrator": "神楽", "text": "もちろん、世界中に\nつばめさんランドを\n開園するんですよ！"},
        { "location": "6695/Talk", "narrator": "みやび", "text": "いや、いかんち。\nアレにケンカ売るんは\nほんまいかんから。"},
        { "location": "6696/Talk", "narrator": "つばめ", "text": "これ、エリカさん\n真っ黒なんじゃ！？"},
        { "location": "6697/Talk", "narrator": "みやび", "text": "いんや、そないなこと\n無いと思うけんど？"},
        { "location": "6698/Talk", "narrator": "アーヤ", "text": "貴方はどう思う？"},
        { "location": "6699/Talk", "narrator": "みやび", "text": "まあ、うちが思っちゅうん\nはただ１つや。"},
        { "location": "6700/Talk", "narrator": "みやび", "text": "これだけの情報で、\n黒やと確定するのは\nあまりに純粋すぎやぞと。"},
        { "location": "6701/Talk", "narrator": "みやび", "text": "ファンタジーならともかく\nここは現実や。"},
        { "location": "6702/Talk", "narrator": "アーヤ", "text": "まあ確かに……、\n表面上見えてることとか\n聞き伝えの情報とか――"},
        { "location": "6703/Talk", "narrator": "アーヤ", "text": "そういったものだけで\n相手を糾弾するのは\nちょっと性急かもね。"},
        { "location": "6704/Talk", "narrator": "みやび", "text": "もしこの情報だけで\nエリカさんを黒やと思うた\n輩は過去を思い返してみ？"},
        { "location": "6705/Talk", "narrator": "みやび", "text": "「アイツ○○らしいぜ」\nゆう噂１つでどん引きして\n付き合うのをやめたり――"},
        { "location": "6706/Talk", "narrator": "みやび", "text": "いじめる側に回ったりした\nような経験はないか？"},
        { "location": "6707/Talk", "narrator": "アーヤ", "text": "わりと誰でも\nありそうなことよね。"},
        { "location": "6708/Talk", "narrator": "アーヤ", "text": "確かに、後で思い返して\nみると……"},
        { "location": "6709/Talk", "narrator": "アーヤ", "text": "あれは本当だったのか？\nって後悔したことは\nあったかもしれないわ。"},
        { "location": "6710/Talk", "narrator": "みやび", "text": "まあ、人間やし、\nそんなん普通にあるぞね。\n先入観の生き物やし。"},
        { "location": "6711/Talk", "narrator": "みやび", "text": "けんど、そういうのを\n一歩止まって見られる\nようになると――"},
        { "location": "6712/Talk", "narrator": "みやび", "text": "もっと世界に\n優しく生きられるやも\nしれんとは思うけんどね。"},
        { "location": "6713/Talk", "narrator": "アーヤ", "text": "そうね……。"},
        { "location": "6714/Talk", "narrator": "つばめ", "text": "神楽ちゃんどうしよ。\n二人の話に、わたし\n全然ついて行けない。"},
        { "location": "6715/Talk", "narrator": "神楽", "text": "つばめさんは\nそれでいいんですよ。"},
        { "location": "6716/Talk", "narrator": "神楽", "text": "汚いことなんて\nわざわざ知る必要は\nありません。"},
        { "location": "6717/Talk", "narrator": "神楽", "text": "それは私が背負えば\nいいことですから……"},
        { "location": "6718/Talk", "narrator": "つばめ", "text": "神楽……ちゃん？"},
        { "location": "6719/Talk", "narrator": "アーヤ", "text": "そうね。少なくとも\n今のつばめには\n無縁なことよ。"},
        { "location": "6720/Talk", "narrator": "みやび", "text": "ピュア突き抜けちょる\nことには定評がある\nつばめちゃんやし。"},
        { "location": "6721/Talk", "narrator": "つばめ", "text": "……もしかしてわたし\nからかわれてない？"},
        { "location": "6722/Talk", "narrator": "神楽", "text": "ふふふっ、\n気のせいですよ♪"},
        { "location": "6723/Talk", "narrator": "つばめ", "text": "って！\n神楽ちゃんが\n牛になっちゃった！！"},
        { "location": "6724/Talk", "narrator": "神楽", "text": "つばめさん、\n牛の私でも\n愛してくれますか？"},
        { "location": "6725/Talk", "narrator": "アーヤ", "text": "いえ、これはバフォメット\nという悪魔よ。"},
        { "location": "6726/Talk", "narrator": "つばめ", "text": "バフォメット？\nって、どういう悪魔\nなんですか？"},
        { "location": "6727/Talk", "narrator": "神楽", "text": "それはですね、色んな\n辞書を調べると、\nこんなのらしいです。"},
        { "location": "6728/Talk", "narrator": "神楽", "text": "『好色の悪魔で、\n　魔女達のサバトでの\n　崇拝対象』"},
        { "location": "6729/Talk", "narrator": "神楽", "text": "『両性具有で胸があり、\n　山羊の頭という姿が\n　特徴的』"},
        { "location": "6730/Talk", "narrator": "神楽", "text": "『上級六大悪魔の\n　最上位の一柱と同格とも\n　言われている』"},
        { "location": "6731/Talk", "narrator": "神楽", "text": "『語源は諸説あり、\n　確固たるものがない』"},
        { "location": "6732/Talk", "narrator": "神楽", "text": "と、まぁ、こんな感じの\n悪魔みたいですね。"},
        { "location": "6733/Talk", "narrator": "みやび", "text": "てか、なんやそれ、\nまんま卯月――"},
        { "location": "6734/Talk", "narrator": "アーヤ", "text": "みやび、待った。\nそれ以上は思ってても\n口に出したらダメよ。"},
        { "location": "6735/Talk", "narrator": "みやび", "text": "言うても、つばめちゃんに\n不道徳を植えつけよう\nとしてるんはよう見るし。"},
        { "location": "6736/Talk", "narrator": "みやび", "text": "女性の姿言うたら\nまんま卯月やしなぁ。"},
        { "location": "6737/Talk", "narrator": "神楽", "text": "まぁ、キャラ的に大体合っ\nてるのは認めますけど。"},
        { "location": "6738/Talk", "narrator": "つばめ", "text": "認めちゃうの！？"},
        { "location": "6739/Talk", "narrator": "みやび", "text": "いや待った。\nうちの勘違いや。"},
        { "location": "6740/Talk", "narrator": "みやび", "text": "卯月は胸がない！\n微塵もない！　よって白！"},
        { "location": "6741/Talk", "narrator": "神楽", "text": "……呪いますよ？"},
        { "location": "6742/Talk", "narrator": "みやび", "text": "お、ガブちゃん、\nおかえりー。"},
        { "location": "6743/Talk", "narrator": "つばめ", "text": "って、お喋りしてたら\nわたしが死亡したとこ\nサラッと流されてる？"},
        { "location": "6744/Talk", "narrator": "ガブリエラ", "text": "だってアンタ結局\n不死身でしょ？\n驚くだけ損じゃない。"},
        { "location": "6745/Talk", "narrator": "みやび", "text": "うむ、余計なエネルギーは\n使わぬが吉やき。"},
        { "location": "6746/Talk", "narrator": "つばめ", "text": "あの、でも今回は割と\n本気でわたし、\nやばそうですし！"},
        { "location": "6747/Talk", "narrator": "みやび", "text": "うーん、どうやろか。\nACT1-4でつばめちゃんが\n刺されたシーンあるやろ。"},
        { "location": "6748/Talk", "narrator": "みやび", "text": "それとこのシーン、\n緊張感や絶望感は、\n全然変わらへんよなぁ。"},
        { "location": "6749/Talk", "narrator": "みやび", "text": "で？　前回は結局\nどんな結末やったかねぇ？\nつばめちゃん？"},
        { "location": "6750/Talk", "narrator": "アーヤ", "text": "つばめ、\n憶えておきなさい。"},
        { "location": "6751/Talk", "narrator": "アーヤ", "text": "これが「オオカミ少年」と\nいう寓話が現実のものと\nなった瞬間よ。"},
        { "location": "6752/Talk", "narrator": "つばめ", "text": "待って。わたし\n騙してないです！\n騙してないですよ！！"},
        { "location": "6753/Talk", "narrator": "みやび", "text": "まぁ、そないなわけで\nつばめちゃんのことは\n置いといて。"},
        { "location": "6754/Talk", "narrator": "つばめ", "text": "置いとかれるの！？"},
        { "location": "6755/Talk", "narrator": "みやび", "text": "これってもしかして\nうちら電撃に打たれて\n死亡エンド？"},
        { "location": "6756/Talk", "narrator": "ガブリエラ", "text": "モブにも劣る最期ね。\n最悪ぅ……。"},
        { "location": "6757/Talk", "narrator": "アーヤ", "text": "つまり私たちは、この\n物語にとってはただの\nモブキャラだったと。"},
        { "location": "6758/Talk", "narrator": "つばめ", "text": "あの、そんな自虐は\nやめませんかっ？"},
        { "location": "6759/Talk", "narrator": "つばめ", "text": "わたしたちは今を燦めく\nトライナリーなんですよ！\nな、なーんて……。"},
        { "location": "6760/Talk", "narrator": "みやび", "text": "ちゅうか、そもそも\nこの辺、ガチで話が\nぶっ飛びすぎやき……。"},
        { "location": "6761/Talk", "narrator": "みやび", "text": "うちですら、全然\n頭がついてこんわ。"},
        { "location": "6762/Talk", "narrator": "ガブリエラ", "text": "結局この音羽は何なの？　\nなんでここにいるわけ？"},
        { "location": "6763/Talk", "narrator": "アーヤ", "text": "卯月が本証を現した\nことといい、もはや\n手がつけられないわね。"},
        { "location": "6764/Talk", "narrator": "アーヤ", "text": "ツッコミどころが満載の\nギャグアニメに\nなってきたみたい。"},
        { "location": "6765/Talk", "narrator": "つばめ", "text": "あの、だから、\nギャグアニメじゃ\nないと思いますよ？"},
        { "location": "6766/Talk", "narrator": "ガブリエラ", "text": "なんでアンタ\nさっきから必死に\nフォローしてんの？"},
        { "location": "6767/Talk", "narrator": "ガブリエラ", "text": "冗談で言ってるに\n決まってるでしょ？"},
        { "location": "6768/Talk", "narrator": "つばめ", "text": "ええぇっ！？"},
        { "location": "6769/Talk", "narrator": "みやび", "text": "ま、次回はガチの解説と\nいきましょうかね。"},
        { "location": "6770/Talk", "narrator": "ガブリエラ", "text": "なんだか次回も\n延々とみやびが\n喋ってそうね。"},
        { "location": "6771/Talk", "narrator": "ガブリエラ", "text": "アンタも聞き飽きたら\nストップかけて\nいいのよ？"},
        { "location": "6772/Talk", "narrator": "ガブリエラ", "text": "もしくは、もっと\nあたしと話したいって\n要望出すとか、ね？"}
    ]
}
