{
    "dir": "stream_150_ch01.json",
    "type": "watchanime",
    "info": {
    },
    "entry":
    [
        { "location": "2533/Talk", "narrator": "つばめ", "text": "ふえっ？　確かに\n美少女ですけど、\n残念って何がですか？"},
        { "location": "2534/Talk", "narrator": "神楽", "text": "つばめさん、\nありがとうアンド\n愛してるラビンユー。"},
        { "location": "2535/Talk", "narrator": "つばめ", "text": "ふえぇぇぇっ！？"},
        { "location": "2536/Talk", "narrator": "神楽", "text": "それはそれとして\n残念美少女とは私を\n少々見誤ってますね。"},
        { "location": "2537/Talk", "narrator": "神楽", "text": "私は最早、更に上の\n『無念美少女』の域に\n達してますよ！！"},
        { "location": "2538/Talk", "narrator": "つばめ", "text": "全然わからないけど\nすごいよ卯月さん！！"},
        { "location": "2539/Talk", "narrator": "神楽", "text": "あぁ、もっと褒めて。\nそして二人は幸せな\nキスを……。"},
        { "location": "2540/Talk", "narrator": "つばめ", "text": "えっえっ！？！？！？"},
        { "location": "2541/Talk", "narrator": "神楽", "text": "はっ！？\nもしかしてあなたは\n組織からの刺客っ！？"},
        { "location": "2542/Talk", "narrator": "つばめ", "text": "えぇっ！？\nな、何？　組織って\nどういうこと？"},
        { "location": "2543/Talk", "narrator": "神楽", "text": "それを話すとなると\n１クール分くらいの回想\nシーンに入りますけど…。"},
        { "location": "2544/Talk", "narrator": "神楽", "text": "覚悟はいいですか？"},
        { "location": "2545/Talk", "narrator": "つばめ", "text": "えっとえっと……\nがんばって聞くね！？"},
        { "location": "2546/Talk", "narrator": "神楽", "text": "私が毎晩ベッドの中で\n寝物語として話します\nから大丈夫ですよ♪"},
        { "location": "2547/Talk", "narrator": "つばめ", "text": "あれ！？\n今する話じゃ\nないのかな！？！？"},
        { "location": "2548/Talk", "narrator": "神楽", "text": "ぐふふふふふふっ♪\n気になりますか？\n知りたいですかぁ？"},
        { "location": "2549/Talk", "narrator": "つばめ", "text": "わわわわわっ、ダ、\nダメだよ卯月さんっ、\nあの本のことはっ。"},
        { "location": "2550/Talk", "narrator": "神楽", "text": "んん～？　どうして\n本について教えたら\nダメなんですか～？"},
        { "location": "2551/Talk", "narrator": "つばめ", "text": "だ、だって、\nあの本って、アレが\nソレで、え～と……。"},
        { "location": "2552/Talk", "narrator": "神楽", "text": "アレとかソレじゃ\nわかりませんよ～？\nもっとちゃんと～？"},
        { "location": "2553/Talk", "narrator": "つばめ", "text": "あぁーっんっ！！\n卯月さんの意地悪ぅっ！！"},
        { "location": "2554/Talk", "narrator": "神楽", "text": "確かに物理的に薄い\nですけど、何を\n言いたいんですか？"},
        { "location": "2555/Talk", "narrator": "つばめ", "text": "……ソノ話ハ\nヤメマショウ。"},
        { "location": "2556/Talk", "narrator": "神楽", "text": "唐突につばめさんが\n心の無いロボットの\nようにっ！？"},
        { "location": "2557/Talk", "narrator": "つばめ", "text": "ワタシハ何モ\n見テナイヨー。\n見テナイカラネー。"},
        { "location": "2558/Talk", "narrator": "神楽", "text": "つばめさんのプリンを\n食べたことは謝ります\nから帰ってきてっ！"},
        { "location": "2559/Talk", "narrator": "つばめ", "text": "何でみんなわたしの\n大切なプリンを\n食べちゃうのっ！？"},
        { "location": "2560/Talk", "narrator": "神楽", "text": "待ってください。\nその認識は少し\n間違っています。"},
        { "location": "2561/Talk", "narrator": "神楽", "text": "実はつばめさんは着痩せ\nするタイプなんです！"},
        { "location": "2562/Talk", "narrator": "つばめ", "text": "ふえぇぇぇっ！？"},
        { "location": "2563/Talk", "narrator": "神楽", "text": "自虐的なリアクション\nしてますけど、\n結構大きいです！"},
        { "location": "2564/Talk", "narrator": "つばめ", "text": "わわわわわっ！？\nいいいいいきなり何を\n言い出すのっ！？"},
        { "location": "2565/Talk", "narrator": "神楽", "text": "この前一緒にお風呂に\n入った時もどさくさで\n観察しまくりました！"},
        { "location": "2566/Talk", "narrator": "つばめ", "text": "卯月さん、そんなこと\nしてたのっ！？"},
        { "location": "2567/Talk", "narrator": "神楽", "text": "ちなみに私の目視による\n推定サイズは……。"},
        { "location": "2568/Talk", "narrator": "つばめ", "text": "ストップ！\nストップっ！！\nストォーーップっ！！"},
        { "location": "2569/Talk", "narrator": "つばめ", "text": "ふえぇぇぇっ！？"},
        { "location": "2570/Talk", "narrator": "神楽", "text": "……なーんでそれを\n知ってるんですかー？"},
        { "location": "2571/Talk", "narrator": "つばめ", "text": "き、気のせいですっ！\nわ、わたしなんて\nささやかなものでっ！"},
        { "location": "2572/Talk", "narrator": "神楽", "text": "黙らっしゃい！\n今はそれどころじゃ\nありませんっ！"},
        { "location": "2573/Talk", "narrator": "つばめ", "text": "う、卯月さんっ！？"},
        { "location": "2574/Talk", "narrator": "神楽", "text": "これは私しか知らない\nつばめさんの極秘事項\nなはずですよ？"},
        { "location": "2575/Talk", "narrator": "神楽", "text": "つばめさんの部屋に\n遊びに行った時に\nブラも確認済みです！"},
        { "location": "2576/Talk", "narrator": "つばめ", "text": "えっ！？\n聞いてくれたら\n教えたよ？"},
        { "location": "2577/Talk", "narrator": "神楽", "text": "つばめさん！？\n普通に言ってますが\n爆弾発言すぎますよ！？"},
        { "location": "2578/Talk", "narrator": "つばめ", "text": "そ、それは、だって、\n何だか恥ずかしく\nなっちゃって……。"},
        { "location": "2579/Talk", "narrator": "神楽", "text": "それは私を\n意識しちゃったって\nことですか？"},
        { "location": "2580/Talk", "narrator": "つばめ", "text": "そ、そういうわけじゃ\nなくて！"},
        { "location": "2581/Talk", "narrator": "神楽", "text": "あらー……、\nばっさりと斬り捨てら\nれちゃいました……。"},
        { "location": "2582/Talk", "narrator": "つばめ", "text": "あああっ、え、えーと\nだから、その、わたし\nこういうのっていうか"},
        { "location": "2583/Talk", "narrator": "つばめ", "text": "友だちとこういうの\n撮ったことなくて、\nだからっ……。"},
        { "location": "2584/Talk", "narrator": "神楽", "text": "なるほど、つまり私が\nつばめさんの初めての\n相手ってことですね！"},
        { "location": "2585/Talk", "narrator": "つばめ", "text": "そうなんだけど……。\n改めて言われると\nちょっと恥ずかしいな。"},
        { "location": "2586/Talk", "narrator": "神楽", "text": "ほほぅ？\n見返りは何でしょう？"},
        { "location": "2587/Talk", "narrator": "神楽", "text": "そもそも、何に使う\nつもりなんですかぁ？"},
        { "location": "2588/Talk", "narrator": "神楽", "text": "私以外が悪用するのは\n許しませんよ？"},
        { "location": "2589/Talk", "narrator": "つばめ", "text": "卯月さんは\nどんなことに\n悪用してるのっ！？"},
        { "location": "2590/Talk", "narrator": "神楽", "text": "冗談ですってば。\n人には言えないことに\n使ってるだけですよ♪"},
        { "location": "2591/Talk", "narrator": "つばめ", "text": "えっ！？"},
        { "location": "2592/Talk", "narrator": "神楽", "text": "なんて。\n冗談ですよ\n冗談♪"},
        { "location": "2593/Talk", "narrator": "つばめ", "text": "そうなの？\nもー。"},
        { "location": "2594/Talk", "narrator": "神楽", "text": "今回は私のわがままを\n聞いてもらって\n感謝しています。"},
        { "location": "2595/Talk", "narrator": "神楽", "text": "でも、次回は\nもしかしたら\nもう私は……。"},
        { "location": "2596/Talk", "narrator": "神楽", "text": "……あっ、いえ、\n何でもありません。\nそれでは、また……。"},
        { "location": "2597/Talk", "narrator": "アーヤ", "text": "いきなりで悪いけど、\n実は残念なお知らせが\nあるの。"},
        { "location": "2598/Talk", "narrator": "ガブリエラ", "text": "まぁ、とりあえず\n聞くけど、何？"},
        { "location": "2599/Talk", "narrator": "みやび", "text": "うちとしては残念でも\n美味しいネタやったら\n構わんぞね。"},
        { "location": "2600/Talk", "narrator": "アーヤ", "text": "ええ、実は卯月から\nとてもとても強く強く\nお願いされて……。"},
        { "location": "2601/Talk", "narrator": "ガブリエラ", "text": "あっ、何かもう、\nその時点で聞きたく\nなくなってきたわ。"},
        { "location": "2602/Talk", "narrator": "みやび", "text": "もう卯月のお願い\nっちゅー時点で\n怪しさ爆発ぞね。"},
        { "location": "2603/Talk", "narrator": "アーヤ", "text": "それで、今回の\nこのコーナーのこと\nなんだけど……。"},
        { "location": "2604/Talk", "narrator": "アーヤ", "text": "つばめと二人だけで\nやりたいから、私たち\nは遠慮して欲しいと。"},
        { "location": "2605/Talk", "narrator": "ガブリエラ", "text": "ええと……？\nなんなのかしら……。"},
        { "location": "2606/Talk", "narrator": "みやび", "text": "まさかこない早う\n強攻手段に出るとは\n思わんかったぞね。"},
        { "location": "2607/Talk", "narrator": "アーヤ", "text": "そんなわけで私たちの\n出番はＯＰが終わる\nまでってことなのよ。"},
        { "location": "2608/Talk", "narrator": "ガブリエラ", "text": "……アーヤがそれで\nいいならまあ\nいいけど……。"},
        { "location": "2609/Talk", "narrator": "みやび", "text": "うちもええけんど\nガブちゃんやアーヤの\nファンが可哀相ぞね。"},
        { "location": "2610/Talk", "narrator": "みやび", "text": "ここ観るんは何ぞ\nアイテムとか\n使うろう？"},
        { "location": "2611/Talk", "narrator": "アーヤ", "text": "この埋め合わせは\nいずれ必ずするから\n許してちょうだい。"},
        { "location": "2612/Talk", "narrator": "ガブリエラ", "text": "少しくらいオアズケ\nさせるのも、たまには\nいいんじゃない？"},
        { "location": "2613/Talk", "narrator": "みやび", "text": "その分次回は\nガブちゃんのサービス\n３倍増しやきね。"},
        { "location": "2614/Talk", "narrator": "ガブリエラ", "text": "聞いてないし、\nやらないわよっ！？"},
        { "location": "2615/Talk", "narrator": "神楽", "text": "というわけで今回は\n私とつばめさんの\n二人だけですよっ！！"},
        { "location": "2616/Talk", "narrator": "つばめ", "text": "えぇぇぇっ！？\nふ、二人だけで\n大丈夫なのっ！？"},
        { "location": "2617/Talk", "narrator": "神楽", "text": "私に身も心も全て\n委ねてくれれば\n大丈夫ですっ！！"},
        { "location": "2618/Talk", "narrator": "つばめ", "text": "そ、それはそれで、\n何だかダメな気が\nするんだけど……。"},
        { "location": "2619/Talk", "narrator": "つばめ", "text": "やっぱりみんなを\n呼んで来た方が\nいいんじゃ……。"},
        { "location": "2620/Talk", "narrator": "神楽", "text": "そんな心配より映像を\n見ながらイチャイチャ\nしましょう♪"},
        { "location": "2621/Talk", "narrator": "つばめ", "text": "いきなり目的が\n違ってる気が\nするよっ！？"},
        { "location": "2622/Talk", "narrator": "神楽", "text": "気のせいですよっ。\n気のせいっ♪"},
        { "location": "2623/Talk", "narrator": "神楽", "text": "それより、せっかく\n秋葉原に来たんだから\n濃い話をします？"},
        { "location": "2624/Talk", "narrator": "つばめ", "text": "濃い話……？\nそれってわたしが\nついていける話？"},
        { "location": "2625/Talk", "narrator": "神楽", "text": "つばめさんもいずれは\nついて来て追い越す\nくらいの勢いで！"},
        { "location": "2626/Talk", "narrator": "つばめ", "text": "というか、この時の\n体験だけでもわたしは\n充分濃く感じたよ～。"},
        { "location": "2627/Talk", "narrator": "神楽", "text": "何言ってるんですか。\nこの時の私は一割も\n本気出してませんよ？"},
        { "location": "2628/Talk", "narrator": "つばめ", "text": "わたし、卯月さんが\nわからなくなって\nきたよ……。"},
        { "location": "2629/Talk", "narrator": "つばめ", "text": "さっきも何だか\n変な声で笑ってたし\n変なオーラ出てたし。"},
        { "location": "2630/Talk", "narrator": "神楽", "text": "つばめさん、それは\n幻聴アンド幻覚です。\n忘れてください。"},
        { "location": "2631/Talk", "narrator": "神楽", "text": "と、まぁ、\nそんなわけで、\n好奇心はほどほどに♪"},
        { "location": "2632/Talk", "narrator": "つばめ", "text": "見せられたわたしの\n立場はっ！？"},
        { "location": "2633/Talk", "narrator": "神楽", "text": "……何だかイラッと\nきました。"},
        { "location": "2634/Talk", "narrator": "つばめ", "text": "あっ、うん、き、気持ちは\nわかるよ……。"},
        { "location": "2635/Talk", "narrator": "神楽", "text": "とにかくつばめさんを\n不埒な目で見るのは\n禁止ですっ！！"},
        { "location": "2636/Talk", "narrator": "つばめ", "text": "……卯月さんったら。\nそんな人いないから\n大丈夫だよ？"},
        { "location": "2637/Talk", "narrator": "神楽", "text": "天然すぎるのも\nいい加減にしてください\nもう！"},
        { "location": "2638/Talk", "narrator": "つばめ", "text": "でも人形ってどうして\nあんなに色んな所を\n強調してるんだろ？"},
        { "location": "2639/Talk", "narrator": "神楽", "text": "それは勿論、男性の\n夢と希望とロマンが\n詰まってるからです。"},
        { "location": "2640/Talk", "narrator": "つばめ", "text": "それにしたって\nちょっと詰めすぎじゃ\nないかなー？"},
        { "location": "2641/Talk", "narrator": "神楽", "text": "それはさておき、\nここは私が大好きな\nお店なんですよっ！"},
        { "location": "2642/Talk", "narrator": "つばめ", "text": "うん、雰囲気が\n落ち着いてて、\nいい感じだよね。"},
        { "location": "2643/Talk", "narrator": "つばめ", "text": "でも何で店員さんが\nメイドさん？\nの格好してるの？"},
        { "location": "2644/Talk", "narrator": "神楽", "text": "このお店も分類的には\nメイドカフェに\nなりますから。"},
        { "location": "2645/Talk", "narrator": "つばめ", "text": "えっ？　でも、\nメイドカフェって\nもっと、こう……。"},
        { "location": "2646/Talk", "narrator": "つばめ", "text": "美味しくなーれ♪\nみたいな？\nち、違ったかな？"},
        { "location": "2647/Talk", "narrator": "神楽", "text": "いえ、メイドカフェと\n言えば普通はそっちを\n連想しますよね。"},
        { "location": "2648/Talk", "narrator": "つばめ", "text": "うん、ＴＶとかで\n見たことしか\nなかったから……。"},
        { "location": "2649/Talk", "narrator": "神楽", "text": "いえ、それはそれで\n私は好きですから\n大丈夫ですよっ。"},
        { "location": "2650/Talk", "narrator": "神楽", "text": "そういうメイドカフェ\nにも今度一緒に\n行きましょうねっ♪"},
        { "location": "2651/Talk", "narrator": "つばめ", "text": "う、うん、そうだね。\n実際に行ってみたら\nきっと楽しいよね？"},
        { "location": "2652/Talk", "narrator": "神楽", "text": "ええ、美味しくなる\n魔法をかけてくれる\nお店もいいですけど。"},
        { "location": "2653/Talk", "narrator": "神楽", "text": "でも、ゆっくりと\nくつろぎたい時は\nここなんです。"},
        { "location": "2654/Talk", "narrator": "つばめ", "text": "うん、ハーブティーも\n美味しいし、読書とか\nするのによさそう♪"},
        { "location": "2655/Talk", "narrator": "神楽", "text": "そう言って貰えて\n安心しました。\n引かれちゃうかと。"},
        { "location": "2656/Talk", "narrator": "つばめ", "text": "そんなことないよ。\nまた卯月さんと\n来たいな。"},
        { "location": "2657/Talk", "narrator": "神楽", "text": "つばめさん……。"},
        { "location": "2658/Talk", "narrator": "神楽", "text": "私、つばめさんに\n隠していることが\nあるんです……。"},
        { "location": "2659/Talk", "narrator": "つばめ", "text": "あっ、わかった！\n今度は、どこのお姫様\nって言い出すつもり？"},
        { "location": "2660/Talk", "narrator": "神楽", "text": "実は私は異世界から\nお嫁さんを探しに来た\n王女なんだぴょん♪"},
        { "location": "2661/Talk", "narrator": "つばめ", "text": "えっと！？\n何言ってるか\nわからないよ！？"},
        { "location": "2662/Talk", "narrator": "神楽", "text": "異世界の常識、現実の\n非常識。お嫁さん捕獲\n当たり前の儀式。"},
        { "location": "2663/Talk", "narrator": "つばめ", "text": "卯月さん！？\n卯月さん！？！？！？"},
        { "location": "2664/Talk", "narrator": "神楽", "text": "つばめさんは身も心も\n私に委ねてくれれば\nそれでいいんですよ♪"},
        { "location": "2665/Talk", "narrator": "つばめ", "text": "こ、こんな時は、\nみやびさん直伝の……\nな、なんでやねんっ！"},
        { "location": "2666/Talk", "narrator": "神楽", "text": "みやびさんは関西人\nじゃありませんから\n直伝は偽りアリです！"},
        { "location": "2667/Talk", "narrator": "つばめ", "text": "そうなの？\n似たようなものだと\n思うんだけど？"},
        { "location": "2668/Talk", "narrator": "神楽", "text": "その発言は本気で命に\n関わるので、二度と\n口にしない方が……。"},
        { "location": "2669/Talk", "narrator": "つばめ", "text": "ふえぇぇぇっ！？"},
        { "location": "2670/Talk", "narrator": "神楽", "text": "つばめさんから\n純朴な笑顔が\n失われていく……。"},
        { "location": "2671/Talk", "narrator": "神楽", "text": "それはそれで\nいいものですよね♪"},
        { "location": "2672/Talk", "narrator": "つばめ", "text": "大体、これって一体\n何だったの！？\nい、いきなり……。"},
        { "location": "2673/Talk", "narrator": "神楽", "text": "何だと言われても……\n本能？　衝動？\n野性の目覚め？"},
        { "location": "2674/Talk", "narrator": "つばめ", "text": "何を言ってるのか\nわかんないよ！？"},
        { "location": "2675/Talk", "narrator": "神楽", "text": "こう、穴があるとつい\n指を入れてみたくなる\nような感覚？"},
        { "location": "2676/Talk", "narrator": "つばめ", "text": "微妙に理解したくない\n例えだねそれ……。"},
        { "location": "2677/Talk", "narrator": "神楽", "text": "あっ！　つばめさんの\n笑顔をまた曇らせて\nいるのは誰っ！？"},
        { "location": "2678/Talk", "narrator": "つばめ", "text": "じぃ～～～～……っ。"},
        { "location": "2679/Talk", "narrator": "神楽", "text": "つばめさん、その視線\nちょっと痛くて\n切なくなりますっ！"},
        { "location": "2680/Talk", "narrator": "神楽", "text": "でもこれはこれで\nくせになって\nしまいそう……。"},
        { "location": "2681/Talk", "narrator": "つばめ", "text": "とかふざけてるから\nいきなりアラートが\n来ちゃったよ！"},
        { "location": "2682/Talk", "narrator": "神楽", "text": "楽しくて幸せな時間は\n突然終わってしまう\nものなんですね……。"},
