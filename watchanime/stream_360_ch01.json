{
    "dir": "stream_360_ch01.json",
    "type": "watchanime",
    "info": {
    },
    "entry":
    [
        { "location": "6987/Talk", "narrator": "ガブリエラ", "text": "誰となんの約束なのよ……"},
        { "location": "6988/Talk", "narrator": "みやび", "text": "正に心の中のユートピア\nやね。約束された地や。"},
        { "location": "6989/Talk", "narrator": "アーヤ", "text": "無意識下における自身との\n約束ね。いつかきっと叶う\nと。"},
        { "location": "6990/Talk", "narrator": "ガブリエラ", "text": "……二人ともなんか\nてきとーに合わせて\n喋ってない？"},
        { "location": "6991/Talk", "narrator": "アーヤ", "text": "ええ、わかるわ……。"},
        { "location": "6992/Talk", "narrator": "ガブリエラ", "text": "わかっちゃいけない\n気がするんだけど……"},
        { "location": "6993/Talk", "narrator": "ガブリエラ", "text": "……は？"},
        { "location": "6994/Talk", "narrator": "みやび", "text": "せやけんど音羽の胸は\n柔らかくて寝心地\n良さそうやよねー。"},
        { "location": "6995/Talk", "narrator": "神楽", "text": "どういう意味ですか？\n場合によっては\n末代まで祟りますよ？"},
        { "location": "6996/Talk", "narrator": "つばめ", "text": "神楽ちゃん、\n胸が小さいからって\n逆恨みはダメだよ？"},
        { "location": "6997/Talk", "narrator": "神楽", "text": "ほげぇっ！？"},
        { "location": "6998/Talk", "narrator": "ガブリエラ", "text": "つばめ、無自覚に\n人の心をえぐるのは\nやめなさい。"},
        { "location": "6999/Talk", "narrator": "つばめ", "text": "えっ？　えっ！？"},
        { "location": "7000/Talk", "narrator": "ガブリエラ", "text": "……もしかして神楽に\n抱きつかれたいの？"},
        { "location": "7001/Talk", "narrator": "ガブリエラ", "text": "はぁ？\n今すぐ死んじゃえば？"},
        { "location": "7002/Talk", "narrator": "みやび", "text": "ガブちゃん、あかん。\nそない言うたら\nご褒美やよ。"},
        { "location": "7003/Talk", "narrator": "ガブリエラ", "text": "何それ、本気で\nキモいんだけど。"},
        { "location": "7004/Talk", "narrator": "みやび", "text": "だから、ご褒美やて。"},
        { "location": "7005/Talk", "narrator": "神楽", "text": "ホントですか？\nそんなこと言われたら\n私でも嬉しいですよ？"},
        { "location": "7006/Talk", "narrator": "ガブリエラ", "text": "ま、まぁ、アンタの\n趣味にとやかく言う\nつもりは無いけど。"},
        { "location": "7007/Talk", "narrator": "神楽", "text": "でも言っときますけど\n相当しんどいと\n思いますよ。"},
        { "location": "7008/Talk", "narrator": "神楽", "text": "私は心を許した人には\nぶん殴りますから！"},
        { "location": "7009/Talk", "narrator": "つばめ", "text": "ぼ、暴力はダメだよ！？"},
        { "location": "7010/Talk", "narrator": "神楽", "text": "いえ、あくまでも\n精神的な話だから\n安心してください。"},
        { "location": "7011/Talk", "narrator": "みやび", "text": "余計にタチ悪いわ！"},
        { "location": "7012/Talk", "narrator": "ガブリエラ", "text": "……ツッコミ星人って\n意外とイイ感じな\nネーミングじゃない？"},
        { "location": "7013/Talk", "narrator": "ガブリエラ", "text": "誰でも思いつく？\nそんなわけないでしょ！"},
        { "location": "7014/Talk", "narrator": "ガブリエラ", "text": "え？　ホントに？\nホントのホントに？\n……もう……。"},
        { "location": "7015/Talk", "narrator": "みやび", "text": "こういう回でも\n隙あらば拾っていかん\nと話は回らんぞね。"},
        { "location": "7016/Talk", "narrator": "みやび", "text": "うちら黙っちょったら\nわざわざ観に来てもら\nった意味が無いきに。"},
        { "location": "7017/Talk", "narrator": "みやび", "text": "サービス精神旺盛な\n女の子は可愛いやろ？\nな？　な？"},
        { "location": "7018/Talk", "narrator": "つばめ", "text": "ここだけの話、実は最近の\n話に全くついて行けてませ\nん。"},
        { "location": "7019/Talk", "narrator": "つばめ", "text": "わたしが主人公なのに\nこれで大丈夫なのかなぁ\n……。"},
        { "location": "7020/Talk", "narrator": "つばめ", "text": "……わたし、\nほんとのほんとに\n主人公ですよねっ！？"},
        { "location": "7021/Talk", "narrator": "神楽", "text": "つばめさん、大丈夫。\n心配ご無用です！"},
        { "location": "7022/Talk", "narrator": "神楽", "text": "つばめさんが脇役でも\nモブでも私は変わらず\n愛でますから！"},
        { "location": "7023/Talk", "narrator": "神楽", "text": "……ところで、\n等身大つばめさんは\nいつ発売でしたっけ？"},
        { "location": "7024/Talk", "narrator": "つばめ", "text": "前回のあらすじっ！！"},
        { "location": "7025/Talk", "narrator": "ガブリエラ", "text": "え？　何？\n珍しくやる気出してて\nどうしちゃったの？"},
        { "location": "7026/Talk", "narrator": "みやび", "text": "珍しいことなら\nそない水差さんと\n見守っちゃろうや。"},
        { "location": "7027/Talk", "narrator": "アーヤ", "text": "ええ、空回りしても\n温かい目で見守るのよ。"},
        { "location": "7028/Talk", "narrator": "つばめ", "text": "なんだか微妙にクールな\n反応だけどいきます！"},
        { "location": "7029/Talk", "narrator": "つばめ", "text": "前回は、わたしたちが\n全滅したかと思いきや\nでっかい牛が現われ――"},
        { "location": "7030/Talk", "narrator": "ガブリエラ", "text": "いきなり雑過ぎっ！"},
        { "location": "7031/Talk", "narrator": "つばめ", "text": "えっ？\n……間違ってた？"},
        { "location": "7032/Talk", "narrator": "アーヤ", "text": "間違ってはいないけれど、\nそれで伝わるのかしら？"},
        { "location": "7033/Talk", "narrator": "みやび", "text": "ちゅうか、むしろ\nそれで伝わる人は\n前回しっかり見ちょる。"},
        { "location": "7034/Talk", "narrator": "つばめ", "text": "なんだか反応がイマイチ\nだけど続けます！"},
        { "location": "7035/Talk", "narrator": "アーヤ", "text": "あら、今日のつばめは\nメンタルが強いわね。"},
        { "location": "7036/Talk", "narrator": "つばめ", "text": "それで世界を滅ぼそう\nとした牛の前に救世主\n音羽さんが現われて――"},
        { "location": "7037/Talk", "narrator": "ガブリエラ", "text": "雑って言うかもう微妙に\n違う話になってない？"},
        { "location": "7038/Talk", "narrator": "つばめ", "text": "わたしたち大復活！\n歌の力で世界を救うよ！"},
        { "location": "7039/Talk", "narrator": "みやび", "text": "何や違う作品の紹介聞いて\nるみたいやね。"},
        { "location": "7040/Talk", "narrator": "アーヤ", "text": "微妙に合ってるのが反応に\n難しいところではあるわ。"},
        { "location": "7041/Talk", "narrator": "つばめ", "text": "さあ、今こそ力を一つに、\nわたしたち合体しちゃい\nます！！"},
        { "location": "7042/Talk", "narrator": "ガブリエラ", "text": "それは絶対に\n間違ってるから！！"},
        { "location": "7043/Talk", "narrator": "つばめ", "text": "そんなわけでＶＴＲ\nスタート！"},
        { "location": "7044/Talk", "narrator": "みやび", "text": "※注：\nこれは牛ではなく\n神楽です。"},
        { "location": "7045/Talk", "narrator": "ガブリエラ", "text": "ベルフェゴールって\n悪魔だったっけ？"},
        { "location": "7046/Talk", "narrator": "つばめ", "text": "あれ？　ここって\n何がどうなったの？"},
        { "location": "7047/Talk", "narrator": "みやび", "text": "まぶしい裸のまんま\nいうのも見づらいから\n視聴者への配慮やな。"},
        { "location": "7048/Talk", "narrator": "アーヤ", "text": "それは違うと\n思うけど……。"},
        { "location": "7049/Talk", "narrator": "みやび", "text": "しかしここ、この手の\n服でこんな風に降下\nしたらいかんぞね。"},
        { "location": "7050/Talk", "narrator": "みやび", "text": "スカートが豪快にめくれ\n上がってしまうはずや。"},
        { "location": "7051/Talk", "narrator": "みやび", "text": "パンツも胸も\n見えまくりや！"},
        { "location": "7052/Talk", "narrator": "みやび", "text": "せやのに見えてへんなんて\nサービス不足と違うん？"},
        { "location": "7053/Talk", "narrator": "つばめ", "text": "気になったの\nそこなんですかっ！？"},
        { "location": "7054/Talk", "narrator": "ガブリエラ", "text": "で、ここはどこ？"},
        { "location": "7055/Talk", "narrator": "つばめ", "text": "「イシュリール」だよ！　\nメノウちゃんのアルバム\nの！"},
        { "location": "7056/Talk", "narrator": "ガブリエラ", "text": "は？\nまたそのパターン？"},
        { "location": "7057/Talk", "narrator": "つばめ", "text": "まさかこんな形で\nその世界が見られる\nなんて感激ーっ！！"},
        { "location": "7058/Talk", "narrator": "ガブリエラ", "text": "いやそうじゃなくて\n夢なのか現実なのか\nってこと。"},
        { "location": "7059/Talk", "narrator": "つばめ", "text": "だからイシュリールは\nこの世に存在しない\nだけで現実だよ！"},
        { "location": "7060/Talk", "narrator": "ガブリエラ", "text": "ああ、正にこじらせた\nファンって感じね。\n社会復帰難しそう。"},
        { "location": "7061/Talk", "narrator": "つばめ", "text": "そこまで深刻なの！？"},
        { "location": "7062/Talk", "narrator": "神楽", "text": "つばめさんを永遠に\n撫でられる聖地は\nここですか！？"},
        { "location": "7063/Talk", "narrator": "ガブリエラ", "text": "ていうか、ここって\n神楽の世界観でしょ？"},
        { "location": "7064/Talk", "narrator": "みやび", "text": "ところで神楽って音羽とも\nイチャイチャしとったん？"},
        { "location": "7065/Talk", "narrator": "神楽", "text": "音羽とは共に闘うと書いて\n友と読む！　な関係でした\nね。"},
        { "location": "7066/Talk", "narrator": "神楽", "text": "ファイトー！\nイッパーツ！！\nって感じです。"},
        { "location": "7067/Talk", "narrator": "みやび", "text": "言わんとしちょる\nことはわかるんやけど\n危ないなぁ。"},
        { "location": "7068/Talk", "narrator": "神楽", "text": "音羽とはいつも言いたい\nことズバズバ言い合って\nたし──"},
        { "location": "7069/Talk", "narrator": "神楽", "text": "死ねばイイのにって\nお互い思ったことも\nありましたよ。"},
        { "location": "7070/Talk", "narrator": "ガブリエラ", "text": "神楽が言うとほんとシャレ\nにならないから。"},
        { "location": "7071/Talk", "narrator": "みやび", "text": "せやって。\nつばめちゃん、\nよかったなぁ。"},
        { "location": "7072/Talk", "narrator": "つばめ", "text": "ふえっ？"},
        { "location": "7073/Talk", "narrator": "みやび", "text": "ライバル現る！\n展開じゃなくて。"},
        { "location": "7074/Talk", "narrator": "つばめ", "text": "そんな、音羽さんと\n比べられるのも\nおこがましいよー。"},
        { "location": "7075/Talk", "narrator": "みやび", "text": "つまり、カワイイ枠の\n奪い合いにはならずに\nすむいうことやき。"},
        { "location": "7076/Talk", "narrator": "ガブリエラ", "text": "カワイイ枠？\nそんな枠あったの？"},
        { "location": "7077/Talk", "narrator": "神楽", "text": "カワイイ枠は永遠に\nつばめさんの為に\nありますから！！"},
        { "location": "7078/Talk", "narrator": "つばめ", "text": "そ、そうなんだ……。"},
        { "location": "7079/Talk", "narrator": "みやび", "text": "しっかし映像は\nシリアスなのにここは\nこんなノリとは。"},
        { "location": "7080/Talk", "narrator": "みやび", "text": "ほんまにこんなんで\nええん？"},
        { "location": "7081/Talk", "narrator": "神楽", "text": "いいんです！\nカワイイは正義！"},
        { "location": "7082/Talk", "narrator": "神楽", "text": "尊いものこそ最も重視\nすべきなんです！！"},
        { "location": "7083/Talk", "narrator": "みやび", "text": "それにしても\n絵面だけ見ると、\nほんまに桃源郷やね。"},
        { "location": "7084/Talk", "narrator": "ガブリエラ", "text": "一方、水面下では\n愛憎ドロドロな\n足の引っ張り合いが？"},
        { "location": "7085/Talk", "narrator": "神楽", "text": "このラブラブ空間に\n変な言いがかりは\nやめてください！"},
        { "location": "7086/Talk", "narrator": "つばめ", "text": "でも三人ってことは\n三角関係だよね？"},
        { "location": "7087/Talk", "narrator": "神楽", "text": "違います！\n私はつばめさんも音羽も\nどっちもＯＫです！"},
        { "location": "7088/Talk", "narrator": "ガブリエラ", "text": "それって、ただの\n二股なんじゃ……。"},
        { "location": "7089/Talk", "narrator": "つばめ", "text": "神楽ちゃん、そういう\n人だったんだね……。"},
        { "location": "7090/Talk", "narrator": "神楽", "text": "待ってください！\nなんで私いつの間にか\n窮地に陥ってるんですか？"},
        { "location": "7091/Talk", "narrator": "神楽", "text": "さては、みやびさん、\n謀りましたね！？"},
        { "location": "7092/Talk", "narrator": "みやび", "text": "……今さら気づいても\nもう手遅れぞね。"},
        { "location": "7093/Talk", "narrator": "つばめ", "text": "えぇっ！？\nみやびさん、ホントに\nそうだったの！？"},
        { "location": "7094/Talk", "narrator": "ガブリエラ", "text": "みやびがテキトーに\n流してるだけなのは\nいつものことでしょ。"},
        { "location": "7095/Talk", "narrator": "みやび", "text": "ガブちゃんはノリが\n悪いぞね……。"},
        { "location": "7096/Talk", "narrator": "ガブリエラ", "text": "みやびの悪ノリには\n乗らないだけだから！"},
        { "location": "7097/Talk", "narrator": "みやび", "text": "ところで尊いと言えば\nこの着てるドレスは\n胸の形わかりやすい。"},
        { "location": "7098/Talk", "narrator": "ガブリエラ", "text": "なんで唐突な「尊い」から\n胸の話になるのよ……。"},
        { "location": "7099/Talk", "narrator": "つばめ", "text": "でも音羽さんって\n胸、大きいですよね。"},
        { "location": "7100/Talk", "narrator": "神楽", "text": "つばめさん、それは\n大きくない私への\nイヤミですか！？"},
        { "location": "7101/Talk", "narrator": "ガブリエラ", "text": "大きくないって言うか\n神楽の場合、\n小さいじゃない。"},
        { "location": "7102/Talk", "narrator": "神楽", "text": "ガブちゃんひどいっ！\nもう実家に帰って！"},
        { "location": "7103/Talk", "narrator": "ガブリエラ", "text": "なんであたしが\n帰るのよ……。"},
        { "location": "7104/Talk", "narrator": "みやび", "text": "ところで、さっきから\n気になってることが\nあるんやけど。"},
        { "location": "7105/Talk", "narrator": "ガブリエラ", "text": "は？　何よ？"},
        { "location": "7106/Talk", "narrator": "みやび", "text": "画面の向こうのキミが\nなんぞ言いたそうや\nないかなーって？"},
        { "location": "7107/Talk", "narrator": "ガブリエラ", "text": "何？　言いたいことが\nあるならハッキリ\n言いなさいよ。"},
        { "location": "7108/Talk", "narrator": "ガブリエラ", "text": "で、実際のところ\n音羽の胸の感触は\nどうだったの？"},
        { "location": "7109/Talk", "narrator": "神楽", "text": "それはモチロン、\nぽよんぽよんですよ！\n女神の枕ですよ！"},
        { "location": "7110/Talk", "narrator": "つばめ", "text": "神楽ちゃん……。"},
        { "location": "7111/Talk", "narrator": "神楽", "text": "ガブちゃん、\n私をハメましたね？"},
        { "location": "7112/Talk", "narrator": "ガブリエラ", "text": "神楽が自爆しただけで\nしょ……。"},
        { "location": "7113/Talk", "narrator": "みやび", "text": "おーっと、ここで遂に\nつばめちゃん復活！？"},
        { "location": "7114/Talk", "narrator": "ガブリエラ", "text": "でもここのつばめ\nなんか変じゃない？\n違和感って言うか。"},
        { "location": "7115/Talk", "narrator": "みやび", "text": "これはあれやね、\n最近話題の自然な表情を\nするロボット。"},
        { "location": "7116/Talk", "narrator": "つばめ", "text": "あっ、あの不気味の谷\n……でしたっけ？\nあれ真っ盛りの！"},
        { "location": "7117/Talk", "narrator": "ガブリエラ", "text": "アーヤのお姉さんと\n同じ名前のロボットが\n確かいたような。"},
        { "location": "7118/Talk", "narrator": "神楽", "text": "だめですよ、\nそんなこと言ったら！"},
        { "location": "7119/Talk", "narrator": "神楽", "text": "ロボットだったら我慢\n出来ずにお持ち帰り\nしちゃいます！"},
        { "location": "7120/Talk", "narrator": "神楽", "text": "つばめさんは不気味でも\nカワイイですから！"},
        { "location": "7121/Talk", "narrator": "みやび", "text": "だめだ、うちら\nみんな病みすぎや。"},
        { "location": "7122/Talk", "narrator": "ガブリエラ", "text": "うちらってあたしを\n巻き込まないでよ！"},
        { "location": "7123/Talk", "narrator": "ガブリエラ", "text": "でも実際、このつばめは\n本人じゃないんでしょ？"},
        { "location": "7124/Talk", "narrator": "ガブリエラ", "text": "音羽が作り出した\nつばめの虚像とかで。"},
        { "location": "7125/Talk", "narrator": "神楽", "text": "ということは、\nつばめさんは別にいると。"},
        { "location": "7126/Talk", "narrator": "神楽", "text": "ということは、\n本人を連れて来れば\nつばめさんは２人！"},
        { "location": "7127/Talk", "narrator": "神楽", "text": "って、そんなことより\n私、気づいちゃいました！"},
        { "location": "7128/Talk", "narrator": "神楽", "text": "このつばめさんは\nお持ち帰り可能ってこと\nじゃないですか！"},
        { "location": "7129/Talk", "narrator": "みやび", "text": "ちゃんと音羽にライセンス\n料払うんやよー。"},
        { "location": "7130/Talk", "narrator": "神楽", "text": "お金で済むことなら\n楽勝です！"},
        { "location": "7131/Talk", "narrator": "ガブリエラ", "text": "あ……神楽ってもう\n本気で手遅れなんだ。"},
        { "location": "7132/Talk", "narrator": "神楽", "text": "むしろ、何を今さら\nですよ！"},
        { "location": "7133/Talk", "narrator": "ガブリエラ", "text": "開き直るなっ！"},
        { "location": "7134/Talk", "narrator": "神楽", "text": "ああ、つばめさんの手と\n私の手が重なり合う……。"},
        { "location": "7135/Talk", "narrator": "神楽", "text": "これがこんな悲しい\nタイミングじゃ\nなければ……。"},
        { "location": "7136/Talk", "narrator": "神楽", "text": "なければ、ここから\nお楽しみタイム\nだったのに！"},
        { "location": "7137/Talk", "narrator": "神楽", "text": "……あれ？　ツッコミ\n無しですか？"},
        { "location": "7138/Talk", "narrator": "ガブリエラ", "text": "もう一々触るのも面倒で。"},
        { "location": "7139/Talk", "narrator": "神楽", "text": "見捨てられた！？"},
        { "location": "7140/Talk", "narrator": "神楽", "text": "「つばめさんの背中\n尊い！！」って\nこの時思ってました。"},
        { "location": "7141/Talk", "narrator": "みやび", "text": "はい、つばめちゃん\n感想をどうぞ。"},
        { "location": "7142/Talk", "narrator": "つばめ", "text": "……虚無……。"},
        { "location": "7143/Talk", "narrator": "神楽", "text": "つばめさんがらしくない\n単語で私を責める！？"},
        { "location": "7144/Talk", "narrator": "神楽", "text": "このナチュラルな\nサディスティックが\nたまりません！"},
        { "location": "7145/Talk", "narrator": "神楽", "text": "私はそんな余韻に\n浸りつつ一時退避っ。"},
        { "location": "7146/Talk", "narrator": "アーヤ", "text": "って、終わってから\n交代されても……。"},
        { "location": "7147/Talk", "narrator": "みやび", "text": "今回は神楽得な回\nやったからアーヤも\n交代しづらかったん？"},
        { "location": "7148/Talk", "narrator": "アーヤ", "text": "そうね。\n内容的にも私にはいじり\nづらい回だったし。"},
        { "location": "7149/Talk", "narrator": "ガブリエラ", "text": "ダメよ、アーヤがもっと\nちゃんと仕切らなきゃ。"},
        { "location": "7150/Talk", "narrator": "ガブリエラ", "text": "あたしツッコミしか\nしてないツッコミ星人\nになっちゃうし。"},
        { "location": "7151/Talk", "narrator": "つばめ", "text": "……それはいつもの\nことなんじゃ……。"},
        { "location": "7152/Talk", "narrator": "アーヤ", "text": "ギャヴィの意見も\nもっともね。\nここは反省しておくわ。"},
        { "location": "7153/Talk", "narrator": "アーヤ", "text": "……一度、漫才教室\nとかに行ってみるべき\nかしら？"},
        { "location": "7154/Talk", "narrator": "アーヤ", "text": "面白い話ができれば子供\nたちも喜びそうだしね。"}
    ]
}
