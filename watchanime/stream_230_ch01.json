{
    "dir": "stream_230_ch01.json",
    "type": "watchanime",
    "info": {
    },
    "entry":
    [
        { "location": "4560/Talk", "narrator": "神楽", "text": "まあ私としても義理で\n聞いただけでどうでも\nいいんですけど。"},
        { "location": "4561/Talk", "narrator": "神楽", "text": "正直興味無いので\nさっさと済ませて\n欲しいんですけど。"},
        { "location": "4562/Talk", "narrator": "ガブリエラ", "text": "うわ……。\nいきなり何言ってんの\nこのヘンタイ。"},
        { "location": "4563/Talk", "narrator": "つばめ", "text": "ガブちゃん、それは\nちょっと酷いよ。"},
        { "location": "4564/Talk", "narrator": "ガブリエラ", "text": "デリカシーの無いヤツには\nこれでいいの！"},
        { "location": "4565/Talk", "narrator": "つばめ", "text": "あはは……。あんまり\n気にしないでね……。"},
        { "location": "4566/Talk", "narrator": "ガブリエラ", "text": "ん？　何黙ってるのよ\nムッツリヘンタイ。"},
        { "location": "4567/Talk", "narrator": "アーヤ", "text": "つまりギャヴィは\nわかってて敢えて\n聞いたわけね？"},
        { "location": "4568/Talk", "narrator": "ガブリエラ", "text": "あっ！　しまった！"},
        { "location": "4569/Talk", "narrator": "アーヤ", "text": "……ギャヴィ？"},
        { "location": "4570/Talk", "narrator": "ガブリエラ", "text": "あははっ、ちょっとした\n冗談だってば……。"},
        { "location": "4571/Talk", "narrator": "ガブリエラ", "text": "そう言えば毎度毎度\nここで追い出されるの\nそろそろやめない？"},
        { "location": "4572/Talk", "narrator": "ガブリエラ", "text": "この後アンタが何を\n観てるのか少しだけ\n気になるし……。"},
        { "location": "4573/Talk", "narrator": "ガブリエラ", "text": "って、やっぱりダメ？\nうーっ！\nこのヘンタイっ！"},
        { "location": "4574/Talk", "narrator": "つばめ", "text": "あ、なんか今回は\nあまり喋れなくて\nごめんなさい。"},
        { "location": "4575/Talk", "narrator": "つばめ", "text": "ついつい画面に\n見入っちゃって、\n反省したり……。"},
        { "location": "4576/Talk", "narrator": "つばめ", "text": "次はがんばります！\nうん、本当に本当に\nがんばりますよ！"},
        { "location": "4577/Talk", "narrator": "神楽", "text": "さてさいいよいよ\n次回はクライマックス\nですよ？"},
        { "location": "4578/Talk", "narrator": "神楽", "text": "いえ、べつに最終回\nじゃなくてＡｃｔ．４\nのって意味ですけど。"},
        { "location": "4579/Talk", "narrator": "神楽", "text": "怒濤の展開に\nきっと私は涙する。"},
        { "location": "4580/Talk", "narrator": "神楽", "text": "……って、私！？"},
        { "location": "4581/Talk", "narrator": "アーヤ", "text": "５人で出たり入ったり\nだとどうしても私が\n出る機会が減るわね。"},
        { "location": "4582/Talk", "narrator": "アーヤ", "text": "あなたとはもっと\nお話ししたいのだけど\nごめんなさいね。"},
        { "location": "4583/Talk", "narrator": "アーヤ", "text": "可愛いあの子たちに\n免じて許してね♪"},
        { "location": "4584/Talk", "narrator": "つばめ", "text": "え、えーと、あの、\n今回もよろしく\nお願いしますっ。"},
        { "location": "4585/Talk", "narrator": "ガブリエラ", "text": "何いきなり\nかしこまってるのよ。"},
        { "location": "4586/Talk", "narrator": "アーヤ", "text": "今回も内容が内容なだけに\n緊張しているんでしょ？"},
        { "location": "4587/Talk", "narrator": "神楽", "text": "私とつばめさんの\nラブラブストーリーが\n遂に始まりますね！"},
        { "location": "4588/Talk", "narrator": "ガブリエラ", "text": "って、神楽！？\nあんた来たの？"},
        { "location": "4589/Talk", "narrator": "神楽", "text": "え？　どうして来たら\n悪いみたいな言い方\nするんですか？"},
        { "location": "4590/Talk", "narrator": "ガブリエラ", "text": "悪くはないけど\nよく来たわねって。"},
        { "location": "4591/Talk", "narrator": "神楽", "text": "だって、つばめさんに\n会う為なら空気なんて\n読みませんから！"},
        { "location": "4592/Talk", "narrator": "つばめ", "text": "少しは空気読んだ方が\nいいんじゃないかな？"},
        { "location": "4593/Talk", "narrator": "神楽", "text": "ピンチの時は空気など\n読むな。これが座右の\n銘ですから。"},
        { "location": "4594/Talk", "narrator": "つばめ", "text": "あ、神楽ちゃんも\n大変な時ではあるんだね。"},
        { "location": "4595/Talk", "narrator": "神楽", "text": "ええ、つばめさんの\nとなりにいたら\n心臓が大変なことに！"},
        { "location": "4596/Talk", "narrator": "ガブリエラ", "text": "……やっぱり、つまみ\n出した方がよくない？"},
        { "location": "4597/Talk", "narrator": "神楽", "text": "あぁっ！\nせめてみやびさんが来る\nまで慈悲をっ！"},
        { "location": "4598/Talk", "narrator": "アーヤ", "text": "みやびのことだから\n卯月がいるならいいや\nって来ない可能性も。"},
        { "location": "4599/Talk", "narrator": "神楽", "text": "それならそれで私の勝ち\nってことですよね？"},
        { "location": "4600/Talk", "narrator": "ガブリエラ", "text": "一体、何の勝ち負け\nなのよ……。"},
        { "location": "4601/Talk", "narrator": "神楽", "text": "それではさっそく\nぜんかいまでの\nあらすじっ！"},
        { "location": "4602/Talk", "narrator": "ガブリエラ", "text": "ちょっと！\nいきなりふざけすぎ\nじゃない？"},
        { "location": "4603/Talk", "narrator": "神楽", "text": "べつに真面目に\nやってもいいですけど\n本当にいいんですか？"},
        { "location": "4604/Talk", "narrator": "神楽", "text": "本編が本編なだけに\n大変なことに\nなっちゃいますよ？"},
        { "location": "4605/Talk", "narrator": "ガブリエラ", "text": "うっ……確かに\nその通りかもだけど、\nそれを神楽が言うな！"},
        { "location": "4606/Talk", "narrator": "つばめ", "text": "ねぇ、わたしのせいで\n全てを失ったって、\n何を失っちゃったの？"},
        { "location": "4607/Talk", "narrator": "つばめ", "text": "わたしは神楽ちゃんに\n何をしちゃったの？"},
        { "location": "4608/Talk", "narrator": "神楽", "text": "つばめさん、酷い！\n忘れちゃったなんて！"},
        { "location": "4609/Talk", "narrator": "神楽", "text": "つばめさんは私の\n大切なものを盗んで\nいったんです。"},
        { "location": "4610/Talk", "narrator": "神楽", "text": "それは…………。\n私の心です！"},
        { "location": "4611/Talk", "narrator": "ガブリエラ", "text": "……うん、\n言うと思った。"},
        { "location": "4612/Talk", "narrator": "神楽", "text": "あぁ、つばめさんの\n可愛らしいお口から\n血がっ！"},
        { "location": "4613/Talk", "narrator": "神楽", "text": "実はこの時その血を\nなめとりたかったのは\n秘密です♪"},
        { "location": "4614/Talk", "narrator": "神楽", "text": "ところで血と言えば、\n皆さんの血液型は\n何型なんですか？"},
        { "location": "4615/Talk", "narrator": "ガブリエラ", "text": "またいきなり話題を\nコロコロと\n変えてくれるわね。"},
        { "location": "4616/Talk", "narrator": "ガブリエラ", "text": "血液型なんてアーヤは\n聞くまでも無くＡに\n決まってるでしょ？"},
        { "location": "4617/Talk", "narrator": "アーヤ", "text": "えーと……それよく\n言われるんだけれど、\n実は私、Ｏなのよね。"},
        { "location": "4618/Talk", "narrator": "神楽", "text": "意外萌えですね！\nＢじゃないあたりが\nまだ甘いですけど。"},
        { "location": "4619/Talk", "narrator": "アーヤ", "text": "甘いって\n言われても……。"},
        { "location": "4620/Talk", "narrator": "ガブリエラ", "text": "ハズレかー、残念ー。\nでも、みやびは絶対Ｂ\nよね？"},
        { "location": "4621/Talk", "narrator": "みやび", "text": "半分だけ正解やね。\nうちはＡＢやき。"},
        { "location": "4622/Talk", "narrator": "神楽", "text": "みやびさんはむしろ\nＡＢの方がしっくり\nきますよね。"},
        { "location": "4623/Talk", "narrator": "みやび", "text": "ま、まぁ、敢えて\n理由は聞かんとくわ。"},
        { "location": "4624/Talk", "narrator": "ガブリエラ", "text": "じゃあ次はつばめ！\nつばめは絶対にＡ！\nじゃなかったら怒る！"},
        { "location": "4625/Talk", "narrator": "つばめ", "text": "正解だけど、\nなんでＡ以外だったら\nダメなの～？"},
        { "location": "4626/Talk", "narrator": "神楽", "text": "ガブちゃんは\nどう見てもＢですよね？"},
        { "location": "4627/Talk", "narrator": "ガブリエラ", "text": "そうだけど、あたしも\n意外ねって言われる\nクチなんだけど？"},
        { "location": "4628/Talk", "narrator": "ガブリエラ", "text": "ちなみＲＨ－のＢよ。\n☆５レアリティ\nなんだからね！"},
        { "location": "4629/Talk", "narrator": "みやび", "text": "でも確か外国やと\n案外ＲＨ－が\nいるいう話やき。"},
        { "location": "4630/Talk", "narrator": "神楽", "text": "つまりガブちゃんは\n日本限定の☆５キャラ\nなんですね。"},
        { "location": "4631/Talk", "narrator": "つばめ", "text": "ていうかガブちゃん、\n血液型占い信じてるの？"},
        { "location": "4632/Talk", "narrator": "神楽", "text": "確かに日本人しか\n信じてないって\n言われてますよね。"},
        { "location": "4633/Talk", "narrator": "ガブリエラ", "text": "べ、べつに空気読んで\n話を合わせてる\nだけだからっ……。"},
        { "location": "4634/Talk", "narrator": "ガブリエラ", "text": "そ、それより、\n人に聞いといて\n神楽は何型なのよ？"},
        { "location": "4635/Talk", "narrator": "神楽", "text": "私はつばめさんと同じ\nＡですから血液の交換\nもできちゃいますよ！"},
        { "location": "4636/Talk", "narrator": "ガブリエラ", "text": "……それはさすがに\nどん引き過ぎる\n発言じゃない！？"},
        { "location": "4637/Talk", "narrator": "神楽", "text": "いいじゃないですか、\nこれくらいしないと\n$handle$さんが"},
        { "location": "4638/Talk", "narrator": "神楽", "text": "画面に集中しちゃって\nもっとどん引き\nしちゃいますよ？"},
        { "location": "4639/Talk", "narrator": "神楽", "text": "つまりアレですよ、\nこれこそ正に\n毒を持って毒を制す！"},
        { "location": "4640/Talk", "narrator": "ガブリエラ", "text": "むしろ毒と毒とが\n入り混じって\n猛毒になってるわよ！"},
        { "location": "4641/Talk", "narrator": "神楽", "text": "ところで\n$handle$さんも\n聞いて欲しいですか？"},
        { "location": "4642/Talk", "narrator": "ガブリエラ", "text": "ちょっと神楽！\n少しはオブラートに\n包みなさいよ！"},
        { "location": "4643/Talk", "narrator": "ガブリエラ", "text": "ああ見えてアイツの\nメンタルめちゃくちゃ\n弱いんだから。"},
        { "location": "4644/Talk", "narrator": "みやび", "text": "ガブちゃんも\nもうちいっとだけでも\n気を遣うてや……。"},
        { "location": "4645/Talk", "narrator": "みやび", "text": "せやけどここの\nつばめちゃんは、\nほんま聖女やね。"},
        { "location": "4646/Talk", "narrator": "みやび", "text": "自らを犠牲にして\n神楽に捧げるなんて\n怖くなかったん？"},
        { "location": "4647/Talk", "narrator": "神楽", "text": "えっ？\nみやびさんそれ本気で\n言ってるんですか？"},
        { "location": "4648/Talk", "narrator": "みやび", "text": "おや？\nうちの勘違いやったき？"},
        { "location": "4649/Talk", "narrator": "ガブリエラ", "text": "確かこのつばめの発言\nって神楽のＮＧワード\nだったんだっけ？"},
        { "location": "4650/Talk", "narrator": "神楽", "text": "そうなんです！\nその真相はＣＭの後で！"},
        { "location": "4651/Talk", "narrator": "みやび", "text": "ＣＭ言うんはうちらの\nシーンのことかい！"},
        { "location": "4652/Talk", "narrator": "神楽", "text": "ＣＭと言えば……と\nいうことで、ちょっと\n退席しまーす。"},
        { "location": "4653/Talk", "narrator": "アーヤ", "text": "えーと、つまり私は\n一時的に戻って来たと\nいうことかしら？"},
        { "location": "4654/Talk", "narrator": "ガブリエラ", "text": "ていうか、神楽は\n何しに出てったのよ？"},
        { "location": "4655/Talk", "narrator": "ガブリエラ", "text": "ていうか、アラートが\n出るの遅すぎでしょ。\n常識的に考えて。"},
        { "location": "4656/Talk", "narrator": "つばめ", "text": "でもアラートってどういう\n仕組みで発動するんだろ？"},
        { "location": "4657/Talk", "narrator": "ガブリエラ", "text": "センサーから直接発動\nさせてるわけじゃ\nないってことよね？"},
        { "location": "4658/Talk", "narrator": "アーヤ", "text": "つまり作為的に発動を\n遅らされた可能性が\nあるってことね。"},
        { "location": "4659/Talk", "narrator": "みやび", "text": "実のところまほさんも\n管理庁がアラート出す\nタイミングを"},
        { "location": "4660/Talk", "narrator": "みやび", "text": "仕組んでるじゃないかって\n疑っちょるみたいや。"},
        { "location": "4661/Talk", "narrator": "アーヤ", "text": "このヘリとアラートの\n遅さの関係性は確かに\n疑うに値するわね。"},
        { "location": "4662/Talk", "narrator": "神楽", "text": "それでは回答です！\nつばめさんはＴＰＯを\n弁えてください。"},
        { "location": "4663/Talk", "narrator": "神楽", "text": "例えばこれがバトル中\nではなく夜二人きりで\n甘いムードの中、"},
        { "location": "4664/Talk", "narrator": "神楽", "text": "全く同じセリフを\n言ったとしましょう。"},
        { "location": "4665/Talk", "narrator": "神楽", "text": "ここが私の寝室で\nベッドの上に二人きり\nだと思ってください。"},
        { "location": "4666/Talk", "narrator": "神楽", "text": "さあ、つばめさん、\nどうぞ！"},
        { "location": "4667/Talk", "narrator": "つばめ", "text": "えぇ～……じゃあ、\n「壊していいよ？\nわたしのこと」かな？"},
        { "location": "4668/Talk", "narrator": "神楽", "text": "はうぅぅぅぅぅん！\nこれで襲わずに\nいられるわけがない！"},
        { "location": "4669/Talk", "narrator": "ガブリエラ", "text": "って、ベッドの上でも\nこんな顔になっちゃう\nわけ！？"},
        { "location": "4670/Talk", "narrator": "神楽", "text": "もちろんですよ！\nああっ、つばめさんの\n運命やいかに……。"},
        { "location": "4671/Talk", "narrator": "アーヤ", "text": "なんだか別の意味で\nドキドキしてきたわ。"},
        { "location": "4672/Talk", "narrator": "アーヤ", "text": "つばめの貞操は私が\nしっかり護らなくちゃ！"},
        { "location": "4673/Talk", "narrator": "神楽", "text": "いえ、それは私の使命\nですからアーヤさんには\n譲りません！"},
        { "location": "4674/Talk", "narrator": "ガブリエラ", "text": "神楽はどう見ても\n襲う側でしょ！"},
        { "location": "4675/Talk", "narrator": "ガブリエラ", "text": "あっ、このシーンって\nリリース前から物議を\n醸してたビジュアル？"},
        { "location": "4676/Talk", "narrator": "アーヤ", "text": "それの別アングルから\n撮影した映像って\nところかしら？"},
        { "location": "4677/Talk", "narrator": "ガブリエラ", "text": "ところでつばめが珍しく\n良いこと言ってるわよね。"},
        { "location": "4678/Talk", "narrator": "つばめ", "text": "確かに珍しいかも\n知れないけどわざわざ\n言わないでも……。"},
        { "location": "4679/Talk", "narrator": "ガブリエラ", "text": "それにしてもあれが\nこんなことになってる\nシーンだったなんて。"},
        { "location": "4680/Talk", "narrator": "神楽", "text": "でも考証好きな人に\nとっては予想の範囲内\nですよねー。"},
        { "location": "4681/Talk", "narrator": "神楽", "text": "そしてここで颯爽と\nガブちゃん参上！\nお約束のカッコ良さ！"},
        { "location": "4682/Talk", "narrator": "神楽", "text": "ていうか、これって\n私が悪の親玉みたい\nじゃないですか！"},
        { "location": "4683/Talk", "narrator": "みやび", "text": "そないなことないで。"},
        { "location": "4684/Talk", "narrator": "神楽", "text": "みやびさん！\nやっぱりみやびさんは\n私の味方でした！"},
        { "location": "4685/Talk", "narrator": "みやび", "text": "卯月は親玉ちゅうより\n悪の手下ちゅうか\n怪人の類いやね。"},
        { "location": "4686/Talk", "narrator": "神楽", "text": "……呪います。"},
        { "location": "4687/Talk", "narrator": "みやび", "text": "ええけんど、いきなり\n落差激しすぎや\nないやろか？"},
        { "location": "4688/Talk", "narrator": "つばめ", "text": "でも何で真幌さんも\nわたしたちと一緒に\n来てたんだろ？"},
        { "location": "4689/Talk", "narrator": "みやび", "text": "そら保護者がおらんと\n未成年だけでの宿泊は\n難しいきに。"},
        { "location": "4690/Talk", "narrator": "みやび", "text": "しっかし情報管理庁も\n一枚岩やないことが\n露呈したわけやね。"},
        { "location": "4691/Talk", "narrator": "神楽", "text": "しかもここ、\nもう私のこと殺る気\nマンマンですよね！？"},
        { "location": "4692/Talk", "narrator": "神楽", "text": "でも、ここからの\nつばめさんは最高に\nカッコイイです！"},
        { "location": "4693/Talk", "narrator": "神楽", "text": "これだけでご飯三杯は\nいけます。\nいけちゃいますとも。"},
        { "location": "4694/Talk", "narrator": "ガブリエラ", "text": "なのに神楽の返答は\n最低よね。つばめも\n報われないわ。"},
        { "location": "4695/Talk", "narrator": "ガブリエラ", "text": "まぁ、神楽の気持ちも\nわからなくないけど。"},
        { "location": "4696/Talk", "narrator": "神楽", "text": "ガブちゃんは呪いリスト\nから外してあげます！"},
        { "location": "4697/Talk", "narrator": "みやび", "text": "しっかしここ、\n一体どうなってるん？\nて聞くだけ野暮か。"},
        { "location": "4698/Talk", "narrator": "みやび", "text": "卯月のフェノメノンの\n中なんやし。"},
        { "location": "4699/Talk", "narrator": "ガブリエラ", "text": "ちょっと待って！\nてことは、このヘリも\n神楽のフェノメノンの"},
        { "location": "4700/Talk", "narrator": "ガブリエラ", "text": "筋書き通りの行動って\nことなわけ？"},
        { "location": "4701/Talk", "narrator": "神楽", "text": "え？　私、ヘリなんて\n呼んでませんし、\n知らなかったですよ？"},
        { "location": "4702/Talk", "narrator": "ガブリエラ", "text": "それにしては\n連れて行かれる時、\n妙に冷静だったけど？"},
        { "location": "4703/Talk", "narrator": "神楽", "text": "もうこの時はトランス\n状態で、ただ硬直して\nいただけですってば。"},
        { "location": "4704/Talk", "narrator": "みやび", "text": "ヘリがフェノメノンを\n突き破れること自体が\nおかしいぞね。"},
        { "location": "4705/Talk", "narrator": "みやび", "text": "それができるなら\nうちら必要無いんと\n違うか？"},
        { "location": "4706/Talk", "narrator": "ガブリエラ", "text": "神楽はもう裏切り者\nなんだから手土産に\n答えて行きなさいよ。"},
        { "location": "4707/Talk", "narrator": "神楽", "text": "私だけのけ者だなんて\n酷いです！"},
        { "location": "4708/Talk", "narrator": "ガブリエラ", "text": "そもそも平然とここに\n混ざって話してるのが\nおかしいでしょ。"},
        { "location": "4709/Talk", "narrator": "みやび", "text": "その図太いちゅうか\n根性すわっちょるのは\n感心するけんど。"},
        { "location": "4710/Talk", "narrator": "神楽", "text": "つばめさん助けて！\n皆さんが私を\nいじめるんです！"},
        { "location": "4711/Talk", "narrator": "つばめ", "text": "か、神楽ちゃんを\nいじめちゃダメーっ！"},
        { "location": "4712/Talk", "narrator": "ガブリエラ", "text": "むしろつばめはいじめ\nられてた当事者なのに\nブレないわね……。"},
        { "location": "4713/Talk", "narrator": "神楽", "text": "あぁっ……やっぱり\nつばめさんだけは\n私の味方ですねっ！"},
        { "location": "4714/Talk", "narrator": "つばめ", "text": "うん、それはそれとして\nあのヘリの謎は？"},
        { "location": "4715/Talk", "narrator": "神楽", "text": "あっ、今、微妙に\n私の中の信頼度が\n下がりました。"},
        { "location": "4716/Talk", "narrator": "神楽", "text": "それはきっと次回に\nみやびさんが解き明か\nしてくれますから！"},
        { "location": "4717/Talk", "narrator": "みやび", "text": "まーた適当なことを\n言うて逃げようって\n魂胆やな。"},
        { "location": "4718/Talk", "narrator": "つばめ", "text": "あっ！　また出た！\nあの白い子！"},
        { "location": "4719/Talk", "narrator": "みやび", "text": "ほんに誰なんやろな。\nたまに出てきては謎な\nこと言うんだけやし。"},
        { "location": "4720/Talk", "narrator": "つばめ", "text": "神楽ちゃんは\n知ってるんだよね？\n教えて欲しいな～？"},
        { "location": "4721/Talk", "narrator": "神楽", "text": "くっ……つばめさんが\nあざとパワーを発揮\nし始めましたね……。"},
        { "location": "4722/Talk", "narrator": "神楽", "text": "じゃあ正解は\n次回に発表します！"},
        { "location": "4723/Talk", "narrator": "ガブリエラ", "text": "そう言って誤魔化す\nつもりなの\n見え見えなんだけど？"},
        { "location": "4724/Talk", "narrator": "神楽", "text": "正解は、このクールが\n終わるまでには\n発表します！"},
        { "location": "4725/Talk", "narrator": "みやび", "text": "延びとるやないか！"},
        { "location": "4726/Talk", "narrator": "みやび", "text": "お？　今回はきれいに\nうちのツッコミで\n終わったんと違う？"},
        { "location": "4727/Talk", "narrator": "みやび", "text": "やっぱりうちが\nきちんとシメんと\n締まらんようやね。"},
        { "location": "4728/Talk", "narrator": "みやび", "text": "そろそろうちも\n本気出す時が\n来たちゅうことか？"}
    ]
}
