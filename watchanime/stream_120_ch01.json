{
    "dir": "stream_120_ch01.json",
    "type": "watchanime",
    "info": {
    },
    "entry":
    [
        { "location": "1940/Talk", "narrator": "みやび", "text": "少なくとも東京に\nいたら危ないのは\n明白やきね。"},
        { "location": "1941/Talk", "narrator": "みやび", "text": "街中も電車の中も\n気持ち人は減った気が\nするわ。"},
        { "location": "1942/Talk", "narrator": "つばめ", "text": "えぇっ！？\nこれで減ってたん\nですかっ！？"},
        { "location": "1943/Talk", "narrator": "神楽", "text": "でも電車の席が\n空いてるといつも\n座れていいですよね。"},
        { "location": "1944/Talk", "narrator": "ガブリエラ", "text": "そういう問題じゃ\nないでしょ……。"},
        { "location": "1945/Talk", "narrator": "みやび", "text": "そら日夜いたいけな\n少女たちが戦ってる\nちゅうんは――"},
        { "location": "1946/Talk", "narrator": "みやび", "text": "同情を集めやすい\nシチュエーションやきね。"},
        { "location": "1947/Talk", "narrator": "つばめ", "text": "もしかしてその為に\nトライナリーって\n女の子だけとか？"},
        { "location": "1948/Talk", "narrator": "ガブリエラ", "text": "そんなわけないでしょ。"},
        { "location": "1949/Talk", "narrator": "つばめ", "text": "で、ですよねー……。"},
        { "location": "1950/Talk", "narrator": "神楽", "text": "そ、そんなこと\nありませんよ？\n気のせいです。"},
        { "location": "1951/Talk", "narrator": "神楽", "text": "ただ詳しくないのに\nニワカ知識で生返事は\n失礼かなってだけで。"},
        { "location": "1952/Talk", "narrator": "ガブリエラ", "text": "あー、うん、だんだん\n話し合わせられなく\nなるとキツいわよね。"},
        { "location": "1953/Talk", "narrator": "つばめ", "text": "大丈夫です！　何でも\nわからないことは\n聞いてください！"},
        { "location": "1954/Talk", "narrator": "ガブリエラ", "text": "つばめってホント、\nメノウのことだけは\n自信満々よね。"},
        { "location": "1955/Talk", "narrator": "つばめ", "text": "そ、それしかとりえが\n無いみたいに\n言わないでよぅ！"},
        { "location": "1956/Talk", "narrator": "神楽", "text": "は？\n何を言い出すのかと。\nそれはありませんよ。"},
        { "location": "1957/Talk", "narrator": "つばめ", "text": "そうだよ。メノウちゃんは\n卯月さんよりも\n全然胸が大きいもん。"},
        { "location": "1958/Talk", "narrator": "ガブリエラ", "text": "確かに、胸を見比べれば\nメノウとは別人だって\n明らかよね。"},
        { "location": "1959/Talk", "narrator": "神楽", "text": "むー……\nふたりとも、後で\n呪っておきますね。"},
        { "location": "1960/Talk", "narrator": "みやび", "text": "わかるでアーヤ。\n深刻なお笑い不足。\nつまり、うち不足や。"},
        { "location": "1961/Talk", "narrator": "みやび", "text": "うちがいない時の\n物足りなさ、君も\n感じてくれちょった？"},
        { "location": "1962/Talk", "narrator": "みやび", "text": "やっぱお色気枠って\n必要やきねえ。"},
        { "location": "1963/Talk", "narrator": "ガブリエラ", "text": "もしかしてあんた、\n神楽の妄想話聞いたの\n初めて？"},
        { "location": "1964/Talk", "narrator": "ガブリエラ", "text": "言ったら失礼だけど、\nアレを真面目に聞くと\n疲れるわよ……。"},
        { "location": "1965/Talk", "narrator": "ガブリエラ", "text": "大体脈絡も無いから\nてきとーに\n聞き流しておきなさい。"},
        { "location": "1966/Talk", "narrator": "つばめ", "text": "あの、みんなちょっと\nひどいんじゃ\nないかな？"},
        { "location": "1967/Talk", "narrator": "つばめ", "text": "あ、でも今回のは\nわたしには少し\n難しかったかも？"},
        { "location": "1968/Talk", "narrator": "つばめ", "text": "わたしもラノベとか\nもっと読んだ方が\nいいですか？"},
        { "location": "1969/Talk", "narrator": "神楽", "text": "……さて、邪魔者は\nいなくなりましたね。\n二人だけです♪"},
        { "location": "1970/Talk", "narrator": "神楽", "text": "なーんて冗談ですよ。\nでも今回のお話は\n滑っちゃいましたね。"},
        { "location": "1971/Talk", "narrator": "神楽", "text": "物語の結末くらいは\n幸せな方がいいに\n決まってますよね？"},
        { "location": "1972/Talk", "narrator": "神楽", "text": "さて、ここで私から\n皆さんに、大事な\nお知らせがあります。"},
        { "location": "1973/Talk", "narrator": "みやび", "text": "まーた、\nそのパターンかね。\nネタ切れやか？"},
        { "location": "1974/Talk", "narrator": "神楽", "text": "マンネリ打破です！\n常に挑戦者なんです！"},
        { "location": "1975/Talk", "narrator": "みやび", "text": "まぁ、色々試して\nみるっちゅうのは\n悪うないけんど。"},
        { "location": "1976/Talk", "narrator": "つばめ", "text": "ちょっと待って！\nわたし、すごく嫌な\n予感がするんだけど！"},
        { "location": "1977/Talk", "narrator": "アーヤ", "text": "落ち着いて、つばめ。\n危険だとわかっていても\n一応は聞きましょう。"},
        { "location": "1978/Talk", "narrator": "神楽", "text": "……何か、いきなり\n私の扱い、酷くなって\nないですか？"},
        { "location": "1979/Talk", "narrator": "神楽", "text": "自業自得だって自覚は\nありますけど。"},
        { "location": "1980/Talk", "narrator": "みやび", "text": "あるんかい！"},
        { "location": "1981/Talk", "narrator": "神楽", "text": "だからここは\n空気読まずに話を\n続けちゃいますけど、"},
        { "location": "1982/Talk", "narrator": "神楽", "text": "実は私、つばめさんと\n結婚しようと\n思うんですよっ！！"},
        { "location": "1983/Talk", "narrator": "つばめ", "text": "……ソウナンデスカ\nソレハスゴイデスネ\nソーキソバタベタイナ"},
        { "location": "1984/Talk", "narrator": "みやび", "text": "つばめちゃんの脳が\n熱暴走しちゅう！\nはよ液体窒素入れな！"},
        { "location": "1985/Talk", "narrator": "アーヤ", "text": "それ、単につばめの\n反応が見たかった\nだけなんでしょ？"},
        { "location": "1986/Talk", "narrator": "アーヤ", "text": "さすがに\n度が過ぎてるわよ。"},
        { "location": "1987/Talk", "narrator": "神楽", "text": "いえ、こうやって日々\n冗談めかして言って\n洗脳していこうかと。"},
        { "location": "1988/Talk", "narrator": "みやび", "text": "もっとタチ悪いわ！"},
        { "location": "1989/Talk", "narrator": "アーヤ", "text": "はぁ……みやび、\n後はよろしくね……。"},
        { "location": "1990/Talk", "narrator": "みやび", "text": "よろしく言われても、\nつばめちゃーん！\n帰って来るぞね！"},
        { "location": "1991/Talk", "narrator": "つばめ", "text": "ワタシツバメ１５サイ\nフツウノオンナノコ\nダケドホントハネ"},
        { "location": "1992/Talk", "narrator": "ガブリエラ", "text": "あ、ごめん。そういえば\nつばめが取っておいてた\nプリン食べちゃったわ。"},
        { "location": "1993/Talk", "narrator": "つばめ", "text": "えええええっ！！\nこれが終わったら\n食べようと思ってたのに！"},
        { "location": "1994/Talk", "narrator": "神楽", "text": "あっ、戻りましたね。\nよかったよかった♪"},
        { "location": "1995/Talk", "narrator": "みやび", "text": "いや、つばめちゃんが\nおかしいなった原因は\n卯月やきね……。"},
        { "location": "1996/Talk", "narrator": "つばめ", "text": "さ、さぁ、\n気を取り直して今回は\n新しいお話ですよ。"},
        { "location": "1997/Talk", "narrator": "ガブリエラ", "text": "うーん、音羽は\nいつになったら\n回復するのかしらね。"},
        { "location": "1998/Talk", "narrator": "ガブリエラ", "text": "で、つばめは音羽相手に\n何やってるの？"},
        { "location": "1999/Talk", "narrator": "つばめ", "text": "うん、動けないだけで\nもしかしたら聞こえて\nるのかもって。"},
        { "location": "2000/Talk", "narrator": "つばめ", "text": "だからこうやって\n時々音羽さんと\nお話ししてるんだ。"},
        { "location": "2001/Talk", "narrator": "みやび", "text": "何やのそれ泣けるわ。\nどんだけいい子指数を\nあげるつもりかいね。"},
        { "location": "2002/Talk", "narrator": "つばめ", "text": "あ、あれっ？\nてっきり、お人形遊び\nみたいなことは"},
        { "location": "2003/Talk", "narrator": "つばめ", "text": "不謹慎だから\nやめなさいって\n言われるかと……。"},
        { "location": "2004/Talk", "narrator": "ガブリエラ", "text": "そのあたりはさすがに\nあたしたちだって\n空気読むから。"},
        { "location": "2005/Talk", "narrator": "神楽", "text": "あっ、ここのパン屋さん\nつばめさんのお気に入り\nなんですよ。"},
        { "location": "2006/Talk", "narrator": "ガブリエラ", "text": "ああ、知ってるわ。\n荻窪のお店でしょ？\n結構人気なんですってね。"},
        { "location": "2007/Talk", "narrator": "ガブリエラ", "text": "確か名物は\nサバサンドだったっけ？"},
        { "location": "2008/Talk", "narrator": "みやび", "text": "神楽坂からやと\nちぃと行くんが\n手間やけんど。"},
        { "location": "2009/Talk", "narrator": "つばめ", "text": "そうだったんですか？\nわたし全然気にして\nなかったです。"},
        { "location": "2010/Talk", "narrator": "つばめ", "text": "パンも美味しいけど、\nここのおばちゃんが\n大好きなんです。"},
        { "location": "2011/Talk", "narrator": "つばめ", "text": "美味しいパンを食べて\nおばちゃんと話すと\n元気をもらえるから。"},
        { "location": "2012/Talk", "narrator": "ガブリエラ", "text": "へー、そんな所に\n神楽と二人だけで\n行っちゃうんだー？"},
        { "location": "2013/Talk", "narrator": "みやび", "text": "ガブちゃん、\n誘われんかったから\n根に持っちょるねえ。"},
        { "location": "2014/Talk", "narrator": "つばめ", "text": "あぁっ！　そんな\nつもりは無かったのに\nごめんなさいっ！"},
        { "location": "2015/Talk", "narrator": "つばめ", "text": "じゃあ今度は５人\nみんなで一緒に\nデートしましょう！"},
        { "location": "2016/Talk", "narrator": "神楽", "text": "つばめさん……。"},
        { "location": "2017/Talk", "narrator": "みやび", "text": "この天然っぷりは\n想定外やねぇ。"},
        { "location": "2018/Talk", "narrator": "つばめ", "text": "えっ？\nわたし、何か変なこと\n言いましたか？"},
        { "location": "2019/Talk", "narrator": "みやび", "text": "何やここでその話\nふるんかね。"},
        { "location": "2020/Talk", "narrator": "ガブリエラ", "text": "ああっ、さてはつばめ、\nあんた音羽を自分の\nクランにしたいから…！"},
        { "location": "2021/Talk", "narrator": "つばめ", "text": "あっ、べつにそんな\nヨコシマな気持ちじゃ\nなくて……。"},
        { "location": "2022/Talk", "narrator": "ガブリエラ", "text": "あらそう。まあそれは\nそうと、どんな能力\nなのかは気になるわね。"},
        { "location": "2023/Talk", "narrator": "みやび", "text": "剣をぶん回しとったし\n案外アーヤとの相性が\nいいかも知れんち。"},
        { "location": "2024/Talk", "narrator": "神楽", "text": "つばめさんがもっと\n可愛らしくなる能力が\nいいですねっ。"},
        { "location": "2025/Talk", "narrator": "ガブリエラ", "text": "それって戦う時に\nどんな得があるのよ？"},
        { "location": "2026/Talk", "narrator": "神楽", "text": "私がいつもの５倍増で\nがんばっちゃいます！"},
        { "location": "2027/Talk", "narrator": "みやび", "text": "つばめちゃん効果、\n高いなー。"},
        { "location": "2028/Talk", "narrator": "つばめ", "text": "あわわわわっ、\nか、からかわないで\nくださいよっ！"},
        { "location": "2029/Talk", "narrator": "つばめ", "text": "と、ところで卯月さん\n急にどうしちゃったん\nですか？"},
        { "location": "2030/Talk", "narrator": "つばめ", "text": "何だかこのあたりから\n少し元気無いというか\nおかしかったような？"},
        { "location": "2031/Talk", "narrator": "神楽", "text": "……気になりますか？\nでも知らない方が\nいいかもですよ？"},
        { "location": "2032/Talk", "narrator": "つばめ", "text": "えぇーっ！？\nそんな風に言われたら\nもっと気になるよぉ！"},
        { "location": "2033/Talk", "narrator": "神楽", "text": "そこまで言うのなら\n仕方ありませんね。\nお話ししましょう。"},
        { "location": "2034/Talk", "narrator": "ガブリエラ", "text": "随分と勿体ぶるけど\n面白いネタ\nなんでしょうね？"},
        { "location": "2035/Talk", "narrator": "神楽", "text": "ズバリそれです！\n突然面白いネタが\n降って来たんですよ！"},
        { "location": "2036/Talk", "narrator": "つばめ", "text": "……はい？"},
        { "location": "2037/Talk", "narrator": "ガブリエラ", "text": "あっ……しまった。\nこれは触ったらマズい\nパターンだったわ。"},
        { "location": "2038/Talk", "narrator": "神楽", "text": "この時に思いついた\n話をノート三冊に\nまとめて来たので、"},
        { "location": "2039/Talk", "narrator": "神楽", "text": "今から皆さんに\nお披露目させて\nもらいますねっ♪"},
        { "location": "2040/Talk", "narrator": "みやび", "text": "何や、そっちの話かね。\nやったらうちは退散する\nかねえ。"},
        { "location": "2041/Talk", "narrator": "アーヤ", "text": "ちょ、ちょっと？\n急に何なの？"},
        { "location": "2042/Talk", "narrator": "ガブリエラ", "text": "ところで、わざわざ\n秋葉原に買いに行くなんて\n流石こだわりがあるわね。"},
        { "location": "2043/Talk", "narrator": "アーヤ", "text": "でも本にこだわるん\nだったら、むしろ\n神保町じゃないかしら？"},
        { "location": "2044/Talk", "narrator": "神楽", "text": "神保町は最後の手段\nですから、まずは\n秋葉原、なんですよ？"},
        { "location": "2045/Talk", "narrator": "アーヤ", "text": "そ、そうなの？\nべつにいいんだけど。"},
        { "location": "2046/Talk", "narrator": "つばめ", "text": "よくわからないけど、\n東京はどこでも人が\n多くて苦手だなぁ。"},
        { "location": "2047/Talk", "narrator": "ガブリエラ", "text": "あんたってすぐ\n人混みに流されて\n行きそうよね。"},
        { "location": "2048/Talk", "narrator": "つばめ", "text": "なっ、何で\n知ってるんですか！？\n見てたんですかっ！？"},
        { "location": "2049/Talk", "narrator": "ガブリエラ", "text": "えーと……。"},
        { "location": "2050/Talk", "narrator": "アーヤ", "text": "それにしてもつばめは\nメノウのことになると\n急に目が輝くのね。"},
        { "location": "2051/Talk", "narrator": "神楽", "text": "なんか話が横に逸れました\nけど、思いついたお話を\n披露するんでした！"},
        { "location": "2052/Talk", "narrator": "ガブリエラ", "text": "いや、頼んでないし、\nこのまま聞かずに\n終わりたいんだけど。"},
        { "location": "2053/Talk", "narrator": "つばめ", "text": "わーい♪\n聞きたい聞きたーい♪"},
        { "location": "2054/Talk", "narrator": "ガブリエラ", "text": "あのね……。"},
        { "location": "2055/Talk", "narrator": "神楽", "text": "ふふっ、つばめさんの\n無垢な素直さには\n敵いませんね。"},
        { "location": "2056/Talk", "narrator": "神楽", "text": "それでは始めます。\n世界を救った\n悲しき少女の物語を。"},
        { "location": "2057/Talk", "narrator": "つばめ", "text": "ぱちぱちぱちぱちっ♪"},
        { "location": "2058/Talk", "narrator": "神楽", "text": "その少女は、滅びゆく\n世界を救う為だけに\n生きていた。"},
        { "location": "2059/Talk", "narrator": "神楽", "text": "世界を救う為だけに\n選ばれ、救うことを\n強いられていた。"},
        { "location": "2060/Talk", "narrator": "神楽", "text": "取ることのない偽りの\n仮面をつけ続け、\n大切な友さえも騙して"},
        { "location": "2061/Talk", "narrator": "神楽", "text": "ただ課せられた使命を\n全うするだけの為に\nそこに存在していた。"},
        { "location": "2062/Talk", "narrator": "ガブリエラ", "text": "……ねぇ、何かそれ\nいつもの電波っぽいの\nより、話が重くない？"},
        { "location": "2063/Talk", "narrator": "神楽", "text": "せめて電波じゃなくて\n中二病っぽいって\n言ってくださいっ！"},
        { "location": "2064/Talk", "narrator": "つばめ", "text": "わたしも何かもっと\nこう、ドババーンって\n感じなのかと。"},
        { "location": "2065/Talk", "narrator": "神楽", "text": "あの、つばめさん、私\nそんな路線を披露した\nことはありませんよ？"},
        { "location": "2066/Talk", "narrator": "アーヤ", "text": "ダークファンタジーや\n終末物とかに\n影響されたのかしら？"},
        { "location": "2067/Talk", "narrator": "神楽", "text": "すぐ読んだ物とかに\n影響されるみたいに\n言わないでくださいっ！"},
        { "location": "2068/Talk", "narrator": "ガブリエラ", "text": "いいけど、どうせ\n最後はおちゃらけて\n落とすんでしょ？"},
        { "location": "2069/Talk", "narrator": "ガブリエラ", "text": "普段よく\nつばめをからかってる\nみたいに。"},
        { "location": "2070/Talk", "narrator": "つばめ", "text": "あっ、そうだったの？\nう～っ、また騙される\nとこだったよぉ～。"},
        { "location": "2071/Talk", "narrator": "神楽", "text": "あの、だから、そんな\n他意は……まぁ、もう\nいいですけど。"},
        { "location": "2072/Talk", "narrator": "アーヤ", "text": "ええ、残念だけど、\nもう時間みたいね。"},
        { "location": "2073/Talk", "narrator": "神楽", "text": "そうみたいですね。\nそれじゃ、この続きは\n次回に持ち越しますね！"},
        { "location": "2074/Talk", "narrator": "ガブリエラ", "text": "無い無い！\nもう神楽の妄想話は\nおしまいだからっ！"},
        { "location": "2075/Talk", "narrator": "アーヤ", "text": "何故か今回は時間が\n短かったように感じるわ。\n不思議ね。"},
        { "location": "2076/Talk", "narrator": "アーヤ", "text": "いえ、卯月の作り話の\nせいではないと\n思うけど……。"},
        { "location": "2077/Talk", "narrator": "アーヤ", "text": "ボケツッコミの応酬が\nあまり無かったから\nかしら？"}
    ]
}
