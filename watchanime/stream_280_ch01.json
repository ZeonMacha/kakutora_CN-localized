{
    "dir": "stream_280_ch01.json",
    "type": "watchanime",
    "info": {
    },
    "entry":
    [
        { "location": "5401/Talk", "narrator": "アーヤ", "text": "そ、そんなこと\nないと思うわよね？"},
        { "location": "5402/Talk", "narrator": "ガブリエラ", "text": "どうして疑問形！？"},
        { "location": "5403/Talk", "narrator": "みやび", "text": "そないな設定やった？\nアーヤ、キャラが\nブレとらん？"},
        { "location": "5404/Talk", "narrator": "アーヤ", "text": "設定とかキャラとか\n言わないように！"},
        { "location": "5405/Talk", "narrator": "アーヤ", "text": "そ、そう思うわよね？\n私もそれが\n言いたかったの。"},
        { "location": "5406/Talk", "narrator": "みやび", "text": "ああ！　真夜中の\n何ちゃらＴＶやね。"},
        { "location": "5407/Talk", "narrator": "アーヤ", "text": "みやびストップ。\nそれはかなり冗談では\n済まなくなるわ。"},
        { "location": "5408/Talk", "narrator": "みやび", "text": "うん、うちも正直、\nちょっと怖かった。"},
        { "location": "5409/Talk", "narrator": "つばめ", "text": "えぇっ！？　待って！\n痛いのダメです！\nダメですからっ！"},
        { "location": "5410/Talk", "narrator": "ガブリエラ", "text": "痛いとかいう問題じゃ\nないと思うけど。"},
        { "location": "5411/Talk", "narrator": "つばめ", "text": "く、くすぐるのも\nダメですから！"},
        { "location": "5412/Talk", "narrator": "ガブリエラ", "text": "そういう意味じゃ\nなくて！"},
        { "location": "5413/Talk", "narrator": "みやび", "text": "これからビリリィッて\n破けるんやけどな。"},
        { "location": "5414/Talk", "narrator": "つばめ", "text": "えぇっ！？\nそ、それ色々と\n大丈夫なんですか？"},
        { "location": "5415/Talk", "narrator": "ガブリエラ", "text": "……アンタ、そんな\n心配してる立場じゃ\nないでしょ。"},
        { "location": "5416/Talk", "narrator": "ガブリエラ", "text": "……命が惜しかったら\nそれは二度と口にしない\nことね。"},
        { "location": "5417/Talk", "narrator": "みやび", "text": "むしろ今その瞬間三回は\nあの世に行っちゅうよ。"},
        { "location": "5418/Talk", "narrator": "つばめ", "text": "ところでその「若い」には\nアーヤさんは含まれます\nか？"},
        { "location": "5419/Talk", "narrator": "ガブリエラ", "text": "ば、ばか、つばめっ！"},
        { "location": "5420/Talk", "narrator": "みやび", "text": "つばめちゃんも意外と\n命知らずやな……。"},
        { "location": "5421/Talk", "narrator": "みやび", "text": "奇遇やね。\nうちもや。"},
        { "location": "5422/Talk", "narrator": "ガブリエラ", "text": "みやびはそんなキャラ\nじゃないでしょ。"},
        { "location": "5423/Talk", "narrator": "みやび", "text": "決めつけんといて！\nうちかてまだ女子高生\nなんよ！？"},
        { "location": "5424/Talk", "narrator": "ガブリエラ", "text": "いや、女子高生でも\nナイから……。"},
        { "location": "5425/Talk", "narrator": "つばめ", "text": "えぇっ！？\nダメだったの！？"},
        { "location": "5426/Talk", "narrator": "つばめ", "text": "わたし、やっと出たと\n思ったら、扱いひどく\nないですか！？"},
        { "location": "5427/Talk", "narrator": "つばめ", "text": "うぅ～、いつまで\nこんなつらい展開が\n続くのかなぁ……。"},
        { "location": "5428/Talk", "narrator": "つばめ", "text": "みんながハッピーで\nかっこいい展開が\n早く来るといいなぁ。"},
        { "location": "5429/Talk", "narrator": "ガブリエラ", "text": "まぁ、何て言うか\n色々と明かされた割に\n絵面的に地味よね。"},
        { "location": "5430/Talk", "narrator": "ガブリエラ", "text": "でもこういうのが\nタメってやつだし\n今はガマンね。"},
        { "location": "5431/Talk", "narrator": "ガブリエラ", "text": "タメにタメて\nガツンといくから\n期待してなさいよ！"},
        { "location": "5432/Talk", "narrator": "アーヤ", "text": "卯月も変に気を\n遣わなくても\nいいのだけれど……。"},
        { "location": "5433/Talk", "narrator": "アーヤ", "text": "でも、あの子なりの\nけじめと言うか\nルールがあるのかも。"},
        { "location": "5434/Talk", "narrator": "アーヤ", "text": "早くそれらが\n解決するといいわね。"},
        { "location": "5435/Talk", "narrator": "神楽", "text": "えへへっ、つい\n我慢出来ずに\n出ちゃいましたぁ。"},
        { "location": "5436/Talk", "narrator": "神楽", "text": "これくらいは見逃して\nくれますよね？　ね？"},
        { "location": "5437/Talk", "narrator": "神楽", "text": "現実の事情で\n私だけのけ者なのは\n不公平すぎですっ！"},
        { "location": "5438/Talk", "narrator": "みやび", "text": "ん？\n珍しくうちが一番乗り\nかいな？"},
        { "location": "5439/Talk", "narrator": "ガブリエラ", "text": "珍しくっていうか\n初めてじゃない？"},
        { "location": "5440/Talk", "narrator": "みやび", "text": "そんな遅刻常習犯みたいに\n言われるのは不本意ぞね。"},
        { "location": "5441/Talk", "narrator": "ガブリエラ", "text": "みやびの場合、\n遅刻って言うより、\nサボリって感じだけど。"},
        { "location": "5442/Talk", "narrator": "みやび", "text": "ガブちゃん、うちのこと、\nそないな目で見とったん\nかい……。"},
        { "location": "5443/Talk", "narrator": "みやび", "text": "うち、悲しくて今晩は\n枕を涙２リットルで\n濡らしそうや……。"},
        { "location": "5444/Talk", "narrator": "ガブリエラ", "text": "はいはい、好きにして\nちょうだい。"},
        { "location": "5445/Talk", "narrator": "アーヤ", "text": "あら？　今回つばめは\n休みなのかしら？"},
        { "location": "5446/Talk", "narrator": "アーヤ", "text": "仕方ないわね。\nだとしたら３人で\n回しましょうか。"},
        { "location": "5447/Talk", "narrator": "つばめ", "text": "いまーす！\nわたし、いますっ！\n休まないですっ！！"},
        { "location": "5448/Talk", "narrator": "みやび", "text": "なんや、てっきり\n出番が無いから\n休みなのかと。"},
        { "location": "5449/Talk", "narrator": "つばめ", "text": "いえ、今回こそ絶対\n出番ありますから！\n大活躍ですから！"},
        { "location": "5450/Talk", "narrator": "ガブリエラ", "text": "出番はともかく大活躍は\n無理なんじゃない？"},
        { "location": "5451/Talk", "narrator": "つばめ", "text": "始まる前から現実を\n突きつけるの禁止！"},
        { "location": "5452/Talk", "narrator": "アーヤ", "text": "何にしろ、つばめが\n来てくれて嬉しいわ。"},
        { "location": "5453/Talk", "narrator": "つばめ", "text": "アーヤさん、優しい！\n大好きっ！"},
        { "location": "5454/Talk", "narrator": "ガブリエラ", "text": "アーヤはすぐそうやって\nつばめを甘やかすから。"},
        { "location": "5455/Talk", "narrator": "みやび", "text": "ガブちゃんもうちに\n甘えてええんよ？"},
        { "location": "5456/Talk", "narrator": "みやび", "text": "しっかし今のご時世に\nＶＨＳを見るとは\n思わんかったぞね。"},
        { "location": "5457/Talk", "narrator": "みやび", "text": "これがいまだ現役とは\nさすがアーヤの家！\nゆう感じやわ。"},
        { "location": "5458/Talk", "narrator": "アーヤ", "text": "つまり、田舎だって\n言いたいわけ？"},
        { "location": "5459/Talk", "narrator": "みやび", "text": "いんや、今時のデジタル\n放送は録画できんき、\n再生専用ちゅうことやか？"},
        { "location": "5460/Talk", "narrator": "みやび", "text": "つまり観たいテープが\nそれなりに保管されてる\nゆう証拠やき。"},
        { "location": "5461/Talk", "narrator": "みやび", "text": "そういえばＣＦカードなん\nて見たの何年ぶりやろね？"},
        { "location": "5462/Talk", "narrator": "みやび", "text": "たまたま対応してる\nアダプタを持っちょったき\n読めたけんど。"},
        { "location": "5463/Talk", "narrator": "ガブリエラ", "text": "こういう話題になると\nみやびの独壇場ね。\nべつにいいんだけど。"},
        { "location": "5464/Talk", "narrator": "つばめ", "text": "それよりＴＶの砂嵐を\n見ると呪われますよ！\nいいんですか！？"},
        { "location": "5465/Talk", "narrator": "アーヤ", "text": "つばめ、ストップ。\n今はそういうふざけた\n話題はやめましょう。"},
        { "location": "5466/Talk", "narrator": "つばめ", "text": "あっ、ワコーマエだよ\nあそこ。前にみんなで\n待ち合わせしたよね。"},
        { "location": "5467/Talk", "narrator": "ガブリエラ", "text": "ああ、つばめがすごい\n化粧してきた日ね。\nなるほどあそこか。"},
        { "location": "5468/Talk", "narrator": "アーヤ", "text": "それにしてもこの廃墟\n映像から具体的な場所に\nよく気づいたわね。"},
        { "location": "5469/Talk", "narrator": "みやび", "text": "キャーッ！\nエリカサーン！！"},
        { "location": "5470/Talk", "narrator": "アーヤ", "text": "みやび、そんなに\n何度もやっていると\nレア度が下がるわよ。"},
        { "location": "5471/Talk", "narrator": "ガブリエラ", "text": "みやびがはしゃいでるのに\nレアも何も無い気もするん\nだけど……。"},
        { "location": "5472/Talk", "narrator": "つばめ", "text": "むしろアーヤさんが\nはしゃぐと、とっても\nレアだと思います！"},
        { "location": "5473/Talk", "narrator": "ガブリエラ", "text": "ていうか重要な映像が\n流れてるのにスルーし\n過ぎ。"},
        { "location": "5474/Talk", "narrator": "みやび", "text": "ほんだら真面目に\n考察してみるが？"},
        { "location": "5475/Talk", "narrator": "アーヤ", "text": "ええ、この真ん中に\n立っているのは姉で\n間違い無いわ……。"},
        { "location": "5476/Talk", "narrator": "ガブリエラ", "text": "ていうか、このあたし\nたちは何なの？\nまた別事象ってこと？"},
        { "location": "5477/Talk", "narrator": "つばめ", "text": "というか、なんで\nわたしと神楽ちゃんは\nいないんですかっ！？"},
        { "location": "5478/Talk", "narrator": "みやび", "text": "そこはほら、\nまだ加入前ちゅうこと\nかも知れんし。"},
        { "location": "5479/Talk", "narrator": "アーヤ", "text": "でも、つばめと卯月が\nいないのも意味がある\nのかも知れないわ。"},
        { "location": "5480/Talk", "narrator": "つばめ", "text": "しかも２０３１年って\nあるけど、ガブちゃん\n若過ぎない？"},
        { "location": "5481/Talk", "narrator": "ガブリエラ", "text": "なんであたしだけ！？\nアーヤとみやびだって\n一緒でしょ！？"},
        { "location": "5482/Talk", "narrator": "アーヤ", "text": "でも録画したカメラの\n時刻設定がおかしい\nわけでもなさそうね。"},
        { "location": "5483/Talk", "narrator": "みやび", "text": "このタイムラインは\n映像内にわざわざ\n入れてあるもんやし。"},
        { "location": "5484/Talk", "narrator": "アーヤ", "text": "逆に言うと、敢えて\n捏造している可能性も\nあるけど……。"},
        { "location": "5485/Talk", "narrator": "みやび", "text": "キャーッ！\nマホサーン！！"},
        { "location": "5486/Talk", "narrator": "ガブリエラ", "text": "はぁっ！？\n何がしたいわけ！？"},
        { "location": "5487/Talk", "narrator": "みやび", "text": "こうやってうちが\nエリカさんラブなのを\n誤魔化す作戦や。"},
        { "location": "5488/Talk", "narrator": "アーヤ", "text": "今さら誤魔化せるわけ\nないでしょ……。"},
        { "location": "5489/Talk", "narrator": "つばめ", "text": "うぅ～っ……真幌さん\nだけだよ、わたしの\n心配してくれてるの。"},
        { "location": "5490/Talk", "narrator": "ガブリエラ", "text": "バカか言わないでよ。\nちょっと忘れてただけで\n心配はしてたわよ。"},
        { "location": "5491/Talk", "narrator": "つばめ", "text": "あの……出来れば\nちょっとでも忘れないで\n欲しいかなって。"},
        { "location": "5492/Talk", "narrator": "みやび", "text": "ちゅうか、まほさんも\n結局「そうか」で\n済ませちょるけんど。"},
        { "location": "5493/Talk", "narrator": "つばめ", "text": "あーん！　わたしと\n神楽ちゃんはやっぱり\n見捨てられたーっ！"},
        { "location": "5494/Talk", "narrator": "みやび", "text": "ここのアーヤ、キツネ\nみたいな顔しちょる。\nマジオコなん？"},
        { "location": "5495/Talk", "narrator": "アーヤ", "text": "真剣に話してるだけで\n怒ってるってわけじゃ\nないわよ……。"},
        { "location": "5496/Talk", "narrator": "アーヤ", "text": "……いえ、確かにこの\n事態に怒りを覚えてる\nのは事実だけれど。"},
        { "location": "5497/Talk", "narrator": "つばめ", "text": "アーヤさんもしかして\nわたしの為に怒って\nくれてるの？"},
        { "location": "5498/Talk", "narrator": "アーヤ", "text": "そうね。つばめがこの\n場にいたら、もう少し\n穏やかだったかもね。"},
        { "location": "5499/Talk", "narrator": "つばめ", "text": "というかエリカさんに\n限らず色々知ってる人\nって、なんでこう――"},
        { "location": "5500/Talk", "narrator": "つばめ", "text": "クイズみたいな方法で\n思わせぶりに情報を\n教えてくるんだろ？"},
        { "location": "5501/Talk", "narrator": "つばめ", "text": "わたしとしては\nもっと簡単に教えて\n欲しいんだけど。"},
        { "location": "5502/Talk", "narrator": "ガブリエラ", "text": "そりゃいきなり\n「犯人は○スです！」\nって送ってきたら"},
        { "location": "5503/Talk", "narrator": "ガブリエラ", "text": "そこで話が\n終わっちゃうでしょ？"},
        { "location": "5504/Talk", "narrator": "みやび", "text": "ガブちゃん、むしろその\n例えで、このアプリが\n終わりそうやけど？"},
        { "location": "5505/Talk", "narrator": "つばめ", "text": "……えっ？\nあれっ？\nわたしっ！？"},
        { "location": "5506/Talk", "narrator": "ガブリエラ", "text": "……もしかして\n吊るされてる？"},
        { "location": "5507/Talk", "narrator": "アーヤ", "text": "これは……。"},
        { "location": "5508/Talk", "narrator": "アーヤ", "text": "……あら？"},
        { "location": "5509/Talk", "narrator": "つばめ", "text": "えっ？\nアーヤさん？"},
        { "location": "5510/Talk", "narrator": "つばめ", "text": "って、神楽ちゃん！？"},
        { "location": "5511/Talk", "narrator": "神楽", "text": "ええ、\n遂に私が来ましたよ。"},
        { "location": "5512/Talk", "narrator": "神楽", "text": "つばめさんを\nアレコレするのは\n私の仕事ですから！"},
        { "location": "5513/Talk", "narrator": "つばめ", "text": "……えええっ！"},
        { "location": "5514/Talk", "narrator": "ガブリエラ", "text": "ていうか、一緒に横に\n吊るされてたのら\n声かけなさいよ……。"},
        { "location": "5515/Talk", "narrator": "神楽", "text": "そんなことしたら気を\n失ってるつばめさんを\n鑑賞出来ませんし！"},
        { "location": "5516/Talk", "narrator": "つばめ", "text": "しなくていいよっ！"},
        { "location": "5517/Talk", "narrator": "みやび", "text": "ところで、あの\n千羽鶴ゆう子は\n何歳なんやろね？"},
        { "location": "5518/Talk", "narrator": "つばめ", "text": "見た目はわたしたちと\n変わらないように\n見えるけど……？"},
        { "location": "5519/Talk", "narrator": "ガブリエラ", "text": "それで長官って、\nどんなエリートコース\nだったのよ。"},
        { "location": "5520/Talk", "narrator": "ガブリエラ", "text": "小学生の時に飛び級で\n大学生だったくらいで\nないと無理でしょ。"},
        { "location": "5521/Talk", "narrator": "つばめ", "text": "もしくは見た目が\n若いだけで実はって\nパターン？"},
        { "location": "5522/Talk", "narrator": "みやび", "text": "いわゆるロリババア\nちゅうやつやね。\nそれもありや。"},
        { "location": "5523/Talk", "narrator": "みやび", "text": "ところでこの辺りの\nまほさん、憑きものが\n取れたみたいやね。"},
        { "location": "5524/Talk", "narrator": "みやび", "text": "こんな感じのまま\nやったら攻略対象に\nなれるんと違う？"},
        { "location": "5525/Talk", "narrator": "ガブリエラ", "text": "強気ワイルド系？\nそれともズボラ系？\nそういうの好きなの？"},
        { "location": "5526/Talk", "narrator": "神楽", "text": "あっ、私はそろそろ\nここら辺で\n失礼しますね。"},
        { "location": "5527/Talk", "narrator": "神楽", "text": "まだ、こっち側の\n人間ではないみたい\nなので。"},
        { "location": "5528/Talk", "narrator": "つばめ", "text": "あっ！\n神楽ちゃんっ！？"},
        { "location": "5529/Talk", "narrator": "アーヤ", "text": "やれやれ。卯月も\nまだ慌ただしいわね。"},
        { "location": "5530/Talk", "narrator": "つばめ", "text": "神楽ちゃん……。"},
        { "location": "5531/Talk", "narrator": "アーヤ", "text": "……音響カプラの音？\n随分と懐かしいわね。"},
        { "location": "5532/Talk", "narrator": "ガブリエラ", "text": "でもＤＴＭＦは最近も\nまだ使われてない？\n生で聴かないだけで。"},
        { "location": "5533/Talk", "narrator": "アーヤ", "text": "まぁ、昔のって言う\nほどではないわね。"},
        { "location": "5534/Talk", "narrator": "みやび", "text": "ここはそう言っとく\n流れやき、細かいとこ\nつっこまんといて！"},
        { "location": "5535/Talk", "narrator": "つばめ", "text": "それよりガブちゃん\nさりげなくいい場所\nキープしてない？"},
        { "location": "5536/Talk", "narrator": "ガブリエラ", "text": "はぁ！？\nて、ＴＶが見やすい\n位置にいただけだし！"},
        { "location": "5537/Talk", "narrator": "アーヤ", "text": "館長とギャヴィの\nカップリングは\n姉妹感があるわね。"},
        { "location": "5538/Talk", "narrator": "ガブリエラ", "text": "はいそこ！\n変な妄想しない！"},
        { "location": "5539/Talk", "narrator": "みやび", "text": "微笑ましくて\nええちゅう話やろ？\n可愛いやね。"},
        { "location": "5540/Talk", "narrator": "つばめ", "text": "可愛いと言えば\nここのみやびさん\n可愛すぎませんか？"},
        { "location": "5541/Talk", "narrator": "アーヤ", "text": "ええ、一瞬だけど\n思わずお持ち帰り\nしたくなったわ。"},
        { "location": "5542/Talk", "narrator": "つばめ", "text": "い、いえ、そこまでは\n言ってないですけど……。"},
        { "location": "5543/Talk", "narrator": "みやび", "text": "なんぞ今回のうちは\n真面目に働かされ通し\nやったな。"},
        { "location": "5544/Talk", "narrator": "みやび", "text": "もう少しボケる\n余裕が欲しかった\nところぞね。"},
        { "location": "5545/Talk", "narrator": "みやび", "text": "次回はまったりボケる\n方向で頼むき。"}
    ]
}
