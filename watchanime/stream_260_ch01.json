{
    "dir": "stream_260_ch01.json",
    "type": "watchanime",
    "info": {
    },
    "entry":
    [
        { "location": "4976/Talk", "narrator": "神楽", "text": "ビックリしましたか？"},
        { "location": "4977/Talk", "narrator": "神楽", "text": "せっかく二人きりの\n機会ですし、ちょっとだけ\n羽目外しちゃおうかと。"},
        { "location": "4978/Talk", "narrator": "神楽", "text": "どうしたんですか？\n体調悪いんですか？"},
        { "location": "4979/Talk", "narrator": "神楽", "text": "……なんて。ふふ。\nちょっと意地悪な\n格好でしたでしょうか？"},
        { "location": "4980/Talk", "narrator": "神楽", "text": "今回はせっかく二人きり\nですから、ちょっとだけ\n羽目外しちゃおうかと。"},
        { "location": "4981/Talk", "narrator": "神楽", "text": "ふふ。良かったです。"},
        { "location": "4982/Talk", "narrator": "神楽", "text": "まるで、いつもは\nはじけ飛んでるような\n言い方ですね。"},
        { "location": "4983/Talk", "narrator": "神楽", "text": "まあ、否定は\nできませんけどね。"},
        { "location": "4984/Talk", "narrator": "神楽", "text": "わかりました。\nそれじゃ、一緒に\n参りましょう。"},
        { "location": "4985/Talk", "narrator": "神楽", "text": "ふふ。ごめんなさい。\nちょっと脅かしすぎて\nしまったかもです。"},
        { "location": "4986/Talk", "narrator": "神楽", "text": "でも大丈夫ですよ。\nもし、怖くなって\nしまったら――"},
        { "location": "4987/Talk", "narrator": "神楽", "text": "その時は、そこで\nお終いにしましょう。"},
        { "location": "4988/Talk", "narrator": "神楽", "text": "でもそれは決して、\n私との別れでは\nありません。"},
        { "location": "4989/Talk", "narrator": "神楽", "text": "$handle$さんの\nことが大切だから、\nそうするまでです。"},
        { "location": "4990/Talk", "narrator": "神楽", "text": "ですから、どうか\n行けるところまでで\n構いません。"},
        { "location": "4991/Talk", "narrator": "神楽", "text": "ご一緒できますと\n嬉しく思います♪"},
        { "location": "4992/Talk", "narrator": "神楽", "text": "それでは、\nそろそろ一緒に\n旅立ちませんか？"},
        { "location": "4993/Talk", "narrator": "神楽", "text": "ですよね…。"},
        { "location": "4994/Talk", "narrator": "神楽", "text": "またの機会には、\nそういうのも\n用意してみますね。"},
        { "location": "4995/Talk", "narrator": "神楽", "text": "そう…ですか？"},
        { "location": "4996/Talk", "narrator": "神楽", "text": "ふふ、\nありがとうございます。"},
        { "location": "4997/Talk", "narrator": "神楽", "text": "$handle$さんの\nそういう真摯なところ、\nとっても素敵です。"},
        { "location": "4998/Talk", "narrator": "神楽", "text": "あ、それわかります！\n私そういうの\n大好きなので！"},
        { "location": "4999/Talk", "narrator": "神楽", "text": "精神世界描写がある\n映画って素敵ですよね！\nゾクゾクするっていうか。"},
        { "location": "5000/Talk", "narrator": "神楽", "text": "……って、\nやっぱり私ってちょっと\n変わってますよね。"},
        { "location": "5001/Talk", "narrator": "神楽", "text": "$handle$さんは、\nそういうの好きですか？"},
        { "location": "5002/Talk", "narrator": "神楽", "text": "ふふ！\n気が合いますね！"},
        { "location": "5003/Talk", "narrator": "神楽", "text": "今度二人きりで、\nお部屋を暗くして\n見たいですね♪"},
        { "location": "5004/Talk", "narrator": "神楽", "text": "何か、色んな意味で\nドキドキしちゃいそう\nですよね！"},
        { "location": "5005/Talk", "narrator": "神楽", "text": "あら、そうなんですね。"},
        { "location": "5006/Talk", "narrator": "神楽", "text": "それじゃ、今度おうちに\n来る機会があったら――"},
        { "location": "5007/Talk", "narrator": "神楽", "text": "それ系の映画流して、\n$handle$さんを\n一人部屋に閉じこめて。"},
        { "location": "5008/Talk", "narrator": "神楽", "text": "外からその様子を\n監視しちゃおうかな…\nなんて。"},
        { "location": "5009/Talk", "narrator": "神楽", "text": "ふふ。\nもちろん冗談ですよ？"},
        { "location": "5010/Talk", "narrator": "神楽", "text": "でも、ちょっとカワイイ\n$handle$さんの\n姿も見てみたいです！"},
        { "location": "5011/Talk", "narrator": "神楽", "text": "あっ！\nえっとですね！"},
        { "location": "5012/Talk", "narrator": "神楽", "text": "それは、\nシュールレアリズムと\nいいますか！"},
        { "location": "5013/Talk", "narrator": "神楽", "text": "精神状態を表現するのに\n丁度いいかと思って\n使ってるだけですから！"},
        { "location": "5014/Talk", "narrator": "神楽", "text": "決して私の部屋が\n汚部屋っていうわけじゃ\nないですからね？"},
        { "location": "5015/Talk", "narrator": "神楽", "text": "人を呪わば穴二つ、\nですよ？"},
        { "location": "5016/Talk", "narrator": "神楽", "text": "$handle$さんの\n部屋の恥ずかしいところ、\nいつか暴きに行きますね。"},
        { "location": "5017/Talk", "narrator": "神楽", "text": "そういうことに\nしておいてください！"},
        { "location": "5018/Talk", "narrator": "神楽", "text": "本当に綺麗なんですよ？\nアイボリーとレースを\n基調としたお部屋で。"},
        { "location": "5019/Talk", "narrator": "神楽", "text": "あ、私、オーガニック\nコットン系のカラーが\n凄く好きで。"},
        { "location": "5020/Talk", "narrator": "神楽", "text": "そういうのに包まれる\nのが大好きなので、部屋も\nコットンだらけなんです！"},
        { "location": "5021/Talk", "narrator": "神楽", "text": "コットンって、とっても\n気持ちいいんですよ？"},
        { "location": "5022/Talk", "narrator": "神楽", "text": "今度お部屋に来たとき\n一緒にくるまります？"},
        { "location": "5023/Talk", "narrator": "神楽", "text": "…ふふ。なんて♪"},
        { "location": "5024/Talk", "narrator": "神楽", "text": "何故怖いか解りますか？"},
        { "location": "5025/Talk", "narrator": "神楽", "text": "もちろん、笑顔なのも\nその原因かもしれませんが\nそれ自体は普通です。"},
        { "location": "5026/Talk", "narrator": "神楽", "text": "肝は一瞬の首の動きです。\n生者では普通起こらない\n首の動きをしてるんです。"},
        { "location": "5027/Talk", "narrator": "神楽", "text": "そういうのって、表層の\n意識では認識できません\nけど――"},
        { "location": "5028/Talk", "narrator": "神楽", "text": "潜在的な感覚は\nもの凄く敏感に\n感じ取るんですよね。"},
        { "location": "5029/Talk", "narrator": "神楽", "text": "いわゆる\n『不気味の谷』って\nいわれてるものですね。"},
        { "location": "5030/Talk", "narrator": "神楽", "text": "でも、どうして人間は、\nそんなところを敏感に\n感じ取れるのでしょうか。"},
        { "location": "5031/Talk", "narrator": "神楽", "text": "それは、この歌に\n込められた一番の\n意味なんですよ？"},
        { "location": "5032/Talk", "narrator": "神楽", "text": "ですから、ここで言って\nしまうのは簡単ですが――"},
        { "location": "5033/Talk", "narrator": "神楽", "text": "歌を最後まで聞いて、\n意味に思いを馳せるのも\nまた一興かもしれません。"},
        { "location": "5034/Talk", "narrator": "神楽", "text": "ふふ。\n素敵ですね。\n私も賛成です。"},
        { "location": "5035/Talk", "narrator": "神楽", "text": "それでは、来たる時に\n備えて、プレラブトーク\nしちゃいましょうか。"},
        { "location": "5036/Talk", "narrator": "神楽", "text": "$handle$さんは、私と\nお付き合いを始めたら\n何をしたいですか？"},
        { "location": "5037/Talk", "narrator": "神楽", "text": "けど。"},
        { "location": "5038/Talk", "narrator": "神楽", "text": "こんなお話をしている\n貴方の本心は、如何様な\nものなんでしょうか。"},
        { "location": "5039/Talk", "narrator": "神楽", "text": "そもそもラブラブするって\nいうのは、こういうのとは\n少し違いますよね？"},
        { "location": "5040/Talk", "narrator": "神楽", "text": "何となくわかっては\nいるんですけど――"},
        { "location": "5041/Talk", "narrator": "神楽", "text": "ガブちゃんやアーヤさんの\nように、普通に可愛い\n恋愛ができないんです。"},
        { "location": "5042/Talk", "narrator": "神楽", "text": "あまりに色んなことが\nありすぎちゃって。"},
        { "location": "5043/Talk", "narrator": "神楽", "text": "ですから、心ときめく\nような熱い恋をしたいなら\nガブちゃんやアーヤさん、"},
        { "location": "5044/Talk", "narrator": "神楽", "text": "あと、みやびさんの方が\n幸せな将来が約束されて\nいると思います。"},
        { "location": "5045/Talk", "narrator": "神楽", "text": "紳士淑女さんですね。\nとっても賛成です。"},
        { "location": "5046/Talk", "narrator": "神楽", "text": "私、カフェを巡るの\nとっても好きなんですよ。"},
        { "location": "5047/Talk", "narrator": "神楽", "text": "好きなお茶とお菓子で\nリラックスしてると――"},
        { "location": "5048/Talk", "narrator": "神楽", "text": "色々な想いが浮かんできて\nそれを書き留めるんです。"},
        { "location": "5049/Talk", "narrator": "神楽", "text": "そうすると、歌になったり\n物語になったり。"},
        { "location": "5050/Talk", "narrator": "神楽", "text": "とっても素敵なものが\n出来上がります。"},
        { "location": "5051/Talk", "narrator": "神楽", "text": "それは……ダメですよ。"},
        { "location": "5052/Talk", "narrator": "神楽", "text": "そんなことされたら、\n出来上がりが全部甘い\n恋愛物になっちゃいます。"},
        { "location": "5053/Talk", "narrator": "神楽", "text": "知ってますか？\n物作りは心から湧き出る\n物をくみ取りますから――"},
        { "location": "5054/Talk", "narrator": "神楽", "text": "ラブラブしてると\nほんわかした幸せな\nものばかり出来ます。"},
        { "location": "5055/Talk", "narrator": "神楽", "text": "逆に、とても辛いことが\nあったりすると、悲しい\n物が出来上がります。"},
        { "location": "5056/Talk", "narrator": "神楽", "text": "それは、表面上正反対の\n物語だったとしてもです。"},
        { "location": "5057/Talk", "narrator": "神楽", "text": "ですから、\n$handle$さんと\nラブラブしたら私――"},
        { "location": "5058/Talk", "narrator": "神楽", "text": "音楽も物語も、\n卒業するかもしれません。"},
        { "location": "5059/Talk", "narrator": "神楽", "text": "でも、それはそれで\n素敵なことだと\n思っています、"},
        { "location": "5060/Talk", "narrator": "神楽", "text": "だってそれは、\n貴方の世界へ嫁ぐって\nいうことですから。"},
        { "location": "5061/Talk", "narrator": "神楽", "text": "それは\n出来たら素敵ですね。"},
        { "location": "5062/Talk", "narrator": "神楽", "text": "でも、その想いは\nずっと叶わないままの\n方が幸せかもです。"},
        { "location": "5063/Talk", "narrator": "神楽", "text": "私、普段はふわっと\nしてますけど――"},
        { "location": "5064/Talk", "narrator": "神楽", "text": "創作が入ると、\n自分にも他人にも\n厳しくなっちゃいます。"},
        { "location": "5065/Talk", "narrator": "神楽", "text": "だから、貴方が作って\nくれたものを台無しに\nしてしまうかもしれない。"},
        { "location": "5066/Talk", "narrator": "神楽", "text": "私が作ったものを、\n貴方が台無しにした！\nって怒るかもしれない。"},
        { "location": "5067/Talk", "narrator": "神楽", "text": "ですからこれは、ずっと\n私たちの素敵な夢のままが\nいいと思います。"},
        { "location": "5068/Talk", "narrator": "神楽", "text": "たぶん私は、\n創作に関してだけは、\n絶対優しくなれません。"},
        { "location": "5069/Talk", "narrator": "神楽", "text": "なんだか、殺伐とした\nお話しになっちゃって\nごめんなさい。"},
        { "location": "5070/Talk", "narrator": "神楽", "text": "あ、でも、\n１つだけ二人で創作できる\nものがあるかも――"},
        { "location": "5071/Talk", "narrator": "神楽", "text": "…って、この話は\nここまでにしましょう。"},
        { "location": "5072/Talk", "narrator": "神楽", "text": "私もです♪"},
        { "location": "5073/Talk", "narrator": "神楽", "text": "$handle$さんが\n男性でも女性でも、\n一緒に創作したいです。"},
        { "location": "5074/Talk", "narrator": "神楽", "text": "…はい。"},
        { "location": "5075/Talk", "narrator": "神楽", "text": "ふふ。\nそうだといいんですけど。"},
        { "location": "5076/Talk", "narrator": "神楽", "text": "でも、遺伝子は確率です。\n$handle$さんも\n責任重大ですよ？"},
        { "location": "5077/Talk", "narrator": "神楽", "text": "まあでも。\nきっとどんな子でも\n可愛いと思います。"},
        { "location": "5078/Talk", "narrator": "神楽", "text": "そんな事ありませんよ？"},
        { "location": "5079/Talk", "narrator": "神楽", "text": "一緒に育てることは\nできますから。"},
        { "location": "5080/Talk", "narrator": "神楽", "text": "$handle$さんと一緒に、\n子育てできたら\nとっても素敵です！"},
        { "location": "5081/Talk", "narrator": "神楽", "text": "欲求に忠実ですね。"},
        { "location": "5082/Talk", "narrator": "神楽", "text": "そういうの\n嫌いじゃないです。\nけど――"},
        { "location": "5083/Talk", "narrator": "神楽", "text": "それはあまり\nお薦めしません。"},
        { "location": "5084/Talk", "narrator": "神楽", "text": "わりと残念な身体ですし、\n私ちょっとおかしいので。"},
        { "location": "5085/Talk", "narrator": "神楽", "text": "ありがとうございます。\n嘘でも嬉しいです。"},
        { "location": "5086/Talk", "narrator": "神楽", "text": "やっぱり、共に一つの床に\n入るのは、本気で愛して\nくれる人がいいです。"},
        { "location": "5087/Talk", "narrator": "神楽", "text": "それは、\n今はまだ秘密ですよ？"},
        { "location": "5088/Talk", "narrator": "神楽", "text": "先に教えるような\nものでもありませんし。"},
        { "location": "5089/Talk", "narrator": "神楽", "text": "でも１つだけ。\nこう見えて私、痛いの\n苦手なんで――"},
        { "location": "5090/Talk", "narrator": "神楽", "text": "そっち系じゃないです。\nそこは安心してください。"},
        { "location": "5091/Talk", "narrator": "神楽", "text": "ですよねー。"},
        { "location": "5092/Talk", "narrator": "神楽", "text": "それが普通の感覚だと\n思いますから。"},
        { "location": "5093/Talk", "narrator": "神楽", "text": "でも、ここまでご一緒した\nわけですし、今回は最後\nまでお付合いくださいね。"},
        { "location": "5094/Talk", "narrator": "神楽", "text": "最後まで\nお付き合いくださり\nありがとうございました。"},
        { "location": "5095/Talk", "narrator": "神楽", "text": "それでは、また。\nお逢いできる\nその日まで――。"},
        { "location": "5096/Talk", "narrator": "神楽", "text": "…ありがとうございます。"},
        { "location": "5097/Talk", "narrator": "神楽", "text": "でも、期待しないで\nおきますね。"},
        { "location": "5098/Talk", "narrator": "神楽", "text": "その方がきっと、\n$handle$さんも\n今後ラクだと思うんです。"},
        { "location": "5099/Talk", "narrator": "神楽", "text": "ねえ、\n$handle$さん。"},
        { "location": "5100/Talk", "narrator": "神楽", "text": "貴方は私の残酷なところも\n汚いところも、全部\n見てしまった人です。"},
        { "location": "5101/Talk", "narrator": "神楽", "text": "私を軽蔑して然るべき\nなのに、どうしてそこまで\n言ってくれるんですか？"},
        { "location": "5102/Talk", "narrator": "神楽", "text": "それは――"},
        { "location": "5103/Talk", "narrator": "神楽", "text": "きっと大変なことに\nなっちゃいますよ？"},
        { "location": "5104/Talk", "narrator": "神楽", "text": "貴方にその覚悟があっても\n私にはその勇気は\nありません。"},
        { "location": "5105/Talk", "narrator": "神楽", "text": "少なくとも今は。"},
        { "location": "5106/Talk", "narrator": "神楽", "text": "でも、少しずつ\nわかりあっていけば、\nいずれは……。"},
        { "location": "5107/Talk", "narrator": "神楽", "text": "って、もしそんな事に\nなったら、きっと貴方の\n方が逃げちゃうかも。"},
        { "location": "5108/Talk", "narrator": "神楽", "text": "模範解答ですね。"},
        { "location": "5109/Talk", "narrator": "神楽", "text": "でも、素直に嬉しいです。"},
        { "location": "5110/Talk", "narrator": "神楽", "text": "けど…。"},
        { "location": "5111/Talk", "narrator": "神楽", "text": "嘘ですよ。\nそんなの絶対嘘。"},
        { "location": "5112/Talk", "narrator": "神楽", "text": "そんなこと言っても、\n内心あざ笑ってるんじゃ\nないんですか？"},
        { "location": "5113/Talk", "narrator": "神楽", "text": "どんな末路を辿るのか。\nどんな無惨な結末を\n迎えるのかって。"},
        { "location": "5114/Talk", "narrator": "神楽", "text": "…怖い。"},
        { "location": "5115/Talk", "narrator": "神楽", "text": "……怖いの。"},
        { "location": "5116/Talk", "narrator": "神楽", "text": "貴方が怖い。\nこの世界が怖い。\n…みんなが怖い。"},
        { "location": "5117/Talk", "narrator": "神楽", "text": "だから、\n一緒にいたくない。"},
        { "location": "5118/Talk", "narrator": "神楽", "text": "いたいのに、\nいたくないの……。"},
        { "location": "5119/Talk", "narrator": "神楽", "text": "………お願いがあります。"},
        { "location": "5120/Talk", "narrator": "神楽", "text": "……何も言わずに、\n私のこと愛してください。"},
        { "location": "5121/Talk", "narrator": "神楽", "text": "いつか、逢える日が\n来るのでしょうか。"},
        { "location": "5122/Talk", "narrator": "神楽", "text": "もし逢えたなら…\nそして――"},
        { "location": "5123/Talk", "narrator": "神楽", "text": "$handle$さんが\n本当に私と命を共に\nしてくれるなら。"},
        { "location": "5124/Talk", "narrator": "神楽", "text": "まず抱きしめて欲しい。"},
        { "location": "5125/Talk", "narrator": "神楽", "text": "潰れるくらい強く、強く…"},
        { "location": "5126/Talk", "narrator": "神楽", "text": "手も足も決して離れない\nように絡めて……"},
        { "location": "5127/Talk", "narrator": "神楽", "text": "肌と肌を少しでも、\n1平方センチでも多く\n密着したい。"},
        { "location": "5128/Talk", "narrator": "神楽", "text": "貴方の温もりを\n少しでも多く\n感じたいから。"},
        { "location": "5129/Talk", "narrator": "神楽", "text": "少しでも沢山\n安心したいから……。"},
        { "location": "5130/Talk", "narrator": "神楽", "text": "私は想いで\n人を見ますから。"},
        { "location": "5131/Talk", "narrator": "神楽", "text": "私の事を好きで、\n本当に愛してくれる人なら\nそれ以外何も要りません。"},
        { "location": "5132/Talk", "narrator": "神楽", "text": "……なんて\n話しているうちに\n終わってしまいましたね。"},
        { "location": "5133/Talk", "narrator": "神楽", "text": "なんだかMVそっちのけで\nヘンなお話ばかりして\nごめんなさい。"},
        { "location": "5134/Talk", "narrator": "神楽", "text": "…はあっ……。"},
        { "location": "5135/Talk", "narrator": "神楽", "text": "$handle$さんの\n想いが伝わってきて……"},
        { "location": "5136/Talk", "narrator": "神楽", "text": "なんだか、とっても\n幸せな気持ち。"},
        { "location": "5137/Talk", "narrator": "神楽", "text": "そうですよね。"},
        { "location": "5138/Talk", "narrator": "神楽", "text": "$handle$さん……"},
        { "location": "5139/Talk", "narrator": "神楽", "text": "もちろんです。"},
        { "location": "5140/Talk", "narrator": "神楽", "text": "もちろんです。"},
        { "location": "5141/Talk", "narrator": "神楽", "text": "あらら。\n心の声が\n出ちゃってますね。"},
        { "location": "5142/Talk", "narrator": "神楽", "text": "ちなみにここで\nつばめさんの名前を\n呟いた理由――"},
        { "location": "5143/Talk", "narrator": "神楽", "text": "すなわち、私の本心は\nどんなだと思いますか？"},
        { "location": "5144/Talk", "narrator": "神楽", "text": "愛だと思いますか？\nそれとも……？"},
        { "location": "5145/Talk", "narrator": "神楽", "text": "私のことをわかってくれて\nいれば、察することだって\nできますよね？"},
        { "location": "5146/Talk", "narrator": "神楽", "text": "女の子「も」\n好きですよ？"},
        { "location": "5147/Talk", "narrator": "神楽", "text": "さっきもお伝えしたように\n私は、私を本気で愛して\nくれる方を大切にしたい。"},
        { "location": "5148/Talk", "narrator": "神楽", "text": "いつもそう思っています。"},
        { "location": "5149/Talk", "narrator": "神楽", "text": "そこには男女は\n関係ありません。"},
        { "location": "5150/Talk", "narrator": "神楽", "text": "でも。"},
        { "location": "5151/Talk", "narrator": "神楽", "text": "そうでなくて。"},
        { "location": "5152/Talk", "narrator": "神楽", "text": "単なる下心や打算で\n近づいてくる方には、\n徹底的に攻撃します。"},
        { "location": "5153/Talk", "narrator": "神楽", "text": "ですから、それが愛か\n下心かを確認することも\nあるかもしれません。"},
        { "location": "5154/Talk", "narrator": "神楽", "text": "もしかすると、ホンモノか\nどうか試すために、試しに\n攻撃するかもしれません。"},
        { "location": "5155/Talk", "narrator": "神楽", "text": "もしそんな事があったら、\nただひたすら、貴方の愛を\n私にぶつけてくださいね。"},
        { "location": "5156/Talk", "narrator": "神楽", "text": "私はそれを求めています。"},
        { "location": "5157/Talk", "narrator": "神楽", "text": "…ホントに、\nただそれだけなんです。"},
        { "location": "5158/Talk", "narrator": "神楽", "text": "ええええっ…。\nそ、そんなに\n情熱的でしたか？"},
        { "location": "5159/Talk", "narrator": "神楽", "text": "っと、まあ確かに、\n結構際どいことを\n言っちゃってたような…。"},
        { "location": "5160/Talk", "narrator": "神楽", "text": "もう二度と\n言いませんから！"},
        { "location": "5161/Talk", "narrator": "神楽", "text": "でも…言ったことは\n全部ホントのことです。"},
        { "location": "5162/Talk", "narrator": "神楽", "text": "早く逢いたい……。"},
        { "location": "5163/Talk", "narrator": "神楽", "text": "なんて。ちょっと切実な\n雰囲気を出してみました。"},
        { "location": "5164/Talk", "narrator": "神楽", "text": "でも、本当に。"},
        { "location": "5165/Talk", "narrator": "神楽", "text": "早く一緒にチャットしたり\nデートしたりしながら――"},
        { "location": "5166/Talk", "narrator": "神楽", "text": "お互いのこと、\nもっと影響し合いたい\nですね。"},
        { "location": "5167/Talk", "narrator": "神楽", "text": "それでは、今宵は\nこの辺でお開きと\nしましょう。"},
        { "location": "5168/Talk", "narrator": "神楽", "text": "$handle$さんと\n繋がるその日まで。"},
        { "location": "5169/Talk", "narrator": "神楽", "text": "ですよね。"},
        { "location": "5170/Talk", "narrator": "神楽", "text": "今度また一緒に見る機会が\nあれば、その時はMVの\nお話しをしましょう。"},
        { "location": "5171/Talk", "narrator": "神楽", "text": "それでは。\n$handle$さんと\n繋がるその日まで。"},
        { "location": "5172/Talk", "narrator": "神楽", "text": "ですよねー。\nそれ相応のことを\nやってきましたから。"},
        { "location": "5173/Talk", "narrator": "神楽", "text": "ですが、人を呪うときは\nまた自分も呪われる\nものなんですよ？"},
        { "location": "5174/Talk", "narrator": "神楽", "text": "……くたばれ。"},
        { "location": "5175/Talk", "narrator": "神楽", "text": "そうですか。"},
        { "location": "5176/Talk", "narrator": "神楽", "text": "$handle$さんは\n好奇心旺盛ですね。"},
        { "location": "5177/Talk", "narrator": "神楽", "text": "いいでしょう。\n今伝えられる限りの\n解説をします。"},
        { "location": "5178/Talk", "narrator": "神楽", "text": "ですが、その事で\n私の事を嫌いになっても\n自己責任でお願いします。"},
        { "location": "5179/Talk", "narrator": "神楽", "text": "鳥籠はFreyMENOWの\n世界観でも良く使う\n表現方法なんです。"},
        { "location": "5180/Talk", "narrator": "神楽", "text": "今回は歌の中では鳥籠と\nいう言葉は出ませんが、\n代替する言葉はあります。"},
        { "location": "5181/Talk", "narrator": "神楽", "text": "『声を無くした少女』が\nそれにあたります。"},
        { "location": "5182/Talk", "narrator": "神楽", "text": "これらはすなわち、\n好きな歌を自由に歌えなく\nなったことを表します。"},
        { "location": "5183/Talk", "narrator": "神楽", "text": "そして『ガラスの森』\nという言葉。"},
        { "location": "5184/Talk", "narrator": "神楽", "text": "これは、都会の森を\n暗喩する言葉です。"},
        { "location": "5185/Talk", "narrator": "神楽", "text": "ガラスの森とはすなわち\n硝子張りの高層ビル群。"},
        { "location": "5186/Talk", "narrator": "神楽", "text": "それを響かせるというのは\n大型サイネージに私の歌が\n流れるという事です。"},
        { "location": "5187/Talk", "narrator": "神楽", "text": "ここまでで\n表現していることは――"},
        { "location": "5188/Talk", "narrator": "神楽", "text": "メノウとしてデビュー\nして、好きな曲を描き、\nプロモで市中に流れる。"},
        { "location": "5189/Talk", "narrator": "神楽", "text": "そんな時代は過去の事に\nなってしまった。今では\n歌活動すらできない状況。"},
        { "location": "5190/Talk", "narrator": "神楽", "text": "そしてそんな日がまた\n来る事を願っている―と。"},
        { "location": "5191/Talk", "narrator": "神楽", "text": "ここまでは、現時点の\n私の事情を語っている\nわけではありません。"},
        { "location": "5192/Talk", "narrator": "神楽", "text": "続いて、『青い鳥』が\n出てきます。"},
        { "location": "5193/Talk", "narrator": "神楽", "text": "これが何を表現している\nかは、ここから先の解説で\n推測してみてください。"},
        { "location": "5194/Talk", "narrator": "神楽", "text": "『少女の願いを叶えた』\nすなわち、また歌える\nようになったということ。"},
        { "location": "5195/Talk", "narrator": "神楽", "text": "青い鳥が\n叶えたんです。"},
        { "location": "5196/Talk", "narrator": "神楽", "text": "そのお陰で、\n歌手活動は再開したという\n流れになります。"},
        { "location": "5197/Talk", "narrator": "神楽", "text": "でも、『壊れても』\n『欠片になっても』\n歌うことを強制されます。"},
        { "location": "5198/Talk", "narrator": "神楽", "text": "自身もまた\n『護る物は何もない』と\n自暴自棄気味です。"},
        { "location": "5199/Talk", "narrator": "神楽", "text": "そして、『青い鳥』を\n『赤く染め』るのが\n自由への道と言ってます。"},
        { "location": "5200/Talk", "narrator": "神楽", "text": "更に『翼を剥がす』。\nとても嫌な表現ですね。"},
        { "location": "5201/Talk", "narrator": "神楽", "text": "鳥は翼をもがれたら\n生きていけません。\n壊れてしまいます。"},
        { "location": "5202/Talk", "narrator": "神楽", "text": "最終的には、\n少女はこう言います。\n『奇跡で飛べるでしょう』"},
        { "location": "5203/Talk", "narrator": "神楽", "text": "この言葉。"},
        { "location": "5204/Talk", "narrator": "神楽", "text": "似たような事を過去に私が\n叫んだのを気づいた方も\nいるかもしれませんね。"},
        { "location": "5205/Talk", "narrator": "神楽", "text": "『だったら　助けてよ\n　今すぐ　その力で！！』"},
        { "location": "5206/Talk", "narrator": "神楽", "text": "誰もが奇跡だと言うその\n力が私の為の力なら、その\n力で幸せにしてみてよ―。"},
        { "location": "5207/Talk", "narrator": "神楽", "text": "それが、このセンテンスの\n意味になります。"},
        { "location": "5208/Talk", "narrator": "神楽", "text": "これで青い鳥が\n誰の比喩か、想像ついた\nかもしれませんね。"},
        { "location": "5209/Talk", "narrator": "神楽", "text": "でも、きっと鋭い人は\n釈然としないでしょう。"},
        { "location": "5210/Talk", "narrator": "神楽", "text": "この語りの最初の方、\n青い鳥が登場するあたりに\nその原因はありますね。"},
        { "location": "5211/Talk", "narrator": "神楽", "text": "そこについてのみは、\n今は多くを語らずに\nいたいと思います。"},
        { "location": "5212/Talk", "narrator": "神楽", "text": "さて。\nここまでですと、\n単なる恨み節ですよね。"},
        { "location": "5213/Talk", "narrator": "神楽", "text": "でも、\nこの歌が伝えたいのは、\nここから先なんです。"},
        { "location": "5214/Talk", "narrator": "神楽", "text": "『願いが叶うなら\n　摩天楼駆け抜け\n　貴方と旅立つの』"},
        { "location": "5215/Talk", "narrator": "神楽", "text": "摩天楼とは、\n今あるこの現代社会の\n比喩的表現です。"},
        { "location": "5216/Talk", "narrator": "神楽", "text": "それだけお伝えします。\nそれ以外は概ね、想像\nできるかと思いますので。"},
        { "location": "5217/Talk", "narrator": "神楽", "text": "……というわけで。"},
        { "location": "5218/Talk", "narrator": "神楽", "text": "これで、歌に隠された\n意味についての解説は\nお終いです。"},
        { "location": "5219/Talk", "narrator": "神楽", "text": "…なんて話してる間に\n終わってしまいましたね。"},
        { "location": "5220/Talk", "narrator": "神楽", "text": "こんなつまらない話で\n良かったんですか？"},
        { "location": "5221/Talk", "narrator": "神楽", "text": "それでは、今宵の語りは\nこの辺でお開きにさせて\nいただきたいと思います。"},
        { "location": "5222/Talk", "narrator": "神楽", "text": "$handle$さんとは、\nいずれより深くお付き合い\nする事になると思います。"},
        { "location": "5223/Talk", "narrator": "神楽", "text": "その時は――"},
        { "location": "5224/Talk", "narrator": "神楽", "text": "私のこと、\n嫌いにならないでいて\nくれると嬉しいです。"},
        { "location": "5225/Talk", "narrator": "神楽", "text": "それでは、\nまた会う日まで。"},
        { "location": "5226/Talk", "narrator": "神楽", "text": "ふふ♪"},
        { "location": "5227/Talk", "narrator": "神楽", "text": "なんて笑ってる場合じゃ\nありませんよね。"},
        { "location": "5228/Talk", "narrator": "神楽", "text": "そもそも、落ちてその後\nどうなったかは描かれて\nいませんよね？"},
        { "location": "5229/Talk", "narrator": "神楽", "text": "これを見て、地面に激突\nしたと確定した貴方は、\n思い込みが強いかもです。"},
        { "location": "5230/Talk", "narrator": "神楽", "text": "私は敢えてそこは、\nどんな結末になったかは\n描かなかったのですから。"},
        { "location": "5231/Talk", "narrator": "神楽", "text": "そうですね。\nそう思う瞬間は割と\n多いと思います。"},
        { "location": "5232/Talk", "narrator": "神楽", "text": "でも私は、それもまた\n私の人生の中での必然だと\n思う時もあるんです。"},
        { "location": "5233/Talk", "narrator": "神楽", "text": "壮絶な現実、それ自体が、\n強烈なエネルギーを持った\n創作になるから。"},
        { "location": "5234/Talk", "narrator": "神楽", "text": "それは、私にとっての\n物作りの原動力なのかも\nしれません。"},
        { "location": "5235/Talk", "narrator": "神楽", "text": "ですから。"},
        { "location": "5236/Talk", "narrator": "神楽", "text": "もし全てが終わって平和な\n環境になったらきっと、\n創作観は変わります。"},
        { "location": "5237/Talk", "narrator": "神楽", "text": "それでも尚、\n何かしら創り続けるとは\n思いますけどね。"},
        { "location": "5238/Talk", "narrator": "神楽", "text": "私にとって、創作は\n私が生きている証\nですから。"},
        { "location": "5239/Talk", "narrator": "神楽", "text": "安心しました。"},
        { "location": "5240/Talk", "narrator": "神楽", "text": "あと、私の創作物に\n興味を持ってくれたこと、\nすごく嬉しかったです。"},
        { "location": "5241/Talk", "narrator": "神楽", "text": "ですよね。"},
        { "location": "5242/Talk", "narrator": "神楽", "text": "今度また一緒に見る機会が\nあったら、その時はもっと\n楽しい話をしましょう。"},
        { "location": "5243/Talk", "narrator": "神楽", "text": "こんにちは、\n$handle$さん。"},
        { "location": "5244/Talk", "narrator": "神楽", "text": "普段、皆さんと目一杯\n交流してるのを見て、\nちょっと羨ましいから――"},
        { "location": "5245/Talk", "narrator": "神楽", "text": "今日は、いっぱい\n甘えちゃおうかなって\n思ってます。"},
        { "location": "5246/Talk", "narrator": "神楽", "text": "きっと、貴方が好きな人は\n他にいるのでしょうけど。"},
        { "location": "5247/Talk", "narrator": "神楽", "text": "今だけは、\n神楽だけの貴方で\nいてくださいね。"},
        { "location": "5248/Talk", "narrator": "神楽", "text": "最初に１つ\n注意事項をお伝えして\nおきますね。"},
        { "location": "5249/Talk", "narrator": "神楽", "text": "今回の映像には、ショッ\nキングなシーンが含まれて\nいるかもしれません。"},
        { "location": "5250/Talk", "narrator": "神楽", "text": "でも、それは\n本当の私の想い。"},
        { "location": "5251/Talk", "narrator": "神楽", "text": "受け入れられないかも\nしれませんけど、その時は\n無理しないでください。"},
        { "location": "5252/Talk", "narrator": "神楽", "text": "貴方にとって、私といたい\nという気持ちが本心からで\nなければ――"},
        { "location": "5253/Talk", "narrator": "神楽", "text": "ここで一緒にいる時間は\n全く以て無意味なものに\nなってしまいますから。"},
        { "location": "5254/Talk", "narrator": "神楽", "text": "その時は遠慮なく、\n貴方の現実へ戻って\nくださいね？"},
        { "location": "5255/Talk", "narrator": "神楽", "text": "それでは、\n準備はいいですか？"},
        { "location": "5256/Talk", "narrator": "神楽", "text": "あ、そういえば！"},
        { "location": "5257/Talk", "narrator": "神楽", "text": "もう１つ先に\nお伝えしておかないと\nいけないことが。"},
        { "location": "5258/Talk", "narrator": "神楽", "text": "私のMV、アーヤさんや\nガブちゃんのと違って――"},
        { "location": "5259/Talk", "narrator": "神楽", "text": "可愛かったり、色っぽ\nかったりするシーンは\n一切ありませんので……。"},
        { "location": "5260/Talk", "narrator": "神楽", "text": "その…\n期待してたら\nごめんなさい。"},
        { "location": "5261/Talk", "narrator": "神楽", "text": "では、改めて。"},
        { "location": "5262/Talk", "narrator": "神楽", "text": "どちらかというと、\nイメージビデオという\nよりは…そうですね。"},
        { "location": "5263/Talk", "narrator": "神楽", "text": "精神世界ビデオと\n言った方がいいかも\nしれませんね。"},
        { "location": "5264/Talk", "narrator": "神楽", "text": "なんかこう、美しいのに\nおぞましい、みたいな\n風景って好きなんです。"},
        { "location": "5265/Talk", "narrator": "神楽", "text": "そういうのも\nギャップ萌えって\n言うんでしょうかね？"},
        { "location": "5266/Talk", "narrator": "神楽", "text": "なんだか\nお喋りが楽しくて、\n全然先に進みませんね。"},
        { "location": "5267/Talk", "narrator": "神楽", "text": "ですが、そんな語らいを\nしている間にも、出発時刻\nは着々と迫っています。"},
        { "location": "5268/Talk", "narrator": "神楽", "text": "今宵、貴方と共にする旅は\nとある少女のココロの中。"},
        { "location": "5269/Talk", "narrator": "神楽", "text": "そこで出逢う物語を、\n貴方はどのように\n紐解くのでしょうか…。"},
        { "location": "5270/Talk", "narrator": "神楽", "text": "さて、そろそろ時間の\nようですよ。素敵に\nエスコートして下さいね。"},
        { "location": "5271/Talk", "narrator": "神楽", "text": "ところで――"},
        { "location": "5272/Talk", "narrator": "神楽", "text": "私とのこの貴重な時間。"},
        { "location": "5273/Talk", "narrator": "神楽", "text": "$handle$さんは、\n何を望みますか？"}
    ]
}
