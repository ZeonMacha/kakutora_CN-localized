{
    "dir": "stream_110_ch01.json",
    "type": "watchanime",
    "info": {
    },
    "entry":
    [
        { "location": "1779/Talk", "narrator": "みやび", "text": "心配は無用や。\nこの日のために総務省には\nちゃんと根回ししちゅう。"},
        { "location": "1780/Talk", "narrator": "神楽", "text": "そういえば、管理庁は\n総務省の管轄ですもんね。"},
        { "location": "1781/Talk", "narrator": "みやび", "text": "特殊攻撃隊の有する特例は\n全て調べて、合法的な\n抜け穴は調査済みや。"},
        { "location": "1782/Talk", "narrator": "ガブリエラ", "text": "ていうか、こんな事の\nために、どんだけ\n本格的にやってんのよ！"},
        { "location": "1783/Talk", "narrator": "みやび", "text": "こんな面白そうなことに\nマックスパワーで挑まんで\nどうするぞね！"},
        { "location": "1784/Talk", "narrator": "つばめ", "text": "あ、あれ？\nみやびさん、乗り気じゃ\nなかったんじゃ……"},
        { "location": "1785/Talk", "narrator": "みやび", "text": "日程や開催場所は\n事前に把握済みやし\nぬかり無しぞね。"},
        { "location": "1786/Talk", "narrator": "ガブリエラ", "text": "そういうことにだけは\n全力出すのね……。"},
        { "location": "1787/Talk", "narrator": "みやび", "text": "おもろいことには\n全力出して楽しむんは\n当たり前やき。"},
        { "location": "1788/Talk", "narrator": "つばめ", "text": "そのヘンな全力が\nわたしに向く日が\nありませんように…。"},
        { "location": "1789/Talk", "narrator": "みやび", "text": "つばめちゃん甘いで。\nうちの基本ターゲットは\nつばめちゃん設定や。"},
        { "location": "1790/Talk", "narrator": "つばめ", "text": "ふえぇっ！？"},
        { "location": "1791/Talk", "narrator": "ガブリエラ", "text": "はぁ？　この状況で\nそれ聞く？　まぁ、\n楽しかったけど……。"},
        { "location": "1792/Talk", "narrator": "みやび", "text": "映像を見返すと卯月が\n一番楽しんでたように\n見えたけんど。"},
        { "location": "1793/Talk", "narrator": "神楽", "text": "はい、作戦のことは\n完全に頭から\n消えてました！"},
        { "location": "1794/Talk", "narrator": "ガブリエラ", "text": "清々しいまでに\n他人ごとなのね、\nあんたは……。"},
        { "location": "1795/Talk", "narrator": "つばめ", "text": "でもわたしも実は\nすっごく楽しかったです。"},
        { "location": "1796/Talk", "narrator": "みやび", "text": "お祭りは楽しんで\nなんぼやき\nそれでええんよ。"},
        { "location": "1797/Talk", "narrator": "ガブリエラ", "text": "ええ、\n変な悪だくみさえ\n無かったらね……。"},
        { "location": "1798/Talk", "narrator": "ガブリエラ", "text": "って、あたしの話は\nもういいから！\nそれより、つばめ。"},
        { "location": "1799/Talk", "narrator": "つばめ", "text": "は、はいっ！？"},
        { "location": "1800/Talk", "narrator": "ガブリエラ", "text": "あたしも人混みは\nあまり好きじゃ\nないけどね。"},
        { "location": "1801/Talk", "narrator": "つばめ", "text": "ガブちゃん、すぐ迷子に\nなりそうですもんね。"},
        { "location": "1802/Talk", "narrator": "ガブリエラ", "text": "あんたが言うな！\nそれと、今あたしの\n背のこと言ったでしょ？"},
        { "location": "1803/Talk", "narrator": "つばめ", "text": "あっ、いや、ガブちゃん\n外国人だから、\n迷いやすいかなって。"},
        { "location": "1804/Talk", "narrator": "みやび", "text": "ガブちゃん、見た目は\n目立つんやけど\n人が多いとなぁ。"},
        { "location": "1805/Talk", "narrator": "ガブリエラ", "text": "やっぱり背のこと\n言ってるじゃない！"},
        { "location": "1806/Talk", "narrator": "神楽", "text": "でも可愛いから\n大丈夫ですよ♪"},
        { "location": "1807/Talk", "narrator": "ガブリエラ", "text": "全然フォローに\nなってなーいっ！！"},
        { "location": "1808/Talk", "narrator": "ガブリエラ", "text": "って、あたしの話は\nもういいから！\nそれより、つばめ。"},
        { "location": "1809/Talk", "narrator": "つばめ", "text": "は、はいっ！？"},
        { "location": "1810/Talk", "narrator": "ガブリエラ", "text": "……まぁ、やっと\nこの回が終わったから\nもういいわ。忘れて。"},
        { "location": "1811/Talk", "narrator": "ガブリエラ", "text": "むしろあたしが直々に\nその脳内から記憶を\n消去してあげたいわ。"},
        { "location": "1812/Talk", "narrator": "ガブリエラ", "text": "……あんたのスマホを\nリモートで壊せば\nいいのかしら？"},
        { "location": "1813/Talk", "narrator": "つばめ", "text": "ガブちゃん、だめだよ、\nそんなことしたら…。"},
        { "location": "1814/Talk", "narrator": "つばめ", "text": "でも本当に何にも\n無かったのかなぁ？\n怪しいなぁ……。"},
        { "location": "1815/Talk", "narrator": "つばめ", "text": "……あっ、いえ、\nな、何も変なことは\n考えて無いですよぉ？"},
        { "location": "1816/Talk", "narrator": "アーヤ", "text": "ええ、わかってる。\nもうここで語るのは\n諦めたから。"},
        { "location": "1817/Talk", "narrator": "アーヤ", "text": "だから、これが\n終わった後で、\nあなたにだけ語るわ。"},
        { "location": "1818/Talk", "narrator": "アーヤ", "text": "三時間ほど。"},
        { "location": "1819/Talk", "narrator": "みやび", "text": "焼き物・粉物は下手に\n語ったら危ないきに\nうちもドキドキや。"},
        { "location": "1820/Talk", "narrator": "みやび", "text": "食べ物のことになると\n譲れんことちゅうんが\nあるんかねぇ。"},
        { "location": "1821/Talk", "narrator": "みやび", "text": "$handle$の\nこだわりも、今度\n聞いちゃろうねえ。"},
        { "location": "1822/Talk", "narrator": "つばめ", "text": "ここで視聴者さんから\n届いたお手紙を\n紹介します。"},
        { "location": "1823/Talk", "narrator": "みやび", "text": "いきなり唐突な\n展開やな！　そもそも\n視聴者って誰や！？"},
        { "location": "1824/Talk", "narrator": "みやび", "text": "検証するんが\n馬鹿らしゅうなる\n展開にはせられんよ。"},
        { "location": "1825/Talk", "narrator": "つばめ", "text": "えーと……、\n『トライナリーの\n皆さん、こんにちは』"},
        { "location": "1826/Talk", "narrator": "神楽", "text": "こんにちはーっ♪"},
        { "location": "1827/Talk", "narrator": "つばめ", "text": "『突然ですが、本日の\n鑑賞会は中止した方が\n身のためです』"},
        { "location": "1828/Talk", "narrator": "アーヤ", "text": "いきなり\n穏やかじゃない話に\nなったわね。"},
        { "location": "1829/Talk", "narrator": "つばめ", "text": "『ていうか中止ったら\n中止なの！　さっさと\n解散しなさい！』"},
        { "location": "1830/Talk", "narrator": "つばめ", "text": "あの～……、\nこれって、\nもしかして……。"},
        { "location": "1831/Talk", "narrator": "アーヤ", "text": "……ちょっと\n待ってて。"},
        { "location": "1832/Talk", "narrator": "ガブリエラ", "text": "なっ……なっ、\n何なのよっ！？\n文句あるわけ！？"},
        { "location": "1833/Talk", "narrator": "みやび", "text": "しかもいきなり\n逆ギレしちゅう！"},
        { "location": "1834/Talk", "narrator": "つばめ", "text": "ガブちゃん、\n今どき不幸の手紙は\nどうかと思うんだけど…。"},
        { "location": "1835/Talk", "narrator": "ガブリエラ", "text": "真顔で言わないでよ！\nあたしだって\nつらいんだからっ！"},
        { "location": "1836/Talk", "narrator": "みやび", "text": "謎の一端が垣間見える\nかと思いきや、\nこないなオチとは。"},
        { "location": "1837/Talk", "narrator": "ガブリエラ", "text": "ガッカリさせちゃって\n悪かったわね！"},
        { "location": "1838/Talk", "narrator": "神楽", "text": "むしろこの実年齢より\n子供っぽい感じ、\nグッドですよグッド。"},
        { "location": "1839/Talk", "narrator": "ガブリエラ", "text": "ごめん。アンタの\n趣味は理解できない。"},
        { "location": "1840/Talk", "narrator": "つばめ", "text": "……それで、わたしは\nこの手紙を何人に\n出せばいいんですか？"},
        { "location": "1841/Talk", "narrator": "ガブリエラ", "text": "つっこむの遅れたけど\nそれ不幸の手紙じゃ\nないから！"},
        { "location": "1842/Talk", "narrator": "神楽", "text": "こんな感じに今回も\n面白トーク満載で\n本編スタートっ！"},
        { "location": "1843/Talk", "narrator": "つばめ", "text": "さぁ、そんなわけで、\nいよいよ七夕まつりの\n本番ですよ♪"},
        { "location": "1844/Talk", "narrator": "ガブリエラ", "text": "はしゃがないでよ。\n恥ずかしいわね。"},
        { "location": "1845/Talk", "narrator": "みやび", "text": "いやいや、お祭りやき\nはしゃいだ者勝ちぞね。"},
        { "location": "1846/Talk", "narrator": "神楽", "text": "はい、私もすっごく\nはしゃいじゃいます！"},
        { "location": "1847/Talk", "narrator": "ガブリエラ", "text": "何か……アーヤが\nいないと、ダメな子\nばっかりね……。"},
        { "location": "1848/Talk", "narrator": "神楽", "text": "さて、お祭りと言えば\n屋台！　ということで\n好きな屋台は何っ？"},
        { "location": "1849/Talk", "narrator": "つばめ", "text": "わたしは鯛焼きっ！\n一番好きな具は\nチーズクリーム～～！！"},
        { "location": "1850/Talk", "narrator": "つばめ", "text": "あっ、だからって\n他の具が劣るとかじゃ\nないんだよ？"},
        { "location": "1851/Talk", "narrator": "つばめ", "text": "鯛焼きに包まれたら\n何だって美味しく\nなっちゃうからっ！"},
        { "location": "1852/Talk", "narrator": "みやび", "text": "それ納豆とかでも\nええんかね？"},
        { "location": "1853/Talk", "narrator": "つばめ", "text": "そうですね、\n今度マイ鯛焼き器で\n作って試してみます！"},
        { "location": "1854/Talk", "narrator": "ガブリエラ", "text": "念のため言っとくけど\nそれ自分一人で\n食べ切ってよね？"},
        { "location": "1855/Talk", "narrator": "つばめ", "text": "たくさん作って\nみんなで食べようと\n思ってたのにっ！？"},
        { "location": "1856/Talk", "narrator": "ガブリエラ", "text": "ちなみにあたしは\n鯛じゃなくて\nたこ焼きよ。"},
        { "location": "1857/Talk", "narrator": "ガブリエラ", "text": "たこ焼きの具はたこに\n決まってるけど、今度\n他のも試してみるわ。"},
        { "location": "1858/Talk", "narrator": "つばめ", "text": "えっ？　ガブちゃん、\nマイたこ焼き器を\n持ってるの？"},
        { "location": "1859/Talk", "narrator": "ガブリエラ", "text": "べつにそれくらい\n日本人なら\n普通でしょ？"},
        { "location": "1860/Talk", "narrator": "みやび", "text": "それ地域が限られ\nちょるし、ガブちゃん\n日本人と違うし。"},
        { "location": "1861/Talk", "narrator": "つばめ", "text": "じゃあ焼き物対決、\nじゃなくてパーティー\nしましょう！"},
        { "location": "1862/Talk", "narrator": "ガブリエラ", "text": "それ、破滅的な未来が\n簡単に予想できるから\n嫌よ。"},
        { "location": "1863/Talk", "narrator": "つばめ", "text": "何でっ！？"},
        { "location": "1864/Talk", "narrator": "神楽", "text": "私は……そうですね、\nクレープでしょうか。"},
        { "location": "1865/Talk", "narrator": "みやび", "text": "何や言い出しっぺに\nしてはオーソドックス\nちゅうか無難やねえ。"},
        { "location": "1866/Talk", "narrator": "神楽", "text": "つばめさんみたいに\n面白おかしいネタを\n提供できなくて残念です。"},
        { "location": "1867/Talk", "narrator": "つばめ", "text": "ちょっと待って～！\nわたしべつにボケた\nつもりは無いんだけど…。"},
        { "location": "1868/Talk", "narrator": "ガブリエラ", "text": "今ジャミングって\n言ってなかった！？\nみやび、何やってるのよ！"},
        { "location": "1869/Talk", "narrator": "アーヤ", "text": "ところで屋台談義が\n途中だったわよね？"},
        { "location": "1870/Talk", "narrator": "みやび", "text": "……もしかして\nそれ語りたいがために\n出て来たん？"},
        { "location": "1871/Talk", "narrator": "アーヤ", "text": "私はリンゴ飴派ね。"},
        { "location": "1872/Talk", "narrator": "みやび", "text": "しかも早速\n語り始めちょうし。"},
        { "location": "1873/Talk", "narrator": "つばめ", "text": "あの～、ここからは\nガブちゃんの、しっとり\nいい感じのシーンが。"},
        { "location": "1874/Talk", "narrator": "ガブリエラ", "text": "アーヤ！\n画面は無視して\n続けていいわよ！"},
        { "location": "1875/Talk", "narrator": "アーヤ", "text": "ええ、\n言われるまでもなく、\n続けさせてもらうわ。"},
        { "location": "1876/Talk", "narrator": "つばめ", "text": "そんなぁ～……。"},
        { "location": "1877/Talk", "narrator": "アーヤ", "text": "鯛焼きやたこ焼きと\n違ってリンゴ飴の\n中味はリンゴ。"},
        { "location": "1878/Talk", "narrator": "アーヤ", "text": "だから語ることなんて\n無いだろうと思ったら\n大間違いよ。"},
        { "location": "1879/Talk", "narrator": "みやび", "text": "アーヤは長野県の出身\nやから、リンゴには\nうるさいんやな。"},
        { "location": "1880/Talk", "narrator": "アーヤ", "text": "そうね、長野的には\nあんず飴もアリね。"},
        { "location": "1881/Talk", "narrator": "みやび", "text": "あ、話脱線させんと\nリンゴ飴についてだけ\n語さんかね。"},
        { "location": "1882/Talk", "narrator": "つばめ", "text": "ガブちゃんの貴重な\nドキドキシーンが\nリンゴ飴語りに……。"},
        { "location": "1883/Talk", "narrator": "アーヤ", "text": "いい？　リンゴ飴に\n使われる主な品種は\n姫りんごと言うの。"},
        { "location": "1884/Talk", "narrator": "アーヤ", "text": "ただ、本来「姫林檎」と\n呼ばれている果実は\n別にあるから要注意ね。"},
        { "location": "1885/Talk", "narrator": "アーヤ", "text": "要するに小玉な品種の\nリンゴを使ってるって\nわけ。"},
        { "location": "1886/Talk", "narrator": "つばめ", "text": "確かに大きいと\nちょっと食べづらい\nですよね。"},
        { "location": "1887/Talk", "narrator": "アーヤ", "text": "そんな中でも、最近では\n美味しくて食べやすい\n新種も開発されていて――"},
        { "location": "1888/Talk", "narrator": "みやび", "text": "アーヤ、ストップ。\n話が脱線どころか\n暴走始めちょる。"},
        { "location": "1889/Talk", "narrator": "アーヤ", "text": "……あと３０分くらい\n私に時間を\nもらえないかしら？"},
        { "location": "1890/Talk", "narrator": "つばめ", "text": "ダメですよ！\nガブちゃんのシーンに\n話を戻しましょう！"},
        { "location": "1891/Talk", "narrator": "ガブリエラ", "text": "じゃあ次はみやびが\n語ってちょうだい。"},
        { "location": "1892/Talk", "narrator": "みやび", "text": "そうやねー、\nうちが好きなんは、\nどさんこ焼きかねえ。"},
        { "location": "1893/Talk", "narrator": "ガブリエラ", "text": "なにそれ！？\n初めて聞くんだけど。"},
        { "location": "1894/Talk", "narrator": "みやび", "text": "あー、うん、\n全国的にはマイナー\nかも知れんきね。"},
        { "location": "1895/Talk", "narrator": "みやび", "text": "すっごく大雑把に\n言うたら、北海道の\nおやきや。"},
        { "location": "1896/Talk", "narrator": "アーヤ", "text": "おやきと一緒に\nしないでちょうだい！"},
        { "location": "1897/Talk", "narrator": "みやび", "text": "しもた…。\n長野県民のこだわりに\n引っかかった！"},
        { "location": "1898/Talk", "narrator": "アーヤ", "text": "私から見たら、\n小さいお好み焼き\nって感じね。"},
        { "location": "1899/Talk", "narrator": "みやび", "text": "それはそれで色々と\n物議を醸しそうやし\n深入りはやめとこか。"},
        { "location": "1900/Talk", "narrator": "みやび", "text": "そんでガブちゃん\nこん時どこ行っとったん？\nトイレ？"},
        { "location": "1901/Talk", "narrator": "ガブリエラ", "text": "ち、違うわよっ！！"},
        { "location": "1902/Talk", "narrator": "ガブリエラ", "text": "その……気まずくて\n居たたまれなくなった\nって言うか……。"},
        { "location": "1903/Talk", "narrator": "ガブリエラ", "text": "でも、元はと言えば\nつばめたちが変なこと\n企んでたせいだし！"},
        { "location": "1904/Talk", "narrator": "つばめ", "text": "あっ、そ、それは、\nその……。"},
        { "location": "1905/Talk", "narrator": "みやび", "text": "まぁ、実際企んだんは\nつばめちゃんやなくて\nうちやけんど。"},
        { "location": "1906/Talk", "narrator": "ガブリエラ", "text": "それは言われなくても\nわかってるし、\n開き直るなーっ！"},
        { "location": "1907/Talk", "narrator": "アーヤ", "text": "ところで、そろそろ\nまたリンゴ飴について\n語ってもいいかしら？"},
        { "location": "1908/Talk", "narrator": "みやび", "text": "まだ諦めずに機会を\nうかがっとったんかね！\nもう退場しときっ。"},
        { "location": "1909/Talk", "narrator": "アーヤ", "text": "えぇっ！？\n何でそうなるのっ！？"},
        { "location": "1910/Talk", "narrator": "アーヤ", "text": "わ、私だけ\n物足りない気持ちに\nさせるなんてっ。"},
        { "location": "1911/Talk", "narrator": "神楽", "text": "アーヤさん、\nしょんぼりしてました\nけど、いいんですか？"},
        { "location": "1912/Talk", "narrator": "みやび", "text": "元はと言えば卯月が\n屋台の話題を\n振ったからぞね。"},
        { "location": "1913/Talk", "narrator": "神楽", "text": "いえ私も、アーヤさん\nならベビーカステラ\nとか無難に流すかと。"},
        { "location": "1914/Talk", "narrator": "つばめ", "text": "イメージ的には\nそれよりもイカ焼き\nとかかなぁ、アーヤさん。"},
        { "location": "1915/Talk", "narrator": "ガブリエラ", "text": "……アーヤ、\n舞台の袖で\n泣いてるわよ。"},
        { "location": "1916/Talk", "narrator": "つばめ", "text": "あぁっ！？\nアーヤさんもしかして\nイカが嫌いだった！？"},
        { "location": "1917/Talk", "narrator": "ガブリエラ", "text": "そうじゃなくて……。"},
        { "location": "1918/Talk", "narrator": "神楽", "text": "そう言えばイカ焼きと\nたこ焼きって\n全然違いますよね。"},
        { "location": "1919/Talk", "narrator": "みやび", "text": "ところが何と\n大阪のイカ焼きは\n粉物なんよ。"},
        { "location": "1920/Talk", "narrator": "つばめ", "text": "えっ？　それは\n知らなかったです。\nどんなのなんですか？"},
        { "location": "1921/Talk", "narrator": "神楽", "text": "たこの代わりにイカが\n入ってるんですか？"},
        { "location": "1922/Talk", "narrator": "みやび", "text": "どっちかと言うたら\nお好み焼きみたいな\n感じやねえ。"},
        { "location": "1923/Talk", "narrator": "ガブリエラ", "text": "あんたたち、アーヤを\n追い出したくせに\n脱線してるわよ……。"},
        { "location": "1924/Talk", "narrator": "ガブリエラ", "text": "ここでいきなり\n泣くことないでしょ？\n許すって言ったのに。"},
        { "location": "1925/Talk", "narrator": "つばめ", "text": "あっ、それはその、\nガブちゃんに叱られた\nからとかじゃなくて、"},
        { "location": "1926/Talk", "narrator": "つばめ", "text": "ガブちゃんの役に\n立ちたかったのに\n結局、立てなくて、"},
        { "location": "1927/Talk", "narrator": "つばめ", "text": "自分が情けなくて、\n悲しくなっちゃった\nからで……。"},
        { "location": "1928/Talk", "narrator": "みやび", "text": "つばめちゃんはまっこと\nええ子やねえ。\nええ子過ぎるぞね。"},
        { "location": "1929/Talk", "narrator": "神楽", "text": "はい、私、ますます\nつばめさんのことが\n好きになりました。"},
        { "location": "1930/Talk", "narrator": "つばめ", "text": "えぇっ！？　ぜ、全然\nそんなこと、ないよ？\nわ、わたしなんてっ。"},
        { "location": "1931/Talk", "narrator": "ガブリエラ", "text": "つばめがいい子なこと\nくらい、あたしだって\n知ってるから！"},
        { "location": "1932/Talk", "narrator": "つばめ", "text": "はわわわわわっ。\nもしかしてわたし、\n今日、天に召される？"},
        { "location": "1933/Talk", "narrator": "みやび", "text": "ガブリエラだけに？\nつばめちゃん、\n上手いこと言うねえ。"},
        { "location": "1934/Talk", "narrator": "ガブリエラ", "text": "ていうか、つばめって\n褒められるのに慣れて\nないんじゃない？"},
        { "location": "1935/Talk", "narrator": "つばめ", "text": "そ、それより結局、\nガブちゃんのドキドキは\nどうなったのかなぁ？"},
        { "location": "1936/Talk", "narrator": "ガブリエラ", "text": "だからそれは\n誤解だって\n言ってるでしょっ！！"},
        { "location": "1937/Talk", "narrator": "神楽", "text": "屋台の話題ばかりに\nなってましたけど、\n作戦は結局失敗？"},
        { "location": "1938/Talk", "narrator": "神楽", "text": "私としてはお祭りを\n楽しんだので\n大成功ですけどっ。"},
        { "location": "1939/Talk", "narrator": "神楽", "text": "今度は貴方も一緒に\nどうですか？"}
    ]
}
