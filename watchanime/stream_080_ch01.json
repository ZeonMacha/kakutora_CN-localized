{
    "dir": "stream_080_ch01.json",
    "type": "watchanime",
    "info": {
    },
    "entry":
    [
        { "location": "1242/Talk", "narrator": "神楽", "text": "そうなんですよ。体重の\n増減で飛べるかどうかが\n決まっちゃうので！"},
        { "location": "1243/Talk", "narrator": "つばめ", "text": "ほえ～。\n大変なんだねぇ。\n頑張って痩せなくちゃね！"},
        { "location": "1244/Talk", "narrator": "神楽", "text": "……つばめさんの\n騙されやすさが裏目に出て\n自爆しました……。"},
        { "location": "1245/Talk", "narrator": "つばめ", "text": "えっ？\nもしかして\n冗談だったの！？"},
        { "location": "1246/Talk", "narrator": "みやび", "text": "すっと理由は\n教えちゃるき。"},
        { "location": "1247/Talk", "narrator": "みやび", "text": "卯月は武器を\n使いよる時は\n飛べんぞね。"},
        { "location": "1248/Talk", "narrator": "アーヤ", "text": "卯月の鎌型の武器は\n空を飛ぶホウキが\n変型したものなのよ。"},
        { "location": "1249/Talk", "narrator": "つばめ", "text": "なるほど！\nそういうこと\nだったんですね。"},
        { "location": "1250/Talk", "narrator": "神楽", "text": "あーっ、二人とも\n種明かしするの\n早過ぎですよー。"},
        { "location": "1251/Talk", "narrator": "神楽", "text": "でもそれって結局、\n私だけだと飛べない\nってことですよね？"},
        { "location": "1252/Talk", "narrator": "つばめ", "text": "えーと、じゃあ\n二人の友情パワーで\n二倍速とか？"},
        { "location": "1253/Talk", "narrator": "みやび", "text": "ちなみに、この時\n名前は知っちゅうけんけど\nうちら初対面やきね。"},
        { "location": "1254/Talk", "narrator": "つばめ", "text": "えぇっ！？\nそれであの\nコンビネーション！？"},
        { "location": "1255/Talk", "narrator": "みやび", "text": "すっと理由は\n教えちゃるき。"},
        { "location": "1256/Talk", "narrator": "みやび", "text": "卯月は武器を\n使いよる時は\n飛べんぞね。"},
        { "location": "1257/Talk", "narrator": "アーヤ", "text": "卯月の鎌型の武器は\n空を飛ぶホウキが\n変型したものなのよ。"},
        { "location": "1258/Talk", "narrator": "つばめ", "text": "なるほど！\nそういうこと\nだったんですね。"},
        { "location": "1259/Talk", "narrator": "神楽", "text": "あーっ、二人とも\n種明かしするの\n早過ぎですよー。"},
        { "location": "1260/Talk", "narrator": "みやび", "text": "やって。\nよかったなぁ、\nつばめちゃん。"},
        { "location": "1261/Talk", "narrator": "つばめ", "text": "ふえぇっ！？\nせ、成長期\nですからっ！"},
        { "location": "1262/Talk", "narrator": "ガブリエラ", "text": "うわぁ……。\n本気でドン引き……。"},
        { "location": "1263/Talk", "narrator": "神楽", "text": "なるほどー。\nつまりガブちゃんは\n悪ってことですね。"},
        { "location": "1264/Talk", "narrator": "ガブリエラ", "text": "神楽にだけは\n言われたく\nないんだけどっ！？"},
        { "location": "1265/Talk", "narrator": "みやび", "text": "ほほう？\nうちと同じ境地とは\nやるねえ。"},
        { "location": "1266/Talk", "narrator": "つばめ", "text": "どんな境地ですかっ！"},
        { "location": "1267/Talk", "narrator": "みやび", "text": "つまり、\n女の子の胸に\n貴賤無しや。"},
        { "location": "1268/Talk", "narrator": "みやび", "text": "みんな違って\nみんなイイ、やき。"},
        { "location": "1269/Talk", "narrator": "ガブリエラ", "text": "……何かこの人、\n勝手に語っちゃって\nるんですけど……。"},
        { "location": "1270/Talk", "narrator": "つばめ", "text": "今から\n$handle$さんの\n記憶を消去します！"},
        { "location": "1271/Talk", "narrator": "つばめ", "text": "今日見たことは\n忘れて～。忘れて～。"},
        { "location": "1272/Talk", "narrator": "つばめ", "text": "お願いですから、\n忘れてくださいぃ～！"},
        { "location": "1273/Talk", "narrator": "ガブリエラ", "text": "……ちょっとあんた、\n後で話があるから\n待ってなさい。"},
        { "location": "1274/Talk", "narrator": "ガブリエラ", "text": "あ、あたしはどうでも\nいいんだけど、ほら、\n胸について、ね。"},
        { "location": "1275/Talk", "narrator": "ガブリエラ", "text": "あんたの見解を\nキッチリ確認しておく\n必要があるんだからっ！"},
        { "location": "1276/Talk", "narrator": "みやび", "text": "ちなみにうちらで\n一番たわわなんわ\nうちやきね。"},
        { "location": "1277/Talk", "narrator": "みやび", "text": "こじゃんと憶えといて\nしっかりチェック\nしときや。"},
        { "location": "1278/Talk", "narrator": "みやび", "text": "うちからのサービス、\nきっちり見逃さん\nようにな～。"},
        { "location": "1279/Talk", "narrator": "アーヤ", "text": "やっぱり５人揃うと\n収拾が難しいわね。\nおつかれさま。"},
        { "location": "1280/Talk", "narrator": "アーヤ", "text": "それにしても二人で\nお風呂に入るなんて\nずるいわね……。"},
        { "location": "1281/Talk", "narrator": "アーヤ", "text": "あっ、いえ、\nこっちの話よ。\n気にしないでっ。"},
        { "location": "1282/Talk", "narrator": "神楽", "text": "えーと、前回は\n遅刻しちゃったので、\n改めまして。"},
        { "location": "1283/Talk", "narrator": "神楽", "text": "卯月神楽です。\n出遅れた分、とっても\nがんばっちゃいます♪"},
        { "location": "1284/Talk", "narrator": "つばめ", "text": "卯月さん、わたしも\nがんばるから、\nよろしくねっ♪"},
        { "location": "1285/Talk", "narrator": "神楽", "text": "はい♪\nつばめさんと私とで\n盛り上げますよっ♪"},
        { "location": "1286/Talk", "narrator": "みやび", "text": "二人きりで仕切るんは\nずるいちや。\nうちも混ぜてほしいぞね。"},
        { "location": "1287/Talk", "narrator": "アーヤ", "text": "ええ、逢瀬さんと卯月の\n二人だけでは\nまだまだ不安ね。"},
        { "location": "1288/Talk", "narrator": "神楽", "text": "アーヤさんも\nみやびさんも、\n心配し過ぎですよ。"},
        { "location": "1289/Talk", "narrator": "神楽", "text": "私とつばめさんが\n力を合わせれば\n無敵ですからっ！"},
        { "location": "1290/Talk", "narrator": "つばめ", "text": "えと……さすがに\nそれは言い過ぎだと\n思うんだけど……。"},
        { "location": "1291/Talk", "narrator": "つばめ", "text": "まずはアーヤさんや\nみやびさんに流れを\n作ってもらって……。"},
        { "location": "1292/Talk", "narrator": "みやび", "text": "そうやね。\nあっためとくんは\nうちらにまかせとき。"},
        { "location": "1293/Talk", "narrator": "アーヤ", "text": "いつから私まで\nコンビ扱いに……。"},
        { "location": "1294/Talk", "narrator": "みやび", "text": "アーヤはうちが認めた\nツッコミストやきね。\nいけるいける。"},
        { "location": "1295/Talk", "narrator": "神楽", "text": "つばめさん！\nこれは私たちも\n負けてられませんよ！"},
        { "location": "1296/Talk", "narrator": "つばめ", "text": "あの……わたしは\nそういう勝ち負けは\nかなりどうでも……。"},
        { "location": "1297/Talk", "narrator": "みやび", "text": "あと今さらやけんど、\n関西っぽいからちゅうて\n芸人扱いはどうなが？"},
        { "location": "1298/Talk", "narrator": "アーヤ", "text": "ええ…？　それは…\n乗るだけ乗っておいて\n今さらな発言じゃない？"},
        { "location": "1299/Talk", "narrator": "みやび", "text": "皆の期待は裏切れんし\nそこは仕方ないんよ。\n需要的な問題で。"},
        { "location": "1300/Talk", "narrator": "神楽", "text": "自分のキャラに\n責任を持つその姿勢、\n尊敬しますっ！"},
        { "location": "1301/Talk", "narrator": "アーヤ", "text": "ほら、\nそろそろ始まるわよ。"},
        { "location": "1302/Talk", "narrator": "神楽", "text": "ということで、\nそれでは今回も\n張り切っていきましょう！"},
        { "location": "1303/Talk", "narrator": "神楽", "text": "は～い、みやびさんが\n飛んでますよ～。\nびゅんびゅんですね。"},
        { "location": "1304/Talk", "narrator": "みやび", "text": "何やまぬけに\n飛んでるみたいに\n言われんといてや。"},
        { "location": "1305/Talk", "narrator": "神楽", "text": "ちなみに実は私も\n飛べちゃうんですよ？\nおそろいですねっ。"},
        { "location": "1306/Talk", "narrator": "つばめ", "text": "あーっ！\n二人とも\nいいなぁ。"},
        { "location": "1307/Talk", "narrator": "みやび", "text": "……卯月、それ、\nネタバレぞね。"},
        { "location": "1308/Talk", "narrator": "神楽", "text": "それより、ここから\nつばめさんの\n大活躍ですよっ！"},
        { "location": "1309/Talk", "narrator": "つばめ", "text": "って、いきなり\n言われても、わたしは\n何が何やらだよ…。"},
        { "location": "1310/Talk", "narrator": "アーヤ", "text": "ところで卯月、\nよく逢瀬さんの武器を\n知ってたわね。"},
        { "location": "1311/Talk", "narrator": "神楽", "text": "はい、この時のために\n情報サイトを見て\n予習はバッチリです！"},
        { "location": "1312/Talk", "narrator": "つばめ", "text": "えっ？　ちょっと\n何それ！？\nどこにあるの！？"},
        { "location": "1313/Talk", "narrator": "つばめ", "text": "って…あ、あれっ？"},
        { "location": "1314/Talk", "narrator": "みやび", "text": "忙しい子やね。\n今度はどうしたが？"},
        { "location": "1315/Talk", "narrator": "つばめ", "text": "卯月さんって\nさっき飛べるって\n聞いたんですけど"},
        { "location": "1316/Talk", "narrator": "つばめ", "text": "何でここでは\nみやびさんに抱えられ\nてるんですか？"},
        { "location": "1317/Talk", "narrator": "神楽", "text": "それを説明すると\n一時間くらいに\nなっちゃいますけど……"},
        { "location": "1318/Talk", "narrator": "つばめ", "text": "えぇっ！？\nそんなに深い\n理由が……？"},
        { "location": "1319/Talk", "narrator": "つばめ", "text": "ところで、ここの\n７０４って数字は\n何なんですか？"},
        { "location": "1320/Talk", "narrator": "アーヤ", "text": "それはクランの\n管理番号ね。"},
        { "location": "1321/Talk", "narrator": "神楽", "text": "わぁ、７００体も\n持ってるなんて\nすごいですねっ。"},
        { "location": "1322/Talk", "narrator": "みやび", "text": "そんなわけないぞね。\nたまたまその番号のを\n使うただけやき。"},
        { "location": "1323/Talk", "narrator": "みやび", "text": "ゆうとるうちに\nうちのサービスシーン\n終わりゆうね。"},
        { "location": "1324/Talk", "narrator": "つばめ", "text": "あれっ！？\nせんぱい！？"},
        { "location": "1325/Talk", "narrator": "ガブリエラ", "text": "あれっ！？\nじゃないわよっ！"},
        { "location": "1326/Talk", "narrator": "ガブリエラ", "text": "あたしの見せ場に\nあたしがいないなんて\nおかしいでしょ！？"},
        { "location": "1327/Talk", "narrator": "神楽", "text": "じゃあガブちゃんの\n見せ場、終わったから\nもう帰るんですか？"},
        { "location": "1328/Talk", "narrator": "ガブリエラ", "text": "帰らないわよっ！！"},
        { "location": "1329/Talk", "narrator": "神楽", "text": "じゃあ一緒に\nつばめさんの活躍を\n応援しましょうっ！"},
        { "location": "1330/Talk", "narrator": "神楽", "text": "あっ、すごい。\nつばめさんパンチ！\nそしてそこからー。"},
        { "location": "1331/Talk", "narrator": "神楽", "text": "つばめさん穴広げっ！"},
        { "location": "1332/Talk", "narrator": "ガブリエラ", "text": "神楽、とりあえず、\nその技名のセンス、\nどうにかしなさいよ……。"},
        { "location": "1333/Talk", "narrator": "神楽", "text": "そしてー、\nクラン引っこ抜き、\n大成功ーっ！"},
        { "location": "1334/Talk", "narrator": "ガブリエラ", "text": "大根とか芋じゃ\nないんだからさ……。"},
        { "location": "1335/Talk", "narrator": "神楽", "text": "クランっていつも\nこんな風に\n全裸なんですか？"},
        { "location": "1336/Talk", "narrator": "アーヤ", "text": "いえ、たまたまよ。\n何らかの心理的要因が\nあったのかもね。"},
        { "location": "1337/Talk", "narrator": "神楽", "text": "何にしろ、\nつばめさん、見事な\nゴールでしたっ。"},
        { "location": "1338/Talk", "narrator": "アーヤ", "text": "逢瀬さん、\n初めてにしては\n上出来だったわよ。"},
        { "location": "1339/Talk", "narrator": "ガブリエラ", "text": "一応、頑張ったことは\n認めてあげるわ。"},
        { "location": "1340/Talk", "narrator": "つばめ", "text": "せんぱい、まだ\nツンデレなんですか？"},
        { "location": "1341/Talk", "narrator": "ガブリエラ", "text": "ツンデレって言うな！"},
        { "location": "1342/Talk", "narrator": "神楽", "text": "ところで何で\nつばめさん一人で\n劇場のお掃除を？"},
        { "location": "1343/Talk", "narrator": "ガブリエラ", "text": "そりゃ掃除は\n新入りの仕事だし。"},
        { "location": "1344/Talk", "narrator": "ガブリエラ", "text": "ていうか神楽、\nあんただって\n新入りでしょ？"},
        { "location": "1345/Talk", "narrator": "神楽", "text": "あれ？\nそうでしたっけ？"},
        { "location": "1346/Talk", "narrator": "アーヤ", "text": "掃除は当番制だから\nそういうのじゃ\nないわよ。"},
        { "location": "1347/Talk", "narrator": "アーヤ", "text": "はい、いい機会だから\nここから皆でクランの\n紹介をしていくわよ。"},
        { "location": "1348/Talk", "narrator": "つばめ", "text": "あっ、この子は\nちとせ。\nちーちゃんです。"},
        { "location": "1349/Talk", "narrator": "つばめ", "text": "言ってた通り、\n昼間のフェノメノンの\n時の子ですね。"},
        { "location": "1350/Talk", "narrator": "ガブリエラ", "text": "何か昼間の時から\n縮んでない？"},
        { "location": "1351/Talk", "narrator": "つばめ", "text": "……気のせいじゃ\nないかな？"},
        { "location": "1352/Talk", "narrator": "つばめ", "text": "元々は推理小説を\n読むのが大好きな\n子だったんだよ。"},
        { "location": "1353/Talk", "narrator": "神楽", "text": "文学少女、ですね。"},
        { "location": "1354/Talk", "narrator": "つばめ", "text": "でも家が厳しくて、\nスマホは高三になって\nやっと持てたんだ。"},
        { "location": "1355/Talk", "narrator": "アーヤ", "text": "それで流行っていた\nＷＡＶＥに乗り遅れた\nのが発症の一要因ね。"},
        { "location": "1356/Talk", "narrator": "つばめ", "text": "でもクランになって\nデジタルクラッキング\nに強くなったんだよ。"},
        { "location": "1357/Talk", "narrator": "ガブリエラ", "text": "トラウマを乗り越えた\nみたいな感じ\nなのかしらね。"},
        { "location": "1358/Talk", "narrator": "みやび", "text": "お次は播磨藤治郎。\n通称「とうちゃん」\nぞね。"},
        { "location": "1359/Talk", "narrator": "みやび", "text": "うちがシールド張る時\n呼ぶき、お馴染みやろ。"},
        { "location": "1360/Talk", "narrator": "神楽", "text": "たくましい\nライオンさん\nですねっ。"},
        { "location": "1361/Talk", "narrator": "みやび", "text": "まぁ、中味はただの\nガンコ一徹な\nオンチャンぞね。"},
        { "location": "1362/Talk", "narrator": "みやび", "text": "元々は四人の子を持つ\n江戸っ子な親父さん\nやったちや。"},
        { "location": "1363/Talk", "narrator": "ガブリエラ", "text": "いいんだけど、\nこの腹巻きって\n要るの？"},
        { "location": "1364/Talk", "narrator": "みやび", "text": "オンチャンの\nシンボルやき。\n重要アイテムぞね。"},
        { "location": "1365/Talk", "narrator": "神楽", "text": "このクランさんは\nラピスラズリの\nラピスちゃんですよ。"},
        { "location": "1366/Talk", "narrator": "つばめ", "text": "ところで、ここで\nラピスちゃんの言った\n「受け攻め」って何？"},
        { "location": "1367/Talk", "narrator": "ガブリエラ", "text": "つばめは余計なこと\n知りたがらなくて\nいいのっ！"},
        { "location": "1368/Talk", "narrator": "つばめ", "text": "えー？　何で\nせんぱいが\n怒るんですかー？"},
        { "location": "1369/Talk", "narrator": "神楽", "text": "ラピスちゃんは元々は\nドイツ生まれの\nハーフなんですよ。"},
        { "location": "1370/Talk", "narrator": "神楽", "text": "小学生の頃に来日して\n以来、日本の漫画が\n大好きなんですって。"},
        { "location": "1371/Talk", "narrator": "つばめ", "text": "へー。何だか\nせんぱいと\n気が合いそうですね。"},
        { "location": "1372/Talk", "narrator": "ガブリエラ", "text": "あ、合わないわよっ！\nあたしはそっちの\n趣味は無いからっ！！"},
        { "location": "1373/Talk", "narrator": "つばめ", "text": "そっちの趣味？"},
        { "location": "1374/Talk", "narrator": "ガブリエラ", "text": "はい、さっさと次っ！"},
        { "location": "1375/Talk", "narrator": "みやび", "text": "ああ、今度は\n二人まとめてやねえ。"},
        { "location": "1376/Talk", "narrator": "みやび", "text": "向かって左の子は\nメタモルガーＶＦＸ\nゆうごっつい名前や。"},
        { "location": "1377/Talk", "narrator": "みやび", "text": "もるがーくんって\n呼んじゃって。"},
        { "location": "1378/Talk", "narrator": "みやび", "text": "元々、特撮ヒーローが\n大好きな男の子やき\nそのまんまぞね。"},
        { "location": "1379/Talk", "narrator": "つばめ", "text": "へぇ！\n今度こそせんぱいと\n気が合いそうですね！"},
        { "location": "1380/Talk", "narrator": "ガブリエラ", "text": "……あんた、あたしが\nオタクだって\n勘違いしてない？"},
        { "location": "1381/Talk", "narrator": "神楽", "text": "違ったんですか？"},
        { "location": "1382/Talk", "narrator": "ガブリエラ", "text": "違うに\n決まってるでしょ！\nまったく……。"},
        { "location": "1383/Talk", "narrator": "ガブリエラ", "text": "そうそう、それで\nもう片方のクランが\nコルトよ。"},
        { "location": "1384/Talk", "narrator": "ガブリエラ", "text": "名前の通り\n銃をこよなく愛してる\nキザな……元、男ね。"},
        { "location": "1385/Talk", "narrator": "つばめ", "text": "えっ？\n……男？\nあの……胸が……。"},
        { "location": "1386/Talk", "narrator": "みやび", "text": "発症者とクランは\nまんま同じ外見やない。\nそういうこともある。"},
        { "location": "1387/Talk", "narrator": "つばめ", "text": "ふ、複雑な事情が\nあるみたい……、\nですね？"},
        { "location": "1388/Talk", "narrator": "ガブリエラ", "text": "さぁ？　知らないけど\nどうせくだらない\n理由でしょ。"},
        { "location": "1389/Talk", "narrator": "みやび", "text": "ガブちゃん、\n仲良いのに\n切り捨てるかね。"},
        { "location": "1390/Talk", "narrator": "つばめ", "text": "ヴァニス界？　って？"},
        { "location": "1391/Talk", "narrator": "アーヤ", "text": "逢瀬さん、それは本当に\n気にしなくていいわ。"},
        { "location": "1392/Talk", "narrator": "ガブリエラ", "text": "ただの中二病用語よ。"},
        { "location": "1393/Talk", "narrator": "つばめ", "text": "あー……。\nそういうクランさん\nなんですね……。"},
        { "location": "1394/Talk", "narrator": "アーヤ", "text": "悪い子じゃないから\nそこは誤解しないで\nあげてね……。"},
        { "location": "1395/Talk", "narrator": "ガブリエラ", "text": "悪い子じゃないけど\n残念な子よね。"},
        { "location": "1396/Talk", "narrator": "ガブリエラ", "text": "波長が合うのか、\nコルトに気がある\nみたいだし。"},
        { "location": "1397/Talk", "narrator": "つばめ", "text": "そ、そうですか……。"},
        { "location": "1398/Talk", "narrator": "アーヤ", "text": "で、このクランが、\nヒストンシャペロン。"},
        { "location": "1399/Talk", "narrator": "アーヤ", "text": "代議士の秘書という\n経歴を持っていた\nクランよ。"},
        { "location": "1400/Talk", "narrator": "つばめ", "text": "ああ、それで何だか\n少し、おかたい感じ\nなんですね。"},
        { "location": "1401/Talk", "narrator": "アーヤ", "text": "ちなみに\n音楽の趣味は\nメタルらしいけど。"},
        { "location": "1402/Talk", "narrator": "つばめ", "text": "わ、わたし、仲良く\nなれるかなぁ……？"},
        { "location": "1403/Talk", "narrator": "ガブリエラ", "text": "べつに全部のクランと\n仲良くする必要\n無いでしょ。"},
        { "location": "1404/Talk", "narrator": "ガブリエラ", "text": "自分の特性、戦い方に\n合ったクランとの\nコネクトが大事だし。"},
        { "location": "1405/Talk", "narrator": "つばめ", "text": "それは、そうかも\n知れないけど……。"},
        { "location": "1406/Talk", "narrator": "つばめ", "text": "あっ、この子は\n銀葉樹。\n銀ちゃんです。"},
        { "location": "1407/Talk", "narrator": "つばめ", "text": "元々は、お花と\nきれいな石が好きな、\nおとなしい子で。"},
        { "location": "1408/Talk", "narrator": "つばめ", "text": "引っ込み思案というか\n人見知りなところが\nわたしと似てるかも？"},
        { "location": "1409/Talk", "narrator": "ガブリエラ", "text": "つばめが\n人見知りなんて\n初耳なんだけど。"},
        { "location": "1410/Talk", "narrator": "つばめ", "text": "えぇーっ！？\nひ、人見知り、\nですよね？"},
        { "location": "1411/Talk", "narrator": "神楽", "text": "つばめさん。\n………………。"},
        { "location": "1412/Talk", "narrator": "つばめ", "text": "にこにこしてる\nだけじゃなくて\n何か言ってよっ！"},
        { "location": "1413/Talk", "narrator": "神楽", "text": "あ、このクランさんは\nフーガちゃん\nですよー。"},
        { "location": "1414/Talk", "narrator": "神楽", "text": "とっても可愛い\n男の子ですっ。"},
        { "location": "1415/Talk", "narrator": "つばめ", "text": "えっ？\n……またなの？"},
        { "location": "1416/Talk", "narrator": "ガブリエラ", "text": "こいつの場合は\n元々「男の娘」って\nやつだったから。"},
        { "location": "1417/Talk", "narrator": "ガブリエラ", "text": "心は女の子ってことで\n当然の結果って\n感じじゃない？"},
        { "location": "1418/Talk", "narrator": "つばめ", "text": "ふ、深い……。"},
        { "location": "1419/Talk", "narrator": "アーヤ", "text": "以上で、今回の\nクラン紹介は\n終わりね。"},
        { "location": "1420/Talk", "narrator": "つばめ", "text": "あの、クランたちって\n普段はサーバーの中に\nいるデータですよね？"},
        { "location": "1421/Talk", "narrator": "つばめ", "text": "それがどうして\n劇場の楽屋に……。"},
        { "location": "1422/Talk", "narrator": "アーヤ", "text": "ええ、彼らが楽屋に\nいたからと言っても\n実体ではないわ。"},
        { "location": "1423/Talk", "narrator": "アーヤ", "text": "……実体がある者も\nいるけど、基本は\n霊体みたいなものね。"},
        { "location": "1424/Talk", "narrator": "ガブリエラ", "text": "ずっとサーバーに\nいるだけだと\n退屈なんじゃない？"},
        { "location": "1425/Talk", "narrator": "アーヤ", "text": "劇場内を跋扈して\n羽を伸ばしている\nってところかしら。"},
        { "location": "1426/Talk", "narrator": "神楽", "text": "皆さん団欒して\nくつろぐのは\n大事ですよね。"},
        { "location": "1427/Talk", "narrator": "つばめ", "text": "そ、そうだね……。"},
        { "location": "1428/Talk", "narrator": "ガブリエラ", "text": "そんな団欒も終わり、\n一転して\nシリアスな感じね。"},
        { "location": "1429/Talk", "narrator": "つばめ", "text": "音羽さんも回復して\n早くあの団欒に\n入れるといいですね。"},
        { "location": "1430/Talk", "narrator": "アーヤ", "text": "……そうね……。"},
        { "location": "1431/Talk", "narrator": "ガブリエラ", "text": "でも、クランとして\n使えなくなるくらい、\nぶっ壊されたのよね。"},
        { "location": "1432/Talk", "narrator": "アーヤ", "text": "ギャヴィ。\nもうその話はおしまい！"},
        { "location": "1433/Talk", "narrator": "神楽", "text": "はいっ！\nシリアスは\nここまでですよっ。"},
        { "location": "1434/Talk", "narrator": "つばめ", "text": "……はっ！？\nス、ストップっ！！\nここで終わりっ！！"},
        { "location": "1435/Talk", "narrator": "神楽", "text": "つばめさん、\nいきなりあわてて、\nどうしたんですか？"},
        { "location": "1436/Talk", "narrator": "つばめ", "text": "だだだ、だって、\nもしかして\nここからって……。"},
        { "location": "1437/Talk", "narrator": "つばめ", "text": "ひゃあぁぁぁーっ！！\nやっぱりお風呂の\nシーンだぁーっ！！"},
        { "location": "1438/Talk", "narrator": "つばめ", "text": "ていうか、何でこんな\n映像があるんですか？\n盗撮ですかっ！？"},
        { "location": "1439/Talk", "narrator": "みやび", "text": "つばめちゃん、\n落ち着き。盗撮らあ\n今さらやきね。"},
        { "location": "1440/Talk", "narrator": "つばめ", "text": "今さらでも何でも\nダメですダメダメダメ\n見ちゃダメぇーっ！！"},
        { "location": "1441/Talk", "narrator": "ガブリエラ", "text": "……みやび、こういう\nシーンになると、\nすぐ出て来るのね。"},
        { "location": "1442/Talk", "narrator": "神楽", "text": "つばめさん、\n落ち着いてください。\n大丈夫ですよ。"},
        { "location": "1443/Talk", "narrator": "つばめ", "text": "卯月さんが落ち着き\n過ぎだし、全然\n大丈夫じゃないよ！？"},
        { "location": "1444/Talk", "narrator": "みやび", "text": "ほうほう、いやー、\nつばめちゃん、\n攻めちょるねぇ。"},
        { "location": "1445/Talk", "narrator": "つばめ", "text": "あわわわわわわわわ。"},
        { "location": "1446/Talk", "narrator": "神楽", "text": "正に泡まみれですね。"},
        { "location": "1447/Talk", "narrator": "ガブリエラ", "text": "……誰が上手いことを\n言えと……。"},
        { "location": "1448/Talk", "narrator": "みやび", "text": "つばめちゃん、結構\n着痩せするタイプ\nなんやねぇ。"},
        { "location": "1449/Talk", "narrator": "神楽", "text": "意外とありますよね。\n羨ましいです。"},
        { "location": "1450/Talk", "narrator": "つばめ", "text": "そそそそんなっ、\nきょ、恐縮で\nありますっ！"},
        { "location": "1451/Talk", "narrator": "ガブリエラ", "text": "つばめ、キャラが\n崩壊してるわよ。"},
        { "location": "1452/Talk", "narrator": "神楽", "text": "ガブちゃんも\nつばめちゃんが\n羨ましいですよね？"},
        { "location": "1453/Talk", "narrator": "ガブリエラ", "text": "い、言っとくけど\nあたし、神楽より\nあるからっ！"},
        { "location": "1454/Talk", "narrator": "神楽", "text": "ええ、誤差の範囲\nですけどね。"},
        { "location": "1455/Talk", "narrator": "ガブリエラ", "text": "誤差って言うなっ！！"},
        { "location": "1456/Talk", "narrator": "みやび", "text": "ここでひとつ、\n$handle$の意見を\n聞きたい。"},
        { "location": "1457/Talk", "narrator": "みやび", "text": "お風呂でいちゃいちゃ\nして、そん次は\nデートのお誘いかい。"},
        { "location": "1458/Talk", "narrator": "みやび", "text": "若い子は\n積極的やねぇ。"},
        { "location": "1459/Talk", "narrator": "つばめ", "text": "あの……みやびさん、\nわたしとそんなに\n年齢違いませんよね？"},
        { "location": "1460/Talk", "narrator": "ガブリエラ", "text": "ババくさい自覚は\nあるってことね。"},
        { "location": "1461/Talk", "narrator": "みやび", "text": "誰がオババキャラや！"},
        { "location": "1462/Talk", "narrator": "ガブリエラ", "text": "そこまで\n言ってないし！"},
        { "location": "1463/Talk", "narrator": "みやび", "text": "もしくはロリババア？\nあー、それえいなぁ。\nそれでいこかなぁ？"},
        { "location": "1464/Talk", "narrator": "神楽", "text": "みやびさん、吸血鬼\nっぽいし、いいかも\n知れないですねっ。"},
        { "location": "1465/Talk", "narrator": "みやび", "text": "やねえ！　忘れちょった\n中二マインドが\nうずくぞね。"},
        { "location": "1466/Talk", "narrator": "ガブリエラ", "text": "……いや、もう、\n好きにしたら？"},
        { "location": "1467/Talk", "narrator": "みやび", "text": "ところで君、うちらの\n会話無視して映像に\n釘付けになっちゅう。"},
        { "location": "1468/Talk", "narrator": "つばめ", "text": "あぁぁぁぁーっ！？\n忘れてたぁーっ！！\nダメですってばっ！！"},
        { "location": "1469/Talk", "narrator": "みやび", "text": "こらカメラ！\nちゃんと映さんと\nいかん！"},
        { "location": "1470/Talk", "narrator": "ガブリエラ", "text": "興奮してるの\nみやびでしょ……。"},
        { "location": "1471/Talk", "narrator": "みやび", "text": "あ、終わってもうた。\n拍子抜けやわー……。"},
        { "location": "1472/Talk", "narrator": "つばめ", "text": "終わってないです！\n全然ダメですよ！？"},
        { "location": "1473/Talk", "narrator": "神楽", "text": "ですよね。\n本当はこの後が\nすごかったのに。"},
        { "location": "1474/Talk", "narrator": "つばめ", "text": "ええっ？　そんなこと…\nべ、別にこの後は\n何も無かったよね！？"},
        { "location": "1475/Talk", "narrator": "みやび", "text": "つばめちゃん、\nショック過ぎた体験に\n記憶を失って……。"},
        { "location": "1476/Talk", "narrator": "つばめ", "text": "ふえぇぇぇっ！？\n怖いこと言わないで\nくださいよっ！？"},
        { "location": "1477/Talk", "narrator": "つばめ", "text": "卯月さん、冗談で、\n本当は何にも無かった\nですよね？"},
        { "location": "1478/Talk", "narrator": "つばめ", "text": "ここ、ほんわか\nいいシーンで終わる\nところですよねっ！？"},
        { "location": "1479/Talk", "narrator": "神楽", "text": "ふっふっふっ。"},
        { "location": "1480/Talk", "narrator": "つばめ", "text": "卯月さぁーーーん！？"},
        { "location": "1481/Talk", "narrator": "神楽", "text": "と、いうわけで！\n私の劇場デビュー、\nどうでしたか？"},
        { "location": "1482/Talk", "narrator": "神楽", "text": "次もつばめさんと\n一緒に頑張って\n盛り上げますよっ。"},
        { "location": "1483/Talk", "narrator": "神楽", "text": "それではまた来週～♪\n……来週？"}
    ]
}
