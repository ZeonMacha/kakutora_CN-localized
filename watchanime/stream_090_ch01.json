{
    "dir": "stream_090_ch01.json",
    "type": "watchanime",
    "info": {
    },
    "entry":
    [
        { "location": "1484/Talk", "narrator": "ガブリエラ", "text": "ライフルじゃなくて\nどうしてよりによって\n拳銃でってこと？"},
        { "location": "1485/Talk", "narrator": "ガブリエラ", "text": "それは、トドメは\nそうしろって\n指示だったからよ。"},
        { "location": "1486/Talk", "narrator": "つばめ", "text": "？？？？？\nどういうこと？"},
        { "location": "1487/Talk", "narrator": "アーヤ", "text": "フェノメノンの\n解析結果に基づいての\n特殊な処置ね。"},
        { "location": "1488/Talk", "narrator": "ガブリエラ", "text": "今回の発症者は\nアメリカカブレで\n洋画大好きだったの。"},
        { "location": "1489/Talk", "narrator": "ガブリエラ", "text": "だから銃によって派手に\n散るのがヤツのルール\nだったってこと。"},
        { "location": "1490/Talk", "narrator": "神楽", "text": "つまり弱点といいますか、\nお約束を突いて\n倒したってことですか？"},
        { "location": "1491/Talk", "narrator": "ガブリエラ", "text": "何か、あたしが\nズルしたみたいに\n言わないでよ……。"},
        { "location": "1492/Talk", "narrator": "ガブリエラ", "text": "甘いわね。\nあたしが超凄い弾丸を\n撃ち込んだのよ！"},
        { "location": "1493/Talk", "narrator": "つばめ", "text": "うわぁ～っ！\nせんぱい、\nすごいです～！"},
        { "location": "1494/Talk", "narrator": "神楽", "text": "……ガブちゃん？"},
        { "location": "1495/Talk", "narrator": "ガブリエラ", "text": "な、何よ！？\n冗談くらい言ったって\nいいでしょっ！"},
        { "location": "1496/Talk", "narrator": "つばめ", "text": "ふえ？\n冗談だったの？"},
        { "location": "1497/Talk", "narrator": "アーヤ", "text": "館長がフェノメノンを\n解析した結果の\nたまものよ。"},
        { "location": "1498/Talk", "narrator": "アーヤ", "text": "要するに今回は\n「拳銃で」倒すべき\n相手だったってこと。"},
        { "location": "1499/Talk", "narrator": "つばめ", "text": "えーと……攻略法？\nみたいなものですか？"},
        { "location": "1500/Talk", "narrator": "アーヤ", "text": "ええ、そんな感じよ。"},
        { "location": "1501/Talk", "narrator": "つばめ", "text": "だ、だから、そんなの\n絶対ありえない\nですってばぁ……。"},
        { "location": "1502/Talk", "narrator": "ガブリエラ", "text": "じゃあ、あの態度は\n何なのよ？"},
        { "location": "1503/Talk", "narrator": "つばめ", "text": "それは、その、わたし\n男子って、ちょっと、\nかなり苦手で……。"},
        { "location": "1504/Talk", "narrator": "みやび", "text": "よかったねぇ、\n$handle$よ。\nこれで安心しちゅうろう？"},
        { "location": "1505/Talk", "narrator": "つばめ", "text": "あわわわわっ、\nみやびさん、ななな何\n言ってるんですかっ。"},
        { "location": "1506/Talk", "narrator": "ガブリエラ", "text": "……つばめ、\n挙動不審過ぎ。"},
        { "location": "1507/Talk", "narrator": "つばめ", "text": "か……可能性って？"},
        { "location": "1508/Talk", "narrator": "みやび", "text": "ほほぅ、うちら\nよう気が合いそう\nやなぁ？"},
        { "location": "1509/Talk", "narrator": "ガブリエラ", "text": "あっ、これ絶対\n手を組んだら\nダメなコンビだ。"},
        { "location": "1510/Talk", "narrator": "神楽", "text": "ダメそうなコンビの\n予感がしますねっ。"},
        { "location": "1511/Talk", "narrator": "みやび", "text": "誰がダメな大人や！？"},
        { "location": "1512/Talk", "narrator": "ガブリエラ", "text": "心配しなくたって\nどうせ男子が苦手な\nパターンでしょ？"},
        { "location": "1513/Talk", "narrator": "つばめ", "text": "あはははは……はい、\nその通りです……。"},
        { "location": "1514/Talk", "narrator": "神楽", "text": "ガブちゃん、結局\nどうしたんでしょう？"},
        { "location": "1515/Talk", "narrator": "神楽", "text": "でも、突っ込むのも\n野暮みたいですし。"},
        { "location": "1516/Talk", "narrator": "神楽", "text": "見なかったことに\nしましょう！"},
        { "location": "1517/Talk", "narrator": "アーヤ", "text": "みやびったら\n私が目を離すとすぐ\nああなるのよね。"},
        { "location": "1518/Talk", "narrator": "アーヤ", "text": "$handle$も\nあまり一緒に\n悪ノリしないでね？"},
        { "location": "1519/Talk", "narrator": "アーヤ", "text": "いえ、ダメって\nわけじゃないけど、\nほどほどにね？"},
        { "location": "1520/Talk", "narrator": "つばめ", "text": "あのっ、どうやったら\n騙されないように\nなれますか？"},
        { "location": "1521/Talk", "narrator": "つばめ", "text": "えっ？　一日三回、\nあれをこうして……、\nそんなことまでっ！？"},
        { "location": "1522/Talk", "narrator": "つばめ", "text": "……それ、もしかして\n騙してませんか？"},
        { "location": "1523/Talk", "narrator": "ガブリエラ", "text": "わ、忘れ物を取りに\n戻っただけだから\n放っといて。"},
        { "location": "1524/Talk", "narrator": "ガブリエラ", "text": "……まぁ、悪気が無い\nことくらい\nわかってるんだけど。"},
        { "location": "1525/Talk", "narrator": "ガブリエラ", "text": "……そうね。気にした\nあたしが馬鹿だった。\nじゃあね。バイバイ。"},
        { "location": "1526/Talk", "narrator": "神楽", "text": "お待たせしましたっ♪\n皆さん、前回のラスト\n憶えてますか？"},
        { "location": "1527/Talk", "narrator": "神楽", "text": "お風呂でしたよね？\nさぁ、続きが楽しみ\nですよねっ！"},
        { "location": "1528/Talk", "narrator": "つばめ", "text": "あっ、あのっ、\n卯月さん落ち着いて！\n今回は──"},
        { "location": "1529/Talk", "narrator": "神楽", "text": "すとーっぷっ！\nネタバレはダメですよ\nつばめさん？"},
        { "location": "1530/Talk", "narrator": "つばめ", "text": "あっ、ごめんなさい。\nでも、あまり期待を\n持たせるのも……。"},
        { "location": "1531/Talk", "narrator": "みやび", "text": "何言っちゅう。\n過度な期待を持たせて\n煽るんは基本ぞね。"},
        { "location": "1532/Talk", "narrator": "アーヤ", "text": "そう言ってしまって\nいる時点で過度な期待\nはされないのでは？"},
        { "location": "1533/Talk", "narrator": "みやび", "text": "ほいたら逆にハードル\n下げようかね？\nつまらんよーゆうて。"},
        { "location": "1534/Talk", "narrator": "アーヤ", "text": "それはそれでどうかと\n思うのだけど……。"},
        { "location": "1535/Talk", "narrator": "神楽", "text": "ところでみやびさん、\n考察はもう\n諦めたんですか？"},
        { "location": "1536/Talk", "narrator": "みやび", "text": "諦めちょらんき！\nほんだら今から\nじっくりと──"},
        { "location": "1537/Talk", "narrator": "神楽", "text": "はい、おしまーい！"},
        { "location": "1538/Talk", "narrator": "みやび", "text": "って！\nふっといて\nそれなん！？"},
        { "location": "1539/Talk", "narrator": "みやび", "text": "はぁ～、アホらし。\nやったら一旦\n引っ込んどくき。"},
        { "location": "1540/Talk", "narrator": "つばめ", "text": "……もしかして\nみやびさん、\n怒っちゃいましたか？"},
        { "location": "1541/Talk", "narrator": "ガブリエラ", "text": "無い無い。どうせ\n出番が来るまでネット\nでも見てるんでしょ。"},
        { "location": "1542/Talk", "narrator": "アーヤ", "text": "ええ、みやびのことは\n基本・放置で\n構わないわ。"},
        { "location": "1543/Talk", "narrator": "つばめ", "text": "あの～、\nそれはそれでちょっと\nひどいような……。"},
        { "location": "1544/Talk", "narrator": "神楽", "text": "私は放置されると\nさびしくて襲っちゃう\nので、ご注意をっ。"},
        { "location": "1545/Talk", "narrator": "つばめ", "text": "お、襲うって\n何なんですかっ！？"},
        { "location": "1546/Talk", "narrator": "神楽", "text": "知りたいですか？\n知りたいんですか～？\nぐふふふふっ♪"},
        { "location": "1547/Talk", "narrator": "ガブリエラ", "text": "……神楽、アンタ、\nキャラ崩壊するの\nちょっと早過ぎない？"},
        { "location": "1548/Talk", "narrator": "アーヤ", "text": "さぁ、そろそろ\n始まるわよ。\n準備して。"},
        { "location": "1549/Talk", "narrator": "神楽", "text": "というわけで、これが\n前回の最後で言ってた\nサプライズですっ。"},
        { "location": "1550/Talk", "narrator": "つばめ", "text": "転入してくるなんて\n本当にびっくり\nだったよ～。"},
        { "location": "1551/Talk", "narrator": "ガブリエラ", "text": "ていうか、それくらい\n予想できてて\n当たり前でしょ？"},
        { "location": "1552/Talk", "narrator": "つばめ", "text": "えへへ……。"},
        { "location": "1553/Talk", "narrator": "つばめ", "text": "ところで卯月さん、\nこの学校に来る前は\nどこに通ってたの？"},
        { "location": "1554/Talk", "narrator": "神楽", "text": "うふふっ、\nそれは秘密ですっ♪"},
        { "location": "1555/Talk", "narrator": "ガブリエラ", "text": "それって、\n勿体つけるような\nことなわけ？"},
        { "location": "1556/Talk", "narrator": "神楽", "text": "じゃあヒント。\n実は海外にいました。"},
        { "location": "1557/Talk", "narrator": "つばめ", "text": "えっ！？\nせんぱいと同じ\n留学生！？"},
        { "location": "1558/Talk", "narrator": "ガブリエラ", "text": "神楽は、どう見ても\n日本人でしょ……。"},
        { "location": "1559/Talk", "narrator": "つばめ", "text": "じゃあ、えーと、\n何だっけ、あれ……。\nき、帰宅子女？"},
        { "location": "1560/Talk", "narrator": "ガブリエラ", "text": "……「帰国子女」\nでしょ……。"},
        { "location": "1561/Talk", "narrator": "つばめ", "text": "そ、そう、それ！\n帰国子女なの？"},
        { "location": "1562/Talk", "narrator": "神楽", "text": "まぁ、そんなところ\nでしょうか。"},
        { "location": "1563/Talk", "narrator": "神楽", "text": "これ以上は\n秘密ですっ♪"},
        { "location": "1564/Talk", "narrator": "つばめ", "text": "えぇ～っ、\n気になるよぉ……。"},
        { "location": "1565/Talk", "narrator": "つばめ", "text": "あれ？　せんぱい、\nこれ敵は見えてるのに\n索敵って、何で？"},
        { "location": "1566/Talk", "narrator": "ガブリエラ", "text": "ああ、これは、他にも\n敵がいないかの確認。"},
        { "location": "1567/Talk", "narrator": "ガブリエラ", "text": "大体いつも\n四方八方から来るから\n注意してたの。"},
        { "location": "1568/Talk", "narrator": "つばめ", "text": "なるほど～。\nさすがせんぱいっ。"},
        { "location": "1569/Talk", "narrator": "ガブリエラ", "text": "ていうか、この時の\nつばめ、おかしくない？"},
        { "location": "1570/Talk", "narrator": "ガブリエラ", "text": "これでかすり傷程度で\n済むなんて、頑丈にも\n程があるでしょ？"},
        { "location": "1571/Talk", "narrator": "神楽", "text": "きっとつばめさんは\n体がすっごく\n丈夫なんですね。"},
        { "location": "1572/Talk", "narrator": "つばめ", "text": "さ、さすがにそれだけじゃ\n無理があるかなぁ？"},
        { "location": "1573/Talk", "narrator": "アーヤ", "text": "ええ、これは逢瀬さんの\nトライガジェットの\n特性かも知れないわ。"},
        { "location": "1574/Talk", "narrator": "ガブリエラ", "text": "防御力が\n凄いってこと？"},
        { "location": "1575/Talk", "narrator": "ガブリエラ", "text": "最初のドームの件でも\n結構頑丈だったから、\nそのせいかしら？"},
        { "location": "1576/Talk", "narrator": "神楽", "text": "じゃあやっぱり\n元々体が丈夫なんですよ。"},
        { "location": "1577/Talk", "narrator": "つばめ", "text": "えーと……卯月さん、\nわたしをそういう\nキャラにしたいの？"},
        { "location": "1578/Talk", "narrator": "ガブリエラ", "text": "ま、要するに、\nあたしの活躍で\n一件落着ってことよ。"},
        { "location": "1579/Talk", "narrator": "つばめ", "text": "せんぱい、\n美味しいとこ取りで\n何かずるいです！"},
        { "location": "1580/Talk", "narrator": "ガブリエラ", "text": "つばめ、前回は自分が\nそうだったこと、\n忘れてない？"},
        { "location": "1581/Talk", "narrator": "つばめ", "text": "えへへへっ……。"},
        { "location": "1582/Talk", "narrator": "つばめ", "text": "ところで卯月さん、\nここのシリアスな\n表情は何？"},
        { "location": "1583/Talk", "narrator": "神楽", "text": "えっ？　あっ、これ？\nこれは、えーと……。"},
        { "location": "1584/Talk", "narrator": "ガブリエラ", "text": "どうせカッコつけてた\nだけでしょ？"},
        { "location": "1585/Talk", "narrator": "神楽", "text": "……あっ、は、はい、\nバレちゃいました？\nそう、キリッ！　て。"},
        { "location": "1586/Talk", "narrator": "みやび", "text": "あぁぁ～っ、\nつばめちゃんが\nキズモノにぃ～。"},
        { "location": "1587/Talk", "narrator": "つばめ", "text": "ふえぇっ！？"},
        { "location": "1588/Talk", "narrator": "みやび", "text": "冗談や。\nすり傷程度で済んで\nまっことよかったちや。"},
        { "location": "1589/Talk", "narrator": "神楽", "text": "見てて痛々しいのが\n可哀相ですけど。"},
        { "location": "1590/Talk", "narrator": "つばめ", "text": "えっ？　そう？\n平気平気っ。\n心配しないでっ。"},
        { "location": "1591/Talk", "narrator": "みやび", "text": "おやおや？\nモブ男子の登場？"},
        { "location": "1592/Talk", "narrator": "ガブリエラ", "text": "いや、ドームの時の\n攻撃隊にいた\nやつらでしょ。"},
        { "location": "1593/Talk", "narrator": "ガブリエラ", "text": "ねぇ、ここのつばめ、\n話しかけられてるのに\n何で無視してるの？"},
        { "location": "1594/Talk", "narrator": "つばめ", "text": "えぇっ！？\nむ、無視なんて\nしてないよっ？"},
        { "location": "1595/Talk", "narrator": "神楽", "text": "じゃあ、意識し過ぎ\nちゃってたとか？"},
        { "location": "1596/Talk", "narrator": "つばめ", "text": "そ、そんな意識なんて\n無い無い無いですっ。\n絶対無いってばっ！"},
        { "location": "1597/Talk", "narrator": "みやび", "text": "つばめちゃん、それは\n全力で否定し過ぎやき。\nモブかて悲しむぞね。"},
        { "location": "1598/Talk", "narrator": "みやび", "text": "せやけどこの左の男、\nヒカル言うたかな？"},
        { "location": "1599/Talk", "narrator": "みやび", "text": "つばめちゃんのこと\nめっちゃ見とるやん。\n要注意やわ～。"},
        { "location": "1600/Talk", "narrator": "みやび", "text": "ほら、つばめちゃんの\n手をわざとらしく\n取りおったで。"},
        { "location": "1601/Talk", "narrator": "ガブリエラ", "text": "……それはヒカルじゃ\nなくて、キリトって\nやつでしょ？"},
        { "location": "1602/Talk", "narrator": "みやび", "text": "どっちでもええぞね。\nガブちゃんは、よう\n憶えとるなぁ。"},
        { "location": "1603/Talk", "narrator": "神楽", "text": "でもつばめさん、\n何であんなに\n驚いてたんですか？"},
        { "location": "1604/Talk", "narrator": "つばめ", "text": "わたし、男の子に\n触られたことって\n今まで殆ど無くて。"},
        { "location": "1605/Talk", "narrator": "つばめ", "text": "東京の子っていきなり\nこんなことするんだ\nってビックリで……。"},
        { "location": "1606/Talk", "narrator": "ガブリエラ", "text": "べつに東京は\n関係無いでしょ。"},
        { "location": "1607/Talk", "narrator": "つばめ", "text": "関係あるよぉ！\n地方だとこんなの全然\nありえないしっ。"},
        { "location": "1608/Talk", "narrator": "つばめ", "text": "やっぱり東京は\n進んでるなぁって。"},
        { "location": "1609/Talk", "narrator": "ガブリエラ", "text": "だってさ、神楽。"},
        { "location": "1610/Talk", "narrator": "つばめ", "text": "あっ、それよりここ！\nみんなでわたしを\n騙して、ひどいよっ！"},
        { "location": "1611/Talk", "narrator": "ガブリエラ", "text": "こっちとしてはむしろ\n騙されるつばめが\n心配なんだけど……。"},
        { "location": "1612/Talk", "narrator": "みやび", "text": "つばめちゃん、\n天然にも限度ちゅう\nもんがあるきね？"},
        { "location": "1613/Talk", "narrator": "神楽", "text": "わたしもよく天然って\n言われますけど、\nかないませんね……。"},
        { "location": "1614/Talk", "narrator": "つばめ", "text": "えっ？　えっ？\n何で騙されたわたしが\nダメな子扱いっ！？"},
        { "location": "1615/Talk", "narrator": "つばめ", "text": "みんなのこと\n信じてたのに\nひどいよぉ～……。"},
        { "location": "1616/Talk", "narrator": "みやび", "text": "ところでガブちゃん、\nこれ何しちゅう？"},
        { "location": "1617/Talk", "narrator": "ガブリエラ", "text": "！！　……べ、べつに、\nたまたま通りかかった\nだけだしっ！"},
        { "location": "1618/Talk", "narrator": "つばめ", "text": "でもせんぱいって\n中等部ですよね？\nここ高等部ですけど？"},
        { "location": "1619/Talk", "narrator": "神楽", "text": "もしかして\nガブちゃんって\n方向音痴だったんですか？"},
        { "location": "1620/Talk", "narrator": "ガブリエラ", "text": "そんなわけ\nないでしょ！"},
        { "location": "1621/Talk", "narrator": "ガブリエラ", "text": "あたしのことは\n気にしなくて\nいいってば！"},
        { "location": "1622/Talk", "narrator": "ガブリエラ", "text": "あ、あたし、\nもう帰るから！\nお先にっ！"},
        { "location": "1623/Talk", "narrator": "みやび", "text": "……ほぅ？\n何やこれは\n後々楽しみやなぁ？"},
        { "location": "1624/Talk", "narrator": "アーヤ", "text": "こら、みやび。\nからかい過ぎだって\n言ってるでしょ。"},
        { "location": "1625/Talk", "narrator": "みやび", "text": "かんにんや。\n可愛い子がテレる顔は\n至宝やき。"},
        { "location": "1626/Talk", "narrator": "みやび", "text": "君かてそう思うろう？"},
        { "location": "1627/Talk", "narrator": "みやび", "text": "さすが、\n我が魂の同志やねえ。"}
    ]
}
