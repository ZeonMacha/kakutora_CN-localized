{
    "dir": "stream_380_ch01.json",
    "type": "watchanime",
    "info": {
    },
    "entry":
    [
        { "location": "7349/Talk", "narrator": "赤髪千羽鶴", "text": "あまり楽しみにされると、\n見た時の落差でガッカリ\nするので程々で……。"},
        { "location": "7350/Talk", "narrator": "赤髪千羽鶴", "text": "それと、一緒に見るのは、\n“今の”わたしが\n一番だと思います。"},
        { "location": "7351/Talk", "narrator": "赤髪千羽鶴", "text": "いいえ。\nわたしは挨拶に\n来ただけなので……。"},
        { "location": "7352/Talk", "narrator": "赤髪千羽鶴", "text": "一緒に見るのは、\n“今の”わたしが\n一番だと思います。"},
        { "location": "7353/Talk", "narrator": "赤髪千羽鶴", "text": "わかりました！\nそれじゃ、いつもの姿に\nしてきますね。"},
        { "location": "7354/Talk", "narrator": "赤髪千羽鶴", "text": "…はい。"},
        { "location": "7355/Talk", "narrator": "赤髪千羽鶴", "text": "わかりました！\nそれじゃ、制服姿で\n来るようにしますね。"},
        { "location": "7356/Talk", "narrator": "赤髪千羽鶴", "text": "……はい？"},
        { "location": "7357/Talk", "narrator": "赤髪千羽鶴", "text": "……あはは、\nそうですか。\nわかりました。"},
        { "location": "7358/Stay", "narrator": "", "text": "サンシャインフリル"},
        { "location": "7359/Talk", "narrator": "赤髪千羽鶴", "text": "はいはい。"},
        { "location": "7360/Talk", "narrator": "赤髪千羽鶴", "text": "そうなんですか？\nそれは素敵ですね…。\nじゃあ、それで。"},
        { "location": "7361/Stay", "narrator": "", "text": "ウエディングドレス"},
        { "location": "7362/Talk", "narrator": "赤髪千羽鶴", "text": "気持ちはわかるけど、\nそろそろ決めてください。"},
        { "location": "7363/Talk", "narrator": "赤髪千羽鶴", "text": "わかりました。\nちょっと不思議な\n感じはしますけど…。"},
        { "location": "7364/Talk", "narrator": "赤髪千羽鶴", "text": "じゃあ、もうこれで\nいいんじゃない\nでしょうかね？"},
        { "location": "7365/Talk", "narrator": "つばめ", "text": "ほんと？\nよかった！"},
        { "location": "7366/Talk", "narrator": "つばめ", "text": "えへへ…。\nなんだか嬉しいような\n恥ずかしいような。"},
        { "location": "7367/Talk", "narrator": "つばめ", "text": "でも、気に入ってもらえて\n良かったよ。"},
        { "location": "7368/Talk", "narrator": "つばめ", "text": "ふあっ……。\nなんだか恥ずかしいよ。"},
        { "location": "7369/Talk", "narrator": "つばめ", "text": "そ、それじゃ、\nそろそろ見ていこっか。"},
        { "location": "7370/Talk", "narrator": "つばめ", "text": "ああっ！\nそ、そうですね！"},
        { "location": "7371/Talk", "narrator": "つばめ", "text": "そうだよ。\nうちから近いんだよ。\n歩いて……"},
        { "location": "7372/Talk", "narrator": "つばめ", "text": "歩いて、20分くらい？\nあれ…ちょっと遠いかな？"},
        { "location": "7373/Talk", "narrator": "つばめ", "text": "なんか、前は普通に\n駅の近くだって\n思ってたけど――"},
        { "location": "7374/Talk", "narrator": "つばめ", "text": "東京に来たら、\n遠かったんだーって\n思ったよ。"},
        { "location": "7375/Talk", "narrator": "つばめ", "text": "東京で20分歩くと、\nすごい遠くまで\nいけるよね。"},
        { "location": "7376/Talk", "narrator": "つばめ", "text": "えええっ！！\nご近所なの！？"},
        { "location": "7377/Talk", "narrator": "つばめ", "text": "な、なんか\nドキドキしてきたよ。"},
        { "location": "7378/Talk", "narrator": "つばめ", "text": "てことは、てことは\nえっと――"},
        { "location": "7379/Talk", "narrator": "つばめ", "text": "花鳥園のお話とか、\nはったさんのお団子の\nお話とかわかるのかな…？"},
        { "location": "7380/Talk", "narrator": "つばめ", "text": "ほんとー！？\nすごい！！"},
        { "location": "7381/Talk", "narrator": "つばめ", "text": "こんどいっぱい\nお話したいなぁ。"},
        { "location": "7382/Talk", "narrator": "つばめ", "text": "アーヤさんやみやびさん\nみたいに、近くに名所とか\nあればいいんだけど――"},
        { "location": "7383/Talk", "narrator": "つばめ", "text": "お話のネタになるような\nものがなかったから、\nあまり言わなかったんだ。"},
        { "location": "7384/Talk", "narrator": "つばめ", "text": "えへへ……\nそうだよねぇ。"},
        { "location": "7385/Talk", "narrator": "つばめ", "text": "そうだね。\nなんだかちょっと\n恥ずかしいっていうか。"},
        { "location": "7386/Talk", "narrator": "つばめ", "text": "みやびさんの土佐弁は\n綺麗だなぁって\n思うんだけどね。"},
        { "location": "7387/Talk", "narrator": "つばめ", "text": "えええっ！！\nあ、あまり楽しみに\nされちゃうとちょっと……"},
        { "location": "7388/Talk", "narrator": "つばめ", "text": "がっ…がんばります！"},
        { "location": "7389/Talk", "narrator": "つばめ", "text": "そうだとは思うけど、\n１曲は聴けたと思うんだ！"},
        { "location": "7390/Talk", "narrator": "つばめ", "text": "１曲も聴けなかったのとは\n雲泥の差だもん。"},
        { "location": "7391/Talk", "narrator": "つばめ", "text": "……って、そういえば\n全然遠州弁じゃないよね。"},
        { "location": "7392/Talk", "narrator": "つばめ", "text": "なんか恥ずかしいけど、\n言ったからには少し\nだけでも喋らなくちゃ……"},
        { "location": "7393/Talk", "narrator": "つばめ", "text": "よーし、\nいくよー！"},
        { "location": "7394/Talk", "narrator": "つばめ", "text": "はい！"},
        { "location": "7395/Talk", "narrator": "つばめ", "text": "は、…はい！"},
        { "location": "7396/Talk", "narrator": "つばめ", "text": "ああっ！\nえ、えっと……"},
        { "location": "7397/Talk", "narrator": "つばめ", "text": "一人で喋るときって、\nあまり方言って\nつかわないよね？"},
        { "location": "7398/Talk", "narrator": "つばめ", "text": "あとほら、\nつかうぞー！　って、\n構えるものでもないし。"},
        { "location": "7399/Talk", "narrator": "つばめ", "text": "…っていうか、\nなんかその……"},
        { "location": "7400/Talk", "narrator": "つばめ", "text": "急に方言で喋り始めるのも\nやっぱなんか\n恥ずかしいような気が…。"},
        { "location": "7401/Talk", "narrator": "つばめ", "text": "あっ、で、でも、\nそのうち勝手に\n出てくるかもしれないし！"},
        { "location": "7402/Talk", "narrator": "つばめ", "text": "だから、\nお話を続けよう！\nそうしよう……。"},
        { "location": "7403/Talk", "narrator": "つばめ", "text": "そ、そうです…。"},
        { "location": "7404/Talk", "narrator": "つばめ", "text": "始まったに！\nって言うんです。"},
        { "location": "7405/Talk", "narrator": "つばめ", "text": "きゃー、\nわかっちゃったょ……。"},
        { "location": "7406/Talk", "narrator": "つばめ", "text": "ちょ、ちょっと……\nそんなハッキリ言われちゃ\n恥ずかしいら…。"},
        { "location": "7407/Talk", "narrator": "つばめ", "text": "でも、わたしも\n$handle$さんのこと\nすごい好きだに？"},
        { "location": "7408/Talk", "narrator": "つばめ", "text": "はぁっ……ちょっと、\nなんか二つの意味で\n恥ずかしいだけん……。"},
        { "location": "7409/Talk", "narrator": "つばめ", "text": "ほんとビックリだら。"},
        { "location": "7410/Talk", "narrator": "つばめ", "text": "だけん、\n$handle$さんが\nいたもんで今があるだに？"},
        { "location": "7411/Talk", "narrator": "つばめ", "text": "いんかったらわたし、\nもうとっくに死んでたかも\nしれんだで。"},
        { "location": "7412/Talk", "narrator": "つばめ", "text": "あ、そうね。\nていうか、なんでこんな所\n撮られてるだいや…。"},
        { "location": "7413/Talk", "narrator": "つばめ", "text": "もっと元気に\nメノウちゃん応援してる\nところとか――"},
        { "location": "7414/Talk", "narrator": "つばめ", "text": "美味しいクレープ\n食べてる所とかにして\nくれりゃあいいだに……。"},
        { "location": "7415/Talk", "narrator": "つばめ", "text": "ええっ！？\nそうなの？"},
        { "location": "7416/Talk", "narrator": "つばめ", "text": "落ち込んでる姿見たって\n全然好きになんて\nならんら？"},
        { "location": "7417/Talk", "narrator": "つばめ", "text": "えへへ……。\nそっかぁ。"},
        { "location": "7418/Talk", "narrator": "つばめ", "text": "ありがとう。\nすごく嬉しい。"},
        { "location": "7419/Talk", "narrator": "つばめ", "text": "えへへ、ありがと。"},
        { "location": "7420/Talk", "narrator": "つばめ", "text": "もう、いーっぱい\n頼っちゃってるけぇが、\nこれからもよろしくね。"},
        { "location": "7421/Talk", "narrator": "つばめ", "text": "でも、こんな姿見せるの\n$handle$さんに\nだけだに？"},
        { "location": "7422/Talk", "narrator": "つばめ", "text": "あはは……。\n過酷なところが無いとは\n言わんけど――"},
        { "location": "7423/Talk", "narrator": "つばめ", "text": "それ以上に\n面白いことだって\nいっぱいあるだに？"},
        { "location": "7424/Talk", "narrator": "つばめ", "text": "あはは……、\n実は……。"},
        { "location": "7425/Talk", "narrator": "つばめ", "text": "今回が初めてだっけもんで\nやっぱ迷っちゃっただよ。"},
        { "location": "7426/Talk", "narrator": "つばめ", "text": "それで、だいぶ歩いて\nえらかったもんで、\nちょっと休んでただよ？"},
        { "location": "7427/Talk", "narrator": "つばめ", "text": "そうかなぁ。"},
        { "location": "7428/Talk", "narrator": "つばめ", "text": "かわいいのは、\n神楽ちゃんみたいなのを\n言うんだよ？"},
        { "location": "7429/Talk", "narrator": "つばめ", "text": "あはは……\nやっぱりそうなるよね。"},
        { "location": "7430/Talk", "narrator": "つばめ", "text": "あーあ、\n神楽ちゃんが\n羨ましいなぁ。"},
        { "location": "7431/Talk", "narrator": "つばめ", "text": "え？\nかわいいよね？\n神楽ちゃん。"},
        { "location": "7432/Talk", "narrator": "つばめ", "text": "ていうか……、\nなんかわたし、あまり\n自分に自信がなくて。"},
        { "location": "7433/Talk", "narrator": "つばめ", "text": "そ、そうかなぁ。"},
        { "location": "7434/Talk", "narrator": "つばめ", "text": "でも、ありがとう。\nなんかわたし、あまり\n自分に自信がなくて。"},
        { "location": "7435/Talk", "narrator": "つばめ", "text": "ええっ！？\nあっ、映像のこと？\nそ、そうかなぁ…。"},
        { "location": "7436/Talk", "narrator": "つばめ", "text": "なんか、普通に\n子供っぽいだけって\nいうか……"},
        { "location": "7437/Talk", "narrator": "つばめ", "text": "そうだよね。\nわたしにだって、好きに\nなってくれる人がいる。"},
        { "location": "7438/Talk", "narrator": "つばめ", "text": "わたしも、\nわたしのこともっと\n好きにならなくちゃ。"},
        { "location": "7439/Talk", "narrator": "つばめ", "text": "…あはは……\nでも……なんか、\nどうすればいいのかな。"},
        { "location": "7440/Talk", "narrator": "つばめ", "text": "……とりあえず、\n続きを見よっか。"},
        { "location": "7441/Talk", "narrator": "つばめ", "text": "そっかぁ……。"},
        { "location": "7442/Talk", "narrator": "つばめ", "text": "もうちょっとだけ\n自信持っても\nいいのかな……？"},
        { "location": "7443/Talk", "narrator": "つばめ", "text": "うーん……\nよくわかんないよ。"},
        { "location": "7444/Talk", "narrator": "つばめ", "text": "もちろん、アーヤさんたち\nみたいに綺麗に\nなりたいとは思うけど――"},
        { "location": "7445/Talk", "narrator": "つばめ", "text": "それは大人になるのとは\nちょっと違うと思うし…。"},
        { "location": "7446/Talk", "narrator": "つばめ", "text": "えへへ。\nありがとうございます。"},
        { "location": "7447/Talk", "narrator": "つばめ", "text": "今のわたし…かぁ。"},
        { "location": "7448/Talk", "narrator": "つばめ", "text": "えへへ。\nありがとうございます。"},
        { "location": "7449/Talk", "narrator": "つばめ", "text": "$handle$さん\nだけでも、そう言って\nくれたら嬉しいです。"},
        { "location": "7450/Talk", "narrator": "つばめ", "text": "え……？\nもしかして、なんか\n怒ってる？"},
        { "location": "7451/Talk", "narrator": "つばめ", "text": "なんか、たまに自分が\nどんな存在なのか、\n分からなくなっちゃうの。"},
        { "location": "7452/Talk", "narrator": "つばめ", "text": "わたしね、\n自分の大好きな人でも、\n全然知らない人でも――"},
        { "location": "7453/Talk", "narrator": "つばめ", "text": "何か自分が役に立てたり\nすると、とっても嬉しい\nっていうか…。"},
        { "location": "7454/Talk", "narrator": "つばめ", "text": "そういうときに、わたし\nいてもいいんだって、\nそう思えるんだ。"},
        { "location": "7455/Talk", "narrator": "つばめ", "text": "けど、そういう時って、\n自分がどうとかって、\nあまり考えないから。"},
        { "location": "7456/Talk", "narrator": "つばめ", "text": "……そういうのって、\nよくないのかな……。"},
        { "location": "7457/Talk", "narrator": "つばめ", "text": "え、えええ？\nえっと、そうかな？"},
        { "location": "7458/Talk", "narrator": "つばめ", "text": "うーん……\nでも、そうかも。"},
        { "location": "7459/Talk", "narrator": "つばめ", "text": "そっか…。\nそうだよね。"},
        { "location": "7460/Talk", "narrator": "つばめ", "text": "$handle$さんが\nわたしのことを好きで\nいてくれるのに――"},
        { "location": "7461/Talk", "narrator": "つばめ", "text": "わたしがわたしのことを\n好きでなかったら\nダメだよね。"},
        { "location": "7462/Talk", "narrator": "つばめ", "text": "…ありがとう。"},
        { "location": "7463/Talk", "narrator": "つばめ", "text": "$handle$さんは\nわたしのことを、なんでも\n受け入れてくれるんだね。"},
        { "location": "7464/Talk", "narrator": "つばめ", "text": "わたしもまだ、自分のこと\n全然わからないけど――"},
        { "location": "7465/Talk", "narrator": "つばめ", "text": "$handle$さんと\n一緒なら、きっといつか\nわかる気がするよ。"},
        { "location": "7466/Talk", "narrator": "つばめ", "text": "ごめんね？\nつまんない話\nいろいろしちゃって。"},
        { "location": "7467/Talk", "narrator": "つばめ", "text": "普段はこういう話は\n絶対しないんだけど……"},
        { "location": "7468/Talk", "narrator": "つばめ", "text": "$handle$さんだと\n素直にできるんだ。"},
        { "location": "7469/Talk", "narrator": "つばめ", "text": "……わたし、\nほんとは弱虫だから……。"},
        { "location": "7470/Talk", "narrator": "つばめ", "text": "あの。\nちょっとだけ、\n甘えていいかな？"},
        { "location": "7471/Talk", "narrator": "つばめ", "text": "えっと、\nちょっとでいいから――"},
        { "location": "7472/Talk", "narrator": "つばめ", "text": "よしよし…って、\nしてください……っ。"},
        { "location": "7473/Talk", "narrator": "つばめ", "text": "……えっと、\n嬉しいですっ……。"},
        { "location": "7474/Talk", "narrator": "つばめ", "text": "わたし、\n$handle$さんが\n好き。"},
        { "location": "7475/Talk", "narrator": "つばめ", "text": "大好きです！\n本当に、大好きです…。"},
        { "location": "7476/Talk", "narrator": "つばめ", "text": "ずっと、ずっと\n一緒にいたいです。"},
        { "location": "7477/Talk", "narrator": "つばめ", "text": "って、ごめんなさい！\nわたし、ほんとに\nなにやってるんだろ。"},
        { "location": "7478/Talk", "narrator": "つばめ", "text": "MV見るの、全然\n進んでなかったよ……。"},
        { "location": "7479/Talk", "narrator": "つばめ", "text": "やっぱりわたしって\n抜けててダメだねぇ――"},
        { "location": "7480/Talk", "narrator": "つばめ", "text": "じゃなくって！\nポジティブポジティブ！\n自分を好きになろう！"},
        { "location": "7481/Talk", "narrator": "つばめ", "text": "えっと！！"},
        { "location": "7482/Talk", "narrator": "つばめ", "text": "わたしは\n$handle$さんの\n素敵なお嫁さんですから！"},
        { "location": "7483/Talk", "narrator": "つばめ", "text": "…はぁっ！"},
        { "location": "7484/Talk", "narrator": "つばめ", "text": "はぁっ、\n嬉しい……。"},
        { "location": "7485/Talk", "narrator": "つばめ", "text": "$handle$さん……"},
        { "location": "7486/Talk", "narrator": "つばめ", "text": "あっ、はい！\nごめんなさい！"},
        { "location": "7487/Talk", "narrator": "つばめ", "text": "…えへへ。\nなんだかちょっと\n気持ちが高ぶっちゃって。"},
        { "location": "7488/Talk", "narrator": "つばめ", "text": "あああっ！\nご、ごめんなさい！"},
        { "location": "7489/Talk", "narrator": "つばめ", "text": "もうしないから、\nこれからも一緒に\nいてください。"},
        { "location": "7490/Talk", "narrator": "つばめ", "text": "あっ、えっと。"},
        { "location": "7491/Talk", "narrator": "つばめ", "text": "とりあえず、\n続き、見ませんか？"},
        { "location": "7492/Talk", "narrator": "つばめ", "text": "ええっ！！\nな、何がですかっ！？"},
        { "location": "7493/Talk", "narrator": "つばめ", "text": "え、えええっ！？"},
        { "location": "7494/Talk", "narrator": "つばめ", "text": "えっと、あの、\nただ歌ってるだけ\nなんだけど……。"},
        { "location": "7495/Talk", "narrator": "つばめ", "text": "え、えええっ！？"},
        { "location": "7496/Talk", "narrator": "つばめ", "text": "だ、大丈夫ですかっ！？\n救急車呼びますか！？"},
        { "location": "7497/Talk", "narrator": "つばめ", "text": "したいしたい！\nしたいです！！"},
        { "location": "7498/Talk", "narrator": "つばめ", "text": "$handle$さんと\n一緒に行きたいところ\nいっぱいあるから！"},
        { "location": "7499/Talk", "narrator": "つばめ", "text": "おだいばとか、\nスカイツリーとか、\n水族館とか！"},
        { "location": "7500/Talk", "narrator": "つばめ", "text": "それと、原宿でしょ？\n渋谷もいいし！\nフルーツパーラーも！"},
        { "location": "7501/Talk", "narrator": "つばめ", "text": "あ、あと、お代官やま？？"},
        { "location": "7502/Talk", "narrator": "つばめ", "text": "そんなのあるの！？\nすごいね！！"},
        { "location": "7503/Talk", "narrator": "つばめ", "text": "やっぱりそうだよね。\nえへへ……。"},
        { "location": "7504/Talk", "narrator": "つばめ", "text": "前にアーヤさんが、\nお代官やまに、素敵な\nフレンチがあるって。"},
        { "location": "7505/Talk", "narrator": "つばめ", "text": "だから、\n$handle$さんと\n行けたら素敵だなって。"},
        { "location": "7506/Talk", "narrator": "つばめ", "text": "やったぁ！"},
        { "location": "7507/Talk", "narrator": "つばめ", "text": "いつか絶対、\n一緒に行こうね！"},
        { "location": "7508/Talk", "narrator": "つばめ", "text": "えへへ、そうだよね？"},
        { "location": "7509/Talk", "narrator": "つばめ", "text": "$handle$さん、\n今度教えてね…？"},
        { "location": "7510/Talk", "narrator": "つばめ", "text": "あっ、でも、\nお店だと恥ずかしいから、\n今度おうちで。"},
        { "location": "7511/Talk", "narrator": "つばめ", "text": "ああっ、確かに！！\nこの映像、ちょっと\n光が強すぎですよね？"},
        { "location": "7512/Talk", "narrator": "つばめ", "text": "えええええっ！？"},
        { "location": "7513/Talk", "narrator": "つばめ", "text": "だだだ大丈夫ですよっ！\n人生谷あれば苦ありです！"},
        { "location": "7514/Talk", "narrator": "つばめ", "text": "今は可愛すぎでも、\nきっとすぐに――"},
        { "location": "7515/Talk", "narrator": "つばめ", "text": "って、あれ？　わたし、\nなんかよくわからないこと\n言ってるような……？"},
        { "location": "7516/Talk", "narrator": "つばめ", "text": "わあああっ！\nそんな大声で！"},
        { "location": "7517/Talk", "narrator": "つばめ", "text": "わ、わたしも\nちゃんとお返しします！"},
        { "location": "7518/Talk", "narrator": "つばめ", "text": "$handle$さーん！\n大好きでーーーーすっ！！"},
        { "location": "7519/Talk", "narrator": "つばめ", "text": "うん。\n東京は大好きだよ。\nずっと憧れてたんだ。"},
        { "location": "7520/Talk", "narrator": "つばめ", "text": "中学の時ずっと入院してて\n女の子らしいこと、全然\n出来なかったから――"},
        { "location": "7521/Talk", "narrator": "つばめ", "text": "退院したら、東京みたいな\n素敵なところで、\nめいっぱい遊ぶぞーって！"},
        { "location": "7522/Talk", "narrator": "つばめ", "text": "その夢を、\n$handle$さんは\n後押ししてくれたんだ。"},
        { "location": "7523/Talk", "narrator": "つばめ", "text": "大変なことも\nいっぱいあったけど……"},
        { "location": "7524/Talk", "narrator": "つばめ", "text": "でも、神楽ちゃんや、\nトライナリーのみんなや。"},
        { "location": "7525/Talk", "narrator": "つばめ", "text": "$handle$さんに\n出逢えたから、本当に\n良かったと思ってるよ。"},
        { "location": "7526/Talk", "narrator": "つばめ", "text": "ありがとう。\nえへへ……。"},
        { "location": "7527/Talk", "narrator": "つばめ", "text": "あはは……\n確かに色々あったもんね。"},
        { "location": "7528/Talk", "narrator": "つばめ", "text": "ええっ！\n$handle$さんの\nせいじゃないよ！"},
        { "location": "7529/Talk", "narrator": "つばめ", "text": "へ……？"},
        { "location": "7530/Talk", "narrator": "つばめ", "text": "芸術？\nなにな……に……？"},
        { "location": "7531/Talk", "narrator": "つばめ", "text": "ふえええ……。"},
        { "location": "7532/Talk", "narrator": "つばめ", "text": "全然尊くなんか\nないよぅ……。"},
        { "location": "7533/Talk", "narrator": "つばめ", "text": "残念じゃ\nないよぅ……。"},
        { "location": "7534/Talk", "narrator": "つばめ", "text": "ええっ！？\nまた――？"},
        { "location": "7535/Talk", "narrator": "つばめ", "text": "えっと、嫌じゃないけど\nやっぱりドキドキするし。"},
        { "location": "7536/Talk", "narrator": "つばめ", "text": "もうちょっと、\n頑張って練習したら\nにしよう？　ね？"},
        { "location": "7537/Talk", "narrator": "つばめ", "text": "えへへ、ありがとう。"},
        { "location": "7538/Talk", "narrator": "つばめ", "text": "あはは……。\nそれだけが\n取り柄だもんね。"},
        { "location": "7539/Talk", "narrator": "つばめ", "text": "はあっ……\n名前で呼ばれると、\nなんか夫婦みたいですね。"},
        { "location": "7540/Talk", "narrator": "つばめ", "text": "えっと……"},
        { "location": "7541/Talk", "narrator": "つばめ", "text": "あはっ！\n嬉しいです！"},
        { "location": "7542/Talk", "narrator": "つばめ", "text": "ずっとずっと\n一緒なんだ～！\nえへへ……。"},
        { "location": "7543/Talk", "narrator": "つばめ", "text": "ああっ、もちろん\n全然それで構わないです！"},
        { "location": "7544/Talk", "narrator": "つばめ", "text": "その子のことを\nずっとずっと、大事に\nしてあげてください！"},
        { "location": "7545/Talk", "narrator": "つばめ", "text": "でも、わたしがまた\n落ち込んだりしたとき――"},
        { "location": "7546/Talk", "narrator": "つばめ", "text": "ちょっとだけ、\nお話聞いてくれると\nとっても嬉しいです！"},
        { "location": "7547/Talk", "narrator": "赤髪千羽鶴", "text": "いらっしゃい、\n$handle$さん。"},
        { "location": "7548/Talk", "narrator": "赤髪千羽鶴", "text": "ここに来てくれて\nありがとうございます。\nとっても嬉しいです。"},
        { "location": "7549/Talk", "narrator": "赤髪千羽鶴", "text": "今回ここで\nご覧いただく映像は――"},
        { "location": "7550/Talk", "narrator": "赤髪千羽鶴", "text": "前にお伝えしたように、\n$handle$さんと\n出逢った頃のものです。"},
        { "location": "7551/Talk", "narrator": "赤髪千羽鶴", "text": "他のみんなに比べて\nなんだか見劣りしちゃうし\nつまらないし――"},
        { "location": "7552/Talk", "narrator": "赤髪千羽鶴", "text": "よくわからない動画だけど\n最後まで一緒に見ていって\n欲しいです！"},
        { "location": "7553/Talk", "narrator": "赤髪千羽鶴", "text": "なので、これから\n彼女を呼びますが――"},
        { "location": "7554/Talk", "narrator": "赤髪千羽鶴", "text": "どんな格好を\nお望みですか？"},
        { "location": "7555/Talk", "narrator": "つばめ", "text": "こ、こんにちは、\n$handle$さん！"},
        { "location": "7556/Talk", "narrator": "つばめ", "text": "えっと、どうかな、\nこの格好？"},
        { "location": "7557/Talk", "narrator": "つばめ", "text": "それと。"},
        { "location": "7558/Talk", "narrator": "つばめ", "text": "こうして二人きりで\n見られるなんて思っても\nみなかったから――"},
        { "location": "7559/Talk", "narrator": "つばめ", "text": "ちょっと嬉しいかも。\nえへへ……。"},
        { "location": "7560/Talk", "narrator": "つばめ", "text": "短い時間ですけど、\nよろしくお願いします！"},
        { "location": "7561/Talk", "narrator": "つばめ", "text": "……って、\nいきなりここなんだ。"},
        { "location": "7562/Talk", "narrator": "つばめ", "text": "そうだ。\nなんか懐かしくなって\nきちゃったから――"},
        { "location": "7563/Talk", "narrator": "つばめ", "text": "ちょっと遠州弁で\n喋ってみようかなぁ。"},
        { "location": "7564/Talk", "narrator": "つばめ", "text": "歌はとってもカフェっ\nぽくてオシャレなのに、\nちょっとアレだけど……"},
        { "location": "7565/Talk", "narrator": "つばめ", "text": "そういえばこの時、\nかなり後悔したんだよね。"},
        { "location": "7566/Talk", "narrator": "つばめ", "text": "新幹線に乗っていけば、\n最初からメノウちゃんの\nライブ見れたのになぁ。"},
        { "location": "7567/Talk", "narrator": "つばめ", "text": "あっ！\n歌が始まった……に？"},
        { "location": "7568/Talk", "narrator": "つばめ", "text": "きゃーーー！\n恥ずかしいぃぃぃ！"},
        { "location": "7569/Talk", "narrator": "つばめ", "text": "って、こんな事してちゃあ\nいつまで経っても\nお話し進まないら。"},
        { "location": "7570/Talk", "narrator": "つばめ", "text": "これじゃあ\n$handle$さんに\n申し訳無いで――"},
        { "location": "7571/Talk", "narrator": "つばめ", "text": "もう開き直って行くでね！"},
        { "location": "7572/Talk", "narrator": "つばめ", "text": "思い返しゃ、こん時が\n$handle$さんとの\n出逢いだったぁよね。"},
        { "location": "7573/Talk", "narrator": "つばめ", "text": "こん時ゃまだ、\n今みたくになるなんて\n思いもせんかったけぇが。"},
        { "location": "7574/Talk", "narrator": "つばめ", "text": "はぁぁ……。"},
        { "location": "7575/Talk", "narrator": "つばめ", "text": "もうやめやめ！\n方言で会話するのは\nここまでーっ！！"},
        { "location": "7576/Talk", "narrator": "つばめ", "text": "わたしもあんな可愛い声で\nエレガントな感じに\n喋れたらなぁ。"},
        { "location": "7577/Talk", "narrator": "つばめ", "text": "ガブちゃんや神楽ちゃんの\n方が全然可愛いし。"},
        { "location": "7578/Talk", "narrator": "つばめ", "text": "みやびさんやアーヤさんは\nすごい美人だし。"},
        { "location": "7579/Talk", "narrator": "つばめ", "text": "わたしだけ、なんか\n全然ダメだなぁって\nいつも思っちゃって。"},
        { "location": "7580/Talk", "narrator": "つばめ", "text": "勉強も運動もホントに\nみんな凄いよね。わたしは\nどっちもダメだけど――"},
        { "location": "7581/Talk", "narrator": "つばめ", "text": "ひゃあああああ！！\nなんでここで、\nこんな映像が！？"},
        { "location": "7582/Talk", "narrator": "つばめ", "text": "ストップストップ！"},
        { "location": "7583/Talk", "narrator": "つばめ", "text": "やっぱ止めちゃダメ！"},
        { "location": "7584/Talk", "narrator": "つばめ", "text": "ああっ！\nやっぱりストップー！"},
        { "location": "7585/Talk", "narrator": "つばめ", "text": "で、でも、\nアレかなぁ……。"},
        { "location": "7586/Talk", "narrator": "つばめ", "text": "こういうのも、きっと\n大人の階段登るって\nやつなんだよね！"},
        { "location": "7587/Talk", "narrator": "つばめ", "text": "恥ずかしいけど\nここは頑張って\n涼しい顔しなくちゃ……"},
        { "location": "7588/Talk", "narrator": "つばめ", "text": "あっ！\n終わった！！\nよかったぁ～……。"},
        { "location": "7589/Talk", "narrator": "つばめ", "text": "ふぅ……。"},
        { "location": "7590/Talk", "narrator": "つばめ", "text": "きっともう大丈夫。\nはぁ、ビックリしたぁ。"},
        { "location": "7591/Talk", "narrator": "つばめ", "text": "この時はホントに\nメノウちゃんのことで\n頭いっぱいだったなぁ。"},
        { "location": "7592/Talk", "narrator": "つばめ", "text": "今は、\n$handle$さんで\n頭いっぱいだけど……。"},
        { "location": "7593/Talk", "narrator": "つばめ", "text": "$handle$さん。\n本当に今の今までずっと、\nありがとうございます。"},
        { "location": "7594/Talk", "narrator": "つばめ", "text": "わたし、\n$handle$さんが\nいたから今があると思う。"},
        { "location": "7595/Talk", "narrator": "つばめ", "text": "いつもわたしのことを\n見守ってくれていて――"},
        { "location": "7596/Talk", "narrator": "つばめ", "text": "今日も、\n二人で見るって思って、\nすごく緊張したけど！"},
        { "location": "7597/Talk", "narrator": "つばめ", "text": "$handle$さん、\nいつもみたいに優しくて\nとても楽しかったよ。"},
        { "location": "7598/Talk", "narrator": "つばめ", "text": "わたしの方が、\n途中で落ち込んだりして\nごめんね？"},
        { "location": "7599/Talk", "narrator": "つばめ", "text": "でも、ああいうの\nあまり人に\n見せないから――"},
        { "location": "7600/Talk", "narrator": "つばめ", "text": "…ううん。\n$handle$さんにしか\n見せたことないや。"},
        { "location": "7601/Talk", "narrator": "つばめ", "text": "だから今日は、\nとっても嬉しかったです。"},
        { "location": "7602/Talk", "narrator": "つばめ", "text": "$handle$さんには\n弱いところ見せても\n大丈夫だって思えたし。"},
        { "location": "7603/Talk", "narrator": "つばめ", "text": "だから、\n何度も同じ事\n言っちゃうかもだけど――"},
        { "location": "7604/Talk", "narrator": "つばめ", "text": "わたしは、\n$handle$さんが\n大好きです！"},
        { "location": "7605/Talk", "narrator": "つばめ", "text": "ずっとずっと、\n一緒にいたいです……。"},
        { "location": "7606/Talk", "narrator": "つばめ", "text": "ずっと、…ずっと……。"},
        { "location": "7607/Talk", "narrator": "つばめ", "text": "$handle$さんっ！"},
        { "location": "7608/Talk", "narrator": "つばめ", "text": "これからもずっと、\nわたしの隣に\nいてくださいね。"},
        { "location": "7609/Talk", "narrator": "つばめ", "text": "映像終わったのに、\n長話しちゃいましたね。"},
        { "location": "7610/Talk", "narrator": "つばめ", "text": "今日はそろそろ\nお終いにしなくちゃ。"},
        { "location": "7611/Talk", "narrator": "つばめ", "text": "$handle$さん。\n今日はほんとに\nありがとうございました。"},
        { "location": "7612/Talk", "narrator": "つばめ", "text": "また、これからも\nよろしくお願いします！"},
        { "location": "7613/Talk", "narrator": "つばめ", "text": "$handle$さんと\nわたしに、\n素敵なココロの旅を！"},
        { "location": "7614/Talk", "narrator": "つばめ", "text": "ばいばい！"}
    ]
}
