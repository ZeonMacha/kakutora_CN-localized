    "entry":
    [
        { "location": "1/chrome"   , "narrator": "", "text": "デイトラ！ | Daily Trinary"},
        { "location": "2/article"  , "narrator": "", "text": "地下室から謎の呟きが聞こえる【２】"},
        { "location": "3/article"  , "narrator": "", "text": "２．なんでも番付（業務用）"},
        { "location": "4/article"  , "narrator": "", "text": "▼学力（学内順位）"},
        { "location": "5/article"  , "narrator": "", "text": "ガブ＞アーヤ＞神楽＞みやび＞つばめ"},
        { "location": "6/article"  , "narrator": "", "text": "▼体力（運動神経）"},
        { "location": "7/article"  , "narrator": "", "text": "アーヤ≧神楽＞ガブ＞つばめ＞みやび"},
        { "location": "8/article"  , "narrator": "", "text": "▼集中力"},
        { "location": "9/article"  , "narrator": "", "text": "ガブ＞みやび＞アーヤ＞神楽＞つばめ"},
        { "location": "10/article" , "narrator": "", "text": "▼世界改変力"},
        { "location": "11/article" , "narrator": "", "text": "つばめ＞＞＞アーヤ＝ガブ＝みやび＝神楽"},
        { "location": "12/article" , "narrator": "", "text": "生活習慣-------------------"},
        { "location": "13/article" , "narrator": "", "text": "▼料理"},
        { "location": "14/article" , "narrator": "", "text": "みやび＞アーヤ＞ガブ＞神楽＞つばめ"},
        { "location": "15/article" , "narrator": "", "text": "▼掃除洗濯"},
        { "location": "16/article" , "narrator": "", "text": "つばめ＞アーヤ＞ガブ＞神楽≧みやび"},
        { "location": "17/article" , "narrator": "", "text": "▼寝起きの良さ"},
        { "location": "18/article" , "narrator": "", "text": "ガブ≧アーヤ＞＞つばめ＞みやび＞神楽"},
        { "location": "19/article" , "narrator": "", "text": "▼浪費度（財布の紐のゆるさ）"},
        { "location": "20/article" , "narrator": "", "text": "神楽＞みやび＞ガブ"},
        { "location": "21/article" , "narrator": "", "text": "＞つばめ＞＞"},
        { "location": "22/article" , "narrator": "", "text": "＞アーヤ"},
        { "location": "23/article" , "narrator": "", "text": "外面、容姿-------------------"},
        { "location": "24/article" , "narrator": "", "text": "▼ファッション意識"},
        { "location": "25/article" , "narrator": "", "text": "神楽≧アーヤ＞ガブ≧みやび＞つばめ"},
        { "location": "26/article" , "narrator": "", "text": "▼メイクスキル"},
        { "location": "27/article" , "narrator": "", "text": "神楽≧アーヤ"},
        { "location": "28/article" , "narrator": "", "text": "≧みやび"},
        { "location": "29/article" , "narrator": "", "text": "＞ガブ＞つばめ"},
        { "location": "30/article" , "narrator": "", "text": "内面、性格-------------------"},
        { "location": "31/article" , "narrator": "", "text": "▼社交性（誰とでも話せる、ネタが尽きない）"},
        { "location": "32/article" , "narrator": "", "text": "神楽＞つばめ＞みやび＞アーヤ＞ガブ"},
        { "location": "33/article" , "narrator": "", "text": "▼モラリティ（真面目度合、ルール遵守）"},
        { "location": "34/article" , "narrator": "", "text": "アーヤ＞ガブ＞つばめ＞神楽≧みやび"},
        { "location": "35/article" , "narrator": "", "text": "▼思いきり（いざというときの行動力）"},
        { "location": "36/article" , "narrator": "", "text": "つばめ＞みやび＞＞神楽＞ガブ＞アーヤ"},
        { "location": "37/article" , "narrator": "", "text": "▼リーダーシップ（決断力、仕切スキル）"},
        { "location": "38/article" , "narrator": "", "text": "神楽≧みやび＞アーヤ＞ガブ＞つばめ"},
        { "location": "39/article" , "narrator": "", "text": "▼アイデア（予想外の発案）"},
        { "location": "40/article" , "narrator": "", "text": "つばめ＞みやび＝神楽＞ガブ＞アーヤ"},
        { "location": "41/article" , "narrator": "", "text": "▼自律性（我慢出来る度合）"},
        { "location": "42/article" , "narrator": "", "text": "アーヤ＝みやび＞つばめ＞神楽＞ガブ"},
        { "location": "43/article" , "narrator": "", "text": "▼人当たり（温和度合）"},
        { "location": "44/article" , "narrator": "", "text": "つばめ＞＞神楽＞みやび＞アーヤ＞ガブ"},
        { "location": "45/article" , "narrator": "", "text": "地下室から謎の呟きが聞こえる【１】"},
        { "location": "46/article" , "narrator": "", "text": "１．ご家族に「娘さんください」とご挨拶に行ったときの反応"},
        { "location": "47/article" , "narrator": "", "text": "▼逢瀬家"},
        { "location": "48/article" , "narrator": "", "text": "啓介「なんだとー！どこの馬の骨だかわからんやつに、娘なんぞやれんわー！」"},
        { "location": "49/article" , "narrator": "", "text": "つばめ「お父さん！○○さんは馬の骨なんかじゃないから！」"},
        { "location": "50/article" , "narrator": "", "text": "啓介「ふん。娘をたぶらかしよったか」"},
        { "location": "51/article" , "narrator": "", "text": "つばめ「たぶらかしてなんてないよ！！お父さん嫌い！」"},
        { "location": "52/article" , "narrator": "", "text": "啓介「お前はだあっとれ！！」"},
        { "location": "53/article" , "narrator": "", "text": "※夜、酒を飲み交わしながら"},
        { "location": "54/article" , "narrator": "", "text": "啓介「ううっ、アイツはのんびりしていて抜けたところもあるが、私にとっては唯一人の大切な娘なんだ……お前なんかに…ううっ。絶対に幸せにしろ！いいな！わかったか！」"},
        { "location": "55/article" , "narrator": "", "text": "ひばり「よかった、つばめに素敵な人が出来て。私はお母さんらしいことは何もしてあげられなかったで、どうかその分、幸せにしてあげてくださいね。あの人もやっと、ゆっくり休めるようになると思います、ありがとうね」"},
        { "location": "56/article" , "narrator": "", "text": "▼國政家"},
        { "location": "57/article" , "narrator": "", "text": "あなた「綾水さんをください、必ず幸せにします」"},
        { "location": "58/article" , "narrator": "", "text": "板の間であぐらをかいている父"},
        { "location": "59/article" , "narrator": "", "text": "綾水父「國政の家は由緒正しき神道の継承者にして天照大神の光の下、日本武尊を祀り給う神聖なる家、決してその血統を絶やす訳にはいかん。養子になり、この家を継ぐ気はあるか」"},
        { "location": "60/article" , "narrator": "", "text": "→はい"},
        { "location": "61/article" , "narrator": "", "text": "綾水父「よし！よく言ってくれた！」 →ハッピーエンド"},
        { "location": "62/article" , "narrator": "", "text": "→いいえ"},
        { "location": "63/article" , "narrator": "", "text": "→八大地獄"},
        { "location": "64/article" , "narrator": "", "text": "綾水母「おやき食べてく？」"},
        { "location": "65/article" , "narrator": "", "text": "あなた「あ、ありがとうございます」"},
        { "location": "66/article" , "narrator": "", "text": "綾水母「さっき作ったばっかりだから。６つとも味が違うでね、ちなみに１コはワサビだで」"},
        { "location": "67/article" , "narrator": "", "text": "あなた「え、ええっ！？」"},
        { "location": "68/article" , "narrator": "", "text": "綾水母「それ食べたらご破談ね」"},
        { "location": "69/article" , "narrator": "", "text": "あなた「そんな」"},
        { "location": "70/article" , "narrator": "", "text": "綾水母「なんちゃって。でも心配せんでもいいよ、ワサビ絶対綾ちゃん引くでｗｗｗ」"},
        { "location": "71/article" , "narrator": "", "text": "▼ロタルィンスカ家"},
        { "location": "72/article" , "narrator": "", "text": "あなた「ガブリエラさんをお嫁にください」"},
        { "location": "73/article" , "narrator": "", "text": "ガブ父（無言で銃の手入れをしている）"},
        { "location": "74/article" , "narrator": "", "text": "あなた「……あ、あの…（ゴクリ」"},
        { "location": "75/article" , "narrator": "", "text": "ガブ父「君は今まで、何かに命を賭けたことがあるか」"},
        { "location": "76/article" , "narrator": "", "text": "あなた「えと、いえ、あまり」"},
        { "location": "77/article" , "narrator": "", "text": "ガブ父「ならば、ここで賭けてみるか？」"},
        { "location": "78/article" , "narrator": "", "text": "あなた「…（ゴクリ」"},
        { "location": "79/article" , "narrator": "", "text": "ガブ父「…ふん、返事も出来ないのか。まあ所詮はそんなものだろう。まだ娘はやれないな」"},
        { "location": "80/article" , "narrator": "", "text": "あなた「…すみません」"},
        { "location": "81/article" , "narrator": "", "text": "ガブ父「君と話していると疲れるな。ギャヴィ、今日はもう疲れたから夕食はベルヴェデーレで済ます。準備してきなさい」"},
        { "location": "82/article" , "narrator": "", "text": "ガブ「はい、お父様」"},
        { "location": "83/article" , "narrator": "", "text": "ガブ父「君も、ちゃんと正装しないと恥を掻くぞ」"},
        { "location": "84/article" , "narrator": "", "text": "ガブ「ごめんね、お父様ツンデレだから。でも本当は貴方のこと、とても感謝してるのよ？」"},
        { "location": "85/article" , "narrator": "", "text": "▼恋ヶ崎家"},
        { "location": "86/article" , "narrator": "", "text": "あなた「みやびさんをおｙ」"},
        { "location": "87/article" , "narrator": "", "text": "みやび父「まあまあ、固い挨拶なんぞしちょらんで、こっちこいや、おきゃくぞね！」"},
        { "location": "88/article" , "narrator": "", "text": "みやび母「えいお酒入ってますきね。あんたは飲み過ぎんようにね」"},
        { "location": "89/article" , "narrator": "", "text": "みやび父「バカチンが！今日飲まずしていつ呑む！ぶわーっと宴会にゃあ」"},
        { "location": "90/article" , "narrator": "", "text": "みやび母「（あなたに耳打ち）程々にしてやってくださいね」"},
        { "location": "91/article" , "narrator": "", "text": "※数時間後"},
        { "location": "92/article" , "narrator": "", "text": "みやび父「えい飲みっぷりだにゃあ！」"},
        { "location": "93/article" , "narrator": "", "text": "あなた「ありがとうございます、それでお話なんですけど、みやびさｎ」"},
        { "location": "94/article" , "narrator": "", "text": "みやび父「次次！やっぱりこの辺で土佐鶴大吟醸で口直ししとこうな！な！」"},
        { "location": "95/article" , "narrator": "", "text": "あなた「えっと、それれお話なんれすけｄ」"},
        { "location": "96/article" , "narrator": "", "text": "みやび父「んがー…んごー…」"},
        { "location": "97/article" , "narrator": "", "text": "みやび母「おとん、やっぱり寂しいがですよ。代わりに私から。変わった子ですけんど、二人で一生懸命育ててきましたき。どうか末永くよろしくお願いします」"},
        { "location": "98/article" , "narrator": "", "text": "あなた「はい、必ずや幸せに」"},
        { "location": "99/article" , "narrator": "", "text": "みやび母「けんど！一度言ったからには本気でお願いします。土佐の女は「はちきん」ながやき、もし泣かすようなことがありゃあ、私が許しませんき。覚悟はえいですか？」"},
        { "location": "100/article", "narrator": "", "text": "（みやびは２階でコンソール前寝落ち）"},
        { "location": "101/article", "narrator": "", "text": "▼卯月家（文雄生きてたらVer）"},
        { "location": "102/article", "narrator": "", "text": "あなた「神楽さんと結婚させてください」"},
        { "location": "103/article", "narrator": "", "text": "文雄「君、ゼータ関数の自然数和が-1/12に収束する仕組みをわかりますか？」"},
        { "location": "104/article", "narrator": "", "text": "あなた「は、はい？」"},
        { "location": "105/article", "narrator": "", "text": "文雄「君たちの結婚という状態は量子的に見れば―――"},
        { "location": "106/article", "narrator": "", "text": "美佐子「お式やるなら、12の月の3がつく日がいいみたいよ～？あ、それから、当日には必ず赤をテーマにしてね、あと、ケーキはシュバルツベルダーキルシュトルテがいいわね！ そうすれば―――"},
        { "location": "107/article", "narrator": "", "text": "神楽（こいつら、私の結婚相手には興味ないのかよおい）"},
        { "location": "108/article", "narrator": "", "text": "文雄「あ、それと、後で脳波検査するから、私の部屋に来なさい。量子的な相対位置を見るから」"},
        { "location": "109/article", "narrator": "", "text": "美佐子「二人の相性と今後のバイオリズムを作るから、生年月日とか色々教えてね？」"},
        { "location": "110/article", "narrator": "", "text": "あなた「あ、はい…」"},
        { "location": "111/article", "narrator": "", "text": "神楽（はぁぁ…早く二人きりで暮らしたいぴょん…）"},
        { "location": "112/article", "narrator": "", "text": "コミケ告知４回目"},
        { "location": "113/article", "narrator": "", "text": "コミケ告知４回目が更新されています！"},
        { "location": "114/article", "narrator": "", "text": "「おや？がすとちゃんの様子が…！？」"},
        { "location": "115/article", "narrator": "", "text": "な最終回をどうぞお楽しみください。"},
        { "location": "116/article", "narrator": "", "text": "イベントクエストの「がすとちゃんサマー大作戦♪」ですよ。"}
    ]
}
