    "info": {
        "title": "デイトラ！ | Daily Trinary"
    },
    "entry":
    [
        { "location": "1/chrome"  , "narrator": "", "text": "デイトラ！ | Daily Trinary"},
        { "location": "2/article" , "narrator": "", "text": "部屋の紹介だって～～～ヾ(｡>﹏"},
        { "location": "3/article" , "narrator": "", "text": "お題【お部屋拝見】 逢瀬つばめ編"},
        { "location": "4/article" , "narrator": "", "text": "ブログ２回目だょヽ(*´∀｀*)ﾉ.+ﾟ"},
        { "location": "5/article" , "narrator": "", "text": "今回は、自分の部屋の紹介をしろだってぇ～～(*≧∀≦*)"},
        { "location": "6/article" , "narrator": "", "text": "でも私のへやって、何もないんだよねぇ(●´ω｀●)"},
        { "location": "7/article" , "narrator": "", "text": "メノウちゃんのＣＤとかしかないから、"},
        { "location": "8/article" , "narrator": "", "text": "あまり大きなものがなくて、"},
        { "location": "9/article" , "narrator": "", "text": "なんか家の展示会のモデルルームみたいだって"},
        { "location": "10/article", "narrator": "", "text": "みんなに言われちゃったょΣ(･ω･;|||"},
        { "location": "11/article", "narrator": "", "text": "でもね、それでも毎日お掃除するところは沢山あるょ。"},
        { "location": "12/article", "narrator": "", "text": "私、お掃除して部屋が綺麗になるのが大好きだから、"},
        { "location": "13/article", "narrator": "", "text": "こういう真っ白なお部屋が好きなんだょね～(´∀｀*)ｳﾌﾌ"},
        { "location": "14/article", "narrator": "", "text": "それに、普段だって音楽聞きながら"},
        { "location": "15/article", "narrator": "", "text": "ネット見たり雑誌読んだりしてるだけだし、"},
        { "location": "16/article", "narrator": "", "text": "今はこれで十分なの( #●´艸`)"},
        { "location": "17/article", "narrator": "", "text": "卯月神楽です♪"},
        { "location": "18/article", "narrator": "", "text": "お題【自己紹介】 卯月神楽編"},
        { "location": "19/article", "narrator": "", "text": "はじめまして、卯月神楽です♪"},
        { "location": "20/article", "narrator": "", "text": "かわいいものと、ファンタジーなものが大好きですっ！"},
        { "location": "21/article", "narrator": "", "text": "まずは簡単に自己紹介をしますね～。"},
        { "location": "22/article", "narrator": "", "text": "生まれも育ちも東京です！"},
        { "location": "23/article", "narrator": "", "text": "好きなことは、カフェ巡り…ってことにしておきますね。"},
        { "location": "24/article", "narrator": "", "text": "ちょうどそんな感じの写真が貼ってありますし。"},
        { "location": "25/article", "narrator": "", "text": "「かわいいもの」は、小動物系が大好きです♪"},
        { "location": "26/article", "narrator": "", "text": "ついついイタズラしたくなっちゃいますよねっ！"},
        { "location": "27/article", "narrator": "", "text": "「ファンタジー」は大好物ですっ！"},
        { "location": "28/article", "narrator": "", "text": "あ、でも、どちらかというと、"},
        { "location": "29/article", "narrator": "", "text": "王子様とお姫様みたいな童謡的なものよりも、"},
        { "location": "30/article", "narrator": "", "text": "カラファリアの森に潜む神獣モスマルを探して"},
        { "location": "31/article", "narrator": "", "text": "険しい道程を冒険するエルフ族の少年、みたいなのがいいですよね♪"},
        { "location": "32/article", "narrator": "", "text": "途中でとある少女リーンと出逢い、村で生け贄にされかけていたその少女リーンを救出して二人で逃げるんです！そして帰る村を失ってしまったリーンを、少年ライルは守っていこうと決意して、二人でモスマルを探す旅をする事になって、そんな中で色んなハプニングがありつつも二人は段々意識するようになったりしつつ、でもエルフは人間と一緒になってはならないという掟があるから凄く苦悩しちゃったりして、愛を取るか、掟を取るかで葛藤しつつ、それが元にケンカして一時離ればなれになってその時リーンが死ぬような目にあったことがきっかけでライルは彼女を一生守ろうって誓うんです！その後２人はモスマルが住まうといわれる険しい森カラファリアに辿り着くんですけど何とそこにはおぞ"},
        { "location": "33/article", "narrator": "", "text": "※文字数制限に達しました。"},
        { "location": "34/article", "narrator": "", "text": "一部文章が掲載されない場合があります。"},
        { "location": "35/article", "narrator": "", "text": "テストkoikoi"},
        { "location": "36/article", "narrator": "", "text": "お題【自己紹介】 恋ヶ崎みやび編"},
        { "location": "37/article", "narrator": "", "text": "コイガサキ１７歳。"},
        { "location": "38/article", "narrator": "", "text": "今PCのセットアップ中につきご多忙です。"},
        { "location": "39/article", "narrator": "", "text": "よって本日の営業は終了とさせて"},
        { "location": "40/article", "narrator": "", "text": "いただきたいが、"},
        { "location": "41/article", "narrator": "", "text": "なんか書かないと当局から抹殺されそうなので"},
        { "location": "42/article", "narrator": "", "text": "適当に書きます。想定限界執筆時間５分に設定。"},
        { "location": "43/article", "narrator": "", "text": "恋ヶ崎みやび、高等部３年。"},
        { "location": "44/article", "narrator": "", "text": "基本ヒッキーと言われる類の者であり"},
        { "location": "45/article", "narrator": "", "text": "趣味は二度寝、と、あとPCということにしておく。"},
        { "location": "46/article", "narrator": "", "text": "出身は高知、けど今は実家は三浦に引っ越していて"},
        { "location": "47/article", "narrator": "", "text": "更にお住まいの寮は新宿区は筑土八幡町。何とも複雑な住環境。"},
        { "location": "48/article", "narrator": "", "text": "ふむ、こう改めて書くと、"},
        { "location": "49/article", "narrator": "", "text": "なんともトリッキーな人生を歩んでそうでえいね。"},
        { "location": "50/article", "narrator": "", "text": "まあ、"},
        { "location": "51/article", "narrator": "", "text": "これくらいでえいか。"},
        { "location": "52/article", "narrator": "", "text": "最後にお別れのメッセージを。"},
        { "location": "53/article", "narrator": "", "text": "久里浜線の景色は最高なので"},
        { "location": "54/article", "narrator": "", "text": "是非窓を全開にして乗ってください。"},
        { "location": "55/article", "narrator": "", "text": "＞足りてないもの"},
        { "location": "56/article", "narrator": "", "text": "じゃんぱ ３"},
        { "location": "57/article", "narrator": "", "text": "EZ-331D ジャンクまわりする"},
        { "location": "58/article", "narrator": "", "text": "あんみつ"},
        { "location": "59/article", "narrator": "", "text": "保湿くりーむ"}
    ]
}
