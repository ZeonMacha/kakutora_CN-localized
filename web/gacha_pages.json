        { "location": "1/article" , "narrator": "", "text": "拡張少女系トライナリー"},
        { "location": "2/article" , "narrator": "", "text": "1日1回無料のクランポイントガチャ！"},
        { "location": "3/article" , "narrator": "", "text": "クランポイントを貯めてお得にクランをGETしよう！！"},
        { "location": "4/article" , "narrator": "", "text": "クランポイントはバトルをクリアすることなどで手に入れることができます。"},
        { "location": "5/article" , "narrator": "", "text": "一部対象外クラン以外のすべてのクランとガチャチケットが排出されます。"},
        { "location": "6/article" , "narrator": "", "text": "各レアリティのクランと排出対象外のクランにつきましては下記をご確認ください。"},
        { "location": "7/article" , "narrator": "", "text": "■対象外のクラン"},
        { "location": "8/article" , "narrator": "", "text": "・一部のコラボクラン"},
        { "location": "9/article" , "narrator": "", "text": "・進化後のクラン"},
        { "location": "10/article", "narrator": "", "text": "・各ヒロインのシャドウクラン5体（シャドウ・つばめ、シャドウ・アーヤ、等）"},
        { "location": "11/article", "narrator": "", "text": "・スピネル"},
        { "location": "12/article", "narrator": "", "text": "■排出時期の制限のあるクラン"},
        { "location": "13/article", "narrator": "", "text": "・ぴょんこ (ch.5 Ep.16 005 メインストーリー解放後)"},
        { "location": "14/article", "narrator": "", "text": "・エヴェレット (ch.2 Ep.25 005 メインストーリー解放後)"},
        { "location": "15/article", "narrator": "", "text": "・マルザンナ (ch.3 Ep.25 005 メインストーリー解放後)"},
        { "location": "16/article", "narrator": "", "text": "・シンギュラリティ (ch.4 Ep.25 005 メインストーリー解放後)"},
        { "location": "17/article", "narrator": "", "text": "・百鶴 (ch.1 Ep.27 005 メインストーリー解放後)"},
        { "location": "18/article", "narrator": "", "text": "・白烏 (ch.2 Ep.27 005 メインストーリー解放後)"},
        { "location": "19/article", "narrator": "", "text": "・リヴォルカ (ch.3 Ep.27 005 メインストーリー解放後)"},
        { "location": "20/article", "narrator": "", "text": "・四十九夜 (ch.4 Ep.27 005 メインストーリー解放後)"},
        { "location": "21/article", "narrator": "", "text": "・月神楽 (ch.5 Ep.28 005 メインストーリー解放後)"},
        { "location": "22/article", "narrator": "", "text": "・カレン (ch.1 Ep.29 005 メインストーリー解放後)"},
        { "location": "23/article", "narrator": "", "text": "・水鏡の神子 (ch.2 Ep.29 005 メインストーリー解放後)"},
        { "location": "24/article", "narrator": "", "text": "・マークスマン (ch.3 Ep.29 005 メインストーリー解放後)"},
        { "location": "25/article", "narrator": "", "text": "・なご (ch.4 Ep.29 005 メインストーリー解放後)"},
        { "location": "26/article", "narrator": "", "text": "・アースタシア(ch.5 Ep.29 005 メインストーリー解放後)"},
        { "location": "27/article", "narrator": "", "text": "・千羽鶴 (Ep.30 005 メインストーリー解放後)"},
        { "location": "28/article", "narrator": "", "text": "※クランポイントガチャには10連のおまけはつきません。"},
        { "location": "29/article", "narrator": "", "text": "SSRクラン（142体）"},
        { "location": "30/article", "narrator": "", "text": "SRクラン（170体）"},
        { "location": "31/article", "narrator": "", "text": "Rクラン（57体）"},
