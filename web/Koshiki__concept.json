    "entry":
    [
        { "location": "1/chrome"  , "narrator": "", "text": "拡張少女系トライナリー｜スマホアプリゲーム公式サイト"},
        { "location": "2/article" , "narrator": "", "text": "アプリとアニメが融合した"},
        { "location": "3/article" , "narrator": "", "text": "新しいプレイ体験"},
        { "location": "4/article" , "narrator": "", "text": "アニメを見ながら、こんなことを"},
        { "location": "5/article" , "narrator": "", "text": "思ったことはありませんか？"},
        { "location": "6/article" , "narrator": "", "text": "「この裏側で何があったんだろう？」"},
        { "location": "7/article" , "narrator": "", "text": "「自分がこの子を支えてあげられたら！」"},
        { "location": "8/article" , "narrator": "", "text": "『拡張少女系トライナリー』では、その思いを実現します。"},
        { "location": "9/article" , "narrator": "", "text": "あなたはアニメ『拡張少女系トライナリー』に登場するヒロインたちに、"},
        { "location": "10/article", "narrator": "", "text": "このアプリを介して関わることができ、自分だけの物語を紡いでいけるのです。"},
        { "location": "11/article", "narrator": "", "text": "アプリをプレイすることでヒロインたちはあなたを知り、"},
        { "location": "12/article", "narrator": "", "text": "あなたは彼女たちを裏から支えられるようになります。"},
        { "location": "13/article", "narrator": "", "text": "彼女たちとコミュニケーションを取り、友だちになって、そして……。"},
        { "location": "14/article", "narrator": "", "text": "それは、普段なら絶対にできない体験。"},
        { "location": "15/article", "narrator": "", "text": "アニメの世界に介入し、ヒロインたちの生き様に関わり、"},
        { "location": "16/article", "narrator": "", "text": "目標を一緒に達成していく。"},
        { "location": "17/article", "narrator": "", "text": "『拡張少女系トライナリー』で、あなたもそして彼女たちも、"},
        { "location": "18/article", "narrator": "", "text": "人生を次のステージへ進ませることができるのです。"},
        { "location": "19/chrome" , "narrator": "", "text": "東映アニメーション"},
        { "location": "20/chrome" , "narrator": "", "text": "ガストソーシャル"},
        { "location": "21/chrome" , "narrator": "", "text": "ガストちゃんTwitter"},
        { "location": "22/chrome" , "narrator": "", "text": "ガスト公式Facebook"},
        { "location": "23/chrome" , "narrator": "", "text": "Apple、Apple ロゴ、iPhone、iPad、iPod touch は米国および他の国々で登録された Apple Inc. の商標です。"},
        { "location": "24/chrome" , "narrator": "", "text": "App Store は Apple Inc. のサービスマークです。"},
        { "location": "25/chrome" , "narrator": "", "text": "Android および Google Play ロゴは、Google Inc. の商標です。"},
