        "title": "拡張少女系トライナリー｜シェルノサージュ コラボ"
    },
    "entry":
    [
        { "location": "1/article" , "narrator": "", "text": "拡張少女系トライナリー｜シェルノサージュ コラボ"},
        { "location": "2/article" , "narrator": "", "text": "『シェルノサージュ』×『拡張少女系トライナリー』"},
        { "location": "3/article" , "narrator": "", "text": "バトルでポイントを集め、コラボコスチュームを手に入れよう！"},
        { "location": "4/article" , "narrator": "", "text": "開催期間"},
        { "location": "5/article" , "narrator": "", "text": "2017/11/29(水) メンテナンス終了後から"},
        { "location": "6/article" , "narrator": "", "text": "2017/12/13(水) メンテナンス開始前まで"},
        { "location": "7/article" , "narrator": "", "text": "イベントについて"},
        { "location": "8/article" , "narrator": "", "text": "開催中のイベントバトルで得たポイントを積み重ねると、その獲得量に応じた報酬が受け取れます。報酬にはコラボ限定の衣装も含まれます。"},
        { "location": "9/article" , "narrator": "", "text": "ポイントで獲得できる衣装"},
        { "location": "10/article", "narrator": "", "text": "ポーラーズメモリーIII"},
        { "location": "11/article", "narrator": "", "text": "（4人それぞれの衣装）"},
        { "location": "12/article", "narrator": "", "text": "ガチャの衣装特典"},
        { "location": "13/article", "narrator": "", "text": "同時開催の10連ガチャには衣装の特典があります。対象は次の3種類で、それぞれ4人分が用意されています。"},
        { "location": "14/article", "narrator": "", "text": "ポーラーズメモリーI"},
        { "location": "15/article", "narrator": "", "text": "だぼだぼフクー"},
        { "location": "16/article", "narrator": "", "text": "読書日和"},
        { "location": "17/article", "narrator": "", "text": "※10連の衣装特典に含まれるのは、この3種類です。"},
        { "location": "18/article", "narrator": "", "text": "新たに登場するSSRとSRのクランは各4体。いずれもイベントポイントの獲得を助けるスキルを持っています。"},
        { "location": "19/article", "narrator": "", "text": "交換所に並ぶ衣装"},
        { "location": "20/article", "narrator": "", "text": "イベントの開催期間には、コスチューム交換所でも次の4種類を取り扱います。各衣装は4人に対応しています。"},
        { "location": "21/article", "narrator": "", "text": "リーベルドレス"},
        { "location": "22/article", "narrator": "", "text": "月待灯"},
        { "location": "23/article", "narrator": "", "text": "エヴァンジェノマイズ"},
        { "location": "24/article", "narrator": "", "text": "ヒュムネステリオン"},
        { "location": "25/article", "narrator": "", "text": "ログインでもらえる衣装"},
        { "location": "26/article", "narrator": "", "text": "12/7(木)開始予定のログインボーナスでは、以下の衣装が4人分配布される予定です。"},
        { "location": "27/article", "narrator": "", "text": "ポーラーズメモリーII"}
    ]
}
