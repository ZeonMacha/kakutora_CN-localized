    "entry":
    [
        { "location": "1/chrome"  , "narrator": "", "text": "デイトラ！ | Daily Trinary"},
        { "location": "2/article" , "narrator": "", "text": "ちゃんねる神楽まであと8日！"},
        { "location": "3/article" , "narrator": "", "text": "CH.05アクティベートまであと8日となりました！"},
        { "location": "4/chrome"  , "narrator": "", "text": "ここではこれから0日目までの間、毎日カウントダウンをやっていく予定です。尚、デイトラ本文については、何か告知することがある日は語りますが、特に無い時は3行で終わる日もありますので予めご了承ください。"},
        { "location": "5/article" , "narrator": "", "text": "あと８日！"},
        { "location": "6/article" , "narrator": "", "text": "４日が２クールですよ！！"},
        { "location": "7/article" , "narrator": "", "text": "いよいよネタキレ感が半端なくなってきましたので、皆様からのご意見ご質問をお受け付け致すことにしました。気が向いたものに答える予定ですので、Twitterで「#デイトラ質問箱」というハッシュで投稿してみてください。"},
        { "location": "8/article" , "narrator": "", "text": "またこの質問箱にも未来ルール（※）は適用されます。"},
        { "location": "9/article" , "narrator": "", "text": "（※：原則未来の質問には回答しない、というルールです）"},
        { "location": "10/article", "narrator": "", "text": "今日の神楽さん"},
        { "location": "11/article", "narrator": "", "text": "※画面は開発中のものです。"},
        { "location": "12/article", "narrator": "", "text": "ちゃんねる神楽まであと9日！"},
        { "location": "13/article", "narrator": "", "text": "CH.05アクティベートまであと9日となりました！"},
        { "location": "14/article", "narrator": "", "text": "一桁になりましたね！"},
        { "location": "15/article", "narrator": "", "text": "残り期間が僅かになり、段々ドキドキしてきました（意味深）"},
        { "location": "16/article", "narrator": "", "text": "ちゃんねる神楽まであと10日！"},
        { "location": "17/article", "narrator": "", "text": "CH.05アクティベートまであと10日となりました！"},
        { "location": "18/article", "narrator": "", "text": "本日も開発スナップ貼りをしたいと思います。"},
        { "location": "19/article", "narrator": "", "text": "今日はひとつ、非日常のシーンでも。"},
        { "location": "20/article", "narrator": "", "text": "凛々しい神楽さんともあと１０日で逢えます！"},
        { "location": "21/article", "narrator": "", "text": "それでは、今日はこの辺で！"},
        { "location": "22/article", "narrator": "", "text": "と思いましたが、せっかくなので撮影失敗したのも置いておきますね。"}
    ]
}
