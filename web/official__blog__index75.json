{
    "dir": "official/blog/index75.html",
    "type": "web",
    "info": {
        "title": "デイトラ！ | Daily Trinary"
    },
    "entry":
    [
        { "location": "1/chrome"  , "narrator": "", "text": "デイトラ！ | Daily Trinary"},
        { "location": "2/article" , "narrator": "", "text": "よろしくね///"},
        { "location": "3/article" , "narrator": "", "text": "お題【自己紹介】 ガブリエラ編"},
        { "location": "4/article" , "narrator": "", "text": "その日は月が綺麗な夜でした。"},
        { "location": "5/article" , "narrator": "", "text": "光の中からやってきた妖精は、少女にこう言ったのです。"},
        { "location": "6/article" , "narrator": "", "text": "さあ、おいで。貴方の大切な人が、この先で待っているわ。"},
        { "location": "7/article" , "narrator": "", "text": "少女は途惑いながらも、期待に胸膨らませ"},
        { "location": "8/article" , "narrator": "", "text": "光の階段を昇っていきました。"},
        { "location": "9/article" , "narrator": "", "text": "はじめまして♪"},
        { "location": "10/article", "narrator": "", "text": "ガブリエラ・ロタルィンスカです。"},
        { "location": "11/article", "narrator": "", "text": "日本人にはちょっと発音しにくいみたい。"},
        { "location": "12/article", "narrator": "", "text": "私はポーランドから来ました。"},
        { "location": "13/article", "narrator": "", "text": "日本のことは昔から好きでしたけど、"},
        { "location": "14/article", "narrator": "", "text": "私がここに来たのは理由があってなの。"},
        { "location": "15/article", "narrator": "", "text": "トライナリーとしての資格があったから、"},
        { "location": "16/article", "narrator": "", "text": "情報管理庁に招待されたのよ？"},
        { "location": "17/article", "narrator": "", "text": "それに、銃の腕もあったのかもしれないわね。"},
        { "location": "18/article", "narrator": "", "text": "こう見えても、それなりに銃の腕はたつのよ？"},
        { "location": "19/article", "narrator": "", "text": "なんか、この前アーヤたちと行ったお祭りの写真が"},
        { "location": "20/article", "narrator": "", "text": "貼られてるけど、あの時もプライズ撃ち落としすぎて"},
        { "location": "21/article", "narrator": "", "text": "お店の人が困っちゃってちょっと可哀想だったの。"},
        { "location": "22/article", "narrator": "", "text": "ひとりで日本に来てるから、"},
        { "location": "23/article", "narrator": "", "text": "たまにちょっとだけ寂しい時もありますけど、"},
        { "location": "24/article", "narrator": "", "text": "アーヤたちがいるから平気。"},
        { "location": "25/article", "narrator": "", "text": "こうしてブログももらえたし、"},
        { "location": "26/article", "narrator": "", "text": "貴方とも沢山お話しできたらって思ってるわ。"},
        { "location": "27/article", "narrator": "", "text": "これからよろしくね///"},
        { "location": "28/article", "narrator": "", "text": "國政綾水です。よろしくお願いします！"},
        { "location": "29/article", "narrator": "", "text": "お題【自己紹介】 國政綾水編"},
        { "location": "30/article", "narrator": "", "text": "はじめまして、國政綾水です。"},
        { "location": "31/article", "narrator": "", "text": "ブログって実は書いた事なくて、いきなり変なことを書いちゃうかもしれないけど、その時は許してね(>_"},
        { "location": "32/article", "narrator": "", "text": "今、大学３年です。"},
        { "location": "33/article", "narrator": "", "text": "情報管理庁附属学園の教育学部に通ってます。"},
        { "location": "34/article", "narrator": "", "text": "学科は…今はひみつ、ってことで(^^;;"},
        { "location": "35/article", "narrator": "", "text": "趣味はバイクでツーリングするのとか、いろいろお裁縫したりとか、あとは、今はやってないけど剣道かな。"},
        { "location": "36/article", "narrator": "", "text": "剣道は高校の時までやっていて、ちょっと大きな大会で優勝したりもしたんだけどね(*^^*)"},
        { "location": "37/article", "narrator": "", "text": "写真は、前に作ったパペットの、あやみおねえさんです。"},
        { "location": "38/article", "narrator": "", "text": "って、なんか自分の人形を作るのって痛い人みたいだけど、これには事情があって…ヽ(´o｀；"},
        { "location": "39/article", "narrator": "", "text": "子供たちのためだから仕方なく、なの！"},
        { "location": "40/article", "narrator": "", "text": "こんな風にブログのページをいただいて、"},
        { "location": "41/article", "narrator": "", "text": "皆さんとお話しできる機会をいただいたので、"},
        { "location": "42/article", "narrator": "", "text": "これからもいろいろなことをお伝えしていきたいと思います！"},
        { "location": "43/article", "narrator": "", "text": "お暇でしたら、お付き合いくださいね(*^^"},
        { "location": "44/article", "narrator": "", "text": "はじめまして、逢瀬つばめです！"},
        { "location": "45/article", "narrator": "", "text": "お題【自己紹介】 逢瀬つばめ編"},
        { "location": "46/article", "narrator": "", "text": "なんか、突然ブログ書けー！っていう指示が来たので、書くことになりましたヾ(｡>﹏"},
        { "location": "47/article", "narrator": "", "text": "まずゎ自己紹介をしま～～～すヽ(*´∀｀)ノ"},
        { "location": "48/article", "narrator": "", "text": "逢瀬つばめ、今年で高校一年になりました～～:.ﾟヽ(´∀`｡)ﾉﾟ.:｡ ゜"},
        { "location": "49/article", "narrator": "", "text": "静岡に住んでるから、静岡の高校に入学しましたょ（あたりまぇだょね(´ｪ｀；)三(；´ｪ｀)"},
        { "location": "50/article", "narrator": "", "text": "じつゎ中学生のときって、ずっと入院してたから"},
        { "location": "51/article", "narrator": "", "text": "学校生活ってすっ～～～ごく久し振りで、"},
        { "location": "52/article", "narrator": "", "text": "ドキドキしてるんだょ～～(*´ω｀*)"},
        { "location": "53/article", "narrator": "", "text": "でも入学式の日に道まちがえて"},
        { "location": "54/article", "narrator": "", "text": "遅刻しちゃったのはひみつにしてくださぃ・゜・(ノД`)・゜・"},
        { "location": "55/article", "narrator": "", "text": "あ～～～～～～！！！ でも、でも、"},
        { "location": "56/article", "narrator": "", "text": "一緒にのっけてる写真みたいな"},
        { "location": "57/article", "narrator": "", "text": "道まちがえて北海道まで行っちゃったりは"},
        { "location": "58/article", "narrator": "", "text": "しないょ～～ヾ(｡>﹏"},
        { "location": "59/article", "narrator": "", "text": "だれだろ、こんな写真とったの(´・ω・`)"},
        { "location": "60/article", "narrator": "", "text": "あとすこしすると、ゴールデンウィークで、"},
        { "location": "61/article", "narrator": "", "text": "メノウちゃんのライブがあって、それが楽しみです！"},
        { "location": "62/article", "narrator": "", "text": "またお話しするね～～～╰(*´︶`*)╯"},
        { "location": "63/article", "narrator": "", "text": "ばぃばぃヽ(*´∀｀)ノ"}
    ]
}
