        { "location": "1/chrome"  , "narrator": "", "text": "拡張少女系トライナリー｜スマホアプリゲーム公式サイト"},
        { "location": "2/article" , "narrator": "", "text": "『拡張少女系トライナリー』の世界"},
        { "location": "3/article" , "narrator": "", "text": "2016年、首都圏に突如出現した巨大な繭。"},
        { "location": "4/article" , "narrator": "", "text": "初めて確認されてから数カ月たった現在もなお、その正体は何ひとつ判明しておらず、"},
        { "location": "5/article" , "narrator": "", "text": "人々はこの正体不明の繭をフェノメノンと呼んだ。"},
        { "location": "6/article" , "narrator": "", "text": "ただひとつわかっていることは、フェノメノンの内側に取り込まれた人々は狂い、"},
        { "location": "7/article" , "narrator": "", "text": "殺し合いを始めるようになってしまうことだった。"},
        { "location": "8/article" , "narrator": "", "text": "業を煮やした日本政府は、突発的に出現するフェノメノンを収束するべく、"},
        { "location": "9/article" , "narrator": "", "text": "特殊部隊を結成した。"},
        { "location": "10/article", "narrator": "", "text": "総務省情報管理庁管轄拡張現実特殊戦略隊群特別攻撃隊───"},
        { "location": "11/article", "narrator": "", "text": "またの名を拡張少女系トライナリー。"},
        { "location": "12/article", "narrator": "", "text": "用語集"},
        { "location": "13/article", "narrator": "", "text": "フェノメノン"},
        { "location": "14/article", "narrator": "", "text": "首都圏に出現するようになった謎の繭。そのなかにはクランと呼ばれる存在が形成した、まったく異なる世界が構築されている。"},
        { "location": "15/article", "narrator": "", "text": "クラン"},
        { "location": "16/article", "narrator": "", "text": "人間の潜在意識が独立し、世界に顕在化した存在。"},
        { "location": "17/article", "narrator": "", "text": "トライナリー"},
        { "location": "18/article", "narrator": "", "text": "トライガジェットという特殊な装置を扱う能力があり、フェノメノンを収束させる力を持つ少女たち。"},
        { "location": "19/chrome" , "narrator": "", "text": "東映アニメーション"},
        { "location": "20/chrome" , "narrator": "", "text": "ガストソーシャル"},
        { "location": "21/chrome" , "narrator": "", "text": "ガストちゃんTwitter"},
        { "location": "22/chrome" , "narrator": "", "text": "ガスト公式Facebook"},
