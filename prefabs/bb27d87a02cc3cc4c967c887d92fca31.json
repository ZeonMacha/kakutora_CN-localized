        { "location": "529/UI", "narrator": "ScreenFadeManager/Panel/Loading_TypeStart/Tutorial/DataLoading/ch01/Dialog_profile01/Panel/PicArea/LeftButton/TextCancel", "text": "キャンセル"},
        { "location": "531/UI", "narrator": "ScreenFadeManager/Panel/Loading_TypeStart/Tutorial/DataLoading/ch01/Dialog_profile01/Panel/PicArea/RightButton/TextOK", "text": "OK"},
        { "location": "533/UI", "narrator": "ScreenFadeManager/Panel/Loading_TypeStart/Tutorial/DataLoading/ch02/Dialog_profile02/Panel/Message", "text": "<b><color=#2670DA><size=40>國政綾水</size>(アーヤ)</color></b>\n<color=#2670DA><size=20>くにまさあやみ</size></color>\n\n２１歳(大学３年)\n誕生日:1994.9.14\n\n長野県出身。\n実家がド田舎の山中にある神社ということもあり、都会に憧れを持つ。責任感が強く、意志が固いリーダー肌の少女。\n\n<b><color=orange>【好きなもの】</color></b>\n武士の心得、精神統一\n哲学、子供、都会\n\n<b><color=blue>【苦手なもの】</color></b>\nだらしない人\n"},
        { "location": "535/UI", "narrator": "ScreenFadeManager/Panel/Loading_TypeStart/Tutorial/DataLoading/ch02/Dialog_profile02/Panel/Message/BackFace/Text", "text": "INFORMATION\n\nFROM  TRIGADGET"},
        { "location": "537/UI", "narrator": "ScreenFadeManager/Panel/Loading_TypeStart/Tutorial/DataLoading/ch02/Dialog_profile02/Panel/Message/TopBar/Text", "text": "PROFILE DATA 02"},
