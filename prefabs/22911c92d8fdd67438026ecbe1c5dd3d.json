        { "location": "685/UI", "narrator": "CuranStrengthningMenuCanvas3/Panel/Curan_Strengthning/Tutorial/TutorialCuran4A/Panel/Message", "text": "<color=green>【クラン強化合成】</color>では、\nクラン同士を合成して\n<color=red>クランのLvを上げる</color>ことができる。\n"},
        { "location": "686/UI", "narrator": "CuranStrengthningMenuCanvas3/Panel/Curan_Strengthning/Tutorial/TutorialCuran4A/Panel/PicArea/LeftButton/TextCancel", "text": "キャンセル"},
        { "location": "687/UI", "narrator": "CuranStrengthningMenuCanvas3/Panel/Curan_Strengthning/Tutorial/TutorialCuran4A/Panel/PicArea/RightButton/TextOK", "text": "OK"},
        { "location": "688/UI", "narrator": "CuranStrengthningMenuCanvas3/Panel/Curan_Strengthning/Tutorial/TutorialCuran4B/Panel/Message", "text": "このアイコンは<color=red>\n【強化するクラン】</color>を\n選ぶためのボタン。\n"},
        { "location": "689/UI", "narrator": "CuranStrengthningMenuCanvas3/Panel/Curan_Strengthning/Tutorial/TutorialCuran4B/Panel/PicArea/LeftButton/TextCancel", "text": "キャンセル"},
        { "location": "690/UI", "narrator": "CuranStrengthningMenuCanvas3/Panel/Curan_Strengthning/Tutorial/TutorialCuran4B/Panel/PicArea/RightButton/TextOK", "text": "OK"},
        { "location": "691/UI", "narrator": "CuranStrengthningMenuCanvas3/Panel/Curan_Strengthning/Tutorial/TutorialCuran4C/Panel/Message", "text": "こっちは<color=red>【強化の餌にするクラン】</color>を選ぶためのボタン。\n要は<color=blue>無くなってしまうほう</color>ね。\n大切な子を選んでしまわないように。\n"},
        { "location": "692/UI", "narrator": "CuranStrengthningMenuCanvas3/Panel/Curan_Strengthning/Tutorial/TutorialCuran4C/Panel/PicArea/LeftButton/TextCancel", "text": "キャンセル"},
        { "location": "693/UI", "narrator": "CuranStrengthningMenuCanvas3/Panel/Curan_Strengthning/Tutorial/TutorialCuran4C/Panel/PicArea/RightButton/TextOK", "text": "OK"},
        { "location": "694/UI", "narrator": "CuranStrengthningMenuCanvas3/Panel/Curan_Strengthning/Tutorial/TutorialCuran6A/Panel/Message", "text": "強化したいクランを選んだら\n次はこっちよ。\n<size=32><color=red>うっかり、ダメ。絶対。</color></size>\n"},
        { "location": "695/UI", "narrator": "CuranStrengthningMenuCanvas3/Panel/Curan_Strengthning/Tutorial/TutorialCuran6A/Panel/PicArea/LeftButton/TextCancel", "text": "キャンセル"},
        { "location": "696/UI", "narrator": "CuranStrengthningMenuCanvas3/Panel/Curan_Strengthning/Tutorial/TutorialCuran6A/Panel/PicArea/RightButton/TextOK", "text": "OK"},
        { "location": "697/UI", "narrator": "CuranStrengthningMenuCanvas3/Panel/Curan_Strengthning/Tutorial/TutorialCuran8A/Panel/Message", "text": "準備が終わったら<color=red>【強化合成する】</color>ボタンをタップしましょ。\nそれと、コインも消費するから。\n"},
        { "location": "698/UI", "narrator": "CuranStrengthningMenuCanvas3/Panel/Curan_Strengthning/Tutorial/TutorialCuran8A/Panel/PicArea/LeftButton/TextCancel", "text": "キャンセル"},
        { "location": "699/UI", "narrator": "CuranStrengthningMenuCanvas3/Panel/Curan_Strengthning/Tutorial/TutorialCuran8A/Panel/PicArea/RightButton/TextOK", "text": "OK"},
        { "location": "700/UI", "narrator": "CuranStrengthningMenuCanvas3/Panel/Curan_Strengthning/Tutorial/TutorialCuran8C/Panel/Message", "text": "これで強化は完了。\nクランは<color=red>【Lvが上がるほど強くなっていく】</color>から、気に入ったクランは\nどんどん強化してね。\n"},
        { "location": "701/UI", "narrator": "CuranStrengthningMenuCanvas3/Panel/Curan_Strengthning/Tutorial/TutorialCuran8C/Panel/PicArea/LeftButton/TextCancel", "text": "キャンセル"},
        { "location": "702/UI", "narrator": "CuranStrengthningMenuCanvas3/Panel/Curan_Strengthning/Tutorial/TutorialCuran8C/Panel/PicArea/RightButton/TextOK", "text": "OK"},
        { "location": "703/UI", "narrator": "CuranStrengthningMenuCanvas3/Panel/Curan_Strengthning/Tutorial/TutorialCuran8D/Panel/Message", "text": "どれだけ強化しても、\n装備しなければ宝の持ち腐れ。\n<color=red>【クラン編成】</color>でしっかり\n装備することを忘れないで。\n"},
        { "location": "704/UI", "narrator": "CuranStrengthningMenuCanvas3/Panel/Curan_Strengthning/Tutorial/TutorialCuran8D/Panel/PicArea/LeftButton/TextCancel", "text": "キャンセル"},
        { "location": "705/UI", "narrator": "CuranStrengthningMenuCanvas3/Panel/Curan_Strengthning/Tutorial/TutorialCuran8D/Panel/PicArea/RightButton/TextOK", "text": "OK"},
        { "location": "706/UI", "narrator": "CuranStrengthningMenuCanvas3/Panel/Curan_Strengthning/Tutorial/TutorialCuran8E/Panel/Message", "text": "強化合成はこれでおしまい。\nクランのLvがMaxになったら、\n次は<color=red>【進化合成】</color>の授業よ。\n"},
        { "location": "707/UI", "narrator": "CuranStrengthningMenuCanvas3/Panel/Curan_Strengthning/Tutorial/TutorialCuran8E/Panel/PicArea/LeftButton/TextCancel", "text": "キャンセル"},
        { "location": "708/UI", "narrator": "CuranStrengthningMenuCanvas3/Panel/Curan_Strengthning/Tutorial/TutorialCuran8E/Panel/PicArea/RightButton/TextOK", "text": "OK"},
        { "location": "709/UI", "narrator": "CuranStrengthningMenuCanvas3/Panel/Processing/Text", "text": "強化実行中"}
