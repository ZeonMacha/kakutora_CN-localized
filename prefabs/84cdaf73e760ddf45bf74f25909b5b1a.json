        { "location": "245/UI", "narrator": "GachaResultWindow_2/BG_Triangle/Kazari/ImageC/Text", "text": "Energy Quantization..."},
        { "location": "246/UI", "narrator": "GachaResultWindow_2/BG_Triangle/Kazari/MOMENTUM/Text", "text": "MOMENTUM,"},
