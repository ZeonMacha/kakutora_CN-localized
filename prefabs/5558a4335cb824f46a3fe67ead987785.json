        { "location": "371/UI", "narrator": "CuranEvolutionMenuCanvas/Panel/Curan_Evolution/Tutorial/TutorialCuran11A/Panel/PicArea/LeftButton/TextCancel", "text": "キャンセル"},
        { "location": "372/UI", "narrator": "CuranEvolutionMenuCanvas/Panel/Curan_Evolution/Tutorial/TutorialCuran11A/Panel/PicArea/RightButton/TextOK", "text": "OK"},
        { "location": "373/UI", "narrator": "CuranEvolutionMenuCanvas/Panel/Curan_Evolution/Tutorial/TutorialCuran11B/Panel/Message", "text": "それと、進化可能なクランは\n<color=red>Lvが最大になったクラン</color>だけ。\n進化が可能な回数にも限度が\nあることは覚えておいてね。\n"},
        { "location": "374/UI", "narrator": "CuranEvolutionMenuCanvas/Panel/Curan_Evolution/Tutorial/TutorialCuran11B/Panel/PicArea/LeftButton/TextCancel", "text": "キャンセル"},
        { "location": "375/UI", "narrator": "CuranEvolutionMenuCanvas/Panel/Curan_Evolution/Tutorial/TutorialCuran11B/Panel/PicArea/RightButton/TextOK", "text": "OK"},
        { "location": "376/UI", "narrator": "CuranEvolutionMenuCanvas/Panel/Curan_Evolution/Tutorial/TutorialCuran9A/Panel/Message", "text": "ただし、進化したクランは\nレアリティが\n上がる代わりに\n<color=red>Lvが1に戻る</color>から\n注意。\n"},
        { "location": "377/UI", "narrator": "CuranEvolutionMenuCanvas/Panel/Curan_Evolution/Tutorial/TutorialCuran9A/Panel/PicArea/LeftButton/TextCancel", "text": "キャンセル"},
        { "location": "378/UI", "narrator": "CuranEvolutionMenuCanvas/Panel/Curan_Evolution/Tutorial/TutorialCuran9A/Panel/PicArea/RightButton/TextOK", "text": "OK"},
        { "location": "379/UI", "narrator": "CuranEvolutionMenuCanvas/Panel/Curan_Evolution/Tutorial/TutorialCuran9B/Panel/Message", "text": "<color=green>【クラン進化合成】</color>では、\n<color=red>進化素材</color>を消費してクランを\n進化さ\nせることができる。\n"},
        { "location": "380/UI", "narrator": "CuranEvolutionMenuCanvas/Panel/Curan_Evolution/Tutorial/TutorialCuran9B/Panel/PicArea/LeftButton/TextCancel", "text": "キャンセル"},
