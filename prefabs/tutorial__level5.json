    [
        { "location": "4/UI" , "narrator": "TutorialCanvas/TutorialRoot/AssistSkillDialog/Desc", "text": "説明\n説明\n説明"},
        { "location": "5/UI" , "narrator": "TutorialCanvas/TutorialRoot/AssistSkillDialog/Title", "text": "スキル名"},
        { "location": "6/UI" , "narrator": "TutorialCanvas/TutorialRoot/Error/Text", "text": "ERROR\n"},
        { "location": "7/UI" , "narrator": "TutorialCanvas/TutorialRoot/Tutorial0/Panel/Message", "text": "相手がクランなら、こちらもクランで対抗。あなたは味方クランを従えることができるから、そのクランの力を借りて戦う。従えたクランを\n<color=red>【サーバントクラン】</color>と呼ぶの。"},
        { "location": "8/UI" , "narrator": "TutorialCanvas/TutorialRoot/Tutorial0/Panel/PicArea/LeftButton/TextCancel", "text": "キャンセル"},
        { "location": "9/UI" , "narrator": "TutorialCanvas/TutorialRoot/Tutorial0/Panel/PicArea/RightButton/TextOK", "text": "OK"},
        { "location": "10/UI", "narrator": "TutorialCanvas/TutorialRoot/Tutorial1A/Panel/Message", "text": "敵は待ってくれないから手短に。\n矢印が指しているキャラは装備しているサーバントクランで、簡単に言ってしまえば武器のようなもの。\nまずはこの5体を好きな順番でタップしてみて。"},
        { "location": "11/UI", "narrator": "TutorialCanvas/TutorialRoot/Tutorial1A/Panel/PicArea/LeftButton/TextCancel", "text": "キャンセル"},
        { "location": "12/UI", "narrator": "TutorialCanvas/TutorialRoot/Tutorial1A/Panel/PicArea/RightButton/TextOK", "text": "OK"},
        { "location": "13/UI", "narrator": "TutorialCanvas/TutorialRoot/Tutorial1B/Panel/Message", "text": "ここに<color=red>【攻撃した順番】</color>が記録\nされる。とても重要なので、\n次のターンでは注目してみて。"},
        { "location": "14/UI", "narrator": "TutorialCanvas/TutorialRoot/Tutorial1B/Panel/PicArea/LeftButton/TextCancel", "text": "キャンセル"},
        { "location": "15/UI", "narrator": "TutorialCanvas/TutorialRoot/Tutorial1B/Panel/PicArea/RightButton/TextOK", "text": "OK"},
        { "location": "16/UI", "narrator": "TutorialCanvas/TutorialRoot/Tutorial2A/Panel/Message", "text": "次は<color=red>【チェイン】</color>を教える。\n他にもパターンはあるけど、今回は\n　　アイコンのクランを<color=red>３体連続で</color>\nタップしつつ、4回攻撃してみて。\n"},
        { "location": "17/UI", "narrator": "TutorialCanvas/TutorialRoot/Tutorial2A/Panel/PicArea/LeftButton/TextCancel", "text": "キャンセル"},
        { "location": "18/UI", "narrator": "TutorialCanvas/TutorialRoot/Tutorial2A/Panel/PicArea/RightButton/TextOK", "text": "OK"},
        { "location": "19/UI", "narrator": "TutorialCanvas/TutorialRoot/Tutorial2B_1/Panel/Message", "text": "残念ながら失敗。\nもう一度、矢印のついているクランを３体続けてタップしてみて。\n"},
        { "location": "20/UI", "narrator": "TutorialCanvas/TutorialRoot/Tutorial2B_1/Panel/PicArea/LeftButton/TextCancel", "text": "キャンセル"},
        { "location": "21/UI", "narrator": "TutorialCanvas/TutorialRoot/Tutorial2B_1/Panel/PicArea/RightButton/TextOK", "text": "OK"},
        { "location": "22/UI", "narrator": "TutorialCanvas/TutorialRoot/Tutorial2B_2/Panel/Message", "text": "<color=red>【チェイン】</color>はアイコンの種類や\n並び順によって、様々に効果が\n変わる。\n"},
        { "location": "23/UI", "narrator": "TutorialCanvas/TutorialRoot/Tutorial2B_2/Panel/PicArea/LeftButton/TextCancel", "text": "キャンセル"},
        { "location": "24/UI", "narrator": "TutorialCanvas/TutorialRoot/Tutorial2B_2/Panel/PicArea/RightButton/TextOK", "text": "OK"},
        { "location": "25/UI", "narrator": "TutorialCanvas/TutorialRoot/Tutorial2C/Panel/Message", "text": "例えばこんな感じ。\n\n\n\n\n\n\n\n効果はアイコンによって様々。\n色んな並びを試してみて。\n"},
        { "location": "26/UI", "narrator": "TutorialCanvas/TutorialRoot/Tutorial2C/Panel/PicArea/LeftButton/TextCancel", "text": "キャンセル"},
        { "location": "27/UI", "narrator": "TutorialCanvas/TutorialRoot/Tutorial2C/Panel/PicArea/RightButton/TextOK", "text": "OK"},
        { "location": "28/UI", "narrator": "TutorialCanvas/TutorialRoot/Tutorial2C/Panel/backDeco/Text", "text": "３チェイン"},
        { "location": "29/UI", "narrator": "TutorialCanvas/TutorialRoot/Tutorial2C/Panel/backDeco/Text (1)", "text": "４チェイン"},
        { "location": "30/UI", "narrator": "TutorialCanvas/TutorialRoot/Tutorial2C/Panel/backDeco/Text (2)", "text": "２ペア"},
        { "location": "31/UI", "narrator": "TutorialCanvas/TutorialRoot/Tutorial2C/Panel/backDeco/Text (3)", "text": "３スタンス"},
        { "location": "32/UI", "narrator": "TutorialCanvas/TutorialRoot/Tutorial3A/Panel/Message", "text": "じゃあおさらい。\n自由にクランを選択していいから\n<color=red>【チェイン】</color>を作ってみて。"},
        { "location": "33/UI", "narrator": "TutorialCanvas/TutorialRoot/Tutorial3A/Panel/PicArea/LeftButton/TextCancel", "text": "キャンセル"},
        { "location": "34/UI", "narrator": "TutorialCanvas/TutorialRoot/Tutorial3A/Panel/PicArea/RightButton/TextOK", "text": "OK"},
        { "location": "35/UI", "narrator": "TutorialCanvas/TutorialRoot/Tutorial4A/Panel/Message", "text": "<color=blue>【ココロエナジー】</color>がたまって\n<color=red>【クランスキル】</color>が使えるように\nなった。早速使ってみる。\n"},
        { "location": "36/UI", "narrator": "TutorialCanvas/TutorialRoot/Tutorial4A/Panel/PicArea/LeftButton/TextCancel", "text": "キャンセル"},
        { "location": "37/UI", "narrator": "TutorialCanvas/TutorialRoot/Tutorial4A/Panel/PicArea/RightButton/TextOK", "text": "OK"},
        { "location": "38/UI", "narrator": "TutorialCanvas/TutorialRoot/Tutorial4B/Panel/Message", "text": "スキルは<color=red>【アイコンをタップ】</color>で\n選択、<color=blue>【スキルを使うボタン】</color>で\n決定する。やってみて。\n"},
        { "location": "39/UI", "narrator": "TutorialCanvas/TutorialRoot/Tutorial4B/Panel/PicArea/LeftButton/TextCancel", "text": "キャンセル"},
        { "location": "40/UI", "narrator": "TutorialCanvas/TutorialRoot/Tutorial4B/Panel/PicArea/RightButton/TextOK", "text": "OK"},
        { "location": "41/UI", "narrator": "TutorialCanvas/TutorialRoot/Tutorial4C/Panel/Message", "text": "スキルを使用すると\n<color=blue>【ココロエナジー】</color>を消費する。\n強力だけど、使いすぎに注意して。\n"},
        { "location": "42/UI", "narrator": "TutorialCanvas/TutorialRoot/Tutorial4C/Panel/PicArea/LeftButton/TextCancel", "text": "キャンセル"},
        { "location": "43/UI", "narrator": "TutorialCanvas/TutorialRoot/Tutorial4C/Panel/PicArea/RightButton/TextOK", "text": "OK"},
        { "location": "44/UI", "narrator": "TutorialCanvas/TutorialRoot/Tutorial4D/Panel/Message", "text": "スキルを選んだら今までと\n同じようにクランを選んで攻撃。\n<color=red>スキルを使いたくない時は、\n最初からクランを押せばいい。</color>"},
        { "location": "45/UI", "narrator": "TutorialCanvas/TutorialRoot/Tutorial4D/Panel/PicArea/LeftButton/TextCancel", "text": "キャンセル"},
        { "location": "46/UI", "narrator": "TutorialCanvas/TutorialRoot/Tutorial4D/Panel/PicArea/RightButton/TextOK", "text": "OK"},
        { "location": "47/UI", "narrator": "TutorialCanvas/TutorialRoot/Tutorial4E/Panel/Message", "text": "<size=33><b><color=green>これでひとまず説明は終了。</color></b></size>\nさぁ、一気に勝負を決めましょう。\nチェインを忘れずにね。"},
        { "location": "48/UI", "narrator": "TutorialCanvas/TutorialRoot/Tutorial4E/Panel/PicArea/LeftButton/TextCancel", "text": "キャンセル"},
        { "location": "49/UI", "narrator": "TutorialCanvas/TutorialRoot/Tutorial4E/Panel/PicArea/RightButton/TextOK", "text": "OK"},
        { "location": "50/UI", "narrator": "TutorialCanvas/TutorialRoot/Tutorial6A/Panel/Message", "text": "クランと敵は<color=red>【喜怒哀楽の属性】</color>を\n持っている。\n\n"},
        { "location": "51/UI", "narrator": "TutorialCanvas/TutorialRoot/Tutorial6A/Panel/PicArea/LeftButton/TextCancel", "text": "キャンセル"},
        { "location": "52/UI", "narrator": "TutorialCanvas/TutorialRoot/Tutorial6A/Panel/PicArea/RightButton/TextOK", "text": "OK"},
        { "location": "53/UI", "narrator": "TutorialCanvas/TutorialRoot/Tutorial6B/Panel/Message", "text": "これが属性の優劣関係。\n\n一番上の　　　が敵の今の属性。\n\nこれに一番効くのは　　　。\nつまりそういうこと。\n"},
        { "location": "54/UI", "narrator": "TutorialCanvas/TutorialRoot/Tutorial6B/Panel/PicArea/LeftButton/TextCancel", "text": "キャンセル"},
        { "location": "55/UI", "narrator": "TutorialCanvas/TutorialRoot/Tutorial6B/Panel/PicArea/RightButton/TextOK", "text": "OK"},
        { "location": "56/UI", "narrator": "TutorialCanvas/TutorialRoot/Tutorial7A/Panel/Message", "text": "ココロエナジーが1目盛り以上\n貯まっていると、\n<color=red>【フルボッコアタック】</color>が使える。\n\nココロエナジーを全部使うけど、\n大ダメージを与えることが可能。\n貯めたエナジーをスキルに使うか\nフルボッコアタックに使うかは\nあなた次第。"},
        { "location": "57/UI", "narrator": "TutorialCanvas/TutorialRoot/Tutorial7A/Panel/PicArea/LeftButton/TextCancel", "text": "キャンセル"},
        { "location": "58/UI", "narrator": "TutorialCanvas/TutorialRoot/Tutorial7A/Panel/PicArea/RightButton/TextOK", "text": "OK"},
        { "location": "59/UI", "narrator": "TutorialCanvas/TutorialRoot/Tutorial9A/Panel/Message", "text": "トライナリーが<b>ココロスフィアで\n着ているコスチューム</b>に応じて、\n<color=red>【アシスト効果】</color>が発生する。\n\n効果は自動で発揮される仕組み。\n色んなコスチュームを試してみて。"},
        { "location": "60/UI", "narrator": "TutorialCanvas/TutorialRoot/Tutorial9A/Panel/PicArea/LeftButton/TextCancel", "text": "キャンセル"},
        { "location": "61/UI", "narrator": "TutorialCanvas/TutorialRoot/Tutorial9A/Panel/PicArea/RightButton/TextOK", "text": "OK"}
    ]
}
