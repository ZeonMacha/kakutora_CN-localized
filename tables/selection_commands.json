        { "location": "10849/param1", "narrator": "", "text": "何度も練習していたの"},
        { "location": "10850/param1", "narrator": "", "text": "その先のこと"},
        { "location": "11208/param1", "narrator": "", "text": "わたしのいる世界"},
        { "location": "11209/param1", "narrator": "", "text": "どんな天気もいい天気"},
        { "location": "11717/param1", "narrator": "", "text": "お手紙の中身はね"},
        { "location": "12430/param1", "narrator": "", "text": "いつかきっと、そしてずっと"},
        { "location": "12856/param1", "narrator": "", "text": "語呂合わせ"},
        { "location": "12932/param1", "narrator": "", "text": "甘くてもいいかしら"},
        { "location": "14044/param1", "narrator": "", "text": "わかってないわね"},
