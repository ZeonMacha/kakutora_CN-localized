        { "location": "1/skill"   , "narrator": "", "text": "適応力？？\n\n"},
        { "location": "1/other"   , "narrator": "", "text": "\nいちご、フレイメノウ、\n可愛い服、鯛焼き\n\n病院、薬、痛いこと\n"},
        { "location": "1/birthday", "narrator": "", "text": "2000年6月7日"},
        { "location": "1/hobby"   , "narrator": "", "text": "今までずっと病院にいたから\n楽しい事をあまり知らない。\n"},
        { "location": "2/skill"   , "narrator": "", "text": "剣道、武士道（真剣も扱う）\n鍋料理を作る\n"},
        { "location": "2/other"   , "narrator": "", "text": "\n武士の心得、精神統一\n哲学、子供、都会\n\nだらしない人\n"},
        { "location": "2/birthday", "narrator": "", "text": "1994年9月14日"},
        { "location": "2/hobby"   , "narrator": "", "text": "ツーリング（バイク）\n一人旅、人形作り、洋裁\n"},
        { "location": "3/skill"   , "narrator": "", "text": "射撃、スナイパー、ポーランド\n料理、香辛料を見分ける\n"},
        { "location": "3/other"   , "narrator": "", "text": "\nたこ焼き、日本文化、銃\nプラツキジェムニャチャーネ\n\n後ろに立たれること\n"},
        { "location": "3/birthday", "narrator": "", "text": "2001年10月13日"},
        { "location": "3/hobby"   , "narrator": "", "text": "日本らしいものを集めること\n日本のサブカルチャー\n"},
        { "location": "4/skill"   , "narrator": "", "text": "プログラミング、人の気持ちを\n察する、懐石料理を作る\n"},
        { "location": "4/other"   , "narrator": "", "text": "\n洋菓子、ＰＣ魔改造、温泉\n一人で久里浜線に乗る\n\n片付け\n"},
        { "location": "4/birthday", "narrator": "", "text": "1998年7月27日"},
        { "location": "4/hobby"   , "narrator": "", "text": "ネトゲ、情報収集\nサーバー構築、侵入\n"},
        { "location": "5/skill"   , "narrator": "", "text": "歌って踊れる\n役になりきれる\n"},
        { "location": "5/other"   , "narrator": "", "text": "\n和菓子、カフェ、魔法少女\n森ガール系のデザイン\n\n掃除、運命\n"},
        { "location": "5/birthday", "narrator": "", "text": "2000年12月9日"},
        { "location": "5/hobby"   , "narrator": "", "text": "ラノベ、アニメを見る\n（特に中二成分多めのもの）\n"}
    ]
}
