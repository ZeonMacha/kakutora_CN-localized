        { "location": "3427/SCENARIO", "narrator": "", "text": "バフバフバフバフ"},
        { "location": "3452/TALK"    , "narrator": "神楽", "text": "補助魔法ってさー"},
        { "location": "3453/TALK"    , "narrator": "神楽", "text": "パーティ組むことが前提じゃないですかー"},
        { "location": "3455/SEL"     , "narrator": "", "text": "まあ確かに"},
        { "location": "3456/SEL"     , "narrator": "", "text": "ソロプレイだとむなしいよね"},
        { "location": "3457/SEL"     , "narrator": "", "text": "$me$が全力で神楽を補助するよ！"},
        { "location": "3458/ACT"     , "narrator": "", "text": "まあ確かに"},
        { "location": "3459/TALK"    , "narrator": "神楽", "text": "な"},
        { "location": "3460/ACT"     , "narrator": "", "text": "ソロプレイだとむなしいよね"},
        { "location": "3461/TALK"    , "narrator": "神楽", "text": "反応遅れるし"},
        { "location": "3462/ACT"     , "narrator": "", "text": "$me$が全力で神楽を補助するよ！"},
        { "location": "3464/TALK"    , "narrator": "神楽", "text": "補助要員ゲットだぜ！！！"},
        { "location": "3466/TALK"    , "narrator": "神楽", "text": "これで攻略が楽になるわー"},
        { "location": "3467/TALK"    , "narrator": "神楽", "text": "助かるー"},
        { "location": "3469/TALK"    , "narrator": "神楽", "text": "ネトゲだと狩りだ祭りだー！！！って時しか使えなくない？"},
        { "location": "3471/SEL"     , "narrator": "", "text": "本来そういうものだしね"},
        { "location": "3472/SEL"     , "narrator": "", "text": "コンシューマでいいの教えようか？"},
        { "location": "3473/SEL"     , "narrator": "", "text": "二人きりで抜け出しちゃお？"},
        { "location": "3474/ACT"     , "narrator": "", "text": "本来そういうものだしね"},
        { "location": "3475/TALK"    , "narrator": "神楽", "text": "あーねー"},
        { "location": "3476/TALK"    , "narrator": "神楽", "text": "そうなんだけどねー"},
        { "location": "3477/ACT"     , "narrator": "", "text": "コンシューマでいいの教えようか？"},
        { "location": "3478/TALK"    , "narrator": "神楽", "text": "ネット対戦とかないやつでってこと？"},
        { "location": "3479/TALK"    , "narrator": "神楽", "text": "一応考えとく"},
        { "location": "3480/ACT"     , "narrator": "", "text": "二人きりで抜け出しちゃお？"},
        { "location": "3482/TALK"    , "narrator": "神楽", "text": "一見リア充な台詞ｗｗｗｗｗ"},
        { "location": "3483/TALK"    , "narrator": "神楽", "text": "たまらんｗｗｗｗ"},
        { "location": "3486/TALK"    , "narrator": "神楽", "text": "リアルにも欲しいよね補助魔法"},
        { "location": "3487/TALK"    , "narrator": "神楽", "text": "メイドとかナースとかにかけてもらいたーい！！！"},
        { "location": "3488/TALK"    , "narrator": "神楽", "text": "あっやっぱりパーティメンバー必要なやつだこれ"},
        { "location": "3489/TALK"    , "narrator": "神楽", "text": "納得ー！"}
