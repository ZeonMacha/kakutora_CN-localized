    "entry":
    [
        { "location": "152/SCENARIO", "narrator": "", "text": "000_魔女の言い分"},
        { "location": "177/TALK"    , "narrator": "ガブリエラ", "text": "神楽ちょっと"},
        { "location": "178/TALK"    , "narrator": "ガブリエラ", "text": "魔女みたいだったわ"},
        { "location": "180/SEL"     , "narrator": "", "text": "へー"},
        { "location": "181/SEL"     , "narrator": "", "text": "カッコいい"},
        { "location": "182/SEL"     , "narrator": "", "text": "怖いって思ったのかな"},
        { "location": "183/ACT"     , "narrator": "", "text": "へー"},
        { "location": "184/TALK"    , "narrator": "ガブリエラ", "text": "あんまり"},
        { "location": "185/TALK"    , "narrator": "ガブリエラ", "text": "ピンときてないみたいね"},
        { "location": "186/ACT"     , "narrator": "", "text": "カッコいい"},
        { "location": "187/TALK"    , "narrator": "ガブリエラ", "text": "ええと"},
        { "location": "189/TALK"    , "narrator": "ガブリエラ", "text": "そういうのとはちょっと違ってて"},
        { "location": "190/ACT"     , "narrator": "", "text": "怖いって思ったのかな"},
        { "location": "192/TALK"    , "narrator": "ガブリエラ", "text": "あ"},
        { "location": "193/TALK"    , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "194/TALK"    , "narrator": "ガブリエラ", "text": "ちょっと"},
        { "location": "196/TALK"    , "narrator": "ガブリエラ", "text": "怖かったのね"},
        { "location": "198/TALK"    , "narrator": "ガブリエラ", "text": "こっちは事情も分からないし"},
        { "location": "199/TALK"    , "narrator": "ガブリエラ", "text": "何ていうのかしら"},
        { "location": "200/TALK"    , "narrator": "ガブリエラ", "text": "わけがわからなくて"},
        { "location": "203/SEL"     , "narrator": "", "text": "不思議ちゃんってこと？"},
        { "location": "204/SEL"     , "narrator": "", "text": "他人は理解できないよ"},
        { "location": "205/SEL"     , "narrator": "", "text": "でもガブはちゃんとわかってあげたいんだね"},
        { "location": "206/ACT"     , "narrator": "", "text": "不思議ちゃんってこと？"},
        { "location": "208/TALK"    , "narrator": "ガブリエラ", "text": "それは"},
        { "location": "209/TALK"    , "narrator": "ガブリエラ", "text": "どっちかっていうとみやびのことね"},
        { "location": "210/ACT"     , "narrator": "", "text": "他人は理解できないよ"},
        { "location": "212/TALK"    , "narrator": "ガブリエラ", "text": "そういうものかも"},
        { "location": "213/TALK"    , "narrator": "ガブリエラ", "text": "しれないけども"},
        { "location": "214/ACT"     , "narrator": "", "text": "でもガブはちゃんとわかってあげたいんだね"},
        { "location": "217/TALK"    , "narrator": "ガブリエラ", "text": "それは"},
        { "location": "218/TALK"    , "narrator": "ガブリエラ", "text": "一応ね"},
        { "location": "219/TALK"    , "narrator": "ガブリエラ", "text": "仲間だもの"},
        { "location": "222/TALK"    , "narrator": "ガブリエラ", "text": "私、神楽に腹を立ててしまったのよ"},
        { "location": "223/TALK"    , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "224/TALK"    , "narrator": "ガブリエラ", "text": "神楽にも言えない事情があったのかもしれないわ"},
        { "location": "225/TALK"    , "narrator": "ガブリエラ", "text": "そう思って"},
        { "location": "227/TALK"    , "narrator": "ガブリエラ", "text": "反省しているの"}
    ]
}
