    "entry":
    [
        { "location": "6/SCENARIO", "narrator": "", "text": "【導入】播磨屋藤治郎"},
        { "location": "12/DIALOG" , "narrator": "", "text": "<size=40>CURAN STORY. 04</size>\nMIYABI KOIGASAKI\n\n<size=45>播磨屋藤治郎</size>\n<size=35>～べらんめぇだよお父ちゃん～</size>"},
        { "location": "28/TALK"   , "narrator": "みやび", "text": "ああ。\n来たかよ、\n$handle$。"},
        { "location": "29/TALK"   , "narrator": "みやび", "text": "ここは、うちら\nトライナリーと、\nクランたちとの交差点。"},
        { "location": "30/TALK"   , "narrator": "みやび", "text": "ココロとココロが\n出逢うて、共鳴して、\n繋がりあう場所ぞね。"},
        { "location": "38/SEL"    , "narrator": "（選択肢）", "text": "概要説明を飛ばす"},
        { "location": "39/SEL"    , "narrator": "（選択肢）", "text": "もう一度聞く"},
        { "location": "40/ACT"    , "narrator": "", "text": "概要説明を飛ばす"},
        { "location": "41/TALK"   , "narrator": "みやび", "text": "ほんだら早速\n今回のクランを\n紹介するぞね。"},
        { "location": "43/ACT"    , "narrator": "", "text": "もう一度聞く"},
        { "location": "48/TALK"   , "narrator": "みやび", "text": "ここでは、普段私たちを\n助けてくれるサーバント\nクランを紹介するきね。"},
        { "location": "49/TALK"   , "narrator": "みやび", "text": "ほんで、おんしが直接\nやつらぁと繋がれる\nよう、手続きしちゅうき。"},
        { "location": "50/SEL"    , "narrator": "（選択肢）", "text": "アニメのクランが使えるようになるの？"},
        { "location": "51/ACT"    , "narrator": "", "text": "アニメのクランが使えるようになるの？"},
        { "location": "53/TALK"   , "narrator": "みやび", "text": "やねえ。\n簡単に言えば、\nやけんど。"},
        { "location": "54/TALK"   , "narrator": "みやび", "text": "このセクターでは、\nクラン一人にスポットを\n当てて紹介するきね。"},
        { "location": "55/TALK"   , "narrator": "みやび", "text": "ほんで【儀式】によって\nおんしとココロを繋げちゃ\nろう。"},
        { "location": "56/TALK"   , "narrator": "みやび", "text": "【儀式】には『コネクト』\nと『シンクロ』の２つが\nあるぞね。"},
        { "location": "58/TALK"   , "narrator": "みやび", "text": "『コネクト』は、おんしと\nクランが物理的に繋がる\nための儀式。"},
        { "location": "59/TALK"   , "narrator": "みやび", "text": "バトルしておんしの中に\nある、抵抗勢力を無力化\nするのに必要ぞね。"},
        { "location": "61/TALK"   , "narrator": "みやび", "text": "次の『シンクロ』では、\nクランの過去を知り、\n共感せんといかんねえ。"},
        { "location": "62/TALK"   , "narrator": "みやび", "text": "クランの過去の\n物語をシェアすることで、\n心が通じるようになるき。"},
        { "location": "64/TALK"   , "narrator": "みやび", "text": "ここまで、\nわかりゆう？"},
        { "location": "65/TALK"   , "narrator": "みやび", "text": "もし、入るセクターを\n間違えたんやったら\n退場できるけんど。"},
        { "location": "66/SEL"    , "narrator": "（選択肢）", "text": "いや、先に進む"},
        { "location": "67/SEL"    , "narrator": "（選択肢）", "text": "今回はやめとく"},
        { "location": "68/SEL"    , "narrator": "（選択肢）", "text": "みやびは別人格ないの？"},
        { "location": "69/ACT"    , "narrator": "", "text": "いや、先に進む"},
        { "location": "70/TALK"   , "narrator": "みやび", "text": "ええかね？\nほいたら早速、今回の\nクランを紹介するきね。"},
        { "location": "71/ACT"    , "narrator": "", "text": "今回はやめとく"},
        { "location": "72/TALK"   , "narrator": "みやび", "text": "ほう\nそうかよ。"},
        { "location": "73/TALK"   , "narrator": "みやび", "text": "そういたら、ここで\nさようならやねえ。"},
        { "location": "75/TALK"   , "narrator": "みやび", "text": "また気が向いたら\n来たらええき。"},
        { "location": "76/TALK"   , "narrator": "みやび", "text": "$handle$と\nうちに、\n素敵なココロの旅を。"},
        { "location": "78/ACT"    , "narrator": "", "text": "みやびは別人格ないの？"},
        { "location": "79/TALK"   , "narrator": "みやび", "text": "何を言い出すか\n思うたら。"},
        { "location": "81/TALK"   , "narrator": "みやび", "text": "そういうのは\nゲームの世界観を\n崩すきねえ。"},
        { "location": "82/TALK"   , "narrator": "みやび", "text": "そもそもうちは\n裏も表もない\n真っ正直な人間やき。"},
        { "location": "83/TALK"   , "narrator": "みやび", "text": "あえてのキャラ作りは\n必要ない思うちや。"},
        { "location": "84/TALK"   , "narrator": "みやび", "text": "そういうことで\nええかね？"},
        { "location": "85/TALK"   , "narrator": "みやび", "text": "そういうことで今回の\nクランを紹介するきね。"},
        { "location": "94/TALK"   , "narrator": "みやび", "text": "オープンプロセス、\n0x9FE番地から\n0xFFF番地へ。"},
        { "location": "95/TALK"   , "narrator": "みやび", "text": "共通意識野を経由、\n外部スフィアへ接続。"},
        { "location": "96/TALK"   , "narrator": "みやび", "text": "EXEC_SEEK_SECTOR\n=>Link() EXT_SPHERE/."},
        { "location": "121/TALK"  , "narrator": "みやび", "text": "シーク完了ぞね。"},
        { "location": "122/TALK"  , "narrator": "みやび", "text": "さて――。"},
        { "location": "124/TALK"  , "narrator": "みやび", "text": "今回、おんしに\n紹介するクランは\n<color=red>【播磨屋藤治郎】</color>。"},
        { "location": "126/TALK"  , "narrator": "みやび", "text": "本名を播磨藤治郎、\n５４歳。クラン通称は\n【とうちゃん】。"},
        { "location": "127/TALK"  , "narrator": "みやび", "text": "大田区の自宅敷地内の\n工場で発症。"},
        { "location": "128/TALK"  , "narrator": "みやび", "text": "ココロファイルナンバー\nE04-055-13によれば、\n今回の発症の原因は……"},
        { "location": "129/TALK"  , "narrator": "みやび", "text": "大型すぎる\n親子げんかぞね。"},
        { "location": "130/TALK"  , "narrator": "みやび", "text": "子供四人対とうちゃん。\n喧嘩の原因は\n会社の赤字。"},
        { "location": "131/TALK"  , "narrator": "みやび", "text": "子供らあは学費どころか\n進学も怪しくなったことで\nとうちゃんを責めた。"},
        { "location": "132/TALK"  , "narrator": "みやび", "text": "とはいえ真面目に\n働いてなかった\nわけやない。"},
        { "location": "133/TALK"  , "narrator": "みやび", "text": "むしろ真面目すぎて\n法改正その他に\n対処できなんだ。"},
        { "location": "134/TALK"  , "narrator": "みやび", "text": "……職人気質が\nあだになったちや。"},
        { "location": "135/TALK"  , "narrator": "みやび", "text": "…こう言うたら\n子供らあには\n悪いけんど。"},
        { "location": "136/TALK"  , "narrator": "みやび", "text": "とうちゃんの仕事は\n誇れる仕事やと\n言うちゃったら。"},
        { "location": "137/TALK"  , "narrator": "みやび", "text": "とうちゃんはまだ\n一家の大黒柱\nやったん違うかね。"},
        { "location": "138/TALK"  , "narrator": "みやび", "text": "一番コネクトしちゅう\nうちが言うことや\nないけんど。"},
        { "location": "139/SEL"   , "narrator": "（選択肢）", "text": "一番相性がいいってこと？"},
        { "location": "140/SEL"   , "narrator": "（選択肢）", "text": "とうちゃんのこと気に入ってるの？"},
        { "location": "141/ACT"   , "narrator": "", "text": "一番相性がいいってこと？"},
        { "location": "142/ACT"   , "narrator": "", "text": "とうちゃんのこと気に入ってるの？"},
        { "location": "144/TALK"  , "narrator": "みやび", "text": "そうやね。"},
        { "location": "145/TALK"  , "narrator": "みやび", "text": "ここでは、クランと一番\n相性がえいトライナリーが\n語ることになっちゅう。"},
        { "location": "146/TALK"  , "narrator": "みやび", "text": "今回の「とうちゃん」は\nうちが一番共感できた\nちうことになるき。"},
        { "location": "147/TALK"  , "narrator": "みやび", "text": "別のクランは\n別のメンバーが\n語るろうね。"},
        { "location": "148/SEL"   , "narrator": "（選択肢）", "text": "とうちゃんに共感したんだ…"},
        { "location": "149/ACT"   , "narrator": "", "text": "とうちゃんに共感したんだ…"},
        { "location": "151/TALK"  , "narrator": "みやび", "text": "そうやね。"},
        { "location": "152/TALK"  , "narrator": "みやび", "text": "$handle$も\nとうちゃんと精神を共有\nできたら共感するろう。"},
        { "location": "153/TALK"  , "narrator": "みやび", "text": "やき、まずは\nとうちゃんとの精神\n共有したらええき。"},
        { "location": "154/SEL"   , "narrator": "（選択肢）", "text": "とうちゃんと精神を共有するのか…"},
        { "location": "155/ACT"   , "narrator": "", "text": "とうちゃんと精神を共有するのか…"},
        { "location": "157/TALK"  , "narrator": "みやび", "text": "そうやね。\nまずは『コネクト』の\nプロセスをせんとね。"},
        { "location": "158/TALK"  , "narrator": "みやび", "text": "具体的には、\nとうちゃんの抵抗する\n意志と戦わんといかんき。"},
        { "location": "159/TALK"  , "narrator": "みやび", "text": "それが終わったら、\nとうちゃんの話を\nこじゃんと聞きゆう。"},
        { "location": "160/TALK"  , "narrator": "みやび", "text": "$handle$が\nそれを共有したら\n『シンクロ』完了やき。"},
        { "location": "161/TALK"  , "narrator": "みやび", "text": "『コネクト』『シンクロ』\n両方完了したら\n終了や。"},
        { "location": "162/SEL"   , "narrator": "（選択肢）", "text": "そしたら【とうちゃん】が使えるの？"},
        { "location": "163/ACT"   , "narrator": "", "text": "そしたら【とうちゃん】が使えるの？"},
        { "location": "165/TALK"  , "narrator": "みやび", "text": "そういうことに\nなるねえ。"},
        { "location": "166/TALK"  , "narrator": "みやび", "text": "しかも特別に\nうちのことも\n教えちゃろう。"},
        { "location": "167/TALK"  , "narrator": "みやび", "text": "やき、『シンクロ』\nまで完了した方が\nお得ぞね。"},
        { "location": "168/TALK"  , "narrator": "みやび", "text": "ほいたら早速、\nとうちゃんの世界に\nアクセスするき。"},
        { "location": "170/TALK"  , "narrator": "みやび", "text": "$handle$と\nうちととうちゃんに、\n素敵なココロの旅を！"}
    ]
}
