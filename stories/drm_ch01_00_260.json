        "title": "らぶとーく 第26話",
        "sub_title": "恋人の条件"
    },
    "entry":
    [
        { "location": "219/SCENARIO", "narrator": "", "text": "恋人の条件"},
        { "location": "236/TALK"    , "narrator": "つばめ", "text": "ごめんね、ひなこちゃん。\n何度も相談に乗って\nもらって…。"},
        { "location": "238/TALK"    , "narrator": "雛", "text": "ううん、気にしないでー。"},
        { "location": "239/TALK"    , "narrator": "雛", "text": "っていうか、ここまで\n関わったら――"},
        { "location": "240/TALK"    , "narrator": "雛", "text": "途中で投げ出すなんて\nできないって。"},
        { "location": "241/TALK"    , "narrator": "つばめ", "text": "…本当にありがと。"},
        { "location": "242/TALK"    , "narrator": "雛", "text": "それで…どう？"},
        { "location": "243/TALK"    , "narrator": "雛", "text": "あれから少しは考えが\nまとまった？"},
        { "location": "245/TALK"    , "narrator": "つばめ", "text": "うーん…。"},
        { "location": "247/TALK"    , "narrator": "つばめ", "text": "とりあえず、ツンデレに\nなるのは間違い、って\nいうのはわかったかな？"},
        { "location": "248/TALK"    , "narrator": "雛", "text": "…ぜ、前進してるって\n思っていいのかなー？"},
        { "location": "249/TALK"    , "narrator": "つばめ", "text": "どうなのかな？"},
        { "location": "250/TALK"    , "narrator": "つばめ", "text": "でも、それ以外は\nさっぱりわからないの。"},
        { "location": "251/TALK"    , "narrator": "つばめ", "text": "そもそもの話、\n何を考えればいいのかが\nわからないし…。"},
        { "location": "252/TALK"    , "narrator": "雛", "text": "あ、あはは…。\nそっかぁ、そこからかー。"},
        { "location": "253/TALK"    , "narrator": "つばめ", "text": "やっぱり、何度考えても\n好きって思うんだけど――"},
        { "location": "255/TALK"    , "narrator": "つばめ", "text": "でも、この好きは恋とは\n違う好きで――"},
        { "location": "256/TALK"    , "narrator": "つばめ", "text": "でも恋も好きってことに\n変わりはなくて――"},
        { "location": "257/TALK"    , "narrator": "つばめ", "text": "うーん…。"},
        { "location": "258/TALK"    , "narrator": "雛", "text": "…真剣なんだね。"},
        { "location": "261/TALK"    , "narrator": "つばめ", "text": "でも、いくら真剣でも\n全然わからないの。"},
        { "location": "263/TALK"    , "narrator": "つばめ", "text": "もしかして、わたしには\n一生理解できないのかな？"},
        { "location": "264/TALK"    , "narrator": "雛", "text": "ダメだよつばめちゃん！\n弱気になったら\nそこで終わりだよ！？"},
        { "location": "267/TALK"    , "narrator": "つばめ", "text": "そ、そうかもしれない\nけど、でも…。"},
        { "location": "268/TALK"    , "narrator": "雛", "text": "…それじゃあ、ちょっと\n考え方を変えてみよっか？"},
        { "location": "269/TALK"    , "narrator": "雛", "text": "つばめちゃんはさ、\n恋人になる人に対して――"},
        { "location": "270/TALK"    , "narrator": "雛", "text": "どういう条件が必要だと\n思ってる？"},
        { "location": "272/TALK"    , "narrator": "つばめ", "text": "条件？"},
        { "location": "273/TALK"    , "narrator": "雛", "text": "うん、恋人の条件。"},
        { "location": "274/TALK"    , "narrator": "雛", "text": "そういうの、何かしら\nあるでしょ？"},
        { "location": "275/TALK"    , "narrator": "つばめ", "text": "うーん、条件かぁ…。"},
        { "location": "276/TALK"    , "narrator": "雛", "text": "…わからないなら、\nちょっと検索でも\nしてみなよ。"},
        { "location": "277/TALK"    , "narrator": "雛", "text": "この手の話は、ネットに\nゴロゴロ転がってるよー。"},
        { "location": "278/TALK"    , "narrator": "つばめ", "text": "う、うん…。"},
        { "location": "280/TALK"    , "narrator": "つばめ", "text": "…でも、それだったら\n$handle$さんに聞いて\nみようかな？"},
        { "location": "292/TALK"    , "narrator": "つばめ", "text": "$handle$さんヽ(*´∀｀*)ﾉ"},
        { "location": "293/TALK"    , "narrator": "つばめ", "text": "ちょっと聞きたぃんだけど"},
        { "location": "294/TALK"    , "narrator": "つばめ", "text": "恋人の条件ってなんだろぅ？(ﾟ∀ﾟ人)"},
        { "location": "296/SEL"     , "narrator": "", "text": "それを$me$に聞かれても"},
        { "location": "297/SEL"     , "narrator": "", "text": "特別かどうかってことかな"},
        { "location": "298/SEL"     , "narrator": "", "text": "ときめきがあるかどうかかな"},
        { "location": "299/ACT"     , "narrator": "", "text": "それを$me$に聞かれても"},
        { "location": "300/TALK"    , "narrator": "つばめ", "text": "ぁ(ﾟ△ﾟ;ﾉ)ﾉ"},
        { "location": "302/TALK"    , "narrator": "つばめ", "text": "そぅだよね"},
        { "location": "304/TALK"    , "narrator": "つばめ", "text": "$handle$さんに求める条件なんだから"},
        { "location": "305/TALK"    , "narrator": "つばめ", "text": "$handle$さんに聞くのは変だよね(/ω＼)(/ω＼)ﾊｽﾞｶｼｰｨ"},
        { "location": "307/TALK"    , "narrator": "つばめ", "text": "難しぃなぁ(´・ω・｀)"},
        { "location": "309/SEL"     , "narrator": "", "text": "そんなところがつばめらしい"},
        { "location": "310/ACT"     , "narrator": "", "text": "そんなところがつばめらしい"},
        { "location": "312/TALK"    , "narrator": "つばめ", "text": "ぅーん"},
        { "location": "313/TALK"    , "narrator": "つばめ", "text": "良ぃってことかな？(´・ω・｀)"},
        { "location": "314/TALK"    , "narrator": "つばめ", "text": "そぅだったら嬉しぃな(●´ω｀●)ゞｴﾍﾍ"},
        { "location": "315/ACT"     , "narrator": "", "text": "特別かどうかってことかな"},
        { "location": "316/TALK"    , "narrator": "つばめ", "text": "$handle$さんは特別だよヾ(*´ｴ`*)ﾉ ｲｯﾁｬｯﾀ"},
        { "location": "318/SEL"     , "narrator": "", "text": "じゃあ気にしなくていいよ"},
        { "location": "319/ACT"     , "narrator": "", "text": "じゃあ気にしなくていいよ"},
        { "location": "321/TALK"    , "narrator": "つばめ", "text": "そぅなの？"},
        { "location": "322/TALK"    , "narrator": "つばめ", "text": "ぅーん"},
        { "location": "324/TALK"    , "narrator": "つばめ", "text": "それでぃぃのかなぁ？(o´Д`)=з"},
        { "location": "325/ACT"     , "narrator": "", "text": "ときめきがあるかどうかかな"},
        { "location": "326/TALK"    , "narrator": "つばめ", "text": "ときめきって何だろぅ？"},
        { "location": "327/TALK"    , "narrator": "つばめ", "text": "それがわかると恋もわかるよぅになるのかな？(｡･ω･｡)"},
        { "location": "329/SEL"     , "narrator": "", "text": "だったら教えようがないよ"},
        { "location": "330/ACT"     , "narrator": "", "text": "だったら教えようがないよ"},
        { "location": "332/TALK"    , "narrator": "つばめ", "text": "そっか(´･ω･｀) "},
        { "location": "333/TALK"    , "narrator": "つばめ", "text": "ぅーん"},
        { "location": "334/TALK"    , "narrator": "つばめ", "text": "やっぱり難しぃね(o´Д`)=з"},
        { "location": "348/TALK"    , "narrator": "つばめ", "text": "…ごめん、ひなこちゃん。\n全然わからないや。"},
        { "location": "349/TALK"    , "narrator": "雛", "text": "…そ、それ、本気？"},
        { "location": "350/TALK"    , "narrator": "つばめ", "text": "うん…恋人の条件って、\nなんなんだろう？"},
        { "location": "353/TALK"    , "narrator": "つばめ", "text": "好きって気持ちだけじゃ\nダメなのかなぁ？"},
        { "location": "354/TALK"    , "narrator": "つばめ", "text": "あ、でもわたしの好きは\n恋の好きじゃないし…\nう～ん…。"},
        { "location": "356/TALK"    , "narrator": "雛", "text": "…ちょっと疑ったけど、\nしらばっくれてるわけじゃ\nないみたいだねー。"},
        { "location": "359/TALK"    , "narrator": "つばめ", "text": "え？　何を？"},
        { "location": "361/TALK"    , "narrator": "雛", "text": "ううん、何でもない。"},
        { "location": "362/TALK"    , "narrator": "雛", "text": "つばめちゃんは、\n人一倍時間を掛けて――"},
        { "location": "363/TALK"    , "narrator": "雛", "text": "ゆっくり恋をしていく\nタイプなのかも\nしれないね。"},
        { "location": "366/TALK"    , "narrator": "つばめ", "text": "そうなのかなぁ？\nうーん…。"},
        { "location": "367/TALK"    , "narrator": "雛", "text": "今はこれ以上考えても\n答えなんて出ないよ。"},
        { "location": "368/TALK"    , "narrator": "雛", "text": "それより、せっかく\nカフェに来てるんだから、\n甘い物でも食べよ。"},
        { "location": "227/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>某月某日　2:04 PM</color>\nとある平日の午後、学園廊下にて。"}
    ]
}
