        "title": "【EXストーリー】音無の花",
        "sub_title": "コネクトストーリー"
    },
    "entry":
    [
        { "location": "18/SCENARIO", "narrator": "", "text": "【導入】銀葉樹"},
        { "location": "24/DIALOG"  , "narrator": "", "text": "<size=40>CURAN STORY. 01</size>\nTSUBAME OHSE\n\n<size=45>相澤亜紀</size>\n<size=35>～石の花～</size>"},
        { "location": "40/TALK"    , "narrator": "つばめ", "text": "ようこそ\nいらっしゃいました、\n$handle$さん。"},
        { "location": "41/TALK"    , "narrator": "つばめ", "text": "ここは、私たち\nトライナリーと、\nクランたちとの交差点。"},
        { "location": "42/TALK"    , "narrator": "つばめ", "text": "ココロとココロが\n出逢い、共鳴し、\nそして繋がりあう場所。"},
        { "location": "50/SEL"     , "narrator": "（選択肢）", "text": "概要説明を飛ばす"},
        { "location": "51/SEL"     , "narrator": "（選択肢）", "text": "もう一度聞く"},
        { "location": "52/ACT"     , "narrator": "", "text": "概要説明を飛ばす"},
        { "location": "53/TALK"    , "narrator": "つばめ", "text": "わかりました。\nそれでは早速クランの\n紹介をします。"},
        { "location": "55/ACT"     , "narrator": "", "text": "もう一度聞く"},
        { "location": "60/TALK"    , "narrator": "つばめ", "text": "ここでは、普段私たちを\n助けてくれるサーバント\nクランを紹介します。"},
        { "location": "61/TALK"    , "narrator": "つばめ", "text": "そして、貴方が直接\n彼女たちと繋がれる\nよう、手続きをします。"},
        { "location": "62/SEL"     , "narrator": "（選択肢）", "text": "アニメに出てくるクランを\n使えるようになるってことかな？"},
        { "location": "63/ACT"     , "narrator": "", "text": "アニメに出てくるクランを\n使えるようになるってことかな？"},
        { "location": "65/TALK"    , "narrator": "つばめ", "text": "はい。\n簡単に言えば、\nそういう事になります。"},
        { "location": "66/TALK"    , "narrator": "つばめ", "text": "このセクターでは、\nクラン一人にスポットを\n当てて紹介します。"},
        { "location": "67/TALK"    , "narrator": "つばめ", "text": "そして彼女との【儀式】\nによって、貴方とココロを\n繋げます。"},
        { "location": "68/TALK"    , "narrator": "つばめ", "text": "【儀式】には『コネクト』\nと『シンクロ』の２つが\nあります。"},
        { "location": "69/TALK"    , "narrator": "つばめ", "text": "『コネクト』は、貴方と\nクランが物理的に繋がる\nための儀式。"},
        { "location": "70/TALK"    , "narrator": "つばめ", "text": "これは、バトルをする事で\n彼女と貴方の中にある、\n抵抗勢力を無力化します。"},
        { "location": "71/TALK"    , "narrator": "つばめ", "text": "次の『シンクロ』では、\nクランの過去を知り、\n共感していただきます。"},
        { "location": "72/TALK"    , "narrator": "つばめ", "text": "これは、クランの過去の\n物語をシェアすることで、\n心が通えるようにします。"},
        { "location": "74/TALK"    , "narrator": "つばめ", "text": "ここまで、\nわかりましたか？"},
        { "location": "75/TALK"    , "narrator": "つばめ", "text": "もし、入るセクターを\n間違えた、という方は\n今からでも退場できます。"},
        { "location": "76/SEL"     , "narrator": "（選択肢）", "text": "オッケー、先に進んで"},
        { "location": "77/SEL"     , "narrator": "（選択肢）", "text": "間違えたので退場します"},
        { "location": "78/SEL"     , "narrator": "（選択肢）", "text": "なんでそんなフォーマルな感じなの？"},
        { "location": "79/ACT"     , "narrator": "", "text": "オッケー、先に進んで"},
        { "location": "80/TALK"    , "narrator": "つばめ", "text": "承知しました。\nそれでは早速、今回の\nクランを紹介しますね。"},
        { "location": "81/ACT"     , "narrator": "", "text": "間違えたので退場します"},
        { "location": "82/TALK"    , "narrator": "つばめ", "text": "あれ、\nそうだったんですね。"},
        { "location": "83/TALK"    , "narrator": "つばめ", "text": "それじゃ、ここで\nさようならですね。"},
        { "location": "85/TALK"    , "narrator": "つばめ", "text": "また気が向いたら\n来てください。"},
        { "location": "86/TALK"    , "narrator": "つばめ", "text": "$handle$さんと\nわたしに、\n素敵なココロの旅を。"},
        { "location": "88/ACT"     , "narrator": "", "text": "なんでそんなフォーマルな感じなの？"},
        { "location": "89/TALK"    , "narrator": "つばめ", "text": "え？\nえっと、そうですね…"},
        { "location": "91/TALK"    , "narrator": "つばめ", "text": "やはり、他人のココロを\n語るわけですから、\nヘラヘラできませんし。"},
        { "location": "92/TALK"    , "narrator": "つばめ", "text": "でもやっぱり、\nあまりいつものわたし\nらしくないですよね。"},
        { "location": "93/TALK"    , "narrator": "つばめ", "text": "ちょっと堅苦しいかも\nしれませんが、我慢して\nお付き合いください。"},
        { "location": "94/TALK"    , "narrator": "つばめ", "text": "それでは早速、今回の\nクランを紹介しますね。"},
        { "location": "103/TALK"   , "narrator": "つばめ", "text": "オープンプロセス、\n0x191番地から\n0xFFF番地へ。"},
        { "location": "104/TALK"   , "narrator": "つばめ", "text": "共通意識野を経由、\n外部スフィアへ接続。"},
        { "location": "105/TALK"   , "narrator": "つばめ", "text": "EXEC_SEEK_SECTOR\n=>Link() EXT_SPHERE/."},
        { "location": "130/TALK"   , "narrator": "つばめ", "text": "シーク完了しました。"},
        { "location": "131/TALK"   , "narrator": "つばめ", "text": "さて――。"},
        { "location": "133/TALK"   , "narrator": "つばめ", "text": "今回、貴方に\n紹介するクランは\n<color=red>【銀葉樹】</color>。"},
        { "location": "137/TALK"   , "narrator": "つばめ", "text": "多摩ニュータウンにて\n発症。"},
        { "location": "138/TALK"   , "narrator": "つばめ", "text": "発症した人の名前は、\n相澤亜紀、１６歳。"},
        { "location": "139/TALK"   , "narrator": "つばめ", "text": "ココロファイルナンバー\nE01-012-58によれば、\n今回の発症の原因は……"},
        { "location": "140/TALK"   , "narrator": "つばめ", "text": "『人見知りで内気な\n亜紀が高校に入り\n心優しい男子に恋をした』"},
        { "location": "141/TALK"   , "narrator": "つばめ", "text": "『自然と付き合うように\nなった二人。だがデート中\n不良グループに襲われる』"},
        { "location": "143/TALK"   , "narrator": "つばめ", "text": "『そして亜紀は願った。\n汚れた理不尽な世界に\n災いを、と』"},
        { "location": "147/TALK"   , "narrator": "つばめ", "text": "……ひどい話です。"},
        { "location": "149/TALK"   , "narrator": "つばめ", "text": "理不尽すぎます。\nでも、だからこそ共感\nできるところもあります。"},
        { "location": "150/TALK"   , "narrator": "つばめ", "text": "そうして今、\nここにいるのですけど。"},
        { "location": "151/SEL"    , "narrator": "（選択肢）", "text": "関係あるんだ"},
        { "location": "152/SEL"    , "narrator": "（選択肢）", "text": "そういえば、つばめが仕切ってる理由って…"},
        { "location": "153/ACT"    , "narrator": "", "text": "関係あるんだ"},
        { "location": "154/ACT"    , "narrator": "", "text": "そういえば、つばめが仕切ってる理由って…"},
        { "location": "156/TALK"   , "narrator": "つばめ", "text": "そうです。"},
        { "location": "157/TALK"   , "narrator": "つばめ", "text": "このセクタでは、クランの\n子と一番相性がいい\nトライナリーが語ります。"},
        { "location": "158/TALK"   , "narrator": "つばめ", "text": "今回の「銀葉樹」ちゃんは\nわたしが一番共感できた子\nということですね。"},
        { "location": "159/TALK"   , "narrator": "つばめ", "text": "ですから、次は誰か、\n他の人がやることに\nなると思います。"},
        { "location": "160/SEL"    , "narrator": "（選択肢）", "text": "銀葉樹の何に共感したの？"},
        { "location": "161/ACT"    , "narrator": "", "text": "銀葉樹の何に共感したの？"},
        { "location": "163/TALK"   , "narrator": "つばめ", "text": "えっと、\nそれはですね……。"},
        { "location": "164/TALK"   , "narrator": "つばめ", "text": "$handle$さんが、\n銀葉樹ちゃんと精神を\n共有できたらお話します。"},
        { "location": "165/TALK"   , "narrator": "つばめ", "text": "ですから、まずは\n銀葉樹ちゃんとの精神\n共有を頑張ってください。"},
        { "location": "166/SEL"    , "narrator": "（選択肢）", "text": "どうやって精神を共有するの？"},
        { "location": "167/ACT"    , "narrator": "", "text": "どうやって精神を共有するの？"},
        { "location": "169/TALK"   , "narrator": "つばめ", "text": "先ほどお伝えした通り、\nまずは『コネクト』の\nプロセスを行います。"},
        { "location": "170/TALK"   , "narrator": "つばめ", "text": "具体的には、\n彼女の抵抗する意志と\n戦うんです。"},
        { "location": "171/TALK"   , "narrator": "つばめ", "text": "それが終われば、\n彼女は貴方に色々\n教えてくれるでしょう。"},
        { "location": "172/TALK"   , "narrator": "つばめ", "text": "$handle$さんが\nそれを共有すれば、\n『シンクロ』完了です。"},
        { "location": "173/TALK"   , "narrator": "つばめ", "text": "『コネクト』『シンクロ』\n両方完了することで、\n貴方と彼女は繋がれます。"},
        { "location": "174/SEL"    , "narrator": "（選択肢）", "text": "そして【銀葉樹】を使うことができるようになる、と"},
        { "location": "175/ACT"    , "narrator": "", "text": "そして【銀葉樹】を使うことができるようになる、と"},
        { "location": "177/TALK"   , "narrator": "つばめ", "text": "そうです！\nその通りです！"},
        { "location": "178/TALK"   , "narrator": "つばめ", "text": "その時には、わたしの\nこともちょっとだけ\n教えますね。"},
        { "location": "179/TALK"   , "narrator": "つばめ", "text": "ですから、『シンクロ』\nまで完了できるように\n頑張ってください！"},
        { "location": "180/TALK"   , "narrator": "つばめ", "text": "それでは早速、\n銀葉樹ちゃんの世界に\nアクセスしますよ。"},
        { "location": "182/TALK"   , "narrator": "つばめ", "text": "$handle$さんと\nわたしと銀葉樹ちゃんに、\n素敵なココロの旅を！"}
    ]
}
