    "entry":
    [
        { "location": "128/SCENARIO", "narrator": "", "text": "020_魔法使いと弟子"},
        { "location": "153/TALK"    , "narrator": "ガブリエラ", "text": "貴方は魔法使いなのね"},
        { "location": "154/TALK"    , "narrator": "ガブリエラ", "text": "ううん、魔女なのかしら？"},
        { "location": "155/TALK"    , "narrator": "ガブリエラ", "text": "どっちでもいいわ"},
        { "location": "156/TALK"    , "narrator": "ガブリエラ", "text": "とにかくすごいわ"},
        { "location": "157/TALK"    , "narrator": "ガブリエラ", "text": "マルザンナったら"},
        { "location": "160/SEL"     , "narrator": "", "text": "もっと褒めて"},
        { "location": "161/SEL"     , "narrator": "", "text": "何かしたっけ？"},
        { "location": "162/ACT"     , "narrator": "", "text": "もっと褒めて"},
        { "location": "163/TALK"    , "narrator": "ガブリエラ", "text": "いくらでも誉めるわ"},
        { "location": "165/TALK"    , "narrator": "ガブリエラ", "text": "マルザンナはすごいのねｖｖｖ"},
        { "location": "166/ACT"     , "narrator": "", "text": "何かしたっけ？"},
        { "location": "167/TALK"    , "narrator": "ガブリエラ", "text": "忘れたのかしら？"},
        { "location": "168/TALK"    , "narrator": "ガブリエラ", "text": "遅刻のいいわけのことよ"},
        { "location": "170/TALK"    , "narrator": "ガブリエラ", "text": "マルザンナの言うとおりにしたら"},
        { "location": "171/TALK"    , "narrator": "ガブリエラ", "text": "アーヤが優しかったわ"},
        { "location": "172/TALK"    , "narrator": "ガブリエラ", "text": "どうやったらそんなこと思いつけるの？"},
        { "location": "174/SEL"     , "narrator": "", "text": "言い訳のプロだからね"},
        { "location": "175/SEL"     , "narrator": "", "text": "二回は使えないよ？"},
        { "location": "176/SEL"     , "narrator": "", "text": "これからは気を付けてね"},
        { "location": "177/ACT"     , "narrator": "", "text": "言い訳のプロだからね"},
        { "location": "178/TALK"    , "narrator": "ガブリエラ", "text": "結局は"},
        { "location": "180/TALK"    , "narrator": "ガブリエラ", "text": "そういうことなのかしら？"},
        { "location": "181/TALK"    , "narrator": "ガブリエラ", "text": "それは真似しちゃいけないわね、、、"},
        { "location": "182/ACT"     , "narrator": "", "text": "二回は使えないよ？"},
        { "location": "183/TALK"    , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "184/TALK"    , "narrator": "ガブリエラ", "text": "気を付けるわ"},
        { "location": "185/TALK"    , "narrator": "ガブリエラ", "text": "今回はありがとう"},
        { "location": "186/ACT"     , "narrator": "", "text": "これからは気を付けてね"},
        { "location": "188/TALK"    , "narrator": "ガブリエラ", "text": "わかっているわよ"},
        { "location": "190/TALK"    , "narrator": "ガブリエラ", "text": "本当は遅刻したことが悪いことだってことは"},
        { "location": "191/TALK"    , "narrator": "ガブリエラ", "text": "だからちゃんと気を付けるようにするわ"},
        { "location": "194/TALK"    , "narrator": "ガブリエラ", "text": "それと"},
        { "location": "195/TALK"    , "narrator": "ガブリエラ", "text": "今回は"},
        { "location": "196/TALK"    , "narrator": "ガブリエラ", "text": "ありがとう"}
    ]
}
