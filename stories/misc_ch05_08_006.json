    [
        { "location": "1884/SCENARIO", "narrator": "", "text": "ドはドラアグのド"},
        { "location": "1909/TALK"    , "narrator": "神楽", "text": "ドはドラアグのド"},
        { "location": "1910/TALK"    , "narrator": "神楽", "text": "レは練炭のレ"},
        { "location": "1911/TALK"    , "narrator": "神楽", "text": "ミは身も蓋もないのミ"},
        { "location": "1913/SEL"     , "narrator": "", "text": "ファはファンクションのファ"},
        { "location": "1914/SEL"     , "narrator": "", "text": "ファ、ファイト！"},
        { "location": "1915/SEL"     , "narrator": "", "text": "ファッファッファッファッｗ"},
        { "location": "1916/ACT"     , "narrator": "", "text": "ファはファンクションのファ"},
        { "location": "1917/TALK"    , "narrator": "神楽", "text": "もっと不穏当な言葉にしてくれないとー！"},
        { "location": "1918/TALK"    , "narrator": "神楽", "text": "ぴょんこはもうぷんぷん！"},
        { "location": "1919/ACT"     , "narrator": "", "text": "ファ、ファイト！"},
        { "location": "1920/TALK"    , "narrator": "神楽", "text": "あーね"},
        { "location": "1921/TALK"    , "narrator": "神楽", "text": "やです"},
        { "location": "1922/ACT"     , "narrator": "", "text": "ファッファッファッファッｗ"},
        { "location": "1924/TALK"    , "narrator": "神楽", "text": "ファッウケたｗ"},
        { "location": "1925/TALK"    , "narrator": "神楽", "text": "やったね！！！"},
        { "location": "1929/TALK"    , "narrator": "神楽", "text": "原曲の歌詞自体が納得いかないんだけどねこれ"},
        { "location": "1930/TALK"    , "narrator": "神楽", "text": "実際はドの音じゃないし"},
        { "location": "1933/SEL"     , "narrator": "", "text": "そうだったんだ！？"},
        { "location": "1934/SEL"     , "narrator": "", "text": "知ってたしー"},
        { "location": "1935/ACT"     , "narrator": "", "text": "そうだったんだ！？"},
        { "location": "1936/TALK"    , "narrator": "神楽", "text": "ここにも一人騙されていた人間が"},
        { "location": "1937/ACT"     , "narrator": "", "text": "知ってたしー"},
        { "location": "1938/TALK"    , "narrator": "神楽", "text": "へーそう？"},
        { "location": "1940/TALK"    , "narrator": "神楽", "text": "ドーいうことなのって聞きたくなるでしょ？"},
        { "location": "1942/SEL"     , "narrator": "", "text": "それはさすがに寒…"},
        { "location": "1943/SEL"     , "narrator": "", "text": "ドーなってんだろうね！？"},
        { "location": "1944/SEL"     , "narrator": "", "text": "作曲家を問い詰めよう！"},
        { "location": "1945/ACT"     , "narrator": "", "text": "それはさすがに寒…"},
        { "location": "1946/TALK"    , "narrator": "神楽", "text": "自分でもそうオモタ"},
        { "location": "1947/TALK"    , "narrator": "神楽", "text": "そしてｵﾜﾀ＼(^o^)／"},
        { "location": "1948/ACT"     , "narrator": "", "text": "ドーなってんだろうね！？"},
        { "location": "1950/TALK"    , "narrator": "神楽", "text": "うわ寒っｗｗｗ"},
        { "location": "1951/TALK"    , "narrator": "神楽", "text": "マジヤバスｗｗｗ"},
        { "location": "1952/TALK"    , "narrator": "神楽", "text": "でもそこがｲｲ！！！"},
        { "location": "1953/ACT"     , "narrator": "", "text": "作曲家を問い詰めよう！"},
        { "location": "1954/TALK"    , "narrator": "神楽", "text": "それはいいや"},
        { "location": "1956/TALK"    , "narrator": "神楽", "text": "ぴょんこは残りのソラシドについて考えながら眠ります"},
        { "location": "1958/TALK"    , "narrator": "神楽", "text": "おやすー"}
    ]
}
