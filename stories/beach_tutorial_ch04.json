    "entry":
    [
        { "location": "468/SCENARIO", "narrator": "", "text": "TGSみやび"},
        { "location": "488/TALK"    , "narrator": "みやび", "text": "デートに海、っちゅうのは\n定番過ぎると思わんか？"},
        { "location": "489/TALK"    , "narrator": "みやび", "text": "いや、別に悪いとは\n言わんけんど。"},
        { "location": "490/TALK"    , "narrator": "みやび", "text": "相棒やったら、\nもっと面白い場所を\n選ぶと思うたんやが…。"},
        { "location": "491/SEL"     , "narrator": "", "text": "気に入らなかった？"},
        { "location": "492/SEL"     , "narrator": "", "text": "定番こそ王道とも言う"},
        { "location": "493/ACT"     , "narrator": "", "text": "気に入らなかった？"},
        { "location": "494/TALK"    , "narrator": "みやび", "text": "なんや、気にしたが？"},
        { "location": "495/TALK"    , "narrator": "みやび", "text": "冗談や、冗談。\n気に入らんわけやないき、\n気にせんでえい。"},
        { "location": "496/TALK"    , "narrator": "みやび", "text": "まっこと気に入らん\n思うてたら、\n一緒に来たりせんぞね。"},
        { "location": "497/ACT"     , "narrator": "", "text": "定番こそ王道とも言う"},
        { "location": "498/TALK"    , "narrator": "みやび", "text": "…なるほど、\n確かにそうかもしれん。"},
        { "location": "499/TALK"    , "narrator": "みやび", "text": "なんだかんだ言うても、\n王道に外れはないきね。"},
        { "location": "500/TALK"    , "narrator": "みやび", "text": "それに…うちとしても\n海デートと聞いて、\nテンション上がったし。"},
        { "location": "502/TALK"    , "narrator": "みやび", "text": "…その証拠に、ほれ、\nこの水着見てみぃ。"},
        { "location": "503/TALK"    , "narrator": "みやび", "text": "なんとも…大胆っちゅうと\n聞こえはえいけんど、\nはしたないような…。"},
        { "location": "504/TALK"    , "narrator": "みやび", "text": "露出しまくり水着なんぞ\n買うてしまったちや。"},
        { "location": "505/SEL"     , "narrator": "", "text": "どうしてこれを選んだの？"},
        { "location": "506/ACT"     , "narrator": "", "text": "どうしてこれを選んだの？"},
        { "location": "509/TALK"    , "narrator": "みやび", "text": "それは…。"},
        { "location": "510/TALK"    , "narrator": "みやび", "text": "恋人の喜ぶ水着特集で、\nこれが一位やった、\nっちゅうだけの理由ちや。"},
        { "location": "511/TALK"    , "narrator": "みやび", "text": "つまり、その…。"},
        { "location": "512/TALK"    , "narrator": "みやび", "text": "…いや、言わせるな。\n少しは察せ、恋人よ。"},
        { "location": "513/SEL"     , "narrator": "", "text": "すごく嬉しい、ありがとう"},
        { "location": "514/SEL"     , "narrator": "", "text": "愛を感じる"},
        { "location": "515/ACT"     , "narrator": "", "text": "すごく嬉しい、ありがとう"},
        { "location": "516/TALK"    , "narrator": "みやび", "text": "…そう言うてくれるなら、\n頑張って選んだ甲斐が\nあるゆうもんや。"},
        { "location": "517/ACT"     , "narrator": "", "text": "愛を感じる"},
        { "location": "518/TALK"    , "narrator": "みやび", "text": "あ、アホか！？"},
        { "location": "519/TALK"    , "narrator": "みやび", "text": "いや、そりゃ恋人やき、\n愛がないっちゅうわけや\nないけんど…。"},
        { "location": "520/TALK"    , "narrator": "みやび", "text": "…うちを、こんな風に\n慌てさせられるんは、\n相棒だけやぞ？"},
        { "location": "523/TALK"    , "narrator": "みやび", "text": "まあ、気に入ってくれた\nっちゅうなら…。"},
        { "location": "524/TALK"    , "narrator": "みやび", "text": "ほれ、今のうちにしっかり\n目に焼き付けときぃ。"},
        { "location": "525/TALK"    , "narrator": "みやび", "text": "喜んでもらえたんは\n嬉しいけんど、さすがに\n海以外では着んだろうし。"},
        { "location": "526/SEL"     , "narrator": "", "text": "ちょっとだけ、触ってもいい？"},
        { "location": "527/ACT"     , "narrator": "", "text": "ちょっとだけ、触ってもいい？"},
        { "location": "529/TALK"    , "narrator": "みやび", "text": "…欲張りな恋人やね。"},
        { "location": "530/TALK"    , "narrator": "みやび", "text": "まあ、えいやろ…。\nせっかく海に来てるん\nやきね。"},
        { "location": "531/TALK"    , "narrator": "みやび", "text": "ちくっと、開放的な\n気持ちになった思うて、\n特別に触らせちゃるぞね。"},
        { "location": "550/TALK"    , "narrator": "みやび", "text": "…こんなに\n薄着しちゅうのに、\n暑くなってきたがよ…。"},
        { "location": "552/TALK"    , "narrator": "みやび", "text": "…まあ、誰も見てないき、\n楽しむとするぞね。"},
        { "location": "558/TALK"    , "narrator": "みやび", "text": "ふふん、柔らかいやろ？"},
        { "location": "559/TALK"    , "narrator": "みやび", "text": "…わ、わかったなら、\n突然触るのはもうやめぃ。"},
        { "location": "561/TALK"    , "narrator": "みやび", "text": "あっ…。"},
        { "location": "562/TALK"    , "narrator": "みやび", "text": "いや…、そういうのは、\n褒められんがよ？"},
        { "location": "568/TALK"    , "narrator": "みやび", "text": "…この水着やと、\n肌に直接触れられるき…、\nソワソワしてくるぞね。"},
        { "location": "570/TALK"    , "narrator": "みやび", "text": "さ、触るだけやぞ？"},
        { "location": "571/TALK"    , "narrator": "みやび", "text": "それと、触れてるときに\n動かすんは禁止や…。"},
        { "location": "577/TALK"    , "narrator": "みやび", "text": "…こんなに\n薄着しちゅうのに、\n暑くなってきたがよ…。"},
        { "location": "579/TALK"    , "narrator": "みやび", "text": "なんや、水着のこと\n褒めてくれちゅうが？"},
        { "location": "585/TALK"    , "narrator": "みやび", "text": "…ゆ、揺らすのが\n好きなが？"},
        { "location": "587/TALK"    , "narrator": "みやび", "text": "あっ…。"},
        { "location": "588/TALK"    , "narrator": "みやび", "text": "いや…、そういうのは、\n褒められんがよ？"},
        { "location": "594/TALK"    , "narrator": "みやび", "text": "…この水着やと、\n肌に直接触れられるき…、\nソワソワしてくるぞね。"},
        { "location": "596/TALK"    , "narrator": "みやび", "text": "さ、触るだけやぞ？"},
        { "location": "597/TALK"    , "narrator": "みやび", "text": "それと、触れてるときに\n動かすんは禁止や…。"},
        { "location": "536/DIALOG"  , "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "604/DIALOG"  , "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"}
    ]
