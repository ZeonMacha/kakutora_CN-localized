    "entry":
    [
        { "location": "245/SCENARIO", "narrator": "", "text": "策士で生きてきた"},
        { "location": "270/TALK"    , "narrator": "神楽", "text": "$handle$にだけ教えてあげる"},
        { "location": "271/TALK"    , "narrator": "神楽", "text": "本当はぴょんこはぴょんこ星から来た宇宙人なのぴょん"},
        { "location": "272/TALK"    , "narrator": "神楽", "text": "ぴょんこ星人が地球人と違うところは地球人の心が読めること"},
        { "location": "273/TALK"    , "narrator": "神楽", "text": "その力を使ってぴょんこは色んなことをした"},
        { "location": "274/TALK"    , "narrator": "神楽", "text": "っていうか現在進行形"},
        { "location": "276/SEL"     , "narrator": "", "text": "本当はヤバい子だったの？"},
        { "location": "277/SEL"     , "narrator": "", "text": "不思議ちゃん気取り萌える"},
        { "location": "278/SEL"     , "narrator": "", "text": "じゃあ$me$が今何考えてるかわかる？"},
        { "location": "279/ACT"     , "narrator": "", "text": "本当はヤバい子だったの？"},
        { "location": "280/TALK"    , "narrator": "神楽", "text": "それはどういう意味でなのかぴょん？"},
        { "location": "281/TALK"    , "narrator": "神楽", "text": "教えて欲しいﾅﾘ"},
        { "location": "282/ACT"     , "narrator": "", "text": "不思議ちゃん気取り萌える"},
        { "location": "283/TALK"    , "narrator": "神楽", "text": "気取りじゃないですし"},
        { "location": "284/TALK"    , "narrator": "神楽", "text": "本当なんですし"},
        { "location": "285/ACT"     , "narrator": "", "text": "じゃあ$me$が今何考えてるかわかる？"},
        { "location": "286/TALK"    , "narrator": "神楽", "text": "どれどれ、、、、"},
        { "location": "288/TALK"    , "narrator": "神楽", "text": "あーこれは口に出さない方がいいことなんでやめとくね★"},
        { "location": "290/TALK"    , "narrator": "神楽", "text": "閑話休題"},
        { "location": "291/TALK"    , "narrator": "神楽", "text": "人の気持ちを読むことができるぴょんこは"},
        { "location": "292/TALK"    , "narrator": "神楽", "text": "FreyMENOWとしてアーティスト活動を行い"},
        { "location": "293/TALK"    , "narrator": "神楽", "text": "人心を掌握した"},
        { "location": "295/SEL"     , "narrator": "", "text": "なんということだ！"},
        { "location": "296/SEL"     , "narrator": "", "text": "ＭＪＤ？"},
        { "location": "297/SEL"     , "narrator": "", "text": "ある意味正解かも…"},
        { "location": "298/ACT"     , "narrator": "", "text": "なんということだ！"},
        { "location": "299/TALK"    , "narrator": "神楽", "text": "フフフ、、、"},
        { "location": "301/TALK"    , "narrator": "神楽", "text": "マジで！"},
        { "location": "302/TALK"    , "narrator": "神楽", "text": "マジで！"},
        { "location": "303/ACT"     , "narrator": "", "text": "ある意味正解かも…"},
        { "location": "304/TALK"    , "narrator": "神楽", "text": "そうかもね？"},
        { "location": "306/TALK"    , "narrator": "神楽", "text": "しかし人心とは移り気なもの"},
        { "location": "307/TALK"    , "narrator": "神楽", "text": "アーティストとしての人気をつなぎ止めるためには"},
        { "location": "308/TALK"    , "narrator": "神楽", "text": "自分の気持ちより民衆の気持ちを優先せねばならない"},
        { "location": "310/SEL"     , "narrator": "", "text": "$me$の歌を聴けぇぇぇ！　じゃないの？"},
        { "location": "311/SEL"     , "narrator": "", "text": "なんか一気に夢がなくなった"},
        { "location": "312/SEL"     , "narrator": "", "text": "ショウビジネスの現実だ"},
        { "location": "313/ACT"     , "narrator": "", "text": "$me$の歌を聴けぇぇぇ！　じゃないの？"},
        { "location": "314/TALK"    , "narrator": "神楽", "text": "そのためには"},
        { "location": "315/TALK"    , "narrator": "神楽", "text": "準備が必要"},
        { "location": "316/ACT"     , "narrator": "", "text": "なんか一気に夢がなくなった"},
        { "location": "317/TALK"    , "narrator": "神楽", "text": "完成された手品なら"},
        { "location": "318/TALK"    , "narrator": "神楽", "text": "種を知っても楽しめるぴょん♪"},
        { "location": "319/ACT"     , "narrator": "", "text": "ショウビジネスの現実だ"},
        { "location": "320/TALK"    , "narrator": "神楽", "text": "バックステージへようこそ♪"},
        { "location": "322/TALK"    , "narrator": "神楽", "text": "民衆の求める音楽"},
        { "location": "323/TALK"    , "narrator": "神楽", "text": "民衆の求めるステージ"},
        { "location": "324/TALK"    , "narrator": "神楽", "text": "民衆の求める物語"},
        { "location": "325/TALK"    , "narrator": "神楽", "text": "民衆の求める世界"},
        { "location": "326/TALK"    , "narrator": "神楽", "text": "FreyMENOWの活動は"},
        { "location": "327/TALK"    , "narrator": "神楽", "text": "そういうものに変わっていった"},
        { "location": "329/SEL"     , "narrator": "", "text": "そうだったんだ…"},
        { "location": "330/SEL"     , "narrator": "", "text": "相当辛いよね…"},
        { "location": "331/SEL"     , "narrator": "", "text": "楽しくはないよね"},
        { "location": "332/ACT"     , "narrator": "", "text": "そうだったんだ…"},
        { "location": "333/TALK"    , "narrator": "神楽", "text": "作り話だから"},
        { "location": "334/ACT"     , "narrator": "", "text": "相当辛いよね…"},
        { "location": "335/TALK"    , "narrator": "神楽", "text": "そうだよね"},
        { "location": "336/ACT"     , "narrator": "", "text": "楽しくはないよね"},
        { "location": "337/TALK"    , "narrator": "神楽", "text": "別の意味では大笑い"},
        { "location": "339/TALK"    , "narrator": "神楽", "text": "FreyMENOWはこの世界に来る前は"},
        { "location": "340/TALK"    , "narrator": "神楽", "text": "自分の考えが人に共感してもらえるのだろうかと不安だった"},
        { "location": "341/TALK"    , "narrator": "神楽", "text": "それでも自分には伝えたいことがあるから"},
        { "location": "342/TALK"    , "narrator": "神楽", "text": "そう思って活動した"},
        { "location": "343/TALK"    , "narrator": "神楽", "text": "そして人の心が自分とあまり違わないことを知って"},
        { "location": "344/TALK"    , "narrator": "神楽", "text": "とてもうれしかった"},
        { "location": "345/TALK"    , "narrator": "神楽", "text": "自分が大好きなものを同じように好きな人が存在することを知って"},
        { "location": "346/TALK"    , "narrator": "神楽", "text": "自分が活動している意味を見つけたと思った"},
        { "location": "347/TALK"    , "narrator": "神楽", "text": "最初はただそれだけだったのに"},
        { "location": "348/TALK"    , "narrator": "神楽", "text": "そうして相手をもっと喜ばせたいと思った"},
        { "location": "349/TALK"    , "narrator": "神楽", "text": "それだけだったのに"},
        { "location": "351/SEL"     , "narrator": "", "text": "えっと…"},
        { "location": "352/SEL"     , "narrator": "", "text": "自分を責めないで"},
        { "location": "353/SEL"     , "narrator": "", "text": "色々大変なのは伝わってきた"},
        { "location": "354/ACT"     , "narrator": "", "text": "えっと…"},
        { "location": "355/TALK"    , "narrator": "神楽", "text": "なんだかなーって"},
        { "location": "356/ACT"     , "narrator": "", "text": "自分を責めないで"},
        { "location": "357/TALK"    , "narrator": "神楽", "text": "責めてるつもりはないけど"},
        { "location": "358/ACT"     , "narrator": "", "text": "色々大変なのは伝わってきた"},
        { "location": "359/TALK"    , "narrator": "神楽", "text": "そうだよね"},
        { "location": "360/TALK"    , "narrator": "神楽", "text": "大変だったんだぴょん"},
        { "location": "362/TALK"    , "narrator": "神楽", "text": "人の顔色をうかがって"},
        { "location": "363/TALK"    , "narrator": "神楽", "text": "話の内容も全部変えて"},
        { "location": "364/TALK"    , "narrator": "神楽", "text": "とにかく気に入られたら勝ち"},
        { "location": "365/TALK"    , "narrator": "神楽", "text": "そんなことしかできなくなった"},
        { "location": "367/TALK"    , "narrator": "神楽", "text": "そんな計算だけで生きて行くようになった"},
        { "location": "368/TALK"    , "narrator": "神楽", "text": "そんなことばかりしてたら"},
        { "location": "369/TALK"    , "narrator": "神楽", "text": "自分の本心もわからなくなった"},
        { "location": "370/TALK"    , "narrator": "神楽", "text": "つまらないよね"},
        { "location": "371/TALK"    , "narrator": "神楽", "text": "そんな人間"},
        { "location": "372/SEL"     , "narrator": "", "text": "神楽はいい子だよ"},
        { "location": "373/SEL"     , "narrator": "", "text": "神楽は魅力的な人間だよ"},
        { "location": "374/SEL"     , "narrator": "", "text": "$me$はどんな神楽も好きだよ"},
        { "location": "375/TALK"    , "narrator": "神楽", "text": "だからぴょんこの周りには"},
        { "location": "376/TALK"    , "narrator": "神楽", "text": "もう"},
        { "location": "377/TALK"    , "narrator": "神楽", "text": "だあれもいなくなっちゃった"},
        { "location": "378/TALK"    , "narrator": "神楽", "text": "$handle$以外"},
        { "location": "380/ACT"     , "narrator": "", "text": "神楽はいい子だよ"},
        { "location": "381/TALK"    , "narrator": "神楽", "text": "それは本心を隠してるから"},
        { "location": "382/TALK"    , "narrator": "神楽", "text": "いい子に見えて当たり前"},
        { "location": "383/TALK"    , "narrator": "神楽", "text": "そういうもんでしょ"},
        { "location": "393/ACT"     , "narrator": "", "text": "神楽は魅力的な人間だよ"},
        { "location": "394/TALK"    , "narrator": "神楽", "text": "それは作られた虚像"},
        { "location": "395/TALK"    , "narrator": "神楽", "text": "だから本当は"},
        { "location": "396/TALK"    , "narrator": "神楽", "text": "何もない虚無"},
        { "location": "406/ACT"     , "narrator": "", "text": "$me$はどんな神楽も好きだよ"},
        { "location": "409/TALK"    , "narrator": "神楽", "text": "どんなって"},
        { "location": "410/TALK"    , "narrator": "神楽", "text": "どんな？"},
        { "location": "412/SEL"     , "narrator": "", "text": "寝ぼけてる神楽とか"},
        { "location": "413/SEL"     , "narrator": "", "text": "病み状態の神楽とか"},
        { "location": "414/SEL"     , "narrator": "", "text": "ブチ切れてる神楽とか"},
        { "location": "415/SEL"     , "narrator": "", "text": "隙のある神楽とか"},
        { "location": "416/SEL"     , "narrator": "", "text": "オタ全開の神楽とか"},
        { "location": "417/ACT"     , "narrator": "", "text": "寝ぼけてる神楽とか"},
        { "location": "418/TALK"    , "narrator": "神楽", "text": "うそ"},
        { "location": "420/TALK"    , "narrator": "神楽", "text": "そんなとこ見せたことあったっけ！？！？！"},
        { "location": "421/ACT"     , "narrator": "", "text": "病み状態の神楽とか"},
        { "location": "422/TALK"    , "narrator": "神楽", "text": "あ"},
        { "location": "423/TALK"    , "narrator": "神楽", "text": "$handle$ってドＭなんだ？"},
        { "location": "424/ACT"     , "narrator": "", "text": "ブチ切れてる神楽とか"},
        { "location": "425/TALK"    , "narrator": "神楽", "text": "あ゛あ゛あ゛あ゛あ゛あ゛あ゛あ゛あ゛！？！？！"},
        { "location": "426/TALK"    , "narrator": "神楽", "text": "どういう意味！？！？！？！？！？！"},
        { "location": "427/ACT"     , "narrator": "", "text": "隙のある神楽とか"},
        { "location": "428/TALK"    , "narrator": "神楽", "text": "ないし"},
        { "location": "429/TALK"    , "narrator": "神楽", "text": "ないですし！！！！"},
        { "location": "430/ACT"     , "narrator": "", "text": "オタ全開の神楽とか"},
        { "location": "431/TALK"    , "narrator": "神楽", "text": "それはね？"},
        { "location": "432/TALK"    , "narrator": "神楽", "text": "合わせてあげてるの（暗黒微笑"},
        { "location": "435/TALK"    , "narrator": "神楽", "text": "ばっかみたい"},
        { "location": "436/TALK"    , "narrator": "神楽", "text": "何もかも"},
        { "location": "437/TALK"    , "narrator": "神楽", "text": "ばっかみたい"},
        { "location": "440/SEL"     , "narrator": "", "text": "そんなことないよ"},
        { "location": "441/SEL"     , "narrator": "", "text": "そういう時もあるよ"},
        { "location": "442/SEL"     , "narrator": "", "text": "全部ぶちまければ楽になるよ"},
        { "location": "443/ACT"     , "narrator": "", "text": "そんなことないよ"},
        { "location": "444/TALK"    , "narrator": "神楽", "text": "嘘でしょ"},
        { "location": "445/ACT"     , "narrator": "", "text": "そういう時もあるよ"},
        { "location": "446/TALK"    , "narrator": "神楽", "text": "そうだよね"},
        { "location": "447/TALK"    , "narrator": "神楽", "text": "あるよね！！！"},
        { "location": "448/ACT"     , "narrator": "", "text": "全部ぶちまければ楽になるよ"},
        { "location": "449/TALK"    , "narrator": "神楽", "text": "ぶちまければいいのかな"},
        { "location": "450/TALK"    , "narrator": "神楽", "text": "でも"},
        { "location": "451/TALK"    , "narrator": "神楽", "text": "そんなものすらないし"},
        { "location": "453/TALK"    , "narrator": "神楽", "text": "だからもうぴょんこなんていなくなってもいいと思う"},
        { "location": "454/TALK"    , "narrator": "神楽", "text": "いいでしょ？"},
        { "location": "455/TALK"    , "narrator": "神楽", "text": "いいよね！！！"},
        { "location": "457/SEL"     , "narrator": "", "text": "いやだ"},
        { "location": "458/SEL"     , "narrator": "", "text": "ずっといてよ"},
        { "location": "459/SEL"     , "narrator": "", "text": "それはよくない"},
        { "location": "460/ACT"     , "narrator": "", "text": "いやだ"},
        { "location": "461/TALK"    , "narrator": "神楽", "text": "そう言ってくれるのは"},
        { "location": "462/TALK"    , "narrator": "神楽", "text": "$handle$だけだとしても？"},
        { "location": "463/ACT"     , "narrator": "", "text": "ずっといてよ"},
        { "location": "464/TALK"    , "narrator": "神楽", "text": "そんなこと言うの"},
        { "location": "465/TALK"    , "narrator": "神楽", "text": "$handle$だけなんだよ？"},
        { "location": "466/ACT"     , "narrator": "", "text": "それはよくない"},
        { "location": "467/TALK"    , "narrator": "神楽", "text": "えっらそー！"},
        { "location": "468/TALK"    , "narrator": "神楽", "text": "禁止した！！！"},
        { "location": "479/TALK"    , "narrator": "神楽", "text": "でも"},
        { "location": "480/TALK"    , "narrator": "神楽", "text": "ぴょんこにはもう"},
        { "location": "482/TALK"    , "narrator": "神楽", "text": "$handle$しかいない、、、"},
        { "location": "485/TALK"    , "narrator": "ボイスメール", "text": "ひとつだけ"},
        { "location": "497/DIALOG"  , "narrator": "Dialog_GETVoice", "text": "<color=green>【神楽】</color>のボイスメール\n<color=red>【ひとつだけ】</color>\nをゲットしました！"}
    ]
}
