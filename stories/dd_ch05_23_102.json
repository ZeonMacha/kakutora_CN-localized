{
    "dir": "chap23/daydra/dd_ch05_23_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "23505",
        "cid": "kagura",
        "title": "005 メインストーリー",
        "sub_title": "パーフェクト撤退＜後編＞"
    },
    "entry":
    [
        { "location": "2869/TALK"  , "narrator": "千羽鶴", "text": "…なるほど。"},
        { "location": "2870/TALK"  , "narrator": "千羽鶴", "text": "予想はしていたけど、\n現在の卯月神楽の\n精神状態は――"},
        { "location": "2871/TALK"  , "narrator": "千羽鶴", "text": "かなりマズい状況\nということか…。"},
        { "location": "2873/TALK"  , "narrator": "千羽鶴", "text": "…まあ、無理もない。"},
        { "location": "2874/TALK"  , "narrator": "千羽鶴", "text": "卯月神楽は、\n全世界を救うために\n必要な――"},
        { "location": "2875/TALK"  , "narrator": "千羽鶴", "text": "私と、エンタングルに\nとっての、生け贄の\n巫女なのだから…。"},
        { "location": "2876/TALK"  , "narrator": "千羽鶴", "text": "彼らと私では、\n救いの方向はまったく\n違っているけど。"},
        { "location": "2877/TALK"  , "narrator": "千羽鶴", "text": "彼女の犠牲によって\n世界全体に利益を\nもたらそうとする。"},
        { "location": "2878/TALK"  , "narrator": "千羽鶴", "text": "功利主義…その局地\nとも言える行為。"},
        { "location": "2879/TALK"  , "narrator": "千羽鶴", "text": "けれど、最高率の\n世界選択法なのは\n間違いない。"},
        { "location": "2880/TALK"  , "narrator": "千羽鶴", "text": "エンタングルも、\n私と同じでそう思った\nに違いない…。"},
        { "location": "2882/TALK"  , "narrator": "千羽鶴", "text": "…………。"},
        { "location": "2883/TALK"  , "narrator": "千羽鶴", "text": "そう、この方法こそ\n最高率の方法…。"},
        { "location": "2884/TALK"  , "narrator": "千羽鶴", "text": "なのに、胸騒ぎを\n覚えるのは、なぜ？"},
        { "location": "2885/TALK"  , "narrator": "千羽鶴", "text": "計画に関する穴を、\n無意識が見つけた\nから？"},
        { "location": "2887/TALK"  , "narrator": "千羽鶴", "text": "…いや、なんども\n考えたけれど、\n穴はないはず。"},
        { "location": "2888/TALK"  , "narrator": "千羽鶴", "text": "他に考えられると\nすると、\nこれは――"},
        { "location": "2894/TALK"  , "narrator": "千羽鶴", "text": "ッ！？"},
        { "location": "2895/TALK"  , "narrator": "パイロット", "text": "地上での交戦を確認！\n長官、衝撃に\n備えてください！"},
        { "location": "2897/TALK"  , "narrator": "千羽鶴", "text": "交戦…マズい。"},
        { "location": "2898/TALK"  , "narrator": "千羽鶴", "text": "逢瀬つばめ以外の誰一人、\nここで失うわけには\nいかない。"},
        { "location": "2899/TALK"  , "narrator": "千羽鶴", "text": "けど、彼女たちが四人で\n力を合わせたとしても。"},
        { "location": "2900/TALK"  , "narrator": "千羽鶴", "text": "卯月神楽のスピネルに\n耐えられる可能性は\nゼロに近い…。"},
        { "location": "2901/TALK"  , "narrator": "千羽鶴", "text": "いや、戦意のない\n逢瀬つばめをフォロー\nしながらとなると。"},
        { "location": "2902/TALK"  , "narrator": "千羽鶴", "text": "戦力は、それよりも\n遙かに落ちる。"},
        { "location": "2903/TALK"  , "narrator": "千羽鶴", "text": "卯月神楽も、\n今の状態では容赦する\nとは考えられない…。"},
        { "location": "2905/TALK"  , "narrator": "千羽鶴", "text": "…ドーム戦の二の舞。\nそれは、マズい。"},
        { "location": "2906/TALK"  , "narrator": "千羽鶴", "text": "…………。"},
        { "location": "2908/TALK"  , "narrator": "千羽鶴", "text": "…どうやら、\nタイムオーバー\nみたい。"},
        { "location": "2910/TALK"  , "narrator": "千羽鶴", "text": "パイロット。\nオープンホールの\n準備。"},
        { "location": "2911/TALK"  , "narrator": "千羽鶴", "text": "卯月神楽を、\n強制的に覚醒させる。"},
        { "location": "2912/TALK"  , "narrator": "パイロット", "text": "了解しました。"},
        { "location": "2914/TALK"  , "narrator": "千羽鶴", "text": "…仕切り直し、か。"},
        { "location": "2923/DIALOG", "narrator": "Dialog_chapter_ch05", "text": "【19 三戸浜からの手紙】"},
        { "location": "2935/DIALOG", "narrator": "Dialog_chapter_ch05", "text": "【19 三戸浜からの手紙】"}
    ]
}
