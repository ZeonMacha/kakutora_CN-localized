{
    "dir": "chap07/daydra/dd_ch04_07_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "7405",
        "cid": "miyabi",
        "title": "005 メインストーリー",
        "sub_title": "劇場の日常＜後編＞"
    },
    "entry":
    [
        { "location": "373/SCENARIO", "narrator": "", "text": "劇場の日常"},
        { "location": "389/TALK"    , "narrator": "みやび", "text": "…いや、やはり\nやめといた方が\nえいかもしれん。"},
        { "location": "390/TALK"    , "narrator": "みやび", "text": "ただでさえウサギは\nオーバーワーク状態\nなんやし――"},
        { "location": "391/TALK"    , "narrator": "みやび", "text": "これ以上負担を\n掛けるわけには\nいかんし。"},
        { "location": "392/TALK"    , "narrator": "みやび", "text": "…まあ、この件は\n保留っちゅうことに\nしとくか。"},
        { "location": "393/SEL"     , "narrator": "", "text": "そろそろ楽屋に戻らない？"},
        { "location": "394/ACT"     , "narrator": "", "text": "そろそろ楽屋に戻らない？"},
        { "location": "413/TALK"    , "narrator": "みやび", "text": "そういえば"},
        { "location": "414/TALK"    , "narrator": "みやび", "text": "大分時間が経っちょるな"},
        { "location": "415/TALK"    , "narrator": "みやび", "text": "チャットに夢中になってたか"},
        { "location": "416/TALK"    , "narrator": "みやび", "text": "ならば、現実へ戻ろう"},
        { "location": "417/TALK"    , "narrator": "みやび", "text": "さらば電脳ワールド"},
        { "location": "428/TALK"    , "narrator": "みやび", "text": "また連絡する、と。"},
        { "location": "467/TALK"    , "narrator": "みやび", "text": "…おつかれ。"},
        { "location": "470/TALK"    , "narrator": "アーヤ", "text": "ああ、みやび。\nまたネット見たり\nしてたんでしょ？"},
        { "location": "471/TALK"    , "narrator": "みやび", "text": "やることはちゃんと\nやったき、何も問題\nないちや。"},
        { "location": "473/TALK"    , "narrator": "みやび", "text": "それにしても…、\n楽屋がこざっぱりした\n気がするがよ。"},
        { "location": "475/TALK"    , "narrator": "アーヤ", "text": "今、丁度その話を\nしてたところよ。"},
        { "location": "478/TALK"    , "narrator": "つばめ", "text": "どうですか、\nせんぱい？"},
        { "location": "481/TALK"    , "narrator": "ガブリエラ", "text": "…うん、問題なし。\nちゃんと全部あるわ。"},
        { "location": "482/TALK"    , "narrator": "ガブリエラ", "text": "新人にも、少しは\n物を見る目が出来て\nきたようね。"},
        { "location": "484/TALK"    , "narrator": "つばめ", "text": "ほっ、よかったぁ…。"},
        { "location": "486/TALK"    , "narrator": "みやび", "text": "…何やってるが？"},
        { "location": "488/TALK"    , "narrator": "アーヤ", "text": "ほら、前につばめが\n楽屋掃除した時――"},
        { "location": "489/TALK"    , "narrator": "アーヤ", "text": "ギャヴィの私物を\n捨てちゃったことが\nあったでしょ？"},
        { "location": "490/TALK"    , "narrator": "アーヤ", "text": "だから、自分の物が\n捨てられてないか\n確認してたのよ。"},
        { "location": "492/TALK"    , "narrator": "みやび", "text": "なるほどなぁ…。\nけんど、ここにある\nガブちゃんの私物――"},
        { "location": "496/TALK"    , "narrator": "みやび", "text": "うちには、ゴミにしか\n見えんけんどね。"},
        { "location": "499/TALK"    , "narrator": "ガブリエラ", "text": "失礼ね。\nこれのどこが\nゴミなのよ？"},
        { "location": "501/TALK"    , "narrator": "みやび", "text": "じゃあ、そこにある\n空になったたこ焼きの\n器は？"},
        { "location": "502/TALK"    , "narrator": "ガブリエラ", "text": "ゴミじゃないわ。\n船の形してる、\n珍しい物なんだから。"},
        { "location": "504/TALK"    , "narrator": "みやび", "text": "…そんな珍しいとは\n思えんのやが。"},
        { "location": "506/TALK"    , "narrator": "アーヤ", "text": "このボロ衣は何？"},
        { "location": "508/TALK"    , "narrator": "ガブリエラ", "text": "それは前にフリマで\n買ったものよ。"},
        { "location": "509/TALK"    , "narrator": "ガブリエラ", "text": "着物の生地で作った、\n手作りハンカチ、って\n言ってたわ。"},
        { "location": "511/TALK"    , "narrator": "みやび", "text": "…何故よりによって\n着物生地で作るが？"},
        { "location": "515/TALK"    , "narrator": "ガブリエラ", "text": "知らないわよ。\n売ってた人が作った\nものなんだから。"},
        { "location": "519/TALK"    , "narrator": "つばめ", "text": "でも、ちゃんと見ると\n素敵な物もあります\nよね。"},
        { "location": "521/TALK"    , "narrator": "ガブリエラ", "text": "えっ？"},
        { "location": "522/TALK"    , "narrator": "つばめ", "text": "正直、わたしにも\nよくわからない物は\n沢山ありますけど――"},
        { "location": "525/TALK"    , "narrator": "つばめ", "text": "でも、さっきの\nハンカチとかは、\n素敵と思いました。"},
        { "location": "526/TALK"    , "narrator": "ガブリエラ", "text": "そ、そう…。\n素敵だと思ったんだ？"},
        { "location": "527/TALK"    , "narrator": "ガブリエラ", "text": "そんな風に褒めて\nもらったのって、\n初めてだわ…。"},
        { "location": "529/TALK"    , "narrator": "ガブリエラ", "text": "でも、当然のこと\n言われても嬉しく\nないから！"},
        { "location": "531/TALK"    , "narrator": "つばめ", "text": "あ、あはは…。"},
        { "location": "534/TALK"    , "narrator": "アーヤ", "text": "…まあ、つばめの\n言うこともわから\nなくはないかも。"},
        { "location": "537/TALK"    , "narrator": "アーヤ", "text": "あそこに飾ってある\nひな人形なんか、\n結構素敵だし。"},
        { "location": "541/TALK"    , "narrator": "みやび", "text": "かなりの年代物みたい\nやけんど…どこで\n見つけたが？"},
        { "location": "543/TALK"    , "narrator": "ガブリエラ", "text": "トップシークレットに\n決まってるでしょ。\n誰にも教えないわ。"},
        { "location": "544/TALK"    , "narrator": "ガブリエラ", "text": "でも、地道に自分の\n足を使って探し回った\n結果、かしら？"},
        { "location": "550/TALK"    , "narrator": "つばめ", "text": "ふふっ、こんなに\n色んな物を見つけて\nくるなんて――"},
        { "location": "551/TALK"    , "narrator": "つばめ", "text": "なんか、光る物を\n拾ってきちゃう、\n鳥さんみたいですね。"},
        { "location": "555/TALK"    , "narrator": "ガブリエラ", "text": "そうそう、鳥のように\nあちこちを探し\nまわって――"},
        { "location": "556/TALK"    , "narrator": "ガブリエラ", "text": "…鳥？"},
        { "location": "559/TALK"    , "narrator": "つばめ", "text": "はい、鳥です。"},
        { "location": "562/TALK"    , "narrator": "ガブリエラ", "text": "………………。"},
        { "location": "566/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "569/TALK"    , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "570/TALK"    , "narrator": "ガブリエラ", "text": "あ…あ、あ――"},
        { "location": "575/TALK"    , "narrator": "ガブリエラ", "text": "あたしは\nアホな鳥か！？"},
        { "location": "582/TALK"    , "narrator": "つばめ", "text": "えぇっ！？\nアホじゃなくて、\n可愛い鳥さんですよ！"},
        { "location": "585/TALK"    , "narrator": "ガブリエラ", "text": "光る物を拾ってくる\n鳥なんて、アホに\n決まってるでしょ！？"},
        { "location": "590/TALK"    , "narrator": "ガブリエラ", "text": "まったく、\n新人のバカ！\n大っ嫌い！！"},
        { "location": "595/TALK"    , "narrator": "つばめ", "text": "あっ、せんぱい！"},
        { "location": "597/TALK"    , "narrator": "つばめ", "text": "…誤解なのにぃ。"},
        { "location": "601/TALK"    , "narrator": "アーヤ", "text": "え、えっと…、\n大丈夫よ、逢瀬さん。"},
        { "location": "602/TALK"    , "narrator": "アーヤ", "text": "ギャヴィの癇癪は\nいつものことだから、\nね？"},
        { "location": "603/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "605/TALK"    , "narrator": "みやび", "text": "…本当、この子は\n天然さんやねぇ。"},
        { "location": "607/TALK"    , "narrator": "みやび", "text": "ガブちゃんも\nペース狂わされて\n大変そうや。"},
        { "location": "608/SEL"     , "narrator": "", "text": "つばめは、多分敵じゃないかも"},
        { "location": "609/ACT"     , "narrator": "", "text": "つばめは、多分敵じゃないかも"},
        { "location": "630/TALK"    , "narrator": "みやび", "text": "これはビックリ"},
        { "location": "632/TALK"    , "narrator": "みやび", "text": "相棒もあの子疑うてたが？"},
        { "location": "634/SEL"     , "narrator": "", "text": "謎の多い子だから、一応ね"},
        { "location": "635/SEL"     , "narrator": "", "text": "無闇に信じるのは危険だよ"},
        { "location": "636/ACT"     , "narrator": "", "text": "謎の多い子だから、一応ね"},
        { "location": "637/TALK"    , "narrator": "みやび", "text": "つばめちゃんだけやない"},
        { "location": "638/TALK"    , "narrator": "みやび", "text": "卯月も同じくらい謎だらけ"},
        { "location": "639/TALK"    , "narrator": "みやび", "text": "うちにはＵＭＡも同然やき"},
        { "location": "640/TALK"    , "narrator": "みやび", "text": "無闇に信じるんは、危険や"},
        { "location": "641/ACT"     , "narrator": "", "text": "無闇に信じるのは危険だよ"},
        { "location": "642/TALK"    , "narrator": "みやび", "text": "その通り"},
        { "location": "643/TALK"    , "narrator": "みやび", "text": "うちも、つばめちゃんは卯月はもちろん"},
        { "location": "644/TALK"    , "narrator": "みやび", "text": "正直"},
        { "location": "645/TALK"    , "narrator": "みやび", "text": "アーヤもガブちゃんも"},
        { "location": "646/TALK"    , "narrator": "みやび", "text": "心から信用してはおらん"},
        { "location": "647/TALK"    , "narrator": "みやび", "text": "みんな、何かしら謎を抱えちょるき"},
        { "location": "649/TALK"    , "narrator": "みやび", "text": "しかし驚いた"},
        { "location": "650/TALK"    , "narrator": "みやび", "text": "相棒もうちと同じで"},
        { "location": "651/TALK"    , "narrator": "みやび", "text": "無闇に信じたりせんとは"},
        { "location": "652/TALK"    , "narrator": "みやび", "text": "うちと相棒は"},
        { "location": "653/TALK"    , "narrator": "みやび", "text": "相思相愛？"},
        { "location": "654/TALK"    , "narrator": "みやび", "text": "それは言い過ぎ"},
        { "location": "655/TALK"    , "narrator": "みやび", "text": "以心伝心？"},
        { "location": "656/TALK"    , "narrator": "みやび", "text": "それも言い過ぎ"},
        { "location": "657/TALK"    , "narrator": "みやび", "text": "気が合う"},
        { "location": "658/TALK"    , "narrator": "みやび", "text": "それやね"},
        { "location": "660/TALK"    , "narrator": "みやび", "text": "そんな相棒にお悩みチャット相談"},
        { "location": "661/TALK"    , "narrator": "みやび", "text": "うちは今"},
        { "location": "662/TALK"    , "narrator": "みやび", "text": "みんなの秘密を知るために"},
        { "location": "663/TALK"    , "narrator": "みやび", "text": "裏で色々しちょるところで"},
        { "location": "664/TALK"    , "narrator": "みやび", "text": "仲間を大募集中だったりするちや"},
        { "location": "665/TALK"    , "narrator": "みやび", "text": "つまり"},
        { "location": "666/TALK"    , "narrator": "みやび", "text": "相棒をスカウトしよう思うてるんやが"},
        { "location": "668/SEL"     , "narrator": "", "text": "プライバシーの侵害にならないレベルなら"},
        { "location": "669/ACT"     , "narrator": "", "text": "プライバシーの侵害にならないレベルなら"},
        { "location": "671/TALK"    , "narrator": "みやび", "text": "それで構わん"},
        { "location": "672/TALK"    , "narrator": "みやび", "text": "とりあえず"},
        { "location": "673/TALK"    , "narrator": "みやび", "text": "話は決まりや"},
        { "location": "674/TALK"    , "narrator": "みやび", "text": "これからは、まあ"},
        { "location": "675/TALK"    , "narrator": "みやび", "text": "もうちくっと仲良くしような"},
        { "location": "677/TALK"    , "narrator": "みやび", "text": "あぼん"},
        { "location": "678/TALK"    , "narrator": "みやび", "text": "すまんミスタッチ"},
        { "location": "679/TALK"    , "narrator": "みやび", "text": "相棒"},
        { "location": "700/DIALOG"  , "narrator": "Dialog_chapter_ch04", "text": "【05 金色の髪のカグラ】"}
    ]
}
