        { "location": "7/SCENARIO", "narrator": "", "text": "260_無関係な関係"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "相棒と話すようになって"},
        { "location": "33/TALK"   , "narrator": "みやび", "text": "結構な時間が過ぎたな"},
        { "location": "35/SEL"    , "narrator": "", "text": "かもね"},
        { "location": "36/SEL"    , "narrator": "", "text": "そうでもないよ"},
        { "location": "37/SEL"    , "narrator": "", "text": "これから先の方がずっと長くなるよ"},
        { "location": "38/ACT"    , "narrator": "", "text": "かもね"},
        { "location": "39/TALK"   , "narrator": "みやび", "text": "余裕ぶって"},
        { "location": "40/TALK"   , "narrator": "みやび", "text": "$handle$のくせに"},
        { "location": "41/TALK"   , "narrator": "みやび", "text": "生意気だの"},
        { "location": "42/ACT"    , "narrator": "", "text": "そうでもないよ"},
        { "location": "43/TALK"   , "narrator": "みやび", "text": "ややや"},
        { "location": "44/TALK"   , "narrator": "みやび", "text": "それは"},
        { "location": "45/TALK"   , "narrator": "みやび", "text": "残念じゃの"},
        { "location": "46/ACT"    , "narrator": "", "text": "これから先の方がずっと長くなるよ"},
        { "location": "56/TALK"   , "narrator": "みやび", "text": "ほう"},
        { "location": "58/SEL"    , "narrator": "", "text": "少なくとも$me$はそのつもり"},
        { "location": "59/SEL"    , "narrator": "", "text": "$me$はみやびを離さない"},
        { "location": "60/SEL"    , "narrator": "", "text": "そうだよね？"},
        { "location": "61/ACT"    , "narrator": "", "text": "少なくとも$me$はそのつもり"},
        { "location": "62/TALK"   , "narrator": "みやび", "text": "そうなのか"},
        { "location": "63/TALK"   , "narrator": "みやび", "text": "そうか"},
        { "location": "64/TALK"   , "narrator": "みやび", "text": "うーむ"},
        { "location": "65/ACT"    , "narrator": "", "text": "$me$はみやびを離さない"},
        { "location": "66/TALK"   , "narrator": "みやび", "text": "なんと"},
        { "location": "68/TALK"   , "narrator": "みやび", "text": "これは"},
        { "location": "69/TALK"   , "narrator": "みやび", "text": "そういうことか"},
        { "location": "70/ACT"    , "narrator": "", "text": "そうだよね？"},
        { "location": "71/TALK"   , "narrator": "みやび", "text": "いや"},
        { "location": "72/TALK"   , "narrator": "みやび", "text": "聞かれても"},
        { "location": "73/TALK"   , "narrator": "みやび", "text": "どうなのか"},
        { "location": "76/SEL"    , "narrator": "", "text": "$me$はみやびと共にある"},
        { "location": "77/SEL"    , "narrator": "", "text": "一緒に歩いて行こうよ"},
        { "location": "78/SEL"    , "narrator": "", "text": "恋ってそういうものでしょ"},
        { "location": "79/ACT"    , "narrator": "", "text": "$me$はみやびと共にある"},
        { "location": "80/TALK"   , "narrator": "みやび", "text": "それはまたまた大仰な"},
        { "location": "81/ACT"    , "narrator": "", "text": "一緒に歩いて行こうよ"},
        { "location": "82/TALK"   , "narrator": "みやび", "text": "ほのぼの系か"},
        { "location": "83/TALK"   , "narrator": "みやび", "text": "散歩がしたいだけなのか"},
        { "location": "85/TALK"   , "narrator": "みやび", "text": "微妙ぞね"},
        { "location": "86/ACT"    , "narrator": "", "text": "恋ってそういうものでしょ"},
        { "location": "87/TALK"   , "narrator": "みやび", "text": "そんなものはない"},
        { "location": "88/TALK"   , "narrator": "みやび", "text": "ないぞ"},
        { "location": "89/TALK"   , "narrator": "みやび", "text": "ないのだ"},
        { "location": "91/TALK"   , "narrator": "みやび", "text": "$handle$にとって"},
        { "location": "92/TALK"   , "narrator": "みやび", "text": "時間とは何か"},
        { "location": "94/SEL"    , "narrator": "", "text": "積み上げていくもの"},
        { "location": "95/SEL"    , "narrator": "", "text": "情報通信研究機構が決定・維持するもの"},
        { "location": "96/SEL"    , "narrator": "", "text": "気がついたら過ぎてるもの"},
        { "location": "97/ACT"    , "narrator": "", "text": "積み上げていくもの"},
        { "location": "98/TALK"   , "narrator": "みやび", "text": "なるほど"},
        { "location": "99/TALK"   , "narrator": "みやび", "text": "歴史を感じるの"},
        { "location": "100/ACT"   , "narrator": "", "text": "情報通信研究機構が決定・維持するもの"},
        { "location": "103/TALK"  , "narrator": "みやび", "text": "日本標準時が$handle$の時間か"},
        { "location": "104/TALK"  , "narrator": "みやび", "text": "ふむ"},
        { "location": "105/ACT"   , "narrator": "", "text": "気がついたら過ぎてるもの"},
        { "location": "106/TALK"  , "narrator": "みやび", "text": "ああ"},
        { "location": "107/TALK"  , "narrator": "みやび", "text": "昼寝の時などはことにそうなるの"},
        { "location": "108/TALK"  , "narrator": "みやび", "text": "あれは何なんだ"},
        { "location": "110/TALK"  , "narrator": "みやび", "text": "そして時に思うのは"},
        { "location": "111/TALK"  , "narrator": "みやび", "text": "タイムリープができたなら"},
        { "location": "112/TALK"  , "narrator": "みやび", "text": "変えられる運命があるのではということだ"},
        { "location": "114/SEL"   , "narrator": "", "text": "$me$は何度でもみやびに巡り会うよ"},
        { "location": "115/SEL"   , "narrator": "", "text": "変えられないからこそ運命"},
        { "location": "116/SEL"   , "narrator": "", "text": "SFは苦手なんだ"},
        { "location": "117/ACT"   , "narrator": "", "text": "$me$は何度でもみやびに巡り会うよ"},
        { "location": "118/TALK"  , "narrator": "みやび", "text": "わー"},
        { "location": "119/TALK"  , "narrator": "みやび", "text": "ロマンチックー"},
        { "location": "120/ACT"   , "narrator": "", "text": "変えられないからこそ運命"},
        { "location": "121/TALK"  , "narrator": "みやび", "text": "まあ"},
        { "location": "122/TALK"  , "narrator": "みやび", "text": "そういうものかもしれん"},
        { "location": "123/ACT"   , "narrator": "", "text": "SFは苦手なんだ"},
        { "location": "124/TALK"  , "narrator": "みやび", "text": "なんと"},
        { "location": "125/TALK"  , "narrator": "みやび", "text": "この世界に存在しながら"},
        { "location": "126/TALK"  , "narrator": "みやび", "text": "そうなのか"},
        { "location": "128/TALK"  , "narrator": "みやび", "text": "まあこれからも"},
        { "location": "129/TALK"  , "narrator": "みやび", "text": "よろしくだ"},
        { "location": "131/TALK"  , "narrator": "みやび", "text": "相棒"},
