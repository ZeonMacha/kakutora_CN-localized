{
    "dir": "chap15/daydra/dd_ch03_15_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "15305",
        "cid": "gabriella",
        "title": "005 メインストーリー",
        "sub_title": "話せない理由＜後編＞"
    },
    "entry":
    [
        { "location": "730/TALK"   , "narrator": "ガブリエラ", "text": "正直に話すわ、$marzanna$"},
        { "location": "731/TALK"   , "narrator": "ガブリエラ", "text": "あなたの言う通りよ"},
        { "location": "733/TALK"   , "narrator": "ガブリエラ", "text": "私"},
        { "location": "734/TALK"   , "narrator": "ガブリエラ", "text": "心因性の失声症なの"},
        { "location": "735/TALK"   , "narrator": "ガブリエラ", "text": "だから"},
        { "location": "736/TALK"   , "narrator": "ガブリエラ", "text": "話せなくて"},
        { "location": "738/SEL"    , "narrator": "", "text": "男の子とだけ話せないの？"},
        { "location": "739/ACT"    , "narrator": "", "text": "男の子とだけ話せないの？"},
        { "location": "741/TALK"   , "narrator": "ガブリエラ", "text": "子供は平気よ"},
        { "location": "742/TALK"   , "narrator": "ガブリエラ", "text": "この前も保育園で普通に話せたし"},
        { "location": "743/TALK"   , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "744/TALK"   , "narrator": "ガブリエラ", "text": "ある程度の年齢から上の男の人が相手だと"},
        { "location": "745/TALK"   , "narrator": "ガブリエラ", "text": "話せなくなってしまうの"},
        { "location": "748/TALK"   , "narrator": "ガブリエラ", "text": "怖いわけじゃないし"},
        { "location": "749/TALK"   , "narrator": "ガブリエラ", "text": "話したいと思ってはいるのよ？"},
        { "location": "750/TALK"   , "narrator": "ガブリエラ", "text": "けれど"},
        { "location": "751/TALK"   , "narrator": "ガブリエラ", "text": "頑張っても全然声が出なくて"},
        { "location": "752/TALK"   , "narrator": "ガブリエラ", "text": "治そうとも思ったけど"},
        { "location": "753/TALK"   , "narrator": "ガブリエラ", "text": "精神的なものだから"},
        { "location": "754/TALK"   , "narrator": "ガブリエラ", "text": "薬でどうにかなるようなものじゃないし"},
        { "location": "756/SEL"    , "narrator": "", "text": "そういうことだったのか"},
        { "location": "757/ACT"    , "narrator": "", "text": "そういうことだったのか"},
        { "location": "759/TALK"   , "narrator": "ガブリエラ", "text": "そうなの"},
        { "location": "760/TALK"   , "narrator": "ガブリエラ", "text": "でもそのせいで話せないから"},
        { "location": "761/TALK"   , "narrator": "ガブリエラ", "text": "みんなに男性恐怖症と間違われて"},
        { "location": "765/TALK"   , "narrator": "ガブリエラ", "text": "$marzanna$は間違えないで"},
        { "location": "766/TALK"   , "narrator": "ガブリエラ", "text": "ちゃんと理解してくれてるのね"},
        { "location": "767/TALK"   , "narrator": "ガブリエラ", "text": "とっても嬉しいわ////"},
        { "location": "772/SEL"    , "narrator": "", "text": "今の状況を何とかしないと"},
        { "location": "773/ACT"    , "narrator": "", "text": "今の状況を何とかしないと"},
        { "location": "775/TALK"   , "narrator": "ガブリエラ", "text": "そうだったわ"},
        { "location": "777/TALK"   , "narrator": "ガブリエラ", "text": "協力してもらえる？"},
        { "location": "779/SEL"    , "narrator": "", "text": "$me$が代わりに答える"},
        { "location": "780/ACT"    , "narrator": "", "text": "$me$が代わりに答える"},
        { "location": "782/TALK"   , "narrator": "ガブリエラ", "text": "頼りにしてるわ"},
        { "location": "793/TALK"   , "narrator": "ガブリエラ", "text": "…本当、頼りにしてる\nからね、$marzanna$。"},
        { "location": "794/SEL"    , "narrator": "", "text": "端末操作：アラーム"},
        { "location": "795/ACT"    , "narrator": "", "text": "端末操作：アラーム"},
        { "location": "802/TALK"   , "narrator": "キリト", "text": "うわっ！？\nビックリしたぁ…。"},
        { "location": "805/TALK"   , "narrator": "ヒカル", "text": "電話…いや、アラーム\nかな？"},
        { "location": "806/TALK"   , "narrator": "ガブリエラ", "text": "こっち向いてくれた。\nよーし！"},
        { "location": "811/SEL"    , "narrator": "", "text": "喋れないのには理由がある"},
        { "location": "812/ACT"    , "narrator": "", "text": "喋れないのには理由がある"},
        { "location": "815/TALK"   , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "817/TALK"   , "narrator": "ヒカル", "text": "えっと…、喋れない\nのには理由がある…？"},
        { "location": "818/TALK"   , "narrator": "ヒカル", "text": "やっぱり…、そういう\nことだったんですね。"},
        { "location": "819/TALK"   , "narrator": "キリト", "text": "いや、納得するには\n早いだろ？"},
        { "location": "820/TALK"   , "narrator": "キリト", "text": "その理由ってのは\n何なんだ？"},
        { "location": "823/TALK"   , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "824/TALK"   , "narrator": "ガブリエラ", "text": "本当、遠慮なく\n聞いてくるん\nだから…。"},
        { "location": "825/TALK"   , "narrator": "ガブリエラ", "text": "まあ、嫌いじゃない\nけどね…。"},
        { "location": "826/SEL"    , "narrator": "", "text": "声に呪いが掛かってるから"},
        { "location": "827/SEL"    , "narrator": "", "text": "美声過ぎて男を魅了するから"},
        { "location": "828/SEL"    , "narrator": "", "text": "今は待ってほしい"},
        { "location": "829/ACT"    , "narrator": "", "text": "声に呪いが掛かってるから"},
        { "location": "833/TALK"   , "narrator": "ガブリエラ", "text": "…は？"},
        { "location": "834/TALK"   , "narrator": "キリト", "text": "…の、呪い？"},
        { "location": "836/TALK"   , "narrator": "ヒカル", "text": "え、えっと…。"},
        { "location": "838/TALK"   , "narrator": "ガブリエラ", "text": "ちょ、$marzanna$！？\n何言おうとしてるの！？"},
        { "location": "840/TALK"   , "narrator": "キリト", "text": "あー、の、呪いかぁ…。\n男と話せなくなる的な\nヤツか？"},
        { "location": "841/TALK"   , "narrator": "ガブリエラ", "text": "ど、どうするのよ\n$marzanna$！"},
        { "location": "842/SEL"    , "narrator": "", "text": "私と話した男は三日後に死んでしまう"},
        { "location": "843/ACT"    , "narrator": "", "text": "私と話した男は三日後に死んでしまう"},
        { "location": "845/TALK"   , "narrator": "ガブリエラ", "text": "！？"},
        { "location": "846/TALK"   , "narrator": "キリト", "text": "ぶふっ！！"},
        { "location": "847/TALK"   , "narrator": "ヒカル", "text": "お、思った以上に\n強力な呪いですね…。"},
        { "location": "849/TALK"   , "narrator": "キリト", "text": "呪いってかこれもう、\n即死系魔法だろ…。"},
        { "location": "851/TALK"   , "narrator": "ガブリエラ", "text": "$marzanna$ッ！！\nどうするのよこの状況！？"},
        { "location": "852/TALK"   , "narrator": "キリト", "text": "…まあ、言えない理由が\nあるのはわかったけど、\nこれは逆効果だと思うぞ？"},
        { "location": "853/TALK"   , "narrator": "ヒカル", "text": "うん…この理由だと、\nちょっとだけ\n気になっちゃうよね。"},
        { "location": "854/TALK"   , "narrator": "キリト", "text": "呪いは大げさにしても、\n何かしらありそうな気が\nしてくるよな。"},
        { "location": "855/TALK"   , "narrator": "キリト", "text": "…ガブリエラ。\n一言でいいから、\n何か言ってもらえるか？"},
        { "location": "857/TALK"   , "narrator": "ガブリエラ", "text": "逆効果になってる\nじゃない！！"},
        { "location": "858/TALK"   , "narrator": "ヒカル", "text": "…………。"},
        { "location": "860/TALK"   , "narrator": "ヒカル", "text": "…あ、キリト。\n教官に倉庫整理を\n頼まれてたでしょ？"},
        { "location": "861/TALK"   , "narrator": "ヒカル", "text": "お客さんもいないし、\n今のうちにやった方が\nいいんじゃない？"},
        { "location": "864/TALK"   , "narrator": "キリト", "text": "ん…そうだな。\n忘れて説教食らう方が、\n呪いより怖いし。"},
        { "location": "865/TALK"   , "narrator": "ヒカル", "text": "そういうわけだから\nガブリエラさん、\nあとはお願いします。"},
        { "location": "876/TALK"   , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "877/TALK"   , "narrator": "ガブリエラ", "text": "さて、と。"},
        { "location": "891/TALK"   , "narrator": "ガブリエラ", "text": "どうして適当なことを言うの？"},
        { "location": "892/TALK"   , "narrator": "ガブリエラ", "text": "原因は心因性失声症だって自分で言ったでしょう？"},
        { "location": "893/TALK"   , "narrator": "ガブリエラ", "text": "なのに"},
        { "location": "894/TALK"   , "narrator": "ガブリエラ", "text": "呪いって何！？"},
        { "location": "895/TALK"   , "narrator": "ガブリエラ", "text": "これじゃただの妄想癖のある女の子じゃない！"},
        { "location": "896/TALK"   , "narrator": "ガブリエラ", "text": "これからどんな顔して二人に会えばいいのよ？"},
        { "location": "897/TALK"   , "narrator": "ガブリエラ", "text": "$marzanna$のバカ！"},
        { "location": "908/ACT"    , "narrator": "", "text": "美声過ぎて男を魅了するから"},
        { "location": "910/TALK"   , "narrator": "ガブリエラ", "text": "！？"},
        { "location": "911/TALK"   , "narrator": "ガブリエラ", "text": "$marzanna$！？\n何言ってるのよー！"},
        { "location": "914/TALK"   , "narrator": "キリト", "text": "…いや、うん。"},
        { "location": "915/TALK"   , "narrator": "キリト", "text": "まあ、ガブリエラの\n声って、確かに綺麗\nだったよな？"},
        { "location": "916/TALK"   , "narrator": "ヒカル", "text": "うん、僕もそう思う。"},
        { "location": "917/TALK"   , "narrator": "キリト", "text": "けどなぁ…さすがに\nこれは言い過ぎじゃ\nねぇかぁ？"},
        { "location": "919/TALK"   , "narrator": "ガブリエラ", "text": "っ！？"},
        { "location": "921/TALK"   , "narrator": "キリト", "text": "まあ、あれだ。\n声だけじゃ魅了するには\n足りないな。"},
        { "location": "922/TALK"   , "narrator": "キリト", "text": "でも、もうちっと胸が\n大きくなったら、\nマジでそうなんじゃね？"},
        { "location": "923/TALK"   , "narrator": "ガブリエラ", "text": "む、胸！？"},
        { "location": "926/TALK"   , "narrator": "ヒカル", "text": "ちょ！？　キリト、\n女の子にそういうこと\n言うのは――"},
        { "location": "928/TALK"   , "narrator": "キリト", "text": "いや、男を魅了する\nためには必要だと\n思うぞ？"},
        { "location": "930/TALK"   , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "932/TALK"   , "narrator": "ヒカル", "text": "え、えっと…。"},
        { "location": "933/TALK"   , "narrator": "ヒカル", "text": "そうだ！\n倉庫整理、今のうちに\nやっちゃおうよ。"},
        { "location": "934/TALK"   , "narrator": "キリト", "text": "別に今じゃなくても\nいいだろ。"},
        { "location": "935/TALK"   , "narrator": "ヒカル", "text": "忘れて東雲教官に\n怒られるよりは\nいいと思うけど？"},
        { "location": "936/TALK"   , "narrator": "ヒカル", "text": "そういうわけだから\nガブリエラさん、\nあとはお願いします。"},
        { "location": "937/TALK"   , "narrator": "キリト", "text": "はぁ…仕方ねぇなぁ。"},
        { "location": "948/TALK"   , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "949/TALK"   , "narrator": "ガブリエラ", "text": "さて、と。"},
        { "location": "961/TALK"   , "narrator": "ガブリエラ", "text": "弁解があれば聞いてあげるわ"},
        { "location": "964/SEL"    , "narrator": "", "text": "ごめんなさい"},
        { "location": "965/ACT"    , "narrator": "", "text": "ごめんなさい"},
        { "location": "967/TALK"   , "narrator": "ガブリエラ", "text": "さすがに"},
        { "location": "968/TALK"   , "narrator": "ガブリエラ", "text": "いきなり謝られるとは思わなかったわ"},
        { "location": "969/TALK"   , "narrator": "ガブリエラ", "text": "っていうか"},
        { "location": "970/TALK"   , "narrator": "ガブリエラ", "text": "この件でふざけるのは本当やめて！"},
        { "location": "971/TALK"   , "narrator": "ガブリエラ", "text": "ヒカルくん達とまともに喋れないこと"},
        { "location": "972/TALK"   , "narrator": "ガブリエラ", "text": "本当に辛いと思ってるんだから"},
        { "location": "974/SEL"    , "narrator": "", "text": "ふざけ過ぎた、ごめん"},
        { "location": "975/ACT"    , "narrator": "", "text": "ふざけ過ぎた、ごめん"},
        { "location": "978/TALK"   , "narrator": "ガブリエラ", "text": "もういいけど"},
        { "location": "979/TALK"   , "narrator": "ガブリエラ", "text": "今回だけよ？"},
        { "location": "990/ACT"    , "narrator": "", "text": "今は待ってほしい"},
        { "location": "992/TALK"   , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "994/TALK"   , "narrator": "キリト", "text": "今は、待ってほしい？"},
        { "location": "996/TALK"   , "narrator": "ヒカル", "text": "…………。"},
        { "location": "998/TALK"   , "narrator": "キリト", "text": "よくわからないけど、\nマジで今はダメなのか？"},
        { "location": "1000/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "1001/TALK"  , "narrator": "キリト", "text": "…マジみてぇだな。"},
        { "location": "1002/TALK"  , "narrator": "ヒカル", "text": "でも、待ってほしいって\n言ってもらえたのは\nよかったよ。"},
        { "location": "1003/TALK"  , "narrator": "ヒカル", "text": "それって、いつかは\n話せる日が来る、って\nことだと思うし。"},
        { "location": "1004/TALK"  , "narrator": "ヒカル", "text": "でしょ？\nガブリエラさん。"},
        { "location": "1006/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "1007/TALK"  , "narrator": "ヒカル", "text": "ね？　それがわかった\nだけでも、今はいいん\nじゃないかな？"},
        { "location": "1008/TALK"  , "narrator": "キリト", "text": "…そうだな。"},
        { "location": "1009/TALK"  , "narrator": "キリト", "text": "あんまし女の子\n急かすのも\nかっこ悪ぃもんな。"},
        { "location": "1010/TALK"  , "narrator": "ヒカル", "text": "だね。"},
        { "location": "1011/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "1012/TALK"  , "narrator": "ガブリエラ", "text": "よかった…。\n納得してくれた\nみたい。"},
        { "location": "1014/TALK"  , "narrator": "ヒカル", "text": "それよりキリト、\n東雲教官に倉庫整理\n頼まれてたでしょ？"},
        { "location": "1015/TALK"  , "narrator": "ヒカル", "text": "お客さんもいないし、\n今のうちにやった方が\nいいんじゃない？"},
        { "location": "1016/TALK"  , "narrator": "キリト", "text": "そうだな。\n忘れたりしたら\n超怒られそうだし。"},
        { "location": "1017/TALK"  , "narrator": "ヒカル", "text": "ガブリエラさん。\nすみませんが、\nあとは任せますね。"},
        { "location": "1028/TALK"  , "narrator": "ガブリエラ", "text": "よかった…。\n理由があるのだけは\nわかってもらえて…。"},
        { "location": "1040/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$、どうもありがとう"},
        { "location": "1041/TALK"  , "narrator": "ガブリエラ", "text": "上手く私の気持ち"},
        { "location": "1042/TALK"  , "narrator": "ガブリエラ", "text": "二人に伝えてくれたわね"},
        { "location": "1044/SEL"   , "narrator": "", "text": "理由を話すのは任せたよ"},
        { "location": "1045/ACT"   , "narrator": "", "text": "理由を話すのは任せたよ"},
        { "location": "1047/TALK"  , "narrator": "ガブリエラ", "text": "わかってるわ"},
        { "location": "1048/TALK"  , "narrator": "ガブリエラ", "text": "そこまで$marzanna$に任せられないわ"},
        { "location": "1049/TALK"  , "narrator": "ガブリエラ", "text": "それは私が"},
        { "location": "1050/TALK"  , "narrator": "ガブリエラ", "text": "自分の言葉で伝えないといけないことだものね"},
        { "location": "1053/TALK"  , "narrator": "ガブリエラ", "text": "そのときはもちろん"},
        { "location": "1054/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$も側で見守ってくれるわよね？"},
        { "location": "1056/SEL"   , "narrator": "", "text": "もちろんだよ"},
        { "location": "1057/ACT"   , "narrator": "", "text": "もちろんだよ"},
        { "location": "1059/TALK"  , "narrator": "ガブリエラ", "text": "ありがとう"},
        { "location": "1060/TALK"  , "narrator": "ガブリエラ", "text": "それを聞けて安心したわ"},
        { "location": "1073/TALK"  , "narrator": "ガブリエラ", "text": "ふぅ…。"},
        { "location": "1074/TALK"  , "narrator": "ガブリエラ", "text": "…ヒカルくんにも、\n結構気を使わせ\nちゃったなぁ。"},
        { "location": "1075/TALK"  , "narrator": "ガブリエラ", "text": "でも、ちゃんと理由を\n話せてないあたしの\nことを――"},
        { "location": "1076/TALK"  , "narrator": "ガブリエラ", "text": "何も聞かずに\nフォローしてくれる\nなんて…。"},
        { "location": "1077/TALK"  , "narrator": "ガブリエラ", "text": "…ヒカルくんって、\nいい人よね…。"},
        { "location": "1078/TALK"  , "narrator": "ガブリエラ", "text": "っ！？"},
        { "location": "1079/TALK"  , "narrator": "ガブリエラ", "text": "い、いけない！\nつい声に\n出しちゃった！"},
        { "location": "1081/TALK"  , "narrator": "ガブリエラ", "text": "もぅ、何やってんの\nかしら、あたし…。"},
        { "location": "1092/DIALOG", "narrator": "Dialog_chapter_ch03", "text": "【12 ピクシャル】"}
    ]
}
