    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "非公開でお願いします"},
        { "location": "16/TALK"   , "narrator": "神楽", "text": "$handle$はさ？"},
        { "location": "17/TALK"   , "narrator": "神楽", "text": "私と一緒に\n緩やかに続いていく日常を\n選んでくれたでしょ。"},
        { "location": "18/TALK"   , "narrator": "神楽", "text": "私、それって実は\n奇跡なんだなって\n思ってる。"},
        { "location": "19/SEL"    , "narrator": "", "text": "$me$も"},
        { "location": "20/SEL"    , "narrator": "", "text": "そうかな～"},
        { "location": "21/SEL"    , "narrator": "", "text": "続けていこうよ"},
        { "location": "22/ACT"    , "narrator": "", "text": "$me$も"},
        { "location": "23/TALK"   , "narrator": "神楽", "text": "やっぱりそう思う？"},
        { "location": "24/ACT"    , "narrator": "", "text": "そうかな～"},
        { "location": "26/TALK"   , "narrator": "神楽", "text": "えー？"},
        { "location": "27/TALK"   , "narrator": "神楽", "text": "当たり前すぎるって\n思ってる？"},
        { "location": "28/TALK"   , "narrator": "神楽", "text": "だったら一回\nリセットして……。"},
        { "location": "29/TALK"   , "narrator": "神楽", "text": "ってウソウソ！\nそんなのやっぱりやだ！"},
        { "location": "30/TALK"   , "narrator": "神楽", "text": "もー！\n変なこと言わせないで！"},
        { "location": "31/ACT"    , "narrator": "", "text": "続けていこうよ"},
        { "location": "33/TALK"   , "narrator": "神楽", "text": "うん！"},
        { "location": "34/TALK"   , "narrator": "神楽", "text": "そうしよう！"},
        { "location": "37/TALK"   , "narrator": "神楽", "text": "それでね……。"},
        { "location": "38/TALK"   , "narrator": "神楽", "text": "そんな日々に入る前に\nやっぱりけじめ的な\nことがしたいなって。"},
        { "location": "39/SEL"    , "narrator": "", "text": "成人式かな？"},
        { "location": "40/SEL"    , "narrator": "", "text": "襲名披露？"},
        { "location": "41/SEL"    , "narrator": "", "text": "なんでも付き合うよ"},
        { "location": "42/SEL"    , "narrator": "", "text": "期待していいのかな…"},
        { "location": "43/ACT"    , "narrator": "", "text": "成人式かな？"},
        { "location": "44/TALK"   , "narrator": "神楽", "text": "なんでそうなるの……。"},
        { "location": "45/ACT"    , "narrator": "", "text": "襲名披露？"},
        { "location": "47/TALK"   , "narrator": "神楽", "text": "二代目ぴょんこ参上！"},
        { "location": "48/TALK"   , "narrator": "神楽", "text": "って何させるの！？"},
        { "location": "49/ACT"    , "narrator": "", "text": "なんでも付き合うよ"},
        { "location": "50/TALK"   , "narrator": "神楽", "text": "うん。\nありがとう。"},
        { "location": "51/ACT"    , "narrator": "", "text": "期待していいのかな…"},
        { "location": "52/TALK"   , "narrator": "神楽", "text": "多分ね？"},
        { "location": "55/TALK"   , "narrator": "神楽", "text": "えっと……。"},
        { "location": "56/TALK"   , "narrator": "神楽", "text": "えっとね？"},
        { "location": "57/TALK"   , "narrator": "神楽", "text": "その……。"},
        { "location": "58/TALK"   , "narrator": "神楽", "text": "あーどうしよう……。\nやっぱり照れる～！！！"},
        { "location": "59/SEL"    , "narrator": "", "text": "頑張って！"},
        { "location": "60/SEL"    , "narrator": "", "text": "レア神楽かわいい！"},
        { "location": "61/SEL"    , "narrator": "", "text": "さっさと言って"},
        { "location": "62/SEL"    , "narrator": "", "text": "これは期待できる"},
        { "location": "63/SEL"    , "narrator": "", "text": "じゃあまた今度でも"},
        { "location": "64/ACT"    , "narrator": "", "text": "頑張って！"},
        { "location": "65/TALK"   , "narrator": "神楽", "text": "えっあっ……。"},
        { "location": "67/TALK"   , "narrator": "神楽", "text": "もー！\nがんばるし！"},
        { "location": "68/ACT"    , "narrator": "", "text": "レア神楽かわいい！"},
        { "location": "69/TALK"   , "narrator": "神楽", "text": "てへぺろ！"},
        { "location": "70/TALK"   , "narrator": "神楽", "text": "とかじゃなくてー！"},
        { "location": "71/ACT"    , "narrator": "", "text": "さっさと言って"},
        { "location": "72/TALK"   , "narrator": "神楽", "text": "えっなんか……\n冷たいね……。"},
        { "location": "73/TALK"   , "narrator": "神楽", "text": "$handle$のバカ！\nバカー！"},
        { "location": "74/ACT"    , "narrator": "", "text": "これは期待できる"},
        { "location": "75/TALK"   , "narrator": "神楽", "text": "えっなんか上から目線？\n$handle$生意気！"},
        { "location": "76/ACT"    , "narrator": "", "text": "じゃあまた今度でも"},
        { "location": "78/TALK"   , "narrator": "神楽", "text": "何それ？\n気を遣ったつもり？"},
        { "location": "79/TALK"   , "narrator": "神楽", "text": "わかってないー！"},
        { "location": "82/TALK"   , "narrator": "神楽", "text": "そのさ……。"},
        { "location": "83/TALK"   , "narrator": "神楽", "text": "結婚式とか\nしたいなって……。"},
        { "location": "84/SEL"    , "narrator": "", "text": "$me$と！？"},
        { "location": "85/SEL"    , "narrator": "", "text": "はい喜んで！"},
        { "location": "86/SEL"    , "narrator": "", "text": "やっとここまで来た……"},
        { "location": "87/SEL"    , "narrator": "", "text": "こちらこそよろしく"},
        { "location": "88/SEL"    , "narrator": "", "text": "大事なところだよね"},
        { "location": "89/ACT"    , "narrator": "", "text": "$me$と！？"},
        { "location": "90/TALK"   , "narrator": "神楽", "text": "他に誰がいるの？"},
        { "location": "91/ACT"    , "narrator": "", "text": "はい喜んで！"},
        { "location": "92/TALK"   , "narrator": "神楽", "text": "居酒屋みたいじゃない？"},
        { "location": "93/ACT"    , "narrator": "", "text": "やっとここまで来た……"},
        { "location": "94/TALK"   , "narrator": "神楽", "text": "やっとって言うかー…。"},
        { "location": "95/ACT"    , "narrator": "", "text": "こちらこそよろしく"},
        { "location": "96/TALK"   , "narrator": "神楽", "text": "……。"},
        { "location": "97/TALK"   , "narrator": "神楽", "text": "はい。"},
        { "location": "98/ACT"    , "narrator": "", "text": "大事なところだよね"},
        { "location": "99/TALK"   , "narrator": "神楽", "text": "うん。\nすごく大事なところ。"},
        { "location": "102/SEL"   , "narrator": "", "text": "やっぱりシャンパンタワー？"},
        { "location": "103/SEL"   , "narrator": "", "text": "ゴンドラスモークだよね！"},
        { "location": "104/SEL"   , "narrator": "", "text": "象に乗って登場！"},
        { "location": "105/SEL"   , "narrator": "", "text": "スピーチ考えなきゃ……"},
        { "location": "106/SEL"   , "narrator": "", "text": "希望とかある？"},
        { "location": "107/ACT"   , "narrator": "", "text": "やっぱりシャンパンタワー？"},
        { "location": "108/TALK"  , "narrator": "神楽", "text": "ホストクラブじゃ\nないんだから……。"},
        { "location": "109/ACT"   , "narrator": "", "text": "ゴンドラスモークだよね！"},
        { "location": "110/TALK"  , "narrator": "神楽", "text": "本当にそんな式あるの？"},
        { "location": "111/ACT"   , "narrator": "", "text": "象に乗って登場！"},
        { "location": "112/TALK"  , "narrator": "神楽", "text": "バーチャルだったら\nありだけどー。"},
        { "location": "113/ACT"   , "narrator": "", "text": "スピーチ考えなきゃ……"},
        { "location": "114/TALK"  , "narrator": "神楽", "text": "それはちょっと\n聞きたいかも……。"},
        { "location": "115/ACT"   , "narrator": "", "text": "希望とかある？"},
        { "location": "116/TALK"  , "narrator": "神楽", "text": "……聞いてくれる？"},
        { "location": "119/TALK"  , "narrator": "神楽", "text": "えっとね……。"},
        { "location": "120/TALK"  , "narrator": "神楽", "text": "私、プライベートでは\nあんまり派手なこと\nしたくないの。"},
        { "location": "121/TALK"  , "narrator": "神楽", "text": "二人の気持ちが\n再確認できることが\n一番大事だし。"},
        { "location": "122/TALK"  , "narrator": "神楽", "text": "極々シンプルで\nいいと思ってる。"},
        { "location": "123/SEL"   , "narrator": "", "text": "わかる"},
        { "location": "124/SEL"   , "narrator": "", "text": "神楽がそう言うなら"},
        { "location": "125/SEL"   , "narrator": "", "text": "少しは盛り上げたい"},
        { "location": "126/ACT"   , "narrator": "", "text": "わかる"},
        { "location": "128/TALK"  , "narrator": "神楽", "text": "わかってくれる？"},
        { "location": "129/ACT"   , "narrator": "", "text": "神楽がそう言うなら"},
        { "location": "130/TALK"  , "narrator": "神楽", "text": "$handle$は？"},
        { "location": "131/ACT"   , "narrator": "", "text": "少しは盛り上げたい"},
        { "location": "132/TALK"  , "narrator": "神楽", "text": "……すごくじゃなくても\nいいでしょ？"},
        { "location": "135/TALK"  , "narrator": "神楽", "text": "でね、考えてみた。"},
        { "location": "136/TALK"  , "narrator": "神楽", "text": "シンプルだけど\n確実な約束ができるのは\nどこだろうって。"},
        { "location": "137/SEL"   , "narrator": "", "text": "どこだった？"},
        { "location": "138/SEL"   , "narrator": "", "text": "$me$の胸の中でしょ！"},
        { "location": "139/SEL"   , "narrator": "", "text": "裁判所かな"},
        { "location": "140/ACT"   , "narrator": "", "text": "どこだった？"},
        { "location": "141/TALK"  , "narrator": "神楽", "text": "どこだと思う？"},
        { "location": "142/ACT"   , "narrator": "", "text": "$me$の胸の中でしょ！"},
        { "location": "143/TALK"  , "narrator": "神楽", "text": "上手いこと言った\nつもりなんでしょ！"},
        { "location": "144/TALK"  , "narrator": "神楽", "text": "……もー……！"},
        { "location": "145/ACT"   , "narrator": "", "text": "裁判所かな"},
        { "location": "147/TALK"  , "narrator": "神楽", "text": "ないし！\nそれはないし！"},
        { "location": "150/TALK"  , "narrator": "神楽", "text": "……なんて。\n確実な約束なんて\n存在しないよね。"},
        { "location": "151/SEL"   , "narrator": "", "text": "その話はもうやめよう"},
        { "location": "152/SEL"   , "narrator": "", "text": "それでも意味はあるって結論でしょ"},
        { "location": "153/SEL"   , "narrator": "", "text": "それでも神楽と約束したいよ"},
        { "location": "154/ACT"   , "narrator": "", "text": "その話はもうやめよう"},
        { "location": "155/TALK"  , "narrator": "神楽", "text": "…うん。"},
        { "location": "156/ACT"   , "narrator": "", "text": "それでも意味はあるって結論でしょ"},
        { "location": "157/TALK"  , "narrator": "神楽", "text": "だよね。"},
        { "location": "158/ACT"   , "narrator": "", "text": "それでも神楽と約束したいよ"},
        { "location": "159/TALK"  , "narrator": "神楽", "text": "ありがとう。"},
        { "location": "162/TALK"  , "narrator": "神楽", "text": "約束の場所の\n話だったよね。"},
        { "location": "163/TALK"  , "narrator": "神楽", "text": "ハネムーンを兼ねて\n江の島に行きたいなって\n思ってる。"},
        { "location": "164/TALK"  , "narrator": "神楽", "text": "どう？"},
        { "location": "165/SEL"   , "narrator": "", "text": "決まってたのか……"},
        { "location": "166/SEL"   , "narrator": "", "text": "なんでそのチョイス？"},
        { "location": "167/SEL"   , "narrator": "", "text": "どこへなりとも、神楽様"},
        { "location": "168/ACT"   , "narrator": "", "text": "決まってたのか……"},
        { "location": "169/TALK"  , "narrator": "神楽", "text": "ダメだった？"},
        { "location": "170/SEL"   , "narrator": "", "text": "そうじゃないけど"},
        { "location": "171/SEL"   , "narrator": "", "text": "ちょっと相談してほしかったかも"},
        { "location": "172/SEL"   , "narrator": "", "text": "単に感想"},
        { "location": "173/ACT"   , "narrator": "", "text": "そうじゃないけど"},
        { "location": "174/TALK"  , "narrator": "神楽", "text": "そうなの？"},
        { "location": "175/ACT"   , "narrator": "", "text": "ちょっと相談してほしかったかも"},
        { "location": "176/TALK"  , "narrator": "神楽", "text": "今してるしー。"},
        { "location": "177/ACT"   , "narrator": "", "text": "単に感想"},
        { "location": "178/TALK"  , "narrator": "神楽", "text": "ふうん？"},
        { "location": "180/ACT"   , "narrator": "", "text": "なんでそのチョイス？"},
        { "location": "181/TALK"  , "narrator": "神楽", "text": "いいところだから？"},
        { "location": "182/SEL"   , "narrator": "", "text": "聞き返されても"},
        { "location": "183/SEL"   , "narrator": "", "text": "いいところなのかー"},
        { "location": "184/SEL"   , "narrator": "", "text": "よし任せた！"},
        { "location": "185/ACT"   , "narrator": "", "text": "聞き返されても"},
        { "location": "186/TALK"  , "narrator": "神楽", "text": "ダメだった？"},
        { "location": "187/ACT"   , "narrator": "", "text": "いいところなのかー"},
        { "location": "188/TALK"  , "narrator": "神楽", "text": "いいところみたいよ？"},
        { "location": "189/ACT"   , "narrator": "", "text": "よし任せた！"},
        { "location": "191/TALK"  , "narrator": "神楽", "text": "やったー！"},
        { "location": "193/ACT"   , "narrator": "", "text": "どこへなりとも、神楽様"},
        { "location": "195/TALK"  , "narrator": "神楽", "text": "ふふふ。\n付いてらっしゃい？"},
        { "location": "196/SEL"   , "narrator": "", "text": "ブヒー！"},
        { "location": "197/SEL"   , "narrator": "", "text": "よろしくー"},
        { "location": "198/SEL"   , "narrator": "", "text": "キャラ作りすぎ…"},
        { "location": "199/ACT"   , "narrator": "", "text": "ブヒー！"},
        { "location": "200/TALK"  , "narrator": "神楽", "text": "よしよし♪"},
        { "location": "201/ACT"   , "narrator": "", "text": "よろしくー"},
        { "location": "202/TALK"  , "narrator": "神楽", "text": "意外と適当？"},
        { "location": "203/ACT"   , "narrator": "", "text": "キャラ作りすぎ…"},
        { "location": "204/TALK"  , "narrator": "神楽", "text": "本当は好きなくせに！"},
        { "location": "208/TALK"  , "narrator": "神楽", "text": "約束をした本人も\n探さなきゃわからなく\nなるような。"},
        { "location": "209/TALK"  , "narrator": "神楽", "text": "でも重い約束が\nできる場所があるの。"},
        { "location": "210/TALK"  , "narrator": "神楽", "text": "そういうのって\n$handle$と\n私らしいなって思って。"},
        { "location": "211/SEL"   , "narrator": "", "text": "わかる！"},
        { "location": "212/SEL"   , "narrator": "", "text": "じゃあ行ってみる"},
        { "location": "213/SEL"   , "narrator": "", "text": "もっと軽くてもいいよ？"},
        { "location": "214/ACT"   , "narrator": "", "text": "わかる！"},
        { "location": "216/TALK"  , "narrator": "神楽", "text": "やっぱり？\nよかったー。"},
        { "location": "217/ACT"   , "narrator": "", "text": "じゃあ行ってみる"},
        { "location": "218/TALK"  , "narrator": "神楽", "text": "前向きだね。\nそういうとこ好き。"},
        { "location": "219/ACT"   , "narrator": "", "text": "もっと軽くてもいいよ？"},
        { "location": "220/TALK"  , "narrator": "神楽", "text": "それじゃ安心できない。\n私ってそんな\n面倒なヒトだから…。"},
        { "location": "223/TALK"  , "narrator": "神楽", "text": "一緒に来て\nくれるよね？"},
        { "location": "224/SEL"   , "narrator": "", "text": "一応ね"},
        { "location": "225/SEL"   , "narrator": "", "text": "行くってば"},
        { "location": "226/SEL"   , "narrator": "", "text": "連れてって！"},
        { "location": "227/ACT"   , "narrator": "", "text": "一応ね"},
        { "location": "229/TALK"  , "narrator": "神楽", "text": "あっ偉そう！"},
        { "location": "230/TALK"  , "narrator": "神楽", "text": "でもいいよ\n私にしか見せない\n顔だと思ってるから。"},
        { "location": "231/ACT"   , "narrator": "", "text": "行くってば"},
        { "location": "232/TALK"  , "narrator": "神楽", "text": "面倒くさいって\n思ってるのかな？"},
        { "location": "233/TALK"  , "narrator": "神楽", "text": "そういうの\n照れ隠しだって\n知ってるけどね♪"},
        { "location": "234/ACT"   , "narrator": "", "text": "連れてって！"},
        { "location": "235/TALK"  , "narrator": "神楽", "text": "よしよし\n素直でいいね。"},
        { "location": "236/TALK"  , "narrator": "神楽", "text": "かわいいね\n$handle$♪"},
        { "location": "15/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>某月某日　1:26 PM</color>\n神楽の家でのこと"}
    ]
