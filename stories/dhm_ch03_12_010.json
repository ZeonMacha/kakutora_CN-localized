    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "006_秘密はここだけ"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "ねえマルザンナ"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "本当はね"},
        { "location": "34/TALK"   , "narrator": "ガブリエラ", "text": "私にも友達はいるのよ"},
        { "location": "36/SEL"    , "narrator": "", "text": "え、誰のこと？"},
        { "location": "37/SEL"    , "narrator": "", "text": "雛達でしょ？"},
        { "location": "38/SEL"    , "narrator": "", "text": "クラスメイト？"},
        { "location": "39/ACT"    , "narrator": "", "text": "え、誰のこと？"},
        { "location": "40/TALK"   , "narrator": "ガブリエラ", "text": "ひなこと繭のことよ"},
        { "location": "41/TALK"   , "narrator": "ガブリエラ", "text": "年上の友達がいるのよ"},
        { "location": "42/TALK"   , "narrator": "ガブリエラ", "text": "すごいでしょう？"},
        { "location": "44/SEL"    , "narrator": "", "text": "アーヤは？"},
        { "location": "45/SEL"    , "narrator": "", "text": "つばめは？"},
        { "location": "46/SEL"    , "narrator": "", "text": "よかったね"},
        { "location": "47/ACT"    , "narrator": "", "text": "アーヤは？"},
        { "location": "48/TALK"   , "narrator": "ガブリエラ", "text": "アーヤは"},
        { "location": "49/TALK"   , "narrator": "ガブリエラ", "text": "友達というのとは少し違うわ"},
        { "location": "51/TALK"   , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "52/TALK"   , "narrator": "ガブリエラ", "text": "アーヤが私のことを友達って言うなら"},
        { "location": "54/TALK"   , "narrator": "ガブリエラ", "text": "認めてあげるわ"},
        { "location": "55/ACT"    , "narrator": "", "text": "つばめは？"},
        { "location": "56/TALK"   , "narrator": "ガブリエラ", "text": "あの子は違うわ"},
        { "location": "57/TALK"   , "narrator": "ガブリエラ", "text": "年上だけど後輩だもの"},
        { "location": "58/ACT"    , "narrator": "", "text": "よかったね"},
        { "location": "59/TALK"   , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "60/TALK"   , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "61/TALK"   , "narrator": "ガブリエラ", "text": "マルザンナも私の大事なお友達だわ"},
        { "location": "62/TALK"   , "narrator": "ガブリエラ", "text": "そのことは忘れないでね"},
        { "location": "64/ACT"    , "narrator": "", "text": "雛達でしょ？"},
        { "location": "66/TALK"   , "narrator": "ガブリエラ", "text": "あら"},
        { "location": "67/TALK"   , "narrator": "ガブリエラ", "text": "わかっちゃったかしらｖｖｖｖ"},
        { "location": "68/TALK"   , "narrator": "ガブリエラ", "text": "マルザンナにもお友達に見えるってことよね///////"},
        { "location": "70/TALK"   , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "71/TALK"   , "narrator": "ガブリエラ", "text": "マルザンナも私の大事なお友達だわ"},
        { "location": "72/TALK"   , "narrator": "ガブリエラ", "text": "そのことは忘れないでね"},
        { "location": "73/TALK"   , "narrator": "ガブリエラ", "text": "だいすきよ"},
        { "location": "74/ACT"    , "narrator": "", "text": "クラスメイト？"},
        { "location": "76/TALK"   , "narrator": "ガブリエラ", "text": "えと"},
        { "location": "77/TALK"   , "narrator": "ガブリエラ", "text": "ね"},
        { "location": "79/TALK"   , "narrator": "ガブリエラ", "text": "クラスにはいないの"},
        { "location": "80/TALK"   , "narrator": "ガブリエラ", "text": "残念だわ"}
    ]
}
