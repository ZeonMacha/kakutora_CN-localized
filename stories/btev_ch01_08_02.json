    "entry":
    [
        { "location": "317/SCENARIO", "narrator": "", "text": "どきがむねむねする理由"},
        { "location": "331/TALK"    , "narrator": "潜在つばめ", "text": "まさか…\n私が負けるなんて…。"},
        { "location": "332/TALK"    , "narrator": "つばめ", "text": "当然だよ。\n卯月さんは\n都会の子だもん。"},
        { "location": "334/TALK"    , "narrator": "つばめ", "text": "わたしの常識を覆す\nことをやってこその\n卯月さんだよ！"},
        { "location": "335/SEL"     , "narrator": "（選択肢）", "text": "都会に対する偏見じゃない？"},
        { "location": "336/SEL"     , "narrator": "（選択肢）", "text": "そうだそうだ！"},
        { "location": "337/ACT"     , "narrator": "", "text": "都会に対する偏見じゃない？"},
        { "location": "339/TALK"    , "narrator": "つばめ", "text": "え？\nそ、そうかな？"},
        { "location": "341/TALK"    , "narrator": "潜在つばめ", "text": "$handle$さんの\n言う通りだよ。"},
        { "location": "345/TALK"    , "narrator": "潜在つばめ", "text": "それでも\n$handle$さんは\n私に敵対した。"},
        { "location": "346/TALK"    , "narrator": "潜在つばめ", "text": "まあ、もう消える\n身としては何を言っても\n仕方ないけどね。"},
        { "location": "347/ACT"     , "narrator": "", "text": "そうだそうだ！"},
        { "location": "350/TALK"    , "narrator": "つばめ", "text": "えへへ、気が合うね！"},
        { "location": "352/TALK"    , "narrator": "潜在つばめ", "text": "$handle$さんって\n都会に嫌な思い出が\nあるのかな…？"},
        { "location": "356/TALK"    , "narrator": "潜在つばめ", "text": "まあ、わたしに賛同\nしなかったわけだし\n何もぶれてないけど。"},
        { "location": "358/TALK"    , "narrator": "潜在つばめ", "text": "もうわたしは\nここにいる力は\nないけど――"},
        { "location": "360/TALK"    , "narrator": "潜在つばめ", "text": "卯月さんを変な妄想で\n汚すのは程々にしてね。"},
        { "location": "361/TALK"    , "narrator": "潜在つばめ", "text": "あなたがどう思おうとも\n卯月さんはピュアな\n子なんだから。"},
        { "location": "363/TALK"    , "narrator": "潜在つばめ", "text": "$handle$さんも\n最後の良心があるなら\n調子に乗らないでね？"},
        { "location": "373/TALK"    , "narrator": "つばめ", "text": "ふー。"},
        { "location": "376/TALK"    , "narrator": "つばめ", "text": "って！\nあれれ！？\nここはどこ？"},
        { "location": "381/TALK"    , "narrator": "神楽", "text": "ようこそ\nつばめさん！\n$handle$さん！"},
        { "location": "383/TALK"    , "narrator": "神楽", "text": "ここは\nカラオケボックス\nですよっ！"},
        { "location": "384/TALK"    , "narrator": "神楽", "text": "3人でちょっとドキドキ\nする遊びをするなら\n個室ですよね♪"},
        { "location": "387/TALK"    , "narrator": "つばめ", "text": "なるほど！\nそう言われるとなんか\nドキドキするね！"},
        { "location": "388/SEL"     , "narrator": "（選択肢）", "text": "何を歌うの？"},
        { "location": "389/SEL"     , "narrator": "（選択肢）", "text": "ドキがムネムネする！"},
        { "location": "390/ACT"     , "narrator": "", "text": "何を歌うの？"},
        { "location": "392/TALK"    , "narrator": "神楽", "text": "今日は、\n歌うよりも楽しい事を\nしちゃいます！"},
        { "location": "393/ACT"     , "narrator": "", "text": "ドキがムネムネする！"},
        { "location": "396/TALK"    , "narrator": "神楽", "text": "$handle$さん…\nネタがとっても\n古いですっ！！"},
        { "location": "397/TALK"    , "narrator": "神楽", "text": "今日は、\n歌うよりも楽しい事を\nしちゃいますよっ！"},
        { "location": "400/TALK"    , "narrator": "つばめ", "text": "えーっ、なにかな？\n楽しみ！"},
        { "location": "403/TALK"    , "narrator": "神楽", "text": "それはですね！"},
        { "location": "408/TALK"    , "narrator": "神楽", "text": "エアープレッツェル\nゲームでーす♪"},
        { "location": "410/TALK"    , "narrator": "つばめ", "text": "エアープレッツェル\nゲーム？"},
        { "location": "414/TALK"    , "narrator": "神楽", "text": "そうです！\nやり方は簡単ですよ？"},
        { "location": "415/TALK"    , "narrator": "神楽", "text": "誰か一人が棒状の\nプレッツェルを\n加えたフリをします！"},
        { "location": "416/TALK"    , "narrator": "神楽", "text": "そしてもう一人が、\nそれを食べるフリを\nします♪"},
        { "location": "419/TALK"    , "narrator": "神楽", "text": "最後まで全部\n食べちゃったら\n成功ですっ！"},
        { "location": "420/SEL"     , "narrator": "（選択肢）", "text": "それって…"},
        { "location": "421/ACT"     , "narrator": "", "text": "それって…"},
        { "location": "424/TALK"    , "narrator": "つばめ", "text": "わぁっ！\n楽しそうー！"},
        { "location": "428/TALK"    , "narrator": "神楽", "text": "それじゃ、まずは\n誰と誰でやりましょう？"},
        { "location": "429/SEL"     , "narrator": "（選択肢）", "text": "$me$とつばめ"},
        { "location": "430/SEL"     , "narrator": "（選択肢）", "text": "$me$と神楽"},
        { "location": "431/SEL"     , "narrator": "（選択肢）", "text": "つばめと神楽"},
        { "location": "432/ACT"     , "narrator": "", "text": "$me$とつばめ"},
        { "location": "433/TALK"    , "narrator": "つばめ", "text": "えええっ！　わたしと\n$handle$さん！？"},
        { "location": "434/TALK"    , "narrator": "神楽", "text": "とっても素敵です！"},
        { "location": "437/TALK"    , "narrator": "神楽", "text": "それでは第一ラウンド\nつばめさん×\n$handle$さん～♪"},
        { "location": "438/TALK"    , "narrator": "つばめ", "text": "え、ええっ？\n決定！？\nまだ心の準備が…"},
        { "location": "440/TALK"    , "narrator": "神楽", "text": "何言ってるんですか！\n勢いですよ！"},
        { "location": "441/TALK"    , "narrator": "つばめ", "text": "そそそうなの！？"},
        { "location": "442/TALK"    , "narrator": "神楽", "text": "そうですよっ！"},
        { "location": "443/TALK"    , "narrator": "神楽", "text": "それじゃつばめさん。\n$handle$さんと\n向き合ってくださーい！"},
        { "location": "449/TALK"    , "narrator": "つばめ", "text": "わっ！"},
        { "location": "450/TALK"    , "narrator": "神楽", "text": "次に、\n顔を近づけまーす！"},
        { "location": "453/TALK"    , "narrator": "つばめ", "text": "わあっ！！"},
        { "location": "454/TALK"    , "narrator": "神楽", "text": "つばめさんは\nプレッツェルを\n咥えるマネを――"},
        { "location": "455/TALK"    , "narrator": "神楽", "text": "$handle$さんは\n音楽が鳴ったらそれを\n食べ尽くしてください！"},
        { "location": "456/SEL"     , "narrator": "（選択肢）", "text": "は、はい！"},
        { "location": "457/SEL"     , "narrator": "（選択肢）", "text": "望むところ"},
        { "location": "458/ACT"     , "narrator": "", "text": "は、はい！"},
        { "location": "459/ACT"     , "narrator": "", "text": "望むところ"},
        { "location": "461/TALK"    , "narrator": "神楽", "text": "それじゃ行きますよ！"},
        { "location": "464/TALK"    , "narrator": "神楽", "text": "よーいっ！"},
        { "location": "466/TALK"    , "narrator": "神楽", "text": "ドーン！"},
        { "location": "471/DIALOG"  , "narrator": "", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "487/TALK"    , "narrator": "つばめ", "text": "ひああっ！"},
        { "location": "494/TALK"    , "narrator": "つばめ", "text": "ひああっ！"},
        { "location": "498/DIALOG"  , "narrator": "", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"},
        { "location": "506/TALK"    , "narrator": "神楽", "text": "はーい！\n合格でーす♪"},
        { "location": "508/TALK"    , "narrator": "つばめ", "text": "ななななんか\n当たっちゃった\nような……"},
        { "location": "509/TALK"    , "narrator": "神楽", "text": "つばめさん\n素敵なちゅー\nでしたよ♪"},
        { "location": "511/TALK"    , "narrator": "つばめ", "text": "ちがう！！"},
        { "location": "513/TALK"    , "narrator": "神楽", "text": "えっ？"},
        { "location": "514/SEL"     , "narrator": "（選択肢）", "text": "えっ！？"},
        { "location": "515/ACT"     , "narrator": "", "text": "えっ！？"},
        { "location": "517/TALK"    , "narrator": "つばめ", "text": "ちがうちがう！\n今はそうじゃないの！"},
        { "location": "518/TALK"    , "narrator": "つばめ", "text": "今じゃなければ\n$handle$さんとも\nやってみたいけど――"},
        { "location": "519/TALK"    , "narrator": "つばめ", "text": "今は、こういうことを\n望んでるわけじゃ\nないのー！"},
        { "location": "520/SEL"     , "narrator": "（選択肢）", "text": "えっ！？"},
        { "location": "521/ACT"     , "narrator": "", "text": "えっ！？"},
        { "location": "524/TALK"    , "narrator": "神楽", "text": "そうですよね、\nつばめさん。"},
        { "location": "526/TALK"    , "narrator": "つばめ", "text": "そうだよ！"},
        { "location": "527/SEL"     , "narrator": "（選択肢）", "text": "はっ？？"},
        { "location": "528/ACT"     , "narrator": "", "text": "はっ？？"},
        { "location": "531/TALK"    , "narrator": "つばめ", "text": "今日はもうおしまい！\n$handle$さんは\n帰って帰って！！"},
        { "location": "545/TALK"    , "narrator": "千羽鶴", "text": "追い出された。"},
        { "location": "546/SEL"     , "narrator": "（選択肢）", "text": "なんで？"},
        { "location": "547/ACT"     , "narrator": "", "text": "なんで？"},
        { "location": "549/TALK"    , "narrator": "千羽鶴", "text": "逢瀬つばめが望まない\n方向に、貴方が舵を\n切ったから。"},
        { "location": "550/TALK"    , "narrator": "千羽鶴", "text": "理不尽かもしれないけど\nここは彼女の世界。"},
        { "location": "551/TALK"    , "narrator": "千羽鶴", "text": "彼女にとって望まない\nことは、無理矢理矯正\nすることができる。"},
        { "location": "552/TALK"    , "narrator": "千羽鶴", "text": "まあ、彼女を理解する\n上での必要なことだと\n割り切った方がいい。"},
        { "location": "553/TALK"    , "narrator": "千羽鶴", "text": "現実と思って対応すると\n心に大きな穴を\n作ることになるかも。"},
        { "location": "554/TALK"    , "narrator": "千羽鶴", "text": "心を覗くということは\nそういうこと。"},
        { "location": "555/TALK"    , "narrator": "千羽鶴", "text": "覗いているつもりが、\n貴方が覗かれてた、\nなんてこともある。"},
        { "location": "556/TALK"    , "narrator": "千羽鶴", "text": "だから、心の中では\n大胆かつ慎重に。"},
        { "location": "557/TALK"    , "narrator": "千羽鶴", "text": "楽しめたかもしれない\nけれど、逢瀬つばめが\n望んだものではない。"},
        { "location": "558/TALK"    , "narrator": "千羽鶴", "text": "今度は今とは\n違う選択をしてみて。"},
        { "location": "574/ACT"     , "narrator": "", "text": "$me$と神楽"},
        { "location": "575/TALK"    , "narrator": "つばめ", "text": "えっ……"},
        { "location": "576/TALK"    , "narrator": "神楽", "text": "ええっ！？\n本気ですか？"},
        { "location": "577/SEL"     , "narrator": "（選択肢）", "text": "え？なんで？"},
        { "location": "578/ACT"     , "narrator": "", "text": "え？なんで？"},
        { "location": "581/TALK"    , "narrator": "つばめ", "text": "ひどいよ！\n$handle$さん！！"},
        { "location": "583/TALK"    , "narrator": "神楽", "text": "本当ですっ！\nまさに鬼畜！"},
        { "location": "584/SEL"     , "narrator": "（選択肢）", "text": "えっ！？えっ？？"},
        { "location": "585/ACT"     , "narrator": "", "text": "えっ！？えっ？？"},
        { "location": "587/TALK"    , "narrator": "つばめ", "text": "もういいよ！\n$handle$さんは\nここから出ていって！"},
        { "location": "601/TALK"    , "narrator": "千羽鶴", "text": "追い出された。"},
        { "location": "602/SEL"     , "narrator": "（選択肢）", "text": "なんで突然こんなことに"},
        { "location": "603/ACT"     , "narrator": "", "text": "なんで突然こんなことに"},
        { "location": "605/TALK"    , "narrator": "千羽鶴", "text": "はい。\nおさらいします。"},
        { "location": "606/TALK"    , "narrator": "千羽鶴", "text": "ここは逢瀬つばめの\nココロの中の世界。"},
        { "location": "607/TALK"    , "narrator": "千羽鶴", "text": "卯月神楽は\n逢瀬つばめの妄想。"},
        { "location": "608/TALK"    , "narrator": "千羽鶴", "text": "そんな中で、貴方が\n逢瀬つばめを選ばない\nということは……？"},
        { "location": "609/SEL"     , "narrator": "（選択肢）", "text": "つばめにとってはショックだね"},
        { "location": "610/SEL"     , "narrator": "（選択肢）", "text": "浮気だね"},
        { "location": "611/ACT"     , "narrator": "", "text": "つばめにとってはショックだね"},
        { "location": "612/TALK"    , "narrator": "千羽鶴", "text": "その通り。"},
        { "location": "613/ACT"     , "narrator": "", "text": "浮気だね"},
        { "location": "615/TALK"    , "narrator": "千羽鶴", "text": "自惚れすぎ。"},
        { "location": "617/TALK"    , "narrator": "千羽鶴", "text": "だから、貴方は\n追い出されて当然の\nことをした。"},
        { "location": "618/TALK"    , "narrator": "千羽鶴", "text": "ただそれだけのこと。"},
        { "location": "619/TALK"    , "narrator": "千羽鶴", "text": "まあ、一旦クールダウン\nして、再挑戦すると\nいいんじゃないかしら。"},
        { "location": "635/ACT"     , "narrator": "", "text": "つばめと神楽"},
        { "location": "637/TALK"    , "narrator": "つばめ", "text": "えええっ！　わたしと\n卯月さん！？"},
        { "location": "639/TALK"    , "narrator": "神楽", "text": "あー…\nそれはちょっと…"},
        { "location": "641/TALK"    , "narrator": "つばめ", "text": "え？"},
        { "location": "643/TALK"    , "narrator": "神楽", "text": "それはちょっと\nパスします♪"},
        { "location": "644/TALK"    , "narrator": "つばめ", "text": "えええええっ！！\nなんでなんで！？\nどうしてーっ！"},
        { "location": "645/SEL"     , "narrator": "（選択肢）", "text": "つばめ？？"},
        { "location": "646/ACT"     , "narrator": "", "text": "つばめ？？"},
        { "location": "650/TALK"    , "narrator": "神楽", "text": "なんでもどうしても、\n私たち、まだ出逢って\nすぐですよ？"},
        { "location": "651/TALK"    , "narrator": "神楽", "text": "プレッツェルゲームで\nうっかり唇を重ねちゃう\nような仲じゃないです。"},
        { "location": "652/TALK"    , "narrator": "つばめ", "text": "そ、そんなことないよ！"},
        { "location": "653/SEL"     , "narrator": "（選択肢）", "text": "ええっ？"},
        { "location": "654/ACT"     , "narrator": "", "text": "ええっ？"},
        { "location": "656/TALK"    , "narrator": "神楽", "text": "……。"},
        { "location": "658/TALK"    , "narrator": "つばめ", "text": "わたし何でもするから！\n卯月さんの好きな\nようにしていいから！"},
        { "location": "661/TALK"    , "narrator": "神楽", "text": "つばめさん……"},
        { "location": "662/TALK"    , "narrator": "つばめ", "text": "だからわたしから\n離れていかないで…"},
        { "location": "663/TALK"    , "narrator": "つばめ", "text": "お願い……。"},
        { "location": "664/SEL"     , "narrator": "（選択肢）", "text": "これって…"},
        { "location": "665/ACT"     , "narrator": "", "text": "これって…"},
        { "location": "668/TALK"    , "narrator": "神楽", "text": "そうですね…。\nこれは――"},
        { "location": "678/TALK"    , "narrator": "つばめ", "text": "まさか…\n私が負けるなんて…。"},
        { "location": "679/TALK"    , "narrator": "潜在つばめ", "text": "当然だよ。\n卯月さんはとっても\n清楚な子だもん。"},
        { "location": "680/TALK"    , "narrator": "潜在つばめ", "text": "３人で楽しい事しよう\nなんて、絶対に\n言わないんだから。"},
        { "location": "681/TALK"    , "narrator": "つばめ", "text": "そんなことないよ…\nだって、都会の子\nなんだよ？"},
        { "location": "682/SEL"     , "narrator": "（選択肢）", "text": "都会に対する偏見じゃない？"},
        { "location": "683/SEL"     , "narrator": "（選択肢）", "text": "そうだそうだ！"},
        { "location": "684/ACT"     , "narrator": "", "text": "都会に対する偏見じゃない？"},
        { "location": "687/TALK"    , "narrator": "つばめ", "text": "え？\nそ、そうかな？"},
        { "location": "688/ACT"     , "narrator": "", "text": "そうだそうだ！"},
        { "location": "689/TALK"    , "narrator": "つばめ", "text": "賛同するならどうして\n私に味方して\nくれなかったのかな。"},
        { "location": "693/TALK"    , "narrator": "つばめ", "text": "でももう、\n何を言っても\n遅いよね。"},
        { "location": "694/TALK"    , "narrator": "つばめ", "text": "わたしはもう\nこの世界から\n消える存在だもん。"},
        { "location": "696/TALK"    , "narrator": "つばめ", "text": "でもあなたの思ってる\n卯月さんは本物の\n卯月さんとは違うよ。"},
        { "location": "698/TALK"    , "narrator": "潜在つばめ", "text": "それはこっちの\nセリフだよ。"},
        { "location": "699/TALK"    , "narrator": "つばめ", "text": "そうかな。\nまあいいや。"},
        { "location": "701/TALK"    , "narrator": "つばめ", "text": "$handle$さん。\nあまりこのわたしを\n信用したらダメだよ？"},
        { "location": "710/TALK"    , "narrator": "つばめ", "text": "ふー。"},
        { "location": "713/TALK"    , "narrator": "つばめ", "text": "って！\nあれれ！？\n何この格好！！"},
        { "location": "719/TALK"    , "narrator": "神楽", "text": "つばめさん、その姿、\nとってもお似合い\nですよ？"},
        { "location": "721/TALK"    , "narrator": "神楽", "text": "私のシチュエーション\nセッティングは\n完璧ですっ！"},
        { "location": "723/TALK"    , "narrator": "つばめ", "text": "え？\n卯月さんが仕組んだの？\n元に戻してよー！"},
        { "location": "724/TALK"    , "narrator": "神楽", "text": "何を言ってるんですか。\n私とつばめさん――"},
        { "location": "725/TALK"    , "narrator": "神楽", "text": "これから２人きりで\n遊ぶんですよね？"},
        { "location": "727/TALK"    , "narrator": "つばめ", "text": "そ、そうだけど\nどうしてわたしばっか\nこんな赤裸々な……"},
        { "location": "728/SEL"     , "narrator": "（選択肢）", "text": "$me$も脱ぎます！"},
        { "location": "729/SEL"     , "narrator": "（選択肢）", "text": "つばめってそういう願望があったんだ"},
        { "location": "730/ACT"     , "narrator": "", "text": "$me$も脱ぎます！"},
        { "location": "732/TALK"    , "narrator": "神楽", "text": "ふふっ、\n$handle$さんも\n変態さんですねっ。"},
        { "location": "733/TALK"    , "narrator": "神楽", "text": "それでこそ、\nつばめさんとお似合いの\nカップルですよ？"},
        { "location": "734/TALK"    , "narrator": "つばめ", "text": "ええっ！？\nべ、別にそういう\n関係じゃないし……"},
        { "location": "736/TALK"    , "narrator": "神楽", "text": "そんなこと言っても、\n身体は全然拒んで\nいませんよ？"},
        { "location": "739/TALK"    , "narrator": "つばめ", "text": "そ、そんなことないよ！"},
        { "location": "740/ACT"     , "narrator": "", "text": "つばめってそういう願望があったんだ"},
        { "location": "741/TALK"    , "narrator": "神楽", "text": "ピンポーン！\nさすがは\n$handle$さん！"},
        { "location": "742/TALK"    , "narrator": "神楽", "text": "つばめさんのことと、\nココロの世界のこと、\nよく分かってますね！"},
        { "location": "745/TALK"    , "narrator": "神楽", "text": "私、\n分かっちゃったんです。"},
        { "location": "746/TALK"    , "narrator": "神楽", "text": "なぜつばめさんが、\n$handle$さんを\nここに呼んだのか。"},
        { "location": "747/TALK"    , "narrator": "神楽", "text": "それは、つばめさんが\n私にもっと色んなこと\nされたいってこと――"},
        { "location": "748/TALK"    , "narrator": "神楽", "text": "$handle$さんに\n知って欲しかった\nからですよね？"},
        { "location": "749/TALK"    , "narrator": "つばめ", "text": "えええええっ！\n全然ちがうよーっ！"},
        { "location": "750/TALK"    , "narrator": "神楽", "text": "本当ですか？"},
        { "location": "752/TALK"    , "narrator": "神楽", "text": "じゃあ私は不要な\nようですので、\n帰ることにしますね。"},
        { "location": "755/TALK"    , "narrator": "つばめ", "text": "ええっ！"},
        { "location": "759/TALK"    , "narrator": "つばめ", "text": "ま、待って卯月さん！\n何でもするからーっ！"},
        { "location": "761/TALK"    , "narrator": "神楽", "text": "ほら、やっぱり！\n今何でもするって\n言いましたよね？"},
        { "location": "763/TALK"    , "narrator": "つばめ", "text": "え、えっとそれは…"},
        { "location": "764/TALK"    , "narrator": "神楽", "text": "じゃあつばめさん。\n早速お願いが\nあるんですけど――"},
        { "location": "765/TALK"    , "narrator": "神楽", "text": "そのバスタオルを\nここで、かわいく\n脱いで下さい♪"},
        { "location": "767/TALK"    , "narrator": "つばめ", "text": "ええええええっ！！"},
        { "location": "768/TALK"    , "narrator": "神楽", "text": "……嫌ですか？"},
        { "location": "769/TALK"    , "narrator": "つばめ", "text": "えっ……"},
        { "location": "770/TALK"    , "narrator": "つばめ", "text": "えっと……"},
        { "location": "771/TALK"    , "narrator": "神楽", "text": "……。"},
        { "location": "773/TALK"    , "narrator": "つばめ", "text": "卯月さんが、\nそれで喜んで\nくれるなら――"},
        { "location": "774/TALK"    , "narrator": "つばめ", "text": "……いいよ？"},
        { "location": "775/SEL"     , "narrator": "（選択肢）", "text": "ちょ、ちょっと待て！"},
        { "location": "776/SEL"     , "narrator": "（選択肢）", "text": "いいぞもっとやれ！"},
        { "location": "777/ACT"     , "narrator": "", "text": "ちょ、ちょっと待て！"},
        { "location": "779/TALK"    , "narrator": "神楽", "text": "あら、\nどうしたんですか？"},
        { "location": "780/TALK"    , "narrator": "神楽", "text": "百合百合したのが\n見たかったんですよね？"},
        { "location": "781/SEL"     , "narrator": "（選択肢）", "text": "それって脅迫じゃないの？"},
        { "location": "782/SEL"     , "narrator": "（選択肢）", "text": "流石にやり過ぎだって"},
        { "location": "783/ACT"     , "narrator": "", "text": "それって脅迫じゃないの？"},
        { "location": "784/TALK"    , "narrator": "神楽", "text": "違いますよ。"},
        { "location": "786/TALK"    , "narrator": "つばめ", "text": "うん、\n全然違うよ。"},
        { "location": "787/ACT"     , "narrator": "", "text": "流石にやり過ぎだって"},
        { "location": "788/TALK"    , "narrator": "神楽", "text": "やり過ぎ？\nそんなこと\nありませんよ？"},
        { "location": "790/TALK"    , "narrator": "つばめ", "text": "うん。\n全然やりすぎじゃ\nないよ？"},
        { "location": "792/ACT"     , "narrator": "", "text": "いいぞもっとやれ！"},
        { "location": "795/TALK"    , "narrator": "神楽", "text": "……。"},
        { "location": "797/TALK"    , "narrator": "つばめ", "text": "……。"},
        { "location": "798/TALK"    , "narrator": "神楽", "text": "もちろん、私たちは\nもっとやるつもり\nですけど。"},
        { "location": "800/TALK"    , "narrator": "つばめ", "text": "でも、見せられるのは\nここまでだよね。"},
        { "location": "802/TALK"    , "narrator": "神楽", "text": "その通りです♪"},
        { "location": "805/TALK"    , "narrator": "つばめ", "text": "だから\n$handle$さんとは\nここでお別れだよ。"},
        { "location": "806/TALK"    , "narrator": "つばめ", "text": "もうどうでもよく\nなってきちゃったし。"},
        { "location": "807/SEL"     , "narrator": "（選択肢）", "text": "え！？"},
        { "location": "808/ACT"     , "narrator": "", "text": "え！？"},
        { "location": "812/TALK"    , "narrator": "つばめ", "text": "それじゃ、\nバイバイ！"},
        { "location": "814/TALK"    , "narrator": "神楽", "text": "さようなら♪"},
        { "location": "815/SEL"     , "narrator": "（選択肢）", "text": "ちょっと待って！"},
        { "location": "816/ACT"     , "narrator": "", "text": "ちょっと待って！"},
        { "location": "831/TALK"    , "narrator": "千羽鶴", "text": "追い出された。"},
        { "location": "832/SEL"     , "narrator": "（選択肢）", "text": "なんで？"},
        { "location": "833/ACT"     , "narrator": "", "text": "なんで？"},
        { "location": "835/TALK"    , "narrator": "千羽鶴", "text": "逢瀬つばめが望まない\n方向に、貴方が舵を\n切ったから。"},
        { "location": "836/TALK"    , "narrator": "千羽鶴", "text": "理不尽かもしれないけど\nここは彼女の世界。"},
        { "location": "837/TALK"    , "narrator": "千羽鶴", "text": "彼女にとって望まない\nことは、無理矢理矯正\nすることができる。"},
        { "location": "838/TALK"    , "narrator": "千羽鶴", "text": "まあ、彼女を理解する\n上での必要なことだと\n割り切った方がいい。"},
        { "location": "839/TALK"    , "narrator": "千羽鶴", "text": "現実と思って対応すると\n心に大きな穴を\n作ることになるかも。"},
        { "location": "840/TALK"    , "narrator": "千羽鶴", "text": "心を覗くということは\nそういうこと。"},
        { "location": "841/TALK"    , "narrator": "千羽鶴", "text": "覗いているつもりが、\n貴方が覗かれてた、\nなんてこともある。"},
        { "location": "842/TALK"    , "narrator": "千羽鶴", "text": "だから、心の中では\n大胆かつ慎重に。"},
        { "location": "843/TALK"    , "narrator": "千羽鶴", "text": "逢瀬つばめが何を\n望んでいるのかを\n考えて――"},
        { "location": "844/TALK"    , "narrator": "千羽鶴", "text": "今度は今とは\n違う選択をしてみて。"},
        { "location": "858/TALK"    , "narrator": "つばめ", "text": "わたし、卯月さんが\n喜んでくれるなら、\nなんでもするもん。"},
        { "location": "860/TALK"    , "narrator": "つばめ", "text": "卯月さんが喜んで\nくれたら、それが\nわたしの幸せだもん。"},
        { "location": "862/TALK"    , "narrator": "神楽", "text": "つばめさんっ♪\nとっても可愛いです♪"},
        { "location": "864/TALK"    , "narrator": "つばめ", "text": "えへへ…。"},
        { "location": "866/TALK"    , "narrator": "神楽", "text": "仮に私の行為が脅迫\nだとして、それを相手が\n望んでいたとしたら。"},
        { "location": "867/TALK"    , "narrator": "神楽", "text": "それは脅迫ですか？"},
        { "location": "869/TALK"    , "narrator": "神楽", "text": "いえ、違います。\nそれは――"},
        { "location": "872/SEL"     , "narrator": "（選択肢）", "text": "プレイ"},
        { "location": "873/SEL"     , "narrator": "（選択肢）", "text": "依存"},
        { "location": "874/ACT"     , "narrator": "", "text": "プレイ"},
        { "location": "875/TALK"    , "narrator": "神楽", "text": "……。"},
        { "location": "876/TALK"    , "narrator": "神楽", "text": "そ、そうですね。\n$handle$さんの\n性癖はわかりました♪"},
        { "location": "877/TALK"    , "narrator": "神楽", "text": "でも恐らく今回は、\nそれよりももっと\nヘヴィな理由……"},
        { "location": "878/TALK"    , "narrator": "神楽", "text": "依存、だと思います♪"},
        { "location": "879/ACT"     , "narrator": "", "text": "依存"},
        { "location": "880/TALK"    , "narrator": "神楽", "text": "あ、悪くない\n回答ですね。"},
        { "location": "882/TALK"    , "narrator": "つばめ", "text": "……依存？"},
        { "location": "883/TALK"    , "narrator": "神楽", "text": "そうです。"},
        { "location": "884/TALK"    , "narrator": "神楽", "text": "簡単に言えば、\n卯月中毒です♪"},
        { "location": "885/SEL"     , "narrator": "（選択肢）", "text": "ちょっと待って"},
        { "location": "886/ACT"     , "narrator": "", "text": "ちょっと待って"},
        { "location": "889/TALK"    , "narrator": "つばめ", "text": "え？"},
        { "location": "890/SEL"     , "narrator": "（選択肢）", "text": "中毒も何も、まだ出逢って１日とかじゃ…"},
        { "location": "891/ACT"     , "narrator": "", "text": "中毒も何も、まだ出逢って１日とかじゃ…"},
        { "location": "894/TALK"    , "narrator": "つばめ", "text": "そうなんだよね。"},
        { "location": "896/TALK"    , "narrator": "つばめ", "text": "でも自分でもビックリ\nするくらい、卯月さんと\nいると安心するんだ。"},
        { "location": "897/TALK"    , "narrator": "つばめ", "text": "なんだか\n声を聞いてると\n落ち着くっていうか。"},
        { "location": "899/TALK"    , "narrator": "つばめ", "text": "なんでだろうね。"},
        { "location": "900/SEL"     , "narrator": "（選択肢）", "text": "甘いウィスパーボイスだから"},
        { "location": "901/SEL"     , "narrator": "（選択肢）", "text": "色気に惑わされてるだけ"},
        { "location": "902/ACT"     , "narrator": "", "text": "甘いウィスパーボイスだから"},
        { "location": "903/TALK"    , "narrator": "つばめ", "text": "あー、それはあるかも。"},
        { "location": "906/TALK"    , "narrator": "神楽", "text": "あるかもですね♪"},
        { "location": "907/TALK"    , "narrator": "つばめ", "text": "でも、もっと深い所に\n何かある気が\nするんだよねー。"},
        { "location": "908/ACT"     , "narrator": "", "text": "色気に惑わされてるだけ"},
        { "location": "910/TALK"    , "narrator": "つばめ", "text": "色気？\nうーん……"},
        { "location": "911/TALK"    , "narrator": "つばめ", "text": "卯月さんに色気とか\nあまり感じたことは\nないなぁ。"},
        { "location": "912/TALK"    , "narrator": "つばめ", "text": "わたしより全然\n胸だって小さいし。"},
        { "location": "914/TALK"    , "narrator": "神楽", "text": "そうですっ！"},
        { "location": "915/SEL"     , "narrator": "（選択肢）", "text": "…本当の神楽が聞いたら怒られるよ？"},
        { "location": "916/ACT"     , "narrator": "", "text": "…本当の神楽が聞いたら怒られるよ？"},
        { "location": "919/TALK"    , "narrator": "つばめ", "text": "え？\nそうなの？？"},
        { "location": "921/TALK"    , "narrator": "神楽", "text": "そんなこと\nありませんよっ！"},
        { "location": "923/TALK"    , "narrator": "つばめ", "text": "ほら、全然\n大丈夫だよ。"},
        { "location": "924/SEL"     , "narrator": "（選択肢）", "text": "つばめの心の中ではね……"},
        { "location": "925/ACT"     , "narrator": "", "text": "つばめの心の中ではね……"},
        { "location": "930/TALK"    , "narrator": "つばめ", "text": "でもなんだか\n心の整理がついた\n気がするよ。"},
        { "location": "931/SEL"     , "narrator": "（選択肢）", "text": "え、うそでしょ！？"},
        { "location": "932/ACT"     , "narrator": "", "text": "え、うそでしょ！？"},
        { "location": "934/TALK"    , "narrator": "つばめ", "text": "ホントだよ。"},
        { "location": "935/TALK"    , "narrator": "つばめ", "text": "わたし、卯月さんの\nこと本当はどう思って\nいるのか――"},
        { "location": "937/TALK"    , "narrator": "つばめ", "text": "自分でもちょっと\n分からなかったんだ。"},
        { "location": "938/TALK"    , "narrator": "つばめ", "text": "すごく仲良くしたいって\n気持ちが強くあって…"},
        { "location": "940/TALK"    , "narrator": "つばめ", "text": "でも、まだ日も浅い\nのにおかしいんじゃ\nないかって。"},
        { "location": "942/TALK"    , "narrator": "つばめ", "text": "でも、この気持ちを\n大事にしてつき合って\nいこうかなって。"},
        { "location": "943/TALK"    , "narrator": "つばめ", "text": "なんでこんな安心\nするのかは、今は\nまだわからないけど。"},
        { "location": "945/TALK"    , "narrator": "神楽", "text": "さすが\nつばめさんですっ！"},
        { "location": "946/SEL"     , "narrator": "（選択肢）", "text": "…よかったね"},
        { "location": "947/ACT"     , "narrator": "", "text": "…よかったね"},
        { "location": "964/TALK"    , "narrator": "千羽鶴", "text": "貴方の気持ちを\n代弁してあげましょう。"},
        { "location": "965/TALK"    , "narrator": "千羽鶴", "text": "『本当にこれで\n　よかったのだろうか』"},
        { "location": "966/TALK"    , "narrator": "千羽鶴", "text": "とはいえ。"},
        { "location": "967/TALK"    , "narrator": "千羽鶴", "text": "どういう結末だと\nしても、心の主が解決\nしたと思うなら終わり。"},
        { "location": "968/TALK"    , "narrator": "千羽鶴", "text": "それが彼女の心の中、\nココロスフィアでの\nルールだから。"},
        { "location": "969/SEL"     , "narrator": "（選択肢）", "text": "でも「なんでかわからないけど」って…"},
        { "location": "970/ACT"     , "narrator": "", "text": "でも「なんでかわからないけど」って…"},
        { "location": "973/TALK"    , "narrator": "千羽鶴", "text": "そうね。\nそういうこともある。"},
        { "location": "974/TALK"    , "narrator": "千羽鶴", "text": "それは、このレベルの\n心の中では解決できる\n事柄じゃないってこと。"},
        { "location": "975/TALK"    , "narrator": "千羽鶴", "text": "もっと心の深い所に\n潜らないと、その\n真相はわからない。"},
        { "location": "976/TALK"    , "narrator": "千羽鶴", "text": "もちろん、その解明を\nもって、はじめて解決\nしたとなるのだけど。"},
        { "location": "977/TALK"    , "narrator": "千羽鶴", "text": "ともあれ、\n今ここでできることは、\nここまでみたい。"},
        { "location": "978/TALK"    , "narrator": "千羽鶴", "text": "一旦現実世界に戻って\n彼女の行動を\n見てみましょ。"}
    ]
}
