        "title": "らぶとーく 第25話",
        "sub_title": "恋する乙女のお見本は"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "恋する乙女のお見本は"},
        { "location": "24/TALK"   , "narrator": "雛", "text": "つーばめちゃん！"},
        { "location": "27/TALK"   , "narrator": "つばめ", "text": "あ、ひなこちゃん。\nこの前はありがと。"},
        { "location": "28/TALK"   , "narrator": "雛", "text": "あー、いいのいいの。"},
        { "location": "29/TALK"   , "narrator": "雛", "text": "恋のキューピッドとして、\n当然のことをしたまでよ！"},
        { "location": "31/TALK"   , "narrator": "つばめ", "text": "ふふっ…。"},
        { "location": "32/TALK"   , "narrator": "雛", "text": "…それで？"},
        { "location": "33/TALK"   , "narrator": "雛", "text": "この前のあの話から、\n何か進展はあったの？"},
        { "location": "38/TALK"   , "narrator": "つばめ", "text": "うっ…そ、それが、\nその…。"},
        { "location": "39/TALK"   , "narrator": "雛", "text": "？"},
        { "location": "47/TALK"   , "narrator": "雛", "text": "えっ！？\n恋が何だかわからない！？"},
        { "location": "48/TALK"   , "narrator": "雛", "text": "つ、つばめちゃん。\nそれ、本当なの？"},
        { "location": "51/TALK"   , "narrator": "つばめ", "text": "うん…驚くよね？"},
        { "location": "52/TALK"   , "narrator": "雛", "text": "そりゃ驚くよ…。"},
        { "location": "53/TALK"   , "narrator": "雛", "text": "思春期真っ盛り、\n恋愛大好き花の女子高生\nなのに――"},
        { "location": "55/TALK"   , "narrator": "雛", "text": "恋がわからないとか…\nつばめちゃんって、\nもしかして超ウブ？"},
        { "location": "58/TALK"   , "narrator": "つばめ", "text": "ご、ごめん…。\nそれもわからない…。"},
        { "location": "61/TALK"   , "narrator": "雛", "text": "はぁ…ってことは、\n恋がどういうものかを\n教えるところからだね…。"},
        { "location": "63/TALK"   , "narrator": "つばめ", "text": "やっぱり、難しいよね？"},
        { "location": "64/TALK"   , "narrator": "雛", "text": "うーん…。"},
        { "location": "66/TALK"   , "narrator": "雛", "text": "…ガブリエラちゃん、\nかな？"},
        { "location": "67/TALK"   , "narrator": "つばめ", "text": "ガブちゃん？"},
        { "location": "68/TALK"   , "narrator": "雛", "text": "うん。\n多分、これが一番\nわかりやすいと思うよー。"},
        { "location": "69/TALK"   , "narrator": "雛", "text": "ガブリエラちゃんの\n態度を、よーく観察すれば\nわかるんじゃないかな？"},
        { "location": "71/TALK"   , "narrator": "つばめ", "text": "？　えっと…態度？"},
        { "location": "72/TALK"   , "narrator": "雛", "text": "うん、態度。"},
        { "location": "73/TALK"   , "narrator": "雛", "text": "あの子の態度を見てれば、\nもう一発で恋がどういう\nものかわかると思うよー。"},
        { "location": "75/TALK"   , "narrator": "つばめ", "text": "…………。"},
        { "location": "87/TALK"   , "narrator": "つばめ", "text": "ぁの"},
        { "location": "88/TALK"   , "narrator": "つばめ", "text": "ひなこちゃんの言ってることわかる？(´･ω･｀) "},
        { "location": "90/SEL"    , "narrator": "", "text": "ガブリエラの態度を見ろ、ってこと？"},
        { "location": "91/ACT"    , "narrator": "", "text": "ガブリエラの態度を見ろ、ってこと？"},
        { "location": "93/TALK"   , "narrator": "つばめ", "text": "うん"},
        { "location": "94/TALK"   , "narrator": "つばめ", "text": "態度を見ろって言うけど"},
        { "location": "95/TALK"   , "narrator": "つばめ", "text": "どぅぃぅ態度を見ればぃぃのかな？(´・ω・`) "},
        { "location": "98/SEL"    , "narrator": "", "text": "つばめと接してる時の態度かな？"},
        { "location": "99/SEL"    , "narrator": "", "text": "男子に対する態度かな？"},
        { "location": "100/SEL"   , "narrator": "", "text": "乙女なところじゃないかな"},
        { "location": "101/ACT"   , "narrator": "", "text": "つばめと接してる時の態度かな？"},
        { "location": "102/TALK"  , "narrator": "つばめ", "text": "わかった！(๑･ㅂ･)و☆"},
        { "location": "103/TALK"  , "narrator": "つばめ", "text": "ぁりがと！(*´ω｀*)"},
        { "location": "115/TALK"  , "narrator": "つばめ", "text": "先輩っぽく徹しようと\nしてるよね？"},
        { "location": "117/TALK"  , "narrator": "雛", "text": "…つばめちゃん。\nどんな態度を思い浮かべ\nたの？"},
        { "location": "118/TALK"  , "narrator": "つばめ", "text": "わたしに対する\n態度だけど…。"},
        { "location": "120/TALK"  , "narrator": "つばめ", "text": "そっか、わたしも\n先輩っぽく振る舞えば\nいいんだ！"},
        { "location": "122/TALK"  , "narrator": "雛", "text": "はい、不正解ー！！"},
        { "location": "123/TALK"  , "narrator": "雛", "text": "っていうか、それもう\n恋じゃないじゃん！"},
        { "location": "124/TALK"  , "narrator": "雛", "text": "恋だよ？　恋愛！！\nラヴ！！　アモーレ！！"},
        { "location": "125/TALK"  , "narrator": "雛", "text": "先輩とか関係ないじゃん！"},
        { "location": "126/TALK"  , "narrator": "つばめ", "text": "…そっか。\n確かにそうだよね。"},
        { "location": "127/TALK"  , "narrator": "雛", "text": "…………。"},
        { "location": "130/TALK"  , "narrator": "雛", "text": "ヤバいかも…。\nキューピッド、\n心が折れそうだよ…。"},
        { "location": "132/TALK"  , "narrator": "つばめ", "text": "じゃあ、ガブちゃんの\nどこを見るのが正解なの？"},
        { "location": "133/TALK"  , "narrator": "雛", "text": "…性格だよ、性格。"},
        { "location": "135/TALK"  , "narrator": "雛", "text": "ガブリエラちゃんはー、\n好きな人の前では\nどうなっちゃう？"},
        { "location": "137/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "139/TALK"  , "narrator": "つばめ", "text": "ガブちゃん、誰にでも\nツンデレじゃないかな？"},
        { "location": "140/TALK"  , "narrator": "雛", "text": "…………。"},
        { "location": "142/TALK"  , "narrator": "つばめ", "text": "あ、あれ？\n間違ってないよね？"},
        { "location": "143/TALK"  , "narrator": "雛", "text": "…確かにそうだね。\nうん、ガブリエラちゃんは\nツンデレだよ。"},
        { "location": "144/TALK"  , "narrator": "つばめ", "text": "つまり、ツンデレに\nなればわかる、って\nこと？"},
        { "location": "145/TALK"  , "narrator": "雛", "text": "…………。"},
        { "location": "147/TALK"  , "narrator": "雛", "text": "…愛のキューピッド、\nやめようかな…。"},
        { "location": "148/ACT"   , "narrator": "", "text": "男子に対する態度かな？"},
        { "location": "149/TALK"  , "narrator": "つばめ", "text": "そぅなの？〆(._.)ﾒﾓﾒﾓ"},
        { "location": "150/TALK"  , "narrator": "つばめ", "text": "でもそれだと"},
        { "location": "151/TALK"  , "narrator": "つばめ", "text": "話せなくなっちゃぅんじゃなぃかな？(´・ω・｀)"},
        { "location": "162/TALK"  , "narrator": "つばめ", "text": "…見るところって、\nガブちゃんの男子に対する\n態度でいいの？"},
        { "location": "163/TALK"  , "narrator": "雛", "text": "うん、そうそう！"},
        { "location": "164/TALK"  , "narrator": "雛", "text": "それも、特別な男子に\n対しての態度だよー。"},
        { "location": "165/TALK"  , "narrator": "つばめ", "text": "そっか…。"},
        { "location": "167/TALK"  , "narrator": "つばめ", "text": "つまり、話をしなければ\nいいってことだね？"},
        { "location": "168/TALK"  , "narrator": "雛", "text": "そこじゃないから！！"},
        { "location": "169/TALK"  , "narrator": "雛", "text": "特別な男子に対しての\n態度だってば！"},
        { "location": "170/TALK"  , "narrator": "雛", "text": "ほら…ガブリエラちゃんに\nとって特別な男子って、\n誰かわかるでしょ？"},
        { "location": "171/TALK"  , "narrator": "つばめ", "text": "ヒカルくんのこと？"},
        { "location": "172/TALK"  , "narrator": "雛", "text": "そうそう、それだよー。"},
        { "location": "174/TALK"  , "narrator": "つばめ", "text": "やっぱり話さないよね？"},
        { "location": "175/TALK"  , "narrator": "雛", "text": "…………。"},
        { "location": "177/ACT"   , "narrator": "", "text": "乙女なところじゃないかな"},
        { "location": "178/TALK"  , "narrator": "つばめ", "text": "それって見た目の話？"},
        { "location": "180/SEL"   , "narrator": "", "text": "中身の話だよ"},
        { "location": "181/ACT"   , "narrator": "", "text": "中身の話だよ"},
        { "location": "183/TALK"  , "narrator": "つばめ", "text": "中身ってことは"},
        { "location": "184/TALK"  , "narrator": "つばめ", "text": "性格のことかな？(´・ω・`) "},
        { "location": "196/TALK"  , "narrator": "つばめ", "text": "それって、ガブちゃんの\n性格を見ろ、ってこと？"},
        { "location": "197/TALK"  , "narrator": "雛", "text": "そう！\nつばめちゃん大正解！"},
        { "location": "198/TALK"  , "narrator": "雛", "text": "そこまでわかれば、\nもうわかったも同然だね！"},
        { "location": "199/TALK"  , "narrator": "つばめ", "text": "えっ、そうなの？"},
        { "location": "200/TALK"  , "narrator": "つばめ", "text": "ガブちゃんの性格って、\nツンデレだよね？"},
        { "location": "201/TALK"  , "narrator": "雛", "text": "えっ？\nま、まあ、確かに\nそうだけど…。"},
        { "location": "202/TALK"  , "narrator": "つばめ", "text": "じゃあ、わたしも\nガブちゃんみたいな――"},
        { "location": "203/TALK"  , "narrator": "つばめ", "text": "ツンデレになれば、\n恋がわかるようになるの\nかな？"},
        { "location": "204/TALK"  , "narrator": "雛", "text": "…………。"},
        { "location": "205/TALK"  , "narrator": "つばめ", "text": "あ、あれ？\nひなこちゃん？"},
        { "location": "207/TALK"  , "narrator": "雛", "text": "…愛のキューピッド、\nやめようかな…。"},
        { "location": "14/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>某月某日　10:02 AM</color>\nとある平日の休み時間、学園廊下にて。"}
    ]
}
