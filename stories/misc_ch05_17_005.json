    "entry":
    [
        { "location": "5492/SCENARIO", "narrator": "", "text": "ほほ笑みのブリム"},
        { "location": "5517/TALK"    , "narrator": "神楽", "text": "やっぱりメイド服っていったら"},
        { "location": "5518/TALK"    , "narrator": "神楽", "text": "正統派クラシックなやつだよね"},
        { "location": "5519/TALK"    , "narrator": "神楽", "text": "最＆高"},
        { "location": "5521/SEL"     , "narrator": "", "text": "だよね！"},
        { "location": "5522/SEL"     , "narrator": "", "text": "ミニスカもいいものだ"},
        { "location": "5523/SEL"     , "narrator": "", "text": "神楽が着るなら全部最高"},
        { "location": "5524/ACT"     , "narrator": "", "text": "だよね！"},
        { "location": "5525/TALK"    , "narrator": "神楽", "text": "よしよし"},
        { "location": "5526/ACT"     , "narrator": "", "text": "ミニスカもいいものだ"},
        { "location": "5527/TALK"    , "narrator": "神楽", "text": "あれはミニスカメイドというものでメイドではない"},
        { "location": "5528/ACT"     , "narrator": "", "text": "神楽が着るなら全部最高"},
        { "location": "5530/TALK"    , "narrator": "神楽", "text": "あーそーいう、、、"},
        { "location": "5531/TALK"    , "narrator": "神楽", "text": "ぴょんこはメイド服は見る専門ぴょん"},
        { "location": "5532/TALK"    , "narrator": "神楽", "text": "でも、、、なんてね？"},
        { "location": "5534/TALK"    , "narrator": "神楽", "text": "黒を基調としたくるぶし丈のワンピースに白いエプロンとブリム！"},
        { "location": "5536/TALK"    , "narrator": "神楽", "text": "イイネイイネ！"},
        { "location": "5537/TALK"    , "narrator": "神楽", "text": "あれは若いだけじゃなくてメイド長クラスのばあやにも似合うところがまたいい！"},
        { "location": "5539/SEL"     , "narrator": "", "text": "なんか…本格的だね？"},
        { "location": "5540/SEL"     , "narrator": "", "text": "そこまでのこだわりはないかな"},
        { "location": "5541/SEL"     , "narrator": "", "text": "$me$は神楽の従者なのに！"},
        { "location": "5542/ACT"     , "narrator": "", "text": "なんか…本格的だね？"},
        { "location": "5543/TALK"    , "narrator": "神楽", "text": "当然"},
        { "location": "5544/TALK"    , "narrator": "神楽", "text": "ぴょんこはクオリティにこだわるウサギだから！"},
        { "location": "5545/ACT"     , "narrator": "", "text": "そこまでのこだわりはないかな"},
        { "location": "5546/TALK"    , "narrator": "神楽", "text": "えー、、、"},
        { "location": "5548/TALK"    , "narrator": "神楽", "text": "がっかりぴょん、、、"},
        { "location": "5549/ACT"     , "narrator": "", "text": "$me$は神楽の従者なのに！"},
        { "location": "5551/TALK"    , "narrator": "神楽", "text": "あらあら$handlek$ったらもー"},
        { "location": "5552/TALK"    , "narrator": "神楽", "text": "ぴょんこと$handlek$はそういうんじゃないぴょん？"},
        { "location": "5553/TALK"    , "narrator": "神楽", "text": "そうでしょ？"},
        { "location": "5554/TALK"    , "narrator": "神楽", "text": "違うかな？"},
        { "location": "5555/TALK"    , "narrator": "神楽", "text": "いやいやそんなことはないよね？？"},
        { "location": "5556/TALK"    , "narrator": "神楽", "text": "$handlek$ったらわかってるくせに☆彡"}
    ]
}
