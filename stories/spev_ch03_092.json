    "type": "",
    "info": {
        "story_id": "91032",
        "cid": "",
        "title": "ぴょんこのサマー大作戦♪",
        "sub_title": "ぴょんこのサマー大作戦♪②【ガブリエラ編】"
    },
    "entry":
    [
        { "location": "15/DIALOG", "narrator": "", "text": "<color=green>7月14日　3:43 PM</color>\nとある平日、神楽坂トライナリー劇場にて"},
        { "location": "25/TALK"  , "narrator": "ガブリエラ", "text": "えーっと…。"},
        { "location": "26/TALK"  , "narrator": "ガブリエラ", "text": "〇月×日。\n今日もバイトは\n暇・暇・暇！"},
        { "location": "27/TALK"  , "narrator": "ガブリエラ", "text": "ラクなのはいいけど、\nとっても退屈で\n嫌になっちゃう。"},
        { "location": "28/TALK"  , "narrator": "ガブリエラ", "text": "お客さんもいないんだし、\nみんなでどこかに\n遊びに行きたいな。"},
        { "location": "29/TALK"  , "narrator": "ガブリエラ", "text": "例えば、遊園地とか！"},
        { "location": "30/TALK"  , "narrator": "ガブリエラ", "text": "期間限定のパレード、\nとっても可愛いから\n必見って、ネットで――"},
        { "location": "37/TALK"  , "narrator": "神楽", "text": "あ、ガブちゃん。\nお疲れさまです。"},
        { "location": "39/TALK"  , "narrator": "ガブリエラ", "text": "か、神楽！？"},
        { "location": "46/TALK"  , "narrator": "神楽", "text": "ふふっ、またノート\n書いてたんですか？"},
        { "location": "48/TALK"  , "narrator": "ガブリエラ", "text": "…い、いいでしょ？\n休憩時間なんだし…。"},
        { "location": "49/TALK"  , "narrator": "神楽", "text": "別に悪いなんて\n言ってませんよ。"},
        { "location": "50/TALK"  , "narrator": "神楽", "text": "ただ、そろそろ何を\n書いてるのか教えて\nほしいなぁ、って…。"},
        { "location": "51/TALK"  , "narrator": "ガブリエラ", "text": "だ、ダメよ！"},
        { "location": "53/TALK"  , "narrator": "ガブリエラ", "text": "これは秘密！\nあたしのプライバシー\nなんだから！"},
        { "location": "55/TALK"  , "narrator": "神楽", "text": "えーっ！\nそろそろ少しくらい\nいいじゃないですか。"},
        { "location": "58/TALK"  , "narrator": "ガブリエラ", "text": "ぜ、絶対ダメ！"},
        { "location": "59/TALK"  , "narrator": "神楽", "text": "もぅ、ガブちゃんは\n本当に照れ屋さんですね。"},
        { "location": "60/TALK"  , "narrator": "神楽", "text": "それが日記であれ\n小説であれ、恥ずかしがる\nことないのに。"},
        { "location": "62/TALK"  , "narrator": "ガブリエラ", "text": "適当なこと言わないでよ。"},
        { "location": "63/TALK"  , "narrator": "ガブリエラ", "text": "神楽だって、\n書いたものを勝手に\n見られたら嫌でしょ？"},
        { "location": "64/TALK"  , "narrator": "神楽", "text": "んー、そうでしょうか？"},
        { "location": "65/TALK"  , "narrator": "神楽", "text": "私なんかは、たまに\nショートストーリーとか\n書きますけど――"},
        { "location": "66/TALK"  , "narrator": "ガブリエラ", "text": "…………ああ、\nそういえば。\nで？　それが？"},
        { "location": "67/TALK"  , "narrator": "神楽", "text": "それを人に見られたって\n全然恥ずかしく\nありません！"},
        { "location": "69/TALK"  , "narrator": "ガブリエラ", "text": "いや、ちょっと待って！"},
        { "location": "70/TALK"  , "narrator": "ガブリエラ", "text": "人に見せる目的で書いてる\n物語と、秘密だらけの\n日記を一緒にしないでよ！"},
        { "location": "74/TALK"  , "narrator": "神楽", "text": "ちっ…"},
        { "location": "75/TALK"  , "narrator": "ガブリエラ", "text": "今、すごく悪い顔\nしてなかった！？"},
        { "location": "78/TALK"  , "narrator": "神楽", "text": "いいえ？"},
        { "location": "79/TALK"  , "narrator": "神楽", "text": "でも物語って、\n実際書いてみると\nとっても楽しいですよね！"},
        { "location": "80/TALK"  , "narrator": "神楽", "text": "頭の中で想像していた\n世界が文字で形になって\nいくのが見えるのって…。"},
        { "location": "81/TALK"  , "narrator": "神楽", "text": "そこに、どんな挿絵を\n添えると良いかなぁって\n考えるのも楽しいです。"},
        { "location": "82/TALK"  , "narrator": "神楽", "text": "いつか、ちゃんと同……\nじゃなくて、本として\n出版してみたいですっ！"},
        { "location": "83/TALK"  , "narrator": "ガブリエラ", "text": "本！？\nそれ本気！？"},
        { "location": "84/TALK"  , "narrator": "神楽", "text": "だって、ただ書いて\n終わりなんて、\n勿体ないじゃないですか。"},
        { "location": "86/TALK"  , "narrator": "ガブリエラ", "text": "…やっぱりあんたって\nただ者じゃないわね。"},
        { "location": "87/TALK"  , "narrator": "神楽", "text": "ですから、ガブちゃんも\nそんなに隠してたら\n勿体ないですよ。"},
        { "location": "88/TALK"  , "narrator": "神楽", "text": "恥ずかしがらずに、\n世間に大公開する気持ちで\nいきましょう！"},
        { "location": "89/TALK"  , "narrator": "ガブリエラ", "text": "きゃ、却下！\nあたしは絶対に\n見せないから…。"},
        { "location": "92/TALK"  , "narrator": "神楽", "text": "ちっ…"},
        { "location": "93/TALK"  , "narrator": "ガブリエラ", "text": "ほら、また！！"},
        { "location": "98/TALK"  , "narrator": "ガブリエラ", "text": "だ、だいたい\nあたしの日記なんて\n全然面白くないから！"},
        { "location": "99/TALK"  , "narrator": "ガブリエラ", "text": "人に見せるために書いて\nるわけじゃないもの。"},
        { "location": "100/TALK" , "narrator": "神楽", "text": "そうですか…。"},
        { "location": "102/TALK" , "narrator": "ガブリエラ", "text": "はぁ…。\nわかってくれた？"},
        { "location": "103/TALK" , "narrator": "神楽", "text": "…じゃあ、私にだけ\nこっそりっていうのは\nどうですか？"},
        { "location": "104/TALK" , "narrator": "ガブリエラ", "text": "それも却下！"},
        { "location": "105/TALK" , "narrator": "神楽", "text": "じゃ、じゃあ、見せ合い\nっこならどうですか？"},
        { "location": "106/TALK" , "narrator": "ガブリエラ", "text": "見せ合いっこって、\n神楽のは最終的に\n本にするんでしょ？"},
        { "location": "107/TALK" , "narrator": "ガブリエラ", "text": "見せ合わなくても、\n完成したら\n簡単に見れるじゃない。"},
        { "location": "108/TALK" , "narrator": "神楽", "text": "そんなことないですよ！"},
        { "location": "109/TALK" , "narrator": "ガブリエラ", "text": "え？\nなんで？"},
        { "location": "110/TALK" , "narrator": "神楽", "text": "え！？\nあ、えっと、\nそれはですね！"},
        { "location": "112/TALK" , "narrator": "神楽", "text": "まだ、全然ラフ中のラフ\nなので、完全に支離滅裂\n状態といいますか……。"},
        { "location": "113/TALK" , "narrator": "神楽", "text": "だから、これから\n大幅に書き直すことに\nなるんですよ！"},
        { "location": "114/TALK" , "narrator": "ガブリエラ", "text": "ふーん…結構本格的に\n書いてるのね。"},
        { "location": "115/TALK" , "narrator": "神楽", "text": "え、ええ…まあ…。"},
        { "location": "116/TALK" , "narrator": "神楽", "text": "ガブちゃん！\n私たち、創作仲間じゃ\nありませんか。"},
        { "location": "117/TALK" , "narrator": "神楽", "text": "だから、気にせず\nちょっとだけ\n見せてくださいっ！"},
        { "location": "119/TALK" , "narrator": "ガブリエラ", "text": "しつこいわねぇ…。"},
        { "location": "120/SEL"  , "narrator": "（選択肢）", "text": "見せ合いっこならよくない？"},
        { "location": "121/SEL"  , "narrator": "（選択肢）", "text": "神楽のを見せてもらおう"},
        { "location": "122/SEL"  , "narrator": "（選択肢）", "text": "そんなに恥ずかしいの？"},
        { "location": "123/ACT"  , "narrator": "", "text": "見せ合いっこならよくない？"},
        { "location": "140/TALK" , "narrator": "ガブリエラ", "text": "あのね$marzanna$"},
        { "location": "141/TALK" , "narrator": "ガブリエラ", "text": "あたしが書いてるの"},
        { "location": "142/TALK" , "narrator": "ガブリエラ", "text": "小説じゃないの"},
        { "location": "143/TALK" , "narrator": "ガブリエラ", "text": "日記よ？"},
        { "location": "145/SEL"  , "narrator": "（選択肢）", "text": "でも神楽の小説気にならない？"},
        { "location": "146/ACT"  , "narrator": "", "text": "でも神楽の小説気にならない？"},
        { "location": "148/TALK" , "narrator": "ガブリエラ", "text": "確かに"},
        { "location": "151/TALK" , "narrator": "ガブリエラ", "text": "わかったわ"},
        { "location": "152/TALK" , "narrator": "ガブリエラ", "text": "少なくとも"},
        { "location": "153/TALK" , "narrator": "ガブリエラ", "text": "神楽のも見れるんだし"},
        { "location": "154/TALK" , "narrator": "ガブリエラ", "text": "ちょっとはマシかも"},
        { "location": "168/TALK" , "narrator": "ガブリエラ", "text": "…わかったわ。"},
        { "location": "169/TALK" , "narrator": "神楽", "text": "見せてくれるんですか？"},
        { "location": "170/TALK" , "narrator": "ガブリエラ", "text": "見せ合いっこならね。\nあたしだけ見せるのは\n嫌だし…。"},
        { "location": "171/TALK" , "narrator": "神楽", "text": "もちろんですよ。\nそれじゃ、せーの、で\nノートを交換しましょう。"},
        { "location": "173/TALK" , "narrator": "ガブリエラ", "text": "うん…じゃあ、いい？"},
        { "location": "174/TALK" , "narrator": "神楽", "text": "はい。\nせーのっ！！"},
        { "location": "176/TALK" , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "177/TALK" , "narrator": "神楽", "text": "…………。"},
        { "location": "179/TALK" , "narrator": "ガブリエラ", "text": "…ちょっと。\n早くノート渡しなさいよ。"},
        { "location": "180/TALK" , "narrator": "神楽", "text": "が、ガブちゃんこそ。\nそんな強く握られたら、\n取れないじゃないですか。"},
        { "location": "182/TALK" , "narrator": "ガブリエラ", "text": "み、見せ合いっこって\n言ったでしょ！？\n早く渡しなさいよ！"},
        { "location": "183/TALK" , "narrator": "神楽", "text": "なら、ガブちゃんだって\n渡してください！"},
        { "location": "184/TALK" , "narrator": "ガブリエラ", "text": "ま、まずは神楽から\n見せなさいよ。"},
        { "location": "185/TALK" , "narrator": "神楽", "text": "それじゃ見せ合いっこに\nならないじゃないですか！"},
        { "location": "186/TALK" , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "187/TALK" , "narrator": "神楽", "text": "…………。"},
        { "location": "188/TALK" , "narrator": "ガブリエラ", "text": "はぁ…、結局お互い、\n見せたくないってことね。"},
        { "location": "190/TALK" , "narrator": "神楽", "text": "…そうですね。"},
        { "location": "191/TALK" , "narrator": "ガブリエラ", "text": "ていうか、神楽は\n本にして出すのが\n目標なんでしょ？"},
        { "location": "192/TALK" , "narrator": "ガブリエラ", "text": "それなのに\n見せられないって、\nホントに大丈夫なの！？"},
        { "location": "193/TALK" , "narrator": "神楽", "text": "だ、だから、今のは\n書き直し前のバージョン\nなんです！"},
        { "location": "194/TALK" , "narrator": "ガブリエラ", "text": "はいはい…。"},
        { "location": "195/TALK" , "narrator": "ガブリエラ", "text": "どっちにしろ、\nお互い見せられない、\nってことね…。"},
        { "location": "198/TALK" , "narrator": "神楽", "text": "はぁ…、\nガブちゃんのノート、\n見たかったなぁ…。"},
        { "location": "199/TALK" , "narrator": "ガブリエラ", "text": "面白いことなんか\n書いてないってば。"},
        { "location": "200/ACT"  , "narrator": "", "text": "神楽のを見せてもらおう"},
        { "location": "217/TALK" , "narrator": "ガブリエラ", "text": "神楽のだけ見せてもらうの？"},
        { "location": "218/TALK" , "narrator": "ガブリエラ", "text": "さすがにそれ"},
        { "location": "219/TALK" , "narrator": "ガブリエラ", "text": "無理じゃない？"},
        { "location": "220/TALK" , "narrator": "ガブリエラ", "text": "本人だって"},
        { "location": "221/TALK" , "narrator": "ガブリエラ", "text": "積極的に見せる気なさそうだし"},
        { "location": "223/SEL"  , "narrator": "（選択肢）", "text": "内容気にならないの？"},
        { "location": "224/ACT"  , "narrator": "", "text": "内容気にならないの？"},
        { "location": "226/TALK" , "narrator": "ガブリエラ", "text": "気にはなるけど"},
        { "location": "229/TALK" , "narrator": "ガブリエラ", "text": "まあ"},
        { "location": "230/TALK" , "narrator": "ガブリエラ", "text": "聞くだけ聞いてみるわ"},
        { "location": "231/TALK" , "narrator": "ガブリエラ", "text": "もしもってこともあるし"},
        { "location": "245/TALK" , "narrator": "ガブリエラ", "text": "…とりあえず、\n神楽の書いてる小説\n読ませてよ。"},
        { "location": "247/TALK" , "narrator": "神楽", "text": "じゃあ、ガブちゃんのも\n見せてもらえるんですか？"},
        { "location": "250/TALK" , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "251/TALK" , "narrator": "神楽", "text": "え？"},
        { "location": "253/TALK" , "narrator": "ガブリエラ", "text": "ほら、早く見せなさいよ。"},
        { "location": "254/TALK" , "narrator": "神楽", "text": "えっと…ガブちゃんのは\n見せてくれないんですか？"},
        { "location": "255/TALK" , "narrator": "ガブリエラ", "text": "あたしのはいいから、\n神楽の読ませてよ。"},
        { "location": "257/TALK" , "narrator": "神楽", "text": "ちょ、嫌ですよ！\nどうして私だけ\nなんですか！？"},
        { "location": "258/TALK" , "narrator": "ガブリエラ", "text": "だって、神楽のはいずれ\n人に見せるんでしょ？"},
        { "location": "259/TALK" , "narrator": "ガブリエラ", "text": "あたしは別に、\n誰かに見せる目的で\n書いてるわけじゃないし。"},
        { "location": "261/TALK" , "narrator": "神楽", "text": "で、でも、私だけ\n見せるのはちょっと…。"},
        { "location": "262/TALK" , "narrator": "神楽", "text": "さっきも言いましたけど、\nまだ書き直す前の\nバージョンですし…。"},
        { "location": "263/TALK" , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "264/TALK" , "narrator": "神楽", "text": "…………。"},
        { "location": "265/TALK" , "narrator": "ガブリエラ", "text": "はぁ…、結局お互い、\n見せたくないってことね。"},
        { "location": "266/TALK" , "narrator": "神楽", "text": "…そうですね。"},
        { "location": "268/TALK" , "narrator": "神楽", "text": "あーあ、ガブちゃんが\n何を書いてるのか、\n知りたかったなぁ…。"},
        { "location": "269/TALK" , "narrator": "ガブリエラ", "text": "あたしのノートより、\n今は自分のお話のこと\n考えなさいよ。"},
        { "location": "270/ACT"  , "narrator": "", "text": "そんなに恥ずかしいの？"},
        { "location": "287/TALK" , "narrator": "ガブリエラ", "text": "恥ずかしい以前の問題よ"},
        { "location": "288/TALK" , "narrator": "ガブリエラ", "text": "普通日記は"},
        { "location": "289/TALK" , "narrator": "ガブリエラ", "text": "人に見せるものじゃないんだし"},
        { "location": "291/SEL"  , "narrator": "（選択肢）", "text": "ブログの延長みたいなもんだよ"},
        { "location": "292/ACT"  , "narrator": "", "text": "ブログの延長みたいなもんだよ"},
        { "location": "294/TALK" , "narrator": "ガブリエラ", "text": "いや全然違うし！"},
        { "location": "295/TALK" , "narrator": "ガブリエラ", "text": "やっぱり"},
        { "location": "296/TALK" , "narrator": "ガブリエラ", "text": "私のノートは見せられないわ"},
        { "location": "310/TALK" , "narrator": "ガブリエラ", "text": "…やっぱり、あたしのは\n見せられないわ。"},
        { "location": "312/TALK" , "narrator": "神楽", "text": "えぇーっ…。"},
        { "location": "313/TALK" , "narrator": "ガブリエラ", "text": "そんな残念そうに\nするほどのこと？"},
        { "location": "314/TALK" , "narrator": "神楽", "text": "だって、もしかしたら\n参考になるかも、と\n思ってたのに…。"},
        { "location": "316/TALK" , "narrator": "ガブリエラ", "text": "参考って…もしかして、\nネタ詰まり？"},
        { "location": "317/TALK" , "narrator": "神楽", "text": "し、仕方ないじゃない\nですか！"},
        { "location": "318/TALK" , "narrator": "神楽", "text": "いろんな乙女の心の\n引き出しを拝見したい\n気分なんです…。"},
        { "location": "319/TALK" , "narrator": "ガブリエラ", "text": "なるほど、それであたしの\nノートを見たがってた、\nってわけね。"},
        { "location": "320/TALK" , "narrator": "神楽", "text": "はい…という事情が\nあるわけなので。"},
        { "location": "321/TALK" , "narrator": "神楽", "text": "見せてくれますか？"},
        { "location": "322/TALK" , "narrator": "ガブリエラ", "text": "見せないってば。"},
        { "location": "325/TALK" , "narrator": "神楽", "text": "そんなぁ…。"},
        { "location": "326/TALK" , "narrator": "ガブリエラ", "text": "…それに、見せたとしても\n日記だから参考になんて\nならないだろうし。"}
    ]
}
