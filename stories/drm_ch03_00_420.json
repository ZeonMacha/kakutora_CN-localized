        "title": "らぶとーく  第42話",
        "sub_title": "シネマ"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "シネマ"},
        { "location": "20/TALK"   , "narrator": "ガブリエラ", "text": "ふぁ～…。"},
        { "location": "22/TALK"   , "narrator": "真幌", "text": "おい、ギャヴィ。\n名作を見ながら\nあくびをするな。"},
        { "location": "24/TALK"   , "narrator": "ガブリエラ", "text": "見たくて見てる\nわけじゃないし…。"},
        { "location": "25/TALK"   , "narrator": "ガブリエラ", "text": "っていうか、\nこれ名作なの？"},
        { "location": "26/TALK"   , "narrator": "真幌", "text": "まあ、古い映画だから\nおまえくらいの年じゃ\n知らないだろうが――"},
        { "location": "27/TALK"   , "narrator": "真幌", "text": "数々の賞を総なめした\n世界的に有名な映画だ。"},
        { "location": "28/TALK"   , "narrator": "ガブリエラ", "text": "えーっ、これが？"},
        { "location": "29/TALK"   , "narrator": "ガブリエラ", "text": "すっごい退屈で、\n見てるのが苦痛なん\nだけど…。"},
        { "location": "30/TALK"   , "narrator": "ガブリエラ", "text": "ラブロマンスの方が\n楽しくていいじゃない。"},
        { "location": "32/TALK"   , "narrator": "真幌", "text": "ははっ…ギャヴィには\nまだこの映画の良さは\nわからないか…。"},
        { "location": "34/TALK"   , "narrator": "ガブリエラ", "text": "一生わからないと\n思うけど？"},
        { "location": "36/TALK"   , "narrator": "真幌", "text": "ほら、目を反らすな。\nここからが\n名シーンだぞ。"},
        { "location": "39/TALK"   , "narrator": "真幌", "text": "今際の際の祖父と、\n主人公の孫が人生に\nついて語り合うんだ。"},
        { "location": "40/TALK"   , "narrator": "ガブリエラ", "text": "その割に、すっごい\nハキハキ喋ってると\n思うんだけど…。"},
        { "location": "41/TALK"   , "narrator": "真幌", "text": "はぁ…本当にわからん\nヤツだなぁ…。"},
        { "location": "42/TALK"   , "narrator": "真幌", "text": "ラストで、主人公が\n祖父の志に触れる\nシーンがあるんだが――"},
        { "location": "43/TALK"   , "narrator": "真幌", "text": "そこが重要なんだ。\n涙なしには見れんぞ？"},
        { "location": "44/TALK"   , "narrator": "ガブリエラ", "text": "えっ！？\n真幌も泣くの！？"},
        { "location": "46/TALK"   , "narrator": "真幌", "text": "五十回以上は見たから、\nさすがにもう泣かんな。"},
        { "location": "47/TALK"   , "narrator": "ガブリエラ", "text": "説得力なくなったわ。\nもぅ…。"},
        { "location": "48/TALK"   , "narrator": "ガブリエラ", "text": "…志に触れる、か。"},
        { "location": "60/TALK"   , "narrator": "ガブリエラ", "text": "今見てる映画なんだけど"},
        { "location": "61/TALK"   , "narrator": "ガブリエラ", "text": "主人公とおじいさんがわかりあえると思う？"},
        { "location": "63/SEL"    , "narrator": "", "text": "そういう話なの？"},
        { "location": "64/ACT"    , "narrator": "", "text": "そういう話なの？"},
        { "location": "66/TALK"   , "narrator": "ガブリエラ", "text": "内容全部話すと凄く長くなるから短く説明すると"},
        { "location": "67/TALK"   , "narrator": "ガブリエラ", "text": "おじいさんと主人公がちょっと通じ合ってない関係でね"},
        { "location": "68/TALK"   , "narrator": "ガブリエラ", "text": "真幌の話だと最後におじいさんの志に触れるみたいだけど"},
        { "location": "69/TALK"   , "narrator": "ガブリエラ", "text": "それで分かり合えると思う？"},
        { "location": "70/TALK"   , "narrator": "ガブリエラ", "text": "あたしは"},
        { "location": "71/TALK"   , "narrator": "ガブリエラ", "text": "通じ合うとは限らないと思うんだけど？"},
        { "location": "73/SEL"    , "narrator": "", "text": "そういうこともあるかもしれないね"},
        { "location": "74/SEL"    , "narrator": "", "text": "通じる日が来るまで待つ"},
        { "location": "75/SEL"    , "narrator": "", "text": "秘するが花って言葉もあるね"},
        { "location": "76/ACT"    , "narrator": "", "text": "そういうこともあるかもしれないね"},
        { "location": "77/TALK"   , "narrator": "ガブリエラ", "text": "やっぱりそう思うわよね？"},
        { "location": "88/TALK"   , "narrator": "ガブリエラ", "text": "…あ、でもこれ、\n映画だったわね。"},
        { "location": "91/TALK"   , "narrator": "真幌", "text": "何だ、急に？"},
        { "location": "94/TALK"   , "narrator": "ガブリエラ", "text": "現実じゃ、志に触れたり\nしたって、わからない\nものはわからない――"},
        { "location": "95/TALK"   , "narrator": "ガブリエラ", "text": "ってことよ。"},
        { "location": "96/TALK"   , "narrator": "真幌", "text": "随分ネガティブな\n考えだな。"},
        { "location": "97/TALK"   , "narrator": "ガブリエラ", "text": "だって、そうじゃない。"},
        { "location": "98/TALK"   , "narrator": "ガブリエラ", "text": "いくら志に触れたと\nしても――"},
        { "location": "99/TALK"   , "narrator": "ガブリエラ", "text": "親子であっても分かり\n合えないことって、\nあると思うわ。"},
        { "location": "100/TALK"  , "narrator": "真幌", "text": "…まあ、そうだな。"},
        { "location": "101/TALK"  , "narrator": "真幌", "text": "敢えて伝えないという\nのも、人生ではあるな。"},
        { "location": "102/TALK"  , "narrator": "ガブリエラ", "text": "でしょ？"},
        { "location": "103/TALK"  , "narrator": "真幌", "text": "ああ、おまえの\n言う通りだ…。"},
        { "location": "104/TALK"  , "narrator": "真幌", "text": "だがな、ギャヴィ。\n問題はそこじゃない。"},
        { "location": "105/TALK"  , "narrator": "真幌", "text": "伝えないまま\n終わったら後悔する。"},
        { "location": "106/TALK"  , "narrator": "真幌", "text": "そう思ったからこそ、\nこの爺さんはきっと――"},
        { "location": "107/TALK"  , "narrator": "真幌", "text": "孫に自分の志を\n伝えたんじゃないか？"},
        { "location": "108/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "109/TALK"  , "narrator": "真幌", "text": "まあ、これは私個人の\n感想ではあるがな。"},
        { "location": "110/TALK"  , "narrator": "真幌", "text": "おまえには、そういう\n想いはないのか？"},
        { "location": "111/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "112/TALK"  , "narrator": "ガブリエラ", "text": "…あたしの気持ちは、\nどうなのかしら？"},
        { "location": "113/TALK"  , "narrator": "ガブリエラ", "text": "このまま伝えないまま\nいようと思ったけど…。"},
        { "location": "114/TALK"  , "narrator": "ガブリエラ", "text": "…そっか。"},
        { "location": "116/TALK"  , "narrator": "ガブリエラ", "text": "なんか、それ聞いて\n納得したわ。"},
        { "location": "117/TALK"  , "narrator": "真幌", "text": "そうか？\nそう言ってもらえると、\n私も嬉しいよ。"},
        { "location": "118/TALK"  , "narrator": "ガブリエラ", "text": "…伝えないまま終わる\n後悔、か…。"},
        { "location": "119/TALK"  , "narrator": "ガブリエラ", "text": "あたしも、ちゃんと\n自分の気持ちを\n伝えないと。"},
        { "location": "120/TALK"  , "narrator": "ガブリエラ", "text": "言わないで、\nいつか絶対に後悔する\n日が来る前に…。"},
        { "location": "121/ACT"   , "narrator": "", "text": "通じる日が来るまで待つ"},
        { "location": "122/TALK"  , "narrator": "ガブリエラ", "text": "時が解決するのを待つのが一番よね"},
        { "location": "133/TALK"  , "narrator": "ガブリエラ", "text": "…このおじいさんさ、\n多分間違ってると\n思うわ。"},
        { "location": "135/TALK"  , "narrator": "真幌", "text": "ギャヴィは\nそう思うのか？"},
        { "location": "137/TALK"  , "narrator": "ガブリエラ", "text": "確かに、気持ちが\n通じ合ってないのは\n嫌かもしれない。"},
        { "location": "138/TALK"  , "narrator": "ガブリエラ", "text": "けど、待つことで\nハッピーエンドに\n繋がる可能性も――"},
        { "location": "139/TALK"  , "narrator": "ガブリエラ", "text": "あると思うの。"},
        { "location": "140/TALK"  , "narrator": "真幌", "text": "…………。"},
        { "location": "141/TALK"  , "narrator": "ガブリエラ", "text": "間違ってないでしょ？"},
        { "location": "143/TALK"  , "narrator": "真幌", "text": "…さあな。\n私にはわからん。"},
        { "location": "144/TALK"  , "narrator": "真幌", "text": "だが、一つだけ\n言えることがある。"},
        { "location": "146/TALK"  , "narrator": "真幌", "text": "…相手がいつまでも\n待ってくれるとは\n思うなよ。"},
        { "location": "147/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "148/TALK"  , "narrator": "真幌", "text": "通じる日が最後まで\n来なかったとしたら――"},
        { "location": "149/TALK"  , "narrator": "真幌", "text": "最後に残るのは、\n伝えなかったことへの\n後悔だけだからな。"},
        { "location": "150/TALK"  , "narrator": "真幌", "text": "ギャヴィはそんなことに\nなるなよ。"},
        { "location": "153/TALK"  , "narrator": "ガブリエラ", "text": "そっか…通じる日が\n来なかったら――"},
        { "location": "154/TALK"  , "narrator": "ガブリエラ", "text": "待ってるのは、\n後悔だけなんだ…。"},
        { "location": "156/TALK"  , "narrator": "ガブリエラ", "text": "なんか、それ聞いて\n納得したわ。"},
        { "location": "157/TALK"  , "narrator": "真幌", "text": "そうか？\nそう言ってもらえると、\n私も嬉しいよ。"},
        { "location": "159/TALK"  , "narrator": "ガブリエラ", "text": "あたしも、ちゃんと\n自分の気持ちを\n伝えないと。"},
        { "location": "160/TALK"  , "narrator": "ガブリエラ", "text": "言わないで、\nいつか絶対に後悔する\n日が来る前に…。"},
        { "location": "161/ACT"   , "narrator": "", "text": "秘するが花って言葉もあるね"},
        { "location": "162/TALK"  , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "163/TALK"  , "narrator": "ガブリエラ", "text": "最後まで自分の中に秘めていた方が幸せってことは"},
        { "location": "164/TALK"  , "narrator": "ガブリエラ", "text": "絶対にあると思うわ"},
        { "location": "176/TALK"  , "narrator": "ガブリエラ", "text": "…でも、志を伝えたと\nしても――"},
        { "location": "177/TALK"  , "narrator": "ガブリエラ", "text": "相手に伝わる保証なんて\nないわけよね？"},
        { "location": "179/TALK"  , "narrator": "真幌", "text": "そりゃそうだ。\n分かり合えないことも\nあるのが人生だからな。"},
        { "location": "180/TALK"  , "narrator": "ガブリエラ", "text": "だったら、そんなのは\n伝えない方が幸せなん\nじゃない？"},
        { "location": "181/TALK"  , "narrator": "ガブリエラ", "text": "分かり合えない、\nってことがわかっちゃう\nより――"},
        { "location": "182/TALK"  , "narrator": "ガブリエラ", "text": "何も伝えないでいる方が\n悪いことにはならないと\n思うわ。"},
        { "location": "184/TALK"  , "narrator": "真幌", "text": "…まあ、そういう\n考え方もあるな。"},
        { "location": "185/TALK"  , "narrator": "ガブリエラ", "text": "でしょ？"},
        { "location": "186/TALK"  , "narrator": "真幌", "text": "ああ…だが…。"},
        { "location": "188/TALK"  , "narrator": "真幌", "text": "おまえは自分の気持ちを\n伝えないまま終わる\nことに――"},
        { "location": "189/TALK"  , "narrator": "真幌", "text": "後悔を覚えずに\nいられるか？"},
        { "location": "191/TALK"  , "narrator": "ガブリエラ", "text": "…え？"},
        { "location": "192/TALK"  , "narrator": "真幌", "text": "少なくとも、この映画の\n爺さんはそう思ったん\nだろうな。"},
        { "location": "193/TALK"  , "narrator": "真幌", "text": "だから、孫に自分の志を\n伝えたんじゃないか？"},
        { "location": "195/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "197/TALK"  , "narrator": "真幌", "text": "まあ、これは私個人の\n感想ではあるがな。"},
        { "location": "198/TALK"  , "narrator": "真幌", "text": "おまえには、そういう\n想いはないのか？"},
        { "location": "199/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "201/TALK"  , "narrator": "ガブリエラ", "text": "…あたしの気持ちは、\nどうなのかしら？"},
        { "location": "202/TALK"  , "narrator": "ガブリエラ", "text": "このまま伝えないまま\nいようと思ったけど…。"},
        { "location": "203/TALK"  , "narrator": "ガブリエラ", "text": "…そっか。"},
        { "location": "204/TALK"  , "narrator": "ガブリエラ", "text": "なんか、それ聞いて\n納得したわ。"},
        { "location": "205/TALK"  , "narrator": "真幌", "text": "そうか？\nそう言ってもらえると、\n私も嬉しいよ。"},
        { "location": "207/TALK"  , "narrator": "ガブリエラ", "text": "…伝えないまま終わる\n後悔、か…。"},
        { "location": "209/TALK"  , "narrator": "ガブリエラ", "text": "あたしも、ちゃんと\n自分の気持ちを\n伝えないと。"},
        { "location": "210/TALK"  , "narrator": "ガブリエラ", "text": "言わないで、\nいつか絶対に後悔する\n日が来る前に…。"},
        { "location": "18/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>某月某日　 6:17 PM</color>\nとある平日、神楽坂トライナリーにて"}
