        { "location": "173/SCENARIO", "narrator": "", "text": "05-05_それは赤く赤く"},
        { "location": "198/TALK"    , "narrator": "つばめ", "text": "気持ちって"},
        { "location": "199/TALK"    , "narrator": "つばめ", "text": "色で表せるょね(*´︶`*)"},
        { "location": "202/SEL"     , "narrator": "", "text": "ブルーとかそういうこと？"},
        { "location": "203/SEL"     , "narrator": "", "text": "なんとなくわかる"},
        { "location": "204/SEL"     , "narrator": "", "text": "$me$の気持ちはパステルカラー"},
        { "location": "205/ACT"     , "narrator": "", "text": "ブルーとかそういうこと？"},
        { "location": "206/TALK"    , "narrator": "つばめ", "text": "そぅそぅ"},
        { "location": "207/ACT"     , "narrator": "", "text": "なんとなくわかる"},
        { "location": "208/TALK"    , "narrator": "つばめ", "text": "わかってくれる？"},
        { "location": "209/ACT"     , "narrator": "", "text": "$me$の気持ちはパステルカラー"},
        { "location": "211/TALK"    , "narrator": "つばめ", "text": "ふわふわだね"},
        { "location": "213/TALK"    , "narrator": "つばめ", "text": "そうぃぅのぃぃね"},
        { "location": "214/TALK"    , "narrator": "つばめ", "text": "楽しいょね"},
        { "location": "216/TALK"    , "narrator": "つばめ", "text": "それでね"},
        { "location": "217/TALK"    , "narrator": "つばめ", "text": "今のぁたしの気持ちは赤なの"},
        { "location": "219/SEL"     , "narrator": "", "text": "危険なの？"},
        { "location": "220/SEL"     , "narrator": "", "text": "どういう意味？"},
        { "location": "221/SEL"     , "narrator": "", "text": "燃えてるんだね"},
        { "location": "222/ACT"     , "narrator": "", "text": "危険なの？"},
        { "location": "223/TALK"    , "narrator": "つばめ", "text": "ぇ"},
        { "location": "225/TALK"    , "narrator": "つばめ", "text": "そぅじゃなぃょ"},
        { "location": "226/ACT"     , "narrator": "", "text": "どういう意味？"},
        { "location": "227/TALK"    , "narrator": "つばめ", "text": "ぁれ"},
        { "location": "229/TALK"    , "narrator": "つばめ", "text": "伝わってなぃ"},
        { "location": "230/ACT"     , "narrator": "", "text": "燃えてるんだね"},
        { "location": "232/TALK"    , "narrator": "つばめ", "text": "そぅなの"},
        { "location": "233/TALK"    , "narrator": "つばめ", "text": "色んなことに燃えてるの(≧ω≦)"},
        { "location": "235/TALK"    , "narrator": "つばめ", "text": "ぁたしにもできることがぁるんだって"},
        { "location": "236/TALK"    , "narrator": "つばめ", "text": "そう思うと"},
        { "location": "237/TALK"    , "narrator": "つばめ", "text": "気持ちがね"},
        { "location": "238/TALK"    , "narrator": "つばめ", "text": "火が着いたみたいに燃えるの"},
        { "location": "239/TALK"    , "narrator": "つばめ", "text": "だから赤なの"}
    ]
