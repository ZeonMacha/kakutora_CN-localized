{
    "dir": "dramatics/daydra/drm_ch03_00_320.js",
    "type": "Episode",
    "info": {
        "story_id": "3032",
        "cid": "gabriella",
        "title": "らぶとーく  第32話",
        "sub_title": "偶然なんかじゃないの"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "幼い恋"},
        { "location": "17/TALK"   , "narrator": "雛", "text": "ガ～ブリエラちゃんっ！"},
        { "location": "18/TALK"   , "narrator": "ガブリエラ", "text": "うわっ！？\nな、何よ…テンション\n高いわね？"},
        { "location": "19/TALK"   , "narrator": "雛", "text": "んっふっふ…\nいや～、この前いいもの\n見ちゃってねー。"},
        { "location": "20/TALK"   , "narrator": "ガブリエラ", "text": "…なんか限定の電車でも\n見たの？"},
        { "location": "21/TALK"   , "narrator": "雛", "text": "そうじゃなくて、\nガブリエラちゃんと\nヒカルくんをねー。"},
        { "location": "22/TALK"   , "narrator": "ガブリエラ", "text": "えっ！？"},
        { "location": "23/TALK"   , "narrator": "雛", "text": "買い物の途中でね、\n二人が仲良さそうに\n話してるのを見たの。"},
        { "location": "24/TALK"   , "narrator": "雛", "text": "傍から見たら、あれは\n間違いなくデートの\nオーラ放ってたね！"},
        { "location": "26/TALK"   , "narrator": "ガブリエラ", "text": "で、デート！？"},
        { "location": "28/TALK"   , "narrator": "ガブリエラ", "text": "バカ言わないで！\nあたし達は別に…\n偶然会っただけで…。"},
        { "location": "29/TALK"   , "narrator": "雛", "text": "なんとも思ってない？"},
        { "location": "31/TALK"   , "narrator": "ガブリエラ", "text": "そ、それは…その…。"},
        { "location": "33/TALK"   , "narrator": "雛", "text": "ヒカルくんのこと嫌い？"},
        { "location": "34/TALK"   , "narrator": "ガブリエラ", "text": "き、嫌いじゃないわ！"},
        { "location": "35/TALK"   , "narrator": "雛", "text": "うんうん、\nやっぱりねー。"},
        { "location": "36/TALK"   , "narrator": "雛", "text": "もし嫌いだったら、\nあんな仲良さそうな\n空気出せないだろうし。"},
        { "location": "38/TALK"   , "narrator": "雛", "text": "やっぱ、あたしの\n恋愛レーダーは\n抜群だわー。"},
        { "location": "40/TALK"   , "narrator": "ガブリエラ", "text": "…何が言いたいのよ？"},
        { "location": "42/TALK"   , "narrator": "雛", "text": "ガブリエラちゃんさ、\nヒカルくんのこと\n好きなんでしょ？"},
        { "location": "44/TALK"   , "narrator": "ガブリエラ", "text": "っ！？"},
        { "location": "45/TALK"   , "narrator": "ガブリエラ", "text": "な、なんでそういう\nことになるのよ！？"},
        { "location": "47/TALK"   , "narrator": "雛", "text": "嫌いじゃないなら、\n好きなのかなー、って\n思っただけだって。"},
        { "location": "48/TALK"   , "narrator": "雛", "text": "で？　そこんとこ\nどうなの？"},
        { "location": "51/TALK"   , "narrator": "ガブリエラ", "text": "ど、どうって…。"},
        { "location": "53/TALK"   , "narrator": "ガブリエラ", "text": "…どうしよう。\n下手なウソ言っても\n信じなさそうだし…。"},
        { "location": "55/TALK"   , "narrator": "ガブリエラ", "text": "…ちょっと待ちなさい。\n考えるから。"},
        { "location": "69/TALK"   , "narrator": "ガブリエラ", "text": "$handle$、見てたでしょ？"},
        { "location": "71/SEL"    , "narrator": "", "text": "もちろん"},
        { "location": "72/ACT"    , "narrator": "", "text": "もちろん"},
        { "location": "74/TALK"   , "narrator": "ガブリエラ", "text": "使用人として当然よね？"},
        { "location": "75/TALK"   , "narrator": "ガブリエラ", "text": "それで"},
        { "location": "76/TALK"   , "narrator": "ガブリエラ", "text": "どう答えたらいいかしら？"},
        { "location": "77/TALK"   , "narrator": "ガブリエラ", "text": "下手なウソつくより"},
        { "location": "78/TALK"   , "narrator": "ガブリエラ", "text": "本当のことを言うべき？"},
        { "location": "80/SEL"    , "narrator": "", "text": "本当に好きなのは$me$だよね"},
        { "location": "81/SEL"    , "narrator": "", "text": "キューピッドになってくれるかもよ"},
        { "location": "82/SEL"    , "narrator": "", "text": "牽制されてるんじゃない？"},
        { "location": "83/ACT"    , "narrator": "", "text": "本当に好きなのは$me$だよね"},
        { "location": "84/TALK"   , "narrator": "ガブリエラ", "text": "は？"},
        { "location": "86/TALK"   , "narrator": "ガブリエラ", "text": "使用人のクセに生意気よ"},
        { "location": "87/TALK"   , "narrator": "ガブリエラ", "text": "もういいわ"},
        { "location": "88/ACT"    , "narrator": "", "text": "キューピッドになってくれるかもよ"},
        { "location": "89/TALK"   , "narrator": "ガブリエラ", "text": "なるほど"},
        { "location": "90/TALK"   , "narrator": "ガブリエラ", "text": "じゃあヒカルくんのことが好きって伝えて…"},
        { "location": "91/TALK"   , "narrator": "ガブリエラ", "text": "や、やっぱり無理/////////"},
        { "location": "92/ACT"    , "narrator": "", "text": "牽制されてるんじゃない？"},
        { "location": "93/TALK"   , "narrator": "ガブリエラ", "text": "う～ん"},
        { "location": "94/TALK"   , "narrator": "ガブリエラ", "text": "その可能性は薄いと思うけど？"},
        { "location": "95/TALK"   , "narrator": "ガブリエラ", "text": "ひなこはそういうことするような子じゃないし"},
        { "location": "107/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "109/TALK"  , "narrator": "雛", "text": "おーい、そろそろ\n考えまとまったー？"},
        { "location": "110/TALK"  , "narrator": "ガブリエラ", "text": "ええ、一応ね。"},
        { "location": "112/TALK"  , "narrator": "ガブリエラ", "text": "さっきの質問だけど、\nノーコメントよ。"},
        { "location": "113/TALK"  , "narrator": "雛", "text": "えぇっ！？\nここまで引っ張っといて\n何そのオチ！？"},
        { "location": "116/TALK"  , "narrator": "ガブリエラ", "text": "冷静に考えたら、\nそもそもあたしが\nどう思ってるかを――"},
        { "location": "117/TALK"  , "narrator": "ガブリエラ", "text": "ひなこに教える\n必要ないでしょ？"},
        { "location": "118/TALK"  , "narrator": "雛", "text": "でもでも、あたしに\n教えたらチョーいいこと\nあるよー？"},
        { "location": "119/TALK"  , "narrator": "雛", "text": "ガブリエラちゃんの\n恋が実るために――"},
        { "location": "120/TALK"  , "narrator": "雛", "text": "色々手を回したりとか\nして協力できるし！"},
        { "location": "121/TALK"  , "narrator": "ガブリエラ", "text": "他人にそういうお節介\nする暇があるなら――"},
        { "location": "122/TALK"  , "narrator": "ガブリエラ", "text": "ひなこ自身が恋愛すれば\nいいじゃん！"},
        { "location": "124/TALK"  , "narrator": "雛", "text": "だーかーらー、\n前にも言ったじゃん。"},
        { "location": "125/TALK"  , "narrator": "雛", "text": "あたしは恋愛するのは\n苦手なんだ、って。"},
        { "location": "126/TALK"  , "narrator": "ガブリエラ", "text": "だからって他人の恋愛に\n関わろうとしないでよ！"},
        { "location": "127/TALK"  , "narrator": "雛", "text": "ほほぅ、他人の恋愛…。"},
        { "location": "128/TALK"  , "narrator": "雛", "text": "それってつまり、\nガブリエラちゃんは\nヒカルくんのことを――"},
        { "location": "129/TALK"  , "narrator": "雛", "text": "やっぱり好きって\nことでＯＫ？"},
        { "location": "131/TALK"  , "narrator": "ガブリエラ", "text": "だ、だから！！\nノーコメントだって\n言ってるでしょ！？"},
        { "location": "133/TALK"  , "narrator": "ガブリエラ", "text": "もういい！！\nこの話おしまい！！"},
        { "location": "134/TALK"  , "narrator": "雛", "text": "あはは…まあさ――"},
        { "location": "135/TALK"  , "narrator": "雛", "text": "あたし自身は確かに\n恋愛は苦手だけど――"},
        { "location": "136/TALK"  , "narrator": "雛", "text": "ヒカルくんが良いヤツ、\nっていうのは、\nよく知ってる…。"},
        { "location": "137/TALK"  , "narrator": "雛", "text": "だからさ、もしも\nガブリエラちゃんが\n本当に好きなら――"},
        { "location": "138/TALK"  , "narrator": "雛", "text": "頑張って実らせて\nくれたら、友達として\n嬉しいんだよねー。"},
        { "location": "139/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "141/TALK"  , "narrator": "雛", "text": "ま、そういうわけ\nだから――"},
        { "location": "142/TALK"  , "narrator": "雛", "text": "協力してほしい時は\nいつでも呼んでねー。"},
        { "location": "146/TALK"  , "narrator": "ガブリエラ", "text": "…一応、本気で応援は\nしてくれてるのかしら？"}
    ]
}
