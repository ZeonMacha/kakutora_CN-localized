        "title": "Twitter Archive 004",
        "sub_title": "卯月画廊：メリークリスマス♪"
    },
    "entry":
    [
        { "location": "289/TALK"  , "narrator": "透明神楽", "text": "メリークリスマース！\n皆さんにプレゼント\nですよー。"},
        { "location": "291/TALK"  , "narrator": "透明つばめ", "text": "って、えぇーっ！？"},
        { "location": "292/TALK"  , "narrator": "透明つばめ", "text": "神楽ちゃん、これ！\nわたし、裸だよ！"},
        { "location": "293/TALK"  , "narrator": "透明神楽", "text": "裸じゃありません！\nちゃんと隠してあるじゃ\nないですか。"},
        { "location": "294/TALK"  , "narrator": "透明みやび", "text": "けんどこれ、リボンやろ？"},
        { "location": "295/TALK"  , "narrator": "透明神楽", "text": "つばめさんは、\nプレゼント係なので！"},
        { "location": "297/TALK"  , "narrator": "透明みやび", "text": "あ、なるほど。"},
        { "location": "298/TALK"  , "narrator": "透明つばめ", "text": "納得しちゃうんですか！？"},
        { "location": "299/TALK"  , "narrator": "透明神楽", "text": "でも、個人的には\n裸のつばめさんも\n捨てがたかったんです…。"},
        { "location": "300/TALK"  , "narrator": "透明神楽", "text": "つばめさんの場合は、\n可愛いから裸でも\nみんな許してくれますし。"},
        { "location": "302/TALK"  , "narrator": "透明つばめ", "text": "えっ、そうなの！？"},
        { "location": "303/TALK"  , "narrator": "透明みやび", "text": "つばめちゃんこそ、\n反応間違っちょるぞね。"},
        { "location": "304/TALK"  , "narrator": "透明神楽", "text": "五人描くのはちょっと\n大変でしたけど…。"},
        { "location": "305/TALK"  , "narrator": "透明神楽", "text": "どうですか？\nこの絵、気に入って\nいただけましたか？"},
        { "location": "307/TALK"  , "narrator": "透明つばめ", "text": "う、うん…ちょっと、\n恥ずかしいけど…。"},
        { "location": "308/TALK"  , "narrator": "透明みやび", "text": "ちゅうか、うちの\n着ちょる服はなんや？"},
        { "location": "310/TALK"  , "narrator": "透明みやび", "text": "下乳どころか、\n半乳状態なんやけんど…。"},
        { "location": "311/TALK"  , "narrator": "透明神楽", "text": "この服は、トライナリーで\n一番ビューティーな人しか\n着こなせない服です。"},
        { "location": "312/TALK"  , "narrator": "透明神楽", "text": "そして、ビューティーと\nいえばみやびさん！"},
        { "location": "313/TALK"  , "narrator": "透明神楽", "text": "なので、みやびさんには\nこの服を着てもらおうと\n思ったわけです。"},
        { "location": "315/TALK"  , "narrator": "透明みやび", "text": "…最近、うちが何も\n言わんことをえいことに。"},
        { "location": "316/TALK"  , "narrator": "透明みやび", "text": "ネタキャラ扱いしてる\nようにしか思えんぞね。"},
        { "location": "317/TALK"  , "narrator": "透明神楽", "text": "そんなことありませんよ。\nみやびさんには、\nこの服が一番です！"},
        { "location": "318/TALK"  , "narrator": "透明みやび", "text": "…ふむ。"},
        { "location": "320/TALK"  , "narrator": "みやび", "text": "というわけなのだが"},
        { "location": "321/TALK"  , "narrator": "みやび", "text": "どう思う？"},
        { "location": "323/TALK"  , "narrator": "みやび", "text": "この服"},
        { "location": "324/TALK"  , "narrator": "みやび", "text": "マジで似合っているのか？"},
        { "location": "325/SEL"   , "narrator": "（選択肢）", "text": "最高です！"},
        { "location": "326/SEL"   , "narrator": "（選択肢）", "text": "寒そうです！"},
        { "location": "327/SEL"   , "narrator": "（選択肢）", "text": "露出少なめが好き"},
        { "location": "328/ACT"   , "narrator": "", "text": "最高です！"},
        { "location": "329/TALK"  , "narrator": "みやび", "text": "相棒スケベです！"},
        { "location": "330/TALK"  , "narrator": "みやび", "text": "まあ"},
        { "location": "331/TALK"  , "narrator": "みやび", "text": "服は悪くない"},
        { "location": "332/TALK"  , "narrator": "みやび", "text": "嫌いではない"},
        { "location": "333/TALK"  , "narrator": "みやび", "text": "ただし"},
        { "location": "335/TALK"  , "narrator": "みやび", "text": "うちが着なければだが"},
        { "location": "336/ACT"   , "narrator": "", "text": "寒そうです！"},
        { "location": "337/TALK"  , "narrator": "みやび", "text": "リアルに着たら"},
        { "location": "338/TALK"  , "narrator": "みやび", "text": "１００パー腹壊すだろう"},
        { "location": "339/TALK"  , "narrator": "みやび", "text": "クリスマスにこれは"},
        { "location": "340/TALK"  , "narrator": "みやび", "text": "拷問ではないか？"},
        { "location": "342/ACT"   , "narrator": "", "text": "露出少なめが好き"},
        { "location": "343/TALK"  , "narrator": "みやび", "text": "逆にその方が"},
        { "location": "344/TALK"  , "narrator": "みやび", "text": "マニアック感出る気がするのだが"},
        { "location": "345/TALK"  , "narrator": "みやび", "text": "どうだろうか？"},
        { "location": "346/SEL"   , "narrator": "（選択肢）", "text": "わかってらっしゃる"},
        { "location": "347/SEL"   , "narrator": "（選択肢）", "text": "そうなのかな？"},
        { "location": "348/ACT"   , "narrator": "", "text": "わかってらっしゃる"},
        { "location": "349/TALK"  , "narrator": "みやび", "text": "スクープ！"},
        { "location": "351/TALK"  , "narrator": "みやび", "text": "相棒にはマニアックな趣味があった！"},
        { "location": "352/TALK"  , "narrator": "みやび", "text": "まあ"},
        { "location": "353/TALK"  , "narrator": "みやび", "text": "趣味は人それぞれである"},
        { "location": "354/TALK"  , "narrator": "みやび", "text": "責めはしない"},
        { "location": "355/TALK"  , "narrator": "みやび", "text": "褒めもしない"},
        { "location": "356/ACT"   , "narrator": "", "text": "そうなのかな？"},
        { "location": "357/TALK"  , "narrator": "みやび", "text": "わからん"},
        { "location": "358/TALK"  , "narrator": "みやび", "text": "うちの勘違いかもしれん"},
        { "location": "359/TALK"  , "narrator": "みやび", "text": "気にするな"},
        { "location": "362/TALK"  , "narrator": "みやび", "text": "しかし"},
        { "location": "364/TALK"  , "narrator": "みやび", "text": "サンタクロース"},
        { "location": "365/TALK"  , "narrator": "みやび", "text": "相棒は"},
        { "location": "366/TALK"  , "narrator": "みやび", "text": "サンタを信じるか？"},
        { "location": "367/SEL"   , "narrator": "（選択肢）", "text": "昔は信じてた"},
        { "location": "368/SEL"   , "narrator": "（選択肢）", "text": "いてほしいと信じてるよ"},
        { "location": "369/ACT"   , "narrator": "", "text": "昔は信じてた"},
        { "location": "370/TALK"  , "narrator": "みやび", "text": "うちもそうだった"},
        { "location": "371/TALK"  , "narrator": "みやび", "text": "幼稚園くらいまでだったか？"},
        { "location": "373/TALK"  , "narrator": "みやび", "text": "懐かしい"},
        { "location": "374/TALK"  , "narrator": "みやび", "text": "純粋無垢で夢いっぱいのうちよ"},
        { "location": "375/ACT"   , "narrator": "", "text": "いてほしいと信じてるよ"},
        { "location": "376/TALK"  , "narrator": "みやび", "text": "嫌いじゃないぞね"},
        { "location": "377/TALK"  , "narrator": "みやび", "text": "その信じ方"},
        { "location": "378/TALK"  , "narrator": "みやび", "text": "確かに"},
        { "location": "379/TALK"  , "narrator": "みやび", "text": "いてほしいとは思う"},
        { "location": "381/TALK"  , "narrator": "みやび", "text": "まあ"},
        { "location": "382/TALK"  , "narrator": "みやび", "text": "サンタがいようがいなかろうが"},
        { "location": "383/TALK"  , "narrator": "みやび", "text": "うちは枕元に"},
        { "location": "384/TALK"  , "narrator": "みやび", "text": "ちゃんと靴下用意して眠るのだが"},
        { "location": "385/SEL"   , "narrator": "（選択肢）", "text": "そうなの！？"},
        { "location": "386/ACT"   , "narrator": "", "text": "そうなの！？"},
        { "location": "388/TALK"  , "narrator": "みやび", "text": "伝統行事は重んじる"},
        { "location": "389/TALK"  , "narrator": "みやび", "text": "それがうちスタイルちや"},
        { "location": "390/SEL"   , "narrator": "（選択肢）", "text": "可愛い一面発見"},
        { "location": "391/SEL"   , "narrator": "（選択肢）", "text": "$me$もやってみようかな？"},
        { "location": "392/ACT"   , "narrator": "", "text": "可愛い一面発見"},
        { "location": "393/TALK"  , "narrator": "みやび", "text": "行事を重んじてるだけだが"},
        { "location": "394/TALK"  , "narrator": "みやび", "text": "褒められているようなので"},
        { "location": "395/TALK"  , "narrator": "みやび", "text": "良しとしよう"},
        { "location": "396/ACT"   , "narrator": "", "text": "$me$もやってみようかな？"},
        { "location": "397/TALK"  , "narrator": "みやび", "text": "えいと思うぞね"},
        { "location": "399/TALK"  , "narrator": "みやび", "text": "プレゼントは突っ込まれないだろうが"},
        { "location": "400/TALK"  , "narrator": "みやび", "text": "だが"},
        { "location": "401/TALK"  , "narrator": "みやび", "text": "いい夢くらいは見れるかもしれん"},
        { "location": "402/TALK"  , "narrator": "みやび", "text": "オススメするぞね"},
        { "location": "409/DIALOG", "narrator": "", "text": "このシナリオの元になっている\nTwitterの会話ログを見ますか？"}
    ]
}
