        { "location": "2299/TALK", "narrator": "プレイヤー", "text": "お着替えしてみよう"},
        { "location": "2301/TALK", "narrator": "プレイヤー", "text": "違う服を着てほしいな"},
        { "location": "2303/TALK", "narrator": "プレイヤー", "text": "よし、お着替えタイムだ！"},
        { "location": "2309/TALK", "narrator": "プレイヤー", "text": "やあ"},
        { "location": "2311/TALK", "narrator": "プレイヤー", "text": "こんにちは"},
        { "location": "2313/TALK", "narrator": "プレイヤー", "text": "げんき？"},
        { "location": "2316/TALK", "narrator": "神楽", "text": "ぴょんこを呼ぶ声"},
        { "location": "2317/TALK", "narrator": "神楽", "text": "あなたはだあれ？"},
        { "location": "2319/SEL" , "narrator": "", "text": "$handle$だよ"},
        { "location": "2320/ACT" , "narrator": "", "text": "$handle$だよ"},
        { "location": "2322/TALK", "narrator": "神楽", "text": "知ってるし"},
        { "location": "2323/TALK", "narrator": "神楽", "text": "ぴょんこに用事ぴょん？"},
        { "location": "2326/SEL" , "narrator": "", "text": "ちょっと着替えてほしいんだ"},
        { "location": "2327/ACT" , "narrator": "", "text": "ちょっと着替えてほしいんだ"},
        { "location": "2337/TALK", "narrator": "神楽", "text": "意味不明すぎ"},
        { "location": "2338/TALK", "narrator": "神楽", "text": "でもまあ"},
        { "location": "2339/TALK", "narrator": "神楽", "text": "優しいぴょんこは聞いてあげるのだった"},
        { "location": "2341/TALK", "narrator": "神楽", "text": "は？"},
        { "location": "2342/TALK", "narrator": "神楽", "text": "この服変だった？"},
        { "location": "2343/TALK", "narrator": "神楽", "text": "なら着替えるけど"},
        { "location": "2346/SEL" , "narrator": "", "text": "$me$が選ぶ"},
        { "location": "2347/SEL" , "narrator": "", "text": "やっぱやめる"},
        { "location": "2349/TALK", "narrator": "神楽", "text": "…………"},
        { "location": "2352/TALK", "narrator": "神楽", "text": "リクエストないとか？"},
        { "location": "2353/TALK", "narrator": "神楽", "text": "なら着ない"},
        { "location": "2355/ACT" , "narrator": "", "text": "$me$が選ぶ"},
        { "location": "2356/TALK", "narrator": "神楽", "text": "だと思った"},
        { "location": "2357/TALK", "narrator": "神楽", "text": "どれを着てほしいと？"},
        { "location": "2364/ACT" , "narrator": "", "text": "やっぱやめる"},
        { "location": "2365/TALK", "narrator": "神楽", "text": "ありえネー"}
    ]
