        "title": "スペシャルエピソード",
        "sub_title": "春眠暁を覚えず"
    },
    "entry":
    [
        { "location": "28/TALK" , "narrator": "透明みやび", "text": "ん～、あと五十分…。"},
        { "location": "30/TALK" , "narrator": "透明みやび", "text": "くぅ～…。"},
        { "location": "38/TALK" , "narrator": "透明みやび", "text": "ん～、あと地球の\n自転五回分…。"},
        { "location": "40/TALK" , "narrator": "透明みやび", "text": "くぅ～…。"},
        { "location": "41/SEL"  , "narrator": "（選択肢）", "text": "みやび、起きなきゃダメだよ"},
        { "location": "42/ACT"  , "narrator": "", "text": "みやび、起きなきゃダメだよ"},
        { "location": "44/TALK" , "narrator": "透明みやび", "text": "ん～…、なんやもぅ…。"},
        { "location": "48/TALK" , "narrator": "透明みやび", "text": "ふぁ～…。\nまた朝が来てしもうた\nかぁ…。"},
        { "location": "52/TALK" , "narrator": "みやび", "text": "なのか？"},
        { "location": "53/SEL"  , "narrator": "（選択肢）", "text": "え？"},
        { "location": "54/ACT"  , "narrator": "", "text": "え？"},
        { "location": "56/TALK" , "narrator": "みやび", "text": "↑なにか？"},
        { "location": "58/TALK" , "narrator": "みやび", "text": "寝起きで目が阿寒"},
        { "location": "59/TALK" , "narrator": "みやび", "text": "画面が欲見得ん"},
        { "location": "60/SEL"  , "narrator": "（選択肢）", "text": "変換間違えまくりだよ"},
        { "location": "61/SEL"  , "narrator": "（選択肢）", "text": "身体伸ばして目を覚まして"},
        { "location": "62/ACT"  , "narrator": "", "text": "変換間違えまくりだよ"},
        { "location": "63/TALK" , "narrator": "みやび", "text": "あ？"},
        { "location": "64/TALK" , "narrator": "みやび", "text": "間違え？"},
        { "location": "66/TALK" , "narrator": "みやび", "text": "人は間違いを繰り返して生きていく生き物"},
        { "location": "67/TALK" , "narrator": "みやび", "text": "寝起きと同時に人間の証明"},
        { "location": "68/TALK" , "narrator": "みやび", "text": "ここまで確実な人間はおらんな"},
        { "location": "69/ACT"  , "narrator": "", "text": "身体伸ばして目を覚まして"},
        { "location": "72/TALK" , "narrator": "みやび", "text": "首は伸びない"},
        { "location": "73/TALK" , "narrator": "みやび", "text": "人だから"},
        { "location": "74/TALK" , "narrator": "みやび", "text": "故に悲しく"},
        { "location": "76/TALK" , "narrator": "みやび", "text": "そして眠い"},
        { "location": "78/SEL"  , "narrator": "（選択肢）", "text": "大丈夫？　起きてる？"},
        { "location": "79/ACT"  , "narrator": "", "text": "大丈夫？　起きてる？"},
        { "location": "81/TALK" , "narrator": "みやび", "text": "身体ダルダル"},
        { "location": "82/TALK" , "narrator": "みやび", "text": "あたまモヤモヤ"},
        { "location": "83/TALK" , "narrator": "みやび", "text": "目はクラクラ"},
        { "location": "84/TALK" , "narrator": "みやび", "text": "それでも起きて話してる"},
        { "location": "85/TALK" , "narrator": "みやび", "text": "夜が待ち遠しい"},
        { "location": "86/SEL"  , "narrator": "（選択肢）", "text": "夜まで頑張ろう"},
        { "location": "87/SEL"  , "narrator": "（選択肢）", "text": "シャキッとして！"},
        { "location": "88/SEL"  , "narrator": "（選択肢）", "text": "胸元が凄いことになってる"},
        { "location": "89/ACT"  , "narrator": "", "text": "夜まで頑張れる？"},
        { "location": "92/TALK" , "narrator": "みやび", "text": "むり"},
        { "location": "94/TALK" , "narrator": "みやび", "text": "よる連れてきて"},
        { "location": "95/TALK" , "narrator": "みやび", "text": "スマホで呼び出し頼む"},
        { "location": "96/TALK" , "narrator": "みやび", "text": "とモーニング無茶ぶりを言うてみた"},
        { "location": "98/ACT"  , "narrator": "", "text": "シャキッとして！"},
        { "location": "102/TALK", "narrator": "みやび", "text": "しゃきぃん"},
        { "location": "103/TALK", "narrator": "みやび", "text": "したぞ"},
        { "location": "104/TALK", "narrator": "みやび", "text": "目覚めた"},
        { "location": "105/TALK", "narrator": "みやび", "text": "気持ちだけは"},
        { "location": "107/ACT" , "narrator": "", "text": "胸元が凄いことになってる"},
        { "location": "112/TALK", "narrator": "みやび", "text": "ビックリしたか？"},
        { "location": "114/TALK", "narrator": "みやび", "text": "大きくて重い"},
        { "location": "115/TALK", "narrator": "みやび", "text": "外せば身体が軽くなりパワーアップなバトル漫画展開"},
        { "location": "116/TALK", "narrator": "みやび", "text": "ということにはならん無駄な重り"},
        { "location": "117/SEL" , "narrator": "（選択肢）", "text": "そうじゃなくて見えちゃいそう"},
        { "location": "118/ACT" , "narrator": "", "text": "そうじゃなくて見えちゃいそう"},
        { "location": "122/TALK", "narrator": "みやび", "text": "ああ"},
        { "location": "123/TALK", "narrator": "みやび", "text": "その発想はなかった"},
        { "location": "124/TALK", "narrator": "みやび", "text": "まあ"},
        { "location": "125/TALK", "narrator": "みやび", "text": "自室だから問題なし"},
        { "location": "126/SEL" , "narrator": "（選択肢）", "text": "いや、$me$が見てるし"},
        { "location": "127/SEL" , "narrator": "（選択肢）", "text": "こっちが心配になる"},
        { "location": "128/ACT" , "narrator": "", "text": "いや、$me$が見てるし"},
        { "location": "129/TALK", "narrator": "みやび", "text": "こういう反応を所望か？"},
        { "location": "131/TALK", "narrator": "みやび", "text": "いやん"},
        { "location": "132/TALK", "narrator": "みやび", "text": "見ないで"},
        { "location": "134/TALK", "narrator": "みやび", "text": "ノルマ達成でＯＫ？"},
        { "location": "137/ACT" , "narrator": "", "text": "こっちが心配になる"},
        { "location": "138/TALK", "narrator": "みやび", "text": "安心せよ"},
        { "location": "139/TALK", "narrator": "みやび", "text": "セキュリティは完璧"},
        { "location": "140/TALK", "narrator": "みやび", "text": "まあ"},
        { "location": "141/TALK", "narrator": "みやび", "text": "見るのは相棒だけ"},
        { "location": "142/TALK", "narrator": "みやび", "text": "うちは気にならん"},
        { "location": "143/SEL" , "narrator": "（選択肢）", "text": "光栄に思うよ"},
        { "location": "144/ACT" , "narrator": "", "text": "光栄に思うよ"},
        { "location": "146/TALK", "narrator": "みやび", "text": "特別扱いされてる思うた？"},
        { "location": "148/TALK", "narrator": "みやび", "text": "見られてもどうも感じない"},
        { "location": "149/TALK", "narrator": "みやび", "text": "そんな存在の可能性もあるかもしれん"},
        { "location": "150/TALK", "narrator": "みやび", "text": "覚えておく"},
        { "location": "156/TALK", "narrator": "みやび", "text": "目が覚めてきたので"},
        { "location": "157/TALK", "narrator": "みやび", "text": "いい加減起きようと思う"},
        { "location": "158/TALK", "narrator": "みやび", "text": "相棒と話したおかげやね"},
        { "location": "159/TALK", "narrator": "みやび", "text": "さらば"},
        { "location": "165/TALK", "narrator": "みやび", "text": "とにかく起きる"},
        { "location": "166/TALK", "narrator": "みやび", "text": "まだ眠いが起きる"},
        { "location": "167/TALK", "narrator": "みやび", "text": "うちは起きるぞー"},
        { "location": "173/TALK", "narrator": "透明みやび", "text": "…といいつつも、\n二度寝の誘惑に\n勝てるわけもなく――"},
        { "location": "175/TALK", "narrator": "透明みやび", "text": "おやすみ…。"},
        { "location": "180/TALK", "narrator": "透明ガブリエラ", "text": "ちょっと、みやび。\nもう学校行く時間\nなんだけど？"},
        { "location": "184/TALK", "narrator": "透明ガブリエラ", "text": "って、何でまだ\nパジャマなのよ？"},
        { "location": "185/TALK", "narrator": "透明みやび", "text": "ん、ガブちゃん。\nいってらっしゃい、\nおやすみなさい…。"},
        { "location": "186/TALK", "narrator": "透明ガブリエラ", "text": "おやすみなさい\nじゃない！"},
        { "location": "187/TALK", "narrator": "透明ガブリエラ", "text": "ほら、さっさと\n顔洗ってきなさいよ。\nもうギリギリよ？"},
        { "location": "190/TALK", "narrator": "透明みやび", "text": "…行かんとダメか？"},
        { "location": "191/TALK", "narrator": "透明ガブリエラ", "text": "サボりは不良の証よ。\nほら、いつまでも\n年頃のレディが――"},
        { "location": "192/TALK", "narrator": "透明ガブリエラ", "text": "そんなみっともない\n格好してんじゃない\nわよ。"},
        { "location": "194/TALK", "narrator": "透明みやび", "text": "はぁ…しゃあない…。"},
        { "location": "195/TALK", "narrator": "透明みやび", "text": "ガブちゃん目覚ましに\n起こされては、うちも\n逆らえんきねぇ…。"},
        { "location": "196/TALK", "narrator": "透明ガブリエラ", "text": "誰が目覚ましよ！？"}
    ]
}
