        { "location": "7/SCENARIO", "narrator": "", "text": "030_口にする日を"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "$marzanna$が代わりにお礼を言ってくれるって言った時"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "ちょっとびっくりしたわ"},
        { "location": "34/TALK"   , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "35/TALK"   , "narrator": "ガブリエラ", "text": "助かったわ"},
        { "location": "37/SEL"    , "narrator": "", "text": "そういう問題？"},
        { "location": "38/SEL"    , "narrator": "", "text": "次も任せて"},
        { "location": "39/SEL"    , "narrator": "", "text": "いつかは自分で言おうね"},
        { "location": "40/ACT"    , "narrator": "", "text": "そういう問題？"},
        { "location": "41/TALK"   , "narrator": "ガブリエラ", "text": "あら"},
        { "location": "43/TALK"   , "narrator": "ガブリエラ", "text": "違うのかしら"},
        { "location": "45/SEL"    , "narrator": "", "text": "親切にしてもらったんでしょう？"},
        { "location": "46/ACT"    , "narrator": "", "text": "親切にしてもらったんでしょう？"},
        { "location": "47/TALK"   , "narrator": "ガブリエラ", "text": "そうよ"},
        { "location": "48/TALK"   , "narrator": "ガブリエラ", "text": "その通りよ"},
        { "location": "51/TALK"   , "narrator": "ガブリエラ", "text": "そう言われれば"},
        { "location": "52/TALK"   , "narrator": "ガブリエラ", "text": "私とても偉そうだったかもしれないわ"},
        { "location": "53/TALK"   , "narrator": "ガブリエラ", "text": "ちゃんとお礼が言えるようにならなくちゃね"},
        { "location": "55/ACT"    , "narrator": "", "text": "次も任せて"},
        { "location": "56/TALK"   , "narrator": "ガブリエラ", "text": "本当？"},
        { "location": "58/TALK"   , "narrator": "ガブリエラ", "text": "やっぱり$marzanna$はいい子ねｖｖｖｖ"},
        { "location": "59/TALK"   , "narrator": "ガブリエラ", "text": "ありがとう$marzanna$"},
        { "location": "60/ACT"    , "narrator": "", "text": "いつかは自分で言おうね"},
        { "location": "62/TALK"   , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "63/TALK"   , "narrator": "ガブリエラ", "text": "いつもいつも"},
        { "location": "64/TALK"   , "narrator": "ガブリエラ", "text": "$marzanna$に頼りっきりなのはいけないわ"},
        { "location": "66/SEL"    , "narrator": "", "text": "フォローはするから"},
        { "location": "67/SEL"    , "narrator": "", "text": "ダメな時は言って？"},
        { "location": "68/SEL"    , "narrator": "", "text": "ガブリエラは偉いね"},
        { "location": "69/ACT"    , "narrator": "", "text": "フォローはするから"},
        { "location": "70/TALK"   , "narrator": "ガブリエラ", "text": "ありがとう$marzanna$"},
        { "location": "71/TALK"   , "narrator": "ガブリエラ", "text": "貴方はやっぱり優しいわ"},
        { "location": "72/TALK"   , "narrator": "ガブリエラ", "text": "そんなところがだいすきよ"},
        { "location": "73/ACT"    , "narrator": "", "text": "ダメな時は言って？"},
        { "location": "74/TALK"   , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "76/TALK"   , "narrator": "ガブリエラ", "text": "お願いするかもしれないわ"},
        { "location": "77/TALK"   , "narrator": "ガブリエラ", "text": "でも頑張るから"},
        { "location": "78/TALK"   , "narrator": "ガブリエラ", "text": "私のこと見ていてね"},
        { "location": "79/ACT"    , "narrator": "", "text": "ガブリエラは偉いね"},
        { "location": "80/TALK"   , "narrator": "ガブリエラ", "text": "$marzanna$ったら"},
        { "location": "82/TALK"   , "narrator": "ガブリエラ", "text": "慰めてくれてるのかしら？"},
        { "location": "83/TALK"   , "narrator": "ガブリエラ", "text": "優しい$marzanna$"},
        { "location": "84/TALK"   , "narrator": "ガブリエラ", "text": "だいすきよ"}
    ]
