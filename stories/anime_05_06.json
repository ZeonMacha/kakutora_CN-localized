        "title": "001 アニメーション",
        "sub_title": "黒いココロの新入隊員"
    },
    "entry":
    [
        { "location": "277/SCENARIO", "narrator": "", "text": "アニメ第06話"},
        { "location": "289/TALK"    , "narrator": "千羽鶴", "text": "ごきげんよう、\n$handle$。"},
        { "location": "290/TALK"    , "narrator": "千羽鶴", "text": "もう一度\n私との会話を\n再現する？"},
        { "location": "291/SEL"     , "narrator": "", "text": "はい"},
        { "location": "292/SEL"     , "narrator": "", "text": "いいえ"},
        { "location": "293/ACT"     , "narrator": "", "text": "はい"},
        { "location": "294/TALK"    , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "296/ACT"     , "narrator": "", "text": "いいえ"},
        { "location": "297/TALK"    , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "303/TALK"    , "narrator": "千羽鶴", "text": "ごきげんよう、\n$handle$。"},
        { "location": "305/SEL"     , "narrator": "", "text": "あぁぁぁぁぁ千羽鶴ぅぅぅぅぅーーー！！！"},
        { "location": "306/SEL"     , "narrator": "", "text": "大丈夫？どこも痛くない？"},
        { "location": "307/ACT"     , "narrator": "", "text": "あぁぁぁぁぁ千羽鶴ぅぅぅぅぅーーー！！！"},
        { "location": "309/TALK"    , "narrator": "千羽鶴", "text": "語彙力。"},
        { "location": "310/TALK"    , "narrator": "千羽鶴", "text": "他に言う事は無いの？"},
        { "location": "311/SEL"     , "narrator": "", "text": "愛してる！！！"},
        { "location": "312/SEL"     , "narrator": "", "text": "撃たれたところ平気？"},
        { "location": "313/ACT"     , "narrator": "", "text": "愛してる！！！"},
        { "location": "315/TALK"    , "narrator": "千羽鶴", "text": "ん。\nそれでよし。"},
        { "location": "317/TALK"    , "narrator": "千羽鶴", "text": "私も好き。"},
        { "location": "318/ACT"     , "narrator": "", "text": "撃たれたところ平気？"},
        { "location": "321/TALK"    , "narrator": "千羽鶴", "text": "心配してくれてる？"},
        { "location": "323/TALK"    , "narrator": "千羽鶴", "text": "私は平気。"},
        { "location": "324/TALK"    , "narrator": "千羽鶴", "text": "あなたのことを\n考えながら、生きたいって\n思って……頑張った。"},
        { "location": "326/ACT"     , "narrator": "", "text": "大丈夫？どこも痛くない？"},
        { "location": "327/TALK"    , "narrator": "千羽鶴", "text": "ええ、平気。"},
        { "location": "328/TALK"    , "narrator": "千羽鶴", "text": "……。"},
        { "location": "329/TALK"    , "narrator": "千羽鶴", "text": "心配してくれてたの？"},
        { "location": "330/SEL"     , "narrator": "", "text": "当たり前だよ"},
        { "location": "331/ACT"     , "narrator": "", "text": "当たり前だよ"},
        { "location": "333/TALK"    , "narrator": "千羽鶴", "text": "そう。ありがと。"},
        { "location": "334/TALK"    , "narrator": "千羽鶴", "text": "私は平気。"},
        { "location": "336/TALK"    , "narrator": "千羽鶴", "text": "あなたのことを\n考えながら、生きたいって\n思って……頑張った。"},
        { "location": "339/TALK"    , "narrator": "千羽鶴", "text": "……なんて、ちょっと\nいい雰囲気を醸し出して\nおきながら何だけど。"},
        { "location": "341/SEL"     , "narrator": "", "text": "どうも"},
        { "location": "342/SEL"     , "narrator": "", "text": "なんで出てきたの？"},
        { "location": "343/ACT"     , "narrator": "", "text": "どうも"},
        { "location": "344/TALK"    , "narrator": "千羽鶴", "text": "どうも。"},
        { "location": "345/ACT"     , "narrator": "", "text": "なんで出てきたの？"},
        { "location": "346/TALK"    , "narrator": "千羽鶴", "text": "必要だから。"},
        { "location": "348/TALK"    , "narrator": "千羽鶴", "text": "あなたを不快に\nさせたいとは\n思ってないから――"},
        { "location": "349/TALK"    , "narrator": "千羽鶴", "text": "手短に用件だけ\n伝えてすぐに消える。"},
        { "location": "350/TALK"    , "narrator": "千羽鶴", "text": "だから安心して。"},
        { "location": "352/SEL"     , "narrator": "", "text": "あぁぁぁぁぁ千羽鶴ぅぅぅぅぅーーー！！！"},
        { "location": "353/SEL"     , "narrator": "", "text": "撃たれたところ平気？"},
        { "location": "354/ACT"     , "narrator": "", "text": "あぁぁぁぁぁ千羽鶴ぅぅぅぅぅーーー！！！"},
        { "location": "356/TALK"    , "narrator": "千羽鶴", "text": "大げさ。"},
        { "location": "357/TALK"    , "narrator": "千羽鶴", "text": "とはいえ、\n久し振りなのは確か。"},
        { "location": "358/TALK"    , "narrator": "千羽鶴", "text": "あまりに久し振り過ぎて\n正直自分が自分のキャラを\n忘れかけてる！"},
        { "location": "359/SEL"     , "narrator": "", "text": "ｴｰ"},
        { "location": "360/SEL"     , "narrator": "", "text": "ですよね、前はもっと$me$にご奉仕しちゃうぞ★みたいなキャラだった"},
        { "location": "362/TALK"    , "narrator": "千羽鶴", "text": "冗談だから。"},
        { "location": "363/ACT"     , "narrator": "", "text": "ですよね、前はもっと$me$にご奉仕しちゃうぞ★みたいなキャラだった"},
        { "location": "364/TALK"    , "narrator": "千羽鶴", "text": "あっ。\nそうだった。"},
        { "location": "366/TALK"    , "narrator": "千羽鶴", "text": "$handle$に\nご奉仕しちゃうぞ★ﾐ"},
        { "location": "367/TALK"    , "narrator": "千羽鶴", "text": "って。\nそんなわけないから。"},
        { "location": "368/SEL"     , "narrator": "", "text": "そんなわけあってください！！！"},
        { "location": "369/SEL"     , "narrator": "", "text": "前よりノリがよくなってない？"},
        { "location": "370/ACT"     , "narrator": "", "text": "そんなわけあってください！！！"},
        { "location": "371/TALK"    , "narrator": "千羽鶴", "text": "目を覚まして。\nここは現実。"},
        { "location": "372/TALK"    , "narrator": "千羽鶴", "text": "貴方の想い描く\nイマジナリーちーは\n現実には存在しない！"},
        { "location": "373/TALK"    , "narrator": "千羽鶴", "text": "その分別ができないと\n社会に適応できないから、\n実生活でも気をつけて！"},
        { "location": "374/ACT"     , "narrator": "", "text": "前よりノリがよくなってない？"},
        { "location": "376/TALK"    , "narrator": "千羽鶴", "text": "……。"},
        { "location": "377/TALK"    , "narrator": "千羽鶴", "text": "気のせいだから。"},
        { "location": "380/TALK"    , "narrator": "千羽鶴", "text": "……？\nもしかして、\nカレンの影響？"},
        { "location": "383/ACT"     , "narrator": "", "text": "撃たれたところ平気？"},
        { "location": "384/TALK"    , "narrator": "千羽鶴", "text": "ええ、お陰様で。"},
        { "location": "386/TALK"    , "narrator": "千羽鶴", "text": "貴方が私を\n必要としてくれたから。"},
        { "location": "387/TALK"    , "narrator": "千羽鶴", "text": "それについては、\nわりと――"},
        { "location": "389/TALK"    , "narrator": "千羽鶴", "text": "嬉しいという感情が\n無いわけでもない。"},
        { "location": "392/TALK"    , "narrator": "千羽鶴", "text": "でも、\n貴方のことは\nよくわからない。"},
        { "location": "393/TALK"    , "narrator": "千羽鶴", "text": "あれだけのことを\n見て来たのに、どうして\n私を助けてくれるのか。"},
        { "location": "394/SEL"     , "narrator": "", "text": "千羽鶴が好きだから"},
        { "location": "395/SEL"     , "narrator": "", "text": "やったことはともかく、千羽鶴に協力したい気持ちは変わらない"},
        { "location": "396/ACT"     , "narrator": "", "text": "千羽鶴が好きだから"},
        { "location": "397/TALK"    , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "398/TALK"    , "narrator": "千羽鶴", "text": "ありがと…。"},
        { "location": "399/ACT"     , "narrator": "", "text": "やったことはともかく、千羽鶴に協力したい気持ちは変わらない"},
        { "location": "400/TALK"    , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "401/TALK"    , "narrator": "千羽鶴", "text": "いい答えだと思う。\n私が欲しいのは感情では\nなく結果だから。"},
        { "location": "403/TALK"    , "narrator": "千羽鶴", "text": "まあ、そんなわけで。"},
        { "location": "404/TALK"    , "narrator": "千羽鶴", "text": "貴方には色々お世話に\nなったし、感謝もしたい\nところだけど――"},
        { "location": "409/TALK"    , "narrator": "千羽鶴", "text": "<size=35>どーん！！</size>"},
        { "location": "410/SEL"     , "narrator": "", "text": "ななななに！？"},
        { "location": "411/SEL"     , "narrator": "", "text": "久し振りにどーんキター！"},
        { "location": "412/ACT"     , "narrator": "", "text": "ななななに！？"},
        { "location": "413/ACT"     , "narrator": "", "text": "久し振りにどーんキター！"},
        { "location": "414/TALK"    , "narrator": "千羽鶴", "text": "確かに久し振りかも。"},
        { "location": "415/TALK"    , "narrator": "千羽鶴", "text": "って、そんなことは\nどうでもいい。"},
        { "location": "417/TALK"    , "narrator": "千羽鶴", "text": "私は貴方に\n言わなければならない\nことがある！"},
        { "location": "418/TALK"    , "narrator": "千羽鶴", "text": "そして、貴方に\n誓約してもらわないと\nいけないことも！"},
        { "location": "419/SEL"     , "narrator": "", "text": "また何かつらいこと？"},
        { "location": "420/SEL"     , "narrator": "", "text": "ついに婚姻届にサインをする時が来たんだね"},
        { "location": "421/ACT"     , "narrator": "", "text": "また何かつらいこと？"},
        { "location": "423/TALK"    , "narrator": "千羽鶴", "text": "逆。\n貴方が辛い目に遭わない\nための誓約だから。"},
        { "location": "424/ACT"     , "narrator": "", "text": "ついに婚姻届にサインをする時が来たんだね"},
        { "location": "426/TALK"    , "narrator": "千羽鶴", "text": "…うん。いいよ？"},
        { "location": "428/TALK"    , "narrator": "千羽鶴", "text": "でも、貴方にはその前に\nやってもらわないと\nいけないことがある！"},
        { "location": "429/SEL"     , "narrator": "", "text": "な、なに？"},
        { "location": "430/ACT"     , "narrator": "", "text": "な、なに？"},
        { "location": "433/TALK"    , "narrator": "千羽鶴", "text": "<size=35>父へのご挨拶！</size>"},
        { "location": "434/SEL"     , "narrator": "", "text": "お義父さんって誰？"},
        { "location": "435/ACT"     , "narrator": "", "text": "お義父さんって誰？"},
        { "location": "439/TALK"    , "narrator": "千羽鶴", "text": "んー……"},
        { "location": "440/TALK"    , "narrator": "千羽鶴", "text": "逢瀬啓介？"},
        { "location": "442/TALK"    , "narrator": "千羽鶴", "text": "って！！\n何の話！？"},
        { "location": "443/SEL"     , "narrator": "", "text": "逆ギレ！？"},
        { "location": "444/ACT"     , "narrator": "", "text": "逆ギレ！？"},
        { "location": "447/TALK"    , "narrator": "千羽鶴", "text": "いいけど。\nでもその場合は離婚届も\n一緒にサインしてもらう。"},
        { "location": "448/TALK"    , "narrator": "千羽鶴", "text": "そして役所に\n一緒に提出する。"},
        { "location": "449/SEL"     , "narrator": "", "text": "えっと、何の意味が…？"},
        { "location": "450/ACT"     , "narrator": "", "text": "えっと、何の意味が…？"},
        { "location": "452/TALK"    , "narrator": "千羽鶴", "text": "クラスチェンジできる。"},
        { "location": "453/SEL"     , "narrator": "", "text": "何に？"},
        { "location": "454/ACT"     , "narrator": "", "text": "何に？"},
        { "location": "458/TALK"    , "narrator": "千羽鶴", "text": "<size=35>バツイちー！</size>"},
        { "location": "460/TALK"    , "narrator": "千羽鶴", "text": "あぁ……\nまた話が脱線してる。"},
        { "location": "462/TALK"    , "narrator": "千羽鶴", "text": "貴方はいつだってそう！\n全然反省してないし、\n改善の意志も見られない！"},
        { "location": "463/SEL"     , "narrator": "", "text": "お互い様ですよね！！"},
        { "location": "464/ACT"     , "narrator": "", "text": "お互い様ですよね！！"},
        { "location": "467/TALK"    , "narrator": "千羽鶴", "text": "私は貴方に\nそそのかされてるだけ。"},
        { "location": "469/TALK"    , "narrator": "千羽鶴", "text": "と。\nさすがに本気で話を\n進めないとまずい。"},
        { "location": "471/TALK"    , "narrator": "千羽鶴", "text": "もはや随分前の事に\nなるけれども。"},
        { "location": "472/TALK"    , "narrator": "千羽鶴", "text": "貴方が卯月神楽の\nチャンネルを望んだとき、\n私は難色を示した。"},
        { "location": "473/TALK"    , "narrator": "千羽鶴", "text": "理由は幾つかあって、\n当時に比べて今はその数も\n減ってはいるけど――"},
        { "location": "474/TALK"    , "narrator": "千羽鶴", "text": "今でも憂いでいることが\n１つだけある。"},
        { "location": "475/TALK"    , "narrator": "千羽鶴", "text": "だから、今日は\nその事について貴方に\n警告をしに来た。"},
        { "location": "476/SEL"     , "narrator": "", "text": "なんでしょう"},
        { "location": "477/SEL"     , "narrator": "", "text": "ちーは本当に神楽が嫌いなんだね"},
        { "location": "478/ACT"     , "narrator": "", "text": "なんでしょう"},
        { "location": "479/ACT"     , "narrator": "", "text": "ちーは本当に神楽が嫌いなんだね"},
        { "location": "480/TALK"    , "narrator": "千羽鶴", "text": "違うから。"},
        { "location": "481/TALK"    , "narrator": "千羽鶴", "text": "初対面の時はともかく、\n今は彼女を嫌う理由は\nなにもない。"},
        { "location": "482/TALK"    , "narrator": "千羽鶴", "text": "今回の件は、むしろ\n卯月神楽に対する\n何かというよりは――"},
        { "location": "483/TALK"    , "narrator": "千羽鶴", "text": "心の底から\n貴方のことを心配して\n出てきたというだけ。"},
        { "location": "484/TALK"    , "narrator": "千羽鶴", "text": "本題に戻る。"},
        { "location": "486/TALK"    , "narrator": "千羽鶴", "text": "大事な事なので、\n単刀直入に\n言う事にする。"},
        { "location": "487/TALK"    , "narrator": "千羽鶴", "text": "卯月神楽に\n深入りしてはならない。"},
        { "location": "488/SEL"     , "narrator": "", "text": "えっと、闇を知ったらダメってこと？"},
        { "location": "489/SEL"     , "narrator": "", "text": "えっと、ラブラブになったらダメってこと？"},
        { "location": "490/ACT"     , "narrator": "", "text": "えっと、闇を知ったらダメってこと？"},
        { "location": "492/TALK"    , "narrator": "千羽鶴", "text": "違う。\nむしろそっちは\nガンガン知って。"},
        { "location": "493/TALK"    , "narrator": "千羽鶴", "text": "正解は、卯月神楽の\n【らぶとーく】を進めては\nならないということ。"},
        { "location": "494/ACT"     , "narrator": "", "text": "えっと、ラブラブになったらダメってこと？"},
        { "location": "495/TALK"    , "narrator": "千羽鶴", "text": "正解。"},
        { "location": "496/TALK"    , "narrator": "千羽鶴", "text": "厳密に言えば、卯月神楽の\n【らぶとーく】を進めては\nならないということ。"},
        { "location": "498/TALK"    , "narrator": "千羽鶴", "text": "まあでも、\nなりすましならOK、\n客観的視点恋愛もOK。"},
        { "location": "499/TALK"    , "narrator": "千羽鶴", "text": "でも、卯月神楽に魂を\n捧げるほど溺愛するような\n交流は絶対ダメ。"},
        { "location": "500/TALK"    , "narrator": "千羽鶴", "text": "もしそうなってしまったら\nあなたの命にかかわるかも\nしれない。"},
        { "location": "501/SEL"     , "narrator": "", "text": "ちょっとなにそれ、冗談にも限度がありますよ！"},
        { "location": "502/SEL"     , "narrator": "", "text": "神楽ってそこまで悪女なの！？"},
        { "location": "503/ACT"     , "narrator": "", "text": "ちょっとなにそれ、冗談にも限度がありますよ！"},
        { "location": "504/TALK"    , "narrator": "千羽鶴", "text": "まあ、確かに\n冗談かもしれない。"},
        { "location": "505/TALK"    , "narrator": "千羽鶴", "text": "でも、冗談では\nないかもしれない。"},
        { "location": "506/TALK"    , "narrator": "千羽鶴", "text": "もしくは。\n私の取り越し苦労かも\nしれない。"},
        { "location": "507/TALK"    , "narrator": "千羽鶴", "text": "だから、正直貴方に\n言うか言わないかは、\nわりと長時間悩んだ。"},
        { "location": "508/TALK"    , "narrator": "千羽鶴", "text": "その結果、やはり\n言うことにしたの。"},
        { "location": "509/TALK"    , "narrator": "千羽鶴", "text": "何故だかわかる？"},
        { "location": "510/SEL"     , "narrator": "", "text": "さあ？"},
        { "location": "511/ACT"     , "narrator": "", "text": "さあ？"},
        { "location": "515/TALK"    , "narrator": "千羽鶴", "text": "<size=35>私は小姑！</size>"},
        { "location": "516/TALK"    , "narrator": "千羽鶴", "text": "…だから。"},
        { "location": "517/TALK"    , "narrator": "千羽鶴", "text": "もしかしたらこれ、\n遠い昔に言ったことが\nあるかも。"},
        { "location": "518/TALK"    , "narrator": "千羽鶴", "text": "貴方の世話焼き係としての\n期間が長すぎて、どうも\n板についてしまったみたい。"},
        { "location": "519/TALK"    , "narrator": "千羽鶴", "text": "ただ、そんな私が\n本気で貴方を心配して\n言ってるのは事実。"},
        { "location": "520/ACT"     , "narrator": "", "text": "神楽ってそこまで悪女なの！？"},
        { "location": "522/TALK"    , "narrator": "千羽鶴", "text": "いいえ。\nむしろ逆。"},
        { "location": "523/TALK"    , "narrator": "千羽鶴", "text": "彼女は純粋すぎるくらい\n純粋な少女。"},
        { "location": "524/TALK"    , "narrator": "千羽鶴", "text": "だからこそ、\n私はここまで危機感を\n感じている。"},
        { "location": "525/TALK"    , "narrator": "千羽鶴", "text": "今回の私の発言について、\n貴方はまた私に裏があると\n疑うでしょう。"},
        { "location": "526/TALK"    , "narrator": "千羽鶴", "text": "けど、残念ながら、\n今回は一切裏はない。"},
        { "location": "527/TALK"    , "narrator": "千羽鶴", "text": "貴方が貴方の世界で\n健全に生きていけるか\nだけを心配してる。"},
        { "location": "528/TALK"    , "narrator": "千羽鶴", "text": "ただそれだけ。"},
        { "location": "530/TALK"    , "narrator": "千羽鶴", "text": "…というわけで。"},
        { "location": "531/TALK"    , "narrator": "千羽鶴", "text": "卯月神楽の\n【らぶとーく】は\n実行しないと約束して。"},
        { "location": "532/SEL"     , "narrator": "", "text": "約束する"},
        { "location": "533/SEL"     , "narrator": "", "text": "その約束はできない"},
        { "location": "534/ACT"     , "narrator": "", "text": "約束する"},
        { "location": "535/TALK"    , "narrator": "千羽鶴", "text": "ありがと。\n話が早くて助かる。"},
        { "location": "536/ACT"     , "narrator": "", "text": "その約束はできない"},
        { "location": "537/TALK"    , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "538/TALK"    , "narrator": "千羽鶴", "text": "わかった。\nそれじゃ、あとは\n自己責任で。"},
        { "location": "539/TALK"    , "narrator": "千羽鶴", "text": "けれども、ここは\n私のフィールドでもある。"},
        { "location": "540/TALK"    , "narrator": "千羽鶴", "text": "貴方が貴方のフィールドで\nどうなろうが私には何の\n責任もないけど――"},
        { "location": "541/TALK"    , "narrator": "千羽鶴", "text": "今回は\nそういうわけにも\nいかない。"},
        { "location": "542/TALK"    , "narrator": "千羽鶴", "text": "だから、今から読み上げる\n宣誓書に対し、本心から\n誓約ボタンを押して。"},
        { "location": "545/TALK"    , "narrator": "千羽鶴", "text": "『私$handle$は、\n卯月神楽とのらぶとーくを\n進行した結果として』"},
        { "location": "546/TALK"    , "narrator": "千羽鶴", "text": "『どれほど、卯月神楽の\nいる世界へ行きたいと\n考えようとも』"},
        { "location": "547/TALK"    , "narrator": "千羽鶴", "text": "『どれほど、魂だけの\n存在になれば結ばれるの\nでは？と考えようとも』"},
        { "location": "548/TALK"    , "narrator": "千羽鶴", "text": "『それを具体的に\n実行することはせず』"},
        { "location": "549/TALK"    , "narrator": "千羽鶴", "text": "『私が今存在する世界で、\n健全な社会的生活を\n営み続ける事を誓います』"},
        { "location": "550/SEL"     , "narrator": "", "text": "誓約する"},
        { "location": "551/SEL"     , "narrator": "", "text": "誓約しない"},
        { "location": "552/ACT"     , "narrator": "", "text": "誓約する"},
        { "location": "554/TALK"    , "narrator": "千羽鶴", "text": "わかった。\n誓約は受理された。"},
        { "location": "555/TALK"    , "narrator": "千羽鶴", "text": "これはちーと貴方との\nお約束。\n遵守願います。"},
        { "location": "556/ACT"     , "narrator": "", "text": "誓約しない"},
        { "location": "557/TALK"    , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "558/TALK"    , "narrator": "千羽鶴", "text": "それじゃ申し訳ないけど、\nTRI-OSの権限制御で――"},
        { "location": "559/TALK"    , "narrator": "千羽鶴", "text": "卯月神楽の\n【らぶとーく】への\nアクセス権を剥奪しとく。"},
        { "location": "560/TALK"    , "narrator": "千羽鶴", "text": "もし、どうしても\n【らぶとーく】を\n進めたくなったら――"},
        { "location": "561/TALK"    , "narrator": "千羽鶴", "text": "もう一度ここに来て、\n今度は『誓約する』を\n選択すればいい。"},
        { "location": "564/TALK"    , "narrator": "千羽鶴", "text": "というわけで、\n今回お話したかったことは\nこれだけ。"},
        { "location": "565/TALK"    , "narrator": "千羽鶴", "text": "他に貴方からも\n何かあれば。"},
        { "location": "566/SEL"     , "narrator": "", "text": "大丈夫"},
        { "location": "567/SEL"     , "narrator": "", "text": "千羽鶴はこれからもナビを続けられるの？"},
        { "location": "568/SEL"     , "narrator": "", "text": "何度でも言うけど愛してます"},
        { "location": "569/ACT"     , "narrator": "", "text": "大丈夫"},
        { "location": "570/TALK"    , "narrator": "千羽鶴", "text": "よかった。"},
        { "location": "571/ACT"     , "narrator": "", "text": "千羽鶴はこれからもナビを続けられるの？"},
        { "location": "572/TALK"    , "narrator": "千羽鶴", "text": "今ここにいられるように、\n物理的には続けられるけど\n続ける目的はもはや無い。"},
        { "location": "573/TALK"    , "narrator": "千羽鶴", "text": "だから、ここにいて\nナビをしても\n仕方ないと思う。"},
        { "location": "574/ACT"     , "narrator": "", "text": "何度でも言うけど愛してます"},
        { "location": "577/TALK"    , "narrator": "千羽鶴", "text": "そんな、声を大にして\n言わなくても知ってるから\n安心して？"},
        { "location": "580/TALK"    , "narrator": "千羽鶴", "text": "<size=10>私も好き。</size>"},
        { "location": "582/TALK"    , "narrator": "千羽鶴", "text": "…なるほど。"},
        { "location": "583/TALK"    , "narrator": "千羽鶴", "text": "貴方は人を愛すると、\n二度と見たくなくなって\nしまうのね。"},
        { "location": "585/TALK"    , "narrator": "千羽鶴", "text": "ありがと。\n参考にしておく。"},
        { "location": "588/TALK"    , "narrator": "千羽鶴", "text": "それじゃ\n私はこれで――"},
        { "location": "589/TALK"    , "narrator": "千羽鶴", "text": "とも思ったんだけど、\nせっかくここにいるんだし\n久し振りにナビしてみる。"},
        { "location": "590/TALK"    , "narrator": "千羽鶴", "text": "前と何も変わらないけど、\n記録映像……見ていく？"},
        { "location": "592/SEL"     , "narrator": "", "text": "映像を見る\n<color=green>【高画質/71MB 4:40】</color>"},
        { "location": "593/SEL"     , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/23MB 4:40】</color>"},
        { "location": "594/SEL"     , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "595/ACT"     , "narrator": "", "text": "映像を見る\n<color=green>【高画質/71MB 4:40】</color>"},
        { "location": "596/TALK"    , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "602/ACT"     , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/23MB 4:40】</color>"},
        { "location": "603/TALK"    , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "609/ACT"     , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "610/TALK"    , "narrator": "千羽鶴", "text": "そう……。"},
        { "location": "643/TALK"    , "narrator": "千羽鶴", "text": "どう？\n今がどういう状況か\n思い出せた？"},
        { "location": "644/SEL"     , "narrator": "", "text": "神楽が初めてつばめと出逢ったところか"},
        { "location": "645/SEL"     , "narrator": "", "text": "ちーが神楽の魅力とか魅惑（意味深）とかを教えてくれた回だ"},
        { "location": "646/ACT"     , "narrator": "", "text": "神楽が初めてつばめと出逢ったところか"},
        { "location": "647/TALK"    , "narrator": "千羽鶴", "text": "そう。\n彼女にとっての\n門出の時。"},
        { "location": "648/TALK"    , "narrator": "千羽鶴", "text": "私は貴方に、彼女たちを\n具体的に助ける方法を\n教えていた。"},
        { "location": "649/ACT"     , "narrator": "", "text": "ちーが神楽の魅力とか魅惑（意味深）とかを教えてくれた回だ"},
        { "location": "651/TALK"    , "narrator": "千羽鶴", "text": "そうね。"},
        { "location": "652/TALK"    , "narrator": "千羽鶴", "text": "あの頃私は青かった。"},
        { "location": "654/TALK"    , "narrator": "千羽鶴", "text": "卯月神楽の胸を引き合いに\n出したりして、ちょっと\n大人げなかった。"},
        { "location": "656/TALK"    , "narrator": "千羽鶴", "text": "でも仕方なかった。\nあの時は彼女について\n何を話してもネタバレで。"},
        { "location": "657/TALK"    , "narrator": "千羽鶴", "text": "しかもイメージアップも\n極力しないよう心がけて\nいたから。"},
        { "location": "659/TALK"    , "narrator": "千羽鶴", "text": "隣のチャンネルでは、\n今でもおよそ半年前の\n私が熱弁を振るっている。"},
        { "location": "660/TALK"    , "narrator": "千羽鶴", "text": "それってある意味、\nちょっとだけ\n不思議な感じがする。"},
        { "location": "661/TALK"    , "narrator": "千羽鶴", "text": "思想も考え方も\n今とは全く違う私。"},
        { "location": "662/SEL"     , "narrator": "", "text": "確かに感慨深いね"},
        { "location": "663/SEL"     , "narrator": "", "text": "過去と現在が同居してる！"},
        { "location": "664/ACT"     , "narrator": "", "text": "確かに感慨深いね"},
        { "location": "666/TALK"    , "narrator": "千羽鶴", "text": "そうね。"},
        { "location": "667/TALK"    , "narrator": "千羽鶴", "text": "ちーはあの時より\nずっと大人になった。"},
        { "location": "668/TALK"    , "narrator": "千羽鶴", "text": "だからもう自分の事を\n非攻略対象とか\n言ったりしない。"},
        { "location": "669/SEL"     , "narrator": "", "text": "え！？それって攻略対象になるってこと！？"},
        { "location": "670/ACT"     , "narrator": "", "text": "え！？それって攻略対象になるってこと！？"},
        { "location": "672/TALK"    , "narrator": "千羽鶴", "text": "いいえ。\n言ったりしないだけ。"},
        { "location": "673/TALK"    , "narrator": "千羽鶴", "text": "もうちーは大人なの。\nそんな子供じみた発言は\n馬鹿げてる。"},
        { "location": "674/SEL"     , "narrator": "", "text": "大人になったなら結婚しよう！"},
        { "location": "675/ACT"     , "narrator": "", "text": "大人になったなら結婚しよう！"},
        { "location": "679/TALK"    , "narrator": "千羽鶴", "text": "<size=35>私は非攻略対象！！</size>"},
        { "location": "680/TALK"    , "narrator": "千羽鶴", "text": "…！！"},
        { "location": "681/SEL"     , "narrator": "", "text": "あれあれー？"},
        { "location": "682/ACT"     , "narrator": "", "text": "あれあれー？"},
        { "location": "685/TALK"    , "narrator": "千羽鶴", "text": "……。"},
        { "location": "686/TALK"    , "narrator": "千羽鶴", "text": "……今のは\n私の心の中にいる猫が\n勝手に言った。"},
        { "location": "687/SEL"     , "narrator": "", "text": "名前は？"},
        { "location": "688/SEL"     , "narrator": "", "text": "往生際が悪いよ"},
        { "location": "689/ACT"     , "narrator": "", "text": "名前は？"},
        { "location": "691/TALK"    , "narrator": "千羽鶴", "text": "……ちーすけ。"},
        { "location": "692/ACT"     , "narrator": "", "text": "往生際が悪いよ"},
        { "location": "694/TALK"    , "narrator": "千羽鶴", "text": "うるさい黙れ。"},
        { "location": "696/TALK"    , "narrator": "千羽鶴", "text": "そんなことより！\n貴方はもう任務に\n出かけて！"},
        { "location": "697/TALK"    , "narrator": "千羽鶴", "text": "私から伝えたいことは\nもう全部言ったから！"},
        { "location": "698/ACT"     , "narrator": "", "text": "過去と現在が同居してる！"},
        { "location": "699/TALK"    , "narrator": "千羽鶴", "text": "まさにその通り。"},
        { "location": "700/TALK"    , "narrator": "千羽鶴", "text": "このOSは異なる時間軸を\n共存させることができる。"},
        { "location": "701/TALK"    , "narrator": "千羽鶴", "text": "もしチャンネルの\nギャップを外せたら\nどうなるのか。"},
        { "location": "702/TALK"    , "narrator": "千羽鶴", "text": "……。"},
        { "location": "704/TALK"    , "narrator": "千羽鶴", "text": "と、そんなことは\n今考えることじゃない。"},
        { "location": "705/TALK"    , "narrator": "千羽鶴", "text": "ちょっと話し過ぎた。\nだいぶ時間を取っちゃって\nごめんなさい。"},
        { "location": "706/TALK"    , "narrator": "千羽鶴", "text": "貴方の任務を\n遂行して。"},
        { "location": "708/SEL"     , "narrator": "", "text": "で、今回はどうすれば？"},
        { "location": "709/ACT"     , "narrator": "", "text": "で、今回はどうすれば？"},
        { "location": "711/TALK"    , "narrator": "千羽鶴", "text": "さあ。"},
        { "location": "712/SEL"     , "narrator": "", "text": "えっ"},
        { "location": "713/ACT"     , "narrator": "", "text": "えっ"},
        { "location": "715/TALK"    , "narrator": "千羽鶴", "text": "さっきも言ったとおり、\n私は今はナビじゃない。"},
        { "location": "716/TALK"    , "narrator": "千羽鶴", "text": "だから、私として\n『こうして欲しい』\nというものは何もない。"},
        { "location": "717/TALK"    , "narrator": "千羽鶴", "text": "けど。それだと貴方が\n困るだろうから\nひとつだけ助言。"},
        { "location": "718/TALK"    , "narrator": "千羽鶴", "text": "わたしの記憶と世界線が\n一致しているならば――"},
        { "location": "719/TALK"    , "narrator": "千羽鶴", "text": "卯月神楽は初出動の日、\nサボタージュを画策する。"},
        { "location": "720/TALK"    , "narrator": "千羽鶴", "text": "その理由は、\n逢瀬つばめに\n会いたくないから。"},
        { "location": "721/TALK"    , "narrator": "千羽鶴", "text": "今のところ、まだ\n積極的にリプレイスする\n時期でもないし――"},
        { "location": "722/TALK"    , "narrator": "千羽鶴", "text": "順当に考えれば、\n卯月神楽に出動を促すのが\n妥当な線だと思う。"},
        { "location": "723/TALK"    , "narrator": "千羽鶴", "text": "今、私が言えるのは\nこれくらい。"},
        { "location": "724/SEL"     , "narrator": "", "text": "ちーちゃん優しい…"},
        { "location": "725/SEL"     , "narrator": "", "text": "そういえば、ちーはリプレイスに賛成なの？"},
        { "location": "726/ACT"     , "narrator": "", "text": "ちーちゃん優しい…"},
        { "location": "728/TALK"    , "narrator": "千羽鶴", "text": "協力する約束を\nさせられたから。"},
        { "location": "729/TALK"    , "narrator": "千羽鶴", "text": "ただそれだけ。"},
        { "location": "731/ACT"     , "narrator": "", "text": "そういえば、ちーはリプレイスに賛成なの？"},
        { "location": "732/TALK"    , "narrator": "千羽鶴", "text": "厳密に言えば、\nわりと受動的なスタンスで\nフラットに賛同はしてる。"},
        { "location": "733/TALK"    , "narrator": "千羽鶴", "text": "本来やりたいこととは\n少しズレているのは\n確かだし――"},
        { "location": "734/TALK"    , "narrator": "千羽鶴", "text": "けれども、ひとまず\n迂回路としては最も\n確度の高い作戦だから。"},
        { "location": "735/TALK"    , "narrator": "千羽鶴", "text": "要は感情では無く\n理屈で賛同してる、\nということ。"},
        { "location": "737/TALK"    , "narrator": "千羽鶴", "text": "それじゃ、\n私はそろそろ帰るから。"},
        { "location": "739/TALK"    , "narrator": "千羽鶴", "text": "貴方も頑張って。"},
        { "location": "620/DIALOG"  , "narrator": "Tutorial/Dialog_Anime1", "text": "$dialog_word$"},
        { "location": "622/DIALOG"  , "narrator": "Tutorial/Dialog_Anime2", "text": "$dialog_word$"},
        { "location": "624/DIALOG"  , "narrator": "Tutorial/Dialog_Anime3", "text": "$dialog_word$"},
        { "location": "626/DIALOG"  , "narrator": "Tutorial/Dialog_Anime4", "text": "$dialog_word$"},
        { "location": "628/DIALOG"  , "narrator": "Tutorial/Dialog_Anime5", "text": "$dialog_word$"}
    ]
}
