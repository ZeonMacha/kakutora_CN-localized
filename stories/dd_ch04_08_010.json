{
    "dir": "chap08/daydra/dd_ch04_08_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "8452",
        "cid": "miyabi",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "着付け教室"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "着付け教室"},
        { "location": "24/TALK"   , "narrator": "ガブリエラ", "text": "着付け教室ぅ？\nみやびが教えてるの？"},
        { "location": "26/TALK"   , "narrator": "みやび", "text": "うむ。"},
        { "location": "27/TALK"   , "narrator": "みやび", "text": "うち、私服が和服やき、\n最近学校でよく頼まれ\nるんよ。"},
        { "location": "28/TALK"   , "narrator": "みやび", "text": "やき、昼休みに希望者\n集めて教えちゅう。"},
        { "location": "29/TALK"   , "narrator": "ガブリエラ", "text": "ふ～ん、そうなんだ…。"},
        { "location": "30/TALK"   , "narrator": "ガブリエラ", "text": "それで、みんなちゃんと\n覚えてくれてる？"},
        { "location": "31/TALK"   , "narrator": "みやび", "text": "ん～…まだしばらくは\n掛かりそうやね。"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "洋服と違って着るのに\n時間も掛かるし――"},
        { "location": "33/TALK"   , "narrator": "みやび", "text": "昼休みの時間も\n限られちゅうき――"},
        { "location": "34/TALK"   , "narrator": "みやび", "text": "しばらくは続けんと\nいかんやろうね。"},
        { "location": "35/TALK"   , "narrator": "ガブリエラ", "text": "紐の結び方とか、\n一回じゃ覚えられなさ\nそう…。"},
        { "location": "36/TALK"   , "narrator": "みやび", "text": "みんな苦労しちゅうよ。"},
        { "location": "37/TALK"   , "narrator": "みやび", "text": "…けんど、和服に興味ある\n言われたら協力せん\nわけにはいかんき――"},
        { "location": "39/TALK"   , "narrator": "みやび", "text": "先生気分を\n楽しんじゅうきね。"},
        { "location": "42/TALK"   , "narrator": "ガブリエラ", "text": "いいんじゃない？"},
        { "location": "43/TALK"   , "narrator": "ガブリエラ", "text": "和服って素敵だから、\nあたしも好きよ。"},
        { "location": "45/TALK"   , "narrator": "みやび", "text": "ガブちゃんなら\nそう言うと思うちょった。"},
        { "location": "47/TALK"   , "narrator": "みやび", "text": "…ちゅうか。"},
        { "location": "54/TALK"   , "narrator": "ガブリエラ", "text": "どうしたの？"},
        { "location": "57/TALK"   , "narrator": "みやび", "text": "いや、気付いた\nことがあるんよ。\nちっくと待ちや。"},
        { "location": "69/TALK"   , "narrator": "みやび", "text": "相棒、今気づいたんやけんど"},
        { "location": "70/TALK"   , "narrator": "みやび", "text": "ガブちゃんが着物着たら、結構似合うと思わんちや？"},
        { "location": "71/TALK"   , "narrator": "みやび", "text": "元が美少女やき、似合わんちゅうことはないと思うんよ"},
        { "location": "73/SEL"    , "narrator": "", "text": "着付け教えてあげよう"},
        { "location": "74/SEL"    , "narrator": "", "text": "馬子にも衣装だ"},
        { "location": "75/SEL"    , "narrator": "", "text": "ガブちゃんには洋服だ！"},
        { "location": "76/ACT"    , "narrator": "", "text": "着付け教えてあげよう"},
        { "location": "77/TALK"   , "narrator": "みやび", "text": "うん、そうするちや"},
        { "location": "78/TALK"   , "narrator": "みやび", "text": "ついでにガブちゃんの和服姿も見れるしな"},
        { "location": "90/TALK"   , "narrator": "みやび", "text": "ガブちゃんも着付け教室、\n来てみるが？"},
        { "location": "91/TALK"   , "narrator": "ガブリエラ", "text": "あたしはいいわ。"},
        { "location": "92/TALK"   , "narrator": "みやび", "text": "…珍しいなぁ。\nガブちゃんがこういうの\n断るなんて…。"},
        { "location": "94/TALK"   , "narrator": "ガブリエラ", "text": "あら、言ってなかった？\nあたし着付けなら\nできるのよ。"},
        { "location": "98/TALK"   , "narrator": "みやび", "text": "マジなが！？"},
        { "location": "99/TALK"   , "narrator": "ガブリエラ", "text": "マジって…本当よ。"},
        { "location": "102/TALK"  , "narrator": "ガブリエラ", "text": "和服って凄く綺麗だから、\n一人で着れるように\nなりたくて――"},
        { "location": "103/TALK"  , "narrator": "ガブリエラ", "text": "日本に来る前に\n独学で勉強したのよ。"},
        { "location": "104/TALK"  , "narrator": "みやび", "text": "そうやったか…。"},
        { "location": "107/TALK"  , "narrator": "ガブリエラ", "text": "ええ…それにほら、\n人に着せてもらうのって\nちょっと恥ずかしいし…。"},
        { "location": "108/TALK"  , "narrator": "みやび", "text": "偉いな、ガブちゃん。\nちっくと見直したがよ。"},
        { "location": "111/TALK"  , "narrator": "ガブリエラ", "text": "ふふっ…けど、やっぱり\n独学だから少し不安も\nあるの…。"},
        { "location": "114/TALK"  , "narrator": "ガブリエラ", "text": "そのうち、\n一度見てもらえる？"},
        { "location": "115/TALK"  , "narrator": "みやび", "text": "えいよ。\nガブちゃんのお手並み\n拝見するぞね。"},
        { "location": "119/TALK"  , "narrator": "ガブリエラ", "text": "もう、プレッシャー\n掛けないでよ！"},
        { "location": "120/ACT"   , "narrator": "", "text": "馬子にも衣装だ"},
        { "location": "121/TALK"  , "narrator": "みやび", "text": "相棒、それはちっくと言い過ぎちや"},
        { "location": "122/TALK"  , "narrator": "みやび", "text": "雰囲気は変わるやろうけんど、ガブちゃんは普通にしててもちゃんとしてるき"},
        { "location": "123/TALK"  , "narrator": "みやび", "text": "あんましそういうこと言うんは感心せんよ"},
        { "location": "134/TALK"  , "narrator": "みやび", "text": "ふぅ…。"},
        { "location": "137/TALK"  , "narrator": "ガブリエラ", "text": "どうかした？"},
        { "location": "139/TALK"  , "narrator": "みやび", "text": "何でもないちや…。\nしっかし、ガブちゃんが\n和服着るいうなら――"},
        { "location": "140/TALK"  , "narrator": "みやび", "text": "うちが普段着てる\nミニの浴衣とかも\n似合いそうやね。"},
        { "location": "144/TALK"  , "narrator": "ガブリエラ", "text": "あ～…\nみやびには悪いけど、\nあれは却下だわ。"},
        { "location": "145/TALK"  , "narrator": "ガブリエラ", "text": "あたし、みやびに会うまで\nミニの浴衣があるなんて\n知らなかったから――"},
        { "location": "146/TALK"  , "narrator": "ガブリエラ", "text": "浴衣イコール裾が長い、\nってイメージが強いのよ。"},
        { "location": "147/TALK"  , "narrator": "みやび", "text": "わからんくはないな。\nうちも最初は同じこと\n考えちょったき。"},
        { "location": "148/TALK"  , "narrator": "みやび", "text": "けんど、一回着てみたら\n意外に着やすくてなぁ。"},
        { "location": "150/TALK"  , "narrator": "ガブリエラ", "text": "う～ん…\nそうかもしれないけど…。"},
        { "location": "151/TALK"  , "narrator": "ガブリエラ", "text": "やっぱり、あたしは\n普通のがいいわ。"},
        { "location": "152/TALK"  , "narrator": "みやび", "text": "…一度くらい着てから\n言うてもらいたいんや\nけんどなぁ。"},
        { "location": "153/ACT"   , "narrator": "", "text": "ガブちゃんは洋服だ！"},
        { "location": "155/TALK"  , "narrator": "みやび", "text": "…まあ、ガブちゃんは西洋人やし"},
        { "location": "156/TALK"  , "narrator": "みやび", "text": "そう思うんもわからんではない"},
        { "location": "167/TALK"  , "narrator": "みやび", "text": "…ガブちゃんの和服姿、\n想像できんしなぁ。"},
        { "location": "170/TALK"  , "narrator": "ガブリエラ", "text": "みやびの前では\n着たことなかったっけ？"},
        { "location": "171/TALK"  , "narrator": "ガブリエラ", "text": "一応、自分の浴衣は\n持ってるのよ？"},
        { "location": "173/TALK"  , "narrator": "みやび", "text": "そうやったが…\n浴衣かぁ…。"},
        { "location": "174/TALK"  , "narrator": "みやび", "text": "そういえば、前に浴衣着た\n美人の外国人さんを見たこと\nあったけんど……"},
        { "location": "175/TALK"  , "narrator": "みやび", "text": "あれは綺麗やったわぁ…。\n女のうちでも見惚れる\nほどやったき。"},
        { "location": "177/TALK"  , "narrator": "ガブリエラ", "text": "ふふん、西洋人だって\n和服は似合うのよ。"},
        { "location": "179/TALK"  , "narrator": "みやび", "text": "そうやね。"},
        { "location": "180/TALK"  , "narrator": "みやび", "text": "…ガブちゃんも、\nもうちっくと\n大人になって――"},
        { "location": "181/TALK"  , "narrator": "みやび", "text": "おしとやかになったら、\n和服の似合う美人に\nなりそうちや。"},
        { "location": "183/TALK"  , "narrator": "ガブリエラ", "text": "…褒められてるんだか\n貶されてるんだか、\nすっごい微妙なんだけど？"},
        { "location": "184/TALK"  , "narrator": "みやび", "text": "冗談やって。\n今でも着てるとこ見たら、\nきっと似合う思うよ。"},
        { "location": "188/TALK"  , "narrator": "みやび", "text": "…けんど、大人になった\nガブちゃんが着た姿は、\nいつか見てみたいぞね。"},
        { "location": "15/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>5月19日　12:23 PM</color>\nＷＡＶＥ戦の翌週平日、昼休みに学園廊下にて。"},
        { "location": "199/DIALOG", "narrator": "Dialog_GEThimegoto_ch04", "text": "【伝統と革新のワルツ】"}
    ]
}
