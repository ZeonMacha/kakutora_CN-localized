        "title": "Extra012 ヒメゴトチャット",
        "sub_title": "フェンスは乗り越えるもの"
    },
    "entry":
    [
        { "location": "143/SCENARIO", "narrator": "", "text": "002_フェンスは乗り越えるもの"},
        { "location": "168/TALK"    , "narrator": "みやび", "text": "知っとるかねチミ"},
        { "location": "169/TALK"    , "narrator": "みやび", "text": "障害というものはな"},
        { "location": "173/TALK"    , "narrator": "みやび", "text": "どうすればいいと思う？"},
        { "location": "175/SEL"     , "narrator": "", "text": "取り除く"},
        { "location": "176/SEL"     , "narrator": "", "text": "発生を抑える"},
        { "location": "177/SEL"     , "narrator": "", "text": "あると燃える"},
        { "location": "179/TALK"    , "narrator": "みやび", "text": "ほれほれ"},
        { "location": "182/TALK"    , "narrator": "みやび", "text": "あー"},
        { "location": "187/TALK"    , "narrator": "みやび", "text": "うまくいかんもんぞね"},
        { "location": "192/ACT"     , "narrator": "", "text": "取り除く"},
        { "location": "193/TALK"    , "narrator": "みやび", "text": "障害物競走的な障害か"},
        { "location": "194/TALK"    , "narrator": "みやび", "text": "なるほどな"},
        { "location": "195/ACT"     , "narrator": "", "text": "発生を抑える"},
        { "location": "196/TALK"    , "narrator": "みやび", "text": "転ばぬ先の杖"},
        { "location": "197/TALK"    , "narrator": "みやび", "text": "確かに正しい"},
        { "location": "198/ACT"     , "narrator": "", "text": "あると燃える"},
        { "location": "208/TALK"    , "narrator": "みやび", "text": "そうきたか"},
        { "location": "209/TALK"    , "narrator": "みやび", "text": "$handle$には素質があるようだ"},
        { "location": "211/TALK"    , "narrator": "みやび", "text": "素晴らしく興味深いぞね"},
        { "location": "213/TALK"    , "narrator": "みやび", "text": "そんなわけで"},
        { "location": "214/TALK"    , "narrator": "みやび", "text": "障害はどうにかする方向にしたいのだが"},
        { "location": "215/TALK"    , "narrator": "みやび", "text": "いかんせん邪魔だから障害と言えるわけだ"},
        { "location": "217/SEL"     , "narrator": "", "text": "$handle$がどうにかする"},
        { "location": "218/SEL"     , "narrator": "", "text": "みやびさん頑張って"},
        { "location": "219/SEL"     , "narrator": "", "text": "あー、ねー？"},
        { "location": "220/ACT"     , "narrator": "", "text": "$handle$がどうにかする"},
        { "location": "230/TALK"    , "narrator": "みやび", "text": "ほう"},
        { "location": "231/TALK"    , "narrator": "みやび", "text": "期待しておくぞね"},
        { "location": "232/TALK"    , "narrator": "みやび", "text": "やってみてー"},
        { "location": "233/TALK"    , "narrator": "みやび", "text": "ほれほれ"},
        { "location": "236/ACT"     , "narrator": "", "text": "みやびさん頑張って"},
        { "location": "237/TALK"    , "narrator": "みやび", "text": "なるほどな"},
        { "location": "238/TALK"    , "narrator": "みやび", "text": "応援係なわけだ"},
        { "location": "239/TALK"    , "narrator": "みやび", "text": "ほうほう"},
        { "location": "240/ACT"     , "narrator": "", "text": "あー、ねー？"},
        { "location": "241/TALK"    , "narrator": "みやび", "text": "相槌だけで乗り切れるのは女子トークだけぞね"},
        { "location": "242/TALK"    , "narrator": "みやび", "text": "打開案を出してみれ"},
        { "location": "243/TALK"    , "narrator": "みやび", "text": "全くもう"},
        { "location": "245/TALK"    , "narrator": "みやび", "text": "まあそんなわけで"},
        { "location": "246/TALK"    , "narrator": "みやび", "text": "有事の際はチミにも出動要請をしたいわけだが"},
        { "location": "248/SEL"     , "narrator": "", "text": "はい喜んで"},
        { "location": "249/SEL"     , "narrator": "", "text": "その時にならないとわからないし"},
        { "location": "250/SEL"     , "narrator": "", "text": "めんどくさいからやだ"},
        { "location": "251/ACT"     , "narrator": "", "text": "はい喜んで"},
        { "location": "252/TALK"    , "narrator": "みやび", "text": "言質とったどー！"},
        { "location": "253/TALK"    , "narrator": "みやび", "text": "よっしゃお願いねｖ"},
        { "location": "255/TALK"    , "narrator": "みやび", "text": "みやび、期待してるからｖ"},
        { "location": "256/ACT"     , "narrator": "", "text": "その時にならないとわからないし"},
        { "location": "258/TALK"    , "narrator": "みやび", "text": "なんだこの優柔不断さ"},
        { "location": "260/TALK"    , "narrator": "みやび", "text": "まるで現代人そのもの"},
        { "location": "262/TALK"    , "narrator": "みやび", "text": "まあよい"},
        { "location": "263/TALK"    , "narrator": "みやび", "text": "その時はみやびさんの期待に応え給え"},
        { "location": "264/ACT"     , "narrator": "", "text": "めんどくさいからやだ"},
        { "location": "265/TALK"    , "narrator": "みやび", "text": "なんとストレートな拒絶"},
        { "location": "266/TALK"    , "narrator": "みやび", "text": "そう見せかけたはぐらかしか"},
        { "location": "267/TALK"    , "narrator": "みやび", "text": "なるほどね……"},
        { "location": "204/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"},
        { "location": "226/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"}
    ]
}
