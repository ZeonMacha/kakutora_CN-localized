        { "location": "7/SCENARIO", "narrator": "", "text": "007_シネマなんかじゃなくて"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "全員にハッピーエンドの物語をください"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "幸せに生きていけるための魔法をください"},
        { "location": "34/TALK"   , "narrator": "ガブリエラ", "text": "その願いは"},
        { "location": "35/TALK"   , "narrator": "ガブリエラ", "text": "どうすれば叶えられますか？"},
        { "location": "38/SEL"    , "narrator": "", "text": "悩み事があるの？"},
        { "location": "39/SEL"    , "narrator": "", "text": "自分で叶えるしかないね"},
        { "location": "40/SEL"    , "narrator": "", "text": "$handle$が姫の願いを叶えましょう"},
        { "location": "41/ACT"    , "narrator": "", "text": "悩み事があるの？"},
        { "location": "42/TALK"   , "narrator": "ガブリエラ", "text": "ちょっとね"},
        { "location": "43/TALK"   , "narrator": "ガブリエラ", "text": "聞いてくれるかしら？"},
        { "location": "44/ACT"    , "narrator": "", "text": "自分で叶えるしかないね"},
        { "location": "45/TALK"   , "narrator": "ガブリエラ", "text": "マルザンナったら"},
        { "location": "47/TALK"   , "narrator": "ガブリエラ", "text": "冷たいのね・・・"},
        { "location": "48/ACT"    , "narrator": "", "text": "$handle$が姫の願いを叶えましょう"},
        { "location": "51/TALK"   , "narrator": "ガブリエラ", "text": "あらマルザンナｖｖｖ"},
        { "location": "52/TALK"   , "narrator": "ガブリエラ", "text": "姫の願いをかなえてくれるのねvvvvvvv"},
        { "location": "53/TALK"   , "narrator": "ガブリエラ", "text": "本当にいい子ねｖｖｖ"},
        { "location": "61/TALK"   , "narrator": "ガブリエラ", "text": "まほは今は幸せだって言うの"},
        { "location": "62/TALK"   , "narrator": "ガブリエラ", "text": "クランたちのこと"},
        { "location": "63/TALK"   , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "66/TALK"   , "narrator": "ガブリエラ", "text": "本当にそうかしら？"},
        { "location": "69/SEL"    , "narrator": "", "text": "気にしすぎ"},
        { "location": "70/SEL"    , "narrator": "", "text": "大丈夫だよ"},
        { "location": "71/SEL"    , "narrator": "", "text": "ガブに思われることは幸せだと思うよ"},
        { "location": "72/ACT"    , "narrator": "", "text": "気にしすぎ"},
        { "location": "73/TALK"   , "narrator": "ガブリエラ", "text": "そう"},
        { "location": "74/TALK"   , "narrator": "ガブリエラ", "text": "だったらいいんだけど"},
        { "location": "75/ACT"    , "narrator": "", "text": "大丈夫だよ"},
        { "location": "76/TALK"   , "narrator": "ガブリエラ", "text": "そう"},
        { "location": "77/TALK"   , "narrator": "ガブリエラ", "text": "なのかしらね？"},
        { "location": "78/ACT"    , "narrator": "", "text": "ガブに思われることは幸せだと思うよ"},
        { "location": "80/TALK"   , "narrator": "ガブリエラ", "text": "ありがとう"},
        { "location": "82/TALK"   , "narrator": "ガブリエラ", "text": "マルザンナはいいこねｖｖ"},
        { "location": "83/TALK"   , "narrator": "ガブリエラ", "text": "かわいいこねｖ"},
        { "location": "85/TALK"   , "narrator": "ガブリエラ", "text": "あのね"},
        { "location": "87/TALK"   , "narrator": "ガブリエラ", "text": "もし"},
        { "location": "88/TALK"   , "narrator": "ガブリエラ", "text": "もしも"},
        { "location": "89/TALK"   , "narrator": "ガブリエラ", "text": "クランたちが幸せじゃなかったとして"},
        { "location": "90/TALK"   , "narrator": "ガブリエラ", "text": "クランたちのこと"},
        { "location": "91/TALK"   , "narrator": "ガブリエラ", "text": "幸せにする方法があると思うかしら？"},
        { "location": "93/SEL"    , "narrator": "", "text": "ある"},
