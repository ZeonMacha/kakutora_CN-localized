        { "location": "7/SCENARIO", "narrator": "", "text": "05-03_年長組（組員は約1名）"},
        { "location": "32/TALK"   , "narrator": "アーヤ", "text": "結構ね"},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "辛いところでもあるのよ"},
        { "location": "34/TALK"   , "narrator": "アーヤ", "text": "他の子たちが高校生と中学生って"},
        { "location": "37/SEL"    , "narrator": "", "text": "かわいいからいいでしょ"},
        { "location": "38/SEL"    , "narrator": "", "text": "そうだよね"},
        { "location": "39/SEL"    , "narrator": "", "text": "鬼教官として指導すれば"},
        { "location": "40/ACT"    , "narrator": "", "text": "かわいいからいいでしょ"},
        { "location": "41/TALK"   , "narrator": "アーヤ", "text": "まあかわいいんだけど＼(^O^)／"},
        { "location": "42/TALK"   , "narrator": "アーヤ", "text": "それだけじゃすまないのよ（｀皿´ )"},
        { "location": "43/ACT"    , "narrator": "", "text": "そうだよね"},
        { "location": "44/TALK"   , "narrator": "アーヤ", "text": "まあね(;^_^A"},
        { "location": "45/TALK"   , "narrator": "アーヤ", "text": "どうしてもね"},
        { "location": "46/ACT"    , "narrator": "", "text": "鬼教官として指導すれば"},
        { "location": "48/TALK"   , "narrator": "アーヤ", "text": "鬼教官"},
        { "location": "50/TALK"   , "narrator": "アーヤ", "text": "いいわね"},
        { "location": "51/TALK"   , "narrator": "アーヤ", "text": "なんて"},
        { "location": "52/TALK"   , "narrator": "アーヤ", "text": "そういうおいま"},
        { "location": "53/TALK"   , "narrator": "アーヤ", "text": "そういうの今"},
        { "location": "54/TALK"   , "narrator": "アーヤ", "text": "はやってないわ"},
        { "location": "56/TALK"   , "narrator": "アーヤ", "text": "ギャヴィは都市の割にはしっかりしてると思うけど"},
        { "location": "58/SEL"    , "narrator": "", "text": "都市ってワルシャワ？"},
        { "location": "59/SEL"    , "narrator": "", "text": "年、あるいは歳だよね"},
        { "location": "60/ACT"    , "narrator": "", "text": "都市ってワルシャワ？"},
        { "location": "61/TALK"   , "narrator": "アーヤ", "text": "何で急に"},
        { "location": "63/TALK"   , "narrator": "アーヤ", "text": "あ"},
        { "location": "64/TALK"   , "narrator": "アーヤ", "text": "ギャヴィの年ね"},
        { "location": "65/ACT"    , "narrator": "", "text": "年、あるいは歳だよね"},
        { "location": "66/TALK"   , "narrator": "アーヤ", "text": "え"},
        { "location": "67/TALK"   , "narrator": "アーヤ", "text": "何の話"},
        { "location": "68/TALK"   , "narrator": "アーヤ", "text": "あ"},
        { "location": "69/TALK"   , "narrator": "アーヤ", "text": "ギャヴィの年のこと"},
        { "location": "71/TALK"   , "narrator": "アーヤ", "text": "やっぱりまだ幼いところはあるし"},
        { "location": "72/TALK"   , "narrator": "アーヤ", "text": "みやびは何考えてるかわからないところがあるし"},
        { "location": "73/TALK"   , "narrator": "アーヤ", "text": "って"},
        { "location": "74/TALK"   , "narrator": "アーヤ", "text": "これは都市は関係なさそうな気もするわ"},
        { "location": "75/TALK"   , "narrator": "アーヤ", "text": "年！"},
        { "location": "76/TALK"   , "narrator": "アーヤ", "text": "で"},
        { "location": "77/TALK"   , "narrator": "アーヤ", "text": "つばめはいい子なんだけど"},
        { "location": "78/TALK"   , "narrator": "アーヤ", "text": "いいこだからこそちょっと心配"},
        { "location": "81/SEL"    , "narrator": "", "text": "どうにかなるって"},
        { "location": "82/SEL"    , "narrator": "", "text": "気を付けてあげないとね"},
        { "location": "83/SEL"    , "narrator": "", "text": "$me$がついてるから"},
        { "location": "84/ACT"    , "narrator": "", "text": "どうにかなるって"},
        { "location": "85/TALK"   , "narrator": "アーヤ", "text": "楽天的ね"},
        { "location": "86/TALK"   , "narrator": "アーヤ", "text": "まあ"},
        { "location": "87/TALK"   , "narrator": "アーヤ", "text": "その精神で"},
        { "location": "88/TALK"   , "narrator": "アーヤ", "text": "どうにかするわ"},
        { "location": "89/ACT"    , "narrator": "", "text": "気を付けてあげないとね"},
        { "location": "90/TALK"   , "narrator": "アーヤ", "text": "そうよね"},
        { "location": "91/TALK"   , "narrator": "アーヤ", "text": "気を付けてあげないとね"},
        { "location": "92/ACT"    , "narrator": "", "text": "$me$がついてるから"},
        { "location": "94/TALK"   , "narrator": "アーヤ", "text": "あら"},
        { "location": "95/TALK"   , "narrator": "アーヤ", "text": "大きく出たわね"},
        { "location": "96/TALK"   , "narrator": "アーヤ", "text": "でも"},
        { "location": "97/TALK"   , "narrator": "アーヤ", "text": "少しうれしいかも"},
        { "location": "99/TALK"   , "narrator": "アーヤ", "text": "頼んだわよ"}
    ]
}
