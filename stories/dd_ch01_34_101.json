{
    "dir": "chap34/daydra/dd_ch01_34_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "34102",
        "cid": "tsubame",
        "title": "002 メインストーリー",
        "sub_title": "ウタノチカラ＜前編＞"
    },
    "entry":
    [
        { "location": "8/SCENARIO", "narrator": "", "text": "タイトル"},
        { "location": "26/TALK"   , "narrator": "つばめ", "text": "……。"},
        { "location": "27/TALK"   , "narrator": "つばめ", "text": "あれ……？\nわたし……"},
        { "location": "28/SEL"    , "narrator": "", "text": "大丈夫？"},
        { "location": "29/ACT"    , "narrator": "", "text": "大丈夫？"},
        { "location": "31/TALK"   , "narrator": "つばめ", "text": "わたし……"},
        { "location": "47/TALK"   , "narrator": "つばめ", "text": "そっか…"},
        { "location": "49/TALK"   , "narrator": "つばめ", "text": "わたし、\n壊されちゃったんだ。"},
        { "location": "50/SEL"    , "narrator": "", "text": "きっと大丈夫だよ"},
        { "location": "51/SEL"    , "narrator": "", "text": "そうかも"},
        { "location": "52/ACT"    , "narrator": "", "text": "きっと大丈夫だよ"},
        { "location": "56/TALK"   , "narrator": "つばめ", "text": "そんなことないよ。"},
        { "location": "57/ACT"    , "narrator": "", "text": "そうかも"},
        { "location": "61/TALK"   , "narrator": "つばめ", "text": "そうかも"},
        { "location": "63/TALK"   , "narrator": "つばめ", "text": "神楽ちゃん、\n幸せになれるかな…。"},
        { "location": "64/TALK"   , "narrator": "音羽", "text": "逢瀬さん。\n逢瀬つばめさん。"},
        { "location": "68/TALK"   , "narrator": "つばめ", "text": "……誰？"},
        { "location": "69/TALK"   , "narrator": "音羽", "text": "音羽よ。\n如月音羽。"},
        { "location": "70/TALK"   , "narrator": "つばめ", "text": "おとわ……"},
        { "location": "74/TALK"   , "narrator": "つばめ", "text": "えっ？\n音羽さん？"},
        { "location": "84/TALK"   , "narrator": "つばめ", "text": "音羽さん、\nそこにいるの？"},
        { "location": "85/TALK"   , "narrator": "音羽", "text": "ええ。\nでもこっちに来るのは\n待って。"},
        { "location": "86/TALK"   , "narrator": "音羽", "text": "逢瀬さんは、\nこの扉をくぐることは\nできないから。"},
        { "location": "87/TALK"   , "narrator": "つばめ", "text": "それじゃ、\nここからでも……"},
        { "location": "89/TALK"   , "narrator": "つばめ", "text": "音羽さん、\nごめんなさい！"},
        { "location": "90/TALK"   , "narrator": "つばめ", "text": "わたし、音羽さんを\n壊しちゃったみたいで…"},
        { "location": "91/TALK"   , "narrator": "つばめ", "text": "全然覚えてないんだけど\nでも、壊したのは\nわたしだから、だから――"},
        { "location": "92/TALK"   , "narrator": "音羽", "text": "言わないで。\n大丈夫、\n全部解ってるから。"},
        { "location": "94/TALK"   , "narrator": "つばめ", "text": "え？"},
        { "location": "95/TALK"   , "narrator": "音羽", "text": "壊したのは、\n逢瀬さんじゃなくて、\n千羽鶴。"},
        { "location": "96/TALK"   , "narrator": "音羽", "text": "あのライブの数日前、\n私は神楽から本当の話を\n色々聞いてしまった。"},
        { "location": "97/TALK"   , "narrator": "音羽", "text": "そして、来るなと\n言われていたライブにも\nこっそり顔を出した。"},
        { "location": "98/TALK"   , "narrator": "音羽", "text": "私は神楽の過酷な運命を\n悲しんで、きっとココロが\n臨界してしまっていた。"},
        { "location": "99/TALK"   , "narrator": "音羽", "text": "だから、それを\n千羽鶴に見つけられて\n発症させられ――"},
        { "location": "100/TALK"  , "narrator": "音羽", "text": "その後、千羽鶴によって\n壊された。"},
        { "location": "101/SEL"   , "narrator": "", "text": "そうだったんだね"},
        { "location": "102/SEL"   , "narrator": "", "text": "どうしてそんな酷いことを！"},
        { "location": "103/ACT"   , "narrator": "", "text": "そうだったんだね"},
        { "location": "105/ACT"   , "narrator": "", "text": "どうしてそんな酷いことを！"},
        { "location": "111/TALK"  , "narrator": "音羽", "text": "貴方は\n$handle$ね。"},
        { "location": "112/TALK"  , "narrator": "音羽", "text": "いつも逢瀬さんや\n神楽を助けてくれてる人。"},
        { "location": "113/SEL"   , "narrator": "", "text": "何で知ってるの？"},
        { "location": "114/SEL"   , "narrator": "", "text": "神楽はまだ助けられてないけどね"},
        { "location": "115/ACT"   , "narrator": "", "text": "何で知ってるの？"},
        { "location": "116/TALK"  , "narrator": "音羽", "text": "クランになると、\n色々見えてくることが\nあるの。"},
        { "location": "117/TALK"  , "narrator": "音羽", "text": "死ぬと魂になって、世界を\n俯瞰するって言うけど…、\nまさにそんな感じ？"},
        { "location": "118/TALK"  , "narrator": "音羽", "text": "もちろんまだ\n死んだわけじゃないけど。"},
        { "location": "119/ACT"   , "narrator": "", "text": "神楽はまだ助けられてないけどね"},
        { "location": "120/TALK"  , "narrator": "音羽", "text": "ううん。"},
        { "location": "121/TALK"  , "narrator": "音羽", "text": "貴方が関わっていることで\n神楽も色々と\n救われてるよ。"},
        { "location": "127/TALK"  , "narrator": "つばめ", "text": "でもどうして長官さんは、\n音羽さんにそんな\n酷いことを……"},
        { "location": "129/TALK"  , "narrator": "音羽", "text": "彼女にとっては、\nそうする他に方法が\n無かったのかもしれない。"},
        { "location": "130/TALK"  , "narrator": "音羽", "text": "確かに、幾つかのことが\n重なっていた。"},
        { "location": "131/TALK"  , "narrator": "音羽", "text": "１つに、私が神楽から\n外の世界の話を\n聞いてしまったこと。"},
        { "location": "132/TALK"  , "narrator": "音羽", "text": "２つめとして、私が\n神楽のココロを揺さぶれる\n唯一の存在だったこと。"},
        { "location": "133/TALK"  , "narrator": "音羽", "text": "そして３つめ。\nこれは私である必要は\n無いことだけど――"},
        { "location": "134/TALK"  , "narrator": "音羽", "text": "あのライブで逢瀬さんを\n壊されることは、千羽鶴に\nとっては死を意味した。"},
        { "location": "135/TALK"  , "narrator": "音羽", "text": "だから、是が非でも\n神楽の歌を阻止しなければ\nならなかったの。"},
        { "location": "136/SEL"   , "narrator": "", "text": "だからってフェノメノンを発症させなくても"},
        { "location": "137/ACT"   , "narrator": "", "text": "だからってフェノメノンを発症させなくても"},
        { "location": "139/TALK"  , "narrator": "音羽", "text": "フェノメノンを\n相殺するには\nフェノメノンしかない。"},
        { "location": "140/SEL"   , "narrator": "", "text": "えっと、どういうこと？"},
        { "location": "141/ACT"   , "narrator": "", "text": "えっと、どういうこと？"},
        { "location": "143/TALK"  , "narrator": "音羽", "text": "まず、神楽が\nフェノメノンを展開した。"},
        { "location": "144/TALK"  , "narrator": "つばめ", "text": "それじゃ、あの\nホールに入った瞬間に\n頭が痛かったのって……"},
        { "location": "145/TALK"  , "narrator": "音羽", "text": "既に神楽の\nフェノメノンの中に\nいたからね。"},
        { "location": "146/TALK"  , "narrator": "音羽", "text": "直後、私のフェノメノンが\n展開して、神楽の\nフェノメノンは消滅した。"},
        { "location": "147/TALK"  , "narrator": "音羽", "text": "それによって\n逢瀬さんは、その場では\n壊されずに済んだの。"},
        { "location": "148/TALK"  , "narrator": "つばめ", "text": "あっ……\nだから頭痛が止んで――"},
        { "location": "149/TALK"  , "narrator": "つばめ", "text": "そういうこと\nだったんだ…。"},
        { "location": "150/TALK"  , "narrator": "音羽", "text": "そういうこと。"},
        { "location": "151/TALK"  , "narrator": "音羽", "text": "そしてここからが\n本題になるけど――"},
        { "location": "152/TALK"  , "narrator": "音羽", "text": "私は逢瀬さんと違って\n聖女でも何でもない\nタダの人間。"},
        { "location": "153/TALK"  , "narrator": "音羽", "text": "千羽鶴のことは\n本気でむかついてるし、\n正直恨んでる。"},
        { "location": "154/TALK"  , "narrator": "音羽", "text": "だから彼女が逢瀬さんを\n本気で消しに掛かってる\nならば、私は……"},
        { "location": "155/TALK"  , "narrator": "音羽", "text": "私は千羽鶴を消し飛ばして\n逢瀬さんを助けたいと\n思ってる。"},
        { "location": "156/TALK"  , "narrator": "音羽", "text": "その想いがあって、\n色んな人に協力してもらい\n私は今ここに来てるの。"},
        { "location": "157/SEL"   , "narrator": "", "text": "音羽さん良く言った！"},
        { "location": "158/SEL"   , "narrator": "", "text": "千羽鶴消したらフェノメノン消えるんじゃ…"},
        { "location": "159/ACT"   , "narrator": "", "text": "音羽さん良く言った！"},
        { "location": "160/TALK"  , "narrator": "音羽", "text": "私はただ、\n私に理不尽な事をした、\nそして――"},
        { "location": "161/TALK"  , "narrator": "音羽", "text": "大切なお友達に\n酷いことをしてる\n千羽鶴が許せないだけ。"},
        { "location": "162/TALK"  , "narrator": "音羽", "text": "理想とか思想とか無いし、\nバカだから身近な人の\n事しか考えられないけど。"},
        { "location": "163/ACT"   , "narrator": "", "text": "千羽鶴消したらフェノメノン消えるんじゃ…"},
        { "location": "164/TALK"  , "narrator": "音羽", "text": "それは多分大丈夫。\n消えないと思うよ。"},
        { "location": "165/SEL"   , "narrator": "", "text": "なんで！？"},
        { "location": "166/ACT"   , "narrator": "", "text": "なんで！？"},
        { "location": "168/TALK"  , "narrator": "音羽", "text": "今の日本を包んでる\nフェノメノンは、千羽鶴と\n逢瀬さんが拮抗してる。"},
        { "location": "169/TALK"  , "narrator": "音羽", "text": "普通はそういうことは\n起こらないんだけどね。\nだから大丈夫だと思う。"},
        { "location": "175/TALK"  , "narrator": "つばめ", "text": "えっ！？"},
        { "location": "176/TALK"  , "narrator": "音羽", "text": "……なに？"},
        { "location": "216/TALK"  , "narrator": "つばめ", "text": "っ！？\nわ、わたしがいる！？"},
        { "location": "217/SEL"   , "narrator": "", "text": "百鶴！？"},
        { "location": "218/ACT"   , "narrator": "", "text": "百鶴！？"},
        { "location": "221/TALK"  , "narrator": "百鶴　", "text": "そうです。\nわたしが百鶴です。"},
        { "location": "222/TALK"  , "narrator": "音羽", "text": "いけない、ちょっと\n時間かけすぎたかも…。"},
        { "location": "224/TALK"  , "narrator": "百鶴　", "text": "そうかもしれませんね。"},
        { "location": "225/TALK"  , "narrator": "百鶴　", "text": "今日は回線工事に\nやって参りました。"},
        { "location": "226/TALK"  , "narrator": "つばめ", "text": "え？\n回線工事？\nなんだろう、それ。"},
        { "location": "229/TALK"  , "narrator": "百鶴　", "text": "残念ですが音羽さん。\n貴方の回線を\n切断しに参りました。"},
        { "location": "230/TALK"  , "narrator": "音羽", "text": "…っ……。"},
        { "location": "231/TALK"  , "narrator": "百鶴　", "text": "気持ちや事情や合意の\n有無は置いておいても、\n貴方の接続は違反です。"},
        { "location": "232/TALK"  , "narrator": "百鶴　", "text": "いわばクラッキングです。\n違反行為は取り締まらねば\nなりません。"},
        { "location": "233/SEL"   , "narrator": "", "text": "まあ待てよ百鶴"},
        { "location": "234/SEL"   , "narrator": "", "text": "$me$は百鶴の味方だよ。がんばって！"},
        { "location": "235/ACT"   , "narrator": "", "text": "まあ待てよ百鶴"},
        { "location": "242/TALK"  , "narrator": "百鶴　", "text": "なんですかぁ！？\nわたしに楯突くんですか？\nええ！？"},
        { "location": "244/TALK"  , "narrator": "つばめ", "text": "な、なんかこの\nわたしさん、\nちょっと怖いんですけど。"},
        { "location": "245/TALK"  , "narrator": "百鶴　", "text": "いいでしょう。\nならば戦闘です！"},
        { "location": "246/SEL"   , "narrator": "", "text": "望むところ"},
        { "location": "247/SEL"   , "narrator": "", "text": "百鶴とは戦いたくない"},
        { "location": "248/ACT"   , "narrator": "", "text": "望むところ"},
        { "location": "249/TALK"  , "narrator": "百鶴　", "text": "……。"},
        { "location": "250/TALK"  , "narrator": "百鶴　", "text": "そうですか。"},
        { "location": "251/TALK"  , "narrator": "百鶴　", "text": "言われると割と\nショックなものですね。"},
        { "location": "252/ACT"   , "narrator": "", "text": "百鶴とは戦いたくない"},
        { "location": "253/TALK"  , "narrator": "百鶴　", "text": "そんなことは\n百も同感ですよ。"},
        { "location": "254/TALK"  , "narrator": "百鶴　", "text": "けれども、\n任務は任務なんです。"},
        { "location": "255/TALK"  , "narrator": "百鶴　", "text": "そればっかりは\nどうしようもありません。"},
        { "location": "258/TALK"  , "narrator": "つばめ", "text": "あ、あの！\nわたしさんは一体\n誰さんなんですか！？"},
        { "location": "261/TALK"  , "narrator": "百鶴　", "text": "…ああ、なんだか\nややこしい事に\nなってきましたね……。"},
        { "location": "262/TALK"  , "narrator": "つばめ", "text": "わたし、まだ音羽さんと\nお話してるんです！"},
        { "location": "263/TALK"  , "narrator": "つばめ", "text": "もう少し待って\nもらえませんか！？"},
        { "location": "264/ACT"   , "narrator": "", "text": "$me$は百鶴の味方だよ。がんばって！"},
        { "location": "269/TALK"  , "narrator": "百鶴　", "text": "えっ？"},
        { "location": "271/TALK"  , "narrator": "百鶴　", "text": "そ、そうなんですか？\nとっても嬉しいです。"},
        { "location": "272/TALK"  , "narrator": "百鶴　", "text": "それでは早速、\n味方の証として\nキッスを――"},
        { "location": "276/TALK"  , "narrator": "つばめ", "text": "ちょ、ちょっと\n待ってください！！"},
        { "location": "277/TALK"  , "narrator": "つばめ", "text": "わたしさん、\nわたしの前で\n何やってるんですか！"},
        { "location": "281/TALK"  , "narrator": "百鶴　", "text": "嫉妬ですか？"},
        { "location": "283/TALK"  , "narrator": "つばめ", "text": "ええっ！？"},
        { "location": "284/TALK"  , "narrator": "つばめ", "text": "えっと、でも自分だから\nそういうのじゃない気が\nするんだけど……"},
        { "location": "285/TALK"  , "narrator": "つばめ", "text": "でもやっぱり\n嫉妬なのかなぁ……。\nでも自分だし……"},
        { "location": "286/SEL"   , "narrator": "", "text": "つばめ混乱してる！？"},
        { "location": "287/SEL"   , "narrator": "", "text": "嫉妬するつばめかわいい！"},
        { "location": "288/ACT"   , "narrator": "", "text": "つばめ混乱してる！？"},
        { "location": "290/TALK"  , "narrator": "つばめ", "text": "うう……\nよくわからなく\nなってきちゃったよ。"},
        { "location": "291/ACT"   , "narrator": "", "text": "嫉妬するつばめかわいい！"},
        { "location": "294/TALK"  , "narrator": "つばめ", "text": "ええっ……\nそ、そうなの！？"},
        { "location": "296/TALK"  , "narrator": "百鶴　", "text": "……。"},
        { "location": "300/TALK"  , "narrator": "百鶴　", "text": "……分離してから\n初めてお逢いしましたが。"},
        { "location": "301/TALK"  , "narrator": "百鶴　", "text": "総意は本当に\nカレンの映し鏡みたいな\n方ですね。"},
        { "location": "307/TALK"  , "narrator": "つばめ", "text": "そうい？？"},
        { "location": "308/TALK"  , "narrator": "百鶴　", "text": "そうなってきますと、\nやはりこの後の展開は\n共有しない方がいいです。"},
        { "location": "309/TALK"  , "narrator": "つばめ", "text": "この後の展開？？\n共有？？\n全然わからないよ…。"},
        { "location": "310/TALK"  , "narrator": "百鶴　", "text": "わからない方がいい。\n貴方はずっとその\nピュアな心でいて下さい。"},
        { "location": "311/TALK"  , "narrator": "百鶴　", "text": "それでは、さようなら。"},
        { "location": "319/TALK"  , "narrator": "つばめ", "text": "えっ！？\nえっ！？！？"},
        { "location": "320/SEL"   , "narrator": "", "text": "ちょっと待て！"},
        { "location": "321/ACT"   , "narrator": "", "text": "ちょっと待て！"},
        { "location": "332/TALK"  , "narrator": "百鶴　", "text": "これでよし。"},
        { "location": "333/SEL"   , "narrator": "", "text": "何したんだ！"},
        { "location": "334/ACT"   , "narrator": "", "text": "何したんだ！"},
        { "location": "338/TALK"  , "narrator": "百鶴　", "text": "怖いですね。\nちょっと席を外して\nいただいただけです。"},
        { "location": "339/TALK"  , "narrator": "百鶴　", "text": "危害は加えていませんよ。"},
        { "location": "340/TALK"  , "narrator": "百鶴　", "text": "ピュアなわたしには\nずっとピュアなままで\nいて戴きたいですから――"},
        { "location": "341/TALK"  , "narrator": "百鶴　", "text": "血なまぐさい\nバトルなど\n見せられません。"},
        { "location": "342/SEL"   , "narrator": "", "text": "本気なんだね"},
        { "location": "343/SEL"   , "narrator": "", "text": "百鶴優しいね"},
        { "location": "344/ACT"   , "narrator": "", "text": "本気なんだね"},
        { "location": "345/TALK"  , "narrator": "百鶴　", "text": "……当然です。"},
        { "location": "346/ACT"   , "narrator": "", "text": "百鶴優しいね"},
        { "location": "347/TALK"  , "narrator": "百鶴　", "text": "……。"},
        { "location": "351/TALK"  , "narrator": "百鶴　", "text": "<size=40>どーん！！</size>"},
        { "location": "353/TALK"  , "narrator": "百鶴　", "text": "んなわけねーだろ！"},
        { "location": "354/TALK"  , "narrator": "百鶴　", "text": "…ってことにしておいて\nください。大人だから\nわかりますよね？"},
        { "location": "356/TALK"  , "narrator": "百鶴　", "text": "さて。"},
        { "location": "361/TALK"  , "narrator": "百鶴　", "text": "音羽さん。\n私は無血回線切断を\n強く希望します。"},
        { "location": "362/TALK"  , "narrator": "百鶴　", "text": "ご意見ご要望があれば。"},
        { "location": "363/TALK"  , "narrator": "音羽", "text": "貴方は逢瀬さんの姿を\nしてるけど、本当に\n逢瀬さんの人格なの？"},
        { "location": "364/TALK"  , "narrator": "百鶴　", "text": "厳密には、\nかつてはそうでした、\nです。"},
        { "location": "365/TALK"  , "narrator": "音羽", "text": "なるほど。ということは、\n千羽鶴の人格ってこと？"},
        { "location": "366/TALK"  , "narrator": "百鶴　", "text": "嘘言っても\n仕方ありませんから、\n“はい”と答えましょう。"},
        { "location": "367/TALK"  , "narrator": "音羽", "text": "ならば、\n絶対に切断させない。"},
        { "location": "368/TALK"  , "narrator": "百鶴　", "text": "そうですか。\n時に正直者は嘘つきより\n残酷ですよね。"},
        { "location": "373/TALK"  , "narrator": "百鶴　", "text": "$handle$さんも\nそう思いませんか？"},
        { "location": "374/SEL"   , "narrator": "", "text": "確かに、つばめの人格って言っておけば良かったのに"},
        { "location": "375/SEL"   , "narrator": "", "text": "その嘘をつけないところが好き"},
        { "location": "376/ACT"   , "narrator": "", "text": "確かに、つばめの人格って言っておけば良かったのに"},
        { "location": "377/TALK"  , "narrator": "百鶴　", "text": "その通りなんですけどね、\nそれが出来ないから\nわたしなんです。"},
        { "location": "378/TALK"  , "narrator": "百鶴　", "text": "これぞ、ザ・個性！\nアイゼンチーチーですよ。"},
        { "location": "379/SEL"   , "narrator": "", "text": "…アイデンティティ？"},
        { "location": "380/ACT"   , "narrator": "", "text": "…アイデンティティ？"},
        { "location": "382/TALK"  , "narrator": "百鶴　", "text": "あ、そうです。\nそれです。"},
        { "location": "383/ACT"   , "narrator": "", "text": "その嘘をつけないところが好き"},
        { "location": "384/TALK"  , "narrator": "百鶴　", "text": "……嬉しいです。"},
        { "location": "385/TALK"  , "narrator": "百鶴　", "text": "$handle$さん。"},
        { "location": "386/SEL"   , "narrator": "", "text": "どうしたの！？"},
        { "location": "387/ACT"   , "narrator": "", "text": "どうしたの！？"},
        { "location": "389/TALK"  , "narrator": "百鶴　", "text": "……いえ。\n何でもありません。"},
        { "location": "391/TALK"  , "narrator": "百鶴　", "text": "いずれにせよ、やはり\n戦うしかありませんねえ。"},
        { "location": "392/SEL"   , "narrator": "", "text": "$me$が相手になるから、音羽に手を出すな"},
        { "location": "393/SEL"   , "narrator": "", "text": "話し合いとかで穏便にやろうよ"},
        { "location": "394/ACT"   , "narrator": "", "text": "$me$が相手になるから、音羽に手を出すな"},
        { "location": "395/TALK"  , "narrator": "百鶴　", "text": "なるほど。それでこそ\n$handle$さん。"},
        { "location": "396/TALK"  , "narrator": "百鶴　", "text": "アッサリ過ぎる程わたしの\n筋書き通りにしてくれて\nありがとうございます。"},
        { "location": "397/ACT"   , "narrator": "", "text": "話し合いとかで穏便にやろうよ"},
        { "location": "398/TALK"  , "narrator": "百鶴　", "text": "残念ですが、\nそれは難しいですね。"},
        { "location": "399/TALK"  , "narrator": "百鶴　", "text": "時間がない上に、\nその提案には\n上司決裁が必要ですので。"},
        { "location": "400/SEL"   , "narrator": "", "text": "千羽鶴か！？"},
        { "location": "401/ACT"   , "narrator": "", "text": "千羽鶴か！？"},
        { "location": "403/TALK"  , "narrator": "百鶴　", "text": "まあ、中間管理職の\n悲しい性ですよね。"},
        { "location": "404/TALK"  , "narrator": "百鶴　", "text": "音羽さんが繋がると、\n我が主へのダイレクト\nアタックが可能になり――"},
        { "location": "405/TALK"  , "narrator": "百鶴　", "text": "更に神楽とコネクトしよう\nものなら、破壊の歌まで\n止められてしまいます。"},
        { "location": "406/TALK"  , "narrator": "百鶴　", "text": "そうならないよう、\nわたしは今回の事態を\n収束しにきました。"},
        { "location": "407/TALK"  , "narrator": "百鶴　", "text": "自発的に！\n率先して！\n収束しに来たんです。"},
        { "location": "408/TALK"  , "narrator": "百鶴　", "text": "ですから闘いは\n決して避けられません。"},
        { "location": "409/TALK"  , "narrator": "百鶴　", "text": "わたしが裏切り者だったり\n無能だったりすると、\n更に上が出てきますから。"},
        { "location": "410/SEL"   , "narrator": "", "text": "なるほど"},
        { "location": "411/SEL"   , "narrator": "", "text": "何だか喋り方に違和感があるんだけど"},
        { "location": "412/ACT"   , "narrator": "", "text": "なるほど"},
        { "location": "413/ACT"   , "narrator": "", "text": "何だか喋り方に違和感があるんだけど"},
        { "location": "414/TALK"  , "narrator": "百鶴　", "text": "気のせいですよ。"},
        { "location": "416/TALK"  , "narrator": "百鶴　", "text": "では、ちゃっちゃと\nやっちゃいましょうかね。"},
        { "location": "418/TALK"  , "narrator": "音羽", "text": "待って！\n$handle$さん、\nここは私が戦うから。"},
        { "location": "419/TALK"  , "narrator": "音羽", "text": "これは私の戦い。\n貴方には迷惑を\nかけられない。"},
        { "location": "420/SEL"   , "narrator": "", "text": "心配しなくても大丈夫"},
        { "location": "421/SEL"   , "narrator": "", "text": "女の子には戦わせられない"},
        { "location": "422/ACT"   , "narrator": "", "text": "心配しなくても大丈夫"},
        { "location": "423/ACT"   , "narrator": "", "text": "女の子には戦わせられない"},
        { "location": "425/TALK"  , "narrator": "音羽", "text": "でも！！"},
        { "location": "428/TALK"  , "narrator": "百鶴　", "text": "ああ、もう\n面倒くさいですね。"},
        { "location": "429/SEL"   , "narrator": "", "text": "待って待って！"},
        { "location": "430/ACT"   , "narrator": "", "text": "待って待って！"},
        { "location": "433/TALK"  , "narrator": "百鶴　", "text": "なんです？"},
        { "location": "434/SEL"   , "narrator": "", "text": "音羽は音羽にしか出来ない事を全力でやって欲しいから、ここは任せて"},
        { "location": "435/SEL"   , "narrator": "", "text": "百鶴、バトル前にデートしない？"},
        { "location": "436/ACT"   , "narrator": "", "text": "音羽は音羽にしか出来ない事を全力でやって欲しいから、ここは任せて"},
        { "location": "437/TALK"  , "narrator": "音羽", "text": "……。"},
        { "location": "438/TALK"  , "narrator": "音羽", "text": "わかったわ。\nありがとう。"},
        { "location": "439/TALK"  , "narrator": "音羽", "text": "貴方の協力に応える為にも\n必ず逢瀬さんと神楽を\n助けるから！"},
        { "location": "440/SEL"   , "narrator": "", "text": "頼んだよ！"},
        { "location": "441/ACT"   , "narrator": "", "text": "頼んだよ！"},
        { "location": "443/TALK"  , "narrator": "百鶴　", "text": "覚悟を決めたと\nいうことで\nよろしいですね。"},
        { "location": "444/TALK"  , "narrator": "百鶴　", "text": "それでは、\n早速やりましょうか。"},
        { "location": "445/TALK"  , "narrator": "百鶴　", "text": "思い出話に華を咲かせても\n何もいい事はありません。"},
        { "location": "449/ACT"   , "narrator": "", "text": "百鶴、バトル前にデートしない？"},
        { "location": "450/TALK"  , "narrator": "百鶴　", "text": "えっ……。\nマジ？"},
        { "location": "451/TALK"  , "narrator": "百鶴　", "text": "百鶴、うれしい♪"},
        { "location": "452/TALK"  , "narrator": "百鶴　", "text": "さあ、すぐにでも\n参りましょう！"},
        { "location": "467/TALK"  , "narrator": "百鶴　", "text": "……。\n到着です。"},
        { "location": "468/TALK"  , "narrator": "百鶴　", "text": "なかなかうまい\n口実でしたね。"},
        { "location": "469/TALK"  , "narrator": "百鶴　", "text": "わたしも、気兼ねせず\n思う存分戦える方が\n助かります。"},
        { "location": "470/SEL"   , "narrator": "", "text": "同感"},
        { "location": "471/SEL"   , "narrator": "", "text": "そんなつもりじゃなかったんだけど"},
        { "location": "472/ACT"   , "narrator": "", "text": "同感"},
        { "location": "473/TALK"  , "narrator": "百鶴　", "text": "……それでは、\n早速やりましょうか。"},
        { "location": "474/TALK"  , "narrator": "百鶴　", "text": "思い出話に華を咲かせても\n何もいい事はありません。"},
        { "location": "475/ACT"   , "narrator": "", "text": "そんなつもりじゃなかったんだけど"},
        { "location": "476/TALK"  , "narrator": "百鶴　", "text": "そんなつもりじゃないで\n済んだら警察要らないん\nですよ■■野郎が！"},
        { "location": "477/TALK"  , "narrator": "百鶴　", "text": "時間がないんですよ。\nさっさと次に進みますよ。"},
        { "location": "482/TALK"  , "narrator": "百鶴　", "text": "ふぅ……"},
        { "location": "486/TALK"  , "narrator": "百鶴　", "text": "……。"},
        { "location": "487/SEL"   , "narrator": "", "text": "ちょっ、百鶴！？"},
        { "location": "488/ACT"   , "narrator": "", "text": "ちょっ、百鶴！？"},
        { "location": "491/TALK"  , "narrator": "百鶴　", "text": "ビビってるんですか？"},
        { "location": "492/TALK"  , "narrator": "百鶴　", "text": "前にも何度も言ってますが\nもう一度言います。"},
        { "location": "493/TALK"  , "narrator": "百鶴　", "text": "わたし、脱いだら\n凄いんですよ。"},
        { "location": "494/TALK"  , "narrator": "百鶴　", "text": "できれば貴方には、\nこの姿は見て欲しく\nありませんでした。"},
        { "location": "496/TALK"  , "narrator": "百鶴　", "text": "ですが、\nこうなってしまった以上\n致し方ないでしょう。"},
        { "location": "509/SEL"   , "narrator": "", "text": "えっ…………"},
        { "location": "510/ACT"   , "narrator": "", "text": "えっ…………"},
        { "location": "512/TALK"  , "narrator": "昇華百鶴", "text": "さて……"},
        { "location": "513/TALK"  , "narrator": "昇華百鶴", "text": "覚悟は"},
        { "location": "514/TALK"  , "narrator": "昇華百鶴", "text": "いいですね？"},
        { "location": "515/SEL"   , "narrator": "", "text": "…望むところだ"},
        { "location": "516/SEL"   , "narrator": "", "text": "いや、ちょっと待って！"},
        { "location": "517/ACT"   , "narrator": "", "text": "…望むところだ"},
        { "location": "518/TALK"  , "narrator": "昇華百鶴", "text": "わかりました。\nそれでは――"},
        { "location": "519/TALK"  , "narrator": "昇華百鶴", "text": "……。"},
        { "location": "520/SEL"   , "narrator": "", "text": "…？"},
        { "location": "521/ACT"   , "narrator": "", "text": "…？"},
        { "location": "523/TALK"  , "narrator": "昇華百鶴", "text": "と、その前に。"},
        { "location": "524/SEL"   , "narrator": "", "text": "あらら……"},
        { "location": "525/ACT"   , "narrator": "", "text": "あらら……"},
        { "location": "527/TALK"  , "narrator": "昇華百鶴", "text": "冥土の土産を\n無理矢理押しつけて\nやります。"},
        { "location": "528/ACT"   , "narrator": "", "text": "いや、ちょっと待って！"},
        { "location": "529/TALK"  , "narrator": "昇華百鶴", "text": "なんですか、\n盛り下がりますね…。"},
        { "location": "530/SEL"   , "narrator": "", "text": "本当にこれから百鶴と戦うの？"},
        { "location": "531/SEL"   , "narrator": "", "text": "百鶴は本当に戦いたいの？"},
        { "location": "532/ACT"   , "narrator": "", "text": "本当にこれから百鶴と戦うの？"},
        { "location": "533/TALK"  , "narrator": "昇華百鶴", "text": "もちろんですよ。"},
        { "location": "534/SEL"   , "narrator": "", "text": "そっかー"},
        { "location": "535/SEL"   , "narrator": "", "text": "今まで仲良くやってきたのに、どうして？"},
        { "location": "536/ACT"   , "narrator": "", "text": "そっかー"},
        { "location": "537/TALK"  , "narrator": "昇華百鶴", "text": "そうなんです！"},
        { "location": "538/ACT"   , "narrator": "", "text": "今まで仲良くやってきたのに、どうして？"},
        { "location": "539/TALK"  , "narrator": "昇華百鶴", "text": "いや、そこでそれを\n出してくるのは反則です。"},
        { "location": "541/ACT"   , "narrator": "", "text": "百鶴は本当に戦いたいの？"},
        { "location": "542/TALK"  , "narrator": "昇華百鶴", "text": "もちろんですとも！\nお前の脳みそかち割って\n飲み干してくれるわ！"},
        { "location": "543/TALK"  , "narrator": "昇華百鶴", "text": "……\nと、台本には\n書いてありますので。"},
        { "location": "544/SEL"   , "narrator": "", "text": "台本って何だよ！"},
        { "location": "545/ACT"   , "narrator": "", "text": "台本って何だよ！"},
        { "location": "547/TALK"  , "narrator": "昇華百鶴", "text": "冗談だよ！\n察しろよ■■野郎が！"},
        { "location": "549/SEL"   , "narrator": "", "text": "どうしてそこまでして戦わないといけないの？"},
        { "location": "550/ACT"   , "narrator": "", "text": "どうしてそこまでして戦わないといけないの？"},
        { "location": "552/TALK"  , "narrator": "昇華百鶴", "text": "わたしの主にとって\n最重要ともいえる事態が\n発生してるからですよ。"},
        { "location": "553/TALK"  , "narrator": "昇華百鶴", "text": "音羽さんが、つばめの心に\n侵入できるようになれば、\n何でもし放題です。"},
        { "location": "554/TALK"  , "narrator": "昇華百鶴", "text": "ようやく我が主が\nつばめと一つに戻る準備が\nできたというのに――"},
        { "location": "555/TALK"  , "narrator": "昇華百鶴", "text": "彼女が侵入すれば、\nそれを断ち切ることなど\n容易い事なのですよ。"},
        { "location": "556/TALK"  , "narrator": "昇華百鶴", "text": "これは、わりとここ最近で\n最大の危機とも言えます。"},
        { "location": "557/TALK"  , "narrator": "昇華百鶴", "text": "ですから、わたしだって\n全力で戦わねば\nならないのですよ。"},
        { "location": "558/TALK"  , "narrator": "昇華百鶴", "text": "そのための\n人格なのですから。"},
        { "location": "560/TALK"  , "narrator": "昇華百鶴", "text": "まあ、そんなわけで\n嫌でもバトルに突入する\nわけですが。"},
        { "location": "561/TALK"  , "narrator": "昇華百鶴", "text": "ぶっちゃけ、\n$handle$さんでは\n太刀打ち出来ません。"},
        { "location": "562/TALK"  , "narrator": "昇華百鶴", "text": "ただ、わたしには\nどうも癖があるようで。"},
        { "location": "563/TALK"  , "narrator": "昇華百鶴", "text": "なくて七癖と\n言いますしね。"},
        { "location": "564/TALK"  , "narrator": "昇華百鶴", "text": "３回攻撃したら、\nその後で――"},
        { "location": "565/TALK"  , "narrator": "昇華百鶴", "text": "わたし、エナジー攻撃と\nバインドスキルしないと\n気が済まないんですよ。"},
        { "location": "566/TALK"  , "narrator": "昇華百鶴", "text": "あと、なぜか\nキレッキレのクランには\nついビビってしまいます。"},
        { "location": "567/TALK"  , "narrator": "昇華百鶴", "text": "ですから、\nそれは可能な限り\n場に出さないでください。"},
        { "location": "568/TALK"  , "narrator": "昇華百鶴", "text": "そこんとこだけ\n配慮してくれれば、\nわたしの勝ちです。"},
        { "location": "569/SEL"   , "narrator": "", "text": "なにそのツッコミ処満載の口上！"},
        { "location": "570/ACT"   , "narrator": "", "text": "なにそのツッコミ処満載の口上！"},
        { "location": "572/TALK"  , "narrator": "昇華百鶴", "text": "それと！"},
        { "location": "573/TALK"  , "narrator": "昇華百鶴", "text": "こんな事もあろうかと、\nわたしは人質として\nカレンを飼ってます。"},
        { "location": "574/TALK"  , "narrator": "昇華百鶴", "text": "ちなみに場所は\n1x052番地です。"},
        { "location": "575/TALK"  , "narrator": "昇華百鶴", "text": "わたしを倒すような\nことがあれば、カレンは\n餓死するでしょうね。"},
        { "location": "576/TALK"  , "narrator": "昇華百鶴", "text": "わたし以外、彼女を\n監禁してる場所を\n知る者はいませんから！"},
        { "location": "577/SEL"   , "narrator": "", "text": "いや、場所教えてるし！！"},
        { "location": "578/ACT"   , "narrator": "", "text": "いや、場所教えてるし！！"},
        { "location": "580/TALK"  , "narrator": "昇華百鶴", "text": "そんな泣き言で\n命乞いしてる\nつもりですか？"},
        { "location": "581/SEL"   , "narrator": "", "text": "もう勢いだけでメチャクチャですよ！？"},
        { "location": "582/ACT"   , "narrator": "", "text": "もう勢いだけでメチャクチャですよ！？"},
        { "location": "584/TALK"  , "narrator": "昇華百鶴", "text": "うるさいですね！\nさあ、いきますよ！！"},
        { "location": "585/SEL"   , "narrator": "", "text": "こっちこそ、行くよ！！"},
        { "location": "586/SEL"   , "narrator": "", "text": "嫌だ、戦いたくない！！"},
        { "location": "587/ACT"   , "narrator": "", "text": "こっちこそ、行くよ！！"},
        { "location": "588/TALK"  , "narrator": "昇華百鶴", "text": "きなさい！\nいっしゅんで\nつぶしてやるわ（棒）"},
        { "location": "589/ACT"   , "narrator": "", "text": "嫌だ、戦いたくない！！"},
        { "location": "590/TALK"  , "narrator": "昇華百鶴", "text": "往生際が悪いんだよ\n■■野郎！"},
        { "location": "591/SEL"   , "narrator": "", "text": "百鶴を傷つけたくない！"},
        { "location": "592/SEL"   , "narrator": "", "text": "百鶴が好きなんだよ！！"},
        { "location": "593/ACT"   , "narrator": "", "text": "百鶴を傷つけたくない！"},
        { "location": "594/TALK"  , "narrator": "昇華百鶴", "text": "随分と\n余裕の構えじゃ\nありませんか。"},
        { "location": "595/TALK"  , "narrator": "昇華百鶴", "text": "そういうのは、\nまずわたしを傷つけてから\n言うべきですよ！"},
        { "location": "596/TALK"  , "narrator": "昇華百鶴", "text": "きなさい！\nいっしゅんで\nつぶしてやるわ（棒）"},
        { "location": "597/ACT"   , "narrator": "", "text": "百鶴が好きなんだよ！！"},
        { "location": "598/TALK"  , "narrator": "昇華百鶴", "text": "ここで言いますか！！"},
