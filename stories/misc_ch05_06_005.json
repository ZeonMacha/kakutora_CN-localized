    "entry":
    [
        { "location": "859/SCENARIO", "narrator": "", "text": "お・や・す・み・な・さ・いっ♪"},
        { "location": "884/TALK"    , "narrator": "神楽", "text": "お風呂上がりのぴょんこは"},
        { "location": "885/TALK"    , "narrator": "神楽", "text": "セルフケアの合間にチャット画面を開くのでした"},
        { "location": "887/SEL"     , "narrator": "", "text": "ど、どんな格好してるの！？"},
        { "location": "888/SEL"     , "narrator": "", "text": "どうせならお風呂ライブして！"},
        { "location": "889/SEL"     , "narrator": "", "text": "疲れは取れた？"},
        { "location": "890/ACT"     , "narrator": "", "text": "ど、どんな格好してるの！？"},
        { "location": "891/TALK"    , "narrator": "神楽", "text": "おいおい"},
        { "location": "892/TALK"    , "narrator": "神楽", "text": "そこなのか"},
        { "location": "893/ACT"     , "narrator": "", "text": "どうせならお風呂ライブして！"},
        { "location": "894/TALK"    , "narrator": "神楽", "text": "だが断る"},
        { "location": "895/ACT"     , "narrator": "", "text": "疲れは取れた？"},
        { "location": "897/TALK"    , "narrator": "神楽", "text": "あ"},
        { "location": "898/TALK"    , "narrator": "神楽", "text": "なんかキュンとｷﾀｰ！！！"},
        { "location": "899/TALK"    , "narrator": "神楽", "text": "$handlek$やさしぃ・・・"},
        { "location": "901/TALK"    , "narrator": "神楽", "text": "ケア関連は本当は全部人任せにしたいところ"},
        { "location": "902/TALK"    , "narrator": "神楽", "text": "時間があればそうするけど"},
        { "location": "903/TALK"    , "narrator": "神楽", "text": "なかなかそうもいかなくて"},
        { "location": "906/SEL"     , "narrator": "", "text": "いつもお疲れさま"},
        { "location": "907/SEL"     , "narrator": "", "text": "何もしなくても神楽はキレイだよ"},
        { "location": "908/SEL"     , "narrator": "", "text": "そういう時はサボれば？"},
        { "location": "909/ACT"     , "narrator": "", "text": "いつもお疲れさま"},
        { "location": "910/TALK"    , "narrator": "神楽", "text": "あーねー"},
        { "location": "911/ACT"     , "narrator": "", "text": "何もしなくても神楽はキレイだよ"},
        { "location": "913/TALK"    , "narrator": "神楽", "text": "そんなことはわかってるけど"},
        { "location": "914/TALK"    , "narrator": "神楽", "text": "もっと磨きをかけたいものなの"},
        { "location": "915/TALK"    , "narrator": "神楽", "text": "それがぴょんこだから♪"},
        { "location": "916/ACT"     , "narrator": "", "text": "そういう時はサボれば？"},
        { "location": "917/TALK"    , "narrator": "神楽", "text": "あ"},
        { "location": "918/TALK"    , "narrator": "神楽", "text": "無茶言うな"},
        { "location": "920/TALK"    , "narrator": "神楽", "text": "するとしないじゃ翌朝が違うから"},
        { "location": "921/TALK"    , "narrator": "神楽", "text": "しないなんて選択肢はないわけ"},
        { "location": "922/TALK"    , "narrator": "神楽", "text": "今日はいい夢が見られそう"},
        { "location": "924/TALK"    , "narrator": "神楽", "text": "おやすみなさい♪"}
    ]
}
