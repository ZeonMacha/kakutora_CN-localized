    "entry":
    [
        { "location": "3210/SCENARIO", "narrator": "", "text": "エレクトロニカ"},
        { "location": "3235/TALK"    , "narrator": "神楽", "text": "つばめさんったらカラオケも行ったことないんだって"},
        { "location": "3236/TALK"    , "narrator": "神楽", "text": "これはぴょんこに初めてを奪われるためのものだとしか思えないんだけど"},
        { "location": "3238/SEL"     , "narrator": "", "text": "カラオケに行くだけだよね！？"},
        { "location": "3239/SEL"     , "narrator": "", "text": "$me$も一緒に行くよ！"},
        { "location": "3240/SEL"     , "narrator": "", "text": "どんなの歌うの？"},
        { "location": "3241/ACT"     , "narrator": "", "text": "カラオケに行くだけだよね！？"},
        { "location": "3242/TALK"    , "narrator": "神楽", "text": "そうだけど？（じゅるり）"},
        { "location": "3244/ACT"     , "narrator": "", "text": "$me$も一緒に行くよ！"},
        { "location": "3246/TALK"    , "narrator": "神楽", "text": "えーえーえーえー"},
        { "location": "3248/TALK"    , "narrator": "神楽", "text": "来るの！？！？！？！"},
        { "location": "3249/TALK"    , "narrator": "神楽", "text": "もー空気読んで空気！"},
        { "location": "3250/TALK"    , "narrator": "神楽", "text": "でも仕方ないから許可してあげる♪"},
        { "location": "3251/TALK"    , "narrator": "神楽", "text": "特別だからね！"},
        { "location": "3252/ACT"     , "narrator": "", "text": "どんなの歌うの？"},
        { "location": "3253/TALK"    , "narrator": "神楽", "text": "つばめさんはフレイメノウ一択な気がする"},
        { "location": "3254/TALK"    , "narrator": "神楽", "text": "ぴょんこはその時の気分で♪"},
        { "location": "3256/TALK"    , "narrator": "神楽", "text": "歌姫ですらソフトウェアで代用できるこの時代に"},
        { "location": "3257/TALK"    , "narrator": "神楽", "text": "カラオケって必要なのかって思ったりもするぴょん"},
        { "location": "3259/SEL"     , "narrator": "", "text": "元々の音声は人の声だし"},
        { "location": "3260/SEL"     , "narrator": "", "text": "歌うの楽しくないの？"},
        { "location": "3261/SEL"     , "narrator": "", "text": "$me$の歌姫は神楽だけ"},
        { "location": "3262/ACT"     , "narrator": "", "text": "元々の音声は人の声だし"},
        { "location": "3263/TALK"    , "narrator": "神楽", "text": "それはそれとしてってこと"},
        { "location": "3264/ACT"     , "narrator": "", "text": "歌うの楽しくないの？"},
        { "location": "3266/TALK"    , "narrator": "神楽", "text": "楽しい"},
        { "location": "3267/ACT"     , "narrator": "", "text": "$me$の歌姫は神楽だけ"},
        { "location": "3269/TALK"    , "narrator": "神楽", "text": "よく言った！！！"},
        { "location": "3271/TALK"    , "narrator": "神楽", "text": "でも$handlek$はぴょんこの歌声聞いたことあったっけ？"},
        { "location": "3272/TALK"    , "narrator": "神楽", "text": "調子いいんだからー！"},
        { "location": "3274/TALK"    , "narrator": "神楽", "text": "あっそうだ"},
        { "location": "3275/TALK"    , "narrator": "神楽", "text": "ぴょんこは別につばめさんと特別になりたいわけじゃないから"},
        { "location": "3276/TALK"    , "narrator": "神楽", "text": "なんか初体験とか見守るのが楽しそうだってだけでしかないから"},
        { "location": "3277/TALK"    , "narrator": "神楽", "text": "それだけなんだからね！"}
    ]
}
