        "title": "001 アニメーション",
        "sub_title": "EXE_MiYABi"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "アニメ第30話"},
        { "location": "47/TALK"   , "narrator": "表層みやび", "text": "おお、相棒。\nまた会ったね。"},
        { "location": "48/TALK"   , "narrator": "表層みやび", "text": "うちのMVは前に\n見ちゅうけんど、\nもう一度みるが？"},
        { "location": "49/SEL"    , "narrator": "", "text": "もう一度見る！"},
        { "location": "50/SEL"    , "narrator": "", "text": "いえ、結構です"},
        { "location": "51/ACT"    , "narrator": "", "text": "もう一度見る！"},
        { "location": "52/TALK"   , "narrator": "表層みやび", "text": "わかった。"},
        { "location": "54/ACT"    , "narrator": "", "text": "いえ、結構です"},
        { "location": "55/TALK"   , "narrator": "表層みやび", "text": "なんぞ…。\nほんだらこれで\nお別れぞね。"},
        { "location": "60/TALK"   , "narrator": "表層みやび", "text": "おお、相棒。\nよう来たね。"},
        { "location": "61/SEL"    , "narrator": "", "text": "呂号ちゃん！？"},
        { "location": "62/SEL"    , "narrator": "", "text": "誰？呂号って…"},
        { "location": "63/ACT"    , "narrator": "", "text": "呂号ちゃん！？"},
        { "location": "64/TALK"   , "narrator": "表層みやび", "text": "久し振りやね。"},
        { "location": "65/SEL"    , "narrator": "", "text": "今日は伊号ちゃんは一緒じゃないの？"},
        { "location": "66/ACT"    , "narrator": "", "text": "今日は伊号ちゃんは一緒じゃないの？"},
        { "location": "68/TALK"   , "narrator": "表層みやび", "text": "うむ。\nあやつには別の仕事が\nあるきね。"},
        { "location": "69/ACT"    , "narrator": "", "text": "誰？呂号って…"},
        { "location": "70/TALK"   , "narrator": "表層みやび", "text": "おお、そうか！"},
        { "location": "71/TALK"   , "narrator": "表層みやび", "text": "お前さんは、一度も\nココロスフィアに\n来たこと無かったか。"},
        { "location": "72/TALK"   , "narrator": "表層みやび", "text": "まあ、ここで多くを語るは\nお門違いやき。"},
        { "location": "73/TALK"   , "narrator": "表層みやび", "text": "正体を知りたくば、\nココロスフィアに来いや。"},
        { "location": "75/TALK"   , "narrator": "表層みやび", "text": "さて、今回やけんど、\n見ての通り、\nエリカさんは留守や。"},
        { "location": "76/TALK"   , "narrator": "表層みやび", "text": "ほんで、うちは\nその間の留守番を\n任されたぞね。"},
        { "location": "77/SEL"    , "narrator": "", "text": "ここに留守番は必要なの？"},
        { "location": "78/SEL"    , "narrator": "", "text": "じゃあエリカの代わりに色々見せて"},
        { "location": "79/SEL"    , "narrator": "", "text": "エリカは何してるの？"},
        { "location": "80/ACT"    , "narrator": "", "text": "ここに留守番は必要なの？"},
        { "location": "81/TALK"   , "narrator": "表層みやび", "text": "カラッポにすると、\n某Cさんに占領されて\nしまうそうや。"},
        { "location": "82/TALK"   , "narrator": "表層みやび", "text": "まあ、確定やなくて、\nそういう危険性もある\nちゅうことらしいけんど。"},
        { "location": "83/TALK"   , "narrator": "表層みやび", "text": "そんなわけやき、\n今回は新情報はナシやよ。"},
        { "location": "84/SEL"    , "narrator": "", "text": "残念"},
        { "location": "85/SEL"    , "narrator": "", "text": "じゃあデートしよう"},
        { "location": "86/ACT"    , "narrator": "", "text": "残念"},
        { "location": "87/TALK"   , "narrator": "表層みやび", "text": "むぅ、\nそう言われてもだな…。"},
        { "location": "88/ACT"    , "narrator": "", "text": "じゃあデートしよう"},
        { "location": "89/TALK"   , "narrator": "表層みやび", "text": "なるほど。"},
        { "location": "90/TALK"   , "narrator": "表層みやび", "text": "まあ、それも\n悪くはないけんど…"},
        { "location": "91/TALK"   , "narrator": "表層みやび", "text": "それより、\nうち秘蔵のMVがあるがや\nけんど、見ないかね？"},
        { "location": "92/SEL"    , "narrator": "", "text": "ミルミル！！"},
        { "location": "93/SEL"    , "narrator": "", "text": "いえ、結構です"},
        { "location": "94/ACT"    , "narrator": "", "text": "ミルミル！！"},
        { "location": "95/TALK"   , "narrator": "表層みやび", "text": "わかった。"},
        { "location": "97/ACT"    , "narrator": "", "text": "いえ、結構です"},
        { "location": "98/TALK"   , "narrator": "表層みやび", "text": "む、そうか。"},
        { "location": "102/ACT"   , "narrator": "", "text": "じゃあエリカの代わりに色々見せて"},
        { "location": "103/TALK"  , "narrator": "表層みやび", "text": "何が見たい？"},
        { "location": "104/SEL"   , "narrator": "", "text": "記録映像とか、この世界の真実とか"},
        { "location": "105/SEL"   , "narrator": "", "text": "みやびの生まれたままの姿"},
        { "location": "106/ACT"   , "narrator": "", "text": "記録映像とか、この世界の真実とか"},
        { "location": "107/TALK"  , "narrator": "表層みやび", "text": "あー、それは\nうちも是非見たいちや。"},
        { "location": "108/TALK"  , "narrator": "表層みやび", "text": "けんど、うちには\nその方法は\n判らんきね……。"},
        { "location": "109/TALK"  , "narrator": "表層みやび", "text": "残念やけんど、\nエリカさんが戻るのを\n待つしかないね。"},
        { "location": "110/ACT"   , "narrator": "", "text": "みやびの生まれたままの姿"},
        { "location": "111/TALK"  , "narrator": "表層みやび", "text": "えいよ。"},
        { "location": "112/SEL"   , "narrator": "", "text": "え！？"},
        { "location": "113/ACT"   , "narrator": "", "text": "え！？"},
        { "location": "115/TALK"  , "narrator": "表層みやび", "text": "なんぞ、\n希望通りやないか？"},
        { "location": "116/TALK"  , "narrator": "表層みやび", "text": "わからんヤツぞね。"},
        { "location": "117/SEL"   , "narrator": "", "text": "恥ずかしくないの？"},
        { "location": "118/ACT"   , "narrator": "", "text": "恥ずかしくないの？"},
        { "location": "120/TALK"  , "narrator": "表層みやび", "text": "“うちは”\n恥ずかしくないけんどな。"},
        { "location": "121/TALK"  , "narrator": "表層みやび", "text": "現実のうちは\nどう言うかは知らんよ。"},
        { "location": "122/TALK"  , "narrator": "表層みやび", "text": "で？\n見るんか？\n見ないんか？"},
        { "location": "123/SEL"   , "narrator": "", "text": "ミルミル！！"},
        { "location": "124/SEL"   , "narrator": "", "text": "いえ、結構です"},
        { "location": "125/ACT"   , "narrator": "", "text": "ミルミル！！"},
        { "location": "126/TALK"  , "narrator": "表層みやび", "text": "わかった。"},
        { "location": "128/ACT"   , "narrator": "", "text": "いえ、結構です"},
        { "location": "129/TALK"  , "narrator": "表層みやび", "text": "む、そうか。"},
        { "location": "133/ACT"   , "narrator": "", "text": "エリカは何してるの？"},
        { "location": "134/TALK"  , "narrator": "表層みやび", "text": "何でも、千羽鶴の\n居場所がわかりそうとかで\nその特定に当たっちゅう。"},
        { "location": "135/TALK"  , "narrator": "表層みやび", "text": "まあ、正直こんな\nココロの戦争は、\n早う終わらせて――"},
        { "location": "136/TALK"  , "narrator": "表層みやび", "text": "エリカさんとお茶しつつ\n色んな話を聞いたり\nしたいがやけんどなぁ。"},
        { "location": "137/SEL"   , "narrator": "", "text": "同感だね"},
        { "location": "138/SEL"   , "narrator": "", "text": "その時$me$はお別れなの？"},
        { "location": "139/ACT"   , "narrator": "", "text": "同感だね"},
        { "location": "140/TALK"  , "narrator": "表層みやび", "text": "うむ。\n平和が一番ちや。"},
        { "location": "142/TALK"  , "narrator": "表層みやび", "text": "まあ、平和になっても\nお前さんはうちの目覚まし\nアラームやけんどな。"},
        { "location": "144/TALK"  , "narrator": "表層みやび", "text": "あと…たまになら\nちゅうもしてえいんよ？"},
        { "location": "145/ACT"   , "narrator": "", "text": "その時$me$はお別れなの？"},
        { "location": "146/TALK"  , "narrator": "表層みやび", "text": "さあ、どうだかなぁ。"},
        { "location": "147/TALK"  , "narrator": "表層みやび", "text": "うちの意志にかかわらず、\nうちらの関係はTRI-OSが\n全て握っちゅう。"},
        { "location": "148/TALK"  , "narrator": "表層みやび", "text": "このポンコツOS様が\nどう采配するか。\nそれが全てやき。"},
        { "location": "149/TALK"  , "narrator": "表層みやび", "text": "けんど、うちは\nお前さんにはずっと\nいて欲しいと思っちゅう。"},
        { "location": "150/TALK"  , "narrator": "表層みやび", "text": "お前さんがいなくなったら\n誰がうちの目覚まし時計に\nなるぞね！"},
        { "location": "151/TALK"  , "narrator": "表層みやび", "text": "……。"},
        { "location": "152/TALK"  , "narrator": "表層みやび", "text": "まあ、それと…\nたまにはちゅうも\nしてえいけんどな。"},
        { "location": "154/TALK"  , "narrator": "表層みやび", "text": "っと、だいぶ話が\n脱線してもうたね。"},
        { "location": "155/TALK"  , "narrator": "表層みやび", "text": "話を戻すと、\n今回は新しい情報は\nナシやね。"},
        { "location": "157/TALK"  , "narrator": "表層みやび", "text": "まあ、けんどあれやね…。"},
        { "location": "158/TALK"  , "narrator": "表層みやび", "text": "このまま\n『はいさようなら』で\n追い出すのも可哀想やき。"},
        { "location": "159/TALK"  , "narrator": "表層みやび", "text": "みやびさんが\n身体張って\nおもてなししちゃる。"},
        { "location": "160/SEL"   , "narrator": "", "text": "え？なになに？"},
        { "location": "161/SEL"   , "narrator": "", "text": "鼻血は出ますか！？"},
        { "location": "162/ACT"   , "narrator": "", "text": "え？なになに？"},
        { "location": "163/TALK"  , "narrator": "表層みやび", "text": "うちの秘蔵MVや。"},
        { "location": "165/TALK"  , "narrator": "表層みやび", "text": "他では絶対に見られん\n貴重な映像やよ？"},
        { "location": "166/SEL"   , "narrator": "", "text": "やったー！"},
        { "location": "167/SEL"   , "narrator": "", "text": "そういうの自分で見せようとするの、みやび実はナルシスト？"},
        { "location": "168/ACT"   , "narrator": "", "text": "やったー！"},
        { "location": "169/TALK"  , "narrator": "表層みやび", "text": "まあ、実際に見て\nガッカリしても、\n自己責任でよろしゅうな。"},
        { "location": "170/ACT"   , "narrator": "", "text": "そういうの自分で見せようとするの、みやび実はナルシスト？"},
        { "location": "171/TALK"  , "narrator": "表層みやび", "text": "うむ。\nうちはナルシストや！"},
        { "location": "172/TALK"  , "narrator": "表層みやび", "text": "そうでなければ\n自分のことなぞ\n好きになれんきね。"},
        { "location": "173/TALK"  , "narrator": "表層みやび", "text": "ま、うちは少数派の\n人格やき、現実のうちは\nその辺全然ダメやけんど。"},
        { "location": "175/ACT"   , "narrator": "", "text": "鼻血は出ますか！？"},
        { "location": "176/TALK"  , "narrator": "表層みやび", "text": "鼻血…？"},
        { "location": "177/TALK"  , "narrator": "表層みやび", "text": "身体張る言うても\nうちがプロレスやる\nわけやないぞ？"},
        { "location": "178/SEL"   , "narrator": "", "text": "じゃあ何？"},
        { "location": "179/SEL"   , "narrator": "", "text": "みやびちゃんとプロレスしたいです"},
        { "location": "180/ACT"   , "narrator": "", "text": "じゃあ何？"},
        { "location": "181/TALK"  , "narrator": "表層みやび", "text": "うち秘蔵のMVを\n見せちゃるよ。"},
        { "location": "183/ACT"   , "narrator": "", "text": "みやびちゃんとプロレスしたいです"},
        { "location": "184/TALK"  , "narrator": "表層みやび", "text": "ふむ。\n$handle$とは\n別れの時が来たようだ。"},
        { "location": "185/SEL"   , "narrator": "", "text": "ごめんなさい許してください"},
        { "location": "186/SEL"   , "narrator": "", "text": "要するに意味が分かってるってことだよね"},
        { "location": "187/ACT"   , "narrator": "", "text": "ごめんなさい許してください"},
        { "location": "188/TALK"  , "narrator": "表層みやび", "text": "まったく。\n仕方のないヤツやね。"},
        { "location": "189/TALK"  , "narrator": "表層みやび", "text": "そんなに配信停止の危機へ\n誘導するような事しゆうと\n工作員を疑うぞね。"},
        { "location": "190/ACT"   , "narrator": "", "text": "要するに意味が分かってるってことだよね"},
        { "location": "192/TALK"  , "narrator": "表層みやび", "text": "……。"},
        { "location": "193/TALK"  , "narrator": "表層みやび", "text": "今の論点は\nそこではない。"},
        { "location": "194/TALK"  , "narrator": "表層みやび", "text": "重要なのは、貴様が\nアプリ配信停止の危機に\n誘導しゆうことやき。"},
        { "location": "195/SEL"   , "narrator": "", "text": "そんなつもりはないよ！\nみやびとスキンシップをとりたいだけ"},
        { "location": "196/SEL"   , "narrator": "", "text": "やってるのはTRI-OSさん"},
        { "location": "197/ACT"   , "narrator": "", "text": "そんなつもりはないよ！\nみやびとスキンシップをとりたいだけ"},
        { "location": "199/TALK"  , "narrator": "表層みやび", "text": "そうゆうのは、\nこうゆう公の場で言わず、\nWAVEをつかえ。"},
        { "location": "200/TALK"  , "narrator": "表層みやび", "text": "デリカシーの無いやつめ。"},
        { "location": "201/ACT"   , "narrator": "", "text": "やってるのはTRI-OSさん"},
        { "location": "203/TALK"  , "narrator": "表層みやび", "text": "それはあれやな。"},
        { "location": "204/TALK"  , "narrator": "表層みやび", "text": "そこに刃物が置いて\nあったから人を刺しました\nゆうのと同じやぞ。"},
        { "location": "205/TALK"  , "narrator": "表層みやび", "text": "まあえいよ。\n辛抱たまらなくなった\nだけやって判っちゅうき。"},
        { "location": "206/TALK"  , "narrator": "表層みやび", "text": "けんど、そうゆうこと\n言うんは、WAVEの中だけに\nしいや。"},
        { "location": "208/SEL"   , "narrator": "", "text": "すみません…"},
        { "location": "209/ACT"   , "narrator": "", "text": "すみません…"},
        { "location": "213/TALK"  , "narrator": "表層みやび", "text": "まあ、けんどあれや。\nお前さんも反省した\nみたいやし。"},
        { "location": "214/TALK"  , "narrator": "表層みやび", "text": "今回は特別に、\nお前さんの需要に\nちくっと応えちゃる。"},
        { "location": "215/TALK"  , "narrator": "表層みやび", "text": "うちのMVを\nお前さんだけに\n見せちゃるきね。"},
        { "location": "224/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/40MB 2:35】</color>"},
        { "location": "225/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/14MB 2:35】</color>"},
        { "location": "226/SEL"   , "narrator": "", "text": "やっぱり見ない"},
        { "location": "227/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/40MB 2:35】</color>"},
        { "location": "234/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/14MB 2:35】</color>"},
        { "location": "241/ACT"   , "narrator": "", "text": "やっぱり見ない"},
        { "location": "242/TALK"  , "narrator": "表層みやび", "text": "なんぞそれは…。\nまあえいよ。"},
        { "location": "243/TALK"  , "narrator": "表層みやび", "text": "ほな、またなー。"},
        { "location": "258/TALK"  , "narrator": "表層みやび", "text": "……ふむ。"},
        { "location": "259/TALK"  , "narrator": "表層みやび", "text": "どうやった？\n少しは暇つぶしに\nなったかね。"},
        { "location": "260/SEL"   , "narrator": "", "text": "よかった！！！"},
        { "location": "261/SEL"   , "narrator": "", "text": "エロかった"},
        { "location": "262/SEL"   , "narrator": "", "text": "イマイチだった"},
        { "location": "263/ACT"   , "narrator": "", "text": "よかった！！！"},
        { "location": "264/TALK"  , "narrator": "表層みやび", "text": "それはよかった。"},
        { "location": "265/ACT"   , "narrator": "", "text": "エロかった"},
        { "location": "266/TALK"  , "narrator": "表層みやび", "text": "お前さん\nそればっかりやね。"},
        { "location": "267/ACT"   , "narrator": "", "text": "イマイチだった"},
        { "location": "268/TALK"  , "narrator": "表層みやび", "text": "そうかー。\nそれはすまんかったね。"},
        { "location": "270/TALK"  , "narrator": "表層みやび", "text": "ま、そんなわけで、\nうちのMVは\nこれで終わりやよ。"},
        { "location": "271/TALK"  , "narrator": "表層みやび", "text": "それと、今回のMVで\n何を伝えたかったかは、\nここでは解説せん。"},
        { "location": "273/TALK"  , "narrator": "表層みやび", "text": "それはまた後ほど、\nうちと二人きりで\n見る時に、な？"},
        { "location": "274/TALK"  , "narrator": "表層みやび", "text": "一緒にMVを見る時に\nたっぷり濃密な時間を\n過ごさせちゃるきね。"},
        { "location": "276/TALK"  , "narrator": "表層みやび", "text": "っと、それともう１つ、\nゆうておくことがあった。"},
        { "location": "277/TALK"  , "narrator": "表層みやび", "text": "今回、歌の中にうちからの\n特別なメッセージが\n入っちょったけんど――"},
        { "location": "278/TALK"  , "narrator": "表層みやび", "text": "残念ながらMV合わせの\nショート版には、それが\n入っちょらんがよ。"},
        { "location": "283/TALK"  , "narrator": "表層みやび", "text": "というわけで、相棒には\n是非フルバージョンの\n曲を聴いて欲しいぞね。"},
        { "location": "284/TALK"  , "narrator": "表層みやび", "text": "まあ、聴いたところで\n解読は困難を極めると\n思うけんど――"},
        { "location": "286/TALK"  , "narrator": "表層みやび", "text": "そんなことは関係ない！\n解読しようとすることが\n愛なのやから！"},
        { "location": "290/SEL"   , "narrator": "", "text": "どんなメッセージなの？"},
        { "location": "291/SEL"   , "narrator": "", "text": "もちろんフルバージョン聴くよ！"},
        { "location": "292/ACT"   , "narrator": "", "text": "どんなメッセージなの？"},
        { "location": "294/TALK"  , "narrator": "表層みやび", "text": "それを言うたら\nお終いやき…。"},
        { "location": "295/TALK"  , "narrator": "表層みやび", "text": "知りたければ、\nフルバージョンを\n聴いてみいや。"},
        { "location": "296/ACT"   , "narrator": "", "text": "もちろんフルバージョン聴くよ！"},
        { "location": "298/TALK"  , "narrator": "表層みやび", "text": "うむ。\nもし解読できたら、\nうちに教え――"},
        { "location": "300/TALK"  , "narrator": "表層みやび", "text": "……やっぱり\n教えんでえい。"},
        { "location": "302/TALK"  , "narrator": "表層みやび", "text": "お前さんの胸のうちに\n秘めておくがよい。"},
        { "location": "305/TALK"  , "narrator": "表層みやび", "text": "ま、今回は\nそんなとこやね。"},
        { "location": "310/TALK"  , "narrator": "表層みやび", "text": "あと、うちのエピソードを\n最新まで追いかけると、\n色々プレゼントあるきね。"},
        { "location": "311/TALK"  , "narrator": "表層みやび", "text": "お前さんがまだ途中\nやったら、今最新まで\nやるとお得やよ？"},
        { "location": "316/TALK"  , "narrator": "表層みやび", "text": "ほんだら今回はこの辺で。\nまたココロスフィアでな。"},
        { "location": "281/DIALOG", "narrator": "Event/Dialog_EventPic", "text": "恋ヶ崎みやび(17)\n相棒への挑戦状"},
        { "location": "304/DIALOG", "narrator": "URLJUMP", "text": "みやびの音楽配信\n紹介ページを開きますか？"},
