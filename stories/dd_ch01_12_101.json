{
    "dir": "chap12/daydra/dd_ch01_12_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "12102",
        "cid": "tsubame",
        "title": "002 メインストーリー",
        "sub_title": "新メンバー？＜前編＞"
    },
    "entry":
    [
        { "location": "8/SCENARIO", "narrator": "", "text": "新メンバー？"},
        { "location": "31/TALK"   , "narrator": "つばめ", "text": "あーあ、また縁日に\n行きたいなぁ…。"},
        { "location": "34/TALK"   , "narrator": "神楽", "text": "楽しかったですよね。"},
        { "location": "35/TALK"   , "narrator": "神楽", "text": "私も、つばめさんの\n可愛い浴衣姿を\nまた見たいです。"},
        { "location": "37/TALK"   , "narrator": "つばめ", "text": "卯月さんの浴衣も\n可愛かったよ。"},
        { "location": "39/TALK"   , "narrator": "神楽", "text": "つばめさんに\nそう言ってもらえると\n嬉しいです。"},
        { "location": "41/TALK"   , "narrator": "つばめ", "text": "また近くで\nお祭りやらないか――"},
        { "location": "42/TALK"   , "narrator": "つばめ", "text": "劇場についたら\n調べてみようかな？"},
        { "location": "68/TALK"   , "narrator": "つばめ", "text": "さてと、今日も\nバイト頑張って――"},
        { "location": "70/TALK"   , "narrator": "繭", "text": "いらっしゃいませ。"},
        { "location": "73/TALK"   , "narrator": "神楽", "text": "えっ？"},
        { "location": "75/TALK"   , "narrator": "つばめ", "text": "まゆちん！？"},
        { "location": "76/TALK"   , "narrator": "繭", "text": "…驚かせたかしら？"},
        { "location": "79/TALK"   , "narrator": "つばめ", "text": "ビックリしたよぉ。\n違うところに入ったの\nかと思っちゃった。"},
        { "location": "81/TALK"   , "narrator": "繭", "text": "たまには茶目っ気も\n必要かと思って…。"},
        { "location": "82/TALK"   , "narrator": "神楽", "text": "でも、何だか\n凄く似合ってます。"},
        { "location": "83/TALK"   , "narrator": "神楽", "text": "何だか、高級会員制\nクラブになった\nみたいに感じますよ！"},
        { "location": "84/TALK"   , "narrator": "繭", "text": "…褒められてるの\nかしら？"},
        { "location": "86/TALK"   , "narrator": "つばめ", "text": "でも、劇場で\n何してるの？"},
        { "location": "88/TALK"   , "narrator": "繭", "text": "教官から、在庫管理の\nＰＣがよくハングする\nようになったから――"},
        { "location": "89/TALK"   , "narrator": "繭", "text": "見て欲しいと\n頼まれて、様子を\n見てただけ。"},
        { "location": "93/TALK"   , "narrator": "つばめ", "text": "…ハング？"},
        { "location": "94/TALK"   , "narrator": "繭", "text": "レジストリが壊滅的に\nおかしくなっていた\nから――"},
        { "location": "95/TALK"   , "narrator": "繭", "text": "クリンナップして\nおいたってこと。"},
        { "location": "97/TALK"   , "narrator": "つばめ", "text": "えーっと…つまり、\n呪文をかけたって\nこと？"},
        { "location": "101/TALK"  , "narrator": "神楽", "text": "レジストリ―・\nクリィーンナーップ♪"},
        { "location": "103/TALK"  , "narrator": "神楽", "text": "って感じですね？"},
        { "location": "106/TALK"  , "narrator": "繭", "text": "…………。"},
        { "location": "110/TALK"  , "narrator": "つばめ", "text": "きゃーっ！！\n卯月さんかわいー！！"},
        { "location": "111/TALK"  , "narrator": "つばめ", "text": "ねえねえ、もう一回！\nもう一回やって！！"},
        { "location": "114/TALK"  , "narrator": "神楽", "text": "えぇっ！？\nだ、ダメ、ダメです！"},
        { "location": "115/TALK"  , "narrator": "繭", "text": "…卯月さんは、\nその手のプロか何か？"},
        { "location": "117/TALK"  , "narrator": "神楽", "text": "は、はい？"},
        { "location": "118/TALK"  , "narrator": "繭", "text": "あまりにも洗練された\n無駄のない可愛さ\nだったので…。"},
        { "location": "120/TALK"  , "narrator": "つばめ", "text": "うん！　何だか\nアイドルみたいに\n可愛かったよね。"},
        { "location": "123/TALK"  , "narrator": "神楽", "text": "つ、つばめさん！\nあまりからかわないで\nください！"},
        { "location": "125/TALK"  , "narrator": "キリト", "text": "あれ？\n逢瀬達じゃん。"},
        { "location": "130/TALK"  , "narrator": "キリト", "text": "よっ、今帰りか？"},
        { "location": "132/TALK"  , "narrator": "ヒカル", "text": "二人とも、\nおかえりなさい。"},
        { "location": "135/TALK"  , "narrator": "つばめ", "text": "キリトくん達まで、\nここで何してるの？"},
        { "location": "137/TALK"  , "narrator": "キリト", "text": "何って…、何て言えば\nいいんだ？"},
        { "location": "139/TALK"  , "narrator": "ヒカル", "text": "アルバイト、で\nいいんじゃない\nかな？"},
        { "location": "141/TALK"  , "narrator": "つばめ", "text": "えぇーっ！？"},
        { "location": "143/TALK"  , "narrator": "神楽", "text": "真幌さん、\nよく許して\nくれましたね？"},
        { "location": "145/TALK"  , "narrator": "ヒカル", "text": "許したというか、\n根負けした感じでした\nけどね。"},
        { "location": "147/TALK"  , "narrator": "つばめ", "text": "…キリトくん達が\nいるってことは――"},
        { "location": "148/TALK"  , "narrator": "つばめ", "text": "もしかして、\nひなこちゃんも\n一緒なの？"},
        { "location": "150/TALK"  , "narrator": "キリト", "text": "当然。\nてか、こうなった\n原因はあいつだしな。"},
        { "location": "153/TALK"  , "narrator": "神楽", "text": "あの、話が全然\n見えてこないん\nですけど…。"},
        { "location": "155/TALK"  , "narrator": "ヒカル", "text": "詳しい話は、\n楽屋に行ってからに\nしませんか？"},
        { "location": "156/TALK"  , "narrator": "ヒカル", "text": "ひなこ部長の作ってる\nまかないも――"},
        { "location": "157/TALK"  , "narrator": "ヒカル", "text": "そろそろ出来上がる\n頃だと思いますし。"},
        { "location": "188/TALK"  , "narrator": "つばめ", "text": "美味しかったぁ！\nひなこちゃん、\nありがと。"},
        { "location": "190/TALK"  , "narrator": "雛", "text": "よかった―。\n喜んでもらえて！"},
        { "location": "192/TALK"  , "narrator": "キリト", "text": "てか、相変わらず\n『牛乳かん』専門\nなんだな。"},
        { "location": "194/TALK"  , "narrator": "雛", "text": "簡単に作れて\n美味しんだから、\n文句言わないのー。"},
        { "location": "195/TALK"  , "narrator": "つばめ", "text": "何だか、小学校の\n給食を思い出す\n美味しさだったよ。"},
        { "location": "198/TALK"  , "narrator": "神楽", "text": "私も、生まれて初めて\n頂きましたが――"},
        { "location": "199/TALK"  , "narrator": "神楽", "text": "この楽屋の雰囲気に\nピッタリな、素朴な\n美味しさでした。"},
        { "location": "201/TALK"  , "narrator": "雛", "text": "えへへー、よかった。\n気に入ってもらえて。"},
        { "location": "203/TALK"  , "narrator": "キリト", "text": "…ディスられてる\nように聞こえたのは\n俺だけか？"},
        { "location": "205/TALK"  , "narrator": "ヒカル", "text": "言ってる本人たちに、\n自覚あるかどうかは\n怪しいですが…。"},
        { "location": "206/TALK"  , "narrator": "雛", "text": "まゆちんは？\n美味しかった？"},
        { "location": "210/TALK"  , "narrator": "繭", "text": "不味い。\n飽きた。\n貧乏くさい。"},
        { "location": "212/TALK"  , "narrator": "キリト", "text": "…の割には、\n美味そうに食ってた\nけどな。"},
        { "location": "214/TALK"  , "narrator": "つばめ", "text": "あはは…。"},
        { "location": "216/TALK"  , "narrator": "つばめ", "text": "…それはそうと、\nどういうことなの？"},
        { "location": "217/TALK"  , "narrator": "つばめ", "text": "ヒカルくんは\nアルバイトって\n言ってたけど…。"},
        { "location": "219/TALK"  , "narrator": "雛", "text": "ふっふっふ…。\nよくぞ聞いてくれ\nました！"},
        { "location": "221/TALK"  , "narrator": "雛", "text": "あたし達、つばめ\nちゃん達のお手伝いを\nするための――"},
        { "location": "222/TALK"  , "narrator": "雛", "text": "クラブを設立したの。"},
        { "location": "225/TALK"  , "narrator": "神楽", "text": "クラブ、ですか？"},
        { "location": "227/TALK"  , "narrator": "雛", "text": "うん、その名も！"},
        { "location": "231/TALK"  , "narrator": "雛", "text": "<size=32>トライナリー応援団！</size>"},
        { "location": "235/TALK"  , "narrator": "繭", "text": "…は？"},
        { "location": "237/TALK"  , "narrator": "キリト", "text": "いや、何だそれ？\nそんな名前聞いて\nねぇぞ！？"},
        { "location": "239/TALK"  , "narrator": "雛", "text": "あたしの中では\n最初っから決まってた\nけど？"},
        { "location": "240/TALK"  , "narrator": "繭", "text": "勝手に決めるな。"},
        { "location": "242/TALK"  , "narrator": "ヒカル", "text": "え、えっと…応援団\nという名前に関しては\n置いておくとして――"},
        { "location": "243/TALK"  , "narrator": "ヒカル", "text": "そういうわけで、\nここで働くことに\nなったんです。"},
        { "location": "244/TALK"  , "narrator": "つばめ", "text": "…トライナリー応援団\nってことは――"},
        { "location": "245/TALK"  , "narrator": "つばめ", "text": "もしかして、劇場の\nお仕事以外も手伝う\nつもりでいるの？"},
        { "location": "247/TALK"  , "narrator": "雛", "text": "そだよー。"},
        { "location": "248/TALK"  , "narrator": "雛", "text": "まあ、一般人だから\n出来ること限られてる\nと思うけどねー。"},
        { "location": "250/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "251/TALK"  , "narrator": "つばめ", "text": "劇場だけじゃなくて、\nトライナリーの方も\n手伝うなんて――"},
        { "location": "252/TALK"  , "narrator": "つばめ", "text": "ちょっと心配かも。"},
        { "location": "253/TALK"  , "narrator": "つばめ", "text": "ひなこちゃん達は\nコネクトできない\nから――"},
        { "location": "254/TALK"  , "narrator": "つばめ", "text": "前線に立つことは\nないと思うけど。"},
        { "location": "256/TALK"  , "narrator": "つばめ", "text": "…トライナリーの\n任務は危険だし――"},
        { "location": "302/SEL"   , "narrator": "", "text": "おーい"},
        { "location": "303/ACT"   , "narrator": "", "text": "おーい"},
        { "location": "311/SEL"   , "narrator": "", "text": "EXEC_SEEK_SECTOR/."},
        { "location": "316/SEL"   , "narrator": "", "text": "Type::EternalWarning"},
        { "location": "317/SEL"   , "narrator": "", "text": "Type::KokoroError"},
        { "location": "318/SEL"   , "narrator": "", "text": "Type::Secret"},
        { "location": "319/SEL"   , "narrator": "", "text": "Type::"},
        { "location": "357/TALK"  , "narrator": "つばめ", "text": "うーん、やっぱり最近\nおなか出てきちゃってる\nかなぁ……。"},
        { "location": "358/TALK"  , "narrator": "つばめ", "text": "東京来てから\n美味しいものばっかりで\n食べ過ぎかも。"},
        { "location": "359/TALK"  , "narrator": "つばめ", "text": "おなかじゃなくて\n胸が大きくなれば\nいいのに……。"},
        { "location": "360/SEL"   , "narrator": "", "text": "ダイエット協力するよ！"},
        { "location": "361/SEL"   , "narrator": "", "text": "ウエスト測ってあげようか"},
        { "location": "362/ACT"   , "narrator": "", "text": "ダイエット協力するよ！"},
        { "location": "363/ACT"   , "narrator": "", "text": "ウエスト測ってあげようか"},
        { "location": "367/TALK"  , "narrator": "つばめ", "text": "え！？"},
        { "location": "369/TALK"  , "narrator": "つばめ", "text": "きゃああああ！\n人のココロに勝手に\n入ってこないでーーっ！"},
        { "location": "459/TALK"  , "narrator": "つばめ", "text": "はぁ……\n卯月さん来ないなぁ。"},
        { "location": "460/SEL"   , "narrator": "", "text": "神楽を待ってるの？"},
        { "location": "461/SEL"   , "narrator": "", "text": "神楽とデート？"},
        { "location": "462/ACT"   , "narrator": "", "text": "神楽を待ってるの？"},
        { "location": "465/TALK"  , "narrator": "つばめ", "text": "そうなんだよね。\n教えて欲しいことが\nあって。"},
        { "location": "466/ACT"   , "narrator": "", "text": "神楽とデート？"},
        { "location": "470/TALK"  , "narrator": "つばめ", "text": "え！？\nデート…っていうほどの\n事じゃないけど……。"},
        { "location": "471/TALK"  , "narrator": "つばめ", "text": "ちょっと卯月さんに\n教えて欲しいことが\nあるんだよね。"},
        { "location": "473/SEL"   , "narrator": "", "text": "勉強？"},
        { "location": "474/SEL"   , "narrator": "", "text": "エッチなこと？"},
        { "location": "475/ACT"   , "narrator": "", "text": "勉強？"},
        { "location": "476/TALK"  , "narrator": "つばめ", "text": "ううん、違うの。\n今回は――"},
        { "location": "477/ACT"   , "narrator": "", "text": "エッチなこと？"},
        { "location": "478/TALK"  , "narrator": "つばめ", "text": "うん。\n実はそうなんだ。"},
        { "location": "479/SEL"   , "narrator": "", "text": "え！？ほんとに？"},
        { "location": "480/SEL"   , "narrator": "", "text": "キマシタワー！"},
        { "location": "481/ACT"   , "narrator": "", "text": "え！？ほんとに？"},
        { "location": "482/TALK"  , "narrator": "つばめ", "text": "え？　ホントだけど？\n聞いてきたのにびっくり\nするなんて変なの。"},
        { "location": "483/TALK"  , "narrator": "つばめ", "text": "わたしね、もう高校生にも\nなるのに、みんなの話が\nわからない時があって。"},
        { "location": "484/TALK"  , "narrator": "つばめ", "text": "ほら、あるでしょ？\n年頃の女の子なら\n知ってること。"},
        { "location": "485/TALK"  , "narrator": "つばめ", "text": "わたしそういうの、\nわからなくて、卯月さんに\n教えてもらいたくて。"},
        { "location": "486/SEL"   , "narrator": "", "text": "で、アポとったんだ"},
        { "location": "487/SEL"   , "narrator": "", "text": "$me$が教えるよ"},
        { "location": "488/ACT"   , "narrator": "", "text": "で、アポとったんだ"},
        { "location": "489/TALK"  , "narrator": "つばめ", "text": "え？\nとってないよ？"},
        { "location": "490/TALK"  , "narrator": "つばめ", "text": "でも、卯月さんならきっと\n言わなくても来てくれる\nって信じてるから。"},
        { "location": "491/SEL"   , "narrator": "", "text": "ちゃんと言わなきゃだめだよ！アタックアタック！"},
        { "location": "492/SEL"   , "narrator": "", "text": "確かに神楽なら、言わなくても押し倒しそう"},
        { "location": "493/ACT"   , "narrator": "", "text": "ちゃんと言わなきゃだめだよ！アタックアタック！"},
        { "location": "496/TALK"  , "narrator": "つばめ", "text": "ええっ…\nそれは恥ずかしいよ――"},
        { "location": "497/ACT"   , "narrator": "", "text": "確かに神楽なら、言わなくても押し倒しそう"},
        { "location": "499/TALK"  , "narrator": "つばめ", "text": "ええっ！？　わたし\n押し倒されちゃうの？"},
        { "location": "500/TALK"  , "narrator": "つばめ", "text": "なんだかちょっと\nドキドキ――"},
        { "location": "503/ACT"   , "narrator": "", "text": "$me$が教えるよ"},
        { "location": "504/TALK"  , "narrator": "つばめ", "text": "そ、それはダメ！！"},
        { "location": "505/TALK"  , "narrator": "つばめ", "text": "だって、\n$handle$さんは…"},
        { "location": "507/ACT"   , "narrator": "", "text": "キマシタワー！"},
        { "location": "508/TALK"  , "narrator": "つばめ", "text": "え？\nなにそれ。"},
        { "location": "509/TALK"  , "narrator": "つばめ", "text": "東京タワーのなかま？"},
        { "location": "512/TALK"  , "narrator": "つばめ", "text": "――っていうか、\n$handle$さん、\nなんでここに！？"},
        { "location": "571/SEL"   , "narrator": "", "text": "え！？"},
        { "location": "572/ACT"   , "narrator": "", "text": "え！？"},
        { "location": "576/TALK"  , "narrator": "千羽鶴", "text": "…！？"},
        { "location": "577/SEL"   , "narrator": "", "text": "ちょっと待て！"},
        { "location": "582/ACT"   , "narrator": "", "text": "ちょっと待て！"},
        { "location": "584/TALK"  , "narrator": "千羽鶴", "text": "人のプライベートを\n覗くのは最低の行為。"},
        { "location": "585/SEL"   , "narrator": "", "text": "なんでここに千羽鶴がいるの？"},
        { "location": "586/ACT"   , "narrator": "", "text": "なんでここに千羽鶴がいるの？"},
        { "location": "588/TALK"  , "narrator": "千羽鶴", "text": "え？\nご飯食べてただけだけど？"},
        { "location": "589/SEL"   , "narrator": "", "text": "プログラムなのに！？"},
        { "location": "590/ACT"   , "narrator": "", "text": "プログラムなのに！？"},
        { "location": "592/TALK"  , "narrator": "千羽鶴", "text": "私、食事してるときに\n声かけられるの\n嫌いなの。"},
        { "location": "593/TALK"  , "narrator": "千羽鶴", "text": "故に問答無用。"},
        { "location": "29/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>6月27日　3:53 PM</color>\n放課後、下校途中にて。"},
        { "location": "268/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "300/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:librarian】</color>\n司書が存在しません。(p12)"},
        { "location": "306/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:MailSystem】</color>\nメッセージが1件届きました。"},
        { "location": "307/DIALOG", "narrator": "INFO", "text": "<color=green>【PN:つばめの司書】(1/2)</color>\n\nこんにちは、司書です！\n見事に有給休暇と当たっちゃいましたね。ごめんなさい。\n\n前にもお話していたかもしれませんが、代わりに司書やってもらえませんか？\n\nやり方教えますから。"},
        { "location": "309/DIALOG", "narrator": "INFO", "text": "<color=green>【PN:つばめの司書】(2/2)</color>\n\n悩みの検索ですけど、\nEXEC_SEEK_SECTOR/.を\n実行すると出てくる検索コマンドで\n「Type::KokoroError」を選択してください。\n\n他にも「EternalWarning」とか、「Secret」とか色々出てきますけど絶対に選択しないで下さいね？\n$handle$さんはいい人なので、しないと思いますけど念のためです。\n\n$handle$さんとわたしに\n素敵なココロの旅を！"},
