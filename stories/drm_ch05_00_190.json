    "entry":
    [
        { "location": "1216/SCENARIO", "narrator": "", "text": "アーティストには不必要な資質"},
        { "location": "1241/TALK"    , "narrator": "神楽", "text": "ぴょんこぴょんこぴょんこ"},
        { "location": "1242/TALK"    , "narrator": "神楽", "text": "ぴょんこさん参上ですよ～～～～♪"},
        { "location": "1244/SEL"     , "narrator": "", "text": "今日は機嫌いいね"},
        { "location": "1245/SEL"     , "narrator": "", "text": "今日も可愛いよ"},
        { "location": "1246/SEL"     , "narrator": "", "text": "今日はどんな話かな？"},
        { "location": "1247/ACT"     , "narrator": "", "text": "今日は機嫌いいね"},
        { "location": "1248/TALK"    , "narrator": "神楽", "text": "いつも上機嫌ってわけにはいかないですよね～"},
        { "location": "1249/TALK"    , "narrator": "神楽", "text": "いくらぴょんこでも"},
        { "location": "1250/ACT"     , "narrator": "", "text": "今日も可愛いよ"},
        { "location": "1253/TALK"    , "narrator": "神楽", "text": "$handle$さんに褒められちゃいましたっ♪"},
        { "location": "1255/TALK"    , "narrator": "神楽", "text": "うれしいなっ"},
        { "location": "1256/ACT"     , "narrator": "", "text": "今日はどんな話かな？"},
        { "location": "1257/TALK"    , "narrator": "神楽", "text": "どんな話にしようかな？"},
        { "location": "1260/TALK"    , "narrator": "神楽", "text": "ぴょんこは少しナーバスなので愚痴りたいです"},
        { "location": "1261/TALK"    , "narrator": "神楽", "text": "そんなぴょんこは許されますか？"},
        { "location": "1263/SEL"     , "narrator": "", "text": "許します"},
        { "location": "1264/SEL"     , "narrator": "", "text": "むしろ萌え！"},
        { "location": "1265/SEL"     , "narrator": "", "text": "何でも聞かせて"},
        { "location": "1266/ACT"     , "narrator": "", "text": "許します"},
        { "location": "1267/TALK"    , "narrator": "神楽", "text": "許された、、、？"},
        { "location": "1268/ACT"     , "narrator": "", "text": "むしろ萌え！"},
        { "location": "1269/TALK"    , "narrator": "神楽", "text": "それは豚っていうやつですか？"},
        { "location": "1270/ACT"     , "narrator": "", "text": "何でも聞かせて"},
        { "location": "1271/TALK"    , "narrator": "神楽", "text": "何でもってわけにはいきませんけど、、、、"},
        { "location": "1273/TALK"    , "narrator": "神楽", "text": "ぴょんこはこの世界がまやかしだって知ってます"},
        { "location": "1274/TALK"    , "narrator": "神楽", "text": "そしてぴょんこが手を下さないとどうにもならないことも"},
        { "location": "1275/TALK"    , "narrator": "神楽", "text": "それって一介の女子高生には荷が重すぎると思いません？"},
        { "location": "1277/SEL"     , "narrator": "", "text": "そうだよね…"},
        { "location": "1278/SEL"     , "narrator": "", "text": "わかるよ"},
        { "location": "1279/SEL"     , "narrator": "", "text": "$me$が側にいるから"},
        { "location": "1280/ACT"     , "narrator": "", "text": "そうだよね…"},
        { "location": "1281/TALK"    , "narrator": "神楽", "text": "そうでしょ～～"},
        { "location": "1282/TALK"    , "narrator": "神楽", "text": "わかってもらえます！？"},
        { "location": "1283/TALK"    , "narrator": "神楽", "text": "今日はなんだか気が済みました"},
        { "location": "1284/TALK"    , "narrator": "神楽", "text": "ではでは～♪"},
        { "location": "1288/ACT"     , "narrator": "", "text": "わかるよ"},
        { "location": "1289/TALK"    , "narrator": "神楽", "text": "本当ですか！？"},
        { "location": "1290/TALK"    , "narrator": "神楽", "text": "信じちゃいますよっ"},
        { "location": "1291/TALK"    , "narrator": "神楽", "text": "今日はなんだか気が楽になりました"},
        { "location": "1292/TALK"    , "narrator": "神楽", "text": "ありがとウサギ♪"},
        { "location": "1296/ACT"     , "narrator": "", "text": "$me$が側にいるから"},
        { "location": "1299/TALK"    , "narrator": "神楽", "text": "それっていつも言いますけど"},
        { "location": "1300/TALK"    , "narrator": "神楽", "text": "側にいたから何なんですか？"},
        { "location": "1302/SEL"     , "narrator": "", "text": "味方になれるかなって"},
        { "location": "1303/SEL"     , "narrator": "", "text": "…邪魔だったかな？"},
        { "location": "1304/SEL"     , "narrator": "", "text": "支えになりたいんだ"},
        { "location": "1305/ACT"     , "narrator": "", "text": "味方になれるかなって"},
        { "location": "1306/TALK"    , "narrator": "神楽", "text": "味方なんて"},
        { "location": "1307/ACT"     , "narrator": "", "text": "…邪魔だったかな？"},
        { "location": "1308/TALK"    , "narrator": "神楽", "text": "邪魔っていうか"},
        { "location": "1309/ACT"     , "narrator": "", "text": "支えになりたいんだ"},
        { "location": "1310/TALK"    , "narrator": "神楽", "text": "支えとか"},
        { "location": "1312/TALK"    , "narrator": "神楽", "text": "そういうの軽々しく言わないで欲しいんです"},
        { "location": "1314/SEL"     , "narrator": "", "text": "軽くなんて考えてないよ"},
        { "location": "1315/SEL"     , "narrator": "", "text": "本気にはしてもらえない？"},
        { "location": "1316/SEL"     , "narrator": "", "text": "ものすごく重いよ"},
        { "location": "1317/ACT"     , "narrator": "", "text": "軽くなんて考えてないよ"},
        { "location": "1318/TALK"    , "narrator": "神楽", "text": "どうでしょうか？"},
        { "location": "1319/ACT"     , "narrator": "", "text": "本気にはしてもらえない？"},
        { "location": "1321/TALK"    , "narrator": "神楽", "text": "本気って"},
        { "location": "1323/TALK"    , "narrator": "神楽", "text": "なんでしょうね？"},
        { "location": "1324/ACT"     , "narrator": "", "text": "ものすごく重いよ"},
        { "location": "1325/TALK"    , "narrator": "神楽", "text": "そうなんでしょうか？"},
        { "location": "1327/TALK"    , "narrator": "神楽", "text": "ちょっとそんな気はしないですけど"},
        { "location": "1329/TALK"    , "narrator": "神楽", "text": "あああああああああ！！！！！"},
        { "location": "1330/TALK"    , "narrator": "神楽", "text": "ちょっとシリアスモード入っちゃいましたね♪"},
        { "location": "1331/TALK"    , "narrator": "神楽", "text": "ぴょんこの新しい一面だと思ってください"},
        { "location": "1332/TALK"    , "narrator": "神楽", "text": "ぴょんこぴょんこぴょんこ"},
        { "location": "1333/TALK"    , "narrator": "神楽", "text": "ぴょんこさんさようなら～～～～♪"}
    ]
