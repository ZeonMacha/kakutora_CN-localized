    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "リセット！"},
        { "location": "32/TALK"   , "narrator": "神楽", "text": "ぴょんこは復活しましたよ～"},
        { "location": "33/TALK"   , "narrator": "神楽", "text": "そちらはどうですか？"},
        { "location": "35/SEL"    , "narrator": "", "text": "まあまあかな"},
        { "location": "36/SEL"    , "narrator": "", "text": "あんまり…"},
        { "location": "37/SEL"    , "narrator": "", "text": "神楽のおかげで元気になった"},
        { "location": "38/ACT"    , "narrator": "", "text": "まあまあかな"},
        { "location": "39/TALK"   , "narrator": "神楽", "text": "そうですか"},
        { "location": "40/TALK"   , "narrator": "神楽", "text": "ならよかったです"},
        { "location": "41/ACT"    , "narrator": "", "text": "あんまり…"},
        { "location": "42/TALK"   , "narrator": "神楽", "text": "あれあれ"},
        { "location": "43/TALK"   , "narrator": "神楽", "text": "ちょっと残念ですね"},
        { "location": "44/ACT"    , "narrator": "", "text": "神楽のおかげで元気になった"},
        { "location": "46/TALK"   , "narrator": "神楽", "text": "ﾔｯﾀﾈーーー！"},
        { "location": "47/TALK"   , "narrator": "神楽", "text": "ぴょんこうれしいですっ♪"},
        { "location": "51/TALK"   , "narrator": "神楽", "text": "この前は母のことでちょっとびっくりさせちゃいましたよね"},
        { "location": "52/TALK"   , "narrator": "神楽", "text": "でもそれはこの世界が色々アレなせいですから気にしないでください"},
        { "location": "53/TALK"   , "narrator": "神楽", "text": "本当の母はとってもかわいいひとなんですよっ♪"},
        { "location": "55/SEL"    , "narrator": "", "text": "えっと…"},
        { "location": "56/ACT"    , "narrator": "", "text": "えっと…"},
        { "location": "60/SEL"    , "narrator": "", "text": "とてもそうは思えないんだけど"},
        { "location": "61/SEL"    , "narrator": "", "text": "神楽はそれで平気なの？"},
        { "location": "62/SEL"    , "narrator": "", "text": "素敵なお母さんなんだね"},
        { "location": "63/ACT"    , "narrator": "", "text": "とてもそうは思えないんだけど"},
        { "location": "64/TALK"   , "narrator": "神楽", "text": "そうですか？"},
        { "location": "65/TALK"   , "narrator": "神楽", "text": "だったらそっとしておいてください"},
        { "location": "66/ACT"    , "narrator": "", "text": "神楽はそれで平気なの？"},
        { "location": "67/TALK"   , "narrator": "神楽", "text": "平気だと思いますか？"},
        { "location": "68/TALK"   , "narrator": "神楽", "text": "わざわざ聞く必要がありますか？"},
        { "location": "69/ACT"    , "narrator": "", "text": "素敵なお母さんなんだね"},
        { "location": "71/TALK"   , "narrator": "神楽", "text": "はい！"},
        { "location": "72/TALK"   , "narrator": "神楽", "text": "そういうわけでなんです♪"},
        { "location": "73/TALK"   , "narrator": "神楽", "text": "それじゃ、またぴょん♪"},
        { "location": "84/TALK"   , "narrator": "神楽", "text": "大体デリカシーがないんですよ"},
        { "location": "85/TALK"   , "narrator": "神楽", "text": "知られたくないことだって人にはあるんです"},
        { "location": "86/TALK"   , "narrator": "神楽", "text": "誰だってそうでしょう？？？？"},
        { "location": "88/SEL"    , "narrator": "", "text": "無理に聞くつもりはないけど"},
        { "location": "89/SEL"    , "narrator": "", "text": "そうだよね、ごめん"},
        { "location": "90/SEL"    , "narrator": "", "text": "話す気になったら言ってよ"},
        { "location": "91/ACT"    , "narrator": "", "text": "無理に聞くつもりはないけど"},
        { "location": "92/TALK"   , "narrator": "神楽", "text": "だったらいいんですけど"},
        { "location": "93/ACT"    , "narrator": "", "text": "そうだよね、ごめん"},
        { "location": "94/TALK"   , "narrator": "神楽", "text": "謝って欲しいわけじゃないです"},
        { "location": "95/ACT"    , "narrator": "", "text": "話す気になったら言ってよ"},
        { "location": "96/TALK"   , "narrator": "神楽", "text": "そんな気にはならないと思いますけど"},
        { "location": "98/TALK"   , "narrator": "神楽", "text": "ぴょんこはできれば楽しく過ごしたいんです"},
        { "location": "100/TALK"  , "narrator": "神楽", "text": "せめて$handle$さんと話してる時ぐらい"},
        { "location": "103/TALK"  , "narrator": "神楽", "text": "これっておかしくないですよね"},
        { "location": "105/SEL"   , "narrator": "", "text": "もちろん"},
        { "location": "106/SEL"   , "narrator": "", "text": "無理しなくていいよ"},
        { "location": "107/SEL"   , "narrator": "", "text": "どんな神楽でも受け止めるから"},
        { "location": "108/ACT"   , "narrator": "", "text": "もちろん"},
        { "location": "109/TALK"  , "narrator": "神楽", "text": "本当にそう思ってますか？"},
        { "location": "110/ACT"   , "narrator": "", "text": "無理しなくていいよ"},
        { "location": "111/TALK"  , "narrator": "神楽", "text": "無理なんて"},
        { "location": "112/ACT"   , "narrator": "", "text": "どんな神楽でも受け止めるから"},
        { "location": "113/TALK"  , "narrator": "神楽", "text": "本気で言ってますか？"},
        { "location": "115/TALK"  , "narrator": "神楽", "text": "今のぴょんこは一刻も早く任務を完了して"},
        { "location": "116/TALK"  , "narrator": "神楽", "text": "この世界を変えたいってそんな気持ちしかないです"},
        { "location": "119/SEL"   , "narrator": "", "text": "それはちょっとさみしいな"},
        { "location": "120/SEL"   , "narrator": "", "text": "お母さん心配だもんね"},
        { "location": "121/SEL"   , "narrator": "", "text": "無理しすぎないでね"},
        { "location": "122/ACT"   , "narrator": "", "text": "それはちょっとさみしいな"},
        { "location": "123/TALK"  , "narrator": "神楽", "text": "知りません"},
        { "location": "124/TALK"  , "narrator": "神楽", "text": "そんなの"},
        { "location": "125/ACT"   , "narrator": "", "text": "お母さん心配だもんね"},
        { "location": "126/TALK"  , "narrator": "神楽", "text": "言わないでください"},
        { "location": "127/TALK"  , "narrator": "神楽", "text": "母のことは"},
        { "location": "128/ACT"   , "narrator": "", "text": "無理しすぎないでね"},
        { "location": "129/TALK"  , "narrator": "神楽", "text": "ここにずっといる方がずっと無理です"},
        { "location": "131/TALK"  , "narrator": "神楽", "text": "本当はこんな世界なんかもどうでもいい"},
        { "location": "132/TALK"  , "narrator": "神楽", "text": "どうでもいいんです"},
        { "location": "134/SEL"   , "narrator": "", "text": "そんなこと言わないで"},
        { "location": "135/SEL"   , "narrator": "", "text": "神楽はがんばってるよ"},
        { "location": "136/SEL"   , "narrator": "", "text": "$me$のこともどうでもいいんだ…"},
        { "location": "137/ACT"   , "narrator": "", "text": "そんなこと言わないで"},
        { "location": "138/TALK"  , "narrator": "神楽", "text": "本当のことを言っただけですよ"},
        { "location": "139/TALK"  , "narrator": "神楽", "text": "本音で話して欲しいって言ってたくせに"},
        { "location": "140/TALK"  , "narrator": "神楽", "text": "矛盾してますね"},
        { "location": "141/ACT"   , "narrator": "", "text": "神楽はがんばってるよ"},
        { "location": "142/TALK"  , "narrator": "神楽", "text": "がんばってるってなんですか"},
        { "location": "143/TALK"  , "narrator": "神楽", "text": "結果が出せないなら意味がないんです"},
        { "location": "144/TALK"  , "narrator": "神楽", "text": "過程なんて"},
        { "location": "145/ACT"   , "narrator": "", "text": "$me$のこともどうでもいいんだ…"},
        { "location": "147/TALK"  , "narrator": "神楽", "text": "そういうとこ"},
        { "location": "149/TALK"  , "narrator": "神楽", "text": "イライラします"},
        { "location": "150/TALK"  , "narrator": "神楽", "text": "ありえないくらい"},
        { "location": "154/TALK"  , "narrator": "神楽", "text": "ごめんなさい"},
        { "location": "157/TALK"  , "narrator": "ボイスメール", "text": "それは全部、私のことで"},
        { "location": "169/DIALOG", "narrator": "Dialog_GETVoice", "text": "<color=green>【神楽】</color>のボイスメール\n<color=red>【それは全部、私のことで】</color>\nをゲットしました！"}
    ]
}
