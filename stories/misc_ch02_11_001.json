        { "location": "38/ACT"    , "narrator": "", "text": "めでたいぞー！"},
        { "location": "39/TALK"   , "narrator": "アーヤ", "text": "えっと。。。ヽ(´o｀；"},
        { "location": "41/TALK"   , "narrator": "アーヤ", "text": "何が（￣ー￣？）"},
