        { "location": "95/SEL"    , "narrator": "", "text": "気にし過ぎ"},
        { "location": "96/SEL"    , "narrator": "", "text": "早期教育推奨"},
        { "location": "97/ACT"    , "narrator": "", "text": "そんなことない"},
        { "location": "99/TALK"   , "narrator": "アーヤ", "text": "んー"},
