        { "location": "86/TALK"   , "narrator": "アーヤ", "text": "考えてみたら"},
        { "location": "87/TALK"   , "narrator": "アーヤ", "text": "よういえんの子にはまだちょっとはやいかも(・・。)ゞ"},
        { "location": "89/TALK"   , "narrator": "アーヤ", "text": "ラブストーリーって"},
