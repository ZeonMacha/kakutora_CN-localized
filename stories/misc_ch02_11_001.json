        { "location": "75/TALK"   , "narrator": "アーヤ", "text": "すぐこういうこと言い出すのよね＼(^O^)／"},
        { "location": "76/TALK"   , "narrator": "アーヤ", "text": "どうなってるのかしら(´o｀；"},
        { "location": "77/TALK"   , "narrator": "アーヤ", "text": "まあ"},
