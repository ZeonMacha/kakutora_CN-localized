        { "location": "47/TALK"   , "narrator": "アーヤ", "text": "幸せじゃない？"},
        { "location": "48/TALK"   , "narrator": "アーヤ", "text": "アーヤと話してるんだから(=^0^=)"},
        { "location": "50/SEL"    , "narrator": "", "text": "もっと幸せになりたいんだよ"},
        { "location": "51/SEL"    , "narrator": "", "text": "それで充分幸せだけどね"},
        { "location": "52/ACT"    , "narrator": "", "text": "もっと幸せになりたいんだよ"},
        { "location": "53/TALK"   , "narrator": "アーヤ", "text": "そういうものかもね(^з^)-☆"},
        { "location": "54/ACT"    , "narrator": "", "text": "それで充分幸せだけどね"},
        { "location": "55/TALK"   , "narrator": "アーヤ", "text": "よく言えました(^з^)-☆"},
        { "location": "64/TALK"   , "narrator": "アーヤ", "text": "七夕自体はちょっと切ない話かもしれないけど"},
        { "location": "65/TALK"   , "narrator": "アーヤ", "text": "七夕がきっかけでお付き合いとかはよくある話なんじゃないかなって思うの"},
        { "location": "67/SEL"    , "narrator": "", "text": "そうかも"},
        { "location": "68/SEL"    , "narrator": "", "text": "$handle$はアーヤと付き合いたい"},
        { "location": "69/SEL"    , "narrator": "", "text": "どうかな"},
