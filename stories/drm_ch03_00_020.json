    [
        { "location": "196/SCENARIO", "narrator": "", "text": "020_憧れと現実"},
        { "location": "222/TALK"    , "narrator": "ガブリエラ", "text": "ため息なんてよくないわよね・・・"},
        { "location": "224/TALK"    , "narrator": "ガブリエラ", "text": "でも色々考えちゃうの・・・"},
        { "location": "226/SEL"     , "narrator": "", "text": "相談に乗ろうか"},
        { "location": "227/SEL"     , "narrator": "", "text": "寝れば忘れるよ"},
        { "location": "229/TALK"    , "narrator": "ガブリエラ", "text": "う～ん・・・"},
        { "location": "232/TALK"    , "narrator": "ガブリエラ", "text": "今日はもう寝るわね・・・"},
        { "location": "244/ACT"     , "narrator": "", "text": "相談に乗ろうか"},
        { "location": "245/TALK"    , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "246/TALK"    , "narrator": "ガブリエラ", "text": "優しくていい子ね、あなた"},
        { "location": "247/TALK"    , "narrator": "ガブリエラ", "text": "聞いてもらえるかしら？"},
        { "location": "248/ACT"     , "narrator": "", "text": "寝れば忘れるよ"},
        { "location": "249/TALK"    , "narrator": "ガブリエラ", "text": "そんな単純なものじゃないわよ・・・"},
        { "location": "251/TALK"    , "narrator": "ガブリエラ", "text": "たぶんね"},
        { "location": "253/TALK"    , "narrator": "ガブリエラ", "text": "アーヤはね、本当はすごくすごく、すごいひとなの"},
        { "location": "254/TALK"    , "narrator": "ガブリエラ", "text": "剣道がすごく強くて、、、ポーランドの大会にも出たくらい強いの"},
        { "location": "255/TALK"    , "narrator": "ガブリエラ", "text": "なのに、今はもう剣道をやめたって言って"},
        { "location": "256/TALK"    , "narrator": "ガブリエラ", "text": "抜け殻みたいなの・・・"},
        { "location": "258/SEL"     , "narrator": "", "text": "アーヤのことが好き？"},
        { "location": "259/SEL"     , "narrator": "", "text": "アーヤのことは嫌い？"},
        { "location": "260/ACT"     , "narrator": "", "text": "アーヤのことが好き？"},
        { "location": "261/ACT"     , "narrator": "", "text": "アーヤのことは嫌い？"},
        { "location": "264/TALK"    , "narrator": "ガブリエラ", "text": "ポーランドでアーヤのことを知って、日本に来るまでは大好きだって思ってたわ"},
        { "location": "265/TALK"    , "narrator": "ガブリエラ", "text": "日本でまた会うことができて、剣道をやめたって聞いたときは大嫌いだって思った"},
        { "location": "267/SEL"     , "narrator": "", "text": "じゃあ今は？"},
        { "location": "268/ACT"     , "narrator": "", "text": "じゃあ今は？"},
        { "location": "271/TALK"    , "narrator": "ガブリエラ", "text": "自分でもよくわからないのよ"},
        { "location": "272/TALK"    , "narrator": "ガブリエラ", "text": "だけどね、"},
        { "location": "273/TALK"    , "narrator": "ガブリエラ", "text": "私はずっとアーヤのことを考えているのにアーヤは私のことをそんなに考えたりしないんだろうなって思うと私はとても悲しいの"},
        { "location": "275/SEL"     , "narrator": "", "text": "そんなことないと思うよ"},
        { "location": "276/SEL"     , "narrator": "", "text": "直接聞いてみれば？"},
        { "location": "277/ACT"     , "narrator": "", "text": "そんなことないと思うよ"},
        { "location": "288/TALK"    , "narrator": "ガブリエラ", "text": "そうかな・・・？"},
        { "location": "289/TALK"    , "narrator": "ガブリエラ", "text": "そうだといいな"},
        { "location": "290/ACT"     , "narrator": "", "text": "直接聞いてみれば？"},
        { "location": "291/TALK"    , "narrator": "ガブリエラ", "text": "・・・・"},
        { "location": "293/TALK"    , "narrator": "ガブリエラ", "text": "そんなこと、無理だもの・・・"},
        { "location": "284/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>200pt.</b></color></size>\nアップしました！"}
    ]
}
