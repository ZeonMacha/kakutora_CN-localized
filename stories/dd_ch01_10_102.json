{
    "dir": "chap10/daydra/dd_ch01_10_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "10105",
        "cid": "tsubame",
        "title": "005 メインストーリー",
        "sub_title": "新入隊員歓迎会＜後編＞"
    },
    "entry":
    [
        { "location": "537/SCENARIO", "narrator": "", "text": "新入隊員歓迎会"},
        { "location": "571/TALK"    , "narrator": "つばめ", "text": "…やっぱり、\n様子見に行こう。"},
        { "location": "572/TALK"    , "narrator": "つばめ", "text": "嫌われたくないから\nって、何もしない\nなんて――"},
        { "location": "573/TALK"    , "narrator": "つばめ", "text": "そんなの、本当の\n友達とは言えない\nもん。"},
        { "location": "574/TALK"    , "narrator": "つばめ", "text": "あ、でもその前に…。"},
        { "location": "586/TALK"    , "narrator": "つばめ", "text": "$handle$さん"},
        { "location": "587/TALK"    , "narrator": "つばめ", "text": "ちょっと聞きたいんだけど"},
        { "location": "588/TALK"    , "narrator": "つばめ", "text": "わたしの気持ちが変わったのって"},
        { "location": "589/TALK"    , "narrator": "つばめ", "text": "$handle$さんのおかげ？"},
        { "location": "591/SEL"     , "narrator": "", "text": "手助けしただけ"},
        { "location": "592/ACT"     , "narrator": "", "text": "手助けしただけ"},
        { "location": "594/TALK"    , "narrator": "つばめ", "text": "やっぱり"},
        { "location": "595/TALK"    , "narrator": "つばめ", "text": "ありがとう"},
        { "location": "598/SEL"     , "narrator": "", "text": "いいから、早く探しに行ってあげて"},
        { "location": "599/ACT"     , "narrator": "", "text": "いいから、早く探しに行ってあげて"},
        { "location": "601/TALK"    , "narrator": "つばめ", "text": "うん"},
        { "location": "602/TALK"    , "narrator": "つばめ", "text": "そうするね"},
        { "location": "613/TALK"    , "narrator": "つばめ", "text": "…急ごう。"},
        { "location": "617/TALK"    , "narrator": "真幌", "text": "ふぅ…ん？"},
        { "location": "618/TALK"    , "narrator": "真幌", "text": "なんだ、卯月はまだ\n戻ってないのか？"},
        { "location": "620/TALK"    , "narrator": "アーヤ", "text": "はい…あれ？\n館長も手洗いに\n行ったんですよね？"},
        { "location": "621/TALK"    , "narrator": "真幌", "text": "ああ…変だな？\n私が手洗いに行った\nときにはもう――"},
        { "location": "622/TALK"    , "narrator": "真幌", "text": "卯月が入っている\n様子はなかったん\nだが…。"},
        { "location": "624/TALK"    , "narrator": "つばめ", "text": "…えっ？"},
        { "location": "645/TALK"    , "narrator": "つばめ", "text": "はぁ、はぁ…。"},
        { "location": "646/TALK"    , "narrator": "つばめ", "text": "ここじゃないみたい。\n卯月さん、どこに\n行っちゃったんだろ？"},
        { "location": "663/TALK"    , "narrator": "ガブリエラ", "text": "ちょっと神楽！\nふざけてないで\n出てきなさい！"},
        { "location": "666/TALK"    , "narrator": "真幌", "text": "どうだ、ギャヴィ。\nそっちにはいたか？"},
        { "location": "668/TALK"    , "narrator": "ガブリエラ", "text": "…いないみたい。\nやっぱり、外に\n行ったんじゃない？"},
        { "location": "670/TALK"    , "narrator": "真幌", "text": "まったく…。\n一言もなしに\n勝手なことを…。"},
        { "location": "687/TALK"    , "narrator": "みやび", "text": "おーい、卯月ー。\nいないならいないと\nゆうてやー！"},
        { "location": "688/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "691/TALK"    , "narrator": "みやび", "text": "あかん。\nツッコミ不在のボケは\n虚しさ炸裂や…。"},
        { "location": "707/TALK"    , "narrator": "アーヤ", "text": "もう、卯月ってば、\n本当にどこ行っちゃっ\nたのかしら？"},
        { "location": "708/TALK"    , "narrator": "アーヤ", "text": "…事件に巻き込まれ\nたりとかしてなければ\nいいんだけど。"},
        { "location": "731/TALK"    , "narrator": "つばめ", "text": "卯月さん、本当に\nどこに…。"},
        { "location": "732/TALK"    , "narrator": "つばめ", "text": "あっ！"},
        { "location": "734/TALK"    , "narrator": "神楽", "text": "……　…。"},
        { "location": "735/TALK"    , "narrator": "神楽", "text": "…。"},
        { "location": "736/TALK"    , "narrator": "つばめ", "text": "卯月さん！"},
        { "location": "737/TALK"    , "narrator": "神楽", "text": "…え？\nつばめ…さん？"},
        { "location": "738/TALK"    , "narrator": "つばめ", "text": "よかったぁ…。\nやっと見つけたよ。"},
        { "location": "741/TALK"    , "narrator": "つばめ", "text": "急にいなくなった\nから、心配したん\nだよ？"},
        { "location": "743/TALK"    , "narrator": "神楽", "text": "…………。"},
        { "location": "744/TALK"    , "narrator": "つばめ", "text": "…大丈夫？\nもしかして、\nお腹が痛いの？"},
        { "location": "746/TALK"    , "narrator": "神楽", "text": "…いえ、平気です。\n心配かけちゃって\nごめんなさい。"},
        { "location": "747/TALK"    , "narrator": "つばめ", "text": "じゃあ、\nもしかして気分が\n悪くなっちゃって――"},
        { "location": "749/TALK"    , "narrator": "神楽", "text": "…平気ですから。\n本当、何でもないん\nです…。"},
        { "location": "751/TALK"    , "narrator": "つばめ", "text": "でも――"},
        { "location": "752/TALK"    , "narrator": "神楽", "text": "平気です！"},
        { "location": "753/TALK"    , "narrator": "神楽", "text": "何でもないって\n言ってるじゃない\nですか！？"},
        { "location": "754/TALK"    , "narrator": "つばめ", "text": "えっ…卯月、さん？"},
        { "location": "758/TALK"    , "narrator": "神楽", "text": "…………。"},
        { "location": "760/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "762/TALK"    , "narrator": "神楽", "text": "…ごめんなさい。\nやっぱり、ちょっと\n体調悪いみたいです。"},
        { "location": "768/TALK"    , "narrator": "つばめ", "text": "あっ、待ってよ\n卯月さん！"},
        { "location": "769/TALK"    , "narrator": "つばめ", "text": "…もし、何か困ってる\nこととかがあるん\nだったら――"},
        { "location": "771/TALK"    , "narrator": "つばめ", "text": "何でも話してね。\nわたし、相談に\n乗るから！"},
        { "location": "773/TALK"    , "narrator": "神楽", "text": "…………。"},
        { "location": "777/TALK"    , "narrator": "神楽", "text": "じゃあ、お願いです。\n私の質問に、答えて\nもらえますか？"},
        { "location": "779/TALK"    , "narrator": "つばめ", "text": "う、うん…。\n質問って？"},
        { "location": "780/TALK"    , "narrator": "神楽", "text": "…つばめさんは今、\n母親を人質に\n取られています。"},
        { "location": "781/TALK"    , "narrator": "神楽", "text": "強盗は母親に拳銃を\n突きつけながら――"},
        { "location": "782/TALK"    , "narrator": "神楽", "text": "「お前の持っている\n包丁で父親を殺せ。さ\nもなくば母親を撃つ」"},
        { "location": "784/TALK"    , "narrator": "神楽", "text": "そう言っています。\nつばめさんは、\nどうしますか？"},
        { "location": "786/TALK"    , "narrator": "つばめ", "text": "えぇっ！？\nそ、そんなの、\n決められないよ…。"},
        { "location": "787/TALK"    , "narrator": "神楽", "text": "ダメです。\n答えてください。"},
        { "location": "788/TALK"    , "narrator": "神楽", "text": "誰かとWAVEで\n相談しても\nいいですから…。"},
        { "location": "790/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "804/TALK"    , "narrator": "つばめ", "text": "卯月さんの質問"},
        { "location": "805/TALK"    , "narrator": "つばめ", "text": "聞ぃてた？"},
        { "location": "806/TALK"    , "narrator": "つばめ", "text": "ぉ母さんを人質に取られてて"},
        { "location": "807/TALK"    , "narrator": "つばめ", "text": "「ぉ前の持ってぃる包丁で父親を殺せ。さもなくば母親を撃つ」"},
        { "location": "808/TALK"    , "narrator": "つばめ", "text": "って言われたら"},
        { "location": "809/TALK"    , "narrator": "つばめ", "text": "どぅするのが正しぃんだろ？"},
        { "location": "811/SEL"     , "narrator": "", "text": "正解のない問題だね"},
        { "location": "812/ACT"     , "narrator": "", "text": "正解のない問題だね"},
        { "location": "814/TALK"    , "narrator": "つばめ", "text": "だから困ってるの"},
        { "location": "815/TALK"    , "narrator": "つばめ", "text": "本当にどっちかが死ぬわけじゃなぃけど"},
        { "location": "816/TALK"    , "narrator": "つばめ", "text": "私には選べなぃ"},
        { "location": "817/TALK"    , "narrator": "つばめ", "text": "$handle$さんだったら"},
        { "location": "818/TALK"    , "narrator": "つばめ", "text": "どぅする？"},
        { "location": "820/SEL"     , "narrator": "", "text": "父親を殺す"},
        { "location": "821/SEL"     , "narrator": "", "text": "母親を見殺しにする"},
        { "location": "822/SEL"     , "narrator": "", "text": "いつまでに選べと言われてないから１年待って！"},
        { "location": "823/ACT"     , "narrator": "", "text": "父親を殺す"},
        { "location": "836/TALK"    , "narrator": "つばめ", "text": "…何も言わないで、\n閉じちゃった。"},
        { "location": "837/TALK"    , "narrator": "つばめ", "text": "でも、お礼を言うのも\n変な感じだし…。"},
        { "location": "838/TALK"    , "narrator": "神楽", "text": "選びましたか？"},
        { "location": "841/TALK"    , "narrator": "つばめ", "text": "…わたしは…\nお父さんを、\n刺すと思う…。"},
        { "location": "845/TALK"    , "narrator": "神楽", "text": "…そうですか。\nなるほど…。"},
        { "location": "847/TALK"    , "narrator": "神楽", "text": "つばめさんは、\n性的に満足して\nいないんですね。"},
        { "location": "849/TALK"    , "narrator": "つばめ", "text": "えっ！？"},
        { "location": "850/TALK"    , "narrator": "神楽", "text": "でも、潜在的には\n凄く求めています。\n人が恋しいんです。"},
        { "location": "851/TALK"    , "narrator": "神楽", "text": "それと、夜はすごく\n積極的なはずです\nから――"},
        { "location": "853/TALK"    , "narrator": "神楽", "text": "恋人を作れば、\n満たされると\n思いますよ。"},
        { "location": "856/TALK"    , "narrator": "つばめ", "text": "え？　え！？\nあ、あの、それって\nどういう…。"},
        { "location": "857/ACT"     , "narrator": "", "text": "母親を見殺しにする"},
        { "location": "868/TALK"    , "narrator": "つばめ", "text": "…何も言わないで、\n閉じちゃった。"},
        { "location": "869/TALK"    , "narrator": "つばめ", "text": "でも、お礼を言うのも\n変な感じだし…。"},
        { "location": "870/TALK"    , "narrator": "神楽", "text": "選びましたか？"},
        { "location": "873/TALK"    , "narrator": "つばめ", "text": "…わたしは…多分、\nお父さんを刺すなんて\nできないと思う…。"},
        { "location": "877/TALK"    , "narrator": "神楽", "text": "…そうですか。\nなるほど…。"},
        { "location": "879/TALK"    , "narrator": "神楽", "text": "つばめさんは、\n受け身タイプ\nなんですね。"},
        { "location": "880/TALK"    , "narrator": "つばめ", "text": "え？"},
        { "location": "881/TALK"    , "narrator": "神楽", "text": "夜はちゃんとエスコー\nトしてくれる異性を\n選ぶのがいいです。"},
        { "location": "882/TALK"    , "narrator": "神楽", "text": "でもその奥手さは――"},
        { "location": "884/TALK"    , "narrator": "神楽", "text": "何かをきっかけに\n爆発してひっくり返る\nかもしれませんよ。"},
        { "location": "886/TALK"    , "narrator": "つばめ", "text": "え？　え！？\nあ、あの、それって\nどういう…。"},
        { "location": "887/ACT"     , "narrator": "", "text": "いつまでに選べと言われてないから１年待って！"},
        { "location": "888/TALK"    , "narrator": "つばめ", "text": "その答えって"},
        { "location": "889/TALK"    , "narrator": "つばめ", "text": "ありなのかな？"},
        { "location": "901/TALK"    , "narrator": "つばめ", "text": "うーん…。"},
        { "location": "902/TALK"    , "narrator": "神楽", "text": "選びましたか？"},
        { "location": "903/TALK"    , "narrator": "つばめ", "text": "…期限はないん\nだよね？"},
        { "location": "904/TALK"    , "narrator": "神楽", "text": "…？\nどういうことですか？"},
        { "location": "905/TALK"    , "narrator": "つばめ", "text": "あのね、いつまでに\n選べ、とは言われて\nないから――"},
        { "location": "906/TALK"    , "narrator": "つばめ", "text": "答えるの、１年くらい\n待ってもらえないか\nなぁ、って…。"},
        { "location": "907/TALK"    , "narrator": "神楽", "text": "…………。"},
        { "location": "910/TALK"    , "narrator": "神楽", "text": "…そうですか。\nなるほど…。"},
        { "location": "911/TALK"    , "narrator": "神楽", "text": "つばめさん、\nこの世界に絶望して\nいますね？"},
        { "location": "913/TALK"    , "narrator": "つばめ", "text": "えっ、絶望！？"},
        { "location": "914/TALK"    , "narrator": "神楽", "text": "はい。全ての人が\nいなくなればいい、\nと思っています。"},
        { "location": "915/TALK"    , "narrator": "神楽", "text": "だから、つばめさんは\n恋人を作ってはいけま\nせん。"},
        { "location": "917/TALK"    , "narrator": "神楽", "text": "不幸にしてしまい\nますよ。"},
        { "location": "918/TALK"    , "narrator": "つばめ", "text": "え？　え！？\nあ、あの、それって\nどういう…。"},
        { "location": "924/TALK"    , "narrator": "神楽", "text": "…なーんて、\nビックリしました？"},
        { "location": "944/TALK"    , "narrator": "神楽", "text": "ちょっとした\n心理テストですよ。"},
        { "location": "946/TALK"    , "narrator": "つばめ", "text": "な、なーんだぁ。\nビックリしちゃった\nよ。"},
        { "location": "947/TALK"    , "narrator": "神楽", "text": "ふふ、さっきスマホで\n見てたサイトに、\n書いてあったんです。"},
        { "location": "948/TALK"    , "narrator": "つばめ", "text": "ふーん…卯月さんは\n何を選んだの？"},
        { "location": "949/TALK"    , "narrator": "神楽", "text": "…気になりますか？"},
        { "location": "951/TALK"    , "narrator": "つばめ", "text": "うん！\n教えてほしいな。"},
        { "location": "954/TALK"    , "narrator": "神楽", "text": "う～ん…やっぱり、\nヒミツです。"},
        { "location": "955/TALK"    , "narrator": "つばめ", "text": "えー、ズルイよー。"},
        { "location": "957/TALK"    , "narrator": "神楽", "text": "ふふっ…。"},
        { "location": "959/TALK"    , "narrator": "アーヤ", "text": "あっ、いたわ！\nほら、あそこ！"},
        { "location": "961/TALK"    , "narrator": "ガブリエラ", "text": "ちょっと、神楽！"},
        { "location": "965/TALK"    , "narrator": "ガブリエラ", "text": "やっと見つけた！\nこんなところに\nいたのね？"},
        { "location": "968/TALK"    , "narrator": "アーヤ", "text": "急にいなくなる\nなんて…。\n何かあったの？"},
        { "location": "971/TALK"    , "narrator": "神楽", "text": "あ、いえ…、\nそういうわけじゃ\nなくて…。"},
        { "location": "974/TALK"    , "narrator": "真幌", "text": "ならば一言くらい\n言ってからにしろ。"},
        { "location": "975/TALK"    , "narrator": "真幌", "text": "何も言わずに消える\n奴があるか？"},
        { "location": "979/TALK"    , "narrator": "みやび", "text": "ほんと、\n探し疲れで足が\n棒になったがよ。"},
        { "location": "980/TALK"    , "narrator": "みやび", "text": "みやびさん専用\n１８０分足揉み券で\n許しちゃるぞね。"},
        { "location": "982/TALK"    , "narrator": "神楽", "text": "本当、ごめんなさい。\nご心配をおかけして。"},
        { "location": "983/TALK"    , "narrator": "真幌", "text": "まあ、何事もなかった\nようで一安心だ。"},
        { "location": "985/TALK"    , "narrator": "真幌", "text": "さあ、劇場へ戻るぞ。\n卯月も食事はまだ\nだろう？"},
        { "location": "988/TALK"    , "narrator": "神楽", "text": "はい。\nもうお腹ペコペコ\nです。"},
        { "location": "991/TALK"    , "narrator": "ガブリエラ", "text": "何言ってんのよ。\n劇場飛び出したのは\nあんたじゃない…。"},
        { "location": "993/TALK"    , "narrator": "つばめ", "text": "…よかった。\n卯月さん、元気に\nなったみたい。"},
        { "location": "995/TALK"    , "narrator": "つばめ", "text": "でも…こんなところで\n何してたのかな…？"},
        { "location": "1006/DIALOG" , "narrator": "Dialog_chapter_ch01", "text": "【08 HANABI】"}
    ]
}
