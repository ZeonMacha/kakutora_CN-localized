    "entry":
    [
        { "location": "12/TALK" , "narrator": "みやび", "text": "ひまー"},
        { "location": "13/TALK" , "narrator": "みやび", "text": "ひまひまひままー"},
        { "location": "14/TALK" , "narrator": "みやび", "text": "世の中つまらぬことだらけ"},
        { "location": "24/SEL"  , "narrator": "（選択肢）", "text": "それを人は平和という"},
        { "location": "25/SEL"  , "narrator": "（選択肢）", "text": "なんて格好してるの！？"},
        { "location": "26/ACT"  , "narrator": "", "text": "それを人は平和という"},
        { "location": "27/TALK" , "narrator": "みやび", "text": "なるほど納得"},
        { "location": "28/TALK" , "narrator": "みやび", "text": "平和とは暇なこと"},
        { "location": "29/TALK" , "narrator": "みやび", "text": "そして行き過ぎた平和は人を堕落させる"},
        { "location": "30/TALK" , "narrator": "みやび", "text": "由々しき事態である"},
        { "location": "31/ACT"  , "narrator": "", "text": "なんて格好してるの！？"},
        { "location": "33/TALK" , "narrator": "みやび", "text": "別に普通だが何か？"},
        { "location": "34/TALK" , "narrator": "みやび", "text": "部屋ではリラックススタイルがうちのジャスティス"},
        { "location": "35/TALK" , "narrator": "みやび", "text": "それが何か問題か？"},
        { "location": "38/SEL"  , "narrator": "（選択肢）", "text": "色々見えそうなんだけど…"},
        { "location": "39/SEL"  , "narrator": "（選択肢）", "text": "女の子がはしたない！"},
        { "location": "40/SEL"  , "narrator": "（選択肢）", "text": "ちょっと身体を動かしてみて"},
        { "location": "41/ACT"  , "narrator": "", "text": "色々見えそうなんだけど…"},
        { "location": "42/TALK" , "narrator": "みやび", "text": "見えそうイコール見えないということ"},
        { "location": "43/TALK" , "narrator": "みやび", "text": "いくら部屋でも"},
        { "location": "45/TALK" , "narrator": "みやび", "text": "丸出し厳禁！"},
        { "location": "46/TALK" , "narrator": "みやび", "text": "常識人のうち！"},
        { "location": "49/ACT"  , "narrator": "", "text": "女の子がはしたない！"},
        { "location": "50/TALK" , "narrator": "みやび", "text": "おまえが言うな案件発生"},
        { "location": "51/TALK" , "narrator": "みやび", "text": "お年頃の乙女の部屋を当然のように覗いている貴様が何を言う！？"},
        { "location": "53/TALK" , "narrator": "みやび", "text": "まあ"},
        { "location": "54/TALK" , "narrator": "みやび", "text": "話しかけたのはうちだが"},
        { "location": "56/TALK" , "narrator": "みやび", "text": "乙女はワガママで気まぐれが許される生き物なのである"},
        { "location": "57/TALK" , "narrator": "みやび", "text": "故に悪いのはそっち"},
        { "location": "58/TALK" , "narrator": "みやび", "text": "うちは無罪ではしたなくもない"},
        { "location": "59/ACT"  , "narrator": "", "text": "ちょっと身体を動かしてみて"},
        { "location": "62/TALK" , "narrator": "みやび", "text": "よし"},
        { "location": "64/TALK" , "narrator": "みやび", "text": "では指をチャット終了ボタンの上へ動かしてみよう"},
        { "location": "71/TALK" , "narrator": "みやび", "text": "しかしいつも思うのだが"},
        { "location": "72/TALK" , "narrator": "みやび", "text": "この体制でのタブレットは見難くて堪らん"},
        { "location": "73/TALK" , "narrator": "みやび", "text": "うちの視界を邪魔するのは"},
        { "location": "74/TALK" , "narrator": "みやび", "text": "憎き二つの脂肪の塊"},
        { "location": "75/TALK" , "narrator": "みやび", "text": "ジャストな体制はないだろうか？"},
        { "location": "76/SEL"  , "narrator": "（選択肢）", "text": "足を開いてみるといいかも"},
        { "location": "77/SEL"  , "narrator": "（選択肢）", "text": "ていうか下着くらい付けようよ"},
        { "location": "78/SEL"  , "narrator": "（選択肢）", "text": "こちらとしては良い景色"},
        { "location": "79/ACT"  , "narrator": "", "text": "足を開いてみるといいかも"},
        { "location": "80/TALK" , "narrator": "みやび", "text": "足を開くとどうなるか？"},
        { "location": "81/TALK" , "narrator": "みやび", "text": "支えを失いタブレットが倒れる"},
        { "location": "84/TALK" , "narrator": "みやび", "text": "相棒はバカか？"},
        { "location": "85/TALK" , "narrator": "みやび", "text": "万有引力を知らぬ星からやって来た宇宙人か？"},
        { "location": "86/ACT"  , "narrator": "", "text": "ていうか下着くらい付けようよ"},
        { "location": "87/TALK" , "narrator": "みやび", "text": "女のリラックスというのは"},
        { "location": "88/TALK" , "narrator": "みやび", "text": "肉体を下着から解放することから始まる"},
        { "location": "89/TALK" , "narrator": "みやび", "text": "胸に跡が付くほど締め付ける金具入りのブラジャー"},
        { "location": "90/TALK" , "narrator": "みやび", "text": "腰回りに跡が付くほどゴムの強い脱ぐとクシャっとなるショーツ"},
        { "location": "91/TALK" , "narrator": "みやび", "text": "どっちも拘束具並みにうちを締め付けて苦しめる"},
        { "location": "93/TALK" , "narrator": "みやび", "text": "白い悪魔と呼ぼう"},
        { "location": "95/TALK" , "narrator": "みやび", "text": "日によっては黒やベージュや薄ピンクにも変化する"},
        { "location": "96/TALK" , "narrator": "みやび", "text": "赤はない"},
        { "location": "97/ACT"  , "narrator": "", "text": "こちらとしては良い景色"},
        { "location": "98/TALK" , "narrator": "みやび", "text": "いい趣味やね"},
        { "location": "100/TALK", "narrator": "みやび", "text": "うちのタブレットは最新故に"},
        { "location": "101/TALK", "narrator": "みやび", "text": "背面を見てるだけでも幸せになるのはわかるぞね"},
        { "location": "102/SEL" , "narrator": "（選択肢）", "text": "そういうことじゃなくて"},
        { "location": "103/ACT" , "narrator": "", "text": "そういうことじゃなくて"},
        { "location": "105/TALK", "narrator": "みやび", "text": "相棒はタブレット背面フェチ"},
        { "location": "106/TALK", "narrator": "みやび", "text": "脳内に保存済みやき"},
        { "location": "107/TALK", "narrator": "みやび", "text": "変更も上書き保存も不可能や"},
        { "location": "111/TALK", "narrator": "みやび", "text": "さて暇つぶしも飽きた"},
        { "location": "112/TALK", "narrator": "みやび", "text": "そろそろ食事にする"},
        { "location": "114/TALK", "narrator": "みやび", "text": "つまりさらばである"},
        { "location": "120/TALK", "narrator": "みやび", "text": "とにかく今のうちは退屈モード"},
        { "location": "121/TALK", "narrator": "みやび", "text": "ネットという最大の友がうちを楽しませてくれん今"},
        { "location": "122/TALK", "narrator": "みやび", "text": "頼りになるのは相棒だけや"},
        { "location": "123/TALK", "narrator": "みやび", "text": "ヘルプミーミー"},
        { "location": "124/SEL" , "narrator": "（選択肢）", "text": "ていうか、なんて格好してるんだ！？"},
        { "location": "125/SEL" , "narrator": "（選択肢）", "text": "乙女よネット世界を捨て街へ出よう"},
        { "location": "126/ACT" , "narrator": "", "text": "ていうか、なんて格好してるんだ！？"},
        { "location": "128/ACT" , "narrator": "", "text": "乙女よネット世界を捨て街へ出よう"},
        { "location": "129/TALK", "narrator": "みやび", "text": "街が来いとうちは言いたい"},
        { "location": "130/TALK", "narrator": "みやび", "text": "部屋にいながら街に出たい"},
        { "location": "131/TALK", "narrator": "みやび", "text": "何故なら外出は面倒だから"},
        { "location": "132/TALK", "narrator": "みやび", "text": "となるともうあれや"},
        { "location": "133/TALK", "narrator": "みやび", "text": "うちはネトゲの街へ旅立とう"},
        { "location": "134/TALK", "narrator": "みやび", "text": "相棒を捨てネトゲの街へ旅立つぞね"},
        { "location": "137/TALK", "narrator": "みやび", "text": "さらば"}
    ]
}
