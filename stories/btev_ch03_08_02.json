        "title": "015 ココロスフィアストーリー【Lv05】",
        "sub_title": "母とは何たるか＜帰結＞"
    },
    "entry":
    [
        { "location": "301/TALK"  , "narrator": "ガブリエラ", "text": "……！？"},
        { "location": "302/SEL"   , "narrator": "（選択肢）", "text": "どう？落ち着いた？"},
        { "location": "303/ACT"   , "narrator": "", "text": "どう？落ち着いた？"},
        { "location": "305/TALK"  , "narrator": "ガブリエラ", "text": "え、ええ…"},
        { "location": "306/SEL"   , "narrator": "（選択肢）", "text": "良かった"},
        { "location": "307/SEL"   , "narrator": "（選択肢）", "text": "すごいことしたね"},
        { "location": "308/ACT"   , "narrator": "", "text": "良かった"},
        { "location": "309/TALK"  , "narrator": "ガブリエラ", "text": "ありがと…"},
        { "location": "310/ACT"   , "narrator": "", "text": "すごいことしたね"},
        { "location": "311/TALK"  , "narrator": "ガブリエラ", "text": "ご、ごめん…なさい。"},
        { "location": "312/SEL"   , "narrator": "（選択肢）", "text": "ココロスフィアの中で良かったよ"},
        { "location": "313/SEL"   , "narrator": "（選択肢）", "text": "ガブリエラが素直に謝った！？"},
        { "location": "314/ACT"   , "narrator": "", "text": "ココロスフィアの中で良かったよ"},
        { "location": "315/TALK"  , "narrator": "ガブリエラ", "text": "さすがに現実では\nやらないわよ。"},
        { "location": "316/TALK"  , "narrator": "ガブリエラ", "text": "ココロの中には\n何十、何百にも重なる\nフィルターがあるもの。"},
        { "location": "317/TALK"  , "narrator": "ガブリエラ", "text": "それが無くなるくらい\nココロが壊れなければ\n１００％やらないわ。"},
        { "location": "318/ACT"   , "narrator": "", "text": "ガブリエラが素直に謝った！？"},
        { "location": "320/TALK"  , "narrator": "ガブリエラ", "text": "ちょっ！！\nなによそれ！"},
        { "location": "321/TALK"  , "narrator": "ガブリエラ", "text": "まるであたしが\nツンデレみたい\nじゃない！"},
        { "location": "322/SEL"   , "narrator": "（選択肢）", "text": "え？違うと思ってるの！？"},
        { "location": "323/SEL"   , "narrator": "（選択肢）", "text": "意味が分かりません"},
        { "location": "324/ACT"   , "narrator": "", "text": "え？違うと思ってるの！？"},
        { "location": "325/TALK"  , "narrator": "ガブリエラ", "text": "違うに\n決まってるでしょ！"},
        { "location": "326/SEL"   , "narrator": "（選択肢）", "text": "さすがツンデレ。感動した"},
        { "location": "327/ACT"   , "narrator": "", "text": "さすがツンデレ。感動した"},
        { "location": "329/TALK"  , "narrator": "ガブリエラ", "text": "はぁ…もういいわ。\n話が全然\n前に進まないじゃない。"},
        { "location": "330/ACT"   , "narrator": "", "text": "意味が分かりません"},
        { "location": "331/TALK"  , "narrator": "ガブリエラ", "text": "頭悪いわね。"},
        { "location": "332/TALK"  , "narrator": "ガブリエラ", "text": "素直に謝らないのは\nツンデレでしょ？"},
        { "location": "333/TALK"  , "narrator": "ガブリエラ", "text": "あたしはそんなこと\n無いから、ツンデレじゃ\nないって言ってるのよ。"},
        { "location": "334/TALK"  , "narrator": "ガブリエラ", "text": "はぁ…もういいわ。\n話が全然\n前に進まないじゃない。"},
        { "location": "338/TALK"  , "narrator": "ガブリエラ", "text": "でも、どうして急に\nあんなことを\nしちゃったのかしら。"},
        { "location": "339/SEL"   , "narrator": "（選択肢）", "text": "ガブリエラのお母さんって本当はどんな人だったの？"},
        { "location": "340/SEL"   , "narrator": "（選択肢）", "text": "ガブリエラのお母さんって強盗に殺されたんだっけ？"},
        { "location": "341/ACT"   , "narrator": "", "text": "ガブリエラのお母さんって本当はどんな人だったの？"},
        { "location": "342/TALK"  , "narrator": "ガブリエラ", "text": "あたしの\nお母さん……？"},
        { "location": "343/TALK"  , "narrator": "ガブリエラ", "text": "……正直、\nあまり覚えてないの。"},
        { "location": "344/TALK"  , "narrator": "ガブリエラ", "text": "殺されたの、\n初等部の頃だったし。"},
        { "location": "345/SEL"   , "narrator": "（選択肢）", "text": "ショックだったよね"},
        { "location": "346/SEL"   , "narrator": "（選択肢）", "text": "初等部の頃だったら普通覚えてるのでは？"},
        { "location": "347/ACT"   , "narrator": "", "text": "ショックだったよね"},
        { "location": "348/TALK"  , "narrator": "ガブリエラ", "text": "…だったと思う。\nそれすらもあまり\n覚えてないから。"},
        { "location": "349/ACT"   , "narrator": "", "text": "初等部の頃だったら普通覚えてるのでは？"},
        { "location": "351/TALK"  , "narrator": "ガブリエラ", "text": "普通！？\n普通って何よ。"},
        { "location": "352/TALK"  , "narrator": "ガブリエラ", "text": "そんなの人によって\n全然違うでしょ。"},
        { "location": "353/TALK"  , "narrator": "ガブリエラ", "text": "憶測で普通とか常識とか\n決めつけないで欲しいわ。\nそういうの嫌い。"},
        { "location": "355/ACT"   , "narrator": "", "text": "ガブリエラのお母さんって強盗に殺されたんだっけ？"},
        { "location": "356/TALK"  , "narrator": "ガブリエラ", "text": "ええ、そうよ。"},
        { "location": "357/SEL"   , "narrator": "（選択肢）", "text": "なんで殺されたの？身代金拒否したとか？"},
        { "location": "358/SEL"   , "narrator": "（選択肢）", "text": "どんな風に？"},
        { "location": "359/ACT"   , "narrator": "", "text": "なんで殺されたの？身代金拒否したとか？"},
        { "location": "360/TALK"  , "narrator": "ガブリエラ", "text": "まさか。\n命より大切なものなんて\n無いわよ。"},
        { "location": "361/ACT"   , "narrator": "", "text": "どんな風に？"},
        { "location": "362/TALK"  , "narrator": "ガブリエラ", "text": "え？\nそれは……"},
        { "location": "363/TALK"  , "narrator": "ガブリエラ", "text": "どんな風だったかしら。\nあまり覚えてないわね。"},
        { "location": "364/SEL"   , "narrator": "（選択肢）", "text": "随分冷静だね"},
        { "location": "365/SEL"   , "narrator": "（選択肢）", "text": "ショックで忘れちゃったんだね"},
        { "location": "366/ACT"   , "narrator": "", "text": "随分冷静だね"},
        { "location": "367/TALK"  , "narrator": "ガブリエラ", "text": "そんなことないわよ。\nただ、全然実感湧かない\nっていうか――"},
        { "location": "368/TALK"  , "narrator": "ガブリエラ", "text": "本当に、その時の事を\n覚えていないのよね。"},
        { "location": "369/ACT"   , "narrator": "", "text": "ショックで忘れちゃったんだね"},
        { "location": "370/TALK"  , "narrator": "ガブリエラ", "text": "多分、そうだと思う。\n本当に全然\n覚えていないんだもの。"},
        { "location": "374/TALK"  , "narrator": "ガブリエラ", "text": "とにかく。"},
        { "location": "375/TALK"  , "narrator": "ガブリエラ", "text": "あたしはお母さんのことが\n知りたいのよ。"},
        { "location": "376/TALK"  , "narrator": "ガブリエラ", "text": "だから片っ端から\n心当たりを探っていたん\nだけど、みんな違ったわ。"},
        { "location": "377/SEL"   , "narrator": "（選択肢）", "text": "でも違うからって銃で撃たなくても…"},
        { "location": "378/ACT"   , "narrator": "", "text": "でも違うからって銃で撃たなくても…"},
        { "location": "380/TALK"  , "narrator": "ガブリエラ", "text": "うーん、そうね。\nなんであんな行動に\n出たのかはわからない。"},
        { "location": "381/TALK"  , "narrator": "ガブリエラ", "text": "でも、そこにも何か\n理由があるんだと\n思うのよね。"},
        { "location": "382/SEL"   , "narrator": "（選択肢）", "text": "まあ、ココロの中だしね"},
        { "location": "383/ACT"   , "narrator": "", "text": "まあ、ココロの中だしね"},
        { "location": "385/TALK"  , "narrator": "ガブリエラ", "text": "ええ。"},
        { "location": "387/TALK"  , "narrator": "ガブリエラ", "text": "はぁ……。\nあたしのお母さんって\nどんな人だったのかしら。"},
        { "location": "388/TALK"  , "narrator": "潜在ガブリエラ", "text": "その答えは\nあたしが知ってるわよ。"},
        { "location": "407/TALK"  , "narrator": "ガブリエラ", "text": "！？\nあんたは？"},
        { "location": "408/TALK"  , "narrator": "潜在ガブリエラ", "text": "あたしは、\n潜在意識に相当する区域に\n生息するあたし。"},
        { "location": "409/TALK"  , "narrator": "潜在ガブリエラ", "text": "今あんたが知りたい\n記憶の間近にいる。"},
        { "location": "410/TALK"  , "narrator": "潜在ガブリエラ", "text": "お母さんのこと。\n知りたければ一緒に来て。"},
        { "location": "412/TALK"  , "narrator": "ガブリエラ", "text": "あ、ちょっと待って！"},
        { "location": "432/TALK"  , "narrator": "ガブリエラ", "text": "……ここは？"},
        { "location": "433/SEL"   , "narrator": "（選択肢）", "text": "ここって確か…"},
        { "location": "434/ACT"   , "narrator": "", "text": "ここって確か…"},
        { "location": "436/TALK"  , "narrator": "潜在ガブリエラ", "text": "あんたが知りたい情報は\nこの中にある。"},
        { "location": "437/TALK"  , "narrator": "潜在ガブリエラ", "text": "けど――"},
        { "location": "446/TALK"  , "narrator": "ガブリエラ", "text": "ひっ！！"},
        { "location": "447/SEL"   , "narrator": "（選択肢）", "text": "やっぱり！\nまずい！"},
        { "location": "448/ACT"   , "narrator": "", "text": "やっぱり！\nまずい！"},
        { "location": "450/TALK"  , "narrator": "？？？", "text": "そのまえに\nあんたは\nきえる"},
        { "location": "451/TALK"  , "narrator": "ガブリエラ", "text": "ここって、まさか！"},
        { "location": "452/SEL"   , "narrator": "（選択肢）", "text": "ガブリエラ逃げろ！"},
        { "location": "453/ACT"   , "narrator": "", "text": "ガブリエラ逃げろ！"},
        { "location": "460/DIALOG", "narrator": "", "text": "\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n                      To be continued…"}
    ]
}
