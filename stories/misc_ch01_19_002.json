        { "location": "89/SCENARIO", "narrator": "", "text": "029_彗星奇譚"},
        { "location": "116/TALK"   , "narrator": "つばめ", "text": "この辺りはね"},
        { "location": "117/TALK"   , "narrator": "つばめ", "text": "東京より空がきれいに見えるょ"},
        { "location": "118/TALK"   , "narrator": "つばめ", "text": "だから星もぃっぱぃ見えるの(*´︶`*)"},
        { "location": "120/SEL"    , "narrator": "", "text": "星座は憶えた？"},
        { "location": "121/SEL"    , "narrator": "", "text": "田舎なんだね"},
        { "location": "122/SEL"    , "narrator": "", "text": "二人で流れ星に願いを掛けよう"},
        { "location": "123/ACT"    , "narrator": "", "text": "星座は憶えた？"},
        { "location": "124/TALK"   , "narrator": "つばめ", "text": "そぅいうのは"},
        { "location": "126/TALK"   , "narrator": "つばめ", "text": "考えてなかった"},
        { "location": "127/ACT"    , "narrator": "", "text": "田舎なんだね"},
        { "location": "128/TALK"   , "narrator": "つばめ", "text": "ひどぃ(´ｪ｀；)三(；´ｪ｀)"},
        { "location": "129/TALK"   , "narrator": "つばめ", "text": "そんな言い方ヽ(；▽；)ノ"},
        { "location": "130/ACT"    , "narrator": "", "text": "二人で流れ星に願いを掛けよう"},
        { "location": "132/TALK"   , "narrator": "つばめ", "text": "ガブちゃんが喜びそう"},
        { "location": "133/TALK"   , "narrator": "つばめ", "text": "なんて"},
        { "location": "134/TALK"   , "narrator": "つばめ", "text": "ぁたしもちょっと嬉しぃけど"},
        { "location": "136/TALK"   , "narrator": "つばめ", "text": "それで"},
        { "location": "137/TALK"   , "narrator": "つばめ", "text": "なんかね"},
        { "location": "138/TALK"   , "narrator": "つばめ", "text": "ちょっとだけおうちを思い出すの"},
        { "location": "140/SEL"    , "narrator": "", "text": "ホームシックかな"},
        { "location": "141/SEL"    , "narrator": "", "text": "お父さんに連絡してる？"},
        { "location": "142/SEL"    , "narrator": "", "text": "寂しい時はいつでも呼んで"},
        { "location": "143/ACT"    , "narrator": "", "text": "ホームシックかな"},
        { "location": "144/TALK"   , "narrator": "つばめ", "text": "そぅ"},
        { "location": "145/TALK"   , "narrator": "つばめ", "text": "なのかな？"},
        { "location": "146/TALK"   , "narrator": "つばめ", "text": "なんだかょくわかんなぃ"},
        { "location": "148/TALK"   , "narrator": "つばめ", "text": "でも多分違うかな"},
        { "location": "149/ACT"    , "narrator": "", "text": "お父さんに連絡してる？"},
        { "location": "150/TALK"   , "narrator": "つばめ", "text": "してるょーヾ(｡>﹏<｡)ﾉﾞ"},
        { "location": "151/TALK"   , "narrator": "つばめ", "text": "時々だけど(・ω<) ﾃﾍﾍﾟﾛ"},
        { "location": "152/TALK"   , "narrator": "つばめ", "text": "ちゃんとしなくちゃね"},
        { "location": "153/ACT"    , "narrator": "", "text": "寂しい時はいつでも呼んで"},
        { "location": "155/TALK"   , "narrator": "つばめ", "text": "寂しいわけじゃないんだょ"},
        { "location": "156/TALK"   , "narrator": "つばめ", "text": "単に思い出すってだけなの"},
        { "location": "157/TALK"   , "narrator": "つばめ", "text": "でも"},
        { "location": "158/TALK"   , "narrator": "つばめ", "text": "寂しい時は"},
        { "location": "159/TALK"   , "narrator": "つばめ", "text": "お願いするょうにするね"}
    ]
