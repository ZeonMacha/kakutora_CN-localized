        { "location": "2827/TALK"  , "narrator": "ガブリエラ", "text": "でも確かに、\nこんな時間も\n悪くないかも…。"},
        { "location": "2828/ACT"   , "narrator": "", "text": "神楽に声を掛ける"},
        { "location": "2840/TALK"  , "narrator": "神楽", "text": "ヤッホー"},
        { "location": "2841/SEL"   , "narrator": "", "text": "これはもうあれしかないよ"},
        { "location": "2842/ACT"   , "narrator": "", "text": "これはもうあれしかないよ"},
        { "location": "2843/TALK"  , "narrator": "神楽", "text": "あれって何ぴょん"},
        { "location": "2845/SEL"   , "narrator": "", "text": "悪の組織が出現"},
        { "location": "2846/SEL"   , "narrator": "", "text": "メンインブラック登場"},
        { "location": "2847/SEL"   , "narrator": "", "text": "スルーして$me$と遊ぶ"},
        { "location": "2848/ACT"   , "narrator": "", "text": "悪の組織が出現"},
        { "location": "2849/TALK"  , "narrator": "神楽", "text": "唐突すぎ"},
        { "location": "2850/ACT"   , "narrator": "", "text": "メンインブラック登場"},
        { "location": "2851/TALK"  , "narrator": "神楽", "text": "ここ日本なんだけど"},
        { "location": "2852/ACT"   , "narrator": "", "text": "スルーして$me$と遊ぶ"},
        { "location": "2853/TALK"  , "narrator": "神楽", "text": "それがいいぴょん♪"},
        { "location": "2854/TALK"  , "narrator": "神楽", "text": "って"},
        { "location": "2855/TALK"  , "narrator": "神楽", "text": "そうはいかないから～"},
        { "location": "2857/TALK"  , "narrator": "神楽", "text": "普段フェノメノン相手にしてるから"},
        { "location": "2858/TALK"  , "narrator": "神楽", "text": "ちょっと感覚がずれてきてるのかも"},
        { "location": "2860/SEL"   , "narrator": "", "text": "それはあるね"},
        { "location": "2861/SEL"   , "narrator": "", "text": "元々そういう性格なんじゃない？"},
        { "location": "2862/SEL"   , "narrator": "", "text": "神楽も無理しないで"},
        { "location": "2863/ACT"   , "narrator": "", "text": "それはあるね"},
        { "location": "2865/TALK"  , "narrator": "神楽", "text": "そうはなりたくないわー"},
        { "location": "2866/TALK"  , "narrator": "神楽", "text": "でもそうなってるのかも、、、"},
        { "location": "2867/ACT"   , "narrator": "", "text": "元々そういう性格なんじゃない？"},
        { "location": "2868/TALK"  , "narrator": "神楽", "text": "あーまーね"},
        { "location": "2869/TALK"  , "narrator": "神楽", "text": "そうじゃないとハッカーとかならない"},
        { "location": "2870/TALK"  , "narrator": "神楽", "text": "適正な資質ってやつね"},
        { "location": "2871/ACT"   , "narrator": "", "text": "神楽も無理しないで"},
        { "location": "2872/TALK"  , "narrator": "神楽", "text": "やーんｱﾘｶﾞﾄ"},
        { "location": "2876/TALK"  , "narrator": "神楽", "text": "ぴょんこ本当はのんきに遊んでもいられないけど"},
        { "location": "2877/TALK"  , "narrator": "神楽", "text": "そういう時間もあっていいよね"},
        { "location": "2879/SEL"   , "narrator": "", "text": "もちろんだよ！"},
        { "location": "2880/SEL"   , "narrator": "", "text": "そのために$me$がいる"},
        { "location": "2881/SEL"   , "narrator": "", "text": "油断しすぎないように気を付けて"},
        { "location": "2882/ACT"   , "narrator": "", "text": "もちろんだよ！"},
        { "location": "2884/ACT"   , "narrator": "", "text": "そのために$me$がいる"},
        { "location": "2885/TALK"  , "narrator": "神楽", "text": "おっおっ"},
        { "location": "2886/TALK"  , "narrator": "神楽", "text": "いいねその自信"},
        { "location": "2887/TALK"  , "narrator": "神楽", "text": "惚れ直しちゃう★"},
        { "location": "2888/ACT"   , "narrator": "", "text": "油断しすぎないように気を付けて"},
        { "location": "2889/TALK"  , "narrator": "神楽", "text": "あーﾀﾞﾖﾈ"},
        { "location": "2890/TALK"  , "narrator": "神楽", "text": "がんばるぴょん、、、"},
        { "location": "2892/TALK"  , "narrator": "神楽", "text": "まあどうせみやびさんの発言もただの思いつきだし"},
        { "location": "2893/TALK"  , "narrator": "神楽", "text": "適当に返事しとくー"},
        { "location": "2895/SEL"   , "narrator": "", "text": "それがいいね"},
        { "location": "2896/SEL"   , "narrator": "", "text": "$me$ともっと話そうよ"},
        { "location": "2897/SEL"   , "narrator": "", "text": "休める時は休んで！"},
        { "location": "2898/ACT"   , "narrator": "", "text": "それがいいね"},
        { "location": "2899/TALK"  , "narrator": "神楽", "text": "ね～"},
        { "location": "2900/TALK"  , "narrator": "神楽", "text": "そうするぴょん、、、"},
        { "location": "2901/ACT"   , "narrator": "", "text": "$me$ともっと話そうよ"},
        { "location": "2902/TALK"  , "narrator": "神楽", "text": "一日そうしていたいぴょん"},
        { "location": "2903/TALK"  , "narrator": "神楽", "text": "本当ﾀﾞﾖ★"},
        { "location": "2904/ACT"   , "narrator": "", "text": "休める時は休んで！"},
        { "location": "2905/TALK"  , "narrator": "神楽", "text": "$handle$心配しすぎー"},
        { "location": "2906/TALK"  , "narrator": "神楽", "text": "でもｷｭﾝときたぴょん♪"},
        { "location": "2918/TALK"  , "narrator": "神楽", "text": "そういえば\nみやびさん。"},
        { "location": "2919/TALK"  , "narrator": "神楽", "text": "カプドラのイベント\nクリアしました？"},
        { "location": "2920/TALK"  , "narrator": "みやび", "text": "あーあったあった。\n今回はまだぞね。"},
        { "location": "2921/TALK"  , "narrator": "神楽", "text": "じゃあこれからみんなで\nクリアしに行きません？"},
        { "location": "2922/TALK"  , "narrator": "つばめ", "text": "賛成！"},
        { "location": "2923/TALK"  , "narrator": "ガブリエラ", "text": "まあ…\n参加するのは\n悪くないかしら……。"},
        { "location": "2924/TALK"  , "narrator": "神楽", "text": "ボーナスポイント\nいっぱいつくと\nいいですね。"},
        { "location": "2925/TALK"  , "narrator": "みやび", "text": "ほいたらうちが\n必勝法を……。"},
        { "location": "2946/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "2947/TALK"  , "narrator": "真幌", "text": "こんなところで\nどうしたんだ？"},
        { "location": "2952/TALK"  , "narrator": "真幌", "text": "あまり遠くまで\n出歩くのは\n関心せんな。"},
        { "location": "2954/TALK"  , "narrator": "神楽", "text": "真幌さん…、\nどうしてここに？"},
        { "location": "2955/TALK"  , "narrator": "真幌", "text": "みやびの家に戻る\n途中で、おまえの\n姿が見えてな。"},
        { "location": "2958/TALK"  , "narrator": "真幌", "text": "…大丈夫なのか？"},
        { "location": "2959/TALK"  , "narrator": "神楽", "text": "え？"},
        { "location": "2960/TALK"  , "narrator": "真幌", "text": "この前の一件から、\n落ち込んでいるよう\nだからな。"},
        { "location": "2961/TALK"  , "narrator": "神楽", "text": "…心配かけて\nごめんなさい。"},
        { "location": "2962/TALK"  , "narrator": "神楽", "text": "それと…メノウのこと\n黙っていて、\nごめんなさい。"},
        { "location": "2963/TALK"  , "narrator": "真幌", "text": "…いや、構わん。"},
        { "location": "2964/TALK"  , "narrator": "真幌", "text": "第一、任務に関係の\nないところまで。"},
        { "location": "2965/TALK"  , "narrator": "真幌", "text": "私に話す必要は\nないからな。"},
        { "location": "2966/TALK"  , "narrator": "真幌", "text": "おまえは、私の指示に\n従って、忠実に任務を\n全うしてくれている。"},
        { "location": "2967/TALK"  , "narrator": "真幌", "text": "役目を果たしている\n以上は、私からは\nなにも文句はない。"},
        { "location": "2969/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "2970/TALK"  , "narrator": "真幌", "text": "…そういえば、\n日向達がおまえのこと\n話してたぞ。"},
        { "location": "2972/TALK"  , "narrator": "神楽", "text": "…ひなこさん達が？"},
        { "location": "2973/TALK"  , "narrator": "真幌", "text": "ああ…、合宿の前から\n元気がなくて心配だ、\nってな。"},
        { "location": "2974/TALK"  , "narrator": "真幌", "text": "…あいつらには、\nメノウの正体が\nおまえなのを――"},
        { "location": "2976/TALK"  , "narrator": "神楽", "text": "話したんですかッ！？"},
        { "location": "2977/TALK"  , "narrator": "真幌", "text": "い、いや、\n話すわけないだろ。"},
        { "location": "2978/TALK"  , "narrator": "真幌", "text": "本人が隠している\n事情を言いふらす\nように思ったのか？"},
        { "location": "2980/TALK"  , "narrator": "神楽", "text": "あ…、ごめんなさい。"},
        { "location": "2981/TALK"  , "narrator": "真幌", "text": "…ずっと隠し続ける\nつもりなのか？"},
        { "location": "2983/TALK"  , "narrator": "神楽", "text": "できれば…。"},
        { "location": "2984/TALK"  , "narrator": "神楽", "text": "私は…メノウである\nことを知られるのが、\n怖いんです。"},
        { "location": "2985/TALK"  , "narrator": "神楽", "text": "ひなこさん達が、\n私を卯月神楽では\nなくて――"},
        { "location": "2986/TALK"  , "narrator": "神楽", "text": "フレイメノウとして\n見てくるように\nなったとしたら…。"},
        { "location": "2987/TALK"  , "narrator": "神楽", "text": "私は…、\nイヤだから…。"},
        { "location": "2988/TALK"  , "narrator": "真幌", "text": "…なるほど。"},
        { "location": "2989/TALK"  , "narrator": "真幌", "text": "逢瀬達と気まずく\nなっているのも、\nそれが理由か…？"},
        { "location": "2991/TALK"  , "narrator": "神楽", "text": "…ごめんなさい。\n真幌さんにまで\nご心配をおかけして。"},
        { "location": "2992/TALK"  , "narrator": "真幌", "text": "いや…、おまえの\n気持ちを聞けて\n安心したよ。"},
        { "location": "2993/TALK"  , "narrator": "真幌", "text": "おまえがメノウである\nという話は、\n他言無用だと。"},
        { "location": "2994/TALK"  , "narrator": "真幌", "text": "改めて私から\n逢瀬達に\n伝えておこう。"},
        { "location": "2997/TALK"  , "narrator": "神楽", "text": "はい…あの、\nありがとう\nございます…。"},
        { "location": "2998/TALK"  , "narrator": "神楽", "text": "話を聞いてくれて…。"},
        { "location": "2999/TALK"  , "narrator": "神楽", "text": "ちょっとだけ、\n気持ちが軽くなった\n気がします。"},
        { "location": "3000/TALK"  , "narrator": "真幌", "text": "話があるなら、\nいつでも聞くぞ。"},
        { "location": "3001/TALK"  , "narrator": "真幌", "text": "上司としてでも、\n教師としてでもな。"},
        { "location": "3002/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "3003/SEL"   , "narrator": "", "text": "真幌に全てを打ち明けるべきだ"},
        { "location": "3004/SEL"   , "narrator": "", "text": "（※何も言わない）"},
        { "location": "3005/ACT"   , "narrator": "", "text": "真幌に全てを打ち明けるべきだ"},
        { "location": "3012/ACT"   , "narrator": "", "text": "（※何も言わない）"},
        { "location": "3019/TALK"  , "narrator": "真幌", "text": "…さて、そろそろ\n暗くなる。"},
        { "location": "3020/TALK"  , "narrator": "真幌", "text": "みんなも待っている\nだろうからな。\n戻るとしよう。"},
        { "location": "3021/TALK"  , "narrator": "神楽", "text": "…はい。"},
        { "location": "3022/TALK"  , "narrator": "真幌", "text": "…なあ、卯月。"},
        { "location": "3023/TALK"  , "narrator": "真幌", "text": "悩みがあるなら、\n本当になんでも\n言うんだぞ？"},
        { "location": "3024/TALK"  , "narrator": "真幌", "text": "いつだって\n頼ってくれて\n構わないんだからな？"},
        { "location": "3025/TALK"  , "narrator": "神楽", "text": "…はい。"},
        { "location": "3055/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "3056/TALK"  , "narrator": "真幌", "text": "どうした？\nなにか"},
        { "location": "3058/TALK"  , "narrator": "神楽", "text": "真幌さん…。\n皇千羽鶴という人を、\nご存じですか？"},
        { "location": "3060/TALK"  , "narrator": "真幌", "text": "…ああ、知っている。\n話があるなら続けろ。"},
        { "location": "3061/TALK"  , "narrator": "神楽", "text": "…どうしよう。"},
        { "location": "3062/TALK"  , "narrator": "神楽", "text": "今いる日本が\nフェノメノンの中、\nって話をするのは。"},
        { "location": "3063/TALK"  , "narrator": "神楽", "text": "かなり労力を\n使うと思うし…"},
        { "location": "3064/TALK"  , "narrator": "真幌", "text": "おい、どうした？\n続きを話せ。"},
        { "location": "3065/TALK"  , "narrator": "神楽", "text": "…はい。\n実は――"},
        { "location": "3073/TALK"  , "narrator": "真幌", "text": "――なるほどな。"},
        { "location": "3074/TALK"  , "narrator": "真幌", "text": "おまえは皇千羽鶴と、\n秘密裏に契約を\n交わしていた。"},
        { "location": "3075/TALK"  , "narrator": "真幌", "text": "そして、いずれ\n逢瀬を殺害しなければ\nならない、か…。"},
        { "location": "3076/TALK"  , "narrator": "神楽", "text": "…はい。"},
        { "location": "3078/TALK"  , "narrator": "神楽", "text": "つばめさんのことを\n殺さなければ…。"},
        { "location": "3079/TALK"  , "narrator": "神楽", "text": "私の母が、殺されて\nしまうんです…。"},
        { "location": "3080/TALK"  , "narrator": "真幌", "text": "…まあ、そんなこと\nだろうとは思ったよ。"},
        { "location": "3081/TALK"  , "narrator": "真幌", "text": "…だが、わからんな。"},
        { "location": "3083/TALK"  , "narrator": "真幌", "text": "皇千羽鶴は、\nなぜ逢瀬のことを\n殺そうとしている？"},
        { "location": "3085/TALK"  , "narrator": "神楽", "text": "そ、それは…。"},
        { "location": "3087/TALK"  , "narrator": "真幌", "text": "…無理に言う\n必要はない。"},
        { "location": "3088/TALK"  , "narrator": "真幌", "text": "詮索はしない。\n事情は、\n言いたければ言え。"},
        { "location": "3089/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "3090/TALK"  , "narrator": "真幌", "text": "卯月は、皇千羽鶴が\nエージェントとしか\n聞いていないんだな？"},
        { "location": "3092/TALK"  , "narrator": "神楽", "text": "はい…違うんですか？"},
        { "location": "3093/TALK"  , "narrator": "真幌", "text": "皇千羽鶴。\n彼女は、情報管理庁の\n長官だ。"},
        { "location": "3095/TALK"  , "narrator": "神楽", "text": "ッ！？\n本当ですか！？"},
        { "location": "3096/TALK"  , "narrator": "真幌", "text": "ああ…、しかし、\nなぜ長官が逢瀬を\n殺そうとするのか…？"},
        { "location": "3097/TALK"  , "narrator": "真幌", "text": "…いや、いずれにせよ\nそれが事実ならば。"},
        { "location": "3098/TALK"  , "narrator": "真幌", "text": "私は隊長として、\nおまえと逢瀬のことを\n守らねばならない。"},
        { "location": "3099/TALK"  , "narrator": "神楽", "text": "…私も、ですか？"},
        { "location": "3100/TALK"  , "narrator": "真幌", "text": "当然だ。"},
        { "location": "3101/TALK"  , "narrator": "真幌", "text": "だが、それには\n色々とやらねばならん\nことがある。"},
        { "location": "3102/TALK"  , "narrator": "真幌", "text": "まずは管理庁に対し\n探りを入れ――"},
        { "location": "3103/TALK"  , "narrator": "真幌", "text": "なにが目的なのかの\n裏を取らねばならん。"},
        { "location": "3104/TALK"  , "narrator": "神楽", "text": "それって、かなり\n危険なんじゃ…。"},
        { "location": "3105/TALK"  , "narrator": "真幌", "text": "わかっているが、\n物事には道理がある。"},
        { "location": "3106/TALK"  , "narrator": "真幌", "text": "如何に派手なことを\nしようとする場合で\nあっても――"},
        { "location": "3107/TALK"  , "narrator": "真幌", "text": "道理に従わなければ、\nならず者の反乱者に\nなってしまうからな。"},
        { "location": "3108/TALK"  , "narrator": "真幌", "text": "ある程度の時間を\n要してしまうのは、\n仕方のないことだ。"},
        { "location": "3109/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "3110/TALK"  , "narrator": "真幌", "text": "ただ、その間は\n全力でおまえと逢瀬を\n保護すると約束する。"},
        { "location": "3111/TALK"  , "narrator": "真幌", "text": "だから、おまえには\n如何なることが\nあったとしても。"},
        { "location": "3112/TALK"  , "narrator": "真幌", "text": "逢瀬に手をかける\nようなことは\nしないでほしい。"},
        { "location": "3113/TALK"  , "narrator": "神楽", "text": "…その頼みを、\n私が聞けなかったと\nしたら？"},
        { "location": "3114/TALK"  , "narrator": "真幌", "text": "…卯月は、\nトロッコ問題という\nのを知っているか？"},
        { "location": "3115/TALK"  , "narrator": "神楽", "text": "線路の上にいる\n一人と五人に\n向かって…。"},
        { "location": "3116/TALK"  , "narrator": "神楽", "text": "暴走したトロッコが\n向かってくる、って\nやつですよね？"},
        { "location": "3117/TALK"  , "narrator": "真幌", "text": "そうだ。そして、\nトロッコが向かうのは\n五人のいる方向…。"},
        { "location": "3118/TALK"  , "narrator": "真幌", "text": "このままでは\n五人は間違いなく\n死亡してしまう。"},
        { "location": "3119/TALK"  , "narrator": "真幌", "text": "だが、自分ならば\nポイントを切り替えて\n救うことができる。"},
        { "location": "3120/TALK"  , "narrator": "真幌", "text": "ただし、その場合は\n切り替えた先にいる\n一人が、確実に死ぬ。"},
        { "location": "3121/TALK"  , "narrator": "真幌", "text": "…私は隊長として、\nおまえ達を守らねば\nならない。"},
        { "location": "3122/TALK"  , "narrator": "真幌", "text": "おまえに対しても、\nそれは変わらない。"},
        { "location": "3124/TALK"  , "narrator": "真幌", "text": "だが、\nトロッコ問題のような\n究極の問題の場合。"},
        { "location": "3125/TALK"  , "narrator": "真幌", "text": "『両方を失いたくないが\n為に、何も行動できない』\nというのは―"},
        { "location": "3126/TALK"  , "narrator": "真幌", "text": "最も褒められない\n行為だと思っている。"},
        { "location": "3127/TALK"  , "narrator": "真幌", "text": "だから、おまえが\n逢瀬に手をかけようと\nした場合…。"},
        { "location": "3128/TALK"  , "narrator": "真幌", "text": "私は、自分の責任を\n全うすべく。"},
        { "location": "3130/TALK"  , "narrator": "真幌", "text": "おまえを手にかける\n命令を出すだろう。"},
        { "location": "3131/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "3132/TALK"  , "narrator": "真幌", "text": "これは、四対一という\n数の暴力による\n理由ではない。"},
        { "location": "3133/TALK"  , "narrator": "真幌", "text": "特別攻撃隊隊長という\n立場にいる者として、\nより健全に――"},
        { "location": "3134/TALK"  , "narrator": "真幌", "text": "隊が機能する方を\n選択する必要が\nあるからだ。"},
        { "location": "3135/TALK"  , "narrator": "神楽", "text": "…わかってます。"},
        { "location": "3136/TALK"  , "narrator": "神楽", "text": "指揮官として、\nまっとうなことだと\n思いますよ。"},
        { "location": "3137/TALK"  , "narrator": "真幌", "text": "…そうなったとしても\n恨まんでくれよ？"},
        { "location": "3138/TALK"  , "narrator": "真幌", "text": "その代わり、事情を\n聞いた以上は私も\n最善を尽くす。"},
        { "location": "3139/TALK"  , "narrator": "真幌", "text": "だから卯月も、\n最悪の結果にならん\nように。"},
        { "location": "3140/TALK"  , "narrator": "真幌", "text": "最善を尽くして\nほしい…。"},
        { "location": "3141/TALK"  , "narrator": "真幌", "text": "私が望むのは、\nそれだけだ。"},
        { "location": "3142/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "3143/TALK"  , "narrator": "真幌", "text": "…ありがとう、\n卯月。"},
        { "location": "3144/TALK"  , "narrator": "真幌", "text": "言い難いこと\nだったろうに、\n打ち明けてくれて…。"},
        { "location": "3145/TALK"  , "narrator": "神楽", "text": "真幌さん…。"},
        { "location": "3146/TALK"  , "narrator": "真幌", "text": "…先に戻る。\nおまえも、\n遅くなるなよ。"},
        { "location": "3162/TALK"  , "narrator": "真幌", "text": "…………。"},
        { "location": "3163/TALK"  , "narrator": "真幌", "text": "皇長官は黒、か…。\n予想は的中だった\nようだな。"},
        { "location": "3164/TALK"  , "narrator": "真幌", "text": "しかし…、\nどうしたものか？"},
        { "location": "3165/TALK"  , "narrator": "真幌", "text": "私の方から\n積極的に動くか？"},
        { "location": "3167/TALK"  , "narrator": "真幌", "text": "…いや、\nそれは得策では\nないな。"},
        { "location": "3168/TALK"  , "narrator": "真幌", "text": "まずは入念な準備が\n必要だ。"},
        { "location": "3169/TALK"  , "narrator": "真幌", "text": "それと、情報を知り得た\nことを察知されないよう、\n用心せねば……。"},
        { "location": "3170/TALK"  , "narrator": "真幌", "text": "……よし。まずは\n段取りと……協力者の\n選定から入るか。"},
        { "location": "3175/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "3176/TALK"  , "narrator": "真幌", "text": "こんなところで\nどうしたんだ？"},
        { "location": "3181/TALK"  , "narrator": "真幌", "text": "あまり遠くまで\n出歩くのは\n関心せんな。"},
        { "location": "3184/TALK"  , "narrator": "神楽", "text": "真幌さん…、\nどうしてここに？"},
        { "location": "3185/TALK"  , "narrator": "真幌", "text": "みやびの家に戻る\n途中で、おまえの\n姿が見えてな。"},
        { "location": "3187/TALK"  , "narrator": "真幌", "text": "…大丈夫なのか？"},
        { "location": "3188/TALK"  , "narrator": "神楽", "text": "え？"},
        { "location": "3189/TALK"  , "narrator": "真幌", "text": "この前の一件から、\n落ち込んでいるよう\nだからな。"},
        { "location": "3190/TALK"  , "narrator": "神楽", "text": "…心配かけて\nごめんなさい。"},
        { "location": "3191/TALK"  , "narrator": "神楽", "text": "それと…メノウのこと\n黙っていて、\nごめんなさい。"},
        { "location": "3192/TALK"  , "narrator": "真幌", "text": "…いや、構わん。"},
        { "location": "3193/TALK"  , "narrator": "真幌", "text": "第一、任務に関係の\nないところまで。"},
        { "location": "3194/TALK"  , "narrator": "真幌", "text": "私に話す必要は\nないからな。"},
        { "location": "3195/TALK"  , "narrator": "真幌", "text": "おまえは、私の指示に\n従って、忠実に任務を\n全うしてくれている。"},
        { "location": "3196/TALK"  , "narrator": "真幌", "text": "役目を果たしている\n以上は、私からは\nなにも文句はない。"},
        { "location": "3198/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "3200/TALK"  , "narrator": "真幌", "text": "実は…あれから私も、\nメノウのことについて\n色々調べてな。"},
        { "location": "3201/TALK"  , "narrator": "真幌", "text": "随分活躍している\nみたいじゃないか。"},
        { "location": "3203/TALK"  , "narrator": "神楽", "text": "はい…、\nおかげさまで…。"},
        { "location": "3206/TALK"  , "narrator": "神楽", "text": "って、\n調べたんですか！？"},
        { "location": "3209/TALK"  , "narrator": "真幌", "text": "当然だ。"},
        { "location": "3210/TALK"  , "narrator": "真幌", "text": "管理庁がそのことを\n教えてくれなかった\nのには…。"},
        { "location": "3211/TALK"  , "narrator": "真幌", "text": "なにか理由があるの\nかもしれないと\n思ってな。"},
        { "location": "3212/TALK"  , "narrator": "真幌", "text": "…まあ、結局は\nわからずじまい\nだったんだが。"},
        { "location": "3213/TALK"  , "narrator": "神楽", "text": "…面倒をおかけして\nしまって、\nすみません。"},
        { "location": "3214/TALK"  , "narrator": "真幌", "text": "いや、気にするな。"},
        { "location": "3215/TALK"  , "narrator": "真幌", "text": "実は、フレイメノウの\n歌を聞いたことが\nなかったんだが…。"},
        { "location": "3216/TALK"  , "narrator": "真幌", "text": "聞いてみたら、\nどれも素晴らしい曲で\nよかったぞ。"},
        { "location": "3217/TALK"  , "narrator": "神楽", "text": "本当ですか？"},
        { "location": "3218/TALK"  , "narrator": "真幌", "text": "ああ、逢瀬がハマる\n気持ちが、少しだけ\nわかった気がするよ。"},
        { "location": "3219/TALK"  , "narrator": "真幌", "text": "卯月、おまえは\nスゴいヤツだ。"},
        { "location": "3221/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "3222/TALK"  , "narrator": "真幌", "text": "ただし、おまえが\nメノウだと知った\nからといって…。"},
        { "location": "3223/TALK"  , "narrator": "真幌", "text": "これからも特別扱いは\nしないから、\nそのつもりでな。"},
        { "location": "3225/TALK"  , "narrator": "神楽", "text": "もちろんです。\n逆に、それを聞いて\n安心しました。"},
        { "location": "3226/TALK"  , "narrator": "真幌", "text": "ん？\nどういう意味だ？"},
        { "location": "3227/TALK"  , "narrator": "神楽", "text": "あ、いえ…。"},
        { "location": "3228/TALK"  , "narrator": "真幌", "text": "…まあいい。\n言いたいことは\n伝えたからな。"},
        { "location": "3229/TALK"  , "narrator": "真幌", "text": "私は先に戻る。\n卯月も、あまり遅く\nなるなよ。"},
        { "location": "3230/TALK"  , "narrator": "神楽", "text": "わかりました。"},
        { "location": "3231/TALK"  , "narrator": "真幌", "text": "うむ…それと、卯月。"},
        { "location": "3232/TALK"  , "narrator": "真幌", "text": "…悩みがあるなら、\nいつでも相談に\nのるからな。"},
        { "location": "3234/TALK"  , "narrator": "神楽", "text": "はい…。\nその時は、\nお願いします…。"},
        { "location": "3247/DIALOG", "narrator": "Dialog_chapter_ch05", "text": "【17 告白】"},
        { "location": "3259/DIALOG", "narrator": "Dialog_chapter_ch05", "text": "【17 告白】"}
    ]
}
