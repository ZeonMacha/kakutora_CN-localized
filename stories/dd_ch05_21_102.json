        { "location": "2730/TALK"  , "narrator": "みやび", "text": "夏の暑さのせいか？\nうちが変なことを\n言うてしもうたのは。"},
        { "location": "2731/TALK"  , "narrator": "みやび", "text": "…まあそれも\n夏の思い出。"},
        { "location": "2732/TALK"  , "narrator": "みやび", "text": "青春の一ページと\nいうことにしとこう。"},
        { "location": "2733/ACT"   , "narrator": "", "text": "ガブリエラに声を掛ける"},
        { "location": "2745/TALK"  , "narrator": "ガブリエラ", "text": "あらどうしたの？"},
        { "location": "2746/SEL"   , "narrator": "", "text": "考えてること当ててみせようか"},
        { "location": "2747/ACT"   , "narrator": "", "text": "考えてること当ててみせようか"},
        { "location": "2748/TALK"  , "narrator": "ガブリエラ", "text": "あら"},
        { "location": "2749/TALK"  , "narrator": "ガブリエラ", "text": "がんばって名探偵さんｖｖｖ"},
        { "location": "2751/SEL"   , "narrator": "", "text": "足りないのはロマンスだ"},
        { "location": "2752/SEL"   , "narrator": "", "text": "恋が不足してる"},
        { "location": "2753/SEL"   , "narrator": "", "text": "愛があればいいだけなのに"},
        { "location": "2754/ACT"   , "narrator": "", "text": "足りないのはロマンスだ"},
        { "location": "2755/TALK"  , "narrator": "ガブリエラ", "text": "ロマンスｖｖｖ"},
        { "location": "2756/ACT"   , "narrator": "", "text": "恋が不足してる"},
        { "location": "2757/TALK"  , "narrator": "ガブリエラ", "text": "そうなのよ！"},
        { "location": "2758/ACT"   , "narrator": "", "text": "愛があればいいだけなのに"},
        { "location": "2759/TALK"  , "narrator": "ガブリエラ", "text": "やっぱり/////////////////"},
        { "location": "2761/TALK"  , "narrator": "ガブリエラ", "text": "さすがね$handle$ｖｖｖ"},
        { "location": "2762/TALK"  , "narrator": "ガブリエラ", "text": "でもね"},
        { "location": "2763/TALK"  , "narrator": "ガブリエラ", "text": "これは私の個人的見解であって"},
        { "location": "2764/TALK"  , "narrator": "ガブリエラ", "text": "みやびは全然違うことを求めてると思うのよ"},
        { "location": "2766/SEL"   , "narrator": "", "text": "そんな気はする"},
        { "location": "2767/SEL"   , "narrator": "", "text": "いや実は意外と"},
        { "location": "2768/SEL"   , "narrator": "", "text": "ガブリエラの話が聞きたいな"},
        { "location": "2769/ACT"   , "narrator": "", "text": "そんな気はする"},
        { "location": "2770/TALK"  , "narrator": "ガブリエラ", "text": "そうでしょう？"},
        { "location": "2771/ACT"   , "narrator": "", "text": "いや実は意外と"},
        { "location": "2772/TALK"  , "narrator": "ガブリエラ", "text": "そうなのかしら？"},
        { "location": "2773/ACT"   , "narrator": "", "text": "ガブリエラの話が聞きたいな"},
        { "location": "2774/TALK"  , "narrator": "ガブリエラ", "text": "私の話はしてるでしょｖｖｖ"},
        { "location": "2776/TALK"  , "narrator": "ガブリエラ", "text": "みやびは違うって言うと思うけど"},
        { "location": "2777/TALK"  , "narrator": "ガブリエラ", "text": "私はやっぱり人生で一番大事なものは"},
        { "location": "2778/TALK"  , "narrator": "ガブリエラ", "text": "人を愛する気持ちだと思うのよｖｖｖｖｖ"},
        { "location": "2780/SEL"   , "narrator": "", "text": "愛の定義は人それぞれ"},
        { "location": "2781/SEL"   , "narrator": "", "text": "ガブリエラと$me$みたいにね"},
        { "location": "2782/SEL"   , "narrator": "", "text": "他に大事なものなんてあるの？"},
        { "location": "2783/ACT"   , "narrator": "", "text": "愛の定義は人それぞれ"},
        { "location": "2784/TALK"  , "narrator": "ガブリエラ", "text": "確かにそうよね"},
        { "location": "2785/TALK"  , "narrator": "ガブリエラ", "text": "それを強要しないのも愛ｖｖｖ"},
        { "location": "2786/ACT"   , "narrator": "", "text": "ガブリエラと$me$みたいにね"},
        { "location": "2787/TALK"  , "narrator": "ガブリエラ", "text": "もうもうもうもう//////////////////////"},
        { "location": "2788/TALK"  , "narrator": "ガブリエラ", "text": "そんなことばっかり言って////////////////////"},
        { "location": "2789/TALK"  , "narrator": "ガブリエラ", "text": "顔が赤くなっちゃうでしょ////////////"},
        { "location": "2790/ACT"   , "narrator": "", "text": "他に大事なものなんてあるの？"},
        { "location": "2791/TALK"  , "narrator": "ガブリエラ", "text": "ないかしら？"},
        { "location": "2792/TALK"  , "narrator": "ガブリエラ", "text": "全てが愛の上に存在しているかも"},
        { "location": "2793/TALK"  , "narrator": "ガブリエラ", "text": "ううん違うわ"},
        { "location": "2794/TALK"  , "narrator": "ガブリエラ", "text": "大事なものは全て愛に満ちてるの"},
        { "location": "2796/TALK"  , "narrator": "ガブリエラ", "text": "愛についての話は後でゆっくりすることにして"},
        { "location": "2797/TALK"  , "narrator": "ガブリエラ", "text": "みやびにはなんて言えばいいかしら？"},
        { "location": "2799/SEL"   , "narrator": "", "text": "ゲームに誘うとか"},
        { "location": "2800/SEL"   , "narrator": "", "text": "昼寝とかいいんじゃない"},
        { "location": "2801/SEL"   , "narrator": "", "text": "ガブリエラと愛の話がしたいのに"},
        { "location": "2802/ACT"   , "narrator": "", "text": "ゲームに誘うとか"},
        { "location": "2803/TALK"  , "narrator": "ガブリエラ", "text": "それじゃいつもと変わらないわよ"},
        { "location": "2804/ACT"   , "narrator": "", "text": "昼寝とかいいんじゃない"},
        { "location": "2805/TALK"  , "narrator": "ガブリエラ", "text": "みんなですることでもないと思うわ？"},
        { "location": "2806/ACT"   , "narrator": "", "text": "ガブリエラと愛の話がしたいのに"},
        { "location": "2807/TALK"  , "narrator": "ガブリエラ", "text": "それは後でゆっくりねｖｖｖｖｖｖ"},
        { "location": "2819/TALK"  , "narrator": "ガブリエラ", "text": "なんて言おうかしら…。"},
        { "location": "2820/TALK"  , "narrator": "みやび", "text": "なあガブちゃん。\nうちは気づいたぞね。"},
