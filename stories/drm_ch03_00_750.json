    [
        { "location": "173/SCENARIO", "narrator": "", "text": "840_これからもそばにいて"},
        { "location": "200/SEL"     , "narrator": "", "text": "はいはい"},
        { "location": "201/SEL"     , "narrator": "", "text": "何？"},
        { "location": "202/ACT"     , "narrator": "", "text": "はいはい"},
        { "location": "203/ACT"     , "narrator": "", "text": "何？"},
        { "location": "205/TALK"    , "narrator": "ガブリエラ", "text": "あのね"},
        { "location": "206/TALK"    , "narrator": "ガブリエラ", "text": "いつも色々とありがとう"},
        { "location": "208/SEL"     , "narrator": "", "text": "どうしたの急に"},
        { "location": "209/SEL"     , "narrator": "", "text": "熱でもあるの？"},
        { "location": "210/SEL"     , "narrator": "", "text": "何かしたっけ？"},
        { "location": "211/ACT"     , "narrator": "", "text": "どうしたの急に"},
        { "location": "212/TALK"    , "narrator": "ガブリエラ", "text": "別に"},
        { "location": "213/ACT"     , "narrator": "", "text": "熱でもあるの？"},
        { "location": "214/TALK"    , "narrator": "ガブリエラ", "text": "ないわよ"},
        { "location": "215/ACT"     , "narrator": "", "text": "何かしたっけ？"},
        { "location": "216/TALK"    , "narrator": "ガブリエラ", "text": "したっていうか"},
        { "location": "218/TALK"    , "narrator": "ガブリエラ", "text": "一度ちゃんと言っておかなきゃって思っただけよ"},
        { "location": "219/TALK"    , "narrator": "ガブリエラ", "text": "$handle$はいつも私に優しいから"},
        { "location": "220/TALK"    , "narrator": "ガブリエラ", "text": "色々わがままを言ってしまうけど"},
        { "location": "221/TALK"    , "narrator": "ガブリエラ", "text": "私が$handle$のことを"},
        { "location": "222/TALK"    , "narrator": "ガブリエラ", "text": "好きだって思ってるってこと"},
        { "location": "224/SEL"     , "narrator": "", "text": "知ってるよ"},
        { "location": "225/SEL"     , "narrator": "", "text": "$handle$も好きだよ"},
        { "location": "227/ACT"     , "narrator": "", "text": "知ってるよ"},
        { "location": "228/TALK"    , "narrator": "ガブリエラ", "text": "知ってて当たり前よね"},
        { "location": "230/ACT"     , "narrator": "", "text": "$handle$も好きだよ"},
        { "location": "240/TALK"    , "narrator": "ガブリエラ", "text": "うんvvvvvvvvvvv"},
        { "location": "242/TALK"    , "narrator": "ガブリエラ", "text": "でもきっと"},
        { "location": "243/TALK"    , "narrator": "ガブリエラ", "text": "私の方が好きだと思うわvvvvvvvvvvvvvvvvv"},
        { "location": "245/TALK"    , "narrator": "ガブリエラ", "text": "だから"},
        { "location": "246/TALK"    , "narrator": "ガブリエラ", "text": "私このさきもずっと"},
        { "location": "247/TALK"    , "narrator": "ガブリエラ", "text": "$handle$と一緒にいたいって思っているのよ"},
        { "location": "249/TALK"    , "narrator": "ガブリエラ", "text": "$handle$は？"},
        { "location": "251/SEL"     , "narrator": "", "text": "もちろんそう思ってる"},
        { "location": "252/SEL"     , "narrator": "", "text": "当たり前すぎて考えてなかった"},
        { "location": "253/ACT"     , "narrator": "", "text": "もちろんそう思ってる"},
        { "location": "255/TALK"    , "narrator": "ガブリエラ", "text": "本当に？"},
        { "location": "258/ACT"     , "narrator": "", "text": "当たり前すぎて考えてなかった"},
        { "location": "259/TALK"    , "narrator": "ガブリエラ", "text": "当たり前vvvvvvvv"},
        { "location": "261/TALK"    , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "262/TALK"    , "narrator": "ガブリエラ", "text": "言葉が足りないわ"},
        { "location": "265/TALK"    , "narrator": "ガブリエラ", "text": "じゃあ"},
        { "location": "266/TALK"    , "narrator": "ガブリエラ", "text": "ずっと一緒にいる約束をする言葉を"},
        { "location": "267/TALK"    , "narrator": "ガブリエラ", "text": "言って欲しいの"},
        { "location": "268/TALK"    , "narrator": "ガブリエラ", "text": "わかるかしら？"},
        { "location": "270/SEL"     , "narrator": "", "text": "もちろん"},
        { "location": "271/SEL"     , "narrator": "", "text": "えーと、何？"},
        { "location": "272/ACT"     , "narrator": "", "text": "もちろん"},
        { "location": "273/TALK"    , "narrator": "ガブリエラ", "text": "本当ね？"},
        { "location": "274/TALK"    , "narrator": "ガブリエラ", "text": "じゃあちゃんと"},
        { "location": "275/TALK"    , "narrator": "ガブリエラ", "text": "言ってちょうだい"},
        { "location": "276/ACT"     , "narrator": "", "text": "えーと、何？"},
        { "location": "277/TALK"    , "narrator": "ガブリエラ", "text": "わからないのかしら？？"},
        { "location": "279/TALK"    , "narrator": "ガブリエラ", "text": "病める時も健やかな時も"},
        { "location": "280/TALK"    , "narrator": "ガブリエラ", "text": "そんな言葉で誓う時の言葉よ"},
        { "location": "282/SEL"     , "narrator": "", "text": "わからないな"},
        { "location": "283/SEL"     , "narrator": "", "text": "わかった"},
        { "location": "284/ACT"     , "narrator": "", "text": "わからないな"},
        { "location": "285/TALK"    , "narrator": "ガブリエラ", "text": "ここまで言ってもわからないのかしら？"},
        { "location": "286/TALK"    , "narrator": "ガブリエラ", "text": "プロポーズの言葉よ"},
        { "location": "287/TALK"    , "narrator": "ガブリエラ", "text": "もう////////////////////"},
        { "location": "288/ACT"     , "narrator": "", "text": "わかった"},
        { "location": "289/TALK"    , "narrator": "ガブリエラ", "text": "本当ね？"},
        { "location": "291/TALK"    , "narrator": "ガブリエラ", "text": "じゃあ"},
        { "location": "292/TALK"    , "narrator": "ガブリエラ", "text": "言ってちょうだい"},
        { "location": "295/SEL"     , "narrator": "", "text": "結婚しよう"},
        { "location": "296/SEL"     , "narrator": "", "text": "一生一緒だよ"},
        { "location": "297/ACT"     , "narrator": "", "text": "結婚しよう"},
        { "location": "298/TALK"    , "narrator": "ガブリエラ", "text": "はいvvvvvvvv"},
        { "location": "300/TALK"    , "narrator": "ガブリエラ", "text": "謹んでvvvvvvvvvvvvvvvvvvvvvvvvvv"},
        { "location": "301/TALK"    , "narrator": "ガブリエラ", "text": "お受けいたします//////////////////////////////"},
        { "location": "302/ACT"     , "narrator": "", "text": "一生一緒だよ"},
        { "location": "303/TALK"    , "narrator": "ガブリエラ", "text": "本当ね//////////////////////////////"},
        { "location": "305/TALK"    , "narrator": "ガブリエラ", "text": "絶対絶対//////////////////////////////"},
        { "location": "306/TALK"    , "narrator": "ガブリエラ", "text": "絶対なんだからvvvvvvvv"},
