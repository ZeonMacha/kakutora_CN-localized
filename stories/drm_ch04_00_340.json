    "entry":
    [
        { "location": "362/SCENARIO", "narrator": "", "text": "267_なんで、どうして、だれが"},
        { "location": "387/TALK"    , "narrator": "みやび", "text": "$handle$よ"},
        { "location": "388/TALK"    , "narrator": "みやび", "text": "ガブちゃんの誤解を解くにはどうすればええかね"},
        { "location": "389/TALK"    , "narrator": "みやび", "text": "ほれこの前のことだ"},
        { "location": "390/TALK"    , "narrator": "みやび", "text": "うちに恋人がおるって話ぞね"},
        { "location": "391/TALK"    , "narrator": "みやび", "text": "妙案をくれ"},
        { "location": "393/SEL"     , "narrator": "", "text": "ないよ"},
        { "location": "394/SEL"     , "narrator": "", "text": "解きたくないし"},
        { "location": "395/ACT"     , "narrator": "", "text": "ないよ"},
        { "location": "396/TALK"    , "narrator": "みやび", "text": "そんなことはないだろう"},
        { "location": "397/ACT"     , "narrator": "", "text": "解きたくないし"},
        { "location": "398/TALK"    , "narrator": "みやび", "text": "うちは解きたいというのだ"},
        { "location": "401/SEL"     , "narrator": "", "text": "解かないと困るの？"},
        { "location": "402/SEL"     , "narrator": "", "text": "言いたい奴には言わせとけ"},
        { "location": "403/SEL"     , "narrator": "", "text": "$me$はむしろうれしいから"},
        { "location": "404/ACT"     , "narrator": "", "text": "解かないと困るの？"},
        { "location": "405/TALK"    , "narrator": "みやび", "text": "困る"},
        { "location": "407/TALK"    , "narrator": "みやび", "text": "ことになっておる"},
        { "location": "408/ACT"     , "narrator": "", "text": "言いたい奴には言わせとけ"},
        { "location": "409/TALK"    , "narrator": "みやび", "text": "おっとこまえー"},
        { "location": "410/TALK"    , "narrator": "みやび", "text": "という問題ではなく"},
        { "location": "411/ACT"     , "narrator": "", "text": "$me$はむしろうれしいから"},
        { "location": "421/TALK"    , "narrator": "みやび", "text": "うれしいのか！"},
        { "location": "422/TALK"    , "narrator": "みやび", "text": "そうかそうか"},
        { "location": "423/TALK"    , "narrator": "みやび", "text": "そういうことなのか！"},
        { "location": "427/TALK"    , "narrator": "みやび", "text": "いや"},
        { "location": "428/TALK"    , "narrator": "みやび", "text": "そうではなく。"},
        { "location": "430/TALK"    , "narrator": "みやび", "text": "ほら色々あるろう"},
        { "location": "431/TALK"    , "narrator": "みやび", "text": "機微とかそういうやつとか"},
        { "location": "433/SEL"     , "narrator": "", "text": "ときめきとか"},
        { "location": "434/SEL"     , "narrator": "", "text": "いちゃつきとか"},
        { "location": "435/ACT"     , "narrator": "", "text": "ときめきとか"},
        { "location": "436/TALK"    , "narrator": "みやび", "text": "ときめき！"},
        { "location": "437/ACT"     , "narrator": "", "text": "いちゃつきとか"},
        { "location": "438/TALK"    , "narrator": "みやび", "text": "早い早い！"},
        { "location": "440/TALK"    , "narrator": "みやび", "text": "そういうのは全て都市伝説であろう"},
        { "location": "442/SEL"     , "narrator": "", "text": "そんなことないと思うよ"},
        { "location": "443/SEL"     , "narrator": "", "text": "現実にここにあるでしょ"},
        { "location": "444/ACT"     , "narrator": "", "text": "そんなことないと思うよ"},
        { "location": "445/TALK"    , "narrator": "みやび", "text": "なぜそう言い切れる"},
        { "location": "446/ACT"     , "narrator": "", "text": "現実にここにあるでしょ"},
        { "location": "447/TALK"    , "narrator": "みやび", "text": "ここに"},
        { "location": "448/TALK"    , "narrator": "みやび", "text": "だと"},
        { "location": "450/TALK"    , "narrator": "みやび", "text": "$handle$は"},
        { "location": "452/TALK"    , "narrator": "みやび", "text": "自分が何を言っているか理解しているのか？"},
        { "location": "454/SEL"     , "narrator": "", "text": "瓢箪から駒"},
        { "location": "455/SEL"     , "narrator": "", "text": "人間万事塞翁が馬"},
        { "location": "456/SEL"     , "narrator": "", "text": "雨降って地固まる"},
        { "location": "457/ACT"     , "narrator": "", "text": "瓢箪から駒"},
        { "location": "458/TALK"    , "narrator": "みやび", "text": "冗談は冗談のままなのだ"},
        { "location": "459/ACT"     , "narrator": "", "text": "人間万事塞翁が馬"},
        { "location": "460/TALK"    , "narrator": "みやび", "text": "これは不幸か幸福か？"},
        { "location": "461/ACT"     , "narrator": "", "text": "雨降って地固まる"},
        { "location": "462/TALK"    , "narrator": "みやび", "text": "そもそも"},
        { "location": "463/TALK"    , "narrator": "みやび", "text": "雨など降っておらぬ"},
        { "location": "465/TALK"    , "narrator": "みやび", "text": "埒があかん"},
        { "location": "467/SEL"     , "narrator": "", "text": "いや、"},
        { "location": "468/ACT"     , "narrator": "", "text": "いや、"},
        { "location": "469/TALK"    , "narrator": "みやび", "text": "ん？"},
        { "location": "472/SEL"     , "narrator": "", "text": "本気で考えてみて"},
        { "location": "473/ACT"     , "narrator": "", "text": "本気で考えてみて"},
        { "location": "474/TALK"    , "narrator": "みやび", "text": "何を"},
        { "location": "477/SEL"     , "narrator": "", "text": "$me$とつきあうこと"},
        { "location": "478/SEL"     , "narrator": "", "text": "$me$が恋人だってこと"},
        { "location": "479/SEL"     , "narrator": "", "text": "$me$とみやびの愛について"},
        { "location": "480/ACT"     , "narrator": "", "text": "$me$とつきあうこと"},
        { "location": "481/TALK"    , "narrator": "みやび", "text": "つきあう"},
        { "location": "482/ACT"     , "narrator": "", "text": "$me$が恋人だってこと"},
        { "location": "483/TALK"    , "narrator": "みやび", "text": "こいびと"},
        { "location": "484/ACT"     , "narrator": "", "text": "$me$とみやびの愛について"},
        { "location": "485/TALK"    , "narrator": "みやび", "text": "アガペか"},
        { "location": "486/TALK"    , "narrator": "みやび", "text": "エロスか"},
        { "location": "488/TALK"    , "narrator": "みやび", "text": "なんと"},
        { "location": "489/TALK"    , "narrator": "みやび", "text": "なんという"},
        { "location": "490/TALK"    , "narrator": "みやび", "text": "なんとなれば"},
        { "location": "491/TALK"    , "narrator": "みやび", "text": "うぬぬぬ…"},
        { "location": "496/TALK"    , "narrator": "ボイスメール", "text": "ああああああああああ"},
        { "location": "417/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>800pt.</b></color></size>\nアップしました！"},
        { "location": "508/DIALOG"  , "narrator": "Dialog_GETVoice", "text": "<color=green>【みやび】</color>のボイスメール\n<color=red>【ああああああああああ】</color>\nをゲットしました！"}
    ]
