{
    "dir": "chap00/daydra/spev_ch03_014.js",
    "type": "",
    "info": {
        "story_id": "3014",
        "cid": "",
        "title": "スペシャルエピソード",
        "sub_title": "飾らざるもの食うべからず"
    },
    "entry":
    [
        { "location": "32/TALK" , "narrator": "透明ガブリエラ", "text": "まったく…、準備できた\nって言ったのは\n誰だったかしら？"},
        { "location": "33/TALK" , "narrator": "コルト", "text": "できてるじゃないッスか。\n食事の準備。"},
        { "location": "34/TALK" , "narrator": "透明ガブリエラ", "text": "あのね、クリスマス\nパーティーってこと\n忘れてるんじゃないの？"},
        { "location": "35/TALK" , "narrator": "透明ガブリエラ", "text": "主役のツリーが\n飾りづけられてないって、\n大問題でしょ。"},
        { "location": "36/TALK" , "narrator": "コルト", "text": "でも、ツリーだけより、\n食事だけの方がいいと\n思うんスよ。"},
        { "location": "39/TALK" , "narrator": "透明ガブリエラ", "text": "口答えしない！\nほら、あんたもさっさと\n飾りを付けなさい。"},
        { "location": "40/TALK" , "narrator": "コルト", "text": "はいはい…。\nこんな感じでいいッスか？"},
        { "location": "41/TALK" , "narrator": "透明ガブリエラ", "text": "適当すぎ！！\n同じ枝にばっかり\n飾らないの。"},
        { "location": "42/TALK" , "narrator": "透明ガブリエラ", "text": "そんなことしたら\n重さで折れちゃうでしょ？"},
        { "location": "44/TALK" , "narrator": "コルト", "text": "そうなったら飾り付け\nできなくなるッスね！"},
        { "location": "46/TALK" , "narrator": "透明ガブリエラ", "text": "嬉しそうに言うな！"},
        { "location": "47/TALK" , "narrator": "コルト", "text": "ってか、何も飾らなくても\nツリー自体の存在感だけで\n十分だと思うんスけど？"},
        { "location": "48/TALK" , "narrator": "透明ガブリエラ", "text": "なるほど、そんなに\n飾り付けが面倒なのね。"},
        { "location": "49/TALK" , "narrator": "コルト", "text": "ええ、そりゃもう！"},
        { "location": "51/TALK" , "narrator": "透明ガブリエラ", "text": "今度の出動の時、\nいつもよりあんたのこと\n酷使してもいいんだけど？"},
        { "location": "52/TALK" , "narrator": "コルト", "text": "あ、あはは！\nイヤだなぁ、姉さん。\n冗談ッスよ、冗談！！"},
        { "location": "53/TALK" , "narrator": "コルト", "text": "さあ、ドンドン綺麗に\n飾り付けちゃいましょう！\nあ、電飾も付けるッスよ！"},
        { "location": "56/TALK" , "narrator": "透明ガブリエラ", "text": "うんうん、\n働き者は大好きよ。"},
        { "location": "57/TALK" , "narrator": "透明ガブリエラ", "text": "じゃあ、見張ってるから\n続きは任せたわね。"},
        { "location": "58/TALK" , "narrator": "コルト", "text": "えぇーっ！？"},
        { "location": "59/TALK" , "narrator": "透明ガブリエラ", "text": "あら、文句があると？"},
        { "location": "60/TALK" , "narrator": "コルト", "text": "い、いいんスか！？\n一人で全部やっちゃって！\nわーいわーい！"},
        { "location": "61/TALK" , "narrator": "透明ガブリエラ", "text": "ええ、もちろんよ。\nサボッた分頑張って\n働きなさいね。"},
        { "location": "63/TALK" , "narrator": "コルト", "text": "とほほ…。"},
        { "location": "64/TALK" , "narrator": "透明ガブリエラ", "text": "ふぅ…さてと…。"},
        { "location": "67/TALK" , "narrator": "ガブリエラ", "text": "そっちの方はどう？"},
        { "location": "68/TALK" , "narrator": "ガブリエラ", "text": "クリスマスちゃんと祝ってる？"},
        { "location": "69/SEL"  , "narrator": "（選択肢）", "text": "もちろん！"},
        { "location": "70/SEL"  , "narrator": "（選択肢）", "text": "クリスマスだけど祝ってないよ"},
        { "location": "71/SEL"  , "narrator": "（選択肢）", "text": "こっちはクリスマスじゃないよ"},
        { "location": "72/ACT"  , "narrator": "", "text": "もちろん！"},
        { "location": "73/TALK" , "narrator": "ガブリエラ", "text": "やっぱりクリスマスは特別な日だもの"},
        { "location": "74/TALK" , "narrator": "ガブリエラ", "text": "祝わなくっちゃね"},
        { "location": "75/ACT"  , "narrator": "", "text": "クリスマスだけど祝ってないよ"},
        { "location": "78/TALK" , "narrator": "ガブリエラ", "text": "正気！？"},
        { "location": "80/TALK" , "narrator": "ガブリエラ", "text": "クリスマスを祝わないなんて変よ"},
        { "location": "81/TALK" , "narrator": "ガブリエラ", "text": "$handle$って変わってるわ"},
        { "location": "82/ACT"  , "narrator": "", "text": "こっちはクリスマスじゃないよ"},
        { "location": "83/TALK" , "narrator": "ガブリエラ", "text": "あらそうなの？"},
        { "location": "84/TALK" , "narrator": "ガブリエラ", "text": "一緒にクリスマスを祝おうと思ったのに"},
        { "location": "87/TALK" , "narrator": "ガブリエラ", "text": "こっちは見ての通りよ"},
        { "location": "88/TALK" , "narrator": "ガブリエラ", "text": "みんなでクリスマスを祝ってるわ"},
        { "location": "89/TALK" , "narrator": "ガブリエラ", "text": "今日はクラン達も一緒だから"},
        { "location": "90/TALK" , "narrator": "ガブリエラ", "text": "とても賑やかなの"},
        { "location": "93/SEL"  , "narrator": "（選択肢）", "text": "楽しそうで羨ましい"},
        { "location": "94/SEL"  , "narrator": "（選択肢）", "text": "まだ準備中みたいだけど？"},
        { "location": "95/ACT"  , "narrator": "", "text": "楽しそうで羨ましい"},
        { "location": "96/TALK" , "narrator": "ガブリエラ", "text": "みんな楽しんでいるわ"},
        { "location": "97/TALK" , "narrator": "ガブリエラ", "text": "私の方はまだだけど"},
        { "location": "98/TALK" , "narrator": "ガブリエラ", "text": "クリスマスツリーの飾り付けが終わってないから"},
        { "location": "99/TALK" , "narrator": "ガブリエラ", "text": "美味しい料理はまだお預けよ"},
        { "location": "100/ACT" , "narrator": "", "text": "まだ準備中みたいだけど？"},
        { "location": "101/TALK", "narrator": "ガブリエラ", "text": "そうなのよ"},
        { "location": "102/TALK", "narrator": "ガブリエラ", "text": "コルトがツリーの飾り付けをサボってたから"},
        { "location": "103/TALK", "narrator": "ガブリエラ", "text": "私はこれが終わるまでお料理はお預け"},
        { "location": "104/TALK", "narrator": "ガブリエラ", "text": "お腹空いたわ"},
        { "location": "106/TALK", "narrator": "ガブリエラ", "text": "でも"},
        { "location": "108/TALK", "narrator": "ガブリエラ", "text": "やっぱりツリーがないとね"},
        { "location": "109/TALK", "narrator": "ガブリエラ", "text": "シンボルがないと寂しいわ"},
        { "location": "110/TALK", "narrator": "ガブリエラ", "text": "$handle$もそう思うでしょ？"},
        { "location": "111/SEL" , "narrator": "（選択肢）", "text": "もちろんだよ"},
        { "location": "112/SEL" , "narrator": "（選択肢）", "text": "食事だけで十分じゃない？"},
        { "location": "113/ACT" , "narrator": "", "text": "もちろんだよ"},
        { "location": "114/TALK", "narrator": "ガブリエラ", "text": "やっぱりそうよね"},
        { "location": "116/TALK", "narrator": "ガブリエラ", "text": "どんなに美味しい料理が並んでいても"},
        { "location": "117/TALK", "narrator": "ガブリエラ", "text": "どんなにみんなと楽しくしていても"},
        { "location": "118/TALK", "narrator": "ガブリエラ", "text": "クリスマスツリーがないと寂しいものよね"},
        { "location": "119/TALK", "narrator": "ガブリエラ", "text": "コルトにはわからないみたいだけど"},
        { "location": "120/ACT" , "narrator": "", "text": "もちろんだよ"},
        { "location": "121/TALK", "narrator": "ガブリエラ", "text": "$handle$もコルトと一緒なの？"},
        { "location": "123/TALK", "narrator": "ガブリエラ", "text": "ツリーのないクリスマスでも平気だなんて"},
        { "location": "124/TALK", "narrator": "ガブリエラ", "text": "絶対に変だと思うんだけど"},
        { "location": "125/TALK", "narrator": "ガブリエラ", "text": "お国柄なのかしら？"},
        { "location": "127/TALK", "narrator": "ガブリエラ", "text": "今日はこんな感じで"},
        { "location": "128/TALK", "narrator": "ガブリエラ", "text": "遅くまでパーティーやりそうだから"},
        { "location": "129/TALK", "narrator": "ガブリエラ", "text": "帰ったらすぐに寝ちゃうかも"},
        { "location": "130/SEL" , "narrator": "（選択肢）", "text": "お話はなしかな？"},
        { "location": "131/ACT" , "narrator": "", "text": "お話はなしかな？"},
        { "location": "133/TALK", "narrator": "ガブリエラ", "text": "どうかしら？"},
        { "location": "134/TALK", "narrator": "ガブリエラ", "text": "帰って元気があったら"},
        { "location": "135/TALK", "narrator": "ガブリエラ", "text": "その時はお話ししましょ"},
        { "location": "136/TALK", "narrator": "ガブリエラ", "text": "っていうか"},
        { "location": "137/TALK", "narrator": "ガブリエラ", "text": "今日は特別な夜だから"},
        { "location": "138/TALK", "narrator": "ガブリエラ", "text": "できればお話はしたいんだけど"},
        { "location": "139/TALK", "narrator": "ガブリエラ", "text": "なんてね////////"},
        { "location": "141/TALK", "narrator": "ガブリエラ", "text": "そろそろツリーの飾り付けも終わりそうだし"},
        { "location": "142/TALK", "narrator": "ガブリエラ", "text": "私も食事を始めるわ"},
        { "location": "143/TALK", "narrator": "ガブリエラ", "text": "それじゃあ$handle$"},
        { "location": "144/TALK", "narrator": "ガブリエラ", "text": "メリークリスマス！"},
        { "location": "147/TALK", "narrator": "コルト", "text": "…姉さーん。\nこんな感じでどうッスか？"},
        { "location": "148/TALK", "narrator": "透明ガブリエラ", "text": "あら、いい感じ。\nやればできるじゃない。"},
        { "location": "149/TALK", "narrator": "コルト", "text": "おっ、褒められた。\nじゃあ飾り付けは\nおしまいってことで…。"},
        { "location": "151/TALK", "narrator": "透明ガブリエラ", "text": "はぁ…仕方ないわね。\nまだ完璧じゃないけど、\n許してあげるわ。"},
        { "location": "152/TALK", "narrator": "コルト", "text": "マジッスか！？"},
        { "location": "153/TALK", "narrator": "透明ガブリエラ", "text": "あんまりガミガミと\n言いたくないのよ。"},
        { "location": "154/TALK", "narrator": "透明ガブリエラ", "text": "なんたって、\n今日はクリスマス\nなんだから。"},
        { "location": "155/TALK", "narrator": "コルト", "text": "へぇ…ギャヴィ姉さんが\nそんな優しいことを\n言うなんて…。"},
        { "location": "156/TALK", "narrator": "コルト", "text": "あっ、そうか。\nクリスマスの奇跡、\nってやつッスね！"},
        { "location": "158/TALK", "narrator": "透明ガブリエラ", "text": "…前言を撤回することも\nできるんだけど？"},
        { "location": "159/TALK", "narrator": "コルト", "text": "ギャ、ギャヴィ姉さんは\nいつも優しくて最高ッス！"},
        { "location": "161/TALK", "narrator": "透明ガブリエラ", "text": "まったく、\n困った子なんだから。"}
    ]
}
