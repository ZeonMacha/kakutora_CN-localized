    "entry":
    [
        { "location": "1136/SCENARIO", "narrator": "", "text": "270_ならばそうしよう"},
        { "location": "1161/TALK"    , "narrator": "みやび", "text": "$handle$は"},
        { "location": "1162/TALK"    , "narrator": "みやび", "text": "うちと付き合いたいのか？"},
        { "location": "1164/SEL"     , "narrator": "", "text": "当然"},
        { "location": "1165/SEL"     , "narrator": "", "text": "もちろんろん"},
        { "location": "1166/SEL"     , "narrator": "", "text": "みやびがその気になるまで待つ"},
        { "location": "1167/ACT"     , "narrator": "", "text": "当然"},
        { "location": "1169/TALK"    , "narrator": "みやび", "text": "切実さがないの"},
        { "location": "1170/TALK"    , "narrator": "みやび", "text": "響かん"},
        { "location": "1171/TALK"    , "narrator": "みやび", "text": "却下ぞね"},
        { "location": "1175/ACT"     , "narrator": "", "text": "もちろんろん"},
        { "location": "1177/TALK"    , "narrator": "みやび", "text": "軽いな"},
        { "location": "1178/TALK"    , "narrator": "みやび", "text": "やめておこう"},
        { "location": "1180/ACT"     , "narrator": "", "text": "みやびがその気になるまで待つ"},
        { "location": "1191/TALK"    , "narrator": "みやび", "text": "ふむ"},
        { "location": "1192/TALK"    , "narrator": "みやび", "text": "その気とは"},
        { "location": "1194/SEL"     , "narrator": "", "text": "$me$を信じてくれるまで"},
        { "location": "1195/SEL"     , "narrator": "", "text": "$me$に恋してくれるまで"},
        { "location": "1196/SEL"     , "narrator": "", "text": "深くは考えてなかった"},
        { "location": "1197/ACT"     , "narrator": "", "text": "$me$を信じてくれるまで"},
        { "location": "1198/TALK"    , "narrator": "みやび", "text": "信頼の問題か"},
        { "location": "1199/ACT"     , "narrator": "", "text": "$me$に恋してくれるまで"},
        { "location": "1200/TALK"    , "narrator": "みやび", "text": "難問だの"},
        { "location": "1201/ACT"     , "narrator": "", "text": "深くは考えてなかった"},
        { "location": "1202/TALK"    , "narrator": "みやび", "text": "少しは考えておけ"},
        { "location": "1204/TALK"    , "narrator": "みやび", "text": "それにしても"},
        { "location": "1205/TALK"    , "narrator": "みやび", "text": "うちがその気にならんかったら"},
        { "location": "1206/TALK"    , "narrator": "みやび", "text": "どうする気ぞね"},
        { "location": "1208/SEL"     , "narrator": "", "text": "どうすればいいかな…"},
        { "location": "1209/SEL"     , "narrator": "", "text": "泣くかも"},
        { "location": "1210/ACT"     , "narrator": "", "text": "どうすればいいかな…"},
        { "location": "1211/TALK"    , "narrator": "みやび", "text": "聞くな"},
        { "location": "1212/ACT"     , "narrator": "", "text": "泣くかも"},
        { "location": "1213/TALK"    , "narrator": "みやび", "text": "なんと"},
        { "location": "1215/TALK"    , "narrator": "みやび", "text": "気弱なことだの"},
        { "location": "1218/SEL"     , "narrator": "", "text": "それはそうなるよ"},
        { "location": "1219/SEL"     , "narrator": "", "text": "恋ってそういうものなんだ"},
        { "location": "1220/ACT"     , "narrator": "", "text": "それはそうなるよ"},
        { "location": "1221/TALK"    , "narrator": "みやび", "text": "なるのか？"},
        { "location": "1222/ACT"     , "narrator": "", "text": "恋ってそういうものなんだ"},
        { "location": "1223/TALK"    , "narrator": "みやび", "text": "ほう"},
        { "location": "1225/TALK"    , "narrator": "みやび", "text": "黙って$me$についてこい"},
        { "location": "1226/TALK"    , "narrator": "みやび", "text": "くらいのことは言わんのか"},
        { "location": "1229/SEL"     , "narrator": "", "text": "趣味じゃない"},
        { "location": "1230/SEL"     , "narrator": "", "text": "言ってもいいけど"},
        { "location": "1231/SEL"     , "narrator": "", "text": "時代錯誤だね"},
        { "location": "1232/SEL"     , "narrator": "", "text": "むしろみやびについて行きたい"},
        { "location": "1233/ACT"     , "narrator": "", "text": "趣味じゃない"},
        { "location": "1234/TALK"    , "narrator": "みやび", "text": "趣味嗜好の問題か"},
        { "location": "1235/ACT"     , "narrator": "", "text": "言ってもいいけど"},
        { "location": "1236/TALK"    , "narrator": "みやび", "text": "あえて言わぬと"},
        { "location": "1237/ACT"     , "narrator": "", "text": "時代錯誤だね"},
        { "location": "1238/TALK"    , "narrator": "みやび", "text": "確かにの"},
        { "location": "1239/ACT"     , "narrator": "", "text": "むしろみやびについて行きたい"},
        { "location": "1240/TALK"    , "narrator": "みやび", "text": "なるほど"},
        { "location": "1242/TALK"    , "narrator": "みやび", "text": "なんとなく"},
        { "location": "1243/TALK"    , "narrator": "みやび", "text": "わかったような"},
        { "location": "1244/TALK"    , "narrator": "みやび", "text": "わからんような"},
        { "location": "1246/SEL"     , "narrator": "", "text": "わかって欲しいな"},
        { "location": "1247/SEL"     , "narrator": "", "text": "今はなんとなくでもいいんだ"},
        { "location": "1248/ACT"     , "narrator": "", "text": "わかって欲しいな"},
        { "location": "1249/TALK"    , "narrator": "みやび", "text": "ぬう"},
        { "location": "1250/ACT"     , "narrator": "", "text": "今はなんとなくでもいいんだ"},
        { "location": "1251/TALK"    , "narrator": "みやび", "text": "そうか"},
        { "location": "1253/TALK"    , "narrator": "みやび", "text": "もう一度聞こう"},
        { "location": "1254/TALK"    , "narrator": "みやび", "text": "$handle$はうちと付き合いたいや否や？"},
        { "location": "1256/SEL"     , "narrator": "", "text": "付き合いたい"},
        { "location": "1257/SEL"     , "narrator": "", "text": "愛を育てていこう"},
        { "location": "1258/SEL"     , "narrator": "", "text": "当然"},
        { "location": "1259/SEL"     , "narrator": "", "text": "好きだ、みやび"},
        { "location": "1260/SEL"     , "narrator": "", "text": "よろしくお願いします"},
        { "location": "1261/ACT"     , "narrator": "", "text": "付き合いたい"},
        { "location": "1262/TALK"    , "narrator": "みやび", "text": "そうか"},
        { "location": "1263/ACT"     , "narrator": "", "text": "愛を育てていこう"},
        { "location": "1264/TALK"    , "narrator": "みやび", "text": "愛、か"},
        { "location": "1265/ACT"     , "narrator": "", "text": "当然"},
        { "location": "1266/TALK"    , "narrator": "みやび", "text": "当たり前のことなのか"},
        { "location": "1267/ACT"     , "narrator": "", "text": "好きだ、みやび"},
        { "location": "1268/TALK"    , "narrator": "みやび", "text": "原初の衝動"},
        { "location": "1269/ACT"     , "narrator": "", "text": "よろしくお願いします"},
        { "location": "1270/TALK"    , "narrator": "みやび", "text": "礼儀正しいの"},
        { "location": "1274/TALK"    , "narrator": "みやび", "text": "ならば"},
        { "location": "1276/TALK"    , "narrator": "みやび", "text": "そうしよう"},
        { "location": "1279/TALK"    , "narrator": "ボイスメール", "text": "コイガサ子に恋が咲き"},
        { "location": "1186/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>800pt.</b></color></size>\nアップしました！"},
        { "location": "1291/DIALOG"  , "narrator": "Dialog_GETVoice", "text": "<color=green>【みやび】</color>のボイスメール\n<color=red>【コイガサ子に恋が咲き】</color>\nをゲットしました！"}
    ]
}
