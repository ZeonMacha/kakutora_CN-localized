        "title": "004 ココロスフィアストーリー【Lv02】",
        "sub_title": "ＪＫＡクーデター＜提起＞"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "高校時代のクーデター"},
        { "location": "13/DIALOG" , "narrator": "", "text": "<size=40>KOKORO-Lv. 02</size>\nAYAMI - KUNIMASA\n\n<size=45>ＪＫＡクーデター</size>\n<size=35>～過去からの反乱～</size>"},
        { "location": "23/TALK"   , "narrator": "高校生アーヤ", "text": "こんにちは。"},
        { "location": "24/SEL"    , "narrator": "（選択肢）", "text": "君は？"},
        { "location": "25/SEL"    , "narrator": "（選択肢）", "text": "高校時代のアーヤ？"},
        { "location": "26/ACT"    , "narrator": "", "text": "君は？"},
        { "location": "27/TALK"   , "narrator": "高校生アーヤ", "text": "國政綾水。\n高校３年です。"},
        { "location": "28/SEL"    , "narrator": "（選択肢）", "text": "回想か何かかな？"},
        { "location": "29/SEL"    , "narrator": "（選択肢）", "text": "ちょｗｗ年サバ読みすぎてかわいい"},
        { "location": "30/ACT"    , "narrator": "", "text": "回想か何かかな？"},
        { "location": "31/TALK"   , "narrator": "高校生アーヤ", "text": "その解釈でも\n問題ないかな。"},
        { "location": "32/TALK"   , "narrator": "高校生アーヤ", "text": "厳密には、過去から\n一貫して持っている\n信念。"},
        { "location": "33/ACT"    , "narrator": "", "text": "ちょｗｗ年サバ読みすぎてかわいい"},
        { "location": "39/DIALOG" , "narrator": "", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"},
        { "location": "43/TALK"   , "narrator": "高校生アーヤ", "text": "サバ読んでるわけじゃ\nありませんっ！"},
        { "location": "44/TALK"   , "narrator": "高校生アーヤ", "text": "私はココロの中では\n永遠の１７歳なの！"},
        { "location": "45/SEL"    , "narrator": "（選択肢）", "text": "アーヤさんマジメカワイイ！"},
        { "location": "46/SEL"    , "narrator": "（選択肢）", "text": "どんびき！"},
        { "location": "47/ACT"    , "narrator": "", "text": "アーヤさんマジメカワイイ！"},
        { "location": "53/DIALOG" , "narrator": "", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"},
        { "location": "57/TALK"   , "narrator": "高校生アーヤ", "text": "今はそんなことを\n議論してる場合じゃ\nないのっ！"},
        { "location": "58/ACT"    , "narrator": "", "text": "どんびき！"},
        { "location": "61/TALK"   , "narrator": "高校生アーヤ", "text": "なんで？\n高校生が高校生と言う\nのはモラルに反すると？"},
        { "location": "63/TALK"   , "narrator": "高校生アーヤ", "text": "まあいいわ。\n今回はそういう話を\nしたいのではなく。"},
        { "location": "66/ACT"    , "narrator": "", "text": "高校時代のアーヤ？"},
        { "location": "67/TALK"   , "narrator": "高校生アーヤ", "text": "そう。どうして\nわかったの？"},
        { "location": "68/SEL"    , "narrator": "（選択肢）", "text": "前に回想で見た"},
        { "location": "69/ACT"    , "narrator": "", "text": "前に回想で見た"},
        { "location": "71/TALK"   , "narrator": "高校生アーヤ", "text": "そうだったのね。"},
        { "location": "72/TALK"   , "narrator": "高校生アーヤ", "text": "改めまして。\n私は國政綾水。\n高校３年です。"},
        { "location": "74/TALK"   , "narrator": "高校生アーヤ", "text": "今回は――"},
        { "location": "76/TALK"   , "narrator": "高校生アーヤ", "text": "……っと。"},
        { "location": "77/SEL"    , "narrator": "（選択肢）", "text": "…？"},
        { "location": "78/ACT"    , "narrator": "", "text": "…？"},
        { "location": "83/TALK"   , "narrator": "高校生アーヤ", "text": "あっと、ごめんなさい。\n貴方は男性ですか？\n女性ですか？"},
        { "location": "84/SEL"    , "narrator": "（選択肢）", "text": "男です"},
        { "location": "85/SEL"    , "narrator": "（選択肢）", "text": "女です"},
        { "location": "86/ACT"    , "narrator": "", "text": "男です"},
        { "location": "93/ACT"    , "narrator": "", "text": "女です"},
        { "location": "102/TALK"  , "narrator": "高校生アーヤ", "text": "わかりました。\nそれじゃ、\n$handle$$yobi$で。"},
        { "location": "103/TALK"  , "narrator": "高校生アーヤ", "text": "今回は\n$handle$$yobi$に\n頼みがあって来ました。"},
        { "location": "104/TALK"  , "narrator": "高校生アーヤ", "text": "単刀直入に\n相談するわ。"},
        { "location": "105/TALK"  , "narrator": "高校生アーヤ", "text": "私のココロの中に\n堕落した私が\n生息しています。"},
        { "location": "106/TALK"  , "narrator": "高校生アーヤ", "text": "それを、私と共に\n撲滅して欲しいの。"},
        { "location": "108/SEL"   , "narrator": "（選択肢）", "text": "協力します"},
        { "location": "109/SEL"   , "narrator": "（選択肢）", "text": "撲滅！？こわい……"},
        { "location": "112/ACT"   , "narrator": "", "text": "協力します"},
        { "location": "113/TALK"  , "narrator": "高校生アーヤ", "text": "ありがとう。"},
        { "location": "114/TALK"  , "narrator": "高校生アーヤ", "text": "國政綾水の心中の\n空気の乱れを\n共に正しましょう！"},
        { "location": "115/ACT"   , "narrator": "", "text": "撲滅！？こわい……"},
        { "location": "117/TALK"  , "narrator": "高校生アーヤ", "text": "撲滅という言葉が\n怖い？"},
        { "location": "118/TALK"  , "narrator": "高校生アーヤ", "text": "堕落したココロは\n伝染病や麻薬と\n同じものなの。"},
        { "location": "119/TALK"  , "narrator": "高校生アーヤ", "text": "撲滅という言葉が\nぴったりかと\n思うんですけど。"},
        { "location": "120/TALK"  , "narrator": "高校生アーヤ", "text": "だから、どうか撲滅に\nご協力お願いします。"},
        { "location": "121/SEL"   , "narrator": "（選択肢）", "text": "協力します"},
        { "location": "122/SEL"   , "narrator": "（選択肢）", "text": "$me$のメリットは？"},
        { "location": "123/ACT"   , "narrator": "", "text": "協力します"},
        { "location": "131/TALK"  , "narrator": "高校生アーヤ", "text": "ありがとう。"},
        { "location": "132/TALK"  , "narrator": "高校生アーヤ", "text": "國政綾水の心中の\n空気の乱れを\n共に正しましょう！"},
        { "location": "133/ACT"   , "narrator": "", "text": "$me$のメリットは？"},
        { "location": "139/DIALOG", "narrator": "", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"},
        { "location": "143/TALK"  , "narrator": "高校生アーヤ", "text": "メリット？"},
        { "location": "144/SEL"   , "narrator": "（選択肢）", "text": "もしかしてボランティアで！？"},
        { "location": "145/ACT"   , "narrator": "", "text": "もしかしてボランティアで！？"},
        { "location": "147/TALK"  , "narrator": "高校生アーヤ", "text": "学生は全てが\n奉仕の精神よ？"},
        { "location": "148/SEL"   , "narrator": "（選択肢）", "text": "学生じゃないし"},
        { "location": "149/SEL"   , "narrator": "（選択肢）", "text": "友だち少なそう"},
        { "location": "150/ACT"   , "narrator": "", "text": "学生じゃないし"},
        { "location": "151/TALK"  , "narrator": "高校生アーヤ", "text": "そうだったのね。"},
        { "location": "152/ACT"   , "narrator": "", "text": "友だち少なそう"},
        { "location": "153/TALK"  , "narrator": "高校生アーヤ", "text": "ちゃんといるから！\n…もう。"},
        { "location": "156/TALK"  , "narrator": "高校生アーヤ", "text": "それなら、何が\n$handle$$yobi$の\nメリットなんです？"},
        { "location": "157/SEL"   , "narrator": "（選択肢）", "text": "後でデートして"},
        { "location": "158/SEL"   , "narrator": "（選択肢）", "text": "お金ください"},
        { "location": "159/SEL"   , "narrator": "（選択肢）", "text": "やっぱ見返りはいらない"},
        { "location": "160/ACT"   , "narrator": "", "text": "後でデートして"},
        { "location": "172/DIALOG", "narrator": "", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"},
        { "location": "176/TALK"  , "narrator": "高校生アーヤ", "text": "え……？"},
        { "location": "177/TALK"  , "narrator": "高校生アーヤ", "text": "………。"},
        { "location": "178/SEL"   , "narrator": "（選択肢）", "text": "だめですか？"},
        { "location": "179/ACT"   , "narrator": "", "text": "だめですか？"},
        { "location": "181/TALK"  , "narrator": "高校生アーヤ", "text": "い、いえ。\nダメじゃないけど。"},
        { "location": "182/TALK"  , "narrator": "高校生アーヤ", "text": "私なんかとデートしても\n何もいいことなんて\nないわよ……？"},
        { "location": "183/SEL"   , "narrator": "（選択肢）", "text": "$me$には素晴らしいこと"},
        { "location": "184/ACT"   , "narrator": "", "text": "$me$には素晴らしいこと"},
        { "location": "186/TALK"  , "narrator": "高校生アーヤ", "text": "そう…なの？\nわかりました。"},
        { "location": "187/TALK"  , "narrator": "高校生アーヤ", "text": "なら、それは\n約束する。\nだから――"},
        { "location": "188/TALK"  , "narrator": "高校生アーヤ", "text": "國政綾水の心中の\n空気の乱れを\n共に正してください！"},
        { "location": "189/ACT"   , "narrator": "", "text": "お金ください"},
        { "location": "197/TALK"  , "narrator": "高校生アーヤ", "text": "そう。\nならば私の方から\nお断りします。"},
        { "location": "198/TALK"  , "narrator": "高校生アーヤ", "text": "私が心に入れる存在\nだから、貴方のこと\n期待していたんだけど。"},
        { "location": "199/TALK"  , "narrator": "高校生アーヤ", "text": "私も落ちるところまで\n落ちてしまったのね…。"},
        { "location": "200/TALK"  , "narrator": "高校生アーヤ", "text": "今すぐ出ていって！"},
        { "location": "214/TALK"  , "narrator": "千羽鶴", "text": "あなた……\n心の中でお金を\n請求してどうするの？"},
        { "location": "215/SEL"   , "narrator": "（選択肢）", "text": "さあ……"},
        { "location": "216/ACT"   , "narrator": "", "text": "さあ……"},
        { "location": "218/TALK"  , "narrator": "千羽鶴", "text": "もう少し考えて\n行動したらどう？"},
        { "location": "219/TALK"  , "narrator": "千羽鶴", "text": "一応これでも私は\n貴方に期待してる。"},
        { "location": "220/TALK"  , "narrator": "千羽鶴", "text": "あまり変な事して\n私をびっくり\nさせないでね。"},
        { "location": "232/ACT"   , "narrator": "", "text": "やっぱ見返りはいらない"},
        { "location": "239/TALK"  , "narrator": "高校生アーヤ", "text": "考え直して\nくれたんですね。\nありがとうございます。"},
        { "location": "240/TALK"  , "narrator": "高校生アーヤ", "text": "國政綾水の心中の\n空気の乱れを\n共に正しましょう！"},
        { "location": "254/TALK"  , "narrator": "潜在アーヤ", "text": "え！？\nちょっと……なに？\n高校の頃の私！？"},
        { "location": "257/TALK"  , "narrator": "高校生アーヤ", "text": "問答無用です！\n堕落しきった私を\n叩きつぶします！"},
        { "location": "258/TALK"  , "narrator": "潜在アーヤ", "text": "な、何よ問答無用って！\n全然意味が\nわからないんだけど！"},
        { "location": "259/TALK"  , "narrator": "高校生アーヤ", "text": "分からなくても\n大丈夫です。\nどのみち消えますから。"},
        { "location": "261/TALK"  , "narrator": "高校生アーヤ", "text": "さあ、行きますよ！"},
        { "location": "262/SEL"   , "narrator": "（選択肢）", "text": "任せとけ！"},
        { "location": "263/SEL"   , "narrator": "（選択肢）", "text": "ちょっと待って！"},
        { "location": "264/ACT"   , "narrator": "", "text": "任せとけ！"},
        { "location": "266/TALK"  , "narrator": "潜在アーヤ", "text": "はあ！？\n何それ！"},
        { "location": "270/TALK"  , "narrator": "潜在アーヤ", "text": "もういいわよ。\n聞く耳持たないなら\n徹底攻勢あるのみ。"},
        { "location": "271/TALK"  , "narrator": "潜在アーヤ", "text": "返り討ちに\nしてあげる！"},
        { "location": "278/ACT"   , "narrator": "", "text": "ちょっと待って！"},
        { "location": "280/TALK"  , "narrator": "高校生アーヤ", "text": "何なの！？"},
        { "location": "281/SEL"   , "narrator": "（選択肢）", "text": "やっぱり協力するのやめます"},
        { "location": "282/SEL"   , "narrator": "（選択肢）", "text": "いや、なんでもないです"},
        { "location": "283/ACT"   , "narrator": "", "text": "やっぱり協力するのやめます"},
        { "location": "285/TALK"  , "narrator": "高校生アーヤ", "text": "なんで！？"},
        { "location": "286/SEL"   , "narrator": "（選択肢）", "text": "やり方が強引"},
        { "location": "287/SEL"   , "narrator": "（選択肢）", "text": "堕落したアーヤの方が好み"},
        { "location": "288/ACT"   , "narrator": "", "text": "やり方が強引"},
        { "location": "289/TALK"  , "narrator": "高校生アーヤ", "text": "時として、心を鬼にし\n問答無用で勝負する\n必要もあるのよ！"},
        { "location": "290/ACT"   , "narrator": "", "text": "堕落したアーヤの方が好み"},
        { "location": "291/TALK"  , "narrator": "高校生アーヤ", "text": "……そう。"},
        { "location": "292/TALK"  , "narrator": "高校生アーヤ", "text": "$handle$$yobi$には\n失望した。"},
        { "location": "294/TALK"  , "narrator": "高校生アーヤ", "text": "もういい。\n一人で戦います。"},
        { "location": "295/TALK"  , "narrator": "高校生アーヤ", "text": "$handle$$yobi$は\n即刻この場から\n出ていって！"},
        { "location": "310/TALK"  , "narrator": "千羽鶴", "text": "かわいそうに。\n貴方は根が正直\nすぎるのね。"},
        { "location": "311/TALK"  , "narrator": "千羽鶴", "text": "そんな貴方に、\n千羽鶴のステキ情報を\n教えてあげる。"},
        { "location": "312/TALK"  , "narrator": "千羽鶴", "text": "ココロスフィアは\nそのスフィアごとに\n主が存在する。"},
        { "location": "313/TALK"  , "narrator": "千羽鶴", "text": "主とは、そのスフィアを\n作り出した人格や記憶。"},
        { "location": "314/TALK"  , "narrator": "千羽鶴", "text": "今回は、高校生の姿の\nアーヤが主ね。"},
        { "location": "315/TALK"  , "narrator": "千羽鶴", "text": "主はその世界において\n絶対的な権限を\n持っていて――"},
        { "location": "316/TALK"  , "narrator": "千羽鶴", "text": "気分次第で\nその中にいる住人や\n貴方の排除も可能。"},
        { "location": "317/SEL"   , "narrator": "（選択肢）", "text": "フェノメノンみたい"},
        { "location": "318/ACT"   , "narrator": "", "text": "フェノメノンみたい"},
        { "location": "320/TALK"  , "narrator": "千羽鶴", "text": "いいところに\n気がついた。"},
        { "location": "321/TALK"  , "narrator": "千羽鶴", "text": "そう、心の中は\nフェノメノンと同じ。"},
        { "location": "322/TALK"  , "narrator": "千羽鶴", "text": "だってフェノメノンは\n心の中身が現実に\n具現化したものだから。"},
        { "location": "323/TALK"  , "narrator": "千羽鶴", "text": "そういうわけだから、\nそのスフィアの主には\n気をつけて。"},
        { "location": "324/TALK"  , "narrator": "千羽鶴", "text": "どんな正論を言っても\n聞く耳持たない理不尽な\nスフィアは沢山ある。"},
        { "location": "325/TALK"  , "narrator": "千羽鶴", "text": "今後、進んでいけば\n更に増えていく。"},
        { "location": "326/TALK"  , "narrator": "千羽鶴", "text": "今のうちに慣れて\nココロスフィア渡り\n上手になっておいてね。"},
        { "location": "346/ACT"   , "narrator": "", "text": "いや、なんでもないです"},
        { "location": "347/TALK"  , "narrator": "高校生アーヤ", "text": "そう、よかった。\nそれじゃ改めて、\n共に闘いましょう。"},
        { "location": "349/TALK"  , "narrator": "潜在アーヤ", "text": "はあ！？\n何それ！"},
        { "location": "353/TALK"  , "narrator": "潜在アーヤ", "text": "もういいわよ。\n聞く耳持たないなら\n徹底攻勢あるのみ。"},
        { "location": "354/TALK"  , "narrator": "潜在アーヤ", "text": "返り討ちに\nしてあげる！"},
        { "location": "366/DIALOG", "narrator": "", "text": "<color=black><size=50><b>高校時代のしっかりした\n國政綾水を取り戻せ！</b></size></color>\n\n\n\n大学生になり、上京し、\nだんだんとだらしなくなっているアーヤ。\n\nそのことを憂いでいる人格と協力し、\n高校時代の引き締まったアーヤを\n取り戻させよう。\n\nもちろんそれが正しいかどうかはわからない。\nけど、勝てばデートが待っている！"}
    ]
}
