        { "location": "1241/DIALOG"  , "narrator": "Tutorial/Dialog_Anime2", "text": "$dialog_word$"},
        { "location": "1243/DIALOG"  , "narrator": "Tutorial/Dialog_Anime3", "text": "$dialog_word$"},
        { "location": "1245/DIALOG"  , "narrator": "Tutorial/Dialog_Anime4", "text": "$dialog_word$"},
