        "title": "001 アニメーション",
        "sub_title": "しあわせのワルツ"
    },
    "entry":
    [
        { "location": "1026/SCENARIO", "narrator": "", "text": "アニメ第20話"},
        { "location": "1038/TALK"    , "narrator": "赤髪千羽鶴", "text": "こんにちは、\n$handle$さん。"},
        { "location": "1039/TALK"    , "narrator": "赤髪千羽鶴", "text": "もう一度わたしと話を\nしていきますか？"},
        { "location": "1040/SEL"     , "narrator": "", "text": "はい"},
        { "location": "1041/SEL"     , "narrator": "", "text": "いいえ"},
        { "location": "1042/ACT"     , "narrator": "", "text": "はい"},
        { "location": "1043/TALK"    , "narrator": "赤髪千羽鶴", "text": "わかりました。\nそれでは……。"},
        { "location": "1045/ACT"     , "narrator": "", "text": "いいえ"},
        { "location": "1046/TALK"    , "narrator": "赤髪千羽鶴", "text": "わかりました。\nそれではこれで。"},
        { "location": "1052/TALK"    , "narrator": "赤髪千羽鶴", "text": "こんにちは、\n$handle$さん。"},
        { "location": "1053/TALK"    , "narrator": "赤髪千羽鶴", "text": "今回は早速の\n本題になりますが。"},
        { "location": "1054/TALK"    , "narrator": "赤髪千羽鶴", "text": "世界に関わるか否かを\n今から固定します。"},
        { "location": "1055/TALK"    , "narrator": "赤髪千羽鶴", "text": "準備は\nよろしいでしょうか。"},
        { "location": "1056/SEL"     , "narrator": "", "text": "はい"},
        { "location": "1057/SEL"     , "narrator": "", "text": "まだ"},
        { "location": "1058/ACT"     , "narrator": "", "text": "はい"},
        { "location": "1059/TALK"    , "narrator": "赤髪千羽鶴", "text": "わかりました。"},
        { "location": "1060/TALK"    , "narrator": "赤髪千羽鶴", "text": "それでは、これより\n最終合意の為の\n署名をして頂きます。"},
        { "location": "1061/TALK"    , "narrator": "赤髪千羽鶴", "text": "と言いましても、\nいつもと同じように\nボタンを押すだけですが。"},
        { "location": "1062/TALK"    , "narrator": "赤髪千羽鶴", "text": "そして合意をすると、\nその直後から、世界への\n関わり方が固定されます。"},
        { "location": "1063/TALK"    , "narrator": "赤髪千羽鶴", "text": "ですから――"},
        { "location": "1064/TALK"    , "narrator": "赤髪千羽鶴", "text": "まだ決められない、\nという方は、その手前で\nアプリをキルするか。"},
        { "location": "1065/TALK"    , "narrator": "赤髪千羽鶴", "text": "もしくは、合意しない\nというボタンを\n押して下さいね。"},
        { "location": "1066/TALK"    , "narrator": "赤髪千羽鶴", "text": "それでは、\nよろしくお願いします。"},
        { "location": "1077/SEL"     , "narrator": "", "text": "【彼女たちとイチャイチャラブラブしたい】での固定に合意する"},
        { "location": "1078/SEL"     , "narrator": "", "text": "合意しない"},
        { "location": "1079/ACT"     , "narrator": "", "text": "【彼女たちとイチャイチャラブラブしたい】での固定に合意する"},
        { "location": "1081/ACT"     , "narrator": "", "text": "合意しない"},
        { "location": "1082/TALK"    , "narrator": "赤髪千羽鶴", "text": "わかりました。"},
        { "location": "1083/TALK"    , "narrator": "赤髪千羽鶴", "text": "それでは一旦中断\nしますので、またここへ\nいらしてください。"},
        { "location": "1089/SEL"     , "narrator": "", "text": "【世界の選択に関わりたい】での固定に合意する"},
        { "location": "1090/SEL"     , "narrator": "", "text": "合意しない"},
        { "location": "1091/ACT"     , "narrator": "", "text": "【世界の選択に関わりたい】での固定に合意する"},
        { "location": "1093/ACT"     , "narrator": "", "text": "合意しない"},
        { "location": "1094/TALK"    , "narrator": "赤髪千羽鶴", "text": "わかりました。"},
        { "location": "1095/TALK"    , "narrator": "赤髪千羽鶴", "text": "それでは一旦中断\nしますので、またここへ\nいらしてください。"},
        { "location": "1105/TALK"    , "narrator": "赤髪千羽鶴", "text": "……。"},
        { "location": "1107/TALK"    , "narrator": "赤髪千羽鶴", "text": "固定化されました。"},
        { "location": "1111/TALK"    , "narrator": "赤髪千羽鶴", "text": "というわけで！"},
        { "location": "1112/TALK"    , "narrator": "赤髪千羽鶴", "text": "$handle$さんは\nこれから難しいことを\n考えなくても大丈夫です！"},
        { "location": "1113/TALK"    , "narrator": "赤髪千羽鶴", "text": "彼女たちとの\nラブラブな日々を\nご堪能ください！"},
        { "location": "1114/TALK"    , "narrator": "赤髪千羽鶴", "text": "世界の行く末は、\n是非わたしたちに\nお任せ下さい！"},
        { "location": "1115/TALK"    , "narrator": "赤髪千羽鶴", "text": "そして――"},
        { "location": "1116/TALK"    , "narrator": "赤髪千羽鶴", "text": "これからも、時間が\n出来たら是非、デートに\nお付き合いくださいね。"},
        { "location": "1118/TALK"    , "narrator": "赤髪千羽鶴", "text": "というわけで！"},
        { "location": "1119/TALK"    , "narrator": "赤髪千羽鶴", "text": "$handle$さんは\nわたしたちの世界に\n関わりたいと。"},
        { "location": "1120/TALK"    , "narrator": "赤髪千羽鶴", "text": "責任を持って、\n善い方向に導いてくれると\nいうことですね！"},
        { "location": "1121/TALK"    , "narrator": "赤髪千羽鶴", "text": "あっ、もちろん\n丸投げではありませんから\n安心して下さい！"},
        { "location": "1122/TALK"    , "narrator": "赤髪千羽鶴", "text": "これからもわたしが\n$handle$さんに\n助言をして行きますから。"},
        { "location": "1123/TALK"    , "narrator": "赤髪千羽鶴", "text": "というわけで、\n改めてよろしく\nお願い申し上げます！"},
        { "location": "1145/TALK"    , "narrator": "赤髪千羽鶴", "text": "ところで――"},
        { "location": "1146/TALK"    , "narrator": "赤髪千羽鶴", "text": "$handle$さんには\nもう１つ、相談したい\nことがあるんです。"},
        { "location": "1147/SEL"     , "narrator": "", "text": "なに？"},
        { "location": "1148/ACT"     , "narrator": "", "text": "なに？"},
        { "location": "1150/TALK"    , "narrator": "赤髪千羽鶴", "text": "えっとですね……\nその……"},
        { "location": "1151/TALK"    , "narrator": "赤髪千羽鶴", "text": "嫌なら全然\n断ってくれて\n構わないのですが。"},
        { "location": "1152/SEL"     , "narrator": "", "text": "…？"},
        { "location": "1153/ACT"     , "narrator": "", "text": "…？"},
        { "location": "1155/TALK"    , "narrator": "赤髪千羽鶴", "text": "……。"},
        { "location": "1159/TALK"    , "narrator": "赤髪千羽鶴", "text": "わたしの右腕に\nなって頂けませんか？"},
        { "location": "1160/SEL"     , "narrator": "", "text": "喜んで！"},
        { "location": "1161/SEL"     , "narrator": "", "text": "ちょっと説明が欲しい"},
        { "location": "1162/ACT"     , "narrator": "", "text": "喜んで！"},
        { "location": "1164/TALK"    , "narrator": "赤髪千羽鶴", "text": "えっ！"},
        { "location": "1165/TALK"    , "narrator": "赤髪千羽鶴", "text": "あの……"},
        { "location": "1166/TALK"    , "narrator": "赤髪千羽鶴", "text": "どういう事なのか、\n聞かなくても\nいいんですか？"},
        { "location": "1167/SEL"     , "narrator": "", "text": "$me$は原初のつばめを一番大事だと思ってるから全然構わない"},
        { "location": "1168/SEL"     , "narrator": "", "text": "…教えてください"},
        { "location": "1169/ACT"     , "narrator": "", "text": "$me$は原初のつばめを一番大事だと思ってるから全然構わない"},
        { "location": "1170/TALK"    , "narrator": "赤髪千羽鶴", "text": "そうですか……。"},
        { "location": "1171/TALK"    , "narrator": "赤髪千羽鶴", "text": "ありがとうございます！\nとても嬉しいです！"},
        { "location": "1173/ACT"     , "narrator": "", "text": "…教えてください"},
        { "location": "1174/TALK"    , "narrator": "赤髪千羽鶴", "text": "あ、はい……。"},
        { "location": "1177/ACT"     , "narrator": "", "text": "ちょっと説明が欲しい"},
        { "location": "1178/TALK"    , "narrator": "赤髪千羽鶴", "text": "あ、はい。\nもちろんです！"},
        { "location": "1181/TALK"    , "narrator": "赤髪千羽鶴", "text": "$handle$さんと\nお付き合いしていて、\nだいぶ長くなりますよね。"},
        { "location": "1182/TALK"    , "narrator": "赤髪千羽鶴", "text": "その中で、いろんな\n訓練をしたり、スタンスを\n聞いたりしてきました。"},
        { "location": "1183/TALK"    , "narrator": "赤髪千羽鶴", "text": "そしてその回答が、\n私の考えとすごく近くて\nビックリしていたんです。"},
        { "location": "1184/TALK"    , "narrator": "赤髪千羽鶴", "text": "だから、きっと\n$handle$さんとなら\n上手くやっていける――"},
        { "location": "1185/TALK"    , "narrator": "赤髪千羽鶴", "text": "そう思って、\n思い切って\n聞いてみました！"},
        { "location": "1186/TALK"    , "narrator": "赤髪千羽鶴", "text": "わたしの思想としては、\n何かを動かす時に、沢山の\n人は要らないんです。"},
        { "location": "1187/TALK"    , "narrator": "赤髪千羽鶴", "text": "洗練された少数の\nブレーンが舵を切り、\n皆がそれで幸せになる。"},
        { "location": "1188/TALK"    , "narrator": "赤髪千羽鶴", "text": "これがわたしの\n理想なんですよ。"},
        { "location": "1189/TALK"    , "narrator": "赤髪千羽鶴", "text": "その為には、ブレーンは\n本当に一枚岩になれる信頼\n関係を築く必要がある。"},
        { "location": "1190/TALK"    , "narrator": "赤髪千羽鶴", "text": "そして、わたしと一緒に\nそれができる人は、\nとても限られています。"},
        { "location": "1191/TALK"    , "narrator": "赤髪千羽鶴", "text": "わたしにとって、\nあなたはその限られた人\nという気がするんです。"},
        { "location": "1194/TALK"    , "narrator": "赤髪千羽鶴", "text": "……なんて。"},
        { "location": "1195/TALK"    , "narrator": "赤髪千羽鶴", "text": "急に言われても、\n返答に困ると\n思いますし――"},
        { "location": "1196/TALK"    , "narrator": "赤髪千羽鶴", "text": "お返事は、次にお逢いした\n時に聞こうと思います！"},
        { "location": "1198/TALK"    , "narrator": "赤髪千羽鶴", "text": "それまでに、\nどうか考えておいて\nくださいね♪"},
        { "location": "1201/TALK"    , "narrator": "赤髪千羽鶴", "text": "さて、この後ですが――"},
        { "location": "1202/TALK"    , "narrator": "赤髪千羽鶴", "text": "前回と同じように\nこのセクションの記録\n映像を見ていきますか？"},
        { "location": "1203/TALK"    , "narrator": "赤髪千羽鶴", "text": "今のスタックポインタは\n記録映像でいえば\n2016年8月30日――"},
        { "location": "1204/TALK"    , "narrator": "赤髪千羽鶴", "text": "夏休みの強化合宿も\nあと少しで終わり…\nといった頃になります。"},
        { "location": "1205/ACT"     , "narrator": "", "text": "まだ"},
        { "location": "1206/TALK"    , "narrator": "赤髪千羽鶴", "text": "わかりました。"},
        { "location": "1207/TALK"    , "narrator": "赤髪千羽鶴", "text": "それでは、準備ができたら\nまたいらしてくださいね。"},
        { "location": "1211/SEL"     , "narrator": "", "text": "映像を見る\n<color=green>【高画質/67MB 4:18】</color>"},
        { "location": "1212/SEL"     , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/22MB 4:18】</color>"},
        { "location": "1213/SEL"     , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "1214/ACT"     , "narrator": "", "text": "映像を見る\n<color=green>【高画質/67MB 4:18】</color>"},
        { "location": "1215/TALK"    , "narrator": "赤髪千羽鶴", "text": "わかりました。\nそれでは再生しましょう。"},
        { "location": "1221/ACT"     , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/22MB 4:18】</color>"},
        { "location": "1222/TALK"    , "narrator": "赤髪千羽鶴", "text": "わかりました。\nそれでは再生しましょう。"},
        { "location": "1228/ACT"     , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "1229/TALK"    , "narrator": "赤髪千羽鶴", "text": "わかりました。\nそれではレポートを\nご覧下さい。"},
        { "location": "1262/TALK"    , "narrator": "赤髪千羽鶴", "text": "さて。"},
        { "location": "1264/TALK"    , "narrator": "赤髪千羽鶴", "text": "今回は、わたしから\nお願いしたい事が\nあります。"},
        { "location": "1265/TALK"    , "narrator": "赤髪千羽鶴", "text": "それは、\n千羽鶴への助言です！"},
        { "location": "1266/SEL"     , "narrator": "", "text": "何するの？"},
        { "location": "1267/ACT"     , "narrator": "", "text": "何するの？"},
        { "location": "1269/TALK"    , "narrator": "赤髪千羽鶴", "text": "前回、卯月さんから\n鋭い質問が来て、千羽鶴が\n悩んでいるようですが――"},
        { "location": "1270/TALK"    , "narrator": "赤髪千羽鶴", "text": "ちゃんと、\n本当のことを言うよう\n進言してください。"},
        { "location": "1271/SEL"     , "narrator": "", "text": "わかった"},
        { "location": "1272/SEL"     , "narrator": "", "text": "わからない"},
        { "location": "1273/ACT"     , "narrator": "", "text": "わかった"},
        { "location": "1274/TALK"    , "narrator": "赤髪千羽鶴", "text": "ありがとうございます！"},
        { "location": "1275/TALK"    , "narrator": "赤髪千羽鶴", "text": "千羽鶴の\nWAVEアカウントを\n登録しておきますね。"},
        { "location": "1276/TALK"    , "narrator": "赤髪千羽鶴", "text": "それでは、\nよろしくお願いします！"},
        { "location": "1277/ACT"     , "narrator": "", "text": "わからない"},
        { "location": "1278/TALK"    , "narrator": "赤髪千羽鶴", "text": "？"},
        { "location": "1279/TALK"    , "narrator": "赤髪千羽鶴", "text": "何がですか？"},
        { "location": "1280/SEL"     , "narrator": "", "text": "つばめがどうしてこんなに可愛いのか、その理由がわからない"},
        { "location": "1281/SEL"     , "narrator": "", "text": "どうしてこの世界は平和なまま続いて行くことができているのか、わからない"},
        { "location": "1282/SEL"     , "narrator": "", "text": "何故会社に行かなくてはならないのか、わからない"},
        { "location": "1283/SEL"     , "narrator": "", "text": "何故つばめがそんなことを言うのかわからない"},
        { "location": "1284/SEL"     , "narrator": "", "text": "今日の晩ご飯は何なのかわからない"},
        { "location": "1285/SEL"     , "narrator": "", "text": "どうして大好きなあの子が$me$の方を向いてくれないのかわからない"},
        { "location": "1286/SEL"     , "narrator": "", "text": "どうしてこっちの世界でTRI-OSがもっと普及しないのかわからない"},
        { "location": "1287/SEL"     , "narrator": "", "text": "何がわからないのかわからなくなった"},
        { "location": "1288/ACT"     , "narrator": "", "text": "つばめがどうしてこんなに可愛いのか、その理由がわからない"},
        { "location": "1290/TALK"    , "narrator": "赤髪千羽鶴", "text": "いや、その……"},
        { "location": "1291/TALK"    , "narrator": "赤髪千羽鶴", "text": "全然可愛くなんて\nありませんから。"},
        { "location": "1292/TALK"    , "narrator": "赤髪千羽鶴", "text": "わたしが可愛いなら、\n世の中の全ての女性は\n更に可愛いですよ？"},
        { "location": "1294/ACT"     , "narrator": "", "text": "どうしてこの世界は平和なまま続いて行くことができているのか、わからない"},
        { "location": "1295/TALK"    , "narrator": "赤髪千羽鶴", "text": "それは、あなたの世界の\n総意がそれを望んでいる\nからに他なりません。"},
        { "location": "1296/TALK"    , "narrator": "赤髪千羽鶴", "text": "毎回同じ事を\n言うようで恐縮ですが……"},
        { "location": "1297/TALK"    , "narrator": "赤髪千羽鶴", "text": "$handle$さんの\n想いは、自分が思うより\n遙かに強いんです。"},
        { "location": "1298/TALK"    , "narrator": "赤髪千羽鶴", "text": "潜在意識が本当に\n思っていることは、大抵\n実現してしまうんです。"},
        { "location": "1299/TALK"    , "narrator": "赤髪千羽鶴", "text": "それが、\n善いことでも\n悪いことでも。"},
        { "location": "1300/TALK"    , "narrator": "赤髪千羽鶴", "text": "だからこそ、\n自分の考えを持つことが\n大事なんですよ。"},
        { "location": "1301/ACT"     , "narrator": "", "text": "何故会社に行かなくてはならないのか、わからない"},
        { "location": "1302/TALK"    , "narrator": "赤髪千羽鶴", "text": "そうすることによって、\n結果的にあなたに幸せが\n回って来るからです。"},
        { "location": "1303/TALK"    , "narrator": "赤髪千羽鶴", "text": "逆に$handle$さんが\n働かない場合、他の人にも\n同じことが許されます。"},
        { "location": "1304/TALK"    , "narrator": "赤髪千羽鶴", "text": "そうなれば、街中は\nゴミだらけになり、\n物は売られなくなり。"},
        { "location": "1305/TALK"    , "narrator": "赤髪千羽鶴", "text": "全てを自分で\nやらねばならず。"},
        { "location": "1306/TALK"    , "narrator": "赤髪千羽鶴", "text": "今とは比較にならない程の\n苦難があなたを襲うことに\nなると思います！"},
        { "location": "1307/TALK"    , "narrator": "赤髪千羽鶴", "text": "$handle$さんが\n頑張って働くことで、\n誰かが幸せになれます。"},
        { "location": "1308/TALK"    , "narrator": "赤髪千羽鶴", "text": "その人の幸せエネルギーは\n回り回って、沢山の人を\n経由して――"},
        { "location": "1309/TALK"    , "narrator": "赤髪千羽鶴", "text": "$handle$さんが\n幸せだと思う何かに\n結びついて戻って来ます。"},
        { "location": "1310/TALK"    , "narrator": "赤髪千羽鶴", "text": "これは本当ですよ？"},
        { "location": "1311/ACT"     , "narrator": "", "text": "何故つばめがそんなことを言うのかわからない"},
        { "location": "1312/TALK"    , "narrator": "赤髪千羽鶴", "text": "そんなことって、\nどんなことですか？"},
        { "location": "1313/SEL"     , "narrator": "", "text": "千羽鶴に介入しろとか！ていうか神楽CHだよここ"},
        { "location": "1314/SEL"     , "narrator": "", "text": "千羽鶴に本当の事を言うように伝えること"},
        { "location": "1315/ACT"     , "narrator": "", "text": "千羽鶴に介入しろとか！ていうか神楽CHだよここ"},
        { "location": "1316/TALK"    , "narrator": "赤髪千羽鶴", "text": "まあ、確かに\nそうですよね。"},
        { "location": "1317/TALK"    , "narrator": "赤髪千羽鶴", "text": "でも、他の子に影響を\n与えて、そこからメスを\n入れる事もよくあります。"},
        { "location": "1318/TALK"    , "narrator": "赤髪千羽鶴", "text": "今まであまり無かったかも\nしれませんが、特段ヘンな\nことでもありませんよ？"},
        { "location": "1319/ACT"     , "narrator": "", "text": "千羽鶴に本当の事を言うように伝えること"},
        { "location": "1320/TALK"    , "narrator": "赤髪千羽鶴", "text": "え？\nそんなにヘンなことを\n言ってますか？"},
        { "location": "1321/TALK"    , "narrator": "赤髪千羽鶴", "text": "わたしは彼女とその先に\nある未来にとって良かれと\n思い依頼してるだけです。"},
        { "location": "1322/TALK"    , "narrator": "赤髪千羽鶴", "text": "他からは見えなくても、\nわたしから見えることは\n多いんです。"},
        { "location": "1323/TALK"    , "narrator": "赤髪千羽鶴", "text": "なにぶん、この\nフェノメノンの\n創造主ですから。"},
        { "location": "1324/TALK"    , "narrator": "赤髪千羽鶴", "text": "とはいえ、\nもちろん強制では\nありませんから――"},
        { "location": "1325/TALK"    , "narrator": "赤髪千羽鶴", "text": "何らかの理由で\nやりたくない場合は、\n無理にとは言いません。"},
        { "location": "1326/TALK"    , "narrator": "赤髪千羽鶴", "text": "今まで大変な訓練を\n二度も受けてきた\n貴方ですから――"},
        { "location": "1327/TALK"    , "narrator": "赤髪千羽鶴", "text": "ちゃんと自分で考えて\n悔いのない行動することが\nベストだと思います。"},
        { "location": "1329/ACT"     , "narrator": "", "text": "今日の晩ご飯は何なのかわからない"},
        { "location": "1330/TALK"    , "narrator": "赤髪千羽鶴", "text": "それは……"},
        { "location": "1331/TALK"    , "narrator": "赤髪千羽鶴", "text": "あなたのママに\n聞いてみて下さい。"},
        { "location": "1332/ACT"     , "narrator": "", "text": "どうして大好きなあの子が$me$の方を向いてくれないのかわからない"},
        { "location": "1333/TALK"    , "narrator": "赤髪千羽鶴", "text": "それは、その子の視野角が\n狭いか、注意力に問題が\nあるのかもしれません。"},
        { "location": "1334/TALK"    , "narrator": "赤髪千羽鶴", "text": "どうしても振り向いて\n欲しいなら、今度は大きな\n声で呼んでみてください！"},
        { "location": "1335/TALK"    , "narrator": "赤髪千羽鶴", "text": "きっと気づいて\n貴方の方を向いてくれると\n思います！"},
        { "location": "1336/ACT"     , "narrator": "", "text": "どうしてこっちの世界でTRI-OSがもっと普及しないのかわからない"},
        { "location": "1337/TALK"    , "narrator": "赤髪千羽鶴", "text": "それは永遠の命題です。"},
        { "location": "1338/TALK"    , "narrator": "赤髪千羽鶴", "text": "Redinessは、\nわたしたちの世界では\nもはや国際標準です。"},
        { "location": "1339/TALK"    , "narrator": "赤髪千羽鶴", "text": "このテクノロジーが\nあなたの世界でも\n受け入れられれば――"},
        { "location": "1340/TALK"    , "narrator": "赤髪千羽鶴", "text": "今後のビジネスが国際化を\n超えて、世界際化するかも\nしれませんよね！"},
        { "location": "1341/TALK"    , "narrator": "赤髪千羽鶴", "text": "二世界間貿易のルールは、\nとても複雑そうですが！"},
        { "location": "1342/ACT"     , "narrator": "", "text": "何がわからないのかわからなくなった"},
        { "location": "1343/TALK"    , "narrator": "赤髪千羽鶴", "text": "大きく息を吸って――"},
        { "location": "1344/TALK"    , "narrator": "赤髪千羽鶴", "text": "吐いて――"},
        { "location": "1345/TALK"    , "narrator": "赤髪千羽鶴", "text": "目を瞑ってください。"},
        { "location": "1346/TALK"    , "narrator": "赤髪千羽鶴", "text": "そして、優しく風が\n吹き抜ける草原を\n想い描いてください。"},
        { "location": "1347/TALK"    , "narrator": "赤髪千羽鶴", "text": "だんだん落ち着いて\nきましたね！"},
        { "location": "1348/TALK"    , "narrator": "赤髪千羽鶴", "text": "混乱したときは是非、\nあなたの住む世界から\n一旦離れてみてください。"},
        { "location": "1349/TALK"    , "narrator": "赤髪千羽鶴", "text": "そうすると、\n心の整理が出来て\nとても良いと思います。"},
        { "location": "1351/TALK"    , "narrator": "赤髪千羽鶴", "text": "というわけで、\n解決したところで。"},
        { "location": "1352/TALK"    , "narrator": "赤髪千羽鶴", "text": "千羽鶴の\nWAVEアカウントを\n登録しておきますね。"},
        { "location": "1353/TALK"    , "narrator": "赤髪千羽鶴", "text": "今回もこの世界のこと、\nよろしくお願いします！"},
        { "location": "1357/TALK"    , "narrator": "赤髪千羽鶴", "text": "既にお楽しみ戴けている\nとは思いますが！"},
        { "location": "1358/TALK"    , "narrator": "赤髪千羽鶴", "text": "前回から、トライナリーの\n皆と心置きなくラブラブ\nできるようになりました！"},
        { "location": "1359/TALK"    , "narrator": "赤髪千羽鶴", "text": "今回も引き続き、\n海でのエピソードを\nお楽しみ下さいね！"},
        { "location": "1361/TALK"    , "narrator": "赤髪千羽鶴", "text": "いつも通り、\n私の方からは特に\n何もありません。"},
        { "location": "1362/TALK"    , "narrator": "赤髪千羽鶴", "text": "では、またです。"},
        { "location": "1363/SEL"     , "narrator": "", "text": "またね"},
        { "location": "1364/SEL"     , "narrator": "", "text": "待って、もしかして前回リプレイスしなかったから怒ってる？"},
        { "location": "1365/ACT"     , "narrator": "", "text": "またね"},
        { "location": "1366/ACT"     , "narrator": "", "text": "待って、もしかして前回リプレイスしなかったから怒ってる？"},
        { "location": "1367/TALK"    , "narrator": "赤髪千羽鶴", "text": "いえ、全然。"},
        { "location": "1368/TALK"    , "narrator": "赤髪千羽鶴", "text": "逆に質問しますが――"},
        { "location": "1369/TALK"    , "narrator": "赤髪千羽鶴", "text": "$handle$さんは\n何故リプレイスを\nしなかったんですか？"},
        { "location": "1370/SEL"     , "narrator": "", "text": "千羽鶴を踏みにじる行為だ"},
        { "location": "1371/SEL"     , "narrator": "", "text": "神楽が可哀想"},
        { "location": "1372/SEL"     , "narrator": "", "text": "良い作戦だとは思えない"},
        { "location": "1373/SEL"     , "narrator": "", "text": "世界を変えることに恐怖を感じた"},
        { "location": "1374/ACT"     , "narrator": "", "text": "千羽鶴を踏みにじる行為だ"},
        { "location": "1376/TALK"    , "narrator": "赤髪千羽鶴", "text": "確かに。"},
        { "location": "1377/TALK"    , "narrator": "赤髪千羽鶴", "text": "俯瞰的立場から千羽鶴に\n不利な情報を供与するのは\nフェアじゃありませんね。"},
        { "location": "1378/TALK"    , "narrator": "赤髪千羽鶴", "text": "$handle$さんの\n仰ることは、\nもっともだと思います。"},
        { "location": "1379/ACT"     , "narrator": "", "text": "神楽が可哀想"},
        { "location": "1381/TALK"    , "narrator": "赤髪千羽鶴", "text": "なるほど。"},
        { "location": "1382/TALK"    , "narrator": "赤髪千羽鶴", "text": "確かに考えようによっては\n卯月さんはあなたや\nエリカの傀儡ともいえる。"},
        { "location": "1383/TALK"    , "narrator": "赤髪千羽鶴", "text": "それは決して彼女の\n意見では無いのに――"},
        { "location": "1384/TALK"    , "narrator": "赤髪千羽鶴", "text": "万一失敗したら、\n被害を被るのは\n卯月さんだけです。"},
        { "location": "1385/SEL"     , "narrator": "", "text": "そのとおり！"},
        { "location": "1386/SEL"     , "narrator": "", "text": "そういう理由じゃないんだけど"},
        { "location": "1387/ACT"     , "narrator": "", "text": "そのとおり！"},
        { "location": "1388/TALK"    , "narrator": "赤髪千羽鶴", "text": "そこまで卯月さんのことを\n大切にしているあなたに\n敬意を表します。"},
        { "location": "1389/TALK"    , "narrator": "赤髪千羽鶴", "text": "これからもあなたの良いと\n思った方法で、卯月さんを\n護ってあげてください。"},
        { "location": "1390/ACT"     , "narrator": "", "text": "そういう理由じゃないんだけど"},
        { "location": "1391/TALK"    , "narrator": "赤髪千羽鶴", "text": "そうですか。"},
        { "location": "1392/TALK"    , "narrator": "赤髪千羽鶴", "text": "すみません、私の凡な\n想像力だと、他の理由は\n思いつかず…。"},
        { "location": "1393/TALK"    , "narrator": "赤髪千羽鶴", "text": "とにかく、想いは\nちゃんと受け取りました！"},
        { "location": "1395/ACT"     , "narrator": "", "text": "良い作戦だとは思えない"},
        { "location": "1397/TALK"    , "narrator": "赤髪千羽鶴", "text": "なるほど。"},
        { "location": "1398/TALK"    , "narrator": "赤髪千羽鶴", "text": "ならば、\n何も気にすることは\n無いと思います。"},
        { "location": "1399/TALK"    , "narrator": "赤髪千羽鶴", "text": "もっとも、特に気にして\nいるわけではないのかも\nしれませんが。"},
        { "location": "1400/TALK"    , "narrator": "赤髪千羽鶴", "text": "これからもあなたの良いと\n思った方法で、世界に\n関わっていってください！"},
        { "location": "1401/ACT"     , "narrator": "", "text": "世界を変えることに恐怖を感じた"},
        { "location": "1403/TALK"    , "narrator": "赤髪千羽鶴", "text": "あぁ、わかります、\nその気持ち。"},
        { "location": "1404/TALK"    , "narrator": "赤髪千羽鶴", "text": "わたしもよく\nその感覚に襲われます。"},
        { "location": "1405/TALK"    , "narrator": "赤髪千羽鶴", "text": "でも、大丈夫ですよ！"},
        { "location": "1406/TALK"    , "narrator": "赤髪千羽鶴", "text": "どんな選択をしても、\n大地が消えて\n無くなったり――"},
        { "location": "1407/TALK"    , "narrator": "赤髪千羽鶴", "text": "一億人が一瞬で\n蒸発したりはしません！"},
        { "location": "1408/TALK"    , "narrator": "赤髪千羽鶴", "text": "ですから、あなたが\nちゃんと自分の強い想いを\n持って決めた事なら――"},
        { "location": "1409/TALK"    , "narrator": "赤髪千羽鶴", "text": "どんな事態に陥っても、\n諦めなければ必ず\n良い結果に繋がります。"},
        { "location": "1411/TALK"    , "narrator": "赤髪千羽鶴", "text": "というわけで、\nわたしが怒ってるんじゃ\nないかとか――"},
        { "location": "1412/TALK"    , "narrator": "赤髪千羽鶴", "text": "そういった、\n懸念されているような事は\n全部杞憂です。"},
        { "location": "1413/TALK"    , "narrator": "赤髪千羽鶴", "text": "ですから、これからも\n自分の信念を貫いて\nいってください。"},
        { "location": "1414/TALK"    , "narrator": "赤髪千羽鶴", "text": "それでは今回も、\n頑張って下さいね！"},
        { "location": "1069/DIALOG"  , "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:navigator】</color>\n\n貴方の選択は既に<color=red>【正直、難しいことはもういいです。彼女たちとイチャイチャラブラブしたい】</color>で固定されています。\n"},
        { "location": "1071/DIALOG"  , "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:navigator】</color>\n\n貴方の選択は既に<color=red>【現在の貴方の選択は【世界の選択に関わりたい】</color>で固定されています。\n"},
        { "location": "1076/DIALOG"  , "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:navigator】</color>\n\nこの後に表示される\n選択肢に『合意する』ことで\nあなたが世界に関わるか\n否かが決定されます。\n\n<color=red>現在の貴方の選択は【正直、難しいことはもういいです。彼女たちとイチャイチャラブラブしたい】です。</color>\n"},
        { "location": "1088/DIALOG"  , "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:navigator】</color>\n\nこの後に表示される\n選択肢に『合意する』ことで\nあなたが世界に関わるか\n否かが決定されます。\n\n<color=red>現在の貴方の選択は【世界の選択に関わりたい】です。</color>\n"},
        { "location": "1100/DIALOG"  , "narrator": "Dialog_Alert", "text": "<color=green>【TRI-OS Plug-in:navigator】</color>\n\n不正な処理が検知されました。\nプロセスを終了します。"},
