{
    "dir": "chap30/daydra/anime_05_30.js",
    "type": "MainStory",
    "info": {
        "story_id": "30501",
        "cid": "kagura",
        "title": "001 アニメーション",
        "sub_title": "NYABONYASTIE 第四巻"
    },
    "entry":
    [
        { "location": "1138/SCENARIO", "narrator": "", "text": "アニメ第30話"},
        { "location": "1151/TALK"    , "narrator": "千羽鶴", "text": "ごきげんよう、\n$handle$。"},
        { "location": "1152/TALK"    , "narrator": "千羽鶴", "text": "もう一度\n私との会話を\n再現する？"},
        { "location": "1153/SEL"     , "narrator": "", "text": "はい"},
        { "location": "1154/SEL"     , "narrator": "", "text": "いいえ"},
        { "location": "1155/SEL"     , "narrator": "", "text": "にゃボットの解説だけ聞く"},
        { "location": "1156/ACT"     , "narrator": "", "text": "はい"},
        { "location": "1157/TALK"    , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "1159/ACT"     , "narrator": "", "text": "いいえ"},
        { "location": "1160/TALK"    , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "1162/ACT"     , "narrator": "", "text": "にゃボットの解説だけ聞く"},
        { "location": "1163/TALK"    , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "1172/TALK"    , "narrator": "千羽鶴", "text": "<size=40>どーん！</size>"},
        { "location": "1173/TALK"    , "narrator": "千羽鶴", "text": "というわけで、\n今回は特別回！"},
        { "location": "1174/TALK"    , "narrator": "千羽鶴", "text": "$handle$が\n頑張ってくれたお陰で\n私は今ここにいる。"},
        { "location": "1175/TALK"    , "narrator": "千羽鶴", "text": "ここにいるなら、\nここにいるだけの\n価値を作らねばならない！"},
        { "location": "1176/SEL"     , "narrator": "", "text": "千羽鶴キター"},
        { "location": "1177/SEL"     , "narrator": "", "text": "何やるの？"},
        { "location": "1178/ACT"     , "narrator": "", "text": "千羽鶴キター"},
        { "location": "1179/ACT"     , "narrator": "", "text": "何やるの？"},
        { "location": "1181/TALK"    , "narrator": "千羽鶴", "text": "というわけで、\n今回のゲームは超力作！"},
        { "location": "1186/TALK"    , "narrator": "千羽鶴", "text": "<size=35><color=red>トライナリー\n彼女を救え！ゲーム！</color></size>"},
        { "location": "1187/SEL"     , "narrator": "", "text": "ドンドンパフパフ！"},
        { "location": "1188/SEL"     , "narrator": "", "text": "え？え？え？"},
        { "location": "1189/SEL"     , "narrator": "", "text": "そんな事やってる暇あんの？"},
        { "location": "1190/ACT"     , "narrator": "", "text": "ドンドンパフパフ！"},
        { "location": "1192/ACT"     , "narrator": "", "text": "え？え？え？"},
        { "location": "1193/TALK"    , "narrator": "千羽鶴", "text": "驚きすぎ。"},
        { "location": "1194/ACT"     , "narrator": "", "text": "そんな事やってる暇あんの？"},
        { "location": "1195/TALK"    , "narrator": "千羽鶴", "text": "今回はMV回。\nMV回はTRI-OSが\nガベコレする時間。"},
        { "location": "1196/SEL"     , "narrator": "", "text": "そうですね"},
        { "location": "1197/SEL"     , "narrator": "", "text": "ガベコレってなんだっけ？"},
        { "location": "1198/ACT"     , "narrator": "", "text": "そうですね"},
        { "location": "1199/TALK"    , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "1200/ACT"     , "narrator": "", "text": "ガベコレってなんだっけ？"},
        { "location": "1201/TALK"    , "narrator": "千羽鶴", "text": "ガベージコレクション。\nシステムの最適化と\nゴミ捨てをする時間。"},
        { "location": "1203/TALK"    , "narrator": "千羽鶴", "text": "だから、ろくに何の機能も\n動かないし、未来に対して\nアプローチもできない。"},
        { "location": "1207/TALK"    , "narrator": "千羽鶴", "text": "<color=red><size=40>遊ぶが吉！</size></color>"},
        { "location": "1208/TALK"    , "narrator": "千羽鶴", "text": "人生ゆとりもまた\n必要だと思う。"},
        { "location": "1209/TALK"    , "narrator": "千羽鶴", "text": "現実は直視できないから\nせめて心の中だけでも\n日日日日金土日の精神で！"},
        { "location": "1210/SEL"     , "narrator": "", "text": "うむ、確かに"},
        { "location": "1211/SEL"     , "narrator": "", "text": "経済が破綻するよ"},
        { "location": "1212/ACT"     , "narrator": "", "text": "うむ、確かに"},
        { "location": "1213/ACT"     , "narrator": "", "text": "経済が破綻するよ"},
        { "location": "1214/TALK"    , "narrator": "千羽鶴", "text": "だから心の中だけの\n妄想にしてと言ってる。"},
        { "location": "1215/TALK"    , "narrator": "千羽鶴", "text": "ちーの話を\nちゃんと聞かない\n$handle$なんか、"},
        { "location": "1218/TALK"    , "narrator": "千羽鶴", "text": "ぷんすこだから。"},
        { "location": "1223/TALK"    , "narrator": "千羽鶴", "text": "というわけで、\n早速だけどゲームの概要を\n説明する。"},
        { "location": "1224/TALK"    , "narrator": "千羽鶴", "text": "今から３つの\n修羅場シチュエーションが\n展開される。"},
        { "location": "1225/TALK"    , "narrator": "千羽鶴", "text": "その３つ全ての修羅場で\n特定のヒロインを\n助けてあげて欲しい！"},
        { "location": "1226/TALK"    , "narrator": "千羽鶴", "text": "もちろん、\n貴方の武器は選択肢。"},
        { "location": "1227/TALK"    , "narrator": "千羽鶴", "text": "困ってるヒロインに\nアドバイスを与えて\n修羅場回避を目指せ！"},
        { "location": "1228/SEL"     , "narrator": "", "text": "オーケー！"},
        { "location": "1229/SEL"     , "narrator": "", "text": "こ、これって重いヤツじゃ……"},
        { "location": "1230/ACT"     , "narrator": "", "text": "オーケー！"},
        { "location": "1231/ACT"     , "narrator": "", "text": "こ、これって重いヤツじゃ……"},
        { "location": "1232/TALK"    , "narrator": "千羽鶴", "text": "くっくっく。"},
        { "location": "1233/TALK"    , "narrator": "千羽鶴", "text": "今まで訓練してきた\n選択と責任をフルに使って\nクリアを目指して欲しい。"},
        { "location": "1235/TALK"    , "narrator": "千羽鶴", "text": "選択肢には、それぞれの\n結末に応じて0点～4点の\n点数がついている。"},
        { "location": "1236/TALK"    , "narrator": "千羽鶴", "text": "全３修羅場の\n点数の合計が\n10点を超えれば合格。"},
        { "location": "1237/TALK"    , "narrator": "千羽鶴", "text": "そして！\n見事合格した貴方には――"},
        { "location": "1238/TALK"    , "narrator": "千羽鶴", "text": "素敵な賞品がっ！"},
        { "location": "1239/SEL"     , "narrator": "", "text": "えーなんだろー（棒）"},
        { "location": "1240/ACT"     , "narrator": "", "text": "えーなんだろー（棒）"},
        { "location": "1250/TALK"    , "narrator": "千羽鶴", "text": "鬼才國政領火博士制作、\n多足ロボットにゃボットが\n育てられる連載型クラン！"},
        { "location": "1251/TALK"    , "narrator": "千羽鶴", "text": "<color=green>定期刊クラン誌\n『にゃぼにゃすティー』\n第四巻</color>をプレゼント！"},
        { "location": "1255/SEL"     , "narrator": "", "text": "にゃボットキター！"},
        { "location": "1256/SEL"     , "narrator": "", "text": "遂に３凸目か…"},
        { "location": "1257/ACT"     , "narrator": "", "text": "にゃボットキター！"},
        { "location": "1258/TALK"    , "narrator": "千羽鶴", "text": "そう、来た。"},
        { "location": "1259/TALK"    , "narrator": "千羽鶴", "text": "にゃぼにゃすティーには\n１巻につき１体の\nにゃボットがついてくる。"},
        { "location": "1260/TALK"    , "narrator": "千羽鶴", "text": "全5巻にわたるその全てを\nコンプリートすれば、\n４凸にゃボットになる！"},
        { "location": "1261/TALK"    , "narrator": "千羽鶴", "text": "だから頑張って\nクイズに答えて、\n第一巻をゲットしてみて。"},
        { "location": "1262/ACT"     , "narrator": "", "text": "遂に３凸目か…"},
        { "location": "1263/TALK"    , "narrator": "千羽鶴", "text": "イエス３凸。"},
        { "location": "1264/TALK"    , "narrator": "千羽鶴", "text": "もう少しで臨界を超えた\nスーパーにゃボットが\n誕生するかもしれない。"},
        { "location": "1266/TALK"    , "narrator": "千羽鶴", "text": "というわけだから、\nにゃボット目指し全問\n正解に挑戦して欲しい！"},
        { "location": "1269/TALK"    , "narrator": "千羽鶴", "text": "それでは早速、\n修羅場を展開する。"},
        { "location": "1272/TALK"    , "narrator": "千羽鶴", "text": "シチュエーション、\nバーニングアウト！"},
        { "location": "1287/TALK"    , "narrator": "神楽", "text": "つばめさん、\n酷いですっ！"},
        { "location": "1288/TALK"    , "narrator": "つばめ", "text": "え、えええっ！？\nどうしたの神楽ちゃん！"},
        { "location": "1289/TALK"    , "narrator": "神楽", "text": "昨日の夜、つばめさんの\n部屋にお泊まりに\n行ったとき、つばめさん、"},
        { "location": "1290/TALK"    , "narrator": "神楽", "text": "『これからもずっと\n一緒だよ？』って\n言いましたよね！？"},
        { "location": "1291/TALK"    , "narrator": "つばめ", "text": "い、言ったけど…\nダメだった？？"},
        { "location": "1292/TALK"    , "narrator": "神楽", "text": "全然ダメじゃないです！\nむしろバッチコーイ\nですけど、ですけど！"},
        { "location": "1293/TALK"    , "narrator": "つばめ", "text": "は、はい！"},
        { "location": "1294/TALK"    , "narrator": "神楽", "text": "じゃあ、どうして\n私を家から\n追い出すんですかっ！"},
        { "location": "1295/TALK"    , "narrator": "つばめ", "text": "え、ええっ！？\nだって、お泊まりって\n一泊だけじゃ……"},
        { "location": "1296/TALK"    , "narrator": "神楽", "text": "『ずっと一緒』って\n言ったんですから、\nずっと一緒ですよっ！"},
        { "location": "1297/TALK"    , "narrator": "神楽", "text": "もしかして、あの言葉は\n嘘だったですか！？\nそうなんですね……。"},
        { "location": "1298/TALK"    , "narrator": "つばめ", "text": "ええええっ！\nそうなっちゃうの！？"},
        { "location": "1299/TALK"    , "narrator": "神楽", "text": "ううっ……、\n酷いですっ！"},
        { "location": "1300/TALK"    , "narrator": "神楽", "text": "ずっと一緒に、なんて\n嘘だったんですね！"},
        { "location": "1301/TALK"    , "narrator": "つばめ", "text": "え、えっと、\nいや、そういうわけじゃ…"},
        { "location": "1302/TALK"    , "narrator": "神楽", "text": "ホントですかっ！\nそれじゃ、この書類に\nハンコお願いします♪"},
        { "location": "1303/SEL"     , "narrator": "", "text": "いいよ"},
        { "location": "1304/SEL"     , "narrator": "", "text": "ハンコは押せないけど、もう一晩だけ泊まってく？"},
        { "location": "1305/SEL"     , "narrator": "", "text": "意味が分かりません"},
        { "location": "1306/ACT"     , "narrator": "", "text": "いいよ"},
        { "location": "1307/TALK"    , "narrator": "つばめ", "text": "わ、わかったよ、\nいいよ、押します！"},
        { "location": "1308/TALK"    , "narrator": "つばめ", "text": "ポンっと…"},
        { "location": "1309/TALK"    , "narrator": "神楽", "text": "ありがとうございます♪"},
        { "location": "1310/TALK"    , "narrator": "つばめ", "text": "よかった、\n喜んでくれて！"},
        { "location": "1311/TALK"    , "narrator": "つばめ", "text": "ところで、この書類って\n何の書類なんだろう。"},
        { "location": "1312/TALK"    , "narrator": "神楽", "text": "それじゃつばめさん、\n今から全て、私の\n言いなりですね、ふふ。"},
        { "location": "1313/TALK"    , "narrator": "つばめ", "text": "ええええっ！？\nこの書類って……"},
        { "location": "1314/TALK"    , "narrator": "つばめ", "text": "『わたしは神楽ちゃんの\n忠実な犬になることを\n誓いますわん♪』"},
        { "location": "1315/TALK"    , "narrator": "つばめ", "text": "そんなぁぁぁ～～～！"},
        { "location": "1317/TALK"    , "narrator": "神楽", "text": "焦って先走ると\n人生破滅しますから\n気をつけましょうぴょん♪"},
        { "location": "1323/ACT"     , "narrator": "", "text": "ハンコは押せないけど、もう一晩だけ泊まってく？"},
        { "location": "1324/TALK"    , "narrator": "つばめ", "text": "あ、えっと、\nそうだ、それじゃ――"},
        { "location": "1325/TALK"    , "narrator": "つばめ", "text": "ハンコは押せないけど、\nもう一晩だけお部屋に\n泊まってく？"},
        { "location": "1326/TALK"    , "narrator": "神楽", "text": "えっ！！"},
        { "location": "1327/TALK"    , "narrator": "つばめ", "text": "あ、だ、ダメだったかな？"},
        { "location": "1328/TALK"    , "narrator": "神楽", "text": "つばめさんっ！\nとっても嬉しいです♪"},
        { "location": "1329/TALK"    , "narrator": "つばめ", "text": "ああっ、よかっ――"},
        { "location": "1331/TALK"    , "narrator": "神楽", "text": "それでは早速、\nお部屋に戻りましょう！"},
        { "location": "1332/TALK"    , "narrator": "つばめ", "text": "えっ、もう！？"},
        { "location": "1333/TALK"    , "narrator": "神楽", "text": "今夜は思いっきり\n遊びましょうね！\n寝かしませんよっ♪"},
        { "location": "1335/TALK"    , "narrator": "つばめ", "text": "え、ええええっ！\nちょっ、それ\nどういう意味～～～！？"},
        { "location": "1342/ACT"     , "narrator": "", "text": "意味が分かりません"},
        { "location": "1343/TALK"    , "narrator": "つばめ", "text": "意味が分かりません。"},
        { "location": "1344/TALK"    , "narrator": "神楽", "text": "酷いですっ！\nつばめさん、昨日と\n言ってることが違います！"},
        { "location": "1345/TALK"    , "narrator": "つばめ", "text": "何も違いません。"},
        { "location": "1346/TALK"    , "narrator": "つばめ", "text": "お友達として\n仲良くしましょうと\n言っただけです。"},
        { "location": "1347/TALK"    , "narrator": "神楽", "text": "うっ……\nつばめさんが\n怒りモードにっ……"},
        { "location": "1348/TALK"    , "narrator": "神楽", "text": "これは一旦\n引くしかありませんね。"},
        { "location": "1349/TALK"    , "narrator": "神楽", "text": "は～あ……。"},
        { "location": "1371/TALK"    , "narrator": "ガブリエラ", "text": "ねえ、アーヤ。"},
        { "location": "1372/TALK"    , "narrator": "ガブリエラ", "text": "あたしが楽しみに\nとっておいた冷蔵庫の\nババロア知らないかしら？"},
        { "location": "1373/TALK"    , "narrator": "アーヤ", "text": "えっ！\nあれってギャヴィの\nだったの！？"},
        { "location": "1374/TALK"    , "narrator": "アーヤ", "text": "どうしよう……、\nてっきりフリーおやつ\nなのかとばっかり……。"},
        { "location": "1375/SEL"     , "narrator": "", "text": "さっき館長が食べてたわよ"},
        { "location": "1376/SEL"     , "narrator": "", "text": "可哀想なギャヴィ、今度私が同じのを買ってあげるわ"},
        { "location": "1377/ACT"     , "narrator": "", "text": "さっき館長が食べてたわよ"},
        { "location": "1378/TALK"    , "narrator": "アーヤ", "text": "さっき館長が\n食べてたわよ？"},
        { "location": "1379/TALK"    , "narrator": "アーヤ", "text": "さすがのギャヴィも\n館長が食べたなら\n諦めるはず……。"},
        { "location": "1380/TALK"    , "narrator": "ガブリエラ", "text": "なんですって！？\nまほに文句言いに\n言ってやるわ。"},
        { "location": "1381/TALK"    , "narrator": "アーヤ", "text": "えっ！？"},
        { "location": "1383/TALK"    , "narrator": "アーヤ", "text": "……。"},
        { "location": "1384/TALK"    , "narrator": "アーヤ", "text": "まあでも、\n私が食べたことは\nわからないと思うし。"},
        { "location": "1392/TALK"    , "narrator": "真幌", "text": "残念だったな、\nアーヤ。"},
        { "location": "1393/TALK"    , "narrator": "真幌", "text": "証拠はこの\n監視カメラの映像に\n全部残ってるぞ。"},
        { "location": "1394/TALK"    , "narrator": "ガブリエラ", "text": "人に罪を\nなすりつけるなんて\n最低よ！"},
        { "location": "1396/TALK"    , "narrator": "アーヤ", "text": "えーっ、ええええっ！？"},
        { "location": "1397/TALK"    , "narrator": "アーヤ", "text": "ババロアより、この部屋に\n監視カメラがある事の方が\n大変なことじゃない！？"},
        { "location": "1403/ACT"     , "narrator": "", "text": "可哀想なギャヴィ、今度私が同じのを買ってあげるわ"},
        { "location": "1404/TALK"    , "narrator": "アーヤ", "text": "可哀想なギャヴィ、\n今度私が同じのを\n買ってあげるわ。"},
        { "location": "1405/TALK"    , "narrator": "アーヤ", "text": "だからそんなに\n機嫌悪くしないで？"},
        { "location": "1406/TALK"    , "narrator": "ガブリエラ", "text": "え！？\nほんと？"},
        { "location": "1407/TALK"    , "narrator": "アーヤ", "text": "ほっ。"},
        { "location": "1408/TALK"    , "narrator": "ガブリエラ", "text": "……でも。"},
        { "location": "1409/TALK"    , "narrator": "ガブリエラ", "text": "まだ誰かに食べられたと\n決まったわけでもないのに\nどうしてそんなこと…？"},
        { "location": "1410/TALK"    , "narrator": "アーヤ", "text": "えっ！？\nあ、ああ、それは！"},
        { "location": "1411/TALK"    , "narrator": "ガブリエラ", "text": "さてはアーヤ…！！"},
        { "location": "1412/SEL"     , "narrator": "", "text": "ごめんなさい、私が食べました"},
        { "location": "1413/SEL"     , "narrator": "", "text": "ギャヴィとデートに行きたかったのよ！！"},
        { "location": "1414/ACT"     , "narrator": "", "text": "ごめんなさい、私が食べました"},
        { "location": "1415/TALK"    , "narrator": "アーヤ", "text": "ごめんなさい、\n私が食べました。"},
        { "location": "1416/TALK"    , "narrator": "アーヤ", "text": "フリーおやつだと\n思ってたの。"},
        { "location": "1417/TALK"    , "narrator": "ガブリエラ", "text": "なんだ、アーヤが\n食べちゃってたのね。"},
        { "location": "1418/TALK"    , "narrator": "アーヤ", "text": "ほんと、ごめんね。"},
        { "location": "1419/TALK"    , "narrator": "ガブリエラ", "text": "いいのよ。\n正直に言ってくれたし、\n今回は許してあげるわ。"},
        { "location": "1420/TALK"    , "narrator": "アーヤ", "text": "ありがとー！"},
        { "location": "1421/TALK"    , "narrator": "ガブリエラ", "text": "でっ、でも、\nそのかわり……"},
        { "location": "1422/TALK"    , "narrator": "ガブリエラ", "text": "今週末、美味しいカフェに\n連れて行ってよね！"},
        { "location": "1423/TALK"    , "narrator": "アーヤ", "text": "ええ、いいわよ。"},
        { "location": "1425/TALK"    , "narrator": "ガブリエラ", "text": "あっ！\nべ、べつにこれは\nデートとかじゃないから！"},
        { "location": "1426/TALK"    , "narrator": "ガブリエラ", "text": "これはただの\nペナルティ\nなんだからーっ！"},
        { "location": "1434/ACT"     , "narrator": "", "text": "ギャヴィとデートに行きたかったのよ！！"},
        { "location": "1435/TALK"    , "narrator": "ガブリエラ", "text": "えええっ！？"},
        { "location": "1436/TALK"    , "narrator": "ガブリエラ", "text": "あ、あたしも\n行きたいけど――"},
        { "location": "1437/TALK"    , "narrator": "ガブリエラ", "text": "はっ、待ってガブリエラ。\nこれは怪しい臭いが\nプンプンするわよ？"},
        { "location": "1438/TALK"    , "narrator": "ガブリエラ", "text": "そもそも、同じババロアを\n買ってくれるのとデートに\n何の関連性が！？！？"},
        { "location": "1439/TALK"    , "narrator": "ガブリエラ", "text": "そういえばアーヤって、\n昔から嘘をつくと\n支離滅裂になるわよね。"},
        { "location": "1440/TALK"    , "narrator": "ガブリエラ", "text": "…ということは、\n今回もやっぱり犯人は…。"},
        { "location": "1441/TALK"    , "narrator": "ガブリエラ", "text": "あぶないあぶない、\nごまかされる\nところだったわ。"},
        { "location": "1442/TALK"    , "narrator": "ガブリエラ", "text": "でも、そっちがその気なら\n遠慮なく…♪"},
        { "location": "1443/TALK"    , "narrator": "ガブリエラ", "text": "行きたいけど～、\nあっ、そうだわ！"},
        { "location": "1444/TALK"    , "narrator": "ガブリエラ", "text": "アーヤと二人きりで\n行きたいところが\nあったの♪"},
        { "location": "1445/TALK"    , "narrator": "アーヤ", "text": "どこかしら？\n言ってみて？"},
        { "location": "1446/TALK"    , "narrator": "ガブリエラ", "text": "佐世保の\nハウステンボスよ？"},
        { "location": "1447/TALK"    , "narrator": "アーヤ", "text": "……。"},
        { "location": "1448/TALK"    , "narrator": "ガブリエラ", "text": "もちろん、連れて行って\nくれるわよね～ふふふ。"},
        { "location": "1449/TALK"    , "narrator": "ガブリエラ", "text": "ババロアの恨みは\n恐ろしいのよ？"},
        { "location": "1472/TALK"    , "narrator": "繭", "text": "みやび先輩。\nひとつカミングアウト\nさせてください。"},
        { "location": "1473/TALK"    , "narrator": "みやび", "text": "えいよ。"},
        { "location": "1476/TALK"    , "narrator": "繭", "text": "私、変態なんです。"},
        { "location": "1477/TALK"    , "narrator": "みやび", "text": "……。"},
        { "location": "1478/SEL"     , "narrator": "", "text": "実はうちもやよ"},
        { "location": "1479/SEL"     , "narrator": "", "text": "ジャンルは？"},
        { "location": "1480/ACT"     , "narrator": "", "text": "実はうちもやよ"},
        { "location": "1481/TALK"    , "narrator": "みやび", "text": "実はうちもやよ。"},
        { "location": "1483/TALK"    , "narrator": "繭", "text": "本当ですか！\nみやび先輩も\n変態だったなんて！！"},
        { "location": "1484/TALK"    , "narrator": "繭", "text": "ちょっと嬉しいです。"},
        { "location": "1485/TALK"    , "narrator": "繭", "text": "ところで、みやび先輩は\nどのような変態ですか？"},
        { "location": "1486/SEL"     , "narrator": "", "text": "実は他の子の下着収集が趣味なんよ"},
        { "location": "1487/SEL"     , "narrator": "", "text": "変態ハッカーやよ"},
        { "location": "1488/ACT"     , "narrator": "", "text": "実は他の子の下着収集が趣味なんよ"},
        { "location": "1489/TALK"    , "narrator": "みやび", "text": "実は、他の子の\n下着収集が趣味なんよ。"},
        { "location": "1491/TALK"    , "narrator": "繭", "text": "どん引きしました。"},
        { "location": "1492/TALK"    , "narrator": "みやび", "text": "ようわからん子やね。"},
        { "location": "1493/TALK"    , "narrator": "繭", "text": "これからは、\n私のだけでお願いします。"},
        { "location": "1494/TALK"    , "narrator": "繭", "text": "早速ですが、\nひとつ置いていきますね。"},
        { "location": "1495/TALK"    , "narrator": "みやび", "text": "は？"},
        { "location": "1503/ACT"     , "narrator": "", "text": "変態ハッカーやよ"},
        { "location": "1504/TALK"    , "narrator": "みやび", "text": "変態ハッカーやよ。"},
        { "location": "1505/TALK"    , "narrator": "繭", "text": "そんな事\n重々承知してますから。"},
        { "location": "1506/TALK"    , "narrator": "みやび", "text": "あらら、それは失敬。"},
        { "location": "1507/TALK"    , "narrator": "みやび", "text": "まあちょっとした\nジョークやよ。\nお前さんだって――"},
        { "location": "1508/TALK"    , "narrator": "繭", "text": "私が三日三晩悩んで\n一大決心の末に\nカミングアウトしたのに。"},
        { "location": "1509/TALK"    , "narrator": "繭", "text": "みやび先輩は\nそうやって私のことを\nバカにするんですね。"},
        { "location": "1510/TALK"    , "narrator": "みやび", "text": "いや、その、\nてゆうか、\nそんなに悩んだんか！？"},
        { "location": "1511/TALK"    , "narrator": "繭", "text": "もういいです。\nさようなら。"},
        { "location": "1519/ACT"     , "narrator": "", "text": "ジャンルは？"},
        { "location": "1520/TALK"    , "narrator": "みやび", "text": "…ジャンルは？"},
        { "location": "1521/TALK"    , "narrator": "繭", "text": "みやび先輩です。"},
        { "location": "1522/TALK"    , "narrator": "みやび", "text": "……。"},
        { "location": "1523/SEL"     , "narrator": "", "text": "それは、お前さん流の告白と見ていいなが？"},
        { "location": "1524/SEL"     , "narrator": "", "text": "うちのフィギュア、３Dプリンタで作っちゃろか？"},
        { "location": "1525/ACT"     , "narrator": "", "text": "それは、お前さん流の告白と見ていいなが？"},
        { "location": "1527/TALK"    , "narrator": "みやび", "text": "それは、\nお前さん流の告白と見て\nいいなが？"},
        { "location": "1528/TALK"    , "narrator": "繭", "text": "はい。"},
        { "location": "1529/TALK"    , "narrator": "みやび", "text": "……。"},
        { "location": "1530/TALK"    , "narrator": "繭", "text": "……。"},
        { "location": "1531/TALK"    , "narrator": "みやび", "text": "………。"},
        { "location": "1532/TALK"    , "narrator": "みやび", "text": "すまん。\nうちには大切な人が\nおるんよ。"},
        { "location": "1533/TALK"    , "narrator": "繭", "text": "大丈夫です。\n正直に言ってくれて\nありがとうございました。"},
        { "location": "1534/TALK"    , "narrator": "繭", "text": "私はこのことを\n伝えられただけで\n十分ですから。"},
        { "location": "1535/TALK"    , "narrator": "みやび", "text": "けど、それやと……"},
        { "location": "1537/TALK"    , "narrator": "繭", "text": "あの謎問答から\n私の気持ちをズバリ\n見透かしてしまう――"},
        { "location": "1538/TALK"    , "narrator": "繭", "text": "やはりみやび先輩は\n素敵で、すごい人です。"},
        { "location": "1540/TALK"    , "narrator": "繭", "text": "そんな素敵な人と一緒に\n活動出来るだけで\n十分幸せですから。"},
        { "location": "1542/TALK"    , "narrator": "繭", "text": "これからも、\n変わらぬお付き合いを\nよろしくお願いします。"},
        { "location": "1543/TALK"    , "narrator": "みやび", "text": "……。"},
        { "location": "1545/TALK"    , "narrator": "みやび", "text": "こちらこそ、\nよろしくね。"},
        { "location": "1552/ACT"     , "narrator": "", "text": "うちのフィギュア、３Dプリンタで作っちゃろか？"},
        { "location": "1553/TALK"    , "narrator": "みやび", "text": "うちのフィギュア、\n３Dプリンタで\n作っちゃろか？"},
        { "location": "1554/TALK"    , "narrator": "繭", "text": "ホントですか！"},
        { "location": "1555/TALK"    , "narrator": "繭", "text": "それではお言葉に甘えて。"},
        { "location": "1556/TALK"    , "narrator": "繭", "text": "完全着せ替え仕様で\nお願いします。"},
        { "location": "1557/TALK"    , "narrator": "みやび", "text": "えっ……"},
        { "location": "1558/TALK"    , "narrator": "繭", "text": "私、変態ですから。"},
        { "location": "1580/TALK"    , "narrator": "千羽鶴", "text": "<size=40>終了！</size>"},
        { "location": "1581/TALK"    , "narrator": "千羽鶴", "text": "というわけで、\n貴方の獲得した\n合計点数は――"},
        { "location": "1588/TALK"    , "narrator": "千羽鶴", "text": "<size=40>$qiiz_seikai$点！</size>"},
        { "location": "1589/TALK"    , "narrator": "千羽鶴", "text": "おめでとう！\n$handle$。"},
        { "location": "1590/TALK"    , "narrator": "千羽鶴", "text": "貴方は見事、\n修羅場劇場の惨状を\n全部解決できた！"},
        { "location": "1591/TALK"    , "narrator": "千羽鶴", "text": "というわけで、\n約束通りにゃボットを\n進呈するけど――"},
        { "location": "1592/TALK"    , "narrator": "千羽鶴", "text": "その前にCM。"},
        { "location": "1595/TALK"    , "narrator": "千羽鶴", "text": "<size=40>$qiiz_seikai$点！</size>"},
        { "location": "1596/TALK"    , "narrator": "千羽鶴", "text": "惜しい！！！"},
        { "location": "1597/TALK"    , "narrator": "千羽鶴", "text": "あともう少しで\n達成だったのに！"},
        { "location": "1598/TALK"    , "narrator": "千羽鶴", "text": "冷め止まぬうちに、\nもう一度挑戦してみる？"},
        { "location": "1600/SEL"     , "narrator": "", "text": "挑戦する！"},
        { "location": "1601/SEL"     , "narrator": "", "text": "もういいです"},
        { "location": "1602/ACT"     , "narrator": "", "text": "挑戦する！"},
        { "location": "1603/TALK"    , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "1604/TALK"    , "narrator": "千羽鶴", "text": "それではリトライを\n開始する！"},
        { "location": "1607/ACT"     , "narrator": "", "text": "もういいです"},
        { "location": "1608/TALK"    , "narrator": "千羽鶴", "text": "そう。わかった。"},
        { "location": "1609/TALK"    , "narrator": "千羽鶴", "text": "気が向いたらまた\n遊びに来て。"},
        { "location": "1610/TALK"    , "narrator": "千羽鶴", "text": "この修羅場をクリアしなく\nても、先のエピソードには\n進めるから。"},
        { "location": "1611/TALK"    , "narrator": "千羽鶴", "text": "安心して\nスルーして欲しい。"},
        { "location": "1612/TALK"    , "narrator": "千羽鶴", "text": "それじゃ。"},
        { "location": "1617/TALK"    , "narrator": "千羽鶴", "text": "<size=40>$qiiz_seikai$点！</size>"},
        { "location": "1618/TALK"    , "narrator": "千羽鶴", "text": "あー。"},
        { "location": "1619/TALK"    , "narrator": "千羽鶴", "text": "これは致命的。"},
        { "location": "1620/TALK"    , "narrator": "千羽鶴", "text": "壊滅的に\n修羅場解決能力がない人。"},
        { "location": "1621/TALK"    , "narrator": "千羽鶴", "text": "まあ、何かの\n手違いがあったのかも\nしれないから――"},
        { "location": "1622/TALK"    , "narrator": "千羽鶴", "text": "とりあえず、\nもう一度やってみる？"},
        { "location": "1627/SEL"     , "narrator": "", "text": "映像を見る\n<color=green>【高画質/40MB 2:35】</color>"},
        { "location": "1628/SEL"     , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/14MB 2:35】</color>"},
        { "location": "1629/SEL"     , "narrator": "", "text": "やっぱり見ない"},
        { "location": "1630/ACT"     , "narrator": "", "text": "映像を見る\n<color=green>【高画質/40MB 2:35】</color>"},
        { "location": "1631/TALK"    , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "1637/ACT"     , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/14MB 2:35】</color>"},
        { "location": "1638/TALK"    , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "1644/ACT"     , "narrator": "", "text": "やっぱり見ない"},
        { "location": "1645/TALK"    , "narrator": "千羽鶴", "text": "そう……。"},
        { "location": "1664/TALK"    , "narrator": "千羽鶴", "text": "というわけで！"},
        { "location": "1667/TALK"    , "narrator": "千羽鶴", "text": "賞品授与式を\n執り行います！"},
        { "location": "1669/TALK"    , "narrator": "千羽鶴", "text": "尚、賞品の授与は前回と\n同じく、國政領火博士\nからとなります。"},
        { "location": "1671/TALK"    , "narrator": "千羽鶴", "text": "尚、賞品の授与は、\n世界的に著名な\n量子研究家であり――"},
        { "location": "1672/TALK"    , "narrator": "千羽鶴", "text": "にゃボットの生みの親でも\nある、國政領火博士に\nお願いしたいと思います。"},
        { "location": "1689/TALK"    , "narrator": "エリカ", "text": "コーンコン。\nみなさんこんにちは、\n國政領火です！"},
        { "location": "1695/TALK"    , "narrator": "エリカ", "text": "連載クラン\nにゃぼにゃすティー！\nゲットおめでとう！"},
        { "location": "1696/TALK"    , "narrator": "エリカ", "text": "これからもジャンジャン\nプレゼントしていく\n予定だから――"},
        { "location": "1697/TALK"    , "narrator": "エリカ", "text": "頑張って集めてね！"},
        { "location": "1702/TALK"    , "narrator": "エリカ", "text": "というわけで、前回も\nゲットしていたから\nわかると思うけど――"},
        { "location": "1703/TALK"    , "narrator": "エリカ", "text": "只今より\n“本誌”部分を\n始めまーす！"},
        { "location": "1705/TALK"    , "narrator": "エリカ", "text": "というわけで、\nこのコーナーが\n何なのかというと――"},
        { "location": "1706/TALK"    , "narrator": "エリカ", "text": "実は、連載クラン\nにゃぼにゃすティー！の\n本誌に当たる部分なの。"},
        { "location": "1707/SEL"     , "narrator": "", "text": "というと？"},
        { "location": "1708/ACT"     , "narrator": "", "text": "というと？"},
        { "location": "1710/TALK"    , "narrator": "エリカ", "text": "要するに！"},
        { "location": "1711/TALK"    , "narrator": "エリカ", "text": "にゃぼにゃすティー！\nバンドルのクラン、\nにゃボットについて――"},
        { "location": "1712/TALK"    , "narrator": "エリカ", "text": "解説しちゃう\nコーナーなんです！"},
        { "location": "1714/SEL"     , "narrator": "", "text": "わーい！"},
        { "location": "1715/SEL"     , "narrator": "", "text": "結構です"},
        { "location": "1716/ACT"     , "narrator": "", "text": "わーい！"},
        { "location": "1717/TALK"    , "narrator": "エリカ", "text": "うんうん。\nわかるよ、その気持ち！"},
        { "location": "1718/TALK"    , "narrator": "エリカ", "text": "やっぱりこれ系には\n解説冊子がなくちゃ\n片手落ちだもんね！"},
        { "location": "1719/TALK"    , "narrator": "エリカ", "text": "それじゃ早速、\n聞きたいコンテンツを\n選択してね！"},
        { "location": "1721/SEL"     , "narrator": "", "text": "将来のビジョン"},
        { "location": "1722/SEL"     , "narrator": "", "text": "にゃボットのしつけ方"},
        { "location": "1723/SEL"     , "narrator": "", "text": "もういいです…"},
        { "location": "1724/ACT"     , "narrator": "", "text": "将来のビジョン"},
        { "location": "1725/TALK"    , "narrator": "エリカ", "text": "もちろん！\n一家に一台――"},
        { "location": "1726/TALK"    , "narrator": "エリカ", "text": "じゃなくて、\n一人に一台\nにゃボット社会！"},
        { "location": "1727/TALK"    , "narrator": "エリカ", "text": "あなたの代わりに\nにゃボットがなんでも\nやってくれるよ。"},
        { "location": "1728/TALK"    , "narrator": "エリカ", "text": "炊事洗濯家事掃除！\nお買い物に出前注文\nお風呂入れたり――"},
        { "location": "1729/TALK"    , "narrator": "エリカ", "text": "あと、尻尾のレーザーで\n赤外線機器の\nコントロールも！"},
        { "location": "1730/TALK"    , "narrator": "エリカ", "text": "もちろん将来的には\n量子的機能も追加して！"},
        { "location": "1731/TALK"    , "narrator": "エリカ", "text": "人生やり直し機能や、\n選択結果予測機能を\n搭載したり！"},
        { "location": "1732/TALK"    , "narrator": "エリカ", "text": "魂を磨く機能なんかも\nいれたりして！"},
        { "location": "1733/TALK"    , "narrator": "エリカ", "text": "寝てる間に\n脳内トレーニングとか\n出来るように！！"},
        { "location": "1734/TALK"    , "narrator": "エリカ", "text": "――なったら\n素敵だと思いませんか！？"},
        { "location": "1735/TALK"    , "narrator": "エリカ", "text": "まずは、\n目指せ一万台だよ！"},
        { "location": "1738/ACT"     , "narrator": "", "text": "にゃボットのしつけ方"},
        { "location": "1739/TALK"    , "narrator": "エリカ", "text": "にゃボットは\n量子AIだから、\n躾は大事だよ？"},
        { "location": "1740/TALK"    , "narrator": "エリカ", "text": "ノイマンAIと違って\n学習したことを元に\nちゃんと考えるから――"},
        { "location": "1741/TALK"    , "narrator": "エリカ", "text": "あなたがどんな意図を\nもって、それをダメと\n言ったのか。"},
        { "location": "1742/TALK"    , "narrator": "エリカ", "text": "どうしてそれを\n守らなければ\nならないのか。"},
        { "location": "1743/TALK"    , "narrator": "エリカ", "text": "そういったことを\nちゃんと教えるのは\n安全保障上重要です！"},
        { "location": "1744/TALK"    , "narrator": "エリカ", "text": "ウッカリ隣の人を\n撃っちゃったり\nしないように――"},
        { "location": "1745/TALK"    , "narrator": "エリカ", "text": "レーザー管理と\n撃ち方の練習は\n絶対やってね？"},
        { "location": "1746/TALK"    , "narrator": "エリカ", "text": "出力の加減は、生まれた\nばかりのにゃボットには\n難しいから。"},
        { "location": "1747/TALK"    , "narrator": "エリカ", "text": "あなたがちゃんと、\n教えてあげないと\nいけないからね？"},
        { "location": "1748/TALK"    , "narrator": "エリカ", "text": "それ以外は、\n好きに育ててあげれば\nいいんじゃないかな？"},
        { "location": "1749/TALK"    , "narrator": "エリカ", "text": "趣味なんかも、あなたが\nやっていることや\n行く場所に興味持って――"},
        { "location": "1750/TALK"    , "narrator": "エリカ", "text": "自ずと\n生まれてくるんだよ？"},
        { "location": "1751/TALK"    , "narrator": "エリカ", "text": "にゃボットとテニスが\n出来たら、すごく\n素敵だと思わないかな？"},
        { "location": "1752/TALK"    , "narrator": "エリカ", "text": "あなただけの\n可愛いにゃボットを\n頑張って育ててね。"},
        { "location": "1755/ACT"     , "narrator": "", "text": "もういいです…"},
        { "location": "1756/TALK"    , "narrator": "エリカ", "text": "うん。\nわかったよ。"},
        { "location": "1758/TALK"    , "narrator": "エリカ", "text": "他にも聞きたいことが\nあれば、いつでも\n質問してね。"},
        { "location": "1759/ACT"     , "narrator": "", "text": "結構です"},
        { "location": "1760/TALK"    , "narrator": "エリカ", "text": "あらら…。"},
        { "location": "1761/TALK"    , "narrator": "エリカ", "text": "聞きたいことが\nあれば、いつでも\n質問してね。"},
        { "location": "1763/TALK"    , "narrator": "エリカ", "text": "話せることは\nお話するから。"},
        { "location": "1764/TALK"    , "narrator": "エリカ", "text": "それじゃ、改めまして。\n今回はにゃボットの\nゲットおめでとう！"},
        { "location": "1765/TALK"    , "narrator": "エリカ", "text": "色んな場面で活用して、\n可愛がってあげてね！"},
        { "location": "1766/TALK"    , "narrator": "エリカ", "text": "それじゃ、またね！"},
        { "location": "1775/TALK"    , "narrator": "千羽鶴", "text": "……おかえり。"},
        { "location": "1776/TALK"    , "narrator": "千羽鶴", "text": "というわけで、\n今回のゲーム大会は\nこれでお終い。"},
        { "location": "1777/TALK"    , "narrator": "千羽鶴", "text": "次回はまた\n次のMV回になる。"},
        { "location": "1778/TALK"    , "narrator": "千羽鶴", "text": "お楽しみに。"},
        { "location": "1277/DIALOG"  , "narrator": "dialog_black", "text": "修羅場劇場その１\n<size=60>\n逢瀬つばめ\n×\n卯月神楽\n</size>\n\n【Mission】\n逢瀬つばめを救え！\n\n"},
        { "location": "1322/DIALOG"  , "narrator": "dialog_black", "text": "――逢瀬つばめ、人生破滅。\n\n\n<size=100>0点</size>\n\n\n"},
        { "location": "1340/DIALOG"  , "narrator": "dialog_black", "text": "――まあ、それもまた\nありや、なしや。\n\n\n<size=100>2点</size>\n\n\n"},
        { "location": "1354/DIALOG"  , "narrator": "dialog_black", "text": "――めでたし、めでたし。\n\n\n<size=100>4点</size>\n\n\n"},
        { "location": "1360/DIALOG"  , "narrator": "dialog_black", "text": "修羅場劇場その２\n<size=60>\n國政綾水\n×\nガブリエラ\n</size>\n\n【Mission】\n國政綾水を救え！\n\n"},
        { "location": "1402/DIALOG"  , "narrator": "dialog_black", "text": "――色々修羅場。\n\n\n<size=100>0点</size>\n\n\n"},
        { "location": "1432/DIALOG"  , "narrator": "dialog_black", "text": "――災い転じてラブラブ。\n\n\n<size=100>4点</size>\n\n\n"},
        { "location": "1454/DIALOG"  , "narrator": "dialog_black", "text": "――愛はババロアより重し。\n\n\n<size=100>2点</size>\n\n\n"},
        { "location": "1462/DIALOG"  , "narrator": "dialog_black", "text": "修羅場劇場その３\n<size=60>\n恋ヶ崎みやび\n×\n光月繭\n</size>\n\n【Mission】\n恋ヶ崎みやびを救え！\n\n"},
        { "location": "1501/DIALOG"  , "narrator": "dialog_black", "text": "――未知の領域へ突入。\n\n\n<size=100>2点</size>\n\n\n"},
        { "location": "1517/DIALOG"  , "narrator": "dialog_black", "text": "――理不尽にも残機０。\n\n\n<size=100>0点</size>\n\n\n"},
        { "location": "1550/DIALOG"  , "narrator": "dialog_black", "text": "――美しく細やかな愛の姿。\n\n\n<size=100>4点</size>\n\n\n"},
        { "location": "1563/DIALOG"  , "narrator": "dialog_black", "text": "――自らハマるアリ地獄。\n\n\n<size=100>2点</size>\n\n\n"}
    ]
}
