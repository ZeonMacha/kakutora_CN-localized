    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "310_それでも"},
        { "location": "34/SEL"    , "narrator": "", "text": "ちーす"},
        { "location": "35/SEL"    , "narrator": "", "text": "どうしたの？"},
        { "location": "36/SEL"    , "narrator": "", "text": "ひょっとして空元気？"},
        { "location": "37/ACT"    , "narrator": "", "text": "ちーす"},
        { "location": "38/TALK"   , "narrator": "アーヤ", "text": "あらなんだか"},
        { "location": "39/TALK"   , "narrator": "アーヤ", "text": "体育会系っぽい"},
        { "location": "40/TALK"   , "narrator": "アーヤ", "text": "そういうのも"},
        { "location": "42/TALK"   , "narrator": "アーヤ", "text": "ありかもね"},
        { "location": "43/TALK"   , "narrator": "アーヤ", "text": "ヽ(￣(ｴ)￣)ﾉ"},
        { "location": "44/ACT"    , "narrator": "", "text": "どうしたの？"},
        { "location": "45/TALK"   , "narrator": "アーヤ", "text": "ううんとくに"},
        { "location": "46/TALK"   , "narrator": "アーヤ", "text": "何でもないんだけど"},
        { "location": "47/TALK"   , "narrator": "アーヤ", "text": "なんとなく"},
        { "location": "49/TALK"   , "narrator": "アーヤ", "text": "またね"},
        { "location": "50/ACT"    , "narrator": "", "text": "ひょっとして空元気？"},
        { "location": "60/TALK"   , "narrator": "アーヤ", "text": "あれ"},
        { "location": "61/TALK"   , "narrator": "アーヤ", "text": "そう見える？"},
        { "location": "63/SEL"    , "narrator": "", "text": "うん"},
        { "location": "64/SEL"    , "narrator": "", "text": "違った？"},
        { "location": "65/ACT"    , "narrator": "", "text": "うん"},
        { "location": "66/TALK"   , "narrator": "アーヤ", "text": "そうなの"},
        { "location": "67/ACT"    , "narrator": "", "text": "違った？"},
        { "location": "68/TALK"   , "narrator": "アーヤ", "text": "どういえばいいかな、、、"},
        { "location": "70/TALK"   , "narrator": "アーヤ", "text": "まあちょっとね"},
        { "location": "71/TALK"   , "narrator": "アーヤ", "text": "元気ないの"},
        { "location": "74/SEL"    , "narrator": "", "text": "ほらやっぱり"},
        { "location": "75/SEL"    , "narrator": "", "text": "元気出して"},
        { "location": "76/SEL"    , "narrator": "", "text": "よかったら話して"},
        { "location": "77/ACT"    , "narrator": "", "text": "ほらやっぱり"},
        { "location": "78/TALK"   , "narrator": "アーヤ", "text": "ちょっとそれはデリカジーないと思うの"},
        { "location": "79/TALK"   , "narrator": "アーヤ", "text": "デリカシー"},
        { "location": "81/TALK"   , "narrator": "アーヤ", "text": "（｀皿´ )"},
        { "location": "86/ACT"    , "narrator": "", "text": "元気出して"},
        { "location": "87/TALK"   , "narrator": "アーヤ", "text": "そうね"},
        { "location": "89/TALK"   , "narrator": "アーヤ", "text": "そのとおり"},
        { "location": "90/TALK"   , "narrator": "アーヤ", "text": "ね"},
        { "location": "95/ACT"    , "narrator": "", "text": "よかったら話して"},
        { "location": "96/TALK"   , "narrator": "アーヤ", "text": "どうしようかな、、、"},
        { "location": "97/SEL"    , "narrator": "", "text": "いやならいいけど"},
        { "location": "98/ACT"    , "narrator": "", "text": "いやならいいけど"},
        { "location": "99/TALK"   , "narrator": "アーヤ", "text": "イヤて言うか"},
        { "location": "101/TALK"  , "narrator": "アーヤ", "text": "祖段しにくい"},
        { "location": "103/TALK"  , "narrator": "アーヤ", "text": "相談"},
        { "location": "105/SEL"   , "narrator": "", "text": "信用できない？"},
        { "location": "106/SEL"   , "narrator": "", "text": "無理にじゃないから"},
        { "location": "107/SEL"   , "narrator": "", "text": "言いたくなった時でいいけど"},
        { "location": "108/ACT"   , "narrator": "", "text": "信用できない？"},
        { "location": "109/TALK"  , "narrator": "アーヤ", "text": "そうじゃなくて"},
        { "location": "110/ACT"   , "narrator": "", "text": "無理にじゃないから"},
        { "location": "111/TALK"  , "narrator": "アーヤ", "text": "ありがと"},
        { "location": "112/ACT"   , "narrator": "", "text": "言いたくなった時でいいけど"},
        { "location": "122/TALK"  , "narrator": "アーヤ", "text": "そう"},
        { "location": "123/TALK"  , "narrator": "アーヤ", "text": "じゃあ"},
        { "location": "125/TALK"  , "narrator": "アーヤ", "text": "今かしら"},
        { "location": "127/TALK"  , "narrator": "アーヤ", "text": "ボランティアサークル"},
        { "location": "128/TALK"  , "narrator": "アーヤ", "text": "解散するかもしえないの"},
        { "location": "129/TALK"  , "narrator": "アーヤ", "text": "しれないの"},
        { "location": "132/SEL"   , "narrator": "", "text": "そうだったんだ……"},
        { "location": "133/ACT"   , "narrator": "", "text": "そうだったんだ……"},
        { "location": "134/TALK"  , "narrator": "アーヤ", "text": "そうなのよ(T^T)"},
        { "location": "135/TALK"  , "narrator": "アーヤ", "text": "まあちょっと"},
        { "location": "136/TALK"  , "narrator": "アーヤ", "text": "やりたいこととか"},
        { "location": "137/TALK"  , "narrator": "アーヤ", "text": "使える時間とか"},
        { "location": "139/TALK"  , "narrator": "アーヤ", "text": "人によって違うから"},
        { "location": "142/SEL"   , "narrator": "", "text": "仕方ないのかもね"},
        { "location": "143/SEL"   , "narrator": "", "text": "どうにかならないのかな"},
        { "location": "144/ACT"   , "narrator": "", "text": "仕方ないのかもね"},
        { "location": "146/TALK"  , "narrator": "アーヤ", "text": "そうかも"},
        { "location": "147/TALK"  , "narrator": "アーヤ", "text": "しれないけど"},
        { "location": "148/ACT"   , "narrator": "", "text": "どうにかならないのかな"},
        { "location": "150/TALK"  , "narrator": "アーヤ", "text": "どうにかって"},
        { "location": "151/TALK"  , "narrator": "アーヤ", "text": "例えば？"},
        { "location": "153/TALK"  , "narrator": "アーヤ", "text": "私一人の問題じゃないし"},
        { "location": "154/TALK"  , "narrator": "アーヤ", "text": "誰か一人だけが悪いわけじゃないのよ"},
        { "location": "156/SEL"   , "narrator": "", "text": "そうだろうけど"},
        { "location": "157/SEL"   , "narrator": "", "text": "順番に話を整理してみようか"},
        { "location": "158/ACT"   , "narrator": "", "text": "そうだろうけど"},
        { "location": "159/TALK"  , "narrator": "アーヤ", "text": "何よ"},
        { "location": "160/TALK"  , "narrator": "アーヤ", "text": "その言い方"},
        { "location": "161/ACT"   , "narrator": "", "text": "順番に話を整理してみようか"},
        { "location": "162/TALK"  , "narrator": "アーヤ", "text": "え"},
        { "location": "163/TALK"  , "narrator": "アーヤ", "text": "何よそれ"},
        { "location": "165/TALK"  , "narrator": "アーヤ", "text": "いいわよ別に"},
        { "location": "166/TALK"  , "narrator": "アーヤ", "text": "ちょっと愚痴ってみたかっただけだし"},
        { "location": "168/SEL"   , "narrator": "", "text": "重要なことなんでしょ？"},
        { "location": "169/ACT"   , "narrator": "", "text": "重要なことなんでしょ？"},
        { "location": "170/TALK"  , "narrator": "アーヤ", "text": "そうだけど"},
        { "location": "171/TALK"  , "narrator": "アーヤ", "text": "でも"},
        { "location": "173/TALK"  , "narrator": "アーヤ", "text": "いいから"},
        { "location": "176/SEL"   , "narrator": "", "text": "ちゃんと聞くから"},
        { "location": "177/SEL"   , "narrator": "", "text": "頼りないかな？"},
        { "location": "178/ACT"   , "narrator": "", "text": "ちゃんと聞くから"},
        { "location": "179/TALK"  , "narrator": "アーヤ", "text": "聞くって言われても"},
        { "location": "180/ACT"   , "narrator": "", "text": "頼りないかな？"},
        { "location": "181/TALK"  , "narrator": "アーヤ", "text": "そういうことじゃなくて"},
        { "location": "183/TALK"  , "narrator": "アーヤ", "text": "どうにもならない"},
        { "location": "184/TALK"  , "narrator": "アーヤ", "text": "ことだってあるの"},
        { "location": "188/TALK"  , "narrator": "アーヤ", "text": "嫌い"},
        { "location": "189/TALK"  , "narrator": "アーヤ", "text": "みんな嫌い"},
        { "location": "191/SEL"   , "narrator": "", "text": "アーヤ？"},
        { "location": "192/ACT"   , "narrator": "", "text": "アーヤ？"},
        { "location": "195/SEL"   , "narrator": "", "text": "泣いてるの？"},
        { "location": "196/ACT"   , "narrator": "", "text": "泣いてるの？"},
        { "location": "199/SEL"   , "narrator": "", "text": "$me$がここにいるから"},
        { "location": "200/SEL"   , "narrator": "", "text": "吐き出してみて"},
        { "location": "201/ACT"   , "narrator": "", "text": "$me$がここにいるから"},
        { "location": "202/TALK"  , "narrator": "アーヤ", "text": "だから？"},
        { "location": "203/TALK"  , "narrator": "アーヤ", "text": "それが？"},
        { "location": "204/TALK"  , "narrator": "アーヤ", "text": "何なの？"},
        { "location": "205/ACT"   , "narrator": "", "text": "吐き出してみて"},
        { "location": "207/TALK"  , "narrator": "アーヤ", "text": "そんなこと"},
        { "location": "209/TALK"  , "narrator": "アーヤ", "text": "気楽に言わないで"},
        { "location": "212/TALK"  , "narrator": "アーヤ", "text": "私ずっと頑張ってたわ"},
        { "location": "213/TALK"  , "narrator": "アーヤ", "text": "保育所と交渉したりも結構したし"},
        { "location": "214/TALK"  , "narrator": "アーヤ", "text": "他の子の分も衣装とか作ったり"},
        { "location": "215/TALK"  , "narrator": "アーヤ", "text": "台本だって考えたり"},
        { "location": "216/TALK"  , "narrator": "アーヤ", "text": "でもそれが全部負担だったとか言われたら"},
        { "location": "217/TALK"  , "narrator": "アーヤ", "text": "どうすればいいのよ"},
        { "location": "218/TALK"  , "narrator": "アーヤ", "text": "知らないわそんなこと"},
        { "location": "219/TALK"  , "narrator": "アーヤ", "text": "なんで適当な人の味方するの？"},
        { "location": "223/TALK"  , "narrator": "アーヤ", "text": "きらい"},
        { "location": "224/TALK"  , "narrator": "アーヤ", "text": "みんな嫌い"},
        { "location": "225/TALK"  , "narrator": "アーヤ", "text": "それに気がつかなかった自分のことも大嫌い"},
        { "location": "227/SEL"   , "narrator": "", "text": "そんな言い方しないで"},
        { "location": "228/SEL"   , "narrator": "", "text": "$me$はアーヤのこと好きだよ"},
        { "location": "229/ACT"   , "narrator": "", "text": "そんな言い方しないで"},
        { "location": "230/TALK"  , "narrator": "アーヤ", "text": "何よ"},
        { "location": "231/ACT"   , "narrator": "", "text": "$me$はアーヤのこと好きだよ"},
        { "location": "232/TALK"  , "narrator": "アーヤ", "text": "そんなこと"},
        { "location": "236/TALK"  , "narrator": "アーヤ", "text": "そんなだから"},
        { "location": "237/TALK"  , "narrator": "アーヤ", "text": "続けても意味がないし"},
        { "location": "238/TALK"  , "narrator": "アーヤ", "text": "みんなも肩の荷が下りてホッとするだろうし"},
        { "location": "240/SEL"   , "narrator": "", "text": "意味がないなんてことはないよ"},
        { "location": "241/SEL"   , "narrator": "", "text": "アーヤは続けたいんでしょ"},
        { "location": "242/ACT"   , "narrator": "", "text": "意味がないなんてことはないよ"},
        { "location": "243/TALK"  , "narrator": "アーヤ", "text": "、、、"},
        { "location": "244/TALK"  , "narrator": "アーヤ", "text": "そうかしら"},
        { "location": "245/ACT"   , "narrator": "", "text": "アーヤは続けたいんでしょ"},
        { "location": "246/TALK"  , "narrator": "アーヤ", "text": "そうだけど"},
        { "location": "249/SEL"   , "narrator": "", "text": "雨降って地固まる、って言うでしょ"},
        { "location": "250/SEL"   , "narrator": "", "text": "問題がわかったんだから解くだけでしょ"},
        { "location": "251/ACT"   , "narrator": "", "text": "雨降って地固まる、って言うでしょ"},
        { "location": "252/TALK"  , "narrator": "アーヤ", "text": "確かに"},
        { "location": "254/TALK"  , "narrator": "アーヤ", "text": "言うけど"},
        { "location": "255/ACT"   , "narrator": "", "text": "問題がわかったんだから解くだけでしょ"},
        { "location": "256/TALK"  , "narrator": "アーヤ", "text": "あきれるくらい"},
        { "location": "258/TALK"  , "narrator": "アーヤ", "text": "前向きね"},
        { "location": "261/SEL"   , "narrator": "", "text": "$me$はアーヤの味方だから"},
        { "location": "262/SEL"   , "narrator": "", "text": "一人で抱え込まなくてもいいと思う"},
        { "location": "263/ACT"   , "narrator": "", "text": "$me$はアーヤの味方だから"},
        { "location": "264/TALK"  , "narrator": "アーヤ", "text": "、、、"},
        { "location": "265/TALK"  , "narrator": "アーヤ", "text": "うん"},
        { "location": "266/ACT"   , "narrator": "", "text": "一人で抱え込まなくてもいいと思う"},
        { "location": "267/TALK"  , "narrator": "アーヤ", "text": "、、、"},
        { "location": "268/TALK"  , "narrator": "アーヤ", "text": "そうね"},
        { "location": "270/TALK"  , "narrator": "アーヤ", "text": "私一人で抱え過ぎちゃったのかな"},
        { "location": "271/TALK"  , "narrator": "アーヤ", "text": "それで不満に思うことがあっても"},
        { "location": "272/TALK"  , "narrator": "アーヤ", "text": "言わないようにしてたけど"},
        { "location": "273/TALK"  , "narrator": "アーヤ", "text": "それが態度に出てたのかもね"},
        { "location": "276/TALK"  , "narrator": "アーヤ", "text": "結局"},
        { "location": "277/TALK"  , "narrator": "アーヤ", "text": "そういうことなのかな、、、"},
        { "location": "279/SEL"   , "narrator": "", "text": "話してくれてありがとう"},
        { "location": "280/ACT"   , "narrator": "", "text": "話してくれてありがとう"},
        { "location": "281/TALK"  , "narrator": "アーヤ", "text": "ううん"},
        { "location": "282/TALK"  , "narrator": "アーヤ", "text": "こちらこそ"},
        { "location": "284/TALK"  , "narrator": "アーヤ", "text": "聞いてくれてありがとう(￣Д￣ )"},
        { "location": "285/TALK"  , "narrator": "アーヤ", "text": "なんだか"},
        { "location": "286/TALK"  , "narrator": "アーヤ", "text": "ちょっと気が楽になったわ"},
        { "location": "287/TALK"  , "narrator": "アーヤ", "text": "もう一回"},
        { "location": "289/TALK"  , "narrator": "アーヤ", "text": "メンバーと話してみるね"},
        { "location": "56/DIALOG" , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>800pt.</b></color></size>\nアップしました！"},
        { "location": "118/DIALOG", "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>800pt.</b></color></size>\nアップしました！"}
