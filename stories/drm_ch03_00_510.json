    "entry":
    [
        { "location": "528/SCENARIO", "narrator": "", "text": "530_甘い甘い木曜日"},
        { "location": "553/TALK"    , "narrator": "ガブリエラ", "text": "それは甘い甘い秘密を抱えた"},
        { "location": "554/TALK"    , "narrator": "ガブリエラ", "text": "咲く前の花なのです"},
        { "location": "556/SEL"     , "narrator": "", "text": "それって何？"},
        { "location": "557/TALK"    , "narrator": "ガブリエラ", "text": "甘い甘い秘密の中身は"},
        { "location": "558/TALK"    , "narrator": "ガブリエラ", "text": "バラのジャム"},
        { "location": "560/ACT"     , "narrator": "", "text": "それって何？"},
        { "location": "566/SEL"     , "narrator": "", "text": "ごめん、何？"},
        { "location": "567/SEL"     , "narrator": "", "text": "ああ、あれね"},
        { "location": "568/ACT"     , "narrator": "", "text": "ごめん、何？"},
        { "location": "569/TALK"    , "narrator": "ガブリエラ", "text": "わからないのかしら？"},
        { "location": "570/ACT"     , "narrator": "", "text": "ああ、あれね"},
        { "location": "571/TALK"    , "narrator": "ガブリエラ", "text": "あら、ちゃんとわかってるのかしら？"},
        { "location": "573/TALK"    , "narrator": "ガブリエラ", "text": "脂の木曜日に食べる"},
        { "location": "574/TALK"    , "narrator": "ガブリエラ", "text": "ポンチキのことよ！？"},
        { "location": "576/SEL"     , "narrator": "", "text": "脂の木曜日って？"},
        { "location": "577/SEL"     , "narrator": "", "text": "ポンチキって？"},
        { "location": "578/ACT"     , "narrator": "", "text": "脂の木曜日って？"},
        { "location": "579/TALK"    , "narrator": "ガブリエラ", "text": "そんなことも知らないのかしら？！"},
        { "location": "580/TALK"    , "narrator": "ガブリエラ", "text": "ポンチキを食べる日よ！"},
        { "location": "581/ACT"     , "narrator": "", "text": "ポンチキって？"},
        { "location": "582/TALK"    , "narrator": "ガブリエラ", "text": "まあ！"},
        { "location": "583/TALK"    , "narrator": "ガブリエラ", "text": "脂の木曜日に食べるもののことも知らないなんて！"},
        { "location": "586/SEL"     , "narrator": "", "text": "えーと……"},
        { "location": "587/SEL"     , "narrator": "", "text": "まあいいや……"},
        { "location": "588/ACT"     , "narrator": "", "text": "えーと……"},
        { "location": "589/ACT"     , "narrator": "", "text": "まあいいや……"},
        { "location": "591/TALK"    , "narrator": "ガブリエラ", "text": "$handle$はどの中身が好きなのかしら？"},
        { "location": "592/SEL"     , "narrator": "", "text": "えーと"},
        { "location": "593/TALK"    , "narrator": "ガブリエラ", "text": "やっぱりバラのジャムは外せないわよね"},
        { "location": "594/TALK"    , "narrator": "ガブリエラ", "text": "あとプルーンジャム！"},
        { "location": "596/TALK"    , "narrator": "ガブリエラ", "text": "日本だとイチゴジャムが手に入りやすいからそれも作るわね"},
        { "location": "598/ACT"     , "narrator": "", "text": "えーと"},
        { "location": "600/TALK"    , "narrator": "ガブリエラ", "text": "どうしたのかしら？"},
        { "location": "602/SEL"     , "narrator": "", "text": "結局何の話なの？"},
        { "location": "603/SEL"     , "narrator": "", "text": "$handle$のために作ってくれるってこと？"},
        { "location": "604/ACT"     , "narrator": "", "text": "結局何の話なの？"},
        { "location": "605/TALK"    , "narrator": "ガブリエラ", "text": "なんでわからないのかしら？？"},
        { "location": "606/TALK"    , "narrator": "ガブリエラ", "text": "脂の木曜日にはポンチキを食べないといけないのに"},
        { "location": "607/TALK"    , "narrator": "ガブリエラ", "text": "日本じゃ売っていないのよ"},
        { "location": "608/TALK"    , "narrator": "ガブリエラ", "text": "だから"},
        { "location": "609/TALK"    , "narrator": "ガブリエラ", "text": "貴方の分も私が作ってあげるって言っているのよ"},
        { "location": "610/ACT"     , "narrator": "", "text": "$handle$のために作ってくれるってこと？"},
        { "location": "620/TALK"    , "narrator": "ガブリエラ", "text": "えっ"},
        { "location": "621/TALK"    , "narrator": "ガブリエラ", "text": "まあ"},
        { "location": "622/TALK"    , "narrator": "ガブリエラ", "text": "そうだけど・・・"},
        { "location": "624/SEL"     , "narrator": "", "text": "ありがとう"},
        { "location": "625/ACT"     , "narrator": "", "text": "ありがとう"},
        { "location": "627/TALK"    , "narrator": "ガブリエラ", "text": "別に"},
        { "location": "628/TALK"    , "narrator": "ガブリエラ", "text": "お礼とかいいわよ"},
        { "location": "629/TALK"    , "narrator": "ガブリエラ", "text": "日本じゃ売っていないから"},
        { "location": "630/TALK"    , "narrator": "ガブリエラ", "text": "作らなきゃいけないわっていうだけだから・・・"},
        { "location": "632/TALK"    , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "633/TALK"    , "narrator": "ガブリエラ", "text": "それは"},
        { "location": "634/TALK"    , "narrator": "ガブリエラ", "text": "脂の木曜日は"},
        { "location": "635/TALK"    , "narrator": "ガブリエラ", "text": "ちゃんとしないといけないから"},
        { "location": "636/TALK"    , "narrator": "ガブリエラ", "text": "それだけなんだからね！"},
        { "location": "638/TALK"    , "narrator": "ガブリエラ", "text": "もう！"},
        { "location": "616/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>1000pt.</b></color></size>\nアップしました！"}
    ]
}
