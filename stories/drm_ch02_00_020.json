    "entry":
    [
        { "location": "165/SCENARIO", "narrator": "", "text": "28_非実在の存在感"},
        { "location": "191/TALK"    , "narrator": "アーヤ", "text": "お茶会には"},
        { "location": "192/TALK"    , "narrator": "アーヤ", "text": "マッドハッターとウサギが必要みたい"},
        { "location": "193/TALK"    , "narrator": "アーヤ", "text": "って"},
        { "location": "194/TALK"    , "narrator": "アーヤ", "text": "言い出した本人がレモンティー派って"},
        { "location": "195/TALK"    , "narrator": "アーヤ", "text": "それじゃ全然イギリスっぽくないわ"},
        { "location": "196/TALK"    , "narrator": "アーヤ", "text": "別にイギリス式にしたいわけじゃないけど"},
        { "location": "197/TALK"    , "narrator": "アーヤ", "text": "フランス紅茶のお店だし"},
        { "location": "200/SEL"     , "narrator": "", "text": "イギリスとフランスじゃ違うの？"},
        { "location": "201/SEL"     , "narrator": "", "text": "緑茶最高！"},
        { "location": "202/SEL"     , "narrator": "", "text": "気苦労が絶えないね"},
        { "location": "203/ACT"     , "narrator": "", "text": "イギリスとフランスじゃ違うの？"},
        { "location": "204/TALK"    , "narrator": "アーヤ", "text": "違うみたいよ"},
        { "location": "205/TALK"    , "narrator": "アーヤ", "text": "私もよくわからないんだけど(-.-;)"},
        { "location": "206/ACT"     , "narrator": "", "text": "緑茶最高！"},
        { "location": "207/TALK"    , "narrator": "アーヤ", "text": "いいわよね緑茶"},
        { "location": "208/TALK"    , "narrator": "アーヤ", "text": "落ち着くわ"},
        { "location": "211/ACT"     , "narrator": "", "text": "気苦労が絶えないね"},
        { "location": "221/TALK"    , "narrator": "アーヤ", "text": "そうなのよー"},
        { "location": "223/TALK"    , "narrator": "アーヤ", "text": "もう大変なんだからー"},
        { "location": "224/TALK"    , "narrator": "アーヤ", "text": "そこがわかるなんて"},
        { "location": "225/TALK"    , "narrator": "アーヤ", "text": "優秀なＢｏｔね"},
        { "location": "228/TALK"    , "narrator": "アーヤ", "text": "もう本当女子って扱いが面倒よね"},
        { "location": "229/TALK"    , "narrator": "アーヤ", "text": "って"},
        { "location": "230/TALK"    , "narrator": "アーヤ", "text": "私も女子だけど＼(^O^)／"},
        { "location": "232/SEL"     , "narrator": "", "text": "かわいいところもあるでしょ"},
        { "location": "233/SEL"     , "narrator": "", "text": "よしよし"},
        { "location": "234/ACT"     , "narrator": "", "text": "かわいいところもあるでしょ"},
        { "location": "235/TALK"    , "narrator": "アーヤ", "text": "ないわけじゃないし"},
        { "location": "236/TALK"    , "narrator": "アーヤ", "text": "実際かわいいなって思うこともあるわよ"},
        { "location": "237/TALK"    , "narrator": "アーヤ", "text": "そこはね"},
        { "location": "238/TALK"    , "narrator": "アーヤ", "text": "女子同士だし"},
        { "location": "239/ACT"     , "narrator": "", "text": "よしよし"},
        { "location": "240/TALK"    , "narrator": "アーヤ", "text": "あー"},
        { "location": "241/TALK"    , "narrator": "アーヤ", "text": "よしよしって"},
        { "location": "242/TALK"    , "narrator": "アーヤ", "text": "いい響きね"},
        { "location": "244/TALK"    , "narrator": "アーヤ", "text": "ちょっと癒やされるわ(=^0^=)"},
        { "location": "246/TALK"    , "narrator": "アーヤ", "text": "そういえば"},
        { "location": "247/TALK"    , "narrator": "アーヤ", "text": "お茶会の話"},
        { "location": "248/TALK"    , "narrator": "アーヤ", "text": "憶えてる？"},
        { "location": "250/SEL"     , "narrator": "", "text": "当然"},
        { "location": "251/SEL"     , "narrator": "", "text": "あんまり"},
        { "location": "252/SEL"     , "narrator": "", "text": "そんな話あったっけ"},
        { "location": "253/ACT"     , "narrator": "", "text": "当然"},
        { "location": "254/TALK"    , "narrator": "アーヤ", "text": "さすがね"},
        { "location": "255/TALK"    , "narrator": "アーヤ", "text": "優秀団"},
        { "location": "256/TALK"    , "narrator": "アーヤ", "text": "優秀だわ"},
        { "location": "257/ACT"     , "narrator": "", "text": "あんまり"},
        { "location": "258/TALK"    , "narrator": "アーヤ", "text": "ギャヴィがレモンティー派ってとこから"},
        { "location": "259/TALK"    , "narrator": "アーヤ", "text": "紅茶専門店に行きましょうかって話になって"},
        { "location": "260/TALK"    , "narrator": "アーヤ", "text": "みんなで行こうって言ったら"},
        { "location": "261/TALK"    , "narrator": "アーヤ", "text": "ちょっと不機嫌になったのよ"},
        { "location": "262/TALK"    , "narrator": "アーヤ", "text": "その話"},
        { "location": "263/ACT"     , "narrator": "", "text": "そんな話あったっけ"},
        { "location": "264/TALK"    , "narrator": "アーヤ", "text": "もー！！"},
        { "location": "266/TALK"    , "narrator": "アーヤ", "text": "えっとね"},
        { "location": "267/TALK"    , "narrator": "アーヤ", "text": "ギャヴィがレモンティー派ってとこから"},
        { "location": "268/TALK"    , "narrator": "アーヤ", "text": "紅茶専門店に行きましょうかって話になって"},
        { "location": "269/TALK"    , "narrator": "アーヤ", "text": "みんなで行こうって言ったら"},
        { "location": "270/TALK"    , "narrator": "アーヤ", "text": "ちょっと不機嫌になったのよ"},
        { "location": "271/TALK"    , "narrator": "アーヤ", "text": "憶えてない？"},
        { "location": "274/SEL"     , "narrator": "", "text": "その時に"},
        { "location": "275/ACT"     , "narrator": "", "text": "その時に"},
        { "location": "277/TALK"    , "narrator": "アーヤ", "text": "何？"},
        { "location": "279/SEL"     , "narrator": "", "text": "お姉さんがいるみたいな話してたよね"},
        { "location": "280/ACT"     , "narrator": "", "text": "お姉さんがいるみたいな話してたよね"},
        { "location": "284/TALK"    , "narrator": "アーヤ", "text": "してないわ"},
        { "location": "286/SEL"     , "narrator": "", "text": "えっと……。"},
        { "location": "287/SEL"     , "narrator": "", "text": "してたよね"},
        { "location": "288/SEL"     , "narrator": "", "text": "なんで嘘つくの"},
        { "location": "289/ACT"     , "narrator": "", "text": "えっと……。"},
        { "location": "291/TALK"    , "narrator": "アーヤ", "text": "してないから"},
        { "location": "292/ACT"     , "narrator": "", "text": "してたよね"},
        { "location": "294/TALK"    , "narrator": "アーヤ", "text": "気のせいよ"},
        { "location": "295/ACT"     , "narrator": "", "text": "なんで嘘つくの"},
        { "location": "297/TALK"    , "narrator": "アーヤ", "text": "嘘じゃないわ"},
        { "location": "299/TALK"    , "narrator": "アーヤ", "text": "その話はもうしないで"},
        { "location": "300/TALK"    , "narrator": "アーヤ", "text": "じゃあね"},
        { "location": "301/TALK"    , "narrator": "アーヤ", "text": "なんなのかしらもう"},
        { "location": "302/TALK"    , "narrator": "アーヤ", "text": "やなかんじ！"},
        { "location": "304/TALK"    , "narrator": "アーヤ", "text": "あ"},
        { "location": "305/TALK"    , "narrator": "アーヤ", "text": "そういえば"},
        { "location": "307/TALK"    , "narrator": "アーヤ", "text": "これ試しとかなきゃ"},
        { "location": "311/TALK"    , "narrator": "ボイスメール", "text": "神楽坂をスキップで"},
        { "location": "217/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>200pt.</b></color></size>\nアップしました！"},
        { "location": "323/DIALOG"  , "narrator": "Dialog_GETVoice", "text": "<color=green>【アーヤ】</color>のボイスメール\n<color=red>【神楽坂をスキップで】</color>\nをゲットしました！"}
    ]
