        "title": "Extra006 ヒメゴトチャット",
        "sub_title": "頭にUSB挿せば済む話ぞね"
    },
    "entry":
    [
        { "location": "184/SCENARIO", "narrator": "", "text": "頭にUSB挿せば済む話ぞね"},
        { "location": "209/TALK"    , "narrator": "みやび", "text": "何故"},
        { "location": "210/TALK"    , "narrator": "みやび", "text": "人間にはUSBが挿せぬのだろう"},
        { "location": "212/SEL"     , "narrator": "", "text": "無茶言うな"},
        { "location": "213/SEL"     , "narrator": "", "text": "挿せるの知らないの？"},
        { "location": "214/SEL"     , "narrator": "", "text": "流行ってるよね"},
        { "location": "215/TALK"    , "narrator": "みやび", "text": "そうは思わんかね"},
        { "location": "217/TALK"    , "narrator": "みやび", "text": "相棒"},
        { "location": "220/TALK"    , "narrator": "みやび", "text": "そうか"},
        { "location": "223/TALK"    , "narrator": "みやび", "text": "思わんか"},
        { "location": "226/TALK"    , "narrator": "みやび", "text": "残念"},
        { "location": "234/ACT"     , "narrator": "", "text": "無茶言うな"},
        { "location": "235/TALK"    , "narrator": "みやび", "text": "無茶かどうかは"},
        { "location": "236/TALK"    , "narrator": "みやび", "text": "試してみよう"},
        { "location": "237/ACT"     , "narrator": "", "text": "挿せるの知らないの？"},
        { "location": "238/TALK"    , "narrator": "みやび", "text": "ああそうか"},
        { "location": "239/TALK"    , "narrator": "みやび", "text": "薄々は気づいてた"},
        { "location": "240/ACT"     , "narrator": "", "text": "流行ってるよね"},
        { "location": "242/TALK"    , "narrator": "みやび", "text": "なるほど"},
        { "location": "244/TALK"    , "narrator": "みやび", "text": "そうだったのか"},
        { "location": "245/TALK"    , "narrator": "みやび", "text": "って"},
        { "location": "246/TALK"    , "narrator": "みやび", "text": "嘘をつけ"},
        { "location": "247/TALK"    , "narrator": "みやび", "text": "いや"},
        { "location": "248/TALK"    , "narrator": "みやび", "text": "つくな"},
        { "location": "251/SEL"     , "narrator": "", "text": "USBなんて挿してどうするの"},
        { "location": "252/ACT"     , "narrator": "", "text": "USBなんて挿してどうするの"},
        { "location": "254/TALK"    , "narrator": "みやび", "text": "挿したらデータが取り出せるろう？"},
        { "location": "255/TALK"    , "narrator": "みやび", "text": "便利かと思って"},
        { "location": "257/SEL"     , "narrator": "", "text": "無理だと思うよ"},
        { "location": "258/SEL"     , "narrator": "", "text": "$handle$に挿すがいい"},
        { "location": "259/SEL"     , "narrator": "", "text": "うーん…"},
        { "location": "260/ACT"     , "narrator": "", "text": "無理だと思うよ"},
        { "location": "261/TALK"    , "narrator": "みやび", "text": "不可能を可能にする"},
        { "location": "262/TALK"    , "narrator": "みやび", "text": "それが君の使命"},
        { "location": "263/ACT"     , "narrator": "", "text": "$handle$に挿すがいい"},
        { "location": "265/TALK"    , "narrator": "みやび", "text": "またそんなことを"},
        { "location": "266/TALK"    , "narrator": "みやび", "text": "しかしその自己犠牲精神崇高なり"},
        { "location": "267/TALK"    , "narrator": "みやび", "text": "誉めてつかわす"},
        { "location": "268/ACT"     , "narrator": "", "text": "うーん…"},
        { "location": "269/TALK"    , "narrator": "みやび", "text": "熟考"},
        { "location": "271/TALK"    , "narrator": "みやび", "text": "あるいは"},
        { "location": "272/TALK"    , "narrator": "みやび", "text": "牛歩戦術"},
        { "location": "274/TALK"    , "narrator": "みやび", "text": "具体的にはまほさんがターゲット"},
        { "location": "275/TALK"    , "narrator": "みやび", "text": "オトナしか知りえぬ機密情報を得たいぞね"},
        { "location": "276/TALK"    , "narrator": "みやび", "text": "トライナリーには機密が多すぎる"},
        { "location": "277/TALK"    , "narrator": "みやび", "text": "そんなわけで"},
        { "location": "278/TALK"    , "narrator": "みやび", "text": "$handle$のリーク絶賛ボシュ―中"},
        { "location": "279/TALK"    , "narrator": "みやび", "text": "よろしく！"}
    ]
}
