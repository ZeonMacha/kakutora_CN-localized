{
    "dir": "chap17/daydra/dd_ch05_17_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "17502",
        "cid": "kagura",
        "title": "002 メインストーリー",
        "sub_title": "つきあおうぜー＜前編＞"
    },
    "entry":
    [
        { "location": "978/TALK"   , "narrator": "神楽", "text": "はぁ…また今日も\n学校休んじゃった…。"},
        { "location": "979/TALK"   , "narrator": "神楽", "text": "もう、あれから三日…。\nさすがに、そろそろ\n行かないと…。"},
        { "location": "980/TALK"   , "narrator": "神楽", "text": "でも…。"},
        { "location": "982/TALK"   , "narrator": "神楽", "text": "はぁ…。"},
        { "location": "984/TALK"   , "narrator": "透明モーフィアス", "text": "ハァ…ハァ…。"},
        { "location": "986/TALK"   , "narrator": "神楽", "text": "…え？"},
        { "location": "995/TALK"   , "narrator": "透明モーフィアス", "text": "ああ、夢のようだぁ。\nメノウたんの部屋に\n入れるなんて…。"},
        { "location": "999/TALK"   , "narrator": "神楽", "text": "…は？"},
        { "location": "1008/TALK"  , "narrator": "透明モーフィアス", "text": "おおっ、この扉は\n間違いなくクローゼット！"},
        { "location": "1009/TALK"  , "narrator": "透明モーフィアス", "text": "つまり、この中は…、\nぐふふふふ…。"},
        { "location": "1010/TALK"  , "narrator": "神楽", "text": "おいっ。"},
        { "location": "1026/TALK"  , "narrator": "透明モーフィアス", "text": "おほっ！？"},
        { "location": "1029/TALK"  , "narrator": "神楽", "text": "人の部屋で、\nなにやってんのよ？"},
        { "location": "1030/TALK"  , "narrator": "透明モーフィアス", "text": "あああ、踏みつけないで！\nいや、でももうちょっと\n強くてもいいかも…。"},
        { "location": "1031/TALK"  , "narrator": "神楽", "text": "なにやってるんだ、\nって聞いてるんだけど？"},
        { "location": "1036/TALK"  , "narrator": "透明モーフィアス", "text": "ももも、もちろん\n宝探しに決まってるじゃ\nないかぁ。"},
        { "location": "1037/TALK"  , "narrator": "透明モーフィアス", "text": "なにもしないのは、\nメノウたんファンとして\n失格だと――"},
        { "location": "1042/TALK"  , "narrator": "透明モーフィアス", "text": "おおおおおおおおっ！？"},
        { "location": "1044/TALK"  , "narrator": "神楽", "text": "なんで劇場じゃなくて\nここにいるのよ？"},
        { "location": "1045/TALK"  , "narrator": "透明モーフィアス", "text": "い、イヤだ！\nあんなむさ苦しい劇場に\nいるなんて！"},
        { "location": "1046/TALK"  , "narrator": "透明モーフィアス", "text": "それより、メノウたんの\n部屋で一緒に暮らした方が\n絶対楽しいじゃないか。"},
        { "location": "1047/TALK"  , "narrator": "神楽", "text": "なんでおまえが\n勝手に決めてるのよ？"},
        { "location": "1048/TALK"  , "narrator": "透明モーフィアス", "text": "んふふふ…、クランが\nトライナリーと一緒に\nいるのは当然だろう？"},
        { "location": "1049/TALK"  , "narrator": "透明モーフィアス", "text": "なら！　その特権を\n最大限利用して楽しむのは\n当然さ！！"},
        { "location": "1050/TALK"  , "narrator": "神楽", "text": "…こいつ。"},
        { "location": "1051/TALK"  , "narrator": "透明モーフィアス", "text": "あ～、僕はなんて\n幸せなんだぁ…。"},
        { "location": "1052/TALK"  , "narrator": "透明モーフィアス", "text": "突発結婚式イベントを\n邪魔されたのは\n悔しかったけど…。"},
        { "location": "1053/SEL"   , "narrator": "", "text": "なんでそいつがいるの！？"},
        { "location": "1054/TALK"  , "narrator": "透明モーフィアス", "text": "リアル同棲生活が\nできたから、\nこの際おｋ！！"},
        { "location": "1055/TALK"  , "narrator": "神楽", "text": "同棲言うな。"},
        { "location": "1056/TALK"  , "narrator": "透明モーフィアス", "text": "同棲でしょ～？"},
        { "location": "1057/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1063/TALK"  , "narrator": "透明モーフィアス", "text": "おふぅぅぅっ！？\nいや、もう他人行儀な\n呼び方はやーめたっ！！"},
        { "location": "1064/TALK"  , "narrator": "透明モーフィアス", "text": "そうだ、今日からはもう\n神楽たんって――"},
        { "location": "1065/TALK"  , "narrator": "神楽", "text": "呼んだら、\n本気で壊しますよ？"},
        { "location": "1070/TALK"  , "narrator": "透明モーフィアス", "text": "おおおおお、いいねぇ！\nメノウたんの踏みつけは\n最高だよぉ！"},
        { "location": "1072/TALK"  , "narrator": "神楽", "text": "キモッ！！\n踏まれて喜ぶとか\n変態ですか！？"},
        { "location": "1073/TALK"  , "narrator": "透明モーフィアス", "text": "メノウたんに踏まれる\n喜びを味わえるファンは\n僕だけだからねぇ！！"},
        { "location": "1080/TALK"  , "narrator": "神楽", "text": "…もういい。\n話にならない。"},
        { "location": "1092/TALK"  , "narrator": "神楽", "text": "$handle$さん、助けてください"},
        { "location": "1093/TALK"  , "narrator": "神楽", "text": "粗大ゴミを処分したいんですけど"},
        { "location": "1094/TALK"  , "narrator": "神楽", "text": "なんとかなりませんか？"},
        { "location": "1097/SEL"   , "narrator": "", "text": "$me$にどうしろと？"},
        { "location": "1098/SEL"   , "narrator": "", "text": "劇場に連れて行こう"},
        { "location": "1099/ACT"   , "narrator": "", "text": "$me$にどうしろと？"},
        { "location": "1100/TALK"  , "narrator": "神楽", "text": "それを聞いてるんじゃないですか"},
        { "location": "1101/TALK"  , "narrator": "神楽", "text": "まったく"},
        { "location": "1102/TALK"  , "narrator": "神楽", "text": "本当に役に立たない"},
        { "location": "1105/TALK"  , "narrator": "神楽", "text": "こうしたらいい"},
        { "location": "1106/TALK"  , "narrator": "神楽", "text": "こんな案はどうかな？"},
        { "location": "1107/TALK"  , "narrator": "神楽", "text": "みたいな感じで"},
        { "location": "1108/TALK"  , "narrator": "神楽", "text": "かっこよくビシッと決めてほしかったのに"},
        { "location": "1110/SEL"   , "narrator": "", "text": "ペットだと思おう"},
        { "location": "1111/SEL"   , "narrator": "", "text": "嫌いだから出てけと言おう"},
        { "location": "1112/SEL"   , "narrator": "", "text": "幻滅させよう"},
        { "location": "1113/ACT"   , "narrator": "", "text": "ペットだと思おう"},
        { "location": "1114/TALK"  , "narrator": "神楽", "text": "わかってませんね"},
        { "location": "1115/TALK"  , "narrator": "神楽", "text": "こういう輩には"},
        { "location": "1116/TALK"  , "narrator": "神楽", "text": "逆効果になっちゃうんです"},
        { "location": "1117/TALK"  , "narrator": "神楽", "text": "だから"},
        { "location": "1118/TALK"  , "narrator": "神楽", "text": "その方法はＮＧです"},
        { "location": "1119/ACT"   , "narrator": "", "text": "嫌いだから出てけと言おう"},
        { "location": "1120/TALK"  , "narrator": "神楽", "text": "これだけ嫌ってるオーラや行動を見せてるのに"},
        { "location": "1121/TALK"  , "narrator": "神楽", "text": "効果ないんですよ？"},
        { "location": "1122/TALK"  , "narrator": "神楽", "text": "むしろこういうタイプは"},
        { "location": "1123/TALK"  , "narrator": "神楽", "text": "喜ぶ可能性がありますし"},
        { "location": "1126/TALK"  , "narrator": "神楽", "text": "仮に言ったとして"},
        { "location": "1127/TALK"  , "narrator": "神楽", "text": "嫌悪の目を向けるメノウたんハァハァ"},
        { "location": "1128/TALK"  , "narrator": "神楽", "text": "とか言われたら打つ手無しですし"},
        { "location": "1129/ACT"   , "narrator": "", "text": "幻滅させよう"},
        { "location": "1130/TALK"  , "narrator": "神楽", "text": "幻滅？"},
        { "location": "1131/TALK"  , "narrator": "神楽", "text": "それって、どういうことですか？"},
        { "location": "1133/SEL"   , "narrator": "", "text": "オナラをしてやれ！"},
        { "location": "1134/SEL"   , "narrator": "", "text": "寝てるときにイビキをかくんだ"},
        { "location": "1135/SEL"   , "narrator": "", "text": "食事をクチャクチャ食べよう"},
        { "location": "1136/ACT"   , "narrator": "", "text": "オナラをしてやれ！"},
        { "location": "1137/TALK"  , "narrator": "神楽", "text": "バカですかあなたは！？"},
        { "location": "1138/TALK"  , "narrator": "神楽", "text": "そりゃ確かに一発で幻滅ものかもしれませんけど"},
        { "location": "1139/ACT"   , "narrator": "", "text": "寝てるときにイビキをかくんだ"},
        { "location": "1140/TALK"  , "narrator": "神楽", "text": "意識してイビキなんてかけませんよ"},
        { "location": "1141/TALK"  , "narrator": "神楽", "text": "それに、仮に寝たふりしてやったとしても"},
        { "location": "1142/ACT"   , "narrator": "", "text": "食事をクチャクチャ食べよう"},
        { "location": "1143/TALK"  , "narrator": "神楽", "text": "無理です"},
        { "location": "1144/TALK"  , "narrator": "神楽", "text": "気持ち悪いじゃないですか"},
        { "location": "1145/TALK"  , "narrator": "神楽", "text": "演技だとしてもできませんし"},
        { "location": "1147/TALK"  , "narrator": "神楽", "text": "私のイメージに対してのダメージが大きすぎます！"},
        { "location": "1148/TALK"  , "narrator": "神楽", "text": "だから絶対無理です！！"},
        { "location": "1151/ACT"   , "narrator": "", "text": "劇場に連れて行こう"},
        { "location": "1153/TALK"  , "narrator": "神楽", "text": "ダメですよ"},
        { "location": "1154/TALK"  , "narrator": "神楽", "text": "劇場に連れて行ったら"},
        { "location": "1155/TALK"  , "narrator": "神楽", "text": "みんなと顔を合わせることになるかもしれませんし"},
        { "location": "1158/TALK"  , "narrator": "神楽", "text": "今はまだ誰にも会いたくないんです"},
        { "location": "1159/TALK"  , "narrator": "神楽", "text": "特に"},
        { "location": "1160/TALK"  , "narrator": "神楽", "text": "つばめさんには絶対に"},
        { "location": "1163/TALK"  , "narrator": "神楽", "text": "なにか"},
        { "location": "1164/TALK"  , "narrator": "神楽", "text": "他に方法はないんですか？"},
        { "location": "1167/SEL"   , "narrator": "", "text": "無視するしかないよ"},
        { "location": "1168/ACT"   , "narrator": "", "text": "無視するしかないよ"},
        { "location": "1170/TALK"  , "narrator": "神楽", "text": "地道に続けないと"},
        { "location": "1171/TALK"  , "narrator": "神楽", "text": "効果なさそうな感じですけど"},
        { "location": "1172/TALK"  , "narrator": "神楽", "text": "仕方ありません"},
        { "location": "1173/TALK"  , "narrator": "神楽", "text": "勝手にいなくなるまで"},
        { "location": "1174/TALK"  , "narrator": "神楽", "text": "無視作戦でいってみます"},
        { "location": "1185/TALK"  , "narrator": "神楽", "text": "ふぅ…。"},
        { "location": "1192/TALK"  , "narrator": "透明モーフィアス", "text": "メノウたん、\n誰とお話ししてたのかな？"},
        { "location": "1195/TALK"  , "narrator": "神楽", "text": "無視無視…、\n気にしないように\nしないと…。"},
        { "location": "1197/TALK"  , "narrator": "神楽", "text": "そうだ、確か雑誌の\nコラムの仕事が\n残ってたんだった。"},
        { "location": "1199/TALK"  , "narrator": "神楽", "text": "そっちに集中すれば、\nこいつのことも\n気にならなくなるかも。"},
        { "location": "1202/TALK"  , "narrator": "神楽", "text": "えっと…、\n先月はどんなの\n書いたんだったっけ…？"},
        { "location": "1203/TALK"  , "narrator": "透明モーフィアス", "text": "んん～？\nメノウたんが書こうと\nしてるそれって…。"},
        { "location": "1204/TALK"  , "narrator": "透明モーフィアス", "text": "ああ、あのコラムかぁ。\nもちろん僕もちゃぁんと\nチェックしてるよぉ。"},
        { "location": "1205/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1207/TALK"  , "narrator": "透明モーフィアス", "text": "先々月号がよかったなぁ。\n確か、恋愛について\n話してたけど…。"},
        { "location": "1208/TALK"  , "narrator": "透明モーフィアス", "text": "まるで、僕とメノウたんの\n愛について語ってる\nみたいで、感動したよ！！"},
        { "location": "1211/TALK"  , "narrator": "神楽", "text": "くっ…。"},
        { "location": "1212/TALK"  , "narrator": "神楽", "text": "んなわけねぇだろ！！"},
        { "location": "1214/TALK"  , "narrator": "神楽", "text": "…って、言いたいけど…、\n反応したら喜ばれるし…。"},
        { "location": "1216/TALK"  , "narrator": "透明モーフィアス", "text": "ねえねえ、メノウたーん。\n仕事もいいけど\n僕の相手もしてよー。"},
        { "location": "1217/TALK"  , "narrator": "神楽", "text": "…集中、できないかも…。"},
        { "location": "1219/ACT"   , "narrator": "", "text": "なんでそいつがいるの！？"},
        { "location": "1239/TALK"  , "narrator": "神楽", "text": "知りませんよ"},
        { "location": "1240/TALK"  , "narrator": "神楽", "text": "いつの間にか粗大ゴミが置かれていただけです"},
        { "location": "1241/TALK"  , "narrator": "神楽", "text": "こんなにうるさくてウザいの"},
        { "location": "1242/TALK"  , "narrator": "神楽", "text": "私が連れてくるはずないじゃないですか"},
        { "location": "1245/SEL"   , "narrator": "", "text": "嫉妬するんですけど？"},
        { "location": "1246/SEL"   , "narrator": "", "text": "そいつ窓から投げ捨てて"},
        { "location": "1247/ACT"   , "narrator": "", "text": "嫉妬するんですけど？"},
        { "location": "1248/TALK"  , "narrator": "神楽", "text": "こんなの相手に嫉妬しないでください！！"},
        { "location": "1249/TALK"  , "narrator": "神楽", "text": "第一、私からしても心外だし"},
        { "location": "1250/TALK"  , "narrator": "神楽", "text": "っていうか"},
        { "location": "1251/TALK"  , "narrator": "神楽", "text": "そう思うなら助けてください"},
        { "location": "1253/SEL"   , "narrator": "", "text": "隣にいられたら助けてた…"},
        { "location": "1254/ACT"   , "narrator": "", "text": "隣にいられたら助けてた…"},
        { "location": "1257/TALK"  , "narrator": "神楽", "text": "もしもですけど"},
        { "location": "1258/TALK"  , "narrator": "神楽", "text": "本当に$handle$さんが隣にいてくれたら"},
        { "location": "1259/TALK"  , "narrator": "神楽", "text": "心強かったでしょうね"},
        { "location": "1260/TALK"  , "narrator": "神楽", "text": "色々相談とか"},
        { "location": "1261/TALK"  , "narrator": "神楽", "text": "紅茶とか入れてもらったり"},
        { "location": "1262/TALK"  , "narrator": "神楽", "text": "あっ足も揉んでもらったりしちゃおうかな"},
        { "location": "1265/ACT"   , "narrator": "", "text": "そいつ窓から投げ捨てて"},
        { "location": "1266/TALK"  , "narrator": "神楽", "text": "なんてこと言うんですか！？"},
        { "location": "1267/TALK"  , "narrator": "神楽", "text": "窓から投げ捨てるって、つまり"},
        { "location": "1268/TALK"  , "narrator": "神楽", "text": "私にこの放射性廃棄物を掴めってことでしょう！？"},
        { "location": "1269/TALK"  , "narrator": "神楽", "text": "こんなキモいの触りたくないです"},
        { "location": "1273/TALK"  , "narrator": "神楽", "text": "こういうとき"},
        { "location": "1274/TALK"  , "narrator": "神楽", "text": "$handle$さんがいてくれたら、つまんで投げ捨ててもらうのに！！！！"},
        { "location": "1275/TALK"  , "narrator": "神楽", "text": "なんでいないんですか！！"},
        { "location": "1277/SEL"   , "narrator": "", "text": "$me$なら一緒にいていいの？"},
        { "location": "1278/ACT"   , "narrator": "", "text": "$me$なら一緒にいていいの？"},
        { "location": "1280/TALK"  , "narrator": "神楽", "text": "うーんと"},
        { "location": "1283/TALK"  , "narrator": "神楽", "text": "わりと複雑な話になっちゃいますけど、いつもじゃないですけどたまにいて欲しいなって思うことはあります。"},
        { "location": "1284/TALK"  , "narrator": "神楽", "text": "色々相談に乗ってもらったり助けられたりしてますし"},
        { "location": "1285/TALK"  , "narrator": "神楽", "text": "それに"},
        { "location": "1286/TALK"  , "narrator": "神楽", "text": "なんだかんだで結構切り返しが好きなので"},
        { "location": "1288/TALK"  , "narrator": "神楽", "text": "あの"},
        { "location": "1289/TALK"  , "narrator": "神楽", "text": "これでも私"},
        { "location": "1290/TALK"  , "narrator": "神楽", "text": "結構$handle$さんのこと信頼してるんですよ？"},
        { "location": "1293/TALK"  , "narrator": "神楽", "text": "まあ今日は"},
        { "location": "1295/TALK"  , "narrator": "神楽", "text": "邪魔がいるから、落ち着いてお話も出来ないけど"},
        { "location": "1298/TALK"  , "narrator": "神楽", "text": "本当、なんとか出て行ってもらう方法"},
        { "location": "1299/TALK"  , "narrator": "神楽", "text": "ありませんかね？"},
        { "location": "1349/TALK"  , "narrator": "ぴょんこ", "text": "　"},
        { "location": "1383/TALK"  , "narrator": "ぴょんこ", "text": "というわけで！"},
        { "location": "1384/SEL"   , "narrator": "", "text": "というわけで？"},
        { "location": "1385/ACT"   , "narrator": "", "text": "というわけで？"},
        { "location": "1387/TALK"  , "narrator": "ぴょんこ", "text": "アーヤさんも\n駆けつけてくれた\nことですしっ！"},
        { "location": "1388/TALK"  , "narrator": "ぴょんこ", "text": "さっさと\n記憶をたどる旅へ\nでかけましょう♪"},
        { "location": "1389/TALK"  , "narrator": "アーヤ", "text": "記憶をたどる旅？"},
        { "location": "1391/TALK"  , "narrator": "ぴょんこ", "text": "そうなんですよっ。"},
        { "location": "1392/TALK"  , "narrator": "ぴょんこ", "text": "今、私は\n$handle$さんと\n記憶を共有してます。"},
        { "location": "1393/TALK"  , "narrator": "ぴょんこ", "text": "過去の思い出を\n大公開してる\nわけですね！"},
        { "location": "1394/TALK"  , "narrator": "アーヤ", "text": "ええっ！？\nどうして？"},
        { "location": "1395/TALK"  , "narrator": "ぴょんこ", "text": "そうやって、\nどこに不整合があるか\n確認してるんですよ。"},
        { "location": "1397/TALK"  , "narrator": "アーヤ", "text": "そうだったのね。\n随分と大変なことに\nなってるわね。"},
        { "location": "1399/TALK"  , "narrator": "アーヤ", "text": "……卯月？"},
        { "location": "1401/TALK"  , "narrator": "アーヤ", "text": "卯月？\n大丈夫！？"},
        { "location": "1402/TALK"  , "narrator": "ぴょんこ", "text": "えっ？\n何がですか？"},
        { "location": "1403/TALK"  , "narrator": "アーヤ", "text": "今なんだか\nボーッとしてなかった？"},
        { "location": "1404/TALK"  , "narrator": "ぴょんこ", "text": "全然そんなこと\nありませんよ？"},
        { "location": "1405/TALK"  , "narrator": "ぴょんこ", "text": "それより――"},
        { "location": "1406/TALK"  , "narrator": "ぴょんこ", "text": "アーヤさん。いつも\nありがとうございます。"},
        { "location": "1407/TALK"  , "narrator": "アーヤ", "text": "どうしたの？\n唐突に。"},
        { "location": "1408/TALK"  , "narrator": "ぴょんこ", "text": "いえ、突然では\nありませんよ。\nいつも思ってることです。"},
        { "location": "1409/TALK"  , "narrator": "ぴょんこ", "text": "こうして私の為に、\n危険を顧みずに\n協力してくれていること。"},
        { "location": "1410/TALK"  , "narrator": "ぴょんこ", "text": "本当に感謝してるんです。"},
        { "location": "1411/TALK"  , "narrator": "アーヤ", "text": "そ、そう？"},
        { "location": "1412/TALK"  , "narrator": "アーヤ", "text": "私にとっては、卯月は\n大切な仲間だから。\n当然のことなんだけどね。"},
        { "location": "1413/TALK"  , "narrator": "ぴょんこ", "text": "アーヤさん…。"},
        { "location": "1414/TALK"  , "narrator": "アーヤ", "text": "ほら、そんなことより、\n急がないと\nいけないんでしょう？"},
        { "location": "1415/TALK"  , "narrator": "ぴょんこ", "text": "あ、はい、\nそうですね！"},
        { "location": "1417/TALK"  , "narrator": "ぴょんこ", "text": "それじゃ\n$handle$さん、\n今回もよろしくですっ！"},
        { "location": "1420/SEL"   , "narrator": "", "text": "お、おう"},
        { "location": "1421/SEL"   , "narrator": "", "text": "任せて"},
        { "location": "1422/ACT"   , "narrator": "", "text": "お、おう"},
        { "location": "1423/ACT"   , "narrator": "", "text": "任せて"},
        { "location": "1425/TALK"  , "narrator": "ぴょんこ", "text": "それじゃ行きますよ！"},
        { "location": "1426/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんに\n素敵な記憶の旅を――"},
        { "location": "1441/TALK"  , "narrator": "アーヤ", "text": "それにしても、\n過去の思い出を\n共有されるなんて――"},
        { "location": "1442/TALK"  , "narrator": "アーヤ", "text": "卯月も\nとんだ災難ね。"},
        { "location": "1443/TALK"  , "narrator": "ぴょんこ", "text": "……。"},
        { "location": "1444/TALK"  , "narrator": "ぴょんこ", "text": "アーヤさん、\n他人事じゃありませんよ？"},
        { "location": "1445/TALK"  , "narrator": "アーヤ", "text": "え？"},
        { "location": "1446/TALK"  , "narrator": "ぴょんこ", "text": "私、わかりますから。"},
        { "location": "1447/TALK"  , "narrator": "ぴょんこ", "text": "アーヤさん、\n“お姉さん”が\nいますよね？"},
        { "location": "1448/TALK"  , "narrator": "アーヤ", "text": "え、ええ……\nいるけど……。"},
        { "location": "1449/TALK"  , "narrator": "ぴょんこ", "text": "……。"},
        { "location": "1450/TALK"  , "narrator": "アーヤ", "text": "え！？\nなに？　なに？"},
        { "location": "1461/TALK"  , "narrator": "拘束されし者", "text": "ようこそ、\n卯月神楽の記憶の世界へ。"},
        { "location": "1462/TALK"  , "narrator": "拘束されし者", "text": "今から一つの記憶に\n照準を当てて、\n貴方に共有する。"},
        { "location": "1463/TALK"  , "narrator": "拘束されし者", "text": "その記憶に違和感を\n感じたら、それを\n申告するように。"},
        { "location": "1464/TALK"  , "narrator": "拘束されし者", "text": "今から共有する記憶は、\n彼女の膨大なライブラリの\n中で懐疑的な部分の１つ―"},
        { "location": "1465/TALK"  , "narrator": "拘束されし者", "text": "記憶の混乱が見られる\n部分から、その１つを\n抽出したものだ。"},
        { "location": "1466/TALK"  , "narrator": "拘束されし者", "text": "ただし、その\n“記憶が混乱する箇所”を\n見られるとは限らない。"},
        { "location": "1467/TALK"  , "narrator": "拘束されし者", "text": "可能な限りその付近に\nスポットを当てて共有する\nつもりではいるが――"},
        { "location": "1468/TALK"  , "narrator": "拘束されし者", "text": "記憶とは無限のフラクタル\n世界であるが故に、これ\n以上の解像度は出せない。"},
        { "location": "1469/SEL"   , "narrator": "", "text": "わかった"},
        { "location": "1470/SEL"   , "narrator": "", "text": "もっとわかりやすく言って"},
        { "location": "1471/ACT"   , "narrator": "", "text": "わかった"},
        { "location": "1472/ACT"   , "narrator": "", "text": "もっとわかりやすく言って"},
        { "location": "1473/TALK"  , "narrator": "拘束されし者", "text": "例えば、とある１時間に\n焦点を当てたとする。"},
        { "location": "1474/TALK"  , "narrator": "拘束されし者", "text": "その１時間という時間の\n記憶を文章にするとき――"},
        { "location": "1475/TALK"  , "narrator": "拘束されし者", "text": "短くすればいくらでも短く\n長くすればいくらでも\n長くできる。"},
        { "location": "1476/TALK"  , "narrator": "拘束されし者", "text": "一例を挙げるなら、\n最短であれば\n「ぼーっとしていた」等。"},
        { "location": "1477/TALK"  , "narrator": "拘束されし者", "text": "最長は、そのボーッと\nしていた最中に考えていた\n思考の全てや――"},
        { "location": "1478/TALK"  , "narrator": "拘束されし者", "text": "視界に映る数多のもの、\n聞こえる音、温度、体調、\nそれこそ無限に描写可能。"},
        { "location": "1479/TALK"  , "narrator": "拘束されし者", "text": "このように、記憶には\n描写の細かさが無限に\n設定でき――"},
        { "location": "1480/TALK"  , "narrator": "拘束されし者", "text": "それを、記憶の解像度と\n呼んでいる。"},
        { "location": "1481/TALK"  , "narrator": "拘束されし者", "text": "私がとある記憶の１点を\n共有する時には、一定の\n解像度を超えられない。"},
        { "location": "1482/TALK"  , "narrator": "拘束されし者", "text": "記憶の着地点に、\nある程度のランダム性が\n出てしまうということだ。"},
        { "location": "1484/TALK"  , "narrator": "拘束されし者", "text": "さて――"},
        { "location": "1485/TALK"  , "narrator": "拘束されし者", "text": "今回共有する記憶は、\n卯月神楽の記憶ではあるが\n卯月神楽のことではない。"},
        { "location": "1486/TALK"  , "narrator": "拘束されし者", "text": "彼女の父である卯月文雄と\n妻、美佐子の\n出逢いの記憶だ。"},
        { "location": "1487/TALK"  , "narrator": "拘束されし者", "text": "念を押しておくが、これは\n神楽の知っている記憶や\n思い出を元にした話。"},
        { "location": "1488/TALK"  , "narrator": "拘束されし者", "text": "客観的事実ではないし、\nそうでないからこそ\n同化の検証になる。"},
        { "location": "1489/TALK"  , "narrator": "拘束されし者", "text": "そこは常に\n頭の片隅に入れながら\n共有してほしい。"},
        { "location": "1496/TALK"  , "narrator": "拘束されし者", "text": "卯月文雄は、\n株式会社UDUKIの\n代表取締役、創始者。"},
        { "location": "1497/TALK"  , "narrator": "拘束されし者", "text": "卯月美佐子、\n旧姓柏崎美佐子は\n占星術師。"},
        { "location": "1501/TALK"  , "narrator": "拘束されし者", "text": "二人のなれそめは、\nその数奇な人生に対し、\n余りに平凡なネット恋愛。"},
        { "location": "1502/TALK"  , "narrator": "拘束されし者", "text": "美佐子が文雄の個人的な\nブログにファンメールを\n送ったのがきっかけだ。"},
        { "location": "1503/TALK"  , "narrator": "拘束されし者", "text": "当時文雄はまだ\n駆け出しのベンチャーで\n経営もおぼつかない状態。"},
        { "location": "1504/TALK"  , "narrator": "拘束されし者", "text": "日々が苦悩の連続である\n彼が、美佐子に癒しを\n求めるのは自然な流れだ。"},
        { "location": "1505/TALK"  , "narrator": "拘束されし者", "text": "美佐子の占星術もまた\n文雄にとっては魅力的\nだった。"},
        { "location": "1506/TALK"  , "narrator": "拘束されし者", "text": "経営者の多くがそうである\nように、文雄もまた占いを\n信奉していたからだ。"},
        { "location": "1510/TALK"  , "narrator": "拘束されし者", "text": "こうして二人の関係は\n急速に進展していく。"},
        { "location": "1511/TALK"  , "narrator": "拘束されし者", "text": "そしてまだ会社の経営も\nおぼつかない中、二人は\n結婚をした。"},
        { "location": "1512/TALK"  , "narrator": "拘束されし者", "text": "当時はまだ豊洲ではなく、\n足立区の安アパートでの\n新婚生活であった。"},
        { "location": "1513/TALK"  , "narrator": "拘束されし者", "text": "そして間もなく、\n長女、神楽が誕生する。"},
        { "location": "1517/TALK"  , "narrator": "拘束されし者", "text": "その後、状況は\n劇的に変わっていく。"},
        { "location": "1518/TALK"  , "narrator": "拘束されし者", "text": "株式会社UDUKIが\n開発していた１つの量子\nコンテンツが当たった。"},
        { "location": "1519/TALK"  , "narrator": "拘束されし者", "text": "それは、\nQ-CLOUDと呼ばれる\nアプリだった。"},
        { "location": "1520/TALK"  , "narrator": "拘束されし者", "text": "まだ当時、世間では\n一般的なPCが主流であり\n量子機器は専門機器。"},
        { "location": "1521/TALK"  , "narrator": "拘束されし者", "text": "文雄は量子機器を全て\nサーバー側で受け持ち、\n普通のスマホで使える――"},
        { "location": "1522/TALK"  , "narrator": "拘束されし者", "text": "お手軽な量子PC体験を\n市場にもたらしたのだ。"},
        { "location": "1523/TALK"  , "narrator": "拘束されし者", "text": "Q-CLOUDの大ヒットで\nUDUKIは急成長を遂げる。"},
        { "location": "1524/TALK"  , "narrator": "拘束されし者", "text": "神楽が小学校\n高学年の頃のことだ。"},
        { "location": "1525/TALK"  , "narrator": "拘束されし者", "text": "このQ-CLOUDの\nヒットで、卯月家の環境は\n劇的に変わる。"},
        { "location": "1526/TALK"  , "narrator": "拘束されし者", "text": "家は豊洲へと越し、\n神楽は中学から\n私学へと転入。"},
        { "location": "1527/TALK"  , "narrator": "拘束されし者", "text": "全てが順風満帆だった。"},
        { "location": "1528/TALK"  , "narrator": "拘束されし者", "text": "その追い風に陰りが\n出てきたのは、神楽が\n中学１年の時だった。"},
        { "location": "1532/TALK"  , "narrator": "拘束されし者", "text": "元官営の民営化による、\n古くからの通信系大企業、\nエンタングル。"},
        { "location": "1533/TALK"  , "narrator": "拘束されし者", "text": "この大企業が、\n量子分野をメイン\nフィールドに転換した。"},
        { "location": "1534/TALK"  , "narrator": "拘束されし者", "text": "今までも一部署では\nやっていたが、メインは\nあくまで通信事業。"},
        { "location": "1535/TALK"  , "narrator": "拘束されし者", "text": "しかし、満を持して\n量子分野への移行を\n果たしたのだろう。"},
        { "location": "1536/TALK"  , "narrator": "拘束されし者", "text": "元々膨大なインフラを\n持つエンタングルの\n追撃は凄まじかった。"},
        { "location": "1540/TALK"  , "narrator": "拘束されし者", "text": "当時量子クラウドの\n最大シェアを誇っていた\nUDUKIは狙い撃ちされた。"},
        { "location": "1541/TALK"  , "narrator": "拘束されし者", "text": "そして、数年のうちに\nエンタングルはその\nシェアを逆転させ――"},
        { "location": "1542/TALK"  , "narrator": "拘束されし者", "text": "世の中は\nRediness一色に\n染まっていった。"},
        { "location": "1543/TALK"  , "narrator": "拘束されし者", "text": "UDUKIは様々な分野で\n劣勢になり、事業縮小を\n強いられ倒産。"},
        { "location": "1544/TALK"  , "narrator": "拘束されし者", "text": "しかし実際はといえば、\n倒産は裏でエンタングルが\n糸を引いていた。"},
        { "location": "1545/TALK"  , "narrator": "拘束されし者", "text": "エンタングルは、\nQ-CLOUDに使われていた\n量子エンジン――"},
        { "location": "1546/TALK"  , "narrator": "拘束されし者", "text": "“ライフギャザー”の\n技術を異常なまでに\n欲していたんだ。"},
        { "location": "1547/TALK"  , "narrator": "拘束されし者", "text": "そして、技術畑の\nコアメンバーを全て\n引き抜いた後に潰した。"},
        { "location": "1548/TALK"  , "narrator": "拘束されし者", "text": "だから、今の\nRedinessは――"},
        { "location": "1549/TALK"  , "narrator": "拘束されし者", "text": "“ライフギャザー”の\nアーキテクチャで\n動いているのだ。"},
        { "location": "1553/TALK"  , "narrator": "拘束されし者", "text": "尚――"},
        { "location": "1554/TALK"  , "narrator": "拘束されし者", "text": "その後文雄は\n精神的重圧に耐えきれず\n自殺。"},
        { "location": "1555/TALK"  , "narrator": "拘束されし者", "text": "美佐子もその後\n鬱に近い状態になる。"},
        { "location": "1556/TALK"  , "narrator": "拘束されし者", "text": "そんな中、エンタングル\n会長である一之宮北斎は\n神楽を養子に迎える。"},
        { "location": "1557/TALK"  , "narrator": "拘束されし者", "text": "自由競争の原理原則が\nあるとはいえ――"},
        { "location": "1558/TALK"  , "narrator": "拘束されし者", "text": "UDUKI倒産の件は、\nエンタングルにも\n責任がある。"},
        { "location": "1559/TALK"  , "narrator": "拘束されし者", "text": "それを考慮した上で、\n娘の生活を保障するという\n名目によるものだ。"},
        { "location": "1560/TALK"  , "narrator": "拘束されし者", "text": "こうして卯月神楽は戸籍上\n一之宮神楽となった。"},
        { "location": "1568/TALK"  , "narrator": "拘束されし者", "text": "ライブラリ\nEOF/."},
        { "location": "1569/TALK"  , "narrator": "拘束されし者", "text": "今回の検索範囲における\n全文リードを終了した。"},
        { "location": "1570/TALK"  , "narrator": "拘束されし者", "text": "今回何か、\n違和感を感じたところは？"},
        { "location": "1571/SEL"   , "narrator": "", "text": "無いと思う"},
        { "location": "1572/SEL"   , "narrator": "", "text": "初めての情報なのでわからない"},
        { "location": "1573/ACT"   , "narrator": "", "text": "無いと思う"},
        { "location": "1574/TALK"  , "narrator": "拘束されし者", "text": "わかった。"},
        { "location": "1575/ACT"   , "narrator": "", "text": "初めての情報なのでわからない"},
        { "location": "1576/TALK"  , "narrator": "拘束されし者", "text": "それはわかっている。\nその前提で、\n聞いているつもりだ。"},
        { "location": "1577/TALK"  , "narrator": "拘束されし者", "text": "お前の持つ卯月神楽の\nありのままの姿と、\n今の記憶の共有――"},
        { "location": "1578/TALK"  , "narrator": "拘束されし者", "text": "その双方が\nしっかりと噛み合っている\nようであれば問題ない。"},
        { "location": "1579/TALK"  , "narrator": "拘束されし者", "text": "よって、直感的に\n違和感を感じなければ\nそれでいい。"},
        { "location": "1581/TALK"  , "narrator": "拘束されし者", "text": "では次回は、\n別のターゲットを\n共有していこう。"},
        { "location": "1596/TALK"  , "narrator": "ぴょんこ", "text": "どうでしたか？\n何か見つかりましたか？"},
        { "location": "1597/SEL"   , "narrator": "", "text": "いや、特には"},
        { "location": "1598/SEL"   , "narrator": "", "text": "神楽が可愛いという真実が見つかった"},
        { "location": "1599/SEL"   , "narrator": "", "text": "エンタングルが■■野郎だという事実が見つかった"},
        { "location": "1600/SEL"   , "narrator": "", "text": "まだ「ぴょんこｽｷ」してない自分が見つかった"},
        { "location": "1601/ACT"   , "narrator": "", "text": "いや、特には"},
        { "location": "1602/TALK"  , "narrator": "ぴょんこ", "text": "そうですか。"},
        { "location": "1603/ACT"   , "narrator": "", "text": "神楽が可愛いという真実が見つかった"},
        { "location": "1605/TALK"  , "narrator": "ぴょんこ", "text": "それは～。"},
        { "location": "1606/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんと\nぴょんこの間では、\n大自然の摂理です。"},
        { "location": "1607/TALK"  , "narrator": "ぴょんこ", "text": "今更すぎですよっ♪"},
        { "location": "1608/ACT"   , "narrator": "", "text": "エンタングルが■■野郎だという事実が見つかった"},
        { "location": "1609/TALK"  , "narrator": "ぴょんこ", "text": "ほんと、\n■■野郎だよな！！"},
        { "location": "1610/TALK"  , "narrator": "ぴょんこ", "text": "■■カ■■■■■■ソ\n■■■■ツ■■■っ■■■\n■■ガ■■■い■■■！！"},
        { "location": "1611/SEL"   , "narrator": "", "text": "ちょｗｗｗ"},
        { "location": "1612/ACT"   , "narrator": "", "text": "ちょｗｗｗ"},
        { "location": "1614/TALK"  , "narrator": "ぴょんこ", "text": "えっ？"},
        { "location": "1615/TALK"  , "narrator": "ぴょんこ", "text": "笑えるようなことなんて\n何も言ってませんよ？"},
        { "location": "1616/ACT"   , "narrator": "", "text": "まだ「ぴょんこｽｷ」してない自分が見つかった"},
        { "location": "1618/TALK"  , "narrator": "ぴょんこ", "text": "それは、とっても素敵な\n自分探しの旅でしたね♪"},
        { "location": "1619/SEL"   , "narrator": "", "text": "ぴょんこｽｷ"},
        { "location": "1620/ACT"   , "narrator": "", "text": "ぴょんこｽｷ"},
        { "location": "1623/TALK"  , "narrator": "ぴょんこ", "text": "はい……。"},
        { "location": "1624/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこも、\n$handle$さんが\n大好きです♪"},
        { "location": "1626/TALK"  , "narrator": "ぴょんこ", "text": "まあでも、まだ今回は\n改ざんの形跡は無かった\nってことですよね？"},
        { "location": "1627/SEL"   , "narrator": "", "text": "そうだね"},
        { "location": "1628/ACT"   , "narrator": "", "text": "そうだね"},
        { "location": "1630/TALK"  , "narrator": "ぴょんこ", "text": "じゃあ、今回もまだ\nこころおきなく\nできますね～～♪"},
        { "location": "1631/SEL"   , "narrator": "", "text": "できますね…って、まさか"},
        { "location": "1632/SEL"   , "narrator": "", "text": "やろうやろう！"},
        { "location": "1633/ACT"   , "narrator": "", "text": "できますね…って、まさか"},
        { "location": "1634/TALK"  , "narrator": "ぴょんこ", "text": "もちろん、\nキスチケジャンケン\nですっ！"},
        { "location": "1635/SEL"   , "narrator": "", "text": "望むところだ"},
        { "location": "1636/SEL"   , "narrator": "", "text": "やりたいのは山々だけど、また今度にしよう"},
        { "location": "1637/SEL"   , "narrator": "", "text": "そろそろこんなことしてないで、真面目に取り組もうよ"},
        { "location": "1638/ACT"   , "narrator": "", "text": "望むところだ"},
        { "location": "1639/ACT"   , "narrator": "", "text": "やりたいのは山々だけど、また今度にしよう"},
        { "location": "1640/TALK"  , "narrator": "ぴょんこ", "text": "えーっ、\nそうなんですか？"},
        { "location": "1641/TALK"  , "narrator": "ぴょんこ", "text": "それじゃ、今度、\n絶対ですよ、絶対！"},
        { "location": "1643/ACT"   , "narrator": "", "text": "そろそろこんなことしてないで、真面目に取り組もうよ"},
        { "location": "1644/TALK"  , "narrator": "ぴょんこ", "text": "なにいってるんですか！\nぴょんこはいつだって\n真面目ですよ！"},
        { "location": "1645/TALK"  , "narrator": "ぴょんこ", "text": "真面目を通り越して、\n毎回毎回が真剣勝負です！"},
        { "location": "1646/SEL"   , "narrator": "", "text": "そうなの？"},
        { "location": "1647/ACT"   , "narrator": "", "text": "そうなの？"},
        { "location": "1649/TALK"  , "narrator": "ぴょんこ", "text": "そうです！"},
        { "location": "1650/TALK"  , "narrator": "ぴょんこ", "text": "ですから、\n早くやりましょう！！"},
        { "location": "1651/SEL"   , "narrator": "", "text": "全然真面目じゃないし！\nやらないやらない"},
        { "location": "1652/SEL"   , "narrator": "", "text": "じゃあやるか"},
        { "location": "1653/ACT"   , "narrator": "", "text": "全然真面目じゃないし！\nやらないやらない"},
        { "location": "1654/TALK"  , "narrator": "ぴょんこ", "text": "わかりました。"},
        { "location": "1655/TALK"  , "narrator": "ぴょんこ", "text": "残念ですけど、\n無理にやってもらっても\n仕方ありませんからね。"},
        { "location": "1657/ACT"   , "narrator": "", "text": "じゃあやるか"},
        { "location": "1661/TALK"  , "narrator": "ぴょんこ", "text": "そう来なくっちゃですっ！"},
        { "location": "1667/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんは、\n今キスチケを\n１枚も持っていませんね。"},
        { "location": "1670/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんは、\n今キスチケを\n$pyonko_kissticket$枚持ってますね。"},
        { "location": "1674/TALK"  , "narrator": "ぴょんこ", "text": "今、$handle$さんは\n$pyonko_kissticket$枚のキスチケを\n持っていますね♪"},
        { "location": "1676/TALK"  , "narrator": "ぴょんこ", "text": "3枚以上持っている間は\n何度でも特別なキッスが\n出来ちゃいますよっ！"},
        { "location": "1677/TALK"  , "narrator": "ぴょんこ", "text": "今回もどうですかっ！"},
        { "location": "1679/TALK"  , "narrator": "ぴょんこ", "text": "というわけで！\nおめでとうございます！"},
        { "location": "1680/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんは、\nキスチケを3枚以上\n獲得してますので！"},
        { "location": "1681/TALK"  , "narrator": "ぴょんこ", "text": "今から特別なキッスを\n進呈しちゃいまーす♪"},
        { "location": "1684/SEL"   , "narrator": "", "text": "やったー！"},
        { "location": "1685/SEL"   , "narrator": "", "text": "今！？"},
        { "location": "1686/SEL"   , "narrator": "", "text": "今はそういう気分じゃないから、また今度で"},
        { "location": "1687/ACT"   , "narrator": "", "text": "やったー！"},
        { "location": "1688/ACT"   , "narrator": "", "text": "今！？"},
        { "location": "1689/TALK"  , "narrator": "ぴょんこ", "text": "今じゃなきゃ\nいつやるんですかっ！？"},
        { "location": "1690/TALK"  , "narrator": "ぴょんこ", "text": "今でしょ！"},
        { "location": "1691/SEL"   , "narrator": "", "text": "古くない？"},
        { "location": "1692/ACT"   , "narrator": "", "text": "古くない？"},
        { "location": "1694/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん？"},
        { "location": "1695/ACT"   , "narrator": "", "text": "今はそういう気分じゃないから、また今度で"},
        { "location": "1696/TALK"  , "narrator": "ぴょんこ", "text": "わかったぴょん。"},
        { "location": "1697/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこはいつでも\nオッケーですから、\n気が向いた時にどうぞ♪"},
        { "location": "1701/TALK"  , "narrator": "ぴょんこ", "text": "というわけで今回は、\n$handle$さんの\n好きな服で好きな所に！"},
        { "location": "1702/TALK"  , "narrator": "ぴょんこ", "text": "これからぴょんこは、\n今、現実の私が着てる服に\n着替えてきます♪"},
        { "location": "1703/TALK"  , "narrator": "ぴょんこ", "text": "いっぱい\n楽しんじゃって\nくださいねっ！"},
        { "location": "1713/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん♪"},
        { "location": "1714/TALK"  , "narrator": "ぴょんこ", "text": "どうですかっ？\nそれでは――"},
        { "location": "1716/SEL"   , "narrator": "", "text": "頬、唇"},
        { "location": "1717/SEL"   , "narrator": "", "text": "胸"},
        { "location": "1718/SEL"   , "narrator": "", "text": "おなか"},
        { "location": "1719/ACT"   , "narrator": "", "text": "頬、唇"},
        { "location": "1723/ACT"   , "narrator": "", "text": "胸"},
        { "location": "1728/ACT"   , "narrator": "", "text": "おなか"},
        { "location": "1750/TALK"  , "narrator": "ぴょんこ", "text": "ふわあっ！"},
        { "location": "1753/TALK"  , "narrator": "ぴょんこ", "text": "ふわあっ！"},
        { "location": "1756/TALK"  , "narrator": "ぴょんこ", "text": "ふわあっ！"},
        { "location": "1759/TALK"  , "narrator": "ぴょんこ", "text": "ふわあっ！"},
        { "location": "1762/TALK"  , "narrator": "ぴょんこ", "text": "ふわあっ！"},
        { "location": "1765/TALK"  , "narrator": "ぴょんこ", "text": "ふわあっ！"},
        { "location": "1774/TALK"  , "narrator": "ぴょんこ", "text": "まさに\nメルティキッス♪"},
        { "location": "1776/TALK"  , "narrator": "ぴょんこ", "text": "温かくて\n柔らかい…。"},
        { "location": "1778/TALK"  , "narrator": "ぴょんこ", "text": "もっともっとー♪"},
        { "location": "1782/TALK"  , "narrator": "ぴょんこ", "text": "な、なんだか\n思ったよりも全然\nドキドキしますねっ！"},
        { "location": "1784/TALK"  , "narrator": "ぴょんこ", "text": "不思議と\n嫌じゃないぴょん♪"},
        { "location": "1786/TALK"  , "narrator": "ぴょんこ", "text": "かまかま～～♪"},
        { "location": "1790/TALK"  , "narrator": "ぴょんこ", "text": "おなかって……\nキスされると\nくすぐったいんですねっ…"},
        { "location": "1792/TALK"  , "narrator": "ぴょんこ", "text": "デリケートなので\n優しくしてくださいねっ！"},
        { "location": "1794/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんぴょん♪"},
        { "location": "1797/SEL"   , "narrator": "", "text": "もう一度"},
        { "location": "1798/SEL"   , "narrator": "", "text": "もうやめる"},
        { "location": "1799/ACT"   , "narrator": "", "text": "もう一度"},
        { "location": "1801/ACT"   , "narrator": "", "text": "もうやめる"},
        { "location": "1819/TALK"  , "narrator": "ぴょんこ", "text": "はぁっ。\n想像以上に\n恥ずかしいですね……。"},
        { "location": "1820/TALK"  , "narrator": "ぴょんこ", "text": "でも、とっても\n素敵な時間でした♪"},
        { "location": "1821/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこはいつでも\nオッケーですから、\nまたしましょうね♪"},
        { "location": "1828/TALK"  , "narrator": "ぴょんこ", "text": "というわけで！\nジャンケンしましょう、\nジャンケン♪"},
        { "location": "1831/TALK"  , "narrator": "ぴょんこ", "text": "それじゃ、\nいきますよっ！"},
        { "location": "1833/TALK"  , "narrator": "ぴょんこ", "text": "と思いましたけど、\n既に事後でしたね…。"},
        { "location": "1855/TALK"  , "narrator": "ぴょんこ", "text": "ふわぁっ！\n負けちゃいました…。"},
        { "location": "1859/TALK"  , "narrator": "ぴょんこ", "text": "約束通り、\nキスチケ１枚進呈ぴょん♪"},
        { "location": "1865/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこの\n勝ちでーすっ♪"},
        { "location": "1866/TALK"  , "narrator": "ぴょんこ", "text": "約束通り、\nキスチケ１枚没収ぴょん♪"},
        { "location": "1871/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこの\n勝ちでーすっ♪"},
        { "location": "1872/TALK"  , "narrator": "ぴょんこ", "text": "というわけで、\nプレゼントはナシ！！"},
        { "location": "1878/TALK"  , "narrator": "ぴょんこ", "text": "ふぅ……\nとっても楽しかったです♪"},
        { "location": "1882/TALK"  , "narrator": "ぴょんこ", "text": "って！\nああっ！！"},
        { "location": "1883/TALK"  , "narrator": "ぴょんこ", "text": "おめでとうございます！\nキスチケ３枚以上\nゲットしちゃいましたね♪"},
        { "location": "1884/TALK"  , "narrator": "ぴょんこ", "text": "というわけで！\n早速今から特別なキッスを\n進呈しちゃいまーす♪"},
        { "location": "1892/TALK"  , "narrator": "ぴょんこ", "text": "そういえば、最近は\n現実の私の状況は\nどうですか？"},
        { "location": "1893/SEL"   , "narrator": "", "text": "わりと楽しそうだよ"},
        { "location": "1894/SEL"   , "narrator": "", "text": "あれ？　わからないの？"},
        { "location": "1895/ACT"   , "narrator": "", "text": "わりと楽しそうだよ"},
        { "location": "1896/TALK"  , "narrator": "ぴょんこ", "text": "あっ、やっぱり\nそうでしたか♪\n予想通りですっ！"},
        { "location": "1897/TALK"  , "narrator": "ぴょんこ", "text": "まあ、聞かなくても\nわかってはいた\nことですけど。"},
        { "location": "1898/TALK"  , "narrator": "ぴょんこ", "text": "なんたって、ぴょんこは\nココロの司書ですからね♪"},
        { "location": "1899/ACT"   , "narrator": "", "text": "あれ？　わからないの？"},
        { "location": "1900/TALK"  , "narrator": "ぴょんこ", "text": "え？"},
        { "location": "1901/TALK"  , "narrator": "ぴょんこ", "text": "もちろん、わかりますよ？"},
        { "location": "1902/TALK"  , "narrator": "ぴょんこ", "text": "なんたってぴょんこは\nココロの司書ですからね♪"},
        { "location": "1904/SEL"   , "narrator": "", "text": "なんでまた急にそんなことを"},
        { "location": "1905/ACT"   , "narrator": "", "text": "なんでまた急にそんなことを"},
        { "location": "1907/TALK"  , "narrator": "ぴょんこ", "text": "え？\nなんでって、そんなの――"},
        { "location": "1910/SEL"   , "narrator": "", "text": "ぴょんこ？\n大丈夫！？"},
        { "location": "1911/ACT"   , "narrator": "", "text": "ぴょんこ？\n大丈夫！？"},
        { "location": "1913/TALK"  , "narrator": "ぴょんこ", "text": "えっ？"},
        { "location": "1915/TALK"  , "narrator": "ぴょんこ", "text": "もちろんですよ。\nだってぴょんこは、\nココロの司書ですからね♪"},
        { "location": "1916/SEL"   , "narrator": "", "text": "同じ事２回繰り返してるよ…"},
        { "location": "1917/ACT"   , "narrator": "", "text": "同じ事２回繰り返してるよ…"},
        { "location": "1919/TALK"  , "narrator": "ぴょんこ", "text": "え？"},
        { "location": "1920/TALK"  , "narrator": "ぴょんこ", "text": "何言ってるんですか～。\nそんなわけないじゃ\nないですか。"},
        { "location": "1921/TALK"  , "narrator": "ぴょんこ", "text": "だってぴょんこは、\nココロの司書ですからね♪"},
        { "location": "1922/SEL"   , "narrator": "", "text": "ぴょんこ！\nしっかりして！"},
        { "location": "1923/ACT"   , "narrator": "", "text": "ぴょんこ！\nしっかりして！"},
        { "location": "1925/TALK"  , "narrator": "ぴょんこ", "text": "しっかりもなにも、\n私は――"},
        { "location": "1926/TALK"  , "narrator": "ぴょんこ", "text": "私……っ…"},
        { "location": "1927/TALK"  , "narrator": "ぴょんこ", "text": "私―――"},
        { "location": "1935/SEL"   , "narrator": "", "text": "ぴょんこ"},
        { "location": "1936/ACT"   , "narrator": "", "text": "ぴょんこ"},
        { "location": "1939/SEL"   , "narrator": "", "text": "ぴょんこーっ！！"},
        { "location": "1940/ACT"   , "narrator": "", "text": "ぴょんこーっ！！"},
        { "location": "1946/TALK"  , "narrator": "みやび", "text": "すまぬぴょんこ殿遅れた切腹侍"},
        { "location": "1947/SEL"   , "narrator": "", "text": "みやび！！！"},
        { "location": "1948/ACT"   , "narrator": "", "text": "みやび！！！"},
        { "location": "1950/TALK"  , "narrator": "みやび", "text": "なんぞ相棒か"},
        { "location": "1951/TALK"  , "narrator": "みやび", "text": "ぴょんこちゃんはどういた"},
        { "location": "1952/SEL"   , "narrator": "", "text": "消えた"},
        { "location": "1953/ACT"   , "narrator": "", "text": "消えた"},
        { "location": "1955/TALK"  , "narrator": "みやび", "text": "まじか"},
        { "location": "1956/TALK"  , "narrator": "みやび", "text": "すまん"},
        { "location": "1957/TALK"  , "narrator": "みやび", "text": "力及ばず"},
        { "location": "1958/SEL"   , "narrator": "", "text": "何か知ってるなら教えて"},
        { "location": "1959/ACT"   , "narrator": "", "text": "何か知ってるなら教えて"},
        { "location": "1961/TALK"  , "narrator": "みやび", "text": "恐らくは"},
        { "location": "1962/TALK"  , "narrator": "みやび", "text": "同化の影響がついにぴょんこちゃんまで押し寄せたということ"},
        { "location": "1963/TALK"  , "narrator": "みやび", "text": "現実の卯月がここ最近、顕著に楽観的になっているのも、同化の影響がかなり広がっていることが原因と思われる"},
        { "location": "1964/TALK"  , "narrator": "みやび", "text": "今はまだ悩みや状況に関する記憶は整合性を保っているが、潜在意識に近い、感情や胸騒ぎといったものが消えていると思われる故に楽観的になっているのだと思う"},
        { "location": "1965/SEL"   , "narrator": "", "text": "じゃあ、ぴょんこは消えちゃったの！？"},
        { "location": "1966/ACT"   , "narrator": "", "text": "じゃあ、ぴょんこは消えちゃったの！？"},
        { "location": "1968/TALK"  , "narrator": "みやび", "text": "いや、人格はそう簡単に消えることは無い"},
        { "location": "1969/TALK"  , "narrator": "みやび", "text": "が"},
        { "location": "1970/TALK"  , "narrator": "みやび", "text": "記憶の整理が始まれば、一瞬にして部署異動もあり得る"},
        { "location": "1971/SEL"   , "narrator": "", "text": "じゃあ、どこかで生きてるの？"},
        { "location": "1972/ACT"   , "narrator": "", "text": "じゃあ、どこかで生きてるの？"},
        { "location": "1974/TALK"  , "narrator": "みやび", "text": "それは間違いないと思いたい"},
        { "location": "1975/TALK"  , "narrator": "みやび", "text": "が"},
        { "location": "1976/TALK"  , "narrator": "みやび", "text": "それでも懸念は残る"},
        { "location": "1977/SEL"   , "narrator": "", "text": "なに？"},
        { "location": "1978/ACT"   , "narrator": "", "text": "なに？"},
        { "location": "1980/TALK"  , "narrator": "みやび", "text": "新しく同化した記憶に対し、どうにも順応できない記憶と人格は、その性質を変えられることもある"},
        { "location": "1981/TALK"  , "narrator": "みやび", "text": "その場合、記憶も初期化されるやも"},
        { "location": "1982/SEL"   , "narrator": "", "text": "そういえば、ぴょんこが前にそんな事を言ってたような"},
        { "location": "1983/ACT"   , "narrator": "", "text": "そういえば、ぴょんこが前にそんな事を言ってたような"},
        { "location": "1985/TALK"  , "narrator": "みやび", "text": "少々悲観的に見るならば、ぴょんこは特殊人格故に、それに該当しやすいとは思う"},
        { "location": "1986/SEL"   , "narrator": "", "text": "どうすればいい？？？"},
        { "location": "1987/ACT"   , "narrator": "", "text": "どうすればいい？？？"},
        { "location": "1989/TALK"  , "narrator": "みやび", "text": "今できることは１つだけ"},
        { "location": "1990/TALK"  , "narrator": "みやび", "text": "記憶の書き換えられたポイントを見つけ出し、そこを元に戻すこと"},
        { "location": "1991/TALK"  , "narrator": "みやび", "text": "なるたけ早く。"},
        { "location": "977/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>7月27日　7:12 PM</color>\n豊洲で発生したフェノメノン戦から３日後、神楽の自室にて"},
        { "location": "1314/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "1316/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "1318/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "1320/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "1322/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "1382/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Information:0x03】</color>\nココロスフィアとの通信を\n復元しました。(101)"},
        { "location": "1738/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "1769/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"},
