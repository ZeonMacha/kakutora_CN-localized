{
    "dir": "dramatics/daydra/drm_ch04_00_800.js",
    "type": "Episode",
    "info": {
        "story_id": "4084",
        "cid": "miyabi",
        "title": "らぶとーく 第85話",
        "sub_title": "満願成就と言うべきか"
    },
    "entry":
    [
        { "location": "27/TALK"   , "narrator": "エリカ", "text": "コーンコン。\nエリカです。"},
        { "location": "28/SEL"    , "narrator": "", "text": "ビックリした！"},
        { "location": "29/ACT"    , "narrator": "", "text": "ビックリした！"},
        { "location": "31/TALK"   , "narrator": "エリカ", "text": "ああっ、ごめんね？\n急に出てきちゃって。"},
        { "location": "33/TALK"   , "narrator": "エリカ", "text": "今回あなたとつばめちゃんに\nとって、とても重要な局面を\n迎えるでしょう？"},
        { "location": "35/TALK"   , "narrator": "エリカ", "text": "今回あなたと綾ちゃんに\nとって、とても重要な局面を\n迎えるでしょう？"},
        { "location": "37/TALK"   , "narrator": "エリカ", "text": "今回あなたとガブリエラ\nちゃんにとって、とても\n重要な局面を迎えるでしょ？"},
        { "location": "39/TALK"   , "narrator": "エリカ", "text": "今回あなたとみやびちゃんに\nとって、とても重要な局面を\n迎えるでしょう？"},
        { "location": "41/TALK"   , "narrator": "エリカ", "text": "だから、ギリギリで\nちょっと心許なくは\nあるんだけど――"},
        { "location": "42/TALK"   , "narrator": "エリカ", "text": "わたしからひとつ、\nふたりにプレゼントが\nあるの！"},
        { "location": "43/SEL"    , "narrator": "", "text": "ありがとう！！　なんだろう？"},
        { "location": "44/SEL"    , "narrator": "", "text": "もしかしてニャボッ……"},
        { "location": "45/ACT"    , "narrator": "", "text": "ありがとう！！　なんだろう？"},
        { "location": "46/TALK"   , "narrator": "エリカ", "text": "えへへ。\n喜んでもらえると\nいいんだけど。"},
        { "location": "47/TALK"   , "narrator": "エリカ", "text": "それじゃ、\nプレゼントしまーす！"},
        { "location": "48/ACT"    , "narrator": "", "text": "もしかしてニャボッ……"},
        { "location": "49/TALK"   , "narrator": "エリカ", "text": "ちがうよぉ……。\nあれはまだ未完成だもん。"},
        { "location": "50/TALK"   , "narrator": "エリカ", "text": "でも、興味あるようなら、\n完成したらあなたにも\n教えるね！"},
        { "location": "51/TALK"   , "narrator": "エリカ", "text": "それでね、\n今回のわたしからの\nプレゼントというのは――"},
        { "location": "52/TALK"   , "narrator": "エリカ", "text": "じゃーん！\nこれでーす！"},
        { "location": "56/SEL"    , "narrator": "", "text": "直接お話できるってこと！？"},
        { "location": "57/ACT"    , "narrator": "", "text": "直接お話できるってこと！？"},
        { "location": "59/TALK"   , "narrator": "エリカ", "text": "その通りだよ！"},
        { "location": "60/TALK"   , "narrator": "エリカ", "text": "でも、ちょっと\nプログラムが間に合わなくて\n完全なものじゃないんだ。"},
        { "location": "61/TALK"   , "narrator": "エリカ", "text": "だから、今回は\nこの先３回だけの限定\n利用にさせて欲しいの。"},
        { "location": "62/TALK"   , "narrator": "エリカ", "text": "けど、今のわたしたちの\nように、ちゃんと向かい\n合ってお話できるから！"},
        { "location": "64/TALK"   , "narrator": "エリカ", "text": "だから、頑張って\nつばめちゃんと素敵な\n思い出を作ってきてね！"},
        { "location": "65/TALK"   , "narrator": "エリカ", "text": "あなたと\nつばめちゃんに\n素敵なココロの旅を！"},
        { "location": "67/TALK"   , "narrator": "エリカ", "text": "だから、頑張って\n綾ちゃんと素敵な\n思い出を作ってきてね！"},
        { "location": "68/TALK"   , "narrator": "エリカ", "text": "あなたと\n綾ちゃんに\n素敵なココロの旅を！"},
        { "location": "70/TALK"   , "narrator": "エリカ", "text": "だから、頑張って\nガブリエラちゃんと素敵な\n思い出を作ってきてね！"},
        { "location": "71/TALK"   , "narrator": "エリカ", "text": "あなたと\nガブリエラちゃんに\n素敵なココロの旅を！"},
        { "location": "73/TALK"   , "narrator": "エリカ", "text": "だから、頑張って\nみやびちゃんと素敵な\n思い出を作ってきてね！"},
        { "location": "74/TALK"   , "narrator": "エリカ", "text": "あなたと\nみやびちゃんに\n素敵なココロの旅を！"},
        { "location": "108/SEL"   , "narrator": "", "text": "おーいみやびー"},
        { "location": "109/SEL"   , "narrator": "", "text": "こっち向いて"},
        { "location": "110/SEL"   , "narrator": "", "text": "照れなくていいよ"},
        { "location": "111/ACT"   , "narrator": "", "text": "おーいみやびー"},
        { "location": "114/TALK"  , "narrator": "みやび", "text": "そう気安く\n呼ばんでもえいろう…。"},
        { "location": "115/ACT"   , "narrator": "", "text": "こっち向いて"},
        { "location": "116/TALK"  , "narrator": "みやび", "text": "それは難題ぞね。"},
        { "location": "117/ACT"   , "narrator": "", "text": "照れなくていいよ"},
        { "location": "118/TALK"  , "narrator": "みやび", "text": "…言わんで\nえいことを。"},
        { "location": "120/SEL"   , "narrator": "", "text": "婚姻届くれたのに？"},
        { "location": "121/SEL"   , "narrator": "", "text": "結婚するんでしょ"},
        { "location": "122/SEL"   , "narrator": "", "text": "ヨメとお話ししたいなー"},
        { "location": "123/ACT"   , "narrator": "", "text": "婚姻届くれたのに？"},
        { "location": "124/TALK"  , "narrator": "みやび", "text": "それはそれ\nこれはこれぞね。"},
        { "location": "125/ACT"   , "narrator": "", "text": "結婚するんでしょ"},
        { "location": "126/TALK"  , "narrator": "みやび", "text": "それは決定事項ぞね。"},
        { "location": "127/ACT"   , "narrator": "", "text": "ヨメとお話ししたいなー"},
        { "location": "128/TALK"  , "narrator": "みやび", "text": "…話はしとろう…。"},
        { "location": "133/TALK"  , "narrator": "みやび", "text": "$handle$は\n平気なんかね？"},
        { "location": "134/TALK"  , "narrator": "みやび", "text": "こういう会話形態に\nなっても。"},
        { "location": "135/TALK"  , "narrator": "みやび", "text": "今までと違う\nコミュニケーション\n手段になっても。"},
        { "location": "136/SEL"   , "narrator": "", "text": "むしろうれしいし"},
        { "location": "137/SEL"   , "narrator": "", "text": "今までと\n変わらないでしょ"},
        { "location": "138/SEL"   , "narrator": "", "text": "みやびの反応に\nニヤニヤはするけど"},
        { "location": "139/ACT"   , "narrator": "", "text": "むしろうれしいし"},
        { "location": "140/TALK"  , "narrator": "みやび", "text": "そうなのか…。"},
        { "location": "141/ACT"   , "narrator": "", "text": "今までと\n変わらないでしょ"},
        { "location": "142/TALK"  , "narrator": "みやび", "text": "いやいや。"},
        { "location": "143/ACT"   , "narrator": "", "text": "みやびの反応に\nニヤニヤはするけど"},
        { "location": "144/TALK"  , "narrator": "みやび", "text": "……！"},
        { "location": "147/TALK"  , "narrator": "みやび", "text": "インプットの\n方法がいきなり\n変わりすぎやき。"},
        { "location": "148/TALK"  , "narrator": "みやび", "text": "どうも落ち着かん。"},
        { "location": "149/SEL"   , "narrator": "", "text": "そのうち慣れるよ"},
        { "location": "150/SEL"   , "narrator": "", "text": "ニヤニヤが止まらない"},
        { "location": "151/SEL"   , "narrator": "", "text": "気にしすぎじゃない？"},
        { "location": "152/ACT"   , "narrator": "", "text": "そのうち慣れるよ"},
        { "location": "153/TALK"  , "narrator": "みやび", "text": "今慣れたい。"},
        { "location": "154/ACT"   , "narrator": "", "text": "ニヤニヤが止まらない"},
        { "location": "155/TALK"  , "narrator": "みやび", "text": "相棒が\nそんなやつだとは。"},
        { "location": "156/TALK"  , "narrator": "みやび", "text": "…いや。\n知っとったけんど。"},
        { "location": "157/ACT"   , "narrator": "", "text": "気にしすぎじゃない？"},
        { "location": "158/TALK"  , "narrator": "みやび", "text": "相棒の方が\n気にしなさすぎとは\n思わんかね？"},
        { "location": "160/TALK"  , "narrator": "みやび", "text": "…困った…。"},
        { "location": "161/TALK"  , "narrator": "みやび", "text": "…今の状態は\n想定しておらん\nかったぞね…。"},
        { "location": "168/TALK"  , "narrator": "みやび", "text": "入力デバイスにより"},
        { "location": "169/TALK"  , "narrator": "みやび", "text": "思考は変換される"},
        { "location": "170/TALK"  , "narrator": "みやび", "text": "つまり直接声を出すのと"},
        { "location": "171/TALK"  , "narrator": "みやび", "text": "こうやって話すのでは"},
        { "location": "172/TALK"  , "narrator": "みやび", "text": "勝手が違うのだ"},
        { "location": "173/TALK"  , "narrator": "みやび", "text": "ドゥユーアンダスタン？"},
        { "location": "175/SEL"   , "narrator": "", "text": "カタカナ表記なのはどうかなー"},
        { "location": "176/SEL"   , "narrator": "", "text": "やっぱり普段のみやびだった"},
        { "location": "177/SEL"   , "narrator": "", "text": "マルチデバイスに対応しよう"},
        { "location": "178/ACT"   , "narrator": "", "text": "カタカナ表記なのはどうかなー"},
        { "location": "179/TALK"  , "narrator": "みやび", "text": "ユーザーフレンドリーなところを"},
        { "location": "181/TALK"  , "narrator": "みやび", "text": "強調してみたのだ"},
        { "location": "182/ACT"   , "narrator": "", "text": "やっぱり普段のみやびだった"},
        { "location": "183/TALK"  , "narrator": "みやび", "text": "まあ"},
        { "location": "184/TALK"  , "narrator": "みやび", "text": "うちはうちやけんど"},
        { "location": "185/ACT"   , "narrator": "", "text": "マルチデバイスに対応しよう"},
        { "location": "186/TALK"  , "narrator": "みやび", "text": "ほほう"},
        { "location": "187/TALK"  , "narrator": "みやび", "text": "それっぽいことを"},
        { "location": "189/TALK"  , "narrator": "みやび", "text": "その"},
        { "location": "190/TALK"  , "narrator": "みやび", "text": "なんだ"},
        { "location": "191/TALK"  , "narrator": "みやび", "text": "$handle$とは"},
        { "location": "192/TALK"  , "narrator": "みやび", "text": "常にチャット前提の"},
        { "location": "194/TALK"  , "narrator": "みやび", "text": "お付き合いだったというか"},
        { "location": "196/SEL"   , "narrator": "", "text": "でも結婚するんでしょ"},
        { "location": "197/SEL"   , "narrator": "", "text": "結婚してもそれが続くの？"},
        { "location": "198/SEL"   , "narrator": "", "text": "みやびにとっての結婚とは？"},
        { "location": "199/ACT"   , "narrator": "", "text": "でも結婚するんでしょ"},
        { "location": "200/TALK"  , "narrator": "みやび", "text": "それは"},
        { "location": "201/TALK"  , "narrator": "みやび", "text": "確定事項ぞね"},
        { "location": "202/ACT"   , "narrator": "", "text": "結婚してもそれが続くの？"},
        { "location": "203/TALK"  , "narrator": "みやび", "text": "困るか"},
        { "location": "204/TALK"  , "narrator": "みやび", "text": "やはり"},
        { "location": "205/ACT"   , "narrator": "", "text": "みやびにとっての結婚とは？"},
        { "location": "206/TALK"  , "narrator": "みやび", "text": "確固とした結論があった"},
        { "location": "207/TALK"  , "narrator": "みやび", "text": "しかし雲散霧消した"},
        { "location": "209/TALK"  , "narrator": "みやび", "text": "ぐぬぬ"},
        { "location": "210/TALK"  , "narrator": "みやび", "text": "どうすればいい"},
        { "location": "212/SEL"   , "narrator": "", "text": "とりあえず式を挙げよう"},
        { "location": "213/SEL"   , "narrator": "", "text": "結婚式だけでもしよう"},
        { "location": "214/ACT"   , "narrator": "", "text": "とりあえず式を挙げよう"},
        { "location": "215/TALK"  , "narrator": "みやび", "text": "いや"},
        { "location": "216/TALK"  , "narrator": "みやび", "text": "ちょっと待て"},
        { "location": "217/ACT"   , "narrator": "", "text": "結婚式だけでもしよう"},
        { "location": "218/TALK"  , "narrator": "みやび", "text": "あ"},
        { "location": "219/TALK"  , "narrator": "みやび", "text": "何だと"},
        { "location": "221/TALK"  , "narrator": "みやび", "text": "その発言は"},
        { "location": "222/TALK"  , "narrator": "みやび", "text": "唐突かつ"},
        { "location": "223/TALK"  , "narrator": "みやび", "text": "ハードルだだ上がりぞね"},
        { "location": "224/TALK"  , "narrator": "みやび", "text": "なぜそうなる"},
        { "location": "226/SEL"   , "narrator": "", "text": "したいから"},
        { "location": "227/SEL"   , "narrator": "", "text": "なんとなく？"},
        { "location": "228/SEL"   , "narrator": "", "text": "案ずるより産むが易し"},
        { "location": "229/ACT"   , "narrator": "", "text": "したいから"},
        { "location": "230/TALK"  , "narrator": "みやび", "text": "なんと"},
        { "location": "232/TALK"  , "narrator": "みやび", "text": "直球な"},
        { "location": "233/ACT"   , "narrator": "", "text": "なんとなく？"},
        { "location": "234/TALK"  , "narrator": "みやび", "text": "いや"},
        { "location": "236/TALK"  , "narrator": "みやび", "text": "適当すぎる"},
        { "location": "237/ACT"   , "narrator": "", "text": "案ずるより産むが易し"},
        { "location": "238/TALK"  , "narrator": "みやび", "text": "まあ"},
        { "location": "239/TALK"  , "narrator": "みやび", "text": "そういう考えもあるか"},
        { "location": "241/TALK"  , "narrator": "みやび", "text": "うーぬぬぬぬ"},
        { "location": "247/TALK"  , "narrator": "みやび", "text": "どういう状態\nやったとしても。"},
        { "location": "249/TALK"  , "narrator": "みやび", "text": "$handle$は\n$handle$やし。"},
        { "location": "250/TALK"  , "narrator": "みやび", "text": "うちはうちや。"},
        { "location": "251/TALK"  , "narrator": "みやび", "text": "それにいつか\n直接会えるという\n可能性もある。"},
        { "location": "252/TALK"  , "narrator": "みやび", "text": "そうなっても\nチャットを続けるか？"},
        { "location": "253/TALK"  , "narrator": "みやび", "text": "…いや、あまりにも\nシュールすぎるろう…。"},
        { "location": "254/TALK"  , "narrator": "みやび", "text": "…それはそれで\n少し楽しそうと\n思ったのは許せ。"},
        { "location": "255/TALK"  , "narrator": "みやび", "text": "$handle$。\nうちは決めたぞね。"},
        { "location": "256/TALK"  , "narrator": "みやび", "text": "$handle$と\n式を挙げると。"},
        { "location": "257/SEL"   , "narrator": "", "text": "棚からぼた餅"},
        { "location": "258/SEL"   , "narrator": "", "text": "ひょうたんから駒"},
        { "location": "259/SEL"   , "narrator": "", "text": "割れ鍋にとじぶた"},
        { "location": "260/ACT"   , "narrator": "", "text": "棚からぼた餅"},
        { "location": "262/TALK"  , "narrator": "みやび", "text": "あれ！？"},
        { "location": "263/TALK"  , "narrator": "みやび", "text": "その程度の\n話だったかね。"},
        { "location": "264/ACT"   , "narrator": "", "text": "ひょうたんから駒"},
        { "location": "265/TALK"  , "narrator": "みやび", "text": "それはまたおめでたい\nような気がする。"},
        { "location": "266/TALK"  , "narrator": "みやび", "text": "…で、いいんかね？"},
        { "location": "267/ACT"   , "narrator": "", "text": "割れ鍋にとじぶた"},
        { "location": "268/TALK"  , "narrator": "みやび", "text": "その言い方は\nちっくと気に入らん。"},
        { "location": "269/TALK"  , "narrator": "みやび", "text": "…ある意味現実的な\n表現かもしれんが。"},
        { "location": "271/TALK"  , "narrator": "みやび", "text": "とは言うたけんど。"},
        { "location": "272/TALK"  , "narrator": "みやび", "text": "$handle$の\n等身大看板を\n作るわけにもいかんし。"},
        { "location": "273/TALK"  , "narrator": "みやび", "text": "いや自動人形にすれば\n却って何も言われん\nかもしれんけんど。"},
        { "location": "274/SEL"   , "narrator": "", "text": "いやちょっと待って！"},
        { "location": "275/SEL"   , "narrator": "", "text": "脱線しすぎ"},
        { "location": "276/SEL"   , "narrator": "", "text": "怖いからそれ怖いから"},
        { "location": "277/ACT"   , "narrator": "", "text": "いやちょっと待って！"},
        { "location": "278/TALK"  , "narrator": "みやび", "text": "やっぱり替え玉は\nいかんかねえ。"},
        { "location": "279/ACT"   , "narrator": "", "text": "脱線しすぎ"},
        { "location": "280/TALK"  , "narrator": "みやび", "text": "そういうわけでは\nないけんど。"},
        { "location": "281/TALK"  , "narrator": "みやび", "text": "ちょっと面白そうやと\n思うてしもうたぞね。"},
        { "location": "282/ACT"   , "narrator": "", "text": "怖いからそれ怖いから"},
        { "location": "283/TALK"  , "narrator": "みやび", "text": "そこがえいかと\n思うたけんど。"},
        { "location": "284/TALK"  , "narrator": "みやび", "text": "やっぱり\nサイコホラー路線は\nいかんかねえ。"},
        { "location": "286/TALK"  , "narrator": "みやび", "text": "妥協案として\nこういうのは\nどうかいね？"},
        { "location": "287/TALK"  , "narrator": "みやび", "text": "日本には八百万の神が\nおると当時に\n付喪神という存在もある。"},
        { "location": "289/TALK"  , "narrator": "みやび", "text": "その懐の広さは\n祈願の類にも\n表れちゅう。"},
        { "location": "290/TALK"  , "narrator": "みやび", "text": "やき、これなら\n式が挙げられると\n思うんやけんど…。"},
