    "entry":
    [
        { "location": "864/SCENARIO", "narrator": "", "text": "バーチャルプラネットのアリス"},
        { "location": "882/TALK"    , "narrator": "つばめ", "text": "メノウちゃんの曲\nやっぱりいいなー。"},
        { "location": "884/TALK"    , "narrator": "神楽", "text": "……。"},
        { "location": "886/TALK"    , "narrator": "みやび", "text": "つばめちゃんは本当に\nメノウのことが\n好きなんやねえ。"},
        { "location": "888/TALK"    , "narrator": "つばめ", "text": "もちろんです！"},
        { "location": "890/TALK"    , "narrator": "つばめ", "text": "曲も声もアレンジも\nステキですけど。"},
        { "location": "891/TALK"    , "narrator": "つばめ", "text": "アルバムを通して\nひとつの物語に\nなってるところ！"},
        { "location": "892/TALK"    , "narrator": "つばめ", "text": "何度聞いても\n同じところで\nドキドキして…。"},
        { "location": "893/SEL"     , "narrator": "", "text": "目の前で褒められる気分はどう？"},
        { "location": "894/ACT"     , "narrator": "", "text": "目の前で褒められる気分はどう？"},
        { "location": "911/TALK"    , "narrator": "神楽", "text": "どう答えれば満足ですか？"},
        { "location": "913/SEL"     , "narrator": "", "text": "機嫌悪いの？"},
        { "location": "914/SEL"     , "narrator": "", "text": "なんかごめんね"},
        { "location": "915/SEL"     , "narrator": "", "text": "うれしいですよ！　とか？"},
        { "location": "916/ACT"     , "narrator": "", "text": "機嫌悪いの？"},
        { "location": "917/TALK"    , "narrator": "神楽", "text": "そういうわけではないですけどー"},
        { "location": "918/ACT"     , "narrator": "", "text": "なんかごめんね"},
        { "location": "919/TALK"    , "narrator": "神楽", "text": "謝る必要なんて全然ないですよ？"},
        { "location": "920/ACT"     , "narrator": "", "text": "うれしいですよ！　とか？"},
        { "location": "921/TALK"    , "narrator": "神楽", "text": "あんまりそういう気分にはならないですね"},
        { "location": "923/TALK"    , "narrator": "神楽", "text": "つばめさんは私がメノウだって知らないわけですし"},
        { "location": "924/TALK"    , "narrator": "神楽", "text": "リサーチ材料にするくらいですかね"},
        { "location": "926/SEL"     , "narrator": "", "text": "冷静なんだね"},
        { "location": "927/SEL"     , "narrator": "", "text": "ドライだなあ"},
        { "location": "928/SEL"     , "narrator": "", "text": "本当は嬉しいでしょ？"},
        { "location": "929/ACT"     , "narrator": "", "text": "冷静なんだね"},
        { "location": "930/TALK"    , "narrator": "神楽", "text": "そうですね"},
        { "location": "931/TALK"    , "narrator": "神楽", "text": "そうじゃないとアーティストではいられませんからね"},
        { "location": "932/ACT"     , "narrator": "", "text": "ドライだなあ"},
        { "location": "933/TALK"    , "narrator": "神楽", "text": "そうでしょうか？"},
        { "location": "934/TALK"    , "narrator": "神楽", "text": "正しい対処だと思いますけど"},
        { "location": "935/ACT"     , "narrator": "", "text": "本当は嬉しいでしょ？"},
        { "location": "936/TALK"    , "narrator": "神楽", "text": "そこは微妙ですね"},
        { "location": "937/TALK"    , "narrator": "神楽", "text": "いつの時期のメノウかにもよりますし"},
        { "location": "951/TALK"    , "narrator": "みやび", "text": "つばめちゃんがメノウを\n好きなことは\nようわかった。"},
        { "location": "953/TALK"    , "narrator": "つばめ", "text": "えへへ……。"},
        { "location": "954/TALK"    , "narrator": "神楽", "text": "私少し疑問に\n思ってることが\nあるんですけど。"},
        { "location": "956/TALK"    , "narrator": "みやび", "text": "うむ。"},
        { "location": "958/TALK"    , "narrator": "つばめ", "text": "何？"},
        { "location": "959/TALK"    , "narrator": "神楽", "text": "例えばメノウのアルバムは\n最初から創作じゃ\nないですか。"},
        { "location": "960/TALK"    , "narrator": "神楽", "text": "ある意味嘘です。\nでもそれを聴いて\n人は感動する。"},
        { "location": "962/TALK"    , "narrator": "つばめ", "text": "うん。\nだって本当に\nすごいんだもん！"},
        { "location": "963/TALK"    , "narrator": "神楽", "text": "……。"},
        { "location": "964/TALK"    , "narrator": "神楽", "text": "でも実話の場合は\nちょっと反応が\n変わってきますよね。"},
        { "location": "965/TALK"    , "narrator": "つばめ", "text": "どういうこと？"},
        { "location": "966/TALK"    , "narrator": "神楽", "text": "実話だと言われた\n話の内容が人の心を\n動かしたとしても。"},
        { "location": "967/TALK"    , "narrator": "神楽", "text": "それが創作だとわかれば\n人は怒りを覚えます。"},
        { "location": "968/TALK"    , "narrator": "神楽", "text": "この差はどこから\n来るんでしょうね？"},
        { "location": "969/TALK"    , "narrator": "みやび", "text": "嘘をつかれたと\n思うからや\nないかねえ。"},
        { "location": "970/TALK"    , "narrator": "みやび", "text": "裏切られた気持ちに\nなるからやない？"},
        { "location": "972/TALK"    , "narrator": "つばめ", "text": "…優しい嘘って\nありますよね。"},
        { "location": "973/TALK"    , "narrator": "つばめ", "text": "その場合もバレたら\n怒っちゃうもの\nなんでしょうか？"},
        { "location": "974/TALK"    , "narrator": "神楽", "text": "…………。"},
        { "location": "975/TALK"    , "narrator": "みやび", "text": "うちは内容に\nよるねえ。"},
        { "location": "976/TALK"    , "narrator": "みやび", "text": "遅刻しそうごめん\nちうて連絡した時に\n自分もだよとか。"},
        { "location": "977/TALK"    , "narrator": "みやび", "text": "そういうのは\n優しいねえと\n思うしねえ。"},
        { "location": "979/TALK"    , "narrator": "つばめ", "text": "えっ！？"},
        { "location": "980/TALK"    , "narrator": "つばめ", "text": "わたしはそういう時は\n本当に\n遅刻してますよ？"},
        { "location": "982/TALK"    , "narrator": "みやび", "text": "まあつばめちゃんは\nそうやろうけど。"},
        { "location": "983/TALK"    , "narrator": "みやび", "text": "アーヤがそう返して\n来た時は多分嘘ぞね。"},
        { "location": "984/TALK"    , "narrator": "つばめ", "text": "確かにそうかも\nしれません……。"},
        { "location": "987/TALK"    , "narrator": "みやび", "text": "卯月はどうぞね？"},
        { "location": "988/TALK"    , "narrator": "神楽", "text": "私ですか？"},
        { "location": "989/SEL"     , "narrator": "", "text": "$me$が答えを当ててあげる"},
        { "location": "990/ACT"     , "narrator": "", "text": "$me$が答えを当ててあげる"},
        { "location": "1007/SEL"    , "narrator": "", "text": "嘘、ダメ、絶対"},
        { "location": "1008/SEL"    , "narrator": "", "text": "ケースバイケース"},
        { "location": "1009/SEL"    , "narrator": "", "text": "むしろ全てが嘘"},
        { "location": "1010/ACT"    , "narrator": "", "text": "嘘、ダメ、絶対"},
        { "location": "1011/TALK"   , "narrator": "神楽", "text": "そんなに潔癖でも子供でもないですよ？"},
        { "location": "1012/ACT"    , "narrator": "", "text": "ケースバイケース"},
        { "location": "1013/TALK"   , "narrator": "神楽", "text": "それってどっちでもいいってことですよねー"},
        { "location": "1014/ACT"    , "narrator": "", "text": "むしろ全てが嘘"},
        { "location": "1015/TALK"   , "narrator": "神楽", "text": "いっそそう言えればどれだけ楽なことか！"},
        { "location": "1027/TALK"   , "narrator": "神楽", "text": "ちょっとすぐには\n答えが出ないです。"},
        { "location": "1028/TALK"   , "narrator": "みやび", "text": "…卯月は真面目\nなんやねえ。"},
        { "location": "1031/TALK"   , "narrator": "神楽", "text": "そういうわけじゃ\nないんですけど…。"},
        { "location": "1033/TALK"   , "narrator": "みやび", "text": "つばめちゃんは？"},
        { "location": "1034/TALK"   , "narrator": "つばめ", "text": "わたしは……。"},
        { "location": "1035/TALK"   , "narrator": "つばめ", "text": "嘘をつかれたことは\nさみしいって思います。"},
        { "location": "1036/TALK"   , "narrator": "つばめ", "text": "でも、理由が\nわたしを思っての\nことなら。"},
        { "location": "1037/TALK"   , "narrator": "つばめ", "text": "その気持ちは\nうれしいかもです。"},
        { "location": "1038/TALK"   , "narrator": "みやび", "text": "つばめちゃんは\nえい子やねえ。"},
        { "location": "1040/TALK"   , "narrator": "つばめ", "text": "そ、そんなこと\nないですよ……！？"},
        { "location": "1043/TALK"   , "narrator": "神楽", "text": "………………。"},
        { "location": "873/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>某月某日　0:20 PM</color>\nとある平日、付属学園食堂でのこと"}
    ]
}
