    "entry":
    [
        { "location": "28/TALK"   , "narrator": "神楽", "text": "んんっ…今、何時？"},
        { "location": "30/TALK"   , "narrator": "神楽", "text": "まだ午前中、か…。\n結構寝た感じするのに…。"},
        { "location": "31/TALK"   , "narrator": "神楽", "text": "…………。"},
        { "location": "35/TALK"   , "narrator": "神楽", "text": "おはようございます$handle$さん"},
        { "location": "36/TALK"   , "narrator": "神楽", "text": "今いますか？"},
        { "location": "37/SEL"    , "narrator": "", "text": "学校はどうしたの？"},
        { "location": "40/TALK"   , "narrator": "神楽", "text": "いませんか？"},
        { "location": "42/TALK"   , "narrator": "神楽", "text": "朝のこんな時間だし"},
        { "location": "49/TALK"   , "narrator": "神楽", "text": "…………。"},
        { "location": "50/TALK"   , "narrator": "神楽", "text": "ラノベでも読もうかな。"},
        { "location": "52/ACT"    , "narrator": "", "text": "学校はどうしたの？"},
        { "location": "54/TALK"   , "narrator": "神楽", "text": "休んだんですよ"},
        { "location": "55/TALK"   , "narrator": "神楽", "text": "ちょっと精神的に疲れが出てしまって"},
        { "location": "57/SEL"    , "narrator": "", "text": "トライナリーの仕事、疲れる？"},
        { "location": "58/SEL"    , "narrator": "", "text": "任務、大変だよね"},
        { "location": "59/ACT"    , "narrator": "", "text": "トライナリーの仕事、疲れる？"},
        { "location": "60/TALK"   , "narrator": "神楽", "text": "いえ、別に。今のところは大したことないなーって感じですね"},
        { "location": "61/TALK"   , "narrator": "神楽", "text": "そうじゃなくて、私が精神的にキッツイのは"},
        { "location": "64/TALK"   , "narrator": "神楽", "text": "あれ、なんでしたっけ"},
        { "location": "65/TALK"   , "narrator": "神楽", "text": "何が辛いのかを忘れるくらいつらいことだったのかな"},
        { "location": "66/TALK"   , "narrator": "神楽", "text": "あ、あれだ、同年代女子でつるむのが苦手で気づかれパナいって話ですね"},
        { "location": "68/SEL"    , "narrator": "", "text": "いつも大変だね"},
        { "location": "69/SEL"    , "narrator": "", "text": "今からでもやめたら？"},
        { "location": "70/ACT"    , "narrator": "", "text": "いつも大変だね"},
        { "location": "71/TALK"   , "narrator": "神楽", "text": "自分で決めて始めたことだし、わりと好きでやってることなので。確かに大変ではありますけど"},
        { "location": "72/TALK"   , "narrator": "神楽", "text": "でもそう言ってもらえると"},
        { "location": "74/TALK"   , "narrator": "神楽", "text": "ちょっと心が軽くなります"},
        { "location": "75/ACT"    , "narrator": "", "text": "今からでもやめたら？"},
        { "location": "76/TALK"   , "narrator": "神楽", "text": "まあ、それもひとつの選択肢かもしれませんけど"},
        { "location": "77/TALK"   , "narrator": "神楽", "text": "自分で決めて始めたことだし、わりと好きでやってることなので"},
        { "location": "78/TALK"   , "narrator": "神楽", "text": "それに今やめたら"},
        { "location": "79/TALK"   , "narrator": "神楽", "text": "つばめさんたちに迷惑かけちゃいますし"},
        { "location": "81/ACT"    , "narrator": "", "text": "任務、大変だよね"},
        { "location": "82/TALK"   , "narrator": "神楽", "text": "自分で決めて始めたことだし、わりと好きでやってることなので。確かに大変ではありますけど"},
        { "location": "83/TALK"   , "narrator": "神楽", "text": "でも"},
        { "location": "84/TALK"   , "narrator": "神楽", "text": "わかってくれる人がいるだけでも"},
        { "location": "85/TALK"   , "narrator": "神楽", "text": "ちょっと心が軽くなります"},
        { "location": "89/SEL"    , "narrator": "", "text": "今日は一日のんびり？"},
        { "location": "90/ACT"    , "narrator": "", "text": "今日は一日のんびり？"},
        { "location": "92/TALK"   , "narrator": "神楽", "text": "その予定です"},
        { "location": "93/TALK"   , "narrator": "神楽", "text": "今日は一日ベッドの上で"},
        { "location": "95/TALK"   , "narrator": "神楽", "text": "ラノベを読んで過ごすつもりなんです"},
        { "location": "96/TALK"   , "narrator": "神楽", "text": "何冊読めるか楽しみです！"},
        { "location": "98/SEL"    , "narrator": "", "text": "ゆっくり休んでね"},
        { "location": "99/SEL"    , "narrator": "", "text": "お母さんに怒られない？"},
        { "location": "100/ACT"   , "narrator": "", "text": "ゆっくり休んでね"},
        { "location": "101/TALK"  , "narrator": "神楽", "text": "ありがとうございます"},
        { "location": "102/ACT"   , "narrator": "", "text": "お母さんに怒られない？"},
        { "location": "104/TALK"  , "narrator": "神楽", "text": "ご心配なく"},
        { "location": "105/TALK"  , "narrator": "神楽", "text": "鍵をかけてあるから"},
        { "location": "106/TALK"  , "narrator": "神楽", "text": "母が入ってくる心配はありませんし"},
        { "location": "108/SEL"   , "narrator": "", "text": "お母さんと仲が悪いの？"},
        { "location": "109/ACT"   , "narrator": "", "text": "お母さんと仲が悪いの？"},
        { "location": "112/TALK"  , "narrator": "神楽", "text": "どうしてですか？"},
        { "location": "113/TALK"  , "narrator": "神楽", "text": "とっても仲良しですよ"},
        { "location": "114/TALK"  , "narrator": "神楽", "text": "鍵をかけるのはそういう意味じゃなくて"},
        { "location": "116/SEL"   , "narrator": "", "text": "ラノベの世界に浸りたいから？"},
        { "location": "117/SEL"   , "narrator": "", "text": "部屋に入れたらぶん殴られるからでしょ？"},
        { "location": "118/ACT"   , "narrator": "", "text": "ラノベの世界に浸りたいから？"},
        { "location": "119/TALK"  , "narrator": "神楽", "text": "そうですそういうことです"},
        { "location": "120/TALK"  , "narrator": "神楽", "text": "ラノベの世界にどっぷり浸かることで疲れを癒やすんです"},
        { "location": "121/TALK"  , "narrator": "神楽", "text": "というわけなので"},
        { "location": "122/TALK"  , "narrator": "神楽", "text": "また読み終わったら声をかけますね"},
        { "location": "123/ACT"   , "narrator": "", "text": "部屋に入れたらぶん殴られるからでしょ？"},
        { "location": "125/TALK"  , "narrator": "神楽", "text": "は？"},
        { "location": "126/TALK"  , "narrator": "神楽", "text": "なにそれ"},
        { "location": "129/TALK"  , "narrator": "神楽", "text": "本気で言ってるんですかそれ？"},
        { "location": "132/SEL"   , "narrator": "", "text": "心配だったから"},
        { "location": "133/ACT"   , "narrator": "", "text": "心配だったから"},
        { "location": "135/TALK"  , "narrator": "神楽", "text": "意味わからないですから"},
        { "location": "136/TALK"  , "narrator": "神楽", "text": "大体"},
        { "location": "137/TALK"  , "narrator": "神楽", "text": "人の母親を酷く言うとか非常識過ぎですし"},
        { "location": "138/TALK"  , "narrator": "神楽", "text": "どういうつもりですか？"},
        { "location": "140/SEL"   , "narrator": "", "text": "ごめんなさい"},
        { "location": "141/SEL"   , "narrator": "", "text": "じゃあ殴られたことないの？"},
        { "location": "142/ACT"   , "narrator": "", "text": "ごめんなさい"},
        { "location": "143/TALK"  , "narrator": "神楽", "text": "いやそうじゃなくて"},
        { "location": "144/TALK"  , "narrator": "神楽", "text": "どういうつもりなのかと聞いてるんですけど？"},
        { "location": "145/ACT"   , "narrator": "", "text": "じゃあ殴られたことないの？"},
        { "location": "146/TALK"  , "narrator": "神楽", "text": "いや違うでしょそれ"},
        { "location": "147/TALK"  , "narrator": "神楽", "text": "どういうつもりか聞いてるんだから答えになってないし"},
        { "location": "149/TALK"  , "narrator": "神楽", "text": "自分の母親をＤＶ親みたいに言われた私の気持ちわかるか？"},
        { "location": "150/TALK"  , "narrator": "神楽", "text": "ふざけんな"},
        { "location": "151/TALK"  , "narrator": "神楽", "text": "おまえなにさまだよ"},
        { "location": "152/TALK"  , "narrator": "神楽", "text": "クソゴミ"},
        { "location": "154/SEL"   , "narrator": "", "text": "でも…"},
        { "location": "155/ACT"   , "narrator": "", "text": "でも…"},
        { "location": "157/TALK"  , "narrator": "神楽", "text": "いやもう話したくないし"},
        { "location": "158/TALK"  , "narrator": "神楽", "text": "常識学ぶか人の気持ち考えられるようになってから出直せ"},
        { "location": "159/TALK"  , "narrator": "神楽", "text": "本当最悪"},
        { "location": "164/TALK"  , "narrator": "神楽", "text": "…なんなのよ。"},
        { "location": "165/TALK"  , "narrator": "神楽", "text": "ママのこと、\nなにも知らないくせに\n好き放題言って…。"},
        { "location": "167/TALK"  , "narrator": "神楽", "text": "ママは…、\nぐすっ…。"},
        { "location": "168/TALK"  , "narrator": "神楽", "text": "ママは…、\n絶対、そんなことしない\n人なのに…。"},
        { "location": "177/TALK"  , "narrator": "神楽", "text": "さて、と。\n昨日買ってきた新刊から\n読もうかな？"},
        { "location": "181/TALK"  , "narrator": "神楽", "text": "もぅ、ラノベ読むって\n言ってるのに――"},
        { "location": "184/TALK"  , "narrator": "神楽", "text": "あっ…。"},
        { "location": "186/TALK"  , "narrator": "神楽", "text": "はぁ…予想してたけど、\nやっぱり来た…。"},
        { "location": "189/TALK"  , "narrator": "つばめ", "text": "卯月さーん(´･ω･｀) "},
        { "location": "190/TALK"  , "narrator": "雛", "text": "具合どう？"},
        { "location": "191/TALK"  , "narrator": "雛", "text": "ちょっとはよくなったー？"},
        { "location": "193/TALK"  , "narrator": "神楽", "text": "大丈夫ですよ"},
        { "location": "194/TALK"  , "narrator": "神楽", "text": "ちょっと疲れてるだけなので"},
        { "location": "196/TALK"  , "narrator": "つばめ", "text": "よかったー(*´︶`*)"},
        { "location": "197/TALK"  , "narrator": "神楽", "text": "学校の方はどうですか？"},
        { "location": "199/TALK"  , "narrator": "つばめ", "text": "ぅーん"},
        { "location": "200/TALK"  , "narrator": "つばめ", "text": "特に変わったことはなぃよー(･Д･｀)"},
        { "location": "201/TALK"  , "narrator": "雛", "text": "いやいや大ありだから！"},
        { "location": "202/TALK"  , "narrator": "雛", "text": "つばめちゃんがね"},
        { "location": "203/TALK"  , "narrator": "雛", "text": "ずーっと神楽ちゃんのこと心配しっぱなし"},
        { "location": "204/TALK"  , "narrator": "繭", "text": "卯月さん、大丈夫かな？"},
        { "location": "205/TALK"  , "narrator": "繭", "text": "このセリフが朝から連発状態"},
        { "location": "206/TALK"  , "narrator": "神楽", "text": "そうなんですか？"},
        { "location": "208/TALK"  , "narrator": "つばめ", "text": "だって"},
        { "location": "209/TALK"  , "narrator": "つばめ", "text": "心配だからヾ(｡>﹏<｡)ﾉﾞ"},
        { "location": "210/TALK"  , "narrator": "繭", "text": "元気なようで安心した"},
        { "location": "211/TALK"  , "narrator": "神楽", "text": "ご心配おかけしました"},
        { "location": "214/TALK"  , "narrator": "雛", "text": "いいのいいのー"},
        { "location": "215/TALK"  , "narrator": "雛", "text": "それじゃ休み時間終わるから"},
        { "location": "216/TALK"  , "narrator": "雛", "text": "またあとでねー"},
        { "location": "217/TALK"  , "narrator": "つばめ", "text": "本当だ"},
        { "location": "218/TALK"  , "narrator": "つばめ", "text": "ぁっとぃぅ間だよ…(o´Д`)=з"},
        { "location": "219/TALK"  , "narrator": "繭", "text": "ゆっくり休んで"},
        { "location": "220/TALK"  , "narrator": "神楽", "text": "授業頑張ってくださいね"},
        { "location": "226/TALK"  , "narrator": "神楽", "text": "…あっという間。\n休み時間って、こんなに\n短かったっけ…？"},
        { "location": "227/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "228/TALK"  , "narrator": "神楽", "text": "はぁ。\nなんかラノベ読む気力\n無くなっちゃった。"},
        { "location": "229/TALK"  , "narrator": "神楽", "text": "さっきまで、あんなに\n楽しみにしてたのに。"},
        { "location": "230/TALK"  , "narrator": "神楽", "text": "本当に疲れてるって\nことかな……。"},
        { "location": "279/TALK"  , "narrator": "ぴょんこ", "text": "　"},
        { "location": "318/TALK"  , "narrator": "ぴょんこ", "text": "ですから、つばめさんっ…"},
        { "location": "320/TALK"  , "narrator": "つばめ", "text": "ああっ！\nぴょんこちゃん、\nお客さん！"},
        { "location": "322/TALK"  , "narrator": "ぴょんこ", "text": "えっ？"},
        { "location": "323/SEL"   , "narrator": "", "text": "お取り込み中すみません"},
        { "location": "324/ACT"   , "narrator": "", "text": "お取り込み中すみません"},
        { "location": "326/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんっ！？"},
        { "location": "327/TALK"  , "narrator": "つばめ", "text": "こんにちは！"},
        { "location": "329/TALK"  , "narrator": "ぴょんこ", "text": "つばめさん、すみません！\n一度席を外して\nもらえないでしょうか！"},
        { "location": "331/TALK"  , "narrator": "つばめ", "text": "えっ、なんで！？"},
        { "location": "332/TALK"  , "narrator": "ぴょんこ", "text": "いいから早く！\nここはぴょんこの\nココロゲートですよっ！"},
        { "location": "333/TALK"  , "narrator": "つばめ", "text": "あっ、う、うん！"},
        { "location": "340/TALK"  , "narrator": "ぴょんこ", "text": "あらためまして、\nぴょんこですよ～♪"},
        { "location": "341/SEL"   , "narrator": "", "text": "大丈夫だったの…？"},
        { "location": "342/SEL"   , "narrator": "", "text": "ぴょんこｽｷ"},
        { "location": "343/ACT"   , "narrator": "", "text": "大丈夫だったの…？"},
        { "location": "344/TALK"  , "narrator": "ぴょんこ", "text": "もちろんですよっ♪"},
        { "location": "345/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんより\n優先する事項なんて\nありませんから♪"},
        { "location": "346/ACT"   , "narrator": "", "text": "ぴょんこｽｷ"},
        { "location": "349/TALK"  , "narrator": "ぴょんこ", "text": "きゃっ♪"},
        { "location": "350/TALK"  , "narrator": "ぴょんこ", "text": "そこでつばめさんが\n聞いているというのに、\nお構いなしなんですねっ！"},
        { "location": "351/SEL"   , "narrator": "", "text": "つばめ、そこにいるの！？"},
        { "location": "352/SEL"   , "narrator": "", "text": "全然構わないよ"},
        { "location": "353/ACT"   , "narrator": "", "text": "つばめ、そこにいるの！？"},
        { "location": "356/TALK"  , "narrator": "ぴょんこ", "text": "なーんて♪"},
        { "location": "357/TALK"  , "narrator": "ぴょんこ", "text": "いるわけ\nないじゃないですか♪"},
        { "location": "358/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこはぁ、\n$handle$さんに\nｽｷって言って欲しくて～♪"},
        { "location": "359/TALK"  , "narrator": "ぴょんこ", "text": "わざわざつばめさんに\n席を外して\nもらったんですよっ？"},
        { "location": "360/TALK"  , "narrator": "ぴょんこ", "text": "でもでもっ！\nそこまでビビってるって\nことは、まさかまさか！"},
        { "location": "361/TALK"  , "narrator": "ぴょんこ", "text": "浮気ですかっ？"},
        { "location": "362/SEL"   , "narrator": "", "text": "全然違います！"},
        { "location": "363/SEL"   , "narrator": "", "text": "そうだけど、本命はぴょんこだよ"},
        { "location": "364/SEL"   , "narrator": "", "text": "…実は本命はつばめなんだ"},
        { "location": "365/ACT"   , "narrator": "", "text": "全然違います！"},
        { "location": "366/TALK"  , "narrator": "ぴょんこ", "text": "ふふっ。\n冗談に決まってるじゃ\nないですかー。"},
        { "location": "367/TALK"  , "narrator": "ぴょんこ", "text": "マジになる\n$handle$さん、\nかわゆす～～～♪"},
        { "location": "368/SEL"   , "narrator": "", "text": "えへへ…"},
        { "location": "369/SEL"   , "narrator": "", "text": "…スラング古くない？"},
        { "location": "370/ACT"   , "narrator": "", "text": "えへへ…"},
        { "location": "373/TALK"  , "narrator": "ぴょんこ", "text": "もーっ！\n$handle$さん\n可愛すぎ事件発生ですっ！"},
        { "location": "374/TALK"  , "narrator": "ぴょんこ", "text": "少し自重してもらわないと\n仕事にならないんですけど\nﾊｧﾊｧ……"},
        { "location": "375/SEL"   , "narrator": "", "text": "おちつこう"},
        { "location": "376/ACT"   , "narrator": "", "text": "おちつこう"},
        { "location": "379/TALK"  , "narrator": "ぴょんこ", "text": "ふぅ……\nおちつきました♪"},
        { "location": "380/ACT"   , "narrator": "", "text": "…スラング古くない？"},
        { "location": "381/TALK"  , "narrator": "ぴょんこ", "text": "……。"},
        { "location": "382/TALK"  , "narrator": "ぴょんこ", "text": "今のはココロの中の\nみさみさが勝手に\n発言しましたぴょん。"},
        { "location": "384/ACT"   , "narrator": "", "text": "そうだけど、本命はぴょんこだよ"},
        { "location": "385/TALK"  , "narrator": "ぴょんこ", "text": "うわーうわーうわー……"},
        { "location": "386/TALK"  , "narrator": "ぴょんこ", "text": "ちょっと！\n$handle$さんっ！"},
        { "location": "387/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこのティーンズ\n真っ盛りで瑞々しい\nココロゲートをっ！"},
        { "location": "388/TALK"  , "narrator": "ぴょんこ", "text": "一瞬にしてドロドロ\n人妻団地妻ココロゲートに\nしないでくださいっ！"},
        { "location": "389/TALK"  , "narrator": "ぴょんこ", "text": "でもでもっ！\nちょっとゾクゾク\nしちゃいますねっ！"},
        { "location": "390/TALK"  , "narrator": "ぴょんこ", "text": "だって、そこにはまだ\nつばめさんが\nいるんですよっ？"},
        { "location": "391/TALK"  , "narrator": "ぴょんこ", "text": "なんという背徳感\nﾊｧﾊｧ……"},
        { "location": "392/SEL"   , "narrator": "", "text": "怒らないの？"},
        { "location": "393/SEL"   , "narrator": "", "text": "興奮してない？"},
        { "location": "394/ACT"   , "narrator": "", "text": "怒らないの？"},
        { "location": "395/TALK"  , "narrator": "ぴょんこ", "text": "まさか～。\nそんなすぐには\n怒りませんよっ♪"},
        { "location": "396/TALK"  , "narrator": "ぴょんこ", "text": "だって、\n$handle$さんの\n本命はぴょんこですよね？"},
        { "location": "397/TALK"  , "narrator": "ぴょんこ", "text": "ですから、\n貢ぐだけ貢いでもらって―"},
        { "location": "398/TALK"  , "narrator": "ぴょんこ", "text": "利用価値がなくなったなー\nと思ったら、このチケット\nを使わせてもらいます♪"},
        { "location": "399/ACT"   , "narrator": "", "text": "興奮してない？"},
        { "location": "400/TALK"  , "narrator": "ぴょんこ", "text": "そりゃ興奮だって\nしますよっ！"},
        { "location": "401/TALK"  , "narrator": "ぴょんこ", "text": "ここから先、\n$handle$さん\nどうなっちゃうのかなー♪"},
        { "location": "402/TALK"  , "narrator": "ぴょんこ", "text": "つばめさんに\n背中からグサッ！　とか\nされちゃうのかすぃら～♪"},
        { "location": "403/TALK"  , "narrator": "ぴょんこ", "text": "な～んてっ！"},
        { "location": "404/TALK"  , "narrator": "ぴょんこ", "text": "そのまえに\nぴょんこが\n刺すけどな。"},
        { "location": "406/ACT"   , "narrator": "", "text": "…実は本命はつばめなんだ"},
        { "location": "407/TALK"  , "narrator": "ぴょんこ", "text": "え"},
        { "location": "408/TALK"  , "narrator": "ぴょんこ", "text": "マジです？"},
        { "location": "409/SEL"   , "narrator": "", "text": "嘘はつけないので、本当です"},
        { "location": "410/SEL"   , "narrator": "", "text": "すみません冗談です"},
        { "location": "411/ACT"   , "narrator": "", "text": "嘘はつけないので、本当です"},
        { "location": "413/TALK"  , "narrator": "ぴょんこ", "text": "あー、\nそうだったんですね。"},
        { "location": "414/TALK"  , "narrator": "ぴょんこ", "text": "それじゃ\n仕方ないですよね。"},
        { "location": "415/TALK"  , "narrator": "ぴょんこ", "text": "正直に言ってくれて\nありがとうございます♪"},
        { "location": "416/TALK"  , "narrator": "ぴょんこ", "text": "それじゃ今後は\nつばめさんに配慮して\n諸々控えて行きますね。"},
        { "location": "417/TALK"  , "narrator": "ぴょんこ", "text": "そんな事にも\n気づかず、\nすみませんでした。"},
        { "location": "419/ACT"   , "narrator": "", "text": "すみません冗談です"},
        { "location": "420/TALK"  , "narrator": "ぴょんこ", "text": "は！？"},
        { "location": "421/TALK"  , "narrator": "ぴょんこ", "text": "おい、冗談にも\n程があるだろ。"},
        { "location": "422/TALK"  , "narrator": "ぴょんこ", "text": "こっちが本気で気持ち\nぶっつけてんのに、それに\n対して冗談でしたぁ！？"},
        { "location": "425/TALK"  , "narrator": "ぴょんこ", "text": "<size=35>ふざけんな！</size>"},
        { "location": "426/SEL"   , "narrator": "", "text": "その程度で怒んなよ"},
        { "location": "427/SEL"   , "narrator": "", "text": "ごめんなさい"},
        { "location": "428/ACT"   , "narrator": "", "text": "その程度で怒んなよ"},
        { "location": "429/TALK"  , "narrator": "ぴょんこ", "text": "……。"},
        { "location": "436/ACT"   , "narrator": "", "text": "ごめんなさい"},
        { "location": "437/TALK"  , "narrator": "ぴょんこ", "text": "はぁ……\n謝るくらいならやるなよ。\nほんとクズだなー。"},
        { "location": "438/TALK"  , "narrator": "ぴょんこ", "text": "まあいいです。\nそんな貴方でも、\n惚れたのは私なので。"},
        { "location": "439/TALK"  , "narrator": "ぴょんこ", "text": "今回は\nなかなおりしましょう♪"},
        { "location": "443/ACT"   , "narrator": "", "text": "全然構わないよ"},
        { "location": "447/TALK"  , "narrator": "ぴょんこ", "text": "<size=40>全</size>"},
        { "location": "450/TALK"  , "narrator": "ぴょんこ", "text": "<size=60>然</size>"},
        { "location": "453/TALK"  , "narrator": "ぴょんこ", "text": "<size=80>か</size>"},
        { "location": "456/TALK"  , "narrator": "ぴょんこ", "text": "<size=100>ま</size>"},
        { "location": "459/TALK"  , "narrator": "ぴょんこ", "text": "<size=120>わ</size>"},
        { "location": "462/TALK"  , "narrator": "ぴょんこ", "text": "<size=140>な</size>"},
        { "location": "465/TALK"  , "narrator": "ぴょんこ", "text": "<size=160>い</size>"},
        { "location": "470/TALK"  , "narrator": "ぴょんこ", "text": "ハァハァ！！"},
        { "location": "471/SEL"   , "narrator": "", "text": "毎度の事ながらおちつけ！"},
        { "location": "472/ACT"   , "narrator": "", "text": "毎度の事ながらおちつけ！"},
        { "location": "474/TALK"  , "narrator": "ぴょんこ", "text": "ペッタンペッタンペッタン\nペッタンペッタンペッタン\nペッタンペッタンペッタン"},
        { "location": "475/TALK"  , "narrator": "ぴょんこ", "text": "これが落ち着いて\nいられるかってんですか！"},
        { "location": "476/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこは恥ずかしくて、\nでもいつもどおりｽｷって\n言葉を言って欲しくて――"},
        { "location": "477/TALK"  , "narrator": "ぴょんこ", "text": "それで、わざわざつばめ\nさんを退けというのに！"},
        { "location": "478/TALK"  , "narrator": "ぴょんこ", "text": "そんな配慮、\n全然要らなかった件！！"},
        { "location": "480/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんっ！"},
        { "location": "481/TALK"  , "narrator": "ぴょんこ", "text": "……ｽｷ。"},
        { "location": "484/TALK"  , "narrator": "ぴょんこ", "text": "というわけで、\n愛の挨拶も\n済みましたので――"},
        { "location": "489/TALK"  , "narrator": "ぴょんこ", "text": "つばめさーん。\nもう大丈夫ですよ♪"},
        { "location": "493/TALK"  , "narrator": "つばめ", "text": "だいじょうぶ？\nわたし、\n邪魔だったかなぁ。"},
        { "location": "494/TALK"  , "narrator": "ぴょんこ", "text": "そんなこと\nありませんよ？"},
        { "location": "495/TALK"  , "narrator": "ぴょんこ", "text": "空気読んで\n引っ込んでくれましたし。"},
        { "location": "496/TALK"  , "narrator": "つばめ", "text": "えへへ！\nよかった～。"},
        { "location": "497/TALK"  , "narrator": "ぴょんこ", "text": "それに、ここに来てくれた\nことも、むしろ嬉しく\n思ってるくらいですよっ。"},
        { "location": "498/TALK"  , "narrator": "つばめ", "text": "神楽ちゃんが\n大変な時だもん。\n来て当然だよ。"},
        { "location": "499/TALK"  , "narrator": "ぴょんこ", "text": "まあ、現時点の現実の私が\n心の中につばめさんが侵入\nしてきたって知ったら――"},
        { "location": "500/TALK"  , "narrator": "ぴょんこ", "text": "自害するかも\nしれませんけど！"},
        { "location": "501/TALK"  , "narrator": "つばめ", "text": "はぁっ……\nそ、そこまで…？"},
        { "location": "502/TALK"  , "narrator": "ぴょんこ", "text": "そうですよっ。\nつばめさんには、\nマジでビビってますから！"},
        { "location": "503/SEL"   , "narrator": "", "text": "それで、つばめはどうしてここにいるの？"},
        { "location": "504/SEL"   , "narrator": "", "text": "それで、前回のは何とかなったの？"},
        { "location": "505/ACT"   , "narrator": "", "text": "それで、つばめはどうしてここにいるの？"},
        { "location": "508/TALK"  , "narrator": "つばめ", "text": "あっ、\nえっとそれは――"},
        { "location": "509/ACT"   , "narrator": "", "text": "それで、前回のは何とかなったの？"},
        { "location": "512/TALK"  , "narrator": "つばめ", "text": "そう、\nそれなんだけど！"},
        { "location": "514/TALK"  , "narrator": "つばめ", "text": "神楽ちゃんのココロが\nボロボロに脆くなってて―"},
        { "location": "515/TALK"  , "narrator": "つばめ", "text": "今は、少しの衝撃で\nすぐにバラバラに\nなっちゃう状況なんだ。"},
        { "location": "516/SEL"   , "narrator": "", "text": "その辺りは、エリカさんから聞いてるよ"},
        { "location": "517/ACT"   , "narrator": "", "text": "その辺りは、エリカさんから聞いてるよ"},
        { "location": "519/TALK"  , "narrator": "ぴょんこ", "text": "あぁ、\nそりゃそうですよね。"},
        { "location": "520/SEL"   , "narrator": "", "text": "でも、同化すると心って崩壊しちゃうものなの？"},
        { "location": "521/ACT"   , "narrator": "", "text": "でも、同化すると心って崩壊しちゃうものなの？"},
        { "location": "523/TALK"  , "narrator": "ぴょんこ", "text": "そうですよ。\n崩壊と再構築が絶えず\n繰り返されていき――"},
        { "location": "524/TALK"  , "narrator": "ぴょんこ", "text": "フェノメノンの外のことは\n全て忘れて、\n中の住人になるんです。"},
        { "location": "525/TALK"  , "narrator": "ぴょんこ", "text": "つばめさんの世界の\nシナリオに沿って演じる、\n役者になるんですよ。"},
        { "location": "526/TALK"  , "narrator": "つばめ", "text": "ココロの中っていうのは\n今までの経験や記憶から\n世界を構築していて――"},
        { "location": "527/TALK"  , "narrator": "つばめ", "text": "その意志や想いの強さが\nココロの世界の強さに\nなってるんだけど。"},
        { "location": "528/TALK"  , "narrator": "ぴょんこ", "text": "その大元の記憶や人格を\n不自然に失っていけば、\n心の社も脆くなります。"},
        { "location": "529/TALK"  , "narrator": "ぴょんこ", "text": "自分がどうしてそれを\n大切にしているのか、\n解らなくなりますからね。"},
        { "location": "530/TALK"  , "narrator": "ぴょんこ", "text": "でも私は現時点においては\n幸いにもまだ、\n一部の崩壊もありません。"},
        { "location": "531/TALK"  , "narrator": "ぴょんこ", "text": "つばめさんが\n防いでくれましたからね。"},
        { "location": "532/TALK"  , "narrator": "ぴょんこ", "text": "とは言っても、\n少しずつ記憶が混乱して\nいってるのは確かで……。"},
        { "location": "533/TALK"  , "narrator": "ぴょんこ", "text": "現実世界では\nその予兆が\n出始めていませんか？"},
        { "location": "534/SEL"   , "narrator": "", "text": "そういえば、お母さんがおかしくなってることを、本気で忘れてたような…？"},
        { "location": "535/SEL"   , "narrator": "", "text": "そういえば今回、なんか言ってることに違和感あったような…？"},
        { "location": "536/ACT"   , "narrator": "", "text": "そういえば、お母さんがおかしくなってることを、本気で忘れてたような…？"},
        { "location": "537/TALK"  , "narrator": "ぴょんこ", "text": "あー、それは多分\nわかっててはぐらかして\nいると思いますよ？"},
        { "location": "538/TALK"  , "narrator": "ぴょんこ", "text": "この世界に矛盾なく\nとけ込もうとするなら――"},
        { "location": "539/TALK"  , "narrator": "ぴょんこ", "text": "むしろ、生まれたときから\nずっと暴力を振るわれて\nいたって設定にしないと。"},
        { "location": "540/TALK"  , "narrator": "ぴょんこ", "text": "うーん、でも確かに、\n案外関係あるかも\nしれませんね。"},
        { "location": "541/TALK"  , "narrator": "ぴょんこ", "text": "一過性の意識の混乱と\nいうこともあります。"},
        { "location": "542/ACT"   , "narrator": "", "text": "そういえば今回、なんか言ってることに違和感あったような…？"},
        { "location": "543/TALK"  , "narrator": "ぴょんこ", "text": "そういうのって、\n案外当たってたり\nするものなんですよね。"},
        { "location": "544/TALK"  , "narrator": "ぴょんこ", "text": "なので、気のせいでは\nないと思います。"},
        { "location": "546/TALK"  , "narrator": "つばめ", "text": "何にしても、神楽ちゃんの\nココロが壊れやすく\nなってるのは確かで……。"},
        { "location": "547/SEL"   , "narrator": "", "text": "これからもつばめが一緒に支えれば、壊れることはないの？"},
        { "location": "548/ACT"   , "narrator": "", "text": "これからもつばめが一緒に支えれば、壊れることはないの？"},
        { "location": "550/TALK"  , "narrator": "つばめ", "text": "うーん、\nどうなんだろう……。"},
        { "location": "551/TALK"  , "narrator": "つばめ", "text": "前回は何とか\n壊れるのを防いだって\n感じかなぁ。"},
        { "location": "552/TALK"  , "narrator": "つばめ", "text": "わたしがお手伝いできる\nのは、ココロの補強をする\n方じゃないから――"},
        { "location": "553/TALK"  , "narrator": "つばめ", "text": "ココロは脆いまま\nなんだよね。"},
        { "location": "554/TALK"  , "narrator": "つばめ", "text": "でも、今はこれしか\n方法が無くて。"},
        { "location": "555/TALK"  , "narrator": "つばめ", "text": "だからみんなで話して、\n持ち回りで神楽ちゃんの\nココロを護る事にしたの。"},
        { "location": "556/SEL"   , "narrator": "", "text": "持ち回りってどういうこと？"},
        { "location": "557/SEL"   , "narrator": "", "text": "ていうか、君はいつのどのつばめなの？"},
        { "location": "558/ACT"   , "narrator": "", "text": "持ち回りってどういうこと？"},
        { "location": "559/ACT"   , "narrator": "", "text": "ていうか、君はいつのどのつばめなの？"},
        { "location": "564/TALK"  , "narrator": "つばめ", "text": "ああっ、大変！\nそろそろ自分の世界に\n戻らなくちゃ！"},
        { "location": "566/TALK"  , "narrator": "つばめ", "text": "ごめんなさい！\n話の途中だけど、\nあまり長居はできなくて。"},
        { "location": "567/TALK"  , "narrator": "つばめ", "text": "もし気になってるなら、\n入れ替わりでアーヤさんが\n来ると思うから――"},
        { "location": "568/TALK"  , "narrator": "つばめ", "text": "その時に、アーヤさんに\n聞いてもらえれば色々\n答えてくれると思うよ。"},
        { "location": "570/TALK"  , "narrator": "ぴょんこ", "text": "つばめさん！"},
        { "location": "572/TALK"  , "narrator": "つばめ", "text": "ああっ、そうだ！\nあと、ぴょんこちゃん……"},
        { "location": "573/TALK"  , "narrator": "ぴょんこ", "text": "はい！？"},
        { "location": "574/TALK"  , "narrator": "つばめ", "text": "WAVEのアカウント\n交換して欲しいんだけど、\nいいかな…？"},
        { "location": "576/TALK"  , "narrator": "ぴょんこ", "text": "え？\n波垢ですか？\nいいですけど……"},
        { "location": "577/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "578/TALK"  , "narrator": "ぴょんこ", "text": "………。"},
        { "location": "580/TALK"  , "narrator": "つばめ", "text": "ありがとう、\nぴょんこちゃん！"},
        { "location": "581/TALK"  , "narrator": "ぴょんこ", "text": "えっ？\nえっと！！"},
        { "location": "582/TALK"  , "narrator": "つばめ", "text": "それじゃ、またね！"},
        { "location": "591/TALK"  , "narrator": "ぴょんこ", "text": "つばめさん！？"},
        { "location": "592/TALK"  , "narrator": "ぴょんこ", "text": "はぁ……。"},
        { "location": "593/SEL"   , "narrator": "", "text": "大変な事になったね"},
        { "location": "594/ACT"   , "narrator": "", "text": "大変な事になったね"},
        { "location": "596/TALK"  , "narrator": "ぴょんこ", "text": "まあ、仕方ないですよ。"},
        { "location": "597/SEL"   , "narrator": "", "text": "もしココロが崩壊したら、神楽は$me$のことを忘れちゃうのかな"},
        { "location": "598/SEL"   , "narrator": "", "text": "こうなるってわかってたら、接続切替なんてしなかったのに"},
        { "location": "599/ACT"   , "narrator": "", "text": "もしココロが崩壊したら、神楽は$me$のことを忘れちゃうのかな"},
        { "location": "600/TALK"  , "narrator": "ぴょんこ", "text": "そうですね。多分、\n忘れてしまうと思います。"},
        { "location": "601/TALK"  , "narrator": "ぴょんこ", "text": "でも大丈夫ですよ。\nココロがつばめさんの\n世界の側に落ち着けば――"},
        { "location": "602/TALK"  , "narrator": "ぴょんこ", "text": "またそこから、\n新しい私と貴方との\nドラマが始まります♪"},
        { "location": "603/SEL"   , "narrator": "", "text": "そんなの嫌だ"},
        { "location": "604/SEL"   , "narrator": "", "text": "神楽としては、心がまっさらになるのってどうなの？"},
        { "location": "605/ACT"   , "narrator": "", "text": "そんなの嫌だ"},
        { "location": "607/TALK"  , "narrator": "ぴょんこ", "text": "ふふっ。\nそう言ってくれると\n思ってました♪"},
        { "location": "608/ACT"   , "narrator": "", "text": "神楽としては、心がまっさらになるのってどうなの？"},
        { "location": "610/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこもいやです。\nていうかですね――"},
        { "location": "611/TALK"  , "narrator": "ぴょんこ", "text": "立ち位置的に、\nぴょんこは無傷では\n済まないと思います。"},
        { "location": "612/TALK"  , "narrator": "ぴょんこ", "text": "みさみさと\n現実の私との関係も\n変わってしまいますし――"},
        { "location": "613/TALK"  , "narrator": "ぴょんこ", "text": "間違いなくスピネルの\nことは隠蔽されますから。"},
        { "location": "614/TALK"  , "narrator": "ぴょんこ", "text": "そうなれば、\nぴょんこも心の奥底に\n封印されちゃいますね。"},
        { "location": "615/TALK"  , "narrator": "ぴょんこ", "text": "ですから、\nそうならないように！"},
        { "location": "616/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんと\n二人三脚で頑張って\n現状を打破しなくては♪"},
        { "location": "617/ACT"   , "narrator": "", "text": "こうなるってわかってたら、接続切替なんてしなかったのに"},
        { "location": "618/TALK"  , "narrator": "ぴょんこ", "text": "おいコラ。\nそんな事言ってると、\n本気で呪いますよ？"},
        { "location": "620/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんが\n接続しなかったら――"},
        { "location": "621/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこは\n$handle$さんに\n出逢えなかったんですよ？"},
        { "location": "622/TALK"  , "narrator": "ぴょんこ", "text": "わかってるんですか！？"},
        { "location": "623/SEL"   , "narrator": "", "text": "そうだよね。ぴょんこｽｷ"},
        { "location": "624/SEL"   , "narrator": "", "text": "でも…"},
        { "location": "625/ACT"   , "narrator": "", "text": "そうだよね。ぴょんこｽｷ"},
        { "location": "627/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこも\n$handle$さんが\n大好きですよ？"},
        { "location": "629/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこは、\n起こってしまった\nことよりも――"},
        { "location": "630/TALK"  , "narrator": "ぴょんこ", "text": "最初から何も無いままで\n終わってしまうことの方が\n怖いんです。"},
        { "location": "631/TALK"  , "narrator": "ぴょんこ", "text": "起こってしまったことは、\nこれから何とかしていけば\nいいんですよ。"},
        { "location": "632/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんと、\nぴょんこの二人で。"},
        { "location": "633/ACT"   , "narrator": "", "text": "でも…"},
        { "location": "634/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんは\n優しいんですね。"},
        { "location": "635/TALK"  , "narrator": "ぴょんこ", "text": "それでも、\n私のことを想って\n肯定できないんでしょう？"},
        { "location": "637/TALK"  , "narrator": "ぴょんこ", "text": "起こったことは\nこれから何とかしていけば\nいいんですよ。"},
        { "location": "638/TALK"  , "narrator": "ぴょんこ", "text": "でも、起こらなかった\nことは、これからもずっと\n起こらないままなんです。"},
        { "location": "639/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこは、\nこの違いはすごく……\nすごく大事だと思います。"},
        { "location": "642/SEL"   , "narrator": "", "text": "ぴょんこ……"},
        { "location": "643/SEL"   , "narrator": "", "text": "そうだね"},
        { "location": "644/SEL"   , "narrator": "", "text": "前向きだね"},
        { "location": "645/ACT"   , "narrator": "", "text": "ぴょんこ……"},
        { "location": "647/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さん……\nぴょんこは――"},
        { "location": "648/ACT"   , "narrator": "", "text": "そうだね"},
        { "location": "649/TALK"  , "narrator": "ぴょんこ", "text": "そうです♪"},
        { "location": "650/TALK"  , "narrator": "ぴょんこ", "text": "そんなことよりですね！\nぴょんこは今、\n焦ってるんですよ！"},
        { "location": "651/SEL"   , "narrator": "", "text": "何を？"},
        { "location": "652/ACT"   , "narrator": "", "text": "何を？"},
        { "location": "654/TALK"  , "narrator": "ぴょんこ", "text": "わからないんですかっ？"},
        { "location": "655/TALK"  , "narrator": "ぴょんこ", "text": "さっきまでつばめさんが\nいて、次はアーヤさんが\n来るんですよね！"},
        { "location": "657/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんと\nぴょんこのラブラブ空間\nタイムが激減ですよ！！"},
        { "location": "658/TALK"  , "narrator": "ぴょんこ", "text": "ですから、今のこの時間は\n超超超～～～～\n貴重な時間なんですっ！"},
        { "location": "659/TALK"  , "narrator": "ぴょんこ", "text": "さあ！　さあ！\nアーヤさんが来る前に\n一発――"},
        { "location": "660/ACT"   , "narrator": "", "text": "前向きだね"},
        { "location": "661/TALK"  , "narrator": "ぴょんこ", "text": "それが\nぴょんこですからっ！"},
        { "location": "662/TALK"  , "narrator": "ぴょんこ", "text": "ふふっ。"},
        { "location": "664/TALK"  , "narrator": "アーヤ", "text": "ぴょんこ、\n大丈夫！？"},
        { "location": "671/TALK"  , "narrator": "アーヤ", "text": "ぴょんこ、\n大丈夫！？"},
        { "location": "674/TALK"  , "narrator": "ぴょんこ", "text": "キタ―――――――！！！"},
        { "location": "676/TALK"  , "narrator": "ぴょんこ", "text": "見てください！\n$handle$さんっ！！"},
        { "location": "678/TALK"  , "narrator": "ぴょんこ", "text": "この間の悪さ！\nこれでこそ\nアーヤさんですよねっ！"},
        { "location": "679/SEL"   , "narrator": "", "text": "まさにアーヤ！"},
        { "location": "680/SEL"   , "narrator": "", "text": "たまたまじゃない？"},
        { "location": "681/ACT"   , "narrator": "", "text": "まさにアーヤ！"},
        { "location": "682/ACT"   , "narrator": "", "text": "たまたまじゃない？"},
        { "location": "684/TALK"  , "narrator": "アーヤ", "text": "別にこのまま帰っても\nいいんだけど。"},
        { "location": "696/TALK"  , "narrator": "アーヤ", "text": "どう？\nココロの調子は。"},
        { "location": "697/TALK"  , "narrator": "ぴょんこ", "text": "つばめさんがサポート\nしてくれてからは、\nずっと安定してますね。"},
        { "location": "698/TALK"  , "narrator": "アーヤ", "text": "そう、よかった。"},
        { "location": "699/TALK"  , "narrator": "アーヤ", "text": "ところで、\n今回の葛藤は？\nこの扉でOK？"},
        { "location": "700/TALK"  , "narrator": "ぴょんこ", "text": "ああ、あはは……\nそういえばまだ\n回してませんでした。"},
        { "location": "703/TALK"  , "narrator": "アーヤ", "text": "ええっ？\n今まで何やってたの？"},
        { "location": "705/TALK"  , "narrator": "アーヤ", "text": "ココロの葛藤が起きてから\nだいぶ時間経ってると\n思うんだけど……。"},
        { "location": "706/TALK"  , "narrator": "アーヤ", "text": "一刻も早く回して\n場所を特定しなくちゃ\nいつ崩壊が起こるか――"},
        { "location": "707/TALK"  , "narrator": "ぴょんこ", "text": "わかってます\nわかってますから。"},
        { "location": "708/TALK"  , "narrator": "ぴょんこ", "text": "オープンプロセス、\n2x99F番地から\n2xACD番地へ。"},
        { "location": "732/TALK"  , "narrator": "ぴょんこ", "text": "シーク完了。"},
        { "location": "734/TALK"  , "narrator": "ぴょんこ", "text": "はいはいそれで、\n今回の悩みは？"},
        { "location": "738/TALK"  , "narrator": "ぴょんこ", "text": "……。"},
        { "location": "739/TALK"  , "narrator": "ぴょんこ", "text": "あーなるほど。"},
        { "location": "740/TALK"  , "narrator": "ぴょんこ", "text": "いま心の中で起きてる\nイライラが――"},
        { "location": "742/TALK"  , "narrator": "ぴょんこ", "text": "つばめさんによるものでは\nないことを、肯定したく\nないんですね。"},
        { "location": "743/SEL"   , "narrator": "", "text": "どうして？"},
        { "location": "744/ACT"   , "narrator": "", "text": "どうして？"},
        { "location": "746/TALK"  , "narrator": "ぴょんこ", "text": "既に本当の気持ちは\nつばめさんに傾き始めてる\nからですよ♪"},
        { "location": "747/TALK"  , "narrator": "ぴょんこ", "text": "もっと魅力的な\n言葉を使えば、ズバリ！"},
        { "location": "752/TALK"  , "narrator": "ぴょんこ", "text": "<size=40>嫉妬！！</size>"},
        { "location": "754/TALK"  , "narrator": "ぴょんこ", "text": "でも、私はつばめさんを\n壊さなければならない\n宿命を背負う女……！"},
        { "location": "755/TALK"  , "narrator": "ぴょんこ", "text": "そんな気持ちは、\n断じて許され――"},
        { "location": "758/TALK"  , "narrator": "ぴょんこ", "text": "…あれあれ？"},
        { "location": "759/TALK"  , "narrator": "アーヤ", "text": "どうしたの？"},
        { "location": "760/TALK"  , "narrator": "ぴょんこ", "text": "それが、なんかわりと\n簡単に許されそうな\n空気なんですよ。"},
        { "location": "761/SEL"   , "narrator": "", "text": "なんで？"},
        { "location": "762/SEL"   , "narrator": "", "text": "これも同化の影響か…？"},
        { "location": "763/ACT"   , "narrator": "", "text": "なんで？"},
        { "location": "766/TALK"  , "narrator": "ぴょんこ", "text": "同化の影響なんじゃ\nないですかね？"},
        { "location": "767/ACT"   , "narrator": "", "text": "これも同化の影響か…？"},
        { "location": "770/TALK"  , "narrator": "ぴょんこ", "text": "さすが\n$handle$さんっ！"},
        { "location": "771/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこのことなら何でも\nわかっちゃうんですね～♪"},
        { "location": "773/TALK"  , "narrator": "ぴょんこ", "text": "まあ、あくまで\n推測ですけど――"},
        { "location": "774/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこの全身が\n感じている直感、\nそして！！"},
        { "location": "775/TALK"  , "narrator": "ぴょんこ", "text": "今このココロゲートが\n崩壊しかけてすらいない\n状況こそが証拠ですっ！"},
        { "location": "776/SEL"   , "narrator": "", "text": "それくらい弱い葛藤ってことか"},
        { "location": "777/ACT"   , "narrator": "", "text": "それくらい弱い葛藤ってことか"},
        { "location": "781/TALK"  , "narrator": "ぴょんこ", "text": "ですですっ♪\nですから今回は\nチョロすぎて――"},
        { "location": "785/TALK"  , "narrator": "ぴょんこ", "text": "あっ……\nえっと………"},
        { "location": "786/TALK"  , "narrator": "ぴょんこ", "text": "アーヤさんにせっかく\n来ていただいたのに\n申し訳ないのですが――"},
        { "location": "788/TALK"  , "narrator": "ぴょんこ", "text": "今回、ぴょんこだけでも\n何とかなりそうです……\n…　　…よねっ？"},
        { "location": "789/TALK"  , "narrator": "アーヤ", "text": "そ……そうね。\nそうかもしれない…わね。"},
        { "location": "790/TALK"  , "narrator": "ぴょんこ", "text": "あ、はい……"},
        { "location": "791/TALK"  , "narrator": "ぴょんこ", "text": "うわ……気まずっ。\n最強に間が悪すぎだし！"},
        { "location": "793/TALK"  , "narrator": "ぴょんこ", "text": "えっと、\nあっ、でも……"},
        { "location": "794/TALK"  , "narrator": "ぴょんこ", "text": "せっかくですし、\n一戦、やっていきます？"},
        { "location": "795/TALK"  , "narrator": "アーヤ", "text": "そ、そうよね！！\nせっかく来たんだし！"},
        { "location": "796/TALK"  , "narrator": "ぴょんこ", "text": "そうですよっ♪\nせっかく来たんですから！"},
        { "location": "797/SEL"   , "narrator": "", "text": "なにこの空気…"},
        { "location": "798/ACT"   , "narrator": "", "text": "なにこの空気…"},
        { "location": "801/TALK"  , "narrator": "ぴょんこ", "text": "察して！\nお願いだから察して！"},
        { "location": "803/TALK"  , "narrator": "ぴょんこ", "text": "それじゃ、アーヤさん\n早速行きましょう♪"},
        { "location": "804/TALK"  , "narrator": "アーヤ", "text": "ええ、行きましょ！\nもちろん、どんな状況でも\n全力でいくわよ！"},
        { "location": "805/TALK"  , "narrator": "ぴょんこ", "text": "そうですよっ！\nその意気ですっ！！"},
        { "location": "807/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんことアーヤさんと\n$handle$さんに、\n素敵なココロの旅をっ。"},
        { "location": "20/DIALOG" , "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:Interrupt】</color>\nSystem Interrupted.\n\n必須選択肢が選ばれていません。\n\n<color=green>『STORY27：シン・カグラ』</color>\nにて、選択を行ってから\n再度アクセスしてください。\n"},
        { "location": "24/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>5月26日　11:10 AM</color>\nとある平日の午前中、豊洲にある神楽の自室にて。"},
        { "location": "244/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "246/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "248/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "250/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "252/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "434/DIALOG", "narrator": "NOTICE", "text": "<color=red>【TRI-OS Error:0x99】</color>\nココロスフィアとの回線が\n切断されました。(981)"}
    ]
}
