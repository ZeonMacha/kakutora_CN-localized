{
    "dir": "chap01/battle/btev_ch01_01_02.js",
    "type": "",
    "info": {
        "story_id": "21003",
        "cid": "",
        "title": "003 ココロスフィアストーリー【Lv01】",
        "sub_title": "最大幸福論＜帰結＞"
    },
    "entry":
    [
        { "location": "302/SCENARIO", "narrator": "", "text": "バトル終了"},
        { "location": "315/TALK"    , "narrator": "つばめ", "text": "ありがとう……。"},
        { "location": "316/TALK"    , "narrator": "つばめ", "text": "まだ理由も言ってないのに\n一緒に戦ってくれて、\nちょっと嬉しかったよ。"},
        { "location": "317/SEL"     , "narrator": "（選択肢）", "text": "つばめの為だから"},
        { "location": "318/SEL"     , "narrator": "（選択肢）", "text": "なし崩し的にね"},
        { "location": "319/ACT"     , "narrator": "", "text": "つばめの為だから"},
        { "location": "320/TALK"    , "narrator": "つばめ", "text": "ふあっ……"},
        { "location": "322/TALK"    , "narrator": "つばめ", "text": "なんかちょっと\n恥ずかしいかも…。"},
        { "location": "323/ACT"     , "narrator": "", "text": "なし崩し的にね"},
        { "location": "324/TALK"    , "narrator": "つばめ", "text": "えへへ、\n確かにそうだよね。"},
        { "location": "325/TALK"    , "narrator": "つばめ", "text": "ごめんね、\n巻き込んじゃって。"},
        { "location": "327/TALK"    , "narrator": "つばめ", "text": "改めて、\nちゃんと教えるね。"},
        { "location": "328/TALK"    , "narrator": "つばめ", "text": "わたしがトライナリーに\n志願した本当の理由。"},
        { "location": "329/TALK"    , "narrator": "つばめ", "text": "とても大切な、\n本当の理由のことを――"},
        { "location": "346/DIALOG"  , "narrator": "", "text": "数年前。\n静岡・某病院。"},
        { "location": "348/TALK"    , "narrator": "つばめ", "text": "……。"},
        { "location": "351/TALK"    , "narrator": "啓介", "text": "どうだ、調子は。"},
        { "location": "354/TALK"    , "narrator": "啓介", "text": "検査の結果――"},
        { "location": "355/TALK"    , "narrator": "つばめ", "text": "もういいよ、\n一人にして。"},
        { "location": "356/TALK"    , "narrator": "つばめ", "text": "どうせわたし、\nもうすぐに\n死んじゃうんでしょ？"},
        { "location": "357/TALK"    , "narrator": "啓介", "text": "バカなことを言うな。"},
        { "location": "358/DIALOG"  , "narrator": "", "text": "わたしは、\n重い病気にかかって\n生きる気力を無くしていた。"},
        { "location": "359/TALK"    , "narrator": "啓介", "text": "そうだ。\nこれ、母さんがな、\nつばめに。"},
        { "location": "360/DIALOG"  , "narrator": "", "text": "その時、\n父から手渡されたのは、\n一枚のCD。"},
        { "location": "361/TALK"    , "narrator": "啓介", "text": "きっとお前が\n好きだろうって、\n聴けば元気になるって、"},
        { "location": "362/DIALOG"  , "narrator": "", "text": "それは、\n母からのプレゼント。"},
        { "location": "363/TALK"    , "narrator": "つばめ", "text": "要らないってば！\n聴かないよそんなの！"},
        { "location": "364/TALK"    , "narrator": "啓介", "text": "……そうか。"},
        { "location": "365/TALK"    , "narrator": "啓介", "text": "とにかく、もう\n部屋に戻って休め。"},
        { "location": "366/DIALOG"  , "narrator": "", "text": "これが、\nわたしとメノウちゃん、\nFreyMENOWという\nアーティストとの\n出逢いだった。"},
        { "location": "380/TALK"    , "narrator": "つばめ", "text": "……。"},
        { "location": "382/DIALOG"  , "narrator": "", "text": "母の予想は的中し、\nわたしはすぐに\nFreyMENOWが\n大好きになってしまった。"},
        { "location": "399/TALK"    , "narrator": "つばめ", "text": "難病で生きる気力を\n失ってたわたしは――"},
        { "location": "400/TALK"    , "narrator": "つばめ", "text": "お母さんからの\nこのプレゼントで\n劇的に持ち直したんだ。"},
        { "location": "402/TALK"    , "narrator": "つばめ", "text": "メノウちゃんって、\nわたしと同い年\nなんだって。"},
        { "location": "403/TALK"    , "narrator": "つばめ", "text": "それを知ったとき、\n私も頑張らなくちゃ…\nって、思ったんだよ。"},
        { "location": "404/TALK"    , "narrator": "つばめ", "text": "だからわたしにとって、\nお母さんとメノウちゃんは\n特別な存在なんだよ。"},
        { "location": "405/TALK"    , "narrator": "つばめ", "text": "そして、トライナリーに\n志願した本当の理由、\nそれはお母さんの為。"},
        { "location": "425/TALK"    , "narrator": "つばめ", "text": "お母さんどうだった？"},
        { "location": "427/TALK"    , "narrator": "啓介", "text": "……。"},
        { "location": "428/TALK"    , "narrator": "啓介", "text": "…だいぶ\n痛むようでな。"},
        { "location": "429/TALK"    , "narrator": "つばめ", "text": "え……"},
        { "location": "431/TALK"    , "narrator": "啓介", "text": "いつもの発作だ。\n俺が付き添うから、\n何の心配もない。"},
        { "location": "435/DIALOG"  , "narrator": "", "text": "母は、\nわたしと同じ病気を\n患っていた。\n\nでも…\n\n病気を治せるっていうお話が来たとき\nそのチャンスとお金を\n全部わたしのために\n使ってくれたんだ。"},
        { "location": "436/DIALOG"  , "narrator": "", "text": "だから――"},
        { "location": "449/TALK"    , "narrator": "真幌", "text": "そして、もし受けると\nいうのであれば、\nそれ相応の報酬が出る。"},
        { "location": "450/TALK"    , "narrator": "つばめ", "text": "それって、お金ですか？"},
        { "location": "451/TALK"    , "narrator": "真幌", "text": "金に限った話ではない。\n物でも、してほしいこと\nでも――"},
        { "location": "452/TALK"    , "narrator": "真幌", "text": "それなりのワガママは\n聞いてもらえるという\nことだ。"},
        { "location": "456/DIALOG"  , "narrator": "", "text": "この時わたしの中で\nトライナリーに志願しようって、\n心が決まった。\n\n『メノウちゃんを助けたい』という\n想いと一緒にあった、もう１つの想い、\n『母への想い』によって。"},
        { "location": "466/TALK"    , "narrator": "つばめ", "text": "だからわたしが今\n東京にいるのはお母さんの\n為でもあるんだ。"},
        { "location": "467/SEL"     , "narrator": "（選択肢）", "text": "何をお願いしたの？"},
        { "location": "468/ACT"     , "narrator": "", "text": "何をお願いしたの？"},
        { "location": "470/TALK"    , "narrator": "つばめ", "text": "んっと、それは……"},
        { "location": "471/TALK"    , "narrator": "つばめ", "text": "……。"},
        { "location": "472/TALK"    , "narrator": "つばめ", "text": "まだ秘密だよ。"},
        { "location": "473/SEL"     , "narrator": "（選択肢）", "text": "えー"},
        { "location": "474/SEL"     , "narrator": "（選択肢）", "text": "秘密にするようなこと？"},
        { "location": "475/ACT"     , "narrator": "", "text": "えー"},
        { "location": "476/TALK"    , "narrator": "つばめ", "text": "もうちょっと、\nちゃんと心の整理が\nついたらお話するから！"},
        { "location": "477/ACT"     , "narrator": "", "text": "秘密にするようなこと？"},
        { "location": "478/TALK"    , "narrator": "つばめ", "text": "んっと、そういうわけでも\nないんだけど……"},
        { "location": "480/TALK"    , "narrator": "つばめ", "text": "実はまだ、この事について\n自分の中ではちゃんとした\n自信がないんだ。"},
        { "location": "481/TALK"    , "narrator": "つばめ", "text": "もちろん今は、\n$handle$さんの\nお陰でココロは安定した。"},
        { "location": "482/TALK"    , "narrator": "つばめ", "text": "けどそれは、自分の想いの\n強さを再認識できたって\nいうだけで……"},
        { "location": "483/TALK"    , "narrator": "つばめ", "text": "その方法が正しいか\nどうかについては、\nまだ考え切れてないんだ。"},
        { "location": "484/TALK"    , "narrator": "つばめ", "text": "そしてそれは、多分この\n階層、レベル０１では\n解決できない問題なの。"},
        { "location": "485/TALK"    , "narrator": "つばめ", "text": "だから、もしよければ……\nその――"},
        { "location": "486/TALK"    , "narrator": "つばめ", "text": "$handle$さんには、\nわたしのもっと深い所まで\n来てもらえたら…って。"},
        { "location": "488/TALK"    , "narrator": "つばめ", "text": "な、なんか\n変なこと言っちゃって\nごめんね！"},
        { "location": "489/TALK"    , "narrator": "つばめ", "text": "でも、こんなお話\n打ち明けられる人なんて\n他にいなくて……。"},
        { "location": "490/SEL"     , "narrator": "（選択肢）", "text": "もちろん行くよ！"},
        { "location": "491/SEL"     , "narrator": "（選択肢）", "text": "気が向いたらね"},
        { "location": "492/ACT"     , "narrator": "", "text": "もちろん行くよ！"},
        { "location": "493/TALK"    , "narrator": "つばめ", "text": "ありがとう！\nすごく嬉しいよ！！"},
        { "location": "494/TALK"    , "narrator": "つばめ", "text": "$handle$さんと、\nもっともっと深い仲に\nなれたら嬉しいです。"},
        { "location": "495/ACT"     , "narrator": "", "text": "気が向いたらね"},
        { "location": "496/TALK"    , "narrator": "つばめ", "text": "うん、もちろん\nそれでいいよ。"},
        { "location": "498/TALK"    , "narrator": "つばめ", "text": "今回は本当にありがとう。"},
        { "location": "499/TALK"    , "narrator": "つばめ", "text": "これでわたし、もう突然\n「静岡に帰る」なんて\n言ったりはしないと思う。"},
        { "location": "500/TALK"    , "narrator": "つばめ", "text": "でも、またそっちの勢力が\n強くなってきちゃったら、\n助けにきて欲しいかな。"},
        { "location": "501/TALK"    , "narrator": "つばめ", "text": "……えへへ。"},
        { "location": "525/TALK"    , "narrator": "千羽鶴", "text": "おめでとう。"},
        { "location": "526/TALK"    , "narrator": "千羽鶴", "text": "あなたは彼女の\nココロの迷いを解消し、\n一歩前進させた。"},
        { "location": "527/SEL"     , "narrator": "（選択肢）", "text": "えっへん"},
        { "location": "528/SEL"     , "narrator": "（選択肢）", "text": "あまり実感ない"},
        { "location": "529/SEL"     , "narrator": "（選択肢）", "text": "本当にこれで良かったのだろうか"},
        { "location": "530/ACT"     , "narrator": "", "text": "えっへん"},
        { "location": "531/TALK"    , "narrator": "千羽鶴", "text": "そうね。\n今回ばかりは\n誇っていいと思う。"},
        { "location": "532/ACT"     , "narrator": "", "text": "あまり実感ない"},
        { "location": "533/TALK"    , "narrator": "千羽鶴", "text": "そうね。\nそう思うかも知れない。\nでも――"},
        { "location": "534/ACT"     , "narrator": "", "text": "本当にこれで良かったのだろうか"},
        { "location": "536/TALK"    , "narrator": "千羽鶴", "text": "選択に絶対的な\n正解なんて最初から\n存在しない。"},
        { "location": "538/TALK"    , "narrator": "千羽鶴", "text": "汚い言い方をすれば、\n利己的な選択をし、\n結果が伴えば正解。"},
        { "location": "539/TALK"    , "narrator": "千羽鶴", "text": "それは申し訳無いけど\n今はあなたも知らない\n私の思惑も含めて。"},
        { "location": "540/TALK"    , "narrator": "千羽鶴", "text": "一般的にも、ダメな\n選択をしたと思ったら\n物事が好転したり――"},
        { "location": "541/TALK"    , "narrator": "千羽鶴", "text": "逆に順当な選択をした\nつもりが、後悔する\n結果になったりもする。"},
        { "location": "542/TALK"    , "narrator": "千羽鶴", "text": "大事なのは\n「自分はどうしたいか」"},
        { "location": "543/TALK"    , "narrator": "千羽鶴", "text": "周囲のノイズを遮断し\n自分で決めること。"},
        { "location": "544/TALK"    , "narrator": "千羽鶴", "text": "私があなたにお願い\nしたいのは、あくまで\nそのサポートなの。"},
        { "location": "546/TALK"    , "narrator": "千羽鶴", "text": "人のココロを動かす\nには、いつも大きな\n力が必要とは限らない。"},
        { "location": "547/TALK"    , "narrator": "千羽鶴", "text": "些細なきっかけを\n与えるだけで、整理が\nつくこともある。"},
        { "location": "548/TALK"    , "narrator": "千羽鶴", "text": "そうやって、逃げずに\n決めて、それを実行\nすることは――"},
        { "location": "549/TALK"    , "narrator": "千羽鶴", "text": "次第にココロを\n強くすることに繋がる。"},
        { "location": "550/SEL"     , "narrator": "（選択肢）", "text": "よくわからない"},
        { "location": "551/ACT"     , "narrator": "", "text": "よくわからない"},
        { "location": "553/TALK"    , "narrator": "千羽鶴", "text": "一気に理解は\n出来ないと思う。"},
        { "location": "554/TALK"    , "narrator": "千羽鶴", "text": "とにかくあなたには、\nこれからもずっと、\n今回の様に――"},
        { "location": "555/TALK"    , "narrator": "千羽鶴", "text": "彼女のココロの成長を\n支援してあげて欲しい。"}
    ]
}
