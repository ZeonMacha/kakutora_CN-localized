    [
        { "location": "89/SCENARIO", "narrator": "", "text": "032_ダンスホールへようこそ"},
        { "location": "116/TALK"   , "narrator": "ガブリエラ", "text": "ダンスのお相手を"},
        { "location": "117/TALK"   , "narrator": "ガブリエラ", "text": "お願いしてもいいかしら？"},
        { "location": "119/SEL"    , "narrator": "", "text": "ヒップホップだyo!"},
        { "location": "120/SEL"    , "narrator": "", "text": "盆踊りならなんとか"},
        { "location": "121/SEL"    , "narrator": "", "text": "お姫様、お手をどうぞ"},
        { "location": "122/ACT"    , "narrator": "", "text": "ヒップホップだyo!"},
        { "location": "123/TALK"   , "narrator": "ガブリエラ", "text": "えと"},
        { "location": "125/TALK"   , "narrator": "ガブリエラ", "text": "そういうものなのかしら？"},
        { "location": "126/ACT"    , "narrator": "", "text": "盆踊りならなんとか"},
        { "location": "127/TALK"   , "narrator": "ガブリエラ", "text": "そういうのじゃないわ"},
        { "location": "128/ACT"    , "narrator": "", "text": "お姫様、お手をどうぞ"},
        { "location": "130/TALK"   , "narrator": "ガブリエラ", "text": "お願いするわねｖｖｖｖｖ"},
        { "location": "132/TALK"   , "narrator": "ガブリエラ", "text": "私がお相手をお願いしたいのはワルツよ"},
        { "location": "134/SEL"    , "narrator": "", "text": "ブンチャッチャかー"},
        { "location": "135/SEL"    , "narrator": "", "text": "ワルツは上手く踊れない"},
        { "location": "136/SEL"    , "narrator": "", "text": "デビュタントまでにマスターしないとね"},
        { "location": "137/ACT"    , "narrator": "", "text": "ブンチャッチャかー"},
        { "location": "138/TALK"   , "narrator": "ガブリエラ", "text": "ブンチャッチャ！？"},
        { "location": "140/TALK"   , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "141/TALK"   , "narrator": "ガブリエラ", "text": "確かに"},
        { "location": "142/TALK"   , "narrator": "ガブリエラ", "text": "ブンチャッチャだわ。。。"},
        { "location": "143/ACT"    , "narrator": "", "text": "ワルツは上手く踊れない"},
        { "location": "144/TALK"   , "narrator": "ガブリエラ", "text": "それは残念だわ"},
        { "location": "145/ACT"    , "narrator": "", "text": "デビュタントまでにマスターしないとね"},
        { "location": "147/TALK"   , "narrator": "ガブリエラ", "text": "ええ"},
        { "location": "148/TALK"   , "narrator": "ガブリエラ", "text": "そうよねｖｖｖｖ"},
        { "location": "149/TALK"   , "narrator": "ガブリエラ", "text": "ちゃんと踊れるようになっておかないと"},
        { "location": "151/TALK"   , "narrator": "ガブリエラ", "text": "デビューできないわ////////////"},
        { "location": "153/TALK"   , "narrator": "ガブリエラ", "text": "でも日本じゃ"},
        { "location": "154/TALK"   , "narrator": "ガブリエラ", "text": "競技以外でワルツを踊ることは"},
        { "location": "155/TALK"   , "narrator": "ガブリエラ", "text": "ないみたいよね"},
        { "location": "156/TALK"   , "narrator": "ガブリエラ", "text": "ちょっと残念だわ"}
    ]
}
