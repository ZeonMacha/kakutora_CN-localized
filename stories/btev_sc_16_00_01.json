{
    "dir": "chap00/battle/btev_sc_16_00_01.js",
    "type": "",
    "info": {
        "story_id": "166",
        "cid": "",
        "title": "【EXストーリー】薔薇の魔術師",
        "sub_title": "コネクトストーリー"
    },
    "entry":
    [
        { "location": "706/SCENARIO", "narrator": "", "text": "【導入】ラピスラズリ（ラピスちゃん）"},
        { "location": "712/DIALOG"  , "narrator": "", "text": "<size=40>CURAN STORY. 01</size>\nKAGURA UZUKI\n\n<size=45>ラピスラズリ</size>\n<size=35>～セカイにはアイが必要でしょ？～</size>"},
        { "location": "728/TALK"    , "narrator": "神楽", "text": "お帰りなさい、\n$handle$さま。"},
        { "location": "729/TALK"    , "narrator": "神楽", "text": "ここは、私たち\nトライナリーと、\nクランたちとの交差点。"},
        { "location": "730/TALK"    , "narrator": "神楽", "text": "ココロとココロが\n出逢い、共鳴し、\nそして繋がりあう場所。"},
        { "location": "738/SEL"     , "narrator": "（選択肢）", "text": "概要説明を飛ばす"},
        { "location": "739/SEL"     , "narrator": "（選択肢）", "text": "もう一度聞く"},
        { "location": "740/ACT"     , "narrator": "", "text": "概要説明を飛ばす"},
        { "location": "741/TALK"    , "narrator": "神楽", "text": "というわけで、\n早速今回のクランを\n紹介しますね。"},
        { "location": "743/ACT"     , "narrator": "", "text": "もう一度聞く"},
        { "location": "748/TALK"    , "narrator": "神楽", "text": "ここでは、普段私たちを\n助けてくれるサーバント\nクランを紹介いたします。"},
        { "location": "749/TALK"    , "narrator": "神楽", "text": "そして、貴方が直接\n彼女たちと繋がれるよう、\n手続きをいたします。"},
        { "location": "750/SEL"     , "narrator": "（選択肢）", "text": "ちょっと待って"},
        { "location": "751/ACT"     , "narrator": "", "text": "ちょっと待って"},
        { "location": "753/TALK"    , "narrator": "神楽", "text": "どうか\nなさいましたか。"},
        { "location": "754/SEL"     , "narrator": "（選択肢）", "text": "お帰りなさいって？"},
        { "location": "755/SEL"     , "narrator": "（選択肢）", "text": "来たことないんだけど、ここ"},
        { "location": "756/SEL"     , "narrator": "（選択肢）", "text": "どういう設定なの？"},
        { "location": "757/ACT"     , "narrator": "", "text": "お帰りなさいって？"},
        { "location": "758/TALK"    , "narrator": "神楽", "text": "挨拶ですが、\nどうかなさいましたか？"},
        { "location": "759/ACT"     , "narrator": "", "text": "来たことないんだけど、ここ"},
        { "location": "760/TALK"    , "narrator": "神楽", "text": "まさか\n憶えてらっしゃらない？"},
        { "location": "761/ACT"     , "narrator": "", "text": "どういう設定なの？"},
        { "location": "762/TALK"    , "narrator": "神楽", "text": "設定とは\n不思議なことを\nおっしゃいますね。"},
        { "location": "764/TALK"    , "narrator": "神楽", "text": "ここで私が\n$handle$さまに\n伝えたいことは。"},
        { "location": "765/TALK"    , "narrator": "神楽", "text": "クランとの【儀式】\nによって、貴方とココロを\n繋げられるということ。"},
        { "location": "766/TALK"    , "narrator": "神楽", "text": "ここまでは\nご理解いただけ\nましたか？"},
        { "location": "767/SEL"     , "narrator": "（選択肢）", "text": "それはわかったけど"},
        { "location": "768/SEL"     , "narrator": "（選択肢）", "text": "いや、そうじゃなくて"},
        { "location": "769/SEL"     , "narrator": "（選択肢）", "text": "もういいやそれで"},
        { "location": "770/ACT"     , "narrator": "", "text": "それはわかったけど"},
        { "location": "771/TALK"    , "narrator": "神楽", "text": "ならば何も\n問題はございませんね。"},
        { "location": "772/ACT"     , "narrator": "", "text": "いや、そうじゃなくて"},
        { "location": "773/TALK"    , "narrator": "神楽", "text": "何が違うのか\nわかりかねます。"},
        { "location": "774/ACT"     , "narrator": "", "text": "もういいやそれで"},
        { "location": "775/TALK"    , "narrator": "神楽", "text": "ご理解いただき\n感謝いたします。"},
        { "location": "778/TALK"    , "narrator": "神楽", "text": "ではお話を\n続けるとしましょう。"},
        { "location": "779/TALK"    , "narrator": "神楽", "text": "【儀式】には『コネクト』\nと『シンクロ』の２つが\nございます。"},
        { "location": "780/TALK"    , "narrator": "神楽", "text": "『コネクト』は、貴方と\nクランが物理的に繋がる\nための儀式となります。"},
        { "location": "781/TALK"    , "narrator": "神楽", "text": "バトルをして彼女と貴方の\n中にある抵抗勢力を\n無力できれば完了です。"},
        { "location": "782/TALK"    , "narrator": "神楽", "text": "次の『シンクロ』では、\nクランの過去を知り、\n共感していただきます。"},
        { "location": "783/TALK"    , "narrator": "神楽", "text": "クランの過去の\n物語をシェアすることで\n心を通わせるものです。"},
        { "location": "785/TALK"    , "narrator": "神楽", "text": "ここまで、\nご理解いただけ\nましたでしょうか？"},
        { "location": "786/TALK"    , "narrator": "神楽", "text": "もし、入るセクターを\n間違えたという場合\n退場も可能ですが。"},
        { "location": "787/SEL"     , "narrator": "（選択肢）", "text": "大丈夫、次に行って"},
        { "location": "788/SEL"     , "narrator": "（選択肢）", "text": "あ、退場する"},
        { "location": "789/SEL"     , "narrator": "（選択肢）", "text": "えーと、メイドなの？"},
        { "location": "790/ACT"     , "narrator": "", "text": "大丈夫、次に行って"},
        { "location": "791/TALK"    , "narrator": "神楽", "text": "承知いたしました。\nそれでは早速、今回の\nクランを紹介いたします。"},
        { "location": "792/ACT"     , "narrator": "", "text": "あ、退場する"},
        { "location": "793/TALK"    , "narrator": "神楽", "text": "残念ですがここで\nお別れですね。"},
        { "location": "795/TALK"    , "narrator": "神楽", "text": "お戻りになる日を\n心待ちに\nしております。"},
        { "location": "796/TALK"    , "narrator": "神楽", "text": "$handle$さまと\n私に、\n素敵なココロの旅を。"},
        { "location": "798/ACT"     , "narrator": "", "text": "えーと、メイドなの？"},
        { "location": "799/TALK"    , "narrator": "神楽", "text": "え？"},
        { "location": "801/TALK"    , "narrator": "神楽", "text": "改めて聞かれると\n困ってしまいますね。"},
        { "location": "802/TALK"    , "narrator": "神楽", "text": "お好きに解釈\nしていただいて\n構いません。"},
        { "location": "803/TALK"    , "narrator": "神楽", "text": "それでは今回の\nクランを紹介\nいたしますね。"},
        { "location": "812/TALK"    , "narrator": "神楽", "text": "オープンプロセス、\n0x486番地から\n0xFFF番地へ。"},
        { "location": "813/TALK"    , "narrator": "神楽", "text": "共通意識野を経由、\n外部スフィアへ接続。"},
        { "location": "814/TALK"    , "narrator": "神楽", "text": "EXEC_SEEK_SECTOR\n=>Link() EXT_SPHERE/."},
        { "location": "839/TALK"    , "narrator": "神楽", "text": "シーク完了\nいたしました。"},
        { "location": "840/TALK"    , "narrator": "神楽", "text": "さて――。"},
        { "location": "842/TALK"    , "narrator": "神楽", "text": "今回、貴方に\n紹介するクランは\n<color=red>【ラピスラズリ】</color>。"},
        { "location": "844/TALK"    , "narrator": "神楽", "text": "発症者は\n亜城クラウスナー聡美\n１８歳、帰国子女。"},
        { "location": "845/TALK"    , "narrator": "神楽", "text": "ココロファイルナンバー\nE05-016-22によれば、\n今回の発症の原因は……"},
        { "location": "846/TALK"    , "narrator": "神楽", "text": "趣味が警察および\n親に発覚したこと。"},
        { "location": "847/TALK"    , "narrator": "神楽", "text": "これだけだと意味不明\nですよね。"},
        { "location": "850/TALK"    , "narrator": "神楽", "text": "個人的にはプライベートを\nどうこう言う\n趣味はありませんが。"},
        { "location": "851/TALK"    , "narrator": "神楽", "text": "世間の目を考えると\n発症するのは\n必然かと。"},
        { "location": "852/SEL"     , "narrator": "（選択肢）", "text": "$me$は気にしないけど"},
        { "location": "853/SEL"     , "narrator": "（選択肢）", "text": "何で神楽が仕切ってるの？"},
        { "location": "854/ACT"     , "narrator": "", "text": "$me$は気にしないけど"},
        { "location": "855/TALK"    , "narrator": "神楽", "text": "$handle$さまの\nような方ばかりなら\n平和なのですけどね。"},
        { "location": "856/ACT"     , "narrator": "", "text": "何で神楽が仕切ってるの？"},
        { "location": "857/TALK"    , "narrator": "神楽", "text": "通じるものが\nあったからと\n言っておきます。"},
        { "location": "858/TALK"    , "narrator": "神楽", "text": "甘美な喜びは\n創作活動の\n糧になりますから。"},
        { "location": "859/SEL"     , "narrator": "（選択肢）", "text": "ま、まさか……"},
        { "location": "860/ACT"     , "narrator": "", "text": "ま、まさか……"},
        { "location": "862/TALK"    , "narrator": "神楽", "text": "どうか\nなさいましたか？"},
        { "location": "863/SEL"     , "narrator": "（選択肢）", "text": "…いやなんでもない"},
        { "location": "864/SEL"     , "narrator": "（選択肢）", "text": "聞いちゃダメな気がする"},
        { "location": "865/SEL"     , "narrator": "（選択肢）", "text": "詳しく聞きたいけど"},
        { "location": "866/ACT"     , "narrator": "", "text": "…いやなんでもない"},
        { "location": "867/TALK"    , "narrator": "神楽", "text": "ならよいのですけれど。"},
        { "location": "868/ACT"     , "narrator": "", "text": "聞いちゃダメな気がする"},
        { "location": "869/TALK"    , "narrator": "神楽", "text": "何でも聞いてくれて\nいいんですよ。"},
        { "location": "870/ACT"     , "narrator": "", "text": "詳しく聞きたいけど"},
        { "location": "871/TALK"    , "narrator": "神楽", "text": "では別の機会に\nじっくりと。"},
        { "location": "874/TALK"    , "narrator": "神楽", "text": "このセクタでは、クランと\n一番相性がいい\nトライナリーが参ります。"},
        { "location": "875/TALK"    , "narrator": "神楽", "text": "つまり他のクランは\n他のメンバーが\n語るということですね。"},
        { "location": "876/TALK"    , "narrator": "神楽", "text": "それでは精神共有と\n参りましょうか。"},
        { "location": "877/SEL"     , "narrator": "（選択肢）", "text": "どうやるの？"},
        { "location": "878/ACT"     , "narrator": "", "text": "どうやるの？"},
        { "location": "880/TALK"    , "narrator": "神楽", "text": "おさらいしましょうか。\nまずは『コネクト』の\nプロセスを行います。"},
        { "location": "881/TALK"    , "narrator": "神楽", "text": "具体的には、\n彼女の抵抗する意志と\n戦うのです。"},
        { "location": "882/TALK"    , "narrator": "神楽", "text": "それが終われば、\n彼女は貴方に色々\n教えてくれるでしょう。"},
        { "location": "883/TALK"    , "narrator": "神楽", "text": "$handle$さまが\nそれを共有すれば、\n『シンクロ』完了です。"},
        { "location": "884/TALK"    , "narrator": "神楽", "text": "『コネクト』『シンクロ』\n両方完了することで、\n貴方と彼女は繋がれます。"},
        { "location": "885/SEL"     , "narrator": "（選択肢）", "text": "それでおしまい？"},
        { "location": "886/ACT"     , "narrator": "", "text": "それでおしまい？"},
        { "location": "888/TALK"    , "narrator": "神楽", "text": "ここからが\n始まりですよ！"},
        { "location": "889/TALK"    , "narrator": "神楽", "text": "$handle$さまは\nラピスちゃんを使える\nようになるんです！"},
        { "location": "890/TALK"    , "narrator": "神楽", "text": "ですから、『シンクロ』\nまで完了できるように\n頑張ってください！"},
        { "location": "891/TALK"    , "narrator": "神楽", "text": "あ。"},
        { "location": "892/TALK"    , "narrator": "神楽", "text": "$handle$さまには\n頑張っていただきたく\n思っております。"},
        { "location": "893/TALK"    , "narrator": "神楽", "text": "それでは。\nラピスちゃんの世界に\nアクセスいたします。"},
        { "location": "895/TALK"    , "narrator": "神楽", "text": "$handle$さまと\n私とラピスちゃんに、\n素敵なココロの旅を！"}
    ]
}
