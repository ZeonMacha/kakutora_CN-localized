{
    "dir": "chap34/daydra/dd_ch02_34_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "34205",
        "cid": "ayami",
        "title": "005 メインストーリー",
        "sub_title": "それは砂の器＜後編＞"
    },
    "entry":
    [
        { "location": "615/SCENARIO", "narrator": "", "text": "それでも未来を"},
        { "location": "631/TALK"    , "narrator": "アーヤ", "text": "…痛っ…。"},
        { "location": "632/TALK"    , "narrator": "アーヤ", "text": "頭が痛いし\n何だか震えが\n止まらないわ…。"},
        { "location": "634/TALK"    , "narrator": "アーヤ", "text": "落ち着かなきゃ\nいけないのに…。"},
        { "location": "638/SEL"     , "narrator": "", "text": "元気？"},
        { "location": "639/ACT"     , "narrator": "", "text": "元気？"},
        { "location": "658/TALK"    , "narrator": "アーヤ", "text": "げんｋじゃないけど"},
        { "location": "659/TALK"    , "narrator": "アーヤ", "text": "どこに行ってたの"},
        { "location": "661/SEL"     , "narrator": "", "text": "ごめんごめん"},
        { "location": "662/SEL"     , "narrator": "", "text": "ちょっとしたバグ"},
        { "location": "663/SEL"     , "narrator": "", "text": "一応解決したから"},
        { "location": "664/ACT"     , "narrator": "", "text": "ごめんごめん"},
        { "location": "665/TALK"    , "narrator": "アーヤ", "text": "軽すぎる"},
        { "location": "666/ACT"     , "narrator": "", "text": "ちょっとしたバグ"},
        { "location": "667/TALK"    , "narrator": "アーヤ", "text": "ちょっとじゃないわ"},
        { "location": "668/ACT"     , "narrator": "", "text": "一応解決したから"},
        { "location": "669/TALK"    , "narrator": "アーヤ", "text": "一応って"},
        { "location": "671/TALK"    , "narrator": "アーヤ", "text": "説明してよね"},
        { "location": "672/TALK"    , "narrator": "アーヤ", "text": "後で"},
        { "location": "674/SEL"     , "narrator": "", "text": "もちろん"},
        { "location": "675/SEL"     , "narrator": "", "text": "がんばる"},
        { "location": "676/SEL"     , "narrator": "", "text": "できるかな…"},
        { "location": "677/ACT"     , "narrator": "", "text": "もちろん"},
        { "location": "678/TALK"    , "narrator": "アーヤ", "text": "よろしくね"},
        { "location": "679/ACT"     , "narrator": "", "text": "がんばる"},
        { "location": "680/TALK"    , "narrator": "アーヤ", "text": "色々あったみたいね"},
        { "location": "681/ACT"     , "narrator": "", "text": "できるかな…"},
        { "location": "682/TALK"    , "narrator": "アーヤ", "text": "そんなに大変なことなの"},
        { "location": "685/SEL"     , "narrator": "", "text": "それよりつばめたちのこと"},
        { "location": "686/SEL"     , "narrator": "", "text": "みんなアーヤを頼りにしてるよ"},
        { "location": "687/SEL"     , "narrator": "", "text": "つばめと神楽を救ってあげて"},
        { "location": "688/ACT"     , "narrator": "", "text": "それよりつばめたちのこと"},
        { "location": "689/TALK"    , "narrator": "アーヤ", "text": "そうね"},
        { "location": "690/TALK"    , "narrator": "アーヤ", "text": "今はそれが一番大事"},
        { "location": "691/ACT"     , "narrator": "", "text": "みんなアーヤを頼りにしてるよ"},
        { "location": "692/TALK"    , "narrator": "アーヤ", "text": "どうかしら"},
        { "location": "693/TALK"    , "narrator": "アーヤ", "text": "でもリーダーだもの"},
        { "location": "694/TALK"    , "narrator": "アーヤ", "text": "しっかりしなきゃ"},
        { "location": "695/ACT"     , "narrator": "", "text": "つばめと神楽を救ってあげて"},
        { "location": "696/TALK"    , "narrator": "アーヤ", "text": "絶対に"},
        { "location": "697/TALK"    , "narrator": "アーヤ", "text": "助けるわ"},
        { "location": "710/TALK"    , "narrator": "アーヤ", "text": "…自分でもびっくり。"},
        { "location": "711/TALK"    , "narrator": "アーヤ", "text": "$handle$さんと\n話しただけで\n気持ちが違う。"},
        { "location": "712/TALK"    , "narrator": "アーヤ", "text": "でもそのくらいの\n間柄じゃなきゃ、\n結婚なんてできないわ。"},
        { "location": "714/TALK"    , "narrator": "アーヤ", "text": "愛って言葉も\n軽すぎる気持ち。"},
        { "location": "716/TALK"    , "narrator": "アーヤ", "text": "$handle$さんと\nまた話せるように\nなってよかった…。"},
        { "location": "718/TALK"    , "narrator": "アーヤ", "text": "…今はそっちの\nことじゃなく。"},
        { "location": "720/TALK"    , "narrator": "アーヤ", "text": "みやび。\n聞こえてる？"},
        { "location": "721/TALK"    , "narrator": "透明みやび", "text": "もちろん。"},
        { "location": "722/TALK"    , "narrator": "アーヤ", "text": "残念だけど姉と\n連絡は取れない。"},
        { "location": "723/TALK"    , "narrator": "アーヤ", "text": "だからこちらだけで\n解決できる作戦しか\n立てられないわ。"},
        { "location": "724/TALK"    , "narrator": "透明みやび", "text": "そうやろうとは\n思うちょった。"},
        { "location": "725/TALK"    , "narrator": "アーヤ", "text": "でもみやびなら\nどうにかできると\n思ってるわ。"},
        { "location": "726/TALK"    , "narrator": "透明みやび", "text": "…いつの間にそんなに\n人を乗せるんが\n上手うなったかね。"},
        { "location": "727/TALK"    , "narrator": "アーヤ", "text": "おだててなんてないわ。\n本心よ。"},
        { "location": "728/TALK"    , "narrator": "アーヤ", "text": "それで――。"},
        { "location": "637/DIALOG"  , "narrator": "Dialog_InfoOS", "text": "\n<color=red>\nApp::WAVE\nactivation succeed!!\n</color>\nライセンスの更新\nありがとうございました。\n素敵なWAVEライフを！\n"},
        { "location": "739/DIALOG"  , "narrator": "Dialog_chapter_ch02", "text": "【28 時計じかけのイチゴ】"}
    ]
}
