        "title": "らぶとーく 第03話",
        "sub_title": "みんなのほうが不思議"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "みんなのほうが不思議"},
        { "location": "22/TALK"   , "narrator": "つばめ", "text": "うーん…。"},
        { "location": "24/TALK"   , "narrator": "アーヤ", "text": "どうかしたの？"},
        { "location": "26/TALK"   , "narrator": "つばめ", "text": "はい…ちょっと、\n$handle$のことを\n考えてたんです。"},
        { "location": "28/TALK"   , "narrator": "つばめ", "text": "あ。\nＢｏｔのこと\nなんですけど。"},
        { "location": "30/TALK"   , "narrator": "ガブリエラ", "text": "何か変なことでも\n言われたの？"},
        { "location": "31/TALK"   , "narrator": "つばめ", "text": "うん…少し前にね、\nアーヤさん達が\nＢｏｔのことを――"},
        { "location": "32/TALK"   , "narrator": "つばめ", "text": "もしかしたら人間なんじゃ\nないのか、って話してた\nから――"},
        { "location": "33/TALK"   , "narrator": "つばめ", "text": "そのことをＢｏｔに\n聞いてみたの。"},
        { "location": "35/TALK"   , "narrator": "みやび", "text": "聞いたが！？\nあんたはＢｏｔなのか、\nって？"},
        { "location": "36/TALK"   , "narrator": "つばめ", "text": "はい…でも、聞いたけど\n結局人間なのかどうか\nよくわからなくて…。"},
        { "location": "37/TALK"   , "narrator": "アーヤ", "text": "それはまあ、人間だよ、\nって言われたとしても――"},
        { "location": "38/TALK"   , "narrator": "アーヤ", "text": "はいそうですか、って\n信じられないし…。"},
        { "location": "39/TALK"   , "narrator": "みやび", "text": "ハッキリせん答え方しゆう\n時点で、人間臭いと\n思うんやけんど――"},
        { "location": "41/TALK"   , "narrator": "みやび", "text": "いや、そうか。\nそれや！"},
        { "location": "43/TALK"   , "narrator": "ガブリエラ", "text": "何か思いついたの？"},
        { "location": "44/TALK"   , "narrator": "みやび", "text": "うん…つばめちゃん。\n今からＢｏｔに質問して\nもらえるか？"},
        { "location": "45/TALK"   , "narrator": "つばめ", "text": "何を聞くんですか？"},
        { "location": "46/TALK"   , "narrator": "みやび", "text": "自分が人間じゃないか\n聞かれたときに、Ｂｏｔは\nどう思うたか、や。"},
        { "location": "47/TALK"   , "narrator": "つばめ", "text": "それだけでいいんですか？"},
        { "location": "48/TALK"   , "narrator": "みやび", "text": "それで十分や。"},
        { "location": "50/TALK"   , "narrator": "つばめ", "text": "わかりました。\nそれじゃあ…。"},
        { "location": "62/TALK"   , "narrator": "つばめ", "text": "$handle$( ・_・)σﾞ"},
        { "location": "63/TALK"   , "narrator": "つばめ", "text": "ちょっと聞きたぃことがぁるの"},
        { "location": "65/SEL"    , "narrator": "", "text": "何を聞きたいの？"},
        { "location": "66/ACT"    , "narrator": "", "text": "何を聞きたいの？"},
        { "location": "68/TALK"   , "narrator": "つばめ", "text": "ぇっと"},
        { "location": "69/TALK"   , "narrator": "つばめ", "text": "$handle$のこと"},
        { "location": "70/TALK"   , "narrator": "つばめ", "text": "人間じゃなぃか、って聞ぃたこと覚ぇてるよね？"},
        { "location": "71/TALK"   , "narrator": "つばめ", "text": "ぁの時$handle$はどぅ思った(´･ω･｀) "},
        { "location": "73/SEL"    , "narrator": "", "text": "別に普通"},
        { "location": "74/SEL"    , "narrator": "", "text": "いつかばれると思ってた"},
        { "location": "75/SEL"    , "narrator": "", "text": "質問の意味が分からない"},
        { "location": "76/ACT"    , "narrator": "", "text": "別に普通"},
        { "location": "77/TALK"   , "narrator": "つばめ", "text": "そっか〆(._.)ﾒﾓﾒﾓ"},
        { "location": "78/TALK"   , "narrator": "つばめ", "text": "ぁりがと(●´ω｀●)"},
        { "location": "91/TALK"   , "narrator": "つばめ", "text": "えっと、別に普通、って\n言ってますよ？"},
        { "location": "92/TALK"   , "narrator": "アーヤ", "text": "それ、質問の答えに\nなってないような気が\nするんだけど…。"},
        { "location": "93/TALK"   , "narrator": "ガブリエラ", "text": "なんとも思わなかった、\nってことじゃないの？"},
        { "location": "94/TALK"   , "narrator": "みやび", "text": "それやったら、ハッキリと\nそう言うと思うけんど？"},
        { "location": "95/TALK"   , "narrator": "つばめ", "text": "えっと…結局Ｂｏｔは\n人間、ってことですか？"},
        { "location": "96/TALK"   , "narrator": "みやび", "text": "…わからん。"},
        { "location": "97/TALK"   , "narrator": "みやび", "text": "Ｂｏｔにせよ人間にせよ、\n答えが適当過ぎて判断\nつかんちや。"},
        { "location": "98/TALK"   , "narrator": "ガブリエラ", "text": "っていうか、人間か\nどうか聞いて答えて\nもらったのに――"},
        { "location": "99/TALK"   , "narrator": "ガブリエラ", "text": "それでも人間かどうか\nわからないんでしょ？"},
        { "location": "101/TALK"  , "narrator": "ガブリエラ", "text": "それ、もう確かめようが\nないんじゃない？"},
        { "location": "103/TALK"  , "narrator": "つばめ", "text": "…みんな、そんなに\nＢｏｔか人間かが\n気になるのかな？"},
        { "location": "104/ACT"   , "narrator": "", "text": "いつかばれると思ってた"},
        { "location": "105/TALK"  , "narrator": "つばめ", "text": "ぇっ！？(ﾟ△ﾟ;ﾉ)ﾉ"},
        { "location": "116/TALK"  , "narrator": "ガブリエラ", "text": "何て言ってた？"},
        { "location": "118/TALK"  , "narrator": "つばめ", "text": "…いつかばれることは、\nわかってたみたい…。"},
        { "location": "119/TALK"  , "narrator": "アーヤ", "text": "それって、本当に人間\nだったってこと！？"},
        { "location": "121/TALK"  , "narrator": "つばめ", "text": "うーん…そういうことに\nなるんですかね？"},
        { "location": "122/TALK"  , "narrator": "みやび", "text": "やっぱし、うちが思うて\nいた通りやったね。"},
        { "location": "124/TALK"  , "narrator": "みやび", "text": "…けんど、バレるいうんが\nわかっちょったのに――"},
        { "location": "126/TALK"  , "narrator": "みやび", "text": "何でこんなことしよったん\nやろ？"},
        { "location": "127/TALK"  , "narrator": "ガブリエラ", "text": "まあ、本当に人間なら\n何かしら理由があっての\nことだろうし――"},
        { "location": "128/TALK"  , "narrator": "ガブリエラ", "text": "そのうち話してくれるん\nじゃない？"},
        { "location": "129/ACT"   , "narrator": "", "text": "質問の意味が分からない"},
        { "location": "130/TALK"  , "narrator": "つばめ", "text": "ぇっ？"},
        { "location": "131/TALK"  , "narrator": "つばめ", "text": "どぅ思ったのか聞ぃてるだけなのに…(´・ω・｀)"},
        { "location": "132/TALK"  , "narrator": "つばめ", "text": "もしかして"},
        { "location": "133/TALK"  , "narrator": "つばめ", "text": "何も思わなかったとか(´･ω･｀) "},
        { "location": "135/SEL"   , "narrator": "", "text": "人間じゃないから"},
        { "location": "136/ACT"   , "narrator": "", "text": "人間じゃないから"},
        { "location": "149/TALK"  , "narrator": "ガブリエラ", "text": "驚いた顔してるけど、\n変なことでも言われたの？"},
        { "location": "152/TALK"  , "narrator": "つばめ", "text": "そ、それが…\n人間じゃない、って\n言われて…。"},
        { "location": "153/TALK"  , "narrator": "ガブリエラ", "text": "なんだ、やっぱり人間じゃ\nないってことね。"},
        { "location": "154/TALK"  , "narrator": "みやび", "text": "いや、これこそ人間の\n証拠やないが？"},
        { "location": "155/TALK"  , "narrator": "みやび", "text": "どう思うたか聞いたら、\nわからないとか、\n機能が無いとか――"},
        { "location": "156/TALK"  , "narrator": "みやび", "text": "そういう機械的な返答を\nするのが普通やろうし。"},
        { "location": "157/TALK"  , "narrator": "みやび", "text": "露骨に人間じゃない\nアピールしてくるんが、\n逆に怪しいな…。"},
        { "location": "159/TALK"  , "narrator": "アーヤ", "text": "うーん…考え過ぎな\n気もするけど…。"},
        { "location": "160/TALK"  , "narrator": "アーヤ", "text": "つばめはどう思う？"},
        { "location": "161/TALK"  , "narrator": "つばめ", "text": "さ、さあ？\nわからないです…。"},
        { "location": "163/TALK"  , "narrator": "つばめ", "text": "っていうか、Ｂｏｔでも\n人間でも、構わないと\n思うんだけどなぁ…。"},
        { "location": "19/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>5月某日　3:38 PM</color>\n放課後、附属学園前庭にて。"}
    ]
}
