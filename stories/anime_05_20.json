{
    "dir": "chap20/daydra/anime_05_20.js",
    "type": "MainStory",
    "info": {
        "story_id": "20501",
        "cid": "kagura",
        "title": "001 アニメーション",
        "sub_title": "NYABONYASTIE 第二巻"
    },
    "entry":
    [
        { "location": "534/SCENARIO", "narrator": "", "text": "アニメ第21話"},
        { "location": "547/TALK"    , "narrator": "千羽鶴", "text": "ごきげんよう、\n$handle$。"},
        { "location": "548/TALK"    , "narrator": "千羽鶴", "text": "もう一度\n私との会話を\n再現する？"},
        { "location": "549/SEL"     , "narrator": "", "text": "はい"},
        { "location": "550/SEL"     , "narrator": "", "text": "いいえ"},
        { "location": "551/SEL"     , "narrator": "", "text": "にゃボットの解説だけ聞く"},
        { "location": "552/ACT"     , "narrator": "", "text": "はい"},
        { "location": "553/TALK"    , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "555/ACT"     , "narrator": "", "text": "いいえ"},
        { "location": "556/TALK"    , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "558/ACT"     , "narrator": "", "text": "にゃボットの解説だけ聞く"},
        { "location": "559/TALK"    , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "567/TALK"    , "narrator": "千羽鶴", "text": "今回もまた、特に\n重要な話はない\nゲームセクションだけど…"},
        { "location": "569/TALK"    , "narrator": "千羽鶴", "text": "聞くだけ野暮だった。"},
        { "location": "570/TALK"    , "narrator": "千羽鶴", "text": "貴方は前回も\nクイズをやって\nにゃボットを貰ってる。"},
        { "location": "571/TALK"    , "narrator": "千羽鶴", "text": "今回も是非\n楽しんでいって。"},
        { "location": "573/TALK"    , "narrator": "千羽鶴", "text": "やっていく？"},
        { "location": "574/SEL"     , "narrator": "", "text": "帰ります"},
        { "location": "575/SEL"     , "narrator": "", "text": "やっていく"},
        { "location": "576/ACT"     , "narrator": "", "text": "帰ります"},
        { "location": "577/TALK"    , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "578/TALK"    , "narrator": "千羽鶴", "text": "それじゃ、また。"},
        { "location": "580/ACT"     , "narrator": "", "text": "やっていく"},
        { "location": "581/TALK"    , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "582/TALK"    , "narrator": "千羽鶴", "text": "今回は、トライナリーの\n5人も参加するから、\n是非楽しんでいって。"},
        { "location": "583/TALK"    , "narrator": "千羽鶴", "text": "それじゃ――"},
        { "location": "590/TALK"    , "narrator": "千羽鶴", "text": "<size=40>どーん！</size>"},
        { "location": "591/TALK"    , "narrator": "千羽鶴", "text": "というわけで、\n今回もまた特別回！"},
        { "location": "592/SEL"     , "narrator": "", "text": "千羽鶴キター"},
        { "location": "593/SEL"     , "narrator": "", "text": "今回は何やるの？"},
        { "location": "594/ACT"     , "narrator": "", "text": "千羽鶴キター"},
        { "location": "595/ACT"     , "narrator": "", "text": "今回は何やるの？"},
        { "location": "601/TALK"    , "narrator": "千羽鶴", "text": "<size=35><color=red>トライナリーと\nじゃんけん大会！</color></size>"},
        { "location": "602/SEL"     , "narrator": "", "text": "ドンドンパフパフ！"},
        { "location": "603/SEL"     , "narrator": "", "text": "名前が直球すぎじゃね？"},
        { "location": "604/SEL"     , "narrator": "", "text": "そんな事やってる暇あんの？"},
        { "location": "605/ACT"     , "narrator": "", "text": "ドンドンパフパフ！"},
        { "location": "607/ACT"     , "narrator": "", "text": "名前が直球すぎじゃね？"},
        { "location": "608/TALK"    , "narrator": "千羽鶴", "text": "黙れ。"},
        { "location": "609/ACT"     , "narrator": "", "text": "そんな事やってる暇あんの？"},
        { "location": "610/TALK"    , "narrator": "千羽鶴", "text": "今回はMV回。\nMV回はTRI-OSが\nガベコレする時間。"},
        { "location": "611/SEL"     , "narrator": "", "text": "それ前も聞いた"},
        { "location": "612/SEL"     , "narrator": "", "text": "ガベコレってなに？"},
        { "location": "613/ACT"     , "narrator": "", "text": "それ前も聞いた"},
        { "location": "614/TALK"    , "narrator": "千羽鶴", "text": "知ってる。"},
        { "location": "615/ACT"     , "narrator": "", "text": "ガベコレってなに？"},
        { "location": "616/TALK"    , "narrator": "千羽鶴", "text": "ガベージコレクション。\nシステムの最適化と\nゴミ捨てをする時間。"},
        { "location": "618/TALK"    , "narrator": "千羽鶴", "text": "だから、ろくに何の機能も\n動かないし、未来に対して\nアプローチもできない。"},
        { "location": "622/TALK"    , "narrator": "千羽鶴", "text": "<color=red><size=40>遊ぶが大吉！</size></color>"},
        { "location": "623/TALK"    , "narrator": "千羽鶴", "text": "人生ゆとりもまた\n必要だと思う。"},
        { "location": "624/TALK"    , "narrator": "千羽鶴", "text": "楽しい事をやって\n笑うだけで、寿命が\n延びると言われてる！"},
        { "location": "625/SEL"     , "narrator": "", "text": "うむ、確かに"},
        { "location": "626/SEL"     , "narrator": "", "text": "いや、このアプリが一番辛いのですが"},
        { "location": "627/ACT"     , "narrator": "", "text": "うむ、確かに"},
        { "location": "628/ACT"     , "narrator": "", "text": "いや、このアプリが一番辛いのですが"},
        { "location": "630/TALK"    , "narrator": "千羽鶴", "text": "揚げ足とりめ。"},
        { "location": "633/TALK"    , "narrator": "千羽鶴", "text": "ぷぷい。"},
        { "location": "634/TALK"    , "narrator": "千羽鶴", "text": "そこは空気読んで\n同意するところだから。"},
        { "location": "641/TALK"    , "narrator": "千羽鶴", "text": "というわけで、\n早速だけどルールと賞品の\n説明をする。"},
        { "location": "642/TALK"    , "narrator": "千羽鶴", "text": "貴方は最初、ジャンケン用\nジャンコインを５枚、\n持っている。"},
        { "location": "643/TALK"    , "narrator": "千羽鶴", "text": "原則として、\n勝てばコインが増えて、\n負ければ減る。"},
        { "location": "644/TALK"    , "narrator": "千羽鶴", "text": "そして\n10枚ゲットすれば――"},
        { "location": "653/TALK"    , "narrator": "千羽鶴", "text": "鬼才國政領火博士制作、\n多足ロボットにゃボットが\n育てられる連載型クラン！"},
        { "location": "654/TALK"    , "narrator": "千羽鶴", "text": "<color=green>定期刊クラン誌\n『にゃぼにゃすティー』\n第二巻</color>をプレゼント！"},
        { "location": "658/SEL"     , "narrator": "", "text": "にゃボット２個目キター！"},
        { "location": "659/SEL"     , "narrator": "", "text": "にゃボットってなに？"},
        { "location": "660/ACT"     , "narrator": "", "text": "にゃボット２個目キター！"},
        { "location": "661/TALK"    , "narrator": "千羽鶴", "text": "そう、２個目来た。\nこれで１凸。"},
        { "location": "662/TALK"    , "narrator": "千羽鶴", "text": "にゃぼにゃすティーには\n１巻につき１体の\nにゃボットがついてくる。"},
        { "location": "663/TALK"    , "narrator": "千羽鶴", "text": "全5巻にわたるその全てを\nコンプリートすれば、\n４凸にゃボットになる！"},
        { "location": "664/TALK"    , "narrator": "千羽鶴", "text": "だから今回も頑張って\nジャンケンコインを\n１０枚貯めてゲットして。"},
        { "location": "665/ACT"     , "narrator": "", "text": "にゃボットってなに？"},
        { "location": "666/TALK"    , "narrator": "千羽鶴", "text": "にゃボットは\n國政領火が制作した\nネコ型ロボット。"},
        { "location": "667/TALK"    , "narrator": "千羽鶴", "text": "特徴は、\n足が８本あること。"},
        { "location": "668/TALK"    , "narrator": "千羽鶴", "text": "本人曰く――"},
        { "location": "669/TALK"    , "narrator": "千羽鶴", "text": "『最も画期的かつ実用的で\n可愛さもギュッと詰まった\n多目的クモ型にゃボット』"},
        { "location": "670/TALK"    , "narrator": "千羽鶴", "text": "……とのこと。"},
        { "location": "671/TALK"    , "narrator": "千羽鶴", "text": "制作に至る経緯は、\n実妹である國政綾水に\nプレゼントする為だとか。"},
        { "location": "672/TALK"    , "narrator": "千羽鶴", "text": "國政綾水の\nココロスフィアを見ると、\nエピソードが見られる。"},
        { "location": "673/TALK"    , "narrator": "千羽鶴", "text": "というわけだから、\nにゃボット目指しコイン\n１０個獲得してみて！"},
        { "location": "675/TALK"    , "narrator": "千羽鶴", "text": "というわけで、\n早速ジャンケンを\nしたいと思う。"},
        { "location": "677/TALK"    , "narrator": "千羽鶴", "text": "対戦相手は、\nトライナリーの５人。"},
        { "location": "678/TALK"    , "narrator": "千羽鶴", "text": "卯月神楽を除く４人は、\n勝てば１コインゲット、\n負ければ１コイン没収。"},
        { "location": "679/TALK"    , "narrator": "千羽鶴", "text": "卯月神楽だけは、\n勝てば２コインゲット、\n負ければ２コイン没収。"},
        { "location": "680/TALK"    , "narrator": "千羽鶴", "text": "ポイントは、\nそれぞれの子によって\n微妙に癖があるという点。"},
        { "location": "681/TALK"    , "narrator": "千羽鶴", "text": "それを見つけ出せたら、\n簡単に１０コイン\nゲットできるかも。"},
        { "location": "682/TALK"    , "narrator": "千羽鶴", "text": "というわけで、是非\n彼女たちの癖を見つけて\n勝ち抜いて欲しい！"},
        { "location": "683/TALK"    , "narrator": "千羽鶴", "text": "それでは！\nゲームスタート！"},
        { "location": "710/SEL"     , "narrator": "", "text": "つばめと戦う"},
        { "location": "711/SEL"     , "narrator": "", "text": "アーヤと戦う"},
        { "location": "712/SEL"     , "narrator": "", "text": "ガブリエラと戦う"},
        { "location": "713/SEL"     , "narrator": "", "text": "みやびと戦う"},
        { "location": "714/SEL"     , "narrator": "", "text": "神楽と戦う"},
        { "location": "715/SEL"     , "narrator": "", "text": "棄権する"},
        { "location": "716/ACT"     , "narrator": "", "text": "つばめと戦う"},
        { "location": "721/TALK"    , "narrator": "つばめ", "text": "ああっ……。\n負けちゃったね。"},
        { "location": "724/TALK"    , "narrator": "つばめ", "text": "わぁい！\n勝ったぁ！！"},
        { "location": "729/ACT"     , "narrator": "", "text": "アーヤと戦う"},
        { "location": "734/TALK"    , "narrator": "アーヤ", "text": "あらら、\n負けちゃったわね。"},
        { "location": "737/TALK"    , "narrator": "アーヤ", "text": "ふふっ、\n私の勝ちね。"},
        { "location": "742/ACT"     , "narrator": "", "text": "ガブリエラと戦う"},
        { "location": "747/TALK"    , "narrator": "ガブリエラ", "text": "ええっ！\n負けちゃったの！？"},
        { "location": "750/TALK"    , "narrator": "ガブリエラ", "text": "ま、こんなものよね！"},
        { "location": "755/ACT"     , "narrator": "", "text": "みやびと戦う"},
        { "location": "760/TALK"    , "narrator": "みやび", "text": "ふむ、負けか。\n勝負事には\n弱いきね。"},
        { "location": "763/TALK"    , "narrator": "みやび", "text": "うちに勝とうなぞ\n８８年早いわ。"},
        { "location": "768/ACT"     , "narrator": "", "text": "神楽と戦う"},
        { "location": "773/TALK"    , "narrator": "神楽", "text": "ふわぁっ！\n負けちゃいました…。"},
        { "location": "776/TALK"    , "narrator": "神楽", "text": "ぴょんこの\n勝ちでーすっ♪"},
        { "location": "781/ACT"     , "narrator": "", "text": "棄権する"},
        { "location": "804/TALK"    , "narrator": "千羽鶴", "text": "というわけで、\n残念ながら貴方は\n負けてしまった！"},
        { "location": "805/TALK"    , "narrator": "千羽鶴", "text": "すなわち、\nゲームオーバー！"},
        { "location": "806/TALK"    , "narrator": "千羽鶴", "text": "でも安心して。\nこのジャンケンは\n何度でも挑戦できる。"},
        { "location": "807/TALK"    , "narrator": "千羽鶴", "text": "というわけで、\nまたの挑戦を\nお待ちしてるから。"},
        { "location": "808/TALK"    , "narrator": "千羽鶴", "text": "ばいばい。"},
        { "location": "832/TALK"    , "narrator": "千羽鶴", "text": "おめでとう！\n$handle$。"},
        { "location": "833/TALK"    , "narrator": "千羽鶴", "text": "貴方は見事、トライナリー\nジャンケンで、コイン\n１０枚を勝ち取った！"},
        { "location": "834/TALK"    , "narrator": "千羽鶴", "text": "というわけで、\n約束通りにゃボットを\n進呈するけど――"},
        { "location": "835/TALK"    , "narrator": "千羽鶴", "text": "その前にCM。"},
        { "location": "837/SEL"     , "narrator": "", "text": "映像を見る\n<color=green>【高画質/36MB 2:22】</color>"},
        { "location": "838/SEL"     , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/13MB 2:22】</color>"},
        { "location": "839/SEL"     , "narrator": "", "text": "映像をスキップする"},
        { "location": "840/ACT"     , "narrator": "", "text": "映像を見る\n<color=green>【高画質/36MB 2:22】</color>"},
        { "location": "841/TALK"    , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "847/ACT"     , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/13MB 2:22】</color>"},
        { "location": "848/TALK"    , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "854/ACT"     , "narrator": "", "text": "映像をスキップする"},
        { "location": "855/TALK"    , "narrator": "千羽鶴", "text": "そう……。"},
        { "location": "868/TALK"    , "narrator": "千羽鶴", "text": "というわけで！"},
        { "location": "871/TALK"    , "narrator": "千羽鶴", "text": "賞品授与式を\n執り行います！"},
        { "location": "873/TALK"    , "narrator": "千羽鶴", "text": "尚、賞品の授与は前回と\n同じく、國政領火博士\nからとなります。"},
        { "location": "875/TALK"    , "narrator": "千羽鶴", "text": "尚、賞品の授与は、\n世界的に著名な\n量子研究家であり――"},
        { "location": "876/TALK"    , "narrator": "千羽鶴", "text": "にゃボットの生みの親でも\nある、國政領火博士に\nお願いしたいと思います。"},
        { "location": "893/TALK"    , "narrator": "エリカ", "text": "コーンコン。\nみなさんこんにちは、\n國政領火です！"},
        { "location": "899/TALK"    , "narrator": "エリカ", "text": "連載クラン\nにゃぼにゃすティー！\nゲットおめでとう！"},
        { "location": "900/TALK"    , "narrator": "エリカ", "text": "これからもジャンジャン\nプレゼントしていく\n予定だから――"},
        { "location": "901/TALK"    , "narrator": "エリカ", "text": "頑張って集めてね！"},
        { "location": "906/TALK"    , "narrator": "エリカ", "text": "というわけで、前回も\nゲットしていたから\nわかると思うけど――"},
        { "location": "907/TALK"    , "narrator": "エリカ", "text": "只今より\n“本誌”部分を\n始めまーす！"},
        { "location": "909/TALK"    , "narrator": "エリカ", "text": "というわけで、\nこのコーナーが\n何なのかというと――"},
        { "location": "910/TALK"    , "narrator": "エリカ", "text": "実は、連載クラン\nにゃぼにゃすティー！の\n本誌に当たる部分なの。"},
        { "location": "911/SEL"     , "narrator": "", "text": "というと？"},
        { "location": "912/ACT"     , "narrator": "", "text": "というと？"},
        { "location": "914/TALK"    , "narrator": "エリカ", "text": "要するに！"},
        { "location": "915/TALK"    , "narrator": "エリカ", "text": "にゃぼにゃすティー！\nバンドルのクラン、\nにゃボットについて――"},
        { "location": "916/TALK"    , "narrator": "エリカ", "text": "解説しちゃう\nコーナーなんです！"},
        { "location": "918/SEL"     , "narrator": "", "text": "わーい！"},
        { "location": "919/SEL"     , "narrator": "", "text": "結構です"},
        { "location": "920/ACT"     , "narrator": "", "text": "わーい！"},
        { "location": "921/TALK"    , "narrator": "エリカ", "text": "うんうん。\nわかるよ、その気持ち！"},
        { "location": "922/TALK"    , "narrator": "エリカ", "text": "やっぱりこれ系には\n解説冊子がなくちゃ\n片手落ちだもんね！"},
        { "location": "923/TALK"    , "narrator": "エリカ", "text": "それじゃ早速、\n聞きたいコンテンツを\n選択してね！"},
        { "location": "925/SEL"     , "narrator": "", "text": "こだわりポイント"},
        { "location": "926/SEL"     , "narrator": "", "text": "開発秘話"},
        { "location": "927/SEL"     , "narrator": "", "text": "もういいです…"},
        { "location": "928/ACT"     , "narrator": "", "text": "こだわりポイント"},
        { "location": "929/TALK"    , "narrator": "エリカ", "text": "ズバリ！\n足の数です！"},
        { "location": "930/TALK"    , "narrator": "エリカ", "text": "にゃボットは８本足、\nすなわち多脚であることに\n意義があります！"},
        { "location": "931/TALK"    , "narrator": "エリカ", "text": "それはどういうことかと\n申しますと！"},
        { "location": "932/TALK"    , "narrator": "エリカ", "text": "多脚ほど安定性と経済性、\n実用性を兼ね備えた\n移動方式はありません！"},
        { "location": "933/TALK"    , "narrator": "エリカ", "text": "例えば車輪の場合、\n速度は出ますが、少しの\n凹凸する問題になります。"},
        { "location": "934/TALK"    , "narrator": "エリカ", "text": "二足歩行は安定性に乏しく\n少しの衝撃で倒れて\nしまいます。"},
        { "location": "935/TALK"    , "narrator": "エリカ", "text": "それに比べ、多脚は\n倒れることも殆ど無く、\n二足以上の速度が出せる。"},
        { "location": "936/TALK"    , "narrator": "エリカ", "text": "尚、車輪でさえ転倒する\n可能性はありますが――"},
        { "location": "937/TALK"    , "narrator": "エリカ", "text": "万一転倒した場合、\n多脚と違い、車輪は\n起き上がることが不可能。"},
        { "location": "938/TALK"    , "narrator": "エリカ", "text": "多脚はその足の自由度を\n生かし、また8本という\n可能性の多さから――"},
        { "location": "939/TALK"    , "narrator": "エリカ", "text": "プログラムにコツは\n必要ですが、確実に自分で\n起き上がる事が可能です！"},
        { "location": "940/TALK"    , "narrator": "エリカ", "text": "このように、多脚は\n全ての移動手法に勝る\n素晴らしい手法で！"},
        { "location": "941/TALK"    , "narrator": "エリカ", "text": "それを考えると、生命の\n大半が４足以上の多脚で\nあることにも納得です！"},
        { "location": "942/TALK"    , "narrator": "エリカ", "text": "尚、多脚と勝負できる\n可能性があるものとしては\nキャタピラがありますが。"},
        { "location": "943/TALK"    , "narrator": "エリカ", "text": "確かにフレキシブルさでは\n車輪よりも上を行き、\n凸凹も得意ではあります。"},
        { "location": "944/TALK"    , "narrator": "エリカ", "text": "しかし、やはりあれは\n車輪の仲間であり！"},
        { "location": "945/TALK"    , "narrator": "エリカ", "text": "転倒時などの\nフレキシブルな対応は\n期待できません。"},
        { "location": "946/TALK"    , "narrator": "エリカ", "text": "よって、多脚こそが\n大自然から授かった\n最高の足であると！"},
        { "location": "947/TALK"    , "narrator": "エリカ", "text": "わたしは信じて\n止まないのです！"},
        { "location": "948/TALK"    , "narrator": "エリカ", "text": "尚、多脚の唯一とも言える\n短所として、スピードを\n出せない事がありますが―"},
        { "location": "949/TALK"    , "narrator": "エリカ", "text": "特殊な足の動きを\nすることで！"},
        { "location": "950/TALK"    , "narrator": "エリカ", "text": "にゃボットは、時速\n３０キロまで出す事が\nできるようになりました！"},
        { "location": "951/TALK"    , "narrator": "エリカ", "text": "以上がわたしの、\nにゃボットへのこだわり\nポイントになります！"},
        { "location": "954/ACT"     , "narrator": "", "text": "開発秘話"},
        { "location": "955/TALK"    , "narrator": "エリカ", "text": "にゃボットには\n量子AIが内蔵されて\nいるのですが――"},
        { "location": "956/TALK"    , "narrator": "エリカ", "text": "これがこの前、\nビックリするような事件を\n起こしました！"},
        { "location": "957/TALK"    , "narrator": "エリカ", "text": "にゃボットの量子AIには、\n綾ちゃんに懐くように\n特別な学習があって。"},
        { "location": "958/TALK"    , "narrator": "エリカ", "text": "綾ちゃんに危害をもたらす\nような言葉やアクションを\n見かけたら即反応！"},
        { "location": "959/TALK"    , "narrator": "エリカ", "text": "という風に\n設計してあるのですが。"},
        { "location": "960/TALK"    , "narrator": "エリカ", "text": "先日工房で、訓練用に\n綾ちゃんの写真をプリント\nしたものを捨てたら――"},
        { "location": "961/TALK"    , "narrator": "エリカ", "text": "わたしが\n消されかけました！"},
        { "location": "962/TALK"    , "narrator": "エリカ", "text": "その時は尻尾レーザーの\n出力テストをしていたん\nですけど。"},
        { "location": "963/TALK"    , "narrator": "エリカ", "text": "うっかりそれを忘れて、\n学習訓練後に電源を切る\nのも忘れていて。"},
        { "location": "964/TALK"    , "narrator": "エリカ", "text": "そのままプリントを\nビリビリしてたら、\n後ろからチュンって！"},
        { "location": "965/TALK"    , "narrator": "エリカ", "text": "ロボット三原則は\nちゃんと学習して\nいるのですが――"},
        { "location": "966/TALK"    , "narrator": "エリカ", "text": "それ故に、\n綾ちゃんを護るのと、\nロボット三原則を守る…。"},
        { "location": "967/TALK"    , "narrator": "エリカ", "text": "この二律背反に、\nにゃボットは悩み、そして\n軽く撃ったのでしょう。"},
        { "location": "968/TALK"    , "narrator": "エリカ", "text": "出力は暖まる程度で。\nだから、消されかけた、\nというのは大げさですが！"},
        { "location": "969/TALK"    , "narrator": "エリカ", "text": "にゃボットがわたしに、\n警告していたのは\n間違い無いです！"},
        { "location": "970/TALK"    , "narrator": "エリカ", "text": "ロボットにも愛という\n感情を与える事ができると\n確信した出来事でした！"},
        { "location": "973/ACT"     , "narrator": "", "text": "もういいです…"},
        { "location": "974/TALK"    , "narrator": "エリカ", "text": "うん。\nわかったよ。"},
        { "location": "976/TALK"    , "narrator": "エリカ", "text": "他にも聞きたいことが\nあれば、いつでも\n質問してね。"},
        { "location": "977/ACT"     , "narrator": "", "text": "結構です"},
        { "location": "978/TALK"    , "narrator": "エリカ", "text": "あらら…。"},
        { "location": "979/TALK"    , "narrator": "エリカ", "text": "聞きたいことが\nあれば、いつでも\n質問してね。"},
        { "location": "981/TALK"    , "narrator": "エリカ", "text": "話せることは\nお話するから。"},
        { "location": "982/TALK"    , "narrator": "エリカ", "text": "それじゃ、改めまして。\n今回はにゃボットの\nゲットおめでとう！"},
        { "location": "983/TALK"    , "narrator": "エリカ", "text": "色んな場面で活用して、\n可愛がってあげてね！"},
        { "location": "984/TALK"    , "narrator": "エリカ", "text": "それじゃ、またね！"},
        { "location": "986/SEL"     , "narrator": "", "text": "はーい"},
        { "location": "987/SEL"     , "narrator": "", "text": "ちょっと待って、リプレイスについて聞きたいことが"},
        { "location": "988/ACT"     , "narrator": "", "text": "はーい"},
        { "location": "989/ACT"     , "narrator": "", "text": "ちょっと待って、リプレイスについて聞きたいことが"},
        { "location": "990/TALK"    , "narrator": "エリカ", "text": "え？\nどうしたの？"},
        { "location": "991/SEL"     , "narrator": "", "text": "前回のエピソードに千羽鶴も出てこなかったし、それっぽい選択肢も無かった"},
        { "location": "992/ACT"     , "narrator": "", "text": "前回のエピソードに千羽鶴も出てこなかったし、それっぽい選択肢も無かった"},
        { "location": "994/TALK"    , "narrator": "エリカ", "text": "……。"},
        { "location": "995/TALK"    , "narrator": "エリカ", "text": "えっ？\nそうなの？"},
        { "location": "996/TALK"    , "narrator": "エリカ", "text": "そんな筈は\nないんだけど……"},
        { "location": "997/TALK"    , "narrator": "エリカ", "text": "ちょっとチューニングが\nズレてるかもしれないから\n見ておくね。"},
        { "location": "998/TALK"    , "narrator": "エリカ", "text": "教えてくれて\nありがとう。"},
        { "location": "1009/TALK"   , "narrator": "千羽鶴", "text": "……おかえり。"},
        { "location": "1010/TALK"   , "narrator": "千羽鶴", "text": "というわけで、\n今回のジャンケン大会は\nこれでお終い。"},
        { "location": "1011/TALK"   , "narrator": "千羽鶴", "text": "次回はまた\n次のMV回になる。"},
        { "location": "1012/TALK"   , "narrator": "千羽鶴", "text": "お楽しみに。"},
        { "location": "704/DIALOG"  , "narrator": "Dialog_chiharupoint", "text": "あなたは現在、\n<size=40><color=red>$jancoin$ジャンコイン</color></size>\n所有しています。"},
        { "location": "782/DIALOG"  , "narrator": "YES_NO", "text": "試合を棄権しますか？\n\n「Yes」を押すと、\nこのゲームから抜けます。\n\n「No」を押すと、\nジャンケンに戻ります。\n"}
    ]
}
