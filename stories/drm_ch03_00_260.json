{
    "dir": "dramatics/daydra/drm_ch03_00_260.js",
    "type": "Episode",
    "info": {
        "story_id": "3026",
        "cid": "gabriella",
        "title": "らぶとーく  第26話",
        "sub_title": "雛は恋愛が苦手"
    },
    "entry":
    [
        { "location": "387/SCENARIO", "narrator": "", "text": "雛は恋愛が苦手"},
        { "location": "398/TALK"    , "narrator": "雛", "text": "そういえば、ずーっと\n気になってたことが\nあるんだけど――"},
        { "location": "399/TALK"    , "narrator": "雛", "text": "ガブリエラちゃんって、\nいっつもスマホ弄ってる\nよね？"},
        { "location": "401/TALK"    , "narrator": "ガブリエラ", "text": "そんな弄ってるつもり\nないんだけど…。"},
        { "location": "402/TALK"    , "narrator": "雛", "text": "そんなことないよー。"},
        { "location": "403/TALK"    , "narrator": "雛", "text": "話してる途中でも、\n急にスマホに向かったり\nすることあるし。"},
        { "location": "405/TALK"    , "narrator": "ガブリエラ", "text": "…$handle$との\nことか。"},
        { "location": "406/TALK"    , "narrator": "ガブリエラ", "text": "やっぱり、目の前で\n急にスマホ弄られたら\n気になるのかしら？"},
        { "location": "407/TALK"    , "narrator": "雛", "text": "その顔は…今初めて\n気付いた感じ？"},
        { "location": "409/TALK"    , "narrator": "ガブリエラ", "text": "…嫌な気にさせたなら\n謝るわ。"},
        { "location": "411/TALK"    , "narrator": "雛", "text": "あー、違う違う。\nそんなんじゃないよー。"},
        { "location": "412/TALK"    , "narrator": "雛", "text": "あたしはそれくらいで\n嫌な気持ちになるほど、\n心狭くないしね！"},
        { "location": "413/TALK"    , "narrator": "ガブリエラ", "text": "そ、そう…。"},
        { "location": "414/TALK"    , "narrator": "雛", "text": "ただ単に、何してるの\nかなぁ、って気になった\nだけだよ。"},
        { "location": "415/SEL"     , "narrator": "", "text": "$me$との会話"},
        { "location": "416/SEL"     , "narrator": "", "text": "日本語の勉強"},
        { "location": "417/SEL"     , "narrator": "", "text": "ハッキング"},
        { "location": "419/TALK"    , "narrator": "雛", "text": "って、もちろん言えない\nようなことだったら、\n言わないでいいから。"},
        { "location": "420/TALK"    , "narrator": "雛", "text": "女の子は秘密が\nいっぱいな生き物\nだからねー。"},
        { "location": "421/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "426/TALK"    , "narrator": "ガブリエラ", "text": "まあ、あんまり言いたく\nないんだけど――"},
        { "location": "427/TALK"    , "narrator": "ガブリエラ", "text": "最近、カプドラが\nちょっと気になって…。"},
        { "location": "429/TALK"    , "narrator": "雛", "text": "カプドラって、スマホの\nゲームだっけ？"},
        { "location": "432/TALK"    , "narrator": "ガブリエラ", "text": "そうよ。\n最近の限定イベントが\n凄く楽しくて――"},
        { "location": "433/TALK"    , "narrator": "ガブリエラ", "text": "それでつい、ね…。"},
        { "location": "435/TALK"    , "narrator": "雛", "text": "ふーん…そっかぁ…。"},
        { "location": "436/TALK"    , "narrator": "雛", "text": "っていうか、ガブちゃん\nって、そんなにゲーマー\nだったんだ？"},
        { "location": "438/TALK"    , "narrator": "ガブリエラ", "text": "ま、まあ、それは\n否定しないけど…。"},
        { "location": "439/TALK"    , "narrator": "ガブリエラ", "text": "…言い訳の理由を\n間違えたわ。"},
        { "location": "440/TALK"    , "narrator": "ガブリエラ", "text": "こういう時こそ、\nアドバイスくれれば\nいいのに…。"},
        { "location": "441/TALK"    , "narrator": "ガブリエラ", "text": "$handle$の役立たず！"},
        { "location": "443/ACT"     , "narrator": "", "text": "$me$との会話"},
        { "location": "457/TALK"    , "narrator": "ガブリエラ", "text": "却下よ"},
        { "location": "458/TALK"    , "narrator": "ガブリエラ", "text": "そんなこと、言えるわけないじゃない"},
        { "location": "470/TALK"    , "narrator": "雛", "text": "ほら、今もまた。"},
        { "location": "471/TALK"    , "narrator": "ガブリエラ", "text": "しまった！\nついうっかり…。"},
        { "location": "473/TALK"    , "narrator": "雛", "text": "うーん、気になるなー。\nガブリエラちゃんは\n何をしてたんだろー？"},
        { "location": "475/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "476/TALK"    , "narrator": "ガブリエラ", "text": "っていうか、何かしら\n予想はしてるんじゃ\nない？"},
        { "location": "477/TALK"    , "narrator": "雛", "text": "えへへ、バレたー？"},
        { "location": "478/TALK"    , "narrator": "雛", "text": "まあ、そんなに頻繁に\nスマホを弄るような\nことといったら――"},
        { "location": "479/TALK"    , "narrator": "雛", "text": "やっぱり、あれしか\nないでしょ！！"},
        { "location": "480/TALK"    , "narrator": "雛", "text": "彼氏とのＷＡＶＥ！"},
        { "location": "483/TALK"    , "narrator": "ガブリエラ", "text": "ちょ、はぁ！？"},
        { "location": "484/TALK"    , "narrator": "ガブリエラ", "text": "ないない、ないから！\nっていうか、彼氏とか\nいないし！"},
        { "location": "486/TALK"    , "narrator": "雛", "text": "本当かなぁ？\nあたし、それがどうにも\n信じられないんだけど。"},
        { "location": "487/TALK"    , "narrator": "雛", "text": "第一、ガブリエラちゃん\nみたいな可愛い子を――"},
        { "location": "488/TALK"    , "narrator": "雛", "text": "男子が放っておくとは\n思えないし。"},
        { "location": "489/TALK"    , "narrator": "ガブリエラ", "text": "知らないわよ、\nそんなの！"},
        { "location": "492/TALK"    , "narrator": "ガブリエラ", "text": "っていうか、人のこと\nより自分はどうなのよ？"},
        { "location": "493/TALK"    , "narrator": "ガブリエラ", "text": "ひなこだって、彼氏の\n一人くらいいるんじゃ\nないの？"},
        { "location": "495/TALK"    , "narrator": "雛", "text": "そりゃ、二人いたら\n大問題だよー。"},
        { "location": "496/TALK"    , "narrator": "ガブリエラ", "text": "…話、逸らそうと\nしてない？"},
        { "location": "497/TALK"    , "narrator": "雛", "text": "…………。"},
        { "location": "498/TALK"    , "narrator": "雛", "text": "いや、恥ずかしい話\nなんだけどさー。"},
        { "location": "499/TALK"    , "narrator": "雛", "text": "あたし、どーもその手の\n話が苦手で…。"},
        { "location": "501/TALK"    , "narrator": "ガブリエラ", "text": "いや、説得力皆無だし。\n話振ってきたのは\nひなこの方でしょ？"},
        { "location": "502/TALK"    , "narrator": "雛", "text": "そうだけど…ほら、\nそれはあたし自身の\n話じゃないでしょ？"},
        { "location": "503/TALK"    , "narrator": "雛", "text": "あたしさ、どうにも\n自分自身の恋愛話って、\n苦手で…。"},
        { "location": "504/TALK"    , "narrator": "ガブリエラ", "text": "それ、ただ恥ずかし\nがってるだけじゃない？"},
        { "location": "505/TALK"    , "narrator": "雛", "text": "…そうじゃないの。"},
        { "location": "506/TALK"    , "narrator": "雛", "text": "あたしね、その…\n他人から恋愛感情を\n向けられるのが――"},
        { "location": "508/TALK"    , "narrator": "雛", "text": "昔っから苦手でさー…\nあ、人の世話をするのは\n好きなんだけどねー。"},
        { "location": "510/TALK"    , "narrator": "ガブリエラ", "text": "なにそれ？\n他人からしたら\n厄介極まりないわね。"},
        { "location": "511/TALK"    , "narrator": "雛", "text": "そうかな？\n愛のキューピッド的な\n存在に思えない？"},
        { "location": "513/TALK"    , "narrator": "ガブリエラ", "text": "ただのお節介やきとしか\n思えないわよ。"},
        { "location": "515/TALK"    , "narrator": "雛", "text": "あちゃー…\nそれは残念…。"},
        { "location": "517/TALK"    , "narrator": "ガブリエラ", "text": "…でも、恋愛感情を\n向けられるのが苦手、\nか…。"},
        { "location": "518/TALK"    , "narrator": "ガブリエラ", "text": "将来的に、\n結構苦労しそうね。"},
        { "location": "520/TALK"    , "narrator": "雛", "text": "どうかな？\nまあ、興味もないから\n困らないよ、きっと。"},
        { "location": "521/TALK"    , "narrator": "ガブリエラ", "text": "そう…。"},
        { "location": "522/TALK"    , "narrator": "ガブリエラ", "text": "男の人が苦手なあたしが\n言えることじゃないとは\n思うけど――"},
        { "location": "523/TALK"    , "narrator": "ガブリエラ", "text": "この様子じゃ、\nあたしの方が先に\n彼氏とか作れそうね。"},
        { "location": "524/TALK"    , "narrator": "ガブリエラ", "text": "…ふふっ。"},
        { "location": "526/TALK"    , "narrator": "雛", "text": "ガブリエラちゃん？"},
        { "location": "527/TALK"    , "narrator": "ガブリエラ", "text": "あ、ううん。\n何でもない。"},
        { "location": "529/TALK"    , "narrator": "ガブリエラ", "text": "まあ、雛にもそのうち、\n恋愛感情を向けられて\n嬉しいって――"},
        { "location": "531/TALK"    , "narrator": "ガブリエラ", "text": "思えるような相手が、\nきっとできるわよ。"},
        { "location": "533/TALK"    , "narrator": "雛", "text": "そうかなぁ？"},
        { "location": "534/TALK"    , "narrator": "雛", "text": "って、アドバイス役は\nあたしの方だってばー！"},
        { "location": "535/ACT"     , "narrator": "", "text": "日本語の勉強"},
        { "location": "549/TALK"    , "narrator": "ガブリエラ", "text": "…まあ、無難かしら？"},
        { "location": "550/TALK"    , "narrator": "ガブリエラ", "text": "奇をてらうよりかはマシってところね"},
        { "location": "562/TALK"    , "narrator": "ガブリエラ", "text": "日本語の勉強を\nしてたのよ。"},
        { "location": "564/TALK"    , "narrator": "雛", "text": "…………。"},
        { "location": "565/TALK"    , "narrator": "ガブリエラ", "text": "な、何よ、その目は？"},
        { "location": "566/TALK"    , "narrator": "雛", "text": "ガブリエラちゃん、\n勉強必要ないくらい\nペラペラじゃん。"},
        { "location": "569/TALK"    , "narrator": "ガブリエラ", "text": "っ！？　ま、まあ、\n日常的な会話はね。"},
        { "location": "570/TALK"    , "narrator": "ガブリエラ", "text": "けど、日本語って\n奥深いから――"},
        { "location": "571/TALK"    , "narrator": "ガブリエラ", "text": "まだまだ勉強して、\n色々学んでる最中\nなのよ。"},
        { "location": "572/TALK"    , "narrator": "雛", "text": "ふーん…。"},
        { "location": "575/TALK"    , "narrator": "ガブリエラ", "text": "…納得してくれた\nかしら？"},
        { "location": "577/TALK"    , "narrator": "雛", "text": "…そういえばさ。"},
        { "location": "578/TALK"    , "narrator": "雛", "text": "語学の習得には、\nその言葉が母語の\n恋人を作るといい――"},
        { "location": "579/TALK"    , "narrator": "雛", "text": "って言うよね？"},
        { "location": "581/TALK"    , "narrator": "ガブリエラ", "text": "何それ？"},
        { "location": "583/TALK"    , "narrator": "雛", "text": "ガブリエラちゃんはさ、\n日本語をもっと知りたい\nなら――"},
        { "location": "584/TALK"    , "narrator": "雛", "text": "絶対恋人は日本人に\nするべきだよ！"},
        { "location": "586/TALK"    , "narrator": "ガブリエラ", "text": "何でそうやって、\n他人に恋人を作らせ\nたがるのよ…。"},
        { "location": "588/ACT"     , "narrator": "", "text": "ハッキング"},
        { "location": "602/TALK"    , "narrator": "ガブリエラ", "text": "$handle$、あんたセンスなさ過ぎだわ"},
        { "location": "603/TALK"    , "narrator": "ガブリエラ", "text": "もう、私が考えるからいいわ"},
        { "location": "615/TALK"    , "narrator": "ガブリエラ", "text": "…まあ、特に大した\nことはしてないわ。"},
        { "location": "616/TALK"    , "narrator": "ガブリエラ", "text": "ネット検索とか、\nゲームとか電子書籍\nとか――"},
        { "location": "617/TALK"    , "narrator": "ガブリエラ", "text": "ぶっちゃけ、ただの\n暇つぶしね。"},
        { "location": "618/TALK"    , "narrator": "雛", "text": "そっか…。"},
        { "location": "620/TALK"    , "narrator": "ガブリエラ", "text": "どう、納得した？"},
        { "location": "621/TALK"    , "narrator": "雛", "text": "うん、完璧！"},
        { "location": "623/TALK"    , "narrator": "雛", "text": "ガブリエラちゃんは、\nすぐに彼氏を作るべき\nだね！"},
        { "location": "624/TALK"    , "narrator": "ガブリエラ", "text": "何で今の話の流れから\nそうなるのよ！？"},
        { "location": "625/TALK"    , "narrator": "雛", "text": "だって、彼氏がいれば\n暇とかしなくてすむ\nじゃん。"},
        { "location": "626/TALK"    , "narrator": "雛", "text": "ＷＡＶＥでいつでも\n彼氏とやりとりも\nできるしー。"},
        { "location": "628/TALK"    , "narrator": "ガブリエラ", "text": "暇つぶしを理由に\n彼氏なんて作らない\nわよ！"}
    ]
}
