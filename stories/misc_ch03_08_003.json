        { "location": "219/SCENARIO", "narrator": "", "text": "009_抹茶クリームあんみつ"},
        { "location": "244/TALK"    , "narrator": "ガブリエラ", "text": "抹茶はいいのよ、抹茶はｖ"},
        { "location": "245/TALK"    , "narrator": "ガブリエラ", "text": "クリームはバニラアイスのことだって教わったわ"},
        { "location": "246/TALK"    , "narrator": "ガブリエラ", "text": "豆もちょっとポーランドの豆に似てるわｖｖｖ"},
        { "location": "247/TALK"    , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "248/TALK"    , "narrator": "ガブリエラ", "text": "半分以上を占めている寒天って何なのかしら？？？"},
        { "location": "251/SEL"     , "narrator": "", "text": "何の話？"},
        { "location": "252/ACT"     , "narrator": "", "text": "何の話？"},
        { "location": "253/TALK"    , "narrator": "ガブリエラ", "text": "ねえマルザンナ"},
        { "location": "254/TALK"    , "narrator": "ガブリエラ", "text": "マルザンナは抹茶クリームあんみつを食べたことがあるかしら？"},
        { "location": "257/SEL"     , "narrator": "", "text": "ある"},
        { "location": "258/SEL"     , "narrator": "", "text": "ない"},
        { "location": "259/SEL"     , "narrator": "", "text": "おすすめのを教えようか"},
        { "location": "260/ACT"     , "narrator": "", "text": "ある"},
        { "location": "261/TALK"    , "narrator": "ガブリエラ", "text": "そうよねｖ"},
        { "location": "262/ACT"     , "narrator": "", "text": "ない"},
        { "location": "263/TALK"    , "narrator": "ガブリエラ", "text": "甘いもの嫌いだったかしら？"},
        { "location": "264/ACT"     , "narrator": "", "text": "おすすめのを教えようか"},
        { "location": "266/TALK"    , "narrator": "ガブリエラ", "text": "ええｖ"},
        { "location": "268/TALK"    , "narrator": "ガブリエラ", "text": "今度"},
        { "location": "269/TALK"    , "narrator": "ガブリエラ", "text": "ぜひ教えてｖｖｖｖｖ"},
        { "location": "271/TALK"    , "narrator": "ガブリエラ", "text": "ところでね"},
        { "location": "272/TALK"    , "narrator": "ガブリエラ", "text": "あんみつの中に入っている寒天って知っていて？"},
        { "location": "274/SEL"     , "narrator": "", "text": "当然"},
        { "location": "275/SEL"     , "narrator": "", "text": "食べていいものだよ"},
        { "location": "276/SEL"     , "narrator": "", "text": "あれは…その…なんていうか…"},
        { "location": "277/ACT"     , "narrator": "", "text": "当然"},
        { "location": "278/TALK"    , "narrator": "ガブリエラ", "text": "んーとね"},
        { "location": "281/ACT"     , "narrator": "", "text": "食べていいものだよ"},
        { "location": "282/TALK"    , "narrator": "ガブリエラ", "text": "そのくらいは知っていてよ？"},
        { "location": "283/ACT"     , "narrator": "", "text": "あれは…その…なんていうか…"},
        { "location": "284/TALK"    , "narrator": "ガブリエラ", "text": "ええと・・・"},
        { "location": "285/TALK"    , "narrator": "ガブリエラ", "text": "聞かない方がいいことなのかしら・・・？"},
        { "location": "287/TALK"    , "narrator": "ガブリエラ", "text": "あれって味もないし、歯ごたえもないでしょう？"},
        { "location": "288/TALK"    , "narrator": "ガブリエラ", "text": "それなのになんであんなにいっぱい入っているのかしら？"},
        { "location": "290/SEL"     , "narrator": "", "text": "さあ…？"},
        { "location": "291/SEL"     , "narrator": "", "text": "原価率の関係"},
        { "location": "292/SEL"     , "narrator": "", "text": "ガブは日本情緒を知りたいんだよね"},
        { "location": "293/ACT"     , "narrator": "", "text": "さあ…？"},
        { "location": "294/TALK"    , "narrator": "ガブリエラ", "text": "知らないのね・・・"},
        { "location": "295/TALK"    , "narrator": "ガブリエラ", "text": "そう、わかったわ"},
        { "location": "296/ACT"     , "narrator": "", "text": "原価率の関係"},
        { "location": "298/TALK"    , "narrator": "ガブリエラ", "text": "そういうことなの・・・？"},
        { "location": "301/TALK"    , "narrator": "ガブリエラ", "text": "知りたくなかったわ・・・"},
        { "location": "302/ACT"     , "narrator": "", "text": "ガブは日本情緒を知りたいんだよね"},
        { "location": "304/TALK"    , "narrator": "ガブリエラ", "text": "もちろんよｖｖｖ"},
        { "location": "305/TALK"    , "narrator": "ガブリエラ", "text": "そのために日本にきたんだから////////"},
        { "location": "307/SEL"     , "narrator": "", "text": "最初はあの寒天がメインだったんだ"},
        { "location": "308/ACT"     , "narrator": "", "text": "最初はあの寒天がメインだったんだ"},
        { "location": "309/TALK"    , "narrator": "ガブリエラ", "text": "そうなの？"},
        { "location": "312/SEL"     , "narrator": "", "text": "冷たいのど越しを楽しむもの"},
        { "location": "313/ACT"     , "narrator": "", "text": "冷たいのど越しを楽しむもの"},
        { "location": "314/TALK"    , "narrator": "ガブリエラ", "text": "スイーツだから冷たいんじゃないのかしら？"},
        { "location": "317/SEL"     , "narrator": "", "text": "夏を涼しく過ごすための冷たさなんだよ"},
        { "location": "318/ACT"     , "narrator": "", "text": "夏を涼しく過ごすための冷たさなんだよ"},
        { "location": "319/TALK"    , "narrator": "ガブリエラ", "text": "そうだったのね・・・"},
        { "location": "320/TALK"    , "narrator": "ガブリエラ", "text": "実は寒天が一番大事だったのね"},
        { "location": "322/TALK"    , "narrator": "ガブリエラ", "text": "納得したわｖｖｖｖ"}
