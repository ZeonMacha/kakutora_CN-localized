{
    "dir": "chap17/daydra/anime_05_17.js",
    "type": "MainStory",
    "info": {
        "story_id": "17501",
        "cid": "kagura",
        "title": "001 アニメーション",
        "sub_title": "電脳仕事人"
    },
    "entry":
    [
        { "location": "264/SCENARIO", "narrator": "", "text": "アニメ第17話"},
        { "location": "277/TALK"    , "narrator": "千羽鶴", "text": "ごきげんよう、\n$handle$。"},
        { "location": "278/TALK"    , "narrator": "千羽鶴", "text": "もう一度\n私との会話を\n再現する？"},
        { "location": "279/SEL"     , "narrator": "", "text": "はい"},
        { "location": "280/SEL"     , "narrator": "", "text": "いいえ"},
        { "location": "281/ACT"     , "narrator": "", "text": "はい"},
        { "location": "282/TALK"    , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "284/ACT"     , "narrator": "", "text": "いいえ"},
        { "location": "285/TALK"    , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "293/TALK"    , "narrator": "千羽鶴", "text": "<size=40>ごめん！</size>"},
        { "location": "294/SEL"     , "narrator": "", "text": "どうしたの！？"},
        { "location": "295/SEL"     , "narrator": "", "text": "ちゅうで許す！"},
        { "location": "296/ACT"     , "narrator": "", "text": "どうしたの！？"},
        { "location": "297/ACT"     , "narrator": "", "text": "ちゅうで許す！"},
        { "location": "312/TALK"    , "narrator": "千羽鶴", "text": "…っ！！"},
        { "location": "313/TALK"    , "narrator": "千羽鶴", "text": "よし！\n許された！"},
        { "location": "316/TALK"    , "narrator": "千羽鶴", "text": "…っ！！"},
        { "location": "317/TALK"    , "narrator": "千羽鶴", "text": "よし！\n許された！"},
        { "location": "326/TALK"    , "narrator": "千羽鶴", "text": "やっぱナシ。"},
        { "location": "329/TALK"    , "narrator": "千羽鶴", "text": "調子にノリ夫！"},
        { "location": "332/TALK"    , "narrator": "千羽鶴", "text": "ちーは１つ\n間違えていた。"},
        { "location": "333/TALK"    , "narrator": "千羽鶴", "text": "前に、次々回から\n本気出す、と私は\n貴方に言った。"},
        { "location": "334/TALK"    , "narrator": "千羽鶴", "text": "そして今回がその\n「次々回」に当たる\nわけだけど――"},
        { "location": "337/TALK"    , "narrator": "千羽鶴", "text": "本気出すのは\n次回からだった！"},
        { "location": "338/SEL"     , "narrator": "", "text": "エー"},
        { "location": "339/SEL"     , "narrator": "", "text": "じゃあ今回も遊ぼう"},
        { "location": "340/SEL"     , "narrator": "", "text": "またドヤ顔してる…"},
        { "location": "341/ACT"     , "narrator": "", "text": "エー"},
        { "location": "343/TALK"    , "narrator": "千羽鶴", "text": "ちーだって\n生き物だから\nたまには間違える。"},
        { "location": "345/ACT"     , "narrator": "", "text": "じゃあ今回も遊ぼう"},
        { "location": "346/TALK"    , "narrator": "千羽鶴", "text": "んー……。"},
        { "location": "347/TALK"    , "narrator": "千羽鶴", "text": "わりと良い考えかも\nしれないとは思う。"},
        { "location": "348/ACT"     , "narrator": "", "text": "またドヤ顔してる…"},
        { "location": "349/TALK"    , "narrator": "千羽鶴", "text": "ドヤ顔しないちーは\nちーに非ず！"},
        { "location": "350/SEL"     , "narrator": "", "text": "かわったねー"},
        { "location": "351/SEL"     , "narrator": "", "text": "かわらないねー"},
        { "location": "352/ACT"     , "narrator": "", "text": "かわったねー"},
        { "location": "353/ACT"     , "narrator": "", "text": "かわらないねー"},
        { "location": "355/TALK"    , "narrator": "千羽鶴", "text": "黙れ。"},
        { "location": "357/TALK"    , "narrator": "千羽鶴", "text": "というわけで。"},
        { "location": "358/TALK"    , "narrator": "千羽鶴", "text": "今日は何の日？\n覚えていたら貴方は\n千羽鶴マスター。"},
        { "location": "359/TALK"    , "narrator": "千羽鶴", "text": "そう、今日はあの\n悪名高きクソゲー――"},
        { "location": "360/TALK"    , "narrator": "千羽鶴", "text": "ちーちゃんと\nラブラブRPGゲームの\nリリース日。"},
        { "location": "361/TALK"    , "narrator": "千羽鶴", "text": "ああっ。\nついに一周まわって\nあの日に戻って来たのね。"},
        { "location": "362/TALK"    , "narrator": "千羽鶴", "text": "というわけで！"},
        { "location": "363/TALK"    , "narrator": "千羽鶴", "text": "せっかくなので、\nクソゲーリリース回\n周回記念として――"},
        { "location": "364/TALK"    , "narrator": "千羽鶴", "text": "ディレクターズコメントを\n作ってみた！"},
        { "location": "365/SEL"     , "narrator": "", "text": "なにそれｗｗ"},
        { "location": "366/ACT"     , "narrator": "", "text": "なにそれｗｗ"},
        { "location": "368/TALK"    , "narrator": "千羽鶴", "text": "例のRPGマップを使い、\nそのポイントごとに\nちーがコメントしていく。"},
        { "location": "371/TALK"    , "narrator": "千羽鶴", "text": "前代未聞の\nRPGゲーム本編を使った\nゲームコメンタリー！"},
        { "location": "372/SEL"     , "narrator": "", "text": "見たい！！"},
        { "location": "373/SEL"     , "narrator": "", "text": "遠慮します"},
        { "location": "374/ACT"     , "narrator": "", "text": "見たい！！"},
        { "location": "375/TALK"    , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "381/ACT"     , "narrator": "", "text": "遠慮します"},
        { "location": "382/TALK"    , "narrator": "千羽鶴", "text": "……。"},
        { "location": "386/SEL"     , "narrator": "", "text": "映像を見る\n<color=green>【高画質/74MB 4:36】</color>"},
        { "location": "387/SEL"     , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/24MB 4:36】</color>"},
        { "location": "388/SEL"     , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "389/ACT"     , "narrator": "", "text": "映像を見る\n<color=green>【高画質/74MB 4:36】</color>"},
        { "location": "390/TALK"    , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "396/ACT"     , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/24MB 4:36】</color>"},
        { "location": "397/TALK"    , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "403/ACT"     , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "404/TALK"    , "narrator": "千羽鶴", "text": "そう……。"},
        { "location": "437/TALK"    , "narrator": "千羽鶴", "text": "ところで。"},
        { "location": "438/TALK"    , "narrator": "千羽鶴", "text": "エリカは信頼できる？"},
        { "location": "439/TALK"    , "narrator": "千羽鶴", "text": "現時点での気持ちとして。"},
        { "location": "440/SEL"     , "narrator": "", "text": "できる"},
        { "location": "441/SEL"     , "narrator": "", "text": "できない"},
        { "location": "442/ACT"     , "narrator": "", "text": "できる"},
        { "location": "445/TALK"    , "narrator": "千羽鶴", "text": "よかった。"},
        { "location": "446/ACT"     , "narrator": "", "text": "できない"},
        { "location": "449/TALK"    , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "451/TALK"    , "narrator": "千羽鶴", "text": "じゃあ同じく、\n私は信頼できる？"},
        { "location": "452/SEL"     , "narrator": "", "text": "できる"},
        { "location": "453/SEL"     , "narrator": "", "text": "できない"},
        { "location": "454/ACT"     , "narrator": "", "text": "できる"},
        { "location": "457/TALK"    , "narrator": "千羽鶴", "text": "よかった。"},
        { "location": "458/ACT"     , "narrator": "", "text": "できない"},
        { "location": "461/TALK"    , "narrator": "千羽鶴", "text": "そう…。"},
        { "location": "467/TALK"    , "narrator": "千羽鶴", "text": "ここからのリプレイスは\n信頼こそが命。"},
        { "location": "468/TALK"    , "narrator": "千羽鶴", "text": "貴方が私やエリカを\n信頼してくれているのは\n本当に心強い。"},
        { "location": "469/TALK"    , "narrator": "千羽鶴", "text": "そして、それは\n成功に向けて\nとても重要なこと。"},
        { "location": "470/TALK"    , "narrator": "千羽鶴", "text": "私もエリカも、\n常軌を逸したヘンな子だし\n理解不能だと思うのに――"},
        { "location": "471/TALK"    , "narrator": "千羽鶴", "text": "そんな二人を\n信頼してくれて\n本当にありがとう。"},
        { "location": "475/TALK"    , "narrator": "千羽鶴", "text": "貴方がエリカを\n信頼できない事については\n私にも責任がある。"},
        { "location": "476/SEL"     , "narrator": "", "text": "千羽鶴は悪くないよ"},
        { "location": "477/SEL"     , "narrator": "", "text": "千羽鶴は優しいね"},
        { "location": "478/SEL"     , "narrator": "", "text": "確かに連帯責任だと思う"},
        { "location": "479/ACT"     , "narrator": "", "text": "千羽鶴は悪くないよ"},
        { "location": "480/TALK"    , "narrator": "千羽鶴", "text": "貴方は優しいのね。"},
        { "location": "481/TALK"    , "narrator": "千羽鶴", "text": "けれども、私の結論は\n決して感情的なものでは\nなく、理屈の上にある。"},
        { "location": "482/ACT"     , "narrator": "", "text": "千羽鶴は優しいね"},
        { "location": "483/TALK"    , "narrator": "千羽鶴", "text": "私は単に、可能な限り\n第三者的視点から感情\n抜きで判断してるだけ。"},
        { "location": "484/ACT"     , "narrator": "", "text": "確かに連帯責任だと思う"},
        { "location": "485/TALK"    , "narrator": "千羽鶴", "text": "そう。その通り。\n貴方には、物事を冷静に\n見る力があると思う。"},
        { "location": "487/TALK"    , "narrator": "千羽鶴", "text": "私がどうしてそう思うのか\n説明しておこうと思う。"},
        { "location": "488/TALK"    , "narrator": "千羽鶴", "text": "彼女が今の行動を\n起こしていることに\nついては――"},
        { "location": "489/TALK"    , "narrator": "千羽鶴", "text": "その動機の殆どは、\n私の行動に紐付いてる。"},
        { "location": "490/TALK"    , "narrator": "千羽鶴", "text": "人の出逢いと繋がりは、\n巡り合わせによって\n敵にも味方にもなる。"},
        { "location": "491/TALK"    , "narrator": "千羽鶴", "text": "もし私とエリカが\n一度も袂を分かつこと無く\n共同戦線を張っていたら。"},
        { "location": "492/TALK"    , "narrator": "千羽鶴", "text": "貴方はエリカを\n信頼していた\n可能性もある。"},
        { "location": "493/TALK"    , "narrator": "千羽鶴", "text": "そのこともまた、\nちょっと考えてみると\nいいかもしれない。"},
        { "location": "494/SEL"     , "narrator": "", "text": "確かにそれはあるよね"},
        { "location": "495/SEL"     , "narrator": "", "text": "単にエリカの性格の問題だよ"},
        { "location": "496/ACT"     , "narrator": "", "text": "確かにそれはあるよね"},
        { "location": "498/TALK"    , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "499/ACT"     , "narrator": "", "text": "単にエリカの性格の問題だよ"},
        { "location": "501/TALK"    , "narrator": "千羽鶴", "text": "なるほど。"},
        { "location": "502/TALK"    , "narrator": "千羽鶴", "text": "そこまで貴方が、\n自分の中で原因をわかって\nいるならそれでいい。"},
        { "location": "503/TALK"    , "narrator": "千羽鶴", "text": "ただ、そうなると――"},
        { "location": "504/TALK"    , "narrator": "千羽鶴", "text": "仕事として割り切って\nもらうか、何とかして\n気持ちを切り替えるか。"},
        { "location": "505/TALK"    , "narrator": "千羽鶴", "text": "貴方は、自分の気持ちを\nいずれかで整理する\n必要がある。"},
        { "location": "506/TALK"    , "narrator": "千羽鶴", "text": "もちろん、やめるという\n選択肢もある。\n私は望まないけど。"},
        { "location": "510/TALK"    , "narrator": "千羽鶴", "text": "私が貴方に\n信頼されないのは、\n仕方ないことだと思う。"},
        { "location": "511/TALK"    , "narrator": "千羽鶴", "text": "客観的に見て、私は\n貴方にとって不利益になる\nことをしてきたと思う。"},
        { "location": "512/TALK"    , "narrator": "千羽鶴", "text": "一度書き込まれた事実を\n消すことはできない。"},
        { "location": "513/TALK"    , "narrator": "千羽鶴", "text": "そして、私自身は今でも、\nリプレイス前の行動は\n間違ってたとは思わない。"},
        { "location": "514/TALK"    , "narrator": "千羽鶴", "text": "その理由は、あの時の\n情報と制限時間等から、\n最大限考えた結果であり。"},
        { "location": "515/TALK"    , "narrator": "千羽鶴", "text": "それは何度やっても、\n大枠としては変わらないと\n今でも思っているから。"},
        { "location": "516/SEL"     , "narrator": "", "text": "わかってるから$me$も割り切ってるし、信頼してないけど最後まで協力はする"},
        { "location": "517/SEL"     , "narrator": "", "text": "そういうとこですよ、反省して"},
        { "location": "518/SEL"     , "narrator": "", "text": "そういう部分じゃなくて、むしろやり方とか性格の問題"},
        { "location": "519/ACT"     , "narrator": "", "text": "わかってるから$me$も割り切ってるし、信頼してないけど最後まで協力はする"},
        { "location": "521/TALK"    , "narrator": "千羽鶴", "text": "ありがと。\nそうしてもらえると\n助かる。"},
        { "location": "522/ACT"     , "narrator": "", "text": "そういうとこですよ、反省して"},
        { "location": "524/TALK"    , "narrator": "千羽鶴", "text": "反省しているか否かと、\n信頼できるか否かは、\n厳密には軸が違う。"},
        { "location": "525/TALK"    , "narrator": "千羽鶴", "text": "私は貴方や彼女たちに\n不快な気持ちや苦痛を\n与えたという自覚はある。"},
        { "location": "526/TALK"    , "narrator": "千羽鶴", "text": "だから、その点については\n本当に申し訳ないと\n思ってはいるけど――"},
        { "location": "527/TALK"    , "narrator": "千羽鶴", "text": "だからといって、今までの\n行動が間違っていた、と\n私が言うことは絶対ない。"},
        { "location": "528/TALK"    , "narrator": "千羽鶴", "text": "なぜなら、それは嘘で\nあり、それこそ誠実さに\n欠ける行為だから。"},
        { "location": "529/TALK"    , "narrator": "千羽鶴", "text": "私は、そういう人こそ\n信頼できない人だと\n思っている。"},
        { "location": "530/ACT"     , "narrator": "", "text": "そういう部分じゃなくて、むしろやり方とか性格の問題"},
        { "location": "532/TALK"    , "narrator": "千羽鶴", "text": "それは信頼の問題と\nいうよりも、好みの問題？"},
        { "location": "533/TALK"    , "narrator": "千羽鶴", "text": "もちろん、人と人との\n関係には、好き嫌いは\n相当に影響する。"},
        { "location": "534/TALK"    , "narrator": "千羽鶴", "text": "だから、そのことを\n信頼出来るか否かと\n混同するのもわかる。"},
        { "location": "535/TALK"    , "narrator": "千羽鶴", "text": "仕事をしていても、\n学校に通っていても――"},
        { "location": "536/TALK"    , "narrator": "千羽鶴", "text": "信頼は出来るけど\n嫌いな上司、先生。"},
        { "location": "537/TALK"    , "narrator": "千羽鶴", "text": "信頼はできないけど、\n好きな上司、先生。"},
        { "location": "538/TALK"    , "narrator": "千羽鶴", "text": "そういう人も\nいると思う。"},
        { "location": "539/TALK"    , "narrator": "千羽鶴", "text": "ちょっと思い返してみて\n整理してみると\nいいかもしれない。"},
        { "location": "543/TALK"    , "narrator": "千羽鶴", "text": "ならば貴方は、\nどんな信念に基づいて\n私やエリカと対話してる？"},
        { "location": "544/SEL"     , "narrator": "", "text": "貴方たちをコロシテでも$me$の大切な彼女を幸せにしたいから今は従ってる"},
        { "location": "545/SEL"     , "narrator": "", "text": "基本的には千羽鶴は信頼してるけど、エリカを信頼する千羽鶴は信頼できない"},
        { "location": "546/SEL"     , "narrator": "", "text": "基本的にはエリカは信頼してるけど、千羽鶴に協力するエリカには失望してる"},
        { "location": "547/ACT"     , "narrator": "", "text": "貴方たちをコロシテでも$me$の大切な彼女を幸せにしたいから今は従ってる"},
        { "location": "549/TALK"    , "narrator": "千羽鶴", "text": "そう、わかった。\nとてもいい答え。"},
        { "location": "550/TALK"    , "narrator": "千羽鶴", "text": "私は今回の計画について、\n私とエリカ、貴方の信頼\n関係が重要だと考える。"},
        { "location": "551/TALK"    , "narrator": "千羽鶴", "text": "けれども、貴方がそれ\n以上の想いで大切な彼女を\n守る意志があるなら――"},
        { "location": "552/TALK"    , "narrator": "千羽鶴", "text": "それはそれで、\nもう１つの成功への\n道なのかもしれない。"},
        { "location": "553/TALK"    , "narrator": "千羽鶴", "text": "成功への道筋は、\n想いの力が握ってる。"},
        { "location": "554/TALK"    , "narrator": "千羽鶴", "text": "例えその想いが\n水と油のように相反する\nものであっても――"},
        { "location": "555/TALK"    , "narrator": "千羽鶴", "text": "その力が同じ方向を\n向いているのなら、それは\n成功する可能性に繋がる。"},
        { "location": "556/TALK"    , "narrator": "千羽鶴", "text": "私としては、\nそれならそれでも\n構わないと思ってる。"},
        { "location": "557/ACT"     , "narrator": "", "text": "基本的には千羽鶴は信頼してるけど、エリカを信頼する千羽鶴は信頼できない"},
        { "location": "559/TALK"    , "narrator": "千羽鶴", "text": "なるほど。"},
        { "location": "561/ACT"     , "narrator": "", "text": "基本的にはエリカは信頼してるけど、千羽鶴に協力するエリカには失望してる"},
        { "location": "563/TALK"    , "narrator": "千羽鶴", "text": "なるほど。"},
        { "location": "569/TALK"    , "narrator": "千羽鶴", "text": "いずれにせよ、貴方は\n自分の真摯な気持ちを\n正直に言ってくれた。"},
        { "location": "570/TALK"    , "narrator": "千羽鶴", "text": "感謝すると共に、\n真摯に受けとめたいと\n思う。"},
        { "location": "571/TALK"    , "narrator": "千羽鶴", "text": "けれども、最終的に\nこの計画は――"},
        { "location": "572/TALK"    , "narrator": "千羽鶴", "text": "私とエリカ、そして貴方が\n三位一体となって、初めて\n成果が出ると思ってる。"},
        { "location": "573/TALK"    , "narrator": "千羽鶴", "text": "だから、貴方が彼女を\n信頼出来ないというなら―"},
        { "location": "574/TALK"    , "narrator": "千羽鶴", "text": "その原因を見つけ出して\n潰していかねばならない。"},
        { "location": "575/TALK"    , "narrator": "千羽鶴", "text": "今回は、私の方から\n『無理ならやめていい』\nとは言いたくない。"},
        { "location": "576/TALK"    , "narrator": "千羽鶴", "text": "もちろん貴方が限界を感じ\nやめていくのは自由だし、\nそれを尊重するけど――"},
        { "location": "577/TALK"    , "narrator": "千羽鶴", "text": "私はそれを解決すべく、\n動いていこうと思ってる。"},
        { "location": "579/TALK"    , "narrator": "千羽鶴", "text": "わかってると思うけど、\n今回の作戦に正解はない。"},
        { "location": "580/TALK"    , "narrator": "千羽鶴", "text": "ゲームみたいに、\nトゥルーエンドが予め\n用意されてるわけもない。"},
        { "location": "581/TALK"    , "narrator": "千羽鶴", "text": "だからこそ、私も、\n貴方も、そしてエリカも。"},
        { "location": "582/TALK"    , "narrator": "千羽鶴", "text": "最大にして唯一の大切な\n事項は、自分が自分を\n最後まで信じられたか。"},
        { "location": "583/TALK"    , "narrator": "千羽鶴", "text": "そして、どんな結果に\nなったとしても、自分が\nやり切ったと思えるか。"},
        { "location": "584/TALK"    , "narrator": "千羽鶴", "text": "大切なものが何かを、\n選択するとき、常にそれを\n忘れずにしてきたか。"},
        { "location": "585/TALK"    , "narrator": "千羽鶴", "text": "それこそが、\n作戦を遂行する上で、\n最も大切なことだと思う。"},
        { "location": "587/TALK"    , "narrator": "千羽鶴", "text": "今回はちょっと真面目で\n重い話になったけど、\n大事な事なのでお話した。"},
        { "location": "588/SEL"     , "narrator": "", "text": "いい話だったよ"},
        { "location": "589/SEL"     , "narrator": "", "text": "退屈だった"},
        { "location": "590/ACT"     , "narrator": "", "text": "いい話だったよ"},
        { "location": "591/TALK"    , "narrator": "千羽鶴", "text": "よかった。"},
        { "location": "592/ACT"     , "narrator": "", "text": "退屈だった"},
        { "location": "593/TALK"    , "narrator": "千羽鶴", "text": "それは残念。"},
        { "location": "595/TALK"    , "narrator": "千羽鶴", "text": "次回から、本格的に\nリプレイス作戦が\n開始される。"},
        { "location": "596/TALK"    , "narrator": "千羽鶴", "text": "それまでに、貴方は\n貴方自身の関わり方を\n決めておくといいかも。"},
        { "location": "597/TALK"    , "narrator": "千羽鶴", "text": "それじゃ、\n今回はこの辺で。"},
        { "location": "598/TALK"    , "narrator": "千羽鶴", "text": "今回も、卯月神楽と\n過去の私のサポートを\nどうかよろしく。"},
