        "title": "005 メインストーリー",
        "sub_title": "クリエイターズハイ＜後編＞"
    },
    "entry":
    [
        { "location": "919/TALK"   , "narrator": "神楽", "text": "…ううっ。"},
        { "location": "920/TALK"   , "narrator": "神楽", "text": "やっぱり、入ろう。\n一日の疲れは寝る前に\n落としておきたいし。"},
        { "location": "941/TALK"   , "narrator": "神楽", "text": "ふぅ…サッパリしたぁ。"},
        { "location": "943/TALK"   , "narrator": "神楽", "text": "眠いの我慢して、\n思い切って入ってきて\n正解だったみたい。"},
        { "location": "944/TALK"   , "narrator": "神楽", "text": "…さて、と。"},
        { "location": "956/TALK"   , "narrator": "神楽", "text": "先ほどは大変お見苦しい姿を見せたようで"},
        { "location": "957/TALK"   , "narrator": "神楽", "text": "忘れていただけると嬉しいです"},
        { "location": "960/SEL"    , "narrator": "", "text": "深夜テンションのこと？"},
        { "location": "961/SEL"    , "narrator": "", "text": "なんのことだかさっぱり"},
        { "location": "962/ACT"    , "narrator": "", "text": "深夜テンションのこと？"},
        { "location": "963/TALK"   , "narrator": "神楽", "text": "どうか忘れてくださいお願いします"},
        { "location": "965/ACT"    , "narrator": "", "text": "なんのことだかさっぱり"},
        { "location": "966/TALK"   , "narrator": "神楽", "text": "それならいいんです"},
        { "location": "967/TALK"   , "narrator": "神楽", "text": "どうか気にしないで下さい"},
        { "location": "969/TALK"   , "narrator": "神楽", "text": "とりあえず"},
        { "location": "970/TALK"   , "narrator": "神楽", "text": "メノウのお仕事の方は一段落付いて"},
        { "location": "971/TALK"   , "narrator": "神楽", "text": "お風呂も入ったし"},
        { "location": "972/TALK"   , "narrator": "神楽", "text": "とても気分がいいんです"},
        { "location": "974/SEL"    , "narrator": "", "text": "それはよかった"},
        { "location": "975/ACT"    , "narrator": "", "text": "それはよかった"},
        { "location": "977/TALK"   , "narrator": "神楽", "text": "なので"},
        { "location": "978/TALK"   , "narrator": "神楽", "text": "これから絵を描こうと思ってるんです"},
        { "location": "980/SEL"    , "narrator": "", "text": "寝るんじゃなかったの！？"},
        { "location": "981/SEL"    , "narrator": "", "text": "目が覚めちゃった？"},
        { "location": "982/ACT"    , "narrator": "", "text": "寝るんじゃなかったの！？"},
        { "location": "983/TALK"   , "narrator": "神楽", "text": "そう思ってたんですが"},
        { "location": "984/TALK"   , "narrator": "神楽", "text": "お風呂入ったら目が覚めちゃって"},
        { "location": "985/ACT"    , "narrator": "", "text": "目が覚めちゃった？"},
        { "location": "987/TALK"   , "narrator": "神楽", "text": "さすが$handle$さん"},
        { "location": "988/TALK"   , "narrator": "神楽", "text": "理解が早くて助かります"},
        { "location": "990/TALK"   , "narrator": "神楽", "text": "それに歌詞を書いたんだから"},
        { "location": "991/TALK"   , "narrator": "神楽", "text": "次は絵を描く"},
        { "location": "992/TALK"   , "narrator": "神楽", "text": "これって当然じゃないですか？"},
        { "location": "993/TALK"   , "narrator": "神楽", "text": "私は普通だと思いますよ！"},
        { "location": "996/SEL"    , "narrator": "", "text": "落ち着いて、寝ようよ"},
        { "location": "997/SEL"    , "narrator": "", "text": "いいね、力作待ってるよ！"},
        { "location": "998/ACT"    , "narrator": "", "text": "落ち着いて、寝ようよ"},
        { "location": "1000/TALK"  , "narrator": "神楽", "text": "そうですね"},
        { "location": "1001/TALK"  , "narrator": "神楽", "text": "また恥ずかしいところをお見せしてしまったようで"},
        { "location": "1003/TALK"  , "narrator": "神楽", "text": "大人しく寝ることにします"},
        { "location": "1004/TALK"  , "narrator": "神楽", "text": "遅くまでありがとうございました"},
        { "location": "1005/TALK"  , "narrator": "神楽", "text": "おやすみなさい"},
        { "location": "1017/TALK"  , "narrator": "神楽", "text": "ふぁ～…、言ってたら\n本当に眠くなってきた…。"},
        { "location": "1018/TALK"  , "narrator": "神楽", "text": "早く寝よう…。"},
        { "location": "1022/TALK"  , "narrator": "透明神楽", "text": "…なにか、忘れてるような\n気もするけど。"},
        { "location": "1027/TALK"  , "narrator": "透明神楽", "text": "う、うぅ～ん…。"},
        { "location": "1028/TALK"  , "narrator": "透明神楽", "text": "ふぁ～…、\nこんな早くに…誰？"},
        { "location": "1041/TALK"  , "narrator": "神楽", "text": "はい、もしもし卯月です。"},
        { "location": "1042/TALK"  , "narrator": "神楽", "text": "…ああ、どうも。\nお疲れ様です。"},
        { "location": "1043/TALK"  , "narrator": "神楽", "text": "送った歌詞の方は…はい？"},
        { "location": "1045/TALK"  , "narrator": "神楽", "text": "あっ！！！！"},
        { "location": "1047/TALK"  , "narrator": "神楽", "text": "ま、まさか！\n忘れてなんかいませんよ。"},
        { "location": "1048/TALK"  , "narrator": "神楽", "text": "今、サビのフレーズで\nちょっと悩んでた\nだけでして…。"},
        { "location": "1049/TALK"  , "narrator": "神楽", "text": "は、はい、大丈夫です！\nはい、失礼します！！"},
        { "location": "1054/TALK"  , "narrator": "神楽", "text": "…ど、どうしよう。\nとんでもない\nミスしちゃったかも…。"},
        { "location": "1067/SEL"   , "narrator": "", "text": "どうかしたの？"},
        { "location": "1068/ACT"   , "narrator": "", "text": "どうかしたの？"},
        { "location": "1085/TALK"  , "narrator": "神楽", "text": "うっかりです"},
        { "location": "1086/TALK"  , "narrator": "神楽", "text": "作詞をしなければいけない曲が"},
        { "location": "1087/TALK"  , "narrator": "神楽", "text": "もう一つあったことをすっかり忘れてて"},
        { "location": "1091/TALK"  , "narrator": "神楽", "text": "とにかく"},
        { "location": "1092/TALK"  , "narrator": "神楽", "text": "やれるところまでは急いでやらないと"},
        { "location": "1093/TALK"  , "narrator": "神楽", "text": "色んな人に迷惑かけちゃいますし"},
        { "location": "1096/SEL"   , "narrator": "", "text": "神楽ならできる！！"},
        { "location": "1097/SEL"   , "narrator": "", "text": "メノウって、大変だね"},
        { "location": "1098/ACT"   , "narrator": "", "text": "神楽ならできる！！"},
        { "location": "1099/TALK"  , "narrator": "神楽", "text": "ありがとうございます"},
        { "location": "1100/TALK"  , "narrator": "神楽", "text": "それじゃあまたあとで！"},
        { "location": "1101/ACT"   , "narrator": "", "text": "メノウって、大変だね"},
        { "location": "1102/TALK"  , "narrator": "神楽", "text": "大変ですよー"},
        { "location": "1104/TALK"  , "narrator": "神楽", "text": "でも"},
        { "location": "1105/TALK"  , "narrator": "神楽", "text": "とっても楽しいお仕事なんです"},
        { "location": "1118/TALK"  , "narrator": "神楽", "text": "ふぅ…悩んでても\n仕方ないし…。"},
        { "location": "1119/TALK"  , "narrator": "神楽", "text": "早くやっちゃわないと！"},
        { "location": "1120/ACT"   , "narrator": "", "text": "いいね、力作待ってるよ！"},
        { "location": "1122/TALK"  , "narrator": "神楽", "text": "任せてください！"},
        { "location": "1123/TALK"  , "narrator": "神楽", "text": "カラー絵描いちゃいますから！！"},
        { "location": "1134/TALK"  , "narrator": "神楽", "text": "…よーし、\nすごいの描いてみせるん\nだから！！"},
        { "location": "1152/TALK"  , "narrator": "神楽", "text": "ふぁ～…。"},
        { "location": "1153/TALK"  , "narrator": "神楽", "text": "空が明るくなってきた…。\nさすがに、そろそろ\n限界ね…。"},
        { "location": "1154/TALK"  , "narrator": "神楽", "text": "結局、半分くらいしか\n描けなかったけど…。"},
        { "location": "1155/TALK"  , "narrator": "神楽", "text": "まあ、残りは今夜にでも\n描けば――"},
        { "location": "1159/TALK"  , "narrator": "神楽", "text": "もぉ、こんな早くに\n誰かしら…？"},
        { "location": "1174/TALK"  , "narrator": "神楽", "text": "はい、もしもし卯月です。"},
        { "location": "1175/TALK"  , "narrator": "神楽", "text": "…ああ、どうも。\nお疲れ様です。"},
        { "location": "1176/TALK"  , "narrator": "神楽", "text": "送った歌詞の方は…はい？"},
        { "location": "1178/TALK"  , "narrator": "神楽", "text": "あっ！！！！"},
        { "location": "1179/TALK"  , "narrator": "神楽", "text": "ま、まさか！\n忘れてなんかいませんよ。"},
        { "location": "1180/TALK"  , "narrator": "神楽", "text": "今、サビのフレーズで\nちょっと悩んでた\nだけでして…。"},
        { "location": "1181/TALK"  , "narrator": "神楽", "text": "は、はい、大丈夫です！\nはい、失礼します！！"},
        { "location": "1186/TALK"  , "narrator": "神楽", "text": "…ど、どうしよう。\nとんでもない\nミスしちゃったかも…。"},
        { "location": "1187/SEL"   , "narrator": "", "text": "どうかしたの？"},
        { "location": "1188/ACT"   , "narrator": "", "text": "どうかしたの？"},
        { "location": "1205/TALK"  , "narrator": "神楽", "text": "うっかりです"},
