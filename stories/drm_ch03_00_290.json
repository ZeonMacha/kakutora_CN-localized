    "entry":
    [
        { "location": "453/SCENARIO", "narrator": "", "text": "290_その気持ちは"},
        { "location": "478/TALK"    , "narrator": "ガブリエラ", "text": "みんな知っているのでしょうか？"},
        { "location": "479/TALK"    , "narrator": "ガブリエラ", "text": "それは夢かもしれません"},
        { "location": "480/TALK"    , "narrator": "ガブリエラ", "text": "それは消えてしまうものかもしれません"},
        { "location": "481/TALK"    , "narrator": "ガブリエラ", "text": "でも　それは確かに"},
        { "location": "482/TALK"    , "narrator": "ガブリエラ", "text": "私の中にあるのです"},
        { "location": "483/TALK"    , "narrator": "ガブリエラ", "text": "その気持ちは"},
        { "location": "485/TALK"    , "narrator": "ガブリエラ", "text": "恋"},
        { "location": "488/SEL"     , "narrator": "", "text": "日本語でお願いします"},
        { "location": "489/SEL"     , "narrator": "", "text": "いいことがあったの？"},
        { "location": "490/SEL"     , "narrator": "", "text": "$handle$のことを言ってる？"},
        { "location": "496/ACT"     , "narrator": "", "text": "日本語でお願いします"},
        { "location": "497/TALK"    , "narrator": "ガブリエラ", "text": "日本語だわよ！？"},
        { "location": "499/TALK"    , "narrator": "ガブリエラ", "text": "これでみんなに通じるんだから！"},
        { "location": "500/TALK"    , "narrator": "ガブリエラ", "text": "ヒカルくんにも"},
        { "location": "502/TALK"    , "narrator": "ガブリエラ", "text": "たぶんね"},
        { "location": "503/ACT"     , "narrator": "", "text": "いいことがあったの？"},
        { "location": "513/TALK"    , "narrator": "ガブリエラ", "text": "やだ"},
        { "location": "515/TALK"    , "narrator": "ガブリエラ", "text": "知ってるくせに////////"},
        { "location": "516/ACT"     , "narrator": "", "text": "$handle$のことを言ってる？"},
        { "location": "517/TALK"    , "narrator": "ガブリエラ", "text": "違うわよ！！"},
        { "location": "518/TALK"    , "narrator": "ガブリエラ", "text": "違うけど"},
        { "location": "520/TALK"    , "narrator": "ガブリエラ", "text": "ええと・・・"},
        { "location": "522/TALK"    , "narrator": "ガブリエラ", "text": "お礼を言わなければいけないと思っているのよ"},
        { "location": "523/TALK"    , "narrator": "ガブリエラ", "text": "貴方に"},
        { "location": "525/SEL"     , "narrator": "", "text": "なんで？"},
        { "location": "526/ACT"     , "narrator": "", "text": "なんで？"},
        { "location": "528/TALK"    , "narrator": "ガブリエラ", "text": "なんでって・・・"},
        { "location": "529/TALK"    , "narrator": "ガブリエラ", "text": "$handle$のおかげで"},
        { "location": "530/TALK"    , "narrator": "ガブリエラ", "text": "私、ヒカルくんとちゃんとお話ができたわ"},
        { "location": "532/SEL"     , "narrator": "", "text": "そうかな……"},
        { "location": "533/SEL"     , "narrator": "", "text": "そうだったね"},
        { "location": "534/ACT"     , "narrator": "", "text": "そうかな……"},
        { "location": "535/ACT"     , "narrator": "", "text": "そうだったね"},
        { "location": "537/TALK"    , "narrator": "ガブリエラ", "text": "それは"},
        { "location": "538/TALK"    , "narrator": "ガブリエラ", "text": "貴方の言う通りにしたから"},
        { "location": "539/TALK"    , "narrator": "ガブリエラ", "text": "だから"},
        { "location": "540/TALK"    , "narrator": "ガブリエラ", "text": "使用人を褒めるのも仕事のうちだから"},
        { "location": "541/TALK"    , "narrator": "ガブリエラ", "text": "その"},
        { "location": "543/TALK"    , "narrator": "ガブリエラ", "text": "ありがとう"},
        { "location": "546/SEL"     , "narrator": "", "text": "どういたしまして、姫"},
        { "location": "547/SEL"     , "narrator": "", "text": "ギャヴィは本当に可愛いね"},
        { "location": "548/SEL"     , "narrator": "", "text": "あ、はい"},
        { "location": "549/ACT"     , "narrator": "", "text": "どういたしまして、姫"},
        { "location": "559/TALK"    , "narrator": "ガブリエラ", "text": "いいお返事ねｖ"},
        { "location": "561/TALK"    , "narrator": "ガブリエラ", "text": "$handle$は素敵な人ね"},
        { "location": "562/TALK"    , "narrator": "ガブリエラ", "text": "なんてねv"},
        { "location": "563/TALK"    , "narrator": "ガブリエラ", "text": "これからもよろしくねvvvvv"},
        { "location": "565/ACT"     , "narrator": "", "text": "ギャヴィは本当に可愛いね"},
        { "location": "566/TALK"    , "narrator": "ガブリエラ", "text": "そんなの当たり前じゃない"},
        { "location": "567/TALK"    , "narrator": "ガブリエラ", "text": "でも嬉しいわv"},
        { "location": "569/ACT"     , "narrator": "", "text": "あ、はい"},
        { "location": "571/TALK"    , "narrator": "ガブリエラ", "text": "まあ！"},
        { "location": "572/TALK"    , "narrator": "ガブリエラ", "text": "そんな適当なお返事するなんて！"},
        { "location": "573/TALK"    , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "574/TALK"    , "narrator": "ガブリエラ", "text": "特別に許してあげるわ"},
        { "location": "509/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>700pt.</b></color></size>\nアップしました！"},
        { "location": "555/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>700pt.</b></color></size>\nアップしました！"}
