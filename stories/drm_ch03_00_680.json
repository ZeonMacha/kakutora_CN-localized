        { "location": "7/SCENARIO", "narrator": "", "text": "740_言葉に気持ちを乗せて"},
        { "location": "34/TALK"   , "narrator": "ガブリエラ", "text": "いるかしら？"},
        { "location": "36/SEL"    , "narrator": "", "text": "いるよ"},
        { "location": "37/SEL"    , "narrator": "", "text": "いないよ"},
        { "location": "38/SEL"    , "narrator": "", "text": "うるさいよ"},
        { "location": "39/ACT"    , "narrator": "", "text": "いるよ"},
        { "location": "41/TALK"   , "narrator": "ガブリエラ", "text": "いてくれたのね"},
        { "location": "42/TALK"   , "narrator": "ガブリエラ", "text": "よかったわｖ"},
        { "location": "43/ACT"    , "narrator": "", "text": "いないよ"},
        { "location": "44/TALK"   , "narrator": "ガブリエラ", "text": "またそんな意地悪ばっかり"},
        { "location": "45/TALK"   , "narrator": "ガブリエラ", "text": "いつもそうね"},
        { "location": "46/ACT"    , "narrator": "", "text": "うるさいよ"},
        { "location": "47/TALK"   , "narrator": "ガブリエラ", "text": "まあ！"},
        { "location": "49/TALK"   , "narrator": "ガブリエラ", "text": "ひどいわ！"},
        { "location": "52/TALK"   , "narrator": "ガブリエラ", "text": "あのね$handle$"},
        { "location": "53/TALK"   , "narrator": "ガブリエラ", "text": "私の詩がね"},
        { "location": "54/TALK"   , "narrator": "ガブリエラ", "text": "先生にほめられたの"},
        { "location": "56/SEL"    , "narrator": "", "text": "おめでとう"},
        { "location": "57/SEL"    , "narrator": "", "text": "そうだったっけ？"},
        { "location": "58/SEL"    , "narrator": "", "text": "$handle$もうれしいよ"},
        { "location": "59/ACT"    , "narrator": "", "text": "おめでとう"},
        { "location": "60/TALK"   , "narrator": "ガブリエラ", "text": "ありがとう"},
        { "location": "61/ACT"    , "narrator": "", "text": "そうだったっけ？"},
        { "location": "62/TALK"   , "narrator": "ガブリエラ", "text": "そうなのよ"},
        { "location": "63/TALK"   , "narrator": "ガブリエラ", "text": "憶えてないのかしら？"},
        { "location": "64/ACT"    , "narrator": "", "text": "$handle$もうれしいよ"},
        { "location": "74/TALK"   , "narrator": "ガブリエラ", "text": "本当かしら？"},
        { "location": "75/TALK"   , "narrator": "ガブリエラ", "text": "まあ"},
        { "location": "76/TALK"   , "narrator": "ガブリエラ", "text": "信じてあげるけど"},
        { "location": "79/TALK"   , "narrator": "ガブリエラ", "text": "それでね"},
        { "location": "81/TALK"   , "narrator": "ガブリエラ", "text": "今日の音声ファイルは"},
        { "location": "82/TALK"   , "narrator": "ガブリエラ", "text": "詩の朗読にしようと思っているのよ"},
        { "location": "83/TALK"   , "narrator": "ガブリエラ", "text": "いいかしら？"},
        { "location": "85/SEL"    , "narrator": "", "text": "いいよ"},
        { "location": "86/SEL"    , "narrator": "", "text": "愛の詩だよね"},
        { "location": "87/ACT"    , "narrator": "", "text": "いいよ"},
        { "location": "88/TALK"   , "narrator": "ガブリエラ", "text": "うん"},
        { "location": "89/TALK"   , "narrator": "ガブリエラ", "text": "ありがとう"},
        { "location": "92/ACT"    , "narrator": "", "text": "愛の詩だよね"},
        { "location": "93/TALK"   , "narrator": "ガブリエラ", "text": "また"},
        { "location": "94/TALK"   , "narrator": "ガブリエラ", "text": "$handle$はそうやって"},
        { "location": "95/TALK"   , "narrator": "ガブリエラ", "text": "私にばっかり言わせて"},
        { "location": "96/TALK"   , "narrator": "ガブリエラ", "text": "たまには"},
        { "location": "97/TALK"   , "narrator": "ガブリエラ", "text": "$handle$が言えばいいのよ"},
        { "location": "98/TALK"   , "narrator": "ガブリエラ", "text": "そうでしょう？？？？"},
        { "location": "103/TALK"  , "narrator": "ボイスメール", "text": "スライス・オブ・ライフ"},
