        "title": "らぶとーく 第53話",
        "sub_title": "本当は、泣きたくてしょうがなかった"
    },
    "entry":
    [
        { "location": "283/SCENARIO", "narrator": "", "text": "460_本当は、泣きたくてしょうがなかった"},
        { "location": "308/TALK"    , "narrator": "アーヤ", "text": "みやびが勧めてくれた小説"},
        { "location": "309/TALK"    , "narrator": "アーヤ", "text": "やっと読み終わったわ＼(◎o◎)／"},
        { "location": "311/SEL"     , "narrator": "", "text": "面白かった？"},
        { "location": "312/SEL"     , "narrator": "", "text": "お疲れさま"},
        { "location": "313/SEL"     , "narrator": "", "text": "どんな話？"},
        { "location": "314/ACT"     , "narrator": "", "text": "面白かった？"},
        { "location": "315/TALK"    , "narrator": "アーヤ", "text": "面白かったけど"},
        { "location": "316/ACT"     , "narrator": "", "text": "お疲れさま"},
        { "location": "317/TALK"    , "narrator": "アーヤ", "text": "つかれたわー"},
        { "location": "318/ACT"     , "narrator": "", "text": "どんな話？"},
        { "location": "319/TALK"    , "narrator": "アーヤ", "text": "一言で言えないわ"},
        { "location": "321/TALK"    , "narrator": "アーヤ", "text": "とにかく長いのよ(--*;"},
        { "location": "322/TALK"    , "narrator": "アーヤ", "text": "それにちょっと暴力的？"},
        { "location": "323/TALK"    , "narrator": "アーヤ", "text": "最後はヒロイン報われたからよかったけど"},
        { "location": "326/SEL"     , "narrator": "", "text": "おとぎ話？"},
        { "location": "327/SEL"     , "narrator": "", "text": "ラブロマンス？"},
        { "location": "328/ACT"     , "narrator": "", "text": "おとぎ話？"},
        { "location": "329/TALK"    , "narrator": "アーヤ", "text": "子供が読んだら泣いちゃうわ"},
        { "location": "330/TALK"    , "narrator": "アーヤ", "text": "たぶん"},
        { "location": "331/ACT"     , "narrator": "", "text": "ラブロマンス？"},
        { "location": "333/TALK"    , "narrator": "アーヤ", "text": "ラブ、、、はあったかな、、、"},
        { "location": "334/TALK"    , "narrator": "アーヤ", "text": "でもロマンスとは違うかも"},
        { "location": "336/TALK"    , "narrator": "アーヤ", "text": "SFなの"},
        { "location": "337/TALK"    , "narrator": "アーヤ", "text": "殺されかけたヒロインが"},
        { "location": "338/TALK"    , "narrator": "アーヤ", "text": "ネズミに助けられて犯人を捕まえるの"},
        { "location": "340/SEL"     , "narrator": "", "text": "あー、あれ"},
        { "location": "341/SEL"     , "narrator": "", "text": "ごめん、意味わからん"},
        { "location": "342/ACT"     , "narrator": "", "text": "あー、あれ"},
        { "location": "343/TALK"    , "narrator": "アーヤ", "text": "$handle$さんも読んだことがあるのね"},
        { "location": "344/ACT"     , "narrator": "", "text": "ごめん、意味わからん"},
        { "location": "345/TALK"    , "narrator": "アーヤ", "text": "あれ(-.-;)"},
        { "location": "346/TALK"    , "narrator": "アーヤ", "text": "説明って難しいわね"},
        { "location": "348/TALK"    , "narrator": "アーヤ", "text": "ヒロインはね、最初ずっと"},
        { "location": "349/TALK"    , "narrator": "アーヤ", "text": "「何で私なの」って思ってるのよ"},
        { "location": "350/TALK"    , "narrator": "アーヤ", "text": "「自分が特別扱いされるわけない」のに、"},
        { "location": "351/TALK"    , "narrator": "アーヤ", "text": "どうして選ばれたのかって"},
        { "location": "353/SEL"     , "narrator": "", "text": "切ないね"},
        { "location": "354/SEL"     , "narrator": "", "text": "ふーん"},
        { "location": "355/SEL"     , "narrator": "", "text": "アーヤは$me$の特別だよ"},
        { "location": "356/ACT"     , "narrator": "", "text": "切ないね"},
        { "location": "357/TALK"    , "narrator": "アーヤ", "text": "そうね、、、"},
        { "location": "358/TALK"    , "narrator": "アーヤ", "text": "でもヒロインは協力者を得て"},
        { "location": "359/TALK"    , "narrator": "アーヤ", "text": "最後に犯人を捕まえるのよ"},
        { "location": "360/TALK"    , "narrator": "アーヤ", "text": "おすすめだけあって面白かったわ"},
        { "location": "361/TALK"    , "narrator": "アーヤ", "text": "長かったけどヽ(´o｀；"},
        { "location": "362/TALK"    , "narrator": "アーヤ", "text": "またおすすめきいてみようかな"},
        { "location": "363/ACT"     , "narrator": "", "text": "ふーん"},
        { "location": "364/TALK"    , "narrator": "アーヤ", "text": "あら"},
        { "location": "365/TALK"    , "narrator": "アーヤ", "text": "興味ないみたいね"},
        { "location": "366/TALK"    , "narrator": "アーヤ", "text": "じゃあいいわ"},
        { "location": "367/TALK"    , "narrator": "アーヤ", "text": "ごめんね"},
        { "location": "369/TALK"    , "narrator": "アーヤ", "text": "変な話して"},
        { "location": "370/ACT"     , "narrator": "", "text": "アーヤは$me$の特別だよ"},
        { "location": "380/TALK"    , "narrator": "アーヤ", "text": "ありがとう"},
        { "location": "381/TALK"    , "narrator": "アーヤ", "text": "でもひとつ言っておくわ"},
        { "location": "382/TALK"    , "narrator": "アーヤ", "text": "私にとっても$handle$さんは特別なんだって"},
        { "location": "383/TALK"    , "narrator": "アーヤ", "text": "わかってる？"},
        { "location": "385/SEL"     , "narrator": "", "text": "うん"},
        { "location": "386/SEL"     , "narrator": "", "text": "知ってた"},
        { "location": "387/SEL"     , "narrator": "", "text": "愛してる"},
        { "location": "388/ACT"     , "narrator": "", "text": "うん"},
        { "location": "389/TALK"    , "narrator": "アーヤ", "text": "そう"},
        { "location": "390/TALK"    , "narrator": "アーヤ", "text": "よかった"},
        { "location": "392/TALK"    , "narrator": "アーヤ", "text": "嬉しいわ"},
        { "location": "393/ACT"     , "narrator": "", "text": "知ってた"},
        { "location": "394/TALK"    , "narrator": "アーヤ", "text": "ずいぶんな自信ね！"},
        { "location": "395/TALK"    , "narrator": "アーヤ", "text": "でも"},
        { "location": "396/TALK"    , "narrator": "アーヤ", "text": "本当のことだしね"},
        { "location": "397/ACT"     , "narrator": "", "text": "愛してる"},
        { "location": "398/TALK"    , "narrator": "アーヤ", "text": "貴方の愛は軽いのよ"},
        { "location": "400/TALK"    , "narrator": "アーヤ", "text": "いつも"},
        { "location": "401/TALK"    , "narrator": "アーヤ", "text": "だから"},
        { "location": "402/TALK"    , "narrator": "アーヤ", "text": "いつも言ってくれないと"},
        { "location": "403/TALK"    , "narrator": "アーヤ", "text": "わからないわ"},
        { "location": "404/TALK"    , "narrator": "アーヤ", "text": "いつもよ"},
        { "location": "405/TALK"    , "narrator": "アーヤ", "text": "いつでもよ"},
        { "location": "410/TALK"    , "narrator": "アーヤ", "text": "私はちゃんと"},
        { "location": "411/TALK"    , "narrator": "アーヤ", "text": "愛してるから"},
        { "location": "376/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>1000pt.</b></color></size>\nアップしました！"}
    ]
}
