{
    "dir": "chap31/daydra/dd_ch03_31_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "31305",
        "cid": "gabriella",
        "title": "005 メインストーリー",
        "sub_title": "兎穴の入り口で＜後編＞"
    },
    "entry":
    [
        { "location": "659/SCENARIO", "narrator": "", "text": "その底には"},
        { "location": "674/TALK"    , "narrator": "ガブリエラ", "text": "……ん……。"},
        { "location": "677/TALK"    , "narrator": "ガブリエラ", "text": "ダイブ成功\nしたのかしら…？"},
        { "location": "678/SEL"     , "narrator": "", "text": "おつかれさま"},
        { "location": "679/ACT"     , "narrator": "", "text": "おつかれさま"},
        { "location": "683/TALK"    , "narrator": "ガブリエラ", "text": "$handle$？\nってことはこれ\n成功したのよね？"},
        { "location": "684/SEL"     , "narrator": "", "text": "一応"},
        { "location": "685/SEL"     , "narrator": "", "text": "当然"},
        { "location": "686/ACT"     , "narrator": "", "text": "一応"},
        { "location": "687/TALK"    , "narrator": "ガブリエラ", "text": "そうよね。"},
        { "location": "688/ACT"     , "narrator": "", "text": "当然"},
        { "location": "690/TALK"    , "narrator": "ガブリエラ", "text": "強気ね。"},
        { "location": "693/TALK"    , "narrator": "ガブリエラ", "text": "それにしてもアーヤは\nどこにいるのかしら。"},
        { "location": "694/SEL"     , "narrator": "", "text": "その前に会わせたい人が"},
        { "location": "695/SEL"     , "narrator": "", "text": "スペシャルゲストが\nいるんだ"},
        { "location": "696/SEL"     , "narrator": "", "text": "すごい人に会えるよ"},
        { "location": "697/ACT"     , "narrator": "", "text": "その前に会わせたい人が"},
        { "location": "700/TALK"    , "narrator": "ガブリエラ", "text": "誰？\nまさか音羽？"},
        { "location": "701/ACT"     , "narrator": "", "text": "スペシャルゲストが\nいるんだ"},
        { "location": "704/TALK"    , "narrator": "ガブリエラ", "text": "スペシャル？\nどういうこと？"},
        { "location": "705/ACT"     , "narrator": "", "text": "すごい人に会えるよ"},
        { "location": "708/TALK"    , "narrator": "ガブリエラ", "text": "誰のこと？"},
        { "location": "716/TALK"    , "narrator": "エリカ", "text": "こんにちは？"},
        { "location": "719/TALK"    , "narrator": "ガブリエラ", "text": "！！"},
        { "location": "720/TALK"    , "narrator": "エリカ", "text": "あなたアヤちゃんの\nお友達よね？"},
        { "location": "722/TALK"    , "narrator": "ガブリエラ", "text": "ガブリエラ・\nロタルィンスカよ。"},
        { "location": "723/TALK"    , "narrator": "ガブリエラ", "text": "あなたは？"},
        { "location": "724/TALK"    , "narrator": "エリカ", "text": "エリカです。\nアヤちゃんの姉です。"},
        { "location": "725/TALK"    , "narrator": "ガブリエラ", "text": "あ…！"},
        { "location": "726/SEL"     , "narrator": "", "text": "びっくりした？"},
        { "location": "727/ACT"     , "narrator": "", "text": "びっくりした？"},
        { "location": "730/TALK"    , "narrator": "ガブリエラ", "text": "したわよ！\n当たり前じゃない！"},
        { "location": "732/TALK"    , "narrator": "ガブリエラ", "text": "そうだ。\nあたしアーヤを\n迎えに来て…。"},
        { "location": "734/TALK"    , "narrator": "エリカ", "text": "アヤちゃん、\nちょっと取り込み中\nなんだけど。"},
        { "location": "735/TALK"    , "narrator": "エリカ", "text": "行ってみましょうか。"},
        { "location": "759/TALK"    , "narrator": "アーヤ", "text": "問題はそこよね。"},
        { "location": "767/TALK"    , "narrator": "ガブリエラ", "text": "アーヤ？\n何一人で話してるの？"},
        { "location": "770/TALK"    , "narrator": "エリカ", "text": "確かにそう\n見えるかも。"},
        { "location": "773/TALK"    , "narrator": "アーヤ", "text": "ギャヴィ？\nと、お姉ちゃん！"},
        { "location": "774/TALK"    , "narrator": "ガブリエラ", "text": "あんまり遅いから\n迎えに来たのよ。"},
        { "location": "777/TALK"    , "narrator": "エリカ", "text": "お姉ちゃん知ってる。\nこういうのツンデレって\n言うんでしょ。"},
        { "location": "781/TALK"    , "narrator": "ガブリエラ", "text": "…！？！？"},
        { "location": "782/TALK"    , "narrator": "アーヤ", "text": "独り言じゃないわ。\n音羽と話してたの。"},
        { "location": "784/TALK"    , "narrator": "ガブリエラ", "text": "…お姉さんの発言\n完全にスルーしたわ\nアーヤったら…。"},
        { "location": "788/TALK"    , "narrator": "音羽", "text": "この空間で私は\n形になれないの。\n声だけでごめんなさい。"},
        { "location": "791/TALK"    , "narrator": "ガブリエラ", "text": "そういうことなの…。"},
        { "location": "792/TALK"    , "narrator": "音羽", "text": "アーヤさんが戻るのが\n遅くなったのも\n理由があるの。"},
        { "location": "793/TALK"    , "narrator": "音羽", "text": "近いうちに\n神楽はつばめさんの\nいる場所で歌を歌う。"},
        { "location": "794/TALK"    , "narrator": "音羽", "text": "希望の心を破壊する歌を。"},
        { "location": "795/TALK"    , "narrator": "音羽", "text": "そうなったら\nこの世界は終わる。\n書き換えられてしまう。"},
        { "location": "796/TALK"    , "narrator": "音羽", "text": "その歌を無効化する\nには私が神楽に\nコネクトする必要がある。"},
        { "location": "797/TALK"    , "narrator": "音羽", "text": "でも今神楽は敵陣にいる。"},
        { "location": "798/TALK"    , "narrator": "音羽", "text": "それにガードも\nされてるだろうし。"},
        { "location": "799/TALK"    , "narrator": "音羽", "text": "コネクトが\n可能なのか\nどうか……。"},
        { "location": "800/TALK"    , "narrator": "アーヤ", "text": "…せっかく音羽が\n協力してくれるって\n言ってくれたのに…。"},
        { "location": "802/TALK"    , "narrator": "エリカ", "text": "大丈夫よ。\n方法はある。"},
        { "location": "805/TALK"    , "narrator": "ガブリエラ", "text": "！"},
        { "location": "806/TALK"    , "narrator": "アーヤ", "text": "……。"},
        { "location": "808/TALK"    , "narrator": "エリカ", "text": "まほちゃんが普段\n劇場で使っている\n司令塔システムあるよね。"},
        { "location": "809/TALK"    , "narrator": "エリカ", "text": "劇場のスクリーン\nホロが沢山出る、\nアレのことなんだけど。"},
        { "location": "810/TALK"    , "narrator": "エリカ", "text": "あのシステムは、特定の\nトライガジェットに対し\nクランをコネクトできる。"},
        { "location": "811/TALK"    , "narrator": "ガブリエラ", "text": "そうね。普段まほが\nあたしたちにやってる\nアレよね。"},
        { "location": "813/TALK"    , "narrator": "エリカ", "text": "うん。一応あのシステム、\nまほちゃん名義のトライ\nガジェットなんだよ？"},
        { "location": "815/TALK"    , "narrator": "ガブリエラ", "text": "ええっ！？　あれも\nトライガジェットなの！？"},
        { "location": "816/TALK"    , "narrator": "エリカ", "text": "うん。家のパソコンも\nサーバー機も、中身は\n同じでしょ？"},
        { "location": "817/TALK"    , "narrator": "エリカ", "text": "そんな感じ。"},
        { "location": "819/TALK"    , "narrator": "アーヤ", "text": "…？？？"},
        { "location": "822/TALK"    , "narrator": "エリカ", "text": "でね、今まで神楽ちゃんに\nコネクトをしていたなら、\n今もまだ理論上はできる。"},
        { "location": "824/TALK"    , "narrator": "エリカ", "text": "音羽ちゃんの修復を完了\nさせた後で、劇場の\nシステムに登録すれば――"},
        { "location": "825/TALK"    , "narrator": "エリカ", "text": "いつもまほちゃんが\nやってるのと同じ方法で、\nコネクト可能ってわけ。"},
        { "location": "826/TALK"    , "narrator": "ガブリエラ", "text": "でも、そもそも神楽が\nガジェット起動して\nいなかったら無理でしょ？"},
        { "location": "828/TALK"    , "narrator": "エリカ", "text": "普段はね。でもそこは、\n一部のプログラムを\n書き換えればできる。"},
        { "location": "832/TALK"    , "narrator": "アーヤ", "text": "え……嘘でしょ！？"},
        { "location": "834/TALK"    , "narrator": "ガブリエラ", "text": "怖すぎるんですけど！！"},
        { "location": "835/TALK"    , "narrator": "エリカ", "text": "気持ちはわかるけど、\n機械的見地から見ると\n普通のことだよ……。"},
        { "location": "836/TALK"    , "narrator": "エリカ", "text": "例えば、エレベーターは\n本気出せば人を挟んで\n殺すことができるし――"},
        { "location": "837/TALK"    , "narrator": "エリカ", "text": "もっと極端な例だと、\n車を運転する人は、\n今すぐ人をひけるよね？"},
        { "location": "838/TALK"    , "narrator": "エリカ", "text": "世の中の殆どのものは、\nルールとセキュリティで\n惨事を防いでるだけ。"},
        { "location": "839/TALK"    , "narrator": "エリカ", "text": "トライガジェットも同じ。\nやろうと思えば出来る\nことを規制してるだけ。"},
        { "location": "842/TALK"    , "narrator": "ガブリエラ", "text": "まあ、確かに\n言われてみればそうよね。"},
        { "location": "844/TALK"    , "narrator": "アーヤ", "text": "……。"},
        { "location": "845/TALK"    , "narrator": "エリカ", "text": "ただ、プログラムの\n書き換えには、みやび\nちゃんの手を借りたい。"},
        { "location": "846/TALK"    , "narrator": "エリカ", "text": "みやびちゃん、\nそういうの得意だよね。"},
        { "location": "849/TALK"    , "narrator": "ガブリエラ", "text": "この話聞いたら、\nみやび、すっごい\n喜びそうだわね……。"},
        { "location": "851/TALK"    , "narrator": "エリカ", "text": "ここまでの準備ができたら\nあとは神楽ちゃんを\n目視できる所に行くだけ。"},
        { "location": "852/TALK"    , "narrator": "エリカ", "text": "劇場のシステムで\nガジェットを捕捉すれば、\nコネクトは可能なはず。"},
        { "location": "854/TALK"    , "narrator": "エリカ", "text": "もちろん、全ては\n机上の空論だから、\nどこかに穴があるかも。"},
        { "location": "855/TALK"    , "narrator": "エリカ", "text": "それに、\n一度ミスしたらもう\n次はないかもしれない。"},
        { "location": "857/TALK"    , "narrator": "アーヤ", "text": "失敗はしないわ。"},
        { "location": "858/TALK"    , "narrator": "音羽", "text": "…どうやってでも\n成功させる。"},
        { "location": "860/TALK"    , "narrator": "ガブリエラ", "text": "あたしも\nフォローするわ。"},
        { "location": "861/SEL"     , "narrator": "", "text": "$me$も"},
        { "location": "862/ACT"     , "narrator": "", "text": "$me$も"},
        { "location": "867/TALK"    , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "868/TALK"    , "narrator": "ガブリエラ", "text": "頼りにしてる"},
        { "location": "870/TALK"    , "narrator": "ガブリエラ", "text": "世界で一番"},
        { "location": "871/TALK"    , "narrator": "ガブリエラ", "text": "本当に"},
        { "location": "882/DIALOG"  , "narrator": "Dialog_chapter_ch03", "text": "【25 ワールド・スピード】"}
    ]
}
