{
    "dir": "chap21/daydra/dd_ch04_21_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "21405",
        "cid": "miyabi",
        "title": "005 メインストーリー",
        "sub_title": "こじゃんと元気キャラ＜後編＞"
    },
    "entry":
    [
        { "location": "477/TALK"  , "narrator": "みやび", "text": "…けんど、やはり\nこんなことは\n滅多にないぞね。"},
        { "location": "478/TALK"  , "narrator": "みやび", "text": "やらんのは勿体ない\n気もするちや。"},
        { "location": "480/TALK"  , "narrator": "みやび", "text": "それに…遊べば\nみんなも元気になる\nかもしれんし…。"},
        { "location": "481/SEL"   , "narrator": "", "text": "遊びに連れてこうよ"},
        { "location": "482/ACT"   , "narrator": "", "text": "遊びに連れてこうよ"},
        { "location": "497/TALK"  , "narrator": "みやび", "text": "いや"},
        { "location": "498/TALK"  , "narrator": "みやび", "text": "うちのキャラじゃない"},
        { "location": "499/TALK"  , "narrator": "みやび", "text": "突然何を言い出すのかと"},
        { "location": "501/TALK"  , "narrator": "みやび", "text": "驚かれてしまう"},
        { "location": "503/SEL"   , "narrator": "", "text": "レアな姿見せてあげようよ"},
        { "location": "504/ACT"   , "narrator": "", "text": "レアな姿見せてあげようよ"},
        { "location": "507/TALK"  , "narrator": "みやび", "text": "なるほど"},
        { "location": "508/TALK"  , "narrator": "みやび", "text": "せっかく合宿になんぞ来てるんやし"},
        { "location": "509/TALK"  , "narrator": "みやび", "text": "こういう時くらい"},
        { "location": "510/TALK"  , "narrator": "みやび", "text": "レアなうちを見せるのもよさそうや"},
        { "location": "511/TALK"  , "narrator": "みやび", "text": "よしわかった"},
        { "location": "512/TALK"  , "narrator": "みやび", "text": "みんなを驚かせてくるとしよう"},
        { "location": "524/TALK"  , "narrator": "みやび", "text": "…いかんなぁ。\n疲れちゅうんは\nわかる。"},
        { "location": "525/TALK"  , "narrator": "みやび", "text": "けんど、休みの日に\nダラダラしちゃあ\nいかんぞね！"},
        { "location": "527/TALK"  , "narrator": "みやび", "text": "今からみんなで、\n外へ遊びに行くぞね！"},
        { "location": "530/TALK"  , "narrator": "アーヤ", "text": "…冗談のつもり？"},
        { "location": "531/TALK"  , "narrator": "アーヤ", "text": "誰もそんなのに\n引っかからないわよ？"},
        { "location": "533/TALK"  , "narrator": "みやび", "text": "いや、本気や。\nみんな準備しぃ。"},
        { "location": "535/TALK"  , "narrator": "つばめ", "text": "えっ！？　本当に\n遊びに行くつもり\nなんですか？"},
        { "location": "537/TALK"  , "narrator": "神楽", "text": "何も今日じゃなくても\nいいんじゃないん\nですか？"},
        { "location": "538/TALK"  , "narrator": "みやび", "text": "いや。みんなが\nヘロヘロということに\n意味がある。"},
        { "location": "539/TALK"  , "narrator": "みやび", "text": "元気なうちと\nヘロヘロなメンバー。\nなんと楽しいことか！"},
        { "location": "541/TALK"  , "narrator": "ガブリエラ", "text": "いや、あたしらは\n全然楽しくないから。"},
        { "location": "543/TALK"  , "narrator": "ガブリエラ", "text": "第一、みやびって\n一番外出を嫌がる\nタイプでしょ？"},
        { "location": "545/TALK"  , "narrator": "みやび", "text": "普段はそうやね。"},
        { "location": "546/TALK"  , "narrator": "みやび", "text": "それを上回る面白さを　\n感じたら実行する。\nそれもうちながよ。"},
        { "location": "547/TALK"  , "narrator": "アーヤ", "text": "…確かに、みやびは\nそういう子よね。"},
        { "location": "548/TALK"  , "narrator": "ガブリエラ", "text": "いや、納得する\nとこじゃないでしょ？"},
        { "location": "550/TALK"  , "narrator": "みやび", "text": "ほれ、\nすっと準備しぃ。"},
        { "location": "551/TALK"  , "narrator": "みやび", "text": "来ない子には、\n今夜の夕食は\n抜きぞね。"},
        { "location": "553/TALK"  , "narrator": "つばめ", "text": "えぇっ！？"},
        { "location": "555/TALK"  , "narrator": "神楽", "text": "もぉ…みやびさんは\n変なところで\n強引なんですから…。"},
        { "location": "558/TALK"  , "narrator": "アーヤ", "text": "でも、遊びに行くって\nどこに行くのよ？"},
        { "location": "560/TALK"  , "narrator": "みやび", "text": "そうやなぁ…。\nとりあえず――"},
        { "location": "602/TALK"  , "narrator": "みやび", "text": "我が家がいつも\n買うてる魚屋やね。"},
        { "location": "603/TALK"  , "narrator": "みやび", "text": "ちゅうわけやき、\n夕飯に食べたい魚、\nカゴに入れるちや。"},
        { "location": "606/TALK"  , "narrator": "ガブリエラ", "text": "…遊びに行くとか\n言っておきながら、\nただの買い物なの？"},
        { "location": "609/TALK"  , "narrator": "みやび", "text": "みんな今日は\nヘロヘロやきね。"},
        { "location": "610/TALK"  , "narrator": "みやび", "text": "まともに遊んだり\nできんやろ？"},
        { "location": "611/TALK"  , "narrator": "みやび", "text": "なので買い物に\n変更や。"},
        { "location": "613/TALK"  , "narrator": "つばめ", "text": "でもわたし、\nとっても楽しいです！"},
        { "location": "614/TALK"  , "narrator": "つばめ", "text": "普段来ないお店に\n来るのって、\nワクワクしますし。"},
        { "location": "616/TALK"  , "narrator": "みやび", "text": "ほれ、ガブちゃんも\nこの状況を楽しむ\n努力をしぃ。"},
        { "location": "618/TALK"  , "narrator": "神楽", "text": "みやびさん。\n食べたいモノは\n何でもいいんですか？"},
        { "location": "620/TALK"  , "narrator": "みやび", "text": "合宿費用は全額\n管理庁に請求書を\n回すきね。"},
        { "location": "621/TALK"  , "narrator": "みやび", "text": "何でも好きなもん\n入れてえいぞ。"},
        { "location": "623/TALK"  , "narrator": "神楽", "text": "何でもなら…私、\nイクラ入れちゃい\nます！"},
        { "location": "624/TALK"  , "narrator": "アーヤ", "text": "そうねぇ…。"},
        { "location": "625/TALK"  , "narrator": "アーヤ", "text": "マグロはこっちで\n結構食べてるから\nウニとか？"},
        { "location": "627/TALK"  , "narrator": "ガブリエラ", "text": "アーヤって\nウニ食べれるんだ？"},
        { "location": "628/TALK"  , "narrator": "アーヤ", "text": "ええ。\nギャヴィは\n何にするの？"},
        { "location": "631/TALK"  , "narrator": "ガブリエラ", "text": "そうねぇ…。\nサーモンかしら？"},
        { "location": "632/TALK"  , "narrator": "みやび", "text": "サーモンって、\nガブちゃん…。"},
        { "location": "634/TALK"  , "narrator": "ガブリエラ", "text": "いいでしょ？\n甘くて好きなのよ。"},
        { "location": "636/TALK"  , "narrator": "つばめ", "text": "あ、みやびさん。\nわたしイチゴ入れても\nいいですか？"},
        { "location": "638/TALK"  , "narrator": "神楽", "text": "つばめさん…、\nここは魚屋さん\nですよ？"},
        { "location": "640/TALK"  , "narrator": "つばめ", "text": "あ、そっか…。\nえへへ…。"},
        { "location": "642/TALK"  , "narrator": "みやび", "text": "なら、魚屋の後に\n八百屋行くぞね。"},
        { "location": "645/TALK"  , "narrator": "みやび", "text": "ほれ、遠慮せんで\nガンガン食べたいもん\n入れまくるちや。"},
        { "location": "691/TALK"  , "narrator": "アーヤ", "text": "…ここのカフェ、\n素敵ね。"},
        { "location": "692/TALK"  , "narrator": "アーヤ", "text": "海風を感じながらの\nティータイム。"},
        { "location": "694/TALK"  , "narrator": "ガブリエラ", "text": "アーヤって、こういう\nオシャレなお店\n大好きだもんね。"},
        { "location": "697/TALK"  , "narrator": "アーヤ", "text": "何よ。\nギャヴィだって\n楽しんでるでしょ？"},
        { "location": "699/TALK"  , "narrator": "ガブリエラ", "text": "あたしは美味しい\nデザートがあれば\nどこでもいいのよ。"},
        { "location": "701/TALK"  , "narrator": "つばめ", "text": "わぁ、このイチゴの\nスムージー、とっても\n美味しい！"},
        { "location": "703/TALK"  , "narrator": "つばめ", "text": "神楽ちゃんも\n一口どう？"},
        { "location": "705/TALK"  , "narrator": "神楽", "text": "いいんですか？\nそれじゃ、一口だけ\nいただきますね。"},
        { "location": "707/TALK"  , "narrator": "ガブリエラ", "text": "あたしにも\n一口ちょうだいよ。"},
        { "location": "709/TALK"  , "narrator": "つばめ", "text": "じゃあ、ガブちゃんの\nレモンスカッシュ\n一口欲しいな。"},
        { "location": "711/TALK"  , "narrator": "アーヤ", "text": "このお店、みやびも\nよく来てたの？"},
        { "location": "713/TALK"  , "narrator": "みやび", "text": "今日みたいな買い物\n帰りに、たまにな。"},
        { "location": "714/TALK"  , "narrator": "みやび", "text": "スイーツが多くて\nうちにとっての\n癒しなんよ。"},
        { "location": "716/TALK"  , "narrator": "アーヤ", "text": "そうなんだ。"},
        { "location": "717/TALK"  , "narrator": "みやび", "text": "うん…ところで、\nその紅茶美味いが？"},
        { "location": "719/TALK"  , "narrator": "アーヤ", "text": "ええ、とっても。\nなんで？"},
        { "location": "722/TALK"  , "narrator": "みやび", "text": "いや…。"},
        { "location": "724/TALK"  , "narrator": "みやび", "text": "海の磯臭さで紅茶の\n香り台無しやと思うん\nやけんど…。"},
        { "location": "768/TALK"  , "narrator": "神楽", "text": "なんだか、充実した\n午後になりましたね。"},
        { "location": "769/TALK"  , "narrator": "つばめ", "text": "みやびさんが家から\n連れ出してくれた\nおかげだね。"},
        { "location": "770/TALK"  , "narrator": "みやび", "text": "何や二人とも。\n疲れ取ったんじゃ\nないが？"},
        { "location": "772/TALK"  , "narrator": "つばめ", "text": "お買い物が楽しくて、\n疲れはどこかに\n消えちゃいました。"},
        { "location": "775/TALK"  , "narrator": "ガブリエラ", "text": "単純ねぇ。\nそんなんで疲れが\n取れるなんて。"},
        { "location": "778/TALK"  , "narrator": "アーヤ", "text": "いいじゃない、\n元気になったん\nだから。"},
        { "location": "781/TALK"  , "narrator": "アーヤ", "text": "それに、家にいるより\n楽しく過ごせたのは\n事実なんだし。"},
        { "location": "783/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "784/TALK"  , "narrator": "アーヤ", "text": "でも、ちょっと\n買い過ぎたかも\nしれないわね。"},
        { "location": "786/TALK"  , "narrator": "ガブリエラ", "text": "大丈夫よ。\nアーヤは意外と\n大食いなんだし。"},
        { "location": "789/TALK"  , "narrator": "アーヤ", "text": "大食いじゃないわよ。\n動いた分、ちゃんと\n食べてるだけだから。"},
        { "location": "791/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "793/TALK"  , "narrator": "つばめ", "text": "イチゴ、どうやって\n食べようかなぁ？"},
        { "location": "795/TALK"  , "narrator": "神楽", "text": "冷やしたのを\n食べるんじゃ\nないんですか？"},
        { "location": "797/TALK"  , "narrator": "つばめ", "text": "お砂糖入れた牛乳に\n入れても\n美味しいんだよ？"},
        { "location": "798/TALK"  , "narrator": "神楽", "text": "そうなんですか…。\n私、そういう食べ方\nしたことなくて…。"},
        { "location": "799/TALK"  , "narrator": "つばめ", "text": "じゃあ、デザートに\n一緒に食べよ。"},
        { "location": "801/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "802/TALK"  , "narrator": "みやび", "text": "みんな、楽しんで\nくれたみたいやな。"},
        { "location": "803/TALK"  , "narrator": "みやび", "text": "思い切って、\nみんな連れだした\n甲斐があったがよ。"},
        { "location": "805/TALK"  , "narrator": "アーヤ", "text": "みやび、今日は\n連れ出してくれて\nありがとう。"},
        { "location": "806/TALK"  , "narrator": "アーヤ", "text": "とっても楽しい\n時間を過ごせたわ。"},
        { "location": "808/TALK"  , "narrator": "つばめ", "text": "また訓練がお休みに\nなったら。"},
        { "location": "809/TALK"  , "narrator": "つばめ", "text": "お買い物に連れて\nいってくださいね。"},
        { "location": "810/TALK"  , "narrator": "みやび", "text": "…そうやね。"},
        { "location": "811/TALK"  , "narrator": "みやび", "text": "その時は全員一緒で、\n荷物持ちしてな。"},
        { "location": "812/TALK"  , "narrator": "つばめ", "text": "はい！"},
        { "location": "813/TALK"  , "narrator": "アーヤ", "text": "そんなこと言わないで\n配送とか\n頼めばいいじゃない。"},
        { "location": "815/TALK"  , "narrator": "ガブリエラ", "text": "そうよ。\n勝手ばっかり\n言うんだから。"},
        { "location": "817/TALK"  , "narrator": "つばめ", "text": "あれ？\nみんな手伝わないん\nですか？　"},
        { "location": "818/TALK"  , "narrator": "みやび", "text": "本気にしたのは\nつばめちゃんだけ\nやねえ。"},
        { "location": "819/TALK"  , "narrator": "つばめ", "text": "えー！？"},
        { "location": "821/TALK"  , "narrator": "みやび", "text": "ふふっ……。"},
        { "location": "832/DIALOG", "narrator": "Dialog_chapter_ch04", "text": "【17 告白】"}
    ]
}
