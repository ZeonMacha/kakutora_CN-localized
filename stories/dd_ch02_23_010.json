{
    "dir": "chap23/daydra/dd_ch02_23_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "23252",
        "cid": "ayami",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "不器用なリーダー"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "不器用なリーダー"},
        { "location": "24/TALK"   , "narrator": "ガブリエラ", "text": "あー、疲れたぁ…。\n今日の訓練、ちょっと\nスパルタ過ぎじゃない？"},
        { "location": "26/TALK"   , "narrator": "アーヤ", "text": "当然でしょ？\n限界まで動かなくちゃ\n訓練じゃないわ。"},
        { "location": "28/TALK"   , "narrator": "つばめ", "text": "もうヘトヘトです…。\n早く帰ろうよ…。"},
        { "location": "29/TALK"   , "narrator": "みやび", "text": "大賛成や。\n熱い風呂と冷えた麦茶で\n疲れた身体を癒すぞね。"},
        { "location": "30/TALK"   , "narrator": "ガブリエラ", "text": "じゃ、早く帰りましょ。"},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "あ、ちょっと待って。"},
        { "location": "36/TALK"   , "narrator": "アーヤ", "text": "卯月、この後なんだけど、\nお茶しに行かない？"},
        { "location": "38/TALK"   , "narrator": "神楽", "text": "えっ…、いいですけど、\nそれなら、つばめさんも\n一緒に――"},
        { "location": "39/TALK"   , "narrator": "アーヤ", "text": "二人だけがいいわ。\nちょっと、大事な話だから。"},
        { "location": "40/TALK"   , "narrator": "神楽", "text": "…………。"},
        { "location": "58/TALK"   , "narrator": "アーヤ", "text": "…訓練で疲れてるとこ、\n無理言ってごめんなさい。"},
        { "location": "60/TALK"   , "narrator": "神楽", "text": "あ、いえ…。\n特に予定もありません\nでしたから…。"},
        { "location": "61/TALK"   , "narrator": "アーヤ", "text": "そう…。"},
        { "location": "62/TALK"   , "narrator": "神楽", "text": "…………。"},
        { "location": "63/TALK"   , "narrator": "アーヤ", "text": "…緊張してるのかしら？\nまあ、無理もないわね。"},
        { "location": "64/TALK"   , "narrator": "アーヤ", "text": "私も、卯月と二人きりで\n話すことって少ないから、\nちょっと緊張してるし…。"},
        { "location": "65/TALK"   , "narrator": "アーヤ", "text": "…って、いけないわね。\n誘ったのは私なんだから、\nこっちから始めないと。"},
        { "location": "66/TALK"   , "narrator": "アーヤ", "text": "えっと…どうして呼んだか、\n卯月も察しは付いてると\n思うんだけど…どう？"},
        { "location": "67/TALK"   , "narrator": "神楽", "text": "…最近の私の態度に、\n問題があるからですよね？"},
        { "location": "68/TALK"   , "narrator": "アーヤ", "text": "率直に言うと、まあ…\nそういうことになるわね。"},
        { "location": "70/TALK"   , "narrator": "神楽", "text": "…ごめんなさい。"},
        { "location": "72/TALK"   , "narrator": "アーヤ", "text": "あ、ううん。\n謝ってほしいわけじゃ\nないのよ。"},
        { "location": "73/TALK"   , "narrator": "アーヤ", "text": "むしろ、今卯月に\n謝らなきゃいけないのは\n私の方よ。"},
        { "location": "75/TALK"   , "narrator": "アーヤ", "text": "卯月の気持ちを知ってて、\n無茶なお願いしてるんだし。"},
        { "location": "76/TALK"   , "narrator": "神楽", "text": "…………。"},
        { "location": "77/TALK"   , "narrator": "アーヤ", "text": "でも、このままの状態が\n続くと…不安なのよ。"},
        { "location": "78/TALK"   , "narrator": "アーヤ", "text": "今の卯月は、訓練にすら\n集中できないような\n状態でしょ？"},
        { "location": "79/TALK"   , "narrator": "アーヤ", "text": "なのに、実戦でちゃんと\n動けるのか、って…。"},
        { "location": "80/TALK"   , "narrator": "アーヤ", "text": "私達も、そんな卯月を\n護って戦えるか聞かれると、\nちょっと自信ないの。"},
        { "location": "81/TALK"   , "narrator": "神楽", "text": "…すみません。"},
        { "location": "82/TALK"   , "narrator": "アーヤ", "text": "…ううん。\n人間だし、悩みを抱くのは\n当然のことよね。"},
        { "location": "84/TALK"   , "narrator": "アーヤ", "text": "それに、そういう時に\n支え合ってこそ、\n仲間なんだし。"},
        { "location": "85/TALK"   , "narrator": "神楽", "text": "…………。"},
        { "location": "86/TALK"   , "narrator": "アーヤ", "text": "だからね、今すぐに\nどうにかしろとは言わない。"},
        { "location": "87/TALK"   , "narrator": "アーヤ", "text": "けど、少しでも早く\n元の状態に戻ってほしいと\n思ってる。"},
        { "location": "88/TALK"   , "narrator": "アーヤ", "text": "卯月が、少しでもみんなと\n元の状態に戻りたいと\n思ってくれてるなら…ね。"},
        { "location": "89/TALK"   , "narrator": "神楽", "text": "…はい。"},
        { "location": "90/TALK"   , "narrator": "アーヤ", "text": "…わかってくれた？"},
        { "location": "91/TALK"   , "narrator": "神楽", "text": "…すぐには無理です。"},
        { "location": "92/TALK"   , "narrator": "神楽", "text": "でも…この状態がいいとは\n私も思っていません。"},
        { "location": "93/TALK"   , "narrator": "神楽", "text": "だから、何とかします…。"},
        { "location": "94/TALK"   , "narrator": "アーヤ", "text": "…………。"},
        { "location": "95/TALK"   , "narrator": "神楽", "text": "…すみませんでした。\nでは、失礼します。"},
        { "location": "104/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "106/TALK"  , "narrator": "アーヤ", "text": "はぁ…。"},
        { "location": "112/TALK"  , "narrator": "アーヤ", "text": "失敗したかも(-ω-;)"},
        { "location": "113/TALK"  , "narrator": "アーヤ", "text": "卯月"},
        { "location": "114/TALK"  , "narrator": "アーヤ", "text": "もっと元気なくなっちゃった気がする(T_T)"},
        { "location": "116/SEL"   , "narrator": "", "text": "元気づけたかったの？"},
        { "location": "117/ACT"   , "narrator": "", "text": "元気づけたかったの？"},
        { "location": "119/TALK"  , "narrator": "アーヤ", "text": "そう(; ;)"},
        { "location": "120/TALK"  , "narrator": "アーヤ", "text": "でも"},
        { "location": "121/TALK"  , "narrator": "アーヤ", "text": "卯月と"},
        { "location": "122/TALK"  , "narrator": "アーヤ", "text": "二人だけで話したこと"},
        { "location": "123/TALK"  , "narrator": "アーヤ", "text": "ほとんどなかったの(>_<)"},
        { "location": "124/TALK"  , "narrator": "アーヤ", "text": "しかも真面目な話"},
        { "location": "125/TALK"  , "narrator": "アーヤ", "text": "緊張して"},
        { "location": "126/TALK"  , "narrator": "アーヤ", "text": "追い打ちかけちゃった気がする(；´Д｀)"},
        { "location": "127/TALK"  , "narrator": "アーヤ", "text": "私はただ"},
        { "location": "128/TALK"  , "narrator": "アーヤ", "text": "卯月に元気になってほしくて"},
        { "location": "129/TALK"  , "narrator": "アーヤ", "text": "励ますつもりだった"},
        { "location": "130/TALK"  , "narrator": "アーヤ", "text": "なのに逆効果(ノД`)"},
        { "location": "132/TALK"  , "narrator": "アーヤ", "text": "バカなことしたな"},
        { "location": "133/TALK"  , "narrator": "アーヤ", "text": "見守ってればよかった(T_T)"},
        { "location": "135/SEL"   , "narrator": "", "text": "言ってよかったと思う"},
        { "location": "136/SEL"   , "narrator": "", "text": "謝りに行くしかない"},
        { "location": "137/SEL"   , "narrator": "", "text": "頼りないなぁ"},
        { "location": "138/ACT"   , "narrator": "", "text": "言ってよかったと思う"},
        { "location": "139/TALK"  , "narrator": "アーヤ", "text": "そう？"},
        { "location": "140/TALK"  , "narrator": "アーヤ", "text": "逆効果になってない？"},
        { "location": "142/SEL"   , "narrator": "", "text": "やるべきことをやった"},
        { "location": "143/SEL"   , "narrator": "", "text": "かっこよかったよ"},
        { "location": "144/ACT"   , "narrator": "", "text": "やるべきことをやった"},
        { "location": "145/TALK"  , "narrator": "アーヤ", "text": "ありがとう(; ;)"},
        { "location": "147/TALK"  , "narrator": "アーヤ", "text": "誰かにそう言ってもらえると"},
        { "location": "148/TALK"  , "narrator": "アーヤ", "text": "安心する(T_T)"},
        { "location": "149/TALK"  , "narrator": "アーヤ", "text": "ちょっとだけど"},
        { "location": "150/TALK"  , "narrator": "アーヤ", "text": "伝えたいことは伝えたから"},
        { "location": "151/TALK"  , "narrator": "アーヤ", "text": "慌てないで"},
        { "location": "152/TALK"  , "narrator": "アーヤ", "text": "見守ることにするわ(｡-_-｡)"},
        { "location": "154/ACT"   , "narrator": "", "text": "かっこよかったよ"},
        { "location": "155/TALK"  , "narrator": "アーヤ", "text": "ありがとう(^^"},
        { "location": "157/TALK"  , "narrator": "アーヤ", "text": "でもやっぱり"},
        { "location": "158/TALK"  , "narrator": "アーヤ", "text": "バカなことしたかも(-.-;)"},
        { "location": "159/TALK"  , "narrator": "アーヤ", "text": "私っていつもこう"},
        { "location": "160/TALK"  , "narrator": "アーヤ", "text": "卯月の家が巻き込まれた時も"},
        { "location": "161/TALK"  , "narrator": "アーヤ", "text": "キツく言っちゃったし(>_<)"},
        { "location": "162/TALK"  , "narrator": "アーヤ", "text": "偉そうにしてるのに"},
        { "location": "163/TALK"  , "narrator": "アーヤ", "text": "見えてないことだらけ(T_T)"},
        { "location": "164/TALK"  , "narrator": "アーヤ", "text": "でもあの時は"},
        { "location": "165/TALK"  , "narrator": "アーヤ", "text": "間違ったこと言ってないと思う"},
        { "location": "166/TALK"  , "narrator": "アーヤ", "text": "だって"},
        { "location": "167/TALK"  , "narrator": "アーヤ", "text": "卯月の行動は間違ってたし(｀ヘ´)"},
        { "location": "169/SEL"   , "narrator": "", "text": "ちょっと落ち着こう"},
        { "location": "170/ACT"   , "narrator": "", "text": "ちょっと落ち着こう"},
        { "location": "172/TALK"  , "narrator": "アーヤ", "text": "ごめんなさい(-.-;)"},
        { "location": "174/TALK"  , "narrator": "アーヤ", "text": "なんか私"},
        { "location": "175/TALK"  , "narrator": "アーヤ", "text": "かっこ悪い(T_T)"},
        { "location": "176/TALK"  , "narrator": "アーヤ", "text": "本当ダメよね"},
        { "location": "177/TALK"  , "narrator": "アーヤ", "text": "(ノД`)"},
        { "location": "180/ACT"   , "narrator": "", "text": "謝りに行くしかない"},
        { "location": "181/TALK"  , "narrator": "アーヤ", "text": "行かない"},
        { "location": "182/TALK"  , "narrator": "アーヤ", "text": "間違ったことは言ってない(￣Д￣ )"},
        { "location": "183/TALK"  , "narrator": "アーヤ", "text": "あれは"},
        { "location": "184/TALK"  , "narrator": "アーヤ", "text": "言うべきことだった"},
        { "location": "187/TALK"  , "narrator": "アーヤ", "text": "まあ"},
        { "location": "189/TALK"  , "narrator": "アーヤ", "text": "元気づけられなかったのは"},
        { "location": "190/TALK"  , "narrator": "アーヤ", "text": "私の責任だけど(>_<)"},
        { "location": "191/TALK"  , "narrator": "アーヤ", "text": "能力不足(T_T)"},
        { "location": "192/TALK"  , "narrator": "アーヤ", "text": "人を元気づけるって"},
        { "location": "193/TALK"  , "narrator": "アーヤ", "text": "難しい(；´Д｀)"},
        { "location": "194/TALK"  , "narrator": "アーヤ", "text": "東京帰ったら"},
        { "location": "195/TALK"  , "narrator": "アーヤ", "text": "もう一度"},
        { "location": "196/TALK"  , "narrator": "アーヤ", "text": "お茶に誘ってみる"},
        { "location": "197/TALK"  , "narrator": "アーヤ", "text": "今度は普通に"},
        { "location": "198/TALK"  , "narrator": "アーヤ", "text": "ただおしゃべりするために(*^^*)"},
        { "location": "200/ACT"   , "narrator": "", "text": "頼りないなぁ"},
        { "location": "201/TALK"  , "narrator": "アーヤ", "text": "そうよね"},
        { "location": "202/TALK"  , "narrator": "アーヤ", "text": "本当"},
        { "location": "203/TALK"  , "narrator": "アーヤ", "text": "自分でも思う(T_T)"},
        { "location": "204/TALK"  , "narrator": "アーヤ", "text": "ダメよね"},
        { "location": "205/TALK"  , "narrator": "アーヤ", "text": "みんなを引っ張ってくのが"},
        { "location": "206/TALK"  , "narrator": "アーヤ", "text": "私の役目なのに"},
        { "location": "207/TALK"  , "narrator": "アーヤ", "text": "失敗ばかり(; ;)"},
        { "location": "208/TALK"  , "narrator": "アーヤ", "text": "卯月にも"},
        { "location": "209/TALK"  , "narrator": "アーヤ", "text": "嫌な尾もいさせただけだし"},
        { "location": "210/TALK"  , "narrator": "アーヤ", "text": "尾もい→重い"},
        { "location": "211/TALK"  , "narrator": "アーヤ", "text": "尾もい→想い"},
        { "location": "212/TALK"  , "narrator": "アーヤ", "text": "間違え過ぎる"},
        { "location": "213/TALK"  , "narrator": "アーヤ", "text": "かっこ悪過ぎ"},
        { "location": "215/SEL"   , "narrator": "", "text": "ごめん冗談だよ"},
        { "location": "216/ACT"   , "narrator": "", "text": "ごめん冗談だよ"},
        { "location": "218/TALK"  , "narrator": "アーヤ", "text": "いいのよ？"},
        { "location": "219/TALK"  , "narrator": "アーヤ", "text": "本当のこと言って(￣Д￣ )"},
        { "location": "221/SEL"   , "narrator": "", "text": "アーヤは頑張ってるよ"},
        { "location": "222/ACT"   , "narrator": "", "text": "アーヤは頑張ってるよ"},
        { "location": "225/TALK"  , "narrator": "アーヤ", "text": "ありがとう(; ;)"},
        { "location": "226/TALK"  , "narrator": "アーヤ", "text": "ごめんなさい"},
        { "location": "227/TALK"  , "narrator": "アーヤ", "text": "$handle$に気を使わせた(ノД`)"},
        { "location": "229/TALK"  , "narrator": "アーヤ", "text": "やっぱりかっこ悪過ぎる"},
        { "location": "230/TALK"  , "narrator": "アーヤ", "text": "もっと"},
        { "location": "231/TALK"  , "narrator": "アーヤ", "text": "しっかりしなくちゃ(-ω-;)"},
        { "location": "22/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>8月21日　 4:35 PM</color>\n合宿中、みやびの実家近くの砂浜でのこと"}
    ]
}
