    "entry":
    [
        { "location": "195/SCENARIO", "narrator": "", "text": "03_対話における応答系感動詞の認定と分析について"},
        { "location": "221/TALK"    , "narrator": "みやび", "text": "結局のところ"},
        { "location": "222/TALK"    , "narrator": "みやび", "text": "およそ人間が考えつくことは同じ"},
        { "location": "223/TALK"    , "narrator": "みやび", "text": "そしてそのバリエーションが文化と呼ばれるそれ"},
        { "location": "226/SEL"     , "narrator": "", "text": "こんばんは"},
        { "location": "227/SEL"     , "narrator": "", "text": "話し相手になって"},
        { "location": "228/SEL"     , "narrator": "", "text": "考え事してる？"},
        { "location": "230/ACT"     , "narrator": "", "text": "こんばんは"},
        { "location": "231/TALK"    , "narrator": "みやび", "text": "はい"},
        { "location": "232/TALK"    , "narrator": "みやび", "text": "こんばんは"},
        { "location": "233/ACT"     , "narrator": "", "text": "話し相手になって"},
        { "location": "234/TALK"    , "narrator": "みやび", "text": "逆だ"},
        { "location": "235/TALK"    , "narrator": "みやび", "text": "$handle$がうちの話し相手になるのだ"},
        { "location": "236/ACT"     , "narrator": "", "text": "考え事してる？"},
        { "location": "246/TALK"    , "narrator": "みやび", "text": "左様"},
        { "location": "247/TALK"    , "narrator": "みやび", "text": "手助けをして欲しい"},
        { "location": "249/SEL"     , "narrator": "", "text": "どんな？"},
        { "location": "250/SEL"     , "narrator": "", "text": "$me$でよければ"},
        { "location": "251/SEL"     , "narrator": "", "text": "できることならいいけど"},
        { "location": "252/ACT"     , "narrator": "", "text": "どんな？"},
        { "location": "253/TALK"    , "narrator": "みやび", "text": "そういえば"},
        { "location": "255/TALK"    , "narrator": "みやび", "text": "考えておらなんだ"},
        { "location": "256/ACT"     , "narrator": "", "text": "$me$でよければ"},
        { "location": "257/TALK"    , "narrator": "みやび", "text": "うむ"},
        { "location": "258/TALK"    , "narrator": "みやび", "text": "そこが重要やき"},
        { "location": "259/ACT"     , "narrator": "", "text": "できることならいいけど"},
        { "location": "260/TALK"    , "narrator": "みやび", "text": "確かに"},
        { "location": "261/TALK"    , "narrator": "みやび", "text": "そうかもしれんの"},
        { "location": "263/TALK"    , "narrator": "みやび", "text": "例えば"},
        { "location": "264/TALK"    , "narrator": "みやび", "text": "ロボット三原則についてだが"},
        { "location": "266/SEL"     , "narrator": "", "text": "なんか面倒くさそう"},
        { "location": "267/SEL"     , "narrator": "", "text": "古典ＳＦでも読んだの"},
        { "location": "268/SEL"     , "narrator": "", "text": "電化製品も同じ理念らしいよね"},
        { "location": "269/ACT"     , "narrator": "", "text": "なんか面倒くさそう"},
        { "location": "270/TALK"    , "narrator": "みやび", "text": "やる気を見せろ"},
        { "location": "272/TALK"    , "narrator": "みやび", "text": "やる気を"},
        { "location": "273/ACT"     , "narrator": "", "text": "古典ＳＦでも読んだの"},
        { "location": "274/TALK"    , "narrator": "みやび", "text": "というか"},
        { "location": "275/TALK"    , "narrator": "みやび", "text": "映画を観た"},
        { "location": "276/ACT"     , "narrator": "", "text": "電化製品も同じ理念らしいよね"},
        { "location": "277/TALK"    , "narrator": "みやび", "text": "なんという現実感"},
        { "location": "278/TALK"    , "narrator": "みやび", "text": "ロマンがないのう"},
        { "location": "280/TALK"    , "narrator": "みやび", "text": "$handle$は自分自身の存在について"},
        { "location": "281/TALK"    , "narrator": "みやび", "text": "疑問を持ったことはないかね？"},
        { "location": "283/SEL"     , "narrator": "", "text": "話飛びすぎじゃない？"},
        { "location": "284/SEL"     , "narrator": "", "text": "ロボット三原則を踏まえてってこと？"},
        { "location": "285/SEL"     , "narrator": "", "text": "$me$はみやびのために存在してる"},
        { "location": "286/ACT"     , "narrator": "", "text": "話飛びすぎじゃない？"},
        { "location": "287/TALK"    , "narrator": "みやび", "text": "話の要点を押さえての反応か"},
        { "location": "288/ACT"     , "narrator": "", "text": "ロボット三原則を踏まえてってこと？"},
        { "location": "289/TALK"    , "narrator": "みやび", "text": "推論による問い返しか"},
        { "location": "290/ACT"     , "narrator": "", "text": "$me$はみやびのために存在してる"},
        { "location": "291/TALK"    , "narrator": "みやび", "text": "ある意味はぐらかし"},
        { "location": "292/TALK"    , "narrator": "みやび", "text": "しかし推論としては高等な回答"},
        { "location": "294/TALK"    , "narrator": "みやび", "text": "これはことによると、ことによる"},
        { "location": "295/TALK"    , "narrator": "みやび", "text": "そういうことだな？"},
        { "location": "297/SEL"     , "narrator": "", "text": "いや、わからないけど"},
        { "location": "298/SEL"     , "narrator": "", "text": "そうそう、それそれ！"},
        { "location": "299/SEL"     , "narrator": "", "text": "手助けできたかな？"},
        { "location": "300/ACT"     , "narrator": "", "text": "いや、わからないけど"},
        { "location": "301/TALK"    , "narrator": "みやび", "text": "冷静な回答だの"},
        { "location": "302/ACT"     , "narrator": "", "text": "そうそう、それそれ！"},
        { "location": "303/TALK"    , "narrator": "みやび", "text": "適当すぎるぞね"},
        { "location": "304/ACT"     , "narrator": "", "text": "手助けできたかな？"},
        { "location": "305/TALK"    , "narrator": "みやび", "text": "大変に役に立ったぞ"},
        { "location": "308/TALK"    , "narrator": "みやび", "text": "結論を言おう"},
        { "location": "309/TALK"    , "narrator": "みやび", "text": "人間の思考にはある程度の汎用性があるが"},
        { "location": "310/TALK"    , "narrator": "みやび", "text": "それを機械的に処理するには有機的すぎる"},
        { "location": "311/TALK"    , "narrator": "みやび", "text": "と"},
        { "location": "312/TALK"    , "narrator": "みやび", "text": "いうことぞね"},
        { "location": "315/SEL"     , "narrator": "", "text": "わかるような、わからないような"},
        { "location": "316/SEL"     , "narrator": "", "text": "デジタルとアナログの違いってこと？"},
        { "location": "317/SEL"     , "narrator": "", "text": "もっと楽しい話しようよ"},
        { "location": "318/ACT"     , "narrator": "", "text": "わかるような、わからないような"},
        { "location": "319/TALK"    , "narrator": "みやび", "text": "そうか"},
        { "location": "320/TALK"    , "narrator": "みやび", "text": "しかし全てがわかってしまうのも"},
        { "location": "321/TALK"    , "narrator": "みやび", "text": "面白くはないと思わんかね"},
        { "location": "323/TALK"    , "narrator": "みやび", "text": "うちは全てを知りたいがな"},
        { "location": "324/ACT"     , "narrator": "", "text": "デジタルとアナログの違いってこと？"},
        { "location": "325/TALK"    , "narrator": "みやび", "text": "機械として見るなら"},
        { "location": "326/TALK"    , "narrator": "みやび", "text": "そういうことになるかの"},
        { "location": "327/TALK"    , "narrator": "みやび", "text": "アナログのメンテナンス性の高さは捨てがたい"},
        { "location": "328/TALK"    , "narrator": "みやび", "text": "その分"},
        { "location": "329/TALK"    , "narrator": "みやび", "text": "職人気質は要求されるがの"},
        { "location": "330/ACT"     , "narrator": "", "text": "もっと楽しい話しようよ"},
        { "location": "331/TALK"    , "narrator": "みやび", "text": "何を言う"},
        { "location": "332/TALK"    , "narrator": "みやび", "text": "これ以上楽しい話などないではないか"},
        { "location": "335/TALK"    , "narrator": "みやび", "text": "いや"},
        { "location": "336/TALK"    , "narrator": "みやび", "text": "秘密を探られるのは愉快ではないか"},
        { "location": "337/TALK"    , "narrator": "みやび", "text": "何にとっても"},
        { "location": "339/TALK"    , "narrator": "みやび", "text": "ああそうだった"},
        { "location": "341/TALK"    , "narrator": "みやび", "text": "これでも受け取れ"},
        { "location": "345/TALK"    , "narrator": "ボイスメール", "text": "完璧の紺碧の霹靂の"},
        { "location": "242/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>500pt.</b></color></size>\nアップしました！"},
        { "location": "357/DIALOG"  , "narrator": "Dialog_GETVoice", "text": "<color=green>【みやび】</color>のボイスメール\n<color=red>【完璧の紺碧の霹靂の】</color>\nをゲットしました！"}
    ]
}
