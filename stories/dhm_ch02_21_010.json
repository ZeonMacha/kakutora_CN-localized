    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "アーヤの恐怖報告"},
        { "location": "34/TALK"   , "narrator": "アーヤ", "text": "いる？"},
        { "location": "36/SEL"    , "narrator": "", "text": "いる"},
        { "location": "37/SEL"    , "narrator": "", "text": "いないし"},
        { "location": "38/SEL"    , "narrator": "", "text": "どうしたの？"},
        { "location": "39/ACT"    , "narrator": "", "text": "いる"},
        { "location": "40/TALK"   , "narrator": "アーヤ", "text": "よかったわ"},
        { "location": "41/TALK"   , "narrator": "アーヤ", "text": "いてくれて"},
        { "location": "42/ACT"    , "narrator": "", "text": "いないし"},
        { "location": "43/TALK"   , "narrator": "アーヤ", "text": "またそんな"},
        { "location": "44/TALK"   , "narrator": "アーヤ", "text": "冗談ばっかり"},
        { "location": "45/ACT"    , "narrator": "", "text": "どうしたの？"},
        { "location": "46/TALK"   , "narrator": "アーヤ", "text": "えと"},
        { "location": "48/TALK"   , "narrator": "アーヤ", "text": "どうしたって"},
        { "location": "49/TALK"   , "narrator": "アーヤ", "text": "いうか"},
        { "location": "51/TALK"   , "narrator": "アーヤ", "text": "昼間の話よ"},
        { "location": "52/TALK"   , "narrator": "アーヤ", "text": "霊気を感じるとか"},
        { "location": "53/TALK"   , "narrator": "アーヤ", "text": "そういうやつ"},
        { "location": "56/TALK"   , "narrator": "アーヤ", "text": "それって"},
        { "location": "57/TALK"   , "narrator": "アーヤ", "text": "本当なの？"},
        { "location": "58/TALK"   , "narrator": "アーヤ", "text": "そんな機能が"},
        { "location": "59/TALK"   , "narrator": "アーヤ", "text": "あったりするの？"},
        { "location": "61/SEL"    , "narrator": "", "text": "ごめんなさい、冗談です"},
        { "location": "62/SEL"    , "narrator": "", "text": "機能じゃなくて$me$の能力"},
        { "location": "63/SEL"    , "narrator": "", "text": "背後に気を付けろ"},
        { "location": "64/ACT"    , "narrator": "", "text": "ごめんなさい、冗談です"},
        { "location": "66/TALK"   , "narrator": "アーヤ", "text": "やっぱり"},
        { "location": "67/TALK"   , "narrator": "アーヤ", "text": "そうなのね（；￢＿￢）"},
        { "location": "68/TALK"   , "narrator": "アーヤ", "text": "そういう冗談は面白くないわ"},
        { "location": "69/TALK"   , "narrator": "アーヤ", "text": "でも"},
        { "location": "71/TALK"   , "narrator": "アーヤ", "text": "謝ってくれたから"},
        { "location": "72/TALK"   , "narrator": "アーヤ", "text": "まあいいわよ(´o｀；"},
        { "location": "73/ACT"    , "narrator": "", "text": "機能じゃなくて$me$の能力"},
        { "location": "74/TALK"   , "narrator": "アーヤ", "text": "え"},
        { "location": "75/TALK"   , "narrator": "アーヤ", "text": "そうなの"},
        { "location": "76/TALK"   , "narrator": "アーヤ", "text": "じゃあ"},
        { "location": "77/TALK"   , "narrator": "アーヤ", "text": "本物なのね"},
        { "location": "80/TALK"   , "narrator": "アーヤ", "text": "実は私もたまにね"},
        { "location": "81/TALK"   , "narrator": "アーヤ", "text": "気になることがあるの"},
        { "location": "82/TALK"   , "narrator": "アーヤ", "text": "みんなが怖がるから"},
        { "location": "84/TALK"   , "narrator": "アーヤ", "text": "言わないようにしてるけど、、、"},
        { "location": "85/TALK"   , "narrator": "アーヤ", "text": "苦労するわねお互い"},
        { "location": "86/TALK"   , "narrator": "アーヤ", "text": "そういうのって"},
        { "location": "87/ACT"    , "narrator": "", "text": "背後に気を付けろ"},
        { "location": "88/TALK"   , "narrator": "アーヤ", "text": "ちょっと"},
        { "location": "89/TALK"   , "narrator": "アーヤ", "text": "まだ続けるの？"},
        { "location": "90/TALK"   , "narrator": "アーヤ", "text": "本気でやめて\n（ノ ﾟДﾟ）ノ\n　　＝＝＝＝　┻━━┻ "},
        { "location": "91/TALK"   , "narrator": "アーヤ", "text": "それにね"},
        { "location": "92/TALK"   , "narrator": "アーヤ", "text": "そういうのは"},
        { "location": "93/TALK"   , "narrator": "アーヤ", "text": "現実になるのよ"},
        { "location": "94/TALK"   , "narrator": "アーヤ", "text": "だから本当に"},
        { "location": "95/TALK"   , "narrator": "アーヤ", "text": "そういう冗談はやめて"},
        { "location": "96/TALK"   , "narrator": "アーヤ", "text": "わかった？"}
    ]
}
