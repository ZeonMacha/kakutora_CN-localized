    "entry":
    [
        { "location": "178/SCENARIO", "narrator": "", "text": "230_異性化糖の糖度は如何に"},
        { "location": "203/TALK"    , "narrator": "みやび", "text": "貴殿の糖度は"},
        { "location": "204/TALK"    , "narrator": "みやび", "text": "どの程度かね"},
        { "location": "206/SEL"     , "narrator": "", "text": "糖度って何"},
        { "location": "207/ACT"     , "narrator": "", "text": "糖度って何"},
        { "location": "208/TALK"    , "narrator": "みやび", "text": "そんなことも知らんのか"},
        { "location": "210/TALK"    , "narrator": "みやび", "text": "糖の含有量ぞね"},
        { "location": "212/TALK"    , "narrator": "みやび", "text": "転じて"},
        { "location": "213/TALK"    , "narrator": "みやび", "text": "恋人同士などのいちゃつき度を指す"},
        { "location": "215/TALK"    , "narrator": "みやび", "text": "主に乙女ゲームで"},
        { "location": "218/SEL"     , "narrator": "", "text": "乙女ゲームとかやらないし"},
        { "location": "219/SEL"     , "narrator": "", "text": "ほどほどの甘さかな……"},
        { "location": "220/SEL"     , "narrator": "", "text": "百パーだね！"},
        { "location": "221/ACT"     , "narrator": "", "text": "乙女ゲームとかやらないし"},
        { "location": "222/TALK"    , "narrator": "みやび", "text": "それは困った"},
        { "location": "224/TALK"    , "narrator": "みやび", "text": "乙女心のわからんちんは"},
        { "location": "225/TALK"    , "narrator": "みやび", "text": "お呼びでないぞね"},
        { "location": "226/ACT"     , "narrator": "", "text": "ほどほどの甘さかな……"},
        { "location": "227/TALK"    , "narrator": "みやび", "text": "それはヘルシー"},
        { "location": "228/TALK"    , "narrator": "みやび", "text": "かつ現代的"},
        { "location": "229/TALK"    , "narrator": "みやび", "text": "しかし"},
        { "location": "230/TALK"    , "narrator": "みやび", "text": "面白くはないぞね"},
        { "location": "231/ACT"     , "narrator": "", "text": "百パーだね！"},
        { "location": "234/TALK"    , "narrator": "みやび", "text": "軽々しくそんなことを"},
        { "location": "235/TALK"    , "narrator": "みやび", "text": "そもそもそのパーセンテージは"},
        { "location": "236/TALK"    , "narrator": "みやび", "text": "どこから算出されておるのだ"},
        { "location": "238/SEL"     , "narrator": "", "text": "$me$の気持ち"},
        { "location": "239/SEL"     , "narrator": "", "text": "みやびの気持ち"},
        { "location": "240/ACT"     , "narrator": "", "text": "$me$の気持ち"},
        { "location": "241/TALK"    , "narrator": "みやび", "text": "なるほど"},
        { "location": "242/TALK"    , "narrator": "みやび", "text": "今度じっくり"},
        { "location": "244/TALK"    , "narrator": "みやび", "text": "見せてもらおうぞ"},
        { "location": "245/ACT"     , "narrator": "", "text": "みやびの気持ち"},
        { "location": "246/TALK"    , "narrator": "みやび", "text": "言うに事欠いてそんなことを"},
        { "location": "247/TALK"    , "narrator": "みやび", "text": "仕方ない"},
        { "location": "248/TALK"    , "narrator": "みやび", "text": "そう思っておけ"},
        { "location": "251/TALK"    , "narrator": "みやび", "text": "ちなみにだ"},
        { "location": "254/TALK"    , "narrator": "ボイスメール", "text": "あまいあまいあまいあまい"},
        { "location": "272/TALK"    , "narrator": "みやび", "text": "うちの見解ぞね"},
        { "location": "266/DIALOG"  , "narrator": "Dialog_GETVoice", "text": "<color=green>【みやび】</color>のボイスメール\n<color=red>【あまいあまいあまいあまい】</color>\nをゲットしました！"}
    ]
}
