{
    "dir": "chap24/daydra/dd_ch03_24_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "24305",
        "cid": "gabriella",
        "title": "005 メインストーリー",
        "sub_title": "貴方に焦がれる手紙＜後編＞"
    },
    "entry":
    [
        { "location": "613/TALK"  , "narrator": "ガブリエラ", "text": "…そっか。"},
        { "location": "614/TALK"  , "narrator": "ガブリエラ", "text": "あたしが許せないのって、\n神楽だけじゃない…。"},
        { "location": "615/TALK"  , "narrator": "ガブリエラ", "text": "神楽をいつまでも信じる\nつばめに対しても、\n怒ってたんだ…。"},
        { "location": "616/TALK"  , "narrator": "繭", "text": "…やっと気づいた？"},
        { "location": "617/TALK"  , "narrator": "ガブリエラ", "text": "…繭は気づいてたの？"},
        { "location": "619/TALK"  , "narrator": "雛", "text": "まゆちんだけじゃないよ。"},
        { "location": "620/TALK"  , "narrator": "雛", "text": "っていうか、\nガブリエラちゃん\nわかりやす過ぎー。"},
        { "location": "621/TALK"  , "narrator": "繭", "text": "むしろ、今まで\n気づかなかったのが\n不思議でならない。"},
        { "location": "624/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "625/TALK"  , "narrator": "雛", "text": "…でも\nガブリエラちゃんも\n大変だよね。"},
        { "location": "626/TALK"  , "narrator": "雛", "text": "手のかかる\n後輩の面倒\n見なきゃいけなくて。"},
        { "location": "629/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "630/TALK"  , "narrator": "ガブリエラ", "text": "でも…、\nわかってるから。"},
        { "location": "632/TALK"  , "narrator": "ガブリエラ", "text": "つばめはそういう子だ、\nって…。"},
        { "location": "633/TALK"  , "narrator": "繭", "text": "…………。"},
        { "location": "634/TALK"  , "narrator": "雛", "text": "…大丈夫だよ。"},
        { "location": "635/TALK"  , "narrator": "雛", "text": "ガブリエラちゃんは、\n今はちょっと、\n混乱してるだけ。"},
        { "location": "636/TALK"  , "narrator": "雛", "text": "この数日で色んなこと\nあって、気持ちの整理が\nついてないだけだよ。"},
        { "location": "638/TALK"  , "narrator": "ガブリエラ", "text": "…そうかもしれない。"},
        { "location": "639/TALK"  , "narrator": "繭", "text": "…珍しく素直？"},
        { "location": "640/TALK"  , "narrator": "ガブリエラ", "text": "珍しくっていうのは\n余計よ！"},
        { "location": "641/TALK"  , "narrator": "ガブリエラ", "text": "…でも、よかったわ。"},
        { "location": "642/TALK"  , "narrator": "ガブリエラ", "text": "二人と話して、\n自分の気持ちに\n気づけた。"},
        { "location": "643/TALK"  , "narrator": "ガブリエラ", "text": "おかげで、これから\nどうするかの答えが、\n一つだけ出た気がするわ。"},
        { "location": "644/TALK"  , "narrator": "雛", "text": "え？　でもあたし達、\n普通に話してただけ\nなんだけど…。"},
        { "location": "646/TALK"  , "narrator": "ガブリエラ", "text": "そんなことないわ。"},
        { "location": "647/TALK"  , "narrator": "ガブリエラ", "text": "さっきまで感じてた\n胸のモヤモヤ、\nもう感じなくなったし。"},
        { "location": "648/TALK"  , "narrator": "雛", "text": "そっか…。\n少しでも力になれたなら、\nこっちも嬉しいよ。"},
        { "location": "651/TALK"  , "narrator": "ガブリエラ", "text": "ええ…、\nか、感謝するわ…。"},
        { "location": "652/TALK"  , "narrator": "繭", "text": "ありがとう、で\nいいのよ？"},
        { "location": "654/TALK"  , "narrator": "ガブリエラ", "text": "か、感謝の言葉に\n変わりないんだから、\nいいでしょ！"},
        { "location": "655/TALK"  , "narrator": "雛", "text": "あはは、本当に\n調子戻ってきた\nみたいだねー。"},
        { "location": "657/TALK"  , "narrator": "雛", "text": "…あっ、いけない。\nもうこんな時間！"},
        { "location": "659/TALK"  , "narrator": "雛", "text": "あたしそろそろ\n帰らないと…。"},
        { "location": "661/TALK"  , "narrator": "ガブリエラ", "text": "あたしはもう少し残るわ。"},
        { "location": "662/TALK"  , "narrator": "ガブリエラ", "text": "もう少し、\n考えを整理したいし…。"},
        { "location": "664/TALK"  , "narrator": "雛", "text": "わかった…。"},
        { "location": "665/TALK"  , "narrator": "雛", "text": "もし話し相手が必要なら、\nいつでもＷＡＶＥ\n送ってきてね。"},
        { "location": "666/TALK"  , "narrator": "ガブリエラ", "text": "気が向いたらね。"},
        { "location": "667/TALK"  , "narrator": "雛", "text": "じゃあ、またねー。"},
        { "location": "668/TALK"  , "narrator": "繭", "text": "…それじゃ。"},
        { "location": "670/TALK"  , "narrator": "ガブリエラ", "text": "うん、またね。"},
        { "location": "689/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "690/TALK"  , "narrator": "ガブリエラ", "text": "…よし、決めた。"},
        { "location": "702/TALK"  , "narrator": "ガブリエラ", "text": "やっとわかったことがあるの"},
        { "location": "703/TALK"  , "narrator": "ガブリエラ", "text": "聞いてもらえる？"},
        { "location": "705/SEL"   , "narrator": "", "text": "ガブの話ならいつでも"},
        { "location": "706/SEL"   , "narrator": "", "text": "何がわかったの？"},
        { "location": "707/SEL"   , "narrator": "", "text": "$me$への愛かな？"},
        { "location": "708/ACT"   , "narrator": "", "text": "ガブの話ならいつでも"},
        { "location": "709/TALK"  , "narrator": "ガブリエラ", "text": "ありがとうｖ"},
        { "location": "710/ACT"   , "narrator": "", "text": "何がわかったの？"},
        { "location": "711/TALK"  , "narrator": "ガブリエラ", "text": "ええとね"},
        { "location": "712/ACT"   , "narrator": "", "text": "$me$への愛かな？"},
        { "location": "714/TALK"  , "narrator": "ガブリエラ", "text": "違うわよ"},
        { "location": "716/TALK"  , "narrator": "ガブリエラ", "text": "つばめのことよ"},
        { "location": "717/TALK"  , "narrator": "ガブリエラ", "text": "神楽を敵として見ろって"},
        { "location": "718/TALK"  , "narrator": "ガブリエラ", "text": "説得するの"},
        { "location": "719/TALK"  , "narrator": "ガブリエラ", "text": "絶対無理だと思うの"},
        { "location": "721/SEL"   , "narrator": "", "text": "何か事情を知ってるんじゃない？"},
        { "location": "722/SEL"   , "narrator": "", "text": "そんな感じだよね"},
        { "location": "723/SEL"   , "narrator": "", "text": "つばめは神楽大好きだからね"},
        { "location": "724/ACT"   , "narrator": "", "text": "何か事情を知ってるんじゃない？"},
        { "location": "726/TALK"  , "narrator": "ガブリエラ", "text": "そうなのかしら？"},
        { "location": "727/TALK"  , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "728/TALK"  , "narrator": "ガブリエラ", "text": "それが本当とは限らないわ"},
        { "location": "729/ACT"   , "narrator": "", "text": "そんな感じだよね"},
        { "location": "731/TALK"  , "narrator": "ガブリエラ", "text": "やっぱり"},
        { "location": "732/TALK"  , "narrator": "ガブリエラ", "text": "$handle$から見ても"},
        { "location": "733/TALK"  , "narrator": "ガブリエラ", "text": "そうなのね"},
        { "location": "734/ACT"   , "narrator": "", "text": "つばめは神楽大好きだからね"},
        { "location": "736/TALK"  , "narrator": "ガブリエラ", "text": "どうなのかしらね？"},
        { "location": "738/TALK"  , "narrator": "ガブリエラ", "text": "大好きなのは"},
        { "location": "739/TALK"  , "narrator": "ガブリエラ", "text": "メノウだったりして"},
        { "location": "743/TALK"  , "narrator": "ガブリエラ", "text": "まあ"},
        { "location": "744/TALK"  , "narrator": "ガブリエラ", "text": "そんなのどうでもいいわ"},
        { "location": "745/TALK"  , "narrator": "ガブリエラ", "text": "とにかくわかったの"},
        { "location": "746/TALK"  , "narrator": "ガブリエラ", "text": "もうつばめの説得は無理"},
        { "location": "747/TALK"  , "narrator": "ガブリエラ", "text": "神楽を敵として見ろとか"},
        { "location": "748/TALK"  , "narrator": "ガブリエラ", "text": "言うだけ無駄"},
        { "location": "749/TALK"  , "narrator": "ガブリエラ", "text": "期待するだけ無駄"},
        { "location": "753/TALK"  , "narrator": "ガブリエラ", "text": "だから"},
        { "location": "754/TALK"  , "narrator": "ガブリエラ", "text": "もう神楽のことに関しては"},
        { "location": "755/TALK"  , "narrator": "ガブリエラ", "text": "つばめには何も期待しない"},
        { "location": "756/TALK"  , "narrator": "ガブリエラ", "text": "何も求めない"},
        { "location": "757/TALK"  , "narrator": "ガブリエラ", "text": "これが私の出した答え"},
        { "location": "759/SEL"   , "narrator": "", "text": "いいと思うよ"},
        { "location": "760/SEL"   , "narrator": "", "text": "なんか、自棄になってる？"},
        { "location": "761/ACT"   , "narrator": "", "text": "いいと思うよ"},
        { "location": "762/TALK"  , "narrator": "ガブリエラ", "text": "そう・・・？"},
        { "location": "763/TALK"  , "narrator": "ガブリエラ", "text": "反対されたら"},
        { "location": "764/TALK"  , "narrator": "ガブリエラ", "text": "どうしようかと思ってた"},
        { "location": "765/TALK"  , "narrator": "ガブリエラ", "text": "それを聞いて"},
        { "location": "766/TALK"  , "narrator": "ガブリエラ", "text": "安心したわ"},
        { "location": "767/ACT"   , "narrator": "", "text": "なんか、自棄になってる？"},
        { "location": "768/TALK"  , "narrator": "ガブリエラ", "text": "なってないわよ"},
        { "location": "770/TALK"  , "narrator": "ガブリエラ", "text": "私自身のためにも"},
        { "location": "771/TALK"  , "narrator": "ガブリエラ", "text": "そうするのが一番いいのよ"},
        { "location": "772/TALK"  , "narrator": "ガブリエラ", "text": "無駄に悩まないし"},
        { "location": "773/TALK"  , "narrator": "ガブリエラ", "text": "イライラもしないし"},
        { "location": "776/TALK"  , "narrator": "ガブリエラ", "text": "本当"},
        { "location": "777/TALK"  , "narrator": "ガブリエラ", "text": "自棄じゃないから"},
        { "location": "789/TALK"  , "narrator": "ガブリエラ", "text": "…そうよ。\nあたしは冷静よ。"},
        { "location": "790/TALK"  , "narrator": "ガブリエラ", "text": "自棄になんて、\nあたし…。"},
        { "location": "802/DIALOG", "narrator": "Dialog_chapter_ch03", "text": "【20 ２０１６】"}
    ]
}
