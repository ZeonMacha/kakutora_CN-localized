        { "location": "7/SCENARIO", "narrator": "", "text": "666_まいごのまいごのみやびさん（ガブリエラ編）"},
        { "location": "31/TALK"   , "narrator": "ガブリエラ", "text": "こんばんは"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "いい夜ねｖｖｖ"},
        { "location": "34/SEL"    , "narrator": "", "text": "悪い夜だよ"},
        { "location": "35/SEL"    , "narrator": "", "text": "聞きたいことがあるんだ"},
        { "location": "36/SEL"    , "narrator": "", "text": "そうだね"},
        { "location": "37/ACT"    , "narrator": "", "text": "悪い夜だよ"},
        { "location": "38/TALK"   , "narrator": "ガブリエラ", "text": "あら"},
        { "location": "40/TALK"   , "narrator": "ガブリエラ", "text": "何かあったのかしら！？"},
        { "location": "41/ACT"    , "narrator": "", "text": "聞きたいことがあるんだ"},
        { "location": "42/TALK"   , "narrator": "ガブリエラ", "text": "わかったわ"},
        { "location": "43/TALK"   , "narrator": "ガブリエラ", "text": "何かしら？"},
        { "location": "44/ACT"    , "narrator": "", "text": "そうだね"},
        { "location": "45/TALK"   , "narrator": "ガブリエラ", "text": "あら？"},
        { "location": "46/TALK"   , "narrator": "ガブリエラ", "text": "気になることでもあるのかしら？"},
        { "location": "49/SEL"    , "narrator": "", "text": "みやびを知らない？"},
        { "location": "50/SEL"    , "narrator": "", "text": "みやびを返して"},
        { "location": "51/SEL"    , "narrator": "", "text": "みやび、どこにいるのかな"},
        { "location": "52/ACT"    , "narrator": "", "text": "みやびを知らない？"},
        { "location": "53/TALK"   , "narrator": "ガブリエラ", "text": "あら"},
        { "location": "54/TALK"   , "narrator": "ガブリエラ", "text": "またそのこと？"},
        { "location": "55/ACT"    , "narrator": "", "text": "みやびを返して"},
        { "location": "56/TALK"   , "narrator": "ガブリエラ", "text": "別に"},
        { "location": "57/TALK"   , "narrator": "ガブリエラ", "text": "取り上げてなんてないわよ"},
        { "location": "58/ACT"    , "narrator": "", "text": "みやび、どこにいるのかな"},
        { "location": "59/TALK"   , "narrator": "ガブリエラ", "text": "さあ"},
        { "location": "61/TALK"   , "narrator": "ガブリエラ", "text": "どこにいるのかしらね"},
        { "location": "63/TALK"   , "narrator": "ガブリエラ", "text": "みやびにも色々あるんだと思うわよ"},
        { "location": "64/TALK"   , "narrator": "ガブリエラ", "text": "そっとしておいてあげた方が"},
        { "location": "65/TALK"   , "narrator": "ガブリエラ", "text": "いいんじゃないしらね"}
    ]
