    "entry":
    [
        { "location": "530/SCENARIO", "narrator": "", "text": "絵師と呼ばないで★"},
        { "location": "555/TALK"    , "narrator": "神楽", "text": "かわいい女の子しか描きたくなーい！！！！"},
        { "location": "556/TALK"    , "narrator": "神楽", "text": "かわいくてちょっとえっちな女の子は正義！！！！！"},
        { "location": "558/SEL"     , "narrator": "", "text": "神楽の絵かわいいよ"},
        { "location": "559/SEL"     , "narrator": "", "text": "え、エッチなの！？"},
        { "location": "560/SEL"     , "narrator": "", "text": "全裸で正座待機！"},
        { "location": "561/ACT"     , "narrator": "", "text": "神楽の絵かわいいよ"},
        { "location": "562/TALK"    , "narrator": "神楽", "text": "ホッホッホッホッ"},
        { "location": "564/TALK"    , "narrator": "神楽", "text": "当然でしょ♪"},
        { "location": "565/ACT"     , "narrator": "", "text": "え、エッチなの！？"},
        { "location": "566/TALK"    , "narrator": "神楽", "text": "じゃなきゃ意味ないし"},
        { "location": "567/ACT"     , "narrator": "", "text": "全裸で正座待機！"},
        { "location": "569/TALK"    , "narrator": "神楽", "text": "うんうん"},
        { "location": "570/TALK"    , "narrator": "神楽", "text": "正直でよろしい"},
        { "location": "571/TALK"    , "narrator": "神楽", "text": "そういうの大事ガチで大事"},
        { "location": "573/TALK"    , "narrator": "神楽", "text": "本人が天然だったり無自覚だったとしてもエロスはどこかに潜んでる"},
        { "location": "574/TALK"    , "narrator": "神楽", "text": "それをさりげなくかつ大胆に描写するのがぴょんこの画風"},
        { "location": "576/SEL"     , "narrator": "", "text": "あ…そうなんだ…"},
        { "location": "577/SEL"     , "narrator": "", "text": "ぴょんこ先生一生付いていきます！"},
        { "location": "578/SEL"     , "narrator": "", "text": "あざとすぎる気もするけど"},
        { "location": "579/ACT"     , "narrator": "", "text": "あ…そうなんだ…"},
        { "location": "580/TALK"    , "narrator": "神楽", "text": "何か引き気味？"},
        { "location": "581/ACT"     , "narrator": "", "text": "ぴょんこ先生一生付いていきます！"},
        { "location": "583/TALK"    , "narrator": "神楽", "text": "よしよし"},
        { "location": "584/TALK"    , "narrator": "神楽", "text": "$handlek$はその身を一生ぴょんこに捧げると誓うのね♪"},
        { "location": "585/TALK"    , "narrator": "神楽", "text": "いいよー全然いいよー"},
        { "location": "586/ACT"     , "narrator": "", "text": "あざとすぎる気もするけど"},
        { "location": "587/TALK"    , "narrator": "神楽", "text": "そんなのあたりまえ"},
        { "location": "588/TALK"    , "narrator": "神楽", "text": "こちとら評価が欲しいんじゃ"},
        { "location": "590/TALK"    , "narrator": "神楽", "text": "そんなぴょんこ先生"},
        { "location": "591/TALK"    , "narrator": "神楽", "text": "こう見えても覆面作家なのでイベントには不参加にならざるを得ない"},
        { "location": "592/TALK"    , "narrator": "神楽", "text": "それだけが悩みの種"},
        { "location": "594/SEL"     , "narrator": "", "text": "この人本気だよ"},
        { "location": "595/SEL"     , "narrator": "", "text": "お、おう…"},
        { "location": "596/SEL"     , "narrator": "", "text": "代わりに売ってきてあげる"},
        { "location": "597/ACT"     , "narrator": "", "text": "この人本気だよ"},
        { "location": "598/TALK"    , "narrator": "神楽", "text": "ですよ？"},
        { "location": "599/TALK"    , "narrator": "神楽", "text": "本気なんですからね！"},
        { "location": "600/ACT"     , "narrator": "", "text": "お、おう…"},
        { "location": "601/TALK"    , "narrator": "神楽", "text": "どうにも$handlek$にこの悩みが伝わらないのが残念すぎる"},
        { "location": "604/ACT"     , "narrator": "", "text": "代わりに売ってきてあげる"},
        { "location": "605/TALK"    , "narrator": "神楽", "text": "なんですと！？"},
        { "location": "606/TALK"    , "narrator": "神楽", "text": "売るではない頒布でござる"},
        { "location": "607/TALK"    , "narrator": "神楽", "text": "なぜなら布教活動は非営利でござる"},
        { "location": "608/TALK"    , "narrator": "神楽", "text": "ぴょんこは言葉に敏感でござるゆえ"},
        { "location": "609/TALK"    , "narrator": "神楽", "text": "$handlek$に売り子を任せるのは無理ジャネ！？という結論に達した！！！！"},
        { "location": "610/TALK"    , "narrator": "神楽", "text": "残念すぎる―――！！！！"}
    ]
}
