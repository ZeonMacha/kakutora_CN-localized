{
    "dir": "chap12/daydra/dd_ch04_12_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "12456",
        "cid": "miyabi",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "ソフトボールの練習"
    },
    "entry":
    [
        { "location": "291/SCENARIO", "narrator": "", "text": "ソフトボールの練習"},
        { "location": "306/TALK"    , "narrator": "キリト", "text": "よし、二人とも、\nグローブはちゃんと\nはめたな？"},
        { "location": "308/TALK"    , "narrator": "つばめ", "text": "うん。\nよろしくお願いします。"},
        { "location": "310/TALK"    , "narrator": "雛", "text": "キリト、本気で\nお願いね。"},
        { "location": "311/TALK"    , "narrator": "キリト", "text": "後で後悔すんなよ。"},
        { "location": "313/TALK"    , "narrator": "ヒカル", "text": "キリト、ほどほどに\nしないとダメですよ？"},
        { "location": "314/TALK"    , "narrator": "キリト", "text": "心配すんなって。"},
        { "location": "322/TALK"    , "narrator": "ヒカル", "text": "二人とも、頑張って！"},
        { "location": "324/TALK"    , "narrator": "みやび", "text": "…元気やねぇ。"},
        { "location": "326/TALK"    , "narrator": "ヒカル", "text": "あ、みやび先輩。"},
        { "location": "328/TALK"    , "narrator": "みやび", "text": "球技大会の\n練習しゆうが？"},
        { "location": "329/TALK"    , "narrator": "ヒカル", "text": "はい。"},
        { "location": "330/TALK"    , "narrator": "ヒカル", "text": "二人とも、\nソフトボールの経験が\nないというので――"},
        { "location": "331/TALK"    , "narrator": "ヒカル", "text": "キリトがコーチについて、\n守備の練習中なんです。"},
        { "location": "334/TALK"    , "narrator": "みやび", "text": "精が出ちゅうねぇ…。"},
        { "location": "335/TALK"    , "narrator": "ヒカル", "text": "…みやび先輩は、\n練習しなくて\nいいんですか？"},
        { "location": "337/TALK"    , "narrator": "みやび", "text": "体育の授業と同じで\n適当に流すき、\n練習はいらんがよ。"},
        { "location": "338/TALK"    , "narrator": "ヒカル", "text": "…みやび先輩。\nそれは少々、問題発言かと\n思います。"},
        { "location": "339/TALK"    , "narrator": "ヒカル", "text": "個人ならまだしも、\nソフトボールはチームで\nプレイするものですし。"},
        { "location": "341/TALK"    , "narrator": "みやび", "text": "練習が面倒で言うてる\nわけやないんよ。"},
        { "location": "342/TALK"    , "narrator": "みやび", "text": "去年の大会の時にな、\nちっくと真剣に\n力入れてやったら――"},
        { "location": "344/TALK"    , "narrator": "みやび", "text": "ボールが変なところに\nばっか飛んでいきよって、\nぼろ負けしてな…。"},
        { "location": "345/TALK"    , "narrator": "ヒカル", "text": "そんなことが…。"},
        { "location": "347/TALK"    , "narrator": "みやび", "text": "やき、今回は力を抜いて、\n適当に流すことにした\nんよ。"},
        { "location": "348/TALK"    , "narrator": "みやび", "text": "変に力むと、ロクなことに\nならんとわかったきね。"},
        { "location": "349/TALK"    , "narrator": "ヒカル", "text": "…すみませんでした。\n失礼な勘違いを\nしてしまって…。"},
        { "location": "351/TALK"    , "narrator": "みやび", "text": "えいよえいよ。\n謝る必要ないぞね。"},
        { "location": "353/TALK"    , "narrator": "みやび", "text": "…しっかし、本当に\n頑張っちゅうねぇ。"},
        { "location": "354/SEL"     , "narrator": "", "text": "混ぜてもらえば？"},
        { "location": "356/TALK"    , "narrator": "みやび", "text": "一日の授業を終えた\nばかりやし、みんな\n疲れてるはずやのに…。"},
        { "location": "358/TALK"    , "narrator": "ヒカル", "text": "それだけ楽しみにしてる、\nということでしょうね。"},
        { "location": "359/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "363/TALK"    , "narrator": "みやび", "text": "さてと、うちは先に\n帰らせてもらうき。"},
        { "location": "364/TALK"    , "narrator": "みやび", "text": "ヒカル君達も、あんまし\n帰り遅くならんようにな。"},
        { "location": "366/TALK"    , "narrator": "ヒカル", "text": "わかりました。\nまた明日、みやび先輩。"},
        { "location": "369/TALK"    , "narrator": "みやび", "text": "ん、また明日な。"},
        { "location": "371/ACT"     , "narrator": "", "text": "混ぜてもらえば？"},
        { "location": "376/TALK"    , "narrator": "みやび", "text": "ん…相棒か？"},
        { "location": "392/TALK"    , "narrator": "みやび", "text": "練習に混ぜてもらえいうんか？"},
        { "location": "393/TALK"    , "narrator": "みやび", "text": "却下、お断りや"},
        { "location": "394/TALK"    , "narrator": "みやび", "text": "うちは身体を動かすんは好きやないし"},
        { "location": "395/TALK"    , "narrator": "みやび", "text": "そもそも、練習する必要がないんよ"},
        { "location": "397/SEL"     , "narrator": "", "text": "自信ないんでしょ？"},
        { "location": "398/SEL"     , "narrator": "", "text": "高校生活最後なんだよ？"},
        { "location": "399/ACT"     , "narrator": "", "text": "自信ないんでしょ？"},
        { "location": "400/TALK"    , "narrator": "みやび", "text": "それは挑発のつもりか？"},
        { "location": "401/TALK"    , "narrator": "みやび", "text": "残念、逆効果やね"},
        { "location": "402/TALK"    , "narrator": "みやび", "text": "うちはそんな挑発に乗るほど、アホやないぞね"},
        { "location": "413/TALK"    , "narrator": "みやび", "text": "…帰るわ。"},
        { "location": "415/TALK"    , "narrator": "ヒカル", "text": "え？　あ、はい…。"},
        { "location": "416/TALK"    , "narrator": "ヒカル", "text": "また明日。"},
        { "location": "418/TALK"    , "narrator": "みやび", "text": "ん、また明日な。"},
        { "location": "423/TALK"    , "narrator": "ヒカル", "text": "…みやび先輩、何だか\n機嫌が悪かったような…？"},
        { "location": "424/ACT"     , "narrator": "", "text": "高校生活最後なんだよ？"},
        { "location": "426/TALK"    , "narrator": "みやび", "text": "おおっ、すっかり忘れちょった！"},
        { "location": "427/TALK"    , "narrator": "みやび", "text": "もう三年やき、これが最後の球技大会になるんか"},
        { "location": "428/TALK"    , "narrator": "みやび", "text": "…そう考えると、何となく感慨深い気持ちになってくるちや"},
        { "location": "440/TALK"    , "narrator": "みやび", "text": "…やっぱり、うちも\n練習に混ぜてもらうぞね。"},
        { "location": "442/TALK"    , "narrator": "ヒカル", "text": "やっぱり、少しはしないと\n不安ですか？"},
        { "location": "443/TALK"    , "narrator": "みやび", "text": "いんや、練習する必要は\nないんやけんど――"},
        { "location": "445/TALK"    , "narrator": "みやび", "text": "空気だけでも味わって\nおきたいんよ。"},
        { "location": "446/TALK"    , "narrator": "ヒカル", "text": "わかりました。\n鞄は見ておきますから、\n行ってきてください。"},
        { "location": "449/TALK"    , "narrator": "みやび", "text": "ん、ありがとさん。\nおーい、うちも混ざって\nえいかー？"},
        { "location": "471/TALK"    , "narrator": "みやび", "text": "はぁ…はぁ…。"},
        { "location": "474/TALK"    , "narrator": "キリト", "text": "だ、大丈夫っすか？\nすっげぇ苦しそうっす\nけど…。"},
        { "location": "477/TALK"    , "narrator": "みやび", "text": "…だ、大丈夫や…。\nち、ちっくと…\n運動不足なだけやき…。"},
        { "location": "479/TALK"    , "narrator": "雛", "text": "全然ちょっとには\n見えないけど…。"},
        { "location": "485/TALK"    , "narrator": "みやび", "text": "しっかし…思うてたより\n楽しかったわ。"},
        { "location": "486/TALK"    , "narrator": "みやび", "text": "球技大会の空気を、\nちっくとだけ感じる\nつもりやったが――"},
        { "location": "487/TALK"    , "narrator": "みやび", "text": "つい、夢中になって\nしもうたがよ。"},
        { "location": "489/TALK"    , "narrator": "つばめ", "text": "本番が楽しみですね。"},
        { "location": "490/TALK"    , "narrator": "みやび", "text": "ん？　そうやね…。"},
        { "location": "491/TALK"    , "narrator": "みやび", "text": "まあ、うちは競技には\n出ないんやけんど。"},
        { "location": "493/TALK"    , "narrator": "ヒカル", "text": "え？　それって\nどういうことですか？"},
        { "location": "495/TALK"    , "narrator": "みやび", "text": "うち、球技大会では\n放送席で実況する係に\nなったんよ。"},
        { "location": "498/TALK"    , "narrator": "キリト", "text": "は！？　\nみやび先輩が実況！？"},
        { "location": "499/TALK"    , "narrator": "つばめ", "text": "みやびさん、実況なんて\nできるんですか！？"},
        { "location": "501/TALK"    , "narrator": "みやび", "text": "目の前で起こっちゅう\nことを説明するくらい\nやったら――"},
        { "location": "503/TALK"    , "narrator": "みやび", "text": "どうとでもなるぞね。"},
        { "location": "504/TALK"    , "narrator": "みやび", "text": "やき、練習とはいえ\nボールを投げられて、\n結構楽しかったちや。"},
        { "location": "506/TALK"    , "narrator": "つばめ", "text": "ま、まあ、そう思って\nくれたならよかった\nですけど…。"},
        { "location": "507/TALK"    , "narrator": "ヒカル", "text": "…でも、みやび先輩の\n実況ってことは、\nやっぱり土佐弁ですよね？"},
        { "location": "509/TALK"    , "narrator": "ヒカル", "text": "僕らはまだしも、\n他の人はちゃんと\n理解できるでしょうか？"},
        { "location": "512/TALK"    , "narrator": "キリト", "text": "どうだろうなぁ？\n俺達でも時々、わからない\nことあるくらいだし…。"},
        { "location": "513/TALK"    , "narrator": "雛", "text": "でもでも、普通の実況より\n面白そうだし、あたしは\n良いと思うな。"},
        { "location": "304/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>7月8日　5:20 PM</color>\n初夏の放課後、学園校庭にて。"},
        { "location": "524/DIALOG"  , "narrator": "Dialog_GEThimegoto_ch04", "text": "【塁球とも言うそうな】"}
    ]
}
