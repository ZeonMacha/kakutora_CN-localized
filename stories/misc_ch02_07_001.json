    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "05-006_マイペースもほどほどに"},
        { "location": "32/TALK"   , "narrator": "アーヤ", "text": "みんなマイペースで困っちゃうわ"},
        { "location": "35/SEL"    , "narrator": "", "text": "鉄拳制裁だ"},
        { "location": "36/SEL"    , "narrator": "", "text": "そんなもんじゃない？"},
        { "location": "37/SEL"    , "narrator": "", "text": "アーヤがびしっと仕切ればいいよ"},
        { "location": "38/ACT"    , "narrator": "", "text": "鉄拳制裁だ"},
        { "location": "39/TALK"   , "narrator": "アーヤ", "text": "いやいや"},
        { "location": "41/TALK"   , "narrator": "アーヤ", "text": "そんなことしないわよ"},
        { "location": "42/ACT"    , "narrator": "", "text": "そんなもんじゃない？"},
        { "location": "43/TALK"   , "narrator": "アーヤ", "text": "まあね"},
        { "location": "44/TALK"   , "narrator": "アーヤ", "text": "そうだとは思うんだけど"},
        { "location": "45/ACT"    , "narrator": "", "text": "アーヤがびしっと仕切ればいいよ"},
        { "location": "47/TALK"   , "narrator": "アーヤ", "text": "びしっとね"},
        { "location": "49/TALK"   , "narrator": "アーヤ", "text": "びしっと"},
        { "location": "50/TALK"   , "narrator": "アーヤ", "text": "しなきゃかもね"},
        { "location": "52/TALK"   , "narrator": "アーヤ", "text": "一応"},
        { "location": "53/TALK"   , "narrator": "アーヤ", "text": "任務なんだし"},
        { "location": "54/TALK"   , "narrator": "アーヤ", "text": "みんなも遊び半分ってことはないんだけど"},
        { "location": "55/TALK"   , "narrator": "アーヤ", "text": "やっぱりこう"},
        { "location": "58/SEL"    , "narrator": "", "text": "やっぱり鉄拳制裁だ"},
        { "location": "59/SEL"    , "narrator": "", "text": "気にしすぎ"},
        { "location": "60/SEL"    , "narrator": "", "text": "苦労が絶えないね"},
        { "location": "61/ACT"    , "narrator": "", "text": "やっぱり鉄拳制裁だ"},
        { "location": "62/TALK"   , "narrator": "アーヤ", "text": "だからしないって"},
        { "location": "63/ACT"    , "narrator": "", "text": "気にしすぎ"},
        { "location": "64/TALK"   , "narrator": "アーヤ", "text": "そういうことなのかしら"},
        { "location": "65/ACT"    , "narrator": "", "text": "苦労が絶えないね"},
        { "location": "67/TALK"   , "narrator": "アーヤ", "text": "そうかも"},
        { "location": "68/TALK"   , "narrator": "アーヤ", "text": "でも"},
        { "location": "69/TALK"   , "narrator": "アーヤ", "text": "そう言ってくれると"},
        { "location": "71/TALK"   , "narrator": "アーヤ", "text": "ちょっと気が楽よ"},
        { "location": "73/TALK"   , "narrator": "アーヤ", "text": "まあ"},
        { "location": "74/TALK"   , "narrator": "アーヤ", "text": "今のところ"},
        { "location": "75/TALK"   , "narrator": "アーヤ", "text": "大きな問題はない詩"},
        { "location": "76/TALK"   , "narrator": "アーヤ", "text": "し"},
        { "location": "77/TALK"   , "narrator": "アーヤ", "text": "私が色々気を付ければ"},
        { "location": "78/TALK"   , "narrator": "アーヤ", "text": "いいだけなのかもね"}
    ]
}
