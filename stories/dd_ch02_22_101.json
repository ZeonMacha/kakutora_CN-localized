{
    "dir": "chap22/daydra/dd_ch02_22_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "22202",
        "cid": "ayami",
        "title": "002 メインストーリー",
        "sub_title": "覚悟＜前編＞"
    },
    "entry":
    [
        { "location": "24/TALK"   , "narrator": "アーヤ", "text": "…そろそろお夕飯の\n時間ね。"},
        { "location": "25/TALK"   , "narrator": "アーヤ", "text": "私も準備くらいは\n手伝わないと…。"},
        { "location": "32/TALK"   , "narrator": "アーヤ", "text": "あ、はい。\nもしもし？"},
        { "location": "33/TALK"   , "narrator": "透明真幌", "text": "私だ。\nこの後、何か予定は\n入っているか？"},
        { "location": "34/TALK"   , "narrator": "アーヤ", "text": "いえ、食事の後は\n特に…。"},
        { "location": "35/TALK"   , "narrator": "透明真幌", "text": "今から飲みに行こうと\n思うのだが\n一緒にどうだ？"},
        { "location": "37/TALK"   , "narrator": "アーヤ", "text": "わかりました。\nでは、夕飯は\nそちらにします。"},
        { "location": "38/TALK"   , "narrator": "透明真幌", "text": "ああ、すまんな。"},
        { "location": "59/TALK"   , "narrator": "真幌", "text": "…どうした？\nあまり酒が進んでない\nようだが？"},
        { "location": "61/TALK"   , "narrator": "アーヤ", "text": "…館長。\nそれ言うの、これで\n三回目ですよ？"},
        { "location": "62/TALK"   , "narrator": "真幌", "text": "そうだったか？\nとにかく、おまえも\nもっと飲め。"},
        { "location": "63/TALK"   , "narrator": "アーヤ", "text": "もう…あんまり\n飲み過ぎないで\nくださいね？"},
        { "location": "64/TALK"   , "narrator": "アーヤ", "text": "まだそんなに\n遅い時間でも\nないんですし。"},
        { "location": "65/TALK"   , "narrator": "真幌", "text": "なんだ？\nおまえももう少し\n飲んでたいのか？"},
        { "location": "66/TALK"   , "narrator": "アーヤ", "text": "お酒を飲みながら\n話すのは、嫌いじゃ\nありませんから。"},
        { "location": "67/TALK"   , "narrator": "真幌", "text": "そうか…まあ、私も\n酔いつぶれるほど\n飲んだりはしないさ。"},
        { "location": "68/TALK"   , "narrator": "真幌", "text": "ただ…少し酒を\n入れなければならん\nわけがあるんだ…。"},
        { "location": "69/TALK"   , "narrator": "アーヤ", "text": "…何か話があるから\n呼び出したんだとは\n思ってましたけど。"},
        { "location": "70/TALK"   , "narrator": "アーヤ", "text": "重要なことなん\nですか？"},
        { "location": "71/TALK"   , "narrator": "真幌", "text": "ああ…少し前に、\nみやびから相談を\n受けたんだ。"},
        { "location": "73/TALK"   , "narrator": "真幌", "text": "フェノメノンが、\n人為的に起こされて\nいる可能性がある、と。"},
        { "location": "75/TALK"   , "narrator": "アーヤ", "text": "…………。"},
        { "location": "76/TALK"   , "narrator": "真幌", "text": "…何だ、アーヤは\nとっくに聞いていた\nようだな。"},
        { "location": "78/TALK"   , "narrator": "アーヤ", "text": "…すみません。\n館長には、すぐに\n報告するべきでした。"},
        { "location": "79/TALK"   , "narrator": "真幌", "text": "いや、構わん。"},
        { "location": "80/TALK"   , "narrator": "真幌", "text": "それより、おまえは\nどこまで聞いている？"},
        { "location": "81/TALK"   , "narrator": "アーヤ", "text": "人為的に起こされた\n可能性がある、としか\n聞いてませんけど…。"},
        { "location": "82/TALK"   , "narrator": "アーヤ", "text": "…続きがあるん\nですか？"},
        { "location": "83/TALK"   , "narrator": "真幌", "text": "ああ…。"},
        { "location": "84/TALK"   , "narrator": "真幌", "text": "我々のいる\nこの空間全体に歪みが\n生じているらしい。"},
        { "location": "85/TALK"   , "narrator": "アーヤ", "text": "歪み…ですか？"},
        { "location": "86/TALK"   , "narrator": "真幌", "text": "そうだ。"},
        { "location": "87/TALK"   , "narrator": "真幌", "text": "ただ、その歪みが\n何であるかまでは\n解析できていない。"},
        { "location": "88/TALK"   , "narrator": "アーヤ", "text": "…ふう…。"},
        { "location": "89/TALK"   , "narrator": "アーヤ", "text": "調べれば調べるほど\n謎が深まっていってる\nみたい……。"},
        { "location": "90/TALK"   , "narrator": "アーヤ", "text": "そんな気が\nしませんか？"},
        { "location": "91/TALK"   , "narrator": "真幌", "text": "同感だ…。"},
        { "location": "92/TALK"   , "narrator": "真幌", "text": "フェノメノンは\n負の感情から生まれた\n竜巻のようなもの。"},
        { "location": "93/TALK"   , "narrator": "真幌", "text": "それを人為的に起こす\nメリットは？"},
        { "location": "94/TALK"   , "narrator": "アーヤ", "text": "…どちらにしろ\n平和な話には\nならないですよね…。"},
        { "location": "95/TALK"   , "narrator": "真幌", "text": "そうだな…。"},
        { "location": "96/TALK"   , "narrator": "真幌", "text": "とにかく、一日も\n早く全容を\n明かしたい。"},
        { "location": "97/TALK"   , "narrator": "真幌", "text": "今はみやびに頑張って\nもらわなければ\nいかんな。"},
        { "location": "98/TALK"   , "narrator": "アーヤ", "text": "…………。"},
        { "location": "99/TALK"   , "narrator": "真幌", "text": "ん？　どうした？"},
        { "location": "100/TALK"  , "narrator": "アーヤ", "text": "いえ…。"},
        { "location": "102/TALK"  , "narrator": "アーヤ", "text": "こんな調子で\n本当に全容を\n明かせるんでしょうか…。"},
        { "location": "103/TALK"  , "narrator": "真幌", "text": "……。"},
        { "location": "104/TALK"  , "narrator": "アーヤ", "text": "これだけ調べても、\n確かなことは何一つ\nわかってないんです。"},
        { "location": "105/TALK"  , "narrator": "アーヤ", "text": "なのに、全容を明かす\nなんて、どれだけ先の\nことになるのか…。"},
        { "location": "106/TALK"  , "narrator": "真幌", "text": "おいおい、珍しく\n弱気じゃないか？"},
        { "location": "107/TALK"  , "narrator": "真幌", "text": "おまえには、もっと\nちゃんとしてもらい\nたいんだがな。"},
        { "location": "108/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "109/TALK"  , "narrator": "真幌", "text": "…まあ、気持ちは\nわからんでもない\nがな。"},
        { "location": "110/TALK"  , "narrator": "真幌", "text": "だが、すまん。"},
        { "location": "111/TALK"  , "narrator": "真幌", "text": "…私も、そう長くは\nないかもしれん。"},
        { "location": "112/TALK"  , "narrator": "アーヤ", "text": "…え？"},
        { "location": "113/TALK"  , "narrator": "真幌", "text": "私に何かあったら、\nトライナリーや\n劇場を仕切れ。"},
        { "location": "114/TALK"  , "narrator": "真幌", "text": "おまえに\n任せたぞ。"},
        { "location": "115/TALK"  , "narrator": "アーヤ", "text": "…そんな冗談\nやめてください！"},
        { "location": "119/TALK"  , "narrator": "アーヤ", "text": "…それともやっぱり\n…本気なのかしら？"},
        { "location": "120/TALK"  , "narrator": "アーヤ", "text": "もし本気\nなんだとしても。"},
        { "location": "121/TALK"  , "narrator": "アーヤ", "text": "隊長の任期が\n終わるとか\nそういう意味よ。"},
        { "location": "124/TALK"  , "narrator": "アーヤ", "text": "絶対…。"},
        { "location": "188/TALK"  , "narrator": "アーヤ", "text": "　"},
        { "location": "204/TALK"  , "narrator": "アーヤ", "text": "[ココロゲート]へ\nいらっしゃい。\n$handle$さん。"},
        { "location": "205/TALK"  , "narrator": "アーヤ", "text": "さて、早速だけど。"},
        { "location": "206/TALK"  , "narrator": "アーヤ", "text": "前回の行動が一体どういう\nことなのか、説明して\nもらいましょうか。"},
        { "location": "207/SEL"   , "narrator": "", "text": "ただ誘導されただけです"},
        { "location": "208/SEL"   , "narrator": "", "text": "そっちこそ、嘘ついてたじゃない"},
        { "location": "209/ACT"   , "narrator": "", "text": "ただ誘導されただけです"},
        { "location": "210/TALK"  , "narrator": "アーヤ", "text": "なるほど。"},
        { "location": "211/TALK"  , "narrator": "アーヤ", "text": "誘導されれば簡単に\n行っちゃうような\n人なのね。"},
        { "location": "212/TALK"  , "narrator": "アーヤ", "text": "よかった。それじゃ今後は\n私もしっかり誘導するから\nよろしくお願いね。"},
        { "location": "213/ACT"   , "narrator": "", "text": "そっちこそ、嘘ついてたじゃない"},
        { "location": "214/TALK"  , "narrator": "アーヤ", "text": "必要悪よ。"},
        { "location": "215/TALK"  , "narrator": "アーヤ", "text": "急に交代なんて言われたら\n貴方も困るでしょ？"},
        { "location": "216/TALK"  , "narrator": "アーヤ", "text": "説明するのだって\n大変だし。"},
        { "location": "217/SEL"   , "narrator": "", "text": "司書は嘘をつかないって言ってたよ"},
        { "location": "218/ACT"   , "narrator": "", "text": "司書は嘘をつかないって言ってたよ"},
        { "location": "220/TALK"  , "narrator": "アーヤ", "text": "誰が？\nそんなルールは\n知らないから。"},
        { "location": "221/TALK"  , "narrator": "アーヤ", "text": "だいたい、嘘を全く\nつかないなんて発言自体が\n嘘の賜物じゃない。"},
        { "location": "222/TALK"  , "narrator": "アーヤ", "text": "人と関わりつつ生きていく\n世界では、善悪問わず\n嘘は絶対に出てしまう。"},
        { "location": "223/TALK"  , "narrator": "アーヤ", "text": "まあ、でも、\nあれでしょう？\n言ってたのは前任でしょ？"},
        { "location": "224/SEL"   , "narrator": "", "text": "そうだよ"},
        { "location": "225/SEL"   , "narrator": "", "text": "つばめの元司書です"},
        { "location": "226/ACT"   , "narrator": "", "text": "そうだよ"},
        { "location": "227/TALK"  , "narrator": "アーヤ", "text": "やっぱり。"},
        { "location": "228/ACT"   , "narrator": "", "text": "つばめの元司書です"},
        { "location": "229/TALK"  , "narrator": "アーヤ", "text": "そうなのね。\nつばめの元司書も\n言ってたか。"},
        { "location": "230/TALK"  , "narrator": "アーヤ", "text": "何か取り決めでも\nしていたのかしら？"},
        { "location": "232/TALK"  , "narrator": "アーヤ", "text": "平和ぼけしている\n0xの言いそうな事だわ。"},
        { "location": "233/TALK"  , "narrator": "アーヤ", "text": "何にしても、\nこれからは私が\n司書なんだから。"},
        { "location": "234/TALK"  , "narrator": "アーヤ", "text": "私に従って頂戴。"},
        { "location": "236/TALK"  , "narrator": "アーヤ", "text": "前任のせいで、だいぶ\n進捗遅れちゃってるし。"},
        { "location": "237/TALK"  , "narrator": "アーヤ", "text": "お陰でこんな所に\n派遣させられちゃって。\nホント迷惑だわ。"},
        { "location": "238/SEL"   , "narrator": "", "text": "随分な言いぐさだね"},
        { "location": "239/SEL"   , "narrator": "", "text": "進捗ってなに？"},
        { "location": "240/ACT"   , "narrator": "", "text": "随分な言いぐさだね"},
        { "location": "241/TALK"  , "narrator": "アーヤ", "text": "自分が同じ立場に立てば\n愚痴りたくなるのも\nわかるわよ？"},
        { "location": "242/TALK"  , "narrator": "アーヤ", "text": "もし貴方が\n会社勤めの人だったら――"},
        { "location": "243/TALK"  , "narrator": "アーヤ", "text": "辞めた前任の引き継ぎを\n殆ど資料無しにやりつつ\n次の納期が来週で。"},
        { "location": "244/TALK"  , "narrator": "アーヤ", "text": "しかも６ヶ月かけて\n進捗率１０％だったら\nどうする？"},
        { "location": "245/SEL"   , "narrator": "", "text": "会社辞めます"},
        { "location": "246/SEL"   , "narrator": "", "text": "頑張って完成させてカリスマになります"},
        { "location": "247/ACT"   , "narrator": "", "text": "会社辞めます"},
        { "location": "248/TALK"  , "narrator": "アーヤ", "text": "その気持ち、わかる。"},
        { "location": "249/ACT"   , "narrator": "", "text": "頑張って完成させてカリスマになります"},
        { "location": "250/TALK"  , "narrator": "アーヤ", "text": "ポジティブな思考を\n持ってるのね。"},
        { "location": "251/TALK"  , "narrator": "アーヤ", "text": "その調子で頑張って\n二人でカリスマを\n目指しましょ。"},
        { "location": "253/ACT"   , "narrator": "", "text": "進捗ってなに？"},
        { "location": "254/TALK"  , "narrator": "アーヤ", "text": "世界線誤差。"},
        { "location": "255/TALK"  , "narrator": "アーヤ", "text": "今おおよそ１０の\nマイナス８乗程度の\n世界線誤差がある。"},
        { "location": "256/TALK"  , "narrator": "アーヤ", "text": "これをマイナス２８乗\n以上の所まで持って\nいかなければならない。"},
        { "location": "257/TALK"  , "narrator": "アーヤ", "text": "そうしないと、私たちの\n世界は終わってしまうかも\nしれないの。"},
        { "location": "258/SEL"   , "narrator": "", "text": "すごい精度だね"},
        { "location": "259/SEL"   , "narrator": "", "text": "他のトライナリーもそこに収める必要があるの？"},
        { "location": "260/ACT"   , "narrator": "", "text": "すごい精度だね"},
        { "location": "261/TALK"  , "narrator": "アーヤ", "text": "平行世界の理論からすれば\n大した精度じゃないわ。"},
        { "location": "262/ACT"   , "narrator": "", "text": "他のトライナリーもそこに収める必要があるの？"},
        { "location": "263/TALK"  , "narrator": "アーヤ", "text": "もちろん。"},
        { "location": "266/TALK"  , "narrator": "アーヤ", "text": "だから、\nどうかお願いだから\n協力して欲しい。"},
        { "location": "267/TALK"  , "narrator": "アーヤ", "text": "私だって本当は、貴方と\nキャッキャウフフ\nしたいけど――"},
        { "location": "268/TALK"  , "narrator": "アーヤ", "text": "こんな状況じゃ、\n我慢して鬼になるしか\nないのよ。"},
        { "location": "269/TALK"  , "narrator": "アーヤ", "text": "そこ、わかって？"},
        { "location": "270/SEL"   , "narrator": "", "text": "まあ、わかった"},
        { "location": "271/SEL"   , "narrator": "", "text": "今後の行動次第かな"},
        { "location": "272/ACT"   , "narrator": "", "text": "まあ、わかった"},
        { "location": "273/TALK"  , "narrator": "アーヤ", "text": "ありがと。"},
        { "location": "274/ACT"   , "narrator": "", "text": "今後の行動次第かな"},
        { "location": "275/TALK"  , "narrator": "アーヤ", "text": "はいはい。\n随分と上から目線なのね。"},
        { "location": "276/TALK"  , "narrator": "アーヤ", "text": "でもこれだけは\n本当に言っておくから。"},
        { "location": "277/TALK"  , "narrator": "アーヤ", "text": "今私たちが暮らしてる\n世界は、本当に脆い。"},
        { "location": "278/TALK"  , "narrator": "アーヤ", "text": "例えるなら、風船のように\n針が一本刺さっただけで\n壊れてしまう。"},
        { "location": "279/TALK"  , "narrator": "アーヤ", "text": "だから、\n本当に國政綾水のことを\n大切に想ってるなら……"},
        { "location": "280/TALK"  , "narrator": "アーヤ", "text": "私の事を嫌ってくれても\n構わないけど、指示に\nだけは従って欲しい。"},
        { "location": "282/TALK"  , "narrator": "アーヤ", "text": "それじゃ、今回も\n回すわよ。"},
        { "location": "287/TALK"  , "narrator": "アーヤ", "text": "オープンプロセス、\n0x556番地から\n0x192番地へ。"},
        { "location": "309/TALK"  , "narrator": "アーヤ", "text": "シーク完了。"},
        { "location": "312/TALK"  , "narrator": "アーヤ", "text": "さて、と。\n今回は……"},
        { "location": "314/TALK"  , "narrator": "アーヤ", "text": "館長の心配ね。"},
        { "location": "315/TALK"  , "narrator": "アーヤ", "text": "ここはそんなに\n思い詰めなくても、気楽に\n話していればいいのに。"},
        { "location": "316/TALK"  , "narrator": "アーヤ", "text": "OSの回答にも\nそうあるけど、\n私も同感ね。"},
        { "location": "317/TALK"  , "narrator": "アーヤ", "text": "館長のことは、私本人も\n知らない昔のことから\nよく知ってるけど――"},
        { "location": "318/TALK"  , "narrator": "アーヤ", "text": "殺しても絶対に\n死ぬような\nタマじゃないから。"},
        { "location": "319/SEL"   , "narrator": "", "text": "なんでそんなこと知ってるの？"},
        { "location": "320/SEL"   , "narrator": "", "text": "急に性格変わってない？"},
        { "location": "321/ACT"   , "narrator": "", "text": "なんでそんなこと知ってるの？"},
        { "location": "322/TALK"  , "narrator": "アーヤ", "text": "私は1xだから。"},
        { "location": "323/ACT"   , "narrator": "", "text": "それにしても、急に性格変わってない？"},
        { "location": "324/TALK"  , "narrator": "アーヤ", "text": "まあ、今までは貴方を\n驚かせまいとして、前任の\n性格に合わせてたから。"},
        { "location": "325/TALK"  , "narrator": "アーヤ", "text": "それに、さっきも\n言ったけど、本当に\n今は焦ってるから。"},
        { "location": "326/TALK"  , "narrator": "アーヤ", "text": "だからどうしても、\n言葉尻も粗くなっちゃう。"},
        { "location": "327/TALK"  , "narrator": "アーヤ", "text": "もう少し精度が上がって\nくれば、落ち着いてくると\n思うから、ごめんね。"},
        { "location": "329/TALK"  , "narrator": "アーヤ", "text": "それじゃ、そろそろ\n行ってきてもらいます。"},
        { "location": "330/TALK"  , "narrator": "アーヤ", "text": "$handle$と\n國政綾水にとって、\n素敵なココロの旅を。"},
        { "location": "23/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>8月27日　 18:17 PM</color>\n合宿中、みやびの実家でのこと"},
        { "location": "153/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "155/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "157/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
