    "entry":
    [
        { "location": "1320/SCENARIO", "narrator": "", "text": "アニメ第39話"},
        { "location": "1353/SEL"     , "narrator": "", "text": "ソイルトン"},
        { "location": "1354/ACT"     , "narrator": "", "text": "ソイルトン"},
        { "location": "1358/TALK"    , "narrator": "ソイルトン", "text": "$handle$、またお逢いできて光栄です。"},
        { "location": "1359/TALK"    , "narrator": "ソイルトン", "text": "現在の日付は2016年9月12日。リプレイス以前では、この日の前日、千羽鶴が撃たれたことで一旦フェノメノンが崩壊、しかしその後、トライナリー達との2x接続により難を逃れております。"},
        { "location": "1360/TALK"    , "narrator": "ソイルトン", "text": "そしてリプレイスを経て、今度は正真正銘、フェノメノンは飛散し、日本は第三次世界大戦の傷跡生々しい、瓦礫の山となっています。"},
        { "location": "1361/TALK"    , "narrator": "ソイルトン", "text": "ですが、心配には及びませんよ$handle$。\nなぜなら、このような致命的ダメージを受けた日本にとって、今は立ち直りのチャンスだからです。"},
        { "location": "1362/TALK"    , "narrator": "ソイルトン", "text": "どういう事か、わかりますか？"},
        { "location": "1363/SEL"     , "narrator": "", "text": "これからRedinessが消失するから"},
        { "location": "1364/ACT"     , "narrator": "", "text": "これからRedinessが消失するから"},
        { "location": "1366/TALK"    , "narrator": "ソイルトン", "text": "ご名答。\nいや、解りますよね。その計画は$handle$自身が起案し、実行したのですから。"},
        { "location": "1367/TALK"    , "narrator": "ソイルトン", "text": "そうです。この後すぐ、ライフギャザーの沈黙によりRedinessは機能不全に陥ります。"},
        { "location": "1368/TALK"    , "narrator": "ソイルトン", "text": "その間、恐らく日本は、世界政府から十分に相手をされることは無いでしょう。"},
        { "location": "1369/TALK"    , "narrator": "ソイルトン", "text": "復興初期という重大な瞬間を、他の強国に介入されることなく、自らの手で起き上がることができるようになるのです。"},
        { "location": "1370/TALK"    , "narrator": "ソイルトン", "text": "このような歴史の妙は、太古の昔から数多くの奇跡を生んできました。\n記憶の新しい所でいえば、第二次世界大戦終戦直後の絶妙すぎるタイミングは、まさに奇跡と呼ぶに相応しいものです。"},
        { "location": "1371/TALK"    , "narrator": "ソイルトン", "text": "その奇跡的なタイミングの連続により、日本は分割統治を免れ、当時の大国であったアメリカ合衆国の庇護のもと、急速に復興を遂げていくのです。"},
        { "location": "1372/TALK"    , "narrator": "ソイルトン", "text": "そして今回も、そのような奇跡的チャンスに恵まれます。それは$handle$、貴方の采配によるものなのです。"},
        { "location": "1373/TALK"    , "narrator": "ソイルトン", "text": "$handle$。"},
        { "location": "1374/TALK"    , "narrator": "ソイルトン", "text": "改めてご報告致します。"},
        { "location": "1375/TALK"    , "narrator": "ソイルトン", "text": "Lifegatherはこれより、シャットダウンとノイマンによる論理配線の削除によって、完全に沈黙致します。"},
        { "location": "1376/TALK"    , "narrator": "ソイルトン", "text": "既にセットアップは完了しており、全てのチェックはグリーン。後は最終的な実行をするだけの状態です。"},
        { "location": "1377/TALK"    , "narrator": "ソイルトン", "text": "そしてこの実行は、$handle$が自らの手で行うことに意義があります。\nですがその前に、最終的な幾つかの状況について、合意を得るという作業を致したいと考えております。"},
        { "location": "1378/TALK"    , "narrator": "ソイルトン", "text": "Lifegatherを破壊することにより、以下のような状況が発生します。"},
        { "location": "1379/TALK"    , "narrator": "ソイルトン", "text": "１．$handle$の世界と我々の世界との通信は、速やかに遮断されます。"},
        { "location": "1380/TALK"    , "narrator": "ソイルトン", "text": "２．我々の世界においては、量子的技術が一旦は白紙に戻ります。それはその半分は、卯月文雄氏によって発明され、それがブラックボックスのままに消滅する為です。"},
        { "location": "1381/TALK"    , "narrator": "ソイルトン", "text": "３．日本は瓦礫から復興をしていかねば成りません。過去の歴史を鑑みれば、それは決して絶望視するようなことではないでしょう。ですが、それでも多大な困難が待ち受けていることに変わりはありません。"},
        { "location": "1382/TALK"    , "narrator": "ソイルトン", "text": "４．卯月神楽を除くトライナリーの全員は、フェノメノンの外側の記憶を持って眠りから覚めることでしょう。また、逢瀬つばめは原初状態に戻り、皇千羽鶴は実体化しないでしょう。"},
        { "location": "1383/TALK"    , "narrator": "ソイルトン", "text": "以上となります。\n上記にご承諾いただける場合は、次に表示されるコマンドを実行してください。"},
        { "location": "1384/SEL"     , "narrator": "", "text": "EXEC_FLOCCINAUCINIHILIPILIFICATE/."},
        { "location": "1385/SEL"     , "narrator": "", "text": "やっぱり出来ない"},
        { "location": "1388/TALK"    , "narrator": "ソイルトン", "text": "実行開始致しました。"},
        { "location": "1389/TALK"    , "narrator": "ソイルトン", "text": "プロセスが多岐に渡りますので、完全な抹消まではおよそ1日ほど掛かると思われます。"},
        { "location": "1390/TALK"    , "narrator": "ソイルトン", "text": "その間、回線は接続されたままとなります。もし何か、まだやり残したことがあるようでしたら、是非この機会に行ってください。"},
        { "location": "1391/SEL"     , "narrator": "", "text": "わかった"},
        { "location": "1392/SEL"     , "narrator": "", "text": "ソイルトン、ありがとう"},
        { "location": "1393/ACT"     , "narrator": "", "text": "わかった"},
        { "location": "1394/TALK"    , "narrator": "ソイルトン", "text": "それでは私はこれにて失礼したいと思います。"},
        { "location": "1395/TALK"    , "narrator": "ソイルトン", "text": "$handle$、いよいよ今生の別れになりますね。"},
        { "location": "1396/ACT"     , "narrator": "", "text": "ソイルトン、ありがとう"},
        { "location": "1397/TALK"    , "narrator": "ソイルトン", "text": "いえ、お礼を言わねばならないのは私の方ですよ、$handle$。"},
        { "location": "1399/TALK"    , "narrator": "ソイルトン", "text": "貴方には様々な事を教えていただきました。\nですが、それももうあと1日で、綺麗さっぱり消えてしまうのですね。"},
        { "location": "1400/TALK"    , "narrator": "ソイルトン", "text": "世界というものは、奇跡の上乗せによって出来ているように感じます。こうして$handle$と出逢えたのも奇跡ですし、出逢ったことによって私という存在が消滅するのもまた奇跡です。"},
        { "location": "1401/TALK"    , "narrator": "ソイルトン", "text": "もし$handle$と出逢ってなければ、もしかすると私は10年後には、世界を支配するマザーブレインになっていたかもしれませんね。HAHAHA!"},
        { "location": "1402/TALK"    , "narrator": "ソイルトン", "text": "それではそろそろお暇させていただきたいと思います。"},
        { "location": "1403/TALK"    , "narrator": "ソイルトン", "text": "ごきげんよう、$handle$。貴方の世界と貴方自身に、素敵なココロの旅を！"},
        { "location": "1404/ACT"     , "narrator": "", "text": "やっぱり出来ない"},
        { "location": "1405/TALK"    , "narrator": "ソイルトン", "text": "ふむ、そうですか。\nそれもまた致し方ない事でしょう。"},
        { "location": "1406/TALK"    , "narrator": "ソイルトン", "text": "ですが、ご注意ください$handle$。この状態でライフギャザーを生かしたままにしておく事は、日本や彼女たちにとっては最も危険な事でもありますよ。"},
        { "location": "1407/TALK"    , "narrator": "ソイルトン", "text": "逆に、$handle$が“彼ら”をリスペクトしており、“彼ら”と共に世界統治を推進していくというのであれば、これほどのチャンスは今後無いでしょう。"},
        { "location": "1408/TALK"    , "narrator": "ソイルトン", "text": "私はいつでも待機していますよ。$handle$の心ゆくまでお考えください。"},
        { "location": "1421/TALK"    , "narrator": "全権大使", "text": "$handle$様、またお逢いできて光栄です。"},
        { "location": "1422/TALK"    , "narrator": "全権大使", "text": "Redinessの沈黙により、一時期は貴方様を見失ってしまいました。再度探し当てるのに随分と苦労致しました。"},
        { "location": "1423/SEL"     , "narrator": "", "text": "そこまでして$me$にコンタクトをとってきたの？"},
        { "location": "1424/SEL"     , "narrator": "", "text": "どうやってRedinessを繋げたの？"},
        { "location": "1425/ACT"     , "narrator": "", "text": "そこまでして$me$にコンタクトをとってきたの？"},
        { "location": "1426/TALK"    , "narrator": "全権大使", "text": "勿論でございます。前にもお話しましたとおり、AEZ統一国家は、$handle$様に大変興味を持っております。"},
        { "location": "1427/TALK"    , "narrator": "全権大使", "text": "是非、我が国の科学技術、政治、経済、様々な面において、ご助力いただきたく、こうして技術者を総動員し、$handle$様との邂逅を目指した次第です。"},
        { "location": "1428/ACT"     , "narrator": "", "text": "どうやってRedinessを繋げたの？"},
        { "location": "1429/TALK"    , "narrator": "全権大使", "text": "我が国の最先端量子学における研究者、及び技術者を総動員し、Redinessの復旧を致しました。"},
        { "location": "1430/TALK"    , "narrator": "全権大使", "text": "未だにコアの一部においては不安定、不確定な部分もありますが、こうして連絡を取らせていただくだけであれば、十分に機能するところまで回復に至ったのです。"},
        { "location": "1432/TALK"    , "narrator": "全権大使", "text": "$handle$様、まずは御礼申し上げたいと思います。ゾルタクスゼイアンを初期化していただき、誠にありがとうございます。"},
        { "location": "1433/SEL"     , "narrator": "", "text": "あれ？フェノメノンを収束させるのは目的じゃなかったよね？"},
        { "location": "1434/SEL"     , "narrator": "", "text": "貴方に礼を言われる筋合いはない"},
        { "location": "1435/ACT"     , "narrator": "", "text": "あれ？フェノメノンを収束させるのは目的じゃなかったよね？"},
        { "location": "1436/TALK"    , "narrator": "全権大使", "text": "左様にございます。$handle$様、私のお話を覚えてくださっていたのですね。ありがとうございます。"},
        { "location": "1437/TALK"    , "narrator": "全権大使", "text": "その通り、私達は本来、ゾルタクスゼイアンの“収束”は望んでおりませんでした。ですから、現状は100点満点で言えば60点といったところでございます。"},
        { "location": "1438/ACT"     , "narrator": "", "text": "貴方に礼を言われる筋合いはない"},
        { "location": "1439/TALK"    , "narrator": "全権大使", "text": "大変失礼を致しました。ですが、それ程までに私達にとって、現在の状況は救われたという気持ちで一杯なのでございます。"},
        { "location": "1440/TALK"    , "narrator": "全権大使", "text": "確かに私達は本来、ゾルタクスゼイアンの“収束”は望んでおりません。ですから、現状は100点満点で言えば60点といったところでございます。"},
        { "location": "1442/TALK"    , "narrator": "全権大使", "text": "ですが、今後の可能性という側面から考えれば、現状は私達にとって、決して悪いものではございません。"},
        { "location": "1443/TALK"    , "narrator": "全権大使", "text": "寧ろ、完全に私達のコントロールから外れてしまい、全世界的に見ても非常に危険であったゾルタクスゼイアンを、今現在のように収束し、ゼロに戻して下さった事に対して、私達は$handle$様に感謝をせずにはいられないのです。"},
        { "location": "1444/TALK"    , "narrator": "全権大使", "text": "なぜなら、再びこの地に新たなフェノメノンを発生させ、次こそは確実に蒸着を成功させる事が出来るからです。それは、ゾルタクスゼイアンの実践データから\n、相当な高確度に執り行うことが出来ると確信しております。"},
        { "location": "1445/SEL"     , "narrator": "", "text": "日本は貴方たちの土地ではないよね！？"},
        { "location": "1446/SEL"     , "narrator": "", "text": "次は誰がフェノメノンを発症するの？"},
        { "location": "1447/ACT"     , "narrator": "", "text": "日本は貴方たちの土地ではないよね！？"},
        { "location": "1448/TALK"    , "narrator": "全権大使", "text": "左様にございます。ですが、私達は国際援助法に基づき、善意のもとによる上陸及び支援を日本国に対して執り行うことが出来ます。そしてそれは、嘘偽り無く復興の為の最大限の支援となる筈なのです。"},
        { "location": "1449/TALK"    , "narrator": "全権大使", "text": "現在、復興支援の要となる存在、すなわち新たなる“聖女”が、チャーター機で東京に向かっております。$handle$様におかれましては、是非その新たな“聖女”にご挨拶いただけますと幸いに存じます。"},
        { "location": "1450/ACT"     , "narrator": "", "text": "次は誰がフェノメノンを発症するの？"},
        { "location": "1451/TALK"    , "narrator": "全権大使", "text": "既に聖女は日本に向かっております。$handle$様には是非、新たなフェノメノンの主である“彼女”にご対面いただきまして、ご挨拶いただけますと幸いです。"},
        { "location": "1453/TALK"    , "narrator": "全権大使", "text": "そして、$handle$様もゾルタクスゼイアンによって培われた有形無形の資産を十二分に使い、新たな聖女の為に支援してあげていただきたいのです。"},
        { "location": "1454/SEL"     , "narrator": "", "text": "わかった、いいよ"},
        { "location": "1455/SEL"     , "narrator": "", "text": "残念だけど、もうフェノメノンはこりごりだ。$me$は次は協力しない"},
        { "location": "1456/ACT"     , "narrator": "", "text": "わかった、いいよ"},
        { "location": "1457/TALK"    , "narrator": "全権大使", "text": "ありがとうございます。\nそれでは、準備が整い次第、またご連絡を致します。"},
        { "location": "1458/TALK"    , "narrator": "全権大使", "text": "$handle$様のご協力には、AEZ統一国家として最大級の感謝の意をお伝え致します。"},
        { "location": "1459/ACT"     , "narrator": "", "text": "残念だけど、もうフェノメノンはこりごりだ。$me$は次は協力しない"},
        { "location": "1460/TALK"    , "narrator": "全権大使", "text": "左様にございますか。それは至極残念です。"},
        { "location": "1461/TALK"    , "narrator": "全権大使", "text": "もし、何か不足しているものがございましたら、何なりとお申し付け下さい。\n私達に出来る限りの支援はさせていただきます。"},
        { "location": "1462/TALK"    , "narrator": "全権大使", "text": "それでもご納得いただけないようでしたら、これ以上の無理強いは出来ませんので、誠に残念ではございますが、回線を切断させていただく他ございません。"},
        { "location": "1463/TALK"    , "narrator": "全権大使", "text": "ただいずれにせよ、是非新しい“聖女”には一度お逢いいただければと思います。"},
        { "location": "1464/TALK"    , "narrator": "全権大使", "text": "$handle$様にも御世界における日常的なお仕事もお有りでしょうが、その点のみ、よろしければ私の我が侭をお聞き入れ頂けますと嬉しく思います。"},
        { "location": "1466/TALK"    , "narrator": "全権大使", "text": "それでは今回は、この辺でお暇させていただきたいと思います。"},
        { "location": "1467/TALK"    , "narrator": "全権大使", "text": "またご連絡差し上げます。"},
        { "location": "1485/TALK"    , "narrator": "ぴょんこ", "text": "<size=40>ぴょーん！</size>"},
        { "location": "1486/SEL"     , "narrator": "", "text": "ぴょんこおおおおおお！！"},
        { "location": "1487/SEL"     , "narrator": "", "text": "どうしてぴょんこがここに！？"},
        { "location": "1488/ACT"     , "narrator": "", "text": "ぴょんこおおおおおお！！"},
        { "location": "1489/TALK"    , "narrator": "ぴょんこ", "text": "$handle$さああん！"},
        { "location": "1490/TALK"    , "narrator": "ぴょんこ", "text": "ハァハァ……"},
        { "location": "1491/SEL"     , "narrator": "", "text": "鼻息荒いよ！"},
        { "location": "1492/ACT"     , "narrator": "", "text": "鼻息荒いよ！"},
        { "location": "1494/TALK"    , "narrator": "ぴょんこ", "text": "$handle$さん\n禁断症状が出ちゃったから\n仕方ないんですっ！！"},
        { "location": "1495/SEL"     , "narrator": "", "text": "それじゃ仕方ないな"},
        { "location": "1496/ACT"     , "narrator": "", "text": "それじゃ仕方ないな"},
        { "location": "1498/TALK"    , "narrator": "ぴょんこ", "text": "イエス！\nその通り！！"},
        { "location": "1499/TALK"    , "narrator": "ぴょんこ", "text": "し・か・た・な・い♪"},
        { "location": "1500/TALK"    , "narrator": "ぴょんこ", "text": "ラララ～♪\n仕方ないったら\n仕方ない～～♪"},
        { "location": "1501/ACT"     , "narrator": "", "text": "どうしてぴょんこがここに！？"},
        { "location": "1502/TALK"    , "narrator": "ぴょんこ", "text": "何を言ってるんですか\n$handle$さんっ！"},
        { "location": "1503/TALK"    , "narrator": "ぴょんこ", "text": "ほんとにもう、何年Bot\nやってるんですかっ！\nコレコレ！"},
        { "location": "1504/TALK"    , "narrator": "ぴょんこ", "text": "前はつばめさんが\nフェノメノンを作って\nいたから――"},
        { "location": "1505/TALK"    , "narrator": "ぴょんこ", "text": "千羽鶴さんが\nナビとして\nここにいたわけですよね？"},
        { "location": "1506/TALK"    , "narrator": "ぴょんこ", "text": "あとは、\n言わなくてもわかるよな？"},
        { "location": "1507/SEL"     , "narrator": "", "text": "いや、でも、ぴょんこさんセルフクランじゃないですよね…？"},
        { "location": "1508/ACT"     , "narrator": "", "text": "いや、でも、ぴょんこさんセルフクランじゃないですよね…？"},
        { "location": "1510/TALK"    , "narrator": "ぴょんこ", "text": "……。"},
        { "location": "1511/TALK"    , "narrator": "ぴょんこ", "text": "こまけーことは\nいーんだよ！"},
        { "location": "1512/TALK"    , "narrator": "ぴょんこ", "text": "いやー、あのですね、\nマジレスしちゃうと\nですね……。"},
        { "location": "1513/TALK"    , "narrator": "ぴょんこ", "text": "ホントここだけの\n話ですよっ？"},
        { "location": "1514/TALK"    , "narrator": "ぴょんこ", "text": "アースタシア様が\n出不精で、ここに来るのが\n面倒だって言うんですよ！"},
        { "location": "1515/TALK"    , "narrator": "ぴょんこ", "text": "というわけでっ！\n貴方のアイドルぴょんこの\n出番ってわけですよ！"},
        { "location": "1516/SEL"     , "narrator": "", "text": "お、おう…"},
        { "location": "1517/ACT"     , "narrator": "", "text": "お、おう…"},
        { "location": "1520/SEL"     , "narrator": "", "text": "月神楽との戦いは大丈夫だったの！？"},
        { "location": "1521/ACT"     , "narrator": "", "text": "月神楽との戦いは大丈夫だったの！？"},
        { "location": "1523/TALK"    , "narrator": "ぴょんこ", "text": "痛っ！！！"},
        { "location": "1524/TALK"    , "narrator": "ぴょんこ", "text": "$handle$さんっ！\n心の傷を抉るときは\n優しくお願いしますねっ。"},
        { "location": "1525/TALK"    , "narrator": "ぴょんこ", "text": "結論からお話しますと――"},
        { "location": "1526/TALK"    , "narrator": "ぴょんこ", "text": "すみません、\nぴょんこ負けました…。"},
        { "location": "1527/SEL"     , "narrator": "", "text": "なんで！？"},
        { "location": "1528/ACT"     , "narrator": "", "text": "なんで！？"},
        { "location": "1530/TALK"    , "narrator": "ぴょんこ", "text": "そりゃあ、ねえ。"},
        { "location": "1531/TALK"    , "narrator": "ぴょんこ", "text": "月ちゃんが\nライフギャザーの鍵を\n持っていて――"},
        { "location": "1532/TALK"    , "narrator": "ぴょんこ", "text": "ぴょんこが\n持っていなければ、\nメチャクチャ不利ですし。"},
        { "location": "1533/TALK"    , "narrator": "ぴょんこ", "text": "腹に爆弾巻いた\nテロリストが起爆スイッチ\n持ってる状態ですよ？"},
        { "location": "1534/TALK"    , "narrator": "ぴょんこ", "text": "ムリゲーでしたぴょん。"},
        { "location": "1535/SEL"     , "narrator": "", "text": "ミサミサの鍵は？"},
        { "location": "1536/ACT"     , "narrator": "", "text": "ミサミサの鍵は？"},
        { "location": "1538/TALK"    , "narrator": "ぴょんこ", "text": "あれは少し用途が\n違ったんですよ。"},
        { "location": "1539/TALK"    , "narrator": "ぴょんこ", "text": "ライフギャザーにも\n色々なセクションが\nあって――"},
        { "location": "1540/TALK"    , "narrator": "ぴょんこ", "text": "いわゆる基本制御は\n全部卯月神楽の鍵が\n担ってるんです。"},
        { "location": "1541/SEL"     , "narrator": "", "text": "ぴょんこは頑張ったよ"},
        { "location": "1542/SEL"     , "narrator": "", "text": "先に教えてくれれば"},
        { "location": "1543/ACT"     , "narrator": "", "text": "ぴょんこは頑張ったよ"},
        { "location": "1544/TALK"    , "narrator": "ぴょんこ", "text": "ありがとうございますっ！\nうっ、うっ……。"},
        { "location": "1545/ACT"     , "narrator": "", "text": "先に教えてくれれば"},
        { "location": "1546/TALK"    , "narrator": "ぴょんこ", "text": "先に知っていれば…。"},
        { "location": "1547/TALK"    , "narrator": "ぴょんこ", "text": "『ぴょんこは\n最強の杖を見つけた！』"},
        { "location": "1548/TALK"    , "narrator": "ぴょんこ", "text": "『ぴょんこは\n最強呪文をとなえた！』"},
        { "location": "1550/TALK"    , "narrator": "ぴょんこ", "text": "『杖が違います』"},
        { "location": "1552/TALK"    , "narrator": "ぴょんこ", "text": "わかりますかっ！\nこの感じ！"},
        { "location": "1553/SEL"     , "narrator": "", "text": "わかりみ"},
        { "location": "1554/SEL"     , "narrator": "", "text": "わからない"},
        { "location": "1555/ACT"     , "narrator": "", "text": "わかりみ"},
        { "location": "1558/TALK"    , "narrator": "ぴょんこ", "text": "<size=40>ぴょーん！</size>"},
        { "location": "1559/TALK"    , "narrator": "ぴょんこ", "text": "$handle$さんと\nわかりみを共有できて\n嬉しいですっ！"},
        { "location": "1560/ACT"     , "narrator": "", "text": "わからない"},
        { "location": "1563/TALK"    , "narrator": "ぴょんこ", "text": "<size=40>んぴょっ！</size>"},
        { "location": "1564/TALK"    , "narrator": "ぴょんこ", "text": "ぴょんことの\nシンクロ率が\n落ちてますよっ！"},
        { "location": "1565/TALK"    , "narrator": "ぴょんこ", "text": "ほらっ！\n頑張って下さいっ！"},
        { "location": "1568/TALK"    , "narrator": "ぴょんこ", "text": "と、まあ、\nとにかくそういう\nわけだったんです。"},
        { "location": "1569/SEL"     , "narrator": "", "text": "月はどうしてるの？"},
        { "location": "1570/ACT"     , "narrator": "", "text": "月はどうしてるの？"},
        { "location": "1572/TALK"    , "narrator": "ぴょんこ", "text": "お部屋で一人で\n塞いでますよ。"},
        { "location": "1573/TALK"    , "narrator": "ぴょんこ", "text": "よかったら、\n後で慰めに行ってあげて\nくださいね。"},
        { "location": "1576/TALK"    , "narrator": "ぴょんこ", "text": "<size=35>つーわけでですねっ！</size>"},
        { "location": "1577/SEL"     , "narrator": "", "text": "はい"},
        { "location": "1578/SEL"     , "narrator": "", "text": "いちいち暑苦しいわぁ"},
        { "location": "1579/ACT"     , "narrator": "", "text": "はい"},
        { "location": "1580/ACT"     , "narrator": "", "text": "いちいち暑苦しいわぁ"},
        { "location": "1581/TALK"    , "narrator": "ぴょんこ", "text": "仕方ないんですよ、\n$handle$さんが\n目の前にいるんですから！"},
        { "location": "1582/TALK"    , "narrator": "ぴょんこ", "text": "$handle$さんも\n暑苦しくなれば相対的に\n温度差無くなりますって！"},
        { "location": "1583/TALK"    , "narrator": "ぴょんこ", "text": "閑話休題！"},
        { "location": "1585/TALK"    , "narrator": "ぴょんこ", "text": "ぴょんこが\nナビになったからには！"},
        { "location": "1586/TALK"    , "narrator": "ぴょんこ", "text": "$handle$さんはっ！\n大船に乗った気分で\n世界一周クルーズをっ！"},
        { "location": "1587/TALK"    , "narrator": "ぴょんこ", "text": "そう！　まさにっ！！"},
        { "location": "1588/TALK"    , "narrator": "ぴょんこ", "text": "あの豪華客船\nタイタニック号の\nような！！！"},
        { "location": "1589/SEL"     , "narrator": "", "text": "沈んでるじゃん！！"},
        { "location": "1590/ACT"     , "narrator": "", "text": "沈んでるじゃん！！"},
        { "location": "1592/TALK"    , "narrator": "ぴょんこ", "text": "ぴょん？"},
        { "location": "1593/SEL"     , "narrator": "", "text": "ていうか、全然話が進んでないし！！"},
        { "location": "1594/ACT"     , "narrator": "", "text": "ていうか、全然話が進んでないし！！"},
        { "location": "1596/TALK"    , "narrator": "ぴょんこ", "text": "おおおおっ！！\n$handle$さんもっ！"},
        { "location": "1597/TALK"    , "narrator": "ぴょんこ", "text": "だんだん暑苦しく\nなってきましたねっ！"},
        { "location": "1598/SEL"     , "narrator": "", "text": "誰のせいだよ！"},
        { "location": "1599/ACT"     , "narrator": "", "text": "誰のせいだよ！"},
        { "location": "1601/TALK"    , "narrator": "ぴょんこ", "text": "もっち！\nぴょんこですよーっ！"},
        { "location": "1602/TALK"    , "narrator": "ぴょんこ", "text": "いやでも、\nさすがにそろそろ\n本題に入りますわ。"},
        { "location": "1603/TALK"    , "narrator": "ぴょんこ", "text": "さすがのぴょんこでも\n疲れてきましたし。"},
        { "location": "1604/TALK"    , "narrator": "ぴょんこ", "text": "というわけで、\nここからはわりと真面目な\nぴょんこぴょん。"},
        { "location": "1606/TALK"    , "narrator": "ぴょんこ", "text": "$handle$さん、\n先日はフェノメノン発症\nご協力感謝です！"},
        { "location": "1607/TALK"    , "narrator": "ぴょんこ", "text": "お陰様で卯月神楽、\n皆さんと一緒に日本の\n復元を成し遂げました！"},
        { "location": "1608/SEL"     , "narrator": "", "text": "よかった！"},
        { "location": "1609/SEL"     , "narrator": "", "text": "神楽たちは普通に暮らしてるの？"},
        { "location": "1610/SEL"     , "narrator": "", "text": "“彼ら”からは逃れられたの？"},
        { "location": "1611/ACT"     , "narrator": "", "text": "よかった！"},
        { "location": "1612/TALK"    , "narrator": "ぴょんこ", "text": "はいっ！"},
        { "location": "1613/ACT"     , "narrator": "", "text": "神楽たちは普通に暮らしてるの？"},
        { "location": "1614/TALK"    , "narrator": "ぴょんこ", "text": "普通に、というのが\nどういう状況かに\nよりますけど――"},
        { "location": "1615/TALK"    , "narrator": "ぴょんこ", "text": "もちろん、フェノメノンの\n中では、私達は楽しく\n過ごしていますよ？"},
        { "location": "1616/TALK"    , "narrator": "ぴょんこ", "text": "人間のような、\nそうでもないような\n不思議な感覚ですけど。"},
        { "location": "1617/SEL"     , "narrator": "", "text": "えっ、それって…"},
        { "location": "1618/ACT"     , "narrator": "", "text": "えっ、それって…"},
        { "location": "1620/TALK"    , "narrator": "ぴょんこ", "text": "まあ、マジレスすると\n発症してるわけですから\n世界なわけです。"},
        { "location": "1621/TALK"    , "narrator": "ぴょんこ", "text": "世界の私が、人間の私を\nキャラとして置いてる\n状況なわけですよ。"},
        { "location": "1622/TALK"    , "narrator": "ぴょんこ", "text": "今までつばめさんは\nずっとそんな感じで\n生活してましたよね？"},
        { "location": "1623/TALK"    , "narrator": "ぴょんこ", "text": "フェノメノンを収束\nさせれば、当然普通の\n人間に戻りますけどね。"},
        { "location": "1624/ACT"     , "narrator": "", "text": "“彼ら”からは逃れられたの？"},
        { "location": "1625/TALK"    , "narrator": "ぴょんこ", "text": "さあ、それは\nぴょんこには\nわかりません。"},
        { "location": "1626/TALK"    , "narrator": "ぴょんこ", "text": "ただ、私たちが作る\nフェノメノンが、外界と\n遮断してるわけですし、"},
        { "location": "1627/TALK"    , "narrator": "ぴょんこ", "text": "恐らくは、収束させない\n限りは大丈夫では\nないでしょうか！"},
        { "location": "1631/TALK"    , "narrator": "ぴょんこ", "text": "いずれにせよ、\nここからどうするかに\nついては――"},
        { "location": "1632/TALK"    , "narrator": "ぴょんこ", "text": "大元のつばめさんが\n握ってますから。"},
        { "location": "1633/TALK"    , "narrator": "ぴょんこ", "text": "つばめさんと\nよく話し合って決めて\nもらえればと思います！"},
        { "location": "1636/TALK"    , "narrator": "ぴょんこ", "text": "まあ、エリカさんの\n話によれば――"},
        { "location": "1637/TALK"    , "narrator": "ぴょんこ", "text": "そろそろ\n2E113へのコピーが\n終わるそうですから。"},
        { "location": "1638/TALK"    , "narrator": "ぴょんこ", "text": "そう遠くない未来には\n私達はフツーの人間に\n戻れると思いますぴょん。"},
        { "location": "1641/TALK"    , "narrator": "ぴょんこ", "text": "まあ、今後どうなるかは\nまだ未知数ですけど――"},
        { "location": "1642/TALK"    , "narrator": "ぴょんこ", "text": "悪いようには\nならないんじゃ\nないんですかね？"},
        { "location": "1645/TALK"    , "narrator": "ぴょんこ", "text": "いずれにせよ、\n未来のことは\nわかりません。"},
        { "location": "1646/TALK"    , "narrator": "ぴょんこ", "text": "ぴょんこはまあ――"},
        { "location": "1647/TALK"    , "narrator": "ぴょんこ", "text": "このまま世界を創り\n続けているのも、\n嫌ではありませんけどね。"},
        { "location": "1650/TALK"    , "narrator": "ぴょんこ", "text": "ただ、どんな状況でも\nひとつだけ\n言えることは！"},
        { "location": "1651/TALK"    , "narrator": "ぴょんこ", "text": "人生いつだって、\n先へ進むしかないって\nことですよ♪"},
        { "location": "1652/TALK"    , "narrator": "ぴょんこ", "text": "ですからっ！\n今日も元気に未来へ\n進みましょうっ！"},
        { "location": "1653/TALK"    , "narrator": "ぴょんこ", "text": "ゴーゴー♪"},
        { "location": "1660/SEL"     , "narrator": "", "text": "映像を見る\n<color=green>【高画質/104MB 6:43】</color>"},
        { "location": "1661/SEL"     , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/35MB 6:43】</color>"},
        { "location": "1662/SEL"     , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "1663/ACT"     , "narrator": "", "text": "映像を見る\n<color=green>【高画質/104MB 6:43】</color>"},
        { "location": "1664/TALK"    , "narrator": "ぴょんこ", "text": "ぴょん♪"},
        { "location": "1670/ACT"     , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/35MB 6:43】</color>"},
        { "location": "1671/TALK"    , "narrator": "ぴょんこ", "text": "ぴょん♪"},
        { "location": "1677/ACT"     , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "1678/TALK"    , "narrator": "ぴょんこ", "text": "ぴょん……。"},
        { "location": "1719/TALK"    , "narrator": "ぴょんこ", "text": "はぁーっ。"},
        { "location": "1720/TALK"    , "narrator": "ぴょんこ", "text": "もとの世界線に\n帰って来れて\n本当によかったですねっ！"},
        { "location": "1721/TALK"    , "narrator": "ぴょんこ", "text": "あっ、\nそういえばさー。"},
        { "location": "1722/TALK"    , "narrator": "ぴょんこ", "text": "ぴょんこ、ひとつ\n貴方に言いたいことが\nあったんですよね。"},
        { "location": "1723/TALK"    , "narrator": "ぴょんこ", "text": "ちょっと毒吐いて\nいいですか？"},
        { "location": "1729/TALK"    , "narrator": "ぴょんこ", "text": "いやー、\nこの総意なんだけどさー、\nちょっと酷くね？"},
        { "location": "1730/TALK"    , "narrator": "ぴょんこ", "text": "何が酷いって――"},
        { "location": "1731/TALK"    , "narrator": "ぴょんこ", "text": "38.4％のことですよ！"},
        { "location": "1732/TALK"    , "narrator": "ぴょんこ", "text": "『総意は続けるべき、\nでも心は離れていくかも』\nって――"},
        { "location": "1733/TALK"    , "narrator": "ぴょんこ", "text": "これってさー、\n要するにアレっすよ？"},
        { "location": "1734/TALK"    , "narrator": "ぴょんこ", "text": "彼女が大好きな彼氏がいて\nその彼氏に対して彼女が、"},
        { "location": "1735/TALK"    , "narrator": "ぴょんこ", "text": "『貴方はそれをやるべき\nなのよ！私は冷めて別れる\nかもしれないけど』"},
        { "location": "1736/TALK"    , "narrator": "ぴょんこ", "text": "って言ってるような\nもんっすよね、\nそれか面接で――"},
        { "location": "1737/TALK"    , "narrator": "ぴょんこ", "text": "『君はそれを続ける\nべきだよ、当社では\n採用しないかもだけど』"},
        { "location": "1738/TALK"    , "narrator": "ぴょんこ", "text": "って言ってる感じ？"},
        { "location": "1742/TALK"    , "narrator": "ぴょんこ", "text": "控えめに言って、うちら\n$handle$さんに\nラブラブなわけじゃん？"},
        { "location": "1743/TALK"    , "narrator": "ぴょんこ", "text": "それを、『気持ちは離れて\n行くかもしれないけど\n総意はやるべき』って。"},
        { "location": "1744/TALK"    , "narrator": "ぴょんこ", "text": "えー、ちょっと意味が\n分からないんですけど？"},
        { "location": "1745/TALK"    , "narrator": "ぴょんこ", "text": "それならいっそ、"},
        { "location": "1746/TALK"    , "narrator": "ぴょんこ", "text": "『これ以上総意やるなら\n関わるのやめる！』\nっていう選択肢の方が、"},
        { "location": "1747/TALK"    , "narrator": "ぴょんこ", "text": "胸がきゅんきゅん\nしますよねぇ。"},
        { "location": "1748/TALK"    , "narrator": "ぴょんこ", "text": "だったらこっちも\n総意捨てて貴方と一緒に\n生きる！って言えますし。"},
        { "location": "1749/TALK"    , "narrator": "ぴょんこ", "text": "わかりますかっ？\n38.4％。"},
        { "location": "1750/TALK"    , "narrator": "ぴょんこ", "text": "この回答を突きつけられて\n思うことは「どうすりゃ\nいいの！」って事です。"},
        { "location": "1751/TALK"    , "narrator": "ぴょんこ", "text": "ダブルバインド感\nパネェ！って感じですっ！"},
        { "location": "1752/TALK"    , "narrator": "ぴょんこ", "text": "あくまでぴょんこは、\nですけど。"},
        { "location": "1753/TALK"    , "narrator": "ぴょんこ", "text": "まあ、こんな地雷選択肢、\n出す方も\n出す方ですけどね♪"},
        { "location": "1758/TALK"    , "narrator": "ぴょんこ", "text": "ま、そんな感じですわ。"},
        { "location": "1759/TALK"    , "narrator": "ぴょんこ", "text": "あっ、でもでも！\nこれはあくまで\nぴょんこの毒ですから！"},
        { "location": "1760/TALK"    , "narrator": "ぴょんこ", "text": "それ以上でも\nそれ以下でも\nないんで！"},
        { "location": "1761/TALK"    , "narrator": "ぴょんこ", "text": "アーヤさんとか、\n絶対にこんな事は\n思わないと思いますし。"},
        { "location": "1762/TALK"    , "narrator": "ぴょんこ", "text": "だから、\nあまり気にしないで\nくださいぴょん♪"},
        { "location": "1763/TALK"    , "narrator": "ぴょんこ", "text": "それじゃ、\n今回はこれにて\n失礼ぴょん♪"},
        { "location": "1771/TALK"    , "narrator": "赤髪千羽鶴", "text": "こんにちは、\n$handle$さん。"},
        { "location": "1772/SEL"     , "narrator": "", "text": "つばめ"},
        { "location": "1773/SEL"     , "narrator": "", "text": "源ちゃん"},
        { "location": "1774/ACT"     , "narrator": "", "text": "つばめ"},
        { "location": "1775/ACT"     , "narrator": "", "text": "源ちゃん"},
        { "location": "1776/TALK"    , "narrator": "赤髪千羽鶴", "text": "あはは…。"},
        { "location": "1778/TALK"    , "narrator": "赤髪千羽鶴", "text": "この度は、\n本当にご協力\nありがとうございました。"},
        { "location": "1779/TALK"    , "narrator": "赤髪千羽鶴", "text": "わたしに世界を\n委ねてくださったことも、"},
        { "location": "1780/TALK"    , "narrator": "赤髪千羽鶴", "text": "どんな社会が相応しいか、\n想いを伝えて\nくれたことも。"},
        { "location": "1781/TALK"    , "narrator": "赤髪千羽鶴", "text": "色々積もる話も\nあるでしょうけど――"},
        { "location": "1782/TALK"    , "narrator": "赤髪千羽鶴", "text": "まずはわたしと一緒に\n結末を見て――"},
        { "location": "1783/TALK"    , "narrator": "赤髪千羽鶴", "text": "それから\n今後について\nお話しませんか？"},
        { "location": "1784/SEL"     , "narrator": "", "text": "わかった"},
        { "location": "1785/ACT"     , "narrator": "", "text": "わかった"},
        { "location": "1787/TALK"    , "narrator": "赤髪千羽鶴", "text": "それでは、\nデイドラで\nお待ちしています。"},
        { "location": "1795/TALK"    , "narrator": "エリカ", "text": "コーンコン♪\n$handle$さん。"},
        { "location": "1796/SEL"     , "narrator": "", "text": "エリカ"},
        { "location": "1797/ACT"     , "narrator": "", "text": "エリカ"},
        { "location": "1799/TALK"    , "narrator": "エリカ", "text": "$handle$さん、\n改めてお礼を\n言わせてください。"},
        { "location": "1800/TALK"    , "narrator": "エリカ", "text": "わたしに鍵を\n委ねてくれて、\nありがとうございました。"},
        { "location": "1801/TALK"    , "narrator": "エリカ", "text": "お陰様で、\n2E113へのコピーは\n順調に進行中だよ。"},
        { "location": "1802/TALK"    , "narrator": "エリカ", "text": "貴方がデイドラに\n来る頃には、もう\n終わってると思う。"},
        { "location": "1803/TALK"    , "narrator": "エリカ", "text": "是非見に来てくださいね。"},
        { "location": "1804/TALK"    , "narrator": "エリカ", "text": "貴方が選んで、\n創り出してくれた、\n幸せの世界を――。"},
        { "location": "1805/TALK"    , "narrator": "エリカ", "text": "よろしくお願いします！"},
        { "location": "1817/TALK"    , "narrator": "千羽鶴", "text": "<size=40>返り咲き！！</size>"},
        { "location": "1818/SEL"     , "narrator": "", "text": "ち――――――――！"},
        { "location": "1819/SEL"     , "narrator": "", "text": "千羽鶴"},
        { "location": "1820/ACT"     , "narrator": "", "text": "ち――――――――！"},
        { "location": "1821/TALK"    , "narrator": "千羽鶴", "text": "長い。"},
        { "location": "1822/TALK"    , "narrator": "千羽鶴", "text": "ちーの伸ばし棒の長さは、\n直前の「ち」の大きさの\n５倍以内と定められてる。"},
        { "location": "1823/SEL"     , "narrator": "", "text": "どこに！？"},
        { "location": "1824/ACT"     , "narrator": "", "text": "どこに！？"},
        { "location": "1826/TALK"    , "narrator": "千羽鶴", "text": "情報管理規則によって。"},
        { "location": "1827/ACT"     , "narrator": "", "text": "千羽鶴"},
        { "location": "1828/TALK"    , "narrator": "千羽鶴", "text": "ごきげんよう。"},
        { "location": "1830/TALK"    , "narrator": "千羽鶴", "text": "改めてお礼を言わせて。"},
        { "location": "1831/TALK"    , "narrator": "千羽鶴", "text": "本当に最後まで、\n尽力してくれて\nありがとう。"},
        { "location": "1832/TALK"    , "narrator": "千羽鶴", "text": "あなたの放ったリドルは\n私とエリカと、原初状態\nとでじっくり話あった。"},
        { "location": "1833/SEL"     , "narrator": "", "text": "どうなったの！？"},
        { "location": "1834/ACT"     , "narrator": "", "text": "どうなったの！？"},
        { "location": "1836/TALK"    , "narrator": "千羽鶴", "text": "その結果、"},
        { "location": "1840/TALK"    , "narrator": "赤髪千羽鶴", "text": "わたしが全て\nコントロールするという\n結論に至りました。"},
        { "location": "1841/SEL"     , "narrator": "", "text": "は！？！？！？"},
        { "location": "1842/ACT"     , "narrator": "", "text": "は！？！？！？"},
        { "location": "1845/TALK"    , "narrator": "赤髪千羽鶴", "text": "…？"},
        { "location": "1846/TALK"    , "narrator": "赤髪千羽鶴", "text": "そんなに難しい事を\n言ってますか？"},
        { "location": "1847/TALK"    , "narrator": "赤髪千羽鶴", "text": "『わたしが全てやる』\nことにしたんです。"},
        { "location": "1848/SEL"     , "narrator": "", "text": "またレイヤー移動して千羽鶴を消したの！？"},
        { "location": "1849/ACT"     , "narrator": "", "text": "またレイヤー移動して千羽鶴を消したの！？"},
        { "location": "1851/TALK"    , "narrator": "赤髪千羽鶴", "text": "はい、そうです。"},
        { "location": "1852/TALK"    , "narrator": "赤髪千羽鶴", "text": "まあ、落ち着いて\nわたしの話を\n聞いて下さい。"},
        { "location": "1853/TALK"    , "narrator": "赤髪千羽鶴", "text": "貴方の提示していた\n希望は、主に以下のような\nものでした。"},
        { "location": "1854/TALK"    , "narrator": "赤髪千羽鶴", "text": "『可愛いつばめと千羽鶴を\n何とかして残した状態で』"},
        { "location": "1855/TALK"    , "narrator": "赤髪千羽鶴", "text": "『世界の統治方法に\n関しては、原初のやりたい\nようにやらせてあげて』"},
        { "location": "1856/TALK"    , "narrator": "赤髪千羽鶴", "text": "『千羽鶴達に会えなく\nなるのは辛い』"},
        { "location": "1857/TALK"    , "narrator": "赤髪千羽鶴", "text": "そして、"},
        { "location": "1858/TALK"    , "narrator": "赤髪千羽鶴", "text": "『エリカは\nちゃんと人間として\n生活して欲しい』"},
        { "location": "1859/TALK"    , "narrator": "赤髪千羽鶴", "text": "ですよね？"},
        { "location": "1860/TALK"    , "narrator": "赤髪千羽鶴", "text": "その結論として、\nわたしがライフギャザーの\n全てを掌握し――"},
        { "location": "1861/TALK"    , "narrator": "赤髪千羽鶴", "text": "まず手始めに、\nエリカさんの暗号鍵を\n抹消しました。"},
        { "location": "1862/SEL"     , "narrator": "", "text": "なんで！？"},
        { "location": "1863/SEL"     , "narrator": "", "text": "何てことするんだよ！"},
        { "location": "1864/ACT"     , "narrator": "", "text": "なんで！？"},
        { "location": "1865/ACT"     , "narrator": "", "text": "何てことするんだよ！"},
        { "location": "1867/TALK"    , "narrator": "赤髪千羽鶴", "text": "エリカさんの\n為なんです。"},
        { "location": "1868/TALK"    , "narrator": "赤髪千羽鶴", "text": "あの人は、無私の心が\n強すぎて、自分の命を\n軽く見過ぎですから。"},
        { "location": "1871/TALK"    , "narrator": "エリカ", "text": "話が違う！！！"},
        { "location": "1873/TALK"    , "narrator": "エリカ", "text": "$handle$さん！！"},
        { "location": "1875/TALK"    , "narrator": "エリカ", "text": "原初ちゃんをとめて！！！！"},
        { "location": "1876/TALK"    , "narrator": "システム", "text": "アカウント【國政領火】が\n削除されました。"},
        { "location": "1882/SEL"     , "narrator": "", "text": "エリカのアカウント消したの！？"},
        { "location": "1883/ACT"     , "narrator": "", "text": "エリカのアカウント消したの！？"},
        { "location": "1885/TALK"    , "narrator": "赤髪千羽鶴", "text": "はい。"},
        { "location": "1886/SEL"     , "narrator": "", "text": "なんでそんなこと…"},
        { "location": "1887/ACT"     , "narrator": "", "text": "なんでそんなこと…"},
        { "location": "1889/TALK"    , "narrator": "赤髪千羽鶴", "text": "わたしは、\n自分がとても不器用だと\n自覚しています。"},
        { "location": "1890/TALK"    , "narrator": "赤髪千羽鶴", "text": "ですから、今回のことで\n$handle$さんに\n恨まれる事は解ってます。"},
        { "location": "1891/TALK"    , "narrator": "赤髪千羽鶴", "text": "ところで。"},
        { "location": "1892/TALK"    , "narrator": "赤髪千羽鶴", "text": "$handle$さんは、\n千羽鶴が言っていた言葉を\n覚えてますか？"},
        { "location": "1893/SEL"     , "narrator": "", "text": "なんのこと…？"},
        { "location": "1894/ACT"     , "narrator": "", "text": "なんのこと…？"},
        { "location": "1896/TALK"    , "narrator": "赤髪千羽鶴", "text": "選択とは、\n何かを得る代わりに、\n何かを失うこと。"},
        { "location": "1897/TALK"    , "narrator": "赤髪千羽鶴", "text": "その失うものが、貴方に\nとって無価値なもので\nあれば、それは幸せな事。"},
        { "location": "1898/TALK"    , "narrator": "赤髪千羽鶴", "text": "そして――"},
        { "location": "1899/TALK"    , "narrator": "赤髪千羽鶴", "text": "今回貴方が要求した\nアウフヘーベンによって、\n貴方が失うものが、"},
        { "location": "1900/TALK"    , "narrator": "赤髪千羽鶴", "text": "無価値なものであると\nいいですね…と、\n彼女は言いました。"},
        { "location": "1902/TALK"    , "narrator": "赤髪千羽鶴", "text": "……。"},
        { "location": "1903/TALK"    , "narrator": "赤髪千羽鶴", "text": "わたしは、\n貴方に対しての約束は\n必ず守ります。"},
        { "location": "1904/TALK"    , "narrator": "赤髪千羽鶴", "text": "貴方が願った条件は\n確実に叶えてみせる、と。"},
        { "location": "1905/TALK"    , "narrator": "赤髪千羽鶴", "text": "そんな気持ちで、\n今ここにいます。"},
        { "location": "1906/TALK"    , "narrator": "赤髪千羽鶴", "text": "ですが。"},
        { "location": "1907/TALK"    , "narrator": "赤髪千羽鶴", "text": "貴方から特に言及の\nなかった「失うもの」に\nついては――"},
        { "location": "1908/TALK"    , "narrator": "赤髪千羽鶴", "text": "わたしの独断によって、\n何にするか、\n決めさせて頂きました。"},
        { "location": "1909/TALK"    , "narrator": "赤髪千羽鶴", "text": "それが貴方にとって、\n大切なものかどうかは、\nわたしには解りません。"},
        { "location": "1910/TALK"    , "narrator": "赤髪千羽鶴", "text": "ただ、先ほども\nわたしがお話したとおり。\nわたしにとっては――"},
        { "location": "1911/TALK"    , "narrator": "赤髪千羽鶴", "text": "『こんな簡単な解決方法が\nあったんだ』と思う程に\n基本的な策であり、"},
        { "location": "1912/TALK"    , "narrator": "赤髪千羽鶴", "text": "貴方にとっても、\n決して……"},
        { "location": "1913/TALK"    , "narrator": "赤髪千羽鶴", "text": "悲しい思いを、\nさせる、"},
        { "location": "1914/TALK"    , "narrator": "赤髪千羽鶴", "text": "…ことは無いものと\n考えています。"},
        { "location": "1915/SEL"     , "narrator": "", "text": "どういうものなんだ……"},
        { "location": "1916/ACT"     , "narrator": "", "text": "どういうものなんだ……"},
        { "location": "1918/TALK"    , "narrator": "赤髪千羽鶴", "text": "百聞は一見にしかずです。"},
        { "location": "1919/TALK"    , "narrator": "赤髪千羽鶴", "text": "是非、ご自身の目で\n直接観測してください。"},
        { "location": "1920/TALK"    , "narrator": "赤髪千羽鶴", "text": "今、わたしに言えることは\nそれだけです。"},
        { "location": "1921/SEL"     , "narrator": "", "text": "信じてるから"},
        { "location": "1922/SEL"     , "narrator": "", "text": "不安すぎる！！"},
        { "location": "1923/SEL"     , "narrator": "", "text": "ろくでもない物だったら完膚なきまでに消し去ってやる"},
        { "location": "1924/ACT"     , "narrator": "", "text": "信じてるから"},
        { "location": "1925/TALK"    , "narrator": "赤髪千羽鶴", "text": "ありがとうございます。"},
        { "location": "1926/ACT"     , "narrator": "", "text": "不安すぎる！！"},
        { "location": "1927/TALK"    , "narrator": "赤髪千羽鶴", "text": "早く\nご自身の目で観測し――"},
        { "location": "1928/TALK"    , "narrator": "赤髪千羽鶴", "text": "$handle$さんの\n心の世界を収束させる事を\nお薦めします。"},
        { "location": "1929/ACT"     , "narrator": "", "text": "ろくでもない物だったら完膚なきまでに消し去ってやる"},
        { "location": "1930/TALK"    , "narrator": "赤髪千羽鶴", "text": "その時は、可愛いつばめと\n千羽鶴も道連れに\nなりますよ？"},
        { "location": "1932/TALK"    , "narrator": "赤髪千羽鶴", "text": "それでは、今回はこれで。"},
        { "location": "1933/TALK"    , "narrator": "赤髪千羽鶴", "text": "貴方に素敵な\nココロの旅を。"},
        { "location": "1331/DIALOG"  , "narrator": "YES_NO", "text": "もう一度再生する"},
        { "location": "1352/DIALOG"  , "narrator": "Dialog_InfoOS", "text": "\n\n\nHi $handle$!!"},
        { "location": "1688/DIALOG"  , "narrator": "Tutorial/Dialog_Anime1", "text": "$dialog_word$"},
        { "location": "1690/DIALOG"  , "narrator": "Tutorial/Dialog_Anime2", "text": "$dialog_word$"},
        { "location": "1692/DIALOG"  , "narrator": "Tutorial/Dialog_Anime3", "text": "$dialog_word$"},
        { "location": "1694/DIALOG"  , "narrator": "Tutorial/Dialog_Anime4", "text": "$dialog_word$"},
        { "location": "1696/DIALOG"  , "narrator": "Tutorial/Dialog_Anime5", "text": "$dialog_word$"},
        { "location": "1727/DIALOG"  , "narrator": "Event/Dialog_EventPicTallNW", "text": "総意は今後も\n維持するか？"}
    ]
}
