{
    "dir": "chap07/daydra/dd_ch03_07_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "7356",
        "cid": "gabriella",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "美術の授業"
    },
    "entry":
    [
        { "location": "320/SCENARIO", "narrator": "", "text": "美術の授業"},
        { "location": "332/TALK"    , "narrator": "ガブリエラ", "text": "う～ん…。"},
        { "location": "335/TALK"    , "narrator": "アーヤ", "text": "ギャヴィ、何してるの？"},
        { "location": "336/TALK"    , "narrator": "ガブリエラ", "text": "見ればわかるでしょ？\n美術の授業中よ。"},
        { "location": "337/TALK"    , "narrator": "アーヤ", "text": "あ、そうだったんだ。\n邪魔しちゃって\nごめん――"},
        { "location": "339/TALK"    , "narrator": "アーヤ", "text": "って、何その絵！？\n凄く上手いじゃない！"},
        { "location": "340/TALK"    , "narrator": "アーヤ", "text": "ギャヴィにこんな\n特技があるなんて\n知らなかったわ。"},
        { "location": "343/TALK"    , "narrator": "ガブリエラ", "text": "べ、別に、特技って程じゃ\nないけど…。"},
        { "location": "344/TALK"    , "narrator": "アーヤ", "text": "謙遜する必要ないでしょ？\nそれだけ描けるんだし。"},
        { "location": "346/TALK"    , "narrator": "ガブリエラ", "text": "…下書きはね。"},
        { "location": "348/TALK"    , "narrator": "ガブリエラ", "text": "けど、絵具で色を塗るのが\n凄く苦手なのよ…。"},
        { "location": "349/TALK"    , "narrator": "ガブリエラ", "text": "どうしても求めてる色が、\n作れないから――"},
        { "location": "350/TALK"    , "narrator": "ガブリエラ", "text": "毎回微妙に違和感のある\n絵になっちゃって…。"},
        { "location": "351/TALK"    , "narrator": "アーヤ", "text": "あ～…まあ、わからない\nでもないわ。"},
        { "location": "352/TALK"    , "narrator": "アーヤ", "text": "私も、同じような経験\nしたことあるし…。"},
        { "location": "354/TALK"    , "narrator": "ガブリエラ", "text": "あー、もうっ！"},
        { "location": "355/TALK"    , "narrator": "ガブリエラ", "text": "空の色はもう少し\n薄い青じゃなきゃ\nダメなのに！"},
        { "location": "358/TALK"    , "narrator": "ガブリエラ", "text": "はぁ…ヤル気失せるわ…。"},
        { "location": "359/TALK"    , "narrator": "アーヤ", "text": "…まあ、別に見たままの\n色にしなくてもいいんじゃ\nない？"},
        { "location": "360/TALK"    , "narrator": "アーヤ", "text": "絵は写真じゃないん\nだから、少し違った方が\n味が出るわよ。"},
        { "location": "362/TALK"    , "narrator": "ガブリエラ", "text": "…そういうもの？"},
        { "location": "365/TALK"    , "narrator": "アーヤ", "text": "ま、まあ、私も詳しい\nわけじゃないから、\n断言はできないけど…。"},
        { "location": "368/TALK"    , "narrator": "アーヤ", "text": "でも、有名な画家の絵とか\n見てると、凄い色使い\nしてるのがあるじゃない。"},
        { "location": "369/TALK"    , "narrator": "アーヤ", "text": "空が黄色だったり、\n色んな色が混ざって\nたり…。"},
        { "location": "370/TALK"    , "narrator": "ガブリエラ", "text": "…見たことはあるわ。"},
        { "location": "371/TALK"    , "narrator": "アーヤ", "text": "だから、それと同じ感じで\n塗ってみたらどう？"},
        { "location": "374/TALK"    , "narrator": "ガブリエラ", "text": "う～ん…。"},
        { "location": "375/TALK"    , "narrator": "アーヤ", "text": "まあ、やり過ぎたら\n減点されると思うけど…。"},
        { "location": "377/TALK"    , "narrator": "ガブリエラ", "text": "…難しそうだけど、\nちょっと楽しそうかも。"},
        { "location": "379/TALK"    , "narrator": "ガブリエラ", "text": "わかった。\nその方向で描いてみるわ。"},
        { "location": "380/TALK"    , "narrator": "アーヤ", "text": "よかった…。\nそれじゃ、頑張ってね。"},
        { "location": "384/TALK"    , "narrator": "ガブリエラ", "text": "そっか…あたしが見たい\n空の色にしちゃっても\nいいのよね？"},
        { "location": "386/TALK"    , "narrator": "ガブリエラ", "text": "写真じゃないんだから、\nどんな色にだって\nできるんだもの。"},
        { "location": "387/TALK"    , "narrator": "ガブリエラ", "text": "…そうだ。\nマルザンナは\nどう思うかしら？"},
        { "location": "399/TALK"    , "narrator": "ガブリエラ", "text": "マルザンナ、空は何色だと思う？"},
        { "location": "401/SEL"     , "narrator": "", "text": "昼間は青、夜は黒"},
        { "location": "402/ACT"     , "narrator": "", "text": "昼間は青、夜は黒"},
        { "location": "404/TALK"    , "narrator": "ガブリエラ", "text": "ふふっ、普通に見たらそうよね？"},
        { "location": "405/TALK"    , "narrator": "ガブリエラ", "text": "けど、私はこう思うの"},
        { "location": "406/TALK"    , "narrator": "ガブリエラ", "text": "もしも空が色んな色に輝いていたとしたら、凄く素敵だと思わない？"},
        { "location": "407/TALK"    , "narrator": "ガブリエラ", "text": "それを絵にしようと思うんだけど、あなたはどう思う？"},
        { "location": "409/SEL"     , "narrator": "", "text": "いや、空は青でしょ？"},
        { "location": "410/SEL"     , "narrator": "", "text": "オーロラみたいで素敵だ"},
        { "location": "411/SEL"     , "narrator": "", "text": "太陽に顔も描こう"},
        { "location": "412/ACT"     , "narrator": "", "text": "いや、空は青でしょ？"},
        { "location": "413/TALK"    , "narrator": "ガブリエラ", "text": "確かにその通りだけど…"},
        { "location": "414/TALK"    , "narrator": "ガブリエラ", "text": "マルザンナって、夢がないのね"},
        { "location": "426/TALK"    , "narrator": "ガブリエラ", "text": "はぁ…せっかく楽しい\n気持ちだったのに、\n一気に冷めちゃったわ。"},
        { "location": "427/TALK"    , "narrator": "ガブリエラ", "text": "…もういいや。\nこの青塗って、さっさと\n終わらせちゃお…。"},
        { "location": "428/ACT"     , "narrator": "", "text": "オーロラみたいで素敵だ"},
        { "location": "430/TALK"    , "narrator": "ガブリエラ", "text": "素晴らしい例えだわ、マルザンナ"},
        { "location": "431/TALK"    , "narrator": "ガブリエラ", "text": "空全体をオーロラみたいな美しい色にしてみるわ"},
        { "location": "442/TALK"    , "narrator": "ガブリエラ", "text": "ふふっ、なんだか楽しく\nなってきたかも。"},
        { "location": "444/TALK"    , "narrator": "ガブリエラ", "text": "それじゃあまずは青に\n紫、緑に赤、それと――"},
        { "location": "460/TALK"    , "narrator": "ガブリエラ", "text": "はぁ……。"},
        { "location": "463/TALK"    , "narrator": "アーヤ", "text": "ギャヴィ、大丈夫？"},
        { "location": "465/TALK"    , "narrator": "ガブリエラ", "text": "アーヤ…大変なことに\nなっちゃったわ。"},
        { "location": "466/TALK"    , "narrator": "アーヤ", "text": "何かあったの？"},
        { "location": "467/TALK"    , "narrator": "ガブリエラ", "text": "美術の時間に描いた絵の\nことなんだけど…。"},
        { "location": "468/TALK"    , "narrator": "ガブリエラ", "text": "アーヤのアドバイスを\n聞いて、本物と違う色で\n描いてみたら――"},
        { "location": "469/TALK"    , "narrator": "ガブリエラ", "text": "先生、物凄く気に入った\nらしくて…。"},
        { "location": "471/TALK"    , "narrator": "アーヤ", "text": "あら、それなら\n良かったじゃない。"},
        { "location": "473/TALK"    , "narrator": "ガブリエラ", "text": "良くない！"},
        { "location": "474/TALK"    , "narrator": "ガブリエラ", "text": "この絵は素晴らしいから、\nって、絵のコンクールに\n出すことになったのよ？"},
        { "location": "476/TALK"    , "narrator": "アーヤ", "text": "えっ！？\nどうしてそんなことに\nなっちゃったの！？"},
        { "location": "477/TALK"    , "narrator": "ガブリエラ", "text": "わからないわよ…。"},
        { "location": "478/TALK"    , "narrator": "ガブリエラ", "text": "感性が素晴らしいとか、\nなんかそんなこと\n言ってた気がするけど――"},
        { "location": "479/TALK"    , "narrator": "ガブリエラ", "text": "あたしには、さっぱり\n何が何だかわからな\nかったわ…。"},
        { "location": "480/TALK"    , "narrator": "アーヤ", "text": "そ、そう…。"},
        { "location": "481/TALK"    , "narrator": "アーヤ", "text": "でも、認められたって\n証拠なんだから、\n喜ぶべきことよ。"},
        { "location": "482/TALK"    , "narrator": "ガブリエラ", "text": "…カラフルな空の絵が\n大勢に見られるのかと\n思うと――"},
        { "location": "484/TALK"    , "narrator": "ガブリエラ", "text": "素直に喜べないわ…。"},
        { "location": "485/TALK"    , "narrator": "アーヤ", "text": "この子、どんな絵を\n描いたのかしら？"},
        { "location": "502/ACT"     , "narrator": "", "text": "太陽に顔も描こう"},
        { "location": "503/TALK"    , "narrator": "ガブリエラ", "text": "それも素敵ね"},
        { "location": "504/TALK"    , "narrator": "ガブリエラ", "text": "どことなくモダンな感じの絵になりそうな予感がするわ"},
        { "location": "516/TALK"    , "narrator": "ガブリエラ", "text": "ふふっ…なんだか楽しく\nなってきたかも。"},
        { "location": "517/TALK"    , "narrator": "ガブリエラ", "text": "時間もないし、\nさっさと始めないと！"},
        { "location": "532/TALK"    , "narrator": "ガブリエラ", "text": "はぁ……。"},
        { "location": "535/TALK"    , "narrator": "アーヤ", "text": "ギャヴィ、大丈夫？"},
        { "location": "537/TALK"    , "narrator": "ガブリエラ", "text": "アーヤ…はぁ…。"},
        { "location": "538/TALK"    , "narrator": "アーヤ", "text": "どうしたの？\nため息ばかり吐いて…。"},
        { "location": "539/TALK"    , "narrator": "ガブリエラ", "text": "…美術で描いた絵よ。"},
        { "location": "542/TALK"    , "narrator": "ガブリエラ", "text": "アーヤの言う通りに\n描いたら、先生に\nドン引きされたわ。"},
        { "location": "544/TALK"    , "narrator": "アーヤ", "text": "えっ！？"},
        { "location": "545/TALK"    , "narrator": "ガブリエラ", "text": "ガブリエラさんは、\n独特の感性を持っている\nのね、って――"},
        { "location": "546/TALK"    , "narrator": "ガブリエラ", "text": "引きつった顔で\n言われたのよ。"},
        { "location": "547/TALK"    , "narrator": "アーヤ", "text": "何を描いたの？\nただの風景画のどこで\nドン引きするのよ？"},
        { "location": "548/TALK"    , "narrator": "ガブリエラ", "text": "太陽に描いた顔が\nいけなかったみたい。"},
        { "location": "549/TALK"    , "narrator": "アーヤ", "text": "…ちょっと待って。"},
        { "location": "550/TALK"    , "narrator": "アーヤ", "text": "ただの風景画に、\n顔のある太陽なんて\n必要ないじゃない。"},
        { "location": "551/TALK"    , "narrator": "ガブリエラ", "text": "だって、アーヤが\n言ったんでしょ！？"},
        { "location": "552/TALK"    , "narrator": "ガブリエラ", "text": "写真じゃないんだから、\n見たまんまに描く必要は\nない、って…。"},
        { "location": "553/TALK"    , "narrator": "アーヤ", "text": "だからって、太陽に顔を\n描くのは、明らかに\nやり過ぎでしょ？"},
        { "location": "554/TALK"    , "narrator": "アーヤ", "text": "っていうか、やり過ぎに\n気を付けろとも、ちゃんと\n言ったのに…。"},
        { "location": "556/TALK"    , "narrator": "ガブリエラ", "text": "提出した絵が返される\nことを考えると、\n恥ずかしくて堪らないわ。"},
        { "location": "558/TALK"    , "narrator": "アーヤ", "text": "…描いてるときに\n気付きなさいよ。"},
        { "location": "330/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>5月11日　1:21 PM</color>\nとある午後、美術の授業中のこと。"},
        { "location": "496/DIALOG"  , "narrator": "Dialog_GEThimegoto_ch03", "text": "【新しい空】"}
    ]
}
