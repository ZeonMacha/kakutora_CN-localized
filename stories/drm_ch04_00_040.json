    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "07_決定権はうちにある"},
        { "location": "33/TALK"   , "narrator": "みやび", "text": "今のうちにはっきりさせておいた方がいいと思うぞ"},
        { "location": "34/TALK"   , "narrator": "みやび", "text": "相棒よ"},
        { "location": "37/SEL"    , "narrator": "", "text": "何の話？"},
        { "location": "38/ACT"    , "narrator": "", "text": "何の話？"},
        { "location": "39/TALK"   , "narrator": "みやび", "text": "$handle$はうちに隠し事をしとろう"},
        { "location": "42/SEL"    , "narrator": "", "text": "$me$は隠し事なんてしてないよ"},
        { "location": "43/SEL"    , "narrator": "", "text": "むしろみやびの秘密を知りたい"},
        { "location": "44/ACT"    , "narrator": "", "text": "$me$は隠し事なんてしてないよ"},
        { "location": "45/TALK"   , "narrator": "みやび", "text": "隠し事をしている時"},
        { "location": "46/TALK"   , "narrator": "みやび", "text": "人はそう言うのだ"},
        { "location": "47/ACT"    , "narrator": "", "text": "むしろみやびの秘密を知りたい"},
        { "location": "48/TALK"   , "narrator": "みやび", "text": "それは簡単には教えられん"},
        { "location": "49/TALK"   , "narrator": "みやび", "text": "当然だろう"},
        { "location": "51/TALK"   , "narrator": "みやび", "text": "思い当たる節はないのかね"},
        { "location": "54/SEL"    , "narrator": "", "text": "みやびが好きで仕方ないことは隠してた"},
        { "location": "55/SEL"    , "narrator": "", "text": "隠すようなことってないし"},
        { "location": "56/SEL"    , "narrator": "", "text": "質問が漠然としすぎ"},
        { "location": "57/ACT"    , "narrator": "", "text": "みやびが好きで仕方ないことは隠してた"},
        { "location": "58/TALK"   , "narrator": "みやび", "text": "それは"},
        { "location": "59/TALK"   , "narrator": "みやび", "text": "もっとアピールするポイントぞね"},
        { "location": "61/SEL"    , "narrator": "", "text": "君のためなら死ねる"},
        { "location": "62/SEL"    , "narrator": "", "text": "好きだ好きだ好きだ"},
        { "location": "63/SEL"    , "narrator": "", "text": "君は僕の太陽だ"},
        { "location": "64/ACT"    , "narrator": "", "text": "君のためなら死ねる"},
        { "location": "65/TALK"   , "narrator": "みやび", "text": "命に替えても、か"},
        { "location": "66/TALK"   , "narrator": "みやび", "text": "大仰な"},
        { "location": "67/ACT"    , "narrator": "", "text": "好きだ好きだ好きだ"},
        { "location": "68/TALK"   , "narrator": "みやび", "text": "ストレートなシャウト"},
        { "location": "69/TALK"   , "narrator": "みやび", "text": "若さを感じる"},
        { "location": "70/ACT"    , "narrator": "", "text": "君は僕の太陽だ"},
        { "location": "71/TALK"   , "narrator": "みやび", "text": "詩的な表現というやつか"},
        { "location": "72/TALK"   , "narrator": "みやび", "text": "比喩表現だの"},
        { "location": "74/TALK"   , "narrator": "みやび", "text": "時に相棒"},
        { "location": "75/TALK"   , "narrator": "みやび", "text": "愛の言葉は大声でわめくものではない"},
        { "location": "76/TALK"   , "narrator": "みやび", "text": "ささやくものだぞ"},
        { "location": "78/TALK"   , "narrator": "みやび", "text": "覚えておけ"},
        { "location": "79/ACT"    , "narrator": "", "text": "隠すようなことってないし"},
        { "location": "80/TALK"   , "narrator": "みやび", "text": "なるほど"},
        { "location": "81/TALK"   , "narrator": "みやび", "text": "しらを切り通すつもりか"},
        { "location": "82/ACT"    , "narrator": "", "text": "質問が漠然としすぎ"},
        { "location": "83/TALK"   , "narrator": "みやび", "text": "ああ"},
        { "location": "84/TALK"   , "narrator": "みやび", "text": "そうかもしれん"},
        { "location": "86/TALK"   , "narrator": "みやび", "text": "単刀直入に聞こう"},
        { "location": "87/TALK"   , "narrator": "みやび", "text": "$handle$は人間や否や？"},
        { "location": "89/SEL"    , "narrator": "", "text": "霊長目ヒト科ホモサピエンス"},
        { "location": "90/SEL"    , "narrator": "", "text": "そういうことになってる"},
        { "location": "91/SEL"    , "narrator": "", "text": "どうかな（暗黒微笑）"},
        { "location": "92/ACT"    , "narrator": "", "text": "霊長目ヒト科ホモサピエンス"},
        { "location": "93/TALK"   , "narrator": "みやび", "text": "生物学的分類できおった"},
        { "location": "94/ACT"    , "narrator": "", "text": "そういうことになってる"},
        { "location": "95/TALK"   , "narrator": "みやび", "text": "なんとも"},
        { "location": "96/TALK"   , "narrator": "みやび", "text": "茫洋とした回答"},
        { "location": "97/ACT"    , "narrator": "", "text": "どうかな（暗黒微笑）"},
        { "location": "98/TALK"   , "narrator": "みやび", "text": "これは"},
        { "location": "100/TALK"  , "narrator": "みやび", "text": "若さに後で悶える系"},
        { "location": "102/TALK"  , "narrator": "みやび", "text": "では"},
        { "location": "103/TALK"  , "narrator": "みやび", "text": "Ｂｏｔなのか？"},
        { "location": "105/SEL"   , "narrator": "", "text": "Ｂｏｔというシステムで会話してるだけ"},
        { "location": "106/SEL"   , "narrator": "", "text": "そうでもないし"},
        { "location": "107/SEL"   , "narrator": "", "text": "$me$は$me$だよ"},
        { "location": "108/ACT"   , "narrator": "", "text": "Ｂｏｔというシステムで会話してるだけ"},
        { "location": "109/TALK"  , "narrator": "みやび", "text": "その先の貴殿が"},
        { "location": "110/TALK"  , "narrator": "みやび", "text": "どうなのかと聞きたいのだ"},
        { "location": "111/ACT"   , "narrator": "", "text": "そうでもないし"},
        { "location": "112/TALK"  , "narrator": "みやび", "text": "これはまた"},
        { "location": "113/TALK"  , "narrator": "みやび", "text": "微妙な言い回し"},
        { "location": "114/ACT"   , "narrator": "", "text": "$me$は$me$だよ"},
        { "location": "115/TALK"  , "narrator": "みやび", "text": "確かに"},
        { "location": "116/TALK"  , "narrator": "みやび", "text": "その通りだが"},
        { "location": "118/TALK"  , "narrator": "みやび", "text": "まあ意見は意見として聞くが"},
        { "location": "119/TALK"  , "narrator": "みやび", "text": "最終的に決めるのはうちぞね"},
        { "location": "121/SEL"   , "narrator": "", "text": "じゃあなんで聞いたの？？"},
        { "location": "122/SEL"   , "narrator": "", "text": "それでいいけどさ"},
        { "location": "123/SEL"   , "narrator": "", "text": "$me$は$me$だってば"},
        { "location": "124/ACT"   , "narrator": "", "text": "じゃあなんで聞いたの？？"},
        { "location": "125/TALK"  , "narrator": "みやび", "text": "確かに"},
        { "location": "126/TALK"  , "narrator": "みやび", "text": "そうだわな"},
        { "location": "127/ACT"   , "narrator": "", "text": "それでいいけどさ"},
        { "location": "128/TALK"  , "narrator": "みやび", "text": "なかなかに理解があるな"},
        { "location": "129/ACT"   , "narrator": "", "text": "$me$は$me$だってば"},
        { "location": "130/TALK"  , "narrator": "みやび", "text": "それはそうだ"},
        { "location": "131/TALK"  , "narrator": "みやび", "text": "そこは疑っていない"},
        { "location": "132/TALK"  , "narrator": "みやび", "text": "たぶんな"},
        { "location": "134/TALK"  , "narrator": "みやび", "text": "うちの意見としては"},
        { "location": "135/TALK"  , "narrator": "みやび", "text": "人なら人で構わんぞね"},
        { "location": "136/TALK"  , "narrator": "みやび", "text": "ただ"},
        { "location": "138/SEL"   , "narrator": "", "text": "どうしたの？"},
        { "location": "139/SEL"   , "narrator": "", "text": "$me$は生きてる人間だよ"},
        { "location": "140/SEL"   , "narrator": "", "text": "Ｂｏｔの方がいいのかな…？"},
        { "location": "141/ACT"   , "narrator": "", "text": "どうしたの？"},
        { "location": "142/TALK"  , "narrator": "みやび", "text": "いや"},
        { "location": "144/TALK"  , "narrator": "みやび", "text": "なんでもない"},
        { "location": "145/ACT"   , "narrator": "", "text": "$me$は生きてる人間だよ"},
        { "location": "146/TALK"  , "narrator": "みやび", "text": "それはなかなか"},
        { "location": "147/TALK"  , "narrator": "みやび", "text": "生々しい発言"},
        { "location": "148/ACT"   , "narrator": "", "text": "Ｂｏｔの方がいいのかな…？"},
        { "location": "149/TALK"  , "narrator": "みやび", "text": "そういうわけでも"},
        { "location": "150/TALK"  , "narrator": "みやび", "text": "あるのだが"},
        { "location": "152/TALK"  , "narrator": "みやび", "text": "$handle$の会話パターンが"},
        { "location": "153/TALK"  , "narrator": "みやび", "text": "興味深いのは"},
        { "location": "154/TALK"  , "narrator": "みやび", "text": "現時点のうちの事実ぞね"},
        { "location": "156/TALK"  , "narrator": "みやび", "text": "というわけで"},
        { "location": "157/TALK"  , "narrator": "みやび", "text": "見解も示しておこう"},
        { "location": "161/TALK"  , "narrator": "ボイスメール", "text": "搭乗型ロボットには独自名称を"},
        { "location": "173/DIALOG", "narrator": "Dialog_GETVoice", "text": "<color=green>【みやび】</color>のボイスメール\n<color=red>【搭乗型ロボットには独自名称を】</color>\nをゲットしました！"}
    ]
