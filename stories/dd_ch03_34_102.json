        "title": "005 メインストーリー",
        "sub_title": "人の子として、私は＜後編＞"
    },
    "entry":
    [
        { "location": "454/SCENARIO", "narrator": "", "text": "人の子として、あたしは"},
        { "location": "469/TALK"    , "narrator": "ガブリエラ", "text": "やだ……。"},
        { "location": "471/TALK"    , "narrator": "ガブリエラ", "text": "みんな待ってよ…。"},
        { "location": "475/SEL"     , "narrator": "", "text": "ガブリエラ"},
        { "location": "476/ACT"     , "narrator": "", "text": "ガブリエラ"},
        { "location": "479/TALK"    , "narrator": "ガブリエラ", "text": "！！！！！"},
        { "location": "493/TALK"    , "narrator": "ガブリエラ", "text": "もう"},
        { "location": "494/TALK"    , "narrator": "ガブリエラ", "text": "どこにいたの"},
        { "location": "496/SEL"     , "narrator": "", "text": "悪い悪い"},
        { "location": "497/SEL"     , "narrator": "", "text": "色々片付けてて"},
        { "location": "498/SEL"     , "narrator": "", "text": "もう大丈夫だと思う"},
        { "location": "499/ACT"     , "narrator": "", "text": "悪い悪い"},
        { "location": "500/TALK"    , "narrator": "ガブリエラ", "text": "ほんとよ"},
        { "location": "501/ACT"     , "narrator": "", "text": "色々片付けてて"},
        { "location": "502/TALK"    , "narrator": "ガブリエラ", "text": "遅いのよ"},
        { "location": "503/ACT"     , "narrator": "", "text": "もう大丈夫だと思う"},
        { "location": "504/TALK"    , "narrator": "ガブリエラ", "text": "絶対よ"},
        { "location": "506/TALK"    , "narrator": "ガブリエラ", "text": "$marzanna$が"},
        { "location": "507/TALK"    , "narrator": "ガブリエラ", "text": "いない間に"},
        { "location": "508/TALK"    , "narrator": "ガブリエラ", "text": "つばめと神楽が"},
        { "location": "509/TALK"    , "narrator": "ガブリエラ", "text": "大変なの"},
        { "location": "511/SEL"     , "narrator": "", "text": "みたいだね"},
        { "location": "512/SEL"     , "narrator": "", "text": "大丈夫、落ち着いて"},
        { "location": "513/SEL"     , "narrator": "", "text": "ガブリエラならできる"},
        { "location": "514/ACT"     , "narrator": "", "text": "みたいだね"},
        { "location": "515/TALK"    , "narrator": "ガブリエラ", "text": "ありえないの"},
        { "location": "516/TALK"    , "narrator": "ガブリエラ", "text": "わかってくれてる？"},
        { "location": "517/ACT"     , "narrator": "", "text": "大丈夫、落ち着いて"},
        { "location": "518/TALK"    , "narrator": "ガブリエラ", "text": "そんな"},
        { "location": "519/TALK"    , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "520/TALK"    , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "521/ACT"     , "narrator": "", "text": "ガブリエラならできる"},
        { "location": "522/TALK"    , "narrator": "ガブリエラ", "text": "うそよ"},
        { "location": "523/TALK"    , "narrator": "ガブリエラ", "text": "そんなの"},
        { "location": "525/TALK"    , "narrator": "ガブリエラ", "text": "みんないなくなるの"},
        { "location": "526/TALK"    , "narrator": "ガブリエラ", "text": "変わってしまうの"},
        { "location": "528/SEL"     , "narrator": "", "text": "元に戻してあげようよ"},
        { "location": "529/SEL"     , "narrator": "", "text": "救えるのはガブリエラだよ"},
        { "location": "530/SEL"     , "narrator": "", "text": "解決策を考えよう"},
        { "location": "531/ACT"     , "narrator": "", "text": "元に戻してあげようよ"},
        { "location": "532/TALK"    , "narrator": "ガブリエラ", "text": "できるなら"},
        { "location": "533/TALK"    , "narrator": "ガブリエラ", "text": "一番いいわ"},
        { "location": "534/ACT"     , "narrator": "", "text": "救えるのはガブリエラだよ"},
        { "location": "535/TALK"    , "narrator": "ガブリエラ", "text": "私が"},
        { "location": "536/TALK"    , "narrator": "ガブリエラ", "text": "救えるの？"},
        { "location": "537/ACT"     , "narrator": "", "text": "解決策を考えよう"},
        { "location": "538/TALK"    , "narrator": "ガブリエラ", "text": "これから"},
        { "location": "539/TALK"    , "narrator": "ガブリエラ", "text": "どうにかできると思う？"},
        { "location": "541/TALK"    , "narrator": "ガブリエラ", "text": "$marzanna$は"},
        { "location": "542/TALK"    , "narrator": "ガブリエラ", "text": "私が変わらないで"},
        { "location": "543/TALK"    , "narrator": "ガブリエラ", "text": "いられると思ってるの？"},
        { "location": "545/SEL"     , "narrator": "", "text": "当然"},
        { "location": "546/SEL"     , "narrator": "", "text": "いい方に変わると思う"},
        { "location": "547/SEL"     , "narrator": "", "text": "だって$me$のお姫さまだから"},
        { "location": "548/ACT"     , "narrator": "", "text": "当然"},
        { "location": "549/TALK"    , "narrator": "ガブリエラ", "text": "すごい自信ね"},
        { "location": "550/TALK"    , "narrator": "ガブリエラ", "text": "それとも信頼"},
        { "location": "551/TALK"    , "narrator": "ガブリエラ", "text": "わかったわ"},
        { "location": "553/TALK"    , "narrator": "ガブリエラ", "text": "その言葉を信じる"},
        { "location": "554/ACT"     , "narrator": "", "text": "いい方に変わると思う"},
        { "location": "555/TALK"    , "narrator": "ガブリエラ", "text": "前向きなのね"},
        { "location": "556/TALK"    , "narrator": "ガブリエラ", "text": "$marzanna$は"},
        { "location": "557/TALK"    , "narrator": "ガブリエラ", "text": "でもそうね"},
        { "location": "558/TALK"    , "narrator": "ガブリエラ", "text": "そう思うしかないわよね"},
        { "location": "559/ACT"     , "narrator": "", "text": "だって$me$のお姫さまだから"},
        { "location": "560/TALK"    , "narrator": "ガブリエラ", "text": "そういう風に"},
        { "location": "561/TALK"    , "narrator": "ガブリエラ", "text": "言ってくれるのは"},
        { "location": "562/TALK"    , "narrator": "ガブリエラ", "text": "$marzanna$だけよ//////"},
        { "location": "563/TALK"    , "narrator": "ガブリエラ", "text": "ありがとう"},
        { "location": "564/TALK"    , "narrator": "ガブリエラ", "text": "大好きよｖ"},
        { "location": "577/TALK"    , "narrator": "ガブリエラ", "text": "…そうね。\n$marzanna$の言う通り。"},
        { "location": "578/TALK"    , "narrator": "ガブリエラ", "text": "あたしがしっかり\nしなきゃダメ。"},
        { "location": "579/TALK"    , "narrator": "ガブリエラ", "text": "すぐ弱気になるのは\nよくない癖だわ。"},
        { "location": "580/TALK"    , "narrator": "ガブリエラ", "text": "気付かせてくれて\nありがとう…。"},
        { "location": "474/DIALOG"  , "narrator": "Dialog_InfoOS", "text": "\n<color=red>\nApp::WAVE\nactivation succeed!!\n</color>\nライセンスの更新\nありがとうございました。\n素敵なWAVEライフを！\n"},
        { "location": "591/DIALOG"  , "narrator": "Dialog_chapter_ch03", "text": "【28 時計じかけのイチゴ】"}
    ]
}
