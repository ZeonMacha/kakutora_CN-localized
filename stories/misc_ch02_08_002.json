    "entry":
    [
        { "location": "160/SCENARIO", "narrator": "", "text": "008_ゆめみるヒヨコ"},
        { "location": "186/TALK"    , "narrator": "アーヤ", "text": "正しく夢を見ないといけないと思うのよ"},
        { "location": "187/TALK"    , "narrator": "アーヤ", "text": "正しくね"},
        { "location": "189/SEL"     , "narrator": "", "text": "そうだよね"},
        { "location": "190/SEL"     , "narrator": "", "text": "優等生だな"},
        { "location": "191/SEL"     , "narrator": "", "text": "アーヤらしいね"},
        { "location": "192/TALK"    , "narrator": "アーヤ", "text": "そうしないと"},
        { "location": "193/TALK"    , "narrator": "アーヤ", "text": "フェノメノンになったりして大変"},
        { "location": "196/TALK"    , "narrator": "アーヤ", "text": "だから"},
        { "location": "197/TALK"    , "narrator": "アーヤ", "text": "ちゃんとしなきゃね"},
        { "location": "200/TALK"    , "narrator": "アーヤ", "text": "よし"},
        { "location": "201/TALK"    , "narrator": "アーヤ", "text": "がんばろっと"},
        { "location": "209/ACT"     , "narrator": "", "text": "そうだよね"},
        { "location": "210/TALK"    , "narrator": "アーヤ", "text": "そうよね"},
        { "location": "211/ACT"     , "narrator": "", "text": "優等生だな"},
        { "location": "212/TALK"    , "narrator": "アーヤ", "text": "何それ（｀皿´ )"},
        { "location": "214/TALK"    , "narrator": "アーヤ", "text": "ちょっと"},
        { "location": "215/TALK"    , "narrator": "アーヤ", "text": "漢字わるーい"},
        { "location": "216/TALK"    , "narrator": "アーヤ", "text": "感じ！"},
        { "location": "217/ACT"     , "narrator": "", "text": "アーヤらしいね"},
        { "location": "218/TALK"    , "narrator": "アーヤ", "text": "そう？"},
        { "location": "220/TALK"    , "narrator": "アーヤ", "text": "まあ"},
        { "location": "221/TALK"    , "narrator": "アーヤ", "text": "そうかもしれない"},
        { "location": "224/TALK"    , "narrator": "アーヤ", "text": "なんかね。。。"},
        { "location": "225/TALK"    , "narrator": "アーヤ", "text": "クランもね"},
        { "location": "226/TALK"    , "narrator": "アーヤ", "text": "最初は変なこと考えてたわけじゃないと思うのよ"},
        { "location": "227/TALK"    , "narrator": "アーヤ", "text": "それが"},
        { "location": "228/TALK"    , "narrator": "アーヤ", "text": "妄想って言うかこじらせていってフェノメノンになったんだろうなって"},
        { "location": "230/SEL"     , "narrator": "", "text": "なるほど"},
        { "location": "231/SEL"     , "narrator": "", "text": "アーヤはその兆候はないの？"},
        { "location": "232/ACT"     , "narrator": "", "text": "なるほど"},
        { "location": "233/TALK"    , "narrator": "アーヤ", "text": "ねえ？"},
        { "location": "235/TALK"    , "narrator": "アーヤ", "text": "だって今はいい子たちだもの"},
        { "location": "236/ACT"     , "narrator": "", "text": "アーヤはその兆候はないの？"},
        { "location": "237/TALK"    , "narrator": "アーヤ", "text": "絶対ない！！！！！！！！！！！！！！！！！！！！！！！！！"},
        { "location": "241/TALK"    , "narrator": "アーヤ", "text": "って"},
        { "location": "242/TALK"    , "narrator": "アーヤ", "text": "言い切る人ほど怪しいのかもしれないわよね。。。"},
        { "location": "246/TALK"    , "narrator": "アーヤ", "text": "はあ。。。。(´o｀；"},
        { "location": "247/TALK"    , "narrator": "アーヤ", "text": "私がフェノメノンになったらどうする？"},
        { "location": "249/SEL"     , "narrator": "", "text": "倒す"},
        { "location": "250/SEL"     , "narrator": "", "text": "$me$がアーヤを元に戻す"},
        { "location": "251/SEL"     , "narrator": "", "text": "なるわけない"},
        { "location": "252/ACT"     , "narrator": "", "text": "倒す"},
        { "location": "253/TALK"    , "narrator": "アーヤ", "text": "工ｴｴｪｪ(´д｀)ｪｪｴｴ工"},
        { "location": "255/TALK"    , "narrator": "アーヤ", "text": "そこは"},
        { "location": "256/TALK"    , "narrator": "アーヤ", "text": "そうじゃないと思うし\n（ノ ﾟДﾟ）ノ　\n＝＝＝＝　┻━━┻ "},
        { "location": "258/TALK"    , "narrator": "アーヤ", "text": "ひどすぎ（｀皿´ )"},
        { "location": "259/ACT"     , "narrator": "", "text": "$me$がアーヤを元に戻す"},
        { "location": "261/TALK"    , "narrator": "アーヤ", "text": "やだ(*^^*)"},
        { "location": "263/TALK"    , "narrator": "アーヤ", "text": "なんか格好いい(*^.^*)"},
        { "location": "264/TALK"    , "narrator": "アーヤ", "text": "だったら"},
        { "location": "266/TALK"    , "narrator": "アーヤ", "text": "心配知ることもないわね"},
        { "location": "267/TALK"    , "narrator": "アーヤ", "text": "することも(*^.^*)"},
        { "location": "268/TALK"    , "narrator": "アーヤ", "text": "頼りにしてるわね(^ε^)-☆!!"},
        { "location": "269/ACT"     , "narrator": "", "text": "なるわけない"},
        { "location": "270/TALK"    , "narrator": "アーヤ", "text": "そうよね"},
        { "location": "272/TALK"    , "narrator": "アーヤ", "text": "うん"},
        { "location": "273/TALK"    , "narrator": "アーヤ", "text": "考えすぎだった"}
    ]
}
