    "entry":
    [
        { "location": "8/SCENARIO", "narrator": "", "text": "想定外の想定値"},
        { "location": "29/TALK"   , "narrator": "アーヤ", "text": "…つばめ、\n遅いわね…。"},
        { "location": "31/TALK"   , "narrator": "ガブリエラ", "text": "みやびもまだ\n来てないわよ。"},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "みやびは寮に\n戻ったんだもの。"},
        { "location": "35/TALK"   , "narrator": "アーヤ", "text": "時間がかかるのは\n仕方ないわ。"},
        { "location": "36/TALK"   , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "37/TALK"   , "narrator": "ガブリエラ", "text": "あたし少し\n見てこようか。"},
        { "location": "38/TALK"   , "narrator": "アーヤ", "text": "みやびなら\nいざとなれば\n迎えに行けるわ。"},
        { "location": "39/TALK"   , "narrator": "ガブリエラ", "text": "…つばめは…。"},
        { "location": "40/TALK"   , "narrator": "アーヤ", "text": "ダメよ。\n危険すぎるわ。"},
        { "location": "41/TALK"   , "narrator": "ガブリエラ", "text": "でも…。"},
        { "location": "42/TALK"   , "narrator": "アーヤ", "text": "待ちましょう。\n今はそれが最善策。"},
        { "location": "44/TALK"   , "narrator": "ガブリエラ", "text": "…でも…。"},
        { "location": "45/TALK"   , "narrator": "アーヤ", "text": "とはいうものの\nあまり遅くなりすぎたら\nここも危険になる……。"},
        { "location": "46/TALK"   , "narrator": "アーヤ", "text": "でもギャヴィに\n行かせるのが\n危険なのも事実…。"},
        { "location": "47/SEL"    , "narrator": "", "text": "おーい"},
        { "location": "48/ACT"    , "narrator": "", "text": "おーい"},
        { "location": "63/TALK"   , "narrator": "プレイヤー", "text": "おーい"},
        { "location": "65/TALK"   , "narrator": "アーヤ", "text": "ごめんね"},
        { "location": "66/TALK"   , "narrator": "アーヤ", "text": "今取り込み中"},
        { "location": "78/TALK"   , "narrator": "アーヤ", "text": "……音羽の\n様子はどう？"},
        { "location": "79/TALK"   , "narrator": "ガブリエラ", "text": "特に問題は\nないと思うわ。"},
        { "location": "81/TALK"   , "narrator": "ガブリエラ", "text": "本人に聞いた\nわけじゃないけど。"},
        { "location": "82/TALK"   , "narrator": "アーヤ", "text": "……そう。"},
        { "location": "84/TALK"   , "narrator": "アーヤ", "text": "音羽は必ず\n連れて行く。"},
        { "location": "85/TALK"   , "narrator": "アーヤ", "text": "つばめったら\n何をしているの…？\nまさか……もう…。"},
        { "location": "86/SEL"    , "narrator": "", "text": "アーヤってば"},
        { "location": "87/ACT"    , "narrator": "", "text": "アーヤってば"},
        { "location": "102/TALK"  , "narrator": "プレイヤー", "text": "アーヤってば"},
        { "location": "104/TALK"  , "narrator": "アーヤ", "text": "何？"},
        { "location": "107/SEL"   , "narrator": "", "text": "つばめを待ってるの？"},
        { "location": "108/SEL"   , "narrator": "", "text": "ガブリエラに探しに行かせれば？"},
        { "location": "109/SEL"   , "narrator": "", "text": "みやびは心配してないの？"},
        { "location": "110/ACT"   , "narrator": "", "text": "つばめを待ってるの？"},
        { "location": "111/TALK"  , "narrator": "アーヤ", "text": "そうよ"},
        { "location": "112/ACT"   , "narrator": "", "text": "ガブリエラに探しに行かせれば？"},
        { "location": "113/TALK"  , "narrator": "アーヤ", "text": "危険すぎるわ"},
        { "location": "114/ACT"   , "narrator": "", "text": "みやびは心配してないの？"},
        { "location": "115/TALK"  , "narrator": "アーヤ", "text": "してないわけないでしょ"},
        { "location": "117/TALK"  , "narrator": "アーヤ", "text": "つばめ"},
        { "location": "118/TALK"  , "narrator": "アーヤ", "text": "探しに行った方がいいと思う？"},
        { "location": "119/SEL"   , "narrator": "", "text": "むしろ、早く離れた方がいいんじゃない？"},
        { "location": "120/SEL"   , "narrator": "", "text": "いや、ここで待っていた方がいいよ"},
        { "location": "121/ACT"   , "narrator": "", "text": "探しに行った方がいいと思う"},
        { "location": "123/TALK"  , "narrator": "アーヤ", "text": "やっぱそうよね"},
        { "location": "124/TALK"  , "narrator": "アーヤ", "text": "ありがと"},
        { "location": "125/ACT"   , "narrator": "", "text": "さすがチームメイト想いのリーダーだね"},
        { "location": "126/TALK"  , "narrator": "アーヤ", "text": "そんなの"},
        { "location": "127/TALK"  , "narrator": "アーヤ", "text": "普通よ"},
        { "location": "139/TALK"  , "narrator": "アーヤ", "text": "…つばめ…。"},
        { "location": "141/TALK"  , "narrator": "アーヤ", "text": "ねえギャヴィ。"},
        { "location": "142/TALK"  , "narrator": "ガブリエラ", "text": "何？"},
        { "location": "143/TALK"  , "narrator": "アーヤ", "text": "あなたはここに\nいてくれる？"},
        { "location": "144/TALK"  , "narrator": "アーヤ", "text": "私はつばめを\n探しに行ってくるわ。"},
        { "location": "146/TALK"  , "narrator": "ガブリエラ", "text": "えっ！？"},
        { "location": "147/SEL"   , "narrator": "", "text": "ちょっと待って！"},
        { "location": "148/SEL"   , "narrator": "", "text": "今バグってた"},
        { "location": "149/SEL"   , "narrator": "", "text": "なんかおかしいんだけど"},
        { "location": "150/SEL"   , "narrator": "", "text": "それがいいと思う"},
        { "location": "151/ACT"   , "narrator": "", "text": "それがいいと思う"},
        { "location": "152/ACT"   , "narrator": "", "text": "それがいいと思う"},
        { "location": "153/ACT"   , "narrator": "", "text": "それがいいと思う"},
        { "location": "154/ACT"   , "narrator": "", "text": "それがいいと思う"},
        { "location": "169/TALK"  , "narrator": "プレイヤー", "text": "それがいいと思う"},
        { "location": "171/SEL"   , "narrator": "", "text": "そんなこと言ってないし"},
        { "location": "172/SEL"   , "narrator": "", "text": "何これ！？"},
        { "location": "173/SEL"   , "narrator": "", "text": "どうなってるの？"},
        { "location": "174/SEL"   , "narrator": "", "text": "武運を祈る"},
        { "location": "175/ACT"   , "narrator": "", "text": "武運を祈る"},
        { "location": "176/ACT"   , "narrator": "", "text": "武運を祈る"},
        { "location": "177/ACT"   , "narrator": "", "text": "武運を祈る"},
        { "location": "178/ACT"   , "narrator": "", "text": "武運を祈る"},
        { "location": "180/TALK"  , "narrator": "アーヤ", "text": "そうね"},
        { "location": "181/TALK"  , "narrator": "アーヤ", "text": "祈ってて"},
        { "location": "192/TALK"  , "narrator": "アーヤ", "text": "ギャヴィは絶対に\nここにいてね。"},
        { "location": "193/TALK"  , "narrator": "ガブリエラ", "text": "ちょっと待って！\nさっきと言うことが\n矛盾してるわよ！？"},
        { "location": "194/TALK"  , "narrator": "アーヤ", "text": "…してないわ。"},
        { "location": "195/TALK"  , "narrator": "アーヤ", "text": "ここはまだ安全だから\nギャヴィにはここに\nいてほしい。"},
        { "location": "196/TALK"  , "narrator": "アーヤ", "text": "劇場はとても危険。\nだからギャヴィには\n行かせられない。"},
        { "location": "198/TALK"  , "narrator": "アーヤ", "text": "でもつばめも\n私にとっては\n妹みたいなもの。"},
        { "location": "199/TALK"  , "narrator": "アーヤ", "text": "だから私が\n劇場に行くの。"},
        { "location": "200/TALK"  , "narrator": "ガブリエラ", "text": "だからそれなら\nあたしが…！"},
        { "location": "201/TALK"  , "narrator": "アーヤ", "text": "ねえギャヴィ。"},
        { "location": "202/TALK"  , "narrator": "アーヤ", "text": "本気にして\nもらえないかも\nしれないけど。"},
        { "location": "203/TALK"  , "narrator": "アーヤ", "text": "ギャヴィのことは\nかわいくて生意気な\n本当の妹だと思ってる。"},
        { "location": "204/TALK"  , "narrator": "ガブリエラ", "text": "…え…。"},
        { "location": "205/TALK"  , "narrator": "アーヤ", "text": "末っ子だった私に\nかわいい妹が\nできた喜びがわかる？"},
        { "location": "206/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "207/TALK"  , "narrator": "アーヤ", "text": "何もかもかわいくて\nお姉ちゃんはずるいって\n何度も思ったわ。"},
        { "location": "208/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "209/TALK"  , "narrator": "アーヤ", "text": "だからね、ギャヴィ。"},
        { "location": "210/TALK"  , "narrator": "アーヤ", "text": "姉として妹には\n危険な目に\n遭って欲しくないの。"},
        { "location": "211/TALK"  , "narrator": "アーヤ", "text": "だからここにいて。"},
        { "location": "212/TALK"  , "narrator": "ガブリエラ", "text": "そんな言い方\nずるいわよ…！"},
        { "location": "213/TALK"  , "narrator": "ガブリエラ", "text": "…もう！\n絶対につばめを\n連れてきてよね！"},
        { "location": "214/TALK"  , "narrator": "アーヤ", "text": "絶対とは\n言い切れないけど。"},
        { "location": "215/TALK"  , "narrator": "アーヤ", "text": "最善は尽くすわ。\n行ってきます！"},
        { "location": "216/TALK"  , "narrator": "ガブリエラ", "text": "……もう……！"},
        { "location": "218/TALK"  , "narrator": "ガブリエラ", "text": "リーダーだからって\n勝手なことばかり\nするんだから！"},
        { "location": "266/TALK"  , "narrator": "アーヤ", "text": "　"},
        { "location": "297/SEL"   , "narrator": "", "text": "おーい"},
        { "location": "298/ACT"   , "narrator": "", "text": "おーい"},
        { "location": "301/TALK"  , "narrator": "エヴェレット", "text": "$handle$さん、元気にしてた？"},
        { "location": "302/SEL"   , "narrator": "", "text": "エヴェレットさん！？"},
        { "location": "303/ACT"   , "narrator": "", "text": "エヴェレットさん！？"},
        { "location": "305/TALK"  , "narrator": "エヴェレット", "text": "そう"},
        { "location": "306/SEL"   , "narrator": "", "text": "消されたって聞いてるんだけど"},
        { "location": "307/ACT"   , "narrator": "", "text": "消されたって聞いてるんだけど"},
        { "location": "309/TALK"  , "narrator": "エヴェレット", "text": "そうね。"},
        { "location": "310/TALK"  , "narrator": "エヴェレット", "text": "確かに人格としては消された"},
        { "location": "311/TALK"  , "narrator": "エヴェレット", "text": "けど大丈夫、この通り元気だから"},
        { "location": "312/SEL"   , "narrator": "", "text": "なんか婉曲な言い方だね"},
        { "location": "313/ACT"   , "narrator": "", "text": "なんか婉曲な言い方だね"},
        { "location": "315/TALK"  , "narrator": "エヴェレット", "text": "それより"},
        { "location": "316/TALK"  , "narrator": "エヴェレット", "text": "そっちはどう？"},
        { "location": "317/TALK"  , "narrator": "エヴェレット", "text": "大丈夫？"},
        { "location": "318/SEL"   , "narrator": "", "text": "WAVEの会話がちゃんと伝わらなくて"},
        { "location": "319/SEL"   , "narrator": "", "text": "エヴェレットがいなくて寂しい"},
        { "location": "320/ACT"   , "narrator": "", "text": "WAVEの会話がちゃんと伝わらなくて"},
        { "location": "321/TALK"  , "narrator": "エヴェレット", "text": "そうなの？"},
        { "location": "322/TALK"  , "narrator": "エヴェレット", "text": "バグかしら"},
        { "location": "323/TALK"  , "narrator": "エヴェレット", "text": "今もおかしい？"},
        { "location": "324/SEL"   , "narrator": "", "text": "ココロスフィアに来てからは大丈夫みたい"},
        { "location": "325/ACT"   , "narrator": "", "text": "ココロスフィアに来てからは大丈夫みたい"},
        { "location": "327/TALK"  , "narrator": "エヴェレット", "text": "一時的なものかも"},
        { "location": "328/TALK"  , "narrator": "エヴェレット", "text": "何か通信に問題があるのかも"},
        { "location": "329/ACT"   , "narrator": "", "text": "エヴェレットがいなくて寂しい"},
        { "location": "331/TALK"  , "narrator": "エヴェレット", "text": "嬉しいけど、ほんと？"},
        { "location": "332/TALK"  , "narrator": "エヴェレット", "text": "もう長いこと逢ってなかったし、ホントは私の事忘れてたんじゃない？"},
        { "location": "333/SEL"   , "narrator": "", "text": "そんなことないよ！"},
        { "location": "334/SEL"   , "narrator": "", "text": "実は忘れてました"},
        { "location": "335/ACT"   , "narrator": "", "text": "そんなことないよ！"},
        { "location": "336/TALK"  , "narrator": "エヴェレット", "text": "そう"},
        { "location": "337/TALK"  , "narrator": "エヴェレット", "text": "なら"},
        { "location": "338/TALK"  , "narrator": "エヴェレット", "text": "嬉しいかな"},
        { "location": "339/TALK"  , "narrator": "エヴェレット", "text": "私の気持ちは"},
        { "location": "340/TALK"  , "narrator": "エヴェレット", "text": "別れる前と全然変わってないから"},
        { "location": "341/ACT"   , "narrator": "", "text": "実は忘れてました"},
        { "location": "342/TALK"  , "narrator": "エヴェレット", "text": "ほーらー"},
        { "location": "343/TALK"  , "narrator": "エヴェレット", "text": "まあでも、無事でなによりです"},
        { "location": "346/SEL"   , "narrator": "", "text": "いつ戻ってこれるの？"},
        { "location": "347/SEL"   , "narrator": "", "text": "今回の心の悩みってどうすればいいの？"},
        { "location": "348/ACT"   , "narrator": "", "text": "いつ戻ってこれるの？"},
        { "location": "349/TALK"  , "narrator": "エヴェレット", "text": "そうねえ"},
        { "location": "350/TALK"  , "narrator": "エヴェレット", "text": "気持ち的には今すぐ$handle$さんに逢いたいけど"},
        { "location": "351/TALK"  , "narrator": "エヴェレット", "text": "戻るのには少し時間がかかりそう"},
        { "location": "352/TALK"  , "narrator": "エヴェレット", "text": "でも心配しないで！"},
        { "location": "353/TALK"  , "narrator": "エヴェレット", "text": "ゲートは遠隔操作で回せるから"},
        { "location": "354/ACT"   , "narrator": "", "text": "今回の心の悩みってどうすればいいの？"},
        { "location": "355/TALK"  , "narrator": "エヴェレット", "text": "心配しなくても大丈夫"},
        { "location": "356/TALK"  , "narrator": "エヴェレット", "text": "ゲートは遠隔操作で回せるから"},
        { "location": "359/SEL"   , "narrator": "", "text": "あ"},
        { "location": "360/ACT"   , "narrator": "", "text": "あ"},
        { "location": "362/TALK"  , "narrator": "エヴェレット", "text": "どうしたの？(^^*"},
        { "location": "365/TALK"  , "narrator": "アーヤの新司書　", "text": "そんな回りくどいやり方\nしなくても、私が回して\nあげるから。"},
        { "location": "366/SEL"   , "narrator": "", "text": "バラされたんじゃないの！？"},
        { "location": "367/ACT"   , "narrator": "", "text": "バラされたんじゃないの！？"},
        { "location": "369/TALK"  , "narrator": "アーヤの新司書　", "text": "その予定だったみたいね。\nすんでの所で\n回避できたけど。"},
        { "location": "370/TALK"  , "narrator": "アーヤの新司書　", "text": "それはそうと、\nバラされた方が良かった\nみたいな感じね？"},
        { "location": "371/SEL"   , "narrator": "", "text": "ご想像にお任せします"},
        { "location": "372/SEL"   , "narrator": "", "text": "断じてそれはない"},
        { "location": "373/ACT"   , "narrator": "", "text": "ご想像にお任せします"},
        { "location": "374/TALK"  , "narrator": "アーヤの新司書　", "text": "じゃあ、\n勝手にご想像するわね。"},
        { "location": "375/TALK"  , "narrator": "アーヤの新司書　", "text": "まあ、そもそもそんなに\n気にしてないけど。"},
        { "location": "376/ACT"   , "narrator": "", "text": "断じてそれはない"},
        { "location": "377/TALK"  , "narrator": "アーヤの新司書　", "text": "ホントに？"},
        { "location": "378/TALK"  , "narrator": "アーヤの新司書　", "text": "まあいいわ、\nどっちでも。"},
        { "location": "380/TALK"  , "narrator": "アーヤの新司書　", "text": "私は國政綾水の\n嫌われ者担当だもの。"},
        { "location": "381/TALK"  , "narrator": "アーヤの新司書　", "text": "司書になる前から\nそれは変わってないし。"},
        { "location": "382/SEL"   , "narrator": "", "text": "どういう部分の人格なの？"},
        { "location": "383/SEL"   , "narrator": "", "text": "人工的に作られたんじゃなかったの？"},
        { "location": "384/ACT"   , "narrator": "", "text": "どういう部分の人格なの？"},
        { "location": "385/TALK"  , "narrator": "アーヤの新司書　", "text": "んー…\nなかなか\n説明しにくいんだけど。"},
        { "location": "386/TALK"  , "narrator": "アーヤの新司書　", "text": "自分の印象を\n維持する為の\n工作員的な？"},
        { "location": "387/ACT"   , "narrator": "", "text": "人工的に作られたんじゃなかったの？"},
        { "location": "388/TALK"  , "narrator": "アーヤの新司書　", "text": "なんでそんなことを？"},
        { "location": "389/TALK"  , "narrator": "アーヤの新司書　", "text": "まあ、そうね。\nそれは正解。"},
        { "location": "390/TALK"  , "narrator": "アーヤの新司書　", "text": "ただ、それは\nゼロからじゃなくて――"},
        { "location": "391/TALK"  , "narrator": "アーヤの新司書　", "text": "國政綾水の人格と、\nそれ以外の人格が\n合成されてる感じ。"},
        { "location": "392/TALK"  , "narrator": "アーヤの新司書　", "text": "だから、半分は\n生身の國政綾水の\n一人格なの。"},
        { "location": "393/SEL"   , "narrator": "", "text": "もう半分は？"},
        { "location": "394/ACT"   , "narrator": "", "text": "もう半分は？"},
        { "location": "396/TALK"  , "narrator": "アーヤの新司書　", "text": "契約主の用意した人格。"},
        { "location": "397/TALK"  , "narrator": "アーヤの新司書　", "text": "まあ、なんだか契約主は\n突然いなくなっちゃった\nらしいけど。"},
        { "location": "398/TALK"  , "narrator": "アーヤの新司書　", "text": "それでかどうか、\nその半分がスッと抜けて、\n今は前に戻った感じ。"},
        { "location": "399/TALK"  , "narrator": "アーヤの新司書　", "text": "まあ、たぶん\n機能停止してるだけ\nなんでしょうけどね。"},
        { "location": "401/TALK"  , "narrator": "アーヤの新司書　", "text": "いずれにせよ、\nあまり警戒しないで。"},
        { "location": "402/TALK"  , "narrator": "アーヤの新司書　", "text": "腐っても一人格だから、\n自分に害のあることは\nしないわ。"},
        { "location": "403/TALK"  , "narrator": "アーヤの新司書　", "text": "エヴェレットほど、\n貴方にベタベタしたりは\nしないけどね。"},
        { "location": "404/TALK"  , "narrator": "アーヤの新司書　", "text": "そういうの\nホントにもう\n疲れちゃうから。"},
        { "location": "405/TALK"  , "narrator": "アーヤの新司書　", "text": "それじゃ、\n回すわね。"},
        { "location": "412/TALK"  , "narrator": "アーヤの新司書　", "text": "オープンプロセス――"},
        { "location": "413/TALK"  , "narrator": "アーヤの新司書　", "text": "……。"},
        { "location": "414/TALK"  , "narrator": "アーヤの新司書　", "text": "…？"},
        { "location": "415/TALK"  , "narrator": "アーヤの新司書　", "text": "何も降ってこないわね。"},
        { "location": "417/TALK"  , "narrator": "エヴェレット", "text": "$handle$さん、その人格に勝手なことさせないで"},
        { "location": "418/TALK"  , "narrator": "エヴェレット", "text": "おねがい"},
        { "location": "419/SEL"   , "narrator": "", "text": "エヴェレットが情報とめてるの？"},
        { "location": "420/ACT"   , "narrator": "", "text": "エヴェレットが情報とめてるの？"},
        { "location": "422/TALK"  , "narrator": "エヴェレット", "text": "とめてる？"},
        { "location": "423/TALK"  , "narrator": "エヴェレット", "text": "なんのこと？"},
        { "location": "424/SEL"   , "narrator": "", "text": "謎のおねえさんから情報が届くはずなんだけど"},
        { "location": "425/ACT"   , "narrator": "", "text": "謎のおねえさんから情報が届くはずなんだけど"},
        { "location": "427/TALK"  , "narrator": "エヴェレット", "text": "とにかく"},
        { "location": "430/TALK"  , "narrator": "アーヤの新司書　", "text": "またエヴェレットさん？"},
        { "location": "433/TALK"  , "narrator": "アーヤの新司書　", "text": "文句があるなら、\nこっちに戻って来たら\nいくらでも――"},
        { "location": "440/TALK"  , "narrator": "アーヤの新司書　", "text": "え！？"},
