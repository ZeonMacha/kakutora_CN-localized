        "title": "001 アニメーション",
        "sub_title": "赤色の髪のツバメ"
    },
    "entry":
    [
        { "location": "452/SCENARIO", "narrator": "", "text": "アニメ第08話"},
        { "location": "464/TALK"    , "narrator": "赤髪千羽鶴", "text": "こんにちは、\n$handle$さん。"},
        { "location": "465/TALK"    , "narrator": "赤髪千羽鶴", "text": "もう一度わたしと話を\nしていきますか？"},
        { "location": "466/SEL"     , "narrator": "", "text": "はい"},
        { "location": "467/SEL"     , "narrator": "", "text": "いいえ"},
        { "location": "468/ACT"     , "narrator": "", "text": "はい"},
        { "location": "469/TALK"    , "narrator": "赤髪千羽鶴", "text": "わかりました。\nそれでは……。"},
        { "location": "471/ACT"     , "narrator": "", "text": "いいえ"},
        { "location": "472/TALK"    , "narrator": "赤髪千羽鶴", "text": "わかりました。\nそれではこれで。"},
        { "location": "478/TALK"    , "narrator": "赤髪千羽鶴", "text": "こんにちは！\n$handle$さん！"},
        { "location": "479/TALK"    , "narrator": "赤髪千羽鶴", "text": "いきなりで\nアレですけど――"},
        { "location": "480/SEL"     , "narrator": "", "text": "なんでしょう？"},
        { "location": "481/SEL"     , "narrator": "", "text": "結婚してくれ？\nもちろんいいよ！"},
        { "location": "482/ACT"     , "narrator": "", "text": "なんでしょう？"},
        { "location": "484/ACT"     , "narrator": "", "text": "結婚してくれ？\nもちろんいいよ！"},
        { "location": "488/TALK"    , "narrator": "赤髪千羽鶴", "text": "<size=35>どーん！</size>"},
        { "location": "489/TALK"    , "narrator": "赤髪千羽鶴", "text": "意味が分かりません。"},
        { "location": "490/TALK"    , "narrator": "赤髪千羽鶴", "text": "といいますか。"},
        { "location": "491/TALK"    , "narrator": "赤髪千羽鶴", "text": "どうして私と結婚したい\nという気持ちになるのか、\n全然わかりません。"},
        { "location": "492/TALK"    , "narrator": "赤髪千羽鶴", "text": "私たちはまだ、出逢って\n数エピソードですよ？"},
        { "location": "493/SEL"     , "narrator": "", "text": "冗談です"},
        { "location": "494/SEL"     , "narrator": "", "text": "大事なのは時間じゃない！この気持ちなんだ！"},
        { "location": "495/ACT"     , "narrator": "", "text": "冗談です"},
        { "location": "496/TALK"    , "narrator": "赤髪千羽鶴", "text": "…まあそうですよね。"},
        { "location": "497/TALK"    , "narrator": "赤髪千羽鶴", "text": "そういう冗談は\nあまり面白く無いので\nやめませんか？"},
        { "location": "498/TALK"    , "narrator": "赤髪千羽鶴", "text": "それはさておき。\nお伝えしたいのは、\nプロポーズとかではなく！"},
        { "location": "499/ACT"     , "narrator": "", "text": "大事なのは時間じゃない！この気持ちなんだ！"},
        { "location": "500/TALK"    , "narrator": "赤髪千羽鶴", "text": "そんな情熱\n嬉しくありません。"},
        { "location": "501/TALK"    , "narrator": "赤髪千羽鶴", "text": "それより、もっと建設的に\nお話をしませんか？"},
        { "location": "502/TALK"    , "narrator": "赤髪千羽鶴", "text": "お付き合いするなら\nそれで構いませんが、\n段階があると思います。"},
        { "location": "503/TALK"    , "narrator": "赤髪千羽鶴", "text": "それでお互いがお互いを\n知って初めて、その意味も\n出てくると思いますし。"},
        { "location": "504/TALK"    , "narrator": "赤髪千羽鶴", "text": "とはいえ、\n今はそんな事をしている\n暇はありません！"},
        { "location": "505/TALK"    , "narrator": "赤髪千羽鶴", "text": "お伝えしたいのは、\nプロポーズとかではなく！"},
        { "location": "508/TALK"    , "narrator": "赤髪千羽鶴", "text": "前回は色々と\nすみませんでした！"},
        { "location": "509/SEL"     , "narrator": "", "text": "どうしたの？いきなり？？"},
        { "location": "510/ACT"     , "narrator": "", "text": "どうしたの？いきなり？？"},
        { "location": "512/TALK"    , "narrator": "赤髪千羽鶴", "text": "えっとですね、\n前回アンケートを\n取ったじゃないですか。"},
        { "location": "513/TALK"    , "narrator": "赤髪千羽鶴", "text": "今後この世界を\nどうしていくのがいいか\nっていう質問のことです。"},
        { "location": "514/TALK"    , "narrator": "赤髪千羽鶴", "text": "私としては単に、\nエピソード３０付近で\n決めてから時間が経つので"},
        { "location": "515/TALK"    , "narrator": "赤髪千羽鶴", "text": "今でもあの時と同じか、\nそれとも考えが変わったか\n確認しただけでした。"},
        { "location": "516/TALK"    , "narrator": "赤髪千羽鶴", "text": "リプレイス作戦についても\n方法を伝えただけで、\n是非は問うて無かったので"},
        { "location": "517/TALK"    , "narrator": "赤髪千羽鶴", "text": "改めて、過去に出た案を\n全部並べて、今の考えを\n聞きたかっただけです。"},
        { "location": "518/SEL"     , "narrator": "", "text": "そういえばそんな事言ってたような"},
        { "location": "519/SEL"     , "narrator": "", "text": "屋上行こうぜ、久し振りにガチで考えちまったよ…"},
        { "location": "520/ACT"     , "narrator": "", "text": "そういえばそんな事言ってたような"},
        { "location": "521/TALK"    , "narrator": "赤髪千羽鶴", "text": "表現が曖昧すぎましたね。\nわかりにくくて\nごめんなさい。"},
        { "location": "522/ACT"     , "narrator": "", "text": "屋上行こうぜ、久し振りにガチで考えちまったよ…"},
        { "location": "523/TALK"    , "narrator": "赤髪千羽鶴", "text": "ごめんなさい。"},
        { "location": "524/TALK"    , "narrator": "赤髪千羽鶴", "text": "でもその心意気は\nとても素敵です！"},
        { "location": "526/TALK"    , "narrator": "赤髪千羽鶴", "text": "いずれにせよ、\n回答はしていただいた\nわけですので――"},
        { "location": "527/TALK"    , "narrator": "赤髪千羽鶴", "text": "$handle$さんには\nその結果を見る権利が\nあります！"},
        { "location": "528/TALK"    , "narrator": "赤髪千羽鶴", "text": "もちろん、\n見ない権利もあります。"},
        { "location": "529/TALK"    , "narrator": "赤髪千羽鶴", "text": "どちらの権利を行使するか\nご自身で決めて下さいね。"},
        { "location": "530/SEL"     , "narrator": "", "text": "結果を見る権利を行使する"},
        { "location": "531/SEL"     , "narrator": "", "text": "結果を見ない権利を更新する"},
        { "location": "532/ACT"     , "narrator": "", "text": "結果を見る権利を行使する"},
        { "location": "533/TALK"    , "narrator": "赤髪千羽鶴", "text": "わかりました。それでは\n公表したいと思います。"},
        { "location": "539/TALK"    , "narrator": "赤髪千羽鶴", "text": "これが今回の結果です。"},
        { "location": "540/TALK"    , "narrator": "赤髪千羽鶴", "text": "対向時間における\n2018年2月5日現在の\n総意となります。"},
        { "location": "541/TALK"    , "narrator": "赤髪千羽鶴", "text": "①：千羽鶴、すなわち\n私が元々推進しようと\nしていた計画、15.7%。"},
        { "location": "542/TALK"    , "narrator": "赤髪千羽鶴", "text": "②：エリカさんの提唱\nするリプレイス計画、\n55.7%。"},
        { "location": "543/TALK"    , "narrator": "赤髪千羽鶴", "text": "③：世界を元に\n戻してしまう、4.40%。"},
        { "location": "544/TALK"    , "narrator": "赤髪千羽鶴", "text": "④：このまま日本を\nフェノメノンで包んだ\nままにする、10.5%。"},
        { "location": "545/TALK"    , "narrator": "赤髪千羽鶴", "text": "⑤：この中には\n自分の回答は無い、\n13.7%。"},
        { "location": "546/TALK"    , "narrator": "赤髪千羽鶴", "text": "という感じです。"},
        { "location": "547/TALK"    , "narrator": "赤髪千羽鶴", "text": "もちろんこれは、\n現時点での総意であり、\n何の影響もありません。"},
        { "location": "552/TALK"    , "narrator": "赤髪千羽鶴", "text": "次に、⑤を選んだ方の\n具体的な理由について\nなんですが――"},
        { "location": "553/TALK"    , "narrator": "赤髪千羽鶴", "text": "大勢の方から、\n様々なお考えを\nいただきました。"},
        { "location": "554/TALK"    , "narrator": "赤髪千羽鶴", "text": "ただ、それを\nディベートするのは\nもう少しお待ちください。"},
        { "location": "555/SEL"     , "narrator": "", "text": "なぜ？"},
        { "location": "556/ACT"     , "narrator": "", "text": "なぜ？"},
        { "location": "558/TALK"    , "narrator": "赤髪千羽鶴", "text": "理由は２つあります。"},
        { "location": "559/TALK"    , "narrator": "赤髪千羽鶴", "text": "１つは、まだ判断する為の\n情報が足りていないのでは\nないかということ。"},
        { "location": "560/TALK"    , "narrator": "赤髪千羽鶴", "text": "これは、⑤のお考えの\n半数近くを占めていた\nご回答でしたので――"},
        { "location": "561/TALK"    , "narrator": "赤髪千羽鶴", "text": "恐らく、それ以外の\nお考えをいただいた方も\n同じだと思います。"},
        { "location": "562/TALK"    , "narrator": "赤髪千羽鶴", "text": "ですから、色々と\n情報をお伝えした後に\n再度いただければと。"},
        { "location": "563/TALK"    , "narrator": "赤髪千羽鶴", "text": "そして２つ目です。\nこちらはより重要な\n理由になります。"},
        { "location": "564/ACT"     , "narrator": "", "text": "結果を見ない権利を更新する"},
        { "location": "565/TALK"    , "narrator": "赤髪千羽鶴", "text": "わかりました。"},
        { "location": "566/TALK"    , "narrator": "赤髪千羽鶴", "text": "それでですね、\n私が唐突に謝った理由は\n何だったかというと――"},
        { "location": "567/TALK"    , "narrator": "赤髪千羽鶴", "text": "質問の真剣度合を\n正確に伝えられなかった\nことではありません。"},
        { "location": "568/SEL"     , "narrator": "", "text": "じゃあ何なの？"},
        { "location": "569/ACT"     , "narrator": "", "text": "じゃあ何なの？"},
        { "location": "572/TALK"    , "narrator": "赤髪千羽鶴", "text": "私は\nウッカリしていました。"},
        { "location": "573/TALK"    , "narrator": "赤髪千羽鶴", "text": "世界をどうしたいか、\nという質問よりも前に――"},
        { "location": "574/TALK"    , "narrator": "赤髪千羽鶴", "text": "それ以前に、\nまず聞かねばならない\nことがありましたよね…。"},
        { "location": "575/SEL"     , "narrator": "", "text": "なんでしょう？"},
        { "location": "576/SEL"     , "narrator": "", "text": "結婚してくれ？\nもちろんいいよ！"},
        { "location": "577/ACT"     , "narrator": "", "text": "なんでしょう？"},
        { "location": "578/ACT"     , "narrator": "", "text": "結婚してくれ？\nもちろんいいよ！"},
        { "location": "580/TALK"    , "narrator": "赤髪千羽鶴", "text": "二度目ですね。"},
        { "location": "581/TALK"    , "narrator": "赤髪千羽鶴", "text": "どういうつもりなのか\nとても興味があります！"},
        { "location": "582/SEL"     , "narrator": "", "text": "それくらい本気ってことなんだけど"},
        { "location": "583/SEL"     , "narrator": "", "text": "こういうの天丼って言うんだけど、知らなかった？"},
        { "location": "584/ACT"     , "narrator": "", "text": "それくらい本気ってことなんだけど"},
        { "location": "586/TALK"    , "narrator": "赤髪千羽鶴", "text": "$handle$さんに\nとっての本気の定義が\nわかりませんが――"},
        { "location": "587/TALK"    , "narrator": "赤髪千羽鶴", "text": "それは心理的に\nどのような心境を\n示すものでしょうか？"},
        { "location": "588/TALK"    , "narrator": "赤髪千羽鶴", "text": "先にも言いましたけど、\nまだ私たちは殆ど\nお互いを知りません。"},
        { "location": "589/TALK"    , "narrator": "赤髪千羽鶴", "text": "ですから、本気の\n意味も計りかねるんです。"},
        { "location": "590/TALK"    , "narrator": "赤髪千羽鶴", "text": "私の定義でいうところの\n本気に照らし合わせれば―"},
        { "location": "591/TALK"    , "narrator": "赤髪千羽鶴", "text": "お互いの良いところも\nダメなところも全部\n知り尽くしていること。"},
        { "location": "592/TALK"    , "narrator": "赤髪千羽鶴", "text": "そして、それを全て\n我慢では無く、受け入れる\nことができること。"},
        { "location": "593/TALK"    , "narrator": "赤髪千羽鶴", "text": "相手を自らと同等に愛し、\n同等のいのちの重さを\n感じていること。"},
        { "location": "594/TALK"    , "narrator": "赤髪千羽鶴", "text": "それを実践できること。"},
        { "location": "595/TALK"    , "narrator": "赤髪千羽鶴", "text": "…という感じに\nなりますけど。"},
        { "location": "596/TALK"    , "narrator": "赤髪千羽鶴", "text": "まず$handle$さんは\n私のダメな所も想いも\n全て受け入れられますか？"},
        { "location": "597/SEL"     , "narrator": "", "text": "もちろんです"},
        { "location": "598/SEL"     , "narrator": "", "text": "それは時と場合による"},
        { "location": "599/ACT"     , "narrator": "", "text": "もちろんです"},
        { "location": "601/TALK"    , "narrator": "赤髪千羽鶴", "text": "わかりました。"},
        { "location": "602/TALK"    , "narrator": "赤髪千羽鶴", "text": "その言葉、\n心に焼き付けましたから。"},
        { "location": "603/ACT"     , "narrator": "", "text": "それは時と場合による"},
        { "location": "604/TALK"    , "narrator": "赤髪千羽鶴", "text": "もっと正確に\n回答してくださいね。"},
        { "location": "605/TALK"    , "narrator": "赤髪千羽鶴", "text": "$handle$さんは、\nまだ私のダメな所とか\n全然知りません。"},
        { "location": "606/TALK"    , "narrator": "赤髪千羽鶴", "text": "時と場合による、\nではなくて、\n判断出来ない、です。"},
        { "location": "607/TALK"    , "narrator": "赤髪千羽鶴", "text": "いずれにせよ、\n本気の結婚申込は\n却下させていただきます。"},
        { "location": "609/ACT"     , "narrator": "", "text": "こういうの天丼って言うんだけど、知らなかった？"},
        { "location": "610/TALK"    , "narrator": "赤髪千羽鶴", "text": "もちろん\n知ってますよ。"},
        { "location": "611/TALK"    , "narrator": "赤髪千羽鶴", "text": "それともうひとつ。"},
        { "location": "612/TALK"    , "narrator": "赤髪千羽鶴", "text": "$handle$さんは\n信用ならない人だと\nわかりました。"},
        { "location": "613/TALK"    , "narrator": "赤髪千羽鶴", "text": "発言する単語の持つ重さと\nそれを発する時の想いの\n重さが一致していません。"},
        { "location": "614/TALK"    , "narrator": "赤髪千羽鶴", "text": "以後、そういう方だと\nいう心構えで\n接していきますね。"},
        { "location": "615/SEL"     , "narrator": "", "text": "もしかして怒ってる？"},
        { "location": "616/ACT"     , "narrator": "", "text": "もしかして怒ってる？"},
        { "location": "618/TALK"    , "narrator": "赤髪千羽鶴", "text": "いえ。\n全然そんなこと\nありませんよ？"},
        { "location": "619/TALK"    , "narrator": "赤髪千羽鶴", "text": "$handle$さんへの\n印象が悪くなったりも\nしていません。"},
        { "location": "620/TALK"    , "narrator": "赤髪千羽鶴", "text": "ただ単に、\n$handle$さんの\n一面を記憶しただけです。"},
        { "location": "621/TALK"    , "narrator": "赤髪千羽鶴", "text": "ですから、\n心配しないでくださいね。"},
        { "location": "623/TALK"    , "narrator": "赤髪千羽鶴", "text": "それで、\n話を戻しますけど――"},
        { "location": "624/TALK"    , "narrator": "赤髪千羽鶴", "text": "私が今回、まず\n聞かねばならなかった\nことはですね！"},
        { "location": "628/TALK"    , "narrator": "赤髪千羽鶴", "text": "<size=35>どーん！</size>"},
        { "location": "629/TALK"    , "narrator": "赤髪千羽鶴", "text": "意味が分かりません。"},
        { "location": "630/TALK"    , "narrator": "赤髪千羽鶴", "text": "といいますか。"},
        { "location": "631/TALK"    , "narrator": "赤髪千羽鶴", "text": "どうして私と結婚したい\nという気持ちになるのか、\n全然わかりません。"},
        { "location": "632/TALK"    , "narrator": "赤髪千羽鶴", "text": "私たちはまだ、出逢って\n数エピソードですよ？"},
        { "location": "633/SEL"     , "narrator": "", "text": "冗談です"},
        { "location": "634/SEL"     , "narrator": "", "text": "大事なのは時間じゃない！この気持ちなんだ！"},
        { "location": "635/ACT"     , "narrator": "", "text": "冗談です"},
        { "location": "636/TALK"    , "narrator": "赤髪千羽鶴", "text": "…まあそうですよね。"},
        { "location": "637/TALK"    , "narrator": "赤髪千羽鶴", "text": "そういう冗談は\nあまり面白く無いので\nやめませんか？"},
        { "location": "638/TALK"    , "narrator": "赤髪千羽鶴", "text": "それはさておき。\nまず聞かねば\nならなかったのは！"},
        { "location": "639/ACT"     , "narrator": "", "text": "大事なのは時間じゃない！この気持ちなんだ！"},
        { "location": "640/TALK"    , "narrator": "赤髪千羽鶴", "text": "そんな情熱\n嬉しくありません。"},
        { "location": "641/TALK"    , "narrator": "赤髪千羽鶴", "text": "それより、もっと建設的に\nお話をしませんか？"},
        { "location": "642/TALK"    , "narrator": "赤髪千羽鶴", "text": "お付き合いするなら\nそれで構いませんが、\n段階があると思います。"},
        { "location": "643/TALK"    , "narrator": "赤髪千羽鶴", "text": "それでお互いがお互いを\n知って初めて、その意味も\n出てくると思いますし。"},
        { "location": "644/TALK"    , "narrator": "赤髪千羽鶴", "text": "とはいえ、\n今はそんな事をしている\n暇はありません！"},
        { "location": "645/TALK"    , "narrator": "赤髪千羽鶴", "text": "聞かねば\nならなかったのは！"},
        { "location": "649/TALK"    , "narrator": "赤髪千羽鶴", "text": "そもそも\n$handle$さんが\n何を期待しているかです！"},
        { "location": "650/SEL"     , "narrator": "", "text": "？？？"},
        { "location": "651/ACT"     , "narrator": "", "text": "？？？"},
        { "location": "653/TALK"    , "narrator": "赤髪千羽鶴", "text": "えっとですね――"},
        { "location": "654/TALK"    , "narrator": "赤髪千羽鶴", "text": "千羽鶴が貴方に\n最初に依頼したことを\n覚えてますか？"},
        { "location": "655/SEL"     , "narrator": "", "text": "ある少女たちと結婚して欲しい！"},
        { "location": "656/SEL"     , "narrator": "", "text": "ちーと結婚して欲しい！"},
        { "location": "657/ACT"     , "narrator": "", "text": "ある少女たちと結婚して欲しい！"},
        { "location": "658/TALK"    , "narrator": "赤髪千羽鶴", "text": "そうです！"},
        { "location": "659/ACT"     , "narrator": "", "text": "ちーと結婚して欲しい！"},
        { "location": "660/TALK"    , "narrator": "赤髪千羽鶴", "text": "もしかして、\n頭の老化現象が\n始まってますか！？"},
        { "location": "661/TALK"    , "narrator": "赤髪千羽鶴", "text": "それとも、世界線が\nズレてしまって\nいるのでしょうか？"},
        { "location": "662/TALK"    , "narrator": "赤髪千羽鶴", "text": "千羽鶴は\n貴方と結婚したいなんて\n思ってませんから。"},
        { "location": "663/TALK"    , "narrator": "赤髪千羽鶴", "text": "正解は、\n彼女たちと結婚して欲しい\nですよ？"},
        { "location": "665/TALK"    , "narrator": "赤髪千羽鶴", "text": "では次の質問です。"},
        { "location": "666/TALK"    , "narrator": "赤髪千羽鶴", "text": "このアプリは、\n貴方の世界では\nどんな“ゲーム”ですか？"},
        { "location": "667/SEL"     , "narrator": "", "text": "恋愛シミュレーションゲーム"},
        { "location": "668/SEL"     , "narrator": "", "text": "恋愛RPG"},
        { "location": "669/ACT"     , "narrator": "", "text": "恋愛シミュレーションゲーム"},
        { "location": "670/ACT"     , "narrator": "", "text": "恋愛RPG"},
        { "location": "672/TALK"    , "narrator": "赤髪千羽鶴", "text": "そうですよね。\nそれは決して――"},
        { "location": "673/TALK"    , "narrator": "赤髪千羽鶴", "text": "【貴方の想いが彼女たちの\n世界の命運を左右する\n本気のディベートアプリ】"},
        { "location": "674/TALK"    , "narrator": "赤髪千羽鶴", "text": "とかいう触れ込みで\nインストールしたわけでは\nありませんよね？"},
        { "location": "675/TALK"    , "narrator": "赤髪千羽鶴", "text": "要するに、前回私が\n前振りもなく、世界の\n運営方針を聞いたのは――"},
        { "location": "676/TALK"    , "narrator": "赤髪千羽鶴", "text": "貴方の世界では\n法律違反になるという\nことなんです。"},
        { "location": "677/TALK"    , "narrator": "赤髪千羽鶴", "text": "貴方は「恋愛」をしたくて\nこのアプリをインストール\nしたわけですから。"},
        { "location": "678/TALK"    , "narrator": "赤髪千羽鶴", "text": "貴方はこのアプリを、不当\n景品類及び不当表示防止法\nに基づき訴えられます。"},
        { "location": "679/TALK"    , "narrator": "赤髪千羽鶴", "text": "ですから、そうなって\nしまう前に、私はある事を\n聞かねばならないんです。"},
        { "location": "680/TALK"    , "narrator": "赤髪千羽鶴", "text": "そして、それに応じて、\n貴方の希望に準じた方針を\n提供せねばなりません。"},
        { "location": "681/TALK"    , "narrator": "赤髪千羽鶴", "text": "では参ります！"},
        { "location": "682/TALK"    , "narrator": "赤髪千羽鶴", "text": "貴方がこのアプリに\n期待するものは――"},
        { "location": "683/TALK"    , "narrator": "赤髪千羽鶴", "text": "掲示通り、彼女たち……\n私や千羽鶴やエリカさんも\n含む皆との恋愛か。"},
        { "location": "684/TALK"    , "narrator": "赤髪千羽鶴", "text": "それとも、\n世界の命運を私たちと共に\n考えていくことか。"},
        { "location": "685/TALK"    , "narrator": "赤髪千羽鶴", "text": "尚、これは\n“総意”では\nありませんから。"},
        { "location": "686/TALK"    , "narrator": "赤髪千羽鶴", "text": "$handle$さん\n個人の希望に応じた、\n個別の方針になります。"},
        { "location": "695/SEL"     , "narrator": "", "text": "正直、難しいことはもういいです。彼女たちとイチャイチャラブラブしたい"},
        { "location": "696/SEL"     , "narrator": "", "text": "世界の選択に関わりたい"},
        { "location": "698/TALK"    , "narrator": "赤髪千羽鶴", "text": "もう少しだけ\n補足をしておきますね。"},
        { "location": "699/TALK"    , "narrator": "赤髪千羽鶴", "text": "彼女たちとのイチャラブを\n希望する場合、私は貴方に\n今後難しい話をしません。"},
        { "location": "700/TALK"    , "narrator": "赤髪千羽鶴", "text": "千羽鶴が言った事とはいえ\n発言責任は私にも\nありますから――"},
        { "location": "701/TALK"    , "narrator": "赤髪千羽鶴", "text": "景表法に抵触しないよう\n貴方と彼女たちとの恋愛に\n集中できるようにします。"},
        { "location": "702/TALK"    , "narrator": "赤髪千羽鶴", "text": "あと、恋愛を選ぶことで\n私たちの世界が崩壊する！\nと心配するかもですが――"},
        { "location": "703/TALK"    , "narrator": "赤髪千羽鶴", "text": "その心配は\n一切無用です！"},
        { "location": "704/TALK"    , "narrator": "赤髪千羽鶴", "text": "貴方が世界に対しての\n選択をすることは、\n今後なくなりますが――"},
        { "location": "705/TALK"    , "narrator": "赤髪千羽鶴", "text": "それらは私や、もう１つの\n選択をした人達によって、\n責任持って遂行します。"},
        { "location": "706/TALK"    , "narrator": "赤髪千羽鶴", "text": "ですから、恋愛している\nだけで、いつの間にか\n世界が幸せになっている―"},
        { "location": "707/TALK"    , "narrator": "赤髪千羽鶴", "text": "なんてことも、\nあるわけですね！"},
        { "location": "708/TALK"    , "narrator": "赤髪千羽鶴", "text": "もちろん逆に、世界が\n大変なことになってしまう\nこともありますが……。"},
        { "location": "709/TALK"    , "narrator": "赤髪千羽鶴", "text": "でもそれは、貴方に\nとっては自然災害と\n同じです。"},
        { "location": "710/TALK"    , "narrator": "赤髪千羽鶴", "text": "貴方には、そうなって\nしまった責任もなければ、\n責められたりもしません。"},
        { "location": "711/TALK"    , "narrator": "赤髪千羽鶴", "text": "逆に、\n世界の選択に関わることを\n希望する場合は――"},
        { "location": "712/TALK"    , "narrator": "赤髪千羽鶴", "text": "これから数回にわたって\n私と一緒に“選択”の\n訓練をしてもらいます。"},
        { "location": "713/TALK"    , "narrator": "赤髪千羽鶴", "text": "…とまあ、訓練といっても\n辛いものではない………\nと思います。"},
        { "location": "714/TALK"    , "narrator": "赤髪千羽鶴", "text": "むしろ、心理ゲームの\nようなものですから――"},
        { "location": "715/TALK"    , "narrator": "赤髪千羽鶴", "text": "$handle$さんが\n自分を知るのにも役に立ち\n有用だと思います。"},
        { "location": "716/TALK"    , "narrator": "赤髪千羽鶴", "text": "訓練の目的は、理想社会\n創造の源となる、貴方の\n確度を上げる為です。"},
        { "location": "717/TALK"    , "narrator": "赤髪千羽鶴", "text": "私たちにとっては命運を\n分かつものですから、\n本気で真剣にやります。"},
        { "location": "718/TALK"    , "narrator": "赤髪千羽鶴", "text": "ですから、少しだけ\n疲れることもあるかも\nしれません。"},
        { "location": "719/TALK"    , "narrator": "赤髪千羽鶴", "text": "ただそれは、お互いに\nとって価値のあるものに\nなると思います。"},
        { "location": "720/TALK"    , "narrator": "赤髪千羽鶴", "text": "私からの補足は\n以上となります。"},
        { "location": "721/ACT"     , "narrator": "", "text": "正直、難しいことはもういいです。彼女たちとイチャイチャラブラブしたい"},
        { "location": "730/TALK"    , "narrator": "赤髪千羽鶴", "text": "わかりました！"},
        { "location": "731/TALK"    , "narrator": "赤髪千羽鶴", "text": "とても賢明な\n判断だと思います。"},
        { "location": "732/TALK"    , "narrator": "赤髪千羽鶴", "text": "$handle$さんは\nこれから私たちと\nラブラブするだけです！"},
        { "location": "733/TALK"    , "narrator": "赤髪千羽鶴", "text": "世界の命運は、安心して\n他の選択者や私に\n任せてくださいね！"},
        { "location": "734/ACT"     , "narrator": "", "text": "世界の選択に関わりたい"},
        { "location": "743/TALK"    , "narrator": "赤髪千羽鶴", "text": "わかりました！"},
        { "location": "744/TALK"    , "narrator": "赤髪千羽鶴", "text": "とても賢明な\n判断だと思います。"},
        { "location": "745/TALK"    , "narrator": "赤髪千羽鶴", "text": "では早速ですが、\n$handle$さんには\n次回から訓練があります。"},
        { "location": "746/TALK"    , "narrator": "赤髪千羽鶴", "text": "気持ちをスッキリ\n透明にしておいて\nくださいね？"},
        { "location": "747/TALK"    , "narrator": "赤髪千羽鶴", "text": "$handle$さん方の\nポテンシャルを\n最大限引き出す為に。"},
        { "location": "749/TALK"    , "narrator": "赤髪千羽鶴", "text": "というわけで、\n私からの今回のお話は\nこれでお終いです。"},
        { "location": "750/TALK"    , "narrator": "赤髪千羽鶴", "text": "この後ですが――"},
        { "location": "751/TALK"    , "narrator": "赤髪千羽鶴", "text": "前回と同じように\nこのセクションの記録\n映像を見ていきますか？"},
        { "location": "752/TALK"    , "narrator": "赤髪千羽鶴", "text": "今のスタックポインタは\n記録映像でいえば\n2016年5月9日――"},
        { "location": "753/TALK"    , "narrator": "赤髪千羽鶴", "text": "クラン“ちとせ”との\nフェノメノン戦の終結\n付近になりますね。"},
        { "location": "755/SEL"     , "narrator": "", "text": "映像を見る\n<color=green>【高画質/95MB 6:14】</color>"},
        { "location": "756/SEL"     , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/30MB 6:14】</color>"},
        { "location": "757/SEL"     , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "758/ACT"     , "narrator": "", "text": "映像を見る\n<color=green>【高画質/95MB 6:14】</color>"},
        { "location": "759/TALK"    , "narrator": "赤髪千羽鶴", "text": "わかりました。\nそれでは再生しましょう。"},
        { "location": "765/ACT"     , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/30MB 6:14】</color>"},
        { "location": "766/TALK"    , "narrator": "赤髪千羽鶴", "text": "わかりました。\nそれでは再生しましょう。"},
        { "location": "772/ACT"     , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "773/TALK"    , "narrator": "赤髪千羽鶴", "text": "わかりました。\nそれではレポートを\nご覧下さい。"},
        { "location": "806/TALK"    , "narrator": "赤髪千羽鶴", "text": "いわゆるひとつの\nサービスシーンという\nやつでしょうか！"},
        { "location": "807/SEL"     , "narrator": "", "text": "イエス！！！"},
        { "location": "808/SEL"     , "narrator": "", "text": "神楽の本当の目的は何だか知ってる？"},
        { "location": "809/ACT"     , "narrator": "", "text": "イエス！！！"},
        { "location": "810/TALK"    , "narrator": "赤髪千羽鶴", "text": "やっぱり！\n良かったですね！"},
        { "location": "811/SEL"     , "narrator": "", "text": "ガンプクガンプク！"},
        { "location": "812/SEL"     , "narrator": "", "text": "自分が裸で神楽に遊ばれてるのを見ても平気なの？"},
        { "location": "813/ACT"     , "narrator": "", "text": "ガンプクガンプク！"},
        { "location": "814/TALK"    , "narrator": "赤髪千羽鶴", "text": "ふふっ。"},
        { "location": "815/ACT"     , "narrator": "", "text": "自分が裸で神楽に遊ばれてるのを見ても平気なの？"},
        { "location": "816/TALK"    , "narrator": "赤髪千羽鶴", "text": "自分ですか？\nうーん、そうですね。"},
        { "location": "817/TALK"    , "narrator": "赤髪千羽鶴", "text": "どちらかというと――"},
        { "location": "818/TALK"    , "narrator": "赤髪千羽鶴", "text": "自分がキャラメイクした\nアバターが辱めを受けてる\n感じでしょうか！"},
        { "location": "819/TALK"    , "narrator": "赤髪千羽鶴", "text": "まあそれはそれで、物語と\nして見れば「むーん」と\n思わなくもありませんが。"},
        { "location": "821/ACT"     , "narrator": "", "text": "神楽の本当の目的は何だか知ってる？"},
        { "location": "822/TALK"    , "narrator": "赤髪千羽鶴", "text": "概ねは\nわかってるつもりです。"},
        { "location": "823/TALK"    , "narrator": "赤髪千羽鶴", "text": "卯月さんは、私の本性が\n露見するようなことを、\n試したのだと思います。"},
        { "location": "824/TALK"    , "narrator": "赤髪千羽鶴", "text": "ここまでの卯月さんを\n見ていればわかるかも\nしれませんが――"},
        { "location": "825/TALK"    , "narrator": "赤髪千羽鶴", "text": "彼女が外の世界で\n聞いていた情報との齟齬が\n大きすぎたんです。"},
        { "location": "826/TALK"    , "narrator": "赤髪千羽鶴", "text": "ですから卯月さんの\n胸もみは、任務の一環では\nありません。"},
        { "location": "827/TALK"    , "narrator": "赤髪千羽鶴", "text": "卯月さんの個人的な\n興味によるものでしか\nないのです。"},
        { "location": "828/SEL"     , "narrator": "", "text": "なるほど"},
        { "location": "829/SEL"     , "narrator": "", "text": "そんな任務あるならむしろ$me$に任せてくれ！！"},
        { "location": "830/SEL"     , "narrator": "", "text": "卯月さんの個人的な興味（意味深"},
        { "location": "831/ACT"     , "narrator": "", "text": "なるほど"},
        { "location": "832/TALK"    , "narrator": "赤髪千羽鶴", "text": "卯月さんは多分、\nこう考えたのだと\n思います。"},
        { "location": "833/TALK"    , "narrator": "赤髪千羽鶴", "text": "もし本当に言われてる\nような子だったら――"},
        { "location": "834/TALK"    , "narrator": "赤髪千羽鶴", "text": "今のつばめは演技であり、\n度を超えた事をする事で\n化けの皮が剥がれるはず。"},
        { "location": "835/TALK"    , "narrator": "赤髪千羽鶴", "text": "ですが、\n結果は卯月さんの予測とは\n違うものになりました。"},
        { "location": "836/TALK"    , "narrator": "赤髪千羽鶴", "text": "ある意味において、\nこの行為が彼女の迷走の\n第一歩となったんです。"},
        { "location": "837/ACT"     , "narrator": "", "text": "そんな任務あるならむしろ$me$に任せてくれ！！"},
        { "location": "838/TALK"    , "narrator": "赤髪千羽鶴", "text": "その心意気は\nとても素敵です！"},
        { "location": "839/TALK"    , "narrator": "赤髪千羽鶴", "text": "では、今後胸もみが\n任務として必要な時が\n来たらお願いしますね。"},
        { "location": "840/ACT"     , "narrator": "", "text": "卯月さんの個人的な興味（意味深"},
        { "location": "841/TALK"    , "narrator": "赤髪千羽鶴", "text": "まあ、卯月さんは\n小動物系が好みの\nようですし――"},
        { "location": "842/TALK"    , "narrator": "赤髪千羽鶴", "text": "そういう意味での個人的\n趣味で実施した、と言われ\nても驚かないでしょう。"},
        { "location": "843/TALK"    , "narrator": "赤髪千羽鶴", "text": "ただ、それにしても\nこの時期における実施は\n時期尚早かと思います。"},
        { "location": "844/TALK"    , "narrator": "赤髪千羽鶴", "text": "何せまだ、つばめの\n天然キャラ成分は殆ど\n見えていませんから。"},
        { "location": "847/TALK"    , "narrator": "赤髪千羽鶴", "text": "それでは今回は\nこれにて失礼します。"},
        { "location": "848/TALK"    , "narrator": "赤髪千羽鶴", "text": "また次回、\nお逢いしましょうね。"},
        { "location": "537/DIALOG"  , "narrator": "Event/Dialog_EventPicTallNW", "text": "今後この世界を\nどうするのがよいか？"},
        { "location": "689/DIALOG"  , "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:navigator】</color>\n\nしばらくの間は、\n何度でも回答を変更できます。\nただし、回答の固定は\n唐突に訪れるかもしれません。\nその点ご注意ください。\n\n最後の回答が、その時点での\n貴方の結論となります。\n\n<color=red>現在の貴方の選択は【正直、難しいことはもういいです。彼女たちとイチャイチャラブラブしたい】です。</color>\n"},
        { "location": "691/DIALOG"  , "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:navigator】</color>\n\nしばらくの間は、\n何度でも回答を変更できます。\nただし、回答の固定は\n唐突に訪れるかもしれません。\nその点ご注意ください。\n\n最後の回答が、その時点での\n貴方の結論となります。\n\n<color=red>現在の貴方の選択は【世界の選択に関わりたい】です。</color>\n"},
        { "location": "693/DIALOG"  , "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:navigator】</color>\n\nしばらくの間は、\n何度でも回答を変更できます。\nただし、回答の固定は\n唐突に訪れるかもしれません。\nその点ご注意ください。\n\n最後の回答が、その時点での\n貴方の結論となります。"},
        { "location": "724/DIALOG"  , "narrator": "Dialog_Alert", "text": "<color=green>【TRI-OS Plug-in:navigator】</color>\n\n<color=red>回答は既にFIXされています。</color>\n会話は何事も無く続きますが、\nこの選択によって、\nイチャイチャコースに\n切り替わることはありません。\n"},
