    "type": "",
    "info": {
        "story_id": "24000",
        "cid": "",
        "title": "000 ココロスフィア解説",
        "sub_title": "ココロの深淵へようこそ"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "ココロスフィア導入みやび"},
        { "location": "13/DIALOG" , "narrator": "", "text": "<size=40>DOOR-No. 000</size>\nCHIHARU\n\n<size=40>Kokoro.Initialize();</size>\n<size=25>～深層ココロスフィアの概念について～</size>"},
        { "location": "22/TALK"   , "narrator": "千羽鶴", "text": "ようこそ、\n恋ヶ崎みやびの\n深層世界へ。"},
        { "location": "24/TALK"   , "narrator": "千羽鶴", "text": "前にもしてるけど、\n深層世界についての説明、\nもう一度聞く？"},
        { "location": "25/SEL"    , "narrator": "（選択肢）", "text": "はい"},
        { "location": "26/SEL"    , "narrator": "（選択肢）", "text": "いいえ"},
        { "location": "27/ACT"    , "narrator": "", "text": "はい"},
        { "location": "28/TALK"   , "narrator": "千羽鶴", "text": "わかった。\nそれじゃもう一度、\n深層世界の話をする。"},
        { "location": "30/ACT"    , "narrator": "", "text": "いいえ"},
        { "location": "31/TALK"   , "narrator": "千羽鶴", "text": "そう、助かる。"},
        { "location": "47/TALK"   , "narrator": "千羽鶴", "text": "さて。"},
        { "location": "48/TALK"   , "narrator": "千羽鶴", "text": "改めて、\nここは恋ヶ崎みやびの\n深層世界。"},
        { "location": "49/TALK"   , "narrator": "千羽鶴", "text": "ところで貴方は\n恋ヶ崎みやびの\n何を知っていますか？"},
        { "location": "50/SEL"    , "narrator": "（選択肢）", "text": "不思議ちゃんなこと"},
        { "location": "51/SEL"    , "narrator": "（選択肢）", "text": "胸が大きいことを心底嫌がっている"},
        { "location": "52/SEL"    , "narrator": "（選択肢）", "text": "何も知らない"},
        { "location": "53/ACT"    , "narrator": "", "text": "不思議ちゃんなこと"},
        { "location": "54/TALK"   , "narrator": "千羽鶴", "text": "あー"},
        { "location": "55/TALK"   , "narrator": "千羽鶴", "text": "まー"},
        { "location": "56/TALK"   , "narrator": "千羽鶴", "text": "そ、そうですね。"},
        { "location": "57/TALK"   , "narrator": "千羽鶴", "text": "あなたの中ではね…。"},
        { "location": "58/ACT"    , "narrator": "", "text": "胸が大きいことを心底嫌がっている"},
        { "location": "59/TALK"   , "narrator": "千羽鶴", "text": "えっ　と。"},
        { "location": "60/TALK"   , "narrator": "千羽鶴", "text": "また胸のこと…？"},
        { "location": "61/TALK"   , "narrator": "千羽鶴", "text": "まー"},
        { "location": "62/TALK"   , "narrator": "千羽鶴", "text": "そう…ですね。"},
        { "location": "63/ACT"    , "narrator": "", "text": "何も知らない"},
        { "location": "64/TALK"   , "narrator": "千羽鶴", "text": "賢い。"},
        { "location": "67/TALK"   , "narrator": "千羽鶴", "text": "それでこそ、私の\nカリスマラブダイバー！"},
        { "location": "68/SEL"    , "narrator": "（選択肢）", "text": "何それかっこいい"},
        { "location": "69/SEL"    , "narrator": "（選択肢）", "text": "何それひどすぎ"},
        { "location": "70/ACT"    , "narrator": "", "text": "何それかっこいい"},
        { "location": "71/TALK"   , "narrator": "千羽鶴", "text": "でしょう？"},
        { "location": "72/TALK"   , "narrator": "千羽鶴", "text": "カリスマラブダイバーの\n名に恥じない活躍を\n永遠に期待し続けてる。"},
        { "location": "73/ACT"    , "narrator": "", "text": "何それひどすぎ"},
        { "location": "74/TALK"   , "narrator": "千羽鶴", "text": "えっ！？\nひどい！？"},
        { "location": "75/TALK"   , "narrator": "千羽鶴", "text": "私、そんなに酷いこと\n言ってるかしら…。"},
        { "location": "76/TALK"   , "narrator": "千羽鶴", "text": "まあ、そういう\nリアクションもあるのかと\nデータベースに入れとく。"},
        { "location": "79/TALK"   , "narrator": "千羽鶴", "text": "非常に身も蓋もない\n結論を言うと、貴方はまだ\n彼女を何も知らない。"},
        { "location": "80/TALK"   , "narrator": "千羽鶴", "text": "それ程までに、彼女の\n心の奥底は深く、そして\nそこまでの壁は厚い。"},
        { "location": "81/TALK"   , "narrator": "千羽鶴", "text": "他の子と恋ヶ崎みやびは\nあらゆる点において、\n一線を画している。"},
        { "location": "82/TALK"   , "narrator": "千羽鶴", "text": "そしてその事については、\n私も匙を投げかけている。"},
        { "location": "83/TALK"   , "narrator": "千羽鶴", "text": "だからこそ、貴方には\n是非彼女の深層世界を\n攻略して欲しい。"},
        { "location": "84/TALK"   , "narrator": "千羽鶴", "text": "難易度が高いと\n燃えることってない？"},
        { "location": "85/SEL"    , "narrator": "（選択肢）", "text": "はい"},
        { "location": "86/SEL"    , "narrator": "（選択肢）", "text": "いいえ"},
        { "location": "87/SEL"    , "narrator": "（選択肢）", "text": "千羽鶴の方が興味ある"},
        { "location": "88/ACT"    , "narrator": "", "text": "はい"},
        { "location": "89/TALK"   , "narrator": "千羽鶴", "text": "まあでも。"},
        { "location": "90/ACT"    , "narrator": "", "text": "いいえ"},
        { "location": "91/TALK"   , "narrator": "千羽鶴", "text": "そう。まあ確かに、\nそもそも彼女に興味が\n無ければ燃えないし。"},
        { "location": "92/ACT"    , "narrator": "", "text": "千羽鶴の方が興味ある"},
        { "location": "95/TALK"   , "narrator": "千羽鶴", "text": "もうここでは\n何も出ませんよ。"},
        { "location": "96/TALK"   , "narrator": "千羽鶴", "text": "そんなことより、\n恋ヶ崎みやびのココロを\n癒してあげて。"},
        { "location": "101/TALK"  , "narrator": "千羽鶴", "text": "……ほんとに。"},
        { "location": "102/TALK"  , "narrator": "千羽鶴", "text": "ホントにしつこい人。"},
        { "location": "103/TALK"  , "narrator": "千羽鶴", "text": "そんなに私の\n心の中を見たい？"},
        { "location": "104/SEL"   , "narrator": "（選択肢）", "text": "はい"},
        { "location": "105/SEL"   , "narrator": "（選択肢）", "text": "いいえ"},
        { "location": "106/ACT"   , "narrator": "", "text": "はい"},
        { "location": "107/TALK"  , "narrator": "千羽鶴", "text": "おぞましすぎて、\n現実に帰って来れなく\nなるかもしれないけど。"},
        { "location": "108/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "109/TALK"  , "narrator": "千羽鶴", "text": "まあ、それでもと言うなら\nいずれ何か見せられる日が\n来るかもしれない。"},
        { "location": "110/ACT"   , "narrator": "", "text": "いいえ"},
        { "location": "111/TALK"  , "narrator": "千羽鶴", "text": "それが正しい判断。\n私の中を覗いても、\nろくなことがないから。"},
        { "location": "113/TALK"  , "narrator": "千羽鶴", "text": "とにかく。\n貴方の実直すぎるアホに\n免じて、ご褒美あげる。"},
        { "location": "123/TALK"  , "narrator": "千羽鶴", "text": "何にしても今は、\n恋ヶ崎みやびのココロを\n癒してあげて。"},
        { "location": "127/TALK"  , "narrator": "千羽鶴", "text": "しつこいです。\nさっさと恋ヶ崎みやびの\nココロを癒してあげて。"},
        { "location": "131/TALK"  , "narrator": "千羽鶴", "text": "だから、私は\nチュートリアルキャラ。\nココロなんて存在しない。"},
        { "location": "132/TALK"  , "narrator": "千羽鶴", "text": "さっさと恋ヶ崎みやびの\nココロを癒してあげて。"},
        { "location": "136/TALK"  , "narrator": "千羽鶴", "text": "残念だけど、私は単なる\nチュートリアルキャラ。\nココロなんて存在しない。"},
        { "location": "137/TALK"  , "narrator": "千羽鶴", "text": "今は恋ヶ崎みやびの\nココロを癒すことに\n集中して。"},
        { "location": "142/TALK"  , "narrator": "千羽鶴", "text": "話を戻すけど。\n確かに彼女の心の中は\n相当常軌を逸している。"},
        { "location": "144/TALK"  , "narrator": "千羽鶴", "text": "既に現実世界でも常軌を\n逸している彼女のこと。"},
        { "location": "145/TALK"  , "narrator": "千羽鶴", "text": "これ以上は御免、とか\n思っても、それが普通の\nメンタルなんだと思う。"},
        { "location": "146/TALK"  , "narrator": "千羽鶴", "text": "けど、彼女にとっては、\nその行動自体が生きる為に\n重要な事なの。"},
        { "location": "147/TALK"  , "narrator": "千羽鶴", "text": "だから是非、\n真摯に向かい合って\n支えてあげてほしい。"},
        { "location": "148/TALK"  , "narrator": "千羽鶴", "text": "貴方と恋ヶ崎みやびに、\n素晴らしきココロの旅を。"}
    ]
}
