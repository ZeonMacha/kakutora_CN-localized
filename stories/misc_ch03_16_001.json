        "title": "Extra003 ヒメゴトチャット",
        "sub_title": "つぎはぎのお姫さま"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "000_つぎはぎのお姫さま"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "お姫様は"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "何もない王国に一人で住んでいました"},
        { "location": "34/TALK"   , "narrator": "ガブリエラ", "text": "だからお姫様は"},
        { "location": "35/TALK"   , "narrator": "ガブリエラ", "text": "色々なものを自分で作って"},
        { "location": "36/TALK"   , "narrator": "ガブリエラ", "text": "王国を豊かにしようとしました"},
        { "location": "38/SEL"    , "narrator": "", "text": "女王じゃなくて姫なの？"},
        { "location": "39/SEL"    , "narrator": "", "text": "寂しそう"},
        { "location": "40/SEL"    , "narrator": "", "text": "新作だね"},
        { "location": "41/ACT"    , "narrator": "", "text": "女王じゃなくて姫なの？"},
        { "location": "42/TALK"   , "narrator": "ガブリエラ", "text": "そうよ"},
        { "location": "43/TALK"   , "narrator": "ガブリエラ", "text": "だって姫の方が可愛いでしょう"},
        { "location": "44/TALK"   , "narrator": "ガブリエラ", "text": "だから姫なの"},
        { "location": "45/ACT"    , "narrator": "", "text": "寂しそう"},
        { "location": "46/TALK"   , "narrator": "ガブリエラ", "text": "いいのよ"},
        { "location": "48/TALK"   , "narrator": "ガブリエラ", "text": "これから幸せになるんだから"},
        { "location": "49/ACT"    , "narrator": "", "text": "新作だね"},
        { "location": "51/TALK"   , "narrator": "ガブリエラ", "text": "そうなのよ"},
        { "location": "52/TALK"   , "narrator": "ガブリエラ", "text": "思いついたばかりだから"},
        { "location": "53/TALK"   , "narrator": "ガブリエラ", "text": "最初に$marzanna$に聞いて欲しくて"},
        { "location": "55/TALK"   , "narrator": "ガブリエラ", "text": "このお姫様は"},
        { "location": "56/TALK"   , "narrator": "ガブリエラ", "text": "自分の力で王国を立派にするの"},
        { "location": "57/TALK"   , "narrator": "ガブリエラ", "text": "そういう姫なのよ"},
        { "location": "59/TALK"   , "narrator": "ガブリエラ", "text": "そういう人って"},
        { "location": "60/TALK"   , "narrator": "ガブリエラ", "text": "格好いいと思うの"},
        { "location": "61/TALK"   , "narrator": "ガブリエラ", "text": "私もそうなりたいわ"}
    ]
}
