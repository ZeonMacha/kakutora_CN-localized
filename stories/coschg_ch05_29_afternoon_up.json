        { "location": "584/TALK", "narrator": "プレイヤー", "text": "お着替えしてみよう"},
        { "location": "586/TALK", "narrator": "プレイヤー", "text": "違う服を着てほしいな"},
        { "location": "588/TALK", "narrator": "プレイヤー", "text": "よし、お着替えタイムだ！"},
        { "location": "594/TALK", "narrator": "プレイヤー", "text": "やあ"},
        { "location": "596/TALK", "narrator": "プレイヤー", "text": "こんにちは"},
        { "location": "598/TALK", "narrator": "プレイヤー", "text": "げんき？"},
        { "location": "601/TALK", "narrator": "神楽", "text": "ぴょんこを呼ぶ声"},
        { "location": "602/TALK", "narrator": "神楽", "text": "あなたはだあれ？"},
        { "location": "604/SEL" , "narrator": "", "text": "$handle$だよ"},
        { "location": "605/ACT" , "narrator": "", "text": "$handle$だよ"},
        { "location": "607/TALK", "narrator": "神楽", "text": "知ってるし"},
        { "location": "608/TALK", "narrator": "神楽", "text": "ぴょんこに用事ぴょん？"},
        { "location": "611/SEL" , "narrator": "", "text": "ちょっと着替えてほしいんだ"},
        { "location": "612/ACT" , "narrator": "", "text": "ちょっと着替えてほしいんだ"},
        { "location": "622/TALK", "narrator": "神楽", "text": "意味不明すぎ"},
        { "location": "623/TALK", "narrator": "神楽", "text": "でもまあ"},
        { "location": "624/TALK", "narrator": "神楽", "text": "優しいぴょんこは聞いてあげるのだった"},
        { "location": "626/TALK", "narrator": "神楽", "text": "は？"},
        { "location": "627/TALK", "narrator": "神楽", "text": "この服変だった？"},
        { "location": "628/TALK", "narrator": "神楽", "text": "なら着替えるけど"},
        { "location": "631/SEL" , "narrator": "", "text": "$me$が選ぶ"},
        { "location": "632/SEL" , "narrator": "", "text": "やっぱやめる"},
        { "location": "634/TALK", "narrator": "神楽", "text": "…………"},
        { "location": "637/TALK", "narrator": "神楽", "text": "リクエストないとか？"},
        { "location": "638/TALK", "narrator": "神楽", "text": "なら着ない"},
        { "location": "640/ACT" , "narrator": "", "text": "$me$が選ぶ"},
        { "location": "641/TALK", "narrator": "神楽", "text": "だと思った"},
        { "location": "642/TALK", "narrator": "神楽", "text": "どれを着てほしいと？"},
        { "location": "649/ACT" , "narrator": "", "text": "やっぱやめる"},
        { "location": "650/TALK", "narrator": "神楽", "text": "ありえネー"}
