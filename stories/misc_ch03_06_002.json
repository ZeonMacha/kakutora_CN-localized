    "entry":
    [
        { "location": "105/SCENARIO", "narrator": "", "text": "05_004_当然の心得よ"},
        { "location": "130/TALK"    , "narrator": "ガブリエラ", "text": "役割分担って大事よね"},
        { "location": "131/TALK"    , "narrator": "ガブリエラ", "text": "自分の役割をちゃんと意識すること"},
        { "location": "132/TALK"    , "narrator": "ガブリエラ", "text": "その役割をちゃんと果たすこと"},
        { "location": "135/SEL"     , "narrator": "", "text": "偉い偉い"},
        { "location": "136/SEL"     , "narrator": "", "text": "ちゃんとできてるの？"},
        { "location": "137/SEL"     , "narrator": "", "text": "$me$の隣がガブの役割"},
        { "location": "138/ACT"     , "narrator": "", "text": "偉い偉い"},
        { "location": "139/TALK"    , "narrator": "ガブリエラ", "text": "当たり前よ"},
        { "location": "140/ACT"     , "narrator": "", "text": "ちゃんとできてるの？"},
        { "location": "141/TALK"    , "narrator": "ガブリエラ", "text": "できてるに決まってるわ"},
        { "location": "142/ACT"     , "narrator": "", "text": "$me$の隣がガブの役割"},
        { "location": "144/TALK"    , "narrator": "ガブリエラ", "text": "あら"},
        { "location": "146/TALK"    , "narrator": "ガブリエラ", "text": "違うわ"},
        { "location": "147/TALK"    , "narrator": "ガブリエラ", "text": "それは逆よ？"},
        { "location": "148/TALK"    , "narrator": "ガブリエラ", "text": "私の隣にマルザンナがいるのよ"},
        { "location": "150/TALK"    , "narrator": "ガブリエラ", "text": "アーヤのサポートが私の役割"},
        { "location": "151/TALK"    , "narrator": "ガブリエラ", "text": "みやびは色んなものを探したりするのが役割"},
        { "location": "152/TALK"    , "narrator": "ガブリエラ", "text": "新人のあの子も"},
        { "location": "153/TALK"    , "narrator": "ガブリエラ", "text": "ちゃんとそういうのわかってもらわないといけないわ"},
        { "location": "155/SEL"     , "narrator": "", "text": "そういうもの？"},
        { "location": "156/SEL"     , "narrator": "", "text": "いじめはだめだよ"},
        { "location": "157/SEL"     , "narrator": "", "text": "先輩として指導すればいいよ"},
        { "location": "158/ACT"     , "narrator": "", "text": "そういうもの？"},
        { "location": "159/TALK"    , "narrator": "ガブリエラ", "text": "そういうものよ"},
        { "location": "160/ACT"     , "narrator": "", "text": "いじめはだめだよ"},
        { "location": "161/TALK"    , "narrator": "ガブリエラ", "text": "そんなことしないわよ"},
        { "location": "162/TALK"    , "narrator": "ガブリエラ", "text": "当たり前でしょう"},
        { "location": "163/ACT"     , "narrator": "", "text": "先輩として指導すればいいよ"},
        { "location": "165/TALK"    , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "166/TALK"    , "narrator": "ガブリエラ", "text": "先輩として"},
        { "location": "168/TALK"    , "narrator": "ガブリエラ", "text": "びしっと教えないとね"}
    ]
}
