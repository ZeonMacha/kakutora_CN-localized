        { "location": "7/SCENARIO", "narrator": "", "text": "022_勇者はレアガチャで当てると聞いた"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "知り合いに勇者はおらんかね"},
        { "location": "33/TALK"   , "narrator": "みやび", "text": "ちっくと用を頼みたい"},
        { "location": "35/SEL"    , "narrator": "", "text": "残念ながら"},
        { "location": "36/SEL"    , "narrator": "", "text": "探しておく"},
        { "location": "37/SEL"    , "narrator": "", "text": "実は$me$"},
        { "location": "38/ACT"    , "narrator": "", "text": "残念ながら"},
        { "location": "39/TALK"   , "narrator": "みやび", "text": "うむ"},
        { "location": "40/TALK"   , "narrator": "みやび", "text": "実に残念"},
        { "location": "41/ACT"    , "narrator": "", "text": "探しておく"},
        { "location": "42/TALK"   , "narrator": "みやび", "text": "そうか"},
        { "location": "43/TALK"   , "narrator": "みやび", "text": "期待しておこう"},
        { "location": "44/ACT"    , "narrator": "", "text": "実は$me$"},
        { "location": "46/TALK"   , "narrator": "みやび", "text": "またまた"},
        { "location": "47/TALK"   , "narrator": "みやび", "text": "それは"},
        { "location": "49/TALK"   , "narrator": "みやび", "text": "好都合"},
        { "location": "51/TALK"   , "narrator": "みやび", "text": "アキバに行きたいのだ"},
        { "location": "52/TALK"   , "narrator": "みやび", "text": "護衛を頼む"},
        { "location": "54/SEL"    , "narrator": "", "text": "なんで護衛"},
        { "location": "55/SEL"    , "narrator": "", "text": "お断りだ"},
        { "location": "56/SEL"    , "narrator": "", "text": "お守りします、みやび姫"},
        { "location": "57/ACT"    , "narrator": "", "text": "なんで護衛"},
        { "location": "58/TALK"   , "narrator": "みやび", "text": "なんで"},
        { "location": "59/TALK"   , "narrator": "みやび", "text": "聞くかね"},
        { "location": "60/ACT"    , "narrator": "", "text": "お断りだ"},
        { "location": "61/TALK"   , "narrator": "みやび", "text": "ややや"},
        { "location": "62/TALK"   , "narrator": "みやび", "text": "ツンデレさんめ"},
        { "location": "63/ACT"    , "narrator": "", "text": "お守りします、みやび姫"},
        { "location": "65/TALK"   , "narrator": "みやび", "text": "苦しゅうない"},
        { "location": "66/TALK"   , "narrator": "みやび", "text": "って"},
        { "location": "67/TALK"   , "narrator": "みやび", "text": "姫の種類が違うぞね"},
        { "location": "71/TALK"   , "narrator": "みやび", "text": "まあ"},
        { "location": "72/TALK"   , "narrator": "みやび", "text": "どっちにしても"},
        { "location": "73/TALK"   , "narrator": "みやび", "text": "相棒のことは連れて行くぞね"},
        { "location": "74/TALK"   , "narrator": "みやび", "text": "覚悟しておけ"}
    ]
