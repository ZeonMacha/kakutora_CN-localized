        { "location": "1580/ACT"     , "narrator": "", "text": "この世界の神楽を幸せにしたいんだ"},
        { "location": "1581/TALK"    , "narrator": "神楽", "text": "今話してるぴょんこ、、、"},
        { "location": "1582/TALK"    , "narrator": "神楽", "text": "そっかそっかー、、、"},
        { "location": "1585/SEL"     , "narrator": "", "text": "好きだよ"},
