    [
        { "location": "1400/SCENARIO", "narrator": "", "text": "可能性の平行線"},
        { "location": "1427/TALK"    , "narrator": "神楽", "text": "ねえ知ってた？"},
        { "location": "1428/TALK"    , "narrator": "神楽", "text": "ぴょんこには中の人がいてそれがおっさんなんだって説があるって"},
        { "location": "1430/SEL"     , "narrator": "", "text": "いやまさか……（震え声"},
        { "location": "1431/SEL"     , "narrator": "", "text": "冗談上手いね！"},
        { "location": "1432/SEL"     , "narrator": "", "text": "シュールな話だね？"},
        { "location": "1433/ACT"     , "narrator": "", "text": "いやまさか……（震え声"},
        { "location": "1434/TALK"    , "narrator": "神楽", "text": "ネットでそんな噂があるらしいぴょん、、、"},
        { "location": "1437/ACT"     , "narrator": "", "text": "冗談上手いね！"},
        { "location": "1438/TALK"    , "narrator": "神楽", "text": "面白い話なのかなｺﾚ、、、"},
        { "location": "1439/TALK"    , "narrator": "神楽", "text": "面白いならいっか～～～"},
        { "location": "1440/ACT"     , "narrator": "", "text": "シュールな話だね？"},
        { "location": "1441/TALK"    , "narrator": "神楽", "text": "何でそんな話になったんだって話だよね"},
        { "location": "1442/TALK"    , "narrator": "神楽", "text": "不思議すぎ！"},
        { "location": "1444/TALK"    , "narrator": "神楽", "text": "でも安心して"},
        { "location": "1445/TALK"    , "narrator": "神楽", "text": "ぴょんこの見た目はぴょんこだから"},
        { "location": "1446/TALK"    , "narrator": "神楽", "text": "都内の高校に通う帰国子女のキラキラＪＫだから"},
        { "location": "1448/SEL"     , "narrator": "", "text": "なんか無理してる感じがしてきた"},
        { "location": "1449/SEL"     , "narrator": "", "text": "そ、そうだよね……"},
        { "location": "1450/SEL"     , "narrator": "", "text": "中身おっさん疑惑晴れてないよ！？"},
        { "location": "1451/ACT"     , "narrator": "", "text": "なんか無理してる感じがしてきた"},
        { "location": "1452/TALK"    , "narrator": "神楽", "text": "いやまさか（ｷｮﾄﾞりつつ"},
        { "location": "1453/ACT"     , "narrator": "", "text": "そ、そうだよね……"},
        { "location": "1455/ACT"     , "narrator": "", "text": "中身おっさん疑惑晴れてないよ！？"},
        { "location": "1456/TALK"    , "narrator": "神楽", "text": "確かにそうぴょん"},
        { "location": "1457/TALK"    , "narrator": "神楽", "text": "まあ気にするな！"},
        { "location": "1459/TALK"    , "narrator": "神楽", "text": "見た目はキラキラ…っていうかゆるふわナチュラルなぴょんこ"},
        { "location": "1461/TALK"    , "narrator": "神楽", "text": "でもそれは天然っていうより努力して作り上げたナチュラルさなわけで"},
        { "location": "1462/TALK"    , "narrator": "神楽", "text": "全く身だしなみに気を遣わなかったらモッサモサなﾓｻｦﾀになる危険性"},
        { "location": "1464/SEL"     , "narrator": "", "text": "どんな神楽でもかわいいよ！"},
        { "location": "1465/SEL"     , "narrator": "", "text": "別の意味で見てみたいかも"},
        { "location": "1466/SEL"     , "narrator": "", "text": "むしろそういうの萌える"},
        { "location": "1467/ACT"     , "narrator": "", "text": "どんな神楽でもかわいいよ！"},
        { "location": "1468/TALK"    , "narrator": "神楽", "text": "ないわーいやないわー"},
        { "location": "1469/TALK"    , "narrator": "神楽", "text": "ぴょんこの努力とかそういうのガン無視だわー"},
        { "location": "1470/ACT"     , "narrator": "", "text": "別の意味で見てみたいかも"},
        { "location": "1471/TALK"    , "narrator": "神楽", "text": "特殊な性癖をお持ちのようですね？？？"},
        { "location": "1472/TALK"    , "narrator": "神楽", "text": "おまわりさんこのひとです！！！"},
        { "location": "1473/ACT"     , "narrator": "", "text": "むしろそういうの萌える"},
        { "location": "1474/TALK"    , "narrator": "神楽", "text": "うっわｗｗｗｗｗｗ"},
        { "location": "1478/TALK"    , "narrator": "神楽", "text": "いやまって"},
        { "location": "1479/TALK"    , "narrator": "神楽", "text": "ﾓｻｦﾀアーティストとかもう全然方向性違いすぎるしそんなことにはならない…ﾊｽﾞ"},
        { "location": "1480/TALK"    , "narrator": "神楽", "text": "そんなぴょんこはどの世界線にも存在しない"},
        { "location": "1482/SEL"     , "narrator": "", "text": "それはどうかな？"},
        { "location": "1483/SEL"     , "narrator": "", "text": "それを聞いて安心した"},
        { "location": "1484/SEL"     , "narrator": "", "text": "価値観が違えばそういう評価になるかも"},
        { "location": "1485/ACT"     , "narrator": "", "text": "それはどうかな？"},
        { "location": "1486/TALK"    , "narrator": "神楽", "text": "えっえっ"},
        { "location": "1487/TALK"    , "narrator": "神楽", "text": "そんなﾏｻｶ"},
        { "location": "1488/ACT"     , "narrator": "", "text": "それを聞いて安心した"},
        { "location": "1489/TALK"    , "narrator": "神楽", "text": "ぴょんこ自身も安心したぴょん♪"},
        { "location": "1490/ACT"     , "narrator": "", "text": "価値観が違えばそういう評価になるかも"},
        { "location": "1491/TALK"    , "narrator": "神楽", "text": "ぴょんこの今の方向性がモサいって評価される世界観、、、"},
        { "location": "1492/TALK"    , "narrator": "神楽", "text": "そういう世界もあるかもね確かに"},
        { "location": "1494/TALK"    , "narrator": "神楽", "text": "ﾓｻぴょんこが存在するとするならばそれはパラダイムシフト？？？"},
        { "location": "1496/SEL"     , "narrator": "", "text": "いや意味わからんし"},
        { "location": "1497/SEL"     , "narrator": "", "text": "パラダイムシフトって何"},
        { "location": "1498/SEL"     , "narrator": "", "text": "どの世界線でも神楽は神楽だよ"},
        { "location": "1499/ACT"     , "narrator": "", "text": "いや意味わからんし"},
        { "location": "1500/TALK"    , "narrator": "神楽", "text": "厨二ワードｶｺｲｲかな～って"},
        { "location": "1501/ACT"     , "narrator": "", "text": "パラダイムシフトって何"},
        { "location": "1502/TALK"    , "narrator": "神楽", "text": "それまでの認識や思想、価値観などが劇的に変化すること"},
        { "location": "1503/ACT"     , "narrator": "", "text": "どの世界線でも神楽は神楽だよ"},
        { "location": "1504/TALK"    , "narrator": "神楽", "text": "言いたいことはわかるけど"},
        { "location": "1505/TALK"    , "narrator": "神楽", "text": "ちょっと都合よすぎー"},
        { "location": "1507/TALK"    , "narrator": "神楽", "text": "別の例えをしてみるぴょん"},
        { "location": "1508/TALK"    , "narrator": "神楽", "text": "ぴょんこは今女子として生きているけど"},
        { "location": "1509/TALK"    , "narrator": "神楽", "text": "実は男子だったら"},
        { "location": "1510/TALK"    , "narrator": "神楽", "text": "$handle$はどうする？？？"},
        { "location": "1512/SEL"     , "narrator": "", "text": "萌える"},
        { "location": "1513/SEL"     , "narrator": "", "text": "萎える"},
        { "location": "1514/SEL"     , "narrator": "", "text": "覚悟する"},
        { "location": "1515/SEL"     , "narrator": "", "text": "途方に暮れる"},
        { "location": "1516/SEL"     , "narrator": "", "text": "運営に報告する"},
        { "location": "1517/ACT"     , "narrator": "", "text": "萌える"},
        { "location": "1518/TALK"    , "narrator": "神楽", "text": "そうなのかー"},
        { "location": "1519/TALK"    , "narrator": "神楽", "text": "予想外過ぎる反応、、、"},
        { "location": "1520/ACT"     , "narrator": "", "text": "萎える"},
        { "location": "1521/TALK"    , "narrator": "神楽", "text": "むー"},
        { "location": "1522/TALK"    , "narrator": "神楽", "text": "そうなっちゃうかー"},
        { "location": "1523/ACT"     , "narrator": "", "text": "覚悟する"},
        { "location": "1524/TALK"    , "narrator": "神楽", "text": "何を！？！？"},
        { "location": "1525/ACT"     , "narrator": "", "text": "途方に暮れる"},
        { "location": "1526/TALK"    , "narrator": "神楽", "text": "あーまーそうかもねー"},
        { "location": "1528/TALK"    , "narrator": "神楽", "text": "確かにそうかも～"},
        { "location": "1529/ACT"     , "narrator": "", "text": "運営に報告する"},
        { "location": "1530/TALK"    , "narrator": "神楽", "text": "運営って誰？"},
        { "location": "1531/TALK"    , "narrator": "神楽", "text": "っていうかどこ？？？"},
        { "location": "1534/SEL"     , "narrator": "", "text": "冗談で言ってるんだよね？"},
        { "location": "1535/SEL"     , "narrator": "", "text": "男の娘だったの！？"},
        { "location": "1536/SEL"     , "narrator": "", "text": "性別が違っても…いやちょっと待って…"},
        { "location": "1537/ACT"     , "narrator": "", "text": "冗談で言ってるんだよね？"},
        { "location": "1538/TALK"    , "narrator": "神楽", "text": "冗談っていうか"},
        { "location": "1539/TALK"    , "narrator": "神楽", "text": "可能性の話なだけ"},
        { "location": "1540/ACT"     , "narrator": "", "text": "男の娘だったの！？"},
        { "location": "1541/TALK"    , "narrator": "神楽", "text": "違うし！！！"},
        { "location": "1542/ACT"     , "narrator": "", "text": "性別が違っても…いやちょっと待って…"},
        { "location": "1543/TALK"    , "narrator": "神楽", "text": "何か可能性を探ってる？？？"},
        { "location": "1544/TALK"    , "narrator": "神楽", "text": "それはそれで興味深いけど"},
        { "location": "1545/TALK"    , "narrator": "神楽", "text": "ぴょんこは女子ですから～～～～！！！"},
        { "location": "1547/TALK"    , "narrator": "神楽", "text": "あーもー"},
        { "location": "1549/TALK"    , "narrator": "神楽", "text": "変な話になっちゃったぴょん、、、"},
        { "location": "1551/SEL"     , "narrator": "", "text": "神楽が振ってきたんだよね？"},
        { "location": "1552/SEL"     , "narrator": "", "text": "いつも通りな感じだけど…"},
        { "location": "1553/SEL"     , "narrator": "", "text": "そんなことより愛してるって伝えたい！"},
        { "location": "1554/ACT"     , "narrator": "", "text": "神楽が振ってきたんだよね？"},
        { "location": "1555/TALK"    , "narrator": "神楽", "text": "そうだっけ？"},
        { "location": "1557/ACT"     , "narrator": "", "text": "いつも通りな感じだけど…"},
        { "location": "1558/TALK"    , "narrator": "神楽", "text": "$handle$にとってのぴょんこって、、、"},
        { "location": "1559/TALK"    , "narrator": "神楽", "text": "こういう人間なのｶｰ！"},
        { "location": "1560/ACT"     , "narrator": "", "text": "そんなことより愛してるって伝えたい！"},
        { "location": "1562/TALK"    , "narrator": "神楽", "text": "ぴょんこﾄﾞｷﾄﾞｷなりー♪"},
        { "location": "1565/SEL"     , "narrator": "", "text": "えーと"},
        { "location": "1566/ACT"     , "narrator": "", "text": "えーと"},
        { "location": "1568/TALK"    , "narrator": "神楽", "text": "んあ？？？？"},
        { "location": "1571/SEL"     , "narrator": "", "text": "今の神楽が一番いいと思う"},
        { "location": "1572/SEL"     , "narrator": "", "text": "神楽は神楽でいてほしいな"},
