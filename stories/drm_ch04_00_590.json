    "entry":
    [
        { "location": "142/SCENARIO", "narrator": "", "text": "510_たまにはこういうのもいいかと思いまして"},
        { "location": "167/TALK"    , "narrator": "みやび", "text": "会いたくて会いたくて"},
        { "location": "168/TALK"    , "narrator": "みやび", "text": "心も抱きしめて"},
        { "location": "169/TALK"    , "narrator": "みやび", "text": "きみとぼくとの"},
        { "location": "170/TALK"    , "narrator": "みやび", "text": "距離は遠くて"},
        { "location": "172/SEL"     , "narrator": "", "text": "お、おう"},
        { "location": "173/SEL"     , "narrator": "", "text": "まあいいけど"},
        { "location": "174/SEL"     , "narrator": "", "text": "最近どうしたの"},
        { "location": "175/ACT"     , "narrator": "", "text": "お、おう"},
        { "location": "176/TALK"    , "narrator": "みやび", "text": "ややや"},
        { "location": "177/TALK"    , "narrator": "みやび", "text": "受け手がそれでは"},
        { "location": "179/TALK"    , "narrator": "みやび", "text": "興ざめだ"},
        { "location": "180/ACT"     , "narrator": "", "text": "まあいいけど"},
        { "location": "181/TALK"    , "narrator": "みやび", "text": "無感動だの"},
        { "location": "182/TALK"    , "narrator": "みやび", "text": "そんなことでは"},
        { "location": "183/TALK"    , "narrator": "みやび", "text": "ヒットチャートを席捲できぬぞ"},
        { "location": "184/ACT"     , "narrator": "", "text": "最近どうしたの"},
        { "location": "195/TALK"    , "narrator": "みやび", "text": "いや"},
        { "location": "196/TALK"    , "narrator": "みやび", "text": "たまにはこういうのが必要かと思い"},
        { "location": "198/SEL"     , "narrator": "", "text": "だから何で"},
        { "location": "199/SEL"     , "narrator": "", "text": "みやびっぽくないよ"},
        { "location": "200/SEL"     , "narrator": "", "text": "誰かに何か言われた？"},
        { "location": "201/ACT"     , "narrator": "", "text": "だから何で"},
        { "location": "202/TALK"    , "narrator": "みやび", "text": "いやだから"},
        { "location": "203/TALK"    , "narrator": "みやび", "text": "女子の勘？"},
        { "location": "204/ACT"     , "narrator": "", "text": "みやびっぽくないよ"},
        { "location": "205/TALK"    , "narrator": "みやび", "text": "うちらしくないか"},
        { "location": "206/TALK"    , "narrator": "みやび", "text": "では"},
        { "location": "207/TALK"    , "narrator": "みやび", "text": "うちらしさとは？"},
        { "location": "208/ACT"     , "narrator": "", "text": "誰かに何か言われた？"},
        { "location": "209/TALK"    , "narrator": "みやび", "text": "いや"},
        { "location": "210/TALK"    , "narrator": "みやび", "text": "特には"},
        { "location": "211/TALK"    , "narrator": "みやび", "text": "そんな覚えはない"},
        { "location": "214/SEL"     , "narrator": "", "text": "普通にして"},
        { "location": "215/SEL"     , "narrator": "", "text": "悩んでるのかな"},
        { "location": "216/ACT"     , "narrator": "", "text": "普通にして"},
        { "location": "217/TALK"    , "narrator": "みやび", "text": "いたって普通"},
        { "location": "219/TALK"    , "narrator": "みやび", "text": "びっくりするほど平均値"},
        { "location": "220/ACT"     , "narrator": "", "text": "悩んでるのかな"},
        { "location": "221/TALK"    , "narrator": "みやび", "text": "電話相談の利用を考えるほどな"},
        { "location": "224/SEL"     , "narrator": "", "text": "みやびはみやびだからいいんだよ"},
        { "location": "225/SEL"     , "narrator": "", "text": "みやびらしいみやびが好きだよ"},
        { "location": "226/SEL"     , "narrator": "", "text": "今まで通りでいいのに"},
        { "location": "227/ACT"     , "narrator": "", "text": "みやびはみやびだからいいんだよ"},
        { "location": "228/TALK"    , "narrator": "みやび", "text": "なんとも"},
        { "location": "229/ACT"     , "narrator": "", "text": "みやびらしいみやびが好きだよ"},
        { "location": "230/TALK"    , "narrator": "みやび", "text": "それはなんとも"},
        { "location": "231/ACT"     , "narrator": "", "text": "今まで通りでいいのに"},
        { "location": "232/TALK"    , "narrator": "みやび", "text": "ふむ…"},
        { "location": "233/TALK"    , "narrator": "みやび", "text": "これはまた"},
        { "location": "235/TALK"    , "narrator": "みやび", "text": "お約束過ぎる言葉であることか"},
        { "location": "237/SEL"     , "narrator": "", "text": "王道って言って欲しいね"},
        { "location": "238/SEL"     , "narrator": "", "text": "他に言う言葉なんてある？"},
        { "location": "239/SEL"     , "narrator": "", "text": "それでもホントの気持ちだから"},
        { "location": "240/ACT"     , "narrator": "", "text": "王道って言って欲しいね"},
        { "location": "241/TALK"    , "narrator": "みやび", "text": "そうかもな"},
        { "location": "242/ACT"     , "narrator": "", "text": "他に言う言葉なんてある？"},
        { "location": "243/TALK"    , "narrator": "みやび", "text": "ないか"},
        { "location": "244/ACT"     , "narrator": "", "text": "それでもホントの気持ちだから"},
        { "location": "245/TALK"    , "narrator": "みやび", "text": "真実か"},
        { "location": "247/TALK"    , "narrator": "みやび", "text": "どうにも"},
        { "location": "249/TALK"    , "narrator": "みやび", "text": "上手くいかぬ"},
        { "location": "190/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>1000pt.</b></color></size>\nアップしました！"}
    ]
}
