{
    "dir": "dramatics/daydra/drm_ch03_00_790.js",
    "type": "Episode",
    "info": {
        "story_id": "3079",
        "cid": "gabriella",
        "title": "らぶとーく 第81話",
        "sub_title": "本物の女王様とあなたの隣のおひめさま"
    },
    "entry":
    [
        { "location": "913/TALK" , "narrator": "ガブリエラ", "text": "意外と開けてる\n感じなのね。"},
        { "location": "915/TALK" , "narrator": "ガブリエラ", "text": "もっと山奥に\nひっそりあるのかと\n思ってたわ…。"},
        { "location": "917/TALK" , "narrator": "ガブリエラ", "text": "中はやっぱり\n暗いけど…。"},
        { "location": "919/TALK" , "narrator": "ガブリエラ", "text": "$handle$は\n来たことあるのかしら。\nこの鍾乳洞に。"},
        { "location": "920/SEL"  , "narrator": "", "text": "あるよ"},
        { "location": "921/SEL"  , "narrator": "", "text": "ないよ"},
        { "location": "922/SEL"  , "narrator": "", "text": "忘れた"},
        { "location": "923/ACT"  , "narrator": "", "text": "あるよ"},
        { "location": "925/TALK" , "narrator": "ガブリエラ", "text": "そうなのね。"},
        { "location": "926/ACT"  , "narrator": "", "text": "ないよ"},
        { "location": "928/TALK" , "narrator": "ガブリエラ", "text": "あたしと一緒ね。"},
        { "location": "929/ACT"  , "narrator": "", "text": "忘れた"},
        { "location": "931/TALK" , "narrator": "ガブリエラ", "text": "そんなことあるの？"},
        { "location": "934/TALK" , "narrator": "ガブリエラ", "text": "ヴィエリチカに\n雰囲気が似てるかもって\n思って選んだけど。"},
        { "location": "935/TALK" , "narrator": "ガブリエラ", "text": "意外と天井も低いし\n湿っぽい感じ。"},
        { "location": "936/TALK" , "narrator": "ガブリエラ", "text": "足元もなんだか\n滑るし。"},
        { "location": "938/TALK" , "narrator": "ガブリエラ", "text": "やっぱり岩塩坑とは\n違うのね。"},
        { "location": "939/SEL"  , "narrator": "", "text": "そりゃそうだ"},
        { "location": "940/SEL"  , "narrator": "", "text": "がっかりしちゃった？"},
        { "location": "941/SEL"  , "narrator": "", "text": "これはこれで楽しいよ"},
        { "location": "942/ACT"  , "narrator": "", "text": "そりゃそうだ"},
        { "location": "943/TALK" , "narrator": "ガブリエラ", "text": "当たり前といえば\n当たり前よね。"},
        { "location": "944/ACT"  , "narrator": "", "text": "がっかりしちゃった？"},
        { "location": "945/TALK" , "narrator": "ガブリエラ", "text": "そういうわけじゃ\nないけど。"},
        { "location": "946/ACT"  , "narrator": "", "text": "これはこれで楽しいよ"},
        { "location": "947/TALK" , "narrator": "ガブリエラ", "text": "そうね。\n確かに興味深いわ。"},
        { "location": "949/TALK" , "narrator": "ガブリエラ", "text": "鍾乳洞って\n何万年もかけて\nこの形になったのよね。"},
        { "location": "950/SEL"  , "narrator": "", "text": "そうだね"},
        { "location": "951/SEL"  , "narrator": "", "text": "実は$me$が作った"},
        { "location": "952/ACT"  , "narrator": "", "text": "そうだね"},
        { "location": "953/TALK" , "narrator": "ガブリエラ", "text": "すごいわよね。"},
        { "location": "954/ACT"  , "narrator": "", "text": "実は$me$が作った"},
        { "location": "955/TALK" , "narrator": "ガブリエラ", "text": "またまた\n冗談ばっかり。"},
        { "location": "956/SEL"  , "narrator": "", "text": "本当なのに"},
        { "location": "957/SEL"  , "narrator": "", "text": "信じてくれないの？"},
        { "location": "958/SEL"  , "narrator": "", "text": "嘘だって\n思ってるんだ"},
        { "location": "959/ACT"  , "narrator": "", "text": "本当なのに"},
        { "location": "960/ACT"  , "narrator": "", "text": "信じてくれないの？"},
        { "location": "961/TALK" , "narrator": "ガブリエラ", "text": "そんなこと\nないでしょう？"},
        { "location": "962/SEL"  , "narrator": "", "text": "どうかな？"},
        { "location": "963/SEL"  , "narrator": "", "text": "ばれたか"},
        { "location": "964/ACT"  , "narrator": "", "text": "どうかな？"},
        { "location": "965/TALK" , "narrator": "ガブリエラ", "text": "…嘘よね？"},
        { "location": "966/ACT"  , "narrator": "", "text": "ばれたか"},
        { "location": "967/TALK" , "narrator": "ガブリエラ", "text": "やっぱり！"},
        { "location": "969/ACT"  , "narrator": "", "text": "嘘だって\n思ってるんだ"},
        { "location": "970/TALK" , "narrator": "ガブリエラ", "text": "だって嘘でしょう？"},
        { "location": "971/SEL"  , "narrator": "", "text": "違うのに…"},
        { "location": "972/SEL"  , "narrator": "", "text": "まあそうだけど"},
        { "location": "973/ACT"  , "narrator": "", "text": "違うのに…"},
        { "location": "974/TALK" , "narrator": "ガブリエラ", "text": "騙されないんだから。"},
        { "location": "975/ACT"  , "narrator": "", "text": "まあそうだけど"},
        { "location": "977/TALK" , "narrator": "ガブリエラ", "text": "そうだって思ってたわ。"},
        { "location": "979/TALK" , "narrator": "ガブリエラ", "text": "…もしかして\n$handle$はあたしを\n笑わせたかったの？"},
        { "location": "980/SEL"  , "narrator": "", "text": "まあね"},
        { "location": "981/SEL"  , "narrator": "", "text": "だってハネムーンだから"},
        { "location": "982/SEL"  , "narrator": "", "text": "それも愛でしょ"},
        { "location": "983/ACT"  , "narrator": "", "text": "まあね"},
        { "location": "984/TALK" , "narrator": "ガブリエラ", "text": "冗談の下手な人ね。"},
        { "location": "985/TALK" , "narrator": "ガブリエラ", "text": "そういうところも\n好きだけど…。"},
        { "location": "986/ACT"  , "narrator": "", "text": "だってハネムーンだから"},
        { "location": "987/TALK" , "narrator": "ガブリエラ", "text": "関係あるのかしら？"},
        { "location": "988/TALK" , "narrator": "ガブリエラ", "text": "でもケンカばかりより\nいいわよね。"},
        { "location": "989/ACT"  , "narrator": "", "text": "それも愛でしょ"},
        { "location": "991/TALK" , "narrator": "ガブリエラ", "text": "そうかしら？"},
        { "location": "992/TALK" , "narrator": "ガブリエラ", "text": "$handle$の愛は\n独特なのね。"},
        { "location": "996/TALK" , "narrator": "ガブリエラ", "text": "時々小銭が置いてある\nところがあるのね。"},
        { "location": "997/TALK" , "narrator": "ガブリエラ", "text": "お供えみたいな\n感じなのかしら。"},
        { "location": "998/TALK" , "narrator": "ガブリエラ", "text": "一見ただの\n鍾乳石みたいだけど。"},
        { "location": "999/TALK" , "narrator": "ガブリエラ", "text": "何か謂われでも\nあるのかしらね。"},
        { "location": "1000/SEL" , "narrator": "", "text": "なんだろうね"},
        { "location": "1001/SEL" , "narrator": "", "text": "身代わり的なアレ"},
        { "location": "1002/SEL" , "narrator": "", "text": "恋の成就祈願かも"},
        { "location": "1003/ACT" , "narrator": "", "text": "なんだろうね"},
        { "location": "1004/TALK", "narrator": "ガブリエラ", "text": "$handle$も\nわからないのね。"},
        { "location": "1005/ACT" , "narrator": "", "text": "身代わり的なアレ"},
        { "location": "1006/TALK", "narrator": "ガブリエラ", "text": "お地蔵様的な？"},
        { "location": "1007/ACT" , "narrator": "", "text": "恋の成就祈願かも"},
        { "location": "1008/TALK", "narrator": "ガブリエラ", "text": "それだったら\nあたしはもう\n必要ないわね。"},
        { "location": "1011/TALK", "narrator": "ガブリエラ", "text": "あ。\nでもね。"},
        { "location": "1012/TALK", "narrator": "ガブリエラ", "text": "確かこの先に\n祭壇があるって\n聞いてるわ。"},
        { "location": "1013/SEL" , "narrator": "", "text": "呪術的な？"},
        { "location": "1014/SEL" , "narrator": "", "text": "民間信仰かな"},
        { "location": "1015/SEL" , "narrator": "", "text": "そういう雰囲気は\nちょっとあるよね"},
        { "location": "1016/ACT" , "narrator": "", "text": "呪術的な？"},
        { "location": "1017/TALK", "narrator": "ガブリエラ", "text": "怖い話なんかじゃ\nないわよ？！"},
        { "location": "1018/ACT" , "narrator": "", "text": "民間信仰かな"},
        { "location": "1019/TALK", "narrator": "ガブリエラ", "text": "それこそお地蔵様\nみたいなものって\nことかしら。"},
        { "location": "1020/ACT" , "narrator": "", "text": "そういう雰囲気は\nちょっとあるよね"},
        { "location": "1021/TALK", "narrator": "ガブリエラ", "text": "この中がって\nことかしら。"},
        { "location": "1023/TALK", "narrator": "ガブリエラ", "text": "それでね。\nせっかくだもの。"},
        { "location": "1024/TALK", "narrator": "ガブリエラ", "text": "日本の神様に\nあたしたちのこと\n報告したいの。"},
        { "location": "1025/SEL" , "narrator": "", "text": "わかった"},
        { "location": "1026/SEL" , "narrator": "", "text": "そのために来たのかー"},
        { "location": "1027/SEL" , "narrator": "", "text": "祝ってもらおう"},
        { "location": "1028/ACT" , "narrator": "", "text": "わかった"},
        { "location": "1029/TALK", "narrator": "ガブリエラ", "text": "なんだか堅くない？"},
        { "location": "1030/ACT" , "narrator": "", "text": "そのために来たのかー"},
        { "location": "1031/TALK", "narrator": "ガブリエラ", "text": "それだけじゃないけど。"},
        { "location": "1032/ACT" , "narrator": "", "text": "祝ってもらおう"},
        { "location": "1033/TALK", "narrator": "ガブリエラ", "text": "そうね。\nお祝いしてもらうのね。"},
        { "location": "1035/TALK", "narrator": "ガブリエラ", "text": "こういう時って\n神社みたいに\nすればいいのかしら？"},
        { "location": "1036/SEL" , "narrator": "", "text": "どうだろう？"},
        { "location": "1037/SEL" , "narrator": "", "text": "手を合わせるだけで\nいいんじゃない"},
        { "location": "1038/SEL" , "narrator": "", "text": "神社じゃないから…"},
        { "location": "1039/ACT" , "narrator": "", "text": "どうだろう？"},
        { "location": "1040/TALK", "narrator": "ガブリエラ", "text": "どうなのかしら？"},
        { "location": "1041/ACT" , "narrator": "", "text": "手を合わせるだけで\nいいんじゃない"},
        { "location": "1042/TALK", "narrator": "ガブリエラ", "text": "いいかしら？"},
        { "location": "1043/ACT" , "narrator": "", "text": "神社じゃないから…"},
        { "location": "1044/TALK", "narrator": "ガブリエラ", "text": "そういえばそうね。"},
        { "location": "1047/TALK", "narrator": "ガブリエラ", "text": "えっとじゃあ\n手を合わせる\nだけにするわね。"},
        { "location": "1057/TALK", "narrator": "透明ガブリエラ", "text": "……。"},
        { "location": "1060/TALK", "narrator": "透明ガブリエラ", "text": "ふう。"},
        { "location": "1061/SEL" , "narrator": "", "text": "ずいぶん長い間\nお祈りしてたね"},
        { "location": "1062/SEL" , "narrator": "", "text": "ラブラブ報告\nしすぎじゃない？"},
        { "location": "1063/SEL" , "narrator": "", "text": "$me$も色々\n報告したよ"},
        { "location": "1064/ACT" , "narrator": "", "text": "ずいぶん長い間\nお祈りしてたね"},
        { "location": "1065/TALK", "narrator": "透明ガブリエラ", "text": "そうね。"},
        { "location": "1066/ACT" , "narrator": "", "text": "ラブラブ報告\nしすぎじゃない？"},
        { "location": "1067/TALK", "narrator": "透明ガブリエラ", "text": "そんなことないわよ。"},
        { "location": "1068/ACT" , "narrator": "", "text": "$me$も色々\n報告したよ"},
        { "location": "1069/TALK", "narrator": "透明ガブリエラ", "text": "うれしいわ。"},
        { "location": "1072/TALK", "narrator": "透明ガブリエラ", "text": "……。"},
        { "location": "1073/TALK", "narrator": "透明ガブリエラ", "text": "ねえ。\n真面目な話を\nしていいかしら。"},
        { "location": "1074/TALK", "narrator": "透明ガブリエラ", "text": "あたしね、時々\n思うのよ。"},
        { "location": "1075/TALK", "narrator": "透明ガブリエラ", "text": "日本に来たのは\n偶然なのかしら\n運命なのかしらって。"},
        { "location": "1076/TALK", "narrator": "透明ガブリエラ", "text": "もちろん\n決めたのはあたし。"},
        { "location": "1077/TALK", "narrator": "透明ガブリエラ", "text": "今を作ったのは\nあたし。"},
        { "location": "1078/TALK", "narrator": "透明ガブリエラ", "text": "だけどアーヤの試合を\n見なかったら？\n留学の話がなかったら？"},
        { "location": "1079/TALK", "narrator": "透明ガブリエラ", "text": "今あたしはここに\nいないかも\nしれないのよ。"},
        { "location": "1080/TALK", "narrator": "透明ガブリエラ", "text": "$handle$を\n知ることもなかった\nかもしれないのよ。"},
        { "location": "1081/SEL" , "narrator": "", "text": "そんなことには\n耐えられないな"},
        { "location": "1082/SEL" , "narrator": "", "text": "その可能性は\n考えたくない…"},
        { "location": "1083/SEL" , "narrator": "", "text": "別の世界で幸せになって"},
        { "location": "1084/ACT" , "narrator": "", "text": "そんなことには\n耐えられないな"},
        { "location": "1085/TALK", "narrator": "透明ガブリエラ", "text": "…そうよね。"},
        { "location": "1086/ACT" , "narrator": "", "text": "その可能性は\n考えたくない…"},
        { "location": "1087/TALK", "narrator": "透明ガブリエラ", "text": "そうでしょう？"},
        { "location": "1088/ACT" , "narrator": "", "text": "別の世界で幸せになって"},
        { "location": "1091/TALK", "narrator": "透明ガブリエラ", "text": "え！？！？！\nそんなこと\n冗談でも言わないで！"},
        { "location": "1094/TALK", "narrator": "透明ガブリエラ", "text": "そう考えると\nケンカなんてしてる\n時間なんてないのに。"},
        { "location": "1096/TALK", "narrator": "透明ガブリエラ", "text": "あたしやっぱり\nまだ子供なのね…。"},
        { "location": "1097/SEL" , "narrator": "", "text": "誰だってそうだよ"},
        { "location": "1098/SEL" , "narrator": "", "text": "いつもご機嫌でなんて\nいられないよ"},
        { "location": "1099/SEL" , "narrator": "", "text": "そこが\nかわいいとこだから！"},
        { "location": "1100/ACT" , "narrator": "", "text": "誰だってそうだよ"},
        { "location": "1101/TALK", "narrator": "透明ガブリエラ", "text": "…そうよね…。"},
        { "location": "1102/ACT" , "narrator": "", "text": "いつもご機嫌でなんて\nいられないよ"},
        { "location": "1103/TALK", "narrator": "透明ガブリエラ", "text": "人生ってやっぱり\nうまくいかないわ。"},
        { "location": "1104/ACT" , "narrator": "", "text": "そこが\nかわいいとこだから！"},
        { "location": "1106/TALK", "narrator": "透明ガブリエラ", "text": "もう！\n調子いいんだから！"},
        { "location": "1109/TALK", "narrator": "透明ガブリエラ", "text": "急には無理だけど。"},
        { "location": "1110/TALK", "narrator": "透明ガブリエラ", "text": "あたしがんばって\n大人になるわ。"},
        { "location": "1111/TALK", "narrator": "透明ガブリエラ", "text": "$handle$のこと\nちゃんと守ったり\nできるような。"},
        { "location": "1112/SEL" , "narrator": "", "text": "守るのは$me$の\n役目だから！"},
        { "location": "1113/SEL" , "narrator": "", "text": "そのままでいいのに\nお姫様"},
        { "location": "1114/SEL" , "narrator": "", "text": "わがまま女王様な\nガブリエラも萌える"},
        { "location": "1115/ACT" , "narrator": "", "text": "守るのは$me$の\n役目だから！"},
        { "location": "1117/TALK", "narrator": "透明ガブリエラ", "text": "…ありがとう。"},
        { "location": "1118/ACT" , "narrator": "", "text": "そのままでいいのに\nお姫様"},
        { "location": "1119/TALK", "narrator": "透明ガブリエラ", "text": "そう言われるのも\nうれしいわ。"},
        { "location": "1120/ACT" , "narrator": "", "text": "わがまま女王様な\nガブリエラも萌える"},
        { "location": "1121/TALK", "narrator": "透明ガブリエラ", "text": "えっ！？\nそういうのが\n好きなの！？"},
        { "location": "1123/TALK", "narrator": "透明ガブリエラ", "text": "永遠なんて\nどこにもないのかも\nしれないけど。"},
        { "location": "1124/TALK", "narrator": "透明ガブリエラ", "text": "$handle$と\nあたしは永遠だって\n信じてる。"},
        { "location": "1125/TALK", "narrator": "透明ガブリエラ", "text": "これまでありがとう。\nこれからも\nよろしくね。"},
        { "location": "1126/SEL" , "narrator": "", "text": "うん"},
        { "location": "1127/SEL" , "narrator": "", "text": "この瞬間が永遠だよ"},
        { "location": "1128/SEL" , "narrator": "", "text": "なんだか泣きそう"},
        { "location": "1129/ACT" , "narrator": "", "text": "うん"},
        { "location": "1130/TALK", "narrator": "透明ガブリエラ", "text": "もうちょっと改まった\n言い方をできないの\nかしら？"},
        { "location": "1131/ACT" , "narrator": "", "text": "この瞬間が永遠だよ"},
        { "location": "1132/TALK", "narrator": "透明ガブリエラ", "text": "…詩みたいね。"},
        { "location": "1133/ACT" , "narrator": "", "text": "なんだか泣きそう"},
        { "location": "1134/TALK", "narrator": "透明ガブリエラ", "text": "そんなこと言われたら\nあたしもちょっと\n泣いちゃいそう。"},
        { "location": "1136/TALK", "narrator": "透明ガブリエラ", "text": "毎日を繰り返して\n永遠にしましょう\nあたしたち……。"},
        { "location": "1153/TALK", "narrator": "ガブリエラ", "text": "いつかポーランドにも\n行きたいの。"},
        { "location": "1154/TALK", "narrator": "ガブリエラ", "text": "$handle$と\n二人で。"},
        { "location": "1155/SEL" , "narrator": "", "text": "帰るんじゃないの？"},
        { "location": "1156/SEL" , "narrator": "", "text": "挨拶もしなきゃだね"},
        { "location": "1157/SEL" , "narrator": "", "text": "色々案内して"},
        { "location": "1158/ACT" , "narrator": "", "text": "帰るんじゃないの？"},
        { "location": "1159/TALK", "narrator": "ガブリエラ", "text": "そう言われれば\nそうだわ。"},
        { "location": "1161/TALK", "narrator": "ガブリエラ", "text": "でもなんだか\nそう言った方が\nしっくりくる気がしたの。"},
        { "location": "1162/ACT" , "narrator": "", "text": "挨拶もしなきゃだね"},
        { "location": "1163/TALK", "narrator": "ガブリエラ", "text": "…そうね。"},
        { "location": "1164/TALK", "narrator": "ガブリエラ", "text": "とにかく頑固だから。\nお父様は。"},
        { "location": "1165/TALK", "narrator": "ガブリエラ", "text": "それを考えると\n頭が痛いわ……。"},
        { "location": "1166/ACT" , "narrator": "", "text": "色々案内して"},
        { "location": "1167/TALK", "narrator": "ガブリエラ", "text": "観光地なんかは\nあんまり案内\nできないけど。"},
        { "location": "1168/TALK", "narrator": "ガブリエラ", "text": "あたしが育った\nワルシャワなら\n任せて。"},
        { "location": "1171/TALK", "narrator": "ガブリエラ", "text": "$handle$と\nしたいことが\nいっぱいあるの。"},
        { "location": "1173/TALK", "narrator": "ガブリエラ", "text": "自分でも不思議な\nくらいよ。"},
        { "location": "1174/TALK", "narrator": "ガブリエラ", "text": "何でこんなに\n色々思いついて\nしまうのかしら。"},
        { "location": "1175/SEL" , "narrator": "", "text": "一生分だからじゃない？"},
        { "location": "1176/SEL" , "narrator": "", "text": "欲張りさんだね"},
        { "location": "1177/SEL" , "narrator": "", "text": "全部叶えるよ"},
        { "location": "1178/ACT" , "narrator": "", "text": "一生分だからじゃない？"},
        { "location": "1180/TALK", "narrator": "ガブリエラ", "text": "一生……。"},
        { "location": "1181/TALK", "narrator": "ガブリエラ", "text": "一生ずっと\n一緒なのよね。"},
        { "location": "1182/ACT" , "narrator": "", "text": "欲張りさんだね"},
        { "location": "1184/TALK", "narrator": "ガブリエラ", "text": "そうかもしれないわ。"},
        { "location": "1185/TALK", "narrator": "ガブリエラ", "text": "そういうのは\n嫌いかしら…？"},
        { "location": "1186/ACT" , "narrator": "", "text": "全部叶えるよ"},
        { "location": "1188/TALK", "narrator": "ガブリエラ", "text": "さすがね\n$handle$。"},
        { "location": "1190/TALK", "narrator": "ガブリエラ", "text": "あたし楽しみに\nしてるから。"},
        { "location": "1191/TALK", "narrator": "ガブリエラ", "text": "ちゃんと全部\n叶えてよね。"},
        { "location": "1195/TALK", "narrator": "ガブリエラ", "text": "今日帰って\n$handle$に\nおやすみなさいを言って。"},
        { "location": "1196/TALK", "narrator": "ガブリエラ", "text": "それから朝が来たら\nおはようって言うの。"},
        { "location": "1197/TALK", "narrator": "ガブリエラ", "text": "今までも同じことを\nしてたはずなのに。"},
        { "location": "1198/TALK", "narrator": "ガブリエラ", "text": "今までと全然違うことを\nするみたいな気持ちなの。"},
        { "location": "1199/TALK", "narrator": "ガブリエラ", "text": "慣れてるはずなのに\nなんだかすごく\nドキドキしてるの。"},
        { "location": "1200/SEL" , "narrator": "", "text": "$me$もだよ"},
        { "location": "1201/SEL" , "narrator": "", "text": "結婚して初めての\n夜だもの"},
        { "location": "1202/SEL" , "narrator": "", "text": "かっわいいなあもう！"},
        { "location": "1203/ACT" , "narrator": "", "text": "$me$もだよ"},
        { "location": "1204/TALK", "narrator": "ガブリエラ", "text": "やっぱりそうよね。"},
        { "location": "1206/TALK", "narrator": "ガブリエラ", "text": "よかった、\nおんなじ気持ちで。"},
        { "location": "1207/ACT" , "narrator": "", "text": "結婚して初めての\n夜だもの"},
        { "location": "1208/TALK", "narrator": "ガブリエラ", "text": "えっ！？！？！？"},
        { "location": "1209/TALK", "narrator": "ガブリエラ", "text": "そう言われると余計\n緊張しちゃうわよ！"},
        { "location": "1210/ACT" , "narrator": "", "text": "かっわいいなあもう！"},
        { "location": "1211/TALK", "narrator": "ガブリエラ", "text": "またそうやって\n子供扱いして！"},
        { "location": "1212/TALK", "narrator": "ガブリエラ", "text": "本当のことだもの\n仕方ないじゃない！"},
        { "location": "1215/TALK", "narrator": "ガブリエラ", "text": "…少し寄り道して\n帰ろうかしら。"},
        { "location": "1216/TALK", "narrator": "ガブリエラ", "text": "こうやってもう少し\nお話ししたいから。"},
        { "location": "1217/SEL" , "narrator": "", "text": "それもいいね"},
        { "location": "1218/SEL" , "narrator": "", "text": "いつでも話そうよ"},
        { "location": "1219/SEL" , "narrator": "", "text": "どこにいても幸せ"},
        { "location": "1220/ACT" , "narrator": "", "text": "それもいいね"},
        { "location": "1222/TALK", "narrator": "ガブリエラ", "text": "$handle$も\n何か話して。"},
        { "location": "1223/TALK", "narrator": "ガブリエラ", "text": "あたしとても\n聞きたいわ。"},
        { "location": "1224/ACT" , "narrator": "", "text": "いつでも話そうよ"},
        { "location": "1226/TALK", "narrator": "ガブリエラ", "text": "そうね。"},
        { "location": "1227/TALK", "narrator": "ガブリエラ", "text": "色んな話を。"},
        { "location": "1228/ACT" , "narrator": "", "text": "どこにいても幸せ"},
        { "location": "1230/TALK", "narrator": "ガブリエラ", "text": "あたしだってそうよ。"},
        { "location": "1231/TALK", "narrator": "ガブリエラ", "text": "$handle$\nさえいれば\nいつだってそう。"},
        { "location": "1235/TALK", "narrator": "ガブリエラ", "text": "えっと……。\nそれじゃあね……。"}
