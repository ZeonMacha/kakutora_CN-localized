    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "東京編５話"},
        { "location": "21/TALK"   , "narrator": "雛", "text": "――でね、\nやっぱりあたしもさ、\n恋人に憧れてるんだよー。"},
        { "location": "23/TALK"   , "narrator": "つばめ", "text": "ひなこちゃんなら、\n恋人くらいすぐに\nできると思うよ？"},
        { "location": "24/TALK"   , "narrator": "雛", "text": "すぐってどれくらい？\n明日？　来週？"},
        { "location": "25/TALK"   , "narrator": "つばめ", "text": "うん、きっとできるよ！"},
        { "location": "27/TALK"   , "narrator": "繭", "text": "…相手を選ばなければ。"},
        { "location": "28/TALK"   , "narrator": "雛", "text": "ちょっと、まゆちん！\n嫌なこと言わないでよー！"},
        { "location": "30/TALK"   , "narrator": "雛", "text": "あたしにだって\n好きなタイプは\nちゃんとあるんだよ？"},
        { "location": "31/TALK"   , "narrator": "つばめ", "text": "例えばどんな人？"},
        { "location": "34/TALK"   , "narrator": "雛", "text": "ん～…明るくて元気で、\n行動力もあって…。"},
        { "location": "36/TALK"   , "narrator": "雛", "text": "あ、そうそう。\n友達を大切にする人！"},
        { "location": "37/TALK"   , "narrator": "つばめ", "text": "それなら、キリトくんや\nヒカルくんもそうだね。"},
        { "location": "38/TALK"   , "narrator": "雛", "text": "えっ！？　いやいや、\nあの二人は友達だし…。"},
        { "location": "40/TALK"   , "narrator": "雛", "text": "そうだ！\nまゆちんはどうなの？"},
        { "location": "42/TALK"   , "narrator": "繭", "text": "私を巻き込まないで。"},
        { "location": "43/TALK"   , "narrator": "雛", "text": "えー、たまにはまゆちんも\n恋バナ混ざろうよー。"},
        { "location": "44/SEL"    , "narrator": "（選択肢）", "text": "盛り上がってるみたいだね"},
        { "location": "45/ACT"    , "narrator": "", "text": "盛り上がってるみたいだね"},
        { "location": "61/TALK"   , "narrator": "つばめ", "text": "昨日ね"},
        { "location": "62/TALK"   , "narrator": "つばめ", "text": "恋愛モノのドラマやってて"},
        { "location": "63/TALK"   , "narrator": "つばめ", "text": "その話してたら"},
        { "location": "64/TALK"   , "narrator": "つばめ", "text": "恋バナになっちゃった(≧艸≦*)"},
        { "location": "66/SEL"    , "narrator": "（選択肢）", "text": "普通の女の子みたい"},
        { "location": "67/SEL"    , "narrator": "（選択肢）", "text": "$me$のことを話してもいいよ"},
        { "location": "68/ACT"    , "narrator": "", "text": "普通の女の子みたい"},
        { "location": "69/TALK"   , "narrator": "つばめ", "text": "どぅぃぅこと？(´･ω･｀) "},
        { "location": "70/TALK"   , "narrator": "つばめ", "text": "わたし"},
        { "location": "71/TALK"   , "narrator": "つばめ", "text": "女の子だけど(･Д･｀)"},
        { "location": "73/TALK"   , "narrator": "つばめ", "text": "時々難しぃこと言ぅよねヾ(｡>﹏<｡)ﾉﾞ"},
        { "location": "74/ACT"    , "narrator": "", "text": "$me$のことを話してもいいよ"},
        { "location": "75/TALK"   , "narrator": "つばめ", "text": "それは"},
        { "location": "76/TALK"   , "narrator": "つばめ", "text": "ちょっと"},
        { "location": "77/TALK"   , "narrator": "つばめ", "text": "恥ずかしぃから(/ω＼)"},
        { "location": "80/TALK"   , "narrator": "つばめ", "text": "$handle1$のことは"},
        { "location": "81/TALK"   , "narrator": "つばめ", "text": "もぅちょっと"},
        { "location": "82/TALK"   , "narrator": "つばめ", "text": "整理できてから話すつもり(*´︶`*)"},
        { "location": "83/TALK"   , "narrator": "つばめ", "text": "ごめんね？"},
        { "location": "95/TALK"   , "narrator": "つばめ", "text": "えへへ…。"},
        { "location": "98/TALK"   , "narrator": "雛", "text": "つばめちゃん、\n誰とお話してたの？"},
        { "location": "100/TALK"  , "narrator": "つばめ", "text": "えっ？"},
        { "location": "103/TALK"  , "narrator": "繭", "text": "…すごく幸せそう。\nもしかして、恋人？"},
        { "location": "104/TALK"  , "narrator": "つばめ", "text": "そ、それは、えっと…。"},
        { "location": "106/TALK"  , "narrator": "つばめ", "text": "…えへへ、秘密。\nでも、とっても特別で、\n大切な人なんだ。"},
        { "location": "125/DIALOG", "narrator": "", "text": "<color=green>9月5日　 3:53 PM</color>\nとある平日の放課後、付属学園、雛の教室にて"},
        { "location": "127/TALK"  , "narrator": "キリト", "text": "…おい、ひなこ。\n授業終わったぞ？"},
        { "location": "128/TALK"  , "narrator": "雛", "text": "くー…。"},
        { "location": "129/TALK"  , "narrator": "キリト", "text": "しょうがねぇな…。\nおい、ひなこ。\nいい加減起きろっての！"},
        { "location": "130/TALK"  , "narrator": "雛", "text": "ん…あれ？\nあたし…どうしたの？"},
        { "location": "131/TALK"  , "narrator": "キリト", "text": "居眠りしてたんだよ。\nほら、もう放課後だぞ？"},
        { "location": "132/TALK"  , "narrator": "雛", "text": "…わっ、ヤバい！\n超爆睡しちゃってたー！"},
        { "location": "144/TALK"  , "narrator": "キリト", "text": "みたいだな…。\nおまえさ、夜はちゃんと\n寝てんのか？"},
        { "location": "146/TALK"  , "narrator": "雛", "text": "…寝てるよー。"},
        { "location": "147/TALK"  , "narrator": "キリト", "text": "…寝てないだろ？"},
        { "location": "150/TALK"  , "narrator": "雛", "text": "…だって、つばめちゃんが\n心配で…。"},
        { "location": "151/TALK"  , "narrator": "キリト", "text": "あのなぁ…そんなんじゃ\nひなこが身体壊すだろ？"},
        { "location": "152/TALK"  , "narrator": "キリト", "text": "気持ちはわかるけど、\nちょっとは自分のことも\n考えろって…。"},
        { "location": "154/TALK"  , "narrator": "雛", "text": "でも、寝てても\nつばめちゃんの夢\n見ちゃうんだもん…。"},
        { "location": "155/TALK"  , "narrator": "雛", "text": "今だって、つばめちゃんと\n恋バナしてる夢見てて…。"},
        { "location": "157/TALK"  , "narrator": "雛", "text": "…………。"},
        { "location": "159/TALK"  , "narrator": "キリト", "text": "…なんだ？\nおい、どうした？"},
        { "location": "164/TALK"  , "narrator": "雛", "text": "あ、あぁーっ！！！"},
        { "location": "165/TALK"  , "narrator": "キリト", "text": "うわっ！！\nな、なんだぁ！？"},
        { "location": "167/TALK"  , "narrator": "雛", "text": "そうだよ！！\nいたじゃん！！\nもう一人すごい協力者が！"},
        { "location": "168/TALK"  , "narrator": "キリト", "text": "いや、ひなこ？\nおまえなに考えて…。"},
        { "location": "171/TALK"  , "narrator": "雛", "text": "ちょっとだけ待って！\nもし、あたしの考えが\n正しければ…。"},
        { "location": "184/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "188/TALK"  , "narrator": "つばめ", "text": "あっ…今のって、\nＷＡＶＥかな？"},
        { "location": "189/TALK"  , "narrator": "つばめ", "text": "誰からだろう…。\nでも、縛られてるから\n見れないし…。"},
        { "location": "191/TALK"  , "narrator": "つばめ", "text": "はぁ…。"},
        { "location": "193/TALK"  , "narrator": "雛", "text": "あのー！！"},
        { "location": "194/TALK"  , "narrator": "雛", "text": "いますかー！？"},
        { "location": "195/TALK"  , "narrator": "雛", "text": "つばめちゃんが大切っていう人"},
        { "location": "196/TALK"  , "narrator": "雛", "text": "いたら返事ください！！"},
        { "location": "197/SEL"   , "narrator": "（選択肢）", "text": "なんでしょう？"},
        { "location": "198/SEL"   , "narrator": "（選択肢）", "text": "呼んだ？"},
        { "location": "199/ACT"   , "narrator": "", "text": "なんでしょう？"},
        { "location": "201/TALK"  , "narrator": "雛", "text": "いた！！"},
        { "location": "202/TALK"  , "narrator": "雛", "text": "やっぱり！！"},
        { "location": "203/ACT"   , "narrator": "", "text": "呼んだ？"},
        { "location": "205/TALK"  , "narrator": "雛", "text": "いた！！"},
        { "location": "206/TALK"  , "narrator": "雛", "text": "呼びました！"},
        { "location": "207/TALK"  , "narrator": "雛", "text": "あなたと話したかったんです！"},
        { "location": "209/TALK"  , "narrator": "雛", "text": "つばめちゃんのＷＡＶＥに話しかけたら"},
        { "location": "210/TALK"  , "narrator": "雛", "text": "連絡取れるかもって"},
        { "location": "212/TALK"  , "narrator": "雛", "text": "よかったー"},
        { "location": "213/SEL"   , "narrator": "（選択肢）", "text": "$me$に用事？"},
        { "location": "214/ACT"   , "narrator": "", "text": "$me$に用事？"},
        { "location": "216/TALK"  , "narrator": "雛", "text": "もちろん"},
        { "location": "217/TALK"  , "narrator": "雛", "text": "それで呼んだんです"},
        { "location": "219/TALK"  , "narrator": "雛", "text": "あたし達"},
        { "location": "220/TALK"  , "narrator": "雛", "text": "つばめちゃんの友達で"},
        { "location": "221/TALK"  , "narrator": "雛", "text": "今"},
        { "location": "222/TALK"  , "narrator": "雛", "text": "つばめちゃん大変なことになってて"},
        { "location": "223/TALK"  , "narrator": "雛", "text": "知ってますか？"},
        { "location": "224/SEL"   , "narrator": "（選択肢）", "text": "最近連絡取れない"},
        { "location": "225/SEL"   , "narrator": "（選択肢）", "text": "管理庁に捕まってる"},
        { "location": "226/ACT"   , "narrator": "", "text": "最近連絡取れない"},
        { "location": "227/TALK"  , "narrator": "雛", "text": "知らなかったんですか？"},
        { "location": "228/TALK"  , "narrator": "雛", "text": "つばめちゃん"},
        { "location": "229/TALK"  , "narrator": "雛", "text": "管理庁に捕まっちゃってて"},
        { "location": "230/TALK"  , "narrator": "雛", "text": "大変なんです"},
        { "location": "231/ACT"   , "narrator": "", "text": "管理庁に捕まってる"},
        { "location": "232/TALK"  , "narrator": "雛", "text": "やっぱり"},
        { "location": "233/TALK"  , "narrator": "雛", "text": "さすがはつばめちゃんの大切な人！"},
        { "location": "235/TALK"  , "narrator": "雛", "text": "それで"},
        { "location": "236/TALK"  , "narrator": "雛", "text": "あたし達はつばめちゃんを"},
        { "location": "237/TALK"  , "narrator": "雛", "text": "助けたいんです"},
        { "location": "238/TALK"  , "narrator": "雛", "text": "でも"},
        { "location": "239/TALK"  , "narrator": "雛", "text": "どうすればいいかわからなくて"},
        { "location": "240/TALK"  , "narrator": "雛", "text": "綾水様達とも連絡取れなくて"},
        { "location": "242/TALK"  , "narrator": "雛", "text": "だからお願いです"},
        { "location": "243/TALK"  , "narrator": "雛", "text": "つばめちゃんの大切な人である"},
        { "location": "244/TALK"  , "narrator": "雛", "text": "あなたに手伝ってほしいんです！"},
        { "location": "245/TALK"  , "narrator": "雛", "text": "お願いします！"},
        { "location": "246/SEL"   , "narrator": "（選択肢）", "text": "一緒につばめを助けてくれ"},
        { "location": "247/SEL"   , "narrator": "（選択肢）", "text": "助言くらいしかできないけど…"},
        { "location": "248/ACT"   , "narrator": "", "text": "一緒につばめを助けてくれ"},
        { "location": "249/TALK"  , "narrator": "雛", "text": "やっぱり"},
        { "location": "250/TALK"  , "narrator": "雛", "text": "あなたも同じ気持ちなんですね？"},
        { "location": "251/TALK"  , "narrator": "雛", "text": "安心しました"},
        { "location": "252/TALK"  , "narrator": "雛", "text": "さすがはつばめちゃんの大切な人！"},
        { "location": "253/ACT"   , "narrator": "", "text": "助言くらいしかできないけど…"},
        { "location": "254/TALK"  , "narrator": "雛", "text": "構いません！"},
        { "location": "255/TALK"  , "narrator": "雛", "text": "今のあたし達には"},
        { "location": "256/TALK"  , "narrator": "雛", "text": "一人でも仲間が必要なんです"},
        { "location": "257/TALK"  , "narrator": "雛", "text": "それにあなたは"},
        { "location": "258/TALK"  , "narrator": "雛", "text": "いつもつばめちゃんを元気にしてきた"},
        { "location": "259/TALK"  , "narrator": "雛", "text": "だから"},
        { "location": "260/TALK"  , "narrator": "雛", "text": "とっても心強いです"},
        { "location": "262/TALK"  , "narrator": "雛", "text": "このこと"},
        { "location": "263/TALK"  , "narrator": "雛", "text": "みんなに話して来ます！"},
        { "location": "277/TALK"  , "narrator": "雛", "text": "やった、やったよ！！\n思った通り！！"},
        { "location": "279/TALK"  , "narrator": "キリト", "text": "なにがだよ？\n誰と話してたんだ？"},
        { "location": "281/TALK"  , "narrator": "雛", "text": "説明するから、\nとりあえずまゆちんと\nヒカルくんを呼ぼう！"},
        { "location": "282/TALK"  , "narrator": "キリト", "text": "…ひなこのやつ、\nなにを企んでんだか…。"}
    ]
}
