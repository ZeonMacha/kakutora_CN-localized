    "dir": "chap05/battle/btev_ch04_05_02.js",
    "type": "",
    "info": {
        "story_id": "24006",
        "cid": "",
        "title": "006 ココロスフィアストーリー【Lv02】",
        "sub_title": "敵Ⅱ＜帰結＞"
    },
    "entry":
    [
        { "location": "129/SCENARIO", "narrator": "", "text": "敵Ⅱ２"},
        { "location": "142/TALK"    , "narrator": "みやび", "text": "…というわけで\nうちが戦いに\n勝ったわけやけんど。"},
        { "location": "143/SEL"     , "narrator": "（選択肢）", "text": "ってどっち！？"},
        { "location": "144/ACT"     , "narrator": "", "text": "ってどっち！？"},
        { "location": "146/TALK"    , "narrator": "みやび", "text": "あんたと一緒に\n戦った方に\n決まっちょるき。"},
        { "location": "147/SEL"     , "narrator": "（選択肢）", "text": "名前も違うし！"},
        { "location": "148/ACT"     , "narrator": "", "text": "名前も違うし！"},
        { "location": "150/TALK"    , "narrator": "みやび", "text": "一緒やったら\nモロバレちや。"},
        { "location": "151/SEL"     , "narrator": "（選択肢）", "text": "負けた方が消えてくところも無し！？"},
        { "location": "152/ACT"     , "narrator": "", "text": "負けた方が消えてくところも無し！？"},
        { "location": "154/TALK"    , "narrator": "みやび", "text": "工数削減にも貢献して\n一石二鳥やね。"},
        { "location": "155/SEL"     , "narrator": "（選択肢）", "text": "もういいです…"},
        { "location": "156/ACT"     , "narrator": "", "text": "もういいです…"},
        { "location": "158/TALK"    , "narrator": "みやび", "text": "うむ。\n世の中突っ込まん方が\nえいこともあるちや。"},
        { "location": "160/TALK"    , "narrator": "みやび", "text": "さて、うちは嘘偽り\n無く、お前さんを\n疑っちょるうちや。"},
        { "location": "161/TALK"    , "narrator": "みやび", "text": "情報管理庁の\n手駒じゃろと\n思っちょる。"},
        { "location": "162/TALK"    , "narrator": "みやび", "text": "とはいえ、そんな\nお前さんにも\n恩がある。"},
        { "location": "163/TALK"    , "narrator": "みやび", "text": "さっき反論するうちを\n倒してくれたきね。"},
        { "location": "164/TALK"    , "narrator": "みやび", "text": "お陰でうちは、\nお前さんを伸び伸びと\n疑えるようになった。"},
        { "location": "166/TALK"    , "narrator": "みやび", "text": "さて、敵ではあれ、\nうちはお前さんを\n疑っちょらん。"},
        { "location": "167/TALK"    , "narrator": "みやび", "text": "そんで今回は更に、\nうちが勝てるように\n協力してくれたき。"},
        { "location": "169/TALK"    , "narrator": "みやび", "text": "敵であっても恩は恩。"},
        { "location": "170/TALK"    , "narrator": "みやび", "text": "そこで、うちのヒミツ\n情報をなにか１つ\nやろうと思ってな。"},
        { "location": "172/SEL"     , "narrator": "（選択肢）", "text": "みやびの恥ずかしい話"},
        { "location": "173/SEL"     , "narrator": "（選択肢）", "text": "みやびのハッカー人生の話"},
        { "location": "174/TALK"    , "narrator": "みやび", "text": "好きな方を\n選んでえいよ。"},
        { "location": "175/ACT"     , "narrator": "", "text": "みやびの恥ずかしい話"},
        { "location": "176/TALK"    , "narrator": "みやび", "text": "なんと！\nそんなもんで\nえいんか？"},
        { "location": "178/TALK"    , "narrator": "みやび", "text": "クーリングオフは\n無しやけんど、\n平気か？"},
        { "location": "179/SEL"     , "narrator": "（選択肢）", "text": "はい"},
        { "location": "180/SEL"     , "narrator": "（選択肢）", "text": "いいえ"},
        { "location": "181/ACT"     , "narrator": "", "text": "はい"},
        { "location": "182/ACT"     , "narrator": "", "text": "いいえ"},
        { "location": "183/TALK"    , "narrator": "みやび", "text": "じゃあもう一度\n選び直しやね。"},
        { "location": "186/TALK"    , "narrator": "みやび", "text": "うーむ、そうか。\nわかった。"},
        { "location": "187/TALK"    , "narrator": "みやび", "text": "まっことくだらん\nことやのに……"},
        { "location": "188/TALK"    , "narrator": "みやび", "text": "まあえいか。\n選択したのは\nうちやないきね。"},
        { "location": "191/TALK"    , "narrator": "みやび", "text": "ほんだら\nいくきね。"},
        { "location": "214/DIALOG"  , "narrator": "", "text": "うちの\n恥ずかしいファイル\n\n①"},
        { "location": "225/TALK"    , "narrator": "みやび", "text": "うちはアーヤより\n身長が低いちや。"},
        { "location": "226/TALK"    , "narrator": "みやび", "text": "アーヤは164cm。\nうちは162cmやきね。"},
        { "location": "227/TALK"    , "narrator": "みやび", "text": "けんど。"},
        { "location": "230/TALK"    , "narrator": "みやび", "text": "胸は\nうちの方が\nでかい。"},
        { "location": "234/TALK"    , "narrator": "みやび", "text": "ああ……\nなんという\n恥ずかしい…。"},
        { "location": "237/DIALOG"  , "narrator": "", "text": "終劇。"},
        { "location": "258/TALK"    , "narrator": "みやび", "text": "はぁ、\n恥ずかしかったちや。"},
        { "location": "259/SEL"     , "narrator": "（選択肢）", "text": "それ、恥ずかしい話なの？"},
        { "location": "260/ACT"     , "narrator": "", "text": "それ、恥ずかしい話なの？"},
        { "location": "263/TALK"    , "narrator": "みやび", "text": "当たり前や。\nいつも気にしちょる。"},
        { "location": "264/TALK"    , "narrator": "みやび", "text": "身長が低いのに胸が\nあるっちゅうことは―"},
        { "location": "265/TALK"    , "narrator": "みやび", "text": "そんだけ脂肪分が\n多いっちゅうことやき。"},
        { "location": "266/TALK"    , "narrator": "みやび", "text": "すなわち、非効率な\n身体っちゅうことや。"},
        { "location": "267/TALK"    , "narrator": "みやび", "text": "最適化されてない\n身体っちゅうんは\n恥ずかしいやないか。"},
        { "location": "268/SEL"     , "narrator": "（選択肢）", "text": "でも世の中胸が大きいのは結構正義みたいな風潮があって"},
        { "location": "269/SEL"     , "narrator": "（選択肢）", "text": "いや、その通りですわ"},
        { "location": "270/ACT"     , "narrator": "", "text": "でも世の中胸が大きいのは結構正義みたいな風潮があって"},
        { "location": "271/TALK"    , "narrator": "みやび", "text": "胸なぞ飾りや。"},
        { "location": "272/TALK"    , "narrator": "みやび", "text": "世の中の老若男女は\nそれがわかっちょらん\nのですよ。"},
        { "location": "273/ACT"     , "narrator": "", "text": "いや、その通りですわ"},
        { "location": "274/TALK"    , "narrator": "みやび", "text": "うむ。\n理解が早くて助かる。"},
        { "location": "276/TALK"    , "narrator": "みやび", "text": "まあそんなわけで、\nせっかくの機会に\nくだらない話を……"},
        { "location": "277/TALK"    , "narrator": "みやび", "text": "……。"},
        { "location": "278/SEL"     , "narrator": "（選択肢）", "text": "どうしたの？"},
        { "location": "279/ACT"     , "narrator": "", "text": "どうしたの？"},
        { "location": "281/TALK"    , "narrator": "みやび", "text": "いや、なんでもない。"},
        { "location": "282/ACT"     , "narrator": "", "text": "みやびのハッカー人生の話"},
        { "location": "283/TALK"    , "narrator": "みやび", "text": "ふむ。\nまあ普通はこっちを\n選ぶじゃろ。"},
        { "location": "284/TALK"    , "narrator": "みやび", "text": "とはゆうてもなぁ。\nうちのハッカー人生\nなんぞ、つまらんぞ。"},
        { "location": "285/TALK"    , "narrator": "みやび", "text": "殆どが、うちが\nいじめられていた話に\nなってしまうきね。"},
        { "location": "286/SEL"     , "narrator": "（選択肢）", "text": "いじめられてたの！？"},
        { "location": "287/ACT"     , "narrator": "", "text": "いじめられてたの！？"},
        { "location": "289/TALK"    , "narrator": "みやび", "text": "うむ。まあ……\n小学校の頃の\n話やけんどな。"},
        { "location": "290/SEL"     , "narrator": "（選択肢）", "text": "小学生からハッカー！？"},
        { "location": "291/ACT"     , "narrator": "", "text": "小学生からハッカー！？"},
        { "location": "293/TALK"    , "narrator": "みやび", "text": "そんなに驚く\nことかえ？"},
        { "location": "294/TALK"    , "narrator": "みやび", "text": "まあえい。\nちゃちゃっと\n済ませるちや。"},
        { "location": "307/DIALOG"  , "narrator": "", "text": "うちの\nハッカー人生物語\n\n①"},
        { "location": "310/DIALOG"  , "narrator": "", "text": "恋ヶ崎みやび。\n遙か17年も昔のこと、\n高知県にて誕生する。"},
        { "location": "311/DIALOG"  , "narrator": "", "text": "幼少期からマイペースすぎて\n周りの子供とは\n全くシンクロできんかったらしい。"},
        { "location": "314/DIALOG"  , "narrator": "", "text": "そうなれば当然、\n浮いた存在になるわけやき、\nいじめられやすくなるわな。\n\nうちは漏れなく\nその対象になったわけや。"},
        { "location": "315/DIALOG"  , "narrator": "", "text": "けんど、\nそこに一筋の光が\n降りてきた。\n\nそれこそが、\n当時社会現象にまでなった\n人気ゲーム\n\n『カプセル＆ドラゴン』\n\n通称・カプドラちや。"},
        { "location": "334/DIALOG"  , "narrator": "", "text": "うちはカプドラを極めて\nクラスの人気者になろう\n大作戦を決行した。\n\nそして、近所の\nゲーマーの兄ちゃんに\nカプドラの必勝法を\n聞きに行った。"},
        { "location": "336/TALK"    , "narrator": "男子高校生", "text": "カプドラで\n強くなりたいって？"},
        { "location": "338/TALK"    , "narrator": "男子高校生", "text": "いい方法\n教えてやるよ。"},
        { "location": "340/TALK"    , "narrator": "みやび", "text": "おお！\nまじか兄ちゃん！"},
        { "location": "342/TALK"    , "narrator": "男子高校生", "text": "任せとけ。\n絶対にクラスの\n人気者になれるねや。"},
        { "location": "343/DIALOG"  , "narrator": "", "text": "その時に教えてもらったのが\nそう、『チート』やった。"},
        { "location": "356/DIALOG"  , "narrator": "", "text": "その後クラスでは、\n兄ちゃんが言ったとおり\nうちは人気者になった。\n\nその甘い蜜を\n知ってしまった事がきっかけで、\nうちはハッカーというものに\n目覚めてしまったのや。"},
        { "location": "359/DIALOG"  , "narrator": "", "text": "終劇。"},
        { "location": "376/TALK"    , "narrator": "みやび", "text": "ま、こんなとこやね。"},
        { "location": "377/TALK"    , "narrator": "みやび", "text": "感想は？"},
        { "location": "378/SEL"     , "narrator": "（選択肢）", "text": "小さい頃から俗っぽかったんだなぁ"},
        { "location": "379/SEL"     , "narrator": "（選択肢）", "text": "みやびらしい"},
        { "location": "380/SEL"     , "narrator": "（選択肢）", "text": "テロップばっかりだった…"},
        { "location": "381/ACT"     , "narrator": "", "text": "小さい頃から俗っぽかったんだなぁ"},
        { "location": "382/TALK"    , "narrator": "みやび", "text": "余計なお世話やね。"},
        { "location": "383/ACT"     , "narrator": "", "text": "みやびらしい"},
        { "location": "384/TALK"    , "narrator": "みやび", "text": "それは褒め言葉か？"},
        { "location": "385/ACT"     , "narrator": "", "text": "テロップばっかりだった…"},
        { "location": "386/TALK"    , "narrator": "みやび", "text": "うちに\nハイクオリティの\n労働を期待するのか？"},
        { "location": "388/TALK"    , "narrator": "みやび", "text": "……いや、\nほらもっと他に\n聞くことがあるじゃろ。"},
        { "location": "389/TALK"    , "narrator": "みやび", "text": "あの兄ちゃんは～…\n…　…とか。"},
        { "location": "390/SEL"     , "narrator": "（選択肢）", "text": "ああっ！　みやびは、あの兄ちゃんが好きだったの？"},
        { "location": "391/ACT"     , "narrator": "", "text": "ああっ！　みやびは、あの兄ちゃんが好きだったの？"},
        { "location": "393/TALK"    , "narrator": "みやび", "text": "……。"},
        { "location": "394/TALK"    , "narrator": "みやび", "text": "もうえい。"},
        { "location": "395/TALK"    , "narrator": "みやび", "text": "やはし、うちの\n勘違いやったか。"},
        { "location": "396/TALK"    , "narrator": "みやび", "text": "いやしかし、\nこれもまた罠……？"},
        { "location": "397/TALK"    , "narrator": "みやび", "text": "うーん、わからん。\nまあえいか、そのうち\n尻尾を出すちや。"},
        { "location": "399/TALK"    , "narrator": "みやび", "text": "さ、お礼も済んだし、\n今回はこれで\nお終いや。"},
        { "location": "401/TALK"    , "narrator": "みやび", "text": "ほんだら、\nさいなら。"}
    ]
}
