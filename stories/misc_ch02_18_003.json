    "entry":
    [
        { "location": "161/SCENARIO", "narrator": "", "text": "意地っ張りとおねえさま"},
        { "location": "186/TALK"    , "narrator": "アーヤ", "text": "ギャヴィを見ていると"},
        { "location": "187/TALK"    , "narrator": "アーヤ", "text": "私が中学生の時こんなだったかしらって"},
        { "location": "188/TALK"    , "narrator": "アーヤ", "text": "思うのよ"},
        { "location": "190/SEL"     , "narrator": "", "text": "多分違う"},
        { "location": "191/SEL"     , "narrator": "", "text": "ギャヴィの方が可愛い"},
        { "location": "192/SEL"     , "narrator": "", "text": "お姉さん役も大変だね"},
        { "location": "193/ACT"     , "narrator": "", "text": "多分違う"},
        { "location": "194/TALK"    , "narrator": "アーヤ", "text": "やっぱり"},
        { "location": "195/ACT"     , "narrator": "", "text": "ギャヴィの方が可愛い"},
        { "location": "196/TALK"    , "narrator": "アーヤ", "text": "そんなこと"},
        { "location": "197/TALK"    , "narrator": "アーヤ", "text": "聞いてないわ"},
        { "location": "198/ACT"     , "narrator": "", "text": "お姉さん役も大変だね"},
        { "location": "200/TALK"    , "narrator": "アーヤ", "text": "大変ってことはないけど"},
        { "location": "202/TALK"    , "narrator": "アーヤ", "text": "どうしても"},
        { "location": "203/TALK"    , "narrator": "アーヤ", "text": "そうなっちゃうのよね"},
        { "location": "205/TALK"    , "narrator": "アーヤ", "text": "もう少し色々と"},
        { "location": "206/TALK"    , "narrator": "アーヤ", "text": "素直になってくれればいいのに"},
        { "location": "208/SEL"     , "narrator": "", "text": "ツンデレこそギャヴィの長所"},
        { "location": "209/SEL"     , "narrator": "", "text": "そのうち大人になるよ"},
        { "location": "210/SEL"     , "narrator": "", "text": "$me$はアーヤが大好き"},
        { "location": "211/ACT"     , "narrator": "", "text": "ツンデレこそギャヴィの長所"},
        { "location": "212/TALK"    , "narrator": "アーヤ", "text": "そういう考え方も"},
        { "location": "213/TALK"    , "narrator": "アーヤ", "text": "ありかもだけど"},
        { "location": "214/TALK"    , "narrator": "アーヤ", "text": "まあ"},
        { "location": "216/TALK"    , "narrator": "アーヤ", "text": "そういうのも"},
        { "location": "217/TALK"    , "narrator": "アーヤ", "text": "個性よね"},
        { "location": "218/ACT"     , "narrator": "", "text": "そのうち大人になるよ"},
        { "location": "219/TALK"    , "narrator": "アーヤ", "text": "ｍだ中学生よ"},
        { "location": "220/TALK"    , "narrator": "アーヤ", "text": "いつになったら"},
        { "location": "221/TALK"    , "narrator": "アーヤ", "text": "大人になるかしら"},
        { "location": "222/ACT"     , "narrator": "", "text": "$me$はアーヤが大好き"},
        { "location": "224/TALK"    , "narrator": "アーヤ", "text": "またすぐそういうことばっかり"},
        { "location": "226/TALK"    , "narrator": "アーヤ", "text": "今はギャヴィの話だから"},
        { "location": "227/TALK"    , "narrator": "アーヤ", "text": "そういうのはいいのよ"},
        { "location": "228/TALK"    , "narrator": "アーヤ", "text": "後にして"},
        { "location": "229/TALK"    , "narrator": "アーヤ", "text": "後でゆっくり聞くから"}
    ]
