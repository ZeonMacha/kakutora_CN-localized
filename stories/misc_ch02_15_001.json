        { "location": "37/ACT"    , "narrator": "", "text": "武者小路実篤"},
        { "location": "38/TALK"   , "narrator": "アーヤ", "text": "そうね(￣Д￣ )"},
        { "location": "39/ACT"    , "narrator": "", "text": "昭和っぽいよ？"},
        { "location": "40/TALK"   , "narrator": "アーヤ", "text": "対象から昭和の人よ"},
        { "location": "41/TALK"   , "narrator": "アーヤ", "text": "大正"},
        { "location": "42/ACT"    , "narrator": "", "text": "$me$とアーヤのことだよね"},
        { "location": "44/TALK"   , "narrator": "アーヤ", "text": "そうじゃないわよ"},
        { "location": "46/TALK"   , "narrator": "アーヤ", "text": "でも"},
        { "location": "47/TALK"   , "narrator": "アーヤ", "text": "そういうことにしておいてあげるわ(^ε^)-☆!!"},
        { "location": "49/TALK"   , "narrator": "アーヤ", "text": "つばめと卯月が一緒にアキバに行ったらしいの"},
        { "location": "50/TALK"   , "narrator": "アーヤ", "text": "同い年のお友達ができて"},
        { "location": "51/TALK"   , "narrator": "アーヤ", "text": "よかったわ"},
        { "location": "53/SEL"    , "narrator": "", "text": "そうなんだ"},
        { "location": "54/SEL"    , "narrator": "", "text": "おかんっぽい発言"},
        { "location": "55/SEL"    , "narrator": "", "text": "先輩も一安心だね"},
        { "location": "56/ACT"    , "narrator": "", "text": "そうなんだ"},
        { "location": "57/TALK"   , "narrator": "アーヤ", "text": "そうよ"},
        { "location": "59/TALK"   , "narrator": "アーヤ", "text": "クラスにも溶け込んでるみたいだし"},
        { "location": "60/TALK"   , "narrator": "アーヤ", "text": "いいことよね(^-^*)(･･*)(^-^*)(･･*)"},
        { "location": "61/ACT"    , "narrator": "", "text": "おかんっぽい発言"},
        { "location": "62/TALK"   , "narrator": "アーヤ", "text": "おかんじゃないわよ（｀皿´ )"},
        { "location": "63/TALK"   , "narrator": "アーヤ", "text": "心配しちゃうのよ"},
        { "location": "64/TALK"   , "narrator": "アーヤ", "text": "私の方が年上だから(;^_^A"},
        { "location": "65/ACT"    , "narrator": "", "text": "先輩も一安心だね"},
        { "location": "67/TALK"   , "narrator": "アーヤ", "text": "そうね(￣Д￣ )"},
        { "location": "68/TALK"   , "narrator": "アーヤ", "text": "つばめはちょっと人見知りのところがあるし"},
        { "location": "69/TALK"   , "narrator": "アーヤ", "text": "こっちに北のも急だったから(´o｀；"},
        { "location": "70/TALK"   , "narrator": "アーヤ", "text": "でも"},
        { "location": "71/TALK"   , "narrator": "アーヤ", "text": "馴染んできたみたいで安心したわ"}
