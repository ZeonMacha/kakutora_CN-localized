{
    "dir": "chap14/daydra/dd_ch01_14_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "14156",
        "cid": "tsubame",
        "title": "Extra005 プレミアムストーリー",
        "sub_title": "國政綾水とランジェリー"
    },
    "entry":
    [
        { "location": "479/SCENARIO", "narrator": "", "text": "アーヤＭＶ回２"},
        { "location": "496/TALK"    , "narrator": "神楽", "text": "どうですか？\n可愛い下着、\n見つかりましたか？"},
        { "location": "498/TALK"    , "narrator": "つばめ", "text": "え、えっと…うん。\nどの下着も\n可愛いと思うよ。"},
        { "location": "499/TALK"    , "narrator": "神楽", "text": "もぉ、つばめさん！\nしっかり選ばないと\nダメじゃないですか。"},
        { "location": "501/TALK"    , "narrator": "つばめ", "text": "で、でも、わたし\nこういうお店来るの\n初めてだから…。"},
        { "location": "503/TALK"    , "narrator": "神楽", "text": "じゃあ、私が代わりに\n選んじゃいますね。\nえーっと…。"},
        { "location": "505/TALK"    , "narrator": "神楽", "text": "あっ、これなんか\nセクシーな感じで\nいいかも！"},
        { "location": "507/TALK"    , "narrator": "つばめ", "text": "えっ！？\nこれはちょっと…。"},
        { "location": "508/TALK"    , "narrator": "神楽", "text": "つばめさんは\n素敵な胸をお持ち\nですから――"},
        { "location": "509/TALK"    , "narrator": "神楽", "text": "こういうデザインのが\n絶対似合いますよ！"},
        { "location": "511/TALK"    , "narrator": "つばめ", "text": "で、デザインは\n素敵だと思うけど――"},
        { "location": "512/TALK"    , "narrator": "つばめ", "text": "生地、ちょっと\n少なくない？"},
        { "location": "513/TALK"    , "narrator": "神楽", "text": "それがセクシー度\n倍増ポイントです！"},
        { "location": "515/TALK"    , "narrator": "つばめ", "text": "わたし、普通に白とか\nベージュとか、\nイチゴ柄がいいな…。"},
        { "location": "516/TALK"    , "narrator": "神楽", "text": "…はい？\nいま、イチゴって\n言いました？"},
        { "location": "517/TALK"    , "narrator": "つばめ", "text": "うん、イチゴ。\n可愛くて\nお気に入りなんだ。"},
        { "location": "519/TALK"    , "narrator": "神楽", "text": "…………。"},
        { "location": "520/TALK"    , "narrator": "つばめ", "text": "…卯月さん？"},
        { "location": "522/TALK"    , "narrator": "神楽", "text": "つばめさん、\n最高です！"},
        { "location": "524/TALK"    , "narrator": "つばめ", "text": "え、えぇっ！？"},
        { "location": "529/TALK"    , "narrator": "ガブリエラ", "text": "何言ってんのよ。\n高校生にもなって\n子供っぽい…。"},
        { "location": "531/TALK"    , "narrator": "つばめ", "text": "こ、子供っぽい\nかなぁ？"},
        { "location": "533/TALK"    , "narrator": "ガブリエラ", "text": "当然でしょ？\n今どき、小学生でも\n履かないわよ。"},
        { "location": "536/TALK"    , "narrator": "神楽", "text": "ガブちゃんなら\n年相応に似合うと\n思いますよ？"},
        { "location": "537/TALK"    , "narrator": "ガブリエラ", "text": "どういう意味よ！？"},
        { "location": "538/TALK"    , "narrator": "つばめ", "text": "あ、えっと…、\nそうだ！"},
        { "location": "539/TALK"    , "narrator": "つばめ", "text": "ガブちゃんは\n気に入った下着、\n見つかったの？"},
        { "location": "541/TALK"    , "narrator": "ガブリエラ", "text": "え！？　ま、まあ、\n一応ね…。"},
        { "location": "542/TALK"    , "narrator": "神楽", "text": "何で後ろに\n隠してるんですか？"},
        { "location": "545/TALK"    , "narrator": "ガブリエラ", "text": "し、下着は見せびら\nかすようなものじゃ\nないからよ…。"},
        { "location": "548/TALK"    , "narrator": "アーヤ", "text": "――えっ！？\nちょっと、ギャヴィ！"},
        { "location": "553/TALK"    , "narrator": "アーヤ", "text": "その持ってる下着、\nギャヴィには\n早過ぎない？"},
        { "location": "558/TALK"    , "narrator": "ガブリエラ", "text": "ちょ、アーヤ！\n勝手に見ないで！"},
        { "location": "560/TALK"    , "narrator": "アーヤ", "text": "でも、黒はもう少し\n大人になってから\nじゃないと――"},
        { "location": "561/TALK"    , "narrator": "ガブリエラ", "text": "言わなくていいから！"},
        { "location": "563/TALK"    , "narrator": "神楽", "text": "黒って…さすがに\nガブちゃんに黒は\n早過ぎますよ…。"},
        { "location": "567/TALK"    , "narrator": "ガブリエラ", "text": "関係ないでしょ！\nあたしが買うん\nだから。"},
        { "location": "572/TALK"    , "narrator": "ガブリエラ", "text": "っていうか、\nそういうアーヤは\nどうなのよ？"},
        { "location": "574/TALK"    , "narrator": "アーヤ", "text": "え？　別に普通だと\n思うけど…。"},
        { "location": "575/TALK"    , "narrator": "ガブリエラ", "text": "そう言って、本当は\nアーヤも黒とか\n選んでるんじゃ――"},
        { "location": "576/TALK"    , "narrator": "ガブリエラ", "text": "…って、何それ？\n本当に普通じゃない。"},
        { "location": "577/TALK"    , "narrator": "アーヤ", "text": "だから、普通だって\n言ったでしょ？"},
        { "location": "579/TALK"    , "narrator": "ガブリエラ", "text": "なんか、シンプル\n過ぎてつまらない\nわね…。"},
        { "location": "583/TALK"    , "narrator": "つばめ", "text": "そうかな？\n逆に大人っぽくて\n素敵だと思うよ。"},
        { "location": "585/TALK"    , "narrator": "ガブリエラ", "text": "大人っぽいのは\nあたしの下着でしょ。"},
        { "location": "588/TALK"    , "narrator": "神楽", "text": "色だけじゃ大人っぽい\nとは言えませんよ。"},
        { "location": "590/TALK"    , "narrator": "神楽", "text": "私がガブちゃんに合う\n大人っぽい下着を\n選んであげますね。"},
        { "location": "592/TALK"    , "narrator": "ガブリエラ", "text": "えー、神楽に\n任せるの\n凄い不安なんだけど。"},
        { "location": "593/TALK"    , "narrator": "神楽", "text": "大丈夫ですよー。\nうーん、ガブちゃんに\n似合うのは…。"},
        { "location": "598/TALK"    , "narrator": "ガブリエラ", "text": "選ぶのは勝手だけど、\n買わないからね！"},
        { "location": "600/TALK"    , "narrator": "つばめ", "text": "あはは…多分、\n凄いの選びそうな\n気がします。"},
        { "location": "602/TALK"    , "narrator": "つばめ", "text": "わたしにも、\nこんな生地の少ない\n下着選んだし…。"},
        { "location": "603/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "615/TALK"    , "narrator": "つばめ", "text": "$handle$さーん"},
        { "location": "616/TALK"    , "narrator": "つばめ", "text": "どぅ思ぅ？ヾ(｡>﹏<｡)ﾉﾞ"},
        { "location": "617/TALK"    , "narrator": "つばめ", "text": "卯月さんの"},
        { "location": "619/TALK"    , "narrator": "つばめ", "text": "選んだ下着"},
        { "location": "620/TALK"    , "narrator": "つばめ", "text": "ちょっと"},
        { "location": "622/TALK"    , "narrator": "つばめ", "text": "過激すぎだよね？(/ω＼)(/ω＼)ﾊｽﾞｶｼｰｨ"},
        { "location": "624/SEL"     , "narrator": "", "text": "見えなくてわからない"},
        { "location": "625/ACT"     , "narrator": "", "text": "見えなくてわからない"},
        { "location": "628/TALK"    , "narrator": "つばめ", "text": "そぅなの？(´･ω･｀) "},
        { "location": "630/TALK"    , "narrator": "つばめ", "text": "残念(o´Д`)=з"},
        { "location": "631/TALK"    , "narrator": "つばめ", "text": "それじゃ"},
        { "location": "632/TALK"    , "narrator": "つばめ", "text": "やめよぅかな？(･Д･｀)"},
        { "location": "634/SEL"     , "narrator": "", "text": "買って着て見せてよ！"},
        { "location": "635/SEL"     , "narrator": "", "text": "アーヤに聞いてみるのは？"},
        { "location": "636/ACT"     , "narrator": "", "text": "買って着て見せてよ！"},
        { "location": "639/TALK"    , "narrator": "つばめ", "text": "見せませんー"},
        { "location": "650/TALK"    , "narrator": "つばめ", "text": "$handle$さんって、\nえっちな人なの\nかなぁ…？"},
        { "location": "652/TALK"    , "narrator": "アーヤ", "text": "あら？\nつばめの持ってる\nその下着――"},
        { "location": "656/TALK"    , "narrator": "つばめ", "text": "えっ！？\nあ、これはその、\n卯月さんが…。"},
        { "location": "657/TALK"    , "narrator": "アーヤ", "text": "可愛くていいわね。"},
        { "location": "659/TALK"    , "narrator": "つばめ", "text": "えぇっ！？\nでも、デザインが\nちょっと…。"},
        { "location": "660/TALK"    , "narrator": "アーヤ", "text": "うーん、慣れてないと\nちょっと付けづらく\n思えるかしら？"},
        { "location": "661/TALK"    , "narrator": "アーヤ", "text": "けど、つばめだって\n高校生の女の子なん\nだから――"},
        { "location": "662/TALK"    , "narrator": "アーヤ", "text": "これくらいいいと\n思うけど？"},
        { "location": "664/TALK"    , "narrator": "つばめ", "text": "そ、そうですか？"},
        { "location": "665/TALK"    , "narrator": "アーヤ", "text": "もちろん、学校には\n付けてかない方が\nいいと思うけどね。"},
        { "location": "668/TALK"    , "narrator": "ガブリエラ", "text": "ちょっと、何それ？\nあたしには早いとか\n言ってたくせに。"},
        { "location": "671/TALK"    , "narrator": "アーヤ", "text": "ギャヴィに\n黒は早すぎよ。"},
        { "location": "672/TALK"    , "narrator": "ガブリエラ", "text": "またそうやって\n子ども扱いして！"},
        { "location": "673/TALK"    , "narrator": "ガブリエラ", "text": "あたしだって\n黒い下着くらい\n着こなせるわよ！"},
        { "location": "675/TALK"    , "narrator": "アーヤ", "text": "着こなすって…、\n別に見せる相手も\nいないくせに…。"},
        { "location": "676/TALK"    , "narrator": "ガブリエラ", "text": "なっ！？"},
        { "location": "677/TALK"    , "narrator": "ガブリエラ", "text": "そ、それ言うなら\nアーヤもでしょ！"},
        { "location": "678/TALK"    , "narrator": "アーヤ", "text": "私は黒なんて\n買ってないわ。"},
        { "location": "679/TALK"    , "narrator": "ガブリエラ", "text": "でも持ってるじゃん。\n前に銭湯で付けてたの\n見たわよ？"},
        { "location": "680/TALK"    , "narrator": "アーヤ", "text": "そりゃ、私はもう\n成人してるし。"},
        { "location": "682/TALK"    , "narrator": "ガブリエラ", "text": "なのに見せる相手が\nいないのね…。"},
        { "location": "684/TALK"    , "narrator": "アーヤ", "text": "そ、そういう変なこと\n言わないの！"},
        { "location": "685/TALK"    , "narrator": "ガブリエラ", "text": "最初に言ったのは\nアーヤじゃん！"},
        { "location": "688/TALK"    , "narrator": "つばめ", "text": "ふ、二人とも\n落ち着いて――"},
        { "location": "692/TALK"    , "narrator": "神楽", "text": "相手ならいますよ。"},
        { "location": "693/TALK"    , "narrator": "アーヤ", "text": "は？"},
        { "location": "703/TALK"    , "narrator": "神楽", "text": "皆さん、見せる\n相手ならいるじゃ\nないですか。"},
        { "location": "705/TALK"    , "narrator": "つばめ", "text": "え！？　誰のこと！？"},
        { "location": "708/TALK"    , "narrator": "神楽", "text": "私たちですよ。"},
        { "location": "709/TALK"    , "narrator": "神楽", "text": "ランジェリー\nパーティーを\nすれば――"},
        { "location": "710/TALK"    , "narrator": "神楽", "text": "皆さん自慢の下着を、\n堂々とお披露目する\nことができるんです！"},
        { "location": "711/TALK"    , "narrator": "つばめ", "text": "し、下着でパーティー\nするの！？"},
        { "location": "714/TALK"    , "narrator": "アーヤ", "text": "そういうわけじゃ\nなくて、えっと――"},
        { "location": "715/TALK"    , "narrator": "アーヤ", "text": "パジャマパーティーの\n下着版、って感じ\nかしら？"},
        { "location": "717/TALK"    , "narrator": "つばめ", "text": "で、でも、下着姿\nなんですよね？"},
        { "location": "719/TALK"    , "narrator": "神楽", "text": "大丈夫ですよ。\n私たち以外は\n誰も見てませんし。"},
        { "location": "720/SEL"     , "narrator": "", "text": "$me$が見てるよ"},
        { "location": "722/TALK"    , "narrator": "つばめ", "text": "それでもちょっと\n恥ずかしいけど…。"},
        { "location": "723/TALK"    , "narrator": "神楽", "text": "やってみると、\nそうでもないですよ。"},
        { "location": "724/TALK"    , "narrator": "神楽", "text": "ね、アーヤさん？"},
        { "location": "726/TALK"    , "narrator": "アーヤ", "text": "ね、って言われても、\n私もやったことないん\nだけど…。"},
        { "location": "730/TALK"    , "narrator": "みやび", "text": "みんな、やたらと\n盛り上がっちゅうね。"},
        { "location": "732/TALK"    , "narrator": "神楽", "text": "今、ランジェリー\nパーティーをする\n計画を立てて――"},
        { "location": "733/TALK"    , "narrator": "神楽", "text": "って…みやびさん、\n凄い下着を選んで\nますね…。"},
        { "location": "735/TALK"    , "narrator": "みやび", "text": "ん？　これが何か？"},
        { "location": "737/TALK"    , "narrator": "ガブリエラ", "text": "うわっ、何それ！？\n超ド派手じゃない！"},
        { "location": "738/TALK"    , "narrator": "みやび", "text": "こっちのは地味やぞ。"},
        { "location": "739/TALK"    , "narrator": "神楽", "text": "もう一枚は、その…、\n言いづらいですけど、\nおばさんっぽいです。"},
        { "location": "740/TALK"    , "narrator": "みやび", "text": "うむ、うちもそう\n思うてたちや。"},
        { "location": "742/TALK"    , "narrator": "アーヤ", "text": "そう思うなら\nどうして――"},
        { "location": "745/TALK"    , "narrator": "アーヤ", "text": "あっ…そっか。\nそういうことね。"},
        { "location": "747/TALK"    , "narrator": "つばめ", "text": "どういうことですか？"},
        { "location": "749/TALK"    , "narrator": "アーヤ", "text": "多分、それくらいしか\nサイズがなかったん\nじゃないの？"},
        { "location": "751/TALK"    , "narrator": "みやび", "text": "うむ…うちに合うのが\nこれだけやったがよ。"},
        { "location": "753/TALK"    , "narrator": "つばめ", "text": "大きいサイズって\n置いてないんですか？"},
        { "location": "754/TALK"    , "narrator": "みやび", "text": "無くはないけんど、\nやたらと派手なのが\n多くて――"},
        { "location": "755/TALK"    , "narrator": "みやび", "text": "シンプルなのは\n皆無に近いがよ。"},
        { "location": "756/TALK"    , "narrator": "アーヤ", "text": "…私の友達にも\n胸の大きい子が\nいるんだけど――"},
        { "location": "757/TALK"    , "narrator": "アーヤ", "text": "よくそれ言われるわ。\nワイヤーが入ってると\n痛い、とかも。"},
        { "location": "759/TALK"    , "narrator": "みやび", "text": "サイズが合わんとな。\nやき、ワイヤー無しが\n好きなんやけんど――"},
        { "location": "760/TALK"    , "narrator": "みやび", "text": "まあ、この店には\nなかったき、贅沢は\n言えん。"},
        { "location": "762/TALK"    , "narrator": "神楽", "text": "…なんか、おばさん\nっぽいとか言って、\nすみません…。"},
        { "location": "764/TALK"    , "narrator": "みやび", "text": "いや、構わん構わん。\nうちもそう思うてるん\nやし。"},
        { "location": "765/TALK"    , "narrator": "みやび", "text": "まあ、下着のデザイン\nのことで騒げるんは\n幸せなことやき――"},
        { "location": "766/TALK"    , "narrator": "みやび", "text": "うちに遠慮せんで、\n思いっきり楽しまんと\nいかんぞね。"},
        { "location": "768/TALK"    , "narrator": "みやび", "text": "じゃ、\n買ってくるちや。"},
        { "location": "773/TALK"    , "narrator": "つばめ", "text": "…胸の大きい人って、\n大変なんですね。"},
        { "location": "775/TALK"    , "narrator": "神楽", "text": "デザインを選べない\nなんて…そんなこと\nあるんですね…。"},
        { "location": "777/TALK"    , "narrator": "ガブリエラ", "text": "…あたし、やっぱり\nこの下着やめるわ。"},
        { "location": "779/TALK"    , "narrator": "アーヤ", "text": "え、いいの？\nあんなに黒がいいって\n言ってたのに。"},
        { "location": "780/TALK"    , "narrator": "ガブリエラ", "text": "あたしはみやびと\n違っていつでも\n付けられるし――"},
        { "location": "782/TALK"    , "narrator": "ガブリエラ", "text": "別に、今急いで付ける\n必要ないもの…。"},
        { "location": "783/TALK"    , "narrator": "アーヤ", "text": "私が何言っても\n聞かなかったのに…。"},
        { "location": "785/TALK"    , "narrator": "神楽", "text": "みやびさんの話は、\nそれだけ威力があった\nってことですね…。"},
        { "location": "786/ACT"     , "narrator": "", "text": "$me$が見てるよ"},
        { "location": "803/TALK"    , "narrator": "つばめ", "text": "$handle$さん"},
        { "location": "805/TALK"    , "narrator": "つばめ", "text": "さっきから"},
        { "location": "806/TALK"    , "narrator": "つばめ", "text": "えっちなこと言い過ぎ！ヾ(｡>﹏<｡)ﾉﾞ"},
        { "location": "807/TALK"    , "narrator": "つばめ", "text": "あんまり"},
        { "location": "808/TALK"    , "narrator": "つばめ", "text": "そういうこと言われると"},
        { "location": "809/TALK"    , "narrator": "つばめ", "text": "困っちゃうよ(´つω・｀)ｼｭﾝ"},
        { "location": "813/TALK"    , "narrator": "システム", "text": "『アーヤさんが入室しました』"},
        { "location": "814/TALK"    , "narrator": "システム", "text": "『ガブリエラさんが入室しました』"},
        { "location": "815/TALK"    , "narrator": "アーヤ", "text": "つばめから聞いた"},
        { "location": "816/TALK"    , "narrator": "アーヤ", "text": "セクハラしてるの？(｀ヘ´)"},
        { "location": "817/TALK"    , "narrator": "ガブリエラ", "text": "何をやってるのよ！"},
        { "location": "818/TALK"    , "narrator": "アーヤ", "text": "女の子に下着姿を見せろとか"},
        { "location": "819/TALK"    , "narrator": "アーヤ", "text": "言っちゃダメでしょ（｀皿´ )"},
        { "location": "820/TALK"    , "narrator": "ガブリエラ", "text": "見損なったわ！"},
        { "location": "822/TALK"    , "narrator": "ガブリエラ", "text": "そんなこと言うなんて"},
        { "location": "823/TALK"    , "narrator": "ガブリエラ", "text": "執事失格よ！"},
        { "location": "824/TALK"    , "narrator": "つばめ", "text": "執事？(*´﹃｀*)"},
        { "location": "826/TALK"    , "narrator": "ガブリエラ", "text": "一々突っ込まないでいいから！"},
        { "location": "828/TALK"    , "narrator": "アーヤ", "text": "とにかく"},
        { "location": "829/TALK"    , "narrator": "アーヤ", "text": "つばめは純粋なんだから"},
        { "location": "830/TALK"    , "narrator": "アーヤ", "text": "セクハラ禁止よ！(>_<)"},
        { "location": "832/SEL"     , "narrator": "", "text": "ごめんなさい"},
        { "location": "833/ACT"     , "narrator": "", "text": "ごめんなさい"},
        { "location": "835/TALK"    , "narrator": "つばめ", "text": "ぅぅん(´・ω・｀)"},
        { "location": "836/TALK"    , "narrator": "つばめ", "text": "もぅぃぃから"},
        { "location": "837/TALK"    , "narrator": "つばめ", "text": "ぇっちな話は"},
        { "location": "839/TALK"    , "narrator": "つばめ", "text": "ほどほどにしてね(*´︶`*)"},
        { "location": "841/TALK"    , "narrator": "ガブリエラ", "text": "程々もダメだから！"},
        { "location": "844/TALK"    , "narrator": "つばめ", "text": "ぇぇっ！？"},
        { "location": "849/TALK"    , "narrator": "システム", "text": "『アーヤさんが入室しました』"},
        { "location": "850/TALK"    , "narrator": "システム", "text": "『ガブリエラさんが入室しました』"},
        { "location": "851/TALK"    , "narrator": "アーヤ", "text": "こら(｀ヘ´)"},
        { "location": "852/TALK"    , "narrator": "アーヤ", "text": "つばめにセクハラしたらダメよ"},
        { "location": "853/TALK"    , "narrator": "ガブリエラ", "text": "まったく"},
        { "location": "854/TALK"    , "narrator": "ガブリエラ", "text": "普段つばめにこういうこと言ってたの？"},
        { "location": "856/SEL"     , "narrator": "", "text": "誤解だよ！"},
        { "location": "857/ACT"     , "narrator": "", "text": "誤解だよ！"},
        { "location": "859/TALK"    , "narrator": "ガブリエラ", "text": "説得力ないわよ"},
        { "location": "860/TALK"    , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "861/TALK"    , "narrator": "ガブリエラ", "text": "あんたが見るってことは"},
        { "location": "862/TALK"    , "narrator": "ガブリエラ", "text": "見せる相手がいるってことになるわよね？"},
        { "location": "863/TALK"    , "narrator": "アーヤ", "text": "ならないし"},
        { "location": "864/TALK"    , "narrator": "アーヤ", "text": "スマホとかに"},
        { "location": "865/TALK"    , "narrator": "アーヤ", "text": "下着姿見せるとかダメだから"},
        { "location": "866/TALK"    , "narrator": "ガブリエラ", "text": "見る人がぃればぃぃんでしょ？"},
        { "location": "867/TALK"    , "narrator": "アーヤ", "text": "そっちの方が問題よ(´o｀；"},
        { "location": "868/TALK"    , "narrator": "つばめ", "text": "でも"},
        { "location": "869/TALK"    , "narrator": "つばめ", "text": "ランジェリーパーティーはぃぃんですか？(´･ω･｀) "},
        { "location": "871/TALK"    , "narrator": "アーヤ", "text": "女同士だし"},
        { "location": "872/TALK"    , "narrator": "ガブリエラ", "text": "いやそれも普通に考えて変だし"},
        { "location": "873/TALK"    , "narrator": "アーヤ", "text": "そうかもしれないけど(-ω-;)"},
        { "location": "874/TALK"    , "narrator": "アーヤ", "text": "ギャヴィの言ってることより普通だから"},
        { "location": "875/SEL"     , "narrator": "", "text": "退室"},
        { "location": "876/ACT"     , "narrator": "", "text": "退室"},
        { "location": "881/ACT"     , "narrator": "", "text": "アーヤに聞いてみるのは？"},
        { "location": "883/TALK"    , "narrator": "つばめ", "text": "アーヤさんは"},
        { "location": "884/TALK"    , "narrator": "つばめ", "text": "絶対止めると思ぅ"},
        { "location": "885/TALK"    , "narrator": "つばめ", "text": "わたしには"},
        { "location": "887/TALK"    , "narrator": "つばめ", "text": "絶対早ぃと思ぅし"},
        { "location": "889/SEL"     , "narrator": "", "text": "聞いてみなよ"},
        { "location": "890/ACT"     , "narrator": "", "text": "聞いてみなよ"},
        { "location": "892/TALK"    , "narrator": "つばめ", "text": "ぅーん"},
        { "location": "893/TALK"    , "narrator": "つばめ", "text": "わかった"},
        { "location": "894/TALK"    , "narrator": "つばめ", "text": "聞ぃてみるね"},
        { "location": "905/TALK"    , "narrator": "つばめ", "text": "…聞くまでもないと\n思うんだけど。"},
        { "location": "906/TALK"    , "narrator": "つばめ", "text": "あの、アーヤさん。\nちょっと聞きたいん\nですけど――"},
        { "location": "907/TALK"    , "narrator": "つばめ", "text": "この下着…わたしには\n似合いませんよね？"},
        { "location": "909/TALK"    , "narrator": "アーヤ", "text": "え…そうかしら？\n結構似合うと思う\nわよ？"},
        { "location": "494/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>7月2日　2:18 PM</color>\nとある休日、ランジェリーショップにて。"}
    ]
}
