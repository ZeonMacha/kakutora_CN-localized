{
    "dir": "chap03/battle/btev_ch00_03_00.js",
    "type": "",
    "info": {
        "story_id": "23000",
        "cid": "",
        "title": "000 ココロスフィア解説",
        "sub_title": "ココロの深淵へようこそ"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "ココロスフィア導入ガブリエラ"},
        { "location": "13/DIALOG" , "narrator": "", "text": "<size=40>DOOR-No. 000</size>\nCHIHARU\n\n<size=40>Kokoro.Initialize();</size>\n<size=25>～深層ココロスフィアの概念について～</size>"},
        { "location": "22/TALK"   , "narrator": "千羽鶴", "text": "ようこそ、\nガブリエラの\n深層世界へ。"},
        { "location": "24/TALK"   , "narrator": "千羽鶴", "text": "前にもしてるけど、\n深層世界についての説明、\nもう一度聞く？"},
        { "location": "25/SEL"    , "narrator": "（選択肢）", "text": "はい"},
        { "location": "26/SEL"    , "narrator": "（選択肢）", "text": "いいえ"},
        { "location": "27/ACT"    , "narrator": "", "text": "はい"},
        { "location": "28/TALK"   , "narrator": "千羽鶴", "text": "わかった。\nそれじゃもう一度、\n深層世界の話をする。"},
        { "location": "30/ACT"    , "narrator": "", "text": "いいえ"},
        { "location": "31/TALK"   , "narrator": "千羽鶴", "text": "そう、助かる。"},
        { "location": "47/TALK"   , "narrator": "千羽鶴", "text": "さて。"},
        { "location": "48/TALK"   , "narrator": "千羽鶴", "text": "改めて、\nここはガブリエラの\n深層世界。"},
        { "location": "49/TALK"   , "narrator": "千羽鶴", "text": "最年少14歳の彼女。\nそんな彼女の抱える\n根本的な未完了は――"},
        { "location": "50/SEL"    , "narrator": "（選択肢）", "text": "一人外国に来ていること"},
        { "location": "51/SEL"    , "narrator": "（選択肢）", "text": "友達ができないこと"},
        { "location": "52/SEL"    , "narrator": "（選択肢）", "text": "胸が大きくならないこと"},
        { "location": "53/ACT"    , "narrator": "", "text": "一人外国に来ていること"},
        { "location": "54/TALK"   , "narrator": "千羽鶴", "text": "そうね。確かにそれは、\n彼女にとって、とても\n大きなプレッシャー。"},
        { "location": "55/TALK"   , "narrator": "千羽鶴", "text": "ただ、心の奥底にある\n重大な未完了とは\n直接的な関係じゃない。"},
        { "location": "56/ACT"    , "narrator": "", "text": "友達ができないこと"},
        { "location": "57/TALK"   , "narrator": "千羽鶴", "text": "確かにそれは\n彼女にとっての\n割と大きな悩み。"},
        { "location": "58/TALK"   , "narrator": "千羽鶴", "text": "けど、それを悩んでいる\nのは、表層の彼女。\n深層じゃない。"},
        { "location": "59/ACT"    , "narrator": "", "text": "胸が大きくならないこと"},
        { "location": "60/TALK"   , "narrator": "千羽鶴", "text": "なるほど。"},
        { "location": "61/TALK"   , "narrator": "千羽鶴", "text": "……。"},
        { "location": "62/TALK"   , "narrator": "千羽鶴", "text": "このセリフの１つ下に、\n永久ループのスクリプトを\n入れてやりたい。"},
        { "location": "63/TALK"   , "narrator": "千羽鶴", "text": "そうだ。\n一つ耳寄り情報を\n教えてあげる。"},
        { "location": "64/TALK"   , "narrator": "千羽鶴", "text": "貴方の選んだ会話は\n全て逐一当局によって\n記録されている。"},
        { "location": "65/TALK"   , "narrator": "千羽鶴", "text": "そして、ファーストフラグ\nという、最初に選んだ\n会話も記録されている。"},
        { "location": "66/TALK"   , "narrator": "千羽鶴", "text": "要するに、貴方が如何に\n変態かということは、\n全部蓄積されているの。"},
        { "location": "67/TALK"   , "narrator": "千羽鶴", "text": "だからこれからも、\nジャンジャン変態発言を\nするといいと思う。"},
        { "location": "68/TALK"   , "narrator": "千羽鶴", "text": "さて、\n本題に戻るけど。"},
        { "location": "70/TALK"   , "narrator": "千羽鶴", "text": "ガブリエラの心の奥底に\n巣くうもの。"},
        { "location": "71/TALK"   , "narrator": "千羽鶴", "text": "それはあまりに\n深くて暗い。"},
        { "location": "72/TALK"   , "narrator": "千羽鶴", "text": "貴方がここまでで見てきた\n彼女からは、想像も\nできないくらいに。"},
        { "location": "73/TALK"   , "narrator": "千羽鶴", "text": "そしてそれは、この\n深層世界を旅しなければ、\nずっとわからない。"},
        { "location": "74/TALK"   , "narrator": "千羽鶴", "text": "それだけでも、\n支え甲斐と介入する価値が\nあると思わない？"},
        { "location": "75/SEL"    , "narrator": "（選択肢）", "text": "はい"},
        { "location": "76/SEL"    , "narrator": "（選択肢）", "text": "いいえ"},
        { "location": "77/SEL"    , "narrator": "（選択肢）", "text": "千羽鶴の方が興味ある"},
        { "location": "78/ACT"    , "narrator": "", "text": "はい"},
        { "location": "79/TALK"   , "narrator": "千羽鶴", "text": "まあでも。"},
        { "location": "80/ACT"    , "narrator": "", "text": "いいえ"},
        { "location": "81/TALK"   , "narrator": "千羽鶴", "text": "そう。まあ確かに、\n興味無い子がどんな闇を\n抱えていても関係無い。"},
        { "location": "82/TALK"   , "narrator": "千羽鶴", "text": "それに。"},
        { "location": "83/ACT"    , "narrator": "", "text": "千羽鶴の方が興味ある"},
        { "location": "86/TALK"   , "narrator": "千羽鶴", "text": "もうここでは\n何も出ませんよ。"},
        { "location": "87/TALK"   , "narrator": "千羽鶴", "text": "そんなことより、\nガブリエラのココロを\n癒してあげて。"},
        { "location": "92/TALK"   , "narrator": "千羽鶴", "text": "……ほんとに。"},
        { "location": "93/TALK"   , "narrator": "千羽鶴", "text": "ホントにしつこい人。"},
        { "location": "94/TALK"   , "narrator": "千羽鶴", "text": "そんなに私の\n心の中を見たい？"},
        { "location": "95/SEL"    , "narrator": "（選択肢）", "text": "はい"},
        { "location": "96/SEL"    , "narrator": "（選択肢）", "text": "いいえ"},
        { "location": "97/ACT"    , "narrator": "", "text": "はい"},
        { "location": "98/TALK"   , "narrator": "千羽鶴", "text": "おぞましすぎて、\n現実に帰って来れなく\nなるかもしれないけど。"},
        { "location": "99/TALK"   , "narrator": "千羽鶴", "text": "……。"},
        { "location": "100/TALK"  , "narrator": "千羽鶴", "text": "まあ、それでもと言うなら\nいずれ何か見せられる日が\n来るかもしれない。"},
        { "location": "101/ACT"   , "narrator": "", "text": "いいえ"},
        { "location": "102/TALK"  , "narrator": "千羽鶴", "text": "それが正しい判断。\n私の中を覗いても、\nろくなことがないから。"},
        { "location": "104/TALK"  , "narrator": "千羽鶴", "text": "とにかく。\n貴方の実直すぎるアホに\n免じて、ご褒美あげる。"},
        { "location": "114/TALK"  , "narrator": "千羽鶴", "text": "何にしても今は、\nガブリエラのココロを\n癒してあげて。"},
        { "location": "118/TALK"  , "narrator": "千羽鶴", "text": "しつこいです。\nさっさとガブリエラの\nココロを癒してあげて。"},
        { "location": "122/TALK"  , "narrator": "千羽鶴", "text": "だから、私は\nチュートリアルキャラ。\nココロなんて存在しない。"},
        { "location": "123/TALK"  , "narrator": "千羽鶴", "text": "さっさとガブリエラの\nココロを癒してあげて。"},
        { "location": "127/TALK"  , "narrator": "千羽鶴", "text": "残念だけど、私は単なる\nチュートリアルキャラ。\nココロなんて存在しない。"},
        { "location": "128/TALK"  , "narrator": "千羽鶴", "text": "今はガブリエラの\nココロを癒すことに\n集中して。"},
        { "location": "133/TALK"  , "narrator": "千羽鶴", "text": "話を戻すけど。\n彼女の心の中は\n確かに簡単じゃない。"},
        { "location": "135/TALK"  , "narrator": "千羽鶴", "text": "想像している以上に\n厳しいことも\nあるかもしれない。"},
        { "location": "136/TALK"  , "narrator": "千羽鶴", "text": "けど、彼女にとっては、\nそれ程までに生きる為に\n大事なことなの。"},
        { "location": "137/TALK"  , "narrator": "千羽鶴", "text": "だから是非、\n真摯に向かい合って\n支えてあげてほしい。"},
        { "location": "138/TALK"  , "narrator": "千羽鶴", "text": "貴方とガブリエラに、\n素晴らしきココロの旅を。"}
    ]
}
