{
    "dir": "chap22/daydra/dd_ch03_22_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "22352",
        "cid": "gabriella",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "気分を変えて"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "気分を変えて"},
        { "location": "21/TALK"   , "narrator": "つばめ", "text": "アーヤさん、どこか\n出かけるんですか？"},
        { "location": "25/TALK"   , "narrator": "アーヤ", "text": "うん、ちょっと遠出して、\nショッピングモールに\n行こうと思うの。"},
        { "location": "26/TALK"   , "narrator": "つばめ", "text": "そういえば、こっちに\n来てから行ってませんね。"},
        { "location": "29/TALK"   , "narrator": "アーヤ", "text": "うん…だからかしら？\n朝起きたら急に行きたい\n気持ちになっちゃって…。"},
        { "location": "31/TALK"   , "narrator": "アーヤ", "text": "みんなは、今日は\nどうする予定なの？"},
        { "location": "33/TALK"   , "narrator": "つばめ", "text": "ちょっと悩み中です。\nこの辺りの探検も\nしてみたいけど――"},
        { "location": "35/TALK"   , "narrator": "つばめ", "text": "電車に乗って、ただ景色を\n眺めるのも面白そうだな、\nとも思ってて…。"},
        { "location": "37/TALK"   , "narrator": "神楽", "text": "電車ってことは、\nひなこさんですね？"},
        { "location": "39/TALK"   , "narrator": "つばめ", "text": "うん。昨日の夜、\nＷＡＶＥで誘われたんだ。"},
        { "location": "41/TALK"   , "narrator": "ガブリエラ", "text": "まあ、見慣れない景色\nばかりだから、意外と\n楽しめそうよね。"},
        { "location": "44/TALK"   , "narrator": "つばめ", "text": "うん…どうしようかなぁ？"},
        { "location": "46/TALK"   , "narrator": "つばめ", "text": "神楽ちゃんはどこか\n行きたいところある？"},
        { "location": "47/TALK"   , "narrator": "神楽", "text": "私は特に…つばめさんに\n付いていきますよ。"},
        { "location": "49/TALK"   , "narrator": "アーヤ", "text": "ギャヴィは？"},
        { "location": "50/TALK"   , "narrator": "ガブリエラ", "text": "…まだ悩み中よ。"},
        { "location": "52/TALK"   , "narrator": "つばめ", "text": "あっ、ひなこちゃんから\nＷＡＶＥ来ちゃった。"},
        { "location": "53/TALK"   , "narrator": "神楽", "text": "もう電車にしちゃって\nいいんじゃないですか？"},
        { "location": "54/TALK"   , "narrator": "神楽", "text": "ひなこさん達も一緒なら、\n選択の幅が広がると\n思いますし。"},
        { "location": "57/TALK"   , "narrator": "つばめ", "text": "う～ん…。"},
        { "location": "59/TALK"   , "narrator": "ガブリエラ", "text": "…あたしも、いい加減\n何か決めないと。"},
        { "location": "71/TALK"   , "narrator": "ガブリエラ", "text": "$marzanna$、今日の予定をどうするか考えてるんだけど"},
        { "location": "72/TALK"   , "narrator": "ガブリエラ", "text": "中々思いつかなくて困ってるの"},
        { "location": "74/SEL"    , "narrator": "", "text": "行きたいところはないの？"},
        { "location": "75/ACT"    , "narrator": "", "text": "行きたいところはないの？"},
        { "location": "77/TALK"   , "narrator": "ガブリエラ", "text": "この辺りって、どういうものがあるのかよくわかってないから"},
        { "location": "78/TALK"   , "narrator": "ガブリエラ", "text": "どこに行きたいか考えようがないのよ"},
        { "location": "79/TALK"   , "narrator": "ガブリエラ", "text": "もう、これならアーヤと一緒にショッピングモール行った方がいいかしら？"},
        { "location": "81/SEL"    , "narrator": "", "text": "それでいいんじゃない？"},
        { "location": "82/SEL"    , "narrator": "", "text": "近くに何かないの？"},
        { "location": "83/ACT"    , "narrator": "", "text": "それでいいんじゃない？"},
        { "location": "84/TALK"   , "narrator": "ガブリエラ", "text": "そうね…"},
        { "location": "85/TALK"   , "narrator": "ガブリエラ", "text": "ショッピングモールなら、色々施設もあるから楽しめそうだし"},
        { "location": "86/TALK"   , "narrator": "ガブリエラ", "text": "そうしてみるわ"},
        { "location": "98/TALK"   , "narrator": "ガブリエラ", "text": "アーヤ、あたしも一緒に\n行くから、ちょっと\n待ってて。"},
        { "location": "117/TALK"  , "narrator": "ガブリエラ", "text": "あっ、あそこの帽子、\n可愛くて良さそうじゃ\nない？"},
        { "location": "120/TALK"  , "narrator": "アーヤ", "text": "あら、いいじゃない。\n形も可愛いし、それに\n凄く涼しげな感じで。"},
        { "location": "123/TALK"  , "narrator": "ガブリエラ", "text": "今持ってる服と\n合わせるのが難しそう\nだけど、う～ん…。"},
        { "location": "124/TALK"  , "narrator": "アーヤ", "text": "なら、服も一緒に\n買ったら？"},
        { "location": "126/TALK"  , "narrator": "ガブリエラ", "text": "あんまり荷物増やしたら、\n帰る時大変でしょ？"},
        { "location": "127/TALK"  , "narrator": "アーヤ", "text": "一着や二着増えても\n変わらないって。"},
        { "location": "129/TALK"  , "narrator": "ガブリエラ", "text": "そうかもしれないけど…。"},
        { "location": "131/TALK"  , "narrator": "ガブリエラ", "text": "っていうか、アーヤは\nちょっと買い過ぎだから。"},
        { "location": "134/TALK"  , "narrator": "アーヤ", "text": "仕方ないじゃない。\n素敵だな、って\n思っちゃったんだから。"},
        { "location": "135/TALK"  , "narrator": "アーヤ", "text": "そう思ったら買わないと、\n後で絶対後悔するわ。"},
        { "location": "137/TALK"  , "narrator": "ガブリエラ", "text": "…帰り、大荷物になっても\n手伝わないわよ？"},
        { "location": "140/TALK"  , "narrator": "アーヤ", "text": "平気よ。\n荷物は宅急便で寮まで\n送るつもりだし。"},
        { "location": "142/TALK"  , "narrator": "ガブリエラ", "text": "…旅慣れてる感じが\n凄いわね。"},
        { "location": "143/TALK"  , "narrator": "ガブリエラ", "text": "っていうか、\nそろそろお昼じゃん。"},
        { "location": "145/TALK"  , "narrator": "ガブリエラ", "text": "買い物は中断して\nお昼ご飯にしよ。"},
        { "location": "162/TALK"  , "narrator": "アーヤ", "text": "あー、楽しかった！\nギャヴィはどうだった？"},
        { "location": "163/TALK"  , "narrator": "ガブリエラ", "text": "うん、楽しかったわ。"},
        { "location": "165/TALK"  , "narrator": "ガブリエラ", "text": "ショッピングモールって、\nどこも変わり映えしない\nだろうから――"},
        { "location": "166/TALK"  , "narrator": "ガブリエラ", "text": "最初は暇潰しくらいに\nなればいいかな、って\n思ってたんだけど――"},
        { "location": "167/TALK"  , "narrator": "ガブリエラ", "text": "おもいっきり一日中\n楽しんじゃった。"},
        { "location": "169/TALK"  , "narrator": "アーヤ", "text": "ふふっ…久しぶりに\n都会っぽい空気に\n触れたからかしらね？"},
        { "location": "170/TALK"  , "narrator": "ガブリエラ", "text": "うん、そうかも。"},
        { "location": "172/TALK"  , "narrator": "ガブリエラ", "text": "ここも凄く素敵で、\nいいところだと\n思うけど――"},
        { "location": "173/TALK"  , "narrator": "ガブリエラ", "text": "そろそろ東京にも\n戻りたいな…。"},
        { "location": "174/ACT"   , "narrator": "", "text": "近くに何かないの？"},
        { "location": "176/TALK"  , "narrator": "ガブリエラ", "text": "海くらいしかないと思うけど"},
        { "location": "177/TALK"  , "narrator": "ガブリエラ", "text": "あ、でも確か"},
        { "location": "178/TALK"  , "narrator": "ガブリエラ", "text": "駅前に何か看板があったような…"},
        { "location": "190/TALK"  , "narrator": "ガブリエラ", "text": "ねえ、確か駅前に、\n何かの看板があったと\n思ったんだけど…。"},
        { "location": "193/TALK"  , "narrator": "つばめ", "text": "看板？"},
        { "location": "195/TALK"  , "narrator": "つばめ", "text": "あっ、そういえば！\n確かあれは――"},
        { "location": "214/TALK"  , "narrator": "ガブリエラ", "text": "か、可愛い！！\nほら、つばめ、神楽！\nあれ見て、あれ！"},
        { "location": "216/TALK"  , "narrator": "神楽", "text": "ちゃんと見てますよー。\n可愛いペンギンですね。"},
        { "location": "218/TALK"  , "narrator": "つばめ", "text": "あはは、手がピコピコ\n動いてる。"},
        { "location": "220/TALK"  , "narrator": "ガブリエラ", "text": "あの手の動き、\n超可愛いんだけど！？"},
        { "location": "222/TALK"  , "narrator": "ガブリエラ", "text": "いいなぁ…\nペンギン飼いたいなぁ…。"},
        { "location": "224/TALK"  , "narrator": "つばめ", "text": "ふふっ…ガブちゃん、\n凄く楽しんでるね。"},
        { "location": "226/TALK"  , "narrator": "神楽", "text": "ガブちゃんがあんなに\n無邪気な笑顔をしている\nところ――"},
        { "location": "227/TALK"  , "narrator": "神楽", "text": "私、初めて見ました。"},
        { "location": "228/TALK"  , "narrator": "ガブリエラ", "text": "いいなぁ…実家の近くに\nこんな水族館がある\nなんて…。"},
        { "location": "230/TALK"  , "narrator": "ガブリエラ", "text": "やっぱり、みやびも\nここにはよく来てたの\nかしら？"},
        { "location": "233/TALK"  , "narrator": "つばめ", "text": "う～ん…どうかなぁ？\nあんまりイメージ\nわかないけど…。"},
        { "location": "235/TALK"  , "narrator": "神楽", "text": "みやびさん、外出と\n人混みが大嫌いです\nからね…。"},
        { "location": "245/TALK"  , "narrator": "みやび", "text": "…っくしゅん！"},
        { "location": "246/SEL"   , "narrator": "", "text": "近くに水族館があって良いね"},
        { "location": "249/TALK"  , "narrator": "みやび", "text": "…夏風邪か？\nいや、体調はどこも\n悪くないき――"},
        { "location": "250/TALK"  , "narrator": "みやび", "text": "噂でもされゆうが？"},
        { "location": "253/TALK"  , "narrator": "みやび", "text": "…一応、風邪薬飲んで\nおくか。"},
        { "location": "254/ACT"   , "narrator": "", "text": "近くに水族館があって良いね"},
        { "location": "273/TALK"  , "narrator": "みやび", "text": "ああ、あそこの水族館か"},
        { "location": "274/TALK"  , "narrator": "みやび", "text": "行ったことないからわからんよ"},
        { "location": "20/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>8月20日　 10:34 AM</color>\n合宿中、みやびの実家でのこと"}
    ]
}
