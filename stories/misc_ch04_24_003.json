    "entry":
    [
        { "location": "148/SCENARIO", "narrator": "", "text": "眠るにはまだ早い"},
        { "location": "173/TALK"    , "narrator": "みやび", "text": "今日は色々あり過ぎて"},
        { "location": "174/TALK"    , "narrator": "みやび", "text": "昼間すやすやと眠ってしまった"},
        { "location": "175/TALK"    , "narrator": "みやび", "text": "故に"},
        { "location": "176/TALK"    , "narrator": "みやび", "text": "今目が冴えて仕方がないんじゃよ"},
        { "location": "178/SEL"     , "narrator": "", "text": "ねーむーれーよーいーこーよー"},
        { "location": "179/SEL"     , "narrator": "", "text": "温めた牛乳飲むといいよ"},
        { "location": "180/SEL"     , "narrator": "", "text": "朝まででも付き合うよ"},
        { "location": "181/ACT"     , "narrator": "", "text": "ねーむーれーよーいーこーよー"},
        { "location": "182/TALK"    , "narrator": "みやび", "text": "ぐー"},
        { "location": "183/ACT"     , "narrator": "", "text": "温めた牛乳飲むといいよ"},
        { "location": "184/TALK"    , "narrator": "みやび", "text": "さよけ"},
        { "location": "185/TALK"    , "narrator": "みやび", "text": "そうする"},
        { "location": "186/ACT"     , "narrator": "", "text": "朝まででも付き合うよ"},
        { "location": "188/TALK"    , "narrator": "みやび", "text": "うむ"},
        { "location": "190/TALK"    , "narrator": "みやび", "text": "さすが相棒"},
        { "location": "192/SEL"     , "narrator": "", "text": "当然だよ"},
        { "location": "193/SEL"     , "narrator": "", "text": "$me$も眠くないから"},
        { "location": "194/SEL"     , "narrator": "", "text": "ホントは添い寝したいんだけどね"},
        { "location": "195/ACT"     , "narrator": "", "text": "当然だよ"},
        { "location": "196/TALK"    , "narrator": "みやび", "text": "ほう"},
        { "location": "197/ACT"     , "narrator": "", "text": "$me$も眠くないから"},
        { "location": "198/TALK"    , "narrator": "みやび", "text": "なかなか"},
        { "location": "199/TALK"    , "narrator": "みやび", "text": "配慮した受け答え"},
        { "location": "200/ACT"     , "narrator": "", "text": "ホントは添い寝したいんだけどね"},
        { "location": "202/TALK"    , "narrator": "みやび", "text": "そういうことは"},
        { "location": "203/TALK"    , "narrator": "みやび", "text": "隣に来れるようになってから言え"},
        { "location": "205/TALK"    , "narrator": "みやび", "text": "では夜通し"},
        { "location": "206/TALK"    , "narrator": "みやび", "text": "六法全書でも読み合わせるとするか"},
        { "location": "208/SEL"     , "narrator": "", "text": "日本国憲法でいいのかな？"},
        { "location": "209/SEL"     , "narrator": "", "text": "刑事訴訟法萌えるよね"},
        { "location": "210/SEL"     , "narrator": "", "text": "$me$のワンマンライブの方がよくない？"},
        { "location": "211/ACT"     , "narrator": "", "text": "日本国憲法でいいのかな？"},
        { "location": "212/TALK"    , "narrator": "みやび", "text": "いや"},
        { "location": "213/TALK"    , "narrator": "みやび", "text": "やはりよくないかも"},
        { "location": "214/ACT"     , "narrator": "", "text": "刑事訴訟法萌えるよね"},
        { "location": "215/TALK"    , "narrator": "みやび", "text": "萌えなのか"},
        { "location": "217/TALK"    , "narrator": "みやび", "text": "特殊な思考をお持ちのようで"},
        { "location": "218/ACT"     , "narrator": "", "text": "$me$のワンマンライブの方がよくない？"},
        { "location": "219/TALK"    , "narrator": "みやび", "text": "興味はある"},
        { "location": "220/TALK"    , "narrator": "みやび", "text": "が"},
        { "location": "221/TALK"    , "narrator": "みやび", "text": "あまりにも準備不足では"},
        { "location": "223/TALK"    , "narrator": "みやび", "text": "まあよい"},
        { "location": "224/TALK"    , "narrator": "みやび", "text": "リラックスしたのか"},
        { "location": "225/TALK"    , "narrator": "みやび", "text": "眠くなってきたので"},
        { "location": "226/TALK"    , "narrator": "みやび", "text": "寝る"},
        { "location": "227/TALK"    , "narrator": "みやび", "text": "ぐー"}
    ]
}
