{
    "dir": "chap00/daydra/spev_ch03_007.js",
    "type": "",
    "info": {
        "story_id": "3007",
        "cid": "",
        "title": "スペシャルエピソード",
        "sub_title": "神楽ちゃんとアルバイト"
    },
    "entry":
    [
        { "location": "34/TALK" , "narrator": "透明神楽", "text": "きゃーっ！\n思った通りです！"},
        { "location": "35/TALK" , "narrator": "透明神楽", "text": "やっぱりガブちゃんは\nメイド服が似合いますね。"},
        { "location": "36/TALK" , "narrator": "透明ガブリエラ", "text": "…………。"},
        { "location": "38/TALK" , "narrator": "透明神楽", "text": "もぅ、ダメですよ。\nメイドさんなんだから\n笑顔にならないと。"},
        { "location": "41/TALK" , "narrator": "透明ガブリエラ", "text": "あのね…アルバイトする\nとは聞いてたけど…。"},
        { "location": "42/TALK" , "narrator": "透明ガブリエラ", "text": "いきなりメイド喫茶に\n連れてこられたら、\n心の準備ができないわよ。"},
        { "location": "43/TALK" , "narrator": "透明神楽", "text": "でも、ガブちゃんに土木\n作業や治験のバイトなんて\nさせられませんし…。"},
        { "location": "44/TALK" , "narrator": "透明ガブリエラ", "text": "それは無理だから！\nそのどっちかだったら、\n絶対却下してたわ。"},
        { "location": "45/TALK" , "narrator": "透明神楽", "text": "じゃあ、却下しなかった\nメイド喫茶は合格って\nことですね？"},
        { "location": "46/TALK" , "narrator": "透明ガブリエラ", "text": "…せめて、前日の夜には\n教えてほしかった、って\n言ってるの！"},
        { "location": "48/TALK" , "narrator": "透明神楽", "text": "そんなに緊張しちゃい\nますか？"},
        { "location": "49/TALK" , "narrator": "透明ガブリエラ", "text": "当然でしょ！？\nいきなりメイド服着て\n給仕しろだなんて…。"},
        { "location": "51/TALK" , "narrator": "透明神楽", "text": "うーん…。"},
        { "location": "53/TALK" , "narrator": "透明神楽", "text": "その割には、\n更衣室で嬉しそうに\n自撮りしてたような…。"},
        { "location": "55/TALK" , "narrator": "透明ガブリエラ", "text": "ちょっと、聞いてるの？"},
        { "location": "56/TALK" , "narrator": "透明神楽", "text": "あ、はい。\nちゃんと聞いてますよ。"},
        { "location": "57/TALK" , "narrator": "透明神楽", "text": "でも、デートコースは\n当日まで秘密にして\nおいた方が…。"},
        { "location": "58/TALK" , "narrator": "透明神楽", "text": "ドキドキ感あって\n楽しいと思いませんか？"},
        { "location": "61/TALK" , "narrator": "透明ガブリエラ", "text": "あくまでもこれを\nデートって言うのね…。"},
        { "location": "63/TALK" , "narrator": "透明ガブリエラ", "text": "まあ、いいわ。\nとにかく今はこのお店の\nメイドさんなんだから…。"},
        { "location": "64/TALK" , "narrator": "透明ガブリエラ", "text": "やる以上は、このお店で\n一番のメイドさんを\n目指すわ。"},
        { "location": "66/TALK" , "narrator": "透明神楽", "text": "素敵です！"},
        { "location": "67/TALK" , "narrator": "透明神楽", "text": "なんだかんだ言っても、\nそう言ってくれると\n信じてました。"},
        { "location": "68/TALK" , "narrator": "透明ガブリエラ", "text": "無理言ってお店に\nお願いしたんでしょ？"},
        { "location": "69/TALK" , "narrator": "透明ガブリエラ", "text": "なのに、中途半端な\n仕事なんてできないわ。"},
        { "location": "70/TALK" , "narrator": "透明神楽", "text": "…あ、お店の中を\n覗いている人が\nいますね。"},
        { "location": "72/TALK" , "narrator": "透明ガブリエラ", "text": "入ってくるかしら？\n神楽、あたしのメイド服、\n変になってない？"},
        { "location": "73/TALK" , "narrator": "透明神楽", "text": "文句なしの完璧です。\nとっても可愛いですよ。"},
        { "location": "74/TALK" , "narrator": "透明ガブリエラ", "text": "そう…。"},
        { "location": "75/TALK" , "narrator": "透明ガブリエラ", "text": "…神楽の方も、\n悪くないわよ。"},
        { "location": "77/TALK" , "narrator": "透明神楽", "text": "えっ？"},
        { "location": "78/TALK" , "narrator": "透明ガブリエラ", "text": "ほ、ほら、準備して！"},
        { "location": "82/TALK" , "narrator": "透明ガブリエラ", "text": "お帰りなさいませ、\nご主人さ…。"},
        { "location": "83/TALK" , "narrator": "透明真幌", "text": "…おっ、二人とも\nやってるな？"},
        { "location": "85/TALK" , "narrator": "透明ガブリエラ", "text": "ま、まほ！？"},
        { "location": "87/TALK" , "narrator": "透明神楽", "text": "あ、お帰りなさい、\n真幌お嬢様！"},
        { "location": "89/TALK" , "narrator": "透明ガブリエラ", "text": "ちょ、なんで！？\nどうしてまほがここに！？"},
        { "location": "90/TALK" , "narrator": "透明真幌", "text": "いや、卯月がギャヴィと\n一日だけメイドをやると\n言われてな。"},
        { "location": "91/TALK" , "narrator": "透明真幌", "text": "多分、恥ずかしくて\nいきなり接客は無理だと\n思うから…。"},
        { "location": "92/TALK" , "narrator": "透明真幌", "text": "少しでも慣れるように、\n客として来てくれと\n頼まれたんだ。"},
        { "location": "93/TALK" , "narrator": "透明ガブリエラ", "text": "か、神楽…あんたねぇ！"},
        { "location": "94/TALK" , "narrator": "透明神楽", "text": "ほら、ガブちゃん。\nお嬢様をお席に\n案内してください。"},
        { "location": "95/TALK" , "narrator": "透明真幌", "text": "ギャヴィ、仕事中だろ？\nメイドに徹しろ。"},
        { "location": "97/TALK" , "narrator": "透明ガブリエラ", "text": "うっ…こ、こちらです、\nお嬢様…。"},
        { "location": "98/TALK" , "narrator": "透明真幌", "text": "ふむ…しかし似合うな。\nとっても可愛いぞ、\nギャヴィ。"},
        { "location": "99/TALK" , "narrator": "透明ガブリエラ", "text": "っ！？"},
        { "location": "100/TALK", "narrator": "透明神楽", "text": "ですよね！\n私もずーっとそう思って\nいたんですよ。"},
        { "location": "101/TALK", "narrator": "透明真幌", "text": "だが卯月、おまえだって\nとても可愛いぞ。"},
        { "location": "102/TALK", "narrator": "透明神楽", "text": "ありがとうございます！"},
        { "location": "104/TALK", "narrator": "透明神楽", "text": "実は、さっき\nガブちゃんにも\n褒めてもらったんです。"},
        { "location": "105/TALK", "narrator": "透明真幌", "text": "ギャヴィが素直に\n褒めるとは、珍しいことも\nあるものだ。"},
        { "location": "106/TALK", "narrator": "透明ガブリエラ", "text": "ちょ！？　わ、悪くない\nって言っただけでしょ！？"},
        { "location": "107/TALK", "narrator": "透明真幌", "text": "ははは、まあ今日一日、\n仲良くメイドとして\n励むんだな。"},
        { "location": "109/TALK", "narrator": "透明ガブリエラ", "text": "…本当、なんのバイトを\nするのか確認しとけば\nよかった…。"}
    ]
}
