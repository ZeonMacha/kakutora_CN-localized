{
    "dir": "chap11/daydra/dd_ch03_11_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "11352",
        "cid": "gabriella",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "ガブリエラ日記"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "ガブリエラ日記"},
        { "location": "24/TALK"   , "narrator": "ガブリエラ", "text": "ふぁ～…今日も暇ねぇ…。"},
        { "location": "25/TALK"   , "narrator": "ガブリエラ", "text": "…こうしてボーッと\nしてると、なんだか\n眠くなってくるわ。"},
        { "location": "26/TALK"   , "narrator": "ガブリエラ", "text": "時間も勿体ないし…。"},
        { "location": "27/TALK"   , "narrator": "ガブリエラ", "text": "今のうちに、少しだけ\n日記書いとこうかしら。"},
        { "location": "28/TALK"   , "narrator": "ガブリエラ", "text": "えっと、確か鞄の中に…\nっと、あったあった。"},
        { "location": "30/TALK"   , "narrator": "ガブリエラ", "text": "さて、と…。"},
        { "location": "31/TALK"   , "narrator": "ガブリエラ", "text": "○月×日。\n今日はとても素敵な一日\nだったから――"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "書くことが多くて、\nちょっと大変かも。"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "午前の授業、今日は凄く\n眠かったけど、どうにか\n眠らずに頑張れた。"},
        { "location": "35/TALK"   , "narrator": "ガブリエラ", "text": "そんな自分へのご褒美に、\nお昼ご飯はちょっとだけ\n豪華にデザート追加。"},
        { "location": "36/SEL"    , "narrator": "", "text": "そんな一日だったの？"},
        { "location": "38/TALK"   , "narrator": "ガブリエラ", "text": "やる気の補給完了！\nおかげで午後の授業は\n完璧、ＧＯＯＤ☆"},
        { "location": "39/TALK"   , "narrator": "ガブリエラ", "text": "もちろん、放課後は\nバイトの前にプチ休憩。"},
        { "location": "40/TALK"   , "narrator": "ガブリエラ", "text": "お友達と一緒にカフェで\nお喋りしながらの\nティータイム。"},
        { "location": "42/TALK"   , "narrator": "ガブリエラ", "text": "恋バナとか、私にはまだ\n早過ぎ？"},
        { "location": "45/TALK"   , "narrator": "ガブリエラ", "text": "早くバイトを終わらせて、\n夜はまたお友達と\nお話したいな。"},
        { "location": "48/TALK"   , "narrator": "ガブリエラ", "text": "…ん、こんなもんかしら？"},
        { "location": "49/TALK"   , "narrator": "ガブリエラ", "text": "っていうか、時間潰しにも\nならなかったわね。"},
        { "location": "50/TALK"   , "narrator": "ガブリエラ", "text": "…動画サイトでも見て、\n時間潰そう。"},
        { "location": "52/ACT"    , "narrator": "", "text": "そんな一日だったの？"},
        { "location": "57/TALK"   , "narrator": "ガブリエラ", "text": "えっ…やだ！！"},
        { "location": "71/TALK"   , "narrator": "ガブリエラ", "text": "もう、マルザンナ！"},
        { "location": "73/TALK"   , "narrator": "ガブリエラ", "text": "人の日記を見るのはマナー違反よ！？"},
        { "location": "74/TALK"   , "narrator": "ガブリエラ", "text": "…でも、マルザンナで安心したけど"},
        { "location": "75/TALK"   , "narrator": "ガブリエラ", "text": "この日記はね、日記の中に、自分の願望を混ぜて書いてるの"},
        { "location": "76/TALK"   , "narrator": "ガブリエラ", "text": "こうだったら良かったな、こうだったら楽しかっただろうなぁ、って"},
        { "location": "77/TALK"   , "narrator": "ガブリエラ", "text": "そうやって書くと、意外と面白いのよ？"},
        { "location": "80/SEL"    , "narrator": "", "text": "願望じゃない部分はどこ？"},
        { "location": "81/ACT"    , "narrator": "", "text": "願望じゃない部分はどこ？"},
        { "location": "83/TALK"   , "narrator": "ガブリエラ", "text": "…マルザンナのいじわる"},
        { "location": "84/TALK"   , "narrator": "ガブリエラ", "text": "わかってるくせに"},
        { "location": "98/TALK"   , "narrator": "神楽", "text": "ガブちゃん、\nそっちの作業は――"},
        { "location": "100/TALK"  , "narrator": "神楽", "text": "その様子だと、\n終わってるみたいですね。"},
        { "location": "102/TALK"  , "narrator": "ガブリエラ", "text": "ええ、とっくにね。"},
        { "location": "103/TALK"  , "narrator": "神楽", "text": "そっちの作業も\n終わっているなら、\n一息入れませんか？"},
        { "location": "104/TALK"  , "narrator": "神楽", "text": "学校帰りに、大好きな\n紅茶の葉を買ってきたん\nです。"},
        { "location": "105/TALK"  , "narrator": "ガブリエラ", "text": "いいわね。\nいただくわ。"},
        { "location": "107/TALK"  , "narrator": "神楽", "text": "はい…………？"},
        { "location": "109/TALK"  , "narrator": "ガブリエラ", "text": "なに？"},
        { "location": "110/TALK"  , "narrator": "神楽", "text": "そのノート、ガブちゃんの\nですか？"},
        { "location": "112/TALK"  , "narrator": "ガブリエラ", "text": "っ！？"},
        { "location": "113/TALK"  , "narrator": "ガブリエラ", "text": "やだ、開いたまま！？"},
        { "location": "114/TALK"  , "narrator": "神楽", "text": "ガブちゃん、これって…。"},
        { "location": "116/TALK"  , "narrator": "ガブリエラ", "text": "こ、これはその…\nえっと…。"},
        { "location": "117/TALK"  , "narrator": "神楽", "text": "ガブちゃんって、\n小説を書く趣味が\nあったんですね。"},
        { "location": "119/TALK"  , "narrator": "ガブリエラ", "text": "え？"},
        { "location": "120/TALK"  , "narrator": "神楽", "text": "驚きました。\nそんな素振り、ちっとも\n見えませんでしたし。"},
        { "location": "121/TALK"  , "narrator": "ガブリエラ", "text": "…もしかして、これが\n日記ってことに気付いて\nない？"},
        { "location": "122/TALK"  , "narrator": "ガブリエラ", "text": "それなら、こっちとしては\nありがたいけど…。"},
        { "location": "124/TALK"  , "narrator": "神楽", "text": "どんな話なのかは\n聞かないけど――"},
        { "location": "125/TALK"  , "narrator": "神楽", "text": "完成したら、絶対に\n読ませてくださいね！"},
        { "location": "127/TALK"  , "narrator": "ガブリエラ", "text": "…ど、どうしよう。"},
        { "location": "140/TALK"  , "narrator": "ガブリエラ", "text": "たすけてまるざんな"},
        { "location": "142/SEL"   , "narrator": "", "text": "日記だと正直に言おう"},
        { "location": "143/SEL"   , "narrator": "", "text": "とりあえず頷いておこう"},
        { "location": "144/ACT"   , "narrator": "", "text": "日記だと正直に言おう"},
        { "location": "156/TALK"  , "narrator": "ガブリエラ", "text": "間違えられたままじゃ、\nみんなに話が広がるかも\nしれないし――"},
        { "location": "157/TALK"  , "narrator": "ガブリエラ", "text": "仕方ないわ。\nこうなったら…。"},
        { "location": "159/TALK"  , "narrator": "ガブリエラ", "text": "これ、小説じゃないわ。\nあたしの日記よ。"},
        { "location": "160/TALK"  , "narrator": "神楽", "text": "日記？"},
        { "location": "161/TALK"  , "narrator": "ガブリエラ", "text": "そうよ。\nだからノートが埋まったと\nしても、見せられないわ。"},
        { "location": "162/TALK"  , "narrator": "ガブリエラ", "text": "日記なんだから、\n見せなくても変じゃ\nないわよね？"},
        { "location": "164/TALK"  , "narrator": "神楽", "text": "…あの、本当にそれ、\n日記なんですか？"},
        { "location": "165/TALK"  , "narrator": "ガブリエラ", "text": "だから、日記だってば。\n信じないの？"},
        { "location": "167/TALK"  , "narrator": "神楽", "text": "えっと…本当に日記だと\nしたら、ちょっとだけ\n申し訳ないけど――"},
        { "location": "168/TALK"  , "narrator": "神楽", "text": "ほんの少しだけ、\n内容が見えちゃったん\nです。"},
        { "location": "169/TALK"  , "narrator": "ガブリエラ", "text": "っ！？"},
        { "location": "170/TALK"  , "narrator": "ガブリエラ", "text": "ど、どこを見たの！？\nなんて書いてあった！？"},
        { "location": "173/TALK"  , "narrator": "神楽", "text": "え、えっと、確か――"},
        { "location": "174/TALK"  , "narrator": "神楽", "text": "『やる気の補給完了！\nおかげで午後の授業は\n完璧、ＧＯＯＤ☆』"},
        { "location": "175/TALK"  , "narrator": "神楽", "text": "っていうのが見えました。"},
        { "location": "177/TALK"  , "narrator": "ガブリエラ", "text": "よ、よりにもよって、\nそこ！？"},
        { "location": "178/TALK"  , "narrator": "神楽", "text": "文章が可愛かったから、\n日記とは思えなかった\nです。"},
        { "location": "179/TALK"  , "narrator": "ガブリエラ", "text": "…見間違い。"},
        { "location": "180/TALK"  , "narrator": "神楽", "text": "え？"},
        { "location": "183/TALK"  , "narrator": "ガブリエラ", "text": "それ、見間違いだから。\nそんなこと書いてないし。"},
        { "location": "184/TALK"  , "narrator": "ガブリエラ", "text": "『学校行って勉強して、\n何事もなく一日終わり\nそうだ』"},
        { "location": "185/TALK"  , "narrator": "ガブリエラ", "text": "今日の日記の内容は\nこんな感じよ？"},
        { "location": "187/TALK"  , "narrator": "神楽", "text": "内容違いすぎますよ！\n私が見たのとまったく\n違うじゃないですか？"},
        { "location": "189/TALK"  , "narrator": "ガブリエラ", "text": "で、でも、実際そんなこと\n書いてないんだから――"},
        { "location": "190/TALK"  , "narrator": "ガブリエラ", "text": "神楽の見間違いなの！\nわかった！？"},
        { "location": "191/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "193/TALK"  , "narrator": "神楽", "text": "はぁ…わかりました。\nガブちゃんがそこまで\n言うなら――"},
        { "location": "194/TALK"  , "narrator": "神楽", "text": "そういうことに\nしておきます。"},
        { "location": "196/TALK"  , "narrator": "ガブリエラ", "text": "それが事実なの！"},
        { "location": "198/TALK"  , "narrator": "神楽", "text": "わかってますよー。\nそれじゃ、紅茶煎れて\nきますね。"},
        { "location": "202/TALK"  , "narrator": "ガブリエラ", "text": "あっ…もうっ！"},
        { "location": "203/TALK"  , "narrator": "ガブリエラ", "text": "…仕方ないか。\nあたしが不注意だったのが\n悪いんだし…。"},
        { "location": "205/TALK"  , "narrator": "ガブリエラ", "text": "…もう、日記は部屋以外で\n書かないようにしよう。"},
        { "location": "206/ACT"   , "narrator": "", "text": "とりあえず頷いておこう"},
        { "location": "217/TALK"  , "narrator": "ガブリエラ", "text": "だ、大丈夫なのかしら？\nそんなことしちゃって…。"},
        { "location": "218/TALK"  , "narrator": "ガブリエラ", "text": "でも、中身を見られた\nみたいだし、そう誤魔化す\nしかないわよね？"},
        { "location": "220/TALK"  , "narrator": "ガブリエラ", "text": "…わ、わかったわ。\n完成したら見せてあげる。"},
        { "location": "222/TALK"  , "narrator": "神楽", "text": "やった、楽しみです！"},
        { "location": "223/TALK"  , "narrator": "神楽", "text": "完成、楽しみに\n待ってますね。"},
        { "location": "224/TALK"  , "narrator": "ガブリエラ", "text": "そ、それより！\nほら、お茶煎れてくれるん\nじゃないの？"},
        { "location": "225/TALK"  , "narrator": "神楽", "text": "あ、そうでした！"},
        { "location": "230/TALK"  , "narrator": "ガブリエラ", "text": "…ど、どうしよう。"},
        { "location": "242/TALK"  , "narrator": "ガブリエラ", "text": "マルザンナ！"},
        { "location": "243/TALK"  , "narrator": "ガブリエラ", "text": "あなたの言う通りにしたけど、本当にこれで良かったの？"},
        { "location": "244/TALK"  , "narrator": "ガブリエラ", "text": "神楽、完成するのを待ってるとか言ってたし…"},
        { "location": "246/SEL"   , "narrator": "", "text": "ああいう言葉は大抵お世辞"},
        { "location": "247/SEL"   , "narrator": "", "text": "これを機に書いてみれば？"},
        { "location": "248/ACT"   , "narrator": "", "text": "ああいう言葉は大抵お世辞"},
        { "location": "250/TALK"  , "narrator": "ガブリエラ", "text": "…そっか"},
        { "location": "251/TALK"  , "narrator": "ガブリエラ", "text": "言われてみると、確かにそうよね？"},
        { "location": "252/TALK"  , "narrator": "ガブリエラ", "text": "ありがとう、マルザンナ"},
        { "location": "264/TALK"  , "narrator": "ガブリエラ", "text": "そうよね…普段から\nラノベばかり読んでる\n神楽が――"},
        { "location": "265/TALK"  , "narrator": "ガブリエラ", "text": "素人のあたしが書いた\n小説を、本気で読みたい\nなんて思うわけないわ。"},
        { "location": "268/TALK"  , "narrator": "ガブリエラ", "text": "慌てて損したわ、\nまったく…。"},
        { "location": "269/TALK"  , "narrator": "ガブリエラ", "text": "…でも、もう部屋以外で\n日記書くのはやめよう。"},
        { "location": "270/ACT"   , "narrator": "", "text": "これを機に書いてみれば？"},
        { "location": "271/TALK"  , "narrator": "ガブリエラ", "text": "あたしは読む専門だから、書く気はないわ"},
        { "location": "272/TALK"  , "narrator": "ガブリエラ", "text": "楽しそうだとは思うけど、自分の書いたものを読まれるのって、恥ずかしいし"},
        { "location": "273/TALK"  , "narrator": "ガブリエラ", "text": "でも、マルザンナにだけなら見せてもいいかな？"},
        { "location": "284/TALK"  , "narrator": "ガブリエラ", "text": "ふふっ…。"},
        { "location": "285/TALK"  , "narrator": "ガブリエラ", "text": "って、しまった…。\n神楽のことどうするか、\n結局相談してないじゃん！"},
        { "location": "286/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "288/TALK"  , "narrator": "ガブリエラ", "text": "ずっと、まだ書き途中、\nってことにしよう。"},
        { "location": "15/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>6月29日　5:20 PM</color>\n5月も半ばを過ぎた頃、神楽坂トライナリーのバイト中。"}
    ]
}
