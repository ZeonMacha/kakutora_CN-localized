{
    "dir": "chap16/daydra/dd_ch05_16_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "16505",
        "cid": "kagura",
        "title": "005 メインストーリー",
        "sub_title": "十六方塞がり＜後編＞"
    },
    "entry":
    [
        { "location": "721/TALK"  , "narrator": "つばめ", "text": "卯月さん、\n大丈夫だからね？"},
        { "location": "723/TALK"  , "narrator": "つばめ", "text": "今日のわたしは、\nいつも以上に\n頑張っちゃうから！"},
        { "location": "725/TALK"  , "narrator": "神楽", "text": "…はい。\n頼りに、してますね。"},
        { "location": "727/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "729/TALK"  , "narrator": "神楽", "text": "バカじゃないの？\nつばめさんに話そうとか、\nありえないわ。"},
        { "location": "730/TALK"  , "narrator": "神楽", "text": "もし話したりしてたら、\n今頃…。"},
        { "location": "732/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "736/TALK"  , "narrator": "神楽", "text": "少しお話に付き合ってもらえますか？"},
        { "location": "737/TALK"  , "narrator": "神楽", "text": "ちょっと頭を冷やしたいので"},
        { "location": "739/SEL"   , "narrator": "", "text": "つばめに話さないんだ？"},
        { "location": "740/ACT"   , "narrator": "", "text": "つばめに話さないんだ？"},
        { "location": "742/TALK"  , "narrator": "神楽", "text": "気づいてたんですか？"},
        { "location": "745/TALK"  , "narrator": "神楽", "text": "まあ"},
        { "location": "746/TALK"  , "narrator": "神楽", "text": "話してどうにかなるものじゃありませんし"},
        { "location": "747/TALK"  , "narrator": "神楽", "text": "うっかりしてましたけど"},
        { "location": "749/TALK"  , "narrator": "神楽", "text": "私達は外のみやびさんと真幌さんに監視されてるんです"},
        { "location": "750/TALK"  , "narrator": "神楽", "text": "つばめさんが協力してくれたとしても"},
        { "location": "751/TALK"  , "narrator": "神楽", "text": "離れればすぐにバレてしまいますから"},
        { "location": "755/TALK"  , "narrator": "神楽", "text": "それに"},
        { "location": "756/TALK"  , "narrator": "神楽", "text": "つばめさんに自宅がバレたら"},
        { "location": "757/TALK"  , "narrator": "神楽", "text": "絶対に来ちゃうじゃないですか"},
        { "location": "758/TALK"  , "narrator": "神楽", "text": "それだけはイヤなんです"},
        { "location": "760/SEL"   , "narrator": "", "text": "母親を見られたくないから？"},
        { "location": "761/SEL"   , "narrator": "", "text": "これ以上好きになりたくないから？"},
        { "location": "762/ACT"   , "narrator": "", "text": "母親を見られたくないから？"},
        { "location": "764/TALK"  , "narrator": "神楽", "text": "そうです"},
        { "location": "765/TALK"  , "narrator": "神楽", "text": "やっぱり$handle$さんは知ってるんですね"},
        { "location": "766/TALK"  , "narrator": "神楽", "text": "うちの母のこと"},
        { "location": "769/TALK"  , "narrator": "神楽", "text": "私の母"},
        { "location": "770/TALK"  , "narrator": "神楽", "text": "今は普通の状態じゃないんです"},
        { "location": "771/TALK"  , "narrator": "神楽", "text": "そんな状態の母を見られるのは"},
        { "location": "772/TALK"  , "narrator": "神楽", "text": "イヤなんです"},
        { "location": "774/TALK"  , "narrator": "神楽", "text": "きっと母だって"},
        { "location": "775/TALK"  , "narrator": "神楽", "text": "自分のそんな姿を見られたくない"},
        { "location": "776/TALK"  , "narrator": "神楽", "text": "そう思うはずだから"},
        { "location": "778/SEL"   , "narrator": "", "text": "お母さんを護ってるんだね"},
        { "location": "779/SEL"   , "narrator": "", "text": "どうせわからないと思うけど？"},
        { "location": "780/ACT"   , "narrator": "", "text": "お母さんを護ってるんだね"},
        { "location": "781/TALK"  , "narrator": "神楽", "text": "私しかいませんから"},
        { "location": "783/TALK"  , "narrator": "神楽", "text": "母を護れるのは"},
        { "location": "786/TALK"  , "narrator": "神楽", "text": "だから"},
        { "location": "787/TALK"  , "narrator": "神楽", "text": "$handle$さんにお願いがあるんです"},
        { "location": "788/TALK"  , "narrator": "神楽", "text": "この事態が終わるまで"},
        { "location": "789/TALK"  , "narrator": "神楽", "text": "私の母は無事なのか"},
        { "location": "790/TALK"  , "narrator": "神楽", "text": "それを教えて欲しいんです"},
        { "location": "792/SEL"   , "narrator": "", "text": "未来のことは話せない"},
        { "location": "793/ACT"   , "narrator": "", "text": "未来のことは話せない"},
        { "location": "795/TALK"  , "narrator": "神楽", "text": "そんなのわかってます"},
        { "location": "796/TALK"  , "narrator": "神楽", "text": "でも知らなきゃ動けません"},
        { "location": "797/TALK"  , "narrator": "神楽", "text": "私はどうしたらいいんですか？"},
        { "location": "798/TALK"  , "narrator": "神楽", "text": "母が危ない目に遭っているのに"},
        { "location": "799/TALK"  , "narrator": "神楽", "text": "それがバレないようにヘラヘラ笑ってどうでもいい発症者を助けろと？"},
        { "location": "800/TALK"  , "narrator": "神楽", "text": "なんですかそれもう拷問と同じだから"},
        { "location": "801/TALK"  , "narrator": "神楽", "text": "こんな気持ちじゃまともに戦うことだってできない！"},
        { "location": "802/TALK"  , "narrator": "神楽", "text": "ルールとかどうでもいいから教ええろよ"},
        { "location": "804/SEL"   , "narrator": "", "text": "今現在は無事だ"},
        { "location": "805/SEL"   , "narrator": "", "text": "$me$だって教えたい！！"},
        { "location": "806/ACT"   , "narrator": "", "text": "今現在は無事だ"},
        { "location": "808/TALK"  , "narrator": "神楽", "text": "本当ですか？"},
        { "location": "810/SEL"   , "narrator": "", "text": "$me$に言えるのはこれだけ"},
        { "location": "811/ACT"   , "narrator": "", "text": "$me$に言えるのはこれだけ"},
        { "location": "814/TALK"  , "narrator": "神楽", "text": "ありがとう"},
        { "location": "815/TALK"  , "narrator": "神楽", "text": "でも"},
        { "location": "818/TALK"  , "narrator": "神楽", "text": "ごめんなさい"},
        { "location": "819/TALK"  , "narrator": "神楽", "text": "酷いことを言いました"},
        { "location": "822/TALK"  , "narrator": "神楽", "text": "自分はみんなに言えないことがあるのに"},
        { "location": "823/TALK"  , "narrator": "神楽", "text": "$handle$さんにはルールを破って言えだなんて"},
        { "location": "826/TALK"  , "narrator": "神楽", "text": "こんなこと言う資格ないけど"},
        { "location": "827/TALK"  , "narrator": "神楽", "text": "大丈夫なんですか？"},
        { "location": "829/SEL"   , "narrator": "", "text": "神楽の助けになったなら構わない"},
        { "location": "830/SEL"   , "narrator": "", "text": "怒られるのは慣れてる"},
        { "location": "831/SEL"   , "narrator": "", "text": "未来のことは言ってない"},
        { "location": "832/ACT"   , "narrator": "", "text": "神楽の助けになったなら構わない"},
        { "location": "833/TALK"  , "narrator": "神楽", "text": "なりましたよ"},
        { "location": "835/TALK"  , "narrator": "神楽", "text": "今の状態がわかっただけでも"},
        { "location": "836/TALK"  , "narrator": "神楽", "text": "本当にありがたいです"},
        { "location": "838/ACT"   , "narrator": "", "text": "怒られるのは慣れてる"},
        { "location": "840/TALK"  , "narrator": "神楽", "text": "本当にごめんなさい"},
        { "location": "841/TALK"  , "narrator": "神楽", "text": "$handle$さんに負担をかけてしまって"},
        { "location": "842/ACT"   , "narrator": "", "text": "未来のことは言ってない"},
        { "location": "843/TALK"  , "narrator": "神楽", "text": "なるほど"},
        { "location": "844/TALK"  , "narrator": "神楽", "text": "言われてみれば確かに！"},
        { "location": "845/TALK"  , "narrator": "神楽", "text": "でも"},
        { "location": "846/TALK"  , "narrator": "神楽", "text": "とりあえずの無事がわかって安心しました"},
        { "location": "848/TALK"  , "narrator": "神楽", "text": "私が母を護ろうとしているのと同じで"},
        { "location": "849/TALK"  , "narrator": "神楽", "text": "$handle$さんは"},
        { "location": "850/TALK"  , "narrator": "神楽", "text": "私のことをこうやって"},
        { "location": "851/TALK"  , "narrator": "神楽", "text": "護ってくれているんですよね"},
        { "location": "852/TALK"  , "narrator": "神楽", "text": "改めて実感しました"},
        { "location": "853/TALK"  , "narrator": "神楽", "text": "これからも"},
        { "location": "854/TALK"  , "narrator": "神楽", "text": "私を護ってくださいね"},
        { "location": "859/TALK"  , "narrator": "神楽", "text": "…本当、よかった。\n今のところは無事みたいで。"},
        { "location": "860/TALK"  , "narrator": "神楽", "text": "…でも、これから\nどうなるのかは\nわからないし…。"},
        { "location": "861/TALK"  , "narrator": "神楽", "text": "さっさと終わらせて、\nママのところに\n急がなくちゃ！"},
        { "location": "862/ACT"   , "narrator": "", "text": "$me$だって教えたい！！"},
        { "location": "863/TALK"  , "narrator": "神楽", "text": "だったら"},
        { "location": "866/TALK"  , "narrator": "神楽", "text": "いえ"},
        { "location": "867/TALK"  , "narrator": "神楽", "text": "ごめんなさい"},
        { "location": "868/TALK"  , "narrator": "神楽", "text": "$handle$さんはいつも"},
        { "location": "869/TALK"  , "narrator": "神楽", "text": "私のことを心配して"},
        { "location": "870/TALK"  , "narrator": "神楽", "text": "力になってくれてました"},
        { "location": "871/TALK"  , "narrator": "神楽", "text": "なのにあんな酷いことを言うなんて"},
        { "location": "874/TALK"  , "narrator": "神楽", "text": "やっぱり今は"},
        { "location": "875/TALK"  , "narrator": "神楽", "text": "冷静じゃないみたいです"},
        { "location": "877/TALK"  , "narrator": "神楽", "text": "多分"},
        { "location": "878/TALK"  , "narrator": "神楽", "text": "落ち着くのは無理だと思うけど"},
        { "location": "879/TALK"  , "narrator": "神楽", "text": "努力はしてみます"},
        { "location": "882/TALK"  , "narrator": "神楽", "text": "本当ごめんなさい"},
        { "location": "888/TALK"  , "narrator": "神楽", "text": "はぁ…。"},
        { "location": "889/TALK"  , "narrator": "神楽", "text": "私、最低だったかも。"},
        { "location": "890/TALK"  , "narrator": "神楽", "text": "…でも、こうしてる今も、\nママはフェノメノンの\nどこかにいるんだし…。"},
        { "location": "892/TALK"  , "narrator": "神楽", "text": "さっさと終わらせて、\nママのところへ\n急がなくちゃ…！"},
        { "location": "894/ACT"   , "narrator": "", "text": "どうせわからないと思うけど"},
        { "location": "897/TALK"  , "narrator": "神楽", "text": "あのさ"},
        { "location": "898/TALK"  , "narrator": "神楽", "text": "人の大切な人にそんなこと言うとか"},
        { "location": "899/TALK"  , "narrator": "神楽", "text": "頭おかしいんじゃない？"},
        { "location": "900/TALK"  , "narrator": "神楽", "text": "私の気持ちもわからないなら二度と話さないから"},
        { "location": "907/ACT"   , "narrator": "", "text": "これ以上好きになりたくないから？"},
        { "location": "909/TALK"  , "narrator": "神楽", "text": "いやそうじゃなくて"},
        { "location": "912/TALK"  , "narrator": "神楽", "text": "やっぱりいいです"},
        { "location": "913/TALK"  , "narrator": "神楽", "text": "お話付き合ってくれてありがとうございました"},
        { "location": "918/TALK"  , "narrator": "神楽", "text": "…それなりに長い付き合い\nなのに、全然私のこと\n理解してないみたい。"},
        { "location": "919/TALK"  , "narrator": "神楽", "text": "ちょっと、ガッカリかも…。"},
        { "location": "930/DIALOG", "narrator": "Dialog_chapter_ch05", "text": "【13 電脳料理人】"},
        { "location": "942/DIALOG", "narrator": "Dialog_chapter_ch05", "text": "【13 電脳料理人】"}
    ]
}
