    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "お姉さんぶっちゃって"},
        { "location": "34/TALK"   , "narrator": "ガブリエラ", "text": "アーヤったら何よ"},
        { "location": "35/TALK"   , "narrator": "ガブリエラ", "text": "自分が心配かけさせといて"},
        { "location": "36/TALK"   , "narrator": "ガブリエラ", "text": "全然自覚ないんだから"},
        { "location": "37/TALK"   , "narrator": "ガブリエラ", "text": "私わざわざ迎えに行ったのに"},
        { "location": "38/TALK"   , "narrator": "ガブリエラ", "text": "まるで私が迷子になって"},
        { "location": "39/TALK"   , "narrator": "ガブリエラ", "text": "アーヤに心配かけたみたいになったじゃない"},
        { "location": "41/SEL"    , "narrator": "", "text": "ガブリエラが一番心配してたよね？"},
        { "location": "42/SEL"    , "narrator": "", "text": "無事でよかったでしょ"},
        { "location": "43/SEL"    , "narrator": "", "text": "本当、アーヤには困ったものだ"},
        { "location": "44/ACT"    , "narrator": "", "text": "ガブリエラが一番心配してたよね？"},
        { "location": "45/TALK"   , "narrator": "ガブリエラ", "text": "心配っていうか"},
        { "location": "46/TALK"   , "narrator": "ガブリエラ", "text": "あんまり遅いから"},
        { "location": "47/TALK"   , "narrator": "ガブリエラ", "text": "何してるのかなって気になっただけよ"},
        { "location": "48/ACT"    , "narrator": "", "text": "無事でよかったでしょ"},
        { "location": "50/TALK"   , "narrator": "ガブリエラ", "text": "それはね"},
        { "location": "51/TALK"   , "narrator": "ガブリエラ", "text": "戻ってこないから"},
        { "location": "52/TALK"   , "narrator": "ガブリエラ", "text": "色々考えちゃうでしょ"},
        { "location": "54/TALK"   , "narrator": "ガブリエラ", "text": "事故とか事件的なこと"},
        { "location": "57/TALK"   , "narrator": "ガブリエラ", "text": "なんて"},
        { "location": "58/TALK"   , "narrator": "ガブリエラ", "text": "考えすぎよね"},
        { "location": "60/SEL"    , "narrator": "", "text": "万が一もあるしね"},
        { "location": "61/SEL"    , "narrator": "", "text": "ガブリエラは優しいから"},
        { "location": "62/SEL"    , "narrator": "", "text": "確かに考えすぎかもね"},
        { "location": "63/ACT"    , "narrator": "", "text": "万が一もあるしね"},
        { "location": "64/TALK"   , "narrator": "ガブリエラ", "text": "そうよね"},
        { "location": "65/TALK"   , "narrator": "ガブリエラ", "text": "用心に越したことはないわ"},
        { "location": "66/ACT"    , "narrator": "", "text": "ガブリエラは優しいから"},
        { "location": "67/TALK"   , "narrator": "ガブリエラ", "text": "まあ////////"},
        { "location": "68/TALK"   , "narrator": "ガブリエラ", "text": "そうかもだけど//////////"},
        { "location": "69/ACT"    , "narrator": "", "text": "確かに考えすぎかもね"},
        { "location": "70/TALK"   , "narrator": "ガブリエラ", "text": "そうよね"},
        { "location": "72/TALK"   , "narrator": "ガブリエラ", "text": "そうだったかも"},
        { "location": "74/ACT"    , "narrator": "", "text": "本当、アーヤには困ったものだ"},
        { "location": "75/TALK"   , "narrator": "ガブリエラ", "text": "え"},
        { "location": "76/TALK"   , "narrator": "ガブリエラ", "text": "そこまで問題ってわけじゃないわ"},
        { "location": "77/TALK"   , "narrator": "ガブリエラ", "text": "そうじゃない"},
        { "location": "79/TALK"   , "narrator": "ガブリエラ", "text": "そうだわ"},
        { "location": "80/TALK"   , "narrator": "ガブリエラ", "text": "今度お使いがあったら"},
        { "location": "81/TALK"   , "narrator": "ガブリエラ", "text": "私も一緒に出ればいいのよ"},
        { "location": "83/SEL"    , "narrator": "", "text": "いいんじゃない"},
        { "location": "84/SEL"    , "narrator": "", "text": "一人になりたい時もあるかも"},
        { "location": "85/SEL"    , "narrator": "", "text": "逆に誘えばいいと思う"},
        { "location": "86/ACT"    , "narrator": "", "text": "いいんじゃない"},
        { "location": "87/TALK"   , "narrator": "ガブリエラ", "text": "そうよね"},
        { "location": "89/TALK"   , "narrator": "ガブリエラ", "text": "そうしましょｖｖｖ"},
        { "location": "90/ACT"    , "narrator": "", "text": "一人になりたい時もあるかも"},
        { "location": "91/TALK"   , "narrator": "ガブリエラ", "text": "さすがに"},
        { "location": "92/TALK"   , "narrator": "ガブリエラ", "text": "その時は遠慮するわよ"},
        { "location": "93/TALK"   , "narrator": "ガブリエラ", "text": "私だって"},
        { "location": "94/ACT"    , "narrator": "", "text": "逆に誘えばいいと思う"},
        { "location": "95/TALK"   , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "97/TALK"   , "narrator": "ガブリエラ", "text": "その手もあるわね"},
        { "location": "98/TALK"   , "narrator": "ガブリエラ", "text": "いつ誘おうかしらｖｖｖ"}
    ]
}
