        { "location": "143/SEL"   , "narrator": "", "text": "どういたしまして"},
        { "location": "144/ACT"   , "narrator": "", "text": "じゃあ今すぐ結婚して"},
        { "location": "154/TALK"  , "narrator": "アーヤ", "text": "そうねダーリン"},
        { "location": "156/TALK"  , "narrator": "アーヤ", "text": "今すぐ迎えに来て"},
        { "location": "157/TALK"  , "narrator": "アーヤ", "text": "待ってるわ★彡"},
