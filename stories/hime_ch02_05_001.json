        { "location": "7/SCENARIO", "narrator": "", "text": "05-01_かっこ悪い私"},
        { "location": "32/TALK"   , "narrator": "アーヤ", "text": "私が一番年上だし一番最初のメンバーなの"},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "それはわかってるんだけどね"},
        { "location": "36/SEL"    , "narrator": "", "text": "おねえさまー"},
        { "location": "37/SEL"    , "narrator": "", "text": "ふーん"},
        { "location": "38/SEL"    , "narrator": "", "text": "もしかして悩んでる？"},
        { "location": "39/ACT"    , "narrator": "", "text": "おねえさまー"},
        { "location": "40/TALK"   , "narrator": "アーヤ", "text": "何かしらそれ"},
        { "location": "41/ACT"    , "narrator": "", "text": "ふーん"},
        { "location": "42/TALK"   , "narrator": "アーヤ", "text": "冷たいわね！"},
        { "location": "43/ACT"    , "narrator": "", "text": "もしかして悩んでる？"},
        { "location": "53/TALK"   , "narrator": "アーヤ", "text": "あ"},
        { "location": "54/TALK"   , "narrator": "アーヤ", "text": "わかってくれる？"},
        { "location": "55/TALK"   , "narrator": "アーヤ", "text": "なんだか"},
        { "location": "56/TALK"   , "narrator": "アーヤ", "text": "よっと"},
        { "location": "57/TALK"   , "narrator": "アーヤ", "text": "ちょっと"},
        { "location": "58/TALK"   , "narrator": "アーヤ", "text": "嬉しいわ"},
        { "location": "62/TALK"   , "narrator": "アーヤ", "text": "なんていうかね、、、"},
        { "location": "63/TALK"   , "narrator": "アーヤ", "text": "トライナリーってチームワークにちょっと門外があるっていうか"},
        { "location": "65/SEL"    , "narrator": "", "text": "問題があるんだ"},
        { "location": "66/SEL"    , "narrator": "", "text": "門外……不出？"},
        { "location": "67/SEL"    , "narrator": "", "text": "門外の変？"},
        { "location": "68/ACT"    , "narrator": "", "text": "問題があるんだ"},
        { "location": "69/TALK"   , "narrator": "アーヤ", "text": "そうなのよ、、、"},
        { "location": "70/ACT"    , "narrator": "", "text": "門外……不出？"},
        { "location": "73/TALK"   , "narrator": "アーヤ", "text": "何の話？"},
        { "location": "75/TALK"   , "narrator": "アーヤ", "text": "って"},
        { "location": "76/TALK"   , "narrator": "アーヤ", "text": "私か！"},
        { "location": "77/TALK"   , "narrator": "アーヤ", "text": "問題があるの"},
        { "location": "78/ACT"    , "narrator": "", "text": "門外の変？"},
        { "location": "79/TALK"   , "narrator": "アーヤ", "text": "へ？"},
        { "location": "81/TALK"   , "narrator": "アーヤ", "text": "あ"},
        { "location": "82/TALK"   , "narrator": "アーヤ", "text": "問題"},
        { "location": "84/TALK"   , "narrator": "アーヤ", "text": "問題"},
        { "location": "86/TALK"   , "narrator": "アーヤ", "text": "ギャヴィはまだ中学生って言うのもあるんだけど"},
        { "location": "88/TALK"   , "narrator": "アーヤ", "text": "ちょっと、、、扱いにくいって言うか、、、"},
        { "location": "90/TALK"   , "narrator": "アーヤ", "text": "そこにつばめが入ってきたでしょ"},
        { "location": "91/TALK"   , "narrator": "アーヤ", "text": "だから新人に気を配らなきゃって思ってるんだけど"},
        { "location": "92/TALK"   , "narrator": "アーヤ", "text": "私、上手くフォローできなくて、、、"},
        { "location": "95/TALK"   , "narrator": "アーヤ", "text": "落ち込むわ、、、"},
        { "location": "98/SEL"    , "narrator": "", "text": "元気出して"},
        { "location": "99/SEL"    , "narrator": "", "text": "そのうちうまくいくようになるよ"},
        { "location": "100/SEL"   , "narrator": "", "text": "ほっとけば？"},
        { "location": "101/ACT"   , "narrator": "", "text": "元気出して"},
        { "location": "111/TALK"  , "narrator": "アーヤ", "text": "んー"},
        { "location": "112/TALK"  , "narrator": "アーヤ", "text": "でも"},
        { "location": "113/TALK"  , "narrator": "アーヤ", "text": "ちょっと元気出たかな"},
        { "location": "114/ACT"   , "narrator": "", "text": "そのうちうまくいくようになるよ"},
        { "location": "115/TALK"  , "narrator": "アーヤ", "text": "あー"},
        { "location": "116/TALK"  , "narrator": "アーヤ", "text": "そんなうまくいくかしら"},
        { "location": "117/ACT"   , "narrator": "", "text": "ほっとけば？"},
        { "location": "118/TALK"  , "narrator": "アーヤ", "text": "ひど（｀皿´ )"},
        { "location": "120/TALK"  , "narrator": "アーヤ", "text": "てきとうすぎ！！"},
        { "location": "124/TALK"  , "narrator": "アーヤ", "text": "なんか"},
        { "location": "125/TALK"  , "narrator": "アーヤ", "text": "こうやって話してみたら"},
        { "location": "126/TALK"  , "narrator": "アーヤ", "text": "ちょっと気が楽になったかも"},
        { "location": "128/SEL"   , "narrator": "", "text": "よかった"},
        { "location": "129/SEL"   , "narrator": "", "text": "本当に？"},
        { "location": "130/ACT"   , "narrator": "", "text": "よかった"},
        { "location": "131/TALK"  , "narrator": "アーヤ", "text": "あら"},
        { "location": "132/TALK"  , "narrator": "アーヤ", "text": "そう思ってくれるの？"},
        { "location": "133/ACT"   , "narrator": "", "text": "本当に？"},
        { "location": "134/TALK"  , "narrator": "アーヤ", "text": "本当よ"},
        { "location": "135/TALK"  , "narrator": "アーヤ", "text": "なんだか不思議だけど"},
        { "location": "137/TALK"  , "narrator": "アーヤ", "text": "$handle$のおかげね"},
        { "location": "138/TALK"  , "narrator": "アーヤ", "text": "ありがと(^ε^)-☆!!"},
        { "location": "140/SEL"   , "narrator": "", "text": "じゃあ今すぐ結婚して"},
        { "location": "141/SEL"   , "narrator": "", "text": "アーヤの気持ちは$me$のもの"},
