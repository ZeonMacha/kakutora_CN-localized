        "title": "002 メインストーリー",
        "sub_title": "大胆勝負～Case2～＜前編＞"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "大胆勝負～Case2～"},
        { "location": "28/TALK"   , "narrator": "ガブリエラ", "text": "ふぅ…。"},
        { "location": "29/TALK"   , "narrator": "ガブリエラ", "text": "戦いの後のお風呂と、\n風呂上りのミルクは\nいつも最高なのに――"},
        { "location": "30/TALK"   , "narrator": "ガブリエラ", "text": "今日はそんな気に\nなれないみたい…。"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "それもこれも、\n全部あの新人の\nせいよ！"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "前回の戦闘といい、\n今回といい、美味しい\nとこ全部持ってくし！"},
        { "location": "34/TALK"   , "narrator": "ガブリエラ", "text": "ううん、\nそれだけじゃない。"},
        { "location": "35/TALK"   , "narrator": "ガブリエラ", "text": "アーヤも、やたらと\nあいつに肩入れして\n味方するし…。"},
        { "location": "37/TALK"   , "narrator": "ガブリエラ", "text": "…あたしだって、\n頑張ってるのに…。"},
        { "location": "43/TALK"   , "narrator": "アーヤ", "text": "…あら、ギャヴィ。\nもう出るところ？"},
        { "location": "46/TALK"   , "narrator": "ガブリエラ", "text": "っ！？\nな、何よ、悪い！？"},
        { "location": "47/TALK"   , "narrator": "アーヤ", "text": "聞いただけよ。\nそれじゃ、私も\n入って来るわ。"},
        { "location": "51/TALK"   , "narrator": "ガブリエラ", "text": "あっ…。"},
        { "location": "52/TALK"   , "narrator": "ガブリエラ", "text": "またやっちゃった。\nせっかく、話をする\nチャンスだったのに。"},
        { "location": "53/TALK"   , "narrator": "ガブリエラ", "text": "…まあ、特に話す\nこともないんだけど。"},
        { "location": "54/TALK"   , "narrator": "ガブリエラ", "text": "でも…何でこんなに\nモヤモヤするの…？"},
        { "location": "98/TALK"   , "narrator": "ガブリエラ", "text": "いらっしゃい♪\nそろそろ来る頃だと\n思ってたわ！"},
        { "location": "99/SEL"    , "narrator": "", "text": "いつも思うけど、現実のガブリエラより明るいよね"},
        { "location": "100/SEL"   , "narrator": "", "text": "今回もちゃちゃっとよろしく！"},
        { "location": "101/ACT"   , "narrator": "", "text": "いつも思うけど元気だね"},
        { "location": "102/TALK"  , "narrator": "ガブリエラ", "text": "そうかしら？\nそうかもね～♪"},
        { "location": "103/TALK"  , "narrator": "ガブリエラ", "text": "でも、あたしも正真正銘\nガブリエラの一部。\n一人格なのよ？"},
        { "location": "104/TALK"  , "narrator": "ガブリエラ", "text": "要するに、あたしの中にも\nこんなあたしも存在する\nってことね。"},
        { "location": "105/TALK"  , "narrator": "ガブリエラ", "text": "ただ、普段は表には\n出てこないだけで。"},
        { "location": "106/TALK"  , "narrator": "ガブリエラ", "text": "まあ、司書なんていう\nヒマな事やらされてる\nってことは――"},
        { "location": "108/TALK"  , "narrator": "ガブリエラ", "text": "あたしってば、\nあたしにとって要らない子\nなのかもしれないけど♪"},
        { "location": "109/SEL"   , "narrator": "", "text": "そういうものなの？"},
        { "location": "110/ACT"   , "narrator": "", "text": "そういうものなの？"},
        { "location": "112/TALK"  , "narrator": "ガブリエラ", "text": "さあ、どうかしらね♪\n真実は貴方のココロの内に\nお任せするわ。"},
        { "location": "113/TALK"  , "narrator": "ガブリエラ", "text": "さて、それはそれとして、\n今回も頑張って扉を\n検索するわよ♪"},
        { "location": "114/ACT"   , "narrator": "", "text": "今回もちゃちゃっとよろしく！"},
        { "location": "116/TALK"  , "narrator": "ガブリエラ", "text": "Zrozumiałam!\n今回も頑張って扉を\n検索するわよ♪"},
        { "location": "124/TALK"  , "narrator": "ガブリエラ", "text": "オープンプロセス、\n0x112番地から\n0x31B番地へ。"},
        { "location": "139/TALK"  , "narrator": "ガブリエラ", "text": "シーク完了っ♪"},
        { "location": "141/TALK"  , "narrator": "ガブリエラ", "text": "さて、今回は……っと。"},
        { "location": "143/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "144/TALK"  , "narrator": "ガブリエラ", "text": "………。"},
        { "location": "145/TALK"  , "narrator": "ガブリエラ", "text": "わかったわ。\nどうもあたし、アーヤ分が\n枯渇してるみたいだわ。"},
        { "location": "147/TALK"  , "narrator": "ガブリエラ", "text": "最近、業務以外で殆ど\nお話してなかったみたい\nだから、それが原因ね。"},
        { "location": "148/SEL"   , "narrator": "", "text": "お風呂場で話ししてたよ？"},
        { "location": "149/ACT"   , "narrator": "", "text": "お風呂場で話ししてたよ？"},
        { "location": "151/TALK"  , "narrator": "ガブリエラ", "text": "そうなのよ。\nだから今回のクラン発生は\nそこじゃないのよね。"},
        { "location": "152/TALK"  , "narrator": "ガブリエラ", "text": "アーヤと話すチャンス\nなのに、自分から話し\nかけられない――"},
        { "location": "153/TALK"  , "narrator": "ガブリエラ", "text": "そこに今回の\nクランが潜んでいるのよ！"},
        { "location": "154/TALK"  , "narrator": "ガブリエラ", "text": "話しかけたいのに\n話しかけられない。"},
        { "location": "155/TALK"  , "narrator": "ガブリエラ", "text": "そんな、あたしの気持ちを\n阻害するクランなんて、\nやっつけちゃって頂戴！"},
        { "location": "156/SEL"   , "narrator": "", "text": "お、おう"},
        { "location": "157/ACT"   , "narrator": "", "text": "お、おう"},
        { "location": "160/TALK"  , "narrator": "ガブリエラ", "text": "ありがと♪\nよろしくお願いね。"},
        { "location": "161/TALK"  , "narrator": "ガブリエラ", "text": "あたしと\n$handle$にとって\n素敵なココロの旅を！"},
        { "location": "27/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>5月9日　8:15 PM</color>\n高校でのフェノメノン戦の後、劇場横の銭湯にて。"},
        { "location": "66/DIALOG" , "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"}
    ]
}
