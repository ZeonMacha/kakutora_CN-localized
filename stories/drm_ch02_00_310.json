        { "location": "68/TALK"   , "narrator": "アーヤ", "text": "んー"},
        { "location": "70/TALK"   , "narrator": "アーヤ", "text": "困ってた人がいたら"},
        { "location": "71/TALK"   , "narrator": "アーヤ", "text": "助けるのは普通のことだと思うのよ"},
        { "location": "72/TALK"   , "narrator": "アーヤ", "text": "そうでしょう？"},
