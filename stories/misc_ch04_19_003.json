    "entry":
    [
        { "location": "158/SCENARIO", "narrator": "", "text": "030_文学の海背川腹"},
        { "location": "185/TALK"    , "narrator": "みやび", "text": "何故に人は海ではしゃぐのだろう"},
        { "location": "187/SEL"     , "narrator": "", "text": "水着のせいかな"},
        { "location": "188/SEL"     , "narrator": "", "text": "気分？"},
        { "location": "189/SEL"     , "narrator": "", "text": "恋人同士っぽい気持ちになるから"},
        { "location": "190/ACT"     , "narrator": "", "text": "水着のせいかな"},
        { "location": "191/TALK"    , "narrator": "みやび", "text": "なるほど"},
        { "location": "192/TALK"    , "narrator": "みやび", "text": "では水着ではない時は？"},
        { "location": "193/ACT"     , "narrator": "", "text": "気分？"},
        { "location": "194/TALK"    , "narrator": "みやび", "text": "だから"},
        { "location": "196/TALK"    , "narrator": "みやび", "text": "その気分はなぜかと問うておる"},
        { "location": "197/ACT"     , "narrator": "", "text": "恋人同士っぽい気持ちになるから"},
        { "location": "199/TALK"    , "narrator": "みやび", "text": "それだ"},
        { "location": "200/TALK"    , "narrator": "みやび", "text": "つまり都市伝説を目の当たりにしてはしゃぐということだな"},
        { "location": "201/TALK"    , "narrator": "みやび", "text": "理解した"},
        { "location": "204/SEL"     , "narrator": "", "text": "海嫌い？"},
        { "location": "205/SEL"     , "narrator": "", "text": "海っていいよね"},
        { "location": "206/SEL"     , "narrator": "", "text": "$me$もみやびと海に行きたい"},
        { "location": "207/ACT"     , "narrator": "", "text": "海嫌い？"},
        { "location": "208/TALK"    , "narrator": "みやび", "text": "嫌いではない"},
        { "location": "209/TALK"    , "narrator": "みやび", "text": "ただ三崎の海は"},
        { "location": "210/TALK"    , "narrator": "みやび", "text": "土佐の海と違うぞね"},
        { "location": "211/TALK"    , "narrator": "みやび", "text": "だから"},
        { "location": "212/TALK"    , "narrator": "みやび", "text": "海は海だが違う気がするだけぞね"},
        { "location": "213/ACT"     , "narrator": "", "text": "海っていいよね"},
        { "location": "214/TALK"    , "narrator": "みやび", "text": "いいな"},
        { "location": "215/TALK"    , "narrator": "みやび", "text": "しかしだからといって闇雲にはしゃげばいいちうもんでもなかろ"},
        { "location": "216/TALK"    , "narrator": "みやび", "text": "そういうことぞね"},
        { "location": "217/ACT"     , "narrator": "", "text": "$me$もみやびと海に行きたい"},
        { "location": "219/TALK"    , "narrator": "みやび", "text": "行っとろう"},
        { "location": "220/TALK"    , "narrator": "みやび", "text": "スマホ越しで"},
        { "location": "221/TALK"    , "narrator": "みやび", "text": "でも"},
        { "location": "222/TALK"    , "narrator": "みやび", "text": "こっちに来るのはやぶさかではない"},
        { "location": "223/TALK"    , "narrator": "みやび", "text": "たまには来てみ"}
    ]
}
