{
    "dir": "dramatics/daydra/drm_ch02_00_010.js",
    "type": "Episode",
    "info": {
        "story_id": "2001",
        "cid": "ayami",
        "title": "らぶとーく 第01話",
        "sub_title": "おねえさまとお茶会を"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "おねえさまとお茶会を"},
        { "location": "23/TALK"   , "narrator": "千羽鶴", "text": "まずはおめでとう。"},
        { "location": "24/TALK"   , "narrator": "千羽鶴", "text": "貴方が今ここにいると\nいうことは、彼女との\n関係の開始を意味する。"},
        { "location": "26/SEL"    , "narrator": "", "text": "関係の開始って、つまり…"},
        { "location": "27/ACT"    , "narrator": "", "text": "関係の開始って、つまり…"},
        { "location": "30/TALK"   , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "31/TALK"   , "narrator": "千羽鶴", "text": "今この瞬間から、貴方と\n彼女は、真のパートナー\nとして歩み始める。"},
        { "location": "32/TALK"   , "narrator": "千羽鶴", "text": "その結果としては、\n恋人になったり、結婚\nしたりするかもしれない。"},
        { "location": "33/TALK"   , "narrator": "千羽鶴", "text": "もちろんそれは、\nあくまで可能性でしか\nないけれども。"},
        { "location": "34/TALK"   , "narrator": "千羽鶴", "text": "１つだけ言えることは、\n全ては貴方の行動次第\nということ。"},
        { "location": "35/TALK"   , "narrator": "千羽鶴", "text": "何にしても、今後\n貴方と彼女の関係進展は、\n全てここで行われる。"},
        { "location": "36/TALK"   , "narrator": "千羽鶴", "text": "一見貴方に関係無いような\nお話が繰り広げられる事も\nあるけど、全部関係ある。"},
        { "location": "37/TALK"   , "narrator": "千羽鶴", "text": "だから、彼女を大切に\n想うなら、ここでの物語は\n決して軽視しないよう。"},
        { "location": "38/SEL"    , "narrator": "", "text": "これでもうパートナーは決まっちゃったの？"},
        { "location": "39/ACT"    , "narrator": "", "text": "これでもうパートナーは決まっちゃったの？"},
        { "location": "41/TALK"   , "narrator": "千羽鶴", "text": "まさか。\nまだ始まりに過ぎない。"},
        { "location": "42/TALK"   , "narrator": "千羽鶴", "text": "もちろん、複数の子と\n関係を深められる。\nというか深めて欲しい。"},
        { "location": "43/TALK"   , "narrator": "千羽鶴", "text": "最初にも言ったとおり、\n貴方には、全員の支えに\nなって欲しいと思ってる。"},
        { "location": "44/TALK"   , "narrator": "千羽鶴", "text": "もちろん、\n強制はしないけど。"},
        { "location": "45/TALK"   , "narrator": "千羽鶴", "text": "貴方がしたいように、\n彼女たちとの物語を\n紡いでいけばいい。"},
        { "location": "46/TALK"   , "narrator": "千羽鶴", "text": "それじゃ、頑張って。\n彼女のココロは、貴方の\n頑張りに委ねられている。"},
        { "location": "70/TALK"   , "narrator": "ガブリエラ", "text": "ふう……。\nやっぱり紅茶は\nレモンティーね。"},
        { "location": "71/TALK"   , "narrator": "アーヤ", "text": "ふふふ。\nギャヴィはレモンティー\n好きよね。"},
        { "location": "72/TALK"   , "narrator": "ガブリエラ", "text": "好きとか嫌いとかじゃ\nないのよ。"},
        { "location": "73/TALK"   , "narrator": "ガブリエラ", "text": "ミルクティーは子供の\n飲み物なの。\nポーランドではね。"},
        { "location": "74/TALK"   , "narrator": "アーヤ", "text": "不思議よね。\nその感覚。"},
        { "location": "75/TALK"   , "narrator": "ガブリエラ", "text": "全然不思議じゃないわ。"},
        { "location": "76/TALK"   , "narrator": "ガブリエラ", "text": "あたしに言わせれば\n外でミルクティーが\n飲める方が不思議よ。"},
        { "location": "77/TALK"   , "narrator": "アーヤ", "text": "この前飲んでるの\n見かけたけど？"},
        { "location": "78/TALK"   , "narrator": "ガブリエラ", "text": "…それは…。"},
        { "location": "80/TALK"   , "narrator": "ガブリエラ", "text": "少しは日本文化に\n慣れた方がいいかなって\n思って…。"},
        { "location": "81/TALK"   , "narrator": "アーヤ", "text": "揚げ足をとるつもりじゃ\nないのよ。"},
        { "location": "82/TALK"   , "narrator": "アーヤ", "text": "子供っぽいなんて\n思わないしね。"},
        { "location": "83/TALK"   , "narrator": "ガブリエラ", "text": "…本当に…？"},
        { "location": "84/TALK"   , "narrator": "アーヤ", "text": "本当よ。"},
        { "location": "85/TALK"   , "narrator": "アーヤ", "text": "そうだ。\n今度紅茶の専門店に\n行くのはどう？"},
        { "location": "87/TALK"   , "narrator": "ガブリエラ", "text": "行ってみたいわ！"},
        { "location": "88/TALK"   , "narrator": "アーヤ", "text": "じゃあみんなの\n予定を聞いて…。"},
        { "location": "89/TALK"   , "narrator": "ガブリエラ", "text": "…そうね。"},
        { "location": "90/TALK"   , "narrator": "アーヤ", "text": "行きたいお店ね、\nアフタヌーンティーの\nプレートがあるの。"},
        { "location": "91/TALK"   , "narrator": "アーヤ", "text": "ケーキとサンドイッチが\n日替わりで\n選べるの。"},
        { "location": "93/TALK"   , "narrator": "アーヤ", "text": "みんなで行くと\nシェアできて\n楽しいわよ。"},
        { "location": "94/TALK"   , "narrator": "ガブリエラ", "text": "うん。\n楽しそうね。"},
        { "location": "102/TALK"  , "narrator": "アーヤ", "text": "みんなで紅茶専門店に行こうって言ったら、ギャヴィちょっと不機嫌みたい"},
        { "location": "103/TALK"  , "narrator": "アーヤ", "text": "二人で行きたかったのかしら"},
        { "location": "104/TALK"  , "narrator": "アーヤ", "text": "紅茶専門店に、私と"},
        { "location": "105/TALK"  , "narrator": "アーヤ", "text": "どう思う？"},
        { "location": "107/SEL"   , "narrator": "", "text": "そうなんじゃない"},
        { "location": "108/SEL"   , "narrator": "", "text": "モテる人は大変だね"},
        { "location": "109/ACT"   , "narrator": "", "text": "そうなんじゃない"},
        { "location": "110/TALK"  , "narrator": "アーヤ", "text": "やっぱり"},
        { "location": "111/TALK"  , "narrator": "アーヤ", "text": "そうなのかしら"},
        { "location": "112/TALK"  , "narrator": "アーヤ", "text": "でもそれを直接聞くのも"},
        { "location": "113/TALK"  , "narrator": "アーヤ", "text": "どうかと思うし"},
        { "location": "116/ACT"   , "narrator": "", "text": "モテる人は大変だね"},
        { "location": "117/TALK"  , "narrator": "アーヤ", "text": "そういうことじゃないし(--#)"},
        { "location": "118/TALK"  , "narrator": "アーヤ", "text": "まあ"},
        { "location": "119/TALK"  , "narrator": "アーヤ", "text": "そんなに深刻に考えることじゃないって"},
        { "location": "120/TALK"  , "narrator": "アーヤ", "text": "そういうことよね"},
        { "location": "128/TALK"  , "narrator": "アーヤ", "text": "ミルクティーしか\nないのは\nやっぱりダメ？"},
        { "location": "131/TALK"  , "narrator": "ガブリエラ", "text": "…そうじゃないわ。"},
        { "location": "132/TALK"  , "narrator": "ガブリエラ", "text": "ただちょっと二人で\n行きたかっただけ。"},
        { "location": "133/TALK"  , "narrator": "アーヤ", "text": "……。"},
        { "location": "134/TALK"  , "narrator": "ガブリエラ", "text": "みんなで行くのが\n嫌なわけじゃないわ。"},
        { "location": "135/TALK"  , "narrator": "アーヤ", "text": "そう？\nならいいんだけど…。"},
        { "location": "136/TALK"  , "narrator": "ガブリエラ", "text": "秘密のお茶会とか\nいいなって思った\nだけだから。"},
        { "location": "137/TALK"  , "narrator": "アーヤ", "text": "…ちょっとした\nサプライズでも\n仕込んでみる？"},
        { "location": "138/TALK"  , "narrator": "ガブリエラ", "text": "…いいかも。"},
        { "location": "139/TALK"  , "narrator": "アーヤ", "text": "何がいいかしら。"},
        { "location": "140/TALK"  , "narrator": "ガブリエラ", "text": "楽しいサプライズね。\n悩むわね。"},
        { "location": "141/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "142/TALK"  , "narrator": "アーヤ", "text": "……。"},
        { "location": "144/TALK"  , "narrator": "ガブリエラ", "text": "こういう時に\nお姉さんがいたら\n相談できるのにね。"},
        { "location": "145/TALK"  , "narrator": "ガブリエラ", "text": "そう思わない？"},
        { "location": "146/TALK"  , "narrator": "アーヤ", "text": "どうかしら。"},
        { "location": "147/TALK"  , "narrator": "ガブリエラ", "text": "アーヤはお姉さんに\n相談したりしないの？"},
        { "location": "148/TALK"  , "narrator": "アーヤ", "text": "いないし\nしないわ？"},
        { "location": "149/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "150/TALK"  , "narrator": "アーヤ", "text": "それより\nお茶会どうする？"},
        { "location": "151/TALK"  , "narrator": "アーヤ", "text": "最重要事項は\nそっちよね。"},
        { "location": "154/TALK"  , "narrator": "ガブリエラ", "text": "う、うん。\nそうよね…。"},
        { "location": "68/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>5月某日　3:22 PM</color>\nGW期間中、神楽坂のカフェにて。"}
    ]
}
