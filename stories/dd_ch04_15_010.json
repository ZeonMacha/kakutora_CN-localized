{
    "dir": "chap15/daydra/dd_ch04_15_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "15452",
        "cid": "miyabi",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "繭との会話"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "繭との会話"},
        { "location": "26/TALK"   , "narrator": "みやび", "text": "…それはビックリや。\nここでやっちゅう映画は\nそんなにレアなが？"},
        { "location": "28/TALK"   , "narrator": "繭", "text": "レアどころの騒ぎじゃ\nありません。"},
        { "location": "29/TALK"   , "narrator": "繭", "text": "今まで一度もソフト化\nされたこともない――"},
        { "location": "30/TALK"   , "narrator": "繭", "text": "凄く昔の、それもあまり\n認知度の高くない映画\nばかりなんです。"},
        { "location": "31/TALK"   , "narrator": "みやび", "text": "うちはあんまり古い映画は\n見ないき、気づかんかった\nちや。"},
        { "location": "32/TALK"   , "narrator": "繭", "text": "無理もないと思います。\nそれに、古い映画に\n詳しかったとしても――"},
        { "location": "33/TALK"   , "narrator": "繭", "text": "かなりマニアックなのが\n多いので、知らないのが\n普通です。"},
        { "location": "34/TALK"   , "narrator": "みやび", "text": "そうながか…。"},
        { "location": "38/TALK"   , "narrator": "みやび", "text": "…困ったなぁ。"},
        { "location": "39/TALK"   , "narrator": "みやび", "text": "この子、スイッチが\n入ったら話が止まらなく\nなるタイプやったか。"},
        { "location": "40/SEL"    , "narrator": "", "text": "マニアックだね、と言おう"},
        { "location": "41/SEL"    , "narrator": "", "text": "オススメを聞こう"},
        { "location": "42/SEL"    , "narrator": "", "text": "普通の映画に誘おう"},
        { "location": "45/TALK"   , "narrator": "みやび", "text": "古い映画はあんまし\n見ないき、言われても\nさっぱりなんやけんど…。"},
        { "location": "47/TALK"   , "narrator": "繭", "text": "西部劇なんかは、\nハズレが少ないから\n大好きなんです。"},
        { "location": "48/TALK"   , "narrator": "繭", "text": "ただ、作品数が多いので\n似た話が多いのが、唯一の\n不満点ですが…。"},
        { "location": "53/TALK"   , "narrator": "みやび", "text": "…光月さんは、まっこと\n映画好きなんやね。"},
        { "location": "54/TALK"   , "narrator": "みやび", "text": "うちは古い映画は\nあまり見ないけんど――"},
        { "location": "55/TALK"   , "narrator": "みやび", "text": "聞いてると、\n何か見てみたくなるがよ。"},
        { "location": "57/TALK"   , "narrator": "繭", "text": "本当ですか！？"},
        { "location": "58/TALK"   , "narrator": "繭", "text": "そんな風に言って頂ける\nなんて、光栄です！"},
        { "location": "59/TALK"   , "narrator": "繭", "text": "今度、映画のＤＶＤを\nお貸ししますので――"},
        { "location": "60/TALK"   , "narrator": "繭", "text": "時間のある時にでも\n是非見てください！"},
        { "location": "62/TALK"   , "narrator": "みやび", "text": "楽しみにしてるぞね。"},
        { "location": "64/ACT"    , "narrator": "", "text": "マニアックだね、と言おう"},
        { "location": "84/TALK"   , "narrator": "みやび", "text": "なるほど、とりあえず褒める作戦やね"},
        { "location": "85/TALK"   , "narrator": "みやび", "text": "けんど、マニアックはいかん"},
        { "location": "86/TALK"   , "narrator": "みやび", "text": "こういうんは、物知り言うた方がえいよ"},
        { "location": "97/TALK"   , "narrator": "繭", "text": "あの、すみません。\n話し過ぎました。"},
        { "location": "99/TALK"   , "narrator": "みやび", "text": "いんや、構わんちや。\n光月さんはまっこと、\n物知りなんやね。"},
        { "location": "100/TALK"  , "narrator": "繭", "text": "…………。"},
        { "location": "101/TALK"  , "narrator": "みやび", "text": "ん？"},
        { "location": "103/TALK"  , "narrator": "繭", "text": "…マニアック過ぎでした。\nすみません。"},
        { "location": "107/TALK"  , "narrator": "みやび", "text": "…しまった。\n褒めると裏目に出る\nタイプやったか。"},
        { "location": "109/TALK"  , "narrator": "みやび", "text": "ここはオススメでも\n聞いておくべきやった\nかもしれんなぁ。"},
        { "location": "110/ACT"   , "narrator": "", "text": "オススメを聞こう"},
        { "location": "129/TALK"  , "narrator": "みやび", "text": "…無難過ぎやせんか？"},
        { "location": "130/TALK"  , "narrator": "みやび", "text": "まあ、自分の専門外の話でウケを狙うんが難しいんはわかるけんど…"},
        { "location": "131/TALK"  , "narrator": "みやび", "text": "…しゃあない、無難に乗り切るとするか"},
        { "location": "143/TALK"  , "narrator": "繭", "text": "あの、すみません。\n話し過ぎました。"},
        { "location": "146/TALK"  , "narrator": "みやび", "text": "いんや、構わんちや。\nしっかし、聞いちゅうたら\n興味わいてきたがよ。"},
        { "location": "147/TALK"  , "narrator": "みやび", "text": "何かお薦めはないがか？\n初心者のうちでも\n楽しめそうなのは？"},
        { "location": "149/TALK"  , "narrator": "繭", "text": "興味がありますか！？\nそれなら、オススメの\n映画があります！"},
        { "location": "150/TALK"  , "narrator": "繭", "text": "「荒野の狙撃手」という\n西部劇なんですが…\nご存じないですよね？"},
        { "location": "151/TALK"  , "narrator": "みやび", "text": "知らんなぁ。\nそれも古い映画なが？"},
        { "location": "154/TALK"  , "narrator": "繭", "text": "白黒ですからね。\nそれに、結構マイナーな\n部類ですし…。"},
        { "location": "155/TALK"  , "narrator": "繭", "text": "ですが、これは本当に\n面白い映画なんです。"},
        { "location": "157/TALK"  , "narrator": "みやび", "text": "そ、そうながか…。\nもし機会があれば\n見るちや。"},
        { "location": "160/TALK"  , "narrator": "みやび", "text": "まあ、永久にないやろう\nけんど…。"},
        { "location": "161/TALK"  , "narrator": "繭", "text": "来週から放映すると、\n東雲教官が言っていま\nした。"},
        { "location": "163/TALK"  , "narrator": "みやび", "text": "…それ、まっことなが？"},
        { "location": "165/TALK"  , "narrator": "繭", "text": "はい。もしお暇があれば、\n是非見てください。"},
        { "location": "167/TALK"  , "narrator": "みやび", "text": "…そうやね。\n是非、見させてもらう\nちや。"},
        { "location": "169/TALK"  , "narrator": "みやび", "text": "…聞いた手前、断るんは\nできんしなぁ。"},
        { "location": "171/TALK"  , "narrator": "みやび", "text": "素直に、物知りやね、と\n褒める程度にするべき\nやったか…。"},
        { "location": "172/ACT"   , "narrator": "", "text": "普通の映画に誘おう"},
        { "location": "192/TALK"  , "narrator": "みやび", "text": "いや、映画に誘うほどの仲やないがよ"},
        { "location": "193/TALK"  , "narrator": "みやび", "text": "それに、うちはそんなマニアックな映画を見る予定ないちや"},
        { "location": "194/TALK"  , "narrator": "みやび", "text": "まあ、趣味が合ういうんなら、誘うんも悪くないけんど…"},
        { "location": "195/TALK"  , "narrator": "みやび", "text": "今回は保留やね"},
        { "location": "206/TALK"  , "narrator": "みやび", "text": "ん？　そういえばうちが\n見たい思うちゅうた映画、\nそろそろ始まる頃やな。"},
        { "location": "208/TALK"  , "narrator": "繭", "text": "みやび先輩は、\n普段どのような映画を\nご覧になるのですか？"},
        { "location": "210/TALK"  , "narrator": "みやび", "text": "うちはハイクオリティな\nＣＧバリバリの映画やね。"},
        { "location": "211/TALK"  , "narrator": "みやび", "text": "やき、もうすぐやる\nあの映画も見に行く\n予定なんよ。"},
        { "location": "212/TALK"  , "narrator": "繭", "text": "「ラグナレク・ノー・\nフィアー」ですか？"},
        { "location": "214/TALK"  , "narrator": "みやび", "text": "そうがよ。\nやっぱりハリウッド映画の\nＣＧはリアルでえいちや。"},
        { "location": "215/TALK"  , "narrator": "みやび", "text": "…ちゅうか、今の映画も\nちゃんと知ってるんやね？"},
        { "location": "216/TALK"  , "narrator": "繭", "text": "タイトルくらいなら…\nあとは、気になったのを\n見る程度です。"},
        { "location": "218/TALK"  , "narrator": "みやび", "text": "なんや、今の映画も\nちゃんと見れるんか。"},
        { "location": "220/TALK"  , "narrator": "みやび", "text": "…なら、うちと一緒に\n「ラグナレク・ノー・\nフィアー」見に行くが？"},
        { "location": "222/TALK"  , "narrator": "繭", "text": "はい…。"},
        { "location": "225/TALK"  , "narrator": "繭", "text": "…はい！？"},
        { "location": "227/TALK"  , "narrator": "みやび", "text": "たまには、今の話題作を\n見るんも面白いんや\nないか思うたんよ。"},
        { "location": "228/TALK"  , "narrator": "みやび", "text": "まあ、無理にとは\n言わんき。\n嫌ならそれでえいが…。"},
        { "location": "231/TALK"  , "narrator": "繭", "text": "い、いえ、行きます！\n是非ご一緒させて\nください！"},
        { "location": "232/TALK"  , "narrator": "繭", "text": "私も、たまには話題作を\n見てみたいと思って\nいたんです！"},
        { "location": "234/TALK"  , "narrator": "みやび", "text": "そうやったん？\nなら、決まりやね。"},
        { "location": "237/TALK"  , "narrator": "繭", "text": "信じられない…。\nみやび先輩から映画に\n誘われるなんて…凄いわ！"},
        { "location": "240/TALK"  , "narrator": "みやび", "text": "マニアックな映画やない\nのにこんなに喜ぶっちゅう\nことは――"},
        { "location": "241/TALK"  , "narrator": "みやび", "text": "この子、普通に映画が好き\nなだけなのかもしれんな。"},
        { "location": "15/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>7月16日　2:05 PM</color>\nとある初夏の休日、神楽坂トライナリーでのバイト中のこと。"}
    ]
}
