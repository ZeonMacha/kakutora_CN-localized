{
    "dir": "chap00/daydra/spev_ch02_007.js",
    "type": "",
    "info": {
        "story_id": "2007",
        "cid": "",
        "title": "スペシャルエピソード",
        "sub_title": "神楽ちゃんとお菓子作り"
    },
    "entry":
    [
        { "location": "32/TALK" , "narrator": "透明アーヤ", "text": "…それにしても、\nまさかお菓子作りだった\nなんて。"},
        { "location": "33/TALK" , "narrator": "透明神楽", "text": "はい？"},
        { "location": "34/TALK" , "narrator": "透明アーヤ", "text": "卯月、家デートがしたい\nって言ってたでしょ？"},
        { "location": "35/TALK" , "narrator": "透明アーヤ", "text": "だから、何しようと\n思ってるのか\n不安だったのよ…。"},
        { "location": "36/TALK" , "narrator": "透明神楽", "text": "アーヤさん…、\nわたしをどんな目で\n見ているんですか？"},
        { "location": "37/TALK" , "narrator": "透明アーヤ", "text": "ま、まあ、今は作業に\n集中しましょ。"},
        { "location": "38/TALK" , "narrator": "透明アーヤ", "text": "次は何をすれば\nいいかしら？"},
        { "location": "40/TALK" , "narrator": "透明神楽", "text": "えっと…あれ？\n確かこの次は…。"},
        { "location": "41/TALK" , "narrator": "透明神楽", "text": "レシピ確認しますから、\nちょっと休んでて\nください。"},
        { "location": "42/TALK" , "narrator": "透明アーヤ", "text": "…卯月、このお菓子は\n作ったことあるって\n言ってなかった？"},
        { "location": "44/TALK" , "narrator": "透明神楽", "text": "ありますけど、\nまだ三回目くらいしか\n作ったことなくて…。"},
        { "location": "45/TALK" , "narrator": "透明神楽", "text": "アーヤさんの方は、\nお菓子作りって\n普段はしないんですか？"},
        { "location": "46/TALK" , "narrator": "透明アーヤ", "text": "しないわ。\n最後に作ったのは\n多分…調理実習かしら？"},
        { "location": "47/TALK" , "narrator": "透明神楽", "text": "…もしかして、\nあんまり自分で作るの、\n興味ありませんでした？"},
        { "location": "48/TALK" , "narrator": "透明アーヤ", "text": "ううん、\nそんなことないわ。"},
        { "location": "50/TALK" , "narrator": "透明アーヤ", "text": "自分でも作ってみたいと\n思ってはいたんだけど。"},
        { "location": "51/TALK" , "narrator": "透明アーヤ", "text": "難しそうだったから、\nなんとなく避けてて…。"},
        { "location": "52/TALK" , "narrator": "透明神楽", "text": "そうだったんですか。"},
        { "location": "53/TALK" , "narrator": "透明アーヤ", "text": "ええ…だから今、\nとっても楽しませて\nもらってるわ。"},
        { "location": "54/TALK" , "narrator": "透明神楽", "text": "よかったぁ…。\nそれじゃあデート\n大成功ですね！"},
        { "location": "55/TALK" , "narrator": "透明アーヤ", "text": "このお菓子がちゃんと\n作れたらね…。\nそれで、レシピの方は？"},
        { "location": "56/TALK" , "narrator": "透明神楽", "text": "はい、確認しました。\n次は生クリームの\n泡立てですね。"},
        { "location": "57/TALK" , "narrator": "透明アーヤ", "text": "それなら、私がやるわ。"},
        { "location": "58/TALK" , "narrator": "透明神楽", "text": "え、大丈夫ですか？\n泡立てって、\n結構コツいりますけど…。"},
        { "location": "60/TALK" , "narrator": "透明アーヤ", "text": "かき混ぜればいいのよね？\nそれくらいなら簡単よ。"},
        { "location": "61/TALK" , "narrator": "透明神楽", "text": "…わかりました。\nそれじゃお願いしますね。"},
        { "location": "62/TALK" , "narrator": "透明アーヤ", "text": "じゃ、早速始めるわ。"},
        { "location": "67/TALK" , "narrator": "透明アーヤ", "text": "あ、あら？\n意外と難しいかも…。"},
        { "location": "68/TALK" , "narrator": "透明神楽", "text": "アーヤさん、泡だて器は\n軽く握ってください。"},
        { "location": "70/TALK" , "narrator": "透明アーヤ", "text": "こ、こうかしら？"},
        { "location": "71/TALK" , "narrator": "透明神楽", "text": "そうです。\n少し泡が立つまで、\nかき回してください。"},
        { "location": "74/TALK" , "narrator": "透明アーヤ", "text": "…………。"},
        { "location": "75/TALK" , "narrator": "透明神楽", "text": "…………。"},
        { "location": "76/TALK" , "narrator": "透明アーヤ", "text": "…意外と時間かかるのね。"},
        { "location": "77/TALK" , "narrator": "透明神楽", "text": "そうなんですよ…。\nお菓子作りって、\n意外と大変なんですよ？"},
        { "location": "78/TALK" , "narrator": "透明神楽", "text": "…っていうか、\nまた力入れてませんか？"},
        { "location": "79/TALK" , "narrator": "透明アーヤ", "text": "軽く握るっていうのが、\nどうも難しくて…。"},
        { "location": "80/TALK" , "narrator": "透明アーヤ", "text": "…ごめんなさい。\nちょっと私のやり方で\nかき混ぜるわ。"},
        { "location": "81/TALK" , "narrator": "透明神楽", "text": "え？　ちょ、アーヤさん！\nボウル抱えながら\n強く混ぜたら！"},
        { "location": "87/TALK" , "narrator": "透明アーヤ", "text": "うん、やっぱりこの方が\nやりやすいわ。"},
        { "location": "88/TALK" , "narrator": "透明神楽", "text": "あ、アーヤさん。\nちょっと作り方が\n豪快過ぎるような…。"},
        { "location": "89/TALK" , "narrator": "透明アーヤ", "text": "でも見て。\nちゃんと泡が立って\nきたわ。"},
        { "location": "90/TALK" , "narrator": "透明アーヤ", "text": "このまま続ければ――"},
        { "location": "98/TALK" , "narrator": "透明アーヤ", "text": "きゃあっ！？"},
        { "location": "101/TALK", "narrator": "透明神楽", "text": "ああっ、やっぱり…。"},
        { "location": "102/TALK", "narrator": "透明アーヤ", "text": "あちゃー…、顔も服も\nベタベタ…。"},
        { "location": "104/TALK", "narrator": "透明神楽", "text": "そうですね…ふふっ。"},
        { "location": "105/TALK", "narrator": "透明アーヤ", "text": "ちょっと、卯月。\n笑わなくてもいいでしょ？"},
        { "location": "106/TALK", "narrator": "透明神楽", "text": "ふふっ、ごめんなさい…。"},
        { "location": "107/TALK", "narrator": "透明神楽", "text": "でも、アーヤさんが\nこんなに可愛らしい\n失敗するなんて…。"},
        { "location": "108/TALK", "narrator": "透明神楽", "text": "ちょっと意外だな、って\n思っちゃって。"},
        { "location": "109/TALK", "narrator": "透明アーヤ", "text": "慣れてないんだから、\n仕方ないでしょ？"},
        { "location": "110/TALK", "narrator": "透明アーヤ", "text": "でも、今度こそは\n上手くやるわ。"},
        { "location": "111/TALK", "narrator": "透明神楽", "text": "そうですね。\nでもその前に…。"},
        { "location": "113/TALK", "narrator": "透明神楽", "text": "ボウルを置いて、\n力を抜いてからに\nしてくださいね？"}
    ]
}
