{
    "dir": "chap21/daydra/dd_ch04_21_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "21456",
        "cid": "miyabi",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "落ち着く場所"
    },
    "entry":
    [
        { "location": "363/SCENARIO", "narrator": "", "text": "落ち着く場所"},
        { "location": "376/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "380/TALK"    , "narrator": "真幌", "text": "どうかしたのか？"},
        { "location": "385/TALK"    , "narrator": "みやび", "text": "まほさん…\nいえ、特にどうもして\nないがですよ。"},
        { "location": "386/TALK"    , "narrator": "真幌", "text": "そうか？"},
        { "location": "387/TALK"    , "narrator": "みやび", "text": "…うち、何か変なとこ\nあります？"},
        { "location": "388/TALK"    , "narrator": "真幌", "text": "いや、ただ珍しいと\n思ってな。"},
        { "location": "389/TALK"    , "narrator": "真幌", "text": "ＰＣの前ならまだしも、\n縁側でぼんやり\nしているなんて。"},
        { "location": "390/TALK"    , "narrator": "みやび", "text": "…言われてみて、\n自分でもビックリです。\nレアですよ。"},
        { "location": "391/TALK"    , "narrator": "真幌", "text": "だろ？　だから何か\nあったのかと思ったん\nだが…。"},
        { "location": "392/TALK"    , "narrator": "みやび", "text": "…いや、本当に\n何でもないがです。"},
        { "location": "394/TALK"    , "narrator": "みやび", "text": "ただ…実家はやっぱし\n落ち着くな、と――"},
        { "location": "397/TALK"    , "narrator": "みやび", "text": "そんな気持ちになっちゅう\nだけですき。"},
        { "location": "398/TALK"    , "narrator": "真幌", "text": "…そうだったか。"},
        { "location": "400/TALK"    , "narrator": "みやび", "text": "…不思議なもんですね。"},
        { "location": "401/TALK"    , "narrator": "みやび", "text": "高校に上がってから、\n三戸浜に引っ越して\nきて――"},
        { "location": "403/TALK"    , "narrator": "みやび", "text": "一年ちょっとで、\nうちだけは東京の\n今の寮に引っ越したき――"},
        { "location": "404/TALK"    , "narrator": "みやび", "text": "正直、土佐の家に比べて\n思い出なんかこれっぽっち\nもないがです。"},
        { "location": "405/TALK"    , "narrator": "みやび", "text": "なのに、ここを実家だと\n思えて安心しちゅう\n自分が――"},
        { "location": "407/TALK"    , "narrator": "みやび", "text": "なんか、不思議で\n堪らんがです。"},
        { "location": "409/TALK"    , "narrator": "真幌", "text": "…………。"},
        { "location": "410/TALK"    , "narrator": "真幌", "text": "驚いたな。"},
        { "location": "411/TALK"    , "narrator": "真幌", "text": "みやびは、そういった\n感情が薄いとばかり\n思っていたのだが――"},
        { "location": "412/TALK"    , "narrator": "真幌", "text": "どうやら、私に\n見えていなかった\nだけのようだ。"},
        { "location": "414/TALK"    , "narrator": "みやび", "text": "うちも、今の今まで\n気付きませんでしたし。"},
        { "location": "415/SEL"     , "narrator": "", "text": "東京に帰りたくない？"},
        { "location": "416/SEL"     , "narrator": "", "text": "家族とも話そうよ"},
        { "location": "418/TALK"    , "narrator": "みやび", "text": "…これが普通ながです？"},
        { "location": "419/TALK"    , "narrator": "真幌", "text": "私に聞かれてもな。\n生まれも育ちも、\n今も東京だし…。"},
        { "location": "420/TALK"    , "narrator": "真幌", "text": "だが、別におかしなこと\nではないと思うぞ。"},
        { "location": "422/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "427/TALK"    , "narrator": "みやび", "text": "…らしくないことを\n言うてますね。\n忘れてください。"},
        { "location": "428/TALK"    , "narrator": "真幌", "text": "それは無理だが、\n心の奥にしまっておくと\nしよう。"},
        { "location": "430/TALK"    , "narrator": "真幌", "text": "…邪魔したら悪いのでな、\n私は退散するぞ。"},
        { "location": "434/TALK"    , "narrator": "みやび", "text": "さてと、うちもそろそろ\n部屋に…。"},
        { "location": "435/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "436/TALK"    , "narrator": "みやび", "text": "もうちっくと、\nのんびりするか…。"},
        { "location": "438/ACT"     , "narrator": "", "text": "東京に帰りたくない？"},
        { "location": "458/TALK"    , "narrator": "みやび", "text": "帰りたくないか、と聞かれれば"},
        { "location": "459/TALK"    , "narrator": "みやび", "text": "そうやね…帰りたくないかもしれん"},
        { "location": "471/TALK"    , "narrator": "みやび", "text": "…しばらく、\n東京に帰りたくないです。"},
        { "location": "473/TALK"    , "narrator": "真幌", "text": "…………。"},
        { "location": "474/TALK"    , "narrator": "真幌", "text": "実家のＰＣを弄れる\nからか？"},
        { "location": "476/TALK"    , "narrator": "みやび", "text": "…バレましたか。"},
        { "location": "478/TALK"    , "narrator": "みやび", "text": "この流れやったら、\nホームシックにでも\nなったのか――"},
        { "location": "479/TALK"    , "narrator": "みやび", "text": "って、心配してくれる\n思うたんですけんど。"},
        { "location": "480/TALK"    , "narrator": "真幌", "text": "意外な一面が見れた\nことは認めるが――"},
        { "location": "481/TALK"    , "narrator": "真幌", "text": "実家の空気恋しさだけで、\nそんなことを言うような\nタマじゃないだろ。"},
        { "location": "484/TALK"    , "narrator": "みやび", "text": "流石ですね、まほさん。\n降参します。"},
        { "location": "486/TALK"    , "narrator": "真幌", "text": "ふっ…とはいえ、\nもうしばらくは\nこっちにいることになる。"},
        { "location": "487/TALK"    , "narrator": "真幌", "text": "その気持ちが少しでも\nあるなら、親孝行の\n一つでもしておけ。"},
        { "location": "489/TALK"    , "narrator": "真幌", "text": "おまえの帰る家を、\n護ってくれている\n人達なのだからな。"},
        { "location": "493/TALK"    , "narrator": "みやび", "text": "…面倒やなぁ。"},
        { "location": "494/TALK"    , "narrator": "みやび", "text": "…けんど、うちの帰る\n場所、護ってくれてる\n人達…か…。"},
        { "location": "495/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "498/TALK"    , "narrator": "みやび", "text": "夕飯作る手伝いくらい、\nしてもえいか…。"},
        { "location": "499/ACT"     , "narrator": "", "text": "家族とも話そうよ"},
        { "location": "521/TALK"    , "narrator": "みやび", "text": "そういえば、帰ってきてからまともに話しとらんかったな"},
        { "location": "532/TALK"    , "narrator": "みやび", "text": "…いや、話も何も、\n特に話すようなこと\nないんやが――"},
        { "location": "533/TALK"    , "narrator": "みやび", "text": "向こうからも、\n特に聞いてもこないし。"},
        { "location": "534/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "535/TALK"    , "narrator": "みやび", "text": "すみません、まほさん。\nうち、ちっくと親のとこ\n行ってきます。"},
        { "location": "537/TALK"    , "narrator": "真幌", "text": "ん？"},
        { "location": "539/TALK"    , "narrator": "みやび", "text": "そろそろ夕飯の支度を\n始める頃やき、手伝い\nですよ。"},
        { "location": "540/TALK"    , "narrator": "真幌", "text": "ん、わかった…。"},
        { "location": "542/TALK"    , "narrator": "みやび", "text": "じゃあ…。"},
        { "location": "543/TALK"    , "narrator": "真幌", "text": "みやび、親と会話できる\n機会は、大切にしろよ。"},
        { "location": "546/TALK"    , "narrator": "みやび", "text": "…努力します。"},
        { "location": "548/TALK"    , "narrator": "みやび", "text": "…まあ、顔合わせれば\n話題くらい見つかるか。"},
        { "location": "375/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>8月25日　 6:12 PM</color>\n合宿中、みやびの実家、縁側でのこと"},
        { "location": "559/DIALOG"  , "narrator": "Dialog_GEThimegoto_ch04", "text": "【一家らんらん】"}
    ]
}
