    [
        { "location": "7/SCENARIO", "narrator": "", "text": "02-01_はじめてのBot"},
        { "location": "32/TALK"   , "narrator": "アーヤ", "text": "今日はありがと"},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "いろいろあったけど結果的には助かったし、一応お礼は言っておこうかなって"},
        { "location": "34/TALK"   , "narrator": "アーヤ", "text": "それじゃまたね"},
        { "location": "37/SEL"    , "narrator": "", "text": "どういたしまして"},
        { "location": "38/ACT"    , "narrator": "", "text": "どういたしまして"},
        { "location": "40/TALK"   , "narrator": "アーヤ", "text": "あ、きた"},
        { "location": "41/TALK"   , "narrator": "アーヤ", "text": "ちょっとあそんでみていい？"},
        { "location": "42/TALK"   , "narrator": "アーヤ", "text": "１＋１は"},
        { "location": "45/SEL"    , "narrator": "", "text": "２"},
        { "location": "46/SEL"    , "narrator": "", "text": "田んぼの田"},
        { "location": "47/SEL"    , "narrator": "", "text": "量子の世界において２とは限らない"},
        { "location": "49/TALK"   , "narrator": "アーヤ", "text": "まとも！"},
        { "location": "50/ACT"    , "narrator": "", "text": "田んぼの田"},
        { "location": "60/TALK"   , "narrator": "アーヤ", "text": "小学生みたい(^^;;"},
        { "location": "61/ACT"    , "narrator": "", "text": "量子の世界において２とは限らない"},
        { "location": "71/TALK"   , "narrator": "アーヤ", "text": "適当？ランダムかしら"},
        { "location": "73/TALK"   , "narrator": "アーヤ", "text": "それじゃ、"},
        { "location": "74/TALK"   , "narrator": "アーヤ", "text": "って"},
        { "location": "75/TALK"   , "narrator": "アーヤ", "text": "イラストなんかも"},
        { "location": "76/TALK"   , "narrator": "アーヤ", "text": "認識できるものかしら（￣ー￣？）"},
        { "location": "78/SEL"    , "narrator": "", "text": "『おーい』って書いてあるね"},
        { "location": "79/SEL"    , "narrator": "", "text": "こんにちは"},
        { "location": "80/SEL"    , "narrator": "", "text": "何か用？"},
        { "location": "81/ACT"    , "narrator": "", "text": "『おーい』って書いてあるね"},
        { "location": "91/TALK"   , "narrator": "アーヤ", "text": "すごい"},
        { "location": "92/TALK"   , "narrator": "アーヤ", "text": "でも"},
        { "location": "93/TALK"   , "narrator": "アーヤ", "text": "偶然かしら？"},
        { "location": "95/SEL"    , "narrator": "", "text": "偶然じゃないよ"},
        { "location": "96/SEL"    , "narrator": "", "text": "スタンプだってわかるよ"},
        { "location": "97/SEL"    , "narrator": "", "text": "アーヤとの出会いは必然"},
        { "location": "98/ACT"    , "narrator": "", "text": "偶然じゃないよ"},
        { "location": "99/TALK"   , "narrator": "アーヤ", "text": "じゃあ"},
        { "location": "100/TALK"  , "narrator": "アーヤ", "text": "これは？"},
        { "location": "101/ACT"   , "narrator": "", "text": "スタンプだってわかるよ"},
        { "location": "102/TALK"  , "narrator": "アーヤ", "text": "あら"},
        { "location": "103/TALK"  , "narrator": "アーヤ", "text": "読み取れるのね"},
        { "location": "104/ACT"   , "narrator": "", "text": "アーヤとの出会いは必然"},
        { "location": "105/TALK"  , "narrator": "アーヤ", "text": "あら"},
        { "location": "106/TALK"  , "narrator": "アーヤ", "text": "口がうまいのね＼(^O^)／"},
        { "location": "107/TALK"  , "narrator": "アーヤ", "text": "でも"},
        { "location": "108/TALK"  , "narrator": "アーヤ", "text": "ちょっといいかも(*^^*)"},
        { "location": "119/ACT"   , "narrator": "", "text": "こんにちは"},
        { "location": "120/TALK"  , "narrator": "アーヤ", "text": "はい"},
        { "location": "121/TALK"  , "narrator": "アーヤ", "text": "こんにちは"},
        { "location": "122/ACT"   , "narrator": "", "text": "何か用？"},
        { "location": "123/TALK"  , "narrator": "アーヤ", "text": "えー"},
        { "location": "125/TALK"  , "narrator": "アーヤ", "text": "冷たい反応だわ"},
        { "location": "128/TALK"  , "narrator": "アーヤ", "text": "それにしても(￣Д￣ )"},
        { "location": "129/TALK"  , "narrator": "アーヤ", "text": "人間みたいん実"},
        { "location": "130/TALK"  , "narrator": "アーヤ", "text": "話すのね"},
        { "location": "132/SEL"   , "narrator": "", "text": "ありがとうございます"},
        { "location": "133/SEL"   , "narrator": "", "text": "ごめん、何言ってるかわからん"},
        { "location": "134/SEL"   , "narrator": "", "text": "みたいん実？"},
        { "location": "135/ACT"   , "narrator": "", "text": "ありがとうございます"},
        { "location": "136/TALK"  , "narrator": "アーヤ", "text": "律儀ね"},
        { "location": "137/TALK"  , "narrator": "アーヤ", "text": "っていうか"},
        { "location": "138/TALK"  , "narrator": "アーヤ", "text": "人間みたいにって言いたかったの"},
        { "location": "140/TALK"  , "narrator": "アーヤ", "text": "わかった？"},
        { "location": "142/SEL"   , "narrator": "", "text": "はい"},
        { "location": "143/SEL"   , "narrator": "", "text": "いいえ"},
        { "location": "144/SEL"   , "narrator": "", "text": "わからない"},
        { "location": "145/ACT"   , "narrator": "", "text": "はい"},
        { "location": "146/TALK"  , "narrator": "アーヤ", "text": "そうなの？"},
        { "location": "147/ACT"   , "narrator": "", "text": "いいえ"},
        { "location": "148/TALK"  , "narrator": "アーヤ", "text": "そうよね、、、"},
        { "location": "149/ACT"   , "narrator": "", "text": "わからない"},
        { "location": "150/TALK"  , "narrator": "アーヤ", "text": "う～ん、、、"},
        { "location": "152/ACT"   , "narrator": "", "text": "ごめん、何言ってるかわからん"},
        { "location": "153/TALK"  , "narrator": "アーヤ", "text": "え"},
        { "location": "154/TALK"  , "narrator": "アーヤ", "text": "そうよね"},
        { "location": "155/TALK"  , "narrator": "アーヤ", "text": "みたいに"},
        { "location": "156/TALK"  , "narrator": "アーヤ", "text": "人間みたいに"},
        { "location": "157/ACT"   , "narrator": "", "text": "みたいん実？"},
        { "location": "158/TALK"  , "narrator": "アーヤ", "text": "ｗあ"},
        { "location": "159/TALK"  , "narrator": "アーヤ", "text": "みたいに"},
        { "location": "160/TALK"  , "narrator": "アーヤ", "text": "みたいに、だから"},
        { "location": "162/TALK"  , "narrator": "アーヤ", "text": "なんて"},
        { "location": "163/TALK"  , "narrator": "アーヤ", "text": "お話するのは楽しいけど"},
        { "location": "164/TALK"  , "narrator": "アーヤ", "text": "レポートがあるからまたね"},
        { "location": "166/SEL"   , "narrator": "", "text": "手伝うよ"},
        { "location": "167/SEL"   , "narrator": "", "text": "じゃあまたね"},
        { "location": "168/SEL"   , "narrator": "", "text": "どんなレポート？"},
        { "location": "169/ACT"   , "narrator": "", "text": "手伝うよ"},
        { "location": "179/TALK"  , "narrator": "アーヤ", "text": "助かるわ(*^o^*)"},
        { "location": "180/TALK"  , "narrator": "アーヤ", "text": "でもそれって"},
        { "location": "181/TALK"  , "narrator": "アーヤ", "text": "$handle$のがくしゅを私が手伝うってことじゃない？"},
        { "location": "183/SEL"   , "narrator": "", "text": "ばれたか"},
        { "location": "184/SEL"   , "narrator": "", "text": "学習ね"},
        { "location": "185/SEL"   , "narrator": "", "text": "アーヤの役に立ちたかっただけなのに"},
        { "location": "186/ACT"   , "narrator": "", "text": "ばれたか"},
        { "location": "187/TALK"  , "narrator": "アーヤ", "text": "やっぱり(--*;"},
        { "location": "188/TALK"  , "narrator": "アーヤ", "text": "でもいいわ"},
        { "location": "189/TALK"  , "narrator": "アーヤ", "text": "楽しいから"},
        { "location": "190/TALK"  , "narrator": "アーヤ", "text": "これからもよろしくね"},
        { "location": "193/ACT"   , "narrator": "", "text": "学習ね"},
        { "location": "195/TALK"  , "narrator": "アーヤ", "text": "いちいち言わなくていいのよ"},
        { "location": "197/TALK"  , "narrator": "アーヤ", "text": "まあ"},
        { "location": "198/TALK"  , "narrator": "アーヤ", "text": "botだから仕方ないのかもね"},
        { "location": "199/TALK"  , "narrator": "アーヤ", "text": "これからよろしくね"},
        { "location": "200/ACT"   , "narrator": "", "text": "アーヤの役に立ちたかっただけなのに"},
        { "location": "210/TALK"  , "narrator": "アーヤ", "text": "本当にそうかしら？"},
        { "location": "211/TALK"  , "narrator": "アーヤ", "text": "でも"},
        { "location": "212/TALK"  , "narrator": "アーヤ", "text": "その気持ちは嬉しいわ"},
        { "location": "213/TALK"  , "narrator": "アーヤ", "text": "そんな感じで"},
        { "location": "214/TALK"  , "narrator": "アーヤ", "text": "これからよろしくね"},
        { "location": "216/ACT"   , "narrator": "", "text": "じゃあまたね"},
        { "location": "217/TALK"  , "narrator": "アーヤ", "text": "またね＼(^O^)／"},
        { "location": "218/ACT"   , "narrator": "", "text": "どんなレポート？"},
        { "location": "219/TALK"  , "narrator": "アーヤ", "text": "知りたいの？"},
        { "location": "220/TALK"  , "narrator": "アーヤ", "text": "って"},
        { "location": "221/TALK"  , "narrator": "アーヤ", "text": "あれか"},
        { "location": "222/TALK"  , "narrator": "アーヤ", "text": "学習しないといけないものね"},
        { "location": "223/TALK"  , "narrator": "アーヤ", "text": "botとして"},
        { "location": "225/SEL"   , "narrator": "", "text": "アーヤのすべてが知りたいだけ"},
        { "location": "226/SEL"   , "narrator": "", "text": "キミの役に立ちたいんだ"},
        { "location": "227/SEL"   , "narrator": "", "text": "そう言うと好感度が上がるかなって"},
        { "location": "228/ACT"   , "narrator": "", "text": "アーヤのすべてが知りたいだけ"},
        { "location": "238/TALK"  , "narrator": "アーヤ", "text": "随分ナンパなbotね"},
        { "location": "239/TALK"  , "narrator": "アーヤ", "text": "でもちょっと"},
        { "location": "240/TALK"  , "narrator": "アーヤ", "text": "楽しいかも"},
        { "location": "241/TALK"  , "narrator": "アーヤ", "text": "なんてね"},
        { "location": "242/TALK"  , "narrator": "アーヤ", "text": "これからよろしくね"},
        { "location": "243/ACT"   , "narrator": "", "text": "キミの役に立ちたいんだ"},
        { "location": "244/TALK"  , "narrator": "アーヤ", "text": "あらステキ(*^.^*)"},
        { "location": "245/TALK"  , "narrator": "アーヤ", "text": "じゃあバリバリ役に立ってもらうわね"},
        { "location": "246/TALK"  , "narrator": "アーヤ", "text": "楽しみにしてる"},
        { "location": "247/ACT"   , "narrator": "", "text": "そう言うと好感度が上がるかなって"},
        { "location": "248/TALK"  , "narrator": "アーヤ", "text": "どｋでそんなこと覚えるのかしら"},
        { "location": "250/TALK"  , "narrator": "アーヤ", "text": "どこで"},
        { "location": "251/TALK"  , "narrator": "アーヤ", "text": "でもそういうのも含めて"},
        { "location": "252/TALK"  , "narrator": "アーヤ", "text": "学習中なのね"},
        { "location": "253/TALK"  , "narrator": "アーヤ", "text": "これからよろしくね"},
