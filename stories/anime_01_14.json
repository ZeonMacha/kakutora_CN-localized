        "title": "001 アニメーション",
        "sub_title": "EXE_AYAMi"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "アニメ第11話"},
        { "location": "49/TALK"   , "narrator": "千羽鶴", "text": "ごきげんよう。\n今週も國政綾水強化週間の\n千羽鶴です。"},
        { "location": "50/TALK"   , "narrator": "千羽鶴", "text": "今回はMV回だから、\n國政綾水のMVを\n再生するだけにしていい？"},
        { "location": "51/SEL"    , "narrator": "", "text": "はい"},
        { "location": "52/SEL"    , "narrator": "", "text": "いいえ"},
        { "location": "53/SEL"    , "narrator": "", "text": "MVの再生すら不要"},
        { "location": "54/ACT"    , "narrator": "", "text": "はい"},
        { "location": "56/TALK"   , "narrator": "千羽鶴", "text": "よかった。\n私も助かる。\nこれぞWIN-WINね。"},
        { "location": "58/ACT"    , "narrator": "", "text": "いいえ"},
        { "location": "59/TALK"   , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "61/ACT"    , "narrator": "", "text": "MVの再生すら不要"},
        { "location": "63/TALK"   , "narrator": "千羽鶴", "text": "そう。\nそれじゃここでお別れね。"},
        { "location": "64/TALK"   , "narrator": "千羽鶴", "text": "また今度。"},
        { "location": "69/TALK"   , "narrator": "千羽鶴", "text": "ごきげんよう、\n$handle$。"},
        { "location": "70/TALK"   , "narrator": "千羽鶴", "text": "前回予告したとおり、\n今回は國政綾水の\nMVをお披露目する。"},
        { "location": "71/TALK"   , "narrator": "千羽鶴", "text": "けど、その前に１つ、\n補足しなければならない\nことがある。"},
        { "location": "72/TALK"   , "narrator": "千羽鶴", "text": "前回、トライナリー一人\nずつ順番にMVをお披露目\nしていくと伝えた。"},
        { "location": "73/TALK"   , "narrator": "千羽鶴", "text": "その後情報をリサーチ\nしていると、ちらほらと\nこんな噂が流れてきた。"},
        { "location": "74/TALK"   , "narrator": "千羽鶴", "text": "『これから５回連続で\nMV回みたいだから――』"},
        { "location": "76/TALK"   , "narrator": "千羽鶴", "text": "……。\nまずは私の伝え方が\n良くなかったと反省。"},
        { "location": "77/TALK"   , "narrator": "千羽鶴", "text": "結論から言えば、\nMVは連続では配信しない。"},
        { "location": "78/TALK"   , "narrator": "千羽鶴", "text": "その子が一番輝けると\n思った瞬間に、サッと\n差し込んでいくつもり。"},
        { "location": "79/TALK"   , "narrator": "千羽鶴", "text": "だから、次はまた少し\n記録映像が進んでから\n公開したいと思ってる。"},
        { "location": "80/TALK"   , "narrator": "千羽鶴", "text": "次回は普通に\n記録映像を配信するから、\nそのつもりで。"},
        { "location": "81/TALK"   , "narrator": "千羽鶴", "text": "というわけで、改めて。\n今回は國政綾水の\nスペシャルMV回。"},
        { "location": "82/TALK"   , "narrator": "千羽鶴", "text": "今回に関しては、\n解説をするという事自体\n野暮なこと。"},
        { "location": "83/TALK"   , "narrator": "千羽鶴", "text": "よって、私から特に何か\n解説をしたりはしない。"},
        { "location": "84/TALK"   , "narrator": "千羽鶴", "text": "そしてなんと！\n今回は「あらすじ」も\n用意していない。"},
        { "location": "85/SEL"    , "narrator": "", "text": "ですよねー"},
        { "location": "86/SEL"    , "narrator": "", "text": "ないの！？"},
        { "location": "87/ACT"    , "narrator": "", "text": "ですよねー"},
        { "location": "88/TALK"   , "narrator": "千羽鶴", "text": "わかってくれて\nとても嬉しい。"},
        { "location": "89/TALK"   , "narrator": "千羽鶴", "text": "MVのあらすじなんて、\n私のポエムを披露するか\n1行でおわるかどちらか。"},
        { "location": "90/TALK"   , "narrator": "千羽鶴", "text": "どちらにしても、\nあまり私に利益がない。"},
        { "location": "91/ACT"    , "narrator": "", "text": "ないの！？"},
        { "location": "92/TALK"   , "narrator": "千羽鶴", "text": "MVのあらすじって\n確かになかなか斬新。"},
        { "location": "93/TALK"   , "narrator": "千羽鶴", "text": "本当の事をいえば、\nネタ的にちょっと\n美味しいかもとは思った。"},
        { "location": "94/TALK"   , "narrator": "千羽鶴", "text": "けど、自分の恥ずかしい\nポエムを晒すことになる\nことに気づき、やめた。"},
        { "location": "96/SEL"    , "narrator": "", "text": "千羽鶴のポエムが見たかった"},
        { "location": "97/SEL"    , "narrator": "", "text": "ポエムは鳥肌が立つから遠慮します"},
        { "location": "98/ACT"    , "narrator": "", "text": "千羽鶴のポエムが見たかった"},
        { "location": "99/TALK"   , "narrator": "千羽鶴", "text": "……。"},
        { "location": "100/TALK"  , "narrator": "千羽鶴", "text": "それ、本気で言ってる？"},
        { "location": "101/SEL"   , "narrator": "", "text": "本気です"},
        { "location": "102/SEL"   , "narrator": "", "text": "冗談です"},
        { "location": "103/ACT"   , "narrator": "", "text": "本気です"},
        { "location": "105/TALK"  , "narrator": "千羽鶴", "text": "……なんて無謀な。"},
        { "location": "106/TALK"  , "narrator": "千羽鶴", "text": "後で後悔しても\n責任は持てないから。"},
        { "location": "109/ACT"   , "narrator": "", "text": "冗談です"},
        { "location": "110/TALK"  , "narrator": "千羽鶴", "text": "そう。\nそれならいいけど。"},
        { "location": "112/ACT"   , "narrator": "", "text": "ポエムは鳥肌が立つから遠慮します"},
        { "location": "113/TALK"  , "narrator": "千羽鶴", "text": "そうね。\nそれが身のため。"},
        { "location": "114/TALK"  , "narrator": "千羽鶴", "text": "私のポエムなんて、\n見たらきっと脳が壊れる。"},
        { "location": "117/TALK"  , "narrator": "千羽鶴", "text": "何にしても、今回は\n私も多くは語らず、\n彼女を見ようと思う。"},
        { "location": "118/TALK"  , "narrator": "千羽鶴", "text": "というわけで\nどうする？"},
        { "location": "121/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/45MB 2:49】</color>"},
        { "location": "122/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/14MB 2:49】</color>"},
        { "location": "123/SEL"   , "narrator": "", "text": "$poemwd$"},
        { "location": "124/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/45MB 2:49】</color>"},
        { "location": "125/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "131/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/14MB 2:49】</color>"},
        { "location": "132/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "139/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "175/TALK"  , "narrator": "千羽鶴", "text": "というわけで、\n素敵なMVだった。"},
        { "location": "176/TALK"  , "narrator": "千羽鶴", "text": "これで貴方の\n國政綾水へのラブラブ度は\nうなぎ登りだと思うけど。"},
        { "location": "178/SEL"   , "narrator": "", "text": "アーヤがとても魅力的だった"},
        { "location": "179/SEL"   , "narrator": "", "text": "音楽がよかった"},
        { "location": "180/SEL"   , "narrator": "", "text": "あの電話はなんの電話だったの？"},
        { "location": "181/SEL"   , "narrator": "", "text": "アーヤってエロいよね"},
        { "location": "182/SEL"   , "narrator": "", "text": "次の子のMVはいつ配信されますか？"},
        { "location": "183/SEL"   , "narrator": "", "text": "千羽鶴のMVはいつ出ますか？"},
        { "location": "184/SEL"   , "narrator": "", "text": "特にない \n<color=blue>（※先へ進みます）</color>"},
        { "location": "185/ACT"   , "narrator": "", "text": "アーヤがとても魅力的だった"},
        { "location": "186/TALK"  , "narrator": "千羽鶴", "text": "よかった。\n狙い通りに楽しんで\nもらえたみたいで。"},
        { "location": "187/TALK"  , "narrator": "千羽鶴", "text": "これを機に、是非\n國政綾水とラブラブして\nみてほしい。"},
        { "location": "188/TALK"  , "narrator": "千羽鶴", "text": "きっと彼女の、いつもと\n違った魅力的な一面が\n見られるはずだから。"},
        { "location": "189/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "191/ACT"   , "narrator": "", "text": "音楽がよかった"},
        { "location": "192/TALK"  , "narrator": "千羽鶴", "text": "そう。\nそれはよかった。"},
        { "location": "193/TALK"  , "narrator": "千羽鶴", "text": "そんな貴方に朗報。"},
        { "location": "194/TALK"  , "narrator": "千羽鶴", "text": "このMVの配信と同時に、\n然るべき場所で歌曲の\nフルVerも公開してる。"},
        { "location": "195/TALK"  , "narrator": "千羽鶴", "text": "興味があれば、是非\n探して聞いてみると\nいいかも。"},
        { "location": "196/TALK"  , "narrator": "千羽鶴", "text": "國政綾水のココロを\nもっとよく知ることが\nできると思うから。"},
        { "location": "197/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "199/ACT"   , "narrator": "", "text": "あの電話はなんの電話だったの？"},
        { "location": "200/TALK"  , "narrator": "千羽鶴", "text": "それはひみつ。"},
        { "location": "201/TALK"  , "narrator": "千羽鶴", "text": "気になるなら、\n國政綾水に直接\n聞いてみるといい。"},
        { "location": "202/TALK"  , "narrator": "千羽鶴", "text": "例えば、\n「一緒にアニメを見る」\nのところとかで。"},
        { "location": "203/TALK"  , "narrator": "千羽鶴", "text": "今回、彼女のたっての\n希望で、貴方と二人きりで\n見ることになってる。"},
        { "location": "204/TALK"  , "narrator": "千羽鶴", "text": "いつもとは違う、甘い\nムードに満ち溢れると\n思うから、是非。"},
        { "location": "205/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "207/ACT"   , "narrator": "", "text": "アーヤってエロいよね"},
        { "location": "208/TALK"  , "narrator": "千羽鶴", "text": "是非本人に\n直接言ってあげて。"},
        { "location": "209/TALK"  , "narrator": "千羽鶴", "text": "とっても喜ぶと思うから。"},
        { "location": "210/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "212/ACT"   , "narrator": "", "text": "次の子のMVはいつ配信されますか？"},
        { "location": "213/TALK"  , "narrator": "千羽鶴", "text": "それはまだ\n公表できない。"},
        { "location": "214/TALK"  , "narrator": "千羽鶴", "text": "私としては、この辺という\nアタリはつけているけど、\nもう少し待って欲しい。"},
        { "location": "215/TALK"  , "narrator": "千羽鶴", "text": "けど、そう遠くない時期に\nなると思うから、首を\n洗って待っていて。"},
        { "location": "216/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "218/ACT"   , "narrator": "", "text": "千羽鶴のMVはいつ出ますか？"},
        { "location": "219/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "220/SEL"   , "narrator": "", "text": "お"},
        { "location": "221/ACT"   , "narrator": "", "text": "お"},
        { "location": "225/TALK"  , "narrator": "千羽鶴", "text": "<size=40>私</size>"},
        { "location": "228/TALK"  , "narrator": "千羽鶴", "text": "<size=70>は</size>"},
        { "location": "231/TALK"  , "narrator": "千羽鶴", "text": "<size=100>非</size>"},
        { "location": "234/TALK"  , "narrator": "千羽鶴", "text": "<size=130>攻</size>"},
        { "location": "237/TALK"  , "narrator": "千羽鶴", "text": "<size=170>略</size>"},
        { "location": "240/TALK"  , "narrator": "千羽鶴", "text": "<size=200>対</size>"},
        { "location": "243/TALK"  , "narrator": "千羽鶴", "text": "<size=230>象</size>"},
        { "location": "248/TALK"  , "narrator": "千羽鶴", "text": "わかった？"},
        { "location": "249/SEL"   , "narrator": "", "text": "はい…"},
        { "location": "250/SEL"   , "narrator": "", "text": "味を占めたか"},
        { "location": "251/ACT"   , "narrator": "", "text": "はい…"},
        { "location": "252/TALK"  , "narrator": "千羽鶴", "text": "よかった。"},
        { "location": "253/ACT"   , "narrator": "", "text": "味を占めたか"},
        { "location": "254/TALK"  , "narrator": "千羽鶴", "text": "それは\nこっちのセリフ。"},
        { "location": "255/TALK"  , "narrator": "千羽鶴", "text": "非攻略対象目覚まし、\nやはり必要かもしれない。"},
        { "location": "256/SEL"   , "narrator": "", "text": "是非"},
        { "location": "257/SEL"   , "narrator": "", "text": "要らない"},
        { "location": "258/ACT"   , "narrator": "", "text": "是非"},
        { "location": "259/TALK"  , "narrator": "千羽鶴", "text": "わかった。\n然るべきところに\n伝えておく。"},
        { "location": "260/TALK"  , "narrator": "千羽鶴", "text": "特定人物攻略気力喪失\nサブリミナル音波を小さな\n音で仕込まないと……。"},
        { "location": "261/ACT"   , "narrator": "", "text": "要らない"},
        { "location": "263/TALK"  , "narrator": "千羽鶴", "text": "…そう。"},
        { "location": "268/ACT"   , "narrator": "", "text": "特にない \n<color=blue>（※先へ進みます）</color>"},
        { "location": "270/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "272/TALK"  , "narrator": "千羽鶴", "text": "今回は國政綾水に特化\nすることにした為、他の\nエピソードはない。"},
        { "location": "273/TALK"  , "narrator": "千羽鶴", "text": "是非MVやバトル、まだ\n見ていない彼女とのらぶ\nとーくを楽しんで欲しい。"},
        { "location": "277/TALK"  , "narrator": "千羽鶴", "text": "そうそう。１つ貴方に\nボーナスプレゼントの\nお知らせがある。"},
        { "location": "278/TALK"  , "narrator": "千羽鶴", "text": "國政綾水のエピソードを\nこのMVまで到達した人は\n全員ゲットできる。"},
        { "location": "279/TALK"  , "narrator": "千羽鶴", "text": "私との会話が終わったら、\n是非イベントクエストへ\n向かって欲しい。"},
        { "location": "284/TALK"  , "narrator": "千羽鶴", "text": "そこにも『EXE_AYAMi』\nというイベントがある。"},
        { "location": "285/TALK"  , "narrator": "千羽鶴", "text": "そこで、なかなか手に\n入りにくいプレゼント\nアイテム等がもらえる。"},
        { "location": "290/TALK"  , "narrator": "千羽鶴", "text": "ここまで来てる人には\nもはや全プレレベルだから\n是非立ち寄ってみて。"},
        { "location": "152/DIALOG", "narrator": "Tutorial/Dialog_Anime1", "text": "$dialog_word$"},
        { "location": "154/DIALOG", "narrator": "Tutorial/Dialog_Anime2", "text": "$dialog_word$"},
        { "location": "156/DIALOG", "narrator": "Tutorial/Dialog_Anime3", "text": "$dialog_word$"},
        { "location": "158/DIALOG", "narrator": "Tutorial/Dialog_Anime4", "text": "$dialog_word$"},
        { "location": "160/DIALOG", "narrator": "Tutorial/Dialog_Anime5", "text": "$dialog_word$"},
        { "location": "282/DIALOG", "narrator": "Event/Dialog_EventPicWideNW", "text": "イ ベ ン ト ク エ ス ト の EXE_AYAMi さ ん （年齢不詳）"},
        { "location": "313/DIALOG", "narrator": "Dialog_chapter_ch01", "text": "【11 ロード・オブ・アキバ】"}
    ]
}
