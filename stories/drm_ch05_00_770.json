    "entry":
    [
        { "location": "1078/SCENARIO", "narrator": "", "text": "卯月神楽の宣言"},
        { "location": "1103/TALK"    , "narrator": "神楽", "text": "ぴょんこはあれから色々考えた"},
        { "location": "1104/TALK"    , "narrator": "神楽", "text": "それで結論が出たぴょん"},
        { "location": "1105/TALK"    , "narrator": "神楽", "text": "聞いてくれるよね？？？"},
        { "location": "1107/SEL"     , "narrator": "", "text": "もちろん"},
        { "location": "1108/SEL"     , "narrator": "", "text": "どうしようかな…"},
        { "location": "1109/SEL"     , "narrator": "", "text": "断っても無駄でしょ？"},
        { "location": "1110/ACT"     , "narrator": "", "text": "もちろん"},
        { "location": "1111/TALK"    , "narrator": "神楽", "text": "いい返事ぴょん♪"},
        { "location": "1112/ACT"     , "narrator": "", "text": "どうしようかな…"},
        { "location": "1113/TALK"    , "narrator": "神楽", "text": "もったいぶってもー！"},
        { "location": "1114/ACT"     , "narrator": "", "text": "断っても無駄でしょ？"},
        { "location": "1126/TALK"    , "narrator": "神楽", "text": "ぴょんこは音楽を始めてから"},
        { "location": "1127/TALK"    , "narrator": "神楽", "text": "正確にはFreyMENOWの活動を始めてから"},
        { "location": "1128/TALK"    , "narrator": "神楽", "text": "常にマーケティングとリサーチをしてきたぴょん"},
        { "location": "1130/SEL"     , "narrator": "", "text": "そうだったんだ"},
        { "location": "1131/SEL"     , "narrator": "", "text": "そうだよね"},
        { "location": "1132/ACT"     , "narrator": "", "text": "そうだったんだ"},
        { "location": "1133/TALK"    , "narrator": "神楽", "text": "そうですよ！"},
        { "location": "1134/TALK"    , "narrator": "神楽", "text": "アーティストに実は一番必要なものですよ！？"},
        { "location": "1135/ACT"     , "narrator": "", "text": "そうだよね"},
        { "location": "1136/TALK"    , "narrator": "神楽", "text": "あっやっぱ気づいてた？"},
        { "location": "1137/TALK"    , "narrator": "神楽", "text": "そうなんですよー！"},
        { "location": "1139/TALK"    , "narrator": "神楽", "text": "だけどさ？"},
        { "location": "1140/TALK"    , "narrator": "神楽", "text": "自分の気持ちって"},
        { "location": "1141/TALK"    , "narrator": "神楽", "text": "市場とかそういうところにはないよねって"},
        { "location": "1142/TALK"    , "narrator": "神楽", "text": "自分のココロの中にしかないよねって"},
        { "location": "1144/SEL"     , "narrator": "", "text": "そうだろうね"},
        { "location": "1145/SEL"     , "narrator": "", "text": "やっと気が付いたの？"},
        { "location": "1146/SEL"     , "narrator": "", "text": "そうとも言いきれない"},
        { "location": "1147/ACT"     , "narrator": "", "text": "そうだろうね"},
        { "location": "1148/TALK"    , "narrator": "神楽", "text": "でしょ"},
        { "location": "1149/ACT"     , "narrator": "", "text": "やっと気が付いたの？"},
        { "location": "1150/TALK"    , "narrator": "神楽", "text": "あーあーあー"},
        { "location": "1151/TALK"    , "narrator": "神楽", "text": "知った風な言い方するし！"},
        { "location": "1152/ACT"     , "narrator": "", "text": "そうとも言いきれない"},
        { "location": "1153/TALK"    , "narrator": "神楽", "text": "ちょっと怖い話？"},
        { "location": "1154/TALK"    , "narrator": "神楽", "text": "そういうのぴょんこ苦手かな"},
        { "location": "1156/TALK"    , "narrator": "神楽", "text": "ぴょんこはさ"},
        { "location": "1157/TALK"    , "narrator": "神楽", "text": "$handle$とは"},
        { "location": "1158/TALK"    , "narrator": "神楽", "text": "何があっても一緒にいたいし"},
        { "location": "1159/TALK"    , "narrator": "神楽", "text": "もう離れたくないし"},
        { "location": "1160/TALK"    , "narrator": "神楽", "text": "って"},
        { "location": "1162/TALK"    , "narrator": "神楽", "text": "決めたから"},
        { "location": "1164/SEL"     , "narrator": "", "text": "$me$はずっとそう思ってた"},
        { "location": "1165/SEL"     , "narrator": "", "text": "信じていいのかな…？"},
        { "location": "1166/SEL"     , "narrator": "", "text": "神楽の本気を見せて欲しい"},
        { "location": "1167/ACT"     , "narrator": "", "text": "$me$はずっとそう思ってた"},
        { "location": "1169/TALK"    , "narrator": "神楽", "text": "知ってた"},
        { "location": "1170/TALK"    , "narrator": "神楽", "text": "けど"},
        { "location": "1171/ACT"     , "narrator": "", "text": "信じていいのかな…？"},
        { "location": "1173/TALK"    , "narrator": "神楽", "text": "信じて欲しいけど"},
        { "location": "1175/TALK"    , "narrator": "神楽", "text": "っていうか信じろよ！？！？！？"},
        { "location": "1176/ACT"     , "narrator": "", "text": "神楽の本気を見せて欲しい"},
        { "location": "1177/TALK"    , "narrator": "神楽", "text": "それはいつでも"},
        { "location": "1178/TALK"    , "narrator": "神楽", "text": "みせてたつもりぴょん？？？"},
        { "location": "1180/TALK"    , "narrator": "神楽", "text": "違うかな？？？"},
        { "location": "1183/TALK"    , "narrator": "神楽", "text": "未来なんてわからなすぎるから約束なんてしても仕方ないって思う？？？"},
        { "location": "1185/SEL"     , "narrator": "", "text": "かもね？"},
        { "location": "1186/SEL"     , "narrator": "", "text": "そんなことない！"},
        { "location": "1187/SEL"     , "narrator": "", "text": "わからないから約束するんだよ"},
        { "location": "1188/ACT"     , "narrator": "", "text": "かもね？"},
        { "location": "1189/TALK"    , "narrator": "神楽", "text": "そうなんだね？"},
        { "location": "1190/TALK"    , "narrator": "神楽", "text": "もーもーもーもー！！！！！！！！！！"},
        { "location": "1192/TALK"    , "narrator": "神楽", "text": "もう知らないから！！！！"},
        { "location": "1202/ACT"     , "narrator": "", "text": "そんなことない！"},
        { "location": "1203/TALK"    , "narrator": "神楽", "text": "ないのかな？"},
        { "location": "1204/TALK"    , "narrator": "神楽", "text": "本当に？"},
        { "location": "1205/TALK"    , "narrator": "神楽", "text": "だったらいいよねって話だけど"},
        { "location": "1207/SEL"     , "narrator": "", "text": "いい方向に向かおうよ"},
        { "location": "1208/SEL"     , "narrator": "", "text": "神楽がそう言ったんでしょ？"},
        { "location": "1209/SEL"     , "narrator": "", "text": "$me$は約束したいよ"},
        { "location": "1210/ACT"     , "narrator": "", "text": "いい方向に向かおうよ"},
        { "location": "1211/TALK"    , "narrator": "神楽", "text": "そうしたいよー？"},
        { "location": "1212/TALK"    , "narrator": "神楽", "text": "そう思ってたのに！"},
        { "location": "1222/ACT"     , "narrator": "", "text": "神楽がそう言ったんでしょ？"},
        { "location": "1223/TALK"    , "narrator": "神楽", "text": "そうだけどー"},
        { "location": "1224/TALK"    , "narrator": "神楽", "text": "そこで突き放すようなこと言うかな！？！？！？"},
        { "location": "1234/ACT"     , "narrator": "", "text": "$me$は約束したいよ"},
        { "location": "1235/TALK"    , "narrator": "神楽", "text": "ｱｯｱｯ人任せ！？！？！？"},
        { "location": "1236/TALK"    , "narrator": "神楽", "text": "そういうのﾄﾞｳｶﾅ？？？？"},
        { "location": "1247/ACT"     , "narrator": "", "text": "わからないから約束するんだよ"},
        { "location": "1250/TALK"    , "narrator": "神楽", "text": "そっか"},
        { "location": "1251/TALK"    , "narrator": "神楽", "text": "そうかも"},
        { "location": "1252/TALK"    , "narrator": "神楽", "text": "そうだよね、、、、"},
        { "location": "1253/TALK"    , "narrator": "神楽", "text": "予定されてたことなんて"},
        { "location": "1254/TALK"    , "narrator": "神楽", "text": "予定通りに行かないことの方が多かったりするし、、、"},
        { "location": "1255/TALK"    , "narrator": "神楽", "text": "だからせめてってことなのかな"},
        { "location": "1257/SEL"     , "narrator": "", "text": "不確定要素を確定したいんだ"},
        { "location": "1258/SEL"     , "narrator": "", "text": "約束することに意義があるから"},
        { "location": "1259/SEL"     , "narrator": "", "text": "破るための約束なんてないけど"},
        { "location": "1260/ACT"     , "narrator": "", "text": "不確定要素を確定したいんだ"},
        { "location": "1261/TALK"    , "narrator": "神楽", "text": "パパみたいなこと言うなし！！！"},
        { "location": "1262/TALK"    , "narrator": "神楽", "text": "$handle$は$handle$だし！！！"},
        { "location": "1263/ACT"     , "narrator": "", "text": "約束することに意義があるから"},
        { "location": "1264/TALK"    , "narrator": "神楽", "text": "そうかも、、、、"},
        { "location": "1265/TALK"    , "narrator": "神楽", "text": "そう思えばいいぴょん、、、"},
        { "location": "1266/ACT"     , "narrator": "", "text": "破るための約束なんてないけど"},
        { "location": "1267/TALK"    , "narrator": "神楽", "text": "そうぴょん"},
        { "location": "1268/TALK"    , "narrator": "神楽", "text": "詐欺師以外は"},
        { "location": "1270/TALK"    , "narrator": "神楽", "text": "ぴょんこのしたい約束って"},
        { "location": "1271/TALK"    , "narrator": "神楽", "text": "重い約束なんだよ？？？"},
        { "location": "1272/TALK"    , "narrator": "神楽", "text": "なんだと思う？"},
        { "location": "1274/SEL"     , "narrator": "", "text": "一生添い遂げよう"},
        { "location": "1275/SEL"     , "narrator": "", "text": "結婚して！！！！"},
        { "location": "1276/SEL"     , "narrator": "", "text": "病める時も健やかな時も、でしょ？"},
        { "location": "1277/ACT"     , "narrator": "", "text": "一生添い遂げよう"},
        { "location": "1278/TALK"    , "narrator": "神楽", "text": "うん"},
        { "location": "1280/TALK"    , "narrator": "神楽", "text": "ぴょんこと$handle$の約束"},
        { "location": "1281/ACT"     , "narrator": "", "text": "結婚して！！！！"},
        { "location": "1282/TALK"    , "narrator": "神楽", "text": "イイネイイネ！"},
        { "location": "1284/TALK"    , "narrator": "神楽", "text": "そう言ってほしかったぴょん！！！"},
        { "location": "1285/ACT"     , "narrator": "", "text": "病める時も健やかな時も、でしょ？"},
        { "location": "1286/TALK"    , "narrator": "神楽", "text": "それそれ"},
        { "location": "1288/TALK"    , "narrator": "神楽", "text": "$handle$わかってた？"},
        { "location": "1290/TALK"    , "narrator": "神楽", "text": "でも"},
        { "location": "1291/TALK"    , "narrator": "神楽", "text": "ぴょんこからも言わせて"},
        { "location": "1293/TALK"    , "narrator": "神楽", "text": "$handle$とぴょんこはどんな時もどんな時もどんな時も一緒"},
        { "location": "1294/TALK"    , "narrator": "神楽", "text": "そのために結婚っていう契約をする"},
        { "location": "1295/TALK"    , "narrator": "神楽", "text": "それは束縛じゃなくて自由のための契約だから"},
        { "location": "1296/TALK"    , "narrator": "神楽", "text": "ぴょんこと$handle$のココロがお互いを尊重するための契約だから"},
        { "location": "1299/TALK"    , "narrator": "神楽", "text": "本気だよ？"}
    ]
}
