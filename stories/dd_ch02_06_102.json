{
    "dir": "chap06/daydra/dd_ch02_06_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "6205",
        "cid": "ayami",
        "title": "005 メインストーリー",
        "sub_title": "出陣【Case：アーヤ】＜後編＞"
    },
    "entry":
    [
        { "location": "256/SCENARIO", "narrator": "", "text": "出陣【アーヤから見たCase】"},
        { "location": "294/TALK"    , "narrator": "アーヤ", "text": "…まあ、実際問題\nあの人に協力を\n頼もうと思っても――"},
        { "location": "295/TALK"    , "narrator": "アーヤ", "text": "電話に出ないから、\n無理な話よね。"},
        { "location": "296/TALK"    , "narrator": "アーヤ", "text": "まったく…、\n何のためにスマホ\n持ってるのかしら？"},
        { "location": "299/TALK"    , "narrator": "ガブリエラ", "text": "…っていうか、あんたが\n言うな、って話よね。"},
        { "location": "301/TALK"    , "narrator": "つばめ", "text": "え？"},
        { "location": "302/TALK"    , "narrator": "ガブリエラ", "text": "フェノメノンの中で、\n生身で発症者と戦って――"},
        { "location": "303/TALK"    , "narrator": "ガブリエラ", "text": "素手でクランを引き剥がす\nなんて芸当、あたし達でも\nできないわ。"},
        { "location": "306/TALK"    , "narrator": "ガブリエラ", "text": "そんなあんたに、\n強いとか言われてもね。"},
        { "location": "307/TALK"    , "narrator": "アーヤ", "text": "ギャヴィ、そういう\n言い方しないの。"},
        { "location": "310/TALK"    , "narrator": "ガブリエラ", "text": "だって本当のことじゃん。"},
        { "location": "312/TALK"    , "narrator": "アーヤ", "text": "…ギャヴィは、\nちょっと逢瀬さんを\n警戒し過ぎね。"},
        { "location": "315/TALK"    , "narrator": "アーヤ", "text": "気持ちはわからなくも\nないけど――"},
        { "location": "317/TALK"    , "narrator": "アーヤ", "text": "これじゃ、お互いの\n足を引っ張ることに\nなるかもしれないわ。"},
        { "location": "318/TALK"    , "narrator": "アーヤ", "text": "どうにかしないと…。"},
        { "location": "319/TALK"    , "narrator": "みやび", "text": "ふぁ～…歩いても歩いても\n到着せんなぁ…。"},
        { "location": "321/TALK"    , "narrator": "アーヤ", "text": "…みやびに協力を\n頼むのは、無理そうね。"},
        { "location": "324/TALK"    , "narrator": "アーヤ", "text": "これからもう一人\n増えることを\n考えると――"},
        { "location": "326/TALK"    , "narrator": "アーヤ", "text": "今のうちに、二人の\n仲を取り持っておき\nたいところだけど…。"},
        { "location": "327/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "331/TALK"    , "narrator": "アーヤ", "text": "頭が痛い(；´Д｀)"},
        { "location": "332/TALK"    , "narrator": "アーヤ", "text": "どうしてこんなにまとまらないの？"},
        { "location": "333/TALK"    , "narrator": "アーヤ", "text": "みんなバラバラ"},
        { "location": "334/TALK"    , "narrator": "アーヤ", "text": "どうしたらいいの？(；´Д｀)"},
        { "location": "336/SEL"     , "narrator": "", "text": "落ち着いて"},
        { "location": "337/ACT"     , "narrator": "", "text": "落ち着いて"},
        { "location": "339/TALK"    , "narrator": "アーヤ", "text": "別に慌ててない"},
        { "location": "340/TALK"    , "narrator": "アーヤ", "text": "困ってるだけ(´o｀；"},
        { "location": "341/TALK"    , "narrator": "アーヤ", "text": "逢瀬さんとギャヴィを仲良くさせる方法がわからなくて"},
        { "location": "342/TALK"    , "narrator": "アーヤ", "text": "本当、頭が痛い(ノД`)"},
        { "location": "344/SEL"     , "narrator": "", "text": "子供じゃないんだ、見守れ"},
        { "location": "345/SEL"     , "narrator": "", "text": "命令すれば？"},
        { "location": "346/ACT"     , "narrator": "", "text": "子供じゃないんだ、見守れ"},
        { "location": "347/TALK"    , "narrator": "アーヤ", "text": "見守った結果"},
        { "location": "348/TALK"    , "narrator": "アーヤ", "text": "更に悪化したら？"},
        { "location": "349/TALK"    , "narrator": "アーヤ", "text": "その可能性の方が高いと思うし"},
        { "location": "350/ACT"     , "narrator": "", "text": "命令すれば？"},
        { "location": "351/TALK"    , "narrator": "アーヤ", "text": "絶対逆効果だと思う(-ω-;)"},
        { "location": "352/TALK"    , "narrator": "アーヤ", "text": "ギャヴィの性格知らな過ぎ"},
        { "location": "353/TALK"    , "narrator": "アーヤ", "text": "そんなこと言ったらキレて"},
        { "location": "354/TALK"    , "narrator": "アーヤ", "text": "余計逢瀬さんに当たるようになるから"},
        { "location": "359/TALK"    , "narrator": "アーヤ", "text": "Ｂｏｔに愚痴ってたって、\n答えは出ないわね。"},
        { "location": "386/TALK"    , "narrator": "つばめ", "text": "あの、せんぱい。"},
        { "location": "388/TALK"    , "narrator": "ガブリエラ", "text": "…何よ？"},
        { "location": "389/TALK"    , "narrator": "つばめ", "text": "え、えっと…。"},
        { "location": "390/TALK"    , "narrator": "つばめ", "text": "…よかったら、\nわたしと手を繋いで\nもらえませんか？"},
        { "location": "391/TALK"    , "narrator": "アーヤ", "text": "えっ！？"},
        { "location": "392/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "395/TALK"    , "narrator": "ガブリエラ", "text": "は？　いや、何？\n急に何言い出すの？"},
        { "location": "397/TALK"    , "narrator": "つばめ", "text": "だ、だって、こんな\n不気味なところ\n歩いてると――"},
        { "location": "398/TALK"    , "narrator": "つばめ", "text": "何か不安な気持ちに\nなってくるじゃない\nですか。"},
        { "location": "399/TALK"    , "narrator": "つばめ", "text": "だから、よかったら\n手を握ってもらえたら\n嬉しいなぁ、って…。"},
        { "location": "401/TALK"    , "narrator": "アーヤ", "text": "…逢瀬さんって、\n凄い子かも。"},
        { "location": "402/TALK"    , "narrator": "アーヤ", "text": "ギャヴィが逢瀬さんを\n警戒してるのは\n明らかなのに――"},
        { "location": "404/TALK"    , "narrator": "アーヤ", "text": "それでも行動を\n起こすなんて…。"},
        { "location": "405/TALK"    , "narrator": "アーヤ", "text": "…リーダーのくせに、\n私ったら何を怖気つい\nてるのかしら。"},
        { "location": "407/TALK"    , "narrator": "アーヤ", "text": "…まさか、新入りの\n仲間に気付かされるなんて\n思わなかったわ。"},
        { "location": "408/TALK"    , "narrator": "アーヤ", "text": "私も逢瀬さん\nみたいに――"},
        { "location": "410/TALK"    , "narrator": "アーヤ", "text": "勇気を出して、一歩を\n踏み出さなくちゃ！"},
        { "location": "444/TALK"    , "narrator": "アーヤ", "text": "…そろそろ出口ね。"},
        { "location": "445/TALK"    , "narrator": "アーヤ", "text": "各自、準備はいい？\n行くわよ！"},
        { "location": "446/TALK"    , "narrator": "アーヤ", "text": "今日はいつも以上に\n集中して、全力で\n戦ってやるわ！"},
        { "location": "457/DIALOG"  , "narrator": "Dialog_chapter_ch02", "text": "【04 レッドサイト】"}
    ]
}
