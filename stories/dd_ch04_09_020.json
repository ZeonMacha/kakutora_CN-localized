{
    "dir": "chap09/daydra/dd_ch04_09_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "9456",
        "cid": "miyabi",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "校庭でのこと"
    },
    "entry":
    [
        { "location": "296/SCENARIO", "narrator": "", "text": "校庭でのこと"},
        { "location": "312/TALK"    , "narrator": "みやび", "text": "はぁ……\n面倒なことになったわ。"},
        { "location": "315/TALK"    , "narrator": "つばめ", "text": "あっ、みやびさん。\nこんなところにいる\nなんて珍しいですね。"},
        { "location": "319/TALK"    , "narrator": "みやび", "text": "つばめちゃん、うちを\nヒッキーか何かと\n勘違いしちょらんか？"},
        { "location": "320/TALK"    , "narrator": "つばめ", "text": "い、いえ！\nそんなことは……。"},
        { "location": "322/TALK"    , "narrator": "つばめ", "text": "って、みやびさん！？\nその手に持ってるの\nって……！！"},
        { "location": "323/TALK"    , "narrator": "みやび", "text": "見ての通り、小鳥さんや。\nなんちゅう鳥なのかは\n知らんけんど。"},
        { "location": "325/TALK"    , "narrator": "つばめ", "text": "いや、そんな呑気な\nこと言ってる場合じゃ\nないですよ！"},
        { "location": "326/TALK"    , "narrator": "つばめ", "text": "足に怪我してるじゃ\nないですか！"},
        { "location": "328/TALK"    , "narrator": "つばめ", "text": "はわわ、どうしよう。\nわたし、絆創膏くらい\nしか持ってないよ。"},
        { "location": "329/TALK"    , "narrator": "みやび", "text": "いや…絆創膏て…\n流石のうちにも、\nその発想は無かったわ。"},
        { "location": "331/TALK"    , "narrator": "つばめ", "text": "あ、あれ？\nだめですか？"},
        { "location": "334/TALK"    , "narrator": "みやび", "text": "つばめちゃん……\n寛大なえい婿さん、\nみつかるとえいね。"},
        { "location": "335/TALK"    , "narrator": "つばめ", "text": "いや、言ってる意味が\n全然わからないです。"},
        { "location": "336/TALK"    , "narrator": "つばめ", "text": "それより、その小鳥さん\nなんとか助けないと！"},
        { "location": "339/TALK"    , "narrator": "みやび", "text": "わかっちゅう。\nけんど、うちに\n治療スキルはない！"},
        { "location": "341/TALK"    , "narrator": "つばめ", "text": "で、でもでも、\nこのままじゃ……。"},
        { "location": "344/TALK"    , "narrator": "みやび", "text": "わかったわかった。\n今聞いてみるき、\nちょっと待ちいや。"},
        { "location": "356/TALK"    , "narrator": "みやび", "text": "見てのとおりや"},
        { "location": "358/SEL"     , "narrator": "", "text": "詳しく説明して"},
        { "location": "359/ACT"     , "narrator": "", "text": "詳しく説明して"},
        { "location": "361/TALK"    , "narrator": "みやび", "text": "怪我した鳥を見つけたけんど、治療スキルも無いき、困っちゅう"},
        { "location": "362/TALK"    , "narrator": "みやび", "text": "どうすればえい？"},
        { "location": "365/SEL"     , "narrator": "", "text": "つばめに任せよう"},
        { "location": "366/SEL"     , "narrator": "", "text": "とりあえず助けよう"},
        { "location": "367/ACT"     , "narrator": "", "text": "つばめに任せよう"},
        { "location": "368/TALK"    , "narrator": "みやび", "text": "…なるほど"},
        { "location": "369/TALK"    , "narrator": "みやび", "text": "うちが一番ラクできる選択をしたか"},
        { "location": "381/TALK"    , "narrator": "みやび", "text": "機械的な答えやね。\nまあ、所詮はbotちゅう\nことか。"},
        { "location": "382/TALK"    , "narrator": "つばめ", "text": "あ、みやびさん。\nどこ行くんですか？"},
        { "location": "385/TALK"    , "narrator": "みやび", "text": "この鳥、かなりのうが\nわるそうやき。"},
        { "location": "386/TALK"    , "narrator": "みやび", "text": "とりあえず…保健室に\n連れて行くか。"},
        { "location": "387/TALK"    , "narrator": "つばめ", "text": "そっか。学校で怪我を\nしたら、まず保健室\nですよね。"},
        { "location": "388/TALK"    , "narrator": "つばめ", "text": "でも、鳥さんでも\n見てもらえるかな？"},
        { "location": "389/TALK"    , "narrator": "みやび", "text": "人しか治さんなんて\n看板、保健室には\n掛かっちょらんき。"},
        { "location": "391/TALK"    , "narrator": "みやび", "text": "ほれ、\nすっと行くちや。"},
        { "location": "396/TALK"    , "narrator": "つばめ", "text": "はい！　あ、置いてか\nないでくださいよー！"},
        { "location": "399/ACT"     , "narrator": "", "text": "とりあえず助けよう"},
        { "location": "401/TALK"    , "narrator": "みやび", "text": "無茶いうな。治療スキル無いっていっちゅうが！"},
        { "location": "403/SEL"     , "narrator": "", "text": "助けてあげて"},
        { "location": "404/ACT"     , "narrator": "", "text": "助けてあげて"},
        { "location": "406/TALK"    , "narrator": "みやび", "text": "…うむむ、強情なbotやね"},
        { "location": "417/TALK"    , "narrator": "みやび", "text": "まあ、聞いたのはうち\nやき、今回は従っちゃる。"},
        { "location": "419/TALK"    , "narrator": "みやび", "text": "つばめちゃん、\nいい加減そろそろ\n落ち着きいや。"},
        { "location": "421/TALK"    , "narrator": "つばめ", "text": "でも、わたしじゃ\n何もできないし……。"},
        { "location": "422/TALK"    , "narrator": "つばめ", "text": "みやびさんは？"},
        { "location": "423/TALK"    , "narrator": "みやび", "text": "治療スキルはないと\nさっきから言っちゅう。"},
        { "location": "424/TALK"    , "narrator": "みやび", "text": "けんど、\n今更放っておくのも\n何や気が引けるき。"},
        { "location": "425/TALK"    , "narrator": "みやび", "text": "とりあえず、保健室に\nでも連れて行くか。"},
        { "location": "427/TALK"    , "narrator": "つばめ", "text": "そっか。学校で怪我を\nしたら、まず保健室\nですよね。"},
        { "location": "428/TALK"    , "narrator": "つばめ", "text": "でも、鳥さんでも\n見てもらえるかな？"},
        { "location": "429/TALK"    , "narrator": "みやび", "text": "人しか治さんなんて\n看板、保健室には\n掛かっちょらんき。"},
        { "location": "431/TALK"    , "narrator": "みやび", "text": "ほれ、\nすっと行くちや。"},
        { "location": "432/TALK"    , "narrator": "つばめ", "text": "は、はい！"},
        { "location": "434/TALK"    , "narrator": "みやび", "text": "はぁ…どうしてうちが\nこんなことを……。"},
        { "location": "436/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "448/TALK"    , "narrator": "つばめ", "text": "あのね、なんだかみやびさんの機嫌が凄く悪そうなの"},
        { "location": "449/TALK"    , "narrator": "つばめ", "text": "もしかして、鳥さんがあまり好きじゃないのかな？"},
        { "location": "452/SEL"     , "narrator": "", "text": "余計なことさせたかも"},
        { "location": "453/SEL"     , "narrator": "", "text": "鳥アレルギーなのかも"},
        { "location": "454/SEL"     , "narrator": "", "text": "照れ隠しだよ"},
        { "location": "455/ACT"     , "narrator": "", "text": "余計なことさせたかな？"},
        { "location": "457/TALK"    , "narrator": "つばめ", "text": "Botさんが助けるように言ったの？"},
        { "location": "458/TALK"    , "narrator": "つばめ", "text": "それじゃあ、わたしが代わるって伝えてみるね"},
        { "location": "470/TALK"    , "narrator": "つばめ", "text": "でも、本当に鳥さんが\n嫌いかはわからない\nから…。"},
        { "location": "472/TALK"    , "narrator": "つばめ", "text": "あの、みやびさん。"},
        { "location": "473/TALK"    , "narrator": "つばめ", "text": "もし用事でもあるなら\nわたしが保健室に\n連れていきますよ？"},
        { "location": "475/TALK"    , "narrator": "みやび", "text": "ん？　別に構わんよ。"},
        { "location": "476/TALK"    , "narrator": "つばめ", "text": "でも……。"},
        { "location": "478/TALK"    , "narrator": "みやび", "text": "それに、動かすと\n傷が悪化するかも\nしれんきね。"},
        { "location": "479/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "480/TALK"    , "narrator": "みやび", "text": "このままうちが\n持って行くのが\n一番えい。"},
        { "location": "484/TALK"    , "narrator": "つばめ", "text": "あ、待ってください。\nみやびさーん！"},
        { "location": "486/TALK"    , "narrator": "つばめ", "text": "…みやびさん、もしかして\n鳥さんのこと、結構心配\nしてるのかな？"},
        { "location": "487/ACT"     , "narrator": "", "text": "鳥アレルギーなのかも"},
        { "location": "489/TALK"    , "narrator": "つばめ", "text": "えっ！？　それ大変だよ！！"},
        { "location": "501/TALK"    , "narrator": "つばめ", "text": "みやびさん！\n小鳥さんはわたしが\n持ちます！"},
        { "location": "504/TALK"    , "narrator": "みやび", "text": "は？　どうしたが？\n急に。"},
        { "location": "505/TALK"    , "narrator": "つばめ", "text": "だってみやびさん、\n鳥アレルギー\nなんですよね？"},
        { "location": "506/TALK"    , "narrator": "つばめ", "text": "だから機嫌が悪いん\nですよね？"},
        { "location": "508/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "509/TALK"    , "narrator": "つばめ", "text": "……みやびさん？"},
        { "location": "511/TALK"    , "narrator": "みやび", "text": "……つばめちゃん、\nいいこと教えちゃるき、\nよく聞きいや。"},
        { "location": "512/TALK"    , "narrator": "みやび", "text": "botの言うこと、\n素直に信じたら\nいかんぞね。"},
        { "location": "515/TALK"    , "narrator": "つばめ", "text": "え？　えっ！？\nそれってどういう…。"},
        { "location": "517/TALK"    , "narrator": "みやび", "text": "えいから、すっと\n保健室行くき。"},
        { "location": "522/TALK"    , "narrator": "つばめ", "text": "あっ、待って！\nわたしも行きますよー！"},
        { "location": "539/ACT"     , "narrator": "", "text": "照れ隠しだよ"},
        { "location": "540/TALK"    , "narrator": "つばめ", "text": "なるほど…うん、納得したよ！"},
        { "location": "541/TALK"    , "narrator": "つばめ", "text": "理由がわかってよかった。ありがとう"},
        { "location": "554/TALK"    , "narrator": "つばめ", "text": "えへへ……。"},
        { "location": "556/TALK"    , "narrator": "みやび", "text": "どうしたが？\n変な顔して。"},
        { "location": "558/TALK"    , "narrator": "つばめ", "text": "あ、いえ、なにも…。"},
        { "location": "559/TALK"    , "narrator": "みやび", "text": "…………。\nbotのやつが、\n何かゆうたが？"},
        { "location": "561/TALK"    , "narrator": "つばめ", "text": "えっ！？　"},
        { "location": "562/TALK"    , "narrator": "みやび", "text": "正直に白状しいや。\nbotは何を\n言うたが？"},
        { "location": "563/TALK"    , "narrator": "つばめ", "text": "…み、みやびさんが\n機嫌悪そうなのは、\n照れ隠しだ、って。"},
        { "location": "565/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "566/TALK"    , "narrator": "みやび", "text": "つばめちゃん、botの\n言葉を信じすぎたら\nいかんちや。"},
        { "location": "567/TALK"    , "narrator": "みやび", "text": "あれは所詮機械やき。"},
        { "location": "568/TALK"    , "narrator": "みやび", "text": "こっちの気持ちなんぞ\nこれっぽっちも\n感じ取れんのやし。"},
        { "location": "569/TALK"    , "narrator": "つばめ", "text": "そ、そうなんですか？"},
        { "location": "570/TALK"    , "narrator": "みやび", "text": "少なくともうちの\n気持ちを理解して\nないんは確かやわ。"},
        { "location": "572/TALK"    , "narrator": "みやび", "text": "さ、無駄口叩いとらんで\nすっと行くき。"},
        { "location": "576/TALK"    , "narrator": "つばめ", "text": "あっ、みやびさん！！"},
        { "location": "579/TALK"    , "narrator": "つばめ", "text": "…怒らせちゃったかな？"},
        { "location": "303/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>5月31日　3:20 PM</color>\nとある放課後、学園中庭にて。"},
        { "location": "533/DIALOG"  , "narrator": "Dialog_GEThimegoto_ch04", "text": "【擬人化などしておらぬ】"}
    ]
}
