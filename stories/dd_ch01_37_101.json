{
    "dir": "chap37/daydra/dd_ch01_37_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "37102",
        "cid": "tsubame",
        "title": "002 メインストーリー",
        "sub_title": "そして、わたしも＜前編＞"
    },
    "entry":
    [
        { "location": "8/SCENARIO", "narrator": "", "text": "そして、わたしも"},
        { "location": "27/TALK"   , "narrator": "つばめ", "text": "「私」もまた\nアウフヘーベン――"},
        { "location": "31/TALK"   , "narrator": "つばめ", "text": "ぅぁぁぁぁぁあ！"},
        { "location": "32/TALK"   , "narrator": "つばめ", "text": "…痛い…！　"},
        { "location": "33/SEL"    , "narrator": "", "text": "どうしたの！？"},
        { "location": "34/SEL"    , "narrator": "", "text": "大丈夫？"},
        { "location": "35/ACT"    , "narrator": "", "text": "どうしたの！？"},
        { "location": "36/TALK"   , "narrator": "つばめ", "text": "あたま、頭が…\n痛いの…！"},
        { "location": "37/ACT"    , "narrator": "", "text": "大丈夫？"},
        { "location": "38/TALK"   , "narrator": "つばめ", "text": "痛い…！"},
        { "location": "39/TALK"   , "narrator": "つばめ", "text": "頭が痛くて…！"},
        { "location": "41/TALK"   , "narrator": "つばめ", "text": "$handle$さん、\n助けて…！"},
        { "location": "42/SEL"    , "narrator": "", "text": "すぐに収まるよ"},
        { "location": "43/SEL"    , "narrator": "", "text": "$me$はここにいるよ"},
        { "location": "44/SEL"    , "narrator": "", "text": "よしよし"},
        { "location": "45/ACT"    , "narrator": "", "text": "すぐに収まるよ"},
        { "location": "47/TALK"   , "narrator": "つばめ", "text": "っ…！"},
        { "location": "48/ACT"    , "narrator": "", "text": "$me$はここにいるよ"},
        { "location": "50/TALK"   , "narrator": "つばめ", "text": "$handle$さん…！"},
        { "location": "51/ACT"    , "narrator": "", "text": "よしよし"},
        { "location": "53/TALK"   , "narrator": "つばめ", "text": "うぅ…ぅ…。"},
        { "location": "69/TALK"   , "narrator": "つばめ", "text": "はぁ…。\nはぁ…。"},
        { "location": "70/SEL"    , "narrator": "", "text": "大丈夫？"},
        { "location": "71/SEL"    , "narrator": "", "text": "まだ痛む？"},
        { "location": "72/ACT"    , "narrator": "", "text": "大丈夫？"},
        { "location": "73/TALK"   , "narrator": "つばめ", "text": "あ…うん。\nもう大丈夫…。"},
        { "location": "74/ACT"    , "narrator": "", "text": "まだ痛む？"},
        { "location": "75/TALK"   , "narrator": "つばめ", "text": "…ううん。\nもう平気。"},
        { "location": "79/TALK"   , "narrator": "つばめ", "text": "もう収まったよ。\n大丈夫。\n心配かけてごめんね。"},
        { "location": "80/TALK"   , "narrator": "つばめ", "text": "でも何で……。"},
        { "location": "81/TALK"   , "narrator": "つばめ", "text": "もしかして\n長官さんに\n何かあった？"},
        { "location": "82/SEL"    , "narrator": "", "text": "撃たれた"},
        { "location": "83/ACT"    , "narrator": "", "text": "撃たれた"},
        { "location": "85/TALK"   , "narrator": "つばめ", "text": "…そうなんだね。"},
        { "location": "86/TALK"   , "narrator": "つばめ", "text": "フェノメノンが\n壊れてる影響を\nわたしが受けたんだ。"},
        { "location": "87/TALK"   , "narrator": "つばめ", "text": "じゃあこの世界は\nもうおしまいだね。"},
        { "location": "89/TALK"   , "narrator": "つばめ", "text": "思い出も気持ちも\n全部さようならだね。"},
        { "location": "90/SEL"    , "narrator": "", "text": "そうだね"},
        { "location": "91/SEL"    , "narrator": "", "text": "そんなことはないよ"},
        { "location": "92/ACT"    , "narrator": "", "text": "そうだね"},
        { "location": "93/TALK"   , "narrator": "つばめ", "text": "…消える時って\n一瞬なんだね。"},
        { "location": "94/TALK"   , "narrator": "つばめ", "text": "これまで頑張って\nきたことも全部。"},
        { "location": "95/ACT"    , "narrator": "", "text": "そんなことはないよ"},
        { "location": "96/TALK"   , "narrator": "つばめ", "text": "なんでそんなことが\n言えるの？"},
        { "location": "97/SEL"    , "narrator": "", "text": "千羽鶴がつばめのクランだから"},
        { "location": "98/SEL"    , "narrator": "", "text": "千羽鶴はつばめだから"},
        { "location": "99/SEL"    , "narrator": "", "text": "つばめが千羽鶴を作ったから"},
        { "location": "100/ACT"   , "narrator": "", "text": "千羽鶴がつばめのクランだから"},
        { "location": "101/TALK"  , "narrator": "つばめ", "text": "…それは聞いた。"},
        { "location": "102/TALK"  , "narrator": "つばめ", "text": "だけど全然\n実感がないよ。"},
        { "location": "103/ACT"   , "narrator": "", "text": "千羽鶴はつばめだから"},
        { "location": "104/TALK"  , "narrator": "つばめ", "text": "長官さんは\n私のクランなんだって\n話は聞いた。"},
        { "location": "105/TALK"  , "narrator": "つばめ", "text": "全然ぴんと\n来ないけど…。"},
        { "location": "106/ACT"   , "narrator": "", "text": "つばめが千羽鶴を作ったから"},
        { "location": "107/TALK"  , "narrator": "つばめ", "text": "長官さんがわたしの\nクランって話\nだよね。"},
        { "location": "109/SEL"   , "narrator": "", "text": "だから何とかできるよ"},
        { "location": "110/SEL"   , "narrator": "", "text": "つばめなら変えられるはず"},
        { "location": "111/ACT"   , "narrator": "", "text": "だから何とかできるよ"},
        { "location": "112/TALK"  , "narrator": "つばめ", "text": "そうなのかな…？"},
        { "location": "113/ACT"   , "narrator": "", "text": "つばめなら変えられるはず"},
        { "location": "114/TALK"  , "narrator": "つばめ", "text": "どうなんだろうね？"},
        { "location": "117/TALK"  , "narrator": "つばめ", "text": "でもね。\nわたしたちの思い出が\nなくなっても。"},
        { "location": "118/TALK"  , "narrator": "つばめ", "text": "元々のわたしたちに\n戻るだけなんだよ。"},
        { "location": "119/SEL"   , "narrator": "", "text": "それはそうかもしれないけど"},
        { "location": "120/SEL"   , "narrator": "", "text": "寂しいこと言わないで"},
        { "location": "121/SEL"   , "narrator": "", "text": "不思議なもんだよね"},
        { "location": "122/ACT"   , "narrator": "", "text": "それはそうかもしれないけど"},
        { "location": "123/TALK"  , "narrator": "つばめ", "text": "そう考えると\n不思議でしょ？"},
        { "location": "124/ACT"   , "narrator": "", "text": "寂しいこと言わないで"},
        { "location": "125/TALK"  , "narrator": "つばめ", "text": "大丈夫。\nそんな気持ちすら\nもうなくなっちゃう。"},
        { "location": "126/ACT"   , "narrator": "", "text": "不思議なもんだよね"},
        { "location": "127/TALK"  , "narrator": "つばめ", "text": "その時は真剣だったのに。"},
        { "location": "128/TALK"  , "narrator": "つばめ", "text": "一生懸命\n生きていたのにね。"},
        { "location": "130/TALK"  , "narrator": "つばめ", "text": "わたし思ったの。"},
        { "location": "131/TALK"  , "narrator": "つばめ", "text": "フェノメノンって\nなんだか人の\n一生みたいって。"},
        { "location": "132/TALK"  , "narrator": "つばめ", "text": "フェノメノンが消えたら\nわたしたちは\n新しい人生に戻る。"},
        { "location": "133/TALK"  , "narrator": "つばめ", "text": "これまでのことは\n全部忘れて。"},
        { "location": "134/TALK"  , "narrator": "つばめ", "text": "それって生きて死んで\n生まれ変わるのと\n同じでしょ？"},
        { "location": "135/TALK"  , "narrator": "つばめ", "text": "…人って死んだら\nどこに行くのかな。\n違うのはきっとそこだけ。"},
        { "location": "136/TALK"  , "narrator": "つばめ", "text": "今のわたしはこの先\nどうなるかを知ってる。\nそれだけの違い。"},
        { "location": "137/TALK"  , "narrator": "つばめ", "text": "…そう考えるとね。"},
        { "location": "138/TALK"  , "narrator": "つばめ", "text": "フェノメノンっていう\n偽りの世界でも\nそれは現実と同じ。"},
        { "location": "139/TALK"  , "narrator": "つばめ", "text": "だから精一杯\n生きるべきなんだと\n思うんだ。"},
        { "location": "140/TALK"  , "narrator": "つばめ", "text": "$handle$さんの\n生きている世界は\n現実なのかな？"},
        { "location": "141/SEL"   , "narrator": "", "text": "当たり前でしょ"},
        { "location": "142/SEL"   , "narrator": "", "text": "ちょっと自信ないかな"},
        { "location": "143/SEL"   , "narrator": "", "text": "怖いこと聞かないで"},
        { "location": "144/ACT"   , "narrator": "", "text": "当たり前でしょ"},
        { "location": "146/TALK"  , "narrator": "つばめ", "text": "そうだよね。"},
        { "location": "147/TALK"  , "narrator": "つばめ", "text": "生きている世界は\n現実なんだよね。"},
        { "location": "148/ACT"   , "narrator": "", "text": "ちょっと自信ないかな"},
        { "location": "149/TALK"  , "narrator": "つばめ", "text": "そうなの？"},
        { "location": "151/TALK"  , "narrator": "つばめ", "text": "$handle$さんが\n生きてるんだから\n現実だよ。"},
        { "location": "152/ACT"   , "narrator": "", "text": "怖いこと聞かないで"},
        { "location": "153/TALK"  , "narrator": "つばめ", "text": "考え出すと\nわからなくなるよね。"},
        { "location": "154/TALK"  , "narrator": "つばめ", "text": "現実って何なのかな。"},
        { "location": "156/TALK"  , "narrator": "つばめ", "text": "えっとね……。"},
        { "location": "157/TALK"  , "narrator": "つばめ", "text": "あたしのいる\nフェノメノンの外の\n現実世界がね。"},
        { "location": "158/TALK"  , "narrator": "つばめ", "text": "偽物じゃないっていう\n保証はないでしょ。"},
        { "location": "159/TALK"  , "narrator": "つばめ", "text": "さらにその外に別の\n世界の誰かが作った\nものかもしれない。"},
        { "location": "160/TALK"  , "narrator": "つばめ", "text": "でもそれは、\n世界を作った人だけが\n知っていて。"},
        { "location": "161/TALK"  , "narrator": "つばめ", "text": "生きている人たちは\n自分がいつか死ぬこと\nだけを知ってる。"},
        { "location": "162/TALK"  , "narrator": "つばめ", "text": "中で生きている人たちは\n精一杯生きて、\nそして死んでいく。"},
        { "location": "163/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "164/TALK"  , "narrator": "つばめ", "text": "このフェノメノンは\nわたしが作った。"},
        { "location": "165/TALK"  , "narrator": "つばめ", "text": "だからわたしが\nいなくなったら\nみんなの記憶も消える。"},
        { "location": "166/TALK"  , "narrator": "つばめ", "text": "お父さん、\nお母さん――"},
        { "location": "167/TALK"  , "narrator": "つばめ", "text": "アーヤさん、ガブちゃん\nみやびさん、真幌さん、\nひなこちゃん、繭ちん。"},
        { "location": "168/TALK"  , "narrator": "つばめ", "text": "それからヒカル君、\nキリト君、たまちゃん先生\nパン屋のおばちゃん。"},
        { "location": "169/TALK"  , "narrator": "つばめ", "text": "…それ以外にも\nたくさんの人たちの\nここでの記憶が。"},
        { "location": "170/TALK"  , "narrator": "つばめ", "text": "でもそれは、\n生きていたことに\nなるのかな…？"},
        { "location": "171/TALK"  , "narrator": "つばめ", "text": "それとも夢と同じで\nただの幻みたいな\nものなのかな…？"},
        { "location": "172/SEL"   , "narrator": "", "text": "それもひとつの人生だと思う"},
        { "location": "173/SEL"   , "narrator": "", "text": "夢みたいな幻や虚無だと思う"},
        { "location": "174/ACT"   , "narrator": "", "text": "それもひとつの人生だと思う"},
        { "location": "175/TALK"  , "narrator": "つばめ", "text": "…そっか。"},
        { "location": "176/TALK"  , "narrator": "つばめ", "text": "それもひとつの人生…。"},
        { "location": "177/ACT"   , "narrator": "", "text": "夢みたいな幻や虚無だと思う"},
        { "location": "178/TALK"  , "narrator": "つばめ", "text": "幻や虚無…。"},
        { "location": "179/TALK"  , "narrator": "つばめ", "text": "…そっか…。"},
        { "location": "232/TALK"  , "narrator": "千羽鶴", "text": "ごきげんよう、\n$handle$。"},
        { "location": "236/TALK"  , "narrator": "千羽鶴", "text": "もう二度と現れない筈が、\n何度も出てきてしまって\nごめんなさい。"},
        { "location": "237/TALK"  , "narrator": "千羽鶴", "text": "でも、これは私にも\n回避出来ない必然の\n流れだから。"},
        { "location": "238/TALK"  , "narrator": "千羽鶴", "text": "少しの間だけ辛抱して。"},
        { "location": "242/SEL"   , "narrator": "", "text": "千羽鶴！\nエリカと話したの？"},
        { "location": "243/ACT"   , "narrator": "", "text": "千羽鶴！\nエリカと話したの？"},
        { "location": "245/TALK"  , "narrator": "千羽鶴", "text": "ええ、話をした。\nその結果――"},
        { "location": "246/TALK"  , "narrator": "千羽鶴", "text": "フェノメノンの存続には\n皆から力をもらう必要が\nあるとの判断に至った。"},
        { "location": "247/SEL"   , "narrator": "", "text": "千羽鶴は死んじゃうの！？"},
        { "location": "248/SEL"   , "narrator": "", "text": "力をもらうってどういうこと？"},
        { "location": "249/ACT"   , "narrator": "", "text": "千羽鶴は死んじゃうの！？"},
        { "location": "250/TALK"  , "narrator": "千羽鶴", "text": "……まだ100％消えると\n決まったわけじゃない。"},
        { "location": "251/TALK"  , "narrator": "千羽鶴", "text": "この作戦が上手くいけば\nあるいは――"},
        { "location": "252/ACT"   , "narrator": "", "text": "力をもらうってどういうこと？"},
        { "location": "253/TALK"  , "narrator": "千羽鶴", "text": "今からそのことを話す。"},
        { "location": "256/TALK"  , "narrator": "千羽鶴", "text": "あ、それから。"},
        { "location": "258/TALK"  , "narrator": "千羽鶴", "text": "エリカから、\n貴方が私の死を\n凄く心配してると聞いた。"},
        { "location": "260/TALK"  , "narrator": "千羽鶴", "text": "まあ、現状では\nそれに対する答えは\nどちらともいえないけど。"},
        { "location": "261/TALK"  , "narrator": "千羽鶴", "text": "ひとつだけ\n言わなくちゃいけない\nことがある。"},
        { "location": "264/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "265/TALK"  , "narrator": "千羽鶴", "text": "……ありがと。"},
        { "location": "268/TALK"  , "narrator": "千羽鶴", "text": "えっと……、\n本題に戻る。"},
        { "location": "272/TALK"  , "narrator": "千羽鶴", "text": "私は破壊されてしまった。"},
        { "location": "273/TALK"  , "narrator": "千羽鶴", "text": "東雲真幌は単なる脅し\nだろうと判断したけど、\nまさか別の刺客とは。"},
        { "location": "274/TALK"  , "narrator": "千羽鶴", "text": "いずれにせよ、\n私はもはやこの世界を\n維持することができない。"},
        { "location": "275/TALK"  , "narrator": "千羽鶴", "text": "フェノメノンは収束をし、\n日本は再び初期化される。"},
        { "location": "276/TALK"  , "narrator": "千羽鶴", "text": "本当の意味での\nミッション・\nアンコンプリート。"},
        { "location": "277/SEL"   , "narrator": "", "text": "まだ、どうにかなるはず！"},
        { "location": "278/SEL"   , "narrator": "", "text": "千羽鶴はどうなるの？"},
        { "location": "279/ACT"   , "narrator": "", "text": "まだ、どうにかなるはず！"},
        { "location": "280/TALK"  , "narrator": "千羽鶴", "text": "どうして\nそう言い切れる？"},
        { "location": "281/SEL"   , "narrator": "", "text": "“彼ら”が、勝負をかけてきた"},
        { "location": "282/ACT"   , "narrator": "", "text": "“彼ら”が、勝負をかけてきた"},
        { "location": "284/TALK"  , "narrator": "千羽鶴", "text": "勝負？\n違う。"},
        { "location": "285/TALK"  , "narrator": "千羽鶴", "text": "彼らはただ単に、貴方を\n絶望的な境地に立たせ、\n奇跡を起こすか見たいだけ。"},
        { "location": "286/TALK"  , "narrator": "千羽鶴", "text": "奇跡が起きれば掬い上げ、\n起きなければ破棄する。\nただそれだけ。"},
        { "location": "287/SEL"   , "narrator": "", "text": "なら絶対に奇跡を起こす"},
        { "location": "288/SEL"   , "narrator": "", "text": "血も涙も無いな"},
        { "location": "289/ACT"   , "narrator": "", "text": "なら絶対に奇跡を起こす"},
        { "location": "290/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "291/TALK"  , "narrator": "千羽鶴", "text": "貴方はいつもそうだった。"},
        { "location": "292/TALK"  , "narrator": "千羽鶴", "text": "無茶なことばかり言って。"},
        { "location": "294/TALK"  , "narrator": "千羽鶴", "text": "逆バブが捗る人。"},
        { "location": "295/ACT"   , "narrator": "", "text": "血も涙も無いな"},
        { "location": "296/TALK"  , "narrator": "千羽鶴", "text": "そう。\n“彼ら”には\n血も涙もない。"},
        { "location": "297/TALK"  , "narrator": "千羽鶴", "text": "私は最初、その思想で\n完全に塗り固められた。"},
        { "location": "298/TALK"  , "narrator": "千羽鶴", "text": "そしてその上で、それと\n対極とも言える貴方の\n世界とリンクさせられた。"},
        { "location": "299/TALK"  , "narrator": "千羽鶴", "text": "今思えば、\nそこから既に、この結末は\n決まっていたのかも。"},
        { "location": "301/ACT"   , "narrator": "", "text": "千羽鶴はどうなるの？"},
        { "location": "302/TALK"  , "narrator": "千羽鶴", "text": "今はこうして、辛うじて\n残留意識として深層世界の\n海を漂っているけど――"},
        { "location": "303/TALK"  , "narrator": "千羽鶴", "text": "いずれは消えて無くなる。"},
        { "location": "305/SEL"   , "narrator": "", "text": "はいはいさようなら"},
        { "location": "306/ACT"   , "narrator": "", "text": "はいはいさようなら"},
        { "location": "308/TALK"  , "narrator": "千羽鶴", "text": "ええ。\nでも１つだけ\nお願いがある。"},
        { "location": "309/TALK"  , "narrator": "千羽鶴", "text": "彼女たちとは、\n可能な限り一緒にいて\nあげて欲しい。"},
        { "location": "310/TALK"  , "narrator": "千羽鶴", "text": "これからも、ずっと。\n可能な限り。"},
        { "location": "312/SEL"   , "narrator": "", "text": "そんなのやだ！！"},
        { "location": "313/SEL"   , "narrator": "", "text": "今までありがとう"},
        { "location": "314/ACT"   , "narrator": "", "text": "そんなのやだ！！"},
        { "location": "316/TALK"  , "narrator": "千羽鶴", "text": "ヨシヨシって\nしてあげたいけど、\nもはやそれも無理。"},
        { "location": "317/ACT"   , "narrator": "", "text": "今までありがとう"},
        { "location": "318/TALK"  , "narrator": "千羽鶴", "text": "こちらこそ。\n随分ひっかき回したけど\nずっと一緒にいてくれた。"},
        { "location": "319/TALK"  , "narrator": "千羽鶴", "text": "私は大丈夫。\nだけど――"},
        { "location": "320/TALK"  , "narrator": "千羽鶴", "text": "彼女たちとは、\n可能な限り一緒にいて\nあげて欲しい。"},
        { "location": "321/TALK"  , "narrator": "千羽鶴", "text": "これからも、ずっと。\n可能な限り。"},
        { "location": "325/TALK"  , "narrator": "カレン", "text": "千羽鶴…さん！？"},
        { "location": "344/TALK"  , "narrator": "千羽鶴", "text": "……ごきげんよう。\n新しい私の主人。"},
        { "location": "345/TALK"  , "narrator": "カレン", "text": "あ、あの……"},
        { "location": "346/TALK"  , "narrator": "千羽鶴", "text": "お気遣いは無用。\n貴方は自分の力で\nセルフを勝ち取った。"},
        { "location": "347/TALK"  , "narrator": "千羽鶴", "text": "私にはネガティブな\n返答をする理由は\nなにひとつない。"},
        { "location": "348/TALK"  , "narrator": "カレン", "text": "あ、は、はい！\n宜しくお願いします！"},
        { "location": "349/TALK"  , "narrator": "カレン", "text": "あ、それでですね、\n千羽鶴さん！"},
        { "location": "350/TALK"  , "narrator": "カレン", "text": "大変なんですよ！\n日本を包むフェノメノンが\n壊れ始めてます！！"},
        { "location": "351/TALK"  , "narrator": "千羽鶴", "text": "……当然だけど、\n知ってるから。"},
        { "location": "352/TALK"  , "narrator": "カレン", "text": "あの、それで\n１つ提案が\nあるんですけど！"},
        { "location": "354/TALK"  , "narrator": "千羽鶴", "text": "……ごきげんよう、\nカレン・ディサイプロブ・\nイシュリール。"},
        { "location": "355/TALK"  , "narrator": "千羽鶴", "text": "どうやら\nセルフクランには\nなり損ねたようね。"},
        { "location": "356/TALK"  , "narrator": "カレン", "text": "えへへ……そうなんです。\n$handle$さんに\n止められちゃって。"},
        { "location": "358/TALK"  , "narrator": "千羽鶴", "text": "どうして止めたの？"},
        { "location": "359/SEL"   , "narrator": "", "text": "千羽鶴の居場所がなくなっちゃうから"},
        { "location": "360/SEL"   , "narrator": "", "text": "千羽鶴の理想を支持したいから"},
        { "location": "361/ACT"   , "narrator": "", "text": "千羽鶴の居場所がなくなっちゃうから"},
        { "location": "362/TALK"  , "narrator": "千羽鶴", "text": "ありがと。\n貴方は優しい人。"},
        { "location": "363/ACT"   , "narrator": "", "text": "千羽鶴の理想を支持したいから"},
        { "location": "364/TALK"  , "narrator": "千羽鶴", "text": "ありがとう。\n貴方はとても素敵な人。"},
        { "location": "366/TALK"  , "narrator": "千羽鶴", "text": "でももう心配しないで。\n私はどのみち消える。"},
        { "location": "367/TALK"  , "narrator": "カレン", "text": "あの！\n千羽鶴さん！"},
        { "location": "369/TALK"  , "narrator": "千羽鶴", "text": "なに。"},
        { "location": "370/TALK"  , "narrator": "カレン", "text": "そのことで、\n提案があるんですけど！"},
        { "location": "372/TALK"  , "narrator": "千羽鶴", "text": "ちょっと待って。\nその前に。"},
        { "location": "373/TALK"  , "narrator": "カレン", "text": "はい？"},
        { "location": "374/TALK"  , "narrator": "千羽鶴", "text": "貴方、しれっと\n普通に話してきてるけど、\n大丈夫？"},
        { "location": "375/TALK"  , "narrator": "カレン", "text": "えっと、\nどういう事でしょうか？"},
        { "location": "376/TALK"  , "narrator": "千羽鶴", "text": "いや……。"},
        { "location": "377/TALK"  , "narrator": "千羽鶴", "text": "私は貴方を壊そうとした。\n何度も、何度も。"},
        { "location": "378/TALK"  , "narrator": "千羽鶴", "text": "様々なアプローチと\n手段を使って、洗脳したり\n揺さぶりかけたり。"},
        { "location": "379/TALK"  , "narrator": "千羽鶴", "text": "百鶴という刺客も送った。"},
        { "location": "380/TALK"  , "narrator": "カレン", "text": "百鶴さんのことは\n今でも思い出すと\n悲しいです……。"},
        { "location": "381/TALK"  , "narrator": "カレン", "text": "わたしがもっと\nしっかりしてれば……"},
        { "location": "382/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "383/TALK"  , "narrator": "千羽鶴", "text": "――恨んだり、\n敵対したり\nするのが普通。"},
        { "location": "384/TALK"  , "narrator": "カレン", "text": "しませんよ！！\nそんなこと！"},
        { "location": "385/TALK"  , "narrator": "カレン", "text": "確かに、かなり\n酷い目に遭わされました\nけど――"},
        { "location": "386/TALK"  , "narrator": "カレン", "text": "でも、千羽鶴さんも\nわたしの中の一人\nですから。"},
        { "location": "390/TALK"  , "narrator": "カレン", "text": "それに、今はもう\n千羽鶴さんに何かされる\n怯えもありません。"},
        { "location": "391/TALK"  , "narrator": "カレン", "text": "だってわたし、\nセルフクランに\nなりましたし！"},
        { "location": "392/TALK"  , "narrator": "千羽鶴", "text": "……天然ドS。"},
        { "location": "393/TALK"  , "narrator": "カレン", "text": "あの、お話を\n戻してもいいですか？"},
        { "location": "394/TALK"  , "narrator": "千羽鶴", "text": "どうぞ。"},
        { "location": "395/TALK"  , "narrator": "カレン", "text": "一つ提案なんですけど！"},
        { "location": "396/TALK"  , "narrator": "カレン", "text": "わたしにこの\n日本を包むフェノメノンを\n支えさせてください！"},
        { "location": "397/TALK"  , "narrator": "千羽鶴", "text": "……え。"},
        { "location": "398/TALK"  , "narrator": "カレン", "text": "わたし、この世界が\n消えて無くなるなんて\n絶対無理です！"},
        { "location": "399/TALK"  , "narrator": "カレン", "text": "セルフクランになった\nわたしなら、それは\n可能な筈です。"},
        { "location": "400/TALK"  , "narrator": "千羽鶴", "text": "……可能だけど。"},
        { "location": "401/TALK"  , "narrator": "千羽鶴", "text": "でも、課題は多い。"},
        { "location": "402/TALK"  , "narrator": "千羽鶴", "text": "記憶や想いを継ぐ\n完全な継続維持には\n私が必要不可欠。"},
        { "location": "403/TALK"  , "narrator": "千羽鶴", "text": "いくら母体が同じでも\n別のクランが作った世界は\n所詮別物になるから。"},
        { "location": "404/TALK"  , "narrator": "カレン", "text": "……ああ……。"},
        { "location": "405/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "406/TALK"  , "narrator": "千羽鶴", "text": "私が。"},
        { "location": "407/TALK"  , "narrator": "カレン", "text": "…はい？"},
        { "location": "408/TALK"  , "narrator": "千羽鶴", "text": "私が貴方の傘下に入れば\n継続出来るように\nサポートできる。"},
        { "location": "409/TALK"  , "narrator": "カレン", "text": "本当ですか！？"},
        { "location": "410/TALK"  , "narrator": "千羽鶴", "text": "本当。"},
        { "location": "411/TALK"  , "narrator": "千羽鶴", "text": "けどそこには、\n３つのハードルがある。"},
        { "location": "412/TALK"  , "narrator": "千羽鶴", "text": "１つ目は、\n貴方がそれをしっかり\n受け入れられるか。"},
        { "location": "413/TALK"  , "narrator": "カレン", "text": "もちろんですよ！"},
        { "location": "414/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "415/TALK"  , "narrator": "千羽鶴", "text": "２つ目は、恐らく\n貴方一人では力不足\nだということ。"},
        { "location": "416/TALK"  , "narrator": "カレン", "text": "…ああ……。\nすみません。"},
        { "location": "417/TALK"  , "narrator": "千羽鶴", "text": "気にしないで。\n貴方が弱いんじゃない。\n私が強すぎただけ。"},
        { "location": "418/TALK"  , "narrator": "千羽鶴", "text": "いずれにせよ、\nこの問題は私の方で\n何とかして解決する。"},
        { "location": "420/TALK"  , "narrator": "千羽鶴", "text": "そして３つ目は――"},
        { "location": "422/TALK"  , "narrator": "千羽鶴", "text": "また貴方を\n破壊しようとするかも。"},
        { "location": "423/TALK"  , "narrator": "カレン", "text": "それは無いと思ってます。\n状況も変わりましたし。"},
        { "location": "424/TALK"  , "narrator": "カレン", "text": "だから、今では昔と同じ、\nひとつのわたしの\n一部です！"},
        { "location": "425/TALK"  , "narrator": "千羽鶴", "text": "……本当に変わった子。"},
        { "location": "426/TALK"  , "narrator": "カレン", "text": "あの、お話を\n戻してもいいですか？"},
        { "location": "427/TALK"  , "narrator": "千羽鶴", "text": "どうぞ。"},
        { "location": "428/TALK"  , "narrator": "カレン", "text": "一つ提案なんですけど！"},
        { "location": "429/TALK"  , "narrator": "カレン", "text": "この世界を維持するのに\nわたしの力を\n使ってくれませんか！？"},
        { "location": "430/TALK"  , "narrator": "千羽鶴", "text": "え……？"},
        { "location": "431/TALK"  , "narrator": "カレン", "text": "もちろん、思想も全然\n違いますし、嫌かも\nしれないですけど――"},
        { "location": "432/TALK"  , "narrator": "カレン", "text": "でも、わたしは\nこの世界が消えるのが\n辛いんです！"},
        { "location": "433/TALK"  , "narrator": "カレン", "text": "辛すぎるんです！！"},
        { "location": "434/TALK"  , "narrator": "カレン", "text": "だからどうか、\nお願いします！\nわたし、何でもします！"},
        { "location": "435/TALK"  , "narrator": "カレン", "text": "壊されても\n構いません。\nだから―――"},
        { "location": "436/TALK"  , "narrator": "千羽鶴", "text": "ちょっと待って。\nあせらないで。"},
        { "location": "437/TALK"  , "narrator": "カレン", "text": "は、はい！"},
        { "location": "438/TALK"  , "narrator": "千羽鶴", "text": "結論から言えば、\nそれは不可能じゃない。"},
        { "location": "439/TALK"  , "narrator": "千羽鶴", "text": "その方法は、\nカレン・ディサイプロブ・\nイシュリール――"},
        { "location": "440/TALK"  , "narrator": "千羽鶴", "text": "貴方が、私の傘下に入る\nこと。そして、１つの\n逢瀬つばめに戻ること。"},
        { "location": "441/TALK"  , "narrator": "カレン", "text": "傘下……。"},
        { "location": "442/TALK"  , "narrator": "千羽鶴", "text": "それは単に\n契約を交わすような\nものじゃない。"},
        { "location": "443/TALK"  , "narrator": "千羽鶴", "text": "心の底から\n共にわかり合えると思える\n相互理解が必要。"},
        { "location": "444/TALK"  , "narrator": "千羽鶴", "text": "それが可能か。"},
        { "location": "445/TALK"  , "narrator": "カレン", "text": "……。"},
        { "location": "446/TALK"  , "narrator": "千羽鶴", "text": "さっき貴方は、\n私に対して素敵な言葉を\n投げかけてくれた。"},
        { "location": "447/TALK"  , "narrator": "千羽鶴", "text": "それは、本当のことかも\nしれないし、善意からの\n嘘かもしれない。"},
        { "location": "448/TALK"  , "narrator": "千羽鶴", "text": "けど、今回は\n例え善意でも\n嘘はつけない。"},
        { "location": "449/TALK"  , "narrator": "千羽鶴", "text": "よく考えてみて。"},
        { "location": "451/TALK"  , "narrator": "カレン", "text": "私は……"},
        { "location": "452/TALK"  , "narrator": "カレン", "text": "…私は………"},
        { "location": "453/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "488/TALK"  , "narrator": "カレン", "text": "私は、\n千羽鶴さんの\n傘下に入ります！"},
        { "location": "489/SEL"   , "narrator": "", "text": "まじで！？"},
        { "location": "490/SEL"   , "narrator": "", "text": "$me$の意見は！？"},
        { "location": "491/ACT"   , "narrator": "", "text": "まじで！？"},
        { "location": "493/TALK"  , "narrator": "カレン", "text": "はい。"},
        { "location": "494/ACT"   , "narrator": "", "text": "$me$の意見は！？"},
        { "location": "496/TALK"  , "narrator": "千羽鶴", "text": "ここは彼女の考えを\n聞いている。貴方の考えは\nまた後で聞くから。"},
        { "location": "501/TALK"  , "narrator": "カレン", "text": "$handle$さんと\nお話するようになって、\nわたし色々学びました。"},
        { "location": "502/TALK"  , "narrator": "カレン", "text": "その中でも、\n一番感じたのは、\n誠実さと優しさです。"},
        { "location": "503/TALK"  , "narrator": "カレン", "text": "$handle$さんは\nいつでもわたしに対して\n誠実で優しかったです。"},
        { "location": "504/TALK"  , "narrator": "カレン", "text": "わたしも\nそうありたいと\n思いました。"},
        { "location": "505/TALK"  , "narrator": "カレン", "text": "なのに、自分の一部だった\n千羽鶴さんに優しく\n出来なかったら――"},
        { "location": "506/TALK"  , "narrator": "カレン", "text": "既にこの時点で、\n自分の想いを自分で\n踏みにじってますよね。"},
        { "location": "507/TALK"  , "narrator": "カレン", "text": "だから、過去の事は\n過去の事です。"},
        { "location": "508/TALK"  , "narrator": "カレン", "text": "それと、これからのことは\n別に考えて、誠心誠意\nわたしに尽くしたい。"},
        { "location": "509/TALK"  , "narrator": "カレン", "text": "わたしにとって、\nベストなものを、誠実に\n選択したいんです。"},
        { "location": "511/TALK"  , "narrator": "千羽鶴", "text": "……ありがとう。\n純粋に嬉しい。"},
        { "location": "512/TALK"  , "narrator": "千羽鶴", "text": "そうなると、\n残る問題はあと１つ。"},
        { "location": "516/TALK"  , "narrator": "カレン", "text": "…ごめんなさい。\n私には無理です。"},
        { "location": "517/SEL"   , "narrator": "", "text": "まじで！？"},
        { "location": "518/SEL"   , "narrator": "", "text": "$me$の意見は！？"},
        { "location": "519/ACT"   , "narrator": "", "text": "まじで！？"},
        { "location": "521/TALK"  , "narrator": "カレン", "text": "はい。"},
        { "location": "522/ACT"   , "narrator": "", "text": "$me$の意見は！？"},
        { "location": "524/TALK"  , "narrator": "千羽鶴", "text": "ここは彼女の考えを\n聞いている。貴方の考えは\nまた後で聞くから。"},
        { "location": "528/TALK"  , "narrator": "カレン", "text": "わたし、\n今まであったことを\n色々思い返してみました。"},
        { "location": "529/TALK"  , "narrator": "カレン", "text": "嬉しいことも、\n辛いことも、\n色々ありましたけど――"},
        { "location": "530/TALK"  , "narrator": "カレン", "text": "やっぱり自分のことは\n自分の責任で、\n守っていかなくちゃって。"},
        { "location": "531/TALK"  , "narrator": "カレン", "text": "そう思いました。"},
        { "location": "533/TALK"  , "narrator": "カレン", "text": "だから、やはりわたしを\n消そうとした千羽鶴さんと\n一緒には…なれません。"},
        { "location": "534/TALK"  , "narrator": "千羽鶴", "text": "そうね。\nそれが普通だと思う。"},
        { "location": "535/TALK"  , "narrator": "千羽鶴", "text": "けどその場合、\nこの世界を維持する方法は\nあと１つだけ。"},
        { "location": "536/TALK"  , "narrator": "カレン", "text": "それはどんな！？"},
        { "location": "537/TALK"  , "narrator": "千羽鶴", "text": "カレンが私を倒し、\n事実上のセルフクランに\nなってしまうこと。"},
        { "location": "538/TALK"  , "narrator": "千羽鶴", "text": "そして、私は貴方の\n傘下に入り、世界の理を\n共有する。"},
        { "location": "539/TALK"  , "narrator": "カレン", "text": "でも、\nそんなことしたら！"},
        { "location": "540/TALK"  , "narrator": "千羽鶴", "text": "貴方が私を受け入れ\nられないのは、\n正直な気持ち。"},
        { "location": "541/TALK"  , "narrator": "千羽鶴", "text": "私はそこに\n異論は無い。"},
        { "location": "542/TALK"  , "narrator": "千羽鶴", "text": "そして、この世界を\n存続させたいという\n気持ちは両者同様。"},
        { "location": "543/TALK"  , "narrator": "千羽鶴", "text": "私はどのみち、\nこのまま放っておけば\n消えてしまう。"},
        { "location": "544/TALK"  , "narrator": "千羽鶴", "text": "貴方の傘下に入って\n生きながらえるのは、\nそれより遙かに良い選択。"},
        { "location": "545/TALK"  , "narrator": "千羽鶴", "text": "だから、私にとっては\n妥当な方法だと思ってる。"},
        { "location": "546/TALK"  , "narrator": "千羽鶴", "text": "後はあなた次第。"},
        { "location": "547/TALK"  , "narrator": "カレン", "text": "わたし……次第……"},
        { "location": "548/TALK"  , "narrator": "カレン", "text": "……。"},
        { "location": "549/TALK"  , "narrator": "カレン", "text": "…わかりました。\nそれでお願いします。"},
        { "location": "550/TALK"  , "narrator": "千羽鶴", "text": "そう。\nわかった。"},
        { "location": "551/TALK"  , "narrator": "千羽鶴", "text": "そうなると、\n残る問題はあと２つ。"},
        { "location": "552/TALK"  , "narrator": "千羽鶴", "text": "１つ目は、\nカレンでは少々\n力が足りないこと。"},
        { "location": "553/TALK"  , "narrator": "カレン", "text": "…ああ……。\nすみません。"},
        { "location": "554/TALK"  , "narrator": "千羽鶴", "text": "気にしないで。\n貴方が弱いんじゃない。\n私が強すぎただけ。"},
        { "location": "555/TALK"  , "narrator": "千羽鶴", "text": "いずれにせよ、\nこの問題は私の方で\n何とかして解決する。"},
        { "location": "557/TALK"  , "narrator": "千羽鶴", "text": "そして２つ目は――"},
        { "location": "562/TALK"  , "narrator": "千羽鶴", "text": "$handle$。\n貴方がこのやり方を\n受け入れられるかどうか。"},
        { "location": "564/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "565/TALK"  , "narrator": "千羽鶴", "text": "なんて質問は\n野暮すぎた。"},
        { "location": "566/TALK"  , "narrator": "千羽鶴", "text": "だって、貴方と私は\nもう、キスした仲だもの、\n受け入れないわけがない。"},
        { "location": "567/TALK"  , "narrator": "カレン", "text": "え"},
