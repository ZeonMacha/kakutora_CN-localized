    "entry":
    [
        { "location": "189/SCENARIO", "narrator": "", "text": "トーキョー奇譚"},
        { "location": "210/TALK"    , "narrator": "ガブリエラ", "text": "…お客さん、\n来ないわね。"},
        { "location": "212/TALK"    , "narrator": "みやび", "text": "いつものことぞね。"},
        { "location": "214/TALK"    , "narrator": "つばめ", "text": "掃除ももう\n終わっちゃい\nましたしね……。"},
        { "location": "217/TALK"    , "narrator": "みやび", "text": "いっそ今日は\n休館日に\nしたらどうかいね。"},
        { "location": "218/TALK"    , "narrator": "つばめ", "text": "そんなことして\nいいんですか！？"},
        { "location": "221/TALK"    , "narrator": "ガブリエラ", "text": "……さすがにそれは\nダメでしょ……。"},
        { "location": "225/TALK"    , "narrator": "みやび", "text": "ガブちゃんは\n真面目やねえ。"},
        { "location": "226/TALK"    , "narrator": "みやび", "text": "うち以上に真面目なんは\nガブちゃんだけぞね。"},
        { "location": "228/TALK"    , "narrator": "ガブリエラ", "text": "みやびより不真面目な\n人なんて滅多にいないの\n間違いでしょ？"},
        { "location": "230/TALK"    , "narrator": "神楽", "text": "…実は。"},
        { "location": "231/TALK"    , "narrator": "神楽", "text": "真面目に聞いて欲しい\n話があるんです。"},
        { "location": "235/TALK"    , "narrator": "みやび", "text": "え？"},
        { "location": "239/TALK"    , "narrator": "つばめ", "text": "どんな話？"},
        { "location": "240/TALK"    , "narrator": "神楽", "text": "神楽坂と\n卯月神楽にまつわる\n秘密の話です。"},
        { "location": "241/TALK"    , "narrator": "みやび", "text": "……なるほど？"},
        { "location": "242/SEL"     , "narrator": "", "text": "聞いてないよ！？"},
        { "location": "243/ACT"     , "narrator": "", "text": "聞いてないよ！？"},
        { "location": "260/TALK"    , "narrator": "神楽", "text": "そういえば"},
        { "location": "261/TALK"    , "narrator": "神楽", "text": "$handle$さんにも言ってない話でした♪"},
        { "location": "263/SEL"     , "narrator": "", "text": "後付けの設定かなー"},
        { "location": "264/SEL"     , "narrator": "", "text": "$me$に先に教えて欲しかった"},
        { "location": "265/SEL"     , "narrator": "", "text": "聞くのが楽しみ"},
        { "location": "266/ACT"     , "narrator": "", "text": "後付けの設定かなー"},
        { "location": "267/TALK"    , "narrator": "神楽", "text": "後付けっていうか"},
        { "location": "268/TALK"    , "narrator": "神楽", "text": "今思いついた話なんですけどね♪"},
        { "location": "271/ACT"     , "narrator": "", "text": "$me$に先に教えて欲しかった"},
        { "location": "272/TALK"    , "narrator": "神楽", "text": "ちょっと難しいですね～"},
        { "location": "273/TALK"    , "narrator": "神楽", "text": "今思いついた話ですから♪"},
        { "location": "275/ACT"     , "narrator": "", "text": "聞くのが楽しみ"},
        { "location": "276/TALK"    , "narrator": "神楽", "text": "ハードル上がっちゃいましたね"},
        { "location": "277/TALK"    , "narrator": "神楽", "text": "ぴょんこがんばります★"},
        { "location": "291/TALK"    , "narrator": "神楽", "text": "…お待たせしました。"},
        { "location": "292/TALK"    , "narrator": "神楽", "text": "神楽と神楽坂の\n秘密をお話しましょう。"},
        { "location": "293/TALK"    , "narrator": "つばめ", "text": "……。"},
        { "location": "294/TALK"    , "narrator": "神楽", "text": "この坂には\n神楽パワーが\n満ちているんです。"},
        { "location": "295/TALK"    , "narrator": "つばめ", "text": "そうなんだ！？"},
        { "location": "296/TALK"    , "narrator": "みやび", "text": "へえ？"},
        { "location": "297/TALK"    , "narrator": "ガブリエラ", "text": "またまた"},
        { "location": "299/SEL"     , "narrator": "", "text": "どんなパワー？"},
        { "location": "300/ACT"     , "narrator": "", "text": "どんなパワー？"},
        { "location": "317/TALK"    , "narrator": "神楽", "text": "何にすればいいでしょう？"},
        { "location": "319/SEL"     , "narrator": "", "text": "決めてなかったの？"},
        { "location": "320/SEL"     , "narrator": "", "text": "いや聞かれても"},
        { "location": "321/ACT"     , "narrator": "", "text": "決めてなかったの？"},
        { "location": "323/TALK"    , "narrator": "神楽", "text": "そうなんです"},
        { "location": "324/ACT"     , "narrator": "", "text": "いや聞かれても"},
        { "location": "325/TALK"    , "narrator": "神楽", "text": "そんな"},
        { "location": "326/TALK"    , "narrator": "神楽", "text": "$handle$さんだけが頼りなんです～～～"},
        { "location": "329/SEL"     , "narrator": "", "text": "天気を左右する力"},
        { "location": "330/SEL"     , "narrator": "", "text": "坂道を楽しく上る力"},
        { "location": "331/SEL"     , "narrator": "", "text": "恋愛成就の力"},
        { "location": "332/ACT"     , "narrator": "", "text": "天気を左右する力"},
        { "location": "333/TALK"    , "narrator": "神楽", "text": "かなり強いパワーですねっ"},
        { "location": "335/TALK"    , "narrator": "神楽", "text": "気に入りました♪"},
        { "location": "347/TALK"    , "narrator": "神楽", "text": "えー…。\n天気を左右する力\nなんです。"},
        { "location": "348/TALK"    , "narrator": "みやび", "text": "それはまた便利な\n力やねえ。"},
        { "location": "349/TALK"    , "narrator": "つばめ", "text": "本当だね！\n卯月さんすごい！"},
        { "location": "350/TALK"    , "narrator": "神楽", "text": "そうでしょう？\nありがとうございます。"},
        { "location": "352/TALK"    , "narrator": "つばめ", "text": "かっこいいね！\nさすがだよ！"},
        { "location": "353/TALK"    , "narrator": "ガブリエラ", "text": "…いやいや。\nまあいいか。"},
        { "location": "354/ACT"     , "narrator": "", "text": "坂道を楽しく上る力"},
        { "location": "355/TALK"    , "narrator": "神楽", "text": "微妙ですね……。"},
        { "location": "356/TALK"    , "narrator": "神楽", "text": "でもその位地味な方がリアリティがあるかもしれませんねっ♪"},
        { "location": "368/TALK"    , "narrator": "神楽", "text": "えっとですね…。"},
        { "location": "369/TALK"    , "narrator": "神楽", "text": "坂道を楽しく上る力\nなんです。"},
        { "location": "370/TALK"    , "narrator": "ガブリエラ", "text": "…期待したけど\nいまいちね。"},
        { "location": "371/TALK"    , "narrator": "みやび", "text": "もっと\n超常現象的なものを\n期待したんやけんど。"},
        { "location": "372/TALK"    , "narrator": "つばめ", "text": "ううん、すごいよ！"},
        { "location": "373/TALK"    , "narrator": "つばめ", "text": "わたしいつも\n神楽坂歩くの\n楽しいなって思ってた。"},
        { "location": "375/TALK"    , "narrator": "つばめ", "text": "それは卯月さんの\nおかげだったんだね！"},
        { "location": "376/TALK"    , "narrator": "神楽", "text": "そ、そうです、ね…。"},
        { "location": "377/TALK"    , "narrator": "ガブリエラ", "text": "そういうことに\nしておけば？"},
        { "location": "378/ACT"     , "narrator": "", "text": "恋愛成就の力"},
        { "location": "379/TALK"    , "narrator": "神楽", "text": "女子ウケしそうな答えですね"},
        { "location": "380/TALK"    , "narrator": "神楽", "text": "そうしてみます♪"},
        { "location": "392/TALK"    , "narrator": "神楽", "text": "恋愛成就の力が\nあるんです。"},
        { "location": "393/TALK"    , "narrator": "みやび", "text": "…坂に？"},
        { "location": "394/TALK"    , "narrator": "神楽", "text": "そ、そうですね。\n神楽坂をそぞろ歩けば\n恋が実るんです。"},
        { "location": "396/TALK"    , "narrator": "みやび", "text": "…それはまた\nえろうロマンチック\nやねえ。"},
        { "location": "397/TALK"    , "narrator": "ガブリエラ", "text": "ほんとにねー。"},
        { "location": "398/TALK"    , "narrator": "つばめ", "text": "うん！\nそうだよね！"},
        { "location": "401/TALK"    , "narrator": "みやび", "text": "お？"},
        { "location": "402/TALK"    , "narrator": "つばめ", "text": "だからデートコースに\nする人がいるんだね。\n知らなかったよ。"},
        { "location": "403/TALK"    , "narrator": "みやび", "text": "…まあそうやろうねえ。"},
        { "location": "405/TALK"    , "narrator": "ガブリエラ", "text": "信じれば本当に\nなるかもよ？"},
        { "location": "199/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>某月某日　4:24 PM</color>\nとある平日、神楽坂トライナリーにて"}
    ]
}
