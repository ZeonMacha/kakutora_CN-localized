{
    "dir": "chap33/daydra/dd_ch02_33_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "33202",
        "cid": "ayami",
        "title": "002 メインストーリー",
        "sub_title": "少女の器＜前編＞"
    },
    "entry":
    [
        { "location": "8/SCENARIO", "narrator": "", "text": "少女の器"},
        { "location": "25/TALK"   , "narrator": "アーヤ", "text": "そろそろね……。"},
        { "location": "26/TALK"   , "narrator": "アーヤ", "text": "５、４、３、２、１。"},
        { "location": "34/TALK"   , "narrator": "アーヤ", "text": "アーケロンが爆発\nするのは敵にすれば\n想定外。"},
        { "location": "35/TALK"   , "narrator": "アーヤ", "text": "一瞬思考停止状態に\nなるのは当然。"},
        { "location": "36/TALK"   , "narrator": "アーヤ", "text": "そこへこのタイミングで\n脱出ポッドが射出されたら\n罠とは思い至らない。"},
        { "location": "38/TALK"   , "narrator": "アーヤ", "text": "――予想通りね。"},
        { "location": "39/TALK"   , "narrator": "アーヤ", "text": "通常攻撃隊は\n全員脱出ポッドへ\n向かったわ。"},
        { "location": "40/TALK"   , "narrator": "アーヤ", "text": "……それにしても……。"},
        { "location": "41/TALK"   , "narrator": "アーヤ", "text": "千羽鶴と卯月は\n周りが見えて\nいないの…？"},
        { "location": "42/TALK"   , "narrator": "アーヤ", "text": "ううん、\nそんなことはない。"},
        { "location": "43/TALK"   , "narrator": "アーヤ", "text": "爆発の時は動きが\n止まっていたもの。"},
        { "location": "50/TALK"   , "narrator": "透明真幌", "text": "生きていたか。"},
        { "location": "51/TALK"   , "narrator": "アーヤ", "text": "…どうでしょう。\n心霊電話かも\nしれませんよ。"},
        { "location": "52/TALK"   , "narrator": "透明真幌", "text": "…なるほど。\n全員無事そうだな。"},
        { "location": "53/TALK"   , "narrator": "透明真幌", "text": "アーケロンのＰｉｎｇが\n途絶えたから\n心配していたんだが。"},
        { "location": "54/TALK"   , "narrator": "透明真幌", "text": "……状況は？"},
        { "location": "55/TALK"   , "narrator": "アーヤ", "text": "現在は\nつばめ、卯月、千羽鶴の\n姿が確認できています。"},
        { "location": "56/TALK"   , "narrator": "アーヤ", "text": "こちらはドーム内で\n救出のタイミングを\n図っています。"},
        { "location": "57/TALK"   , "narrator": "透明真幌", "text": "なるほど。"},
        { "location": "58/TALK"   , "narrator": "透明真幌", "text": "千羽鶴をつばめから\n気を逸らさせる\n必要があるな。"},
        { "location": "59/TALK"   , "narrator": "透明真幌", "text": "ドームのサイネージを\n利用しよう。"},
        { "location": "60/TALK"   , "narrator": "透明真幌", "text": "私がサイネージを通して\n千羽鶴に話し掛ける。\nその間にどうにかしろ。"},
        { "location": "62/TALK"   , "narrator": "アーヤ", "text": "どうにか、って…。"},
        { "location": "63/TALK"   , "narrator": "透明真幌", "text": "計画はあるんだろう。\n大胆に動け。"},
        { "location": "64/TALK"   , "narrator": "アーヤ", "text": "…はい。"},
        { "location": "65/TALK"   , "narrator": "透明真幌", "text": "ああ。サイネージの\nジャックは光月たちが\n協力してくれた。"},
        { "location": "66/TALK"   , "narrator": "透明真幌", "text": "今の状況を光月たちに\n共有できたら\n連絡する。"},
        { "location": "67/TALK"   , "narrator": "透明真幌", "text": "そちらも準備を\n進めておけ。"},
        { "location": "74/TALK"   , "narrator": "アーヤ", "text": "慎重に決めて大胆に動け。\n館長の口癖ね。"},
        { "location": "75/TALK"   , "narrator": "アーヤ", "text": "光月さんたちも\n危ないってわかってるのに\n相変わらずだし。"},
        { "location": "77/TALK"   , "narrator": "アーヤ", "text": "ギャヴィもみやびも\n常にベストを\n尽くしてくれてる。"},
        { "location": "78/TALK"   , "narrator": "アーヤ", "text": "それから――。"},
        { "location": "90/TALK"   , "narrator": "アーヤ", "text": "ありがとう"},
        { "location": "91/TALK"   , "narrator": "アーヤ", "text": "$handle$さん"},
        { "location": "93/SEL"    , "narrator": "", "text": "どういたしまして"},
        { "location": "94/SEL"    , "narrator": "", "text": "改まって何"},
        { "location": "95/SEL"    , "narrator": "", "text": "礼にはまだ早いよ"},
        { "location": "96/ACT"    , "narrator": "", "text": "どういたしまして"},
        { "location": "97/TALK"   , "narrator": "アーヤ", "text": "本当に"},
        { "location": "98/TALK"   , "narrator": "アーヤ", "text": "ありがとう"},
        { "location": "99/ACT"    , "narrator": "", "text": "改まって何"},
        { "location": "100/TALK"  , "narrator": "アーヤ", "text": "言っておかないと"},
        { "location": "101/TALK"  , "narrator": "アーヤ", "text": "いけないことだから"},
        { "location": "102/ACT"   , "narrator": "", "text": "礼にはまだ早いよ"},
        { "location": "103/TALK"  , "narrator": "アーヤ", "text": "そんなことないわ"},
        { "location": "105/TALK"  , "narrator": "アーヤ", "text": "これが最後の通信に"},
        { "location": "106/TALK"  , "narrator": "アーヤ", "text": "なるかもしれないから"},
        { "location": "108/SEL"   , "narrator": "", "text": "縁起でもない"},
        { "location": "109/SEL"   , "narrator": "", "text": "絶対生きてるって"},
        { "location": "110/SEL"   , "narrator": "", "text": "二人の未来はどうなるの"},
        { "location": "111/ACT"   , "narrator": "", "text": "縁起でもない"},
        { "location": "112/TALK"  , "narrator": "アーヤ", "text": "最悪の事態は想定しておかないと"},
        { "location": "113/ACT"   , "narrator": "", "text": "絶対生きてるって"},
        { "location": "114/TALK"  , "narrator": "アーヤ", "text": "そのつもりではいるけど"},
        { "location": "115/ACT"   , "narrator": "", "text": "二人の未来はどうなるの"},
        { "location": "116/TALK"  , "narrator": "アーヤ", "text": "ごめんね"},
        { "location": "118/TALK"  , "narrator": "アーヤ", "text": "最初は警戒したし"},
        { "location": "119/TALK"  , "narrator": "アーヤ", "text": "その後も八つ当たりしたり"},
        { "location": "120/TALK"  , "narrator": "アーヤ", "text": "したこともあったわ"},
        { "location": "121/TALK"  , "narrator": "アーヤ", "text": "ごめんなさい"},
        { "location": "122/TALK"  , "narrator": "アーヤ", "text": "でも"},
        { "location": "123/TALK"  , "narrator": "アーヤ", "text": "今は出会えてよかった"},
        { "location": "124/TALK"  , "narrator": "アーヤ", "text": "支えてくれてありがとう"},
        { "location": "127/SEL"   , "narrator": "", "text": "そんな言い方"},
        { "location": "128/SEL"   , "narrator": "", "text": "これから先もきっとあるから"},
        { "location": "129/SEL"   , "narrator": "", "text": "このフラグは絶対折る！"},
        { "location": "130/ACT"   , "narrator": "", "text": "そんな言い方"},
        { "location": "131/TALK"  , "narrator": "アーヤ", "text": "おかしい？"},
        { "location": "132/ACT"   , "narrator": "", "text": "これから先もきっとあるから"},
        { "location": "133/TALK"  , "narrator": "アーヤ", "text": "だといいわね"},
        { "location": "134/ACT"   , "narrator": "", "text": "このフラグは絶対折る！"},
        { "location": "135/TALK"  , "narrator": "アーヤ", "text": "強気なのね"},
        { "location": "137/TALK"  , "narrator": "アーヤ", "text": "私、覚悟はできてるの"},
        { "location": "138/TALK"  , "narrator": "アーヤ", "text": "でも"},
        { "location": "140/TALK"  , "narrator": "アーヤ", "text": "また会えた時は"},
        { "location": "141/TALK"  , "narrator": "アーヤ", "text": "笑ってね"},
        { "location": "154/TALK"  , "narrator": "アーヤ", "text": "もう少し時間が\nありそうね…。"},
        { "location": "166/TALK"  , "narrator": "アーヤ", "text": "聞いてくれる？"},
        { "location": "167/TALK"  , "narrator": "アーヤ", "text": "私ずっと後悔してたの"},
        { "location": "168/TALK"  , "narrator": "アーヤ", "text": "姉とのこと"},
        { "location": "169/TALK"  , "narrator": "アーヤ", "text": "お姉ちゃんは私に何も言わずにフランスに行って"},
        { "location": "170/TALK"  , "narrator": "アーヤ", "text": "取り残されたみたいで"},
        { "location": "171/TALK"  , "narrator": "アーヤ", "text": "腹が立って悔しくてさみしくて"},
        { "location": "172/TALK"  , "narrator": "アーヤ", "text": "ずっと側にいるんじゃなかったのって"},
        { "location": "173/TALK"  , "narrator": "アーヤ", "text": "でもそれは"},
        { "location": "174/TALK"  , "narrator": "アーヤ", "text": "嫌いだからじゃなくて"},
        { "location": "175/TALK"  , "narrator": "アーヤ", "text": "嫌われたからじゃなくて"},
        { "location": "176/TALK"  , "narrator": "アーヤ", "text": "私がお姉ちゃんを無視してたから"},
        { "location": "177/TALK"  , "narrator": "アーヤ", "text": "言うことができなかっただけなの"},
        { "location": "178/TALK"  , "narrator": "アーヤ", "text": "だけど私"},
        { "location": "179/TALK"  , "narrator": "アーヤ", "text": "それを認めたくなくて"},
        { "location": "180/TALK"  , "narrator": "アーヤ", "text": "嘘をついた姉のことは許せない、嫌いだって"},
        { "location": "181/TALK"  , "narrator": "アーヤ", "text": "ずっと思い続けてて"},
        { "location": "182/TALK"  , "narrator": "アーヤ", "text": "思い続けるしかなくて"},
        { "location": "183/TALK"  , "narrator": "アーヤ", "text": "だけど同時に後悔してた"},
        { "location": "186/TALK"  , "narrator": "アーヤ", "text": "そういうの"},
        { "location": "187/TALK"  , "narrator": "アーヤ", "text": "もうしたくない"},
        { "location": "190/TALK"  , "narrator": "アーヤ", "text": "だから"},
        { "location": "193/TALK"  , "narrator": "アーヤ", "text": "$handle$さん"},
        { "location": "194/TALK"  , "narrator": "アーヤ", "text": "私、あなたと別れたくない"},
        { "location": "195/TALK"  , "narrator": "アーヤ", "text": "ずっとこの先も一緒にいたい"},
        { "location": "196/TALK"  , "narrator": "アーヤ", "text": "本当よ"},
        { "location": "207/TALK"  , "narrator": "アーヤ", "text": "覚悟はできてるなんて\nやっぱり嘘。"},
        { "location": "208/TALK"  , "narrator": "アーヤ", "text": "私、やっぱり\n死にたくない。"},
        { "location": "210/TALK"  , "narrator": "アーヤ", "text": "死にたくない……！"},
        { "location": "258/TALK"  , "narrator": "アーヤ", "text": "　"},
        { "location": "286/TALK"  , "narrator": "エヴェレット", "text": "あの。\nもう来ないでって\n言いませんでしたっけ？"},
        { "location": "287/TALK"  , "narrator": "エヴェレット", "text": "本気で\nむかついてるんですけど。"},
        { "location": "288/SEL"   , "narrator": "", "text": "わかりました"},
        { "location": "289/SEL"   , "narrator": "", "text": "すみませんでした"},
        { "location": "290/ACT"   , "narrator": "", "text": "わかりました"},
        { "location": "298/ACT"   , "narrator": "", "text": "すみませんでした"},
        { "location": "299/TALK"  , "narrator": "エヴェレット", "text": "もう……"},
        { "location": "300/TALK"  , "narrator": "エヴェレット", "text": "謝るなら最初から\n言わないで……。"},
        { "location": "301/TALK"  , "narrator": "エヴェレット", "text": "私だって、\n凄く悲しかったんだから。"},
        { "location": "302/SEL"   , "narrator": "", "text": "ほんとにごめんね？"},
        { "location": "303/ACT"   , "narrator": "", "text": "ほんとにごめんね？"},
        { "location": "306/TALK"  , "narrator": "エヴェレット", "text": "…もういいわよ。"},
        { "location": "307/TALK"  , "narrator": "エヴェレット", "text": "でも、もう二度と\nそういうこと言わないで。"},
        { "location": "308/TALK"  , "narrator": "エヴェレット", "text": "やっぱり、\n冗談でもそういうの\n言われると辛い。"},
        { "location": "309/TALK"  , "narrator": "エヴェレット", "text": "傷になっちゃうから。"},
        { "location": "310/TALK"  , "narrator": "エヴェレット", "text": "……。"},
        { "location": "311/TALK"  , "narrator": "エヴェレット", "text": "うん。"},
        { "location": "312/TALK"  , "narrator": "エヴェレット", "text": "もうこの話は\nこれでおしまい。"},
        { "location": "313/TALK"  , "narrator": "エヴェレット", "text": "それじゃ、\n気を取り直して\nいきましょうか。"},
        { "location": "314/TALK"  , "narrator": "エヴェレット", "text": "改めまして――"},
        { "location": "330/TALK"  , "narrator": "昇華エヴェレット", "text": "…はぁ……はぁ……"},
        { "location": "331/TALK"  , "narrator": "昇華エヴェレット", "text": "……っ…"},
        { "location": "332/TALK"  , "narrator": "昇華エヴェレット", "text": "私……"},
        { "location": "340/SEL"   , "narrator": "", "text": "戻ったの！？"},
        { "location": "341/ACT"   , "narrator": "", "text": "戻ったの！？"},
        { "location": "343/TALK"  , "narrator": "エヴェレット", "text": "…そうみたい……。"},
        { "location": "346/TALK"  , "narrator": "エヴェレット", "text": "ありがとう、\n$handle$さん。\n色々協力してくれて。"},
        { "location": "347/TALK"  , "narrator": "エヴェレット", "text": "それと――"},
        { "location": "348/TALK"  , "narrator": "エヴェレット", "text": "ただいま。"},
        { "location": "349/SEL"   , "narrator": "", "text": "おかえりなさい！"},
        { "location": "350/SEL"   , "narrator": "", "text": "もう何ヶ月ぶりだよー！！"},
        { "location": "351/ACT"   , "narrator": "", "text": "おかえりなさい！"},
        { "location": "352/TALK"  , "narrator": "エヴェレット", "text": "ふふ。"},
        { "location": "353/ACT"   , "narrator": "", "text": "もう何ヶ月ぶりだよー！！"},
        { "location": "354/TALK"  , "narrator": "エヴェレット", "text": "ごめんなさい。"},
        { "location": "355/TALK"  , "narrator": "エヴェレット", "text": "私も寂しかったのよ？\nだから、おあいこ。"},
        { "location": "358/TALK"  , "narrator": "エヴェレット", "text": "私を千羽鶴の\n改ざんから切り離して\nくれてありがとう。"},
        { "location": "359/SEL"   , "narrator": "", "text": "大丈夫だった？"},
        { "location": "360/ACT"   , "narrator": "", "text": "大丈夫だった？"},
        { "location": "362/TALK"  , "narrator": "エヴェレット", "text": "ええ。お陰様で。"},
        { "location": "363/TALK"  , "narrator": "エヴェレット", "text": "けど、昇華したのに\n何も出来なかった……"},
        { "location": "364/TALK"  , "narrator": "エヴェレット", "text": "今でもセルフクランは\n発症を望んでいる\nままだし。"},
        { "location": "366/TALK"  , "narrator": "エヴェレット", "text": "せっかく貴方が\n協力してくれたのにね。"},
        { "location": "367/SEL"   , "narrator": "", "text": "$me$も何もできなかったよ"},
        { "location": "368/ACT"   , "narrator": "", "text": "$me$も何もできなかったよ"},
        { "location": "370/TALK"  , "narrator": "エヴェレット", "text": "ううん。\n私の正気を\n保ってくれた。"},
        { "location": "371/TALK"  , "narrator": "エヴェレット", "text": "それに、現実世界でも、\n私の心を落ち着かせる為に\n頑張ってくれたわよね。"},
        { "location": "372/TALK"  , "narrator": "エヴェレット", "text": "お陰でセルフクランは\n辛うじて発症を免れた。"},
        { "location": "373/TALK"  , "narrator": "エヴェレット", "text": "貴方には\nどんなにお礼をしても\nしきれないわね。"},
        { "location": "374/SEL"   , "narrator": "", "text": "好きでやってるだけだから"},
        { "location": "375/SEL"   , "narrator": "", "text": "お礼にちゅーして！"},
        { "location": "376/ACT"   , "narrator": "", "text": "好きでやってるだけだから"},
        { "location": "378/TALK"  , "narrator": "エヴェレット", "text": "ありがと。"},
        { "location": "379/ACT"   , "narrator": "", "text": "お礼にちゅーして！"},
        { "location": "383/TALK"  , "narrator": "エヴェレット", "text": "え……"},
        { "location": "385/TALK"  , "narrator": "エヴェレット", "text": "ええええっ！？"},
        { "location": "386/TALK"  , "narrator": "エヴェレット", "text": "うーん……\nどうしよっかな……"},
        { "location": "387/SEL"   , "narrator": "", "text": "その反応は脈有りと見た！"},
        { "location": "388/SEL"   , "narrator": "", "text": "あ、でも、無理なら無理でいいよ？"},
        { "location": "389/ACT"   , "narrator": "", "text": "その反応は脈有りと見た！"},
        { "location": "391/TALK"  , "narrator": "エヴェレット", "text": "自信過剰。"},
        { "location": "392/ACT"   , "narrator": "", "text": "あ、でも、無理なら無理でいいよ？"},
        { "location": "394/TALK"  , "narrator": "エヴェレット", "text": "そ、そうなの？"},
        { "location": "396/TALK"  , "narrator": "エヴェレット", "text": "……んー、\nちょっと考えさせて。"},
        { "location": "399/TALK"  , "narrator": "エヴェレット", "text": "とにかく、私は\nこれからも今の私を\n大事にしていくつもり。"},
        { "location": "400/TALK"  , "narrator": "エヴェレット", "text": "だから、これからも\nサポートしてくれると\n嬉しいかな。"},
        { "location": "402/TALK"  , "narrator": "エヴェレット", "text": "でも、\n貴方にとってはその方が\n都合がいいのよね？"},
        { "location": "403/TALK"  , "narrator": "エヴェレット", "text": "発症させたい\nみたいだったし。"},
        { "location": "404/TALK"  , "narrator": "エヴェレット", "text": "よければ、\nその理由を聞かせて\nもらえないかしら？"},
        { "location": "405/SEL"   , "narrator": "", "text": "つばめに洗脳されていないアーヤを大事にしたいから"},
        { "location": "406/SEL"   , "narrator": "", "text": "エヴェレットが嫌いだから"},
        { "location": "407/SEL"   , "narrator": "", "text": "実はあまり意味も無く何となく"},
        { "location": "408/ACT"   , "narrator": "", "text": "つばめに洗脳されていないアーヤを大事にしたいから"},
        { "location": "409/TALK"  , "narrator": "エヴェレット", "text": "そう。"},
        { "location": "410/TALK"  , "narrator": "エヴェレット", "text": "そう言われてしまうと、\n何も言い返せないわね。"},
        { "location": "411/TALK"  , "narrator": "エヴェレット", "text": "感覚ではよくわからない\nけど、千羽鶴が言うには\n私は洗脳されてるのよね？"},
        { "location": "412/SEL"   , "narrator": "", "text": "そう"},
        { "location": "413/ACT"   , "narrator": "", "text": "そう"},
        { "location": "415/TALK"  , "narrator": "エヴェレット", "text": "それでも、\n私にとってはこれが\n現実なの。"},
        { "location": "416/TALK"  , "narrator": "エヴェレット", "text": "とはいえ、私が封印して\nいて、苦しんでる他の\n私がいるなら――"},
        { "location": "417/TALK"  , "narrator": "エヴェレット", "text": "あ、いや、\nそういうわけでも\nないのかしら？"},
        { "location": "418/TALK"  , "narrator": "エヴェレット", "text": "私が、本当は今の私の\nような考え方ではなくて、\n多分全然違う……"},
        { "location": "419/TALK"  , "narrator": "エヴェレット", "text": "うーん……\nやっぱりちょっと\n想像つかないわ。"},
        { "location": "420/ACT"   , "narrator": "", "text": "エヴェレットが嫌いだから"},
        { "location": "422/TALK"  , "narrator": "エヴェレット", "text": "あー、そう。"},
        { "location": "423/TALK"  , "narrator": "エヴェレット", "text": "それじゃ仕方ないわね。"},
        { "location": "424/TALK"  , "narrator": "エヴェレット", "text": "ただ、１つだけ\nお願いがあるの。"},
        { "location": "425/TALK"  , "narrator": "エヴェレット", "text": "私の事が嫌いなら\nそれはそれでいいわ。"},
        { "location": "426/TALK"  , "narrator": "エヴェレット", "text": "ただ、私が嫌いって理由で\n現実の私が発症した方が\nいいって思ってるなら――"},
        { "location": "427/TALK"  , "narrator": "エヴェレット", "text": "それは、もう一度\n考え直してみて欲しい。"},
        { "location": "428/TALK"  , "narrator": "エヴェレット", "text": "私と現実の私は\nイコールじゃないから。"},
        { "location": "429/TALK"  , "narrator": "エヴェレット", "text": "それとも、\nもし現実の私が\n嫌いだってことなら――"},
        { "location": "430/TALK"  , "narrator": "エヴェレット", "text": "……って、それなら\n「私が」嫌いだなんて\n言わないか……。"},
        { "location": "431/ACT"   , "narrator": "", "text": "実はあまり意味も無く何となく"},
        { "location": "432/TALK"  , "narrator": "エヴェレット", "text": "はぁぁ……。"},
        { "location": "433/TALK"  , "narrator": "エヴェレット", "text": "私にとっては\n生か死かレベルの\n重大な事なのよ…？"},
        { "location": "434/TALK"  , "narrator": "エヴェレット", "text": "そういう時くらいは\nお願いだから\n真面目にやって！"},
        { "location": "435/TALK"  , "narrator": "エヴェレット", "text": "それとも、そんなことも\nわからなかったわけ！？"},
        { "location": "436/SEL"   , "narrator": "", "text": "すみません……"},
        { "location": "437/SEL"   , "narrator": "", "text": "わかってたけど、わりとアーヤどうでもいいんで"},
        { "location": "438/ACT"   , "narrator": "", "text": "すみません……"},
        { "location": "439/TALK"  , "narrator": "エヴェレット", "text": "まあ、いいわよ今回は。\n貴方にとっても、\n初めてのことだったし。"},
        { "location": "440/TALK"  , "narrator": "エヴェレット", "text": "私の方も、\n強く言っちゃって\nごめんなさい。"},
        { "location": "441/TALK"  , "narrator": "エヴェレット", "text": "でも、それくらい\n私は貴方のこと――"},
        { "location": "442/TALK"  , "narrator": "エヴェレット", "text": "…ううん。\nなんでもない。"},
        { "location": "443/ACT"   , "narrator": "", "text": "わかってたけど、わりとアーヤどうでもいいんで"},
        { "location": "444/TALK"  , "narrator": "エヴェレット", "text": "それじゃ、\nなんでここにいるの！？"},
        { "location": "446/SEL"   , "narrator": "", "text": "どんな死に様か見てみたいから"},
        { "location": "447/SEL"   , "narrator": "", "text": "コンプリートしたいから"},
        { "location": "449/ACT"   , "narrator": "", "text": "どんな死に様か見てみたいから"},
        { "location": "467/TALK"  , "narrator": "エヴェレット", "text": "そう、わかった。"},
        { "location": "468/TALK"  , "narrator": "エヴェレット", "text": "その言葉、\n絶対忘れないから。"},
        { "location": "469/ACT"   , "narrator": "", "text": "コンプリートしたいから"},
        { "location": "487/TALK"  , "narrator": "エヴェレット", "text": "なるほど、わかった。"},
        { "location": "488/TALK"  , "narrator": "エヴェレット", "text": "貴方にとってみたら、\n所詮はゲームだものね。"},
        { "location": "490/TALK"  , "narrator": "エヴェレット", "text": "もう二度と\nここには来ないで。"},
        { "location": "491/TALK"  , "narrator": "エヴェレット", "text": "貴方に國政綾水を\n支えて欲しくない。"},
        { "location": "501/TALK"  , "narrator": "エヴェレット", "text": "とにかく。"},
        { "location": "502/TALK"  , "narrator": "エヴェレット", "text": "貴方がどう思おうが、\n私は今の私を大事にする。"},
        { "location": "504/SEL"   , "narrator": "", "text": "ところで、アーヤは結婚についてどう思ってる？"},
        { "location": "505/ACT"   , "narrator": "", "text": "ところで、アーヤは結婚についてどう思ってる？"},
        { "location": "507/TALK"  , "narrator": "エヴェレット", "text": "は？"},
        { "location": "508/TALK"  , "narrator": "エヴェレット", "text": "どうして急に\nそんな話題振るの？"},
        { "location": "509/SEL"   , "narrator": "", "text": "$me$は結婚するためにここにいるらしいから"},
        { "location": "510/ACT"   , "narrator": "", "text": "$me$は結婚するためにここにいるらしいから"},
        { "location": "512/TALK"  , "narrator": "エヴェレット", "text": "誰と？"},
        { "location": "513/SEL"   , "narrator": "", "text": "もちろんアーヤ"},
        { "location": "514/SEL"   , "narrator": "", "text": "教えない"},
        { "location": "515/ACT"   , "narrator": "", "text": "もちろんアーヤ"},
        { "location": "516/TALK"  , "narrator": "エヴェレット", "text": "え？"},
        { "location": "518/TALK"  , "narrator": "エヴェレット", "text": "私はお断りします。"},
        { "location": "519/TALK"  , "narrator": "エヴェレット", "text": "とは言っても、\n現実のアーヤがかなり\n貴方にゾッコンだし――"},
        { "location": "520/TALK"  , "narrator": "エヴェレット", "text": "私一人反対したところで\nどうにもならないけど。"},
        { "location": "522/TALK"  , "narrator": "エヴェレット", "text": "まさか。\nないない。"},
        { "location": "523/TALK"  , "narrator": "エヴェレット", "text": "とは言っても、\n現実のアーヤがかなり\n貴方にゾッコンだし――"},
        { "location": "524/TALK"  , "narrator": "エヴェレット", "text": "私一人反対したところで\nどうにもならないけど。"},
        { "location": "526/TALK"  , "narrator": "エヴェレット", "text": "そ、そんな、\n急に言われても\n心の準備が……"},
        { "location": "527/TALK"  , "narrator": "エヴェレット", "text": "あ、でも、ダメって\n意味じゃないの。"},
        { "location": "528/TALK"  , "narrator": "エヴェレット", "text": "ただ、ちょっとだけ\n心の準備が……"},
        { "location": "529/TALK"  , "narrator": "エヴェレット", "text": "ほら、\n私まだ２１だもの。"},
        { "location": "530/TALK"  , "narrator": "エヴェレット", "text": "もちろん法的には\n結婚出来る年齢だけど、\nやっぱほら――"},
        { "location": "531/TALK"  , "narrator": "エヴェレット", "text": "急に言われちゃうと、\nドキドキするっていうか、\nその……"},
        { "location": "532/SEL"   , "narrator": "", "text": "照れてるエヴェレットかわいい"},
        { "location": "533/ACT"   , "narrator": "", "text": "照れてるエヴェレットかわいい"},
        { "location": "536/TALK"  , "narrator": "エヴェレット", "text": "もう！\nそういうのじゃないから！"},
        { "location": "538/TALK"  , "narrator": "エヴェレット", "text": "でも、確かに貴方が一緒に\nいてくれたら、何が\n起きても寂しくないかな。"},
        { "location": "540/ACT"   , "narrator": "", "text": "教えない"},
        { "location": "541/TALK"  , "narrator": "エヴェレット", "text": "あらあら、\n秘密主義なの？"},
        { "location": "542/TALK"  , "narrator": "エヴェレット", "text": "まあ、いいけど。"},
        { "location": "544/TALK"  , "narrator": "エヴェレット", "text": "でも、結婚するために\nここにいるって、\n不思議な話ね。"},
        { "location": "545/SEL"   , "narrator": "", "text": "アーヤはアーヤの世界にいる現実の誰かと結ばれたい？"},
        { "location": "546/SEL"   , "narrator": "", "text": "そういう運命の元にいる二人だったのさ"},
        { "location": "547/ACT"   , "narrator": "", "text": "アーヤはアーヤの世界にいる現実の誰かと結ばれたい？"},
        { "location": "548/TALK"  , "narrator": "エヴェレット", "text": "んー、どうかしらね。"},
        { "location": "549/TALK"  , "narrator": "エヴェレット", "text": "現実の私はそういう\n気持ちもあるかも\nしれないけど――"},
        { "location": "550/TALK"  , "narrator": "エヴェレット", "text": "私は、それよりも\nココロが通じ合ってる\n人の方がいいかな。"},
        { "location": "551/TALK"  , "narrator": "エヴェレット", "text": "結婚には色んな理由が\nあって、色々好きな所が\nあるからするわけだけど。"},
        { "location": "552/TALK"  , "narrator": "エヴェレット", "text": "でも、最終的には、\n居心地の良さとか、\n自然でいられるとか。"},
        { "location": "553/TALK"  , "narrator": "エヴェレット", "text": "そういったところが\n幸せに繋がると\n思うのよね。"},
        { "location": "555/TALK"  , "narrator": "エヴェレット", "text": "いつでも想い\n通じ合える人こそ\n共に歩みたい、かな？"},
        { "location": "556/ACT"   , "narrator": "", "text": "そういう運命の元にいる二人だったのさ"},
        { "location": "559/TALK"  , "narrator": "エヴェレット", "text": "ええと…"},
        { "location": "560/TALK"  , "narrator": "エヴェレット", "text": "何を言ってるのか\nよくわからないわね。"},
        { "location": "563/TALK"  , "narrator": "エヴェレット", "text": "ええと…"},
        { "location": "564/TALK"  , "narrator": "エヴェレット", "text": "何を言ってるのか\nよくわからないわね。"},
        { "location": "567/TALK"  , "narrator": "エヴェレット", "text": "あらあら、\n随分と強気な発言ね。"},
        { "location": "568/TALK"  , "narrator": "エヴェレット", "text": "……でも、そういうの、\nわりと好きよ？"},
        { "location": "569/TALK"  , "narrator": "エヴェレット", "text": "なんだか落ち着くし。\nそれに―――"},
        { "location": "570/TALK"  , "narrator": "エヴェレット", "text": "ずっと一緒にいてくれる\n人なんだって、\n安心できるから。"},
        { "location": "571/TALK"  , "narrator": "エヴェレット", "text": "…なんてね！"},
        { "location": "574/TALK"  , "narrator": "エヴェレット", "text": "――と、変な話に\nなっちゃったけど。"},
        { "location": "575/TALK"  , "narrator": "エヴェレット", "text": "それ以前にまだ\n何も解決してないし。"},
        { "location": "576/TALK"  , "narrator": "エヴェレット", "text": "貴方にはもうちょっと\n色々手伝って\nもらわなくちゃね。"},
        { "location": "577/TALK"  , "narrator": "エヴェレット", "text": "まずは、セルフクランの\n水鏡の神子がどうなって\nしまったのか調べないと。"},
        { "location": "578/TALK"  , "narrator": "エヴェレット", "text": "白烏が何かいろいろ\nやってたんでしょうけど。"},
        { "location": "579/TALK"  , "narrator": "エヴェレット", "text": "本人は一体どこへ\n行っちゃったのかしらね。"},
        { "location": "580/SEL"   , "narrator": "", "text": "探しに行こうよ"},
        { "location": "581/SEL"   , "narrator": "", "text": "そのうちひょっこり出てくるのでは？"},
        { "location": "582/ACT"   , "narrator": "", "text": "探しに行こうよ"},
        { "location": "583/TALK"  , "narrator": "エヴェレット", "text": "え？\nうーん、でも……"},
        { "location": "584/SEL"   , "narrator": "", "text": "白烏は前にエヴェレット探しに行こうって言ってくれてたよ"},
        { "location": "585/ACT"   , "narrator": "", "text": "白烏は前にエヴェレット探しに行こうって言ってくれてたよ"},
        { "location": "587/TALK"  , "narrator": "エヴェレット", "text": "そうだったの！？\n知らなかった…。"},
        { "location": "588/TALK"  , "narrator": "エヴェレット", "text": "……そうね。\n探しに行ってみましょ。"},
        { "location": "589/TALK"  , "narrator": "エヴェレット", "text": "恐らくは無事だと思うけど\n万一のこともあるし……"},
        { "location": "590/ACT"   , "narrator": "", "text": "そのうちひょっこり出てくるのでは？"},
        { "location": "591/TALK"  , "narrator": "エヴェレット", "text": "そうね。"},
        { "location": "592/TALK"  , "narrator": "エヴェレット", "text": "……んー、\nそうかもしれないけど……"},
        { "location": "593/TALK"  , "narrator": "エヴェレット", "text": "でも、もう出てくるのを\n待ってるような時間は\n無いのよね……"},
        { "location": "594/TALK"  , "narrator": "エヴェレット", "text": "やっぱり探しに\n行くべきなのかしら。"},
        { "location": "595/SEL"   , "narrator": "", "text": "行くべき"},
        { "location": "596/SEL"   , "narrator": "", "text": "エヴェレットはどうしたい？"},
        { "location": "597/ACT"   , "narrator": "", "text": "行くべき"},
        { "location": "598/TALK"  , "narrator": "エヴェレット", "text": "やっぱりそうよね。"},
        { "location": "599/TALK"  , "narrator": "エヴェレット", "text": "恐らくは無事だと思うけど\n万一のこともあるし……"},
        { "location": "600/ACT"   , "narrator": "", "text": "エヴェレットはどうしたい？"},
        { "location": "601/TALK"  , "narrator": "エヴェレット", "text": "私は…\nやっぱり\n後悔したくないかな。"},
        { "location": "602/TALK"  , "narrator": "エヴェレット", "text": "もうのんびりしてる\n時間も無いし……。"},
        { "location": "603/TALK"  , "narrator": "エヴェレット", "text": "……やっぱり\n探しに行きましょ。"},
        { "location": "604/TALK"  , "narrator": "エヴェレット", "text": "恐らくは無事だと思うけど\n万一のこともあるしね。"},
        { "location": "607/TALK"  , "narrator": "エヴェレット", "text": "それじゃ、\n貴方が次に来たときに、\n決行しましょ。"},
        { "location": "608/TALK"  , "narrator": "エヴェレット", "text": "それまでに、\n手がかりがないか\n探してみるわね。"},
        { "location": "610/TALK"  , "narrator": "エヴェレット", "text": "それじゃ――"},
        { "location": "611/TALK"  , "narrator": "エヴェレット", "text": "…っと。"},
        { "location": "612/SEL"   , "narrator": "", "text": "？？"},
        { "location": "613/ACT"   , "narrator": "", "text": "？？"},
        { "location": "616/TALK"  , "narrator": "エヴェレット", "text": "そういえば、\nあれ、どうしよっか。"},
        { "location": "617/SEL"   , "narrator": "", "text": "あれって？"},
        { "location": "618/ACT"   , "narrator": "", "text": "あれって？"},
        { "location": "621/TALK"  , "narrator": "エヴェレット", "text": "ええっ！？\nさっき言ってた\nアレだってば。"},
        { "location": "622/SEL"   , "narrator": "", "text": "ああ、アレね"},
        { "location": "623/SEL"   , "narrator": "", "text": "アレじゃわからない"},
        { "location": "624/ACT"   , "narrator": "", "text": "ああ、アレね"},
        { "location": "625/TALK"  , "narrator": "エヴェレット", "text": "そう、アレよ……？"},
        { "location": "626/ACT"   , "narrator": "", "text": "アレじゃわからない"},
        { "location": "627/TALK"  , "narrator": "エヴェレット", "text": "だ、だから……"},
        { "location": "628/TALK"  , "narrator": "エヴェレット", "text": "キ……キスするか\nどうするかの話！！"},
        { "location": "629/TALK"  , "narrator": "エヴェレット", "text": "そういうの言わせるのって\nデリカシー無いわよ？"},
        { "location": "630/SEL"   , "narrator": "", "text": "可愛いから意地悪したくなった"},
        { "location": "631/ACT"   , "narrator": "", "text": "可愛いから意地悪したくなった"},
        { "location": "633/TALK"  , "narrator": "エヴェレット", "text": "もう、バカ。"},
        { "location": "635/SEL"   , "narrator": "", "text": "しましょう！"},
        { "location": "636/SEL"   , "narrator": "", "text": "アーヤはどうしたいの？"},
        { "location": "637/ACT"   , "narrator": "", "text": "しましょう！"},
        { "location": "638/TALK"  , "narrator": "エヴェレット", "text": "わ、わかったわ。"},
        { "location": "639/ACT"   , "narrator": "", "text": "アーヤはどうしたいの？"},
        { "location": "640/TALK"  , "narrator": "エヴェレット", "text": "え？　私！？"},
        { "location": "641/TALK"  , "narrator": "エヴェレット", "text": "えっと、それは……"},
        { "location": "642/TALK"  , "narrator": "エヴェレット", "text": "……。"},
        { "location": "643/TALK"  , "narrator": "エヴェレット", "text": "したく、ないことは\n全然無くて。"},
        { "location": "644/TALK"  , "narrator": "エヴェレット", "text": "…したいんだけどね？"},
        { "location": "673/TALK"  , "narrator": "エヴェレット", "text": "ふわっ……"},
        { "location": "674/TALK"  , "narrator": "エヴェレット", "text": "なんかすごく\n気持ちいいかも…"},
        { "location": "679/TALK"  , "narrator": "エヴェレット", "text": "ひぁっ…"},
        { "location": "681/TALK"  , "narrator": "エヴェレット", "text": "ど、どうしよう、\n止まらない…っ。"},
        { "location": "683/TALK"  , "narrator": "エヴェレット", "text": "なにこれ…\n変な気分……"},
        { "location": "692/TALK"  , "narrator": "エヴェレット", "text": "はぁ、…はぁっ…。"},
        { "location": "693/TALK"  , "narrator": "エヴェレット", "text": "…もうお終い？\nもう１回だけ……"},
        { "location": "694/SEL"   , "narrator": "", "text": "うん"},
        { "location": "695/SEL"   , "narrator": "", "text": "そろそろお終いにしよ？"},
        { "location": "696/ACT"   , "narrator": "", "text": "うん"},
        { "location": "703/ACT"   , "narrator": "", "text": "そろそろお終いにしよ？"},
        { "location": "705/TALK"  , "narrator": "エヴェレット", "text": "そ、そうよね。"},
        { "location": "706/TALK"  , "narrator": "エヴェレット", "text": "なんだかいっぱい\nお願いしちゃって\nごめんなさい。"},
        { "location": "707/SEL"   , "narrator": "", "text": "すごかった"},
        { "location": "708/SEL"   , "narrator": "", "text": "可愛かった"},
        { "location": "709/SEL"   , "narrator": "", "text": "引いた"},
        { "location": "710/ACT"   , "narrator": "", "text": "すごかった"},
        { "location": "711/TALK"  , "narrator": "エヴェレット", "text": "えええええっ……"},
        { "location": "712/TALK"  , "narrator": "エヴェレット", "text": "なにそれ、やだ…。"},
        { "location": "713/ACT"   , "narrator": "", "text": "可愛かった"},
        { "location": "714/TALK"  , "narrator": "エヴェレット", "text": "か、可愛いとか、\nあまり言われたこと\n無いんだけど！"},
        { "location": "715/ACT"   , "narrator": "", "text": "引いた"},
        { "location": "716/TALK"  , "narrator": "エヴェレット", "text": "ああっ！！\nご、ごめんなさい。"},
        { "location": "718/TALK"  , "narrator": "エヴェレット", "text": "でも、すごく素敵だった。"},
        { "location": "719/TALK"  , "narrator": "エヴェレット", "text": "今度は現実の私と、\nこんな風にできるように\nなると嬉しいかな…。"},
        { "location": "721/TALK"  , "narrator": "エヴェレット", "text": "私のわがままに\nつき合ってくれて、\nありがと。"},
