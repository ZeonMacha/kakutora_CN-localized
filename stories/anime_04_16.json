{
    "dir": "chap16/daydra/anime_04_16.js",
    "type": "MainStory",
    "info": {
        "story_id": "16401",
        "cid": "miyabi",
        "title": "001 アニメーション",
        "sub_title": "ピクシャル"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "アニメ第11話"},
        { "location": "48/TALK"   , "narrator": "千羽鶴", "text": "ごきげんよう、\n$handle$。"},
        { "location": "50/TALK"   , "narrator": "千羽鶴", "text": "いつも通り、今回も\n逢瀬つばめの解説を\nするだけでいい？"},
        { "location": "52/TALK"   , "narrator": "千羽鶴", "text": "いつも通り、今回も\n國政綾水の解説を\nするだけでいい？"},
        { "location": "54/TALK"   , "narrator": "千羽鶴", "text": "いつも通り、今回も\nガブリエラの解説を\nするだけでいい？"},
        { "location": "56/TALK"   , "narrator": "千羽鶴", "text": "いつも通り、今回も\n恋ヶ崎みやびの解説を\nするだけでいい？"},
        { "location": "58/SEL"    , "narrator": "", "text": "はい"},
        { "location": "59/SEL"    , "narrator": "", "text": "いいえ"},
        { "location": "60/ACT"    , "narrator": "", "text": "はい"},
        { "location": "62/TALK"   , "narrator": "千羽鶴", "text": "よかった。\n私も助かる。\nこれぞWIN-WINね。"},
        { "location": "64/ACT"    , "narrator": "", "text": "いいえ"},
        { "location": "65/TALK"   , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "121/TALK"  , "narrator": "千羽鶴", "text": "好きです！\nつき合ってください！"},
        { "location": "148/SEL"   , "narrator": "", "text": "いきなり予告編でビビった"},
        { "location": "149/SEL"   , "narrator": "", "text": "楽しみです！"},
        { "location": "150/SEL"   , "narrator": "", "text": "もしかして今の予告動画って千羽鶴が自演で再現してなかった！？"},
        { "location": "151/ACT"   , "narrator": "", "text": "いきなり予告編でビビった"},
        { "location": "152/TALK"  , "narrator": "千羽鶴", "text": "せっかくだから、\n一番インパクトのある\n所で公表してみた。"},
        { "location": "153/TALK"  , "narrator": "千羽鶴", "text": "でも、製品版は\n純然たるクソゲーだから\n覚悟しておいて。"},
        { "location": "154/ACT"   , "narrator": "", "text": "楽しみです！"},
        { "location": "155/TALK"  , "narrator": "千羽鶴", "text": "ありがと。"},
        { "location": "156/TALK"  , "narrator": "千羽鶴", "text": "楽しみにしていられるのも\n今のうちだから、存分に\n楽しみにするといい。"},
        { "location": "157/ACT"   , "narrator": "", "text": "もしかして今の予告動画って千羽鶴が自演で再現してなかった！？"},
        { "location": "158/TALK"  , "narrator": "千羽鶴", "text": "してない、してない。"},
        { "location": "159/SEL"   , "narrator": "", "text": "でも今開けた時「好きです！」のシーンと同じポーズを…"},
        { "location": "160/ACT"   , "narrator": "", "text": "でも今開けた時「好きです！」のシーンと同じポーズを…"},
        { "location": "162/TALK"  , "narrator": "千羽鶴", "text": "たまたま、たまたま！\nちゃんと動画だから。"},
        { "location": "163/SEL"   , "narrator": "", "text": "自演かわいい"},
        { "location": "164/SEL"   , "narrator": "", "text": "予算ないの？"},
        { "location": "165/ACT"   , "narrator": "", "text": "自演かわいい"},
        { "location": "167/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "168/TALK"  , "narrator": "千羽鶴", "text": "いい切り返しが\n思いつかない……。"},
        { "location": "169/TALK"  , "narrator": "千羽鶴", "text": "……ど"},
        { "location": "172/TALK"  , "narrator": "千羽鶴", "text": "<size=40>どーん！</size>"},
        { "location": "174/ACT"   , "narrator": "", "text": "予算ないの？"},
        { "location": "177/TALK"  , "narrator": "千羽鶴", "text": "<size=45>ない！</size>"},
        { "location": "180/TALK"  , "narrator": "千羽鶴", "text": "それはそうと、改めて。\n沢山の意見や感想、\nありがとう。"},
        { "location": "181/TALK"  , "narrator": "千羽鶴", "text": "もっと閑古鳥が啼く感じ\nかと思ったけど、逆に\n凄くてビックリした。"},
        { "location": "182/TALK"  , "narrator": "千羽鶴", "text": "お陰でこれからも\n貴方とトライナリーたちの\n為に頑張れる。"},
        { "location": "183/TALK"  , "narrator": "千羽鶴", "text": "戴いた意見は、後で\nご飯食べながらじっくり\n読ませてもらうから。"},
        { "location": "184/TALK"  , "narrator": "千羽鶴", "text": "というわけで、\n早速本題に\n行きたいんだけど――"},
        { "location": "185/TALK"  , "narrator": "千羽鶴", "text": "貴方の相手をした後、\n早速制作にとりかかるから\nすぐに記録映像でもいい？"},
        { "location": "186/SEL"   , "narrator": "", "text": "どうぞ！"},
        { "location": "187/SEL"   , "narrator": "", "text": "集めた意見はどうするの？"},
        { "location": "188/ACT"   , "narrator": "", "text": "どうぞ！"},
        { "location": "189/TALK"  , "narrator": "千羽鶴", "text": "ありがと。"},
        { "location": "190/ACT"   , "narrator": "", "text": "集めた意見はどうするの？"},
        { "location": "191/TALK"  , "narrator": "千羽鶴", "text": "もちろん、今後の貴方と\nトライナリーたちとの\n交流円滑化に役立てる。"},
        { "location": "192/TALK"  , "narrator": "千羽鶴", "text": "TRI-OSのアップデートも\n必要になるから、数日で\nとはいかないけど。"},
        { "location": "193/TALK"  , "narrator": "千羽鶴", "text": "でもやっぱり今の状況では\n十分に彼女とイチャラブ\n出来てなさそうだし――"},
        { "location": "194/TALK"  , "narrator": "千羽鶴", "text": "彼女の日常の見せ方も\n少し考えた方がいいかも\nと思ってはいる。"},
        { "location": "195/TALK"  , "narrator": "千羽鶴", "text": "答えは必ず結果で返すから\n少しの間待って欲しい。"},
        { "location": "199/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/116MB 7:17】</color>"},
        { "location": "200/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/37MB 7:17】</color>"},
        { "location": "201/SEL"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "202/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/116MB 7:17】</color>"},
        { "location": "203/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "209/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/37MB 7:17】</color>"},
        { "location": "210/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "216/ACT"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "217/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "250/TALK"  , "narrator": "千羽鶴", "text": "――というわけで。"},
        { "location": "251/TALK"  , "narrator": "千羽鶴", "text": "久々の大型戦闘回だった\n今回だけど、何か質問は？"},
        { "location": "253/SEL"   , "narrator": "", "text": "今回の映像記録って…"},
        { "location": "254/SEL"   , "narrator": "", "text": "神楽＝メノウキター！"},
        { "location": "255/SEL"   , "narrator": "", "text": "神楽ちゃんが大変！！"},
        { "location": "256/SEL"   , "narrator": "", "text": "フェノメノンの中にスパコンを接続できるの！？"},
        { "location": "257/SEL"   , "narrator": "", "text": "特にない \n<color=blue>（※先へ進みます）</color>"},
        { "location": "258/ACT"   , "narrator": "", "text": "今回の映像記録って…"},
        { "location": "259/TALK"  , "narrator": "千羽鶴", "text": "…？\nなに？"},
        { "location": "260/SEL"   , "narrator": "", "text": "発症者の素性とか…"},
        { "location": "261/SEL"   , "narrator": "", "text": "着替えさせるシーンに心抉られる"},
        { "location": "262/ACT"   , "narrator": "", "text": "発症者の素性とか…"},
        { "location": "263/TALK"  , "narrator": "千羽鶴", "text": "今やプレイ方式として\nアイテム課金型は社会に\n浸透した。"},
        { "location": "264/TALK"  , "narrator": "千羽鶴", "text": "特に私たちの世界の日本\nでは、かなりの人口が\n毎日楽しんでる。"},
        { "location": "265/TALK"  , "narrator": "千羽鶴", "text": "ただ、他の娯楽や投資と\n同様、限界を超えてしまう\n人は少なからずいる。"},
        { "location": "266/TALK"  , "narrator": "千羽鶴", "text": "そんな状況であれば、\nクランを発症する人が\nいてもおかしくはない。"},
        { "location": "267/TALK"  , "narrator": "千羽鶴", "text": "いじめや男女関係などの\n人間関係の問題と並んで、\nお金の問題は深い。"},
        { "location": "268/TALK"  , "narrator": "千羽鶴", "text": "そういった現代によくある\n心の葛藤がクランとなる\n以上、出やすいのは確か。"},
        { "location": "269/TALK"  , "narrator": "千羽鶴", "text": "必然的に、記録映像にも\n現れやすくなる。\nただそれだけのこと。"},
        { "location": "270/ACT"   , "narrator": "", "text": "着替えさせるシーンに心抉られる"},
        { "location": "271/TALK"  , "narrator": "千羽鶴", "text": "え？\nなぜ？"},
        { "location": "272/SEL"   , "narrator": "", "text": "TRI-OSでもできますよね？"},
        { "location": "273/ACT"   , "narrator": "", "text": "TRI-OSでもできますよね？"},
        { "location": "275/TALK"  , "narrator": "千羽鶴", "text": "え？\nできないできない。"},
        { "location": "276/SEL"   , "narrator": "", "text": "着替えボタンあるでしょ"},
        { "location": "277/ACT"   , "narrator": "", "text": "着替えボタンあるでしょ"},
        { "location": "279/TALK"  , "narrator": "千羽鶴", "text": "着替えランチャーボタンは\n強制的な着せ替えをする\nボタンじゃない。"},
        { "location": "280/TALK"  , "narrator": "千羽鶴", "text": "単に彼女と、着る服の\n相談をするだけのボタン。"},
        { "location": "281/TALK"  , "narrator": "千羽鶴", "text": "話し合いの結果によっては\n彼女は貴方が希望する服に\n着替えないかもしれない。"},
        { "location": "282/TALK"  , "narrator": "千羽鶴", "text": "そう。別に貴方が着せて\nいるわけじゃない。\n彼女が好きで着ている。"},
        { "location": "283/TALK"  , "narrator": "千羽鶴", "text": "すなわちそれは、\n合意の上、彼女の意志に\nよって着ているだけ。"},
        { "location": "284/TALK"  , "narrator": "千羽鶴", "text": "記録映像でクラン\nモーフィアスがやっていた\n行為とは全然違う。"},
        { "location": "285/TALK"  , "narrator": "千羽鶴", "text": "だから貴方に万一、\nやましさのようなものが\nあるとするならば――"},
        { "location": "288/TALK"  , "narrator": "千羽鶴", "text": "<size=35>それは単に\n貴方の心の問題！</size>"},
        { "location": "289/TALK"  , "narrator": "千羽鶴", "text": "だから安心して。\n他は？"},
        { "location": "292/ACT"   , "narrator": "", "text": "神楽＝メノウキター！"},
        { "location": "295/TALK"  , "narrator": "千羽鶴", "text": "そうらしい。"},
        { "location": "296/SEL"   , "narrator": "", "text": "ビックリした！"},
        { "location": "297/SEL"   , "narrator": "", "text": "何となく予想はしてた"},
        { "location": "298/SEL"   , "narrator": "", "text": "知ってた"},
        { "location": "299/ACT"   , "narrator": "", "text": "ビックリした！"},
        { "location": "300/TALK"  , "narrator": "千羽鶴", "text": "そうね。\n私もビックリした。"},
        { "location": "301/SEL"   , "narrator": "", "text": "千羽鶴も知らなかったの？"},
        { "location": "302/SEL"   , "narrator": "", "text": "前にメノウのライブにいたよね？あれって…"},
        { "location": "303/ACT"   , "narrator": "", "text": "千羽鶴も知らなかったの？"},
        { "location": "304/TALK"  , "narrator": "千羽鶴", "text": "んー、微妙なところ。"},
        { "location": "305/TALK"  , "narrator": "千羽鶴", "text": "以前、私のはとこの\n母の兄の長女の友達に\n教えてもらった事がある。"},
        { "location": "306/TALK"  , "narrator": "千羽鶴", "text": "まあ、他人からの\n情報なんて、目視せず\n確定なんてできないし。"},
        { "location": "307/ACT"   , "narrator": "", "text": "前にメノウのライブにいたよね？あれって…"},
        { "location": "308/TALK"  , "narrator": "千羽鶴", "text": "だからアレは\n私のはとこの母の\n兄の長女の友達。"},
        { "location": "310/ACT"   , "narrator": "", "text": "何となく予想はしてた"},
        { "location": "311/TALK"  , "narrator": "千羽鶴", "text": "なるほど。\nどういう所で？"},
        { "location": "312/SEL"   , "narrator": "", "text": "目の色？"},
        { "location": "313/SEL"   , "narrator": "", "text": "神楽のキレ具合とかから"},
        { "location": "314/ACT"   , "narrator": "", "text": "目の色？"},
        { "location": "315/TALK"  , "narrator": "千羽鶴", "text": "目の色なんて\nカラーコンタクトで\nいくらでも変えられる。"},
        { "location": "316/TALK"  , "narrator": "千羽鶴", "text": "そんなのは\n理由にならない。"},
        { "location": "317/TALK"  , "narrator": "千羽鶴", "text": "第一、\n胸の大きさが\n全然違う！"},
        { "location": "318/SEL"   , "narrator": "", "text": "胸の大きさなんていくらでも変えられる！そんなの理由にならない"},
        { "location": "319/ACT"   , "narrator": "", "text": "胸の大きさなんていくらでも変えられる！そんなの理由にならない"},
        { "location": "321/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "322/TALK"  , "narrator": "千羽鶴", "text": "ああいえばこういう。"},
        { "location": "323/TALK"  , "narrator": "千羽鶴", "text": "まあ何にしても。\n目の色や顔の形は\n理由にはならない。"},
        { "location": "324/TALK"  , "narrator": "千羽鶴", "text": "それは憶測の域を\n超えるものではない。"},
        { "location": "325/TALK"  , "narrator": "千羽鶴", "text": "世界を正しく見る為には\n物事を多角的に見て、そこ\nから推測する必要がある。"},
        { "location": "326/TALK"  , "narrator": "千羽鶴", "text": "是非今後の人生で\n実践してみて。"},
        { "location": "327/ACT"   , "narrator": "", "text": "神楽のキレ具合とかから"},
        { "location": "328/TALK"  , "narrator": "千羽鶴", "text": "なるほど。\n確かにそれは一理ある。"},
        { "location": "329/TALK"  , "narrator": "千羽鶴", "text": "卯月神楽はフレイメノウの\n事になると、過剰に反応\nしていたから。"},
        { "location": "330/TALK"  , "narrator": "千羽鶴", "text": "けど、その反応は\n基本的には怒りや拒絶と\nいった負の感情だった。"},
        { "location": "331/TALK"  , "narrator": "千羽鶴", "text": "それはなぜ？"},
        { "location": "332/TALK"  , "narrator": "千羽鶴", "text": "続きは\n<color=green>#トライナリー神楽のこと</color>\nで検索。"},
        { "location": "334/ACT"   , "narrator": "", "text": "知ってた"},
        { "location": "335/TALK"  , "narrator": "千羽鶴", "text": "…そう。"},
        { "location": "336/TALK"  , "narrator": "千羽鶴", "text": "貴方、もしかして\nみんなでTVを\n見ている時に――"},
        { "location": "337/TALK"  , "narrator": "千羽鶴", "text": "あーこれ知ってるわ。\n○○なんだよな～（ドヤッ"},
        { "location": "338/TALK"  , "narrator": "千羽鶴", "text": "って言った次の瞬間、\nTVが全然違うことを言って\n気まずくなったことない？"},
        { "location": "339/SEL"   , "narrator": "", "text": "あります"},
        { "location": "340/SEL"   , "narrator": "", "text": "ありません"},
        { "location": "341/ACT"   , "narrator": "", "text": "あります"},
        { "location": "344/TALK"  , "narrator": "千羽鶴", "text": "<size=35>ダメ！絶対！</size>"},
        { "location": "345/TALK"  , "narrator": "千羽鶴", "text": "どう対応していいか\nわからなくなる周りの人が\nかわいそうだから！"},
        { "location": "346/ACT"   , "narrator": "", "text": "ありません"},
        { "location": "347/TALK"  , "narrator": "千羽鶴", "text": "…そう。"},
        { "location": "352/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "354/ACT"   , "narrator": "", "text": "神楽ちゃんが大変！！"},
        { "location": "355/TALK"  , "narrator": "千羽鶴", "text": "どの辺が？"},
        { "location": "356/SEL"   , "narrator": "", "text": "精神的に辛そう"},
        { "location": "357/SEL"   , "narrator": "", "text": "ビリィィィィ！って"},
        { "location": "358/ACT"   , "narrator": "", "text": "精神的に辛そう"},
        { "location": "359/TALK"  , "narrator": "千羽鶴", "text": "そうかもしれない。\n確かに今、彼女は重大な\n転機のまっただ中にいる。"},
        { "location": "360/TALK"  , "narrator": "千羽鶴", "text": "でも、今この問題を\n解決出来るのは、\n彼女自身以外にはいない。"},
        { "location": "361/TALK"  , "narrator": "千羽鶴", "text": "歯がゆいかもしれないけど\nどうか卯月神楽を\n見守ってあげて欲しい。"},
        { "location": "362/ACT"   , "narrator": "", "text": "ビリィィィィ！って"},
        { "location": "363/TALK"  , "narrator": "千羽鶴", "text": "ああ。\nビリィィィィ！って。"},
        { "location": "364/TALK"  , "narrator": "千羽鶴", "text": "それが？"},
        { "location": "365/SEL"   , "narrator": "", "text": "いたいけな少女のお肌が顕わに…"},
        { "location": "366/SEL"   , "narrator": "", "text": "$me$もビリィィィィ！したいです"},
        { "location": "367/ACT"   , "narrator": "", "text": "いたいけな少女のお肌が顕わに…"},
        { "location": "368/TALK"  , "narrator": "千羽鶴", "text": "そうね。"},
        { "location": "369/TALK"  , "narrator": "千羽鶴", "text": "でもきっと大丈夫。\n彼女はこんな事で凹む\nタマじゃないから。"},
        { "location": "370/TALK"  , "narrator": "千羽鶴", "text": "でも確かに、これが\nガブリエラあたりだったら\n大変なことになってた。"},
        { "location": "371/SEL"   , "narrator": "", "text": "もしかして、湖の映像に差し替えられちゃう！？"},
        { "location": "372/SEL"   , "narrator": "", "text": "確かにガブちゃんそういうの耐性無さそう"},
        { "location": "373/ACT"   , "narrator": "", "text": "もしかして、湖の映像に差し替えられちゃう！？"},
        { "location": "374/TALK"  , "narrator": "千羽鶴", "text": "違うから。"},
        { "location": "375/TALK"  , "narrator": "千羽鶴", "text": "まあ、それもあるかも\nしれないけど。"},
        { "location": "376/TALK"  , "narrator": "千羽鶴", "text": "もし今度記録映像が\n間に合わなかったら\nそうしよう…。"},
        { "location": "377/ACT"   , "narrator": "", "text": "確かにガブちゃんそういうの耐性無さそう"},
        { "location": "378/TALK"  , "narrator": "千羽鶴", "text": "ええ。無い。"},
        { "location": "379/TALK"  , "narrator": "千羽鶴", "text": "だから、\n貴方がしっかり\n守ってあげて。"},
        { "location": "381/ACT"   , "narrator": "", "text": "$me$もビリィィィィ！したいです"},
        { "location": "382/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "383/TALK"  , "narrator": "千羽鶴", "text": "それじゃ、試しに\n私でやってみる？"},
        { "location": "384/TALK"  , "narrator": "千羽鶴", "text": "マネキンのように\n微動だにしないと\n思うけど。"},
        { "location": "385/SEL"   , "narrator": "", "text": "最高ですね！"},
        { "location": "386/SEL"   , "narrator": "", "text": "それじゃつまらない"},
        { "location": "387/SEL"   , "narrator": "", "text": "千羽鶴には純愛貫くからやらない"},
        { "location": "388/SEL"   , "narrator": "", "text": "興味無い"},
        { "location": "389/ACT"   , "narrator": "", "text": "最高ですね！"},
        { "location": "390/TALK"  , "narrator": "千羽鶴", "text": "診断結果が出た。"},
        { "location": "393/TALK"  , "narrator": "千羽鶴", "text": "<color=red><size=50>貴方は変態！</size></color>"},
        { "location": "394/TALK"  , "narrator": "千羽鶴", "text": "基本的に興奮というものは\n相手の反応に対する\n期待から来る所が大きい。"},
        { "location": "395/TALK"  , "narrator": "千羽鶴", "text": "それが無くても\n最高だという貴方は、\nなかなかの性癖の持ち主★"},
        { "location": "396/TALK"  , "narrator": "千羽鶴", "text": "みんなに「$me$は\n変態だ！」と言って回れば\n人気者間違いなし♪"},
        { "location": "397/TALK"  , "narrator": "千羽鶴", "text": "是非学校や職場で試して\nみて。新しい人生が\n貴方を待ってるから。"},
        { "location": "398/TALK"  , "narrator": "千羽鶴", "text": "――というわけで\nちーの性癖診断おわり。"},
        { "location": "399/ACT"   , "narrator": "", "text": "それじゃつまらない"},
        { "location": "400/TALK"  , "narrator": "千羽鶴", "text": "診断結果が出た。"},
        { "location": "403/TALK"  , "narrator": "千羽鶴", "text": "<color=red><size=50>貴方はサド！</size></color>"},
        { "location": "404/TALK"  , "narrator": "千羽鶴", "text": "ビリィィィィ！って\nした後の反応が無いと\n不満という貴方はキチク★"},
        { "location": "405/TALK"  , "narrator": "千羽鶴", "text": "そんな貴方と好相性なのは\nドエムの女の子♪"},
        { "location": "406/TALK"  , "narrator": "千羽鶴", "text": "是非合コンでは、\nドエムッ子に\nアタックしてみて♪"},
        { "location": "407/TALK"  , "narrator": "千羽鶴", "text": "最高にハッピーな\n人生が待っているかも！"},
        { "location": "408/TALK"  , "narrator": "千羽鶴", "text": "――というわけで\nちーの恋愛診断おわり。"},
        { "location": "409/ACT"   , "narrator": "", "text": "千羽鶴には純愛貫くからやらない"},
        { "location": "411/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "413/TALK"  , "narrator": "千羽鶴", "text": "それ、\n全然面白くないから。"},
        { "location": "414/ACT"   , "narrator": "", "text": "興味無い"},
        { "location": "415/TALK"  , "narrator": "千羽鶴", "text": "…そう。"},
        { "location": "421/ACT"   , "narrator": "", "text": "フェノメノンの中にスパコンを接続できるの！？"},
        { "location": "424/TALK"  , "narrator": "千羽鶴", "text": "確かにそう見えるかも。"},
        { "location": "425/TALK"  , "narrator": "千羽鶴", "text": "でも実際には、\nフェノメノンの中に管を\n入れているわけではない。"},
        { "location": "426/TALK"  , "narrator": "千羽鶴", "text": "内側から情報を取得して\nいるのは、トライナリー\n達の装備するガジェット。"},
        { "location": "427/TALK"  , "narrator": "千羽鶴", "text": "すなわち、いつもの\n通信機器のAUXから\nデータを取得してるだけ。"},
        { "location": "429/TALK"  , "narrator": "千羽鶴", "text": "そのAUXは、\nアーケロンの中にある。"},
        { "location": "430/TALK"  , "narrator": "千羽鶴", "text": "そしてそこから取得した\nデータを高速に演算し、\nみやびに提供している。"},
        { "location": "431/SEL"   , "narrator": "", "text": "それだけのことに、あの数のスパコン！？"},
        { "location": "432/SEL"   , "narrator": "", "text": "トライガジェットって本当に千羽鶴の世界のモノなの？"},
        { "location": "433/ACT"   , "narrator": "", "text": "それだけのことに、あの数のスパコン！？"},
        { "location": "434/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "436/TALK"  , "narrator": "千羽鶴", "text": "それだけフェノメノンと\nいうものは、我々の\n常識を越えたものなの。"},
        { "location": "437/TALK"  , "narrator": "千羽鶴", "text": "あのスパコンで処理して\nはじき出せるデータだって\n大したものじゃない。"},
        { "location": "438/TALK"  , "narrator": "千羽鶴", "text": "せいぜい８ビット\nパソコンが出せる限界の\n情報量程度でしかない。"},
        { "location": "439/TALK"  , "narrator": "千羽鶴", "text": "ただ、フェノメノン相手\nともなれば、このくらいが\nノイマン型の限界かも。"},
        { "location": "442/ACT"   , "narrator": "", "text": "トライガジェットって本当に千羽鶴の世界のモノなの？"},
        { "location": "443/TALK"  , "narrator": "千羽鶴", "text": "もちろん。"},
        { "location": "444/SEL"   , "narrator": "", "text": "現代の技術力で作れるものと思えない"},
        { "location": "445/ACT"   , "narrator": "", "text": "現代の技術力で作れるものと思えない"},
        { "location": "447/TALK"  , "narrator": "千羽鶴", "text": "その気持ちはよくわかる。"},
        { "location": "448/TALK"  , "narrator": "千羽鶴", "text": "でも、貴方の世界でも\n恐らくは信じられない\nものが既に存在している。"},
        { "location": "449/TALK"  , "narrator": "千羽鶴", "text": "メディアが発達した現在、\nその害悪とも言える\n勘違いが多発する。"},
        { "location": "450/TALK"  , "narrator": "千羽鶴", "text": "それは、世に出回っている\n情報こそが、世界のすべて\nであると思い込む勘違い。"},
        { "location": "451/TALK"  , "narrator": "千羽鶴", "text": "実際はそんなことはない。"},
        { "location": "452/TALK"  , "narrator": "千羽鶴", "text": "貴方が未だ不可能と\n思い込んでいる数々の\n技術は既に完成している。"},
        { "location": "453/TALK"  , "narrator": "千羽鶴", "text": "そしてそれは主に、\n世界のごく１％以下の\n人間によって隠匿される。"},
        { "location": "454/TALK"  , "narrator": "千羽鶴", "text": "だから、貴方のとなりに\nいる人の腕時計は、タイム\nリーパーかもしれない。"},
        { "location": "455/TALK"  , "narrator": "千羽鶴", "text": "それが、\n世界が持つ本来の可能性。"},
        { "location": "458/TALK"  , "narrator": "千羽鶴", "text": "だから、街ゆく少女たちの\n太腿についているリング状\nアクセサリについても――"},
        { "location": "459/TALK"  , "narrator": "千羽鶴", "text": "それは、貴方の目を\n楽しませる以外にも\n何かあるかもしれない。"},
        { "location": "463/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "465/ACT"   , "narrator": "", "text": "特にない \n<color=blue>（※先へ進みます）</color>"},
        { "location": "467/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "474/TALK"  , "narrator": "千羽鶴", "text": "さて、今回の\n逢瀬つばめだけど――"},
        { "location": "475/TALK"  , "narrator": "千羽鶴", "text": "実は今回、バトルが\n開始される前に重要な\n出来事が起こっている。"},
        { "location": "476/TALK"  , "narrator": "千羽鶴", "text": "それは恋ヶ崎みやびに\nよって、逢瀬つばめにだけ\nもたらされた、ある情報。"},
        { "location": "477/TALK"  , "narrator": "千羽鶴", "text": "けど、その情報は、\n逢瀬つばめ１人で判断\nするには少々重い内容。"},
        { "location": "478/TALK"  , "narrator": "千羽鶴", "text": "その為、貴方には\nその情報の扱いについて\nサポートをして欲しい。"},
        { "location": "479/TALK"  , "narrator": "千羽鶴", "text": "それ如何によって、\nこのバトルの勝敗が\n決まってくる。"},
        { "location": "480/TALK"  , "narrator": "千羽鶴", "text": "同時に彼女への\n心のサポートも\nお願いしたい。"},
        { "location": "481/TALK"  , "narrator": "千羽鶴", "text": "それじゃ、\n健闘を祈ってる。"},
        { "location": "485/TALK"  , "narrator": "千羽鶴", "text": "さて、今回の\n國政綾水だけど――"},
        { "location": "486/TALK"  , "narrator": "千羽鶴", "text": "バトル自体も深刻な状況\nではあるけど、一旦\nそこから離れてみる。"},
        { "location": "487/TALK"  , "narrator": "千羽鶴", "text": "それ以上に重要な\n出来事が、彼女の身には\n起こっていたから。"},
        { "location": "488/TALK"  , "narrator": "千羽鶴", "text": "その出来事は、偶然では\nあるけど、フェノメノン\n発生と同日のことだった。"},
        { "location": "489/TALK"  , "narrator": "千羽鶴", "text": "そしてそれが災いして、\n彼女の判断次第では、\n戦闘に影響が出てしまう。"},
        { "location": "490/TALK"  , "narrator": "千羽鶴", "text": "非常に難しい問題に\n直面している彼女を\n助けてあげて欲しい。"},
        { "location": "491/TALK"  , "narrator": "千羽鶴", "text": "その事情は、実際に\n彼女のチャンネルに行って\n自分の目で確かめて。"},
        { "location": "492/TALK"  , "narrator": "千羽鶴", "text": "それじゃ、\n健闘を祈ってる。"},
        { "location": "496/TALK"  , "narrator": "千羽鶴", "text": "さて、今回の\nガブリエラだけど――"},
        { "location": "497/TALK"  , "narrator": "千羽鶴", "text": "バトルからは少しだけ\n時間をずらして、数日前に\nスポットを当てる。"},
        { "location": "498/TALK"  , "narrator": "千羽鶴", "text": "その日は金曜。\n平日の放課後に\nあたる時間。"},
        { "location": "499/TALK"  , "narrator": "千羽鶴", "text": "彼女はこの時、\n些細なことで悩んでいる。"},
        { "location": "500/TALK"  , "narrator": "千羽鶴", "text": "しかし、そこで入手する\n情報は、後日のバトルと\n深い関係がある。"},
        { "location": "501/TALK"  , "narrator": "千羽鶴", "text": "彼女はまだそれに気づいて\nいないけど、この情報を\n取得しておいた方がいい。"},
        { "location": "502/TALK"  , "narrator": "千羽鶴", "text": "貴方には是非、\nその為のサポートを\nしてもらいたい。"},
        { "location": "503/TALK"  , "narrator": "千羽鶴", "text": "それじゃ、\n健闘を祈ってる。"},
        { "location": "507/TALK"  , "narrator": "千羽鶴", "text": "さて、今回の\n恋ヶ崎みやびだけど――"},
        { "location": "508/TALK"  , "narrator": "千羽鶴", "text": "記録映像を見ても\nわかる通り、今回彼女は\n前線から離脱している。"},
        { "location": "509/TALK"  , "narrator": "千羽鶴", "text": "もちろんそのような事は、\n普段であれば許される\n事ではない。"},
        { "location": "510/TALK"  , "narrator": "千羽鶴", "text": "けど、今回に関しては\nこの機転をきかせた行動が\n良い結果を生んでいる。"},
        { "location": "511/TALK"  , "narrator": "千羽鶴", "text": "しかし、この結論に\n至る過程においては、\n貴方の協力が必要になる。"},
        { "location": "512/TALK"  , "narrator": "千羽鶴", "text": "その為、貴方には彼女が\n最善を尽くせるよう、その\nサポートをして欲しい。"},
        { "location": "513/TALK"  , "narrator": "千羽鶴", "text": "それじゃ、\n健闘を祈ってる。"},
        { "location": "83/DIALOG" , "narrator": "Dialog_Black_Nw", "text": "<size=400>特</size>"},
        { "location": "87/DIALOG" , "narrator": "Dialog_Black_Nw", "text": "<size=400>報</size>"},
        { "location": "91/DIALOG" , "narrator": "Dialog_Black_Nw", "text": "<size=400>！</size>"},
        { "location": "96/DIALOG" , "narrator": "Dialog_Black_Nw", "text": "<size=200>特報！</size>"},
        { "location": "102/DIALOG", "narrator": "Dialog_Black_Nw", "text": "<size=100>祝！\n意見収集\n100人突破！</size>"},
        { "location": "107/DIALOG", "narrator": "Dialog_Black_Nw", "text": "<size=100>全世界が\n泣いた。</size>"},
        { "location": "114/DIALOG", "narrator": "Dialog_Black_Nw", "text": "<size=100>あの名作\nクソゲーが。</size>"},
        { "location": "123/DIALOG", "narrator": "Dialog_Black_Nw", "text": "<size=300>再\n臨\n 。</size>"},
        { "location": "130/DIALOG", "narrator": "Dialog_Black_Nw", "text": "\n\n2017年6月28日　堂々開幕。\n―――――――――――――――――\n<size=25>\n原案\nちーちゃん\n\n原作\nちーちゃんのラブラブゲーム制作委員会 2017\n\nキャスト\n千羽鶴\n\n演出/効果\n千羽鶴\n\nchiharu-soft. 2017\n</size>\n"},
