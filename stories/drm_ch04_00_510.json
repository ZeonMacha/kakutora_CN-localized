        "title": "らぶとーく 第56話",
        "sub_title": "それはないわ、やっぱりあるわ"
    },
    "entry":
    [
        { "location": "156/SCENARIO", "narrator": "", "text": "それはないわ、やっぱりあるわ"},
        { "location": "173/TALK"    , "narrator": "みやび", "text": "いや"},
        { "location": "174/TALK"    , "narrator": "みやび", "text": "あそこのサーバーのセキュリティは甘い"},
        { "location": "175/TALK"    , "narrator": "みやび", "text": "抜け道がある"},
        { "location": "177/TALK"    , "narrator": "ラビットアニマ", "text": "なんと！"},
        { "location": "178/TALK"    , "narrator": "みやび", "text": "アドミンのパスは固いが"},
        { "location": "179/TALK"    , "narrator": "みやび", "text": "ユーザーアカウントにチョロいのがある"},
        { "location": "181/TALK"    , "narrator": "ラビットアニマ", "text": "なるほど"},
        { "location": "182/TALK"    , "narrator": "ラビットアニマ", "text": "そこを詳しく"},
        { "location": "183/TALK"    , "narrator": "みやび", "text": "そいつのログインパス"},
        { "location": "188/TALK"    , "narrator": "ラビットアニマ", "text": "ど新人にＷＡＶＥスタンプ一つ"},
        { "location": "189/TALK"    , "narrator": "みやび", "text": "おめおめ"},
        { "location": "191/TALK"    , "narrator": "みやび", "text": "うちの使っちょらんスタンプを送ろう"},
        { "location": "193/TALK"    , "narrator": "ラビットアニマ", "text": "光栄です"},
        { "location": "194/TALK"    , "narrator": "みやび", "text": "それはそうと"},
        { "location": "195/TALK"    , "narrator": "みやび", "text": "相棒は付いてきてるか？"},
        { "location": "197/SEL"     , "narrator": "", "text": "聞いてるだけでいいよ"},
        { "location": "198/SEL"     , "narrator": "", "text": "ついてってるし"},
        { "location": "199/SEL"     , "narrator": "", "text": "あ、寝てた"},
        { "location": "200/ACT"     , "narrator": "", "text": "聞いてるだけでいいよ"},
        { "location": "201/TALK"    , "narrator": "みやび", "text": "何と弱気！？"},
        { "location": "202/TALK"    , "narrator": "みやび", "text": "うちは悲しい！"},
        { "location": "203/TALK"    , "narrator": "みやび", "text": "男ならもっと押し気味でいかんと！"},
        { "location": "204/TALK"    , "narrator": "みやび", "text": "何言うても構わん"},
        { "location": "205/TALK"    , "narrator": "みやび", "text": "話に食いつくのだ！"},
        { "location": "206/TALK"    , "narrator": "みやび", "text": "その方がかっこいい！"},
        { "location": "207/TALK"    , "narrator": "みやび", "text": "うちが骨は拾うたる"},
        { "location": "209/TALK"    , "narrator": "ラビットアニマ", "text": "フォローするということ？"},
        { "location": "210/TALK"    , "narrator": "みやび", "text": "うさぎナイスフォロー"},
        { "location": "212/TALK"    , "narrator": "ラビットアニマ", "text": "その気はなかったのに"},
        { "location": "213/TALK"    , "narrator": "みやび", "text": "よし"},
        { "location": "214/TALK"    , "narrator": "みやび", "text": "話を続けよう"},
        { "location": "217/TALK"    , "narrator": "ラビットアニマ", "text": "いえ"},
        { "location": "218/TALK"    , "narrator": "ラビットアニマ", "text": "お邪魔みたいなので消えますね"},
        { "location": "219/TALK"    , "narrator": "システム", "text": "『ＲａｂｂｉｔＡｎｉｍａが退場しました』"},
        { "location": "228/TALK"    , "narrator": "みやび", "text": "何や？\n用事でもあるが？"},
        { "location": "230/TALK"    , "narrator": "繭", "text": "そうではないのですが…。"},
        { "location": "231/TALK"    , "narrator": "みやび", "text": "…？"},
        { "location": "232/TALK"    , "narrator": "繭", "text": "ふふっ…ごちそうさま。\nお腹いっぱいです。"},
        { "location": "238/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "239/TALK"    , "narrator": "みやび", "text": "さすがはウサギ、\n感がえいなぁ…。"},
        { "location": "240/ACT"     , "narrator": "", "text": "ついてってるし"},
        { "location": "241/TALK"    , "narrator": "みやび", "text": "さすがや"},
        { "location": "242/TALK"    , "narrator": "みやび", "text": "なんて"},
        { "location": "243/TALK"    , "narrator": "みやび", "text": "そんなわけあるか！"},
        { "location": "245/TALK"    , "narrator": "みやび", "text": "全然聞いてなかったやろ？"},
        { "location": "247/SEL"     , "narrator": "", "text": "バレたか"},
        { "location": "248/ACT"     , "narrator": "", "text": "バレたか"},
        { "location": "250/TALK"    , "narrator": "みやび", "text": "当然"},
        { "location": "251/TALK"    , "narrator": "みやび", "text": "気配を感じなかった"},
        { "location": "253/TALK"    , "narrator": "ラビットアニマ", "text": "あ"},
        { "location": "254/TALK"    , "narrator": "ラビットアニマ", "text": "こんにちは"},
        { "location": "255/TALK"    , "narrator": "ラビットアニマ", "text": "いたんですか"},
        { "location": "256/TALK"    , "narrator": "みやび", "text": "ウサギも感じなかったようや"},
        { "location": "258/TALK"    , "narrator": "ラビットアニマ", "text": "そういうの感じたことないのですが"},
        { "location": "259/TALK"    , "narrator": "みやび", "text": "うちも最近開眼した"},
        { "location": "260/TALK"    , "narrator": "みやび", "text": "ただし"},
        { "location": "261/TALK"    , "narrator": "みやび", "text": "相棒限定"},
        { "location": "264/TALK"    , "narrator": "ラビットアニマ", "text": "使い道が限られますね"},
        { "location": "265/TALK"    , "narrator": "みやび", "text": "ありがたいか？"},
        { "location": "267/SEL"     , "narrator": "", "text": "ありがたい"},
        { "location": "268/ACT"     , "narrator": "", "text": "ありがたい"},
        { "location": "270/TALK"    , "narrator": "みやび", "text": "よしよし"},
        { "location": "271/TALK"    , "narrator": "みやび", "text": "素直な良い子やねぇ"},
        { "location": "272/TALK"    , "narrator": "みやび", "text": "なでなでなでなで"},
        { "location": "274/TALK"    , "narrator": "ラビットアニマ", "text": "子犬を撫でてるように見える"},
        { "location": "275/TALK"    , "narrator": "みやび", "text": "そんな感じ"},
        { "location": "276/TALK"    , "narrator": "みやび", "text": "さて"},
        { "location": "277/TALK"    , "narrator": "みやび", "text": "話に戻るか"},
        { "location": "279/ACT"     , "narrator": "", "text": "あ、寝てた"},
        { "location": "280/TALK"    , "narrator": "みやび", "text": "バカモノ！"},
        { "location": "282/TALK"    , "narrator": "みやび", "text": "うちがいるゆうんに寝るとかありえん"},
        { "location": "283/TALK"    , "narrator": "みやび", "text": "独り言になってしまう"},
        { "location": "285/TALK"    , "narrator": "ラビットアニマ", "text": "私のことをお忘れですか？"},
        { "location": "292/TALK"    , "narrator": "ラビットアニマ", "text": "あ"},
        { "location": "293/TALK"    , "narrator": "ラビットアニマ", "text": "そこリアル言葉で謝るとは思いませんでした"},
        { "location": "294/TALK"    , "narrator": "みやび", "text": "存在忘れるとか失礼やきね"},
        { "location": "296/TALK"    , "narrator": "みやび", "text": "礼儀はちゃんとせんと"},
        { "location": "298/SEL"     , "narrator": "", "text": "みやびは偉い！"},
        { "location": "299/ACT"     , "narrator": "", "text": "みやびは偉い！"},
        { "location": "302/TALK"    , "narrator": "みやび", "text": "嬉しいな"},
        { "location": "303/TALK"    , "narrator": "みやび", "text": "もっと褒めても構わんぞ"},
        { "location": "304/TALK"    , "narrator": "みやび", "text": "むしろ褒めまくれ"},
        { "location": "307/TALK"    , "narrator": "ラビットアニマ", "text": "何か出るんですか？"},
        { "location": "308/TALK"    , "narrator": "みやび", "text": "それはお楽しみ"},
        { "location": "310/TALK"    , "narrator": "ラビットアニマ", "text": "なるほど"},
        { "location": "311/TALK"    , "narrator": "ラビットアニマ", "text": "興味はあります"},
        { "location": "312/TALK"    , "narrator": "みやび", "text": "見たいが？"},
        { "location": "171/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>某月某日　 5:02 PM</color>\nとある平日の放課後、某カフェにて"}
    ]
}
