        { "location": "761/TALK"    , "narrator": "神楽", "text": "ぴょんこだって$handle$の話聞きたい時もあるんだから！"},
        { "location": "764/SEL"     , "narrator": "", "text": "神楽とのＷＡＶＥは癒し"},
        { "location": "765/SEL"     , "narrator": "", "text": "神楽がちょっと心配"},
