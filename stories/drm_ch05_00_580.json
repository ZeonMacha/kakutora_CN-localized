        { "location": "786/TALK"    , "narrator": "神楽", "text": "心配性だなー$handle$"},
        { "location": "788/SEL"     , "narrator": "", "text": "そういうところが心配"},
        { "location": "789/SEL"     , "narrator": "", "text": "取り越し苦労ならいいけど"},
        { "location": "790/SEL"     , "narrator": "", "text": "何でも聞くからね！"},
        { "location": "791/ACT"     , "narrator": "", "text": "そういうところが心配"},
        { "location": "792/TALK"    , "narrator": "神楽", "text": "ｿｳﾅﾉｶ、、、"},
        { "location": "793/ACT"     , "narrator": "", "text": "取り越し苦労ならいいけど"},
        { "location": "794/TALK"    , "narrator": "神楽", "text": "あっ何それ"},
        { "location": "795/TALK"    , "narrator": "神楽", "text": "心配しなさいよねっ！（ツンデレ"},
        { "location": "796/ACT"     , "narrator": "", "text": "何でも聞くからね！"},
        { "location": "797/TALK"    , "narrator": "神楽", "text": "そのためには資金が必要ぴょん"},
        { "location": "798/TALK"    , "narrator": "神楽", "text": "今すぐぴょんこバンクに一億振り込むこと！"},
        { "location": "799/TALK"    , "narrator": "神楽", "text": "それで情報解禁！"},
        { "location": "801/ACT"     , "narrator": "", "text": "これからも色々話そうよ"},
        { "location": "802/TALK"    , "narrator": "神楽", "text": "例えば？"},
        { "location": "804/SEL"     , "narrator": "", "text": "天気の話とか？"},
        { "location": "805/SEL"     , "narrator": "", "text": "二人の愛について"},
        { "location": "806/SEL"     , "narrator": "", "text": "推してるラノベとか"},
        { "location": "807/ACT"     , "narrator": "", "text": "天気の話とか？"},
        { "location": "808/TALK"    , "narrator": "神楽", "text": "なんでよ"},
        { "location": "810/TALK"    , "narrator": "神楽", "text": "わけわからなさ杉"},
        { "location": "811/ACT"     , "narrator": "", "text": "二人の愛について"},
        { "location": "812/TALK"    , "narrator": "神楽", "text": "おっｲｲﾈｲｲﾈ♪"},
        { "location": "814/ACT"     , "narrator": "", "text": "推してるラノベとか"},
        { "location": "815/TALK"    , "narrator": "神楽", "text": "それは、、、"},
        { "location": "816/TALK"    , "narrator": "神楽", "text": "始めると朝まで語っても語りつくせないあれこれになるが、、、"},
        { "location": "818/TALK"    , "narrator": "神楽", "text": "その覚悟はあるのか？人の子よ、、、"},
        { "location": "819/TALK"    , "narrator": "神楽", "text": "ｺﾞｺﾞｺﾞｺﾞｺﾞｺﾞ、、、"},
        { "location": "822/TALK"    , "narrator": "神楽", "text": "いやそういう話じゃなくて"},
        { "location": "823/TALK"    , "narrator": "神楽", "text": "$handle$も色々ぴょんこに話してよって"},
        { "location": "824/TALK"    , "narrator": "神楽", "text": "そういう話なんでしたー！"},
        { "location": "826/SEL"     , "narrator": "", "text": "$me$もそうしたいけど…"},
        { "location": "827/SEL"     , "narrator": "", "text": "いやそれは無理"},
        { "location": "828/SEL"     , "narrator": "", "text": "神楽の話を聞く方が楽しいよ"},
        { "location": "829/ACT"     , "narrator": "", "text": "$me$もそうしたいけど…"},
        { "location": "830/TALK"    , "narrator": "神楽", "text": "けどなんだ"},
        { "location": "831/TALK"    , "narrator": "神楽", "text": "むぅぅぅぅ"},
        { "location": "832/ACT"     , "narrator": "", "text": "いやそれは無理"},
        { "location": "833/TALK"    , "narrator": "神楽", "text": "あっ言い切った！"},
        { "location": "834/TALK"    , "narrator": "神楽", "text": "ムキ―！！！！"},
        { "location": "835/ACT"     , "narrator": "", "text": "神楽の話を聞く方が楽しいよ"},
        { "location": "836/TALK"    , "narrator": "神楽", "text": "えーえーえーえー"},
        { "location": "837/TALK"    , "narrator": "神楽", "text": "ぴょんこは$handle$の話がいいのにー"},
        { "location": "839/TALK"    , "narrator": "神楽", "text": "なんかいつもぴょんこの都合で話してるみたいで"},
        { "location": "840/TALK"    , "narrator": "神楽", "text": "そういうのって"},
        { "location": "841/TALK"    , "narrator": "神楽", "text": "気にならないの？"},
        { "location": "843/SEL"     , "narrator": "", "text": "全然"},
        { "location": "844/SEL"     , "narrator": "", "text": "なるけどしょうがないかなって"},
        { "location": "845/SEL"     , "narrator": "", "text": "運営に報告だ！"},
        { "location": "846/ACT"     , "narrator": "", "text": "全然"},
        { "location": "847/TALK"    , "narrator": "神楽", "text": "$handle$は大物なのかな？"},
        { "location": "849/TALK"    , "narrator": "神楽", "text": "それとも鈍いのかな？"},
        { "location": "851/ACT"     , "narrator": "", "text": "なるけどしょうがないかなって"},
        { "location": "852/TALK"    , "narrator": "神楽", "text": "割り切ってるんだ？"},
        { "location": "853/TALK"    , "narrator": "神楽", "text": "むぅぅぅぅん、、、"},
        { "location": "854/ACT"     , "narrator": "", "text": "運営に報告だ！"},
        { "location": "855/TALK"    , "narrator": "神楽", "text": "なんだかなー"},
        { "location": "856/TALK"    , "narrator": "神楽", "text": "ぴょんこと$handle$の問題じゃないの"},
        { "location": "857/TALK"    , "narrator": "神楽", "text": "こういうの"},
        { "location": "859/TALK"    , "narrator": "神楽", "text": "ぴょんこ都合で話すってことは"},
        { "location": "860/TALK"    , "narrator": "神楽", "text": "ぴょんこに都合がいいところばっかりしか目にしないってことぴょん"},
        { "location": "861/TALK"    , "narrator": "神楽", "text": "あっその方がよかったぴょん♪"},
        { "location": "862/TALK"    , "narrator": "神楽", "text": "$handle$はかっこよくてかわいいぴょんこしか知らずにすむね★"},
        { "location": "864/SEL"     , "narrator": "", "text": "素の神楽も知りたいな…"},
        { "location": "865/SEL"     , "narrator": "", "text": "オフな神楽は教えてくれないの？"},
        { "location": "866/SEL"     , "narrator": "", "text": "そうじゃないとこも知ってるけどなー"},
        { "location": "867/ACT"     , "narrator": "", "text": "素の神楽も知りたいな…"},
