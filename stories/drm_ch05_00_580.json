        { "location": "767/ACT"     , "narrator": "", "text": "神楽とのＷＡＶＥは癒し"},
        { "location": "768/TALK"    , "narrator": "神楽", "text": "そうなの？"},
        { "location": "769/TALK"    , "narrator": "神楽", "text": "結構荒れてる時もあると思うけどﾅｰ"},
        { "location": "771/SEL"     , "narrator": "", "text": "そこがかわいい"},
