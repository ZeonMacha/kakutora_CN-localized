    "type": "",
    "info": {
        "story_id": "21018",
        "cid": "",
        "title": "018 ココロスフィアストーリー【Lv06】",
        "sub_title": "チャプター９＜帰結＞"
    },
    "entry":
    [
        { "location": "6/SCENARIO", "narrator": "", "text": "微笑の裏にあるものは"},
        { "location": "25/TALK"   , "narrator": "潜在つばめ", "text": "なるほど、\n大したものだよ。"},
        { "location": "26/TALK"   , "narrator": "潜在つばめ", "text": "まさか深層世界でも\nあなたに負けるなんて。"},
        { "location": "27/TALK"   , "narrator": "表層つばめ", "text": "続き、\n見せてくれるよね？"},
        { "location": "28/TALK"   , "narrator": "潜在つばめ", "text": "もちろんだよ。\nそれはココロの中の\n約束事だもん。"},
        { "location": "29/TALK"   , "narrator": "潜在つばめ", "text": "でも何度も言うけど、\n知った後の気持ちの\n処理は自己責任で。"},
        { "location": "30/TALK"   , "narrator": "潜在つばめ", "text": "それだけは、\nよろしくね。"},
        { "location": "31/TALK"   , "narrator": "表層つばめ", "text": "……うん。"},
        { "location": "52/DIALOG" , "narrator": "", "text": "静岡での高校入学後、\n初めてできた友達と帰宅中、\nそのうちの一人がスマホを\n池に落としてしまった。\n\nそしてその翌日のこと――"},
        { "location": "54/TALK"   , "narrator": "つばめ", "text": "おはよう！"},
        { "location": "55/TALK"   , "narrator": "女子高校生Ａ", "text": "あ、おはよー、\nつばめちゃん。"},
        { "location": "56/TALK"   , "narrator": "つばめ", "text": "あ、っと……"},
        { "location": "61/TALK"   , "narrator": "つばめ", "text": "これ！\n見つけたよ！"},
        { "location": "62/TALK"   , "narrator": "女子高校生Ａ", "text": "え…"},
        { "location": "63/TALK"   , "narrator": "女子高校生Ａ", "text": "ええええっ！！\nそれって昨日落とした\n私のスマホ！？"},
        { "location": "65/TALK"   , "narrator": "つばめ", "text": "うんっ！\n見つかって良かったよ。"},
        { "location": "66/TALK"   , "narrator": "女子高校生Ａ", "text": "いや……その…\nでも、あのため池、\n超汚くなかった？"},
        { "location": "67/TALK"   , "narrator": "つばめ", "text": "ちょっと、だけ、\nえへへ…"},
        { "location": "68/TALK"   , "narrator": "つばめ", "text": "ああでも大丈夫だよ！\nお風呂で念入りに\n身体洗ったし！"},
        { "location": "69/TALK"   , "narrator": "つばめ", "text": "臭くないよね？"},
        { "location": "70/TALK"   , "narrator": "女子高校生Ａ", "text": "……。"},
        { "location": "71/TALK"   , "narrator": "女子高校生Ａ", "text": "あり……がとう……"},
        { "location": "72/TALK"   , "narrator": "つばめ", "text": "…どうしたの？"},
        { "location": "73/TALK"   , "narrator": "女子高校生Ａ", "text": "はぁ…。\nちょっと待って。"},
        { "location": "77/TALK"   , "narrator": "女子高校生Ａ", "text": "はいこれ。\n約束の１万円。\nこれでいい？"},
        { "location": "79/TALK"   , "narrator": "つばめ", "text": "ええええっ！！\nいいいいらないよ！"},
        { "location": "80/TALK"   , "narrator": "女子高校生Ａ", "text": "え？\nなんで？"},
        { "location": "81/TALK"   , "narrator": "つばめ", "text": "わたしは、みさき\nちゃんが喜んでくれ\nたらってそれだけで…"},
        { "location": "82/TALK"   , "narrator": "つばめ", "text": "とにかく、見つかって\n良かったよ。\nそれじゃまた後でね！"},
        { "location": "86/TALK"   , "narrator": "女子高校生Ａ", "text": "……。"},
        { "location": "88/TALK"   , "narrator": "女子高校生Ｂ", "text": "おはよー！"},
        { "location": "89/TALK"   , "narrator": "女子高校生Ｂ", "text": "って、あれ？\nどうしたの？"},
        { "location": "90/TALK"   , "narrator": "女子高校生Ａ", "text": "いや、\nつばめちゃんがさ……"},
        { "location": "99/TALK"   , "narrator": "女子高校生Ｂ", "text": "ええっ！\nマジで？\n信じらんない。"},
        { "location": "100/TALK"  , "narrator": "女子高校生Ｂ", "text": "で、そのスマホ\nどうすんの？"},
        { "location": "101/TALK"  , "narrator": "女子高校生Ａ", "text": "使わないよ、\n新しいの買って\nもらっちゃったし。"},
        { "location": "102/TALK"  , "narrator": "女子高校生Ａ", "text": "それに汚いじゃん…？"},
        { "location": "103/TALK"  , "narrator": "女子高校生Ｂ", "text": "だよねー！"},
        { "location": "104/TALK"  , "narrator": "女子高校生Ａ", "text": "つばめちゃんってさぁ、\nなんかちょっと別の\n世界に生きてるよね。"},
        { "location": "105/TALK"  , "narrator": "女子高校生Ｂ", "text": "あそうそうそう！\n私もそう思ってたん\nだよね！！"},
        { "location": "106/TALK"  , "narrator": "女子高校生Ａ", "text": "やっていける自信\nないわー。\n眩しすぎて！"},
        { "location": "107/TALK"  , "narrator": "女子高校生Ｂ", "text": "同感～～。\n気が合うねえ。"},
        { "location": "108/TALK"  , "narrator": "女子高校生Ｂ", "text": "みさきちゃんとは\nズッ友でいられそう。"},
        { "location": "109/TALK"  , "narrator": "女子高校生Ａ", "text": "ズッ友だよー。\n当然じゃん。"},
        { "location": "110/TALK"  , "narrator": "女子高校生Ｂ", "text": "あはは～よかった！"},
        { "location": "112/TALK"  , "narrator": "女子高校生Ｂ", "text": "あ、そうだ！\n今日学校終わったらさ、\n二人で――"},
        { "location": "135/TALK"  , "narrator": "潜在つばめ", "text": "…どうかな？\n何かのヒントに\nなった？"},
        { "location": "136/TALK"  , "narrator": "表層つばめ", "text": "わからない。\nでも……"},
        { "location": "137/TALK"  , "narrator": "表層つばめ", "text": "わたしのこと、\n後であんな風に\n話されてたんだ。"},
        { "location": "138/TALK"  , "narrator": "表層つばめ", "text": "全然忘れてたよ。"},
        { "location": "139/TALK"  , "narrator": "潜在つばめ", "text": "忘れてたわけじゃ\nないよ。"},
        { "location": "140/TALK"  , "narrator": "潜在つばめ", "text": "心の奥で繋がってる\n集合的無意識から拾っ\nてきちゃってるだけ。"},
        { "location": "141/TALK"  , "narrator": "潜在つばめ", "text": "そういうことも\nあるんだよ。"},
        { "location": "142/TALK"  , "narrator": "潜在つばめ", "text": "だから「ヒントだけで\n済めばいいけど」って\n言ったの。"},
        { "location": "143/TALK"  , "narrator": "表層つばめ", "text": "……。"},
        { "location": "145/TALK"  , "narrator": "潜在つばめ", "text": "…と、わたしそろそろ\nエネルギー切れみたい。"},
        { "location": "147/TALK"  , "narrator": "潜在つばめ", "text": "約束はちゃんと\n果たしたよね。"},
        { "location": "148/TALK"  , "narrator": "潜在つばめ", "text": "あとはじっくり\n考えてみるといいと\n思うよ。"},
        { "location": "164/TALK"  , "narrator": "表層つばめ", "text": "わたし……"},
        { "location": "165/SEL"   , "narrator": "（選択肢）", "text": "つばめ、かわいい！"},
        { "location": "166/SEL"   , "narrator": "（選択肢）", "text": "純粋すぎるんだね"},
        { "location": "167/SEL"   , "narrator": "（選択肢）", "text": "確かに引くわ、これは"},
        { "location": "168/ACT"   , "narrator": "", "text": "つばめ、かわいい！"},
        { "location": "170/TALK"  , "narrator": "表層つばめ", "text": "ええええっ！\nなんでそうなるの？"},
        { "location": "171/SEL"   , "narrator": "（選択肢）", "text": "今のでもっとつばめが好きになった"},
        { "location": "172/ACT"   , "narrator": "", "text": "今のでもっとつばめが好きになった"},
        { "location": "174/TALK"  , "narrator": "表層つばめ", "text": "そ、そうなの？\nよくわかんないけど―"},
        { "location": "176/TALK"  , "narrator": "表層つばめ", "text": "でも、あんだけ困って\nたら、助けたいって\n思わないのかな。"},
        { "location": "177/SEL"   , "narrator": "（選択肢）", "text": "なるよ！"},
        { "location": "178/SEL"   , "narrator": "（選択肢）", "text": "人によるかな"},
        { "location": "179/ACT"   , "narrator": "", "text": "なるよ！"},
        { "location": "180/TALK"  , "narrator": "表層つばめ", "text": "そっか、\n少し安心したよ。"},
        { "location": "181/TALK"  , "narrator": "表層つばめ", "text": "わたしだけ\n何かおかしいのかと\n思っちゃってた。"},
        { "location": "182/ACT"   , "narrator": "", "text": "人によるかな"},
        { "location": "183/TALK"  , "narrator": "表層つばめ", "text": "そっか。確かに、\n人それぞれだもんね。"},
        { "location": "185/ACT"   , "narrator": "", "text": "純粋すぎるんだね"},
        { "location": "186/TALK"  , "narrator": "表層つばめ", "text": "そんなことないよ。\nわたし、そんなに\n綺麗じゃないよ？"},
        { "location": "187/TALK"  , "narrator": "表層つばめ", "text": "すぐに怒っちゃうし、\nいやなことも\n考えちゃうし……"},
        { "location": "188/SEL"   , "narrator": "（選択肢）", "text": "普通だよ"},
        { "location": "189/ACT"   , "narrator": "", "text": "普通だよ"},
        { "location": "191/TALK"  , "narrator": "表層つばめ", "text": "そうかな……。"},
        { "location": "192/SEL"   , "narrator": "（選択肢）", "text": "それに、そこがつばめのいいところだと思う"},
        { "location": "193/ACT"   , "narrator": "", "text": "それに、そこがつばめのいいところだと思う"},
        { "location": "195/TALK"  , "narrator": "表層つばめ", "text": "いいところ…\nなのかなぁ……"},
        { "location": "196/ACT"   , "narrator": "", "text": "確かに引くわ、これは"},
        { "location": "197/TALK"  , "narrator": "表層つばめ", "text": "そうなんだ……\nこれから気をつけよう。"},
        { "location": "198/TALK"  , "narrator": "表層つばめ", "text": "……とはいっても\nどうやって気をつけた\nらいいかわからない。"},
        { "location": "199/SEL"   , "narrator": "（選択肢）", "text": "そのままでいいんじゃない？"},
        { "location": "200/ACT"   , "narrator": "", "text": "そのままでいいんじゃない？"},
        { "location": "202/TALK"  , "narrator": "表層つばめ", "text": "そうなの？"},
        { "location": "203/SEL"   , "narrator": "（選択肢）", "text": "つばめの性格に合う人もいるよ"},
        { "location": "204/ACT"   , "narrator": "", "text": "つばめの性格に合う人もいるよ"},
        { "location": "206/TALK"  , "narrator": "表層つばめ", "text": "そういうもの\nなのかなぁ。"},
        { "location": "208/SEL"   , "narrator": "（選択肢）", "text": "とにかく！！"},
        { "location": "209/ACT"   , "narrator": "", "text": "とにかく！！"},
        { "location": "211/TALK"  , "narrator": "表層つばめ", "text": "は、はいっ！！"},
        { "location": "212/SEL"   , "narrator": "（選択肢）", "text": "友達欲しかったら当たっていくしかないよ！"},
        { "location": "213/ACT"   , "narrator": "", "text": "友達欲しかったら当たっていくしかないよ！"},
        { "location": "215/TALK"  , "narrator": "表層つばめ", "text": "そ、そうなんだけど…\nまた同じことに\nなっちゃったら……"},
        { "location": "216/SEL"   , "narrator": "（選択肢）", "text": "$me$はつばめが好きだよ"},
        { "location": "217/SEL"   , "narrator": "（選択肢）", "text": "つばめと気が合う子だっているよ"},
        { "location": "218/ACT"   , "narrator": "", "text": "$me$はつばめが好きだよ"},
        { "location": "220/TALK"  , "narrator": "表層つばめ", "text": "そ、そうなの？"},
        { "location": "221/TALK"  , "narrator": "表層つばめ", "text": "なんか、ちょっと\n嬉しいかも。"},
        { "location": "222/ACT"   , "narrator": "", "text": "つばめと気が合う子だっているよ"},
        { "location": "223/TALK"  , "narrator": "表層つばめ", "text": "そう…だね。"},
        { "location": "225/SEL"   , "narrator": "（選択肢）", "text": "元気出して。いつものつばめで当たっていけばいい。"},
        { "location": "226/ACT"   , "narrator": "", "text": "元気出して。いつものつばめで当たっていけばいい。"},
        { "location": "228/TALK"  , "narrator": "表層つばめ", "text": "……うん。"},
        { "location": "229/TALK"  , "narrator": "表層つばめ", "text": "最初から諦めてたら\nだめだよね。"},
        { "location": "231/TALK"  , "narrator": "表層つばめ", "text": "$handle$\nみたいに――"},
        { "location": "232/TALK"  , "narrator": "表層つばめ", "text": "わたしのこと、\n好きって言ってくれる\n人もいるんだし。"},
        { "location": "234/TALK"  , "narrator": "表層つばめ", "text": "勇気出して\n当たってみるよ！"},
        { "location": "235/SEL"   , "narrator": "（選択肢）", "text": "がんばって！"},
        { "location": "236/ACT"   , "narrator": "", "text": "がんばって！"},
        { "location": "238/TALK"  , "narrator": "表層つばめ", "text": "いろいろありがとう。"},
        { "location": "239/TALK"  , "narrator": "表層つばめ", "text": "今回は、ちょっと\n自分を知ることが\n出来た気がするよ。"},
        { "location": "240/TALK"  , "narrator": "表層つばめ", "text": "また何かあったら、\nよろしくね。"}
    ]
}
