    "entry":
    [
        { "location": "151/SCENARIO", "narrator": "", "text": "030_さよなら、人魚姫"},
        { "location": "178/TALK"    , "narrator": "ガブリエラ", "text": "怖い話を聞いてしまったわ"},
        { "location": "179/TALK"    , "narrator": "ガブリエラ", "text": "日本の人魚伝説"},
        { "location": "180/TALK"    , "narrator": "ガブリエラ", "text": "衝撃的だったわ"},
        { "location": "181/TALK"    , "narrator": "ガブリエラ", "text": "なんてことかしら"},
        { "location": "183/SEL"     , "narrator": "", "text": "そんなのあったっけ"},
        { "location": "184/SEL"     , "narrator": "", "text": "八百比丘尼だね"},
        { "location": "185/ACT"     , "narrator": "", "text": "そんなのあったっけ"},
        { "location": "186/TALK"    , "narrator": "ガブリエラ", "text": "あったわよ"},
        { "location": "187/ACT"     , "narrator": "", "text": "八百比丘尼だね"},
        { "location": "189/TALK"    , "narrator": "ガブリエラ", "text": "漢字が読めないわ"},
        { "location": "192/SEL"     , "narrator": "", "text": "やおびくに"},
        { "location": "193/ACT"     , "narrator": "", "text": "やおびくに"},
        { "location": "195/TALK"    , "narrator": "ガブリエラ", "text": "そうそれよ"},
        { "location": "196/TALK"    , "narrator": "ガブリエラ", "text": "さすがね$marzanna$"},
        { "location": "198/TALK"    , "narrator": "ガブリエラ", "text": "人魚の肉を食べて"},
        { "location": "199/TALK"    , "narrator": "ガブリエラ", "text": "800年生きた人がいるんですって？"},
        { "location": "201/SEL"     , "narrator": "", "text": "非科学的"},
        { "location": "202/SEL"     , "narrator": "", "text": "実在しないから"},
        { "location": "203/SEL"     , "narrator": "", "text": "$me$は千年ガブに寄り添うよ"},
        { "location": "204/ACT"     , "narrator": "", "text": "非科学的"},
        { "location": "205/TALK"    , "narrator": "ガブリエラ", "text": "伝説だもの"},
        { "location": "206/TALK"    , "narrator": "ガブリエラ", "text": "当たり前じゃない"},
        { "location": "207/ACT"     , "narrator": "", "text": "実在しないから"},
        { "location": "208/TALK"    , "narrator": "ガブリエラ", "text": "そういう問題じゃないのよ"},
        { "location": "209/ACT"     , "narrator": "", "text": "$me$は千年ガブに寄り添うよ"},
        { "location": "211/TALK"    , "narrator": "ガブリエラ", "text": "やだ$marzanna$ったら/////////"},
        { "location": "213/TALK"    , "narrator": "ガブリエラ", "text": "永遠を誓い合った"},
        { "location": "214/TALK"    , "narrator": "ガブリエラ", "text": "恋人同士みたいじゃないｖｖｖｖｖ"},
        { "location": "216/TALK"    , "narrator": "ガブリエラ", "text": "ところでこのお話"},
        { "location": "217/TALK"    , "narrator": "ガブリエラ", "text": "人間が不老不死になったってことはわかるのよ"},
        { "location": "218/TALK"    , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "219/TALK"    , "narrator": "ガブリエラ", "text": "人魚ってどんな生き物だったかがわからないのよね"},
        { "location": "220/TALK"    , "narrator": "ガブリエラ", "text": "だから余計"},
        { "location": "221/TALK"    , "narrator": "ガブリエラ", "text": "不気味な感じがして怖いのかしら"}
    ]
}
