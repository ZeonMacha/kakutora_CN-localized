{
    "dir": "chap19/daydra/dd_ch02_19_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "19252",
        "cid": "ayami",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "夏は特に"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "夏は特に…"},
        { "location": "29/TALK"   , "narrator": "透明つばめ", "text": "はぁ、はぁ…。"},
        { "location": "33/TALK"   , "narrator": "透明ガブリエラ", "text": "つばめ、大丈夫？\n大分息が上がってるわよ？"},
        { "location": "35/TALK"   , "narrator": "透明つばめ", "text": "う、うん…疲れたけど、\nまだ平気…。"},
        { "location": "39/TALK"   , "narrator": "透明神楽", "text": "みやびさんは？"},
        { "location": "42/TALK"   , "narrator": "透明みやび", "text": "…ちっくと、\n辛くなってきたがよ…。"},
        { "location": "44/TALK"   , "narrator": "透明つばめ", "text": "ゴール…真幌さんのとこ、\nまだ遠い？"},
        { "location": "48/TALK"   , "narrator": "透明神楽", "text": "まだ大分先ですから、\n辛いなら少しペース\n落としますか？"},
        { "location": "50/TALK"   , "narrator": "透明つばめ", "text": "う、ううん…頑張る！"},
        { "location": "54/TALK"   , "narrator": "透明アーヤ", "text": "みんな、遅れ気味よ。\nお喋りしてないで\n走って。"},
        { "location": "58/TALK"   , "narrator": "透明ガブリエラ", "text": "あ、アーヤはちょっと、\n元気過ぎよ！"},
        { "location": "61/TALK"   , "narrator": "透明つばめ", "text": "疲れてないんですか？"},
        { "location": "64/TALK"   , "narrator": "透明アーヤ", "text": "まさか。\nさっきから足が重くて、\n結構辛いわ。"},
        { "location": "66/TALK"   , "narrator": "透明みやび", "text": "全然そうには見えんぞ？\nまだまだ走り足りない\n感じやないか。"},
        { "location": "70/TALK"   , "narrator": "透明アーヤ", "text": "ふふっ…こういうの、\n昔から憧れてたの。"},
        { "location": "72/TALK"   , "narrator": "透明アーヤ", "text": "朝の誰もいない砂浜で、\n走り込みする特訓って――"},
        { "location": "74/TALK"   , "narrator": "透明アーヤ", "text": "青春ドラマみたいで、\nワクワクしない？"},
        { "location": "76/TALK"   , "narrator": "透明ガブリエラ", "text": "今時、そんな汗臭い\n青春ドラマやってんの？"},
        { "location": "79/TALK"   , "narrator": "透明みやび", "text": "わからんけんど、\nうちの好みやないき、\n見る気はせんな。"},
        { "location": "82/TALK"   , "narrator": "透明つばめ", "text": "み、見たとしても、\n真似したいとは\n思えません…。"},
        { "location": "86/TALK"   , "narrator": "透明アーヤ", "text": "はい、お喋りはそこまで。\n卯月、そろそろペース\n上げたらどう？"},
        { "location": "90/TALK"   , "narrator": "透明神楽", "text": "…様子を見てそうします。"},
        { "location": "94/TALK"   , "narrator": "透明アーヤ", "text": "わかったわ。\nじゃあ、先行ってるわ。"},
        { "location": "100/TALK"  , "narrator": "透明ガブリエラ", "text": "うわっ、\nスピード上げたし！？"},
        { "location": "103/TALK"  , "narrator": "透明神楽", "text": "…あれ、\n絶対疲れてませんよね？"},
        { "location": "104/TALK"  , "narrator": "透明神楽", "text": "砂浜なのに、フォームも\n凄い綺麗ですし…。"},
        { "location": "106/TALK"  , "narrator": "透明みやび", "text": "体育会系は凄いな…。\nうちから見たら、\n化け物や。"},
        { "location": "110/TALK"  , "narrator": "透明みやび", "text": "卯月はえいが？\nうちら置いて、先行っても\nえいんよ？"},
        { "location": "113/TALK"  , "narrator": "透明神楽", "text": "もう少ししたら行きます。\n今は、アーヤさんのペースに\n引っ張られて――"},
        { "location": "114/TALK"  , "narrator": "透明神楽", "text": "自分のペース配分を\n崩しそうなので…。"},
        { "location": "116/TALK"  , "narrator": "透明ガブリエラ", "text": "…あっ！"},
        { "location": "120/TALK"  , "narrator": "透明ガブリエラ", "text": "ちょ、アーヤ！\nシャツ、シャツが！！"},
        { "location": "124/TALK"  , "narrator": "透明神楽", "text": "汗で身体に張り付いて、\nちょっと透けちゃって\nますね。"},
        { "location": "127/TALK"  , "narrator": "透明みやび", "text": "あの様子だと、前の方も\nピッチリ張り付いちょり\nそうやけんど――"},
        { "location": "129/TALK"  , "narrator": "透明みやび", "text": "本人、まったく気付い\nとらんようやね。"},
        { "location": "132/TALK"  , "narrator": "透明つばめ", "text": "あ、アーヤさ…んっ！\nけほっ、けほっ！"},
        { "location": "137/TALK"  , "narrator": "透明ガブリエラ", "text": "バカ！　息上がってん\nだから、大声出せるはず\nないでしょ？"},
        { "location": "139/TALK"  , "narrator": "透明つばめ", "text": "で、でも、アーヤさんに\n教えないと…。"},
        { "location": "141/TALK"  , "narrator": "透明みやび", "text": "大丈夫や。\nこの砂浜はうちら以外、\n滅多に人は来んき――"},
        { "location": "142/TALK"  , "narrator": "透明みやび", "text": "運悪く誰かに見られたと\nしても、数人程度や。"},
        { "location": "146/TALK"  , "narrator": "透明つばめ", "text": "人数の問題じゃないです！"},
        { "location": "149/TALK"  , "narrator": "透明神楽", "text": "でも、もう私たちには\n何もできませんよ。"},
        { "location": "150/TALK"  , "narrator": "透明神楽", "text": "アーヤさん、あんなに\n先に行っちゃってますし。"},
        { "location": "159/TALK"  , "narrator": "透明アーヤ", "text": "…なんだか、高校時代を\n思い出すなぁ。"},
        { "location": "160/SEL"   , "narrator": "", "text": "つばめが何か言いたそう"},
        { "location": "161/SEL"   , "narrator": "", "text": "アーヤ、シャツが！"},
        { "location": "162/SEL"   , "narrator": "", "text": "端末操作：連続振動"},
        { "location": "165/TALK"  , "narrator": "透明アーヤ", "text": "剣道部の先輩に初めて\n褒められた時――"},
        { "location": "166/TALK"  , "narrator": "透明アーヤ", "text": "あの日は、嬉しくて\n疲れがあまり気にならない\n感じだったっけ。"},
        { "location": "168/TALK"  , "narrator": "透明アーヤ", "text": "なんか、逆に疲れが\n気持ちよく感じて――"},
        { "location": "169/TALK"  , "narrator": "透明アーヤ", "text": "今の私、あの時と\n同じ状態かも。"},
        { "location": "173/TALK"  , "narrator": "透明アーヤ", "text": "…ラストスパート！"},
        { "location": "175/ACT"   , "narrator": "", "text": "つばめが何か言いたそう"},
        { "location": "181/TALK"  , "narrator": "透明アーヤ", "text": "…今、震えた？\nＷＡＶＥかしら？"},
        { "location": "183/TALK"  , "narrator": "透明アーヤ", "text": "けど、今は走るのに\n集中しなくちゃ！"},
        { "location": "185/ACT"   , "narrator": "", "text": "アーヤ、シャツが！"},
        { "location": "191/TALK"  , "narrator": "透明アーヤ", "text": "…今、震えた？\nＷＡＶＥかしら？"},
        { "location": "193/TALK"  , "narrator": "透明アーヤ", "text": "けど、今は走るのに\n集中しなくちゃ！"},
        { "location": "214/TALK"  , "narrator": "真幌", "text": "最後まで足を止めるな！\nもうゴールは目の前だぞ！"},
        { "location": "217/TALK"  , "narrator": "アーヤ", "text": "みんな、頑張って！"},
        { "location": "220/TALK"  , "narrator": "神楽", "text": "ラストスパートですよ！"},
        { "location": "224/TALK"  , "narrator": "ガブリエラ", "text": "っ、ご…ゴール…。\nはぁ、はぁ…\nも、もう、走れない…。"},
        { "location": "229/TALK"  , "narrator": "つばめ", "text": "はぁ、はぁ…ううっ、\nあ、足が重いよぉ…。"},
        { "location": "231/TALK"  , "narrator": "みやび", "text": "ま、まほさん…砂浜での\n走り込みは、ちっくと\nキツいと思うがですよ。"},
        { "location": "233/TALK"  , "narrator": "真幌", "text": "合宿の訓練なんだ。\nキツいのは当然だろう？"},
        { "location": "234/TALK"  , "narrator": "真幌", "text": "それに、ちゃんと効果は\n出ているぞ。"},
        { "location": "238/TALK"  , "narrator": "アーヤ", "text": "初日よりも、タイムが\n随分上がりましたね。"},
        { "location": "240/TALK"  , "narrator": "真幌", "text": "そういうことだ。\nとにかく、今日もよく\n頑張ったな。"},
        { "location": "241/TALK"  , "narrator": "真幌", "text": "後は自由時間にするから、\nとりあえずシャワーでも\n浴びて、ゆっくり休め。"},
        { "location": "246/TALK"  , "narrator": "アーヤ", "text": "お疲れ様でした！"},
        { "location": "248/TALK"  , "narrator": "アーヤ", "text": "さあ、みんな。\n少し休んだらみやびの家に\n戻りましょ。"},
        { "location": "251/TALK"  , "narrator": "つばめ", "text": "そ、それより、\nシャツが…。"},
        { "location": "254/TALK"  , "narrator": "アーヤ", "text": "シャツがどうかした？"},
        { "location": "255/TALK"  , "narrator": "つばめ", "text": "…あ、あれ？"},
        { "location": "258/TALK"  , "narrator": "神楽", "text": "もう大丈夫ですよ。"},
        { "location": "259/TALK"  , "narrator": "神楽", "text": "私が到着した時には、\nほぼ乾いてましたから…。"},
        { "location": "260/TALK"  , "narrator": "みやび", "text": "それだけ、うちらより\n早く到着しちょった\nゆうことか…。"},
        { "location": "262/TALK"  , "narrator": "みやび", "text": "恐ろしい話や…。"},
        { "location": "265/TALK"  , "narrator": "アーヤ", "text": "よくわからないけど、\nみんなはもう少し体力を\nつけた方が良さそうね。"},
        { "location": "267/TALK"  , "narrator": "ガブリエラ", "text": "…アーヤは、もう少し\n自分の状態に気を配れる\nようになった方がいいわ。"},
        { "location": "270/TALK"  , "narrator": "つばめ", "text": "うん…本当、誰もいなくて\n良かったよ…。"},
        { "location": "274/TALK"  , "narrator": "アーヤ", "text": "？　何のことよ？"},
        { "location": "276/TALK"  , "narrator": "ガブリエラ", "text": "…ううん、何でもない。\n気にしないで…。"},
        { "location": "277/ACT"   , "narrator": "", "text": "端末操作：連続振動"},
        { "location": "284/TALK"  , "narrator": "透明アーヤ", "text": "…電話かしら？"},
        { "location": "285/TALK"  , "narrator": "透明アーヤ", "text": "仕方ないわね。\n一度止まらないと。"},
        { "location": "305/TALK"  , "narrator": "アーヤ", "text": "電話じゃなかったみたい。"},
        { "location": "306/TALK"  , "narrator": "アーヤ", "text": "もしかして、タイマーでも\n掛かってたのかしら？"},
        { "location": "307/TALK"  , "narrator": "つばめ", "text": "あ、アーヤさーん！"},
        { "location": "315/TALK"  , "narrator": "アーヤ", "text": "あっ、追いつかれ\nちゃった…。"},
        { "location": "318/TALK"  , "narrator": "ガブリエラ", "text": "アーヤ、シャツ！\n超透けてるから！"},
        { "location": "323/TALK"  , "narrator": "アーヤ", "text": "えっ…きゃっ！？"},
        { "location": "325/TALK"  , "narrator": "みやび", "text": "…気付いてなかった\nみたいやね。"},
        { "location": "330/TALK"  , "narrator": "神楽", "text": "パタパタしてください！\nパタパタして、シャツに\n空気入れてください！"},
        { "location": "333/TALK"  , "narrator": "アーヤ", "text": "う、うん…ありがと、\n教えてくれて…。"},
        { "location": "335/TALK"  , "narrator": "ガブリエラ", "text": "気付かなかったの？\nあんなくっついてたら\n気持ち悪いと思うのに…。"},
        { "location": "337/TALK"  , "narrator": "アーヤ", "text": "感じなかったわ。\n多分、走るのに夢中に\nなってて…。"},
        { "location": "339/TALK"  , "narrator": "神楽", "text": "…アーヤさんって、\nスポーツしてる時は――"},
        { "location": "340/TALK"  , "narrator": "神楽", "text": "凄い無防備になっちゃうん\nですね？"},
        { "location": "341/TALK"  , "narrator": "みやび", "text": "意外な一面やね。"},
        { "location": "344/TALK"  , "narrator": "アーヤ", "text": "もう、恥ずかしいから\nあまり言わないでよ…。"},
        { "location": "25/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>8月21日　 8:25 AM</color>\n合宿中、午前の訓練にて"}
    ]
}
