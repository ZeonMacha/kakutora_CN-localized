{
    "dir": "chap10/daydra/dd_ch01_10_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "10102",
        "cid": "tsubame",
        "title": "002 メインストーリー",
        "sub_title": "新入隊員歓迎会＜前編＞"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "新入隊員歓迎会"},
        { "location": "73/TALK"   , "narrator": "真幌", "text": "えー、では、新人の\n入隊とこれからの\n活躍を期待して――"},
        { "location": "85/TALK"   , "narrator": "真幌", "text": "乾杯！"},
        { "location": "86/TALK"   , "narrator": "一同", "text": "<color=red><size=40>乾杯！</size></color>"},
        { "location": "90/TALK"   , "narrator": "みやび", "text": "つばめちゃん、乙。\nどんどん食べりゃせ。"},
        { "location": "94/TALK"   , "narrator": "つばめ", "text": "は、はい…。\nそれにしても、\n豪華な料理ですねぇ。"},
        { "location": "97/TALK"   , "narrator": "みやび", "text": "お口に合わなかったら\nすまんがね。"},
        { "location": "99/TALK"   , "narrator": "みやび", "text": "うち、和食しか\n出来へんから…。"},
        { "location": "102/TALK"  , "narrator": "つばめ", "text": "これ、みやびさんが\n作ったんですか！？"},
        { "location": "105/TALK"  , "narrator": "つばめ", "text": "料亭の料理にしか\n見えないんです\nけど…。"},
        { "location": "107/TALK"  , "narrator": "みやび", "text": "うちの実家、土佐で\n酒造をしてたき――"},
        { "location": "108/TALK"  , "narrator": "みやび", "text": "こういうのは\n子供の頃に、\n一杯仕込まれたが。"},
        { "location": "113/TALK"  , "narrator": "つばめ", "text": "それでも、これは\nすご過ぎると思い\nますよ？"},
        { "location": "116/TALK"  , "narrator": "みやび", "text": "料理もプログラムも、\nどれだけ行程を\nモジュール化して――"},
        { "location": "117/TALK"  , "narrator": "みやび", "text": "効率のいい処理を\nできるかが決め手に\nなるちや。"},
        { "location": "122/TALK"  , "narrator": "つばめ", "text": "…みやびさんの\n言うことって、難しい\n単語多いなぁ…。"},
        { "location": "124/TALK"  , "narrator": "真幌", "text": "…しかし、卯月は\nいつになったら\n来るんだ？"},
        { "location": "125/TALK"  , "narrator": "真幌", "text": "新人歓迎会なのだから\n主役が揃わんことには\n盛り上がらんし――"},
        { "location": "127/TALK"  , "narrator": "真幌", "text": "逢瀬も、一人だけで\n居心地の悪い思いは\nしていないか？"},
        { "location": "131/TALK"  , "narrator": "つばめ", "text": "いえ、皆さんに\n歓迎してもらえて、\n凄く嬉しいです。"},
        { "location": "134/TALK"  , "narrator": "つばめ", "text": "でも、卯月さんとも\n早くお話したいな…。"},
        { "location": "137/TALK"  , "narrator": "ガブリエラ", "text": "ほら、新人。\nたこ焼き焼けたわよ。"},
        { "location": "140/TALK"  , "narrator": "つばめ", "text": "えっ？"},
        { "location": "145/TALK"  , "narrator": "ガブリエラ", "text": "栄えある一個目を\n食べさせてあげる\nから、感謝しなさい。"},
        { "location": "148/TALK"  , "narrator": "つばめ", "text": "あ、ありがとう\nございます！\nいただきまーす。"},
        { "location": "152/TALK"  , "narrator": "アーヤ", "text": "ギャヴィ、焼き方が\n前にも増して上手く\nなったわね。"},
        { "location": "154/TALK"  , "narrator": "ガブリエラ", "text": "褒めるなら、\n焼き方じゃなくて\n味の方でしょ？"},
        { "location": "155/TALK"  , "narrator": "アーヤ", "text": "ふふっ、それなら\n私にも焼いてもらおう\nかしら？"},
        { "location": "159/TALK"  , "narrator": "つばめ", "text": "わぁ、美味しい！\nこのたこ焼き、\n最高です！"},
        { "location": "164/TALK"  , "narrator": "ガブリエラ", "text": "そ、そう？"},
        { "location": "167/TALK"  , "narrator": "つばめ", "text": "はい！\nこれなら仕事が\nなくなっても――"},
        { "location": "169/TALK"  , "narrator": "つばめ", "text": "たこ焼き屋さんで\n食べていけますね！"},
        { "location": "175/TALK"  , "narrator": "ガブリエラ", "text": "あんた！\n実は生粋のイジメっ子\nでしょ！？"},
        { "location": "178/TALK"  , "narrator": "つばめ", "text": "えええっ！？\nそんなことない\nですよ！"},
        { "location": "181/TALK"  , "narrator": "みやび", "text": "…ガブちゃんも、\nなんだかんだ言うて\n歓迎しちょるようやね。"},
        { "location": "186/TALK"  , "narrator": "神楽", "text": "お、遅くなり\nましたー！！"},
        { "location": "189/TALK"  , "narrator": "つばめ", "text": "あっ、卯月さん！"},
        { "location": "192/TALK"  , "narrator": "真幌", "text": "やっと主役が\n揃ったな。"},
        { "location": "196/TALK"  , "narrator": "神楽", "text": "すみません。\n到着が遅れて\nしまって。"},
        { "location": "199/TALK"  , "narrator": "アーヤ", "text": "卯月、こっち来て。\n席代わりましょ。"},
        { "location": "228/TALK"  , "narrator": "神楽", "text": "お待たせしました、\nつばめさん。"},
        { "location": "230/TALK"  , "narrator": "つばめ", "text": "ううん。\n卯月さんも、\nおつかれさま。"},
        { "location": "234/TALK"  , "narrator": "アーヤ", "text": "ふふっ…\n一気に二人も隊員が\n増えて――"},
        { "location": "235/TALK"  , "narrator": "アーヤ", "text": "急に大所帯になった\n気がするわね。"},
        { "location": "238/TALK"  , "narrator": "真幌", "text": "逢瀬と卯月以外は、\nみんな、バラバラでの\n入隊だったからな。"},
        { "location": "239/TALK"  , "narrator": "真幌", "text": "もちろん、\n同学年というのも\nコイツ等が初だ。"},
        { "location": "243/TALK"  , "narrator": "神楽", "text": "ふふっ、それって\n何だか――"},
        { "location": "244/TALK"  , "narrator": "神楽", "text": "運命を感じちゃい\nそうな出会いですね。"},
        { "location": "248/TALK"  , "narrator": "ガブリエラ", "text": "いや、大袈裟だから。"},
        { "location": "252/TALK"  , "narrator": "つばめ", "text": "ううん。\n大袈裟なんかじゃ\nないよ。"},
        { "location": "253/TALK"  , "narrator": "つばめ", "text": "同じ時期に入隊した\nのもそうだけど――"},
        { "location": "256/TALK"  , "narrator": "つばめ", "text": "出会ってすぐに\n仲良くなれたでしょ？"},
        { "location": "257/TALK"  , "narrator": "つばめ", "text": "だからね、わたしも\n卯月さんには、\n運命を感じてるよ。"},
        { "location": "261/TALK"  , "narrator": "神楽", "text": "…つばめさん。"},
        { "location": "264/TALK"  , "narrator": "アーヤ", "text": "…そうね。\nつばめの言う通り、\nきっと運命なのよ。"},
        { "location": "268/TALK"  , "narrator": "みやび", "text": "おっ？　アーヤが\nロマンチックなこと\n言うたぞ！？"},
        { "location": "273/TALK"  , "narrator": "アーヤ", "text": "何よ？　私だって\nこれくらい言うわよ。"},
        { "location": "278/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "286/TALK"  , "narrator": "神楽", "text": "あの、すみません。\nちょっとお花を摘みに\nいってきます。"},
        { "location": "291/TALK"  , "narrator": "つばめ", "text": "あ、卯月さん？"},
        { "location": "296/TALK"  , "narrator": "ガブリエラ", "text": "花摘みって、\nお手洗いのことよね？"},
        { "location": "299/TALK"  , "narrator": "みやび", "text": "うむ…まさかリアルで\n聞くとは思わんかった\nぞね。"},
        { "location": "303/TALK"  , "narrator": "つばめ", "text": "また待ちぼうけ…。\n早く戻ってきて\nほしいな…。"},
        { "location": "342/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "344/TALK"  , "narrator": "つばめ", "text": "卯月さん、遅いなぁ。\nどうしたんだろ…。"},
        { "location": "345/TALK"  , "narrator": "つばめ", "text": "…様子、見に行って\nみようかな？"},
        { "location": "346/TALK"  , "narrator": "つばめ", "text": "でも、トイレにまで\nおしかけるのって、\n変だよね…"},
        { "location": "347/TALK"  , "narrator": "つばめ", "text": "まだ仲良くなった\nばかりなんだし――"},
        { "location": "348/TALK"  , "narrator": "つばめ", "text": "馴れ馴れしいとか\n思われちゃうかも…。"},
        { "location": "350/TALK"  , "narrator": "つばめ", "text": "…どうしよう。"},
        { "location": "394/TALK"  , "narrator": "つばめ", "text": "$handle$さん\nこんにちは。"},
        { "location": "395/TALK"  , "narrator": "つばめ", "text": "わたし、最近\n司書失格ですよね。"},
        { "location": "396/TALK"  , "narrator": "つばめ", "text": "まともに\n役に立ってないです。"},
        { "location": "397/SEL"   , "narrator": "", "text": "ほんとだよ"},
        { "location": "398/SEL"   , "narrator": "", "text": "なんか裏がありそうだし仕方ない"},
        { "location": "399/ACT"   , "narrator": "", "text": "ほんとだよ"},
        { "location": "401/TALK"  , "narrator": "つばめ", "text": "あああっ！\nご、ごめんなさい……。"},
        { "location": "402/TALK"  , "narrator": "つばめ", "text": "わ、わたしがダメでも、\n本体のつばめは\nいい子ですから！"},
        { "location": "403/TALK"  , "narrator": "つばめ", "text": "ですから、どうか\n見捨てないでください…。"},
        { "location": "404/ACT"   , "narrator": "", "text": "なんか裏がありそうだし仕方ない"},
        { "location": "406/TALK"  , "narrator": "つばめ", "text": "あ、ありがとう\nございます！"},
        { "location": "407/TALK"  , "narrator": "つばめ", "text": "$handle$さんが\n優しい人で良かったです。"},
        { "location": "408/TALK"  , "narrator": "つばめ", "text": "でも、今回こそは\nちゃんと役に立てるように\n頑張りますからね！"},
        { "location": "417/TALK"  , "narrator": "つばめ", "text": "オープンプロセス、\n0x231番地から\n0xCFB番地へ。"},
        { "location": "439/TALK"  , "narrator": "つばめ", "text": "シーク完了しました。"},
        { "location": "442/TALK"  , "narrator": "つばめ", "text": "えっとですねー…"},
        { "location": "444/TALK"  , "narrator": "つばめ", "text": "……ああっ！！\n今回は大丈夫です！"},
        { "location": "445/TALK"  , "narrator": "つばめ", "text": "えっとですね！！"},
        { "location": "446/SEL"   , "narrator": "", "text": "神楽の元へ行ってみる勇気を与えればいい？"},
        { "location": "447/ACT"   , "narrator": "", "text": "神楽の元へ行ってみる勇気を与えればいい？"},
        { "location": "449/TALK"  , "narrator": "つばめ", "text": "ああっ……。"},
        { "location": "450/TALK"  , "narrator": "つばめ", "text": "そ、そうですよね。\n見ればわかりますもんね。"},
        { "location": "452/TALK"  , "narrator": "つばめ", "text": "はぁ…。\n今回もまた、役に\n立てませんでしたね。"},
        { "location": "453/SEL"   , "narrator": "", "text": "まあ、そういうことになるね"},
        { "location": "454/SEL"   , "narrator": "", "text": "司書さんは頑張ってるよ、元気出して！"},
        { "location": "455/ACT"   , "narrator": "", "text": "まあ、そういうことになるね"},
        { "location": "456/TALK"  , "narrator": "つばめ", "text": "えへへ……ごめんなさい。"},
        { "location": "457/TALK"  , "narrator": "つばめ", "text": "でも$handle$さん\nわたしのこと、ちゃんと\nわかってるんですね。"},
        { "location": "458/TALK"  , "narrator": "つばめ", "text": "そこまでわたしに\n興味を持ってくれて\nありがとうございます！"},
        { "location": "459/TALK"  , "narrator": "つばめ", "text": "わたしよりよっぽど\nわたしの司書らしいです。"},
        { "location": "460/TALK"  , "narrator": "つばめ", "text": "次回からわたしの代わりに\nつばめの司書を\nやってみませんか？"},
        { "location": "461/SEL"   , "narrator": "", "text": "やってみたい"},
        { "location": "462/SEL"   , "narrator": "", "text": "遠慮します"},
        { "location": "463/ACT"   , "narrator": "", "text": "やってみたい"},
        { "location": "466/TALK"  , "narrator": "つばめ", "text": "ええっ！\nホントにそう思います？"},
        { "location": "467/TALK"  , "narrator": "つばめ", "text": "…とっても退屈ですよ？"},
        { "location": "468/TALK"  , "narrator": "つばめ", "text": "……って、\n当然冗談ですよね。\n真に受けてごめんなさい。"},
        { "location": "469/ACT"   , "narrator": "", "text": "遠慮します"},
        { "location": "471/TALK"  , "narrator": "つばめ", "text": "えへへ……\nそりゃそうですよね。"},
        { "location": "472/TALK"  , "narrator": "つばめ", "text": "とっても退屈ですから、\nやめた方が\nいいと思いますよ。"},
        { "location": "474/ACT"   , "narrator": "", "text": "司書さんは頑張ってるよ、元気出して！"},
        { "location": "475/TALK"  , "narrator": "つばめ", "text": "そうでしょうか…。"},
        { "location": "495/TALK"  , "narrator": "つばめ", "text": "ふわっ…！"},
        { "location": "496/TALK"  , "narrator": "つばめ", "text": "やっぱり\nダメでしたか？"},
        { "location": "499/TALK"  , "narrator": "つばめ", "text": "はあっ…"},
        { "location": "500/TALK"  , "narrator": "つばめ", "text": "えへへ、\nありがとうございます！"},
        { "location": "501/TALK"  , "narrator": "つばめ", "text": "とっても嬉しいです！"},
        { "location": "504/TALK"  , "narrator": "つばめ", "text": "ひあっ！"},
        { "location": "505/TALK"  , "narrator": "つばめ", "text": "これは罰ですか？\nそれともご褒美ですか？"},
        { "location": "508/TALK"  , "narrator": "つばめ", "text": "ひあっ！"},
        { "location": "509/TALK"  , "narrator": "つばめ", "text": "これは罰ですか？\nそれともご褒美ですか？"},
        { "location": "512/TALK"  , "narrator": "つばめ", "text": "ひあっ！"},
        { "location": "513/TALK"  , "narrator": "つばめ", "text": "これは罰ですか？\nそれともご褒美ですか？"},
        { "location": "516/TALK"  , "narrator": "つばめ", "text": "ひあっ！"},
        { "location": "517/TALK"  , "narrator": "つばめ", "text": "これは罰ですか？\nそれともご褒美ですか？"},
        { "location": "521/TALK"  , "narrator": "つばめ", "text": "と、とにかく！\n次こそは頑張りますから\nよろしくお願いします！"},
        { "location": "523/TALK"  , "narrator": "つばめ", "text": "……って、\nなんかちょっと脱線\nしちゃいましたね……。"},
        { "location": "524/TALK"  , "narrator": "つばめ", "text": "わたしのことはともかく、\nつばめのことは、どうか\nよろしくお願いします！"},
        { "location": "525/TALK"  , "narrator": "つばめ", "text": "$handle$さんと\nわたしに、\n素敵なココロの旅を！"},
        { "location": "24/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>6月1日　5:54 PM</color>\n神楽坂トライナリーにて。"},
        { "location": "362/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "481/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "520/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"}
    ]
}
