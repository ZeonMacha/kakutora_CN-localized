{
    "dir": "chap23/daydra/dd_ch04_23_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "23456",
        "cid": "miyabi",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "地元の光景"
    },
    "entry":
    [
        { "location": "174/SCENARIO", "narrator": "", "text": "地元の光景"},
        { "location": "190/TALK"    , "narrator": "ガブリエラ", "text": "あれ？　誰かのタオル、\nあたしのバッグに\n入ってるんだけど？"},
        { "location": "193/TALK"    , "narrator": "つばめ", "text": "あ、それわたしのだ。\nよかったー、失くしたかと\n思ってたよ。"},
        { "location": "194/TALK"    , "narrator": "アーヤ", "text": "あら？　ブラシって\nどこ入れたかしら…。"},
        { "location": "196/TALK"    , "narrator": "神楽", "text": "アーヤさんのブラシなら、\n洗面所にありましたよ。"},
        { "location": "197/TALK"    , "narrator": "神楽", "text": "帰る日にしまうのかと\n思ってました。"},
        { "location": "199/TALK"    , "narrator": "アーヤ", "text": "あ、そうだったわ。"},
        { "location": "204/TALK"    , "narrator": "みやび", "text": "なんや？　もう荷物\nまとめてるが？"},
        { "location": "206/TALK"    , "narrator": "アーヤ", "text": "ええ、当日とか前日に\nバタバタするの嫌だし。"},
        { "location": "208/TALK"    , "narrator": "神楽", "text": "みやびさんは\n用意しなくて\nいいんですか？"},
        { "location": "209/TALK"    , "narrator": "みやび", "text": "うちは身軽で来たき、\n当日の朝にすっとやれば\n問題ないちや。"},
        { "location": "212/TALK"    , "narrator": "つばめ", "text": "すごいなぁ。\n旅慣れてるんですね。"},
        { "location": "213/TALK"    , "narrator": "みやび", "text": "ちゅうか、実家やしね。"},
        { "location": "216/TALK"    , "narrator": "みやび", "text": "…ま、頑張りぃ。\nうちはちくっと外に\n出てくるぞね。"},
        { "location": "218/TALK"    , "narrator": "ガブリエラ", "text": "買い物でも行くの？"},
        { "location": "219/TALK"    , "narrator": "みやび", "text": "いんや、ＰＣの前で\n座りっぱなしで\n身体固まったきね。"},
        { "location": "220/TALK"    , "narrator": "みやび", "text": "ちくっと散歩して\nほぐしてくるがよ。"},
        { "location": "235/TALK"    , "narrator": "みやび", "text": "ふぅ…。"},
        { "location": "236/TALK"    , "narrator": "みやび", "text": "またしばらく、\nここともお別れやなぁ…。"},
        { "location": "237/TALK"    , "narrator": "みやび", "text": "次帰ってくるのは、\n多分一か月後くらいやな。"},
        { "location": "238/TALK"    , "narrator": "みやび", "text": "…けんど、考えてみると\nちくっと早い気もするし…。"},
        { "location": "239/TALK"    , "narrator": "みやび", "text": "だとすると…、秋か冬？"},
        { "location": "241/TALK"    , "narrator": "みやび", "text": "はぁ…今度来るときは、\n超寒くなってるんは\n確実やなぁ。"},
        { "location": "242/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "243/TALK"    , "narrator": "みやび", "text": "…写真でも、\n撮っておくべきか？"},
        { "location": "244/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "245/TALK"    , "narrator": "みやび", "text": "いや、ないない。\nどうせ撮っても\nまず見返さんやろうし。"},
        { "location": "246/TALK"    , "narrator": "みやび", "text": "ちゅうか、アーヤの\n写真好きが移ったか？"},
        { "location": "248/TALK"    , "narrator": "みやび", "text": "…うちらしくない。\nもうちくっと、\n頭冷やして帰るか…。"},
        { "location": "265/TALK"    , "narrator": "みやび", "text": "うちの帰還ぞね～。\nみんなの方は\nひと段落付いた？"},
        { "location": "267/TALK"    , "narrator": "ガブリエラ", "text": "とっくに終わったわよ。\nっていうか、\nどこ行ってたの？"},
        { "location": "268/TALK"    , "narrator": "みやび", "text": "だらだら散歩しちょった\nだけや。"},
        { "location": "271/TALK"    , "narrator": "つばめ", "text": "わたしも\n一緒に行きたかったなぁ。"},
        { "location": "273/TALK"    , "narrator": "神楽", "text": "まだ帰る日までは\n数日ありますし、\nいつでも行けますよ。"},
        { "location": "274/SEL"     , "narrator": "", "text": "写真は撮ったの？"},
        { "location": "276/TALK"    , "narrator": "アーヤ", "text": "私も、帰る前にもう一度\n色々見て回りたいわ。"},
        { "location": "277/TALK"    , "narrator": "ガブリエラ", "text": "その時は声かけて。\nあたしも一緒に行きたい。"},
        { "location": "278/TALK"    , "narrator": "ガブリエラ", "text": "見るのに夢中になってて、\n写真全然撮ってなかった\nのよ…。"},
        { "location": "281/TALK"    , "narrator": "アーヤ", "text": "私が撮ったのあるから、\nデータ渡す？"},
        { "location": "284/TALK"    , "narrator": "ガブリエラ", "text": "それも欲しいけど、\n自分でもちょっとは\n撮りたいのよ。"},
        { "location": "287/TALK"    , "narrator": "みやび", "text": "…みんな、まっこと\n元気やねぇ…。"},
        { "location": "288/TALK"    , "narrator": "みやび", "text": "まあ、うちは散歩して\n疲れたき、部屋でちくっと\n寝てくるがよ。"},
        { "location": "290/ACT"     , "narrator": "", "text": "写真は撮ったの？"},
        { "location": "310/TALK"    , "narrator": "みやび", "text": "地元の写真なんぞ"},
        { "location": "311/TALK"    , "narrator": "みやび", "text": "撮る必要に"},
        { "location": "312/TALK"    , "narrator": "みやび", "text": "第一"},
        { "location": "313/TALK"    , "narrator": "みやび", "text": "最近のカメラは高画質"},
        { "location": "314/TALK"    , "narrator": "みやび", "text": "故にデータサイズがビッグ"},
        { "location": "315/TALK"    , "narrator": "みやび", "text": "うちのスマホの容量は無尽蔵ではない"},
        { "location": "316/TALK"    , "narrator": "みやび", "text": "理解したか？"},
        { "location": "317/TALK"    , "narrator": "みやび", "text": "したと決めつけてさらばだ"},
        { "location": "328/TALK"    , "narrator": "みやび", "text": "…まったく。"},
        { "location": "331/TALK"    , "narrator": "つばめ", "text": "？　何か変なこと\n言われたんですか？"},
        { "location": "333/TALK"    , "narrator": "みやび", "text": "うむ…写真を撮ったか\n聞かれたがよ。"},
        { "location": "335/TALK"    , "narrator": "ガブリエラ", "text": "写真なら、少し前に\nみんなで撮ったじゃない。"},
        { "location": "337/TALK"    , "narrator": "アーヤ", "text": "帰ったらちゃんと\n現像して渡すわね。"},
        { "location": "339/TALK"    , "narrator": "つばめ", "text": "楽しみです！\nね、神楽ちゃん。"},
        { "location": "341/TALK"    , "narrator": "神楽", "text": "あ…はい…。"},
        { "location": "342/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "344/TALK"    , "narrator": "ガブリエラ", "text": "でも、せっかくだから\n今から撮りにいかない？"},
        { "location": "345/TALK"    , "narrator": "みやび", "text": "は？"},
        { "location": "346/TALK"    , "narrator": "ガブリエラ", "text": "いや、あたしとアーヤは\nどうせ写真撮りに行く\nつもりだったし。"},
        { "location": "347/TALK"    , "narrator": "みやび", "text": "何も今日じゃなくても\nえいやろ？"},
        { "location": "348/TALK"    , "narrator": "アーヤ", "text": "…ううん、今がいいわ。"},
        { "location": "351/TALK"    , "narrator": "アーヤ", "text": "もうすぐ夕方だし、\n夕日に染まった海とか\n撮りたいもの。"},
        { "location": "354/TALK"    , "narrator": "みやび", "text": "好きにしぃ。\nうちは待っちょるき、\nみんなだけで――"},
        { "location": "355/TALK"    , "narrator": "アーヤ", "text": "家のすぐ前なんだから、\nみやびも付き合いなさい。"},
        { "location": "356/TALK"    , "narrator": "みやび", "text": "拒否権は？"},
        { "location": "358/TALK"    , "narrator": "ガブリエラ", "text": "使用期間外だから却下。\nほら、行くわよ。"},
        { "location": "361/TALK"    , "narrator": "みやび", "text": "…うちの拒否権、\n使用期間あったんやね…。"},
        { "location": "384/TALK"    , "narrator": "アーヤ", "text": "…やっぱり、\n夕方の海って素敵ね。"},
        { "location": "385/TALK"    , "narrator": "ガブリエラ", "text": "うん…ちょっとだけ\nロマンチックな気持ちに\nなるかも。"},
        { "location": "388/TALK"    , "narrator": "みやび", "text": "よし、ならばチューやな。"},
        { "location": "392/TALK"    , "narrator": "ガブリエラ", "text": "なんで！？"},
        { "location": "394/TALK"    , "narrator": "みやび", "text": "夕日に染まった海を\n見ながら砂浜にいる\nシチュエーションやぞ？"},
        { "location": "395/TALK"    , "narrator": "みやび", "text": "おもいっきしイチャラブ\n雰囲気ＭＡＸやろ。"},
        { "location": "396/TALK"    , "narrator": "つばめ", "text": "ああ、ドラマとかで\nそういうの見たこと\nありますよ。"},
        { "location": "397/TALK"    , "narrator": "みやび", "text": "そうやろ？\nちゅうわけやき、\nチューしぃ。"},
        { "location": "399/TALK"    , "narrator": "神楽", "text": "わかりました。\nでは…。"},
        { "location": "401/TALK"    , "narrator": "つばめ", "text": "って、神楽ちゃん！？"},
        { "location": "403/TALK"    , "narrator": "神楽", "text": "あっ、つばめさん。\nどうして離れちゃうん\nですか？"},
        { "location": "404/TALK"    , "narrator": "つばめ", "text": "だ、だって、もう少しで\nキスしちゃうところ\nだったから…。"},
        { "location": "405/TALK"    , "narrator": "神楽", "text": "しようとしてたんです！"},
        { "location": "406/TALK"    , "narrator": "つばめ", "text": "えぇっ！？"},
        { "location": "408/TALK"    , "narrator": "みやび", "text": "おっ、ノリがえいね卯月。\nキスシーンはうちが\nしっかり撮るぞね。"},
        { "location": "410/TALK"    , "narrator": "神楽", "text": "お願いします。\nさあ、つばめさん！"},
        { "location": "412/TALK"    , "narrator": "つばめ", "text": "ちょ、ダメダメ！\nダメだよ神楽ちゃん！"},
        { "location": "414/TALK"    , "narrator": "ガブリエラ", "text": "はぁ…相変わらず\nなんだから…。"},
        { "location": "415/TALK"    , "narrator": "アーヤ", "text": "ふふっ、いいじゃない。\n二人とも楽しそうなん\nだし。"},
        { "location": "416/TALK"    , "narrator": "ガブリエラ", "text": "見てるこっちとしては\nうるさいだけじゃない。"},
        { "location": "417/TALK"    , "narrator": "みやび", "text": "なんや、ガブちゃんは\nつばめちゃん達が\n羨ましいが？"},
        { "location": "420/TALK"    , "narrator": "ガブリエラ", "text": "そ、そんなこと\n言ってないでしょ！"},
        { "location": "421/TALK"    , "narrator": "みやび", "text": "えいやん、別に。\nアーヤとちくっと\nチューしてみぃ。"},
        { "location": "423/TALK"    , "narrator": "ガブリエラ", "text": "ななななな、\nなんでアーヤなのよ！？"},
        { "location": "424/TALK"    , "narrator": "みやび", "text": "つばめちゃんと卯月の唇は\n埋まっちょるきね。"},
        { "location": "426/TALK"    , "narrator": "みやび", "text": "開いてるんはアーヤの\nしかないやろ？"},
        { "location": "428/TALK"    , "narrator": "アーヤ", "text": "あのね…そういうこと\nするために来たわけじゃ\nないでしょ？"},
        { "location": "430/TALK"    , "narrator": "みやび", "text": "そういうシチュになんやし、\nしてもえいんやないが？"},
        { "location": "431/TALK"    , "narrator": "ガブリエラ", "text": "じゃあ、\nみやびは誰とするのよ？"},
        { "location": "432/TALK"    , "narrator": "みやび", "text": "せんよ。\nうちのファーストキスは\nまだ大切に取っとくきね。"},
        { "location": "433/TALK"    , "narrator": "ガブリエラ", "text": "自分はやらないのに\nあたし達にやらせようと\nしないでよ！"},
        { "location": "434/TALK"    , "narrator": "みやび", "text": "まあまあ、これも大切な\n思い出っちゅうことで…。"},
        { "location": "436/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "442/TALK"    , "narrator": "ガブリエラ", "text": "えっ！？"},
        { "location": "444/TALK"    , "narrator": "アーヤ", "text": "ふふ…、\nいい写真が撮れたわ。"},
        { "location": "446/TALK"    , "narrator": "神楽", "text": "アーヤさん、早過ぎです。\n私、まだつばめさんと\nキスしてませんよ？"},
        { "location": "449/TALK"    , "narrator": "つばめ", "text": "ししし、しないから！\nキスは絶対しません！"},
        { "location": "451/TALK"    , "narrator": "神楽", "text": "えーっ…。"},
        { "location": "453/TALK"    , "narrator": "ガブリエラ", "text": "…今のって、そんないい\nシチュだったの？"},
        { "location": "454/TALK"    , "narrator": "アーヤ", "text": "うん、みんなすごく\n楽しそうに映ってるわ。"},
        { "location": "455/TALK"    , "narrator": "アーヤ", "text": "撮る、って言ってからだと\nこんな自然な一枚は\n撮れないもの。"},
        { "location": "458/TALK"    , "narrator": "みやび", "text": "とほほ、うちが写真係に\nなるつもりやったのに…。"},
        { "location": "459/TALK"    , "narrator": "アーヤ", "text": "ごめんなさい。\nでも、私も少しでも多く\n残しておきたいのよ。"},
        { "location": "460/TALK"    , "narrator": "アーヤ", "text": "またこうやって、\nみんなで来られるとは\n限らないんだし…。"},
        { "location": "463/TALK"    , "narrator": "ガブリエラ", "text": "…そうよね。"},
        { "location": "464/TALK"    , "narrator": "ガブリエラ", "text": "これから、どんなことが\n起きるかもわからないん\nだし…。"},
        { "location": "465/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "473/TALK"    , "narrator": "アーヤ", "text": "…うん。\n素敵な海の写真が\n撮れたわ。"},
        { "location": "475/TALK"    , "narrator": "ガブリエラ", "text": "あたしの方もＯＫよ。\nじゃ、今日はもう\n帰りましょ。"},
        { "location": "476/TALK"    , "narrator": "神楽", "text": "そうですね…。\nそろそろ、真っ暗に\nなりそうですし。"},
        { "location": "479/TALK"    , "narrator": "神楽", "text": "行きましょ、つばめさん。"},
        { "location": "482/TALK"    , "narrator": "つばめ", "text": "うん。"},
        { "location": "491/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "492/TALK"    , "narrator": "みやび", "text": "どんなことが起きるか\nわからん、か…。"},
        { "location": "493/TALK"    , "narrator": "みやび", "text": "うちも、もしかすると\nもう戻ってこれんっちゅう\n可能性も…。"},
        { "location": "494/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "495/TALK"    , "narrator": "みやび", "text": "…見返すつもりも、\n思い出として残そうとも\n思わんけんど――"},
        { "location": "497/TALK"    , "narrator": "みやび", "text": "写真くらい…、\nちくっと撮っておいても\n悪くないか…。"},
        { "location": "189/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>8月29日　 2:18 PM</color>\n合宿中、みやびの実家でのこと"}
    ]
}
