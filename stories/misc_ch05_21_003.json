        { "location": "6771/TALK"    , "narrator": "神楽", "text": "ミスリル"},
        { "location": "6772/TALK"    , "narrator": "神楽", "text": "それは灰色の輝きという名の"},
        { "location": "6773/TALK"    , "narrator": "神楽", "text": "空想の金属"},
        { "location": "6775/SEL"     , "narrator": "", "text": "アルミニウムだって説があるね"},
        { "location": "6776/SEL"     , "narrator": "", "text": "ゲームで見るやつだ！"},
        { "location": "6777/SEL"     , "narrator": "", "text": "モリア銀だね"},
        { "location": "6778/ACT"     , "narrator": "", "text": "アルミニウムだって説があるね"},
        { "location": "6779/TALK"    , "narrator": "神楽", "text": "あーあーあーあーあー"},
        { "location": "6781/TALK"    , "narrator": "神楽", "text": "夢が壊れたー"},
        { "location": "6782/ACT"     , "narrator": "", "text": "ゲームで見るやつだ！"},
        { "location": "6783/TALK"    , "narrator": "神楽", "text": "中世風ファンタジー系だとよく出るやつぴょん"},
        { "location": "6784/ACT"     , "narrator": "", "text": "モリア銀だね"},
        { "location": "6786/TALK"    , "narrator": "神楽", "text": "それだ！！！！"},
        { "location": "6788/TALK"    , "narrator": "神楽", "text": "正統派厨二アイテム！"},
        { "location": "6789/TALK"    , "narrator": "神楽", "text": "未知なる金属萌えるー！"},
        { "location": "6791/TALK"    , "narrator": "神楽", "text": "魔法の素材さえあればは"},
        { "location": "6792/TALK"    , "narrator": "神楽", "text": "魔法のアイテムが作れる人間が思うことなので"},
        { "location": "6793/TALK"    , "narrator": "神楽", "text": "凡人が手に入れても仕方ないんだけどね"}
