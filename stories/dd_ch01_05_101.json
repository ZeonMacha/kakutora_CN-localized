{
    "dir": "chap05/daydra/dd_ch01_05_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "5102",
        "cid": "tsubame",
        "title": "002 メインストーリー",
        "sub_title": "社会生活不適応少女＜前編＞"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "社会生活不適応少女"},
        { "location": "25/TALK"   , "narrator": "つばめ", "text": "わぁ…。"},
        { "location": "28/TALK"   , "narrator": "珠緒先生", "text": "ふふっ、\nそんなに珍しい？"},
        { "location": "30/TALK"   , "narrator": "つばめ", "text": "珍しいっていうか…。"},
        { "location": "31/TALK"   , "narrator": "つばめ", "text": "今までいた学校に比べて、\n倍以上大きくて、なんか\n落ち着かないんです。"},
        { "location": "32/TALK"   , "narrator": "珠緒先生", "text": "そっか、急に転校が\n決まったんだものね。"},
        { "location": "34/TALK"   , "narrator": "つばめ", "text": "はい…だからこの学校の\nことも、まだ全然\n知らないんです。"},
        { "location": "36/TALK"   , "narrator": "珠緒先生", "text": "詳しい話はまほちゃん――"},
        { "location": "38/TALK"   , "narrator": "珠緒先生", "text": "じゃなくて、東雲教官に\n説明してもらってね。"},
        { "location": "40/TALK"   , "narrator": "珠緒先生", "text": "多分、ここの学校のことを\n説明すると、うんと長く\nなると思うから…。"},
        { "location": "42/TALK"   , "narrator": "つばめ", "text": "そうなんですか？"},
        { "location": "43/TALK"   , "narrator": "珠緒先生", "text": "政府機関が建てた\n学校だから、\n色々あるのよ。"},
        { "location": "44/TALK"   , "narrator": "珠緒先生", "text": "とはいっても、普通の\n中高大一貫の学校と\n思ってもらえれば――"},
        { "location": "45/TALK"   , "narrator": "珠緒先生", "text": "とりあえずそれで\n問題はないはずよ。"},
        { "location": "46/TALK"   , "narrator": "つばめ", "text": "はい…。"},
        { "location": "48/TALK"   , "narrator": "珠緒先生", "text": "それで、逢瀬さんは\n『特殊攻撃隊特科』\nだけど――"},
        { "location": "49/TALK"   , "narrator": "珠緒先生", "text": "他にどんな学科があるかは\n知ってる？"},
        { "location": "51/TALK"   , "narrator": "つばめ", "text": "あ、いえ…。"},
        { "location": "53/TALK"   , "narrator": "珠緒先生", "text": "簡単に説明すると、\n『通常攻撃隊特科』という\nものがあるわ。"},
        { "location": "54/TALK"   , "narrator": "珠緒先生", "text": "授業のカリキュラムは、\n通常攻撃隊特科と\n同じと思って構わないわ。"},
        { "location": "55/TALK"   , "narrator": "珠緒先生", "text": "その他にも――"},
        { "location": "57/TALK"   , "narrator": "つばめ", "text": "どうしよう…まさかこんな\n急に転校が決まるなんて\n思わなかったなぁ。"},
        { "location": "58/TALK"   , "narrator": "つばめ", "text": "転校の挨拶、ちゃんと\nできるかな？"},
        { "location": "59/TALK"   , "narrator": "つばめ", "text": "緊張し過ぎて、\nハッキリ喋れるか\n心配だよ…。"},
        { "location": "61/TALK"   , "narrator": "珠緒先生", "text": "――とまあ、簡単だけど\nうちはこんな感じの\n学校なの。"},
        { "location": "62/TALK"   , "narrator": "珠緒先生", "text": "どう？\n理解してもらえたかしら？"},
        { "location": "64/TALK"   , "narrator": "つばめ", "text": "え！？\nあ、はい、大丈夫です！"},
        { "location": "65/TALK"   , "narrator": "珠緒先生", "text": "まあ、日常生活を送る\n面では、普通の学校と\n大差はないから――"},
        { "location": "67/TALK"   , "narrator": "つばめ", "text": "…な、なんか、話が\n飛び過ぎて、付いていけ\nないかも。"},
        { "location": "70/TALK"   , "narrator": "雛", "text": "おーい。"},
        { "location": "71/TALK"   , "narrator": "つばめ", "text": "え？"},
        { "location": "84/TALK"   , "narrator": "つばめ", "text": "うわぁっ！！"},
        { "location": "95/TALK"   , "narrator": "珠緒先生", "text": "あまり緊張しないで、\nのびのびと過ごして\nもらって――"},
        { "location": "96/TALK"   , "narrator": "珠緒先生", "text": "って、あら？\n逢瀬さん？"},
        { "location": "97/TALK"   , "narrator": "珠緒先生", "text": "…もぅ、話の途中で\nいなくなるなんて。"},
        { "location": "98/TALK"   , "narrator": "珠緒先生", "text": "特別攻撃隊特科に所属する\n子達って、集団行動が\n苦手な子ばかりだけど――"},
        { "location": "99/TALK"   , "narrator": "珠緒先生", "text": "まさか、逢瀬さんも\nそうなのかしら？"},
        { "location": "100/TALK"  , "narrator": "珠緒先生", "text": "はぁ…、\n先が思いやられるわ……"},
        { "location": "101/TALK"  , "narrator": "珠緒先生", "text": "って、ダメよ！\nそんなこと考えたら！"},
        { "location": "102/TALK"  , "narrator": "珠緒先生", "text": "私は先生なんだから、\nここはビシッと注意\nしないとダメね！"},
        { "location": "122/TALK"  , "narrator": "雛", "text": "いやー、ごめんねー。\n急に呼び止めたり\nしちゃってー。"},
        { "location": "125/TALK"  , "narrator": "つばめ", "text": "えっ！？\n呼び止めたっていうより、\nあれは、その…。"},
        { "location": "126/TALK"  , "narrator": "繭", "text": "拉致。"},
        { "location": "129/TALK"  , "narrator": "雛", "text": "誰がそんなことを！？"},
        { "location": "132/TALK"  , "narrator": "繭", "text": "おまえだ。"},
        { "location": "133/TALK"  , "narrator": "つばめ", "text": "あ、あのぉ…。\nわたしに、何か用ですか？"},
        { "location": "140/TALK"  , "narrator": "雛", "text": "あっ、そうだった！"},
        { "location": "142/TALK"  , "narrator": "雛", "text": "あなた、新しく特別攻撃隊\n特科に来た生徒でしょ？"},
        { "location": "143/TALK"  , "narrator": "つばめ", "text": "えっ！？"},
        { "location": "144/TALK"  , "narrator": "雛", "text": "あれ？　違った？\n間違ってないよねー？"},
        { "location": "147/TALK"  , "narrator": "つばめ", "text": "え、えと、その…。"},
        { "location": "148/TALK"  , "narrator": "つばめ", "text": "ど、どうしよう…。\nそれって、言っても\nいいことなのかな？"},
        { "location": "149/TALK"  , "narrator": "雛", "text": "…あらら？\nどしたの？"},
        { "location": "151/TALK"  , "narrator": "つばめ", "text": "あ、いえ…。"},
        { "location": "153/TALK"  , "narrator": "繭", "text": "…………ハァ。"},
        { "location": "154/TALK"  , "narrator": "つばめ", "text": "っ！"},
        { "location": "156/TALK"  , "narrator": "つばめ", "text": "どうしよう…。\nわたし、どうしたら\nいいんだろ…。"},
        { "location": "203/TALK"  , "narrator": "つばめ", "text": "こんにちは、\n$handle$さん。\n[ココロゲート]へようこそ。"},
        { "location": "204/TALK"  , "narrator": "つばめ", "text": "どうやらまたココロに\nロックがかかって\nしまったみたいですね。"},
        { "location": "205/TALK"  , "narrator": "つばめ", "text": "早速その【問題の扉】を\nコールします！"},
        { "location": "212/TALK"  , "narrator": "つばめ", "text": "オープンプロセス、\n0x663番地から\n0x8EF番地へ。"},
        { "location": "227/TALK"  , "narrator": "つばめ", "text": "シーク完了しました。"},
        { "location": "228/TALK"  , "narrator": "つばめ", "text": "今回もここに、\n躊躇の根源になっている\n<color=red>【[クラン]】</color>がいます。"},
        { "location": "230/TALK"  , "narrator": "つばめ", "text": "ココロファイルナンバー\n01-258-39によれば、\n今回の躊躇の原因は……"},
        { "location": "231/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "232/TALK"  , "narrator": "つばめ", "text": "………。"},
        { "location": "233/TALK"  , "narrator": "つばめ", "text": "あー、なるほど。"},
        { "location": "234/SEL"   , "narrator": "", "text": "なに？"},
        { "location": "235/ACT"   , "narrator": "", "text": "なに？"},
        { "location": "237/TALK"  , "narrator": "つばめ", "text": "いえ。どうもわたし、\n過去に何度か友達関係で\n問題があったようで……。"},
        { "location": "238/TALK"  , "narrator": "つばめ", "text": "そのトラウマが無意識に\n作用して、先へ進めない\nみたいですね。"},
        { "location": "239/SEL"   , "narrator": "", "text": "何があったの？"},
        { "location": "240/ACT"   , "narrator": "", "text": "何があったの？"},
        { "location": "242/TALK"  , "narrator": "つばめ", "text": "簡単に言えば、自分に\n心当たりが無いのに、\n嫌われちゃったとか――"},
        { "location": "243/TALK"  , "narrator": "つばめ", "text": "次の日から突然\n無視されるように\nなっちゃったとかですね。"},
        { "location": "244/SEL"   , "narrator": "", "text": "なるほど"},
        { "location": "245/ACT"   , "narrator": "", "text": "なるほど"},
        { "location": "247/TALK"  , "narrator": "つばめ", "text": "まあ、わたし総体としては\n今回の件は全然問題ないと\n思ってるんですけど。"},
        { "location": "248/TALK"  , "narrator": "つばめ", "text": "でも、[クラン]が出ちゃうと\nその判断すらできなく\nなっちゃうんですよね。"},
        { "location": "249/TALK"  , "narrator": "つばめ", "text": "というわけで、今回も\nよろしくお願いします！"},
        { "location": "250/SEL"   , "narrator": "", "text": "頑張るよ"},
        { "location": "251/ACT"   , "narrator": "", "text": "頑張るよ"},
        { "location": "253/TALK"  , "narrator": "つばめ", "text": "ありがとうございます！"},
        { "location": "255/TALK"  , "narrator": "つばめ", "text": "$handle$さんと\nわたしに、\n素敵なココロの旅を！"},
        { "location": "24/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>5月9日　0:06 PM</color>\nWAVE戦前、附属学園中庭。"},
        { "location": "169/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"}
    ]
}
