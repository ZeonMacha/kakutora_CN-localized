{
    "dir": "chap15/daydra/dd_ch03_15_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "15356",
        "cid": "gabriella",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "展覧会"
    },
    "entry":
    [
        { "location": "267/SCENARIO", "narrator": "", "text": "展覧会"},
        { "location": "279/TALK"    , "narrator": "ガブリエラ", "text": "…マズいわ。\n道に迷ったかも。"},
        { "location": "291/TALK"    , "narrator": "ガブリエラ", "text": "$marzanna$、私が今いる位置ってわかる？"},
        { "location": "293/SEL"     , "narrator": "", "text": "受信できないからわからない"},
        { "location": "294/ACT"     , "narrator": "", "text": "受信できないからわからない"},
        { "location": "296/TALK"    , "narrator": "ガブリエラ", "text": "うそっ！？　どうしよう…"},
        { "location": "297/TALK"    , "narrator": "ガブリエラ", "text": "何とかならない？"},
        { "location": "298/TALK"    , "narrator": "ガブリエラ", "text": "このあたりって慣れてないから、どこに何があるのかよくわからないの"},
        { "location": "300/SEL"     , "narrator": "", "text": "健闘を祈ってるよ"},
        { "location": "301/ACT"     , "narrator": "", "text": "健闘を祈ってるよ"},
        { "location": "303/TALK"    , "narrator": "ガブリエラ", "text": "もぉ、肝心な時に役立たずなんだから！"},
        { "location": "316/TALK"    , "narrator": "ガブリエラ", "text": "はぁ…どうしよう？"},
        { "location": "320/TALK"    , "narrator": "繭", "text": "ガブリエラ。"},
        { "location": "322/TALK"    , "narrator": "ガブリエラ", "text": "えっ…繭！？"},
        { "location": "323/TALK"    , "narrator": "繭", "text": "やっぱり…見覚えのある\n後姿だったから、\nもしやと思ったけど――"},
        { "location": "324/TALK"    , "narrator": "ガブリエラ", "text": "あんた、\nここで何してるの？"},
        { "location": "326/TALK"    , "narrator": "繭", "text": "バイト…っ！"},
        { "location": "328/TALK"    , "narrator": "ガブリエラ", "text": "？"},
        { "location": "331/TALK"    , "narrator": "繭", "text": "…何でもない。\nガブリエラこそ、\nここで何をしてるの？"},
        { "location": "332/TALK"    , "narrator": "ガブリエラ", "text": "何って、えっと…。"},
        { "location": "334/TALK"    , "narrator": "繭", "text": "…迷子？"},
        { "location": "337/TALK"    , "narrator": "ガブリエラ", "text": "ち、違うわ！\n今やってる浮世絵展に\n行くところよ。"},
        { "location": "338/TALK"    , "narrator": "繭", "text": "ああ…一丁目の方で\nやってる、あれね。"},
        { "location": "339/TALK"    , "narrator": "ガブリエラ", "text": "知ってるの？"},
        { "location": "340/TALK"    , "narrator": "繭", "text": "駅前にポスターが\n貼ってあったし…。"},
        { "location": "341/TALK"    , "narrator": "繭", "text": "っていうか、\nこっちは５丁目だから、\n全然方向が違う。"},
        { "location": "343/TALK"    , "narrator": "ガブリエラ", "text": "ご、５丁目？\nそれって、えっと…。"},
        { "location": "344/TALK"    , "narrator": "繭", "text": "…………。"},
        { "location": "345/TALK"    , "narrator": "繭", "text": "こっちよ。"},
        { "location": "349/TALK"    , "narrator": "ガブリエラ", "text": "あっ…"},
        { "location": "351/TALK"    , "narrator": "ガブリエラ", "text": "…もぅ、大きな街って\nわかりにくいのよ…。"},
        { "location": "363/TALK"    , "narrator": "繭", "text": "…ここよ。"},
        { "location": "365/TALK"    , "narrator": "ガブリエラ", "text": "良かった…。\n一時はどうなるかと\n思ったわ。"},
        { "location": "367/TALK"    , "narrator": "繭", "text": "今度からは、降りる出口と\n地図をしっかり確認した\n方が良い。"},
        { "location": "368/TALK"    , "narrator": "繭", "text": "南口とかに出てたら、\n確実に遭難してた。"},
        { "location": "370/TALK"    , "narrator": "ガブリエラ", "text": "大袈裟なんだから…。\nでも、助かったわ。"},
        { "location": "371/TALK"    , "narrator": "繭", "text": "…じゃあ、私は行くから。\nまた学校で。"},
        { "location": "373/TALK"    , "narrator": "ガブリエラ", "text": "うん…ありがと。"},
        { "location": "377/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "378/TALK"    , "narrator": "ガブリエラ", "text": "そういえば、繭がどんな\nバイトしてるのか、\n誰も知らないんだっけ？"},
        { "location": "379/SEL"     , "narrator": "", "text": "それは繭に失礼だよ"},
        { "location": "380/SEL"     , "narrator": "", "text": "一定の距離を空けるんだよ"},
        { "location": "381/TALK"    , "narrator": "ガブリエラ", "text": "…後をつけてみよう\nかしら？"},
        { "location": "382/TALK"    , "narrator": "ガブリエラ", "text": "繭のバイトを知る\nチャンスなんだし。"},
        { "location": "385/TALK"    , "narrator": "ガブリエラ", "text": "…って、ダメよね。"},
        { "location": "386/TALK"    , "narrator": "ガブリエラ", "text": "助けてもらったのに、\n恩を仇で返すような\n真似、失礼だもの。"},
        { "location": "389/TALK"    , "narrator": "ガブリエラ", "text": "…浮世絵見て忘れよう。"},
        { "location": "391/ACT"     , "narrator": "", "text": "それは繭に失礼だよ"},
        { "location": "409/TALK"    , "narrator": "ガブリエラ", "text": "わ、わかってるわ"},
        { "location": "410/TALK"    , "narrator": "ガブリエラ", "text": "っていうか、どうして私の考えてることわかったの？"},
        { "location": "411/TALK"    , "narrator": "ガブリエラ", "text": "$marzanna$は鋭いわね"},
        { "location": "423/TALK"    , "narrator": "ガブリエラ", "text": "…でも、繭のおかげで\n道に迷わずに済んだん\nだから――"},
        { "location": "424/TALK"    , "narrator": "ガブリエラ", "text": "恩を仇で返すようなこと、\nしたらいけないわね。"},
        { "location": "427/TALK"    , "narrator": "ガブリエラ", "text": "…浮世絵見て忘れよう。"},
        { "location": "428/ACT"     , "narrator": "", "text": "一定の距離を空けるんだよ"},
        { "location": "447/TALK"    , "narrator": "ガブリエラ", "text": "任せて"},
        { "location": "448/TALK"    , "narrator": "ガブリエラ", "text": "気配を悟られないようにするのは、狙撃の基本よ"},
        { "location": "449/TALK"    , "narrator": "ガブリエラ", "text": "もちろん、撃つわけじゃないけど"},
        { "location": "461/TALK"    , "narrator": "ガブリエラ", "text": "ふふっ、なんだか\n探偵になったみたい…。"},
        { "location": "462/TALK"    , "narrator": "ガブリエラ", "text": "よし、尾行開始！"},
        { "location": "474/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "475/TALK"    , "narrator": "ガブリエラ", "text": "そろそろ到着しても\nいいころだと思うけど、\nまだなのかしら？"},
        { "location": "477/TALK"    , "narrator": "ガブリエラ", "text": "っていうか、この辺って\nどこも繭が働きそうな\n店がないんだけど…。"},
        { "location": "479/TALK"    , "narrator": "ガブリエラ", "text": "カラオケ、ブティック、\nバーガーショップ、\nネットカフェ――"},
        { "location": "481/TALK"    , "narrator": "ガブリエラ", "text": "メガネ屋、メイドサロン、\n電気屋に大型レコード店、\nあとはコンビニ？"},
        { "location": "482/TALK"    , "narrator": "ガブリエラ", "text": "…もしかして、バイトまで\n時間潰す気とか？"},
        { "location": "485/TALK"    , "narrator": "ガブリエラ", "text": "…あっ、しまった！"},
        { "location": "488/TALK"    , "narrator": "ガブリエラ", "text": "うそ…\nあたしが見失うなんて…。"},
        { "location": "489/TALK"    , "narrator": "ガブリエラ", "text": "数秒前までここにいた、\nってことは、どこかお店に\n入った――"},
        { "location": "491/TALK"    , "narrator": "ガブリエラ", "text": "ってわけでもなさそう。\nまさか、本当にただ\n見失っただけ？"},
        { "location": "493/TALK"    , "narrator": "ガブリエラ", "text": "…勘が鈍ったのかしら？\nやっぱり、毎日銃に\n触れないからなぁ…。"},
        { "location": "495/TALK"    , "narrator": "ガブリエラ", "text": "はぁ…もういいや。\n浮世絵見に行こう。"},
        { "location": "501/TALK"    , "narrator": "繭", "text": "…諦めたかしら？"},
        { "location": "502/TALK"    , "narrator": "繭", "text": "バカ、間抜け、私。\nバカ正直にバイトとか\n言うなんて…。"},
        { "location": "503/TALK"    , "narrator": "繭", "text": "今まで必死に隠してた\n努力が無駄になるところ\nだったわ。"},
        { "location": "504/TALK"    , "narrator": "繭", "text": "…一応、店にはもう少し\n歩いてから行った方が\nいいかも。"},
        { "location": "506/TALK"    , "narrator": "繭", "text": "…めんどくさ。"},
        { "location": "277/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>7月10日　1:41 PM</color>\nとある初夏の休日、某大型駅にて。"},
        { "location": "517/DIALOG"  , "narrator": "Dialog_GEThimegoto_ch03", "text": "【白昼夢の迷宮】"}
    ]
}
