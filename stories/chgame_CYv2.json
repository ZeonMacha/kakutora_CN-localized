    "entry":
    [
        { "location": "1839/SCENARIO", "narrator": "", "text": "CY敵（ガブちゃん）"},
        { "location": "1851/TALK"    , "narrator": "千羽鶴", "text": "かつてここには\n宝箱があった。"},
        { "location": "1852/SEL"     , "narrator": "", "text": "かわいいミミックのこと？"},
        { "location": "1853/ACT"     , "narrator": "", "text": "かわいいミミックのこと？"},
        { "location": "1856/TALK"    , "narrator": "千羽鶴", "text": "そう！\nかわいいミミック――"},
        { "location": "1857/TALK"    , "narrator": "千羽鶴", "text": "……。"},
        { "location": "1859/TALK"    , "narrator": "千羽鶴", "text": "可愛かったら\nミミックにならない。"},
        { "location": "1860/TALK"    , "narrator": "千羽鶴", "text": "そう。\nミミックにガブリエラは\nミスキャストだった。"},
        { "location": "1861/TALK"    , "narrator": "千羽鶴", "text": "そこは反省。"},
        { "location": "1862/TALK"    , "narrator": "千羽鶴", "text": "でも仕方ないの！\nだって――"},
        { "location": "1865/TALK"    , "narrator": "千羽鶴", "text": "宝箱の中に入りそうなの\nガブリエラしか\nいなかったし！！"},
        { "location": "1866/SEL"     , "narrator": "", "text": "それ、ガブリエラが聞いたら怒るよ…？"},
        { "location": "1867/ACT"     , "narrator": "", "text": "それ、ガブリエラが聞いたら怒るよ…？"},
        { "location": "1869/TALK"    , "narrator": "千羽鶴", "text": "今はいない。よって\n聞かれることはない。"},
        { "location": "1870/TALK"    , "narrator": "千羽鶴", "text": "結論、怒られない！"},
        { "location": "1871/TALK"    , "narrator": "千羽鶴", "text": "我ながら完璧……。"}
    ]
}
