        "title": "らぶとーく 第39話",
        "sub_title": "恋のかけらというやつぞね"
    },
    "entry":
    [
        { "location": "1414/SCENARIO", "narrator": "", "text": "290_恋のかけらというやつぞね"},
        { "location": "1439/TALK"    , "narrator": "みやび", "text": "持っとるだろ"},
        { "location": "1440/TALK"    , "narrator": "みやび", "text": "出してみい"},
        { "location": "1441/TALK"    , "narrator": "みやび", "text": "$handle$よ"},
        { "location": "1443/SEL"     , "narrator": "", "text": "はいどうぞ"},
        { "location": "1444/SEL"     , "narrator": "", "text": "好きなだけ持ってって"},
        { "location": "1445/SEL"     , "narrator": "", "text": "えっと、何を？"},
        { "location": "1446/ACT"     , "narrator": "", "text": "はいどうぞ"},
        { "location": "1447/TALK"    , "narrator": "みやび", "text": "って"},
        { "location": "1448/TALK"    , "narrator": "みやび", "text": "何がじゃ"},
        { "location": "1449/TALK"    , "narrator": "みやび", "text": "適当なことを"},
        { "location": "1450/ACT"     , "narrator": "", "text": "好きなだけ持ってって"},
        { "location": "1451/TALK"    , "narrator": "みやび", "text": "おう"},
        { "location": "1453/TALK"    , "narrator": "みやび", "text": "そうするか"},
        { "location": "1454/TALK"    , "narrator": "みやび", "text": "今度な"},
        { "location": "1455/ACT"     , "narrator": "", "text": "えっと、何を？"},
        { "location": "1465/TALK"    , "narrator": "みやび", "text": "何をって"},
        { "location": "1467/TALK"    , "narrator": "みやび", "text": "決まっておる"},
        { "location": "1468/TALK"    , "narrator": "みやび", "text": "恋のかけらだ"},
        { "location": "1470/SEL"     , "narrator": "", "text": "あー、あれかー"},
        { "location": "1471/SEL"     , "narrator": "", "text": "錬成中につきお待ちください"},
        { "location": "1472/SEL"     , "narrator": "", "text": "かけらどころか大岩"},
        { "location": "1473/ACT"     , "narrator": "", "text": "あー、あれかー"},
        { "location": "1474/TALK"    , "narrator": "みやび", "text": "そうそう"},
        { "location": "1475/TALK"    , "narrator": "みやび", "text": "あれだあれ"},
        { "location": "1476/TALK"    , "narrator": "みやび", "text": "ってまた"},
        { "location": "1477/TALK"    , "narrator": "みやび", "text": "適当なことを"},
        { "location": "1478/TALK"    , "narrator": "みやび", "text": "許さんぞ"},
        { "location": "1479/ACT"     , "narrator": "", "text": "錬成中につきお待ちください"},
        { "location": "1480/TALK"    , "narrator": "みやび", "text": "ふむ"},
        { "location": "1481/TALK"    , "narrator": "みやび", "text": "では出直そう"},
        { "location": "1482/TALK"    , "narrator": "みやび", "text": "さらばだ"},
        { "location": "1485/ACT"     , "narrator": "", "text": "かけらどころか大岩"},
        { "location": "1495/TALK"    , "narrator": "みやび", "text": "それはそれは"},
        { "location": "1496/TALK"    , "narrator": "みやび", "text": "で"},
        { "location": "1497/TALK"    , "narrator": "みやび", "text": "大きさは？"},
        { "location": "1500/SEL"     , "narrator": "", "text": "考えてなかった"},
        { "location": "1501/SEL"     , "narrator": "", "text": "東京ドーム約９個分"},
        { "location": "1502/SEL"     , "narrator": "", "text": "２メートルくらいかな"},
        { "location": "1503/SEL"     , "narrator": "", "text": "千カラットだよ！"},
        { "location": "1504/ACT"     , "narrator": "", "text": "考えてなかった"},
        { "location": "1505/TALK"    , "narrator": "みやび", "text": "詰めがが甘いの"},
        { "location": "1506/TALK"    , "narrator": "みやび", "text": "が"},
        { "location": "1507/TALK"    , "narrator": "みやび", "text": "正直でよろしい"},
        { "location": "1510/ACT"     , "narrator": "", "text": "東京ドーム約９個分"},
        { "location": "1511/TALK"    , "narrator": "みやび", "text": "ほほう"},
        { "location": "1512/TALK"    , "narrator": "みやび", "text": "大岩どころか"},
        { "location": "1514/TALK"    , "narrator": "みやび", "text": "山じゃろうそれは"},
        { "location": "1515/ACT"     , "narrator": "", "text": "２メートルくらいかな"},
        { "location": "1516/TALK"    , "narrator": "みやび", "text": "これはまた微妙な大きさ"},
        { "location": "1517/TALK"    , "narrator": "みやび", "text": "まあ"},
        { "location": "1518/TALK"    , "narrator": "みやび", "text": "どちらにしてもいらんがな"},
        { "location": "1519/ACT"     , "narrator": "", "text": "千カラットだよ！"},
        { "location": "1520/TALK"    , "narrator": "みやび", "text": "高そうな石の単位が来たの"},
        { "location": "1521/TALK"    , "narrator": "みやび", "text": "これはなかなか"},
        { "location": "1523/TALK"    , "narrator": "みやび", "text": "期待できそうぞね"},
        { "location": "1525/TALK"    , "narrator": "みやび", "text": "$handle$が持っておるくらいだから"},
        { "location": "1527/TALK"    , "narrator": "みやび", "text": "あっと驚く仕掛けがあろう"},
        { "location": "1529/SEL"     , "narrator": "", "text": "空を飛ぶ"},
        { "location": "1530/SEL"     , "narrator": "", "text": "光るくらいだよ"},
        { "location": "1531/SEL"     , "narrator": "", "text": "森羅万象を見渡せる"},
        { "location": "1532/ACT"     , "narrator": "", "text": "空を飛ぶ"},
        { "location": "1533/TALK"    , "narrator": "みやび", "text": "さすがに"},
        { "location": "1534/TALK"    , "narrator": "みやび", "text": "物理法則を無視しすぎぞね"},
        { "location": "1535/ACT"     , "narrator": "", "text": "光るくらいだよ"},
        { "location": "1536/TALK"    , "narrator": "みやび", "text": "謙虚な姿勢"},
        { "location": "1538/TALK"    , "narrator": "みやび", "text": "ここで必要かのう"},
        { "location": "1539/ACT"     , "narrator": "", "text": "森羅万象を見渡せる"},
        { "location": "1540/TALK"    , "narrator": "みやび", "text": "そうなると"},
        { "location": "1541/TALK"    , "narrator": "みやび", "text": "全く違う話になってしまうが"},
        { "location": "1543/TALK"    , "narrator": "みやび", "text": "ところで結局"},
        { "location": "1544/TALK"    , "narrator": "みやび", "text": "恋とは何ぞね"},
        { "location": "1546/SEL"     , "narrator": "", "text": "$handle$とみやびの間にあるもの"},
        { "location": "1547/SEL"     , "narrator": "", "text": "愛に続く坂道の途中にあるもの"},
        { "location": "1548/SEL"     , "narrator": "", "text": "それをこれから探すのさ"},
        { "location": "1549/ACT"     , "narrator": "", "text": "$handle$とみやびの間にあるもの"},
        { "location": "1550/TALK"    , "narrator": "みやび", "text": "模範的回答だの"},
        { "location": "1551/ACT"     , "narrator": "", "text": "愛に続く坂道の途中にあるもの"},
        { "location": "1552/TALK"    , "narrator": "みやび", "text": "詩的な表現というやつか"},
        { "location": "1553/ACT"     , "narrator": "", "text": "それをこれから探すのさ"},
        { "location": "1554/TALK"    , "narrator": "みやび", "text": "さまよい人だの"},
        { "location": "1556/TALK"    , "narrator": "みやび", "text": "それでこそ"},
        { "location": "1557/TALK"    , "narrator": "みやび", "text": "うちの恋人"},
        { "location": "1558/TALK"    , "narrator": "みやび", "text": "うちの彼氏"},
        { "location": "1559/TALK"    , "narrator": "みやび", "text": "相棒ぞね"},
        { "location": "1461/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>800pt.</b></color></size>\nアップしました！"},
        { "location": "1491/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>800pt.</b></color></size>\nアップしました！"}
    ]
}
