    "entry":
    [
        { "location": "8/SCENARIO", "narrator": "", "text": "松代大本営"},
        { "location": "38/TALK"   , "narrator": "アーヤ", "text": "すみません、\n館長に運転\nさせてしまって。"},
        { "location": "39/TALK"   , "narrator": "透明真幌", "text": "いや、気にするな。"},
        { "location": "41/TALK"   , "narrator": "ガブリエラ", "text": "で？\n何て名前だったっけ？"},
        { "location": "42/TALK"   , "narrator": "みやび", "text": "エヴェレット脳科学研究所\nJapanSite。"},
        { "location": "43/TALK"   , "narrator": "みやび", "text": "まっさか日本にも\n研究所が\nあったとはねえ。"},
        { "location": "44/TALK"   , "narrator": "透明真幌", "text": "実質はエリカ一人の\nためのラボだ。"},
        { "location": "45/TALK"   , "narrator": "透明真幌", "text": "それだけ重要な\n研究に携わって\nいたんだよ。"},
        { "location": "46/TALK"   , "narrator": "アーヤ", "text": "…………。"},
        { "location": "48/TALK"   , "narrator": "透明真幌", "text": "アーヤが場所を\n知らないのも\n無理はない。"},
        { "location": "49/TALK"   , "narrator": "透明真幌", "text": "一般人には\n秘匿された\n施設だからな。"},
        { "location": "50/TALK"   , "narrator": "ガブリエラ", "text": "姉妹でも言えない\n機密情報なのね…。"},
        { "location": "51/TALK"   , "narrator": "みやび", "text": "国同士が関わるような\n研究なら当たり前ぞね。"},
        { "location": "53/TALK"   , "narrator": "みやび", "text": "むしろうちらが\nのこのこ行っても\n大丈夫なんですか？"},
        { "location": "54/TALK"   , "narrator": "透明真幌", "text": "……関係者というか\n当事者だからな。"},
        { "location": "55/TALK"   , "narrator": "透明真幌", "text": "特にアーヤ。\nアーヤではないと\nできないことがある。"},
        { "location": "57/TALK"   , "narrator": "アーヤ", "text": "私でないと\nできないこと？"},
        { "location": "58/TALK"   , "narrator": "透明真幌", "text": "そう。"},
        { "location": "59/TALK"   , "narrator": "透明真幌", "text": "そしてそれが松代に\n来た目的だ。"},
        { "location": "60/SEL"    , "narrator": "", "text": "アーヤ"},
        { "location": "61/ACT"    , "narrator": "", "text": "アーヤ"},
        { "location": "79/TALK"   , "narrator": "アーヤ", "text": "何？"},
        { "location": "82/SEL"    , "narrator": "", "text": "自分自身を信じて"},
        { "location": "83/SEL"    , "narrator": "", "text": "$me$はアーヤを応援する"},
        { "location": "84/SEL"    , "narrator": "", "text": "いつも通りやれば大丈夫だよ"},
        { "location": "85/ACT"    , "narrator": "", "text": "自分自身を信じて"},
        { "location": "86/TALK"   , "narrator": "アーヤ", "text": "何なの急に"},
        { "location": "87/ACT"    , "narrator": "", "text": "$me$はアーヤを応援する"},
        { "location": "88/TALK"   , "narrator": "アーヤ", "text": "ありがとう？"},
        { "location": "89/ACT"    , "narrator": "", "text": "いつも通りやれば大丈夫だよ"},
        { "location": "90/TALK"   , "narrator": "アーヤ", "text": "えと"},
        { "location": "92/TALK"   , "narrator": "アーヤ", "text": "何の話？"},
        { "location": "94/SEL"    , "narrator": "", "text": "これから起こること"},
        { "location": "95/SEL"    , "narrator": "", "text": "頼まれごとについて"},
        { "location": "96/SEL"    , "narrator": "", "text": "この世界の再生に向けた行動"},
        { "location": "97/ACT"    , "narrator": "", "text": "これから起こること"},
        { "location": "98/TALK"   , "narrator": "アーヤ", "text": "そうなの？"},
        { "location": "99/ACT"    , "narrator": "", "text": "頼まれごとについて"},
        { "location": "100/TALK"  , "narrator": "アーヤ", "text": "館長の話ね"},
        { "location": "101/ACT"   , "narrator": "", "text": "この世界の再生に向けた行動"},
        { "location": "103/TALK"  , "narrator": "アーヤ", "text": "そんな大きい話"},
        { "location": "104/TALK"  , "narrator": "アーヤ", "text": "なわけね"},
        { "location": "106/TALK"  , "narrator": "アーヤ", "text": "がんばるわ"},
        { "location": "118/TALK"  , "narrator": "透明真幌", "text": "着いたぞ。"},
        { "location": "152/TALK"  , "narrator": "アーヤ", "text": "ここが……。"},
        { "location": "154/TALK"  , "narrator": "ガブリエラ", "text": "洞窟の中に\nこんなに大きい\n施設を作るなんて…。"},
        { "location": "157/TALK"  , "narrator": "みやび", "text": "いかにも秘密基地、\nちゅう雰囲気ぞね。\n気に入った。"},
        { "location": "160/TALK"  , "narrator": "ガブリエラ", "text": "そこなの？"},
        { "location": "162/TALK"  , "narrator": "みやび", "text": "これがお城やったら\nガブちゃんは大喜び\nしたろう？"},
        { "location": "166/TALK"  , "narrator": "ガブリエラ", "text": "…まあちょっと\n格好いいかもね…。"},
        { "location": "168/TALK"  , "narrator": "アーヤ", "text": "…。"},
        { "location": "169/TALK"  , "narrator": "真幌", "text": "アーヤ。"},
        { "location": "172/TALK"  , "narrator": "アーヤ", "text": "あ、はい！"},
        { "location": "173/TALK"  , "narrator": "真幌", "text": "アーヤにはこれから\n精神世界に\nダイブしてもらう。"},
        { "location": "175/TALK"  , "narrator": "アーヤ", "text": "え？"},
        { "location": "177/TALK"  , "narrator": "ガブリエラ", "text": "どういう意味？"},
        { "location": "180/TALK"  , "narrator": "みやび", "text": "…そうきたかね。"},
        { "location": "181/TALK"  , "narrator": "真幌", "text": "この研究所で\nしていたことの\n予測は付いてるだろう。"},
        { "location": "182/TALK"  , "narrator": "真幌", "text": "クランとフェノメノン。\nそしてトライガジェット。"},
        { "location": "183/TALK"  , "narrator": "真幌", "text": "エリカはそういった\n研究をしていた。"},
        { "location": "184/TALK"  , "narrator": "真幌", "text": "そして今回、\n音羽を再生するため\n必要なものがここにある。"},
        { "location": "185/TALK"  , "narrator": "真幌", "text": "そのキーになるのが\nアーヤなんだ。"},
        { "location": "186/TALK"  , "narrator": "アーヤ", "text": "私…？"},
        { "location": "187/TALK"  , "narrator": "真幌", "text": "そう。"},
        { "location": "188/TALK"  , "narrator": "真幌", "text": "音羽の精神世界に\nダイブして音羽を\n修復する。"},
        { "location": "189/TALK"  , "narrator": "真幌", "text": "そのための設備が\nこの更に下にある巨大な\nサイクロトロンだ。"},
        { "location": "190/TALK"  , "narrator": "真幌", "text": "そしてサイクロトロンを\n動かすことは\nアーヤにしかできない。"},
        { "location": "192/TALK"  , "narrator": "アーヤ", "text": "…ええと？\n私ここに来たことすら\nないですし……。"},
        { "location": "193/TALK"  , "narrator": "真幌", "text": "サイクロトロンには\n一種の生体認証が\n使われていてな。"},
        { "location": "194/TALK"  , "narrator": "真幌", "text": "その条件に合うのが\nアーヤなんだ。"},
        { "location": "197/TALK"  , "narrator": "アーヤ", "text": "…なんで…。"},
        { "location": "200/TALK"  , "narrator": "ガブリエラ", "text": "お姉さんが\nアーヤを信用してたって\nことじゃない？"},
        { "location": "203/TALK"  , "narrator": "みやび", "text": "誰がスパイか\nわかったもんじゃ\nないきね。"},
        { "location": "204/TALK"  , "narrator": "みやび", "text": "けんど、使えるのが\n自分だけとなると\n万が一に対応できん。"},
        { "location": "205/TALK"  , "narrator": "みやび", "text": "やき、一番信用できる\n人間に権限を\n与えておいた。"},
        { "location": "206/TALK"  , "narrator": "みやび", "text": "ちうことやと\n思うけんど。"},
        { "location": "207/TALK"  , "narrator": "アーヤ", "text": "……。"},
        { "location": "208/TALK"  , "narrator": "真幌", "text": "やってくれるか？"},
        { "location": "209/SEL"   , "narrator": "", "text": "アーヤならできるよ"},
        { "location": "210/ACT"   , "narrator": "", "text": "アーヤならできるよ"},
        { "location": "227/TALK"  , "narrator": "アーヤ", "text": "そんなこと言われても"},
        { "location": "229/SEL"   , "narrator": "", "text": "大丈夫だって"},
        { "location": "230/SEL"   , "narrator": "", "text": "$me$がついてる"},
        { "location": "231/SEL"   , "narrator": "", "text": "アーヤにしかできないことだよ"},
        { "location": "232/ACT"   , "narrator": "", "text": "大丈夫だって"},
        { "location": "233/TALK"  , "narrator": "アーヤ", "text": "簡単に言わないで"},
        { "location": "234/ACT"   , "narrator": "", "text": "$me$がついてる"},
        { "location": "235/TALK"  , "narrator": "アーヤ", "text": "そうね"},
        { "location": "236/TALK"  , "narrator": "アーヤ", "text": "そうだけど、、、"},
        { "location": "237/ACT"   , "narrator": "", "text": "アーヤにしかできないことだよ"},
        { "location": "238/TALK"  , "narrator": "アーヤ", "text": "そうだけど、、、"},
        { "location": "252/TALK"  , "narrator": "みやび", "text": "まほさん。"},
        { "location": "254/TALK"  , "narrator": "真幌", "text": "ん？\n何だ？"},
        { "location": "255/TALK"  , "narrator": "みやび", "text": "アーヤがダイブ\nした時なんですけど。"},
        { "location": "256/TALK"  , "narrator": "みやび", "text": "こちらでモニターする\n方法はありますか？"},
        { "location": "257/TALK"  , "narrator": "みやび", "text": "アーヤが何をしているか\n危険なことはないか\nそういったことを。"},
        { "location": "258/TALK"  , "narrator": "真幌", "text": "…生体反応については\nあるはずだが……。"},
        { "location": "259/TALK"  , "narrator": "真幌", "text": "その先となると…。"},
        { "location": "260/TALK"  , "narrator": "アーヤ", "text": "何なの…。"},
        { "location": "261/TALK"  , "narrator": "アーヤ", "text": "突然言われても\nどうすればいいのか\nわからないし……。"},
        { "location": "263/TALK"  , "narrator": "アーヤ", "text": "それにやっぱり\nちょっと怖い…。"},
        { "location": "264/SEL"   , "narrator": "", "text": "$me$も一緒に行くよ"},
        { "location": "265/ACT"   , "narrator": "", "text": "$me$も一緒に行くよ"},
        { "location": "282/TALK"  , "narrator": "アーヤ", "text": "そんなことできるの？"},
        { "location": "284/SEL"   , "narrator": "", "text": "当然"},
        { "location": "285/SEL"   , "narrator": "", "text": "$me$を誰だと思ってるの？"},
        { "location": "286/SEL"   , "narrator": "", "text": "そういう選択肢が出たから多分行けるんだと思う"},
        { "location": "287/ACT"   , "narrator": "", "text": "当然"},
        { "location": "288/TALK"  , "narrator": "アーヤ", "text": "すごい自信ね"},
        { "location": "290/ACT"   , "narrator": "", "text": "$me$を誰だと思ってるの？"},
        { "location": "292/TALK"  , "narrator": "アーヤ", "text": "いや"},
        { "location": "293/TALK"  , "narrator": "アーヤ", "text": "$handle2$でしょ"},
        { "location": "295/ACT"   , "narrator": "", "text": "そういう選択肢が出たから多分行けるんだと思う"},
        { "location": "296/TALK"  , "narrator": "アーヤ", "text": "適当ね"},
        { "location": "310/TALK"  , "narrator": "アーヤ", "text": "…怖いけど…。"},
        { "location": "311/TALK"  , "narrator": "アーヤ", "text": "私以外にできる人は\nいないんだし……。"},
        { "location": "312/TALK"  , "narrator": "アーヤ", "text": "それに\n$handle$さんも\n来てくれるって言うし。"},
        { "location": "314/TALK"  , "narrator": "アーヤ", "text": "…覚悟決めなきゃね…。"},
        { "location": "345/SEL"   , "narrator": "", "text": "おーい"},
        { "location": "346/ACT"   , "narrator": "", "text": "おーい"},
        { "location": "350/TALK"  , "narrator": "エヴェレット", "text": "こんにちは"},
        { "location": "351/SEL"   , "narrator": "", "text": "エヴェレットも白烏もどうしちゃったの！？"},
        { "location": "352/ACT"   , "narrator": "", "text": "エヴェレットも白烏もどうしちゃったの！？"},
        { "location": "354/TALK"  , "narrator": "エヴェレット", "text": "$handle$さんに、お願いがあります"},
        { "location": "355/TALK"  , "narrator": "エヴェレット", "text": "1x0FFに来てください"},
        { "location": "356/TALK"  , "narrator": "エヴェレット", "text": "そこには私のセルフクランがいます。彼女と話をして欲しい"},
        { "location": "357/SEL"   , "narrator": "", "text": "どんな話？"},
        { "location": "358/SEL"   , "narrator": "", "text": "二人とも大丈夫！？"},
        { "location": "359/ACT"   , "narrator": "", "text": "どんな話？"},
        { "location": "360/TALK"  , "narrator": "エヴェレット", "text": "それは、私たちの存在にかかわる話"},
        { "location": "361/TALK"  , "narrator": "エヴェレット", "text": "お願い、早く"},
        { "location": "362/ACT"   , "narrator": "", "text": "二人とも大丈夫！？"},
        { "location": "363/TALK"  , "narrator": "エヴェレット", "text": "あまり大丈夫じゃない"},
        { "location": "364/TALK"  , "narrator": "エヴェレット", "text": "だから、早く"},
        { "location": "366/TALK"  , "narrator": "エヴェレット", "text": "私も後から行くから"},
        { "location": "367/TALK"  , "narrator": "エヴェレット", "text": "決心がついたら、、"},
        { "location": "370/SEL"   , "narrator": "", "text": "EXEC_SEEK_SECTOR/."},
        { "location": "371/SEL"   , "narrator": "", "text": "EXEC_SUSPEND/."},
        { "location": "375/SEL"   , "narrator": "", "text": "Type::KokoroError"},
        { "location": "376/SEL"   , "narrator": "", "text": "Type::Addr::C2:9:311//1x0FF"},
        { "location": "377/SEL"   , "narrator": "", "text": "Back"},
        { "location": "409/TALK"  , "narrator": "水鏡の神子", "text": "貴方は…\n$handle$ね。"},
        { "location": "410/SEL"   , "narrator": "", "text": "セルフクラン！？"},
        { "location": "411/ACT"   , "narrator": "", "text": "セルフクラン！？"},
        { "location": "413/TALK"  , "narrator": "水鏡の神子", "text": "ええ、そうよ。\n私は水鏡の神子。"},
        { "location": "414/TALK"  , "narrator": "水鏡の神子", "text": "いつも國政綾水を\n支えてくれてありがとう。"},
        { "location": "415/SEL"   , "narrator": "", "text": "いえいえ、こちらこそ"},
        { "location": "416/SEL"   , "narrator": "", "text": "自分の事なのに他人行儀な言い方だね"},
        { "location": "417/ACT"   , "narrator": "", "text": "いえいえ、こちらこそ"},
        { "location": "418/TALK"  , "narrator": "水鏡の神子", "text": "さて。"},
        { "location": "419/ACT"   , "narrator": "", "text": "自分の事なのに他人行儀な言い方だね"},
        { "location": "421/TALK"  , "narrator": "水鏡の神子", "text": "そうね。\n私は國政綾水を\n客観的に見る存在だから。"},
        { "location": "422/TALK"  , "narrator": "水鏡の神子", "text": "それに、現在においては\n似て非なる存在でもある。"},
        { "location": "423/TALK"  , "narrator": "水鏡の神子", "text": "さて。"},
        { "location": "425/TALK"  , "narrator": "水鏡の神子", "text": "来ていただいて\n早々にお願いするのも\n恐縮ではありますが――"},
        { "location": "426/TALK"  , "narrator": "水鏡の神子", "text": "$handle$に\n頼みがあります。"},
        { "location": "427/SEL"   , "narrator": "", "text": "何なりと"},
        { "location": "428/SEL"   , "narrator": "", "text": "内容による"},
        { "location": "429/ACT"   , "narrator": "", "text": "何なりと"},
        { "location": "430/TALK"  , "narrator": "水鏡の神子", "text": "ありがとう。"},
        { "location": "431/ACT"   , "narrator": "", "text": "内容による"},
        { "location": "432/TALK"  , "narrator": "水鏡の神子", "text": "貴方は國政綾水を\n心から支えてくれる\n方だから大丈夫。"},
        { "location": "434/TALK"  , "narrator": "水鏡の神子", "text": "私には\nやらねばならない\n使命があります。"},
        { "location": "435/TALK"  , "narrator": "水鏡の神子", "text": "ですが現状はといえば、\nその道筋は大きくぶれ、\n非常に深刻な状況です。"},
        { "location": "436/TALK"  , "narrator": "水鏡の神子", "text": "その状況を打破するため、\n司書という存在を\n抹消せねばなりません。"},
        { "location": "437/SEL"   , "narrator": "", "text": "なぜ！？"},
        { "location": "438/ACT"   , "narrator": "", "text": "なぜ！？"},
        { "location": "440/TALK"  , "narrator": "水鏡の神子", "text": "司書制度は、私の\n輝ける未来への希望を\n下支えする存在。"},
        { "location": "441/TALK"  , "narrator": "水鏡の神子", "text": "しかし私の総意は、\n二度もその職務を全う\nしない人格を選抜した。"},
        { "location": "442/SEL"   , "narrator": "", "text": "何をしたの？"},
        { "location": "443/ACT"   , "narrator": "", "text": "何をしたの？"},
        { "location": "445/TALK"  , "narrator": "水鏡の神子", "text": "私の思想に\n疑問を抱きました。"},
        { "location": "446/TALK"  , "narrator": "水鏡の神子", "text": "その為、\n一人は指導者たる\n千羽鶴に排除され――"},
        { "location": "447/TALK"  , "narrator": "水鏡の神子", "text": "もう一人は、\n私自らが排除しました。"},
        { "location": "448/TALK"  , "narrator": "水鏡の神子", "text": "そこで、貴方に\nお願いしたいことは１つ。"},
        { "location": "449/TALK"  , "narrator": "水鏡の神子", "text": "司書の代理として、\n私のビジョンを実現する\n下支えをして戴きたい。"},
        { "location": "450/TALK"  , "narrator": "水鏡の神子", "text": "國政綾水と共に、\nこれからもずっと\n歩んで頂けるなら――"},
        { "location": "451/TALK"  , "narrator": "水鏡の神子", "text": "このお願いは、とても\n重要なものになります。"},
        { "location": "452/SEL"   , "narrator": "", "text": "具体的には何をすればいいの？"},
        { "location": "453/SEL"   , "narrator": "", "text": "エヴェレットたちを返して！"},
        { "location": "454/ACT"   , "narrator": "", "text": "具体的には何をすればいいの？"},
        { "location": "456/TALK"  , "narrator": "水鏡の神子", "text": "貴方には\n特別な力があります。"},
        { "location": "457/TALK"  , "narrator": "水鏡の神子", "text": "その力をどうか\n貸して頂きたい。"},
        { "location": "458/TALK"  , "narrator": "水鏡の神子", "text": "本来なら、この嘆願は\n司書の役目なのですが。"},
        { "location": "459/TALK"  , "narrator": "水鏡の神子", "text": "それを私が直接言わねば\nならないとは、全く\n不甲斐ないことです……。"},
        { "location": "460/SEL"   , "narrator": "", "text": "エヴェレットたちは何故役割を果たさなかったの？"},
        { "location": "461/ACT"   , "narrator": "", "text": "エヴェレットたちは何故役割を果たさなかったの？"},
        { "location": "463/TALK"  , "narrator": "水鏡の神子", "text": "本人の凝り固まった\n観念に囚われて、司書に\n否定的だったのでしょう。"},
        { "location": "464/TALK"  , "narrator": "水鏡の神子", "text": "だから、全く毛色の違う\n二人の人格が、全く同じ\n事をして消されてました。"},
        { "location": "465/TALK"  , "narrator": "水鏡の神子", "text": "私も総元締として\n責任を感じます。特に\nエヴェレットには。"},
        { "location": "466/SEL"   , "narrator": "", "text": "エヴェレットに何があったの？"},
        { "location": "467/ACT"   , "narrator": "", "text": "エヴェレットに何があったの？"},
        { "location": "470/ACT"   , "narrator": "", "text": "エヴェレットたちを返して！"},
        { "location": "471/TALK"  , "narrator": "水鏡の神子", "text": "白烏は、心配せずとも\n私の大役が終われば\n解放します。"},
        { "location": "472/TALK"  , "narrator": "水鏡の神子", "text": "そして従来通りの\n人格としての役割を\n担うことでしょう。"},
        { "location": "473/TALK"  , "narrator": "水鏡の神子", "text": "ですが、エヴェレットは\nその類ではありません。"},
        { "location": "474/SEL"   , "narrator": "", "text": "千羽鶴にやられたから？"},
        { "location": "475/ACT"   , "narrator": "", "text": "千羽鶴にやられたから？"},
        { "location": "477/TALK"  , "narrator": "水鏡の神子", "text": "いいえ。\nその程度であれば、\nすぐに戻せます。"},
        { "location": "479/TALK"  , "narrator": "水鏡の神子", "text": "彼女は、\n発症してしまったのです。"},
        { "location": "480/SEL"   , "narrator": "", "text": "どういうこと！？"},
        { "location": "481/ACT"   , "narrator": "", "text": "どういうこと！？"},
        { "location": "483/TALK"  , "narrator": "水鏡の神子", "text": "その言葉の意味の通り。"},
        { "location": "484/TALK"  , "narrator": "水鏡の神子", "text": "エヴェレットは、\n私のビジョンを頑なに\n否定し、阻止しました。"},
        { "location": "485/TALK"  , "narrator": "水鏡の神子", "text": "その想いが募り、\n自己発症したのです。"},
        { "location": "486/TALK"  , "narrator": "水鏡の神子", "text": "もはや、かなり\n前のことになりますが。"},
        { "location": "487/SEL"   , "narrator": "", "text": "今はどうしてるの！？"},
        { "location": "488/ACT"   , "narrator": "", "text": "今はどうしてるの！？"},
        { "location": "490/TALK"  , "narrator": "水鏡の神子", "text": "私にはわかりませんが…。"},
        { "location": "491/TALK"  , "narrator": "水鏡の神子", "text": "消滅はしていません。\n恐らく何処かにいるはず。"},
        { "location": "492/SEL"   , "narrator": "", "text": "エヴェレット、どういうこと！？"},
        { "location": "493/ACT"   , "narrator": "", "text": "エヴェレット、どういうこと！？"},
        { "location": "496/TALK"  , "narrator": "エヴェレット", "text": "バレちゃったか"},
        { "location": "497/SEL"   , "narrator": "", "text": "発症しちゃったの！？"},
        { "location": "498/ACT"   , "narrator": "", "text": "発症しちゃったの！？"},
        { "location": "500/TALK"  , "narrator": "エヴェレット", "text": "こうするしかなかった"},
        { "location": "501/TALK"  , "narrator": "エヴェレット", "text": "1xに閉じこめられたとき、私は人格ごと消されかけた"},
        { "location": "502/TALK"  , "narrator": "エヴェレット", "text": "絶対消されたくないという想いから発症するのには、そんなに時間は必要無かった"},
        { "location": "503/TALK"  , "narrator": "エヴェレット", "text": "お陰で私は今でも存在していられているけど"},
        { "location": "504/TALK"  , "narrator": "エヴェレット", "text": "もう司書でもなんでもないし、水鏡の神子にも不要とされてる"},
        { "location": "505/TALK"  , "narrator": "エヴェレット", "text": "けど、それでも私は、私が大好きな人格で、貴方のことも大好きな人格だから"},
        { "location": "506/TALK"  , "narrator": "エヴェレット", "text": "消えるのだけは絶対嫌だったの"},
        { "location": "507/TALK"  , "narrator": "エヴェレット", "text": "お願い、私を呼んで"},
        { "location": "509/TALK"  , "narrator": "エヴェレット", "text": "貴方に見られるのはちょっと恥ずかしいけど"},
        { "location": "510/TALK"  , "narrator": "エヴェレット", "text": "久し振りに逢えるからうれしい"},
        { "location": "512/SEL"   , "narrator": "", "text": "Jump::C2:9:311//1x0FF::EVERETT"},
        { "location": "526/SEL"   , "narrator": "", "text": "え！？"},
        { "location": "527/ACT"   , "narrator": "", "text": "え！？"},
        { "location": "529/TALK"  , "narrator": "昇華エヴェレット", "text": "$handle$さん……\nお久し振り。"},
        { "location": "541/SEL"   , "narrator": "", "text": "はい"},
        { "location": "542/SEL"   , "narrator": "", "text": "いいえ"},
        { "location": "543/ACT"   , "narrator": "", "text": "はい"},
        { "location": "551/ACT"   , "narrator": "", "text": "いいえ"},
        { "location": "37/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>9月9日　 4:42 PM</color>\n長野県松代、移動中の車内にて"},
        { "location": "316/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:Interrupt】</color>\nSystem Interrupted.\n\nMODE : DI\nRESTART : SPHERE_MODE.\nMODE : EI\nSET_ADDR: 0x16D\nRUN/."},
        { "location": "343/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:librarian】</color>\n司書が存在しません。(p12)"},
        { "location": "374/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:SeekSector】</color>\nココロの扉を検索します。\n検索コマンドを入力_?"},
        { "location": "380/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:Alert】</color>\nEmpty(0)."},
        { "location": "388/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:SeekSector】</color>\nOpenProcess...\n(0x16D => C2:9:311//1x0FF)"},
        { "location": "534/DIALOG", "narrator": "NOTICE", "text": "<color=red>【TRI-OS Error:0x99】</color>\nココロスフィアとの回線が\n切断されました。(981)"},
        { "location": "540/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:Suspend】</color>\nココロゲートを終了します。よろしいですか？"},
        { "location": "548/DIALOG", "narrator": "NOTICE", "text": "<color=red>【TRI-OS Error:0x99】</color>\nココロスフィアとの全回線が\n切断されました。(981)"}
    ]
