        { "location": "312/TALK", "narrator": "プレイヤー", "text": "お着替えしてみよう"},
        { "location": "314/TALK", "narrator": "プレイヤー", "text": "違う服を着てほしいな"},
        { "location": "316/TALK", "narrator": "プレイヤー", "text": "よし、お着替えタイムだ！"},
        { "location": "322/TALK", "narrator": "プレイヤー", "text": "やあ"},
        { "location": "324/TALK", "narrator": "プレイヤー", "text": "こんにちは"},
        { "location": "326/TALK", "narrator": "プレイヤー", "text": "げんき？"},
        { "location": "329/TALK", "narrator": "神楽", "text": "ぴょんこを呼ぶ声"},
        { "location": "330/TALK", "narrator": "神楽", "text": "あなたはだあれ？"},
        { "location": "332/SEL" , "narrator": "", "text": "$handle$だよ"},
        { "location": "333/ACT" , "narrator": "", "text": "$handle$だよ"},
        { "location": "335/TALK", "narrator": "神楽", "text": "知ってるし"},
        { "location": "336/TALK", "narrator": "神楽", "text": "ぴょんこに用事ぴょん？"},
        { "location": "339/SEL" , "narrator": "", "text": "ちょっと着替えてほしいんだ"},
        { "location": "340/ACT" , "narrator": "", "text": "ちょっと着替えてほしいんだ"},
        { "location": "350/TALK", "narrator": "神楽", "text": "意味不明すぎ"},
        { "location": "351/TALK", "narrator": "神楽", "text": "でもまあ"},
        { "location": "352/TALK", "narrator": "神楽", "text": "優しいぴょんこは聞いてあげるのだった"},
        { "location": "354/TALK", "narrator": "神楽", "text": "は？"},
        { "location": "355/TALK", "narrator": "神楽", "text": "この服変だった？"},
        { "location": "356/TALK", "narrator": "神楽", "text": "なら着替えるけど"},
        { "location": "359/SEL" , "narrator": "", "text": "$me$が選ぶ"},
        { "location": "360/SEL" , "narrator": "", "text": "やっぱやめる"},
        { "location": "362/TALK", "narrator": "神楽", "text": "…………"},
        { "location": "365/TALK", "narrator": "神楽", "text": "リクエストないとか？"},
        { "location": "366/TALK", "narrator": "神楽", "text": "なら着ない"},
        { "location": "368/ACT" , "narrator": "", "text": "$me$が選ぶ"},
        { "location": "369/TALK", "narrator": "神楽", "text": "だと思った"},
        { "location": "370/TALK", "narrator": "神楽", "text": "どれを着てほしいと？"},
        { "location": "377/ACT" , "narrator": "", "text": "やっぱやめる"},
        { "location": "378/TALK", "narrator": "神楽", "text": "ありえネー"}
