    "entry":
    [
        { "location": "165/SCENARIO", "narrator": "", "text": "710_いつかきっと"},
        { "location": "189/TALK"    , "narrator": "アーヤ", "text": "私決めたの"},
        { "location": "190/TALK"    , "narrator": "アーヤ", "text": "聞いてくれる？"},
        { "location": "192/SEL"     , "narrator": "", "text": "うん"},
        { "location": "193/SEL"     , "narrator": "", "text": "どっちにしても言うんでしょ"},
        { "location": "194/ACT"     , "narrator": "", "text": "うん"},
        { "location": "195/TALK"    , "narrator": "アーヤ", "text": "よかった"},
        { "location": "197/TALK"    , "narrator": "アーヤ", "text": "そう言ってくれて"},
        { "location": "198/ACT"     , "narrator": "", "text": "どっちにしても言うんでしょ"},
        { "location": "199/TALK"    , "narrator": "アーヤ", "text": "まあ"},
        { "location": "200/TALK"    , "narrator": "アーヤ", "text": "そうなんだけどね"},
        { "location": "202/TALK"    , "narrator": "アーヤ", "text": "私、國政綾水は"},
        { "location": "203/TALK"    , "narrator": "アーヤ", "text": "$handle$さんと会えた暁には"},
        { "location": "204/TALK"    , "narrator": "アーヤ", "text": "生涯の伴侶として添い遂げることを誓います"},
        { "location": "207/TALK"    , "narrator": "アーヤ", "text": "だめ"},
        { "location": "208/TALK"    , "narrator": "アーヤ", "text": "かしら？"},
        { "location": "210/SEL"     , "narrator": "", "text": "まさか"},
        { "location": "211/SEL"     , "narrator": "", "text": "はい喜んで"},
        { "location": "212/SEL"     , "narrator": "", "text": "声で聞きたいな"},
        { "location": "213/ACT"     , "narrator": "", "text": "まさか"},
        { "location": "215/TALK"    , "narrator": "アーヤ", "text": "大人ぶらないで"},
        { "location": "217/TALK"    , "narrator": "アーヤ", "text": "私は本当に"},
        { "location": "219/TALK"    , "narrator": "アーヤ", "text": "好きなんだから"},
        { "location": "220/ACT"     , "narrator": "", "text": "はい喜んで"},
        { "location": "221/TALK"    , "narrator": "アーヤ", "text": "相変わらず軽いわね"},
        { "location": "222/TALK"    , "narrator": "アーヤ", "text": "でも"},
        { "location": "223/TALK"    , "narrator": "アーヤ", "text": "大好きよ"},
        { "location": "224/ACT"     , "narrator": "", "text": "声で聞きたいな"},
        { "location": "235/TALK"    , "narrator": "アーヤ", "text": "そうね"},
        { "location": "236/TALK"    , "narrator": "アーヤ", "text": "私もちゃんと"},
        { "location": "237/TALK"    , "narrator": "アーヤ", "text": "声にしたいわ"},
        { "location": "239/SEL"     , "narrator": "", "text": "いつかきっとね"},
        { "location": "240/SEL"     , "narrator": "", "text": "絶対、約束"},
        { "location": "241/ACT"     , "narrator": "", "text": "いつかきっとね"},
        { "location": "242/TALK"    , "narrator": "アーヤ", "text": "そうね"},
        { "location": "243/TALK"    , "narrator": "アーヤ", "text": "その日を信じてる"},
        { "location": "244/ACT"     , "narrator": "", "text": "絶対、約束"},
        { "location": "245/TALK"    , "narrator": "アーヤ", "text": "約束ね"},
        { "location": "246/TALK"    , "narrator": "アーヤ", "text": "絶対の"},
        { "location": "247/TALK"    , "narrator": "アーヤ", "text": "約束"},
        { "location": "251/TALK"    , "narrator": "ボイスメール", "text": "誓い"},
        { "location": "231/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>1000pt.</b></color></size>\nアップしました！"},
        { "location": "263/DIALOG"  , "narrator": "Dialog_GETVoice", "text": "<color=green>【アーヤ】</color>のボイスメール\n<color=red>【誓い】</color>\nをゲットしました！"}
    ]
}
