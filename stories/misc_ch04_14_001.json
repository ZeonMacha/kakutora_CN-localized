    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "05_000_サブカルチャー革命未満"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "革命とは"},
        { "location": "33/TALK"   , "narrator": "みやび", "text": "常にマイノリティが起こすものぞね"},
        { "location": "35/SEL"    , "narrator": "", "text": "歴史の話？"},
        { "location": "36/SEL"    , "narrator": "", "text": "そういうもんだろうね"},
        { "location": "37/SEL"    , "narrator": "", "text": "一緒に革命を起こさないか"},
        { "location": "38/ACT"    , "narrator": "", "text": "歴史の話？"},
        { "location": "39/TALK"   , "narrator": "みやび", "text": "まあ"},
        { "location": "40/TALK"   , "narrator": "みやび", "text": "それもある"},
        { "location": "41/ACT"    , "narrator": "", "text": "そういうもんだろうね"},
        { "location": "42/TALK"   , "narrator": "みやび", "text": "なかなかに"},
        { "location": "43/TALK"   , "narrator": "みやび", "text": "ドライな反応"},
        { "location": "44/ACT"    , "narrator": "", "text": "一緒に革命を起こさないか"},
        { "location": "46/TALK"   , "narrator": "みやび", "text": "その声を待っていた"},
        { "location": "48/TALK"   , "narrator": "みやび", "text": "と"},
        { "location": "49/TALK"   , "narrator": "みやび", "text": "言うとでも思ったか"},
        { "location": "50/TALK"   , "narrator": "みやび", "text": "悪くない"},
        { "location": "52/TALK"   , "narrator": "みやび", "text": "何の話をしているかと言うと"},
        { "location": "53/TALK"   , "narrator": "みやび", "text": "アキバ系と呼ばれる文化のことぞね"},
        { "location": "55/SEL"    , "narrator": "", "text": "クールジャパン！"},
        { "location": "56/SEL"    , "narrator": "", "text": "後ろ暗いからこそいいのに"},
        { "location": "57/SEL"    , "narrator": "", "text": "一言でまとめるのもちょっとね"},
        { "location": "58/ACT"    , "narrator": "", "text": "クールジャパン！"},
        { "location": "59/TALK"   , "narrator": "みやび", "text": "なるほど"},
        { "location": "60/TALK"   , "narrator": "みやび", "text": "肯定派か"},
        { "location": "61/ACT"    , "narrator": "", "text": "後ろ暗いからこそいいのに"},
        { "location": "62/TALK"   , "narrator": "みやび", "text": "うむ"},
        { "location": "63/TALK"   , "narrator": "みやび", "text": "背徳の美学"},
        { "location": "64/ACT"    , "narrator": "", "text": "一言でまとめるのもちょっとね"},
        { "location": "66/TALK"   , "narrator": "みやび", "text": "おお"},
        { "location": "68/TALK"   , "narrator": "みやび", "text": "俯瞰的意見"},
        { "location": "69/TALK"   , "narrator": "みやび", "text": "気に入った"},
        { "location": "71/TALK"   , "narrator": "みやび", "text": "しかし"},
        { "location": "72/TALK"   , "narrator": "みやび", "text": "一番の問題は"},
        { "location": "73/TALK"   , "narrator": "みやび", "text": "本人たちが革命を望んでいないことかもしれぬ"},
        { "location": "75/TALK"   , "narrator": "みやび", "text": "いや"},
        { "location": "76/TALK"   , "narrator": "みやび", "text": "その場合は"},
        { "location": "77/TALK"   , "narrator": "みやび", "text": "そもそも問題ではないのか"},
        { "location": "80/TALK"   , "narrator": "みやび", "text": "ちうことで"},
        { "location": "81/TALK"   , "narrator": "みやび", "text": "問題は解決だ"},
        { "location": "82/TALK"   , "narrator": "みやび", "text": "喜べ相棒"}
    ]
}
