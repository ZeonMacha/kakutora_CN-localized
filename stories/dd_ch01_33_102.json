        "title": "005 メインストーリー",
        "sub_title": "チャンネルカグラ＜後編＞"
    },
    "entry":
    [
        { "location": "512/SCENARIO", "narrator": "", "text": "灰色の天然色"},
        { "location": "529/TALK"    , "narrator": "神楽", "text": "ぅあぁぁぁぁ……！"},
        { "location": "531/TALK"    , "narrator": "神楽", "text": "…っ……。\nこんな事になるなら\nいっそ……――"},
        { "location": "532/TALK"    , "narrator": "神楽", "text": "だめ……"},
        { "location": "533/TALK"    , "narrator": "神楽", "text": "だめ！"},
        { "location": "534/TALK"    , "narrator": "神楽", "text": "生きる。"},
        { "location": "535/TALK"    , "narrator": "神楽", "text": "生きてやる！\n絶対……"},
        { "location": "537/TALK"    , "narrator": "神楽", "text": "早く…っ……"},
        { "location": "538/TALK"    , "narrator": "神楽", "text": "早く…死ななくちゃ……"},
        { "location": "539/TALK"    , "narrator": "神楽", "text": "……　…っ…"},
        { "location": "541/TALK"    , "narrator": "千羽鶴", "text": "……。"},
        { "location": "542/TALK"    , "narrator": "神楽", "text": "あ、あぁ…ぁ……！"},
        { "location": "543/TALK"    , "narrator": "千羽鶴", "text": "……。"},
        { "location": "546/TALK"    , "narrator": "神楽", "text": "あ……。"},
        { "location": "556/TALK"    , "narrator": "透明神楽", "text": "……。"},
        { "location": "562/TALK"    , "narrator": "千羽鶴", "text": "完了。"},
        { "location": "563/TALK"    , "narrator": "千羽鶴", "text": "一之宮神楽。"},
        { "location": "564/TALK"    , "narrator": "千羽鶴", "text": "あなたはこちらの\n準備したことに\n従わなかった。"},
        { "location": "565/TALK"    , "narrator": "千羽鶴", "text": "逢瀬つばめへの\n激しい好意と憎悪。"},
        { "location": "566/TALK"    , "narrator": "千羽鶴", "text": "矛盾する気持ちを\n抱かせて葛藤させ\nあなたを発症させた。"},
        { "location": "567/TALK"    , "narrator": "千羽鶴", "text": "あとは歌うだけで\n逢瀬つばめは破壊され\n任務は完了した。"},
        { "location": "568/TALK"    , "narrator": "千羽鶴", "text": "任務実行にあたり\nこちらは破格の条件を\n提示したはず。"},
        { "location": "569/TALK"    , "narrator": "千羽鶴", "text": "スピネルは卯月美佐子の\n中へ戻し、あなたは\nフランスに帰る。"},
        { "location": "570/TALK"    , "narrator": "千羽鶴", "text": "国家機密の実行者に\n対する措置としては\nありえない好条件。"},
        { "location": "571/TALK"    , "narrator": "千羽鶴", "text": "なのにあなたは\n歌わなかった。"},
        { "location": "572/TALK"    , "narrator": "千羽鶴", "text": "だけど今回こそ\n歌えるでしょう？\n一之宮神楽。"},
        { "location": "573/TALK"    , "narrator": "神楽", "text": "はい。"},
        { "location": "575/TALK"    , "narrator": "千羽鶴", "text": "それはよかった。"},
        { "location": "576/TALK"    , "narrator": "千羽鶴", "text": "儀式の決行は１時間後。"},
        { "location": "577/TALK"    , "narrator": "神楽", "text": "はい。"},
        { "location": "578/TALK"    , "narrator": "千羽鶴", "text": "あなたも儀式用の服に\n着替えてもらう。\nあっちに準備がある。"},
        { "location": "579/TALK"    , "narrator": "神楽", "text": "はい。"},
        { "location": "585/TALK"    , "narrator": "千羽鶴", "text": "協力してくれて\nありがと。"},
        { "location": "586/TALK"    , "narrator": "千羽鶴", "text": "これで概ね、\n全ての準備が整った。"},
        { "location": "587/TALK"    , "narrator": "千羽鶴", "text": "あとは、貴方がココロの\n中で協力してくれれば、\n全ては完了する。"},
        { "location": "588/TALK"    , "narrator": "千羽鶴", "text": "それじゃ、また後ほど。"},
        { "location": "590/TALK"    , "narrator": "千羽鶴", "text": "自殺しないようにって\nお願いしたはず。"},
        { "location": "591/TALK"    , "narrator": "千羽鶴", "text": "幸い、フェノメノン展開の\n方が辛うじて早かったから\n死なずに済んだけど。"},
        { "location": "592/TALK"    , "narrator": "千羽鶴", "text": "彼女が死んでいたら\nもはや為す術は\nなくなっていた。"},
        { "location": "593/TALK"    , "narrator": "千羽鶴", "text": "まあ、結果オーライだから\nこれくらいに\nしておくけど。"},
        { "location": "594/TALK"    , "narrator": "千羽鶴", "text": "それじゃ、私はこれから\n儀式の準備があるから。"},
        { "location": "595/TALK"    , "narrator": "千羽鶴", "text": "また後ほど。"},
        { "location": "625/TALK"    , "narrator": "つばめ", "text": "もうやだ…。\nやだよ……。"},
        { "location": "626/TALK"    , "narrator": "つばめ", "text": "う…うう……。"},
        { "location": "627/SEL"     , "narrator": "", "text": "つばめ！"},
        { "location": "628/SEL"     , "narrator": "", "text": "しっかりして！"},
        { "location": "629/SEL"     , "narrator": "", "text": "辛いんだよね？"},
        { "location": "630/ACT"     , "narrator": "", "text": "つばめ！"},
        { "location": "631/ACT"     , "narrator": "", "text": "しっかりして！"},
        { "location": "632/ACT"     , "narrator": "", "text": "辛いんだよね？"},
        { "location": "636/TALK"    , "narrator": "つばめ", "text": "う…ぁ……。\n$handle$さん……。\nたすけ…て…よ…。"},
        { "location": "637/SEL"     , "narrator": "", "text": "$me$はここだよ！"},
        { "location": "638/SEL"     , "narrator": "", "text": "つばめ！　つばめ！！"},
        { "location": "639/SEL"     , "narrator": "", "text": "$handle$だよ！"},
        { "location": "640/ACT"     , "narrator": "", "text": "$me$はここだよ！"},
        { "location": "641/ACT"     , "narrator": "", "text": "つばめ！　つばめ！！"},
        { "location": "642/ACT"     , "narrator": "", "text": "$handle$だよ！"},
        { "location": "646/TALK"    , "narrator": "つばめ", "text": "痛い……。\n辛いの……。"},
        { "location": "647/SEL"     , "narrator": "", "text": "気付いて…！"},
        { "location": "648/SEL"     , "narrator": "", "text": "つばめ！！！！！"},
        { "location": "649/SEL"     , "narrator": "", "text": "ここにいるのに…"},
        { "location": "650/ACT"     , "narrator": "", "text": "気付いて…！"},
        { "location": "651/ACT"     , "narrator": "", "text": "つばめ！！！！！"},
        { "location": "652/ACT"     , "narrator": "", "text": "ここにいるのに…"},
        { "location": "666/DIALOG"  , "narrator": "Dialog_chapter_ch01", "text": "【27 シン・カグラ】"}
    ]
}
