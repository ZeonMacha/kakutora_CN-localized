{
    "dir": "chap05/daydra/anime_05_05.js",
    "type": "MainStory",
    "info": {
        "story_id": "5501",
        "cid": "kagura",
        "title": "001 アニメーション",
        "sub_title": "EnigMATRIX."
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "アニメ第05話"},
        { "location": "19/TALK"   , "narrator": "赤髪千羽鶴", "text": "こんにちは、\n$handle$さん。"},
        { "location": "20/TALK"   , "narrator": "赤髪千羽鶴", "text": "もう一度わたしと話を\nしていきますか？"},
        { "location": "21/SEL"    , "narrator": "", "text": "はい"},
        { "location": "22/SEL"    , "narrator": "", "text": "いいえ"},
        { "location": "23/ACT"    , "narrator": "", "text": "はい"},
        { "location": "24/TALK"   , "narrator": "赤髪千羽鶴", "text": "わかりました。\nそれでは……。"},
        { "location": "26/ACT"    , "narrator": "", "text": "いいえ"},
        { "location": "27/TALK"   , "narrator": "赤髪千羽鶴", "text": "わかりました。\nそれではこれで。"},
        { "location": "33/TALK"   , "narrator": "赤髪千羽鶴", "text": "こんにちは。"},
        { "location": "34/SEL"    , "narrator": "", "text": "原初のつばめ！"},
        { "location": "35/SEL"    , "narrator": "", "text": "会いたかったよ！"},
        { "location": "36/ACT"    , "narrator": "", "text": "原初のつばめ！"},
        { "location": "37/TALK"   , "narrator": "赤髪千羽鶴", "text": "やっぱり慣れませんね、\nその呼び方。"},
        { "location": "38/ACT"    , "narrator": "", "text": "会いたかったよ！"},
        { "location": "39/TALK"   , "narrator": "赤髪千羽鶴", "text": "そう言ってもらえると\n特に理由もなく\n嬉しくなりますよね。"},
        { "location": "40/TALK"   , "narrator": "赤髪千羽鶴", "text": "どうしてなんでしょうか。"},
        { "location": "41/TALK"   , "narrator": "赤髪千羽鶴", "text": "本来人間は、\n誰かに求められることを\n渇望してるとか？"},
        { "location": "43/TALK"   , "narrator": "赤髪千羽鶴", "text": "と、そんなことは\nいいんです。"},
        { "location": "44/TALK"   , "narrator": "赤髪千羽鶴", "text": "今回はどうしても\n確認したいことがあって\nここに来ました。"},
        { "location": "45/TALK"   , "narrator": "赤髪千羽鶴", "text": "わたしナビゲーターじゃ\nありませんし、あまり\n来ても良くありませんが。"},
        { "location": "46/SEL"    , "narrator": "", "text": "そうなんだ"},
        { "location": "47/SEL"    , "narrator": "", "text": "毎回でもオッケーよ！"},
        { "location": "48/ACT"    , "narrator": "", "text": "そうなんだ"},
        { "location": "49/TALK"   , "narrator": "赤髪千羽鶴", "text": "はい。"},
        { "location": "50/ACT"    , "narrator": "", "text": "毎回でもオッケーよ！"},
        { "location": "51/TALK"   , "narrator": "赤髪千羽鶴", "text": "ありがとうございます！\nお気持ちは\nとても嬉しいです。"},
        { "location": "52/TALK"   , "narrator": "赤髪千羽鶴", "text": "ですけど、やはり\n役割を全うできない者は\nいるべきではありません。"},
        { "location": "54/TALK"   , "narrator": "赤髪千羽鶴", "text": "ナビゲーターの役割は\n世界の道筋を作って\n伝えることですけど――"},
        { "location": "55/TALK"   , "narrator": "赤髪千羽鶴", "text": "わたしはそういうのは、\nちょっと出来ませんから。"},
        { "location": "56/TALK"   , "narrator": "赤髪千羽鶴", "text": "それで、今回わたしが\nここに来た目的はですね。"},
        { "location": "57/TALK"   , "narrator": "赤髪千羽鶴", "text": "$handle$さんに\n改めて確認しておきたい\n事があったからなんです。"},
        { "location": "58/SEL"    , "narrator": "", "text": "なんだろう？"},
        { "location": "59/SEL"    , "narrator": "", "text": "えっと、いつごろ婚約するかについてだっけ？"},
        { "location": "60/ACT"    , "narrator": "", "text": "なんだろう？"},
        { "location": "61/TALK"   , "narrator": "赤髪千羽鶴", "text": "とっても大事な事です。"},
        { "location": "62/ACT"    , "narrator": "", "text": "えっと、いつごろ婚約するかについてだっけ？"},
        { "location": "63/TALK"   , "narrator": "赤髪千羽鶴", "text": "いいえ。\nもっと大事なことです。"},
        { "location": "64/SEL"    , "narrator": "", "text": "残念……"},
        { "location": "65/SEL"    , "narrator": "", "text": "真面目に答えられると凹む"},
        { "location": "66/ACT"    , "narrator": "", "text": "残念……"},
        { "location": "68/TALK"   , "narrator": "赤髪千羽鶴", "text": "わたしもそれなりに\n残念ですけど、でも今は\n優先度は低いんです。"},
        { "location": "69/TALK"   , "narrator": "赤髪千羽鶴", "text": "わたしには、\nそれよりも大事な\n使命がありますから。"},
        { "location": "71/TALK"   , "narrator": "赤髪千羽鶴", "text": "ですから、\nそれが終わったら改めて\nご相談できればと。"},
        { "location": "72/ACT"    , "narrator": "", "text": "真面目に答えられると凹む"},
        { "location": "73/TALK"   , "narrator": "赤髪千羽鶴", "text": "えっ？\nもしかして不真面目な\n会話だったんですか？"},
        { "location": "74/TALK"   , "narrator": "赤髪千羽鶴", "text": "その……なんか、\n理解できていなくて\nすみません……。"},
        { "location": "75/SEL"    , "narrator": "", "text": "なんでそんなに尊いの…"},
        { "location": "76/SEL"    , "narrator": "", "text": "うんうん。これから覚えていけばいいからね？"},
        { "location": "77/ACT"    , "narrator": "", "text": "なんでそんなに尊いの…"},
        { "location": "78/TALK"   , "narrator": "赤髪千羽鶴", "text": "？？"},
        { "location": "79/ACT"    , "narrator": "", "text": "うんうん。これから覚えていけばいいからね？"},
        { "location": "80/TALK"   , "narrator": "赤髪千羽鶴", "text": "はい。\n人生は常に\n学びゆくものですから。"},
        { "location": "84/TALK"   , "narrator": "赤髪千羽鶴", "text": "それでは早速ですが、\n本題に入りますね。"},
        { "location": "85/TALK"   , "narrator": "赤髪千羽鶴", "text": "以前にも似たような事は\n何度か聞いているかも\nしれませんけど。"},
        { "location": "86/TALK"   , "narrator": "赤髪千羽鶴", "text": "$handle$さんは――"},
        { "location": "87/TALK"   , "narrator": "赤髪千羽鶴", "text": "この世界をどういう形で\n運営していくのが\n理想だと思いますか！？"},
        { "location": "88/TALK"   , "narrator": "赤髪千羽鶴", "text": "随分と時間が経ってますし\n色々考えたと思いますので\n是非いまのお考えを！"},
        { "location": "102/SEL"   , "narrator": "", "text": "千羽鶴がやろうとしていた、フェノメノンで全世界を包むのがいいと思う"},
        { "location": "103/SEL"   , "narrator": "", "text": "エリカが提案した、今日本を包んでるフェノメノンを蒸着する案がいいと思う"},
        { "location": "104/SEL"   , "narrator": "", "text": "今日本を包んでるフェノメノンを飛散させ、元の現実に戻すのがいいと思う"},
        { "location": "105/SEL"   , "narrator": "", "text": "今日本を包んでるフェノメノンを、このままずっと持続させるのがいいと思う"},
        { "location": "106/SEL"   , "narrator": "", "text": "どれもダメ"},
        { "location": "107/ACT"   , "narrator": "", "text": "千羽鶴がやろうとしていた、フェノメノンで全世界を包むのがいいと思う"},
        { "location": "109/TALK"  , "narrator": "赤髪千羽鶴", "text": "そうですよね。\nわたしも本当は、これが\nベストだと思ってます。"},
        { "location": "110/TALK"  , "narrator": "赤髪千羽鶴", "text": "ただ、\nあまりにハードルが\n高いですよね。"},
        { "location": "111/TALK"  , "narrator": "赤髪千羽鶴", "text": "それがクリアになれば\nいいのですが。"},
        { "location": "112/ACT"   , "narrator": "", "text": "エリカが提案した、今日本を包んでるフェノメノンを蒸着する案がいいと思う"},
        { "location": "114/TALK"  , "narrator": "赤髪千羽鶴", "text": "そうですね。\n今考えうる案で、最も\nバランスが良い案です。"},
        { "location": "115/TALK"  , "narrator": "赤髪千羽鶴", "text": "現実味もありますし、\n現状放棄も最低限で\n済みますから。"},
        { "location": "116/ACT"   , "narrator": "", "text": "今日本を包んでるフェノメノンを飛散させ、元の現実に戻すのがいいと思う"},
        { "location": "118/TALK"  , "narrator": "赤髪千羽鶴", "text": "すごく正直な意見だと\n思います。"},
        { "location": "119/TALK"  , "narrator": "赤髪千羽鶴", "text": "全世界を基準に考えたら\n当然こうするべきだと\n思いますし。"},
        { "location": "120/TALK"  , "narrator": "赤髪千羽鶴", "text": "本来の歴史が繋がる唯一の\n方法でもありますから、\n最も公平でもありますね。"},
        { "location": "121/ACT"   , "narrator": "", "text": "今日本を包んでるフェノメノンを、このままずっと持続させるのがいいと思う"},
        { "location": "123/TALK"  , "narrator": "赤髪千羽鶴", "text": "とても共感できます。\n私も今のこの日本は\nとても好きですから。"},
        { "location": "124/TALK"  , "narrator": "赤髪千羽鶴", "text": "今の幸せな日本を\n確実に保証できる唯一の\n案でもありますよね。"},
        { "location": "125/TALK"  , "narrator": "赤髪千羽鶴", "text": "確実な永続を可能にする\n方法さえ見つかれば、\n更に盤石になりますし。"},
        { "location": "126/ACT"   , "narrator": "", "text": "どれもダメ"},
        { "location": "128/TALK"  , "narrator": "赤髪千羽鶴", "text": "そうですか…\nすみません。"},
        { "location": "129/TALK"  , "narrator": "赤髪千羽鶴", "text": "私の考えが及ばない\nところにアイデアを\nお持ちなんですね！"},
        { "location": "130/TALK"  , "narrator": "赤髪千羽鶴", "text": "もしよければ、\nそれを教えて\nもらえませんか？"},
        { "location": "131/TALK"  , "narrator": "赤髪千羽鶴", "text": "<color=green>#トライナリー世界を\n救う案</color>として\nSNSでご意見ください！"},
        { "location": "133/TALK"  , "narrator": "赤髪千羽鶴", "text": "ご協力\nありがとうございました。"},
        { "location": "134/TALK"  , "narrator": "赤髪千羽鶴", "text": "最終的に、\n$handle$さん達の\n総意の力は絶大です。"},
        { "location": "135/TALK"  , "narrator": "赤髪千羽鶴", "text": "わたしたちの世界を\n外側から大きく操作できる\n唯一の力ですから。"},
        { "location": "136/TALK"  , "narrator": "赤髪千羽鶴", "text": "ですから、早いうちから\n$handle$さんと\n意志疎通しておきたくて。"},
        { "location": "137/TALK"  , "narrator": "赤髪千羽鶴", "text": "もちろん、今後いくらでも\n気が変わっていいですよ？"},
        { "location": "138/TALK"  , "narrator": "赤髪千羽鶴", "text": "でも、よければその都度\nここで教えてくださいね。"},
        { "location": "139/TALK"  , "narrator": "赤髪千羽鶴", "text": "今回は、\nわたしからは\n以上になります。"},
        { "location": "140/TALK"  , "narrator": "赤髪千羽鶴", "text": "それはそうと――"},
        { "location": "141/TALK"  , "narrator": "赤髪千羽鶴", "text": "今のスタックポインタは\n記録映像でいえば\n2016年5月3日――"},
        { "location": "142/TALK"  , "narrator": "赤髪千羽鶴", "text": "文京ドームでの戦いも、\n丁度佳境に入った頃に\nなりますね。"},
        { "location": "143/TALK"  , "narrator": "赤髪千羽鶴", "text": "今回干渉する卯月さんの\n時間軸も、その近辺に\nなりますが――"},
        { "location": "144/TALK"  , "narrator": "赤髪千羽鶴", "text": "以前確定された\n記録映像を、もう一度\nおさらいしますか？"},
        { "location": "146/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/65MB 4:18】</color>"},
        { "location": "147/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/21MB 4:18】</color>"},
        { "location": "148/SEL"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "149/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/65MB 4:18】</color>"},
        { "location": "150/TALK"  , "narrator": "赤髪千羽鶴", "text": "わかりました。\nそれでは再生しましょう。"},
        { "location": "156/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/21MB 4:18】</color>"},
        { "location": "157/TALK"  , "narrator": "赤髪千羽鶴", "text": "わかりました。\nそれでは再生しましょう。"},
        { "location": "163/ACT"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "164/TALK"  , "narrator": "赤髪千羽鶴", "text": "わかりました。\nそれではレポートを\nご覧下さい。"},
        { "location": "197/TALK"  , "narrator": "赤髪千羽鶴", "text": "……。"},
        { "location": "198/TALK"  , "narrator": "赤髪千羽鶴", "text": "この時の対処については\n今でもそれ以外の最適解を\n見つけられない状態です。"},
        { "location": "199/TALK"  , "narrator": "赤髪千羽鶴", "text": "ですから、\n必要悪だったと\n言わざるを得ません。"},
        { "location": "200/SEL"   , "narrator": "", "text": "なんのこと？"},
        { "location": "201/ACT"   , "narrator": "", "text": "なんのこと？"},
        { "location": "203/TALK"  , "narrator": "赤髪千羽鶴", "text": "音羽さんのクランを\n破壊したことです。"},
        { "location": "204/SEL"   , "narrator": "", "text": "あれって結局何がどうなってたの？"},
        { "location": "205/SEL"   , "narrator": "", "text": "必要悪なんて冷酷すぎる"},
        { "location": "206/ACT"   , "narrator": "", "text": "あれって結局何がどうなってたの？"},
        { "location": "207/TALK"  , "narrator": "赤髪千羽鶴", "text": "一時的に死亡していた\nカレンによる逢瀬つばめに\n本来のセルフクラン――"},
        { "location": "208/TALK"  , "narrator": "赤髪千羽鶴", "text": "千羽鶴が一時的に入り込み\n音羽さんを破壊する行為に\n及んでいます。"},
        { "location": "209/TALK"  , "narrator": "赤髪千羽鶴", "text": "逢瀬つばめに千羽鶴が\n入り込んでいる、\nその状況とはすなわち――"},
        { "location": "210/TALK"  , "narrator": "赤髪千羽鶴", "text": "今のわたしと\n実質同じです。"},
        { "location": "211/TALK"  , "narrator": "赤髪千羽鶴", "text": "ですから、音羽さんの\n破壊はわたしがやったと\n言ってもいいと思います。"},
        { "location": "212/SEL"   , "narrator": "", "text": "でもホントは君じゃないんでしょ？"},
        { "location": "213/SEL"   , "narrator": "", "text": "どうして千羽鶴はこの時戻れたの？"},
        { "location": "214/ACT"   , "narrator": "", "text": "でもホントは君じゃないんでしょ？"},
        { "location": "215/TALK"  , "narrator": "赤髪千羽鶴", "text": "いいえ、わたしです。"},
        { "location": "216/TALK"  , "narrator": "赤髪千羽鶴", "text": "もちろん、\n意志を持って実行したのは\n千羽鶴ですが。"},
        { "location": "217/TALK"  , "narrator": "赤髪千羽鶴", "text": "千羽鶴はわたしの\n一人格ですから、わたしに\n変わりはありません。"},
        { "location": "218/ACT"   , "narrator": "", "text": "どうして千羽鶴はこの時戻れたの？"},
        { "location": "219/TALK"  , "narrator": "赤髪千羽鶴", "text": "千羽鶴はカレンの人格たる\nつばめとの接触を\n恐れていました。"},
        { "location": "220/TALK"  , "narrator": "赤髪千羽鶴", "text": "なぜなら、もしつばめと\n千羽鶴が不用意に接触\nしてしまったら――"},
        { "location": "221/TALK"  , "narrator": "赤髪千羽鶴", "text": "カレンの人格たるつばめは\n千羽鶴のことや外の世界の\nことを全部思い出します。"},
        { "location": "222/TALK"  , "narrator": "赤髪千羽鶴", "text": "それは千羽鶴にとって、\n最もあってはならない\nことだったんです。"},
        { "location": "223/TALK"  , "narrator": "赤髪千羽鶴", "text": "ですが、あの時は\nカレン側の魂が完全に\n離脱していました。"},
        { "location": "224/TALK"  , "narrator": "赤髪千羽鶴", "text": "ですから千羽鶴は、\nバクチではありましたが\n一時的に入り込みました。"},
        { "location": "225/TALK"  , "narrator": "赤髪千羽鶴", "text": "そうしないと、千羽鶴が\nいずれは還る場所――"},
        { "location": "226/TALK"  , "narrator": "赤髪千羽鶴", "text": "すなわち、つばめの身体を\n失ってしまうからです。"},
        { "location": "227/TALK"  , "narrator": "赤髪千羽鶴", "text": "結果として、首の皮一枚で\nわたしの当初の計画は\n維持できました。"},
        { "location": "229/ACT"   , "narrator": "", "text": "必要悪なんて冷酷すぎる"},
        { "location": "230/TALK"  , "narrator": "赤髪千羽鶴", "text": "そうですね。\nその通りです。"},
        { "location": "231/TALK"  , "narrator": "赤髪千羽鶴", "text": "もっと辛辣に\nいってくれて\n構いませんよ。"},
        { "location": "232/TALK"  , "narrator": "赤髪千羽鶴", "text": "わたしはそんな言葉では\n傷ついたり凹んだり\nしませんから大丈夫です。"},
        { "location": "233/TALK"  , "narrator": "赤髪千羽鶴", "text": "わたしは今でも、\nあの時の行動が間違って\nいたとは思いません。"},
        { "location": "234/TALK"  , "narrator": "赤髪千羽鶴", "text": "ですから、あなたは\n遠慮なく私を責める\n権利があります。"},
        { "location": "235/TALK"  , "narrator": "赤髪千羽鶴", "text": "その権利は\n有効に使ってください。"},
        { "location": "237/TALK"  , "narrator": "赤髪千羽鶴", "text": "ただ――"},
        { "location": "238/TALK"  , "narrator": "赤髪千羽鶴", "text": "可能であれば、一人の\n人間の魂を破壊するなどと\nいう事はしたくなかった。"},
        { "location": "239/TALK"  , "narrator": "赤髪千羽鶴", "text": "その想いもまた\n本当の気持ちとして\n存在しています。"},
        { "location": "240/TALK"  , "narrator": "赤髪千羽鶴", "text": "ですから、わたしは\n今でも思います。"},
        { "location": "241/TALK"  , "narrator": "赤髪千羽鶴", "text": "音羽さんを\n元の正常な魂に\n戻してあげたいと。"},
        { "location": "242/SEL"   , "narrator": "", "text": "やっぱり後悔してるの？"},
        { "location": "243/SEL"   , "narrator": "", "text": "$me$もそうしたい！"},
        { "location": "244/ACT"   , "narrator": "", "text": "やっぱり後悔してるの？"},
        { "location": "245/TALK"  , "narrator": "赤髪千羽鶴", "text": "後悔はしてません。"},
        { "location": "246/TALK"  , "narrator": "赤髪千羽鶴", "text": "ただ、人の魂は\n壊れていない方が\nよりベターですよね。"},
        { "location": "247/ACT"   , "narrator": "", "text": "$me$もそうしたい！"},
        { "location": "248/TALK"  , "narrator": "赤髪千羽鶴", "text": "ですよね。"},
        { "location": "250/TALK"  , "narrator": "赤髪千羽鶴", "text": "ですから、\nついでで構いません。"},
        { "location": "251/TALK"  , "narrator": "赤髪千羽鶴", "text": "もし卯月さんを観測する\n中で、音羽さんを治す\n手がかりを見つけたら。"},
        { "location": "252/TALK"  , "narrator": "赤髪千羽鶴", "text": "わたしに教えて\nいただけないでしょうか？"},
        { "location": "253/SEL"   , "narrator": "", "text": "いいよ"},
        { "location": "254/SEL"   , "narrator": "", "text": "信用できない"},
        { "location": "255/ACT"   , "narrator": "", "text": "いいよ"},
        { "location": "256/TALK"  , "narrator": "赤髪千羽鶴", "text": "ありがとうございます。"},
        { "location": "257/TALK"  , "narrator": "赤髪千羽鶴", "text": "でも、本当についでで\n構いませんから。"},
        { "location": "258/ACT"   , "narrator": "", "text": "信用できない"},
        { "location": "259/TALK"  , "narrator": "赤髪千羽鶴", "text": "そうですか。\nそれは残念です。"},
        { "location": "260/TALK"  , "narrator": "赤髪千羽鶴", "text": "$handle$さんが\n信じるかどうかは\n自由ですが――"},
        { "location": "261/TALK"  , "narrator": "赤髪千羽鶴", "text": "わたしは本当にそう\n思ってますから、それでは\n自分で探そうと思います。"},
        { "location": "263/TALK"  , "narrator": "赤髪千羽鶴", "text": "それじゃ、あまり長居を\nしてもアレですから、\n今回はこの辺で。"},
        { "location": "264/TALK"  , "narrator": "赤髪千羽鶴", "text": "卯月さんの観測、\n頑張ってくださいね。"},
        { "location": "90/DIALOG" , "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:navigator】</color>\n\n期間中は、何度でも\n回答を変更できます。\n最後の回答が、その時点での\n貴方の結論となります。\n\n<color=red>現在のあなたの選択は\n【千羽鶴がやろうとしていた、フェノメノンで全世界を包むのがいいと思う】\nです。</color>"},
        { "location": "92/DIALOG" , "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:navigator】</color>\n\n期間中は、何度でも\n回答を変更できます。\n最後の回答が、その時点での\n貴方の結論となります。\n\n<color=red>現在のあなたの選択は\n【エリカが提案した、今日本を包んでるフェノメノンを蒸着する案がいいと思う】\nです。</color>"},
        { "location": "94/DIALOG" , "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:navigator】</color>\n\n期間中は、何度でも\n回答を変更できます。\n最後の回答が、その時点での\n貴方の結論となります。\n\n<color=red>現在のあなたの選択は\n【今日本を包んでるフェノメノンを飛散させ、元の現実に戻すのがいいと思う】\nです。</color>"},
        { "location": "96/DIALOG" , "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:navigator】</color>\n\n期間中は、何度でも\n回答を変更できます。\n最後の回答が、その時点での\n貴方の結論となります。\n\n<color=red>現在のあなたの選択は\n【今日本を包んでるフェノメノンを、このままずっと持続させるのがいいと思う】\nです。</color>"},
        { "location": "98/DIALOG" , "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:navigator】</color>\n\n期間中は、何度でも\n回答を変更できます。\n最後の回答が、その時点での\n貴方の結論となります。\n\n<color=red>現在のあなたの選択は\n【どれもダメ】\nです。</color>"},
