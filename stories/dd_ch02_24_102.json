        "title": "005 メインストーリー",
        "sub_title": "貴方を憂う手紙＜後編＞"
    },
    "entry":
    [
        { "location": "483/TALK"  , "narrator": "アーヤ", "text": "…ううん。\nやっぱり、ダメ！"},
        { "location": "484/TALK"  , "narrator": "アーヤ", "text": "館長のことはもちろん\n気になるけど、それだけで\n動いたらいけないわ。"},
        { "location": "485/TALK"  , "narrator": "アーヤ", "text": "館長がいない間は、\n私が代わりをしなきゃ\nいけないんだし。"},
        { "location": "486/TALK"  , "narrator": "アーヤ", "text": "…大丈夫。"},
        { "location": "487/TALK"  , "narrator": "アーヤ", "text": "私にはできるって、\n館長は信じてくれたん\nだから…。"},
        { "location": "489/TALK"  , "narrator": "アーヤ", "text": "…ねえ、ギャヴィ。"},
        { "location": "492/TALK"  , "narrator": "ガブリエラ", "text": "ん？　なに？"},
        { "location": "493/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "495/TALK"  , "narrator": "アーヤ", "text": "ううん、ごめん。\n何でもない。"},
        { "location": "496/TALK"  , "narrator": "ガブリエラ", "text": "は？　何よそれ…。\nまあ、いいけど…。"},
        { "location": "497/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "509/TALK"  , "narrator": "アーヤ", "text": "みんなに聞けない質問"},
        { "location": "511/TALK"  , "narrator": "アーヤ", "text": "聞いてくれる？(￣Д￣ )"},
        { "location": "513/SEL"   , "narrator": "", "text": "そのために$me$がいる"},
        { "location": "514/ACT"   , "narrator": "", "text": "そのために$me$がいる"},
        { "location": "516/TALK"  , "narrator": "アーヤ", "text": "ありがと(^^"},
        { "location": "520/TALK"  , "narrator": "アーヤ", "text": "もしもだけど"},
        { "location": "521/TALK"  , "narrator": "アーヤ", "text": "館長が戻ってこなかったら"},
        { "location": "522/TALK"  , "narrator": "アーヤ", "text": "その時は"},
        { "location": "523/TALK"  , "narrator": "アーヤ", "text": "救出に行かないといけないの"},
        { "location": "524/SEL"   , "narrator": "", "text": "ええと？"},
        { "location": "525/SEL"   , "narrator": "", "text": "何？　ゲームの話？"},
        { "location": "526/SEL"   , "narrator": "", "text": "寝坊してるだけじゃない？"},
        { "location": "527/TALK"  , "narrator": "アーヤ", "text": "でも相手は情報管理庁だから"},
        { "location": "528/TALK"  , "narrator": "アーヤ", "text": "こっちの戦力なんて把握されてるだろうし"},
        { "location": "529/TALK"  , "narrator": "アーヤ", "text": "役に立てるのかしら？"},
        { "location": "531/ACT"   , "narrator": "", "text": "ええと？"},
        { "location": "532/TALK"  , "narrator": "アーヤ", "text": "あれ？"},
        { "location": "533/ACT"   , "narrator": "", "text": "何？　ゲームの話？"},
        { "location": "534/TALK"  , "narrator": "アーヤ", "text": "違うわよ"},
        { "location": "535/ACT"   , "narrator": "", "text": "寝坊してるだけじゃない？"},
        { "location": "536/TALK"  , "narrator": "アーヤ", "text": "そうかも"},
        { "location": "537/TALK"  , "narrator": "アーヤ", "text": "だったら"},
        { "location": "538/TALK"  , "narrator": "アーヤ", "text": "いいんだけど"},
        { "location": "540/TALK"  , "narrator": "アーヤ", "text": "えっとね"},
        { "location": "541/TALK"  , "narrator": "アーヤ", "text": "以前館長が私に言ってたの"},
        { "location": "542/TALK"  , "narrator": "アーヤ", "text": "何かあったら後を頼むみたいなこと"},
        { "location": "544/SEL"   , "narrator": "", "text": "把握した"},
        { "location": "545/SEL"   , "narrator": "", "text": "それでいいんじゃない"},
        { "location": "546/SEL"   , "narrator": "", "text": "さすがはアーヤ"},
        { "location": "547/ACT"   , "narrator": "", "text": "把握した"},
        { "location": "548/TALK"  , "narrator": "アーヤ", "text": "よかった"},
        { "location": "549/ACT"   , "narrator": "", "text": "それでいいんじゃない"},
        { "location": "550/TALK"  , "narrator": "アーヤ", "text": "よくないわよ"},
        { "location": "551/ACT"   , "narrator": "", "text": "さすがはアーヤ"},
        { "location": "552/TALK"  , "narrator": "アーヤ", "text": "おだてないでいいから"},
        { "location": "554/TALK"  , "narrator": "アーヤ", "text": "それで"},
        { "location": "556/TALK"  , "narrator": "アーヤ", "text": "その前に助けに行くべきだって思ったんだけど"},
        { "location": "557/TALK"  , "narrator": "アーヤ", "text": "管理庁相手だと無理かもしれない"},
        { "location": "559/SEL"   , "narrator": "", "text": "気弱になるな！"},
        { "location": "560/SEL"   , "narrator": "", "text": "まあそうだろうね……"},
        { "location": "561/SEL"   , "narrator": "", "text": "他に手はないのかな？"},
        { "location": "562/ACT"   , "narrator": "", "text": "気弱になるな！"},
        { "location": "563/TALK"  , "narrator": "アーヤ", "text": "これは冷静な判断よ"},
        { "location": "564/ACT"   , "narrator": "", "text": "まあそうだろうね……"},
        { "location": "565/TALK"  , "narrator": "アーヤ", "text": "やっぱりそうよね、、、"},
        { "location": "566/ACT"   , "narrator": "", "text": "他に手はないのかな？"},
        { "location": "567/TALK"  , "narrator": "アーヤ", "text": "それはもちろん考えるけど"},
        { "location": "569/TALK"  , "narrator": "アーヤ", "text": "館長が戻る間は"},
        { "location": "570/TALK"  , "narrator": "アーヤ", "text": "必然的に私が代わりになるの"},
        { "location": "571/TALK"  , "narrator": "アーヤ", "text": "おかしいこと"},
        { "location": "572/TALK"  , "narrator": "アーヤ", "text": "言ってないわよね？"},
        { "location": "574/SEL"   , "narrator": "", "text": "やるしかないね"},
        { "location": "575/SEL"   , "narrator": "", "text": "どーんといけ"},
        { "location": "576/SEL"   , "narrator": "", "text": "代役くらいならね"},
        { "location": "577/ACT"   , "narrator": "", "text": "やるしかないね"},
        { "location": "579/TALK"  , "narrator": "アーヤ", "text": "そうよね(｡-_-｡)"},
        { "location": "580/TALK"  , "narrator": "アーヤ", "text": "その通りよね"},
        { "location": "581/TALK"  , "narrator": "アーヤ", "text": "代わりになれるか"},
        { "location": "582/TALK"  , "narrator": "アーヤ", "text": "引っ張っていけるか"},
        { "location": "583/TALK"  , "narrator": "アーヤ", "text": "そうじゃなくて"},
        { "location": "584/TALK"  , "narrator": "アーヤ", "text": "やらなきゃダメ(｀ヘ´)"},
        { "location": "585/TALK"  , "narrator": "アーヤ", "text": "それしかないのよね"},
        { "location": "588/TALK"  , "narrator": "アーヤ", "text": "目が覚めたかも(^^"},
        { "location": "590/TALK"  , "narrator": "アーヤ", "text": "私、やるわ"},
        { "location": "592/SEL"   , "narrator": "", "text": "困った時のサポートは任せろ"},
        { "location": "593/ACT"   , "narrator": "", "text": "困った時のサポートは任せろ"},
        { "location": "596/TALK"  , "narrator": "アーヤ", "text": "なら"},
        { "location": "597/TALK"  , "narrator": "アーヤ", "text": "困った時は"},
        { "location": "598/TALK"  , "narrator": "アーヤ", "text": "甘えさせてね(・・。)ゞ"},
        { "location": "599/ACT"   , "narrator": "", "text": "どーんといけ"},
        { "location": "601/TALK"  , "narrator": "アーヤ", "text": "未熟者の私に"},
        { "location": "602/TALK"  , "narrator": "アーヤ", "text": "みんな引っ張っていけるかしら？(-ω-;)"},
        { "location": "603/TALK"  , "narrator": "アーヤ", "text": "$handle$はどう思う？"},
        { "location": "604/TALK"  , "narrator": "アーヤ", "text": "って"},
        { "location": "605/TALK"  , "narrator": "アーヤ", "text": "どーんといけだもんね"},
        { "location": "606/TALK"  , "narrator": "アーヤ", "text": "どーんといくわよ"},
        { "location": "608/SEL"   , "narrator": "", "text": "やるしかないだろ"},
        { "location": "609/ACT"   , "narrator": "", "text": "やるしかないだろ"},
        { "location": "612/ACT"   , "narrator": "", "text": "代役くらいならね"},
        { "location": "613/TALK"  , "narrator": "アーヤ", "text": "そうだったわ"},
        { "location": "614/TALK"  , "narrator": "アーヤ", "text": "私が館長の代わりに"},
        { "location": "615/TALK"  , "narrator": "アーヤ", "text": "隊長をやること"},
        { "location": "616/TALK"  , "narrator": "アーヤ", "text": "まだ本決まりなわけじゃないわね(>_<)"},
        { "location": "617/TALK"  , "narrator": "アーヤ", "text": "もしかしたら"},
        { "location": "618/TALK"  , "narrator": "アーヤ", "text": "話し合いが長引いてるだけかも(-.-;)"},
        { "location": "621/TALK"  , "narrator": "アーヤ", "text": "最悪の展開ばかり考えてた"},
        { "location": "622/TALK"  , "narrator": "アーヤ", "text": "混乱してたみたい(´o｀；"},
        { "location": "623/TALK"  , "narrator": "アーヤ", "text": "そもそも館長って"},
        { "location": "624/TALK"  , "narrator": "アーヤ", "text": "簡単にどうにかなるような"},
        { "location": "625/TALK"  , "narrator": "アーヤ", "text": "そんな人じゃなかったわ(^^"},
        { "location": "628/TALK"  , "narrator": "アーヤ", "text": "ちょっと"},
        { "location": "629/TALK"  , "narrator": "アーヤ", "text": "落ち着かなくちゃ"},
        { "location": "641/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "642/TALK"  , "narrator": "アーヤ", "text": "そうよね。"},
        { "location": "643/TALK"  , "narrator": "アーヤ", "text": "館長が帰ってくる\nまでの代役なら、\n私にもできるはず。"},
        { "location": "645/TALK"  , "narrator": "アーヤ", "text": "ギャヴィ…。\n私、頑張るから。"},
        { "location": "647/TALK"  , "narrator": "ガブリエラ", "text": "は？"},
        { "location": "649/TALK"  , "narrator": "アーヤ", "text": "ううん…。\n聞いてもらいたかった\nだけ。"},
        { "location": "650/TALK"  , "narrator": "ガブリエラ", "text": "…変なの。"},
        { "location": "651/TALK"  , "narrator": "アーヤ", "text": "…代役くらいは、\n私が勤めます。"},
        { "location": "652/TALK"  , "narrator": "アーヤ", "text": "だから…無事な顔を\n見せてくださいよ、\n館長…。"},
        { "location": "663/DIALOG", "narrator": "Dialog_chapter_ch02", "text": "【20 ２０１６】"}
    ]
}
