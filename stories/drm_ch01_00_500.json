{
    "dir": "dramatics/daydra/drm_ch01_00_500.js",
    "type": "Episode",
    "info": {
        "story_id": "1050",
        "cid": "tsubame",
        "title": "らぶとーく 第50話",
        "sub_title": "優先順位"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "優先順位"},
        { "location": "21/TALK"   , "narrator": "アーヤ", "text": "…ここよね、卯月が\nヘリに乗って消えたの\nって。"},
        { "location": "25/TALK"   , "narrator": "みやび", "text": "間違いないちや。"},
        { "location": "28/TALK"   , "narrator": "みやび", "text": "そしてここが、\nつばめちゃんが卯月に\n殺されかけてた場所ちや。"},
        { "location": "30/TALK"   , "narrator": "つばめ", "text": "…やっぱり、この場所に\n戻ってくるのは、\nちょっと辛いかも。"},
        { "location": "31/TALK"   , "narrator": "ガブリエラ", "text": "…つばめ、あんたは\n帰っていいのよ？"},
        { "location": "33/TALK"   , "narrator": "つばめ", "text": "だ、大丈夫だよ。\n心配してくれて\nありがと。"},
        { "location": "35/TALK"   , "narrator": "ガブリエラ", "text": "ち、違うわよ！"},
        { "location": "36/TALK"   , "narrator": "ガブリエラ", "text": "そんな暗い顔で隣に\nいられると、気が散って\n仕方がないだけだから！"},
        { "location": "37/TALK"   , "narrator": "ガブリエラ", "text": "…っていうか、わざわざ\n検証しに戻ってくる\n必要あったの？"},
        { "location": "38/TALK"   , "narrator": "ガブリエラ", "text": "神楽が裏切ったのは\n事実なんだし――"},
        { "location": "40/TALK"   , "narrator": "ガブリエラ", "text": "連れ去ったのが管理庁\nだっていうのもわかって\nるのに…。"},
        { "location": "42/TALK"   , "narrator": "アーヤ", "text": "つばめの言う通り、\n卯月に何かしらの理由が\nあるんだとしたら――"},
        { "location": "43/TALK"   , "narrator": "アーヤ", "text": "もしかしたら、手掛かりに\nなるような物をわざと\n落としていって――"},
        { "location": "44/TALK"   , "narrator": "アーヤ", "text": "私達に何かを伝えようと\nしてる可能性もある\nでしょ？"},
        { "location": "47/TALK"   , "narrator": "ガブリエラ", "text": "…アーヤも、神楽のことを\n信じてるの？"},
        { "location": "49/TALK"   , "narrator": "アーヤ", "text": "…わからない。"},
        { "location": "51/TALK"   , "narrator": "アーヤ", "text": "けど、つばめのことは\n信じてるから――"},
        { "location": "52/TALK"   , "narrator": "アーヤ", "text": "一度検証してみても\nいいと思ったのよ。"},
        { "location": "53/TALK"   , "narrator": "みやび", "text": "けんど、何も残っては\nなさそうやね。"},
        { "location": "55/TALK"   , "narrator": "つばめ", "text": "…………。"},
        { "location": "58/TALK"   , "narrator": "ガブリエラ", "text": "そういえばさ、どうしても\nわからないことがあるん\nだけど――"},
        { "location": "59/TALK"   , "narrator": "ガブリエラ", "text": "つばめ、あの時神楽に\n対して、無抵抗だった\nように見えたけど――"},
        { "location": "60/TALK"   , "narrator": "ガブリエラ", "text": "あれ、どういうこと？"},
        { "location": "61/TALK"   , "narrator": "つばめ", "text": "えっ…。"},
        { "location": "62/SEL"    , "narrator": "", "text": "暴力が嫌いだから？"},
        { "location": "63/SEL"    , "narrator": "", "text": "抵抗できなかった？"},
        { "location": "64/SEL"    , "narrator": "", "text": "死にたかったってことはないよね"},
        { "location": "67/TALK"   , "narrator": "みやび", "text": "そういえば、まったく\n抵抗してる感じが\nしなかった気がするちや。"},
        { "location": "68/TALK"   , "narrator": "みやび", "text": "ちっくとは暴れるくらい\nするんが普通やないが？"},
        { "location": "69/TALK"   , "narrator": "アーヤ", "text": "そうね。\n手足を抑えられていた\nわけでもないんだし…。"},
        { "location": "72/TALK"   , "narrator": "ガブリエラ", "text": "…まさかつばめ、\n死にたかった、なんて\n言わないわよね？"},
        { "location": "74/TALK"   , "narrator": "つばめ", "text": "…………。"},
        { "location": "75/TALK"   , "narrator": "ガブリエラ", "text": "…あんた、まさか！"},
        { "location": "77/TALK"   , "narrator": "つばめ", "text": "ち、違うよ！\n死にたいなんて、\n一度も思ったことないよ。"},
        { "location": "78/TALK"   , "narrator": "つばめ", "text": "ただ、あの時は――"},
        { "location": "79/TALK"   , "narrator": "つばめ", "text": "このまま殺されても、\nいいかも、って…。"},
        { "location": "82/TALK"   , "narrator": "ガブリエラ", "text": "バカ！！"},
        { "location": "83/TALK"   , "narrator": "ガブリエラ", "text": "あんた、自分が何言って\nるかわかってんの！？"},
        { "location": "84/TALK"   , "narrator": "ガブリエラ", "text": "殺されてもいいなんて\nこと、あるわけない\nでしょ！！"},
        { "location": "87/TALK"   , "narrator": "つばめ", "text": "で、でもあの時は、\n本当に…。"},
        { "location": "88/TALK"   , "narrator": "ガブリエラ", "text": "それがおかしいって\n言ってんのよ！！"},
        { "location": "89/TALK"   , "narrator": "アーヤ", "text": "ギャヴィの言う通りよ。"},
        { "location": "90/TALK"   , "narrator": "アーヤ", "text": "何で殺されてもいいとか\n思ったの？"},
        { "location": "91/TALK"   , "narrator": "アーヤ", "text": "そんなに自分の命を\n軽く思ってるわけ？"},
        { "location": "92/TALK"   , "narrator": "つばめ", "text": "そ、そういうわけじゃ…。"},
        { "location": "93/TALK"   , "narrator": "みやび", "text": "そうとしか聞こえん\nかったよ。"},
        { "location": "94/TALK"   , "narrator": "みやび", "text": "つばめちゃん、今の発言は\n誰が聞いてもおかしいと\n思うぞね。"},
        { "location": "96/TALK"   , "narrator": "つばめ", "text": "で、でも、神楽ちゃんが…。"},
        { "location": "98/TALK"   , "narrator": "みやび", "text": "えい加減にしぃ！！"},
        { "location": "100/TALK"  , "narrator": "みやび", "text": "神楽神楽言う前に、\n自分のことをもっと\n大切にしぃ！！"},
        { "location": "101/TALK"  , "narrator": "アーヤ", "text": "つばめは、卯月のこと\n以外はどうでもいいと\n思ってるわけ？"},
        { "location": "102/TALK"  , "narrator": "アーヤ", "text": "あなたが死んだら、\n私達や日向さん達は\nもちろん――"},
        { "location": "103/TALK"  , "narrator": "アーヤ", "text": "あなたのお父さんや\nお母さんも、凄く悲しむ\nのよ？"},
        { "location": "104/TALK"  , "narrator": "アーヤ", "text": "そのことを、少しも\n考えなかったの！？"},
        { "location": "107/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "108/TALK"  , "narrator": "ガブリエラ", "text": "あんたにとっては、\n神楽以外の人間は、\nどうだっていいのね？"},
        { "location": "110/TALK"  , "narrator": "つばめ", "text": "そ、そんなことない！\nそうじゃないんだけど、\nただ…。"},
        { "location": "111/TALK"  , "narrator": "ガブリエラ", "text": "だったら！"},
        { "location": "112/TALK"  , "narrator": "ガブリエラ", "text": "殺されても良いなんて、\n軽々しく思わないでよ！"},
        { "location": "114/TALK"  , "narrator": "ガブリエラ", "text": "そうじゃなきゃ、\nつばめの言うこと…\n何も信用できない。"},
        { "location": "116/TALK"  , "narrator": "ガブリエラ", "text": "どうせ卯月のことしか\n考えてない言葉なんだ、\nって…。"},
        { "location": "118/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "119/TALK"  , "narrator": "アーヤ", "text": "私とみやびも、ギャヴィと\n同じ気持ちよ。"},
        { "location": "120/TALK"  , "narrator": "アーヤ", "text": "つばめ…お願いだから、\nもっと自分の命を\n大切に想って。"},
        { "location": "121/TALK"  , "narrator": "みやび", "text": "それだけやない。"},
        { "location": "122/TALK"  , "narrator": "みやび", "text": "つばめちゃんのことを\n大切に想っちゅう――"},
        { "location": "123/TALK"  , "narrator": "みやび", "text": "うちらのことも、\nちっくとでえいき、\n考えてほしいが…。"},
        { "location": "124/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "126/ACT"   , "narrator": "", "text": "暴力が嫌いだから？"},
        { "location": "143/TALK"  , "narrator": "つばめ", "text": "それはそぅかもしれなぃんだけど(´･ω･｀) "},
        { "location": "144/TALK"  , "narrator": "つばめ", "text": "でも"},
        { "location": "145/TALK"  , "narrator": "つばめ", "text": "あの時はそれだけじゃなかったの"},
        { "location": "158/TALK"  , "narrator": "つばめ", "text": "…あの時――"},
        { "location": "159/TALK"  , "narrator": "つばめ", "text": "わたし、思ったんです…。"},
        { "location": "160/TALK"  , "narrator": "つばめ", "text": "神楽ちゃんになら、\nこのまま殺されても\nいいかも、って…。"},
        { "location": "162/ACT"   , "narrator": "", "text": "抵抗できなかった"},
        { "location": "179/TALK"  , "narrator": "つばめ", "text": "ぅぅん"},
        { "location": "180/TALK"  , "narrator": "つばめ", "text": "しよぅと思えばできたけど"},
        { "location": "181/TALK"  , "narrator": "つばめ", "text": "あの時はそぅ思わなかったの"},
        { "location": "194/TALK"  , "narrator": "つばめ", "text": "…あの時は、抵抗しよう\nって気持ち、まったく\nなかったんです…。"},
        { "location": "195/TALK"  , "narrator": "アーヤ", "text": "…どういうこと？"},
        { "location": "196/TALK"  , "narrator": "つばめ", "text": "その…このまま神楽ちゃんに\n殺されても、いいかも、\nって思えて…。"},
        { "location": "198/ACT"   , "narrator": "", "text": "死にたかったってことはないよね"},
        { "location": "215/TALK"  , "narrator": "つばめ", "text": "それはなぃよΣ(ﾟдﾟlll)"},
        { "location": "216/TALK"  , "narrator": "つばめ", "text": "死にたぃなんて思ったこと"},
        { "location": "217/TALK"  , "narrator": "つばめ", "text": "一度もなぃから(●´ω｀●)ゞ"},
        { "location": "230/TALK"  , "narrator": "つばめ", "text": "…死にたいって気持ちは、\n少しもなかったんです。"},
        { "location": "231/TALK"  , "narrator": "みやび", "text": "そりゃ当然やね。\n誰だって死にたい思う\n人間はいないき。"},
        { "location": "233/TALK"  , "narrator": "つばめ", "text": "そう、ですよね…。"},
        { "location": "234/TALK"  , "narrator": "つばめ", "text": "でも、それなのに私――"},
        { "location": "235/TALK"  , "narrator": "つばめ", "text": "あの時は、このまま\n神楽ちゃんに殺されても、\nいいかもって――"},
        { "location": "236/TALK"  , "narrator": "つばめ", "text": "そんなことを、\n本気で思ってて…。"},
        { "location": "20/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>8月某日　 6:13 PM</color>\n合宿中、神楽が去った海岸にて"}
    ]
}
