{
    "dir": "chap13/daydra/dd_ch02_13_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "13252",
        "cid": "ayami",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "子供と遭遇"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "子供と遭遇"},
        { "location": "21/TALK"   , "narrator": "雛", "text": "綾水様、\n今朝は素敵でした！"},
        { "location": "24/TALK"   , "narrator": "アーヤ", "text": "？　何が？"},
        { "location": "25/TALK"   , "narrator": "雛", "text": "転んで泣いてた\n男の子を、助けてたじゃ\nないですかー。"},
        { "location": "27/TALK"   , "narrator": "アーヤ", "text": "ああ、あのことね。"},
        { "location": "29/TALK"   , "narrator": "雛", "text": "ビックリしました。\n綾水様って、子供の相手が\n凄くお上手なんですね。"},
        { "location": "30/TALK"   , "narrator": "つばめ", "text": "上手って、どういうこと？"},
        { "location": "32/TALK"   , "narrator": "雛", "text": "泣いてた男の子がね、\n綾水様に何か言われた\n瞬間――"},
        { "location": "33/TALK"   , "narrator": "雛", "text": "ピタッと泣き止んで、\n自分で立ち上がったの。"},
        { "location": "34/TALK"   , "narrator": "つばめ", "text": "す、凄いよそれ。\nアーヤさん、どんな魔法を\n使ったんですか？"},
        { "location": "36/TALK"   , "narrator": "アーヤ", "text": "大げさね。\n普通に声を掛けただけよ。"},
        { "location": "38/TALK"   , "narrator": "アーヤ", "text": "ああいう時って驚いて\n泣いてるだけだから、\n意外とすぐ泣き止むのよ。"},
        { "location": "39/TALK"   , "narrator": "つばめ", "text": "…アーヤさん、\n詳しいんですね。"},
        { "location": "42/TALK"   , "narrator": "アーヤ", "text": "そ、そうかしら？"},
        { "location": "43/SEL"    , "narrator": "", "text": "本で学んだとか？"},
        { "location": "44/SEL"    , "narrator": "", "text": "もしかして、経験談？"},
        { "location": "45/SEL"    , "narrator": "", "text": "子供好きだからね"},
        { "location": "49/TALK"   , "narrator": "雛", "text": "それはやっぱり、\n綾水様が大人だから\nじゃないかなー？"},
        { "location": "51/TALK"   , "narrator": "つばめ", "text": "大人だから？"},
        { "location": "53/TALK"   , "narrator": "雛", "text": "うん、なんて言うのかな？"},
        { "location": "54/TALK"   , "narrator": "雛", "text": "ほら、なんか自然と\nそういうことわかっちゃい\nそうな感じしない？"},
        { "location": "55/TALK"   , "narrator": "つばめ", "text": "あはは、言われてみると\n確かにそうかも。"},
        { "location": "60/TALK"   , "narrator": "アーヤ", "text": "…私が何も言わない間に、\n結論が出ちゃったみたい。"},
        { "location": "61/TALK"   , "narrator": "アーヤ", "text": "まあ、二人が言うほど\nわかってるつもりは\nないんだけど――"},
        { "location": "62/TALK"   , "narrator": "アーヤ", "text": "そういう風に見えてる\nなら、ちょっと嬉しいな。"},
        { "location": "64/ACT"    , "narrator": "", "text": "本で学んだとか？"},
        { "location": "84/TALK"   , "narrator": "アーヤ", "text": "ナイスアドバイス！"},
        { "location": "85/TALK"   , "narrator": "アーヤ", "text": "どう答えようか迷ってたところだったの"},
        { "location": "86/TALK"   , "narrator": "アーヤ", "text": "本で知った、って答え方"},
        { "location": "87/TALK"   , "narrator": "アーヤ", "text": "凄く便利よね"},
        { "location": "88/TALK"   , "narrator": "アーヤ", "text": "それで行くわ(^^)"},
        { "location": "101/TALK"  , "narrator": "アーヤ", "text": "本で読んだことが\nあるのよ。"},
        { "location": "102/TALK"  , "narrator": "アーヤ", "text": "子供はビックリすると、\nそれが理由で泣きだす\nことがよくある、ってね。"},
        { "location": "104/TALK"  , "narrator": "つばめ", "text": "そうなんですかぁ。\n勉強になります。"},
        { "location": "105/TALK"  , "narrator": "雛", "text": "…っていうか――"},
        { "location": "106/TALK"  , "narrator": "雛", "text": "子供に関する本を読んだ\nことがある、っていうのが\n驚きです。"},
        { "location": "109/TALK"  , "narrator": "アーヤ", "text": "ま、まあほら、あれよ。\n誰でもいずれは必要に\nなる知識だし…。"},
        { "location": "110/TALK"  , "narrator": "アーヤ", "text": "もちろん、今はそんな\n予定はないけど――"},
        { "location": "114/TALK"  , "narrator": "アーヤ", "text": "早いうちに読んでおいても\n損はないかな、って\n思ったのよ。"},
        { "location": "115/TALK"  , "narrator": "雛", "text": "そうだったんですか…。"},
        { "location": "116/TALK"  , "narrator": "雛", "text": "あたしも、今度読んで\nみようかなぁ？"},
        { "location": "120/TALK"  , "narrator": "アーヤ", "text": "…自分で言ったことでは\nあるけど、将来的に絶対\n必要になるんだし――"},
        { "location": "121/TALK"  , "narrator": "アーヤ", "text": "私も読んでおいた方が\nよさそうね。"},
        { "location": "122/ACT"   , "narrator": "", "text": "もしかして、経験談？"},
        { "location": "143/TALK"  , "narrator": "アーヤ", "text": "そういうわけじゃないけど"},
        { "location": "144/TALK"  , "narrator": "アーヤ", "text": "経験談なら、いいのがあるわ"},
        { "location": "156/TALK"  , "narrator": "アーヤ", "text": "まあ、自分が子供の時の\nことを思い出せば――"},
        { "location": "157/TALK"  , "narrator": "アーヤ", "text": "なんとなくだけど\nどうすればいいか\nわかると思うわ。"},
        { "location": "158/TALK"  , "narrator": "雛", "text": "自分の子供時代…\nあ～、そういえば――"},
        { "location": "159/TALK"  , "narrator": "雛", "text": "私も転んだりした時は、\n痛みじゃなくてビックリ\nして泣いてました。"},
        { "location": "161/TALK"  , "narrator": "アーヤ", "text": "私もよ。\n小さい頃は、転ぶたびに\n泣いてたわ…。"},
        { "location": "163/TALK"  , "narrator": "つばめ", "text": "そうだったんですか！？"},
        { "location": "165/TALK"  , "narrator": "アーヤ", "text": "うん。擦りむいたかも、\nって思い込んじゃって、\nいつも泣いてた。"},
        { "location": "166/TALK"  , "narrator": "雛", "text": "何だか、今とは結構\nイメージが違います\nけど――。"},
        { "location": "167/TALK"  , "narrator": "雛", "text": "凄く可愛いと思います！"},
        { "location": "169/TALK"  , "narrator": "アーヤ", "text": "ありがと…でも、ちょっと\n恥ずかしいから、この話は\nおしまいね。"},
        { "location": "170/ACT"   , "narrator": "", "text": "子供好きだからね"},
        { "location": "191/TALK"  , "narrator": "アーヤ", "text": "…そうね"},
        { "location": "192/TALK"  , "narrator": "アーヤ", "text": "大切なのはその気持ちよね？"},
        { "location": "203/TALK"  , "narrator": "雛", "text": "私も、あんなふうに\n子供の対応が出来る\n大人になりたいなぁ…。"},
        { "location": "205/TALK"  , "narrator": "アーヤ", "text": "子供が好き、って気持ちが\n大切なんじゃない？"},
        { "location": "206/TALK"  , "narrator": "つばめ", "text": "アーヤさんって、\n子供好きなんですか？"},
        { "location": "209/TALK"  , "narrator": "アーヤ", "text": "あら、知らなかった？\n私は子供のことが\n大好きよ。"},
        { "location": "210/TALK"  , "narrator": "アーヤ", "text": "だから、泣いてる姿を\n見たら心配になっちゃ\nうのかもしれないわ。"},
        { "location": "213/TALK"  , "narrator": "つばめ", "text": "そっか…子供嫌い\nだったらそんな気持ちには\nなりませんよね。"},
        { "location": "214/TALK"  , "narrator": "雛", "text": "そうだね。\nなんか、納得しました。"},
        { "location": "216/TALK"  , "narrator": "アーヤ", "text": "それなら良かったわ。"},
        { "location": "19/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>7月8日　12:45 PM</color>\nとある平日の昼休み、学園前庭にて。"}
    ]
}
