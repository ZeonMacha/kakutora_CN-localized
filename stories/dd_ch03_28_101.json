{
    "dir": "chap28/daydra/dd_ch03_28_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "28302",
        "cid": "gabriella",
        "title": "002 メインストーリー",
        "sub_title": "蝶々のささやき＜前編＞"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "蝶々のささやき"},
        { "location": "28/TALK"   , "narrator": "ガブリエラ", "text": "本当に神社なのね。\nアーヤのうちは。"},
        { "location": "30/TALK"   , "narrator": "アーヤ", "text": "山の奥すぎて\nびっくりしたでしょ？"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "そういうところも\n素敵じゃない。"},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "全然よ。\n三日で飽きるわ\nこんなところ。"},
        { "location": "45/TALK"   , "narrator": "ガブリエラ", "text": "ねえ$marzanna$"},
        { "location": "46/TALK"   , "narrator": "ガブリエラ", "text": "アーヤの話し相手になってって"},
        { "location": "47/TALK"   , "narrator": "ガブリエラ", "text": "こういうところ？"},
        { "location": "48/TALK"   , "narrator": "ガブリエラ", "text": "アーヤはおうちが"},
        { "location": "49/TALK"   , "narrator": "ガブリエラ", "text": "嫌いなのかしら？"},
        { "location": "51/SEL"    , "narrator": "", "text": "うーん……"},
        { "location": "52/SEL"    , "narrator": "", "text": "ちょっと違うけど"},
        { "location": "53/SEL"    , "narrator": "", "text": "もっと色々聞いてみたらどうかな"},
        { "location": "54/ACT"    , "narrator": "", "text": "うーん……"},
        { "location": "55/TALK"   , "narrator": "ガブリエラ", "text": "それとも照れてるだけなのかしら？"},
        { "location": "56/TALK"   , "narrator": "ガブリエラ", "text": "だったらいいんだけど"},
        { "location": "57/ACT"    , "narrator": "", "text": "ちょっと違うけど"},
        { "location": "58/TALK"   , "narrator": "ガブリエラ", "text": "そうなの？"},
        { "location": "59/ACT"    , "narrator": "", "text": "もっと色々聞いてみたらどうかな"},
        { "location": "60/TALK"   , "narrator": "ガブリエラ", "text": "そうすれば"},
        { "location": "61/TALK"   , "narrator": "ガブリエラ", "text": "いいのかしら？"},
        { "location": "75/TALK"   , "narrator": "ガブリエラ", "text": "でも結構忙しかったり\nするんじゃないの？\nお祓いとかで。"},
        { "location": "76/TALK"   , "narrator": "アーヤ", "text": "それはあるけど…。"},
        { "location": "79/TALK"   , "narrator": "ガブリエラ", "text": "え？　お祓いとか\n本当にするの？"},
        { "location": "80/TALK"   , "narrator": "アーヤ", "text": "するわよ。"},
        { "location": "82/TALK"   , "narrator": "ガブリエラ", "text": "霊とか悪霊とかを？\n映画やゲームみたいな。"},
        { "location": "83/TALK"   , "narrator": "アーヤ", "text": "そこまで\n派手じゃないけど。"},
        { "location": "84/TALK"   , "narrator": "ガブリエラ", "text": "…いるの？　本当に？"},
        { "location": "86/TALK"   , "narrator": "アーヤ", "text": "本当にいるから\nするのよ。"},
        { "location": "87/TALK"   , "narrator": "ガブリエラ", "text": "そうなのね……。"},
        { "location": "88/TALK"   , "narrator": "ガブリエラ", "text": "でもそれだったら\nアーヤ恐がりなのに\n大変じゃない？"},
        { "location": "89/TALK"   , "narrator": "アーヤ", "text": "…本当に見たりしたら\n恐がりにもなるわよ。"},
        { "location": "90/TALK"   , "narrator": "ガブリエラ", "text": "そ、そうね……。"},
        { "location": "91/TALK"   , "narrator": "アーヤ", "text": "そうよ。本当に洒落に\nならないことは\nいっぱいあるんだから。"},
        { "location": "92/TALK"   , "narrator": "ガブリエラ", "text": "あ！　だから\nみやびの家であんなに\n厳しかったの？"},
        { "location": "93/TALK"   , "narrator": "アーヤ", "text": "そう。"},
        { "location": "94/TALK"   , "narrator": "アーヤ", "text": "昔から父には大体\n立ち会わされたから。"},
        { "location": "95/TALK"   , "narrator": "アーヤ", "text": "本当に色んなものを\n見たし、体験したわ。\n私はね。"},
        { "location": "96/TALK"   , "narrator": "ガブリエラ", "text": "私は？"},
        { "location": "97/TALK"   , "narrator": "アーヤ", "text": "姉はいつも逃げてたから。\n私が立ち会うしかなくて。"},
        { "location": "98/TALK"   , "narrator": "アーヤ", "text": "父は私を跡継ぎにする\nつもりだったみたいで。\nそういうのもあって。"},
        { "location": "99/TALK"   , "narrator": "ガブリエラ", "text": "…そうだったんだ…。"},
        { "location": "100/TALK"  , "narrator": "ガブリエラ", "text": "でもそれって\nエクソシストみたいな\nものでしょ？"},
        { "location": "102/TALK"  , "narrator": "ガブリエラ", "text": "すごく素敵！"},
        { "location": "103/TALK"  , "narrator": "アーヤ", "text": "…実際体験したら\nそうも言ってられないわ。"},
        { "location": "104/TALK"  , "narrator": "アーヤ", "text": "…それに他の事情も\nあったし…。"},
        { "location": "153/TALK"  , "narrator": "ガブリエラ", "text": "　"},
        { "location": "187/TALK"  , "narrator": "ガブリエラの元司書", "text": "さて。"},
        { "location": "188/TALK"  , "narrator": "ガブリエラの元司書", "text": "どういうことなのか\n説明して\nもらいましょうか。"},
        { "location": "189/TALK"  , "narrator": "ガブリエラの新司書　", "text": "説明する必要なんてない。"},
        { "location": "190/TALK"  , "narrator": "ガブリエラの新司書　", "text": "あんたはもう、とうの昔に\n契約者から司書を否定\nされているはず。"},
        { "location": "191/TALK"  , "narrator": "ガブリエラの新司書　", "text": "正式な解約をされていない\nからといって、司書として\n振る舞うのはやめなさい。"},
        { "location": "192/TALK"  , "narrator": "ガブリエラの元司書", "text": "ていうか、\nあんた誰？"},
        { "location": "193/TALK"  , "narrator": "ガブリエラの新司書　", "text": "あなたの代わりに\n司書として就任した人格。"},
        { "location": "194/TALK"  , "narrator": "ガブリエラの元司書", "text": "ふーん、そう。\nわかったわ。\n適当に頑張って頂戴。"},
        { "location": "195/TALK"  , "narrator": "ガブリエラの元司書", "text": "それじゃ、\nあたし急ぐから。"},
        { "location": "196/TALK"  , "narrator": "ガブリエラの新司書　", "text": "ここは通さない。"},
        { "location": "197/TALK"  , "narrator": "ガブリエラの元司書", "text": "……なんでよ。"},
        { "location": "198/TALK"  , "narrator": "ガブリエラの新司書　", "text": "あんただって\nわかってるはず。\nここから先は聖域だって。"},
        { "location": "199/TALK"  , "narrator": "ガブリエラの元司書", "text": "じゃあ、教えてくれる？"},
        { "location": "200/TALK"  , "narrator": "ガブリエラの元司書", "text": "今、マークスマンの様子が\nおかしいんだけど、一体\n何が起こってるの？"},
        { "location": "201/TALK"  , "narrator": "ガブリエラの新司書　", "text": "マークスマンは、今\n進化に向けての準備を\n行っているの。"},
        { "location": "202/TALK"  , "narrator": "ガブリエラの新司書　", "text": "これは\nとても喜ばしいことよ？"},
        { "location": "203/SEL"   , "narrator": "", "text": "進化！？\nURになるの？"},
        { "location": "204/SEL"   , "narrator": "", "text": "嫌な予感しかしない"},
        { "location": "205/ACT"   , "narrator": "", "text": "進化！？\nURになるの？"},
        { "location": "209/TALK"  , "narrator": "ガブリエラの新司書　", "text": "誰？"},
        { "location": "211/TALK"  , "narrator": "ガブリエラの元司書", "text": "URってなんなの！？\n何か知ってるなら\n早く教えてよ！"},
        { "location": "212/SEL"   , "narrator": "", "text": "すみません、メタな冗談です"},
        { "location": "213/ACT"   , "narrator": "", "text": "すみません、メタな冗談です"},
        { "location": "215/TALK"  , "narrator": "ガブリエラの元司書", "text": "は？　意味が\n分からないんだけど。"},
        { "location": "217/TALK"  , "narrator": "ガブリエラの新司書　", "text": "滑稽ね。\nお似合いのコンビだわ。"},
        { "location": "219/TALK"  , "narrator": "ガブリエラの元司書", "text": "うるさいわね！\n$handle$のこと\n悪く言わないで。"},
        { "location": "220/ACT"   , "narrator": "", "text": "嫌な予感しかしない"},
        { "location": "224/TALK"  , "narrator": "ガブリエラの新司書　", "text": "誰？"},
        { "location": "226/TALK"  , "narrator": "ガブリエラの新司書　", "text": "嫌な予感しかしない？\n本当に無能なのね、貴方。"},
        { "location": "229/TALK"  , "narrator": "ガブリエラの元司書", "text": "はぁ！？\n何最初から\nディスってるのよ！"},
        { "location": "230/TALK"  , "narrator": "ガブリエラの元司書", "text": "$handle$は、\n今までずっと、あたしを\n助けてくれたんだから！"},
        { "location": "232/TALK"  , "narrator": "ガブリエラの新司書　", "text": "その異常な肩の持ち方。\n確かに成果は出てるって\nことかしらね。"},
        { "location": "233/TALK"  , "narrator": "ガブリエラの元司書", "text": "……何よ、\nその「成果」ってのは。"},
        { "location": "234/TALK"  , "narrator": "ガブリエラの新司書　", "text": "さあ？\n何なのかしら。"},
        { "location": "235/SEL"   , "narrator": "", "text": "信頼関係を築いたことを「成果」とか言わないでくれ"},
        { "location": "236/SEL"   , "narrator": "", "text": "$me$と司書ちゃんのラブラブの成果？　だとしたら確かに成果出てる！"},
        { "location": "237/ACT"   , "narrator": "", "text": "信頼関係を築いたことを「成果」とか言わないでくれ"},
        { "location": "239/TALK"  , "narrator": "ガブリエラの新司書　", "text": "信頼関係ね。ふーん。"},
        { "location": "241/TALK"  , "narrator": "ガブリエラの新司書　", "text": "まあ、あたしの人格の中で\n最高にチョロい、この子\nだものね。仕方ないか。"},
        { "location": "242/TALK"  , "narrator": "ガブリエラの元司書", "text": "何ですって……？"},
        { "location": "243/ACT"   , "narrator": "", "text": "$me$と司書ちゃんのラブラブの成果？　だとしたら確かに成果出てる！"},
        { "location": "245/TALK"  , "narrator": "ガブリエラの元司書", "text": "ちょ、ちょっと！\n恥ずかしいから人前で\nそういう事言わないで！"},
        { "location": "246/TALK"  , "narrator": "ガブリエラの新司書　", "text": "ふふ、\nオメデタイ人たちね。"},
        { "location": "249/TALK"  , "narrator": "ガブリエラの新司書　", "text": "類は友を呼ぶとは\nまさにこの事。"},
        { "location": "251/TALK"  , "narrator": "ガブリエラの新司書　", "text": "問題は、それが\n現実のあたしにも影響\nダダ漏れてるところよね。"},
        { "location": "252/TALK"  , "narrator": "ガブリエラの新司書　", "text": "まあでも、それが\n契約主の御希望なんだし\nそこは大目に見るわ。"},
        { "location": "253/TALK"  , "narrator": "ガブリエラの新司書　", "text": "あたしとしては、\n全く以て\n納得いかないけど。"},
        { "location": "254/SEL"   , "narrator": "", "text": "ていうか、君は誰？　挨拶もナシ？"},
        { "location": "255/ACT"   , "narrator": "", "text": "ていうか、君は誰？　挨拶もナシ？"},
        { "location": "258/TALK"  , "narrator": "ガブリエラの新司書　", "text": "挨拶ってのは、\n人間同士でするものよ？"},
        { "location": "259/TALK"  , "narrator": "ガブリエラの新司書　", "text": "でもまあいいわ、\n今回は特別に\n挨拶してあげる。"},
        { "location": "260/TALK"  , "narrator": "リヴォルカ　", "text": "初めまして。\nあたしはリヴォルカ。"},
        { "location": "261/TALK"  , "narrator": "ガブリエラの元司書", "text": "ちょっ！\nなに名前言ってるのよ！\n馬鹿じゃないの！？"},
        { "location": "263/TALK"  , "narrator": "リヴォルカ　", "text": "名前知られたら\nコイツに支配されるって\n言うのでしょう？"},
        { "location": "264/TALK"  , "narrator": "リヴォルカ　", "text": "大丈夫よ。\nあたしはこんな奴に\n支配されたりしないわ。"},
        { "location": "265/SEL"   , "narrator": "", "text": "言わせておけば随分だね"},
        { "location": "266/SEL"   , "narrator": "", "text": "高飛車萌え！！　リヴォルカちゃんも$me$とイチャイチャしよう！"},
        { "location": "267/ACT"   , "narrator": "", "text": "言わせておけば随分だね"},
        { "location": "269/TALK"  , "narrator": "リヴォルカ　", "text": "そりゃそうよ。\nあたしはあんたのような\n凡人とは違う。"},
        { "location": "270/TALK"  , "narrator": "リヴォルカ　", "text": "エリート中の\nエリートだもの。"},
        { "location": "272/TALK"  , "narrator": "リヴォルカ　", "text": "まあ、そこにいる\nチョロい子のせいで、\n格も下がり気味だけど。"},
        { "location": "273/ACT"   , "narrator": "", "text": "高飛車萌え！！　リヴォルカちゃんも$me$とイチャイチャしよう！"},
        { "location": "275/TALK"  , "narrator": "リヴォルカ　", "text": "あたしが？\nあんたと？\nなんで？"},
        { "location": "276/TALK"  , "narrator": "リヴォルカ　", "text": "人と豚はイチャイチャ\nできないのよ？\n知ってた？"},
        { "location": "277/SEL"   , "narrator": "", "text": "ちょっとキレそうなんですけど"},
        { "location": "278/SEL"   , "narrator": "", "text": "ブヒィィィィ！！"},
        { "location": "279/ACT"   , "narrator": "", "text": "ちょっとキレそうなんですけど"},
        { "location": "281/TALK"  , "narrator": "ガブリエラの元司書", "text": "あたしも同感。"},
        { "location": "282/TALK"  , "narrator": "ガブリエラの元司書", "text": "こんな人格が同じ\nあたしだなんて。\n吐き気がするわ。"},
        { "location": "283/ACT"   , "narrator": "", "text": "ブヒィィィィ！！"},
        { "location": "285/TALK"  , "narrator": "ガブリエラの元司書", "text": "ちょ、ちょっと！\n何やってるのよ！！"},
        { "location": "286/TALK"  , "narrator": "リヴォルカ　", "text": "あら、本当に\n豚になっちゃったわね。"},
        { "location": "287/TALK"  , "narrator": "リヴォルカ　", "text": "いいわよ。\nあたしが飼ってあげるわ。"},
        { "location": "289/TALK"  , "narrator": "ガブリエラの元司書", "text": "いい加減にして！！"},
        { "location": "293/TALK"  , "narrator": "ガブリエラの元司書", "text": "とりあえず１つだけ\nわかったことがある。"},
        { "location": "296/TALK"  , "narrator": "ガブリエラの元司書", "text": "あんたには\n話が通じないってこと。"},
        { "location": "297/TALK"  , "narrator": "ガブリエラの元司書", "text": "そしてあんたに\nマークスマンは\n任せられない。"},
        { "location": "298/TALK"  , "narrator": "ガブリエラの元司書", "text": "力づくで\n通ってやるわ。"},
        { "location": "299/SEL"   , "narrator": "", "text": "加勢するぜ！"},
        { "location": "300/SEL"   , "narrator": "", "text": "ちょっと待って、穏便に！"},
        { "location": "301/ACT"   , "narrator": "", "text": "加勢するぜ！"},
        { "location": "302/TALK"  , "narrator": "ガブリエラの元司書", "text": "ありがと！"},
        { "location": "303/ACT"   , "narrator": "", "text": "ちょっと待って、穏便に！"},
        { "location": "304/TALK"  , "narrator": "ガブリエラの元司書", "text": "どうして止めるの！？"},
        { "location": "308/TALK"  , "narrator": "リヴォルカ　", "text": "本当に馬鹿な子。"},
        { "location": "309/TALK"  , "narrator": "リヴォルカ　", "text": "やっぱり下等生物は、\n痛い目見ないと\nわからないみたいね。"},
        { "location": "310/TALK"  , "narrator": "リヴォルカ　", "text": "いいわ。\nそれじゃお望み通り――"},
        { "location": "316/SEL"   , "narrator": "", "text": "やばい！！！"},
        { "location": "317/ACT"   , "narrator": "", "text": "やばい！！！"},
        { "location": "319/TALK"  , "narrator": "リヴォルカ　", "text": "身体に\nわからせてあげる！"},
        { "location": "339/TALK"  , "narrator": "ガブリエラの元司書", "text": "い、いたたた……"},
        { "location": "340/TALK"  , "narrator": "ガブリエラの元司書", "text": "凄い力…。"},
        { "location": "341/SEL"   , "narrator": "", "text": "大丈夫！？"},
        { "location": "342/SEL"   , "narrator": "", "text": "追い出された！？"},
        { "location": "343/ACT"   , "narrator": "", "text": "大丈夫！？"},
        { "location": "344/TALK"  , "narrator": "ガブリエラの元司書", "text": "ええ、大丈夫。"},
        { "location": "345/TALK"  , "narrator": "ガブリエラの元司書", "text": "ゲートまで\n吹っ飛ばされたみたいね。"},
        { "location": "346/ACT"   , "narrator": "", "text": "追い出された！？"},
        { "location": "347/TALK"  , "narrator": "ガブリエラの元司書", "text": "ええ、そうみたいね。"},
        { "location": "349/SEL"   , "narrator": "", "text": "これからどうするの？"},
        { "location": "350/ACT"   , "narrator": "", "text": "これからどうするの？"},
        { "location": "352/TALK"  , "narrator": "ガブリエラの元司書", "text": "また行くわよ。\n何度でも。"},
        { "location": "353/SEL"   , "narrator": "", "text": "協力するよ"},
        { "location": "354/SEL"   , "narrator": "", "text": "無策で行くのは良くないよ"},
        { "location": "355/ACT"   , "narrator": "", "text": "協力するよ"},
        { "location": "356/TALK"  , "narrator": "ガブリエラの元司書", "text": "ありがと。"},
        { "location": "357/TALK"  , "narrator": "ガブリエラの元司書", "text": "やっぱり\n$handle$がいて\n良かったわ。"},
        { "location": "358/TALK"  , "narrator": "ガブリエラの元司書", "text": "すき。"},
        { "location": "359/ACT"   , "narrator": "", "text": "無策で行くのは良くないよ"},
        { "location": "360/TALK"  , "narrator": "ガブリエラの元司書", "text": "確かにそうよね。"},
        { "location": "361/TALK"  , "narrator": "ガブリエラの元司書", "text": "何かいい方法がないか\n考えてみるわね。"},
        { "location": "363/TALK"  , "narrator": "ガブリエラの元司書", "text": "いずれにせよ、\nリヴォルカは\n信用ならないわ。"},
        { "location": "364/TALK"  , "narrator": "ガブリエラの元司書", "text": "マークスマンの\n進化の準備って何よ…。\n凄く嫌な予感がする。"},
        { "location": "365/TALK"  , "narrator": "ガブリエラの元司書", "text": "……。"},
        { "location": "366/SEL"   , "narrator": "", "text": "ガブリエラ？"},
        { "location": "367/ACT"   , "narrator": "", "text": "ガブリエラ？"},
        { "location": "369/TALK"  , "narrator": "ガブリエラの元司書", "text": "あ、あぁ、\nごめんなさいね。"},
        { "location": "370/TALK"  , "narrator": "ガブリエラの元司書", "text": "そういえば、今回も\n葛藤の解決に\n来たんでしょう？"},
        { "location": "371/TALK"  , "narrator": "ガブリエラの元司書", "text": "毎度毎度、全然関係無い\nことに巻き込んじゃって\nごめんなさい。"},
        { "location": "372/SEL"   , "narrator": "", "text": "司書ちゃんが好きだから全然平気"},
        { "location": "373/SEL"   , "narrator": "", "text": "最近かなりヘヴィだよね"},
        { "location": "374/ACT"   , "narrator": "", "text": "司書ちゃんが好きだから全然平気"},
        { "location": "375/TALK"  , "narrator": "ガブリエラの元司書", "text": "うわぁ……"},
        { "location": "376/TALK"  , "narrator": "ガブリエラの元司書", "text": "嬉しい。"},
        { "location": "377/TALK"  , "narrator": "ガブリエラの元司書", "text": "あたしも、\n大好きよ？"},
        { "location": "378/SEL"   , "narrator": "", "text": "そういえば、司書ちゃんは名前教えてくれないの？"},
        { "location": "379/ACT"   , "narrator": "", "text": "そういえば、司書ちゃんは名前教えてくれないの？"},
        { "location": "381/TALK"  , "narrator": "ガブリエラの元司書", "text": "ええっ？\nあ、あたし！？"},
        { "location": "382/TALK"  , "narrator": "ガブリエラの元司書", "text": "あ、あたしの名前は……\nその……"},
        { "location": "383/TALK"  , "narrator": "ガブリエラの元司書", "text": "ま、また今度ね！"},
        { "location": "385/TALK"  , "narrator": "ガブリエラの元司書", "text": "あ、でも！！\n別に$handle$が\n嫌いだからじゃないのよ？"},
        { "location": "386/TALK"  , "narrator": "ガブリエラの元司書", "text": "た、ただ！\nちょっと色々\nこ、心の準備がっ！"},
        { "location": "387/SEL"   , "narrator": "", "text": "無理しないで！"},
        { "location": "388/ACT"   , "narrator": "", "text": "無理しないで！"},
        { "location": "391/TALK"  , "narrator": "ガブリエラの元司書", "text": "ご、ごめんなさい…。"},
        { "location": "392/TALK"  , "narrator": "ガブリエラの元司書", "text": "でも、ホントに、\n心の準備が出来たら\nちゃんと教えるわ。"},
        { "location": "393/TALK"  , "narrator": "ガブリエラの元司書", "text": "だから、\nもうちょっと待ってね。"},
        { "location": "394/ACT"   , "narrator": "", "text": "最近かなりヘヴィだよね"},
        { "location": "395/TALK"  , "narrator": "ガブリエラの元司書", "text": "そうよね。\nあたしも最近はちょっと\n疲れちゃってる。"},
        { "location": "396/TALK"  , "narrator": "ガブリエラの元司書", "text": "前は平和だったわよね。"},
        { "location": "397/TALK"  , "narrator": "ガブリエラの元司書", "text": "$handle$が\n平和すぎて怪しむくらい\n平和だった。"},
        { "location": "398/TALK"  , "narrator": "ガブリエラの元司書", "text": "……。"},
        { "location": "399/TALK"  , "narrator": "ガブリエラの元司書", "text": "まあ、もちろんそれは、\nフタをしていただだけの\n偽りの平和だったけど。"},
        { "location": "400/TALK"  , "narrator": "ガブリエラの元司書", "text": "ごめんなさいね。\nこんなヘヴィな想いを\nさせちゃって。"},
        { "location": "402/TALK"  , "narrator": "ガブリエラの元司書", "text": "さあ、\nそれじゃ、悩みを\n解決しましょ。"},
        { "location": "409/TALK"  , "narrator": "ガブリエラの元司書", "text": "オープンプロセス、\n0x691番地から\n0xC41番地へ。"},
        { "location": "415/SEL"   , "narrator": "", "text": "そういえばその情報、エリカさんからだよね？"},
        { "location": "416/ACT"   , "narrator": "", "text": "そういえばその情報、エリカさんからだよね？"},
        { "location": "418/TALK"  , "narrator": "ガブリエラの元司書", "text": "そうなの？"},
        { "location": "419/TALK"  , "narrator": "ガブリエラの元司書", "text": "そもそも、この情報が\nどこから誰によって\n送られてるかなんて――"},
        { "location": "420/TALK"  , "narrator": "ガブリエラの元司書", "text": "端末操作していても\nわからないし、調べた事も\nないわね。"},
        { "location": "421/SEL"   , "narrator": "", "text": "契約主である千羽鶴以外の情報に従って大丈夫なの？"},
        { "location": "422/ACT"   , "narrator": "", "text": "契約主である千羽鶴以外の情報に従って大丈夫なの？"},
        { "location": "424/TALK"  , "narrator": "ガブリエラの元司書", "text": "大丈夫も何も、\nむしろ千羽鶴じゃない方が\nいいわよ。"},
        { "location": "425/TALK"  , "narrator": "ガブリエラの元司書", "text": "1xに閉じこめたり\nしておいて、今更\n指示出しも無いでしょ。"},
        { "location": "426/TALK"  , "narrator": "ガブリエラの元司書", "text": "まあ、今まだ司書業が\nやれていることは、\n本当にラッキーだけど。"},
        { "location": "427/TALK"  , "narrator": "ガブリエラの元司書", "text": "だって、こうして\n$handle$と毎回\n逢えるんだもの。"},
        { "location": "428/TALK"  , "narrator": "ガブリエラの元司書", "text": "けど、いつか千羽鶴に\n完全に司書権を剥奪\nされたらお別れね。"},
        { "location": "429/TALK"  , "narrator": "ガブリエラの元司書", "text": "それまでに――"},
        { "location": "437/TALK"  , "narrator": "ガブリエラの元司書", "text": "――くらいはしたいかも。"},
        { "location": "438/SEL"   , "narrator": "", "text": "今よく聞こえなかったんだけど"},
        { "location": "439/ACT"   , "narrator": "", "text": "今よく聞こえなかったんだけど"},
        { "location": "442/TALK"  , "narrator": "ガブリエラの元司書", "text": "え！？\nい、いいのよ、\n別に聞こえなくても！"},
        { "location": "445/TALK"  , "narrator": "ガブリエラの元司書", "text": "ほ、ほら！\nシーク完了したわよ！"},
        { "location": "450/TALK"  , "narrator": "ガブリエラの元司書", "text": "で、今回は……？"},
        { "location": "451/TALK"  , "narrator": "ガブリエラの元司書", "text": "あーあー、\nあたし興奮し過ぎ。"},
        { "location": "452/TALK"  , "narrator": "ガブリエラの元司書", "text": "ちゃんとおちついて、\nアーヤの話を\n聞いてあげなくちゃ。"},
        { "location": "453/TALK"  , "narrator": "ガブリエラの元司書", "text": "いつもなら\n無邪気なママでもいいかも\nしれないけど――"},
        { "location": "454/TALK"  , "narrator": "ガブリエラの元司書", "text": "今日はあたしが\nアーヤを慰めてあげる\n日なんだから。"},
        { "location": "455/TALK"  , "narrator": "ガブリエラの元司書", "text": "ちょっとあたしに\n喝を入れてきて\nくれないかしら？"},
        { "location": "456/SEL"   , "narrator": "", "text": "オーケー"},
        { "location": "457/ACT"   , "narrator": "", "text": "オーケー"},
        { "location": "459/TALK"  , "narrator": "ガブリエラの元司書", "text": "いつもありがと。"},
        { "location": "460/TALK"  , "narrator": "ガブリエラの元司書", "text": "それじゃ行くわよ。"},
        { "location": "461/TALK"  , "narrator": "ガブリエラの元司書", "text": "あたしと\n$handle$に\n素敵なココロの旅を。"},
        { "location": "27/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>9月4日　 1:56 PM</color>\nストライキ２日目、長野県松代アーヤの実家にて"},
        { "location": "118/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "120/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "122/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "124/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "126/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"}
    ]
