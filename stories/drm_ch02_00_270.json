        { "location": "420/SCENARIO", "narrator": "", "text": "190_カスタム・タンデム・アルゴリズム"},
        { "location": "445/TALK"    , "narrator": "アーヤ", "text": "この前はありがとう"},
        { "location": "446/TALK"    , "narrator": "アーヤ", "text": "助かったわ"},
        { "location": "448/SEL"     , "narrator": "", "text": "いやいや"},
        { "location": "449/SEL"     , "narrator": "", "text": "どういたしまして"},
        { "location": "450/SEL"     , "narrator": "", "text": "ていうか何だっけ"},
        { "location": "451/ACT"     , "narrator": "", "text": "いやいや"},
        { "location": "452/ACT"     , "narrator": "", "text": "どういたしまして"},
        { "location": "453/ACT"     , "narrator": "", "text": "ていうか何だっけ"},
        { "location": "455/TALK"    , "narrator": "アーヤ", "text": "ギャヴィがいる時"},
        { "location": "456/TALK"    , "narrator": "アーヤ", "text": "つばめがバイクに乗りたいって言い出して"},
        { "location": "457/TALK"    , "narrator": "アーヤ", "text": "ギャヴィが不機嫌になったでしょ"},
        { "location": "458/TALK"    , "narrator": "アーヤ", "text": "でも"},
        { "location": "460/TALK"    , "narrator": "アーヤ", "text": "$handle$さんに聞いてみたら"},
        { "location": "461/TALK"    , "narrator": "アーヤ", "text": "ゴキゲンになったでしょ"},
        { "location": "463/SEL"     , "narrator": "", "text": "あれか"},
        { "location": "464/SEL"     , "narrator": "", "text": "すっかり忘れてた"},
        { "location": "465/SEL"     , "narrator": "", "text": "大したことないよ"},
        { "location": "466/ACT"     , "narrator": "", "text": "あれか"},
        { "location": "467/TALK"    , "narrator": "アーヤ", "text": "そう"},
        { "location": "468/TALK"    , "narrator": "アーヤ", "text": "あれよ(*^^*)"},
        { "location": "469/ACT"     , "narrator": "", "text": "すっかり忘れてた"},
        { "location": "470/TALK"    , "narrator": "アーヤ", "text": "うわ＼(◎o◎)／"},
        { "location": "472/TALK"    , "narrator": "アーヤ", "text": "酷いわね"},
        { "location": "473/ACT"     , "narrator": "", "text": "大したことないよ"},
        { "location": "483/TALK"    , "narrator": "アーヤ", "text": "またまた(*^o^*)"},
        { "location": "484/TALK"    , "narrator": "アーヤ", "text": "おかｇで助かったんだから(^з^)-☆"},
        { "location": "485/TALK"    , "narrator": "アーヤ", "text": "おかげで"},
        { "location": "487/TALK"    , "narrator": "アーヤ", "text": "でももしかして"},
        { "location": "488/TALK"    , "narrator": "アーヤ", "text": "忙しかったんじゃないかなってちょっと心配"},
        { "location": "490/SEL"     , "narrator": "", "text": "実はちょっとね"},
        { "location": "491/SEL"     , "narrator": "", "text": "暇な時しかない"},
        { "location": "492/SEL"     , "narrator": "", "text": "アーヤのためならいつでも空けるし"},
        { "location": "493/ACT"     , "narrator": "", "text": "実はちょっとね"},
        { "location": "494/TALK"    , "narrator": "アーヤ", "text": "あ"},
        { "location": "495/TALK"    , "narrator": "アーヤ", "text": "ごめんね(;^_^A"},
        { "location": "496/TALK"    , "narrator": "アーヤ", "text": "忙しい時は断ってくれていいからね！"},
        { "location": "497/ACT"     , "narrator": "", "text": "暇な時しかない"},
        { "location": "498/TALK"    , "narrator": "アーヤ", "text": "えーとヾ(･･ )"},
        { "location": "500/TALK"    , "narrator": "アーヤ", "text": "それもどうなの、、、"},
        { "location": "501/TALK"    , "narrator": "アーヤ", "text": "でも"},
        { "location": "502/TALK"    , "narrator": "アーヤ", "text": "忙しい時は無理しないでね"},
        { "location": "503/ACT"     , "narrator": "", "text": "アーヤのためならいつでも空けるし"},
        { "location": "514/TALK"    , "narrator": "アーヤ", "text": "相変わらず口がうまいのね(--#)"},
        { "location": "515/TALK"    , "narrator": "アーヤ", "text": "でも"},
        { "location": "516/TALK"    , "narrator": "アーヤ", "text": "うれしいかも(*^o^*)"},
        { "location": "517/TALK"    , "narrator": "アーヤ", "text": "だけど"},
        { "location": "518/TALK"    , "narrator": "アーヤ", "text": "忙しい時は"},
        { "location": "519/TALK"    , "narrator": "アーヤ", "text": "無理しないでね(*^.^*)"},
        { "location": "522/TALK"    , "narrator": "アーヤ", "text": "ギャヴィはね、、、"},
        { "location": "523/TALK"    , "narrator": "アーヤ", "text": "ちょっとだけ"},
        { "location": "524/TALK"    , "narrator": "アーヤ", "text": "愚痴も聞いてくれたらうれしいわ"},
        { "location": "527/TALK"    , "narrator": "ボイスメール", "text": "おひめさまには遅すぎる"},
