{
    "dir": "chap22/daydra/dd_ch05_22_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "22502",
        "cid": "kagura",
        "title": "002 メインストーリー",
        "sub_title": "世界が変わるとき＜前編＞"
    },
    "entry":
    [
        { "location": "34/TALK"   , "narrator": "神楽", "text": "店を出た時は\nそんなに\n思わなかったけど。"},
        { "location": "35/TALK"   , "narrator": "神楽", "text": "ずっと持ってると\n結構重いな…。"},
        { "location": "36/TALK"   , "narrator": "アーヤ", "text": "卯月は平気？\nもう少し持とうか？"},
        { "location": "37/TALK"   , "narrator": "神楽", "text": "えっ！？\n大丈夫です。"},
        { "location": "38/TALK"   , "narrator": "みやび", "text": "アーヤは力持ち\nやきねえ。"},
        { "location": "39/TALK"   , "narrator": "みやび", "text": "うちはアーヤに\nお任せぞね。"},
        { "location": "40/TALK"   , "narrator": "アーヤ", "text": "あのねえ、みやび。"},
        { "location": "41/TALK"   , "narrator": "アーヤ", "text": "私はみやびが\n非力だから持って\nあげてるわけじゃないの。"},
        { "location": "42/TALK"   , "narrator": "アーヤ", "text": "夕食を作るのが\nみやびだから。"},
        { "location": "43/TALK"   , "narrator": "アーヤ", "text": "その手間の分\n代わりに持って\nあげてるだけ。"},
        { "location": "44/TALK"   , "narrator": "みやび", "text": "あれ、\nそうだったぞね。\nうちはてっきり。"},
        { "location": "45/TALK"   , "narrator": "アーヤ", "text": "てっきり何よ？"},
        { "location": "61/TALK"   , "narrator": "神楽", "text": "…………。"},
        { "location": "63/TALK"   , "narrator": "神楽", "text": "……ッ！！"},
        { "location": "64/TALK"   , "narrator": "神楽", "text": "ああ、もうっ！！"},
        { "location": "77/TALK"   , "narrator": "神楽", "text": "あああああああああああああ"},
        { "location": "78/TALK"   , "narrator": "神楽", "text": "わたしにんどうしらっっいうのｙ"},
        { "location": "79/TALK"   , "narrator": "神楽", "text": "教えてよ！！１１！！"},
        { "location": "81/SEL"    , "narrator": "", "text": "落ち着いて、どうしたの？"},
        { "location": "82/ACT"    , "narrator": "", "text": "落ち着いて、どうしたの？"},
        { "location": "84/TALK"   , "narrator": "神楽", "text": "合宿が終わるまで"},
        { "location": "85/TALK"   , "narrator": "神楽", "text": "もう数日しかないんです"},
        { "location": "86/TALK"   , "narrator": "神楽", "text": "つばめさんを"},
        { "location": "87/TALK"   , "narrator": "神楽", "text": "それｍでに怖さｎきゃいけないなんて"},
        { "location": "88/TALK"   , "narrator": "神楽", "text": "そんなの"},
        { "location": "89/TALK"   , "narrator": "神楽", "text": "どうしろと？"},
        { "location": "90/TALK"   , "narrator": "神楽", "text": "壊したくないのに"},
        { "location": "93/TALK"   , "narrator": "神楽", "text": "私に戸っての日本は"},
        { "location": "94/TALK"   , "narrator": "神楽", "text": "舞台なんかじゃんくて"},
        { "location": "95/TALK"   , "narrator": "神楽", "text": "現実hに存在しる世界なんだか"},
        { "location": "96/TALK"   , "narrator": "神楽", "text": "ウソだとしてmｐ"},
        { "location": "97/TALK"   , "narrator": "神楽", "text": "記憶に残る限り"},
        { "location": "98/TALK"   , "narrator": "神楽", "text": "死ぬまで本物なんです"},
        { "location": "99/TALK"   , "narrator": "神楽", "text": "つばめさんを"},
        { "location": "102/TALK"  , "narrator": "神楽", "text": "好きになってしまったことも"},
        { "location": "103/TALK"  , "narrator": "神楽", "text": "全部"},
        { "location": "104/TALK"  , "narrator": "神楽", "text": "私には本物なのに"},
        { "location": "107/TALK"  , "narrator": "神楽", "text": "信じられない"},
        { "location": "108/TALK"  , "narrator": "神楽", "text": "つばめさんを壊したところで"},
        { "location": "109/TALK"  , "narrator": "神楽", "text": "すめｒ議千羽鶴が母を戻すのか"},
        { "location": "110/TALK"  , "narrator": "神楽", "text": "今後の生活を保証するのか"},
        { "location": "111/TALK"  , "narrator": "神楽", "text": "皇千羽鶴は信用出来ない"},
        { "location": "112/TALK"  , "narrator": "神楽", "text": "従っても"},
        { "location": "113/TALK"  , "narrator": "神楽", "text": "裏切られたら？"},
        { "location": "114/TALK"  , "narrator": "神楽", "text": "でも本当だったら"},
        { "location": "116/SEL"   , "narrator": "", "text": "大丈夫だから、落ち着いて！"},
        { "location": "117/ACT"   , "narrator": "", "text": "大丈夫だから、落ち着いて！"},
        { "location": "119/TALK"  , "narrator": "神楽", "text": "貴方だって気付いてるでしょ？"},
        { "location": "120/TALK"  , "narrator": "神楽", "text": "あいつは信じられないって"},
        { "location": "121/TALK"  , "narrator": "神楽", "text": "なんの保証もないのに"},
        { "location": "122/TALK"  , "narrator": "神楽", "text": "これ以上あいつの言いなりになるなんて無理！"},
        { "location": "124/SEL"   , "narrator": "", "text": "$me$が付いてるから"},
        { "location": "125/ACT"   , "narrator": "", "text": "$me$が付いてるから"},
        { "location": "127/TALK"  , "narrator": "神楽", "text": "気持ちは嬉しいですよ"},
        { "location": "128/TALK"  , "narrator": "神楽", "text": "けど気持ちだけでしょ？"},
        { "location": "129/TALK"  , "narrator": "神楽", "text": "貴方になにができるの？"},
        { "location": "131/SEL"   , "narrator": "", "text": "落ち着いて話を聞いて！"},
        { "location": "132/ACT"   , "narrator": "", "text": "落ち着いて話を聞いて！"},
        { "location": "135/TALK"  , "narrator": "神楽", "text": "ああそうだ"},
        { "location": "136/TALK"  , "narrator": "神楽", "text": "落ち着いたらいい方法浮かびましたよ"},
        { "location": "137/TALK"  , "narrator": "神楽", "text": "私死にますよ"},
        { "location": "138/TALK"  , "narrator": "神楽", "text": "そうですよそれが一番じゃないですか"},
        { "location": "140/TALK"  , "narrator": "神楽", "text": "それならもう苦しまないで済みます死ね！！！"},
        { "location": "141/TALK"  , "narrator": "神楽", "text": "つばめさんを殺すとか皇千羽鶴が約束を守るのかとか"},
        { "location": "142/TALK"  , "narrator": "神楽", "text": "考えて悩んで苦しまないで済むしラクじゃないですか"},
        { "location": "143/TALK"  , "narrator": "神楽", "text": "決めましたそうします"},
        { "location": "145/SEL"   , "narrator": "", "text": "神楽が死んだ後、二人とも殺されるかも"},
        { "location": "146/ACT"   , "narrator": "", "text": "神楽が死んだ後、二人とも殺されるかも"},
        { "location": "148/TALK"  , "narrator": "神楽", "text": "つばめさんは殺されてもお母さんは"},
        { "location": "151/TALK"  , "narrator": "神楽", "text": "あの人なら"},
        { "location": "152/TALK"  , "narrator": "神楽", "text": "やるかも、、、"},
        { "location": "155/TALK"  , "narrator": "神楽", "text": "それじゃあ"},
        { "location": "157/TALK"  , "narrator": "神楽", "text": "私はどうしたらいいの？"},
        { "location": "209/TALK"  , "narrator": "ぴょんこ", "text": "　"},
        { "location": "245/TALK"  , "narrator": "昇華ぴょんこ", "text": "お待たせしましたっ！\n占いもできちゃう\nスーパー魔法戦士！"},
        { "location": "246/TALK"  , "narrator": "昇華ぴょんこ", "text": "呪ってピョンコ♪\n大復活ですっ！"},
        { "location": "247/SEL"   , "narrator": "", "text": "呪ってピョンコ！！！"},
        { "location": "248/SEL"   , "narrator": "", "text": "ぴょんこｽｷｽｷｽｷｽｷ!!"},
        { "location": "249/ACT"   , "narrator": "", "text": "呪ってピョンコ！！！"},
        { "location": "250/TALK"  , "narrator": "昇華ぴょんこ", "text": "あたのぼうですよっ！"},
        { "location": "251/TALK"  , "narrator": "昇華ぴょんこ", "text": "ていうか、すでに\n$handle$さんは\n呪われてますからっ！"},
        { "location": "252/TALK"  , "narrator": "昇華ぴょんこ", "text": "ぴょんこが\n大好きになる呪いに\n罹ってるぴょん♪"},
        { "location": "253/ACT"   , "narrator": "", "text": "ぴょんこｽｷｽｷｽｷｽｷ!!"},
        { "location": "256/TALK"  , "narrator": "昇華ぴょんこ", "text": "キャーーーー！！！"},
        { "location": "257/TALK"  , "narrator": "昇華ぴょんこ", "text": "そんなにいっぱい\nｽｷｽｷ言ってはなりません\n旦那様！"},
        { "location": "258/TALK"  , "narrator": "昇華ぴょんこ", "text": "ぴょんこのﾗﾌﾞﾊﾟﾜｰが\nはち切れんばかりに\n炸裂してっ！！"},
        { "location": "259/TALK"  , "narrator": "昇華ぴょんこ", "text": "この世の全てが\nぴょんこで満たされて\nしまいますっっ♪"},
        { "location": "260/TALK"  , "narrator": "神楽の新司書　", "text": "コイツ…\n自分で何言ってるのか\n解って言ってるんかな…"},
        { "location": "262/TALK"  , "narrator": "昇華ぴょんこ", "text": "というわけで\n$handle$さんっ！！"},
        { "location": "263/SEL"   , "narrator": "", "text": "おうよ！"},
        { "location": "264/SEL"   , "narrator": "", "text": "あ、はい"},
        { "location": "265/ACT"   , "narrator": "", "text": "おうよ！"},
        { "location": "266/ACT"   , "narrator": "", "text": "あ、はい"},
        { "location": "268/TALK"  , "narrator": "昇華ぴょんこ", "text": "$handle$さんから\n無限の愛を頂戴した\nぴょんこは無限に戦える！"},
        { "location": "269/TALK"  , "narrator": "昇華ぴょんこ", "text": "見てください！\nこのみなぎる無敵パワー！"},
        { "location": "270/TALK"  , "narrator": "昇華ぴょんこ", "text": "まっずはこの目の前にいる\nキモイのを\nさっさとしばいて――"},
        { "location": "271/TALK"  , "narrator": "昇華ぴょんこ", "text": "$handle$さんとっ！\nぴょんこだけの世界をっ！"},
        { "location": "300/TALK"  , "narrator": "神楽の新司書　", "text": "だからお前\n調子に乗りすぎ\nなんだっての！"},
        { "location": "301/TALK"  , "narrator": "昇華ぴょんこ", "text": "すみません、あ、でも、\n調子に乗ってるってよりは\n流れに乗ってるっていうか"},
        { "location": "302/TALK"  , "narrator": "神楽の新司書　", "text": "どっちかっつーと、\nキモイのはオメーだろ。"},
        { "location": "303/TALK"  , "narrator": "神楽の新司書　", "text": "だいたい、呪うのは\n私の専売特許だっつーの。"},
        { "location": "304/TALK"  , "narrator": "神楽の新司書　", "text": "解ってて言ってる？\nねえ、ねえ！！"},
        { "location": "305/TALK"  , "narrator": "昇華ぴょんこ", "text": "あっ、えっと\nわかってます！\nわかってますから――"},
        { "location": "306/TALK"  , "narrator": "昇華ぴょんこ", "text": "とりあえず\n足をどけて\nいただけませんかっ！？"},
        { "location": "307/SEL"   , "narrator": "", "text": "ぴょんこ…弱すぎじゃね？"},
        { "location": "308/SEL"   , "narrator": "", "text": "ぴょんこをいじめるなよ！"},
        { "location": "309/ACT"   , "narrator": "", "text": "ぴょんこ…弱すぎじゃね？"},
        { "location": "310/TALK"  , "narrator": "昇華ぴょんこ", "text": "いえ、ちちち違うんです\n$handle$さんっ！"},
        { "location": "311/TALK"  , "narrator": "昇華ぴょんこ", "text": "これは敵を油断させる為の\n作戦で――"},
        { "location": "314/ACT"   , "narrator": "", "text": "ぴょんこをいじめるなよ！"},
        { "location": "316/TALK"  , "narrator": "神楽の新司書　", "text": "別にいじめてなんて\nいませんよ。"},
        { "location": "317/TALK"  , "narrator": "神楽の新司書　", "text": "今の流れを見てたら、\nこれって予定調和だと\n思いませんでしたか？"},
        { "location": "318/SEL"   , "narrator": "", "text": "否定はできない…"},
        { "location": "319/SEL"   , "narrator": "", "text": "それでもぴょんこをいじめるヤツは許さない"},
        { "location": "320/ACT"   , "narrator": "", "text": "否定はできない…"},
        { "location": "321/TALK"  , "narrator": "神楽の新司書　", "text": "良かったです。\n貴方がまともな人で。"},
        { "location": "322/ACT"   , "narrator": "", "text": "それでもぴょんこをいじめるヤツは許さない"},
        { "location": "323/TALK"  , "narrator": "神楽の新司書　", "text": "ぴょんこに\nゾッコンなんですね。"},
        { "location": "324/TALK"  , "narrator": "神楽の新司書　", "text": "まあいいですけど。"},
        { "location": "327/TALK"  , "narrator": "アースタシア", "text": "ケンカはいけませんよ。\n私の可愛い娘たち……"},
        { "location": "328/SEL"   , "narrator": "", "text": "！？"},
        { "location": "329/ACT"   , "narrator": "", "text": "！？"},
        { "location": "331/TALK"  , "narrator": "神楽の新司書　", "text": "あ。\nこの声は――"},
        { "location": "361/TALK"  , "narrator": "ぴょんこ", "text": "アースタシア様っ！！"},
        { "location": "362/TALK"  , "narrator": "神楽の新司書　", "text": "アースタシア……"},
        { "location": "363/SEL"   , "narrator": "", "text": "誰？？"},
        { "location": "364/SEL"   , "narrator": "", "text": "神楽のセルフクラン…？"},
        { "location": "365/ACT"   , "narrator": "", "text": "誰？？"},
        { "location": "366/TALK"  , "narrator": "アースタシア", "text": "貴方は\n$handle$ですね。"},
        { "location": "367/TALK"  , "narrator": "アースタシア", "text": "いつも卯月神楽のことを\n支えてくれてありがとう。"},
        { "location": "368/TALK"  , "narrator": "アースタシア", "text": "私はアースタシア。\n卯月神楽の心の根幹を\n司る存在。"},
        { "location": "369/TALK"  , "narrator": "アースタシア", "text": "あなた方に倣った\n言い方をするならば、\nセルフクランです。"},
        { "location": "370/ACT"   , "narrator": "", "text": "神楽のセルフクラン…？"},
        { "location": "371/TALK"  , "narrator": "アースタシア", "text": "そうですね。\nあなた方が\nそう呼ぶ存在です。"},
        { "location": "372/TALK"  , "narrator": "アースタシア", "text": "いつも卯月神楽のことを\n支えてくれてありがとう。"},
        { "location": "374/TALK"  , "narrator": "神楽の新司書　", "text": "アースタシア――"},
        { "location": "375/TALK"  , "narrator": "神楽の新司書　", "text": "こんな所に\n姿を見せるなんて\n珍しいですね……？"},
        { "location": "376/TALK"  , "narrator": "ぴょんこ", "text": "アースタシア様！\n直接お目にかかれるなんて\n光栄至極ですっ！！"},
        { "location": "379/TALK"  , "narrator": "ぴょんこ", "text": "<size=40>サインください！！</size>"},
        { "location": "381/TALK"  , "narrator": "神楽の新司書　", "text": "また踏むぞおい。"},
        { "location": "382/TALK"  , "narrator": "アースタシア", "text": "ケンカはいけませんよ。"},
        { "location": "384/TALK"  , "narrator": "神楽の新司書　", "text": "……すみません。"},
        { "location": "385/TALK"  , "narrator": "アースタシア", "text": "ぴょんこ。\nサインなら後でいくらでも\nあげますから――"},
        { "location": "387/TALK"  , "narrator": "ぴょんこ", "text": "ホントですかっ！"},
        { "location": "388/TALK"  , "narrator": "アースタシア", "text": "ですから、早く\n自分の新しい配属場所に\nお戻りなさい。"},
        { "location": "389/TALK"  , "narrator": "ぴょんこ", "text": "――っ。"},
        { "location": "390/TALK"  , "narrator": "ぴょんこ", "text": "……それは。"},
        { "location": "391/TALK"  , "narrator": "ぴょんこ", "text": "それは、\nできません。"},
        { "location": "392/TALK"  , "narrator": "アースタシア", "text": "なりません。"},
        { "location": "393/TALK"  , "narrator": "アースタシア", "text": "先の記憶の破断以降、\n貴方は私の中では\n存在してはならない存在。"},
        { "location": "394/TALK"  , "narrator": "アースタシア", "text": "それを匿い、0x111にて\n生存を許すだけでも\n大変寛大な措置なのです。"},
        { "location": "395/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん……。"},
        { "location": "396/TALK"  , "narrator": "アースタシア", "text": "月神楽。\n貴方も職務怠慢です。"},
        { "location": "397/TALK"  , "narrator": "月神楽　", "text": "うわ、ばか！！！！\nなに名前呼んじゃって――"},
        { "location": "399/TALK"  , "narrator": "アースタシア", "text": "私が顕在するのが珍しいと\n先ほど言ってましたが、\nそれ程の事態なのです。"},
        { "location": "400/TALK"  , "narrator": "月神楽　", "text": "……はぁ～～～。"},
        { "location": "401/TALK"  , "narrator": "アースタシア", "text": "記憶の整理と\n矛盾する存在の消去を\n粛々と行ってください。"},
        { "location": "402/TALK"  , "narrator": "月神楽　", "text": "コイツほんとに\n抜けてるっつーか、\n天然っつーか――"},
        { "location": "403/SEL"   , "narrator": "", "text": "せんせー、月神楽さんがせんせーのこと、心の中でディスってますよ！"},
        { "location": "405/TALK"  , "narrator": "アースタシア", "text": "貴方の仕事が滞ると、\nその間、私という総体は\n混乱し続けるのですよ？"},
        { "location": "406/TALK"  , "narrator": "月神楽　", "text": "部外者いるのに\n名前バレとかすんなよ……"},
        { "location": "407/TALK"  , "narrator": "アースタシア", "text": "月神楽。\n聞いてるのですか？"},
        { "location": "408/TALK"  , "narrator": "月神楽　", "text": "あっ、……はい、\nわかってます。"},
        { "location": "412/ACT"   , "narrator": "", "text": "せんせー、月神楽さんがせんせーのこと、心の中でディスってますよ！"},
        { "location": "415/TALK"  , "narrator": "月神楽　", "text": "はぁ！？　おまっ！！\n何言っちゃってるん\nですか！"},
        { "location": "418/TALK"  , "narrator": "ぴょんこ", "text": "ククク……。"},
        { "location": "419/TALK"  , "narrator": "アースタシア", "text": "……。"},
        { "location": "420/TALK"  , "narrator": "アースタシア", "text": "月神楽。"},
        { "location": "422/TALK"  , "narrator": "月神楽　", "text": "は、はい！"},
        { "location": "423/TALK"  , "narrator": "アースタシア", "text": "不満があるなら\nちゃんと\n聞かせてください？"},
        { "location": "424/TALK"  , "narrator": "月神楽　", "text": "あ、えっと\n特には……"},
        { "location": "425/SEL"   , "narrator": "", "text": "$me$が月神楽の名前をまだ知らなかったのに、名前を言われちゃったからだよ"},
        { "location": "426/ACT"   , "narrator": "", "text": "$me$が月神楽の名前をまだ知らなかったのに、名前を言われちゃったからだよ"},
        { "location": "429/TALK"  , "narrator": "月神楽　", "text": "あっ！！"},
        { "location": "430/TALK"  , "narrator": "アースタシア", "text": "え？"},
        { "location": "431/TALK"  , "narrator": "アースタシア", "text": "あっ、\nそうだったのですね。\nもうとっくに告……"},
        { "location": "432/TALK"  , "narrator": "アースタシア", "text": "いえ、でも、別に何も\n秘密にすることでは\nありませんよ？"},
        { "location": "436/TALK"  , "narrator": "アースタシア", "text": "生きとし生けるものは\n全て、ひとつの大いなる\nもので繋がっています。"},
        { "location": "438/TALK"  , "narrator": "月神楽　", "text": "あ、は、はい……。"},
        { "location": "439/TALK"  , "narrator": "ぴょんこ", "text": "ホント、その通りだと\n思いますっ！！"},
        { "location": "440/TALK"  , "narrator": "アースタシア", "text": "$handle$さんも\n改めて、月神楽のことを\nよろしくお願いします。"},
        { "location": "441/SEL"   , "narrator": "", "text": "任せてください！"},
        { "location": "442/SEL"   , "narrator": "", "text": "あ、はい"},
        { "location": "443/ACT"   , "narrator": "", "text": "任せてください！"},
        { "location": "445/ACT"   , "narrator": "", "text": "あ、はい"},
        { "location": "449/TALK"  , "narrator": "月神楽　", "text": "$handle$……っ。\nこいつ、呪い頃す……。\n絶対頃す！！"},
        { "location": "450/TALK"  , "narrator": "アースタシア", "text": "貴方と月神楽が\nこうして出逢ったのも\n世界の意志です。"},
        { "location": "451/TALK"  , "narrator": "アースタシア", "text": "この導きが、\n卯月神楽の光へと\n繋がっていますように。"},
        { "location": "453/TALK"  , "narrator": "月神楽　", "text": "光へ導かれますように。"},
        { "location": "455/TALK"  , "narrator": "ぴょんこ", "text": "光へ導かれますように！"},
        { "location": "458/TALK"  , "narrator": "アースタシア", "text": "さて、話を戻しますが。\nぴょんこのことです。"},
        { "location": "461/TALK"  , "narrator": "アースタシア", "text": "ぴょんこの件は、\n貴方のたっての願いとして\n温存を許しましたが――"},
        { "location": "462/TALK"  , "narrator": "アースタシア", "text": "あまりに酷いようなら、\n記憶野からの追放しか\n策が無くなります。"},
        { "location": "463/SEL"   , "narrator": "", "text": "ちょっと待って"},
        { "location": "464/ACT"   , "narrator": "", "text": "ちょっと待って"},
        { "location": "466/TALK"  , "narrator": "アースタシア", "text": "どうしましたか？"},
        { "location": "469/SEL"   , "narrator": "", "text": "何が何だかよくわからないんだけど、$me$にわかるように説明して？"},
        { "location": "470/ACT"   , "narrator": "", "text": "何が何だかよくわからないんだけど、$me$にわかるように説明して？"},
        { "location": "472/TALK"  , "narrator": "アースタシア", "text": "そうですね。\n確かに――"},
        { "location": "473/TALK"  , "narrator": "アースタシア", "text": "$handle$にも\n説明して協力を仰いだ方が\n良いかもしれません。"},
        { "location": "474/TALK"  , "narrator": "アースタシア", "text": "では、簡単に\n事情を説明しましょう。"},
        { "location": "476/TALK"  , "narrator": "アースタシア", "text": "ぴょんこは\n卯月神楽単独の人格では\nありません。"},
        { "location": "478/TALK"  , "narrator": "アースタシア", "text": "卯月美佐子との\nハイブリッド人格、\nそれはすなわち――"},
        { "location": "479/TALK"  , "narrator": "アースタシア", "text": "今、私と卯月美佐子の\nココロが繋がっている故に\n存在出来る人格です。"},
        { "location": "480/TALK"  , "narrator": "アースタシア", "text": "単独の人格である0xとも、\n半プログラムの1xとも\n違う、生身2名の融合。"},
        { "location": "482/TALK"  , "narrator": "アースタシア", "text": "それがぴょんこであり、\n所属としては2xと呼ばれる\nものになります。"},
        { "location": "484/TALK"  , "narrator": "アースタシア", "text": "さて。"},
        { "location": "485/TALK"  , "narrator": "アースタシア", "text": "そんな彼女がおかれている\n状況に、今大変な変革が\n訪れています。"},
        { "location": "486/TALK"  , "narrator": "アースタシア", "text": "卯月神楽の記憶の中から、\n卯月美佐子との繋がりを\n示唆する所が消えました。"},
        { "location": "487/TALK"  , "narrator": "アースタシア", "text": "客観的事実はどうであれ、\nココロを平穏にし、崩壊を\n免れるためには――"},
        { "location": "488/TALK"  , "narrator": "アースタシア", "text": "何らかの解釈による\nココロの構造改革を\nせねばなりません。"},
        { "location": "490/TALK"  , "narrator": "アースタシア", "text": "その構造改革では、\n必然的に卯月美佐子との\n繋がりは否定されます。"},
        { "location": "491/SEL"   , "narrator": "", "text": "なるほど"},
        { "location": "492/SEL"   , "narrator": "", "text": "でも、美佐子さんと繋がっているという事実は否定できないでしょ？"},
        { "location": "493/ACT"   , "narrator": "", "text": "なるほど"},
        { "location": "494/ACT"   , "narrator": "", "text": "でも、美佐子さんと繋がっているという事実は否定できないでしょ？"},
        { "location": "495/TALK"  , "narrator": "アースタシア", "text": "もちろん、客観的に見れば\nそれは事実であり正しい。"},
        { "location": "496/TALK"  , "narrator": "アースタシア", "text": "ですが、ココロという物は\nどんなに客観視しても、\n必ず主観視になります。"},
        { "location": "497/TALK"  , "narrator": "アースタシア", "text": "なぜなら、誰であろうと\n今までの経験や記憶がその\n基準となるからです。"},
        { "location": "498/TALK"  , "narrator": "アースタシア", "text": "例えば、\n考えてみてください。"},
        { "location": "501/TALK"  , "narrator": "アースタシア", "text": "貴方に結婚した記憶が\nないのに、薬指にリングを\nはめていたとしましょう。"},
        { "location": "502/TALK"  , "narrator": "アースタシア", "text": "貴方はどう考えますか？"},
        { "location": "505/TALK"  , "narrator": "アースタシア", "text": "特に深く考えず、寝ぼけて\n適当に付けたのでは？\nとか――"},
        { "location": "506/TALK"  , "narrator": "アースタシア", "text": "飲み会で酔った拍子に\n誰かの指輪を付けてその\nままなのでは、とか。"},
        { "location": "507/TALK"  , "narrator": "アースタシア", "text": "その場で考え得る\n常識的な解釈で、\n心の安定をとります。"},
        { "location": "508/TALK"  , "narrator": "アースタシア", "text": "そうしないと、\nココロが不安定なままで、\nいずれ崩壊するからです。"},
        { "location": "511/TALK"  , "narrator": "アースタシア", "text": "実際は１年前に結婚して\nいて、その期間の記憶を\n失っているとしても――"},
        { "location": "512/TALK"  , "narrator": "アースタシア", "text": "貴方はそれを\n肯定することは\nできないでしょう。"},
        { "location": "513/TALK"  , "narrator": "アースタシア", "text": "同様に、卯月美佐子と\n繋がっていたという事実は\n否定せねばなりません。"},
        { "location": "514/TALK"  , "narrator": "アースタシア", "text": "そうしないと、\nそこからココロが崩壊\nしかねないからです。"},
        { "location": "518/TALK"  , "narrator": "アースタシア", "text": "私はぴょんこの消滅は\n免れないだろうと\n考えましたが――"},
        { "location": "519/TALK"  , "narrator": "アースタシア", "text": "月神楽は、彼女を\n管理した上で生かすという\n選択をしたのです。"},
        { "location": "520/SEL"   , "narrator": "", "text": "なるほど"},
        { "location": "521/SEL"   , "narrator": "", "text": "もしかして月神楽って、すごく優しい子なのでは？"},
        { "location": "522/ACT"   , "narrator": "", "text": "なるほど"},
        { "location": "523/TALK"  , "narrator": "ぴょんこ", "text": "まーあれだよなー。"},
        { "location": "524/TALK"  , "narrator": "ぴょんこ", "text": "生かす選択を\nしたっつーか――"},
        { "location": "525/ACT"   , "narrator": "", "text": "もしかして月神楽って、すごく優しい子なのでは？"},
        { "location": "527/TALK"  , "narrator": "月神楽　", "text": "今頃気づいたんですか？\nもー、遅すぎですよ？"},
        { "location": "530/TALK"  , "narrator": "ぴょんこ", "text": "呪いの実験台に\n家無しの人格が一匹、\n欲しかっただけですよね？"},
        { "location": "531/SEL"   , "narrator": "", "text": "えっ"},
        { "location": "532/ACT"   , "narrator": "", "text": "えっ"},
        { "location": "534/TALK"  , "narrator": "月神楽　", "text": "まさかそんな～～。"},
        { "location": "536/TALK"  , "narrator": "月神楽　", "text": "あれは、ちょっとした\nジョークですよっ♪"},
        { "location": "537/SEL"   , "narrator": "", "text": "それで、ぴょんこは逃げ出してきたの？"},
        { "location": "538/ACT"   , "narrator": "", "text": "それで、ぴょんこは逃げ出してきたの？"},
        { "location": "541/TALK"  , "narrator": "ぴょんこ", "text": "あ、いえ、\nそれはまた別の理由で…。"},
        { "location": "542/TALK"  , "narrator": "アースタシア", "text": "では、どういった\n理由なのですか？"},
        { "location": "548/TALK"  , "narrator": "ぴょんこ", "text": "アースタシア様、\nぴょんこの話を\n聞いてくださいっ！"},
        { "location": "549/TALK"  , "narrator": "アースタシア", "text": "もちろんです。\nお話なさい。"},
        { "location": "550/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこが\n同化の原因を突き止めて、\n記憶状態を元に戻します！"},
        { "location": "551/TALK"  , "narrator": "ぴょんこ", "text": "エリカさんから\n聞いたんです。"},
        { "location": "552/TALK"  , "narrator": "ぴょんこ", "text": "今回の同化の原因は\n自然発生的なものでは\nなくて――"},
        { "location": "553/TALK"  , "narrator": "ぴょんこ", "text": "誰かが、外の記憶を\n切り離し、つばめさんの\n記憶につなぎ替えたって。"},
        { "location": "554/TALK"  , "narrator": "ぴょんこ", "text": "だから、その切替を\n元に戻して、外の記憶に\n繋ぎ戻せば！"},
        { "location": "555/TALK"  , "narrator": "ぴょんこ", "text": "記憶の辻褄は\nしっかり元通りに\nなる筈なんです！"},
        { "location": "556/TALK"  , "narrator": "ぴょんこ", "text": "そしてエリカさんは、\nできればぴょんこにも\n手伝って欲しいって。"},
        { "location": "557/TALK"  , "narrator": "ぴょんこ", "text": "だから、ぴょんこは\nエリカさんのお手伝いに\n行きたいんですっ！"},
        { "location": "558/TALK"  , "narrator": "アースタシア", "text": "なるほど。\nですが――"},
        { "location": "560/TALK"  , "narrator": "アースタシア", "text": "外の記憶への接続切替は、\n卯月神楽の心の中でできる\nことではありません。"},
        { "location": "561/TALK"  , "narrator": "アースタシア", "text": "それは、1x接続の先にある\n量子サーバーで\n行われていること。"},
        { "location": "562/TALK"  , "narrator": "アースタシア", "text": "貴方がそこへ行くと\nいうことは――"},
        { "location": "563/TALK"  , "narrator": "アースタシア", "text": "一時的であれ、卯月神楽の\n記憶から消滅することで\nあり、存在は抹消される。"},
        { "location": "564/TALK"  , "narrator": "アースタシア", "text": "それは、今貴方が望まない\n貴方自身の消滅を、より\n加速させる事になります。"},
        { "location": "565/TALK"  , "narrator": "ぴょんこ", "text": "それでも。"},
        { "location": "566/TALK"  , "narrator": "ぴょんこ", "text": "それでもぴょんこは！"},
        { "location": "567/TALK"  , "narrator": "ぴょんこ", "text": "危険かも知れないけど！！"},
        { "location": "568/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこが生き残れる\n一縷の望みに\n賭けたいんです！！"},
        { "location": "570/TALK"  , "narrator": "月神楽　", "text": "……。"},
        { "location": "571/TALK"  , "narrator": "アースタシア", "text": "………。"},
        { "location": "572/TALK"  , "narrator": "アースタシア", "text": "わかりました、\nよいでしょう。"},
        { "location": "575/TALK"  , "narrator": "ぴょんこ", "text": "ホントですかっ！！"},
        { "location": "577/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さん、\nやりましたよっ！！"},
        { "location": "578/SEL"   , "narrator": "", "text": "よかったね！"},
        { "location": "579/SEL"   , "narrator": "", "text": "協力するよ！"},
        { "location": "580/ACT"   , "narrator": "", "text": "よかったね！"},
        { "location": "581/TALK"  , "narrator": "ぴょんこ", "text": "これでまた、\n$handle$さんとの\nラブクエスト再開ですね！"},
        { "location": "582/ACT"   , "narrator": "", "text": "協力するよ！"},
        { "location": "584/TALK"  , "narrator": "ぴょんこ", "text": "ぴょーん♪"},
        { "location": "586/TALK"  , "narrator": "アースタシア", "text": "残念ですが、\nそれはできません。"},
        { "location": "588/TALK"  , "narrator": "ぴょんこ", "text": "えっ！？"},
        { "location": "590/TALK"  , "narrator": "アースタシア", "text": "ココロの外へ向かう\n今回の件について――"},
        { "location": "591/TALK"  , "narrator": "アースタシア", "text": "$handle$を含む\n全ての支援は\nつけられません。"},
        { "location": "592/SEL"   , "narrator": "", "text": "なぜ？"},
        { "location": "593/ACT"   , "narrator": "", "text": "なぜ？"},
        { "location": "596/TALK"  , "narrator": "アースタシア", "text": "貴方が今いるこの場所は\n卯月神楽の心の中。"},
        { "location": "597/TALK"  , "narrator": "アースタシア", "text": "共通意識野への\n移動であれば、辛うじて\n私の範囲内ですが――"},
        { "location": "598/TALK"  , "narrator": "アースタシア", "text": "完全なるプログラム領域\nともなる、量子サーバーは\nもはや私ではありません。"},
        { "location": "599/TALK"  , "narrator": "アースタシア", "text": "少なくとも、卯月神楽の\nココロゲートを経由しては\n向かわせられません。"},
        { "location": "600/TALK"  , "narrator": "アースタシア", "text": "それに。"},
        { "location": "601/TALK"  , "narrator": "アースタシア", "text": "貴方がここへアクセス\nするときには、然るべき\n理由がありますよね？"},
        { "location": "602/TALK"  , "narrator": "アースタシア", "text": "そろそろ\n忘れていませんか？"},
        { "location": "603/SEL"   , "narrator": "", "text": "覚えてるよ"},
        { "location": "604/SEL"   , "narrator": "", "text": "なんだっけ？"},
        { "location": "605/ACT"   , "narrator": "", "text": "覚えてるよ"},
        { "location": "606/TALK"  , "narrator": "アースタシア", "text": "ならば、その使命を\n全うしてください。"},
        { "location": "607/ACT"   , "narrator": "", "text": "なんだっけ？"},
        { "location": "608/TALK"  , "narrator": "アースタシア", "text": "卯月神楽の\n心の葛藤を\n解消することです。"},
        { "location": "611/TALK"  , "narrator": "アースタシア", "text": "ここしばらくの間、\nつばめさんたちの支援で\n何とかやっていました。"},
        { "location": "612/TALK"  , "narrator": "アースタシア", "text": "ですが、それも\nそろそろ限界です。"},
        { "location": "613/TALK"  , "narrator": "アースタシア", "text": "彼女たちがこれ以上\n影響するのは、私にとって\n良いことではありません。"},
        { "location": "614/TALK"  , "narrator": "アースタシア", "text": "それに加えて、\n前回のつばめさんによる\n記憶への無断侵入。"},
        { "location": "616/TALK"  , "narrator": "アースタシア", "text": "悪意があるかどうかは\n不明ですが、その事自体が\n非常に危険な事なのです。"},
        { "location": "617/TALK"  , "narrator": "アースタシア", "text": "それもあり、\n彼女たちの支援は、\n今回で打ち切りとして――"},
        { "location": "619/TALK"  , "narrator": "アースタシア", "text": "トライナリー間における\n2x接続は全て\n遮断することにしました。"},
        { "location": "620/TALK"  , "narrator": "アースタシア", "text": "これ以降、彼女たちは\n卯月神楽の心へは\n侵入できません。"},
        { "location": "622/TALK"  , "narrator": "アースタシア", "text": "ゆえに。\n$handle$は\n任務を遂行してください。"},
        { "location": "623/TALK"  , "narrator": "アースタシア", "text": "それが、結果的には\n卯月神楽という総体への\n無限の愛になるのです。"},
        { "location": "624/TALK"  , "narrator": "アースタシア", "text": "これからは、月神楽が\nココロの司書となります。"},
        { "location": "625/TALK"  , "narrator": "アースタシア", "text": "二人で力を合わせ、\n卯月神楽の心に平穏と光を\n照らし続けてください。"},
        { "location": "626/SEL"   , "narrator": "", "text": "わかりました"},
        { "location": "627/SEL"   , "narrator": "", "text": "ぴょんこは大丈夫なの？"},
        { "location": "628/ACT"   , "narrator": "", "text": "わかりました"},
        { "location": "629/TALK"  , "narrator": "アースタシア", "text": "さあ、ぴょんこ。"},
        { "location": "630/ACT"   , "narrator": "", "text": "ぴょんこは大丈夫なの？"},
        { "location": "633/TALK"  , "narrator": "ぴょんこ", "text": "……。"},
        { "location": "635/TALK"  , "narrator": "ぴょんこ", "text": "何言ってるんですか、\n$handle$さんっ♪"},
        { "location": "636/TALK"  , "narrator": "ぴょんこ", "text": "今のぴょんこは、\n$handle$さんの\n愛で満タンですっ！"},
        { "location": "637/TALK"  , "narrator": "ぴょんこ", "text": "ちょっとやそっと\n離れたくらいでは\n全然平気ですし――"},
        { "location": "640/TALK"  , "narrator": "ぴょんこ", "text": "これから、ずっとずっと\nずーっと、ずーっと\nず――――――――っと！"},
        { "location": "642/TALK"  , "narrator": "月神楽　", "text": "お前さあ、\nいつもくどいんだよ…。\nコッテコテ。"},
        { "location": "643/TALK"  , "narrator": "ぴょんこ", "text": "クドすぎるくらいが\n丁度いいんですよっ！"},
        { "location": "645/TALK"  , "narrator": "ぴょんこ", "text": "だって、一生ずっと\n一緒にいるために、\n頑張るんですから！"},
        { "location": "646/SEL"   , "narrator": "", "text": "ぴょんこ……"},
        { "location": "647/ACT"   , "narrator": "", "text": "ぴょんこ……"},
        { "location": "649/TALK"  , "narrator": "アースタシア", "text": "さあ、ぴょんこ。"},
        { "location": "656/TALK"  , "narrator": "アースタシア", "text": "もう、おゆきなさい。"},
        { "location": "658/TALK"  , "narrator": "アースタシア", "text": "時間は殆どありません。"},
        { "location": "659/TALK"  , "narrator": "アースタシア", "text": "貴方が外に出れば、\n記憶の辻褄合わせにかかる\n時間は更に短くなります。"},
        { "location": "660/TALK"  , "narrator": "アースタシア", "text": "決して時間を\n無駄にはしないように。"},
        { "location": "661/TALK"  , "narrator": "ぴょんこ", "text": "はいっ！\nありがとうございます！"},
        { "location": "663/TALK"  , "narrator": "月神楽　", "text": "私が1xのゲートまで\n送ってあげますね。"},
        { "location": "665/TALK"  , "narrator": "ぴょんこ", "text": "え……マジで？"},
        { "location": "666/SEL"   , "narrator": "", "text": "$me$も行けるところまで一緒に行くよ"},
        { "location": "667/ACT"   , "narrator": "", "text": "$me$も行けるところまで一緒に行くよ"},
        { "location": "673/TALK"  , "narrator": "ぴょんこ", "text": "ホントですかっ！！"},
        { "location": "675/TALK"  , "narrator": "ぴょんこ", "text": "――だそうですよ？\n月ちゃん用無しですねっ。"},
        { "location": "676/TALK"  , "narrator": "月神楽　", "text": "お前バカだろ。\n$handle$さんが1xの\nゲートの場所知ってるか？"},
        { "location": "677/TALK"  , "narrator": "ぴょんこ", "text": "もっ……"},
        { "location": "679/TALK"  , "narrator": "ぴょんこ", "text": "もちろん\n知ってるよな！"},
        { "location": "680/SEL"   , "narrator": "", "text": "知らないよ…"},
        { "location": "681/ACT"   , "narrator": "", "text": "知らないよ…"},
        { "location": "683/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん……。"},
        { "location": "684/TALK"  , "narrator": "月神楽　", "text": "はぁ……。"},
        { "location": "685/TALK"  , "narrator": "月神楽　", "text": "$handle$さん……。"},
        { "location": "686/TALK"  , "narrator": "月神楽　", "text": "よく今までこんな\n頭元気な子と\nつき合ってきましたね。"},
        { "location": "687/SEL"   , "narrator": "", "text": "ぴょんこは可愛いよ！"},
        { "location": "688/SEL"   , "narrator": "", "text": "まあ、ね（苦笑）"},
        { "location": "689/ACT"   , "narrator": "", "text": "ぴょんこは可愛いよ！"},
        { "location": "691/TALK"  , "narrator": "月神楽　", "text": "恋は盲目…ですか。"},
        { "location": "692/ACT"   , "narrator": "", "text": "まあ、ね（苦笑）"},
        { "location": "693/TALK"  , "narrator": "月神楽　", "text": "察しておきますね。"},
        { "location": "696/TALK"  , "narrator": "月神楽　", "text": "さあ、行きますよ。"},
        { "location": "698/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん♪"},
        { "location": "706/TALK"  , "narrator": "アースタシア", "text": "……。"},
        { "location": "707/TALK"  , "narrator": "アースタシア", "text": "ぴょんこ……、\nしっかりやるのですよ。"},
        { "location": "708/TALK"  , "narrator": "アースタシア", "text": "彼女とママと私にとって、\n素敵なココロの旅に\nなりますように――。"},
        { "location": "712/SEL"   , "narrator": "", "text": "あの、可能なら１つお願いがあるのですが"},
        { "location": "713/ACT"   , "narrator": "", "text": "あの、可能なら１つお願いがあるのですが"},
        { "location": "715/TALK"  , "narrator": "アースタシア", "text": "何でしょう？"},
        { "location": "716/SEL"   , "narrator": "", "text": "ガブリエラのココロゲートに移動させてもらうことはできますか？"},
        { "location": "717/ACT"   , "narrator": "", "text": "ガブリエラのココロゲートに移動させてもらうことはできますか？"},
        { "location": "719/TALK"  , "narrator": "アースタシア", "text": "ええ、もちろんです。"},
        { "location": "720/TALK"  , "narrator": "アースタシア", "text": "もしかして――"},
        { "location": "721/TALK"  , "narrator": "アースタシア", "text": "今回は、その為に\nここへ来たのですか？"},
        { "location": "722/SEL"   , "narrator": "", "text": "まあ、それも１つの目的でした"},
        { "location": "723/ACT"   , "narrator": "", "text": "まあ、それも１つの目的でした"},
        { "location": "725/TALK"  , "narrator": "アースタシア", "text": "それは……。"},
        { "location": "726/TALK"  , "narrator": "アースタシア", "text": "私の人格たちが、\n時間を潰してしまい\n申し訳ありませんでした。"},
        { "location": "727/SEL"   , "narrator": "", "text": "可愛いから全然オッケーです！"},
        { "location": "728/SEL"   , "narrator": "", "text": "確かに長かった…"},
        { "location": "729/ACT"   , "narrator": "", "text": "可愛いから全然オッケーです！"},
        { "location": "731/TALK"  , "narrator": "アースタシア", "text": "そう言っていただけると\n少し気が楽になります。"},
        { "location": "732/ACT"   , "narrator": "", "text": "確かに長かった…"},
        { "location": "733/TALK"  , "narrator": "アースタシア", "text": "そうですよね。\n申し訳ありません。"},
        { "location": "735/TALK"  , "narrator": "アースタシア", "text": "お詫びという程の事でも\nありませんが、\n確実に転送致しますね。"},
        { "location": "736/TALK"  , "narrator": "アースタシア", "text": "$handle$と\nガブリエラにとって\n素敵なココロの旅を。"},
        { "location": "760/TALK"  , "narrator": "ガブリエラ", "text": "やってみたいことって\nいうのはね――"},
        { "location": "761/TALK"  , "narrator": "ガブリエラ", "text": "指定されるエラーとは\n逆さまの選択を\nし続けたらどうなるか。"},
        { "location": "762/SEL"   , "narrator": "", "text": "やめて！マジでやめて！"},
        { "location": "763/ACT"   , "narrator": "", "text": "やめて！マジでやめて！"},
        { "location": "765/TALK"  , "narrator": "ガブリエラ", "text": "臆病ね。"},
        { "location": "766/TALK"  , "narrator": "ガブリエラ", "text": "でもね、\n$handle$。"},
        { "location": "767/TALK"  , "narrator": "ガブリエラ", "text": "あたしは既に一度\n消されかけてるの。"},
        { "location": "768/TALK"  , "narrator": "ガブリエラ", "text": "今更敵が１つ２つ増えた\nところで何ともないわよ。\nそれに――"},
        { "location": "769/SEL"   , "narrator": "", "text": "絶対絶対絶ー対だめーーーーーっ！！"},
        { "location": "770/ACT"   , "narrator": "", "text": "絶対絶対絶ー対だめーーーーーっ！！"},
        { "location": "772/TALK"  , "narrator": "ガブリエラ", "text": "ええええっ！？\nな、なによ！"},
        { "location": "773/TALK"  , "narrator": "ガブリエラ", "text": "普段だったら\nそんなに強く言うこと\n無いのに。"},
        { "location": "774/SEL"   , "narrator": "", "text": "だから、それくらいの事なんだよ。お願い信じて！"},
        { "location": "775/ACT"   , "narrator": "", "text": "だから、それくらいの事なんだよ。お願い信じて！"},
        { "location": "777/TALK"  , "narrator": "ガブリエラ", "text": "うーん……"},
        { "location": "778/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "779/TALK"  , "narrator": "ガブリエラ", "text": "わかったわ。"},
        { "location": "780/TALK"  , "narrator": "ガブリエラ", "text": "他でもない\n$handle$の\n頼みだもん。"},
        { "location": "781/TALK"  , "narrator": "ガブリエラ", "text": "今回は\n指示通りに\nやることにするわね。"},
        { "location": "782/SEL"   , "narrator": "", "text": "ありがとう！"},
        { "location": "783/ACT"   , "narrator": "", "text": "ありがとう！"},
        { "location": "785/TALK"  , "narrator": "ガブリエラ", "text": "うん。"},
        { "location": "786/TALK"  , "narrator": "ガブリエラ", "text": "それじゃ、\n今回の悩みを\n見てみましょ。"},
        { "location": "793/TALK"  , "narrator": "ガブリエラ", "text": "オープンプロセス、\n0x9FB番地から\n0xBAA番地へ。"},
        { "location": "818/TALK"  , "narrator": "ガブリエラ", "text": "シーク完了っ♪"},
        { "location": "823/TALK"  , "narrator": "ガブリエラ", "text": "で、今回は……と。"},
        { "location": "824/TALK"  , "narrator": "ガブリエラ", "text": "なるほど。\nあたしらしい悩みね。"},
        { "location": "825/TALK"  , "narrator": "ガブリエラ", "text": "ていうか、\nあんたもこのタイミングで\nすごい爆弾発言するわね。"},
        { "location": "826/SEL"   , "narrator": "", "text": "ここしかないと思って"},
        { "location": "827/SEL"   , "narrator": "", "text": "え？\nなにが爆弾だった？"},
        { "location": "828/ACT"   , "narrator": "", "text": "ここしかないと思って"},
        { "location": "829/TALK"  , "narrator": "ガブリエラ", "text": "まあ、確かに\n的確だとは思うわね。"},
        { "location": "830/ACT"   , "narrator": "", "text": "え？\nなにが爆弾だった？"},
        { "location": "831/TALK"  , "narrator": "ガブリエラ", "text": "神楽がつばめを壊すって\n言ってきたことよ。"},
        { "location": "832/TALK"  , "narrator": "ガブリエラ", "text": "そんなこと言われたら、\n普通動揺しちゃうでしょ？"},
        { "location": "833/TALK"  , "narrator": "ガブリエラ", "text": "でもまあ、あんたも\n考え無しじゃないって\nことはわかるわ。"},
        { "location": "835/TALK"  , "narrator": "ガブリエラ", "text": "お陰で、あたしの\nソルジャーとしての勘が\nもの凄い騒いでる。"},
        { "location": "836/TALK"  , "narrator": "ガブリエラ", "text": "総意としても、\n友達を信じたいという\n気持ちもありながら――"},
        { "location": "837/TALK"  , "narrator": "ガブリエラ", "text": "神楽に対して\n尋問しなくちゃ…って\n気持ちが勝ってる。"},
        { "location": "838/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "840/TALK"  , "narrator": "ガブリエラ", "text": "だから、\nその気持ちを勝たせるよう\n気の迷いを絶つわ。"},
        { "location": "841/TALK"  , "narrator": "ガブリエラ", "text": "というわけで、\n今回も撃退、よろしく。"},
        { "location": "842/SEL"   , "narrator": "", "text": "任せて！"},
        { "location": "843/ACT"   , "narrator": "", "text": "任せて！"},
        { "location": "845/TALK"  , "narrator": "ガブリエラ", "text": "ふふ。\nいつもありがと。"},
        { "location": "846/TALK"  , "narrator": "ガブリエラ", "text": "あたしと\n$handle$に\n素敵なココロの旅を。"},
        { "location": "33/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>8月29日　1:12 PM</color>\n合宿中、横須賀での買い物の途中。"},
        { "location": "60/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>8月29日　5:45 PM</color>\n合宿中、みやびの実家付近の砂浜にて"},
        { "location": "174/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "176/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "178/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "180/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "182/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "244/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Information:0x03】</color>\nココロスフィアとの通信を\n復元しました。(101)"},
        { "location": "759/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Information:0xEF】</color>\n\n<color=red>QJUMP:CH05=>CH03</color>\n1x100->1x000->\n[21:33:58:23:9E]->\nC3:1x000->0x9FB\nTIME_SCALE:1x\n\nCommand succeed.\n(101)"},
        { "location": "859/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Information:0x11】</color>\n\nKokoro-Gate\n<color=blue>[Address:1x100]</color>\nsave succeed !\nAnd hibernation a gate.\n\n時空間整合性維持のため、\nココロゲートを一旦停止し\n現実世界に戻ります。\n(102)\n"}
    ]
}
