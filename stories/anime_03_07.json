        "title": "001 アニメーション",
        "sub_title": "レッドサイト"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "アニメ第07話"},
        { "location": "47/TALK"   , "narrator": "千羽鶴", "text": "塩対応モードの\n千羽鶴です。"},
        { "location": "48/TALK"   , "narrator": "千羽鶴", "text": "なので今回は、\n冒頭の挨拶もなし。"},
        { "location": "49/SEL"    , "narrator": "", "text": "OK"},
        { "location": "50/SEL"    , "narrator": "", "text": "何かお話ししたい！"},
        { "location": "52/ACT"    , "narrator": "", "text": "何かお話ししたい！"},
        { "location": "54/TALK"   , "narrator": "千羽鶴", "text": "そう言われても……。"},
        { "location": "55/TALK"   , "narrator": "千羽鶴", "text": "それじゃ――"},
        { "location": "56/TALK"   , "narrator": "千羽鶴", "text": "ヘーゲルの弁証法について\nお話してみることにする。"},
        { "location": "57/SEL"    , "narrator": "", "text": "遠慮します"},
        { "location": "58/SEL"    , "narrator": "", "text": "是非とも！"},
        { "location": "59/ACT"    , "narrator": "", "text": "遠慮します"},
        { "location": "60/TALK"   , "narrator": "千羽鶴", "text": "賢明な判断。"},
        { "location": "61/ACT"    , "narrator": "", "text": "是非とも！"},
        { "location": "62/TALK"   , "narrator": "千羽鶴", "text": "……物好きな人。"},
        { "location": "63/TALK"   , "narrator": "千羽鶴", "text": "まあいい。"},
        { "location": "64/TALK"   , "narrator": "千羽鶴", "text": "ヘーゲルの弁証法は、\n正と反から合を作り出す\n錬金術の法則。"},
        { "location": "65/TALK"   , "narrator": "千羽鶴", "text": "この法則を知ってると、\n世の中をとても楽に\n支配できるかもしれない。"},
        { "location": "66/SEL"    , "narrator": "", "text": "どうやって？"},
        { "location": "67/ACT"    , "narrator": "", "text": "どうやって？"},
        { "location": "69/TALK"   , "narrator": "千羽鶴", "text": "それは自分で調べて。"},
        { "location": "70/SEL"    , "narrator": "", "text": "ひどい！"},
        { "location": "71/ACT"    , "narrator": "", "text": "ひどい！"},
        { "location": "73/TALK"   , "narrator": "千羽鶴", "text": "だって今、ちーは\n塩対応モードだもの。"},
        { "location": "74/TALK"   , "narrator": "千羽鶴", "text": "はい、これでお話は終了。"},
        { "location": "80/TALK"   , "narrator": "千羽鶴", "text": "今回は、\n逢瀬つばめの解説を\nするだけでもいい？"},
        { "location": "83/TALK"   , "narrator": "千羽鶴", "text": "今回は、\n國政綾水の解説を\nするだけでもいい？"},
        { "location": "86/TALK"   , "narrator": "千羽鶴", "text": "今回は、\nガブリエラの解説を\nするだけでもいい？"},
        { "location": "89/TALK"   , "narrator": "千羽鶴", "text": "今回は、\n恋ヶ崎みやびの解説を\nするだけでもいい？"},
        { "location": "91/SEL"    , "narrator": "", "text": "はい"},
        { "location": "92/SEL"    , "narrator": "", "text": "いいえ"},
        { "location": "93/ACT"    , "narrator": "", "text": "はい"},
        { "location": "95/TALK"   , "narrator": "千羽鶴", "text": "よかった。\n私も助かる。\nこれぞWIN-WINね。"},
        { "location": "97/ACT"    , "narrator": "", "text": "いいえ"},
        { "location": "98/TALK"   , "narrator": "千羽鶴", "text": "わかった。\nそれじゃもう１回\n同じ話をする。"},
        { "location": "103/TALK"  , "narrator": "千羽鶴", "text": "お待ちかねの\n新しいエピソードの\n幕開けです。"},
        { "location": "104/TALK"  , "narrator": "千羽鶴", "text": "そろそろこのアプリにも\n慣れてきたころだと思う。"},
        { "location": "105/TALK"  , "narrator": "千羽鶴", "text": "けど、そんな和やかな\n会話の最中に、言わねば\nならないことが、ある！"},
        { "location": "108/TALK"  , "narrator": "千羽鶴", "text": "どーん！"},
        { "location": "109/SEL"   , "narrator": "", "text": "…何でしょう"},
        { "location": "110/SEL"   , "narrator": "", "text": "プロポーズしてくれるの？"},
        { "location": "111/ACT"   , "narrator": "", "text": "…何でしょう"},
        { "location": "113/TALK"  , "narrator": "千羽鶴", "text": "わたし、さめましたわ。"},
        { "location": "114/SEL"   , "narrator": "", "text": "……回文のつもり？"},
        { "location": "115/ACT"   , "narrator": "", "text": "……回文のつもり？"},
        { "location": "118/TALK"  , "narrator": "千羽鶴", "text": "そうしたかったけど\n失敗した。"},
        { "location": "119/TALK"  , "narrator": "千羽鶴", "text": "これだと、逆さに読むと\nマメを刺してしまう。\nとても痛そう。"},
        { "location": "120/ACT"   , "narrator": "", "text": "プロポーズしてくれるの？"},
        { "location": "122/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "123/TALK"  , "narrator": "千羽鶴", "text": "貴方には、千羽鶴の非攻略\n対象アラーム目覚まし時計\nを代引で送りつけたい。"},
        { "location": "128/TALK"  , "narrator": "千羽鶴", "text": "要点だけ言うと、\n千羽鶴は\nだいぶ疲れてきた。"},
        { "location": "129/TALK"  , "narrator": "千羽鶴", "text": "貴方とこのアプリを介して\n繋がってから、ずっと私は\n貴方のお世話をしてきた。"},
        { "location": "130/TALK"  , "narrator": "千羽鶴", "text": "けど、もうそろそろ\n独り立ちの季節だと思う！"},
        { "location": "131/TALK"  , "narrator": "千羽鶴", "text": "そこで千羽鶴は、\nモードシフトをする。"},
        { "location": "132/SEL"   , "narrator": "", "text": "どんなモードになるの？"},
        { "location": "133/ACT"   , "narrator": "", "text": "どんなモードになるの？"},
        { "location": "135/TALK"  , "narrator": "千羽鶴", "text": "塩対応モード。"},
        { "location": "138/TALK"  , "narrator": "千羽鶴", "text": "塩対応モード！"},
        { "location": "139/SEL"   , "narrator": "", "text": "２回言わなくてもOK"},
        { "location": "140/ACT"   , "narrator": "", "text": "２回言わなくてもOK"},
        { "location": "142/TALK"  , "narrator": "千羽鶴", "text": "というわけで、\n適当に記録映像を流して\nおくから、後はよろしく。"},
        { "location": "143/TALK"  , "narrator": "千羽鶴", "text": "前回の続きからだから\n特に説明も要らないと思う。"},
        { "location": "144/SEL"   , "narrator": "", "text": "塩対応すぎる！"},
        { "location": "145/ACT"   , "narrator": "", "text": "塩対応すぎる！"},
        { "location": "148/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/70MB 4:37】</color>"},
        { "location": "149/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/22MB 4:37】</color>"},
        { "location": "150/SEL"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "151/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/70MB 4:37】</color>"},
        { "location": "152/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "158/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/22MB 4:37】</color>"},
        { "location": "159/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "165/ACT"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "166/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "167/TALK"  , "narrator": "千羽鶴", "text": "残念だけど、いろいろ\n事情があってのことだと\n思うから。"},
        { "location": "168/TALK"  , "narrator": "千羽鶴", "text": "家に帰ったら、是非\n映像記録の方も\n見てみて欲しい。"},
        { "location": "169/TALK"  , "narrator": "千羽鶴", "text": "それではどうぞ。"},
        { "location": "203/TALK"  , "narrator": "千羽鶴", "text": "はい、どうでしたか？"},
        { "location": "204/TALK"  , "narrator": "千羽鶴", "text": "今回は塩対応モードにつき\n質問は受け付けません。"},
        { "location": "206/SEL"   , "narrator": "", "text": "神楽のチャンネルくるー？"},
        { "location": "207/SEL"   , "narrator": "", "text": "今回のフェノメノンはどうなってるの？"},
        { "location": "208/SEL"   , "narrator": "", "text": "特にない\n<color=blue>（※先へ進みます）</color>"},
        { "location": "209/ACT"   , "narrator": "", "text": "神楽のチャンネルくるー？"},
        { "location": "210/TALK"  , "narrator": "千羽鶴", "text": "既にある。\nそれは貴方の心の中に。"},
        { "location": "211/SEL"   , "narrator": "", "text": "もちろんあるけど、それって来ないってこと？"},
        { "location": "212/SEL"   , "narrator": "", "text": "それって来ないってこと？"},
        { "location": "213/ACT"   , "narrator": "", "text": "もちろんあるけど、それって来ないってこと？"},
        { "location": "214/TALK"  , "narrator": "千羽鶴", "text": "本当にあるのね。"},
        { "location": "215/TALK"  , "narrator": "千羽鶴", "text": "ならば是非とも貴方の\n脳内でタップリと\nイチャイチャして欲しい。"},
        { "location": "216/ACT"   , "narrator": "", "text": "それって来ないってこと？"},
        { "location": "217/TALK"  , "narrator": "千羽鶴", "text": "前向きに検討しております。"},
        { "location": "219/SEL"   , "narrator": "", "text": "いや、実際の所どうなの？"},
        { "location": "220/ACT"   , "narrator": "", "text": "いや、実際の所どうなの？"},
        { "location": "223/TALK"  , "narrator": "千羽鶴", "text": "塩対応モードだって\n言ってるのに。"},
        { "location": "224/TALK"  , "narrator": "千羽鶴", "text": "卯月神楽のチャンネルは\nもちろん枠は\n用意してある。"},
        { "location": "225/TALK"  , "narrator": "千羽鶴", "text": "けど、何らかの障害が\n発生していて映らないから\n現在原因究明中。"},
        { "location": "226/SEL"   , "narrator": "", "text": "それって、神楽黒幕疑惑！？"},
        { "location": "227/SEL"   , "narrator": "", "text": "それって、神楽ラスボス疑惑！？"},
        { "location": "228/ACT"   , "narrator": "", "text": "それって、神楽黒幕疑惑！？"},
        { "location": "229/TALK"  , "narrator": "千羽鶴", "text": "んー。\n確かにそれはあるかも。"},
        { "location": "230/TALK"  , "narrator": "千羽鶴", "text": "一人だけ魔女ッ子っぽい\n上に、戦闘力も高いから、\nそうかもしれない。"},
        { "location": "231/SEL"   , "narrator": "", "text": "えっと、そういうの、隠す気無いの？"},
        { "location": "232/ACT"   , "narrator": "", "text": "えっと、そういうの、隠す気無いの？"},
        { "location": "235/TALK"  , "narrator": "千羽鶴", "text": "隠すも何も、\nよくわからないから\n適当に言ってるだけ。"},
        { "location": "236/TALK"  , "narrator": "千羽鶴", "text": "逆に黒幕だと思わせて\nおいて、実は真の勇者は\n彼女だけだったりして。"},
        { "location": "237/TALK"  , "narrator": "千羽鶴", "text": "それとも、彼女だけは\n既に死んでいるとか。"},
        { "location": "238/SEL"   , "narrator": "", "text": "どれもありそうで怖い"},
        { "location": "239/SEL"   , "narrator": "", "text": "混乱させようとしてる？"},
        { "location": "240/ACT"   , "narrator": "", "text": "どれもありそうで怖い"},
        { "location": "242/TALK"  , "narrator": "千羽鶴", "text": "そうね。この情報が\n錯綜する感覚、まさに\nネット時代って感じ。"},
        { "location": "243/ACT"   , "narrator": "", "text": "混乱させようとしてる？"},
        { "location": "245/TALK"  , "narrator": "千羽鶴", "text": "まさか。\n寧ろ私が混乱してる。"},
        { "location": "247/TALK"  , "narrator": "千羽鶴", "text": "何にせよ、\n早くシステムエラーの\n原因を突き止めないと。"},
        { "location": "248/ACT"   , "narrator": "", "text": "それって、神楽ラスボス疑惑！？"},
        { "location": "249/TALK"  , "narrator": "千羽鶴", "text": "それは違う！\n断じて違う！"},
        { "location": "250/SEL"   , "narrator": "", "text": "断言した！"},
        { "location": "251/ACT"   , "narrator": "", "text": "断言した！"},
        { "location": "253/TALK"  , "narrator": "千羽鶴", "text": "それはそう。\nだって――"},
        { "location": "256/TALK"  , "narrator": "千羽鶴", "text": "ラスボスは私だから！"},
        { "location": "257/TALK"  , "narrator": "千羽鶴", "text": "どーん！"},
        { "location": "258/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "260/TALK"  , "narrator": "千羽鶴", "text": "ごめんなさい。\n反省してる。"},
        { "location": "261/TALK"  , "narrator": "千羽鶴", "text": "とにかく私も\n混乱してる状況だから。"},
        { "location": "262/TALK"  , "narrator": "千羽鶴", "text": "早くシステムエラーの\n原因を突き止めないと。"},
        { "location": "265/ACT"   , "narrator": "", "text": "今回のフェノメノンはどうなってるの？"},
        { "location": "267/TALK"  , "narrator": "千羽鶴", "text": "今、塩対応モードだって\n言ってるのに。"},
        { "location": "268/TALK"  , "narrator": "千羽鶴", "text": "今回はWAVEアプリという\nチャットアプリがそのまま\n現実になったもの。"},
        { "location": "269/TALK"  , "narrator": "千羽鶴", "text": "襲ってきてるのは、\nスタンプね。"},
        { "location": "270/TALK"  , "narrator": "千羽鶴", "text": "そう、あの可愛かったり\nキモかったりする絵。"},
        { "location": "271/TALK"  , "narrator": "千羽鶴", "text": "スタンプに\n殺されたりしたら、\nもの凄く惨めかも。"},
        { "location": "272/TALK"  , "narrator": "千羽鶴", "text": "そういう意味でも今回は\n負けられないと思う。\n精神的に。"},
        { "location": "274/ACT"   , "narrator": "", "text": "特にない\n<color=blue>（※先へ進みます）</color>"},
        { "location": "281/TALK"  , "narrator": "千羽鶴", "text": "それじゃ、今回の\n逢瀬つばめについて、\nちゃっちゃと説明する。"},
        { "location": "282/TALK"  , "narrator": "千羽鶴", "text": "色々考えたんだけど、\n今回彼女がバトルに集中\nできるようにするには――"},
        { "location": "283/TALK"  , "narrator": "千羽鶴", "text": "数日前のある出来事で\n彼女をサポートしてあげる\nのが一番良いと判断した。"},
        { "location": "284/TALK"  , "narrator": "千羽鶴", "text": "そこで逢瀬つばめの\nチャンネルでは、数日前、\n入隊時にフォーカスする。"},
        { "location": "285/SEL"   , "narrator": "", "text": "入隊時？"},
        { "location": "286/ACT"   , "narrator": "", "text": "入隊時？"},
        { "location": "288/TALK"  , "narrator": "千羽鶴", "text": "そう。前回の\nドームでの戦いの翌日、\n逢瀬つばめは入隊した。"},
        { "location": "289/TALK"  , "narrator": "千羽鶴", "text": "それは記録映像に\nあった通り。"},
        { "location": "293/TALK"  , "narrator": "千羽鶴", "text": "けど、その入隊手続きは\nある一面においては、少々\n強引に行われた。"},
        { "location": "294/TALK"  , "narrator": "千羽鶴", "text": "そして彼女は、\nその日の夜に、その事を\nとても悩むことになる。"},
        { "location": "297/TALK"  , "narrator": "千羽鶴", "text": "貴方はそんな彼女の\n夜のひとときにアクセスし\n彼女のココロを導くの。"},
        { "location": "299/TALK"  , "narrator": "千羽鶴", "text": "その問題を解消できるか\n否かで、トライナリーの\n戦績は大きく変わる。"},
        { "location": "300/TALK"  , "narrator": "千羽鶴", "text": "というわけで、今回も\n彼女のサポートよろしく。"},
        { "location": "304/TALK"  , "narrator": "千羽鶴", "text": "それじゃ、今回の\n國政綾水について、\nちゃっちゃと説明する。"},
        { "location": "305/TALK"  , "narrator": "千羽鶴", "text": "色々考えたんだけど、\n今回彼女がバトルに集中\nできるようにするには――"},
        { "location": "306/TALK"  , "narrator": "千羽鶴", "text": "数日前のある出来事で\n彼女をサポートしてあげる\nのが一番良いと判断した。"},
        { "location": "307/TALK"  , "narrator": "千羽鶴", "text": "そこで今回、國政綾水の\nチャンネルでは――"},
        { "location": "308/TALK"  , "narrator": "千羽鶴", "text": "数日前、逢瀬つばめの\n入隊時にフォーカスを\n当てることにした。"},
        { "location": "309/SEL"   , "narrator": "", "text": "つばめの入隊時？"},
        { "location": "310/ACT"   , "narrator": "", "text": "つばめの入隊時？"},
        { "location": "312/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "314/TALK"  , "narrator": "千羽鶴", "text": "記録映像の通り、入隊\n手続きの際に、彼女は東雲\n真幌と共にその場にいた。"},
        { "location": "315/TALK"  , "narrator": "千羽鶴", "text": "そしてその後、入隊の件に\n関して東雲真幌と話すの\nだけど――"},
        { "location": "316/TALK"  , "narrator": "千羽鶴", "text": "その時、とても心を\nかき乱すような事態に\nなってしまう。"},
        { "location": "318/TALK"  , "narrator": "千羽鶴", "text": "貴方には、その時の彼女を\n見てもらい、的確に\nサポートしてもらいたい。"},
        { "location": "319/TALK"  , "narrator": "千羽鶴", "text": "その問題を解消できるか\n否かで、トライナリーの\n戦績は大きく変わる。"},
        { "location": "320/TALK"  , "narrator": "千羽鶴", "text": "というわけで、今回も\n彼女のサポートよろしく。"},
        { "location": "324/TALK"  , "narrator": "千羽鶴", "text": "それじゃ、今回の\nガブリエラについて、\nちゃっちゃと説明する。"},
        { "location": "325/TALK"  , "narrator": "千羽鶴", "text": "彼女は今回の戦闘に\n非常に大きな不満を\n持っている。"},
        { "location": "326/TALK"  , "narrator": "千羽鶴", "text": "いえ、寧ろこれは\n今までの蓄積もあっての\nことなんだけど。"},
        { "location": "327/TALK"  , "narrator": "千羽鶴", "text": "とにかく、その不満が\n既に無視できないレベルに\nまで大きくなってるの。"},
        { "location": "328/TALK"  , "narrator": "千羽鶴", "text": "このままでは、彼女の\n働きは非常に悪くなり、\n本人の為にもよくない。"},
        { "location": "329/TALK"  , "narrator": "千羽鶴", "text": "そこで貴方には、戦闘中の\n彼女から不満を聞き出し、\nクリアにしてもらいたい。"},
        { "location": "330/TALK"  , "narrator": "千羽鶴", "text": "その問題を解消できるか\n否かで、トライナリーの\n戦績は大きく変わる。"},
        { "location": "331/TALK"  , "narrator": "千羽鶴", "text": "というわけで、今回も\n彼女のサポートよろしく。"},
        { "location": "335/TALK"  , "narrator": "千羽鶴", "text": "それじゃ、今回の\n恋ヶ崎みやびについて、\nちゃっちゃと説明する。"},
        { "location": "336/TALK"  , "narrator": "千羽鶴", "text": "彼女は正直、私にも\n良く解らないことが多くて\n今回もかなり悩んだ。"},
        { "location": "337/TALK"  , "narrator": "千羽鶴", "text": "そして悩んだ結果、\n普通に彼女の日常生活を\n見てもらうことにした。"},
        { "location": "338/SEL"   , "narrator": "", "text": "え！？"},
        { "location": "339/ACT"   , "narrator": "", "text": "え！？"},
        { "location": "341/TALK"  , "narrator": "千羽鶴", "text": "だって仕方ないでしょう？"},
        { "location": "342/TALK"  , "narrator": "千羽鶴", "text": "彼女には今、特に何か\nサポートしなければ\nならない問題が無い。"},
        { "location": "343/TALK"  , "narrator": "千羽鶴", "text": "とは言っても、彼女だけ\n「今回はナシ」って\n言ったら怒るでしょ？"},
        { "location": "344/SEL"   , "narrator": "", "text": "そりゃそうだ！"},
        { "location": "345/SEL"   , "narrator": "", "text": "まあ、それならそれで"},
        { "location": "346/ACT"   , "narrator": "", "text": "そりゃそうだ！"},
        { "location": "347/TALK"  , "narrator": "千羽鶴", "text": "良かった。\n見繕う作業が\n無駄にならなくて。"},
        { "location": "348/ACT"   , "narrator": "", "text": "まあ、それならそれで"},
        { "location": "349/TALK"  , "narrator": "千羽鶴", "text": "淡泊。"},
        { "location": "350/TALK"  , "narrator": "千羽鶴", "text": "今流行の「ホトケ男子」？\nいや「ホトケ女子」かも。"},
        { "location": "351/TALK"  , "narrator": "千羽鶴", "text": "まあ、貴方のことなんて\nどうでもいい。"},
        { "location": "353/TALK"  , "narrator": "千羽鶴", "text": "というわけで、彼女の\n日常生活を\nお楽しみください。"},
        { "location": "354/TALK"  , "narrator": "千羽鶴", "text": "とはいえ、何もないのに\n彼女の生活を映したら、\nそれは単なる盗撮。"},
        { "location": "355/TALK"  , "narrator": "千羽鶴", "text": "そこで今回は、\n直接戦闘に関係\nないことだけど――"},
        { "location": "356/TALK"  , "narrator": "千羽鶴", "text": "私が彼女について、少々\n気になってることについて\nスポットを当ててみた。"},
        { "location": "357/SEL"   , "narrator": "", "text": "気になってること？"},
        { "location": "358/ACT"   , "narrator": "", "text": "気になってること？"},
        { "location": "360/TALK"  , "narrator": "千羽鶴", "text": "ええ。"},
        { "location": "361/TALK"  , "narrator": "千羽鶴", "text": "まあ、それが私の杞憂で、\n実際には何も無ければ\nそれでもよし。"},
        { "location": "362/TALK"  , "narrator": "千羽鶴", "text": "予想通り何かあっても、\n貴方がサポートして\nくれればそれでよし。"},
        { "location": "363/TALK"  , "narrator": "千羽鶴", "text": "…そんな感じ？"},
        { "location": "364/SEL"   , "narrator": "", "text": "どんな感じっすか…"},
        { "location": "365/ACT"   , "narrator": "", "text": "どんな感じっすか…"},
        { "location": "367/TALK"  , "narrator": "千羽鶴", "text": "というわけで、今回も\n彼女のサポートよろしく。"},
        { "location": "369/SEL"   , "narrator": "", "text": "頑張ります！"},
        { "location": "370/SEL"   , "narrator": "", "text": "塩対応といいつつ、ちゃんと説明する千羽鶴かわいい"},
        { "location": "371/ACT"   , "narrator": "", "text": "頑張ります！"},
        { "location": "372/ACT"   , "narrator": "", "text": "塩対応といいつつ、ちゃんと説明する千羽鶴かわいい"},
        { "location": "375/TALK"  , "narrator": "千羽鶴", "text": "…！？"},
        { "location": "376/TALK"  , "narrator": "千羽鶴", "text": "理解不能。"},
        { "location": "179/DIALOG", "narrator": "Tutorial/Dialog_Anime1", "text": "$dialog_word$"},
        { "location": "181/DIALOG", "narrator": "Tutorial/Dialog_Anime2", "text": "$dialog_word$"},
        { "location": "183/DIALOG", "narrator": "Tutorial/Dialog_Anime3", "text": "$dialog_word$"},
        { "location": "185/DIALOG", "narrator": "Tutorial/Dialog_Anime4", "text": "$dialog_word$"},
        { "location": "187/DIALOG", "narrator": "Tutorial/Dialog_Anime5", "text": "$dialog_word$"}
    ]
