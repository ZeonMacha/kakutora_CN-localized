    "entry":
    [
        { "location": "5/SCENARIO", "narrator": "", "text": "バトル前"},
        { "location": "29/TALK"   , "narrator": "千羽鶴", "text": "ようこそ。\nここは逢瀬つばめの\n精神世界――"},
        { "location": "30/TALK"   , "narrator": "千羽鶴", "text": "通称<color=red>【[ココロスフィア]】</color>\nと呼ばれている場所。"},
        { "location": "31/TALK"   , "narrator": "千羽鶴", "text": "ここでは彼女は\nあなたと普通に\n対話できる。"},
        { "location": "32/TALK"   , "narrator": "千羽鶴", "text": "彼女の心に直接\n語りかけることで、\n心を動かすの。"},
        { "location": "33/TALK"   , "narrator": "千羽鶴", "text": "早速、彼女を呼んで\n対話をしてみましょ。"},
        { "location": "42/DIALOG" , "narrator": "", "text": "<size=40>KOKORO-Lv. 01</size>\nTSUBAME - OHSE\n\n<size=45>最大幸福論</size>\n<size=35>～とある母子によるケース～</size>"},
        { "location": "57/TALK"   , "narrator": "つばめ", "text": "……。"},
        { "location": "59/TALK"   , "narrator": "つばめ", "text": "………。"},
        { "location": "62/TALK"   , "narrator": "つばめ", "text": "…。"},
        { "location": "64/SEL"    , "narrator": "（選択肢）", "text": "こんにちは"},
        { "location": "65/SEL"    , "narrator": "（選択肢）", "text": "お困りですか？"},
        { "location": "66/ACT"    , "narrator": "", "text": "こんにちは"},
        { "location": "67/ACT"    , "narrator": "", "text": "お困りですか？"},
        { "location": "70/TALK"   , "narrator": "つばめ", "text": "あなたは確か……"},
        { "location": "71/SEL"    , "narrator": "（選択肢）", "text": "そうです、私が$handle$です"},
        { "location": "72/SEL"    , "narrator": "（選択肢）", "text": "そうです、私がヘンな端末さんです"},
        { "location": "73/ACT"    , "narrator": "", "text": "そうです、私が$handle$です"},
        { "location": "74/TALK"   , "narrator": "つばめ", "text": "そう、$handle$……\n[ココロゲート]の\n司書から聞いた人だ。"},
        { "location": "75/ACT"    , "narrator": "", "text": "そうです、私がヘンな端末さんです"},
        { "location": "81/DIALOG" , "narrator": "", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"},
        { "location": "85/TALK"   , "narrator": "つばめ", "text": "え……………？"},
        { "location": "87/TALK"   , "narrator": "つばめ", "text": "お願い、\nわたしのココロで\nヘンなことしないで…"},
        { "location": "88/SEL"    , "narrator": "（選択肢）", "text": "当然ですよしませんよ、いやだなぁ"},
        { "location": "89/SEL"    , "narrator": "（選択肢）", "text": "色々しちゃうよムフフ"},
        { "location": "90/ACT"    , "narrator": "", "text": "当然ですよしませんよ、いやだなぁ"},
        { "location": "91/TALK"   , "narrator": "つばめ", "text": "ほんと？\nよかった！"},
        { "location": "92/ACT"    , "narrator": "", "text": "色々しちゃうよムフフ"},
        { "location": "98/DIALOG" , "narrator": "", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"},
        { "location": "102/TALK"  , "narrator": "つばめ", "text": "え、えええっ……\n何をされちゃうの…？"},
        { "location": "107/DIALOG", "narrator": "", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "114/TALK"  , "narrator": "つばめ", "text": "ふわあっ！"},
        { "location": "118/TALK"  , "narrator": "つばめ", "text": "ひやぁぁっ！"},
        { "location": "122/TALK"  , "narrator": "つばめ", "text": "やああっ！"},
        { "location": "127/DIALOG", "narrator": "", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"},
        { "location": "130/TALK"  , "narrator": "つばめ", "text": "おねがい、\nもう許してっ……"},
        { "location": "131/SEL"   , "narrator": "（選択肢）", "text": "ごめんね、もうしないよ"},
        { "location": "132/ACT"   , "narrator": "", "text": "ごめんね、もうしないよ"},
        { "location": "134/TALK"  , "narrator": "つばめ", "text": "ほんと？"},
        { "location": "135/SEL"   , "narrator": "（選択肢）", "text": "ほんと！"},
        { "location": "136/ACT"   , "narrator": "", "text": "ほんと！"},
        { "location": "138/TALK"  , "narrator": "つばめ", "text": "はぁ、\nよかった……。"},
        { "location": "140/TALK"  , "narrator": "つばめ", "text": "あれ？\n何もされなかった？"},
        { "location": "141/SEL"   , "narrator": "（選択肢）", "text": "ごめんね、冗談だったんだ"},
        { "location": "142/ACT"   , "narrator": "", "text": "ごめんね、冗談だったんだ"},
        { "location": "144/TALK"  , "narrator": "つばめ", "text": "なぁんだ、\nよかったぁ……。"},
        { "location": "145/TALK"  , "narrator": "つばめ", "text": "やっぱり本当は\n優しい人だったんだね。"},
        { "location": "152/DIALOG", "narrator": "", "text": "ゴキゲンポイントが\n<size=40><color=red><b>100pt.</b></color></size>\nアップしました！"},
        { "location": "158/TALK"  , "narrator": "つばめ", "text": "それで、ここに\n何をしにきたの？"},
        { "location": "159/SEL"   , "narrator": "（選択肢）", "text": "つばめのココロを支えに来たよ"},
        { "location": "160/ACT"   , "narrator": "", "text": "つばめのココロを支えに来たよ"},
        { "location": "163/TALK"  , "narrator": "つばめ", "text": "そうなんだ。"},
        { "location": "164/TALK"  , "narrator": "つばめ", "text": "確かにわたしのココロの\n中には、いつも何かの\n悩みがあるよ。"},
        { "location": "165/TALK"  , "narrator": "つばめ", "text": "後悔とか、自責とか\n決められないこととか、\nいろいろあるの。"},
        { "location": "166/SEL"   , "narrator": "（選択肢）", "text": "なるほど"},
        { "location": "167/ACT"   , "narrator": "", "text": "なるほど"},
        { "location": "169/TALK"  , "narrator": "つばめ", "text": "わたしもそういった\nことを抱え込んでる\n人格の一人なんだ。"},
        { "location": "170/SEL"   , "narrator": "（選択肢）", "text": "相談してみて？"},
        { "location": "171/ACT"   , "narrator": "", "text": "相談してみて？"},
        { "location": "173/TALK"  , "narrator": "つばめ", "text": "え？　いいの？"},
        { "location": "174/TALK"  , "narrator": "つばめ", "text": "そんなこと言ってくれた人\n始めてだから、\nちょっとドキドキするよ。"},
        { "location": "175/TALK"  , "narrator": "つばめ", "text": "あのね――"},
        { "location": "176/TALK"  , "narrator": "つばめ", "text": "わたし、なし崩し的に\n東京に住むように\nなっちゃったでしょ？"},
        { "location": "177/TALK"  , "narrator": "つばめ", "text": "それで、その事を責める\nわたしがいて……"},
        { "location": "178/TALK"  , "narrator": "つばめ", "text": "お母さんも入院中だし、\nお父さんもまだちゃんと\n納得してないし……。"},
        { "location": "179/TALK"  , "narrator": "つばめ", "text": "普通に考えて、こんな\n状態で東京に居残るとか、\nおかしいでしょ？"},
        { "location": "180/TALK"  , "narrator": "つばめ", "text": "だからこのままだとわたし\n突然「静岡に帰る」とか\n言い出しちゃいそうなの。"},
        { "location": "181/SEL"   , "narrator": "（選択肢）", "text": "素直に帰るってのはダメなの？"},
        { "location": "182/SEL"   , "narrator": "（選択肢）", "text": "そんなに軽い気持ちで決めたの？"},
        { "location": "183/ACT"   , "narrator": "", "text": "素直に帰るってのはダメなの？"},
        { "location": "185/TALK"  , "narrator": "つばめ", "text": "だ、ダメだよ！！"},
        { "location": "186/TALK"  , "narrator": "つばめ", "text": "トライナリーだって、\nわたしの中ではちゃんと\n考えて決めたんだもん。"},
        { "location": "187/TALK"  , "narrator": "つばめ", "text": "わかんないかも\nしれないけど、すごく\n固い決意だったんだよ！"},
        { "location": "188/ACT"   , "narrator": "", "text": "そんなに軽い気持ちで決めたの？"},
        { "location": "189/TALK"  , "narrator": "つばめ", "text": "ち、違うよ！\nわたしの中では、すごく\n固い決意だったんだよ！"},
        { "location": "191/TALK"  , "narrator": "つばめ", "text": "志願したのは、もちろん\n純粋にやってみたかった\nってのもあるけど……。"},
        { "location": "192/TALK"  , "narrator": "つばめ", "text": "それ以上に大切な\n理由があったんだ。"},
        { "location": "193/TALK"  , "narrator": "つばめ", "text": "だから、今からやめて\n帰るなんてできないよ。"},
        { "location": "194/SEL"   , "narrator": "（選択肢）", "text": "どんな理由なの？"},
        { "location": "195/ACT"   , "narrator": "", "text": "どんな理由なの？"},
        { "location": "197/TALK"  , "narrator": "つばめ", "text": "そ、それは……"},
        { "location": "198/TALK"  , "narrator": "つばめ", "text": "えっとね…"},
        { "location": "203/SEL"   , "narrator": "（選択肢）", "text": "なんだ？"},
        { "location": "204/ACT"   , "narrator": "", "text": "なんだ？"},
        { "location": "206/TALK"  , "narrator": "つばめ", "text": "……っ。\nもしかして……"},
        { "location": "210/TALK"  , "narrator": "つばめ", "text": "やっぱり……！"},
        { "location": "212/TALK"  , "narrator": "つばめ", "text": "大変だよ。\n[クラン]がこっちに\n向かってきてる！"},
        { "location": "213/SEL"   , "narrator": "（選択肢）", "text": "クランが？"},
        { "location": "214/ACT"   , "narrator": "", "text": "クランが？"},
        { "location": "216/TALK"  , "narrator": "つばめ", "text": "うん。"},
        { "location": "217/TALK"  , "narrator": "つばめ", "text": "わたしのココロの中に\n巣くう、色んな想いが\n実体化したものなの。"},
        { "location": "218/TALK"  , "narrator": "つばめ", "text": "[クラン]たちはいつも\n自分と違う考えを持つ\nクランと戦ってる。"},
        { "location": "219/TALK"  , "narrator": "つばめ", "text": "きっと、今回わたしが\n行動を起こそうと\nしたから――"},
        { "location": "220/TALK"  , "narrator": "つばめ", "text": "それに反対する\n[クラン]が、攻撃しに\n来たんだと思う。"},
        { "location": "225/TALK"  , "narrator": "つばめ", "text": "きゃあっ！！"},
        { "location": "226/SEL"   , "narrator": "（選択肢）", "text": "大丈夫！？"},
        { "location": "227/ACT"   , "narrator": "", "text": "大丈夫！？"},
        { "location": "229/TALK"  , "narrator": "つばめ", "text": "うん、ありがとう。"},
        { "location": "230/TALK"  , "narrator": "つばめ", "text": "ねえ、お願いがあるの！\nわたしと一緒に戦って！"},
        { "location": "231/TALK"  , "narrator": "つばめ", "text": "わたし、どうしても\nトライナリーやりたくて、\nだからっ…！！"},
        { "location": "232/SEL"   , "narrator": "（選択肢）", "text": "もちろん！"},
        { "location": "233/SEL"   , "narrator": "（選択肢）", "text": "それはどうかな"},
        { "location": "234/ACT"   , "narrator": "", "text": "もちろん！"},
        { "location": "236/TALK"  , "narrator": "つばめ", "text": "え！？　ほんとに？\nありがとう！！！"},
        { "location": "237/TALK"  , "narrator": "つばめ", "text": "それじゃお言葉に甘えて、\nよろしくお願いしますっ！"},
        { "location": "238/ACT"   , "narrator": "", "text": "それはどうかな"},
        { "location": "240/TALK"  , "narrator": "つばめ", "text": "えええええっ！！"},
        { "location": "241/TALK"  , "narrator": "つばめ", "text": "で、でももう\n[クラン]が来ちゃうよ！"},
        { "location": "242/TALK"  , "narrator": "つばめ", "text": "無理矢理になっちゃって\nごめんなさい！\nでも――"},
        { "location": "243/TALK"  , "narrator": "つばめ", "text": "お願いだから\n一緒に来てっ！"},
        { "location": "255/DIALOG", "narrator": "", "text": "<color=black><size=50><b>トライナリー志願を否定する\nもう１つの想いを撃破せよ！</b></size></color>\n\n\n\n逢瀬つばめは、確固たる理由があって\nトライナリーを志願し、東京に残った。\n\nだが、それを良しとしない気持ちもまた\n彼女のココロの中には存在しているのだ。\n\nこのままでは、その気持ちが勝ってしまい\nトライナリーをやめたいと言い出しかねない。\n\nそんな彼女の「恐れの感情」を抑制して、\n彼女が本当にやりたいことへの想いを支援しよう！"}
    ]
}
