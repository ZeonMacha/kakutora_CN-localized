    "entry":
    [
        { "location": "198/SCENARIO", "narrator": "", "text": "120_ディスプレイの向こう側"},
        { "location": "223/TALK"    , "narrator": "アーヤ", "text": "うーん、、、"},
        { "location": "224/TALK"    , "narrator": "アーヤ", "text": "こんな感じだったかしら、、、"},
        { "location": "225/TALK"    , "narrator": "アーヤ", "text": "なんか違うって感じは拭えないけど送るわね"},
        { "location": "226/TALK"    , "narrator": "アーヤ", "text": "それにしても"},
        { "location": "227/TALK"    , "narrator": "アーヤ", "text": "色々あったわね"},
        { "location": "231/TALK"    , "narrator": "ボイスメール", "text": "らんらんの乱"},
        { "location": "249/SEL"     , "narrator": "", "text": "あったね"},
        { "location": "250/SEL"     , "narrator": "", "text": "これで最後みたいでヤダ"},
        { "location": "251/ACT"     , "narrator": "", "text": "あったね"},
        { "location": "252/TALK"    , "narrator": "アーヤ", "text": "そうよね"},
        { "location": "253/ACT"     , "narrator": "", "text": "これで最後みたいでヤダ"},
        { "location": "254/TALK"    , "narrator": "アーヤ", "text": "えと"},
        { "location": "255/TALK"    , "narrator": "アーヤ", "text": "そういうつもりじゃないけど"},
        { "location": "258/SEL"     , "narrator": "", "text": "もしかして怒ってる？"},
        { "location": "259/SEL"     , "narrator": "", "text": "怒ってるわけじゃないよね"},
        { "location": "260/SEL"     , "narrator": "", "text": "なんかごめんね"},
        { "location": "261/ACT"     , "narrator": "", "text": "もしかして怒ってる？"},
        { "location": "262/TALK"    , "narrator": "アーヤ", "text": "ううん"},
        { "location": "263/TALK"    , "narrator": "アーヤ", "text": "別に"},
        { "location": "264/ACT"     , "narrator": "", "text": "怒ってるわけじゃないよね"},
        { "location": "265/TALK"    , "narrator": "アーヤ", "text": "そういうわけじゃない"},
        { "location": "266/TALK"    , "narrator": "アーヤ", "text": "けど"},
        { "location": "267/ACT"     , "narrator": "", "text": "なんかごめんね"},
        { "location": "277/TALK"    , "narrator": "アーヤ", "text": "やだ"},
        { "location": "278/TALK"    , "narrator": "アーヤ", "text": "そんなつもりじゃない"},
        { "location": "280/TALK"    , "narrator": "アーヤ", "text": "はず"},
        { "location": "284/TALK"    , "narrator": "アーヤ", "text": "ただ"},
        { "location": "285/TALK"    , "narrator": "アーヤ", "text": "貴方が人間って"},
        { "location": "286/TALK"    , "narrator": "アーヤ", "text": "本当なのかも練って"},
        { "location": "287/TALK"    , "narrator": "アーヤ", "text": "そう思うようになってきて"},
        { "location": "289/TALK"    , "narrator": "アーヤ", "text": "だから"},
        { "location": "290/TALK"    , "narrator": "アーヤ", "text": "余計に"},
        { "location": "292/TALK"    , "narrator": "アーヤ", "text": "どうすればいいか"},
        { "location": "293/TALK"    , "narrator": "アーヤ", "text": "悩んでるの"},
        { "location": "295/SEL"     , "narrator": "", "text": "$me$は$me$だよ"},
        { "location": "296/SEL"     , "narrator": "", "text": "悩む必要なんてないよ"},
        { "location": "297/ACT"     , "narrator": "", "text": "$me$は$me$だよ"},
        { "location": "298/TALK"    , "narrator": "アーヤ", "text": "それは"},
        { "location": "299/TALK"    , "narrator": "アーヤ", "text": "そうかも"},
        { "location": "300/TALK"    , "narrator": "アーヤ", "text": "しれないけど"},
        { "location": "301/ACT"     , "narrator": "", "text": "悩む必要なんてないよ"},
        { "location": "302/TALK"    , "narrator": "アーヤ", "text": "そんなわけにはいかないわ"},
        { "location": "303/TALK"    , "narrator": "アーヤ", "text": "っていうか"},
        { "location": "304/TALK"    , "narrator": "アーヤ", "text": "できないわ"},
        { "location": "307/SEL"     , "narrator": "", "text": "$me$のこと嫌い？"},
        { "location": "308/SEL"     , "narrator": "", "text": "考えすぎないでほしいな"},
        { "location": "309/ACT"     , "narrator": "", "text": "$me$のこと嫌い？"},
        { "location": "310/TALK"    , "narrator": "アーヤ", "text": "きらいｔか"},
        { "location": "311/TALK"    , "narrator": "アーヤ", "text": "とか"},
        { "location": "312/TALK"    , "narrator": "アーヤ", "text": "そういうのとは違う気がする"},
        { "location": "313/TALK"    , "narrator": "アーヤ", "text": "でも"},
        { "location": "314/TALK"    , "narrator": "アーヤ", "text": "ちょっとね"},
        { "location": "315/ACT"     , "narrator": "", "text": "考えすぎないでほしいな"},
        { "location": "316/TALK"    , "narrator": "アーヤ", "text": "それで割り切れないから"},
        { "location": "317/TALK"    , "narrator": "アーヤ", "text": "悩んでるのよ"},
        { "location": "319/TALK"    , "narrator": "アーヤ", "text": "もう"},
        { "location": "322/SEL"     , "narrator": "", "text": "アーヤとはまた普通に話したい"},
        { "location": "323/SEL"     , "narrator": "", "text": "わからない方がよかった？"},
        { "location": "324/ACT"     , "narrator": "", "text": "アーヤとはまた普通に話したい"},
        { "location": "325/TALK"    , "narrator": "アーヤ", "text": "普通"},
        { "location": "326/TALK"    , "narrator": "アーヤ", "text": "そうね"},
        { "location": "329/ACT"     , "narrator": "", "text": "わからない方がよかった？"},
        { "location": "330/TALK"    , "narrator": "アーヤ", "text": "それは"},
        { "location": "332/TALK"    , "narrator": "アーヤ", "text": "よくわからないわ"},
        { "location": "335/TALK"    , "narrator": "アーヤ", "text": "ちょっとね"},
        { "location": "336/TALK"    , "narrator": "アーヤ", "text": "整理しないとだめみたい"},
        { "location": "337/TALK"    , "narrator": "アーヤ", "text": "頭の中"},
        { "location": "338/TALK"    , "narrator": "アーヤ", "text": "だから"},
        { "location": "339/TALK"    , "narrator": "アーヤ", "text": "今日は"},
        { "location": "340/TALK"    , "narrator": "アーヤ", "text": "またね"},
        { "location": "243/DIALOG"  , "narrator": "Dialog_GETVoice", "text": "<color=green>【アーヤ】</color>のボイスメール\n<color=red>【らんらんの乱】</color>\nをゲットしました！"},
        { "location": "273/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>500pt.</b></color></size>\nアップしました！"}
    ]
}
