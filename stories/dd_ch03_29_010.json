        "title": "SideStory014 ストーリー",
        "sub_title": "FILE11.決行"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "東京編１１話"},
        { "location": "17/DIALOG" , "narrator": "", "text": "<color=green>9月6日　 6:38 PM</color>\nカラオケボックスでの相談後、神楽坂トライナリー前にて"},
        { "location": "18/TALK"   , "narrator": "ヒカル", "text": "…………。"},
        { "location": "19/TALK"   , "narrator": "ヒカル", "text": "なるほど…、大体だけど\nわかってきたかも…。"},
        { "location": "20/TALK"   , "narrator": "雛", "text": "ヒカルくん。"},
        { "location": "23/TALK"   , "narrator": "雛", "text": "お疲れさま。\n差し入れ持ってきたよ。"},
        { "location": "25/TALK"   , "narrator": "ヒカル", "text": "ありがとう。\n喉乾いてたから助かるよ。"},
        { "location": "26/TALK"   , "narrator": "雛", "text": "…それで、どう？"},
        { "location": "27/TALK"   , "narrator": "ヒカル", "text": "うん…劇場の警備は、\n予想以上の人数が\n動員されてたよ。"},
        { "location": "28/TALK"   , "narrator": "雛", "text": "じゃあ、侵入するのは\n無理ってこと？"},
        { "location": "29/TALK"   , "narrator": "ヒカル", "text": "いや…ちょっと作戦は\n考えてあるけど…。"},
        { "location": "30/TALK"   , "narrator": "ヒカル", "text": "教えるのは、もう少し\n考えてからにするよ。"},
        { "location": "31/TALK"   , "narrator": "ヒカル", "text": "できる限り安全な方法で\n侵入したいし。"},
        { "location": "32/TALK"   , "narrator": "雛", "text": "わかった。\n期待してるよー。"},
        { "location": "33/TALK"   , "narrator": "雛", "text": "…でも、本当にあの時、\nあたし一人だったら\nヤバかったんだねー？"},
        { "location": "34/TALK"   , "narrator": "雛", "text": "ありがと、ヒカルくん。\nあたしを止めてくれて…。"},
        { "location": "35/TALK"   , "narrator": "雛", "text": "もしヒカルくんが、\nあの時あたしのことを\n止めてくれなかったら…。"},
        { "location": "36/TALK"   , "narrator": "雛", "text": "今更だけど、考えると\n少し怖くなってくるよー。"},
        { "location": "37/TALK"   , "narrator": "ヒカル", "text": "いえ、そんな…。\n友達として当然のことを\nしたまでだから…。"},
        { "location": "38/TALK"   , "narrator": "雛", "text": "それだけじゃないの。"},
        { "location": "40/TALK"   , "narrator": "雛", "text": "あたし、ヒカルくんには\n謝らなきゃいけないこと\nあるから…。"},
        { "location": "41/TALK"   , "narrator": "ヒカル", "text": "…謝ること？"},
        { "location": "43/TALK"   , "narrator": "雛", "text": "…ヒカルくんに、\n無理に手伝わせちゃった\nこと…。"},
        { "location": "44/TALK"   , "narrator": "雛", "text": "ヒカルくんも、本当は\nつばめちゃんを助けたい、\nって言ってたけど…。"},
        { "location": "45/TALK"   , "narrator": "雛", "text": "最初は断ってたよね？"},
        { "location": "46/TALK"   , "narrator": "ヒカル", "text": "ええ、まあ…はい…。"},
        { "location": "47/TALK"   , "narrator": "雛", "text": "その考えが変わったの、\nあたしのせいだよね。"},
        { "location": "49/TALK"   , "narrator": "雛", "text": "あたしが、一人だけで\n動くなんて言ったから…。"},
        { "location": "50/TALK"   , "narrator": "雛", "text": "ヒカルくんに、手伝う\nって言わせちゃって…。\n本当、ごめんなさい…。"},
        { "location": "51/TALK"   , "narrator": "ヒカル", "text": "…………。"},
        { "location": "52/TALK"   , "narrator": "ヒカル", "text": "お礼を言われるのは\n嬉しいんだけど…。"},
        { "location": "53/TALK"   , "narrator": "ヒカル", "text": "謝られるのは、\nちょっと複雑かも…。"},
        { "location": "55/TALK"   , "narrator": "雛", "text": "え？"},
        { "location": "56/TALK"   , "narrator": "ヒカル", "text": "…確かに、協力することに\nなったきっかけは、\nひなこさんだよ。"},
        { "location": "57/TALK"   , "narrator": "ヒカル", "text": "けど、おかげで僕は、\n自分の気持ちに正直に\n行動することができた。"},
        { "location": "58/TALK"   , "narrator": "ヒカル", "text": "そのことを、僕は本当に\n嬉しく思ってるんだ。"},
        { "location": "59/TALK"   , "narrator": "ヒカル", "text": "それに、僕はひなこさんを\n本気で止めようとは、\n思ってなかったし…。"},
        { "location": "60/TALK"   , "narrator": "雛", "text": "…そうだったの？"},
        { "location": "61/TALK"   , "narrator": "ヒカル", "text": "ひなこさんだったら、\n絶対に一人でもやると\n思ってたんだ。"},
        { "location": "62/TALK"   , "narrator": "ヒカル", "text": "そしたら、予想的中。"},
        { "location": "63/TALK"   , "narrator": "ヒカル", "text": "そんなひなこさんを見て、\n本当に羨ましくなって…。"},
        { "location": "64/TALK"   , "narrator": "ヒカル", "text": "ひなこさんの\n手助けをしたい、\nって思ったから…。"},
        { "location": "65/TALK"   , "narrator": "ヒカル", "text": "僕はこうして、\n自分の気持ちに正直に\n動けるようになったんだ。"},
        { "location": "66/TALK"   , "narrator": "雛", "text": "…………。"},
        { "location": "67/TALK"   , "narrator": "ヒカル", "text": "仕方なくとか、嫌々とか、\n自分にウソをついて、\n協力してるんじゃないよ。"},
        { "location": "68/TALK"   , "narrator": "ヒカル", "text": "本当に、こうすることが\n僕にとっても一番だ、って\n思えたから…。"},
        { "location": "69/TALK"   , "narrator": "ヒカル", "text": "ひなこさんに、\n協力しようと思った。\nそれだけだよ。"},
        { "location": "70/TALK"   , "narrator": "雛", "text": "…………。"},
        { "location": "71/TALK"   , "narrator": "雛", "text": "ヒカルくんって、\nそういうことを\n自然に言えて…。"},
        { "location": "72/TALK"   , "narrator": "雛", "text": "大人っていうか、\n紳士的っていうか…、\nスゴイ人だよねー。"},
        { "location": "73/TALK"   , "narrator": "ヒカル", "text": "…そっか。\nじゃあ、もう一つの理由は\n言わなくて正解だったよ。"},
        { "location": "74/TALK"   , "narrator": "雛", "text": "他にも何かあったの？"},
        { "location": "75/TALK"   , "narrator": "ヒカル", "text": "…みんなが断ったのに、\n僕だけが手伝うって\n言ったら…。"},
        { "location": "76/TALK"   , "narrator": "ヒカル", "text": "ちょっと、かっこいいとこ\n見せられるかなぁ…、\nとか、思ったり…。"},
        { "location": "77/TALK"   , "narrator": "雛", "text": "えぇっ！？\nヒカルくんでも\nそんなこと思うの！？"},
        { "location": "78/TALK"   , "narrator": "ヒカル", "text": "あ、ありますよ。\nっていうか、\n普通に考えてますよ？"},
        { "location": "79/TALK"   , "narrator": "雛", "text": "へぇー、そうなんだー。"},
        { "location": "80/TALK"   , "narrator": "雛", "text": "ヒカルくんでも、\nかっこつけたくなったり\nするんだねー。"},
        { "location": "82/TALK"   , "narrator": "ヒカル", "text": "…うん、まあね。"},
        { "location": "83/TALK"   , "narrator": "ヒカル", "text": "…ある人の前でだけはね。"},
        { "location": "99/TALK"   , "narrator": "ガブリエラ", "text": "…多分、ひなこよね？"},
        { "location": "102/TALK"  , "narrator": "ガブリエラ", "text": "…やっぱり。"},
        { "location": "103/TALK"  , "narrator": "ガブリエラ", "text": "アーヤのところに\n長文送ってきたって\n言ってたから…。"},
        { "location": "104/TALK"  , "narrator": "ガブリエラ", "text": "なにか来るとは\n思ってたけど…。"},
        { "location": "109/TALK"  , "narrator": "雛", "text": "こちら東京のひなこ"},
        { "location": "110/TALK"  , "narrator": "雛", "text": "あたしとヒカルくんは今"},
        { "location": "112/TALK"  , "narrator": "雛", "text": "劇場の近くにいまーす！"},
        { "location": "113/TALK"  , "narrator": "雛", "text": "劇場への侵入方法捜索なう！"},
        { "location": "114/TALK"  , "narrator": "雛", "text": "警備すごいよー"},
        { "location": "115/TALK"  , "narrator": "雛", "text": "でも"},
        { "location": "116/TALK"  , "narrator": "雛", "text": "絶対中に入ってみせるよ"},
        { "location": "117/TALK"  , "narrator": "雛", "text": "ターゲットは床下のＰＣなり！！"},
        { "location": "119/TALK"  , "narrator": "雛", "text": "ガブリエラちゃん"},
        { "location": "120/TALK"  , "narrator": "雛", "text": "そっちも大変な想いしてると思うけど"},
        { "location": "121/TALK"  , "narrator": "雛", "text": "応援してるよ！"},
        { "location": "122/TALK"  , "narrator": "雛", "text": "頑張ってね！"},
        { "location": "133/TALK"  , "narrator": "ガブリエラ", "text": "…信じられない。"},
        { "location": "135/TALK"  , "narrator": "ガブリエラ", "text": "本当に…ひなこ達も\n動いてくれてるんだ…。"},
        { "location": "136/TALK"  , "narrator": "ガブリエラ", "text": "つばめや、あたし達の\n手助けをするために…。"},
        { "location": "137/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "149/TALK"  , "narrator": "ガブリエラ", "text": "怒られちゃうかも"},
        { "location": "150/TALK"  , "narrator": "ガブリエラ", "text": "今の私の気持ち"},
        { "location": "151/TALK"  , "narrator": "ガブリエラ", "text": "まほに知られたら"},
        { "location": "153/SEL"   , "narrator": "（選択肢）", "text": "まさか、返信するつもり？"},
        { "location": "154/SEL"   , "narrator": "（選択肢）", "text": "雛達への気持ち？"},
        { "location": "155/ACT"   , "narrator": "", "text": "まさか、返信するつもり？"},
        { "location": "156/TALK"  , "narrator": "ガブリエラ", "text": "そうじゃないわ"},
        { "location": "157/TALK"  , "narrator": "ガブリエラ", "text": "ひなこ達に対して"},
        { "location": "158/TALK"  , "narrator": "ガブリエラ", "text": "思ってる気持ちよ"},
        { "location": "159/ACT"   , "narrator": "", "text": "雛達への気持ち？"},
        { "location": "160/TALK"  , "narrator": "ガブリエラ", "text": "そうなの"},
        { "location": "161/TALK"  , "narrator": "ガブリエラ", "text": "まほにはナイショよ？"},
        { "location": "163/TALK"  , "narrator": "ガブリエラ", "text": "命の危険があるにも関わらず"},
        { "location": "164/TALK"  , "narrator": "ガブリエラ", "text": "私達のために"},
        { "location": "165/TALK"  , "narrator": "ガブリエラ", "text": "手助けするために"},
        { "location": "166/TALK"  , "narrator": "ガブリエラ", "text": "動いてくれてるの"},
        { "location": "167/TALK"  , "narrator": "ガブリエラ", "text": "もちろん不安も感じてるわ"},
        { "location": "168/TALK"  , "narrator": "ガブリエラ", "text": "けど"},
        { "location": "171/TALK"  , "narrator": "ガブリエラ", "text": "嬉しいの"},
        { "location": "172/TALK"  , "narrator": "ガブリエラ", "text": "そんなに私達のことを心配して"},
        { "location": "173/TALK"  , "narrator": "ガブリエラ", "text": "想ってくれてるのが"},
        { "location": "176/TALK"  , "narrator": "ガブリエラ", "text": "こんな風に思うのって"},
        { "location": "178/TALK"  , "narrator": "ガブリエラ", "text": "本当はよくないと思う"},
        { "location": "179/TALK"  , "narrator": "ガブリエラ", "text": "でもどうしても"},
        { "location": "180/TALK"  , "narrator": "ガブリエラ", "text": "そういう気持ちになっちゃうの"},
        { "location": "181/TALK"  , "narrator": "ガブリエラ", "text": "私は間違ってるかしら？"},
        { "location": "183/SEL"   , "narrator": "（選択肢）", "text": "本気で信頼してる証拠だ"},
        { "location": "184/SEL"   , "narrator": "（選択肢）", "text": "褒められないよ"},
        { "location": "185/ACT"   , "narrator": "", "text": "本気で信頼してる証拠だ"},
        { "location": "186/TALK"  , "narrator": "ガブリエラ", "text": "かもしれない"},
        { "location": "187/TALK"  , "narrator": "ガブリエラ", "text": "ううん"},
        { "location": "188/TALK"  , "narrator": "ガブリエラ", "text": "信頼してるわ"},
        { "location": "189/TALK"  , "narrator": "ガブリエラ", "text": "あの子達の存在を"},
        { "location": "190/TALK"  , "narrator": "ガブリエラ", "text": "とっても頼もしく感じてるわ"},
        { "location": "191/ACT"   , "narrator": "", "text": "褒められないよ"},
        { "location": "192/TALK"  , "narrator": "ガブリエラ", "text": "そう"},
        { "location": "195/TALK"  , "narrator": "ガブリエラ", "text": "そうよね"},
        { "location": "197/TALK"  , "narrator": "ガブリエラ", "text": "あの子達は一般人なんだから"},
        { "location": "198/TALK"  , "narrator": "ガブリエラ", "text": "こんな気持ち"},
        { "location": "199/TALK"  , "narrator": "ガブリエラ", "text": "よくなかったわ"},
        { "location": "202/TALK"  , "narrator": "ガブリエラ", "text": "頭冷やしてくるから"},
        { "location": "203/TALK"  , "narrator": "ガブリエラ", "text": "また後でね"},
        { "location": "216/TALK"  , "narrator": "ガブリエラ", "text": "…でも、無茶だけは\nしないといいんだけど…。"},
        { "location": "219/TALK"  , "narrator": "真幌", "text": "ん…？　おい、ギャヴィ。\nまさか東京からか？"},
        { "location": "221/TALK"  , "narrator": "ガブリエラ", "text": "…正解。\nひなこからだったわ。"},
        { "location": "222/TALK"  , "narrator": "真幌", "text": "まったく…、気持ちだけで\n行動を起こさなければ\nよいのだが…。"},
        { "location": "223/TALK"  , "narrator": "ガブリエラ", "text": "それ、無理っぽいわ。\n劇場の中に入ろうと\nしてるみたいだし。"},
        { "location": "224/TALK"  , "narrator": "真幌", "text": "…劇場に？"},
        { "location": "225/TALK"  , "narrator": "ガブリエラ", "text": "うん…意味は分からないん\nだけど、えっと…。"},
        { "location": "226/TALK"  , "narrator": "ガブリエラ", "text": "床下のＰＣがどうの、\nって言ってたかしら？"},
        { "location": "227/TALK"  , "narrator": "真幌", "text": "な、なんだと！！\nそれは本当か！？"},
        { "location": "229/TALK"  , "narrator": "ガブリエラ", "text": "え！？　え、ええ…。\n間違いないけど…、\nそれがどうかしたの？"},
        { "location": "230/TALK"  , "narrator": "真幌", "text": "なんてことを…。\nあいつら、正気か！？"},
        { "location": "231/TALK"  , "narrator": "ガブリエラ", "text": "あ、ちょっとまほ！\nどこ行くの！？"},
        { "location": "232/TALK"  , "narrator": "真幌", "text": "みやびのところだ！\n私の考えていることが\n間違っていなければ…。"},
        { "location": "233/TALK"  , "narrator": "真幌", "text": "次は、光月からみやびに\n連絡が入る！"},
        { "location": "238/TALK"  , "narrator": "ガブリエラ", "text": "…まほがあんなに\n慌てるなんて…。"},
        { "location": "239/TALK"  , "narrator": "ガブリエラ", "text": "ひなこ達は、いったい何を\nするつもりなの…？"}
    ]
}
