        { "location": "204/SCENARIO", "narrator": "", "text": "627_隣の席に"},
        { "location": "229/TALK"    , "narrator": "ガブリエラ", "text": "昼間ね"},
        { "location": "230/TALK"    , "narrator": "ガブリエラ", "text": "クラスの男子に話しかけようかって"},
        { "location": "231/TALK"    , "narrator": "ガブリエラ", "text": "相談をしたでしょう？"},
        { "location": "233/SEL"     , "narrator": "", "text": "したね"},
