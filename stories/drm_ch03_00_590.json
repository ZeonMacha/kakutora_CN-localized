        { "location": "235/ACT"     , "narrator": "", "text": "したね"},
        { "location": "236/TALK"    , "narrator": "ガブリエラ", "text": "ええ"},
        { "location": "237/TALK"    , "narrator": "ガブリエラ", "text": "したわよね"},
        { "location": "238/ACT"     , "narrator": "", "text": "したっけ？"},
        { "location": "239/TALK"    , "narrator": "ガブリエラ", "text": "もう"},
        { "location": "240/TALK"    , "narrator": "ガブリエラ", "text": "したわよ？"},
        { "location": "242/TALK"    , "narrator": "ガブリエラ", "text": "結局話しかけなかったけど"},
        { "location": "244/SEL"     , "narrator": "", "text": "安心したよ"},
        { "location": "245/SEL"     , "narrator": "", "text": "そうだね"},
        { "location": "246/ACT"     , "narrator": "", "text": "安心したよ"},
        { "location": "256/TALK"    , "narrator": "ガブリエラ", "text": "安心？"},
        { "location": "259/SEL"     , "narrator": "", "text": "ガブが話しかけていいのは$me$だけ"},
        { "location": "260/ACT"     , "narrator": "", "text": "ガブが話しかけていいのは$me$だけ"},
        { "location": "261/TALK"    , "narrator": "ガブリエラ", "text": "え///////////"},
        { "location": "262/TALK"    , "narrator": "ガブリエラ", "text": "やだ///////////"},
        { "location": "263/TALK"    , "narrator": "ガブリエラ", "text": "すぐそんなことばっかり//////////////////////"},
        { "location": "266/SEL"     , "narrator": "", "text": "本当のことだし"},
        { "location": "267/SEL"     , "narrator": "", "text": "ガブは違うの？"},
        { "location": "268/ACT"     , "narrator": "", "text": "本当のことだし"},
        { "location": "269/TALK"    , "narrator": "ガブリエラ", "text": "$handle$ったらvvvvvvvvvvvvvvvvvv"},
        { "location": "270/TALK"    , "narrator": "ガブリエラ", "text": "嫉妬とかしなくていいのよ////////////////////"},
        { "location": "271/TALK"    , "narrator": "ガブリエラ", "text": "もうvvvvvvvvvvvv"},
        { "location": "272/ACT"     , "narrator": "", "text": "ガブは違うの？"},
        { "location": "273/TALK"    , "narrator": "ガブリエラ", "text": "え"},
        { "location": "274/TALK"    , "narrator": "ガブリエラ", "text": "でも////////////////"},
        { "location": "275/TALK"    , "narrator": "ガブリエラ", "text": "そうかもしれないわ//////////////////////"},
        { "location": "276/TALK"    , "narrator": "ガブリエラ", "text": "なんて////////"},
        { "location": "277/TALK"    , "narrator": "ガブリエラ", "text": "こんなこと言わせないで////////"},
        { "location": "278/TALK"    , "narrator": "ガブリエラ", "text": "もうvvvvvvvvvvvv"},
        { "location": "280/ACT"     , "narrator": "", "text": "そうだね"},
        { "location": "281/TALK"    , "narrator": "ガブリエラ", "text": "そうなのよ"},
        { "location": "283/TALK"    , "narrator": "ガブリエラ", "text": "私まだまだね"},
        { "location": "284/TALK"    , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "285/TALK"    , "narrator": "ガブリエラ", "text": "$handle$がいてくれるから"},
        { "location": "286/TALK"    , "narrator": "ガブリエラ", "text": "って"},
        { "location": "287/TALK"    , "narrator": "ガブリエラ", "text": "そういうのがダメなのかしら？"},
        { "location": "289/SEL"     , "narrator": "", "text": "ダメじゃないよ"},
        { "location": "290/SEL"     , "narrator": "", "text": "側にいるから"},
