        "title": "001 ココロスフィアストーリー【Lv01】",
        "sub_title": "明晰記憶喪失＜提起＞"
    },
    "entry":
    [
        { "location": "5/SCENARIO", "narrator": "", "text": "バトル導入"},
        { "location": "29/TALK"   , "narrator": "千羽鶴", "text": "ようこそ。\nここはガブリエラの\n精神世界――"},
        { "location": "30/TALK"   , "narrator": "千羽鶴", "text": "通称<color=red>【[ココロスフィア]】</color>\nと呼ばれている場所。"},
        { "location": "31/TALK"   , "narrator": "千羽鶴", "text": "ここでは彼女は\nあなたと普通に\n対話できる。"},
        { "location": "32/TALK"   , "narrator": "千羽鶴", "text": "彼女の心に直接\n語りかけることで、\n心を動かすの。"},
        { "location": "33/TALK"   , "narrator": "千羽鶴", "text": "早速、彼女を呼んで\n対話をしてみましょ。"},
        { "location": "42/DIALOG" , "narrator": "", "text": "<size=40>KOKORO-Lv. 01</size>\nGABRIELLA\n\n<size=45>明晰記憶喪失</size>\n<size=35>～時間が止まったココロ～</size>"},
        { "location": "53/TALK"   , "narrator": "潜在ガブリエラ", "text": "あら、\nこんなところに\nお客さん？"},
        { "location": "54/TALK"   , "narrator": "潜在ガブリエラ", "text": "って、まあ！\n誰かと思えば\nマルザンナじゃない！"},
        { "location": "55/SEL"    , "narrator": "（選択肢）", "text": "いや、$me$は$handle$ですが"},
        { "location": "56/ACT"    , "narrator": "", "text": "いや、$me$は$handle$ですが"},
        { "location": "59/TALK"   , "narrator": "潜在ガブリエラ", "text": "何を訳の分からない\nことを言ってるの？"},
        { "location": "60/TALK"   , "narrator": "潜在ガブリエラ", "text": "それより、私の\n心の部屋に来てくれる\nなんて嬉しいわ。"},
        { "location": "61/TALK"   , "narrator": "潜在ガブリエラ", "text": "今日はどうして？\n何かサプライズでも\nあるのかしら！"},
        { "location": "62/SEL"    , "narrator": "（選択肢）", "text": "あなたのココロを落ち着かせに来ました"},
        { "location": "63/ACT"    , "narrator": "", "text": "あなたのココロを落ち着かせに来ました"},
        { "location": "67/TALK"   , "narrator": "潜在ガブリエラ", "text": "まあ、そうなの？\nとっても嬉しいわ♪"},
        { "location": "68/TALK"   , "narrator": "潜在ガブリエラ", "text": "でもね、マルザンナ。\nあたし今、悩んでること\nなんて特に無いのよ？"},
        { "location": "69/SEL"    , "narrator": "（選択肢）", "text": "え、本当に？例えばドーム戦の時とか、銃が撃てなくて悩んでたよね？"},
        { "location": "70/ACT"    , "narrator": "", "text": "え、本当に？例えばドーム戦の時とか、銃が撃てなくて悩んでたよね？"},
        { "location": "72/TALK"   , "narrator": "潜在ガブリエラ", "text": "……そうね。"},
        { "location": "73/TALK"   , "narrator": "潜在ガブリエラ", "text": "でも、本当のところ\nそんなことは\nどうでもいいの。"},
        { "location": "74/TALK"   , "narrator": "潜在ガブリエラ", "text": "銃なんて、撃てなきゃ\n撃たなければいいだけ\nなんだから。"},
        { "location": "75/TALK"   , "narrator": "潜在ガブリエラ", "text": "それより、せっかく\n来たんだから遊びま\nしょマルザンナ。"},
        { "location": "76/TALK"   , "narrator": "潜在ガブリエラ", "text": "お茶もお茶菓子も、\n用意してるわよ。"},
        { "location": "77/SEL"    , "narrator": "（選択肢）", "text": "昔、何かあったの？"},
        { "location": "78/ACT"    , "narrator": "", "text": "昔、何かあったの？"},
        { "location": "81/TALK"   , "narrator": "潜在ガブリエラ", "text": "何も無いわよ！"},
        { "location": "82/TALK"   , "narrator": "潜在ガブリエラ", "text": "そんな詮索する\nマルザンナなんて嫌い。"},
        { "location": "84/TALK"   , "narrator": "表層ガブリエラ", "text": "あたしも興味\nあるんだけど。"},
        { "location": "86/TALK"   , "narrator": "潜在ガブリエラ", "text": "あんたは！？"},
        { "location": "87/TALK"   , "narrator": "表層ガブリエラ", "text": "あたし？\n戦いを重んじる人格。"},
        { "location": "88/TALK"   , "narrator": "表層ガブリエラ", "text": "あんたね、あたしの\n心を引っかき回して\nいるのは。"},
        { "location": "89/TALK"   , "narrator": "潜在ガブリエラ", "text": "何もしてないわよ。"},
        { "location": "90/TALK"   , "narrator": "表層ガブリエラ", "text": "してる。　　　　"},
        { "location": "91/TALK"   , "narrator": "表層ガブリエラ", "text": "だってあんた、\nあたしが銃を棄てる\nよう働きかけてるし。"},
        { "location": "92/TALK"   , "narrator": "潜在ガブリエラ", "text": "当たり前よ！\n銃なんて何も生まない。\n傷つけるだけよ。"},
        { "location": "93/TALK"   , "narrator": "潜在ガブリエラ", "text": "自分も……\n周りの人たちも……。"},
        { "location": "94/TALK"   , "narrator": "表層ガブリエラ", "text": "……まあ。\nあんたが言いたい\nことはわかる。"},
        { "location": "95/TALK"   , "narrator": "表層ガブリエラ", "text": "でも私はソルジャーよ。\n銃が撃てないと、もっと\n不幸なことになるわ。"},
        { "location": "96/TALK"   , "narrator": "潜在ガブリエラ", "text": "それでも嫌！\n銃は絶対に嫌！！"},
        { "location": "98/TALK"   , "narrator": "表層ガブリエラ", "text": "ならば、\n徹底抗戦あるのみね。"},
        { "location": "99/TALK"   , "narrator": "潜在ガブリエラ", "text": "いいわよ。\nでも、あたしは\n絶対に倒せない。"},
        { "location": "101/TALK"  , "narrator": "潜在ガブリエラ", "text": "あたしの大切なお人形\nさんたちが、あたしを\n守ってくれるもの。"},
        { "location": "102/TALK"  , "narrator": "潜在ガブリエラ", "text": "銃よりも、\nよっぽど強いし\n頼りになるわ。"},
        { "location": "103/TALK"  , "narrator": "潜在ガブリエラ", "text": "なにより、\n誰も傷つけることが\nないもの。"},
        { "location": "104/TALK"  , "narrator": "潜在ガブリエラ", "text": "それでも倒すって\nいうならいらっしゃい。"},
        { "location": "105/TALK"  , "narrator": "潜在ガブリエラ", "text": "お人形さんたちに\nやっつけてもらうから。"},
        { "location": "109/TALK"  , "narrator": "表層ガブリエラ", "text": "……。"},
        { "location": "110/TALK"  , "narrator": "表層ガブリエラ", "text": "ねえ、あんた。"},
        { "location": "111/TALK"  , "narrator": "表層ガブリエラ", "text": "手伝ってくれる？"},
        { "location": "112/SEL"   , "narrator": "（選択肢）", "text": "何があったか教えてくれるなら"},
        { "location": "113/SEL"   , "narrator": "（選択肢）", "text": "デートしてくれるなら"},
        { "location": "114/ACT"   , "narrator": "", "text": "何があったか教えてくれるなら"},
        { "location": "121/TALK"  , "narrator": "表層ガブリエラ", "text": "ふーん、\n交渉するんだ。"},
        { "location": "122/TALK"  , "narrator": "表層ガブリエラ", "text": "いいわ。勝てたらね。\nあたしがわかる\n範囲で、だけど。"},
        { "location": "123/ACT"   , "narrator": "", "text": "デートしてくれるなら"},
        { "location": "135/DIALOG", "narrator": "", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"},
        { "location": "141/TALK"  , "narrator": "表層ガブリエラ", "text": "はぁ！？\n何言ってるの！？"},
        { "location": "142/TALK"  , "narrator": "表層ガブリエラ", "text": "ま、まあ、そんなこと\nで手伝ってくれるなら、\n全然いいけど？"},
        { "location": "146/TALK"  , "narrator": "表層ガブリエラ", "text": "それじゃ行きましょ。\n彼女の可愛いお人形\nさんたちと戦いに。"},
        { "location": "161/TALK"  , "narrator": "潜在ガブリエラ", "text": "……。"},
        { "location": "162/TALK"  , "narrator": "潜在ガブリエラ", "text": "本当に来ちゃったのね\nマルザンナ……。"},
        { "location": "164/TALK"  , "narrator": "表層ガブリエラ", "text": "あたしの生死が\nかかってるからね。"},
        { "location": "165/TALK"  , "narrator": "表層ガブリエラ", "text": "あんたも含めてだけど。"},
        { "location": "167/TALK"  , "narrator": "潜在ガブリエラ", "text": "あんたはそうね。\nでも、マルザンナは\n関係無いでしょう？"},
        { "location": "168/SEL"   , "narrator": "（選択肢）", "text": "ガブリエラを助けたいから"},
        { "location": "169/ACT"   , "narrator": "", "text": "ガブリエラを助けたいから"},
        { "location": "173/TALK"  , "narrator": "潜在ガブリエラ", "text": "はぁ……。\nもういい。\n失望したわ。"},
        { "location": "174/TALK"  , "narrator": "潜在ガブリエラ", "text": "あなたは私の\nお人形さんじゃ\nなかった。"},
        { "location": "176/TALK"  , "narrator": "潜在ガブリエラ", "text": "いいこと？\nこれより奥へは\n絶対に行かせない。"},
        { "location": "177/TALK"  , "narrator": "潜在ガブリエラ", "text": "あたしの大切な\nお人形さんたちが\nあんたを倒す。"},
        { "location": "178/TALK"  , "narrator": "潜在ガブリエラ", "text": "覚悟しなさいね。"},
        { "location": "190/DIALOG", "narrator": "", "text": "<color=black><size=50><b>銃を捨てさせようとする\nガブリエラを排除せよ！</b></size></color>\n\n\n銃を撃つことに対し、\nとあるトラウマを持つガブリエラ。\nそれをダシにして\nここぞとばかりに銃を捨てさせようとする\n人格が現れた。\n\n彼女がここで銃を諦めたら、\nトライナリーの戦力は格段に落ちてしまう。\n\nココロとトライナリーの安寧のためにも\n銃を捨てさせようとするガブリエラを排除しよう。"}
    ]
}
