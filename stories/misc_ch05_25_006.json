        { "location": "8815/SCENARIO", "narrator": "", "text": "たまには池袋にでも行きませんか"},
        { "location": "8840/TALK"    , "narrator": "神楽", "text": "やっぱりねー"},
        { "location": "8841/TALK"    , "narrator": "神楽", "text": "たまには行った方がいいと思うの"},
        { "location": "8842/TALK"    , "narrator": "神楽", "text": "池袋にも"},
        { "location": "8844/SEL"     , "narrator": "", "text": "アキバの方が楽しいよ"},
        { "location": "8845/SEL"     , "narrator": "", "text": "神楽の行きたい場所ならどこでも"},
        { "location": "8846/SEL"     , "narrator": "", "text": "ひょっとして腐ってる系女子？"},
        { "location": "8847/ACT"     , "narrator": "", "text": "アキバの方が楽しいよ"},
        { "location": "8848/TALK"    , "narrator": "神楽", "text": "そうかもしれないけど"},
        { "location": "8849/ACT"     , "narrator": "", "text": "神楽の行きたい場所ならどこでも"},
        { "location": "8851/TALK"    , "narrator": "神楽", "text": "模範解答だね$handle$"},
        { "location": "8852/TALK"    , "narrator": "神楽", "text": "訓練されてるー！"},
        { "location": "8853/TALK"    , "narrator": "神楽", "text": "でもそんな$handle$はきらいじゃないぴょん★"},
        { "location": "8854/ACT"     , "narrator": "", "text": "ひょっとして腐ってる系女子？"},
        { "location": "8855/TALK"    , "narrator": "神楽", "text": "違うけどー"},
        { "location": "8857/TALK"    , "narrator": "神楽", "text": "色んなことを知りたい女子だから。ぴょんこは"},
        { "location": "8859/TALK"    , "narrator": "神楽", "text": "なんかね？"},
        { "location": "8860/TALK"    , "narrator": "神楽", "text": "老舗のメイド喫茶もあるみたいだし"},
        { "location": "8861/TALK"    , "narrator": "神楽", "text": "気になるのよ乙女ロードも"},
        { "location": "8863/SEL"     , "narrator": "", "text": "好奇心は神楽を殺す"},
        { "location": "8864/SEL"     , "narrator": "", "text": "乙女は乙女でもなあ"},
        { "location": "8865/SEL"     , "narrator": "", "text": "別に止めないけど"},
        { "location": "8866/ACT"     , "narrator": "", "text": "好奇心は神楽を殺す"},
        { "location": "8867/TALK"    , "narrator": "神楽", "text": "ぴょんこは猫じゃなくてウサギだからそのことわざには当てはまらないぴょん"},
        { "location": "8868/TALK"    , "narrator": "神楽", "text": "ご心配なく★"},
        { "location": "8869/ACT"     , "narrator": "", "text": "乙女は乙女でもなあ"},
        { "location": "8870/TALK"    , "narrator": "神楽", "text": "色んな乙女があっていいと思うぴょん"},
        { "location": "8872/TALK"    , "narrator": "神楽", "text": "夢な乙女も全然アリ☆彡"},
        { "location": "8873/TALK"    , "narrator": "神楽", "text": "じゃないのかなー$handle$は"},
        { "location": "8874/TALK"    , "narrator": "神楽", "text": "難しいね！"},
        { "location": "8875/ACT"     , "narrator": "", "text": "別に止めないけど"},
        { "location": "8876/TALK"    , "narrator": "神楽", "text": "$handle$ってクール"},
        { "location": "8877/TALK"    , "narrator": "神楽", "text": "それともドライなの？"},
        { "location": "8878/TALK"    , "narrator": "神楽", "text": "束縛されるのはお互いいやだし"},
