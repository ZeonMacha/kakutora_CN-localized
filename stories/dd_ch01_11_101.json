{
    "dir": "chap11/daydra/dd_ch01_11_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "11102",
        "cid": "tsubame",
        "title": "002 メインストーリー",
        "sub_title": "親離れ子離れ＜前編＞"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "親離れ子離れ"},
        { "location": "22/TALK"   , "narrator": "つばめ", "text": "…………。"},
        { "location": "23/TALK"   , "narrator": "啓介", "text": "…………。"},
        { "location": "25/TALK"   , "narrator": "つばめ", "text": "…大変なことに\nなっちゃったなぁ…。"},
        { "location": "56/TALK"   , "narrator": "つばめ", "text": "ふぅ…変だなぁ。\nちゃんと掃除してる\nのに――"},
        { "location": "57/TALK"   , "narrator": "つばめ", "text": "どうしていつも、\nこんなに散らかって\nるんだろ…。"},
        { "location": "60/TALK"   , "narrator": "ガブリエラ", "text": "あっ、いたいた。"},
        { "location": "62/TALK"   , "narrator": "ガブリエラ", "text": "アーヤ、こっちよー！"},
        { "location": "66/TALK"   , "narrator": "アーヤ", "text": "よかった…。\nつばめ、あなたに\nお客さんよ。"},
        { "location": "68/TALK"   , "narrator": "つばめ", "text": "わたしに？\n誰ですか？"},
        { "location": "77/TALK"   , "narrator": "啓介", "text": "つばめ。"},
        { "location": "79/TALK"   , "narrator": "つばめ", "text": "……えっ。"},
        { "location": "81/TALK"   , "narrator": "つばめ", "text": "えぇーっ！？"},
        { "location": "82/TALK"   , "narrator": "つばめ", "text": "お、お父さん！！\nなんで！？"},
        { "location": "83/TALK"   , "narrator": "啓介", "text": "何でじゃないだろう！"},
        { "location": "84/TALK"   , "narrator": "啓介", "text": "帰ると言っておき\nながら、全然帰って\nきやせんし――"},
        { "location": "85/TALK"   , "narrator": "啓介", "text": "最近じゃ、\n連絡もよこさんで！"},
        { "location": "86/TALK"   , "narrator": "つばめ", "text": "しょ、しょーがない\nでしょ！？"},
        { "location": "87/TALK"   , "narrator": "つばめ", "text": "何度か帰ろうかとは\n思ったけど――"},
        { "location": "88/TALK"   , "narrator": "つばめ", "text": "色々あって、\nダメになっちゃったん\nだから。"},
        { "location": "89/TALK"   , "narrator": "啓介", "text": "ちゃんと帰ると\n約束だっただろう！\nいい加減にしろ！"},
        { "location": "91/TALK"   , "narrator": "つばめ", "text": "だから、帰れるときに\n帰るつもりだったん\nだってば！"},
        { "location": "92/TALK"   , "narrator": "ガブリエラ", "text": "…ねえ、アーヤ。\n今のつばめって――"},
        { "location": "93/TALK"   , "narrator": "ガブリエラ", "text": "いつもと様子が\n違わない？"},
        { "location": "95/TALK"   , "narrator": "アーヤ", "text": "だ、ダメよ。\nここでそういうこと\n言わないの。"},
        { "location": "97/TALK"   , "narrator": "つばめ", "text": "ううっ…、\n恥ずかしいとこ\n見られてる…。"},
        { "location": "99/TALK"   , "narrator": "つばめ", "text": "と、とにかく！\n今はお仕事中なの！"},
        { "location": "100/TALK"  , "narrator": "つばめ", "text": "みんなもいるから、\n話は後でわたしの\n部屋で――"},
        { "location": "101/TALK"  , "narrator": "真幌", "text": "あー、ったく！"},
        { "location": "106/TALK"  , "narrator": "真幌", "text": "うっさいなぁ。\n昼寝の時間が\n台無しじゃないか。"},
        { "location": "107/TALK"  , "narrator": "真幌", "text": "楽屋ではあれほど\n静かにしろと\n何度も――"},
        { "location": "109/TALK"  , "narrator": "真幌", "text": "んっ？"},
        { "location": "110/TALK"  , "narrator": "啓介", "text": "…………。"},
        { "location": "111/TALK"  , "narrator": "真幌", "text": "…………。"},
        { "location": "112/TALK"  , "narrator": "真幌", "text": "えっと…おたく、誰？"},
        { "location": "113/TALK"  , "narrator": "啓介", "text": "…あっ。"},
        { "location": "114/TALK"  , "narrator": "啓介", "text": "あー、ゴホン。\n私は、ここにいる\n逢瀬つばめの――"},
        { "location": "117/TALK"  , "narrator": "つばめ", "text": "わたしの父です。"},
        { "location": "118/TALK"  , "narrator": "真幌", "text": "……おお。"},
        { "location": "120/TALK"  , "narrator": "啓介", "text": "…つばめ、帰るぞ！"},
        { "location": "122/TALK"  , "narrator": "つばめ", "text": "えぇっ！？"},
        { "location": "123/TALK"  , "narrator": "ガブリエラ", "text": "ちょ、アーヤ！\nこのままじゃ――"},
        { "location": "125/TALK"  , "narrator": "アーヤ", "text": "わかってる。\nあの、逢瀬さんの\nお父さん――"},
        { "location": "126/TALK"  , "narrator": "アーヤ", "text": "あまりにも衝撃的\nだったことは\nお詫びします。"},
        { "location": "127/TALK"  , "narrator": "アーヤ", "text": "ですが、一応こんな\nところでも政府機関\nなので――"},
        { "location": "128/TALK"  , "narrator": "アーヤ", "text": "契約上、勝手に抜け\nたりすることは\nできないんです。"},
        { "location": "130/TALK"  , "narrator": "啓介", "text": "私はこんなところだ\nなんて聞いていない！"},
        { "location": "131/TALK"  , "narrator": "啓介", "text": "大体、映画館が\n政府機関だと？\n嘘も大概にしなさい！"},
        { "location": "132/TALK"  , "narrator": "アーヤ", "text": "しかし、契約書が――"},
        { "location": "134/TALK"  , "narrator": "啓介", "text": "契約は無効だ！\nつばめ、帰るぞ！"},
        { "location": "136/TALK"  , "narrator": "つばめ", "text": "だーめぇー！！\nいやだぁー！！"},
        { "location": "138/TALK"  , "narrator": "ガブリエラ", "text": "つばめ！？"},
        { "location": "140/TALK"  , "narrator": "アーヤ", "text": "お、お父さん！\n落ち着いてください！"},
        { "location": "142/TALK"  , "narrator": "真幌", "text": "…國政隊員。\nあとは私に\n任せなさい。"},
        { "location": "145/TALK"  , "narrator": "アーヤ", "text": "は、はい？"},
        { "location": "146/TALK"  , "narrator": "真幌", "text": "逢瀬隊員のお父様。\nまさかいらっしゃる\nとは思わず――"},
        { "location": "147/TALK"  , "narrator": "真幌", "text": "驚かせるようなことに\nなってしまい、申し訳\nありませんでした。"},
        { "location": "149/TALK"  , "narrator": "啓介", "text": "そんなことは\nどうでもいい！\n私はこの子と――"},
        { "location": "150/TALK"  , "narrator": "真幌", "text": "申し遅れました。\n私、情報管理庁\n所属――"},
        { "location": "151/TALK"  , "narrator": "真幌", "text": "対フェノメノン特化型\n特別攻撃隊隊長、\n東雲真幌と申します。"},
        { "location": "152/TALK"  , "narrator": "真幌", "text": "逢瀬隊員には、\nいつもお世話になって\nおります。"},
        { "location": "153/TALK"  , "narrator": "啓介", "text": "あ、ああ…。\n隊長？"},
        { "location": "154/TALK"  , "narrator": "真幌", "text": "はい。"},
        { "location": "156/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "159/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "161/TALK"  , "narrator": "真幌", "text": "ほら、君達は劇場の\n仕事をしなさい。"},
        { "location": "162/TALK"  , "narrator": "アーヤ", "text": "は、はい…。"},
        { "location": "164/TALK"  , "narrator": "ガブリエラ", "text": "…すぐ剥がれそうな\n化けの皮よね。"},
        { "location": "166/TALK"  , "narrator": "アーヤ", "text": "ギャヴィ！\nほら、早く行くわよ。"},
        { "location": "180/TALK"  , "narrator": "真幌", "text": "…一つずつしっかり\n説明を致します。"},
        { "location": "181/TALK"  , "narrator": "啓介", "text": "…………。"},
        { "location": "183/TALK"  , "narrator": "つばめ", "text": "…ど、どうなっちゃ\nうんだろ…。"},
        { "location": "205/TALK"  , "narrator": "啓介", "text": "…カモフラージュ、\nですと？"},
        { "location": "207/TALK"  , "narrator": "真幌", "text": "そうです。"},
        { "location": "208/TALK"  , "narrator": "真幌", "text": "我々特別攻撃隊、\n通称トライナリーの\n存在は――"},
        { "location": "209/TALK"  , "narrator": "真幌", "text": "一般の人達には\n秘密になっている\n特別な部隊です。"},
        { "location": "210/TALK"  , "narrator": "真幌", "text": "我々の部隊名だけは\n明らかになって\nいますが――"},
        { "location": "211/TALK"  , "narrator": "真幌", "text": "誰が、どのように\nフェノメノンを\n収束させているのか。"},
        { "location": "212/TALK"  , "narrator": "真幌", "text": "それについては、\n外部には一切情報を\n開示しておりません。"},
        { "location": "213/TALK"  , "narrator": "真幌", "text": "これは政府の方針で\nあり、その為に――"},
        { "location": "214/TALK"  , "narrator": "真幌", "text": "我々は、どう考えても\n政府の特務機関とは\n思えないような場所。"},
        { "location": "215/TALK"  , "narrator": "真幌", "text": "すなわち、場末の\n映画館という\nこの場所を――"},
        { "location": "216/TALK"  , "narrator": "真幌", "text": "司令部として\n活動しているのです。"},
        { "location": "217/TALK"  , "narrator": "啓介", "text": "…なるほど。\n理由はわかりました。"},
        { "location": "218/TALK"  , "narrator": "啓介", "text": "ですが、先ほどの\nあなたの言動の理由を\n聞いていませんが？"},
        { "location": "219/TALK"  , "narrator": "真幌", "text": "説明する必要も\nないでしょう？"},
        { "location": "220/TALK"  , "narrator": "真幌", "text": "仮に、この映画館が\n怪しまれて目を付け\nられたとします。"},
        { "location": "221/TALK"  , "narrator": "真幌", "text": "しかし、劇場に生息\nする女が、あのような\n姿をしていれば――"},
        { "location": "222/TALK"  , "narrator": "真幌", "text": "誰もそれ以上、政府の\n特務機関と思うことは\nできないでしょう。"},
        { "location": "223/TALK"  , "narrator": "真幌", "text": "これは、先ほどの\n父上の反応から\n察するに――"},
        { "location": "224/TALK"  , "narrator": "真幌", "text": "ご同意いただけると\n思いますが…、\nいかがでしょう？"},
        { "location": "225/TALK"  , "narrator": "啓介", "text": "え、ええ、まあ…。"},
        { "location": "226/TALK"  , "narrator": "真幌", "text": "我々は時として、\n自らを貶めるような\nカモフラージュを――"},
        { "location": "227/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "239/TALK"  , "narrator": "つばめ", "text": "なんだか"},
        { "location": "241/TALK"  , "narrator": "つばめ", "text": "大変なことになってきちゃった"},
        { "location": "242/TALK"  , "narrator": "つばめ", "text": "どうしよう"},
        { "location": "244/SEL"   , "narrator": "", "text": "お父さんが来たんだね？"},
        { "location": "245/ACT"   , "narrator": "", "text": "お父さんが来たんだね？"},
        { "location": "247/TALK"  , "narrator": "つばめ", "text": "うん"},
        { "location": "248/TALK"  , "narrator": "つばめ", "text": "まあ"},
        { "location": "249/TALK"  , "narrator": "つばめ", "text": "わたしがいつまでも"},
        { "location": "250/TALK"  , "narrator": "つばめ", "text": "家に帰らなかったのが"},
        { "location": "251/TALK"  , "narrator": "つばめ", "text": "いけないんだけど"},
        { "location": "253/SEL"   , "narrator": "", "text": "何で帰らなかったの？"},
        { "location": "254/ACT"   , "narrator": "", "text": "何で帰らなかったの？"},
        { "location": "257/TALK"  , "narrator": "つばめ", "text": "忙しくて"},
        { "location": "259/TALK"  , "narrator": "つばめ", "text": "ほら"},
        { "location": "260/TALK"  , "narrator": "つばめ", "text": "出撃とか"},
        { "location": "261/TALK"  , "narrator": "つばめ", "text": "バイトとか"},
        { "location": "262/TALK"  , "narrator": "つばめ", "text": "学校のこととか"},
        { "location": "263/TALK"  , "narrator": "つばめ", "text": "色々やることあって"},
        { "location": "265/TALK"  , "narrator": "つばめ", "text": "っていうか"},
        { "location": "266/TALK"  , "narrator": "つばめ", "text": "お母さんと相談して"},
        { "location": "267/TALK"  , "narrator": "つばめ", "text": "こっちで暮らすのＯＫしてくれたんだよ？"},
        { "location": "268/TALK"  , "narrator": "つばめ", "text": "なのに"},
        { "location": "269/TALK"  , "narrator": "つばめ", "text": "今更帰れなんて"},
        { "location": "270/TALK"  , "narrator": "つばめ", "text": "酷過ぎるよ"},
        { "location": "273/SEL"   , "narrator": "", "text": "本当にそんな忙しかったの？"},
        { "location": "274/ACT"   , "narrator": "", "text": "本当にそんな忙しかったの？"},
        { "location": "276/TALK"  , "narrator": "つばめ", "text": "うん"},
        { "location": "277/TALK"  , "narrator": "つばめ", "text": "凄く忙しくて"},
        { "location": "278/TALK"  , "narrator": "つばめ", "text": "ちょっと"},
        { "location": "279/TALK"  , "narrator": "つばめ", "text": "大変だったの"},
        { "location": "281/TALK"  , "narrator": "つばめ", "text": "本当だよ？"},
        { "location": "326/TALK"  , "narrator": "つばめ", "text": "こんにちは――"},
        { "location": "327/SEL"   , "narrator": "", "text": "嘘はいけませんよ！"},
        { "location": "328/SEL"   , "narrator": "", "text": "親不孝はいけませんよ！"},
        { "location": "329/SEL"   , "narrator": "", "text": "この機会にお父さんに$me$を紹介してくれるよう働きかけてください"},
        { "location": "330/ACT"   , "narrator": "", "text": "嘘はいけませんよ！"},
        { "location": "331/TALK"  , "narrator": "つばめ", "text": "えええっ！！\n急にどうしたんですか？"},
        { "location": "332/SEL"   , "narrator": "", "text": "忙しすぎて連絡できないとか嘘でしょ"},
        { "location": "333/ACT"   , "narrator": "", "text": "忙しすぎて連絡できないとか嘘でしょ"},
        { "location": "335/TALK"  , "narrator": "つばめ", "text": "えっと、ごめんなさい！"},
        { "location": "336/TALK"  , "narrator": "つばめ", "text": "ちょっと状況を\n把握できないので\n検索しますね。"},
        { "location": "337/ACT"   , "narrator": "", "text": "親不孝はいけませんよ！"},
        { "location": "338/TALK"  , "narrator": "つばめ", "text": "えええっ！！\nわたし、親不孝なんて\nしてませんよ？"},
        { "location": "339/SEL"   , "narrator": "", "text": "連絡してないからお父さん怒ってたよ？"},
        { "location": "340/ACT"   , "narrator": "", "text": "連絡してないからお父さん怒ってたよ？"},
        { "location": "342/TALK"  , "narrator": "つばめ", "text": "あー、その事ですか。"},
        { "location": "343/TALK"  , "narrator": "つばめ", "text": "きっと何か事情が\nあるんじゃ\nないでしょうか！"},
        { "location": "344/TALK"  , "narrator": "つばめ", "text": "ちょっと\n検索してみますね。"},
        { "location": "345/ACT"   , "narrator": "", "text": "この機会にお父さんに$me$を紹介してくれるよう働きかけてください"},
        { "location": "346/TALK"  , "narrator": "つばめ", "text": "え？\nそれは構いませんけど…。"},
        { "location": "347/TALK"  , "narrator": "つばめ", "text": "でも、直接現実のわたしに\n言えば、すぐに紹介して\nもらえると思いますよ？"},
        { "location": "348/TALK"  , "narrator": "つばめ", "text": "お父さんとも\nWAVE友に\nなりたいんですか？"},
        { "location": "349/SEL"   , "narrator": "", "text": "いや、そうじゃなくて…"},
        { "location": "350/SEL"   , "narrator": "", "text": "WAVE友ってなに？"},
        { "location": "351/ACT"   , "narrator": "", "text": "いや、そうじゃなくて…"},
        { "location": "352/TALK"  , "narrator": "つばめ", "text": "…？？"},
        { "location": "353/TALK"  , "narrator": "つばめ", "text": "よくわかりませんけど、\n今日もお仕事\n頑張っておきますね。"},
        { "location": "354/ACT"   , "narrator": "", "text": "WAVE友ってなに？"},
        { "location": "355/TALK"  , "narrator": "つばめ", "text": "WAVEの\nフレンド登録をしている\nお友達のことです。"},
        { "location": "356/TALK"  , "narrator": "つばめ", "text": "お父さん、あまり\nWAVE友いないから、\n案外喜ぶかも……。"},
        { "location": "357/TALK"  , "narrator": "つばめ", "text": "っと、そんなことより\nお仕事しないとですよね！"},
        { "location": "367/TALK"  , "narrator": "つばめ", "text": "オープンプロセス、\n0x554番地から\n0x103番地へ。"},
        { "location": "382/TALK"  , "narrator": "つばめ", "text": "シーク完了しました。"},
        { "location": "384/TALK"  , "narrator": "つばめ", "text": "さて、それで\n今回は……と…"},
        { "location": "386/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "387/TALK"  , "narrator": "つばめ", "text": "なるほど、\n状況はわかりました。"},
        { "location": "388/SEL"   , "narrator": "", "text": "で、どうなの？"},
        { "location": "389/ACT"   , "narrator": "", "text": "で、どうなの？"},
        { "location": "391/TALK"  , "narrator": "つばめ", "text": "ズバリ！\nわたしは\n嘘をついています！"},
        { "location": "392/SEL"   , "narrator": "", "text": "…自爆？"},
        { "location": "393/SEL"   , "narrator": "", "text": "えーそうだったんだー（棒）"},
        { "location": "394/SEL"   , "narrator": "", "text": "素敵な名推理ですね"},
        { "location": "395/ACT"   , "narrator": "", "text": "…自爆？"},
        { "location": "396/TALK"  , "narrator": "つばめ", "text": "自爆もなにも、\n本当の事ですから。"},
        { "location": "398/TALK"  , "narrator": "つばめ", "text": "ココロの司書は、\n如何なる時も、本当の\n事だけを伝えます！"},
        { "location": "399/SEL"   , "narrator": "", "text": "それこそが嘘だ！（ドーン"},
        { "location": "400/SEL"   , "narrator": "", "text": "じゃあ今日のパンツの色を教えてください"},
        { "location": "401/SEL"   , "narrator": "", "text": "じゃあ３サイズを教えてください"},
        { "location": "402/ACT"   , "narrator": "", "text": "それこそが嘘だ！（ドーン"},
        { "location": "403/TALK"  , "narrator": "つばめ", "text": "ホントですよー…。"},
        { "location": "404/SEL"   , "narrator": "", "text": "嘘がない人生なんてあり得ない"},
        { "location": "405/ACT"   , "narrator": "", "text": "嘘がない人生なんてあり得ない"},
        { "location": "407/TALK"  , "narrator": "つばめ", "text": "確かに現実では\nそうですね。でもここは\nココロの中ですし……。"},
        { "location": "408/ACT"   , "narrator": "", "text": "じゃあ今日のパンツの色を教えてください"},
        { "location": "411/TALK"  , "narrator": "つばめ", "text": "え……"},
        { "location": "412/SEL"   , "narrator": "", "text": "さっそく本当の事だけを伝えて下さい！"},
        { "location": "413/ACT"   , "narrator": "", "text": "さっそく本当の事だけを伝えて下さい！"},
        { "location": "416/TALK"  , "narrator": "つばめ", "text": "黙秘権を発動します！"},
        { "location": "417/TALK"  , "narrator": "つばめ", "text": "嘘は言ってませんよ？"},
        { "location": "418/SEL"   , "narrator": "", "text": "まあ、確かに"},
        { "location": "419/SEL"   , "narrator": "", "text": "どうせ今日もイチゴ柄でしょ？"},
        { "location": "420/ACT"   , "narrator": "", "text": "まあ、確かに"},
        { "location": "421/TALK"  , "narrator": "つばめ", "text": "ふふーん、です！"},
        { "location": "422/ACT"   , "narrator": "", "text": "どうせ今日もイチゴ柄でしょ？"},
        { "location": "424/TALK"  , "narrator": "つばめ", "text": "違いますよ！\n失礼ですね！"},
        { "location": "425/TALK"  , "narrator": "つばめ", "text": "ココロの司書は\nココロの中らしく\n黒ですから！"},
        { "location": "426/TALK"  , "narrator": "つばめ", "text": "そんなイチゴ柄とか\n子供っぽいのは\n現実の……"},
        { "location": "427/SEL"   , "narrator": "", "text": "なるほど"},
        { "location": "428/ACT"   , "narrator": "", "text": "なるほど"},
        { "location": "431/TALK"  , "narrator": "つばめ", "text": "…あわわわ！！\n何を言わせるんですか！"},
        { "location": "432/SEL"   , "narrator": "", "text": "自爆ですよね？"},
        { "location": "433/SEL"   , "narrator": "", "text": "つばめらしいね"},
        { "location": "434/ACT"   , "narrator": "", "text": "自爆ですよね？"},
        { "location": "436/TALK"  , "narrator": "つばめ", "text": "そうですね！"},
        { "location": "437/ACT"   , "narrator": "", "text": "つばめらしいね"},
        { "location": "439/TALK"  , "narrator": "つばめ", "text": "あはは……\nはぁ。"},
        { "location": "440/TALK"  , "narrator": "つばめ", "text": "そりゃそうですよ。\nわたしですもん。"},
        { "location": "443/ACT"   , "narrator": "", "text": "じゃあ３サイズを教えてください"},
        { "location": "446/TALK"  , "narrator": "つばめ", "text": "……え？"},
        { "location": "447/SEL"   , "narrator": "", "text": "さっそく本当の事だけを伝えて下さい！"},
        { "location": "448/ACT"   , "narrator": "", "text": "さっそく本当の事だけを伝えて下さい！"},
        { "location": "450/TALK"  , "narrator": "つばめ", "text": "拒否権を発動します！"},
        { "location": "452/TALK"  , "narrator": "つばめ", "text": "嘘は言ってませんよ？"},
        { "location": "453/SEL"   , "narrator": "", "text": "まあ、確かに"},
        { "location": "454/SEL"   , "narrator": "", "text": "言うのが恥ずかしいくらい、ふとってるってことなんだね"},
        { "location": "455/ACT"   , "narrator": "", "text": "まあ、確かに"},
        { "location": "456/TALK"  , "narrator": "つばめ", "text": "ふふーん、です！"},
        { "location": "457/ACT"   , "narrator": "", "text": "言うのが恥ずかしいくらい、ふとってるってことなんだね"},
        { "location": "459/TALK"  , "narrator": "つばめ", "text": "そんなこと無いですよ！\nウエスト６１ですもん！"},
        { "location": "460/TALK"  , "narrator": "つばめ", "text": "卯月さんが、いつも\n羨ましいって言いつつ\n脇腹揉んできて大変です。"},
        { "location": "461/SEL"   , "narrator": "", "text": "６１…メモメモ"},
        { "location": "462/SEL"   , "narrator": "", "text": "卯月さんの方がおなか出てるの？"},
        { "location": "463/ACT"   , "narrator": "", "text": "６１…メモメモ"},
        { "location": "464/TALK"  , "narrator": "つばめ", "text": "……え？"},
        { "location": "466/TALK"  , "narrator": "つばめ", "text": "ああああっ！\n何メモってるんですか！\n記憶から消してください！"},
        { "location": "468/TALK"  , "narrator": "つばめ", "text": "誘導尋問とか\n酷すぎます！"},
        { "location": "469/SEL"   , "narrator": "", "text": "普通は引っかからないレベルだよね"},
        { "location": "470/ACT"   , "narrator": "", "text": "普通は引っかからないレベルだよね"},
        { "location": "472/TALK"  , "narrator": "つばめ", "text": "むーーーーー！"},
        { "location": "473/ACT"   , "narrator": "", "text": "卯月さんの方がおなか出てるの？"},
        { "location": "474/TALK"  , "narrator": "つばめ", "text": "わたしより\n１センチ負けてる\nみたいですよ？"},
        { "location": "475/SEL"   , "narrator": "", "text": "クックックッ…"},
        { "location": "476/ACT"   , "narrator": "", "text": "クックックッ…"},
        { "location": "478/TALK"  , "narrator": "つばめ", "text": "え？　え？？"},
        { "location": "479/SEL"   , "narrator": "", "text": "つばめは純粋でかわいいね"},
        { "location": "480/SEL"   , "narrator": "", "text": "つばめは天然腹黒だね"},
        { "location": "481/ACT"   , "narrator": "", "text": "つばめは純粋でかわいいね"},
        { "location": "482/TALK"  , "narrator": "つばめ", "text": "そ、そうですか？\nありがとうございます！"},
        { "location": "483/ACT"   , "narrator": "", "text": "つばめは天然腹黒だね"},
        { "location": "484/TALK"  , "narrator": "つばめ", "text": "ええっ！？\n天然腹黒ですか？"},
        { "location": "485/TALK"  , "narrator": "つばめ", "text": "どっちかというと色白だと\n思っていたんですが……。\nショックです。"},
        { "location": "486/SEL"   , "narrator": "", "text": "…わざとでしょ"},
        { "location": "487/ACT"   , "narrator": "", "text": "…わざとでしょ"},
        { "location": "489/TALK"  , "narrator": "つばめ", "text": "え？\n何がですか？？"},
        { "location": "494/TALK"  , "narrator": "つばめ", "text": "……で！\n話を戻しますけど！"},
        { "location": "495/TALK"  , "narrator": "つばめ", "text": "色々理由並べてますけど、\n実際は、帰る時間は\n無くはなかったんです。"},
        { "location": "496/ACT"   , "narrator": "", "text": "えーそうだったんだー（棒）"},
        { "location": "497/TALK"  , "narrator": "つばめ", "text": "はい！\nそうだったんです！"},
        { "location": "498/SEL"   , "narrator": "", "text": "そんなドヤ顔してる場合じゃないでしょ"},
        { "location": "499/ACT"   , "narrator": "", "text": "そんなドヤ顔してる場合じゃないでしょ"},
        { "location": "501/TALK"  , "narrator": "つばめ", "text": "えへへ、そうですよね。"},
        { "location": "502/ACT"   , "narrator": "", "text": "素敵な名推理ですね"},
        { "location": "503/TALK"  , "narrator": "つばめ", "text": "えっへん！"},
        { "location": "504/SEL"   , "narrator": "", "text": "威張ってる場合じゃないでしょ"},
        { "location": "505/ACT"   , "narrator": "", "text": "威張ってる場合じゃないでしょ"},
        { "location": "507/TALK"  , "narrator": "つばめ", "text": "えへへ、そうですよね。"},
        { "location": "509/SEL"   , "narrator": "", "text": "正直に謝らないとダメじゃない？"},
        { "location": "510/SEL"   , "narrator": "", "text": "まあ、家族の関係も様々だしそういう事もあるよね"},
        { "location": "511/ACT"   , "narrator": "", "text": "正直に謝らないとダメじゃない？"},
        { "location": "512/TALK"  , "narrator": "つばめ", "text": "そうなんですよね。"},
        { "location": "513/TALK"  , "narrator": "つばめ", "text": "といいますか、\nわたしの総体もホントは\nそうしたいと思ってます。"},
        { "location": "514/ACT"   , "narrator": "", "text": "まあ、家族の関係も様々だしそういう事もあるよね"},
        { "location": "515/TALK"  , "narrator": "つばめ", "text": "そういうのも確かに\n一理ありますけど……"},
        { "location": "516/TALK"  , "narrator": "つばめ", "text": "でもやっぱり、わたしは\nお父さんとの関係は\n悪くしたくないです。"},
        { "location": "517/TALK"  , "narrator": "つばめ", "text": "だから今回はちゃんと\n正直に言って謝りたい\nと思ってます。"},
        { "location": "519/TALK"  , "narrator": "つばめ", "text": "でも、面倒くさかった…\nとか、やっぱり言いにくい\nじゃないですか。"},
        { "location": "520/TALK"  , "narrator": "つばめ", "text": "もちろん、それでも\n言わなければならない\nとは思いますが……"},
        { "location": "521/TALK"  , "narrator": "つばめ", "text": "……やっぱりどうしても\n出ちゃいますよね。\n阻止するクランが。"},
        { "location": "522/SEL"   , "narrator": "", "text": "頑張って倒すからちゃんと言うんだよ？"},
        { "location": "523/ACT"   , "narrator": "", "text": "頑張って倒すからちゃんと言うんだよ？"},
        { "location": "525/TALK"  , "narrator": "つばめ", "text": "はい、もちろんです！"},
        { "location": "526/TALK"  , "narrator": "つばめ", "text": "どうか\nよろしくお願いします！"},
        { "location": "527/TALK"  , "narrator": "つばめ", "text": "それじゃ行きますよ！"},
        { "location": "528/TALK"  , "narrator": "つばめ", "text": "$handle$さんと\nわたしに――"},
        { "location": "529/TALK"  , "narrator": "つばめ", "text": "っと、\nちょっと待ってください！"},
        { "location": "530/TALK"  , "narrator": "つばめ", "text": "すみません。\n大事なお話が\nあったんでした。"},
        { "location": "531/SEL"   , "narrator": "", "text": "どうしたの？"},
        { "location": "532/SEL"   , "narrator": "", "text": "もしかして告白？"},
        { "location": "533/ACT"   , "narrator": "", "text": "どうしたの？"},
        { "location": "534/TALK"  , "narrator": "つばめ", "text": "あ、えっと、\n実はですね……"},
        { "location": "535/ACT"   , "narrator": "", "text": "もしかして告白？"},
        { "location": "536/TALK"  , "narrator": "つばめ", "text": "え、えええっ！\n違いますよ！"},
        { "location": "537/TALK"  , "narrator": "つばめ", "text": "それはまたの機会に――"},
        { "location": "538/TALK"  , "narrator": "つばめ", "text": "じゃなくて！ ですね！"},
        { "location": "540/TALK"  , "narrator": "つばめ", "text": "わたし、近々\n有給休暇をいただいて\nいてですね。"},
        { "location": "541/TALK"  , "narrator": "つばめ", "text": "ちょっと帰省するので\nその時に当たっちゃったら\nごめんなさい。"},
        { "location": "542/SEL"   , "narrator": "", "text": "有給休暇なんてあるの！？"},
        { "location": "543/SEL"   , "narrator": "", "text": "帰省って…まさか$me$のことを親御さんに報告しに帰るの！？"},
        { "location": "544/ACT"   , "narrator": "", "text": "有給休暇なんてあるの！？"},
        { "location": "545/TALK"  , "narrator": "つばめ", "text": "ありますよ！\nわたしだって普通に\n休みますもん。"},
        { "location": "546/ACT"   , "narrator": "", "text": "帰省って…まさか$me$のことを親御さんに報告しに帰るの！？"},
        { "location": "547/TALK"  , "narrator": "つばめ", "text": "残念ながら\n違います…えへへ。"},
        { "location": "550/TALK"  , "narrator": "つばめ", "text": "あ、でも！"},
        { "location": "551/TALK"  , "narrator": "つばめ", "text": "$handle$さん\nこの前、司書やりたいって\n言ってましたよね？"},
        { "location": "552/TALK"  , "narrator": "つばめ", "text": "わたしがいないときに\n来ちゃったら、司書\nやっちゃってください。"},
        { "location": "553/SEL"   , "narrator": "", "text": "え！？"},
        { "location": "554/ACT"   , "narrator": "", "text": "え！？"},
        { "location": "556/TALK"  , "narrator": "つばめ", "text": "なんて、\n冗談ですよ。"},
        { "location": "558/SEL"   , "narrator": "", "text": "司書は本当の事しか伝えないのでは？"},
        { "location": "559/ACT"   , "narrator": "", "text": "司書は本当の事しか伝えないのでは？"},
        { "location": "561/TALK"  , "narrator": "つばめ", "text": "う、嘘と冗談は\n全然別物ですよぅ～。"},
        { "location": "563/TALK"  , "narrator": "つばめ", "text": "まあそんなわけで、\n何かあっても対応できない\n時がありますので……"},
        { "location": "564/TALK"  , "narrator": "つばめ", "text": "そこに当たらないように\n祈っててください。"},
        { "location": "566/TALK"  , "narrator": "つばめ", "text": "それじゃ改めまして！\n今回も張り切って\n行きましょう！"},
        { "location": "567/TALK"  , "narrator": "つばめ", "text": "$handle$さんと\nわたしに、\n素敵なココロの旅を！"},
        { "location": "21/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>6月21日　9:03 PM</color>\n寮「とらいあんぐる」つばめの部屋にて。"},
        { "location": "33/DIALOG" , "narrator": "Dialog_EventData", "text": "遡って、昨日。\n神楽坂トライナリー劇場でのこと。"},
        { "location": "294/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"}
    ]
}
