        "title": "001 アニメーション",
        "sub_title": "ガブリエラの紹介"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "アニメ第01～04話"},
        { "location": "48/TALK"   , "narrator": "千羽鶴", "text": "ようこそ。\nガブリエラの\nステージへ。"},
        { "location": "50/TALK"   , "narrator": "千羽鶴", "text": "それじゃまずは、\nガブリエラの\nおさらいから。"},
        { "location": "52/TALK"   , "narrator": "千羽鶴", "text": "ここから先は、\nそれぞれの少女ごとに\nチャンネルが分かれる。"},
        { "location": "53/TALK"   , "narrator": "千羽鶴", "text": "同じ空間で同じ事象を\n体験していても、感じ\n方や想いは様々。"},
        { "location": "54/TALK"   , "narrator": "千羽鶴", "text": "だから、貴方の彼女たち\nへのサポートもまた、\n様々なものになるはず。"},
        { "location": "55/TALK"   , "narrator": "千羽鶴", "text": "貴方には１００％の力で\n彼女を深くサポートして\n欲しいから――"},
        { "location": "56/TALK"   , "narrator": "千羽鶴", "text": "この恋愛ゲームでは、\n各彼女ごとに別チャン\nネルになってる。"},
        { "location": "57/TALK"   , "narrator": "千羽鶴", "text": "ところで――"},
        { "location": "58/TALK"   , "narrator": "千羽鶴", "text": "$handle$は、\nガブリエラを一番に\n選んだ。それはなぜ？"},
        { "location": "59/SEL"    , "narrator": "", "text": "彼女を支えたいから"},
        { "location": "60/SEL"    , "narrator": "", "text": "何となく"},
        { "location": "61/ACT"    , "narrator": "", "text": "彼女を支えたいから"},
        { "location": "62/TALK"   , "narrator": "千羽鶴", "text": "そう。\nとてもいい返答。"},
        { "location": "63/ACT"    , "narrator": "", "text": "何となく"},
        { "location": "64/TALK"   , "narrator": "千羽鶴", "text": "そう。まあ、\nそういう事もある。"},
        { "location": "65/TALK"   , "narrator": "千羽鶴", "text": "でも、彼女と接してみて\n自分向きじゃないと\n感じたら――"},
        { "location": "66/TALK"   , "narrator": "千羽鶴", "text": "無理につき合う\n必要は無いから。"},
        { "location": "67/TALK"   , "narrator": "千羽鶴", "text": "あまり気負わずに\nプレイしてみて。"},
        { "location": "68/TALK"   , "narrator": "千羽鶴", "text": "それじゃまずは、\nガブリエラについて\n今一度おさらいをする。"},
        { "location": "79/TALK"   , "narrator": "千羽鶴", "text": "[ガブリエラ]。\n<color=green>ガブちゃん</color>とか、\n<color=green>ギャヴィ</color>と言われてる。"},
        { "location": "80/TALK"   , "narrator": "千羽鶴", "text": "前にサラッと言った\nけど、彼女の銃の\nスキルは半端ない。"},
        { "location": "81/TALK"   , "narrator": "千羽鶴", "text": "記録映像を見て分かった\nと思うけど、それは常識を\n超えている。"},
        { "location": "82/SEL"    , "narrator": "", "text": "１００ｍ先のこけしを打ち抜くくらい？"},
        { "location": "83/SEL"    , "narrator": "", "text": "１００ｍ先の針の穴に糸を通すくらい？"},
        { "location": "84/ACT"    , "narrator": "", "text": "１００ｍ先のこけしを打ち抜くくらい？"},
        { "location": "85/TALK"   , "narrator": "千羽鶴", "text": "まさにその通り。\n彼女はそのくらい簡単に\nやってのける。"},
        { "location": "87/ACT"    , "narrator": "", "text": "１００ｍ先の針の穴に糸を通すくらい？"},
        { "location": "89/TALK"   , "narrator": "千羽鶴", "text": "変なこと言ってる人がいる。\nなんて非常識なのかしら。"},
        { "location": "90/SEL"    , "narrator": "", "text": "だって常識を超えてるのでは…？"},
        { "location": "91/ACT"    , "narrator": "", "text": "だって常識を超えてるのでは…？"},
        { "location": "93/TALK"   , "narrator": "千羽鶴", "text": "もちろん。"},
        { "location": "94/TALK"   , "narrator": "千羽鶴", "text": "でも、常識を超えている\nとは言っても、常識の\n範疇で考えて欲しかった。"},
        { "location": "95/TALK"   , "narrator": "千羽鶴", "text": "貴方には幻滅したわ。"},
        { "location": "96/SEL"    , "narrator": "", "text": "何を言ってるのかよくわかりません"},
        { "location": "97/ACT"    , "narrator": "", "text": "何を言ってるのかよくわかりません"},
        { "location": "99/TALK"   , "narrator": "千羽鶴", "text": "とまあ、\nそんな冗談はさておき。"},
        { "location": "100/TALK"  , "narrator": "千羽鶴", "text": "彼女は１００ｍ離れた\n所にあるこけしくらいなら\n簡単に撃ち落とせる。"},
        { "location": "102/SEL"   , "narrator": "", "text": "なるほど！"},
        { "location": "103/SEL"   , "narrator": "", "text": "何故にこけし…？"},
        { "location": "104/ACT"   , "narrator": "", "text": "なるほど！"},
        { "location": "105/TALK"  , "narrator": "千羽鶴", "text": "しかし彼女は今、その\n実力が発揮できない。"},
        { "location": "106/TALK"  , "narrator": "千羽鶴", "text": "全く銃が撃てなくなって\nしまう状況になったの。"},
        { "location": "107/ACT"   , "narrator": "", "text": "何故にこけしなの？"},
        { "location": "108/TALK"  , "narrator": "千羽鶴", "text": "ガブリエラが\n大好きなものだから。"},
        { "location": "109/SEL"   , "narrator": "", "text": "好きな物じゃ撃てないじゃん"},
        { "location": "110/ACT"   , "narrator": "", "text": "好きな物じゃ撃てないじゃん"},
        { "location": "112/TALK"  , "narrator": "千羽鶴", "text": "全くその通りね。"},
        { "location": "114/TALK"  , "narrator": "千羽鶴", "text": "そうそう、そういえば。"},
        { "location": "115/TALK"  , "narrator": "千羽鶴", "text": "今回彼女はまさに\nその状態になった。"},
        { "location": "116/TALK"  , "narrator": "千羽鶴", "text": "全く銃が撃てなくなって\nしまう状況になったの。"},
        { "location": "121/SEL"   , "narrator": "", "text": "そんな状況、映像にあったっけ？"},
        { "location": "122/ACT"   , "narrator": "", "text": "そんな状況、映像にあったっけ？"},
        { "location": "124/TALK"  , "narrator": "千羽鶴", "text": "映像ではそんな様子は\n映らない。"},
        { "location": "125/TALK"  , "narrator": "千羽鶴", "text": "なぜならそれは、\n彼女の心の中で静かに\n起こった事件だから。"},
        { "location": "129/TALK"  , "narrator": "千羽鶴", "text": "そして、\nもう分かってると思うけど\nここで貴方の出番。"},
        { "location": "130/TALK"  , "narrator": "千羽鶴", "text": "彼女に対してもまた、\nココロをサポートして\n解決に導いてあげて欲しい。"},
        { "location": "133/TALK"  , "narrator": "千羽鶴", "text": "そして、\nもう分かってると思うけど\nここで貴方の出番。"},
        { "location": "134/TALK"  , "narrator": "千羽鶴", "text": "彼女に対してもまた、\nココロをサポートして\n解決に導いてあげて欲しい。"},
        { "location": "135/SEL"   , "narrator": "", "text": "これで３人目なんだけど、みんな何か問題を抱えて戦っていたってこと？"},
        { "location": "136/ACT"   , "narrator": "", "text": "これで３人目なんだけど、みんな何か問題を抱えて戦っていたってこと？"},
        { "location": "138/TALK"  , "narrator": "千羽鶴", "text": "逆に聞きたい。"},
        { "location": "139/TALK"  , "narrator": "千羽鶴", "text": "生死を賭けた戦闘において\n一度も問題が発生しない\nことなんてどれ程あるか。"},
        { "location": "140/TALK"  , "narrator": "千羽鶴", "text": "記録映像にはその全てを\n記録することはできない。"},
        { "location": "141/TALK"  , "narrator": "千羽鶴", "text": "映像に記録されているだけ\nでも色々な問題は起きて\nいるけど――"},
        { "location": "142/TALK"  , "narrator": "千羽鶴", "text": "実際にはそれ以上に色々な\n問題や危機を、彼女達は\n沢山抱えている。"},
        { "location": "143/TALK"  , "narrator": "千羽鶴", "text": "それでも彼女達は、\n今までそれを自分で\n解決して乗り切ってきた。"},
        { "location": "144/TALK"  , "narrator": "千羽鶴", "text": "けど年端もいかない少女が\n毎回の死闘で、問題を解決\nし続けるには無理がある。"},
        { "location": "145/TALK"  , "narrator": "千羽鶴", "text": "だから私は、貴方に\n助けを求めているの。"},
        { "location": "146/TALK"  , "narrator": "千羽鶴", "text": "わかった？"},
        { "location": "147/SEL"   , "narrator": "", "text": "わかった"},
        { "location": "148/SEL"   , "narrator": "", "text": "まだよくわからない"},
        { "location": "149/ACT"   , "narrator": "", "text": "わかった"},
        { "location": "150/TALK"  , "narrator": "千羽鶴", "text": "オッケー。"},
        { "location": "151/TALK"  , "narrator": "千羽鶴", "text": "今回もまた、\n素晴らしいココロの\nサポートを期待してる。"},
        { "location": "152/ACT"   , "narrator": "", "text": "まだよくわからない"},
        { "location": "153/TALK"  , "narrator": "千羽鶴", "text": "焦らなくてもいい。\nそのうち何かのきっかけで\nわかるかもしれない。"},
        { "location": "154/TALK"  , "narrator": "千羽鶴", "text": "それでもわからなければ、\n途中でやめてもらっても\n構わない。"},
        { "location": "155/TALK"  , "narrator": "千羽鶴", "text": "私には貴方を強制する力も\n権限も無いから。"},
        { "location": "156/TALK"  , "narrator": "千羽鶴", "text": "とにかく、今回だけは\n是非とも頑張って欲しい。"},
        { "location": "157/TALK"  , "narrator": "千羽鶴", "text": "素晴らしいココロの\nサポートを期待してる。"},
        { "location": "161/SEL"   , "narrator": "", "text": "で、それを解決したのが$me$ってこと？"},
        { "location": "162/ACT"   , "narrator": "", "text": "で、それを解決したのが$me$ってこと？"},
        { "location": "165/TALK"  , "narrator": "千羽鶴", "text": "その通り。\nそして貴方にとっては\nこれから成すべきこと。"},
        { "location": "166/TALK"  , "narrator": "千羽鶴", "text": "彼女に対してもまた、\nココロをサポートして\n解決に導いてあげて欲しい。"},
        { "location": "169/SEL"   , "narrator": "", "text": "そうだったんだ！"},
        { "location": "170/ACT"   , "narrator": "", "text": "そうだったんだ！"},
        { "location": "172/TALK"  , "narrator": "千羽鶴", "text": "そうだったの。"},
        { "location": "173/TALK"  , "narrator": "千羽鶴", "text": "そして、\nそれを解決したのが貴方。"},
        { "location": "174/SEL"   , "narrator": "", "text": "いえ、何もやってませんが。"},
        { "location": "175/ACT"   , "narrator": "", "text": "いえ、何もやってませんが。"},
        { "location": "178/TALK"  , "narrator": "千羽鶴", "text": "そうね。\nだって、これから\nやってもらうのだから。"},
        { "location": "179/SEL"   , "narrator": "", "text": "意味がわかりません"},
        { "location": "180/ACT"   , "narrator": "", "text": "意味がわかりません"},
        { "location": "182/TALK"  , "narrator": "千羽鶴", "text": "貴方には、私たちの世界の\n時間を、未来へ過去へと\n自在に移動する力がある。"},
        { "location": "183/TALK"  , "narrator": "千羽鶴", "text": "貴方には、\nこのエピソードで\nガブリエラをサポートし――"},
        { "location": "184/TALK"  , "narrator": "千羽鶴", "text": "記録動画の通りに\n歴史が進むように、\n頑張ってもらう。"},
        { "location": "185/TALK"  , "narrator": "千羽鶴", "text": "いい？"},
        { "location": "186/SEL"   , "narrator": "", "text": "オッケー！"},
        { "location": "187/SEL"   , "narrator": "", "text": "それって歴史改変では！？"},
        { "location": "188/SEL"   , "narrator": "", "text": "いやです！"},
        { "location": "189/ACT"   , "narrator": "", "text": "オッケー！"},
        { "location": "192/ACT"   , "narrator": "", "text": "それって歴史改変では！？"},
        { "location": "193/TALK"  , "narrator": "千羽鶴", "text": "んー。\nそれはちょっと違う。"},
        { "location": "194/TALK"  , "narrator": "千羽鶴", "text": "まあ今は難しい事は\n考えず、彼女とイチャラブ\nする事に専念して。"},
        { "location": "195/ACT"   , "narrator": "", "text": "いやです！"},
        { "location": "196/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "197/TALK"  , "narrator": "千羽鶴", "text": "じゃあ今すぐに\n別の彼女のチャンネルに\n切り替えた方がいい。"},
        { "location": "202/TALK"  , "narrator": "千羽鶴", "text": "彼女が撃てなくなったのは\n逢瀬つばめがクランに首を\n掴まれてしまったところ。"},
        { "location": "203/TALK"  , "narrator": "千羽鶴", "text": "映像ではその後、すぐさま\nガブリエラが威嚇射撃を\nして、状況は好転する。"},
        { "location": "204/TALK"  , "narrator": "千羽鶴", "text": "一応、その前後の\n映像を編集して\n用意してあるけど、見る？"},
        { "location": "205/SEL"   , "narrator": "", "text": "見る"},
        { "location": "206/SEL"   , "narrator": "", "text": "見なくて平気"},
        { "location": "207/ACT"   , "narrator": "", "text": "見る"},
        { "location": "208/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "209/TALK"  , "narrator": "千羽鶴", "text": "ストリーミングで\n配信するから、\n回線が細い人は要注意。"},
        { "location": "210/TALK"  , "narrator": "千羽鶴", "text": "そんな人の為に、\n<color=green>あらすじレポート</color>も\n用意してある。"},
        { "location": "211/TALK"  , "narrator": "千羽鶴", "text": "回線種別と相談しつつ、\n映像にするか、レポート\nにするか決めて欲しい。"},
        { "location": "212/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/22MB 1:29】</color>"},
        { "location": "213/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/7MB 1:29】</color>"},
        { "location": "214/SEL"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "215/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/22MB 1:29】</color>"},
        { "location": "216/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "222/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/7MB 1:29】</color>"},
        { "location": "223/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "229/ACT"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "230/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "231/TALK"  , "narrator": "千羽鶴", "text": "残念だけど、いろいろ\n事情があってのことだと\n思うから。"},
        { "location": "232/TALK"  , "narrator": "千羽鶴", "text": "家に帰ったら、是非\n記録映像の方も\n見てみて欲しい。"},
        { "location": "233/TALK"  , "narrator": "千羽鶴", "text": "それではどうぞ。"},
        { "location": "249/TALK"  , "narrator": "千羽鶴", "text": "どう？\nどういう状況だったか\n思い出せた？"},
        { "location": "250/TALK"  , "narrator": "千羽鶴", "text": "是非、ガブリエラの\nココロを落ち着かせて――"},
        { "location": "251/TALK"  , "narrator": "千羽鶴", "text": "この映像のように、\n的確な射撃で状況を改善\nできるようにして欲しい。"},
        { "location": "253/ACT"   , "narrator": "", "text": "見なくて平気"},
        { "location": "254/TALK"  , "narrator": "千羽鶴", "text": "そう、わかった。"},
        { "location": "255/TALK"  , "narrator": "千羽鶴", "text": "是非ガブリエラのココロを\n落ち着かせて、状況を改善\nできるようにして欲しい。"},
        { "location": "268/TALK"  , "narrator": "千羽鶴", "text": "どう？\nどういう状況だったか\n思い出せた？"},
        { "location": "269/TALK"  , "narrator": "千羽鶴", "text": "是非、ガブリエラの\nココロを落ち着かせて――"},
        { "location": "270/TALK"  , "narrator": "千羽鶴", "text": "この映像のように、\n的確な射撃で状況を改善\nできるようにして欲しい。"},
        { "location": "240/DIALOG", "narrator": "Tutorial/Dialog_Anime3", "text": "敵（女剣士）は手強く、\n逢瀬つばめも常に近くにいるため、\nなかなか女剣士に手出し出来ない。\n\nそうこうしているうちに、\n逢瀬つばめが女剣士に追い詰められる。\n\n剣士のアーヤはまだ接近できておらず\n後方支援のみやびでは手出しできない。\n\n銃の使いであるガブリエラは、\n今こそ自分の力が発揮できると考え\n遠方から女騎士に照準を合わせる――。\n\n\nそして見事に女騎士の剣を打ち抜き\n武器を破壊。そこからはトライナリーの\n優勢となる。\nみやびがつばめを抱えて保護する。\nその間にアーヤは女騎士と対峙。\n\nだが、そんな一息付けると思った矢先、\nみやびは保護対象であるつばめから、\n信じられない言葉を聞く。\n「メノウちゃんを助けたいの！」\n"}
    ]
}
