    "entry":
    [
        { "location": "90/SCENARIO", "narrator": "", "text": "ざわめきのフォークロア"},
        { "location": "115/TALK"   , "narrator": "みやび", "text": "ネット上の都市伝説"},
        { "location": "116/TALK"   , "narrator": "みやび", "text": "それがネットロア"},
        { "location": "118/SEL"    , "narrator": "", "text": "造語だね"},
        { "location": "119/SEL"    , "narrator": "", "text": "怖い話なら聞きたい"},
        { "location": "120/SEL"    , "narrator": "", "text": "二人で伝説になろう"},
        { "location": "121/ACT"    , "narrator": "", "text": "造語だね"},
        { "location": "122/TALK"   , "narrator": "みやび", "text": "左様"},
        { "location": "123/ACT"    , "narrator": "", "text": "怖い話なら聞きたい"},
        { "location": "124/TALK"   , "narrator": "みやび", "text": "意外と"},
        { "location": "126/TALK"   , "narrator": "みやび", "text": "イケる口だったか"},
        { "location": "127/ACT"    , "narrator": "", "text": "二人で伝説になろう"},
        { "location": "129/TALK"   , "narrator": "みやび", "text": "いい響きぞね"},
        { "location": "130/TALK"   , "narrator": "みやび", "text": "伝説になろうとは"},
        { "location": "132/TALK"   , "narrator": "みやび", "text": "さてさて"},
        { "location": "133/TALK"   , "narrator": "みやび", "text": "この神楽坂トライナリーにも"},
        { "location": "134/TALK"   , "narrator": "みやび", "text": "色々な噂があるわけだが"},
        { "location": "136/SEL"    , "narrator": "", "text": "夜中の映写室に……"},
        { "location": "137/SEL"    , "narrator": "", "text": "仕込みのやつ？"},
        { "location": "138/SEL"    , "narrator": "", "text": "和装美少女の噂かな"},
        { "location": "139/ACT"    , "narrator": "", "text": "夜中の映写室に……"},
        { "location": "140/TALK"   , "narrator": "みやび", "text": "怖い話なら"},
        { "location": "142/TALK"   , "narrator": "みやび", "text": "やめておくがよかろう"},
        { "location": "143/TALK"   , "narrator": "みやび", "text": "怖いからな"},
        { "location": "144/ACT"    , "narrator": "", "text": "仕込みのやつ？"},
        { "location": "145/TALK"   , "narrator": "みやび", "text": "ああ"},
        { "location": "146/TALK"   , "narrator": "みやび", "text": "そういうのもあった"},
        { "location": "147/TALK"   , "narrator": "みやび", "text": "早耳だな"},
        { "location": "148/ACT"    , "narrator": "", "text": "和装美少女の噂かな"},
        { "location": "150/TALK"   , "narrator": "みやび", "text": "わかりやすいおだてになど"},
        { "location": "151/TALK"   , "narrator": "みやび", "text": "乗ってやるぞ"},
        { "location": "152/TALK"   , "narrator": "みやび", "text": "オホホホホホホ"},
        { "location": "154/TALK"   , "narrator": "みやび", "text": "噂を確認したとして"},
        { "location": "155/TALK"   , "narrator": "みやび", "text": "大事なことは"},
        { "location": "156/TALK"   , "narrator": "みやび", "text": "真実はひとつきりではない"},
        { "location": "157/TALK"   , "narrator": "みやび", "text": "ということだ"},
        { "location": "158/TALK"   , "narrator": "みやび", "text": "関わる人間すべてが"},
        { "location": "159/TALK"   , "narrator": "みやび", "text": "その人間にとっての真実を持っているのだ"}
    ]
}
