{
    "dir": "chap07/battle/btev_ch04_07_00.js",
    "type": "",
    "info": {
        "story_id": "24010",
        "cid": "",
        "title": "010 ココロスフィアストーリー【Lv04】",
        "sub_title": "監視＜提起＞"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "監視"},
        { "location": "13/DIALOG" , "narrator": "", "text": "<size=40>KOKORO-Lv. 04</size>\nMIYABI - KOIGASAKI\n\n<size=45>監視</size>\n<size=35>～天然か養殖か～</size>"},
        { "location": "43/TALK"   , "narrator": "みやび", "text": "…むっ！？"},
        { "location": "45/TALK"   , "narrator": "みやび", "text": "ああ…なんだ、\n$handle$か…。"},
        { "location": "46/TALK"   , "narrator": "みやび", "text": "いつの間に\n見ちょったが？"},
        { "location": "47/TALK"   , "narrator": "みやび", "text": "こっちは今、\n気がピリピリ\nしちょるき――"},
        { "location": "48/TALK"   , "narrator": "みやび", "text": "覗き見厳禁や。\nほれ、帰った帰った。"},
        { "location": "49/SEL"    , "narrator": "（選択肢）", "text": "警戒してる？"},
        { "location": "50/ACT"    , "narrator": "", "text": "警戒してる？"},
        { "location": "52/TALK"   , "narrator": "みやび", "text": "バリバリ厳戒態勢や。"},
        { "location": "53/TALK"   , "narrator": "みやび", "text": "今もうちを――"},
        { "location": "55/TALK"   , "narrator": "みやび", "text": "ハッ！？"},
        { "location": "56/TALK"   , "narrator": "みやび", "text": "そこ！\n誰や！？"},
        { "location": "58/TALK"   , "narrator": "つばめ", "text": "はわわっ！？"},
        { "location": "61/TALK"   , "narrator": "つばめ", "text": "こ、こんばんはぁ。"},
        { "location": "62/TALK"   , "narrator": "みやび", "text": "…何の用や？"},
        { "location": "63/TALK"   , "narrator": "つばめ", "text": "えへへー。\nこんな時間まで\nお仕事ですかぁ？"},
        { "location": "64/TALK"   , "narrator": "みやび", "text": "…そうや。\n色々やること\nあってな。"},
        { "location": "65/TALK"   , "narrator": "みやび", "text": "つばめちゃんこそ、\nこんな時間まで\n何やっちょるが？"},
        { "location": "66/TALK"   , "narrator": "つばめ", "text": "夜のお散歩をしてた\nだけですよー。"},
        { "location": "67/TALK"   , "narrator": "つばめ", "text": "そしたら、\nみやびさんの\n部屋から――"},
        { "location": "68/TALK"   , "narrator": "つばめ", "text": "灯りが漏れてるのが\n見えたんですー。"},
        { "location": "69/TALK"   , "narrator": "みやび", "text": "…監視しちょったが？"},
        { "location": "70/TALK"   , "narrator": "つばめ", "text": "えー、違いますよー。"},
        { "location": "73/TALK"   , "narrator": "みやび", "text": "…もうえいから、\n部屋帰りぃ。"},
        { "location": "74/TALK"   , "narrator": "つばめ", "text": "そうしますー。\nでも、その前に――"},
        { "location": "75/TALK"   , "narrator": "つばめ", "text": "何やってたか\n見せてほしいなー？"},
        { "location": "76/TALK"   , "narrator": "みやび", "text": "…………。"},
        { "location": "79/TALK"   , "narrator": "みやび", "text": "プライバシーに\n関わることやき――"},
        { "location": "80/TALK"   , "narrator": "つばめ", "text": "あれれー？\nお仕事じゃないん\nですかー？"},
        { "location": "83/TALK"   , "narrator": "みやび", "text": "…………。"},
        { "location": "84/SEL"    , "narrator": "（選択肢）", "text": "邪魔しちゃダメだよ"},
        { "location": "85/SEL"    , "narrator": "（選択肢）", "text": "つばめは仲間だし、見せてあげなよ"},
        { "location": "86/ACT"    , "narrator": "", "text": "邪魔しちゃダメだよ"},
        { "location": "88/TALK"   , "narrator": "つばめ", "text": "あ…そっか、\n$handle$さんも\nいたんだ？"},
        { "location": "90/TALK"   , "narrator": "つばめ", "text": "じゃあ、わたしは\n帰りますけど――"},
        { "location": "92/TALK"   , "narrator": "つばめ", "text": "あんまり危険な\nことは、やめた方が\nいいと思いますよ？"},
        { "location": "97/TALK"   , "narrator": "みやび", "text": "はぁ…、\nヤバかったぁ…。"},
        { "location": "98/TALK"   , "narrator": "みやび", "text": "うちだけやったら、\n今頃どんな目に\n合うてたことか…。"},
        { "location": "99/SEL"    , "narrator": "（選択肢）", "text": "一体、何をしてたの？"},
        { "location": "100/ACT"   , "narrator": "", "text": "一体、何をしてたの？"},
        { "location": "103/TALK"  , "narrator": "みやび", "text": "…助けてもらった\nことやし、コッソリ\n教えるけんど――"},
        { "location": "104/TALK"  , "narrator": "みやび", "text": "実はな、管理庁に\nハッキング仕掛けよう\n思うてたところや。"},
        { "location": "105/TALK"  , "narrator": "みやび", "text": "うちのメンバーは、\nどうにも信用ならん\n奴ばかりやきね。"},
        { "location": "106/TALK"  , "narrator": "みやび", "text": "今のつばめちゃん\nだってそうや。"},
        { "location": "107/TALK"  , "narrator": "みやび", "text": "ハッキングかけよう\n思うてた\nタイミングで――"},
        { "location": "108/TALK"  , "narrator": "みやび", "text": "狙ったように来るとか\nおかしいやろ？"},
        { "location": "109/SEL"   , "narrator": "（選択肢）", "text": "てか、さっきのつばめ怪し過ぎない？"},
        { "location": "110/ACT"   , "narrator": "", "text": "てか、さっきのつばめ怪し過ぎない？"},
        { "location": "112/TALK"  , "narrator": "みやび", "text": "ここでそれ言うか？\n当然やろ。"},
        { "location": "113/TALK"  , "narrator": "みやび", "text": "うちの思い込み\nフィルターが掛かっ\nちょるきね。"},
        { "location": "114/TALK"  , "narrator": "みやび", "text": "うちが最もスパイと\n思うちょるんが、\nつばめちゃんちや。"},
        { "location": "115/TALK"  , "narrator": "みやび", "text": "スパイと思われん\nように道化を演じ\nとるに違いない。"},
        { "location": "117/TALK"  , "narrator": "みやび", "text": "…もう監視されて\nないみたいやな。"},
        { "location": "119/TALK"  , "narrator": "みやび", "text": "よし、ハッキング\n再開するぞね。"},
        { "location": "120/SEL"   , "narrator": "（選択肢）", "text": "一人で調べるなんて、危険だよ"},
        { "location": "121/ACT"   , "narrator": "", "text": "一人で調べるなんて、危険だよ"},
        { "location": "124/TALK"  , "narrator": "みやび", "text": "逆や。\n一人の方が安全ぞね。"},
        { "location": "125/TALK"  , "narrator": "みやび", "text": "…どこに管理庁の\nスパイがおるか、\nわからんき――"},
        { "location": "126/TALK"  , "narrator": "みやび", "text": "下手に心を許せん。"},
        { "location": "127/TALK"  , "narrator": "みやび", "text": "つばめちゃん以外も、\nみんな何かしら謎を\n抱えちょるがよ。"},
        { "location": "128/TALK"  , "narrator": "みやび", "text": "誰も信用できん…。"},
        { "location": "129/SEL"   , "narrator": "（選択肢）", "text": "$me$なら信用して平気"},
        { "location": "130/ACT"   , "narrator": "", "text": "$me$なら信用して平気"},
        { "location": "132/TALK"  , "narrator": "みやび", "text": "…まあ、$handle$は\n他の子よりかは信用\nしちょるけんど――"},
        { "location": "133/TALK"  , "narrator": "みやび", "text": "実際にここにおる\nわけやないやろ？"},
        { "location": "134/TALK"  , "narrator": "みやび", "text": "ぶっちゃけ\n頼り甲斐ゼロちや。"},
        { "location": "135/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "136/TALK"  , "narrator": "みやび", "text": "まあ、うちの戦いは\n孤独ちゅうことや。"},
        { "location": "143/TALK"  , "narrator": "つばめ", "text": "全然孤独じゃない\nですよ、みやびさん！"},
        { "location": "146/TALK"  , "narrator": "みやび", "text": "どわあっ！\nまだおったんか！"},
        { "location": "147/TALK"  , "narrator": "つばめ", "text": "そりゃずっといましたよ。\nお話も聞いてましたし。"},
        { "location": "148/TALK"  , "narrator": "みやび", "text": "なっ！\nなんやって！？"},
        { "location": "149/TALK"  , "narrator": "つばめ", "text": "早速ですけど、\nちょっとパソコンの画面\n見せてくださいね！"},
        { "location": "150/ACT"   , "narrator": "", "text": "つばめは仲間だし、見せてあげなよ"},
        { "location": "153/TALK"  , "narrator": "みやび", "text": "余計なことを！！"},
        { "location": "155/TALK"  , "narrator": "つばめ", "text": "そうですよー。\n仲間なんですから\nいいじゃないですか。"},
        { "location": "159/TALK"  , "narrator": "みやび", "text": "あ、コラ！\n見たらいかん！"},
        { "location": "161/TALK"  , "narrator": "つばめ", "text": "えーっと…あれれぇ？"},
        { "location": "162/TALK"  , "narrator": "つばめ", "text": "みやびさーん。\nこれって何してる\n画面ですかぁ？"},
        { "location": "165/TALK"  , "narrator": "みやび", "text": "ち、ちくっと\nデータをまとめちょる\nだけぞね。"},
        { "location": "167/TALK"  , "narrator": "みやび", "text": "ちゅうか、こんな\nコマンドだらけの\n画面見ても――"},
        { "location": "168/TALK"  , "narrator": "みやび", "text": "つばめちゃんには\nわからんやろ？"},
        { "location": "169/TALK"  , "narrator": "つばめ", "text": "うーん…、\nそうですねー…。\nでもこれ――"},
        { "location": "170/TALK"  , "narrator": "つばめ", "text": "管理庁のサーバーに\nハッキングしようと\nしてますよねー？"},
        { "location": "171/TALK"  , "narrator": "みやび", "text": "なっ！？"},
        { "location": "173/TALK"  , "narrator": "つばめ", "text": "抜けてるなぁ…。\nわたしはスパイなん\nですよ？"},
        { "location": "174/TALK"  , "narrator": "つばめ", "text": "これくらいのこと、\nわかってるに\n決まってますよ。"},
        { "location": "175/TALK"  , "narrator": "みやび", "text": "っ！？"},
        { "location": "176/TALK"  , "narrator": "みやび", "text": "やっぱり…、\nつばめちゃんは\nスパイやったか…。"},
        { "location": "179/TALK"  , "narrator": "神楽", "text": "おっと。"},
        { "location": "180/TALK"  , "narrator": "神楽", "text": "はい、残念。\n逃がしませんよ。"},
        { "location": "182/TALK"  , "narrator": "みやび", "text": "なっ！？\n卯月、あんたもか！！"},
        { "location": "184/TALK"  , "narrator": "神楽", "text": "さあ、つばめさん。\nこそこそと嗅ぎまわる\nネズミを――"},
        { "location": "185/TALK"  , "narrator": "神楽", "text": "管理庁に\n連行しましょう。"},
        { "location": "187/TALK"  , "narrator": "つばめ", "text": "うん。\nそれじゃ、\nしゅっぱーつ！"},
        { "location": "190/TALK"  , "narrator": "みやび", "text": "い、嫌や！\n離せ、離せー！"},
        { "location": "203/DIALOG", "narrator": "", "text": "<color=black><size=50><b>みやびを拘束しようとする\nつばめ達を倒せ！</b></size></color>\n\n\n\n警戒するあまり、\n心の中では敏腕スパイと化した逢瀬つばめ。\n\nその妄想は、つばめや神楽に対する\nいらぬ警戒心を増幅させるばかりか\nみやびとつばめたちの関係も悪化させてしまう。\n\nトライナリーの平穏のためにも、\nこの虚像たちは倒しておこう。"}
    ]
}
