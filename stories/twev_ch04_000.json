{
    "dir": "chap00/daydra/twev_ch04_000.js",
    "type": "",
    "info": {
        "story_id": "31100",
        "cid": "",
        "title": "Twitter Archive 000",
        "sub_title": "卯月画廊：おためし（白黒イラスト）"
    },
    "entry":
    [
        { "location": "25/TALK"   , "narrator": "透明みやび", "text": "…………。"},
        { "location": "26/TALK"   , "narrator": "透明つばめ", "text": "あ、あの…どうして\n胸を揉んでるんですか？"},
        { "location": "27/TALK"   , "narrator": "透明みやび", "text": "うん…つばめちゃんは\n知っちょるか？"},
        { "location": "28/TALK"   , "narrator": "透明みやび", "text": "ここ３０年で雌象の\n９８％近くが牙を持たず\n生まれるようになった。"},
        { "location": "29/TALK"   , "narrator": "透明みやび", "text": "その原因が、過酷な密漁\nから種を守るための\n進化らしいことを…。"},
        { "location": "30/TALK"   , "narrator": "透明つばめ", "text": "ごめんなさい。\nそれと胸に何の関係が\nあるんですか？"},
        { "location": "31/TALK"   , "narrator": "透明みやび", "text": "牙を持たぬうちの胸は、\nどうなのだろうか？"},
        { "location": "32/TALK"   , "narrator": "透明みやび", "text": "進化論的に見た場合、\n胸の大きさはどちらへ\n向かってしまうのか。"},
        { "location": "33/TALK"   , "narrator": "透明みやび", "text": "その謎が頭の中で\nグルグルしちゅうがよ。"},
        { "location": "35/TALK"   , "narrator": "透明つばめ", "text": "え、えっと…。\nそうだ！"},
        { "location": "36/TALK"   , "narrator": "透明つばめ", "text": "$handle$さんなら、\n答えてくれるかも\nしれませんよ？"},
        { "location": "37/TALK"   , "narrator": "透明みやび", "text": "…そうやろか？\nまあ、面白そうやき、\n聞いてみるけんど…。"},
        { "location": "39/TALK"   , "narrator": "みやび", "text": "進化論的に見た場合"},
        { "location": "40/TALK"   , "narrator": "みやび", "text": "胸の大きさはどちらへ向かうのだろうか？"},
        { "location": "41/SEL"    , "narrator": "（選択肢）", "text": "わからないよ！"},
        { "location": "42/SEL"    , "narrator": "（選択肢）", "text": "大きい方"},
        { "location": "43/SEL"    , "narrator": "（選択肢）", "text": "小さい方"},
        { "location": "44/ACT"    , "narrator": "", "text": "わからないよ！"},
        { "location": "45/TALK"   , "narrator": "みやび", "text": "簡単に諦めるとは情けない"},
        { "location": "46/ACT"    , "narrator": "", "text": "大きい方"},
        { "location": "47/TALK"   , "narrator": "みやび", "text": "なるほど"},
        { "location": "48/TALK"   , "narrator": "みやび", "text": "これが世に言う「おま中」というやつか"},
        { "location": "49/ACT"    , "narrator": "", "text": "小さい方"},
        { "location": "50/TALK"   , "narrator": "みやび", "text": "ふむ"},
        { "location": "51/TALK"   , "narrator": "みやび", "text": "うちとしては生存の危機とも言える状態"},
        { "location": "52/TALK"   , "narrator": "みやび", "text": "まもって！$handle$！"},
        { "location": "54/TALK"   , "narrator": "みやび", "text": "まあ"},
        { "location": "55/TALK"   , "narrator": "みやび", "text": "巨乳に需要があれば巨乳が増え"},
        { "location": "56/TALK"   , "narrator": "みやび", "text": "貧乳に需要があれば貧乳が増える"},
        { "location": "57/TALK"   , "narrator": "みやび", "text": "ということなのだろう"},
        { "location": "58/TALK"   , "narrator": "みやび", "text": "うちはそう思うのだが"},
        { "location": "59/SEL"    , "narrator": "（選択肢）", "text": "大きい方が需要あるんじゃない？"},
        { "location": "60/SEL"    , "narrator": "（選択肢）", "text": "小さい方が需要あるでしょ"},
        { "location": "61/ACT"    , "narrator": "", "text": "大きい方が需要あるんじゃない？"},
        { "location": "62/TALK"   , "narrator": "みやび", "text": "牙があれば"},
        { "location": "63/TALK"   , "narrator": "みやび", "text": "うちは密漁されていた"},
        { "location": "64/TALK"   , "narrator": "みやび", "text": "牙がないことを感謝"},
        { "location": "65/TALK"   , "narrator": "みやび", "text": "大きくて重いことに"},
        { "location": "66/TALK"   , "narrator": "みやび", "text": "恨み"},
        { "location": "67/ACT"    , "narrator": "", "text": "小さいのに決まってる"},
        { "location": "68/TALK"   , "narrator": "みやび", "text": "それは素晴らしい"},
        { "location": "70/TALK"   , "narrator": "みやび", "text": "需要無き巨乳は"},
        { "location": "71/TALK"   , "narrator": "みやび", "text": "いずれ地上から"},
        { "location": "72/TALK"   , "narrator": "みやび", "text": "排斥されることになるだろう"},
        { "location": "73/TALK"   , "narrator": "みやび", "text": "まあ"},
        { "location": "74/TALK"   , "narrator": "みやび", "text": "うちの胸の大きさが"},
        { "location": "75/TALK"   , "narrator": "みやび", "text": "変わることはないのだが"},
        { "location": "77/TALK"   , "narrator": "みやび", "text": "とりあえず"},
        { "location": "78/TALK"   , "narrator": "みやび", "text": "そろそろ揉むのはやめよう"},
        { "location": "79/TALK"   , "narrator": "みやび", "text": "チラ見されて気分悪い"},
        { "location": "82/SEL"    , "narrator": "（選択肢）", "text": "そりゃ見られるよ"},
        { "location": "83/SEL"    , "narrator": "（選択肢）", "text": "男の人に見せないでね"},
        { "location": "84/ACT"    , "narrator": "", "text": "そりゃ見られるよ"},
        { "location": "85/TALK"   , "narrator": "みやび", "text": "そんなに珍しいか？"},
        { "location": "86/TALK"   , "narrator": "みやび", "text": "胸なんぞ"},
        { "location": "87/TALK"   , "narrator": "みやび", "text": "誰しも持ってるだろうに"},
        { "location": "88/TALK"   , "narrator": "みやび", "text": "相棒にもあるだろう？"},
        { "location": "89/ACT"    , "narrator": "", "text": "男の人に見せないでね"},
        { "location": "90/TALK"   , "narrator": "みやび", "text": "嫉妬か？"},
        { "location": "91/TALK"   , "narrator": "みやび", "text": "独占欲か？"},
        { "location": "92/TALK"   , "narrator": "みやび", "text": "まあ"},
        { "location": "93/TALK"   , "narrator": "みやび", "text": "相棒が嫌というなら"},
        { "location": "94/TALK"   , "narrator": "みやび", "text": "外でするのはやめよう"},
        { "location": "98/TALK"   , "narrator": "みやび", "text": "しかし"},
        { "location": "99/TALK"   , "narrator": "みやび", "text": "何故進化論の話が"},
        { "location": "100/TALK"  , "narrator": "みやび", "text": "胸になったのだろう？"},
        { "location": "101/TALK"  , "narrator": "みやび", "text": "うちの思考回路は"},
        { "location": "102/TALK"  , "narrator": "みやび", "text": "謎に包まれている"},
        { "location": "103/SEL"   , "narrator": "（選択肢）", "text": "話に付き合うの大変だよ"},
        { "location": "104/SEL"   , "narrator": "（選択肢）", "text": "そこがみやびの楽しいところ"},
        { "location": "105/ACT"   , "narrator": "", "text": "話に付き合うの大変だよ"},
        { "location": "106/TALK"  , "narrator": "みやび", "text": "それは"},
        { "location": "108/TALK"  , "narrator": "みやび", "text": "申し訳ないことをした"},
        { "location": "109/TALK"  , "narrator": "みやび", "text": "じゃあ今日は"},
        { "location": "110/TALK"  , "narrator": "みやび", "text": "もうやめておこう"},
        { "location": "111/ACT"   , "narrator": "", "text": "そこがみやびの楽しいところ"},
        { "location": "112/TALK"  , "narrator": "みやび", "text": "それはありがたい"},
        { "location": "113/TALK"  , "narrator": "みやび", "text": "気兼ねなく"},
        { "location": "114/TALK"  , "narrator": "みやび", "text": "突拍子のないことを"},
        { "location": "115/TALK"  , "narrator": "みやび", "text": "突然言う許可ゲット"},
        { "location": "116/TALK"  , "narrator": "みやび", "text": "前言撤回は受け付けん"},
        { "location": "118/TALK"  , "narrator": "みやび", "text": "ではまた"},
        { "location": "120/TALK"  , "narrator": "みやび", "text": "新たな謎が見つかる日に"},
        { "location": "121/TALK"  , "narrator": "みやび", "text": "もしくは"},
        { "location": "122/TALK"  , "narrator": "みやび", "text": "暇な時に"},
        { "location": "128/DIALOG", "narrator": "", "text": "このシナリオの元になっている\nTwitterの会話ログを見ますか？"}
    ]
}
