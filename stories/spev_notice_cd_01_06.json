{
    "dir": "chap00/daydra/spev_notice_cd_01_06.js",
    "type": "",
    "info": {
        "story_id": "91056",
        "cid": "",
        "title": "006 アフターストーリー",
        "sub_title": "恋ヶ崎みやびの思い出"
    },
    "entry":
    [
        { "location": "1508/DIALOG", "narrator": "", "text": "<color=green>某月某日　4:43 PM</color>\nとある平日の放課後、神楽坂トライナリーホワイエにて。"},
        { "location": "1509/TALK"  , "narrator": "真幌", "text": "…美味い。"},
        { "location": "1512/TALK"  , "narrator": "アーヤ", "text": "美味しいわ、みやび。\nまるでお店で飲む\nコーヒーみたい！"},
        { "location": "1514/TALK"  , "narrator": "みやび", "text": "そりゃ、店で出すための\nコーヒーやきね。"},
        { "location": "1515/TALK"  , "narrator": "みやび", "text": "ある程度美味くないと\nクレームの原因になるき。"},
        { "location": "1516/TALK"  , "narrator": "真幌", "text": "しかし、今まで本格的な\nコーヒーを煎れたことは\nないんだろう？"},
        { "location": "1517/TALK"  , "narrator": "みやび", "text": "まほさんの入れてくれた\nコーヒーメーカーの\nおかげです。"},
        { "location": "1518/TALK"  , "narrator": "みやび", "text": "スイッチ一つで\nほぼほぼ完成やき。"},
        { "location": "1519/TALK"  , "narrator": "真幌", "text": "…まあ、コーヒーだけに\n限ればそうかもしれんな。"},
        { "location": "1522/TALK"  , "narrator": "真幌", "text": "だが…このラテアートに\n関しては違うだろ？"},
        { "location": "1525/TALK"  , "narrator": "アーヤ", "text": "ビックリするくらい\n上手いんだけど…、\nいつ練習したの？"},
        { "location": "1526/TALK"  , "narrator": "みやび", "text": "マシンが届いた日やね。\nこれくらいのウリは\n必要や思うてな。"},
        { "location": "1529/TALK"  , "narrator": "真幌", "text": "おい、アーヤ。\nラテアートに関しては\n詳しくないんだが…。"},
        { "location": "1530/TALK"  , "narrator": "真幌", "text": "そんなちょっとの練習で\nどうにかなるモノなのか？"},
        { "location": "1533/TALK"  , "narrator": "アーヤ", "text": "無理だと思います。\n私も練習したこと\nあるんですけど…。"},
        { "location": "1535/TALK"  , "narrator": "アーヤ", "text": "全然思い通りの絵に\nなりませんでした。"},
        { "location": "1536/TALK"  , "narrator": "みやび", "text": "コツがいるきね。\nそれを掴まんことには\n無理ゲーやろ。"},
        { "location": "1538/TALK"  , "narrator": "真幌", "text": "元々、手の込んだ\n和食を作ったりも\nしていたからな。"},
        { "location": "1539/TALK"  , "narrator": "真幌", "text": "手が器用なのもそうだが、\nセンスもあったのかも\nしれんな。"},
        { "location": "1541/TALK"  , "narrator": "みやび", "text": "けんど、ラテアートは\n一日十杯が限界ちや。"},
        { "location": "1542/TALK"  , "narrator": "アーヤ", "text": "やっぱり、大変よね？"},
        { "location": "1543/TALK"  , "narrator": "みやび", "text": "それもあるけんど、\nぶっちゃけ思うてたより\n何倍もめんどいちや。"},
        { "location": "1545/TALK"  , "narrator": "アーヤ", "text": "あのね…。"},
        { "location": "1547/TALK"  , "narrator": "真幌", "text": "とりあえずコーヒーに\nついての心配はなさそう\nだな。"},
        { "location": "1549/TALK"  , "narrator": "アーヤ", "text": "そうですね。"},
        { "location": "1551/TALK"  , "narrator": "アーヤ", "text": "じゃあ、次は紅茶を\nお願いできる？\nミルクティーがいいわ。"},
        { "location": "1553/TALK"  , "narrator": "みやび", "text": "あいあい。\nまほさんは？"},
        { "location": "1554/TALK"  , "narrator": "真幌", "text": "いや、私はいい。\n片付けねばならない\n仕事があるんでな。"},
        { "location": "1555/TALK"  , "narrator": "真幌", "text": "続きは二人で\nやっててくれ。"},
        { "location": "1567/TALK"  , "narrator": "みやび", "text": "…ほれ、アーヤ。\nミルクティー。"},
        { "location": "1568/TALK"  , "narrator": "アーヤ", "text": "ありがとう…。\nちょうど良かったわ。"},
        { "location": "1569/TALK"  , "narrator": "みやび", "text": "？　なにがや？"},
        { "location": "1570/TALK"  , "narrator": "アーヤ", "text": "二人きりになれて…。\n大切な話があるの。"},
        { "location": "1571/TALK"  , "narrator": "みやび", "text": "…まあ、なんとなく\n聞かんでもわかる\nけんど…。"},
        { "location": "1572/TALK"  , "narrator": "みやび", "text": "卯月のことやね？"},
        { "location": "1573/TALK"  , "narrator": "アーヤ", "text": "ええ…みやびから見て、\n今の卯月はどう見える？"},
        { "location": "1575/TALK"  , "narrator": "みやび", "text": "うちらの仕切り役、\nちゃんとこなしちゅうと\n思うがよ。"},
        { "location": "1576/TALK"  , "narrator": "アーヤ", "text": "意見が合うわね。\n私も凄く頑張ってるって\n思ってたわ。"},
        { "location": "1577/TALK"  , "narrator": "みやび", "text": "…色々あったき、\n簡単に元通りになるとは\n思わんけんど…。"},
        { "location": "1578/TALK"  , "narrator": "みやび", "text": "アーヤが無理矢理仕切り役\n任せて、関わらんといかん\nようにしてくれたき。"},
        { "location": "1579/TALK"  , "narrator": "みやび", "text": "好調な感じに進んどると\n思うがよ。"},
        { "location": "1580/TALK"  , "narrator": "アーヤ", "text": "ふふっ…みやびだって、\nそうじゃない。"},
        { "location": "1581/TALK"  , "narrator": "みやび", "text": "…先輩である前に、\n卯月の仲間やきね。"},
        { "location": "1582/TALK"  , "narrator": "みやび", "text": "今年の夏……。\n卯月がうちらの前から\n去っていった。"},
        { "location": "1583/TALK"  , "narrator": "みやび", "text": "あの時うちは思ったんよ。\nもっと卯月にできることが\nあったんやないかって。"},
        { "location": "1584/TALK"  , "narrator": "みやび", "text": "やき、戻ってきた今――"},
        { "location": "1585/TALK"  , "narrator": "みやび", "text": "前よりもっと仲良くなれる\nように、迎え入れたいと\n思うてるちや。"},
        { "location": "1586/TALK"  , "narrator": "アーヤ", "text": "…できると思う？\n卯月の方から距離を\n開けるかもしれないのに。"},
        { "location": "1587/TALK"  , "narrator": "みやび", "text": "そんなん、簡単やき。"},
        { "location": "1588/TALK"  , "narrator": "みやび", "text": "何度でも、\n無理矢理にでも\n引っ張り出すがよ。"},
        { "location": "1590/TALK"  , "narrator": "みやび", "text": "そんで、関わらんと\nいかんような状況に\n持って行くぞね。"},
        { "location": "1591/TALK"  , "narrator": "アーヤ", "text": "ふふっ…やっぱり、\n強引に行くしかないわね。"},
        { "location": "1592/TALK"  , "narrator": "みやび", "text": "多少強引でも、ちゃんと\nコミュニケーション\nとらんとね。"},
        { "location": "1593/TALK"  , "narrator": "みやび", "text": "ドンドン距離が開きゆう。"},
        { "location": "1594/TALK"  , "narrator": "みやび", "text": "ところで…アーヤ、\n紅茶冷めゆうよ？"},
        { "location": "1596/TALK"  , "narrator": "アーヤ", "text": "え？　あっ！\n忘れてた！"},
        { "location": "1609/TALK"  , "narrator": "みやび", "text": "う～ん…。"},
        { "location": "1613/TALK"  , "narrator": "ガブリエラ", "text": "…あら？\nみやび、こんな時間まで\n練習してるの？"},
        { "location": "1615/TALK"  , "narrator": "みやび", "text": "ん？　うわっ、マジか。\nいつの間にか真っ暗や！"},
        { "location": "1616/TALK"  , "narrator": "ガブリエラ", "text": "随分集中してたみたいね。\nそんなに楽しいの？"},
        { "location": "1618/TALK"  , "narrator": "みやび", "text": "ん～、楽しいとは\nちくっと違うような…。"},
        { "location": "1619/TALK"  , "narrator": "ガブリエラ", "text": "面倒くさがりなくせに、\n変なとこ凝り性だものね、\nみやびって…。"},
        { "location": "1620/TALK"  , "narrator": "ガブリエラ", "text": "ま、せっかくだし\nあたしにもなにか\n一杯煎れてもらえる？"},
        { "location": "1622/TALK"  , "narrator": "みやび", "text": "お客さん、もう閉店ぞね。"},
        { "location": "1623/TALK"  , "narrator": "ガブリエラ", "text": "ラテアートできるって\nアーヤから聞いたわ。"},
        { "location": "1625/TALK"  , "narrator": "ガブリエラ", "text": "絵柄はウサギでお願い。\nあと、うんと甘くしてね。"},
        { "location": "1626/TALK"  , "narrator": "みやび", "text": "人の話を聞かん\nお客さんやなぁ…。"},
        { "location": "1635/TALK"  , "narrator": "ガブリエラ", "text": "美味しかったぁ。\nみやび、ごちそうさま。"},
        { "location": "1637/TALK"  , "narrator": "みやび", "text": "おそまつさまぞね。"},
        { "location": "1638/TALK"  , "narrator": "ガブリエラ", "text": "飲み物担当を\nみやびがやったのは\n正解だったわね。"},
        { "location": "1639/TALK"  , "narrator": "みやび", "text": "そう言うてもらえると、\nうちも安心するぞね。"},
        { "location": "1640/TALK"  , "narrator": "ガブリエラ", "text": "さてと、それじゃあ\nそろそろ――"},
        { "location": "1641/TALK"  , "narrator": "ガブリエラ", "text": "あっ、そうだ。\nみやびってまだ食器\n決めてないでしょ？"},
        { "location": "1642/TALK"  , "narrator": "ガブリエラ", "text": "そろそろ決めないと、\n勝手に決められちゃう\nわよ？"},
        { "location": "1643/TALK"  , "narrator": "みやび", "text": "うちはそれでえいよ。\nもしくは、みんなの\n残りもんとかでな。"},
        { "location": "1644/TALK"  , "narrator": "ガブリエラ", "text": "そんなの勿体ないわ。\nせっかく自分の作った\nロゴが入る食器なのに。"},
        { "location": "1645/TALK"  , "narrator": "ガブリエラ", "text": "特別な一枚にしたいと\n思わないわけ？"},
        { "location": "1646/TALK"  , "narrator": "みやび", "text": "…特別な一枚、か。"},
        { "location": "1648/TALK"  , "narrator": "みやび", "text": "ふーむ…そうやなぁ…。"},
        { "location": "1649/TALK"  , "narrator": "みやび", "text": "…なら、\nうちは小鉢にするぞね。"},
        { "location": "1650/TALK"  , "narrator": "ガブリエラ", "text": "え？\nそんな脇役みたいなので\nいいの！？"},
        { "location": "1651/TALK"  , "narrator": "ガブリエラ", "text": "もっと大皿とか\nスープボウルとか\n色々あると思うのに。"},
        { "location": "1652/TALK"  , "narrator": "みやび", "text": "小鉢は和食に於いては\n重要なものやよ？"},
        { "location": "1653/TALK"  , "narrator": "みやび", "text": "懐石でも一番最初に\n目に入る器やき、\nその店の品性が問われる。"},
        { "location": "1654/TALK"  , "narrator": "みやび", "text": "アーヤも今回は、和風の\nアペタイザーを頑張って\n考えちゅうみたいやき――"},
        { "location": "1655/TALK"  , "narrator": "みやび", "text": "殆どのお客人に\n出されるものに\nなると思うちや。"},
        { "location": "1656/TALK"  , "narrator": "ガブリエラ", "text": "なるほどね。みやびに\nとって思い入れあるなら、\nいいんじゃないかしら。"},
        { "location": "1657/TALK"  , "narrator": "ガブリエラ", "text": "それじゃ、あたしは\n先に帰るわね。"},
        { "location": "1658/TALK"  , "narrator": "みやび", "text": "ん、おつかれー。"},
        { "location": "1661/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "1662/TALK"  , "narrator": "みやび", "text": "ふぅ…片付けるの、\n手伝うてもらえば\nよかったやろか…？"},
        { "location": "1663/SEL"   , "narrator": "（選択肢）", "text": "小鉢にした理由、本気？"},
        { "location": "1664/ACT"   , "narrator": "", "text": "小鉢にした理由、本気？"},
        { "location": "1681/TALK"  , "narrator": "みやび", "text": "本気と思うたか？"},
        { "location": "1682/TALK"  , "narrator": "みやび", "text": "もち冗談"},
        { "location": "1683/TALK"  , "narrator": "みやび", "text": "当然である"},
        { "location": "1684/TALK"  , "narrator": "みやび", "text": "コレで満足か？"},
        { "location": "1687/SEL"   , "narrator": "みやび", "text": "本当の理由は？"},
        { "location": "1688/SEL"   , "narrator": "（選択肢）", "text": "うん、ありがとう"},
        { "location": "1689/ACT"   , "narrator": "", "text": "本当の理由は？"},
        { "location": "1690/TALK"  , "narrator": "みやび", "text": "乙女のトップシークレットである"},
        { "location": "1691/TALK"  , "narrator": "みやび", "text": "可愛く言うなら"},
        { "location": "1692/TALK"  , "narrator": "みやび", "text": "ナイショ"},
        { "location": "1693/TALK"  , "narrator": "みやび", "text": "ＯＫ？"},
        { "location": "1696/SEL"   , "narrator": "（選択肢）", "text": "教えてほしい"},
        { "location": "1697/SEL"   , "narrator": "（選択肢）", "text": "ＯＫ！"},
        { "location": "1698/ACT"   , "narrator": "", "text": "教えてほしい"},
        { "location": "1699/TALK"  , "narrator": "みやび", "text": "大胆なヤツめ"},
        { "location": "1700/TALK"  , "narrator": "みやび", "text": "よろしい"},
        { "location": "1701/TALK"  , "narrator": "みやび", "text": "ではしかと聞くがよい"},
        { "location": "1704/TALK"  , "narrator": "みやび", "text": "小鉢には"},
        { "location": "1705/TALK"  , "narrator": "みやび", "text": "思い出があるのだ"},
        { "location": "1706/TALK"  , "narrator": "みやび", "text": "以上！"},
        { "location": "1708/SEL"   , "narrator": "（選択肢）", "text": "思い出とは？"},
        { "location": "1709/SEL"   , "narrator": "（選択肢）", "text": "そうだったのか、ありがとう"},
        { "location": "1710/ACT"   , "narrator": "", "text": "思い出とは？"},
        { "location": "1712/TALK"  , "narrator": "みやび", "text": "随分と食いつくな？"},
        { "location": "1713/TALK"  , "narrator": "みやび", "text": "まあよい"},
        { "location": "1714/TALK"  , "narrator": "みやび", "text": "ずっと昔の話だが"},
        { "location": "1715/TALK"  , "narrator": "みやび", "text": "親戚からもらったのだ"},
        { "location": "1716/TALK"  , "narrator": "みやび", "text": "綺麗な小鉢を"},
        { "location": "1717/TALK"  , "narrator": "みやび", "text": "もちろん高級品"},
        { "location": "1718/TALK"  , "narrator": "みやび", "text": "うちのお気に入りだったが"},
        { "location": "1719/TALK"  , "narrator": "みやび", "text": "素敵すぎた"},
        { "location": "1720/TALK"  , "narrator": "みやび", "text": "その結果"},
        { "location": "1721/TALK"  , "narrator": "みやび", "text": "使わず行方不明となったわけなのだ"},
        { "location": "1724/TALK"  , "narrator": "みやび", "text": "そのことを思い出して"},
        { "location": "1725/TALK"  , "narrator": "みやび", "text": "小鉢にしようと思ったのだ"},
        { "location": "1726/TALK"  , "narrator": "みやび", "text": "理解したか？"},
        { "location": "1728/SEL"   , "narrator": "（選択肢）", "text": "可愛い思い出だね"},
        { "location": "1729/ACT"   , "narrator": "", "text": "可愛い思い出だね"},
        { "location": "1731/TALK"  , "narrator": "みやび", "text": "うっさい"},
        { "location": "1733/TALK"  , "narrator": "みやび", "text": "みんなには"},
        { "location": "1734/TALK"  , "narrator": "みやび", "text": "言うなよ？"},
        { "location": "1735/TALK"  , "narrator": "みやび", "text": "小っ恥ずかしくて堪らん"},
        { "location": "1737/SEL"   , "narrator": "（選択肢）", "text": "二人だけの秘密ね"},
        { "location": "1738/ACT"   , "narrator": "", "text": "二人だけの秘密ね"},
        { "location": "1740/TALK"  , "narrator": "みやび", "text": "その言い方も"},
        { "location": "1742/TALK"  , "narrator": "みやび", "text": "いや"},
        { "location": "1743/TALK"  , "narrator": "みやび", "text": "悪くない"},
        { "location": "1745/TALK"  , "narrator": "みやび", "text": "なんてな"},
        { "location": "1746/TALK"  , "narrator": "みやび", "text": "さらば！"},
        { "location": "1758/TALK"  , "narrator": "みやび", "text": "…けんどまあ、今回\n目指すんはモダン和やし、\n似ても似つかんけんどな。"},
        { "location": "1759/TALK"  , "narrator": "みやび", "text": "…まあ、\n大事なのは想いやきね。"},
        { "location": "1760/ACT"   , "narrator": "", "text": "そうだったのか、ありがとう"},
        { "location": "1763/ACT"   , "narrator": "", "text": "ＯＫ！"},
        { "location": "1766/ACT"   , "narrator": "", "text": "うん、ありがとう"},
        { "location": "1768/TALK"  , "narrator": "みやび", "text": "マジか"},
        { "location": "1769/TALK"  , "narrator": "みやび", "text": "もっと突っ込んでくるかと"},
        { "location": "1770/TALK"  , "narrator": "みやび", "text": "無駄に構えてしまった"},
        { "location": "1771/TALK"  , "narrator": "みやび", "text": "恥ずいではないか！"},
        { "location": "1772/TALK"  , "narrator": "みやび", "text": "さらば！"},
        { "location": "1783/TALK"  , "narrator": "みやび", "text": "…テンション下がる。"},
        { "location": "1784/TALK"  , "narrator": "みやび", "text": "中途半端に食いつくなら\n聞かんでほしいがよ。"}
    ]
}
