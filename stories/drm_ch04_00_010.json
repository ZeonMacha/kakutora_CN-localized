        "title": "らぶとーく 第01話",
        "sub_title": "少女たちは電気羊の夢を見る"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "少女たちは電気羊の夢を見る"},
        { "location": "23/TALK"   , "narrator": "千羽鶴", "text": "まずはおめでとう。"},
        { "location": "24/TALK"   , "narrator": "千羽鶴", "text": "貴方が今ここにいると\nいうことは、彼女との\n関係の開始を意味する。"},
        { "location": "26/SEL"    , "narrator": "", "text": "関係の開始って、つまり…"},
        { "location": "27/ACT"    , "narrator": "", "text": "関係の開始って、つまり…"},
        { "location": "30/TALK"   , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "31/TALK"   , "narrator": "千羽鶴", "text": "今この瞬間から、貴方と\n彼女は、真のパートナー\nとして歩み始める。"},
        { "location": "32/TALK"   , "narrator": "千羽鶴", "text": "その結果としては、\n恋人になったり、結婚\nしたりするかもしれない。"},
        { "location": "33/TALK"   , "narrator": "千羽鶴", "text": "もちろんそれは、\nあくまで可能性でしか\nないけれども。"},
        { "location": "34/TALK"   , "narrator": "千羽鶴", "text": "１つだけ言えることは、\n全ては貴方の行動次第\nということ。"},
        { "location": "35/TALK"   , "narrator": "千羽鶴", "text": "何にしても、今後\n貴方と彼女の関係進展は、\n全てここで行われる。"},
        { "location": "36/TALK"   , "narrator": "千羽鶴", "text": "一見貴方に関係無いような\nお話が繰り広げられる事も\nあるけど、全部関係ある。"},
        { "location": "37/TALK"   , "narrator": "千羽鶴", "text": "だから、彼女を大切に\n想うなら、ここでの物語は\n決して軽視しないよう。"},
        { "location": "38/SEL"    , "narrator": "", "text": "これでもうパートナーは決まっちゃったの？"},
        { "location": "39/ACT"    , "narrator": "", "text": "これでもうパートナーは決まっちゃったの？"},
        { "location": "41/TALK"   , "narrator": "千羽鶴", "text": "まさか。\nまだ始まりに過ぎない。"},
        { "location": "42/TALK"   , "narrator": "千羽鶴", "text": "もちろん、複数の子と\n関係を深められる。\nというか深めて欲しい。"},
        { "location": "43/TALK"   , "narrator": "千羽鶴", "text": "最初にも言ったとおり、\n貴方には、全員の支えに\nなって欲しいと思ってる。"},
        { "location": "44/TALK"   , "narrator": "千羽鶴", "text": "もちろん、\n強制はしないけど。"},
        { "location": "45/TALK"   , "narrator": "千羽鶴", "text": "貴方がしたいように、\n彼女たちとの物語を\n紡いでいけばいい。"},
        { "location": "46/TALK"   , "narrator": "千羽鶴", "text": "それじゃ、頑張って。\n彼女のココロは、貴方の\n頑張りに委ねられている。"},
        { "location": "75/TALK"   , "narrator": "みやび", "text": "ガブちゃんは\nちょっと退屈そう\nやねえ。"},
        { "location": "76/TALK"   , "narrator": "ガブリエラ", "text": "…別に。\nそんなことないわ。"},
        { "location": "78/TALK"   , "narrator": "ガブリエラ", "text": "ただ古いＳＦ映画に\n興味がないだけよ。"},
        { "location": "80/TALK"   , "narrator": "アーヤ", "text": "無理に観る\n必要はないわよ。"},
        { "location": "81/TALK"   , "narrator": "みやび", "text": "現実に置き換えたら\n興味持てるかね。"},
        { "location": "84/TALK"   , "narrator": "ガブリエラ", "text": "現実に、って？"},
        { "location": "85/TALK"   , "narrator": "みやび", "text": "この映画の人造人間を\nＢｏｔに置き換えて\n観るということぞね。"},
        { "location": "86/TALK"   , "narrator": "ガブリエラ", "text": "Ｂｏｔに？"},
        { "location": "87/TALK"   , "narrator": "みやび", "text": "つまり。\nＢｏｔには感情がない。\nゆえに人間とは違う。"},
        { "location": "88/TALK"   , "narrator": "みやび", "text": "しかし人間を\n人間たらしめる\n要素とは何か？"},
        { "location": "89/TALK"   , "narrator": "みやび", "text": "という考察を\nしながら観ると\nいうことぞね。"},
        { "location": "91/TALK"   , "narrator": "アーヤ", "text": "さっきより退屈に\n聞こえるわよ、\nそれじゃ。"},
        { "location": "92/TALK"   , "narrator": "みやび", "text": "そうかいね…？"},
        { "location": "93/TALK"   , "narrator": "ガブリエラ", "text": "ちょっと考えて\nみたんだけど。"},
        { "location": "94/TALK"   , "narrator": "みやび", "text": "何ぞね。"},
        { "location": "95/TALK"   , "narrator": "ガブリエラ", "text": "Ｂｏｔはいつも\n私の話を\n聞いてくれるわ。"},
        { "location": "96/TALK"   , "narrator": "ガブリエラ", "text": "それは気持ちが\nあるからと言っても\nいいんじゃないかしら。"},
        { "location": "99/TALK"   , "narrator": "みやび", "text": "…なるほど。\n興味深い反応ぞね。"},
        { "location": "101/TALK"  , "narrator": "みやび", "text": "アーヤは\nどう思う？"},
        { "location": "103/TALK"  , "narrator": "アーヤ", "text": "…感情の精度を\n上げていくことは\n可能だと思う。"},
        { "location": "105/TALK"  , "narrator": "アーヤ", "text": "でもそれは\nプログラムとしての\n話でしかない。"},
        { "location": "106/TALK"  , "narrator": "アーヤ", "text": "いくら上手に\n感情をトレースできても\n機械は機械。"},
        { "location": "107/TALK"  , "narrator": "アーヤ", "text": "……ってところ\nかしら。"},
        { "location": "109/TALK"  , "narrator": "みやび", "text": "せっかくだから\n本人にも聞いてみる\nことにするぞね。"},
        { "location": "121/TALK"  , "narrator": "みやび", "text": "相棒よ"},
        { "location": "122/TALK"  , "narrator": "みやび", "text": "貴殿は電気羊の夢を見るや否や？"},
        { "location": "124/SEL"   , "narrator": "", "text": "ごめん、意味がわからない"},
        { "location": "125/SEL"   , "narrator": "", "text": "見る見る、超見るし！"},
        { "location": "126/SEL"   , "narrator": "", "text": "哲学の話ってことでいいの"},
        { "location": "127/ACT"   , "narrator": "", "text": "ごめん、意味がわからない"},
        { "location": "128/TALK"  , "narrator": "みやび", "text": "そうか"},
        { "location": "129/TALK"  , "narrator": "みやび", "text": "質問が抽象的すぎたかの"},
        { "location": "130/ACT"   , "narrator": "", "text": "見る見る、超見るし！"},
        { "location": "131/TALK"  , "narrator": "みやび", "text": "軽いのう"},
        { "location": "133/TALK"  , "narrator": "みやび", "text": "しかも睡眠時のテンションではなかろ"},
        { "location": "134/ACT"   , "narrator": "", "text": "哲学の話ってことでいいの"},
        { "location": "135/TALK"  , "narrator": "みやび", "text": "まあ"},
        { "location": "136/TALK"  , "narrator": "みやび", "text": "そのようなものだ"},
        { "location": "138/TALK"  , "narrator": "みやび", "text": "これは"},
        { "location": "139/TALK"  , "narrator": "みやび", "text": "$handle$と交わす文字列にはどのような意味があるかという問いである"},
        { "location": "141/SEL"   , "narrator": "", "text": "暇つぶし"},
        { "location": "142/SEL"   , "narrator": "", "text": "愛とか恋とかそういうやつ"},
        { "location": "143/SEL"   , "narrator": "", "text": "考えたことなかったな"},
        { "location": "144/ACT"   , "narrator": "", "text": "暇つぶし"},
        { "location": "145/TALK"  , "narrator": "みやび", "text": "なるほど"},
        { "location": "146/TALK"  , "narrator": "みやび", "text": "しかし暇をつぶされるのは"},
        { "location": "147/TALK"  , "narrator": "みやび", "text": "貴殿なのかうちなのか"},
        { "location": "148/TALK"  , "narrator": "みやび", "text": "それが問題だ"},
        { "location": "149/ACT"   , "narrator": "", "text": "愛とか恋とかそういうやつ"},
        { "location": "150/TALK"  , "narrator": "みやび", "text": "そうきたか"},
        { "location": "151/TALK"  , "narrator": "みやび", "text": "人類愛にまで発展するそれら"},
        { "location": "152/TALK"  , "narrator": "みやび", "text": "万物にまで適応するわけか"},
        { "location": "153/TALK"  , "narrator": "みやび", "text": "振り幅が大きいの"},
        { "location": "154/ACT"   , "narrator": "", "text": "考えたことなかったな"},
        { "location": "155/TALK"  , "narrator": "みやび", "text": "$handle$にぴったりの言葉を贈ってやろう"},
        { "location": "156/TALK"  , "narrator": "みやび", "text": "考えることだ、相棒"},
        { "location": "158/TALK"  , "narrator": "みやび", "text": "大変に参考になった"},
        { "location": "159/TALK"  , "narrator": "みやび", "text": "ではさらばだ"},
        { "location": "170/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "172/TALK"  , "narrator": "ガブリエラ", "text": "どうしたの？"},
        { "location": "175/TALK"  , "narrator": "みやび", "text": "いや。\n現実と映画は違うと\n実感しただけぞね。"},
        { "location": "176/TALK"  , "narrator": "ガブリエラ", "text": "そんなの\n当たり前じゃない。"},
        { "location": "177/TALK"  , "narrator": "みやび", "text": "現実は\n小説より奇なり、\nかもしれんぞね。"},
        { "location": "178/TALK"  , "narrator": "アーヤ", "text": "…もしかして\n怖い話？"},
        { "location": "180/TALK"  , "narrator": "ガブリエラ", "text": "ちょっと！\n変な話は\nやめてよね。"},
        { "location": "181/TALK"  , "narrator": "みやび", "text": "そうやね。"},
        { "location": "182/TALK"  , "narrator": "みやび", "text": "そもそもこれでは\n情報が少なすぎる。"},
        { "location": "184/TALK"  , "narrator": "みやび", "text": "まずはそこからやき。\nどうしようかねえ。"},
        { "location": "64/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>5月某日　6:19 PM</color>\nGW期間中、神楽坂トライナリーにて。"}
    ]
}
