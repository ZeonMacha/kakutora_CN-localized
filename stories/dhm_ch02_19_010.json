    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "みんなでうた"},
        { "location": "34/TALK"   , "narrator": "アーヤ", "text": "もっと乙女な歌なんて"},
        { "location": "35/TALK"   , "narrator": "アーヤ", "text": "いくらでもあるし"},
        { "location": "36/TALK"   , "narrator": "アーヤ", "text": "どうってことないわ(￣Д￣ )"},
        { "location": "38/SEL"    , "narrator": "", "text": "メルティの歌のこと？"},
        { "location": "39/SEL"    , "narrator": "", "text": "乙女なアーヤかわいい"},
        { "location": "40/SEL"    , "narrator": "", "text": "オトナな歌も歌おうよ"},
        { "location": "41/ACT"    , "narrator": "", "text": "メルティの歌のこと？"},
        { "location": "42/TALK"   , "narrator": "アーヤ", "text": "そう"},
        { "location": "43/TALK"   , "narrator": "アーヤ", "text": "それのこと"},
        { "location": "44/ACT"    , "narrator": "", "text": "乙女なアーヤかわいい"},
        { "location": "45/TALK"   , "narrator": "アーヤ", "text": "もう"},
        { "location": "46/TALK"   , "narrator": "アーヤ", "text": "恥ずかしかったんだから"},
        { "location": "47/ACT"    , "narrator": "", "text": "オトナな歌も歌おうよ"},
        { "location": "48/TALK"   , "narrator": "アーヤ", "text": "そうね"},
        { "location": "49/TALK"   , "narrator": "アーヤ", "text": "そんな歌も歌いたいわ"},
        { "location": "51/TALK"   , "narrator": "アーヤ", "text": "歌ったおかげで"},
        { "location": "52/TALK"   , "narrator": "アーヤ", "text": "館長が色々ばらす前に"},
        { "location": "53/TALK"   , "narrator": "アーヤ", "text": "話が終わってよかったわ"},
        { "location": "54/TALK"   , "narrator": "アーヤ", "text": "アドバイスありがと"},
        { "location": "55/TALK"   , "narrator": "アーヤ", "text": "まあちょっと"},
        { "location": "56/TALK"   , "narrator": "アーヤ", "text": "恥ずかしかったけど、、、"},
        { "location": "58/SEL"    , "narrator": "", "text": "恥ずかしかった？　ごめん"},
        { "location": "59/SEL"    , "narrator": "", "text": "てか、よく歌詞覚えてたね？"},
        { "location": "60/SEL"    , "narrator": "", "text": "これで次からは安心だね"},
        { "location": "61/ACT"    , "narrator": "", "text": "恥ずかしかった？　ごめん"},
        { "location": "62/TALK"   , "narrator": "アーヤ", "text": "少しね"},
        { "location": "63/TALK"   , "narrator": "アーヤ", "text": "でも"},
        { "location": "64/TALK"   , "narrator": "アーヤ", "text": "みんなが驚いた顔してて"},
        { "location": "65/TALK"   , "narrator": "アーヤ", "text": "それが面白かったから"},
        { "location": "67/TALK"   , "narrator": "アーヤ", "text": "歌ってよかったわ(*^^*)"},
        { "location": "68/ACT"    , "narrator": "", "text": "てか、よく歌詞覚えてたね？"},
        { "location": "69/TALK"   , "narrator": "アーヤ", "text": "実はね"},
        { "location": "70/TALK"   , "narrator": "アーヤ", "text": "歌ったことあるのよ"},
        { "location": "71/TALK"   , "narrator": "アーヤ", "text": "人形劇で"},
        { "location": "72/TALK"   , "narrator": "アーヤ", "text": "アニメ観てる子が多いから"},
        { "location": "73/TALK"   , "narrator": "アーヤ", "text": "やっぱり反応も違うし"},
        { "location": "74/TALK"   , "narrator": "アーヤ", "text": "あ"},
        { "location": "75/TALK"   , "narrator": "アーヤ", "text": "でも(・・。)ゞ"},
        { "location": "76/TALK"   , "narrator": "アーヤ", "text": "このことは言わないでm(_ _)m"},
        { "location": "77/TALK"   , "narrator": "アーヤ", "text": "やっぱりちょっと"},
        { "location": "79/TALK"   , "narrator": "アーヤ", "text": "恥ずかしいから"},
        { "location": "80/ACT"    , "narrator": "", "text": "これで次からは安心だね"},
        { "location": "81/TALK"   , "narrator": "アーヤ", "text": "次って！？"},
        { "location": "83/TALK"   , "narrator": "アーヤ", "text": "また館長が蒸し返すってこと？"},
        { "location": "84/TALK"   , "narrator": "アーヤ", "text": "それはない"},
        { "location": "85/TALK"   , "narrator": "アーヤ", "text": "と"},
        { "location": "86/TALK"   , "narrator": "アーヤ", "text": "思いたい"},
        { "location": "87/TALK"   , "narrator": "アーヤ", "text": "それに二度目は歌っても"},
        { "location": "88/TALK"   , "narrator": "アーヤ", "text": "みんなの気はそらせないと思うのよ"},
        { "location": "89/TALK"   , "narrator": "アーヤ", "text": "だから別の手を考えなきゃ"},
        { "location": "90/TALK"   , "narrator": "アーヤ", "text": "そうなったらね"}
    ]
}
