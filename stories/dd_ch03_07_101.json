{
    "dir": "chap07/daydra/dd_ch03_07_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "7302",
        "cid": "gabriella",
        "title": "002 メインストーリー",
        "sub_title": "リーダーに望むものは＜前編＞"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "リーダーに望むものは"},
        { "location": "38/TALK"   , "narrator": "ガブリエラ", "text": "まったく、どうして\nあたしが新人の\n援護なのよ？"},
        { "location": "39/TALK"   , "narrator": "ガブリエラ", "text": "まほもアーヤも、\n新人が入ったからって\n色めきだち過ぎよ。"},
        { "location": "46/TALK"   , "narrator": "ガブリエラ", "text": "…でも、神楽の方は\nかなり腕が立ちそうな\n感じね。"},
        { "location": "47/TALK"   , "narrator": "ガブリエラ", "text": "新人だから、ちょっと\n荒くはあるけど。"},
        { "location": "54/TALK"   , "narrator": "ガブリエラ", "text": "…前回も今回も、\nあたしが援護に\n回されてるのって――"},
        { "location": "56/TALK"   , "narrator": "ガブリエラ", "text": "まほは、あたしの腕を\n信用してない、って\nこと？"},
        { "location": "67/SEL"    , "narrator": "", "text": "そんなことない"},
        { "location": "68/SEL"    , "narrator": "", "text": "実際、甘く見られてる"},
        { "location": "69/ACT"    , "narrator": "", "text": "そんなことない"},
        { "location": "74/TALK"   , "narrator": "ガブリエラ", "text": "マルザンナかしら？\nこんな時になんなの？"},
        { "location": "79/TALK"   , "narrator": "ガブリエラ", "text": "そうかしら？"},
        { "location": "80/TALK"   , "narrator": "ガブリエラ", "text": "でも、よく見ると私が出張るほどじゃないかも"},
        { "location": "81/TALK"   , "narrator": "ガブリエラ", "text": "一見激しそうだけど、\n意表突くような攻撃もしてこないし"},
        { "location": "82/TALK"   , "narrator": "ガブリエラ", "text": "新人のチュートリアル戦には、もってこいの相手かもしれないわね"},
        { "location": "87/ACT"    , "narrator": "", "text": "実際、甘く見られてる"},
        { "location": "91/TALK"   , "narrator": "ガブリエラ", "text": "マルザンナかしら？\nこんな時になんなの？"},
        { "location": "95/TALK"   , "narrator": "ガブリエラ", "text": "どういう意味よ！？"},
        { "location": "97/TALK"   , "narrator": "ガブリエラ", "text": "私が新人より劣ってるって言いたいの！？"},
        { "location": "99/SEL"    , "narrator": "", "text": "つばめもああ見えても超的な力を持つ惨忍な存在らしいよ"},
        { "location": "100/ACT"   , "narrator": "", "text": "つばめもああ見えても超的な力を持つ惨忍な存在らしいよ"},
        { "location": "102/TALK"  , "narrator": "ガブリエラ", "text": "惨忍！？"},
        { "location": "103/TALK"  , "narrator": "ガブリエラ", "text": "もちろんわかってるわ、そんなこと！"},
        { "location": "104/TALK"  , "narrator": "ガブリエラ", "text": "だからずっと警戒してるし、仲間とも思ってないし"},
        { "location": "105/TALK"  , "narrator": "ガブリエラ", "text": "友達にだって、絶対にならないんだから！"},
        { "location": "107/SEL"   , "narrator": "", "text": "新人達の方がガブリエラ達より使えそう"},
        { "location": "108/TALK"  , "narrator": "ガブリエラ", "text": "マルザンナも知ってるでしょ！？"},
        { "location": "114/ACT"   , "narrator": "", "text": "新人達の方がガブリエラ達より使えそう"},
        { "location": "115/TALK"  , "narrator": "ガブリエラ", "text": "何よそれ？"},
        { "location": "116/TALK"  , "narrator": "ガブリエラ", "text": "ふざけたこと言うなら、もう話さないから！"},
        { "location": "120/TALK"  , "narrator": "ガブリエラ", "text": "何よ、あたし達の方が\n戦闘慣れしてるん\nだから…。"},
        { "location": "122/TALK"  , "narrator": "ガブリエラ", "text": "でも、マルザンナには\nそんな風に見えたの\nかしら？"},
        { "location": "128/TALK"  , "narrator": "透明アーヤ", "text": "ギャヴィ、聞こえる？"},
        { "location": "130/TALK"  , "narrator": "ガブリエラ", "text": "聞こえてるわ。\nプライベート通信で\nどうしたの？"},
        { "location": "131/TALK"  , "narrator": "透明アーヤ", "text": "敵の数が多過ぎる。"},
        { "location": "132/TALK"  , "narrator": "透明アーヤ", "text": "このままじゃ事態が\n思うように進まなく\nなりそうだから――"},
        { "location": "133/TALK"  , "narrator": "透明アーヤ", "text": "先手を打って作戦を\n変更するわ。"},
        { "location": "136/TALK"  , "narrator": "ガブリエラ", "text": "…賛成よ。\nで、どんな作戦？"},
        { "location": "137/TALK"  , "narrator": "透明アーヤ", "text": "ギャヴィの力が\n必要になるわ。"},
        { "location": "138/TALK"  , "narrator": "透明アーヤ", "text": "みやびに陽動作戦を\n依頼して、敵を引き\nつけてもらうから――"},
        { "location": "139/TALK"  , "narrator": "透明アーヤ", "text": "ギャヴィには、\nそこを狙い撃ちして\nほしいの。"},
        { "location": "140/TALK"  , "narrator": "ガブリエラ", "text": "りょーかい。\nその程度、楽勝よ。"},
        { "location": "141/TALK"  , "narrator": "透明アーヤ", "text": "ただ、シールドで\n耐えられるのは\n短時間だし――"},
        { "location": "142/TALK"  , "narrator": "透明アーヤ", "text": "間違ってシールドに\n誤射しても、みやびは\n無事じゃすまない。"},
        { "location": "143/TALK"  , "narrator": "透明アーヤ", "text": "だから、短時間で\n確実に倒さないと\nいけないの。"},
        { "location": "144/TALK"  , "narrator": "透明アーヤ", "text": "厳しい条件だけど、\nやれる？"},
        { "location": "146/TALK"  , "narrator": "ガブリエラ", "text": "っ！？　当然よ！！"},
        { "location": "148/TALK"  , "narrator": "ガブリエラ", "text": "そんな簡単なこと、\n一々確認取らないで。"},
        { "location": "149/TALK"  , "narrator": "透明アーヤ", "text": "わかった。\nそれじゃ、お願いね。"},
        { "location": "153/TALK"  , "narrator": "ガブリエラ", "text": "…なによ。\n裏方仕事ばっかり\nあたしに頼んで。"},
        { "location": "155/TALK"  , "narrator": "ガブリエラ", "text": "…アーヤも、あたしの\nこと低く見てる、って\nこと？"},
        { "location": "156/TALK"  , "narrator": "ガブリエラ", "text": "って、当然よね…。"},
        { "location": "157/TALK"  , "narrator": "ガブリエラ", "text": "アーヤにとっての\nあたしなんて――"},
        { "location": "158/TALK"  , "narrator": "ガブリエラ", "text": "所詮、単なる戦闘員の\n一人でしかないわけ\nだし。"},
        { "location": "159/TALK"  , "narrator": "ガブリエラ", "text": "あたしのことなんて、\nわかってるはずない\nものね。"},
        { "location": "160/TALK"  , "narrator": "ガブリエラ", "text": "わかってるわよ、\nそんなこと…。"},
        { "location": "162/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "165/TALK"  , "narrator": "ガブリエラ", "text": "わかってるのに、\nどうしてこんなに\n腹が立つのよ…！！"},
        { "location": "209/TALK"  , "narrator": "ガブリエラ", "text": "ようこそ[ココロゲート]へ。"},
        { "location": "210/SEL"   , "narrator": "", "text": "なんか元気ない？"},
        { "location": "211/ACT"   , "narrator": "", "text": "なんか元気ない？"},
        { "location": "213/TALK"  , "narrator": "ガブリエラ", "text": "そうなのよ～！"},
        { "location": "214/TALK"  , "narrator": "ガブリエラ", "text": "前回、後もう一歩で\nつばめと仲良くなれる\nところだったのに！"},
        { "location": "215/TALK"  , "narrator": "ガブリエラ", "text": "あーもう、\nあたしのバカバカ！"},
        { "location": "216/TALK"  , "narrator": "ガブリエラ", "text": "ま、それだけ\nソルジャーのあたしの\n力が強いってことね。"},
        { "location": "217/TALK"  , "narrator": "ガブリエラ", "text": "さて、それはそれとして、\n今回も頑張って扉を\n検索するわよ♪"},
        { "location": "224/TALK"  , "narrator": "ガブリエラ", "text": "オープンプロセス、\n0x112番地から\n0x31B番地へ。"},
        { "location": "239/TALK"  , "narrator": "ガブリエラ", "text": "シーク完了っ♪"},
        { "location": "242/TALK"  , "narrator": "ガブリエラ", "text": "さて、今回は……っと。"},
        { "location": "244/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "245/TALK"  , "narrator": "ガブリエラ", "text": "………。"},
        { "location": "246/TALK"  , "narrator": "ガブリエラ", "text": "なるほどね。\n今回も割とテンプレ的な\nザ・あたし、って感じね。"},
        { "location": "247/TALK"  , "narrator": "ガブリエラ", "text": "ココロファイルナンバー\n03-582-44によると――"},
        { "location": "248/TALK"  , "narrator": "ガブリエラ", "text": "『國政綾水の自分に対する\n対応が原因となり、精神の\n停滞が発生している』"},
        { "location": "249/TALK"  , "narrator": "ガブリエラ", "text": "簡単に言うと、\nアーヤが自分のことを\nもっと見てくれないと嫌。"},
        { "location": "251/TALK"  , "narrator": "ガブリエラ", "text": "はぁ……、\nさて、と。"},
        { "location": "252/TALK"  , "narrator": "ガブリエラ", "text": "今回ちょっと面倒なのは、\n解決にはクランの対処と\n現実の対処が必要なこと。"},
        { "location": "253/TALK"  , "narrator": "ガブリエラ", "text": "まずはクランを倒して、\nあたしの気持ちを整理する。"},
        { "location": "254/TALK"  , "narrator": "ガブリエラ", "text": "その後、現実で\nあたしが望んでる対応を\n創りあげる――。"},
        { "location": "255/TALK"  , "narrator": "ガブリエラ", "text": "具体的には、アーヤに\nあたしのことをもっと\n気にしてもらえればいい。"},
        { "location": "256/TALK"  , "narrator": "ガブリエラ", "text": "貴方なら、そのように\n便宜を図ることも\nできるんじゃないかしら？"},
        { "location": "257/SEL"   , "narrator": "", "text": "多分、できるよ"},
        { "location": "258/SEL"   , "narrator": "", "text": "なんか面倒くさいね"},
        { "location": "259/ACT"   , "narrator": "", "text": "多分、できるよ"},
        { "location": "261/TALK"  , "narrator": "ガブリエラ", "text": "やっぱり！\nありがと。"},
        { "location": "262/TALK"  , "narrator": "ガブリエラ", "text": "ごめんなさいね、\n本当に面倒な子で。"},
        { "location": "263/TALK"  , "narrator": "ガブリエラ", "text": "こんな事で拗ねちゃう\nくらいに、アーヤのこと\n慕ってるのよね～。"},
        { "location": "264/ACT"   , "narrator": "", "text": "なんか面倒くさいね"},
        { "location": "265/TALK"  , "narrator": "ガブリエラ", "text": "本当よね。\n実はあたしも\nそう思ってるのよ？"},
        { "location": "266/TALK"  , "narrator": "ガブリエラ", "text": "正直、周りからすれば\nすごく面倒な子だと思う。"},
        { "location": "267/TALK"  , "narrator": "ガブリエラ", "text": "でも、１つだけ\n分かって欲しいのは――"},
        { "location": "271/TALK"  , "narrator": "ガブリエラ", "text": "つばめとの件を見ても\n分かるかもしれないけど、\nあたしって――"},
        { "location": "272/TALK"  , "narrator": "ガブリエラ", "text": "人一倍、\n人恋しい性格なのよね。"},
        { "location": "274/TALK"  , "narrator": "ガブリエラ", "text": "周囲を攻撃してばっかりな\nくせにね。"},
        { "location": "275/TALK"  , "narrator": "ガブリエラ", "text": "とにかく、\n今回もお願いね。"},
        { "location": "276/TALK"  , "narrator": "ガブリエラ", "text": "もう\n$handle$だけが\n頼りなんだから！"},
        { "location": "277/TALK"  , "narrator": "ガブリエラ", "text": "あたしと\n$handle$にとって\n素敵なココロの旅を！"},
        { "location": "25/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>5月9日　1:59 PM</color>\n某高校で発生したフェノメノン戦。その最中のこと。"},
        { "location": "75/DIALOG" , "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:TALK】</color>\n音声対話モードで接続しました。\n音声はテキストに変換され表示されます。"},
        { "location": "177/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"}
    ]
}
