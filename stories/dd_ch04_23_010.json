{
    "dir": "chap23/daydra/dd_ch04_23_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "23452",
        "cid": "miyabi",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "本気かお世辞かそれとも…"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "本気かお世辞かそれとも…"},
        { "location": "18/TALK"   , "narrator": "神楽", "text": "…………。"},
        { "location": "24/TALK"   , "narrator": "みやび", "text": "…ん？　卯月か。\nこんなとこで\n何やっちゅうが？"},
        { "location": "26/TALK"   , "narrator": "神楽", "text": "あ、えっと…。"},
        { "location": "28/TALK"   , "narrator": "神楽", "text": "あはは…ちょっと、\nボーッとしちゃって\nました。"},
        { "location": "29/TALK"   , "narrator": "みやび", "text": "退屈やろ？\n田舎やし、うちにも\n何の娯楽も無いき。"},
        { "location": "30/TALK"   , "narrator": "神楽", "text": "いえ、そんなこと\nないです。"},
        { "location": "31/TALK"   , "narrator": "神楽", "text": "私、みやびさんのお家、\nとっても気に入ってます。"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "まっこと？"},
        { "location": "33/TALK"   , "narrator": "神楽", "text": "はい…こうしてると、\n何だか落ち着いた気持ちに\nなれるんです。"},
        { "location": "34/TALK"   , "narrator": "みやび", "text": "落ち着いた気持ちなぁ…。\nうちにはわからんな。"},
        { "location": "36/TALK"   , "narrator": "神楽", "text": "ふふっ…。"},
        { "location": "37/TALK"   , "narrator": "神楽", "text": "…でも、もう少ししたら\n東京に帰らないと\nいけないんですよね…。"},
        { "location": "38/TALK"   , "narrator": "神楽", "text": "それを考えると、\nちょっと寂しいです…。"},
        { "location": "39/TALK"   , "narrator": "みやび", "text": "ふむ…。"},
        { "location": "40/TALK"   , "narrator": "みやび", "text": "なら、また遊びにくれば\nえいやろ。"},
        { "location": "41/TALK"   , "narrator": "神楽", "text": "え？"},
        { "location": "42/TALK"   , "narrator": "みやび", "text": "知っちょるやろ？\nうちが頻繁に実家に\n帰っちょるの。"},
        { "location": "43/TALK"   , "narrator": "みやび", "text": "卯月の予定が合えば、\nその時について来れば\nえいやん。"},
        { "location": "44/TALK"   , "narrator": "神楽", "text": "いいんですか？\nみやびさんのご迷惑に\nなるんじゃ…。"},
        { "location": "45/TALK"   , "narrator": "みやび", "text": "うちは自室で不可思議\n触っちょるやろうき、\nほとんど相手はできん。"},
        { "location": "47/TALK"   , "narrator": "みやび", "text": "けんど、それでもえいなら\nうちは構わん。\nいつでもウェルカムや。"},
        { "location": "48/TALK"   , "narrator": "神楽", "text": "ありがとうございます！\nそれじゃあ――"},
        { "location": "49/TALK"   , "narrator": "神楽", "text": "あ…。"},
        { "location": "50/TALK"   , "narrator": "みやび", "text": "…どうした？"},
        { "location": "52/TALK"   , "narrator": "神楽", "text": "い、いえ…ただその…、\nう、嬉し過ぎちゃって…。"},
        { "location": "53/TALK"   , "narrator": "みやび", "text": "…そういう感じには\n見えんけんど？"},
        { "location": "54/TALK"   , "narrator": "みやび", "text": "何か気になることでも\nあるなら、一応言うてみぃ。"},
        { "location": "57/TALK"   , "narrator": "神楽", "text": "大丈夫です。\n本当、そういうのは\nないんで…。"},
        { "location": "59/TALK"   , "narrator": "神楽", "text": "じゃあ、私はちょっと、\nやることがあるので…。"},
        { "location": "64/TALK"   , "narrator": "みやび", "text": "ウソが下手やなぁ…。\nまあ、上手な奴よりは\n親しみ持てるけんど。"},
        { "location": "65/TALK"   , "narrator": "みやび", "text": "…………。"},
        { "location": "77/TALK"   , "narrator": "みやび", "text": "謎"},
        { "location": "78/TALK"   , "narrator": "みやび", "text": "卯月の反応は見たな？"},
        { "location": "79/TALK"   , "narrator": "みやび", "text": "あの表情は何かある"},
        { "location": "80/TALK"   , "narrator": "みやび", "text": "何を隠しているのか？"},
        { "location": "81/TALK"   , "narrator": "みやび", "text": "相棒のシックスセンスに協力要請"},
        { "location": "82/TALK"   , "narrator": "みやび", "text": "どう思う？"},
        { "location": "84/SEL"    , "narrator": "", "text": "もしかして、もう来れないから？"},
        { "location": "85/SEL"    , "narrator": "", "text": "お世辞だったからじゃない？"},
        { "location": "86/ACT"    , "narrator": "", "text": "もしかして、もう来れないから？"},
        { "location": "89/TALK"   , "narrator": "みやび", "text": "来れないとは？"},
        { "location": "90/TALK"   , "narrator": "みやび", "text": "うちが帰る時に"},
        { "location": "91/TALK"   , "narrator": "みやび", "text": "ついて来ればいいだけのこと"},
        { "location": "92/TALK"   , "narrator": "みやび", "text": "なのに来れない？"},
        { "location": "93/TALK"   , "narrator": "みやび", "text": "意味が分からん"},
        { "location": "94/TALK"   , "narrator": "みやび", "text": "結論"},
        { "location": "96/TALK"   , "narrator": "みやび", "text": "相棒にシックスセンスはなかった"},
        { "location": "107/TALK"  , "narrator": "みやび", "text": "…もう来れん、か…。"},
        { "location": "108/TALK"  , "narrator": "みやび", "text": "絶対にありえん、とも\n思えんな。"},
        { "location": "109/TALK"  , "narrator": "みやび", "text": "けんど、もしそれが\n事実やったとすると、\nその理由は…？"},
        { "location": "110/TALK"  , "narrator": "みやび", "text": "…ふむ。\nやはり、あれか？"},
        { "location": "111/TALK"  , "narrator": "みやび", "text": "卯月はスパイやき、\nそれは出来んっちゅうこと\nなのかもしれん。"},
        { "location": "112/TALK"  , "narrator": "みやび", "text": "だとすると、正体を明かす\n日が近い、っちゅうこと\nなんやろか？"},
        { "location": "113/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "114/TALK"  , "narrator": "みやび", "text": "いや、先走り過ぎやな。"},
        { "location": "115/TALK"  , "narrator": "みやび", "text": "今のとこ、スパイである\n確証もないんやし…。"},
        { "location": "116/TALK"  , "narrator": "みやび", "text": "ちゅうか、こんなこと\n考えること事態、\nおかしなことや。"},
        { "location": "117/TALK"  , "narrator": "みやび", "text": "…結局、直接聞かな\nなーんもわからん、\nっちゅうことか…。"},
        { "location": "118/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "119/TALK"  , "narrator": "みやび", "text": "別に…今急いで聞かんでも\nえいよな？"},
        { "location": "120/TALK"  , "narrator": "みやび", "text": "こういうのはタイミングが\n重要やと思うし…。"},
        { "location": "121/TALK"  , "narrator": "みやび", "text": "…うん、そうや。\nタイミング見て、\n近いうちに聞けばえいか…。"},
        { "location": "138/ACT"   , "narrator": "", "text": "お世辞だったからじゃない？"},
        { "location": "139/TALK"  , "narrator": "みやび", "text": "１００パー本気はありえん"},
        { "location": "140/TALK"  , "narrator": "みやび", "text": "なんパーかはお世辞だろう"},
        { "location": "141/TALK"  , "narrator": "みやび", "text": "それは確実"},
        { "location": "142/TALK"  , "narrator": "みやび", "text": "しかし"},
        { "location": "143/TALK"  , "narrator": "みやび", "text": "だとするとあの表情に違和感を覚える"},
        { "location": "144/TALK"  , "narrator": "みやび", "text": "何か違う気がする"},
        { "location": "145/TALK"  , "narrator": "みやび", "text": "もっとこう"},
        { "location": "146/TALK"  , "narrator": "みやび", "text": "違う何かが"},
        { "location": "148/TALK"  , "narrator": "みやび", "text": "少し考える"},
        { "location": "159/TALK"  , "narrator": "みやび", "text": "微かやけんど、\nあの表情には\n悲しみが見えた。"},
        { "location": "160/TALK"  , "narrator": "みやび", "text": "何故悲しむ？\n卯月が悲しまんといかん\n理由とはなんや？"},
        { "location": "161/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "162/TALK"  , "narrator": "みやび", "text": "…いや…待て待て。"},
        { "location": "163/TALK"  , "narrator": "みやび", "text": "うち、何やっちゅうが？"},
        { "location": "164/TALK"  , "narrator": "みやび", "text": "スパイ疑惑がある卯月を\n心配しちゅうが？"},
        { "location": "165/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "167/TALK"  , "narrator": "みやび", "text": "ははっ…うちも、\nまだまだ甘いなぁ…。"},
        { "location": "17/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>8月20日　 1:02 PM</color>\n合宿中、みやびの実家でのこと"},
        { "location": "132/DIALOG", "narrator": "Dialog_GEThimegoto_ch04", "text": "【うそうその嘘】"}
    ]
}
