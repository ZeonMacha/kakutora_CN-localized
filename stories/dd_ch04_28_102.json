{
    "dir": "chap28/daydra/dd_ch04_28_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "28405",
        "cid": "miyabi",
        "title": "005 メインストーリー",
        "sub_title": "解析係数＜後編＞"
    },
    "entry":
    [
        { "location": "550/SCENARIO", "narrator": "", "text": "机上の真実展開中"},
        { "location": "568/TALK"    , "narrator": "みやび", "text": "…これは…。"},
        { "location": "569/TALK"    , "narrator": "みやび", "text": "提供者がエリカさんで\nなかったら\n正気を疑うところぞね。"},
        { "location": "570/TALK"    , "narrator": "みやび", "text": "しかし\nなんという……。"},
        { "location": "571/SEL"     , "narrator": "", "text": "解析完了？"},
        { "location": "572/SEL"     , "narrator": "", "text": "手が止まってるよ"},
        { "location": "573/SEL"     , "narrator": "", "text": "何かわかった？"},
        { "location": "574/ACT"     , "narrator": "", "text": "解析完了？"},
        { "location": "582/TALK"    , "narrator": "みやび", "text": "その先の長さに途方に暮れておる"},
        { "location": "583/ACT"     , "narrator": "", "text": "手が止まってるよ"},
        { "location": "591/TALK"    , "narrator": "みやび", "text": "それはステージが"},
        { "location": "592/TALK"    , "narrator": "みやび", "text": "進んだということ"},
        { "location": "593/ACT"     , "narrator": "", "text": "何かわかった？"},
        { "location": "601/TALK"    , "narrator": "みやび", "text": "わかったというか"},
        { "location": "603/TALK"    , "narrator": "みやび", "text": "一旦解析は"},
        { "location": "604/TALK"    , "narrator": "みやび", "text": "終了した"},
        { "location": "605/TALK"    , "narrator": "みやび", "text": "ゆえにうちは"},
        { "location": "606/TALK"    , "narrator": "みやび", "text": "熟考に入る"},
        { "location": "607/TALK"    , "narrator": "みやび", "text": "問いかけ無用"},
        { "location": "608/TALK"    , "narrator": "みやび", "text": "以上だ"},
        { "location": "613/TALK"    , "narrator": "みやび", "text": "もしこれが\n実用に耐える\nものやとして。"},
        { "location": "614/TALK"    , "narrator": "みやび", "text": "まほさんに伝える\nことに何の意味が？"},
        { "location": "615/SEL"     , "narrator": "", "text": "何だったの？"},
        { "location": "616/SEL"     , "narrator": "", "text": "教えて欲しいな…"},
        { "location": "617/SEL"     , "narrator": "", "text": "$me$に話せば頭の整理になるよ"},
        { "location": "618/ACT"     , "narrator": "", "text": "何だったの？"},
        { "location": "626/TALK"    , "narrator": "みやび", "text": "そうやね"},
        { "location": "627/ACT"     , "narrator": "", "text": "教えて欲しいな…"},
        { "location": "635/TALK"    , "narrator": "みやび", "text": "黙っておくわけにもいかんろう"},
        { "location": "636/ACT"     , "narrator": "", "text": "$me$に話せば頭の整理になるよ"},
        { "location": "644/TALK"    , "narrator": "みやび", "text": "それも確かに"},
        { "location": "645/TALK"    , "narrator": "みやび", "text": "一理ある"},
        { "location": "647/TALK"    , "narrator": "みやび", "text": "$handle$も一応関係者"},
        { "location": "648/TALK"    , "narrator": "みやび", "text": "ということで"},
        { "location": "649/TALK"    , "narrator": "みやび", "text": "伝えておこう"},
        { "location": "650/TALK"    , "narrator": "みやび", "text": "エリカさんのデータは"},
        { "location": "651/TALK"    , "narrator": "みやび", "text": "クランのレシピ"},
        { "location": "652/TALK"    , "narrator": "みやび", "text": "だったぞね"},
        { "location": "654/SEL"     , "narrator": "", "text": "えと…料理なの？"},
        { "location": "655/SEL"     , "narrator": "", "text": "作り方、的な？"},
        { "location": "656/SEL"     , "narrator": "", "text": "そんなことなんで知ってるの"},
        { "location": "657/ACT"     , "narrator": "", "text": "えと…料理なの？"},
        { "location": "658/TALK"    , "narrator": "みやび", "text": "手順書というか"},
        { "location": "659/TALK"    , "narrator": "みやび", "text": "設計図というか"},
        { "location": "660/TALK"    , "narrator": "みやび", "text": "そんなものだ"},
        { "location": "661/ACT"     , "narrator": "", "text": "作り方、的な？"},
        { "location": "662/TALK"    , "narrator": "みやび", "text": "おおざっぱに言うと"},
        { "location": "663/TALK"    , "narrator": "みやび", "text": "そんな感じだ"},
        { "location": "664/ACT"     , "narrator": "", "text": "そんなことなんで知ってるの"},
        { "location": "665/TALK"    , "narrator": "みやび", "text": "それはうちが知りたい"},
        { "location": "667/TALK"    , "narrator": "みやび", "text": "とにかくここにある"},
        { "location": "668/TALK"    , "narrator": "みやび", "text": "条件その他を整えれば"},
        { "location": "669/TALK"    , "narrator": "みやび", "text": "クランを引っこ抜くことも"},
        { "location": "670/TALK"    , "narrator": "みやび", "text": "元の状態に戻すことも"},
        { "location": "671/TALK"    , "narrator": "みやび", "text": "できるようになる"},
        { "location": "672/TALK"    , "narrator": "みやび", "text": "はず"},
        { "location": "673/TALK"    , "narrator": "みやび", "text": "理論上は"},
        { "location": "675/SEL"     , "narrator": "", "text": "危険じゃないの？"},
        { "location": "676/SEL"     , "narrator": "", "text": "そんなことできるんだ"},
        { "location": "677/SEL"     , "narrator": "", "text": "エリカってすごい人だったんだ"},
        { "location": "678/ACT"     , "narrator": "", "text": "危険じゃないの？"},
        { "location": "679/TALK"    , "narrator": "みやび", "text": "その可能性は"},
        { "location": "680/TALK"    , "narrator": "みやび", "text": "否定できない"},
        { "location": "681/ACT"     , "narrator": "", "text": "そんなことできるんだ"},
        { "location": "682/TALK"    , "narrator": "みやび", "text": "このデータの内容が"},
        { "location": "683/TALK"    , "narrator": "みやび", "text": "正確ならばな"},
        { "location": "684/ACT"     , "narrator": "", "text": "エリカってすごい人だったんだ"},
        { "location": "685/TALK"    , "narrator": "みやび", "text": "何を今さら"},
        { "location": "686/TALK"    , "narrator": "みやび", "text": "わかりきったことを"},
        { "location": "692/TALK"    , "narrator": "みやび", "text": "そもそも松代で\nクランが発生する\nことが……。"},
        { "location": "693/TALK"    , "narrator": "みやび", "text": "！"},
        { "location": "694/TALK"    , "narrator": "みやび", "text": "音羽！"},
        { "location": "695/TALK"    , "narrator": "みやび", "text": "これは音羽を\n治すために\n必要な情報！？"},
        { "location": "696/TALK"    , "narrator": "みやび", "text": "なるほど。\nそういうこと\nだったぞね。"},
        { "location": "700/TALK"    , "narrator": "みやび", "text": "相棒よ"},
        { "location": "701/TALK"    , "narrator": "みやび", "text": "これからうちは"},
        { "location": "702/TALK"    , "narrator": "みやび", "text": "まほさんに報告する"},
        { "location": "703/TALK"    , "narrator": "みやび", "text": "エリカさんのデータの内容を"},
        { "location": "704/TALK"    , "narrator": "みやび", "text": "橋渡し感謝する"},
        { "location": "706/SEL"     , "narrator": "", "text": "どういたしまして"},
        { "location": "707/SEL"     , "narrator": "", "text": "早く解決するといいね"},
        { "location": "708/SEL"     , "narrator": "", "text": "さっきの話詳しく教えて"},
        { "location": "709/ACT"     , "narrator": "", "text": "どういたしまして"},
        { "location": "710/TALK"    , "narrator": "みやび", "text": "大変に感謝する"},
        { "location": "711/TALK"    , "narrator": "みやび", "text": "ではまた"},
        { "location": "712/ACT"     , "narrator": "", "text": "早く解決するといいね"},
        { "location": "713/TALK"    , "narrator": "みやび", "text": "うちも努力する"},
        { "location": "714/TALK"    , "narrator": "みやび", "text": "吉報を待て"},
        { "location": "715/ACT"     , "narrator": "", "text": "さっきの話詳しく教えて"},
        { "location": "716/TALK"    , "narrator": "みやび", "text": "それは"},
        { "location": "717/TALK"    , "narrator": "みやび", "text": "無理だ"},
        { "location": "719/SEL"     , "narrator": "", "text": "そんなに危ない内容なの？"},
        { "location": "720/SEL"     , "narrator": "", "text": "知りたいな…"},
        { "location": "721/SEL"     , "narrator": "", "text": "面倒くさいだけなんでしょ"},
        { "location": "722/ACT"     , "narrator": "", "text": "そんなに危ない内容なの？"},
        { "location": "723/TALK"    , "narrator": "みやび", "text": "それもあるが"},
        { "location": "724/ACT"     , "narrator": "", "text": "知りたいな…"},
        { "location": "725/TALK"    , "narrator": "みやび", "text": "そうなのか？"},
        { "location": "726/TALK"    , "narrator": "みやび", "text": "では真実を告げよう"},
        { "location": "727/ACT"     , "narrator": "", "text": "面倒くさいだけなんでしょ"},
        { "location": "728/TALK"    , "narrator": "みやび", "text": "よくわかったな"},
        { "location": "730/TALK"    , "narrator": "みやび", "text": "説明が面倒くさい"},
        { "location": "731/TALK"    , "narrator": "みやび", "text": "ゆえに教えたくない"},
        { "location": "733/SEL"     , "narrator": "", "text": "まあそう言わず"},
        { "location": "734/SEL"     , "narrator": "", "text": "いいから教えて"},
        { "location": "735/SEL"     , "narrator": "", "text": "もしかして説明できないだけじゃ？"},
        { "location": "736/ACT"     , "narrator": "", "text": "まあそう言わず"},
        { "location": "737/TALK"    , "narrator": "みやび", "text": "えー"},
        { "location": "738/ACT"     , "narrator": "", "text": "いいから教えて"},
        { "location": "739/TALK"    , "narrator": "みやび", "text": "おやおや"},
        { "location": "740/ACT"     , "narrator": "", "text": "もしかして説明できないだけじゃ？"},
        { "location": "741/TALK"    , "narrator": "みやび", "text": "そんなわけがなかろう"},
        { "location": "743/TALK"    , "narrator": "みやび", "text": "仕方ないの"},
        { "location": "744/TALK"    , "narrator": "みやび", "text": "聞くがよい"},
        { "location": "747/TALK"    , "narrator": "みやび", "text": "クランという存在は、人のココロの中にある人格の１つと同義"},
        { "location": "748/TALK"    , "narrator": "みやび", "text": "それを現実に顕在化するためには"},
        { "location": "749/TALK"    , "narrator": "みやび", "text": "量子的干渉を行い"},
        { "location": "750/TALK"    , "narrator": "みやび", "text": "物理的周囲に存在する人間の感覚までも"},
        { "location": "751/TALK"    , "narrator": "みやび", "text": "それが「本当である」ということを"},
        { "location": "752/TALK"    , "narrator": "みやび", "text": "潜在意識下において素直に信じ込ませるコトが必要になる"},
        { "location": "755/TALK"    , "narrator": "みやび", "text": "ここまでは理解できたか？"},
        { "location": "756/SEL"     , "narrator": "", "text": "なんとか"},
        { "location": "757/SEL"     , "narrator": "", "text": "大体は"},
        { "location": "758/SEL"     , "narrator": "", "text": "ごめん$me$が悪かった"},
        { "location": "759/ACT"     , "narrator": "", "text": "なんとか"},
        { "location": "760/TALK"    , "narrator": "みやび", "text": "なかなか優秀だの"},
        { "location": "761/ACT"     , "narrator": "", "text": "大体は"},
        { "location": "762/TALK"    , "narrator": "みやび", "text": "それは素晴らしい"},
        { "location": "763/ACT"     , "narrator": "", "text": "ごめん$me$が悪かった"},
        { "location": "764/TALK"    , "narrator": "みやび", "text": "ここまで来たら最後まで聞け"},
        { "location": "767/TALK"    , "narrator": "みやび", "text": "逆に言えば"},
        { "location": "768/TALK"    , "narrator": "みやび", "text": "それによって他セカイとの不整合を発生させることができる"},
        { "location": "769/TALK"    , "narrator": "みやび", "text": "その結果、フェノメノンが形成されるのだ"},
        { "location": "772/SEL"     , "narrator": "", "text": "わかったような"},
        { "location": "773/SEL"     , "narrator": "", "text": "なんかすごいってことは伝わった"},
        { "location": "774/SEL"     , "narrator": "", "text": "世界のずれがフェノメノンの発生原因ってとこかな"},
        { "location": "775/ACT"     , "narrator": "", "text": "わかったような"},
        { "location": "776/TALK"    , "narrator": "みやび", "text": "まあそうなるか"},
        { "location": "777/ACT"     , "narrator": "", "text": "なんかすごいってことは伝わった"},
        { "location": "778/TALK"    , "narrator": "みやび", "text": "それでいいか"},
        { "location": "779/ACT"     , "narrator": "", "text": "世界のずれがフェノメノンの発生原因ってとこかな"},
        { "location": "780/TALK"    , "narrator": "みやび", "text": "全部ではないがの"},
        { "location": "782/TALK"    , "narrator": "みやび", "text": "なお他セカイの不整合には"},
        { "location": "783/TALK"    , "narrator": "みやび", "text": "膨大なエネルギーとレディネスが必要"},
        { "location": "784/TALK"    , "narrator": "みやび", "text": "らしいが"},
        { "location": "785/TALK"    , "narrator": "みやび", "text": "レディネスについてはうちも不明"},
        { "location": "786/TALK"    , "narrator": "みやび", "text": "今のところは"},
        { "location": "787/TALK"    , "narrator": "みやび", "text": "そして今大事なことは"},
        { "location": "788/TALK"    , "narrator": "みやび", "text": "まほさんへの報告ぞね"},
        { "location": "790/SEL"     , "narrator": "", "text": "そうだね"},
        { "location": "791/SEL"     , "narrator": "", "text": "とりあえずお疲れさま"},
        { "location": "792/SEL"     , "narrator": "", "text": "もう少し頑張って！"},
        { "location": "793/ACT"     , "narrator": "", "text": "そうだね"},
        { "location": "794/TALK"    , "narrator": "みやび", "text": "ということで"},
        { "location": "795/TALK"    , "narrator": "みやび", "text": "さらばだ"},
        { "location": "796/ACT"     , "narrator": "", "text": "とりあえずお疲れさま"},
        { "location": "797/TALK"    , "narrator": "みやび", "text": "うむ"},
        { "location": "798/TALK"    , "narrator": "みやび", "text": "解析については終了ぞね"},
        { "location": "799/ACT"     , "narrator": "", "text": "もう少し頑張って！"},
        { "location": "800/TALK"    , "narrator": "みやび", "text": "だったらええけんど"},
        { "location": "806/TALK"    , "narrator": "みやび", "text": "それにしても。"},
        { "location": "807/TALK"    , "narrator": "みやび", "text": "まほさんとエリカさんは\nどういう間柄\nなんやろうねえ…。"},
        { "location": "818/DIALOG"  , "narrator": "Dialog_chapter_ch04", "text": "【23 エクセプション】"}
    ]
}
