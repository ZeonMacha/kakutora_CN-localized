    "entry":
    [
        { "location": "2803/SCENARIO", "narrator": "", "text": "チャンネルはそのままね"},
        { "location": "2828/TALK"    , "narrator": "神楽", "text": "チャンネルは変える派？"},
        { "location": "2829/TALK"    , "narrator": "神楽", "text": "それとも回す派？"},
        { "location": "2831/SEL"     , "narrator": "", "text": "いつも神楽チャンネルに合わせてる"},
        { "location": "2832/SEL"     , "narrator": "", "text": "ジョグダイヤルだから回してる"},
        { "location": "2833/SEL"     , "narrator": "", "text": "変える以外にあるの？"},
        { "location": "2834/ACT"     , "narrator": "", "text": "いつも神楽チャンネルに合わせてる"},
        { "location": "2836/TALK"    , "narrator": "神楽", "text": "よしよし偉いぞ♪"},
        { "location": "2838/TALK"    , "narrator": "神楽", "text": "それでこそ$handlek$"},
        { "location": "2839/ACT"     , "narrator": "", "text": "ジョグダイヤルだから回してる"},
        { "location": "2840/TALK"    , "narrator": "神楽", "text": "そういやそういうのもあった"},
        { "location": "2841/ACT"     , "narrator": "", "text": "変える以外にあるの？"},
        { "location": "2842/TALK"    , "narrator": "神楽", "text": "あるんですー"},
        { "location": "2844/TALK"    , "narrator": "神楽", "text": "あとさーチャンネルとチャネルは語源同じだって知ってた？"},
        { "location": "2846/SEL"     , "narrator": "", "text": "またまた"},
        { "location": "2847/SEL"     , "narrator": "", "text": "常識だよ"},
        { "location": "2848/SEL"     , "narrator": "", "text": "日本語の意味するところは違ってる"},
        { "location": "2849/ACT"     , "narrator": "", "text": "またまた"},
        { "location": "2850/TALK"    , "narrator": "神楽", "text": "本当だっつー"},
        { "location": "2851/ACT"     , "narrator": "", "text": "常識だよ"},
        { "location": "2852/TALK"    , "narrator": "神楽", "text": "マジで！"},
        { "location": "2853/ACT"     , "narrator": "", "text": "日本語の意味するところは違ってる"},
        { "location": "2854/TALK"    , "narrator": "神楽", "text": "今はねー"},
        { "location": "2856/TALK"    , "narrator": "神楽", "text": "チャンネルはエンタメでチャネルは流通って感じするのよねー"},
        { "location": "2858/SEL"     , "narrator": "", "text": "わかる！"},
        { "location": "2859/SEL"     , "narrator": "", "text": "商売人だなー"},
        { "location": "2860/SEL"     , "narrator": "", "text": "$me$チャネルは神楽の独占市場"},
        { "location": "2861/ACT"     , "narrator": "", "text": "わかる！"},
        { "location": "2862/TALK"    , "narrator": "神楽", "text": "でしょ！"},
        { "location": "2863/ACT"     , "narrator": "", "text": "商売人だなー"},
        { "location": "2864/TALK"    , "narrator": "神楽", "text": "市場にも敏感じゃないとやっていけないんですー！"},
        { "location": "2865/ACT"     , "narrator": "", "text": "$me$チャネルは神楽の独占市場"},
        { "location": "2867/TALK"    , "narrator": "神楽", "text": "アハハｲｲﾈ！"},
        { "location": "2868/TALK"    , "narrator": "神楽", "text": "ぴょんこに廃課金どころの騒ぎじゃないのめり込みぶり"},
        { "location": "2869/TALK"    , "narrator": "神楽", "text": "ニヤニヤしちゃう♪"},
        { "location": "2871/TALK"    , "narrator": "神楽", "text": "$handlek$は何が何でもぴょんこにチャンネルを合わせておくこと！"},
        { "location": "2872/TALK"    , "narrator": "神楽", "text": "これは義務かつ権利である！"}
    ]
}
