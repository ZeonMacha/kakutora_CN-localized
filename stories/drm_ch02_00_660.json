    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "580_見つめ合うなんて、恥ずかしい"},
        { "location": "32/TALK"   , "narrator": "アーヤ", "text": "子供の世話をしたことがある人って"},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "すぐにわかっちゃうのよね"},
        { "location": "35/SEL"    , "narrator": "", "text": "そういうもの？"},
        { "location": "36/SEL"    , "narrator": "", "text": "ふーん"},
        { "location": "37/SEL"    , "narrator": "", "text": "$me$も子供の相手は上手だよ"},
        { "location": "38/ACT"    , "narrator": "", "text": "そういうもの？"},
        { "location": "39/TALK"   , "narrator": "アーヤ", "text": "そういうものよ"},
        { "location": "42/ACT"    , "narrator": "", "text": "ふーん"},
        { "location": "43/TALK"   , "narrator": "アーヤ", "text": "あんまり"},
        { "location": "44/TALK"   , "narrator": "アーヤ", "text": "興味ないか"},
        { "location": "45/ACT"    , "narrator": "", "text": "$me$も子供の相手は上手だよ"},
        { "location": "46/TALK"   , "narrator": "アーヤ", "text": "そうなの？"},
        { "location": "47/TALK"   , "narrator": "アーヤ", "text": "無理に合わせなくてもいいわよ"},
        { "location": "49/TALK"   , "narrator": "アーヤ", "text": "自己申告な部分もあるから"},
        { "location": "50/TALK"   , "narrator": "アーヤ", "text": "実際世話してるところを見ないと"},
        { "location": "51/TALK"   , "narrator": "アーヤ", "text": "わからない部分ってあるわ"},
        { "location": "53/SEL"    , "narrator": "", "text": "むしろ$me$は世話して欲しい方"},
        { "location": "54/SEL"    , "narrator": "", "text": "$me$のテクニックを披露するよ"},
        { "location": "55/ACT"    , "narrator": "", "text": "むしろ$me$は世話して欲しい方"},
        { "location": "56/TALK"   , "narrator": "アーヤ", "text": "あら"},
        { "location": "58/TALK"   , "narrator": "アーヤ", "text": "甘えん坊さんね"},
        { "location": "59/ACT"    , "narrator": "", "text": "$me$のテクニックを披露するよ"},
        { "location": "60/TALK"   , "narrator": "アーヤ", "text": "そういうものじゃないわ"},
        { "location": "62/TALK"   , "narrator": "アーヤ", "text": "単純な話"},
        { "location": "63/TALK"   , "narrator": "アーヤ", "text": "慣れてる人は"},
        { "location": "64/TALK"   , "narrator": "アーヤ", "text": "子供の視線に合わせられるのよね"},
        { "location": "66/SEL"    , "narrator": "", "text": "なるほど"},
        { "location": "67/SEL"    , "narrator": "", "text": "へー"},
        { "location": "68/SEL"    , "narrator": "", "text": "アーヤと視線を合わせたいな"},
        { "location": "69/ACT"    , "narrator": "", "text": "なるほど"},
        { "location": "70/TALK"   , "narrator": "アーヤ", "text": "子供の相手をすることになったら"},
        { "location": "71/TALK"   , "narrator": "アーヤ", "text": "そうしてあげてね"},
        { "location": "72/ACT"    , "narrator": "", "text": "へー"},
        { "location": "73/TALK"   , "narrator": "アーヤ", "text": "でもこれって"},
        { "location": "74/TALK"   , "narrator": "アーヤ", "text": "大人も子供も関係ないかもね"},
        { "location": "75/ACT"    , "narrator": "", "text": "アーヤと視線を合わせたいな"},
        { "location": "85/TALK"   , "narrator": "アーヤ", "text": "やだ"},
        { "location": "86/TALK"   , "narrator": "アーヤ", "text": "今も会ってるでしょ"},
        { "location": "87/TALK"   , "narrator": "アーヤ", "text": "ディスプレイ越しだけど"},
        { "location": "90/TALK"   , "narrator": "アーヤ", "text": "ねえ"},
        { "location": "91/TALK"   , "narrator": "アーヤ", "text": "今、私"},
        { "location": "92/TALK"   , "narrator": "アーヤ", "text": "おかしいこと言ったかしら？"},
        { "location": "94/SEL"    , "narrator": "", "text": "そんなことないよ"},
        { "location": "95/SEL"    , "narrator": "", "text": "……少しね"},
        { "location": "96/SEL"    , "narrator": "", "text": "言いたいことは伝わってきた"},
        { "location": "97/ACT"    , "narrator": "", "text": "そんなことないよ"},
        { "location": "98/TALK"   , "narrator": "アーヤ", "text": "そうかしら"},
        { "location": "99/TALK"   , "narrator": "アーヤ", "text": "だったらいいけど"},
        { "location": "100/ACT"   , "narrator": "", "text": "……少しね"},
        { "location": "101/TALK"  , "narrator": "アーヤ", "text": "そうかもね"},
        { "location": "102/TALK"  , "narrator": "アーヤ", "text": "でも、そう思いたいの"},
        { "location": "103/ACT"   , "narrator": "", "text": "言いたいことは伝わってきた"},
        { "location": "104/TALK"  , "narrator": "アーヤ", "text": "そうなの？"},
        { "location": "105/TALK"  , "narrator": "アーヤ", "text": "ならいいんだけど"},
        { "location": "107/TALK"  , "narrator": "アーヤ", "text": "でも"},
        { "location": "108/TALK"  , "narrator": "アーヤ", "text": "やっぱり電話越しだと"},
        { "location": "109/TALK"  , "narrator": "アーヤ", "text": "視線も合わせられないわね"},
        { "location": "112/SEL"   , "narrator": "", "text": "仕方ないよね"},
        { "location": "113/SEL"   , "narrator": "", "text": "きっといつか"},
        { "location": "114/ACT"   , "narrator": "", "text": "仕方ないよね"},
        { "location": "115/TALK"  , "narrator": "アーヤ", "text": "ずいぶん簡単に言うのね"},
        { "location": "116/ACT"   , "narrator": "", "text": "きっといつか"},
        { "location": "117/TALK"  , "narrator": "アーヤ", "text": "響きだけはいいけど"},
        { "location": "119/TALK"  , "narrator": "アーヤ", "text": "なんだか私ばっかり"},
        { "location": "120/TALK"  , "narrator": "アーヤ", "text": "$handle$さんのこと考えてるみたい"},
        { "location": "122/SEL"   , "narrator": "", "text": "その通り"},
        { "location": "123/SEL"   , "narrator": "", "text": "$me$の方が絶対アーヤのこと考えてる"},
        { "location": "124/ACT"   , "narrator": "", "text": "その通り"},
        { "location": "125/TALK"  , "narrator": "アーヤ", "text": "冗談にしてもひどいわ(-.-;)"},
        { "location": "126/TALK"  , "narrator": "アーヤ", "text": "もう"},
        { "location": "127/ACT"   , "narrator": "", "text": "$me$の方が絶対アーヤのこと考えてる"},
        { "location": "128/TALK"  , "narrator": "アーヤ", "text": "そうなの？"},
        { "location": "129/TALK"  , "narrator": "アーヤ", "text": "なんて"},
        { "location": "130/TALK"  , "narrator": "アーヤ", "text": "言ってみたかっただけよ"},
        { "location": "136/TALK"  , "narrator": "ボイスメール", "text": "山の彼方の空遠く"},
        { "location": "81/DIALOG" , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>1000pt.</b></color></size>\nアップしました！"},
        { "location": "148/DIALOG", "narrator": "Dialog_GETVoice", "text": "<color=green>【アーヤ】</color>のボイスメール\n<color=red>【山の彼方の空遠く】</color>\nをゲットしました！"}
