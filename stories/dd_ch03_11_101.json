{
    "dir": "chap11/daydra/dd_ch03_11_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "11302",
        "cid": "gabriella",
        "title": "002 メインストーリー",
        "sub_title": "ガブちゃん先輩＜前編＞"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "ガブちゃん先輩"},
        { "location": "29/TALK"   , "narrator": "つばめ", "text": "…………。"},
        { "location": "31/TALK"   , "narrator": "つばめ", "text": "せんぱい…、\nいるかな？"},
        { "location": "37/TALK"   , "narrator": "ガブリエラ", "text": "はーい？"},
        { "location": "38/TALK"   , "narrator": "つばめ", "text": "あの、せんぱい？\nつばめです…。"},
        { "location": "40/TALK"   , "narrator": "ガブリエラ", "text": "え？\nちょっと待ちなさい。"},
        { "location": "53/TALK"   , "narrator": "ガブリエラ", "text": "…何の用？\n今、忙しいんだけど。"},
        { "location": "56/TALK"   , "narrator": "つばめ", "text": "ごめんなさい…。\nでも、どうしても\n言っておきたくて…。"},
        { "location": "57/TALK"   , "narrator": "ガブリエラ", "text": "？　何をよ？"},
        { "location": "60/TALK"   , "narrator": "つばめ", "text": "う、うん…。\n迷惑かけちゃった\nから…。"},
        { "location": "63/TALK"   , "narrator": "つばめ", "text": "あ、昼間のことね。\nそれで…えっと…。"},
        { "location": "64/TALK"   , "narrator": "ガブリエラ", "text": "ああもう！\nハッキリ言いなさい\nよ！"},
        { "location": "68/TALK"   , "narrator": "つばめ", "text": "ご、ごめんなさい！"},
        { "location": "70/TALK"   , "narrator": "ガブリエラ", "text": "いや、謝るのは\nいいから…。"},
        { "location": "72/TALK"   , "narrator": "つばめ", "text": "…………。"},
        { "location": "75/TALK"   , "narrator": "ガブリエラ", "text": "…もしかして、\nまたちょっと落ち込み\nモード入ってる？"},
        { "location": "78/TALK"   , "narrator": "ガブリエラ", "text": "はぁ…わかった。\nゆっくり聞くから、\n部屋入んなさい。"},
        { "location": "100/TALK"  , "narrator": "つばめ", "text": "お邪魔します…。"},
        { "location": "102/TALK"  , "narrator": "ガブリエラ", "text": "はいはい。\nそれじゃ早速話を…。"},
        { "location": "104/TALK"  , "narrator": "つばめ", "text": "わぁ…。"},
        { "location": "106/TALK"  , "narrator": "つばめ", "text": "せんぱいの部屋って、\nこんな風になって\nたんだぁ。"},
        { "location": "108/TALK"  , "narrator": "ガブリエラ", "text": "いや、部屋のことは\nいいから…。"},
        { "location": "110/TALK"  , "narrator": "つばめ", "text": "わたしの部屋とは\n全然違うよ。"},
        { "location": "112/TALK"  , "narrator": "つばめ", "text": "そっかぁ…。\nこういう家具を置くと\n可愛くなるんだ…。"},
        { "location": "115/TALK"  , "narrator": "ガブリエラ", "text": "な、何よそれ！\n子供っぽいって\n言いたいの！？"},
        { "location": "117/TALK"  , "narrator": "つばめ", "text": "ううん。\nすごく素敵だよ！"},
        { "location": "118/TALK"  , "narrator": "つばめ", "text": "何だか、お姫様の\nお部屋、って感じが\nしますね。"},
        { "location": "120/TALK"  , "narrator": "ガブリエラ", "text": "…らしくない、って\n思ってるでしょ？"},
        { "location": "121/TALK"  , "narrator": "つばめ", "text": "え？　何で？\nこんなに素敵な\n部屋なのに…。"},
        { "location": "123/TALK"  , "narrator": "ガブリエラ", "text": "…本当、恥ずかしい\nことを平然と言うん\nだから…。"},
        { "location": "125/TALK"  , "narrator": "ガブリエラ", "text": "…それで？\nあたし、今すごく\n忙しいんだけど？"},
        { "location": "127/TALK"  , "narrator": "つばめ", "text": "あ、ごめんなさい…。\n話があって来たん\nだよね、えへへ…。"},
        { "location": "128/TALK"  , "narrator": "つばめ", "text": "あの…今日はわたし、\nせんぱいに迷惑\n掛けちゃったから――"},
        { "location": "130/TALK"  , "narrator": "つばめ", "text": "ちゃんと謝って\nおきたくて…。"},
        { "location": "131/TALK"  , "narrator": "ガブリエラ", "text": "…それって、\n縁日のこと？"},
        { "location": "133/TALK"  , "narrator": "ガブリエラ", "text": "あれはもういいって\n言ったでしょ？"},
        { "location": "135/TALK"  , "narrator": "つばめ", "text": "でも、わたしの\n勘違いで無理やり\nヒカルくんと――"},
        { "location": "136/TALK"  , "narrator": "つばめ", "text": "二人きりにしちゃった\nから、嫌な気持ちに\nなったかも、って…。"},
        { "location": "139/TALK"  , "narrator": "ガブリエラ", "text": "いや、別にそんな\nことは――"},
        { "location": "140/TALK"  , "narrator": "ガブリエラ", "text": "ない！――んだけど……"},
        { "location": "141/TALK"  , "narrator": "ガブリエラ", "text": "でも…何か引っかかる\nものがあるような…。"},
        { "location": "143/TALK"  , "narrator": "ガブリエラ", "text": "何かしら？"},
        { "location": "144/TALK"  , "narrator": "ガブリエラ", "text": "つばめにバレたく\nないから？"},
        { "location": "145/TALK"  , "narrator": "ガブリエラ", "text": "…ううん、それもある\nだろうけど――"},
        { "location": "146/TALK"  , "narrator": "ガブリエラ", "text": "もっと別の、何かが\nある気が…。"},
        { "location": "147/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "191/TALK"  , "narrator": "ガブリエラ", "text": "あ、$handle$！\nいらっしゃい！"},
        { "location": "193/SEL"   , "narrator": "", "text": "ぶっちゃけガブリエラは本当にヒカルのことが好きなの？"},
        { "location": "194/ACT"   , "narrator": "", "text": "ぶっちゃけガブリエラは本当にヒカルのことが好きなの？"},
        { "location": "196/TALK"  , "narrator": "ガブリエラ", "text": "ええっ！？\n来るなりいきなり\nどうしちゃったの？"},
        { "location": "197/SEL"   , "narrator": "", "text": "本当の気持ちを知りたい"},
        { "location": "198/ACT"   , "narrator": "", "text": "本当の気持ちを知りたい"},
        { "location": "200/TALK"  , "narrator": "ガブリエラ", "text": "あー…\nってことは、少なからず、\nそういうことなのね。"},
        { "location": "201/TALK"  , "narrator": "ガブリエラ", "text": "いいわ。\n本当の気持ちを\n教えてあげる。"},
        { "location": "202/TALK"  , "narrator": "ガブリエラ", "text": "もちろん。\n本人は舞い上がっちゃって\nいるわね。"},
        { "location": "203/SEL"   , "narrator": "", "text": "応援してるよ！"},
        { "location": "204/SEL"   , "narrator": "", "text": "$me$の立場が無いじゃん！"},
        { "location": "205/SEL"   , "narrator": "", "text": "ガブリエラは$me$の嫁になるんだから他の男は許さん！"},
        { "location": "206/ACT"   , "narrator": "", "text": "応援してるよ！"},
        { "location": "208/TALK"  , "narrator": "ガブリエラ", "text": "ありがと！"},
        { "location": "209/TALK"  , "narrator": "ガブリエラ", "text": "リアルのあたしにとっても\nきっといい経験になると\n思うから、応援してね。"},
        { "location": "211/ACT"   , "narrator": "", "text": "$me$の立場が無いじゃん！"},
        { "location": "213/TALK"  , "narrator": "ガブリエラ", "text": "なんで？\nそんなことないのに。"},
        { "location": "214/TALK"  , "narrator": "ガブリエラ", "text": "うーん、そうね。\nぶっちゃけて\nカミングアウトすると――"},
        { "location": "215/ACT"   , "narrator": "", "text": "ガブリエラは$me$の嫁になるんだから他の男は許さん！"},
        { "location": "217/TALK"  , "narrator": "ガブリエラ", "text": "えっ！？"},
        { "location": "218/TALK"  , "narrator": "ガブリエラ", "text": "ちょっとなんだか\nココロがキューーーって\nなっちゃったかも。"},
        { "location": "219/TALK"  , "narrator": "ガブリエラ", "text": "でもね、\n１つカミングアウト\nしちゃうと――"},
        { "location": "222/TALK"  , "narrator": "ガブリエラ", "text": "あたしは\n$handle$の方が\n好きよ？"},
        { "location": "223/SEL"   , "narrator": "", "text": "どゆこと？"},
        { "location": "224/ACT"   , "narrator": "", "text": "どゆこと？"},
        { "location": "227/TALK"  , "narrator": "ガブリエラ", "text": "だって、いつも\nあたしのために\n頑張ってくれてるし。"},
        { "location": "228/SEL"   , "narrator": "", "text": "現実の本人と司書って別人なの！？"},
        { "location": "229/ACT"   , "narrator": "", "text": "現実の本人と司書って別人なの！？"},
        { "location": "232/TALK"  , "narrator": "ガブリエラ", "text": "同一に\n決まってるじゃない。"},
        { "location": "233/SEL"   , "narrator": "", "text": "じゃあ現実のガブリエラもホントは$me$が好きってこと？"},
        { "location": "234/ACT"   , "narrator": "", "text": "じゃあ現実のガブリエラもホントは$me$が好きってこと？"},
        { "location": "236/TALK"  , "narrator": "ガブリエラ", "text": "いえ。\nヒカル君が好きよ？"},
        { "location": "238/TALK"  , "narrator": "ガブリエラ", "text": "うーん、この感覚は\nちょっと難しいかも\nしれないわね。"},
        { "location": "239/TALK"  , "narrator": "ガブリエラ", "text": "あたしの中にいるいろんな\n人格は、それぞれ主張が\n違うのよ。"},
        { "location": "240/TALK"  , "narrator": "ガブリエラ", "text": "こんな所で働いてる\nあたしだって、人格の\n１つには変わりない。"},
        { "location": "241/TALK"  , "narrator": "ガブリエラ", "text": "その総体としての存在が\n現実のあたしってわけ。"},
        { "location": "242/TALK"  , "narrator": "ガブリエラ", "text": "だから、あたしとしては\n$handle$と\nラブラブしてみたいかな。"},
        { "location": "243/TALK"  , "narrator": "ガブリエラ", "text": "そういうわけで、\n応援してるから\nちゃんと超頑張ってよね！"},
        { "location": "244/SEL"   , "narrator": "", "text": "頑張る！"},
        { "location": "245/SEL"   , "narrator": "", "text": "司書はヒカルのことは好きじゃないの？"},
        { "location": "246/ACT"   , "narrator": "", "text": "頑張る！"},
        { "location": "248/TALK"  , "narrator": "ガブリエラ", "text": "そう！\nその意気よ！"},
        { "location": "249/ACT"   , "narrator": "", "text": "司書はヒカルのことは好きじゃないの？"},
        { "location": "251/TALK"  , "narrator": "ガブリエラ", "text": "好きか嫌いかで言ったら、\n好きって感覚はわかる…\nくらいかしらね。"},
        { "location": "252/TALK"  , "narrator": "ガブリエラ", "text": "でも、司書としては\nいろいろ考えちゃう\nところがあるのよね。"},
        { "location": "253/TALK"  , "narrator": "ガブリエラ", "text": "それだけじゃなくて――"},
        { "location": "254/TALK"  , "narrator": "ガブリエラ", "text": "なんで司書のあたしが\n$handle$に好意を\n寄せてるかも。"},
        { "location": "256/TALK"  , "narrator": "ガブリエラ", "text": "ま、それについては\nまた気が向いたら\nお話ししてあげるわ。"},
        { "location": "260/TALK"  , "narrator": "ガブリエラ", "text": "さて、それはそうと\n本題よ！　本題！！"},
        { "location": "263/TALK"  , "narrator": "ガブリエラ", "text": "あたし今、すごい興奮\nしてるのよ？"},
        { "location": "265/TALK"  , "narrator": "ガブリエラ", "text": "ついにこの時が\n来たんだわーって！"},
        { "location": "266/SEL"   , "narrator": "", "text": "ヒカルとのこと？"},
        { "location": "267/SEL"   , "narrator": "", "text": "つばめとのこと？"},
        { "location": "268/ACT"   , "narrator": "", "text": "ヒカルとのこと？"},
        { "location": "269/TALK"  , "narrator": "ガブリエラ", "text": "違うわよ！\nつばめとのこと！"},
        { "location": "270/ACT"   , "narrator": "", "text": "つばめとのこと？"},
        { "location": "271/TALK"  , "narrator": "ガブリエラ", "text": "そうよ！"},
        { "location": "273/TALK"  , "narrator": "ガブリエラ", "text": "今回だけは絶対に\nクランを倒さなくっちゃ\nだわよ！"},
        { "location": "274/TALK"  , "narrator": "ガブリエラ", "text": "まずは急ぎ、\n扉をコールするわね。"},
        { "location": "281/TALK"  , "narrator": "ガブリエラ", "text": "オープンプロセス、\n0x58F番地から\n0x224番地へ。"},
        { "location": "296/TALK"  , "narrator": "ガブリエラ", "text": "シーク完了っ♪"},
        { "location": "297/TALK"  , "narrator": "ガブリエラ", "text": "さあ！\n頑張ってクランを\n倒してちょうだい！"},
        { "location": "298/SEL"   , "narrator": "", "text": "ちょっとまって！"},
        { "location": "299/ACT"   , "narrator": "", "text": "ちょっとまって！"},
        { "location": "301/TALK"  , "narrator": "ガブリエラ", "text": "もうっ、何よ。\nじれったいわね。"},
        { "location": "302/SEL"   , "narrator": "", "text": "せめて説明だけでも聞かせて"},
        { "location": "303/ACT"   , "narrator": "", "text": "せめて説明だけでも聞かせて"},
        { "location": "305/TALK"  , "narrator": "ガブリエラ", "text": "え？"},
        { "location": "306/TALK"  , "narrator": "ガブリエラ", "text": "ああっ！\nそういえば\nそうだったわね。"},
        { "location": "307/TALK"  , "narrator": "ガブリエラ", "text": "今回のあたしの\nココロのもやもやは、\nズバリ！！"},
        { "location": "308/TALK"  , "narrator": "ガブリエラ", "text": "つばめに告白できない\n自分に対しての\n苛立ちなのよ！"},
        { "location": "309/SEL"   , "narrator": "", "text": "仲直りの告白？"},
        { "location": "310/SEL"   , "narrator": "", "text": "もしかして百合展開！？"},
        { "location": "311/ACT"   , "narrator": "", "text": "仲直りの告白？"},
        { "location": "312/TALK"  , "narrator": "ガブリエラ", "text": "そう！\nそうなのよ！"},
        { "location": "313/ACT"   , "narrator": "", "text": "もしかして百合展開！？"},
        { "location": "314/TALK"  , "narrator": "ガブリエラ", "text": "ち、違うわよ！！"},
        { "location": "315/TALK"  , "narrator": "ガブリエラ", "text": "つばめとお友達になる\nための大事な告白よ！"},
        { "location": "316/TALK"  , "narrator": "ガブリエラ", "text": "前から言ってるでしょ？"},
        { "location": "318/TALK"  , "narrator": "ガブリエラ", "text": "あたしがずっとずっと\nずーっと望んでいた\nこの展開！"},
        { "location": "319/TALK"  , "narrator": "ガブリエラ", "text": "今まではずっと意地張って\nきたけど、ついに罪悪感が\n上回ったのね。"},
        { "location": "320/TALK"  , "narrator": "ガブリエラ", "text": "ここまで来れば\nあと一押し！"},
        { "location": "321/TALK"  , "narrator": "ガブリエラ", "text": "言うことを阻止する、\nプライドの塊のような\nクランを倒すのよ！"},
        { "location": "322/SEL"   , "narrator": "", "text": "ガッテン姉貴！"},
        { "location": "323/SEL"   , "narrator": "", "text": "ほのかな百合を期待！"},
        { "location": "324/ACT"   , "narrator": "", "text": "ガッテン姉貴！"},
        { "location": "326/TALK"  , "narrator": "ガブリエラ", "text": "な、なんか今日は\nやけにノリがいいわね。"},
        { "location": "327/ACT"   , "narrator": "", "text": "ほのかな百合を期待！"},
        { "location": "329/TALK"  , "narrator": "ガブリエラ", "text": "百合とか無いから！"},
        { "location": "331/TALK"  , "narrator": "ガブリエラ", "text": "ほんと、\n“マルザンナ”は\n何を考えてるのかしら。"},
        { "location": "333/TALK"  , "narrator": "ガブリエラ", "text": "それじゃ、行くわよ！"},
        { "location": "334/TALK"  , "narrator": "ガブリエラ", "text": "あたしと\n$handle$にとって\n素敵なココロの旅を！"},
        { "location": "27/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>6月5日　7:15 PM</color>\n七夕祭りの後、寮「とらいあんぐる」ガブリエラの部屋前にて。"},
        { "location": "159/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"}
    ]
}
