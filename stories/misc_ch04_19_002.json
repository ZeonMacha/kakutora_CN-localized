    [
        { "location": "85/SCENARIO", "narrator": "", "text": "029_ねむたい木馬大作戦"},
        { "location": "112/TALK"   , "narrator": "みやび", "text": "トロイの木馬"},
        { "location": "113/TALK"   , "narrator": "みやび", "text": "知っておろう"},
        { "location": "115/SEL"    , "narrator": "", "text": "ギリシャ神話だよね"},
        { "location": "116/SEL"    , "narrator": "", "text": "マルウェアの"},
        { "location": "117/SEL"    , "narrator": "", "text": "木製のメリーゴーランド！"},
        { "location": "118/ACT"    , "narrator": "", "text": "ギリシャ神話だよね"},
        { "location": "119/TALK"   , "narrator": "みやび", "text": "確かに"},
        { "location": "120/TALK"   , "narrator": "みやび", "text": "語源はそれじゃの"},
        { "location": "121/ACT"    , "narrator": "", "text": "マルウェアの"},
        { "location": "122/TALK"   , "narrator": "みやび", "text": "そうそう"},
        { "location": "124/TALK"   , "narrator": "みやび", "text": "それそれ"},
        { "location": "125/ACT"    , "narrator": "", "text": "木製のメリーゴーランド！"},
        { "location": "127/TALK"   , "narrator": "みやび", "text": "まっことクラシックなタイプぞね"},
        { "location": "128/TALK"   , "narrator": "みやび", "text": "素晴らしい"},
        { "location": "130/TALK"   , "narrator": "みやび", "text": "まあ要は"},
        { "location": "131/TALK"   , "narrator": "みやび", "text": "偽装工作とかそういうのを指すわけだが"},
        { "location": "133/SEL"    , "narrator": "", "text": "偽装してるの？"},
        { "location": "134/SEL"    , "narrator": "", "text": "何か気になることがあるの？"},
        { "location": "135/ACT"    , "narrator": "", "text": "偽装してるの？"},
        { "location": "136/TALK"   , "narrator": "みやび", "text": "しとるといえばしとる"},
        { "location": "137/TALK"   , "narrator": "みやび", "text": "それは女子の嗜み"},
        { "location": "138/TALK"   , "narrator": "みやび", "text": "そういうものぞね"},
        { "location": "139/ACT"    , "narrator": "", "text": "何か気になることがあるの？"},
        { "location": "140/TALK"   , "narrator": "みやび", "text": "あるといえばある"},
        { "location": "141/TALK"   , "narrator": "みやび", "text": "しかし"},
        { "location": "142/TALK"   , "narrator": "みやび", "text": "気のせいだと思いたい"},
        { "location": "144/TALK"   , "narrator": "みやび", "text": "そういうことぞね"}
    ]
}
