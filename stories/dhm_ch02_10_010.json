        { "location": "32/TALK"   , "narrator": "アーヤ", "text": "方拭くね"},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "買った服ね"},
        { "location": "34/TALK"   , "narrator": "アーヤ", "text": "部屋で色々コーディネートしてみたわ"},
        { "location": "35/TALK"   , "narrator": "アーヤ", "text": "一通り"},
        { "location": "37/SEL"    , "narrator": "", "text": "もう満足した？"},
        { "location": "38/SEL"    , "narrator": "", "text": "着てみた感想は？"},
        { "location": "39/SEL"    , "narrator": "", "text": "虫食いと日焼けに注意"},
        { "location": "42/ACT"    , "narrator": "", "text": "もう満足した？"},
        { "location": "43/TALK"   , "narrator": "アーヤ", "text": "結構ね(￣Д￣ )"},
        { "location": "44/TALK"   , "narrator": "アーヤ", "text": "でも"},
        { "location": "45/TALK"   , "narrator": "アーヤ", "text": "着て出かけてないわ"},
        { "location": "46/TALK"   , "narrator": "アーヤ", "text": "お出かけしないと"},
        { "location": "47/TALK"   , "narrator": "アーヤ", "text": "お気に入りの組み合わせでね"},
        { "location": "48/ACT"    , "narrator": "", "text": "着てみた感想は？"},
        { "location": "49/TALK"   , "narrator": "アーヤ", "text": "いい幹事"},
        { "location": "50/TALK"   , "narrator": "アーヤ", "text": "感じ"},
        { "location": "51/TALK"   , "narrator": "アーヤ", "text": "でもどうせなら"},
        { "location": "52/TALK"   , "narrator": "アーヤ", "text": "新しいの欲しいわ"},
        { "location": "53/TALK"   , "narrator": "アーヤ", "text": "スカートとかジャケットとか"},
        { "location": "54/TALK"   , "narrator": "アーヤ", "text": "買いそびれたやつ"},
        { "location": "55/TALK"   , "narrator": "アーヤ", "text": "って"},
        { "location": "56/TALK"   , "narrator": "アーヤ", "text": "きりがないわね"},
        { "location": "57/TALK"   , "narrator": "アーヤ", "text": "我慢しなきゃ"},
        { "location": "58/ACT"    , "narrator": "", "text": "虫食いと日焼けに注意"},
        { "location": "60/TALK"   , "narrator": "アーヤ", "text": "あら"},
        { "location": "61/TALK"   , "narrator": "アーヤ", "text": "気を遣ってくれてるのね"},
        { "location": "62/TALK"   , "narrator": "アーヤ", "text": "でもそんなこと滅多にないから大丈夫よ"},
        { "location": "63/TALK"   , "narrator": "アーヤ", "text": "それより"},
        { "location": "64/TALK"   , "narrator": "アーヤ", "text": "心配なのは行方不明ね"},
        { "location": "65/TALK"   , "narrator": "アーヤ", "text": "クローゼットって魔窟＼(◎o◎)／"},
        { "location": "66/TALK"   , "narrator": "アーヤ", "text": "気を付けなくちゃ"}
