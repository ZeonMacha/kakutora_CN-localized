        "title": "スペシャルエピソード",
        "sub_title": "更衣室での秘め事"
    },
    "entry":
    [
        { "location": "27/TALK" , "narrator": "透明みやび", "text": "しっかし、アーヤは\nまっこと似合うなぁ…。"},
        { "location": "28/TALK" , "narrator": "透明アーヤ", "text": "そう？\nみんなだって、\nとっても素敵よ。"},
        { "location": "30/TALK" , "narrator": "透明つばめ", "text": "うぅ…でも、やっぱり\nちょっと恥ずかしいです。"},
        { "location": "31/TALK" , "narrator": "透明神楽", "text": "あ、またシャッター\nチャンスです！"},
        { "location": "36/TALK" , "narrator": "透明ガブリエラ", "text": "あ～、息苦しい…。\nあたし、ちょっと脱いで\nくるから。"},
        { "location": "37/TALK" , "narrator": "透明神楽", "text": "えっ？\nもう脱いじゃうんですか？"},
        { "location": "38/TALK" , "narrator": "透明ガブリエラ", "text": "本番でもないのに、\n長時間着てても\n疲れるだけでしょ？"},
        { "location": "39/TALK" , "narrator": "透明ガブリエラ", "text": "じゃ、お先に。"},
        { "location": "48/TALK" , "narrator": "透明ガブリエラ", "text": "…さて、と。"},
        { "location": "51/TALK" , "narrator": "透明ガブリエラ", "text": "えっと…、\nこの辺でどうかしら？"},
        { "location": "52/TALK" , "narrator": "透明ガブリエラ", "text": "…もうちょっと上？\nじゃ、これくらいで…。"},
        { "location": "53/TALK" , "narrator": "透明ガブリエラ", "text": "うわっ、胸見えちゃう！"},
        { "location": "55/TALK" , "narrator": "透明ガブリエラ", "text": "それじゃ…ここ！"},
        { "location": "62/TALK" , "narrator": "透明ガブリエラ", "text": "やった！\nナイスショット！"},
        { "location": "63/SEL"  , "narrator": "（選択肢）", "text": "自撮り？"},
        { "location": "64/ACT"  , "narrator": "", "text": "自撮り？"},
        { "location": "70/TALK" , "narrator": "透明ガブリエラ", "text": "きゃっ！？"},
        { "location": "72/TALK" , "narrator": "透明ガブリエラ", "text": "やだ、見られてた！？"},
        { "location": "76/TALK" , "narrator": "ガブリエラ", "text": "ダメじゃない$marzanna$！"},
        { "location": "77/TALK" , "narrator": "ガブリエラ", "text": "ここは試着室"},
        { "location": "78/TALK" , "narrator": "ガブリエラ", "text": "レディが着替えるところよ？"},
        { "location": "79/TALK" , "narrator": "ガブリエラ", "text": "カメラは切ってちょうだい"},
        { "location": "80/SEL"  , "narrator": "（選択肢）", "text": "着替えなさそうだったから…"},
        { "location": "81/ACT"  , "narrator": "", "text": "着替えなさそうだったから…"},
        { "location": "83/TALK" , "narrator": "ガブリエラ", "text": "着替えるわよ"},
        { "location": "84/TALK" , "narrator": "ガブリエラ", "text": "今は"},
        { "location": "85/TALK" , "narrator": "ガブリエラ", "text": "着替える準備してたの！"},
        { "location": "86/TALK" , "narrator": "ガブリエラ", "text": "わかるでしょ？"},
        { "location": "87/TALK" , "narrator": "ガブリエラ", "text": "レディは着替えにも手順が必要なのよ"},
        { "location": "88/SEL"  , "narrator": "（選択肢）", "text": "記録は必要だよね"},
        { "location": "89/ACT"  , "narrator": "", "text": "記録は必要だよね"},
        { "location": "92/TALK" , "narrator": "ガブリエラ", "text": "そう"},
        { "location": "93/TALK" , "narrator": "ガブリエラ", "text": "これは記録よ"},
        { "location": "94/TALK" , "narrator": "ガブリエラ", "text": "今度ウエディングドレス着る時の"},
        { "location": "95/TALK" , "narrator": "ガブリエラ", "text": "参考としての記録"},
        { "location": "96/TALK" , "narrator": "ガブリエラ", "text": "そういうことなのよ"},
        { "location": "100/TALK", "narrator": "ガブリエラ", "text": "でも"},
        { "location": "101/TALK", "narrator": "ガブリエラ", "text": "今撮った写真が役立つのって"},
        { "location": "102/TALK", "narrator": "ガブリエラ", "text": "いつなのかしら？"},
        { "location": "104/TALK", "narrator": "ガブリエラ", "text": "十年後"},
        { "location": "105/TALK", "narrator": "ガブリエラ", "text": "もしかしたら"},
        { "location": "106/TALK", "narrator": "ガブリエラ", "text": "二十年後とか？"},
        { "location": "107/SEL" , "narrator": "（選択肢）", "text": "わかったらつまらないよ"},
        { "location": "108/SEL" , "narrator": "（選択肢）", "text": "今から二人の式を挙げよう"},
        { "location": "109/ACT" , "narrator": "", "text": "わかったらつまらないよ"},
        { "location": "112/TALK", "narrator": "ガブリエラ", "text": "$marzanna$の言う通りね"},
        { "location": "113/TALK", "narrator": "ガブリエラ", "text": "自分がいつ結婚するか"},
        { "location": "114/TALK", "narrator": "ガブリエラ", "text": "そんなの"},
        { "location": "115/TALK", "narrator": "ガブリエラ", "text": "わかったら面白くないわ"},
        { "location": "117/TALK", "narrator": "ガブリエラ", "text": "きっと"},
        { "location": "118/TALK", "narrator": "ガブリエラ", "text": "ドキドキも"},
        { "location": "119/TALK", "narrator": "ガブリエラ", "text": "弱くなっちゃうし"},
        { "location": "120/ACT" , "narrator": "", "text": "今から二人の式を挙げよう"},
        { "location": "121/TALK", "narrator": "ガブリエラ", "text": "$marzanna$ってば"},
        { "location": "122/TALK", "narrator": "ガブリエラ", "text": "いくらなんでも強引過ぎ"},
        { "location": "123/TALK", "narrator": "ガブリエラ", "text": "第一"},
        { "location": "124/TALK", "narrator": "ガブリエラ", "text": "手順があるでしょ？"},
        { "location": "125/SEL" , "narrator": "（選択肢）", "text": "プロポーズからだね"},
        { "location": "126/SEL" , "narrator": "（選択肢）", "text": "キスくらいはしておかないと"},
        { "location": "127/ACT" , "narrator": "", "text": "プロポーズからだね"},
        { "location": "130/TALK", "narrator": "ガブリエラ", "text": "正解よ"},
        { "location": "132/TALK", "narrator": "ガブリエラ", "text": "やっぱりまずは"},
        { "location": "133/TALK", "narrator": "ガブリエラ", "text": "思い出に残るロマンチックなプロポーズ"},
        { "location": "134/TALK", "narrator": "ガブリエラ", "text": "これをしてくれないと"},
        { "location": "135/TALK", "narrator": "ガブリエラ", "text": "お嫁には行けないわ"},
        { "location": "136/TALK", "narrator": "ガブリエラ", "text": "私にプロポーズするなら"},
        { "location": "137/TALK", "narrator": "ガブリエラ", "text": "シチュエーションを大切にね"},
        { "location": "138/ACT" , "narrator": "", "text": "キスくらいはしておかないと"},
        { "location": "139/TALK", "narrator": "ガブリエラ", "text": "大ハズレね"},
        { "location": "140/TALK", "narrator": "ガブリエラ", "text": "もぅ"},
        { "location": "141/TALK", "narrator": "ガブリエラ", "text": "わからないなんて"},
        { "location": "142/TALK", "narrator": "ガブリエラ", "text": "私の執事失格よ"},
        { "location": "146/TALK", "narrator": "ガブリエラ", "text": "でも"},
        { "location": "147/TALK", "narrator": "ガブリエラ", "text": "またウエディングドレス"},
        { "location": "148/TALK", "narrator": "ガブリエラ", "text": "着れる日がきてほしい///////"},
        { "location": "149/TALK", "narrator": "ガブリエラ", "text": "できれば早く"},
        { "location": "150/TALK", "narrator": "ガブリエラ", "text": "でも"},
        { "location": "152/TALK", "narrator": "ガブリエラ", "text": "早過ぎないくらいで"},
        { "location": "153/SEL" , "narrator": "（選択肢）", "text": "言い忘れてた"},
        { "location": "154/SEL" , "narrator": "（選択肢）", "text": "その時はまた見せてね"},
        { "location": "155/ACT" , "narrator": "", "text": "言い忘れてた"},
        { "location": "156/TALK", "narrator": "ガブリエラ", "text": "なにを？"},
        { "location": "157/SEL" , "narrator": "（選択肢）", "text": "とっても素敵だよ"},
        { "location": "158/SEL" , "narrator": "（選択肢）", "text": "結婚してください"},
        { "location": "159/ACT" , "narrator": "", "text": "とっても素敵だよ"},
        { "location": "162/TALK", "narrator": "ガブリエラ", "text": "ありがとう"},
        { "location": "164/TALK", "narrator": "ガブリエラ", "text": "とっても嬉しいわ//////"},
        { "location": "165/ACT" , "narrator": "", "text": "結婚してください"},
        { "location": "167/TALK", "narrator": "ガブリエラ", "text": "試着室でプロポーズはちょっと"},
        { "location": "168/TALK", "narrator": "ガブリエラ", "text": "ムードを勉強して"},
        { "location": "169/TALK", "narrator": "ガブリエラ", "text": "出直してきなさい"},
        { "location": "171/ACT" , "narrator": "", "text": "その時はまた見せてね"},
        { "location": "174/TALK", "narrator": "ガブリエラ", "text": "ええ"},
        { "location": "176/TALK", "narrator": "ガブリエラ", "text": "だから自撮りのこと"},
        { "location": "177/TALK", "narrator": "ガブリエラ", "text": "みんなにはナイショよ？"}
    ]
}
