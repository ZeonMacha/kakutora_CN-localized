{
    "dir": "chap16/daydra/dd_ch04_16_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "16402",
        "cid": "miyabi",
        "title": "002 メインストーリー",
        "sub_title": "大混乱の大根役者＜前編＞"
    },
    "entry":
    [
        { "location": "36/TALK"   , "narrator": "みやび", "text": "…なかなか手強い\nシステムやな。"},
        { "location": "37/TALK"   , "narrator": "みやび", "text": "フェノメノンも\nセキュリティ対策\nしちょるとは。"},
        { "location": "38/TALK"   , "narrator": "みやび", "text": "ちっくとビックリな\n事実やね。"},
        { "location": "39/TALK"   , "narrator": "みやび", "text": "…光月さんの方に\n頼めたらえいんや\nけんど。"},
        { "location": "40/TALK"   , "narrator": "みやび", "text": "さすがに、これ以上\nディープな作業は\n無理やろうし…。"},
        { "location": "44/TALK"   , "narrator": "みやび", "text": "…みんな、\n上手くやっちょ\nろうかね？"},
        { "location": "45/TALK"   , "narrator": "みやび", "text": "アーヤ、そっちの方\n何か問題は起きちょ\nらん？"},
        { "location": "49/TALK"   , "narrator": "透明アーヤ", "text": "こちらアーヤ。\n今のところ順調よ。"},
        { "location": "50/TALK"   , "narrator": "みやび", "text": "了解や。"},
        { "location": "51/TALK"   , "narrator": "透明アーヤ", "text": "それで、ハッキングは\n上手くいきそう？"},
        { "location": "52/TALK"   , "narrator": "みやび", "text": "…もうちくっと\n時間かかりそうや。"},
        { "location": "53/TALK"   , "narrator": "みやび", "text": "思うてた以上に厳重で\nなかなか奥まで\n辿りつかんがよ。"},
        { "location": "54/TALK"   , "narrator": "透明アーヤ", "text": "了解…。\nでも、できれば\n急いで。"},
        { "location": "59/TALK"   , "narrator": "みやび", "text": "…順調とは\n言うちょったけど。"},
        { "location": "60/TALK"   , "narrator": "みやび", "text": "しんどそうな\n声やったな…。"},
        { "location": "61/TALK"   , "narrator": "みやび", "text": "…まあ、それは\nこっちも同じや\nけんど…。"},
        { "location": "65/TALK"   , "narrator": "みやび", "text": "…ダメや。\nやはりうちと光月さん\nだけじゃ追いつかん。"},
        { "location": "66/TALK"   , "narrator": "みやび", "text": "…………。"},
        { "location": "67/TALK"   , "narrator": "みやび", "text": "あいつに頼むしか\nなさそうやなぁ…。"},
        { "location": "82/TALK"   , "narrator": "繭", "text": "…予想はしてたけど、\n簡単な作業しか\nもらえない。"},
        { "location": "83/TALK"   , "narrator": "繭", "text": "やはり、みやび先輩は\nまだ私のこと……。"},
        { "location": "84/TALK"   , "narrator": "繭", "text": "素人レベルにしか\n思っていない、と\nいうことか…。"},
        { "location": "88/TALK"   , "narrator": "繭", "text": "クイーンからの\n呼び出し？\nこのタイミングで？"},
        { "location": "89/TALK"   , "narrator": "繭", "text": "…………。"},
        { "location": "90/TALK"   , "narrator": "繭", "text": "現在発生中の\nフェノメノンの解析の\n手伝い…。"},
        { "location": "91/TALK"   , "narrator": "繭", "text": "今、まさにその\n作業をしてるん\nだけどね。"},
        { "location": "92/TALK"   , "narrator": "繭", "text": "さすがのクイーンも\nわかるわけないか。"},
        { "location": "93/TALK"   , "narrator": "繭", "text": "了解。\n使用する回線を\n教えてください、と。"},
        { "location": "100/TALK"  , "narrator": "繭", "text": "…えっ？"},
        { "location": "101/TALK"  , "narrator": "繭", "text": "この回線って…、\n私とみやび先輩が\n繋げたもの…？"},
        { "location": "102/TALK"  , "narrator": "繭", "text": "まさか、この短時間で\nこの回線の存在に\n気づいたなんて…。"},
        { "location": "103/TALK"  , "narrator": "繭", "text": "…さすがですね、\nクイーン。"},
        { "location": "120/TALK"  , "narrator": "みやび", "text": "よし…ウサギが\n手伝ってくれるなら\nもう安心や。"},
        { "location": "121/TALK"  , "narrator": "みやび", "text": "これで作業が\n大幅にラクに\nなったがよ…。"},
        { "location": "122/SEL"   , "narrator": "", "text": "ずいぶん信頼してるね"},
        { "location": "123/ACT"   , "narrator": "", "text": "ずいぶん信頼してるね"},
        { "location": "130/TALK"  , "narrator": "みやび", "text": "当然"},
        { "location": "131/TALK"  , "narrator": "みやび", "text": "一番の理解者だぞ"},
        { "location": "132/TALK"  , "narrator": "みやび", "text": "多分オッサンだが"},
        { "location": "133/TALK"  , "narrator": "みやび", "text": "ウサギはな"},
        { "location": "134/TALK"  , "narrator": "みやび", "text": "管理庁に不信感を抱いたうちを"},
        { "location": "135/TALK"  , "narrator": "みやび", "text": "初めて理解してくれた存在なのだ"},
        { "location": "136/TALK"  , "narrator": "みやび", "text": "多分オッサンだが"},
        { "location": "137/TALK"  , "narrator": "みやび", "text": "それだけではない"},
        { "location": "138/TALK"  , "narrator": "みやび", "text": "管理庁にバレたら"},
        { "location": "139/TALK"  , "narrator": "みやび", "text": "一発逮捕＆国家反逆罪レベルのハッキングでも"},
        { "location": "140/TALK"  , "narrator": "みやび", "text": "躊躇なく実行する命知らず"},
        { "location": "141/TALK"  , "narrator": "みやび", "text": "超頼りになる"},
        { "location": "142/TALK"  , "narrator": "みやび", "text": "あいつがいなかったら"},
        { "location": "143/TALK"  , "narrator": "みやび", "text": "今のうちはないだろう"},
        { "location": "144/TALK"  , "narrator": "みやび", "text": "マジな話"},
        { "location": "146/SEL"   , "narrator": "", "text": "本人聞いたら喜びそう"},
        { "location": "147/ACT"   , "narrator": "", "text": "本人聞いたら喜びそう"},
        { "location": "149/TALK"  , "narrator": "みやび", "text": "言う必要はない"},
        { "location": "150/TALK"  , "narrator": "みやび", "text": "なぜなら"},
        { "location": "152/TALK"  , "narrator": "みやび", "text": "ツーカーの仲に"},
        { "location": "153/TALK"  , "narrator": "みやび", "text": "無駄な会話はいらん"},
        { "location": "154/TALK"  , "narrator": "みやび", "text": "よく覚えておくがよい"},
        { "location": "156/TALK"  , "narrator": "みやび", "text": "仕事に戻る"},
        { "location": "161/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "162/TALK"  , "narrator": "みやび", "text": "しかし、改めて\n考えてみると\nマズいかねえ？"},
        { "location": "163/TALK"  , "narrator": "みやび", "text": "ちっくと気を許し\n過ぎかもしれん。"},
        { "location": "164/TALK"  , "narrator": "みやび", "text": "…けんど、うちが\nトライナリーっ\nちゅう事実。"},
        { "location": "165/TALK"  , "narrator": "みやび", "text": "これが\nバレるようなヘマは\nしちょらんはずや。"},
        { "location": "166/TALK"  , "narrator": "みやび", "text": "自分が管理庁の下で\n働いちょる人間と\nバレるわけにはいかん。"},
        { "location": "167/TALK"  , "narrator": "みやび", "text": "バレたらウサギは\n間違いなくうちから\n去ってしまうちや…。"},
        { "location": "168/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "169/TALK"  , "narrator": "みやび", "text": "いや、いかん。\n今は任務中やき、\n作業に集中せんと。"},
        { "location": "170/TALK"  , "narrator": "みやび", "text": "…けんど、ウサギは\n勘がえいきね。"},
        { "location": "171/TALK"  , "narrator": "みやび", "text": "いずれは自分で\n気づく可能性は\nあるな…。"},
        { "location": "172/TALK"  , "narrator": "みやび", "text": "なら、そうなる前に、\nうちの方からバラして\nしまうか？"},
        { "location": "173/TALK"  , "narrator": "みやび", "text": "…いや、いやいや、\n身バレはハッカーの\n御法度や！"},
        { "location": "174/TALK"  , "narrator": "みやび", "text": "どうもウサギの\nことになると\n冷静になれんちや。"},
        { "location": "175/TALK"  , "narrator": "みやび", "text": "………………。"},
        { "location": "177/TALK"  , "narrator": "みやび", "text": "…ヤバい。\n作業に集中できん…。"},
        { "location": "225/TALK"  , "narrator": "みやび", "text": "　"},
        { "location": "241/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "261/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "264/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "267/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "271/SEL"   , "narrator": "", "text": "まだ寝てる！？"},
        { "location": "272/SEL"   , "narrator": "", "text": "もしかして死んでる！？"},
        { "location": "273/ACT"   , "narrator": "", "text": "まだ寝てる！？"},
        { "location": "276/TALK"  , "narrator": "みやび", "text": "クワッ！！"},
        { "location": "277/TALK"  , "narrator": "みやび", "text": "やーい\n騙されおった。"},
        { "location": "278/SEL"   , "narrator": "", "text": "……。"},
        { "location": "279/ACT"   , "narrator": "", "text": "……。"},
        { "location": "281/ACT"   , "narrator": "", "text": "もしかして死んでる！？"},
        { "location": "282/TALK"  , "narrator": "みやび", "text": "ゾンビ～～…。"},
        { "location": "283/TALK"  , "narrator": "みやび", "text": "お前さんを喰わせろ～…"},
        { "location": "284/SEL"   , "narrator": "", "text": "何やってるんすか！"},
        { "location": "285/SEL"   , "narrator": "", "text": "今から全裸になります！"},
        { "location": "286/ACT"   , "narrator": "", "text": "何やってるんすか！"},
        { "location": "287/TALK"  , "narrator": "みやび", "text": "たまにはこうやって\n遊ばんと、マンネリに\nなるやろ。"},
        { "location": "288/TALK"  , "narrator": "みやび", "text": "というわけで、\nゾンビなのは嘘やよ？"},
        { "location": "289/SEL"   , "narrator": "", "text": "わかってますって…"},
        { "location": "290/ACT"   , "narrator": "", "text": "わかってますって…"},
        { "location": "292/ACT"   , "narrator": "", "text": "今から全裸になります！"},
        { "location": "293/TALK"  , "narrator": "みやび", "text": "しまった…。\n相棒は変態さんやったの\n忘れちょったが。"},
        { "location": "295/TALK"  , "narrator": "みやび", "text": "忘れんように、これから\n相棒のことは変態って\n呼ぶことにするか。"},
        { "location": "298/TALK"  , "narrator": "みやび", "text": "さて$ht$。\nいよいよ今回から\nMKCCの活動を開始する。"},
        { "location": "299/SEL"   , "narrator": "", "text": "何でも略せばいいってモンじゃないよ"},
        { "location": "300/SEL"   , "narrator": "", "text": "MKCCって？"},
        { "location": "301/ACT"   , "narrator": "", "text": "何でも略せばいいってモンじゃないよ"},
        { "location": "304/TALK"  , "narrator": "みやび", "text": "ふむ。\nいきなりお小言か。"},
        { "location": "305/TALK"  , "narrator": "みやび", "text": "ならばよい。\n$ht$には何の略かは\n教えてやらん。"},
        { "location": "306/ACT"   , "narrator": "", "text": "MKCCって？"},
        { "location": "308/TALK"  , "narrator": "みやび", "text": "$ht$には教えてやらんと\n言うたはずやけんど？"},
        { "location": "309/TALK"  , "narrator": "みやび", "text": "けんど、１つだけ\nヒントをやろう。"},
        { "location": "310/TALK"  , "narrator": "みやび", "text": "最後のCは\nカンパニーのCぞね。"},
        { "location": "312/TALK"  , "narrator": "みやび", "text": "ズバリ！\nみやびココロクラック\nカンパニー。"},
        { "location": "315/SEL"   , "narrator": "", "text": "会社なんだ…"},
        { "location": "316/ACT"   , "narrator": "", "text": "会社なんだ…"},
        { "location": "318/TALK"  , "narrator": "みやび", "text": "うむ。\nよって資本金が\n必要である。"},
        { "location": "319/SEL"   , "narrator": "", "text": "出資するよ"},
        { "location": "320/SEL"   , "narrator": "", "text": "出資するよ"},
        { "location": "321/SEL"   , "narrator": "", "text": "出資するよ"},
        { "location": "322/SEL"   , "narrator": "", "text": "出資するよ"},
        { "location": "323/SEL"   , "narrator": "", "text": "出資しない"},
        { "location": "324/ACT"   , "narrator": "", "text": "出資するよ"},
        { "location": "327/ACT"   , "narrator": "", "text": "出資するよ"},
        { "location": "330/ACT"   , "narrator": "", "text": "出資するよ"},
        { "location": "333/ACT"   , "narrator": "", "text": "出資するよ"},
        { "location": "337/TALK"  , "narrator": "みやび", "text": "おお。\nなんという太っ腹。"},
        { "location": "338/TALK"  , "narrator": "みやび", "text": "$ht$のお陰で\nMKCCは\n活動を続けられる。"},
        { "location": "339/ACT"   , "narrator": "", "text": "出資しない"},
        { "location": "340/TALK"  , "narrator": "みやび", "text": "なんぞ。\nけちくさい$ht$や。"},
        { "location": "343/TALK"  , "narrator": "みやび", "text": "さて、そんなわけで、\n早速$ht$には\n任務を与えるぞね。"},
        { "location": "344/SEL"   , "narrator": "", "text": "承知しました"},
        { "location": "345/SEL"   , "narrator": "", "text": "みやびは何もしないの？"},
        { "location": "346/ACT"   , "narrator": "", "text": "承知しました"},
        { "location": "347/TALK"  , "narrator": "みやび", "text": "うむ。\n「承知しました」とは。\nまっことえい響きやね。"},
        { "location": "348/ACT"   , "narrator": "", "text": "みやびは何もしないの？"},
        { "location": "349/TALK"  , "narrator": "みやび", "text": "もちろんやるがね。\nしかし、まずは部下に\n指示出しをせんと。"},
        { "location": "351/TALK"  , "narrator": "みやび", "text": "さて$ht$君。\n早速任務の話やけんど、\n君は知っているかね。"},
        { "location": "352/TALK"  , "narrator": "みやび", "text": "つばめちゃんの\nココロの司書が\n更迭されたそうや。"},
        { "location": "353/SEL"   , "narrator": "", "text": "知ってる"},
        { "location": "354/SEL"   , "narrator": "", "text": "知らなかった"},
        { "location": "355/ACT"   , "narrator": "", "text": "知ってる"},
        { "location": "356/TALK"  , "narrator": "みやび", "text": "ふむ。\nならば話は早い。"},
        { "location": "357/ACT"   , "narrator": "", "text": "知らなかった"},
        { "location": "358/TALK"  , "narrator": "みやび", "text": "情弱やね。"},
        { "location": "360/TALK"  , "narrator": "みやび", "text": "そもそも司書の更迭とは\nどういった事なのか。"},
        { "location": "361/TALK"  , "narrator": "みやび", "text": "そんな話は\n聞いたことがない。"},
        { "location": "362/TALK"  , "narrator": "みやび", "text": "だいたいあれよ、\nうちが前に言ったとおり、\n司書は閑職や。"},
        { "location": "363/TALK"  , "narrator": "みやび", "text": "その司書が更迭となれば、\n次はどこへ行く？\n行き場なぞないんよ。"},
        { "location": "364/SEL"   , "narrator": "", "text": "それじゃつばめの司書は…"},
        { "location": "365/ACT"   , "narrator": "", "text": "それじゃつばめの司書は…"},
        { "location": "367/TALK"  , "narrator": "みやび", "text": "うむ。\n既にこの世には\nいないかもしれんね。"},
        { "location": "368/SEL"   , "narrator": "", "text": "そんな…"},
        { "location": "369/ACT"   , "narrator": "", "text": "そんな…"},
        { "location": "371/TALK"  , "narrator": "みやび", "text": "まあ実際はどうなったかは\n調べてみん事には\nわからんけんど。"},
        { "location": "372/TALK"  , "narrator": "みやび", "text": "そしてうちは\nクラッカーや。"},
        { "location": "373/TALK"  , "narrator": "みやび", "text": "うちが本気を出せば、\nつばめちゃんの司書の\nその後調査など楽勝。"},
        { "location": "374/TALK"  , "narrator": "みやび", "text": "そしてそれを調べることは\n本来の目的である、うちの\nココロクラックに役立つ。"},
        { "location": "375/SEL"   , "narrator": "", "text": "それじゃ早速調べよう"},
        { "location": "376/SEL"   , "narrator": "", "text": "なんで役にたつの？"},
        { "location": "377/ACT"   , "narrator": "", "text": "それじゃ早速調べよう"},
        { "location": "378/TALK"  , "narrator": "みやび", "text": "うむ。"},
        { "location": "379/ACT"   , "narrator": "", "text": "なんで役にたつの？"},
        { "location": "381/TALK"  , "narrator": "みやび", "text": "えい質問やね。"},
        { "location": "382/TALK"  , "narrator": "みやび", "text": "もしつばめちゃんの司書が\n目に見えるところに存在\nしなくなっている場合――"},
        { "location": "383/TALK"  , "narrator": "みやび", "text": "目に見えないところ、\nすなわち「閉架」された\nココロにいるやもしれん。"},
        { "location": "384/TALK"  , "narrator": "みやび", "text": "それを見つけるっちゅう\nことは、つまり……。"},
        { "location": "385/SEL"   , "narrator": "", "text": "閉架書庫のデータが取れる？"},
        { "location": "386/ACT"   , "narrator": "", "text": "閉架書庫のデータが取れる？"},
        { "location": "388/TALK"  , "narrator": "みやび", "text": "その通りや！\n$ht$賢いな。\n惚れてしまいそうや。"},
        { "location": "390/TALK"  , "narrator": "みやび", "text": "けんど、その為には\n１つ材料が必要ぞね。"},
        { "location": "391/TALK"  , "narrator": "みやび", "text": "そんで、それを\n$ht$に調達してきて\nもらいたいんよ。"},
        { "location": "392/SEL"   , "narrator": "", "text": "何でしょう"},
        { "location": "393/ACT"   , "narrator": "", "text": "何でしょう"},
        { "location": "395/TALK"  , "narrator": "みやび", "text": "それは、つばめちゃんの\nココロの司書の名前や。"},
        { "location": "396/SEL"   , "narrator": "", "text": "あーそれなら知ってる"},
        { "location": "397/SEL"   , "narrator": "", "text": "名前を調べてくればいいの？"},
        { "location": "398/ACT"   , "narrator": "", "text": "あーそれなら知ってる"},
        { "location": "400/TALK"  , "narrator": "みやび", "text": "待ちぃや！"},
        { "location": "401/TALK"  , "narrator": "みやび", "text": "その名前が何なのかは\n次回聞くことにする。"},
        { "location": "402/TALK"  , "narrator": "みやび", "text": "今その名を聞くことは\nとても危険やきね。"},
        { "location": "403/SEL"   , "narrator": "", "text": "なんで！？"},
        { "location": "404/ACT"   , "narrator": "", "text": "なんで！？"},
        { "location": "406/TALK"  , "narrator": "みやび", "text": "うむ。それは――"},
        { "location": "407/TALK"  , "narrator": "みやび", "text": "たった今、\nMKCCの就業時間が\n終わったからや！"},
        { "location": "408/TALK"  , "narrator": "みやび", "text": "これ以上働くと\n残業になってまうぞね！"},
        { "location": "409/SEL"   , "narrator": "", "text": "残業…ですか"},
        { "location": "410/ACT"   , "narrator": "", "text": "残業…ですか"},
        { "location": "412/TALK"  , "narrator": "みやび", "text": "うちは残業は嫌や。\n更に、お前さんにも\n残業代払わんといかん。"},
        { "location": "413/TALK"  , "narrator": "みやび", "text": "よって、おそるべき\nLOSE-LOSE！"},
        { "location": "414/TALK"  , "narrator": "みやび", "text": "やき、名前は\n次回聞くことにするぞね。"},
        { "location": "415/SEL"   , "narrator": "", "text": "なんてホワイトな活動！"},
        { "location": "416/SEL"   , "narrator": "", "text": "まだ全然働いてないですよね？"},
        { "location": "417/ACT"   , "narrator": "", "text": "なんてホワイトな活動！"},
        { "location": "418/TALK"  , "narrator": "みやび", "text": "うむ。うちの秘密結社\nMKCCは、法定時間を守る\n優良結社やきね。"},
        { "location": "419/TALK"  , "narrator": "みやび", "text": "そんなわけで、\n今日はおしまいや。"},
        { "location": "420/ACT"   , "narrator": "", "text": "まだ全然働いてないですよね？"},
        { "location": "421/TALK"  , "narrator": "みやび", "text": "そこを批判するとは、\nおのれブラック結社員め！"},
        { "location": "422/SEL"   , "narrator": "", "text": "社員がブラックなの！？"},
        { "location": "423/ACT"   , "narrator": "", "text": "社員がブラックなの！？"},
        { "location": "425/TALK"  , "narrator": "みやび", "text": "上司（うち）に\n残業させるとは、\nブラックもいいとこや。"},
        { "location": "426/TALK"  , "narrator": "みやび", "text": "とにかく、今日は\nもうお終いぞね。"},
        { "location": "428/ACT"   , "narrator": "", "text": "名前を調べてくればいいの？"},
        { "location": "429/TALK"  , "narrator": "みやび", "text": "その通りや。\n簡単なお仕事やろ？"},
        { "location": "430/TALK"  , "narrator": "みやび", "text": "次回ここに来る時までに\nしっかり調べときや。"},
        { "location": "431/TALK"  , "narrator": "みやび", "text": "そんなわけで、\n今日はおしまいや。"},
        { "location": "433/TALK"  , "narrator": "みやび", "text": "ほんだら、またな。"},
        { "location": "434/SEL"   , "narrator": "", "text": "ちょっと待て！"},
        { "location": "435/ACT"   , "narrator": "", "text": "ちょっと待て！"},
        { "location": "437/TALK"  , "narrator": "みやび", "text": "なんぞ。\n早速賃上げ要求か？"},
        { "location": "438/SEL"   , "narrator": "", "text": "クラン倒さなくていいの？"},
        { "location": "439/ACT"   , "narrator": "", "text": "クラン倒さなくていいの？"},
        { "location": "441/TALK"  , "narrator": "みやび", "text": "クラン…？"},
        { "location": "442/TALK"  , "narrator": "みやび", "text": "おお、そうか！\nつい本業に夢中になって、\n本業を忘れておったぞね。"},
        { "location": "443/TALK"  , "narrator": "みやび", "text": "ほんだらサッと\nやってまうか。"},
        { "location": "446/TALK"  , "narrator": "みやび", "text": "オープンプロセス、\n0x112番地から\n0xB4F番地へ。"},
        { "location": "468/TALK"  , "narrator": "みやび", "text": "完了。"},
        { "location": "471/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "472/TALK"  , "narrator": "みやび", "text": "うちのココロの\n雑念の元になっちゅう\nクランを倒しや。"},
        { "location": "473/TALK"  , "narrator": "みやび", "text": "以上！\nほんだらいくぞね！"},
        { "location": "474/SEL"   , "narrator": "", "text": "早っ！"},
        { "location": "475/ACT"   , "narrator": "", "text": "早っ！"},
        { "location": "477/TALK"  , "narrator": "みやび", "text": "それ以上に語ることも\nないきね。"},
        { "location": "478/TALK"  , "narrator": "みやび", "text": "それより早く切り上げて、\nアフター５を楽しむちや。"},
        { "location": "480/TALK"  , "narrator": "みやび", "text": "うちと$handle$に\nえいココロの旅を。"},
        { "location": "15/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>7月24日　5:56 PM</color>\n豊洲で発生したフェノメノン戦の最中、劇場内にて。"},
        { "location": "190/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "192/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "194/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "196/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "198/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"},
