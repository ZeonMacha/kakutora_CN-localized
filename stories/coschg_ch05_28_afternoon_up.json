        { "location": "469/ACT" , "narrator": "", "text": "$handle$だよ"},
        { "location": "471/TALK", "narrator": "神楽", "text": "知ってるし"},
        { "location": "472/TALK", "narrator": "神楽", "text": "ぴょんこに用事ぴょん？"},
        { "location": "475/SEL" , "narrator": "", "text": "ちょっと着替えてほしいんだ"},
        { "location": "476/ACT" , "narrator": "", "text": "ちょっと着替えてほしいんだ"},
        { "location": "486/TALK", "narrator": "神楽", "text": "意味不明すぎ"},
        { "location": "487/TALK", "narrator": "神楽", "text": "でもまあ"},
        { "location": "488/TALK", "narrator": "神楽", "text": "優しいぴょんこは聞いてあげるのだった"},
        { "location": "490/TALK", "narrator": "神楽", "text": "は？"},
        { "location": "491/TALK", "narrator": "神楽", "text": "この服変だった？"},
        { "location": "492/TALK", "narrator": "神楽", "text": "なら着替えるけど"},
        { "location": "495/SEL" , "narrator": "", "text": "$me$が選ぶ"},
        { "location": "496/SEL" , "narrator": "", "text": "やっぱやめる"},
        { "location": "498/TALK", "narrator": "神楽", "text": "…………"},
        { "location": "501/TALK", "narrator": "神楽", "text": "リクエストないとか？"},
