        { "location": "448/TALK", "narrator": "プレイヤー", "text": "お着替えしてみよう"},
        { "location": "450/TALK", "narrator": "プレイヤー", "text": "違う服を着てほしいな"},
        { "location": "452/TALK", "narrator": "プレイヤー", "text": "よし、お着替えタイムだ！"},
        { "location": "458/TALK", "narrator": "プレイヤー", "text": "やあ"},
        { "location": "460/TALK", "narrator": "プレイヤー", "text": "こんにちは"},
        { "location": "462/TALK", "narrator": "プレイヤー", "text": "げんき？"},
        { "location": "465/TALK", "narrator": "神楽", "text": "ぴょんこを呼ぶ声"},
        { "location": "466/TALK", "narrator": "神楽", "text": "あなたはだあれ？"},
