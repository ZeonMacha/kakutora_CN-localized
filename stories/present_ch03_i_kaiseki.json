        { "location": "169/TALK", "narrator": "ガブリエラ", "text": "懐石料理って、料理の芸術品よね"},
        { "location": "171/TALK", "narrator": "ガブリエラ", "text": "食べるのに、ちょっと罪悪感を覚えるわ"},
        { "location": "174/SEL" , "narrator": "", "text": "食べるのが礼儀だよ"},
        { "location": "175/ACT" , "narrator": "", "text": "食べるのが礼儀だよ"},
        { "location": "178/TALK", "narrator": "ガブリエラ", "text": "そういうところ、日本人って凄いわ"},
        { "location": "179/TALK", "narrator": "ガブリエラ", "text": "私みたいに、懐石料理を前にしてなかなか食べられない人って"},
        { "location": "180/TALK", "narrator": "ガブリエラ", "text": "結構多いと思うのに"},
        { "location": "181/TALK", "narrator": "ガブリエラ", "text": "日本の料理って、どうしてこんなに美しい物ばかりなの？"},
        { "location": "184/SEL" , "narrator": "", "text": "君は闇を知らない"},
        { "location": "185/ACT" , "narrator": "", "text": "君は闇を知らない"},
        { "location": "188/TALK", "narrator": "ガブリエラ", "text": "闇？"},
        { "location": "189/TALK", "narrator": "ガブリエラ", "text": "日本料理に闇なんてあるの？"},
        { "location": "190/TALK", "narrator": "ガブリエラ", "text": "でも、それもいつか見てみたいわね"},
        { "location": "191/TALK", "narrator": "ガブリエラ", "text": "きっと、凄く美しい闇なんでしょうね"}
    ]
