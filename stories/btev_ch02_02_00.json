        "title": "001 ココロスフィアストーリー【Lv01】",
        "sub_title": "己の敵は己＜提起＞"
    },
    "entry":
    [
        { "location": "5/SCENARIO", "narrator": "", "text": "バトル導入"},
        { "location": "29/TALK"   , "narrator": "千羽鶴", "text": "ようこそ。\nここは國政綾水の\n精神世界――"},
        { "location": "30/TALK"   , "narrator": "千羽鶴", "text": "通称<color=red>【[ココロスフィア]】</color>\nと呼ばれている場所。"},
        { "location": "31/TALK"   , "narrator": "千羽鶴", "text": "ここでは彼女は\nあなたと普通に\n対話できる。"},
        { "location": "32/TALK"   , "narrator": "千羽鶴", "text": "彼女の心に直接\n語りかけることで、\n心を動かすの。"},
        { "location": "33/TALK"   , "narrator": "千羽鶴", "text": "早速、彼女を呼んで\n対話をしてみましょ。"},
        { "location": "42/DIALOG" , "narrator": "", "text": "<size=40>KOKORO-Lv. 01</size>\nAYAMI - KUNIMASA\n\n<size=45>己の敵は己</size>\n<size=35>～アンヴィバレンツ～</size>"},
        { "location": "51/TALK"   , "narrator": "潜在アーヤ", "text": "――だから、\n私はホントに\nそれでいいの？"},
        { "location": "52/TALK"   , "narrator": "表層アーヤ", "text": "良くは無いけど、\nそんなこと言ってる\n場合じゃないでしょ！"},
        { "location": "53/TALK"   , "narrator": "潜在アーヤ", "text": "はぁぁ、これは\n埒が明かないわ。"},
        { "location": "55/SEL"    , "narrator": "（選択肢）", "text": "あのー"},
        { "location": "56/TALK"   , "narrator": "表層アーヤ", "text": "こればかりは\n絶対に折れないから。"},
        { "location": "57/TALK"   , "narrator": "潜在アーヤ", "text": "ほんとに？\nめちゃダサイわよ？"},
        { "location": "58/TALK"   , "narrator": "表層アーヤ", "text": "…っ……"},
        { "location": "59/TALK"   , "narrator": "潜在アーヤ", "text": "これからも同じ事を\n繰り返せば、社会的に\n抹消されることも……"},
        { "location": "60/TALK"   , "narrator": "表層アーヤ", "text": "……それは…　…"},
        { "location": "61/ACT"    , "narrator": "", "text": "あのー"},
        { "location": "68/TALK"   , "narrator": "表層アーヤ", "text": "え？"},
        { "location": "69/TALK"   , "narrator": "表層アーヤ", "text": "ちょっと貴方\nだれ！？"},
        { "location": "70/TALK"   , "narrator": "表層アーヤ", "text": "勝手に人のココロの\n中に入ってこないで！"},
        { "location": "72/TALK"   , "narrator": "潜在アーヤ", "text": "え？　いいじゃない。\n何か面白そうだし。\nそれに――"},
        { "location": "74/TALK"   , "narrator": "潜在アーヤ", "text": "ちょっとだけ\n素敵な出逢いの\nオーラを感じない？"},
        { "location": "76/TALK"   , "narrator": "表層アーヤ", "text": "は？\n何言ってるの私！"},
        { "location": "77/TALK"   , "narrator": "表層アーヤ", "text": "私たちにとって害悪\nかもしれないのよ？\nこの人！"},
        { "location": "80/TALK"   , "narrator": "潜在アーヤ", "text": "え？　そうかしら。\n私はそうは思わないわ。"},
        { "location": "83/TALK"   , "narrator": "潜在アーヤ", "text": "…えと、お名前、\n教えて頂けますか？"},
        { "location": "84/SEL"    , "narrator": "（選択肢）", "text": "$handle$です！（キリッ"},
        { "location": "85/SEL"    , "narrator": "（選択肢）", "text": "あ、$handle$です…けど……"},
        { "location": "86/ACT"    , "narrator": "", "text": "$handle$です！（キリッ"},
        { "location": "92/DIALOG" , "narrator": "", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"},
        { "location": "96/TALK"   , "narrator": "潜在アーヤ", "text": "$handle$さんね。\n素敵な名前。"},
        { "location": "97/ACT"    , "narrator": "", "text": "あ、$handle$です…けど……"},
        { "location": "98/TALK"   , "narrator": "潜在アーヤ", "text": "$handle$さんね。\nちょっと緊張してる？\n可愛い♪"},
        { "location": "100/TALK"  , "narrator": "潜在アーヤ", "text": "あの、良ければ\n今から一緒に\nお茶でもしませんか？"},
        { "location": "101/SEL"   , "narrator": "（選択肢）", "text": "是非！"},
        { "location": "102/SEL"   , "narrator": "（選択肢）", "text": "いや、それよりも……"},
        { "location": "103/ACT"   , "narrator": "", "text": "是非！"},
        { "location": "104/ACT"   , "narrator": "", "text": "いや、それよりも……"},
        { "location": "106/TALK"  , "narrator": "表層アーヤ", "text": "ちょっと！！\nそんなことやってる\n場合じゃないでしょ！"},
        { "location": "109/TALK"  , "narrator": "表層アーヤ", "text": "だいたい\n貴方何者なのよ！"},
        { "location": "110/SEL"   , "narrator": "（選択肢）", "text": "アーヤのココロを助けに来た者です"},
        { "location": "111/ACT"   , "narrator": "", "text": "アーヤのココロを助けに来た者です"},
        { "location": "113/TALK"  , "narrator": "表層アーヤ", "text": "え？\nココロを助けに…？"},
        { "location": "114/SEL"   , "narrator": "（選択肢）", "text": "アーヤって、結構悩みが多いよね"},
        { "location": "115/ACT"   , "narrator": "", "text": "アーヤって、結構悩みが多いよね"},
        { "location": "117/TALK"  , "narrator": "表層アーヤ", "text": "そうなのよ！\n今、私と――"},
        { "location": "119/TALK"  , "narrator": "潜在アーヤ", "text": "―私が言い争ってるのも\nその一つだし。"},
        { "location": "120/SEL"   , "narrator": "（選択肢）", "text": "今は何を争ってるの？"},
        { "location": "121/ACT"   , "narrator": "", "text": "今は何を争ってるの？"},
        { "location": "123/TALK"  , "narrator": "潜在アーヤ", "text": "任務のために、どんだけ\n自分が恥ずかしい思いを\nしなくちゃいけないのか。"},
        { "location": "124/TALK"  , "narrator": "潜在アーヤ", "text": "この間だって、貴方も\n見てたでしょ？\n電車から飛び降りたの。"},
        { "location": "125/TALK"  , "narrator": "潜在アーヤ", "text": "あの時の乗客の白い目。\n今思い出しても\n自殺したくなるわ。"},
        { "location": "126/TALK"  , "narrator": "潜在アーヤ", "text": "いくら任務優先ったって\n私にだって\n人生があるんだから！"},
        { "location": "128/TALK"  , "narrator": "表層アーヤ", "text": "そんな個人的なことと、\nトライナリーという社会的\n責務を天秤になんて――"},
        { "location": "130/TALK"  , "narrator": "潜在アーヤ", "text": "天秤にかけて当然よ！\nトライナリー以前に\n普通の女なんだから！"},
        { "location": "131/TALK"  , "narrator": "潜在アーヤ", "text": "だいたい、そこの私、\nあんなド田舎から上京した\n本当の理由、忘れたの？"},
        { "location": "132/TALK"  , "narrator": "表層アーヤ", "text": "は！？　何それ。\nそんなの日本を\n護る為に……"},
        { "location": "133/TALK"  , "narrator": "潜在アーヤ", "text": "それ、建前じゃない。\n本当は――"},
        { "location": "134/TALK"  , "narrator": "表層アーヤ", "text": "やあああああああああ\nああああああああああ\nああああああああっ！"},
        { "location": "135/TALK"  , "narrator": "表層アーヤ", "text": "倒す！\n消えて！！"},
        { "location": "136/TALK"  , "narrator": "表層アーヤ", "text": "本音とか建て前とか\nどうでもいいの！"},
        { "location": "137/TALK"  , "narrator": "表層アーヤ", "text": "それより私は、\nどんな事があろうとも、\n出動しなくちゃ――"},
        { "location": "138/TALK"  , "narrator": "表層アーヤ", "text": "他の子たちだけに\n任せておくなんて、\n私には出来ないもの！"},
        { "location": "139/TALK"  , "narrator": "潜在アーヤ", "text": "大した責任感ね。"},
        { "location": "140/TALK"  , "narrator": "潜在アーヤ", "text": "でも、その本質が\n何なのか知ったら\n泣いちゃうわよ。"},
        { "location": "141/TALK"  , "narrator": "表層アーヤ", "text": "うるさいわね！\nで、どうするのよ。\n勝負するの？"},
        { "location": "142/TALK"  , "narrator": "潜在アーヤ", "text": "いいわよ。\n確かに決着つけて\nおいた方がいいかも。"},
        { "location": "143/TALK"  , "narrator": "潜在アーヤ", "text": "このままだと現実の私が\n一生この件で悩んで、\n人生を棒に振りそうだし。"},
        { "location": "144/TALK"  , "narrator": "表層アーヤ", "text": "……そうね。"},
        { "location": "145/TALK"  , "narrator": "表層アーヤ", "text": "貴方は……"},
        { "location": "146/TALK"  , "narrator": "表層アーヤ", "text": "助けに来たっていう\nけどどっちを助けて\nくれるのかしら？"},
        { "location": "147/SEL"   , "narrator": "（選択肢）", "text": "責任感の強いアーヤ"},
        { "location": "148/SEL"   , "narrator": "（選択肢）", "text": "自分を大事にするアーヤ"},
        { "location": "149/ACT"   , "narrator": "", "text": "責任感の強いアーヤ"},
        { "location": "152/TALK"  , "narrator": "潜在アーヤ", "text": "あら、残念。\nそれじゃ私は敵ね。"},
        { "location": "153/TALK"  , "narrator": "潜在アーヤ", "text": "でも……"},
        { "location": "156/TALK"  , "narrator": "潜在アーヤ", "text": "もし私が勝ったら、\n今度一度、お食事\nご一緒してくれません？"},
        { "location": "159/TALK"  , "narrator": "表層アーヤ", "text": "こらああっ！"},
        { "location": "162/TALK"  , "narrator": "潜在アーヤ", "text": "あら、怖い怖い。"},
        { "location": "164/TALK"  , "narrator": "潜在アーヤ", "text": "このままここにいると\n責任感の強い私に\n消されちゃうから――"},
        { "location": "166/TALK"  , "narrator": "潜在アーヤ", "text": "準備してくるわ。\n首を洗って\n待ってなさい。"},
        { "location": "170/TALK"  , "narrator": "表層アーヤ", "text": "あ、あの！"},
        { "location": "172/TALK"  , "narrator": "表層アーヤ", "text": "私に支援してくれて\nありがとう。"},
        { "location": "173/TALK"  , "narrator": "表層アーヤ", "text": "バトルではどうか、\n宜しくお願いします。"},
        { "location": "174/TALK"  , "narrator": "表層アーヤ", "text": "それと……"},
        { "location": "175/TALK"  , "narrator": "表層アーヤ", "text": "さっきあの私が\n言ったこと……"},
        { "location": "176/TALK"  , "narrator": "表層アーヤ", "text": "全部、\n忘れてください！"},
        { "location": "178/TALK"  , "narrator": "表層アーヤ", "text": "あんなの！\n全部ウソだし！"},
        { "location": "179/SEL"   , "narrator": "（選択肢）", "text": "まあ、そういう事にしておきますね"},
        { "location": "180/ACT"   , "narrator": "", "text": "まあ、そういう事にしておきますね"},
        { "location": "182/TALK"  , "narrator": "表層アーヤ", "text": "ほ、ほんとに\nほんとだってば！"},
        { "location": "183/TALK"  , "narrator": "表層アーヤ", "text": "さあ、早く行って\nちゃっちゃと\n倒しちゃいましょ！"},
        { "location": "193/TALK"  , "narrator": "潜在アーヤ", "text": "ホントに\nいいのね？"},
        { "location": "195/TALK"  , "narrator": "表層アーヤ", "text": "ええ。　　　"},
        { "location": "196/TALK"  , "narrator": "潜在アーヤ", "text": "これからも、周りから\n白い目を受けながら\n生きていく事になる。"},
        { "location": "197/TALK"  , "narrator": "表層アーヤ", "text": "それでも\nやらなくちゃ。"},
        { "location": "198/TALK"  , "narrator": "潜在アーヤ", "text": "はぁ。　　　　"},
        { "location": "199/TALK"  , "narrator": "潜在アーヤ", "text": "本当に不器用な私。"},
        { "location": "200/TALK"  , "narrator": "潜在アーヤ", "text": "それもこれも\n全部全部ぜーんぶっ！"},
        { "location": "201/TALK"  , "narrator": "潜在アーヤ", "text": "貴方のような\nバカ正直で真面目な\nカタブツがいるから！"},
        { "location": "202/TALK"  , "narrator": "潜在アーヤ", "text": "いい機会だから、\n貴方を倒して\n力を弱めてあげるわ。"},
        { "location": "203/TALK"  , "narrator": "潜在アーヤ", "text": "そして、これからは\nもっともっと\n楽に生きるんだから！"},
        { "location": "215/DIALOG", "narrator": "", "text": "<color=black><size=50><b>体裁を気にする\nアーヤを排除せよ！</b></size></color>\n\n\n\n東京を守る任務、トライナリー。\nそれを確実に遂行する為には\n個という自分を捨てる必要がある。\n\nそれができなければ、\nいずれその躊躇が重大な状況を\n生んでしまうかもしれない。\n\nトライナリーとしての責務を果たすため、\nちゃらちゃらしたアーヤを排除しよう！"},
        { "location": "216/ACT"   , "narrator": "", "text": "自分を大事にするアーヤ"},
        { "location": "219/TALK"  , "narrator": "表層アーヤ", "text": "そんな！\nそれじゃ任務に対する\n責任が取れない！"},
        { "location": "221/TALK"  , "narrator": "潜在アーヤ", "text": "別に任務をおろそかに\nするなんて、一言も\n言ってないでしょ？"},
        { "location": "222/TALK"  , "narrator": "潜在アーヤ", "text": "単に、いつも恥ずかしい\n思いをしてまで献身的に\n活動しなくてもってだけ。"},
        { "location": "224/TALK"  , "narrator": "表層アーヤ", "text": "そんなんじゃ、全然\n任務を全うすること\nなんて――！！"},
        { "location": "225/TALK"  , "narrator": "潜在アーヤ", "text": "はいはい、そこまで。\n続きは拳で語りましょ。"},
        { "location": "226/TALK"  , "narrator": "潜在アーヤ", "text": "心の中のバトルでは、\n想いが強い方が勝つ。\n文句ないはずよ？"},
        { "location": "228/TALK"  , "narrator": "表層アーヤ", "text": "……わかりました。\nいいでしょう。\n準備してきます。"},
        { "location": "230/TALK"  , "narrator": "潜在アーヤ", "text": "ふふ。　　　　"},
        { "location": "232/TALK"  , "narrator": "潜在アーヤ", "text": "私に支援してくれて\nありがとう。"},
        { "location": "233/TALK"  , "narrator": "潜在アーヤ", "text": "バトルではどうか、\n宜しくお願いね？"},
        { "location": "234/TALK"  , "narrator": "潜在アーヤ", "text": "それと……"},
        { "location": "235/TALK"  , "narrator": "潜在アーヤ", "text": "私たちが勝ったら、\n後で思いっきりデート\n楽しみましょうね♪"},
        { "location": "236/SEL"   , "narrator": "（選択肢）", "text": "頑張ります！"},
        { "location": "237/ACT"   , "narrator": "", "text": "頑張ります！"},
        { "location": "239/TALK"  , "narrator": "潜在アーヤ", "text": "素敵♪　　　　"},
        { "location": "240/TALK"  , "narrator": "潜在アーヤ", "text": "期待してるわね。"},
        { "location": "251/TALK"  , "narrator": "表層アーヤ", "text": "ホントに\nいいのね？"},
        { "location": "253/TALK"  , "narrator": "潜在アーヤ", "text": "もちろん。"},
        { "location": "254/TALK"  , "narrator": "表層アーヤ", "text": "これでもし、私が妥協\nしたことで東京が大惨事に\n見舞われたりしたら――"},
        { "location": "255/TALK"  , "narrator": "表層アーヤ", "text": "私たち、一生後悔\nする事になるわよ。"},
        { "location": "256/TALK"  , "narrator": "潜在アーヤ", "text": "公衆の面前で次はどんな\n羞恥プレイをするのか\n怯えて生きるよりマシよ。"},
        { "location": "257/TALK"  , "narrator": "表層アーヤ", "text": "意見が折り合わないわね。"},
        { "location": "258/TALK"  , "narrator": "潜在アーヤ", "text": "ほんとに。"},
        { "location": "259/TALK"  , "narrator": "表層アーヤ", "text": "貴方を倒して、二度と\nそんなこと考えない\nようにしなくちゃ！"},
        { "location": "260/TALK"  , "narrator": "潜在アーヤ", "text": "それはこっちも同じよ！"},
        { "location": "261/TALK"  , "narrator": "表層アーヤ", "text": "行きます！！"},
        { "location": "273/DIALOG", "narrator": "", "text": "<color=black><size=50><b>自分を捨てて任務に盲進する\nアーヤを排除せよ！</b></size></color>\n\n\n東京を守る任務、トライナリー。\nそれを確実に遂行する為には\n時に恥を忍んでもやらなければならない時がある。\n\nけどそれは、二十歳そこそこの\n女性にとっては、あまりに辛いこと。\n\nそこまで個を犠牲にして\n任務にあたらなければならないのか。\n行きすぎた正義感を持つアーヤを倒し、\n心のバランスを保とう。"}
    ]
}
