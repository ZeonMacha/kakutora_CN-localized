{
    "dir": "chap13/daydra/dd_ch04_13_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "13402",
        "cid": "miyabi",
        "title": "002 メインストーリー",
        "sub_title": "穴へは飛び込むべきか＜前編＞"
    },
    "entry":
    [
        { "location": "8/SCENARIO", "narrator": "", "text": "うさぎと女王"},
        { "location": "20/TALK"   , "narrator": "みやび", "text": "…そろそろ時間やな。"},
        { "location": "24/TALK"   , "narrator": "フェイタルクイーン", "text": "ウサギ、始めてもいいか？"},
        { "location": "26/TALK"   , "narrator": "ラビットアニマ", "text": "お疲れ様です、いつでもどうぞ"},
        { "location": "28/TALK"   , "narrator": "フェイタルクイーン", "text": "うむ"},
        { "location": "29/TALK"   , "narrator": "フェイタルクイーン", "text": "先日発生したフェノメノンを解析した際に"},
        { "location": "30/TALK"   , "narrator": "フェイタルクイーン", "text": "新たな事実が発覚した"},
        { "location": "32/TALK"   , "narrator": "ラビットアニマ", "text": "フェノメノンについてですか？"},
        { "location": "34/TALK"   , "narrator": "フェイタルクイーン", "text": "いや"},
        { "location": "35/TALK"   , "narrator": "フェイタルクイーン", "text": "トライナリーについてだ"},
        { "location": "37/TALK"   , "narrator": "フェイタルクイーン", "text": "仮に、世間で噂されている通り"},
        { "location": "38/TALK"   , "narrator": "フェイタルクイーン", "text": "彼女たち、と仮定する"},
        { "location": "39/TALK"   , "narrator": "フェイタルクイーン", "text": "彼女たちはフェノメノン内で戦闘する際に"},
        { "location": "40/TALK"   , "narrator": "フェイタルクイーン", "text": "特殊なアイテムを使っていること"},
        { "location": "41/TALK"   , "narrator": "フェイタルクイーン", "text": "前に話したと思うが、覚えているか？"},
        { "location": "43/TALK"   , "narrator": "ラビットアニマ", "text": "FatalQueenが以前ハッキングに成功し"},
        { "location": "44/TALK"   , "narrator": "ラビットアニマ", "text": "謎のAPIの存在を確認したというアレですね？"},
        { "location": "46/TALK"   , "narrator": "フェイタルクイーン", "text": "そうだ"},
        { "location": "47/TALK"   , "narrator": "フェイタルクイーン", "text": "その際に、どこかへ通信していること"},
        { "location": "49/TALK"   , "narrator": "フェイタルクイーン", "text": "その結果、何らかの処理を行っているらしいこともわかったのだが"},
        { "location": "50/TALK"   , "narrator": "フェイタルクイーン", "text": "今回、そのAPIをトレースした結果"},
        { "location": "52/TALK"   , "narrator": "フェイタルクイーン", "text": "いくつかの挙動を確認することに成功した"},
        { "location": "53/TALK"   , "narrator": "フェイタルクイーン", "text": "それが何を意味するかはわかるな？"},
        { "location": "56/TALK"   , "narrator": "ラビットアニマ", "text": "フェノメノンで作用しているということは"},
        { "location": "57/TALK"   , "narrator": "ラビットアニマ", "text": "そのアイテムと"},
        { "location": "58/TALK"   , "narrator": "ラビットアニマ", "text": "フェノメノンは"},
        { "location": "59/TALK"   , "narrator": "ラビットアニマ", "text": "何かしらの関係がある"},
        { "location": "60/TALK"   , "narrator": "ラビットアニマ", "text": "ということでしょうか？"},
        { "location": "62/TALK"   , "narrator": "フェイタルクイーン", "text": "その通り"},
        { "location": "64/TALK"   , "narrator": "フェイタルクイーン", "text": "例えばの話だが"},
        { "location": "65/TALK"   , "narrator": "フェイタルクイーン", "text": "ゲームソフトを作ったとしよう"},
        { "location": "66/TALK"   , "narrator": "フェイタルクイーン", "text": "そのゲームの世界に新たな３Ｄモデルを投下するには"},
        { "location": "67/TALK"   , "narrator": "フェイタルクイーン", "text": "ゲームソフトプログラム側の「協力」が必要不可欠になる"},
        { "location": "69/TALK"   , "narrator": "フェイタルクイーン", "text": "つまりトライナリーがフェノメノン内部で自由にアクションを起こせるのは"},
        { "location": "70/TALK"   , "narrator": "フェイタルクイーン", "text": "フェノメノンという世界のアルゴリズムと"},
        { "location": "71/TALK"   , "narrator": "フェイタルクイーン", "text": "そのアイテムが"},
        { "location": "72/TALK"   , "narrator": "フェイタルクイーン", "text": "繋がっているからと考えられる"},
        { "location": "74/TALK"   , "narrator": "ラビットアニマ", "text": "今の話からすると"},
        { "location": "75/TALK"   , "narrator": "ラビットアニマ", "text": "Queenはトライナリーのことを"},
        { "location": "76/TALK"   , "narrator": "ラビットアニマ", "text": "フェノメノンの一部だとお思いなのですか？"},
        { "location": "78/TALK"   , "narrator": "フェイタルクイーン", "text": "可能性はある"},
        { "location": "80/TALK"   , "narrator": "ラビットアニマ", "text": "ですが"},
        { "location": "82/TALK"   , "narrator": "フェイタルクイーン", "text": "落ち着け"},
        { "location": "83/TALK"   , "narrator": "フェイタルクイーン", "text": "まだ確証はない"},
        { "location": "84/TALK"   , "narrator": "フェイタルクイーン", "text": "あくまでも可能性の一つというだけだ"},
        { "location": "88/TALK"   , "narrator": "フェイタルクイーン", "text": "今はそれ以上何も言えないが"},
        { "location": "89/TALK"   , "narrator": "フェイタルクイーン", "text": "その可能性があるというのを覚えておいてほしい"},
        { "location": "91/TALK"   , "narrator": "ラビットアニマ", "text": "わかりました"},
        { "location": "92/TALK"   , "narrator": "ラビットアニマ", "text": "では、また次の日時に"},
        { "location": "93/TALK"   , "narrator": "システム", "text": "『RabbitAnimaが退出しました』"},
        { "location": "95/TALK"   , "narrator": "みやび", "text": "…トライナリーが\nフェノメノンの一部、\nか…。"},
        { "location": "96/TALK"   , "narrator": "みやび", "text": "自分で言うてて\nゾッとする話やね。"},
        { "location": "97/TALK"   , "narrator": "みやび", "text": "…………。"},
        { "location": "98/TALK"   , "narrator": "みやび", "text": "ちゅうか、ウサギとも\n大分長い付き合いに\nなっちょるなぁ…。"},
        { "location": "99/TALK"   , "narrator": "みやび", "text": "最初の頃は、こんな\n頻繁にやり取りも\nせんかったし。"},
        { "location": "100/TALK"  , "narrator": "みやび", "text": "まあ、雑談なんぞ\nする関係やない\nけんども――"},
        { "location": "102/TALK"  , "narrator": "みやび", "text": "まっこと、距離感\n縮まったなぁ…。"},
        { "location": "103/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "104/TALK"  , "narrator": "みやび", "text": "リアルで会うても、\n意外と楽しめるかも\nしれんな…。"},
        { "location": "105/TALK"  , "narrator": "みやび", "text": "いや、いかんいかん。\nハッカーがリアルで\n会うのはご法度や。"},
        { "location": "106/TALK"  , "narrator": "みやび", "text": "それに、高度な知識と\n渋いコードから見て、\n確実にオッサンやし。"},
        { "location": "107/TALK"  , "narrator": "みやび", "text": "うさぎなんて呼んじゅう\nけんど、そう考えると\n妙な気分になるね。"},
        { "location": "108/TALK"  , "narrator": "みやび", "text": "これもまた\nバーチャルワールドの\n功罪か……。"},
        { "location": "110/TALK"  , "narrator": "みやび", "text": "と、こんなこと思うて\nしまうとは、\nうちらしくない…。"},
        { "location": "111/TALK"  , "narrator": "みやび", "text": "…信頼し過ぎて、\nちくっと距離縮め\n過ぎたか？"},
        { "location": "112/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "113/TALK"  , "narrator": "みやび", "text": "やり取りする回数、\n減らした方がえいかも\nしれんなぁ…。"},
        { "location": "156/TALK"  , "narrator": "みやび", "text": "さあ、どこからでも\nかかってきいや！"},
        { "location": "177/TALK"  , "narrator": "みやび", "text": "はあっ！\nえいタップや！"},
        { "location": "181/TALK"  , "narrator": "みやび", "text": "もうこれ以上大きく\nなりたくないき、\nあまり触らんといてや。"},
        { "location": "185/TALK"  , "narrator": "みやび", "text": "子供を身ごもると\n旦那に毎日こんな感じで\n触られるんかね……。"},
        { "location": "189/TALK"  , "narrator": "みやび", "text": "みやびさん\n６ポイントゲット。"},
        { "location": "190/SEL"   , "narrator": "", "text": "ここ最近本末転倒じゃない？"},
        { "location": "191/SEL"   , "narrator": "", "text": "毎回みやびを触れて嬉しい"},
        { "location": "192/ACT"   , "narrator": "", "text": "ここ最近本末転倒じゃない？"},
        { "location": "193/TALK"  , "narrator": "みやび", "text": "そこに気づくとは、\nおぬし、ただ者では\nないな。"},
        { "location": "194/TALK"  , "narrator": "みやび", "text": "さよう。\n本来これは、うちを叩き\n起こすのが目的だった。"},
        { "location": "195/TALK"  , "narrator": "みやび", "text": "けんど今は、うちが\n楽しむために、敢えて\nお前さんにやらせちょる。"},
        { "location": "196/ACT"   , "narrator": "", "text": "毎回みやびを触れて嬉しい"},
        { "location": "197/TALK"  , "narrator": "みやび", "text": "……またそういうことを\nシレッと言いおって。"},
        { "location": "198/TALK"  , "narrator": "みやび", "text": "できることなら、\n面と向かって真顔で言って\nもらいたいものやね。"},
        { "location": "201/TALK"  , "narrator": "みやび", "text": "とまあ戯れ言は置いておき\n１７ポイントになった\nわけやけんど――"},
        { "location": "206/TALK"  , "narrator": "みやび", "text": "素数になったので、\nみやびさん、\n２回目の報酬をゲット！"},
        { "location": "207/SEL"   , "narrator": "", "text": "早くないすか？"},
        { "location": "208/ACT"   , "narrator": "", "text": "早くないすか？"},
        { "location": "210/TALK"  , "narrator": "みやび", "text": "速度は計算式に\n含まれては\nおらんからな。"},
        { "location": "211/TALK"  , "narrator": "みやび", "text": "で、今回の賞品は、\nお前さんの労働力や。"},
        { "location": "212/SEL"   , "narrator": "", "text": "何をするの？"},
        { "location": "213/SEL"   , "narrator": "", "text": "ちゅーする労働？"},
        { "location": "214/ACT"   , "narrator": "", "text": "何をするの？"},
        { "location": "215/TALK"  , "narrator": "みやび", "text": "焦らんでも、\n労働は逃げはせんよ。"},
        { "location": "216/ACT"   , "narrator": "", "text": "ちゅーする労働？"},
        { "location": "218/TALK"  , "narrator": "みやび", "text": "一体どうゆう育ち方\nしてきたのやろか。"},
        { "location": "223/TALK"  , "narrator": "みやび", "text": "がしかし！\n賞品をもらうのは後や。"},
        { "location": "224/TALK"  , "narrator": "みやび", "text": "まずは、うちの仕事を\nやってまおうかね。"},
        { "location": "231/TALK"  , "narrator": "みやび", "text": "オープンプロセス、\n0x492番地から\n0x559番地へ。"},
        { "location": "246/TALK"  , "narrator": "みやび", "text": "完了。"},
        { "location": "247/TALK"  , "narrator": "みやび", "text": "さて問題や。\n今回のうちを見て\nどう思う？"},
        { "location": "248/SEL"   , "narrator": "", "text": "警戒心が強い"},
        { "location": "249/SEL"   , "narrator": "", "text": "主題がズレてる"},
        { "location": "250/SEL"   , "narrator": "", "text": "相変わらず胸がでかい"},
        { "location": "251/ACT"   , "narrator": "", "text": "警戒心が強い"},
        { "location": "252/TALK"  , "narrator": "みやび", "text": "いや、逆やろ。\n警戒心ガバガバや。"},
        { "location": "253/ACT"   , "narrator": "", "text": "主題がズレてる"},
        { "location": "254/TALK"  , "narrator": "みやび", "text": "お。なかなか\nえい筋しちゅうね。"},
        { "location": "255/ACT"   , "narrator": "", "text": "相変わらず胸がでかい"},
        { "location": "256/TALK"  , "narrator": "みやび", "text": "出よったな、\nオッパイ星人め。"},
        { "location": "258/TALK"  , "narrator": "みやび", "text": "今回のうちやけんど、\n困ったことに、本末転倒な\n事になっちゅう。"},
        { "location": "259/TALK"  , "narrator": "みやび", "text": "ハッカー相手に警戒心を\n持つのは当然やけんど、\nそれは頻度の問題やない。"},
        { "location": "260/TALK"  , "narrator": "みやび", "text": "今の自分は、何かが\n引っかかって、それすら\n解らんくなっちゅうがね。"},
        { "location": "261/TALK"  , "narrator": "みやび", "text": "やき、\nクランを倒してすっと\nうちの目を醒まさせい。"},
        { "location": "262/TALK"  , "narrator": "みやび", "text": "これが今回の\nミッションや。"},
        { "location": "263/SEL"   , "narrator": "", "text": "で、賞品の件は？"},
        { "location": "264/ACT"   , "narrator": "", "text": "で、賞品の件は？"},
        { "location": "270/TALK"  , "narrator": "みやび", "text": "おおっ、\n自己申告とは\nなかなかやるな。"},
        { "location": "271/TALK"  , "narrator": "みやび", "text": "ほんだらご期待に応えて、\n今回うちがもらう賞品を\n教えちゃろう。"},
        { "location": "272/TALK"  , "narrator": "みやび", "text": "うちのハッキングを\n手伝う助手になりや。"},
        { "location": "273/SEL"   , "narrator": "", "text": "何をハッキングするの？"},
        { "location": "274/ACT"   , "narrator": "", "text": "何をハッキングするの？"},
        { "location": "276/TALK"  , "narrator": "みやび", "text": "うちのココロや。"},
        { "location": "277/SEL"   , "narrator": "", "text": "どういうこと？"},
        { "location": "278/ACT"   , "narrator": "", "text": "どういうこと？"},
        { "location": "280/TALK"  , "narrator": "みやび", "text": "額面通り。\nうちのココロを\nクラックするちや。"},
        { "location": "281/SEL"   , "narrator": "", "text": "司書だよね？"},
        { "location": "282/SEL"   , "narrator": "", "text": "もしかして、本当はみやびの人格ではない？"},
        { "location": "283/ACT"   , "narrator": "", "text": "司書だよね？"},
        { "location": "284/TALK"  , "narrator": "みやび", "text": "もちろん。\nけんど、司書だって\n見られないものはある。"},
        { "location": "285/ACT"   , "narrator": "", "text": "もしかして、本当はみやびの人格ではない？"},
        { "location": "286/TALK"  , "narrator": "みやび", "text": "飛躍しすぎや。"},
        { "location": "287/TALK"  , "narrator": "みやび", "text": "うちは司書やけんど、\n全てのココロを見られる\nわけやない。"},
        { "location": "289/TALK"  , "narrator": "みやび", "text": "そんな閉架された\nココロを見る為に\nクラックするわけや。"},
        { "location": "290/SEL"   , "narrator": "", "text": "でも、何で急に？"},
        { "location": "291/SEL"   , "narrator": "", "text": "嫌だと言ったら？"},
        { "location": "292/ACT"   , "narrator": "", "text": "でも、何で急に？"},
        { "location": "293/TALK"  , "narrator": "みやび", "text": "急でもなんでもない。\nずっと前から\n何も変わっちょらんよ。"},
        { "location": "294/TALK"  , "narrator": "みやび", "text": "ただ……"},
        { "location": "295/TALK"  , "narrator": "みやび", "text": "お前さんが、言うに値する\n存在かどうか、見定めて\nいただけや。"},
        { "location": "296/ACT"   , "narrator": "", "text": "嫌だと言ったら？"},
        { "location": "297/TALK"  , "narrator": "みやび", "text": "今までうちに触ったのを\n全部詳細に記述して、\n事案として告発する。"},
        { "location": "298/TALK"  , "narrator": "みやび", "text": "ブタバコに入って人生を\n棒に振るか、JKと楽しく\nハッキングするか――"},
        { "location": "299/TALK"  , "narrator": "みやび", "text": "じっくり考えて\n答えを出しいや。"},
        { "location": "304/TALK"  , "narrator": "みやび", "text": "とにかく、\nそうゆうわけやき。\n詳細はまた今度な。"},
        { "location": "305/TALK"  , "narrator": "みやび", "text": "今回は、うちの錯乱を\nしっかり対処しいや。"},
        { "location": "307/TALK"  , "narrator": "みやび", "text": "うちと$handle$に\nえいココロの旅を。"},
        { "location": "19/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>6月21日　9:47 PM</color>\nとある平日の夜、寮「とらいあんぐる」みやびの部屋。"},
        { "location": "125/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "162/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "188/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"}
    ]
}
