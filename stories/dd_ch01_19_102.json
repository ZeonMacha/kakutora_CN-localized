        "title": "005 メインストーリー",
        "sub_title": "気にしすぎの夏＜後編＞"
    },
    "entry":
    [
        { "location": "550/TALK"  , "narrator": "つばめ", "text": "…あれ？"},
        { "location": "553/TALK"  , "narrator": "つばめ", "text": "って、違うよ！"},
        { "location": "555/TALK"  , "narrator": "雛", "text": "うわっ！\nな、なにが違うの？"},
        { "location": "557/TALK"  , "narrator": "つばめ", "text": "だって！"},
        { "location": "558/TALK"  , "narrator": "つばめ", "text": "ひなこちゃん達が\n大変なのって\nわたし達のせいなのに。"},
        { "location": "559/TALK"  , "narrator": "つばめ", "text": "それなのに\nわたし全然\n気がつかなくて。"},
        { "location": "561/TALK"  , "narrator": "つばめ", "text": "なんか、他人事\nみたいなこと\n言っちゃったから…。"},
        { "location": "562/TALK"  , "narrator": "雛", "text": "そんな、気にすること\nないのにー。"},
        { "location": "563/TALK"  , "narrator": "ヒカル", "text": "そうですよ。\n無理に強制されてる\nわけじゃないし。"},
        { "location": "564/TALK"  , "narrator": "ヒカル", "text": "僕達がやりたいと\n思って来てる\nだけのことだよ。"},
        { "location": "566/TALK"  , "narrator": "つばめ", "text": "それでも、夏休みに\n遠出させちゃって\nごめんね…。"},
        { "location": "568/TALK"  , "narrator": "雛", "text": "気にし過ぎ\nだってばー。"},
        { "location": "570/TALK"  , "narrator": "つばめ", "text": "でも…。"},
        { "location": "572/TALK"  , "narrator": "みやび", "text": "…報酬ありやろ？"},
        { "location": "575/TALK"  , "narrator": "雛", "text": "えっ！？"},
        { "location": "576/TALK"  , "narrator": "ヒカル", "text": "うっ…。"},
        { "location": "577/TALK"  , "narrator": "キリト", "text": "ギクッ！？"},
        { "location": "580/TALK"  , "narrator": "みやび", "text": "まほさんのことやき、\n多分何かしらの報酬は\nあるんやろ？"},
        { "location": "584/TALK"  , "narrator": "つばめ", "text": "え？　そうなの？"},
        { "location": "585/TALK"  , "narrator": "ヒカル", "text": "あはは…、\n実はそうなんです。"},
        { "location": "586/TALK"  , "narrator": "キリト", "text": "こっちにいる間、\n食事に関してだけは\n保障する。"},
        { "location": "587/TALK"  , "narrator": "キリト", "text": "美味いものを\n好きなだけ食わせて\nくれるって。"},
        { "location": "588/TALK"  , "narrator": "雛", "text": "えへへ…この辺って\n三崎マグロっていう\nのが有名でしょ？"},
        { "location": "589/TALK"  , "narrator": "雛", "text": "それをお腹いっぱい\n食べられるのは\n魅力的だなぁ、って。"},
        { "location": "591/TALK"  , "narrator": "みやび", "text": "…食い物に\n釣られたが！？"},
        { "location": "593/TALK"  , "narrator": "雛", "text": "食べてみたかったん\nです、三崎マグロ！"},
        { "location": "595/TALK"  , "narrator": "キリト", "text": "大トロ食い放題でも\nいいって言われりゃ\n釣られますって！"},
        { "location": "596/TALK"  , "narrator": "雛", "text": "ま、そういうこと\nだから。"},
        { "location": "597/TALK"  , "narrator": "雛", "text": "あたし達だって\nただ働き、って\nわけじゃないの。"},
        { "location": "598/TALK"  , "narrator": "雛", "text": "だからつばめちゃんが\n気にする必要はない、\nってことだよ。"},
        { "location": "603/TALK"  , "narrator": "真幌", "text": "おまえら、\n食事はすんだのか？"},
        { "location": "607/TALK"  , "narrator": "キリト", "text": "あ、東雲教官。\nちょうど終わった\nとこっすよ。"},
        { "location": "608/TALK"  , "narrator": "真幌", "text": "よし、ならば\n早速働いてもらうぞ。"},
        { "location": "610/TALK"  , "narrator": "真幌", "text": "荷物を持って\n外の車に乗れ。"},
        { "location": "612/TALK"  , "narrator": "ヒカル", "text": "わかりました。"},
        { "location": "614/TALK"  , "narrator": "ヒカル", "text": "では、逢瀬さん、\nみやび先輩。\n僕たちはこれで。"},
        { "location": "616/TALK"  , "narrator": "みやび", "text": "ん。"},
        { "location": "618/TALK"  , "narrator": "みやび", "text": "外食もえいけんど、\nうちに食べに来ても\nえいきね。"},
        { "location": "619/TALK"  , "narrator": "キリト", "text": "マジっすか！？"},
        { "location": "620/TALK"  , "narrator": "雛", "text": "じゃあ、お夕飯は\n一緒に食べよ、\nつばめちゃん。"},
        { "location": "622/TALK"  , "narrator": "つばめ", "text": "うん、楽しみに\nしてるね。"},
        { "location": "625/TALK"  , "narrator": "真幌", "text": "ほら、もういいか？\n行くぞ。"},
        { "location": "627/TALK"  , "narrator": "雛", "text": "あ、はい。\nじゃあ、また夜にね。"},
        { "location": "651/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "653/TALK"  , "narrator": "みやび", "text": "つばめちゃん。\nうちらも食事に\nするがよ。"},
        { "location": "654/TALK"  , "narrator": "みやび", "text": "用意してくるき、\n座って待っちょれ。"},
        { "location": "655/TALK"  , "narrator": "つばめ", "text": "あ、はい。"},
        { "location": "658/SEL"   , "narrator": "", "text": "雛達が来てくれてよかったね"},
        { "location": "659/ACT"   , "narrator": "", "text": "雛達が来てくれてよかったね"},
        { "location": "676/TALK"  , "narrator": "つばめ", "text": "ぅん(*´︶`*)"},
        { "location": "678/TALK"  , "narrator": "つばめ", "text": "遊ぶ時間作れるかはわからないけど"},
        { "location": "679/TALK"  , "narrator": "つばめ", "text": "ぉ夕飯だけでも"},
        { "location": "680/TALK"  , "narrator": "つばめ", "text": "一緒に取りたぃな(●´ω｀●)ゞｴﾍﾍ"},
        { "location": "681/TALK"  , "narrator": "つばめ", "text": "沢山"},
        { "location": "682/TALK"  , "narrator": "つばめ", "text": "ぉ話もしたぃし(´艸`*"},
        { "location": "684/SEL"   , "narrator": "", "text": "つばめも訓練頑張れそうだね"},
        { "location": "685/ACT"   , "narrator": "", "text": "つばめも訓練頑張れそうだね"},
        { "location": "687/TALK"  , "narrator": "つばめ", "text": "そぅだね"},
        { "location": "688/TALK"  , "narrator": "つばめ", "text": "ひなこちゃん達が"},
        { "location": "689/TALK"  , "narrator": "つばめ", "text": "頑張ってくれてるんだもん(≧ω≦)"},
        { "location": "690/TALK"  , "narrator": "つばめ", "text": "わたしも頑張らなきゃ(๑･ㅂ･)و☆"},
        { "location": "701/TALK"  , "narrator": "つばめ", "text": "よーし、お昼の訓練も\n頑張ろ！"},
        { "location": "712/DIALOG", "narrator": "Dialog_chapter_ch01", "text": "【MV EXE_GARBiELa】"}
    ]
}
