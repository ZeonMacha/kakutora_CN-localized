    "entry":
    [
        { "location": "4986/SCENARIO", "narrator": "", "text": "その名はインバネス"},
        { "location": "5011/TALK"    , "narrator": "神楽", "text": "シャーロックホームズが着てるマントみたいなののついたコートの名前知ってる？"},
        { "location": "5013/SEL"     , "narrator": "", "text": "マントじゃないの？"},
        { "location": "5014/SEL"     , "narrator": "", "text": "インバネスコートでしょ"},
        { "location": "5015/SEL"     , "narrator": "", "text": "いや知らんし"},
        { "location": "5016/ACT"     , "narrator": "", "text": "マントじゃないの？"},
        { "location": "5018/TALK"    , "narrator": "神楽", "text": "知らざあ言って聞かせやしょう"},
        { "location": "5019/TALK"    , "narrator": "神楽", "text": "インバネスコートって言うんだぴょん"},
        { "location": "5020/TALK"    , "narrator": "神楽", "text": "ひとつお利口になったね$handlek$"},
        { "location": "5021/ACT"     , "narrator": "", "text": "インバネスコートでしょ"},
        { "location": "5022/TALK"    , "narrator": "神楽", "text": "あ"},
        { "location": "5023/TALK"    , "narrator": "神楽", "text": "知ってたの"},
        { "location": "5025/TALK"    , "narrator": "神楽", "text": "つまらん"},
        { "location": "5026/ACT"     , "narrator": "", "text": "いや知らんし"},
        { "location": "5027/TALK"    , "narrator": "神楽", "text": "冷たいなー"},
        { "location": "5029/TALK"    , "narrator": "神楽", "text": "いやあれね？"},
        { "location": "5030/TALK"    , "narrator": "神楽", "text": "日本だと着物の時着るからさ？"},
        { "location": "5031/TALK"    , "narrator": "神楽", "text": "みやびさんに聞いてみたわけ"},
        { "location": "5032/TALK"    , "narrator": "神楽", "text": "そしたら男性用しかないんだってさー"},
        { "location": "5033/TALK"    , "narrator": "神楽", "text": "つまらんよー"},
        { "location": "5035/SEL"     , "narrator": "", "text": "単に持っていないだけでは"},
        { "location": "5036/SEL"     , "narrator": "", "text": "神楽着付けとかできたっけ？"},
        { "location": "5037/SEL"     , "narrator": "", "text": "じゃあ$me$が作ってあげる"},
        { "location": "5038/ACT"     , "narrator": "", "text": "単に持っていないだけでは"},
        { "location": "5039/TALK"    , "narrator": "神楽", "text": "そう思って探したぴょん"},
        { "location": "5040/TALK"    , "narrator": "神楽", "text": "本当にそうだったぴょん"},
        { "location": "5042/TALK"    , "narrator": "神楽", "text": "子供用とかだったらあるんだけどね"},
        { "location": "5043/TALK"    , "narrator": "神楽", "text": "あとガチミリタリー正装とか"},
        { "location": "5044/TALK"    , "narrator": "神楽", "text": "そういうのは勘弁して"},
        { "location": "5045/TALK"    , "narrator": "神楽", "text": "がっかりぴょん、、、"},
        { "location": "5046/ACT"     , "narrator": "", "text": "神楽着付けとかできたっけ？"},
        { "location": "5047/TALK"    , "narrator": "神楽", "text": "それは秘密"},
        { "location": "5048/TALK"    , "narrator": "神楽", "text": "人に着付けてもらってはおるって手もあるし"},
        { "location": "5049/TALK"    , "narrator": "神楽", "text": "でも肝心のブツがないからお手上げぴょん"},
        { "location": "5050/ACT"     , "narrator": "", "text": "じゃあ$me$が作ってあげる"},
        { "location": "5052/TALK"    , "narrator": "神楽", "text": "$handlek$ってテーラーの資格とかあるの？"},
        { "location": "5053/TALK"    , "narrator": "神楽", "text": "ぴょんこはコスプレ衣装作成レベルじゃ満足できないんだからね！"},
        { "location": "5054/TALK"    , "narrator": "神楽", "text": "でもそれだったらうんとデコラティブでかわいいやつを作ってもらっちゃおうかなー"},
        { "location": "5056/TALK"    , "narrator": "神楽", "text": "楽しみにしとく♪"}
    ]
}
