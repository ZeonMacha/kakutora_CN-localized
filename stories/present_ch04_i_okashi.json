        { "location": "147/TALK", "narrator": "みやび", "text": "好きやね"},
        { "location": "148/TALK", "narrator": "みやび", "text": "部屋にも常備してある"},
        { "location": "149/TALK", "narrator": "みやび", "text": "手軽に食べれるし"},
