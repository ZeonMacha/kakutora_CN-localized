        { "location": "35/TALK"   , "narrator": "つばめ", "text": "暇な時に電話とかするみたぃだよ"},
        { "location": "36/TALK"   , "narrator": "つばめ", "text": "用がなくても"},
        { "location": "39/SEL"    , "narrator": "", "text": "そうだね"},
        { "location": "40/SEL"    , "narrator": "", "text": "それがどうかした？"},
        { "location": "41/SEL"    , "narrator": "", "text": "知ってるし"},
        { "location": "42/ACT"    , "narrator": "", "text": "そうだね"},
        { "location": "43/TALK"   , "narrator": "つばめ", "text": "やっぱり"},
        { "location": "44/TALK"   , "narrator": "つばめ", "text": "そぅなんだ"},
        { "location": "45/ACT"    , "narrator": "", "text": "それがどうかした？"},
        { "location": "46/TALK"   , "narrator": "つばめ", "text": "えっと"},
        { "location": "47/TALK"   , "narrator": "つばめ", "text": "だからね"},
        { "location": "48/ACT"    , "narrator": "", "text": "知ってるし"},
        { "location": "49/TALK"   , "narrator": "つばめ", "text": "あ"},
        { "location": "50/TALK"   , "narrator": "つばめ", "text": "知ってるの"},
        { "location": "52/TALK"   , "narrator": "つばめ", "text": "えっとね"},
        { "location": "53/TALK"   , "narrator": "つばめ", "text": "ぁたし今まで"},
        { "location": "54/TALK"   , "narrator": "つばめ", "text": "夜に連絡するとか"},
        { "location": "55/TALK"   , "narrator": "つばめ", "text": "迷惑だって思ってたの"},
        { "location": "56/TALK"   , "narrator": "つばめ", "text": "でも"},
        { "location": "57/TALK"   , "narrator": "つばめ", "text": "まゆちんとひなこちゃんは暇だったら連絡してくればって"},
        { "location": "58/SEL"    , "narrator": "", "text": "逆にかかってきたらどう？"},
        { "location": "59/SEL"    , "narrator": "", "text": "友達に遠慮し過ぎ"},
        { "location": "60/SEL"    , "narrator": "", "text": "普通、夜は掛けないよ"},
        { "location": "61/TALK"   , "narrator": "つばめ", "text": "言ってくれたんだヾ(｡>﹏<｡)ﾉﾞ"},
        { "location": "63/ACT"    , "narrator": "", "text": "逆にかかってきたらどう？"},
        { "location": "66/TALK"   , "narrator": "つばめ", "text": "ぁたしだったら"},
        { "location": "67/TALK"   , "narrator": "つばめ", "text": "嬉しぃな"},
        { "location": "68/TALK"   , "narrator": "つばめ", "text": "そっか"},
        { "location": "69/TALK"   , "narrator": "つばめ", "text": "まゆちんとひなこちゃんも"},
        { "location": "70/TALK"   , "narrator": "つばめ", "text": "きっとおんなじだょね"},
        { "location": "71/TALK"   , "narrator": "つばめ", "text": "これからは"},
        { "location": "72/TALK"   , "narrator": "つばめ", "text": "連絡しょっと"},
        { "location": "73/ACT"    , "narrator": "", "text": "友達に遠慮し過ぎ"},
        { "location": "75/TALK"   , "narrator": "つばめ", "text": "そぅなのかな？"},
        { "location": "76/TALK"   , "narrator": "つばめ", "text": "んー"},
        { "location": "78/TALK"   , "narrator": "つばめ", "text": "でも"},
        { "location": "79/TALK"   , "narrator": "つばめ", "text": "ぁたしだったら"},
        { "location": "80/TALK"   , "narrator": "つばめ", "text": "うれしぃな"},
        { "location": "81/TALK"   , "narrator": "つばめ", "text": "ぅん"},
        { "location": "82/TALK"   , "narrator": "つばめ", "text": "変な遠慮はよくなぃね"},
