        "title": "らぶとーく 第77話",
        "sub_title": "昨日までの私と、明日からのあなた"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "昨日までの私と、明日からのあなた"},
        { "location": "18/TALK"   , "narrator": "アーヤ", "text": "よしよし。\nここもキレイに\nなったし。"},
        { "location": "20/TALK"   , "narrator": "アーヤ", "text": "後は元通り\n組み立てるだけね。"},
        { "location": "21/TALK"   , "narrator": "アーヤ", "text": "……。"},
        { "location": "22/TALK"   , "narrator": "アーヤ", "text": "…人の気持ちも\nこうやって分解して\n確認できればいいのに。"},
        { "location": "23/TALK"   , "narrator": "アーヤ", "text": "……。"},
        { "location": "24/SEL"    , "narrator": "", "text": "持て余しちゃうよね"},
        { "location": "25/ACT"    , "narrator": "", "text": "持て余しちゃうよね"},
        { "location": "43/TALK"   , "narrator": "アーヤ", "text": "何が？"},
        { "location": "45/SEL"    , "narrator": "", "text": "$me$が退屈で"},
        { "location": "46/SEL"    , "narrator": "", "text": "アーヤがかわいくて"},
        { "location": "47/ACT"    , "narrator": "", "text": "$me$が退屈で"},
        { "location": "48/TALK"   , "narrator": "アーヤ", "text": "今手が離せないのよ"},
        { "location": "49/TALK"   , "narrator": "アーヤ", "text": "また後でね"},
        { "location": "50/ACT"    , "narrator": "", "text": "アーヤがかわいくて"},
        { "location": "51/TALK"   , "narrator": "アーヤ", "text": "そんなの"},
        { "location": "53/TALK"   , "narrator": "アーヤ", "text": "いつものことでしょ"},
        { "location": "54/TALK"   , "narrator": "アーヤ", "text": "それに私"},
        { "location": "55/TALK"   , "narrator": "アーヤ", "text": "かわいいより格好いいって"},
        { "location": "56/TALK"   , "narrator": "アーヤ", "text": "言われたいから(=^0^=)"},
        { "location": "73/TALK"   , "narrator": "真幌", "text": "バイクの整備か。"},
        { "location": "75/TALK"   , "narrator": "アーヤ", "text": "はい。"},
        { "location": "76/TALK"   , "narrator": "真幌", "text": "しかしさっき\nスマホを手に\nしていたような。"},
        { "location": "77/TALK"   , "narrator": "アーヤ", "text": "あ、ＷＡＶＥの\n着信があったので。"},
        { "location": "78/TALK"   , "narrator": "真幌", "text": "終わってから\nゆっくり返信\nすればいいのに。"},
        { "location": "79/TALK"   , "narrator": "アーヤ", "text": "…まあ、\nそうですね。"},
        { "location": "80/TALK"   , "narrator": "アーヤ", "text": "でもちょうど\n一段落ついたところ\nでしたし。"},
        { "location": "81/SEL"    , "narrator": "", "text": "めんどくさい話になってる？"},
        { "location": "82/ACT"    , "narrator": "", "text": "めんどくさい話になってる？"},
        { "location": "112/TALK"  , "narrator": "真幌", "text": "ん？\n返信しなくて\nいいのか？"},
        { "location": "114/TALK"  , "narrator": "アーヤ", "text": "急用では\nなかったので\n大丈夫です。"},
        { "location": "115/TALK"  , "narrator": "真幌", "text": "ならいいが。"},
        { "location": "116/TALK"  , "narrator": "真幌", "text": "…それにしても\nスマホは便利なようで\n不便だな。"},
        { "location": "117/TALK"  , "narrator": "アーヤ", "text": "…そうですね。"},
        { "location": "118/TALK"  , "narrator": "真幌", "text": "着信があると\nつい手にしてしまう。"},
        { "location": "119/TALK"  , "narrator": "真幌", "text": "目の前のことだけ\n見ている方が\n集中できるのにな。"},
        { "location": "120/TALK"  , "narrator": "アーヤ", "text": "ですね。"},
        { "location": "121/TALK"  , "narrator": "真幌", "text": "だからといって\n電源を切ってしまっては\n本末転倒だし。"},
        { "location": "122/TALK"  , "narrator": "真幌", "text": "悩みどころだよな。"},
        { "location": "123/TALK"  , "narrator": "アーヤ", "text": "…ああ。\n切ってしまうの、\n手ですよね。"},
        { "location": "124/TALK"  , "narrator": "アーヤ", "text": "そうすれば\n考えてる途中で\n鳴らないですから。"},
        { "location": "125/TALK"  , "narrator": "真幌", "text": "いやいや。\n人の話を\n聞いていたのか？"},
        { "location": "126/TALK"  , "narrator": "アーヤ", "text": "聞いてたから\n気付いたんですよ。"},
        { "location": "127/TALK"  , "narrator": "真幌", "text": "…いや、まあ、\nいいか。"},
        { "location": "128/TALK"  , "narrator": "真幌", "text": "そのくらい\n思い切った方が\nいい時もあるだろうし。"},
        { "location": "130/TALK"  , "narrator": "アーヤ", "text": "ですよね！"},
        { "location": "131/TALK"  , "narrator": "真幌", "text": "常に全力で集中\nするのは不可能だし。"},
        { "location": "132/TALK"  , "narrator": "アーヤ", "text": "…休息が必要\nということですか？"},
        { "location": "133/TALK"  , "narrator": "真幌", "text": "それもあるし。"},
        { "location": "134/TALK"  , "narrator": "真幌", "text": "後は比較検討\nする時間なんかだな。"},
        { "location": "135/TALK"  , "narrator": "アーヤ", "text": "ああ。わかります。"},
        { "location": "136/TALK"  , "narrator": "真幌", "text": "実は悩む時間が\n一番楽しいって\n知っているか？"},
        { "location": "137/TALK"  , "narrator": "アーヤ", "text": "え。そうなんですか？"},
        { "location": "138/TALK"  , "narrator": "真幌", "text": "決まったらもう\n結果を出すために\n行動するだけだからな。"},
        { "location": "139/TALK"  , "narrator": "真幌", "text": "責任と行動力が\n必要になってくる。"},
        { "location": "140/TALK"  , "narrator": "真幌", "text": "だが決めるまでは\nそんなものは\n必要ない。"},
        { "location": "141/TALK"  , "narrator": "真幌", "text": "だから本心は\n決まっていても\n悩むもんなんだ。"},
        { "location": "142/TALK"  , "narrator": "アーヤ", "text": "なるほど……。"},
        { "location": "143/TALK"  , "narrator": "真幌", "text": "だから大いに悩め。"},
        { "location": "144/TALK"  , "narrator": "アーヤ", "text": "悩めって……。"},
        { "location": "145/TALK"  , "narrator": "真幌", "text": "どうも整備に集中\nできてないように\n見えてたからな。"},
        { "location": "146/TALK"  , "narrator": "アーヤ", "text": "…そんなことは…。"},
        { "location": "147/TALK"  , "narrator": "真幌", "text": "勘違いなら\n聞き流せ。\n邪魔したな。"},
        { "location": "148/TALK"  , "narrator": "アーヤ", "text": "…あ、はい…。"},
        { "location": "151/TALK"  , "narrator": "アーヤ", "text": "うーん…。"},
        { "location": "153/TALK"  , "narrator": "アーヤ", "text": "結局私、どうするか\n決めてるのに\n踏み出せないだけなの…？"},
        { "location": "17/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>某月某日　 3:12 PM</color>\nとある平日、神楽坂トライナリーにて"}
    ]
}
