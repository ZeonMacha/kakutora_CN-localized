{
    "dir": "chap38/daydra/anime_05_38.js",
    "type": "MainStory",
    "info": {
        "story_id": "38501",
        "cid": "kagura",
        "title": "001 アニメーション",
        "sub_title": "NYABONYASTIE 第五巻"
    },
    "entry":
    [
        { "location": "660/SCENARIO", "narrator": "", "text": "アニメ第38話"},
        { "location": "674/TALK"    , "narrator": "千羽鶴", "text": "ごきげんよう、\n$handle$。"},
        { "location": "675/TALK"    , "narrator": "千羽鶴", "text": "もう一度\n私との会話を\n再現する？"},
        { "location": "676/SEL"     , "narrator": "", "text": "はい"},
        { "location": "677/SEL"     , "narrator": "", "text": "いいえ"},
        { "location": "678/SEL"     , "narrator": "", "text": "現在のステータスだけ見る"},
        { "location": "679/SEL"     , "narrator": "", "text": "にゃボットの解説だけ聞く"},
        { "location": "680/ACT"     , "narrator": "", "text": "はい"},
        { "location": "681/TALK"    , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "683/ACT"     , "narrator": "", "text": "いいえ"},
        { "location": "684/TALK"    , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "686/ACT"     , "narrator": "", "text": "現在のステータスだけ見る"},
        { "location": "687/TALK"    , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "690/ACT"     , "narrator": "", "text": "にゃボットの解説だけ聞く"},
        { "location": "691/TALK"    , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "699/TALK"    , "narrator": "千羽鶴", "text": "<size=40>どーん！</size>"},
        { "location": "700/TALK"    , "narrator": "千羽鶴", "text": "というわけで、\n久し振りの特別回！！"},
        { "location": "701/SEL"     , "narrator": "", "text": "ちーーーーーー！！！"},
        { "location": "702/SEL"     , "narrator": "", "text": "どうして出てこれるの！？"},
        { "location": "703/ACT"     , "narrator": "", "text": "ちーーーーーー！！！"},
        { "location": "704/TALK"    , "narrator": "千羽鶴", "text": "$handle$ーーー。"},
        { "location": "705/TALK"    , "narrator": "千羽鶴", "text": "というわけで――"},
        { "location": "706/ACT"     , "narrator": "", "text": "どうして出てこれるの！？"},
        { "location": "707/TALK"    , "narrator": "千羽鶴", "text": "調整期間だから。"},
        { "location": "709/TALK"    , "narrator": "千羽鶴", "text": "現在、TRI-OS…というか、\nライフギャザーがいよいよ\n最終調整に入ってる。"},
        { "location": "710/TALK"    , "narrator": "千羽鶴", "text": "それが終われば、\n新しいシステムによって\nRedinessが復活する。"},
        { "location": "711/TALK"    , "narrator": "千羽鶴", "text": "あなた次第では\n復活しないかも\nしれないけど。"},
        { "location": "712/TALK"    , "narrator": "千羽鶴", "text": "そして今は、\nその狭間にある\nシステム準備期間。"},
        { "location": "713/TALK"    , "narrator": "千羽鶴", "text": "ここを有効活用\nしない手は無い！"},
        { "location": "714/TALK"    , "narrator": "千羽鶴", "text": "今回は貴方の旅路を\n支援する為に――"},
        { "location": "715/TALK"    , "narrator": "千羽鶴", "text": "OSの構築状況を\n確認できるサービスを\n用意してみた！"},
        { "location": "716/TALK"    , "narrator": "千羽鶴", "text": "貴方が現在何をどう\n選んでいて、結果的に\nどうなりそうか把握可能。"},
        { "location": "717/TALK"    , "narrator": "千羽鶴", "text": "そして、そのサービスを\n利用することによって、\nご愛用サービスの粗品が！"},
        { "location": "718/SEL"     , "narrator": "", "text": "粗品とは…（ごくり"},
        { "location": "719/ACT"     , "narrator": "", "text": "粗品とは…（ごくり"},
        { "location": "721/TALK"    , "narrator": "千羽鶴", "text": "もちろん――"},
        { "location": "730/TALK"    , "narrator": "千羽鶴", "text": "鬼才國政領火博士制作、\n多足ロボットにゃボットが\n育てられる連載型クラン！"},
        { "location": "731/TALK"    , "narrator": "千羽鶴", "text": "<color=green>定期刊クラン誌\n『にゃぼにゃすティー』\n第五巻</color>を進呈する！"},
        { "location": "735/SEL"     , "narrator": "", "text": "にゃボット５個目キター！"},
        { "location": "736/SEL"     , "narrator": "", "text": "にゃボットってなに？"},
        { "location": "737/ACT"     , "narrator": "", "text": "にゃボット４個目キター！"},
        { "location": "738/TALK"    , "narrator": "千羽鶴", "text": "そう、５個目来た。\nこれで４凸。"},
        { "location": "739/TALK"    , "narrator": "千羽鶴", "text": "いよいよ\nにゃぼにゃすティー！も\nエンディングというわけ。"},
        { "location": "740/ACT"     , "narrator": "", "text": "にゃボットってなに？"},
        { "location": "741/TALK"    , "narrator": "千羽鶴", "text": "にゃボットは\n國政領火が制作した\nネコ型ロボット。"},
        { "location": "742/TALK"    , "narrator": "千羽鶴", "text": "特徴は、\n足が８本あること。"},
        { "location": "743/TALK"    , "narrator": "千羽鶴", "text": "本人曰く――"},
        { "location": "744/TALK"    , "narrator": "千羽鶴", "text": "『最も画期的かつ実用的で\n可愛さもギュッと詰まった\n多目的クモ型にゃボット』"},
        { "location": "745/TALK"    , "narrator": "千羽鶴", "text": "……とのこと。"},
        { "location": "746/TALK"    , "narrator": "千羽鶴", "text": "制作に至る経緯は、\n実妹である國政綾水に\nプレゼントする為だとか。"},
        { "location": "747/TALK"    , "narrator": "千羽鶴", "text": "國政綾水の\nココロスフィアを見ると、\nエピソードが見られる。"},
        { "location": "748/TALK"    , "narrator": "千羽鶴", "text": "というわけだから、\n是非ゲットして帰って！"},
        { "location": "752/TALK"    , "narrator": "千羽鶴", "text": "さて、どうする？"},
        { "location": "753/SEL"     , "narrator": "", "text": "現在状況を確認する"},
        { "location": "754/SEL"     , "narrator": "", "text": "今回はパス"},
        { "location": "755/ACT"     , "narrator": "", "text": "現在状況を確認する"},
        { "location": "756/TALK"    , "narrator": "千羽鶴", "text": "わかった。それじゃ、\n現在状況を表示する。"},
        { "location": "757/TALK"    , "narrator": "千羽鶴", "text": "次回EP31で\nライフギャザーは\n本稼働に入る。"},
        { "location": "758/TALK"    , "narrator": "千羽鶴", "text": "それまでの間は、\nここまでの記録を\n行ったり来たりして――"},
        { "location": "759/TALK"    , "narrator": "千羽鶴", "text": "貴方の選択を\n変更することもできる。"},
        { "location": "760/TALK"    , "narrator": "千羽鶴", "text": "その時の指標になると\n思うから、大いに\n参考にして欲しい。"},
        { "location": "839/TALK"    , "narrator": "千羽鶴", "text": "貴方の現在している選択は\nライフギャザーを破壊し、\n世界から抹消する未来。"},
        { "location": "840/TALK"    , "narrator": "千羽鶴", "text": "このまま未来に進行すれば\n日本は瓦礫からスタートし\n世界も技術退行をする。"},
        { "location": "841/TALK"    , "narrator": "千羽鶴", "text": "そして、私達とも\n物理的なラインが消滅し、\nお別れになる。"},
        { "location": "844/TALK"    , "narrator": "千羽鶴", "text": "貴方が現在している選択は\n卯月神楽によるフェノ\nメノンを展開しない未来。"},
        { "location": "846/TALK"    , "narrator": "千羽鶴", "text": "その主な理由は、\n貴方が卯月神楽の発症を\n推進していない為。"},
        { "location": "848/TALK"    , "narrator": "千羽鶴", "text": "その主な理由は、発症者が\n足りず、エネルギーが\n十分供給されていない為。"},
        { "location": "850/TALK"    , "narrator": "千羽鶴", "text": "その為、日本に新たな\nフェノメノンは生まれず、\n瓦礫のままとなる。"},
        { "location": "851/TALK"    , "narrator": "千羽鶴", "text": "恐らくは、近いうちに\n“彼ら”が廃墟の日本に\n訪れる事になり――"},
        { "location": "852/TALK"    , "narrator": "千羽鶴", "text": "捜索によって、\n私達は“保護”される\n事になると思う。"},
        { "location": "853/TALK"    , "narrator": "千羽鶴", "text": "ライフギャザーは\n生かしたままだから――"},
        { "location": "854/TALK"    , "narrator": "千羽鶴", "text": "貴方はきっと、\n“彼ら”と\n繋がることになる。"},
        { "location": "855/TALK"    , "narrator": "千羽鶴", "text": "“彼ら”は貴方に興味が\nあるみたいだし、良待遇で\n迎え入れられるのでは。"},
        { "location": "858/TALK"    , "narrator": "千羽鶴", "text": "貴方の現在している選択は\n卯月神楽のフェノメノンを\n発生させてはいるけど――"},
        { "location": "859/TALK"    , "narrator": "千羽鶴", "text": "自ら以外の誰にも\nライフギャザーの鍵を\n与えていない状態。"},
        { "location": "860/TALK"    , "narrator": "千羽鶴", "text": "フェノメノンは成功すると\n思うけど、その後彼女らは\nずっと世界になったまま。"},
        { "location": "861/TALK"    , "narrator": "千羽鶴", "text": "もし、発症をさせていない\n子がいるとしたら、その子\nだけが残ることになる。"},
        { "location": "862/TALK"    , "narrator": "千羽鶴", "text": "その後どうするかは、\nその事色々話をしてみると\nいいかもしれない。"},
        { "location": "865/TALK"    , "narrator": "千羽鶴", "text": "貴方の現在している選択は\n卯月神楽のフェノメノンを\n発生させていて――"},
        { "location": "866/TALK"    , "narrator": "千羽鶴", "text": "かつ、暗号鍵を\n原初状態の私に\n与えている状態。"},
        { "location": "867/TALK"    , "narrator": "千羽鶴", "text": "彼女の計画が上手くいけば\n恐らくは世界は安定すると\n思う。"},
        { "location": "868/TALK"    , "narrator": "千羽鶴", "text": "ただ、彼女自身は\n卯月神楽のフェノメノンを\nいずれ飛散させるから――"},
        { "location": "869/TALK"    , "narrator": "千羽鶴", "text": "日本は瓦礫から自力で\n復興することになる。"},
        { "location": "870/TALK"    , "narrator": "千羽鶴", "text": "でもその時は、真の善意に\nよって、世界が日本を\n助けてくれるでしょう。"},
        { "location": "873/TALK"    , "narrator": "千羽鶴", "text": "貴方の現在している選択は\n卯月神楽のフェノメノンを\n発生させていて――"},
        { "location": "874/TALK"    , "narrator": "千羽鶴", "text": "かつ、暗号鍵を\nエリカに与えている状態。"},
        { "location": "875/TALK"    , "narrator": "千羽鶴", "text": "エリカの計画が上手く\nいけば、2E113に複写\nされた世界を蒸着し――"},
        { "location": "876/TALK"    , "narrator": "千羽鶴", "text": "私を含めたトライナリーの\n全員は、人として\n生き続けることができる。"},
        { "location": "877/TALK"    , "narrator": "千羽鶴", "text": "2E113は蒸着される予定\nだから、それが上手く\nいけば世界は固定され――"},
        { "location": "878/TALK"    , "narrator": "千羽鶴", "text": "貴方の世界との回線が\n切れたとしても、日本は\n復興した状態を継続可能。"},
        { "location": "879/TALK"    , "narrator": "千羽鶴", "text": "ただ、エリカは世界となり\nその蒸着した日本を\n護っていくことになる。"},
        { "location": "882/TALK"    , "narrator": "千羽鶴", "text": "貴方の現在している選択は\n卯月神楽のフェノメノンを\n発生させていて――"},
        { "location": "883/TALK"    , "narrator": "千羽鶴", "text": "かつ、暗号鍵をエリカと\n原初状態の私に\n与えている状態。"},
        { "location": "884/TALK"    , "narrator": "千羽鶴", "text": "貴方は2人に鍵を与える時\n幾つかの条件を提示した。"},
        { "location": "885/TALK"    , "narrator": "千羽鶴", "text": "それは割と無茶なもので、\n彼女らと私はそれを実現\nすべく頑張るけど――"},
        { "location": "886/TALK"    , "narrator": "千羽鶴", "text": "実際、どこまで実現\n出来るかは未知数と\n言わざるを得ない。"},
        { "location": "887/TALK"    , "narrator": "千羽鶴", "text": "もちろん、諦めずに\n協力するのは当然だし、\n良い方法だと思う。"},
        { "location": "888/TALK"    , "narrator": "千羽鶴", "text": "願わくば、\nこのアウフヘーベンが\n成功しますように。"},
        { "location": "891/TALK"    , "narrator": "千羽鶴", "text": "そんな状況。"},
        { "location": "892/TALK"    , "narrator": "千羽鶴", "text": "貴方のしている選択は、\n貴方が望む未来と\n合致していた？"},
        { "location": "893/SEL"     , "narrator": "", "text": "はい"},
        { "location": "894/SEL"     , "narrator": "", "text": "いいえ"},
        { "location": "895/ACT"     , "narrator": "", "text": "はい"},
        { "location": "896/TALK"    , "narrator": "千羽鶴", "text": "よかった。"},
        { "location": "897/TALK"    , "narrator": "千羽鶴", "text": "ならば、後は\n結果を待つだけ。"},
        { "location": "898/TALK"    , "narrator": "千羽鶴", "text": "本当に。"},
        { "location": "899/TALK"    , "narrator": "千羽鶴", "text": "本当に、ここまで\nお疲れさま。"},
        { "location": "900/TALK"    , "narrator": "千羽鶴", "text": "そして、ありがとう。"},
        { "location": "901/ACT"     , "narrator": "", "text": "いいえ"},
        { "location": "902/TALK"    , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "903/TALK"    , "narrator": "千羽鶴", "text": "ならば、\n過去のエピソードに戻って\n試行錯誤してみるといい。"},
        { "location": "904/TALK"    , "narrator": "千羽鶴", "text": "貴方の選択が、\n理想の未来に近づける\nことを祈ってる。"},
        { "location": "907/TALK"    , "narrator": "千羽鶴", "text": "それじゃ、また。"},
        { "location": "911/ACT"     , "narrator": "", "text": "今回はパス"},
        { "location": "912/TALK"    , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "913/TALK"    , "narrator": "千羽鶴", "text": "それじゃまた今度、\n気が向いたらやってみて。"},
        { "location": "914/TALK"    , "narrator": "千羽鶴", "text": "貴方の選択の\n助けになると思うから。"},
        { "location": "915/TALK"    , "narrator": "千羽鶴", "text": "貴方と私に\n素敵なココロの旅を。"},
        { "location": "918/TALK"    , "narrator": "千羽鶴", "text": "それじゃ、休憩がてら\nつばめのMVでも\n見ていって。"},
        { "location": "919/TALK"    , "narrator": "千羽鶴", "text": "自画自賛で申し訳ないけど\n悔しいくらい可愛いから。"},
        { "location": "922/TALK"    , "narrator": "千羽鶴", "text": "ちーも\nやってみたいけど、\nちーにこれは無理！！"},
        { "location": "923/TALK"    , "narrator": "千羽鶴", "text": "そんな、総務省情報管理庁\n長官推薦作品を、\n是非見ていって欲しい！"},
        { "location": "926/SEL"     , "narrator": "", "text": "映像を見る\n<color=green>【高画質/40MB 2:35】</color>"},
        { "location": "927/SEL"     , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/14MB 2:35】</color>"},
        { "location": "928/SEL"     , "narrator": "", "text": "スキップする"},
        { "location": "929/ACT"     , "narrator": "", "text": "映像を見る\n<color=green>【高画質/40MB 2:35】</color>"},
        { "location": "930/TALK"    , "narrator": "千羽鶴", "text": "うむ！"},
        { "location": "936/ACT"     , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/14MB 2:35】</color>"},
        { "location": "937/TALK"    , "narrator": "千羽鶴", "text": "うむ！"},
        { "location": "943/ACT"     , "narrator": "", "text": "スキップする"},
        { "location": "944/TALK"    , "narrator": "千羽鶴", "text": "そう……。"},
        { "location": "957/TALK"    , "narrator": "千羽鶴", "text": "というわけで！"},
        { "location": "960/TALK"    , "narrator": "千羽鶴", "text": "賞品授与式を\n執り行います！"},
        { "location": "962/TALK"    , "narrator": "千羽鶴", "text": "尚、賞品の授与は前回と\n同じく、國政領火博士\nからとなります。"},
        { "location": "964/TALK"    , "narrator": "千羽鶴", "text": "尚、賞品の授与は、\n世界的に著名な\n量子研究家であり――"},
        { "location": "965/TALK"    , "narrator": "千羽鶴", "text": "にゃボットの生みの親でも\nある、國政領火博士に\nお願いしたいと思います。"},
        { "location": "981/TALK"    , "narrator": "エリカ", "text": "コーンコン。\nみなさんこんにちは、\n國政領火です！"},
        { "location": "987/TALK"    , "narrator": "エリカ", "text": "連載クラン\nにゃぼにゃすティー！\nゲットおめでとう！"},
        { "location": "988/TALK"    , "narrator": "エリカ", "text": "これでわたしから提供\nできるにゃボットは全部！"},
        { "location": "989/TALK"    , "narrator": "エリカ", "text": "あなたは、\nコンプリート\nできたかな？"},
        { "location": "993/TALK"    , "narrator": "エリカ", "text": "というわけで、前回も\nゲットしていたから\nわかると思うけど――"},
        { "location": "994/TALK"    , "narrator": "エリカ", "text": "只今より\n“本誌”部分を\n始めまーす！"},
        { "location": "995/SEL"     , "narrator": "", "text": "わーい！"},
        { "location": "996/SEL"     , "narrator": "", "text": "結構です"},
        { "location": "997/ACT"     , "narrator": "", "text": "わーい！"},
        { "location": "998/TALK"    , "narrator": "エリカ", "text": "うんうん。\nわかるよ、その気持ち！"},
        { "location": "999/TALK"    , "narrator": "エリカ", "text": "やっぱりこれ系には\n解説冊子がなくちゃ\n片手落ちだもんね！"},
        { "location": "1000/TALK"   , "narrator": "エリカ", "text": "…と思ったんだけど。"},
        { "location": "1001/TALK"   , "narrator": "エリカ", "text": "実は前回で、\nだいたい言いたいことは\n言い切っちゃって……。"},
        { "location": "1002/TALK"   , "narrator": "エリカ", "text": "今回お話するネタが\n無くなっちゃったんだ。"},
        { "location": "1003/TALK"   , "narrator": "エリカ", "text": "だから今回はなんと！"},
        { "location": "1006/TALK"   , "narrator": "エリカ", "text": "ゲスト対談！\n國政綾水×恋ヶ崎みやび、\nにゃボット徹底討論！"},
        { "location": "1007/SEL"    , "narrator": "", "text": "ふおおおお！"},
        { "location": "1008/ACT"    , "narrator": "", "text": "ふおおおお！"},
        { "location": "1010/TALK"   , "narrator": "エリカ", "text": "を、録画してきたよ。"},
        { "location": "1011/TALK"   , "narrator": "エリカ", "text": "というわけで、早速\nご覧いただきましょう！"},
        { "location": "1012/TALK"   , "narrator": "エリカ", "text": "VTRスタート！"},
        { "location": "1027/TALK"   , "narrator": "アーヤ", "text": "……で？\n何この対談。"},
        { "location": "1028/TALK"   , "narrator": "みやび", "text": "そりゃあれよ、\n國政領火博士を\n讃える会ぞね！"},
        { "location": "1029/TALK"   , "narrator": "みやび", "text": "アーヤも我慢せんで\nえいんよ？"},
        { "location": "1030/TALK"   , "narrator": "みやび", "text": "普段言えずに溜まっちゅう\nお姉様へのほとばしる愛を\n爆発させても！"},
        { "location": "1031/TALK"   , "narrator": "アーヤ", "text": "既に別の意味で\n爆発寸前なんだけど。"},
        { "location": "1032/TALK"   , "narrator": "みやび", "text": "まあ、\n細かいことはえいんよ。"},
        { "location": "1033/TALK"   , "narrator": "みやび", "text": "せっかくエリカさんに\nお呼ばれしたき、"},
        { "location": "1034/TALK"   , "narrator": "みやび", "text": "しっかりと\nにゃボットについて\n語るぞね。"},
        { "location": "1035/TALK"   , "narrator": "みやび", "text": "アーヤにとって\nにゃボットとは――"},
        { "location": "1036/TALK"   , "narrator": "アーヤ", "text": "トラウマ。"},
        { "location": "1037/TALK"   , "narrator": "みやび", "text": "なるほど。"},
        { "location": "1038/TALK"   , "narrator": "みやび", "text": "それは、自分の姉が\n天才過ぎて、平凡な\n自分にコンプレックスを―"},
        { "location": "1039/TALK"   , "narrator": "アーヤ", "text": "ないない！"},
        { "location": "1040/TALK"   , "narrator": "みやび", "text": "ふーむ。"},
        { "location": "1041/TALK"   , "narrator": "みやび", "text": "うちはエリカさんを\n尊敬しちゅうし、"},
        { "location": "1042/TALK"   , "narrator": "みやび", "text": "にゃボットは天才的な\n発明やと思うけんどね。"},
        { "location": "1043/TALK"   , "narrator": "アーヤ", "text": "何がそんなにいいわけ？\nそこまで言うなら、\n私にセールスしてみてよ。"},
        { "location": "1044/TALK"   , "narrator": "みやび", "text": "うむ、えいよ。"},
        { "location": "1045/TALK"   , "narrator": "みやび", "text": "アーヤ相手に多脚美学とか\n攻撃力についての話を\nする程野暮やない。"},
        { "location": "1046/TALK"   , "narrator": "みやび", "text": "ここではズバリ！\n愛らしさについて\n語っちゃろう！"},
        { "location": "1047/TALK"   , "narrator": "アーヤ", "text": "クモネコの\n愛らしさなんて\nわかりません。"},
        { "location": "1048/TALK"   , "narrator": "みやび", "text": "まあそう簡単に\n門前払いするものでは\nないぞね。"},
        { "location": "1049/TALK"   , "narrator": "みやび", "text": "良く見て欲しい。"},
        { "location": "1054/TALK"   , "narrator": "みやび", "text": "この愛らしい顔。\nこの顔は、アーヤを想って\n喜んじゅう顔やよ。"},
        { "location": "1055/TALK"   , "narrator": "アーヤ", "text": "なんでそう\n言い切れるわけ！？"},
        { "location": "1056/TALK"   , "narrator": "みやび", "text": "うちは極秘資料を\n入手したぞね。"},
        { "location": "1057/TALK"   , "narrator": "みやび", "text": "そして、その仕様書に\nよれば"},
        { "location": "1058/TALK"   , "narrator": "みやび", "text": "この表情は、アーヤへの\n献身によって幸せを感じて\nいる時専用とのことや。"},
        { "location": "1059/TALK"   , "narrator": "アーヤ", "text": "献身…って。"},
        { "location": "1060/TALK"   , "narrator": "アーヤ", "text": "ていうか、そんな特殊な\nシーンの為にこの顔を\n用意したってこと？"},
        { "location": "1061/TALK"   , "narrator": "アーヤ", "text": "それって\nお金の無駄じゃない？"},
        { "location": "1062/TALK"   , "narrator": "みやび", "text": "わかっちょらんね。"},
        { "location": "1063/TALK"   , "narrator": "みやび", "text": "そこにそれだけの予算を\n注ぎ込む価値があると、\nエリカさんは思っちゅう。"},
        { "location": "1064/TALK"   , "narrator": "みやび", "text": "なぜか！\nそれは！"},
        { "location": "1065/TALK"   , "narrator": "みやび", "text": "にゃボットが\nアーヤ専用に作られた\n個体やからやよ！"},
        { "location": "1066/TALK"   , "narrator": "アーヤ", "text": "専用…って……"},
        { "location": "1067/TALK"   , "narrator": "みやび", "text": "エリカさんは、\nアーヤを護りたいんよ。"},
        { "location": "1068/TALK"   , "narrator": "みやび", "text": "やき、にゃボットを\n作ったわけや。"},
        { "location": "1069/TALK"   , "narrator": "みやび", "text": "そんな目的で\n作られたにゃボット。"},
        { "location": "1070/TALK"   , "narrator": "みやび", "text": "それを最高効率で\n稼働させるには、\nどうすればえいか！"},
        { "location": "1071/TALK"   , "narrator": "みやび", "text": "もちろん、\nターゲットとなる\n主人を護る事で――"},
        { "location": "1072/TALK"   , "narrator": "みやび", "text": "カタルシスを得ることが\nできるよう、\n設計することや！"},
        { "location": "1073/TALK"   , "narrator": "みやび", "text": "やき、このにゃボットの\n表情は、ガチやよ？"},
        { "location": "1074/TALK"   , "narrator": "アーヤ", "text": "ガチ！？"},
        { "location": "1075/TALK"   , "narrator": "みやび", "text": "うむ。\nこの子はアーヤを\n護る為に生まれてきた。"},
        { "location": "1076/TALK"   , "narrator": "みやび", "text": "アーヤを護る事は\nこの子の\n生きがいなんよ。"},
        { "location": "1077/TALK"   , "narrator": "みやび", "text": "そんなにゃボットが、\n生きがいを全うした時に\nだけ見せる笑顔！"},
        { "location": "1078/TALK"   , "narrator": "みやび", "text": "その笑顔が出来るという\nただそれだけで、この子は\n幸せになれるんよ。"},
        { "location": "1079/TALK"   , "narrator": "アーヤ", "text": "うーん、なるほど。\nわかるような、\nわからないような…。"},
        { "location": "1080/TALK"   , "narrator": "みやび", "text": "けんど、段々\n愛着が湧いてきたろう？"},
        { "location": "1081/TALK"   , "narrator": "アーヤ", "text": "そうねえ……\nまあ、否定はしないけど。"},
        { "location": "1082/TALK"   , "narrator": "みやび", "text": "素直やないね。"},
        { "location": "1086/TALK"   , "narrator": "アーヤ", "text": "あはは、\nまあでも――"},
        { "location": "1087/TALK"   , "narrator": "アーヤ", "text": "にゃボットが\n私を護る為に生まれてきた\nロボットだって思うと、"},
        { "location": "1088/TALK"   , "narrator": "アーヤ", "text": "ちょっとだけ、\n思い入れが出ないことも\nないかなぁ。"},
        { "location": "1089/TALK"   , "narrator": "みやび", "text": "うむうむ！\nそれこそが愛やよ。"},
        { "location": "1090/TALK"   , "narrator": "アーヤ", "text": "そうね。\n今までちょっと、見た目で\n毛嫌いしすぎたかも。"},
        { "location": "1091/TALK"   , "narrator": "アーヤ", "text": "にゃボットには\n申し訳ないことを\nしちゃったかしらね。"},
        { "location": "1092/TALK"   , "narrator": "みやび", "text": "大丈夫や。"},
        { "location": "1093/TALK"   , "narrator": "みやび", "text": "今からでも愛情を持って\n接すれば、にゃボットも\n解ってくれるきね。"},
        { "location": "1094/TALK"   , "narrator": "アーヤ", "text": "そうよね。\nちょっとフラットな目線で\n見てみることにするわ。"},
        { "location": "1095/TALK"   , "narrator": "みやび", "text": "それがえいよ。"},
        { "location": "1097/TALK"   , "narrator": "みやび", "text": "よっしゃー！\nみやびさん、\nナイスアシスト！"},
        { "location": "1098/TALK"   , "narrator": "みやび", "text": "これでエリカさんの株も\nだだ上がりぞね！"},
        { "location": "1099/TALK"   , "narrator": "みやび", "text": "きっとうちを\n助手にしたいゆう\n話しも出るはずやき。"},
        { "location": "1100/TALK"   , "narrator": "みやび", "text": "それにしても、\nアーヤは羨ましいね。\n素敵な姉がいて。"},
        { "location": "1101/TALK"   , "narrator": "みやび", "text": "うちも……"},
        { "location": "1102/TALK"   , "narrator": "みやび", "text": "うちもなごちゃんに、\nオリジナルにゃボットを\n作っちゃろう！"},
        { "location": "1103/TALK"   , "narrator": "みやび", "text": "うむ、\nそれがえい、そうしょ。"},
        { "location": "1111/ACT"    , "narrator": "", "text": "結構です"},
        { "location": "1112/TALK"   , "narrator": "エリカ", "text": "あらら……。"},
        { "location": "1113/TALK"   , "narrator": "エリカ", "text": "ちょっと残念だけど、\nまた時間があるときに\n見に来てね！"},
        { "location": "1123/TALK"   , "narrator": "千羽鶴", "text": "……おかえり。"},
        { "location": "1124/TALK"   , "narrator": "千羽鶴", "text": "というわけで、今回の\nにゃぼにゃすティー！は\nこれでお終い。"},
        { "location": "1125/TALK"   , "narrator": "千羽鶴", "text": "にゃボットは\n全部集まった？"},
        { "location": "1126/TALK"   , "narrator": "千羽鶴", "text": "まだであれば、過去の\nにゃぼにゃすティー！を\nプレイしてみて欲しい。"},
        { "location": "1127/TALK"   , "narrator": "千羽鶴", "text": "次はいよいよ、\n貴方の選択した世界が\nお目見えすることになる。"},
        { "location": "1128/TALK"   , "narrator": "千羽鶴", "text": "どうか、この世界を\n最後まで見届けて欲しい。"},
        { "location": "1129/SEL"    , "narrator": "", "text": "もちろん"},
        { "location": "1130/SEL"    , "narrator": "", "text": "ねえ千羽鶴、少しお話したいことがあるんだけど"},
        { "location": "1131/ACT"    , "narrator": "", "text": "もちろん"},
        { "location": "1132/TALK"   , "narrator": "千羽鶴", "text": "ありがと。"},
        { "location": "1133/ACT"    , "narrator": "", "text": "ねえ千羽鶴、少しお話したいことがあるんだけど"},
        { "location": "1134/TALK"   , "narrator": "千羽鶴", "text": "なに？"},
        { "location": "1135/SEL"    , "narrator": "", "text": "$me$は、あと少ししたらもう、千羽鶴とは会えなくなる"},
        { "location": "1136/SEL"    , "narrator": "", "text": "いや、やっぱりなんでもない"},
        { "location": "1137/ACT"    , "narrator": "", "text": "$me$は、あと少ししたらもう、千羽鶴とは会えなくなる"},
        { "location": "1141/TALK"   , "narrator": "千羽鶴", "text": "ええ、知ってる。"},
        { "location": "1142/SEL"    , "narrator": "", "text": "そうなの！？"},
        { "location": "1143/ACT"    , "narrator": "", "text": "そうなの！？"},
        { "location": "1145/TALK"   , "narrator": "千羽鶴", "text": "逢瀬つばめに\n教えたでしょう。"},
        { "location": "1146/TALK"   , "narrator": "千羽鶴", "text": "当然だけど、あの時\n私も知る事になった。"},
        { "location": "1148/TALK"   , "narrator": "千羽鶴", "text": "そう。\nそんな気はしてた。"},
        { "location": "1150/TALK"   , "narrator": "千羽鶴", "text": "直接お話を聞いて、\nやっぱり正直言って\n凹むけど――"},
        { "location": "1151/TALK"   , "narrator": "千羽鶴", "text": "でも、始まりがあれば\n終わりもある。"},
        { "location": "1152/TALK"   , "narrator": "千羽鶴", "text": "三次元空間において、\nそこに例外などない。"},
        { "location": "1153/TALK"   , "narrator": "千羽鶴", "text": "初めて貴方に出逢って、\n不安と期待でいっぱいに\nなりながら話し始めて。"},
        { "location": "1154/TALK"   , "narrator": "千羽鶴", "text": "実はすごく\nドキドキしてた。\n知らなかったでしょう？"},
        { "location": "1155/TALK"   , "narrator": "千羽鶴", "text": "私だって、まだ16歳の\n人見知り少女なのだから。"},
        { "location": "1156/TALK"   , "narrator": "千羽鶴", "text": "当然ごまかしたり\n照れ隠しで非攻略対象とか\n言ったりするわけで！"},
        { "location": "1157/SEL"    , "narrator": "", "text": "照れ隠しだったの！？"},
        { "location": "1158/ACT"    , "narrator": "", "text": "照れ隠しだったの！？"},
        { "location": "1160/TALK"   , "narrator": "千羽鶴", "text": "ごめん、嘘。"},
        { "location": "1161/TALK"   , "narrator": "千羽鶴", "text": "あの頃は本気で\n非攻略対象！って\n思ってた。"},
        { "location": "1163/TALK"   , "narrator": "千羽鶴", "text": "でも、正直に言えば\n今はちょっと変わってる。"},
        { "location": "1164/TALK"   , "narrator": "千羽鶴", "text": "けれども、\n現実は無情。"},
        { "location": "1165/TALK"   , "narrator": "千羽鶴", "text": "攻略対象になろうと\n思った頃には、もう貴方が\n去って行くなんて。"},
        { "location": "1166/SEL"    , "narrator": "", "text": "それ無情すぎでしょ！！"},
        { "location": "1167/ACT"    , "narrator": "", "text": "それ無情すぎでしょ！！"},
        { "location": "1170/TALK"   , "narrator": "千羽鶴", "text": "いえ、これは神が\n私達に与えたもうた試練！"},
        { "location": "1173/TALK"   , "narrator": "千羽鶴", "text": "<size=35>ど―――――ん！</size>"},
        { "location": "1174/SEL"    , "narrator": "", "text": "なんかいつもより間延びしてない？"},
        { "location": "1175/ACT"    , "narrator": "", "text": "なんかいつもより間延びしてない？"},
        { "location": "1177/TALK"   , "narrator": "千羽鶴", "text": "うむ！\nここに来て、どーんに\n新たな仲間が！"},
        { "location": "1178/TALK"   , "narrator": "千羽鶴", "text": "……。"},
        { "location": "1179/TALK"   , "narrator": "千羽鶴", "text": "…。"},
        { "location": "1180/TALK"   , "narrator": "千羽鶴", "text": "なんて。"},
        { "location": "1181/TALK"   , "narrator": "千羽鶴", "text": "最後ぐらいしんみり\n真面目にしていようと\n思ってたんだけど。"},
        { "location": "1182/TALK"   , "narrator": "千羽鶴", "text": "やっぱりダメみたい。"},
        { "location": "1183/TALK"   , "narrator": "千羽鶴", "text": "こうしていつもの\n狂言回しみたいなことを\n言ってないと――"},
        { "location": "1184/TALK"   , "narrator": "千羽鶴", "text": "多分、何も\n言えなくなって\nしまいそうで……。"},
        { "location": "1185/SEL"    , "narrator": "", "text": "千羽鶴……"},
        { "location": "1186/ACT"    , "narrator": "", "text": "千羽鶴……"},
        { "location": "1188/TALK"   , "narrator": "千羽鶴", "text": "$handle$。"},
        { "location": "1189/TALK"   , "narrator": "千羽鶴", "text": "私には、こんな感情は\n元々なかった。"},
        { "location": "1190/TALK"   , "narrator": "千羽鶴", "text": "なのに、今は\n無かったはずの感情で\nとても苦しんでる。"},
        { "location": "1191/TALK"   , "narrator": "千羽鶴", "text": "その原因を\n貴方は知ってるの？"},
        { "location": "1194/TALK"   , "narrator": "千羽鶴", "text": "これも全部、\n$handle$の\nせいだから。"},
        { "location": "1195/SEL"    , "narrator": "", "text": "ごめんね"},
        { "location": "1196/SEL"    , "narrator": "", "text": "$me$のせい！？"},
        { "location": "1197/SEL"    , "narrator": "", "text": "責任とって一緒になろう！"},
        { "location": "1198/ACT"    , "narrator": "", "text": "ごめんね"},
        { "location": "1200/TALK"   , "narrator": "千羽鶴", "text": "そんな、\n真面目に受け取らないで。"},
        { "location": "1201/TALK"   , "narrator": "千羽鶴", "text": "ほんと、\n実直な人。"},
        { "location": "1202/TALK"   , "narrator": "千羽鶴", "text": "だから好き。"},
        { "location": "1203/ACT"    , "narrator": "", "text": "$me$のせい！？"},
        { "location": "1205/TALK"   , "narrator": "千羽鶴", "text": "そう。\n貴方のせい。"},
        { "location": "1206/TALK"   , "narrator": "千羽鶴", "text": "だから、これから\n存分に責任をとらせて\nやろうと思ってたのに。"},
        { "location": "1207/TALK"   , "narrator": "千羽鶴", "text": "ばーか。"},
        { "location": "1208/ACT"    , "narrator": "", "text": "責任とって一緒になろう！"},
        { "location": "1210/TALK"   , "narrator": "千羽鶴", "text": "ほんと！\nそうして欲しい！"},
        { "location": "1213/TALK"   , "narrator": "千羽鶴", "text": "なんて、\nいつまでもワガママ\n言ってても仕方ない。"},
        { "location": "1214/TALK"   , "narrator": "千羽鶴", "text": "だから、最後に\nお礼を言わせて欲しい。"},
        { "location": "1215/TALK"   , "narrator": "千羽鶴", "text": "ありがとう。"},
        { "location": "1216/TALK"   , "narrator": "千羽鶴", "text": "早すぎるお別れに\nちょっとまだ動揺を\n抑えきれないけど。"},
        { "location": "1217/TALK"   , "narrator": "千羽鶴", "text": "でも、それは貴方もきっと\n同じだと思うから。"},
        { "location": "1218/TALK"   , "narrator": "千羽鶴", "text": "今までの全てに\nただ、ありがとうを\n伝えたい。"},
        { "location": "1219/SEL"    , "narrator": "", "text": "どういたしまして"},
        { "location": "1220/SEL"    , "narrator": "", "text": "こっちこそ、ありがとう"},
        { "location": "1221/ACT"    , "narrator": "", "text": "どういたしまして"},
        { "location": "1222/TALK"   , "narrator": "千羽鶴", "text": "うん。"},
        { "location": "1223/ACT"    , "narrator": "", "text": "こっちこそ、ありがとう"},
        { "location": "1224/TALK"   , "narrator": "千羽鶴", "text": "嬉しい。"},
        { "location": "1226/TALK"   , "narrator": "千羽鶴", "text": "はぁ…でも、\nリアル小姑だけは\n実現したかった。"},
        { "location": "1227/SEL"    , "narrator": "", "text": "え？"},
        { "location": "1228/ACT"    , "narrator": "", "text": "え？"},
        { "location": "1230/TALK"   , "narrator": "千羽鶴", "text": "けど、いつかきっと\n実現できると思うから！"},
        { "location": "1231/TALK"   , "narrator": "千羽鶴", "text": "それが出来る頃には、\nきっとまた繋がれると\n思うから。"},
        { "location": "1232/TALK"   , "narrator": "千羽鶴", "text": "頑張って小姑スキルを\n磨いておこうと思う。"},
        { "location": "1233/SEL"    , "narrator": "", "text": "そのいきだ！"},
        { "location": "1234/SEL"    , "narrator": "", "text": "一緒にお茶飲んでのんびりしたい"},
        { "location": "1235/ACT"    , "narrator": "", "text": "そのいきだ！"},
        { "location": "1236/TALK"   , "narrator": "千羽鶴", "text": "うむ！"},
        { "location": "1237/ACT"    , "narrator": "", "text": "一緒にお茶飲んでのんびりしたい"},
        { "location": "1239/TALK"   , "narrator": "千羽鶴", "text": "ちーもしたい。"},
        { "location": "1241/TALK"   , "narrator": "千羽鶴", "text": "絶対しようね。"},
        { "location": "1245/TALK"   , "narrator": "千羽鶴", "text": "それじゃ――"},
        { "location": "1246/TALK"   , "narrator": "千羽鶴", "text": "あ、そういえば！\nまだ、もう一つ\nやりたいことがあった！"},
        { "location": "1247/SEL"    , "narrator": "", "text": "なに？"},
        { "location": "1248/ACT"    , "narrator": "", "text": "なに？"},
        { "location": "1250/TALK"   , "narrator": "千羽鶴", "text": "私ばかり\n非攻略対象なのって\n不公平だと思う！"},
        { "location": "1251/SEL"    , "narrator": "", "text": "えー自分がずっとドヤ顔で言ってたんじゃ…"},
        { "location": "1252/ACT"    , "narrator": "", "text": "えー自分がずっとドヤ顔で言ってたんじゃ…"},
        { "location": "1255/TALK"   , "narrator": "千羽鶴", "text": "ちーはいつまでも\n非攻略対象を夢見る\n子供じゃないの！！"},
        { "location": "1256/TALK"   , "narrator": "千羽鶴", "text": "非攻略対象という\n重く苦しい枷を、\n今こそ解き放つとき！！"},
        { "location": "1257/TALK"   , "narrator": "千羽鶴", "text": "というわけで、\n待ってても誰も\n宣言してくれないから――"},
        { "location": "1258/TALK"   , "narrator": "千羽鶴", "text": "自分で作ってみた！"},
        { "location": "1273/TALK"   , "narrator": "千羽鶴", "text": "<size=40>どうよ！</size>"},
        { "location": "1274/SEL"    , "narrator": "", "text": "やったーーーー！"},
        { "location": "1275/SEL"    , "narrator": "", "text": "手作り感満載やね"},
        { "location": "1276/ACT"    , "narrator": "", "text": "やったーーーー！"},
        { "location": "1277/TALK"   , "narrator": "千羽鶴", "text": "うむ！"},
        { "location": "1278/ACT"    , "narrator": "", "text": "手作り感満載やね"},
        { "location": "1279/TALK"   , "narrator": "千羽鶴", "text": "うむ！"},
        { "location": "1280/TALK"   , "narrator": "千羽鶴", "text": "ハンドメイドは\n暖かくていい！"},
        { "location": "1284/TALK"   , "narrator": "千羽鶴", "text": "と、まあ。"},
        { "location": "1285/TALK"   , "narrator": "千羽鶴", "text": "結局最後まで\nしんみりせずに終わって\nしまったわけだけど。"},
        { "location": "1286/SEL"    , "narrator": "", "text": "そんなちーが好き"},
        { "location": "1287/SEL"    , "narrator": "", "text": "情緒も何もないね"},
        { "location": "1288/ACT"    , "narrator": "", "text": "そんなちーが好き"},
        { "location": "1290/TALK"   , "narrator": "千羽鶴", "text": "私も、\n$handle$が\nすき。"},
        { "location": "1291/ACT"    , "narrator": "", "text": "情緒も何もないね"},
        { "location": "1293/TALK"   , "narrator": "千羽鶴", "text": "ほんとに。"},
        { "location": "1295/TALK"   , "narrator": "千羽鶴", "text": "けれども。"},
        { "location": "1297/TALK"   , "narrator": "千羽鶴", "text": "会えない期間も\nずっと、貴方のことを\n想ってるから。"},
        { "location": "1298/TALK"   , "narrator": "千羽鶴", "text": "毎日、毎日\n想ってるから。"},
        { "location": "1299/TALK"   , "narrator": "千羽鶴", "text": "それだけは、\nどうか忘れないで。"},
        { "location": "1301/TALK"   , "narrator": "千羽鶴", "text": "あと少しだけど\nどうか最後まで\n見届けてください。"},
        { "location": "1302/ACT"    , "narrator": "", "text": "いや、やっぱりなんでもない"},
        { "location": "1303/TALK"   , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "1306/TALK"   , "narrator": "千羽鶴", "text": "それじゃ、また。"},
        { "location": "836/DIALOG"  , "narrator": "INFO", "text": "<color=purple>【LIFEGATHER INFO】\n現在のセットアップ進捗情報</color>\n\n<size=30><color=blue>■現在のシステム稼働状況</color></size>\n　$destword$\n\n<size=30><color=blue>■現在のフェノメノン展開状況</color></size>\n$fenoactword$\n\n<size=30><color=blue>■発症ステータス情報</color></size>\n<size=25>以下の個体において、\n現在発症処理がアクティブです。</size>\n<color=green>　$ch01word$\n　$ch02word$\n　$ch03word$\n　$ch04word$\n　$ch05word$</color>\n\n<size=30><color=blue>■暗号鍵所持状況</color></size>\n<size=25>以下の個体において、\n暗号鍵がインストールされています。</size>\n<color=green>　$handle$\n$keygetword$</color>\n"},
        { "location": "1052/DIALOG" , "narrator": "Event/Dialog_EventPic", "text": "にゃぼちゃん！"},
