        { "location": "150/SEL"     , "narrator": "", "text": "よかったら話聞くよ"},
        { "location": "151/ACT"     , "narrator": "", "text": "おつかれさまです"},
        { "location": "152/TALK"    , "narrator": "アーヤ", "text": "ほんとよー"},
        { "location": "153/TALK"    , "narrator": "アーヤ", "text": "つかれたわー(；´Д｀)"},
        { "location": "154/ACT"     , "narrator": "", "text": "今日はゆっくり休んで"},
        { "location": "155/TALK"    , "narrator": "アーヤ", "text": "そうね"},
        { "location": "156/TALK"    , "narrator": "アーヤ", "text": "そうする(｡-_-｡)"},
        { "location": "157/TALK"    , "narrator": "アーヤ", "text": "おやすみ(^ε^)-☆!!"},
        { "location": "167/ACT"     , "narrator": "", "text": "よかったら話聞くよ"},
        { "location": "169/TALK"    , "narrator": "アーヤ", "text": "やさいいのね"},
        { "location": "170/TALK"    , "narrator": "アーヤ", "text": "あ"},
        { "location": "171/TALK"    , "narrator": "アーヤ", "text": "優しいのね"},
        { "location": "172/TALK"    , "narrator": "アーヤ", "text": "よ！！"},
        { "location": "174/TALK"    , "narrator": "アーヤ", "text": "つばめも少しは先頭に慣れてきたみたいだけど"},
        { "location": "176/SEL"     , "narrator": "", "text": "戦闘だよね"},
        { "location": "177/SEL"     , "narrator": "", "text": "先頭にいるの？"},
        { "location": "178/SEL"     , "narrator": "", "text": "アーヤ！　戦闘、戦闘！"},
        { "location": "179/ACT"     , "narrator": "", "text": "戦闘だよね"},
        { "location": "180/TALK"    , "narrator": "アーヤ", "text": "そうね"},
        { "location": "181/ACT"     , "narrator": "", "text": "先頭にいるの？"},
        { "location": "182/TALK"    , "narrator": "アーヤ", "text": "先頭じゃないわよ(--#)"},
        { "location": "183/TALK"    , "narrator": "アーヤ", "text": "わかってるくせに(-ω-;)"},
        { "location": "184/ACT"     , "narrator": "", "text": "アーヤ！　戦闘、戦闘！"},
        { "location": "185/TALK"    , "narrator": "アーヤ", "text": "えっ"},
        { "location": "186/TALK"    , "narrator": "アーヤ", "text": "戦闘ね"},
        { "location": "187/TALK"    , "narrator": "アーヤ", "text": "先頭！"},
        { "location": "189/TALK"    , "narrator": "アーヤ", "text": "防御力の高さだけじゃ辛い部分もあるのよ(T^T)"},
        { "location": "190/TALK"    , "narrator": "アーヤ", "text": "フォローしなきゃとか"},
        { "location": "191/TALK"    , "narrator": "アーヤ", "text": "色々ね"},
        { "location": "193/SEL"     , "narrator": "", "text": "そうなんだ"},
        { "location": "194/SEL"     , "narrator": "", "text": "アーヤは偉いよね"},
        { "location": "195/SEL"     , "narrator": "", "text": "ほっとけば"},
        { "location": "196/ACT"     , "narrator": "", "text": "そうなんだ"},
        { "location": "197/TALK"    , "narrator": "アーヤ", "text": "そうなのよー"},
        { "location": "198/ACT"     , "narrator": "", "text": "アーヤは偉いよね"},
        { "location": "200/TALK"    , "narrator": "アーヤ", "text": "まあ"},
        { "location": "201/TALK"    , "narrator": "アーヤ", "text": "偉いって言うほどじゃなくて"},
        { "location": "202/TALK"    , "narrator": "アーヤ", "text": "一番長いし"},
        { "location": "204/TALK"    , "narrator": "アーヤ", "text": "年上ってだけだけどね(*^o^*)"},
        { "location": "205/ACT"     , "narrator": "", "text": "ほっとけば"},
        { "location": "206/TALK"    , "narrator": "アーヤ", "text": "そうはいかないわよ"},
        { "location": "208/TALK"    , "narrator": "アーヤ", "text": "頑張ってもらいたいし"},
        { "location": "209/TALK"    , "narrator": "アーヤ", "text": "現状もどうにかしたいのよ"},
        { "location": "211/SEL"     , "narrator": "", "text": "そうだよね"},
        { "location": "212/SEL"     , "narrator": "", "text": "諦めたら楽になるぞ"},
        { "location": "213/ACT"     , "narrator": "", "text": "そうだよね"},
        { "location": "214/TALK"    , "narrator": "アーヤ", "text": "そうなのよ(｡-_-｡)"},
        { "location": "215/ACT"     , "narrator": "", "text": "諦めたら楽になるぞ"},
        { "location": "216/TALK"    , "narrator": "アーヤ", "text": "そういうわけにはいかないわよ（｀皿´ )"},
        { "location": "218/TALK"    , "narrator": "アーヤ", "text": "でも"},
        { "location": "219/TALK"    , "narrator": "アーヤ", "text": "１人で戦ってた頃より全然いい"},
        { "location": "221/TALK"    , "narrator": "アーヤ", "text": "別の苦労はあるけどね"}
