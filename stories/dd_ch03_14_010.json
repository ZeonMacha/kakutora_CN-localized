{
    "dir": "chap14/daydra/dd_ch03_14_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "14352",
        "cid": "gabriella",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "國政綾水と急接近！"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "アーヤＭＶ回１"},
        { "location": "19/TALK"   , "narrator": "ガブリエラ", "text": "アーヤ、帰ってる？\n今いいかしら？"},
        { "location": "23/TALK"   , "narrator": "ガブリエラ", "text": "…アーヤ？\nねえ、ちょっと。\nいないの？"},
        { "location": "27/TALK"   , "narrator": "ガブリエラ", "text": "借りてた本、\n返しに来たんだけど？"},
        { "location": "29/TALK"   , "narrator": "ガブリエラ", "text": "…入るわよ？"},
        { "location": "45/TALK"   , "narrator": "アーヤ", "text": "くー…すー…。"},
        { "location": "46/TALK"   , "narrator": "ガブリエラ", "text": "…入るわよ？"},
        { "location": "52/TALK"   , "narrator": "ガブリエラ", "text": "…何だ。\n寝てたのね。"},
        { "location": "53/TALK"   , "narrator": "ガブリエラ", "text": "そういえば、昨日は\nレポートを書くとか\n言ってたっけ。"},
        { "location": "54/TALK"   , "narrator": "ガブリエラ", "text": "もしかして、\n徹夜だったのかしら？"},
        { "location": "56/TALK"   , "narrator": "ガブリエラ", "text": "…お疲れ様。\n本、置いとくから。"},
        { "location": "57/TALK"   , "narrator": "アーヤ", "text": "…くー。"},
        { "location": "58/TALK"   , "narrator": "ガブリエラ", "text": "ふふっ、\n寝息で返事してる\nみたい。"},
        { "location": "59/TALK"   , "narrator": "アーヤ", "text": "くー…すー…。"},
        { "location": "60/TALK"   , "narrator": "ガブリエラ", "text": "…考えてみると、\nアーヤの寝顔って\n超レアかも。"},
        { "location": "61/TALK"   , "narrator": "ガブリエラ", "text": "出撃の後とか、\nあたし達は車の中で\n寝ちゃうけど――"},
        { "location": "62/TALK"   , "narrator": "ガブリエラ", "text": "運転してるアーヤは\nいつも起きてるし。"},
        { "location": "63/TALK"   , "narrator": "ガブリエラ", "text": "そっか…。\nアーヤってこんな\n顔で眠るのね…。"},
        { "location": "64/TALK"   , "narrator": "アーヤ", "text": "くー…。"},
        { "location": "65/TALK"   , "narrator": "ガブリエラ", "text": "…アーヤって――"},
        { "location": "67/TALK"   , "narrator": "ガブリエラ", "text": "やっぱり、美人よね。"},
        { "location": "72/TALK"   , "narrator": "ガブリエラ", "text": "初めてアーヤのこと\n見たのって、かなり\n前だったっけ。"},
        { "location": "73/TALK"   , "narrator": "ガブリエラ", "text": "その時も美人だし、\nかっこいいな、って\n思ったけど――"},
        { "location": "76/TALK"   , "narrator": "ガブリエラ", "text": "今はそれ以上に\n美人だし…かっこよく\n見えるかも。"},
        { "location": "77/TALK"   , "narrator": "ガブリエラ", "text": "戦ってるとこ、\n間近で見てるから\nかしら？"},
        { "location": "78/TALK"   , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "79/TALK"   , "narrator": "ガブリエラ", "text": "寝てても美人で\nかっこいいとか、\nズルいわ…。"},
        { "location": "80/SEL"    , "narrator": "", "text": "惚れてるの？"},
        { "location": "81/SEL"    , "narrator": "", "text": "イタズラしちゃえ"},
        { "location": "82/ACT"    , "narrator": "", "text": "惚れてるの？"},
        { "location": "91/TALK"   , "narrator": "ガブリエラ", "text": "それはないから"},
        { "location": "92/TALK"   , "narrator": "ガブリエラ", "text": "ありえないでしょ？"},
        { "location": "93/TALK"   , "narrator": "ガブリエラ", "text": "まあ"},
        { "location": "94/TALK"   , "narrator": "ガブリエラ", "text": "そういう人もいるのはわかるわ"},
        { "location": "95/TALK"   , "narrator": "ガブリエラ", "text": "女の子同士の"},
        { "location": "96/TALK"   , "narrator": "ガブリエラ", "text": "百合ってやつよね？"},
        { "location": "97/TALK"   , "narrator": "ガブリエラ", "text": "でも私はノーマルだから！"},
        { "location": "98/TALK"   , "narrator": "ガブリエラ", "text": "ちょっと美人でかっこいいなって"},
        { "location": "99/TALK"   , "narrator": "ガブリエラ", "text": "思っただけよ！"},
        { "location": "104/TALK"  , "narrator": "ガブリエラ", "text": "…って、これじゃ\nムキになって言い訳\nしてるみたい。"},
        { "location": "105/TALK"  , "narrator": "ガブリエラ", "text": "それに、いつの間にか\nこんな近くまで\n寄ってるし…。"},
        { "location": "106/TALK"  , "narrator": "ガブリエラ", "text": "…何やってんだろ。\n本は返したんだし、\nもう帰ろ…。"},
        { "location": "109/TALK"  , "narrator": "アーヤ", "text": "んんっ…誰？"},
        { "location": "110/TALK"  , "narrator": "ガブリエラ", "text": "えっ！？\nあっ、きゃぁ！！"},
        { "location": "112/TALK"  , "narrator": "アーヤ", "text": "っ！？　危ない！！"},
        { "location": "116/TALK"  , "narrator": "ガブリエラ", "text": "むぎゅっ！"},
        { "location": "117/TALK"  , "narrator": "アーヤ", "text": "っと…危なかったわ。"},
        { "location": "118/TALK"  , "narrator": "ガブリエラ", "text": "えっ…えっ？"},
        { "location": "146/TALK"  , "narrator": "ガブリエラ", "text": "えぇーっ！？"},
        { "location": "147/TALK"  , "narrator": "アーヤ", "text": "ビックリしたわ…。\nギャヴィ、大丈夫？\nケガしてない？"},
        { "location": "148/TALK"  , "narrator": "ガブリエラ", "text": "えっ？　あ、えと…、\nどうなってんの？"},
        { "location": "149/TALK"  , "narrator": "アーヤ", "text": "ちょっと、大丈夫？\n頭打ったりとか\nしてない？"},
        { "location": "150/TALK"  , "narrator": "ガブリエラ", "text": "…あ、う、うん。\n大丈夫…ありがと。"},
        { "location": "151/TALK"  , "narrator": "アーヤ", "text": "そう…。"},
        { "location": "152/TALK"  , "narrator": "アーヤ", "text": "それはそうと――"},
        { "location": "153/TALK"  , "narrator": "アーヤ", "text": "寝てる人に\n飛びかかったりしたら\n危ないでしょ！？"},
        { "location": "155/TALK"  , "narrator": "ガブリエラ", "text": "ちょ！？　飛びかかる\nって何よ！？"},
        { "location": "156/TALK"  , "narrator": "ガブリエラ", "text": "急にアーヤが声かけた\nから、ビックリして\n転んだんじゃない！"},
        { "location": "157/TALK"  , "narrator": "アーヤ", "text": "それにしたって、\n勝手に入って来るのは\nどうなの？"},
        { "location": "158/TALK"  , "narrator": "ガブリエラ", "text": "仕方ないでしょ！？\n大体、明るいうちから\n寝てる方が悪いのよ。"},
        { "location": "159/TALK"  , "narrator": "アーヤ", "text": "いや、全然答えに\nなってないんだけど？"},
        { "location": "160/TALK"  , "narrator": "アーヤ", "text": "…っていうか、\nちょっと待って。"},
        { "location": "161/TALK"  , "narrator": "ガブリエラ", "text": "どうかし…っ！？"},
        { "location": "162/TALK"  , "narrator": "ガブリエラ", "text": "ちょ、えっ！？\nな、何やってんの、\nアーヤ？"},
        { "location": "163/TALK"  , "narrator": "アーヤ", "text": "動かないで。\nすぐ済むから。"},
        { "location": "164/TALK"  , "narrator": "ガブリエラ", "text": "で、でも…、そんな\nあちこち触られたら、\nその…あっ！"},
        { "location": "165/TALK"  , "narrator": "アーヤ", "text": "くすぐったかった？\nもう少しだから…。"},
        { "location": "167/TALK"  , "narrator": "ガブリエラ", "text": "うっ、うぅ…。"},
        { "location": "168/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "169/TALK"  , "narrator": "アーヤ", "text": "やっぱり。\nギャヴィ、あなた――"},
        { "location": "170/TALK"  , "narrator": "アーヤ", "text": "ちゃんとご飯\n食べてる？"},
        { "location": "171/TALK"  , "narrator": "ガブリエラ", "text": "…え？"},
        { "location": "172/TALK"  , "narrator": "アーヤ", "text": "こんなに身体軽いし、\nほら、この辺の\n肉付きとか…。"},
        { "location": "173/TALK"  , "narrator": "ガブリエラ", "text": "ひゃぅっ！"},
        { "location": "175/TALK"  , "narrator": "アーヤ", "text": "太るのも問題だけど、\n痩せ過ぎも毒よ？"},
        { "location": "176/TALK"  , "narrator": "アーヤ", "text": "ケガだってしやすく\nなるんだから。\nわかってるの？"},
        { "location": "177/TALK"  , "narrator": "ガブリエラ", "text": "うっ…、\nあ、アーヤの…。"},
        { "location": "179/TALK"  , "narrator": "ガブリエラ", "text": "アーヤの、バカー！！"},
        { "location": "195/TALK"  , "narrator": "アーヤ", "text": "…？\n何怒ってるのかしら？"},
        { "location": "196/TALK"  , "narrator": "アーヤ", "text": "まあ、いっか…。\nもうひと眠りしよ。\nふぁ～…。"},
        { "location": "197/ACT"   , "narrator": "", "text": "イタズラしちゃえ"},
        { "location": "206/TALK"  , "narrator": "ガブリエラ", "text": "それ、面白そうね"},
        { "location": "207/TALK"  , "narrator": "ガブリエラ", "text": "$handle$がしてくれればだけど"},
        { "location": "208/TALK"  , "narrator": "ガブリエラ", "text": "考えなくてもわかるでしょ？"},
        { "location": "209/TALK"  , "narrator": "ガブリエラ", "text": "そんなことしたら"},
        { "location": "210/TALK"  , "narrator": "ガブリエラ", "text": "後で絶対怒られちゃうわ"},
        { "location": "211/TALK"  , "narrator": "ガブリエラ", "text": "私は嫌よ"},
        { "location": "214/TALK"  , "narrator": "ガブリエラ", "text": "アーヤって、冗談が\nわからないしね。"},
        { "location": "216/TALK"  , "narrator": "アーヤ", "text": "んぅー…すー…。"},
        { "location": "218/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "219/TALK"  , "narrator": "ガブリエラ", "text": "それにしても、\nやっぱアーヤの髪って\nサラサラよね…。"},
        { "location": "220/TALK"  , "narrator": "ガブリエラ", "text": "…髪くらいなら、\n触っても起きない\nかな？"},
        { "location": "221/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "222/TALK"  , "narrator": "ガブリエラ", "text": "わぁ…、なんか、\n指が気持ちいい…。"},
        { "location": "223/TALK"  , "narrator": "ガブリエラ", "text": "うちで一番の肉体派の\nくせに、女子力まで\n高いなんて――"},
        { "location": "225/TALK"  , "narrator": "ガブリエラ", "text": "ちょっとズルいわ。\nチートも程々に\nしなさいよ…。"},
        { "location": "226/TALK"  , "narrator": "アーヤ", "text": "くー…んっ…。"},
        { "location": "227/TALK"  , "narrator": "ガブリエラ", "text": "ぷっ…新発見。\nアーヤのほっぺは\nぷーにぷにー…。"},
        { "location": "230/TALK"  , "narrator": "アーヤ", "text": "んっ、んん～っ…。"},
        { "location": "231/TALK"  , "narrator": "ガブリエラ", "text": "やばっ！\n起きちゃった！？"},
        { "location": "233/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "234/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "236/TALK"  , "narrator": "アーヤ", "text": "くー…。"},
        { "location": "237/TALK"  , "narrator": "ガブリエラ", "text": "ほっ…よかった…。"},
        { "location": "238/TALK"  , "narrator": "ガブリエラ", "text": "…それにしても、\nこういう無防備な\nアーヤも――"},
        { "location": "240/TALK"  , "narrator": "ガブリエラ", "text": "結構カワイイかも。\nふふっ…。"},
        { "location": "241/TALK"  , "narrator": "ガブリエラ", "text": "でも、こんなに\n触られてるのに\n起きないなんて――"},
        { "location": "242/TALK"  , "narrator": "ガブリエラ", "text": "剣士失格よ。\n気配くらい読めなくて\nどうするのよ？"},
        { "location": "246/TALK"  , "narrator": "アーヤ", "text": "…気配読むとか、\n普通に無理だから。"},
        { "location": "247/TALK"  , "narrator": "ガブリエラ", "text": "きゃぁっ！？"},
        { "location": "250/TALK"  , "narrator": "ガブリエラ", "text": "ちょ、何！？\n起きてたの！？"},
        { "location": "253/TALK"  , "narrator": "アーヤ", "text": "あれだけ遊ばれれば\n誰だって起きるわよ。"},
        { "location": "254/TALK"  , "narrator": "アーヤ", "text": "すぐにやめると\n思って寝たふり\nしてたけど――"},
        { "location": "255/TALK"  , "narrator": "アーヤ", "text": "全然やめようと\nしないんだから…。"},
        { "location": "256/TALK"  , "narrator": "ガブリエラ", "text": "そ、それならさっさと\n起きなさいよ！"},
        { "location": "257/TALK"  , "narrator": "ガブリエラ", "text": "気付かないで遊んでた\nあたしがバカみたい\nじゃない…。"},
        { "location": "258/TALK"  , "narrator": "アーヤ", "text": "うーん、そう思ったん\nだけどね――"},
        { "location": "260/TALK"  , "narrator": "アーヤ", "text": "珍しくギャヴィが、\nカワイイ、とか言って\n褒めてくれたでしょ？"},
        { "location": "261/TALK"  , "narrator": "ガブリエラ", "text": "っ！？"},
        { "location": "262/TALK"  , "narrator": "アーヤ", "text": "眠ってればもう少し\n褒めてもらえるかな、\nって思ったのよ。"},
        { "location": "264/TALK"  , "narrator": "ガブリエラ", "text": "なっ！？\nうっ、うぅぅ…。"},
        { "location": "265/TALK"  , "narrator": "ガブリエラ", "text": "ぬ、盗み聞きとか\n信じらんない！"},
        { "location": "266/TALK"  , "narrator": "ガブリエラ", "text": "アーヤのバカ！\nエッチ、スケベー！！"},
        { "location": "275/TALK"  , "narrator": "アーヤ", "text": "…寝てる人に好き放題\nした人のセリフ？"},
        { "location": "278/TALK"  , "narrator": "アーヤ", "text": "…まあ、いっか。\nもうひと眠りしよ…。"},
        { "location": "15/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>7月9日　5:11 PM</color>\nとある休日の午後、寮「とらいあんぐる」アーヤの部屋前。"}
    ]
}
