        "title": "005 メインストーリー",
        "sub_title": "想定外の想定値＜後編＞"
    },
    "entry":
    [
        { "location": "452/SCENARIO", "narrator": "", "text": "１００パーセントなんてないけど"},
        { "location": "467/TALK"    , "narrator": "アーヤ", "text": "つばめはクラン達を\n退避させた後\nどこに向かったの？"},
        { "location": "468/TALK"    , "narrator": "アーヤ", "text": "普段使わない廊下だから\n迷ってるのかも…。"},
        { "location": "469/TALK"    , "narrator": "アーヤ", "text": "ならこの辺りに\nいてもいいはず…。"},
        { "location": "470/SEL"     , "narrator": "", "text": "いや、逃げようよ"},
        { "location": "471/SEL"     , "narrator": "", "text": "二階にいるよ…？"},
        { "location": "472/ACT"     , "narrator": "", "text": "二階にいるよ…？"},
        { "location": "473/ACT"     , "narrator": "", "text": "二階にいるよ…？"},
        { "location": "490/TALK"    , "narrator": "アーヤ", "text": "ごめんね"},
        { "location": "492/TALK"    , "narrator": "アーヤ", "text": "相手できないから"},
        { "location": "503/TALK"    , "narrator": "アーヤ", "text": "最後に見たのは\nどこだっけ？"},
        { "location": "504/SEL"     , "narrator": "", "text": "いいから逃げようよ"},
        { "location": "505/SEL"     , "narrator": "", "text": "二階だってば"},
        { "location": "506/ACT"     , "narrator": "", "text": "二階だってば"},
        { "location": "507/ACT"     , "narrator": "", "text": "二階だってば"},
        { "location": "536/TALK"    , "narrator": "アーヤ", "text": "一旦別れた場所まで\n戻った方がいい？"},
        { "location": "537/SEL"     , "narrator": "", "text": "危険すぎるでしょ"},
        { "location": "538/SEL"     , "narrator": "", "text": "二階上がって！"},
        { "location": "539/ACT"     , "narrator": "", "text": "二階上がって！"},
        { "location": "540/ACT"     , "narrator": "", "text": "二階上がって！"},
        { "location": "546/TALK"    , "narrator": "アーヤ", "text": "えっ！？"},
        { "location": "547/TALK"    , "narrator": "通常攻撃隊Ａ", "text": "いたぞ！"},
        { "location": "548/TALK"    , "narrator": "アーヤ", "text": "まずい！"},
        { "location": "550/TALK"    , "narrator": "アーヤ", "text": "とりあえず\nシャッターを！"},
        { "location": "555/TALK"    , "narrator": "アーヤ", "text": "もうこれ以上は\n探せない…！"},
        { "location": "575/TALK"    , "narrator": "ガブリエラ", "text": "お帰りなさい。"},
        { "location": "576/TALK"    , "narrator": "ガブリエラ", "text": "って、つばめは…。"},
        { "location": "578/TALK"    , "narrator": "アーヤ", "text": "ごめんなさい。"},
        { "location": "579/TALK"    , "narrator": "ガブリエラ", "text": "えっ！？"},
        { "location": "580/TALK"    , "narrator": "アーヤ", "text": "すぐに通常攻撃隊が\nやってくるわ。"},
        { "location": "581/TALK"    , "narrator": "アーヤ", "text": "アーケロンに\n乗って、ギャヴィ。"},
        { "location": "582/TALK"    , "narrator": "ガブリエラ", "text": "だったら\n今度はあたしが\n探しに行くわ！"},
        { "location": "583/TALK"    , "narrator": "アーヤ", "text": "ダメよ！"},
        { "location": "584/TALK"    , "narrator": "ガブリエラ", "text": "だって\nつばめが…！"},
        { "location": "585/TALK"    , "narrator": "アーヤ", "text": "本当にごめん。\n後でいくらでも\n怒っていいわ。"},
        { "location": "586/TALK"    , "narrator": "アーヤ", "text": "でもここで\nギャヴィまでも\n守れなかったら。"},
        { "location": "587/TALK"    , "narrator": "アーヤ", "text": "私はリーダーを\n続けられない。"},
        { "location": "588/TALK"    , "narrator": "ガブリエラ", "text": "……………………。"},
        { "location": "589/TALK"    , "narrator": "アーヤ", "text": "乗り込んだらすぐに\nみやびを迎えに行くわ。"},
        { "location": "590/TALK"    , "narrator": "ガブリエラ", "text": "…もう！"},
        { "location": "619/TALK"    , "narrator": "アーヤ", "text": "……ごめんね。"},
        { "location": "620/TALK"    , "narrator": "アーヤ", "text": "いくら謝っても\n謝り足りないとは\n思うけど。"},
        { "location": "621/TALK"    , "narrator": "ガブリエラ", "text": "………………。"},
        { "location": "623/TALK"    , "narrator": "みやび", "text": "いや。\n現時点では\n一番えい選択やき。"},
        { "location": "624/TALK"    , "narrator": "みやび", "text": "そこはもう\n仕方がないろう。"},
        { "location": "625/TALK"    , "narrator": "みやび", "text": "音羽はこうやって\n連れ出せた\nわけやし。"},
        { "location": "626/TALK"    , "narrator": "みやび", "text": "反撃のチャンスを\n伺えばええだけぞね。"},
        { "location": "627/TALK"    , "narrator": "アーヤ", "text": "ごめんね、ギャヴィ。"},
        { "location": "628/TALK"    , "narrator": "アーヤ", "text": "偉そうなことを\n言ったくせに\nこんな結果になって。"},
        { "location": "629/TALK"    , "narrator": "ガブリエラ", "text": "…………別に。"},
        { "location": "631/TALK"    , "narrator": "みやび", "text": "これから憧れの\nアーヤの実家に\n行くんやき。"},
        { "location": "632/TALK"    , "narrator": "みやび", "text": "もう少し楽しい顔\nしてもええと\n思うちや。"},
        { "location": "635/TALK"    , "narrator": "ガブリエラ", "text": "あんた本っ当に\n呑気ね！"},
        { "location": "636/TALK"    , "narrator": "みやび", "text": "いや？　先輩の\n余裕を見せとる\nだけぞね。"},
        { "location": "638/TALK"    , "narrator": "ガブリエラ", "text": "まるであたしに\n余裕がない\nみたいじゃない！"},
        { "location": "639/TALK"    , "narrator": "みやび", "text": "…そんなつもりは\nないけんどねえ？"},
        { "location": "640/TALK"    , "narrator": "ガブリエラ", "text": "わかってて\n言ってるでしょ！"},
        { "location": "641/TALK"    , "narrator": "アーヤ", "text": "こらこら、\n喧嘩しないの。"},
        { "location": "642/TALK"    , "narrator": "アーヤ", "text": "みやびがいてくれて\nよかったわ……。"},
        { "location": "643/TALK"    , "narrator": "アーヤ", "text": "悔しいからって\n余裕をなくしちゃ\nダメよね……。"},
        { "location": "644/TALK"    , "narrator": "アーヤ", "text": "絶対に助ける。\nだから無事でいてね\nつばめ……。"},
        { "location": "656/DIALOG"  , "narrator": "Dialog_chapter_ch02", "text": "【MV EXE_KAGURa】"}
    ]
}
