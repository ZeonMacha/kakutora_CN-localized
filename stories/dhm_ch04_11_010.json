{
    "dir": "chap11/himegoto/dhm_ch04_11_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "11457",
        "cid": "miyabi",
        "title": "Extra007 ヒメゴトチャット",
        "sub_title": "スイーツの甘きことなし"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "004_スイーツの甘きことなし"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "サクサクほろほろサックサク―"},
        { "location": "33/TALK"   , "narrator": "みやび", "text": "これがクッキーの信条なり"},
        { "location": "34/TALK"   , "narrator": "みやび", "text": "駄菓子菓子"},
        { "location": "35/TALK"   , "narrator": "みやび", "text": "自作クッキーは"},
        { "location": "36/TALK"   , "narrator": "みやび", "text": "そこが大いに不足しておったのじゃよ"},
        { "location": "38/SEL"    , "narrator": "", "text": "不味かった、ってこと？"},
        { "location": "39/SEL"    , "narrator": "", "text": "不味くないならいいじゃん"},
        { "location": "40/SEL"    , "narrator": "", "text": "違うの作ったら？"},
        { "location": "41/ACT"    , "narrator": "", "text": "不味かった、ってこと？"},
        { "location": "42/TALK"   , "narrator": "みやび", "text": "まずいといえばまずい"},
        { "location": "43/TALK"   , "narrator": "みやび", "text": "いや"},
        { "location": "44/TALK"   , "narrator": "みやび", "text": "味自体はまずくはないが"},
        { "location": "45/TALK"   , "narrator": "みやび", "text": "サクサクさくさくサックサク―"},
        { "location": "46/TALK"   , "narrator": "みやび", "text": "そんな歯ごたえ的な何かが足りん"},
        { "location": "47/TALK"   , "narrator": "みやび", "text": "しかし確信が持てず、全部喰らってしまったのじゃよ"},
        { "location": "48/TALK"   , "narrator": "みやび", "text": "カロリー……"},
        { "location": "49/TALK"   , "narrator": "みやび", "text": "消費カロリーが怖い！！！！！"},
        { "location": "50/ACT"    , "narrator": "", "text": "不味くないならいいじゃん"},
        { "location": "51/TALK"   , "narrator": "みやび", "text": "そういう説もあるな、相棒"},
        { "location": "52/TALK"   , "narrator": "みやび", "text": "しかしそれはうちの法律では違法である"},
        { "location": "53/TALK"   , "narrator": "みやび", "text": "すなわち罪！"},
        { "location": "54/ACT"    , "narrator": "", "text": "違うの作ったら？"},
        { "location": "56/TALK"   , "narrator": "みやび", "text": "ふむ"},
        { "location": "57/TALK"   , "narrator": "みやび", "text": "建設的な意見"},
        { "location": "58/TALK"   , "narrator": "みやび", "text": "しかし"},
        { "location": "59/TALK"   , "narrator": "みやび", "text": "クッキーごときが攻略できずケーキなど作れようか？"},
        { "location": "61/TALK"   , "narrator": "みやび", "text": "いや"},
        { "location": "62/TALK"   , "narrator": "みやび", "text": "難易度を下げてプリンあたりにするか"},
        { "location": "64/TALK"   , "narrator": "みやび", "text": "よし"},
        { "location": "65/TALK"   , "narrator": "みやび", "text": "貴殿の意見を"},
        { "location": "66/TALK"   , "narrator": "みやび", "text": "前向きに検討しよう"}
    ]
}
