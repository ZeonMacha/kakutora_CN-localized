        "title": "らぶとーく 第27話",
        "sub_title": "ハッカーの良心などという宣言"
    },
    "entry":
    [
        { "location": "513/SCENARIO", "narrator": "", "text": "ハッカーの良心などという宣言"},
        { "location": "523/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "535/TALK"    , "narrator": "みやび", "text": "暇人参上！"},
        { "location": "536/TALK"    , "narrator": "みやび", "text": "どうする？"},
        { "location": "538/SEL"     , "narrator": "", "text": "お話でもする？"},
        { "location": "539/SEL"     , "narrator": "", "text": "バイトは？"},
        { "location": "540/SEL"     , "narrator": "", "text": "たたかう"},
        { "location": "541/ACT"     , "narrator": "", "text": "お話でもする？"},
        { "location": "542/TALK"    , "narrator": "みやび", "text": "暇つぶしにお喋り？"},
        { "location": "543/TALK"    , "narrator": "みやび", "text": "ワンパターン過ぎや"},
        { "location": "544/TALK"    , "narrator": "みやび", "text": "萎える"},
        { "location": "546/TALK"    , "narrator": "みやび", "text": "ショボーン"},
        { "location": "547/ACT"     , "narrator": "", "text": "バイトは？"},
        { "location": "548/TALK"    , "narrator": "みやび", "text": "作業は終えた"},
        { "location": "549/TALK"    , "narrator": "みやび", "text": "やることないから待機中"},
        { "location": "550/TALK"    , "narrator": "みやび", "text": "仕事が来るまで待ってるだけの精神的に辛いお仕事です"},
        { "location": "551/ACT"     , "narrator": "", "text": "たたかう"},
        { "location": "552/TALK"    , "narrator": "みやび", "text": "相棒の攻撃"},
        { "location": "553/TALK"    , "narrator": "みやび", "text": "うちの暇にはダメージを与えられん"},
        { "location": "554/TALK"    , "narrator": "みやび", "text": "ダメやったね"},
        { "location": "556/TALK"    , "narrator": "みやび", "text": "おっ"},
        { "location": "557/TALK"    , "narrator": "みやび", "text": "ちっくと待ちぃ"},
        { "location": "575/TALK"    , "narrator": "つばめ", "text": "あっ、みやびさん。\nお疲れ様です。"},
        { "location": "577/TALK"    , "narrator": "みやび", "text": "つばめちゃん、\nえいところに来た。"},
        { "location": "578/TALK"    , "narrator": "みやび", "text": "今な、相棒と会話しゆう\nところなんやが――"},
        { "location": "579/TALK"    , "narrator": "みやび", "text": "つばめちゃんも一緒に\n入ってくれんか？"},
        { "location": "580/TALK"    , "narrator": "つばめ", "text": "え？　わたしもですか？"},
        { "location": "581/TALK"    , "narrator": "みやび", "text": "うん"},
        { "location": "582/TALK"    , "narrator": "みやび", "text": "まあ、ちっくと興味が\nあってな…。"},
        { "location": "583/TALK"    , "narrator": "みやび", "text": "やき、ちっくとでえいき、\n入ってくれんか？"},
        { "location": "585/TALK"    , "narrator": "つばめ", "text": "それはまあ、構いません\nけど…。"},
        { "location": "587/TALK"    , "narrator": "みやび", "text": "よし、決まりや。"},
        { "location": "593/TALK"    , "narrator": "みやび", "text": "ちゅうわけやき"},
        { "location": "594/TALK"    , "narrator": "みやび", "text": "今からつばめちゃんも来るちや"},
        { "location": "596/SEL"     , "narrator": "", "text": "呼ぶ必要ないのに"},
        { "location": "597/ACT"     , "narrator": "", "text": "呼ぶ必要ないのに"},
        { "location": "599/TALK"    , "narrator": "みやび", "text": "うちにはある"},
        { "location": "600/TALK"    , "narrator": "みやび", "text": "あるから呼んだ"},
        { "location": "602/TALK"    , "narrator": "システム", "text": "『つばめさんが入室しました』"},
        { "location": "603/TALK"    , "narrator": "つばめ", "text": "おじゃまします"},
        { "location": "605/TALK"    , "narrator": "みやび", "text": "つばめちゃん参上"},
        { "location": "607/SEL"     , "narrator": "", "text": "こんにちは"},
        { "location": "608/ACT"     , "narrator": "", "text": "こんにちは"},
        { "location": "610/TALK"    , "narrator": "つばめ", "text": "こんにちは、$handle$さん"},
        { "location": "611/TALK"    , "narrator": "つばめ", "text": "それでみやびさん"},
        { "location": "612/TALK"    , "narrator": "つばめ", "text": "どういう用事ですか"},
        { "location": "614/TALK"    , "narrator": "みやび", "text": "難しいことやない"},
        { "location": "615/TALK"    , "narrator": "みやび", "text": "普段通りにお喋りしてえいよ"},
        { "location": "616/TALK"    , "narrator": "つばめ", "text": "そう言われても"},
        { "location": "617/TALK"    , "narrator": "つばめ", "text": "今は話題もないですし"},
        { "location": "619/TALK"    , "narrator": "みやび", "text": "暇つぶしの雑談でもえいき"},
        { "location": "620/TALK"    , "narrator": "みやび", "text": "楽しもう"},
        { "location": "621/TALK"    , "narrator": "つばめ", "text": "雑談ですか"},
        { "location": "622/TALK"    , "narrator": "つばめ", "text": "頑張ってみます"},
        { "location": "625/SEL"     , "narrator": "", "text": "困るよね"},
        { "location": "626/SEL"     , "narrator": "", "text": "ちょっと付き合ってね"},
        { "location": "627/SEL"     , "narrator": "", "text": "相変わらず不思議ちゃんだよね"},
        { "location": "628/ACT"     , "narrator": "", "text": "困るよね"},
        { "location": "629/TALK"    , "narrator": "みやび", "text": "待て"},
        { "location": "631/TALK"    , "narrator": "みやび", "text": "何が困るのだ？"},
        { "location": "633/SEL"     , "narrator": "", "text": "つばめが困ってるでしょ？"},
        { "location": "634/ACT"     , "narrator": "", "text": "つばめが困ってるでしょ？"},
        { "location": "636/TALK"    , "narrator": "みやび", "text": "別に困るようなこと言ってない"},
        { "location": "637/TALK"    , "narrator": "みやび", "text": "雑談がそんなに難しいか？"},
        { "location": "638/TALK"    , "narrator": "みやび", "text": "これも雑談やが"},
        { "location": "640/TALK"    , "narrator": "つばめ", "text": "$handle$さん"},
        { "location": "641/TALK"    , "narrator": "つばめ", "text": "心配してくれてありがと"},
        { "location": "642/TALK"    , "narrator": "つばめ", "text": "でも"},
        { "location": "643/TALK"    , "narrator": "つばめ", "text": "全然困ってないから大丈夫だよ"},
        { "location": "644/TALK"    , "narrator": "つばめ", "text": "それに"},
        { "location": "645/TALK"    , "narrator": "つばめ", "text": "みやびさんのことだから"},
        { "location": "646/TALK"    , "narrator": "つばめ", "text": "きっと何か考えがあってのことだと思うし"},
        { "location": "649/SEL"     , "narrator": "", "text": "つばめは良い子だ"},
        { "location": "650/ACT"     , "narrator": "", "text": "つばめは良い子だ"},
        { "location": "652/TALK"    , "narrator": "つばめ", "text": "ありがと"},
        { "location": "657/ACT"     , "narrator": "", "text": "ちょっと付き合ってね"},
        { "location": "658/TALK"    , "narrator": "みやび", "text": "他人行儀な"},
        { "location": "659/TALK"    , "narrator": "みやび", "text": "いつまでも付き合うぞ！"},
        { "location": "661/SEL"     , "narrator": "", "text": "つばめに言ったんだけど"},
        { "location": "662/ACT"     , "narrator": "", "text": "つばめに言ったんだけど"},
        { "location": "664/TALK"    , "narrator": "みやび", "text": "うちには無しか？"},
        { "location": "665/TALK"    , "narrator": "みやび", "text": "のけ者か？"},
        { "location": "666/TALK"    , "narrator": "みやび", "text": "邪魔者扱いか？"},
        { "location": "668/SEL"     , "narrator": "", "text": "そうじゃないけど、つばめを困らせてるし"},
        { "location": "669/ACT"     , "narrator": "", "text": "そうじゃないけど、つばめを困らせてるし"},
        { "location": "671/TALK"    , "narrator": "つばめ", "text": "そんなことないよ"},
        { "location": "672/TALK"    , "narrator": "つばめ", "text": "確かによくわからない行動だけど"},
        { "location": "673/TALK"    , "narrator": "つばめ", "text": "それがみやびさんっぽいし"},
        { "location": "674/TALK"    , "narrator": "つばめ", "text": "わたしは全然困ってないから"},
        { "location": "677/SEL"     , "narrator": "", "text": "気を使わせてごめん"},
        { "location": "678/ACT"     , "narrator": "", "text": "気を使わせてごめん"},
        { "location": "680/TALK"    , "narrator": "つばめ", "text": "ううん"},
        { "location": "681/TALK"    , "narrator": "つばめ", "text": "$handle$さんとお話しできるの嬉しいから"},
        { "location": "682/TALK"    , "narrator": "つばめ", "text": "本当に気は使ってないよ"},
        { "location": "686/ACT"     , "narrator": "", "text": "相変わらず不思議ちゃんだよね"},
        { "location": "687/TALK"    , "narrator": "みやび", "text": "同意"},
        { "location": "688/TALK"    , "narrator": "みやび", "text": "つばめちゃんの良い子さは"},
        { "location": "690/TALK"    , "narrator": "みやび", "text": "不思議ちゃんクラス"},
        { "location": "691/TALK"    , "narrator": "つばめ", "text": "そうなんですか？"},
        { "location": "694/SEL"     , "narrator": "", "text": "いや、不思議なのはみやび"},
        { "location": "695/ACT"     , "narrator": "", "text": "いや、不思議なのはみやび"},
        { "location": "697/TALK"    , "narrator": "みやび", "text": "は？"},
        { "location": "698/TALK"    , "narrator": "みやび", "text": "うちのどこが不思議？"},
        { "location": "699/TALK"    , "narrator": "みやび", "text": "今不思議なことしとらん"},
        { "location": "701/SEL"     , "narrator": "", "text": "自覚無しな辺り、本物だ"},
        { "location": "702/ACT"     , "narrator": "", "text": "自覚無しな辺り、本物だ"},
        { "location": "704/TALK"    , "narrator": "みやび", "text": "誰が本物や"},
        { "location": "706/TALK"    , "narrator": "つばめ", "text": "あの！"},
        { "location": "707/TALK"    , "narrator": "つばめ", "text": "そう思うのって"},
        { "location": "708/TALK"    , "narrator": "つばめ", "text": "みやびさんが凄く頭が良いからだと思います"},
        { "location": "709/TALK"    , "narrator": "つばめ", "text": "だから私から見ても"},
        { "location": "710/TALK"    , "narrator": "つばめ", "text": "不思議なくらい凄い人だなぁって"},
        { "location": "711/TALK"    , "narrator": "つばめ", "text": "思う時ありますし"},
        { "location": "714/SEL"     , "narrator": "", "text": "やっぱりつばめは良い子だ"},
        { "location": "715/ACT"     , "narrator": "", "text": "やっぱりつばめは良い子だ"},
        { "location": "717/TALK"    , "narrator": "つばめ", "text": "そうかな？"},
        { "location": "718/TALK"    , "narrator": "つばめ", "text": "そんなことないよ"},
        { "location": "722/TALK"    , "narrator": "みやび", "text": "なんか"},
        { "location": "723/TALK"    , "narrator": "みやび", "text": "あれやね"},
        { "location": "724/TALK"    , "narrator": "みやび", "text": "思うてた反応と違うわ"},
        { "location": "725/TALK"    , "narrator": "つばめ", "text": "え？"},
        { "location": "731/TALK"    , "narrator": "つばめ", "text": "あれ？"},
        { "location": "735/TALK"    , "narrator": "つばめ", "text": "ど、どうしたんですか？\n急に退出して…。"},
        { "location": "737/TALK"    , "narrator": "みやび", "text": "…別に。\n雑談やき、いつ終わるのも\n自由や。"},
        { "location": "738/TALK"    , "narrator": "みやび", "text": "ちゅうわけで、解散や。"},
        { "location": "739/TALK"    , "narrator": "つばめ", "text": "でも、反応がどうとか\n言ってたのに、\n途中で良いんですか？"},
        { "location": "741/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "743/TALK"    , "narrator": "みやび", "text": "ああ、もうえい。\nどうでもえいがよ、\nそんなもん。"},
        { "location": "745/TALK"    , "narrator": "つばめ", "text": "そ、そうですか…。"},
        { "location": "746/TALK"    , "narrator": "つばめ", "text": "…みやびさん、\n少し機嫌悪そうかも。"},
        { "location": "748/TALK"    , "narrator": "つばめ", "text": "わたし、何か怒らせる\nようなことしちゃった\nかな…？"}
    ]
}
