        "title": "らぶとーく 第48話",
        "sub_title": "口止めとは生意気な（アーヤ）"
    },
    "entry":
    [
        { "location": "144/SCENARIO", "narrator": "", "text": "口止めとは生意気な（アーヤ）"},
        { "location": "159/TALK"    , "narrator": "アーヤ", "text": "どうぞー。"},
        { "location": "162/TALK"    , "narrator": "みやび", "text": "お邪魔するぞね。"},
        { "location": "163/TALK"    , "narrator": "アーヤ", "text": "あらみやび、\nどうかしたの？"},
        { "location": "164/TALK"    , "narrator": "みやび", "text": "ん…当直のことや。"},
        { "location": "165/TALK"    , "narrator": "みやび", "text": "今度の当直、まさか\nアーヤが代わる\n言うとは思わなくて。"},
        { "location": "167/TALK"    , "narrator": "アーヤ", "text": "ああ、そのことね。"},
        { "location": "170/TALK"    , "narrator": "みやび", "text": "実は、その日はどうしても\n外せん用事があってな。"},
        { "location": "171/TALK"    , "narrator": "みやび", "text": "正直、どうしようか\n悩んでたちや。"},
        { "location": "174/TALK"    , "narrator": "みやび", "text": "やき、アーヤが\n代わる言うてくれて、\nまっこと助かった。"},
        { "location": "175/TALK"    , "narrator": "みやび", "text": "ありがとな。"},
        { "location": "176/TALK"    , "narrator": "アーヤ", "text": "どういたしまして。"},
        { "location": "179/TALK"    , "narrator": "アーヤ", "text": "けど、改まってお礼を\n言いに来なくても\n良かったのに。"},
        { "location": "180/TALK"    , "narrator": "みやび", "text": "いや、それやと\nうちの気がすまん。"},
        { "location": "181/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "183/TALK"    , "narrator": "アーヤ", "text": "ダメね。\nやっぱり内緒には\nできないわ。"},
        { "location": "184/TALK"    , "narrator": "みやび", "text": "…何のことや？"},
        { "location": "187/TALK"    , "narrator": "アーヤ", "text": "実はね、今回の当直を\n代わったのって――"},
        { "location": "188/TALK"    , "narrator": "アーヤ", "text": "$handle$さんに\n頼まれたからなのよ。"},
        { "location": "189/TALK"    , "narrator": "みやび", "text": "は？"},
        { "location": "190/TALK"    , "narrator": "アーヤ", "text": "その日は、どうしても\nみやびさんに外せない\n用事があるんだ、って…。"},
        { "location": "191/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "194/TALK"    , "narrator": "みやび", "text": "初耳や。\nそんなこと言われたが？"},
        { "location": "195/TALK"    , "narrator": "アーヤ", "text": "ええ…。"},
        { "location": "197/TALK"    , "narrator": "みやび", "text": "そうか…。"},
        { "location": "198/TALK"    , "narrator": "みやび", "text": "なるほどな…。\n道理でタイミングが\n良過ぎるわけや。"},
        { "location": "201/TALK"    , "narrator": "アーヤ", "text": "…余計だったかしら？"},
        { "location": "203/TALK"    , "narrator": "みやび", "text": "いや、そんなことは\nないぞね。"},
        { "location": "204/TALK"    , "narrator": "みやび", "text": "それより、当直の方は\nまっこと変わってもらって\nえいが？"},
        { "location": "207/TALK"    , "narrator": "アーヤ", "text": "ええ、もちろん。"},
        { "location": "208/TALK"    , "narrator": "みやび", "text": "そうか…。\n改めて、ありがとうな。"},
        { "location": "218/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "225/TALK"    , "narrator": "みやび", "text": "おい"},
        { "location": "227/TALK"    , "narrator": "みやび", "text": "うちに内緒で勝手なことを"},
        { "location": "228/TALK"    , "narrator": "みやび", "text": "余計なことするな！"},
        { "location": "230/SEL"     , "narrator": "", "text": "もう決まったし"},
        { "location": "231/SEL"     , "narrator": "", "text": "サプライズ成功！"},
        { "location": "232/SEL"     , "narrator": "", "text": "遠慮しないで"},
        { "location": "233/ACT"     , "narrator": "", "text": "もう決まったし"},
        { "location": "234/TALK"    , "narrator": "みやび", "text": "勝手に決めよって"},
        { "location": "235/TALK"    , "narrator": "みやび", "text": "ハッキリ言っておく"},
        { "location": "236/TALK"    , "narrator": "みやび", "text": "こういうズルは好きやない"},
        { "location": "237/TALK"    , "narrator": "みやび", "text": "礼は言わんぞ！"},
        { "location": "238/ACT"     , "narrator": "", "text": "サプライズ成功！"},
        { "location": "239/TALK"    , "narrator": "みやび", "text": "そうやね"},
        { "location": "240/TALK"    , "narrator": "みやび", "text": "ハッピーの付かない方"},
        { "location": "241/TALK"    , "narrator": "みやび", "text": "ただのサプライズ"},
        { "location": "242/TALK"    , "narrator": "みやび", "text": "いや"},
        { "location": "243/TALK"    , "narrator": "みやび", "text": "限りなくバッドに近い"},
        { "location": "244/ACT"     , "narrator": "", "text": "遠慮しないで"},
        { "location": "245/TALK"    , "narrator": "みやび", "text": "おまえが言うな！"},
        { "location": "246/TALK"    , "narrator": "みやび", "text": "それはアーヤのセリフや"},
        { "location": "247/TALK"    , "narrator": "みやび", "text": "呆れるほどの図々しさやね"},
        { "location": "250/SEL"     , "narrator": "", "text": "余計なことしてごめん…"},
        { "location": "251/ACT"     , "narrator": "", "text": "余計なことしてごめん…"},
        { "location": "254/TALK"    , "narrator": "みやび", "text": "まあ"},
        { "location": "255/TALK"    , "narrator": "みやび", "text": "当直がなくなって助かったのは事実や"},
        { "location": "256/TALK"    , "narrator": "みやび", "text": "実際困ってたのも事実"},
        { "location": "257/TALK"    , "narrator": "みやび", "text": "そういうことだ"},
        { "location": "258/TALK"    , "narrator": "みやび", "text": "まあ"},
        { "location": "260/TALK"    , "narrator": "みやび", "text": "休みに罪はない"},
        { "location": "261/TALK"    , "narrator": "みやび", "text": "遠慮なく使わせてもらうちや！"},
        { "location": "154/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>某月某日　 5:40 PM</color>\nとある平日、寮「とらいあんぐる」アーヤの部屋にて"}
    ]
}
