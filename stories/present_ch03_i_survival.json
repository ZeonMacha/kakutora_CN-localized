        { "location": "205/TALK", "narrator": "ガブリエラ", "text": "サバイバル入門なんて、私には必要ないわ"},
        { "location": "207/TALK", "narrator": "ガブリエラ", "text": "子供の頃から、サバイバル術もちゃんと習ってきたんだし"},
        { "location": "210/SEL" , "narrator": "", "text": "火とか起こせたりする？"},
        { "location": "211/ACT" , "narrator": "", "text": "火とか起こせたりする？"},
        { "location": "214/TALK", "narrator": "ガブリエラ", "text": "習った最初の頃にやったわ"},
        { "location": "215/TALK", "narrator": "ガブリエラ", "text": "あれ、難しいから今でも嫌いよ"},
        { "location": "216/TALK", "narrator": "ガブリエラ", "text": "まあ、他にも食べられる野草の勉強とかも習ったけど"},
        { "location": "217/TALK", "narrator": "ガブリエラ", "text": "実践したことはないわ"},
        { "location": "220/SEL" , "narrator": "", "text": "大変だったんだね"},
        { "location": "221/ACT" , "narrator": "", "text": "大変だったんだね"},
        { "location": "224/TALK", "narrator": "ガブリエラ", "text": "楽しくもあったけれどね"},
        { "location": "225/TALK", "narrator": "ガブリエラ", "text": "森で訓練してる時とか"},
        { "location": "226/TALK", "narrator": "ガブリエラ", "text": "時々、洞窟とか見つけることもあって"},
        { "location": "227/TALK", "narrator": "ガブリエラ", "text": "ちょっとした冒険心を駆り立てられもしたし"},
        { "location": "228/TALK", "narrator": "ガブリエラ", "text": "また、ああいう経験出来ればいいんだけれど"}
    ]
}
