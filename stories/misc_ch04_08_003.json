        { "location": "288/TALK"    , "narrator": "みやび", "text": "して"},
        { "location": "289/TALK"    , "narrator": "みやび", "text": "キンクマとはなんぞや"},
        { "location": "291/TALK"    , "narrator": "みやび", "text": "まあなんちゅーか"},
        { "location": "292/TALK"    , "narrator": "みやび", "text": "ハムスターぐらいの存在感なわけだ"},
        { "location": "294/SEL"     , "narrator": "", "text": "みやびのこと？"},
        { "location": "295/SEL"     , "narrator": "", "text": "$handle$のこと？"},
        { "location": "296/SEL"     , "narrator": "", "text": "みやびは$me$の太陽だ"},
        { "location": "297/ACT"     , "narrator": "", "text": "みやびのこと？"},
        { "location": "298/TALK"    , "narrator": "みやび", "text": "そうなんでチュー"},
        { "location": "299/ACT"     , "narrator": "", "text": "$handle$のこと？"},
        { "location": "300/TALK"    , "narrator": "みやび", "text": "そうかもでチュー"},
        { "location": "301/ACT"     , "narrator": "", "text": "みやびは$me$の太陽だ"},
        { "location": "303/TALK"    , "narrator": "みやび", "text": "ほう"},
        { "location": "305/TALK"    , "narrator": "みやび", "text": "よくぞ言ってくれました"},
        { "location": "306/TALK"    , "narrator": "みやび", "text": "うちを照大神と呼ぶがよかろうぞ"},
        { "location": "308/TALK"    , "narrator": "みやび", "text": "まあ"},
        { "location": "309/TALK"    , "narrator": "みやび", "text": "なんというか"},
        { "location": "310/TALK"    , "narrator": "みやび", "text": "人との関わりの程度がだね"},
        { "location": "311/TALK"    , "narrator": "みやび", "text": "いうなればハムスターぐらいのもんじゃないかと思うわけだ"},
        { "location": "313/SEL"     , "narrator": "", "text": "大きいんだか小さいんだか"},
        { "location": "314/SEL"     , "narrator": "", "text": "癒し系ってことかな？"},
        { "location": "315/SEL"     , "narrator": "", "text": "手のひらに収まる温かさだね"},
        { "location": "316/ACT"     , "narrator": "", "text": "大きいんだか小さいんだか"},
        { "location": "317/TALK"    , "narrator": "みやび", "text": "ほんに"},
        { "location": "319/TALK"    , "narrator": "みやび", "text": "そう思うろう？"},
        { "location": "320/ACT"     , "narrator": "", "text": "癒し系ってことかな？"},
