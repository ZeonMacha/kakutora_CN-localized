        "title": "005 メインストーリー",
        "sub_title": "慟哭＜後編＞"
    },
    "entry":
    [
        { "location": "552/TALK"  , "narrator": "つばめ", "text": "やっぱり"},
        { "location": "553/TALK"  , "narrator": "つばめ", "text": "一人になんてできなぃo(*･ﾛ･*)o、"},
        { "location": "554/TALK"  , "narrator": "つばめ", "text": "神楽ちゃんは"},
        { "location": "555/TALK"  , "narrator": "つばめ", "text": "大事なぉ友達だもん(*´︶`*)"},
        { "location": "557/SEL"   , "narrator": "", "text": "つばめがそう言うならもう止めない"},
        { "location": "558/ACT"   , "narrator": "", "text": "つばめがそう言うならもう止めない"},
        { "location": "560/TALK"  , "narrator": "つばめ", "text": "ごめんね(´・ω・｀)"},
        { "location": "561/TALK"  , "narrator": "つばめ", "text": "でも"},
        { "location": "562/TALK"  , "narrator": "つばめ", "text": "わたしだけじゃ"},
        { "location": "563/TALK"  , "narrator": "つばめ", "text": "どぅすればぃぃかわからなぃから(o´Д`)=з"},
        { "location": "564/TALK"  , "narrator": "つばめ", "text": "協力してほしぃの(●´人｀)"},
        { "location": "565/TALK"  , "narrator": "つばめ", "text": "神楽ちゃんに"},
        { "location": "566/TALK"  , "narrator": "つばめ", "text": "なんて声かければぃぃかな？(･ｪ･^ )( ^･ｪ･)"},
        { "location": "568/SEL"   , "narrator": "", "text": "元気づけたいの？"},
        { "location": "569/ACT"   , "narrator": "", "text": "元気づけたいの？"},
        { "location": "571/TALK"  , "narrator": "つばめ", "text": "ぅん"},
        { "location": "572/TALK"  , "narrator": "つばめ", "text": "今より"},
        { "location": "573/TALK"  , "narrator": "つばめ", "text": "少しでもぃぃからo(*･ﾛ･*)o、"},
        { "location": "575/TALK"  , "narrator": "つばめ", "text": "何とかしたぃの"},
        { "location": "577/SEL"   , "narrator": "", "text": "神楽が好きだと言おう"},
        { "location": "578/SEL"   , "narrator": "", "text": "つばめの言葉で話してあげて"},
        { "location": "579/ACT"   , "narrator": "", "text": "神楽が好きだと言おう"},
        { "location": "580/TALK"  , "narrator": "つばめ", "text": "わかった"},
        { "location": "581/TALK"  , "narrator": "つばめ", "text": "きっと"},
        { "location": "582/TALK"  , "narrator": "つばめ", "text": "元気になってくれるよね？(*´ω｀*)"},
        { "location": "596/TALK"  , "narrator": "つばめ", "text": "神楽ちゃん。\nわたし、ここにいたら\n邪魔かな？"},
        { "location": "597/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "599/TALK"  , "narrator": "つばめ", "text": "…あのね、\n神楽ちゃん。"},
        { "location": "600/TALK"  , "narrator": "つばめ", "text": "わたし\n神楽ちゃんのこと、\n大好きだよ。"},
        { "location": "603/TALK"  , "narrator": "神楽", "text": "…えっ？"},
        { "location": "604/TALK"  , "narrator": "つばめ", "text": "神楽ちゃんは、\nわたしの大切で\n大好きなお友達だよ。"},
        { "location": "605/TALK"  , "narrator": "つばめ", "text": "だから、神楽ちゃんが\n悩んでたり、悲しんで\nほしくない。"},
        { "location": "606/TALK"  , "narrator": "つばめ", "text": "もし…何か悩んでる\nことがあるなら\n話してほしいな。"},
        { "location": "607/TALK"  , "narrator": "つばめ", "text": "わたしでよければ、\n力になるから…。"},
        { "location": "608/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "609/TALK"  , "narrator": "つばめ", "text": "…神楽ちゃん。"},
        { "location": "613/TALK"  , "narrator": "神楽", "text": "つばめさん…、\n私…！！"},
        { "location": "615/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "616/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "621/TALK"  , "narrator": "神楽", "text": "いえ…私のことは\n放っておいて\nください。"},
        { "location": "623/TALK"  , "narrator": "つばめ", "text": "で、でも、わたし…。"},
        { "location": "624/TALK"  , "narrator": "神楽", "text": "やめてください！"},
        { "location": "625/TALK"  , "narrator": "神楽", "text": "私のこと、友達って\n言いましたよね？"},
        { "location": "626/TALK"  , "narrator": "神楽", "text": "大切で、大好きな\nお友達だって。"},
        { "location": "628/TALK"  , "narrator": "神楽", "text": "なら、これ以上\n私を苦しめないで\nください…。"},
        { "location": "629/TALK"  , "narrator": "つばめ", "text": "そ、そんな…。\nわたし、友達だから\n力になろうって――"},
        { "location": "632/TALK"  , "narrator": "神楽", "text": "いい加減にして！！"},
        { "location": "634/TALK"  , "narrator": "神楽", "text": "友達だから…友達、\n友達って！"},
        { "location": "635/TALK"  , "narrator": "神楽", "text": "友達って言葉を\n武器にして\n私を苦しめないで！"},
        { "location": "640/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "642/TALK"  , "narrator": "つばめ", "text": "そんな…わたし、\nそんなつもりは…。"},
        { "location": "644/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "645/TALK"  , "narrator": "つばめ", "text": "神楽ちゃん、\nごめん…。\nわたし…ごめんね…。"},
        { "location": "646/ACT"   , "narrator": "", "text": "つばめの言葉で話してあげて"},
        { "location": "647/TALK"  , "narrator": "つばめ", "text": "そぅだね(´･ω･｀) "},
        { "location": "648/TALK"  , "narrator": "つばめ", "text": "わたしの言葉じゃなきゃ"},
        { "location": "649/TALK"  , "narrator": "つばめ", "text": "意味なぃよねo(*･ﾛ･*)o、"},
        { "location": "661/TALK"  , "narrator": "つばめ", "text": "…$handle$さんに\n頼むのは、間違ってる\nよね。"},
        { "location": "662/TALK"  , "narrator": "つばめ", "text": "……神楽ちゃんを\n元気づけたいのは\nわたしなんだから。"},
        { "location": "663/TALK"  , "narrator": "つばめ", "text": "人に聞かないで\nわたしの言葉で\n伝えないと…。"},
        { "location": "666/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "667/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "669/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "670/TALK"  , "narrator": "つばめ", "text": "…ごめんなさい。"},
        { "location": "672/TALK"  , "narrator": "神楽", "text": "…え？"},
        { "location": "673/TALK"  , "narrator": "つばめ", "text": "神楽ちゃんが凄く\n悩んでるって、\nわかってるのにね。"},
        { "location": "675/TALK"  , "narrator": "つばめ", "text": "わたし、なんて\n声をかければいいか\nわからなくて…。"},
        { "location": "676/TALK"  , "narrator": "つばめ", "text": "本当にごめん…。\n頼りないよね。"},
        { "location": "680/TALK"  , "narrator": "神楽", "text": "…謝らないで\nください。"},
        { "location": "681/TALK"  , "narrator": "神楽", "text": "むしろ、謝るのは\n私の方です。"},
        { "location": "682/TALK"  , "narrator": "神楽", "text": "つばめさんまで\n変に悩ませることに\nなっちゃって…。"},
        { "location": "683/TALK"  , "narrator": "神楽", "text": "本当にごめんなさい。"},
        { "location": "684/TALK"  , "narrator": "つばめ", "text": "そんな…。\n神楽ちゃんこそ\n謝ることじゃ…。"},
        { "location": "685/TALK"  , "narrator": "神楽", "text": "謝ることですよ。"},
        { "location": "688/TALK"  , "narrator": "神楽", "text": "だって…どうしようも\nないことなのは\nわかってたのに…。"},
        { "location": "689/TALK"  , "narrator": "神楽", "text": "ずっと前から、\nわかってたのに…。"},
        { "location": "691/TALK"  , "narrator": "つばめ", "text": "…どうしようもない\nことって…どういう\nことなの？"},
        { "location": "693/TALK"  , "narrator": "神楽", "text": "…いえ、いいんです。\n忘れてください。"},
        { "location": "695/TALK"  , "narrator": "つばめ", "text": "ううん、教えて。"},
        { "location": "696/TALK"  , "narrator": "つばめ", "text": "教えてくれれば、\nわたしも解決策を\n考えられるし。"},
        { "location": "697/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "699/TALK"  , "narrator": "つばめ", "text": "一緒に考えれば、\nきっとどうにかなる\nと思うの。"},
        { "location": "701/TALK"  , "narrator": "神楽", "text": "…なりませんよ。"},
        { "location": "702/TALK"  , "narrator": "つばめ", "text": "でも……。"},
        { "location": "705/TALK"  , "narrator": "神楽", "text": "いい加減にして\nください！"},
        { "location": "707/TALK"  , "narrator": "つばめ", "text": "っ！？"},
        { "location": "709/TALK"  , "narrator": "神楽", "text": "私の話を聞かないで、\n頭の中お花畑なこと\nばかり言って！"},
        { "location": "710/TALK"  , "narrator": "神楽", "text": "これ以上、\nイライラさせないで！"},
        { "location": "715/TALK"  , "narrator": "神楽", "text": "そういう無責任なこと\n言われるのが…、\n一番傷つくんです…！"},
        { "location": "721/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "723/TALK"  , "narrator": "つばめ", "text": "そんな…無責任に、\n言ったわけじゃ\nないのに…。"},
        { "location": "724/TALK"  , "narrator": "つばめ", "text": "わたし…何を間違え\nちゃったんだろ…。"},
        { "location": "725/TALK"  , "narrator": "つばめ", "text": "何で、あんなに\n神楽ちゃんを怒らせ\nちゃったのかな…？"},
        { "location": "726/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "739/DIALOG", "narrator": "Dialog_chapter_ch01", "text": "【18 ブラック・クラン】"}
    ]
}
