    [
        { "location": "397/SCENARIO", "narrator": "", "text": "読書のお供"},
        { "location": "399/TALK"    , "narrator": "アーヤ", "text": "最近行ってみたいところといえば"},
        { "location": "400/TALK"    , "narrator": "アーヤ", "text": "ブックカフェかな"},
        { "location": "401/TALK"    , "narrator": "アーヤ", "text": "ただね、ブックカフェって"},
        { "location": "402/TALK"    , "narrator": "アーヤ", "text": "おしゃれだけど"},
        { "location": "403/TALK"    , "narrator": "アーヤ", "text": "少しだけ抵抗があるのよね"},
        { "location": "405/SEL"     , "narrator": "", "text": "そう？"},
        { "location": "406/SEL"     , "narrator": "", "text": "漫画の方がいいよね"},
        { "location": "407/SEL"     , "narrator": "", "text": "本汚したらって思うよね"},
        { "location": "408/ACT"     , "narrator": "", "text": "そう？"},
        { "location": "409/TALK"    , "narrator": "アーヤ", "text": "$handle$さんは"},
        { "location": "410/TALK"    , "narrator": "アーヤ", "text": "そうじゃないのね"},
        { "location": "411/ACT"     , "narrator": "", "text": "漫画の方がいいよね"},
        { "location": "412/TALK"    , "narrator": "アーヤ", "text": "ええと"},
        { "location": "413/TALK"    , "narrator": "アーヤ", "text": "そういうことじゃなくて"},
        { "location": "414/ACT"     , "narrator": "", "text": "本汚したらって思うよね"},
        { "location": "415/TALK"    , "narrator": "アーヤ", "text": "そうなのよ"},
        { "location": "416/TALK"    , "narrator": "アーヤ", "text": "食べ物って"},
        { "location": "417/TALK"    , "narrator": "アーヤ", "text": "うっかりした時が"},
        { "location": "418/TALK"    , "narrator": "アーヤ", "text": "怖いの"},
        { "location": "419/TALK"    , "narrator": "アーヤ", "text": "それに"},
        { "location": "421/TALK"    , "narrator": "アーヤ", "text": "図書館だと"},
        { "location": "422/TALK"    , "narrator": "アーヤ", "text": "飲食禁止でしょ"},
        { "location": "423/TALK"    , "narrator": "アーヤ", "text": "普通は"},
        { "location": "425/SEL"     , "narrator": "", "text": "確かに"},
        { "location": "426/SEL"     , "narrator": "", "text": "行かないから知らない"},
        { "location": "427/SEL"     , "narrator": "", "text": "カフェ併設してるとこもあるよ"},
        { "location": "428/ACT"     , "narrator": "", "text": "確かに"},
        { "location": "429/TALK"    , "narrator": "アーヤ", "text": "そっちに慣れてるから"},
        { "location": "430/ACT"     , "narrator": "", "text": "行かないから知らない"},
        { "location": "431/TALK"    , "narrator": "アーヤ", "text": "あら"},
        { "location": "432/TALK"    , "narrator": "アーヤ", "text": "そうなの"},
        { "location": "433/ACT"     , "narrator": "", "text": "カフェ併設してるとこもあるよ"},
        { "location": "434/TALK"    , "narrator": "アーヤ", "text": "それでも"},
        { "location": "435/TALK"    , "narrator": "アーヤ", "text": "本があるところは"},
        { "location": "436/TALK"    , "narrator": "アーヤ", "text": "飲食禁止でしょ"},
        { "location": "438/TALK"    , "narrator": "アーヤ", "text": "気にしすぎなのかも"},
        { "location": "439/TALK"    , "narrator": "アーヤ", "text": "しれないけど"},
        { "location": "440/TALK"    , "narrator": "アーヤ", "text": "やっぱり気になるのよ"},
        { "location": "441/TALK"    , "narrator": "アーヤ", "text": "気にしすぎ？"}
    ]
}
