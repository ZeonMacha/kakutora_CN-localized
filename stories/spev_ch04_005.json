    "info": {
        "story_id": "4005",
        "cid": "",
        "title": "スペシャルエピソード",
        "sub_title": "来世までお預け"
    },
    "entry":
    [
        { "location": "22/TALK" , "narrator": "透明みやび", "text": "はぁ…どうしてうちまで\nこんな息苦しい服着んと\nいかんのやろか…。"},
        { "location": "23/TALK" , "narrator": "透明みやび", "text": "こっちは結婚する予定も\n相手もいない女子高生\nやぞ？"},
        { "location": "24/TALK" , "narrator": "透明みやび", "text": "みんなも相手もおらん\nっちゅうのに…、\n乙女心は面倒やなぁ…。"},
        { "location": "26/TALK" , "narrator": "透明みやび", "text": "はぁ…。"},
        { "location": "27/SEL"  , "narrator": "（選択肢）", "text": "素敵だね"},
        { "location": "28/ACT"  , "narrator": "", "text": "素敵だね"},
        { "location": "33/TALK" , "narrator": "透明みやび", "text": "…見られちょったか。\nまあ、予想通りやけんど。"},
        { "location": "38/TALK" , "narrator": "みやび", "text": "そりゃどうも"},
        { "location": "40/TALK" , "narrator": "みやび", "text": "サンキューメルシー"},
        { "location": "41/TALK" , "narrator": "みやび", "text": "では脱ぐとしよう"},
        { "location": "42/SEL"  , "narrator": "（選択肢）", "text": "いや、まだ早いでしょ！？"},
        { "location": "43/SEL"  , "narrator": "（選択肢）", "text": "じゃあ、また後で"},
        { "location": "44/ACT"  , "narrator": "", "text": "いや、まだ早いでしょ！？"},
        { "location": "45/TALK" , "narrator": "みやび", "text": "早いも遅いもない"},
        { "location": "46/TALK" , "narrator": "みやび", "text": "ウエディングドレスの試着をした"},
        { "location": "47/TALK" , "narrator": "みやび", "text": "し終わったら脱ぐ"},
        { "location": "48/TALK" , "narrator": "みやび", "text": "これ当然"},
        { "location": "49/TALK" , "narrator": "みやび", "text": "故に脱ぐのだ"},
        { "location": "50/ACT"  , "narrator": "", "text": "じゃあ、また後で"},
        { "location": "51/TALK" , "narrator": "みやび", "text": "うむ"},
        { "location": "55/SEL"  , "narrator": "（選択肢）", "text": "もうちょっと見せてよ"},
        { "location": "56/ACT"  , "narrator": "", "text": "もうちょっと見せてよ"},
        { "location": "59/TALK" , "narrator": "みやび", "text": "それは構わんが"},
        { "location": "60/TALK" , "narrator": "みやび", "text": "楽しいか？"},
        { "location": "62/TALK" , "narrator": "みやび", "text": "うちのこんな姿見て"},
        { "location": "63/TALK" , "narrator": "みやび", "text": "何が楽しい？"},
        { "location": "64/SEL"  , "narrator": "（選択肢）", "text": "すごく綺麗だから"},
        { "location": "65/SEL"  , "narrator": "（選択肢）", "text": "滅多に見られないと思うから"},
        { "location": "66/ACT"  , "narrator": "", "text": "すごく綺麗だから"},
        { "location": "69/TALK" , "narrator": "みやび", "text": "そうであろう"},
        { "location": "71/TALK" , "narrator": "みやび", "text": "えい生地のウエディングドレスである"},
        { "location": "72/TALK" , "narrator": "みやび", "text": "触り心地はよい"},
        { "location": "73/TALK" , "narrator": "みやび", "text": "締め付けは拷問"},
        { "location": "74/SEL"  , "narrator": "（選択肢）", "text": "いや、みやびのことだよ"},
        { "location": "75/ACT"  , "narrator": "", "text": "いや、みやびのことだよ"},
        { "location": "79/TALK" , "narrator": "みやび", "text": "いや"},
        { "location": "80/TALK" , "narrator": "みやび", "text": "冗談にマジ返しはズルい"},
        { "location": "82/TALK" , "narrator": "みやび", "text": "空気嫁"},
        { "location": "84/TALK" , "narrator": "みやび", "text": "読め"},
        { "location": "85/TALK" , "narrator": "みやび", "text": "そしてうちをからかうな"},
        { "location": "86/ACT"  , "narrator": "", "text": "滅多に見られないと思うから"},
        { "location": "88/TALK" , "narrator": "みやび", "text": "当然過ぎる"},
        { "location": "89/TALK" , "narrator": "みやび", "text": "頻繁にウエディングドレス着るとか"},
        { "location": "90/TALK" , "narrator": "みやび", "text": "普通はない"},
        { "location": "91/TALK" , "narrator": "みやび", "text": "結婚詐欺師か"},
        { "location": "92/TALK" , "narrator": "みやび", "text": "ウエディングドレス専門モデルか？"},
        { "location": "94/TALK" , "narrator": "みやび", "text": "まあ"},
        { "location": "95/TALK" , "narrator": "みやび", "text": "もう脱いでえいな？"},
        { "location": "96/SEL"  , "narrator": "（選択肢）", "text": "結婚式に憧れないの"},
        { "location": "97/ACT"  , "narrator": "", "text": "結婚式に憧れないの"},
        { "location": "100/TALK", "narrator": "みやび", "text": "ない"},
        { "location": "101/TALK", "narrator": "みやび", "text": "面倒くさい"},
        { "location": "103/TALK", "narrator": "みやび", "text": "金かかる"},
        { "location": "104/TALK", "narrator": "みやび", "text": "ウエディングドレスマジ息苦しい"},
        { "location": "105/TALK", "narrator": "みやび", "text": "何故する必要が？"},
        { "location": "106/SEL" , "narrator": "（選択肢）", "text": "可愛いみやびを見てもらいたい"},
        { "location": "107/SEL" , "narrator": "（選択肢）", "text": "きっと楽しいよ"},
        { "location": "108/ACT" , "narrator": "", "text": "可愛いみやびを見てもらいたい"},
        { "location": "110/TALK", "narrator": "みやび", "text": "意味不明"},
        { "location": "111/TALK", "narrator": "みやび", "text": "何故相棒がそう思う？"},
        { "location": "112/SEL" , "narrator": "（選択肢）", "text": "未来の夫なので"},
        { "location": "113/SEL" , "narrator": "（選択肢）", "text": "可愛いからみんなに見せたい"},
        { "location": "114/ACT" , "narrator": "", "text": "未来の夫なので"},
        { "location": "115/TALK", "narrator": "みやび", "text": "あらまあビックリ"},
        { "location": "116/TALK", "narrator": "みやび", "text": "いつからそんなことに？"},
        { "location": "117/TALK", "narrator": "みやび", "text": "初耳過ぎてついて行けん"},
        { "location": "118/ACT" , "narrator": "", "text": "可愛いからみんなに見せたい"},
        { "location": "120/TALK", "narrator": "みやび", "text": "いや"},
        { "location": "121/TALK", "narrator": "みやび", "text": "理由になってない"},
        { "location": "122/TALK", "narrator": "みやび", "text": "それと重大な頼みを言う"},
        { "location": "123/TALK", "narrator": "みやび", "text": "可愛い可愛い連呼するな"},
        { "location": "124/TALK", "narrator": "みやび", "text": "さすがにうちも"},
        { "location": "125/TALK", "narrator": "みやび", "text": "顔が熱くなる"},
        { "location": "127/ACT" , "narrator": "", "text": "きっと楽しいよ"},
        { "location": "129/TALK", "narrator": "みやび", "text": "そうだろうか？"},
        { "location": "130/TALK", "narrator": "みやび", "text": "いや"},
        { "location": "131/TALK", "narrator": "みやび", "text": "ブーケ投げは楽しそうだ"},
        { "location": "132/TALK", "narrator": "みやび", "text": "未婚の売れ残りよ"},
        { "location": "133/TALK", "narrator": "みやび", "text": "うちの花を奪い合え！"},
        { "location": "135/TALK", "narrator": "みやび", "text": "そう言いながら投げる"},
        { "location": "136/TALK", "narrator": "みやび", "text": "言うのはもちろん"},
        { "location": "137/TALK", "narrator": "みやび", "text": "心の中で"},
        { "location": "140/TALK", "narrator": "みやび", "text": "何であれ"},
        { "location": "141/TALK", "narrator": "みやび", "text": "次に着るのは何十年後？"},
        { "location": "142/TALK", "narrator": "みやび", "text": "または来世？"},
        { "location": "143/TALK", "narrator": "みやび", "text": "次回をお楽しみに"},
        { "location": "144/TALK", "narrator": "みやび", "text": "※来ない可能性もありますが当方は一切の責任を負いません"},
        { "location": "146/TALK", "narrator": "透明みやび", "text": "ふむ…さてと、\nさっさと脱いで…。"},
        { "location": "147/TALK", "narrator": "透明ガブリエラ", "text": "みやびー。\nまだなの？"},
        { "location": "149/TALK", "narrator": "透明みやび", "text": "ん？　ガブちゃん？"},
        { "location": "150/TALK", "narrator": "透明ガブリエラ", "text": "みんな準備できてるん\nだから、みやびも早く\n出てきなさいよ。"},
        { "location": "151/TALK", "narrator": "透明神楽", "text": "記念撮影しますから、\nみやびさんも\n早く出てきてください。"},
        { "location": "152/TALK", "narrator": "透明みやび", "text": "いや、うちは…。"},
        { "location": "153/TALK", "narrator": "透明みやび", "text": "…………。"},
        { "location": "154/TALK", "narrator": "透明みやび", "text": "…すぐ行くき、\nちくっと待ちぃ。"},
        { "location": "156/TALK", "narrator": "透明みやび", "text": "来世までないかも\nしれんのやし、\nちくっと楽しむか…。"}
    ]
}
