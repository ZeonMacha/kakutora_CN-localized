{
    "dir": "chap23/daydra/dd_ch03_23_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "23352",
        "cid": "gabriella",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "神楽の優しさ"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "神楽の優しさ"},
        { "location": "23/TALK"   , "narrator": "真幌", "text": "よーし、今日の訓練は\nこれで終わりだ。"},
        { "location": "24/TALK"   , "narrator": "真幌", "text": "午後はゆっくり休んで、\n明日に備えるんだ。\n解散！"},
        { "location": "25/TALK"   , "narrator": "つばめ", "text": "はぁ…へとへとだよぉ…。"},
        { "location": "26/TALK"   , "narrator": "神楽", "text": "そ、そう、ですね…。\n今日はなんだか、\nとってもハードでした…。"},
        { "location": "27/TALK"   , "narrator": "アーヤ", "text": "暑さのせいよ。\n多分いつも以上に\n体力持ってかれてるわ。"},
        { "location": "30/TALK"   , "narrator": "ガブリエラ", "text": "はぁ、はぁ…。"},
        { "location": "32/TALK"   , "narrator": "つばめ", "text": "ガブちゃん、大丈夫？"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "う、ん…。\n喉、カラカラで…。"},
        { "location": "35/TALK"   , "narrator": "アーヤ", "text": "早く帰って冷たい物\n飲みましょ。"},
        { "location": "37/TALK"   , "narrator": "ガブリエラ", "text": "賛成…ってか、あれ？\nみやびはどこ？"},
        { "location": "40/TALK"   , "narrator": "真幌", "text": "あいつならさっさと\n戻ってったぞ。"},
        { "location": "41/TALK"   , "narrator": "真幌", "text": "冷たい麦茶が待ってる、\nとか言ってな。"},
        { "location": "44/TALK"   , "narrator": "つばめ", "text": "麦茶…。\n神楽ちゃん、行こ。"},
        { "location": "46/TALK"   , "narrator": "神楽", "text": "はい。\nガブちゃんも、\n歩けますか？"},
        { "location": "48/TALK"   , "narrator": "ガブリエラ", "text": "平気よ、大げさね…。"},
        { "location": "62/TALK"   , "narrator": "ガブリエラ", "text": "ふぅ…。"},
        { "location": "63/TALK"   , "narrator": "ガブリエラ", "text": "何か、今日は本当に\n疲れたわ…。"},
        { "location": "64/TALK"   , "narrator": "ガブリエラ", "text": "シャワー浴びたし、\n食事も済んだのに、\nまだちょっと息苦しい…。"},
        { "location": "65/TALK"   , "narrator": "ガブリエラ", "text": "それに…ちょっと\n頭も痛いし…。"},
        { "location": "66/TALK"   , "narrator": "ガブリエラ", "text": "…夕飯の時間まで、\nちょっと寝よう。"},
        { "location": "67/TALK"   , "narrator": "ガブリエラ", "text": "…布団出さないと――"},
        { "location": "68/TALK"   , "narrator": "ガブリエラ", "text": "っ！？"},
        { "location": "70/TALK"   , "narrator": "ガブリエラ", "text": "あ、あれ…なんか…、\nめまいが…。"},
        { "location": "76/TALK"   , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "77/TALK"   , "narrator": "ガブリエラ", "text": "うっ…あ、あれ？"},
        { "location": "78/TALK"   , "narrator": "ガブリエラ", "text": "あたし…何して…。"},
        { "location": "89/TALK"   , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "90/TALK"   , "narrator": "ガブリエラ", "text": "あたし…寝てたの？\nでも、いつの間に…。"},
        { "location": "91/TALK"   , "narrator": "神楽", "text": "ガブちゃん！？"},
        { "location": "95/TALK"   , "narrator": "神楽", "text": "ダメですよ！\nまだ休んでないと！"},
        { "location": "97/TALK"   , "narrator": "ガブリエラ", "text": "神楽…えっ？\nあたし…どうしたの？"},
        { "location": "98/TALK"   , "narrator": "神楽", "text": "覚えてないんですか？"},
        { "location": "99/TALK"   , "narrator": "神楽", "text": "ガブちゃん、\nここで倒れてたんですよ。"},
        { "location": "100/TALK"  , "narrator": "ガブリエラ", "text": "倒れてた…あたしが！？"},
        { "location": "102/TALK"  , "narrator": "神楽", "text": "はい…多分、熱中症だと\n思いますよ。"},
        { "location": "103/TALK"  , "narrator": "神楽", "text": "どうですか？\n気持ち悪かったり\nしませんか？"},
        { "location": "104/TALK"  , "narrator": "ガブリエラ", "text": "え、ええ…ちょっとだけ\n頭が痛いけど…。"},
        { "location": "105/TALK"  , "narrator": "神楽", "text": "やっぱり…顔色もあまり\nよくありませんから、\nもう少し休んでください。"},
        { "location": "107/TALK"  , "narrator": "神楽", "text": "私、氷枕と冷たい飲み物を\n持ってきますから。"},
        { "location": "108/TALK"  , "narrator": "ガブリエラ", "text": "い、いいわよ。\nそんな大げさな――"},
        { "location": "110/TALK"  , "narrator": "神楽", "text": "ガブちゃん！"},
        { "location": "111/TALK"  , "narrator": "神楽", "text": "倒れてた人にそんなこと\n言う権利はありません！"},
        { "location": "112/TALK"  , "narrator": "神楽", "text": "私が戻るまで、\n大人しくしていて\nくださいね…約束ですよ！"},
        { "location": "113/TALK"  , "narrator": "ガブリエラ", "text": "は、はい…。"},
        { "location": "117/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "119/TALK"  , "narrator": "ガブリエラ", "text": "情けない…。\nまさか、熱中症って…。"},
        { "location": "120/SEL"   , "narrator": "", "text": "具合は平気？"},
        { "location": "123/TALK"  , "narrator": "ガブリエラ", "text": "気を付けてたつもり\nなんだけど…。"},
        { "location": "124/TALK"  , "narrator": "ガブリエラ", "text": "でも、訓練中じゃなくて\n本当助かったわ。"},
        { "location": "125/TALK"  , "narrator": "ガブリエラ", "text": "つばめには、あんまり\nかっこ悪い姿見られたく\nないし…。"},
        { "location": "129/TALK"  , "narrator": "ガブリエラ", "text": "…っていうか、神楽しか\n倒れてるの見てないの\nかしら？"},
        { "location": "130/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "132/TALK"  , "narrator": "ガブリエラ", "text": "具合よくなってからで\nいいか…。"},
        { "location": "134/ACT"   , "narrator": "", "text": "具合は平気？"},
        { "location": "153/TALK"  , "narrator": "ガブリエラ", "text": "なんとか"},
        { "location": "155/TALK"  , "narrator": "ガブリエラ", "text": "ごめん"},
        { "location": "156/TALK"  , "narrator": "ガブリエラ", "text": "小さいもじ"},
        { "location": "157/TALK"  , "narrator": "ガブリエラ", "text": "ツラいから"},
        { "location": "158/TALK"  , "narrator": "ガブリエラ", "text": "あとで"},
        { "location": "159/TALK"  , "narrator": "ガブリエラ", "text": "よくなったらね"},
        { "location": "172/TALK"  , "narrator": "ガブリエラ", "text": "はぁ…。"},
        { "location": "176/TALK"  , "narrator": "神楽", "text": "ガブちゃん、冷たい麦茶と\n氷枕持って――"},
        { "location": "177/TALK"  , "narrator": "神楽", "text": "って、スマホなんか\n弄ってちゃダメですよ！"},
        { "location": "179/TALK"  , "narrator": "ガブリエラ", "text": "大げさ過ぎ…、\nこれくらい平気よ。"},
        { "location": "180/TALK"  , "narrator": "神楽", "text": "ガブちゃん…、\n私、本当に怒りますよ？"},
        { "location": "181/TALK"  , "narrator": "ガブリエラ", "text": "うっ…。"},
        { "location": "182/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "183/TALK"  , "narrator": "ガブリエラ", "text": "わ、わかったわよ…。\n倒れたのは事実だし、\n従うわ。"},
        { "location": "186/TALK"  , "narrator": "神楽", "text": "そうです。\n今日一日は素直な良い子で\nいてくださいね。"},
        { "location": "188/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "189/TALK"  , "narrator": "ガブリエラ", "text": "あたし…どれくらい\n倒れてたの？"},
        { "location": "190/TALK"  , "narrator": "神楽", "text": "私が見つけたのが、\n大体三十分くらい前です。"},
        { "location": "192/TALK"  , "narrator": "ガブリエラ", "text": "…その間、ずっと看病して\nくれてたの？"},
        { "location": "193/TALK"  , "narrator": "神楽", "text": "それこそ大袈裟ですよ。\n冷たいタオルを当てたり\nしてただけです。"},
        { "location": "195/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "197/TALK"  , "narrator": "神楽", "text": "やっぱり、\nまだ具合悪いですか？"},
        { "location": "198/TALK"  , "narrator": "ガブリエラ", "text": "…ううん。"},
        { "location": "199/TALK"  , "narrator": "ガブリエラ", "text": "め、面倒かけたわ…。"},
        { "location": "200/TALK"  , "narrator": "神楽", "text": "もう…友達なんだから、\n面倒なんて言わないで\nください。"},
        { "location": "201/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "202/TALK"  , "narrator": "神楽", "text": "氷枕、置いときますね。"},
        { "location": "203/TALK"  , "narrator": "神楽", "text": "麦茶飲んだら、\nもう少し横になって\n休んでください。"},
        { "location": "204/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "205/TALK"  , "narrator": "神楽", "text": "じゃあ、私はこれで…。"},
        { "location": "207/TALK"  , "narrator": "ガブリエラ", "text": "か、神楽！"},
        { "location": "209/TALK"  , "narrator": "神楽", "text": "はい？"},
        { "location": "210/TALK"  , "narrator": "ガブリエラ", "text": "…世話になったわ。"},
        { "location": "211/TALK"  , "narrator": "神楽", "text": "もう、だからそんなこと\n言わないで――"},
        { "location": "215/TALK"  , "narrator": "ガブリエラ", "text": "ありがと…。"},
        { "location": "216/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "217/TALK"  , "narrator": "神楽", "text": "はい…。"},
        { "location": "221/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "223/TALK"  , "narrator": "ガブリエラ", "text": "はぁ…なんか、\n余計に顔が熱くなった\n気がするわ…。"},
        { "location": "224/TALK"  , "narrator": "ガブリエラ", "text": "…友達なんだから\n気にするな、かぁ…。"},
        { "location": "225/TALK"  , "narrator": "ガブリエラ", "text": "本当、よくもあんな\n恥ずかしいセリフを\n平然と言えるもんだわ。"},
        { "location": "226/TALK"  , "narrator": "ガブリエラ", "text": "…悪い気はしないけど。"},
        { "location": "227/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "228/TALK"  , "narrator": "ガブリエラ", "text": "色々と用意して\nもらったんだし、\nお昼寝しよ…。"},
        { "location": "22/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>8月25日　 0:10 PM</color>\n合宿中、みやびの実家近くの砂浜でのこと"},
        { "location": "239/DIALOG", "narrator": "Dialog_GEThimegoto_ch03", "text": "【ナイチンゲール誓詞】"}
    ]
}
