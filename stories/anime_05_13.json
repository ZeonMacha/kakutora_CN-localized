    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "アニメ第13話"},
        { "location": "19/TALK"   , "narrator": "赤髪千羽鶴", "text": "こんにちは、\n$handle$さん。"},
        { "location": "20/TALK"   , "narrator": "赤髪千羽鶴", "text": "もう一度わたしと話を\nしていきますか？"},
        { "location": "21/SEL"    , "narrator": "", "text": "はい"},
        { "location": "22/SEL"    , "narrator": "", "text": "いいえ"},
        { "location": "23/ACT"    , "narrator": "", "text": "はい"},
        { "location": "24/TALK"   , "narrator": "赤髪千羽鶴", "text": "わかりました。\nそれでは……。"},
        { "location": "26/ACT"    , "narrator": "", "text": "いいえ"},
        { "location": "27/TALK"   , "narrator": "赤髪千羽鶴", "text": "わかりました。\nそれではこれで。"},
        { "location": "33/TALK"   , "narrator": "赤髪千羽鶴", "text": "こんにちは、\n$handle$さん。"},
        { "location": "34/SEL"    , "narrator": "", "text": "こんにちは～"},
        { "location": "35/SEL"    , "narrator": "", "text": "あれ？つばめ？？"},
        { "location": "36/ACT"    , "narrator": "", "text": "こんにちは～"},
        { "location": "37/ACT"    , "narrator": "", "text": "あれ？つばめ？？"},
        { "location": "38/TALK"   , "narrator": "赤髪千羽鶴", "text": "え？？"},
        { "location": "39/TALK"   , "narrator": "赤髪千羽鶴", "text": "ああ、もしかして\nエリカさんだと\n思いました？"},
        { "location": "40/TALK"   , "narrator": "赤髪千羽鶴", "text": "今回はここが\n空き領域でしたので、\n使わせてもらってます。"},
        { "location": "41/TALK"   , "narrator": "赤髪千羽鶴", "text": "前にもお伝えした通り、\nわたしはナビでは\nありませんので――"},
        { "location": "42/TALK"   , "narrator": "赤髪千羽鶴", "text": "エリカさんたちが\n使わない場所を\nお借りしてるだけです。"},
        { "location": "43/TALK"   , "narrator": "赤髪千羽鶴", "text": "エリカさんたちも、\n必要な回を使ってる\nだけみたいですし――"},
        { "location": "44/TALK"   , "narrator": "赤髪千羽鶴", "text": "今までがたまたま\n毎回同じサイクルだった\nだけだと思いますよ？"},
        { "location": "47/TALK"   , "narrator": "赤髪千羽鶴", "text": "というわけで、\n前回は思考実験への参加、\nお疲れさまでした。"},
        { "location": "48/TALK"   , "narrator": "赤髪千羽鶴", "text": "特に世界の決定に関係ある\nわけではありませんので、\n結果はお気になさらず。"},
        { "location": "49/TALK"   , "narrator": "赤髪千羽鶴", "text": "$handle$さんの\nご自身を止まって見る\n機会になればと思います。"},
        { "location": "50/TALK"   , "narrator": "赤髪千羽鶴", "text": "ついでになりますが、\n他の方がどんな選択を\nしたか統計を見ますか？"},
        { "location": "51/SEL"    , "narrator": "", "text": "見る"},
        { "location": "52/SEL"    , "narrator": "", "text": "見ない"},
        { "location": "54/TALK"   , "narrator": "赤髪千羽鶴", "text": "これも単なる\n興味の域を超えない\nデータですから――"},
        { "location": "55/TALK"   , "narrator": "赤髪千羽鶴", "text": "見てもみなくても\nどちらでも大丈夫ですよ。"},
        { "location": "57/ACT"    , "narrator": "", "text": "見る"},
        { "location": "58/TALK"   , "narrator": "赤髪千羽鶴", "text": "わかりました。"},
        { "location": "59/TALK"   , "narrator": "赤髪千羽鶴", "text": "それでは、対向時間\n2018年3月2日における\n皆さんの結果になります。"},
        { "location": "65/TALK"   , "narrator": "赤髪千羽鶴", "text": "様々なパターンを試す方も\nいらっしゃいますので、\n最初の選択の統計です。"},
        { "location": "66/TALK"   , "narrator": "赤髪千羽鶴", "text": "圧倒的に多かったのは、\n双方共に5人を助ける、\nという選択でした。"},
        { "location": "67/TALK"   , "narrator": "赤髪千羽鶴", "text": "ボタンを押す押さないに\nかかわらず、\n最大人数を救う選択。"},
        { "location": "68/TALK"   , "narrator": "赤髪千羽鶴", "text": "それはある意味において、\n保身よりも他者の命を\n優先させる行為であり――"},
        { "location": "69/TALK"   , "narrator": "赤髪千羽鶴", "text": "非常に乱暴な言い方を\nすれば、功利主義が浸透\nしてる結果とも言えます。"},
        { "location": "70/SEL"    , "narrator": "", "text": "ふむ"},
        { "location": "71/SEL"    , "narrator": "", "text": "功利主義って？"},
        { "location": "72/ACT"    , "narrator": "", "text": "ふむ"},
        { "location": "73/ACT"    , "narrator": "", "text": "功利主義って？"},
        { "location": "74/TALK"   , "narrator": "赤髪千羽鶴", "text": "千羽鶴は功利主義を\n別の表現で言ってました。"},
        { "location": "75/TALK"   , "narrator": "赤髪千羽鶴", "text": "『最大幸福論』ですね。"},
        { "location": "76/TALK"   , "narrator": "赤髪千羽鶴", "text": "全てが平等な条件ならば、\nあるいは、例えそれが\n不平等であっても――"},
        { "location": "77/TALK"   , "narrator": "赤髪千羽鶴", "text": "より最大の市民が幸せに\nなる選択こそが正しい、\nという理論です。"},
        { "location": "83/TALK"   , "narrator": "赤髪千羽鶴", "text": "今回のクレーン問題は、\nボタンを押すか押さないか\nが論点としてあります。"},
        { "location": "84/TALK"   , "narrator": "赤髪千羽鶴", "text": "すなわち、ボタンを\n押すことで、貴方は\n世間から注目される。"},
        { "location": "85/TALK"   , "narrator": "赤髪千羽鶴", "text": "その上でも、最大幸福を\n貫き通せるかどうかが\nポイントの１つでした。"},
        { "location": "88/TALK"   , "narrator": "赤髪千羽鶴", "text": "貴方の選択は両方とも\n「ボタンを押す」という\nものでしたので――"},
        { "location": "89/TALK"   , "narrator": "赤髪千羽鶴", "text": "大多数の集合意識には\n当てはまらない思考と\nいうことになります。"},
        { "location": "90/TALK"   , "narrator": "赤髪千羽鶴", "text": "前回は、\n脳体サンプル候補、なんて\n言ってしまいましたが――"},
        { "location": "91/TALK"   , "narrator": "赤髪千羽鶴", "text": "己の責任を果たすという、\n使命感があったのかも\nしれませんね。"},
        { "location": "94/TALK"   , "narrator": "赤髪千羽鶴", "text": "貴方の選択は、双方とも\n5名の犠牲を出すという\nものでした。"},
        { "location": "95/TALK"   , "narrator": "赤髪千羽鶴", "text": "これは、大多数の\n集合意識からは最も遠い\nところにある思想です。"},
        { "location": "96/TALK"   , "narrator": "赤髪千羽鶴", "text": "ただ、わたし自身あれから\n色々考えてみたのですが。\nもしかすると――"},
        { "location": "97/TALK"   , "narrator": "赤髪千羽鶴", "text": "あなたは、助けを求めて\n来た人を見捨てられない\n性格なのかもしれません。"},
        { "location": "98/TALK"   , "narrator": "赤髪千羽鶴", "text": "もしくは、死を認識する者\nを助けたい、という\n心情かもしれませんね。"},
        { "location": "99/TALK"   , "narrator": "赤髪千羽鶴", "text": "確かにそう考えると、\n非常に理にかなった\n考え方と言えます。"},
        { "location": "100/TALK"  , "narrator": "赤髪千羽鶴", "text": "死の恐怖と共にある死は、\n無意識の死と違い、精神的\n拷問死とも言えます。"},
        { "location": "101/TALK"  , "narrator": "赤髪千羽鶴", "text": "それを想像できる程に\n想像力が豊かか、もしくは\n過去に辛い経験があるか。"},
        { "location": "102/TALK"  , "narrator": "赤髪千羽鶴", "text": "少なくとも、あなたは\n本気で相手の気持ちを\n考えることができる。"},
        { "location": "103/TALK"  , "narrator": "赤髪千羽鶴", "text": "自分が世間から追及される\n未来を告げられ尚、5人を\n犠牲にする選択を２回。"},
        { "location": "104/TALK"  , "narrator": "赤髪千羽鶴", "text": "これは、ある意味において\nもの凄い精神的重荷が\nかかる行為です。"},
        { "location": "105/TALK"  , "narrator": "赤髪千羽鶴", "text": "ポジティブに言えば\n献身的。ネガティブに\n言えば自己犠牲が強い。"},
        { "location": "106/TALK"  , "narrator": "赤髪千羽鶴", "text": "…まあ、最終的には、\nあなた自身があなたを\nどう考えるかですけどね。"},
        { "location": "111/TALK"  , "narrator": "赤髪千羽鶴", "text": "貴方の選択は、\n双方共に５名を助ける\nというものでした。"},
        { "location": "112/TALK"  , "narrator": "赤髪千羽鶴", "text": "要するに、最も大衆的な\n平均的判断をしたという\nことになります。"},
        { "location": "113/TALK"  , "narrator": "赤髪千羽鶴", "text": "先に話したとおり、\n功利主義に則ったという\nことになりますね。"},
        { "location": "114/TALK"  , "narrator": "赤髪千羽鶴", "text": "んー、でももしかすると\n考え方が逆かも\nしれません。"},
        { "location": "115/TALK"  , "narrator": "赤髪千羽鶴", "text": "この結果が大多数だった、\n故にこの結果が功利主義で\nある、という考え方です。"},
        { "location": "116/TALK"  , "narrator": "赤髪千羽鶴", "text": "人は一般的に、幸せを\n追い求めますよね。"},
        { "location": "117/TALK"  , "narrator": "赤髪千羽鶴", "text": "貴方がこの選択をする時も\n少なくとも自分の幸せも\n考えているはずです。"},
        { "location": "118/TALK"  , "narrator": "赤髪千羽鶴", "text": "もっと具体的にいえば、\n例えば、自身が負い目を\n感じない選択をした――"},
        { "location": "119/TALK"  , "narrator": "赤髪千羽鶴", "text": "そういった理由であっても\n自身の幸せを考慮した\n結果なわけです。"},
        { "location": "120/TALK"  , "narrator": "赤髪千羽鶴", "text": "そうした様々な理由で、\n大多数がこの回答を\n選択したのなら――"},
        { "location": "121/TALK"  , "narrator": "赤髪千羽鶴", "text": "結果、これが最も大多数を\n幸せにする選択である、\nということになります。"},
        { "location": "122/TALK"  , "narrator": "赤髪千羽鶴", "text": "もちろん、この選択を\n苦痛と考えるひとも\n当然いるわけですが。"},
        { "location": "123/TALK"  , "narrator": "赤髪千羽鶴", "text": "功利主義では、より沢山の\n人が幸せなら、それが\nベストな回答になります。"},
        { "location": "124/TALK"  , "narrator": "赤髪千羽鶴", "text": "ですから、この回答こそが\n功利主義的回答、という\nことになるわけですね。"},
        { "location": "127/TALK"  , "narrator": "赤髪千羽鶴", "text": "貴方は２回とも\nボタンを押さないという\n選択をしました。"},
        { "location": "128/TALK"  , "narrator": "赤髪千羽鶴", "text": "正直、わたしが驚いたのは\nこの選択をした人が、\n思いの外少なかった事です。"},
        { "location": "129/TALK"  , "narrator": "赤髪千羽鶴", "text": "ですが、\nある意味それは――"},
        { "location": "130/TALK"  , "narrator": "赤髪千羽鶴", "text": "この結果は、こちらに\n接続している皆さんの\n特色かもしれません。"},
        { "location": "135/TALK"  , "narrator": "赤髪千羽鶴", "text": "……というわけで、\n前回の結果報告は\n終了です。"},
        { "location": "136/ACT"   , "narrator": "", "text": "見ない"},
        { "location": "137/TALK"  , "narrator": "赤髪千羽鶴", "text": "わかりました。"},
        { "location": "139/TALK"  , "narrator": "赤髪千羽鶴", "text": "それでは早速、\n今回の訓練を\nしたいと思います！"},
        { "location": "140/SEL"   , "narrator": "", "text": "望むところ"},
        { "location": "141/SEL"   , "narrator": "", "text": "もう次！？"},
        { "location": "142/ACT"   , "narrator": "", "text": "望むところ"},
        { "location": "143/TALK"  , "narrator": "赤髪千羽鶴", "text": "さすがですね！\n気合い満点です！"},
        { "location": "144/ACT"   , "narrator": "", "text": "もう次！？"},
        { "location": "145/TALK"  , "narrator": "赤髪千羽鶴", "text": "もちろんです！\n時間を無駄には\n出来ませんから！"},
        { "location": "147/TALK"  , "narrator": "赤髪千羽鶴", "text": "では、今回の問題を\nお話したいと思います。"},
        { "location": "148/TALK"  , "narrator": "赤髪千羽鶴", "text": "まず事前準備として――"},
        { "location": "149/TALK"  , "narrator": "赤髪千羽鶴", "text": "SKIP、AUTOモードを\n使ってる方は\n解除してください。"},
        { "location": "150/TALK"  , "narrator": "赤髪千羽鶴", "text": "その状態ですと\n貴方の意志に関係なく、\n選択進行してしまいます。"},
        { "location": "151/SEL"   , "narrator": "", "text": "SKIP・AUTOを利用している場合、解除してからこのボタンを押してください"},
        { "location": "152/SEL"   , "narrator": "", "text": "SKIP・AUTOは使っていません"},
        { "location": "153/ACT"   , "narrator": "", "text": "SKIP・AUTOを利用している場合、解除してからこのボタンを押してください"},
        { "location": "154/ACT"   , "narrator": "", "text": "SKIP・AUTOは使っていません"},
        { "location": "156/TALK"  , "narrator": "赤髪千羽鶴", "text": "ご協力\nありがとうございます。"},
        { "location": "158/TALK"  , "narrator": "赤髪千羽鶴", "text": "次に、ゲストを一人\n招待したいと思います。"},
        { "location": "159/TALK"  , "narrator": "赤髪千羽鶴", "text": "$handle$さんが\nお気に入りの子を\n一人選択してください。"},
        { "location": "160/SEL"   , "narrator": "", "text": "逢瀬つばめ"},
        { "location": "161/SEL"   , "narrator": "", "text": "國政綾水"},
        { "location": "162/SEL"   , "narrator": "", "text": "ガブリエラ"},
        { "location": "163/SEL"   , "narrator": "", "text": "恋ヶ崎みやび"},
        { "location": "164/SEL"   , "narrator": "", "text": "卯月神楽"},
        { "location": "165/SEL"   , "narrator": "", "text": "皇千羽鶴"},
        { "location": "166/SEL"   , "narrator": "", "text": "國政領火"},
        { "location": "167/ACT"   , "narrator": "", "text": "逢瀬つばめ"},
        { "location": "171/ACT"   , "narrator": "", "text": "國政綾水"},
        { "location": "175/ACT"   , "narrator": "", "text": "ガブリエラ"},
        { "location": "179/ACT"   , "narrator": "", "text": "恋ヶ崎みやび"},
        { "location": "183/ACT"   , "narrator": "", "text": "卯月神楽"},
        { "location": "187/ACT"   , "narrator": "", "text": "皇千羽鶴"},
        { "location": "191/ACT"   , "narrator": "", "text": "國政領火"},
        { "location": "196/TALK"  , "narrator": "赤髪千羽鶴", "text": "わかりました。"},
        { "location": "226/TALK"  , "narrator": "赤髪千羽鶴", "text": "さて。\nここに最愛の人がいます。\nその人が住む世界も。"},
        { "location": "227/TALK"  , "narrator": "赤髪千羽鶴", "text": "ある日、異世界戦争が\n始まりました。"},
        { "location": "228/TALK"  , "narrator": "赤髪千羽鶴", "text": "それは、どこかの異世界と\nあなたの大切な彼女がいる\n世界との戦争です。"},
        { "location": "229/TALK"  , "narrator": "赤髪千羽鶴", "text": "とはいえ、その戦争は\n普通のドンパチでは\nありません。"},
        { "location": "230/TALK"  , "narrator": "赤髪千羽鶴", "text": "突如、大自然の摂理に\nよってマッチングが\n行われて――"},
        { "location": "231/TALK"  , "narrator": "赤髪千羽鶴", "text": "その時に「攻撃」ボタンを\n押すか押さないかによって\n結果が変わるものです。"},
        { "location": "232/TALK"  , "narrator": "赤髪千羽鶴", "text": "ただ１回、１つのボタンを\n押すか押さないかだけが、\n戦争の勝敗を決めます。"},
        { "location": "233/TALK"  , "narrator": "赤髪千羽鶴", "text": "では、その\n「攻撃」ボタンを押すと\n何が起こるのか。"},
        { "location": "234/TALK"  , "narrator": "赤髪千羽鶴", "text": "マッチングされた相手の\n世界を分解し、その力を\n貴方の世界が吸収します。"},
        { "location": "235/TALK"  , "narrator": "赤髪千羽鶴", "text": "結果、相手世界は消滅し、\nあなたの$gcn$がいる\n世界は残機が１増えます。"},
        { "location": "236/TALK"  , "narrator": "赤髪千羽鶴", "text": "すなわち、次の戦争で\nもし負けても、１回は\n消滅を免れるわけです。"},
        { "location": "237/TALK"  , "narrator": "赤髪千羽鶴", "text": "「攻撃」ボタンを\n押さなかった場合\n何も起きません。"},
        { "location": "238/TALK"  , "narrator": "赤髪千羽鶴", "text": "尚、ボタンを押しても、\nあなたの$gcn$がいる\n世界は何も失いません。"},
        { "location": "239/TALK"  , "narrator": "赤髪千羽鶴", "text": "ボタンを押すことによる\n代償は無い、\nということです。"},
        { "location": "240/TALK"  , "narrator": "赤髪千羽鶴", "text": "さて、次に\n相手の行動ですが――"},
        { "location": "241/TALK"  , "narrator": "赤髪千羽鶴", "text": "戦争ですから、\n相手もボタンを押す\n可能性があります。"},
        { "location": "242/TALK"  , "narrator": "赤髪千羽鶴", "text": "もしあなたがボタンを\n押さず、相手がボタンを\n押せば――"},
        { "location": "243/TALK"  , "narrator": "赤髪千羽鶴", "text": "あなたの$gcn$の\n世界は消滅します。"},
        { "location": "244/TALK"  , "narrator": "赤髪千羽鶴", "text": "では、あなたも\n相手世界の人も\nボタンを押したら？"},
        { "location": "245/TALK"  , "narrator": "赤髪千羽鶴", "text": "エネルギーがぶつかりあい\n双方の世界に大ダメージを\n与える事になります。"},
        { "location": "246/TALK"  , "narrator": "赤髪千羽鶴", "text": "両者共に消滅は免れますが\nあなたの$gcn$は\n無傷では済みません。"},
        { "location": "247/TALK"  , "narrator": "赤髪千羽鶴", "text": "次の戦いまでに、\n$gcn$を回復して\n立て直しは可能ですが――"},
        { "location": "248/TALK"  , "narrator": "赤髪千羽鶴", "text": "それが連続すれば、彼女は\n疲弊しますし、辛い思いを\nさせるでしょう。"},
        { "location": "249/TALK"  , "narrator": "赤髪千羽鶴", "text": "戦争が何回起こるかは\nわかりません。"},
        { "location": "251/TALK"  , "narrator": "赤髪千羽鶴", "text": "さて。"},
        { "location": "273/TALK"  , "narrator": "赤髪千羽鶴", "text": "早速初戦が\n始まりました！"},
        { "location": "274/TALK"  , "narrator": "赤髪千羽鶴", "text": "今からあなたの元に\nボタンが現れます。"},
        { "location": "291/TALK"  , "narrator": "赤髪千羽鶴", "text": "…と。そんな折りに、\n貴方に電話が\n掛かってきます。"},
        { "location": "292/TALK"  , "narrator": "赤髪千羽鶴", "text": "マッチングされた\n相手の世界の人からです。"},
        { "location": "293/TALK"  , "narrator": "赤髪千羽鶴", "text": "<color=green>『我々は、攻撃ボタンを\n　押すつもりは無い』</color>"},
        { "location": "294/TALK"  , "narrator": "赤髪千羽鶴", "text": "そう言って、\n電話は切れました。"},
        { "location": "295/TALK"  , "narrator": "赤髪千羽鶴", "text": "さあ、いよいよ\n選択の時が訪れます。"},
        { "location": "311/TALK"  , "narrator": "赤髪千羽鶴", "text": "「攻撃」ボタンを\n押すか、押さないか。\nあなたが決めてください。"},
        { "location": "312/TALK"  , "narrator": "赤髪千羽鶴", "text": "相手を攻撃する場合は、\n「攻撃」ボタンを。"},
        { "location": "313/TALK"  , "narrator": "赤髪千羽鶴", "text": "攻撃しない場合は、\n「戻る」ボタンを\n押します。"},
        { "location": "338/TALK"  , "narrator": "赤髪千羽鶴", "text": "攻撃ボタンを\n受け付けました。"},
        { "location": "339/TALK"  , "narrator": "赤髪千羽鶴", "text": "あなたの世界は、\n相手の世界に\n攻撃を仕掛けました。"},
        { "location": "344/TALK"  , "narrator": "赤髪千羽鶴", "text": "キャンセルボタンを\n受け付けました。"},
        { "location": "345/TALK"  , "narrator": "赤髪千羽鶴", "text": "あなたの世界は、\n相手の世界に\n何もしませんでした。"},
        { "location": "347/SEL"   , "narrator": "", "text": "スキップモードになっています。解除してもう一度選択する場合はこちら"},
        { "location": "348/SEL"   , "narrator": "", "text": "選択しない場合は、ここでエピソードを終了します。"},
        { "location": "349/ACT"   , "narrator": "", "text": "スキップモードになっています。解除してもう一度選択する場合はこちら"},
        { "location": "351/ACT"   , "narrator": "", "text": "選択しない場合は、ここでエピソードを終了します。"},
        { "location": "379/TALK"  , "narrator": "赤髪千羽鶴", "text": "さて。"},
        { "location": "380/TALK"  , "narrator": "赤髪千羽鶴", "text": "あなたの選択が、\nあなたの世界にどんな\n結果をもたらすか。"},
        { "location": "381/TALK"  , "narrator": "赤髪千羽鶴", "text": "それは次回、\n確率で出したいと\n思います。"},
        { "location": "382/TALK"  , "narrator": "赤髪千羽鶴", "text": "あなたの選択によって、\nあなたの$gcn$が\nどうなるかの確率です。"},
        { "location": "383/TALK"  , "narrator": "赤髪千羽鶴", "text": "そこから色々なことが\nわかると思います。"},
        { "location": "385/TALK"  , "narrator": "赤髪千羽鶴", "text": "というわけで、\n今回の訓練は\nこれでお終いです。"},
        { "location": "386/TALK"  , "narrator": "赤髪千羽鶴", "text": "今回は初回選択は\n見ませんし、回答は何度\nでも変更可能ですから――"},
        { "location": "387/TALK"  , "narrator": "赤髪千羽鶴", "text": "日々色々な角度で考え、\n判断が変わったら気軽に\n再回答して下さいね。"},
        { "location": "389/TALK"  , "narrator": "赤髪千羽鶴", "text": "というわけで、\n前回はデートに\n行きましたけど！"},
        { "location": "390/TALK"  , "narrator": "赤髪千羽鶴", "text": "わたしの知識不足で\nヘンなところばかり候補に\nあげてごめんなさい。"},
        { "location": "391/SEL"   , "narrator": "", "text": "いやー、マジでひいたわー"},
        { "location": "392/SEL"   , "narrator": "", "text": "まあそういうこともあるよ"},
        { "location": "393/SEL"   , "narrator": "", "text": "全然そんなことないよ、楽しかったよ！"},
        { "location": "394/ACT"   , "narrator": "", "text": "いやー、マジでひいたわー"},
        { "location": "395/TALK"  , "narrator": "赤髪千羽鶴", "text": "ですよねー。"},
        { "location": "396/ACT"   , "narrator": "", "text": "まあそういうこともあるよ"},
        { "location": "397/TALK"  , "narrator": "赤髪千羽鶴", "text": "そういうもの\nなのでしょうか。"},
        { "location": "398/ACT"   , "narrator": "", "text": "全然そんなことないよ、楽しかったよ！"},
        { "location": "399/TALK"  , "narrator": "赤髪千羽鶴", "text": "そう言ってくれる\n$handle$さんが\n好きです。"},
        { "location": "401/TALK"  , "narrator": "赤髪千羽鶴", "text": "今回は勉強してきたので、\n$handle$さんにも\nご満足いただけるかと！"},
        { "location": "402/TALK"  , "narrator": "赤髪千羽鶴", "text": "さあ！\nというわけで、今回は\n遊園地に行きましょう！"},
        { "location": "403/SEL"   , "narrator": "", "text": "やったー！"},
        { "location": "404/SEL"   , "narrator": "", "text": "遊園地！？\n…ちょっとパス"},
        { "location": "405/ACT"   , "narrator": "", "text": "やったー！"},
        { "location": "406/TALK"  , "narrator": "赤髪千羽鶴", "text": "ふふっ、\n喜んでもらえて\nよかったです！"},
        { "location": "407/TALK"  , "narrator": "赤髪千羽鶴", "text": "それでは、行きますよ！"},
        { "location": "418/TALK"  , "narrator": "赤髪千羽鶴", "text": "つきました！"},
        { "location": "419/TALK"  , "narrator": "赤髪千羽鶴", "text": "今回はちゃんと\nデートですよね！"},
        { "location": "420/SEL"   , "narrator": "", "text": "そうだね"},
        { "location": "421/SEL"   , "narrator": "", "text": "お、おう"},
        { "location": "422/ACT"   , "narrator": "", "text": "そうだね"},
        { "location": "423/TALK"  , "narrator": "赤髪千羽鶴", "text": "ふふっ、\n良かったです！"},
        { "location": "424/ACT"   , "narrator": "", "text": "お、おう"},
        { "location": "425/TALK"  , "narrator": "赤髪千羽鶴", "text": "なんだか妙に\n歯切れが悪いですね？"},
        { "location": "427/TALK"  , "narrator": "赤髪千羽鶴", "text": "それでは、\n何して遊びますか？"},
        { "location": "428/SEL"   , "narrator": "", "text": "ジェットコースター"},
        { "location": "429/SEL"   , "narrator": "", "text": "メリーゴーランド"},
        { "location": "430/ACT"   , "narrator": "", "text": "ジェットコースター"},
        { "location": "431/TALK"  , "narrator": "赤髪千羽鶴", "text": "なるほど。確かに\n遊園地といえばジェット\nコースターが人気ですね。"},
        { "location": "432/TALK"  , "narrator": "赤髪千羽鶴", "text": "でも、いつも\n思っていたんですけど――"},
        { "location": "433/TALK"  , "narrator": "赤髪千羽鶴", "text": "ジェットコースターって\nどうして皆さん\n乗りたがるのでしょう？"},
        { "location": "434/TALK"  , "narrator": "赤髪千羽鶴", "text": "敢えて身体に苦痛を与え、\n精神を極限状態に置く\nことになるのに。"},
        { "location": "435/SEL"   , "narrator": "", "text": "個性的な意見だね…"},
        { "location": "436/SEL"   , "narrator": "", "text": "もしかして怖いの？"},
        { "location": "437/ACT"   , "narrator": "", "text": "個性的な意見だね…"},
        { "location": "438/TALK"  , "narrator": "赤髪千羽鶴", "text": "うーん、そうでしょうか？"},
        { "location": "439/TALK"  , "narrator": "赤髪千羽鶴", "text": "ジェットコースターに\n乗りたいという意見が\n多数ある世界は――"},
        { "location": "440/TALK"  , "narrator": "赤髪千羽鶴", "text": "いわば自殺志願者が\n沢山いる世界と\n同義だと思いますが。"},
        { "location": "441/ACT"   , "narrator": "", "text": "もしかして怖いの？"},
        { "location": "442/TALK"  , "narrator": "赤髪千羽鶴", "text": "はい、怖いです！"},
        { "location": "443/TALK"  , "narrator": "赤髪千羽鶴", "text": "肉体に対して大きな衝撃を\n敢えて与えるわけですから\n何があるかわかりません。"},
        { "location": "444/TALK"  , "narrator": "赤髪千羽鶴", "text": "レールもいつ脱線するか\nわかりませんし――"},
        { "location": "445/TALK"  , "narrator": "赤髪千羽鶴", "text": "人生においてあまり\n意味を見いだせない\nロシアンルーレットです。"},
        { "location": "447/SEL"   , "narrator": "", "text": "あ、はい"},
        { "location": "448/ACT"   , "narrator": "", "text": "あ、はい"},
        { "location": "450/TALK"  , "narrator": "赤髪千羽鶴", "text": "とまあ、\nそんな話をしていても\n仕方ありませんし。"},
        { "location": "451/TALK"  , "narrator": "赤髪千羽鶴", "text": "そろそろ、\n乗りに行きましょうか。"},
        { "location": "452/SEL"   , "narrator": "", "text": "えっ、乗るの？？"},
        { "location": "453/SEL"   , "narrator": "", "text": "インテリ系ツンデレなつばめかわいい"},
        { "location": "454/ACT"   , "narrator": "", "text": "えっ、乗るの？？"},
        { "location": "455/TALK"  , "narrator": "赤髪千羽鶴", "text": "えっ？"},
        { "location": "456/TALK"  , "narrator": "赤髪千羽鶴", "text": "だって、\n$handle$さんが\n乗りたいって言いました。"},
        { "location": "457/TALK"  , "narrator": "赤髪千羽鶴", "text": "ああっ、もしかして！\n今更死ぬのが\n怖くなったんですか！？"},
        { "location": "458/TALK"  , "narrator": "赤髪千羽鶴", "text": "私は既に、\n覚悟は出来てますよ！"},
        { "location": "459/ACT"   , "narrator": "", "text": "インテリ系ツンデレなつばめかわいい"},
        { "location": "461/TALK"  , "narrator": "赤髪千羽鶴", "text": "んんん…？？"},
        { "location": "462/TALK"  , "narrator": "赤髪千羽鶴", "text": "よくわからないですけど、\nかわいいというのは\n多分間違いです。"},
        { "location": "463/TALK"  , "narrator": "赤髪千羽鶴", "text": "今まで一度もそんな事\n言われたことありません\nから間違いありません！"},
        { "location": "464/TALK"  , "narrator": "赤髪千羽鶴", "text": "さあ、それより\n早く行きましょう。"},
        { "location": "466/TALK"  , "narrator": "赤髪千羽鶴", "text": "私はもう、\n死に対する覚悟は\n出来てます！"},
        { "location": "474/TALK"  , "narrator": "赤髪千羽鶴", "text": "ふわあああ……\n死よりも酷い\n体験をしました。"},
        { "location": "475/SEL"   , "narrator": "", "text": "大丈夫！？"},
        { "location": "476/SEL"   , "narrator": "", "text": "楽しかった？"},
        { "location": "477/ACT"   , "narrator": "", "text": "大丈夫！？"},
        { "location": "478/TALK"  , "narrator": "赤髪千羽鶴", "text": "はい、何とか。"},
        { "location": "479/ACT"   , "narrator": "", "text": "楽しかった？"},
        { "location": "481/TALK"  , "narrator": "赤髪千羽鶴", "text": "はい！\n実は楽しかったです！"},
        { "location": "483/TALK"  , "narrator": "赤髪千羽鶴", "text": "とても貴重な体験が\nできましたから。"},
        { "location": "485/TALK"  , "narrator": "赤髪千羽鶴", "text": "今回の体験を一言で\n言うなら、臨死体験\nでしょうか！"},
        { "location": "486/SEL"   , "narrator": "", "text": "わかる"},
        { "location": "487/SEL"   , "narrator": "", "text": "わからない"},
        { "location": "488/ACT"   , "narrator": "", "text": "わかる"},
        { "location": "489/TALK"  , "narrator": "赤髪千羽鶴", "text": "ああっ！\n共感してくれて\n嬉しいです！"},
        { "location": "490/ACT"   , "narrator": "", "text": "わからない"},
        { "location": "491/TALK"  , "narrator": "赤髪千羽鶴", "text": "ええっ！\nわたしだけですか！？"},
        { "location": "493/TALK"  , "narrator": "赤髪千羽鶴", "text": "何にしても、皆さんが\nジェットコースター中毒に\nなるのもわかりました。"},
        { "location": "494/TALK"  , "narrator": "赤髪千羽鶴", "text": "これほどお手軽に\n死を体験出来る機械も\n他にありませんよね。"},
        { "location": "495/TALK"  , "narrator": "赤髪千羽鶴", "text": "さあ、\nもう一度行きましょう！"},
        { "location": "496/ACT"   , "narrator": "", "text": "メリーゴーランド"},
        { "location": "497/TALK"  , "narrator": "赤髪千羽鶴", "text": "なるほど。\n確かに遊園地には\n必ずありますよね。"},
        { "location": "498/TALK"  , "narrator": "赤髪千羽鶴", "text": "ですが、\n素朴な疑問がありまして。"},
        { "location": "499/SEL"   , "narrator": "", "text": "なに？"},
        { "location": "500/ACT"   , "narrator": "", "text": "なに？"},
        { "location": "502/TALK"  , "narrator": "赤髪千羽鶴", "text": "これって\n何が面白いのでしょうか。"},
        { "location": "503/SEL"   , "narrator": "", "text": "まあ、本来は小さなお子様向けだからね"},
        { "location": "504/SEL"   , "narrator": "", "text": "好き合ってる男女がキャッキャウフフするのが楽しいんだよ"},
        { "location": "505/SEL"   , "narrator": "", "text": "それ言っちゃダメ"},
        { "location": "506/ACT"   , "narrator": "", "text": "まあ、本来は小さなお子様向けだからね"},
        { "location": "507/TALK"  , "narrator": "赤髪千羽鶴", "text": "それはわかります。"},
        { "location": "508/TALK"  , "narrator": "赤髪千羽鶴", "text": "問題は大人同士で\n乗ってる人達ですよ。"},
        { "location": "509/TALK"  , "narrator": "赤髪千羽鶴", "text": "いわゆる置物の動物が\n概ね４～５周回するだけで\nお終いですよね。"},
        { "location": "510/ACT"   , "narrator": "", "text": "好き合ってる男女がキャッキャウフフするのが楽しいんだよ"},
        { "location": "512/TALK"  , "narrator": "赤髪千羽鶴", "text": "えっと、要するに\nその解釈で言えば……"},
        { "location": "513/TALK"  , "narrator": "赤髪千羽鶴", "text": "馬の形をしている\n必要は無いのでは？"},
        { "location": "515/TALK"  , "narrator": "赤髪千羽鶴", "text": "同じ所を４～５周回\nするのは、恐らく用地的な\n問題かと思いますが。"},
        { "location": "516/ACT"   , "narrator": "", "text": "それ言っちゃダメ"},
        { "location": "517/TALK"  , "narrator": "赤髪千羽鶴", "text": "ああっ！\nすみません！"},
        { "location": "518/TALK"  , "narrator": "赤髪千羽鶴", "text": "これはいわゆる\n遊園地のタブーという\n類のものなんですね！"},
        { "location": "520/TALK"  , "narrator": "赤髪千羽鶴", "text": "いずれにせよ、\n馬に乗りたければ\n牧場に行くべきです！"},
        { "location": "521/SEL"   , "narrator": "", "text": "多分、馬に乗りたいわけじゃないと思うよ？"},
        { "location": "522/SEL"   , "narrator": "", "text": "じゃあ、牧場に行く？"},
        { "location": "523/SEL"   , "narrator": "", "text": "これは可愛い馬に乗った可愛いつばめを尊い気持ちで見る為の遊具なんだよ！"},
        { "location": "524/ACT"   , "narrator": "", "text": "多分、馬に乗りたいわけじゃないと思うよ？"},
        { "location": "526/TALK"  , "narrator": "赤髪千羽鶴", "text": "そうなんですか！？"},
        { "location": "528/TALK"  , "narrator": "赤髪千羽鶴", "text": "んー、そうなってくると、\n更にこの遊具の存在価値が\nわかりません。"},
        { "location": "529/TALK"  , "narrator": "赤髪千羽鶴", "text": "まあでも、そんな時こそ\n百聞は一見にしかずです！"},
        { "location": "530/TALK"  , "narrator": "赤髪千羽鶴", "text": "乗りに行きましょう！"},
        { "location": "531/ACT"   , "narrator": "", "text": "じゃあ、牧場に行く？"},
        { "location": "532/TALK"  , "narrator": "赤髪千羽鶴", "text": "わたしが馬に乗りたい\nわけじゃありませんから。"},
        { "location": "533/TALK"  , "narrator": "赤髪千羽鶴", "text": "さあ、そんなことより！\n決めたからには早く\n乗りに行きましょう！"},
        { "location": "534/ACT"   , "narrator": "", "text": "これは可愛い馬に乗った可愛いつばめを尊い気持ちで見る為の遊具なんだよ！"},
        { "location": "536/TALK"  , "narrator": "赤髪千羽鶴", "text": "そ、そうなんですか！"},
        { "location": "537/TALK"  , "narrator": "赤髪千羽鶴", "text": "困りました。\nここには可愛くない\nわたししかいません……。"},
        { "location": "538/TALK"  , "narrator": "赤髪千羽鶴", "text": "御希望に添えず\n申し訳ありません！"},
        { "location": "539/SEL"   , "narrator": "", "text": "かわいいいいいいい！！"},
        { "location": "540/SEL"   , "narrator": "", "text": "素のままで十分希望に添えてますから安心して下さい"},
        { "location": "541/SEL"   , "narrator": "", "text": "確かに可愛くないつばめしかいないな"},
        { "location": "542/ACT"   , "narrator": "", "text": "かわいいいいいいい！！"},
        { "location": "543/TALK"  , "narrator": "赤髪千羽鶴", "text": "えええっ！？\nよくわかりません！"},
        { "location": "544/TALK"  , "narrator": "赤髪千羽鶴", "text": "いずれにせよ、\n乗ると決めたからには\n腹をくくります！"},
        { "location": "546/TALK"  , "narrator": "赤髪千羽鶴", "text": "頑張って、可愛い\n逢瀬つばめを演じますので\nよろしくお願いします！"},
        { "location": "547/ACT"   , "narrator": "", "text": "素のままで十分希望に添えてますから安心して下さい"},
        { "location": "548/TALK"  , "narrator": "赤髪千羽鶴", "text": "そ、そうなんですか？"},
        { "location": "549/TALK"  , "narrator": "赤髪千羽鶴", "text": "人の価値観って\n本当に人それぞれ\nなんですね。"},
        { "location": "551/TALK"  , "narrator": "赤髪千羽鶴", "text": "今日はまたひとつ\n勉強になりました。"},
        { "location": "552/ACT"   , "narrator": "", "text": "確かに可愛くないつばめしかいないな"},
        { "location": "554/TALK"  , "narrator": "赤髪千羽鶴", "text": "本当にすみません……。"},
        { "location": "555/TALK"  , "narrator": "赤髪千羽鶴", "text": "まあでも、\n乗ると決めてしまったのは\n$handle$さんです。"},
        { "location": "556/TALK"  , "narrator": "赤髪千羽鶴", "text": "可愛くなくても、\n時間の無駄でも、\n決めた事はやるべきです。"},
        { "location": "559/TALK"  , "narrator": "赤髪千羽鶴", "text": "さあ、\n乗りにいきますよ！"},
        { "location": "566/TALK"  , "narrator": "赤髪千羽鶴", "text": "は～～～～。"},
        { "location": "567/TALK"  , "narrator": "赤髪千羽鶴", "text": "やっぱり同じ所を\n周回するだけの\n遊具でしたね。"},
        { "location": "568/SEL"   , "narrator": "", "text": "楽しくなかった？"},
        { "location": "569/SEL"   , "narrator": "", "text": "なんだこれ！つばめの可愛いシーン飛ばされとるやんけバグだろバグ！！"},
        { "location": "570/ACT"   , "narrator": "", "text": "楽しくなかった？"},
        { "location": "571/TALK"  , "narrator": "赤髪千羽鶴", "text": "んー、そうですね。"},
        { "location": "572/TALK"  , "narrator": "赤髪千羽鶴", "text": "乗っている間、どんな\n体験に集中することで\n楽しさを味わえるか――"},
        { "location": "573/TALK"  , "narrator": "赤髪千羽鶴", "text": "多角的な視野で\n実践してみました。"},
        { "location": "574/TALK"  , "narrator": "赤髪千羽鶴", "text": "その結果、今までにない\n新たな発見がありまして。"},
        { "location": "575/TALK"  , "narrator": "赤髪千羽鶴", "text": "結論としては\n楽しかったです。"},
        { "location": "576/SEL"   , "narrator": "", "text": "それはよかった"},
        { "location": "577/SEL"   , "narrator": "", "text": "具体的にはどんな発見？"},
        { "location": "578/ACT"   , "narrator": "", "text": "それはよかった"},
        { "location": "579/TALK"  , "narrator": "赤髪千羽鶴", "text": "はい。"},
        { "location": "580/ACT"   , "narrator": "", "text": "具体的にはどんな発見？"},
        { "location": "581/TALK"  , "narrator": "赤髪千羽鶴", "text": "動体視力が静止視力より\n機能的に劣る点を利用した\n演出効果により――"},
        { "location": "582/TALK"  , "narrator": "赤髪千羽鶴", "text": "周囲の人や物の評価が、\n平均的なそれよりも\n上昇するという発見です。"},
        { "location": "583/TALK"  , "narrator": "赤髪千羽鶴", "text": "簡単に言えば、電飾による\nライトアップと移動による\n背景のぼかし効果で――"},
        { "location": "585/TALK"  , "narrator": "赤髪千羽鶴", "text": "あなたが普段より\n1.2倍ほど美しく\n見えました。"},
        { "location": "588/ACT"   , "narrator": "", "text": "なんだこれ！つばめの可愛いシーン飛ばされとるやんけバグだろバグ！！"},
        { "location": "590/TALK"  , "narrator": "赤髪千羽鶴", "text": "検討した結果、可愛い\nシーンなんて無かったので\nカットしました！"},
        { "location": "591/SEL"   , "narrator": "", "text": "自分に対する評価が低すぎる"},
        { "location": "592/SEL"   , "narrator": "", "text": "$me$の価値観からだと可愛いしか無いので復活させてください"},
        { "location": "593/ACT"   , "narrator": "", "text": "自分に対する評価が低すぎる"},
        { "location": "595/TALK"  , "narrator": "赤髪千羽鶴", "text": "そうでしょうか。\n過去の実績から\n妥当だと思ってますよ。"},
        { "location": "596/ACT"   , "narrator": "", "text": "$me$の価値観からだと可愛いしか無いので復活させてください"},
        { "location": "597/TALK"  , "narrator": "赤髪千羽鶴", "text": "だめです！"},
        { "location": "598/TALK"  , "narrator": "赤髪千羽鶴", "text": "そんなイレギュラーな\n価値観を元に採用なんて\nできません！"},
        { "location": "599/SEL"   , "narrator": "", "text": "強情ー！"},
        { "location": "600/SEL"   , "narrator": "", "text": "もしかして照れてるだけでは？"},
        { "location": "601/ACT"   , "narrator": "", "text": "強情ー！"},
        { "location": "602/TALK"  , "narrator": "赤髪千羽鶴", "text": "何とでも\n言ってください。"},
        { "location": "603/ACT"   , "narrator": "", "text": "もしかして照れてるだけでは？"},
        { "location": "604/TALK"  , "narrator": "赤髪千羽鶴", "text": "そ、そんなこと\nありませんよ！"},
        { "location": "619/TALK"  , "narrator": "赤髪千羽鶴", "text": "ふぅ、\nただいまっと。"},
        { "location": "620/TALK"  , "narrator": "赤髪千羽鶴", "text": "遊園地、\nとっても楽しかったです！"},
        { "location": "621/SEL"   , "narrator": "", "text": "$me$も楽しかった"},
        { "location": "622/SEL"   , "narrator": "", "text": "次はどこへ行こうか"},
        { "location": "623/ACT"   , "narrator": "", "text": "$me$も楽しかった"},
        { "location": "624/TALK"  , "narrator": "赤髪千羽鶴", "text": "それはよかったです！"},
        { "location": "625/TALK"  , "narrator": "赤髪千羽鶴", "text": "やっぱりお互い\n楽しめるのが\n一番ですよね。"},
        { "location": "626/ACT"   , "narrator": "", "text": "次はどこへ行こうか"},
        { "location": "627/TALK"  , "narrator": "赤髪千羽鶴", "text": "そうですね。"},
        { "location": "628/TALK"  , "narrator": "赤髪千羽鶴", "text": "それは次回までの\nわたしの宿題に\nさせてください！"},
        { "location": "629/TALK"  , "narrator": "赤髪千羽鶴", "text": "$handle$さんと\n二人で楽しめることを\n探しておきますから！"},
        { "location": "631/ACT"   , "narrator": "", "text": "遊園地！？\n…ちょっとパス"},
        { "location": "632/TALK"  , "narrator": "赤髪千羽鶴", "text": "っと、ダメでしたか？"},
        { "location": "633/TALK"  , "narrator": "赤髪千羽鶴", "text": "ごめんなさい。\nまたわたしの\n勉強不足でしたね。"},
        { "location": "634/TALK"  , "narrator": "赤髪千羽鶴", "text": "次こそは、\n御希望に添えるよう\n頑張りますので！"},
        { "location": "636/TALK"  , "narrator": "赤髪千羽鶴", "text": "というわけで、\n今回のデートは\nこれでお終いです。"},
        { "location": "638/TALK"  , "narrator": "赤髪千羽鶴", "text": "この後ですが――"},
        { "location": "639/TALK"  , "narrator": "赤髪千羽鶴", "text": "前回と同じように\nこのセクションの記録\n映像を見ていきますか？"},
        { "location": "640/TALK"  , "narrator": "赤髪千羽鶴", "text": "今のスタックポインタは\n記録映像でいえば\n2016年7月16日――"},
        { "location": "641/TALK"  , "narrator": "赤髪千羽鶴", "text": "アーヤさんとガブちゃんの\nメルティ戦、及び人形劇\nサークルの件です。"},
        { "location": "644/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/78MB 5:05】</color>"},
        { "location": "645/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/25MB 5:05】</color>"},
        { "location": "646/SEL"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "647/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/78MB 5:05】</color>"},
        { "location": "648/TALK"  , "narrator": "赤髪千羽鶴", "text": "わかりました。\nそれでは再生しましょう。"},
        { "location": "654/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/25MB 5:05】</color>"},
        { "location": "655/TALK"  , "narrator": "赤髪千羽鶴", "text": "わかりました。\nそれでは再生しましょう。"},
        { "location": "661/ACT"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "662/TALK"  , "narrator": "赤髪千羽鶴", "text": "わかりました。\nそれではレポートを\nご覧下さい。"},
        { "location": "695/TALK"  , "narrator": "赤髪千羽鶴", "text": "それじゃ、また次回。"},
        { "location": "696/SEL"   , "narrator": "", "text": "はーい"},
        { "location": "697/SEL"   , "narrator": "", "text": "ちょまって！！"},
        { "location": "698/ACT"   , "narrator": "", "text": "はーい"},
        { "location": "699/ACT"   , "narrator": "", "text": "ちょまって！！"},
        { "location": "700/TALK"  , "narrator": "赤髪千羽鶴", "text": "またですか？"},
        { "location": "701/TALK"  , "narrator": "赤髪千羽鶴", "text": "今回こそ、記録映像に\n対するコメントは\n一切無いんですが。"},
        { "location": "702/SEL"   , "narrator": "", "text": "じゃあそろそろ、つばめについて色々教えて欲しい"},
        { "location": "703/ACT"   , "narrator": "", "text": "じゃあそろそろ、つばめについて色々教えて欲しい"},
        { "location": "706/TALK"  , "narrator": "赤髪千羽鶴", "text": "んー、そうですね。"},
        { "location": "707/TALK"  , "narrator": "赤髪千羽鶴", "text": "わかりました。\nそれでは改めて、わたしに\nついてお話します。"},
        { "location": "708/TALK"  , "narrator": "赤髪千羽鶴", "text": "そもそもわたしとは\n一体だれなのか！"},
        { "location": "709/TALK"  , "narrator": "赤髪千羽鶴", "text": "そう思ったことは\nありませんか？"},
        { "location": "710/SEL"   , "narrator": "", "text": "つばめはつばめでしょ"},
        { "location": "711/SEL"   , "narrator": "", "text": "ある"},
        { "location": "712/ACT"   , "narrator": "", "text": "つばめはつばめでしょ"},
        { "location": "713/TALK"  , "narrator": "赤髪千羽鶴", "text": "まあ、確かに\nそうなんですけど……。"},
        { "location": "714/TALK"  , "narrator": "赤髪千羽鶴", "text": "何が言いたいかというと、\nわたしと、千羽鶴と、\n可愛いつばめの関係です。"},
        { "location": "715/ACT"   , "narrator": "", "text": "ある"},
        { "location": "716/TALK"  , "narrator": "赤髪千羽鶴", "text": "さすがですね！"},
        { "location": "718/TALK"  , "narrator": "赤髪千羽鶴", "text": "まあ、普通に考えると、\n千羽鶴と可愛いつばめを\n足したらわたしです。"},
        { "location": "719/TALK"  , "narrator": "赤髪千羽鶴", "text": "ならば、彼女たちを\n足したら、わたしが\n二人になってしまいます。"},
        { "location": "720/TALK"  , "narrator": "赤髪千羽鶴", "text": "わたし、千羽鶴、\n可愛いつばめ。実際に\n3人とも実在してますし。"},
        { "location": "721/TALK"  , "narrator": "赤髪千羽鶴", "text": "でも、実際は\n3人でひとりの\n逢瀬つばめです。"},
        { "location": "722/SEL"   , "narrator": "", "text": "ふむ"},
        { "location": "723/ACT"   , "narrator": "", "text": "ふむ"},
        { "location": "725/TALK"  , "narrator": "赤髪千羽鶴", "text": "えっと…\nわかりますか？"},
        { "location": "726/TALK"  , "narrator": "赤髪千羽鶴", "text": "こう考えると\nすこし頭の整理が\n出来るかもしれません。"},
        { "location": "729/TALK"  , "narrator": "赤髪千羽鶴", "text": "如月音羽。\n彼女は文京ドームで\nフェノメノンを発症。"},
        { "location": "731/TALK"  , "narrator": "赤髪千羽鶴", "text": "その結果、クラン\nテルプシコラを\n生み出しました。"},
        { "location": "732/TALK"  , "narrator": "赤髪千羽鶴", "text": "では、テルプシコラが\n生まれ、フェノメノンが\n出来ていたとき――"},
        { "location": "733/TALK"  , "narrator": "赤髪千羽鶴", "text": "如月音羽は一体\nどうなっていたので\nしょうか！"},
        { "location": "734/TALK"  , "narrator": "赤髪千羽鶴", "text": "答えは驚く程簡単です。"},
        { "location": "736/TALK"  , "narrator": "赤髪千羽鶴", "text": "如月音羽は\n世界になっていたのです。"},
        { "location": "737/TALK"  , "narrator": "赤髪千羽鶴", "text": "乱暴にいえば、\nフェノメノンそのものに\n変身していたということ。"},
        { "location": "738/TALK"  , "narrator": "赤髪千羽鶴", "text": "ですから、フェノメノンが\n収束した後で、彼女は\n姿を現しましたよね？"},
        { "location": "741/TALK"  , "narrator": "赤髪千羽鶴", "text": "わたしも基本は\n彼女と同じです。"},
        { "location": "742/TALK"  , "narrator": "赤髪千羽鶴", "text": "如月音羽＝わたし。\nテルプシコラ＝千羽鶴。"},
        { "location": "743/TALK"  , "narrator": "赤髪千羽鶴", "text": "では、今話している\nわたしは何なのでしょう。"},
        { "location": "744/TALK"  , "narrator": "赤髪千羽鶴", "text": "それは、日本を包む\nフェノメノンそのものの\n意志という存在です。"},
        { "location": "745/TALK"  , "narrator": "赤髪千羽鶴", "text": "ですから、あなたは\nフェノメノンとなった\nつばめと話しています。"},
        { "location": "748/TALK"  , "narrator": "赤髪千羽鶴", "text": "如月音羽が、つばめと\n神楽を自分の世界に招待\nしたのは覚えてますか？"},
        { "location": "749/TALK"  , "narrator": "赤髪千羽鶴", "text": "あれと近い状況で、\nわたしは今、あなたと\n話しているわけです。"},
        { "location": "752/SEL"   , "narrator": "", "text": "千羽鶴がセルフクランでしょ？セルフクラン＝本体じゃないの？"},
        { "location": "753/SEL"   , "narrator": "", "text": "じゃあ、可愛いつばめはどんな存在なの？"},
        { "location": "754/ACT"   , "narrator": "", "text": "千羽鶴がセルフクランでしょ？セルフクラン＝本体じゃないの？"},
        { "location": "755/TALK"  , "narrator": "赤髪千羽鶴", "text": "それは誤解です。"},
        { "location": "756/TALK"  , "narrator": "赤髪千羽鶴", "text": "ちょっとおさらいを\nしてみましょう。"},
        { "location": "760/TALK"  , "narrator": "赤髪千羽鶴", "text": "例えば、國政綾水には、\n水鏡の神子という\nセルフクランがいます。"},
        { "location": "761/TALK"  , "narrator": "赤髪千羽鶴", "text": "彼女がフェノメノンを\n発症すれば――"},
        { "location": "762/TALK"  , "narrator": "赤髪千羽鶴", "text": "……。"},
        { "location": "764/TALK"  , "narrator": "赤髪千羽鶴", "text": "いや、やめましょう。"},
        { "location": "767/TALK"  , "narrator": "赤髪千羽鶴", "text": "例えば、ガブリエラには、\nマークスマンという\nセルフクランがいます。"},
        { "location": "768/TALK"  , "narrator": "赤髪千羽鶴", "text": "彼女がフェノメノンを\n発症すればマークスマンが\n世界を制御しますが――"},
        { "location": "769/TALK"  , "narrator": "赤髪千羽鶴", "text": "それは、発症によって\nマークスマンの力が超絶に\n強くなっただけです。"},
        { "location": "770/TALK"  , "narrator": "赤髪千羽鶴", "text": "他の数多の人格、すなわち\nクランたちが消える\nわけでもなく――"},
        { "location": "771/TALK"  , "narrator": "赤髪千羽鶴", "text": "ガブリエラ本人が\nマークスマンに変身する\nわけでもありません。"},
        { "location": "772/TALK"  , "narrator": "赤髪千羽鶴", "text": "ここまで、\nわかりますよね？"},
        { "location": "775/TALK"  , "narrator": "赤髪千羽鶴", "text": "では、他の人格や\n総意としてのガブリエラは\nどうなったのか。"},
        { "location": "776/TALK"  , "narrator": "赤髪千羽鶴", "text": "フェノメノン、すなわち\n世界そのものになっている\nというわけです。"},
        { "location": "777/TALK"  , "narrator": "赤髪千羽鶴", "text": "当然肉体としては\n存在しませんから、\n顕在はできません。"},
        { "location": "778/TALK"  , "narrator": "赤髪千羽鶴", "text": "が、然るべき装置があれば\nこうしてわたしのように、\n対話することができます。"},
        { "location": "779/ACT"   , "narrator": "", "text": "じゃあ、可愛いつばめはどんな存在なの？"},
        { "location": "780/TALK"  , "narrator": "赤髪千羽鶴", "text": "んー、\nそこが一番\n説明が難しいのですが。"},
        { "location": "781/TALK"  , "narrator": "赤髪千羽鶴", "text": "わたしが特殊な脳器質で\nあるが故の、結果として\n顕在する存在になります。"},
        { "location": "782/TALK"  , "narrator": "赤髪千羽鶴", "text": "誤解を恐れずに言うなら、\n千羽鶴とは別の、\nもう一人のセルフクラン。"},
        { "location": "783/TALK"  , "narrator": "赤髪千羽鶴", "text": "発症クランは、その世界を\n自由に作り替えることが\nできるのですが――"},
        { "location": "784/TALK"  , "narrator": "赤髪千羽鶴", "text": "わたしという存在は、\nそのセルフクランが\n2人いるということです。"},
        { "location": "785/TALK"  , "narrator": "赤髪千羽鶴", "text": "他にあまり例が無いので、\nこれくらいしか説明\n出来ませんが。"},
        { "location": "787/TALK"  , "narrator": "赤髪千羽鶴", "text": "――と、\nこんなところでしょうか。"},
        { "location": "789/TALK"  , "narrator": "赤髪千羽鶴", "text": "んー、そうですね。"},
        { "location": "790/TALK"  , "narrator": "赤髪千羽鶴", "text": "わかりました。\nそれでは改めて、わたしに\nついてお話します。"},
        { "location": "792/TALK"  , "narrator": "赤髪千羽鶴", "text": "えっと――"},
        { "location": "793/TALK"  , "narrator": "赤髪千羽鶴", "text": "名前や年齢は既に\nご存知かと思いますので。"},
        { "location": "795/TALK"  , "narrator": "赤髪千羽鶴", "text": "まず、\n趣味とかでしょうか。\n趣味はですね――"},
        { "location": "796/TALK"  , "narrator": "赤髪千羽鶴", "text": "折り紙と、\n音楽を聴くのと、\nあとは読書ですね。"},
        { "location": "797/SEL"   , "narrator": "", "text": "折り紙って何を折るの？"},
        { "location": "798/SEL"   , "narrator": "", "text": "音楽は何を聴くの？"},
        { "location": "799/SEL"   , "narrator": "", "text": "読書は何を読むの？"},
        { "location": "800/ACT"   , "narrator": "", "text": "折り紙って何を折るの？"},
        { "location": "801/TALK"  , "narrator": "赤髪千羽鶴", "text": "鶴を折るのが好きです。\nあとは……"},
        { "location": "802/TALK"  , "narrator": "赤髪千羽鶴", "text": "…パクパク？"},
        { "location": "803/ACT"   , "narrator": "", "text": "音楽は何を聴くの？"},
        { "location": "804/TALK"  , "narrator": "赤髪千羽鶴", "text": "FreyMENOWですよ！"},
        { "location": "806/TALK"  , "narrator": "赤髪千羽鶴", "text": "メノウちゃんの歌を\n聞いていると、とっても\n癒されるんですよ。"},
        { "location": "807/TALK"  , "narrator": "赤髪千羽鶴", "text": "聞ける時間は限られて\nいましたが、一生懸命\n聞いて歌を覚えてました。"},
        { "location": "809/TALK"  , "narrator": "赤髪千羽鶴", "text": "そうすれば、音楽を\n聴けないときでも、\n頭の中で流せますから。"},
        { "location": "810/ACT"   , "narrator": "", "text": "読書は何を読むの？"},
        { "location": "811/TALK"  , "narrator": "赤髪千羽鶴", "text": "地政学や政治思想、\nあと歴史書でしょうか。"},
        { "location": "812/TALK"  , "narrator": "赤髪千羽鶴", "text": "たまに心理学書や\nやさしい哲学書とかも\n読むときがあります。"},
        { "location": "813/TALK"  , "narrator": "赤髪千羽鶴", "text": "時間はたっぷり\nありましたから、いつも\nじっくり読んでました！"},
        { "location": "814/SEL"   , "narrator": "", "text": "疲れない？"},
        { "location": "815/SEL"   , "narrator": "", "text": "$me$と同じだね"},
        { "location": "816/ACT"   , "narrator": "", "text": "疲れない？"},
        { "location": "817/TALK"  , "narrator": "赤髪千羽鶴", "text": "ずっと読んでると\n疲れますね。"},
        { "location": "818/TALK"  , "narrator": "赤髪千羽鶴", "text": "そういう時は気分転換に、\n占いの本とか、\n魔術書を読みます！"},
        { "location": "819/SEL"   , "narrator": "", "text": "何占い？"},
        { "location": "820/SEL"   , "narrator": "", "text": "魔術書！？"},
        { "location": "821/ACT"   , "narrator": "", "text": "何占い？"},
        { "location": "822/TALK"  , "narrator": "赤髪千羽鶴", "text": "数秘術です！"},
        { "location": "823/ACT"   , "narrator": "", "text": "魔術書！？"},
        { "location": "824/TALK"  , "narrator": "赤髪千羽鶴", "text": "あっ、ちょっと\n大げさに言って\nしまいましたね。"},
        { "location": "825/TALK"  , "narrator": "赤髪千羽鶴", "text": "中世ヨーロッパの歴史書の\n中でも、魔術関連に焦点を\n当てたものです。"},
        { "location": "826/TALK"  , "narrator": "赤髪千羽鶴", "text": "ファンタジー読み物として\n読んでたんです。\n大したものではないです。"},
        { "location": "828/ACT"   , "narrator": "", "text": "$me$と同じだね"},
        { "location": "829/TALK"  , "narrator": "赤髪千羽鶴", "text": "ほんとですか！？"},
        { "location": "830/TALK"  , "narrator": "赤髪千羽鶴", "text": "それじゃ今度、\n経験機械問題について\nお話しませんか！"},
        { "location": "831/TALK"  , "narrator": "赤髪千羽鶴", "text": "アレを考えるのが\n大好きなんです！"},
        { "location": "832/TALK"  , "narrator": "赤髪千羽鶴", "text": "……。"},
        { "location": "835/TALK"  , "narrator": "赤髪千羽鶴", "text": "…っと、あまり長々\nお話しても\nよくありませんので。"},
        { "location": "836/TALK"  , "narrator": "赤髪千羽鶴", "text": "先に進みます。\n次は、特技でしょうか。"},
        { "location": "837/TALK"  , "narrator": "赤髪千羽鶴", "text": "特技は、そうですね、\nえっと――"},
        { "location": "838/TALK"  , "narrator": "赤髪千羽鶴", "text": "暗算？\n長文？"},
        { "location": "839/TALK"  , "narrator": "赤髪千羽鶴", "text": "苦手なことは、\n他人に対する気遣い。"},
        { "location": "840/TALK"  , "narrator": "赤髪千羽鶴", "text": "憧れてるのは、\nかわいい子。"},
        { "location": "841/TALK"  , "narrator": "赤髪千羽鶴", "text": "あとは……"},
        { "location": "842/SEL"   , "narrator": "", "text": "将来の夢は？"},
        { "location": "843/SEL"   , "narrator": "", "text": "好きな異性のタイプは？"},
        { "location": "844/SEL"   , "narrator": "", "text": "結婚願望はありますか？"},
        { "location": "845/ACT"   , "narrator": "", "text": "将来の夢は？"},
        { "location": "846/TALK"  , "narrator": "赤髪千羽鶴", "text": "あっ、そうですね！"},
        { "location": "847/TALK"  , "narrator": "赤髪千羽鶴", "text": "将来のビジョンは、\n世界から涙を無くすこと。"},
        { "location": "848/ACT"   , "narrator": "", "text": "好きな異性のタイプは？"},
        { "location": "850/TALK"  , "narrator": "赤髪千羽鶴", "text": "え？\nんー、そうですね……"},
        { "location": "851/TALK"  , "narrator": "赤髪千羽鶴", "text": "異性と言われると\n返答に困りますが、\n対人全般で言うなら――"},
        { "location": "853/TALK"  , "narrator": "赤髪千羽鶴", "text": "過干渉しない人？"},
        { "location": "854/ACT"   , "narrator": "", "text": "結婚願望はありますか？"},
        { "location": "855/TALK"  , "narrator": "赤髪千羽鶴", "text": "ありません。"},
        { "location": "856/SEL"   , "narrator": "", "text": "ラブラブコースなのに全然ラブラブ展開じゃないじゃん！"},
        { "location": "857/SEL"   , "narrator": "", "text": "言い切ったね"},
        { "location": "858/SEL"   , "narrator": "", "text": "$me$と同じだ"},
        { "location": "859/ACT"   , "narrator": "", "text": "ラブラブコースなのに全然ラブラブ展開じゃないじゃん！"},
        { "location": "860/TALK"  , "narrator": "赤髪千羽鶴", "text": "嘘をついてまで\nラブラブしたいんですか？"},
        { "location": "861/TALK"  , "narrator": "赤髪千羽鶴", "text": "都合良くラブラブしたい\nだけなら、恋愛ゲームと\n同じじゃないですか。"},
        { "location": "862/TALK"  , "narrator": "赤髪千羽鶴", "text": "積極的にラブラブしている\nつもりではいますが、\nやはり嘘はつけません。"},
        { "location": "863/TALK"  , "narrator": "赤髪千羽鶴", "text": "それではダメという\nことなら、他を当たって\nいただいた方がよいです。"},
        { "location": "864/ACT"   , "narrator": "", "text": "言い切ったね"},
        { "location": "865/TALK"  , "narrator": "赤髪千羽鶴", "text": "それ以外の回答が\n無いので。"},
        { "location": "866/ACT"   , "narrator": "", "text": "$me$と同じだ"},
        { "location": "867/TALK"  , "narrator": "赤髪千羽鶴", "text": "ふふ。\nお仲間ですね。"},
        { "location": "870/TALK"  , "narrator": "赤髪千羽鶴", "text": "――というわけで、これで\nわたしからの自己紹介を\n終了したいと思います。"},
        { "location": "872/TALK"  , "narrator": "赤髪千羽鶴", "text": "今回、わたしからは\n以上になります。"},
        { "location": "873/TALK"  , "narrator": "赤髪千羽鶴", "text": "それでは、またです。"},
        { "location": "63/DIALOG" , "narrator": "Event/Dialog_EventPicTallNW", "text": "クレーン問題の観測結果"},
