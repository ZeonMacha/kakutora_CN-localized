    "info": {
        "story_id": "18205",
        "cid": "ayami",
        "title": "005 メインストーリー",
        "sub_title": "其は詮索か友愛か＜後編＞"
    },
    "entry":
    [
        { "location": "381/SEL"   , "narrator": "", "text": "$me$も協力しようか？"},
        { "location": "382/SEL"   , "narrator": "", "text": "知ってるところから知っていこう"},
        { "location": "383/ACT"   , "narrator": "", "text": "$me$も協力しようか？"},
        { "location": "384/TALK"  , "narrator": "アーヤ", "text": "ううん"},
        { "location": "385/TALK"  , "narrator": "アーヤ", "text": "やっぱりダメ(￣Д￣ )"},
        { "location": "386/TALK"  , "narrator": "アーヤ", "text": "いくらなんでも"},
        { "location": "387/TALK"  , "narrator": "アーヤ", "text": "倫理的に問題あるし(´o｀；"},
        { "location": "388/TALK"  , "narrator": "アーヤ", "text": "リーダーだからって"},
        { "location": "389/TALK"  , "narrator": "アーヤ", "text": "何やっても許されるわけじゃないし(>_<)"},
        { "location": "392/TALK"  , "narrator": "アーヤ", "text": "もうちょっと"},
        { "location": "393/TALK"  , "narrator": "アーヤ", "text": "考えてみるわ(￣∇￣)"},
        { "location": "405/TALK"  , "narrator": "アーヤ", "text": "…なんて言ったけど、\n考えてどうにかなる\nことじゃないわよね。"},
        { "location": "406/TALK"  , "narrator": "アーヤ", "text": "本人に直接\n聞いてみる？"},
        { "location": "407/TALK"  , "narrator": "アーヤ", "text": "そんなことしても\n教えてくれる\nわけないわよね…。"},
        { "location": "408/TALK"  , "narrator": "アーヤ", "text": "…何か、卯月のことを\n知れるようなもの…。"},
        { "location": "412/TALK"  , "narrator": "アーヤ", "text": "またやってる…。\n意識しなかったけど、\n本当大人気なのね…。"},
        { "location": "413/ACT"   , "narrator": "", "text": "知ってるところから知っていこう"},
        { "location": "414/TALK"  , "narrator": "アーヤ", "text": "そう言われても"},
        { "location": "415/TALK"  , "narrator": "アーヤ", "text": "知らないことの方が多いし(; ;)"},
        { "location": "416/TALK"  , "narrator": "アーヤ", "text": "知ってるところと言われてもね"},
        { "location": "419/TALK"  , "narrator": "アーヤ", "text": "まあ"},
        { "location": "420/TALK"  , "narrator": "アーヤ", "text": "ちょっと考えてみるわ(´o｀；"},
        { "location": "432/TALK"  , "narrator": "アーヤ", "text": "私が卯月のことで\n知ってること、か…。"},
        { "location": "433/TALK"  , "narrator": "アーヤ", "text": "…何も知らない、って\nことはないはず\nなんだけど…。"},
        { "location": "434/TALK"  , "narrator": "アーヤ", "text": "何を知ってるのか、\nって言われても…、\nすぐに出てこないわ。"},
        { "location": "435/TALK"  , "narrator": "アーヤ", "text": "はぁ…やっぱり私、\n何も知らなかったの\nかしら？"},
        { "location": "436/TALK"  , "narrator": "アーヤ", "text": "卯月がメノウ\nだっていうのも\n知らなかったしね…。"},
        { "location": "438/TALK"  , "narrator": "アーヤ", "text": "…………！？"},
        { "location": "439/TALK"  , "narrator": "アーヤ", "text": "そうよ、メノウよ！\nメノウがあったわ！"},
        { "location": "440/TALK"  , "narrator": "アーヤ", "text": "メノウの正体が\n卯月なんだから。"},
        { "location": "441/TALK"  , "narrator": "アーヤ", "text": "メノウを知れば、\n少しは卯月を知る\nことができるかも。"},
        { "location": "442/TALK"  , "narrator": "アーヤ", "text": "そうでなくても、\nきっかけを掴む\n可能性はあるし。"},
        { "location": "444/TALK"  , "narrator": "アーヤ", "text": "…さっきのＣＤ、\n買いに行こう。"},
        { "location": "460/TALK"  , "narrator": "アーヤ", "text": "…メノウの曲かぁ。"},
        { "location": "461/TALK"  , "narrator": "アーヤ", "text": "そういえば、ＣＭで\nサビの部分だけは\nよく聞いてるわ。"},
        { "location": "462/TALK"  , "narrator": "アーヤ", "text": "でも\n通して聞いたことって\nないわね…。"},
        { "location": "463/TALK"  , "narrator": "アーヤ", "text": "…あの卯月が、\nどんな歌を\n歌うのか…。"},
        { "location": "464/TALK"  , "narrator": "アーヤ", "text": "なんだか、ちょっと\n楽しみかも…。"},
        { "location": "465/TALK"  , "narrator": "アーヤ", "text": "あ、あった。\nこれね。"},
        { "location": "466/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "467/TALK"  , "narrator": "アーヤ", "text": "改めて見ても、\nやっぱり卯月には\n見えないわね。"},
        { "location": "469/TALK"  , "narrator": "アーヤ", "text": "同一人物だって\n知ってて見ても\n信じられないわ。"},
        { "location": "470/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "471/TALK"  , "narrator": "アーヤ", "text": "本当に、これを聞いて\n少しは卯月に近づける\nのかしら？"},
        { "location": "472/TALK"  , "narrator": "アーヤ", "text": "メノウって、卯月が\n必死に隠そうとしてた\n姿なのよね。"},
        { "location": "473/TALK"  , "narrator": "アーヤ", "text": "きっと卯月には\n凄く大切で、重要な\n秘密だった…。"},
        { "location": "474/TALK"  , "narrator": "アーヤ", "text": "……秘密には\nあまり触れられたく\nない、わよね……。"},
        { "location": "475/TALK"  , "narrator": "アーヤ", "text": "もしそうだとしたら、\n今このＣＤを聞いても\nいいのかしら？"},
        { "location": "476/TALK"  , "narrator": "アーヤ", "text": "知られたくない一面に\n無理やり飛び込む\nようなものだし…。"},
        { "location": "477/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "479/TALK"  , "narrator": "アーヤ", "text": "むやみに踏み込んで\nいいことじゃない\nわね。"},
        { "location": "480/TALK"  , "narrator": "アーヤ", "text": "…やっぱり、\n別の方法を考えよう。"},
        { "location": "491/DIALOG", "narrator": "Dialog_chapter_ch02", "text": "【15 弾の数だけ抱きしめて】"}
    ]
}
