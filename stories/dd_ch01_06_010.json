{
    "dir": "chap06/daydra/dd_ch01_06_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "6152",
        "cid": "tsubame",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "化粧品"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "化粧品"},
        { "location": "24/TALK"   , "narrator": "つばめ", "text": "…真幌さん、\nまだかなぁ？"},
        { "location": "25/TALK"   , "narrator": "つばめ", "text": "入隊手続きの用紙を\n持ってくるだけの\nはずなのに――"},
        { "location": "26/TALK"   , "narrator": "つばめ", "text": "もう十分も経ってる。\nもしかして、\n見つからないのかな？"},
        { "location": "27/TALK"   , "narrator": "つばめ", "text": "…………。"},
        { "location": "29/TALK"   , "narrator": "つばめ", "text": "っていうかこの部屋、\nどうしてこんなに\n散らかってるの！？"},
        { "location": "30/TALK"   , "narrator": "つばめ", "text": "片づけよう、って\n思う人はいないの\nかなぁ？"},
        { "location": "31/TALK"   , "narrator": "つばめ", "text": "…なんか、ちょっと\nストレス溜まるかも。"},
        { "location": "32/TALK"   , "narrator": "つばめ", "text": "はぁ…雑誌も読んだら\n読みっぱなしだし…。"},
        { "location": "34/TALK"   , "narrator": "つばめ", "text": "ファッション雑誌\nみたいだけど…、\nアーヤさんのかな？"},
        { "location": "35/TALK"   , "narrator": "つばめ", "text": "綺麗な人がいっぱい。\n大人の女の人って\nかっこいいなぁ…。"},
        { "location": "37/TALK"   , "narrator": "つばめ", "text": "…わたしも、いい加減\nお化粧くらいできる\nようになりたいな。"},
        { "location": "49/TALK"   , "narrator": "つばめ", "text": "ねえねえ、相談があるの"},
        { "location": "51/SEL"    , "narrator": "", "text": "なに？"},
        { "location": "52/ACT"    , "narrator": "", "text": "なに？"},
        { "location": "54/TALK"   , "narrator": "つばめ", "text": "お化粧の練習をしたいんだけど"},
        { "location": "55/TALK"   , "narrator": "つばめ", "text": "誰に聞くのがいいと思う？"},
        { "location": "58/TALK"   , "narrator": "つばめ", "text": "やっぱり、アーヤさんがいいかな？"},
        { "location": "59/TALK"   , "narrator": "つばめ", "text": "この本も"},
        { "location": "60/TALK"   , "narrator": "つばめ", "text": "アーヤさんのみたいだし"},
        { "location": "62/SEL"    , "narrator": "", "text": "アーヤに聞こう"},
        { "location": "63/SEL"    , "narrator": "", "text": "真幌に聞こう"},
        { "location": "64/ACT"    , "narrator": "", "text": "アーヤに聞こう"},
        { "location": "65/TALK"   , "narrator": "つばめ", "text": "うん"},
        { "location": "66/TALK"   , "narrator": "つばめ", "text": "それじゃあ、ちょっと聞いてくるね"},
        { "location": "90/TALK"   , "narrator": "アーヤ", "text": "そっか。\n逢瀬さんは化粧した\nことなかったんだ？"},
        { "location": "92/TALK"   , "narrator": "つばめ", "text": "はい。だからアーヤ\nさんに教えてもらえ\nたら嬉しいな、って…。"},
        { "location": "93/TALK"   , "narrator": "アーヤ", "text": "私でよければ\n力になるわ。"},
        { "location": "94/TALK"   , "narrator": "つばめ", "text": "よ、よろしく\nお願いします！"},
        { "location": "95/TALK"   , "narrator": "アーヤ", "text": "でも、私も得意って\nわけじゃないから――"},
        { "location": "96/TALK"   , "narrator": "アーヤ", "text": "プロなのは\n期待しないでね。"},
        { "location": "99/TALK"   , "narrator": "つばめ", "text": "わたしも、あんまり\n凄いのはちょっと…。"},
        { "location": "103/TALK"  , "narrator": "つばめ", "text": "初心者向けので\nお願いしたいんです。"},
        { "location": "105/TALK"  , "narrator": "アーヤ", "text": "だとすると…下地と\nコンシーラ、ファンデー\nションくらいかしら？"},
        { "location": "107/TALK"  , "narrator": "アーヤ", "text": "目は必要ないかな？\nパッチリした\n可愛い目をしてるし。"},
        { "location": "108/TALK"  , "narrator": "つばめ", "text": "そ、そうですか？"},
        { "location": "109/TALK"  , "narrator": "アーヤ", "text": "そうよ。\nちょっと羨ましいわ。"},
        { "location": "112/TALK"  , "narrator": "つばめ", "text": "えへへ…。"},
        { "location": "113/TALK"  , "narrator": "アーヤ", "text": "でも、眉毛は少し\n整えた方がいいかも。"},
        { "location": "115/TALK"  , "narrator": "つばめ", "text": "眉毛って、\n自分で整えたり\nするものなんですか？"},
        { "location": "116/TALK"  , "narrator": "アーヤ", "text": "そりゃそうよ。\n髪の毛と同じで\n伸びるんだから。"},
        { "location": "117/TALK"  , "narrator": "つばめ", "text": "あ、そっか。\n気付きませんでした。"},
        { "location": "118/TALK"  , "narrator": "アーヤ", "text": "ふふっ…\n本当に初心者なのね。"},
        { "location": "119/TALK"  , "narrator": "アーヤ", "text": "それじゃ、最初から\n説明するわね。\nまずは――"},
        { "location": "123/TALK"  , "narrator": "つばめ", "text": "…やっぱり、アーヤさんに\n聞いて正解だったみたい。"},
        { "location": "125/TALK"  , "narrator": "アーヤ", "text": "――っと、\nそういえば……。"},
        { "location": "127/TALK"  , "narrator": "つばめ", "text": "はいっ！"},
        { "location": "128/TALK"  , "narrator": "アーヤ", "text": "館長ってもう\n手続き書類\n持ってきたの？"},
        { "location": "129/TALK"  , "narrator": "つばめ", "text": "あああっ！\nそうでした！！"},
        { "location": "132/TALK"  , "narrator": "つばめ", "text": "すっかり\n忘れてたよ…。"},
        { "location": "133/ACT"   , "narrator": "", "text": "真幌に聞こう"},
        { "location": "135/TALK"  , "narrator": "つばめ", "text": "大人の真幌さんなら、色んなテクニックを知ってそうだね"},
        { "location": "136/TALK"  , "narrator": "つばめ", "text": "真幌さんが戻って来たら"},
        { "location": "137/TALK"  , "narrator": "つばめ", "text": "早速聞いてみる"},
        { "location": "149/TALK"  , "narrator": "真幌", "text": "すまん、待たせたな。\n中々用紙が見つから\nなくて――"},
        { "location": "150/TALK"  , "narrator": "つばめ", "text": "あの、真幌さん。\nちょっと、聞きたい\nことがあって…。"},
        { "location": "152/TALK"  , "narrator": "真幌", "text": "構わんぞ。\n答えられるような\n質問ならばな。"},
        { "location": "153/TALK"  , "narrator": "つばめ", "text": "あの…真幌さんって、\nお化粧得意ですか？"},
        { "location": "154/TALK"  , "narrator": "真幌", "text": "…………は？"},
        { "location": "155/TALK"  , "narrator": "つばめ", "text": "す、すみません…。\nわたし、お化粧って\nやったことなくて…。"},
        { "location": "156/TALK"  , "narrator": "つばめ", "text": "興味はあるんです。\nでも、教わったこと\nないから、その…。"},
        { "location": "157/TALK"  , "narrator": "真幌", "text": "…ふふっ。"},
        { "location": "158/TALK"  , "narrator": "真幌", "text": "あはははは！\n予想外の可愛らしい\n相談だ。"},
        { "location": "159/TALK"  , "narrator": "つばめ", "text": "す、すみません…。"},
        { "location": "160/TALK"  , "narrator": "真幌", "text": "いや、構わん。\nしかし運がいいな。"},
        { "location": "161/TALK"  , "narrator": "真幌", "text": "私は化粧に関しては\nプロフェッショナル\nなんだ。"},
        { "location": "163/TALK"  , "narrator": "つばめ", "text": "本当ですか！？"},
        { "location": "164/TALK"  , "narrator": "真幌", "text": "ああ、本当だ。\n私に全部任せておけ！"},
        { "location": "166/TALK"  , "narrator": "つばめ", "text": "お願いします！"},
        { "location": "168/TALK"  , "narrator": "真幌", "text": "さてと、それじゃ早速\n始めるわけだが…。"},
        { "location": "170/TALK"  , "narrator": "真幌", "text": "どこの国の人間に\nなりたい？"},
        { "location": "171/TALK"  , "narrator": "つばめ", "text": "はい！\n最初はやっぱり…。"},
        { "location": "172/TALK"  , "narrator": "つばめ", "text": "って、あれ？\n今、なんて言いました？"},
        { "location": "173/TALK"  , "narrator": "真幌", "text": "どこの国の人間に\nなりたいかと\n聞いたんだ。"},
        { "location": "174/TALK"  , "narrator": "真幌", "text": "それによって\n肌の色をどうするかが\n決まるだろ？"},
        { "location": "176/TALK"  , "narrator": "つばめ", "text": "そんなことまで\nできちゃうんですか！？"},
        { "location": "177/TALK"  , "narrator": "真幌", "text": "練習次第でな。"},
        { "location": "179/TALK"  , "narrator": "つばめ", "text": "す、凄いです真幌さん！\nやっぱり真幌さんに\n相談して正解でした。"},
        { "location": "180/TALK"  , "narrator": "真幌", "text": "ならその期待に応えて\nお前をハリウッド\n女優の顔にしてやろう。"},
        { "location": "183/TALK"  , "narrator": "つばめ", "text": "…えっ？"},
        { "location": "184/TALK"  , "narrator": "真幌", "text": "心配はいらないぞ！\n時間は掛かるが\n瓜二つにしてみせよう。"},
        { "location": "185/TALK"  , "narrator": "真幌", "text": "さあ、そこへ座れ。\n彫りを深くするために\n頬に陰影をつけて――"},
        { "location": "191/TALK"  , "narrator": "つばめ", "text": "…これ、\n化粧じゃなくて\n特殊メイクなんじゃ？"},
        { "location": "15/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>5月4日　3:45 PM</color>\nドーム戦の翌日、神楽坂トライナリー劇場にて。"}
    ]
}
