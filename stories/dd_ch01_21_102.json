{
    "dir": "chap21/daydra/dd_ch01_21_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "21105",
        "cid": "tsubame",
        "title": "005 メインストーリー",
        "sub_title": "邦画のような一幕＜後編＞"
    },
    "entry":
    [
        { "location": "530/TALK"  , "narrator": "つばめ", "text": "やっぱり"},
        { "location": "531/TALK"  , "narrator": "つばめ", "text": "決めた"},
        { "location": "532/TALK"  , "narrator": "つばめ", "text": "わたし"},
        { "location": "533/TALK"  , "narrator": "つばめ", "text": "ひなこちゃん達見送りに行く(๑･ㅂ･)و☆"},
        { "location": "535/SEL"   , "narrator": "", "text": "じゃあ急いで！"},
        { "location": "536/SEL"   , "narrator": "", "text": "気をつけて行くんだよ"},
        { "location": "537/SEL"   , "narrator": "", "text": "間に合うといいけど"},
        { "location": "538/ACT"   , "narrator": "", "text": "じゃあ急いで！"},
        { "location": "539/TALK"  , "narrator": "つばめ", "text": "ヽ(･ω･ )ゝ☆"},
        { "location": "540/ACT"   , "narrator": "", "text": "気をつけて行くんだよ"},
        { "location": "541/TALK"  , "narrator": "つばめ", "text": "(´ｪ｀；)三(；´ｪ｀)"},
        { "location": "542/ACT"   , "narrator": "", "text": "間に合うといいけど"},
        { "location": "556/TALK"  , "narrator": "つばめ", "text": "…午後の訓練、\n遅刻しちゃうかも\nしれないけど…。"},
        { "location": "557/TALK"  , "narrator": "つばめ", "text": "その時は\nごめんなさい！"},
        { "location": "603/TALK"  , "narrator": "雛", "text": "あーあ、なんか\nあっという間だった\nねー。"},
        { "location": "605/TALK"  , "narrator": "キリト", "text": "本当だな。\nもう数日こっちに\n残りたかったな。"},
        { "location": "606/TALK"  , "narrator": "キリト", "text": "美味いもの食ったり\n遊んだりさあ…。"},
        { "location": "608/TALK"  , "narrator": "ヒカル", "text": "美味しいものなら\n東雲教官に沢山奢って\nもらったでしょ？"},
        { "location": "610/TALK"  , "narrator": "キリト", "text": "全然食い足りねぇよ。"},
        { "location": "611/TALK"  , "narrator": "雛", "text": "あたしもあたしも！\nもっとマグロ食べた\nかった！"},
        { "location": "613/TALK"  , "narrator": "繭", "text": "数日もすれば\n飽きたとか言うに\n決まってる。"},
        { "location": "614/TALK"  , "narrator": "ヒカル", "text": "あはは…でも、\nとっても美味しかった\nですよね？"},
        { "location": "616/TALK"  , "narrator": "繭", "text": "…そうね。"},
        { "location": "618/TALK"  , "narrator": "キリト", "text": "…そういや、そろそろ\n午後の訓練が始まる\n時間じゃねぇか？"},
        { "location": "619/TALK"  , "narrator": "キリト", "text": "今頃逢瀬達、教官に\nめっちゃしごかれて\nいるんだろうなぁ。"},
        { "location": "621/TALK"  , "narrator": "雛", "text": "うん…お別れくらい、\n顔見て言いたかった\nなぁ…。"},
        { "location": "622/TALK"  , "narrator": "繭", "text": "どうせすぐ会えるし。"},
        { "location": "623/TALK"  , "narrator": "雛", "text": "…だよねー。"},
        { "location": "624/TALK"  , "narrator": "雛", "text": "…そんなのは\nわかってる。\n………けど…。"},
        { "location": "625/TALK"  , "narrator": "雛", "text": "やっぱし、ちょっと\n寂しいなぁ…。"},
        { "location": "626/TALK"  , "narrator": "雛", "text": "はぁ…。"},
        { "location": "628/TALK"  , "narrator": "ヒカル", "text": "元気出してください、\nひなこさん。"},
        { "location": "630/TALK"  , "narrator": "キリト", "text": "よっしゃ！　帰りに\n横須賀寄って三笠\n見に行こうぜ！"},
        { "location": "631/TALK"  , "narrator": "キリト", "text": "あれを見れば誰でも\n元気になるからな！"},
        { "location": "633/TALK"  , "narrator": "繭", "text": "おまえだけだ。"},
        { "location": "634/TALK"  , "narrator": "ヒカル", "text": "あはは…。"},
        { "location": "636/TALK"  , "narrator": "ヒカル", "text": "…あれ？"},
        { "location": "643/TALK"  , "narrator": "つばめ", "text": "はぁ、はぁ…。"},
        { "location": "645/TALK"  , "narrator": "ヒカル", "text": "お、逢瀬さん！？"},
        { "location": "646/TALK"  , "narrator": "雛", "text": "つばめちゃん！\nどうしたの、\nそんな走って！？"},
        { "location": "649/TALK"  , "narrator": "つばめ", "text": "よ、よかったぁ…。\n間に合わないかと\n思ったよぉ…。"},
        { "location": "651/TALK"  , "narrator": "繭", "text": "…走ってきたの？\nみやび先輩の家から？"},
        { "location": "652/TALK"  , "narrator": "つばめ", "text": "うん…みんな、\n今日帰っちゃうん\nでしょ？"},
        { "location": "653/TALK"  , "narrator": "つばめ", "text": "だから、その前に\n顔見たくて…。"},
        { "location": "655/TALK"  , "narrator": "キリト", "text": "あ、アホか！？\nおまえもう午後の訓練\n始まる時間だろ！"},
        { "location": "656/TALK"  , "narrator": "キリト", "text": "東雲教官、\nぜってー怒ってるぞ？"},
        { "location": "658/TALK"  , "narrator": "雛", "text": "そうだよ！\n急いで戻った方が…。"},
        { "location": "660/TALK"  , "narrator": "つばめ", "text": "ううん、平気だよ。"},
        { "location": "661/TALK"  , "narrator": "つばめ", "text": "怒られるの、\n覚悟してきてるし。"},
        { "location": "662/TALK"  , "narrator": "繭", "text": "…そういう問題？"},
        { "location": "663/TALK"  , "narrator": "ヒカル", "text": "それは大丈夫とは\n言わないんじゃ…。"},
        { "location": "665/TALK"  , "narrator": "つばめ", "text": "でも、どうしても\n会いたかったの！"},
        { "location": "666/TALK"  , "narrator": "つばめ", "text": "みんなは…わたしに\n初めてできたお友達\nだったから…。"},
        { "location": "667/TALK"  , "narrator": "キリト", "text": "いやいや、大げさだろ\nそれは。"},
        { "location": "669/TALK"  , "narrator": "つばめ", "text": "ううん、本当なの。"},
        { "location": "670/TALK"  , "narrator": "つばめ", "text": "わたし…わたしね…。"},
        { "location": "671/TALK"  , "narrator": "つばめ", "text": "東京に来る前…、\nずっと、独りぼっち\nだったから。"},
        { "location": "673/TALK"  , "narrator": "キリト", "text": "…なに？"},
        { "location": "674/TALK"  , "narrator": "ヒカル", "text": "独りぼっち…ですか？"},
        { "location": "675/TALK"  , "narrator": "繭", "text": "…………。"},
        { "location": "676/TALK"  , "narrator": "雛", "text": "…お友達、\n一人もいなかったの？"},
        { "location": "677/TALK"  , "narrator": "つばめ", "text": "あ、あはは…、\nまあ、ずっと入院してたし\n話しかけるの苦手だから。"},
        { "location": "678/TALK"  , "narrator": "つばめ", "text": "あと、お友達できても\nすぐに引かれちゃうのか、\n疎遠になっちゃったり…。"},
        { "location": "679/TALK"  , "narrator": "雛", "text": "…………。"},
        { "location": "682/TALK"  , "narrator": "つばめ", "text": "だから…ね。\nみんなのことは\nこう思ってるの。"},
        { "location": "683/TALK"  , "narrator": "つばめ", "text": "本当に大切な\nお友達だって。"},
        { "location": "684/TALK"  , "narrator": "つばめ", "text": "…本当だよ？"},
        { "location": "685/TALK"  , "narrator": "繭", "text": "…疑ってないから。"},
        { "location": "686/TALK"  , "narrator": "つばめ", "text": "…うん。"},
        { "location": "687/TALK"  , "narrator": "つばめ", "text": "だからね…。"},
        { "location": "688/TALK"  , "narrator": "つばめ", "text": "みんなのこと\nちゃんと見送りたいな\nって思ったんだ。"},
        { "location": "689/TALK"  , "narrator": "つばめ", "text": "東京戻ったら\nまた会おうね、って\n約束できたら――"},
        { "location": "690/TALK"  , "narrator": "つばめ", "text": "残りの合宿の間も、\n不安にならないで\n頑張れるから…。"},
        { "location": "692/TALK"  , "narrator": "雛", "text": "…つばめちゃん。"},
        { "location": "693/TALK"  , "narrator": "つばめ", "text": "うん？"},
        { "location": "695/TALK"  , "narrator": "雛", "text": "つばめちゃんって…、\nほんと、天然だよね。"},
        { "location": "697/TALK"  , "narrator": "つばめ", "text": "うん…え！？"},
        { "location": "700/TALK"  , "narrator": "雛", "text": "いや、だってさ、\n今更すぎるじゃん。"},
        { "location": "701/TALK"  , "narrator": "雛", "text": "だって\nそんなこと。"},
        { "location": "702/TALK"  , "narrator": "雛", "text": "とーっくの昔に\nわかってること\nなんだから。"},
        { "location": "703/TALK"  , "narrator": "キリト", "text": "だよなぁ…。\nおまえ、マジで\n今更過ぎるだろ？"},
        { "location": "704/TALK"  , "narrator": "ヒカル", "text": "そうだよね。\nさすがにちょっと、\n呆れちゃったよ。"},
        { "location": "706/TALK"  , "narrator": "繭", "text": "…抜けてる。"},
        { "location": "708/TALK"  , "narrator": "つばめ", "text": "そ、そんなぁ…。"},
        { "location": "709/TALK"  , "narrator": "雛", "text": "仕方ないなあ。"},
        { "location": "710/TALK"  , "narrator": "雛", "text": "コホン。\n改めて言うね。"},
        { "location": "712/TALK"  , "narrator": "雛", "text": "あたし達にとって、\nつばめちゃんは\n大切なお友達。"},
        { "location": "714/TALK"  , "narrator": "雛", "text": "今までもそうだし\nこれからもそう。\n特別な友達だよ。"},
        { "location": "715/TALK"  , "narrator": "雛", "text": "…でしょ？\nみんな。"},
        { "location": "716/TALK"  , "narrator": "ヒカル", "text": "ですね。\nもしかして逢瀬さん、\n知りませんでした？"},
        { "location": "718/TALK"  , "narrator": "つばめ", "text": "あ、う…それは…、\nわかってたけど…。"},
        { "location": "719/TALK"  , "narrator": "キリト", "text": "本当かぁ？\nちょっと疑わしいぞ。"},
        { "location": "721/TALK"  , "narrator": "つばめ", "text": "ほ、本当だよ！"},
        { "location": "722/TALK"  , "narrator": "つばめ", "text": "みんな、会った日から\nずっと仲良くして\nくれてるし…。"},
        { "location": "723/TALK"  , "narrator": "雛", "text": "なら、こんなとこに\nいちゃダメでしょ？"},
        { "location": "724/TALK"  , "narrator": "雛", "text": "あたし達を見送った\nせいで怒られたり\nなんかしたら。"},
        { "location": "725/TALK"  , "narrator": "雛", "text": "あたし達\n落ち込んじゃう。"},
        { "location": "726/TALK"  , "narrator": "ヒカル", "text": "そういうことです。\nだから、早く戻って\nください。"},
        { "location": "727/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "728/TALK"  , "narrator": "キリト", "text": "また東京戻ってきたら\n遊びに行こうな。"},
        { "location": "731/TALK"  , "narrator": "つばめ", "text": "…うん！"},
        { "location": "732/TALK"  , "narrator": "繭", "text": "…ほら、行って。\nダッシュで。"},
        { "location": "734/TALK"  , "narrator": "つばめ", "text": "うん…みんなも、\n気を付けて帰ってね。"},
        { "location": "735/TALK"  , "narrator": "つばめ", "text": "あとでＷＡＶＥ\n送るから！"},
        { "location": "742/TALK"  , "narrator": "雛", "text": "楽しみにしてるー！\n訓練頑張ってねー！！"},
        { "location": "746/TALK"  , "narrator": "雛", "text": "…行っちゃったね。"},
        { "location": "748/TALK"  , "narrator": "キリト", "text": "ああ……。\nそれにしても……。"},
        { "location": "749/TALK"  , "narrator": "キリト", "text": "よくもまあ、\nあんなこっ恥ずかしい\nこと言えるもんだ。"},
        { "location": "750/TALK"  , "narrator": "キリト", "text": "聞いてるこっちまで\n恥ずかしくなって\nきちまったぜ。"},
        { "location": "752/TALK"  , "narrator": "ヒカル", "text": "あはは…僕もちょっと\nそう思ったよ。"},
        { "location": "753/TALK"  , "narrator": "ヒカル", "text": "でもさ、その方が\n逢瀬さんらしいよね。"},
        { "location": "755/TALK"  , "narrator": "繭", "text": "天然にプラスして、\n純粋な子だから。"},
        { "location": "757/TALK"  , "narrator": "雛", "text": "……うん…\nそうだよね…。"},
        { "location": "759/TALK"  , "narrator": "雛", "text": "グスッ…。"},
        { "location": "761/TALK"  , "narrator": "キリト", "text": "…ん、ひなこ？"},
        { "location": "763/TALK"  , "narrator": "雛", "text": "うぅ…あー、もー！！"},
        { "location": "764/TALK"  , "narrator": "雛", "text": "本当、つばめちゃんは\n超天然なんだから…！"},
        { "location": "766/TALK"  , "narrator": "キリト", "text": "……ったく、\nどっちがだよ…。"},
        { "location": "768/TALK"  , "narrator": "繭", "text": "…………。"},
        { "location": "769/TALK"  , "narrator": "繭", "text": "またすぐ会える。\nそれに、ＷＡＶＥで\n話せるから。"},
        { "location": "770/TALK"  , "narrator": "雛", "text": "…うん。"},
        { "location": "772/TALK"  , "narrator": "雛", "text": "…よし、行こ！\nもう電車来ちゃうし！"},
        { "location": "773/TALK"  , "narrator": "雛", "text": "急がないと\n乗り遅れちゃう！"},
        { "location": "779/TALK"  , "narrator": "キリト", "text": "あ、待てよひなこ！"},
        { "location": "781/TALK"  , "narrator": "ヒカル", "text": "走らなくても\n間に合いますよー。"},
        { "location": "790/TALK"  , "narrator": "繭", "text": "…………。"},
        { "location": "791/TALK"  , "narrator": "繭", "text": "まったく、寂しがり屋\nなんだから…。"},
        { "location": "804/DIALOG", "narrator": "Dialog_chapter_ch01", "text": "【17 告白】"}
    ]
}
