        "title": "らぶとーく 第02話",
        "sub_title": "すぐにわかることだけど"
    },
    "entry":
    [
        { "location": "121/SCENARIO", "narrator": "", "text": "すぐにわかることだけど"},
        { "location": "130/TALK"    , "narrator": "神楽", "text": "この世界にも\nあるのかな……。"},
        { "location": "132/TALK"    , "narrator": "神楽", "text": "なんて。\nあるに決まってるけど。"},
        { "location": "133/TALK"    , "narrator": "神楽", "text": "やっぱり行かない方が\nいいのかな…。"},
        { "location": "134/SEL"     , "narrator": "", "text": "どこ行くの？"},
        { "location": "135/ACT"     , "narrator": "", "text": "どこ行くの？"},
        { "location": "152/TALK"    , "narrator": "神楽", "text": "いちいち答えないとダメですか？"},
        { "location": "154/SEL"     , "narrator": "", "text": "できれば"},
        { "location": "155/SEL"     , "narrator": "", "text": "いやならいいけど……"},
        { "location": "156/SEL"     , "narrator": "", "text": "神楽のこと知りたいな～"},
        { "location": "157/ACT"     , "narrator": "", "text": "できれば"},
        { "location": "158/TALK"    , "narrator": "神楽", "text": "なるほど"},
        { "location": "160/ACT"     , "narrator": "", "text": "いやならいいけど……"},
        { "location": "161/TALK"    , "narrator": "神楽", "text": "意外と控えめですね"},
        { "location": "163/ACT"     , "narrator": "", "text": "神楽のこと知りたいな～"},
        { "location": "164/TALK"    , "narrator": "神楽", "text": "なんだかずいぶんカワイイ言い方を"},
        { "location": "167/TALK"    , "narrator": "神楽", "text": "そういえば"},
        { "location": "168/TALK"    , "narrator": "神楽", "text": "私はこの世界では2016年のハイティを演じる必要があるんです\n女子高生です"},
        { "location": "169/TALK"    , "narrator": "神楽", "text": "それに付き合ってくれるなら多少の譲歩はするつもりです"},
        { "location": "171/SEL"     , "narrator": "", "text": "はい喜んで！！！"},
        { "location": "172/SEL"     , "narrator": "", "text": "その展開待ってた！"},
        { "location": "173/SEL"     , "narrator": "", "text": "仕方ないから付き合うよ"},
        { "location": "174/ACT"     , "narrator": "", "text": "はい喜んで！！！"},
        { "location": "175/TALK"    , "narrator": "神楽", "text": "じゃあよろしく"},
        { "location": "176/ACT"     , "narrator": "", "text": "その展開待ってた！"},
        { "location": "177/TALK"    , "narrator": "神楽", "text": "随分乗り気ですね"},
        { "location": "178/TALK"    , "narrator": "神楽", "text": "助かりますけど"},
        { "location": "179/ACT"     , "narrator": "", "text": "仕方ないから付き合うよ"},
        { "location": "180/TALK"    , "narrator": "神楽", "text": "まあそういうものですよね"},
        { "location": "181/TALK"    , "narrator": "神楽", "text": "それで構いませんけど"},
        { "location": "193/TALK"    , "narrator": "神楽", "text": "割り切っていこう。"},
        { "location": "194/TALK"    , "narrator": "神楽", "text": "利用できるものは\n利用する。"},
        { "location": "196/TALK"    , "narrator": "神楽", "text": "そうしないといつまでも\n助けられないから…。"},
        { "location": "206/TALK"    , "narrator": "神楽", "text": "音羽の家……。\n見た目は全然\n代わってない…。"},
        { "location": "207/TALK"    , "narrator": "神楽", "text": "あの部屋も元のまま\nなんだろうな…。"},
        { "location": "208/SEL"     , "narrator": "", "text": "ここどこ？"},
        { "location": "209/ACT"     , "narrator": "", "text": "ここどこ？"},
        { "location": "226/TALK"    , "narrator": "神楽", "text": "知り合いの家ぴょん♪"},
        { "location": "235/SEL"     , "narrator": "", "text": "ぴょんこキター！"},
        { "location": "236/SEL"     , "narrator": "", "text": "女子高生…っぽいねそれ…"},
        { "location": "237/SEL"     , "narrator": "", "text": "遊びに来たの？"},
        { "location": "238/ACT"     , "narrator": "", "text": "ぴょんこキター！"},
        { "location": "239/TALK"    , "narrator": "神楽", "text": "ぴょん？"},
        { "location": "240/TALK"    , "narrator": "神楽", "text": "ぴょんこのこと知ってるぴょん？"},
        { "location": "241/TALK"    , "narrator": "神楽", "text": "まあいいぴょん"},
        { "location": "243/ACT"     , "narrator": "", "text": "女子高生…っぽいねそれ…"},
        { "location": "245/TALK"    , "narrator": "神楽", "text": "やっぱりね！！！"},
        { "location": "248/ACT"     , "narrator": "", "text": "遊びに来たの？"},
        { "location": "249/TALK"    , "narrator": "神楽", "text": "そういうわけじゃないぴょん、、、"},
        { "location": "263/TALK"    , "narrator": "神楽", "text": "チャイムを押しても\nもう音羽は……。"},
        { "location": "265/TALK"    , "narrator": "神楽", "text": "ドームライブには\n来ないでって\nあれだけ言ったのに。"},
        { "location": "266/SEL"     , "narrator": "", "text": "じゃあ帰ろうか"},
        { "location": "267/ACT"     , "narrator": "", "text": "じゃあ帰ろうか"},
        { "location": "284/TALK"    , "narrator": "神楽", "text": "なんで"},
        { "location": "286/TALK"    , "narrator": "神楽", "text": "そんなこと言うぴょん？"},
        { "location": "288/SEL"     , "narrator": "", "text": "神楽が辛そうだから"},
        { "location": "289/SEL"     , "narrator": "", "text": "そんなふいんきに見えるから"},
        { "location": "290/SEL"     , "narrator": "", "text": "それが一番いい気がして"},
        { "location": "291/ACT"     , "narrator": "", "text": "神楽が辛そうだから"},
        { "location": "292/TALK"    , "narrator": "神楽", "text": "ぴょんこが？"},
        { "location": "294/ACT"     , "narrator": "", "text": "そんなふいんきに見えるから"},
        { "location": "295/TALK"    , "narrator": "神楽", "text": "ふんいきでしょ"},
        { "location": "296/TALK"    , "narrator": "神楽", "text": "ふんいき！！！"},
        { "location": "298/ACT"     , "narrator": "", "text": "それが一番いい気がして"},
        { "location": "299/TALK"    , "narrator": "神楽", "text": "何か不思議"},
        { "location": "300/TALK"    , "narrator": "神楽", "text": "実はぴょんこもそう思ってた"},
        { "location": "305/TALK"    , "narrator": "神楽", "text": "知りたいですか？"},
        { "location": "306/TALK"    , "narrator": "神楽", "text": "この家の知り合いの話"},
        { "location": "308/SEL"     , "narrator": "", "text": "もちろん"},
        { "location": "309/SEL"     , "narrator": "", "text": "話してもいいなら"},
        { "location": "310/SEL"     , "narrator": "", "text": "無理しないでいいよ"},
        { "location": "311/ACT"     , "narrator": "", "text": "もちろん"},
        { "location": "312/TALK"    , "narrator": "神楽", "text": "そうですか"},
        { "location": "313/ACT"     , "narrator": "", "text": "話してもいいなら"},
        { "location": "314/TALK"    , "narrator": "神楽", "text": "いいかな？"},
        { "location": "315/ACT"     , "narrator": "", "text": "無理しないでいいよ"},
        { "location": "316/TALK"    , "narrator": "神楽", "text": "優しいんですね"},
        { "location": "318/TALK"    , "narrator": "神楽", "text": "その代わりに教えてください"},
        { "location": "319/TALK"    , "narrator": "神楽", "text": "千羽鶴のこと"},
        { "location": "321/SEL"     , "narrator": "", "text": "うーん…"},
        { "location": "322/SEL"     , "narrator": "", "text": "よく知らないんだ"},
        { "location": "323/SEL"     , "narrator": "", "text": "役に立つ情報は持ってない"},
        { "location": "324/ACT"     , "narrator": "", "text": "うーん…"},
        { "location": "325/TALK"    , "narrator": "神楽", "text": "悩むことなんですね"},
        { "location": "326/TALK"    , "narrator": "神楽", "text": "了解ぴょん"},
        { "location": "328/ACT"     , "narrator": "", "text": "よく知らないんだ"},
        { "location": "329/TALK"    , "narrator": "神楽", "text": "それはそうかもしれません"},
        { "location": "330/TALK"    , "narrator": "神楽", "text": "残念ぴょん"},
        { "location": "333/ACT"     , "narrator": "", "text": "役に立つ情報は持ってない"},
        { "location": "334/TALK"    , "narrator": "神楽", "text": "正直な答えですね"},
        { "location": "335/TALK"    , "narrator": "神楽", "text": "がっかりぴょん"},
        { "location": "349/TALK"    , "narrator": "神楽", "text": "$handle$は\n千羽鶴の情報を\n持っていない…。"},
        { "location": "350/TALK"    , "narrator": "神楽", "text": "隠してる可能性は\nあるけど多分\n本当に知らない。"},
        { "location": "351/TALK"    , "narrator": "神楽", "text": "それから……。"},
        { "location": "363/TALK"    , "narrator": "神楽", "text": "$handle$さん"},
        { "location": "364/TALK"    , "narrator": "神楽", "text": "この家は音羽の家"},
        { "location": "365/TALK"    , "narrator": "神楽", "text": "来てみたけどおうちの人と話す勇気が出ないぴょん、、、"},
        { "location": "367/SEL"     , "narrator": "", "text": "そうだよね"},
        { "location": "368/SEL"     , "narrator": "", "text": "今日は帰ろう"},
        { "location": "369/SEL"     , "narrator": "", "text": "話してくれてありがとう"},
        { "location": "370/ACT"     , "narrator": "", "text": "そうだよね"},
        { "location": "371/TALK"    , "narrator": "神楽", "text": "そうなのぴょん"},
        { "location": "372/TALK"    , "narrator": "神楽", "text": "今日はもう帰ることにする、、、"},
        { "location": "374/ACT"     , "narrator": "", "text": "今日は帰ろう"},
        { "location": "375/TALK"    , "narrator": "神楽", "text": "ｿｳﾀﾞﾈ、、、"},
        { "location": "376/TALK"    , "narrator": "神楽", "text": "ありがと、、、"},
        { "location": "378/ACT"     , "narrator": "", "text": "話してくれてありがとう"},
        { "location": "379/TALK"    , "narrator": "神楽", "text": "ううん"},
        { "location": "380/TALK"    , "narrator": "神楽", "text": "約束しましたから"},
        { "location": "394/TALK"    , "narrator": "神楽", "text": "少しは信用しても\nいいのかもしれない…。"},
        { "location": "129/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>某月某日　1:43 PM</color>\nある日、東京都内にて"}
    ]
}
