    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "アニメ第25話"},
        { "location": "48/TALK"   , "narrator": "謎のおねえさん", "text": "こんにちは、\n$handle$さん。"},
        { "location": "50/TALK"   , "narrator": "謎のおねえさん", "text": "前に色々話したから、\n今回はつばめちゃんの\nお話をするだけでもいい？"},
        { "location": "52/TALK"   , "narrator": "謎のおねえさん", "text": "前に色々話したから、\n今回は綾ちゃんの\nお話をするだけでもいい？"},
        { "location": "54/TALK"   , "narrator": "謎のおねえさん", "text": "前に色々話したから、\n今回はガブリエラちゃんの\nお話をするだけでもいい？"},
        { "location": "56/TALK"   , "narrator": "謎のおねえさん", "text": "前に色々話したから、\n今回はみやびちゃんの\nお話をするだけでもいい？"},
        { "location": "58/SEL"    , "narrator": "", "text": "はい"},
        { "location": "59/SEL"    , "narrator": "", "text": "いいえ"},
        { "location": "60/ACT"    , "narrator": "", "text": "はい"},
        { "location": "62/TALK"   , "narrator": "謎のおねえさん", "text": "うん、わかった。"},
        { "location": "64/ACT"    , "narrator": "", "text": "いいえ"},
        { "location": "66/TALK"   , "narrator": "謎のおねえさん", "text": "はーい。\nそれじゃ、少しだけ\n巻き戻しするね？"},
        { "location": "90/TALK"   , "narrator": "千羽鶴", "text": "ごきげんよう。"},
        { "location": "91/TALK"   , "narrator": "千羽鶴", "text": "突然だけど\nアンケートに\n回答して欲しい。"},
        { "location": "92/SEL"    , "narrator": "", "text": "いいよ"},
        { "location": "93/SEL"    , "narrator": "", "text": "ものによるけど"},
        { "location": "94/ACT"    , "narrator": "", "text": "いいよ"},
        { "location": "95/ACT"    , "narrator": "", "text": "ものによるけど"},
        { "location": "97/TALK"   , "narrator": "千羽鶴", "text": "ありがと。\nそれじゃ質問。"},
        { "location": "98/TALK"   , "narrator": "千羽鶴", "text": "私のことは、好き？"},
        { "location": "99/SEL"    , "narrator": "", "text": "好き"},
        { "location": "100/SEL"   , "narrator": "", "text": "嫌い"},
        { "location": "101/SEL"   , "narrator": "", "text": "愛してる"},
        { "location": "102/ACT"   , "narrator": "", "text": "好き"},
        { "location": "105/TALK"  , "narrator": "千羽鶴", "text": "ありがと。"},
        { "location": "106/ACT"   , "narrator": "", "text": "嫌い"},
        { "location": "109/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "110/ACT"   , "narrator": "", "text": "愛してる"},
        { "location": "113/TALK"  , "narrator": "千羽鶴", "text": "それは行きすぎ。"},
        { "location": "114/TALK"  , "narrator": "千羽鶴", "text": "愛しているという言葉は\n全てを受け入れる覚悟が\nあってこその言葉。"},
        { "location": "115/TALK"  , "narrator": "千羽鶴", "text": "自らの人生を賭けようと\n思う時にしか\n使ってはいけない。"},
        { "location": "118/TALK"  , "narrator": "千羽鶴", "text": "でもどうして、\nそんなに私のことを\n好きでいられるの？"},
        { "location": "119/TALK"  , "narrator": "千羽鶴", "text": "前回以降、私は客観的に\n見ても相当酷なことを\n彼女たちに行っている。"},
        { "location": "120/TALK"  , "narrator": "千羽鶴", "text": "貴方が普通の心ある\n人間なら、それを見て\n何か思う事があるはず。"},
        { "location": "121/TALK"  , "narrator": "千羽鶴", "text": "それを受け入れた上での\n理由が知りたい。"},
        { "location": "122/SEL"   , "narrator": "", "text": "考え方に共感してる"},
        { "location": "123/SEL"   , "narrator": "", "text": "かわいいは正義！"},
        { "location": "124/SEL"   , "narrator": "", "text": "酷いことしてる自覚はあるのね"},
        { "location": "125/ACT"   , "narrator": "", "text": "考え方に共感してる"},
        { "location": "127/TALK"  , "narrator": "千羽鶴", "text": "ありがと。\n私にとって一番\n嬉しい回答。"},
        { "location": "128/ACT"   , "narrator": "", "text": "かわいいは正義！"},
        { "location": "130/TALK"  , "narrator": "千羽鶴", "text": "意味が分からない。"},
        { "location": "131/TALK"  , "narrator": "千羽鶴", "text": "でも……もしかすると。"},
        { "location": "132/TALK"  , "narrator": "千羽鶴", "text": "選択肢一行では回答不能な\n深い理由があって、それが\n言えないからこんな事に？"},
        { "location": "133/TALK"  , "narrator": "千羽鶴", "text": "それなら是非SNSを使って\n<color=green>#千羽鶴かわいい</color> タグで\n教えて欲しい。"},
        { "location": "134/TALK"  , "narrator": "千羽鶴", "text": "きっと私にはわからない\n未知の想いが詰まっている\nと思うから楽しみ。"},
        { "location": "135/ACT"   , "narrator": "", "text": "酷いことしてる自覚はあるのね"},
        { "location": "137/TALK"  , "narrator": "千羽鶴", "text": "自覚というか――"},
        { "location": "138/TALK"  , "narrator": "千羽鶴", "text": "客観的に見て意志の自主性\nに介入するのは褒められた\n行為ではないのでしょう？"},
        { "location": "139/TALK"  , "narrator": "千羽鶴", "text": "貴方たちの住んでいる\n世界では、そういう常識が\nあるのでは？"},
        { "location": "140/TALK"  , "narrator": "千羽鶴", "text": "私自身がそれについて\n罪悪感を持っているか否か\nでいえば、それはノー。"},
        { "location": "141/TALK"  , "narrator": "千羽鶴", "text": "必要だからやってる。"},
        { "location": "142/TALK"  , "narrator": "千羽鶴", "text": "けど、貴方から見れば\n酷いことである、という\n感情が芽生えるのも解る。"},
        { "location": "143/TALK"  , "narrator": "千羽鶴", "text": "それは、人間社会の\n一般的な常識になぞらえた\n解として。"},
        { "location": "147/TALK"  , "narrator": "千羽鶴", "text": "それが自然な\n回答だと思う。"},
        { "location": "148/TALK"  , "narrator": "千羽鶴", "text": "私の本意でもないけど、\nもはや消去法でそこは\n断念せざるを得ない。"},
        { "location": "149/TALK"  , "narrator": "千羽鶴", "text": "理想的なのは、私に対し\n最後まで好意を抱いた上で\n共に行動することだった。"},
        { "location": "150/TALK"  , "narrator": "千羽鶴", "text": "けど、前回の行動は、\nそれが瓦解するのを覚悟で\n起こしている。"},
        { "location": "151/TALK"  , "narrator": "千羽鶴", "text": "本当はそれも含めて\n理解して貰いたかったけど\nそれは贅沢というもの。"},
        { "location": "153/TALK"  , "narrator": "千羽鶴", "text": "さて。"},
        { "location": "154/TALK"  , "narrator": "千羽鶴", "text": "今回は、そんな貴方に\n伝えなければならない\nことがある。"},
        { "location": "155/TALK"  , "narrator": "千羽鶴", "text": "私を好きか嫌いか、\nその感情を超越して\n協力し続けてもらう為に。"},
        { "location": "156/TALK"  , "narrator": "千羽鶴", "text": "今貴方の焦点は、私と\nトライナリーたちとの\n関係じゃないかと思う。"},
        { "location": "157/TALK"  , "narrator": "千羽鶴", "text": "すなわち、\n私はトライナリーの\n敵なのか味方なのか。"},
        { "location": "158/TALK"  , "narrator": "千羽鶴", "text": "結論から言えば、私は\n彼女たちを絶対的な敵認定\nすることはない。"},
        { "location": "159/TALK"  , "narrator": "千羽鶴", "text": "もし敵認定しているように\n見えるのであれば、それは\n本質ではない。"},
        { "location": "160/TALK"  , "narrator": "千羽鶴", "text": "彼女たちや貴方にはまだ\n見えていない、本当に敵対\nすべき存在と戦う準備。"},
        { "location": "161/SEL"   , "narrator": "", "text": "見えていない敵？"},
        { "location": "162/ACT"   , "narrator": "", "text": "見えていない敵？"},
        { "location": "164/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "165/TALK"  , "narrator": "千羽鶴", "text": "結論から言えば、私と\n彼女たちが対立関係にある\nように見えるのは――"},
        { "location": "166/TALK"  , "narrator": "千羽鶴", "text": "彼ら\n「まだ見えていない敵」が\n大きく関係している。"},
        { "location": "167/TALK"  , "narrator": "千羽鶴", "text": "得てして「対立」は、\nそういった存在によって\n計画的に創造される。"},
        { "location": "168/TALK"  , "narrator": "千羽鶴", "text": "私たちにとってのそれは、\n私たちの日本の外側にいて\n日本を奪おうとしてる。"},
        { "location": "169/TALK"  , "narrator": "千羽鶴", "text": "私は、彼らからこの日本を\n護るべく行動してるけど、\n彼らにとって私は邪魔。"},
        { "location": "170/TALK"  , "narrator": "千羽鶴", "text": "だから、内部で対立し\n自滅するための様々な\n工作を仕掛けてくる。"},
        { "location": "171/SEL"   , "narrator": "", "text": "それって人間なの？\nそれとも単なる概念？"},
        { "location": "172/ACT"   , "narrator": "", "text": "それって人間なの？\nそれとも単なる概念？"},
        { "location": "174/TALK"  , "narrator": "千羽鶴", "text": "もちろん人間。\n貴方と同じ、生身の。"},
        { "location": "175/TALK"  , "narrator": "千羽鶴", "text": "改造されていたり、\n能力者であったりはしない\nただの人。"},
        { "location": "176/TALK"  , "narrator": "千羽鶴", "text": "私は彼らに育てられ、\nそして作られた。"},
        { "location": "177/TALK"  , "narrator": "千羽鶴", "text": "いわば私にとっての\n親みたいな存在。"},
        { "location": "178/TALK"  , "narrator": "千羽鶴", "text": "そして彼らは、この世界を\n理想的な社会に変貌させる\nことに尽力していた。"},
        { "location": "179/TALK"  , "narrator": "千羽鶴", "text": "私は彼らの思想に共感し\nその教えに忠実でいた\nのだけれど――"},
        { "location": "180/TALK"  , "narrator": "千羽鶴", "text": "世界をこの目で見て、\n客観的な判断を続けるに\nつれて、徐々に理解した。"},
        { "location": "181/TALK"  , "narrator": "千羽鶴", "text": "彼らは決して理想的な\n社会を作ろうとはして\nいないし、作れない。"},
        { "location": "182/TALK"  , "narrator": "千羽鶴", "text": "それに気づいた私は\n彼らに解らないように\n密かに反旗を翻した。"},
        { "location": "183/TALK"  , "narrator": "千羽鶴", "text": "けど、彼らはもうそれに\n気づいてしまったみたい。"},
        { "location": "184/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "185/TALK"  , "narrator": "千羽鶴", "text": "一度に全部を伝えることは\nできない。"},
        { "location": "186/TALK"  , "narrator": "千羽鶴", "text": "それに、私がいくら口で\n伝えても、貴方は実感が\n湧かないと思う。"},
        { "location": "187/TALK"  , "narrator": "千羽鶴", "text": "翻し、私の狂気的な行動は\n実体験として目の当たりに\nしている。"},
        { "location": "189/TALK"  , "narrator": "千羽鶴", "text": "いくら貴方が私の理想に\n共感してくれているとは\nいえ、分が悪すぎる。"},
        { "location": "191/TALK"  , "narrator": "千羽鶴", "text": "嘘かほんとか、未だに私を\n可愛いなんて思ってくれて\nいる貴重な存在の貴方。"},
        { "location": "192/TALK"  , "narrator": "千羽鶴", "text": "その気持ちが崩壊する\n前に、何とかこの事を\n体感してもらいたい。"},
        { "location": "194/TALK"  , "narrator": "千羽鶴", "text": "やむを得ず酷いと思われる\nことをせざるを得ないこの\n状況。"},
        { "location": "195/TALK"  , "narrator": "千羽鶴", "text": "これが続けば、いくら\n貴方が傍観者に徹して\nいてもいずれ離れていく。"},
        { "location": "197/TALK"  , "narrator": "千羽鶴", "text": "嫌われて当然。"},
        { "location": "199/TALK"  , "narrator": "千羽鶴", "text": "だから、\n少し方針を変える。"},
        { "location": "200/TALK"  , "narrator": "千羽鶴", "text": "次回から数回にわたって、\n記録映像含め「彼ら」に\nついて紹介したいと思う。"},
        { "location": "201/TALK"  , "narrator": "千羽鶴", "text": "どのみちフェイズⅢに\n突入するには、まだ少し\n時間がかかる。"},
        { "location": "202/TALK"  , "narrator": "千羽鶴", "text": "それまでに、可能な限り\n私の本当の想いと状況を\n共感してもらいたい。"},
        { "location": "203/TALK"  , "narrator": "千羽鶴", "text": "貴方に本当の\nパートナーに\nなって欲しいから。"},
        { "location": "205/TALK"  , "narrator": "千羽鶴", "text": "貴方が以前してくれた\n１つの回答――"},
        { "location": "206/TALK"  , "narrator": "千羽鶴", "text": "『彼女の為に千羽鶴を\n犠牲にする』という選択を\nしなくて済むように。"},
        { "location": "207/TALK"  , "narrator": "千羽鶴", "text": "そして、もう１つの\n選択もまた、同様に\nしなくて済むように。"},
        { "location": "209/TALK"  , "narrator": "千羽鶴", "text": "貴方が以前してくれた\n１つの回答――"},
        { "location": "210/TALK"  , "narrator": "千羽鶴", "text": "『千羽鶴の為に彼女を\n犠牲にする』という選択を\nしなくて済むように。"},
        { "location": "211/TALK"  , "narrator": "千羽鶴", "text": "そして、もう１つの\n選択もまた、同様に\nしなくて済むように。"},
        { "location": "215/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/75MB 4:57】</color>"},
        { "location": "216/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/24MB 4:57】</color>"},
        { "location": "217/SEL"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "218/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/75MB 4:57】</color>"},
        { "location": "219/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "225/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/24MB 4:57】</color>"},
        { "location": "226/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "232/ACT"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "233/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "266/TALK"  , "narrator": "千羽鶴", "text": "というわけで、今回も\nスリルとサスペンスに\n満ちあふれた回だった。"},
        { "location": "267/TALK"  , "narrator": "千羽鶴", "text": "感想は"},
        { "location": "280/TALK"  , "narrator": "謎のおねえさん", "text": "コーンコン。"},
        { "location": "281/SEL"   , "narrator": "", "text": "！？"},
        { "location": "282/ACT"   , "narrator": "", "text": "！？"},
        { "location": "285/TALK"  , "narrator": "謎のおねえさん", "text": "あっ、よかった～。\nやっと上手くいったよ。"},
        { "location": "287/TALK"  , "narrator": "謎のおねえさん", "text": "こんにちは！\nあなたが、\n$handle$さん？"},
        { "location": "288/SEL"   , "narrator": "", "text": "はい"},
        { "location": "289/SEL"   , "narrator": "", "text": "そうです、$me$が$handle$です（キリッ"},
        { "location": "290/SEL"   , "narrator": "", "text": "違いますよ"},
        { "location": "291/ACT"   , "narrator": "", "text": "はい"},
        { "location": "293/TALK"  , "narrator": "謎のおねえさん", "text": "えへへ、よかった。"},
        { "location": "294/ACT"   , "narrator": "", "text": "そうです、$me$が$handle$です（キリッ"},
        { "location": "295/TALK"  , "narrator": "謎のおねえさん", "text": "うんうん。\nキリッとしてて\nカッコイイね。"},
        { "location": "296/ACT"   , "narrator": "", "text": "違いますよ"},
        { "location": "297/TALK"  , "narrator": "謎のおねえさん", "text": "そうなの？\nそれは困っちゃったな。"},
        { "location": "298/SEL"   , "narrator": "", "text": "冗談ですよ"},
        { "location": "299/ACT"   , "narrator": "", "text": "冗談ですよ"},
        { "location": "301/TALK"  , "narrator": "謎のおねえさん", "text": "あらら。"},
        { "location": "303/TALK"  , "narrator": "謎のおねえさん", "text": "――っと、いけない！\nあんまりのんびりしてる\nヒマは無いんだった！"},
        { "location": "304/TALK"  , "narrator": "謎のおねえさん", "text": "色々お話しはしたいけど、\nまだ急いでやらなくちゃ\nいけないことが山積みで。"},
        { "location": "305/SEL"   , "narrator": "", "text": "千羽鶴は！？"},
        { "location": "306/SEL"   , "narrator": "", "text": "貴方は？"},
        { "location": "307/ACT"   , "narrator": "", "text": "千羽鶴は！？"},
        { "location": "308/TALK"  , "narrator": "謎のおねえさん", "text": "かなり精神状態が\n良くないから、あなたと\n接触できなくしたの。"},
        { "location": "309/SEL"   , "narrator": "", "text": "それじゃ千羽鶴を$me$に逢わせたのは…えっと…名前は…？"},
        { "location": "310/ACT"   , "narrator": "", "text": "それじゃ千羽鶴を$me$に逢わせたのは…えっと…名前は…？"},
        { "location": "312/TALK"  , "narrator": "謎のおねえさん", "text": "あ、わたし？"},
        { "location": "315/TALK"  , "narrator": "謎のおねえさん", "text": "とりあえず今は\n謎のおねえさん、って\nことにしておいて？"},
        { "location": "317/TALK"  , "narrator": "謎のおねえさん", "text": "で、答えをいうと、\nわたしじゃないよ。"},
        { "location": "318/ACT"   , "narrator": "", "text": "貴方は？"},
        { "location": "320/TALK"  , "narrator": "謎のおねえさん", "text": "わたしは…えっと。"},
        { "location": "323/TALK"  , "narrator": "謎のおねえさん", "text": "とりあえず今は\n謎のおねえさん、って\nことにしておいて？"},
        { "location": "324/TALK"  , "narrator": "謎のおねえさん", "text": "落ち着いたらまた\nゆっくり自己紹介\nさせてね？"},
        { "location": "325/SEL"   , "narrator": "", "text": "今は一体どういう状況なの？"},
        { "location": "326/ACT"   , "narrator": "", "text": "今は一体どういう状況なの？"},
        { "location": "328/TALK"  , "narrator": "謎のおねえさん", "text": "あなたに接触していた\n千羽鶴ちゃんなんだけど、\nかなり精神状態が悪くて。"},
        { "location": "329/TALK"  , "narrator": "謎のおねえさん", "text": "色々大変なことを\nし始めちゃったから\n接触できなくしたの。"},
        { "location": "330/SEL"   , "narrator": "", "text": "謎のおねえさんが、千羽鶴と$me$を会わせたの？"},
        { "location": "331/ACT"   , "narrator": "", "text": "謎のおねえさんが、千羽鶴と$me$を会わせたの？"},
        { "location": "333/TALK"  , "narrator": "謎のおねえさん", "text": "ううん、違うよ。"},
        { "location": "335/TALK"  , "narrator": "謎のおねえさん", "text": "あの子が自分でルートを\n見つけて接触を試みた\nみたい。"},
        { "location": "336/TALK"  , "narrator": "謎のおねえさん", "text": "すごいよね！"},
        { "location": "337/TALK"  , "narrator": "謎のおねえさん", "text": "だけど、ちょっと\nやりすぎだったと思う。"},
        { "location": "338/TALK"  , "narrator": "謎のおねえさん", "text": "少なくともわたしには、\n危険な方向に暴走し始めた\nように見えて止めたけど。"},
        { "location": "339/TALK"  , "narrator": "謎のおねえさん", "text": "もしかして、\n邪魔だったかな…？"},
        { "location": "340/SEL"   , "narrator": "", "text": "はい"},
        { "location": "341/SEL"   , "narrator": "", "text": "いいえ"},
        { "location": "342/ACT"   , "narrator": "", "text": "はい"},
        { "location": "343/TALK"  , "narrator": "謎のおねえさん", "text": "そっか。\nごめんね。"},
        { "location": "344/TALK"  , "narrator": "謎のおねえさん", "text": "でもたぶん、あのままだと\nあなたにも彼女たちにも\n迷惑かけちゃうから――"},
        { "location": "345/TALK"  , "narrator": "謎のおねえさん", "text": "ちょっと強引だったけど\n千羽鶴ちゃんは1回休みに\nさせてもらえないかな？"},
        { "location": "346/TALK"  , "narrator": "謎のおねえさん", "text": "その間に、\nわたしも考えてみるね。"},
        { "location": "347/ACT"   , "narrator": "", "text": "いいえ"},
        { "location": "349/TALK"  , "narrator": "謎のおねえさん", "text": "えへへ、よかった！"},
        { "location": "350/TALK"  , "narrator": "謎のおねえさん", "text": "ちょっと強引かなって\n思ってたから、今の言葉\n聞いて安心したよ。"},
        { "location": "351/TALK"  , "narrator": "謎のおねえさん", "text": "今の千羽鶴ちゃんが\nこれ以上頑張ると、逆に\n迷惑かけそうだから――"},
        { "location": "352/TALK"  , "narrator": "謎のおねえさん", "text": "悩んでたけど、思い切って\n千羽鶴ちゃんには外して\nもらうことにしちゃった。"},
        { "location": "354/TALK"  , "narrator": "謎のおねえさん", "text": "今回の記録映像についても\n色々聞きたいこと山積み\nだと思うけど――"},
        { "location": "355/TALK"  , "narrator": "謎のおねえさん", "text": "ていうか、まず\n記録映像が何なのかも\nお話しないとだよね。"},
        { "location": "356/TALK"  , "narrator": "謎のおねえさん", "text": "ちょっと今、すぐには\n手が回らないから、\n次の時でいいかな？"},
        { "location": "357/TALK"  , "narrator": "謎のおねえさん", "text": "ほんとにごめんね？"},
        { "location": "358/TALK"  , "narrator": "謎のおねえさん", "text": "まずは、千羽鶴ちゃんが\n今回用に作ったフォーカス\nを、収束させなくちゃ。"},
        { "location": "359/SEL"   , "narrator": "", "text": "フォーカスって？"},
        { "location": "360/ACT"   , "narrator": "", "text": "フォーカスって？"},
        { "location": "363/TALK"  , "narrator": "謎のおねえさん", "text": "記録映像に至るために\n必要な行動をお膳立てする\nための介入処理、かな？"},
        { "location": "365/TALK"  , "narrator": "謎のおねえさん", "text": "あなた側からだと、\nDAY'S DRAMAとか\nそんな表記になってない？"},
        { "location": "366/SEL"   , "narrator": "", "text": "いつものアレか"},
        { "location": "367/ACT"   , "narrator": "", "text": "いつものアレか"},
        { "location": "369/TALK"  , "narrator": "謎のおねえさん", "text": "そう。"},
        { "location": "370/TALK"  , "narrator": "謎のおねえさん", "text": "TRI-OSの機能としては、\n過去や未来を覗ける\nツールでしかないけど――"},
        { "location": "371/TALK"  , "narrator": "謎のおねえさん", "text": "千羽鶴ちゃんはそれを\n使って可能性軸の補正を\nしていたんだね。"},
        { "location": "372/TALK"  , "narrator": "謎のおねえさん", "text": "それの今回分が既に\nセットされちゃってるから\nわたしが誘導するね。"},
        { "location": "377/TALK"  , "narrator": "謎のおねえさん", "text": "逢瀬つばめちゃんの\n場合だと――"},
        { "location": "379/TALK"  , "narrator": "謎のおねえさん", "text": "ちょっと大変なことに\nなってるね。"},
        { "location": "380/TALK"  , "narrator": "謎のおねえさん", "text": "掃除用具入れに入らずに、\nすぐに脱出するように\n誘導できたら嬉しいかな。"},
        { "location": "381/TALK"  , "narrator": "謎のおねえさん", "text": "記録映像は、\n千羽鶴ちゃんが作りたい\n世界を映し出してる。"},
        { "location": "382/TALK"  , "narrator": "謎のおねえさん", "text": "逆に言えばそこから\n回避する行動をとれば\n未来は変わる。"},
        { "location": "383/TALK"  , "narrator": "謎のおねえさん", "text": "今のままだと彼女は\n絶対捕まっちゃうから、\n何とかしてあげてね？"},
        { "location": "387/TALK"  , "narrator": "謎のおねえさん", "text": "綾ちゃんの場合だと――"},
        { "location": "389/TALK"  , "narrator": "謎のおねえさん", "text": "気持ちがかなり\n焦ってるね。"},
        { "location": "390/TALK"  , "narrator": "謎のおねえさん", "text": "責任感から、危ない橋を\n渡ろうとしてるみたい。\n綾ちゃんらしいなぁ。"},
        { "location": "391/TALK"  , "narrator": "謎のおねえさん", "text": "それを回避しないと、\n綾ちゃんまで捕まっちゃう\nかもしれない。"},
        { "location": "392/TALK"  , "narrator": "謎のおねえさん", "text": "基本的には何もせず\nつばめちゃんを信じて\n待ってもらう感じかな。"},
        { "location": "396/TALK"  , "narrator": "謎のおねえさん", "text": "ガブリエラちゃんの\n場合だと――"},
        { "location": "398/TALK"  , "narrator": "謎のおねえさん", "text": "やっぱり気がせいてる\nみたいだね。"},
        { "location": "399/TALK"  , "narrator": "謎のおねえさん", "text": "こんな時だから、\n落ち着かないのは\n仕方ないけど――"},
        { "location": "400/TALK"  , "narrator": "謎のおねえさん", "text": "焦って行動したら、\n千羽鶴ちゃんの\n思うつぼだから。"},
        { "location": "401/TALK"  , "narrator": "謎のおねえさん", "text": "あなたには、可能な限り\nガブリエラちゃんの心を\n安定させて欲しいかな。"},
        { "location": "405/TALK"  , "narrator": "謎のおねえさん", "text": "みやびちゃんの\n場合だと――"},
        { "location": "407/TALK"  , "narrator": "謎のおねえさん", "text": "表面上は落ち着いて\n行動してるけど、内心\nかなり焦燥感があるね。"},
        { "location": "408/TALK"  , "narrator": "謎のおねえさん", "text": "彼女については、今回は\n他のメンバーほど深刻な\n状況じゃないけど、"},
        { "location": "409/TALK"  , "narrator": "謎のおねえさん", "text": "できる限り\nサポートしてあげて\n欲しいかな？"},
        { "location": "412/TALK"  , "narrator": "謎のおねえさん", "text": "ココロスフィアに入ったら\nわたしが情報を投下する\nから、それに準じてね。"},
        { "location": "413/TALK"  , "narrator": "謎のおねえさん", "text": "いろいろ駆け足過ぎて、\n頭が追いつかないかも\nしれないけど、ごめんね？"},
        { "location": "414/TALK"  , "narrator": "謎のおねえさん", "text": "とにかく今回だけ、\n無事に乗り切れば、次回は\n落ち着けると思うから。"},
        { "location": "415/TALK"  , "narrator": "謎のおねえさん", "text": "そしたら、ちゃんと色々\n事情を説明するね。"},
        { "location": "416/TALK"  , "narrator": "謎のおねえさん", "text": "$handle$さんに\n素敵なココロの旅を。"},
