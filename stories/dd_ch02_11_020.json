{
    "dir": "chap11/daydra/dd_ch02_11_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "11256",
        "cid": "ayami",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "お気に入りのマグカップ"
    },
    "entry":
    [
        { "location": "299/SCENARIO", "narrator": "", "text": "お気に入りのマグカップ"},
        { "location": "322/TALK"    , "narrator": "アーヤ", "text": "あっ…。"},
        { "location": "323/TALK"    , "narrator": "神楽", "text": "どうしましたかな？"},
        { "location": "326/TALK"    , "narrator": "アーヤ", "text": "…私のマグカップ、\nヒビ入っちゃった。"},
        { "location": "328/TALK"    , "narrator": "つばめ", "text": "えっ？　それっていつも\n使ってる、あの白いの\nですか？"},
        { "location": "329/TALK"    , "narrator": "アーヤ", "text": "うん…お湯注いだら、\nパキッて…あっ、ちょっと\nお湯漏れてきてるし…。"},
        { "location": "331/TALK"    , "narrator": "つばめ", "text": "…残念でしたね。\nお気に入りだ、って\n言ってたのに…。"},
        { "location": "332/TALK"    , "narrator": "神楽", "text": "アーヤさん、温かいのは\nいつもそれ使ってまし\nたし…。"},
        { "location": "334/TALK"    , "narrator": "アーヤ", "text": "まあ、ここまで持ったのが\n驚きよ。"},
        { "location": "335/TALK"    , "narrator": "アーヤ", "text": "高校の時に作ったから、\nもう五年くらいになるの\nかしら？"},
        { "location": "337/TALK"    , "narrator": "神楽", "text": "えっ、作った？"},
        { "location": "339/TALK"    , "narrator": "アーヤ", "text": "あら、言ってなかった？"},
        { "location": "341/TALK"    , "narrator": "アーヤ", "text": "このマグカップ、友達が\n美術の時間に作ってくれた\nものなのよ。"},
        { "location": "344/TALK"    , "narrator": "つばめ", "text": "えぇっ！？\n学校で作ったもの\nだったんですか！？"},
        { "location": "345/TALK"    , "narrator": "神楽", "text": "確かに、微妙な歪みや\n凹凸があったりしたのは\n知ってましたけど――"},
        { "location": "346/TALK"    , "narrator": "神楽", "text": "そういうデザインなんだと\n思ってました。"},
        { "location": "347/TALK"    , "narrator": "アーヤ", "text": "手作りだからね。\nまあ、本人はかなり\n悔しがってたけど。"},
        { "location": "348/TALK"    , "narrator": "アーヤ", "text": "時間があれば超綺麗に\n作れたのに、って…。"},
        { "location": "349/TALK"    , "narrator": "つばめ", "text": "…器用なお友達ですね。"},
        { "location": "351/TALK"    , "narrator": "神楽", "text": "っていうか、手作りの\nマグカップをそんな長い間\n使ってたなんて――"},
        { "location": "352/TALK"    , "narrator": "神楽", "text": "物持ち良すぎませんか？"},
        { "location": "354/TALK"    , "narrator": "アーヤ", "text": "それ、友達にも電話で\n言われたわ。"},
        { "location": "355/TALK"    , "narrator": "アーヤ", "text": "いい加減捨てろとか、\n新しいの買えとか…。"},
        { "location": "356/TALK"    , "narrator": "アーヤ", "text": "でも、どうも気に入った\n形のが見つからなくてね。"},
        { "location": "357/TALK"    , "narrator": "神楽", "text": "でも、ヒビが入っちゃった\n以上はわがままも言って\nられませんよ？"},
        { "location": "358/TALK"    , "narrator": "神楽", "text": "毎回紙コップって\nわけにもいきませんし…。"},
        { "location": "359/SEL"     , "narrator": "", "text": "店に買いに行こう"},
        { "location": "360/SEL"     , "narrator": "", "text": "また作ってもらえば？"},
        { "location": "361/SEL"     , "narrator": "", "text": "何だっていいじゃん"},
        { "location": "365/TALK"    , "narrator": "アーヤ", "text": "そうよね…。"},
        { "location": "366/TALK"    , "narrator": "アーヤ", "text": "まさか、接着剤で修理して\n使うわけにもいかないし。"},
        { "location": "367/TALK"    , "narrator": "神楽", "text": "隙間に飲み物が入って、\n色が汚くなっちゃいます\nからね。"},
        { "location": "369/TALK"    , "narrator": "アーヤ", "text": "そうそう、白いのだと\n特に目立って、汚らしく\nなっちゃうのがね…。"},
        { "location": "372/TALK"    , "narrator": "アーヤ", "text": "…今度の休みにでも、\n代わりのマグカップを\n見に行ってみるわ。"},
        { "location": "373/TALK"    , "narrator": "つばめ", "text": "それが良いですよ。"},
        { "location": "374/TALK"    , "narrator": "神楽", "text": "でも、今までと同じ感じの\nマグカップで良いなら――"},
        { "location": "375/TALK"    , "narrator": "神楽", "text": "結構簡単に見つかりそうな\n感じしますけどね。"},
        { "location": "376/TALK"    , "narrator": "つばめ", "text": "柄も色もない、\n真っ白のシンプルな\nマグカップだもんね。"},
        { "location": "378/TALK"    , "narrator": "アーヤ", "text": "…だといいんだけどね。"},
        { "location": "380/TALK"    , "narrator": "アーヤ", "text": "そのシンプルなのが、\n意外と見つからないもの\nなんだけど…。"},
        { "location": "382/ACT"     , "narrator": "", "text": "店に買いに行こう"},
        { "location": "403/TALK"    , "narrator": "アーヤ", "text": "それしかないけど"},
        { "location": "404/TALK"    , "narrator": "アーヤ", "text": "問題は、多分似た形のが売ってない、ってことよ"},
        { "location": "415/TALK"    , "narrator": "アーヤ", "text": "…とはいっても、\n卯月の言う通り紙コップ\nってわけにもいかないし。"},
        { "location": "417/TALK"    , "narrator": "アーヤ", "text": "…買いに行くしか\nなさそうね。"},
        { "location": "418/TALK"    , "narrator": "つばめ", "text": "気が進まない感じですね？"},
        { "location": "421/TALK"    , "narrator": "アーヤ", "text": "マグカップには\nこだわりがあるのよ。"},
        { "location": "422/TALK"    , "narrator": "アーヤ", "text": "けど、中々好みに合うのが\nなくて困ってた時に――"},
        { "location": "423/TALK"    , "narrator": "アーヤ", "text": "友達が作ってくれたのが、\n今まで使ってた物なの。"},
        { "location": "425/TALK"    , "narrator": "アーヤ", "text": "だから、多分簡単には\n見つからないだろうなぁ、\nと思ってね…。"},
        { "location": "426/TALK"    , "narrator": "神楽", "text": "それで、長い間ずっと\n使い続けていたんですね。"},
        { "location": "428/TALK"    , "narrator": "アーヤ", "text": "うん…でもまあ、ここなら\n地元よりお店も多いし――"},
        { "location": "429/TALK"    , "narrator": "アーヤ", "text": "とりあえず、今度の休みに\n見に行ってみるとするわ。"},
        { "location": "431/TALK"    , "narrator": "つばめ", "text": "…見つかると良いですね。"},
        { "location": "433/TALK"    , "narrator": "アーヤ", "text": "ありがと。\n私も見つかるのを\n願ってるわ。"},
        { "location": "434/ACT"     , "narrator": "", "text": "また作ってもらえば？"},
        { "location": "456/TALK"    , "narrator": "アーヤ", "text": "あ、そっか"},
        { "location": "457/TALK"    , "narrator": "アーヤ", "text": "また作ってもらえば間違いないわね"},
        { "location": "459/TALK"    , "narrator": "アーヤ", "text": "ナイスアイデア(*≧∀≦*) "},
        { "location": "471/TALK"    , "narrator": "アーヤ", "text": "ごめん、\nちょっと電話するから。"},
        { "location": "476/TALK"    , "narrator": "アーヤ", "text": "…あ、もしもし？\n久しぶり、ごめんね急に。"},
        { "location": "479/TALK"    , "narrator": "つばめ", "text": "…お友達かな？"},
        { "location": "481/TALK"    , "narrator": "神楽", "text": "みたいですね…。"},
        { "location": "483/TALK"    , "narrator": "アーヤ", "text": "うん、うん…そうそう、\n実はそのことで\n電話したの。"},
        { "location": "484/TALK"    , "narrator": "アーヤ", "text": "あのマグカップだけど、\nとうとうヒビが入っちゃ\nって――"},
        { "location": "485/TALK"    , "narrator": "アーヤ", "text": "それで、また新しいのを\n作ってもらえないかと\n思って、電話したの。"},
        { "location": "490/TALK"    , "narrator": "神楽", "text": "は！？"},
        { "location": "492/TALK"    , "narrator": "つばめ", "text": "また作ってもらうん\nですか！？"},
        { "location": "495/TALK"    , "narrator": "アーヤ", "text": "二人とも、電話中だから。"},
        { "location": "497/TALK"    , "narrator": "神楽", "text": "す、すみません…。"},
        { "location": "499/TALK"    , "narrator": "アーヤ", "text": "…うん、そうそう。\n形と色は前回と同じで…。"},
        { "location": "500/TALK"    , "narrator": "アーヤ", "text": "あはは、覚えてたんだ？\nちょ、耳タコになるほど\n言ってはいないでしょ？"},
        { "location": "504/TALK"    , "narrator": "つばめ", "text": "…ず、随分と仲の良い\nお友達みたいだね。"},
        { "location": "506/TALK"    , "narrator": "神楽", "text": "ですね…けど、さすがに\n無茶なお願いだし、\n断られると思いますけど…。"},
        { "location": "509/TALK"    , "narrator": "アーヤ", "text": "うん…うん、わかった。\nそれじゃ、よろしくね。"},
        { "location": "517/TALK"    , "narrator": "アーヤ", "text": "…ふぅ。"},
        { "location": "521/TALK"    , "narrator": "つばめ", "text": "…やっぱり、断られちゃい\nましたか？"},
        { "location": "523/TALK"    , "narrator": "アーヤ", "text": "ううん、すぐに作って\n送ってくれるって。"},
        { "location": "524/TALK"    , "narrator": "神楽", "text": "すぐって…マグカップって\nそんなすぐに作れるような\n物なんですか？"},
        { "location": "526/TALK"    , "narrator": "アーヤ", "text": "あの子、今は美大生だから\n設備も材料も有り余ってる\nらしくて――"},
        { "location": "527/TALK"    , "narrator": "アーヤ", "text": "前のより綺麗なのを\n作ってみせる、って、\n凄く張り切ってたわ。"},
        { "location": "528/TALK"    , "narrator": "神楽", "text": "そ、そうですか…。\nよかったですね。"},
        { "location": "530/TALK"    , "narrator": "アーヤ", "text": "ええ。\n早く到着しないか、\n今から楽しみだわ。"},
        { "location": "532/TALK"    , "narrator": "神楽", "text": "…アーヤさんに、\nまさかそんなノリのいい\nお友達がいたなんて…。"},
        { "location": "535/TALK"    , "narrator": "つばめ", "text": "うん…ちょっと意外だね。"},
        { "location": "552/ACT"     , "narrator": "", "text": "なんだっていいじゃん"},
        { "location": "582/TALK"    , "narrator": "アーヤ", "text": "いや、よくないから"},
        { "location": "583/TALK"    , "narrator": "アーヤ", "text": "普通こだわりあるでしょ？"},
        { "location": "595/TALK"    , "narrator": "アーヤ", "text": "…二人も、マグカップに\nこだわりってあるでしょ？"},
        { "location": "597/TALK"    , "narrator": "つばめ", "text": "えっ…あまり考えたこと\nなかったです…。"},
        { "location": "598/TALK"    , "narrator": "神楽", "text": "可愛いな、って思った\nデザインのを買うくらい\nです。"},
        { "location": "599/TALK"    , "narrator": "アーヤ", "text": "形や大きさには、\n特にないの？"},
        { "location": "600/TALK"    , "narrator": "つばめ", "text": "えっと…アーヤさんには\nそういうのあるんですか？"},
        { "location": "602/TALK"    , "narrator": "アーヤ", "text": "もちろん。\nまず色は白の無地、\nこれが最低条件ね。"},
        { "location": "603/TALK"    , "narrator": "アーヤ", "text": "形は大きめの円柱形、\n持ち手部分は指が三本\n入ること。"},
        { "location": "604/TALK"    , "narrator": "アーヤ", "text": "…それくらいかしら？"},
        { "location": "606/TALK"    , "narrator": "神楽", "text": "ず、随分と細かく\nこだわってたんですね？"},
        { "location": "608/TALK"    , "narrator": "アーヤ", "text": "よく使うものだからね。\n使ってて気になるのは\n嫌なのよ。"},
        { "location": "609/TALK"    , "narrator": "つばめ", "text": "でも、聞いた限りだと\nそんなに変わった物じゃ\nない感じだから――"},
        { "location": "610/TALK"    , "narrator": "つばめ", "text": "すぐに見つかりそうじゃ\nないですか？"},
        { "location": "613/TALK"    , "narrator": "アーヤ", "text": "そう思うでしょ？\nでも、これが中々\n見つからないのよ。"},
        { "location": "614/TALK"    , "narrator": "アーヤ", "text": "底から上に向かって\n大きくなってたり――"},
        { "location": "615/TALK"    , "narrator": "アーヤ", "text": "持ち手の部分が\n指二本しか\n入らなかったり――"},
        { "location": "616/TALK"    , "narrator": "アーヤ", "text": "模様が入ってたりとか、\nそういうのばっかりで\n全然見つからないのよ。"},
        { "location": "618/TALK"    , "narrator": "つばめ", "text": "…シンプルな物って、\n意外とないんですね？"},
        { "location": "619/TALK"    , "narrator": "神楽", "text": "…私のマグカップも、\n持ち手のところが\n小さいから――"},
        { "location": "621/TALK"    , "narrator": "神楽", "text": "使ってると指が\n痛くなっちゃうん\nですよね…。"},
        { "location": "622/TALK"    , "narrator": "つばめ", "text": "…そういえば、わたしのは\n底に向かってカップが\n細くなるから――"},
        { "location": "624/TALK"    , "narrator": "つばめ", "text": "思ったより飲み物が\n入らないのが、\nちょっと不満かも…。"},
        { "location": "627/TALK"    , "narrator": "アーヤ", "text": "はぁ…今度のお休みに、\nマグカップ見に行かないと\nいけないわね…。"},
        { "location": "631/TALK"    , "narrator": "神楽", "text": "…私達も、\nそうしましょうか？"},
        { "location": "634/TALK"    , "narrator": "つばめ", "text": "うん…でも、わたしに\n合うマグカップって、\nどんな形なのかなぁ？"},
        { "location": "309/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>6月25日　3:10 PM</color>\nとある初夏の休日、神楽坂トライナリーバイト中のこと。"},
        { "location": "546/DIALOG"  , "narrator": "Dialog_GEThimegoto_ch02", "text": "【革新的手工芸】"},
        { "location": "558/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>400pt.</b></color></size>\nアップしました！"}
    ]
}
