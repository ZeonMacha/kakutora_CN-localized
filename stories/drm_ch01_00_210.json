        { "location": "413/TALK"    , "narrator": "つばめ", "text": "ぁたし"},
        { "location": "414/TALK"    , "narrator": "つばめ", "text": "がんばるからね(´ｪ｀；)三(；´ｪ｀)"},
        { "location": "417/SEL"     , "narrator": "", "text": "頑張るってちょっと違うかな"},
