        { "location": "328/SCENARIO", "narrator": "", "text": "たぶん、それは"},
        { "location": "354/TALK"    , "narrator": "つばめ", "text": "ぃろぃろとごめんね"},
        { "location": "356/SEL"     , "narrator": "", "text": "なんで謝るの？"},
        { "location": "357/SEL"     , "narrator": "", "text": "何かあったっけ？"},
        { "location": "358/ACT"     , "narrator": "", "text": "なんで謝るの？"},
