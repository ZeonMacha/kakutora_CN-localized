        { "location": "436/SEL"     , "narrator": "", "text": "ちょっと違うんだ"},
        { "location": "437/SEL"     , "narrator": "", "text": "それはわかってる"},
        { "location": "438/ACT"     , "narrator": "", "text": "一応"},
