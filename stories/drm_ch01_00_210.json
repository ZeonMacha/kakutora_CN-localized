        { "location": "367/TALK"    , "narrator": "つばめ", "text": "なんかわからなくて(´ｪ｀；)三(；´ｪ｀)"},
        { "location": "370/SEL"     , "narrator": "", "text": "なんだ、そのことか"},
        { "location": "371/SEL"     , "narrator": "", "text": "$me$は好きだからそれでいいんだよ"},
        { "location": "373/ACT"     , "narrator": "", "text": "なんだ、そのことか"},
        { "location": "374/TALK"    , "narrator": "つばめ", "text": "あれ(･ｪ･^ )( ^･ｪ･)"},
        { "location": "375/TALK"    , "narrator": "つばめ", "text": "それはそれでさみしぃかも(´・ω・｀)"},
        { "location": "376/ACT"     , "narrator": "", "text": "$me$は好きだからそれでいいんだよ"},
        { "location": "386/TALK"    , "narrator": "つばめ", "text": "そぅなの・・・？"},
        { "location": "387/TALK"    , "narrator": "つばめ", "text": "ぅん"},
        { "location": "388/TALK"    , "narrator": "つばめ", "text": "ょかった(●´ω｀●)ゞｴﾍﾍ"},
        { "location": "390/TALK"    , "narrator": "つばめ", "text": "$handle$さんとこうやってお話しできるのぅれしぃの"},
        { "location": "391/TALK"    , "narrator": "つばめ", "text": "でも"},
        { "location": "392/TALK"    , "narrator": "つばめ", "text": "それって"},
        { "location": "393/TALK"    , "narrator": "つばめ", "text": "仲良しだからっていうのと"},
        { "location": "395/TALK"    , "narrator": "つばめ", "text": "違う気持ちじゃなきゃぃけなぃんだょね"},
        { "location": "397/SEL"     , "narrator": "", "text": "いけないっていうか……"},
        { "location": "398/SEL"     , "narrator": "", "text": "まだ早かったかな……"},
        { "location": "399/SEL"     , "narrator": "", "text": "義務じゃないから"},
        { "location": "400/ACT"     , "narrator": "", "text": "いけないっていうか……"},
        { "location": "401/TALK"    , "narrator": "つばめ", "text": "だから"},
        { "location": "402/TALK"    , "narrator": "つばめ", "text": "ごめんね"},
        { "location": "405/ACT"     , "narrator": "", "text": "まだ早かったかな……"},
        { "location": "406/TALK"    , "narrator": "つばめ", "text": "ぁたしでも"},
        { "location": "407/TALK"    , "narrator": "つばめ", "text": "時間が経てばわかるようになるのかな？"},
        { "location": "408/ACT"     , "narrator": "", "text": "義務じゃないから"},
        { "location": "409/TALK"    , "narrator": "つばめ", "text": "ぅん"},
