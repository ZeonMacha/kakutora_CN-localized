        { "location": "282/SCENARIO", "narrator": "", "text": "150_アイス食べる？"},
        { "location": "307/TALK"    , "narrator": "つばめ", "text": "アイスクリームヾ(o´∀｀o)ﾉ"},
        { "location": "308/TALK"    , "narrator": "つばめ", "text": "アイスクリーム(っ´ω`ｃ)"},
        { "location": "310/SEL"     , "narrator": "", "text": "アイスおいしいよね"},
        { "location": "311/SEL"     , "narrator": "", "text": "アイス食べてるの？"},
        { "location": "312/SEL"     , "narrator": "", "text": "一口ちょうだい"},
        { "location": "313/ACT"     , "narrator": "", "text": "アイスおいしいよね"},
        { "location": "314/TALK"    , "narrator": "つばめ", "text": "ぅん"},
        { "location": "315/TALK"    , "narrator": "つばめ", "text": "だいすき(●´ω｀●)"},
        { "location": "316/ACT"     , "narrator": "", "text": "アイス食べてるの？"},
        { "location": "317/TALK"    , "narrator": "つばめ", "text": "そぅ(*´︶`*)"},
        { "location": "318/TALK"    , "narrator": "つばめ", "text": "ぉいしぃょね☆:*･ﾟ(●´∀｀●):*･ﾟ☆ "},
        { "location": "319/ACT"     , "narrator": "", "text": "一口ちょうだい"},
        { "location": "321/TALK"    , "narrator": "つばめ", "text": "どどどどどどどどぅしょぅ"},
        { "location": "323/TALK"    , "narrator": "つばめ", "text": "ぇぇと"},
        { "location": "324/TALK"    , "narrator": "つばめ", "text": "ぁーん"},
        { "location": "325/TALK"    , "narrator": "つばめ", "text": "どぅo(*･ﾛ･*)o"},
        { "location": "326/TALK"    , "narrator": "つばめ", "text": "ぉぃしい？"},
        { "location": "328/TALK"    , "narrator": "つばめ", "text": "ねぇねぇ"},
        { "location": "329/TALK"    , "narrator": "つばめ", "text": "$handle$さんは何アイスが好き？"},
        { "location": "331/SEL"     , "narrator": "", "text": "甘いものはちょっと"},
        { "location": "332/SEL"     , "narrator": "", "text": "ソーダとか"},
        { "location": "333/SEL"     , "narrator": "", "text": "つばめは何が好きなの？"},
        { "location": "334/ACT"     , "narrator": "", "text": "甘いものはちょっと"},
        { "location": "335/TALK"    , "narrator": "つばめ", "text": "そっかー(´･ω･｀) "},
        { "location": "337/TALK"    , "narrator": "つばめ", "text": "そーゆーひともぃるょね・・・"},
        { "location": "338/ACT"     , "narrator": "", "text": "ソーダとか"},
        { "location": "339/TALK"    , "narrator": "つばめ", "text": "ソーダなんだ(●´ω｀●)"},
        { "location": "340/TALK"    , "narrator": "つばめ", "text": "夏って感じがするね(*´︶`*)"},
        { "location": "341/ACT"     , "narrator": "", "text": "つばめは何が好きなの？"},
        { "location": "351/TALK"    , "narrator": "つばめ", "text": "ぁたしわね"},
        { "location": "352/TALK"    , "narrator": "つばめ", "text": "やっぱりバニラが一番好きヽ(*´∀｀)ノ"},
        { "location": "353/TALK"    , "narrator": "つばめ", "text": "その次わ"},
        { "location": "354/TALK"    , "narrator": "つばめ", "text": "ぃちごかな(*´︶`*)"},
        { "location": "356/TALK"    , "narrator": "つばめ", "text": "静岡ゎね"},
        { "location": "357/TALK"    , "narrator": "つばめ", "text": "変なアイスもあったりするんだょ(･Д･｀)"},
        { "location": "358/TALK"    , "narrator": "つばめ", "text": "昔は抹茶アイスとか珍しかったってお父さんが言ってたし"},
        { "location": "359/TALK"    , "narrator": "つばめ", "text": "あとわさび！"},
        { "location": "362/SEL"     , "narrator": "", "text": "面白そう"},
        { "location": "363/SEL"     , "narrator": "", "text": "ないわー"},
        { "location": "364/SEL"     , "narrator": "", "text": "そういうのもあるんだ"},
        { "location": "365/ACT"     , "narrator": "", "text": "面白そう"},
        { "location": "366/TALK"    , "narrator": "つばめ", "text": "えっ"},
        { "location": "367/TALK"    , "narrator": "つばめ", "text": "そうかな？"},
        { "location": "368/TALK"    , "narrator": "つばめ", "text": "(・ω<) ﾃﾍﾍﾟﾛ"},
        { "location": "369/ACT"     , "narrator": "", "text": "ないわー"},
        { "location": "370/TALK"    , "narrator": "つばめ", "text": "だよね"},
        { "location": "371/TALK"    , "narrator": "つばめ", "text": "なぃよね"},
        { "location": "372/TALK"    , "narrator": "つばめ", "text": "(´つω・｀)ｼｭﾝ"},
        { "location": "375/ACT"     , "narrator": "", "text": "そういうのもあるんだ"},
        { "location": "376/TALK"    , "narrator": "つばめ", "text": "ぅん(･ｪ･^ )( ^･ｪ･)"},
        { "location": "377/TALK"    , "narrator": "つばめ", "text": "わさびも名産だから"},
        { "location": "378/TALK"    , "narrator": "つばめ", "text": "アイスにしたみたぃだよヾ(*´ｴ`*)ﾉ"},
        { "location": "380/TALK"    , "narrator": "つばめ", "text": "そんでね"},
        { "location": "381/TALK"    , "narrator": "つばめ", "text": "変なアイスだから"},
        { "location": "382/TALK"    , "narrator": "つばめ", "text": "ちょっとだけ食べてみたぃって思ったんだけど"},
        { "location": "383/TALK"    , "narrator": "つばめ", "text": "きっと変なアイスだから"},
        { "location": "384/TALK"    , "narrator": "つばめ", "text": "残しちゃうょね"},
        { "location": "386/SEL"     , "narrator": "", "text": "残せばいいよ"},
        { "location": "387/SEL"     , "narrator": "", "text": "悪いことは言わない、やめておけ"},
        { "location": "388/SEL"     , "narrator": "", "text": "残りは$handle$が始末してやる"},
        { "location": "389/ACT"     , "narrator": "", "text": "残せばいいよ"},
        { "location": "390/TALK"    , "narrator": "つばめ", "text": "もったいなくないかな(´ｪ｀；)三(；´ｪ｀)？"},
        { "location": "391/TALK"    , "narrator": "つばめ", "text": "大丈夫かな(´ｪ｀；)三(；´ｪ｀)？"},
        { "location": "392/TALK"    , "narrator": "つばめ", "text": "そぅだ(ﾟ∀ﾟ人)"},
        { "location": "393/TALK"    , "narrator": "つばめ", "text": "今度一緒にチャレンジしてねヾ(*´ｴ`*)ﾉ"},
        { "location": "394/ACT"     , "narrator": "", "text": "悪いことは言わない、やめておけ"},
        { "location": "395/TALK"    , "narrator": "つばめ", "text": "ゃっぱりそう思う(´ｪ｀；)三(；´ｪ｀)？"},
        { "location": "396/TALK"    , "narrator": "つばめ", "text": "でも気になるんだ(´ｪ｀；)三(；´ｪ｀)？"},
        { "location": "397/TALK"    , "narrator": "つばめ", "text": "そぅだ(ﾟ∀ﾟ人)"},
        { "location": "398/TALK"    , "narrator": "つばめ", "text": "今度一緒にチャレンジしょぅよヾ(*´ｴ`*)ﾉ"},
        { "location": "399/ACT"     , "narrator": "", "text": "残りは$handle$が始末してやる"},
