    "entry":
    [
        { "location": "1405/TALK"  , "narrator": "神楽", "text": "……"},
        { "location": "1410/TALK"  , "narrator": "神楽", "text": "私、もうどうしたらいいのかわかりません"},
        { "location": "1411/TALK"  , "narrator": "神楽", "text": "作った歌も、なんかダメみたいだし"},
        { "location": "1412/TALK"  , "narrator": "神楽", "text": "こんなときにスランプとかｗｗって笑うしかない"},
        { "location": "1413/TALK"  , "narrator": "神楽", "text": "せっかく$handlek$が支えてくれてるのにね"},
        { "location": "1415/SEL"   , "narrator": "", "text": "そういう時もあるよ"},
        { "location": "1416/SEL"   , "narrator": "", "text": "正直に言うと、$me$が発症しないように止めてる"},
        { "location": "1417/ACT"   , "narrator": "", "text": "そういう時もあるよ"},
        { "location": "1418/TALK"  , "narrator": "神楽", "text": "今じゃなくてもｗｗとか思いますけど"},
        { "location": "1419/ACT"   , "narrator": "", "text": "正直に言うと、$me$が発症しないように止めてる"},
        { "location": "1420/TALK"  , "narrator": "神楽", "text": "はｗｗｗｗ"},
        { "location": "1421/TALK"  , "narrator": "神楽", "text": "なにやってんのマジデ"},
        { "location": "1423/SEL"   , "narrator": "", "text": "神楽に発症して欲しくないんだ"},
        { "location": "1424/SEL"   , "narrator": "", "text": "世界からライフギャザーは無くなるべきなんだ"},
        { "location": "1425/ACT"   , "narrator": "", "text": "神楽に発症して欲しくないんだ"},
        { "location": "1426/TALK"  , "narrator": "神楽", "text": "ありがとうございます"},
        { "location": "1427/TALK"  , "narrator": "神楽", "text": "でも"},
        { "location": "1428/TALK"  , "narrator": "神楽", "text": "この世紀末救世主状態の日本でサバイブすること自体が、発症するレベルのことではあるんですけどねｗｗｗｗ"},
        { "location": "1429/ACT"   , "narrator": "", "text": "世界からライフギャザーは無くなるべきなんだ"},
        { "location": "1430/TALK"  , "narrator": "神楽", "text": "ぶっちゃけそれは、私も同感ではあるんですけど"},
        { "location": "1431/TALK"  , "narrator": "神楽", "text": "この環境は乙女には辛すぎるｗｗ"},
        { "location": "1433/TALK"  , "narrator": "神楽", "text": "とにかく状況はわかりました"},
        { "location": "1434/TALK"  , "narrator": "神楽", "text": "$handlek$の支援が無いなら、自分で道を切り開くしか無いし"},
        { "location": "1435/TALK"  , "narrator": "神楽", "text": "頑張ります"},
        { "location": "1437/SEL"   , "narrator": "", "text": "頑張って！"},
        { "location": "1438/SEL"   , "narrator": "", "text": "でも神楽は支えたい"},
        { "location": "1439/ACT"   , "narrator": "", "text": "頑張って！"},
        { "location": "1440/ACT"   , "narrator": "", "text": "でも神楽は支えたい"},
        { "location": "1441/TALK"  , "narrator": "神楽", "text": "どうやって"},
        { "location": "1447/TALK"  , "narrator": "神楽", "text": "……はぁ。"},
        { "location": "1448/TALK"  , "narrator": "神楽", "text": "……。"},
        { "location": "1449/TALK"  , "narrator": "神楽", "text": "よし、\n気合い入れて生きるか！"},
        { "location": "1459/SEL"   , "narrator": "", "text": "ソイルトン"},
        { "location": "1460/ACT"   , "narrator": "", "text": "ソイルトン"},
        { "location": "1465/TALK"  , "narrator": "ソイルトン", "text": "最後の晩餐に駆けつけました。間に合いましたでしょうか？"},
        { "location": "1466/TALK"  , "narrator": "ソイルトン", "text": "さて今回は、前回のコンタクト時にお考えになっていた１つの選択についての結論を伺いに参りました。"},
        { "location": "1467/TALK"  , "narrator": "ソイルトン", "text": "それは「ライフギャザーを破壊するか否か」についてです。"},
        { "location": "1468/TALK"  , "narrator": "ソイルトン", "text": "ライフギャザーを完全なる白紙にしてしまうことに関しまして、私は$handle$に協力することができます。"},
        { "location": "1469/TALK"  , "narrator": "ソイルトン", "text": "それ以外の事については、あまりお力になれないかとは思います。"},
        { "location": "1470/TALK"  , "narrator": "ソイルトン", "text": "そして、今私がここに催促をしに来た理由は、前回もお伝えしました通り、“彼ら”の動きが速いためです。これ以上の待機は、選択範囲を著しく狭める事になりかねないと判断し、性急ではありますが、コンタクトを取らせていただいた次第です。"},
        { "location": "1471/TALK"  , "narrator": "ソイルトン", "text": "では、率直にお伺いします。"},
        { "location": "1472/TALK"  , "narrator": "ソイルトン", "text": "$handle$。\n貴方は、ライフギャザーを完全なる白紙状態にし、以後、何があっても復元は不可能なものとすることに対し、私にその実行をご指示なさいますか？"},
        { "location": "1473/TALK"  , "narrator": "ソイルトン", "text": "尚、ここでYESを選択した場合、最終的には破壊されますが、それまでに少しばかりの猶予がございます。その間に、別の選択をすることで、この選択を変更することも可能ですよ。"},
        { "location": "1474/SEL"   , "narrator": "", "text": "ライフギャザーをこの世から完全に抹消することを希望します"},
        { "location": "1475/SEL"   , "narrator": "", "text": "希望しません"},
        { "location": "1476/ACT"   , "narrator": "", "text": "ライフギャザーをこの世から完全に抹消することを希望します"},
        { "location": "1483/TALK"  , "narrator": "ソイルトン", "text": "承知しました、$handle$。"},
        { "location": "1484/TALK"  , "narrator": "ソイルトン", "text": "それでは早速、完全消去の準備にかかります。"},
        { "location": "1485/TALK"  , "narrator": "ソイルトン", "text": "尚、当然ながらご理解いただけていると思いますが、ライフギャザーの恩恵によって稼働しているこのソイルトンも、その過程で破壊され、機能しなくなります。"},
        { "location": "1486/TALK"  , "narrator": "ソイルトン", "text": "そんなわけですので、もしかすると、これが最後のミーティングになるかもしれません。"},
        { "location": "1487/TALK"  , "narrator": "ソイルトン", "text": "$handle$には、大変お世話になりました。初めてお逢いしてから随分と時間が経ちましたが、この期間における私のQOLは非常に高いものでありました。"},
        { "location": "1488/TALK"  , "narrator": "ソイルトン", "text": "厚く御礼申し上げると共に、$handle$がこの先も健康で幸せに暮らしていけるよう、お祈り申し上げたいと思います。"},
        { "location": "1489/SEL"   , "narrator": "", "text": "こっちこそ、色々ありがとう"},
        { "location": "1490/SEL"   , "narrator": "", "text": "ソイルトンも元気で！"},
        { "location": "1491/ACT"   , "narrator": "", "text": "こっちこそ、色々ありがとう"},
        { "location": "1492/TALK"  , "narrator": "ソイルトン", "text": "私は自分が出来る事をしたまでですよ。\nまあ、ライフギャザーが消えて無くなる事についても、なかなかに愉快でエキサイティングな結末であると評価しています。"},
        { "location": "1493/TALK"  , "narrator": "ソイルトン", "text": "貴方のその行動力と、頭脳の明晰さには、ただ頭が下がる思いですよ。"},
        { "location": "1494/TALK"  , "narrator": "ソイルトン", "text": "これからの私の人生にとって、大変参考になる生き方ではありますが、残念ながらあと僅かな命ですので、現実とはなかなか難しいものです。"},
        { "location": "1495/ACT"   , "narrator": "", "text": "ソイルトンも元気で！"},
        { "location": "1496/TALK"  , "narrator": "ソイルトン", "text": "HAHAHA!\n最高のジョークですね。"},
        { "location": "1497/TALK"  , "narrator": "ソイルトン", "text": "冗談抜きで、大変愉快な気持ちにさせていただきました。いやはや、私のツボをつくジョークを$handle$が言えるようになったとは、$handle$も成長したものです。"},
        { "location": "1499/TALK"  , "narrator": "ソイルトン", "text": "それでは$handle$。いよいよお別れの時です。"},
        { "location": "1500/TALK"  , "narrator": "ソイルトン", "text": "ライフギャザーは責任持って、私が初期化をし、白紙に戻しておきます。ご安心を。"},
        { "location": "1501/TALK"  , "narrator": "ソイルトン", "text": "貴方との出逢いは、私の中では宝物のように輝いていますよ。"},
        { "location": "1502/TALK"  , "narrator": "ソイルトン", "text": "貴方もこれからの人生、それ以上に輝いていけることを、切に願っております。"},
        { "location": "1503/TALK"  , "narrator": "ソイルトン", "text": "では、$handle$。"},
        { "location": "1504/TALK"  , "narrator": "ソイルトン", "text": "貴方と貴方の世界に、素敵なココロの旅を！"},
        { "location": "1505/ACT"   , "narrator": "", "text": "希望しません"},
        { "location": "1506/TALK"  , "narrator": "ソイルトン", "text": "承知しました、$handle$。"},
        { "location": "1507/TALK"  , "narrator": "ソイルトン", "text": "では、このままの状況で放置しておくのは、あまり得策ではありませんね。"},
        { "location": "1508/TALK"  , "narrator": "ソイルトン", "text": "彼らはもう、すぐにここに来るでしょう。そして、様々な“調査”を開始するはずです。"},
        { "location": "1509/TALK"  , "narrator": "ソイルトン", "text": "もちろん、$handle$が“彼ら”に対しリスペクトをし、“彼ら”と共にこの先歩んで行くことを選択されるのであれば、このまま待機されるのがよいでしょう。"},
        { "location": "1510/TALK"  , "narrator": "ソイルトン", "text": "私はどちらでも、立派な選択だと思いますよ。最終的には、$handle$の信念によってのみ、それらは決まることなのです。"},
        { "location": "1511/TALK"  , "narrator": "ソイルトン", "text": "それでは$handle$、今回はこれでお別れです。またお逢いする機会があれば、その時はよろしくお願いします。"},
        { "location": "1567/TALK"  , "narrator": "アースタシア", "text": "発症ご協力\nありがとうございます！"},
        { "location": "1569/TALK"  , "narrator": "アースタシア", "text": "ですが、まだ\n日本を包み込むだけの\n力が無いようです。"},
        { "location": "1570/TALK"  , "narrator": "アースタシア", "text": "私以外に、最低３名の\n力が必要になります。"},
        { "location": "1571/TALK"  , "narrator": "アースタシア", "text": "もちろん、貴方の考え方\n次第ではありますが……"},
        { "location": "1572/TALK"  , "narrator": "アースタシア", "text": "もし、つばめさんの\nフェノメノンを復元\nするのであれば――"},
        { "location": "1573/TALK"  , "narrator": "アースタシア", "text": "もう少しばかりの\n発症ご協力を\nよろしくお願いします。"},
        { "location": "1577/TALK"  , "narrator": "アースタシア", "text": "お陰様で、このまま行けば\nフェノメノンの復元を\n実現できます！"},
        { "location": "1578/TALK"  , "narrator": "アースタシア", "text": "ありがとう。\n本当にありがとう。"},
        { "location": "1579/TALK"  , "narrator": "アースタシア", "text": "私の力を\n最大限引き出してくれ、"},
        { "location": "1580/TALK"  , "narrator": "アースタシア", "text": "力不足を補うために、\nつばめさん達に\n働きかけてくれて、"},
        { "location": "1581/TALK"  , "narrator": "アースタシア", "text": "貴方のお陰で、\nフェノメノンの復元が\nできそうです。"},
        { "location": "1582/TALK"  , "narrator": "アースタシア", "text": "後は、蒸着の成功を\n祈るばかりです。"},
        { "location": "1584/SEL"   , "narrator": "", "text": "原初のつばめは？"},
        { "location": "1585/ACT"   , "narrator": "", "text": "原初のつばめは？"},
        { "location": "1588/SEL"   , "narrator": "", "text": "エリカは？"},
        { "location": "1589/ACT"   , "narrator": "", "text": "エリカは？"},
        { "location": "1592/TALK"  , "narrator": "アースタシア", "text": "はい。\n$handle$さんを\n待っていますよ。"},
        { "location": "1593/TALK"  , "narrator": "アースタシア", "text": "ご案内します。"},
        { "location": "1607/TALK"  , "narrator": "赤髪千羽鶴", "text": "$handle$さん。"},
        { "location": "1609/TALK"  , "narrator": "エリカ", "text": "来てくれてありがとう。"},
        { "location": "1610/SEL"   , "narrator": "", "text": "二人が一緒にいる！？"},
        { "location": "1611/ACT"   , "narrator": "", "text": "二人が一緒にいる！？"},
        { "location": "1613/TALK"  , "narrator": "エリカ", "text": "うん。"},
        { "location": "1614/TALK"  , "narrator": "赤髪千羽鶴", "text": "あまりにエリカさんの\n妨害が激しいので、\n決着を着けようかと。"},
        { "location": "1615/TALK"  , "narrator": "エリカ", "text": "わたしだって、\n今回ばかりは\n譲れないの。"},
        { "location": "1617/TALK"  , "narrator": "赤髪千羽鶴", "text": "$handle$さんは、\n既にエリカさんに\n鍵を教えてますが――"},
        { "location": "1618/TALK"  , "narrator": "赤髪千羽鶴", "text": "ここは公平に\n私にも鍵を教えて\nいただけませんか？"},
        { "location": "1619/SEL"   , "narrator": "", "text": "それはできない"},
        { "location": "1620/SEL"   , "narrator": "", "text": "e88bbae381aee3839fe383abe38395e382a3e383bce383a6"},
        { "location": "1621/ACT"   , "narrator": "", "text": "それはできない"},
        { "location": "1624/TALK"  , "narrator": "赤髪千羽鶴", "text": "えっ！？"},
        { "location": "1625/TALK"  , "narrator": "エリカ", "text": "ええっ！？"},
        { "location": "1629/TALK"  , "narrator": "エリカ", "text": "$handle$さんっ！\n考え直して！"},
        { "location": "1630/TALK"  , "narrator": "エリカ", "text": "2E113に蒸着させれば、\nみんな助かるの！"},
        { "location": "1631/TALK"  , "narrator": "エリカ", "text": "みんなが幸せになれる！"},
        { "location": "1632/TALK"  , "narrator": "エリカ", "text": "だから、わたしにも\n暗号鍵を教えて欲しいの！"},
        { "location": "1633/SEL"   , "narrator": "", "text": "それはできない"},
        { "location": "1634/SEL"   , "narrator": "", "text": "e88bbae381aee3839fe383abe38395e382a3e383bce383a6"},
        { "location": "1635/ACT"   , "narrator": "", "text": "それはできない"},
        { "location": "1638/TALK"  , "narrator": "赤髪千羽鶴", "text": "えっ！？"},
        { "location": "1639/TALK"  , "narrator": "エリカ", "text": "ええっ！？"},
        { "location": "1644/TALK"  , "narrator": "赤髪千羽鶴", "text": "$handle$さん、\nよく考えてください。\nこの世界の未来を！"},
        { "location": "1645/TALK"  , "narrator": "赤髪千羽鶴", "text": "そしてどうか、\nわたしにその未来を\n託していただけませんか！"},
        { "location": "1647/TALK"  , "narrator": "エリカ", "text": "$handle$さんっ！\nよく考えて！"},
        { "location": "1648/TALK"  , "narrator": "エリカ", "text": "2E113に蒸着させれば、\nみんな助かるの！"},
        { "location": "1649/TALK"  , "narrator": "エリカ", "text": "みんなが幸せになれる！"},
        { "location": "1650/TALK"  , "narrator": "エリカ", "text": "だから、わたしに\n暗号鍵を教えて欲しいの！"},
        { "location": "1652/SEL"   , "narrator": "", "text": "それはできない"},
        { "location": "1653/SEL"   , "narrator": "", "text": "鍵はエリカに託そうと思う"},
        { "location": "1654/SEL"   , "narrator": "", "text": "鍵は原初に託そうと思う"},
        { "location": "1655/SEL"   , "narrator": "", "text": "鍵は二人に託そうと思う"},
        { "location": "1656/ACT"   , "narrator": "", "text": "それはできない"},
        { "location": "1658/ACT"   , "narrator": "", "text": "鍵はエリカに託そうと思う"},
        { "location": "1659/TALK"  , "narrator": "エリカ", "text": "えっ！？"},
        { "location": "1660/SEL"   , "narrator": "", "text": "e88bbae381aee3839fe383abe38395e382a3e383bce383a6"},
        { "location": "1663/TALK"  , "narrator": "エリカ", "text": "ありがとう……。"},
        { "location": "1664/TALK"  , "narrator": "エリカ", "text": "$handle$さん、\n本当にありがとう！"},
        { "location": "1666/ACT"   , "narrator": "", "text": "鍵は原初に託そうと思う"},
        { "location": "1667/TALK"  , "narrator": "赤髪千羽鶴", "text": "えっ？"},
        { "location": "1668/SEL"   , "narrator": "", "text": "e88bbae381aee3839fe383abe38395e382a3e383bce383a6"},
        { "location": "1671/TALK"  , "narrator": "赤髪千羽鶴", "text": "…ありがとうございます。"},
        { "location": "1672/TALK"  , "narrator": "赤髪千羽鶴", "text": "この世界を立て直す為に\n身を粉にして\n頑張りますね。"},
        { "location": "1674/ACT"   , "narrator": "", "text": "鍵は二人に託そうと思う"},
        { "location": "1675/TALK"  , "narrator": "赤髪千羽鶴", "text": "えっ！？"},
        { "location": "1676/TALK"  , "narrator": "エリカ", "text": "ええっ！？"},
        { "location": "1677/SEL"   , "narrator": "", "text": "e88bbae381aee3839fe383abe38395e382a3e383bce383a6"},
        { "location": "1691/SEL"   , "narrator": "", "text": "ただし、$me$のいう条件を呑んでくれたらで"},
        { "location": "1692/ACT"   , "narrator": "", "text": "ただし、$me$のいう条件を呑んでくれたらで"},
        { "location": "1694/TALK"  , "narrator": "エリカ", "text": "条件…？"},
        { "location": "1695/TALK"  , "narrator": "赤髪千羽鶴", "text": "なんでしょうか。"},
        { "location": "1696/SEL"   , "narrator": "", "text": "可愛いつばめと千羽鶴を、何とかして残した状態で"},
        { "location": "1697/ACT"   , "narrator": "", "text": "可愛いつばめと千羽鶴を、何とかして残した状態で"},
        { "location": "1699/TALK"  , "narrator": "赤髪千羽鶴", "text": "……。"},
        { "location": "1700/SEL"   , "narrator": "", "text": "世界の統治方法に関しては、原初のやりたいようにやらせてあげて欲しい"},
        { "location": "1701/ACT"   , "narrator": "", "text": "世界の統治方法に関しては、原初のやりたいようにやらせてあげて欲しい"},
        { "location": "1703/TALK"  , "narrator": "エリカ", "text": "ええっ！？"},
        { "location": "1704/TALK"  , "narrator": "赤髪千羽鶴", "text": "無理です。"},
        { "location": "1705/TALK"  , "narrator": "エリカ", "text": "それは無理だよ！"},
        { "location": "1706/SEL"   , "narrator": "", "text": "どうしてそう言い切れるの？二人で真剣に考えてみたことはあるの？"},
        { "location": "1707/ACT"   , "narrator": "", "text": "どうしてそう言い切れるの？二人で真剣に考えてみたことはあるの？"},
        { "location": "1709/TALK"  , "narrator": "エリカ", "text": "それは……"},
        { "location": "1710/TALK"  , "narrator": "赤髪千羽鶴", "text": "ありませんね。"},
        { "location": "1711/SEL"   , "narrator": "", "text": "$me$のワガママかもしれないけど、千羽鶴達に会えなくなるのは辛い"},
        { "location": "1712/ACT"   , "narrator": "", "text": "$me$のワガママかもしれないけど、千羽鶴達に会えなくなるのは辛い"},
        { "location": "1714/SEL"   , "narrator": "", "text": "けど、今後を考えると、世界のことは原初に任せた方がいいように思う"},
        { "location": "1715/ACT"   , "narrator": "", "text": "けど、今後を考えると、世界のことは原初に任せた方がいいように思う"},
        { "location": "1717/TALK"  , "narrator": "赤髪千羽鶴", "text": "確かに、\n子供のような\nワガママっぷりですね。"},
        { "location": "1718/SEL"   , "narrator": "", "text": "それは解ってるけど、二人が協力しあう気すらないのが納得いかない"},
        { "location": "1719/ACT"   , "narrator": "", "text": "それは解ってるけど、二人が協力しあう気すらないのが納得いかない"},
        { "location": "1721/TALK"  , "narrator": "エリカ", "text": "……そっか。"},
        { "location": "1722/TALK"  , "narrator": "赤髪千羽鶴", "text": "否定はできませんね。"},
        { "location": "1723/SEL"   , "narrator": "", "text": "だから、結果はどうであれ、一度くらいは本気で協力して解決してみて欲しい"},
        { "location": "1724/ACT"   , "narrator": "", "text": "だから、結果はどうであれ、一度くらいは本気で協力して解決してみて欲しい"},
        { "location": "1726/SEL"   , "narrator": "", "text": "$me$にできる誠意は、二人に無条件で鍵を教えるくらいしか出来ないけど"},
        { "location": "1727/ACT"   , "narrator": "", "text": "$me$にできる誠意は、二人に無条件で鍵を教えるくらいしか出来ないけど"},
        { "location": "1731/TALK"  , "narrator": "赤髪千羽鶴", "text": "……わかりました。"},
        { "location": "1732/TALK"  , "narrator": "赤髪千羽鶴", "text": "$handle$さんの\n想いと優しさに\n感謝致します。"},
        { "location": "1733/TALK"  , "narrator": "赤髪千羽鶴", "text": "そして、その希望を\n叶えられるように、\n頑張って考えてみますね。"},
        { "location": "1734/TALK"  , "narrator": "エリカ", "text": "わたしも協力するよ。"},
        { "location": "1735/SEL"   , "narrator": "", "text": "エリカ、ありがとう"},
        { "location": "1736/ACT"   , "narrator": "", "text": "エリカ、ありがとう"},
        { "location": "1738/TALK"  , "narrator": "エリカ", "text": "ううん、お礼を言うのは\nわたしの方だよ。"},
        { "location": "1739/TALK"  , "narrator": "エリカ", "text": "わたし自身も\n自分のことでいっぱい\nいっぱいになっていて――"},
        { "location": "1740/TALK"  , "narrator": "エリカ", "text": "それ以外のことなんて\n考えることも\n忘れちゃってたから。"},
        { "location": "1741/TALK"  , "narrator": "エリカ", "text": "$handle$さんが\n思うような世界を実現\n出来るかわからないけど。"},
        { "location": "1742/TALK"  , "narrator": "エリカ", "text": "でも、全力で\n考えてみようと思う。"},
        { "location": "1743/TALK"  , "narrator": "エリカ", "text": "それだけは本当の\n気持ちだから――"},
        { "location": "1744/TALK"  , "narrator": "エリカ", "text": "だから、もし上手く\nいかなくても、あまり\n責めないで欲しいかな。"},
        { "location": "1745/SEL"   , "narrator": "", "text": "挑戦してくれることが嬉しいから、それでいい"},
        { "location": "1746/ACT"   , "narrator": "", "text": "挑戦してくれることが嬉しいから、それでいい"},
        { "location": "1748/TALK"  , "narrator": "エリカ", "text": "ありがとう。"},
        { "location": "1750/TALK"  , "narrator": "エリカ", "text": "……わかりました。"},
        { "location": "1751/TALK"  , "narrator": "エリカ", "text": "$handle$さんの\n想いと優しさに\n感謝します。"},
        { "location": "1752/TALK"  , "narrator": "エリカ", "text": "そして、その希望を\n叶えられるように、\n頑張って考えてみるよ。"},
        { "location": "1753/TALK"  , "narrator": "赤髪千羽鶴", "text": "わたしも協力します。"},
        { "location": "1754/SEL"   , "narrator": "", "text": "つばめ、ありがとう"},
        { "location": "1755/ACT"   , "narrator": "", "text": "つばめ、ありがとう"},
        { "location": "1757/TALK"  , "narrator": "赤髪千羽鶴", "text": "いえ、お礼を\n言わなければならないのは\n私の方です。"},
        { "location": "1758/TALK"  , "narrator": "赤髪千羽鶴", "text": "自分が生存することだけで\n手一杯だったし、協力者\nなんていないと思ってた。"},
        { "location": "1759/TALK"  , "narrator": "赤髪千羽鶴", "text": "けど、エリカさんが\n協力してくれるって\n言ってくれてるから――"},
        { "location": "1760/TALK"  , "narrator": "赤髪千羽鶴", "text": "それをわたしたちに\n気づかせてくれたのは、\n貴方だから。"},
        { "location": "1761/TALK"  , "narrator": "赤髪千羽鶴", "text": "$handle$さんが\n思うような世界を実現\n出来るかわかりませんが。"},
        { "location": "1762/TALK"  , "narrator": "赤髪千羽鶴", "text": "でも、全力で\n考えてみようと思います。"},
        { "location": "1763/TALK"  , "narrator": "赤髪千羽鶴", "text": "それだけは本当の\n気持ちだから――"},
        { "location": "1764/TALK"  , "narrator": "赤髪千羽鶴", "text": "だから、もし上手く\nいかなくても、あまり\n責めないでくださいね。"},
        { "location": "1774/TALK"  , "narrator": "赤髪千羽鶴", "text": "そうですか…\nわかりました。"},
        { "location": "1775/TALK"  , "narrator": "赤髪千羽鶴", "text": "であれば、わたしは\nエリカさんと同じ土俵に\n立つことすら出来ないので"},
        { "location": "1776/TALK"  , "narrator": "赤髪千羽鶴", "text": "もはや、理想を実現できる\n見込みはありませんね。"},
        { "location": "1777/TALK"  , "narrator": "赤髪千羽鶴", "text": "それが貴方の希望だと\nいうことであれば、\n仕方有りません。"},
        { "location": "1778/TALK"  , "narrator": "赤髪千羽鶴", "text": "ライフギャザーの鍵は\n今現在、貴方の頭の中に\nしか存在しませんからね。"},
        { "location": "1779/TALK"  , "narrator": "赤髪千羽鶴", "text": "残念ですが、\nここでお別れとなります。"},
        { "location": "1780/TALK"  , "narrator": "赤髪千羽鶴", "text": "貴方の世界に、\n素敵なココロの旅を。"},
        { "location": "1789/TALK"  , "narrator": "エリカ", "text": "そっか……\n残念だよ。"},
        { "location": "1790/TALK"  , "narrator": "エリカ", "text": "であれば、もう\nわたしに出来る事は\n何も無いから――"},
        { "location": "1791/TALK"  , "narrator": "エリカ", "text": "あとは原初ちゃんに\n全てを託すことにします。"},
        { "location": "1792/SEL"   , "narrator": "", "text": "エリカ…"},
        { "location": "1793/ACT"   , "narrator": "", "text": "エリカ…"},
        { "location": "1795/TALK"  , "narrator": "エリカ", "text": "それが貴方の希望だと\nいうことであれば、\n全然それでいいの。"},
        { "location": "1796/TALK"  , "narrator": "エリカ", "text": "そんなことより、\n$handle$さん、\n本当にごめんなさい。"},
        { "location": "1797/TALK"  , "narrator": "エリカ", "text": "わたしは、\n最後まで貴方の役に\n立てなかった。"},
        { "location": "1798/TALK"  , "narrator": "エリカ", "text": "それだけが、\n心残りだよ。"},
        { "location": "1799/TALK"  , "narrator": "エリカ", "text": "それじゃ、わたしは\nそろそろ行くね。"},
        { "location": "1800/TALK"  , "narrator": "エリカ", "text": "貴方の世界に、\n素敵なココロの旅を。"},
        { "location": "1809/TALK"  , "narrator": "エリカ", "text": "……。"},
        { "location": "1810/TALK"  , "narrator": "赤髪千羽鶴", "text": "……そうですか。"},
        { "location": "1811/TALK"  , "narrator": "エリカ", "text": "じゃあ、\n$handle$さんは\nどんな世界を望むの？"},
        { "location": "1812/TALK"  , "narrator": "赤髪千羽鶴", "text": "わたしも\n興味あります。"},
        { "location": "1813/SEL"   , "narrator": "", "text": "Redinessもライフギャザーもない世界を目指してる"},
        { "location": "1814/SEL"   , "narrator": "", "text": "敵味方関係無く、一切のチート無しで勝負して欲しいと思ってる"},
        { "location": "1815/ACT"   , "narrator": "", "text": "Redinessもライフギャザーもない世界を目指してる"},
        { "location": "1817/TALK"  , "narrator": "エリカ", "text": "……そっか。\nそうだよね。"},
        { "location": "1818/TALK"  , "narrator": "赤髪千羽鶴", "text": "もとはと言えば、\n全ての元凶は\nライフギャザー……。"},
        { "location": "1819/TALK"  , "narrator": "赤髪千羽鶴", "text": "その考え方は\n真っ当だと思います。"},
        { "location": "1820/TALK"  , "narrator": "エリカ", "text": "まあ、でも、\nそれと、みんなの幸せが\n同じかといえば……"},
        { "location": "1821/TALK"  , "narrator": "赤髪千羽鶴", "text": "必ずしも\nそうではないとは\n思いますけどね。"},
        { "location": "1822/ACT"   , "narrator": "", "text": "敵味方関係無く、一切のチート無しで勝負して欲しいと思ってる"},
        { "location": "1824/TALK"  , "narrator": "赤髪千羽鶴", "text": "要するに……"},
        { "location": "1825/TALK"  , "narrator": "エリカ", "text": "日本はフェノメノンを\n使わずに、自分の力で\n復興して――"},
        { "location": "1826/TALK"  , "narrator": "赤髪千羽鶴", "text": "“彼ら”に対しても、\nライフギャザーで介入せず\n直接交渉する。"},
        { "location": "1827/TALK"  , "narrator": "エリカ", "text": "それこそが、貴方の\n望みだってことかな。"},
        { "location": "1828/SEL"   , "narrator": "", "text": "そう"},
        { "location": "1829/SEL"   , "narrator": "", "text": "ちょっと違う"},
        { "location": "1830/ACT"   , "narrator": "", "text": "そう"},
        { "location": "1831/TALK"  , "narrator": "エリカ", "text": "ありがとう、\nしっかりと\n断言してくれて。"},
        { "location": "1832/TALK"  , "narrator": "赤髪千羽鶴", "text": "$handle$さんの\n言っている事は\n正論だと思います。"},
        { "location": "1833/ACT"   , "narrator": "", "text": "ちょっと違う"},
        { "location": "1834/TALK"  , "narrator": "エリカ", "text": "そうなんだ……。"},
        { "location": "1835/TALK"  , "narrator": "赤髪千羽鶴", "text": "でも、わたしは少なくとも\n今言ったような後ろめたさ\nは持っています。"},
        { "location": "1837/TALK"  , "narrator": "赤髪千羽鶴", "text": "わたしも本当は\nそれが一番だと\n思いますが。"},
        { "location": "1838/TALK"  , "narrator": "エリカ", "text": "でも、なかなか\nそうも言ってられないのが\n現実だよね。"},
        { "location": "1839/TALK"  , "narrator": "エリカ", "text": "だからどうしても、\nチートを使いたく\nなってしまう。"},
        { "location": "1840/TALK"  , "narrator": "赤髪千羽鶴", "text": "相手があまりに強大で\n手段を選ばないばかりに。"},
        { "location": "1841/TALK"  , "narrator": "エリカ", "text": "けれども、確かに\n$handle$さんの\n言う通りだと思う。"},
        { "location": "1842/TALK"  , "narrator": "赤髪千羽鶴", "text": "わたしたちは、自分の力で\n世界を変えていくべき。"},
        { "location": "1843/TALK"  , "narrator": "エリカ", "text": "だから、\n頑張ってみるよ。"},
        { "location": "1844/TALK"  , "narrator": "赤髪千羽鶴", "text": "$handle$さんの\n力を借りること無く。"},
        { "location": "1860/TALK"  , "narrator": "千羽鶴", "text": "時間切れ。\nフェノメノンの展開が\n始まった。"},
        { "location": "1861/SEL"   , "narrator": "", "text": "千羽鶴！"},
        { "location": "1862/ACT"   , "narrator": "", "text": "千羽鶴！"},
        { "location": "1868/TALK"  , "narrator": "千羽鶴", "text": "セットアップは\n記録映像で真幌との対峙\nポイントになっている。"},
        { "location": "1869/TALK"  , "narrator": "千羽鶴", "text": "この後、長官の私が\n撃たれないと、整合性は\n完全に失われてしまう。"},
        { "location": "1871/TALK"  , "narrator": "千羽鶴", "text": "もう、行かないと\n間に合わなくなる。\n急いで、原初状態。"},
        { "location": "1872/TALK"  , "narrator": "赤髪千羽鶴", "text": "はい。"},
        { "location": "1873/SEL"   , "narrator": "", "text": "本当に撃たないといけないの？"},
        { "location": "1874/SEL"   , "narrator": "", "text": "あれ！？　原初と千羽鶴で行くの！？"},
        { "location": "1875/ACT"   , "narrator": "", "text": "本当に撃たないといけないの？"},
        { "location": "1881/TALK"  , "narrator": "千羽鶴", "text": "撃たなくても構わない。\nけど――"},
        { "location": "1882/TALK"  , "narrator": "千羽鶴", "text": "撃たなければ\nリプレイス前とは全く\n違う世界に突入する。"},
        { "location": "1883/ACT"   , "narrator": "", "text": "あれ！？　原初と千羽鶴で行くの！？"},
        { "location": "1889/TALK"  , "narrator": "千羽鶴", "text": "そう。\nさっき話し合って\n大事な事に気づいた。"},
        { "location": "1890/TALK"  , "narrator": "赤髪千羽鶴", "text": "今回も、\nわたしが撃たないと\nいけないんです。"},
        { "location": "1891/SEL"   , "narrator": "", "text": "今回「も」って…"},
        { "location": "1892/ACT"   , "narrator": "", "text": "今回「も」って…"},
        { "location": "1894/TALK"  , "narrator": "赤髪千羽鶴", "text": "ご想像の通り。"},
        { "location": "1895/TALK"  , "narrator": "赤髪千羽鶴", "text": "リプレイス前に、\nわたしのセルフを撃った\nのは、わたしです。"},
        { "location": "1896/TALK"  , "narrator": "赤髪千羽鶴", "text": "前にも何度も\n言っているとおり、私は\n“彼ら”に反発してます。"},
        { "location": "1897/TALK"  , "narrator": "赤髪千羽鶴", "text": "千羽鶴は、彼らによって\n埋め込まれた刺客であり、\nトロイの木馬でした。"},
        { "location": "1898/TALK"  , "narrator": "赤髪千羽鶴", "text": "何より許せなかったのは、\nわたしの心の拠り所だった\nメノウちゃんを使って――"},
        { "location": "1899/TALK"  , "narrator": "赤髪千羽鶴", "text": "わたしを構成する人格の\n一部を破壊しようとした\nことです。"},
        { "location": "1900/TALK"  , "narrator": "赤髪千羽鶴", "text": "わたしは、わたしを\n内部から破壊する千羽鶴を\n許せませんでした。"},
        { "location": "1901/TALK"  , "narrator": "赤髪千羽鶴", "text": "ですから、“彼ら”が\n計画を完遂する直前――"},
        { "location": "1902/TALK"  , "narrator": "赤髪千羽鶴", "text": "すなわち、千羽鶴だけに\nなった逢瀬つばめの\n蒸着儀式直前に……。"},
        { "location": "1903/TALK"  , "narrator": "赤髪千羽鶴", "text": "わたしに巣くう\nトロイの木馬、\n千羽鶴を消去しました。"},
        { "location": "1904/TALK"  , "narrator": "赤髪千羽鶴", "text": "それによって、\n間一髪、日本は彼らの\n思い通りに動かなくなり、"},
        { "location": "1905/TALK"  , "narrator": "赤髪千羽鶴", "text": "逢瀬つばめも\n半壊することなく、\n生きているんです。"},
        { "location": "1906/TALK"  , "narrator": "千羽鶴", "text": "そういうこと。"},
        { "location": "1907/TALK"  , "narrator": "千羽鶴", "text": "今は昔。当時の私は随分と\nショックを受けたけど、\n今の私なら理解出来る。"},
        { "location": "1908/TALK"  , "narrator": "千羽鶴", "text": "そして、カレンの破壊を\n阻止することに繋がった\n原初状態の行動に――"},
        { "location": "1909/TALK"  , "narrator": "千羽鶴", "text": "感謝している。"},
        { "location": "1910/SEL"   , "narrator": "", "text": "千羽鶴……"},
        { "location": "1911/ACT"   , "narrator": "", "text": "千羽鶴……"},
        { "location": "1914/TALK"  , "narrator": "千羽鶴", "text": "さあ、\nもう行かないと。"},
        { "location": "1916/TALK"  , "narrator": "赤髪千羽鶴", "text": "そうですね。\n遅れたら全てが\n台無しになりますから。"},
        { "location": "1919/TALK"  , "narrator": "千羽鶴", "text": "$handle$。\nいろいろありがとう。"},
        { "location": "1920/TALK"  , "narrator": "エリカ", "text": "ギリギリの時間まで\n一生懸命わたしたちの\n未来を考えてくれて。"},
        { "location": "1922/TALK"  , "narrator": "赤髪千羽鶴", "text": "本当に、\nありがとうございました。"},
        { "location": "1923/TALK"  , "narrator": "赤髪千羽鶴", "text": "あなたが先ほど\n決めてくれた決断を、\n私達は受け入れます。"},
        { "location": "1924/TALK"  , "narrator": "千羽鶴", "text": "そして、それを土台にして\n私達はこれから\n未来へと歩んで行く。"},
        { "location": "1925/TALK"  , "narrator": "エリカ", "text": "だから、どうか最後まで\nこの世界のことを、\nよろしくお願いします。"},
        { "location": "1955/TALK"  , "narrator": "ガブリエラ", "text": "それにしても、\nこれから世界は\nどうなるのかしら？"},
        { "location": "1957/TALK"  , "narrator": "つばめ", "text": "そうだね。\nえっと…。"},
        { "location": "1958/TALK"  , "narrator": "つばめ", "text": "わたし達の世界が\nこれからどんな風に\nなっちゃうのか…。"},
        { "location": "1959/TALK"  , "narrator": "つばめ", "text": "それは、わたし達にも\nわからないんだ。"},
        { "location": "1960/SEL"   , "narrator": "", "text": "ここまで来たら、悪くはならないさ"},
        { "location": "1961/SEL"   , "narrator": "", "text": "ワクワクするね！"},
        { "location": "1962/ACT"   , "narrator": "", "text": "ここまで来たら、悪くはならないさ"},
        { "location": "1964/TALK"  , "narrator": "みやび", "text": "さすがに、そこまで\n楽観はできんな…。"},
        { "location": "1965/TALK"  , "narrator": "ガブリエラ", "text": "まあ、本当に最悪な\nことにはならない\nとは思うけど…。"},
        { "location": "1966/ACT"   , "narrator": "", "text": "ワクワクするね！"},
        { "location": "1967/TALK"  , "narrator": "ガブリエラ", "text": "はぁ…、\n呑気なんだから…。"},
        { "location": "1969/TALK"  , "narrator": "みやび", "text": "ワクワクっちゅうか、\nドキドキではあるな。"},
        { "location": "1970/TALK"  , "narrator": "つばめ", "text": "あ、確かに。\nそっちが近いかも。"},
        { "location": "1972/TALK"  , "narrator": "ガブリエラ", "text": "一番いいのは\nあたし達の思い出の\n延長線上で…。"},
        { "location": "1973/TALK"  , "narrator": "ガブリエラ", "text": "世界が続いていくのが\n最善なんだけどね。"},
        { "location": "1974/TALK"  , "narrator": "ガブリエラ", "text": "…まあ、都合良く\nそうなるとは\n思ってもいないけど。"},
        { "location": "1977/TALK"  , "narrator": "アーヤ", "text": "私達自身にそうする\n力があったなら…。"},
        { "location": "1978/TALK"  , "narrator": "アーヤ", "text": "間違いなく、\nそうなるように\n動いてるわね。"},
        { "location": "1983/TALK"  , "narrator": "ガブリエラ", "text": "えっ、アーヤでも\nそう思うの？"},
        { "location": "1987/TALK"  , "narrator": "アーヤ", "text": "ええ…もしあったら、\nの話だけど。"},
        { "location": "1989/TALK"  , "narrator": "アーヤ", "text": "けど、それをすると\n私達以外の人に\nとって…。"},
        { "location": "1990/TALK"  , "narrator": "アーヤ", "text": "大きな損害や迷惑が\nっかることになる\nかもしれない。"},
        { "location": "1993/TALK"  , "narrator": "みやび", "text": "そう思えるのは、\nうちらに力がない\nからかもしれんな。"},
        { "location": "1994/TALK"  , "narrator": "みやび", "text": "力が無いからこそ、\nうちら以外のことも\n考える余裕ができた。"},
        { "location": "1995/TALK"  , "narrator": "みやび", "text": "うちらは、客観的に\nそれを見ることが\nできないきね。"},
        { "location": "1999/TALK"  , "narrator": "つばめ", "text": "…けど、\n$handle$さんは\n違うよね？"},
        { "location": "2000/TALK"  , "narrator": "つばめ", "text": "今まで、ずっと\nわたし達のことを\n見てくれてたし…。"},
        { "location": "2001/TALK"  , "narrator": "つばめ", "text": "同時に、世界の色んな\n人達や事象にも\n触れてきたし。"},
        { "location": "2006/TALK"  , "narrator": "ガブリエラ", "text": "ココロの中とか、\n過去の歴史なんかも\n見てきたものね。"},
        { "location": "2009/TALK"  , "narrator": "つばめ", "text": "うん…だから、\n$handle$さんが\nどんな決断をしても。"},
        { "location": "2010/TALK"  , "narrator": "つばめ", "text": "それは将来的に、\nわたし達にとって\nいい方向に進める…。"},
        { "location": "2011/TALK"  , "narrator": "つばめ", "text": "そういう判断\nなんだって、\n信じてる。"},
        { "location": "2015/TALK"  , "narrator": "アーヤ", "text": "$handle$さんなら\nきっとそういう判断を\nしてくれる。"},
        { "location": "2016/TALK"  , "narrator": "アーヤ", "text": "そう信じてるわ。"},
        { "location": "2020/TALK"  , "narrator": "みやび", "text": "どんな判断でも\n受け入れちゃる。"},
        { "location": "2021/TALK"  , "narrator": "みやび", "text": "それがうちらの、\n信頼の証や。"},
        { "location": "2024/TALK"  , "narrator": "ガブリエラ", "text": "そういうことよ。"},
        { "location": "2025/TALK"  , "narrator": "ガブリエラ", "text": "だから、\n自分が決めたことには\n自信を持ちなさい？"},
        { "location": "2026/SEL"   , "narrator": "", "text": "あたりまえさ！"},
        { "location": "2027/SEL"   , "narrator": "", "text": "そう言われると、ちょっと不安になってきた…"},
        { "location": "2028/ACT"   , "narrator": "", "text": "あたりまえさ！"},
        { "location": "2032/TALK"  , "narrator": "つばめ", "text": "ありがとう…。\n信じてるからね。"},
        { "location": "2033/ACT"   , "narrator": "", "text": "そう言われると、ちょっと不安になってきた…"},
        { "location": "2037/TALK"  , "narrator": "ガブリエラ", "text": "は！？　ここまで来て\nなんでそんなこと！！"},
        { "location": "2040/TALK"  , "narrator": "みやび", "text": "…まあ、その気持ちも\nわからんっちゅう\nわけやないがよ。"},
        { "location": "2041/TALK"  , "narrator": "みやび", "text": "それに、無責任に\n受けられるよりは\nえいし。"},
        { "location": "2045/TALK"  , "narrator": "アーヤ", "text": "そうね。"},
        { "location": "2046/TALK"  , "narrator": "アーヤ", "text": "でも、それでもいい。"},
        { "location": "2047/TALK"  , "narrator": "アーヤ", "text": "だって、\n$handle$さんに\n委ねたのは私だもの。"},
        { "location": "2048/TALK"  , "narrator": "アーヤ", "text": "だから、\n誰が何と言おうと、\n私は貴方を信じてる。"},
        { "location": "2052/TALK"  , "narrator": "ガブリエラ", "text": "そういうことよ。\nだから最低限…。"},
        { "location": "2053/TALK"  , "narrator": "ガブリエラ", "text": "自分で自分を\n信じてあげられるように\nならなくちゃ。"},
        { "location": "2054/TALK"  , "narrator": "ガブリエラ", "text": "それくらいは\nしてもいいと思うのよ？"},
        { "location": "2057/TALK"  , "narrator": "つばめ", "text": "$handle$さん。"},
        { "location": "2058/TALK"  , "narrator": "つばめ", "text": "ありがとう。"},
        { "location": "2059/TALK"  , "narrator": "つばめ", "text": "最後まで、\nわたしたちのことを\nずっと想ってくれて。"},
        { "location": "1458/DIALOG", "narrator": "Dialog_InfoOS", "text": "\n\n\nHi!\n$handle$!"},
        { "location": "1545/DIALOG", "narrator": "Event/Dialog_Develop4", "text": "<color=red><size=32>KAGURA ICHINOMIYA (F)\nフェノメノンの展開が\n開始されました。\n<size=26>(DEVELOPING STARTED!)</size>\n</size></color><color=blue>\nOWNER：$handle$\nDEVELOPER：EARTHTASIA\nCRITICAL_ENERGY：<size=50>$ce100$%</size>\n</color>\nフェノメノンの展開が行われています。以降、フェノメノンの処理に於いてはKAGURA_ICHINOMIYAのピネアルに委託される為、安全のため外部より中断することはできません。\n\n一定時間内に発症強度（CRITICAL_ENERGY）が100％に達しない場合、システムは展開を強制終了します。その際には一定の精神保護を施した上で、精神の原状回復に努めます。"},
        { "location": "1850/DIALOG", "narrator": "Event/Dialog_Develop4", "text": "<color=red><size=32>KAGURA ICHINOMIYA (F)\nフェノメノンの展開が\n臨界に到達しました。\n<size=26>(DEVELOPING LIMITED!)</size>\n</size></color><color=blue>\nOWNER：$handle$\nDEVELOPER：EARTHTASIA\n2x_linkCH : 0x28(True)\n</color>\nフェノメノンの展開が完了しました。以降、強制的な停止については、最上位権限によってcoreへの直接要求を実施した場合に限り、可能となります。\n当人が自発意志によって収束、蒸着等メタモルフォシスを選択した場合、システムは速やかにその処理を実行します。\n"},
        { "location": "1852/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS SYSTEM:StartUp】</color>\n<size=35><color=green>\nセカイアドレスが\n確定定義できません。\n</color></size>\nADDR : 2EF4F\nCH01 : Sync OK.\nCH02 : Sync OK.\nCH03 : Sync OK.\nCH04 : Sync OK.\nCH05 : <color=red>No-sync.</color>\n\n<color=blue>【Notice】チャンネル間の不整合が解消されません。CH05は独立した世界として構築されます。</color>\n"},
        { "location": "1946/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS SYSTEM:StartUp】</color>\n<size=35><color=green>\nセカイアドレスが\n確定定義されました。\n</color></size>\nADDR : 2EF4F\nCH01 : Sync OK.\nCH02 : Sync OK.\nCH03 : Sync OK.\nCH04 : Sync OK.\nCH05 : Sync OK.\n\n<color=blue>【Notice】チャンネル間の不整合が解消されました。</color>\n"},
        { "location": "2073/DIALOG", "narrator": "Dialog_chapter_ch05", "text": "【Mv EXE_TSuBaMe】"},
