    "entry":
    [
        { "location": "206/SCENARIO", "narrator": "", "text": "05-05_事象と現象"},
        { "location": "231/TALK"    , "narrator": "アーヤ", "text": "男所帯って言い方はあるけど"},
        { "location": "232/TALK"    , "narrator": "アーヤ", "text": "女所帯って言わないわね"},
        { "location": "235/SEL"     , "narrator": "", "text": "せやな"},
        { "location": "236/SEL"     , "narrator": "", "text": "作ればいい"},
        { "location": "237/SEL"     , "narrator": "", "text": "社会学的な問題提起だね"},
        { "location": "238/ACT"     , "narrator": "", "text": "せやな"},
        { "location": "239/TALK"    , "narrator": "アーヤ", "text": "あら"},
        { "location": "240/TALK"    , "narrator": "アーヤ", "text": "興味ないみたい"},
        { "location": "241/ACT"     , "narrator": "", "text": "作ればいい"},
        { "location": "242/TALK"    , "narrator": "アーヤ", "text": "トライナリーって"},
        { "location": "244/TALK"    , "narrator": "アーヤ", "text": "女所帯だわよ？"},
        { "location": "245/ACT"     , "narrator": "", "text": "社会学的な問題提起だね"},
        { "location": "247/TALK"    , "narrator": "アーヤ", "text": "そうね"},
        { "location": "248/TALK"    , "narrator": "アーヤ", "text": "所帯を持つのは男性っていう前提があるから"},
        { "location": "249/TALK"    , "narrator": "アーヤ", "text": "そういう言い方になるのよね"},
        { "location": "250/TALK"    , "narrator": "アーヤ", "text": "なんて"},
        { "location": "251/TALK"    , "narrator": "アーヤ", "text": "こんな話ができるとは思ってなかったわ"},
        { "location": "253/TALK"    , "narrator": "アーヤ", "text": "ちょっと嬉しい"},
        { "location": "255/TALK"    , "narrator": "アーヤ", "text": "まあ現実問題として"},
        { "location": "256/TALK"    , "narrator": "アーヤ", "text": "トライナリーは女子ばっかりだから"},
        { "location": "257/TALK"    , "narrator": "アーヤ", "text": "女所帯って言っていいと思うの"},
        { "location": "258/TALK"    , "narrator": "アーヤ", "text": "だからって"},
        { "location": "260/TALK"    , "narrator": "アーヤ", "text": "何が変わるってわけじゃないんだけどね"}
    ]
}
