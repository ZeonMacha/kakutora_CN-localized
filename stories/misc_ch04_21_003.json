    "entry":
    [
        { "location": "192/SCENARIO", "narrator": "", "text": "033_根拠という不確定要素"},
        { "location": "219/TALK"    , "narrator": "みやび", "text": "ソースを出せ"},
        { "location": "220/TALK"    , "narrator": "みやび", "text": "と"},
        { "location": "221/TALK"    , "narrator": "みやび", "text": "いうではないか"},
        { "location": "223/SEL"     , "narrator": "", "text": "情報源のことだね"},
        { "location": "224/SEL"     , "narrator": "", "text": "目玉焼きは醤油派"},
        { "location": "225/ACT"     , "narrator": "", "text": "情報源のことだね"},
        { "location": "226/TALK"    , "narrator": "みやび", "text": "まあ"},
        { "location": "227/TALK"    , "narrator": "みやび", "text": "そうだ"},
        { "location": "228/ACT"     , "narrator": "", "text": "目玉焼きは醤油派"},
        { "location": "230/TALK"    , "narrator": "みやび", "text": "奇遇ちや"},
        { "location": "231/TALK"    , "narrator": "みやび", "text": "うちも醤油派ぞね"},
        { "location": "233/TALK"    , "narrator": "みやび", "text": "ところでだ"},
        { "location": "234/TALK"    , "narrator": "みやび", "text": "情報源が正しいかどうかは"},
        { "location": "236/TALK"    , "narrator": "みやび", "text": "どう判断するべきか"},
        { "location": "238/SEL"     , "narrator": "", "text": "勘？"},
        { "location": "239/SEL"     , "narrator": "", "text": "経験則かな"},
        { "location": "240/SEL"     , "narrator": "", "text": "多角的視点からの検証"},
        { "location": "241/ACT"     , "narrator": "", "text": "勘？"},
        { "location": "242/TALK"    , "narrator": "みやび", "text": "いや"},
        { "location": "244/TALK"    , "narrator": "みやび", "text": "聞かれても"},
        { "location": "245/ACT"     , "narrator": "", "text": "経験則かな"},
        { "location": "246/TALK"    , "narrator": "みやび", "text": "ぬう"},
        { "location": "247/TALK"    , "narrator": "みやび", "text": "それっぽいことを"},
        { "location": "248/ACT"     , "narrator": "", "text": "多角的視点からの検証"},
        { "location": "249/TALK"    , "narrator": "みやび", "text": "おお"},
        { "location": "250/TALK"    , "narrator": "みやび", "text": "なにやら信憑性の高そうな"},
        { "location": "252/TALK"    , "narrator": "みやび", "text": "最初の判断は無意識で下しているが"},
        { "location": "253/TALK"    , "narrator": "みやび", "text": "それが裏付けをとると割と当たっておるのは"},
        { "location": "254/TALK"    , "narrator": "みやび", "text": "不思議なことじゃの"}
    ]
}
