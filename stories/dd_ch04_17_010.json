{
    "dir": "chap17/daydra/dd_ch04_17_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "17452",
        "cid": "miyabi",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "恐怖"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "恐怖"},
        { "location": "33/TALK"   , "narrator": "みやび", "text": "んっ？"},
        { "location": "36/TALK"   , "narrator": "つばめ", "text": "あれ？　みやびさん、\nパソコンどうかしたん\nですか？"},
        { "location": "38/TALK"   , "narrator": "みやび", "text": "…ＳＳＤの様子が\nちっくとおかしくてな。"},
        { "location": "39/TALK"   , "narrator": "みやび", "text": "とうとうおしゃかに\nなったようやが。"},
        { "location": "41/TALK"   , "narrator": "繭", "text": "結構使い込んでいた\nみたいですね。"},
        { "location": "42/TALK"   , "narrator": "みやび", "text": "うん、長い間頑張って\nくれたえい子やったが。"},
        { "location": "45/TALK"   , "narrator": "キリト", "text": "あの、ＳＳＤの様子が\n変だったってことは、\nデータはもちろん…。"},
        { "location": "47/TALK"   , "narrator": "みやび", "text": "おしゃかやね。\n綺麗さっぱりさよならや。"},
        { "location": "49/TALK"   , "narrator": "雛", "text": "でも、全然ショックを\n受けてるようには\n見えませんよー？"},
        { "location": "51/TALK"   , "narrator": "繭", "text": "バックアップ取ってる\nからに決まってる。"},
        { "location": "53/TALK"   , "narrator": "繭", "text": "あなた達も、週に一度\nくらいは取ってるでしょ？"},
        { "location": "55/TALK"   , "narrator": "雛", "text": "…バックアップ？"},
        { "location": "58/TALK"   , "narrator": "キリト", "text": "いや、取ってねぇけど？"},
        { "location": "59/TALK"   , "narrator": "繭", "text": "…は？"},
        { "location": "61/TALK"   , "narrator": "みやび", "text": "まさか…つばめちゃんは\nちゃんとバックアップを\n取っちょるよな？"},
        { "location": "62/TALK"   , "narrator": "つばめ", "text": "取ってないですけど？"},
        { "location": "65/TALK"   , "narrator": "みやび", "text": "…なんでや？\nどうしてバックアップを\n取らんが？"},
        { "location": "67/TALK"   , "narrator": "雛", "text": "なんでって…\n考えたこともないし…。"},
        { "location": "69/TALK"   , "narrator": "キリト", "text": "っていうか、\n面倒くさくないっすか？"},
        { "location": "71/TALK"   , "narrator": "みやび", "text": "…………。"},
        { "location": "73/TALK"   , "narrator": "繭", "text": "っ！？　みやび先輩！"},
        { "location": "77/TALK"   , "narrator": "みやび", "text": "だ、大丈夫や。\nちっくと、眩暈がした\nだけやき…。"},
        { "location": "80/TALK"   , "narrator": "みやび", "text": "…こいつら、正気とは\n思えんな。"},
        { "location": "92/TALK"   , "narrator": "みやび", "text": "相棒、うちは頭が痛うなってきたがよ"},
        { "location": "94/TALK"   , "narrator": "みやび", "text": "つばめちゃん達、ＰＣのデータが消えたらショック受けるんわかっちゅうに"},
        { "location": "95/TALK"   , "narrator": "みやび", "text": "まったくバックアップ取っとらんがよ"},
        { "location": "96/TALK"   , "narrator": "みやび", "text": "まっこと信じられん…今まで集めたり作ったデータが"},
        { "location": "97/TALK"   , "narrator": "みやび", "text": "一瞬にして消えてしまうんが怖くないがか？"},
        { "location": "98/TALK"   , "narrator": "みやび", "text": "…ここは、言って聞かせた方がえいやろか？"},
        { "location": "100/SEL"   , "narrator": "", "text": "一度痛い目を見せるべき"},
        { "location": "101/SEL"   , "narrator": "", "text": "何とかしてあげて"},
        { "location": "102/ACT"   , "narrator": "", "text": "一度痛い目を見せるべき"},
        { "location": "104/TALK"  , "narrator": "みやび", "text": "…相棒、思ってた以上にスパルタやね"},
        { "location": "105/TALK"  , "narrator": "みやび", "text": "やけんど、確かにそれが一番かもしれんね"},
        { "location": "106/TALK"  , "narrator": "みやび", "text": "大切なデータが根こそぎ消えるショックと恐怖"},
        { "location": "107/TALK"  , "narrator": "みやび", "text": "それがどれほどのものか、身を持って知るのが一番やな"},
        { "location": "118/TALK"  , "narrator": "みやび", "text": "…あんたら、一つだけ言うて\nおくき、耳かっぽじって\nよく聞くちや。"},
        { "location": "119/TALK"  , "narrator": "みやび", "text": "ＰＣなんてのは、\nいつ異常が出るか\nわからない物なんよ。"},
        { "location": "121/TALK"  , "narrator": "キリト", "text": "…まあ、そうっすよね。\n俺のも急に再起動したり\nすることあるし。"},
        { "location": "124/TALK"  , "narrator": "雛", "text": "あ～、あるある。\nあたしのノートも\n時々そうなるよ。"},
        { "location": "126/TALK"  , "narrator": "繭", "text": "あ、あなた達…それで\n不安を感じないの？"},
        { "location": "129/TALK"  , "narrator": "キリト", "text": "不安っていうか、\nしっかりしてくれ、って\n思うけどな。"},
        { "location": "131/TALK"  , "narrator": "みやび", "text": "もうえいよ。\n多分、言ってもわかって\nもらえんきね。"},
        { "location": "133/TALK"  , "narrator": "みやび", "text": "バックアップを取らんで\nいるとどうなるか――"},
        { "location": "134/TALK"  , "narrator": "みやび", "text": "いずれ身を持って経験し、\n後悔から学ぶとえいよ。"},
        { "location": "136/TALK"  , "narrator": "雛", "text": "う～ん…ちょっと大げさな\n気がするけどなぁ…。"},
        { "location": "138/TALK"  , "narrator": "つばめ", "text": "ショックは受けると\n思いますけど、そこまで\nじゃない気がします。"},
        { "location": "141/TALK"  , "narrator": "キリト", "text": "ちくしょぉ、って思う\nくらいじゃねぇの？\n繭もそう思うだろ？"},
        { "location": "142/TALK"  , "narrator": "繭", "text": "…想像するだけでも、\n死にたくなるほど\n怖いんだけど？"},
        { "location": "143/ACT"   , "narrator": "", "text": "何とかしてあげて"},
        { "location": "146/TALK"  , "narrator": "みやび", "text": "そうやね"},
        { "location": "147/TALK"  , "narrator": "みやび", "text": "言った方がえいかどうか\n聞くまでもなかったがよ"},
        { "location": "148/TALK"  , "narrator": "みやび", "text": "驚き過ぎてまともな判断が\nできんくなっちゅうたの\nかもしれん"},
        { "location": "159/TALK"  , "narrator": "みやび", "text": "…明日、みんなに\nフラッシュメモリを\n配るき。"},
        { "location": "160/TALK"  , "narrator": "みやび", "text": "それに、最低限自分の\n大事なデータを保存して、\n大切にしまっとくちや。"},
        { "location": "162/TALK"  , "narrator": "雛", "text": "大事なデータだけでも\nバックアップしろ、って\nことですか？"},
        { "location": "164/TALK"  , "narrator": "繭", "text": "それ以外にないでしょ？"},
        { "location": "167/TALK"  , "narrator": "キリト", "text": "まあ、貰えるってんなら\nありがたく使わせて\n貰うっすけど――"},
        { "location": "168/TALK"  , "narrator": "キリト", "text": "そこまでする必要、\n本当にあんのかなぁ？"},
        { "location": "170/TALK"  , "narrator": "つばめ", "text": "う～ん…でも、全部\n消えちゃうよりは\nいいんじゃないかな？"},
        { "location": "172/TALK"  , "narrator": "雛", "text": "確かにそうだけど、\n消えても困るような\nデータほとんどないし…。"},
        { "location": "174/TALK"  , "narrator": "みやび", "text": "…そんなデータでも、\n消えた時のショックは\nまっことはんぱないんよ。"},
        { "location": "176/TALK"  , "narrator": "繭", "text": "みやび先輩…こいつら、\n一度痛い目を見た方が\n良いんじゃないですか？"},
        { "location": "179/TALK"  , "narrator": "みやび", "text": "正直うちもそう思うがよ。"},
        { "location": "181/TALK"  , "narrator": "みやび", "text": "ＨＤＤ、綺麗さっぱり\nキエテナクナーレ、\nっちゅう感じにな。"},
        { "location": "182/TALK"  , "narrator": "みやび", "text": "けんど、やれること\nやっとかんと――"},
        { "location": "183/TALK"  , "narrator": "みやび", "text": "後で痛むんは、\nこっちの心やきな…。"},
        { "location": "185/TALK"  , "narrator": "キリト", "text": "あの、バックアップって\n一回やればそれで\nいいんすか？"},
        { "location": "187/TALK"  , "narrator": "繭", "text": "…キエテナクナーレ！"},
        { "location": "18/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>7月26日　0:21 PM</color>\nとある平日の昼休み、つばめの教室にて。"}
    ]
}
