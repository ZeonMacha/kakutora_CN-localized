    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "006_軽さはりんご3個分"},
        { "location": "32/TALK"   , "narrator": "アーヤ", "text": "読めたわ＼(◎o◎)／"},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "卯月が貸してくれた本"},
        { "location": "35/SEL"    , "narrator": "", "text": "色々読みたくなった？"},
        { "location": "36/SEL"    , "narrator": "", "text": "意外だ"},
        { "location": "37/SEL"    , "narrator": "", "text": "どういうのだった？"},
        { "location": "38/TALK"   , "narrator": "アーヤ", "text": "全然読まないタイプの小説だから"},
        { "location": "39/TALK"   , "narrator": "アーヤ", "text": "時間がかかるかと思ったけど"},
        { "location": "40/TALK"   , "narrator": "アーヤ", "text": "意外とすんなり読めた感じ"},
        { "location": "42/ACT"    , "narrator": "", "text": "色々読みたくなった？"},
        { "location": "44/TALK"   , "narrator": "アーヤ", "text": "想像して頼りは"},
        { "location": "45/TALK"   , "narrator": "アーヤ", "text": "あ"},
        { "location": "46/TALK"   , "narrator": "アーヤ", "text": "想像してたよりは"},
        { "location": "47/TALK"   , "narrator": "アーヤ", "text": "面白かったけど"},
        { "location": "48/TALK"   , "narrator": "アーヤ", "text": "わざわざ読むほどじゃないわね(￣Д￣ )"},
        { "location": "49/TALK"   , "narrator": "アーヤ", "text": "でも"},
        { "location": "50/TALK"   , "narrator": "アーヤ", "text": "機会があったら"},
        { "location": "51/TALK"   , "narrator": "アーヤ", "text": "読もうかしら"},
        { "location": "52/TALK"   , "narrator": "アーヤ", "text": "そんな感じ"},
        { "location": "53/ACT"    , "narrator": "", "text": "意外だ"},
        { "location": "55/TALK"   , "narrator": "アーヤ", "text": "そう（￣ー￣？）"},
        { "location": "57/SEL"    , "narrator": "", "text": "読まずに返すかと思ってた"},
        { "location": "58/SEL"    , "narrator": "", "text": "苦手なジャンルじゃないの？"},
        { "location": "59/SEL"    , "narrator": "", "text": "時間ないかと思って"},
        { "location": "60/ACT"    , "narrator": "", "text": "読まずに返すかと思ってた"},
        { "location": "61/TALK"   , "narrator": "アーヤ", "text": "それはちょっと"},
        { "location": "62/TALK"   , "narrator": "アーヤ", "text": "失礼よね"},
        { "location": "63/TALK"   , "narrator": "アーヤ", "text": "卯月にも"},
        { "location": "64/ACT"    , "narrator": "", "text": "苦手なジャンルじゃないの？"},
        { "location": "65/TALK"   , "narrator": "アーヤ", "text": "二がってっていうか"},
        { "location": "66/TALK"   , "narrator": "アーヤ", "text": "苦手っていうか"},
        { "location": "67/TALK"   , "narrator": "アーヤ", "text": "食わず嫌いって感じかな"},
        { "location": "68/ACT"    , "narrator": "", "text": "時間ないかと思って"},
        { "location": "69/TALK"   , "narrator": "アーヤ", "text": "まあ"},
        { "location": "70/TALK"   , "narrator": "アーヤ", "text": "それはあるけど"},
        { "location": "71/TALK"   , "narrator": "アーヤ", "text": "文庫一冊くらいはね"},
        { "location": "73/TALK"   , "narrator": "アーヤ", "text": "ちょっと面白かった"},
        { "location": "74/TALK"   , "narrator": "アーヤ", "text": "突っ込みどころもいっぱいあったけどヽ(´o｀；"},
        { "location": "75/TALK"   , "narrator": "アーヤ", "text": "でも"},
        { "location": "76/TALK"   , "narrator": "アーヤ", "text": "あんまり感想言うと"},
        { "location": "77/TALK"   , "narrator": "アーヤ", "text": "卯月がおすすめしてくるわよね"},
        { "location": "78/TALK"   , "narrator": "アーヤ", "text": "気を付けなきゃ"},
        { "location": "79/ACT"    , "narrator": "", "text": "どういうのだった？"},
        { "location": "80/TALK"   , "narrator": "アーヤ", "text": "えーと"},
        { "location": "81/TALK"   , "narrator": "アーヤ", "text": "主人公がヒロインにモテモテの話"},
        { "location": "82/TALK"   , "narrator": "アーヤ", "text": "ヒロインは巻かいから来たみたい"},
        { "location": "83/TALK"   , "narrator": "アーヤ", "text": "魔界"},
        { "location": "84/TALK"   , "narrator": "アーヤ", "text": "こういうのが男のロマンなのかしらね"},
        { "location": "85/TALK"   , "narrator": "アーヤ", "text": "卯月が主人公の気持ちで読んでるのか"},
        { "location": "86/TALK"   , "narrator": "アーヤ", "text": "ヒロインの気持ちで読んでるのかは気になるわね"}
    ]
}
