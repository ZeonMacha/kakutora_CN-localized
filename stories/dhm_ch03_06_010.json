        { "location": "7/SCENARIO", "narrator": "", "text": "029_見えなくなるから、と人は言う"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "高等部にはあまり行かない方がいいかしら"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "今思い出してみても"},
        { "location": "34/TALK"   , "narrator": "ガブリエラ", "text": "あの告白は突然すぎたし"},
        { "location": "35/TALK"   , "narrator": "ガブリエラ", "text": "またあんなことがあったらちょっと怖いわ"},
        { "location": "38/SEL"    , "narrator": "", "text": "次からは無視しよう"},
        { "location": "39/SEL"    , "narrator": "", "text": "無事でよかったよ"},
        { "location": "40/SEL"    , "narrator": "", "text": "あんな奴ばかりじゃないよ"},
        { "location": "41/ACT"    , "narrator": "", "text": "次からは無視しよう"},
        { "location": "42/TALK"   , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "44/TALK"   , "narrator": "ガブリエラ", "text": "それがいいかもしれないわ"},
        { "location": "46/SEL"    , "narrator": "", "text": "移動中は携帯で話すふりしよう"},
        { "location": "47/ACT"    , "narrator": "", "text": "移動中は携帯で話すふりしよう"},
        { "location": "48/TALK"   , "narrator": "ガブリエラ", "text": "なるほど"},
        { "location": "49/TALK"   , "narrator": "ガブリエラ", "text": "それだと話しかけられないわね"},
        { "location": "50/TALK"   , "narrator": "ガブリエラ", "text": "さすがマルザンナだわ"},
        { "location": "52/ACT"    , "narrator": "", "text": "無事でよかったよ"},
        { "location": "54/TALK"   , "narrator": "ガブリエラ", "text": "本当にそうね"},
        { "location": "56/TALK"   , "narrator": "ガブリエラ", "text": "心配してくれてありがとう"},
        { "location": "58/SEL"    , "narrator": "", "text": "何もなくて何よりだった"},
        { "location": "59/ACT"    , "narrator": "", "text": "何もなくて何よりだった"},
        { "location": "60/TALK"   , "narrator": "ガブリエラ", "text": "そうよね"},
        { "location": "61/TALK"   , "narrator": "ガブリエラ", "text": "マルザンナのおかげだわ"},
        { "location": "64/SEL"    , "narrator": "", "text": "もし万が一があったら"},
        { "location": "65/ACT"    , "narrator": "", "text": "もし万が一があったら"},
        { "location": "66/TALK"   , "narrator": "ガブリエラ", "text": "ちょっとマルザンナ？"},
        { "location": "68/TALK"   , "narrator": "ガブリエラ", "text": "貴方少し変よ？"},
        { "location": "69/TALK"   , "narrator": "ガブリエラ", "text": "おどかさないで！"},
        { "location": "71/ACT"    , "narrator": "", "text": "あんな奴ばかりじゃないよ"},
        { "location": "72/TALK"   , "narrator": "ガブリエラ", "text": "そうかもしれないわ"},
        { "location": "73/TALK"   , "narrator": "ガブリエラ", "text": "ちょっと変な人だったのかも"},
        { "location": "75/TALK"   , "narrator": "ガブリエラ", "text": "気を付けないとね"}
