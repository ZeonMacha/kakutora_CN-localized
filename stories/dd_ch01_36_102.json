{
    "dir": "chap36/daydra/dd_ch01_36_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "36105",
        "cid": "tsubame",
        "title": "005 メインストーリー",
        "sub_title": "聖女＜後編＞"
    },
    "entry":
    [
        { "location": "556/TALK"  , "narrator": "聖女つばめ", "text": "……。"},
        { "location": "559/TALK"  , "narrator": "真幌", "text": "どうだ、調子は。"},
        { "location": "562/TALK"  , "narrator": "真幌", "text": "検査の結果――"},
        { "location": "563/TALK"  , "narrator": "聖女つばめ", "text": "もういいよ、\n一人にして。"},
        { "location": "564/TALK"  , "narrator": "聖女つばめ", "text": "どうせわたし、もうすぐ\n死んじゃうんでしょ？"},
        { "location": "565/TALK"  , "narrator": "聖女つばめ", "text": "だからもう、\n一人にして。"},
        { "location": "566/TALK"  , "narrator": "真幌", "text": "バカなことを言うな。"},
        { "location": "568/TALK"  , "narrator": "聖女つばめ", "text": "だってこんな、\nわたしだけ…！"},
        { "location": "584/TALK"  , "narrator": "聖女つばめ", "text": "…今日は\n天気がいいね…。"},
        { "location": "586/TALK"  , "narrator": "真幌", "text": "どうだ、調子は。"},
        { "location": "590/TALK"  , "narrator": "聖女つばめ", "text": "…今は平気です。"},
        { "location": "591/TALK"  , "narrator": "真幌", "text": "…そうか。\nなら少しやるか。"},
        { "location": "592/TALK"  , "narrator": "聖女つばめ", "text": "はい。先生。"},
        { "location": "610/TALK"  , "narrator": "真幌", "text": "人にはそれぞれ、\n正しいと思っている\nことがある。"},
        { "location": "611/TALK"  , "narrator": "真幌", "text": "人が争っている場合、\nそのどちらかだけが\n悪いことはあまりない。"},
        { "location": "612/TALK"  , "narrator": "真幌", "text": "特に国対国の場合は。"},
        { "location": "613/TALK"  , "narrator": "真幌", "text": "これに関わる場合、\n心構えが必要だ。"},
        { "location": "614/TALK"  , "narrator": "真幌", "text": "そのために\n何をすればいいか\nわかるか。"},
        { "location": "615/TALK"  , "narrator": "聖女つばめ", "text": "え…えっと…。"},
        { "location": "616/TALK"  , "narrator": "聖女つばめ", "text": "……すみません……。"},
        { "location": "617/TALK"  , "narrator": "真幌", "text": "最低限、\n必ずすべきこと。"},
        { "location": "618/TALK"  , "narrator": "真幌", "text": "それは双方の状況を\n自分で調べること。"},
        { "location": "619/TALK"  , "narrator": "真幌", "text": "決して偏ってはならない。\n片方に情を寄せても\nいけない。"},
        { "location": "620/TALK"  , "narrator": "真幌", "text": "情は優しさではない。"},
        { "location": "621/TALK"  , "narrator": "聖女つばめ", "text": "…………。"},
        { "location": "622/TALK"  , "narrator": "真幌", "text": "…誤解するな。\n優しさを捨てろと\n言っているわけではない。"},
        { "location": "623/TALK"  , "narrator": "聖女つばめ", "text": "あ、はい！"},
        { "location": "624/TALK"  , "narrator": "真幌", "text": "話を戻そう。"},
        { "location": "625/TALK"  , "narrator": "真幌", "text": "対立するどちらにも良い\n結果を出そうとする場合\n公平さが必要だ。"},
        { "location": "626/TALK"  , "narrator": "真幌", "text": "どちらか一方に\n情をかければ公平さを\n失ってしまう。"},
        { "location": "627/TALK"  , "narrator": "真幌", "text": "そうすれば新たなる\n対立の火種になる。\n…わかるな？"},
        { "location": "628/TALK"  , "narrator": "聖女つばめ", "text": "はい…！"},
        { "location": "637/TALK"  , "narrator": "真幌", "text": "ヘーゲルの弁証法を\n知っているか？"},
        { "location": "638/TALK"  , "narrator": "聖女つばめ", "text": "へーげる、の、\nべんしょうほう？"},
        { "location": "639/TALK"  , "narrator": "聖女つばめ", "text": "何かを壊して\n弁償する時に\n使うものですか？"},
        { "location": "640/TALK"  , "narrator": "真幌", "text": "ぶは。"},
        { "location": "641/TALK"  , "narrator": "聖女つばめ", "text": "えっえっ！？"},
        { "location": "642/TALK"  , "narrator": "真幌", "text": "説明しようか。"},
        { "location": "643/TALK"  , "narrator": "真幌", "text": "物事を正しいと\n思っている側に立ち、\nそれを正とする。"},
        { "location": "644/TALK"  , "narrator": "真幌", "text": "正とされる側と、\nその反とされる側とは\n思想が対立している。"},
        { "location": "645/TALK"  , "narrator": "真幌", "text": "しかし正とされる側の\n内部にも矛盾が\n含まれている。"},
        { "location": "646/TALK"  , "narrator": "真幌", "text": "そして正の中の矛盾が反、\nすなわち対立組織を産む。"},
        { "location": "647/TALK"  , "narrator": "真幌", "text": "……ここまでは\nわかるな？"},
        { "location": "648/TALK"  , "narrator": "聖女つばめ", "text": "…うーん…どっちに\nついても完璧はないって\nことですか？"},
        { "location": "649/TALK"  , "narrator": "真幌", "text": "…いったんそれで\nよしとしよう。\nでは続きだ。"},
        { "location": "650/TALK"  , "narrator": "真幌", "text": "どんなに完璧に\n見えるものにも\n矛盾はある。"},
        { "location": "651/TALK"  , "narrator": "真幌", "text": "その矛盾は反組織を\n産み出すが、単にそれを\n潰すのでは意味がない。"},
        { "location": "652/TALK"  , "narrator": "真幌", "text": "なぜかわかるな？"},
        { "location": "653/TALK"  , "narrator": "聖女つばめ", "text": "……根本の問題が\n解決されていないから、\n…ですよね…？"},
        { "location": "654/TALK"  , "narrator": "真幌", "text": "よしよし。"},
        { "location": "655/TALK"  , "narrator": "真幌", "text": "ではどうする？"},
        { "location": "656/TALK"  , "narrator": "聖女つばめ", "text": "えっ！？\nどうしよう…。"},
        { "location": "657/TALK"  , "narrator": "聖女つばめ", "text": "…どうすれば\nいいですか…？"},
        { "location": "658/TALK"  , "narrator": "真幌", "text": "正と反を徹底的に\n洗い出す。\nそして矛盾を突き止める。"},
        { "location": "659/TALK"  , "narrator": "真幌", "text": "そうして至る解が合。\nそれがアウフヘーベンだ。"},
        { "location": "660/TALK"  , "narrator": "聖女つばめ", "text": "アウフヘーベン…。"},
        { "location": "661/TALK"  , "narrator": "真幌", "text": "以上が\nヘーゲルの弁証法だ。\nどうだ、理解できたか？"},
        { "location": "662/TALK"  , "narrator": "聖女つばめ", "text": "…ちょっと\n難しいです…。"},
        { "location": "663/TALK"  , "narrator": "真幌", "text": "確かにいきなりは\n難しいだろうな。"},
        { "location": "664/TALK"  , "narrator": "聖女つばめ", "text": "はい……。"},
        { "location": "665/TALK"  , "narrator": "聖女つばめ", "text": "だから息抜きに\n音楽聞いても\nいいですか？"},
        { "location": "666/TALK"  , "narrator": "真幌", "text": "調子がいいな。\n…病院には内緒だぞ。"},
        { "location": "667/TALK"  , "narrator": "聖女つばめ", "text": "もちろんです！"},
        { "location": "668/TALK"  , "narrator": "聖女つばめ", "text": "…どうしてここの人たちは\nわたしに何もさせて\nくれないんでしょう。"},
        { "location": "669/TALK"  , "narrator": "真幌", "text": "…さあな。"},
        { "location": "670/TALK"  , "narrator": "真幌", "text": "だがそれも逢瀬を\n大事に思っての\nことなんだろう。"},
        { "location": "671/TALK"  , "narrator": "聖女つばめ", "text": "だったら音楽くらい\n自由に聞かせて\nくれても……。"},
        { "location": "672/TALK"  , "narrator": "真幌", "text": "それだよ。"},
        { "location": "673/TALK"  , "narrator": "聖女つばめ", "text": "え？"},
        { "location": "674/TALK"  , "narrator": "真幌", "text": "ヘーゲルの弁証法の\n実例だ。"},
        { "location": "675/TALK"  , "narrator": "真幌", "text": "逢瀬が大事だから\n禁止事項を作る病院。"},
        { "location": "676/TALK"  , "narrator": "真幌", "text": "大事だと言うなら\n音楽ぐらい好きにと\n不満を募らせる逢瀬。"},
        { "location": "677/TALK"  , "narrator": "真幌", "text": "それぞれの理由を\n突き詰めていけば\n解と合に至る。"},
        { "location": "678/TALK"  , "narrator": "真幌", "text": "そして\nアウフヘーベンたる\n「私」を生み出す。"},
        { "location": "679/TALK"  , "narrator": "真幌", "text": "どうだ？"},
        { "location": "680/TALK"  , "narrator": "聖女つばめ", "text": "…どうだ、と\n言われても……。"},
        { "location": "681/TALK"  , "narrator": "聖女つばめ", "text": "……わたしにはよく\nわからないです……。"},
        { "location": "682/TALK"  , "narrator": "真幌", "text": "…そうか。\n今は難しいかも\nしれないな。"},
        { "location": "683/TALK"  , "narrator": "真幌", "text": "だがこの先、きっと…。"},
        { "location": "684/TALK"  , "narrator": "聖女つばめ", "text": "先生？"},
        { "location": "685/TALK"  , "narrator": "真幌", "text": "いや、こちらの話だ。\n逢瀬はさっさと\n音楽を聴け。"},
        { "location": "686/TALK"  , "narrator": "聖女つばめ", "text": "えー。\nそんな言い方しなくても\nいいじゃないですかー。"},
        { "location": "687/TALK"  , "narrator": "真幌", "text": "じゃあやめるか？"},
        { "location": "688/TALK"  , "narrator": "聖女つばめ", "text": "えっ！\nそれはいやです！\n聴かせてください！"},
        { "location": "689/TALK"  , "narrator": "真幌", "text": "ははは。"},
        { "location": "549/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:Interrupt】</color>\nSystem Interrupted.\n\n必須選択肢が選ばれていません。\n\n<color=green>『STORY27：シン・カグラ』</color>\nにて、選択を行ってから\n再度アクセスしてください。\n"},
        { "location": "553/DIALOG", "narrator": "Dialog_EventData", "text": "数年前。\n静岡・某病院。"},
        { "location": "570/DIALOG", "narrator": "Dialog_Black", "text": "わたしの頭痛の原因は\nレディネスのインプラントにあるらしい。"},
        { "location": "571/DIALOG", "narrator": "Dialog_Black", "text": "特異体質なので専門病院に、とだけ言われて\n知らない病院に連れて来られた。\nそれ以上の説明はなかった。"},
        { "location": "572/DIALOG", "narrator": "Dialog_Black", "text": "こちらからは家族に連絡を\n取ることすらできない。\nもっともできたとしても、\n所在地すらわからない。"},
        { "location": "573/DIALOG", "narrator": "Dialog_Black", "text": "インプラント直後は\nそうでもなかった頭痛は、\n年を追うごとにひどくなっている。"},
        { "location": "594/DIALOG", "narrator": "Dialog_Black", "text": "東雲先生はわたしに\n勉強を教えてくれる先生。"},
        { "location": "595/DIALOG", "narrator": "Dialog_Black", "text": "ずっと入院している\nわたしのために来てくれている。"},
        { "location": "596/DIALOG", "narrator": "Dialog_Black", "text": "東雲先生はいつも優しかった。"},
        { "location": "597/DIALOG", "narrator": "Dialog_Black", "text": "だけど、時折見せる真剣な表情は\nゾッとするほど冷たかった。"},
        { "location": "598/DIALOG", "narrator": "Dialog_Black", "text": "それから、勉強以外のことも\nたくさん教えてくれた。"},
        { "location": "599/DIALOG", "narrator": "Dialog_Black", "text": "世界で生きていくために\n必要なこと、世の中の楽しいこと、\nそれから歌。"},
        { "location": "600/DIALOG", "narrator": "Dialog_Black", "text": "勉強以外のことは全部、松果体肥大に\n悪影響があるとして医師から\n禁止されていたけれど。"},
        { "location": "631/DIALOG", "narrator": "Dialog_Black", "text": "東雲先生が一番大事にしていたのは、\n自分自身の頭で考えること。"},
        { "location": "632/DIALOG", "narrator": "Dialog_Black", "text": "そのための知識であり教養である、と\n繰り返し教えられた。"},
        { "location": "633/DIALOG", "narrator": "Dialog_Black", "text": "――それは医師から禁止されている\n思想だったけれど。"},
        { "location": "691/DIALOG", "narrator": "Dialog_Black", "text": "アウフヘーベンたる「わたし」。"},
        { "location": "692/DIALOG", "narrator": "Dialog_Black", "text": "多国籍企業群は、\nわたしという「反」を生み出した。\n「反」はまた、統一国家による矛盾だった。"},
        { "location": "693/DIALOG", "narrator": "Dialog_Black", "text": "反は解を得て合に至る。"},
        { "location": "694/DIALOG", "narrator": "Dialog_Black", "text": "いずれ多国籍国家は、\n弁証法によるアウフヘーベンによって\nわたしを再吸収するだろう。"},
        { "location": "695/DIALOG", "narrator": "Dialog_Black", "text": "聖女であり、同時に\n聖女になり損ねた矛盾したわたしを。"},
        { "location": "707/DIALOG", "narrator": "Dialog_chapter_ch01", "text": "【30 綾水たちの沈黙】"}
    ]
}
