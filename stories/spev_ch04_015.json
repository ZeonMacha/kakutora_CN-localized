        "title": "スペシャルエピソード",
        "sub_title": "特別製は渡せない"
    },
    "entry":
    [
        { "location": "29/TALK" , "narrator": "みやび", "text": "まったく、クラン達の\nお騒がせっぷりも\n困ったもんぞね。"},
        { "location": "30/TALK" , "narrator": "みやび", "text": "ほれ、\nちゃんと反省しちょるが？"},
        { "location": "31/TALK" , "narrator": "透明寅沢ハル", "text": "は～い…。"},
        { "location": "32/TALK" , "narrator": "みやび", "text": "うむうむ。\nそれでヨシ。"},
        { "location": "33/TALK" , "narrator": "みやび", "text": "チョコが欲しいなら\nちゃんと言わんと\nいかんよ。"},
        { "location": "34/TALK" , "narrator": "透明寅沢ハル", "text": "チョコが欲しいよー。"},
        { "location": "35/TALK" , "narrator": "みやび", "text": "早いな…。"},
        { "location": "36/TALK" , "narrator": "みやび", "text": "まあえい、うちもこれから\n作るところやき、\nハルの分も作っちゃる。"},
        { "location": "37/TALK" , "narrator": "透明寅沢ハル", "text": "わぁ～い！\nやったぁー！！"},
        { "location": "39/TALK" , "narrator": "みやび", "text": "ハルはまっこと\n食べ物が好きやねぇ。"},
        { "location": "40/TALK" , "narrator": "透明寅沢ハル", "text": "食べることがどんなこと\nよりも一番楽しいよ！"},
        { "location": "41/TALK" , "narrator": "透明寅沢ハル", "text": "三度の飯より\n好きなものはないね！"},
        { "location": "42/TALK" , "narrator": "みやび", "text": "それはえいけど\nほどほどにせんと\nいかんよ。"},
        { "location": "43/TALK" , "narrator": "透明寅沢ハル", "text": "そこらへんのクランとは\n鍛え方が違うから\n大丈夫だよ。"},
        { "location": "44/TALK" , "narrator": "みやび", "text": "そもそもクランは\n食事の必要がないから…。"},
        { "location": "45/TALK" , "narrator": "みやび", "text": "ほんだら、すっと\n始めるかねぇ。"},
        { "location": "57/SEL"  , "narrator": "（選択肢）", "text": "$me$の分のチョコもお願い！"},
        { "location": "58/ACT"  , "narrator": "", "text": "$me$の分のチョコもお願い！"},
        { "location": "64/TALK" , "narrator": "みやび", "text": "もちろん、相棒の分も作るちや"},
        { "location": "65/TALK" , "narrator": "みやび", "text": "そのためにチョコや洋菓子について色々調べたんよ"},
        { "location": "66/TALK" , "narrator": "みやび", "text": "色々とあったけんど"},
        { "location": "67/TALK" , "narrator": "みやび", "text": "不安そうにしてたつばめちゃんも上手く出来たみたいやし"},
        { "location": "70/SEL"  , "narrator": "（選択肢）", "text": "でもクランが居ると賑やかでいいね"},
        { "location": "71/SEL"  , "narrator": "（選択肢）", "text": "寅沢ハルを許すのは甘いんじゃない？"},
        { "location": "72/SEL"  , "narrator": "（選択肢）", "text": "モーフィアスはもっとお仕置きしてしまえ"},
        { "location": "73/ACT"  , "narrator": "", "text": "でもクランが居ると賑やかでいいね"},
        { "location": "74/TALK" , "narrator": "みやび", "text": "そうやね"},
        { "location": "76/TALK" , "narrator": "みやび", "text": "ちくっと賑やかすぎる時もあるけんど…"},
        { "location": "77/TALK" , "narrator": "みやび", "text": "皆が楽しんでるのはえいことちや"},
        { "location": "78/ACT"  , "narrator": "", "text": "寅沢ハルを許すのは甘いんじゃない？"},
        { "location": "79/TALK" , "narrator": "みやび", "text": "甘いか。チョコだけに"},
        { "location": "80/SEL"  , "narrator": "（選択肢）", "text": "あ、はい…"},
        { "location": "81/SEL"  , "narrator": "（選択肢）", "text": "わはは（どっ"},
        { "location": "82/ACT"  , "narrator": "", "text": "あ、はい…"},
        { "location": "83/TALK" , "narrator": "みやび", "text": "ぬ…微妙な反応"},
        { "location": "84/ACT"  , "narrator": "", "text": "わはは（どっ"},
        { "location": "85/TALK" , "narrator": "みやび", "text": "もっとウケてもえいよ"},
        { "location": "87/TALK" , "narrator": "みやび", "text": "まあ子供のイタズラみたいなもんやき"},
        { "location": "88/TALK" , "narrator": "みやび", "text": "反省もしとるようから今回はこれでえいんよ"},
        { "location": "89/ACT"  , "narrator": "", "text": "モーフィアスはもっとお仕置きしてしまえ"},
        { "location": "91/TALK" , "narrator": "みやび", "text": "まああいつのことは卯月に任せるちや"},
        { "location": "92/TALK" , "narrator": "みやび", "text": "…卯月がお仕置きする限り、あいつは喜び続けるかもしれんけんど"},
        { "location": "95/TALK" , "narrator": "みやび", "text": "今日はあいつらの分も作ってやらんとね"},
        { "location": "96/TALK" , "narrator": "みやび", "text": "当然、相棒のは特別製やけんどね"},
        { "location": "97/TALK" , "narrator": "みやび", "text": "ところで、相棒はどんなチョコが好きなが？"},
        { "location": "98/SEL"  , "narrator": "（選択肢）", "text": "チョコトリュフかな"},
        { "location": "99/SEL"  , "narrator": "（選択肢）", "text": "チョコケーキがいい"},
        { "location": "100/SEL" , "narrator": "（選択肢）", "text": "チョコクッキーが食べたい"},
        { "location": "101/ACT" , "narrator": "", "text": "生チョコトリュフかな"},
        { "location": "102/TALK", "narrator": "みやび", "text": "相棒は一口で食べやすいのが好きなんやね"},
        { "location": "104/TALK", "narrator": "みやび", "text": "とろけるような食感がたまらんね、あれは"},
        { "location": "105/ACT" , "narrator": "", "text": "チョコケーキがいい"},
        { "location": "106/TALK", "narrator": "みやび", "text": "ふわふわしたのが好きなんかね"},
        { "location": "108/TALK", "narrator": "みやび", "text": "やっぱりケーキは満足感が高いぞね"},
        { "location": "109/ACT" , "narrator": "", "text": "チョコクッキーが食べたい"},
        { "location": "110/TALK", "narrator": "みやび", "text": "サクっとしたのがええんやね"},
        { "location": "112/TALK", "narrator": "みやび", "text": "手軽に食べられるのがえいね"},
        { "location": "114/TALK", "narrator": "みやび", "text": "相棒の好みのチョコを作るために"},
        { "location": "115/TALK", "narrator": "みやび", "text": "チョコの種類を調べてるうちに"},
        { "location": "116/TALK", "narrator": "みやび", "text": "うちのほうが食べたくなってきたぞね"},
        { "location": "117/TALK", "narrator": "みやび", "text": "和食専門やったけんど、チョコ作りで色々試してみるんも面白いかもしれんねえ"},
        { "location": "118/TALK", "narrator": "みやび", "text": "一流チョコメーカーのようにはいかんけんど"},
        { "location": "119/TALK", "narrator": "みやび", "text": "相棒に気に入ってもらえるように頑張るぞね"},
        { "location": "120/TALK", "narrator": "みやび", "text": "期待しとってえいよ"},
        { "location": "121/SEL" , "narrator": "（選択肢）", "text": "$me$にとっては市販品よりもいい"},
        { "location": "122/SEL" , "narrator": "（選択肢）", "text": "まああれと比べちゃうとねｗ"},
        { "location": "123/ACT" , "narrator": "", "text": "$me$にとっては市販品よりもいい"},
        { "location": "124/TALK", "narrator": "みやび", "text": "そう言ってくれると作り甲斐があるんよ"},
        { "location": "125/ACT" , "narrator": "", "text": "まああれと比べちゃうとねｗ"},
        { "location": "126/TALK", "narrator": "みやび", "text": "はっきりいいよる…。"},
        { "location": "128/TALK", "narrator": "みやび", "text": "さて、気合入れて頑張るかねぇ"},
        { "location": "129/TALK", "narrator": "みやび", "text": "ほんだら、また後でな"},
        { "location": "137/TALK", "narrator": "透明寅沢ハル", "text": "ん～、甘くて\n美味しいなぁ。"},
        { "location": "139/TALK", "narrator": "透明みやび", "text": "ちょ、ハル！\n作りかけのチョコを――"},
        { "location": "140/TALK", "narrator": "透明みやび", "text": "次々食べるのは\nやめるちや！"},
        { "location": "141/TALK", "narrator": "透明みやび", "text": "これじゃ全部、完成前に\nなくなってしまうぞね！"},
        { "location": "142/TALK", "narrator": "透明寅沢ハル", "text": "む～、また\n怒られちゃうから\n我慢するよ～。"},
        { "location": "144/TALK", "narrator": "透明みやび", "text": "やれやれ…。\nハルを満足させるのは\n苦労しそうぞね"},
        { "location": "145/SEL" , "narrator": "（選択肢）", "text": "調子はどう？"},
        { "location": "146/ACT" , "narrator": "", "text": "調子はどう？"},
        { "location": "151/TALK", "narrator": "みやび", "text": "作っても作ってもハルにすぐ食べられてしまう"},
        { "location": "152/TALK", "narrator": "みやび", "text": "このまま永遠にチョコを作り続けることになりそうやったけんど"},
        { "location": "153/TALK", "narrator": "みやび", "text": "なんとかわかってくれたみたいぞね"},
        { "location": "154/SEL" , "narrator": "（選択肢）", "text": "チョコ作りは楽しい？"},
        { "location": "155/SEL" , "narrator": "（選択肢）", "text": "他のメンバーに変わってもらおう"},
        { "location": "156/ACT" , "narrator": "", "text": "チョコ作りは楽しい？"},
        { "location": "157/TALK", "narrator": "みやび", "text": "うむ、普段やらんからね"},
        { "location": "158/TALK", "narrator": "みやび", "text": "やり始めるとつい色々凝りたくなってしまうがよ"},
        { "location": "159/ACT" , "narrator": "", "text": "他のメンバーに変わってもらおう"},
        { "location": "160/TALK", "narrator": "みやび", "text": "まあこれでも楽しんじょるき"},
        { "location": "161/TALK", "narrator": "みやび", "text": "その必要はないんよ"},
        { "location": "163/TALK", "narrator": "みやび", "text": "よし、引き続き頑張るかね"},
        { "location": "165/TALK", "narrator": "透明寅沢ハル", "text": "うう、仕方ない。\nそれじゃこれが\n最後のひとつ…"},
        { "location": "166/TALK", "narrator": "透明寅沢ハル", "text": "あれ？このチョコ\nなんか豪華だね"},
        { "location": "168/TALK", "narrator": "透明みやび", "text": "おっと、それだけは\n渡さんよ。"},
        { "location": "169/TALK", "narrator": "透明寅沢ハル", "text": "えー、なんでー。"},
        { "location": "171/TALK", "narrator": "透明みやび", "text": "それはとびっきりの\n「特別製」になる\nやつなんよ。"}
    ]
}
