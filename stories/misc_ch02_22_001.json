    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "優しいだなんて"},
        { "location": "34/TALK"   , "narrator": "アーヤ", "text": "優しいって言葉は"},
        { "location": "35/TALK"   , "narrator": "アーヤ", "text": "色んな意味があり過ぎて"},
        { "location": "36/TALK"   , "narrator": "アーヤ", "text": "時々深読みし過ぎちゃうわ"},
        { "location": "38/SEL"    , "narrator": "", "text": "嫌味かもね"},
        { "location": "39/SEL"    , "narrator": "", "text": "難しいよね"},
        { "location": "40/SEL"    , "narrator": "", "text": "言葉通りにとっていいよ"},
        { "location": "41/ACT"    , "narrator": "", "text": "嫌味かもね"},
        { "location": "42/TALK"   , "narrator": "アーヤ", "text": "ほんとにね"},
        { "location": "44/TALK"   , "narrator": "アーヤ", "text": "そういうことあるわよね"},
        { "location": "45/ACT"    , "narrator": "", "text": "難しいよね"},
        { "location": "46/TALK"   , "narrator": "アーヤ", "text": "そうなのよ"},
        { "location": "47/ACT"    , "narrator": "", "text": "言葉通りにとっていいよ"},
        { "location": "49/TALK"   , "narrator": "アーヤ", "text": "あら"},
        { "location": "50/TALK"   , "narrator": "アーヤ", "text": "そうかもね"},
        { "location": "51/TALK"   , "narrator": "アーヤ", "text": "深読みしすぎなのかもね"},
        { "location": "53/TALK"   , "narrator": "アーヤ", "text": "最近思うのはね"},
        { "location": "54/TALK"   , "narrator": "アーヤ", "text": "優しいって大人になることかも"},
        { "location": "55/TALK"   , "narrator": "アーヤ", "text": "ってことなのよね"},
        { "location": "57/SEL"    , "narrator": "", "text": "そうかも"},
        { "location": "58/SEL"    , "narrator": "", "text": "どうかなー"},
        { "location": "59/SEL"    , "narrator": "", "text": "$me$はアーヤに優しくされたい"},
        { "location": "60/ACT"    , "narrator": "", "text": "そうかも"},
        { "location": "61/TALK"   , "narrator": "アーヤ", "text": "そうだと"},
        { "location": "63/TALK"   , "narrator": "アーヤ", "text": "おもうのよね"},
        { "location": "64/ACT"    , "narrator": "", "text": "どうかなー"},
        { "location": "65/TALK"   , "narrator": "アーヤ", "text": "そんなこと"},
        { "location": "66/TALK"   , "narrator": "アーヤ", "text": "ないのかしら"},
        { "location": "67/ACT"    , "narrator": "", "text": "$me$はアーヤに優しくされたい"},
        { "location": "69/TALK"   , "narrator": "アーヤ", "text": "こらこら"},
        { "location": "70/TALK"   , "narrator": "アーヤ", "text": "甘えん坊ね"},
        { "location": "71/TALK"   , "narrator": "アーヤ", "text": "まだ子供なのかしら？"},
        { "location": "73/TALK"   , "narrator": "アーヤ", "text": "悪い意味に取り過ぎるのも"},
        { "location": "74/TALK"   , "narrator": "アーヤ", "text": "よくないわね"},
        { "location": "75/TALK"   , "narrator": "アーヤ", "text": "気を付けなきゃだわ"}
    ]
