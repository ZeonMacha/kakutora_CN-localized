        { "location": "98/TALK"    , "narrator": "ガブリエラ", "text": "アイシングクッキーって"},
        { "location": "99/TALK"    , "narrator": "ガブリエラ", "text": "なんであんなにかわいいのかしら？"},
        { "location": "101/SEL"    , "narrator": "", "text": "何でだろうね"},
        { "location": "102/SEL"    , "narrator": "", "text": "それ何？"},
        { "location": "103/SEL"    , "narrator": "", "text": "ガブの方が可愛いよ"},
        { "location": "104/ACT"    , "narrator": "", "text": "何でだろうね"},
        { "location": "105/TALK"   , "narrator": "ガブリエラ", "text": "本当に"},
        { "location": "106/TALK"   , "narrator": "ガブリエラ", "text": "不思議よね"},
        { "location": "107/ACT"    , "narrator": "", "text": "それ何？"},
        { "location": "108/TALK"   , "narrator": "ガブリエラ", "text": "絵とか文字の書いてあるクッキー"},
        { "location": "109/TALK"   , "narrator": "ガブリエラ", "text": "見たことないかしら？"},
        { "location": "110/ACT"    , "narrator": "", "text": "ガブの方が可愛いよ"},
        { "location": "112/TALK"   , "narrator": "ガブリエラ", "text": "そういう話をしてるわけじゃないのよ//////"},
        { "location": "113/TALK"   , "narrator": "ガブリエラ", "text": "もう///////"},
        { "location": "115/TALK"   , "narrator": "ガブリエラ", "text": "あんまりかわいいから"},
        { "location": "117/TALK"   , "narrator": "ガブリエラ", "text": "食べる気にならないわよね"},
        { "location": "119/SEL"    , "narrator": "", "text": "色つきのクッキーはちょっと……"},
        { "location": "120/SEL"    , "narrator": "", "text": "おいしければ食べるよ"},
        { "location": "121/SEL"    , "narrator": "", "text": "もっとかわいいの作ってあげる"},
        { "location": "122/ACT"    , "narrator": "", "text": "色つきのクッキーはちょっと……"},
        { "location": "123/TALK"   , "narrator": "ガブリエラ", "text": "$marzanna$ったら"},
        { "location": "124/TALK"   , "narrator": "ガブリエラ", "text": "あんなにかわいいものを嫌がるなんて"},
        { "location": "125/TALK"   , "narrator": "ガブリエラ", "text": "どうかしてるわ"},
        { "location": "126/ACT"    , "narrator": "", "text": "おいしければ食べるよ"},
        { "location": "127/TALK"   , "narrator": "ガブリエラ", "text": "おいしいとかおいしくないとかじゃないのよ"},
        { "location": "128/TALK"   , "narrator": "ガブリエラ", "text": "見た目がまず第一なのよ"},
        { "location": "129/TALK"   , "narrator": "ガブリエラ", "text": "それに"},
        { "location": "130/TALK"   , "narrator": "ガブリエラ", "text": "おいしくないってことはないと思うわ"},
        { "location": "131/ACT"    , "narrator": "", "text": "もっとかわいいの作ってあげる"},
        { "location": "133/TALK"   , "narrator": "ガブリエラ", "text": "$marzanna$ったら！"},
        { "location": "135/TALK"   , "narrator": "ガブリエラ", "text": "アイシングクッキーが作れるのねｖｖｖ"},
        { "location": "136/TALK"   , "narrator": "ガブリエラ", "text": "何て素敵なのかしらｖｖｖｖｖ"},
        { "location": "137/TALK"   , "narrator": "ガブリエラ", "text": "$marzanna$のクッキー"},
        { "location": "138/TALK"   , "narrator": "ガブリエラ", "text": "とても楽しみにしているわねｖｖｖｖ"}
