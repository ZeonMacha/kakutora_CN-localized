    "entry":
    [
        { "location": "366/SCENARIO", "narrator": "", "text": "ささやかな日常のシーン"},
        { "location": "393/TALK"    , "narrator": "つばめ", "text": "いただきまーす！"},
        { "location": "395/TALK"    , "narrator": "雛", "text": "つばめちゃんは\n元気だねー。"},
        { "location": "396/TALK"    , "narrator": "神楽", "text": "そこがつばめさんの\nいいところじゃ\nないですか。"},
        { "location": "397/TALK"    , "narrator": "繭", "text": "…おいしそうに\n食べるところも\nいいところだと思う。"},
        { "location": "399/TALK"    , "narrator": "雛", "text": "そうだね。\nたとえ学食の\nおそばでも。"},
        { "location": "400/TALK"    , "narrator": "雛", "text": "なんかおいしそうに\n食べるよね、\nつばめちゃんって。"},
        { "location": "402/TALK"    , "narrator": "つばめ", "text": "あれ？\nみんなはおいしく\nないの？"},
        { "location": "404/TALK"    , "narrator": "雛", "text": "おいしいとか\nおいしくないとか\nよりも。"},
        { "location": "405/TALK"    , "narrator": "雛", "text": "もう飽きちゃってるん\nだよねー。"},
        { "location": "407/TALK"    , "narrator": "繭", "text": "そう。"},
        { "location": "408/TALK"    , "narrator": "神楽", "text": "確かに毎日同じものを\n食べてると飽きますよね。"},
        { "location": "409/TALK"    , "narrator": "雛", "text": "そうそう。\n味わう意味が\nなくなるっていうか。"},
        { "location": "411/TALK"    , "narrator": "つばめ", "text": "そっかー。"},
        { "location": "412/TALK"    , "narrator": "つばめ", "text": "わたしまだ転校してきた\nばっかりだから\nピンとこないけど。"},
        { "location": "413/TALK"    , "narrator": "つばめ", "text": "そのうち飽きたって\nなっちゃうのかな。"},
        { "location": "415/TALK"    , "narrator": "雛", "text": "そう考えるとさ。\n自作のお弁当とか\n大変だよね。"},
        { "location": "416/TALK"    , "narrator": "雛", "text": "遠足の時くらいだけ\nだったらいいけど\n毎日はね。"},
        { "location": "419/TALK"    , "narrator": "つばめ", "text": "…そうかも。"},
        { "location": "421/TALK"    , "narrator": "神楽", "text": "たまに作ってもらうの\nうれしかったですよね。"},
        { "location": "422/TALK"    , "narrator": "神楽", "text": "うちの母はあんまり\n器用じゃないんですけど。"},
        { "location": "423/TALK"    , "narrator": "神楽", "text": "それでもやっぱり\nうれしかったです。"},
        { "location": "424/SEL"     , "narrator": "", "text": "もっと聞かせてよ"},
        { "location": "425/ACT"     , "narrator": "", "text": "もっと聞かせてよ"},
        { "location": "440/SEL"     , "narrator": "", "text": "他に何がある？"},
        { "location": "441/SEL"     , "narrator": "", "text": "神楽の話でもいいよ"},
        { "location": "442/SEL"     , "narrator": "", "text": "神楽はお弁当作らないの？"},
        { "location": "443/ACT"     , "narrator": "", "text": "他に何がある？"},
        { "location": "444/TALK"    , "narrator": "神楽", "text": "そうですね♪"},
        { "location": "445/TALK"    , "narrator": "神楽", "text": "でも今はみんなと話してますからまたの機会に♪"},
        { "location": "446/ACT"     , "narrator": "", "text": "神楽の話でもいいよ"},
        { "location": "447/TALK"    , "narrator": "神楽", "text": "いつもしてるじゃないですか\nﾔﾀﾞｰ"},
        { "location": "448/ACT"     , "narrator": "", "text": "神楽はお弁当作らないの？"},
        { "location": "449/TALK"    , "narrator": "神楽", "text": "ぴょんこはあんまり作らないですね～"},
        { "location": "450/TALK"    , "narrator": "神楽", "text": "気が向いたら作るかも♪"},
        { "location": "459/TALK"    , "narrator": "雛", "text": "うちは言えば\n作ってくれるとは\n思うけど。"},
        { "location": "461/TALK"    , "narrator": "繭", "text": "うちは自分で作れって\n言われる。\n確実に。"},
        { "location": "463/TALK"    , "narrator": "雛", "text": "神楽ちゃんのところは？"},
        { "location": "465/TALK"    , "narrator": "神楽", "text": "うちもちょっと\n無理だと思います。"},
        { "location": "466/TALK"    , "narrator": "雛", "text": "そっかー。\n高校生だとそう\nなっちゃうのかな。"},
        { "location": "467/TALK"    , "narrator": "雛", "text": "うちはちょっと\n過保護なのかな？"},
        { "location": "468/TALK"    , "narrator": "神楽", "text": "…別にそういうことじゃ\nないと思いますよ。"},
        { "location": "469/TALK"    , "narrator": "雛", "text": "だよね！"},
        { "location": "471/TALK"    , "narrator": "つばめ", "text": "お父さんのお弁当、\nちょっと食べたく\nなっちゃったな…。"},
        { "location": "473/TALK"    , "narrator": "雛", "text": "あれ？\nホームシックに\nさせちゃったかな…。"},
        { "location": "475/TALK"    , "narrator": "神楽", "text": "……………。"},
        { "location": "476/TALK"    , "narrator": "神楽", "text": "ママのお弁当、か…。"},
        { "location": "376/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>某月某日　0:14 PM</color>\nとある平日の昼休み、付属学園食堂にて"}
    ]
}
