        { "location": "312/SCENARIO", "narrator": "", "text": "344_説得の呪文（ガブリエラ編）"},
        { "location": "337/TALK"    , "narrator": "ガブリエラ", "text": "今夜は星が綺麗ね"},
        { "location": "338/TALK"    , "narrator": "ガブリエラ", "text": "$marzanna$にも見えるかしら？"},
        { "location": "340/SEL"     , "narrator": "", "text": "星に願いを掛けたいな"},
        { "location": "341/SEL"     , "narrator": "", "text": "ガブリエラにお願いがあるんだ"},
        { "location": "342/SEL"     , "narrator": "", "text": "星より大事なことがある"},
        { "location": "343/ACT"     , "narrator": "", "text": "星に願いを掛けたいな"},
        { "location": "344/TALK"    , "narrator": "ガブリエラ", "text": "あら"},
        { "location": "346/TALK"    , "narrator": "ガブリエラ", "text": "どんな願いかしら？"},
        { "location": "347/ACT"     , "narrator": "", "text": "ガブリエラにお願いがあるんだ"},
        { "location": "348/TALK"    , "narrator": "ガブリエラ", "text": "$marzanna$の言うことなら"},
        { "location": "350/TALK"    , "narrator": "ガブリエラ", "text": "なんでも聞いてあげてよ？"},
        { "location": "351/ACT"     , "narrator": "", "text": "星より大事なことがある"},
        { "location": "352/TALK"    , "narrator": "ガブリエラ", "text": "そうなの？"},
        { "location": "353/TALK"    , "narrator": "ガブリエラ", "text": "一体どんなことかしら"},
        { "location": "356/SEL"     , "narrator": "", "text": "みやびと当直代わってあげて"},
        { "location": "357/ACT"     , "narrator": "", "text": "みやびと当直代わってあげて"},
        { "location": "359/TALK"    , "narrator": "ガブリエラ", "text": "どうしてそんなことを"},
        { "location": "361/TALK"    , "narrator": "ガブリエラ", "text": "$marzanna$が言うのかしら？"},
        { "location": "363/SEL"     , "narrator": "", "text": "みやびの代わりに"},
        { "location": "364/SEL"     , "narrator": "", "text": "代わって欲しいから"},
        { "location": "365/SEL"     , "narrator": "", "text": "ガブリエラは優しい子だよね"},
        { "location": "366/ACT"     , "narrator": "", "text": "みやびの代わりに"},
        { "location": "367/TALK"    , "narrator": "ガブリエラ", "text": "だからどうして？"},
        { "location": "369/TALK"    , "narrator": "ガブリエラ", "text": "マルザンナは私のお友達でしょう？"},
        { "location": "371/TALK"    , "narrator": "ガブリエラ", "text": "$handle$は私の一番じゃないの？"},
        { "location": "373/TALK"    , "narrator": "ガブリエラ", "text": "変だわ"},
        { "location": "375/TALK"    , "narrator": "ガブリエラ", "text": "そんなの"},
        { "location": "376/ACT"     , "narrator": "", "text": "代わって欲しいから"},
        { "location": "378/TALK"    , "narrator": "ガブリエラ", "text": "それはマルザンナの意見でしょう？"},
        { "location": "380/TALK"    , "narrator": "ガブリエラ", "text": "なんで$handle$がそんなこと言うの？"},
        { "location": "382/TALK"    , "narrator": "ガブリエラ", "text": "みやびは関係ないわ"},
        { "location": "383/TALK"    , "narrator": "ガブリエラ", "text": "変なこと言うのね"},
        { "location": "384/TALK"    , "narrator": "ガブリエラ", "text": "$marzanna$ったら"},
        { "location": "385/ACT"     , "narrator": "", "text": "ガブリエラは優しい子だよね"},
        { "location": "386/TALK"    , "narrator": "ガブリエラ", "text": "そんな言い方しても"},
        { "location": "387/TALK"    , "narrator": "ガブリエラ", "text": "関係ないわ"},
        { "location": "388/TALK"    , "narrator": "ガブリエラ", "text": "私には"}
    ]
}
