        "title": "らぶとーく 第60話",
        "sub_title": "勝手すぎると呆れてちょうだい"
    },
    "entry":
    [
        { "location": "1173/SCENARIO", "narrator": "", "text": "勝手すぎると呆れてちょうだい"},
        { "location": "1199/TALK"    , "narrator": "神楽", "text": "いないの？"},
        { "location": "1201/TALK"    , "narrator": "神楽", "text": "返事して"},
        { "location": "1203/TALK"    , "narrator": "神楽", "text": "おいこら"},
        { "location": "1205/TALK"    , "narrator": "神楽", "text": "もー！！！"},
        { "location": "1208/TALK"    , "narrator": "神楽", "text": "どこ行ってるの"},
        { "location": "1212/TALK"    , "narrator": "神楽", "text": "ねえ"},
        { "location": "1214/SEL"     , "narrator": "", "text": "いるよ～"},
        { "location": "1215/SEL"     , "narrator": "", "text": "どうしたの…？"},
        { "location": "1216/SEL"     , "narrator": "", "text": "ごめんね遅くなって"},
        { "location": "1219/ACT"     , "narrator": "", "text": "いるよ～"},
        { "location": "1220/TALK"    , "narrator": "神楽", "text": "やっと来た"},
        { "location": "1221/TALK"    , "narrator": "神楽", "text": "遅い！！！！！"},
        { "location": "1222/ACT"     , "narrator": "", "text": "どうしたの…？"},
        { "location": "1223/TALK"    , "narrator": "神楽", "text": "どうしたのもこうしたのもないぴょん"},
        { "location": "1224/ACT"     , "narrator": "", "text": "ごめんね遅くなって"},
        { "location": "1225/TALK"    , "narrator": "神楽", "text": "ほんとそう"},
        { "location": "1226/TALK"    , "narrator": "神楽", "text": "遅すぎる"},
        { "location": "1227/TALK"    , "narrator": "神楽", "text": "もーもーもーもー"},
        { "location": "1228/TALK"    , "narrator": "神楽", "text": "ぴょんこ待ちくたびれたし"},
        { "location": "1229/TALK"    , "narrator": "神楽", "text": "泣きそうだったし"},
        { "location": "1230/TALK"    , "narrator": "神楽", "text": "なんなのもー"},
        { "location": "1231/TALK"    , "narrator": "神楽", "text": "$handle$のバカ"},
        { "location": "1233/TALK"    , "narrator": "神楽", "text": "なんか白いのに最後通牒突きつけられたでしょ"},
        { "location": "1234/TALK"    , "narrator": "神楽", "text": "ぴょんこもうｶﾞｸﾌﾞﾙで"},
        { "location": "1235/TALK"    , "narrator": "神楽", "text": "震えて震えて仕方がないぴょん、、、"},
        { "location": "1237/SEL"     , "narrator": "", "text": "そんなことあったっけ？"},
        { "location": "1238/SEL"     , "narrator": "", "text": "そうだよね…"},
        { "location": "1239/SEL"     , "narrator": "", "text": "よしよし大丈夫だよ"},
        { "location": "1240/ACT"     , "narrator": "", "text": "そんなことあったっけ？"},
        { "location": "1241/TALK"    , "narrator": "神楽", "text": "あったし！！！！"},
        { "location": "1242/TALK"    , "narrator": "神楽", "text": "何か歌歌えって"},
        { "location": "1243/TALK"    , "narrator": "神楽", "text": "もう歌うしかないって言われたし！"},
        { "location": "1244/TALK"    , "narrator": "神楽", "text": "勝手に！"},
        { "location": "1245/ACT"     , "narrator": "", "text": "そうだよね…"},
        { "location": "1246/TALK"    , "narrator": "神楽", "text": "そうなのぴょん、、、"},
        { "location": "1247/ACT"     , "narrator": "", "text": "よしよし大丈夫だよ"},
        { "location": "1248/TALK"    , "narrator": "神楽", "text": "ビエーン！！！"},
        { "location": "1249/TALK"    , "narrator": "神楽", "text": "ホントにホントに？？？"},
        { "location": "1251/TALK"    , "narrator": "神楽", "text": "そんで"},
        { "location": "1252/TALK"    , "narrator": "神楽", "text": "白いのと話した直後はそんなこと思ってなかったのに"},
        { "location": "1253/TALK"    , "narrator": "神楽", "text": "一人きりになったら"},
        { "location": "1254/TALK"    , "narrator": "神楽", "text": "なんだかいきなり怖くなって"},
        { "location": "1257/TALK"    , "narrator": "神楽", "text": "どうしようもなくなって"},
        { "location": "1260/TALK"    , "narrator": "神楽", "text": "そういうの"},
        { "location": "1261/SEL"     , "narrator": "", "text": "あるよね…"},
        { "location": "1262/SEL"     , "narrator": "", "text": "わかる！"},
        { "location": "1263/SEL"     , "narrator": "", "text": "かわいいところもあるんだね"},
        { "location": "1264/TALK"    , "narrator": "神楽", "text": "わかってくれるかな"},
        { "location": "1265/TALK"    , "narrator": "神楽", "text": "わかってくれるよね、、、"},
        { "location": "1267/ACT"     , "narrator": "", "text": "あるよね…"},
        { "location": "1268/TALK"    , "narrator": "神楽", "text": "あるでしょ？"},
        { "location": "1269/ACT"     , "narrator": "", "text": "わかる！"},
        { "location": "1270/TALK"    , "narrator": "神楽", "text": "わかってくれる？"},
        { "location": "1271/ACT"     , "narrator": "", "text": "かわいいところもあるんだね"},
        { "location": "1272/TALK"    , "narrator": "神楽", "text": "ぴょんこはいつでもかわいいのに"},
        { "location": "1273/TALK"    , "narrator": "神楽", "text": "そんなこと言うの？"},
        { "location": "1275/TALK"    , "narrator": "神楽", "text": "$handle$はいつもぴょんこと一緒にいるんでしょ"},
        { "location": "1276/TALK"    , "narrator": "神楽", "text": "それって信じていいの"},
        { "location": "1277/TALK"    , "narrator": "神楽", "text": "この先も信じていいの"},
        { "location": "1279/SEL"     , "narrator": "", "text": "信じてよ"},
        { "location": "1280/SEL"     , "narrator": "", "text": "信じてくれないの？"},
        { "location": "1281/SEL"     , "narrator": "", "text": "信じようよ！"},
        { "location": "1282/ACT"     , "narrator": "", "text": "信じてよ"},
        { "location": "1283/TALK"    , "narrator": "神楽", "text": "うん、、、"},
        { "location": "1284/ACT"     , "narrator": "", "text": "信じてくれないの？"},
        { "location": "1285/TALK"    , "narrator": "神楽", "text": "それは"},
        { "location": "1287/TALK"    , "narrator": "神楽", "text": "信じてるけど"},
        { "location": "1288/TALK"    , "narrator": "神楽", "text": "けど、、、"},
        { "location": "1289/ACT"     , "narrator": "", "text": "信じようよ！"},
        { "location": "1290/TALK"    , "narrator": "神楽", "text": "言い切った？"},
        { "location": "1292/TALK"    , "narrator": "神楽", "text": "ぴょんこはつばめさんの前で歌を歌ってしまったら世界が変わる"},
        { "location": "1293/TALK"    , "narrator": "神楽", "text": "この世界は作り替えられてしまう"},
        { "location": "1294/TALK"    , "narrator": "神楽", "text": "そうしたら多分ぴょんこはもう"},
        { "location": "1295/TALK"    , "narrator": "神楽", "text": "$handle$のこと忘れる"},
        { "location": "1296/TALK"    , "narrator": "神楽", "text": "多分だけど"},
        { "location": "1297/TALK"    , "narrator": "神楽", "text": "絶対"},
        { "location": "1298/TALK"    , "narrator": "神楽", "text": "どうしても"},
        { "location": "1299/TALK"    , "narrator": "神楽", "text": "そんなことしたくなくても"},
        { "location": "1300/TALK"    , "narrator": "神楽", "text": "したくないけど"},
        { "location": "1301/TALK"    , "narrator": "神楽", "text": "したくないけど！"},
        { "location": "1303/SEL"     , "narrator": "", "text": "それでも$me$は憶えてる"},
        { "location": "1304/SEL"     , "narrator": "", "text": "神楽も忘れないと思う"},
        { "location": "1305/SEL"     , "narrator": "", "text": "仕方ないよね…"},
        { "location": "1306/ACT"     , "narrator": "", "text": "それでも$me$は憶えてる"},
        { "location": "1308/TALK"    , "narrator": "神楽", "text": "うん"},
        { "location": "1309/TALK"    , "narrator": "神楽", "text": "その言葉が聞きたかったの"},
        { "location": "1311/SEL"     , "narrator": "", "text": "だと思ってた"},
        { "location": "1312/SEL"     , "narrator": "", "text": "本当だからね"},
        { "location": "1313/SEL"     , "narrator": "", "text": "忘れられるわけないでしょ"},
        { "location": "1314/ACT"     , "narrator": "", "text": "だと思ってた"},
        { "location": "1315/TALK"    , "narrator": "神楽", "text": "あれお見通しってこと？"},
        { "location": "1316/TALK"    , "narrator": "神楽", "text": "生意気だな$handle$"},
        { "location": "1317/ACT"     , "narrator": "", "text": "本当だからね"},
        { "location": "1318/TALK"    , "narrator": "神楽", "text": "絶対だよね"},
        { "location": "1319/TALK"    , "narrator": "神楽", "text": "ホントに"},
        { "location": "1320/ACT"     , "narrator": "", "text": "忘れられるわけないでしょ"},
        { "location": "1321/TALK"    , "narrator": "神楽", "text": "忘れる、じゃなくて忘れられる、なんだ？"},
        { "location": "1323/TALK"    , "narrator": "神楽", "text": "うん"},
        { "location": "1324/TALK"    , "narrator": "神楽", "text": "いいねそれ"},
        { "location": "1326/TALK"    , "narrator": "神楽", "text": "ねえ$handle$"},
        { "location": "1327/TALK"    , "narrator": "神楽", "text": "ぴょんこのこと愛してるって言って"},
        { "location": "1328/TALK"    , "narrator": "神楽", "text": "絶対に忘れないって誓って"},
        { "location": "1330/SEL"     , "narrator": "", "text": "宇宙で一番愛してる"},
        { "location": "1331/SEL"     , "narrator": "", "text": "生まれ変わっても忘れない"},
        { "location": "1332/SEL"     , "narrator": "", "text": "忘れないのは愛の証明"},
        { "location": "1333/ACT"     , "narrator": "", "text": "宇宙で一番愛してる"},
        { "location": "1334/TALK"    , "narrator": "神楽", "text": "宇宙か、、、"},
        { "location": "1335/TALK"    , "narrator": "神楽", "text": "それは何宇宙なんだろうね？"},
        { "location": "1336/ACT"     , "narrator": "", "text": "生まれ変わっても忘れない"},
        { "location": "1337/TALK"    , "narrator": "神楽", "text": "輪廻転生か～"},
        { "location": "1338/TALK"    , "narrator": "神楽", "text": "あるいは前々前世"},
        { "location": "1339/ACT"     , "narrator": "", "text": "忘れないのは愛の証明"},
        { "location": "1340/TALK"    , "narrator": "神楽", "text": "両方入れてきたことは褒める"},
        { "location": "1341/TALK"    , "narrator": "神楽", "text": "でも愛の言葉にしては堅いぴょん♪"},
        { "location": "1343/TALK"    , "narrator": "神楽", "text": "ぴょんこは$handle$の言葉を全面的に信じるけど"},
        { "location": "1345/SEL"     , "narrator": "", "text": "信じてよ！"},
        { "location": "1346/SEL"     , "narrator": "", "text": "ホントのことしか言ってない"},
        { "location": "1347/SEL"     , "narrator": "", "text": "それで合ってるよ"},
        { "location": "1348/ACT"     , "narrator": "", "text": "信じてよ！"},
        { "location": "1349/TALK"    , "narrator": "神楽", "text": "信じてる"},
        { "location": "1350/ACT"     , "narrator": "", "text": "ホントのことしか言ってない"},
        { "location": "1351/TALK"    , "narrator": "神楽", "text": "知ってる"},
        { "location": "1352/ACT"     , "narrator": "", "text": "それで合ってるよ"},
        { "location": "1353/TALK"    , "narrator": "神楽", "text": "そうだよね？"},
        { "location": "1355/TALK"    , "narrator": "神楽", "text": "信じてるけど"},
        { "location": "1356/TALK"    , "narrator": "神楽", "text": "それでも聞いて"},
        { "location": "1359/TALK"    , "narrator": "ボイスメール", "text": "約束、だから"},
        { "location": "1377/ACT"     , "narrator": "", "text": "神楽も忘れないと思う"},
        { "location": "1378/TALK"    , "narrator": "神楽", "text": "そんなの"},
        { "location": "1380/TALK"    , "narrator": "神楽", "text": "無理だから"},
        { "location": "1381/TALK"    , "narrator": "神楽", "text": "無理だから"},
        { "location": "1382/ACT"     , "narrator": "", "text": "仕方ないよね…"},
        { "location": "1383/TALK"    , "narrator": "神楽", "text": "そうだよね"},
        { "location": "1385/TALK"    , "narrator": "神楽", "text": "仕方ないよね"},
        { "location": "1386/TALK"    , "narrator": "神楽", "text": "もう"},
        { "location": "1371/DIALOG"  , "narrator": "Dialog_GETVoice", "text": "<color=green>【神楽】</color>のボイスメール\n<color=red>【約束、だから】</color>\nをゲットしました！"}
    ]
}
