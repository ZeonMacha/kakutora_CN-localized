        "title": "005 メインストーリー",
        "sub_title": "かしこみかしこみ＜後編＞"
    },
    "entry":
    [
        { "location": "489/SCENARIO", "narrator": "", "text": "未来に触れるなら"},
        { "location": "517/TALK"    , "narrator": "ガブリエラ", "text": "もう！\nみやびが変なこと\n言うから！"},
        { "location": "520/TALK"    , "narrator": "みやび", "text": "うちは可能性の\n話をしただけぞね。"},
        { "location": "521/TALK"    , "narrator": "ガブリエラ", "text": "でもあたし思ったの。"},
        { "location": "522/TALK"    , "narrator": "ガブリエラ", "text": "本当のことは\nわからないけど。"},
        { "location": "523/TALK"    , "narrator": "ガブリエラ", "text": "少なくともつばめは\nあたしたちのこと\n嫌いじゃないって。"},
        { "location": "526/TALK"    , "narrator": "みやび", "text": "理由は？"},
        { "location": "528/TALK"    , "narrator": "ガブリエラ", "text": "だってそうでなきゃ\nまたあたしたちを\n集めたりしない。"},
        { "location": "529/TALK"    , "narrator": "ガブリエラ", "text": "そうでしょ？"},
        { "location": "530/SEL"     , "narrator": "", "text": "$me$もそう思う"},
        { "location": "531/SEL"     , "narrator": "", "text": "楽天主義だね"},
        { "location": "532/SEL"     , "narrator": "", "text": "それはどうかな…"},
        { "location": "533/ACT"     , "narrator": "", "text": "$me$もそう思う"},
        { "location": "534/ACT"     , "narrator": "", "text": "楽天主義だね"},
        { "location": "535/ACT"     , "narrator": "", "text": "それはどうかな…"},
        { "location": "553/TALK"    , "narrator": "ガブリエラ", "text": "違うかしら"},
        { "location": "555/SEL"     , "narrator": "", "text": "違わないよ"},
        { "location": "556/SEL"     , "narrator": "", "text": "友情って感じだね"},
        { "location": "557/SEL"     , "narrator": "", "text": "$me$もまた出会いたい"},
        { "location": "558/ACT"     , "narrator": "", "text": "違わないよ"},
        { "location": "559/TALK"    , "narrator": "ガブリエラ", "text": "そうよね"},
        { "location": "560/TALK"    , "narrator": "ガブリエラ", "text": "よかったわ"},
        { "location": "562/ACT"     , "narrator": "", "text": "友情って感じだね"},
        { "location": "563/TALK"    , "narrator": "ガブリエラ", "text": "そうかもしれないわ"},
        { "location": "564/TALK"    , "narrator": "ガブリエラ", "text": "先輩と後輩だけど"},
        { "location": "566/ACT"     , "narrator": "", "text": "$me$もまた出会いたい"},
        { "location": "567/TALK"    , "narrator": "ガブリエラ", "text": "そんなのｖｖｖ"},
        { "location": "568/TALK"    , "narrator": "ガブリエラ", "text": "当たり前よね///////////////"},
        { "location": "584/TALK"    , "narrator": "みやび", "text": "夜の魔法はすごいねえ。"},
        { "location": "585/TALK"    , "narrator": "ガブリエラ", "text": "へ？"},
        { "location": "586/TALK"    , "narrator": "みやび", "text": "ガブちゃんがこんなに\n素直にデレるところが\n拝めるとは。"},
        { "location": "589/TALK"    , "narrator": "ガブリエラ", "text": "何よそれ！"},
        { "location": "592/TALK"    , "narrator": "アーヤ", "text": "私もギャヴィと\n同じことを考えてた。"},
        { "location": "593/TALK"    , "narrator": "アーヤ", "text": "つばめの期待に\n応えないとね。"},
        { "location": "595/TALK"    , "narrator": "ガブリエラ", "text": "…う、うん…。"},
        { "location": "597/TALK"    , "narrator": "アーヤ", "text": "ところでみやび。\nあなたも禊ぎ、\nしておかない？"},
        { "location": "599/TALK"    , "narrator": "みやび", "text": "うちか……。"},
        { "location": "601/TALK"    , "narrator": "みやび", "text": "正直面倒やけんど。\nその衣装は着てみたいき。\nしとこうかねえ。"},
        { "location": "602/TALK"    , "narrator": "アーヤ", "text": "だったら早速。\n着付けは問題\nないわね。"},
        { "location": "605/TALK"    , "narrator": "みやび", "text": "いや、袴は\nわからんぞね…。"},
        { "location": "637/TALK"    , "narrator": "みやび", "text": "ふむ。\nこれはこれで。"},
        { "location": "638/TALK"    , "narrator": "アーヤ", "text": "ふふ。"},
        { "location": "641/TALK"    , "narrator": "みやび", "text": "どういた？"},
        { "location": "643/TALK"    , "narrator": "アーヤ", "text": "５月まではこの三人\nだったなって。"},
        { "location": "645/TALK"    , "narrator": "ガブリエラ", "text": "確かにそうね。\nある意味原点回帰？"},
        { "location": "647/TALK"    , "narrator": "アーヤ", "text": "かもしれないわ。"},
        { "location": "649/TALK"    , "narrator": "アーヤ", "text": "では、成功を\n祈願して――。"},
        { "location": "664/DIALOG"  , "narrator": "Dialog_chapter_ch03", "text": "【MV EXE_MiYABi】"}
    ]
}
