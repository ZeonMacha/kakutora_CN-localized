        { "location": "691/TALK"    , "narrator": "つばめ", "text": "ずっと一緒だよね"},
        { "location": "692/ACT"     , "narrator": "", "text": "やだって言ったらもうしないの？"},
        { "location": "693/TALK"    , "narrator": "つばめ", "text": "ぇ"},
        { "location": "694/TALK"    , "narrator": "つばめ", "text": "やだそんなの"},
        { "location": "696/SEL"     , "narrator": "", "text": "だったらどう言えばいいと思う？"},
        { "location": "697/SEL"     , "narrator": "", "text": "つばめの気持ちが聞きたいな"},
        { "location": "698/ACT"     , "narrator": "", "text": "だったらどう言えばいいと思う？"},
        { "location": "699/TALK"    , "narrator": "つばめ", "text": "ぇっと"},
        { "location": "700/ACT"     , "narrator": "", "text": "つばめの気持ちが聞きたいな"},
        { "location": "701/TALK"    , "narrator": "つばめ", "text": "ぁたしの"},
        { "location": "702/TALK"    , "narrator": "つばめ", "text": "きもち"},
        { "location": "704/TALK"    , "narrator": "つばめ", "text": "ぇっとね"},
        { "location": "706/TALK"    , "narrator": "つばめ", "text": "ずっと一緒に"},
        { "location": "707/TALK"    , "narrator": "つばめ", "text": "いて欲しいの"},
        { "location": "708/TALK"    , "narrator": "つばめ", "text": "$handle1$には"},
        { "location": "709/TALK"    , "narrator": "つばめ", "text": "そばにいて"},
        { "location": "710/TALK"    , "narrator": "つばめ", "text": "離れないでいて欲しいの"},
        { "location": "711/TALK"    , "narrator": "つばめ", "text": "ぁたしひとりだと"},
        { "location": "712/TALK"    , "narrator": "つばめ", "text": "怖くてもう生きていけない"},
        { "location": "713/TALK"    , "narrator": "つばめ", "text": "だから"},
        { "location": "714/TALK"    , "narrator": "つばめ", "text": "お願い"},
        { "location": "715/TALK"    , "narrator": "つばめ", "text": "ぁたし"},
        { "location": "716/TALK"    , "narrator": "つばめ", "text": "$handle1$のこと"},
        { "location": "717/TALK"    , "narrator": "つばめ", "text": "一番大事だから"},
        { "location": "719/SEL"     , "narrator": "", "text": "$me$もつばめが一番大事"},
        { "location": "720/SEL"     , "narrator": "", "text": "わかった"},
        { "location": "721/SEL"     , "narrator": "", "text": "離れないから大丈夫"},
        { "location": "722/SEL"     , "narrator": "", "text": "よく言えました"},
        { "location": "723/ACT"     , "narrator": "", "text": "$me$もつばめが一番大事"},
        { "location": "724/TALK"    , "narrator": "つばめ", "text": "本当？"},
        { "location": "725/TALK"    , "narrator": "つばめ", "text": "ぁりがとぅ"},
        { "location": "726/ACT"     , "narrator": "", "text": "わかった"},
        { "location": "727/TALK"    , "narrator": "つばめ", "text": "これが"},
        { "location": "728/TALK"    , "narrator": "つばめ", "text": "ぁたしの気持ちだから"},
        { "location": "729/ACT"     , "narrator": "", "text": "離れないから大丈夫"},
        { "location": "730/TALK"    , "narrator": "つばめ", "text": "よかった"},
        { "location": "731/TALK"    , "narrator": "つばめ", "text": "うれしぃ"},
        { "location": "732/ACT"     , "narrator": "", "text": "よく言えました"},
        { "location": "733/TALK"    , "narrator": "つばめ", "text": "なんだか"},
        { "location": "735/TALK"    , "narrator": "つばめ", "text": "先生みたぃ"},
        { "location": "736/TALK"    , "narrator": "つばめ", "text": "$handle$先生"},
        { "location": "737/TALK"    , "narrator": "つばめ", "text": "ょろしくね"},
        { "location": "750/TALK"    , "narrator": "つばめ", "text": "$handle1$が\nいてくれるなら。"},
        { "location": "751/TALK"    , "narrator": "つばめ", "text": "きっとこの先も\n平気だよ。"},
        { "location": "752/TALK"    , "narrator": "つばめ", "text": "きっと……。"},
