{
    "dir": "dramatics/himegoto/drm_ch05_00_680.js",
    "type": "Episode",
    "info": {
        "story_id": "5068",
        "cid": "kagura",
        "title": "らぶとーく 第68話",
        "sub_title": "全部が焼き直し"
    },
    "entry":
    [
        { "location": "1356/SCENARIO", "narrator": "", "text": "全部が焼き直し"},
        { "location": "1381/TALK"    , "narrator": "神楽", "text": "物語の最後はハッピーエンドだから"},
        { "location": "1382/TALK"    , "narrator": "神楽", "text": "その途中がどんなに辛くても大丈夫"},
        { "location": "1383/TALK"    , "narrator": "神楽", "text": "むしろどうしようもない目に遭った方がハッピーエンドは際立つし"},
        { "location": "1384/TALK"    , "narrator": "神楽", "text": "ドラマチックな展開になる"},
        { "location": "1386/SEL"     , "narrator": "", "text": "新作の構想？"},
        { "location": "1387/SEL"     , "narrator": "", "text": "ハリウッド映画かな"},
        { "location": "1388/SEL"     , "narrator": "", "text": "途中を描くのが一番難しい"},
        { "location": "1389/ACT"     , "narrator": "", "text": "新作の構想？"},
        { "location": "1392/TALK"    , "narrator": "神楽", "text": "でも違うかも"},
        { "location": "1393/ACT"     , "narrator": "", "text": "ハリウッド映画かな"},
        { "location": "1394/TALK"    , "narrator": "神楽", "text": "そうかもね"},
        { "location": "1395/TALK"    , "narrator": "神楽", "text": "全世界が大好きなエンターテインメント"},
        { "location": "1396/ACT"     , "narrator": "", "text": "途中を描くのが一番難しい"},
        { "location": "1397/TALK"    , "narrator": "神楽", "text": "その通り"},
        { "location": "1398/TALK"    , "narrator": "神楽", "text": "全ての創作者がそれに頷く"},
        { "location": "1400/TALK"    , "narrator": "神楽", "text": "だから"},
        { "location": "1401/TALK"    , "narrator": "神楽", "text": "ぴょんこが今大変なのは"},
        { "location": "1402/TALK"    , "narrator": "神楽", "text": "ハッピーエンドのためにある"},
        { "location": "1403/SEL"     , "narrator": "", "text": "その通り"},
        { "location": "1404/SEL"     , "narrator": "", "text": "元気出して"},
        { "location": "1405/SEL"     , "narrator": "", "text": "今日はもう休もう"},
        { "location": "1406/TALK"    , "narrator": "神楽", "text": "そういうことでしょ"},
        { "location": "1407/TALK"    , "narrator": "神楽", "text": "違うかな"},
        { "location": "1409/ACT"     , "narrator": "", "text": "その通り"},
        { "location": "1410/TALK"    , "narrator": "神楽", "text": "簡単に賛同するのね"},
        { "location": "1412/TALK"    , "narrator": "神楽", "text": "もう少し考えて"},
        { "location": "1422/ACT"     , "narrator": "", "text": "元気出して"},
        { "location": "1423/TALK"    , "narrator": "神楽", "text": "そんなの無理だし"},
        { "location": "1433/ACT"     , "narrator": "", "text": "今日はもう休もう"},
        { "location": "1437/TALK"    , "narrator": "神楽", "text": "その方がいいのかも"},
        { "location": "1438/TALK"    , "narrator": "神楽", "text": "でも眠れないの"},
        { "location": "1439/TALK"    , "narrator": "神楽", "text": "考えがまとまらなくて"},
        { "location": "1440/TALK"    , "narrator": "神楽", "text": "頭も痛いし"},
        { "location": "1441/TALK"    , "narrator": "神楽", "text": "指先も冷たいし"},
        { "location": "1443/SEL"     , "narrator": "", "text": "ストレスだね…"},
        { "location": "1444/SEL"     , "narrator": "", "text": "まず深呼吸してみよう"},
        { "location": "1445/SEL"     , "narrator": "", "text": "ちゃんとごはん食べてる？"},
        { "location": "1446/ACT"     , "narrator": "", "text": "ストレスだね…"},
        { "location": "1447/TALK"    , "narrator": "神楽", "text": "それ以外ないか"},
        { "location": "1449/TALK"    , "narrator": "神楽", "text": "やっぱり"},
        { "location": "1450/ACT"     , "narrator": "", "text": "まず深呼吸してみよう"},
        { "location": "1451/TALK"    , "narrator": "神楽", "text": "しないよりはまし"},
        { "location": "1452/TALK"    , "narrator": "神楽", "text": "そういうのも"},
        { "location": "1453/ACT"     , "narrator": "", "text": "ちゃんとごはん食べてる？"},
        { "location": "1454/TALK"    , "narrator": "神楽", "text": "食べてる"},
        { "location": "1457/TALK"    , "narrator": "神楽", "text": "一応"},
        { "location": "1459/TALK"    , "narrator": "神楽", "text": "どうせならもっと一目見てわかるくらいの変化が外見に出たら"},
        { "location": "1460/TALK"    , "narrator": "神楽", "text": "わかってくれるんじゃないかな"},
        { "location": "1461/TALK"    , "narrator": "神楽", "text": "髪の色が変わるとか"},
        { "location": "1462/TALK"    , "narrator": "神楽", "text": "目の色が変わるとか"},
        { "location": "1463/TALK"    , "narrator": "神楽", "text": "尻尾が生えるとか"},
        { "location": "1464/TALK"    , "narrator": "神楽", "text": "第三の目が開くとか"},
        { "location": "1466/SEL"     , "narrator": "", "text": "どこに行きたいのかわからない…"},
        { "location": "1467/SEL"     , "narrator": "", "text": "えと…厨二ってことかな？"},
        { "location": "1468/SEL"     , "narrator": "", "text": "キャラデザの変更にはお金がかかるよ"},
        { "location": "1469/ACT"     , "narrator": "", "text": "どこに行きたいのかわからない…"},
        { "location": "1470/TALK"    , "narrator": "神楽", "text": "新しすぎるのかなぴょんこ"},
        { "location": "1471/ACT"     , "narrator": "", "text": "えと…厨二ってことかな？"},
        { "location": "1472/TALK"    , "narrator": "神楽", "text": "わかりやすく言えばそうなるかも"},
        { "location": "1473/ACT"     , "narrator": "", "text": "キャラデザの変更にはお金がかかるよ"},
        { "location": "1474/TALK"    , "narrator": "神楽", "text": "公式ならね"},
        { "location": "1475/TALK"    , "narrator": "神楽", "text": "これは何ていうか"},
        { "location": "1476/TALK"    , "narrator": "神楽", "text": "二次創作的な？"},
        { "location": "1477/TALK"    , "narrator": "神楽", "text": "改変だからおｋ"},
        { "location": "1479/TALK"    , "narrator": "神楽", "text": "トラジディーがもたらすカタストロフィ"},
        { "location": "1480/TALK"    , "narrator": "神楽", "text": "そんなものは現代劇では求められていないぴょん"},
        { "location": "1481/TALK"    , "narrator": "神楽", "text": "望まれているのはハッピーフォーエバーなハッピーエンド"},
        { "location": "1483/SEL"     , "narrator": "", "text": "なんだかよくわかんないけど…"},
        { "location": "1484/SEL"     , "narrator": "", "text": "よしよしいい子だ"},
        { "location": "1485/SEL"     , "narrator": "", "text": "それこそが$me$の求めているもの"},
        { "location": "1486/ACT"     , "narrator": "", "text": "なんだかよくわかんないけど…"},
        { "location": "1487/TALK"    , "narrator": "神楽", "text": "それは残念ぴょん"},
        { "location": "1497/ACT"     , "narrator": "", "text": "よしよしいい子だ"},
        { "location": "1498/TALK"    , "narrator": "神楽", "text": "いい子でなんて"},
        { "location": "1500/TALK"    , "narrator": "神楽", "text": "いたくないぴょん"},
        { "location": "1510/ACT"     , "narrator": "", "text": "それこそが$me$の求めているもの"},
        { "location": "1512/TALK"    , "narrator": "神楽", "text": "そっか$handle$"},
        { "location": "1513/TALK"    , "narrator": "神楽", "text": "ぴょんこと$handle$が惹かれあった理由はここにあったんだ"},
        { "location": "1514/TALK"    , "narrator": "神楽", "text": "理由はワケって読むこと"},
        { "location": "1516/SEL"     , "narrator": "", "text": "本気と書いてマジで？"},
        { "location": "1517/SEL"     , "narrator": "", "text": "神楽を捨てられた空き缶なんかにしない"},
        { "location": "1518/SEL"     , "narrator": "", "text": "それこそが$me$たちの出会った理由"},
        { "location": "1519/ACT"     , "narrator": "", "text": "本気と書いてマジで？"},
        { "location": "1521/ACT"     , "narrator": "", "text": "神楽を捨てられた空き缶なんかにしない"},
        { "location": "1522/TALK"    , "narrator": "神楽", "text": "諦めたらそこで試合終了だよ"},
        { "location": "1523/ACT"     , "narrator": "", "text": "それこそが$me$たちの出会った理由"},
        { "location": "1524/TALK"    , "narrator": "神楽", "text": "理由があるってＹＯＵは言う"},
        { "location": "1525/TALK"    , "narrator": "神楽", "text": "ワケがあるからＮＯ仕訳"},
        { "location": "1527/TALK"    , "narrator": "神楽", "text": "ぴょんこは結局ハッピーエンドを諦めたくない"},
        { "location": "1528/TALK"    , "narrator": "神楽", "text": "そんな甘ちゃんなんだぴょん"},
        { "location": "1530/SEL"     , "narrator": "", "text": "その方が大変じゃないかな…"},
        { "location": "1531/SEL"     , "narrator": "", "text": "甘くはないと思う"},
        { "location": "1532/ACT"     , "narrator": "", "text": "その方が大変じゃないかな…"},
        { "location": "1533/TALK"    , "narrator": "神楽", "text": "そうかもしれない"},
        { "location": "1534/TALK"    , "narrator": "神楽", "text": "秩序がなくなればエントロピーは増大し"},
        { "location": "1535/TALK"    , "narrator": "神楽", "text": "カタストロフィに向かう"},
        { "location": "1536/TALK"    , "narrator": "神楽", "text": "しかしそれは一種の収束と言える"},
        { "location": "1537/ACT"     , "narrator": "", "text": "甘くはないと思う"},
        { "location": "1538/TALK"    , "narrator": "神楽", "text": "甘いのは"},
        { "location": "1539/TALK"    , "narrator": "神楽", "text": "ハッピーエンドって状態"},
        { "location": "1540/TALK"    , "narrator": "神楽", "text": "その中身は人による"},
        { "location": "1542/TALK"    , "narrator": "神楽", "text": "人には物語が必要な理由は"},
        { "location": "1543/TALK"    , "narrator": "神楽", "text": "秩序と安寧をもたらすため"},
        { "location": "1544/TALK"    , "narrator": "神楽", "text": "それは善き人以外を排除するユートピアなのか"},
        { "location": "1545/TALK"    , "narrator": "神楽", "text": "善意が暴走したディストピアなのか"},
        { "location": "1547/SEL"     , "narrator": "", "text": "どっちを目指すの？"},
        { "location": "1548/SEL"     , "narrator": "", "text": "どっちも嫌だな…"},
        { "location": "1549/SEL"     , "narrator": "", "text": "厨二ワールド炸裂だね！"},
        { "location": "1550/ACT"     , "narrator": "", "text": "どっちを目指すの？"},
        { "location": "1551/TALK"    , "narrator": "神楽", "text": "そんなの"},
        { "location": "1552/TALK"    , "narrator": "神楽", "text": "どっちも願い下げ！"},
        { "location": "1553/ACT"     , "narrator": "", "text": "どっちも嫌だな…"},
        { "location": "1554/TALK"    , "narrator": "神楽", "text": "それが正常な反応ぴょん"},
        { "location": "1555/TALK"    , "narrator": "神楽", "text": "洗脳されていないなら"},
        { "location": "1556/ACT"     , "narrator": "", "text": "厨二ワールド炸裂だね！"},
        { "location": "1557/TALK"    , "narrator": "神楽", "text": "厨二ゴコロのない創作物なんてこの世に存在しない"},
        { "location": "1561/TALK"    , "narrator": "神楽", "text": "そしてぴょんこの出した結論"},
        { "location": "1564/TALK"    , "narrator": "ボイスメール", "text": "コピーアンドペーストの幸福論"},
        { "location": "1576/DIALOG"  , "narrator": "Dialog_GETVoice", "text": "<color=green>【神楽】</color>のボイスメール\n<color=red>【コピーアンドペーストの幸福論】</color>\nをゲットしました！"}
    ]
}
