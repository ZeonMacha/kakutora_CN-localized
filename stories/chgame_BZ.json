        { "location": "656/SCENARIO", "narrator": "", "text": "BZエンディング"},
        { "location": "667/TALK"    , "narrator": "千羽鶴", "text": "ついにここまで\n辿り着いたのね。"},
        { "location": "669/TALK"    , "narrator": "千羽鶴", "text": "これも\n貴方の協力が\nあってこそ。"},
        { "location": "670/SEL"     , "narrator": "", "text": "異様に不気味なんですが"},
        { "location": "671/ACT"     , "narrator": "", "text": "異様に不気味なんですが"},
        { "location": "673/TALK"    , "narrator": "千羽鶴", "text": "大丈夫。\nラストダンジョンだし\nこんなもの。"},
        { "location": "675/TALK"    , "narrator": "千羽鶴", "text": "あ！\nあそこに転がってるのは\nまさに宝玉！"},
        { "location": "676/SEL"     , "narrator": "", "text": "宝玉なのに\n転がってるんすか！"},
        { "location": "677/ACT"     , "narrator": "", "text": "宝玉なのに\n転がってるんすか！"},
        { "location": "680/TALK"    , "narrator": "千羽鶴", "text": "ゲットした。"},
        { "location": "681/SEL"     , "narrator": "", "text": "早っ！"},
        { "location": "682/ACT"     , "narrator": "", "text": "早っ！"},
        { "location": "684/TALK"    , "narrator": "千羽鶴", "text": "こんなところに時間を\n使ってなんか\nいられないもの。"},
        { "location": "685/TALK"    , "narrator": "千羽鶴", "text": "さあ、\n早速この宝玉で、私から\n「非」を取り除くの。"},
        { "location": "686/TALK"    , "narrator": "千羽鶴", "text": "貴方も一緒に\n祈ってほしい。"},
        { "location": "687/TALK"    , "narrator": "千羽鶴", "text": "「非」よ！\n闇の彼方へと\n消えたまへ！！"},
        { "location": "688/SEL"     , "narrator": "", "text": "一緒に祈る"},
        { "location": "689/ACT"     , "narrator": "", "text": "一緒に祈る"},
        { "location": "761/TALK"    , "narrator": "千羽鶴", "text": "やった……！"},
        { "location": "762/TALK"    , "narrator": "千羽鶴", "text": "私、ついにこれで\n『攻略対象』に\nなったのね。"},
        { "location": "763/SEL"     , "narrator": "", "text": "おめでとう！！"},
        { "location": "764/ACT"     , "narrator": "", "text": "おめでとう！！"},
        { "location": "766/TALK"    , "narrator": "千羽鶴", "text": "ありがとう。"},
        { "location": "767/SEL"     , "narrator": "", "text": "それじゃ早速、つき合ってください！"},
        { "location": "768/ACT"     , "narrator": "", "text": "それじゃ早速、つき合ってください！"},
        { "location": "771/TALK"    , "narrator": "千羽鶴", "text": "なんで？"},
        { "location": "772/SEL"     , "narrator": "", "text": "だって、攻略対象でしょ？"},
        { "location": "773/ACT"     , "narrator": "", "text": "だって、攻略対象でしょ？"},
        { "location": "775/TALK"    , "narrator": "千羽鶴", "text": "意味がわからない。\nどうして攻略対象と\nつき合うの？"},
        { "location": "776/SEL"     , "narrator": "", "text": "え？？　そりゃ、攻略対象だから……"},
        { "location": "777/ACT"     , "narrator": "", "text": "え？？　そりゃ、攻略対象だから……"},
        { "location": "779/TALK"    , "narrator": "千羽鶴", "text": "……。"},
        { "location": "780/TALK"    , "narrator": "千羽鶴", "text": "このゲームの名前、\n覚えてる？"},
        { "location": "781/SEL"     , "narrator": "", "text": "『ちーちゃんとラブラブRPGゲーム！』ですよね？"},
        { "location": "782/ACT"     , "narrator": "", "text": "『ちーちゃんとラブラブRPGゲーム！』ですよね？"},
        { "location": "784/TALK"    , "narrator": "千羽鶴", "text": "そう。RPG。"},
        { "location": "785/TALK"    , "narrator": "千羽鶴", "text": "RPGで\n攻略対象といえば？"},
        { "location": "786/SEL"     , "narrator": "", "text": "攻略対象と…いえば…"},
        { "location": "787/ACT"     , "narrator": "", "text": "攻略対象と…いえば…"},
        { "location": "789/TALK"    , "narrator": "千羽鶴", "text": "……。"},
        { "location": "790/TALK"    , "narrator": "千羽鶴", "text": "あとは、記録映像が\n答えを教えてくれる。"},
        { "location": "659/DIALOG"  , "narrator": "INFO", "text": "偉大なる宝玉の城に\n到着した！"},
