    "entry":
    [
        { "location": "451/SCENARIO", "narrator": "", "text": "ディストピアという愛の園"},
        { "location": "476/TALK"    , "narrator": "神楽", "text": "今回は愛について語り合いたいと思う"},
        { "location": "478/SEL"     , "narrator": "", "text": "早くもネタ切れ？"},
        { "location": "479/SEL"     , "narrator": "", "text": "$me$の愛は語り尽くせない"},
        { "location": "480/SEL"     , "narrator": "", "text": "もっと硬派な話題はないの？"},
        { "location": "481/ACT"     , "narrator": "", "text": "早くもネタ切れ？"},
        { "location": "482/TALK"    , "narrator": "神楽", "text": "最重要課題を軽く見ると後悔しますよ？"},
        { "location": "483/ACT"     , "narrator": "", "text": "$me$の愛は語り尽くせない"},
        { "location": "485/TALK"    , "narrator": "神楽", "text": "イイネイイネ"},
        { "location": "487/TALK"    , "narrator": "神楽", "text": "そういうの好き"},
        { "location": "488/TALK"    , "narrator": "神楽", "text": "よーし朝まで語っちゃお♪"},
        { "location": "489/ACT"     , "narrator": "", "text": "もっと硬派な話題はないの？"},
        { "location": "490/TALK"    , "narrator": "神楽", "text": "ない"},
        { "location": "492/TALK"    , "narrator": "神楽", "text": "ところで純粋に疑問なんだけど"},
        { "location": "493/TALK"    , "narrator": "神楽", "text": "生まれた時から愛を受け続けてきた人間と、全く与えられなかった人間"},
        { "location": "494/TALK"    , "narrator": "神楽", "text": "人からの愛を受け止めることができるのは圧倒的に前者なのはどうしてなんだろう"},
        { "location": "495/TALK"    , "narrator": "神楽", "text": "後者の方がどう考えても絶対量が不足しているはずなのにね"},
        { "location": "497/SEL"     , "narrator": "", "text": "慣れてないんだよ"},
        { "location": "498/SEL"     , "narrator": "", "text": "身につまされるな、、、"},
        { "location": "499/SEL"     , "narrator": "", "text": "本当はわかってて聞いてるでしょ"},
        { "location": "500/ACT"     , "narrator": "", "text": "慣れてないんだよ"},
        { "location": "501/TALK"    , "narrator": "神楽", "text": "愛にも練度と訓練が必要"},
        { "location": "503/TALK"    , "narrator": "神楽", "text": "世知辛い"},
        { "location": "504/ACT"     , "narrator": "", "text": "身につまされるな、、、"},
        { "location": "505/TALK"    , "narrator": "神楽", "text": "$handlek$にはぴょんこがいるぴょん"},
        { "location": "506/TALK"    , "narrator": "神楽", "text": "でしょ？"},
        { "location": "507/ACT"     , "narrator": "", "text": "本当はわかってて聞いてるでしょ"},
        { "location": "509/TALK"    , "narrator": "神楽", "text": "まあそうだけど"},
        { "location": "510/TALK"    , "narrator": "神楽", "text": "$handlek$との共通認識を作っておきたいわけですしー"},
        { "location": "511/TALK"    , "narrator": "神楽", "text": "そういうのもひとつの愛の証"},
        { "location": "512/TALK"    , "narrator": "神楽", "text": "違う？"},
        { "location": "514/TALK"    , "narrator": "神楽", "text": "そう考えてゆくと"},
        { "location": "515/TALK"    , "narrator": "神楽", "text": "セカイの中心で愛を叫んだりできるのは元々愛を知っているか"},
        { "location": "516/TALK"    , "narrator": "神楽", "text": "あるいは別の何かを愛だと錯覚しているかのどちらか"},
        { "location": "517/TALK"    , "narrator": "神楽", "text": "どちらが幸せなのかは"},
        { "location": "518/TALK"    , "narrator": "神楽", "text": "神のみぞ知る"}
    ]
}
