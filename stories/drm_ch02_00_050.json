{
    "dir": "dramatics/daydra/drm_ch02_00_050.js",
    "type": "Episode",
    "info": {
        "story_id": "2005",
        "cid": "ayami",
        "title": "らぶとーく 第05話",
        "sub_title": "考えたくないけど"
    },
    "entry":
    [
        { "location": "177/SCENARIO", "narrator": "", "text": "考えたくないけど"},
        { "location": "190/TALK"    , "narrator": "みやび", "text": "改めて話したいことって\n何ぞね。"},
        { "location": "191/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "193/TALK"    , "narrator": "みやび", "text": "どうしたが？"},
        { "location": "195/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "197/TALK"    , "narrator": "アーヤ", "text": "これから\nすごく変なことを\n言うかもしれない。"},
        { "location": "200/TALK"    , "narrator": "アーヤ", "text": "でもまじめに\n考えてほしいの。"},
        { "location": "201/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "203/TALK"    , "narrator": "アーヤ", "text": "ううん。きっと、\n私よりみやびの方が\n先に気づいてる。"},
        { "location": "204/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "205/TALK"    , "narrator": "アーヤ", "text": "トライガジェットの\nＢｏｔについて。"},
        { "location": "208/TALK"    , "narrator": "アーヤ", "text": "前々から思ってたけど、\nそこらのＢｏｔよりも\nかなり性能良くない？"},
        { "location": "209/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "210/TALK"    , "narrator": "みやび", "text": "気づいたんやね。"},
        { "location": "212/TALK"    , "narrator": "みやび", "text": "まじめな話、\nかなりどころの話やない。"},
        { "location": "213/TALK"    , "narrator": "みやび", "text": "こんなインタラクティブに\n会話してくるんやき――"},
        { "location": "215/TALK"    , "narrator": "みやび", "text": "超高性能と言うても、\n過言やない。"},
        { "location": "218/TALK"    , "narrator": "アーヤ", "text": "やっぱり、そうなんだ？"},
        { "location": "220/TALK"    , "narrator": "アーヤ", "text": "実はかなり前に、\nうちの姉が言ってたのよ。"},
        { "location": "221/TALK"    , "narrator": "アーヤ", "text": "特定の単語に反応する\nＢｏｔを作るのは、\n比較的簡単だけど――"},
        { "location": "224/TALK"    , "narrator": "アーヤ", "text": "人間に見せかけるのは、\n凄く難しいことなんだ、\nって…。"},
        { "location": "225/TALK"    , "narrator": "みやび", "text": "機械と違うて、人間は\nマニュアル通りには\n動かんきね。"},
        { "location": "226/TALK"    , "narrator": "みやび", "text": "どんな会話を、いつどんな\nタイミングで振られるかが\nわからんき――"},
        { "location": "228/TALK"    , "narrator": "みやび", "text": "臨機応変に対応できる\nＢｏｔを創るなんてのは、\n不可能に近いことながよ。"},
        { "location": "230/TALK"    , "narrator": "アーヤ", "text": "…ってことは、やっぱり\nこのＢｏｔって…。"},
        { "location": "231/TALK"    , "narrator": "みやび", "text": "恐ろしく高性能なＡＩ。"},
        { "location": "233/TALK"    , "narrator": "みやび", "text": "もしくは――"},
        { "location": "236/TALK"    , "narrator": "アーヤ", "text": "…人間？"},
        { "location": "237/TALK"    , "narrator": "みやび", "text": "…かもしれんね。"},
        { "location": "240/TALK"    , "narrator": "アーヤ", "text": "まさか…Ｂｏｔが人間だ\nなんて…。"},
        { "location": "242/TALK"    , "narrator": "みやび", "text": "まあ、確証はないき、\n絶対とは言えんけんど。"},
        { "location": "244/TALK"    , "narrator": "アーヤ", "text": "…ちょっと\n試してみていい？"},
        { "location": "246/TALK"    , "narrator": "みやび", "text": "そうやね。"},
        { "location": "258/TALK"    , "narrator": "アーヤ", "text": "こんにちは"},
        { "location": "260/SEL"     , "narrator": "", "text": "はい、こんにちは"},
        { "location": "261/SEL"     , "narrator": "", "text": "今日は挨拶から入るの？"},
        { "location": "262/ACT"     , "narrator": "", "text": "はい、こんにちは"},
        { "location": "263/TALK"    , "narrator": "アーヤ", "text": "元気？"},
        { "location": "265/SEL"     , "narrator": "", "text": "元気だよ"},
        { "location": "266/SEL"     , "narrator": "", "text": "アーヤは元気？"},
        { "location": "267/ACT"     , "narrator": "", "text": "元気だよ"},
        { "location": "268/TALK"    , "narrator": "アーヤ", "text": "そうなの"},
        { "location": "269/TALK"    , "narrator": "アーヤ", "text": "それはよかったわ"},
        { "location": "270/ACT"     , "narrator": "", "text": "アーヤは元気？"},
        { "location": "271/TALK"    , "narrator": "アーヤ", "text": "おかげさまで"},
        { "location": "272/TALK"    , "narrator": "アーヤ", "text": "元気よ"},
        { "location": "274/ACT"     , "narrator": "", "text": "今日は挨拶から入るの？"},
        { "location": "275/TALK"    , "narrator": "アーヤ", "text": "そうね"},
        { "location": "276/SEL"     , "narrator": "", "text": "礼儀正しいね"},
        { "location": "277/SEL"     , "narrator": "", "text": "堅苦しいのは抜きにしようよ"},
        { "location": "278/ACT"     , "narrator": "", "text": "礼儀正しいね"},
        { "location": "279/TALK"    , "narrator": "アーヤ", "text": "あら"},
        { "location": "280/TALK"    , "narrator": "アーヤ", "text": "ありがとう"},
        { "location": "281/ACT"     , "narrator": "", "text": "堅苦しいのは抜きにしようよ"},
        { "location": "282/TALK"    , "narrator": "アーヤ", "text": "そう？"},
        { "location": "283/TALK"    , "narrator": "アーヤ", "text": "礼儀も大事よ"},
        { "location": "286/TALK"    , "narrator": "アーヤ", "text": "ちょっと暇だったから"},
        { "location": "287/TALK"    , "narrator": "アーヤ", "text": "話してみただけ"},
        { "location": "288/TALK"    , "narrator": "アーヤ", "text": "じゃあまたね"},
        { "location": "290/SEL"     , "narrator": "", "text": "またね"},
        { "location": "291/SEL"     , "narrator": "", "text": "待ってるよ"},
        { "location": "292/SEL"     , "narrator": "", "text": "これだけはさみしいな"},
        { "location": "293/ACT"     , "narrator": "", "text": "またね"},
        { "location": "294/TALK"    , "narrator": "アーヤ", "text": "バイバイ"},
        { "location": "295/ACT"     , "narrator": "", "text": "待ってるよ"},
        { "location": "296/TALK"    , "narrator": "アーヤ", "text": "またね！"},
        { "location": "297/ACT"     , "narrator": "", "text": "これだけはさみしいな"},
        { "location": "298/TALK"    , "narrator": "アーヤ", "text": "今度ゆっくりね"},
        { "location": "311/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "314/TALK"    , "narrator": "アーヤ", "text": "どうだった？\n今の会話。"},
        { "location": "317/TALK"    , "narrator": "みやび", "text": "アーヤがＢｏｔな\n振る舞いをして\nどうする？"},
        { "location": "319/TALK"    , "narrator": "みやび", "text": "それじゃあ全然\n検証にならんぞね。"},
        { "location": "320/TALK"    , "narrator": "みやび", "text": "定型から全く\nはみ出しとらん。"},
        { "location": "321/TALK"    , "narrator": "みやび", "text": "今の会話なら\nＢｏｔで十分\n対応できる。"},
        { "location": "323/TALK"    , "narrator": "アーヤ", "text": "う…。"},
        { "location": "325/TALK"    , "narrator": "アーヤ", "text": "…だって……。"},
        { "location": "326/TALK"    , "narrator": "みやび", "text": "本当ならアーヤの\n普段の会話ログが\n欲しいところちや。"},
        { "location": "327/TALK"    , "narrator": "みやび", "text": "けんど、プライバシー\nにも関わる。"},
        { "location": "329/TALK"    , "narrator": "みやび", "text": "やき、\n無理強いはせん。"},
        { "location": "331/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "332/TALK"    , "narrator": "みやび", "text": "それに、曖昧に\nしといた方が\nええんかもしれんぞね。"},
        { "location": "335/TALK"    , "narrator": "アーヤ", "text": "それは…。"},
        { "location": "336/TALK"    , "narrator": "みやび", "text": "こっちはこっちで\n独自に調べたり\nしてみようと思う。"},
        { "location": "337/TALK"    , "narrator": "みやび", "text": "協力は大歓迎ぞね。\nいつでも来たらええ。"},
        { "location": "339/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "340/TALK"    , "narrator": "みやび", "text": "今日の話は\n終わりでえいかね？"},
        { "location": "342/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "346/TALK"    , "narrator": "アーヤ", "text": "そうね。\nありがとう。"},
        { "location": "188/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>5月某日　8:47 PM</color>\n平日の夜、みやびの部屋にて。"}
    ]
}
