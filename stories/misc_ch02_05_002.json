    "entry":
    [
        { "location": "160/SCENARIO", "narrator": "", "text": "002_スーパーマーケット"},
        { "location": "185/TALK"    , "narrator": "アーヤ", "text": "ルバーブが売ってないのよ"},
        { "location": "186/TALK"    , "narrator": "アーヤ", "text": "高級スーパーでジャムをやっと蜜けたけど"},
        { "location": "188/TALK"    , "narrator": "アーヤ", "text": "高くてびっくりしたわよ(--#)"},
        { "location": "189/SEL"     , "narrator": "", "text": "ルバーブって何"},
        { "location": "190/SEL"     , "narrator": "", "text": "なるほど"},
        { "location": "191/SEL"     , "narrator": "", "text": "ジャム買えば"},
        { "location": "192/TALK"    , "narrator": "アーヤ", "text": "なんなのかしらあれ(￣Д￣ )"},
        { "location": "193/TALK"    , "narrator": "アーヤ", "text": "ほんとはそんなに好きでもないんだけど"},
        { "location": "194/TALK"    , "narrator": "アーヤ", "text": "食べられないてなると食べたくなるから(-ω-;)"},
        { "location": "195/TALK"    , "narrator": "アーヤ", "text": "困ったわー"},
        { "location": "203/ACT"     , "narrator": "", "text": "ルバーブって何"},
        { "location": "204/TALK"    , "narrator": "アーヤ", "text": "やっぱりそうなの＼(◎o◎)／"},
        { "location": "207/TALK"    , "narrator": "アーヤ", "text": "野菜"},
        { "location": "210/TALK"    , "narrator": "アーヤ", "text": "多分"},
        { "location": "211/ACT"     , "narrator": "", "text": "なるほど"},
        { "location": "212/TALK"    , "narrator": "アーヤ", "text": "ええと"},
        { "location": "214/TALK"    , "narrator": "アーヤ", "text": "わかってるのかな(´o｀；？"},
        { "location": "215/TALK"    , "narrator": "アーヤ", "text": "何の話か"},
        { "location": "216/ACT"     , "narrator": "", "text": "ジャム買えば"},
        { "location": "217/TALK"    , "narrator": "アーヤ", "text": "だから高いのよ(--#)"},
        { "location": "218/TALK"    , "narrator": "アーヤ", "text": "ありえないくらいに"},
        { "location": "227/TALK"    , "narrator": "アーヤ", "text": "ルバーブってね"},
        { "location": "228/TALK"    , "narrator": "アーヤ", "text": "赤い茎の草っていうか野菜があるのよ"},
        { "location": "229/TALK"    , "narrator": "アーヤ", "text": "茎のところを甘く似てジャムにしたりパイのフィリングにしたりするの"},
        { "location": "230/TALK"    , "narrator": "アーヤ", "text": "煮て"},
        { "location": "232/SEL"     , "narrator": "", "text": "おいしそうだね"},
        { "location": "233/SEL"     , "narrator": "", "text": "え…何それ…"},
        { "location": "234/SEL"     , "narrator": "", "text": "外国映画で見た気がする"},
        { "location": "235/ACT"     , "narrator": "", "text": "おいしそうだね"},
        { "location": "236/TALK"    , "narrator": "アーヤ", "text": "まあおいしいかな"},
        { "location": "237/TALK"    , "narrator": "アーヤ", "text": "甘いの好きな人だったら結構好きかもね"},
        { "location": "238/ACT"     , "narrator": "", "text": "え…何それ…"},
        { "location": "239/TALK"    , "narrator": "アーヤ", "text": "工ｴｴｪｪ(´д｀)ｪｪｴｴ工"},
        { "location": "241/TALK"    , "narrator": "アーヤ", "text": "なにその反応(--*;"},
        { "location": "242/ACT"     , "narrator": "", "text": "外国映画で見た気がする"},
        { "location": "252/TALK"    , "narrator": "アーヤ", "text": "あっ、そうね"},
        { "location": "253/TALK"    , "narrator": "アーヤ", "text": "アメリカだと家庭料理でルバーブのパイ作るみたいだし"},
        { "location": "254/TALK"    , "narrator": "アーヤ", "text": "ガブも知ってた"},
        { "location": "256/TALK"    , "narrator": "アーヤ", "text": "そろそろ道の駅とかで売ってそうなんだけど"},
        { "location": "257/TALK"    , "narrator": "アーヤ", "text": "それだけのために寄生するのもね"},
        { "location": "258/TALK"    , "narrator": "アーヤ", "text": "ぎゃ"},
        { "location": "259/TALK"    , "narrator": "アーヤ", "text": "帰省ね！！！！！"},
        { "location": "262/TALK"    , "narrator": "アーヤ", "text": "東京で売ってないのかなー？"},
        { "location": "265/SEL"     , "narrator": "", "text": "見つかるといいね"},
        { "location": "266/SEL"     , "narrator": "", "text": "無理かも"},
        { "location": "267/SEL"     , "narrator": "", "text": "栽培するのはどう"},
        { "location": "268/ACT"     , "narrator": "", "text": "見つかるといいね"},
        { "location": "278/TALK"    , "narrator": "アーヤ", "text": "ねー(>_<)"},
        { "location": "279/TALK"    , "narrator": "アーヤ", "text": "見つかるよう祈ってて(^з^)-☆"},
        { "location": "280/ACT"     , "narrator": "", "text": "無理かも"},
        { "location": "281/TALK"    , "narrator": "アーヤ", "text": "かなー(T_T)"},
        { "location": "282/TALK"    , "narrator": "アーヤ", "text": "でも希望は持っておくわ(; ;)"},
        { "location": "283/ACT"     , "narrator": "", "text": "栽培するのはどう"},
        { "location": "284/TALK"    , "narrator": "アーヤ", "text": "その手があったか！"},
        { "location": "285/TALK"    , "narrator": "アーヤ", "text": "って、ないから(--#)"},
        { "location": "287/TALK"    , "narrator": "アーヤ", "text": "もー(｀ヘ´) "},
        { "location": "248/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"},
        { "location": "274/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"}
