{
    "dir": "chap19/daydra/dd_ch03_19_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "19352",
        "cid": "gabriella",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "岩場の洞窟"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "岩場の洞窟"},
        { "location": "18/TALK"   , "narrator": "ガブリエラ", "text": "えっと、水着とタオル、\nそれと懐中電灯、と…。"},
        { "location": "20/TALK"   , "narrator": "ガブリエラ", "text": "うん、準備ＯＫ！"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "$marzanna$、今日は面白いところに連れて行ってあげるわ"},
        { "location": "34/SEL"    , "narrator": "", "text": "どこに行くつもりなの？"},
        { "location": "35/ACT"    , "narrator": "", "text": "どこに行くつもりなの？"},
        { "location": "37/TALK"   , "narrator": "ガブリエラ", "text": "ネットで調べてて見つけたの"},
        { "location": "38/TALK"   , "narrator": "ガブリエラ", "text": "この近くに岩場になってる海岸があるんだけど"},
        { "location": "39/TALK"   , "narrator": "ガブリエラ", "text": "そこにね、見つけ辛いけど、綺麗な洞窟があるらしいの"},
        { "location": "40/TALK"   , "narrator": "ガブリエラ", "text": "どう、面白そうでしょ？"},
        { "location": "42/SEL"    , "narrator": "", "text": "一人で行くの？"},
        { "location": "43/ACT"    , "narrator": "", "text": "一人で行くの？"},
        { "location": "45/TALK"   , "narrator": "ガブリエラ", "text": "$marzanna$がいるから、一人じゃないわ"},
        { "location": "46/TALK"   , "narrator": "ガブリエラ", "text": "まあ、ちょっとは不安だけど…"},
        { "location": "48/TALK"   , "narrator": "ガブリエラ", "text": "でも、危ないことするわけじゃないし、平気よ"},
        { "location": "50/SEL"    , "narrator": "", "text": "誰か誘った方が良い"},
        { "location": "51/SEL"    , "narrator": "", "text": "洞窟の怪談話を知ってる"},
        { "location": "52/SEL"    , "narrator": "", "text": "ちょっとした冒険だね"},
        { "location": "53/ACT"    , "narrator": "", "text": "誰か誘った方が良い"},
        { "location": "54/TALK"   , "narrator": "ガブリエラ", "text": "もぅ、$marzanna$は心配性なんだから"},
        { "location": "65/TALK"   , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "66/TALK"   , "narrator": "ガブリエラ", "text": "でも、もしものことも\n考えて、やっぱり誰か\n誘おうかしら？"},
        { "location": "68/TALK"   , "narrator": "ガブリエラ", "text": "…つばめ、神楽。\n今日は海に行くの？"},
        { "location": "71/TALK"   , "narrator": "つばめ", "text": "うん、午前中だけ泳ぎに\n行こうと思うんだ。"},
        { "location": "74/TALK"   , "narrator": "神楽", "text": "今日は一段と暑いから、\nきっと気持ちいいと\n思うんです。"},
        { "location": "75/TALK"   , "narrator": "ガブリエラ", "text": "そう…それなら、\nちょっとだけ遠くの\n岩場に行ってみない？"},
        { "location": "76/TALK"   , "narrator": "神楽", "text": "えっ、岩場ですか？"},
        { "location": "78/TALK"   , "narrator": "ガブリエラ", "text": "ネットで見つけたん\nだけど、綺麗な洞窟が\nあるらしいの。"},
        { "location": "79/TALK"   , "narrator": "ガブリエラ", "text": "興味あるなら、\n二人も一緒にどう？"},
        { "location": "80/TALK"   , "narrator": "つばめ", "text": "わぁ、楽しそうだよ\n卯月さん！"},
        { "location": "81/TALK"   , "narrator": "つばめ", "text": "一緒に行くよ。\nどんな洞窟なのか\n見てみたいな。"},
        { "location": "82/TALK"   , "narrator": "ガブリエラ", "text": "ん、つばめは決まりね。\n神楽はどうする？"},
        { "location": "83/TALK"   , "narrator": "神楽", "text": "絶対行きません！"},
        { "location": "84/TALK"   , "narrator": "ガブリエラ", "text": "え、何でよ？"},
        { "location": "85/TALK"   , "narrator": "神楽", "text": "だって、岩場ですよね？\nおまけに洞窟なんて――"},
        { "location": "86/TALK"   , "narrator": "神楽", "text": "フナ虫とコウモリが\nウジャウジャいそうじゃ\nないですか。"},
        { "location": "88/TALK"   , "narrator": "つばめ", "text": "ふ、フナ虫！？"},
        { "location": "89/TALK"   , "narrator": "ガブリエラ", "text": "ちょ！？　神楽！\nあんた何てこと言うのよ！"},
        { "location": "90/TALK"   , "narrator": "神楽", "text": "だって、本当のことじゃ\nないですか。"},
        { "location": "92/TALK"   , "narrator": "神楽", "text": "私は遠慮します。\nフナ虫もコウモリも\n苦手なので。"},
        { "location": "93/TALK"   , "narrator": "つばめ", "text": "…………。"},
        { "location": "94/TALK"   , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "96/TALK"   , "narrator": "つばめ", "text": "が、ガブちゃん…\nわたしも、フナ虫は\nちょっと苦手で…。"},
        { "location": "97/TALK"   , "narrator": "ガブリエラ", "text": "わかってる。\nあたしも、もう行く気が\n失せちゃったわ…。"},
        { "location": "99/TALK"   , "narrator": "神楽", "text": "砂浜が一番ですよ。\n岩場より、そっちの方が\n安心です。"},
        { "location": "100/ACT"   , "narrator": "", "text": "洞窟の怪談話を知ってる"},
        { "location": "101/TALK"  , "narrator": "ガブリエラ", "text": "どうしてそういうこと言うの！？"},
        { "location": "103/TALK"  , "narrator": "ガブリエラ", "text": "そんなこと言われたら、行く気なくなっちゃうじゃない…"},
        { "location": "104/TALK"  , "narrator": "ガブリエラ", "text": "もう、$marzanna$のバカ！"},
        { "location": "115/TALK"  , "narrator": "ガブリエラ", "text": "…せっかく楽しみに\nしてたのに。"},
        { "location": "117/TALK"  , "narrator": "つばめ", "text": "あっ、ガブちゃん。\nこれから海に行くん\nだけど――"},
        { "location": "118/TALK"  , "narrator": "ガブリエラ", "text": "行かない！\n今日は一日家にいるわ！"},
        { "location": "119/TALK"  , "narrator": "つばめ", "text": "そ、そっか…。"},
        { "location": "121/TALK"  , "narrator": "つばめ", "text": "なんか、機嫌悪いみたい。\n何かあったのかな？"},
        { "location": "122/ACT"   , "narrator": "", "text": "ちょっとした冒険だね"},
        { "location": "124/TALK"  , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "125/TALK"  , "narrator": "ガブリエラ", "text": "冒険って言われたら、ワクワクしてきちゃった"},
        { "location": "126/TALK"  , "narrator": "ガブリエラ", "text": "準備に戻るわね"},
        { "location": "138/TALK"  , "narrator": "ガブリエラ", "text": "ふふっ…素敵なところだと\n良いな…。"},
        { "location": "170/TALK"  , "narrator": "ガブリエラ", "text": "えっと…確かここを\nもう少し進むと――"},
        { "location": "172/TALK"  , "narrator": "雛", "text": "うわぁぁぁぁぁっ！？\nふ、フナ虫！！\n海のゴキブリ！！"},
        { "location": "174/TALK"  , "narrator": "キリト", "text": "おいおい、騒ぎ過ぎだろ？\n別に噛みつきゃしねぇん\nだぞ？"},
        { "location": "177/TALK"  , "narrator": "雛", "text": "気持ち悪いじゃん！！\nうわっ、こっちにも！？"},
        { "location": "179/TALK"  , "narrator": "ヒカル", "text": "ヒナコさん、こっちの方は\nいないみたいですよ。"},
        { "location": "181/TALK"  , "narrator": "キリト", "text": "ったく、フナ虫が怖いのに\n岩場に来るからこうなるん\nだよ。"},
        { "location": "183/TALK"  , "narrator": "雛", "text": "怖いんじゃなくて\n気持ち悪いの！"},
        { "location": "186/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "188/TALK"  , "narrator": "雛", "text": "ねえ、ガブリエラちゃん。\n早く洞窟行こうよー。"},
        { "location": "189/TALK"  , "narrator": "雛", "text": "ここは虫だらけで\n落ち着けないよ…。"},
        { "location": "191/TALK"  , "narrator": "ガブリエラ", "text": "知らないわよ。\nっていうか、勝手について\n来たのはあんた達でしょ？"},
        { "location": "192/TALK"  , "narrator": "雛", "text": "だって、一人でどこかに\n行くのが見えたから――"},
        { "location": "193/TALK"  , "narrator": "雛", "text": "またみんなとケンカして、\n居づらくなっちゃったの\nかなぁ、って――"},
        { "location": "194/TALK"  , "narrator": "雛", "text": "優しいお姉さんは、\n心配になっちゃったん\nだよ。"},
        { "location": "198/TALK"  , "narrator": "ガブリエラ", "text": "勘違いってわかったん\nだから、もう帰って\nいいのに…。"},
        { "location": "201/TALK"  , "narrator": "キリト", "text": "洞窟探検なんて楽しそうな\nことするのわかってて、\n帰れるわけねぇだろ、な？"},
        { "location": "203/TALK"  , "narrator": "ヒカル", "text": "そうですね。\n綺麗な洞窟という\nことなので――"},
        { "location": "204/TALK"  , "narrator": "ヒカル", "text": "ガブリエラさんさえ\n良ければ、ご一緒させて\nもらえませんか？"},
        { "location": "206/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "207/TALK"  , "narrator": "雛", "text": "というわけ。"},
        { "location": "208/TALK"  , "narrator": "雛", "text": "まあ、どうしても\n一人で行きたい、って\n言うなら――"},
        { "location": "209/TALK"  , "narrator": "雛", "text": "あたし達はこのまま\n帰るけど…。"},
        { "location": "211/TALK"  , "narrator": "ガブリエラ", "text": "…別に、付いてきたいなら\n構わないけど――"},
        { "location": "212/TALK"  , "narrator": "ガブリエラ", "text": "ただ、あたしもどういう\n場所なのか、よく知らない\nから――"},
        { "location": "213/TALK"  , "narrator": "ガブリエラ", "text": "しょぼかったりしても、\n責任取れないわよ？"},
        { "location": "215/TALK"  , "narrator": "雛", "text": "了解であります、隊長！"},
        { "location": "218/TALK"  , "narrator": "キリト", "text": "おっ、隊長隊長！\n前方にそれらしい穴が\n見えるぜ！"},
        { "location": "220/TALK"  , "narrator": "ガブリエラ", "text": "あれは…ネットで見た\n写真に似てるかも…。"},
        { "location": "221/TALK"  , "narrator": "雛", "text": "あそこでいいの、隊長？"},
        { "location": "222/TALK"  , "narrator": "ガブリエラ", "text": "ええ、間違いないわ。\n急ぎましょ！"},
        { "location": "223/TALK"  , "narrator": "雛", "text": "あ、待って隊長！"},
        { "location": "225/TALK"  , "narrator": "ガブリエラ", "text": "っていうか、\n隊長っていうのやめて！"},
        { "location": "226/TALK"  , "narrator": "雛", "text": "了解であります、隊長！"},
        { "location": "228/TALK"  , "narrator": "ガブリエラ", "text": "…まったく。"},
        { "location": "270/TALK"  , "narrator": "キリト", "text": "おおっ、すげぇ！！\nなんだここ！？"},
        { "location": "271/TALK"  , "narrator": "ヒカル", "text": "洞窟の中が、ちょっとした\n砂浜になってるんですね。"},
        { "location": "272/TALK"  , "narrator": "ヒカル", "text": "岩場だらけの中に、\nまさかこんな場所が\nあるなんて…。"},
        { "location": "274/TALK"  , "narrator": "雛", "text": "凄いよガブリエラちゃん！\nここ最高だよー！"},
        { "location": "276/TALK"  , "narrator": "雛", "text": "なんか秘密基地みたいで、\n超テンション上がるね！"},
        { "location": "278/TALK"  , "narrator": "ガブリエラ", "text": "…そうね。"},
        { "location": "281/TALK"  , "narrator": "キリト", "text": "ん？　なんかテンション\n低くねぇか？"},
        { "location": "282/TALK"  , "narrator": "雛", "text": "もしかして、あんまり\n気に入ってないの？"},
        { "location": "283/TALK"  , "narrator": "ガブリエラ", "text": "あ、ううん。\nそうじゃないの。"},
        { "location": "285/TALK"  , "narrator": "ガブリエラ", "text": "秘密基地みたいで、\nあたしも凄く良いところ\nだとは思ってるけど――"},
        { "location": "288/TALK"  , "narrator": "ガブリエラ", "text": "ちょっと、想像してたの\nとは違ったから…。"},
        { "location": "289/TALK"  , "narrator": "雛", "text": "どんなの想像してたの？"},
        { "location": "290/TALK"  , "narrator": "ガブリエラ", "text": "青の洞窟みたいなのよ。"},
        { "location": "293/TALK"  , "narrator": "キリト", "text": "青の洞窟？"},
        { "location": "295/TALK"  , "narrator": "ヒカル", "text": "陽の光が反射することで、\n洞窟内の海水が――"},
        { "location": "296/TALK"  , "narrator": "ヒカル", "text": "綺麗な青色に見える\n洞窟があるんですよ。"},
        { "location": "298/TALK"  , "narrator": "キリト", "text": "…なんか、テレビで見た\nことある気がするけど、\nそりゃ期待し過ぎだろ。"},
        { "location": "301/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "303/TALK"  , "narrator": "キリト", "text": "…でもまあ、ここだって\nすっげぇ良い洞窟だと\n思うけどな。"},
        { "location": "304/TALK"  , "narrator": "キリト", "text": "雛も言ってたけど、\n秘密基地みたいだし。"},
        { "location": "305/TALK"  , "narrator": "雛", "text": "ね？　ね？\nテンションめっちゃ\n上がるよね！？"},
        { "location": "307/TALK"  , "narrator": "雛", "text": "それに、ここに来るまでも\n超楽しかったし。"},
        { "location": "308/TALK"  , "narrator": "ヒカル", "text": "同感です。"},
        { "location": "309/TALK"  , "narrator": "ヒカル", "text": "連れてきていただいて、\nありがとうございます。\n隊ちょ――"},
        { "location": "312/TALK"  , "narrator": "ガブリエラ", "text": "っ！？"},
        { "location": "314/TALK"  , "narrator": "ヒカル", "text": "あ、すみません！\nガブリエラさん…。"},
        { "location": "315/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "318/TALK"  , "narrator": "ガブリエラ", "text": "まあ、楽しかったから\nそれで良いか…。"},
        { "location": "17/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>8月22日　10:23 AM</color>\n合宿中、みやびの実家にて"}
    ]
}
