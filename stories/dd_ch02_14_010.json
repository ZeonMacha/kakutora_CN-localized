{
    "dir": "chap14/daydra/dd_ch02_14_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "14252",
        "cid": "ayami",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "國政綾水とひなこさん"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "アーヤＭＶ回１"},
        { "location": "21/TALK"   , "narrator": "ガブリエラ", "text": "はぁ、お腹空いた…。"},
        { "location": "23/TALK"   , "narrator": "アーヤ", "text": "ふふっ、大丈夫？"},
        { "location": "25/TALK"   , "narrator": "ガブリエラ", "text": "ええ…でも、午前中に\n体育があると、\nお腹空いて困るわ…。"},
        { "location": "26/TALK"   , "narrator": "アーヤ", "text": "じゃあ、早いとこ\n学食行きましょ。"},
        { "location": "27/TALK"   , "narrator": "雛", "text": "あっ！"},
        { "location": "30/TALK"   , "narrator": "雛", "text": "こんにちは、綾水様。\nガブリエラちゃん。"},
        { "location": "32/TALK"   , "narrator": "アーヤ", "text": "あら、日向さん。"},
        { "location": "34/TALK"   , "narrator": "ガブリエラ", "text": "ん…どうしたの？\nお弁当は？"},
        { "location": "35/TALK"   , "narrator": "雛", "text": "えへへ…実は家に\n忘れてきちゃった\nから――"},
        { "location": "36/TALK"   , "narrator": "雛", "text": "今日はあたしだけ、\n学食でお昼なんだー。"},
        { "location": "37/TALK"   , "narrator": "ガブリエラ", "text": "抜けてるわねぇ。"},
        { "location": "38/TALK"   , "narrator": "雛", "text": "いやー、ちゃんと\nカバン入れたと\n思ったんだけどねー。"},
        { "location": "39/TALK"   , "narrator": "アーヤ", "text": "災難だったわね。"},
        { "location": "40/TALK"   , "narrator": "アーヤ", "text": "私たちも、これから\n学食でお昼にするとこ\nなんだけど――"},
        { "location": "41/TALK"   , "narrator": "アーヤ", "text": "よかったら、\n日向さんも一緒に\nどう？"},
        { "location": "42/TALK"   , "narrator": "雛", "text": "いいんですか！？"},
        { "location": "44/TALK"   , "narrator": "アーヤ", "text": "もちろん。\nね、ギャヴィ？"},
        { "location": "46/TALK"   , "narrator": "ガブリエラ", "text": "はぁ…仕方ないわね。"},
        { "location": "47/TALK"   , "narrator": "ガブリエラ", "text": "本当は、アーヤと\nお話しながら\n食べたかったのに…。"},
        { "location": "48/TALK"   , "narrator": "雛", "text": "やったー！\nお弁当忘れて\n幸運でしたよー！"},
        { "location": "49/TALK"   , "narrator": "雛", "text": "っていうか、一人で\n食べるの寂しいな、\nって思ってたから――"},
        { "location": "50/TALK"   , "narrator": "雛", "text": "本当嬉しいです！"},
        { "location": "52/TALK"   , "narrator": "ガブリエラ", "text": "はいはい、そういうの\nいいから行くわよ。"},
        { "location": "70/TALK"   , "narrator": "雛", "text": "…………。"},
        { "location": "73/TALK"   , "narrator": "アーヤ", "text": "日向さん。\n早く食べないと\n冷めちゃうわよ？"},
        { "location": "76/TALK"   , "narrator": "雛", "text": "あ、はい！\nすぐに食べ――"},
        { "location": "77/TALK"   , "narrator": "雛", "text": "熱っ！？"},
        { "location": "79/TALK"   , "narrator": "ガブリエラ", "text": "何やってんのよ。\nってか、もしかして\n緊張してない？"},
        { "location": "82/TALK"   , "narrator": "雛", "text": "あ、あはは…。\nちょっとねー。"},
        { "location": "83/TALK"   , "narrator": "アーヤ", "text": "そんな知らない仲でも\nないのに。"},
        { "location": "85/TALK"   , "narrator": "雛", "text": "そ、そうなんです\nけど、その…。"},
        { "location": "87/TALK"   , "narrator": "ガブリエラ", "text": "…本当、こういうとこ\n鈍感よね。"},
        { "location": "88/TALK"   , "narrator": "ガブリエラ", "text": "ひなこが緊張してる\n理由なんて――"},
        { "location": "89/TALK"   , "narrator": "ガブリエラ", "text": "アーヤと話してるから\n以外にないじゃない。"},
        { "location": "90/TALK"   , "narrator": "ガブリエラ", "text": "…でも、さっきまでは\n平気じゃなかった？"},
        { "location": "92/TALK"   , "narrator": "雛", "text": "うーん…ほら、\nこういう時って\nいつもは――"},
        { "location": "93/TALK"   , "narrator": "雛", "text": "つばめちゃんや\nまゆちん達も\n一緒だし。"},
        { "location": "94/TALK"   , "narrator": "雛", "text": "それに、今日のは\n不意打ちだった\nから…。"},
        { "location": "96/TALK"   , "narrator": "アーヤ", "text": "…………。"},
        { "location": "104/TALK"  , "narrator": "アーヤ", "text": "ちょっといい？(￣Д￣ )"},
        { "location": "106/SEL"   , "narrator": "", "text": "ひなこのこと？"},
        { "location": "107/ACT"   , "narrator": "", "text": "ひなこのこと？"},
        { "location": "109/TALK"  , "narrator": "アーヤ", "text": "そう(￣∇￣)"},
        { "location": "110/TALK"  , "narrator": "アーヤ", "text": "日向さん"},
        { "location": "111/TALK"  , "narrator": "アーヤ", "text": "バイトも一緒だし"},
        { "location": "112/TALK"  , "narrator": "アーヤ", "text": "慣れてくれたと思ったけど（；￢＿￢）"},
        { "location": "113/TALK"  , "narrator": "アーヤ", "text": "やっぱり"},
        { "location": "114/TALK"  , "narrator": "アーヤ", "text": "上級生の私とは"},
        { "location": "115/TALK"  , "narrator": "アーヤ", "text": "緊張するのかしら？(-ω-;)"},
        { "location": "117/SEL"   , "narrator": "", "text": "いや、そういう理由じゃなくて…"},
        { "location": "118/ACT"   , "narrator": "", "text": "いや、そういう理由じゃなくて…"},
        { "location": "120/TALK"  , "narrator": "アーヤ", "text": "え？(￣Д￣ )"},
        { "location": "122/TALK"  , "narrator": "アーヤ", "text": "どういうこと？"},
        { "location": "124/SEL"   , "narrator": "", "text": "気づいてないの！？"},
        { "location": "125/ACT"   , "narrator": "", "text": "気づいてないの！？"},
        { "location": "127/TALK"  , "narrator": "アーヤ", "text": "意味が分からないんだけど（￣ー￣？）"},
        { "location": "128/TALK"  , "narrator": "アーヤ", "text": "とにかく今は"},
        { "location": "129/TALK"  , "narrator": "アーヤ", "text": "日向さんの緊張"},
        { "location": "130/TALK"  , "narrator": "アーヤ", "text": "ほぐす方が先だから(｡-_-｡)"},
        { "location": "131/TALK"  , "narrator": "アーヤ", "text": "何かいい方法ある？"},
        { "location": "133/SEL"   , "narrator": "", "text": "会話するしかないと思う"},
        { "location": "134/SEL"   , "narrator": "", "text": "それ、本当に緊張なのかな？"},
        { "location": "135/ACT"   , "narrator": "", "text": "会話するしかないと思う"},
        { "location": "136/TALK"  , "narrator": "アーヤ", "text": "どんな会話？(￣Д￣ )"},
        { "location": "138/SEL"   , "narrator": "", "text": "何でもいいから、とにかく話そう"},
        { "location": "139/ACT"   , "narrator": "", "text": "何でもいいから、とにかく話そう"},
        { "location": "141/TALK"  , "narrator": "アーヤ", "text": "逆に難しいけど"},
        { "location": "142/TALK"  , "narrator": "アーヤ", "text": "まあ"},
        { "location": "143/TALK"  , "narrator": "アーヤ", "text": "とにかくやってみる(>_<)"},
        { "location": "150/TALK"  , "narrator": "アーヤ", "text": "…何でもいいとは\nいっても――"},
        { "location": "151/TALK"  , "narrator": "アーヤ", "text": "日向さんに関係が\nありそうな話題が\nいいから…。"},
        { "location": "153/TALK"  , "narrator": "アーヤ", "text": "あっ、そういえば、\n気になってたことが\nあったの。"},
        { "location": "154/TALK"  , "narrator": "アーヤ", "text": "日向さんは確か、\nフェノメノンに\n巻き込まれた時に――"},
        { "location": "155/TALK"  , "narrator": "アーヤ", "text": "私に助けられたことが\nある、って言ってた\nわね？"},
        { "location": "157/TALK"  , "narrator": "雛", "text": "あ、はい。\nあの日のことは今でも\nよく覚えてます！"},
        { "location": "159/TALK"  , "narrator": "アーヤ", "text": "ごめんなさい。\n私、その時のこと\n覚えてなくて…。"},
        { "location": "160/TALK"  , "narrator": "雛", "text": "あー、そりゃそう\nですよー。"},
        { "location": "161/TALK"  , "narrator": "雛", "text": "あたしが綾水様を\n見たのだって――"},
        { "location": "162/TALK"  , "narrator": "雛", "text": "フェノメノンが収束\nした直後の、ちょっと\nだけでしたし。"},
        { "location": "164/TALK"  , "narrator": "ガブリエラ", "text": "正体隠さなきゃ\nいけないのに――"},
        { "location": "165/TALK"  , "narrator": "ガブリエラ", "text": "おもいっきり姿\n見られちゃってる\nじゃない。"},
        { "location": "167/TALK"  , "narrator": "ガブリエラ", "text": "アーヤも気が緩むこと\nあるのね？"},
        { "location": "169/TALK"  , "narrator": "アーヤ", "text": "…面目ないわ。"},
        { "location": "170/TALK"  , "narrator": "雛", "text": "でも、あの時の\n綾水様、本当に\nかっこよかったです。"},
        { "location": "171/TALK"  , "narrator": "雛", "text": "ほとんど背中しか\n見えなかったけど――"},
        { "location": "172/TALK"  , "narrator": "雛", "text": "なんか、大きくて\n頼りがいがあって、\nとっても綺麗で…。"},
        { "location": "174/TALK"  , "narrator": "アーヤ", "text": "あ、ありがとう…。"},
        { "location": "175/TALK"  , "narrator": "ガブリエラ", "text": "それって確か、\nアーヤ一人だけの\n時だっけ？"},
        { "location": "177/TALK"  , "narrator": "アーヤ", "text": "時期的に多分ね。"},
        { "location": "178/TALK"  , "narrator": "雛", "text": "やっぱり、一人で\nフェノメノンを\n収束させるのって――"},
        { "location": "179/TALK"  , "narrator": "雛", "text": "超凄いことなん\nでしょ？"},
        { "location": "181/TALK"  , "narrator": "アーヤ", "text": "どうかしら？\nモノにもよると\n思うけど。"},
        { "location": "182/TALK"  , "narrator": "ガブリエラ", "text": "いや、普通に考えて\nバケモノだし。"},
        { "location": "183/TALK"  , "narrator": "アーヤ", "text": "も、もう少し違う\n言い方ないの？"},
        { "location": "185/TALK"  , "narrator": "雛", "text": "同じトライナリーの\nガブリエラちゃんが\nそう言うんだから――"},
        { "location": "187/TALK"  , "narrator": "雛", "text": "やっぱり綾水様は\n凄い人です！"},
        { "location": "188/TALK"  , "narrator": "雛", "text": "あ、でももちろん\nあたしは化け物とか\n思ってませんよ？"},
        { "location": "189/TALK"  , "narrator": "雛", "text": "あたしにとっては\n英雄的存在ですから！"},
        { "location": "192/TALK"  , "narrator": "ガブリエラ", "text": "ぷっ…、さすがに\n言い過ぎじゃない？"},
        { "location": "195/TALK"  , "narrator": "アーヤ", "text": "そ、そうね…。\n私はやるべきことを\nしただけなんだし…。"},
        { "location": "197/TALK"  , "narrator": "ガブリエラ", "text": "とか言いつつ、\n満更でもなさそうな\n顔してるけど？"},
        { "location": "199/TALK"  , "narrator": "アーヤ", "text": "してないから！"},
        { "location": "200/TALK"  , "narrator": "雛", "text": "本当、綾水様は\nあたしにとっての\n英雄で、勇者様です。"},
        { "location": "201/TALK"  , "narrator": "雛", "text": "もしまたあたしが\nフェノメノンに\n巻き込まれた際は――"},
        { "location": "202/TALK"  , "narrator": "雛", "text": "助けに来て\nくれますか？"},
        { "location": "206/TALK"  , "narrator": "アーヤ", "text": "もちろんよ。\nギャヴィも一緒にね。"},
        { "location": "207/TALK"  , "narrator": "ガブリエラ", "text": "ま、それがあたし達の\n仕事だしね。"},
        { "location": "208/TALK"  , "narrator": "雛", "text": "じゃあ、その時には\n綾水様――"},
        { "location": "209/TALK"  , "narrator": "雛", "text": "あたしをお姫様抱っこ\nして助けてください！"},
        { "location": "210/TALK"  , "narrator": "アーヤ", "text": "はい？"},
        { "location": "211/TALK"  , "narrator": "ガブリエラ　", "text": "はぁ！？"},
        { "location": "212/TALK"  , "narrator": "雛", "text": "フェノメノンから\n解放された後って――"},
        { "location": "213/TALK"  , "narrator": "雛", "text": "なんかこう、頭の中が\nぼーっとした感じに\nなるんですよー。"},
        { "location": "214/TALK"  , "narrator": "雛", "text": "だから、あの時も\nまたすぐに意識を\n失っちゃって…。"},
        { "location": "216/TALK"  , "narrator": "ガブリエラ", "text": "それとお姫様抱っこに\n何の関係があるのよ？"},
        { "location": "217/TALK"  , "narrator": "雛", "text": "だから、その時は\n綾水様に介抱されたい\nってことだよー。"},
        { "location": "219/TALK"  , "narrator": "雛", "text": "もちろん、綾水様に\nだったらお持ち帰り\nされても――"},
        { "location": "220/TALK"  , "narrator": "ガブリエラ", "text": "あたしが蹴っ飛ばして\n起こしてやるわよ。"},
        { "location": "222/TALK"  , "narrator": "雛", "text": "ちょ！？\nガブリエラちゃん\n暴力的だよー。"},
        { "location": "223/TALK"  , "narrator": "ガブリエラ", "text": "あんたにアーヤの\nお姫様抱っこなんて\n一兆年早いわ！"},
        { "location": "224/TALK"  , "narrator": "ガブリエラ", "text": "あたしだって、\nまだ一度も…。"},
        { "location": "225/TALK"  , "narrator": "雛", "text": "ん？　なになに？"},
        { "location": "226/TALK"  , "narrator": "ガブリエラ", "text": "な、何でもない！"},
        { "location": "227/TALK"  , "narrator": "ガブリエラ", "text": "とにかく、その時は\nあたしが蹴っ飛ばして\n起こすから――"},
        { "location": "228/TALK"  , "narrator": "ガブリエラ", "text": "ひなこは安心して\n気を失っていいわよ。"},
        { "location": "229/TALK"  , "narrator": "雛", "text": "ぶー、ダメでーす。\n綾水様のキスじゃ\nなきゃ起きませーん。"},
        { "location": "230/TALK"  , "narrator": "ガブリエラ", "text": "何でキスになるのよ！"},
        { "location": "232/TALK"  , "narrator": "アーヤ", "text": "…ふふっ。"},
        { "location": "234/TALK"  , "narrator": "アーヤ", "text": "ギャヴィってば、\nいつの間に\n日向さんと――"},
        { "location": "235/TALK"  , "narrator": "アーヤ", "text": "こんな仲良しに\nなったのかしら？"},
        { "location": "236/ACT"   , "narrator": "", "text": "それ、本当に緊張なのかな？"},
        { "location": "237/TALK"  , "narrator": "アーヤ", "text": "どういうこと？(￣Д￣ )"},
        { "location": "239/SEL"   , "narrator": "", "text": "そわそわしてる別の理由といえば？"},
        { "location": "240/ACT"   , "narrator": "", "text": "そわそわしてる別の理由といえば？"},
        { "location": "244/TALK"  , "narrator": "アーヤ", "text": "そういうことね(>_<)"},
        { "location": "245/TALK"  , "narrator": "アーヤ", "text": "わかった"},
        { "location": "246/TALK"  , "narrator": "アーヤ", "text": "ありがとう(￣∇￣)"},
        { "location": "254/TALK"  , "narrator": "アーヤ", "text": "ごめんなさい、\n気づけなかったわ。"},
        { "location": "256/TALK"  , "narrator": "雛", "text": "え？　何がですか？"},
        { "location": "258/TALK"  , "narrator": "アーヤ", "text": "日向さん、\n学食の前に――"},
        { "location": "259/TALK"  , "narrator": "アーヤ", "text": "お手洗い行くつもり\nだったんじゃない？"},
        { "location": "262/TALK"  , "narrator": "雛", "text": "はい！？"},
        { "location": "265/TALK"  , "narrator": "ガブリエラ", "text": "はぁ…どうしてそう\nなっちゃうのよ？"},
        { "location": "266/TALK"  , "narrator": "雛", "text": "いや、違いますから！\nそれ、綾水様の\n誤解ですよ！"},
        { "location": "267/TALK"  , "narrator": "アーヤ", "text": "本当？"},
        { "location": "268/TALK"  , "narrator": "雛", "text": "本当ですよー！"},
        { "location": "270/TALK"  , "narrator": "アーヤ", "text": "そっか…。\nでも、我慢はしないで\nいいからね？"},
        { "location": "271/TALK"  , "narrator": "雛", "text": "だから、\n違いますってー！"},
        { "location": "273/TALK"  , "narrator": "ガブリエラ", "text": "アーヤ、ひなこは\n最初から緊張してる\nって言ってるでしょ？"},
        { "location": "274/TALK"  , "narrator": "アーヤ", "text": "でも、それにしては\n緊張し過ぎてる\n気がするし…。"},
        { "location": "275/TALK"  , "narrator": "ガブリエラ", "text": "だからって、\nよりにもよって\nトイレと間違える？"},
        { "location": "276/TALK"  , "narrator": "ガブリエラ", "text": "アーヤって、\n本当変なところで\n抜けてるわよね。"},
        { "location": "278/TALK"  , "narrator": "アーヤ", "text": "そ、そうかしら…？"},
        { "location": "279/TALK"  , "narrator": "ガブリエラ", "text": "じゃなきゃこんな\n間違いしないって。"},
        { "location": "281/TALK"  , "narrator": "ガブリエラ", "text": "そういうことだから、\nひなこも無駄に緊張\nする必要ないわよ。"},
        { "location": "283/TALK"  , "narrator": "雛", "text": "うん…綾水様って、\nかっこいい人だと\n思ってたけど――"},
        { "location": "284/TALK"  , "narrator": "雛", "text": "こういう\n超可愛い一面も\nあるんですねー。"},
        { "location": "286/TALK"  , "narrator": "アーヤ", "text": "え？　そ、そう？"},
        { "location": "288/TALK"  , "narrator": "ガブリエラ", "text": "…わからないわ。"},
        { "location": "289/TALK"  , "narrator": "ガブリエラ", "text": "今のやり取りの、\nどこに可愛いとこが\nあったわけ？"},
        { "location": "290/TALK"  , "narrator": "雛", "text": "ギャップ萌えだよ、\nギャップ萌え！！"},
        { "location": "291/TALK"  , "narrator": "雛", "text": "普段キリッとしてる\n綾水様の――"},
        { "location": "292/TALK"  , "narrator": "雛", "text": "意外なところで\n抜けてる一面！"},
        { "location": "293/TALK"  , "narrator": "雛", "text": "超可愛いと思わない？"},
        { "location": "294/TALK"  , "narrator": "ガブリエラ", "text": "…結局、アーヤなら\n何だっていい、って\nことじゃないの？"},
        { "location": "295/TALK"  , "narrator": "雛", "text": "そうとも言うねー。"},
        { "location": "297/TALK"  , "narrator": "雛", "text": "というわけで、\n今まで以上に綾水様に\n惚れちゃいました！"},
        { "location": "298/TALK"  , "narrator": "雛", "text": "これからも、綾水様の\n色んなギャップを\n見せてくださいねー。"},
        { "location": "301/TALK"  , "narrator": "アーヤ", "text": "あ、あはは…、\n見せてるつもりは\nないんだけど…。"},
        { "location": "303/TALK"  , "narrator": "ガブリエラ", "text": "っていうか、ひなこ！\nちょっとアーヤに\n近づき過ぎ！"},
        { "location": "304/TALK"  , "narrator": "雛", "text": "いやー、綾水様の\nギャップに胸キュン\nしちゃって――"},
        { "location": "306/TALK"  , "narrator": "雛", "text": "ちょーっと、\n抱き着きたいなぁ、\nなんて…。"},
        { "location": "307/TALK"  , "narrator": "ガブリエラ", "text": "却下！！\nアーヤが許しても\nあたしが許さないわ！"},
        { "location": "309/TALK"  , "narrator": "アーヤ", "text": "…ふふっ。"},
        { "location": "310/TALK"  , "narrator": "アーヤ", "text": "この二人、いつの間に\nこんなに仲良く\nなったのかしら？"},
        { "location": "18/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>7月15日　0:04 PM</color>\nとある昼休み、学園の廊下にて。"}
