{
    "dir": "chap34/daydra/dd_ch05_34_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "34505",
        "cid": "kagura",
        "title": "005 メインストーリー",
        "sub_title": "ミレニアム・プロジェクト"
    },
    "entry":
    [
        { "location": "624/SEL"   , "narrator": "", "text": "つばめ！"},
        { "location": "625/ACT"   , "narrator": "", "text": "つばめ！"},
        { "location": "628/TALK"  , "narrator": "プレイヤー", "text": "結局、リプレイス前に戻ってしまったね"},
        { "location": "629/SEL"   , "narrator": "", "text": "狙いはなんだ？"},
        { "location": "630/SEL"   , "narrator": "", "text": "こんなことして楽しい？"},
        { "location": "631/SEL"   , "narrator": "", "text": "つばめがこんな目にあってるのに平気なの？"},
        { "location": "632/ACT"   , "narrator": "", "text": "狙いはなんだ？"},
        { "location": "633/TALK"  , "narrator": "プレイヤー", "text": "基本的にはリプレイス前の進行に流れを戻すことだよ"},
        { "location": "634/ACT"   , "narrator": "", "text": "こんなことして楽しい？"},
        { "location": "635/TALK"  , "narrator": "プレイヤー", "text": "楽しくてやってるわけじゃない"},
        { "location": "636/SEL"   , "narrator": "", "text": "じゃあどうして？"},
        { "location": "637/ACT"   , "narrator": "", "text": "じゃあどうして？"},
        { "location": "639/TALK"  , "narrator": "プレイヤー", "text": "リプレイス前の進行に流れを戻したいだけ"},
        { "location": "640/ACT"   , "narrator": "", "text": "つばめがこんな目にあってるのに平気なの？"},
        { "location": "641/TALK"  , "narrator": "プレイヤー", "text": "これも予定通りだから"},
        { "location": "642/SEL"   , "narrator": "", "text": "予定って？"},
        { "location": "643/ACT"   , "narrator": "", "text": "予定って？"},
        { "location": "645/TALK"  , "narrator": "プレイヤー", "text": "リプレイス前の進行に流れを戻すのが目的だから"},
        { "location": "647/SEL"   , "narrator": "", "text": "何故？"},
        { "location": "648/ACT"   , "narrator": "", "text": "何故？"},
        { "location": "650/TALK"  , "narrator": "プレイヤー", "text": "$me$達もリプレイスをしてるからだよ"},
        { "location": "651/SEL"   , "narrator": "", "text": "どんな？"},
        { "location": "652/SEL"   , "narrator": "", "text": "なら協力しようよ"},
        { "location": "653/ACT"   , "narrator": "", "text": "どんな？"},
        { "location": "654/TALK"  , "narrator": "プレイヤー", "text": "リプレイスし始めた世界をリプレイス前に戻す"},
        { "location": "655/ACT"   , "narrator": "", "text": "なら協力しようよ"},
        { "location": "656/TALK"  , "narrator": "プレイヤー", "text": "もちろん大歓迎だよ、その言葉を待っていた"},
        { "location": "657/SEL"   , "narrator": "", "text": "おまえは何を目指してる？"},
        { "location": "658/ACT"   , "narrator": "", "text": "おまえは何を目指してる？"},
        { "location": "660/TALK"  , "narrator": "プレイヤー", "text": "だから、リプレイスし始めた世界を、その前に戻したいんだって"},
        { "location": "662/SEL"   , "narrator": "", "text": "そんなことしてどうなる？"},
        { "location": "663/ACT"   , "narrator": "", "text": "そんなことしてどうなる？"},
        { "location": "665/TALK"  , "narrator": "プレイヤー", "text": "最大の敗因を挽回するために必要なんだ"},
        { "location": "666/SEL"   , "narrator": "", "text": "何それ？"},
        { "location": "667/ACT"   , "narrator": "", "text": "何それ？"},
        { "location": "669/TALK"  , "narrator": "プレイヤー", "text": "最終的に昇華出来なかったこと"},
        { "location": "670/SEL"   , "narrator": "", "text": "その辺詳しく"},
        { "location": "671/ACT"   , "narrator": "", "text": "その辺詳しく"},
        { "location": "673/TALK"  , "narrator": "プレイヤー", "text": "その辺を伝えたくて来たんだ"},
        { "location": "674/SEL"   , "narrator": "", "text": "早く聞かせて"},
        { "location": "675/ACT"   , "narrator": "", "text": "早く聞かせて"},
        { "location": "677/TALK"  , "narrator": "プレイヤー", "text": "君にも力になってほしい"},
        { "location": "678/SEL"   , "narrator": "", "text": "乗っ取り猛々しい"},
        { "location": "679/SEL"   , "narrator": "", "text": "自分との協力プレイ展開！？"},
        { "location": "680/SEL"   , "narrator": "", "text": "こっちに協力してよ"},
        { "location": "681/SEL"   , "narrator": "", "text": "ジュエル９００個で手を打とう"},
        { "location": "682/ACT"   , "narrator": "", "text": "乗っ取り猛々しい"},
        { "location": "683/TALK"  , "narrator": "プレイヤー", "text": "$me$と君では確かにそうだけど、君と“彼女らの記憶”だったらどうかな"},
        { "location": "684/ACT"   , "narrator": "", "text": "自分との協力プレイ展開！？"},
        { "location": "685/TALK"  , "narrator": "プレイヤー", "text": "正確には君が$me$に協力するんだ"},
        { "location": "686/SEL"   , "narrator": "", "text": "何それ、お邪魔キャラの分際で"},
        { "location": "687/ACT"   , "narrator": "", "text": "何それ、お邪魔キャラの分際で"},
        { "location": "689/TALK"  , "narrator": "プレイヤー", "text": "$me$と君では確かにそうだけど、君と“彼女らの記憶”だったらどうかな"},
        { "location": "690/ACT"   , "narrator": "", "text": "こっちに協力してよ"},
        { "location": "691/TALK"  , "narrator": "プレイヤー", "text": "君が$me$に協力するのが一番いいことだよ"},
        { "location": "692/SEL"   , "narrator": "", "text": "いや、そうは思わない"},
        { "location": "693/ACT"   , "narrator": "", "text": "いや、そうは思わない"},
        { "location": "695/TALK"  , "narrator": "プレイヤー", "text": "さて、それはどうかな？"},
        { "location": "696/ACT"   , "narrator": "", "text": "ジュエル９００個で手を打とう"},
        { "location": "697/TALK"  , "narrator": "プレイヤー", "text": "ジュエルの譲渡機能なんてないじゃん"},
        { "location": "698/SEL"   , "narrator": "", "text": "じゃあヤダよ"},
        { "location": "699/ACT"   , "narrator": "", "text": "じゃあヤダよ"},
        { "location": "701/TALK"  , "narrator": "プレイヤー", "text": "じゃあ、勝手に進めさせてもらうよ"},
        { "location": "703/TALK"  , "narrator": "プレイヤー", "text": "$me$が言っても上手く伝わらないので、トライナリーたちの現実記憶を招待した"},
        { "location": "704/SEL"   , "narrator": "", "text": "現実記憶？？"},
        { "location": "705/ACT"   , "narrator": "", "text": "現実記憶？？"},
        { "location": "707/TALK"  , "narrator": "プレイヤー", "text": "現実世界の記憶を映画のように再生すること。映画と違ってインタラクティブだけど"},
        { "location": "708/SEL"   , "narrator": "", "text": "アーヤたちがフェノメノンに入る前の記憶と話せるってこと？"},
        { "location": "709/ACT"   , "narrator": "", "text": "アーヤたちがフェノメノンに入る前の記憶と話せるってこと？"},
        { "location": "711/TALK"  , "narrator": "プレイヤー", "text": "うん、そう。その方が絶対分かりやすいと思うしね"},
        { "location": "712/TALK"  , "narrator": "プレイヤー", "text": "ごゆっくり！"},
        { "location": "746/SEL"   , "narrator": "", "text": "ここは！？"},
        { "location": "747/ACT"   , "narrator": "", "text": "ここは！？"},
        { "location": "750/TALK"  , "narrator": "アーヤ", "text": "…貴方、ですか？"},
        { "location": "751/SEL"   , "narrator": "", "text": "なにが？"},
        { "location": "752/ACT"   , "narrator": "", "text": "なにが？"},
        { "location": "754/TALK"  , "narrator": "アーヤ", "text": "フェノメノンの中で\n洗脳された私達を――"},
        { "location": "755/TALK"  , "narrator": "アーヤ", "text": "たきつけているのは\n貴方なのかと\n聞いているんです。"},
        { "location": "756/SEL"   , "narrator": "", "text": "いや、協力してるだけだよ"},
        { "location": "757/SEL"   , "narrator": "", "text": "人違いしてませんか？"},
        { "location": "758/SEL"   , "narrator": "", "text": "言い方は悪いけど、そういうことになる"},
        { "location": "759/SEL"   , "narrator": "", "text": "それ以外の選択なかったし"},
        { "location": "760/ACT"   , "narrator": "", "text": "いや、協力してるだけだよ"},
        { "location": "761/TALK"  , "narrator": "ガブリエラ", "text": "フェノメノンの中の\nあたし達に協力してる\nってことは…。"},
        { "location": "762/TALK"  , "narrator": "ガブリエラ", "text": "たきつけてるのと\nやってることは\n変わらないわ。"},
        { "location": "763/ACT"   , "narrator": "", "text": "人違いしてませんか？"},
        { "location": "765/TALK"  , "narrator": "みやび", "text": "この期に及んで、\nそれは苦し過ぎやろ？"},
        { "location": "766/ACT"   , "narrator": "", "text": "言い方は悪いけど、そういうことになる"},
        { "location": "767/TALK"  , "narrator": "みやび", "text": "意外と素直に\n認めよったな。"},
        { "location": "768/TALK"  , "narrator": "ガブリエラ", "text": "言い訳しても無駄と\nわかって、\n観念したみたいね。"},
        { "location": "769/SEL"   , "narrator": "", "text": "そういうわけじゃないけど"},
        { "location": "770/ACT"   , "narrator": "", "text": "そういうわけじゃないけど"},
        { "location": "773/TALK"  , "narrator": "ガブリエラ", "text": "じゃあ、\nどういうわけよ？"},
        { "location": "774/ACT"   , "narrator": "", "text": "それ以外の選択なかったし"},
        { "location": "775/TALK"  , "narrator": "ガブリエラ", "text": "つまり、たきつけた\nってことよね？"},
        { "location": "776/TALK"  , "narrator": "みやび", "text": "ハッキリ言わん辺り、\n後ろめたさがある\nっちゅうことやろか？"},
        { "location": "778/TALK"  , "narrator": "アーヤ", "text": "なんであれ、\n貴方のやっている\nことは…。"},
        { "location": "779/TALK"  , "narrator": "アーヤ", "text": "私達の足を\n引っ張ってることに\n変わりないわ。"},
        { "location": "780/SEL"   , "narrator": "", "text": "いや、そう言われても…"},
        { "location": "781/ACT"   , "narrator": "", "text": "いや、そう言われても…"},
        { "location": "784/TALK"  , "narrator": "ガブリエラ", "text": "この様子からすると、\n大人しく認めることは\nなさそうね。"},
        { "location": "785/TALK"  , "narrator": "みやび", "text": "簡単に認められても、\nそれはそれでウソっ\nぽく思えるけんどな。"},
        { "location": "786/TALK"  , "narrator": "みやび", "text": "それに、初めっから\n簡単にことが進むとも\n思うちょらんし。"},
        { "location": "787/SEL"   , "narrator": "", "text": "全面戦争する気、とか？"},
        { "location": "788/SEL"   , "narrator": "", "text": "つまり$me$に協力してくれるんだね？"},
        { "location": "789/SEL"   , "narrator": "", "text": "さすがみやび、$me$のこと理解してるね"},
        { "location": "790/ACT"   , "narrator": "", "text": "全面戦争する気、とか？"},
        { "location": "791/TALK"  , "narrator": "みやび", "text": "…随分好戦的なヤツ\nみたいやね。"},
        { "location": "792/TALK"  , "narrator": "ガブリエラ", "text": "まあ、あんたがそれを\n望むなら、それでも\n構わないけど？"},
        { "location": "794/TALK"  , "narrator": "アーヤ", "text": "ダメよ。\nそれが目的じゃ\nないでしょ？"},
        { "location": "795/ACT"   , "narrator": "", "text": "つまり$me$に協力してくれるんだね？"},
        { "location": "797/TALK"  , "narrator": "ガブリエラ", "text": "なんでそうなるのよ？"},
        { "location": "798/TALK"  , "narrator": "みやび", "text": "そんな都合のいい\n展開になるはず\nないやろ…。"},
        { "location": "799/ACT"   , "narrator": "", "text": "さすがみやび、$me$のこと理解してるね"},
        { "location": "800/TALK"  , "narrator": "みやび", "text": "いや、知らん。\nちゅうか、あんまし\n興味もないし。"},
        { "location": "802/TALK"  , "narrator": "アーヤ", "text": "貴方が洗脳された\n私達をたきつけて\nいることは…。"},
        { "location": "803/TALK"  , "narrator": "アーヤ", "text": "$handle$から\n聞いたわ。"},
        { "location": "804/TALK"  , "narrator": "アーヤ", "text": "だから、作戦を\n正当化するために、\n貴方を説得に来たの。"},
        { "location": "805/SEL"   , "narrator": "", "text": "作戦って？"},
        { "location": "806/SEL"   , "narrator": "", "text": "どんな風に説得するつもり？"},
        { "location": "807/ACT"   , "narrator": "", "text": "作戦って？"},
        { "location": "809/TALK"  , "narrator": "アーヤ", "text": "ええ、それを話せば、\nわかってもらえると\n信じてる。"},
        { "location": "810/ACT"   , "narrator": "", "text": "どんな風に説得するつもり？"},
        { "location": "811/TALK"  , "narrator": "アーヤ", "text": "…私達の任務について\n貴方に話す。"},
        { "location": "812/TALK"  , "narrator": "アーヤ", "text": "こちらの意図を\n理解してもらわないと\n話にならないし。"},
        { "location": "814/TALK"  , "narrator": "アーヤ", "text": "私達は、フェノメノン\nという神の奇跡を\n媒介として…。"},
        { "location": "815/TALK"  , "narrator": "アーヤ", "text": "天使となり、世界に\n恒久的安寧を\nもたらすという…。"},
        { "location": "816/TALK"  , "narrator": "アーヤ", "text": "重大な任務があるの。"},
        { "location": "817/SEL"   , "narrator": "", "text": "いや、もうちょっと根本的なことから頼む"},
        { "location": "818/SEL"   , "narrator": "", "text": "なるほど意味がわからない"},
        { "location": "819/ACT"   , "narrator": "", "text": "いや、もうちょっと根本的なことから頼む"},
        { "location": "820/ACT"   , "narrator": "", "text": "なるほど意味がわからない"},
        { "location": "823/TALK"  , "narrator": "ガブリエラ", "text": "…大分洗脳されてる\nみたいね？"},
        { "location": "824/TALK"  , "narrator": "みやび", "text": "初心者さんやし、\nお手柔らかにしてやりや。"},
        { "location": "825/TALK"  , "narrator": "アーヤ", "text": "まあ、簡単に説得\nできるとは最初から\n思ってないわ。"},
        { "location": "826/TALK"  , "narrator": "アーヤ", "text": "順番に、一つずつ\n話していくから、\nよく聞いて。"},
        { "location": "827/TALK"  , "narrator": "アーヤ", "text": "この世界の平和的\n統治を目指す人達が\nいるんだけど…。"},
        { "location": "828/TALK"  , "narrator": "アーヤ", "text": "それは仮に、\n“彼ら”と\n言っておくわ。"},
        { "location": "829/TALK"  , "narrator": "アーヤ", "text": "その“彼ら”の推進する、\n人々を絶対なる安寧へ\n導くための政策に――"},
        { "location": "830/TALK"  , "narrator": "アーヤ", "text": "私達は、中心メンバー\nとして参加してるの。"},
        { "location": "831/SEL"   , "narrator": "", "text": "安寧って、どういうこと？"},
        { "location": "832/ACT"   , "narrator": "", "text": "安寧って、どういうこと？"},
        { "location": "834/TALK"  , "narrator": "みやび", "text": "フェノメノンっちゅう\n神の奇跡で、敗戦国\n日本を蘇らせ…。"},
        { "location": "835/TALK"  , "narrator": "みやび", "text": "その奇跡を持って、\n千年王国とし…。"},
        { "location": "836/TALK"  , "narrator": "みやび", "text": "人々に神の奇跡を\n信じさせる気持ちを\n復活させることや。"},
        { "location": "837/TALK"  , "narrator": "ガブリエラ", "text": "その千年王国は\n理想的な社会に\n於いて…。"},
        { "location": "838/TALK"  , "narrator": "ガブリエラ", "text": "世界で最も豊かで\n幸せな、法と規律に\nよって…。"},
        { "location": "839/TALK"  , "narrator": "ガブリエラ", "text": "絶対的な秩序のある\n国として世界に\n知らしめること。"},
        { "location": "840/TALK"  , "narrator": "アーヤ", "text": "そして、千年王国を\n創りし存在こそが…。"},
        { "location": "841/TALK"  , "narrator": "アーヤ", "text": "４人の天使であると\nいうこともまた…。"},
        { "location": "843/TALK"  , "narrator": "アーヤ", "text": "具体的行動により\n世界に示すことが、\n私達の任務なの。"},
        { "location": "844/SEL"   , "narrator": "", "text": "いやいや、わけわからないし！"},
        { "location": "845/SEL"   , "narrator": "", "text": "えっと、カルト？"},
        { "location": "846/ACT"   , "narrator": "", "text": "いやいや、わけわからないし！"},
        { "location": "848/TALK"  , "narrator": "アーヤ", "text": "…上手く説明できたと\n思ったんだけど。"},
        { "location": "849/TALK"  , "narrator": "みやび", "text": "洗脳の影響やろ。\n根気よくいかんと\nダメそうやね。"},
        { "location": "850/ACT"   , "narrator": "", "text": "えっと、カルト？"},
        { "location": "852/TALK"  , "narrator": "ガブリエラ", "text": "あのね、あたし達は\n現実的なことを\n話してるのよ？"},
        { "location": "853/TALK"  , "narrator": "ガブリエラ", "text": "妄想に狂った連中と\n一緒にされるのは、\n不愉快だわ。"},
        { "location": "854/TALK"  , "narrator": "みやび", "text": "しゃあない。\n信じられんからこそ\n“奇跡”になるんやし。"},
        { "location": "856/TALK"  , "narrator": "アーヤ", "text": "えっと…それじゃあ、\nもう少し詳しく\n話すわ。"},
        { "location": "857/TALK"  , "narrator": "アーヤ", "text": "４人の天使について\nだけど、わかる？"},
        { "location": "858/SEL"   , "narrator": "", "text": "知らない"},
        { "location": "859/SEL"   , "narrator": "", "text": "つばめ、アーヤ、ガブリエラ、みやびのこと？"},
        { "location": "860/ACT"   , "narrator": "", "text": "知らない"},
        { "location": "861/ACT"   , "narrator": "", "text": "つばめ、アーヤ、ガブリエラ、みやびのこと？"},
        { "location": "863/TALK"  , "narrator": "アーヤ", "text": "違うわ。"},
        { "location": "865/TALK"  , "narrator": "アーヤ", "text": "私達三人と、\n卯月のことよ。"},
        { "location": "866/TALK"  , "narrator": "アーヤ", "text": "それは４人の\n熾天使であり、\n今この時を境に…。"},
        { "location": "867/TALK"  , "narrator": "アーヤ", "text": "それは伝説の存在では\nなく、現実のものと\nなるの。"},
        { "location": "868/TALK"  , "narrator": "みやび", "text": "わかりやすく言うと、\n黙示録の始まり、\nっちゅうことや。"},
        { "location": "869/TALK"  , "narrator": "みやび", "text": "うちらは荒廃した\nフェノメノンの中に\n入り…。"},
        { "location": "870/TALK"  , "narrator": "みやび", "text": "その世界を千年王国\nとして切り開く。"},
        { "location": "872/TALK"  , "narrator": "みやび", "text": "そして、世界を\n安寧へと導くための\n存在なんよ。"},
        { "location": "873/TALK"  , "narrator": "ガブリエラ", "text": "それが達成されれば、\n世界は一つになる。"},
        { "location": "874/TALK"  , "narrator": "ガブリエラ", "text": "この世は\n日本を皮切りとして、\n神の統治の元で…。"},
        { "location": "875/TALK"  , "narrator": "ガブリエラ", "text": "全世界規模の\n千年王国へと\n突き進めるのよ。"},
        { "location": "876/SEL"   , "narrator": "", "text": "自信満々に言うね？"},
        { "location": "877/ACT"   , "narrator": "", "text": "自信満々に言うね？"},
        { "location": "879/TALK"  , "narrator": "ガブリエラ", "text": "根拠もあるわ。"},
        { "location": "880/TALK"  , "narrator": "ガブリエラ", "text": "日本が一夜にして\n復興するっていう…。"},
        { "location": "882/TALK"  , "narrator": "ガブリエラ", "text": "神の奇跡を、全人類が\n目の当たりにする\nことになるんだから。"},
        { "location": "883/TALK"  , "narrator": "みやび", "text": "今、否定的なことを\n言うてても…。"},
        { "location": "884/TALK"  , "narrator": "みやび", "text": "否定しようもない\n大いなる奇跡を\n目にすれば…。"},
        { "location": "885/TALK"  , "narrator": "みやび", "text": "信仰は間違いなく\n復活する。"},
        { "location": "886/TALK"  , "narrator": "アーヤ", "text": "そして世界中の人々は\n自らの国にも千年王国\n創造を祈る。"},
        { "location": "887/TALK"  , "narrator": "アーヤ", "text": "私達天使が、\nそれを判断する"},
        { "location": "888/TALK"  , "narrator": "アーヤ", "text": "黙示録の天使として、\n厳格な基準のもとに\n行動し…。"},
        { "location": "889/TALK"  , "narrator": "アーヤ", "text": "全世界規模の\n千年王国を\n創造するの。"},
        { "location": "890/SEL"   , "narrator": "", "text": "ごめん、マジで話についていけない"},
        { "location": "891/ACT"   , "narrator": "", "text": "ごめん、マジで話についていけない"},
        { "location": "894/TALK"  , "narrator": "アーヤ", "text": "…ダメみたい。\n想像以上に旧世界秩序の\n観念に囚われてるわね。"},
        { "location": "895/TALK"  , "narrator": "ガブリエラ", "text": "それ以外\n考えられないわ。"},
        { "location": "896/TALK"  , "narrator": "みやび", "text": "面倒やねえ。\nどうしたらえいか…。"},
        { "location": "899/TALK"  , "narrator": "プレイヤー", "text": "$me$が代わりに説明するよ"},
        { "location": "900/SEL"   , "narrator": "", "text": "いい加減、$me$に着いてくるのやめてよ"},
        { "location": "901/ACT"   , "narrator": "", "text": "いい加減、$me$に着いてくるのやめて"},
        { "location": "903/TALK"  , "narrator": "プレイヤー", "text": "言われなくても、そろそろ消えるから大丈夫"},
        { "location": "904/TALK"  , "narrator": "プレイヤー", "text": "このミレニアム計画だけど、リプレイス前にはあと一歩の所まで来てた"},
        { "location": "905/SEL"   , "narrator": "", "text": "マジだったの？"},
        { "location": "906/ACT"   , "narrator": "", "text": "マジだったの？"},
        { "location": "908/TALK"  , "narrator": "プレイヤー", "text": "アーヤ達は発症と肉体からの解脱を経て天使となり、つばめによる千年王国という理想社会を日本に創造する"},
        { "location": "909/SEL"   , "narrator": "", "text": "えーっと…"},
        { "location": "910/ACT"   , "narrator": "", "text": "えーっと…"},
        { "location": "912/TALK"  , "narrator": "プレイヤー", "text": "そして後は、蒸着によって世界にご披露するだけだった"},
        { "location": "913/SEL"   , "narrator": "", "text": "そんなことさせないぞ！"},
        { "location": "914/SEL"   , "narrator": "", "text": "見てみたいな、千年王国"},
        { "location": "915/SEL"   , "narrator": "", "text": "どうにもまだ理解できてない"},
        { "location": "916/ACT"   , "narrator": "", "text": "そんなことはさせないぞ！"},
        { "location": "917/TALK"  , "narrator": "プレイヤー", "text": "内側のアーヤ達を焚きつけてるからわかってる"},
        { "location": "918/ACT"   , "narrator": "", "text": "見てみたいな、千年王国"},
        { "location": "919/TALK"  , "narrator": "プレイヤー", "text": "内側のアーヤ達を焚きつけて妨害したのに？"},
        { "location": "920/ACT"   , "narrator": "", "text": "どうにもまだ理解できてない"},
        { "location": "921/TALK"  , "narrator": "プレイヤー", "text": "これ以上詳しく説明できない"},
        { "location": "923/TALK"  , "narrator": "プレイヤー", "text": "けど、つばめのセルフクラン、千羽鶴だっけ？壊してまで蒸着を妨害するなんて"},
        { "location": "924/SEL"   , "narrator": "", "text": "ん？"},
        { "location": "925/ACT"   , "narrator": "", "text": "ん？"},
        { "location": "927/TALK"  , "narrator": "プレイヤー", "text": "彼らにしてみれば、露ほども想像し得なかった事態らしいよ？"},
        { "location": "928/SEL"   , "narrator": "", "text": "え？"},
        { "location": "929/ACT"   , "narrator": "", "text": "え？"},
        { "location": "931/TALK"  , "narrator": "プレイヤー", "text": "千羽鶴を撃って\n破壊したでしょ？"},
        { "location": "932/SEL"   , "narrator": "", "text": "彼らがやったんじゃないの！？"},
        { "location": "933/SEL"   , "narrator": "", "text": "そう思ってるの？"},
        { "location": "934/ACT"   , "narrator": "", "text": "彼らがやったんじゃないの！？"},
        { "location": "936/TALK"  , "narrator": "プレイヤー", "text": "しらばっくれてるでしょ？"},
        { "location": "937/ACT"   , "narrator": "", "text": "そう思ってるの？"},
        { "location": "938/TALK"  , "narrator": "プレイヤー", "text": "それ以外に考えられないし"},
        { "location": "940/TALK"  , "narrator": "プレイヤー", "text": "だから、今回こそは邪魔をさせないから"},
        { "location": "941/SEL"   , "narrator": "", "text": "いや、そもそも$me$たちじゃないから！"},
        { "location": "942/ACT"   , "narrator": "", "text": "いや、そもそも$me$たちじゃないから！"},
        { "location": "944/TALK"  , "narrator": "プレイヤー", "text": "…は？"},
        { "location": "945/SEL"   , "narrator": "", "text": "$me$たちは、そっちがやったとばかり思ってたもの"},
        { "location": "946/ACT"   , "narrator": "", "text": "$me$たちは、そっちがやったとばかり思ってたもの"},
        { "location": "949/TALK"  , "narrator": "プレイヤー", "text": "まあいいや、もうそれは過去の事だし、$me$の仕事ももうそろそろ終わるし"},
        { "location": "950/TALK"  , "narrator": "プレイヤー", "text": "短い間だったけど、回線貸してくれてありがとう"},
        { "location": "951/SEL"   , "narrator": "", "text": "ここから去るの？"},
        { "location": "952/ACT"   , "narrator": "", "text": "ここから去るの？"},
        { "location": "954/TALK"  , "narrator": "プレイヤー", "text": "そうだよ、君がこっちに協力してくれれば尚良かったけど"},
        { "location": "955/TALK"  , "narrator": "プレイヤー", "text": "それは外側のトライナリーたちの意識に任せることにする"},
        { "location": "956/SEL"   , "narrator": "", "text": "そもそも何の為に$me$の回線を乗っ取ってたわけ？"},
        { "location": "957/ACT"   , "narrator": "", "text": "そもそも何の為に$me$の回線を乗っ取ってたわけ？"},
        { "location": "959/TALK"  , "narrator": "プレイヤー", "text": "バイパス回線の敷設"},
        { "location": "960/SEL"   , "narrator": "", "text": "は！？"},
        { "location": "961/ACT"   , "narrator": "", "text": "は！？"},
        { "location": "963/TALK"  , "narrator": "プレイヤー", "text": "気づいて邪魔されるようなら、ここで例の邪魔しないでの交換条件を発動しようと思ってたけど"},
        { "location": "964/TALK"  , "narrator": "プレイヤー", "text": "気づかれなくてよかったです、ではでは"},
        { "location": "970/DIALOG", "narrator": "NOTICE", "text": "<color=red>【TRI-OS Error:0x99】</color>\n回線が切断されました。\n(981)"},
        { "location": "979/DIALOG", "narrator": "Dialog_chapter_ch05", "text": "【28 時計じかけのイチゴ】"},
        { "location": "991/DIALOG", "narrator": "Dialog_chapter_ch05", "text": "【28 時計じかけのイチゴ】"}
    ]
}
