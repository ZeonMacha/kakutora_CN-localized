        "title": "スペシャルエピソード",
        "sub_title": "恐怖と魅了のお化け屋敷"
    },
    "entry":
    [
        { "location": "25/TALK" , "narrator": "透明つばめ", "text": "う、卯月さん！\n歩くの早いよぉ！"},
        { "location": "26/TALK" , "narrator": "透明神楽", "text": "大丈夫ですよ。\n置いていったりは\nしませんから。"},
        { "location": "28/TALK" , "narrator": "透明神楽", "text": "それにしても、\n随分本格的な\nお化け屋敷ですね。"},
        { "location": "30/TALK" , "narrator": "透明神楽", "text": "あそこの人形とか、\nちょっと迫力あり過ぎ\nだと思いませんか？"},
        { "location": "32/TALK" , "narrator": "透明つばめ", "text": "や、ヤダよ！\nわたし見ないから！"},
        { "location": "33/TALK" , "narrator": "透明神楽", "text": "せっかく入ったのに\n見ないなんて、\n勿体ないですよ。"},
        { "location": "34/TALK" , "narrator": "透明つばめ", "text": "で、でも、\n凄く怖いし…。"},
        { "location": "35/TALK" , "narrator": "透明神楽", "text": "怖いのが出てきたら\n教えてあげますね。"},
        { "location": "36/TALK" , "narrator": "透明つばめ", "text": "教えられなくても\n見えちゃうよ！"},
        { "location": "38/TALK" , "narrator": "透明神楽", "text": "なら、私にしっかり\n捕まって、下を向いて\nいてください。"},
        { "location": "39/TALK" , "narrator": "透明神楽", "text": "見えなければ、\nちょっとはマシに\nなると思いますよ。"},
        { "location": "42/TALK" , "narrator": "透明つばめ", "text": "そ、そうかなぁ？"},
        { "location": "43/TALK" , "narrator": "透明神楽", "text": "ほら、つばめさん。\nそこの影から何か\n出てきそうですよ。"},
        { "location": "44/TALK" , "narrator": "透明つばめ", "text": "わかった、\nわかったよぉ…。"},
        { "location": "47/TALK" , "narrator": "透明神楽", "text": "ふふっ…怯えてる\nつばめさんって、\nかわいいです。"},
        { "location": "48/TALK" , "narrator": "透明つばめ", "text": "それ、あんまし\n嬉しくないよ…？"},
        { "location": "50/SEL"  , "narrator": "（選択肢）", "text": "そんなに怖いの？"},
        { "location": "51/ACT"  , "narrator": "", "text": "そんなに怖いの？"},
        { "location": "58/TALK" , "narrator": "つばめ", "text": "お化け屋敷が怖くなぃ人"},
        { "location": "60/TALK" , "narrator": "つばめ", "text": "そんなに"},
        { "location": "61/TALK" , "narrator": "つばめ", "text": "ぃなぃと思ぅよ・゜・(ノД`)・゜・"},
        { "location": "62/SEL"  , "narrator": "（選択肢）", "text": "怖がる必要ないよ"},
        { "location": "63/ACT"  , "narrator": "", "text": "怖がる必要ないよ"},
        { "location": "65/TALK" , "narrator": "つばめ", "text": "そぅぃわれても"},
        { "location": "66/TALK" , "narrator": "つばめ", "text": "怖ぃものは怖ぃよ(´つω・｀)ｼｭﾝ"},
        { "location": "67/SEL"  , "narrator": "（選択肢）", "text": "普段から僕と話してるのに？"},
        { "location": "68/SEL"  , "narrator": "（選択肢）", "text": "神楽がいるじゃん"},
        { "location": "69/ACT"  , "narrator": "", "text": "普段から僕と話してるのに？"},
        { "location": "74/TALK" , "narrator": "つばめ", "text": "よくわからなぃよ"},
        { "location": "75/TALK" , "narrator": "つばめ", "text": "$handle$さんと話すのと"},
        { "location": "76/TALK" , "narrator": "つばめ", "text": "お化け屋敷"},
        { "location": "77/TALK" , "narrator": "つばめ", "text": "何か関係ぁるかな？(･ｪ･^ )( ^･ｪ･)"},
        { "location": "78/SEL"  , "narrator": "（選択肢）", "text": "実はお化けです"},
        { "location": "79/SEL"  , "narrator": "（選択肢）", "text": "$me$だってお化けみたいなもんでしょ？"},
        { "location": "80/ACT"  , "narrator": "", "text": "実はお化けです"},
        { "location": "82/TALK" , "narrator": "つばめ", "text": "$handle$さんみたぃなぉ化けなら"},
        { "location": "83/TALK" , "narrator": "つばめ", "text": "大歓迎(*≧∀≦*) "},
        { "location": "85/TALK" , "narrator": "つばめ", "text": "怖くなぃし"},
        { "location": "86/TALK" , "narrator": "つばめ", "text": "話してると"},
        { "location": "87/TALK" , "narrator": "つばめ", "text": "楽しぃ気持ちになるから(*´ω｀*)"},
        { "location": "88/ACT"  , "narrator": "", "text": "$me$だってお化けみたいなもんでしょ？"},
        { "location": "91/TALK" , "narrator": "つばめ", "text": "わかった"},
        { "location": "92/TALK" , "narrator": "つばめ", "text": "姿が見ぇなぃからでしょ？ヾ(｡>﹏<｡)ﾉﾞ"},
        { "location": "93/TALK" , "narrator": "つばめ", "text": "でもね"},
        { "location": "94/TALK" , "narrator": "つばめ", "text": "$handle$さんは違ぅよ"},
        { "location": "95/TALK" , "narrator": "つばめ", "text": "怖くなぃし(*´︶`*)"},
        { "location": "96/TALK" , "narrator": "つばめ", "text": "ぁ"},
        { "location": "97/TALK" , "narrator": "つばめ", "text": "でもぉ化けと似てるかも"},
        { "location": "98/TALK" , "narrator": "つばめ", "text": "一緒に話してると"},
        { "location": "99/TALK" , "narrator": "つばめ", "text": "ドキドキすることぁるから(≧艸≦*)"},
        { "location": "101/TALK", "narrator": "つばめ", "text": "でも"},
        { "location": "102/TALK", "narrator": "つばめ", "text": "ぉ化けのドキドキとは"},
        { "location": "103/TALK", "narrator": "つばめ", "text": "違ぅけど (*´∀`*)"},
        { "location": "105/ACT" , "narrator": "", "text": "神楽がいるじゃん"},
        { "location": "106/TALK", "narrator": "つばめ", "text": "卯月さんはぃるけど"},
        { "location": "107/TALK", "narrator": "つばめ", "text": "ぉ化けもぃるし(´･ω･｀) "},
        { "location": "108/SEL" , "narrator": "（選択肢）", "text": "本物じゃないよ？"},
        { "location": "109/ACT" , "narrator": "", "text": "本物じゃないよ？"},
        { "location": "113/TALK", "narrator": "つばめ", "text": "余計に怖ぃよ・゜・(ノД`)・゜・"},
        { "location": "115/TALK", "narrator": "つばめ", "text": "だって"},
        { "location": "116/TALK", "narrator": "つばめ", "text": "絶対驚かされるの"},
        { "location": "117/TALK", "narrator": "つばめ", "text": "わかるしヽ(；▽；)ノ"},
        { "location": "118/SEL" , "narrator": "（選択肢）", "text": "本当怖がり屋さんだね"},
        { "location": "119/ACT" , "narrator": "", "text": "本当怖がり屋さんだね"},
        { "location": "121/TALK", "narrator": "つばめ", "text": "だって"},
        { "location": "122/TALK", "narrator": "つばめ", "text": "怖ぃものは怖ぃし(´つω・｀)ｼｭﾝ"},
        { "location": "123/TALK", "narrator": "つばめ", "text": "ガブちゃんとか"},
        { "location": "124/TALK", "narrator": "つばめ", "text": "アーヤさんには"},
        { "location": "125/TALK", "narrator": "つばめ", "text": "笑われちゃぅかもしれなぃけど(o´Д`)=з"},
        { "location": "126/SEL" , "narrator": "（選択肢）", "text": "そんなつばめも可愛いよ"},
        { "location": "127/SEL" , "narrator": "（選択肢）", "text": "神楽には笑われないでよかったね"},
        { "location": "128/ACT" , "narrator": "", "text": "そんなつばめも可愛いよ"},
        { "location": "133/TALK", "narrator": "つばめ", "text": "でも"},
        { "location": "134/TALK", "narrator": "つばめ", "text": "ちょっと嬉しぃかも"},
        { "location": "135/TALK", "narrator": "つばめ", "text": "ヾ(*´ｴ`*)ﾉ ｲｯﾁｬｯﾀ"},
        { "location": "136/ACT" , "narrator": "", "text": "神楽に笑われないでよかったね"},
        { "location": "139/TALK", "narrator": "つばめ", "text": "ぅん"},
        { "location": "140/TALK", "narrator": "つばめ", "text": "ってぃぅか"},
        { "location": "141/TALK", "narrator": "つばめ", "text": "卯月さんは平気なのかな？"},
        { "location": "142/TALK", "narrator": "つばめ", "text": "でも"},
        { "location": "143/TALK", "narrator": "つばめ", "text": "怖ぃし"},
        { "location": "144/SEL" , "narrator": "（選択肢）", "text": "$me$もいるよ"},
        { "location": "145/ACT" , "narrator": "", "text": "$me$もいるよ"},
        { "location": "147/TALK", "narrator": "つばめ", "text": "ぅん"},
        { "location": "148/TALK", "narrator": "つばめ", "text": "頼りにしてます(*´︶`*)"},
        { "location": "152/TALK", "narrator": "つばめ", "text": "ちょっと歩きづらぃかも"},
        { "location": "153/TALK", "narrator": "つばめ", "text": "ぉ話はまた後でねヽ(*´∀｀)ノ"},
        { "location": "158/TALK", "narrator": "透明神楽", "text": "…つばめさん。\nこんな暗い場所で\n歩きスマホしたら――"},
        { "location": "159/TALK", "narrator": "透明神楽", "text": "お化けに連れて\nいかれちゃいますよ？"},
        { "location": "160/TALK", "narrator": "透明つばめ", "text": "や、やめてよぉ！\nそういう怖いこと\n言うの…。"},
        { "location": "162/TALK", "narrator": "透明神楽", "text": "でも、つばめさんは\n可愛いから、\n意外と本当に――"},
        { "location": "168/TALK", "narrator": "透明つばめ", "text": "キャァァァーッ！！"},
        { "location": "169/TALK", "narrator": "透明つばめ", "text": "う、卯月さぁん…。\nわたし…わたし、\nやっぱりもぅ…。"},
        { "location": "170/TALK", "narrator": "透明神楽", "text": "つ、つばめさん。\nそんなに恐がったら\n可愛過ぎて――"},
        { "location": "174/TALK", "narrator": "幽霊", "text": "あ゛あ゛あ゛あ゛！！\nうぅらぁめぇしぃ\nやぁぁぁぁ…。"},
        { "location": "176/TALK", "narrator": "透明つばめ", "text": "んぴっ！？"},
        { "location": "178/TALK", "narrator": "透明神楽", "text": "ま、またそんな\n可愛い声を！！"},
        { "location": "179/TALK", "narrator": "透明つばめ", "text": "も、もうダメェ…！\n卯月さん、早く、\n早く出ようよぉ…！"},
        { "location": "181/TALK", "narrator": "透明神楽", "text": "ま、まあまあ、\n落ち着いてください。"},
        { "location": "182/TALK", "narrator": "透明神楽", "text": "そんな可愛い声で\n怯えていたら――"},
        { "location": "183/TALK", "narrator": "透明神楽", "text": "魅了されたお化け\nさん達が集まって\nきちゃいますよ？"},
        { "location": "185/TALK", "narrator": "透明つばめ", "text": "魅了って何！？\n意味わからないよ！"},
        { "location": "186/TALK", "narrator": "透明神楽", "text": "大丈夫です。\n私はわかりますから！"},
        { "location": "189/TALK", "narrator": "透明つばめ", "text": "もぉ、お願いだから\n出口に急ごうよぉ！"}
    ]
}
