{
    "dir": "chap03/battle/btev_ch03_03_02.js",
    "type": "",
    "info": {
        "story_id": "23003",
        "cid": "",
        "title": "003 ココロスフィアストーリー【Lv01】",
        "sub_title": "明晰記憶喪失＜帰結＞"
    },
    "entry":
    [
        { "location": "227/SCENARIO", "narrator": "", "text": "バトル終了"},
        { "location": "236/TALK"    , "narrator": "潜在ガブリエラ", "text": "……なんて\n…ことなの？"},
        { "location": "237/TALK"    , "narrator": "表層ガブリエラ", "text": "……。　　　　"},
        { "location": "239/TALK"    , "narrator": "潜在ガブリエラ", "text": "ケダモノ！\n……銃なんて、\n何も…生まないのに…"},
        { "location": "245/TALK"    , "narrator": "表層ガブリエラ", "text": "……。　　　　"},
        { "location": "248/TALK"    , "narrator": "表層ガブリエラ", "text": "ありがと。\nあんたのお陰で\nあたしは救われる。"},
        { "location": "250/SEL"     , "narrator": "（選択肢）", "text": "どういたしまして"},
        { "location": "251/SEL"     , "narrator": "（選択肢）", "text": "過去見せてくれるんでしょ？"},
        { "location": "252/ACT"     , "narrator": "", "text": "どういたしまして"},
        { "location": "253/TALK"    , "narrator": "表層ガブリエラ", "text": "それじゃ約束通り\nあたしの過去を\n見せてあげるわ。"},
        { "location": "254/ACT"     , "narrator": "", "text": "過去見せてくれるんでしょ？"},
        { "location": "255/TALK"    , "narrator": "表層ガブリエラ", "text": "見せるわよ。\nせっかちなんだから。"},
        { "location": "257/TALK"    , "narrator": "表層ガブリエラ", "text": "それは昔のこと。\nあたしが\n初等部だった頃の話よ。"},
        { "location": "278/DIALOG"  , "narrator": "", "text": "あたしの生まれ育った街\nそれは、ポーランド共和国の首都、\nワルシャワだった。"},
        { "location": "280/TALK"    , "narrator": "ガブリエラ", "text": "あーっ、楽しかった！"},
        { "location": "281/TALK"    , "narrator": "ガブリエラ", "text": "また明日も\nアーニャちゃんの\nおうちに行こっと。"},
        { "location": "282/DIALOG"  , "narrator": "", "text": "この頃のポーランドは、\n東西の対立が激化していたこともあり、\nかなり物騒な状況だった。"},
        { "location": "283/TALK"    , "narrator": "ガブリエラ", "text": "いけないわ。\nもうこんな時間！"},
        { "location": "284/TALK"    , "narrator": "ガブリエラ", "text": "早く帰らないと、\nお父様に怒られちゃう。"},
        { "location": "296/DIALOG"  , "narrator": "", "text": "街の治安は悪化し、\n夜出歩くことは\nとても危険なことだった。"},
        { "location": "297/DIALOG"  , "narrator": "", "text": "そして、その情勢不安は\nあたしの家にも\n最悪の事件をもたらしたの。"},
        { "location": "302/SEL"     , "narrator": "（選択肢）", "text": "どういたしまして"},
        { "location": "303/SEL"     , "narrator": "（選択肢）", "text": "デートしてくれるんでしょ？"},
        { "location": "304/ACT"     , "narrator": "", "text": "どういたしまして"},
        { "location": "305/TALK"    , "narrator": "表層ガブリエラ", "text": "それじゃ約束通り\nデート、する？"},
        { "location": "306/SEL"     , "narrator": "（選択肢）", "text": "する！"},
        { "location": "307/ACT"     , "narrator": "", "text": "する！"},
        { "location": "309/ACT"     , "narrator": "", "text": "デートしてくれるんでしょ？"},
        { "location": "310/TALK"    , "narrator": "表層ガブリエラ", "text": "す、するわよ！\nもう、せっかち\nなんだから。"},
        { "location": "332/TALK"    , "narrator": "ガブリエラ", "text": "せっかくだから、\nあたしの故郷の\nワルシャワにしてみた。"},
        { "location": "333/SEL"     , "narrator": "（選択肢）", "text": "どこの国だっけ？"},
        { "location": "334/SEL"     , "narrator": "（選択肢）", "text": "その服かわいい"},
        { "location": "335/ACT"     , "narrator": "", "text": "どこの国だっけ？"},
        { "location": "337/TALK"    , "narrator": "ガブリエラ", "text": "ポーランドよ！\nポーランドの首都！"},
        { "location": "338/ACT"     , "narrator": "", "text": "その服かわいい"},
        { "location": "344/DIALOG"  , "narrator": "", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"},
        { "location": "349/TALK"    , "narrator": "ガブリエラ", "text": "えっ！？　うそよ……\nちょっと子供っぽくて\n恥ずかしいのに。"},
        { "location": "350/TALK"    , "narrator": "ガブリエラ", "text": "昔ポーランドにいた頃\n着ていた服なのよ。"},
        { "location": "353/TALK"    , "narrator": "ガブリエラ", "text": "当時のポーランドは\n情勢不安が酷くて\n大変だったわ。"},
        { "location": "354/TALK"    , "narrator": "ガブリエラ", "text": "今でも\nそうなんでしょうけど。"},
        { "location": "355/TALK"    , "narrator": "ガブリエラ", "text": "だからすごく治安が\n悪くて。こんなに\n綺麗な街なのにね。"},
        { "location": "356/SEL"     , "narrator": "（選択肢）", "text": "大変だったね"},
        { "location": "357/ACT"     , "narrator": "", "text": "大変だったね"},
        { "location": "359/TALK"    , "narrator": "ガブリエラ", "text": "そう。\n大変だったわ。"},
        { "location": "361/TALK"    , "narrator": "ガブリエラ", "text": "私の家も、\n被害にあったもの。"},
        { "location": "362/SEL"     , "narrator": "（選択肢）", "text": "え？　だいじょうぶ！？"},
        { "location": "363/ACT"     , "narrator": "", "text": "え？　だいじょうぶ！？"},
        { "location": "365/TALK"    , "narrator": "ガブリエラ", "text": "……あまり。"},
        { "location": "366/TALK"    , "narrator": "ガブリエラ", "text": "…聞いてくれる？\n何があったか。"},
        { "location": "379/DIALOG"  , "narrator": "", "text": "強盗。"},
        { "location": "381/DIALOG"  , "narrator": "", "text": "あいつらは、うちのことを\n前もって調べていたみたい。\n\nお父様が一番油断する\n夕食後の団欒を\n狙って襲ってきたのだから。"},
        { "location": "383/DIALOG"  , "narrator": "", "text": "銃を取る間もなく、\nお母様は強盗に\n羽交い締めにされたわ。\n\nそして、\nお父様の説得の甲斐も無く――"},
        { "location": "399/DIALOG"  , "narrator": "", "text": "お母様は\n殺された。"},
        { "location": "412/TALK"    , "narrator": "表層ガブリエラ", "text": "この事件があって、\nあたしは銃を撃つとき\n必ず抵抗を感じるの。"},
        { "location": "414/TALK"    , "narrator": "表層ガブリエラ", "text": "それは、さっきの\nもう一人のあたしの\nような――"},
        { "location": "415/TALK"    , "narrator": "表層ガブリエラ", "text": "もう銃を見るのも嫌\nっていうあたしが\n心の中にいるから。"},
        { "location": "416/TALK"    , "narrator": "表層ガブリエラ", "text": "でも、ドーム戦の時の\n抵抗は凄かったわ。"},
        { "location": "417/TALK"    , "narrator": "表層ガブリエラ", "text": "いつもだったら\nあたし一人で抑え\n込めたんだけど……。"},
        { "location": "418/TALK"    , "narrator": "表層ガブリエラ", "text": "もしかしたら、\n何か別の要因が\nあるのかも。"},
        { "location": "419/SEL"     , "narrator": "（選択肢）", "text": "どんな？"},
        { "location": "420/ACT"     , "narrator": "", "text": "どんな？"},
        { "location": "422/TALK"    , "narrator": "表層ガブリエラ", "text": "それはあたしには\nわからないわ。"},
        { "location": "423/TALK"    , "narrator": "表層ガブリエラ", "text": "あたしが教えられる\nのは、これくらいね。"},
        { "location": "424/TALK"    , "narrator": "表層ガブリエラ", "text": "ともあれ、あの時\nあんたが助けてくれた\nことは感謝してる。"},
        { "location": "425/TALK"    , "narrator": "表層ガブリエラ", "text": "今回のことも……。"},
        { "location": "427/TALK"    , "narrator": "表層ガブリエラ", "text": "あ、ありがと。"},
        { "location": "428/TALK"    , "narrator": "表層ガブリエラ", "text": "お陰で落ち着いて\n撃てそう。"},
        { "location": "429/SEL"     , "narrator": "（選択肢）", "text": "どういたしまして"},
        { "location": "430/ACT"     , "narrator": "", "text": "どういたしまして"},
        { "location": "432/TALK"    , "narrator": "表層ガブリエラ", "text": "それじゃ、\nあたしはこれで。"},
        { "location": "434/TALK"    , "narrator": "表層ガブリエラ", "text": "また縁があったら\nここで会いましょ。"},
        { "location": "458/TALK"    , "narrator": "千羽鶴", "text": "おめでとう。"},
        { "location": "459/TALK"    , "narrator": "千羽鶴", "text": "あなたは彼女の\nココロの迷いを解消し、\n一歩前進させた。"},
        { "location": "460/SEL"     , "narrator": "（選択肢）", "text": "えっへん"},
        { "location": "461/SEL"     , "narrator": "（選択肢）", "text": "あまり実感ない"},
        { "location": "462/SEL"     , "narrator": "（選択肢）", "text": "本当にこれで良かったのだろうか"},
        { "location": "463/ACT"     , "narrator": "", "text": "えっへん"},
        { "location": "464/TALK"    , "narrator": "千羽鶴", "text": "そうね。\n今回ばかりは\n誇っていいと思う。"},
        { "location": "465/ACT"     , "narrator": "", "text": "あまり実感ない"},
        { "location": "466/TALK"    , "narrator": "千羽鶴", "text": "そうね。\nそう思うかも知れない。\nでも――"},
        { "location": "467/ACT"     , "narrator": "", "text": "本当にこれで良かったのだろうか"},
        { "location": "469/TALK"    , "narrator": "千羽鶴", "text": "選択に絶対的な\n正解なんて最初から\n存在しない。"},
        { "location": "471/TALK"    , "narrator": "千羽鶴", "text": "汚い言い方をすれば、\n利己的な選択をし、\n結果が伴えば正解。"},
        { "location": "472/TALK"    , "narrator": "千羽鶴", "text": "それは申し訳無いけど\n今はあなたも知らない\n私の思惑も含めて。"},
        { "location": "473/TALK"    , "narrator": "千羽鶴", "text": "一般的にも、ダメな\n選択をしたと思ったら\n物事が好転したり――"},
        { "location": "474/TALK"    , "narrator": "千羽鶴", "text": "逆に順当な選択をした\nつもりが、後悔する\n結果になったりもする。"},
        { "location": "475/TALK"    , "narrator": "千羽鶴", "text": "大事なのは\n「自分はどうしたいか」"},
        { "location": "476/TALK"    , "narrator": "千羽鶴", "text": "周囲のノイズを遮断し\n自分で決めること。"},
        { "location": "477/TALK"    , "narrator": "千羽鶴", "text": "私があなたにお願い\nしたいのは、あくまで\nそのサポートなの。"},
        { "location": "479/TALK"    , "narrator": "千羽鶴", "text": "人のココロを動かす\nには、いつも大きな\n力が必要とは限らない。"},
        { "location": "480/TALK"    , "narrator": "千羽鶴", "text": "些細なきっかけを\n与えるだけで、整理が\nつくこともある。"},
        { "location": "481/TALK"    , "narrator": "千羽鶴", "text": "そうやって、逃げずに\n決めて、それを実行\nすることは――"},
        { "location": "482/TALK"    , "narrator": "千羽鶴", "text": "次第にココロを\n強くすることに繋がる。"},
        { "location": "483/SEL"     , "narrator": "（選択肢）", "text": "よくわからない"},
        { "location": "484/ACT"     , "narrator": "", "text": "よくわからない"},
        { "location": "486/TALK"    , "narrator": "千羽鶴", "text": "一気に理解は\n出来ないと思う。"},
        { "location": "487/TALK"    , "narrator": "千羽鶴", "text": "とにかくあなたには、\nこれからもずっと、\n今回の様に――"},
        { "location": "488/TALK"    , "narrator": "千羽鶴", "text": "彼女のココロの成長を\n支援してあげて欲しい。"}
    ]
}
