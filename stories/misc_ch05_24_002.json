    [
        { "location": "8033/SCENARIO", "narrator": "", "text": "バナナブレッドの"},
        { "location": "8058/TALK"    , "narrator": "神楽", "text": "バナナブレッドはバナナの入ったパウンドケーキ"},
        { "location": "8059/TALK"    , "narrator": "神楽", "text": "でもバナナブレッドプディングは食パンとバナナとカスタードのケーキ"},
        { "location": "8061/SEL"     , "narrator": "", "text": "似たようなもんじゃないの？"},
        { "location": "8062/SEL"     , "narrator": "", "text": "どっちも甘そう"},
        { "location": "8063/SEL"     , "narrator": "", "text": "全然違う食べ物だね…"},
        { "location": "8064/ACT"     , "narrator": "", "text": "似たようなもんじゃないの？"},
        { "location": "8065/TALK"    , "narrator": "神楽", "text": "全然違う"},
        { "location": "8066/ACT"     , "narrator": "", "text": "どっちも甘そう"},
        { "location": "8067/TALK"    , "narrator": "神楽", "text": "それはその通り"},
        { "location": "8068/ACT"     , "narrator": "", "text": "全然違う食べ物だね…"},
        { "location": "8070/TALK"    , "narrator": "神楽", "text": "ねー！"},
        { "location": "8072/TALK"    , "narrator": "神楽", "text": "今までぴょんこ勘違いしてたぴょん"},
        { "location": "8073/TALK"    , "narrator": "神楽", "text": "悔しい、、、"},
        { "location": "8075/TALK"    , "narrator": "神楽", "text": "そんでもってぴょんこはバナナの入ったパウンドケーキとカスタードを組み合わせてバナナブレッドプディングを作ろうと思った"},
        { "location": "8076/TALK"    , "narrator": "神楽", "text": "なぜならぴょんこの中のバナナブレッドプディングはそういう食べ物だったから"},
        { "location": "8078/SEL"     , "narrator": "", "text": "夢を現実にする気だ"},
        { "location": "8079/SEL"     , "narrator": "", "text": "甘すぎるんじゃないかな…"},
        { "location": "8080/SEL"     , "narrator": "", "text": "$me$も食べたいな"},
        { "location": "8081/ACT"     , "narrator": "", "text": "夢を現実にする気だ"},
        { "location": "8082/TALK"    , "narrator": "神楽", "text": "そういうとすごくカッコいい♪"},
        { "location": "8084/TALK"    , "narrator": "神楽", "text": "夢を叶える女ぴょんこ！"},
        { "location": "8085/ACT"     , "narrator": "", "text": "甘すぎるんじゃないかな…"},
        { "location": "8086/TALK"    , "narrator": "神楽", "text": "バナナブレッドは無理だからプディングを甘さ控えめにするぴょん"},
        { "location": "8087/TALK"    , "narrator": "神楽", "text": "それでいけるはず、、、"},
        { "location": "8088/ACT"     , "narrator": "", "text": "$me$も食べたいな"},
        { "location": "8090/TALK"    , "narrator": "神楽", "text": "$handlek$のお口に合うといいけど、、、"},
        { "location": "8091/TALK"    , "narrator": "神楽", "text": "なんてな！"},
        { "location": "8092/TALK"    , "narrator": "神楽", "text": "ぴょんこの料理は絶対おいしいから覚悟しておくこと！！！"},
        { "location": "8093/TALK"    , "narrator": "神楽", "text": "バナナブレッドのプディング♪"}
    ]
}
