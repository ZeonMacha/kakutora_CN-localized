    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "003_そこな越後屋"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "喜べ"},
        { "location": "33/TALK"   , "narrator": "みやび", "text": "帯を取ってきた"},
        { "location": "36/SEL"    , "narrator": "", "text": "わーい"},
        { "location": "37/SEL"    , "narrator": "", "text": "なんで"},
        { "location": "38/SEL"    , "narrator": "", "text": "あーれークルクルクルクル"},
        { "location": "39/ACT"    , "narrator": "", "text": "わーい"},
        { "location": "40/TALK"   , "narrator": "みやび", "text": "迎合"},
        { "location": "41/TALK"   , "narrator": "みやび", "text": "潔しとせず"},
        { "location": "42/ACT"    , "narrator": "", "text": "なんで"},
        { "location": "44/TALK"   , "narrator": "みやび", "text": "なんか"},
        { "location": "45/TALK"   , "narrator": "みやび", "text": "気分で"},
        { "location": "46/ACT"    , "narrator": "", "text": "あーれークルクルクルクル"},
        { "location": "56/TALK"   , "narrator": "みやび", "text": "時代劇で町娘がお代官様にアレされるアレか"},
        { "location": "57/TALK"   , "narrator": "みやび", "text": "その提案は"},
        { "location": "59/TALK"   , "narrator": "みやび", "text": "魅力的だが"},
        { "location": "60/TALK"   , "narrator": "みやび", "text": "あれはファンタジーだ"},
        { "location": "63/TALK"   , "narrator": "みやび", "text": "そんなわけで"},
        { "location": "64/TALK"   , "narrator": "みやび", "text": "アーヤと行ってきたわけだが"},
        { "location": "66/SEL"    , "narrator": "", "text": "アーヤ、喜んでた？"},
        { "location": "67/SEL"    , "narrator": "", "text": "帯はどうだった？"},
        { "location": "68/SEL"    , "narrator": "", "text": "試着してた？"},
        { "location": "69/ACT"    , "narrator": "", "text": "アーヤ、喜んでた？"},
        { "location": "70/TALK"   , "narrator": "みやび", "text": "うむ"},
        { "location": "71/TALK"   , "narrator": "みやび", "text": "意外なほどに"},
        { "location": "72/TALK"   , "narrator": "みやび", "text": "なんでも"},
        { "location": "73/TALK"   , "narrator": "みやび", "text": "凄い、綺麗、素敵、可愛い、らしい"},
        { "location": "74/TALK"   , "narrator": "みやび", "text": "当然だがな"},
        { "location": "77/ACT"    , "narrator": "", "text": "帯はどうだった？"},
        { "location": "78/TALK"   , "narrator": "みやび", "text": "最高"},
        { "location": "79/TALK"   , "narrator": "みやび", "text": "しかし"},
        { "location": "80/TALK"   , "narrator": "みやび", "text": "ひとつ問題が"},
        { "location": "82/TALK"   , "narrator": "みやび", "text": "最高の帯には"},
        { "location": "83/TALK"   , "narrator": "みやび", "text": "最高の着物"},
        { "location": "84/TALK"   , "narrator": "みやび", "text": "それが世の理"},
        { "location": "86/TALK"   , "narrator": "みやび", "text": "だが"},
        { "location": "87/TALK"   , "narrator": "みやび", "text": "資金不足！"},
        { "location": "90/ACT"    , "narrator": "", "text": "試着してた？"},
        { "location": "91/TALK"   , "narrator": "みやび", "text": "あ？"},
        { "location": "92/TALK"   , "narrator": "みやび", "text": "アーヤがか？"},
        { "location": "93/TALK"   , "narrator": "みやび", "text": "反物を当てるくらいはしたぞ"},
        { "location": "94/TALK"   , "narrator": "みやび", "text": "仕立て上がりなら安いのもあると言ったんだが"},
        { "location": "95/TALK"   , "narrator": "みやび", "text": "色々と面倒だからそれはいいだと"},
        { "location": "97/TALK"   , "narrator": "みやび", "text": "まあ"},
        { "location": "98/TALK"   , "narrator": "みやび", "text": "着物でバイクは乗れんしね"},
        { "location": "52/DIALOG" , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"}
    ]
}
