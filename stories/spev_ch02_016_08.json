    [
        { "location": "496/SCENARIO", "narrator": "", "text": "三日月と猫の爪"},
        { "location": "498/TALK"    , "narrator": "アーヤ", "text": "どっちに見える？"},
        { "location": "499/TALK"    , "narrator": "アーヤ", "text": "実は"},
        { "location": "500/TALK"    , "narrator": "アーヤ", "text": "ネコ派"},
        { "location": "501/TALK"    , "narrator": "アーヤ", "text": "トライナリーでも猫派が絶対的多数だったわ"},
        { "location": "503/SEL"     , "narrator": "", "text": "猫かわいいしね"},
        { "location": "504/SEL"     , "narrator": "", "text": "犬の方が好きだけど"},
        { "location": "505/SEL"     , "narrator": "", "text": "動物はあんまり……"},
        { "location": "506/SEL"     , "narrator": "", "text": "$me$はアーヤ派"},
        { "location": "507/ACT"     , "narrator": "", "text": "猫かわいいしね"},
        { "location": "508/TALK"    , "narrator": "アーヤ", "text": "かわいいわ"},
        { "location": "509/TALK"    , "narrator": "アーヤ", "text": "それは否定しない"},
        { "location": "510/ACT"     , "narrator": "", "text": "犬の方が好きだけど"},
        { "location": "511/TALK"    , "narrator": "アーヤ", "text": "犬もいいわよね"},
        { "location": "512/ACT"     , "narrator": "", "text": "動物はあんまり……"},
        { "location": "513/TALK"    , "narrator": "アーヤ", "text": "あら"},
        { "location": "514/TALK"    , "narrator": "アーヤ", "text": "そうだったの"},
        { "location": "515/ACT"     , "narrator": "", "text": "$me$はアーヤ派"},
        { "location": "516/TALK"    , "narrator": "アーヤ", "text": "それを言うなら"},
        { "location": "517/TALK"    , "narrator": "アーヤ", "text": "私は$handle$さん派"},
        { "location": "518/TALK"    , "narrator": "アーヤ", "text": "って"},
        { "location": "519/TALK"    , "narrator": "アーヤ", "text": "ちょっと恥ずかしい、、、"},
        { "location": "521/TALK"    , "narrator": "アーヤ", "text": "うちにね"},
        { "location": "522/TALK"    , "narrator": "アーヤ", "text": "猫の親子がやってくるのよ"},
        { "location": "523/TALK"    , "narrator": "アーヤ", "text": "みんな猫がかわいいって大騒ぎ"},
        { "location": "525/SEL"     , "narrator": "", "text": "そのうち飽きると思うけど"},
        { "location": "526/SEL"     , "narrator": "", "text": "あんまり興味ないなー"},
        { "location": "527/SEL"     , "narrator": "", "text": "猫和むよね"},
        { "location": "528/ACT"     , "narrator": "", "text": "そのうち飽きると思うけど"},
        { "location": "529/TALK"    , "narrator": "アーヤ", "text": "そうかもね"},
        { "location": "530/ACT"     , "narrator": "", "text": "あんまり興味ないなー"},
        { "location": "531/TALK"    , "narrator": "アーヤ", "text": "そうなのね"},
        { "location": "532/ACT"     , "narrator": "", "text": "猫和むよね"},
        { "location": "533/TALK"    , "narrator": "アーヤ", "text": "そうなのよ"},
        { "location": "534/TALK"    , "narrator": "アーヤ", "text": "あのかわいさ"},
        { "location": "535/TALK"    , "narrator": "アーヤ", "text": "反則だわ"},
        { "location": "536/TALK"    , "narrator": "アーヤ", "text": "抱っことかしたいけど"},
        { "location": "537/TALK"    , "narrator": "アーヤ", "text": "させてくれないのよ(-ω-;)"},
        { "location": "538/TALK"    , "narrator": "アーヤ", "text": "でもそういうところも"},
        { "location": "539/TALK"    , "narrator": "アーヤ", "text": "猫らしくていい"},
        { "location": "541/TALK"    , "narrator": "アーヤ", "text": "そのうち親離れすると思うけど"},
        { "location": "542/TALK"    , "narrator": "アーヤ", "text": "そうしたら親猫だけ来るようになるのかしら"},
        { "location": "543/TALK"    , "narrator": "アーヤ", "text": "そうなったら少し"},
        { "location": "544/TALK"    , "narrator": "アーヤ", "text": "さみしいわ"},
        { "location": "545/TALK"    , "narrator": "アーヤ", "text": "仕方ないけど"}
    ]
}
