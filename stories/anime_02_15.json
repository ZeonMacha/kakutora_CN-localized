{
    "dir": "chap15/daydra/anime_02_15.js",
    "type": "MainStory",
    "info": {
        "story_id": "15201",
        "cid": "ayami",
        "title": "001 アニメーション",
        "sub_title": "ロード・オブ・アキバ"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "アニメ第11話"},
        { "location": "47/TALK"   , "narrator": "千羽鶴", "text": "ごきげんよう、\n$handle$。"},
        { "location": "49/TALK"   , "narrator": "千羽鶴", "text": "いつも通り、今回も\n逢瀬つばめの解説を\nするだけでいい？"},
        { "location": "51/TALK"   , "narrator": "千羽鶴", "text": "いつも通り、今回も\n國政綾水の解説を\nするだけでいい？"},
        { "location": "53/TALK"   , "narrator": "千羽鶴", "text": "いつも通り、今回も\nガブリエラの解説を\nするだけでいい？"},
        { "location": "55/TALK"   , "narrator": "千羽鶴", "text": "いつも通り、今回も\n恋ヶ崎みやびの解説を\nするだけでいい？"},
        { "location": "57/SEL"    , "narrator": "", "text": "はい"},
        { "location": "58/SEL"    , "narrator": "", "text": "いいえ"},
        { "location": "59/ACT"    , "narrator": "", "text": "はい"},
        { "location": "61/TALK"   , "narrator": "千羽鶴", "text": "よかった。\n私も助かる。\nこれぞWIN-WINね。"},
        { "location": "63/ACT"    , "narrator": "", "text": "いいえ"},
        { "location": "64/TALK"   , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "69/TALK"   , "narrator": "千羽鶴", "text": "こんにちは。"},
        { "location": "70/TALK"   , "narrator": "千羽鶴", "text": "今回はのっけから１つ、\n貴方に伝えたい事がある。"},
        { "location": "73/TALK"   , "narrator": "千羽鶴", "text": "反省！"},
        { "location": "74/SEL"    , "narrator": "", "text": "猿かい！"},
        { "location": "75/SEL"    , "narrator": "", "text": "随分とパワフルな反省ですね"},
        { "location": "76/ACT"    , "narrator": "", "text": "猿かい！"},
        { "location": "77/TALK"   , "narrator": "千羽鶴", "text": "うき。"},
        { "location": "79/TALK"   , "narrator": "千羽鶴", "text": "……。"},
        { "location": "80/TALK"   , "narrator": "千羽鶴", "text": "変な事させないで！"},
        { "location": "82/TALK"   , "narrator": "千羽鶴", "text": "お陰で、この２文字に\nよって、私の貴方への\n愛はすべて消費した。"},
        { "location": "83/SEL"    , "narrator": "", "text": "「う」と「き」だけで全消費！！"},
        { "location": "84/SEL"    , "narrator": "", "text": "自分でやったんじゃ…"},
        { "location": "85/ACT"    , "narrator": "", "text": "「う」と「き」だけで全消費！！"},
        { "location": "86/TALK"   , "narrator": "千羽鶴", "text": "そう！\nそれくらいにも、\n私の愛は――"},
        { "location": "89/TALK"   , "narrator": "千羽鶴", "text": "<size=50>薄弱！！</size>"},
        { "location": "90/TALK"   , "narrator": "千羽鶴", "text": "というわけで、私に\nかまけようと思ってる人は\n早々に他の子を攻略して。"},
        { "location": "91/TALK"   , "narrator": "千羽鶴", "text": "そうでない人は、\n「へーそうなんだ」って\n思うだけにしておいて。"},
        { "location": "92/TALK"   , "narrator": "千羽鶴", "text": "というわけで\n本題に戻るけど。"},
        { "location": "93/ACT"    , "narrator": "", "text": "自分でやったんじゃ…"},
        { "location": "94/TALK"   , "narrator": "千羽鶴", "text": "確かに実行者は私。"},
        { "location": "95/TALK"   , "narrator": "千羽鶴", "text": "けど、その因果を\n作ったのは貴方！"},
        { "location": "96/TALK"   , "narrator": "千羽鶴", "text": "よって、この事態を\n招いた原因は貴方にある！"},
        { "location": "97/SEL"    , "narrator": "", "text": "そ、そうですね…"},
        { "location": "98/SEL"    , "narrator": "", "text": "その考え方だと、このアプリを配信した事が更なる因果なのでやはり千羽鶴"},
        { "location": "99/ACT"    , "narrator": "", "text": "そ、そうですね…"},
        { "location": "100/TALK"  , "narrator": "千羽鶴", "text": "わかってくれて助かる。"},
        { "location": "101/TALK"  , "narrator": "千羽鶴", "text": "そんな素直に折れてくれる\n貴方には、とある才能が\nあると思う。"},
        { "location": "102/TALK"  , "narrator": "千羽鶴", "text": "だから、今私が自らの\n会話をジェネレートしつつ\nアナライズした――"},
        { "location": "103/TALK"  , "narrator": "千羽鶴", "text": "その結果として\nはじき出された結論を、\n貴方に共有する。"},
        { "location": "104/TALK"  , "narrator": "千羽鶴", "text": "これは私自身も気づいて\nなかった、私の真相！"},
        { "location": "105/SEL"   , "narrator": "", "text": "なに！？"},
        { "location": "106/SEL"   , "narrator": "", "text": "いえ、そういうのは結構です"},
        { "location": "107/ACT"   , "narrator": "", "text": "なに！？"},
        { "location": "108/TALK"  , "narrator": "千羽鶴", "text": "実は私は……"},
        { "location": "109/TALK"  , "narrator": "千羽鶴", "text": "ツンデレだった！！"},
        { "location": "110/TALK"  , "narrator": "千羽鶴", "text": "私はツンデレ！"},
        { "location": "111/TALK"  , "narrator": "千羽鶴", "text": "ツンデレ千羽鶴！"},
        { "location": "114/TALK"  , "narrator": "千羽鶴", "text": "どーん！"},
        { "location": "115/SEL"   , "narrator": "", "text": "そうなの！？"},
        { "location": "116/SEL"   , "narrator": "", "text": "知ってた"},
        { "location": "117/ACT"   , "narrator": "", "text": "そうなの！？"},
        { "location": "118/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "119/TALK"  , "narrator": "千羽鶴", "text": "私の発言と、その結果と\nして発生した事象を\n統合すると、そうなる。"},
        { "location": "120/TALK"  , "narrator": "千羽鶴", "text": "すなわち、\n１．まずは私が発言する。"},
        { "location": "121/TALK"  , "narrator": "千羽鶴", "text": "２．貴方がそれに\n　　リアクションする。"},
        { "location": "122/TALK"  , "narrator": "千羽鶴", "text": "３．私はそれに否定する。"},
        { "location": "123/TALK"  , "narrator": "千羽鶴", "text": "４．けど、結果的に私は\n　　肯定した行動をとる。"},
        { "location": "124/TALK"  , "narrator": "千羽鶴", "text": "これは典型的なツンデレの\n理論と合致する。"},
        { "location": "125/TALK"  , "narrator": "千羽鶴", "text": "そんな気がしないのなら、\nそれは言葉尻が理屈的\nかつ非感情的だから。"},
        { "location": "126/TALK"  , "narrator": "千羽鶴", "text": "でも、やってることは\nガブリエラと\nだいたい一緒！"},
        { "location": "127/SEL"   , "narrator": "", "text": "ツンデレは自分をツンデレだとは言わないよ"},
        { "location": "128/SEL"   , "narrator": "", "text": "ガブちゃん……"},
        { "location": "129/ACT"   , "narrator": "", "text": "ツンデレは自分をツンデレだとは言わないよ"},
        { "location": "130/TALK"  , "narrator": "千羽鶴", "text": "…！？"},
        { "location": "131/TALK"  , "narrator": "千羽鶴", "text": "確かにそうかも。"},
        { "location": "132/TALK"  , "narrator": "千羽鶴", "text": "もう少し詳細な\n解析が必要かもしれない。"},
        { "location": "133/TALK"  , "narrator": "千羽鶴", "text": "…と。\nそんな話はどうでもいい。"},
        { "location": "134/ACT"   , "narrator": "", "text": "ガブちゃん……"},
        { "location": "135/TALK"  , "narrator": "千羽鶴", "text": "１つだけ\nフォローしておく。"},
        { "location": "137/TALK"  , "narrator": "千羽鶴", "text": "私はガブリエラの\nツンデレ成分は、\n彼女の長所だと思ってる。"},
        { "location": "138/TALK"  , "narrator": "千羽鶴", "text": "ビッグデータによれば、\n可愛いと思われる傾向が\n強い要素だから。"},
        { "location": "139/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "141/TALK"  , "narrator": "千羽鶴", "text": "あくまでデータからの\n分析で、私見は一切\n含まれない結論だから。"},
        { "location": "143/ACT"   , "narrator": "", "text": "知ってた"},
        { "location": "144/TALK"  , "narrator": "千羽鶴", "text": "…！？"},
        { "location": "146/TALK"  , "narrator": "千羽鶴", "text": "貴方の脳を\n私の解析用スパコンとして\n譲って欲しい。"},
        { "location": "147/SEL"   , "narrator": "", "text": "それって千羽鶴流ツンデレでいうところの求婚ですよね"},
        { "location": "148/ACT"   , "narrator": "", "text": "それって千羽鶴流ツンデレでいうところの求婚ですよね"},
        { "location": "150/TALK"  , "narrator": "千羽鶴", "text": "あ、本当に\n脳だけでいいから。"},
        { "location": "152/ACT"   , "narrator": "", "text": "いえ、そういうのは結構です"},
        { "location": "153/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "154/TALK"  , "narrator": "千羽鶴", "text": "しょぼん。"},
        { "location": "156/ACT"   , "narrator": "", "text": "その考え方だと、このアプリを配信した事が更なる因果なのでやはり千羽鶴"},
        { "location": "157/TALK"  , "narrator": "千羽鶴", "text": "なるほど、\n確かにそうかも。"},
        { "location": "158/TALK"  , "narrator": "千羽鶴", "text": "貴方は頭がいい。\nけど、決定的に\n欠落していることがある。"},
        { "location": "159/SEL"   , "narrator": "", "text": "…何でしょう"},
        { "location": "160/ACT"   , "narrator": "", "text": "…何でしょう"},
        { "location": "162/TALK"  , "narrator": "千羽鶴", "text": "デリカシー。"},
        { "location": "163/TALK"  , "narrator": "千羽鶴", "text": "私は結果的に、\n貴方にババを持たせたくて\n先の理論を打ち立てた。"},
        { "location": "164/TALK"  , "narrator": "千羽鶴", "text": "だから貴方は\nそれに従い、\nババを所持するべき！"},
        { "location": "165/SEL"   , "narrator": "", "text": "あ、はい…"},
        { "location": "166/ACT"   , "narrator": "", "text": "あ、はい…"},
        { "location": "168/TALK"  , "narrator": "千羽鶴", "text": "よかった。\nそれじゃ、合意の元で\n貴方の負け。"},
        { "location": "169/TALK"  , "narrator": "千羽鶴", "text": "というわけで。\nそろそろ本題に\n戻っていい？"},
        { "location": "170/TALK"  , "narrator": "千羽鶴", "text": "私はとても反省した。"},
        { "location": "173/ACT"   , "narrator": "", "text": "随分とパワフルな反省ですね"},
        { "location": "174/TALK"  , "narrator": "千羽鶴", "text": "その通り。何事も全力で、\n全エネルギーを使って\nやる。"},
        { "location": "175/TALK"  , "narrator": "千羽鶴", "text": "生きていく上で\n大事なこと。"},
        { "location": "176/TALK"  , "narrator": "千羽鶴", "text": "とにかくそういうわけで、\n私は反省した。"},
        { "location": "178/TALK"  , "narrator": "千羽鶴", "text": "最近すこし、\n貴方と遊びすぎた。"},
        { "location": "179/TALK"  , "narrator": "千羽鶴", "text": "そして本来やるべき\n仕事をしていない事に\n気づいてしまった。"},
        { "location": "180/TALK"  , "narrator": "千羽鶴", "text": "だから今回は、\n本来の仕事に戻り、\n貴方を厳しく審査する！"},
        { "location": "181/SEL"   , "narrator": "", "text": "そんな仕事だっけ？"},
        { "location": "182/ACT"   , "narrator": "", "text": "そんな仕事だっけ？"},
        { "location": "184/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "185/TALK"  , "narrator": "千羽鶴", "text": "私の任務は、貴方と\nトライナリーの彼女たち\nとの親睦を深めること。"},
        { "location": "186/TALK"  , "narrator": "千羽鶴", "text": "その役割があるからこそ、\nラブラブトレーナーの\n称号を授かった。"},
        { "location": "187/SEL"   , "narrator": "", "text": "誰から？"},
        { "location": "188/ACT"   , "narrator": "", "text": "誰から？"},
        { "location": "190/TALK"  , "narrator": "千羽鶴", "text": "私から。"},
        { "location": "191/TALK"  , "narrator": "千羽鶴", "text": "しかしその責務を\n最近は全うしていない。"},
        { "location": "192/TALK"  , "narrator": "千羽鶴", "text": "よって今回は――"},
        { "location": "197/TALK"  , "narrator": "千羽鶴", "text": "抜き打ち審査をする！"},
        { "location": "198/TALK"  , "narrator": "千羽鶴", "text": "というわけで。"},
        { "location": "202/TALK"  , "narrator": "千羽鶴", "text": "今、貴方がどれくらい\n彼女と濃密な交流を\nしているか検索中。"},
        { "location": "203/SEL"   , "narrator": "", "text": "濃密な交流って具体的には？"},
        { "location": "204/ACT"   , "narrator": "", "text": "濃密な交流って具体的には？"},
        { "location": "206/TALK"  , "narrator": "千羽鶴", "text": "TRI-OSの\nシステム名でいえば\n『らぶとーく』。"},
        { "location": "207/TALK"  , "narrator": "千羽鶴", "text": "このシステムを、\nどれくらい活用しているか\nチェックしている。"},
        { "location": "208/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "209/TALK"  , "narrator": "千羽鶴", "text": "結果が出た。"},
        { "location": "210/TALK"  , "narrator": "千羽鶴", "text": "貴方の彼女たちへの\nここまでの交流は……"},
        { "location": "263/TALK"  , "narrator": "千羽鶴", "text": "20点満点中、\n<color=red><size=40>$calc$点！</size></color>"},
        { "location": "265/TALK"  , "narrator": "千羽鶴", "text": "すごい！　\n満点を取るなんて。"},
        { "location": "266/TALK"  , "narrator": "千羽鶴", "text": "貴方こそ、私が探していた\n天下一品の逸材。"},
        { "location": "267/TALK"  , "narrator": "千羽鶴", "text": "これからも\nこの調子で頑張って。"},
        { "location": "268/TALK"  , "narrator": "千羽鶴", "text": "でも、貴方は頑張って\nいるけど、全体で見たら\nまだ全然足りない。"},
        { "location": "270/TALK"  , "narrator": "千羽鶴", "text": "なかなかの高得点。\nとてもいい調子。"},
        { "location": "271/TALK"  , "narrator": "千羽鶴", "text": "貴方の頑張りが、\n今の彼女たちの幸せを\n創っている。"},
        { "location": "272/TALK"  , "narrator": "千羽鶴", "text": "その事を忘れずに、\nこれからも\n頑張って欲しい。"},
        { "location": "273/TALK"  , "narrator": "千羽鶴", "text": "でも、貴方は頑張って\nいるけど、全体で見たら\nまだ全然足りない。"},
        { "location": "275/TALK"  , "narrator": "千羽鶴", "text": "貴方はとても\n頑張ってる。"},
        { "location": "276/TALK"  , "narrator": "千羽鶴", "text": "とても好きな子に\n純愛を貫いてるか、全員と\n交流しようとしてるか。"},
        { "location": "277/TALK"  , "narrator": "千羽鶴", "text": "どちらにしても、\nとても素晴らしいこと。"},
        { "location": "278/TALK"  , "narrator": "千羽鶴", "text": "是非これからも\n貴方の大切だと思う彼女を\n支えてあげて欲しい。"},
        { "location": "279/TALK"  , "narrator": "千羽鶴", "text": "でも、貴方は頑張って\nいるけど、全体で見たら\nまだ全然足りない。"},
        { "location": "281/TALK"  , "narrator": "千羽鶴", "text": "貴方はなかなか\n頑張っていると思う。"},
        { "location": "282/TALK"  , "narrator": "千羽鶴", "text": "とても好きな子に\n純愛を貫いてるか、全員と\n交流しようとしてるか。"},
        { "location": "283/TALK"  , "narrator": "千羽鶴", "text": "どちらにしても、\nとても素晴らしいこと。"},
        { "location": "284/TALK"  , "narrator": "千羽鶴", "text": "是非これからも\n貴方の大切だと思う彼女を\n支えてあげて欲しい。"},
        { "location": "285/TALK"  , "narrator": "千羽鶴", "text": "でも、貴方は頑張って\nいるけど、全体で見たら\nまだ全然足りない。"},
        { "location": "287/TALK"  , "narrator": "千羽鶴", "text": "…貴方には\nもうちょっと頑張って\n欲しいと思ってる。"},
        { "location": "288/TALK"  , "narrator": "千羽鶴", "text": "全体として見ると、\nまだ彼女へのサポートが\n全然足りない。"},
        { "location": "292/TALK"  , "narrator": "千羽鶴", "text": "そこで私は、\nそのことについて\n色々考えてみた。"},
        { "location": "293/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "294/TALK"  , "narrator": "千羽鶴", "text": "ここ重要。千羽鶴、\n仕事ちゃんとしてる\nアピールだから。"},
        { "location": "295/SEL"   , "narrator": "", "text": "ソウデスネ"},
        { "location": "296/ACT"   , "narrator": "", "text": "ソウデスネ"},
        { "location": "298/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "299/TALK"  , "narrator": "千羽鶴", "text": "それで、話を戻すと。"},
        { "location": "300/TALK"  , "narrator": "千羽鶴", "text": "もしかしたら私の考えが\nちょっと間違っていたかも\nしれないと思ってる。"},
        { "location": "301/TALK"  , "narrator": "千羽鶴", "text": "私は貴方と彼女との\n関係向上の為に、あらゆる\n要素を詰め込んだ。"},
        { "location": "302/TALK"  , "narrator": "千羽鶴", "text": "コミュニケーションの\n機会は多いほどいいと\n思っていたのだけど……"},
        { "location": "303/TALK"  , "narrator": "千羽鶴", "text": "貴方にも、時間に\n限りがあるということが\n計算値から抜けていた。"},
        { "location": "304/TALK"  , "narrator": "千羽鶴", "text": "日々の生活の中で\nまる１日TRI-OSを\n触れるわけじゃない。"},
        { "location": "305/TALK"  , "narrator": "千羽鶴", "text": "だから、彼女と交流したい\nけど、やることが多すぎて\n思うように進展しない――"},
        { "location": "306/TALK"  , "narrator": "千羽鶴", "text": "そんなことに\nなってしまっていないかと\n考えてみたりした。"},
        { "location": "307/TALK"  , "narrator": "千羽鶴", "text": "私の使命は、貴方と\n彼女との交流を円滑に\n進めていくこと。"},
        { "location": "308/TALK"  , "narrator": "千羽鶴", "text": "だから私のプログラム\n設計が円滑さを阻害してる\nなら、是正が必要。"},
        { "location": "309/TALK"  , "narrator": "千羽鶴", "text": "その為の意見を、\n貴方から聞きたいと\n思っている。"},
        { "location": "310/SEL"   , "narrator": "", "text": "それは――"},
        { "location": "311/ACT"   , "narrator": "", "text": "それは――"},
        { "location": "313/TALK"  , "narrator": "千羽鶴", "text": "ちょっと待って。\nここでは聞かない。"},
        { "location": "314/TALK"  , "narrator": "千羽鶴", "text": "TRI-OSのコミュニ\nケーションシステムは\n使い勝手はいい。"},
        { "location": "315/TALK"  , "narrator": "千羽鶴", "text": "けど、効率性重視のため、\n貴方の意志を端折って\n短文でまとめてしまう。"},
        { "location": "316/TALK"  , "narrator": "千羽鶴", "text": "それは得てして、\n私すらも期待しない回答を\nはじき出す時がある。"},
        { "location": "317/TALK"  , "narrator": "千羽鶴", "text": "だから今回は、私の\nTRI-OSではなく、貴方の\n世界のSNSを借りる。"},
        { "location": "318/TALK"  , "narrator": "千羽鶴", "text": "貴方が今、私が提供する\n彼女のエピソードを十分に\n見て回れているか。"},
        { "location": "319/TALK"  , "narrator": "千羽鶴", "text": "もし追いつかないなら、\nどれくらいの情報量なら\n適当だと思うか。"},
        { "location": "320/TALK"  , "narrator": "千羽鶴", "text": "もしくは、どういった\n見せ方をすれば、貴方の\nサイクルに合うのか。"},
        { "location": "321/TALK"  , "narrator": "千羽鶴", "text": "そういったものを\n<color=green>#トライナリー千羽鶴への\n回答</color> で答えて。"},
        { "location": "322/TALK"  , "narrator": "千羽鶴", "text": "幸い私は、TRI-OSの\nネットワークで、貴方の\n世界のSNSを見られる。"},
        { "location": "323/TALK"  , "narrator": "千羽鶴", "text": "それを元に、今後彼女の\n姿をどうやって提供するか\n考えてみようと思う。"},
        { "location": "324/SEL"   , "narrator": "", "text": "わかった"},
        { "location": "325/SEL"   , "narrator": "", "text": "答えたら何かくれるの？"},
        { "location": "326/ACT"   , "narrator": "", "text": "わかった"},
        { "location": "327/TALK"  , "narrator": "千羽鶴", "text": "というわけで、\nよろしく。"},
        { "location": "328/ACT"   , "narrator": "", "text": "答えたら何かくれるの？"},
        { "location": "329/TALK"  , "narrator": "千羽鶴", "text": "……そうね。"},
        { "location": "330/TALK"  , "narrator": "千羽鶴", "text": "私にとっても、\nサンプルは沢山必要。"},
        { "location": "331/TALK"  , "narrator": "千羽鶴", "text": "だから、１００人以上の\n人が意見を返して\nくれたなら――"},
        { "location": "336/TALK"  , "narrator": "千羽鶴", "text": "あの稀代のクソゲー、\nちーちゃんラブラブゲーム\nの続編を作ろうと思う。"},
        { "location": "340/TALK"  , "narrator": "千羽鶴", "text": "というわけで、\nよろしく。"},
        { "location": "342/TALK"  , "narrator": "千羽鶴", "text": "よし。\nこれはすごい\n仕事してる感が、ある！"},
        { "location": "344/TALK"  , "narrator": "千羽鶴", "text": "さて。\nそれではお待ちかねの、\n記録映像を見ましょ。"},
        { "location": "346/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/70MB 4:24】</color>"},
        { "location": "347/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/22MB 4:24】</color>"},
        { "location": "348/SEL"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "349/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/70MB 4:24】</color>"},
        { "location": "350/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "356/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/22MB 4:24】</color>"},
        { "location": "357/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "363/ACT"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "364/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "397/TALK"  , "narrator": "千羽鶴", "text": "――というわけで。"},
        { "location": "398/TALK"  , "narrator": "千羽鶴", "text": "笑いあり癒しあり\n強烈なシーンありの\n素敵な回だった。"},
        { "location": "399/TALK"  , "narrator": "千羽鶴", "text": "何か感想があれば。"},
        { "location": "401/SEL"   , "narrator": "", "text": "神楽がつばめのことを、どう思ってるのかわからない"},
        { "location": "402/SEL"   , "narrator": "", "text": "神楽たちが行っていたメイドカフェに行きたい"},
        { "location": "403/SEL"   , "narrator": "", "text": "トライナリーのメンバーのフィギュアは出ないんですか！？"},
        { "location": "404/SEL"   , "narrator": "", "text": "千羽鶴のフィギュアは出ないんですか！？"},
        { "location": "405/SEL"   , "narrator": "", "text": "特にない \n<color=blue>（※先へ進みます）</color>"},
        { "location": "406/ACT"   , "narrator": "", "text": "神楽がつばめのことを、どう思ってるのかわからない"},
        { "location": "407/TALK"  , "narrator": "千羽鶴", "text": "人のココロなんて、\n実際の所、誰だって\n誰のこともわからない。"},
        { "location": "408/TALK"  , "narrator": "千羽鶴", "text": "……とまあ、そんな\n一般論は置いておいて。"},
        { "location": "409/TALK"  , "narrator": "千羽鶴", "text": "もう少し突っ込むと、\n貴方が聞きたいことは、\nどういうこと？"},
        { "location": "410/SEL"   , "narrator": "", "text": "この前つばめの発言にむかついてたし、何か裏がありそう"},
        { "location": "411/SEL"   , "narrator": "", "text": "どんなに仲良しでも、あそこまでするものなの？"},
        { "location": "412/ACT"   , "narrator": "", "text": "この前つばめの発言にむかついてたし、何か裏がありそう"},
        { "location": "413/TALK"  , "narrator": "千羽鶴", "text": "裏がない人間関係なんて、\n無いとは言わないけども\n割と希だと思う。"},
        { "location": "414/TALK"  , "narrator": "千羽鶴", "text": "どんなに唯一無二の親友\nだって、むかつく時は\nあると思うし。"},
        { "location": "415/TALK"  , "narrator": "千羽鶴", "text": "ただ、貴方が言いたいのが\nそういうことではないと\nいうことは解ってる。"},
        { "location": "416/TALK"  , "narrator": "千羽鶴", "text": "実際に何を考えていて、\nどうしたいのかは本人で\nないと解らないけど――"},
        { "location": "417/TALK"  , "narrator": "千羽鶴", "text": "私が貴方に\n贈りたい言葉はこれ。\n『アンヴィバレンツ』。"},
        { "location": "418/TALK"  , "narrator": "千羽鶴", "text": "二律背反と訳す。"},
        { "location": "419/TALK"  , "narrator": "千羽鶴", "text": "人間の行動には大抵\n大小問わず、矛盾した\n感情や事情が発生する。"},
        { "location": "420/TALK"  , "narrator": "千羽鶴", "text": "通常は流せるレベルの\nことでも、重大な問題で\n二律背反が発生すると――"},
        { "location": "421/TALK"  , "narrator": "千羽鶴", "text": "そのココロは\n大きく乱れることになる。"},
        { "location": "422/TALK"  , "narrator": "千羽鶴", "text": "その時の人間の行動は、\n得てして常軌を逸している\n事もある。"},
        { "location": "423/TALK"  , "narrator": "千羽鶴", "text": "とても共感出来るものでは\nないこともある。"},
        { "location": "424/TALK"  , "narrator": "千羽鶴", "text": "けど、そういう事が\n実際に起こりえるからこそ\n事実は小説よりも奇なり。"},
        { "location": "425/TALK"  , "narrator": "千羽鶴", "text": "気になるなら、卯月神楽の\n行動や考えを、今後今以上\nに注目しているといい。"},
        { "location": "426/ACT"   , "narrator": "", "text": "どんなに仲良しでも、あそこまでするものなの？"},
        { "location": "427/TALK"  , "narrator": "千羽鶴", "text": "プリのシーンのこと？"},
        { "location": "428/TALK"  , "narrator": "千羽鶴", "text": "女の子同士の関係では、\nこのくらいはやったりする\n子もいるのは確か。"},
        { "location": "429/TALK"  , "narrator": "千羽鶴", "text": "もちろんそれは、友達と\nしてちょっと深い仲に\nなっているだけだと思う。"},
        { "location": "430/TALK"  , "narrator": "千羽鶴", "text": "ただ、卯月神楽については\n実際の所そういった理由\nだけかどうかは不明。"},
        { "location": "431/TALK"  , "narrator": "千羽鶴", "text": "確かに彼女は、小動物系の\n天然可愛い子が好きだから\n十分それも理由にはなる。"},
        { "location": "432/TALK"  , "narrator": "千羽鶴", "text": "けど、友達になった時期、\n経緯、その他の出来事。"},
        { "location": "433/TALK"  , "narrator": "千羽鶴", "text": "それらを考慮すれば、\n確かにもやっとしたものが\n残るというのもわかる。"},
        { "location": "435/TALK"  , "narrator": "千羽鶴", "text": "何にしても、一人の考え\nなんてものは、大抵偏った\nものになってしまう。"},
        { "location": "436/TALK"  , "narrator": "千羽鶴", "text": "それは、チュートリアル\nキャラでAIでもある私に\nおいても、同じこと。"},
        { "location": "437/TALK"  , "narrator": "千羽鶴", "text": "もし本当に気になるなら、\n沢山の人と一緒に考えて\nみるのもいいかと思う。"},
        { "location": "438/TALK"  , "narrator": "千羽鶴", "text": "例えばSNSに、\n<color=green>#トライナリー神楽のこと</color>\nとか付けて共有する。"},
        { "location": "439/TALK"  , "narrator": "千羽鶴", "text": "貴方の世界でも熟成してる\n筈の、ネットワークを駆使\nすることも１つの手段。"},
        { "location": "440/TALK"  , "narrator": "千羽鶴", "text": "貴方の疑問を、貴方の力で\n解決できることこそが、\n生きていく上では必要。"},
        { "location": "441/TALK"  , "narrator": "千羽鶴", "text": "貴方にとっての\n良い結果がでることを\n期待してる。"},
        { "location": "442/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "444/ACT"   , "narrator": "", "text": "神楽たちが行っていたメイドカフェに行きたい"},
        { "location": "447/TALK"  , "narrator": "千羽鶴", "text": "そうね。\n貴方の世界にも、この\nお店はあるかもしれない。"},
        { "location": "448/TALK"  , "narrator": "千羽鶴", "text": "そして、あなたの世界にも\n卯月神楽がいれば、そこに\n来ているかもしれない。"},
        { "location": "449/TALK"  , "narrator": "千羽鶴", "text": "このお店は、\n秋葉原の少し上野寄り、\n末広町のあたりにある。"},
        { "location": "450/TALK"  , "narrator": "千羽鶴", "text": "神楽は昔からこのお店が\n好きで、週に１回くらいは\n行っているみたい。"},
        { "location": "451/TALK"  , "narrator": "千羽鶴", "text": "運がよければ、\n何か痕跡を見つけることが\nできるかもしれない。"},
        { "location": "452/TALK"  , "narrator": "千羽鶴", "text": "…でもその前に、\nそのお店が貴方の世界にも\n存在するか、そして――"},
        { "location": "453/TALK"  , "narrator": "千羽鶴", "text": "その痕跡が実際にその\nお店に存在するか。"},
        { "location": "454/TALK"  , "narrator": "千羽鶴", "text": "現実的に考えて、\nその確率はかなり低いと\n言わざるを得ない。"},
        { "location": "455/TALK"  , "narrator": "千羽鶴", "text": "ただ、現実は時として、\n不可思議な確率変動を\n起こしたりするもの。"},
        { "location": "456/TALK"  , "narrator": "千羽鶴", "text": "平たく言えば\n『何が起こってもおかしく\nない』のが現実。"},
        { "location": "457/TALK"  , "narrator": "千羽鶴", "text": "あとは、\n貴方自身の考え次第。"},
        { "location": "460/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "462/ACT"   , "narrator": "", "text": "トライナリーのメンバーのフィギュアは出ないんですか！？"},
        { "location": "463/TALK"  , "narrator": "千羽鶴", "text": "もちろん、\n出るかもしれないし\n出ないかもしれない。"},
        { "location": "464/TALK"  , "narrator": "千羽鶴", "text": "この可能性変動を、\n貴方の世界の有名な言葉で\n言えば――"},
        { "location": "465/TALK"  , "narrator": "千羽鶴", "text": "全ては神の見えざる手に\n委ねられている。"},
        { "location": "466/TALK"  , "narrator": "千羽鶴", "text": "そう。現実とは、\n誰でもない、貴方が\n作り出していく物語。"},
        { "location": "467/TALK"  , "narrator": "千羽鶴", "text": "でももし、どうやって\n作り出していけば良いか\nわからないと言うなら――"},
        { "location": "468/TALK"  , "narrator": "千羽鶴", "text": "まずは <color=green>#トライナリー\nフィギュア欲しい</color> とか\n叫んでみるといい。"},
        { "location": "469/TALK"  , "narrator": "千羽鶴", "text": "渋谷の交差点で叫ぶのが\n恥ずかしいなら、ひとまず\nSNSで叫んでみるとか。"},
        { "location": "470/TALK"  , "narrator": "千羽鶴", "text": "ただ、もちろん\nそれで世界が動くか\nどうかはわからない。"},
        { "location": "471/TALK"  , "narrator": "千羽鶴", "text": "そこには誰も\n責任をとることは\nできない。"},
        { "location": "472/TALK"  , "narrator": "千羽鶴", "text": "けど、貴方が何も\nしなければ何も動かない。\nこれは世界の鉄則。"},
        { "location": "473/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "475/ACT"   , "narrator": "", "text": "千羽鶴のフィギュアは出ないんですか！？"},
        { "location": "476/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "477/SEL"   , "narrator": "", "text": "来るか！？"},
        { "location": "478/ACT"   , "narrator": "", "text": "来るか！？"},
        { "location": "480/TALK"  , "narrator": "千羽鶴", "text": "あ。"},
        { "location": "481/TALK"  , "narrator": "千羽鶴", "text": "待って。\n冷静になって、千羽鶴。"},
        { "location": "482/TALK"  , "narrator": "千羽鶴", "text": "フィギュアが出るか否かに\n攻略対象か否かは\n関係ない。"},
        { "location": "483/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "484/TALK"  , "narrator": "千羽鶴", "text": "出るといいわね。"},
        { "location": "485/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "487/ACT"   , "narrator": "", "text": "特にない \n<color=blue>（※先へ進みます）</color>"},
        { "location": "489/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "496/TALK"  , "narrator": "千羽鶴", "text": "さて、今回の\n逢瀬つばめだけど。"},
        { "location": "497/TALK"  , "narrator": "千羽鶴", "text": "今回については、珍しく\n彼女にとって重大な転機\nとなる選択がない。"},
        { "location": "498/TALK"  , "narrator": "千羽鶴", "text": "そこで！\nむしろ$handle$が\n気にしていそうな……"},
        { "location": "499/TALK"  , "narrator": "千羽鶴", "text": "とある心情について\n焦点が当たる場面が\nあったので、そこにした。"},
        { "location": "500/TALK"  , "narrator": "千羽鶴", "text": "閑話休題的なノリで、\n楽しんで背中を\n押しまくってあげて。"},
        { "location": "501/TALK"  , "narrator": "千羽鶴", "text": "貴方と逢瀬つばめに\nとって、よい日常を。"},
        { "location": "505/TALK"  , "narrator": "千羽鶴", "text": "さて、今回の\n國政綾水だけど。"},
        { "location": "506/TALK"  , "narrator": "千羽鶴", "text": "彼女は今回、記録映像には\n全く姿を現さない。"},
        { "location": "507/TALK"  , "narrator": "千羽鶴", "text": "その為、\nその前日にあった\nとあるシーンを公開する。"},
        { "location": "508/TALK"  , "narrator": "千羽鶴", "text": "その日、彼女は\n横須賀にいた。"},
        { "location": "509/TALK"  , "narrator": "千羽鶴", "text": "それも、逢瀬つばめの\n同級生である\n日向雛と共に。"},
        { "location": "510/TALK"  , "narrator": "千羽鶴", "text": "何故そのような事に\nなっているのかは、\n実際に見て知って欲しい。"},
        { "location": "511/TALK"  , "narrator": "千羽鶴", "text": "レアな組み合わせである事\n以外に何の変哲もない\n日常シーンだけど――"},
        { "location": "512/TALK"  , "narrator": "千羽鶴", "text": "今後の國政綾水の動きを\n左右する、１つのステップ\nになっているため選んだ。"},
        { "location": "513/TALK"  , "narrator": "千羽鶴", "text": "閑話休題的な感じでは\nあるけど、今回も彼女の\nために力を貸して欲しい。"},
        { "location": "514/TALK"  , "narrator": "千羽鶴", "text": "グッドラック。"},
        { "location": "518/TALK"  , "narrator": "千羽鶴", "text": "さて、今回の\nガブリエラだけど――"},
        { "location": "519/TALK"  , "narrator": "千羽鶴", "text": "記録映像には登場\nしなかったため、別の\nエピソードを用意した。"},
        { "location": "520/TALK"  , "narrator": "千羽鶴", "text": "このエピソードには、\n彼女にとっての鍵となる\n要素が含まれている。"},
        { "location": "521/TALK"  , "narrator": "千羽鶴", "text": "この要素は恐らく、\nかなり終盤までずっと\n引っ張るから結構重要。"},
        { "location": "522/TALK"  , "narrator": "千羽鶴", "text": "今回ガブリエラが貴方に\nどこまで打ち明けるかは\n私にはわからない。"},
        { "location": "523/TALK"  , "narrator": "千羽鶴", "text": "けど、彼女を見守って\nいきたいと思ってるなら、\n真摯に対応してあげて。"},
        { "location": "524/TALK"  , "narrator": "千羽鶴", "text": "幸運を祈ってる。"},
        { "location": "528/TALK"  , "narrator": "千羽鶴", "text": "さて、今回の\n恋ヶ崎みやびだけど――"},
        { "location": "529/TALK"  , "narrator": "千羽鶴", "text": "実は直近において言えば、\n今回の４人の中では最も\n重要なことを提示してる。"},
        { "location": "530/TALK"  , "narrator": "千羽鶴", "text": "記録映像の最後で、\nフェノメノンアラートが\n発生していたと思う。"},
        { "location": "531/TALK"  , "narrator": "千羽鶴", "text": "詳しくは次回見てもらう\n予定だけど、このフェノ\nメノンはとても曲者。"},
        { "location": "532/TALK"  , "narrator": "千羽鶴", "text": "それに打ち勝つためには\nどうしても貴方の力が\n必要になってくる。"},
        { "location": "533/TALK"  , "narrator": "千羽鶴", "text": "もっと厳密に言えば、\n恋ヶ崎みやびが自身を\nどう自己判断するか。"},
        { "location": "534/TALK"  , "narrator": "千羽鶴", "text": "その結果、どう行動を\n起こすかで、勝敗が\n決まるといってもいい。"},
        { "location": "535/TALK"  , "narrator": "千羽鶴", "text": "逆に、貴方がここで彼女に\n適切なサポートをすれば、\n次の戦いは勝ったも同然。"},
        { "location": "536/TALK"  , "narrator": "千羽鶴", "text": "それくらい、ここでの\n決断は重要なものになる。"},
        { "location": "537/TALK"  , "narrator": "千羽鶴", "text": "そういうわけで、今回の\n恋ヶ崎みやびに関しては、\n積極的に協力して欲しい。"},
        { "location": "538/TALK"  , "narrator": "千羽鶴", "text": "健闘を祈ってる。"},
        { "location": "334/DIALOG", "narrator": "Event/Dialog_EventPic", "text": "ク ソ ゲ ー 、 \nこ こ に 極 ま れ り 。"},
