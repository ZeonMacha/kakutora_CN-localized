        "title": "Extra002 プレミアムストーリー",
        "sub_title": "高校時代"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "高校時代"},
        { "location": "21/TALK"   , "narrator": "アーヤ", "text": "野球部の練習、\nかなり気合入ってますね。"},
        { "location": "23/TALK"   , "narrator": "真幌", "text": "そりゃそうだ。\nなんたって今年は夏も\n甲子園行き濃厚だからな。"},
        { "location": "25/TALK"   , "narrator": "珠緒先生", "text": "うちの野球部が春の選抜に\n出場して優勝するなんて、\n開校以来初めてですからね。"},
        { "location": "27/TALK"   , "narrator": "真幌", "text": "そうですね。いいところ\nまでは行ったことがある\nみたいですが…。"},
        { "location": "28/TALK"   , "narrator": "アーヤ", "text": "…それにしても、\n女子達の応援が\n凄いですね。"},
        { "location": "29/TALK"   , "narrator": "アーヤ", "text": "今まで応援なんて\nまったくしてなかった\nのに…。"},
        { "location": "31/TALK"   , "narrator": "真幌", "text": "全くだ。\n調子がいいときほど\n応援団は増えるもの。"},
        { "location": "32/TALK"   , "narrator": "真幌", "text": "甲子園球児の彼氏が\n出来れば、箔もつくしな。"},
        { "location": "34/TALK"   , "narrator": "珠緒先生", "text": "いいですねぇ…。\n私も、そんな恋人が\n欲しかったです。"},
        { "location": "36/TALK"   , "narrator": "アーヤ", "text": "あ、あまり褒められない\n理由ですね…。"},
        { "location": "39/TALK"   , "narrator": "珠緒先生", "text": "そういえば、國政さんも\n高校時代は、あれくらい\nモテてたんじゃない？"},
        { "location": "40/TALK"   , "narrator": "真幌", "text": "ああ、そういえば。\n剣道でブイブイいわせて\nいたんだったな。"},
        { "location": "42/TALK"   , "narrator": "アーヤ", "text": "いわせてません！\n普通に剣道してた\nだけですから。"},
        { "location": "43/TALK"   , "narrator": "珠緒先生", "text": "國政さんがうちの学園に\n来るのが決まった時――"},
        { "location": "44/TALK"   , "narrator": "珠緒先生", "text": "高等部の職員室でも、\n凄い話題になったのよ。"},
        { "location": "45/TALK"   , "narrator": "珠緒先生", "text": "剣道の世界選手権に出た\n女子生徒が入ってくる、\nって。"},
        { "location": "46/TALK"   , "narrator": "真幌", "text": "世界選手権出場となれば、\nさぞモテただろう？"},
        { "location": "47/TALK"   , "narrator": "アーヤ", "text": "そんなことないですよ。\nその証拠に、今現在まで\n恋人もいませんし。"},
        { "location": "48/TALK"   , "narrator": "珠緒先生", "text": "國政さんのお目に掛かった\n男子がいなかったのね。"},
        { "location": "49/TALK"   , "narrator": "真幌", "text": "だが、告白とかメルアドの\n交換くらいはしたこと\nあるんじゃないか？"},
        { "location": "53/TALK"   , "narrator": "アーヤ", "text": "ま、まあ、なくはなかった\nですけど…。"},
        { "location": "54/TALK"   , "narrator": "珠緒先生", "text": "あら、ちゃんと青春して\nたんじゃない。"},
        { "location": "55/TALK"   , "narrator": "真幌", "text": "モテないと言う割には、\n意外とモテてたんじゃ\nないか？"},
        { "location": "58/TALK"   , "narrator": "アーヤ", "text": "…どうなんですかね？"},
        { "location": "60/TALK"   , "narrator": "アーヤ", "text": "でも、少なくとも\nあの野球部を応援する\n女子達みたいに――"},
        { "location": "61/TALK"   , "narrator": "アーヤ", "text": "私が男子から声援を\n浴びることはなかった\nですね。"},
        { "location": "62/TALK"   , "narrator": "真幌", "text": "…意外だ。"},
        { "location": "63/TALK"   , "narrator": "珠緒先生", "text": "そうですね。\n國政さん、見た目だって\n凄い美人なのに…。"},
        { "location": "64/TALK"   , "narrator": "真幌", "text": "まあ、陸上や新体操に\n比べて、男子受けは\n悪いのかもしれんな。"},
        { "location": "65/TALK"   , "narrator": "珠緒先生", "text": "でも、それを抜かしても、\n國政さん程の子を放って\nおくなんて…。"},
        { "location": "67/TALK"   , "narrator": "真幌", "text": "ですね。\n相当ヘタレな男が\n多かったに違いない。"},
        { "location": "69/TALK"   , "narrator": "アーヤ", "text": "ど、どうなんですかね？\n私にはなんとも…。"},
        { "location": "72/TALK"   , "narrator": "アーヤ", "text": "って、いけない！\n講義が始まるので、\n失礼します！"},
        { "location": "75/TALK"   , "narrator": "真幌", "text": "…逃げたな。"},
        { "location": "76/TALK"   , "narrator": "珠緒先生", "text": "逃げちゃいましたね。"},
        { "location": "86/TALK"   , "narrator": "アーヤ", "text": "はぁ…自然に逃げたつもり\nだけど、怪しまれなかった\nかしら？"},
        { "location": "87/TALK"   , "narrator": "アーヤ", "text": "まさか、私の話に\nなるなんて…。"},
        { "location": "88/TALK"   , "narrator": "アーヤ", "text": "…………。"},
        { "location": "103/TALK"  , "narrator": "アーヤ", "text": "すっごい変なこと聞くけど"},
        { "location": "104/TALK"  , "narrator": "アーヤ", "text": "私って、そんなにモテたように見える？"},
        { "location": "106/SEL"   , "narrator": "", "text": "モテなかったの？"},
        { "location": "107/ACT"   , "narrator": "", "text": "モテなかったの？"},
        { "location": "110/TALK"  , "narrator": "アーヤ", "text": "やっぱり、そう見えるのかしら…"},
        { "location": "112/TALK"  , "narrator": "アーヤ", "text": "でも、"},
        { "location": "113/TALK"  , "narrator": "アーヤ", "text": "本当に男子からモテなかったの"},
        { "location": "115/SEL"   , "narrator": "", "text": "女子からモテたとか？"},
        { "location": "116/SEL"   , "narrator": "", "text": "ちょっと寂しいね"},
        { "location": "117/ACT"   , "narrator": "", "text": "女子からモテたとか？"},
        { "location": "120/TALK"  , "narrator": "アーヤ", "text": "正解…"},
        { "location": "121/TALK"  , "narrator": "アーヤ", "text": "悲しいことにね(T_T)"},
        { "location": "122/TALK"  , "narrator": "アーヤ", "text": "あ！"},
        { "location": "123/TALK"  , "narrator": "アーヤ", "text": "女子からは告白されたことないから！"},
        { "location": "124/TALK"  , "narrator": "アーヤ", "text": "ただ、男らしくてかっこいい、って"},
        { "location": "125/TALK"  , "narrator": "アーヤ", "text": "毎日のように言われ続けて…"},
        { "location": "126/TALK"  , "narrator": "アーヤ", "text": "応援してもらえるのは嬉しいけど、複雑だったわ…"},
        { "location": "128/SEL"   , "narrator": "", "text": "今は素敵な女の子だ"},
        { "location": "129/SEL"   , "narrator": "", "text": "よっ、男前！"},
        { "location": "130/ACT"   , "narrator": "", "text": "今は素敵な女の子だ"},
        { "location": "132/TALK"  , "narrator": "アーヤ", "text": "お世辞でも嬉しいわ"},
        { "location": "136/ACT"   , "narrator": "", "text": "よっ、男前！"},
        { "location": "137/TALK"  , "narrator": "アーヤ", "text": "女よ！"},
        { "location": "140/ACT"   , "narrator": "", "text": "ちょっと寂しいね"},
        { "location": "141/TALK"  , "narrator": "アーヤ", "text": "そうでもなかったけど…"},
        { "location": "143/SEL"   , "narrator": "", "text": "まだ何か隠してるね？"},
        { "location": "144/ACT"   , "narrator": "", "text": "まだ何か隠してるね？"},
        { "location": "147/TALK"  , "narrator": "アーヤ", "text": "近所の剣道クラブのちびっ子達に、凄く懐かれてた(-ω-;)"},
        { "location": "149/TALK"  , "narrator": "アーヤ", "text": "実は、告白もその子達からされたもので…"},
        { "location": "150/TALK"  , "narrator": "アーヤ", "text": "でも、男子に違いないから、ウソじゃないし"},
        { "location": "151/TALK"  , "narrator": "アーヤ", "text": "それに、近所のおじちゃんやおばちゃんとか"},
        { "location": "152/TALK"  , "narrator": "アーヤ", "text": "女子からの人気は、さっきの野球部以上だったから"},
        { "location": "153/TALK"  , "narrator": "アーヤ", "text": "本当、寂しくはなかったの"},
        { "location": "154/TALK"  , "narrator": "アーヤ", "text": "そういうことよ"},
        { "location": "166/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "167/TALK"  , "narrator": "アーヤ", "text": "あれはあれで嬉しかった\nけど――"},
        { "location": "169/TALK"  , "narrator": "アーヤ", "text": "やっぱり、モテては\nいなかったなぁ…。"},
        { "location": "18/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>5月13日　10:02 AM</color>\nＷＡＶＥ戦翌週、午前中に学園校庭にて。"}
    ]
}
