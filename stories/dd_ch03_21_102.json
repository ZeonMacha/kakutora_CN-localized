{
    "dir": "chap21/daydra/dd_ch03_21_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "21305",
        "cid": "gabriella",
        "title": "005 メインストーリー",
        "sub_title": "胸騒ぎの鼻＜後編＞"
    },
    "entry":
    [
        { "location": "572/TALK"  , "narrator": "ガブリエラ", "text": "…やっぱり、手くらい\n握ってあげよう。"},
        { "location": "574/TALK"  , "narrator": "ガブリエラ", "text": "こんな暗いんだし。"},
        { "location": "575/TALK"  , "narrator": "ガブリエラ", "text": "先輩として\n後輩を気に掛けるのは\n当たり前よね…。"},
        { "location": "576/TALK"  , "narrator": "ガブリエラ", "text": "…よしっ！"},
        { "location": "581/TALK"  , "narrator": "ガブリエラ", "text": "…つばめ、手出して。\n握っててあげるから。"},
        { "location": "584/TALK"  , "narrator": "つばめ", "text": "え？"},
        { "location": "585/TALK"  , "narrator": "ガブリエラ", "text": "やせ我慢してんの\nバレバレよ。"},
        { "location": "587/TALK"  , "narrator": "ガブリエラ", "text": "そんなんで転んだり\nされても迷惑だし？"},
        { "location": "589/TALK"  , "narrator": "ガブリエラ", "text": "奥に行くまで、\nあたしが引っ張って\nあげるわ。"},
        { "location": "590/TALK"  , "narrator": "つばめ", "text": "…ありがと、\nガブちゃん。"},
        { "location": "591/TALK"  , "narrator": "つばめ", "text": "でも大丈夫だよ。"},
        { "location": "593/TALK"  , "narrator": "ガブリエラ", "text": "…強がってるでしょ？"},
        { "location": "594/TALK"  , "narrator": "つばめ", "text": "そ、そんなこと\nないよ。"},
        { "location": "595/TALK"  , "narrator": "つばめ", "text": "それに、手を繋いだら\n歩きにくくなるから。"},
        { "location": "596/TALK"  , "narrator": "つばめ", "text": "ガブちゃんも\n転んじゃうかも\nしれないし。"},
        { "location": "598/TALK"  , "narrator": "ガブリエラ", "text": "…あっそ。\nなら、気を付けて\n歩きなさいよ？"},
        { "location": "599/TALK"  , "narrator": "つばめ", "text": "う、うん…。"},
        { "location": "603/TALK"  , "narrator": "ガブリエラ", "text": "…なによ、せっかく\n気にしてやったって\nいうのに…。"},
        { "location": "604/TALK"  , "narrator": "ガブリエラ", "text": "無理に強がったって、\n自分が辛いだけじゃ\nない。"},
        { "location": "605/TALK"  , "narrator": "ガブリエラ", "text": "まあ、あたしのことも\n心配してくれてる\nのよね。"},
        { "location": "606/TALK"  , "narrator": "ガブリエラ", "text": "悪い気はしない\nけど…。"},
        { "location": "607/TALK"  , "narrator": "ガブリエラ", "text": "…なんか、反応に困る\n断られ方だわ。"},
        { "location": "634/TALK"  , "narrator": "みやび", "text": "…そろそろ到着や。"},
        { "location": "635/TALK"  , "narrator": "ガブリエラ", "text": "え？　なんかここ、\nちょっと明るい？"},
        { "location": "637/TALK"  , "narrator": "アーヤ", "text": "…あっ、凄いわ！\nほら、天井に穴が\n空いてる！"},
        { "location": "640/TALK"  , "narrator": "つばめ", "text": "え…わぁ！\n空が見えますよ！"},
        { "location": "642/TALK"  , "narrator": "ガブリエラ", "text": "本当…みやび、\nここって何なの？"},
        { "location": "644/TALK"  , "narrator": "みやび", "text": "さあ？　うちもよくは\n知らん。"},
        { "location": "646/TALK"  , "narrator": "みやび", "text": "けんど、この場所は\n暗くて静かやき、\n考え事に最適ちや。"},
        { "location": "647/TALK"  , "narrator": "みやび", "text": "やき、時々一人で来る\n秘密の場所ながよ。"},
        { "location": "649/TALK"  , "narrator": "神楽", "text": "こういう場所、\nテレビでは\n見ますけど。"},
        { "location": "650/TALK"  , "narrator": "神楽", "text": "実際に来たのは\n初めてです。"},
        { "location": "652/TALK"  , "narrator": "みやび", "text": "まあ、そこまで\nロマンチックな場所\nではないけんどな。"},
        { "location": "654/TALK"  , "narrator": "アーヤ", "text": "…どんなところに\n行くつもりなのかって\n思ったけど。"},
        { "location": "656/TALK"  , "narrator": "アーヤ", "text": "想像以上に面白い\nところに連れてきて\nもらえたわ。"},
        { "location": "658/TALK"  , "narrator": "みやび", "text": "…ガブちゃんは\nどうや？"},
        { "location": "660/TALK"  , "narrator": "ガブリエラ", "text": "合格よ。"},
        { "location": "661/TALK"  , "narrator": "ガブリエラ", "text": "どうせなら\nもっと早く教えて\nほしかったわ。"},
        { "location": "663/TALK"  , "narrator": "みやび", "text": "秘密の場所\n言うたやろ？"},
        { "location": "664/TALK"  , "narrator": "みやび", "text": "みんなは特別やき、\n教えたがよ。"},
        { "location": "666/TALK"  , "narrator": "つばめ", "text": "洞窟の中にいるのに\n空が見えるなんて、\nちょっと不思議だね。"},
        { "location": "668/TALK"  , "narrator": "神楽", "text": "ふふっ、そうですね。"},
        { "location": "670/TALK"  , "narrator": "ガブリエラ", "text": "…つばめも、\nこれでもう怖くない\nみたいね。"},
        { "location": "671/TALK"  , "narrator": "つばめ", "text": "それにしても、\n高い穴だねー。"},
        { "location": "672/TALK"  , "narrator": "つばめ", "text": "上から覗いたら、\nちょっと怖いかも。"},
        { "location": "673/TALK"  , "narrator": "神楽", "text": "外からだと、真っ暗な\n穴にしか見えないと\n思いますしね。"},
        { "location": "675/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "687/TALK"  , "narrator": "ガブリエラ", "text": "ねえ$marzanna$"},
        { "location": "688/TALK"  , "narrator": "ガブリエラ", "text": "あなたはどんな時なら"},
        { "location": "689/TALK"  , "narrator": "ガブリエラ", "text": "手をつないでもいいと思う？"},
        { "location": "691/SEL"   , "narrator": "", "text": "恋人同士の時"},
        { "location": "692/SEL"   , "narrator": "", "text": "子供と歩く時"},
        { "location": "693/SEL"   , "narrator": "", "text": "犯人を捕まえた時"},
        { "location": "694/ACT"   , "narrator": "", "text": "恋人同士の時"},
        { "location": "695/TALK"  , "narrator": "ガブリエラ", "text": "確かにそうかも////////////////"},
        { "location": "696/TALK"  , "narrator": "ガブリエラ", "text": "だったら"},
        { "location": "697/TALK"  , "narrator": "ガブリエラ", "text": "断られても仕方ないかも"},
        { "location": "699/SEL"   , "narrator": "", "text": "つばめとは友達だからね"},
        { "location": "700/SEL"   , "narrator": "", "text": "恋人は$me$だからね"},
        { "location": "701/ACT"   , "narrator": "", "text": "つばめとは友達だからね"},
        { "location": "702/TALK"  , "narrator": "ガブリエラ", "text": "そうよね"},
        { "location": "704/TALK"  , "narrator": "ガブリエラ", "text": "その通りよ"},
        { "location": "705/ACT"   , "narrator": "", "text": "恋人は$me$だからね"},
        { "location": "706/TALK"  , "narrator": "ガブリエラ", "text": "もう//////////////"},
        { "location": "707/TALK"  , "narrator": "ガブリエラ", "text": "そんなこと言わないの//////////"},
        { "location": "709/ACT"   , "narrator": "", "text": "子供と歩く時"},
        { "location": "710/TALK"  , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "711/TALK"  , "narrator": "ガブリエラ", "text": "ちゃんと手を引いてあげないとね"},
        { "location": "713/SEL"   , "narrator": "", "text": "つばめはああ見えて高校生だからね"},
        { "location": "714/SEL"   , "narrator": "", "text": "ガブリエラももう中学生だしね"},
        { "location": "715/ACT"   , "narrator": "", "text": "つばめはああ見えて高校生だからね"},
        { "location": "716/TALK"  , "narrator": "ガブリエラ", "text": "もう子供って年じゃないわね"},
        { "location": "717/ACT"   , "narrator": "", "text": "ガブリエラももう中学生だしね"},
        { "location": "718/TALK"  , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "720/TALK"  , "narrator": "ガブリエラ", "text": "って"},
        { "location": "721/TALK"  , "narrator": "ガブリエラ", "text": "私が引く側なんだけど！！"},
        { "location": "723/ACT"   , "narrator": "", "text": "犯人を捕まえた時"},
        { "location": "724/TALK"  , "narrator": "ガブリエラ", "text": "えーと"},
        { "location": "725/TALK"  , "narrator": "ガブリエラ", "text": "何の話をしているのかしら？"},
        { "location": "727/SEL"   , "narrator": "", "text": "民間人でも現行犯逮捕なら可能だから！"},
        { "location": "728/SEL"   , "narrator": "", "text": "ガブリエラ捕物帖"},
        { "location": "729/ACT"   , "narrator": "", "text": "民間人でも現行犯逮捕なら可能だから！"},
        { "location": "730/TALK"  , "narrator": "ガブリエラ", "text": "いえ待って"},
        { "location": "731/TALK"  , "narrator": "ガブリエラ", "text": "そんな話は"},
        { "location": "732/TALK"  , "narrator": "ガブリエラ", "text": "していないわよ！？！？！"},
        { "location": "733/ACT"   , "narrator": "", "text": "ガブリエラ捕物帖"},
        { "location": "734/TALK"  , "narrator": "ガブリエラ", "text": "なんだか"},
        { "location": "735/TALK"  , "narrator": "ガブリエラ", "text": "時代劇みたいで格好いいわｖｖｖｖｖｖｖｖｖｖｖｖｖｖ"},
        { "location": "736/TALK"  , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "737/TALK"  , "narrator": "ガブリエラ", "text": "今したい話とは"},
        { "location": "738/TALK"  , "narrator": "ガブリエラ", "text": "違うんだけど"},
        { "location": "754/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "756/TALK"  , "narrator": "神楽", "text": "つばめさん。"},
        { "location": "758/TALK"  , "narrator": "つばめ", "text": "なあに？"},
        { "location": "759/TALK"  , "narrator": "神楽", "text": "手を繋いでも\nいいですか？"},
        { "location": "761/TALK"  , "narrator": "つばめ", "text": "……えっ！？"},
        { "location": "762/TALK"  , "narrator": "つばめ", "text": "な、何なの\nみんなして！？"},
        { "location": "763/TALK"  , "narrator": "神楽", "text": "みんな？"},
        { "location": "764/TALK"  , "narrator": "つばめ", "text": "えと、さっき\nガブちゃんにも\n言われて…。"},
        { "location": "765/TALK"  , "narrator": "つばめ", "text": "神楽ちゃんも、\nこういうところって\n苦手なの？"},
        { "location": "767/TALK"  , "narrator": "ガブリエラ", "text": "違うわよ！\nあたしはつばめが\n怖がってたから…。"},
        { "location": "769/TALK"  , "narrator": "神楽", "text": "…慣れてない\n場所ですからね…。"},
        { "location": "770/TALK"  , "narrator": "神楽", "text": "少しだけ緊張は\nしてますね…。"},
        { "location": "772/TALK"  , "narrator": "神楽", "text": "だから、って\n思ったんですけど\nダメですか…？"},
        { "location": "773/TALK"  , "narrator": "つばめ", "text": "えとね……。\n手をつなぐと却って\n危ないと思うんだ…。"},
        { "location": "774/TALK"  , "narrator": "つばめ", "text": "だから、ごめんね。"},
        { "location": "776/TALK"  , "narrator": "神楽", "text": "……。"},
        { "location": "778/TALK"  , "narrator": "つばめ", "text": "えっと…\n帰り道は歌でも\n歌っちゃおうか？"},
        { "location": "779/TALK"  , "narrator": "ガブリエラ", "text": "何よ…あたしの時と\n態度が違うじゃ\nない…。"},
        { "location": "781/TALK"  , "narrator": "ガブリエラ", "text": "神楽にばっかり、\nそうやって…。"},
        { "location": "783/TALK"  , "narrator": "ガブリエラ", "text": "あたしに対しては\nそんな素振り、\n全然見せないのに…。"},
        { "location": "785/TALK"  , "narrator": "ガブリエラ", "text": "あたしだって、\n友達なのに…。"},
        { "location": "786/TALK"  , "narrator": "ガブリエラ", "text": "…バカ。"},
        { "location": "789/TALK"  , "narrator": "アーヤ", "text": "ギャヴィ、\n何か言った？"},
        { "location": "792/TALK"  , "narrator": "ガブリエラ", "text": "何でもないわよ！"},
        { "location": "803/DIALOG", "narrator": "Dialog_chapter_ch03", "text": "【17 告白】"}
    ]
}
