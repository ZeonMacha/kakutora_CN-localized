{
    "dir": "chap12/daydra/dd_ch03_12_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "12352",
        "cid": "gabriella",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "お好み焼きについて"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "お好み焼きについて"},
        { "location": "21/TALK"   , "narrator": "つばめ", "text": "お好み焼き屋さん？\n学校の近くにあるなんて\n知らなかったよ。"},
        { "location": "23/TALK"   , "narrator": "ガブリエラ", "text": "…何だか、面白そうな\n話をしてるわね。"},
        { "location": "24/TALK"   , "narrator": "ガブリエラ", "text": "でも、この辺りに\nお好み焼き屋なんて\nあったかしら？"},
        { "location": "26/TALK"   , "narrator": "雛", "text": "一本路地に入らなくちゃ\nいけない店なんだ。\n穴場スポットってやつ。"},
        { "location": "27/TALK"   , "narrator": "雛", "text": "お店は小さいんだけど、\n凄く美味しいんだよ！"},
        { "location": "28/TALK"   , "narrator": "繭", "text": "広島風がオススメ。\n一度は食べるべき。"},
        { "location": "30/TALK"   , "narrator": "ガブリエラ", "text": "あれは量が多いから\n苦手なのよねぇ…。"},
        { "location": "32/TALK"   , "narrator": "雛", "text": "ただ、自分で焼かなくちゃ\nいけないのがネックなん\nだよねぇ…。"},
        { "location": "34/TALK"   , "narrator": "ガブリエラ", "text": "あ、そういう店なのね。\nうん、興味失せたわ。"},
        { "location": "38/TALK"   , "narrator": "つばめ", "text": "ひなこちゃんの気持ち、\nよくわかるよ。"},
        { "location": "39/TALK"   , "narrator": "つばめ", "text": "自分で焼くと、どうしても\nひっくり返すのが綺麗に\nできないんだよね。"},
        { "location": "40/TALK"   , "narrator": "繭", "text": "私の場合、鉄板の上が\nいつも惨状になるわ。"},
        { "location": "41/TALK"   , "narrator": "雛", "text": "広島風まで自分達で\n焼かせる鬼畜仕様の\nお店だからねぇ。"},
        { "location": "42/TALK"   , "narrator": "繭", "text": "あれが得意な人なんて、\n店員さん以外は滅多に\nいないと思う。"},
        { "location": "47/TALK"   , "narrator": "つばめ", "text": "う～ん…"},
        { "location": "48/TALK"   , "narrator": "つばめ", "text": "あっ、そうだ！"},
        { "location": "50/TALK"   , "narrator": "つばめ", "text": "ガブちゃんって、\nたこ焼きを焼くの\n得意だったよね？"},
        { "location": "55/TALK"   , "narrator": "ガブリエラ", "text": "えっ！？　ええ、まあ…。"},
        { "location": "58/TALK"   , "narrator": "つばめ", "text": "じゃあ、もしかしたら\nお好み焼きも上手に\n焼けるんじゃない？"},
        { "location": "60/TALK"   , "narrator": "雛", "text": "おっ、意外な特技発覚！\nていうか、さすがは\nガブリエラちゃん！"},
        { "location": "62/TALK"   , "narrator": "繭", "text": "もし得意だとしたら、\nリスペクトに値するわ。"},
        { "location": "63/SEL"    , "narrator": "", "text": "期待に応えよう！"},
        { "location": "64/SEL"    , "narrator": "", "text": "知らないフリをしよう"},
        { "location": "67/TALK"   , "narrator": "ガブリエラ", "text": "ど、どうしよう…\n何だか凄く期待されてる\nみたい。"},
        { "location": "68/TALK"   , "narrator": "ガブリエラ", "text": "お好み焼きを\nひっくり返すの、\n私も苦手なのに…。"},
        { "location": "69/TALK"   , "narrator": "つばめ", "text": "…ガブちゃん？"},
        { "location": "73/TALK"   , "narrator": "ガブリエラ", "text": "…わ、悪いけど、\nお好み焼きは遠慮するわ。"},
        { "location": "74/TALK"   , "narrator": "ガブリエラ", "text": "あたし、たこ焼きの方が\n好きだから…。"},
        { "location": "77/TALK"   , "narrator": "雛", "text": "えーっ！？\nすっごく美味しい\nお店なんだよ！？"},
        { "location": "78/TALK"   , "narrator": "つばめ", "text": "行こうよ、ガブちゃん！"},
        { "location": "81/TALK"   , "narrator": "ガブリエラ", "text": "あたしはいいの！"},
        { "location": "82/TALK"   , "narrator": "ガブリエラ", "text": "でもたこ焼き屋に行く\n時には誘ってちょうだい。"},
        { "location": "85/TALK"   , "narrator": "雛", "text": "はぁ…残念…。"},
        { "location": "87/TALK"   , "narrator": "ガブリエラ", "text": "自分でひっくり返さなくて\nいいお店なら、あたしも\n行きたかったな…。"},
        { "location": "89/ACT"    , "narrator": "", "text": "期待に応えよう！"},
        { "location": "109/TALK"  , "narrator": "ガブリエラ", "text": "期待を裏切って、空気を悪くできないわね"},
        { "location": "110/TALK"  , "narrator": "ガブリエラ", "text": "わかったわ、私、頑張ってみる！"},
        { "location": "122/TALK"  , "narrator": "ガブリエラ", "text": "ええ、出来るわ。"},
        { "location": "124/TALK"  , "narrator": "ガブリエラ", "text": "大丈夫、これはウソじゃ\nないわ。"},
        { "location": "125/TALK"  , "narrator": "ガブリエラ", "text": "緊張はするし、ちょっと\n歪みはするけど、ちゃんと\nひっくり返せはするもの。"},
        { "location": "127/TALK"  , "narrator": "つばめ", "text": "やっぱり！\nさすがはガブちゃん！"},
        { "location": "128/TALK"  , "narrator": "雛", "text": "日本人のあたし達より\n凄い、ってところ、\n尊敬するよ。"},
        { "location": "130/TALK"  , "narrator": "ガブリエラ", "text": "ま、まあ、日本好きとして\n最低限の嗜みよ。"},
        { "location": "132/TALK"  , "narrator": "繭", "text": "ガブリエラさんと\n呼んだ方が良い？"},
        { "location": "135/TALK"  , "narrator": "ガブリエラ", "text": "大袈裟だってば。\nまったく、これくらいの\nことで…。"},
        { "location": "136/TALK"  , "narrator": "ガブリエラ", "text": "っていうか、本当に\n褒め過ぎで不安を感じる\nレベルなんだけど…。"},
        { "location": "138/TALK"  , "narrator": "雛", "text": "じゃあ、近いうちに\nみんなでお好み焼きを\n食べに行こ！"},
        { "location": "140/TALK"  , "narrator": "雛", "text": "ひっくり返し役は\nガブリエラちゃんに\nお願いする、ってことで！"},
        { "location": "142/TALK"  , "narrator": "つばめ", "text": "賛成ー！\nガブちゃん頑張ってね！"},
        { "location": "145/TALK"  , "narrator": "繭", "text": "広島風を上手く焼けたら、\n私のヒーローよ。"},
        { "location": "149/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "151/TALK"  , "narrator": "ガブリエラ", "text": "今夜から、秘密の特訓を\nしないとダメそうね…。"},
        { "location": "152/ACT"   , "narrator": "", "text": "知らないフリをしよう"},
        { "location": "158/TALK"  , "narrator": "ガブリエラ", "text": "あ、あら？\n誰かしら…？"},
        { "location": "172/TALK"  , "narrator": "ガブリエラ", "text": "たこ焼きを知っててお好み焼きを知らないなんて"},
        { "location": "173/TALK"  , "narrator": "ガブリエラ", "text": "そんなの通用するの？"},
        { "location": "174/TALK"  , "narrator": "ガブリエラ", "text": "…不安ではあるけど、ちょっと気になるわ"},
        { "location": "175/TALK"  , "narrator": "ガブリエラ", "text": "マルザンナの言うとおりに言ってみるわ"},
        { "location": "188/TALK"  , "narrator": "ガブリエラ", "text": "え、えっと…根本的な\nところから聞くけど…。"},
        { "location": "190/TALK"  , "narrator": "ガブリエラ", "text": "お好み焼きって、なに？"},
        { "location": "192/TALK"  , "narrator": "繭", "text": "…え？"},
        { "location": "195/TALK"  , "narrator": "つばめ", "text": "ガブちゃん、もしかして\nお好み焼き知らないの？"},
        { "location": "197/TALK"  , "narrator": "ガブリエラ", "text": "は、初めて聞くわ。\nどんな食べ物なのかしら？"},
        { "location": "200/TALK"  , "narrator": "雛", "text": "たこ焼きは知ってるのに\nお好み焼きを知らない\nなんて、あるんだね。"},
        { "location": "202/TALK"  , "narrator": "ガブリエラ", "text": "あたしもそれがすっごい\n疑問ではあるんだけど…。"},
        { "location": "205/TALK"  , "narrator": "繭", "text": "これは、焼けるか\nどうか以前の問題ね。"},
        { "location": "207/TALK"  , "narrator": "雛", "text": "そうだね…近いうちに、\nガブリエラちゃんを\nお店に連れて行かないと。"},
        { "location": "209/TALK"  , "narrator": "ガブリエラ", "text": "えっ！？"},
        { "location": "210/TALK"  , "narrator": "雛", "text": "たこ焼きが好きなら、\nお好み焼きだって\n絶対気に入るよ。"},
        { "location": "211/TALK"  , "narrator": "雛", "text": "焼くのは難しいけど、\n凄く美味しいしね。"},
        { "location": "212/TALK"  , "narrator": "つばめ", "text": "お野菜とお肉いっぱいで、\n一枚でお腹いっぱいに\nなるんだよ。"},
        { "location": "214/TALK"  , "narrator": "ガブリエラ", "text": "そ、そう…わかったわ。\n近いうちに行きましょ。"},
        { "location": "215/TALK"  , "narrator": "ガブリエラ", "text": "あたし、お好み焼きも\n大好きだから楽しみだわ。"},
        { "location": "217/TALK"  , "narrator": "雛", "text": "もちろん、そのときの\nひっくり返す係りは\nガブリエラちゃんね。"},
        { "location": "220/TALK"  , "narrator": "ガブリエラ", "text": "な、なんで！？\nあたし、お好み焼きのこと\n知らないのに！"},
        { "location": "221/TALK"  , "narrator": "雛", "text": "だからこそ、実際にやって\n難しさを知った方がいい\nでしょ？"},
        { "location": "222/TALK"  , "narrator": "雛", "text": "本当に難しいから、\nビックリすると思うよ。"},
        { "location": "224/TALK"  , "narrator": "繭", "text": "何事も経験。\n経験するなら早い方が\nいいわ。"},
        { "location": "226/TALK"  , "narrator": "ガブリエラ", "text": "ひっくり返す時の緊張感が\n苦手なのに…。"},
        { "location": "227/TALK"  , "narrator": "ガブリエラ", "text": "でも、せっかく初体験だと\n思われてるんだし――"},
        { "location": "229/TALK"  , "narrator": "ガブリエラ", "text": "気楽にやってみよう\nかしら？"},
        { "location": "20/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>6月30日　12:25 PM</color>\nとある平日の昼休み、学園内路地にて。"}
    ]
}
