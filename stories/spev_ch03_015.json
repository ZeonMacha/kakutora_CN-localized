{
    "dir": "chap00/daydra/spev_ch03_015.js",
    "type": "",
    "info": {
        "story_id": "3015",
        "cid": "",
        "title": "スペシャルエピソード",
        "sub_title": "ガブッとズッキュン★"
    },
    "entry":
    [
        { "location": "29/TALK" , "narrator": "ガブリエラ", "text": "ふう、一時は\nどうなるかと\n思ったけど…"},
        { "location": "31/TALK" , "narrator": "ガブリエラ", "text": "取り返した材料の\nおかげで\nチョコが作れたわ。"},
        { "location": "32/TALK" , "narrator": "ガブリエラ", "text": "我ながら\nなかなかの出来ね。"},
        { "location": "33/TALK" , "narrator": "透明天原真希詩", "text": "頑張って作っていた\nようだけど――"},
        { "location": "34/TALK" , "narrator": "透明天原真希詩", "text": "一体誰に渡すつもり\nなんだい？"},
        { "location": "35/TALK" , "narrator": "ガブリエラ", "text": "えっと…\nそれは…。"},
        { "location": "36/TALK" , "narrator": "ガブリエラ", "text": "ハッキリと相手を\n言うのもちょっと\n恥ずかしいわね…。"},
        { "location": "37/SEL"  , "narrator": "（選択肢）", "text": "$me$が欲しい！！"},
        { "location": "38/ACT"  , "narrator": "", "text": "$me$が欲しい！！"},
        { "location": "53/TALK" , "narrator": "ガブリエラ", "text": "そんなにがっついてこなくても"},
        { "location": "55/TALK" , "narrator": "ガブリエラ", "text": "ちゃんとあげるわよ"},
        { "location": "56/TALK" , "narrator": "ガブリエラ", "text": "$marzanna$の為に作ったんだから"},
        { "location": "57/TALK" , "narrator": "ガブリエラ", "text": "色々なドライフルーツを入れてみたの"},
        { "location": "58/TALK" , "narrator": "ガブリエラ", "text": "気に入ってもらえると嬉しいわ"},
        { "location": "60/SEL"  , "narrator": "（選択肢）", "text": "ガブリエラの作ったものなら何でも"},
        { "location": "61/SEL"  , "narrator": "（選択肢）", "text": "美味しそう！"},
        { "location": "62/ACT"  , "narrator": "", "text": "ガブリエラの作ったものなら何でも"},
        { "location": "63/TALK" , "narrator": "ガブリエラ", "text": "まあ！"},
        { "location": "64/TALK" , "narrator": "ガブリエラ", "text": "そう言ってくれるのは嬉しいけど"},
        { "location": "65/TALK" , "narrator": "ガブリエラ", "text": "それはそれで作り甲斐がない気もするわ"},
        { "location": "66/ACT"  , "narrator": "", "text": "美味しそう！"},
        { "location": "67/TALK" , "narrator": "ガブリエラ", "text": "もちろん美味しいに決まっているわ"},
        { "location": "68/TALK" , "narrator": "ガブリエラ", "text": "レシピを自分なりにアレンジしてみたの"},
        { "location": "70/TALK" , "narrator": "ガブリエラ", "text": "入れるドライフルーツの種類に"},
        { "location": "71/TALK" , "narrator": "ガブリエラ", "text": "こだわったの"},
        { "location": "72/TALK" , "narrator": "ガブリエラ", "text": "$marzanna$の好きなフルーツが入ってればいいんだけど"},
        { "location": "73/TALK" , "narrator": "ガブリエラ", "text": "楽しみにしててね"},
        { "location": "86/TALK" , "narrator": "ガブリエラ", "text": "ひ…秘密よ！"},
        { "location": "87/TALK" , "narrator": "透明天原真希詩", "text": "えー、いいじゃーん。\n教えてよー。"},
        { "location": "89/TALK" , "narrator": "ガブリエラ", "text": "だーめっ！絶対に\n教えないんだから。"},
        { "location": "90/TALK" , "narrator": "透明天原真希詩", "text": "よっぽど大事な\n相手なんだね…。"},
        { "location": "91/TALK" , "narrator": "透明天原真希詩", "text": "よし！"},
        { "location": "92/TALK" , "narrator": "透明天原真希詩", "text": "それならその相手に\n渡す時は、とびっきり\n気合入れて渡さないと。"},
        { "location": "93/TALK" , "narrator": "ガブリエラ", "text": "気合…？"},
        { "location": "94/TALK" , "narrator": "透明天原真希詩", "text": "そう！\n可愛さを追求すれば\n効果バツグンだよ！"},
        { "location": "95/TALK" , "narrator": "ガブリエラ", "text": "バツグンって…\n何の効果よ。"},
        { "location": "96/TALK" , "narrator": "透明天原真希詩", "text": "日本式のバレンタインは\n女の子にとって\n特別な儀式なんだよ。"},
        { "location": "97/TALK" , "narrator": "透明天原真希詩", "text": "とびっきり可愛い\nキメ顔で渡さないと！"},
        { "location": "99/TALK" , "narrator": "ガブリエラ", "text": "キ…キメ顔…？"},
        { "location": "100/TALK", "narrator": "ガブリエラ", "text": "べ、別にそんなこと\nしなくたって\n渡せればいいのよ！"},
        { "location": "101/TALK", "narrator": "透明天原真希詩", "text": "ダメダメ！！\n他の女の子はもっと\n全力だよ！"},
        { "location": "102/TALK", "narrator": "透明天原真希詩", "text": "そのために私も普段の\n天狗の衣装から\nこの恰好になったのさ"},
        { "location": "103/TALK", "narrator": "ガブリエラ", "text": "そ、そうなの…。"},
        { "location": "105/TALK", "narrator": "透明天原真希詩", "text": "さあ、ガブリエラも\n今できる最大の\nカワイイ渡し方を――"},
        { "location": "107/TALK", "narrator": "透明天原真希詩", "text": "今ここで\n練習するんだよ！\nさあ、これを持って！"},
        { "location": "119/TALK", "narrator": "透明ガブリエラ", "text": "う、う～ん…。"},
        { "location": "120/SEL" , "narrator": "（選択肢）", "text": "$me$もカワイイガブリエラが見たい！"},
        { "location": "121/ACT" , "narrator": "", "text": "$me$もカワイイガブリエラが見たい！"},
        { "location": "126/TALK", "narrator": "ガブリエラ", "text": "もう！$marzanna$まで何言ってるのよ！"},
        { "location": "129/SEL" , "narrator": "（選択肢）", "text": "ごめん…"},
        { "location": "130/SEL" , "narrator": "（選択肢）", "text": "カワイイキメ顔見たかったからつい…"},
        { "location": "131/ACT" , "narrator": "", "text": "ごめん…"},
        { "location": "132/TALK", "narrator": "ガブリエラ", "text": "怒ってるわけじゃないのよ"},
        { "location": "133/ACT" , "narrator": "", "text": "カワイイキメ顔見たかったからつい…"},
        { "location": "134/TALK", "narrator": "ガブリエラ", "text": "ついじゃないわよ"},
        { "location": "136/TALK", "narrator": "ガブリエラ", "text": "でも"},
        { "location": "137/TALK", "narrator": "ガブリエラ", "text": "$marzanna$が喜んでくれるなら"},
        { "location": "138/TALK", "narrator": "ガブリエラ", "text": "頑張ってみようかしら…"},
        { "location": "140/TALK", "narrator": "透明ガブリエラ", "text": "わ、わかったわ。"},
        { "location": "141/TALK", "narrator": "透明ガブリエラ", "text": "やってみるから\nアドバイスを頂戴ね。"},
        { "location": "142/TALK", "narrator": "透明天原真希詩", "text": "フッフッフ…。\n天狗の私に任せれば\n間違いはないよ。"},
        { "location": "144/TALK", "narrator": "透明ガブリエラ", "text": "天狗は関係ないと\n思うけど…"},
        { "location": "145/TALK", "narrator": "透明天原真希詩", "text": "大事なのはチョコの\n構え方と――"},
        { "location": "146/TALK", "narrator": "透明天原真希詩", "text": "手、足、首の角度！\nそして表情！"},
        { "location": "147/TALK", "narrator": "透明ガブリエラ", "text": "こ、こう…？"},
        { "location": "148/TALK", "narrator": "透明天原真希詩", "text": "表情が硬いよ！"},
        { "location": "149/TALK", "narrator": "透明天原真希詩", "text": "もっと笑顔！\nそして恥ずかしがらない\nことが大事！"},
        { "location": "150/TALK", "narrator": "透明ガブリエラ", "text": "むむむ…。"},
        { "location": "151/TALK", "narrator": "透明ガブリエラ", "text": "えいっ！"},
        { "location": "152/TALK", "narrator": "透明天原真希詩", "text": "まだ！\nもう一押し！"},
        { "location": "153/TALK", "narrator": "透明ガブリエラ", "text": "う、うぅ～。"},
        { "location": "154/SEL" , "narrator": "（選択肢）", "text": "頑張って！"},
        { "location": "155/ACT" , "narrator": "", "text": "頑張って！"},
        { "location": "160/TALK", "narrator": "ガブリエラ", "text": "ちょっと！"},
        { "location": "161/TALK", "narrator": "ガブリエラ", "text": "恥ずかしいから見ないでよ！"},
        { "location": "162/TALK", "narrator": "ガブリエラ", "text": "全然できてないみたいだし…"},
        { "location": "163/SEL" , "narrator": "（選択肢）", "text": "ガブリエラらしくやれば問題ないよ"},
        { "location": "164/SEL" , "narrator": "（選択肢）", "text": "十分可愛いよ"},
        { "location": "165/ACT" , "narrator": "", "text": "ガブリエラらしくやれば問題ないよ"},
        { "location": "166/TALK", "narrator": "ガブリエラ", "text": "私らしく…ね"},
        { "location": "167/TALK", "narrator": "ガブリエラ", "text": "私は普段こんなことしないから"},
        { "location": "168/TALK", "narrator": "ガブリエラ", "text": "そもそも私らしくないと思うけど…"},
        { "location": "169/ACT" , "narrator": "", "text": "十分可愛いよ"},
        { "location": "170/TALK", "narrator": "ガブリエラ", "text": "もう！からかってるの？"},
        { "location": "172/TALK", "narrator": "ガブリエラ", "text": "いつまでも続けるのも辛いし次で最後にするわ"},
        { "location": "174/TALK", "narrator": "透明ガブリエラ", "text": "よし、これでキメるわ！"},
        { "location": "175/TALK", "narrator": "透明天原真希詩", "text": "おおっ！\nその意気だよ！"},
        { "location": "178/TALK", "narrator": "透明ガブリエラ", "text": "ぐぬぬ…えいっ！"},
        { "location": "180/TALK", "narrator": "透明ガブリエラ", "text": "ど、どうかしら…。"},
        { "location": "181/TALK", "narrator": "透明天原真希詩", "text": "良い！\n凄く良いよ！完璧！"},
        { "location": "182/SEL" , "narrator": "（選択肢）", "text": "カワイイーー！"},
        { "location": "183/ACT" , "narrator": "", "text": "カワイイーー！"},
        { "location": "188/TALK", "narrator": "ガブリエラ", "text": "よ、喜んでもらえたようでよかったけど"},
        { "location": "189/TALK", "narrator": "ガブリエラ", "text": "恥ずかしい…"},
        { "location": "191/TALK", "narrator": "ガブリエラ", "text": "ここまでやったんだから"},
        { "location": "192/TALK", "narrator": "ガブリエラ", "text": "ありがたく受け取りなさいよ！"}
    ]
}
