        { "location": "398/SCENARIO", "narrator": "", "text": "520_貴方のすきなもの"},
        { "location": "423/TALK"    , "narrator": "ガブリエラ", "text": "夕焼け空がとても綺麗だったの"},
        { "location": "424/TALK"    , "narrator": "ガブリエラ", "text": "だから写真に撮ってみたの"},
        { "location": "425/TALK"    , "narrator": "ガブリエラ", "text": "そちらはどんなお天気かしら？"},
        { "location": "427/SEL"     , "narrator": "", "text": "いい天気だよ"},
        { "location": "428/SEL"     , "narrator": "", "text": "最悪"},
        { "location": "429/SEL"     , "narrator": "", "text": "まあまあかな"},
        { "location": "430/ACT"     , "narrator": "", "text": "いい天気だよ"},
        { "location": "431/TALK"    , "narrator": "ガブリエラ", "text": "こっちと同じなのね"},
        { "location": "433/TALK"    , "narrator": "ガブリエラ", "text": "そう"},
        { "location": "434/TALK"    , "narrator": "ガブリエラ", "text": "よかったわ"},
        { "location": "435/ACT"     , "narrator": "", "text": "最悪"},
        { "location": "436/TALK"    , "narrator": "ガブリエラ", "text": "あら・・・"},
        { "location": "437/TALK"    , "narrator": "ガブリエラ", "text": "残念だわね・・・"},
        { "location": "439/SEL"     , "narrator": "", "text": "でもガブと話せたからいいかな"},
        { "location": "440/ACT"     , "narrator": "", "text": "でもガブと話せたからいいかな"},
        { "location": "450/TALK"    , "narrator": "ガブリエラ", "text": "またそんなことばっかり言って！"},
        { "location": "453/SEL"     , "narrator": "", "text": "本当のことだから"},
        { "location": "454/ACT"     , "narrator": "", "text": "本当のことだから"},
        { "location": "455/TALK"    , "narrator": "ガブリエラ", "text": "本当に"},
        { "location": "456/TALK"    , "narrator": "ガブリエラ", "text": "口がうまいんだから・・・"},
        { "location": "458/ACT"     , "narrator": "", "text": "まあまあかな"},
        { "location": "459/TALK"    , "narrator": "ガブリエラ", "text": "それは"},
        { "location": "460/TALK"    , "narrator": "ガブリエラ", "text": "普通ってことなのね"},
        { "location": "461/TALK"    , "narrator": "ガブリエラ", "text": "きっと"},
        { "location": "463/TALK"    , "narrator": "ガブリエラ", "text": "ねえ"},
        { "location": "464/TALK"    , "narrator": "ガブリエラ", "text": "お天気の話は興味なかったかしら？"},
        { "location": "466/SEL"     , "narrator": "", "text": "そんなことないよ"},
        { "location": "467/SEL"     , "narrator": "", "text": "あんまりないかな"},
        { "location": "468/ACT"     , "narrator": "", "text": "そんなことないよ"},
        { "location": "469/ACT"     , "narrator": "", "text": "あんまりないかな"},
        { "location": "471/TALK"    , "narrator": "ガブリエラ", "text": "そう"},
        { "location": "472/TALK"    , "narrator": "ガブリエラ", "text": "他にはどんなお話がしたいのかしら？"},
        { "location": "474/SEL"     , "narrator": "", "text": "聞いてどうするの？"},
        { "location": "475/SEL"     , "narrator": "", "text": "$handle$と話したくて仕方ないんだね"},
        { "location": "476/ACT"     , "narrator": "", "text": "聞いてどうするの？"},
        { "location": "477/TALK"    , "narrator": "ガブリエラ", "text": "えっ"},
        { "location": "478/TALK"    , "narrator": "ガブリエラ", "text": "そんなの"},
        { "location": "480/TALK"    , "narrator": "ガブリエラ", "text": "なんでもいいでしょ？？？"},
        { "location": "481/ACT"     , "narrator": "", "text": "$handle$と話したくて仕方ないんだね"},
        { "location": "482/TALK"    , "narrator": "ガブリエラ", "text": "えっ"},
        { "location": "483/TALK"    , "narrator": "ガブリエラ", "text": "何言い出すの"},
        { "location": "485/TALK"    , "narrator": "ガブリエラ", "text": "もう知らない！！！！！！"},
        { "location": "487/TALK"    , "narrator": "ガブリエラ", "text": "意地悪ばっかり"},
        { "location": "489/TALK"    , "narrator": "ガブリエラ", "text": "しないでちょうだいね？"},
        { "location": "492/TALK"    , "narrator": "ボイスメール", "text": "どんな天気もいい天気"},
        { "location": "446/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>1000pt.</b></color></size>\nアップしました！"},
