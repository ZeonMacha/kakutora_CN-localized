        "title": "005 メインストーリー",
        "sub_title": "いびつで丸いこの世界＜後編＞"
    },
    "entry":
    [
        { "location": "807/SCENARIO", "narrator": "", "text": "そのうたは"},
        { "location": "822/TALK"    , "narrator": "つばめ", "text": "$handle$さん……。"},
        { "location": "834/TALK"    , "narrator": "つばめ", "text": "ぇとね"},
        { "location": "835/TALK"    , "narrator": "つばめ", "text": "ぉ返事はしなくてぃぃょ"},
        { "location": "836/TALK"    , "narrator": "つばめ", "text": "危険な時は"},
        { "location": "837/TALK"    , "narrator": "つばめ", "text": "だからこれは"},
        { "location": "838/TALK"    , "narrator": "つばめ", "text": "ぁたしのひとりごと"},
        { "location": "839/TALK"    , "narrator": "つばめ", "text": "だと思って"},
        { "location": "840/TALK"    , "narrator": "つばめ", "text": "ごめんね"},
        { "location": "841/TALK"    , "narrator": "つばめ", "text": "でも"},
        { "location": "842/TALK"    , "narrator": "つばめ", "text": "$handle$さんと全然話せなくなるのは"},
        { "location": "843/TALK"    , "narrator": "つばめ", "text": "ぁたし無理"},
        { "location": "844/TALK"    , "narrator": "つばめ", "text": "絶対無理"},
        { "location": "845/TALK"    , "narrator": "つばめ", "text": "無理なの"},
        { "location": "847/TALK"    , "narrator": "つばめ", "text": "だから"},
        { "location": "848/TALK"    , "narrator": "つばめ", "text": "それだけ"},
        { "location": "849/TALK"    , "narrator": "つばめ", "text": "伝えておくね"},
        { "location": "853/TALK"    , "narrator": "つばめ", "text": "これだったら\n大丈夫だよね…。"},
        { "location": "854/TALK"    , "narrator": "つばめ", "text": "$handle$さんに迷惑\nかからないよね…。"},
        { "location": "858/TALK"    , "narrator": "つばめ", "text": "カレンちゃんの"},
        { "location": "859/TALK"    , "narrator": "つばめ", "text": "ぉ話はしたこと"},
        { "location": "860/TALK"    , "narrator": "つばめ", "text": "なかったょね"},
        { "location": "861/TALK"    , "narrator": "つばめ", "text": "カレンちゃんは"},
        { "location": "863/TALK"    , "narrator": "つばめ", "text": "ぁたしの生きる希望だったんだ"},
        { "location": "865/SEL"     , "narrator": "", "text": "ちょっと待って！"},
        { "location": "866/SEL"     , "narrator": "", "text": "カレンちゃんって…"},
        { "location": "867/SEL"     , "narrator": "", "text": "そういうことだったんだ！？"},
        { "location": "868/ACT"     , "narrator": "", "text": "ちょっと待って！"},
        { "location": "869/TALK"    , "narrator": "つばめ", "text": "$handle$さんだ"},
        { "location": "870/TALK"    , "narrator": "つばめ", "text": "でも"},
        { "location": "871/TALK"    , "narrator": "つばめ", "text": "平気なの？"},
        { "location": "873/ACT"     , "narrator": "", "text": "カレンちゃんって…"},
        { "location": "874/TALK"    , "narrator": "つばめ", "text": "あれ"},
        { "location": "875/TALK"    , "narrator": "つばめ", "text": "カレンちゃんを"},
        { "location": "876/TALK"    , "narrator": "つばめ", "text": "知ってるの？"},
        { "location": "878/ACT"     , "narrator": "", "text": "そういうことだったんだ！？"},
        { "location": "879/TALK"    , "narrator": "つばめ", "text": "えと"},
        { "location": "880/TALK"    , "narrator": "つばめ", "text": "何が？"},
        { "location": "883/SEL"     , "narrator": "", "text": "ココロの司書でしょ"},
        { "location": "884/SEL"     , "narrator": "", "text": "いや、何でもない"},
        { "location": "885/SEL"     , "narrator": "", "text": "Wishrealの主人公だっけ"},
        { "location": "886/ACT"     , "narrator": "", "text": "ココロの司書でしょ"},
        { "location": "887/TALK"    , "narrator": "つばめ", "text": "何それ？"},
        { "location": "888/TALK"    , "narrator": "つばめ", "text": "司書さんなの？"},
        { "location": "889/TALK"    , "narrator": "つばめ", "text": "でもそれは"},
        { "location": "891/TALK"    , "narrator": "つばめ", "text": "違う人だょ"},
        { "location": "893/ACT"     , "narrator": "", "text": "いや、何でもない"},
        { "location": "894/TALK"    , "narrator": "つばめ", "text": "そう？"},
        { "location": "895/TALK"    , "narrator": "つばめ", "text": "変なの"},
        { "location": "897/ACT"     , "narrator": "", "text": "Wishrealの主人公だっけ"},
        { "location": "898/TALK"    , "narrator": "つばめ", "text": "そぅ！"},
        { "location": "900/TALK"    , "narrator": "つばめ", "text": "$handle$さんすごい"},
        { "location": "903/TALK"    , "narrator": "つばめ", "text": "ぇっとね"},
        { "location": "904/TALK"    , "narrator": "つばめ", "text": "カレンちゃんのおはなし"},
        { "location": "905/TALK"    , "narrator": "つばめ", "text": "カレンちゃんのお母さんは"},
        { "location": "906/TALK"    , "narrator": "つばめ", "text": "不治の病に罹ってたの"},
        { "location": "907/TALK"    , "narrator": "つばめ", "text": "でもイシュリールって街なら"},
        { "location": "908/TALK"    , "narrator": "つばめ", "text": "お母さんの病気が治せるって聞いたの"},
        { "location": "909/TALK"    , "narrator": "つばめ", "text": "イシュリールは魔法の街だから"},
        { "location": "910/TALK"    , "narrator": "つばめ", "text": "カレンちゃんは長い長い旅をして"},
        { "location": "911/TALK"    , "narrator": "つばめ", "text": "やっとイシュリールに着くの"},
        { "location": "912/TALK"    , "narrator": "つばめ", "text": "それでウィルって男の子に会うの"},
        { "location": "913/TALK"    , "narrator": "つばめ", "text": "でもウィルは"},
        { "location": "915/TALK"    , "narrator": "つばめ", "text": "治す方法を知ってるけど教えないって"},
        { "location": "916/TALK"    , "narrator": "つばめ", "text": "ひどいでしょ！"},
        { "location": "918/SEL"     , "narrator": "", "text": "ひどいね"},
        { "location": "919/SEL"     , "narrator": "", "text": "治療費がなかったのかな"},
        { "location": "920/SEL"     , "narrator": "", "text": "実はそんなものなかったとか"},
        { "location": "921/ACT"     , "narrator": "", "text": "ひどいね"},
        { "location": "922/TALK"    , "narrator": "つばめ", "text": "でしょ！"},
        { "location": "923/TALK"    , "narrator": "つばめ", "text": "でも本当は"},
        { "location": "924/TALK"    , "narrator": "つばめ", "text": "理由があったんだょ"},
        { "location": "925/ACT"     , "narrator": "", "text": "治療費がなかったのかな"},
        { "location": "926/TALK"    , "narrator": "つばめ", "text": "え"},
        { "location": "927/TALK"    , "narrator": "つばめ", "text": "そぅぃぅ話じゃないょ"},
        { "location": "928/ACT"     , "narrator": "", "text": "実はそんなものなかったとか"},
        { "location": "929/TALK"    , "narrator": "つばめ", "text": "違うょ"},
        { "location": "930/TALK"    , "narrator": "つばめ", "text": "最後まで聞いて"},
        { "location": "932/TALK"    , "narrator": "つばめ", "text": "だからカレンちゃんは一生懸命街を探すの"},
        { "location": "933/TALK"    , "narrator": "つばめ", "text": "お母さんの病気を治すために"},
        { "location": "934/TALK"    , "narrator": "つばめ", "text": "でもやっぱり見つからなくて"},
        { "location": "935/TALK"    , "narrator": "つばめ", "text": "夜になって"},
        { "location": "936/TALK"    , "narrator": "つばめ", "text": "カレンちゃん泣きそうになった時に"},
        { "location": "937/TALK"    , "narrator": "つばめ", "text": "またウィルが来るの"},
        { "location": "938/TALK"    , "narrator": "つばめ", "text": "今度は教えるからって"},
        { "location": "939/TALK"    , "narrator": "つばめ", "text": "何で？ってカレンちゃんが聞いたら"},
        { "location": "940/TALK"    , "narrator": "つばめ", "text": "カレンちゃんの思いは本当だってわかったからって答えるの"},
        { "location": "941/TALK"    , "narrator": "つばめ", "text": "それで"},
        { "location": "942/TALK"    , "narrator": "つばめ", "text": "カレンちゃんが願いながら歌えばお母さんが治るって"},
        { "location": "943/TALK"    , "narrator": "つばめ", "text": "願いが叶うって"},
        { "location": "944/TALK"    , "narrator": "つばめ", "text": "鐘撞き堂で"},
        { "location": "945/TALK"    , "narrator": "つばめ", "text": "水の星ルーディルと火の星フマクトが、丁度満月のルナティリスを挟む時間に"},
        { "location": "946/TALK"    , "narrator": "つばめ", "text": "歌を歌えば"},
        { "location": "948/SEL"     , "narrator": "", "text": "固有名詞多いな！？"},
        { "location": "949/SEL"     , "narrator": "", "text": "カレンは試されたんだね"},
        { "location": "950/SEL"     , "narrator": "", "text": "一件落着だ"},
        { "location": "951/ACT"     , "narrator": "", "text": "固有名詞多いな！？"},
        { "location": "952/TALK"    , "narrator": "つばめ", "text": "ぇっそこ？"},
        { "location": "954/TALK"    , "narrator": "つばめ", "text": "そこなの？"},
        { "location": "955/ACT"     , "narrator": "", "text": "カレンは試されたんだね"},
        { "location": "956/TALK"    , "narrator": "つばめ", "text": "そうだね"},
        { "location": "958/TALK"    , "narrator": "つばめ", "text": "本気でお母さんを治したいかどうか"},
        { "location": "959/ACT"     , "narrator": "", "text": "一件落着だ"},
        { "location": "960/TALK"    , "narrator": "つばめ", "text": "ぇとね"},
        { "location": "961/TALK"    , "narrator": "つばめ", "text": "まだ続きがあるの"},
        { "location": "963/TALK"    , "narrator": "つばめ", "text": "その話を聞いて"},
        { "location": "964/TALK"    , "narrator": "つばめ", "text": "カレンちゃんは歌えないっていうの"},
        { "location": "965/TALK"    , "narrator": "つばめ", "text": "習ったこともないし"},
        { "location": "967/TALK"    , "narrator": "つばめ", "text": "歌ったこともないからって"},
        { "location": "969/SEL"     , "narrator": "", "text": "民俗学的に納得の流れ"},
        { "location": "970/SEL"     , "narrator": "", "text": "音痴なのかな？"},
        { "location": "971/SEL"     , "narrator": "", "text": "いきなりは無理だよね…"},
        { "location": "972/ACT"     , "narrator": "", "text": "民俗学的に納得の流れ"},
        { "location": "973/TALK"    , "narrator": "つばめ", "text": "ぇとょく"},
        { "location": "974/TALK"    , "narrator": "つばめ", "text": "わかんなぃけど"},
        { "location": "975/ACT"     , "narrator": "", "text": "音痴なのかな？"},
        { "location": "976/TALK"    , "narrator": "つばめ", "text": "そういう話じゃないよ？"},
        { "location": "977/TALK"    , "narrator": "つばめ", "text": "でも"},
        { "location": "978/TALK"    , "narrator": "つばめ", "text": "そぅぃぅことなのかな？"},
        { "location": "979/ACT"     , "narrator": "", "text": "いきなりは無理だよね…"},
        { "location": "980/TALK"    , "narrator": "つばめ", "text": "そうでしょ"},
        { "location": "982/TALK"    , "narrator": "つばめ", "text": "そうだょね"},
        { "location": "984/TALK"    , "narrator": "つばめ", "text": "カレンちゃんはどうしようってなるんだけど"},
        { "location": "985/TALK"    , "narrator": "つばめ", "text": "ウィルが言うの"},
        { "location": "986/TALK"    , "narrator": "つばめ", "text": "思いがあればきっと歌えるって"},
        { "location": "987/TALK"    , "narrator": "つばめ", "text": "歌を紡ぐのは想いなんだって"},
        { "location": "988/TALK"    , "narrator": "つばめ", "text": "それで"},
        { "location": "989/TALK"    , "narrator": "つばめ", "text": "カレンちゃんは歌うの"},
        { "location": "990/TALK"    , "narrator": "つばめ", "text": "そうしたら"},
        { "location": "991/TALK"    , "narrator": "つばめ", "text": "街全体が助けてくれたの"},
        { "location": "992/TALK"    , "narrator": "つばめ", "text": "カレンちゃんが歌うのを"},
        { "location": "993/TALK"    , "narrator": "つばめ", "text": "カレンちゃんの想いを叶えるのを"},
        { "location": "995/SEL"     , "narrator": "", "text": "街全体？"},
        { "location": "996/SEL"     , "narrator": "", "text": "クライマックスシーンだ"},
        { "location": "997/SEL"     , "narrator": "", "text": "大画面で見てみたい"},
        { "location": "998/ACT"     , "narrator": "", "text": "街全体？"},
        { "location": "999/TALK"    , "narrator": "つばめ", "text": "そぅ"},
        { "location": "1000/TALK"   , "narrator": "つばめ", "text": "街全体"},
        { "location": "1001/ACT"    , "narrator": "", "text": "クライマックスシーンだ"},
        { "location": "1002/TALK"   , "narrator": "つばめ", "text": "ぅん"},
        { "location": "1004/TALK"   , "narrator": "つばめ", "text": "ぃつもぁたし泣いちゃうの"},
        { "location": "1005/ACT"    , "narrator": "", "text": "大画面で見てみたい"},
        { "location": "1006/TALK"   , "narrator": "つばめ", "text": "カレンちゃんの歌は"},
        { "location": "1007/TALK"   , "narrator": "つばめ", "text": "本当にすごぃんだから"},
        { "location": "1009/TALK"   , "narrator": "つばめ", "text": "ウィルの本当の名前はイシュリールなの"},
        { "location": "1010/TALK"   , "narrator": "つばめ", "text": "イシュリールの街自体がウィルの魔法なの"},
        { "location": "1011/TALK"   , "narrator": "つばめ", "text": "だから街全体がカレンちゃんを助けてくれたんだよ"},
        { "location": "1013/SEL"    , "narrator": "", "text": "なるほど"},
        { "location": "1014/SEL"    , "narrator": "", "text": "王道ファンタジーだ"},
        { "location": "1015/SEL"    , "narrator": "", "text": "東映でアニメ化するのかな？"},
        { "location": "1016/ACT"    , "narrator": "", "text": "なるほど"},
        { "location": "1017/TALK"   , "narrator": "つばめ", "text": "このおはなしも"},
        { "location": "1019/TALK"   , "narrator": "つばめ", "text": "カレンちゃんも"},
        { "location": "1020/TALK"   , "narrator": "つばめ", "text": "大好きなの"},
        { "location": "1021/ACT"    , "narrator": "", "text": "王道ファンタジーだ"},
        { "location": "1022/TALK"   , "narrator": "つばめ", "text": "そぅなの？"},
        { "location": "1023/ACT"    , "narrator": "", "text": "東映でアニメ化するのかな？"},
        { "location": "1024/TALK"   , "narrator": "つばめ", "text": "映画とか？"},
        { "location": "1025/TALK"   , "narrator": "つばめ", "text": "なったら絶対"},
        { "location": "1027/TALK"   , "narrator": "つばめ", "text": "観に行こうっと"},
        { "location": "1031/TALK"   , "narrator": "つばめ", "text": "もう少しお話ししても"},
        { "location": "1032/TALK"   , "narrator": "つばめ", "text": "大丈夫かな"},
        { "location": "1035/TALK"   , "narrator": "つばめ", "text": "ぁたしね"},
        { "location": "1036/TALK"   , "narrator": "つばめ", "text": "トライナリーに入ったの"},
        { "location": "1037/TALK"   , "narrator": "つばめ", "text": "お母さんを治して欲しかったからなの"},
        { "location": "1038/TALK"   , "narrator": "つばめ", "text": "何でも願いを叶えてくれるって言われたから"},
        { "location": "1039/TALK"   , "narrator": "つばめ", "text": "それって"},
        { "location": "1040/TALK"   , "narrator": "つばめ", "text": "カレンちゃんみたいって思って"},
        { "location": "1041/TALK"   , "narrator": "つばめ", "text": "それで"},
        { "location": "1043/TALK"   , "narrator": "つばめ", "text": "辛いことがあっても"},
        { "location": "1044/TALK"   , "narrator": "つばめ", "text": "最後はきっと願いが叶うって思ってた"},
        { "location": "1045/TALK"   , "narrator": "つばめ", "text": "でも"},
        { "location": "1046/TALK"   , "narrator": "つばめ", "text": "そんなことなかった"},
        { "location": "1047/TALK"   , "narrator": "つばめ", "text": "今はこんなだし"},
        { "location": "1048/TALK"   , "narrator": "つばめ", "text": "閉じ込められてるし"},
        { "location": "1050/SEL"    , "narrator": "", "text": "ああ…"},
        { "location": "1051/SEL"    , "narrator": "", "text": "それは残念だったね"},
        { "location": "1052/SEL"    , "narrator": "", "text": "落ち込まないで"},
        { "location": "1053/ACT"    , "narrator": "", "text": "ああ…"},
        { "location": "1054/TALK"   , "narrator": "つばめ", "text": "ね"},
        { "location": "1055/ACT"    , "narrator": "", "text": "それは残念だったね"},
        { "location": "1056/TALK"   , "narrator": "つばめ", "text": "勝手に思ってただけなんだけどね"},
        { "location": "1057/ACT"    , "narrator": "", "text": "落ち込まないで"},
        { "location": "1058/TALK"   , "narrator": "つばめ", "text": "ありがとう"},
        { "location": "1060/TALK"   , "narrator": "つばめ", "text": "でもね"},
        { "location": "1061/TALK"   , "narrator": "つばめ", "text": "ウィルはいるよ"},
        { "location": "1063/TALK"   , "narrator": "つばめ", "text": "$handle$さんって名前の"},
        { "location": "1066/SEL"    , "narrator": "", "text": "$me$が！？"},
        { "location": "1067/SEL"    , "narrator": "", "text": "やっとわかってくれたんだね…"},
        { "location": "1068/SEL"    , "narrator": "", "text": "いや、何もしてないけど"},
        { "location": "1069/ACT"    , "narrator": "", "text": "$me$が！？"},
        { "location": "1071/TALK"   , "narrator": "つばめ", "text": "そぅ"},
        { "location": "1072/TALK"   , "narrator": "つばめ", "text": "$handle$さんはウィル"},
        { "location": "1073/ACT"    , "narrator": "", "text": "やっとわかってくれたんだね…"},
        { "location": "1075/TALK"   , "narrator": "つばめ", "text": "ごめんね"},
        { "location": "1076/TALK"   , "narrator": "つばめ", "text": "気付くのが遅れて"},
        { "location": "1077/TALK"   , "narrator": "つばめ", "text": "でもね"},
        { "location": "1078/TALK"   , "narrator": "つばめ", "text": "$handle$さんは"},
        { "location": "1079/TALK"   , "narrator": "つばめ", "text": "隠してたでしょ"},
        { "location": "1080/TALK"   , "narrator": "つばめ", "text": "ウィルだってこと"},
        { "location": "1081/ACT"    , "narrator": "", "text": "いや、何もしてないけど"},
        { "location": "1083/TALK"   , "narrator": "つばめ", "text": "そんなことないょ"},
        { "location": "1084/TALK"   , "narrator": "つばめ", "text": "いっぱい魔法を使ってくれた"},
        { "location": "1086/TALK"   , "narrator": "つばめ", "text": "$handle$さんが"},
        { "location": "1087/TALK"   , "narrator": "つばめ", "text": "いてくれるから"},
        { "location": "1088/TALK"   , "narrator": "つばめ", "text": "ぁたしもう迷わない"},
        { "location": "1089/TALK"   , "narrator": "つばめ", "text": "卯月さんからもらった"},
        { "location": "1090/TALK"   , "narrator": "つばめ", "text": "イシュリールっていう魔法"},
        { "location": "1091/TALK"   , "narrator": "つばめ", "text": "それからウィル"},
        { "location": "1093/SEL"    , "narrator": "", "text": "卯月さんからもらった？"},
        { "location": "1094/SEL"    , "narrator": "", "text": "ウィルは$me$？"},
        { "location": "1095/SEL"    , "narrator": "", "text": "決めたんだ"},
        { "location": "1096/ACT"    , "narrator": "", "text": "卯月さんからもらった？"},
        { "location": "1097/TALK"   , "narrator": "つばめ", "text": "そぅだよ"},
        { "location": "1098/TALK"   , "narrator": "つばめ", "text": "このお話は"},
        { "location": "1099/TALK"   , "narrator": "つばめ", "text": "フレイメノウのアルバム"},
        { "location": "1100/TALK"   , "narrator": "つばめ", "text": "Wishrealの話だから"},
        { "location": "1101/ACT"    , "narrator": "", "text": "ウィルは$me$？"},
        { "location": "1102/TALK"   , "narrator": "つばめ", "text": "$handle$さん以外"},
        { "location": "1104/TALK"   , "narrator": "つばめ", "text": "誰がいるの？"},
        { "location": "1105/ACT"    , "narrator": "", "text": "決めたんだ"},
        { "location": "1106/TALK"   , "narrator": "つばめ", "text": "ぅん"},
        { "location": "1107/TALK"   , "narrator": "つばめ", "text": "決めたんだ"},
        { "location": "1109/TALK"   , "narrator": "つばめ", "text": "ぁたし"},
        { "location": "1110/TALK"   , "narrator": "つばめ", "text": "卯月さんを助ける"},
        { "location": "1111/TALK"   , "narrator": "つばめ", "text": "絶対に"},
        { "location": "1113/SEL"    , "narrator": "", "text": "つばめが死ぬのはナシだよ"},
        { "location": "1114/SEL"    , "narrator": "", "text": "応援するよ"},
        { "location": "1115/SEL"    , "narrator": "", "text": "ちょっと前、死ぬとか言ってなかった…？"},
        { "location": "1116/ACT"    , "narrator": "", "text": "つばめが死ぬのはナシだよ"},
        { "location": "1117/TALK"   , "narrator": "つばめ", "text": "ぅん"},
        { "location": "1118/TALK"   , "narrator": "つばめ", "text": "わかったょ"},
        { "location": "1119/ACT"    , "narrator": "", "text": "応援するよ"},
        { "location": "1120/TALK"   , "narrator": "つばめ", "text": "ぁりがとぅ"},
        { "location": "1122/TALK"   , "narrator": "つばめ", "text": "そう言ってくれるって"},
        { "location": "1123/TALK"   , "narrator": "つばめ", "text": "信じてた"},
        { "location": "1124/ACT"    , "narrator": "", "text": "ちょっと前、死ぬとか言ってなかった…？"},
        { "location": "1125/TALK"   , "narrator": "つばめ", "text": "もう言わなぃ"},
        { "location": "1127/SEL"    , "narrator": "", "text": "絶対だよ"},
        { "location": "1128/SEL"    , "narrator": "", "text": "思い直してくれてよかった"},
        { "location": "1129/SEL"    , "narrator": "", "text": "$me$も神楽も泣くところだった"},
        { "location": "1130/ACT"    , "narrator": "", "text": "絶対だよ"},
        { "location": "1131/TALK"   , "narrator": "つばめ", "text": "$handle$さんが"},
        { "location": "1132/TALK"   , "narrator": "つばめ", "text": "そう言うなら絶対"},
        { "location": "1133/ACT"    , "narrator": "", "text": "思い直してくれてよかった"},
        { "location": "1134/TALK"   , "narrator": "つばめ", "text": "ぅん"},
        { "location": "1135/TALK"   , "narrator": "つばめ", "text": "もぅ言わなぃから"},
        { "location": "1136/ACT"    , "narrator": "", "text": "$me$も神楽も泣くところだった"},
        { "location": "1137/TALK"   , "narrator": "つばめ", "text": "ごめんね"},
        { "location": "1139/TALK"   , "narrator": "つばめ", "text": "悲しぃ思いさせて"},
        { "location": "1142/TALK"   , "narrator": "つばめ", "text": "見ててね$handle$さん"},
        { "location": "1143/TALK"   , "narrator": "つばめ", "text": "ぁたしがちゃんと謳いきるまで"},
        { "location": "1144/TALK"   , "narrator": "つばめ", "text": "願いを全部叶えるまで"},
        { "location": "1160/TALK"   , "narrator": "つばめ", "text": "！！！！"},
        { "location": "1166/TALK"   , "narrator": "千羽鶴", "text": "逢瀬つばめ\nすぐに行く。"},
        { "location": "1169/TALK"   , "narrator": "つばめ", "text": "え！？え？"},
        { "location": "1171/TALK"   , "narrator": "千羽鶴", "text": "あなたに自由な時間を\n与えすぎた。\n失敗だった。"},
        { "location": "1172/TALK"   , "narrator": "つばめ", "text": "な、何の話ですか！？"},
        { "location": "1178/TALK"   , "narrator": "千羽鶴", "text": "ココロゲートで\n話したことを\n覚えてる？"},
        { "location": "1179/SEL"    , "narrator": "", "text": "覚えてるけど、\n納得はしていなかった"},
        { "location": "1180/SEL"    , "narrator": "", "text": "覚えてるけど\nそれが何か？"},
        { "location": "1181/SEL"    , "narrator": "", "text": "さあ、忘れた"},
        { "location": "1182/ACT"    , "narrator": "", "text": "覚えてるけど、\n納得はしていなかった"},
        { "location": "1183/TALK"   , "narrator": "千羽鶴", "text": "なるほど、\n理解できた。"},
        { "location": "1184/ACT"    , "narrator": "", "text": "覚えてるけど\nそれが何か？"},
        { "location": "1185/TALK"   , "narrator": "千羽鶴", "text": "そういう聞き方を\nするの。"},
        { "location": "1186/ACT"    , "narrator": "", "text": "さあ、忘れた"},
        { "location": "1187/TALK"   , "narrator": "千羽鶴", "text": "それでうまく\nごまかしたつもり？"},
        { "location": "1189/TALK"   , "narrator": "千羽鶴", "text": "アースタシアとカレンは\nこの世界の秩序の形成を\n阻害している。"},
        { "location": "1190/TALK"   , "narrator": "千羽鶴", "text": "それを消滅させるために\n尽力を尽くしていたのに。"},
        { "location": "1191/TALK"   , "narrator": "千羽鶴", "text": "また阻害域が\n増大している。\n$handle$のせいで。"},
        { "location": "1192/TALK"   , "narrator": "千羽鶴", "text": "もう逢瀬つばめとは\n話をしないで。"},
        { "location": "1193/TALK"   , "narrator": "千羽鶴", "text": "本当に油断ならない。\n回線もいつの間にか\n復旧させてるし。"},
        { "location": "1194/TALK"   , "narrator": "千羽鶴", "text": "これは切っておくから。\nもうつながないで。"},
        { "location": "1199/TALK"   , "narrator": "つばめ", "text": "えっ！？\n長官さん！？"},
        { "location": "1210/DIALOG" , "narrator": "Dialog_chapter_ch01", "text": "【26 ホワイト・マイル】"}
    ]
}
