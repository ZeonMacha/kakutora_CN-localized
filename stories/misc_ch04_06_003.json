        "title": "Extra008 ヒメゴトチャット",
        "sub_title": "緑萌ゆ、黒は萎ゆ"
    },
    "entry":
    [
        { "location": "170/SCENARIO", "narrator": "", "text": "05_005_緑萌ゆ、黒は萎ゆ"},
        { "location": "195/TALK"    , "narrator": "みやび", "text": "緑萌ゆ"},
        { "location": "196/TALK"    , "narrator": "みやび", "text": "と"},
        { "location": "197/TALK"    , "narrator": "みやび", "text": "言うではないか"},
        { "location": "200/SEL"     , "narrator": "", "text": "初夏って感じ"},
        { "location": "201/SEL"     , "narrator": "", "text": "それがどうしたの"},
        { "location": "202/SEL"     , "narrator": "", "text": "一方的で強い愛着心・情熱・欲望などの気持ちを持つこと"},
        { "location": "203/ACT"     , "narrator": "", "text": "初夏って感じ"},
        { "location": "204/TALK"    , "narrator": "みやび", "text": "確かにそんな時期の"},
        { "location": "205/TALK"    , "narrator": "みやび", "text": "言葉ぞね"},
        { "location": "206/ACT"     , "narrator": "", "text": "それがどうしたの"},
        { "location": "207/TALK"    , "narrator": "みやび", "text": "どうもこうも"},
        { "location": "208/TALK"    , "narrator": "みやび", "text": "ぞね"},
        { "location": "209/ACT"     , "narrator": "", "text": "一方的で強い愛着心・情熱・欲望などの気持ちを持つこと"},
        { "location": "213/TALK"    , "narrator": "みやび", "text": "それはネットスラング"},
        { "location": "214/TALK"    , "narrator": "みやび", "text": "あるいはサブカルチャー"},
        { "location": "215/TALK"    , "narrator": "みやび", "text": "そのような界隈での萌え"},
        { "location": "216/TALK"    , "narrator": "みやび", "text": "かような萌えはお呼びでない"},
        { "location": "217/TALK"    , "narrator": "みやび", "text": "ま"},
        { "location": "219/TALK"    , "narrator": "みやび", "text": "時と場合によってはありだが"},
        { "location": "221/TALK"    , "narrator": "みやび", "text": "その対義語は"},
        { "location": "222/TALK"    , "narrator": "みやび", "text": "何だと思うぞね"},
        { "location": "224/SEL"     , "narrator": "", "text": "秋枯れる？"},
        { "location": "225/SEL"     , "narrator": "", "text": "ないんじゃない"},
        { "location": "226/SEL"     , "narrator": "", "text": "黒萎える"},
        { "location": "227/ACT"     , "narrator": "", "text": "秋枯れる？"},
        { "location": "228/TALK"    , "narrator": "みやび", "text": "ほう"},
        { "location": "229/TALK"    , "narrator": "みやび", "text": "枯山水的な"},
        { "location": "230/ACT"     , "narrator": "", "text": "ないんじゃない"},
        { "location": "231/TALK"    , "narrator": "みやび", "text": "左様"},
        { "location": "232/TALK"    , "narrator": "みやび", "text": "本来はそうだ"},
        { "location": "233/ACT"     , "narrator": "", "text": "黒萎える"},
        { "location": "234/TALK"    , "narrator": "みやび", "text": "ほほう"},
        { "location": "236/TALK"    , "narrator": "みやび", "text": "なかなかのセンス"},
        { "location": "238/TALK"    , "narrator": "みやび", "text": "まあちょっと"},
        { "location": "239/TALK"    , "narrator": "みやび", "text": "緑萌ゆちう雰囲気だなと"},
        { "location": "240/TALK"    , "narrator": "みやび", "text": "人を見ていて思ったものでな"},
        { "location": "241/TALK"    , "narrator": "みやび", "text": "ならばうちはどうなのか？と"},
        { "location": "242/TALK"    , "narrator": "みやび", "text": "ちっくと自省してみただけぞね"}
    ]
}
