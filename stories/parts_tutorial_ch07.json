    "entry":
    [
        { "location": "518/SCENARIO", "narrator": "", "text": "エリカデートイベント"},
        { "location": "529/TALK"    , "narrator": "エリカ", "text": "はぁ～！\n幸せ～～！"},
        { "location": "530/TALK"    , "narrator": "エリカ", "text": "わたしね、パーツ屋で\nお買い物するのが\n大好きなんだ。"},
        { "location": "531/TALK"    , "narrator": "エリカ", "text": "一日中だって\nいてもいいくらいだよ。"},
        { "location": "532/SEL"     , "narrator": "", "text": "デートで一日中パーツ屋！？"},
        { "location": "533/SEL"     , "narrator": "", "text": "じゃあ、ゆっくり見ていこうか"},
        { "location": "534/ACT"     , "narrator": "", "text": "デートで一日中パーツ屋！？"},
        { "location": "536/TALK"    , "narrator": "エリカ", "text": "あ、ううん。\nさすがに、\nそこまではしないかな。"},
        { "location": "537/ACT"     , "narrator": "", "text": "じゃあ、ゆっくり見ていこうか"},
        { "location": "538/TALK"    , "narrator": "エリカ", "text": "気持ちは嬉しいけど、\n今日は我慢しようと\n思うの。"},
        { "location": "539/TALK"    , "narrator": "エリカ", "text": "その言葉に甘えちゃうと、\n本当に一日中いることに\nなっちゃいそうだし…。"},
        { "location": "541/TALK"    , "narrator": "エリカ", "text": "せっかく今回は\nデートなんだからね、\nそれは申し訳ないよ。"},
        { "location": "543/TALK"    , "narrator": "エリカ", "text": "で、でも…せっかく\nパーツ屋に来てるん\nだし…。"},
        { "location": "544/TALK"    , "narrator": "エリカ", "text": "今だけ、ちょっとだけ\nパーツ見てきていいかな？"},
        { "location": "545/SEL"     , "narrator": "", "text": "そんなに好きなんだ？"},
        { "location": "546/SEL"     , "narrator": "", "text": "それは構わないよ"},
        { "location": "547/ACT"     , "narrator": "", "text": "そんなに好きなんだ？"},
        { "location": "549/TALK"    , "narrator": "エリカ", "text": "うん…子供の頃から、\nずーっと好きなの。"},
        { "location": "550/TALK"    , "narrator": "エリカ", "text": "玩具とかに囲まれてる\nよりも、こういうパーツに\n囲まれながら…。"},
        { "location": "551/TALK"    , "narrator": "エリカ", "text": "考えて、組み立てて、\nオリジナルの玩具を\n作るのが好きだったんだ。"},
        { "location": "552/TALK"    , "narrator": "エリカ", "text": "…変わってるよね？\n普通の女の子は、\nそんなことしないし…。"},
        { "location": "553/SEL"     , "narrator": "", "text": "そんなエリカが可愛い"},
        { "location": "554/SEL"     , "narrator": "", "text": "$me$には理想的ですが！？"},
        { "location": "555/ACT"     , "narrator": "", "text": "そんなエリカが可愛い"},
        { "location": "559/TALK"    , "narrator": "エリカ", "text": "えーっ！\nそういうこと、\n面と向かって言わないの！"},
        { "location": "560/TALK"    , "narrator": "エリカ", "text": "恥ずかしいのと\n嬉しいので、顔を\n見られなくなっちゃうよ。"},
        { "location": "561/ACT"     , "narrator": "", "text": "$me$には理想的ですが！？"},
        { "location": "563/TALK"    , "narrator": "エリカ", "text": "えぇっ、本当！？"},
        { "location": "565/TALK"    , "narrator": "エリカ", "text": "うーん、あなたって\nちょっと変わってるよね？"},
        { "location": "566/TALK"    , "narrator": "エリカ", "text": "でも、だからこそ\n合うのかな。わたしも\n変わり者だから。"},
        { "location": "567/TALK"    , "narrator": "エリカ", "text": "ちょっと、\n嬉しいかも。"},
        { "location": "569/ACT"     , "narrator": "", "text": "それは構わないよ"},
        { "location": "571/TALK"    , "narrator": "エリカ", "text": "ごめんね。せっかくの\nデートなのにこんな\nワガママ言って…。"},
        { "location": "572/TALK"    , "narrator": "エリカ", "text": "こういうところが、\nわたしのいけないところ\nなんだろうなぁ。"},
        { "location": "573/TALK"    , "narrator": "エリカ", "text": "綾ちゃんにも、\n何度か怒られたこと\nあったし…。"},
        { "location": "574/SEL"     , "narrator": "", "text": "$me$は受け入れる"},
        { "location": "575/SEL"     , "narrator": "", "text": "好きな物に一生懸命でいいと思う"},
        { "location": "576/ACT"     , "narrator": "", "text": "$me$は受け入れる"},
        { "location": "579/TALK"    , "narrator": "エリカ", "text": "えへへ…嬉しいな。"},
        { "location": "580/TALK"    , "narrator": "エリカ", "text": "自分の好きな物を、\nちゃんと受け入れて\nもらえてるって。"},
        { "location": "582/TALK"    , "narrator": "エリカ", "text": "あ、でもその優しさに\n甘えてばっかりなのは\nダメだよね？"},
        { "location": "583/TALK"    , "narrator": "エリカ", "text": "やっぱりこれからは、\nちょっと自制するように\nするからね。"},
        { "location": "584/TALK"    , "narrator": "エリカ", "text": "けど、今だけは、\n甘えさせてもらうことに\nしてるけどね。"},
        { "location": "585/ACT"     , "narrator": "", "text": "好きな物に一生懸命でいいと思う"},
        { "location": "587/TALK"    , "narrator": "エリカ", "text": "嬉しいな。\nえへへ。"},
        { "location": "588/TALK"    , "narrator": "エリカ", "text": "わたしね、結婚とか\n絶対にできないと\n思ってるんだけど、"},
        { "location": "589/TALK"    , "narrator": "エリカ", "text": "それでももし結婚するなら\n好きなことやらせてくれる\n相手の人がいいかな。"},
        { "location": "591/TALK"    , "narrator": "エリカ", "text": "ワガママすぎる\n発言なのは\nわかってるけど――"},
        { "location": "592/TALK"    , "narrator": "エリカ", "text": "わかってるから、\n恋人も作らないし、\n結婚もしないんだよね。"},
        { "location": "593/SEL"     , "narrator": "", "text": "$me$はどうでしょう"},
        { "location": "594/SEL"     , "narrator": "", "text": "独身が一番だよ"},
        { "location": "595/ACT"     , "narrator": "", "text": "$me$はどうでしょう"},
        { "location": "596/TALK"    , "narrator": "エリカ", "text": "ありがとう、\n気を使ってくれて。"},
        { "location": "597/TALK"    , "narrator": "エリカ", "text": "それとも、\n本気なのかな？"},
        { "location": "598/TALK"    , "narrator": "エリカ", "text": "もし本気なら、\nやめた方がいいよ？"},
        { "location": "599/TALK"    , "narrator": "エリカ", "text": "わたし、行ったきり\n帰ってこなく\nなっちゃうから。"},
        { "location": "600/TALK"    , "narrator": "エリカ", "text": "ずっと一緒にいたら\nそのうち嫌になっちゃうと\n思うの。"},
        { "location": "601/ACT"     , "narrator": "", "text": "独身が一番だよ"},
        { "location": "603/TALK"    , "narrator": "エリカ", "text": "そうだよね！\nわたしもそう思うよ。"},
        { "location": "604/TALK"    , "narrator": "エリカ", "text": "あなたみたいな人と\n好きなときに逢って、\n研究に没頭して……。"},
        { "location": "605/TALK"    , "narrator": "エリカ", "text": "そんな生活が、\n一番わたしには\n似合ってるからね。"},
        { "location": "609/SEL"     , "narrator": "", "text": "ちょっとだけ甘えていい？"},
        { "location": "610/ACT"     , "narrator": "", "text": "ちょっとだけ甘えていい？"},
        { "location": "615/TALK"    , "narrator": "エリカ", "text": "えっ…\nえええっ！？"},
        { "location": "616/TALK"    , "narrator": "エリカ", "text": "い、いいけど…。\nちょっとだけだからね？"},
        { "location": "637/TALK"    , "narrator": "エリカ", "text": "ふふっ…ツンツンされるの\nくすぐったいかも…。"},
        { "location": "641/TALK"    , "narrator": "エリカ", "text": "…頭ポンポンされると、\n胸が熱くなってくるの\n感じるよ。"},
        { "location": "650/TALK"    , "narrator": "エリカ", "text": "だ、ダメダメダメ！"},
        { "location": "651/TALK"    , "narrator": "エリカ", "text": "ちょっとだけでも、\nここは触っちゃダメな\nところなの。"},
        { "location": "655/TALK"    , "narrator": "エリカ", "text": "きゃぁっ！？"},
        { "location": "656/TALK"    , "narrator": "エリカ", "text": "もぉ…女の子の胸に\nイタズラしたらダメだよ。"},
        { "location": "665/TALK"    , "narrator": "エリカ", "text": "あ、あはは…、\nくすぐったくて、\nムズムズしちゃうかも…。"},
        { "location": "668/TALK"    , "narrator": "エリカ", "text": "ひゃんっ！？"},
        { "location": "670/TALK"    , "narrator": "エリカ", "text": "きゅ、急に触ったら\nダメだよ！\n変な声出ちゃった…。"},
        { "location": "678/TALK"    , "narrator": "エリカ", "text": "えへへ…、\n頭撫でてもらうの、\n久しぶりかも…。"},
        { "location": "681/TALK"    , "narrator": "エリカ", "text": "落ち着くなぁ…。\nわたし、頭撫でられるの\n大好き…。"},
        { "location": "689/TALK"    , "narrator": "エリカ", "text": "ひゃっ！？"},
        { "location": "690/TALK"    , "narrator": "エリカ", "text": "む、胸だよ！？\n今触ったの、胸だから！"},
        { "location": "694/TALK"    , "narrator": "エリカ", "text": "ちょっ！？\nどこ撫でてるの！？"},
        { "location": "695/TALK"    , "narrator": "エリカ", "text": "撫でてくれるなら、\n頭の方が嬉しいのに…。"},
        { "location": "704/TALK"    , "narrator": "エリカ", "text": "はふぅ…お腹、\nぽかぽかだよぉ…。"},
        { "location": "708/TALK"    , "narrator": "エリカ", "text": "うぅ～、ちょっと\n恥ずかしいかも…。"},
        { "location": "621/DIALOG"  , "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "716/DIALOG"  , "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"}
    ]
}
