    "entry":
    [
        { "location": "1172/SCENARIO", "narrator": "", "text": "オルレアンの祈りとニシンの戦い"},
        { "location": "1197/TALK"    , "narrator": "神楽", "text": "紅茶事件"},
        { "location": "1198/TALK"    , "narrator": "神楽", "text": "薔薇戦争"},
        { "location": "1199/TALK"    , "narrator": "神楽", "text": "そしてニシンの戦い"},
        { "location": "1200/TALK"    , "narrator": "神楽", "text": "不思議ちゃん枠の史実が散見される件"},
        { "location": "1202/SEL"     , "narrator": "", "text": "中身は真面目だよ…"},
        { "location": "1203/SEL"     , "narrator": "", "text": "テストに出るの？"},
        { "location": "1204/SEL"     , "narrator": "", "text": "$me$たちも歴史に名を刻もう"},
        { "location": "1205/ACT"     , "narrator": "", "text": "中身は真面目だよ…"},
        { "location": "1206/TALK"    , "narrator": "神楽", "text": "知っています。"},
        { "location": "1207/ACT"     , "narrator": "", "text": "テストに出るの？"},
        { "location": "1208/TALK"    , "narrator": "神楽", "text": "出ません。"},
        { "location": "1209/ACT"     , "narrator": "", "text": "$me$たちも歴史に名を刻もう"},
        { "location": "1211/TALK"    , "narrator": "神楽", "text": "その答えを待ってたわダーリン"},
        { "location": "1212/TALK"    , "narrator": "神楽", "text": "必修項目になりましょう♪"},
        { "location": "1214/TALK"    , "narrator": "神楽", "text": "ただニシンの戦いは絵面がすごすぎる"},
        { "location": "1215/TALK"    , "narrator": "神楽", "text": "日本人の思い浮かべるニシンのイメージは身欠きニシン"},
        { "location": "1216/TALK"    , "narrator": "神楽", "text": "ニシン来たかとカモメに問えばぁわたしゃ立つ鳥、えぇ波に聞～け～"},
        { "location": "1218/SEL"     , "narrator": "", "text": "ごめんなさいわかりません"},
        { "location": "1219/SEL"     , "narrator": "", "text": "年ごまかしてない？"},
        { "location": "1220/SEL"     , "narrator": "", "text": "チョイ ヤサエ　エンヤンサーノ"},
        { "location": "1221/ACT"     , "narrator": "", "text": "ごめんなさいわかりません"},
        { "location": "1222/TALK"    , "narrator": "神楽", "text": "ひょっとしてアニソンしか聴かない人？"},
        { "location": "1223/ACT"     , "narrator": "", "text": "年ごまかしてない？"},
        { "location": "1224/TALK"    , "narrator": "神楽", "text": "それ以前に我ながらキャラが違いすぎると思う、、、"},
        { "location": "1226/TALK"    , "narrator": "神楽", "text": "ぴょんこは民謡とか知らないから、、、"},
        { "location": "1227/ACT"     , "narrator": "", "text": "チョイ ヤサエ　エンヤンサーノ"},
        { "location": "1229/TALK"    , "narrator": "神楽", "text": "完璧な合いの手"},
        { "location": "1230/TALK"    , "narrator": "神楽", "text": "これはもう日曜の昼間に放送してる某公共放送に出演できるレベル！"},
        { "location": "1232/TALK"    , "narrator": "神楽", "text": "あ"},
        { "location": "1233/TALK"    , "narrator": "神楽", "text": "頼まれても出ないけど"},
        { "location": "1234/TALK"    , "narrator": "神楽", "text": "民謡とか知らないし"},
        { "location": "1236/TALK"    , "narrator": "神楽", "text": "フォークロア系は北欧とかアイリッシュしか知らないし"},
        { "location": "1238/TALK"    , "narrator": "神楽", "text": "そういえば身欠きニシンなんて料理に使ったことなかった"},
        { "location": "1239/TALK"    , "narrator": "神楽", "text": "今度何か作ってみようかな"}
    ]
}
