        "title": "Extra008 ヒメゴトチャット",
        "sub_title": "オールドシネマ・オープンカフェ"
    },
    "entry":
    [
        { "location": "2356/SCENARIO", "narrator": "", "text": "オールドシネマ・オープンカフェ"},
        { "location": "2381/TALK"    , "narrator": "神楽", "text": "名画座って言い方されると"},
        { "location": "2382/TALK"    , "narrator": "神楽", "text": "モノクロ映画しかかからないような気がするんだけど"},
        { "location": "2384/SEL"     , "narrator": "", "text": "わかる！"},
        { "location": "2385/SEL"     , "narrator": "", "text": "$me$は全米系娯楽大作しか観ないから"},
        { "location": "2386/SEL"     , "narrator": "", "text": "名画座って何？"},
        { "location": "2387/ACT"     , "narrator": "", "text": "わかる！"},
        { "location": "2389/TALK"    , "narrator": "神楽", "text": "でしょでしょ！"},
        { "location": "2391/TALK"    , "narrator": "神楽", "text": "さすが$handlek$♪"},
        { "location": "2392/TALK"    , "narrator": "神楽", "text": "雰囲気がそうなの！"},
        { "location": "2393/TALK"    , "narrator": "神楽", "text": "ひとつしかないスクリーンとか"},
        { "location": "2394/TALK"    , "narrator": "神楽", "text": "エントランスのちょっと暗い感じとかね"},
        { "location": "2395/ACT"     , "narrator": "", "text": "$me$は全米系娯楽大作しか観ないから"},
        { "location": "2396/TALK"    , "narrator": "神楽", "text": "あーそういう楽しみ方ね"},
        { "location": "2398/TALK"    , "narrator": "神楽", "text": "それはそれで楽しいから全然あり"},
        { "location": "2399/ACT"     , "narrator": "", "text": "名画座って何？"},
        { "location": "2400/TALK"    , "narrator": "神楽", "text": "そこから？"},
        { "location": "2401/TALK"    , "narrator": "神楽", "text": "映画館の種類"},
        { "location": "2402/TALK"    , "narrator": "神楽", "text": "ロードショーじゃなくて旧作品だけをかける、、、上映する映画館のこと"},
        { "location": "2403/TALK"    , "narrator": "神楽", "text": "ネット配信が普及する前はそれなりにあったらしい"},
        { "location": "2404/TALK"    , "narrator": "神楽", "text": "そんな時代、想像もつかないけど！"},
        { "location": "2406/TALK"    , "narrator": "神楽", "text": "神楽坂トライナリーは真幌さんの趣味でよく怪獣映画を上映してるんだけど"},
        { "location": "2407/TALK"    , "narrator": "神楽", "text": "怪獣映画て！"},
        { "location": "2408/TALK"    , "narrator": "神楽", "text": "しかも特撮感バリバリ！"},
        { "location": "2411/SEL"     , "narrator": "", "text": "好きなんでしょ？"},
        { "location": "2412/SEL"     , "narrator": "", "text": "意外と詳しいと見た"},
        { "location": "2413/SEL"     , "narrator": "", "text": "神楽のために映画館を貸し切りにしよう"},
        { "location": "2414/ACT"     , "narrator": "", "text": "好きなんでしょ？"},
        { "location": "2415/TALK"    , "narrator": "神楽", "text": "設定なんかがぶっ飛びまくってるところは意外と気に入ってる"},
        { "location": "2416/ACT"     , "narrator": "", "text": "意外と詳しいと見た"},
        { "location": "2417/TALK"    , "narrator": "神楽", "text": "そうでもないけど"},
        { "location": "2418/ACT"     , "narrator": "", "text": "神楽のために映画館を貸し切りにしよう"},
        { "location": "2420/TALK"    , "narrator": "神楽", "text": "それは素敵な誘い"},
        { "location": "2422/TALK"    , "narrator": "神楽", "text": "その時は全米が恋した級の甘い甘いラブロマンスでお願いね！"},
        { "location": "2423/TALK"    , "narrator": "神楽", "text": "怪獣映画には燃えはあるけど萌えがないから"},
        { "location": "2424/TALK"    , "narrator": "神楽", "text": "いやしかし世の中には怪獣に萌える人種もいるからなー"},
        { "location": "2425/TALK"    , "narrator": "神楽", "text": "特殊過ぎんだろ！！！！"},
        { "location": "2427/TALK"    , "narrator": "神楽", "text": "全然知らない世界過ぎて面白いというよりは興味深いという意識で見るね、古い映画は"},
        { "location": "2428/TALK"    , "narrator": "神楽", "text": "それもありでしょ"}
    ]
}
