{
    "dir": "chap19/daydra/dd_ch03_19_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "19356",
        "cid": "gabriella",
        "title": "Extra005 プレミアムストーリー",
        "sub_title": "横須賀の祭り"
    },
    "entry":
    [
        { "location": "324/SCENARIO", "narrator": "", "text": "横須賀の祭り"},
        { "location": "359/TALK"    , "narrator": "つばめ", "text": "わぁ！！"},
        { "location": "360/TALK"    , "narrator": "つばめ", "text": "横須賀って初めて\n来たけど、こんな大きな\nお祭りがやるんだね。"},
        { "location": "362/TALK"    , "narrator": "雛", "text": "つばめちゃんって、\n横須賀は初めて？"},
        { "location": "365/TALK"    , "narrator": "つばめ", "text": "うん！"},
        { "location": "367/TALK"    , "narrator": "キリト", "text": "それなら絶対行くべき\nおすすめスポットが――"},
        { "location": "368/TALK"    , "narrator": "つばめ", "text": "三笠公園のこと？"},
        { "location": "370/TALK"    , "narrator": "キリト", "text": "…バレバレかよ。"},
        { "location": "372/TALK"    , "narrator": "雛", "text": "あはは、\nそりゃそうだよー。"},
        { "location": "374/TALK"    , "narrator": "繭", "text": "わからない方が\nおかしいから。"},
        { "location": "376/TALK"    , "narrator": "ヒカル", "text": "でも、せっかくのお祭り\nなんですし、今日は\n公園ではなく――"},
        { "location": "377/TALK"    , "narrator": "ヒカル", "text": "出店を見て周った方が\n良いと思いますよ？"},
        { "location": "380/TALK"    , "narrator": "キリト", "text": "…まあ、そうだな。\n三笠はどこにも\n逃げねぇし。"},
        { "location": "382/TALK"    , "narrator": "つばめ", "text": "出店かぁ…どこを見に\n行こうかなぁ？"},
        { "location": "383/TALK"    , "narrator": "つばめ", "text": "やっぱり鯛焼き屋は\n譲れないよね。"},
        { "location": "386/TALK"    , "narrator": "ガブリエラ", "text": "あんた、本当にそれしか\nないのね…。"},
        { "location": "387/TALK"    , "narrator": "ガブリエラ", "text": "そういえば、昨日ネットで\n調べた飴細工の屋台、\nどこににあるのかしら？"},
        { "location": "388/TALK"    , "narrator": "ガブリエラ", "text": "ホームページに\n場所が書いてあれば\nいいんだけど…。"},
        { "location": "390/TALK"    , "narrator": "キリト", "text": "おいおい、逢瀬。\n祭りは食い物の屋台\nだけじゃないんだぜ？"},
        { "location": "391/TALK"    , "narrator": "キリト", "text": "遊べるようなところも\n周らないと、勿体ないぞ。"},
        { "location": "393/TALK"    , "narrator": "つばめ", "text": "例えば？"},
        { "location": "394/TALK"    , "narrator": "キリト", "text": "へへっ、プラモ釣りだな。"},
        { "location": "395/TALK"    , "narrator": "つばめ", "text": "それって、紐を引いた\n先にある景品がもらえる、\nあれ？"},
        { "location": "396/TALK"    , "narrator": "キリト", "text": "おう！\n今日こそは店の奥に\nドーンと飾ってある――"},
        { "location": "397/TALK"    , "narrator": "キリト", "text": "武蔵１／５００モデルを\nゲットしてやるぜ！！"},
        { "location": "398/TALK"    , "narrator": "ヒカル", "text": "えっ！？\nキリト、それ本気ですか？"},
        { "location": "400/TALK"    , "narrator": "キリト", "text": "当然！　気合い入れて\n武蔵を引き寄せてやるぜ！"},
        { "location": "402/TALK"    , "narrator": "雛", "text": "うわぁ…\n本気で信じちゃってる\nみたい…。"},
        { "location": "405/TALK"    , "narrator": "繭", "text": "それ、絶対糸繋がって\nないから。"},
        { "location": "406/TALK"    , "narrator": "繭", "text": "全財産つぎ込んでも\n絶対取れないから。"},
        { "location": "408/TALK"    , "narrator": "キリト", "text": "はぁ…夢の無い奴だな。"},
        { "location": "410/TALK"    , "narrator": "ガブリエラ", "text": "キリト君は夢しか\n見えてないようね…。"},
        { "location": "411/TALK"    , "narrator": "キリト", "text": "繭は何見るんだよ？"},
        { "location": "412/TALK"    , "narrator": "繭", "text": "ＰＣパーツ釣り。"},
        { "location": "415/TALK"    , "narrator": "ガブリエラ", "text": "…秋葉原のお祭りでも、\nそんなの見たことないん\nだけど？"},
        { "location": "416/TALK"    , "narrator": "キリト", "text": "こんだけデカいんだ。\n探せばありそうだよな。"},
        { "location": "418/TALK"    , "narrator": "雛", "text": "じゃあ、あたしは\n鉄道模型釣りがいい！"},
        { "location": "421/TALK"    , "narrator": "ガブリエラ", "text": "…ふざけてるのか\n真面目なのか、いまいち\n判断できないわね？"},
        { "location": "423/TALK"    , "narrator": "つばめ", "text": "楽しくて仕方ないんだよ。"},
        { "location": "424/TALK"    , "narrator": "つばめ", "text": "ヒカルくんはどうするの？"},
        { "location": "425/TALK"    , "narrator": "ヒカル", "text": "僕は、飴細工を見に\n行こうと思ってます。"},
        { "location": "426/TALK"    , "narrator": "ガブリエラ", "text": "えっ！？"},
        { "location": "428/TALK"    , "narrator": "雛", "text": "飴細工釣り？\nいいと思うよー。"},
        { "location": "429/TALK"    , "narrator": "ヒカル", "text": "ち、違いますよ。\n普通の飴細工です。"},
        { "location": "430/TALK"    , "narrator": "ヒカル", "text": "ここの出店に、毎年凄い\n人が出店しているのを――"},
        { "location": "431/TALK"    , "narrator": "ヒカル", "text": "昨日、ネットで見つけて\n知ったんです。"},
        { "location": "433/TALK"    , "narrator": "キリト", "text": "…おまえ、本当に\n枯れてるよな？"},
        { "location": "434/TALK"    , "narrator": "ヒカル", "text": "そ、そうでしょうか？"},
        { "location": "436/TALK"    , "narrator": "ガブリエラ", "text": "…飴細工見るのは、\nもう無理そうね。"},
        { "location": "439/SEL"     , "narrator": "", "text": "ヒカルと趣味が合うね"},
        { "location": "440/SEL"     , "narrator": "", "text": "片っ端から周れば？"},
        { "location": "441/SEL"     , "narrator": "", "text": "逆に意識してると思われそう"},
        { "location": "444/TALK"    , "narrator": "ガブリエラ", "text": "…あたしも飴細工が\n見たいって言ったら――"},
        { "location": "445/TALK"    , "narrator": "ガブリエラ", "text": "またヒカル君とのことを\n誤解されそうだし…。"},
        { "location": "448/TALK"    , "narrator": "つばめ", "text": "ガブちゃんは\n何を見たいの？"},
        { "location": "451/TALK"    , "narrator": "ガブリエラ", "text": "…別に。\n特に決めてないわ。"},
        { "location": "452/TALK"    , "narrator": "つばめ", "text": "そっか…。\nじゃあ、私と一緒に\n周ろう。"},
        { "location": "454/TALK"    , "narrator": "キリト", "text": "よーし、そんじゃ花火の\n時間になったら、会場で\n落ち合おうぜ。"},
        { "location": "456/TALK"    , "narrator": "雛", "text": "繭ちん、鉄道模型と\nＰＣパーツ釣り探しに\n行こう！"},
        { "location": "457/TALK"    , "narrator": "繭", "text": "いや、絶対無いし。"},
        { "location": "458/TALK"    , "narrator": "雛", "text": "ぶらつこう、って\nことだよー。\n繭ちんはニブちんだなぁ。"},
        { "location": "478/TALK"    , "narrator": "ヒカル", "text": "では、また後で。"},
        { "location": "482/TALK"    , "narrator": "つばめ", "text": "じゃあ、わたしたちも\n行こっか？"},
        { "location": "483/TALK"    , "narrator": "ガブリエラ", "text": "うん…。"},
        { "location": "485/TALK"    , "narrator": "ガブリエラ", "text": "…見たかったなぁ…。"},
        { "location": "487/ACT"     , "narrator": "", "text": "ヒカルと趣味が合うね"},
        { "location": "503/TALK"    , "narrator": "ガブリエラ", "text": "そうやってからかわれるのが嫌なの！"},
        { "location": "515/TALK"    , "narrator": "ガブリエラ", "text": "まったく、$marzanna$まで\n言ってくるなんて…。"},
        { "location": "516/TALK"    , "narrator": "つばめ", "text": "ガブちゃんは\n何を見たいの？"},
        { "location": "518/ACT"     , "narrator": "", "text": "片っ端から周れば？"},
        { "location": "533/TALK"    , "narrator": "ガブリエラ", "text": "それよ！"},
        { "location": "534/TALK"    , "narrator": "ガブリエラ", "text": "一軒ずつ周れば、飴細工の店にも自然に行くことができるわ"},
        { "location": "535/TALK"    , "narrator": "ガブリエラ", "text": "冴えてるわね、$marzanna$"},
        { "location": "546/TALK"    , "narrator": "つばめ", "text": "ガブちゃんは\n何を見たいの？"},
        { "location": "549/TALK"    , "narrator": "ガブリエラ", "text": "とりあえず、一通り見て\n周るつもりよ。"},
        { "location": "551/TALK"    , "narrator": "雛", "text": "おっ、やる気満々だねー。"},
        { "location": "552/TALK"    , "narrator": "繭", "text": "出店の数が多いから、\n意外と難しそうだと\n思うけど。"},
        { "location": "553/TALK"    , "narrator": "ガブリエラ", "text": "ちゃっちゃと見て\n周るから平気よ。"},
        { "location": "555/TALK"    , "narrator": "ガブリエラ", "text": "あたしの本命は、\n飴細工なんだから。"},
        { "location": "557/TALK"    , "narrator": "キリト", "text": "よーし、そんじゃ花火の\n時間になったら、会場で\n落ち合おうぜ。"},
        { "location": "574/TALK"    , "narrator": "ガブリエラ", "text": "…うわっ、\nもうこんな時間じゃん！？"},
        { "location": "575/TALK"    , "narrator": "ガブリエラ", "text": "もうそろそろ花火が\n始まっちゃう…。"},
        { "location": "576/TALK"    , "narrator": "ガブリエラ", "text": "まだ飴細工\n見てないのに…。"},
        { "location": "578/TALK"    , "narrator": "ガブリエラ", "text": "…あ、何あの店！？\n青いリンゴ飴とか\n売ってるし！"},
        { "location": "579/TALK"    , "narrator": "ガブリエラ", "text": "…面白そう。\nあれは買わないと！"},
        { "location": "582/TALK"    , "narrator": "神楽", "text": "ここにいたんですね、\nガブちゃん。"},
        { "location": "585/TALK"    , "narrator": "つばめ", "text": "見つけたよ。\nほら、もうすぐ花火が\n始まる時間だから――"},
        { "location": "586/TALK"    , "narrator": "つばめ", "text": "急いで会場行こう。"},
        { "location": "589/TALK"    , "narrator": "ガブリエラ", "text": "えっ！？\nで、でも、まだあたし、\nお店見てないし…。"},
        { "location": "590/TALK"    , "narrator": "神楽", "text": "全然見てないんですか？"},
        { "location": "591/TALK"    , "narrator": "ガブリエラ", "text": "いや、沢山見はした\nけど…。"},
        { "location": "592/TALK"    , "narrator": "神楽", "text": "それじゃあ、早く花火を\n見に行きましょう。"},
        { "location": "593/TALK"    , "narrator": "神楽", "text": "もう全員揃って、\nあとはガブちゃんだけ\nなんですよ？"},
        { "location": "594/TALK"    , "narrator": "つばめ", "text": "さ、ガブちゃん。\nこっちこっち！"},
        { "location": "596/TALK"    , "narrator": "ガブリエラ", "text": "えぇっ！？\nちょ、そんな…！"},
        { "location": "597/TALK"    , "narrator": "ガブリエラ", "text": "飴細工見たかったのにー！"},
        { "location": "598/ACT"     , "narrator": "", "text": "逆に意識してると思われそう"},
        { "location": "614/TALK"    , "narrator": "ガブリエラ", "text": "$marzanna$はそう思うの？"},
        { "location": "615/TALK"    , "narrator": "ガブリエラ", "text": "それじゃ、どう答えたらいいのよ…"},
        { "location": "616/TALK"    , "narrator": "ガブリエラ", "text": "…混乱してきたわ"},
        { "location": "628/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "629/TALK"    , "narrator": "つばめ", "text": "ガブちゃんは\n何を見たいの？"},
        { "location": "630/TALK"    , "narrator": "ガブリエラ", "text": "うん…。"},
        { "location": "631/TALK"    , "narrator": "ガブリエラ", "text": "…やっぱり、正直に\n飴細工って言おう。"},
        { "location": "632/TALK"    , "narrator": "ガブリエラ", "text": "我慢してたら、\n全然楽しめないと思うし。"},
        { "location": "634/TALK"    , "narrator": "ガブリエラ", "text": "…あ、あたしも、\n飴細工を見たいの。"},
        { "location": "635/TALK"    , "narrator": "つばめ", "text": "…やっぱり。\nガブちゃんは飴細工を\n見たがると思ったよ。"},
        { "location": "637/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "639/TALK"    , "narrator": "雛", "text": "うん、あたしも思ってた。"},
        { "location": "640/TALK"    , "narrator": "雛", "text": "ガブリエラちゃん、\nそういうの大好き\nだもんね。"},
        { "location": "642/TALK"    , "narrator": "ガブリエラ", "text": "…えっ？"},
        { "location": "643/TALK"    , "narrator": "つばめ", "text": "日本の文化的な物に\n目がないのは、\nみんな知ってるよ。"},
        { "location": "645/TALK"    , "narrator": "繭", "text": "そうでなくても、\n見たことがないなら\nあれは一見の価値あり。"},
        { "location": "646/TALK"    , "narrator": "繭", "text": "ていうか、見ないと\n勿体ない。"},
        { "location": "648/TALK"    , "narrator": "キリト", "text": "でも、これでまた\n楽屋に物が増えることに\nなりそうだな。"},
        { "location": "649/TALK"    , "narrator": "雛", "text": "そりゃそうだよー。\n飴細工って、食べるより\n飾る方がメインだし。"},
        { "location": "651/TALK"    , "narrator": "雛", "text": "ヒカルくんも\nそのつもりでしょ？"},
        { "location": "652/TALK"    , "narrator": "ヒカル", "text": "もちろんです。\nどこに飾るかは、\nまだ考え中ですが…。"},
        { "location": "653/TALK"    , "narrator": "ガブリエラ", "text": "…なんか、あたしの\n思ってた反応と違う？"},
        { "location": "655/TALK"    , "narrator": "ガブリエラ", "text": "絶対からかわれると\n思ってたのに…。"},
        { "location": "657/TALK"    , "narrator": "ヒカル", "text": "飴細工の屋台の場所は\n向こうですが、えっと…。"},
        { "location": "659/TALK"    , "narrator": "ヒカル", "text": "そうだ、よろしければ\n逢瀬さんも一緒に\n行きませんか？"},
        { "location": "660/TALK"    , "narrator": "つばめ", "text": "うん、それだとわたしも\n嬉しいな。"},
        { "location": "661/TALK"    , "narrator": "つばめ", "text": "鯛焼き以外は、\n特に見るもの\n決めてなかったし。"},
        { "location": "663/TALK"    , "narrator": "キリト", "text": "よーし、そんじゃ花火の\n時間になったら、会場で\n落ち合おうぜ。"},
        { "location": "664/TALK"    , "narrator": "雛", "text": "繭ちん、鉄道模型と\nＰＣパーツ釣り探しに\n行こう！"},
        { "location": "665/TALK"    , "narrator": "繭", "text": "いや、絶対無いし。"},
        { "location": "666/TALK"    , "narrator": "雛", "text": "ぶらつこう、って\nことだよー。\n繭ちんはニブちんだなぁ。"},
        { "location": "685/TALK"    , "narrator": "ヒカル", "text": "では、僕達も\n行きましょうか。"},
        { "location": "686/TALK"    , "narrator": "つばめ", "text": "うん。\n楽しみだね、ガブちゃん！"},
        { "location": "688/TALK"    , "narrator": "ガブリエラ", "text": "…うん。"},
        { "location": "690/TALK"    , "narrator": "ガブリエラ", "text": "我慢しないで良かった…。\n飴細工、早く見たいな。"},
        { "location": "358/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>8月20日　 6:50 PM</color>\n合宿中、横須賀のお祭りにて"}
    ]
}
