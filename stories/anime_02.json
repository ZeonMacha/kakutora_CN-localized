{
    "dir": "chap02/daydra/anime_02.js",
    "type": "MainStory",
    "info": {
        "story_id": "2201",
        "cid": "ayami",
        "title": "001 アニメーション",
        "sub_title": "アーヤの紹介"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "アニメ第01～04話"},
        { "location": "48/TALK"   , "narrator": "千羽鶴", "text": "ようこそ。\n國政綾水の\nステージへ。"},
        { "location": "50/TALK"   , "narrator": "千羽鶴", "text": "それじゃまずは、\n國政綾水の\nおさらいから。"},
        { "location": "52/TALK"   , "narrator": "千羽鶴", "text": "ここから先は、\nそれぞれの少女ごとに\nチャンネルが分かれる。"},
        { "location": "53/TALK"   , "narrator": "千羽鶴", "text": "同じ空間で同じ事象を\n体験していても、感じ\n方や想いは様々。"},
        { "location": "54/TALK"   , "narrator": "千羽鶴", "text": "だから、貴方の彼女たち\nへのサポートもまた、\n様々なものになるはず。"},
        { "location": "55/TALK"   , "narrator": "千羽鶴", "text": "貴方には１００％の力で\n彼女を深くサポートして\n欲しいから――"},
        { "location": "56/TALK"   , "narrator": "千羽鶴", "text": "この恋愛ゲームでは、\n各彼女ごとに別チャン\nネルになってる。"},
        { "location": "57/TALK"   , "narrator": "千羽鶴", "text": "ところで――"},
        { "location": "58/TALK"   , "narrator": "千羽鶴", "text": "$handle$は、\n國政綾水を一番に\n選んだ。それはなぜ？"},
        { "location": "59/SEL"    , "narrator": "", "text": "彼女を支えたいから"},
        { "location": "60/SEL"    , "narrator": "", "text": "何となく"},
        { "location": "61/ACT"    , "narrator": "", "text": "彼女を支えたいから"},
        { "location": "62/TALK"   , "narrator": "千羽鶴", "text": "そう。\nとてもいい返答。"},
        { "location": "63/ACT"    , "narrator": "", "text": "何となく"},
        { "location": "64/TALK"   , "narrator": "千羽鶴", "text": "そう。まあ、\nそういう事もある。"},
        { "location": "65/TALK"   , "narrator": "千羽鶴", "text": "でも、彼女と接してみて\n自分向きじゃないと\n感じたら――"},
        { "location": "66/TALK"   , "narrator": "千羽鶴", "text": "無理につき合う\n必要は無いから。"},
        { "location": "67/TALK"   , "narrator": "千羽鶴", "text": "あまり気負わずに\nプレイしてみて。"},
        { "location": "68/TALK"   , "narrator": "千羽鶴", "text": "それじゃまずは、\n國政綾水について\n今一度おさらいをする。"},
        { "location": "79/TALK"   , "narrator": "千羽鶴", "text": "[國政綾水]。\n<color=blue>くにまさ あやみ</color>\nと読む。愛称は<color=blue>アーヤ</color>。"},
        { "location": "80/TALK"   , "narrator": "千羽鶴", "text": "彼女は、非常に優秀な\n剣術の使い手であり――"},
        { "location": "81/TALK"   , "narrator": "千羽鶴", "text": "その腕前は、高校時代に\n剣道の世界選手権で優勝\nしたほど。"},
        { "location": "84/TALK"   , "narrator": "千羽鶴", "text": "さて、ここで１つ\nおさらいクイズ。"},
        { "location": "85/TALK"   , "narrator": "千羽鶴", "text": "彼女はなぜこのような\n格好をしているのか？\n分かる人。"},
        { "location": "86/SEL"    , "narrator": "", "text": "コスプレイヤーだ！"},
        { "location": "87/SEL"    , "narrator": "", "text": "悪と戦う魔法少女だ！"},
        { "location": "88/ACT"    , "narrator": "", "text": "コスプレイヤーだ！"},
        { "location": "89/TALK"   , "narrator": "千羽鶴", "text": "そう！"},
        { "location": "91/TALK"   , "narrator": "千羽鶴", "text": "って！　違うから！"},
        { "location": "92/TALK"   , "narrator": "千羽鶴", "text": "あなたが勢いよく\n答えるから、誘導されて\n思わずバグった。"},
        { "location": "94/TALK"   , "narrator": "千羽鶴", "text": "そう。\n私は今、あなたに\n傷物にされた…しくしく"},
        { "location": "96/TALK"   , "narrator": "千羽鶴", "text": "チラッ…"},
        { "location": "98/TALK"   , "narrator": "千羽鶴", "text": "というわけで不正解。\nさっき私が説明したはず。"},
        { "location": "99/TALK"   , "narrator": "千羽鶴", "text": "正解は、戦闘少女として\n街の治安を守っている。"},
        { "location": "100/TALK"  , "narrator": "千羽鶴", "text": "まったく。ちゃんと覚えて。"},
        { "location": "104/TALK"  , "narrator": "千羽鶴", "text": "もう貴方は\nちはる学園落第だから。"},
        { "location": "105/ACT"   , "narrator": "", "text": "悪と戦う魔法少女だ！"},
        { "location": "106/TALK"  , "narrator": "千羽鶴", "text": "概ね正解ね。\nまあ、戦う相手は悪では\nないけど。"},
        { "location": "110/TALK"  , "narrator": "千羽鶴", "text": "とにかく、彼女が<color=red>逢瀬\nつばめ</color>の命運を握って\nいたことに違いはない。"},
        { "location": "111/TALK"  , "narrator": "千羽鶴", "text": "そんな彼女、結果的には\nちゃんと現場に急行し――"},
        { "location": "112/TALK"  , "narrator": "千羽鶴", "text": "フェノメノン収束の\n任務にあたっている。\nけど！"},
        { "location": "113/TALK"  , "narrator": "千羽鶴", "text": "実は彼女、\n直前にトラブルに\n巻き込まれていて――"},
        { "location": "114/TALK"  , "narrator": "千羽鶴", "text": "現場に急行できなかった\nかもしれなかった。"},
        { "location": "118/TALK"  , "narrator": "千羽鶴", "text": "そして、\nもう分かってると思うけど\nここで貴方の出番。"},
        { "location": "119/TALK"  , "narrator": "千羽鶴", "text": "彼女に対してもまた、\nココロをサポートして\n解決に導いてあげて欲しい。"},
        { "location": "122/TALK"  , "narrator": "千羽鶴", "text": "そして、\nもう分かってると思うけど\nここで貴方の出番。"},
        { "location": "123/TALK"  , "narrator": "千羽鶴", "text": "彼女に対してもまた、\nココロをサポートして\n解決に導いてあげて欲しい。"},
        { "location": "124/SEL"   , "narrator": "", "text": "これで３人目なんだけど、みんな何か問題を抱えて戦っていたってこと？"},
        { "location": "125/ACT"   , "narrator": "", "text": "これで３人目なんだけど、みんな何か問題を抱えて戦っていたってこと？"},
        { "location": "127/TALK"  , "narrator": "千羽鶴", "text": "逆に聞きたい。"},
        { "location": "128/TALK"  , "narrator": "千羽鶴", "text": "生死を賭けた戦闘において\n一度も問題が発生しない\nことなんてどれ程あるか。"},
        { "location": "129/TALK"  , "narrator": "千羽鶴", "text": "記録映像にはその全てを\n記録することはできない。"},
        { "location": "130/TALK"  , "narrator": "千羽鶴", "text": "映像に記録されているだけ\nでも色々な問題は起きて\nいるけど――"},
        { "location": "131/TALK"  , "narrator": "千羽鶴", "text": "実際にはそれ以上に色々な\n問題や危機を、彼女達は\n沢山抱えている。"},
        { "location": "132/TALK"  , "narrator": "千羽鶴", "text": "それでも彼女達は、\n今までそれを自分で\n解決して乗り切ってきた。"},
        { "location": "133/TALK"  , "narrator": "千羽鶴", "text": "けど年端もいかない少女が\n毎回の死闘で、問題を解決\nし続けるには無理がある。"},
        { "location": "134/TALK"  , "narrator": "千羽鶴", "text": "だから私は、貴方に\n助けを求めているの。"},
        { "location": "135/TALK"  , "narrator": "千羽鶴", "text": "わかった？"},
        { "location": "136/SEL"   , "narrator": "", "text": "わかった"},
        { "location": "137/SEL"   , "narrator": "", "text": "まだよくわからない"},
        { "location": "138/ACT"   , "narrator": "", "text": "わかった"},
        { "location": "139/TALK"  , "narrator": "千羽鶴", "text": "オッケー。"},
        { "location": "140/TALK"  , "narrator": "千羽鶴", "text": "今回もまた、\n素晴らしいココロの\nサポートを期待してる。"},
        { "location": "141/ACT"   , "narrator": "", "text": "まだよくわからない"},
        { "location": "142/TALK"  , "narrator": "千羽鶴", "text": "焦らなくてもいい。\nそのうち何かのきっかけで\nわかるかもしれない。"},
        { "location": "143/TALK"  , "narrator": "千羽鶴", "text": "それでもわからなければ、\n途中でやめてもらっても\n構わない。"},
        { "location": "144/TALK"  , "narrator": "千羽鶴", "text": "私には貴方を強制する力も\n権限も無いから。"},
        { "location": "145/TALK"  , "narrator": "千羽鶴", "text": "とにかく、今回だけは\n是非とも頑張って欲しい。"},
        { "location": "146/TALK"  , "narrator": "千羽鶴", "text": "素晴らしいココロの\nサポートを期待してる。"},
        { "location": "150/SEL"   , "narrator": "", "text": "で、それを解決したのが$me$ってこと？"},
        { "location": "151/ACT"   , "narrator": "", "text": "で、それを解決したのが$me$ってこと？"},
        { "location": "154/TALK"  , "narrator": "千羽鶴", "text": "その通り。\nそして貴方にとっては\nこれから成すべきこと。"},
        { "location": "155/TALK"  , "narrator": "千羽鶴", "text": "彼女に対してもまた、\nココロをサポートして\n解決に導いてあげて欲しい。"},
        { "location": "158/SEL"   , "narrator": "", "text": "そうだったんだ！"},
        { "location": "159/ACT"   , "narrator": "", "text": "そうだったんだ！"},
        { "location": "161/TALK"  , "narrator": "千羽鶴", "text": "そうだったの。"},
        { "location": "162/TALK"  , "narrator": "千羽鶴", "text": "そして、\nそれを解決したのが貴方。"},
        { "location": "163/SEL"   , "narrator": "", "text": "いえ、何もやってませんが。"},
        { "location": "164/ACT"   , "narrator": "", "text": "いえ、何もやってませんが。"},
        { "location": "167/TALK"  , "narrator": "千羽鶴", "text": "そうね。\nだって、これから\nやってもらうのだから。"},
        { "location": "168/SEL"   , "narrator": "", "text": "意味がわかりません"},
        { "location": "169/ACT"   , "narrator": "", "text": "意味がわかりません"},
        { "location": "171/TALK"  , "narrator": "千羽鶴", "text": "貴方には、私たちの世界の\n時間を、未来へ過去へと\n自在に移動する力がある。"},
        { "location": "172/TALK"  , "narrator": "千羽鶴", "text": "貴方には、\nこのエピソードで\n國政綾水をサポートし――"},
        { "location": "173/TALK"  , "narrator": "千羽鶴", "text": "記録動画の通りに\n歴史が進むように、\n頑張ってもらう。"},
        { "location": "174/TALK"  , "narrator": "千羽鶴", "text": "いい？"},
        { "location": "175/SEL"   , "narrator": "", "text": "オッケー！"},
        { "location": "176/SEL"   , "narrator": "", "text": "それって歴史改変では！？"},
        { "location": "177/SEL"   , "narrator": "", "text": "いやです！"},
        { "location": "178/ACT"   , "narrator": "", "text": "オッケー！"},
        { "location": "181/ACT"   , "narrator": "", "text": "それって歴史改変では！？"},
        { "location": "182/TALK"  , "narrator": "千羽鶴", "text": "んー。\nそれはちょっと違う。"},
        { "location": "183/TALK"  , "narrator": "千羽鶴", "text": "まあ今は難しい事は\n考えず、彼女とイチャラブ\nする事に専念して。"},
        { "location": "184/ACT"   , "narrator": "", "text": "いやです！"},
        { "location": "185/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "186/TALK"  , "narrator": "千羽鶴", "text": "じゃあ今すぐに\n別の彼女のチャンネルに\n切り替えた方がいい。"},
        { "location": "191/TALK"  , "narrator": "千羽鶴", "text": "それじゃ、\n健闘を祈ってる。"},
        { "location": "193/TALK"  , "narrator": "千羽鶴", "text": "…っと。\nそう、一応念のため――"},
        { "location": "194/TALK"  , "narrator": "千羽鶴", "text": "彼女が現場に急行する\n前後の映像を編集して\n用意してあるけど、見る？"},
        { "location": "195/SEL"   , "narrator": "", "text": "見る"},
        { "location": "196/SEL"   , "narrator": "", "text": "見なくて平気"},
        { "location": "197/ACT"   , "narrator": "", "text": "見る"},
        { "location": "198/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "199/TALK"  , "narrator": "千羽鶴", "text": "映像は逢瀬つばめが上京する\nところから、國政綾水が\nドームに到着するまで。"},
        { "location": "200/TALK"  , "narrator": "千羽鶴", "text": "ストリーミングで\n配信するから、\n回線が細い人は要注意。"},
        { "location": "201/TALK"  , "narrator": "千羽鶴", "text": "そんな人の為に、\n<color=green>あらすじレポート</color>も\n用意してある。"},
        { "location": "202/TALK"  , "narrator": "千羽鶴", "text": "回線種別と相談しつつ、\n映像にするか、レポート\nにするか決めて欲しい。"},
        { "location": "203/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/51MB 3:24】</color>"},
        { "location": "204/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/16MB 3:24】</color>"},
        { "location": "205/SEL"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "206/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/51MB 3:24】</color>"},
        { "location": "207/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "213/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/16MB 3:24】</color>"},
        { "location": "214/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "220/ACT"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "221/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "222/TALK"  , "narrator": "千羽鶴", "text": "残念だけど、いろいろ\n事情があってのことだと\n思うから。"},
        { "location": "223/TALK"  , "narrator": "千羽鶴", "text": "家に帰ったら、是非\n記録映像の方も\n見てみて欲しい。"},
        { "location": "224/TALK"  , "narrator": "千羽鶴", "text": "それではどうぞ。"},
        { "location": "239/TALK"  , "narrator": "千羽鶴", "text": "どう？\nどういう状況だったか\n思い出せた？"},
        { "location": "240/TALK"  , "narrator": "千羽鶴", "text": "是非、國政綾水のココロを\n落ち着かせて――"},
        { "location": "241/TALK"  , "narrator": "千羽鶴", "text": "この映像のように、\n現場に急行できるように\nして欲しい。"},
        { "location": "243/ACT"   , "narrator": "", "text": "見なくて平気"},
        { "location": "245/TALK"  , "narrator": "千羽鶴", "text": "そう、わかった。"},
        { "location": "246/TALK"  , "narrator": "千羽鶴", "text": "是非、國政綾水のココロを\n落ち着かせて、現場に急行\nできるようにして欲しい。"},
        { "location": "258/TALK"  , "narrator": "千羽鶴", "text": "どう？\nどういう状況だったか\n思い出せた？"},
        { "location": "259/TALK"  , "narrator": "千羽鶴", "text": "是非、國政綾水のココロを\n落ち着かせて――"},
        { "location": "260/TALK"  , "narrator": "千羽鶴", "text": "この映像のように、\n現場に急行できるように\nして欲しい。"},
        { "location": "231/DIALOG", "narrator": "Tutorial/Dialog_Anime2", "text": "逢瀬つばめはFreyMENOWの\nライブ会場に辿り着いたが、運悪く\nそこで発生したフェノメノンに\n巻き込まれてしまう。\n\n一方、思い思いの休暇を過ごしていた\nトライナリーの面々。\nそこにフェノメノン・アラートが\n鳴り響く。\n\n\n現場へ急行するアーヤたち\nトライナリーの面々。\n\nライブ会場に辿り着き、中に入ると\n既に状況は開始されていた。\n襲われている逢瀬つばめ、\n襲いかかる謎の女剣士。\n\n彼女たちは、この状況を\n収束させるべく、トライナリーに\n変身し、武装する。"}
    ]
}
