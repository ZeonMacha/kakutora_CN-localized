        { "location": "397/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "401/TALK"  , "narrator": "つばめ", "text": "$handle$さん"},
        { "location": "402/TALK"  , "narrator": "つばめ", "text": "相談したぃことがぁるの(´･ω･｀) "},
        { "location": "404/SEL"   , "narrator": "", "text": "神楽のこと？"},
        { "location": "405/ACT"   , "narrator": "", "text": "神楽のこと？"},
        { "location": "407/TALK"  , "narrator": "つばめ", "text": "ぅん"},
        { "location": "408/TALK"  , "narrator": "つばめ", "text": "実家のこと"},
        { "location": "409/TALK"  , "narrator": "つばめ", "text": "わたしも知ってるよって"},
        { "location": "410/TALK"  , "narrator": "つばめ", "text": "教えよぅと思ぅんだけど"},
        { "location": "411/TALK"  , "narrator": "つばめ", "text": "間違ってなぃよね？(´･ω･｀) "},
        { "location": "413/SEL"   , "narrator": "", "text": "やめた方がいいと思うよ"},
        { "location": "414/ACT"   , "narrator": "", "text": "やめた方がいいと思うよ"},
        { "location": "416/TALK"  , "narrator": "つばめ", "text": "そうなのかな？"},
        { "location": "418/SEL"   , "narrator": "", "text": "神楽が何も言わないんだし"},
        { "location": "419/ACT"   , "narrator": "", "text": "神楽が何も言わないんだし"},
        { "location": "421/TALK"  , "narrator": "つばめ", "text": "言ぃたくても"},
        { "location": "422/TALK"  , "narrator": "つばめ", "text": "言ぇなぃんじゃなぃかな？(･Д･｀)"},
        { "location": "423/TALK"  , "narrator": "つばめ", "text": "だから"},
        { "location": "424/TALK"  , "narrator": "つばめ", "text": "わたしも知ってるよって(*´︶`*)"},
        { "location": "425/TALK"  , "narrator": "つばめ", "text": "コッソリ教えてぁげたら"},
        { "location": "426/TALK"  , "narrator": "つばめ", "text": "ちょっとは元気になるかもヽ(*´∀｀)ノ"},
        { "location": "427/TALK"  , "narrator": "つばめ", "text": "秘密を共有することになるから"},
        { "location": "429/SEL"   , "narrator": "", "text": "みやびを裏切ることになるよ？"},
        { "location": "430/ACT"   , "narrator": "", "text": "みやびを裏切ることになるよ？"},
        { "location": "432/TALK"  , "narrator": "つばめ", "text": "それは"},
        { "location": "435/TALK"  , "narrator": "つばめ", "text": "でも"},
        { "location": "436/TALK"  , "narrator": "つばめ", "text": "卯月さんが無茶しなぃためだし(´･ω･｀) "},
        { "location": "437/TALK"  , "narrator": "つばめ", "text": "それはぃぃと思ぅんだけど"},
        { "location": "440/TALK"  , "narrator": "つばめ", "text": "ダメかな？(o´Д`)=з"},
        { "location": "442/SEL"   , "narrator": "", "text": "時には見守ることも大切だよ"},
        { "location": "443/ACT"   , "narrator": "", "text": "時には見守ることも大切だよ"},
        { "location": "446/TALK"  , "narrator": "つばめ", "text": "わかったよ"},
        { "location": "447/TALK"  , "narrator": "つばめ", "text": "みやびさんからも"},
        { "location": "448/TALK"  , "narrator": "つばめ", "text": "監視するよぅに言われたし(*´︶`*)"},
        { "location": "449/TALK"  , "narrator": "つばめ", "text": "卯月さんには"},
        { "location": "450/TALK"  , "narrator": "つばめ", "text": "内緒にしてぉくねヾ(｡>﹏<｡)ﾉﾞ"},
        { "location": "452/SEL"   , "narrator": "", "text": "神楽のこと、見ててあげてね"},
        { "location": "453/ACT"   , "narrator": "", "text": "神楽のこと、見ててあげてね"},
        { "location": "455/TALK"  , "narrator": "つばめ", "text": "ぅん"},
        { "location": "456/TALK"  , "narrator": "つばめ", "text": "任せて(๑･ㅂ･)و☆"},
        { "location": "462/TALK"  , "narrator": "つばめ", "text": "こういう時こそ、\nわたしがしっかり\nしないとね。"},
        { "location": "463/TALK"  , "narrator": "つばめ", "text": "絶対、卯月さんには\n無茶させないように\nしないと！"},
        { "location": "466/TALK"  , "narrator": "つばめ", "text": "卯月さん、\n大丈夫だからね？"},
        { "location": "468/TALK"  , "narrator": "つばめ", "text": "今日のわたしは、\nいつも以上に\n頑張っちゃうから！"},
        { "location": "470/TALK"  , "narrator": "神楽", "text": "…はい。\n頼りに、してますね。"},
        { "location": "472/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "473/TALK"  , "narrator": "つばめ", "text": "…心配だなぁ。"},
