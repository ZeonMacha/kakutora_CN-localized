    "entry":
    [
        { "location": "2604/DIALOG", "narrator": "", "text": "<color=green>某月某日　1:26 PM</color>\nとある休日、神楽坂トライナリー楽屋にて。"},
        { "location": "2605/TALK"  , "narrator": "神楽", "text": "――じゃあ、カフェの\nメニューはこれで\n決定としますね。"},
        { "location": "2606/TALK"  , "narrator": "アーヤ", "text": "ええ、わかったわ。"},
        { "location": "2607/TALK"  , "narrator": "みやび", "text": "ふぅ…、思うてたより\n長い道のりやったなぁ…。"},
        { "location": "2609/TALK"  , "narrator": "神楽", "text": "二人とも、本当に\nお疲れ様でした。"},
        { "location": "2610/TALK"  , "narrator": "神楽", "text": "メニュー表は私の方で\n作成しておきますので、\nあとは任せてください。"},
        { "location": "2611/TALK"  , "narrator": "みやび", "text": "よろしゅうな。"},
        { "location": "2612/TALK"  , "narrator": "アーヤ", "text": "さてと、それじゃ私は\n先に上がらせてもらうわ。"},
        { "location": "2613/TALK"  , "narrator": "神楽", "text": "珍しいですね。\nアーヤさんが先に\n上がるなんて…。"},
        { "location": "2616/TALK"  , "narrator": "みやび", "text": "わかった、デートやろ？"},
        { "location": "2617/TALK"  , "narrator": "アーヤ", "text": "そんなわけないでしょ。\nちょっとやることがある\nだけよ。"},
        { "location": "2618/TALK"  , "narrator": "みやび", "text": "…そんなわけない\nっちゅう返しは、\nちくっと寂しいがよ。"},
        { "location": "2619/TALK"  , "narrator": "神楽", "text": "そうですね…。"},
        { "location": "2620/TALK"  , "narrator": "アーヤ", "text": "お、大きなお世話よ。\nそういうわけだから、\nお先にね。"},
        { "location": "2637/TALK"  , "narrator": "アーヤ", "text": "よし…できた！"},
        { "location": "2638/TALK"  , "narrator": "アーヤ", "text": "思ったより時間が\n掛かっちゃったけど…。"},
        { "location": "2639/TALK"  , "narrator": "アーヤ", "text": "$handle$、\n喜んでくれるかしら？"},
        { "location": "2652/TALK"  , "narrator": "アーヤ", "text": "見てほしいものがあるの(*^o^*)"},
        { "location": "2655/SEL"   , "narrator": "（選択肢）", "text": "かわいい靴下だ！"},
        { "location": "2656/ACT"   , "narrator": "", "text": "かわいい靴下だ！"},
        { "location": "2658/TALK"  , "narrator": "アーヤ", "text": "ありがとう(^^"},
        { "location": "2662/SEL"   , "narrator": "（選択肢）", "text": "前に話してくれた靴下だよね？"},
        { "location": "2663/ACT"   , "narrator": "", "text": "前に話してくれた靴下だよね？"},
        { "location": "2665/TALK"  , "narrator": "アーヤ", "text": "そう"},
        { "location": "2666/TALK"  , "narrator": "アーヤ", "text": "覚えててくれたんだ？(*^^*)"},
        { "location": "2667/TALK"  , "narrator": "アーヤ", "text": "あの靴下がね"},
        { "location": "2669/TALK"  , "narrator": "アーヤ", "text": "やっと完成したの＼(^O^)／"},
        { "location": "2672/SEL"   , "narrator": "（選択肢）", "text": "自分で作ったんだ？"},
        { "location": "2673/ACT"   , "narrator": "", "text": "自分で作ったんだ？"},
        { "location": "2675/TALK"  , "narrator": "アーヤ", "text": "そうなの(^^"},
        { "location": "2676/TALK"  , "narrator": "アーヤ", "text": "実はね"},
        { "location": "2677/TALK"  , "narrator": "アーヤ", "text": "$handle$にプレゼントしたくて(・・。)ゞ"},
        { "location": "2678/TALK"  , "narrator": "アーヤ", "text": "こっそり作ってたの(*^^*)"},
        { "location": "2680/SEL"   , "narrator": "（選択肢）", "text": "えっ！？　気づかなかった！"},
        { "location": "2681/ACT"   , "narrator": "", "text": "えっ！？　気づかなかった！"},
        { "location": "2683/TALK"  , "narrator": "アーヤ", "text": "でしょ？(￣∇￣)"},
        { "location": "2684/TALK"  , "narrator": "アーヤ", "text": "隠れて作るの"},
        { "location": "2685/TALK"  , "narrator": "アーヤ", "text": "大変だったんだから(;^_^A"},
        { "location": "2686/TALK"  , "narrator": "アーヤ", "text": "でも"},
        { "location": "2688/TALK"  , "narrator": "アーヤ", "text": "やっと完成したわ＼(^O^)／"},
        { "location": "2691/TALK"  , "narrator": "アーヤ", "text": "自分としては"},
        { "location": "2692/TALK"  , "narrator": "アーヤ", "text": "結構いい完成度(￣∇￣)"},
        { "location": "2693/TALK"  , "narrator": "アーヤ", "text": "なんて"},
        { "location": "2694/TALK"  , "narrator": "アーヤ", "text": "自画自賛してみたり(￣∇￣*)ゞ"},
        { "location": "2695/TALK"  , "narrator": "アーヤ", "text": "しっかり作ったから"},
        { "location": "2696/TALK"  , "narrator": "アーヤ", "text": "簡単に伸びたり"},
        { "location": "2697/TALK"  , "narrator": "アーヤ", "text": "破れたりしないはず(=^0^=)"},
        { "location": "2698/TALK"  , "narrator": "アーヤ", "text": "ただ"},
        { "location": "2699/TALK"  , "narrator": "アーヤ", "text": "デザインが心配かも(｡-_-｡)"},
        { "location": "2700/TALK"  , "narrator": "アーヤ", "text": "私の趣味だから"},
        { "location": "2701/TALK"  , "narrator": "アーヤ", "text": "$handle$が気に入るか"},
        { "location": "2702/TALK"  , "narrator": "アーヤ", "text": "ちょっと不安かも(-ω-;)"},
        { "location": "2704/SEL"   , "narrator": "（選択肢）", "text": "とってもかわいいよ"},
        { "location": "2705/SEL"   , "narrator": "（選択肢）", "text": "最高に嬉しいよ"},
        { "location": "2706/SEL"   , "narrator": "（選択肢）", "text": "嬉しいけど、ちょっと恥ずかしいかも"},
        { "location": "2707/ACT"   , "narrator": "", "text": "とってもかわいいよ"},
        { "location": "2708/TALK"  , "narrator": "アーヤ", "text": "ありがとう(*^o^*)"},
        { "location": "2709/TALK"  , "narrator": "アーヤ", "text": "可愛さ重視にしたの"},
        { "location": "2710/TALK"  , "narrator": "アーヤ", "text": "そっちの方が"},
        { "location": "2711/TALK"  , "narrator": "アーヤ", "text": "いいかなって(・・。)ゞ"},
        { "location": "2712/ACT"   , "narrator": "", "text": "最高に嬉しいよ"},
        { "location": "2713/TALK"  , "narrator": "アーヤ", "text": "本当に？"},
        { "location": "2714/TALK"  , "narrator": "アーヤ", "text": "そう言ってもらえると"},
        { "location": "2715/TALK"  , "narrator": "アーヤ", "text": "私も嬉しい(^ε^)-☆!!"},
        { "location": "2716/ACT"   , "narrator": "", "text": "嬉しいけど、ちょっと恥ずかしいかも"},
        { "location": "2717/TALK"  , "narrator": "アーヤ", "text": "やっぱり"},
        { "location": "2719/TALK"  , "narrator": "アーヤ", "text": "ちょっと子供っぽかった？(>_<)"},
        { "location": "2720/TALK"  , "narrator": "アーヤ", "text": "人前で靴を脱ぐ日は"},
        { "location": "2721/TALK"  , "narrator": "アーヤ", "text": "履かない方がいいかも(T_T)"},
        { "location": "2723/SEL"   , "narrator": "（選択肢）", "text": "でも、すごく嬉しい"},
        { "location": "2724/ACT"   , "narrator": "", "text": "でも、すごく嬉しい"},
        { "location": "2726/TALK"  , "narrator": "アーヤ", "text": "ありがとう(; ;)"},
        { "location": "2728/TALK"  , "narrator": "アーヤ", "text": "喜んでもらえたなら"},
        { "location": "2730/TALK"  , "narrator": "アーヤ", "text": "作ってよかったわ(^^"},
        { "location": "2731/TALK"  , "narrator": "アーヤ", "text": "でも"},
        { "location": "2732/TALK"  , "narrator": "アーヤ", "text": "本当子供っぽいデザインだから"},
        { "location": "2733/TALK"  , "narrator": "アーヤ", "text": "恥ずかしいと思ったら"},
        { "location": "2734/TALK"  , "narrator": "アーヤ", "text": "履かないでいいから(;^_^A"},
        { "location": "2735/TALK"  , "narrator": "アーヤ", "text": "ただ"},
        { "location": "2736/TALK"  , "narrator": "アーヤ", "text": "これを$handle$が持ってくれてたら"},
        { "location": "2737/TALK"  , "narrator": "アーヤ", "text": "それだけで幸せだから(*^^*)"},
        { "location": "2740/TALK"  , "narrator": "アーヤ", "text": "あれ？"},
        { "location": "2741/TALK"  , "narrator": "アーヤ", "text": "なんか重い発言？(￣Д￣ )"},
        { "location": "2743/SEL"   , "narrator": "（選択肢）", "text": "いや、愛を感じる"},
        { "location": "2744/SEL"   , "narrator": "（選択肢）", "text": "ちょっとだけね"},
        { "location": "2745/ACT"   , "narrator": "", "text": "いや、愛を感じる"},
        { "location": "2747/TALK"  , "narrator": "アーヤ", "text": "恥ずかしい"},
        { "location": "2748/ACT"   , "narrator": "", "text": "ちょっとだけね"},
        { "location": "2750/TALK"  , "narrator": "アーヤ", "text": "でも"},
        { "location": "2751/TALK"  , "narrator": "アーヤ", "text": "本当のことだから( ・_・)σﾞ"},
        { "location": "2753/TALK"  , "narrator": "アーヤ", "text": "とにかく"},
        { "location": "2754/TALK"  , "narrator": "アーヤ", "text": "完成したことの報告(^^"},
        { "location": "2755/TALK"  , "narrator": "アーヤ", "text": "今度送るから"},
        { "location": "2756/TALK"  , "narrator": "アーヤ", "text": "楽しみにしててね(^з^)-☆"},
        { "location": "2767/TALK"  , "narrator": "アーヤ", "text": "…喜んでもらえて\nよかった。"},
        { "location": "2768/TALK"  , "narrator": "アーヤ", "text": "それじゃ、\n早速ラッピングして…。"},
        { "location": "2769/TALK"  , "narrator": "アーヤ", "text": "…あっ！"},
        { "location": "2771/TALK"  , "narrator": "アーヤ", "text": "そう見せかけて、\n食器と一緒に送ったら…。"},
        { "location": "2772/TALK"  , "narrator": "アーヤ", "text": "きっと、\n$handle$驚くわ。"},
        { "location": "2773/TALK"  , "narrator": "アーヤ", "text": "ふふっ…決めた。\n食器と一緒に送っちゃお。"}
    ]
}
