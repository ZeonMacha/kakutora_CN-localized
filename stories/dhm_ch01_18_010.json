        { "location": "7/SCENARIO", "narrator": "", "text": "030_スタイリスト候補生"},
        { "location": "32/TALK"   , "narrator": "つばめ", "text": "ガブちゃんはやっぱりおしゃれさんだね(๑･ㅂ･)و✧"},
        { "location": "33/TALK"   , "narrator": "つばめ", "text": "入ったことないお店とかいっぱい行っちゃった"},
        { "location": "35/SEL"    , "narrator": "", "text": "よかったね"},
        { "location": "36/SEL"    , "narrator": "", "text": "楽しかった？"},
        { "location": "37/SEL"    , "narrator": "", "text": "$me$のセンスの方がいいよ"},
        { "location": "38/ACT"    , "narrator": "", "text": "よかったね"},
        { "location": "39/TALK"   , "narrator": "つばめ", "text": "ぅん"},
        { "location": "40/ACT"    , "narrator": "", "text": "楽しかった？"},
        { "location": "41/TALK"   , "narrator": "つばめ", "text": "当たり前でしょ"},
        { "location": "44/ACT"    , "narrator": "", "text": "$me$のセンスの方がいいよ"},
        { "location": "46/TALK"   , "narrator": "つばめ", "text": "そぅだね"},
        { "location": "47/TALK"   , "narrator": "つばめ", "text": "そうかもしれなぃね"},
        { "location": "49/TALK"   , "narrator": "つばめ", "text": "結局選んでもらった服は試着しなかったけど"},
        { "location": "50/TALK"   , "narrator": "つばめ", "text": "した方がょかったかな？"},
        { "location": "52/SEL"    , "narrator": "", "text": "試着したところ見たかった"},
        { "location": "53/SEL"    , "narrator": "", "text": "人それぞれ趣味はあるし…"},
        { "location": "54/SEL"    , "narrator": "", "text": "嫌われちゃうかも"},
        { "location": "55/ACT"    , "narrator": "", "text": "試着したところ見たかった"},
        { "location": "57/TALK"   , "narrator": "つばめ", "text": "それはダメ"},
        { "location": "59/TALK"   , "narrator": "つばめ", "text": "だって"},
        { "location": "60/TALK"   , "narrator": "つばめ", "text": "恥ずかしぃから"},
        { "location": "61/TALK"   , "narrator": "つばめ", "text": "ぁんな服着たことなぃし"},
        { "location": "62/TALK"   , "narrator": "つばめ", "text": "きっと似合えばかっこぃぃんだろうけど"},
        { "location": "63/TALK"   , "narrator": "つばめ", "text": "やっぱり無理(´ｪ｀；)三(；´ｪ｀)"},
        { "location": "64/TALK"   , "narrator": "つばめ", "text": "見せられなぃょ(/ω＼)"},
        { "location": "65/ACT"    , "narrator": "", "text": "人それぞれ趣味はあるし…"},
        { "location": "66/TALK"   , "narrator": "つばめ", "text": "そぅだょねヾ(*´ｴ`*)ﾉ"},
        { "location": "67/TALK"   , "narrator": "つばめ", "text": "みんなが自分に似合うの着ればぃぃだけだょね"},
        { "location": "68/ACT"    , "narrator": "", "text": "嫌われちゃうかも"},
        { "location": "69/TALK"   , "narrator": "つばめ", "text": "そぅかな？？？？"},
        { "location": "71/TALK"   , "narrator": "つばめ", "text": "でも"},
        { "location": "72/TALK"   , "narrator": "つばめ", "text": "ガブちゃんは本当はそんなわがままな子じゃなぃょ"},
        { "location": "73/TALK"   , "narrator": "つばめ", "text": "だってガブちゃんだもん"}
