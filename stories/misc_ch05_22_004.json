    "entry":
    [
        { "location": "7257/SCENARIO", "narrator": "", "text": "百合の彩度、菫の明度"},
        { "location": "7284/TALK"    , "narrator": "神楽", "text": "カメラもこだわりはじめるときりがないぴょん"},
        { "location": "7285/TALK"    , "narrator": "神楽", "text": "設定とか特に"},
        { "location": "7287/SEL"     , "narrator": "", "text": "そうだろうね"},
        { "location": "7288/SEL"     , "narrator": "", "text": "$me$が教えてあげる"},
        { "location": "7289/SEL"     , "narrator": "", "text": "適当に撮るのでもいいと思う"},
        { "location": "7290/ACT"     , "narrator": "", "text": "そうだろうね"},
        { "location": "7291/TALK"    , "narrator": "神楽", "text": "$handlek$はカメラ興味ないみたいぴょん"},
        { "location": "7292/ACT"     , "narrator": "", "text": "$me$が教えてあげる"},
        { "location": "7294/TALK"    , "narrator": "神楽", "text": "おっおっ！？"},
        { "location": "7295/TALK"    , "narrator": "神楽", "text": "格好いい$handlek$アピール！？"},
        { "location": "7296/TALK"    , "narrator": "神楽", "text": "なんかいい感じ"},
        { "location": "7297/ACT"     , "narrator": "", "text": "適当に撮るのでもいいと思う"},
        { "location": "7298/TALK"    , "narrator": "神楽", "text": "まあそうだけど"},
        { "location": "7299/TALK"    , "narrator": "神楽", "text": "ぴょんこは高みを目指したい！"},
        { "location": "7301/TALK"    , "narrator": "神楽", "text": "スマホのカメラもちょっと設定覚えるだけで変わってくるぴょん"},
        { "location": "7304/SEL"     , "narrator": "", "text": "スタンプ機能とか"},
        { "location": "7305/SEL"     , "narrator": "", "text": "ホワイトバランスとか"},
        { "location": "7306/SEL"     , "narrator": "", "text": "神楽が写ってるだけで最高"},
        { "location": "7307/ACT"     , "narrator": "", "text": "スタンプ機能とか"},
        { "location": "7308/TALK"    , "narrator": "神楽", "text": "いやそういうのじゃなくて"},
        { "location": "7309/ACT"     , "narrator": "", "text": "ホワイトバランスとか"},
        { "location": "7310/TALK"    , "narrator": "神楽", "text": "基本だよね！"},
        { "location": "7311/TALK"    , "narrator": "神楽", "text": "でも結構大事なやつ"},
        { "location": "7312/ACT"     , "narrator": "", "text": "神楽が写ってるだけで最高"},
        { "location": "7314/TALK"    , "narrator": "神楽", "text": "ちょｗｗｗ"},
        { "location": "7316/TALK"    , "narrator": "神楽", "text": "そんな当たり前のこと言わなくてもいいぴょん"},
        { "location": "7317/TALK"    , "narrator": "神楽", "text": "もー$handlek$ったらー"},
        { "location": "7319/TALK"    , "narrator": "神楽", "text": "ぴょんこは写真もちょっと芸術的なやつがいいと思うぴょん"},
        { "location": "7320/TALK"    , "narrator": "神楽", "text": "スナップ写真とかも楽しいけどね"}
    ]
}
