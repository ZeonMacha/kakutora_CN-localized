        { "location": "79/SCENARIO", "narrator": "", "text": "027_闇夜に霜の降る如く"},
        { "location": "104/TALK"   , "narrator": "ガブリエラ", "text": "目で引かず"},
        { "location": "105/TALK"   , "narrator": "ガブリエラ", "text": "心で引かず"},
        { "location": "106/TALK"   , "narrator": "ガブリエラ", "text": "闇夜に霜の降る如く"},
        { "location": "108/SEL"    , "narrator": "", "text": "射撃心得だね"},
        { "location": "109/SEL"    , "narrator": "", "text": "何それ"},
        { "location": "110/SEL"    , "narrator": "", "text": "そういう感じの詩も書くの？"},
        { "location": "111/ACT"    , "narrator": "", "text": "射撃心得だね"},
        { "location": "112/TALK"   , "narrator": "ガブリエラ", "text": "あら"},
        { "location": "113/TALK"   , "narrator": "ガブリエラ", "text": "知っているのねｖ"},
        { "location": "114/ACT"    , "narrator": "", "text": "何それ"},
        { "location": "115/TALK"   , "narrator": "ガブリエラ", "text": "射撃心得よ"},
        { "location": "116/TALK"   , "narrator": "ガブリエラ", "text": "心しなさい"},
        { "location": "117/ACT"    , "narrator": "", "text": "そういう感じの詩も書くの？"},
        { "location": "118/TALK"   , "narrator": "ガブリエラ", "text": "違うわよ"},
        { "location": "119/TALK"   , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "120/TALK"   , "narrator": "ガブリエラ", "text": "今度書いてみようかしら？"},
        { "location": "122/TALK"   , "narrator": "ガブリエラ", "text": "キリトとの勝負がギリギリだったから"},
        { "location": "123/TALK"   , "narrator": "ガブリエラ", "text": "エアガンも練習しようと思っているの"},
        { "location": "124/TALK"   , "narrator": "ガブリエラ", "text": "次はいつになるかしらね"},
        { "location": "127/SEL"    , "narrator": "", "text": "誘ってみたらどう？"},
        { "location": "128/SEL"    , "narrator": "", "text": "次は実銃でやってみたいね"},
        { "location": "129/SEL"    , "narrator": "", "text": "また勝利確実だよ"},
        { "location": "130/ACT"    , "narrator": "", "text": "誘ってみたらどう？"},
        { "location": "132/TALK"   , "narrator": "ガブリエラ", "text": "そんなこと"},
        { "location": "133/TALK"   , "narrator": "ガブリエラ", "text": "できないわ"},
        { "location": "134/TALK"   , "narrator": "ガブリエラ", "text": "もう！"},
        { "location": "137/TALK"   , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "138/TALK"   , "narrator": "ガブリエラ", "text": "できたら"},
        { "location": "139/TALK"   , "narrator": "ガブリエラ", "text": "早く勝負がしたいと思っているわ"},
        { "location": "140/ACT"    , "narrator": "", "text": "次は実銃でやってみたいね"},
        { "location": "141/TALK"   , "narrator": "ガブリエラ", "text": "どうかしら、、、"},
        { "location": "143/TALK"   , "narrator": "ガブリエラ", "text": "養成科の訓練場なら撃てるかもしれないわ"},
        { "location": "144/TALK"   , "narrator": "ガブリエラ", "text": "でもやっぱりキリトたちに実銃を撃たせるのは"},
        { "location": "145/TALK"   , "narrator": "ガブリエラ", "text": "どうかと思うから"},
        { "location": "146/TALK"   , "narrator": "ガブリエラ", "text": "やめておくわね"},
        { "location": "147/ACT"    , "narrator": "", "text": "また勝利確実だよ"},
        { "location": "148/TALK"   , "narrator": "ガブリエラ", "text": "その油断が命取りになるのよ"},
        { "location": "149/TALK"   , "narrator": "ガブリエラ", "text": "勝負は真剣にしないといけないわ"},
        { "location": "150/TALK"   , "narrator": "ガブリエラ", "text": "特に銃は"}
    ]
}
