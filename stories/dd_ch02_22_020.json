{
    "dir": "chap22/daydra/dd_ch02_22_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "22256",
        "cid": "ayami",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "古いバス停"
    },
    "entry":
    [
        { "location": "487/SCENARIO", "narrator": "", "text": "古いバス停"},
        { "location": "514/TALK"    , "narrator": "透明神楽", "text": "どうですか？\n雨宿りできそうな\nところ、ありましたか？"},
        { "location": "517/TALK"    , "narrator": "透明つばめ", "text": "ダメ、何もないよ…。"},
        { "location": "519/TALK"    , "narrator": "透明ガブリエラ", "text": "ああもう！！\nこれだから夏は嫌いよ！"},
        { "location": "523/TALK"    , "narrator": "透明アーヤ", "text": "夕立に文句言っても\n仕方ないでしょ？"},
        { "location": "527/TALK"    , "narrator": "透明アーヤ", "text": "…このままじゃ、\nずぶ濡れで帰ることに\nなりそうね…。"},
        { "location": "530/TALK"    , "narrator": "透明神楽", "text": "…あっ！"},
        { "location": "532/TALK"    , "narrator": "透明神楽", "text": "見つけました！\nあそこなら雨宿り\nできそうです！"},
        { "location": "536/TALK"    , "narrator": "透明アーヤ", "text": "っ！？　ちょ、それって\nまさか、あそこにある\n古い小屋のこと？"},
        { "location": "539/TALK"    , "narrator": "透明ガブリエラ", "text": "ドアも開いてるみたい。\nみんな、急ぐわよ！"},
        { "location": "541/TALK"    , "narrator": "透明アーヤ", "text": "あ、でもあそこは…"},
        { "location": "557/TALK"    , "narrator": "透明アーヤ", "text": "ま、待って！！"},
        { "location": "575/TALK"    , "narrator": "つばめ", "text": "ふぅ…どうにか雨宿り\nできそうだねー。"},
        { "location": "576/TALK"    , "narrator": "ガブリエラ", "text": "そうね。"},
        { "location": "580/TALK"    , "narrator": "ガブリエラ", "text": "それより、ここって\nバス停だったのね？"},
        { "location": "584/TALK"    , "narrator": "神楽", "text": "みたいですね。\nでも、もう使われては\nいないみたいですけど。"},
        { "location": "586/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "590/TALK"    , "narrator": "つばめ", "text": "きゃっ！？\nか、雷鳴ってるよぉ…。"},
        { "location": "594/TALK"    , "narrator": "神楽", "text": "通り雨だと思うけど、\nしばらくはやみそうに\nないですね。"},
        { "location": "597/TALK"    , "narrator": "ガブリエラ", "text": "…早く帰りたい。\n全身濡れて寒いし…。"},
        { "location": "598/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "601/TALK"    , "narrator": "つばめ", "text": "あの、アーヤさん、\n大丈夫ですか？"},
        { "location": "605/TALK"    , "narrator": "つばめ", "text": "さっきからずっと\n黙ったままですけど？"},
        { "location": "608/TALK"    , "narrator": "アーヤ", "text": "え、ええ、大丈夫。\n平気よ…。"},
        { "location": "611/TALK"    , "narrator": "アーヤ", "text": "…こんなボロボロで\n薄暗いバス停なのに、\nみんな怖くないのかしら？"},
        { "location": "614/TALK"    , "narrator": "ガブリエラ", "text": "はぁ…まあ、慌てても\nどうなるわけじゃないし、\nやむのを待つしかないか。"},
        { "location": "616/TALK"    , "narrator": "つばめ", "text": "う、うん…くしゅんっ！"},
        { "location": "619/TALK"    , "narrator": "神楽", "text": "…………。"},
        { "location": "620/TALK"    , "narrator": "神楽", "text": "つばめさん、濡れて身体が\n冷えちゃったんですね。"},
        { "location": "621/TALK"    , "narrator": "神楽", "text": "こっちで一緒に\n温まりましょう！"},
        { "location": "624/TALK"    , "narrator": "つばめ", "text": "カイロでも持ってるの？"},
        { "location": "625/TALK"    , "narrator": "神楽", "text": "ぎゅっと抱きしめ合えば、\n二人とも体温でぽかぽか\nです！"},
        { "location": "627/TALK"    , "narrator": "つばめ", "text": "えぇっ！？\nは、恥ずかしいよぉ…。"},
        { "location": "630/TALK"    , "narrator": "ガブリエラ", "text": "それ聞かされてる\nこっちが恥ずかしいわよ。"},
        { "location": "633/TALK"    , "narrator": "神楽", "text": "ガブちゃんも良ければ\n一緒にどうですか？"},
        { "location": "636/TALK"    , "narrator": "ガブリエラ", "text": "遠慮するわ。\nバス停の中見てる方が\n楽しいし。"},
        { "location": "639/TALK"    , "narrator": "アーヤ", "text": "た、楽しいって…。"},
        { "location": "642/TALK"    , "narrator": "ガブリエラ", "text": "…まさかアーヤ、\n怖がってない？"},
        { "location": "643/TALK"    , "narrator": "アーヤ", "text": "えっ！？"},
        { "location": "646/TALK"    , "narrator": "神楽", "text": "ここ、ホラー映画とかに\n出てきそうな雰囲気あり\nますから――"},
        { "location": "649/TALK"    , "narrator": "神楽", "text": "アーヤさんには\nちょっと怖いかも\nしれませんね。"},
        { "location": "651/TALK"    , "narrator": "アーヤ", "text": "べ、別に怖がってないし！\n勝手に決めつけないで。"},
        { "location": "653/TALK"    , "narrator": "ガブリエラ", "text": "ふーん…\nまあ、別に良いけど。"},
        { "location": "655/TALK"    , "narrator": "神楽", "text": "ほら、つばめさん。\nこんなに身体が\n冷え切ってますよ？"},
        { "location": "657/TALK"    , "narrator": "つばめ", "text": "か、神楽ちゃんこそ…\nあっ、腕くすぐったい。"},
        { "location": "659/TALK"    , "narrator": "神楽", "text": "我慢してください。\n風邪ひかないように\n温めてるんですから…。"},
        { "location": "662/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "674/TALK"    , "narrator": "アーヤ", "text": "早く帰りたい(; ;)"},
        { "location": "676/SEL"     , "narrator": "", "text": "みんな、帰る気なさそう"},
        { "location": "677/ACT"     , "narrator": "", "text": "みんな、帰る気なさそう"},
        { "location": "679/TALK"    , "narrator": "アーヤ", "text": "そうなの"},
        { "location": "680/TALK"    , "narrator": "アーヤ", "text": "こんな薄暗いバス停なのに、みんな平気みたい"},
        { "location": "682/SEL"     , "narrator": "", "text": "不気味じゃないのかな？"},
        { "location": "683/SEL"     , "narrator": "", "text": "ダッシュで帰ろう"},
        { "location": "684/ACT"     , "narrator": "", "text": "不気味じゃないのかな？"},
        { "location": "686/TALK"    , "narrator": "アーヤ", "text": "わからないけど、怖がってるのは私だけみたい"},
        { "location": "687/TALK"    , "narrator": "アーヤ", "text": "でも"},
        { "location": "689/TALK"    , "narrator": "アーヤ", "text": "さっきから、背中に変な視線感じる気がするし|ﾟДﾟ)))"},
        { "location": "690/TALK"    , "narrator": "アーヤ", "text": "本当、早く帰りたい…"},
        { "location": "703/TALK"    , "narrator": "アーヤ", "text": "…気のせいだって\nわかってるけど――"},
        { "location": "704/TALK"    , "narrator": "アーヤ", "text": "こういう雰囲気のところに\nいると、どうしても背後が\n気になるわ…。"},
        { "location": "707/TALK"    , "narrator": "ガブリエラ", "text": "ふーん…時刻表を見た\n感じだと――"},
        { "location": "708/TALK"    , "narrator": "ガブリエラ", "text": "昭和六十二年までは、\n間違いなく使われてた\nみたい…。"},
        { "location": "714/TALK"    , "narrator": "つばめ", "text": "凄い昔だね。"},
        { "location": "716/TALK"    , "narrator": "ガブリエラ", "text": "そこからずっと放置\nされてるのかしら？"},
        { "location": "719/TALK"    , "narrator": "ガブリエラ", "text": "…あら？"},
        { "location": "725/TALK"    , "narrator": "ガブリエラ", "text": "ここにあるのって…。"},
        { "location": "727/TALK"    , "narrator": "アーヤ", "text": "こういう時って、\n確か振り向くと幽霊に\n憑りつかれるって――"},
        { "location": "731/TALK"    , "narrator": "ガブリエラ", "text": "やった、ラッキー！"},
        { "location": "735/TALK"    , "narrator": "アーヤ", "text": "っ！？　ひあぁっ！！"},
        { "location": "737/TALK"    , "narrator": "ガブリエラ", "text": "きゃぁっ！？\nな、なになに！？"},
        { "location": "740/TALK"    , "narrator": "神楽", "text": "ど、どうしました！？"},
        { "location": "744/TALK"    , "narrator": "アーヤ", "text": "あっ…あ、あれ？\nギャヴィ？"},
        { "location": "747/TALK"    , "narrator": "ガブリエラ", "text": "何なのよ、もう！\n急に大声出して、\nビックリしたじゃない！"},
        { "location": "748/TALK"    , "narrator": "アーヤ", "text": "び、ビックリしたのは\nこっちよ！"},
        { "location": "749/TALK"    , "narrator": "アーヤ", "text": "後ろから大声で\n驚かしたくせに！"},
        { "location": "750/TALK"    , "narrator": "ガブリエラ", "text": "そんなことしないわよ。"},
        { "location": "751/TALK"    , "narrator": "ガブリエラ", "text": "傘を見つけたから、\nそれでラッキーって\n言っただけだし。"},
        { "location": "752/TALK"    , "narrator": "アーヤ", "text": "え？"},
        { "location": "756/TALK"    , "narrator": "つばめ", "text": "あっ、本当だ！\n二本もあったんだ？"},
        { "location": "758/TALK"    , "narrator": "神楽", "text": "結構古くて汚れてます\nけど、使えるんですか？"},
        { "location": "761/TALK"    , "narrator": "ガブリエラ", "text": "うん、大丈夫そうよ。"},
        { "location": "762/TALK"    , "narrator": "ガブリエラ", "text": "二本あるから、\n相合傘すれば濡れずに\n帰れるわね。"},
        { "location": "763/TALK"    , "narrator": "アーヤ", "text": "や、やったわギャヴィ！\nこれで帰れる！"},
        { "location": "766/TALK"    , "narrator": "ガブリエラ", "text": "うん！"},
        { "location": "767/TALK"    , "narrator": "ガブリエラ", "text": "って…アーヤ、やっぱり\n怖かったんでしょ？"},
        { "location": "770/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "771/TALK"    , "narrator": "ガブリエラ", "text": "とうとうバス停まで\n怖がって…次は何？\n電車の駅が怖くなるの？"},
        { "location": "773/TALK"    , "narrator": "アーヤ", "text": "…今回は、何も言い返せ\nないわね。"},
        { "location": "774/ACT"     , "narrator": "", "text": "ダッシュで帰ろう"},
        { "location": "775/TALK"    , "narrator": "アーヤ", "text": "それはちょっと、嫌かも"},
        { "location": "776/TALK"    , "narrator": "アーヤ", "text": "もう濡れてはいるけど、傘無しで雨の中走るのは嫌よ"},
        { "location": "777/TALK"    , "narrator": "アーヤ", "text": "多分、みんなもそう言うと思う"},
        { "location": "788/TALK"    , "narrator": "アーヤ", "text": "…走って帰るのは、\n最終手段よね？"},
        { "location": "793/TALK"    , "narrator": "つばめ", "text": "そうですね…。\n今は、やんでくれるのを\n待ちたいです。"},
        { "location": "795/TALK"    , "narrator": "神楽", "text": "私、濡れるのって\nそんな好きじゃないから、\n出来れば避けたいです…。"},
        { "location": "796/TALK"    , "narrator": "神楽", "text": "タクシーでも通って\nくれればいいのに…。"},
        { "location": "799/TALK"    , "narrator": "ガブリエラ", "text": "アーヤ、もしかして\n走って帰りたいとか\n思ってる？"},
        { "location": "803/TALK"    , "narrator": "アーヤ", "text": "うーん…まあ、今ももう\nずぶ濡れだけど――"},
        { "location": "804/TALK"    , "narrator": "アーヤ", "text": "この雨の中を走るのは、\nちょっと嫌かも…。"},
        { "location": "807/TALK"    , "narrator": "アーヤ", "text": "まあ、ずっとここに\nいるのも同じくらい\n嫌だけど…。"},
        { "location": "809/TALK"    , "narrator": "神楽", "text": "とにかく、しばらくは\n様子見ですね。"},
        { "location": "812/TALK"    , "narrator": "アーヤ", "text": "…そうね。"},
        { "location": "815/TALK"    , "narrator": "アーヤ", "text": "奥は怖いし、なるべく\n入口の近くにいよう…。"},
        { "location": "818/TALK"    , "narrator": "ガブリエラ", "text": "…それにしても、\n本当にボロボロね。"},
        { "location": "821/TALK"    , "narrator": "ガブリエラ", "text": "うわっ！？\nここ、雨漏りしてるし。"},
        { "location": "823/TALK"    , "narrator": "ガブリエラ", "text": "…あら？"},
        { "location": "828/TALK"    , "narrator": "つばめ", "text": "何か見つけたの？"},
        { "location": "831/TALK"    , "narrator": "ガブリエラ", "text": "やった、ラッキー！\n傘があったわ！"},
        { "location": "834/TALK"    , "narrator": "アーヤ", "text": "えっ！？"},
        { "location": "836/TALK"    , "narrator": "ガブリエラ", "text": "ほら、見て！\n古くて汚れてはいるけど、\nまだ使えそうよ。"},
        { "location": "838/TALK"    , "narrator": "神楽", "text": "誰かが捨てていった\nみたいですね…。"},
        { "location": "841/TALK"    , "narrator": "つばめ", "text": "あ、ガブちゃん！\nそっちにもう一本\nあるよ！"},
        { "location": "843/TALK"    , "narrator": "ガブリエラ", "text": "やったわ！\nこれで相合傘すれば、\n濡れずに帰れるわね。"},
        { "location": "844/TALK"    , "narrator": "アーヤ", "text": "…その傘、\nどこにあったの？"},
        { "location": "847/TALK"    , "narrator": "ガブリエラ", "text": "どこって、ここよ。\nアーヤのすぐ後ろに\n立てかけてあったわ。"},
        { "location": "848/TALK"    , "narrator": "ガブリエラ", "text": "アーヤが影になってて、\n見えなかったみたい。"},
        { "location": "849/TALK"    , "narrator": "アーヤ", "text": "そ、そうだったんだ…。\n全然気づかなかったわ。"},
        { "location": "850/TALK"    , "narrator": "ガブリエラ", "text": "まったく、変なところで\n抜けてるんだから…。"},
        { "location": "853/TALK"    , "narrator": "神楽", "text": "あの、とりあえず\n傘も手に入れたこと\nですし――"},
        { "location": "854/TALK"    , "narrator": "神楽", "text": "早く帰りませんか？\nお風呂で温まらないと、\n風邪引いちゃいます。"},
        { "location": "857/TALK"    , "narrator": "ガブリエラ", "text": "そうね。\nはい、あんた達の傘。"},
        { "location": "860/TALK"    , "narrator": "つばめ", "text": "ありがと、ガブちゃん。"},
        { "location": "863/TALK"    , "narrator": "ガブリエラ", "text": "ほら、行くわよアーヤ。"},
        { "location": "866/TALK"    , "narrator": "アーヤ", "text": "え、ええ…。"},
        { "location": "870/TALK"    , "narrator": "アーヤ", "text": "…ちょっと振り向けば、\nすぐに見つかったはず\nなのに…。"},
        { "location": "872/TALK"    , "narrator": "アーヤ", "text": "私って、少し怖がり\n過ぎるのかしら？"},
        { "location": "512/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>8月26日　 3:56 PM</color>\n合宿中、とある雨の日のこと"}
    ]
}
