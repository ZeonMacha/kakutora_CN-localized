        { "location": "7/SCENARIO", "narrator": "", "text": "016_百人までの第一歩"},
        { "location": "32/TALK"   , "narrator": "つばめ", "text": "新しいお友達と行ったカフェ"},
        { "location": "33/TALK"   , "narrator": "つばめ", "text": "楽しかったな(*´︶`*)"},
        { "location": "35/SEL"    , "narrator": "", "text": "応援団が増えそうだね"},
        { "location": "36/SEL"    , "narrator": "", "text": "雛達の方が良くない？"},
        { "location": "37/SEL"    , "narrator": "", "text": "ＷＡＶＥ交換した？"},
        { "location": "38/TALK"   , "narrator": "つばめ", "text": "かわぃぃお店だったし"},
        { "location": "39/TALK"   , "narrator": "つばめ", "text": "お店の人も素敵だったょ"},
        { "location": "40/TALK"   , "narrator": "つばめ", "text": "お茶も美味しかった"},
        { "location": "41/ACT"    , "narrator": "", "text": "応援団が増えそうだね"},
        { "location": "42/TALK"   , "narrator": "つばめ", "text": "応援団とか大げさだょ"},
        { "location": "43/TALK"   , "narrator": "つばめ", "text": "普通のお友達だょ"},
        { "location": "44/TALK"   , "narrator": "つばめ", "text": "ぅんとね"},
        { "location": "45/TALK"   , "narrator": "つばめ", "text": "二人ともバイトと塾で忙しいって言ってた"},
        { "location": "46/TALK"   , "narrator": "つばめ", "text": "でも"},
        { "location": "47/TALK"   , "narrator": "つばめ", "text": "また遊ぼうねって約束したんだヽ(*´∀｀*)ﾉ"},
        { "location": "48/TALK"   , "narrator": "つばめ", "text": "楽しみ"},
        { "location": "49/ACT"    , "narrator": "", "text": "雛達の方が良くない？"},
        { "location": "50/TALK"   , "narrator": "つばめ", "text": "そんな言い方どうかと思うょ？"},
        { "location": "51/TALK"   , "narrator": "つばめ", "text": "お友達を比べてるみたいでよくなぃ"},
        { "location": "52/TALK"   , "narrator": "つばめ", "text": "みんな大事なお友達なんだから！"},
        { "location": "53/ACT"    , "narrator": "", "text": "ＷＡＶＥ交換した？"},
        { "location": "55/TALK"   , "narrator": "つばめ", "text": "もちろん"},
        { "location": "56/TALK"   , "narrator": "つばめ", "text": "さっきもメッセージしたんだ"},
        { "location": "57/TALK"   , "narrator": "つばめ", "text": "今日は楽しかったねって"},
        { "location": "58/TALK"   , "narrator": "つばめ", "text": "こうぃぅのすごくうれしぃね"}
    ]
}
