        "title": "Extra007 ヒメゴトチャット",
        "sub_title": "うちのマシンが火を噴く、か？"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "000_うちのマシンが火を噴く、か？"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "相棒よ"},
        { "location": "33/TALK"   , "narrator": "みやび", "text": "あまりうちを本気にさせるな"},
        { "location": "34/TALK"   , "narrator": "みやび", "text": "おかげでアーヤのＰＣが火を噴くことになったではないか"},
        { "location": "37/SEL"    , "narrator": "", "text": "アーヤ喜んでた？"},
        { "location": "38/SEL"    , "narrator": "", "text": "お疲れ様でした"},
        { "location": "39/SEL"    , "narrator": "", "text": "$me$のも改造してほしい"},
        { "location": "40/ACT"    , "narrator": "", "text": "アーヤ喜んでた？"},
        { "location": "41/TALK"   , "narrator": "みやび", "text": "当然だ"},
        { "location": "43/TALK"   , "narrator": "みやび", "text": "と言いたいところだが"},
        { "location": "44/TALK"   , "narrator": "みやび", "text": "早すぎて気持ち悪い、だそうな"},
        { "location": "46/SEL"    , "narrator": "", "text": "どれだけハイスペック？"},
        { "location": "47/SEL"    , "narrator": "", "text": "やりすぎたんじゃない？"},
        { "location": "48/ACT"    , "narrator": "", "text": "どれだけハイスペック？"},
        { "location": "49/TALK"   , "narrator": "みやび", "text": "いや"},
        { "location": "51/TALK"   , "narrator": "みやび", "text": "そこまでではないはず"},
        { "location": "52/TALK"   , "narrator": "みやび", "text": "むしろ普通"},
        { "location": "53/ACT"    , "narrator": "", "text": "やりすぎたんじゃない？"},
        { "location": "54/TALK"   , "narrator": "みやび", "text": "まさか"},
        { "location": "55/TALK"   , "narrator": "みやび", "text": "そこまではしていない"},
        { "location": "56/TALK"   , "narrator": "みやび", "text": "謙遜なく"},
        { "location": "58/TALK"   , "narrator": "みやび", "text": "今までどうやってＰＣを使ってたのか"},
        { "location": "59/TALK"   , "narrator": "みやび", "text": "気になるぞね"},
        { "location": "60/ACT"    , "narrator": "", "text": "お疲れ様でした"},
        { "location": "61/TALK"   , "narrator": "みやび", "text": "うむ"},
        { "location": "62/TALK"   , "narrator": "みやび", "text": "苦しゅうない"},
        { "location": "64/TALK"   , "narrator": "みやび", "text": "ま"},
        { "location": "65/TALK"   , "narrator": "みやび", "text": "うちも楽しかったしな"},
        { "location": "66/ACT"    , "narrator": "", "text": "$me$のも改造してほしい"},
        { "location": "69/TALK"   , "narrator": "みやび", "text": "よい心がけじゃ"},
        { "location": "71/TALK"   , "narrator": "みやび", "text": "任せておけ"},
        { "location": "72/TALK"   , "narrator": "みやび", "text": "なんて言うと思ったか"},
        { "location": "73/TALK"   , "narrator": "みやび", "text": "実際は"},
        { "location": "74/TALK"   , "narrator": "みやび", "text": "それなりにえい値段のを買うのが吉"},
        { "location": "75/TALK"   , "narrator": "みやび", "text": "保証もあるしな"},
        { "location": "77/SEL"    , "narrator": "", "text": "それでもみやびの改造したやつがいい"},
        { "location": "78/SEL"    , "narrator": "", "text": "ちょっと期待外れだった"},
        { "location": "79/ACT"    , "narrator": "", "text": "それでもみやびの改造したやつがいい"},
        { "location": "80/TALK"   , "narrator": "みやび", "text": "ほう"},
        { "location": "81/TALK"   , "narrator": "みやび", "text": "なるほどなるほど"},
        { "location": "82/TALK"   , "narrator": "みやび", "text": "人の話を聞かん奴だな"},
        { "location": "83/TALK"   , "narrator": "みやび", "text": "気が向いたら考えてやるぞね"},
        { "location": "84/ACT"    , "narrator": "", "text": "ちょっと期待外れだった"},
        { "location": "85/TALK"   , "narrator": "みやび", "text": "うちは事実しか言わん"},
        { "location": "86/TALK"   , "narrator": "みやび", "text": "それもこれも"},
        { "location": "87/TALK"   , "narrator": "みやび", "text": "相棒のためぞね"}
    ]
}
