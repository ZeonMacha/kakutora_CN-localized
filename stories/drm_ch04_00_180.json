    "entry":
    [
        { "location": "725/SCENARIO", "narrator": "", "text": "124_秘密を瓶に閉じ込めて"},
        { "location": "750/TALK"    , "narrator": "みやび", "text": "秘密というものは"},
        { "location": "751/TALK"    , "narrator": "みやび", "text": "開示されてしまうと秘密ではない"},
        { "location": "752/TALK"    , "narrator": "みやび", "text": "しかし公然の秘密というものも存在する"},
        { "location": "753/TALK"    , "narrator": "みやび", "text": "その境目はどこか？"},
        { "location": "754/TALK"    , "narrator": "みやび", "text": "また"},
        { "location": "755/TALK"    , "narrator": "みやび", "text": "あえてそのままにしておくという選択肢を選ぶことも可能だ"},
        { "location": "757/SEL"     , "narrator": "", "text": "考え中？"},
        { "location": "758/SEL"     , "narrator": "", "text": "秘密の匂いがする"},
        { "location": "759/ACT"     , "narrator": "", "text": "考え中？"},
        { "location": "760/TALK"    , "narrator": "みやび", "text": "色々と"},
        { "location": "761/ACT"     , "narrator": "", "text": "秘密の匂いがする"},
        { "location": "762/TALK"    , "narrator": "みやび", "text": "嗅ぎつけたか"},
        { "location": "764/TALK"    , "narrator": "みやび", "text": "うちの秘密を知りたくはないかね"},
        { "location": "766/SEL"     , "narrator": "", "text": "知ってるし"},
        { "location": "767/SEL"     , "narrator": "", "text": "二人だけの秘密ってことだね"},
        { "location": "768/SEL"     , "narrator": "", "text": "言ったら秘密じゃなくなるよ"},
        { "location": "769/ACT"     , "narrator": "", "text": "知ってるし"},
        { "location": "779/TALK"    , "narrator": "みやび", "text": "なんと"},
        { "location": "781/TALK"    , "narrator": "みやび", "text": "何を知っているのだ"},
        { "location": "783/SEL"     , "narrator": "", "text": "スリーサイズ？"},
        { "location": "784/SEL"     , "narrator": "", "text": "みやびが美しいことかな"},
        { "location": "785/ACT"     , "narrator": "", "text": "スリーサイズ？"},
        { "location": "786/TALK"    , "narrator": "みやび", "text": "いや"},
        { "location": "787/TALK"    , "narrator": "みやび", "text": "聞かれても"},
        { "location": "788/ACT"     , "narrator": "", "text": "みやびが美しいことかな"},
        { "location": "789/TALK"    , "narrator": "みやび", "text": "それは秘密ではない"},
        { "location": "790/TALK"    , "narrator": "みやび", "text": "ただの事実だ"},
        { "location": "794/TALK"    , "narrator": "みやび", "text": "他にはないのか"},
        { "location": "796/SEL"     , "narrator": "", "text": "みやびはトライナリー"},
        { "location": "797/SEL"     , "narrator": "", "text": "みやびは女子高生"},
        { "location": "798/ACT"     , "narrator": "", "text": "みやびはトライナリー"},
        { "location": "799/TALK"    , "narrator": "みやび", "text": "たしかに秘密だが"},
        { "location": "800/ACT"     , "narrator": "", "text": "みやびは女子高生"},
        { "location": "801/TALK"    , "narrator": "みやび", "text": "秘密……"},
        { "location": "802/TALK"    , "narrator": "みやび", "text": "ではあるか、一部においては"},
        { "location": "804/ACT"     , "narrator": "", "text": "二人だけの秘密ってことだね"},
        { "location": "805/TALK"    , "narrator": "みやび", "text": "そうなるかな"},
        { "location": "806/TALK"    , "narrator": "みやび", "text": "一応"},
        { "location": "807/ACT"     , "narrator": "", "text": "言ったら秘密じゃなくなるよ"},
        { "location": "808/TALK"    , "narrator": "みやび", "text": "それが"},
        { "location": "809/TALK"    , "narrator": "みやび", "text": "そうでもない"},
        { "location": "811/TALK"    , "narrator": "みやび", "text": "実はうちには妹がいる"},
        { "location": "813/SEL"     , "narrator": "", "text": "秘密にしなきゃいけないこと？"},
        { "location": "814/SEL"     , "narrator": "", "text": "他にこのことを知ってるのは誰？"},
        { "location": "815/SEL"     , "narrator": "", "text": "あ、そうなんだ"},
        { "location": "816/ACT"     , "narrator": "", "text": "秘密にしなきゃいけないこと？"},
        { "location": "817/TALK"    , "narrator": "みやび", "text": "そう来るか"},
        { "location": "818/ACT"     , "narrator": "", "text": "他にこのことを知ってるのは誰？"},
        { "location": "819/TALK"    , "narrator": "みやび", "text": "ここにはおらん"},
        { "location": "820/ACT"     , "narrator": "", "text": "あ、そうなんだ"},
        { "location": "821/TALK"    , "narrator": "みやび", "text": "軽いのう"},
        { "location": "823/TALK"    , "narrator": "みやび", "text": "このことは"},
        { "location": "824/TALK"    , "narrator": "みやび", "text": "軍事機密並みの"},
        { "location": "825/TALK"    , "narrator": "みやび", "text": "機密情報であり"},
        { "location": "826/SEL"     , "narrator": "", "text": "えと"},
        { "location": "827/SEL"     , "narrator": "", "text": "ちょっと待って"},
        { "location": "828/SEL"     , "narrator": "", "text": "あの"},
        { "location": "829/TALK"    , "narrator": "みやび", "text": "すなわち$handle$の持っている情報は"},
        { "location": "830/ACT"     , "narrator": "", "text": "えと"},
        { "location": "831/TALK"    , "narrator": "みやび", "text": "なんだ"},
        { "location": "832/ACT"     , "narrator": "", "text": "ちょっと待って"},
        { "location": "833/TALK"    , "narrator": "みやび", "text": "ぬ"},
        { "location": "834/ACT"     , "narrator": "", "text": "あの"},
        { "location": "835/TALK"    , "narrator": "みやび", "text": "その"},
        { "location": "838/SEL"     , "narrator": "", "text": "姉妹がいるって秘密じゃないよね"},
        { "location": "839/SEL"     , "narrator": "", "text": "なんでそんな大きい話になるの"},
        { "location": "840/SEL"     , "narrator": "", "text": "みやびがお姉さんだってことは理解した"},
        { "location": "841/ACT"     , "narrator": "", "text": "姉妹がいるって秘密じゃないよね"},
        { "location": "842/TALK"    , "narrator": "みやび", "text": "ややや"},
        { "location": "843/ACT"     , "narrator": "", "text": "なんでそんな大きい話になるの"},
        { "location": "844/TALK"    , "narrator": "みやび", "text": "おろろ"},
        { "location": "845/ACT"     , "narrator": "", "text": "みやびがお姉さんだってことは理解した"},
        { "location": "846/TALK"    , "narrator": "みやび", "text": "それだけか"},
        { "location": "848/TALK"    , "narrator": "みやび", "text": "なんと"},
        { "location": "850/TALK"    , "narrator": "みやび", "text": "期待する反応が得られんの"},
        { "location": "852/SEL"     , "narrator": "", "text": "何を期待してるの"},
        { "location": "853/ACT"     , "narrator": "", "text": "何を期待してるの"},
        { "location": "854/TALK"    , "narrator": "みやび", "text": "お"},
        { "location": "856/TALK"    , "narrator": "みやび", "text": "この話は"},
        { "location": "857/TALK"    , "narrator": "みやび", "text": "単なる家族構成とは違う話なのだ"},
        { "location": "859/SEL"     , "narrator": "", "text": "えっと…昼ドラ的な？"},
        { "location": "860/SEL"     , "narrator": "", "text": "ゴシップならノーサンキュー"},
        { "location": "861/ACT"     , "narrator": "", "text": "えっと…昼ドラ的な？"},
        { "location": "862/TALK"    , "narrator": "みやび", "text": "そっちでは"},
        { "location": "864/TALK"    , "narrator": "みやび", "text": "ない"},
        { "location": "865/ACT"     , "narrator": "", "text": "ゴシップならノーサンキュー"},
        { "location": "866/TALK"    , "narrator": "みやび", "text": "ハリウッドセレブか"},
        { "location": "868/TALK"    , "narrator": "みやび", "text": "当然知っているはずのことを"},
        { "location": "869/TALK"    , "narrator": "みやび", "text": "知らぬのか"},
        { "location": "871/SEL"     , "narrator": "", "text": "何のこと？"},
        { "location": "872/ACT"     , "narrator": "", "text": "何のこと？"},
        { "location": "873/TALK"    , "narrator": "みやび", "text": "いや"},
        { "location": "877/TALK"    , "narrator": "みやび", "text": "それは秘密ぞね"},
        { "location": "879/TALK"    , "narrator": "みやび", "text": "そしてその秘密は"},
        { "location": "880/TALK"    , "narrator": "みやび", "text": "秘密である理由があるのだ"},
        { "location": "883/TALK"    , "narrator": "ボイスメール", "text": "逆三角形不安定"},
        { "location": "775/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>500pt.</b></color></size>\nアップしました！"},
        { "location": "895/DIALOG"  , "narrator": "Dialog_GETVoice", "text": "<color=green>【みやび】</color>のボイスメール\n<color=red>【逆三角形不安定】</color>\nをゲットしました！"}
    ]
}
