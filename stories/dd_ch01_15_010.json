{
    "dir": "chap15/daydra/dd_ch01_15_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "15152",
        "cid": "tsubame",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "神楽のノート"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "神楽のノート"},
        { "location": "25/TALK"   , "narrator": "つばめ", "text": "ごめんね、卯月さん。\nもう少しで写し終わる\nから…。"},
        { "location": "27/TALK"   , "narrator": "神楽", "text": "そんなに急がなくても、\n一日くらい貸しても\n平気ですよ？"},
        { "location": "28/TALK"   , "narrator": "つばめ", "text": "ううん、大丈夫だよ。"},
        { "location": "31/TALK"   , "narrator": "つばめ", "text": "っていうか、わたしって\n文字写すのが遅いのかな？"},
        { "location": "32/TALK"   , "narrator": "つばめ", "text": "黒板の内容、授業中に\n写しきれないなんて…。"},
        { "location": "33/TALK"   , "narrator": "神楽", "text": "いつもじゃないなら、\nたまたまですよ。"},
        { "location": "34/TALK"   , "narrator": "神楽", "text": "特に今日は、先生も\nひっきりなしに書いて\nましたからね。"},
        { "location": "37/TALK"   , "narrator": "つばめ", "text": "でも、卯月さんは\nちゃんと写せてるよね？"},
        { "location": "39/TALK"   , "narrator": "つばめ", "text": "字も綺麗だし…落書きも\nちょっと描いてあるし。"},
        { "location": "40/TALK"   , "narrator": "つばめ", "text": "あっ、この犬の絵可愛い！\n吹き出しまで付いてるし。"},
        { "location": "43/TALK"   , "narrator": "神楽", "text": "それは重要なポイントに\n描いてる印ですね。"},
        { "location": "44/TALK"   , "narrator": "神楽", "text": "吹き出しにして囲めば、\nその子達が喋ってるような\n感じになるから――"},
        { "location": "45/TALK"   , "narrator": "神楽", "text": "何となく頭の中に\n残るんですよ。"},
        { "location": "47/TALK"   , "narrator": "つばめ", "text": "ふーん…可愛いだけじゃ\nなくて、工夫してあるん\nだね…。"},
        { "location": "49/TALK"   , "narrator": "つばめ", "text": "…わたしも、真似して\n作ってみようかなぁ？"},
        { "location": "50/SEL"    , "narrator": "", "text": "つばめも描いてみよう"},
        { "location": "51/SEL"    , "narrator": "", "text": "提出の時恥ずかしいよ？"},
        { "location": "52/SEL"    , "narrator": "", "text": "描く余裕、あるの？"},
        { "location": "55/TALK"   , "narrator": "つばめ", "text": "こんなノートがあったら、\n勉強も凄く楽しくなる\n気がするし。"},
        { "location": "56/TALK"   , "narrator": "神楽", "text": "そうですね。\n素っ気ないノートよりは、\n読んでて楽しいですし。"},
        { "location": "57/TALK"   , "narrator": "神楽", "text": "まあ、自分で作るから\nちょっと大変では\nありますけど…。"},
        { "location": "60/TALK"   , "narrator": "神楽", "text": "もし作るなら、\n絵は出来る限り簡略化\nした方がいいですよ。"},
        { "location": "61/TALK"   , "narrator": "神楽", "text": "時間の限られた授業中に、\n時間を掛けて凄い絵を\n描いたりは出来ませんし。"},
        { "location": "64/TALK"   , "narrator": "つばめ", "text": "そうだよね…。\n卯月さんの絵も、\nそんな感じだし。"},
        { "location": "65/TALK"   , "narrator": "神楽", "text": "時間を見つけて、サラッと\n描く程度ですからね。"},
        { "location": "66/TALK"   , "narrator": "神楽", "text": "あとは、色を付けたり、\n小さいスタンプを使うのも\nオススメです。"},
        { "location": "67/TALK"   , "narrator": "つばめ", "text": "わぁ、何だか楽しそう！"},
        { "location": "69/TALK"   , "narrator": "神楽", "text": "鞄の中に入ってるので、\n一式出しておきますね。"},
        { "location": "71/TALK"   , "narrator": "つばめ", "text": "ありがとう、卯月さん。\nそれじゃあ早速何か絵を\n描いてみよっと。"},
        { "location": "73/TALK"   , "narrator": "神楽", "text": "…楽しそうな気分を\n壊すようで申し訳ないん\nですけど――"},
        { "location": "74/TALK"   , "narrator": "神楽", "text": "ノートを写す作業のこと、\n忘れないでくださいね？"},
        { "location": "76/ACT"    , "narrator": "", "text": "つばめも描いてみよう"},
        { "location": "97/TALK"   , "narrator": "つばめ", "text": "うん、わたしもそう思ってた"},
        { "location": "98/TALK"   , "narrator": "つばめ", "text": "こっちの方が、絶対勉強も楽しくなるよ"},
        { "location": "110/TALK"  , "narrator": "つばめ", "text": "よーし、決めた！\nわたしも真似して、\n色々絵を描きこむよ。"},
        { "location": "111/TALK"  , "narrator": "神楽", "text": "あ、でしたら、\n絵は出来る限り簡略化\nした方がいいですよ。"},
        { "location": "112/TALK"  , "narrator": "神楽", "text": "時間の限られた授業中に、\n時間を掛けて凄い絵を\n描いたりは出来ませんし。"},
        { "location": "113/TALK"  , "narrator": "つばめ", "text": "そうだよね…。\n卯月さんの絵も、\nそんな感じだし。"},
        { "location": "115/TALK"  , "narrator": "神楽", "text": "時間を見つけて、サラッと\n描く程度ですからね。"},
        { "location": "116/TALK"  , "narrator": "神楽", "text": "あとは、色を付けたり、\n小さいスタンプを使うのも\nオススメです。"},
        { "location": "117/TALK"  , "narrator": "つばめ", "text": "わぁ、何だか楽しそう！"},
        { "location": "119/TALK"  , "narrator": "神楽", "text": "鞄の中に入ってるので、\n一式出しておきますね。"},
        { "location": "120/TALK"  , "narrator": "つばめ", "text": "ありがとう、卯月さん。\nそれじゃあ早速何か絵を\n描いてみよっと。"},
        { "location": "122/TALK"  , "narrator": "神楽", "text": "…楽しそうな気分を\n壊すようで申し訳ないん\nですけど――"},
        { "location": "123/TALK"  , "narrator": "神楽", "text": "ノートを写す作業のこと、\n忘れないでくださいね？"},
        { "location": "124/ACT"   , "narrator": "", "text": "提出の時恥ずかしいよ？"},
        { "location": "146/TALK"  , "narrator": "つばめ", "text": "そうだよ、提出のこと忘れてたよ"},
        { "location": "147/TALK"  , "narrator": "つばめ", "text": "卯月さん、大丈夫かな？"},
        { "location": "159/TALK"  , "narrator": "つばめ", "text": "ねえ、卯月さん。\nやっぱり絵は消した方が\nいいんじゃないかな？"},
        { "location": "161/TALK"  , "narrator": "神楽", "text": "えっ、どうしてですか？"},
        { "location": "162/TALK"  , "narrator": "つばめ", "text": "授業で提出する時に、\n先生に見られちゃうん\nだよ？"},
        { "location": "163/TALK"  , "narrator": "つばめ", "text": "きっと、真面目に授業を\n受けなさい、って\n怒られちゃうよ。"},
        { "location": "164/TALK"  , "narrator": "神楽", "text": "そんなことないですよ。"},
        { "location": "165/TALK"  , "narrator": "神楽", "text": "前の学校でも同じような\nノートの取り方をして\nいましたけど――"},
        { "location": "166/TALK"  , "narrator": "神楽", "text": "褒められこそすれ、\n怒られはしません\nでしたし。"},
        { "location": "168/TALK"  , "narrator": "つばめ", "text": "えっ！？　褒められたの？"},
        { "location": "170/TALK"  , "narrator": "神楽", "text": "はい。重要な個所にだけ、\n的確に絵が描かれてて\n目立ちやすい、って――"},
        { "location": "171/TALK"  , "narrator": "神楽", "text": "絵のところに花丸を\n描いてもらったり\nしてたんです。"},
        { "location": "172/TALK"  , "narrator": "つばめ", "text": "そうだったんだぁ…。"},
        { "location": "174/TALK"  , "narrator": "つばめ", "text": "じゃあ、重要な箇所を\nしっかり見分けないと\nいけないんだね？"},
        { "location": "175/TALK"  , "narrator": "神楽", "text": "もちろんですよ。\nじゃなきゃ、落書き帳に\nなっちゃいますよ？"},
        { "location": "177/TALK"  , "narrator": "つばめ", "text": "だよね…。"},
        { "location": "178/TALK"  , "narrator": "つばめ", "text": "卯月さんみたいな\nノートは、作ってみたい\nから――"},
        { "location": "179/TALK"  , "narrator": "つばめ", "text": "いっぱい勉強して、\n大切な個所を見分けられる\nようになるのを目指すよ。"},
        { "location": "180/TALK"  , "narrator": "神楽", "text": "つばめさんがやる気を\n出せたみたいで、私も\n嬉しいです。"},
        { "location": "181/TALK"  , "narrator": "神楽", "text": "けど…勉強の目的、\nちょっと変わってきて\nいませんか？"},
        { "location": "182/ACT"   , "narrator": "", "text": "描く余裕、あるの？"},
        { "location": "204/TALK"  , "narrator": "つばめ", "text": "授業中に描くのは、多分無理かも…"},
        { "location": "205/TALK"  , "narrator": "つばめ", "text": "でも、帰ってからなら描けるよね？"},
        { "location": "216/TALK"  , "narrator": "つばめ", "text": "うん、決めた！"},
        { "location": "217/TALK"  , "narrator": "つばめ", "text": "授業中は無理だから、\n帰ってから、復習する\n時に描くよ。"},
        { "location": "218/TALK"  , "narrator": "つばめ", "text": "それなら時間の制限も\nないから、ゆっくり\n描けるしね。"},
        { "location": "221/TALK"  , "narrator": "神楽", "text": "つばめさんの場合は、\nそっちの方が良さそう\nですね。"},
        { "location": "222/TALK"  , "narrator": "神楽", "text": "それに、帰ってから\nノートを開く理由も\nできるので――"},
        { "location": "223/TALK"  , "narrator": "神楽", "text": "毎日読み返すのが\n習慣になるかも\nしれませんし。"},
        { "location": "224/TALK"  , "narrator": "つばめ", "text": "いいことづくめだよね。\nよーし、寮に帰ったら、\n早速やってみよっと。"},
        { "location": "225/TALK"  , "narrator": "神楽", "text": "あ、待ってください。\nつばめさんのノート、\n貸してもらえますか？"},
        { "location": "226/TALK"  , "narrator": "つばめ", "text": "うん、いいけど…。"},
        { "location": "228/TALK"  , "narrator": "神楽", "text": "ありがとうございます。\nじゃあ、上の余白に…。"},
        { "location": "230/TALK"  , "narrator": "つばめ", "text": "…あ、かわいい！\n犬の絵だ！"},
        { "location": "231/TALK"  , "narrator": "神楽", "text": "ここに吹き出しを\n付けて…。"},
        { "location": "233/TALK"  , "narrator": "つばめ", "text": "えっと…『僕を描くのに\n夢中にならないでね』？"},
        { "location": "235/TALK"  , "narrator": "神楽", "text": "つばめさん、なんだか\n絵を描く方に集中しちゃい\nそうな気がしたので――"},
        { "location": "236/TALK"  , "narrator": "神楽", "text": "絶対に見てくれそうな\n注意書きにしてみました。"},
        { "location": "238/TALK"  , "narrator": "つばめ", "text": "あはは…言われなかったら\n多分そうなってたよ。"},
        { "location": "239/TALK"  , "narrator": "つばめ", "text": "でも、これならもう\n安心だね。\nありがと、卯月さん。"},
        { "location": "15/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>7月18日　15:53 PM</color>\nとある初夏の平日、神楽坂トライナリーでのバイト中のこと。"}
    ]
}
