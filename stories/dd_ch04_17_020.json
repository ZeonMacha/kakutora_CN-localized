{
    "dir": "chap17/daydra/dd_ch04_17_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "17456",
        "cid": "miyabi",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "おサボり旅行"
    },
    "entry":
    [
        { "location": "193/SCENARIO", "narrator": "", "text": "おサボり旅行"},
        { "location": "204/TALK"    , "narrator": "みやび", "text": "ここが高崎駅なが？\n意外と大きいんやね。"},
        { "location": "206/TALK"    , "narrator": "雛", "text": "そりゃそうですよ。\n新幹線も止まる駅です\nからねー。"},
        { "location": "208/TALK"    , "narrator": "みやび", "text": "ふむ、なるほど…。"},
        { "location": "210/TALK"    , "narrator": "みやび", "text": "…なのに、うちらは\nわざわざ鈍行でここまで\n来たんやね？"},
        { "location": "211/TALK"    , "narrator": "雛", "text": "言い出したのは\nみやび先輩じゃ\nないですか。"},
        { "location": "212/TALK"    , "narrator": "雛", "text": "学校行くとき、\n電車の中で言ったこと\n覚えてますか？"},
        { "location": "215/TALK"    , "narrator": "みやび", "text": "ん～？　確か…。"},
        { "location": "230/TALK"    , "narrator": "みやび", "text": "…なあ、ひなこちゃん。"},
        { "location": "231/TALK"    , "narrator": "みやび", "text": "登校途中に思い立って、\nぶらり電車の旅とか\nするん――"},
        { "location": "232/TALK"    , "narrator": "みやび", "text": "青春っぽくてえいと\n思わん？"},
        { "location": "234/TALK"    , "narrator": "雛", "text": "何ですかその超が付く\n素敵な提案！？"},
        { "location": "235/TALK"    , "narrator": "雛", "text": "もしかして、あたしに\n学校サボろうっていう\nお誘いですか？"},
        { "location": "236/TALK"    , "narrator": "みやび", "text": "ひなこちゃんを\n不良の道へ進ませるような\nことはできんよ。"},
        { "location": "238/TALK"    , "narrator": "みやび", "text": "ただ、うちがしてみたい\n思うて聞いちゅうんよ。"},
        { "location": "239/TALK"    , "narrator": "雛", "text": "そうですか…。"},
        { "location": "240/TALK"    , "narrator": "雛", "text": "ぶらり電車旅というのは、\n新幹線もありですか？"},
        { "location": "242/TALK"    , "narrator": "みやび", "text": "鈍行一択やね。\n新幹線やとぶらり感が\n無くてつまらんし。"},
        { "location": "243/TALK"    , "narrator": "みやび", "text": "ひなこちゃんやったら、\nどこへ行こう思う？"},
        { "location": "245/TALK"    , "narrator": "雛", "text": "…そうですね。"},
        { "location": "246/TALK"    , "narrator": "雛", "text": "新宿から湘南新宿ライン、\nもしくは上野から高崎線に\n乗って――"},
        { "location": "248/TALK"    , "narrator": "雛", "text": "高崎までのんびりと\n電車旅行を楽しむと\n思います。"},
        { "location": "250/TALK"    , "narrator": "みやび", "text": "高崎…群馬やったっけ？"},
        { "location": "251/TALK"    , "narrator": "雛", "text": "はい。\n約二時間、鈍行に揺られる\n旅になりますね。"},
        { "location": "253/TALK"    , "narrator": "みやび", "text": "…なるほど。"},
        { "location": "267/TALK"    , "narrator": "雛", "text": "…って、話から始まって、\n本当に来ることになったん\nですから。"},
        { "location": "269/TALK"    , "narrator": "みやび", "text": "…そうやったね。\nそんなこと言った記憶、\nうっすらとあるんよ。"},
        { "location": "271/TALK"    , "narrator": "みやび", "text": "…けんど、思い付きで\n鈍行旅行なんて――"},
        { "location": "273/TALK"    , "narrator": "みやび", "text": "自分でやっておきながら、\n今更ビックリちや。"},
        { "location": "275/TALK"    , "narrator": "雛", "text": "あたしも、まさかそれに\n付き合ってる自分に\n驚いてます。"},
        { "location": "276/TALK"    , "narrator": "雛", "text": "う～ん…これから\nどうしようかなぁ？"},
        { "location": "277/TALK"    , "narrator": "雛", "text": "高崎駅から出てる\n電車だと、えっと…。"},
        { "location": "278/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "290/TALK"    , "narrator": "みやび", "text": "高崎なう！"},
        { "location": "292/SEL"     , "narrator": "", "text": "そうみたいだね"},
        { "location": "293/ACT"     , "narrator": "", "text": "そうみたいだね"},
        { "location": "295/TALK"    , "narrator": "みやび", "text": "自分でもビックリしてるんよ"},
        { "location": "296/TALK"    , "narrator": "みやび", "text": "学校サボッて、鈍行でこんなところまで来ちゅうなんて"},
        { "location": "297/TALK"    , "narrator": "みやび", "text": "信じられんがよ"},
        { "location": "299/SEL"     , "narrator": "", "text": "これは夢だ！"},
        { "location": "300/SEL"     , "narrator": "", "text": "今更だし、もう楽しもうよ"},
        { "location": "301/ACT"     , "narrator": "", "text": "これは夢だ！"},
        { "location": "302/TALK"    , "narrator": "みやび", "text": "夢？"},
        { "location": "303/TALK"    , "narrator": "みやび", "text": "まあ、それやったらありえそうやね"},
        { "location": "315/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "316/TALK"    , "narrator": "雛", "text": "みやび先輩。\nこの後なんですけど…。"},
        { "location": "317/TALK"    , "narrator": "みやび", "text": "夢や。"},
        { "location": "318/TALK"    , "narrator": "雛", "text": "…はい？"},
        { "location": "322/TALK"    , "narrator": "みやび", "text": "そうや。\nこれは、きっと夢や！"},
        { "location": "338/TALK"    , "narrator": "みやび", "text": "っ！？"},
        { "location": "340/TALK"    , "narrator": "雛", "text": "あ、起きましたか？"},
        { "location": "342/TALK"    , "narrator": "みやび", "text": "…ひなこちゃん？\nここは…。"},
        { "location": "345/TALK"    , "narrator": "みやび", "text": "…電車の中…。"},
        { "location": "347/TALK"    , "narrator": "みやび", "text": "なんや、やっぱしあれは\n夢やったんか。"},
        { "location": "350/TALK"    , "narrator": "みやび", "text": "…ははっ、そうやな。\nいくらうちでも、\nあれはないちや。"},
        { "location": "351/TALK"    , "narrator": "雛", "text": "何の話ですか？"},
        { "location": "353/TALK"    , "narrator": "みやび", "text": "いや、なんでもないんよ。\nちっくと、変な夢を\n見ただけやき。"},
        { "location": "354/TALK"    , "narrator": "雛", "text": "そうだったんですか…。"},
        { "location": "356/TALK"    , "narrator": "雛", "text": "それよりみやび先輩。\nほら、見てください。"},
        { "location": "357/TALK"    , "narrator": "雛", "text": "次が、高崎駅ですよ。"},
        { "location": "360/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "361/TALK"    , "narrator": "雛", "text": "？　みやび先輩？"},
        { "location": "363/TALK"    , "narrator": "みやび", "text": "…これは、夢か？"},
        { "location": "364/TALK"    , "narrator": "雛", "text": "えっと…もしかして、\n寝ぼけちゃってるとか？"},
        { "location": "366/TALK"    , "narrator": "みやび", "text": "…いや、なんでもない。"},
        { "location": "367/TALK"    , "narrator": "みやび", "text": "ちっくと、薄気味悪い\n気分やな…。"},
        { "location": "368/ACT"     , "narrator": "", "text": "今更だし、もう楽しもうよ"},
        { "location": "370/TALK"    , "narrator": "みやび", "text": "…そうやね"},
        { "location": "371/TALK"    , "narrator": "みやび", "text": "信じようが信じまいが、これが現実なんやし"},
        { "location": "372/TALK"    , "narrator": "みやび", "text": "今更学校にも行けんき、今日は遊ぶちや"},
        { "location": "384/TALK"    , "narrator": "雛", "text": "みやび先輩！\nあたしに提案があります！"},
        { "location": "386/TALK"    , "narrator": "みやび", "text": "ん、言うてみい。"},
        { "location": "387/TALK"    , "narrator": "雛", "text": "両毛線という電車が\nここから出ているん\nですが――"},
        { "location": "388/TALK"    , "narrator": "雛", "text": "あたし、それに乗って\nみたいんです。"},
        { "location": "391/TALK"    , "narrator": "みやび", "text": "それ、面白い電車なが？"},
        { "location": "392/TALK"    , "narrator": "雛", "text": "手動でドアを開け閉め\nできる電車なんですよー。"},
        { "location": "393/TALK"    , "narrator": "みやび", "text": "マジか！？\nそんな電車見たこと\nないき――"},
        { "location": "395/TALK"    , "narrator": "みやび", "text": "次はそれに乗って、\nぶらり旅行を続けるちや！"},
        { "location": "413/TALK"    , "narrator": "真幌", "text": "…なるほど。"},
        { "location": "414/TALK"    , "narrator": "真幌", "text": "その何ちゃら線に乗って、\nそのまま温泉に入りに\n行き――"},
        { "location": "415/TALK"    , "narrator": "真幌", "text": "今頃になって\n土産片手に帰ってきた、\nということだな？"},
        { "location": "417/TALK"    , "narrator": "雛", "text": "は、はい…。\n予定より、少しだけ\n遅くなりましたけど…。"},
        { "location": "420/TALK"    , "narrator": "みやび", "text": "青春を満喫した\n結果ながです。"},
        { "location": "421/TALK"    , "narrator": "みやび", "text": "まほさんやったら\n理解してくれよる\n思っちょります"},
        { "location": "427/TALK"    , "narrator": "真幌", "text": "出来るわけないだろうが！"},
        { "location": "428/TALK"    , "narrator": "真幌", "text": "学校サボッて群馬まで\n行って、温泉入って\n帰ってくるとか――"},
        { "location": "429/TALK"    , "narrator": "真幌", "text": "どこが青春だ！？\n老人の日帰り温泉旅行と\n変わらんぞ！？"},
        { "location": "432/TALK"    , "narrator": "雛", "text": "…ごもっともです。"},
        { "location": "433/TALK"    , "narrator": "みやび", "text": "まあ、サボッて青春を\n満喫した分、明日からは\n真面目にやりますき――"},
        { "location": "435/TALK"    , "narrator": "みやび", "text": "お説教はこの辺で\n勘弁してもらえん\nですか？"},
        { "location": "436/TALK"    , "narrator": "真幌", "text": "…驚くほど反省の色が\n見えないんだが？"},
        { "location": "438/TALK"    , "narrator": "雛", "text": "し、してますよー。\n反省してますから。"},
        { "location": "439/TALK"    , "narrator": "雛", "text": "だから、温泉まんじゅう\nでも食べて、東雲教官も\n落ち着いてください。"},
        { "location": "440/TALK"    , "narrator": "みやび", "text": "色々試食して選んだが\nですよ。"},
        { "location": "442/TALK"    , "narrator": "雛", "text": "お煎餅とどっちにするかで\n迷ったんですよねー。"},
        { "location": "444/TALK"    , "narrator": "真幌", "text": "こいつら…反省文でも\n書かせるか？"},
        { "location": "202/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>7月27日　11:02 AM</color>\nとある平日の午前中、高崎駅にて。"},
        { "location": "455/DIALOG"  , "narrator": "Dialog_GEThimegoto_ch04", "text": "【ガタンゴトンと揺れながら】"}
    ]
}
