        { "location": "56/TALK", "narrator": "ガブリエラ", "text": "あら、こんなの貰っちゃっていいの？"},
        { "location": "58/TALK", "narrator": "ガブリエラ", "text": "丁度、行ってみたいレストランがあったのよ"},
        { "location": "59/TALK", "narrator": "ガブリエラ", "text": "ありがたく使わせてもらうわ"},
        { "location": "62/SEL" , "narrator": "", "text": "どういうレストランなの？"},
        { "location": "63/ACT" , "narrator": "", "text": "どういうレストランなの？"},
        { "location": "65/TALK", "narrator": "ガブリエラ", "text": "渋谷に新しく出来たお店よ"},
        { "location": "66/TALK", "narrator": "ガブリエラ", "text": "ちょっと値段は高めなんだけれど"},
        { "location": "67/TALK", "narrator": "ガブリエラ", "text": "本格的なイタリアンが食べれるらしいの"},
        { "location": "68/TALK", "narrator": "ガブリエラ", "text": "場所も渋谷駅のすぐ前らしいし"},
        { "location": "71/SEL" , "narrator": "", "text": "場所は関係ないと思うけど？"},
        { "location": "72/ACT" , "narrator": "", "text": "場所は関係ないと思うけど？"},
        { "location": "75/TALK", "narrator": "ガブリエラ", "text": "あるわ"},
        { "location": "76/TALK", "narrator": "ガブリエラ", "text": "渋谷って、あんまり行かないから"},
        { "location": "77/TALK", "narrator": "ガブリエラ", "text": "どこに何があるのか、さっぱりわからないの"},
        { "location": "78/TALK", "narrator": "ガブリエラ", "text": "駅の出口すら、まだよくわかってないし"},
        { "location": "79/TALK", "narrator": "ガブリエラ", "text": "多分、駅から離れた場所に行こうとしたら"},
        { "location": "80/TALK", "narrator": "ガブリエラ", "text": "間違いなく迷うと思うわ"}
    ]
