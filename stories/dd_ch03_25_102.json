        "title": "005 メインストーリー",
        "sub_title": "少女の顔をした戦争＜後編＞"
    },
    "entry":
    [
        { "location": "427/SCENARIO", "narrator": "", "text": "釦とリボンと指ぬきと"},
        { "location": "442/TALK"    , "narrator": "ガブリエラ", "text": "あたし……。"},
        { "location": "443/TALK"    , "narrator": "ガブリエラ", "text": "冷静にならなきゃって\n思ってたのに…。"},
        { "location": "455/TALK"    , "narrator": "ガブリエラ", "text": "ごめんなさい"},
        { "location": "456/TALK"    , "narrator": "ガブリエラ", "text": "さっきの話だけど"},
        { "location": "458/SEL"     , "narrator": "", "text": "バグバグなんだけど！"},
        { "location": "459/SEL"     , "narrator": "", "text": "本気にしないで"},
        { "location": "460/SEL"     , "narrator": "", "text": "迷ってる暇なんてないよ！"},
        { "location": "461/ACT"     , "narrator": "", "text": "迷ってる暇なんてないよ！"},
        { "location": "462/ACT"     , "narrator": "", "text": "迷ってる暇なんてないよ！"},
        { "location": "463/ACT"     , "narrator": "", "text": "迷ってる暇なんてないよ！"},
        { "location": "465/TALK"    , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "466/TALK"    , "narrator": "ガブリエラ", "text": "あたし一人で怖がって"},
        { "location": "467/TALK"    , "narrator": "ガブリエラ", "text": "焦ってたわ"},
        { "location": "468/TALK"    , "narrator": "ガブリエラ", "text": "だけど"},
        { "location": "469/TALK"    , "narrator": "ガブリエラ", "text": "もう迷わない"},
        { "location": "470/TALK"    , "narrator": "ガブリエラ", "text": "アーヤがここにいてって"},
        { "location": "471/TALK"    , "narrator": "ガブリエラ", "text": "言ったんだから"},
        { "location": "472/TALK"    , "narrator": "ガブリエラ", "text": "ここで待つわ"},
        { "location": "473/TALK"    , "narrator": "ガブリエラ", "text": "アーヤを信じて"},
        { "location": "475/SEL"     , "narrator": "", "text": "それがいいよ"},
        { "location": "476/SEL"     , "narrator": "", "text": "探しに行かないの？"},
        { "location": "477/ACT"     , "narrator": "", "text": "それがいいよ"},
        { "location": "478/TALK"    , "narrator": "ガブリエラ", "text": "そうでしょう？"},
        { "location": "479/ACT"     , "narrator": "", "text": "探しに行かないの？"},
        { "location": "480/TALK"    , "narrator": "ガブリエラ", "text": "行かないわ"},
        { "location": "482/TALK"    , "narrator": "ガブリエラ", "text": "ここは今戦場だもの"},
        { "location": "483/TALK"    , "narrator": "ガブリエラ", "text": "戦場で勝手な行動は命取り"},
        { "location": "484/TALK"    , "narrator": "ガブリエラ", "text": "それを忘れていたの"},
        { "location": "485/TALK"    , "narrator": "ガブリエラ", "text": "焦りすぎて"},
        { "location": "487/SEL"     , "narrator": "", "text": "そっか"},
        { "location": "488/SEL"     , "narrator": "", "text": "少しは落ち着いたんだ"},
        { "location": "489/ACT"     , "narrator": "", "text": "そっか"},
        { "location": "490/TALK"    , "narrator": "ガブリエラ", "text": "そうだったのよ"},
        { "location": "491/ACT"     , "narrator": "", "text": "少しは落ち着いたんだ"},
        { "location": "492/TALK"    , "narrator": "ガブリエラ", "text": "そう思いたいわ"},
        { "location": "494/TALK"    , "narrator": "ガブリエラ", "text": "あたし確かに情勢不安な場所で生まれたけど"},
        { "location": "495/TALK"    , "narrator": "ガブリエラ", "text": "戦争をしている時期もあったけど"},
        { "location": "496/TALK"    , "narrator": "ガブリエラ", "text": "でも前線からは遠く離れていたんだわ"},
        { "location": "497/TALK"    , "narrator": "ガブリエラ", "text": "当たり前よね"},
        { "location": "499/TALK"    , "narrator": "ガブリエラ", "text": "子供だもの"},
        { "location": "501/SEL"     , "narrator": "", "text": "でも慣れてはいるんじゃ…"},
        { "location": "502/SEL"     , "narrator": "", "text": "結構重い体験だよね"},
        { "location": "503/ACT"     , "narrator": "", "text": "でも慣れてはいるんじゃ…"},
        { "location": "504/TALK"    , "narrator": "ガブリエラ", "text": "全然だった"},
        { "location": "505/ACT"     , "narrator": "", "text": "結構重い体験だよね"},
        { "location": "506/TALK"    , "narrator": "ガブリエラ", "text": "今の方がよっぽど重いわよ"},
        { "location": "508/TALK"    , "narrator": "ガブリエラ", "text": "あたしのお父様は人に向ける引き金の重さを知っているわ"},
        { "location": "509/TALK"    , "narrator": "ガブリエラ", "text": "でもあたしは知らずにすんでた"},
        { "location": "510/TALK"    , "narrator": "ガブリエラ", "text": "だけど"},
        { "location": "511/TALK"    , "narrator": "ガブリエラ", "text": "この先"},
        { "location": "514/TALK"    , "narrator": "ガブリエラ", "text": "ねえ$marzanna$"},
        { "location": "515/TALK"    , "narrator": "ガブリエラ", "text": "あたしがかわいそうだと思うなら"},
        { "location": "516/TALK"    , "narrator": "ガブリエラ", "text": "何か言って"},
        { "location": "518/SEL"     , "narrator": "", "text": "欲しいのは同情？"},
        { "location": "519/ACT"     , "narrator": "", "text": "欲しいのは同情？"},
        { "location": "521/TALK"    , "narrator": "ガブリエラ", "text": "同情で"},
        { "location": "522/TALK"    , "narrator": "ガブリエラ", "text": "抱きしめてもらえるなら"},
        { "location": "523/TALK"    , "narrator": "ガブリエラ", "text": "同情でもいいわ"},
        { "location": "525/SEL"     , "narrator": "", "text": "怖くて当たり前だから"},
        { "location": "526/SEL"     , "narrator": "", "text": "$me$がハグしてるところを妄想して"},
        { "location": "527/SEL"     , "narrator": "", "text": "ガブリエラはとてもいい子だ"},
        { "location": "528/ACT"     , "narrator": "", "text": "怖くて当たり前だから"},
        { "location": "529/TALK"    , "narrator": "ガブリエラ", "text": "そうよ"},
        { "location": "530/TALK"    , "narrator": "ガブリエラ", "text": "怖いの"},
        { "location": "531/TALK"    , "narrator": "ガブリエラ", "text": "あたしすごく"},
        { "location": "532/TALK"    , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "533/TALK"    , "narrator": "ガブリエラ", "text": "それでいいのね・・・"},
        { "location": "534/ACT"     , "narrator": "", "text": "$me$がハグしてるところを妄想して"},
        { "location": "535/TALK"    , "narrator": "ガブリエラ", "text": "妄想って何よ"},
        { "location": "536/TALK"    , "narrator": "ガブリエラ", "text": "妄想って！"},
        { "location": "537/TALK"    , "narrator": "ガブリエラ", "text": "もう！"},
        { "location": "538/ACT"     , "narrator": "", "text": "ガブリエラはとてもいい子だ"},
        { "location": "539/TALK"    , "narrator": "ガブリエラ", "text": "・・・そうやって"},
        { "location": "540/TALK"    , "narrator": "ガブリエラ", "text": "子供扱いするのね"},
        { "location": "541/TALK"    , "narrator": "ガブリエラ", "text": "でも今回だけは"},
        { "location": "542/TALK"    , "narrator": "ガブリエラ", "text": "子供でいいわ"},
        { "location": "554/TALK"    , "narrator": "ガブリエラ", "text": "ふう…。"},
        { "location": "555/TALK"    , "narrator": "ガブリエラ", "text": "少し落ち着けたかしら…。\nアーヤの冷静さには\n全然及ばないけど…。"},
        { "location": "556/TALK"    , "narrator": "ガブリエラ", "text": "$marzanna$の\nおかげね。"},
        { "location": "557/TALK"    , "narrator": "ガブリエラ", "text": "戦場で仲間を\n信じるって\nこういうことなのね。"},
        { "location": "560/TALK"    , "narrator": "ガブリエラ", "text": "ありがとう…。"},
        { "location": "571/DIALOG"  , "narrator": "Dialog_chapter_ch03", "text": "【MV EXE_KAGURa】"}
    ]
}
