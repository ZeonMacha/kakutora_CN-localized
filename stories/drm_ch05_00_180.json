    "entry":
    [
        { "location": "1053/SCENARIO", "narrator": "", "text": "ぎょーむれんらく"},
        { "location": "1078/TALK"    , "narrator": "神楽", "text": "機密事項は言うわけにはいかないから最初から知らないってことにするしかないぴょん"},
        { "location": "1079/TALK"    , "narrator": "神楽", "text": "プライベートは明かしたくないことって誰にでもあるぴょん"},
        { "location": "1080/TALK"    , "narrator": "神楽", "text": "そういうのってやっぱり嘘になっちゃうんですかね？"},
        { "location": "1082/SEL"     , "narrator": "", "text": "厳密に言えばなる"},
        { "location": "1083/SEL"     , "narrator": "", "text": "ならないでしょ"},
        { "location": "1084/SEL"     , "narrator": "", "text": "$me$は神楽の全てを知ってる"},
        { "location": "1085/ACT"     , "narrator": "", "text": "厳密に言えばなる"},
        { "location": "1086/TALK"    , "narrator": "神楽", "text": "厳密にしたいんですねっ♪"},
        { "location": "1087/TALK"    , "narrator": "神楽", "text": "なるほどです"},
        { "location": "1088/ACT"     , "narrator": "", "text": "ならないでしょ"},
        { "location": "1089/TALK"    , "narrator": "神楽", "text": "そうですよね～～～"},
        { "location": "1090/TALK"    , "narrator": "神楽", "text": "ならないですよねっ♪"},
        { "location": "1091/ACT"     , "narrator": "", "text": "$me$は神楽の全てを知ってる"},
        { "location": "1092/TALK"    , "narrator": "神楽", "text": "えっｿﾝﾅ、、、、"},
        { "location": "1093/TALK"    , "narrator": "神楽", "text": "恥ずかしいです～～～～～！！！"},
        { "location": "1095/TALK"    , "narrator": "神楽", "text": "ぴょんこが嘘を付いたりする時は波風を立てたくないって気持ちがあるんですよ"},
        { "location": "1096/TALK"    , "narrator": "神楽", "text": "こう見えても大人ですからねぴょんこは"},
        { "location": "1098/SEL"     , "narrator": "", "text": "だから時々心配"},
        { "location": "1099/SEL"     , "narrator": "", "text": "$me$の方が大人だもんね！"},
        { "location": "1100/SEL"     , "narrator": "", "text": "たまには子供になってもいいと思う"},
        { "location": "1101/ACT"     , "narrator": "", "text": "だから時々心配"},
        { "location": "1103/TALK"    , "narrator": "神楽", "text": "心配してくれてるんですねっ♪"},
        { "location": "1104/TALK"    , "narrator": "神楽", "text": "ぴょんこうれしいですっ"},
        { "location": "1105/ACT"     , "narrator": "", "text": "$me$の方が大人だもんね！"},
        { "location": "1106/TALK"    , "narrator": "神楽", "text": "ｵﾄﾅｵﾄﾅー"},
        { "location": "1107/TALK"    , "narrator": "神楽", "text": "$handle$さんったら大人～～～！"},
        { "location": "1108/ACT"     , "narrator": "", "text": "たまには子供になってもいいと思う"},
        { "location": "1111/TALK"    , "narrator": "神楽", "text": "その時は$handle$さんに甘えますねっ♪"},
        { "location": "1114/TALK"    , "narrator": "神楽", "text": "実際のところ$handle$さんはぴょんことの関係をどうとらえてるんですか？"},
        { "location": "1116/SEL"     , "narrator": "", "text": "恋人への第一歩"},
        { "location": "1117/SEL"     , "narrator": "", "text": "愛とか恋に該当するもの"},
        { "location": "1118/SEL"     , "narrator": "", "text": "攻略対象"},
        { "location": "1119/ACT"     , "narrator": "", "text": "恋人への第一歩"},
        { "location": "1120/TALK"    , "narrator": "神楽", "text": "なるほどです♪"},
        { "location": "1121/ACT"     , "narrator": "", "text": "愛とか恋に該当するもの"},
        { "location": "1122/TALK"    , "narrator": "神楽", "text": "照れちゃうやつですね～～♪"},
        { "location": "1123/ACT"     , "narrator": "", "text": "攻略対象"},
        { "location": "1124/TALK"    , "narrator": "神楽", "text": "あっあっそういうことですか♪"},
        { "location": "1125/TALK"    , "narrator": "神楽", "text": "ぴょんこはギャルゲのヒロインなわけですねっ？"},
        { "location": "1128/SEL"     , "narrator": "", "text": "だから素で接して欲しいな"},
        { "location": "1129/SEL"     , "narrator": "", "text": "本心を打ち明けて欲しい"},
        { "location": "1130/SEL"     , "narrator": "", "text": "どんな神楽でも側にいるから"},
        { "location": "1131/ACT"     , "narrator": "", "text": "だから素で接して欲しいな"},
        { "location": "1132/TALK"    , "narrator": "神楽", "text": "ｵﾝﾅﾉｺはすっぴんで好きな人には会えないものなんです♪"},
        { "location": "1133/ACT"     , "narrator": "", "text": "本心を打ち明けて欲しい"},
        { "location": "1134/TALK"    , "narrator": "神楽", "text": "$handle$さんにもヒミツにしたいことだってありますよ～～"},
        { "location": "1135/ACT"     , "narrator": "", "text": "どんな神楽でも側にいるから"},
        { "location": "1136/TALK"    , "narrator": "神楽", "text": "やだﾔｻｼｰ"},
        { "location": "1137/TALK"    , "narrator": "神楽", "text": "ｷｭﾝってなっちゃいます～～♪"},
        { "location": "1141/SEL"     , "narrator": "", "text": "本気で言ってるのにな…"},
        { "location": "1142/SEL"     , "narrator": "", "text": "まだ信用してくれてないんだね"},
        { "location": "1143/SEL"     , "narrator": "", "text": "$me$がんばるからね"},
        { "location": "1144/ACT"     , "narrator": "", "text": "本気で言ってるのにな…"},
        { "location": "1145/TALK"    , "narrator": "神楽", "text": "ありがとぴょん♪"},
        { "location": "1147/ACT"     , "narrator": "", "text": "まだ信用してくれてないんだね"},
        { "location": "1148/TALK"    , "narrator": "神楽", "text": "信用してますよ～♪"},
        { "location": "1150/ACT"     , "narrator": "", "text": "$me$がんばるからね"},
        { "location": "1151/TALK"    , "narrator": "神楽", "text": "楽しみにしてます♪"},
        { "location": "1155/TALK"    , "narrator": "神楽", "text": "えっとですね、、、"},
        { "location": "1156/TALK"    , "narrator": "神楽", "text": "心配してくれるのはとてもうれしいんですけど"},
        { "location": "1158/TALK"    , "narrator": "神楽", "text": "ぴょんこにもプライバシーとかありますし"},
        { "location": "1159/TALK"    , "narrator": "神楽", "text": "全部をフルオープンにするわけにはいかないんですよ"},
        { "location": "1160/TALK"    , "narrator": "神楽", "text": "それに義理とかそういうのもありませんよね"},
        { "location": "1161/TALK"    , "narrator": "神楽", "text": "私たちの間に"},
        { "location": "1162/TALK"    , "narrator": "神楽", "text": "違いますか？"},
        { "location": "1164/SEL"     , "narrator": "", "text": "そういうのも含めて話そうよ"},
        { "location": "1165/SEL"     , "narrator": "", "text": "今はそうかもしれないけど"},
        { "location": "1166/SEL"     , "narrator": "", "text": "話す気になるまで待つから"},
        { "location": "1167/ACT"     , "narrator": "", "text": "そういうのも含めて話そうよ"},
        { "location": "1168/TALK"    , "narrator": "神楽", "text": "それはまた今度"},
        { "location": "1169/ACT"     , "narrator": "", "text": "今はそうかもしれないけど"},
        { "location": "1170/TALK"    , "narrator": "神楽", "text": "今は、、、、、って"},
        { "location": "1171/TALK"    , "narrator": "神楽", "text": "今後もそうですよ"},
        { "location": "1172/ACT"     , "narrator": "", "text": "話す気になるまで待つから"},
        { "location": "1173/TALK"    , "narrator": "神楽", "text": "多分ならないと思いますけど"},
        { "location": "1175/TALK"    , "narrator": "神楽", "text": "業務連絡なんかはちゃんとしますから"},
        { "location": "1176/TALK"    , "narrator": "神楽", "text": "それ以上のことは必要ないですよね"},
        { "location": "1177/TALK"    , "narrator": "神楽", "text": "ぴょんこだって忙しい時もありますし"},
        { "location": "1178/TALK"    , "narrator": "神楽", "text": "そういうことでよろしくお願いします"},
        { "location": "1181/TALK"    , "narrator": "ボイスメール", "text": "誤解しないで"},
        { "location": "1193/DIALOG"  , "narrator": "Dialog_GETVoice", "text": "<color=green>【神楽】</color>のボイスメール\n<color=red>【誤解しないで】</color>\nをゲットしました！"}
