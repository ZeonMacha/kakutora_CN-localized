        { "location": "129/SEL"     , "narrator": "", "text": "リズムがあってこそのメロディだから？"},
        { "location": "130/SEL"     , "narrator": "", "text": "ラップにはメロディは不要だyo!"},
        { "location": "131/SEL"     , "narrator": "", "text": "それは音痴って言うんじゃない"},
        { "location": "132/ACT"     , "narrator": "", "text": "リズムがあってこそのメロディだから？"},
        { "location": "133/TALK"    , "narrator": "アーヤ", "text": "そういうことなのかしら？"},
        { "location": "134/ACT"     , "narrator": "", "text": "ラップにはメロディは不要だyo!"},
        { "location": "135/TALK"    , "narrator": "アーヤ", "text": "え"},
