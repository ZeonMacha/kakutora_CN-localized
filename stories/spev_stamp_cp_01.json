        "title": "【期間限定】トライナリースタンプ配信記念",
        "sub_title": "トライナリースタンプ配信記念"
    },
    "entry":
    [
        { "location": "19/TALK"   , "narrator": "みやび", "text": "ん～…。"},
        { "location": "20/TALK"   , "narrator": "みやび", "text": "…まだか？\nそろそろやと思うたん\nやけんど…。"},
        { "location": "24/TALK"   , "narrator": "つばめ", "text": "あ、いたいた。\n探しましたよ。"},
        { "location": "26/TALK"   , "narrator": "つばめ", "text": "休憩時間、もうとっくに\n終わっちゃってますよ？"},
        { "location": "30/TALK"   , "narrator": "みやび", "text": "知っちゅうがよ。"},
        { "location": "31/TALK"   , "narrator": "つばめ", "text": "…ゲームですか？"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "いんや、お届け物を\n待っちゅうがよ。"},
        { "location": "33/TALK"   , "narrator": "つばめ", "text": "お届け物、ですか？"},
        { "location": "34/TALK"   , "narrator": "みやび", "text": "ロマンチックな言い方を\nすると――"},
        { "location": "35/TALK"   , "narrator": "みやび", "text": "時空の果ての要人殿からの\nプレゼント、やね。"},
        { "location": "38/TALK"   , "narrator": "つばめ", "text": "ジクーノハテ…？\n外国ですか？"},
        { "location": "39/TALK"   , "narrator": "みやび", "text": "ある意味正解。"},
        { "location": "47/TALK"   , "narrator": "みやび", "text": "よっしゃ、来たぞね♪"},
        { "location": "50/TALK"   , "narrator": "つばめ", "text": "あの…いったいなにが\n届いたんですか？"},
        { "location": "51/TALK"   , "narrator": "みやび", "text": "ふふん、つばめちゃんにも\n送っちゃろうかね。"},
        { "location": "57/TALK"   , "narrator": "みやび", "text": "ほい、送信完了。\n見てみぃ。"},
        { "location": "59/TALK"   , "narrator": "つばめ", "text": "は、はあ…。"},
        { "location": "73/TALK"   , "narrator": "つばめ", "text": "ぇっ！？(ﾟ△ﾟ;ﾉ)ﾉ"},
        { "location": "77/TALK"   , "narrator": "つばめ", "text": "すごぃ"},
        { "location": "78/TALK"   , "narrator": "つばめ", "text": "これ"},
        { "location": "79/TALK"   , "narrator": "つばめ", "text": "わたし達のスタンプ(*≧∀≦*) "},
        { "location": "81/TALK"   , "narrator": "みやび", "text": "その通り"},
        { "location": "82/TALK"   , "narrator": "みやび", "text": "これが待っていたお届け物"},
        { "location": "84/TALK"   , "narrator": "つばめ", "text": "神楽ちゃん！"},
        { "location": "85/TALK"   , "narrator": "つばめ", "text": "これもかわぃぃ(*´ω｀*)"},
        { "location": "87/TALK"   , "narrator": "みやび", "text": "ふむふむ"},
        { "location": "88/TALK"   , "narrator": "みやび", "text": "使い勝手良好なり"},
        { "location": "89/TALK"   , "narrator": "みやび", "text": "皆に布教するとしよう"},
        { "location": "110/TALK"  , "narrator": "神楽", "text": "――と、いうわけで、\n明け方に仮眠を取ろうと\n思っていたら…。"},
        { "location": "111/TALK"  , "narrator": "神楽", "text": "熟睡してしまって、\n遅れてしまったんです。"},
        { "location": "112/TALK"  , "narrator": "ガブリエラ", "text": "…真夜中につぶやきが\nあったから、まさかとは\n思ってたけど…。"},
        { "location": "114/TALK"  , "narrator": "ガブリエラ", "text": "徹夜で絵を描いてたとは\n思わなかったわ。"},
        { "location": "116/TALK"  , "narrator": "神楽", "text": "深夜から明け方の時間が\n一番筆が進むんですよね。"},
        { "location": "117/TALK"  , "narrator": "アーヤ", "text": "だからって、待ち合わせに\n遅れていい理由には\nならないのよ？"},
        { "location": "119/TALK"  , "narrator": "神楽", "text": "わかっていますよ。\nそこはちゃんと\n反省してますから。"},
        { "location": "121/TALK"  , "narrator": "神楽", "text": "ですけど…、\n創作活動を\n頑張った後には――"},
        { "location": "122/TALK"  , "narrator": "神楽", "text": "身体が求める限りの\n休息を与えなければ\nならないんですっ！！"},
        { "location": "123/TALK"  , "narrator": "ガブリエラ", "text": "だから、それ理由に\nなってないから…。"},
        { "location": "130/TALK"  , "narrator": "神楽", "text": "……っと。\nみやびさんからですね。"},
        { "location": "143/TALK"  , "narrator": "ガブリエラ", "text": "あたしにも来た…。\nつばめもいるみたいよ？"},
        { "location": "149/TALK"  , "narrator": "アーヤ", "text": "どうしたのかしら？\nまさか、緊急事態？"},
        { "location": "151/TALK"  , "narrator": "みやび", "text": "あ～アアァア～！"},
        { "location": "154/TALK"  , "narrator": "アーヤ", "text": "は！？"},
        { "location": "157/TALK"  , "narrator": "みやび", "text": "都会のターザン"},
        { "location": "158/TALK"  , "narrator": "みやび", "text": "アーヤ・ザ・ワイルド"},
        { "location": "159/TALK"  , "narrator": "みやび", "text": "参上！"},
        { "location": "160/TALK"  , "narrator": "神楽", "text": "ちょｗｗｗｗｗｗｗｗｗ"},
        { "location": "162/TALK"  , "narrator": "アーヤ", "text": "ちょっとなにこれ！？"},
        { "location": "163/TALK"  , "narrator": "アーヤ", "text": "私でしょこれ！？(>_<)"},
        { "location": "164/TALK"  , "narrator": "システム", "text": "恋ヶ崎みやび さんからスタンプが届きました"},
        { "location": "165/TALK"  , "narrator": "神楽", "text": "ありがとうございます♪"},
        { "location": "168/TALK"  , "narrator": "ガブリエラ", "text": "勝手に私たちのスタンプ作ったの？"},
        { "location": "170/TALK"  , "narrator": "つばめ", "text": "そぅみたぃ(･Д･｀)"},
        { "location": "171/TALK"  , "narrator": "つばめ", "text": "みやびさんのぉ友達が"},
        { "location": "172/TALK"  , "narrator": "ガブリエラ", "text": "そんなお友達がいたのね"},
        { "location": "178/TALK"  , "narrator": "神楽", "text": "えーっ！なにこれ！！！！"},
        { "location": "179/TALK"  , "narrator": "神楽", "text": "超かわいいんですけど！！"},
        { "location": "181/TALK"  , "narrator": "神楽", "text": "ヤバみＭＡＸですっ！！"},
        { "location": "184/TALK"  , "narrator": "つばめ", "text": "スタンプだけど"},
        { "location": "185/TALK"  , "narrator": "つばめ", "text": "ちょっと恥ずかしぃかも(/ω＼)"},
        { "location": "188/TALK"  , "narrator": "ガブリエラ", "text": "ちょっとつばめ！"},
        { "location": "190/TALK"  , "narrator": "ガブリエラ", "text": "私のスタンプ使わないでちょうだい"},
        { "location": "191/TALK"  , "narrator": "ガブリエラ", "text": "私が照れてるみたいじゃないの！！////////////"},
        { "location": "193/TALK"  , "narrator": "みやび", "text": "ガブちゃんスタンプは"},
        { "location": "194/TALK"  , "narrator": "みやび", "text": "甘えたり"},
        { "location": "195/TALK"  , "narrator": "みやび", "text": "ツンデレするときに便利"},
        { "location": "196/TALK"  , "narrator": "みやび", "text": "むしろそれ用"},
        { "location": "197/TALK"  , "narrator": "ガブリエラ", "text": "なにそれ！？"},
        { "location": "198/TALK"  , "narrator": "みやび", "text": "忠実に再現された本人クオリティー"},
        { "location": "199/TALK"  , "narrator": "ガブリエラ", "text": "何度も言ってるけど"},
        { "location": "200/TALK"  , "narrator": "ガブリエラ", "text": "私はツンデレじゃないわ"},
        { "location": "202/TALK"  , "narrator": "みやび", "text": "なにっ！？"},
        { "location": "204/TALK"  , "narrator": "みやび", "text": "ガブちゃんがツンデレか否か"},
        { "location": "205/TALK"  , "narrator": "みやび", "text": "それを決める会合が今始まる"},
        { "location": "206/TALK"  , "narrator": "ガブリエラ", "text": "はじまらないから！"},
        { "location": "208/TALK"  , "narrator": "つばめ", "text": "二人とも(´ｪ｀；)三(；´ｪ｀)"},
        { "location": "209/TALK"  , "narrator": "つばめ", "text": "ケンカしなぃで"},
        { "location": "212/TALK"  , "narrator": "神楽", "text": "その通りです！！"},
        { "location": "216/TALK"  , "narrator": "アーヤ", "text": "スタンプのせいで（；￢＿￢）"},
        { "location": "218/TALK"  , "narrator": "アーヤ", "text": "誰が喋ってるか"},
        { "location": "219/TALK"  , "narrator": "アーヤ", "text": "混乱するわ(-ω-;)"},
        { "location": "222/TALK"  , "narrator": "みやび", "text": "みんな"},
        { "location": "223/TALK"  , "narrator": "みやび", "text": "もう使いこなしている"},
        { "location": "224/TALK"  , "narrator": "みやび", "text": "さすがは現代っ子"},
        { "location": "226/TALK"  , "narrator": "つばめ", "text": "みやびさんの使った"},
        { "location": "227/TALK"  , "narrator": "つばめ", "text": "そのシリーズも"},
        { "location": "228/TALK"  , "narrator": "つばめ", "text": "とっても好きです(*´ω｀*)"},
        { "location": "230/TALK"  , "narrator": "神楽", "text": "スタンプって"},
        { "location": "232/TALK"  , "narrator": "神楽", "text": "使う人の個性出ますよね♪"},
        { "location": "236/TALK"  , "narrator": "アーヤ", "text": "私のお気に入り(^^"},
        { "location": "237/TALK"  , "narrator": "アーヤ", "text": "一生懸命な顔"},
        { "location": "238/TALK"  , "narrator": "アーヤ", "text": "かわいい(*^.^*)"},
        { "location": "241/TALK"  , "narrator": "つばめ", "text": "わたしは"},
        { "location": "243/TALK"  , "narrator": "つばめ", "text": "嬉しぃときに使ぇる"},
        { "location": "245/TALK"  , "narrator": "つばめ", "text": "素敵なスタンプ(*´︶`*)"},
        { "location": "246/TALK"  , "narrator": "つばめ", "text": "これが好きだよ(´∀｀*)"},
        { "location": "247/TALK"  , "narrator": "神楽", "text": "ガブちゃんは？"},
        { "location": "251/TALK"  , "narrator": "ガブリエラ", "text": "これよ"},
        { "location": "252/TALK"  , "narrator": "つばめ", "text": "それもかわぃぃよね(´ω｀*)"},
        { "location": "253/TALK"  , "narrator": "ガブリエラ", "text": "このウサギ"},
        { "location": "254/TALK"  , "narrator": "ガブリエラ", "text": "とってもキュートよね"},
        { "location": "255/TALK"  , "narrator": "ガブリエラ", "text": "なかでもこれが一番かわいいわ"},
        { "location": "257/TALK"  , "narrator": "みやび", "text": "ふむふむなるほど"},
        { "location": "258/TALK"  , "narrator": "アーヤ", "text": "みやびは？"},
        { "location": "261/TALK"  , "narrator": "つばめ", "text": "好きなのなぃってこと？"},
        { "location": "264/TALK"  , "narrator": "神楽", "text": "紛らわしいです"},
        { "location": "266/TALK"  , "narrator": "みやび", "text": "紛らわしくもあり"},
        { "location": "267/TALK"  , "narrator": "みやび", "text": "適度に力が抜けたこの感じ"},
        { "location": "268/TALK"  , "narrator": "みやび", "text": "好きにならずにいられない"},
        { "location": "269/TALK"  , "narrator": "神楽", "text": "理解不能です。。"},
        { "location": "272/TALK"  , "narrator": "神楽", "text": "前言撤回ｗ便利そうｗｗ"},
        { "location": "274/TALK"  , "narrator": "ガブリエラ", "text": "ほんき？"},
        { "location": "277/TALK"  , "narrator": "みやび", "text": "あっ"},
        { "location": "278/TALK"  , "narrator": "神楽", "text": "あっ？"},
        { "location": "280/TALK"  , "narrator": "神楽", "text": "なにか？"},
        { "location": "282/TALK"  , "narrator": "みやび", "text": "追加プレゼント也"},
        { "location": "284/TALK"  , "narrator": "神楽", "text": "あ・・・"},
        { "location": "286/TALK"  , "narrator": "システム", "text": "恋ヶ崎みやび さんからスタンプが届きました"},
        { "location": "288/TALK"  , "narrator": "神楽", "text": "何故この人のまで作った！？"},
        { "location": "290/TALK"  , "narrator": "みやび", "text": "これだけにあらず！"},
        { "location": "292/TALK"  , "narrator": "みやび", "text": "エリカさんも参戦！！"},
        { "location": "293/TALK"  , "narrator": "みやび", "text": "ドンドン使うぞね"},
        { "location": "295/TALK"  , "narrator": "アーヤ", "text": "いや"},
        { "location": "296/TALK"  , "narrator": "アーヤ", "text": "私は使いにくいから(-ω-;)"},
        { "location": "299/TALK"  , "narrator": "つばめ", "text": "そぅですか？"},
        { "location": "300/TALK"  , "narrator": "つばめ", "text": "かわぃくて"},
        { "location": "301/TALK"  , "narrator": "つばめ", "text": "使ぃやすぃと思ぃますよ(ﾟ∀ﾟ人)"},
        { "location": "302/TALK"  , "narrator": "アーヤ", "text": "でも"},
        { "location": "303/TALK"  , "narrator": "アーヤ", "text": "姉だし(￣Д￣ )"},
        { "location": "306/TALK"  , "narrator": "ガブリエラ", "text": "そんなこと言って"},
        { "location": "308/TALK"  , "narrator": "ガブリエラ", "text": "お姉さんを悲しませるつもり？"},
        { "location": "311/TALK"  , "narrator": "アーヤ", "text": "こらっ"},
        { "location": "312/TALK"  , "narrator": "アーヤ", "text": "からかわないの(>_<)"},
        { "location": "314/TALK"  , "narrator": "つばめ", "text": "羨ましぃです(´･ω･｀) "},
        { "location": "315/TALK"  , "narrator": "つばめ", "text": "わたし"},
        { "location": "316/TALK"  , "narrator": "つばめ", "text": "一人っ子だから"},
        { "location": "317/TALK"  , "narrator": "つばめ", "text": "お姉さんぃぃなぁ(*´ω｀*)"},
        { "location": "318/TALK"  , "narrator": "アーヤ", "text": "そうなの？"},
        { "location": "319/TALK"  , "narrator": "アーヤ", "text": "そんないいものじゃないのに(´o｀；"},
        { "location": "321/TALK"  , "narrator": "ガブリエラ", "text": "素直になれば？"},
        { "location": "323/TALK"  , "narrator": "アーヤ", "text": "そりゃまあ"},
        { "location": "324/TALK"  , "narrator": "アーヤ", "text": "最近"},
        { "location": "325/TALK"  , "narrator": "アーヤ", "text": "少し見直しはしたけど(｡-_-｡)"},
        { "location": "326/TALK"  , "narrator": "アーヤ", "text": "それでも・・・"},
        { "location": "328/TALK"  , "narrator": "神楽", "text": "ツンデレアーヤさんキタコレ"},
        { "location": "331/TALK"  , "narrator": "アーヤ", "text": "ツンデレじゃない！"},
        { "location": "333/TALK"  , "narrator": "アーヤ", "text": "こらっ(｀ヘ´)"},
        { "location": "334/TALK"  , "narrator": "アーヤ", "text": "っていうか"},
        { "location": "335/TALK"  , "narrator": "アーヤ", "text": "素直じゃないって"},
        { "location": "336/TALK"  , "narrator": "アーヤ", "text": "ギャヴィに言われるなんて( ・_・)σﾞ"},
        { "location": "338/TALK"  , "narrator": "ガブリエラ", "text": "なによ"},
        { "location": "340/TALK"  , "narrator": "アーヤ", "text": "ちょっとビックリ(;^_^A"},
        { "location": "341/TALK"  , "narrator": "ガブリエラ", "text": "どういう意味よ！"},
        { "location": "342/TALK"  , "narrator": "ガブリエラ", "text": "私は普通に素直だし"},
        { "location": "345/TALK"  , "narrator": "神楽", "text": "本日のおまいう"},
        { "location": "348/TALK"  , "narrator": "システム", "text": "【ガブリエラ】さんがログアウトしました。"},
        { "location": "349/TALK"  , "narrator": "システム", "text": "【國政綾水】さんがログアウトしました。"},
        { "location": "350/TALK"  , "narrator": "神楽", "text": "ああっ！"},
        { "location": "351/TALK"  , "narrator": "つばめ", "text": "どうしたの？"},
        { "location": "352/TALK"  , "narrator": "神楽", "text": "二人がリアル口論開始しちゃいました"},
        { "location": "354/TALK"  , "narrator": "神楽", "text": "すみませんつばめさん"},
        { "location": "355/TALK"  , "narrator": "神楽", "text": "また後で♪"},
        { "location": "373/TALK"  , "narrator": "つばめ", "text": "あわわ、大変です！\nケンカが始まっちゃった\nみたいですよ！？"},
        { "location": "375/TALK"  , "narrator": "みやび", "text": "あ～、平気や平気。\nいつものことやき。"},
        { "location": "376/TALK"  , "narrator": "みやび", "text": "ケンカやなくて、\nじゃれおうちょる\nだけちや。"},
        { "location": "379/TALK"  , "narrator": "つばめ", "text": "そうなんですか？"},
        { "location": "380/TALK"  , "narrator": "みやび", "text": "気にするだけ無駄ぞね。"},
        { "location": "384/TALK"  , "narrator": "つばめ", "text": "はあ…わかりました…。"},
        { "location": "385/TALK"  , "narrator": "つばめ", "text": "…それにしても、\nこのスタンプ\nとっても面白いですね。"},
        { "location": "386/TALK"  , "narrator": "みやび", "text": "時空を超えて届いた\nありがたいスタンプ\nやきね。"},
        { "location": "387/TALK"  , "narrator": "みやび", "text": "有効活用させてもらうと\nするぞね。"},
        { "location": "388/SEL"   , "narrator": "（選択肢）", "text": "$me$もほしい！"},
        { "location": "389/SEL"   , "narrator": "（選択肢）", "text": "うらやましい・・・"},
        { "location": "390/ACT"   , "narrator": "", "text": "$me$もほしい！"},
        { "location": "407/TALK"  , "narrator": "みやび", "text": "ほしいのか？"},
        { "location": "408/TALK"  , "narrator": "みやび", "text": "買えるはずだぞ？"},
        { "location": "409/TALK"  , "narrator": "みやび", "text": "そっちでも"},
        { "location": "410/TALK"  , "narrator": "みやび", "text": "しかるべきショップで"},
        { "location": "411/TALK"  , "narrator": "みやび", "text": "それがどこなのか"},
        { "location": "412/TALK"  , "narrator": "みやび", "text": "うちは知らん"},
        { "location": "413/TALK"  , "narrator": "みやび", "text": "自分で調べよ"},
        { "location": "414/TALK"  , "narrator": "システム", "text": "彼女たちの使うスタンプが、皆さんの世界のスタンプショップで「クリエイターズスタンプ」として配信を開始しました。"},
        { "location": "415/TALK"  , "narrator": "みやび", "text": "なにこの便利機能？"},
        { "location": "416/TALK"  , "narrator": "みやび", "text": "やはり そっちの世界にも"},
        { "location": "417/TALK"  , "narrator": "みやび", "text": "そういうものがあるのか"},
        { "location": "418/TALK"  , "narrator": "みやび", "text": "まあ"},
        { "location": "419/TALK"  , "narrator": "みやび", "text": "手に入れる方法はわかったな？"},
        { "location": "420/TALK"  , "narrator": "みやび", "text": "スタンプのうちらのことも"},
        { "location": "422/TALK"  , "narrator": "みやび", "text": "末永く大切にするのだぞ"},
