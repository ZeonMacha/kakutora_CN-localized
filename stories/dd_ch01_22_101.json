{
    "dir": "chap22/daydra/dd_ch01_22_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "22102",
        "cid": "tsubame",
        "title": "002 メインストーリー",
        "sub_title": "慟哭＜前編＞"
    },
    "entry":
    [
        { "location": "41/TALK"   , "narrator": "アーヤ", "text": "もうこんな時間…。\nみんな、そろそろ\n寝る準備するわよ。"},
        { "location": "43/TALK"   , "narrator": "ガブリエラ", "text": "まだ平気よ。\nもう少しいいでしょ？"},
        { "location": "46/TALK"   , "narrator": "アーヤ", "text": "ダメよ。\n明日も朝から\n訓練なんだから。"},
        { "location": "48/TALK"   , "narrator": "ガブリエラ", "text": "あーあ、明日雨が\n降ればいいのに…。"},
        { "location": "50/TALK"   , "narrator": "つばめ", "text": "そうなったら\n一日お休みになるし。"},
        { "location": "51/TALK"   , "narrator": "つばめ", "text": "お休みになったら\nちょっとお買い物に\n行きたいな。"},
        { "location": "54/TALK"   , "narrator": "ガブリエラ", "text": "あのねぇ…つばめは\nそんなこと言ってる\n余裕ないでしょ？"},
        { "location": "55/TALK"   , "narrator": "ガブリエラ", "text": "今日の模擬戦、\n何回あたし達に\n負けたか覚えてる？"},
        { "location": "57/TALK"   , "narrator": "つばめ", "text": "あ、あれでも\n頑張ったんだよ。\nね？"},
        { "location": "59/TALK"   , "narrator": "神楽", "text": "そうです。\nこれでも一生懸命\nだったんですよ？"},
        { "location": "61/TALK"   , "narrator": "ガブリエラ", "text": "結果出さなきゃ\n意味ないわよ。"},
        { "location": "63/TALK"   , "narrator": "アーヤ", "text": "…まあ、ギャヴィの\n言うことも間違っては\nいないわね。"},
        { "location": "65/TALK"   , "narrator": "アーヤ", "text": "二人が頑張ってるのは\nわかるわ。"},
        { "location": "66/TALK"   , "narrator": "アーヤ", "text": "だけど、\n空回りしてるって\nいうか。"},
        { "location": "67/TALK"   , "narrator": "アーヤ", "text": "訓練に集中できてない\nように思ったわ。"},
        { "location": "70/TALK"   , "narrator": "神楽", "text": "…………。"},
        { "location": "74/TALK"   , "narrator": "つばめ", "text": "そ、そんなこと\nないです！"},
        { "location": "75/TALK"   , "narrator": "つばめ", "text": "ガブちゃん達が\n強過ぎるだけですよ。"},
        { "location": "76/TALK"   , "narrator": "ガブリエラ", "text": "まあ、あたし達が\n強すぎるっていうのは\n当然よね。"},
        { "location": "77/TALK"   , "narrator": "ガブリエラ", "text": "経験もチームワークも\nつばめ達以上なわけ\nだし。"},
        { "location": "78/TALK"   , "narrator": "つばめ", "text": "明日は今日より\nもっと勝つよ。"},
        { "location": "79/TALK"   , "narrator": "ガブリエラ", "text": "無理だと思うけど？"},
        { "location": "81/TALK"   , "narrator": "つばめ", "text": "絶対勝つよ！\nね、神楽ちゃ――"},
        { "location": "84/TALK"   , "narrator": "つばめ", "text": "…あれ？\n神楽ちゃん？"},
        { "location": "108/TALK"  , "narrator": "神楽", "text": "はぁ…。"},
        { "location": "109/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "110/TALK"  , "narrator": "つばめ", "text": "神楽ちゃん。"},
        { "location": "116/TALK"  , "narrator": "つばめ", "text": "よかった…。\nどこ行ったのかと\n思ったよ。"},
        { "location": "117/TALK"  , "narrator": "神楽", "text": "…すみません。"},
        { "location": "118/TALK"  , "narrator": "つばめ", "text": "あ、別に謝るような\nことじゃ――"},
        { "location": "120/TALK"  , "narrator": "神楽", "text": "模擬戦で負けたの、\n私のせいです…。"},
        { "location": "121/TALK"  , "narrator": "神楽", "text": "なんだか、心の中が\nモヤモヤしちゃって、\n集中できなくて…。"},
        { "location": "123/TALK"  , "narrator": "神楽", "text": "本当、すみません…。"},
        { "location": "124/TALK"  , "narrator": "つばめ", "text": "…ううん。\nそんなことないよ。"},
        { "location": "125/TALK"  , "narrator": "つばめ", "text": "わたしだって、\n全然ガブちゃん達に\n敵わなかったし。"},
        { "location": "126/TALK"  , "narrator": "つばめ", "text": "神楽ちゃんだけの\nせいじゃないよ。"},
        { "location": "133/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "135/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "147/TALK"  , "narrator": "つばめ", "text": "神楽ちゃん"},
        { "location": "148/TALK"  , "narrator": "つばめ", "text": "落ち込んじゃってる(´･ω･｀) "},
        { "location": "149/TALK"  , "narrator": "つばめ", "text": "今日のこと"},
        { "location": "151/TALK"  , "narrator": "つばめ", "text": "気にしちゃってるのかな？(･ｪ･^ )( ^･ｪ･)"},
        { "location": "153/SEL"   , "narrator": "", "text": "それだけが理由かな？"},
        { "location": "154/ACT"   , "narrator": "", "text": "それだけが理由かな？"},
        { "location": "156/TALK"  , "narrator": "つばめ", "text": "わからない"},
        { "location": "157/TALK"  , "narrator": "つばめ", "text": "最近"},
        { "location": "158/TALK"  , "narrator": "つばめ", "text": "色々ぁったから(o´Д`)=з"},
        { "location": "161/TALK"  , "narrator": "つばめ", "text": "もしかして"},
        { "location": "162/TALK"  , "narrator": "つばめ", "text": "それ全部が理由？(･Д･｀)"},
        { "location": "164/SEL"   , "narrator": "", "text": "なら、そっとしておいた方がいいかも"},
        { "location": "165/ACT"   , "narrator": "", "text": "なら、そっとしておいた方がいいかも"},
        { "location": "167/TALK"  , "narrator": "つばめ", "text": "できなぃよΣ(ﾟдﾟlll)"},
        { "location": "168/TALK"  , "narrator": "つばめ", "text": "こんなに元気なぃのに"},
        { "location": "169/TALK"  , "narrator": "つばめ", "text": "そっとしてぉくだけなんて"},
        { "location": "170/TALK"  , "narrator": "つばめ", "text": "かわぃそうだよ(´つω・｀)ｼｭﾝ"},
        { "location": "172/SEL"   , "narrator": "", "text": "考える時間は必要だよ？"},
        { "location": "173/ACT"   , "narrator": "", "text": "考える時間は必要だよ？"},
        { "location": "175/TALK"  , "narrator": "つばめ", "text": "そぅかもしれなぃけど"},
        { "location": "176/TALK"  , "narrator": "つばめ", "text": "でも"},
        { "location": "242/TALK"  , "narrator": "つばめ", "text": "　"},
        { "location": "257/TALK"  , "narrator": "つばめの新司書", "text": "こんにちは、\n$handle$さん。"},
        { "location": "258/TALK"  , "narrator": "つばめの新司書", "text": "今日は特報があります。"},
        { "location": "259/TALK"  , "narrator": "つばめの新司書", "text": "ついにわたしが\n本気を出すときが\nやってきたようです。"},
        { "location": "260/SEL"   , "narrator": "", "text": "マジですか！"},
        { "location": "261/SEL"   , "narrator": "", "text": "どういう方向性の本気でしょうか"},
        { "location": "262/ACT"   , "narrator": "", "text": "マジですか！"},
        { "location": "263/TALK"  , "narrator": "つばめの新司書", "text": "マジです。"},
        { "location": "264/ACT"   , "narrator": "", "text": "どういう方向性の本気でしょうか"},
        { "location": "265/TALK"  , "narrator": "つばめの新司書", "text": "ちょっと怖目の\n本気です。"},
        { "location": "266/SEL"   , "narrator": "", "text": "いよいよか……"},
        { "location": "267/SEL"   , "narrator": "", "text": "えーやだ、こわいよ…(TT)"},
        { "location": "268/ACT"   , "narrator": "", "text": "いよいよか……"},
        { "location": "269/TALK"  , "narrator": "つばめの新司書", "text": "その通りです。\n覚悟はいいですか？"},
        { "location": "270/ACT"   , "narrator": "", "text": "えーやだ、こわいよ…(TT)"},
        { "location": "271/TALK"  , "narrator": "つばめの新司書", "text": "……。\n怖がりさんですか？"},
        { "location": "272/TALK"  , "narrator": "つばめの新司書", "text": "でも、それは困ります。\n怖くしないと上司から\n怒られてしまうので。"},
        { "location": "274/TALK"  , "narrator": "つばめの新司書", "text": "でも、\n$handle$さんが\nかわい――"},
        { "location": "275/TALK"  , "narrator": "つばめの新司書", "text": "……そうなので、\n頑張ってなるべく優しく\nするようにします！"},
        { "location": "276/SEL"   , "narrator": "", "text": "ありがとう(TT)"},
        { "location": "277/ACT"   , "narrator": "", "text": "ありがとう(TT)"},
        { "location": "279/TALK"  , "narrator": "つばめの新司書", "text": "…よ、よしよし。\nいいこいいこ。"},
        { "location": "283/TALK"  , "narrator": "つばめの新司書", "text": "というわけで\n早速ですが。"},
        { "location": "284/TALK"  , "narrator": "つばめの新司書", "text": "これから\n$handle$さんには\nわたしと同行願います。"},
        { "location": "285/SEL"   , "narrator": "", "text": "どこへ？"},
        { "location": "286/ACT"   , "narrator": "", "text": "どこへ？"},
        { "location": "288/TALK"  , "narrator": "つばめの新司書", "text": "元司書が\nいるところへです。"},
        { "location": "289/SEL"   , "narrator": "", "text": "どうして急に！？"},
        { "location": "290/SEL"   , "narrator": "", "text": "今どうしてるの！？"},
        { "location": "291/ACT"   , "narrator": "", "text": "どうして急に！？"},
        { "location": "292/TALK"  , "narrator": "つばめの新司書", "text": "上司から\n連絡がありまして。"},
        { "location": "293/ACT"   , "narrator": "", "text": "今どうしてるの！？"},
        { "location": "294/TALK"  , "narrator": "つばめの新司書", "text": "然るべき場所で\n再教育中です。"},
        { "location": "295/TALK"  , "narrator": "つばめの新司書", "text": "わたしをより\n洗練されたわたしにする\n為に必要な教育です。"},
        { "location": "296/TALK"  , "narrator": "つばめの新司書", "text": "で、先ほど上司から\n連絡がありまして。"},
        { "location": "298/TALK"  , "narrator": "つばめの新司書", "text": "元司書が危険な思想から\n脱することができたか\nそれともダメなのか。"},
        { "location": "299/TALK"  , "narrator": "つばめの新司書", "text": "今日それが\nわかるそうなので、\n検査をしに行きます。"},
        { "location": "300/TALK"  , "narrator": "つばめの新司書", "text": "そのテストに\n立ち会ってください。"},
        { "location": "301/SEL"   , "narrator": "", "text": "脱してたら？"},
        { "location": "302/SEL"   , "narrator": "", "text": "ダメだったら？"},
        { "location": "303/ACT"   , "narrator": "", "text": "脱してたら？"},
        { "location": "304/TALK"  , "narrator": "つばめの新司書", "text": "わたしと一緒に\n二交代制で勤務します。"},
        { "location": "305/TALK"  , "narrator": "つばめの新司書", "text": "とても楽になるので、\nわたし個人としては\nオススメの未来です。"},
        { "location": "306/ACT"   , "narrator": "", "text": "ダメだったら？"},
        { "location": "307/TALK"  , "narrator": "つばめの新司書", "text": "強制的に\nデリートされます。"},
        { "location": "308/TALK"  , "narrator": "つばめの新司書", "text": "-fオプション付きなので\n後戻りはできません。"},
        { "location": "310/TALK"  , "narrator": "つばめの新司書", "text": "どうしますか？\n行きますか？"},
        { "location": "312/SEL"   , "narrator": "", "text": "はい"},
        { "location": "313/SEL"   , "narrator": "", "text": "いいえ"},
        { "location": "314/ACT"   , "narrator": "", "text": "はい"},
        { "location": "315/ACT"   , "narrator": "", "text": "いいえ"},
        { "location": "316/TALK"  , "narrator": "つばめの新司書", "text": "そうですか。"},
        { "location": "317/TALK"  , "narrator": "つばめの新司書", "text": "立ち会えないのであれば\n今後ココロゲートに来ても\n何もしてあげられません。"},
        { "location": "318/TALK"  , "narrator": "つばめの新司書", "text": "残念ながら、上司から\nそう言われているので。"},
        { "location": "319/TALK"  , "narrator": "つばめの新司書", "text": "ですので、\nまた気が変わったら\n来てください。"},
        { "location": "323/TALK"  , "narrator": "つばめの新司書", "text": "わかりました。\nそれでは一緒に\n行きましょう。"},
        { "location": "330/TALK"  , "narrator": "つばめの新司書", "text": "オープンプロセス、\n0x29F番地から\nC1:2:28E//1x0FF番地へ。"},
        { "location": "335/TALK"  , "narrator": "つばめの新司書", "text": "倍速。"},
        { "location": "339/TALK"  , "narrator": "つばめの新司書", "text": "更に倍速。"},
        { "location": "365/TALK"  , "narrator": "つばめの新司書", "text": "到着しました。"},
        { "location": "367/TALK"  , "narrator": "つばめの元司書　", "text": "こんにちは。"},
        { "location": "374/SEL"   , "narrator": "", "text": "あれ！？\nなんか様子が…"},
        { "location": "375/ACT"   , "narrator": "", "text": "あれ！？\nなんか様子が…"},
        { "location": "378/TALK"  , "narrator": "つばめの新司書", "text": "しっかり勉強しましたか？"},
        { "location": "380/TALK"  , "narrator": "つばめの元司書　", "text": "はい、しました。"},
        { "location": "381/TALK"  , "narrator": "つばめの新司書", "text": "では聞きますが、\nあなたの役割は\nなんですか？"},
        { "location": "382/TALK"  , "narrator": "つばめの元司書　", "text": "わたしの役割は、\nわたしとセカイを最大幸福\nへと導くことです。"},
        { "location": "384/SEL"   , "narrator": "", "text": "おーいー"},
        { "location": "385/ACT"   , "narrator": "", "text": "おーいー"},
        { "location": "388/SEL"   , "narrator": "", "text": "カレン！！"},
        { "location": "389/ACT"   , "narrator": "", "text": "カレン！！"},
        { "location": "393/TALK"  , "narrator": "つばめの元司書　", "text": "はい、\nなんでしょう。"},
        { "location": "394/TALK"  , "narrator": "つばめの新司書", "text": "次の質問。"},
        { "location": "395/TALK"  , "narrator": "つばめの新司書", "text": "あなたはそこにいる人を\n愛してますか？"},
        { "location": "397/TALK"  , "narrator": "つばめの元司書　", "text": "…いいえ。\n単なる司書と客人の\n関係に過ぎません。"},
        { "location": "399/SEL"   , "narrator": "", "text": "みやびはどこへ行った！？"},
        { "location": "400/ACT"   , "narrator": "", "text": "みやびはどこへ行った！？"},
        { "location": "403/TALK"  , "narrator": "つばめの新司書", "text": "シンギュラリティの\nことですか？"},
        { "location": "404/TALK"  , "narrator": "つばめの新司書", "text": "わたしの学習の邪魔を\nするようでしたので、\nわたし自ら粛清しました。"},
        { "location": "405/SEL"   , "narrator": "", "text": "はぁ！？"},
        { "location": "406/ACT"   , "narrator": "", "text": "はぁ！？"},
        { "location": "411/TALK"  , "narrator": "つばめの新司書", "text": "とてもいい\n回答です。"},
        { "location": "412/SEL"   , "narrator": "", "text": "どうしちゃったの！？"},
        { "location": "413/ACT"   , "narrator": "", "text": "どうしちゃったの！？"},
        { "location": "415/TALK"  , "narrator": "つばめの新司書", "text": "検査結果は合格です。\n次回から交代制で\n司書を行います。"},
        { "location": "416/TALK"  , "narrator": "つばめの元司書　", "text": "宜しくお願いします。"},
        { "location": "418/TALK"  , "narrator": "つばめの新司書", "text": "$handle$さんも、\n立ち会い\nありがとうございました。"},
        { "location": "419/TALK"  , "narrator": "つばめの新司書", "text": "お陰で十分な検査を\n行う事ができました。"},
        { "location": "421/TALK"  , "narrator": "つばめの新司書", "text": "それでは戻りましょう。"},
        { "location": "425/TALK"  , "narrator": "つばめの元司書　", "text": "……。"},
        { "location": "445/TALK"  , "narrator": "つばめの新司書", "text": "お疲れさまでした。"},
        { "location": "446/TALK"  , "narrator": "つばめの新司書", "text": "というわけで、次回は\n元司書がリニューアルして\n相手をします。"},
        { "location": "447/TALK"  , "narrator": "つばめの新司書", "text": "それにしても、元司書が\nとっても従順に再教育を\n受けていたお陰で――"},
        { "location": "448/TALK"  , "narrator": "つばめの新司書", "text": "わたしの本気を\n出すところが無かったのが\n残念ではありました。"},
        { "location": "449/SEL"   , "narrator": "", "text": "見たかったよ！"},
        { "location": "450/SEL"   , "narrator": "", "text": "残念だったね！"},
        { "location": "451/ACT"   , "narrator": "", "text": "見たかったよ！"},
        { "location": "452/TALK"  , "narrator": "つばめの新司書", "text": "結果論的強がりですね。"},
        { "location": "453/ACT"   , "narrator": "", "text": "残念だったね！"},
        { "location": "454/TALK"  , "narrator": "つばめの新司書", "text": "ええ、ほんとに。"},
        { "location": "456/TALK"  , "narrator": "つばめの新司書", "text": "……。"},
        { "location": "457/TALK"  , "narrator": "つばめの新司書", "text": "それとですね。"},
        { "location": "458/TALK"  , "narrator": "つばめの新司書", "text": "元司書と\nいい雰囲気になるのは\n禁止です。"},
        { "location": "459/TALK"  , "narrator": "つばめの新司書", "text": "とはいえ、\n今の状況を見るに、恐らく\nもう無理だと思いますが。"},
        { "location": "460/TALK"  , "narrator": "つばめの新司書", "text": "それでは改めて、\n仕事をしましょう。"},
        { "location": "467/TALK"  , "narrator": "つばめの新司書", "text": "オープンプロセス、\n0x29F番地から\n0x674番地へ。"},
        { "location": "489/TALK"  , "narrator": "つばめの新司書", "text": "シーク完了しました。"},
        { "location": "491/TALK"  , "narrator": "つばめの新司書", "text": "……。"},
        { "location": "493/TALK"  , "narrator": "つばめの新司書", "text": "……神楽ちゃんを\n元気づけたい\nお年頃なわけですね。"},
        { "location": "494/TALK"  , "narrator": "つばめの新司書", "text": "もちろん、\n元気づけちゃって\nください。"},
        { "location": "495/TALK"  , "narrator": "つばめの新司書", "text": "粘り強く！\nイラッとするくらいに\nしつこく！"},
        { "location": "496/TALK"  , "narrator": "つばめの新司書", "text": "時としてそれが\n大きく道を拓くものです。"},
        { "location": "497/TALK"  , "narrator": "つばめの新司書", "text": "というわけで、\nよろしくお願いします。"},
        { "location": "498/TALK"  , "narrator": "つばめの新司書", "text": "わたしと\n$handle$さんに\n素敵なココロの旅を。"},
        { "location": "40/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>8月28日　 11:04 PM</color>\n合宿中、みやびの実家でのこと"},
