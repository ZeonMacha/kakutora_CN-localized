        "title": "らぶとーく 第47話",
        "sub_title": "口止めとは生意気な（つばめ）"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "口止めとは生意気な（つばめ）"},
        { "location": "22/TALK"   , "narrator": "つばめ", "text": "あ、はーい。\n開いてますよー。"},
        { "location": "25/TALK"   , "narrator": "みやび", "text": "お邪魔するぞね。"},
        { "location": "26/TALK"   , "narrator": "つばめ", "text": "みやびさん。\nどうかしたんですか？"},
        { "location": "27/TALK"   , "narrator": "みやび", "text": "ん…当直のことや。"},
        { "location": "28/TALK"   , "narrator": "みやび", "text": "今度の当直、まさか\nつばめちゃんが代わる\n言うとは思わなくて。"},
        { "location": "30/TALK"   , "narrator": "つばめ", "text": "ああ、そのことですか。"},
        { "location": "33/TALK"   , "narrator": "みやび", "text": "実は、その日はどうしても\n外せん用事があってな。"},
        { "location": "34/TALK"   , "narrator": "みやび", "text": "正直、どうしようか\n悩んでたちや。"},
        { "location": "37/TALK"   , "narrator": "みやび", "text": "やき、つばめちゃんが\n代わる言うてくれて、\nまっこと助かった。"},
        { "location": "39/TALK"   , "narrator": "みやび", "text": "ありがとな。"},
        { "location": "40/TALK"   , "narrator": "つばめ", "text": "そ、そんな！\nお礼なんて良いですから。"},
        { "location": "41/TALK"   , "narrator": "みやび", "text": "いや、礼くらい言わせて\nもらえんと、うちの気が\nすまん。"},
        { "location": "42/TALK"   , "narrator": "つばめ", "text": "…………。"},
        { "location": "44/TALK"   , "narrator": "つばめ", "text": "あの…それなら、\nもう一人お礼を言うべき\n人がいまして…。"},
        { "location": "45/TALK"   , "narrator": "みやび", "text": "…もう一人？"},
        { "location": "46/TALK"   , "narrator": "つばめ", "text": "…$handle$さんです。"},
        { "location": "47/TALK"   , "narrator": "みやび", "text": "は？"},
        { "location": "48/TALK"   , "narrator": "つばめ", "text": "これ、実は口止めされて\nたんですけど――"},
        { "location": "49/TALK"   , "narrator": "つばめ", "text": "当直を代わったのって、\n$handle$さんにお願い\nされたからなんです。"},
        { "location": "50/TALK"   , "narrator": "つばめ", "text": "その日は、みやびさんが\nどうしても外せない用事が\nあるんだ、って…。"},
        { "location": "51/TALK"   , "narrator": "みやび", "text": "…………。"},
        { "location": "54/TALK"   , "narrator": "みやび", "text": "初耳や。\nそんなこと言われたが？"},
        { "location": "55/TALK"   , "narrator": "つばめ", "text": "はい…。"},
        { "location": "57/TALK"   , "narrator": "みやび", "text": "そうか…。"},
        { "location": "58/TALK"   , "narrator": "みやび", "text": "なるほどな…。\n道理でタイミングが\n良過ぎるわけや。"},
        { "location": "61/TALK"   , "narrator": "つばめ", "text": "…あの、余計なこと\nしちゃいましたか？"},
        { "location": "63/TALK"   , "narrator": "みやび", "text": "いや、そんなことは\nないぞね。"},
        { "location": "64/TALK"   , "narrator": "みやび", "text": "それより、当直の方は\nまっこと変わってもらって\nえいが？"},
        { "location": "68/TALK"   , "narrator": "つばめ", "text": "はい！\n大丈夫です！"},
        { "location": "69/TALK"   , "narrator": "みやび", "text": "そうか…。\n改めて、ありがとうな。"},
        { "location": "82/TALK"   , "narrator": "みやび", "text": "…………。"},
        { "location": "87/TALK"   , "narrator": "みやび", "text": "おい"},
        { "location": "89/TALK"   , "narrator": "みやび", "text": "うちに内緒で勝手なことを"},
        { "location": "90/TALK"   , "narrator": "みやび", "text": "余計なことするな！"},
        { "location": "92/SEL"    , "narrator": "", "text": "もう決まったし"},
        { "location": "93/SEL"    , "narrator": "", "text": "サプライズ成功！"},
        { "location": "94/SEL"    , "narrator": "", "text": "遠慮しないで"},
        { "location": "95/ACT"    , "narrator": "", "text": "もう決まったし"},
        { "location": "96/TALK"   , "narrator": "みやび", "text": "勝手に決めよって"},
        { "location": "97/TALK"   , "narrator": "みやび", "text": "ハッキリ言っておく"},
        { "location": "98/TALK"   , "narrator": "みやび", "text": "こういうズルは好きやない"},
        { "location": "99/TALK"   , "narrator": "みやび", "text": "礼は言わんぞ！"},
        { "location": "100/ACT"   , "narrator": "", "text": "サプライズ成功！"},
        { "location": "101/TALK"  , "narrator": "みやび", "text": "そうやね"},
        { "location": "102/TALK"  , "narrator": "みやび", "text": "ハッピーの付かない方"},
        { "location": "103/TALK"  , "narrator": "みやび", "text": "ただのサプライズ"},
        { "location": "104/TALK"  , "narrator": "みやび", "text": "いや"},
        { "location": "105/TALK"  , "narrator": "みやび", "text": "限りなくバッドに近い"},
        { "location": "106/ACT"   , "narrator": "", "text": "遠慮しないで"},
        { "location": "107/TALK"  , "narrator": "みやび", "text": "おまえが言うな！"},
        { "location": "108/TALK"  , "narrator": "みやび", "text": "それはつばめちゃんのセリフや"},
        { "location": "109/TALK"  , "narrator": "みやび", "text": "呆れるほどの図々しさやね"},
        { "location": "112/SEL"   , "narrator": "", "text": "余計なことしてごめん…"},
        { "location": "113/ACT"   , "narrator": "", "text": "余計なことしてごめん…"},
        { "location": "116/TALK"  , "narrator": "みやび", "text": "まあ"},
        { "location": "117/TALK"  , "narrator": "みやび", "text": "当直がなくなって助かったのは事実や"},
        { "location": "118/TALK"  , "narrator": "みやび", "text": "実際困ってたのも事実"},
        { "location": "119/TALK"  , "narrator": "みやび", "text": "そういうことだ"},
        { "location": "120/TALK"  , "narrator": "みやび", "text": "まあ"},
        { "location": "122/TALK"  , "narrator": "みやび", "text": "休みに罪はない"},
        { "location": "123/TALK"  , "narrator": "みやび", "text": "遠慮なく使わせてもらうちや！"},
        { "location": "17/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>某月某日　 6:10 PM</color>\nとある平日、寮「とらいあんぐる」つばめの部屋にて"}
    ]
}
