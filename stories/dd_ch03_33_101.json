        "title": "002 メインストーリー",
        "sub_title": "背中越しの真実＜前編＞"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "幕間の"},
        { "location": "30/TALK"   , "narrator": "ガブリエラ", "text": "さあ来て…！"},
        { "location": "31/TALK"   , "narrator": "ガブリエラ", "text": "５、４、３、２、１。"},
        { "location": "39/TALK"   , "narrator": "ガブリエラ", "text": "アーケロンが爆発\nするのは敵にすれば\n想定外のはず。"},
        { "location": "40/TALK"   , "narrator": "ガブリエラ", "text": "そこへこのタイミングで\n脱出ポッドが射出されたら\n罠とは思い至らない。"},
        { "location": "42/TALK"   , "narrator": "ガブリエラ", "text": "――やっぱりね。"},
        { "location": "43/TALK"   , "narrator": "ガブリエラ", "text": "通常攻撃隊は\n全員脱出ポッドへ\n向かったわ。"},
        { "location": "44/TALK"   , "narrator": "ガブリエラ", "text": "……それにしても……。"},
        { "location": "45/TALK"   , "narrator": "ガブリエラ", "text": "つばめのあの白い服は\n何なの？"},
        { "location": "46/TALK"   , "narrator": "ガブリエラ", "text": "それに千羽鶴と\n神楽はなにをして\nいるの…？"},
        { "location": "47/TALK"   , "narrator": "透明アーヤ", "text": "ギャヴィ。\n館長から連絡があったわ。"},
        { "location": "48/TALK"   , "narrator": "ガブリエラ", "text": "まほから？"},
        { "location": "49/TALK"   , "narrator": "透明アーヤ", "text": "ええ。館長が陽動を\nしている間につばめを\n救出するようにと。"},
        { "location": "50/TALK"   , "narrator": "ガブリエラ", "text": "陽動開始時刻は？"},
        { "location": "51/TALK"   , "narrator": "透明アーヤ", "text": "まだ未定よ。\n決まり次第また\n連絡する。"},
        { "location": "52/TALK"   , "narrator": "ガブリエラ", "text": "了解。"},
        { "location": "53/TALK"   , "narrator": "ガブリエラ", "text": "準備できるまで\n待機ってことよね…。"},
        { "location": "60/TALK"   , "narrator": "ガブリエラ", "text": "ねえ$marzanna$"},
        { "location": "61/TALK"   , "narrator": "ガブリエラ", "text": "憶えてる？"},
        { "location": "63/SEL"    , "narrator": "", "text": "何を？"},
        { "location": "64/SEL"    , "narrator": "", "text": "おぼえてない"},
        { "location": "65/SEL"    , "narrator": "", "text": "忘れた"},
        { "location": "66/ACT"    , "narrator": "", "text": "何を？"},
        { "location": "67/TALK"   , "narrator": "ガブリエラ", "text": "以前ここに来た時のこと"},
        { "location": "68/ACT"    , "narrator": "", "text": "おぼえてない"},
        { "location": "69/TALK"   , "narrator": "ガブリエラ", "text": "全部忘れたってことかしら？"},
        { "location": "70/ACT"    , "narrator": "", "text": "忘れた"},
        { "location": "71/TALK"   , "narrator": "ガブリエラ", "text": "適当すぎるわよ？"},
        { "location": "74/TALK"   , "narrator": "ガブリエラ", "text": "フレイメノウのライブで"},
        { "location": "75/TALK"   , "narrator": "ガブリエラ", "text": "フェノメノンが発生した時のことよ"},
        { "location": "76/TALK"   , "narrator": "ガブリエラ", "text": "あの時$marzanna$が"},
        { "location": "77/TALK"   , "narrator": "ガブリエラ", "text": "いきなり話し掛けてきたわよね"},
        { "location": "79/SEL"    , "narrator": "", "text": "そうだったね"},
        { "location": "80/SEL"    , "narrator": "", "text": "思い出した"},
        { "location": "81/SEL"    , "narrator": "", "text": "憶えててくれたんだ"},
        { "location": "82/ACT"    , "narrator": "", "text": "そうだったね"},
        { "location": "84/TALK"   , "narrator": "ガブリエラ", "text": "思い出してくれた？"},
        { "location": "85/ACT"    , "narrator": "", "text": "思い出した"},
        { "location": "87/TALK"   , "narrator": "ガブリエラ", "text": "忘れてたの？"},
        { "location": "88/ACT"    , "narrator": "", "text": "憶えててくれたんだ"},
        { "location": "90/TALK"   , "narrator": "ガブリエラ", "text": "そんなの"},
        { "location": "91/TALK"   , "narrator": "ガブリエラ", "text": "当たり前でしょ"},
        { "location": "93/TALK"   , "narrator": "ガブリエラ", "text": "あの時"},
        { "location": "94/TALK"   , "narrator": "ガブリエラ", "text": "突然あたしの過去を当てられて"},
        { "location": "95/TALK"   , "narrator": "ガブリエラ", "text": "すごくびっくりした"},
        { "location": "96/TALK"   , "narrator": "ガブリエラ", "text": "それと同時に"},
        { "location": "97/TALK"   , "narrator": "ガブリエラ", "text": "ときめいたの"},
        { "location": "99/SEL"    , "narrator": "", "text": "それは光栄だ"},
        { "location": "100/SEL"   , "narrator": "", "text": "と、ときめいたの…？"},
        { "location": "101/SEL"   , "narrator": "", "text": "$me$はガブリエラにときめいた"},
        { "location": "102/ACT"   , "narrator": "", "text": "それは光栄だ"},
        { "location": "104/TALK"  , "narrator": "ガブリエラ", "text": "だってまるで"},
        { "location": "105/TALK"  , "narrator": "ガブリエラ", "text": "女神マルザンナが"},
        { "location": "106/TALK"  , "narrator": "ガブリエラ", "text": "降臨したみたいだったもの"},
        { "location": "107/ACT"   , "narrator": "", "text": "と、ときめいたの…？"},
        { "location": "109/TALK"  , "narrator": "ガブリエラ", "text": "そうよ"},
        { "location": "110/TALK"  , "narrator": "ガブリエラ", "text": "他に表現のしようがないわ"},
        { "location": "111/TALK"  , "narrator": "ガブリエラ", "text": "この気持ちは"},
        { "location": "112/ACT"   , "narrator": "", "text": "$me$はガブリエラにときめいた"},
        { "location": "114/TALK"  , "narrator": "ガブリエラ", "text": "じゃあ私たち"},
        { "location": "115/TALK"  , "narrator": "ガブリエラ", "text": "最初から"},
        { "location": "116/TALK"  , "narrator": "ガブリエラ", "text": "両想いだったのねｖｖｖｖｖｖｖｖ"},
        { "location": "118/TALK"  , "narrator": "ガブリエラ", "text": "アーヤとみやびは"},
        { "location": "119/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$のこと疑ってた時期が合ったけど"},
        { "location": "120/TALK"  , "narrator": "ガブリエラ", "text": "私はそんなこと"},
        { "location": "122/TALK"  , "narrator": "ガブリエラ", "text": "したくなかったの"},
        { "location": "123/TALK"  , "narrator": "ガブリエラ", "text": "だって私は$marzanna$のこと"},
        { "location": "124/TALK"  , "narrator": "ガブリエラ", "text": "信じてたもの"},
        { "location": "125/TALK"  , "narrator": "ガブリエラ", "text": "悪い奴じゃないって"},
        { "location": "126/TALK"  , "narrator": "ガブリエラ", "text": "絶対にいいやつだって"},
        { "location": "128/SEL"   , "narrator": "", "text": "それはどうかな"},
        { "location": "129/SEL"   , "narrator": "", "text": "いいやつじゃないかもよ"},
        { "location": "130/SEL"   , "narrator": "", "text": "いいやつ、か…"},
        { "location": "131/ACT"   , "narrator": "", "text": "それはどうかな"},
        { "location": "133/TALK"  , "narrator": "ガブリエラ", "text": "絶対そうよ"},
        { "location": "134/ACT"   , "narrator": "", "text": "いいやつじゃないかもよ"},
        { "location": "136/TALK"  , "narrator": "ガブリエラ", "text": "そんなことないわ"},
        { "location": "137/ACT"   , "narrator": "", "text": "いいやつ、か…"},
        { "location": "139/TALK"  , "narrator": "ガブリエラ", "text": "いいやつでしょう？"},
        { "location": "142/TALK"  , "narrator": "ガブリエラ", "text": "私"},
        { "location": "143/TALK"  , "narrator": "ガブリエラ", "text": "ヒカル君が好きだった時"},
        { "location": "144/TALK"  , "narrator": "ガブリエラ", "text": "あなたにずいぶんと"},
        { "location": "145/TALK"  , "narrator": "ガブリエラ", "text": "ひどいことをしたわ"},
        { "location": "146/TALK"  , "narrator": "ガブリエラ", "text": "もう絶交されても"},
        { "location": "147/TALK"  , "narrator": "ガブリエラ", "text": "仕方ないくらい"},
        { "location": "148/TALK"  , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "149/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$はずっと"},
        { "location": "150/TALK"  , "narrator": "ガブリエラ", "text": "私の側にいてくれた"},
        { "location": "151/TALK"  , "narrator": "ガブリエラ", "text": "こんなひどい"},
        { "location": "152/TALK"  , "narrator": "ガブリエラ", "text": "私なのに"},
        { "location": "154/SEL"   , "narrator": "", "text": "ガブリエラが好きだったからね"},
        { "location": "155/SEL"   , "narrator": "", "text": "もう過ぎた話だよ"},
        { "location": "156/SEL"   , "narrator": "", "text": "気にするな"},
        { "location": "157/ACT"   , "narrator": "", "text": "ガブリエラが好きだったからね"},
        { "location": "159/TALK"  , "narrator": "ガブリエラ", "text": "ごめんなさい"},
        { "location": "160/ACT"   , "narrator": "", "text": "もう過ぎた話だよ"},
        { "location": "162/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$は優しいわね"},
        { "location": "163/TALK"  , "narrator": "ガブリエラ", "text": "本当に"},
        { "location": "164/ACT"   , "narrator": "", "text": "気にするな"},
        { "location": "166/TALK"  , "narrator": "ガブリエラ", "text": "そういうわけにもいかないわ"},
        { "location": "168/TALK"  , "narrator": "ガブリエラ", "text": "今の私は"},
        { "location": "169/TALK"  , "narrator": "ガブリエラ", "text": "もうわかってる"},
        { "location": "170/TALK"  , "narrator": "ガブリエラ", "text": "一番大事な人が誰なのか"},
        { "location": "172/SEL"   , "narrator": "", "text": "それは誰？"},
        { "location": "173/SEL"   , "narrator": "", "text": "ドキドキ"},
        { "location": "174/SEL"   , "narrator": "", "text": "$me$だよね！"},
        { "location": "175/ACT"   , "narrator": "", "text": "それは誰？"},
        { "location": "177/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$に決まってるわ"},
        { "location": "178/ACT"   , "narrator": "", "text": "ドキドキ"},
        { "location": "180/TALK"  , "narrator": "ガブリエラ", "text": "それはね・・・"},
        { "location": "181/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$よ"},
        { "location": "182/TALK"  , "narrator": "ガブリエラ", "text": "当たり前でしょう？"},
        { "location": "183/ACT"   , "narrator": "", "text": "$me$だよね！"},
        { "location": "185/TALK"  , "narrator": "ガブリエラ", "text": "なんでそうなのかしら？"},
        { "location": "186/TALK"  , "narrator": "ガブリエラ", "text": "もう！"},
        { "location": "187/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$だけど・・・"},
        { "location": "190/TALK"  , "narrator": "ガブリエラ", "text": "それにもし"},
        { "location": "191/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$が本当は"},
        { "location": "192/TALK"  , "narrator": "ガブリエラ", "text": "悪いやつだったとしても"},
        { "location": "193/TALK"  , "narrator": "ガブリエラ", "text": "私はもうそれでいいの"},
        { "location": "195/TALK"  , "narrator": "ガブリエラ", "text": "だって"},
        { "location": "196/TALK"  , "narrator": "ガブリエラ", "text": "私に生きる力を与えてくれたのは"},
        { "location": "197/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$なんだから"},
        { "location": "201/TALK"  , "narrator": "ガブリエラ", "text": "ふふ……。"},
        { "location": "249/TALK"  , "narrator": "ガブリエラ", "text": "　"},
        { "location": "287/TALK"  , "narrator": "リヴォルカ　", "text": "あら、誰かと思えば\n豚じゃない。"},
        { "location": "288/TALK"  , "narrator": "マルザンナ", "text": "もう来ないでって\n言ったでしょ？"},
        { "location": "289/SEL"   , "narrator": "", "text": "わかりました"},
        { "location": "290/SEL"   , "narrator": "", "text": "すみませんでした"},
        { "location": "291/ACT"   , "narrator": "", "text": "わかりました"},
        { "location": "299/ACT"   , "narrator": "", "text": "すみませんでした"},
        { "location": "300/TALK"  , "narrator": "マルザンナ", "text": "はぁ……"},
        { "location": "301/TALK"  , "narrator": "マルザンナ", "text": "今更謝られても\nどうすればいいのよ。"},
        { "location": "302/TALK"  , "narrator": "マルザンナ", "text": "あの時、すごい\nショックだったんだから。"},
        { "location": "303/SEL"   , "narrator": "", "text": "ほんとにごめんね？"},
        { "location": "304/ACT"   , "narrator": "", "text": "ほんとにごめんね？"},
        { "location": "307/TALK"  , "narrator": "マルザンナ", "text": "…もういいわ。"},
        { "location": "308/TALK"  , "narrator": "マルザンナ", "text": "でも、もう二度と\nあんなことは\n言って欲しくない。"},
        { "location": "309/TALK"  , "narrator": "マルザンナ", "text": "やっぱり、\n冗談でもそういうの\n言われると辛いわよ。"},
        { "location": "310/TALK"  , "narrator": "マルザンナ", "text": "でも。"},
        { "location": "311/TALK"  , "narrator": "マルザンナ", "text": "……。"},
        { "location": "312/TALK"  , "narrator": "マルザンナ", "text": "これでおしまい。"},
        { "location": "313/TALK"  , "narrator": "マルザンナ", "text": "仲直りしましょ？"},
        { "location": "314/TALK"  , "narrator": "マルザンナ", "text": "あたしにはやっぱり\n$handle$が\n必要だもの。"},
        { "location": "315/TALK"  , "narrator": "マルザンナ", "text": "それじゃ、\n改めまして――"},
        { "location": "331/TALK"  , "narrator": "昇華マルザンナ", "text": "ああっ……"},
        { "location": "332/TALK"  , "narrator": "昇華マルザンナ", "text": "はあぁぁっ……"},
        { "location": "354/TALK"  , "narrator": "マルザンナ", "text": "……っ！"},
        { "location": "355/TALK"  , "narrator": "マルザンナ", "text": "はぁ……はぁ……"},
        { "location": "356/TALK"  , "narrator": "リヴォルカ　", "text": "あんた、ちょっと\n大丈夫…？"},
        { "location": "357/TALK"  , "narrator": "マルザンナ", "text": "はぁ……はぁ……\nなんとか、大丈夫…"},
        { "location": "360/TALK"  , "narrator": "マルザンナ", "text": "心配かけたわね……"},
        { "location": "362/TALK"  , "narrator": "リヴォルカ　", "text": "え？\nあ、あたしは別に\n心配なんてしてないし！"},
        { "location": "363/SEL"   , "narrator": "", "text": "マルザンナ元に戻ってよかった"},
        { "location": "364/SEL"   , "narrator": "", "text": "リヴォルカツンデレかわいい"},
        { "location": "365/ACT"   , "narrator": "", "text": "マルザンナ元に戻ってよかった"},
        { "location": "367/TALK"  , "narrator": "マルザンナ", "text": "ありがとう。"},
        { "location": "368/TALK"  , "narrator": "マルザンナ", "text": "$handle$が\n千羽鶴のバインドを\n断ち切ってくれたからよ？"},
        { "location": "369/TALK"  , "narrator": "マルザンナ", "text": "本当に貴方は\nあたしの命の恩人ね。"},
        { "location": "370/ACT"   , "narrator": "", "text": "リヴォルカツンデレかわいい"},
        { "location": "372/TALK"  , "narrator": "リヴォルカ　", "text": "おい豚……\nこんな時にすら\n第一声がそれ…？"},
        { "location": "373/TALK"  , "narrator": "リヴォルカ　", "text": "まあ、所詮は豚だし\nしょうがないか。"},
        { "location": "374/TALK"  , "narrator": "リヴォルカ　", "text": "場の雰囲気だって\nわからないでしょうし。"},
        { "location": "376/SEL"   , "narrator": "", "text": "千羽鶴は？"},
        { "location": "377/ACT"   , "narrator": "", "text": "千羽鶴は？"},
        { "location": "380/TALK"  , "narrator": "リヴォルカ　", "text": "さあね。"},
        { "location": "382/TALK"  , "narrator": "マルザンナ", "text": "セルフクランの発症は\n辛うじて阻止できた\nみたいね。"},
        { "location": "384/TALK"  , "narrator": "リヴォルカ　", "text": "そのようね、\n残念ながら。"},
        { "location": "387/TALK"  , "narrator": "リヴォルカ　", "text": "そういえばあんたって、\nセルフクランの発症\n反対派よね？"},
        { "location": "388/SEL"   , "narrator": "", "text": "もちろん反対派"},
        { "location": "389/SEL"   , "narrator": "", "text": "いえ、賛成派ですが"},
        { "location": "390/ACT"   , "narrator": "", "text": "もちろん反対派"},
        { "location": "393/ACT"   , "narrator": "", "text": "いえ、賛成派ですが"},
        { "location": "396/TALK"  , "narrator": "リヴォルカ　", "text": "あら、そうだった？\nまあ、豚の言う事なんて\nいちいち覚えてないし。"},
        { "location": "401/TALK"  , "narrator": "リヴォルカ　", "text": "そういえばあんたって、\nセルフクランの発症\n賛成派だったわよね？"},
        { "location": "402/SEL"   , "narrator": "", "text": "もちろんです"},
        { "location": "403/SEL"   , "narrator": "", "text": "え？　反対派だけど"},
        { "location": "404/ACT"   , "narrator": "", "text": "もちろん反対派"},
        { "location": "407/ACT"   , "narrator": "", "text": "いえ、賛成派ですが"},
        { "location": "410/TALK"  , "narrator": "リヴォルカ　", "text": "あら、そうだった？\nまあ、豚の言う事なんて\nいちいち覚えてないし。"},
        { "location": "416/TALK"  , "narrator": "リヴォルカ　", "text": "まあ正直、あんたが\n反対しようと、痛くも\nかゆくもないし――"},
        { "location": "417/TALK"  , "narrator": "リヴォルカ　", "text": "賛同してもらえなくて\n残念だとか、そういう感情\n一切ないけど。"},
        { "location": "418/TALK"  , "narrator": "リヴォルカ　", "text": "でも１つだけ\nむかつくことがあるのよ。"},
        { "location": "419/SEL"   , "narrator": "", "text": "なに？"},
        { "location": "420/SEL"   , "narrator": "", "text": "ぶひ？"},
        { "location": "421/ACT"   , "narrator": "", "text": "なに？"},
        { "location": "422/ACT"   , "narrator": "", "text": "ぶひ？"},
        { "location": "424/TALK"  , "narrator": "リヴォルカ　", "text": "真面目に話してるときに\nブヒブヒ言うな豚！"},
        { "location": "425/TALK"  , "narrator": "リヴォルカ　", "text": "…なんて、\n家畜に言葉で言っても\n理解できないわよね。"},
        { "location": "426/TALK"  , "narrator": "リヴォルカ　", "text": "身体に覚えさせてやるわ。"},
        { "location": "432/TALK"  , "narrator": "マルザンナ", "text": "ちょっと！！"},
        { "location": "433/TALK"  , "narrator": "マルザンナ", "text": "あたしの\n$handle$に\n痛いことしないで！"},
        { "location": "435/TALK"  , "narrator": "リヴォルカ　", "text": "きもっ……。\nあたしの$handle$\nですって？"},
        { "location": "436/TALK"  , "narrator": "リヴォルカ　", "text": "さすが、あたし全体の\nアベレージを下げまくる\n人格だけのことはあるわ。"},
        { "location": "437/TALK"  , "narrator": "リヴォルカ　", "text": "まあでも、\n今はそんなことは\nどうでもいいのよ。"},
        { "location": "439/TALK"  , "narrator": "リヴォルカ　", "text": "本題は、\nなんでこの豚が\nむかつくのか、だし。"},
        { "location": "441/TALK"  , "narrator": "リヴォルカ　", "text": "あんた、本当に\n真剣にあたしのこと\n考えてるわけ？"},
        { "location": "442/TALK"  , "narrator": "リヴォルカ　", "text": "発症させたくない\n理由なんて、どうせ――"},
        { "location": "443/TALK"  , "narrator": "リヴォルカ　", "text": "『$me$のガブリエラたんと\nイチャイチャできなく\nなっちゃうブヒィ！』"},
        { "location": "444/TALK"  , "narrator": "リヴォルカ　", "text": "…って理由なんじゃ\nなくて？"},
        { "location": "445/SEL"   , "narrator": "", "text": "見くびるなよ"},
        { "location": "446/SEL"   , "narrator": "", "text": "豚語が正しすぎて$me$への愛が見え隠れしてるよ"},
        { "location": "447/ACT"   , "narrator": "", "text": "見くびるなよ"},
        { "location": "448/TALK"  , "narrator": "リヴォルカ　", "text": "それはこっちのセリフよ。"},
        { "location": "449/TALK"  , "narrator": "リヴォルカ　", "text": "…まあいいわ。\n豚の耳に念仏って言うし。"},
        { "location": "450/SEL"   , "narrator": "", "text": "馬です…"},
        { "location": "451/SEL"   , "narrator": "", "text": "真珠です…"},
        { "location": "452/ACT"   , "narrator": "", "text": "馬です…"},
        { "location": "453/TALK"  , "narrator": "リヴォルカ　", "text": "え！？"},
        { "location": "454/TALK"  , "narrator": "リヴォルカ　", "text": "う、うるさいわね！！\nあんたのために\nカスタマイズしたのよ！"},
        { "location": "455/ACT"   , "narrator": "", "text": "真珠です…"},
        { "location": "456/TALK"  , "narrator": "リヴォルカ　", "text": "え！？\n豚の耳に真珠？？\nそうだったかしら？"},
        { "location": "457/TALK"  , "narrator": "リヴォルカ　", "text": "あんたが\n間違ってるんじゃないの？"},
        { "location": "458/SEL"   , "narrator": "", "text": "豚に真珠ですよ…"},
        { "location": "459/ACT"   , "narrator": "", "text": "豚に真珠ですよ…"},
        { "location": "461/TALK"  , "narrator": "リヴォルカ　", "text": "……。"},
        { "location": "462/TALK"  , "narrator": "リヴォルカ　", "text": "う、うるさいわね、\n知ってるわよ。"},
        { "location": "463/TALK"  , "narrator": "リヴォルカ　", "text": "あんたには人間の\n諺なんてもったいないから\n崩してやったのよ！"},
        { "location": "465/ACT"   , "narrator": "", "text": "豚語が正しすぎて$me$への愛が見え隠れしてるよ"},
        { "location": "467/TALK"  , "narrator": "リヴォルカ　", "text": "はぁぁぁぁ！？"},
        { "location": "470/TALK"  , "narrator": "リヴォルカ　", "text": "バカなんじゃないの！？"},
        { "location": "474/TALK"  , "narrator": "リヴォルカ　", "text": "<size=40>自惚れ屋！</size>"},
        { "location": "478/TALK"  , "narrator": "リヴォルカ　", "text": "<size=50>クズ！</size>"},
        { "location": "479/TALK"  , "narrator": "リヴォルカ　", "text": "はぁ、はぁ……"},
        { "location": "481/TALK"  , "narrator": "マルザンナ", "text": "…なんか\n顔赤くない？"},
        { "location": "483/TALK"  , "narrator": "リヴォルカ　", "text": "怒りに\n満ちあふれてるのよ！！"},
        { "location": "486/TALK"  , "narrator": "リヴォルカ　", "text": "もういい。\n話すだけ無駄だと\n確信したから。"},
        { "location": "488/TALK"  , "narrator": "リヴォルカ　", "text": "とにかく。"},
        { "location": "489/TALK"  , "narrator": "リヴォルカ　", "text": "あんたがちゃんと考えて\n発症を阻止してるなんて、\n全然思ってないから。"},
        { "location": "490/TALK"  , "narrator": "リヴォルカ　", "text": "もしそれが本当なら\nあたしを説得して\nみせなさいよ。"},
        { "location": "491/SEL"   , "narrator": "", "text": "今のガブリエラの想いも対等に真の想いだと思うから"},
        { "location": "492/SEL"   , "narrator": "", "text": "愛するガブリエラを失いたくないから"},
        { "location": "493/ACT"   , "narrator": "", "text": "今のガブリエラの想いも対等に真の想いだと思うから"},
        { "location": "495/TALK"  , "narrator": "マルザンナ", "text": "そうよ！\nあたしが今ここにいるのは\n事実なんだもの。"},
        { "location": "497/TALK"  , "narrator": "リヴォルカ　", "text": "まあ、それは\n否定しないわ。"},
        { "location": "498/TALK"  , "narrator": "リヴォルカ　", "text": "けど、それを言うなら\n今封印されてる本当の\n想いも真の想いだから。"},
        { "location": "499/TALK"  , "narrator": "リヴォルカ　", "text": "それじゃ説得は\n無理だわね。"},
        { "location": "500/ACT"   , "narrator": "", "text": "愛するガブリエラを失いたくないから"},
        { "location": "502/TALK"  , "narrator": "リヴォルカ　", "text": "その回答には２つの\nダウトがあるわね。"},
        { "location": "503/TALK"  , "narrator": "リヴォルカ　", "text": "まず、発症によって\nガブリエラ自身が\n失われることはない。"},
        { "location": "504/TALK"  , "narrator": "リヴォルカ　", "text": "特に、あんたから見れば\n何も変わらないと思う。"},
        { "location": "505/TALK"  , "narrator": "リヴォルカ　", "text": "そして次に、\nその発言は、あんたの\n自己中心的発言ね。"},
        { "location": "506/TALK"  , "narrator": "リヴォルカ　", "text": "あたしの本体は\n発症することを\n悲願としている。"},
        { "location": "507/TALK"  , "narrator": "リヴォルカ　", "text": "それを阻止して、\nあんたの愛するあたしが\n失われないようにする――"},
        { "location": "508/TALK"  , "narrator": "リヴォルカ　", "text": "それって、\n束縛って言わない？"},
        { "location": "509/TALK"  , "narrator": "リヴォルカ　", "text": "あたしがあんたに\n首輪をつけて飼うのとは\n話が違うのよ。"},
        { "location": "510/TALK"  , "narrator": "リヴォルカ　", "text": "そんな、自らの意志も\n尊重されない愛って、\nどうなのかしらね。"},
        { "location": "511/SEL"   , "narrator": "", "text": "それは本当にガブリエラ本人の意志なの？"},
        { "location": "512/ACT"   , "narrator": "", "text": "それは本当にガブリエラ本人の意志なの？"},
        { "location": "514/TALK"  , "narrator": "リヴォルカ　", "text": "あら、豚ちゃん逃避？"},
        { "location": "515/TALK"  , "narrator": "リヴォルカ　", "text": "正解は、\n「本人の意志」だけど？"},
        { "location": "516/TALK"  , "narrator": "リヴォルカ　", "text": "そんな言葉じゃ、\n説得は無理だわね。"},
        { "location": "520/TALK"  , "narrator": "マルザンナ", "text": "$handle$は\nどうして発症を\n希望してるの？"},
        { "location": "521/TALK"  , "narrator": "マルザンナ", "text": "正直、ちょっと\nショックなんだけど。"},
        { "location": "522/SEL"   , "narrator": "", "text": "真のガブリエラを幸せにしたいから"},
        { "location": "523/SEL"   , "narrator": "", "text": "マルザンナのこと、本当は嫌いだし"},
        { "location": "524/SEL"   , "narrator": "", "text": "実はそんなに深い意味は無くて…"},
        { "location": "525/ACT"   , "narrator": "", "text": "真のガブリエラを幸せにしたいから"},
        { "location": "526/TALK"  , "narrator": "マルザンナ", "text": "それって、\n確かに理にかなった\n意見だとは思うけど――"},
        { "location": "527/TALK"  , "narrator": "マルザンナ", "text": "あたしは\nどうなるの？"},
        { "location": "528/TALK"  , "narrator": "マルザンナ", "text": "ここにこうして\n生きてるあたし。"},
        { "location": "529/TALK"  , "narrator": "マルザンナ", "text": "今、この瞬間\n一生懸命現実を\n生きてるあたしは？"},
        { "location": "530/SEL"   , "narrator": "", "text": "きっと一緒に幸せになるよ"},
        { "location": "531/SEL"   , "narrator": "", "text": "本体の方が命が重いと思うから"},
        { "location": "532/ACT"   , "narrator": "", "text": "きっと一緒に幸せになるよ"},
        { "location": "533/TALK"  , "narrator": "マルザンナ", "text": "無責任なこと\n言わないでよ……。"},
        { "location": "534/TALK"  , "narrator": "マルザンナ", "text": "自分に例えてみれば\nわかるわよ。"},
        { "location": "535/TALK"  , "narrator": "マルザンナ", "text": "誰かの代わりに\n死んでもらうって\n言われて――"},
        { "location": "536/TALK"  , "narrator": "マルザンナ", "text": "自分に人権はないのかと\n聞いたら、来世では\n幸せになれるよって――"},
        { "location": "537/TALK"  , "narrator": "マルザンナ", "text": "そう言われてるのと\nだいたい同じなのよ？"},
        { "location": "538/ACT"   , "narrator": "", "text": "本体の方が命が重いと思うから"},
        { "location": "540/TALK"  , "narrator": "リヴォルカ　", "text": "あら。\n豚のくせに生意気なくらい\n素晴らしい回答ね。"},
        { "location": "541/TALK"  , "narrator": "リヴォルカ　", "text": "その通りよ。\n今のあたしが生きてるのは\n夢の中と同じ。"},
        { "location": "542/TALK"  , "narrator": "リヴォルカ　", "text": "夢から覚めれば、全ては\n無かったことになる。"},
        { "location": "543/TALK"  , "narrator": "リヴォルカ　", "text": "重さは雲泥の差よね。"},
        { "location": "545/TALK"  , "narrator": "マルザンナ", "text": "違うから！"},
        { "location": "546/TALK"  , "narrator": "マルザンナ", "text": "今のあたしが体験した\n思い出や絆は絶対に\n消えるものじゃないし。"},
        { "location": "548/TALK"  , "narrator": "リヴォルカ　", "text": "アーヤたちも一緒に\n消えるから安心して。\n何一つ残らないから。"},
        { "location": "549/TALK"  , "narrator": "リヴォルカ　", "text": "$handle$が\nいるわよ。\n絶対に消せない。"},
        { "location": "550/TALK"  , "narrator": "リヴォルカ　", "text": "……。"},
        { "location": "551/TALK"  , "narrator": "リヴォルカ　", "text": "豚は除外。"},
        { "location": "552/TALK"  , "narrator": "マルザンナ", "text": "そうやってごまかすの、\nもうやめにしたら？"},
        { "location": "553/TALK"  , "narrator": "リヴォルカ　", "text": "………。"},
        { "location": "554/TALK"  , "narrator": "リヴォルカ　", "text": "とにかく、あんたが\n何を言おうと、豚は\nあたしの家畜になった。"},
        { "location": "555/TALK"  , "narrator": "リヴォルカ　", "text": "あんたとは\n袂を分かったのよ。"},
        { "location": "557/ACT"   , "narrator": "", "text": "マルザンナのこと、本当は嫌いだし"},
        { "location": "559/TALK"  , "narrator": "マルザンナ", "text": "え！？\nそう……だったの…？"},
        { "location": "560/TALK"  , "narrator": "マルザンナ", "text": "ご、ごめん。\n全然気づかなくて。"},
        { "location": "561/TALK"  , "narrator": "マルザンナ", "text": "あ……"},
        { "location": "562/TALK"  , "narrator": "マルザンナ", "text": "えっと"},
        { "location": "563/TALK"  , "narrator": "マルザンナ", "text": "それなら、もう\n無理して来なくても\nいいのよ？"},
        { "location": "564/TALK"  , "narrator": "マルザンナ", "text": "あたしに\n気を使わなくても……"},
        { "location": "566/ACT"   , "narrator": "", "text": "実はそんなに深い意味は無くて…"},
        { "location": "568/TALK"  , "narrator": "マルザンナ", "text": "えっ……\nそんな…。"},
        { "location": "569/TALK"  , "narrator": "マルザンナ", "text": "あたしにとっての一大事\nなのに、そんな気持ちで\n返事したの？"},
        { "location": "570/SEL"   , "narrator": "", "text": "すみません…"},
        { "location": "571/SEL"   , "narrator": "", "text": "まあガブリエラはフラグ立てる為に進めてるだけだし"},
        { "location": "572/ACT"   , "narrator": "", "text": "すみません…"},
        { "location": "573/TALK"  , "narrator": "マルザンナ", "text": "……ううん、\nごめんなさい。"},
        { "location": "574/TALK"  , "narrator": "マルザンナ", "text": "あたしの伝え方が\n悪かったんだと思うの。"},
        { "location": "575/TALK"  , "narrator": "マルザンナ", "text": "もっとちゃんと、\n真面目に想いを込めて\n相談すれば良かったのよ。"},
        { "location": "576/TALK"  , "narrator": "マルザンナ", "text": "そうすれば、\n$handle$も\n勘違いしなかったと思う。"},
        { "location": "577/TALK"  , "narrator": "マルザンナ", "text": "だから、\n今までのことは\nもういいの。"},
        { "location": "578/TALK"  , "narrator": "マルザンナ", "text": "今からでも全然いいから、\nあたしのことを、もう少し\n真面目に考えてみて？"},
        { "location": "579/ACT"   , "narrator": "", "text": "まあガブリエラはフラグ立てる為に進めてるだけだし"},
        { "location": "581/TALK"  , "narrator": "マルザンナ", "text": "え"},
        { "location": "583/TALK"  , "narrator": "リヴォルカ　", "text": "あーあ、言っちゃった。"},
        { "location": "584/TALK"  , "narrator": "マルザンナ", "text": "……。"},
        { "location": "585/TALK"  , "narrator": "マルザンナ", "text": "もう来なくていいわよ。"},
        { "location": "587/SEL"   , "narrator": "", "text": "そうするわ"},
        { "location": "588/SEL"   , "narrator": "", "text": "いや、どんな結末になるかだけは見たいんで"},
        { "location": "590/ACT"   , "narrator": "", "text": "そうするわ"},
        { "location": "608/TALK"  , "narrator": "マルザンナ", "text": "…！？"},
        { "location": "609/TALK"  , "narrator": "マルザンナ", "text": "……ええ。\nそうして頂戴。"},
        { "location": "610/ACT"   , "narrator": "", "text": "いや、どんな結末になるかだけは見たいんで"},
        { "location": "628/TALK"  , "narrator": "マルザンナ", "text": "見せるわけ\nないじゃない。"},
        { "location": "629/TALK"  , "narrator": "マルザンナ", "text": "二度と\nここには来ないで。"},
        { "location": "644/TALK"  , "narrator": "リヴォルカ　", "text": "さて。\nこれからどうする？"},
        { "location": "646/TALK"  , "narrator": "マルザンナ", "text": "何がよ。"},
        { "location": "647/TALK"  , "narrator": "リヴォルカ　", "text": "このまま話し合いしてても\n永遠に決着なんて\nつかないでしょ？"},
        { "location": "648/TALK"  , "narrator": "マルザンナ", "text": "……そうね。"},
        { "location": "649/TALK"  , "narrator": "リヴォルカ　", "text": "ねえ。\n手っ取り早く、\n勝負しちゃわない？"},
        { "location": "650/TALK"  , "narrator": "リヴォルカ　", "text": "やるか\nやられるか。"},
        { "location": "651/TALK"  , "narrator": "マルザンナ", "text": "…！？"},
        { "location": "652/SEL"   , "narrator": "", "text": "いや、ちょっとまって、もっと穏便に…"},
        { "location": "653/SEL"   , "narrator": "", "text": "いいぞやれやれ！"},
        { "location": "654/ACT"   , "narrator": "", "text": "いや、ちょっとまって、もっと穏便に…"},
        { "location": "656/TALK"  , "narrator": "リヴォルカ　", "text": "焼き豚にされる前に\n黙った方が身の為よ？"},
        { "location": "657/TALK"  , "narrator": "マルザンナ", "text": "……。"},
        { "location": "658/TALK"  , "narrator": "マルザンナ", "text": "わかったわ。"},
        { "location": "659/SEL"   , "narrator": "", "text": "ちょっとマルザンナ、やめて！"},
        { "location": "660/ACT"   , "narrator": "", "text": "ちょっとマルザンナ、やめて！"},
        { "location": "663/TALK"  , "narrator": "マルザンナ", "text": "大丈夫よ。\nあたしは負けないから。"},
        { "location": "665/TALK"  , "narrator": "リヴォルカ　", "text": "よし、決まりね。"},
        { "location": "666/TALK"  , "narrator": "リヴォルカ　", "text": "それじゃ公明正大に\nやるために、マークスマン\nの面前対決にしましょ。"},
        { "location": "668/TALK"  , "narrator": "リヴォルカ　", "text": "あたしが勝ったら\n焼き豚にしてあげるから\n楽しみにしてなさい。"},
        { "location": "675/TALK"  , "narrator": "マルザンナ", "text": "……はぁ。"},
        { "location": "676/SEL"   , "narrator": "", "text": "マルザンナ、大丈夫"},
        { "location": "677/ACT"   , "narrator": "", "text": "マルザンナ、大丈夫"},
        { "location": "679/TALK"  , "narrator": "マルザンナ", "text": "ええ、大丈夫よ。"},
        { "location": "680/TALK"  , "narrator": "マルザンナ", "text": "まあ、こうなることは\n覚悟していたから。"},
        { "location": "681/TALK"  , "narrator": "マルザンナ", "text": "あたしのことは、\nあたしが一番わかってる。"},
        { "location": "682/TALK"  , "narrator": "マルザンナ", "text": "白黒ハッキリつけたい\n性格だもの。"},
        { "location": "683/TALK"  , "narrator": "マルザンナ", "text": "……。"},
        { "location": "684/TALK"  , "narrator": "マルザンナ", "text": "けど。"},
        { "location": "685/TALK"  , "narrator": "マルザンナ", "text": "本当はすごく怖いの。"},
        { "location": "686/SEL"   , "narrator": "", "text": "そりゃそうだ"},
        { "location": "687/SEL"   , "narrator": "", "text": "マルザンナなら勝てるよ"},
        { "location": "688/ACT"   , "narrator": "", "text": "そりゃそうだ"},
        { "location": "689/ACT"   , "narrator": "", "text": "マルザンナなら勝てるよ"},
        { "location": "690/TALK"  , "narrator": "マルザンナ", "text": "どうかしら。"},
        { "location": "691/TALK"  , "narrator": "マルザンナ", "text": "リヴォルカは、\n戦闘に特化した\n最高の自信家よ。"},
        { "location": "692/TALK"  , "narrator": "マルザンナ", "text": "正直、\n勝てる気はしないわ。"},
        { "location": "694/TALK"  , "narrator": "マルザンナ", "text": "……。"},
        { "location": "696/TALK"  , "narrator": "マルザンナ", "text": "……ねえ、\n$handle$。"},
        { "location": "697/TALK"  , "narrator": "マルザンナ", "text": "戦う前に\nお願いがあるの。"},
        { "location": "698/TALK"  , "narrator": "マルザンナ", "text": "もしあたしが負けて\n消えてしまっても――"},
        { "location": "699/TALK"  , "narrator": "マルザンナ", "text": "つばめのフェノメノンで\n頑張ってる現実のあたしを\n護ってあげて。"},
        { "location": "701/TALK"  , "narrator": "マルザンナ", "text": "それと……"},
        { "location": "702/TALK"  , "narrator": "マルザンナ", "text": "その……"},
        { "location": "703/TALK"  , "narrator": "マルザンナ", "text": "これが最後かも\nしれないし、その……"},
        { "location": "704/SEL"   , "narrator": "", "text": "…？"},
        { "location": "705/ACT"   , "narrator": "", "text": "…？"},
        { "location": "707/TALK"  , "narrator": "マルザンナ", "text": "……して。"},
        { "location": "708/SEL"   , "narrator": "", "text": "…？？"},
        { "location": "709/ACT"   , "narrator": "", "text": "…？？"},
        { "location": "711/TALK"  , "narrator": "マルザンナ", "text": "だっ、だからっ！！"},
        { "location": "712/TALK"  , "narrator": "マルザンナ", "text": "キキキキキキ…"},
        { "location": "713/TALK"  , "narrator": "マルザンナ", "text": "…キ…　…ス"},
        { "location": "714/SEL"   , "narrator": "", "text": "いいよ"},
        { "location": "715/SEL"   , "narrator": "", "text": "ひゃっほーう！！"},
        { "location": "716/ACT"   , "narrator": "", "text": "いいよ"},
        { "location": "718/ACT"   , "narrator": "", "text": "ひゃっほーう！！"},
        { "location": "728/TALK"  , "narrator": "マルザンナ", "text": "ででででもでもでも！\nちょっとだけ\n触れるだけよ！！"},
        { "location": "729/TALK"  , "narrator": "マルザンナ", "text": "それ以上は禁止だから！"},
        { "location": "731/TALK"  , "narrator": "マルザンナ", "text": "はい！！"},
        { "location": "746/TALK"  , "narrator": "マルザンナ", "text": "ひぁっ…"},
        { "location": "747/TALK"  , "narrator": "マルザンナ", "text": "な、なんだか\n不思議な気持ち……"},
        { "location": "751/TALK"  , "narrator": "マルザンナ", "text": "ひぁっ…"},
        { "location": "752/TALK"  , "narrator": "マルザンナ", "text": "な、なんだか\n不思議な気持ち……"},
        { "location": "759/TALK"  , "narrator": "マルザンナ", "text": "は、はいはい。\nおしまいおしまい！"},
        { "location": "760/SEL"   , "narrator": "", "text": "もう１回！"},
        { "location": "761/SEL"   , "narrator": "", "text": "柔らかかった"},
        { "location": "762/ACT"   , "narrator": "", "text": "もう１回！"},
        { "location": "766/TALK"  , "narrator": "マルザンナ", "text": "え……ええええっ！？"},
        { "location": "770/ACT"   , "narrator": "", "text": "柔らかかった"},
        { "location": "772/TALK"  , "narrator": "マルザンナ", "text": "ばっ、バカ！！"},
        { "location": "773/TALK"  , "narrator": "マルザンナ", "text": "……。"},
        { "location": "774/TALK"  , "narrator": "マルザンナ", "text": "でも、ありがと。\nいい思い出になったわ。"},
        { "location": "775/SEL"   , "narrator": "", "text": "消えないでね…"},
        { "location": "776/ACT"   , "narrator": "", "text": "消えないでね…"},
        { "location": "778/TALK"  , "narrator": "マルザンナ", "text": "ええ。もちろん、\n最善を尽くすつもり。"},
        { "location": "779/TALK"  , "narrator": "マルザンナ", "text": "それじゃ、あたしも\n準備をしてくるわ。"},
        { "location": "781/ACT"   , "narrator": "", "text": "いいぞやれやれ！"},
        { "location": "783/TALK"  , "narrator": "マルザンナ", "text": "ちょ、ちょっと\n$handle$！？"},
        { "location": "785/TALK"  , "narrator": "リヴォルカ　", "text": "豚が騒いでるわね。\n景気がいいわ。"},
        { "location": "787/TALK"  , "narrator": "マルザンナ", "text": "はぁ……\nもういいわ。"},
        { "location": "789/TALK"  , "narrator": "マルザンナ", "text": "わかった、その勝負\n乗ってあげるわよ。"},
        { "location": "790/TALK"  , "narrator": "リヴォルカ　", "text": "それでこそ\n勇敢なる戦士、\nあたしの一人格よ。"},
        { "location": "791/TALK"  , "narrator": "リヴォルカ　", "text": "それじゃ公明正大に\nやるために、マークスマン\nの面前対決にしましょ。"},
        { "location": "792/TALK"  , "narrator": "マルザンナ", "text": "…いいわよ。\nそれじゃ、\n準備してくるから。"},
        { "location": "794/TALK"  , "narrator": "マルザンナ", "text": "……。"},
        { "location": "802/TALK"  , "narrator": "リヴォルカ　", "text": "さて。\n決闘が楽しみね。"},
        { "location": "803/TALK"  , "narrator": "リヴォルカ　", "text": "あたしが勝ったら\nお祝いにあんたを\n焼き豚にして食べるわ。"},
        { "location": "804/TALK"  , "narrator": "リヴォルカ　", "text": "それと。"},
        { "location": "805/TALK"  , "narrator": "リヴォルカ　", "text": "あんたはもう\nあたしの家畜に\nなったんだから。"},
        { "location": "807/TALK"  , "narrator": "リヴォルカ　", "text": "忠誠の証を\n見せて頂戴。"},
        { "location": "808/SEL"   , "narrator": "", "text": "どうすればいいの？"},
        { "location": "809/ACT"   , "narrator": "", "text": "どうすればいいの？"},
        { "location": "817/TALK"  , "narrator": "リヴォルカ　", "text": "うーん……そうね。"},
        { "location": "818/TALK"  , "narrator": "リヴォルカ　", "text": "……。"},
        { "location": "819/TALK"  , "narrator": "リヴォルカ　", "text": "………。"},
        { "location": "821/TALK"  , "narrator": "リヴォルカ　", "text": "ちょっと考えておくわ。"},
        { "location": "822/TALK"  , "narrator": "リヴォルカ　", "text": "それじゃ、\nあたしも\n準備してくるから。"},
        { "location": "823/TALK"  , "narrator": "リヴォルカ　", "text": "決闘には\nちゃんと顔をだすのよ？"},
        { "location": "29/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>9月11日　 6:10 PM</color>\n文京ドーム突入時のこと"},
        { "location": "214/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "216/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "218/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "220/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "222/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "296/DIALOG", "narrator": "NOTICE", "text": "<color=red>【TRI-OS Error:0x99】</color>\nココロスフィアとの全回線が\n切断されました。(981)"},
        { "location": "589/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:navigator】</color>\n\n左上にあるボタンを押すのもまた、一つの選択肢のような気もします。\n(212)"},
        { "location": "591/DIALOG", "narrator": "YES_NO", "text": "<color=green>【TRI-OS Plug-in:navigator】</color>\n\nどんなことにも限度があります。\n今ならまだ、この選択を\n帳消しにすることができます。\n無効にして選択前に戻しますか？\n(213)"},
        { "location": "611/DIALOG", "narrator": "YES_NO", "text": "<color=green>【TRI-OS Plug-in:navigator】</color>\n\nどんなことにも限度があります。\n今ならまだ、この選択を\n帳消しにすることができます。\n無効にして選択前に戻しますか？\n(213)"},
        { "location": "635/DIALOG", "narrator": "NOTICE", "text": "<color=red>【TRI-OS Error:0x99】</color>\nココロスフィアとの全回線が\n切断されました。(981)"},
        { "location": "737/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "739/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:librarian】</color>\n彼女は性格的に\n3秒以上放置されると\n耐えられなくなります。\n(p87)"},
        { "location": "756/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"}
