        { "location": "511/TALK", "narrator": "神楽", "text": "…………。"},
        { "location": "512/TALK", "narrator": "神楽", "text": "どこも変わってない。\nいつもの神楽坂。"},
        { "location": "513/TALK", "narrator": "神楽", "text": "……やっぱりちょっと\n違うかな？"},
        { "location": "514/TALK", "narrator": "神楽", "text": "でも違うのは\n周りじゃなくて\nきっと――"},
        { "location": "527/TALK", "narrator": "神楽", "text": "元気ぴょん？"},
        { "location": "529/SEL" , "narrator": "", "text": "もちろん"},
        { "location": "530/SEL" , "narrator": "", "text": "神楽はどう？"},
        { "location": "531/SEL" , "narrator": "", "text": "今元気になったよ"},
        { "location": "532/ACT" , "narrator": "", "text": "もちろん"},
        { "location": "533/TALK", "narrator": "神楽", "text": "よかった♪"},
        { "location": "535/ACT" , "narrator": "", "text": "神楽はどう？"},
        { "location": "536/TALK", "narrator": "神楽", "text": "ぴょんこは元気だけどー"},
        { "location": "537/TALK", "narrator": "神楽", "text": "だけどもー"},
        { "location": "539/ACT" , "narrator": "", "text": "今元気になったよ"},
        { "location": "540/TALK", "narrator": "神楽", "text": "そっかそっか♪"},
        { "location": "542/TALK", "narrator": "神楽", "text": "かわいいね$handle$"},
        { "location": "545/TALK", "narrator": "神楽", "text": "なんかね？"},
        { "location": "546/TALK", "narrator": "神楽", "text": "ぴょんここの前"},
        { "location": "547/TALK", "narrator": "神楽", "text": "一世一代の大告白をいたしましたぴょん？？？"},
        { "location": "548/TALK", "narrator": "神楽", "text": "なのにこんなのこのこのこのこ$handle$と連絡取ったりしてなんだかなーなんだかなーなんだかなー？？？"},
        { "location": "550/SEL" , "narrator": "", "text": "悪いことなの？"},
        { "location": "551/SEL" , "narrator": "", "text": "いい方に向かってるってことじゃない？"},
        { "location": "552/SEL" , "narrator": "", "text": "絶対また話せるって思ってた"},
        { "location": "553/ACT" , "narrator": "", "text": "悪いことなの？"},
        { "location": "557/SEL" , "narrator": "", "text": "いいことだよ"},
        { "location": "558/SEL" , "narrator": "", "text": "悪いことかも…"},
        { "location": "559/SEL" , "narrator": "", "text": "それは$me$たちの未来が決める"},
        { "location": "560/ACT" , "narrator": "", "text": "いいことだよ"},
        { "location": "561/TALK", "narrator": "神楽", "text": "そっかー"},
        { "location": "562/TALK", "narrator": "神楽", "text": "円満解決ぴょん♪"},
        { "location": "563/ACT" , "narrator": "", "text": "悪いことかも…"},
        { "location": "565/TALK", "narrator": "神楽", "text": "そんなこと言うなし！"},
        { "location": "566/ACT" , "narrator": "", "text": "それは$me$たちの未来が決める"},
        { "location": "570/ACT" , "narrator": "", "text": "いい方に向かってるってことじゃない？"},
        { "location": "571/TALK", "narrator": "神楽", "text": "それはちょっとそうだね♪"},
        { "location": "572/TALK", "narrator": "神楽", "text": "完全に楽観はできないけどーーー"},
        { "location": "573/SEL" , "narrator": "", "text": "それは仕方ない"},
        { "location": "574/SEL" , "narrator": "", "text": "それでも少しはよくなったんでしょ？"},
        { "location": "575/SEL" , "narrator": "", "text": "色々難しいよね"},
        { "location": "576/ACT" , "narrator": "", "text": "それは仕方ない"},
        { "location": "577/TALK", "narrator": "神楽", "text": "そうだよねーーー"},
        { "location": "578/TALK", "narrator": "神楽", "text": "やっぱそうなっちゃうよねーーー"},
        { "location": "579/ACT" , "narrator": "", "text": "それでも少しはよくなったんでしょ？"},
        { "location": "580/TALK", "narrator": "神楽", "text": "それはね"},
        { "location": "581/TALK", "narrator": "神楽", "text": "絶対そう～～～～！"},
        { "location": "582/ACT" , "narrator": "", "text": "色々難しいよね"},
        { "location": "583/TALK", "narrator": "神楽", "text": "ですぴょん、、、、"},
        { "location": "584/TALK", "narrator": "神楽", "text": "仕方ない、、、"},
        { "location": "586/ACT" , "narrator": "", "text": "絶対また話せるって思ってた"},
        { "location": "589/TALK", "narrator": "神楽", "text": "ぴょんこ読まれてた！？！？！？！？"},
        { "location": "590/SEL" , "narrator": "", "text": "まあね……"},
        { "location": "591/SEL" , "narrator": "", "text": "そう信じるしかないでしょ"},
        { "location": "592/SEL" , "narrator": "", "text": "それが$me$の愛だから"},
        { "location": "593/ACT" , "narrator": "", "text": "まあね……"},
        { "location": "594/TALK", "narrator": "神楽", "text": "なんだそれ？？？？"},
        { "location": "595/TALK", "narrator": "神楽", "text": "もーﾊｽﾞｶｼｰ！！！！"},
        { "location": "596/ACT" , "narrator": "", "text": "そう信じるしかないでしょ"},
        { "location": "597/TALK", "narrator": "神楽", "text": "それって愛だよね！？！？！？！？"},
        { "location": "599/ACT" , "narrator": "", "text": "それが$me$の愛だから"},
        { "location": "600/TALK", "narrator": "神楽", "text": "直球決め台詞キターーーーーー！！！！"},
        { "location": "601/TALK", "narrator": "神楽", "text": "ぴょんこもうﾒﾛﾒﾛﾒﾛﾝ、、、、"},
        { "location": "615/TALK", "narrator": "神楽", "text": "……ふふふ……。"},
        { "location": "616/TALK", "narrator": "神楽", "text": "よかった……。"},
        { "location": "617/TALK", "narrator": "神楽", "text": "$handle$と\nまた普通に\n話ができて……。"},
        { "location": "618/SEL" , "narrator": "", "text": "神楽"},
        { "location": "619/ACT" , "narrator": "", "text": "神楽"},
        { "location": "636/TALK", "narrator": "神楽", "text": "呼んだぴょん？？？"},
        { "location": "637/TALK", "narrator": "神楽", "text": "どうしたぴょん？"},
        { "location": "639/SEL" , "narrator": "", "text": "神楽が返事してくれてうれしいなって"},
        { "location": "640/SEL" , "narrator": "", "text": "二度と会えないとか言わないで"},
        { "location": "641/SEL" , "narrator": "", "text": "世界がどうなっても一緒だから！"},
        { "location": "642/ACT" , "narrator": "", "text": "神楽が返事してくれてうれしいなって"},
        { "location": "643/TALK", "narrator": "神楽", "text": "そっかそっかそっかー"},
        { "location": "644/TALK", "narrator": "神楽", "text": "かわいいぞ$handle$！！！！"},
        { "location": "645/ACT" , "narrator": "", "text": "二度と会えないとか言わないで"},
        { "location": "647/TALK", "narrator": "神楽", "text": "うん"},
        { "location": "648/TALK", "narrator": "神楽", "text": "もう言わないぴょん"},
        { "location": "649/ACT" , "narrator": "", "text": "世界がどうなっても一緒だから！"},
        { "location": "651/TALK", "narrator": "神楽", "text": "惚れ直しちゃう～～～♪"},
        { "location": "663/TALK", "narrator": "神楽", "text": "$handle$ったら\nもう……。"},
        { "location": "665/TALK", "narrator": "神楽", "text": "こっちは今でも結構\n大変だったり\nするんだから……。"},
        { "location": "667/TALK", "narrator": "神楽", "text": "……でも……。"},
