{
    "dir": "chap35/daydra/dd_ch01_35_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "35102",
        "cid": "tsubame",
        "title": "002 メインストーリー",
        "sub_title": "相容れないもの＜前編＞"
    },
    "entry":
    [
        { "location": "8/SCENARIO", "narrator": "", "text": "タイトル"},
        { "location": "38/TALK"   , "narrator": "音羽", "text": "つばめちゃん。"},
        { "location": "39/TALK"   , "narrator": "つばめ", "text": "音羽さん！\nわたし――"},
        { "location": "40/TALK"   , "narrator": "音羽", "text": "とっても素敵だったよ。\nつばめちゃんの歌。"},
        { "location": "41/TALK"   , "narrator": "つばめ", "text": "あの！"},
        { "location": "42/TALK"   , "narrator": "つばめ", "text": "わたし、\n役に立てたのかな。"},
        { "location": "44/TALK"   , "narrator": "つばめ", "text": "なんか、何も考えずに\n急に「ここで歌わないと」\nって思って歌ったけど――"},
        { "location": "45/TALK"   , "narrator": "音羽", "text": "それでいいの。\nううん、むしろ\nそうでないといけない。"},
        { "location": "46/TALK"   , "narrator": "音羽", "text": "心配しなくても大丈夫。\nちゃんと神楽に想いは\n伝わってるから。"},
        { "location": "48/TALK"   , "narrator": "音羽", "text": "私が歌ったアースタシアで\n神楽のフェノメノンを\n少し改変させた。"},
        { "location": "49/TALK"   , "narrator": "音羽", "text": "そしてつばめちゃんの歌が\nイシュフォビアの歌に\n亀裂を生じさせた。"},
        { "location": "50/TALK"   , "narrator": "音羽", "text": "神楽はまだ混乱しては\nいるけど、裏を返せば\n心が揺らいでる証拠。"},
        { "location": "51/TALK"   , "narrator": "音羽", "text": "だから、つばめちゃん\nたちの歌はかなり\n効果があったということ。"},
        { "location": "53/TALK"   , "narrator": "つばめ", "text": "よかった……"},
        { "location": "54/TALK"   , "narrator": "音羽", "text": "さあ、行きましょ、\nつばめちゃん。"},
        { "location": "56/TALK"   , "narrator": "つばめ", "text": "え？\nどこへ？"},
        { "location": "57/TALK"   , "narrator": "音羽", "text": "神楽に繋がれた鎖を\n壊すために、彼女の\nココロと繋がるの。"},
        { "location": "58/TALK"   , "narrator": "つばめ", "text": "神楽ちゃんは……\n神楽ちゃんは一体、どう\nなっちゃったんですか？"},
        { "location": "59/TALK"   , "narrator": "音羽", "text": "クランの集合体を\n受けとめて、ひとつの\n強大なクランを生んだ。"},
        { "location": "60/TALK"   , "narrator": "音羽", "text": "それが、あの\nバフォメットの姿をした\n巨大な怪物の正体よ。"},
        { "location": "61/TALK"   , "narrator": "音羽", "text": "今や神楽は、圧倒的な\n力を持つクランの集合体に\n支配されてる。"},
        { "location": "62/TALK"   , "narrator": "音羽", "text": "多数のクランに対し、\n自分の想いだけでは\n太刀打ちできないから。"},
        { "location": "63/TALK"   , "narrator": "音羽", "text": "だから、神楽から、\nクランの集合体を\n切り離す必要があるの。"},
        { "location": "64/TALK"   , "narrator": "つばめ", "text": "切り離す……"},
        { "location": "65/TALK"   , "narrator": "音羽", "text": "そう。\nさあ、今こそこの扉を\nくぐってこっちに来て。"},
        { "location": "66/TALK"   , "narrator": "音羽", "text": "私も、つばめちゃんを\n受け入れる準備が\nできたから。"},
        { "location": "67/TALK"   , "narrator": "つばめ", "text": "わ、わかりました。\nそれじゃ――"},
        { "location": "69/TALK"   , "narrator": "千羽鶴", "text": "待って。"},
        { "location": "71/TALK"   , "narrator": "つばめ", "text": "えっ！？"},
        { "location": "72/TALK"   , "narrator": "千羽鶴", "text": "音羽と\n繋がってはいけない。"},
        { "location": "76/TALK"   , "narrator": "つばめ", "text": "長官さん！？"},
        { "location": "77/SEL"    , "narrator": "", "text": "千羽鶴！！"},
        { "location": "78/ACT"    , "narrator": "", "text": "千羽鶴！！"},
        { "location": "80/TALK"   , "narrator": "千羽鶴", "text": "そう。\nそしてあなたの\nセルフクラン。"},
        { "location": "81/TALK"   , "narrator": "音羽", "text": "千羽鶴……！！"},
        { "location": "83/TALK"   , "narrator": "千羽鶴", "text": "如月音羽。"},
        { "location": "84/TALK"   , "narrator": "千羽鶴", "text": "貴方には\n申し訳無いことをしたと\n思っている。"},
        { "location": "85/TALK"   , "narrator": "音羽", "text": "その事はもういい。"},
        { "location": "86/TALK"   , "narrator": "音羽", "text": "だけど、\nつばめちゃんと神楽に\nしたことは許せない。"},
        { "location": "87/TALK"   , "narrator": "音羽", "text": "だから、絶対に貴方を\n許しはしないし――"},
        { "location": "88/TALK"   , "narrator": "音羽", "text": "つばめちゃんも\n消させはしない。"},
        { "location": "89/TALK"   , "narrator": "千羽鶴", "text": "そのことなら\n残念だけど……"},
        { "location": "90/TALK"   , "narrator": "千羽鶴", "text": "逢瀬つばめは\n既に消滅した。"},
        { "location": "91/TALK"   , "narrator": "つばめ", "text": "ええっ！？\nつばめは消滅した…って、\nわたし！？"},
        { "location": "92/TALK"   , "narrator": "つばめ", "text": "私が消滅した！？\nやっぱり死んだの！？"},
        { "location": "94/TALK"   , "narrator": "千羽鶴", "text": "そう。\n貴方は既に貴方の肉体と\n離れてしまっている。"},
        { "location": "95/TALK"   , "narrator": "千羽鶴", "text": "卯月神楽の歌った\n破壊の歌によって。"},
        { "location": "96/TALK"   , "narrator": "千羽鶴", "text": "けれども\n心配しなくても\n大丈夫。"},
        { "location": "97/TALK"   , "narrator": "千羽鶴", "text": "元々貴方は、逢瀬つばめを\n構成する中でも、異端とも\n言える人格でしかない。"},
        { "location": "98/TALK"   , "narrator": "千羽鶴", "text": "セルフクランである私が\n発症によって飛び出した\n後に残った残渣。"},
        { "location": "99/TALK"   , "narrator": "千羽鶴", "text": "それが私をも凌ぐ力を\n持っていたことが、私や\n“彼ら”の誤算だった。"},
        { "location": "100/TALK"  , "narrator": "つばめ", "text": "“彼ら”って\n誰なんですか！？"},
        { "location": "101/TALK"  , "narrator": "千羽鶴", "text": "元は同志。今は敵。\nまあ、“彼ら”については\nさほど重要じゃない。"},
        { "location": "102/TALK"  , "narrator": "千羽鶴", "text": "今重要なのは、貴方が\nもはや逢瀬つばめではなく\n戻る場所も無いという事。"},
        { "location": "103/TALK"  , "narrator": "千羽鶴", "text": "そして今から、\n私は私の本当の姿――"},
        { "location": "104/TALK"  , "narrator": "千羽鶴", "text": "逢瀬つばめへと戻る。\nただいま。\nそしておかえりなさい。"},
        { "location": "105/TALK"  , "narrator": "音羽", "text": "つばめちゃん！\n千羽鶴に騙されてはダメ！"},
        { "location": "106/TALK"  , "narrator": "音羽", "text": "つばめちゃんは、\nまだ戻れる！"},
        { "location": "109/TALK"  , "narrator": "千羽鶴", "text": "無理。この子には既に\n確固たるココロがない。"},
        { "location": "110/TALK"  , "narrator": "音羽", "text": "それは、どうなのかな。"},
        { "location": "111/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "113/SEL"   , "narrator": "", "text": "残念だけど音羽、$me$は千羽鶴に協力すると決めたんだ"},
        { "location": "114/ACT"   , "narrator": "", "text": "残念だけど音羽、$me$は千羽鶴に協力すると決めたんだ"},
        { "location": "117/SEL"   , "narrator": "", "text": "おい千羽鶴！\nもう$me$の前に姿を現さないって言ったよな！"},
        { "location": "118/ACT"   , "narrator": "", "text": "おい千羽鶴！\nもう$me$の前に姿を現さないって言ったよな！"},
        { "location": "121/SEL"   , "narrator": "", "text": "音羽、何か知ってるの！？"},
        { "location": "122/ACT"   , "narrator": "", "text": "音羽、何か知ってるの！？"},
        { "location": "125/TALK"  , "narrator": "千羽鶴", "text": "何か掴んでるのね。\n私も知らない何かを。"},
        { "location": "126/TALK"  , "narrator": "音羽", "text": "さあ。それはわからない。"},
        { "location": "127/TALK"  , "narrator": "音羽", "text": "私が思ってることは\nただ１つ。"},
        { "location": "128/TALK"  , "narrator": "音羽", "text": "自分がどうなっても、\nつばめちゃんを元に戻し、\n貴方を消し飛ばす。"},
        { "location": "129/SEL"   , "narrator": "", "text": "あれ？　聞こえてない！？\n音羽！？　千羽鶴！？"},
        { "location": "130/ACT"   , "narrator": "", "text": "あれ？　聞こえてない！？\n音羽！？　千羽鶴！？"},
        { "location": "132/TALK"  , "narrator": "音羽", "text": "命に替えてもね！"},
        { "location": "164/TALK"  , "narrator": "カレン", "text": "…っ…うっ……"},
        { "location": "165/SEL"   , "narrator": "", "text": "カレン！！"},
        { "location": "166/ACT"   , "narrator": "", "text": "カレン！！"},
        { "location": "169/TALK"  , "narrator": "カレン", "text": "ええっ！？"},
        { "location": "170/TALK"  , "narrator": "カレン", "text": "$handle$さぁん…"},
        { "location": "171/SEL"   , "narrator": "", "text": "どうしたの！？"},
        { "location": "172/ACT"   , "narrator": "", "text": "どうしたの！？"},
        { "location": "174/TALK"  , "narrator": "カレン", "text": "百鶴さんが…\n百鶴さんがぁ…っ…"},
        { "location": "175/SEL"   , "narrator": "", "text": "百鶴がどうしたの！？"},
        { "location": "176/SEL"   , "narrator": "", "text": "ごめん、百鶴は$me$が倒した"},
        { "location": "177/ACT"   , "narrator": "", "text": "百鶴がどうしたの！？"},
        { "location": "179/TALK"  , "narrator": "カレン", "text": "百鶴さんが……っ…"},
        { "location": "181/TALK"  , "narrator": "カレン", "text": "いろんなコンビニの\nオリジナルスイーツを\n全部買ってきてくれて！"},
        { "location": "182/TALK"  , "narrator": "カレン", "text": "これで一週間分は\n持つでしょうって言って、\nさよならって…っ…"},
        { "location": "183/TALK"  , "narrator": "カレン", "text": "一週間前に……っ…"},
        { "location": "184/SEL"   , "narrator": "", "text": "百鶴は……もう…"},
        { "location": "185/SEL"   , "narrator": "", "text": "オリジナルスイーツはどうだった？"},
        { "location": "186/ACT"   , "narrator": "", "text": "百鶴は……もう…"},
        { "location": "187/TALK"  , "narrator": "カレン", "text": "大丈夫です…っ……\n解ってますから…"},
        { "location": "189/ACT"   , "narrator": "", "text": "オリジナルスイーツはどうだった？"},
        { "location": "190/TALK"  , "narrator": "カレン", "text": "２日で\n食べ終わりました…っ…"},
        { "location": "191/TALK"  , "narrator": "カレン", "text": "でも、大丈夫です…"},
        { "location": "192/TALK"  , "narrator": "カレン", "text": "百鶴さんのことは、\n解ってますから……"},
        { "location": "194/SEL"   , "narrator": "", "text": "ごめん、$me$が……"},
        { "location": "195/SEL"   , "narrator": "", "text": "ごめん、なんか戦う選択肢しか出なくて……"},
        { "location": "196/ACT"   , "narrator": "", "text": "ごめん、$me$が……"},
        { "location": "197/ACT"   , "narrator": "", "text": "ごめん、なんか戦う選択肢しか出なくて……"},
        { "location": "198/TALK"  , "narrator": "カレン", "text": "え？\n選択肢ですか？"},
        { "location": "200/ACT"   , "narrator": "", "text": "ごめん、百鶴は$me$が倒した"},
        { "location": "202/TALK"  , "narrator": "カレン", "text": "いえ、違うんです……"},
        { "location": "203/TALK"  , "narrator": "カレン", "text": "百鶴さんは、\n$handle$さんが\n倒したわけじゃなくて――"},
        { "location": "204/TALK"  , "narrator": "カレン", "text": "全部、百鶴さん自身が\n仕込んだことなんです。"},
        { "location": "205/SEL"   , "narrator": "", "text": "仕込んだ…！？"},
        { "location": "206/ACT"   , "narrator": "", "text": "仕込んだ…！？"},
        { "location": "208/TALK"  , "narrator": "カレン", "text": "はい。"},
        { "location": "209/TALK"  , "narrator": "カレン", "text": "百鶴さんは、わたしが\n千羽鶴に消されるのを\n良しとしてませんでした。"},
        { "location": "210/TALK"  , "narrator": "カレン", "text": "だから、破壊の歌が\n歌われる前に、ここ1xに\n匿ってくれたんです。"},
        { "location": "211/TALK"  , "narrator": "カレン", "text": "1xは私のココロの\n外側とも言える\n場所ですし――"},
        { "location": "212/TALK"  , "narrator": "カレン", "text": "無作為に抽出された\nココロアドレスですから\n簡単には見つかりません。"},
        { "location": "213/TALK"  , "narrator": "カレン", "text": "千羽鶴でさえも、\n簡単には見つけられないと\n百鶴さんは言ってました。"},
        { "location": "214/TALK"  , "narrator": "カレン", "text": "ですから、もし\n$handle$さんが\n百鶴さんと戦ったとしても"},
        { "location": "215/TALK"  , "narrator": "カレン", "text": "それは百鶴さんの\n強引な計画だったんだと\n思います。"},
        { "location": "216/TALK"  , "narrator": "カレン", "text": "選択肢も、百鶴さん自身が\n自分で作ったのかも\nしれません。"},
        { "location": "217/SEL"   , "narrator": "", "text": "なんてこった……"},
        { "location": "218/SEL"   , "narrator": "", "text": "どうして百鶴は千羽鶴に反旗を翻したの？"},
        { "location": "219/ACT"   , "narrator": "", "text": "なんてこった……"},
        { "location": "221/TALK"  , "narrator": "カレン", "text": "だから\n$handle$さんは\n全然気にしなくても……。"},
        { "location": "222/ACT"   , "narrator": "", "text": "どうして百鶴は千羽鶴に反旗を翻したの？"},
        { "location": "224/TALK"  , "narrator": "カレン", "text": "そこまでは\nわかりません。"},
        { "location": "225/TALK"  , "narrator": "カレン", "text": "ただ１つだけ\n言っていたことが\nあります。"},
        { "location": "226/TALK"  , "narrator": "カレン", "text": "『わたしは0xに\n　派遣されてきてから、\n　色々な体験をしました』"},
        { "location": "227/TALK"  , "narrator": "カレン", "text": "『そして、0xも\n　まんざらではないと\n　思いました』"},
        { "location": "228/TALK"  , "narrator": "カレン", "text": "『わたしがそう思っている\n　以上、主もいずれ、そう\n　思う可能性は高い』"},
        { "location": "229/TALK"  , "narrator": "カレン", "text": "『その時に、0xが\n　無くなってたら\n　辛い想いをする――』"},
        { "location": "230/TALK"  , "narrator": "カレン", "text": "……だそうです。"},
        { "location": "231/SEL"   , "narrator": "", "text": "それと反旗を翻すのとどういう関係が？"},
        { "location": "232/SEL"   , "narrator": "", "text": "それと百鶴の「仕込み」ってどういう関係が？"},
        { "location": "233/ACT"   , "narrator": "", "text": "それと反旗を翻すのとどういう関係が？"},
        { "location": "234/TALK"  , "narrator": "カレン", "text": "千羽鶴は、0xという\nわたしの世界を壊すことが\n目的なんだそうです。"},
        { "location": "235/TALK"  , "narrator": "カレン", "text": "けど、わたしがいる限り\n0xという世界は\n無くなりません。"},
        { "location": "236/ACT"   , "narrator": "", "text": "それと百鶴の「仕込み」ってどういう関係が？"},
        { "location": "238/TALK"  , "narrator": "カレン", "text": "自分がいると、\nココロの中のバランスが\n千羽鶴に傾いたままだと。"},
        { "location": "239/TALK"  , "narrator": "カレン", "text": "自分がいなくなれば\n天秤はわたしと千羽鶴で\n釣り合うって言って…！"},
        { "location": "240/SEL"   , "narrator": "", "text": "なるほど…"},
        { "location": "241/SEL"   , "narrator": "", "text": "そんなことで！\nなんなんだよあいつは！"},
        { "location": "242/ACT"   , "narrator": "", "text": "なるほど…"},
        { "location": "243/ACT"   , "narrator": "", "text": "そんなことで！\nなんなんだよあいつは！"},
        { "location": "245/TALK"  , "narrator": "カレン", "text": "ごめんなさい、\nわたしがもっと\nしっかりしていれば……"},
        { "location": "246/SEL"   , "narrator": "", "text": "カレンのせいじゃないから！"},
        { "location": "247/SEL"   , "narrator": "", "text": "ホントだよ責任とれ"},
        { "location": "248/ACT"   , "narrator": "", "text": "カレンのせいじゃないから！"},
        { "location": "249/TALK"  , "narrator": "カレン", "text": "…ありがとうございます。"},
        { "location": "250/ACT"   , "narrator": "", "text": "ホントだよ責任とれ"},
        { "location": "252/TALK"  , "narrator": "カレン", "text": "はあぁっ……\nごめんなさい、\nごめんなさい……っ。"},
        { "location": "253/TALK"  , "narrator": "カレン", "text": "どんなことしても\n償う気持ちで一杯です。"},
        { "location": "259/TALK"  , "narrator": "カレン", "text": "それで、\nひとつ百鶴さんと\n約束したことがあって。"},
        { "location": "260/SEL"   , "narrator": "", "text": "なに！？"},
        { "location": "261/ACT"   , "narrator": "", "text": "なに！？"},
        { "location": "263/TALK"  , "narrator": "カレン", "text": "えと、それは……"},
        { "location": "264/TALK"  , "narrator": "カレン", "text": "わたし――"},
        { "location": "267/TALK"  , "narrator": "カレン", "text": "<size=35>セルフクランに\nなります！！</size>"},
        { "location": "268/SEL"   , "narrator": "", "text": "え…どういうこと！？"},
        { "location": "269/SEL"   , "narrator": "", "text": "マジで？　すごい！！"},
        { "location": "270/ACT"   , "narrator": "", "text": "え…どういうこと！？"},
        { "location": "271/TALK"  , "narrator": "カレン", "text": "あ、えっと、\nわたしが逢瀬つばめの\n主人格になるんです。"},
        { "location": "272/ACT"   , "narrator": "", "text": "マジで？　すごい！！"},
        { "location": "273/TALK"  , "narrator": "カレン", "text": "あああっ！\nで、でもなれるとは\n限らないんですよ！"},
        { "location": "274/TALK"  , "narrator": "カレン", "text": "でも、なれたら\nわたしが逢瀬つばめの\n主人格になります。"},
        { "location": "276/TALK"  , "narrator": "カレン", "text": "今はもう実質\nそうなってるんですけど、\nそれはあくまで結果論で。"},
        { "location": "277/TALK"  , "narrator": "カレン", "text": "今つばめにいる人格の\n中で、最も影響力がある\nからというだけなので――"},
        { "location": "278/TALK"  , "narrator": "カレン", "text": "千羽鶴が戻って来たら\n一瞬でそれが書き換わって\nしまうそうなんです。"},
        { "location": "279/TALK"  , "narrator": "カレン", "text": "本来逢瀬つばめのセルフ\nクランは千羽鶴ですし、\n全然違う性格でしたし。"},
        { "location": "280/TALK"  , "narrator": "カレン", "text": "けど、わたしがセルフ\nクランになれば、千羽鶴は\n戻って来れなくなって、"},
        { "location": "281/TALK"  , "narrator": "カレン", "text": "千羽鶴という人格がない、\n今の状態こそが、\n本当のわたしになります。"},
        { "location": "282/SEL"   , "narrator": "", "text": "なるほど"},
        { "location": "283/ACT"   , "narrator": "", "text": "なるほど"},
        { "location": "285/TALK"  , "narrator": "カレン", "text": "千羽鶴がいまクランとして\n分離してるのは、安定して\n日本を維持したい為。"},
        { "location": "286/TALK"  , "narrator": "カレン", "text": "不安定な因子である\nわたしたち、残留人格を\n隔離して雑音を無くす為。"},
        { "location": "287/TALK"  , "narrator": "カレン", "text": "けど、わたしたちが\n壊されれば、分離している\n意味はありません。"},
        { "location": "288/TALK"  , "narrator": "カレン", "text": "だから、もうすぐにでも\n戻ってくるはずです。"},
        { "location": "289/TALK"  , "narrator": "カレン", "text": "千羽鶴は百鶴さんが\nわたしを匿っていたことを\n知りませんから。"},
        { "location": "290/TALK"  , "narrator": "カレン", "text": "その時千羽鶴がわたしを\n見つけてどうするかは\nわかりませんが――"},
        { "location": "291/TALK"  , "narrator": "カレン", "text": "恐らくは再度わたしを\n潰す為に色々なことを\nするだろうと。"},
        { "location": "292/TALK"  , "narrator": "カレン", "text": "でも、わたしがセルフ\nクランになってしまえば\nもう手出しはできない。"},
        { "location": "293/TALK"  , "narrator": "カレン", "text": "だから百鶴さんは、\n匿ってくれたんです。"},
        { "location": "294/TALK"  , "narrator": "カレン", "text": "わたしがセルフクランに\nなって、千羽鶴と対等な\n関係になることを望んで。"},
        { "location": "295/TALK"  , "narrator": "カレン", "text": "ただ、わたしがセルフ\nクランになるには、\nその……"},
        { "location": "296/TALK"  , "narrator": "カレン", "text": "$handle$さんの\n力が必要なんだそうです。"},
        { "location": "297/TALK"  , "narrator": "カレン", "text": "だから、お願いです、\n協力してください！"},
        { "location": "299/SEL"   , "narrator": "", "text": "$me$は千羽鶴に協力したいから、それは無理"},
        { "location": "300/SEL"   , "narrator": "", "text": "$me$は千羽鶴派だけど、百鶴の直感に賭けて協力する"},
        { "location": "301/ACT"   , "narrator": "", "text": "$me$は千羽鶴に協力したいから、それは無理"},
        { "location": "302/TALK"  , "narrator": "カレン", "text": "あ――"},
        { "location": "303/TALK"  , "narrator": "カレン", "text": "そ、そうだったんですね。\nすみません、そんなこと\n知らなかったので。"},
        { "location": "304/TALK"  , "narrator": "カレン", "text": "言いたい放題言っちゃって\n本当にごめんなさい。"},
        { "location": "305/TALK"  , "narrator": "カレン", "text": "ああっ、でもどうしよう。"},
        { "location": "306/TALK"  , "narrator": "カレン", "text": "わたしがセルフクランに\nなる為の準備をし始めたら\nきっと邪魔しますよね？"},
        { "location": "307/SEL"   , "narrator": "", "text": "当然です"},
        { "location": "308/SEL"   , "narrator": "", "text": "いや、邪魔しないよ"},
        { "location": "309/ACT"   , "narrator": "", "text": "当然です"},
        { "location": "311/TALK"  , "narrator": "カレン", "text": "そうですか……"},
        { "location": "312/TALK"  , "narrator": "カレン", "text": "……。"},
        { "location": "313/TALK"  , "narrator": "カレン", "text": "ごめんなさい！\nそれでもわたし、\n止められません。"},
        { "location": "314/TALK"  , "narrator": "カレン", "text": "百鶴さんや、他の人格の\n皆さんの想いも\n背負っていますから！"},
        { "location": "315/TALK"  , "narrator": "カレン", "text": "もしそれでも、\n$handle$さんが\nわたしを阻止するなら――"},
        { "location": "316/TALK"  , "narrator": "カレン", "text": "ごめんなさい……\n$handle$さんと\n戦います。"},
        { "location": "317/TALK"  , "narrator": "カレン", "text": "次に$handle$さんが\nここに来るときが、\nその時になると思います。"},
        { "location": "318/TALK"  , "narrator": "カレン", "text": "それまで、\nどうかお元気で……。"},
        { "location": "321/ACT"   , "narrator": "", "text": "いや、邪魔しないよ"},
        { "location": "323/TALK"  , "narrator": "カレン", "text": "ほんとですか！？\nありがとうございます！"},
        { "location": "324/TALK"  , "narrator": "カレン", "text": "$handle$さんに\nあまり迷惑かけないように\n頑張りますから！"},
        { "location": "325/TALK"  , "narrator": "カレン", "text": "ありがとうございます！"},
        { "location": "326/TALK"  , "narrator": "カレン", "text": "あの……それで……"},
        { "location": "327/TALK"  , "narrator": "カレン", "text": "迷惑ついでに\n１つお願いが\nあるんですけど――"},
        { "location": "329/TALK"  , "narrator": "カレン", "text": "$handle$さんに\nひとつ、手伝って欲しい\nことがありまして。"},
        { "location": "330/SEL"   , "narrator": "", "text": "何をするの？"},
        { "location": "331/ACT"   , "narrator": "", "text": "何をするの？"},
        { "location": "335/ACT"   , "narrator": "", "text": "$me$は千羽鶴派だけど、百鶴の直感に賭けて協力する"},
        { "location": "337/TALK"  , "narrator": "カレン", "text": "ありがとうございます。"},
        { "location": "338/TALK"  , "narrator": "カレン", "text": "きっと百鶴さんも\n喜んでると思います。"},
        { "location": "339/TALK"  , "narrator": "カレン", "text": "わたしも精一杯\nがんばりますから\nよろしくお願いします！"},
        { "location": "343/SEL"   , "narrator": "", "text": "もちろん協力する"},
        { "location": "344/ACT"   , "narrator": "", "text": "もちろん協力する"},
        { "location": "346/TALK"  , "narrator": "カレン", "text": "ありがとうございます！"},
        { "location": "347/TALK"  , "narrator": "カレン", "text": "わたし、精一杯\n頑張りますから、\nよろしくお願いします！"},
        { "location": "350/SEL"   , "narrator": "", "text": "で、何をすれば？"},
        { "location": "351/ACT"   , "narrator": "", "text": "で、何をすれば？"},
        { "location": "354/TALK"  , "narrator": "カレン", "text": "あ、えっと\nそれはですね……"},
        { "location": "355/TALK"  , "narrator": "カレン", "text": "わたしが昇華した後に、\n邪念をはたき落として\n欲しいんですよ。"},
        { "location": "356/SEL"   , "narrator": "", "text": "えっとそれって、俗に言うバトル…？"},
        { "location": "357/ACT"   , "narrator": "", "text": "えっとそれって、俗に言うバトル…？"},
        { "location": "360/TALK"  , "narrator": "カレン", "text": "まあ、\nそうなっちゃいますね。"},
        { "location": "361/TALK"  , "narrator": "カレン", "text": "でも、\n気にしないでください！"},
        { "location": "362/TALK"  , "narrator": "カレン", "text": "これはセルフクランに\nなる為の試練なので！"},
        { "location": "363/TALK"  , "narrator": "カレン", "text": "ちょっと怖いですけど、\n$handle$さんなら\n大丈夫ですから。"},
        { "location": "364/TALK"  , "narrator": "カレン", "text": "それよりも……"},
        { "location": "365/TALK"  , "narrator": "カレン", "text": "――って、これは\nまた後でも……"},
        { "location": "366/SEL"   , "narrator": "", "text": "え？　なに？"},
        { "location": "367/ACT"   , "narrator": "", "text": "え？　なに？"},
        { "location": "369/TALK"  , "narrator": "カレン", "text": "ああっ！\nいえ、なんでも\nありません！"},
        { "location": "370/TALK"  , "narrator": "カレン", "text": "それじゃわたし、\nセルフになるための\n準備がありますので！"},
        { "location": "371/TALK"  , "narrator": "カレン", "text": "あの、\n$handle$さん！"},
        { "location": "372/SEL"   , "narrator": "", "text": "はい"},
        { "location": "373/SEL"   , "narrator": "", "text": "どうしたの？　改まって"},
        { "location": "374/ACT"   , "narrator": "", "text": "はい"},
        { "location": "375/ACT"   , "narrator": "", "text": "どうしたの？　改まって"},
        { "location": "378/TALK"  , "narrator": "カレン", "text": "えっと……"},
        { "location": "379/TALK"  , "narrator": "カレン", "text": "今までずっと\nわたしを支えてくれて\nありがとうございます！"},
        { "location": "380/TALK"  , "narrator": "カレン", "text": "もしわたしが\nセルフクランになれたら。"},
        { "location": "381/TALK"  , "narrator": "カレン", "text": "一時的に現実のわたしの\n感情が不安定になるかも\nしれません。"},
        { "location": "382/TALK"  , "narrator": "カレン", "text": "でもそれは、わたし自身に\nこんな感情もあったんだと\nいう驚きからのものです。"},
        { "location": "383/TALK"  , "narrator": "カレン", "text": "ですから、どうか今までと\n同じように、暖かく\n見守ってください。"},
        { "location": "384/TALK"  , "narrator": "カレン", "text": "……まあそれ以前に、\n私がセルフクランに\nなれれば、ですけど。"},
        { "location": "385/TALK"  , "narrator": "カレン", "text": "それじゃ、ちょっと\n準備してきますね。"},
        { "location": "386/TALK"  , "narrator": "カレン", "text": "わたし……\n$handle$さんと\n出逢えて良かったです！"},
        { "location": "388/TALK"  , "narrator": "カレン", "text": "$handle$さんに\n素敵なココロの旅を。"},
        { "location": "25/DIALOG" , "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:Interrupt】</color>\nSystem Interrupted.\n\n必須選択肢が選ばれていません。\n\n<color=green>『STORY27：シン・カグラ』</color>\nにて、選択を行ってから\n再度アクセスしてください。\n"},
        { "location": "28/DIALOG" , "narrator": "Dialog_Black", "text": "音羽さん。\n\nわたし、歌ったよ――"},
        { "location": "29/DIALOG" , "narrator": "Dialog_Black", "text": "ちゃんと神楽ちゃんに届いたかな。\n\nわたしの想い――"},
        { "location": "37/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>-月--日　 -:-- --</color>\nNull"},
        { "location": "135/DIALOG", "narrator": "Dialog_InfoOS", "text": "\n\nSystem Interrupted.\n\nMODE : DI\nRESTART : SPHERE_MODE.\nMODE : EI\nSET_ADDR: 1x052\nRUN/."},
        { "location": "395/DIALOG", "narrator": "NOTICE", "text": "<color=red>【TRI-OS Error:0x99】</color>\nココロスフィアとの回線が\n切断されました。(981)"}
    ]
}
