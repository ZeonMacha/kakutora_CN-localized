        { "location": "142/SCENARIO", "narrator": "", "text": "550_手書きの文字"},
        { "location": "167/TALK"    , "narrator": "ガブリエラ", "text": "$handle$ははんこって持ってるの？"},
        { "location": "169/SEL"     , "narrator": "", "text": "持ってるけど"},
        { "location": "170/SEL"     , "narrator": "", "text": "突然どうしたの"},
        { "location": "171/ACT"     , "narrator": "", "text": "持ってるけど"},
        { "location": "172/ACT"     , "narrator": "", "text": "突然どうしたの"},
        { "location": "174/TALK"    , "narrator": "ガブリエラ", "text": "やっぱり持ってるのね"},
        { "location": "176/TALK"    , "narrator": "ガブリエラ", "text": "じゃあサインはしないものなの？"},
        { "location": "178/SEL"     , "narrator": "", "text": "しないよ"},
        { "location": "179/SEL"     , "narrator": "", "text": "練習したことはある"},
        { "location": "180/ACT"     , "narrator": "", "text": "しないよ"},
        { "location": "181/TALK"    , "narrator": "ガブリエラ", "text": "そうなのね・・・"},
        { "location": "182/ACT"     , "narrator": "", "text": "練習したことはある"},
        { "location": "183/TALK"    , "narrator": "ガブリエラ", "text": "それは"},
        { "location": "184/TALK"    , "narrator": "ガブリエラ", "text": "うんと小さい頃の話よね？"},
        { "location": "186/TALK"    , "narrator": "ガブリエラ", "text": "じゃあ"},
        { "location": "187/TALK"    , "narrator": "ガブリエラ", "text": "$handle$のものだって証明はどうするの？"},
        { "location": "189/SEL"     , "narrator": "", "text": "自分自身が証明書"},
        { "location": "190/ACT"     , "narrator": "", "text": "自分自身が証明書"},
        { "location": "192/TALK"    , "narrator": "ガブリエラ", "text": "わかるような"},
        { "location": "193/TALK"    , "narrator": "ガブリエラ", "text": "わからないような・・・"},
        { "location": "195/SEL"     , "narrator": "", "text": "サインが欲しいの？"},
        { "location": "196/SEL"     , "narrator": "", "text": "今話してるだけじゃ証明できない？"},
        { "location": "197/ACT"     , "narrator": "", "text": "サインが欲しいの？"},
        { "location": "198/TALK"    , "narrator": "ガブリエラ", "text": "あっ"},
        { "location": "199/TALK"    , "narrator": "ガブリエラ", "text": "勘違いしてるのね"},
        { "location": "200/TALK"    , "narrator": "ガブリエラ", "text": "タレントとかミュージシャンのサインとは違うわよ"},
        { "location": "201/ACT"     , "narrator": "", "text": "今話してるだけじゃ証明できない？"},
        { "location": "202/TALK"    , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "203/TALK"    , "narrator": "ガブリエラ", "text": "そういうものかもしれないわ"},
        { "location": "205/TALK"    , "narrator": "ガブリエラ", "text": "日本のことはだいぶわかってきたつもりだったのに"},
        { "location": "206/TALK"    , "narrator": "ガブリエラ", "text": "はんこのことはとてもびっくりしたわ"},
        { "location": "209/SEL"     , "narrator": "", "text": "そうなの？"},
        { "location": "210/SEL"     , "narrator": "", "text": "そうだろうね"},
        { "location": "211/ACT"     , "narrator": "", "text": "そうなの？"},
        { "location": "212/ACT"     , "narrator": "", "text": "そうだろうね"},
        { "location": "214/TALK"    , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "215/TALK"    , "narrator": "ガブリエラ", "text": "普通の手紙なんかには使わないのよね"},
        { "location": "217/SEL"     , "narrator": "", "text": "うん"},
        { "location": "218/SEL"     , "narrator": "", "text": "使うよ？"},
        { "location": "219/SEL"     , "narrator": "", "text": "よくできました"},
        { "location": "220/ACT"     , "narrator": "", "text": "うん"},
        { "location": "221/TALK"    , "narrator": "ガブリエラ", "text": "うんうん"},
        { "location": "222/TALK"    , "narrator": "ガブリエラ", "text": "そうよねv"},
        { "location": "223/ACT"     , "narrator": "", "text": "使うよ？"},
        { "location": "224/TALK"    , "narrator": "ガブリエラ", "text": "まあ！"},
        { "location": "225/TALK"    , "narrator": "ガブリエラ", "text": "なんでそんな嘘をつくのかしら？"},
        { "location": "226/ACT"     , "narrator": "", "text": "よくできました"},
        { "location": "236/TALK"    , "narrator": "ガブリエラ", "text": "あら"},
        { "location": "237/TALK"    , "narrator": "ガブリエラ", "text": "大したことなくってよv"},
        { "location": "239/TALK"    , "narrator": "ガブリエラ", "text": "じゃあ"},
        { "location": "240/TALK"    , "narrator": "ガブリエラ", "text": "日本の普通の手紙を見せてもらえないかしら？"},
        { "location": "241/TALK"    , "narrator": "ガブリエラ", "text": "プライバシーに関わることだから"},
        { "location": "242/TALK"    , "narrator": "ガブリエラ", "text": "私宛に手紙を書いてくれればいいわ"},
        { "location": "245/SEL"     , "narrator": "", "text": "ラブレターか…"},
        { "location": "246/SEL"     , "narrator": "", "text": "返事を書いてくれるなら"},
        { "location": "247/SEL"     , "narrator": "", "text": "WAVEじゃダメなの？"},
        { "location": "248/ACT"     , "narrator": "", "text": "ラブレターか…"},
        { "location": "259/TALK"    , "narrator": "ガブリエラ", "text": "えっ"},
        { "location": "260/TALK"    , "narrator": "ガブリエラ", "text": "そんなつもりで言ったんじゃないのよ！？！？！？！"},
        { "location": "262/SEL"     , "narrator": "", "text": "じゃあいらない？"},
        { "location": "263/ACT"     , "narrator": "", "text": "じゃあいらない？"},
        { "location": "264/TALK"    , "narrator": "ガブリエラ", "text": "えっと"},
        { "location": "265/TALK"    , "narrator": "ガブリエラ", "text": "えっと"},
        { "location": "267/TALK"    , "narrator": "ガブリエラ", "text": "欲しいです・・・・"},
        { "location": "271/ACT"     , "narrator": "", "text": "返事を書いてくれるなら"},
        { "location": "272/TALK"    , "narrator": "ガブリエラ", "text": "えっ"},
        { "location": "273/TALK"    , "narrator": "ガブリエラ", "text": "えっと"},
        { "location": "275/TALK"    , "narrator": "ガブリエラ", "text": "書いてあげるから・・・・"},
        { "location": "276/ACT"     , "narrator": "", "text": "WAVEじゃダメなの？"},
        { "location": "277/TALK"    , "narrator": "ガブリエラ", "text": "だめよ！"},
        { "location": "278/TALK"    , "narrator": "ガブリエラ", "text": "それじゃいつもと変わらないわ？"},
        { "location": "279/TALK"    , "narrator": "ガブリエラ", "text": "貴方からの手書きの手紙が欲しいのよ！！"},
        { "location": "282/SEL"     , "narrator": "", "text": "じゃあ今度ね"},
        { "location": "283/ACT"     , "narrator": "", "text": "じゃあ今度ね"},
        { "location": "285/TALK"    , "narrator": "ガブリエラ", "text": "待ってるんだからね？"},
        { "location": "286/TALK"    , "narrator": "ガブリエラ", "text": "絶対よ？"},
        { "location": "289/TALK"    , "narrator": "ボイスメール", "text": "お手紙の中身はね"},
        { "location": "232/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>1000pt.</b></color></size>\nアップしました！"},
        { "location": "254/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>1000pt.</b></color></size>\nアップしました！"},
        { "location": "301/DIALOG"  , "narrator": "Dialog_GETVoice", "text": "<color=green>【ガブリエラ】</color>のボイスメール\n<color=red>【お手紙の中身はね】</color>\nをゲットしました！"}
    ]
