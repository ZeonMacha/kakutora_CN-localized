    [
        { "location": "150/TALK"  , "narrator": "アーヤ", "text": "食べ慣れてない食べ物って"},
        { "location": "151/TALK"  , "narrator": "アーヤ", "text": "いまいちちゃんと料理できてるかわからないのよね(￣Д￣ )"},
        { "location": "152/TALK"  , "narrator": "アーヤ", "text": "でも美味しかったらいいわよね(｡-_-｡)"},
        { "location": "153/TALK"  , "narrator": "アーヤ", "text": "美味しかったし"},
        { "location": "154/TALK"  , "narrator": "アーヤ", "text": "実際(;^_^A"},
        { "location": "164/SEL"   , "narrator": "", "text": "何作ったの"},
        { "location": "165/SEL"   , "narrator": "", "text": "$me$もおなかすいてきた"},
        { "location": "166/SEL"   , "narrator": "", "text": "アーヤの手料理食べたいな"},
        { "location": "172/ACT"   , "narrator": "", "text": "何作ったの"},
        { "location": "173/TALK"  , "narrator": "アーヤ", "text": "サラダなんだけど"},
        { "location": "174/ACT"   , "narrator": "", "text": "$me$もおなかすいてきた"},
        { "location": "175/TALK"  , "narrator": "アーヤ", "text": "そう？"},
        { "location": "176/TALK"  , "narrator": "アーヤ", "text": "こういうのってうつるわね"},
        { "location": "177/ACT"   , "narrator": "", "text": "アーヤの手料理食べたいな"},
        { "location": "189/TALK"  , "narrator": "アーヤ", "text": "そうよね"},
        { "location": "190/TALK"  , "narrator": "アーヤ", "text": "私だって食べてもらいたいわ"},
        { "location": "191/TALK"  , "narrator": "アーヤ", "text": "$handle$さんに"},
        { "location": "192/TALK"  , "narrator": "アーヤ", "text": "あーん"},
        { "location": "193/TALK"  , "narrator": "アーヤ", "text": "なんてね"},
        { "location": "198/TALK"  , "narrator": "アーヤ", "text": "タブーリっていう"},
        { "location": "199/TALK"  , "narrator": "アーヤ", "text": "レバノン料理"},
        { "location": "200/TALK"  , "narrator": "アーヤ", "text": "食べたことあったっけ？"},
        { "location": "202/SEL"   , "narrator": "", "text": "もうちょっと説明して"},
        { "location": "203/SEL"   , "narrator": "", "text": "ないかな……"},
        { "location": "204/SEL"   , "narrator": "", "text": "あれ美味しいよね"},
        { "location": "205/ACT"   , "narrator": "", "text": "もうちょっと説明して"},
        { "location": "206/TALK"  , "narrator": "アーヤ", "text": "みじん切りのパセリのサラダ"},
        { "location": "207/TALK"  , "narrator": "アーヤ", "text": "トマトとタマネギも入るの"},
        { "location": "208/TALK"  , "narrator": "アーヤ", "text": "パセリが主役ってとこがポイントみたいね(・・。)ゞ"},
        { "location": "209/ACT"   , "narrator": "", "text": "ないかな……"},
        { "location": "210/TALK"  , "narrator": "アーヤ", "text": "そうだったわね"},
        { "location": "211/TALK"  , "narrator": "アーヤ", "text": "機会があったら"},
        { "location": "212/TALK"  , "narrator": "アーヤ", "text": "試してみて"},
        { "location": "213/ACT"   , "narrator": "", "text": "あれ美味しいよね"},
        { "location": "214/TALK"  , "narrator": "アーヤ", "text": "そうよね"},
        { "location": "215/TALK"  , "narrator": "アーヤ", "text": "パセリだらけなのにちゃんとサラダだし"},
        { "location": "216/TALK"  , "narrator": "アーヤ", "text": "見た目もちょっとおしゃれだし"},
        { "location": "218/TALK"  , "narrator": "アーヤ", "text": "ただやっぱり問題は"},
        { "location": "219/TALK"  , "narrator": "アーヤ", "text": "確信を持ってこれが正しい味って言い切れないところね"},
        { "location": "220/TALK"  , "narrator": "アーヤ", "text": "だからちゃんと言い切れるようになったら"},
        { "location": "221/TALK"  , "narrator": "アーヤ", "text": "食べてもらいたいわ"},
        { "location": "222/TALK"  , "narrator": "アーヤ", "text": "あなたにも"},
        { "location": "169/DIALOG", "narrator": "Tutorial/Dialog_Tutorial_Candy", "text": "彼女たちとの会話では\n<color=red>【ココロキャンディ】</color>という\nものを消費して先へ進む。\n\n足りない場合、ジュエルで買うか、\nバトル等で貯めてからストーリーを\n再挑戦することになるから注意。\n\n<color=green>今回だけは使っても減らないから、\n好きな選択肢を選んでみて。</color>"},
        { "location": "187/DIALOG", "narrator": "Tutorial/Dialog_Tutorial_Love2", "text": "<color=red>【親密度】</color>を沢山貯めると\n彼女との関係性が変化していく。\n\n<color=green>【友達】</color>になり<color=orange>【恋人】</color>になり…\n更にその先まで発展するかも。\n頑張ってハートを集めて欲しい。\n\n集めたハートは<color=red>【PROFILE】</color>で\n確認できるわ。"},
        { "location": "196/DIALOG", "narrator": "Tutorial/Dialog_Tutorial_Camera", "text": "そうそう、ひとつお得情報。\n<color=red>カメラボタンを押すことで、\n彼女を見守る視点を変えられる。</color>\n\n今回はお試しでカメラを５つ\n用意しておいた。\n実際には<color=green>ゴキゲンポイント</color>で\n交換して増やしていくことに\nなるから、今のうちにいっぱい\n堪能しておくといいと思う。"}
    ]
}
