{
    "dir": "dramatics/daydra/drm_ch01_00_220.js",
    "type": "Episode",
    "info": {
        "story_id": "1022",
        "cid": "tsubame",
        "title": "らぶとーく 第22話",
        "sub_title": "ひなこちゃん"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "ひなこちゃん"},
        { "location": "18/TALK"   , "narrator": "雛", "text": "――え？\nちょ、ちょっと待って！"},
        { "location": "20/TALK"   , "narrator": "雛", "text": "えっと…今の話から\n推測するとー。"},
        { "location": "22/TALK"   , "narrator": "雛", "text": "つばめちゃん…\n好きな人がいる、\nってこと？"},
        { "location": "24/TALK"   , "narrator": "つばめ", "text": "うん。"},
        { "location": "25/TALK"   , "narrator": "雛", "text": "つばめちゃん！！"},
        { "location": "28/TALK"   , "narrator": "つばめ", "text": "は、はい！？"},
        { "location": "29/TALK"   , "narrator": "雛", "text": "…おめでとう。"},
        { "location": "30/TALK"   , "narrator": "雛", "text": "あたし、今マジで本当に\n超嬉しいよ！"},
        { "location": "32/TALK"   , "narrator": "雛", "text": "つばめちゃんの方から、\nあたしに恋愛相談を\nしてくるなんて！"},
        { "location": "33/TALK"   , "narrator": "つばめ", "text": "う、うん…こんな相談\nできるの――"},
        { "location": "35/TALK"   , "narrator": "つばめ", "text": "ひなこちゃんくらいしか\n思いつかなくて…。"},
        { "location": "37/TALK"   , "narrator": "雛", "text": "ナイス判断！\n間違ってないよ、それ。"},
        { "location": "38/TALK"   , "narrator": "雛", "text": "まゆちんとかキリトに\nこんな相談しても――"},
        { "location": "39/TALK"   , "narrator": "雛", "text": "まともな答えは出ない\nだろうしね。"},
        { "location": "40/TALK"   , "narrator": "雛", "text": "ここは恋愛キューピッドの\nあたしに任せてよー。"},
        { "location": "42/TALK"   , "narrator": "つばめ", "text": "うん。\nよろしくお願いします。"},
        { "location": "43/TALK"   , "narrator": "雛", "text": "それじゃ、詳しく\n聞かせてもらえる？"},
        { "location": "45/TALK"   , "narrator": "つばめ", "text": "うん…でも、どこから\n話せばいいかな？"},
        { "location": "47/TALK"   , "narrator": "つばめ", "text": "うーん…。"},
        { "location": "48/SEL"    , "narrator": "", "text": "ちょっと待って"},
        { "location": "49/ACT"    , "narrator": "", "text": "ちょっと待って"},
        { "location": "54/TALK"   , "narrator": "つばめ", "text": "あ…ごめんひなこちゃん！\nちょっとだけ待って\nもらえる？"},
        { "location": "55/TALK"   , "narrator": "雛", "text": "おっ！？\nもしかして相手は…。"},
        { "location": "57/TALK"   , "narrator": "つばめ", "text": "え、えへへ…秘密！"},
        { "location": "71/TALK"   , "narrator": "つばめ", "text": "ごめんね$handle$さん"},
        { "location": "72/TALK"   , "narrator": "つばめ", "text": "今からひなこちゃんに"},
        { "location": "73/TALK"   , "narrator": "つばめ", "text": "$handle$さんとのことを相談するところなの(´∀｀*)ｳﾌﾌ"},
        { "location": "74/TALK"   , "narrator": "つばめ", "text": "だから"},
        { "location": "75/TALK"   , "narrator": "つばめ", "text": "お話は少し待ってもらぇるかな？(´・ω・`) "},
        { "location": "77/SEL"    , "narrator": "", "text": "何を言うつもり？"},
        { "location": "78/SEL"    , "narrator": "", "text": "このことを他人に言うならおしまいだね"},
        { "location": "79/SEL"    , "narrator": "", "text": "第三者の意見も重要かも"},
        { "location": "80/ACT"    , "narrator": "", "text": "何を言うつもり？"},
        { "location": "81/TALK"   , "narrator": "つばめ", "text": "$handle$さんに対する気持ち"},
        { "location": "82/TALK"   , "narrator": "つばめ", "text": "恋人だと思ってるけど"},
        { "location": "83/TALK"   , "narrator": "つばめ", "text": "お兄ちゃんって思ぅ気持ちじゃぃけなぃんだよね？(´・ω・｀)"},
        { "location": "84/TALK"   , "narrator": "つばめ", "text": "だから"},
        { "location": "85/TALK"   , "narrator": "つばめ", "text": "どぅぃぅ気持ちじゃなきゃぃけなぃのか"},
        { "location": "86/TALK"   , "narrator": "つばめ", "text": "詳しく聞こぅと思って(๑･ㅂ･)و✧"},
        { "location": "87/TALK"   , "narrator": "つばめ", "text": "もちろん$handle$さんのことは言わなぃよ？(*´︶`*)"},
        { "location": "89/SEL"    , "narrator": "", "text": "それでもダメ"},
        { "location": "90/ACT"    , "narrator": "", "text": "それでもダメ"},
        { "location": "92/TALK"   , "narrator": "つばめ", "text": "ぇぇっ！？Σ(ﾟдﾟlll)"},
        { "location": "93/TALK"   , "narrator": "つばめ", "text": "なんで？・゜・(ノД`)・゜・"},
        { "location": "95/SEL"    , "narrator": "", "text": "つばめに気付いてほしいから"},
        { "location": "96/ACT"    , "narrator": "", "text": "つばめに気付いてほしいから"},
        { "location": "98/TALK"   , "narrator": "つばめ", "text": "そっか…"},
        { "location": "99/TALK"   , "narrator": "つばめ", "text": "わかったよ(´つω・｀)ｼｭﾝ"},
        { "location": "100/TALK"  , "narrator": "つばめ", "text": "ひなこちゃんに謝ってくるね"},
        { "location": "113/TALK"  , "narrator": "つばめ", "text": "…ごめんなさい！\nやっぱり、この話は\nなかったことにして！"},
        { "location": "114/TALK"  , "narrator": "雛", "text": "な、何ですと！？"},
        { "location": "115/TALK"  , "narrator": "雛", "text": "そ、そりゃないよ\nつばめちゃん。"},
        { "location": "116/TALK"  , "narrator": "雛", "text": "あたしだって、聞きたくて\n超ウズウズワクワクしてた\nっていうのにー…。"},
        { "location": "118/TALK"  , "narrator": "つばめ", "text": "本当にごめんなさい！"},
        { "location": "120/TALK"  , "narrator": "つばめ", "text": "でも…この話は他の人に\n言っちゃダメだ、って…。"},
        { "location": "121/TALK"  , "narrator": "雛", "text": "…恋人さんに言われたの？"},
        { "location": "122/TALK"  , "narrator": "つばめ", "text": "うん…。"},
        { "location": "123/TALK"  , "narrator": "雛", "text": "…………。"},
        { "location": "125/TALK"  , "narrator": "つばめ", "text": "ごめんね…。"},
        { "location": "126/TALK"  , "narrator": "雛", "text": "よし、許す！！"},
        { "location": "129/TALK"  , "narrator": "つばめ", "text": "え？"},
        { "location": "130/TALK"  , "narrator": "雛", "text": "つばめちゃんの恋人さんが\n言うなって言ってるん\nでしょ？"},
        { "location": "131/TALK"  , "narrator": "雛", "text": "それなのに無理やり\n聞き出して――"},
        { "location": "132/TALK"  , "narrator": "雛", "text": "それでつばめちゃんと\n恋人さんの関係にヒビが\n入ったりしたら――"},
        { "location": "133/TALK"  , "narrator": "雛", "text": "愛のキューピッドの\n名が廃るわ！"},
        { "location": "134/TALK"  , "narrator": "つばめ", "text": "ひなこちゃん…。"},
        { "location": "135/TALK"  , "narrator": "雛", "text": "だから、気にしないで\nいいよー。"},
        { "location": "136/TALK"  , "narrator": "雛", "text": "でも、もし何か相談したい\nことがあった時は――"},
        { "location": "137/TALK"  , "narrator": "雛", "text": "またあたしに声掛けてね。"},
        { "location": "139/TALK"  , "narrator": "つばめ", "text": "うん！\nありがと、ひなこちゃん。"},
        { "location": "141/TALK"  , "narrator": "雛", "text": "…なんて、かっこいいこと\n言いはしたけど――"},
        { "location": "142/TALK"  , "narrator": "雛", "text": "やっぱり、\n超気になるなぁ…。"},
        { "location": "143/ACT"   , "narrator": "", "text": "このことを他人に言うならおしまいだね"},
        { "location": "144/TALK"  , "narrator": "つばめ", "text": "えっ！？Σ(ﾟдﾟlll)"},
        { "location": "145/TALK"  , "narrator": "つばめ", "text": "そんなのヤダ！"},
        { "location": "146/TALK"  , "narrator": "つばめ", "text": "言わなぃからそんなこと言わなぃで・゜・(ノД`)・゜・"},
        { "location": "158/ACT"   , "narrator": "", "text": "第三者の意見も重要かも"},
        { "location": "159/TALK"  , "narrator": "つばめ", "text": "よかった(●´ω｀●)ゞｴﾍﾍ"},
        { "location": "160/TALK"  , "narrator": "つばめ", "text": "そぅ言ってもらぇて"},
        { "location": "172/TALK"  , "narrator": "つばめ", "text": "ごめん、おまたせ。"},
        { "location": "174/TALK"  , "narrator": "雛", "text": "いいっていいってー。"},
        { "location": "175/TALK"  , "narrator": "雛", "text": "それより、早速聞かせて\nもらえる？"},
        { "location": "176/TALK"  , "narrator": "つばめ", "text": "うん…。"},
        { "location": "177/TALK"  , "narrator": "つばめ", "text": "その人と会ったのは、\n東京に来てから\nなんだけど――"},
        { "location": "178/TALK"  , "narrator": "つばめ", "text": "いつも、色んな相談に\n乗ってもらったり\nしてて――"},
        { "location": "180/TALK"  , "narrator": "つばめ", "text": "最初はどういう人かは\nわからなかったの。"},
        { "location": "181/TALK"  , "narrator": "つばめ", "text": "けど、よく話してるうちに\nお友達になって――"},
        { "location": "183/TALK"  , "narrator": "つばめ", "text": "今は、その…恋人同士に\nなったつもりではあるん\nだけど…。"},
        { "location": "184/TALK"  , "narrator": "雛", "text": "ちょっと待った！"},
        { "location": "187/TALK"  , "narrator": "雛", "text": "こっちに来てから\n知り合ったってことは――"},
        { "location": "189/TALK"  , "narrator": "雛", "text": "もしかして、うちの\n学校の生徒とか？"},
        { "location": "191/TALK"  , "narrator": "つばめ", "text": "えっと…詳しくは\n話せないんだけど――"},
        { "location": "192/TALK"  , "narrator": "つばめ", "text": "うちの学校の生徒じゃ\nないよ。"},
        { "location": "194/TALK"  , "narrator": "雛", "text": "ふーん…そっかー…。"},
        { "location": "195/TALK"  , "narrator": "つばめ", "text": "？"},
        { "location": "196/TALK"  , "narrator": "雛", "text": "あ、ごめんね。\n続けて続けてー。"},
        { "location": "197/TALK"  , "narrator": "つばめ", "text": "うん…それで、一応その、\n恋人同士にはなれたとは\n思うんだけど――"},
        { "location": "198/TALK"  , "narrator": "つばめ", "text": "恋人同士の好きって、\n特別な好きじゃないと\nいけないの？"},
        { "location": "199/TALK"  , "narrator": "雛", "text": "どういうこと？"},
        { "location": "200/TALK"  , "narrator": "つばめ", "text": "わたし、その人のことを\nお兄ちゃんみたいな人だと\n思ってるの。"},
        { "location": "201/TALK"  , "narrator": "つばめ", "text": "けど、恋人同士の好き、\nっていうのは――"},
        { "location": "202/TALK"  , "narrator": "つばめ", "text": "お兄ちゃんに対する好き、\nっていうのとは、違うん\nだよね？"},
        { "location": "203/TALK"  , "narrator": "雛", "text": "…………。"},
        { "location": "206/TALK"  , "narrator": "つばめ", "text": "わたしはその人のこと、\n本当に好きなんだけど――"},
        { "location": "207/TALK"  , "narrator": "つばめ", "text": "どうしてもそこが\n引っかかってて…。"},
        { "location": "208/TALK"  , "narrator": "雛", "text": "なるほどねー…。"},
        { "location": "210/TALK"  , "narrator": "つばめ", "text": "ひなこちゃん。\nわたし、どうしたら\nいいと思う？"},
        { "location": "212/TALK"  , "narrator": "雛", "text": "うーん…そうだなー…。"},
        { "location": "214/TALK"  , "narrator": "雛", "text": "多分、つばめちゃんが\nその人に抱いてる気持ち\nって――"},
        { "location": "215/TALK"  , "narrator": "雛", "text": "まだ恋じゃないと思うの。"},
        { "location": "216/TALK"  , "narrator": "つばめ", "text": "そ、そんな！\nわたし、本当に好きって\n思ってるんだよ！？"},
        { "location": "217/TALK"  , "narrator": "雛", "text": "うん、それについては\n疑ってないよ。"},
        { "location": "218/TALK"  , "narrator": "雛", "text": "でも、今のつばめちゃんが\n抱いてる、好き、って\n気持ちは――"},
        { "location": "219/TALK"  , "narrator": "雛", "text": "恋に発展する前段階の\n好きなんじゃないかな？"},
        { "location": "220/TALK"  , "narrator": "つばめ", "text": "…恋の、前段階？"},
        { "location": "221/TALK"  , "narrator": "雛", "text": "うん。\nえーっと、なんて説明\nすればいいかな…。"},
        { "location": "222/TALK"  , "narrator": "雛", "text": "その人は、他の人と比べて\n特別な存在、って\n思ってるでしょ？"},
        { "location": "223/TALK"  , "narrator": "つばめ", "text": "うん。"},
        { "location": "224/TALK"  , "narrator": "雛", "text": "そう、それだよ。\nその人は他の人より\n特別な存在なの。"},
        { "location": "225/TALK"  , "narrator": "雛", "text": "でも、特別ではあるけど、\n恋を抱くほどではないん\nじゃないかな？"},
        { "location": "226/TALK"  , "narrator": "雛", "text": "けど、他の人よりも\n特別で大切、って\n気持ちがあるから――"},
        { "location": "227/TALK"  , "narrator": "雛", "text": "それを恋だと間違えて\nいるんだと思うなー。"},
        { "location": "229/TALK"  , "narrator": "つばめ", "text": "…そう、なのかな？"},
        { "location": "230/TALK"  , "narrator": "雛", "text": "その人のことを、\n大切な恋人として好き、\nって気持ちじゃなくて――"},
        { "location": "231/TALK"  , "narrator": "雛", "text": "お兄ちゃんみたいで好き、\nって気持ちで見てるなら、\nそうだと思うなー。"},
        { "location": "232/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "235/TALK"  , "narrator": "つばめ", "text": "じゃあ…わたし達はまだ、\n恋人じゃない、ってこと？"},
        { "location": "236/TALK"  , "narrator": "雛", "text": "うん…あたしはそう思う。"},
        { "location": "237/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "238/TALK"  , "narrator": "雛", "text": "ただ――"},
        { "location": "239/TALK"  , "narrator": "雛", "text": "話を聞いてる限りだと、\n二人とも相思相愛だ、\nっていうのは――"},
        { "location": "240/TALK"  , "narrator": "雛", "text": "すっごい伝わってきた。\nきっと、凄い仲良し\nなんだねー。"},
        { "location": "242/TALK"  , "narrator": "つばめ", "text": "…うん。\n一緒にお話してると、\n凄く楽しいの。"},
        { "location": "243/TALK"  , "narrator": "雛", "text": "だろうねー。"},
        { "location": "244/TALK"  , "narrator": "雛", "text": "だから、二人がそういう\n気持ちを持ってるなら――"},
        { "location": "245/TALK"  , "narrator": "雛", "text": "もう少し時間を掛ければ、\nきっと解決すると思うよ。"},
        { "location": "246/TALK"  , "narrator": "つばめ", "text": "…どれくらいかな？"},
        { "location": "247/TALK"  , "narrator": "雛", "text": "それはわからないけど、\n絶対大丈夫！"},
        { "location": "248/TALK"  , "narrator": "雛", "text": "なんてったって、\nつばめちゃんは\n可愛いしねー。"},
        { "location": "251/TALK"  , "narrator": "つばめ", "text": "や、やめてよ\nひなこちゃん。\n恥ずかしいよ…。"},
        { "location": "253/TALK"  , "narrator": "雛", "text": "あれだけ惚気話を\nしておきながら！？"},
        { "location": "255/TALK"  , "narrator": "雛", "text": "…まあ、とにかくさ。"},
        { "location": "256/TALK"  , "narrator": "雛", "text": "もしまた不安になったり\nしたときは、いつでも\nあたしに言ってね。"},
        { "location": "257/TALK"  , "narrator": "雛", "text": "その時はまた、的確に\nアドバイスしちゃうから！"},
        { "location": "259/TALK"  , "narrator": "つばめ", "text": "ふふっ…うん。\nその時はまた、\nよろしくお願いします。"},
        { "location": "261/TALK"  , "narrator": "つばめ", "text": "…わたし、もしかして\n焦り過ぎてたのかな？"},
        { "location": "262/TALK"  , "narrator": "つばめ", "text": "…もっと、$handle$さんの\nことどう思ってるのか、\nしっかり考えなきゃ！"}
    ]
}
