        "title": "002 メインストーリー",
        "sub_title": "女王様とウサギ＜前編＞"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "女王様とウサギ"},
        { "location": "26/TALK"   , "narrator": "みやび", "text": "ふむ…思った通りや。"},
        { "location": "28/TALK"   , "narrator": "みやび", "text": "ここ最近で、急に世界が\n動き出しちょるようや\nねぇ…。"},
        { "location": "34/TALK"   , "narrator": "みやび", "text": "…逢瀬つばめのことも\nそうやけんど――"},
        { "location": "35/TALK"   , "narrator": "みやび", "text": "あのＷＡＶＥのＢＯＴの\nことも気になる。"},
        { "location": "40/TALK"   , "narrator": "みやび", "text": "…やはり、ネットには\n何の情報も無し、か。"},
        { "location": "41/TALK"   , "narrator": "みやび", "text": "ＷＡＶＥが始めた\n新サービスかもと\n思うたんやが…。"},
        { "location": "43/TALK"   , "narrator": "みやび", "text": "一般人のＷＡＶＥには\nない機能、ちゅうことは、\n答えは一つ。"},
        { "location": "44/TALK"   , "narrator": "みやび", "text": "管理庁の作りだした、\nトライナリー監視用の\nソフト。"},
        { "location": "45/TALK"   , "narrator": "みやび", "text": "そして逢瀬つばめも、\n管理庁が送り込んだ\n刺客――"},
        { "location": "47/TALK"   , "narrator": "みやび", "text": "いや、決めつけはいかん。\n証拠はまだないんやし…。"},
        { "location": "48/TALK"   , "narrator": "みやび", "text": "疑うておくくらいに\n留めておくんが、\n今のところベストか…。"},
        { "location": "54/TALK"   , "narrator": "みやび", "text": "ん？　ウサギか…。"},
        { "location": "55/TALK"   , "narrator": "みやび", "text": "…………。"},
        { "location": "56/TALK"   , "narrator": "みやび", "text": "ああ、やっぱしそうかー。"},
        { "location": "57/TALK"   , "narrator": "みやび", "text": "まあわかってはいた\nけんどな。"},
        { "location": "59/TALK"   , "narrator": "みやび", "text": "しかし、ウサギの洞察力を\n持ってしても、欠片も\n情報がみつからんとは…。"},
        { "location": "60/TALK"   , "narrator": "みやび", "text": "さて、どうした\nものか…。"},
        { "location": "61/TALK"   , "narrator": "みやび", "text": "『RabbitAnimaの\n見解は？』…と。"},
        { "location": "63/TALK"   , "narrator": "みやび", "text": "…あー、\nなるほどなぁ。"},
        { "location": "64/TALK"   , "narrator": "みやび", "text": "やけんど、それやと\nリスクも大きく――"},
        { "location": "65/TALK"   , "narrator": "みやび", "text": "……。"},
        { "location": "66/TALK"   , "narrator": "みやび", "text": "こら、いかんね。\nやはりここいらが\n潮時か……"},
        { "location": "110/TALK"  , "narrator": "みやび", "text": "……　…"},
        { "location": "124/TALK"  , "narrator": "みやび", "text": "ふわあっ！"},
        { "location": "128/TALK"  , "narrator": "みやび", "text": "ひやぁぁっ！"},
        { "location": "132/TALK"  , "narrator": "みやび", "text": "ふごあぁぁっ！"},
        { "location": "139/TALK"  , "narrator": "みやび", "text": "はあああ……\nまたお前さんか。"},
        { "location": "140/SEL"   , "narrator": "", "text": "また寝てるし"},
        { "location": "141/ACT"   , "narrator": "", "text": "また寝てるし"},
        { "location": "145/TALK"  , "narrator": "みやび", "text": "他にする事ないきね。\n今日は新記録の\n８３度寝に挑戦する。"},
        { "location": "146/SEL"   , "narrator": "", "text": "あるでしょ、やること！"},
        { "location": "147/ACT"   , "narrator": "", "text": "あるでしょ、やること！"},
        { "location": "149/TALK"  , "narrator": "みやび", "text": "あー…もしかしてまた、\n扉で[クラン]が\n暴れちゅうが？"},
        { "location": "156/TALK"  , "narrator": "みやび", "text": "オープンプロセス、\n0x0022番地から\n0x963F番地へ。"},
        { "location": "171/TALK"  , "narrator": "みやび", "text": "…ふむ、完了。"},
        { "location": "173/TALK"  , "narrator": "みやび", "text": "さ、適当に入りや。"},
        { "location": "174/SEL"   , "narrator": "", "text": "説明して"},
        { "location": "175/ACT"   , "narrator": "", "text": "説明して"},
        { "location": "177/TALK"  , "narrator": "みやび", "text": "説明せんでも\nわかるろう？"},
        { "location": "178/SEL"   , "narrator": "", "text": "いや申し訳無いけど、今回は何でロックかかったのか１ミリもわからない"},
        { "location": "179/ACT"   , "narrator": "", "text": "いや申し訳無いけど、今回は何でロックかかったのか１ミリもわからない"},
        { "location": "181/TALK"  , "narrator": "みやび", "text": "マジか！"},
        { "location": "183/TALK"  , "narrator": "みやび", "text": "仕方ないね……"},
        { "location": "185/TALK"  , "narrator": "みやび", "text": "ええと、\nココロファイルナンバー\n04-669-11によると――"},
        { "location": "186/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "187/TALK"  , "narrator": "みやび", "text": "………。"},
        { "location": "188/TALK"  , "narrator": "みやび", "text": "あー、これはいかんね。"},
        { "location": "189/TALK"  , "narrator": "みやび", "text": "$handle$が\n分からなくて当然や…。"},
        { "location": "190/SEL"   , "narrator": "", "text": "何がわかったの！？"},
        { "location": "191/ACT"   , "narrator": "", "text": "何がわかったの！？"},
        { "location": "193/TALK"  , "narrator": "みやび", "text": "あ、うむ。"},
        { "location": "194/TALK"  , "narrator": "みやび", "text": "今から晩ご飯を食べに\n行くか、このまま作業を\n続けるか悩んじょる。"},
        { "location": "195/SEL"   , "narrator": "", "text": "そうなんだ"},
        { "location": "196/SEL"   , "narrator": "", "text": "嘘ですよね"},
        { "location": "197/ACT"   , "narrator": "", "text": "そうなんだ"},
        { "location": "198/TALK"  , "narrator": "みやび", "text": "うむ、そうなんや。\nだいぶ腹が減っちゅう\nようやね。"},
        { "location": "199/TALK"  , "narrator": "みやび", "text": "で、うちとしては、\n飯を喰いに行くなんて\nあり得ないと思うちょる。"},
        { "location": "200/TALK"  , "narrator": "みやび", "text": "作業を続ける方向で\n協力してや。"},
        { "location": "201/SEL"   , "narrator": "", "text": "オッケー！"},
        { "location": "202/SEL"   , "narrator": "", "text": "嘘ですよね"},
        { "location": "203/ACT"   , "narrator": "", "text": "オッケー！"},
        { "location": "204/TALK"  , "narrator": "みやび", "text": "よぅし！\nオッケーゆうたね！"},
        { "location": "205/TALK"  , "narrator": "みやび", "text": "いてら！"},
        { "location": "213/ACT"   , "narrator": "", "text": "嘘ですよね"},
        { "location": "215/ACT"   , "narrator": "", "text": "嘘ですよね"},
        { "location": "217/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "218/TALK"  , "narrator": "みやび", "text": "いくら司書業を営んで\nおろうとも、嘘を言わねば\nならんこともあるちや。"},
        { "location": "219/SEL"   , "narrator": "", "text": "本当の事教えて"},
        { "location": "220/ACT"   , "narrator": "", "text": "本当の事教えて"},
        { "location": "222/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "223/TALK"  , "narrator": "みやび", "text": "わかった。"},
        { "location": "224/TALK"  , "narrator": "みやび", "text": "理由は$handle$、\nお前さんやき。"},
        { "location": "225/TALK"  , "narrator": "みやび", "text": "現実のうちは、お前さんに\n相当な警戒心を抱きゆう。"},
        { "location": "226/TALK"  , "narrator": "みやび", "text": "ぶっちゃけ、今も、\nもはやBotの事が\n分からなければ――"},
        { "location": "227/TALK"  , "narrator": "みやび", "text": "強制的に関係を切断\nせざるを得ないと\n考えちょった。"},
        { "location": "228/SEL"   , "narrator": "", "text": "それって、$me$とみやびがもう話せなくなるってこと？"},
        { "location": "229/ACT"   , "narrator": "", "text": "それって、$me$とみやびがもう話せなくなるってこと？"},
        { "location": "231/TALK"  , "narrator": "みやび", "text": "その通り。"},
        { "location": "232/TALK"  , "narrator": "みやび", "text": "出来るかどうかわからん\nけんど、物理的な回線を\n切断しようとしちゅう。"},
        { "location": "233/TALK"  , "narrator": "みやび", "text": "それが叶わなくても、\n二度と受け答えは\nせんようになるな。"},
        { "location": "234/TALK"  , "narrator": "みやび", "text": "それは嫌やろ？"},
        { "location": "235/SEL"   , "narrator": "", "text": "嫌やわ"},
        { "location": "236/SEL"   , "narrator": "", "text": "別に"},
        { "location": "237/ACT"   , "narrator": "", "text": "嫌やわ"},
        { "location": "238/TALK"  , "narrator": "みやび", "text": "ほんだら、扉を\n塞いじゅう[クラン]を\nすっと倒しいや。"},
        { "location": "239/TALK"  , "narrator": "みやび", "text": "うちの本心は、\nまだ$handle$と\n繋がっていたい。"},
        { "location": "240/TALK"  , "narrator": "みやび", "text": "今ならまだ\n間に合うきね。"},
        { "location": "242/TALK"  , "narrator": "みやび", "text": "うちと$handle$に\nえいココロの旅を！"},
        { "location": "249/ACT"   , "narrator": "", "text": "別に"},
        { "location": "250/TALK"  , "narrator": "みやび", "text": "ほうかほうか。\nならここにいるのも\n時間の無駄やき。"},
        { "location": "251/TALK"  , "narrator": "みやび", "text": "はよ他んとこ行きや。"},
        { "location": "20/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>5月4日　2:07 PM</color>\nFreyMENOWライブ戦翌日、\n寮「とらいあんぐる」203号室にて。"},
        { "location": "78/DIALOG" , "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "115/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "137/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"}
    ]
}
