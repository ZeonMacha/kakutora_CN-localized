    "entry":
    [
        { "location": "221/SCENARIO", "narrator": "", "text": "記憶と追憶"},
        { "location": "246/TALK"    , "narrator": "神楽", "text": "ねえ$handle$"},
        { "location": "247/TALK"    , "narrator": "神楽", "text": "終わりの始まりって退廃的でステキだと思わない？"},
        { "location": "248/TALK"    , "narrator": "神楽", "text": "それから"},
        { "location": "249/TALK"    , "narrator": "神楽", "text": "それを目の当たりにすることができるのって"},
        { "location": "250/TALK"    , "narrator": "神楽", "text": "ありえないような奇跡だと思わない？"},
        { "location": "251/TALK"    , "narrator": "神楽", "text": "なんて"},
        { "location": "252/TALK"    , "narrator": "神楽", "text": "そう思わないとやってられないっていうか"},
        { "location": "253/TALK"    , "narrator": "神楽", "text": "現実ってもうどうしようもない"},
        { "location": "255/SEL"     , "narrator": "", "text": "何があったの？"},
        { "location": "256/SEL"     , "narrator": "", "text": "疲れてるんだね…"},
        { "location": "257/SEL"     , "narrator": "", "text": "$me$に全部吐き出して"},
        { "location": "258/ACT"     , "narrator": "", "text": "何があったの？"},
        { "location": "259/TALK"    , "narrator": "神楽", "text": "大変なことがあったんだぴょん"},
        { "location": "260/ACT"     , "narrator": "", "text": "疲れてるんだね…"},
        { "location": "261/TALK"    , "narrator": "神楽", "text": "当たり前当たり前当たり前！！！"},
        { "location": "262/ACT"     , "narrator": "", "text": "$me$に全部吐き出して"},
        { "location": "265/TALK"    , "narrator": "神楽", "text": "だいすきﾍﾟﾛﾍﾟﾛﾍﾟﾛﾍﾟﾛ！"},
        { "location": "267/TALK"    , "narrator": "神楽", "text": "ぴょんこはこの世界に理由と目的があって送り込まれてきたでしょ"},
        { "location": "268/TALK"    , "narrator": "神楽", "text": "それなのに"},
        { "location": "269/TALK"    , "narrator": "神楽", "text": "ぴょんこの意思とは関係のないところでこの世界を改変するって話になったみたい"},
        { "location": "272/SEL"     , "narrator": "", "text": "それは大変だ"},
        { "location": "273/SEL"     , "narrator": "", "text": "元々意思が尊重されてたようには見えないけど…"},
        { "location": "274/SEL"     , "narrator": "", "text": "それってもう終わりってこと？"},
        { "location": "275/ACT"     , "narrator": "", "text": "それは大変だ"},
        { "location": "276/TALK"    , "narrator": "神楽", "text": "ほんとそれ"},
        { "location": "277/ACT"     , "narrator": "", "text": "元々意思が尊重されてたようには見えないけど…"},
        { "location": "278/TALK"    , "narrator": "神楽", "text": "うがー"},
        { "location": "279/TALK"    , "narrator": "神楽", "text": "まあね？？？"},
        { "location": "280/TALK"    , "narrator": "神楽", "text": "そうなんだけど！！！"},
        { "location": "281/TALK"    , "narrator": "神楽", "text": "今までの方がまだましだったっていうそういう話！！！"},
        { "location": "282/ACT"     , "narrator": "", "text": "それってもう終わりってこと？"},
        { "location": "283/TALK"    , "narrator": "神楽", "text": "そんな感じー"},
        { "location": "285/TALK"    , "narrator": "神楽", "text": "ママも音羽もぴょんこがどうにかするつもりだったのに"},
        { "location": "286/TALK"    , "narrator": "神楽", "text": "もうぴょんこにはどうにもできない"},
        { "location": "287/TALK"    , "narrator": "神楽", "text": "でもそれより"},
        { "location": "288/TALK"    , "narrator": "神楽", "text": "この世界が変わったらもう$handle$のことは忘れちゃう"},
        { "location": "291/TALK"    , "narrator": "神楽", "text": "忘れたくないのに"},
        { "location": "293/SEL"     , "narrator": "", "text": "そんなことないよ"},
        { "location": "294/SEL"     , "narrator": "", "text": "$me$は神楽を忘れない"},
        { "location": "295/SEL"     , "narrator": "", "text": "全部最後にはうまくいくから！"},
        { "location": "296/ACT"     , "narrator": "", "text": "そんなことないよ"},
        { "location": "297/TALK"    , "narrator": "神楽", "text": "そんなわけないでしょ"},
        { "location": "298/ACT"     , "narrator": "", "text": "$me$は神楽を忘れない"},
        { "location": "299/TALK"    , "narrator": "神楽", "text": "そんなのわからないし"},
        { "location": "300/TALK"    , "narrator": "神楽", "text": "覚えてない可能性の方が高いし"},
        { "location": "301/TALK"    , "narrator": "神楽", "text": "それから"},
        { "location": "304/TALK"    , "narrator": "神楽", "text": "ううんやっぱりなんでもない"},
        { "location": "305/TALK"    , "narrator": "神楽", "text": "なんでもないから"},
        { "location": "306/ACT"     , "narrator": "", "text": "全部最後にはうまくいくから！"},
        { "location": "307/TALK"    , "narrator": "神楽", "text": "バカなの？？？？"},
        { "location": "308/TALK"    , "narrator": "神楽", "text": "バカだったね！"},
        { "location": "311/TALK"    , "narrator": "神楽", "text": "でもそう考えられたらいいのかもねー"},
        { "location": "312/TALK"    , "narrator": "神楽", "text": "ぴょんこには無理だけど"},
        { "location": "314/TALK"    , "narrator": "神楽", "text": "何のためにこの世界に来たのかって思ったり"},
        { "location": "317/TALK"    , "narrator": "神楽", "text": "結局ぴょんこはただの駒でしかないんだなってｾﾞﾂﾎﾞｰしたり"},
        { "location": "320/TALK"    , "narrator": "神楽", "text": "でも"},
        { "location": "323/TALK"    , "narrator": "神楽", "text": "一番つらいのは$handle$との思い出が全部なくなること"},
        { "location": "325/SEL"     , "narrator": "", "text": "憶えててくれないの？"},
        { "location": "326/SEL"     , "narrator": "", "text": "なくなったりしないよ"},
        { "location": "327/SEL"     , "narrator": "", "text": "$me$が全部覚えとく"},
        { "location": "328/ACT"     , "narrator": "", "text": "憶えててくれないの？"},
        { "location": "329/TALK"    , "narrator": "神楽", "text": "忘れたくないけど"},
        { "location": "330/ACT"     , "narrator": "", "text": "なくなったりしないよ"},
        { "location": "331/TALK"    , "narrator": "神楽", "text": "どこかにその爪痕は残ったりするかもしれないけど"},
        { "location": "332/ACT"     , "narrator": "", "text": "$me$が全部覚えとく"},
        { "location": "333/TALK"    , "narrator": "神楽", "text": "それは"},
        { "location": "334/TALK"    , "narrator": "神楽", "text": "ぴょんこの分も？"},
        { "location": "336/SEL"     , "narrator": "", "text": "もちろん"},
        { "location": "337/SEL"     , "narrator": "", "text": "神楽は神楽で思い出を持っててよ"},
        { "location": "338/ACT"     , "narrator": "", "text": "もちろん"},
        { "location": "339/TALK"    , "narrator": "神楽", "text": "そっか、、、"},
        { "location": "340/ACT"     , "narrator": "", "text": "神楽は神楽で思い出を持っててよ"},
        { "location": "341/TALK"    , "narrator": "神楽", "text": "それはできないって言ってるのに"},
        { "location": "342/TALK"    , "narrator": "神楽", "text": "何でそんなこと言うの"},
        { "location": "346/SEL"     , "narrator": "", "text": "$me$はそっちの世界の干渉を受けない"},
        { "location": "347/SEL"     , "narrator": "", "text": "$me$には使命があるから"},
        { "location": "348/SEL"     , "narrator": "", "text": "約束したよね"},
        { "location": "349/ACT"     , "narrator": "", "text": "$me$はそっちの世界の干渉を受けない"},
        { "location": "350/TALK"    , "narrator": "神楽", "text": "それって"},
        { "location": "351/TALK"    , "narrator": "神楽", "text": "本当なの？"},
        { "location": "352/ACT"     , "narrator": "", "text": "$me$には使命があるから"},
        { "location": "353/TALK"    , "narrator": "神楽", "text": "ぴょんこも知らないこと？"},
        { "location": "354/ACT"     , "narrator": "", "text": "約束したよね"},
        { "location": "355/TALK"    , "narrator": "神楽", "text": "約束って？"},
        { "location": "358/SEL"     , "narrator": "", "text": "ずっと一緒だって言ったでしょ"},
        { "location": "359/SEL"     , "narrator": "", "text": "神楽の側にいたいんだ"},
        { "location": "360/SEL"     , "narrator": "", "text": "$me$たち恋人同士だから！"},
        { "location": "361/ACT"     , "narrator": "", "text": "ずっと一緒だって言ったでしょ"},
        { "location": "362/TALK"    , "narrator": "神楽", "text": "聞いた"},
        { "location": "364/TALK"    , "narrator": "神楽", "text": "それは"},
        { "location": "365/ACT"     , "narrator": "", "text": "神楽の側にいたいんだ"},
        { "location": "366/TALK"    , "narrator": "神楽", "text": "知ってるし"},
        { "location": "367/TALK"    , "narrator": "神楽", "text": "ぴょんこだってそうだし"},
        { "location": "368/ACT"     , "narrator": "", "text": "$me$たち恋人同士だから！"},
        { "location": "369/TALK"    , "narrator": "神楽", "text": "今はね"},
        { "location": "370/TALK"    , "narrator": "神楽", "text": "そうだけど"},
        { "location": "372/TALK"    , "narrator": "神楽", "text": "でももうぴょんこだけの話じゃないんだよ？？？"},
        { "location": "373/TALK"    , "narrator": "神楽", "text": "この世界が変わっちゃったらどうなるかなんて"},
        { "location": "374/TALK"    , "narrator": "神楽", "text": "ぴょんこにはわかんないし"},
        { "location": "377/TALK"    , "narrator": "神楽", "text": "あれ"},
        { "location": "378/TALK"    , "narrator": "神楽", "text": "$handle$は知ってるのひょっとして"},
        { "location": "380/SEL"     , "narrator": "", "text": "まさか！"},
        { "location": "381/SEL"     , "narrator": "", "text": "それは言えない"},
        { "location": "382/SEL"     , "narrator": "", "text": "希望はある"},
        { "location": "383/ACT"     , "narrator": "", "text": "まさか！"},
        { "location": "384/TALK"    , "narrator": "神楽", "text": "だよね"},
        { "location": "385/ACT"     , "narrator": "", "text": "それは言えない"},
        { "location": "386/TALK"    , "narrator": "神楽", "text": "あっなんか含んでる？？？"},
        { "location": "387/TALK"    , "narrator": "神楽", "text": "厨二っぽいな～"},
        { "location": "388/TALK"    , "narrator": "神楽", "text": "嫌いじゃないけど"},
        { "location": "389/TALK"    , "narrator": "神楽", "text": "いやむしろ好きだけど"},
        { "location": "390/ACT"     , "narrator": "", "text": "希望はある"},
        { "location": "391/TALK"    , "narrator": "神楽", "text": "mjd言ってる？？？"},
        { "location": "394/SEL"     , "narrator": "", "text": "$me$を信じて"},
        { "location": "395/SEL"     , "narrator": "", "text": "この先も二人でいようよ"},
        { "location": "396/SEL"     , "narrator": "", "text": "よくなるために未来はあるんだよ"},
        { "location": "397/ACT"     , "narrator": "", "text": "$me$を信じて"},
        { "location": "398/TALK"    , "narrator": "神楽", "text": "信じてないわけじゃない"},
        { "location": "399/ACT"     , "narrator": "", "text": "この先も二人でいようよ"},
        { "location": "400/TALK"    , "narrator": "神楽", "text": "ずっと？？？"},
        { "location": "401/ACT"     , "narrator": "", "text": "よくなるために未来はあるんだよ"},
        { "location": "402/TALK"    , "narrator": "神楽", "text": "だったらいいんだけど"},
        { "location": "404/TALK"    , "narrator": "神楽", "text": "もしかして$handle$ってぴょんこを元気づけようとしてるの？"},
        { "location": "406/SEL"     , "narrator": "", "text": "何を今さら"},
        { "location": "407/SEL"     , "narrator": "", "text": "それもあるけど"},
        { "location": "408/SEL"     , "narrator": "", "text": "本気でこの先の話をしてるんだけどな～"},
        { "location": "409/ACT"     , "narrator": "", "text": "何を今さら"},
        { "location": "410/TALK"    , "narrator": "神楽", "text": "あれ"},
        { "location": "411/TALK"    , "narrator": "神楽", "text": "そっか、、、"},
        { "location": "412/ACT"     , "narrator": "", "text": "それもあるけど"},
        { "location": "413/TALK"    , "narrator": "神楽", "text": "あるんだ"},
        { "location": "414/TALK"    , "narrator": "神楽", "text": "やっぱり"},
        { "location": "415/ACT"     , "narrator": "", "text": "本気でこの先の話をしてるんだけどな～"},
        { "location": "416/TALK"    , "narrator": "神楽", "text": "どんだけ楽天主義なの$handle$"},
        { "location": "418/TALK"    , "narrator": "神楽", "text": "でもうん"},
        { "location": "419/TALK"    , "narrator": "神楽", "text": "そうだね"},
        { "location": "420/TALK"    , "narrator": "神楽", "text": "そういうの"},
        { "location": "422/TALK"    , "narrator": "神楽", "text": "大事かも"},
        { "location": "425/TALK"    , "narrator": "ボイスメール", "text": "微糖のティアドロップス"},
        { "location": "437/DIALOG"  , "narrator": "Dialog_GETVoice", "text": "<color=green>【神楽】</color>のボイスメール\n<color=red>【微糖のティアドロップス】</color>\nをゲットしました！"}
    ]
}
