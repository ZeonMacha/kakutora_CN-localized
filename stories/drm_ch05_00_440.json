        "title": "らぶとーく 第44話",
        "sub_title": "ニルヴァーナ"
    },
    "entry":
    [
        { "location": "2463/SCENARIO", "narrator": "", "text": "ニルヴァーナ"},
        { "location": "2488/TALK"    , "narrator": "神楽", "text": "ぴょんこはやっとわかった"},
        { "location": "2489/TALK"    , "narrator": "神楽", "text": "ぴょんこのことを本当にわかってくれるのは$handle$だけだって"},
        { "location": "2491/SEL"     , "narrator": "", "text": "だって恋人だからね"},
        { "location": "2492/SEL"     , "narrator": "", "text": "そう言ってくれてうれしいよ"},
        { "location": "2493/SEL"     , "narrator": "", "text": "大げさだなあもう"},
        { "location": "2494/ACT"     , "narrator": "", "text": "だって恋人だからね"},
        { "location": "2495/TALK"    , "narrator": "神楽", "text": "そうぴょん"},
        { "location": "2497/TALK"    , "narrator": "神楽", "text": "恋人ぴょん"},
        { "location": "2498/ACT"     , "narrator": "", "text": "そう言ってくれてうれしいよ"},
        { "location": "2499/TALK"    , "narrator": "神楽", "text": "ぴょんこ気付くのが遅かったね"},
        { "location": "2502/ACT"     , "narrator": "", "text": "大げさだなあもう"},
        { "location": "2503/TALK"    , "narrator": "神楽", "text": "そんなことないぴょん"},
        { "location": "2504/TALK"    , "narrator": "神楽", "text": "本当のことだし"},
        { "location": "2506/TALK"    , "narrator": "神楽", "text": "だから"},
        { "location": "2507/TALK"    , "narrator": "神楽", "text": "$handle$にしかできないお願いをするね？"},
        { "location": "2509/SEL"     , "narrator": "", "text": "何でも言って！"},
        { "location": "2510/SEL"     , "narrator": "", "text": "神楽かわいいなあもう"},
        { "location": "2511/SEL"     , "narrator": "", "text": "$me$に叶えられることかな…"},
        { "location": "2512/ACT"     , "narrator": "", "text": "何でも言って！"},
        { "location": "2514/ACT"     , "narrator": "", "text": "神楽かわいいなあもう"},
        { "location": "2515/TALK"    , "narrator": "神楽", "text": "ｿｯｶﾅ、、、？"},
        { "location": "2516/ACT"     , "narrator": "", "text": "$me$に叶えられることかな…"},
        { "location": "2517/TALK"    , "narrator": "神楽", "text": "大丈夫！"},
        { "location": "2519/TALK"    , "narrator": "神楽", "text": "ぴょんこと一緒にしんでください♪"},
        { "location": "2521/SEL"     , "narrator": "", "text": "はい？"},
        { "location": "2522/SEL"     , "narrator": "", "text": "いやいやいやいや！"},
        { "location": "2523/SEL"     , "narrator": "", "text": "その冗談面白くないよ"},
        { "location": "2524/ACT"     , "narrator": "", "text": "はい？"},
        { "location": "2525/TALK"    , "narrator": "神楽", "text": "ぴょんこと一緒に"},
        { "location": "2526/TALK"    , "narrator": "神楽", "text": "死んでください"},
        { "location": "2527/ACT"     , "narrator": "", "text": "いやいやいやいや！"},
        { "location": "2528/TALK"    , "narrator": "神楽", "text": "ぴょんこからの最後のお願い"},
        { "location": "2529/TALK"    , "narrator": "神楽", "text": "聞いてくれるよね？"},
        { "location": "2530/ACT"     , "narrator": "", "text": "その冗談面白くないよ"},
        { "location": "2531/TALK"    , "narrator": "神楽", "text": "冗談じゃなくて"},
        { "location": "2532/TALK"    , "narrator": "神楽", "text": "本気だから"},
        { "location": "2534/TALK"    , "narrator": "神楽", "text": "ぴょんこが$handle$とできることなんて"},
        { "location": "2535/TALK"    , "narrator": "神楽", "text": "もうこのくらいしか残ってないでしょ？"},
        { "location": "2537/SEL"     , "narrator": "", "text": "他にもいっぱいあるでしょ！？"},
        { "location": "2538/SEL"     , "narrator": "", "text": "厨二ワールド全開すぎるでしょ！"},
        { "location": "2539/SEL"     , "narrator": "", "text": "待って落ち着いて"},
        { "location": "2540/ACT"     , "narrator": "", "text": "他にもいっぱいあるでしょ！？"},
        { "location": "2542/TALK"    , "narrator": "神楽", "text": "ないし"},
        { "location": "2543/TALK"    , "narrator": "神楽", "text": "全然ないし！"},
        { "location": "2544/ACT"     , "narrator": "", "text": "厨二ワールド全開すぎるでしょ！"},
        { "location": "2545/TALK"    , "narrator": "神楽", "text": "そういうのじゃなくて本気"},
        { "location": "2546/TALK"    , "narrator": "神楽", "text": "ガチだから"},
        { "location": "2547/ACT"     , "narrator": "", "text": "待って落ち着いて"},
        { "location": "2548/TALK"    , "narrator": "神楽", "text": "すごく落ち着いてる"},
        { "location": "2549/TALK"    , "narrator": "神楽", "text": "ぴょんこは"},
        { "location": "2552/SEL"     , "narrator": "", "text": "$me$は神楽に生きててほしい"},
        { "location": "2553/SEL"     , "narrator": "", "text": "一緒に生きよう"},
        { "location": "2554/SEL"     , "narrator": "", "text": "死ぬのだけはダメ"},
        { "location": "2555/ACT"     , "narrator": "", "text": "$me$は神楽に生きててほしい"},
        { "location": "2556/TALK"    , "narrator": "神楽", "text": "もう疲れた"},
        { "location": "2557/ACT"     , "narrator": "", "text": "一緒に生きよう"},
        { "location": "2558/TALK"    , "narrator": "神楽", "text": "無理だもん"},
        { "location": "2559/ACT"     , "narrator": "", "text": "死ぬのだけはダメ"},
        { "location": "2560/TALK"    , "narrator": "神楽", "text": "何でそんなこと言うの"},
        { "location": "2562/TALK"    , "narrator": "神楽", "text": "結局$handle$は死ぬのが怖いだけ"},
        { "location": "2563/TALK"    , "narrator": "神楽", "text": "ぴょんこのことなんてどうでもいい"},
        { "location": "2564/TALK"    , "narrator": "神楽", "text": "そうなんでしょ"},
        { "location": "2566/SEL"     , "narrator": "", "text": "神楽が大事だから言うんだよ"},
        { "location": "2567/SEL"     , "narrator": "", "text": "そりゃ怖いけど…"},
        { "location": "2568/SEL"     , "narrator": "", "text": "生きてたらいいことがあるから"},
        { "location": "2569/ACT"     , "narrator": "", "text": "神楽が大事だから言うんだよ"},
        { "location": "2570/TALK"    , "narrator": "神楽", "text": "嘘ばっかり"},
        { "location": "2572/ACT"     , "narrator": "", "text": "そりゃ怖いけど…"},
        { "location": "2573/TALK"    , "narrator": "神楽", "text": "やっぱりそうなんでしょ！？"},
        { "location": "2574/ACT"     , "narrator": "", "text": "生きてたらいいことがあるから"},
        { "location": "2575/TALK"    , "narrator": "神楽", "text": "ないし"},
        { "location": "2576/TALK"    , "narrator": "神楽", "text": "もうないし！！！"},
        { "location": "2578/TALK"    , "narrator": "神楽", "text": "$handle$はぴょんこの何なの？"},
        { "location": "2580/SEL"     , "narrator": "", "text": "恋人"},
        { "location": "2581/SEL"     , "narrator": "", "text": "理解者のつもりだけど"},
        { "location": "2582/SEL"     , "narrator": "", "text": "神楽はどう思ってるの？"},
        { "location": "2583/ACT"     , "narrator": "", "text": "恋人"},
        { "location": "2584/TALK"    , "narrator": "神楽", "text": "でしょ！"},
        { "location": "2585/ACT"     , "narrator": "", "text": "理解者のつもりだけど"},
        { "location": "2586/TALK"    , "narrator": "神楽", "text": "だったら"},
        { "location": "2587/ACT"     , "narrator": "", "text": "神楽はどう思ってるの？"},
        { "location": "2588/TALK"    , "narrator": "神楽", "text": "一番大事な人"},
        { "location": "2589/TALK"    , "narrator": "神楽", "text": "って"},
        { "location": "2590/TALK"    , "narrator": "神楽", "text": "思ってる"},
        { "location": "2591/TALK"    , "narrator": "神楽", "text": "だから"},
        { "location": "2594/TALK"    , "narrator": "神楽", "text": "一緒に死んで"},
        { "location": "2595/TALK"    , "narrator": "神楽", "text": "そうしたらずっと一緒だし"},
        { "location": "2596/TALK"    , "narrator": "神楽", "text": "もう辛いことなんてないし"},
        { "location": "2598/SEL"     , "narrator": "", "text": "その方が辛いよ"},
        { "location": "2599/SEL"     , "narrator": "", "text": "ちょっと深呼吸してみようか"},
        { "location": "2600/SEL"     , "narrator": "", "text": "疲れちゃったんだよね…"},
        { "location": "2601/ACT"     , "narrator": "", "text": "その方が辛いよ"},
        { "location": "2602/TALK"    , "narrator": "神楽", "text": "そんなわけないし！"},
        { "location": "2603/TALK"    , "narrator": "神楽", "text": "楽になるって言うでしょ！！！"},
        { "location": "2604/ACT"     , "narrator": "", "text": "ちょっと深呼吸してみようか"},
        { "location": "2605/TALK"    , "narrator": "神楽", "text": "何でよ"},
        { "location": "2606/TALK"    , "narrator": "神楽", "text": "なだめるつもりなの？"},
        { "location": "2607/ACT"     , "narrator": "", "text": "疲れちゃったんだよね…"},
        { "location": "2608/TALK"    , "narrator": "神楽", "text": "疲れたよ！！！！"},
        { "location": "2609/TALK"    , "narrator": "神楽", "text": "もうどうしようもないほど疲れてるんだよ！！！"},
        { "location": "2610/TALK"    , "narrator": "神楽", "text": "わざわざ聞くな！！！"},
        { "location": "2612/TALK"    , "narrator": "神楽", "text": "もう嫌"},
        { "location": "2613/TALK"    , "narrator": "神楽", "text": "なにもかもがいや"},
        { "location": "2615/TALK"    , "narrator": "神楽", "text": "生きていたくない"},
        { "location": "2616/TALK"    , "narrator": "神楽", "text": "もうしんじゃいたい"},
        { "location": "2617/TALK"    , "narrator": "神楽", "text": "しんじゃいたい"},
        { "location": "2620/SEL"     , "narrator": "", "text": "よしよし"},
        { "location": "2621/SEL"     , "narrator": "", "text": "抱きしめてあげられたらいいのに"},
        { "location": "2622/SEL"     , "narrator": "", "text": "思い切り泣けばいいよ"},
        { "location": "2623/ACT"     , "narrator": "", "text": "よしよし"},
        { "location": "2624/TALK"    , "narrator": "神楽", "text": "あーもー"},
        { "location": "2625/TALK"    , "narrator": "神楽", "text": "あーもー！！！！"},
        { "location": "2626/ACT"     , "narrator": "", "text": "抱きしめてあげられたらいいのに"},
        { "location": "2627/TALK"    , "narrator": "神楽", "text": "ぎゅってしてよ"},
        { "location": "2628/TALK"    , "narrator": "神楽", "text": "痛くて息ができないくらい"},
        { "location": "2629/TALK"    , "narrator": "神楽", "text": "ぎゅってして"},
        { "location": "2630/ACT"     , "narrator": "", "text": "思い切り泣けばいいよ"},
        { "location": "2631/TALK"    , "narrator": "神楽", "text": "うっさい"},
        { "location": "2636/TALK"    , "narrator": "神楽", "text": "$handle$は"},
        { "location": "2637/TALK"    , "narrator": "神楽", "text": "何でぴょんこが生きていた方がいいって思うの"},
        { "location": "2639/SEL"     , "narrator": "", "text": "$me$が嬉しい気持ちになるから"},
        { "location": "2640/SEL"     , "narrator": "", "text": "この先いいことが絶対あるから"},
        { "location": "2641/SEL"     , "narrator": "", "text": "死んでほしくないから"},
        { "location": "2642/ACT"     , "narrator": "", "text": "$me$が嬉しい気持ちになるから"},
        { "location": "2643/TALK"    , "narrator": "神楽", "text": "何それ"},
        { "location": "2644/TALK"    , "narrator": "神楽", "text": "自分のことばっかり"},
        { "location": "2645/ACT"     , "narrator": "", "text": "この先いいことが絶対あるから"},
        { "location": "2646/TALK"    , "narrator": "神楽", "text": "相変わらず"},
        { "location": "2648/TALK"    , "narrator": "神楽", "text": "適当すぎ"},
        { "location": "2649/ACT"     , "narrator": "", "text": "死んでほしくないから"},
        { "location": "2650/TALK"    , "narrator": "神楽", "text": "そんなの答えじゃないし"},
        { "location": "2653/TALK"    , "narrator": "神楽", "text": "$handle$のバーカ"},
        { "location": "2654/TALK"    , "narrator": "神楽", "text": "ぜんぜん私のことわかってないじゃん"},
        { "location": "2655/TALK"    , "narrator": "神楽", "text": "わｋｔてるならいまっこにいて"},
        { "location": "2656/TALK"    , "narrator": "神楽", "text": "なんで"},
        { "location": "2657/TALK"    , "narrator": "神楽", "text": "どうしｔ"},
        { "location": "2658/TALK"    , "narrator": "神楽", "text": "きらい"},
        { "location": "2661/TALK"    , "narrator": "ボイスメール", "text": "青空の下で"},
        { "location": "2673/DIALOG"  , "narrator": "Dialog_GETVoice", "text": "<color=green>【神楽】</color>のボイスメール\n<color=red>【青空の下で】</color>\nをゲットしました！"}
    ]
}
