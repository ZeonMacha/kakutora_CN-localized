        "title": "005 メインストーリー",
        "sub_title": "非携帯とは何事か＜後編＞"
    },
    "entry":
    [
        { "location": "488/SCENARIO", "narrator": "", "text": "しばしさらば"},
        { "location": "502/TALK"    , "narrator": "みやび", "text": "いやいや。\n願いは口に出せ\n言うしね。"},
        { "location": "503/TALK"    , "narrator": "みやび", "text": "ここしばらくの\n超展開ぶりから\n叶わぬ願いではない。"},
        { "location": "510/TALK"    , "narrator": "みやび", "text": "$handle$と\n一緒にここに\n戻れますように。"},
        { "location": "511/SEL"     , "narrator": "", "text": "それって…二人で？"},
        { "location": "512/SEL"     , "narrator": "", "text": "もしかしてリアルに？"},
        { "location": "513/SEL"     , "narrator": "", "text": "物理的な話として？"},
        { "location": "514/ACT"     , "narrator": "", "text": "それって…二人で？"},
        { "location": "515/ACT"     , "narrator": "", "text": "もしかしてリアルに？"},
        { "location": "516/ACT"     , "narrator": "", "text": "物理的な話として？"},
        { "location": "533/TALK"    , "narrator": "みやび", "text": "おう"},
        { "location": "534/TALK"    , "narrator": "みやび", "text": "当然じゃ"},
        { "location": "535/TALK"    , "narrator": "みやび", "text": "ばかちんが"},
        { "location": "537/SEL"     , "narrator": "", "text": "うれしいな"},
        { "location": "538/SEL"     , "narrator": "", "text": "本当に大変なことになってるんだ"},
        { "location": "539/SEL"     , "narrator": "", "text": "本気なんだよね？"},
        { "location": "540/ACT"     , "narrator": "", "text": "うれしいな"},
        { "location": "541/TALK"    , "narrator": "みやび", "text": "それは"},
        { "location": "542/TALK"    , "narrator": "みやび", "text": "よかった"},
        { "location": "543/TALK"    , "narrator": "みやび", "text": "ホッとした"},
        { "location": "544/ACT"     , "narrator": "", "text": "本当に大変なことになってるんだ"},
        { "location": "545/TALK"    , "narrator": "みやび", "text": "こらこら"},
        { "location": "546/TALK"    , "narrator": "みやび", "text": "ピンときてなかったのか"},
        { "location": "547/TALK"    , "narrator": "みやび", "text": "$handle$め"},
        { "location": "548/ACT"     , "narrator": "", "text": "本気なんだよね？"},
        { "location": "549/TALK"    , "narrator": "みやび", "text": "嘘でこんなことを言えるのは"},
        { "location": "550/TALK"    , "narrator": "みやび", "text": "結婚詐欺師か"},
        { "location": "551/TALK"    , "narrator": "みやび", "text": "乙女ゲーのヒーローしかおらん"},
        { "location": "553/TALK"    , "narrator": "みやび", "text": "というわけで"},
        { "location": "554/TALK"    , "narrator": "みやび", "text": "第一希望は"},
        { "location": "555/TALK"    , "narrator": "みやび", "text": "相棒とここに戻ってくる、だが"},
        { "location": "556/TALK"    , "narrator": "みやび", "text": "それより確率の高い話をしたい"},
        { "location": "558/SEL"     , "narrator": "", "text": "何？"},
        { "location": "559/SEL"     , "narrator": "", "text": "聞きたくない話のような"},
        { "location": "560/SEL"     , "narrator": "", "text": "何でも言って！"},
        { "location": "561/ACT"     , "narrator": "", "text": "何？"},
        { "location": "562/TALK"    , "narrator": "みやび", "text": "ええと"},
        { "location": "563/ACT"     , "narrator": "", "text": "聞きたくない話のような"},
        { "location": "564/TALK"    , "narrator": "みやび", "text": "かもしれん"},
        { "location": "565/ACT"     , "narrator": "", "text": "何でも言って！"},
        { "location": "566/TALK"    , "narrator": "みやび", "text": "これは頼もしい"},
        { "location": "568/TALK"    , "narrator": "みやび", "text": "うちが亡き後は"},
        { "location": "569/TALK"    , "narrator": "みやび", "text": "この部屋の権利を"},
        { "location": "570/TALK"    , "narrator": "みやび", "text": "$handle$に譲る"},
        { "location": "571/TALK"    , "narrator": "みやび", "text": "やき"},
        { "location": "572/TALK"    , "narrator": "みやび", "text": "この部屋に残したデータは"},
        { "location": "573/TALK"    , "narrator": "みやび", "text": "全部消してくれ"},
        { "location": "574/TALK"    , "narrator": "みやび", "text": "絶対に"},
        { "location": "576/SEL"     , "narrator": "", "text": "了解"},
        { "location": "577/SEL"     , "narrator": "", "text": "そんなことにならないよね？"},
        { "location": "578/SEL"     , "narrator": "", "text": "気が向いたらね"},
        { "location": "579/ACT"     , "narrator": "", "text": "了解"},
        { "location": "580/TALK"    , "narrator": "みやび", "text": "感謝する"},
        { "location": "581/ACT"     , "narrator": "", "text": "そんなことにならないよね？"},
        { "location": "582/TALK"    , "narrator": "みやび", "text": "ならよいが"},
        { "location": "583/ACT"     , "narrator": "", "text": "気が向いたらね"},
        { "location": "584/TALK"    , "narrator": "みやび", "text": "適当なやつめ"},
        { "location": "587/SEL"     , "narrator": "", "text": "それはそれとして"},
        { "location": "588/ACT"     , "narrator": "", "text": "それはそれとして"},
        { "location": "589/TALK"    , "narrator": "みやび", "text": "うむ"},
        { "location": "592/SEL"     , "narrator": "", "text": "つばめが大変なことに"},
        { "location": "593/SEL"     , "narrator": "", "text": "つばめ逃げ遅れたみたい"},
        { "location": "594/SEL"     , "narrator": "", "text": "今一番危機にあるのはつばめ"},
        { "location": "595/ACT"     , "narrator": "", "text": "データって$me$のセクシーショット？"},
        { "location": "596/TALK"    , "narrator": "みやび", "text": "なんでだ！"},
        { "location": "599/ACT"     , "narrator": "", "text": "$me$の隠し撮り画像なんでしょ、データって"},
        { "location": "600/TALK"    , "narrator": "みやび", "text": "どうやって！"},
        { "location": "603/ACT"     , "narrator": "", "text": "$me$への恋文なら全世界にアーカイブしよう"},
        { "location": "604/TALK"    , "narrator": "みやび", "text": "ないわーマジでないわー"},
        { "location": "608/TALK"    , "narrator": "みやび", "text": "本当に"},
        { "location": "609/TALK"    , "narrator": "みやび", "text": "$handle$はどこまでも$handle$"},
        { "location": "610/TALK"    , "narrator": "みやび", "text": "しかしそのおかげで"},
        { "location": "611/TALK"    , "narrator": "みやび", "text": "少し元気が出た"},
        { "location": "626/TALK"    , "narrator": "みやび", "text": "お。"},
        { "location": "627/TALK"    , "narrator": "みやび", "text": "お迎えが来たぞね。"},
        { "location": "650/TALK"    , "narrator": "アーヤ", "text": "みやび！"},
        { "location": "652/TALK"    , "narrator": "みやび", "text": "待たせて\nすまんかったぞね。"},
        { "location": "653/TALK"    , "narrator": "アーヤ", "text": "大丈夫？\n忘れ物ない？"},
        { "location": "654/TALK"    , "narrator": "みやび", "text": "もうえいよ。\n忘れ物は全部\n回収したきね。"},
        { "location": "656/TALK"    , "narrator": "みやび", "text": "物理的なんも、\n精神的なんも…。"},
        { "location": "667/DIALOG"  , "narrator": "Dialog_chapter_ch04", "text": "【MV EXE_KAGURa】"}
    ]
}
