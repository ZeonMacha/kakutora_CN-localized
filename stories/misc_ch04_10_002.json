        "title": "Extra004 ヒメゴトチャット",
        "sub_title": "体温はHDDにあり"
    },
    "entry":
    [
        { "location": "92/SCENARIO", "narrator": "", "text": "05_000_体温はHDDにあり"},
        { "location": "117/TALK"   , "narrator": "みやび", "text": "手仕事やらなんやらより"},
        { "location": "118/TALK"   , "narrator": "みやび", "text": "量産型に魅力を感じるのは"},
        { "location": "119/TALK"   , "narrator": "みやび", "text": "何故なのだろう"},
        { "location": "121/SEL"    , "narrator": "", "text": "デジタルネイティブだから"},
        { "location": "122/SEL"    , "narrator": "", "text": "没個性こそ美徳"},
        { "location": "123/SEL"    , "narrator": "", "text": "安定性と入手のたやすさを重視した結論"},
        { "location": "124/ACT"    , "narrator": "", "text": "デジタルネイティブだから"},
        { "location": "125/TALK"   , "narrator": "みやび", "text": "ひとくくりか"},
        { "location": "126/ACT"    , "narrator": "", "text": "没個性こそ美徳"},
        { "location": "127/TALK"   , "narrator": "みやび", "text": "日本人の思考か"},
        { "location": "128/TALK"   , "narrator": "みやび", "text": "コピー＆ペースト時代の弊害か"},
        { "location": "129/ACT"    , "narrator": "", "text": "安定性と入手のたやすさを重視した結論"},
        { "location": "131/TALK"   , "narrator": "みやび", "text": "左様"},
        { "location": "132/TALK"   , "narrator": "みやび", "text": "デファクトスタンダードには意味があり"},
        { "location": "133/TALK"   , "narrator": "みやび", "text": "常に同じ環境を用意できるということは"},
        { "location": "134/TALK"   , "narrator": "みやび", "text": "パフォーマンスの向上につながるのだ"},
        { "location": "135/TALK"   , "narrator": "みやび", "text": "さすがじゃの相棒"},
        { "location": "137/TALK"   , "narrator": "みやび", "text": "そもそも温もりとか体温とか言うならば"},
        { "location": "138/TALK"   , "narrator": "みやび", "text": "HDDから出る熱で充分だと思わんか"},
        { "location": "140/SEL"    , "narrator": "", "text": "えー……"},
        { "location": "141/SEL"    , "narrator": "", "text": "その通り"},
        { "location": "142/SEL"    , "narrator": "", "text": "いやちょっと考えさせて"},
        { "location": "143/ACT"    , "narrator": "", "text": "えー……"},
        { "location": "144/TALK"   , "narrator": "みやび", "text": "おや"},
        { "location": "145/TALK"   , "narrator": "みやび", "text": "不満そうじゃの"},
        { "location": "146/ACT"    , "narrator": "", "text": "その通り"},
        { "location": "147/TALK"   , "narrator": "みやび", "text": "ほう"},
        { "location": "148/TALK"   , "narrator": "みやび", "text": "これはまた"},
        { "location": "149/ACT"    , "narrator": "", "text": "いやちょっと考えさせて"},
        { "location": "150/TALK"   , "narrator": "みやび", "text": "いやいや"},
        { "location": "151/TALK"   , "narrator": "みやび", "text": "考えるまでもなかろう"},
        { "location": "153/TALK"   , "narrator": "みやび", "text": "そうは言っても"},
        { "location": "154/TALK"   , "narrator": "みやび", "text": "量産型の着物などは味気ない"},
        { "location": "155/TALK"   , "narrator": "みやび", "text": "手仕事だからこそ意味があるものもある"},
        { "location": "156/TALK"   , "narrator": "みやび", "text": "そのあたりは"},
        { "location": "157/TALK"   , "narrator": "みやび", "text": "重々承知ちや"}
    ]
}
