{
    "dir": "chap10/daydra/dd_ch04_10_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "10402",
        "cid": "miyabi",
        "title": "002 メインストーリー",
        "sub_title": "遊んでるわけやない＜前編＞"
    },
    "entry":
    [
        { "location": "8/SCENARIO", "narrator": "", "text": "遊んでるわけやない"},
        { "location": "32/TALK"   , "narrator": "真幌", "text": "これが今日入荷した\nフィルムだ。\nすぐに整理してくれ。"},
        { "location": "35/TALK"   , "narrator": "みやび", "text": "五本も入荷したが\nですか？\n珍しく多いですね。"},
        { "location": "36/TALK"   , "narrator": "真幌", "text": "とある好事家から、\n色々あって手に入れた\n超レア物なんだ。"},
        { "location": "38/TALK"   , "narrator": "みやび", "text": "…そうですか。"},
        { "location": "40/TALK"   , "narrator": "真幌", "text": "そうだ。\nつまり、何を言いたい\nかというと――"},
        { "location": "41/TALK"   , "narrator": "真幌", "text": "絶対にキズとか\nつけたりするなよ？\nしたら弁償だぞ？"},
        { "location": "44/TALK"   , "narrator": "みやび", "text": "褒められませんがよ。\nそんな責任、バイトに\n押し付けるゆうんは。"},
        { "location": "45/TALK"   , "narrator": "真幌", "text": "文句を言うな。\n任せるのが逢瀬達なら\nこんなことは言わん。"},
        { "location": "46/TALK"   , "narrator": "真幌", "text": "だが、おまえは\n特にズボラだからな。"},
        { "location": "47/TALK"   , "narrator": "真幌", "text": "鞭を与えておかんと、\n適当なことをする\n可能性が捨てきれん。"},
        { "location": "48/TALK"   , "narrator": "みやび", "text": "…………。"},
        { "location": "68/TALK"   , "narrator": "みやび", "text": "…まほさん、\n鏡を見たことないが？"},
        { "location": "70/TALK"   , "narrator": "みやび", "text": "まほさんの方が、\nうちの数倍ズボラや\nっちゅうに…。"},
        { "location": "71/TALK"   , "narrator": "みやび", "text": "しっかし、何でこんな\nよくわからん白黒映画\n集めちょるが？"},
        { "location": "72/TALK"   , "narrator": "みやび", "text": "こんなもん\n上映したって、\n客なんぞ来ない――"},
        { "location": "73/TALK"   , "narrator": "みやび", "text": "いや、来られたら\n困るのか。"},
        { "location": "74/TALK"   , "narrator": "みやび", "text": "人に来られても\n困るし、営業せんでも\nやはり困る…。"},
        { "location": "75/TALK"   , "narrator": "みやび", "text": "今更やけんど、\n面倒な映画館やね。"},
        { "location": "76/TALK"   , "narrator": "みやび", "text": "このフィルムも、\n聞いたことない\n映画やし…ん？"},
        { "location": "77/TALK"   , "narrator": "みやび", "text": "この映像…、\n知ってるぞ？\n確かどこかで…。"},
        { "location": "79/TALK"   , "narrator": "みやび", "text": "う～ん……。"},
        { "location": "84/TALK"   , "narrator": "みやび", "text": "緊急事態"},
        { "location": "85/TALK"   , "narrator": "みやび", "text": "今見た映画の映像"},
        { "location": "86/TALK"   , "narrator": "みやび", "text": "どっかで見たことある"},
        { "location": "87/TALK"   , "narrator": "みやび", "text": "けど"},
        { "location": "88/TALK"   , "narrator": "みやび", "text": "思い出せん"},
        { "location": "89/TALK"   , "narrator": "みやび", "text": "検索頼む"},
        { "location": "91/SEL"    , "narrator": "", "text": "さすがに画像見ないとわからない"},
        { "location": "92/SEL"    , "narrator": "", "text": "ガッテン姉貴！"},
        { "location": "93/ACT"    , "narrator": "", "text": "さすがに画像見ないとわからない"},
        { "location": "94/TALK"   , "narrator": "みやび", "text": "面倒くさい"},
        { "location": "96/TALK"   , "narrator": "みやび", "text": "自分で調べよ"},
        { "location": "98/SEL"    , "narrator": "", "text": "そう言わずに、見せて"},
        { "location": "99/SEL"    , "narrator": "", "text": "無理なので諦めます"},
        { "location": "100/ACT"   , "narrator": "", "text": "そう言わずに、見せて"},
        { "location": "103/TALK"  , "narrator": "みやび", "text": "仕方のないヤツめ"},
        { "location": "104/TALK"  , "narrator": "みやび", "text": "うちの優しさに震えよ"},
        { "location": "106/TALK"  , "narrator": "みやび", "text": "見せたぞ"},
        { "location": "107/TALK"  , "narrator": "みやび", "text": "すっと検索せよ"},
        { "location": "110/SEL"   , "narrator": "", "text": "これだけじゃ不可能だ"},
        { "location": "111/ACT"   , "narrator": "", "text": "これだけじゃ不可能だ"},
        { "location": "113/TALK"  , "narrator": "みやび", "text": "ここまでさせといてそれか？"},
        { "location": "114/TALK"  , "narrator": "みやび", "text": "期待はしとらんかったが"},
        { "location": "115/ACT"   , "narrator": "", "text": "無理なので諦めます"},
        { "location": "116/TALK"  , "narrator": "みやび", "text": "うむ"},
        { "location": "117/TALK"  , "narrator": "みやび", "text": "期待しとらんかったき"},
        { "location": "118/TALK"  , "narrator": "みやび", "text": "それでえいよ"},
        { "location": "120/ACT"   , "narrator": "", "text": "ガッテン姉貴"},
        { "location": "121/TALK"  , "narrator": "みやび", "text": "マジか"},
        { "location": "123/TALK"  , "narrator": "みやび", "text": "じゃあ"},
        { "location": "124/TALK"  , "narrator": "みやび", "text": "どれくらいで検索できる？"},
        { "location": "126/SEL"   , "narrator": "", "text": "一瞬"},
        { "location": "127/SEL"   , "narrator": "", "text": "１０分"},
        { "location": "128/SEL"   , "narrator": "", "text": "１０年"},
        { "location": "129/ACT"   , "narrator": "", "text": "一瞬"},
        { "location": "130/TALK"  , "narrator": "みやび", "text": "一瞬なら"},
        { "location": "131/TALK"  , "narrator": "みやび", "text": "一瞬と答える前に"},
        { "location": "132/TALK"  , "narrator": "みやび", "text": "検索結果を出しぃ"},
        { "location": "133/TALK"  , "narrator": "みやび", "text": "そして未だに出てこない"},
        { "location": "134/TALK"  , "narrator": "みやび", "text": "慰謝料は気持ち程度でえいぞ"},
        { "location": "136/TALK"  , "narrator": "みやび", "text": "ハワイ旅行７泊８日程度でな"},
        { "location": "137/ACT"   , "narrator": "", "text": "１０分"},
        { "location": "138/TALK"  , "narrator": "みやび", "text": "遅くも早くもない"},
        { "location": "139/TALK"  , "narrator": "みやび", "text": "微妙な時間やけんど"},
        { "location": "140/TALK"  , "narrator": "みやび", "text": "ストレス溜まって"},
        { "location": "141/TALK"  , "narrator": "みやび", "text": "どうでもよくなるには"},
        { "location": "142/TALK"  , "narrator": "みやび", "text": "十分過ぎる時間や"},
        { "location": "143/TALK"  , "narrator": "みやび", "text": "この疑問"},
        { "location": "145/TALK"  , "narrator": "みやび", "text": "迷宮入り！"},
        { "location": "146/ACT"   , "narrator": "", "text": "１０年"},
        { "location": "147/TALK"  , "narrator": "みやび", "text": "駄菓子屋のおじちゃんか？"},
        { "location": "148/TALK"  , "narrator": "みやび", "text": "１００円の物を１００万円っちゅう"},
        { "location": "149/TALK"  , "narrator": "みやび", "text": "つまり渡すのは"},
        { "location": "150/TALK"  , "narrator": "みやび", "text": "１０秒でえいな？"},
        { "location": "151/TALK"  , "narrator": "みやび", "text": "ほれ、１０、９、８、７、６"},
        { "location": "152/TALK"  , "narrator": "みやび", "text": "５、４、３、２、１"},
        { "location": "153/TALK"  , "narrator": "みやび", "text": "ウソつき確定！"},
        { "location": "154/TALK"  , "narrator": "みやび", "text": "１０年反省しぃ"},
        { "location": "157/TALK"  , "narrator": "みやび", "text": "いや待て"},
        { "location": "159/TALK"  , "narrator": "みやび", "text": "思い出した！"},
        { "location": "164/TALK"  , "narrator": "みやび", "text": "確か、こんな感じの\n名前だったか？"},
        { "location": "170/TALK"  , "narrator": "みやび", "text": "あった、これや！\nこのサイトやったかー。"},
        { "location": "171/TALK"  , "narrator": "みやび", "text": "しっかし、誰がこんな\nサイト運営しちょるか。"},
        { "location": "172/TALK"  , "narrator": "みやび", "text": "…まさか、まほさんの\n言うてた好事家って――"},
        { "location": "173/TALK"  , "narrator": "みやび", "text": "こいつらと\n関係あるんかいな？"},
        { "location": "174/SEL"   , "narrator": "", "text": "一人で楽しまないで"},
        { "location": "175/ACT"   , "narrator": "", "text": "一人で楽しまないで"},
        { "location": "183/TALK"  , "narrator": "みやび", "text": "いやー"},
        { "location": "185/TALK"  , "narrator": "みやび", "text": "それはムリな話や"},
        { "location": "186/TALK"  , "narrator": "みやび", "text": "チャットじゃ見せられん"},
        { "location": "189/SEL"   , "narrator": "", "text": "また画像送ってよ"},
        { "location": "190/ACT"   , "narrator": "", "text": "また画像送ってよ"},
        { "location": "192/TALK"  , "narrator": "みやび", "text": "くだらんこと覚えよって"},
        { "location": "194/SEL"   , "narrator": "", "text": "画像送ってよ"},
        { "location": "195/ACT"   , "narrator": "", "text": "画像送ってよ"},
        { "location": "199/TALK"  , "narrator": "みやび", "text": "これな"},
        { "location": "201/TALK"  , "narrator": "みやび", "text": "イケてないサイトやろ？"},
        { "location": "207/TALK"  , "narrator": "みやび", "text": "どっかのマニアが管理しちょる"},
        { "location": "209/TALK"  , "narrator": "みやび", "text": "トライナリーファンサイトや"},
        { "location": "210/TALK"  , "narrator": "みやび", "text": "トライナリーは身バレ厳禁"},
        { "location": "211/TALK"  , "narrator": "みやび", "text": "つまり"},
        { "location": "212/TALK"  , "narrator": "みやび", "text": "学校以外の人間は誰も知らん"},
        { "location": "213/TALK"  , "narrator": "みやび", "text": "けんど"},
        { "location": "214/TALK"  , "narrator": "みやび", "text": "何故か年頃の女の子が戦っちょるゆうんは"},
        { "location": "215/TALK"  , "narrator": "みやび", "text": "公然の秘密みたいな感じで出回っとる"},
        { "location": "216/TALK"  , "narrator": "みやび", "text": "下らんサイトが乱立するんは"},
        { "location": "217/TALK"  , "narrator": "みやび", "text": "この噂が原因や"},
        { "location": "218/TALK"  , "narrator": "みやび", "text": "例えば"},
        { "location": "219/TALK"  , "narrator": "みやび", "text": "トライナリーの正体は"},
        { "location": "220/TALK"  , "narrator": "みやび", "text": "あの有名地下アイドルだった！"},
        { "location": "221/TALK"  , "narrator": "みやび", "text": "…アホかと"},
        { "location": "223/TALK"  , "narrator": "みやび", "text": "そんなクソ情報"},
        { "location": "224/TALK"  , "narrator": "みやび", "text": "どこから手に入れるのか？"},
        { "location": "226/SEL"   , "narrator": "", "text": "実際やったら売れそう"},
        { "location": "227/ACT"   , "narrator": "", "text": "実際やったら売れそう"},
        { "location": "229/TALK"  , "narrator": "みやび", "text": "は？"},
        { "location": "231/TALK"  , "narrator": "みやび", "text": "ありえん"},
        { "location": "232/TALK"  , "narrator": "みやび", "text": "アイドルキャラ作るなんぞ"},
        { "location": "233/TALK"  , "narrator": "みやび", "text": "面倒臭過ぎる"},
        { "location": "234/TALK"  , "narrator": "みやび", "text": "今でもキャラ作っちょるっちゅうに"},
        { "location": "235/TALK"  , "narrator": "みやび", "text": "しかもうちには合わん"},
        { "location": "237/SEL"   , "narrator": "", "text": "素でやればいいじゃん"},
        { "location": "238/ACT"   , "narrator": "", "text": "素でやればいいじゃん"},
        { "location": "241/TALK"  , "narrator": "みやび", "text": "ありえん"},
        { "location": "243/TALK"  , "narrator": "みやび", "text": "あほらしい"},
        { "location": "289/TALK"  , "narrator": "みやび", "text": "お、来よったか。\nはよ、はよ。"},
        { "location": "302/TALK"  , "narrator": "みやび", "text": "あいたっ！"},
        { "location": "305/TALK"  , "narrator": "みやび", "text": "きゃあー"},
        { "location": "308/TALK"  , "narrator": "みやび", "text": "はあっ！"},
        { "location": "314/TALK"  , "narrator": "みやび", "text": "みやびさん\n２ポイントゲット。"},
        { "location": "315/SEL"   , "narrator": "", "text": "なんですかそれ"},
        { "location": "316/ACT"   , "narrator": "", "text": "なんですかそれ"},
        { "location": "318/TALK"  , "narrator": "みやび", "text": "おさわりポイントや。"},
        { "location": "319/TALK"  , "narrator": "みやび", "text": "これからお前さんが\nうちを触るたびに\nポイントが加算され――"},
        { "location": "320/TALK"  , "narrator": "みやび", "text": "貯まるとなんと！\nみやびさんがお前さんに\n何かをねだる！"},
        { "location": "321/SEL"   , "narrator": "", "text": "何ポイントでねだるの？"},
        { "location": "322/SEL"   , "narrator": "", "text": "何をねだるの？"},
        { "location": "323/ACT"   , "narrator": "", "text": "何ポイントでねだるの？"},
        { "location": "324/ACT"   , "narrator": "", "text": "何をねだるの？"},
        { "location": "326/TALK"  , "narrator": "みやび", "text": "さあね。\nキマグレやき。"},
        { "location": "327/TALK"  , "narrator": "みやび", "text": "明日本マグロを\nねだるかもしれんし、\n１年後に指輪かもしれん。"},
        { "location": "328/SEL"   , "narrator": "", "text": "随分高価ですね…"},
        { "location": "329/SEL"   , "narrator": "", "text": "そんなキマグレじゃポイント意味なくね？"},
        { "location": "330/ACT"   , "narrator": "", "text": "随分高価ですね…"},
        { "location": "331/TALK"  , "narrator": "みやび", "text": "うちを触りゆうは\nそうゆうことやき。"},
        { "location": "332/ACT"   , "narrator": "", "text": "そんなキマグレじゃポイント意味なくね？"},
        { "location": "333/TALK"  , "narrator": "みやび", "text": "うちが暇つぶしに\n盛り上がる為に\n意味がある！"},
        { "location": "335/TALK"  , "narrator": "みやび", "text": "…と、そんなことより、\nそろそろ仕事を\nさせてもらえんかね。"},
        { "location": "336/SEL"   , "narrator": "", "text": "ど、どうぞ……"},
        { "location": "337/ACT"   , "narrator": "", "text": "ど、どうぞ……"},
        { "location": "341/TALK"  , "narrator": "みやび", "text": "まったく、お前さんは\nすぐに脇道に逸れるき\n仕事が全然進まんちや。"},
        { "location": "342/SEL"   , "narrator": "", "text": "えー…"},
        { "location": "343/SEL"   , "narrator": "", "text": "前回「仕事ばかり」だって言ってたから、いい潤いになったでしょ？"},
        { "location": "344/ACT"   , "narrator": "", "text": "えー…"},
        { "location": "345/TALK"  , "narrator": "みやび", "text": "なんぞ？"},
        { "location": "346/ACT"   , "narrator": "", "text": "前回「仕事ばかり」だって言ってたから、いい潤いになったでしょ？"},
        { "location": "349/TALK"  , "narrator": "みやび", "text": "否！\nそれはまた別やき。"},
        { "location": "350/TALK"  , "narrator": "みやび", "text": "えいか。うちがゆうたがは\n仕事が無い状態で戯れたい\nっちゅうことや。"},
        { "location": "351/TALK"  , "narrator": "みやび", "text": "仕事が目の前にあったら\n思う存分楽しめんぞね。"},
        { "location": "352/SEL"   , "narrator": "", "text": "戯れたいんですか！？"},
        { "location": "353/ACT"   , "narrator": "", "text": "戯れたいんですか！？"},
        { "location": "356/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "357/TALK"  , "narrator": "みやび", "text": "そんなことは\n言っちょらんがね。"},
        { "location": "359/TALK"  , "narrator": "みやび", "text": "ほれ、\nまた横道に逸れる！\nもう先に進むぞね！"},
        { "location": "366/TALK"  , "narrator": "みやび", "text": "オープンプロセス、\n0x815番地から\n0x2CC番地へ。"},
        { "location": "388/TALK"  , "narrator": "みやび", "text": "完了。"},
        { "location": "390/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "392/TALK"  , "narrator": "みやび", "text": "………。"},
        { "location": "393/TALK"  , "narrator": "みやび", "text": "………だが断る！"},
        { "location": "394/SEL"   , "narrator": "", "text": "な、何を！？"},
        { "location": "395/ACT"   , "narrator": "", "text": "な、何を！？"},
        { "location": "397/TALK"  , "narrator": "みやび", "text": "どうせアイドルユニットを\n結成するための一押しを\n期待しちゅうがやろ？"},
        { "location": "398/SEL"   , "narrator": "", "text": "まさかそんな…"},
        { "location": "399/SEL"   , "narrator": "", "text": "みやびのアイドル姿が見たい"},
        { "location": "400/ACT"   , "narrator": "", "text": "まさかそんな…"},
        { "location": "401/TALK"  , "narrator": "みやび", "text": "ふむ。\nならばよいが。"},
        { "location": "402/ACT"   , "narrator": "", "text": "みやびのアイドル姿が見たい"},
        { "location": "403/TALK"  , "narrator": "みやび", "text": "やはりか！\nだが断る！！"},
        { "location": "404/SEL"   , "narrator": "", "text": "ですよねー"},
        { "location": "405/SEL"   , "narrator": "", "text": "そこを何とか！"},
        { "location": "406/ACT"   , "narrator": "", "text": "ですよねー"},
        { "location": "408/TALK"  , "narrator": "みやび", "text": "あたりまえや。\n全く、仕方のないやつめ。"},
        { "location": "409/ACT"   , "narrator": "", "text": "そこを何とか！"},
        { "location": "410/TALK"  , "narrator": "みやび", "text": "死んでもやらん。"},
        { "location": "411/SEL"   , "narrator": "", "text": "松"},
        { "location": "412/SEL"   , "narrator": "", "text": "素直にやめる"},
        { "location": "413/ACT"   , "narrator": "", "text": "松"},
        { "location": "414/TALK"  , "narrator": "みやび", "text": "なんぞ松っちゅうんは…"},
        { "location": "433/TALK"  , "narrator": "みやび", "text": "……ん？"},
        { "location": "435/TALK"  , "narrator": "みやび", "text": "ふわあっ！\nこれはなんぞね！！"},
        { "location": "445/TALK"  , "narrator": "みやび", "text": "ま、まさか\nうちがこんなことを！"},
        { "location": "455/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "456/TALK"  , "narrator": "みやび", "text": "なんでこんなことを\nせないかんちや！"},
        { "location": "466/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "468/TALK"  , "narrator": "みやび", "text": "デレッ♪"},
        { "location": "485/TALK"  , "narrator": "みやび", "text": "さて。\nどうゆうことなのか\n説明してもらうぞね。"},
        { "location": "486/SEL"   , "narrator": "", "text": "説明も何も「松」っての押しただけですけど"},
        { "location": "487/SEL"   , "narrator": "", "text": "みやびだってノリノリだったじゃん"},
        { "location": "488/ACT"   , "narrator": "", "text": "説明も何も「松」っての押しただけですけど"},
        { "location": "490/TALK"  , "narrator": "みやび", "text": "「松」ってのを押した？\nなんぞ、そのボタン押し\nちゅうような言い方は。"},
        { "location": "491/TALK"  , "narrator": "みやび", "text": "まあえい。"},
        { "location": "492/TALK"  , "narrator": "みやび", "text": "お前さんは色々\n謎なことをやりゆうき、\nやはり要注意やね。"},
        { "location": "493/ACT"   , "narrator": "", "text": "みやびだってノリノリだったじゃん"},
        { "location": "495/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "496/TALK"  , "narrator": "みやび", "text": "うちは、どうせやるなら\n全力でやるっちゅう\nポリシーがあるだけや。"},
        { "location": "498/TALK"  , "narrator": "みやび", "text": "別にお前さんとは\n全然関係ないわ。"},
        { "location": "500/TALK"  , "narrator": "みやび", "text": "ほれ！\nまた脱線したちや！"},
        { "location": "501/TALK"  , "narrator": "みやび", "text": "うちの葛藤を\n解消しに来たがやろ。\n本題に移るぞね。"},
        { "location": "502/ACT"   , "narrator": "", "text": "素直にやめる"},
        { "location": "503/TALK"  , "narrator": "みやび", "text": "ふむ。\n当然の判断や。"},
        { "location": "507/TALK"  , "narrator": "みやび", "text": "今回のうちからの願いは、\n調査を諦めんよう、一押し\nして欲しいという事や。"},
        { "location": "508/SEL"   , "narrator": "", "text": "そんなに重要な調査なの？"},
        { "location": "509/ACT"   , "narrator": "", "text": "そんなに重要な調査なの？"},
        { "location": "511/TALK"  , "narrator": "みやび", "text": "うむ。"},
        { "location": "512/TALK"  , "narrator": "みやび", "text": "だいぶ主題が逸れちゅう\nけんど、本来の目的は\nファンサイトではない。"},
        { "location": "513/TALK"  , "narrator": "みやび", "text": "まほさんのフィルムの\n出所調査こそが、やり遂げ\nねばならん任務やき。"},
        { "location": "514/SEL"   , "narrator": "", "text": "あーそういえばそうだったね"},
        { "location": "515/ACT"   , "narrator": "", "text": "あーそういえばそうだったね"},
        { "location": "518/TALK"  , "narrator": "みやび", "text": "忘れちょったか。\n情けない相棒ぞね…。"},
        { "location": "519/TALK"  , "narrator": "みやび", "text": "ともあれ、ここで諦めると\n今後のうちにとって\n大変よくない事になる。"},
        { "location": "520/TALK"  , "narrator": "みやび", "text": "敗北こそ\n最強の枯葉剤やき。"},
        { "location": "521/TALK"  , "narrator": "みやび", "text": "うちを枯らさぬよう\n最善を尽くせ、相棒。"},
        { "location": "522/TALK"  , "narrator": "みやび", "text": "うちと$handle$に\nえいココロの旅を。"},
        { "location": "16/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>6月10日　5:29 PM</color>\nとある平日の午後、神楽坂トライナリーでのバイトの最中のこと。"},
        { "location": "257/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
