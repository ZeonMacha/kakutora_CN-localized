    "entry":
    [
        { "location": "269/SCENARIO", "narrator": "", "text": "彼氏の役目"},
        { "location": "280/TALK"    , "narrator": "アーヤ", "text": "うーん…、\nどれがいいかしら？"},
        { "location": "281/TALK"    , "narrator": "アーヤ", "text": "これは前に着たし、\nこっちのは今回はちょっと\n合わない気がするし…。"},
        { "location": "282/TALK"    , "narrator": "アーヤ", "text": "…作る？"},
        { "location": "283/TALK"    , "narrator": "アーヤ", "text": "いやいや、無理でしょ。\n今からじゃさすがに時間も\n足りないし…。"},
        { "location": "285/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "297/TALK"    , "narrator": "アーヤ", "text": "$handle$さん"},
        { "location": "298/TALK"    , "narrator": "アーヤ", "text": "相談があるんだけど"},
        { "location": "299/TALK"    , "narrator": "アーヤ", "text": "今って平気？ヾ(･･ )"},
        { "location": "301/SEL"     , "narrator": "", "text": "悩んでるみたいだね"},
        { "location": "302/ACT"     , "narrator": "", "text": "悩んでるみたいだね"},
        { "location": "304/TALK"    , "narrator": "アーヤ", "text": "見てたの？"},
        { "location": "305/TALK"    , "narrator": "アーヤ", "text": "なんか恥ずかしい(*^^*)"},
        { "location": "306/TALK"    , "narrator": "アーヤ", "text": "あのね"},
        { "location": "307/TALK"    , "narrator": "アーヤ", "text": "今度ボランティアで着ていく服なんだけど"},
        { "location": "308/TALK"    , "narrator": "アーヤ", "text": "どんなのにするか悩んでるの"},
        { "location": "309/TALK"    , "narrator": "アーヤ", "text": "動きやすさ優先か"},
        { "location": "310/TALK"    , "narrator": "アーヤ", "text": "アップリケとか付いた子供向けか"},
        { "location": "311/TALK"    , "narrator": "アーヤ", "text": "劇に合わせたヒラヒラ系か"},
        { "location": "312/TALK"    , "narrator": "アーヤ", "text": "どうしたらいいと思う？（￣ー￣？）"},
        { "location": "314/SEL"     , "narrator": "", "text": "$me$がアドバイスしていいの？"},
        { "location": "315/ACT"     , "narrator": "", "text": "$me$がアドバイスしていいの？"},
        { "location": "317/TALK"    , "narrator": "アーヤ", "text": "もちろん(*^o^*)"},
        { "location": "318/TALK"    , "narrator": "アーヤ", "text": "ぜひ意見が聞きたいわ"},
        { "location": "321/SEL"     , "narrator": "", "text": "好きにすれば"},
        { "location": "322/SEL"     , "narrator": "", "text": "全部似合いそうで迷う"},
        { "location": "323/SEL"     , "narrator": "", "text": "いっそ着ない"},
        { "location": "324/ACT"     , "narrator": "", "text": "好きにすれば"},
        { "location": "325/TALK"    , "narrator": "アーヤ", "text": "え？"},
        { "location": "327/TALK"    , "narrator": "アーヤ", "text": "冷たい(>_<)"},
        { "location": "328/TALK"    , "narrator": "アーヤ", "text": "何かしら選んでくれると思ったのに"},
        { "location": "330/SEL"     , "narrator": "", "text": "適当過ぎた？"},
        { "location": "331/ACT"     , "narrator": "", "text": "適当過ぎた？"},
        { "location": "334/TALK"    , "narrator": "アーヤ", "text": "ちょっとね"},
        { "location": "335/TALK"    , "narrator": "アーヤ", "text": "でも"},
        { "location": "336/TALK"    , "narrator": "アーヤ", "text": "そのくらいクールな方がいいのかも(^з^)―☆"},
        { "location": "337/ACT"     , "narrator": "", "text": "全部似合いそうで迷う"},
        { "location": "339/TALK"    , "narrator": "アーヤ", "text": "あら優しい"},
        { "location": "340/TALK"    , "narrator": "アーヤ", "text": "そう言ってもらえると嬉しいわ(*^o^*)"},
        { "location": "342/TALK"    , "narrator": "アーヤ", "text": "まあ"},
        { "location": "343/TALK"    , "narrator": "アーヤ", "text": "ちょっと優柔不断っぽくも感じるけど"},
        { "location": "345/SEL"     , "narrator": "", "text": "いっそ着ない"},
        { "location": "346/ACT"     , "narrator": "", "text": "いっそ着ない"},
        { "location": "349/TALK"    , "narrator": "アーヤ", "text": "普段着で、ってこと？"},
        { "location": "351/SEL"     , "narrator": "", "text": "いや…そうじゃなくて…"},
        { "location": "352/ACT"     , "narrator": "", "text": "いや…そうじゃなくて…"},
        { "location": "355/TALK"    , "narrator": "アーヤ", "text": "酷い！(--#)"},
        { "location": "357/TALK"    , "narrator": "アーヤ", "text": "もうちょっと"},
        { "location": "358/TALK"    , "narrator": "アーヤ", "text": "本気で考えてみてよ"},
        { "location": "361/TALK"    , "narrator": "アーヤ", "text": "話に付き合ってくれてありがと"},
        { "location": "363/SEL"     , "narrator": "", "text": "まだ聞きたいことあるんじゃない？"},
        { "location": "364/ACT"     , "narrator": "", "text": "まだ聞きたいことあるんじゃない？"},
        { "location": "366/TALK"    , "narrator": "アーヤ", "text": "何かあったっけ？"},
        { "location": "368/SEL"     , "narrator": "", "text": "$me$に彼氏みたいな真似させてそれ？"},
        { "location": "369/ACT"     , "narrator": "", "text": "$me$に彼氏みたいな真似させてそれ？"},
        { "location": "371/TALK"    , "narrator": "アーヤ", "text": "あ"},
        { "location": "372/TALK"    , "narrator": "アーヤ", "text": "彼氏"},
        { "location": "373/TALK"    , "narrator": "アーヤ", "text": "彼氏ねー？"},
        { "location": "375/SEL"     , "narrator": "", "text": "言うことあるでしょ？"},
        { "location": "376/ACT"     , "narrator": "", "text": "言うことあるでしょ？"},
        { "location": "378/TALK"    , "narrator": "アーヤ", "text": "ええと"},
        { "location": "380/TALK"    , "narrator": "アーヤ", "text": "似合うかしら？"},
        { "location": "382/SEL"     , "narrator": "", "text": "最高"},
        { "location": "383/SEL"     , "narrator": "", "text": "うーん……"},
        { "location": "384/SEL"     , "narrator": "", "text": "$me$色に染まったね"},
        { "location": "385/ACT"     , "narrator": "", "text": "最高"},
        { "location": "386/TALK"    , "narrator": "アーヤ", "text": "もう"},
        { "location": "387/TALK"    , "narrator": "アーヤ", "text": "照れちゃうわ"},
        { "location": "388/ACT"     , "narrator": "", "text": "うーん……"},
        { "location": "389/TALK"    , "narrator": "アーヤ", "text": "こらこら"},
        { "location": "390/TALK"    , "narrator": "アーヤ", "text": "そこはほめるところよ？"},
        { "location": "391/ACT"     , "narrator": "", "text": "$me$色に染まったね"},
        { "location": "392/TALK"    , "narrator": "アーヤ", "text": "時代錯誤ね！"},
        { "location": "393/TALK"    , "narrator": "アーヤ", "text": "嫌いじゃないけど"},
        { "location": "395/TALK"    , "narrator": "アーヤ", "text": "なんてね"},
        { "location": "396/TALK"    , "narrator": "アーヤ", "text": "あとは自分で決めるから"},
        { "location": "397/TALK"    , "narrator": "アーヤ", "text": "楽しかったわ"},
        { "location": "399/TALK"    , "narrator": "アーヤ", "text": "彼氏ゴッコ(^з^)-☆"},
        { "location": "412/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "413/TALK"    , "narrator": "アーヤ", "text": "本当に彼氏がいたら、\nやっぱりこんな感じの\n毎日なのかしら？"},
        { "location": "425/TALK"    , "narrator": "アーヤ", "text": "彼女からのメッセージよ"},
        { "location": "427/TALK"    , "narrator": "アーヤ", "text": "受け取ってね☆"},
        { "location": "430/TALK"    , "narrator": "ボイスメール", "text": "声が聞きたくて（なんて）"},
        { "location": "278/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>某月某日　9:43 PM</color>\nとある平日の夜、寮「とらいあんぐる」アーヤの部屋にて。"},
        { "location": "442/DIALOG"  , "narrator": "Dialog_GETVoice", "text": "<color=green>【アーヤ】</color>のボイスメール\n<color=red>【声が聞きたくて（なんて）】</color>\nをゲットしました！"}
    ]
}
