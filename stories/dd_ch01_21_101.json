    "entry":
    [
        { "location": "24/TALK"   , "narrator": "真幌", "text": "よーし、午前の訓練は\nここまでだ。"},
        { "location": "25/TALK"   , "narrator": "真幌", "text": "午後はみっちりと\n模擬戦をするから、\nそのつもりでな。"},
        { "location": "64/TALK"   , "narrator": "みやび", "text": "…まほさん、今日は\nやたらとスパルタ\nメニューやね。"},
        { "location": "65/TALK"   , "narrator": "アーヤ", "text": "訓練の成果がちゃんと\n出てるか、確かめたい\nのかもしれないわね。"},
        { "location": "68/TALK"   , "narrator": "神楽", "text": "私、先に行きますね。"},
        { "location": "69/TALK"   , "narrator": "神楽", "text": "早く食事を取って、\n少しでも長く休みたい\nので…。"},
        { "location": "71/TALK"   , "narrator": "ガブリエラ", "text": "あたしも。\nほら、つばめも\n行くわよ。"},
        { "location": "74/TALK"   , "narrator": "つばめ", "text": "ううん、先行って…。\n五分くらい座ってから\n行くよ…。"},
        { "location": "76/TALK"   , "narrator": "ガブリエラ", "text": "あらそう。\nじゃあ、お先に。"},
        { "location": "78/TALK"   , "narrator": "神楽", "text": "ごめんなさい、\nつばめさん。\n先行ってますね。"},
        { "location": "107/TALK"  , "narrator": "みやび", "text": "…卯月がつばめちゃん\n置いてくとはなぁ。"},
        { "location": "109/TALK"  , "narrator": "アーヤ", "text": "それだけ疲れてる\nってことでしょ。"},
        { "location": "111/TALK"  , "narrator": "つばめ", "text": "アーヤさん達も、\nわたしに構わず\n行ってくださいね。"},
        { "location": "112/TALK"  , "narrator": "つばめ", "text": "少し休んだら、\nすぐにわたしも\n戻りますから。"},
        { "location": "114/TALK"  , "narrator": "アーヤ", "text": "そう？\nじゃあ、悪いけど\n先行くわね。"},
        { "location": "115/TALK"  , "narrator": "つばめ", "text": "はい。"},
        { "location": "118/TALK"  , "narrator": "アーヤ", "text": "…あ、そういえば。"},
        { "location": "119/TALK"  , "narrator": "アーヤ", "text": "今日って確か、\n日向さん達が東京に\n帰る日だったわね？"},
        { "location": "121/TALK"  , "narrator": "みやび", "text": "ああ、あの子達、\n今日帰るんか。"},
        { "location": "122/TALK"  , "narrator": "つばめ", "text": "はい…午後一の\n電車で帰るって\n言ってました。"},
        { "location": "123/TALK"  , "narrator": "つばめ", "text": "もうそろそろ、\n駅に到着する頃\nだと思います。"},
        { "location": "124/TALK"  , "narrator": "みやび", "text": "そうやったか…。\n別れの挨拶できんのは\n寂しいなぁ？"},
        { "location": "125/TALK"  , "narrator": "つばめ", "text": "それは朝起きたとき、\nＷＡＶＥでしたから\n大丈夫ですよ。"},
        { "location": "127/TALK"  , "narrator": "アーヤ", "text": "そっか。"},
        { "location": "129/TALK"  , "narrator": "アーヤ", "text": "それじゃ、つばめも\n少し休んだら\n戻っておいでね。"},
        { "location": "130/TALK"  , "narrator": "つばめ", "text": "あ、はい。"},
        { "location": "138/TALK"  , "narrator": "つばめ", "text": "…ふぅ…本当、\n今日の訓練は\nキツいなぁ…。"},
        { "location": "139/SEL"   , "narrator": "", "text": "雛達帰っちゃうんだ？"},
        { "location": "140/ACT"   , "narrator": "", "text": "雛達帰っちゃうんだ？"},
        { "location": "157/TALK"  , "narrator": "つばめ", "text": "ぅん(´･ω･｀) "},
        { "location": "158/TALK"  , "narrator": "つばめ", "text": "そぅなの"},
        { "location": "159/TALK"  , "narrator": "つばめ", "text": "元々ひなこちゃん達は"},
        { "location": "160/TALK"  , "narrator": "つばめ", "text": "早く帰ることになってて(´つω・｀)ｼｭﾝ"},
        { "location": "162/SEL"   , "narrator": "", "text": "やっぱり寂しい？"},
        { "location": "163/SEL"   , "narrator": "", "text": "これで訓練に集中できるね"},
        { "location": "164/ACT"   , "narrator": "", "text": "やっぱり寂しい？"},
        { "location": "165/TALK"  , "narrator": "つばめ", "text": "もちろん(´･ω･｀) "},
        { "location": "166/TALK"  , "narrator": "つばめ", "text": "ひなこちゃん達は帰るけど"},
        { "location": "167/TALK"  , "narrator": "つばめ", "text": "わたし達は"},
        { "location": "168/TALK"  , "narrator": "つばめ", "text": "まだ合宿続くから"},
        { "location": "169/TALK"  , "narrator": "つばめ", "text": "東京帰るまで"},
        { "location": "171/TALK"  , "narrator": "つばめ", "text": "会ぇなぃんだし・゜・(ノД`)・゜・"},
        { "location": "173/ACT"   , "narrator": "", "text": "これで訓練に集中できるね"},
        { "location": "174/TALK"  , "narrator": "つばめ", "text": "(´・ω・｀)(´・ω・｀)"},
        { "location": "175/TALK"  , "narrator": "つばめ", "text": "みんなとほとんど会えてなぃょ"},
        { "location": "176/TALK"  , "narrator": "つばめ", "text": "それに"},
        { "location": "177/TALK"  , "narrator": "つばめ", "text": "会ってお話とかした方が"},
        { "location": "178/TALK"  , "narrator": "つばめ", "text": "その後ちゃんと"},
        { "location": "179/TALK"  , "narrator": "つばめ", "text": "集中できるょ"},
        { "location": "182/SEL"   , "narrator": "", "text": "見送りに行かないの？"},
        { "location": "183/SEL"   , "narrator": "", "text": "別れの挨拶はいいの？"},
        { "location": "184/ACT"   , "narrator": "", "text": "見送りに行かないの？"},
        { "location": "185/TALK"  , "narrator": "つばめ", "text": "そりゃ"},
        { "location": "186/TALK"  , "narrator": "つばめ", "text": "行きたぃけどヾ(｡>﹏<｡)ﾉﾞ"},
        { "location": "189/TALK"  , "narrator": "つばめ", "text": "でも"},
        { "location": "190/TALK"  , "narrator": "つばめ", "text": "午後の訓練があるし(´･ω･｀) "},
        { "location": "191/TALK"  , "narrator": "つばめ", "text": "見送り行ったら"},
        { "location": "193/TALK"  , "narrator": "つばめ", "text": "訓練に遅れちゃぅから"},
        { "location": "196/TALK"  , "narrator": "つばめ", "text": "行きたぃけど"},
        { "location": "197/TALK"  , "narrator": "つばめ", "text": "行けなぃよ(o´Д`)=з"},
        { "location": "199/ACT"   , "narrator": "", "text": "別れの挨拶はいいの？"},
        { "location": "201/TALK"  , "narrator": "つばめ", "text": "東京でまた会えるから"},
        { "location": "202/TALK"  , "narrator": "つばめ", "text": "それに"},
        { "location": "203/TALK"  , "narrator": "つばめ", "text": "午後の訓練もあるし_(┐「ε:)_"},
        { "location": "204/TALK"  , "narrator": "つばめ", "text": "挨拶なんてしたら"},
        { "location": "206/TALK"  , "narrator": "つばめ", "text": "さみしくなっちゃう|д･)"},
        { "location": "209/SEL"   , "narrator": "", "text": "後悔しない？"},
        { "location": "210/ACT"   , "narrator": "", "text": "後悔しない？"},
        { "location": "213/TALK"  , "narrator": "つばめ", "text": "どぅかな"},
        { "location": "215/TALK"  , "narrator": "つばめ", "text": "わからなぃよ"},
        { "location": "280/TALK"  , "narrator": "つばめ", "text": "　"},
        { "location": "293/TALK"  , "narrator": "つばめ", "text": "こんにちは、\n$handle$さん。"},
        { "location": "294/TALK"  , "narrator": "つばめ", "text": "突然ですが、\n前回までのあらすじです。"},
        { "location": "295/TALK"  , "narrator": "つばめ", "text": "自分で自分に嫉妬した\nココロつばめは、水着姿で\n大胆勝負をかけた。"},
        { "location": "296/TALK"  , "narrator": "つばめ", "text": "以上。"},
        { "location": "297/SEL"   , "narrator": "", "text": "…で？"},
        { "location": "298/SEL"   , "narrator": "", "text": "どうしたの！？急に"},
        { "location": "299/ACT"   , "narrator": "", "text": "…で？"},
        { "location": "300/TALK"  , "narrator": "つばめ", "text": "わかりませんか？"},
        { "location": "301/ACT"   , "narrator": "", "text": "どうしたの！？急に"},
        { "location": "302/TALK"  , "narrator": "つばめ", "text": "大事なお話があります。"},
        { "location": "304/TALK"  , "narrator": "つばめ", "text": "元司書の某さんは\n危険な存在です。"},
        { "location": "305/TALK"  , "narrator": "つばめ", "text": "かかわるくらいなら\nわたしにかかわって\nください。"},
        { "location": "306/SEL"   , "narrator": "", "text": "それと前回のあらすじとの関係は？"},
        { "location": "307/ACT"   , "narrator": "", "text": "それと前回のあらすじとの関係は？"},
        { "location": "309/TALK"  , "narrator": "つばめ", "text": "……わかりませんか？"},
        { "location": "311/TALK"  , "narrator": "つばめ", "text": "『わたしだけを見て！』\nということです。"},
        { "location": "313/TALK"  , "narrator": "つばめ", "text": "なんて。花言葉みたいで\nちょっとオシャレかなと\n思いました。"},
        { "location": "314/SEL"   , "narrator": "", "text": "ホントにどうしちゃったの！？"},
        { "location": "315/SEL"   , "narrator": "", "text": "元司書さんが危険だなんて嘘だ"},
        { "location": "316/ACT"   , "narrator": "", "text": "ホントにどうしちゃったの！？"},
        { "location": "317/TALK"  , "narrator": "つばめ", "text": "察して下さい。"},
        { "location": "318/ACT"   , "narrator": "", "text": "元司書さんが危険だなんて嘘だ"},
        { "location": "319/TALK"  , "narrator": "つばめ", "text": "いいでしょう。\nならば戦争です。"},
        { "location": "320/SEL"   , "narrator": "", "text": "やばいよやばいよ！"},
        { "location": "321/ACT"   , "narrator": "", "text": "やばいよやばいよ！"},
        { "location": "323/TALK"  , "narrator": "つばめ", "text": "$handle$さんの\n方がやばいですよ。"},
        { "location": "325/TALK"  , "narrator": "つばめ", "text": "まず先に伝えておきますと\n元司書とわたしとでは、\nわたしの方が深いです。"},
        { "location": "326/TALK"  , "narrator": "つばめ", "text": "成績で例えるなら、\n12位と285位くらいに\nなります。"},
        { "location": "327/TALK"  , "narrator": "つばめ", "text": "それでも\n元司書の肩を持ちますか？"},
        { "location": "328/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "329/TALK"  , "narrator": "つばめ", "text": "言ってる意味、\nわかります？"},
        { "location": "330/SEL"   , "narrator": "", "text": "深層心理に近い所にいるから色々有利（意味深）ってこと？"},
        { "location": "331/SEL"   , "narrator": "", "text": "そもそも本当につばめの人格なの？"},
        { "location": "332/ACT"   , "narrator": "", "text": "深層心理に近い所にいるから色々有利（意味深）ってこと？"},
        { "location": "333/TALK"  , "narrator": "つばめ", "text": "ピンポーン。"},
        { "location": "334/TALK"  , "narrator": "つばめ", "text": "そういうことです。"},
        { "location": "335/ACT"   , "narrator": "", "text": "そもそも本当につばめの人格なの？"},
        { "location": "336/TALK"  , "narrator": "つばめ", "text": "疑り深い人ですね。"},
        { "location": "337/TALK"  , "narrator": "つばめ", "text": "前から言ってますよね？\nわたしは逢瀬つばめの\n一人格でし…す。"},
        { "location": "338/SEL"   , "narrator": "", "text": "なんかいつも過去形で言おうとして言い直してるよね？"},
        { "location": "339/ACT"   , "narrator": "", "text": "なんかいつも過去形で言おうとして言い直してるよね？"},
        { "location": "341/TALK"  , "narrator": "つばめ", "text": "……ブラフです。"},
        { "location": "343/TALK"  , "narrator": "つばめ", "text": "とにかく、です。"},
        { "location": "344/TALK"  , "narrator": "つばめ", "text": "元司書は既に\n司書ではありません。"},
        { "location": "345/TALK"  , "narrator": "つばめ", "text": "そして、影響力としては\n彼女よりも私の方が\n相当強いです。"},
        { "location": "346/TALK"  , "narrator": "つばめ", "text": "彼女がVer1.1なら\nわたしはVer2.0です。\nおよそ40倍の性能です！"},
        { "location": "347/SEL"   , "narrator": "", "text": "なんで急にアピールし始めてるの？"},
        { "location": "348/SEL"   , "narrator": "", "text": "元司書は今どうなっちゃってるの？"},
        { "location": "349/ACT"   , "narrator": "", "text": "なんで急にアピールし始めてるの？"},
        { "location": "350/TALK"  , "narrator": "つばめ", "text": "それは、あなたが\nいつまでたってもわたしに\n懐いてくれないからです。"},
        { "location": "351/SEL"   , "narrator": "", "text": "うーん、まあ…"},
        { "location": "352/SEL"   , "narrator": "", "text": "被害者妄想ですよ"},
        { "location": "353/ACT"   , "narrator": "", "text": "うーん、まあ…"},
        { "location": "354/TALK"  , "narrator": "つばめ", "text": "ほら。\n「そんな事ないよ」キリッ\nって言えないですよね？"},
        { "location": "355/ACT"   , "narrator": "", "text": "被害者妄想ですよ"},
        { "location": "356/TALK"  , "narrator": "つばめ", "text": "……そうでしょうか。"},
        { "location": "358/TALK"  , "narrator": "つばめ", "text": "そんなわけなので、\n作戦を変えようと\n思います。"},
        { "location": "361/TALK"  , "narrator": "つばめ", "text": "題して、\nあなた好みのわたし\n大作戦！"},
        { "location": "362/SEL"   , "narrator": "", "text": "お、おう…"},
        { "location": "363/ACT"   , "narrator": "", "text": "お、おう…"},
        { "location": "365/TALK"  , "narrator": "つばめ", "text": "あなたは油断してますが、\nわたしはどんな\nわたしにだってなれます！"},
        { "location": "366/SEL"   , "narrator": "", "text": "別に油断とかしてませんが…"},
        { "location": "367/ACT"   , "narrator": "", "text": "別に油断とかしてませんが…"},
        { "location": "369/TALK"  , "narrator": "つばめ", "text": "試しに何でも\n言ってみてください。"},
        { "location": "370/SEL"   , "narrator": "", "text": "ツンデレなつばめがいい"},
        { "location": "371/SEL"   , "narrator": "", "text": "妹のようなつばめがいい"},
        { "location": "372/SEL"   , "narrator": "", "text": "エロエロなつばめがいい"},
        { "location": "373/SEL"   , "narrator": "", "text": "今のままが一番だよ"},
        { "location": "374/ACT"   , "narrator": "", "text": "ツンデレなつばめがいい"},
        { "location": "375/TALK"  , "narrator": "つばめ", "text": "べっべつにあんたのこと\nなんて好きでもなんでも\nないんだからね。"},
        { "location": "376/TALK"  , "narrator": "つばめ", "text": "迫真の演技…！！"},
        { "location": "377/ACT"   , "narrator": "", "text": "妹のようなつばめがいい"},
        { "location": "378/TALK"  , "narrator": "つばめ", "text": "もー、おにいちゃんってば\nいつまで寝てるのー！？"},
        { "location": "379/TALK"  , "narrator": "つばめ", "text": "早く起きないと\nぶっ殺しますわよ？"},
        { "location": "380/TALK"  , "narrator": "つばめ", "text": "迫真の演技…！！"},
        { "location": "381/ACT"   , "narrator": "", "text": "エロエロなつばめがいい"},
        { "location": "382/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "383/TALK"  , "narrator": "つばめ", "text": "■■■■■■■■、\n■■■■■■■■■■\n■■■■…？"},
        { "location": "384/TALK"  , "narrator": "つばめ", "text": "迫真の演技…。"},
        { "location": "385/ACT"   , "narrator": "", "text": "今のままが一番だよ"},
        { "location": "387/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "388/TALK"  , "narrator": "つばめ", "text": "どうしてそういうことを\n言うんですか？"},
        { "location": "389/TALK"  , "narrator": "つばめ", "text": "もういいです。"},
        { "location": "391/TALK"  , "narrator": "つばめ", "text": "だいぶ話が逸れましたが、\n早速仕事をしましょう。"},
        { "location": "392/SEL"   , "narrator": "", "text": "あ、あれ！？\n元司書さんの話はこれでおしまい！？"},
        { "location": "393/ACT"   , "narrator": "", "text": "あ、あれ！？\n元司書さんの話はこれでおしまい！？"},
        { "location": "397/TALK"  , "narrator": "つばめ", "text": "と、こんな感じで。"},
        { "location": "398/SEL"   , "narrator": "", "text": "もう終わり！？"},
        { "location": "399/ACT"   , "narrator": "", "text": "もう終わり！？"},
        { "location": "401/TALK"  , "narrator": "つばめ", "text": "わかってもらえれば\nそれで十分なので。"},
        { "location": "402/SEL"   , "narrator": "", "text": "全然わかりません……"},
        { "location": "403/ACT"   , "narrator": "", "text": "全然わかりません……"},
        { "location": "405/TALK"  , "narrator": "つばめ", "text": "さて、それじゃ\n今日の仕事をしましょう。"},
        { "location": "406/SEL"   , "narrator": "", "text": "ガン無視！？"},
        { "location": "407/ACT"   , "narrator": "", "text": "ガン無視！？"},
        { "location": "410/TALK"  , "narrator": "つばめ", "text": "時間がないんですから。\nいつもそうやって話の腰を\n折らないでください。"},
        { "location": "411/SEL"   , "narrator": "", "text": "折ってるのは司書さんの方では…？"},
        { "location": "412/ACT"   , "narrator": "", "text": "折ってるのは司書さんの方では…？"},
        { "location": "414/TALK"  , "narrator": "つばめ", "text": "ああいえばこういう。\n困った人ですね。"},
        { "location": "415/TALK"  , "narrator": "つばめ", "text": "まあ、いいです。\nわたしの意志は強いので、\n誘導には乗りません。"},
        { "location": "416/ACT"   , "narrator": "", "text": "元司書は今どうなっちゃってるの？"},
        { "location": "417/TALK"  , "narrator": "つばめ", "text": "前にも話したとおり、\n現在再教育中です。"},
        { "location": "418/TALK"  , "narrator": "つばめ", "text": "…が。"},
        { "location": "419/TALK"  , "narrator": "つばめ", "text": "風の噂によれば、\n共謀者と共に脱走したとか\nしてないとか。"},
        { "location": "420/TALK"  , "narrator": "つばめ", "text": "そのあたりをうろついて\nいるかもしれません。"},
        { "location": "421/TALK"  , "narrator": "つばめ", "text": "$handle$さんも\nココロードを歩くときは\n気をつけてください。"},
        { "location": "422/SEL"   , "narrator": "", "text": "別に怖い存在じゃないでしょ"},
        { "location": "423/ACT"   , "narrator": "", "text": "別に怖い存在じゃないでしょ"},
        { "location": "425/TALK"  , "narrator": "つばめ", "text": "いいえ。"},
        { "location": "426/TALK"  , "narrator": "つばめ", "text": "彼女はわたしのココロの\n中における、反乱分子の\n一味。"},
        { "location": "427/TALK"  , "narrator": "つばめ", "text": "例えるならば、\n政治犯、もしくは\n思想犯というべき者です。"},
        { "location": "428/SEL"   , "narrator": "", "text": "穏やかじゃない発言だね"},
        { "location": "429/SEL"   , "narrator": "", "text": "一味ってことは、他にもいるってこと？"},
        { "location": "430/ACT"   , "narrator": "", "text": "穏やかじゃない発言だね"},
        { "location": "431/TALK"  , "narrator": "つばめ", "text": "穏やかじゃありませんよ。"},
        { "location": "432/TALK"  , "narrator": "つばめ", "text": "彼女はそれを隠して、\n司書になったんですから。"},
        { "location": "433/ACT"   , "narrator": "", "text": "一味ってことは、他にもいるってこと？"},
        { "location": "434/TALK"  , "narrator": "つばめ", "text": "もちろんです。\n総意のうちの数割は\n反乱分子ですから。"},
        { "location": "435/SEL"   , "narrator": "", "text": "トップを潰さないとダメでしょ"},
        { "location": "436/ACT"   , "narrator": "", "text": "トップを潰さないとダメでしょ"},
        { "location": "438/TALK"  , "narrator": "つばめ", "text": "そんな簡単にできたら、\nとっくの昔にやってます。"},
        { "location": "440/TALK"  , "narrator": "つばめ", "text": "とにかく、そういう\nわけですから、彼女には\n近づかないように。"},
        { "location": "441/TALK"  , "narrator": "つばめ", "text": "わたしやセカイを\n想ってくれるのなら\n尚更です。"},
        { "location": "442/TALK"  , "narrator": "つばめ", "text": "さて。伝えたいことは\n伝えましたし、さっさと\n仕事しましょう。"},
        { "location": "451/TALK"  , "narrator": "つばめ", "text": "オープンプロセス、\n0x22C番地から\n0x89F番地へ。"},
        { "location": "471/TALK"  , "narrator": "つばめ", "text": "シーク完了しました。"},
        { "location": "474/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "476/TALK"  , "narrator": "つばめ", "text": "……なるほど。"},
        { "location": "477/TALK"  , "narrator": "つばめ", "text": "ていうかですね。"},
        { "location": "478/TALK"  , "narrator": "つばめ", "text": "こんなの、行かなかったら\n後で後悔するに\n決まってるわけです。"},
        { "location": "479/TALK"  , "narrator": "つばめ", "text": "というわけで、\n早速宜しくお願いします。"},
        { "location": "480/SEL"   , "narrator": "", "text": "オッケー"},
        { "location": "481/SEL"   , "narrator": "", "text": "「決まってる」は言い過ぎでは？"},
        { "location": "482/ACT"   , "narrator": "", "text": "オッケー"},
        { "location": "483/ACT"   , "narrator": "", "text": "「決まってる」は言い過ぎでは？"},
        { "location": "484/TALK"  , "narrator": "つばめ", "text": "そうでしょうか。"},
        { "location": "485/TALK"  , "narrator": "つばめ", "text": "人はココロの中では\nこれしか無いと決まって\nいても、ごまかします。"},
        { "location": "486/TALK"  , "narrator": "つばめ", "text": "その理由は、\n怖いからとか\n面倒くさいとか。"},
        { "location": "487/TALK"  , "narrator": "つばめ", "text": "そういった様々な\nネガ要因を取り除くと、\n概ね決まってるんです。"},
        { "location": "488/TALK"  , "narrator": "つばめ", "text": "わたしは、そういった\n客観的な視点から、物事を\n見ることができます。"},
        { "location": "489/TALK"  , "narrator": "つばめ", "text": "人は、観念やそれによる\n恐れ、諦めが無ければ\nもっと強く生きられます。"},
        { "location": "490/TALK"  , "narrator": "つばめ", "text": "だからこそ、観念が薄い\n子供ほど、ミラクルを\n生み出すんです！"},
        { "location": "491/TALK"  , "narrator": "つばめ", "text": "わたしがココロの\n司書として実践してるのは\nそういうことなんです。"},
        { "location": "492/TALK"  , "narrator": "つばめ", "text": "というわけで、安心して\nわたしに従ってください！"},
        { "location": "494/TALK"  , "narrator": "つばめ", "text": "わたしと\n$handle$さんに\n素敵なココロの旅を。"},
        { "location": "22/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>8月24日　 11:52 AM</color>\n合宿中、午前の訓練終了時のこと"},
        { "location": "245/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "247/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "249/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "251/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "253/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"}
