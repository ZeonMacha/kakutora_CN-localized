        { "location": "325/TALK", "narrator": "ガブリエラ", "text": "善光寺って、こういう見た目なのね？"},
        { "location": "327/TALK", "narrator": "ガブリエラ", "text": "名前は聞いたことあるけど、見たことはなかったの"},
        { "location": "330/SEL" , "narrator": "", "text": "ガブリエラが知らなかったのが驚き"},
        { "location": "331/ACT" , "narrator": "", "text": "ガブリエラが知らなかったのが驚き"},
        { "location": "334/TALK", "narrator": "ガブリエラ", "text": "何でも知ってると思わないでよ"},
        { "location": "335/TALK", "narrator": "ガブリエラ", "text": "っていうか、知らないことの方が多いんだし"},
        { "location": "336/TALK", "narrator": "ガブリエラ", "text": "善光寺だって、名前は知ってるけど"},
        { "location": "337/TALK", "narrator": "ガブリエラ", "text": "それ以外のことはさっぱりなんだから"},
        { "location": "340/SEL" , "narrator": "", "text": "見た目がわかってよかったね"},
        { "location": "341/ACT" , "narrator": "", "text": "見た目がわかってよかったね"},
        { "location": "344/TALK", "narrator": "ガブリエラ", "text": "ええ、そうね"},
