        { "location": "346/TALK", "narrator": "ガブリエラ", "text": "せっかくだし、ちょっと調べてみようかしら？"},
        { "location": "347/TALK", "narrator": "ガブリエラ", "text": "調べておけば、お参りに行ったときに"},
