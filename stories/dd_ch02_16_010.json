{
    "dir": "chap16/daydra/dd_ch02_16_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "16252",
        "cid": "ayami",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "ゴキブリ注意"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "ゴキブリ注意"},
        { "location": "24/TALK"   , "narrator": "ガブリエラ", "text": "はぁ…暇ねぇ…。"},
        { "location": "26/TALK"   , "narrator": "つばめ", "text": "やることやっちゃうと、\n閉館まですること\nないもんね？"},
        { "location": "27/TALK"   , "narrator": "ガブリエラ", "text": "まあ、こういう時こそ\nスマホゲームに没頭して、\n時間を忘れた方が――"},
        { "location": "28/TALK"   , "narrator": "ガブリエラ", "text": "ん？"},
        { "location": "30/TALK"   , "narrator": "つばめ", "text": "え、なに？"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "今、なんかカサカサって\n音がしたような…。"},
        { "location": "33/TALK"   , "narrator": "つばめ", "text": "カサカサ？\nなんだろう…。"},
        { "location": "36/TALK"   , "narrator": "ガブリエラ", "text": "確か、ちゃぶ台の下から\n聞こえ――"},
        { "location": "41/TALK"   , "narrator": "ガブリエラ", "text": "ひっ！？\nいやぁぁぁぁぁぁぁ！！"},
        { "location": "44/TALK"   , "narrator": "つばめ", "text": "が、ガブちゃん！？\nどうし――"},
        { "location": "47/TALK"   , "narrator": "つばめ", "text": "やだ、ゴキブリ！？\nきゃあぁぁぁぁぁぁ！！"},
        { "location": "51/TALK"   , "narrator": "ガブリエラ", "text": "こここ、こっち来た！！\nつばめ、あんた何とか\nしなさいよ！"},
        { "location": "55/TALK"   , "narrator": "つばめ", "text": "む、無理だよぉ！！"},
        { "location": "58/TALK"   , "narrator": "ガブリエラ", "text": "誰か！！\n誰か来てぇ！！"},
        { "location": "70/TALK"   , "narrator": "アーヤ", "text": "ふぁ…。"},
        { "location": "71/TALK"   , "narrator": "アーヤ", "text": "っ！\nいけないいけない。"},
        { "location": "72/TALK"   , "narrator": "アーヤ", "text": "いくら暇だからって、\nバイト中にあくびは\nいけないわね。"},
        { "location": "73/TALK"   , "narrator": "アーヤ", "text": "…でも、本当に\n今日は暇だわ…。"},
        { "location": "74/TALK"   , "narrator": "アーヤ", "text": "やることなくて、\nこのままじゃ本当に\n寝ちゃいそう…。"},
        { "location": "75/SEL"    , "narrator": "", "text": "暇そうだね"},
        { "location": "78/TALK"   , "narrator": "アーヤ", "text": "はぁ…"},
        { "location": "79/TALK"   , "narrator": "アーヤ", "text": "………………。"},
        { "location": "80/TALK"   , "narrator": "アーヤ", "text": "………………。"},
        { "location": "84/TALK"   , "narrator": "アーヤ", "text": "くぅ…。"},
        { "location": "86/TALK"   , "narrator": "アーヤ", "text": "はっ！？"},
        { "location": "87/TALK"   , "narrator": "アーヤ", "text": "ああもう、\nしっかりしなきゃ！"},
        { "location": "88/TALK"   , "narrator": "アーヤ", "text": "ちょっと、外の空気にでも\n当たってこよう…。"},
        { "location": "90/ACT"    , "narrator": "", "text": "暇そうだね"},
        { "location": "97/TALK"   , "narrator": "アーヤ", "text": "…いいタイミングね。"},
        { "location": "111/TALK"  , "narrator": "アーヤ", "text": "暇過ぎて寝そう(；´Д｀)"},
        { "location": "112/TALK"  , "narrator": "アーヤ", "text": "けど、声掛けてもらえたから目が覚めた"},
        { "location": "113/TALK"  , "narrator": "アーヤ", "text": "もう大丈夫(*≧∀≦*) "},
        { "location": "114/TALK"  , "narrator": "アーヤ", "text": "けど、暇過ぎて時間を無駄にしてる気分…"},
        { "location": "116/SEL"   , "narrator": "", "text": "楽屋に行ってみよう"},
        { "location": "117/SEL"   , "narrator": "", "text": "楽屋にゴキブリが出たよ"},
        { "location": "118/SEL"   , "narrator": "", "text": "平和が一番さ"},
        { "location": "119/ACT"   , "narrator": "", "text": "楽屋に行ってみよう"},
        { "location": "121/TALK"  , "narrator": "アーヤ", "text": "そうね…楽屋なら誰かしらいると思うし"},
        { "location": "122/TALK"  , "narrator": "アーヤ", "text": "お喋りでもしてくるわ"},
        { "location": "146/TALK"  , "narrator": "ガブリエラ", "text": "つばめ、そっち行った！"},
        { "location": "150/TALK"  , "narrator": "つばめ", "text": "きゃーっ！！\nこ、来ないで来ないでー！"},
        { "location": "151/TALK"  , "narrator": "ガブリエラ", "text": "ちゃぶ台！\nちゃぶ台の上に避難して！"},
        { "location": "152/TALK"  , "narrator": "つばめ", "text": "きゃーっ！！"},
        { "location": "155/TALK"  , "narrator": "アーヤ", "text": "ちょっと、どうしたの？\nいくら何でも騒ぎ過ぎよ。"},
        { "location": "157/TALK"  , "narrator": "つばめ", "text": "あ、アーヤさん！！"},
        { "location": "159/TALK"  , "narrator": "ガブリエラ", "text": "アーヤ、足元！\n踏んづけて！"},
        { "location": "163/TALK"  , "narrator": "アーヤ", "text": "え？"},
        { "location": "164/TALK"  , "narrator": "アーヤ", "text": "きゃぁぁぁぁぁぁぁっ！\nちょ、やだ！　ゴキブリ！"},
        { "location": "165/TALK"  , "narrator": "つばめ", "text": "アーヤさん、この雑誌！\n使ってください！"},
        { "location": "167/TALK"  , "narrator": "アーヤ", "text": "くっ…てぇいっ！"},
        { "location": "175/TALK"  , "narrator": "ガブリエラ", "text": "やった、仕留めた！"},
        { "location": "179/TALK"  , "narrator": "つばめ", "text": "はぁ…よ、よかったぁ…。"},
        { "location": "182/TALK"  , "narrator": "アーヤ", "text": "はぁ、はぁ…な、なに？\nどういうことなの？"},
        { "location": "184/TALK"  , "narrator": "ガブリエラ", "text": "ゴキブリよ、ゴキブリ！\n急に出てきたから、\n驚いて逃げてたのよ。"},
        { "location": "187/TALK"  , "narrator": "アーヤ", "text": "逃げてちゃ\n意味ないでしょ！？\n退治しなさいよ！"},
        { "location": "188/TALK"  , "narrator": "つばめ", "text": "で、でも、怖いじゃない\nですかぁ…。"},
        { "location": "190/TALK"  , "narrator": "アーヤ", "text": "噛みつかれるわけでも\nないのに、まったく…。"},
        { "location": "191/TALK"  , "narrator": "ガブリエラ", "text": "なによ、アーヤだって\n大声で叫んだくせに。"},
        { "location": "193/TALK"  , "narrator": "アーヤ", "text": "そ、そりゃ、入って\nすぐにゴキブリがいたら、\n誰だって叫ぶわよ…。"},
        { "location": "195/TALK"  , "narrator": "ガブリエラ", "text": "それはそうだけど――"},
        { "location": "196/TALK"  , "narrator": "ガブリエラ", "text": "なんか、すっごい可愛い\n叫び方で、そっちの方が\n驚いたかも。"},
        { "location": "197/TALK"  , "narrator": "アーヤ", "text": "なっ！？"},
        { "location": "199/TALK"  , "narrator": "つばめ", "text": "わたしも、ちょっとだけ\nそう思いました。"},
        { "location": "201/TALK"  , "narrator": "アーヤ", "text": "うっ…ば、バカなこと\n言ってないの！"},
        { "location": "202/TALK"  , "narrator": "アーヤ", "text": "後でスプレーを用意して\nおくから――"},
        { "location": "203/TALK"  , "narrator": "アーヤ", "text": "今度からは、自分たちで\n退治するのよ？"},
        { "location": "207/TALK"  , "narrator": "つばめ", "text": "あっ…行っちゃった…。\n怒らせちゃったかな？"},
        { "location": "209/TALK"  , "narrator": "ガブリエラ", "text": "照れてるだけよ。\n気にすることないって。"},
        { "location": "210/TALK"  , "narrator": "ガブリエラ", "text": "今気にしなきゃいけない\nのは…潰れたゴキブリを、\nどうすればいいかよ…。"},
        { "location": "211/ACT"   , "narrator": "", "text": "楽屋にゴキブリが出たよ"},
        { "location": "212/TALK"  , "narrator": "アーヤ", "text": "へぇ、そんなことまでわかるんだ？"},
        { "location": "213/TALK"  , "narrator": "アーヤ", "text": "っていうか、さっきから楽屋の方が騒がしいのって、それが原因？"},
        { "location": "226/TALK"  , "narrator": "アーヤ", "text": "確か、スプレーが\nこの辺に…。"},
        { "location": "241/TALK"  , "narrator": "ガブリエラ", "text": "つばめ、そっち行った！"},
        { "location": "243/TALK"  , "narrator": "つばめ", "text": "きゃーっ！！\nこ、来ないで来ないでー！"},
        { "location": "244/TALK"  , "narrator": "ガブリエラ", "text": "ちゃぶ台！\nちゃぶ台の上に避難して！"},
        { "location": "245/TALK"  , "narrator": "つばめ", "text": "きゃーっ！！"},
        { "location": "247/TALK"  , "narrator": "アーヤ", "text": "ほら、騒がないの。\nゴキブリはどこ？"},
        { "location": "249/TALK"  , "narrator": "つばめ", "text": "そ、そこです！\n足元！"},
        { "location": "251/TALK"  , "narrator": "アーヤ", "text": "…あ、いたいた。\nそれっ！"},
        { "location": "260/TALK"  , "narrator": "ガブリエラ", "text": "やった！\nさすがねアーヤ！"},
        { "location": "263/TALK"  , "narrator": "つばめ", "text": "ありがとうございます、\nアーヤさん！"},
        { "location": "266/TALK"  , "narrator": "アーヤ", "text": "まったく…\nゴキブリくらいで\n騒ぎ過ぎよ。"},
        { "location": "267/TALK"  , "narrator": "アーヤ", "text": "さっさと退治しちゃえば\nいいだけなのに…。"},
        { "location": "268/TALK"  , "narrator": "つばめ", "text": "そんな…簡単に言われても\nできませんよ…。"},
        { "location": "269/TALK"  , "narrator": "ガブリエラ", "text": "怖がらずに退治できる\nアーヤの方が変よ！"},
        { "location": "271/TALK"  , "narrator": "アーヤ", "text": "変って…そもそも\nあなた達、一人暮らし\nしてるんでしょ？"},
        { "location": "272/TALK"  , "narrator": "アーヤ", "text": "自分で退治できなくて、\n部屋に出た時はどうする\nつもりなの？"},
        { "location": "274/TALK"  , "narrator": "ガブリエラ", "text": "…い、今まで、\n一度も出たことないし…。"},
        { "location": "276/TALK"  , "narrator": "つばめ", "text": "そうだ…お父さんいない\nから、ゴキブリ退治して\nもらえないんだ…。"},
        { "location": "277/TALK"  , "narrator": "アーヤ", "text": "…今までお父さん\n任せにしてたの？"},
        { "location": "278/TALK"  , "narrator": "つばめ", "text": "だ、だって怖いじゃ\nないですか！"},
        { "location": "280/TALK"  , "narrator": "つばめ", "text": "そうだ、アーヤさん。\nもし部屋にゴキブリが\n出たら――"},
        { "location": "281/TALK"  , "narrator": "つばめ", "text": "その時はお願いして\nいいですか！？"},
        { "location": "283/TALK"  , "narrator": "アーヤ", "text": "えっ！？"},
        { "location": "287/TALK"  , "narrator": "ガブリエラ", "text": "ず、ずるい！\nそれならあたしだって\nお願いしたいわ！"},
        { "location": "289/TALK"  , "narrator": "アーヤ", "text": "嫌よ！\n私だってゴキブリは\n見たくもないんだから！"},
        { "location": "293/TALK"  , "narrator": "ガブリエラ", "text": "で、でも！"},
        { "location": "294/TALK"  , "narrator": "ガブリエラ", "text": "あたし達じゃ絶対に\nゴキブリの退治なんて\nできないから――"},
        { "location": "295/TALK"  , "narrator": "ガブリエラ", "text": "逃がしたゴキブリが\n繁殖しちゃうかも\nしれないのよ？"},
        { "location": "296/TALK"  , "narrator": "つばめ", "text": "い、嫌だ！\n寮がゴキブリだらけに\nなっちゃうよ！"},
        { "location": "298/TALK"  , "narrator": "ガブリエラ", "text": "でしょ？\nだから、アーヤには\n寮を守るためにも――"},
        { "location": "301/TALK"  , "narrator": "ガブリエラ", "text": "ゴキブリが出た時には\n退治してほしいの。\nお願い！"},
        { "location": "304/TALK"  , "narrator": "アーヤ", "text": "あ、あんたねぇ…。"},
        { "location": "307/TALK"  , "narrator": "アーヤ", "text": "けど、寮でゴキブリが\n大量発生なんて事態、\n絶対嫌だわ…。"},
        { "location": "310/TALK"  , "narrator": "アーヤ", "text": "はぁ…スプレーだけは\n部屋に常備しておきな\nさいよ？"},
        { "location": "311/TALK"  , "narrator": "アーヤ", "text": "雑誌や新聞紙で叩くのは、\nできれば避けたいし…。"},
        { "location": "314/TALK"  , "narrator": "つばめ", "text": "は、はい！\n本当に助かります、\nアーヤさん。"},
        { "location": "317/TALK"  , "narrator": "ガブリエラ", "text": "うんうん、やっぱり\nトライナリーのリーダーは\nアーヤしかいないわね。"},
        { "location": "319/TALK"  , "narrator": "アーヤ", "text": "…これなら、暇な方が\nマシだったわ。"},
        { "location": "320/ACT"   , "narrator": "", "text": "平和が一番さ"},
        { "location": "321/TALK"  , "narrator": "アーヤ", "text": "そっか"},
        { "location": "322/TALK"  , "narrator": "アーヤ", "text": "暇ってことは、平和ってことよね"},
        { "location": "333/TALK"  , "narrator": "アーヤ", "text": "私が暇ってことは、\nフェノメノンも発生して\nいないってことだから――"},
        { "location": "334/TALK"  , "narrator": "アーヤ", "text": "本当に今のところは\n平和な時間、って\n証拠なんだし。"},
        { "location": "335/TALK"  , "narrator": "アーヤ", "text": "…なんだか、暇な時間が\n凄く贅沢に思えてきた\nかも。"},
        { "location": "336/TALK"  , "narrator": "アーヤ", "text": "…夕飯の献立でも\n考えよう。"},
        { "location": "338/TALK"  , "narrator": "アーヤ", "text": "今日は久しぶりに、\n手の込んだものを\n作ってみようかしら？"},
        { "location": "15/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>7月14日　5:12 PM</color>\nとある平日の放課後、神楽坂トライナリー劇場でのバイト中のこと。"}
    ]
}
