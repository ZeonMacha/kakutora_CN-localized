    [
        { "location": "222/SCENARIO", "narrator": "", "text": "540_卵焼き"},
        { "location": "247/TALK"    , "narrator": "アーヤ", "text": "卵焼きの味付けって"},
        { "location": "248/TALK"    , "narrator": "アーヤ", "text": "何味だった？"},
        { "location": "250/SEL"     , "narrator": "", "text": "塩味"},
        { "location": "251/SEL"     , "narrator": "", "text": "醤油"},
        { "location": "252/SEL"     , "narrator": "", "text": "みりんと醤油"},
        { "location": "253/SEL"     , "narrator": "", "text": "砂糖"},
        { "location": "254/SEL"     , "narrator": "", "text": "砂糖醤油"},
        { "location": "255/SEL"     , "narrator": "", "text": "塩麹"},
        { "location": "256/SEL"     , "narrator": "", "text": "よくわからない"},
        { "location": "257/ACT"     , "narrator": "", "text": "塩味"},
        { "location": "258/TALK"    , "narrator": "アーヤ", "text": "シンプルね"},
        { "location": "259/ACT"     , "narrator": "", "text": "醤油"},
        { "location": "260/TALK"    , "narrator": "アーヤ", "text": "薄口？濃口？"},
        { "location": "261/ACT"     , "narrator": "", "text": "みりんと醤油"},
        { "location": "262/TALK"    , "narrator": "アーヤ", "text": "煮物みたいね"},
        { "location": "263/ACT"     , "narrator": "", "text": "砂糖"},
        { "location": "264/TALK"    , "narrator": "アーヤ", "text": "甘いやつなのね"},
        { "location": "265/ACT"     , "narrator": "", "text": "砂糖醤油"},
        { "location": "266/TALK"    , "narrator": "アーヤ", "text": "甘じょっぱいやつね"},
        { "location": "267/ACT"     , "narrator": "", "text": "塩麹"},
        { "location": "268/TALK"    , "narrator": "アーヤ", "text": "おしゃれ！"},
        { "location": "269/ACT"     , "narrator": "", "text": "よくわからない"},
        { "location": "270/TALK"    , "narrator": "アーヤ", "text": "料理はあまりしないのね"},
        { "location": "272/TALK"    , "narrator": "アーヤ", "text": "うちは甘いやつだったんだけど"},
        { "location": "273/TALK"    , "narrator": "アーヤ", "text": "$handle$さんはそういうの平気？"},
        { "location": "275/SEL"     , "narrator": "", "text": "平気"},
        { "location": "276/SEL"     , "narrator": "", "text": "そのうち慣れると思う"},
        { "location": "277/SEL"     , "narrator": "", "text": "アーヤの料理は全部おいしい"},
        { "location": "278/ACT"     , "narrator": "", "text": "平気"},
        { "location": "279/TALK"    , "narrator": "アーヤ", "text": "その言い方"},
        { "location": "281/TALK"    , "narrator": "アーヤ", "text": "ちょっと"},
        { "location": "282/TALK"    , "narrator": "アーヤ", "text": "作り甲斐がないわ"},
        { "location": "283/ACT"     , "narrator": "", "text": "そのうち慣れると思う"},
        { "location": "284/TALK"    , "narrator": "アーヤ", "text": "あら"},
        { "location": "286/TALK"    , "narrator": "アーヤ", "text": "しょっぱい派なのね"},
        { "location": "287/ACT"     , "narrator": "", "text": "アーヤの料理は全部おいしい"},
        { "location": "297/TALK"    , "narrator": "アーヤ", "text": "あら"},
        { "location": "299/TALK"    , "narrator": "アーヤ", "text": "そうかしら＼(◎o◎)／"},
        { "location": "300/TALK"    , "narrator": "アーヤ", "text": "ならいいんだけど"},
        { "location": "302/TALK"    , "narrator": "アーヤ", "text": "お弁当にね"},
        { "location": "303/TALK"    , "narrator": "アーヤ", "text": "卵焼きは入ってないといけないでしょ"},
        { "location": "304/TALK"    , "narrator": "アーヤ", "text": "だから"},
        { "location": "305/TALK"    , "narrator": "アーヤ", "text": "何味がいいかしらって思って聞いてみたの"},
        { "location": "307/SEL"     , "narrator": "", "text": "ウィンナーも入れてほしいな"},
        { "location": "308/SEL"     , "narrator": "", "text": "アーヤのお弁当楽しみ！"},
        { "location": "309/ACT"     , "narrator": "", "text": "ウィンナーも入れてほしいな"},
        { "location": "310/TALK"    , "narrator": "アーヤ", "text": "いいわね"},
        { "location": "311/TALK"    , "narrator": "アーヤ", "text": "タコさんにしたやつよね"},
        { "location": "312/ACT"     , "narrator": "", "text": "アーヤのお弁当楽しみ！"},
        { "location": "313/TALK"    , "narrator": "アーヤ", "text": "そう"},
        { "location": "314/TALK"    , "narrator": "アーヤ", "text": "張り切って作っちゃう"},
        { "location": "316/TALK"    , "narrator": "アーヤ", "text": "食べて欲しいわ"},
        { "location": "317/TALK"    , "narrator": "アーヤ", "text": "いつかちゃんとね"},
        { "location": "320/TALK"    , "narrator": "ボイスメール", "text": "郷土料理ってほどでもないけど"},
        { "location": "293/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>1000pt.</b></color></size>\nアップしました！"},
        { "location": "332/DIALOG"  , "narrator": "Dialog_GETVoice", "text": "<color=green>【アーヤ】</color>のボイスメール\n<color=red>【郷土料理ってほどでもないけど】</color>\nをゲットしました！"}
    ]
}
