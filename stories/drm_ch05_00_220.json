        { "location": "1718/TALK"    , "narrator": "神楽", "text": "つばめさんって本当心の底から女の子～～って感じの人ですよね～～～"},
        { "location": "1720/SEL"     , "narrator": "", "text": "$me$は神楽一筋だから"},
        { "location": "1721/SEL"     , "narrator": "", "text": "確かにかわいい系だよね"},
        { "location": "1722/SEL"     , "narrator": "", "text": "ちょっと苦手だな…"},
        { "location": "1723/ACT"     , "narrator": "", "text": "$me$は神楽一筋だから"},
        { "location": "1725/TALK"    , "narrator": "神楽", "text": "ぴょんこったら愛され系★"},
        { "location": "1726/TALK"    , "narrator": "神楽", "text": "ﾃﾚﾁｬｳ、、、ﾎﾟｯ、、、"},
        { "location": "1727/ACT"     , "narrator": "", "text": "確かにかわいい系だよね"},
        { "location": "1728/TALK"    , "narrator": "神楽", "text": "でしょでしょでしょでしょ～～～～！"},
        { "location": "1729/ACT"     , "narrator": "", "text": "ちょっと苦手だな…"},
        { "location": "1731/TALK"    , "narrator": "神楽", "text": "そうなんですか？？？"},
        { "location": "1733/TALK"    , "narrator": "神楽", "text": "ぴょんこに遠慮しなくていいんですよ？？？"},
        { "location": "1735/TALK"    , "narrator": "神楽", "text": "一緒に外出したくらいで秘密とか"},
        { "location": "1736/TALK"    , "narrator": "神楽", "text": "どれだけかわいいこと言い出すのかって思っちゃいましたよ♪"},
        { "location": "1738/SEL"     , "narrator": "", "text": "そういうとこも好きなんでしょ？"},
        { "location": "1739/SEL"     , "narrator": "", "text": "$me$のほうがかわいいのに…"},
        { "location": "1740/SEL"     , "narrator": "", "text": "神楽が一番かわいいよ！"},
        { "location": "1741/ACT"     , "narrator": "", "text": "そういうとこも好きなんでしょ？"},
        { "location": "1742/TALK"    , "narrator": "神楽", "text": "嫌いじゃないですよもちろん"},
        { "location": "1743/ACT"     , "narrator": "", "text": "$me$のほうがかわいいのに…"},
        { "location": "1744/TALK"    , "narrator": "神楽", "text": "ﾔﾀﾞーー"},
        { "location": "1745/TALK"    , "narrator": "神楽", "text": "そんなのぴょんこ知ってますぴょん♪"},
        { "location": "1746/ACT"     , "narrator": "", "text": "神楽が一番かわいいよ！"},
        { "location": "1747/TALK"    , "narrator": "神楽", "text": "ですよね？"},
        { "location": "1748/TALK"    , "narrator": "神楽", "text": "ぴょんこ知ってますけどそのくらい"},
        { "location": "1750/TALK"    , "narrator": "神楽", "text": "でもつばめさんはつばめさんで、、、ｸﾞﾌﾌ、、、"},
        { "location": "1754/TALK"    , "narrator": "神楽", "text": "なんでしょうね？"},
        { "location": "1755/TALK"    , "narrator": "神楽", "text": "ぴょんこは認知が歪んでしまっているんでしょうか？"},
        { "location": "1756/TALK"    , "narrator": "神楽", "text": "つばめさんが本当に可愛い人に見えるんですよ、、、"},
        { "location": "1759/SEL"     , "narrator": "", "text": "別に変じゃないと思う"},
        { "location": "1760/SEL"     , "narrator": "", "text": "百合カミングアウトされてもﾅｰ"},
        { "location": "1761/SEL"     , "narrator": "", "text": "それのどこがダメなの？"},
        { "location": "1762/ACT"     , "narrator": "", "text": "別に変じゃないと思う"},
        { "location": "1763/TALK"    , "narrator": "神楽", "text": "$handle$さんから見てもつばめさんは本物なんですね、、、"},
        { "location": "1764/ACT"     , "narrator": "", "text": "百合カミングアウトされてもﾅｰ"},
        { "location": "1765/TALK"    , "narrator": "神楽", "text": "そういうんじゃないですよ"},
        { "location": "1766/TALK"    , "narrator": "神楽", "text": "そういうのかもしれませんけど"},
        { "location": "1767/ACT"     , "narrator": "", "text": "それのどこがダメなの？"},
        { "location": "1768/TALK"    , "narrator": "神楽", "text": "、、、別にダメじゃないんですかね、、、？"},
        { "location": "1770/TALK"    , "narrator": "神楽", "text": "いっそ嫌いなタイプの人間だったらぴょんこはこんなに悩んでないと思うんです"},
        { "location": "1771/TALK"    , "narrator": "神楽", "text": "つばめさんのことで"},
        { "location": "1773/SEL"     , "narrator": "", "text": "わかるよ"},
        { "location": "1774/SEL"     , "narrator": "", "text": "$me$との関係でも悩んで欲しいな～"},
        { "location": "1775/SEL"     , "narrator": "", "text": "大丈夫、うまくいくから"},
        { "location": "1776/ACT"     , "narrator": "", "text": "わかるよ"},
        { "location": "1779/TALK"    , "narrator": "神楽", "text": "わかってくれますか？"},
        { "location": "1780/TALK"    , "narrator": "神楽", "text": "ぴょんこ自身も面倒くさい立場ですし"},
        { "location": "1781/TALK"    , "narrator": "神楽", "text": "どうしてもしなきゃいけないこともありますし"},
        { "location": "1782/TALK"    , "narrator": "神楽", "text": "叫びだしたくなっちゃいます"},
        { "location": "1783/TALK"    , "narrator": "神楽", "text": "ああああああああああああ！"},
        { "location": "1785/ACT"     , "narrator": "", "text": "$me$との関係でも悩んで欲しいな～"},
        { "location": "1786/TALK"    , "narrator": "神楽", "text": "それは口説き文句ですか？"},
        { "location": "1787/TALK"    , "narrator": "神楽", "text": "だったらもっとうんとロマンチックなシチュエーションで言ってくれないとだめですよ★"},
        { "location": "1789/TALK"    , "narrator": "神楽", "text": "わかってないですね～～～も～！"},
        { "location": "1790/ACT"     , "narrator": "", "text": "大丈夫、うまくいくから"},
        { "location": "1791/TALK"    , "narrator": "神楽", "text": "その根拠のない自信ってどこからくるんでしょう？"},
        { "location": "1792/TALK"    , "narrator": "神楽", "text": "ぴょんこ時々不思議なんですけど、、、"},
        { "location": "1793/TALK"    , "narrator": "神楽", "text": "でもそれを聞くと少し安心できるような気がするんですよね"},
        { "location": "1795/TALK"    , "narrator": "神楽", "text": "不思議なことに"},
        { "location": "1796/TALK"    , "narrator": "神楽", "text": "なんででしょうね？"}
