{
    "dir": "chap20/daydra/anime_04_20.js",
    "type": "MainStory",
    "info": {
        "story_id": "20401",
        "cid": "miyabi",
        "title": "001 アニメーション",
        "sub_title": "EXE_GARBiELa"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "アニメ第20話"},
        { "location": "47/TALK"   , "narrator": "千羽鶴", "text": "ごきげんよう。\n今週はガブリエラ\n強化月間。"},
        { "location": "48/TALK"   , "narrator": "千羽鶴", "text": "MV回だから、\nガブリエラのMVを\n再生するだけにしていい？"},
        { "location": "49/SEL"    , "narrator": "", "text": "はい"},
        { "location": "50/SEL"    , "narrator": "", "text": "いいえ"},
        { "location": "51/SEL"    , "narrator": "", "text": "MVの再生すら不要"},
        { "location": "52/ACT"    , "narrator": "", "text": "はい"},
        { "location": "54/TALK"   , "narrator": "千羽鶴", "text": "よかった。\n私も助かる。\nこれぞWIN-WINね。"},
        { "location": "56/ACT"    , "narrator": "", "text": "いいえ"},
        { "location": "57/TALK"   , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "59/ACT"    , "narrator": "", "text": "MVの再生すら不要"},
        { "location": "61/TALK"   , "narrator": "千羽鶴", "text": "そう。\nそれじゃここでお別れね。"},
        { "location": "62/TALK"   , "narrator": "千羽鶴", "text": "また今度。"},
        { "location": "67/TALK"   , "narrator": "千羽鶴", "text": "ごきげんよう。"},
        { "location": "68/SEL"    , "narrator": "", "text": "前のノリに戻った！？"},
        { "location": "69/ACT"    , "narrator": "", "text": "前のノリに戻った！？"},
        { "location": "71/TALK"   , "narrator": "千羽鶴", "text": "そう。今回は\nガブリエラMV回だから。"},
        { "location": "72/TALK"   , "narrator": "千羽鶴", "text": "日本古来の戦が\nそうしていたように、\n何事にも合意休戦は必要。"},
        { "location": "73/TALK"   , "narrator": "千羽鶴", "text": "今回貴方には、何ひとつ\n構えることなくMVを楽しん\nで欲しいと思ってる。"},
        { "location": "74/TALK"   , "narrator": "千羽鶴", "text": "だから大道具を\n以前のものに戻してみた。"},
        { "location": "75/SEL"    , "narrator": "", "text": "なるほど"},
        { "location": "76/SEL"    , "narrator": "", "text": "そもそも戦ってません"},
        { "location": "77/ACT"    , "narrator": "", "text": "なるほど"},
        { "location": "78/ACT"    , "narrator": "", "text": "そもそも戦ってません"},
        { "location": "79/TALK"   , "narrator": "千羽鶴", "text": "なるほど。"},
        { "location": "81/TALK"   , "narrator": "千羽鶴", "text": "そういうわけだから、\n今回は心をカラッポにして\n彼女を堪能して欲しい。"},
        { "location": "82/SEL"    , "narrator": "", "text": "はーい"},
        { "location": "83/SEL"    , "narrator": "", "text": "ガブちゃんは天使！"},
        { "location": "84/SEL"    , "narrator": "", "text": "いやいや無理でしょ"},
        { "location": "85/ACT"    , "narrator": "", "text": "はーい"},
        { "location": "86/TALK"   , "narrator": "千羽鶴", "text": "いい子。"},
        { "location": "87/ACT"    , "narrator": "", "text": "ガブちゃんは天使！"},
        { "location": "88/TALK"   , "narrator": "千羽鶴", "text": "そ、そうね…。"},
        { "location": "89/ACT"    , "narrator": "", "text": "いやいや無理でしょ"},
        { "location": "90/TALK"   , "narrator": "千羽鶴", "text": "先を急ぎたいのはわかる。\nでも、息抜きも必要。"},
        { "location": "91/TALK"   , "narrator": "千羽鶴", "text": "ちゃんと息抜きしないと\n精神的に滅入ってしまい\n帰って来れなくなる。"},
        { "location": "92/SEL"    , "narrator": "", "text": "それは言い過ぎでは？"},
        { "location": "93/SEL"    , "narrator": "", "text": "ここから先、そんなに凄いの…？"},
        { "location": "94/ACT"    , "narrator": "", "text": "それは言い過ぎでは？"},
        { "location": "95/TALK"   , "narrator": "千羽鶴", "text": "それはどうかしら。"},
        { "location": "96/TALK"   , "narrator": "千羽鶴", "text": "是非とも貴方の無限に\n広がる想像の海で、色んな\n想いを馳せてみて欲しい。"},
        { "location": "97/ACT"    , "narrator": "", "text": "ここから先、そんなに凄いの…？"},
        { "location": "98/TALK"   , "narrator": "千羽鶴", "text": "……。"},
        { "location": "99/TALK"   , "narrator": "千羽鶴", "text": "確かに言い過ぎたかも。"},
        { "location": "101/TALK"  , "narrator": "千羽鶴", "text": "いずれにせよ、\n今回は掛け値無しに、\nビックリ企画はない。"},
        { "location": "102/TALK"  , "narrator": "千羽鶴", "text": "だからホントに\nリラックスして\n楽しんで欲しい。"},
        { "location": "104/TALK"  , "narrator": "千羽鶴", "text": "ちなみに、今回は\nポエムもナシで。"},
        { "location": "105/SEL"   , "narrator": "", "text": "やっぱり"},
        { "location": "106/SEL"   , "narrator": "", "text": "えー"},
        { "location": "107/ACT"   , "narrator": "", "text": "やっぱり"},
        { "location": "108/TALK"  , "narrator": "千羽鶴", "text": "無い事は想定済みと。\n酷い反応。"},
        { "location": "109/ACT"   , "narrator": "", "text": "えー"},
        { "location": "110/TALK"  , "narrator": "千羽鶴", "text": "また書けと。\n酷い仕打ち。"},
        { "location": "112/TALK"  , "narrator": "千羽鶴", "text": "というわけで、\nどうする？"},
        { "location": "115/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/36MB 2:22】</color>"},
        { "location": "116/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/13MB 2:22】</color>"},
        { "location": "117/SEL"   , "narrator": "", "text": "映像をスキップする"},
        { "location": "118/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/36MB 2:22】</color>"},
        { "location": "119/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "125/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/13MB 2:22】</color>"},
        { "location": "126/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "132/ACT"   , "narrator": "", "text": "映像をスキップする"},
        { "location": "133/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "146/TALK"  , "narrator": "千羽鶴", "text": "というわけで、\n素敵なMVだった。"},
        { "location": "147/TALK"  , "narrator": "千羽鶴", "text": "ガブリエラに\nラブラブできたでしょう。"},
        { "location": "149/SEL"   , "narrator": "", "text": "ガブリエラがとても可愛かった"},
        { "location": "150/SEL"   , "narrator": "", "text": "音楽がよかった"},
        { "location": "151/SEL"   , "narrator": "", "text": "男の子とは話せるようになるんだろうか"},
        { "location": "152/SEL"   , "narrator": "", "text": "銃と少女の組み合わせは最高ですね"},
        { "location": "153/SEL"   , "narrator": "", "text": "次の子のMVはいつ、誰が配信されますか？"},
        { "location": "154/SEL"   , "narrator": "", "text": "千羽鶴のMVはいつ出ますか？"},
        { "location": "155/SEL"   , "narrator": "", "text": "特にない \n<color=blue>（※先へ進みます）</color>"},
        { "location": "156/ACT"   , "narrator": "", "text": "ガブリエラがとても可愛かった"},
        { "location": "157/TALK"  , "narrator": "千羽鶴", "text": "そうね。\n彼女はとても\nカワイイと思う。"},
        { "location": "158/TALK"  , "narrator": "千羽鶴", "text": "しっかりしてるから\n忘れがちだけど、\n彼女はまだ――"},
        { "location": "161/TALK"  , "narrator": "千羽鶴", "text": "<size=40><color=red>中学生だから！</color></size>"},
        { "location": "162/TALK"  , "narrator": "千羽鶴", "text": "海外の子は独り立ちが\n早いとか、戦火の中育った\nとか、色々あるけど――"},
        { "location": "165/TALK"  , "narrator": "千羽鶴", "text": "<size=40><color=red>中学生だから！</color></size>"},
        { "location": "166/TALK"  , "narrator": "千羽鶴", "text": "やはりまだ、感情を制御\nできなかったり、経験が\n足りなかったりする。"},
        { "location": "167/TALK"  , "narrator": "千羽鶴", "text": "だから、貴方がしっかりと\n支えてあげて欲しい。"},
        { "location": "168/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "170/ACT"   , "narrator": "", "text": "音楽がよかった"},
        { "location": "171/TALK"  , "narrator": "千羽鶴", "text": "そう。\nそれはよかった。"},
        { "location": "172/TALK"  , "narrator": "千羽鶴", "text": "彼女の母国語を\n沢山堪能できて\n良かったと思う。"},
        { "location": "173/TALK"  , "narrator": "千羽鶴", "text": "そんな貴方に朗報。"},
        { "location": "174/TALK"  , "narrator": "千羽鶴", "text": "このMVの配信と同時に、\n然るべき場所で歌曲の\nフルVerも公開してる。"},
        { "location": "175/TALK"  , "narrator": "千羽鶴", "text": "興味があれば、是非\n探して聞いてみると\nいいかも。"},
        { "location": "176/TALK"  , "narrator": "千羽鶴", "text": "ガブリエラの可愛さを\nより深く堪能できると\n思うから。"},
        { "location": "177/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "179/ACT"   , "narrator": "", "text": "男の子とは話せるようになるんだろうか"},
        { "location": "180/TALK"  , "narrator": "千羽鶴", "text": "それは貴方次第。"},
        { "location": "181/TALK"  , "narrator": "千羽鶴", "text": "貴方が男だろうが\n女だろうが関係無く、\n貴方の関わり次第。"},
        { "location": "182/TALK"  , "narrator": "千羽鶴", "text": "彼女が男性と喋れないのは\n心因性のもの。"},
        { "location": "183/TALK"  , "narrator": "千羽鶴", "text": "貴方が彼女のココロに\n深く関わり、その問題を\n解決できれば……"},
        { "location": "184/TALK"  , "narrator": "千羽鶴", "text": "彼女は今よりずっと\n素敵になれる。"},
        { "location": "185/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "187/ACT"   , "narrator": "", "text": "銃と少女の組み合わせは最高ですね"},
        { "location": "188/TALK"  , "narrator": "千羽鶴", "text": "そうね。\n彼女にはとても\nよく似合う。"},
        { "location": "189/TALK"  , "narrator": "千羽鶴", "text": "私にはマネできない\n可愛さ。"},
        { "location": "190/SEL"   , "narrator": "", "text": "千羽鶴も銃を持ってみて！"},
        { "location": "191/SEL"   , "narrator": "", "text": "確かに千羽鶴には似合わないな"},
        { "location": "192/ACT"   , "narrator": "", "text": "千羽鶴も銃を持ってみて！"},
        { "location": "193/TALK"  , "narrator": "千羽鶴", "text": "いいえ。\n私は銃を持ってなくても\n殺せるから。"},
        { "location": "194/SEL"   , "narrator": "", "text": "何を！？"},
        { "location": "195/SEL"   , "narrator": "", "text": "やはりな。"},
        { "location": "196/ACT"   , "narrator": "", "text": "何を！？"},
        { "location": "197/ACT"   , "narrator": "", "text": "やはりな。"},
        { "location": "199/TALK"  , "narrator": "千羽鶴", "text": "…言ってみたかっただけ。"},
        { "location": "200/TALK"  , "narrator": "千羽鶴", "text": "真剣に受け答えする\n$handle$が\nちょっと可愛かった。"},
        { "location": "201/ACT"   , "narrator": "", "text": "確かに千羽鶴には似合わないな"},
        { "location": "202/TALK"  , "narrator": "千羽鶴", "text": "むっ。"},
        { "location": "203/TALK"  , "narrator": "千羽鶴", "text": "私に銃が似合わないなんて\nそんなこと思ってる貴方の\nセンスも大した事ない。"},
        { "location": "204/SEL"   , "narrator": "", "text": "自分で「マネできない」って言ってたし！"},
        { "location": "205/ACT"   , "narrator": "", "text": "自分で「マネできない」って言ってたし！"},
        { "location": "207/TALK"  , "narrator": "千羽鶴", "text": "サソイウケに\n決まってるから！"},
        { "location": "209/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "211/ACT"   , "narrator": "", "text": "次の子のMVはいつ、誰が配信されますか？"},
        { "location": "212/TALK"  , "narrator": "千羽鶴", "text": "それはまだ\n公表できない。"},
        { "location": "213/TALK"  , "narrator": "千羽鶴", "text": "私としては、この辺という\nアタリはつけているけど、\nもう少し待って欲しい。"},
        { "location": "214/TALK"  , "narrator": "千羽鶴", "text": "けど、そう遠くない時期に\nなると思うから、首を\n洗って待っていて。"},
        { "location": "215/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "217/ACT"   , "narrator": "", "text": "千羽鶴のMVはいつ出ますか？"},
        { "location": "218/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "219/SEL"   , "narrator": "", "text": "お"},
        { "location": "220/ACT"   , "narrator": "", "text": "お"},
        { "location": "224/TALK"  , "narrator": "千羽鶴", "text": "<size=260>私</size>"},
        { "location": "227/TALK"  , "narrator": "千羽鶴", "text": "<size=230>は</size>"},
        { "location": "230/TALK"  , "narrator": "千羽鶴", "text": "<size=200>あ</size>"},
        { "location": "234/TALK"  , "narrator": "千羽鶴", "text": "<size=170>る</size>"},
        { "location": "238/TALK"  , "narrator": "千羽鶴", "text": "<size=140>意</size>"},
        { "location": "242/TALK"  , "narrator": "千羽鶴", "text": "<size=110>味</size>"},
        { "location": "246/TALK"  , "narrator": "千羽鶴", "text": "<size=80>攻</size>"},
        { "location": "250/TALK"  , "narrator": "千羽鶴", "text": "<size=50>略</size>"},
        { "location": "254/TALK"  , "narrator": "千羽鶴", "text": "<size=30>対</size>"},
        { "location": "258/TALK"  , "narrator": "千羽鶴", "text": "<size=20>象</size>"},
        { "location": "265/TALK"  , "narrator": "千羽鶴", "text": "わかった？"},
        { "location": "266/SEL"   , "narrator": "", "text": "意味が分かりません！"},
        { "location": "267/SEL"   , "narrator": "", "text": "新方式！？"},
        { "location": "268/ACT"   , "narrator": "", "text": "意味が分かりません！"},
        { "location": "269/TALK"  , "narrator": "千羽鶴", "text": "そう？"},
        { "location": "270/TALK"  , "narrator": "千羽鶴", "text": "「ある意味」という弱さが\nMV回の否定を裏付けて\nいるわけだけど。"},
        { "location": "271/ACT"   , "narrator": "", "text": "新方式！？"},
        { "location": "272/TALK"  , "narrator": "千羽鶴", "text": "毎回同じだと\nマンネリするでしょ。"},
        { "location": "273/TALK"  , "narrator": "千羽鶴", "text": "ちーはいつも\n貴方にサプライズを\n提供するのに全力！"},
        { "location": "275/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "277/ACT"   , "narrator": "", "text": "特にない \n<color=blue>（※先へ進みます）</color>"},
        { "location": "279/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "281/TALK"  , "narrator": "千羽鶴", "text": "今回はガブリエラに\n特化する為、他の\nエピソードはない。"},
        { "location": "282/TALK"  , "narrator": "千羽鶴", "text": "是非MVやバトル、まだ\n見ていない彼女とのらぶ\nとーくを楽しんで欲しい。"},
        { "location": "286/TALK"  , "narrator": "千羽鶴", "text": "そして今回も１つ、貴方に\nボーナスプレゼントの\nお知らせがある。"},
        { "location": "287/TALK"  , "narrator": "千羽鶴", "text": "ガブリエラのエピソードを\nこのMVまで到達した人は\n全員ゲットできる。"},
        { "location": "288/TALK"  , "narrator": "千羽鶴", "text": "私との会話が終わったら、\n是非イベントクエストへ\n向かって欲しい。"},
        { "location": "293/TALK"  , "narrator": "千羽鶴", "text": "そこにも\n『EXE_GARBiELRA』\nというイベントがある。"},
        { "location": "294/TALK"  , "narrator": "千羽鶴", "text": "そこで、なかなか手に\n入りにくいプレゼント\nアイテム等がもらえる。"},
        { "location": "299/TALK"  , "narrator": "千羽鶴", "text": "ここまで来てる人には\nもはや全プレレベルだから\n是非立ち寄ってみて。"},
        { "location": "300/SEL"   , "narrator": "", "text": "行ってきます！"},
        { "location": "301/SEL"   , "narrator": "", "text": "そういえば何で綴りが「ガルビエラ」さんなの？"},
        { "location": "302/ACT"   , "narrator": "", "text": "行ってきます！"},
        { "location": "303/TALK"  , "narrator": "千羽鶴", "text": "いってらっしゃい。"},
        { "location": "304/TALK"  , "narrator": "千羽鶴", "text": "今日もお仕事頑張ってね。\nあなた。"},
        { "location": "305/TALK"  , "narrator": "千羽鶴", "text": "お小遣いは\n１５０円だけど。"},
        { "location": "306/TALK"  , "narrator": "千羽鶴", "text": "そんなわけで、\n貴方に素敵な\nガブリエライフを。"},
        { "location": "307/ACT"   , "narrator": "", "text": "そういえば何で綴りが「ガルビエラ」さんなの？"},
        { "location": "308/TALK"  , "narrator": "千羽鶴", "text": "いいところに気づいた。"},
        { "location": "309/TALK"  , "narrator": "千羽鶴", "text": "決して誤字などではなく、\nそれが本来の、戸籍登録\nされてるポーランド記述。"},
        { "location": "310/TALK"  , "narrator": "千羽鶴", "text": "日本で言うなら\n旧漢字みたいなもの。"},
        { "location": "311/TALK"  , "narrator": "千羽鶴", "text": "読み方も、決して\nガルビエラではないから\n注意するように。"},
        { "location": "312/TALK"  , "narrator": "千羽鶴", "text": "覚えておくと、きっと\n今後の人生において\n天文学的確率で得をする。"},
        { "location": "313/TALK"  , "narrator": "千羽鶴", "text": "というわけで、\n貴方に素敵な\nガルビエライフを。"},
        { "location": "291/DIALOG", "narrator": "Event/Dialog_EventPicWideNW", "text": "イ ベ ン ト ク エ ス ト の EXE_GARBiELA さ ん （年齢不詳）"},
        { "location": "337/DIALOG", "narrator": "Dialog_chapter_ch04", "text": "【16 しあわせのパンツ】"}
    ]
}
