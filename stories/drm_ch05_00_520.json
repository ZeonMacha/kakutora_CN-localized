    "entry":
    [
        { "location": "922/SCENARIO", "narrator": "", "text": "ケータイ小説"},
        { "location": "947/TALK"    , "narrator": "神楽", "text": "リアルなぴょんこの話を小説にした"},
        { "location": "949/SEL"     , "narrator": "", "text": "守秘義務とか大丈夫？"},
        { "location": "950/SEL"     , "narrator": "", "text": "読んだ方がいいのかな…"},
        { "location": "951/SEL"     , "narrator": "", "text": "小説って時点で創作だよね"},
        { "location": "952/ACT"     , "narrator": "", "text": "守秘義務とか大丈夫？"},
        { "location": "953/TALK"    , "narrator": "神楽", "text": "そういうのには抵触しないぴょん"},
        { "location": "954/ACT"     , "narrator": "", "text": "読んだ方がいいのかな…"},
        { "location": "955/TALK"    , "narrator": "神楽", "text": "$handle$に読んで欲しくて書いたのにそんなこと言うの？"},
        { "location": "956/TALK"    , "narrator": "神楽", "text": "さみしいなー"},
        { "location": "957/TALK"    , "narrator": "神楽", "text": "っていうか"},
        { "location": "958/TALK"    , "narrator": "神楽", "text": "読めよ"},
        { "location": "959/TALK"    , "narrator": "神楽", "text": "読めよな！！！！"},
        { "location": "960/ACT"     , "narrator": "", "text": "小説って時点で創作だよね"},
        { "location": "961/TALK"    , "narrator": "神楽", "text": "夢がないこと言うなー"},
        { "location": "963/TALK"    , "narrator": "神楽", "text": "リアルぴょんこはヤンキーのカレがいたけど死別して"},
        { "location": "965/TALK"    , "narrator": "神楽", "text": "さらに自分もなんか白血病とかになったりして"},
        { "location": "966/TALK"    , "narrator": "神楽", "text": "でも世界の中心で愛を叫んだりした"},
        { "location": "968/SEL"     , "narrator": "", "text": "それって本当に2016年の話？？？"},
        { "location": "969/SEL"     , "narrator": "", "text": "いやそんなことなかったよね…"},
        { "location": "970/SEL"     , "narrator": "", "text": "あったなあそんな話"},
        { "location": "971/ACT"     , "narrator": "", "text": "それって本当に2016年の話？？？"},
        { "location": "972/TALK"    , "narrator": "神楽", "text": "何を本当と定義すればいいのかな？"},
        { "location": "973/ACT"     , "narrator": "", "text": "いやそんなことなかったよね…"},
        { "location": "974/TALK"    , "narrator": "神楽", "text": "そうだったっけ？？？"},
        { "location": "975/TALK"    , "narrator": "神楽", "text": "おっかしーなー？"},
        { "location": "976/ACT"     , "narrator": "", "text": "あったなあそんな話"},
        { "location": "977/TALK"    , "narrator": "神楽", "text": "そうでしょー"},
        { "location": "979/TALK"    , "narrator": "神楽", "text": "ぴょんこはリアルラブを追求した"},
        { "location": "980/TALK"    , "narrator": "神楽", "text": "そしてそれをケータイ小説にした"},
        { "location": "982/SEL"     , "narrator": "", "text": "なんで！？"},
        { "location": "983/SEL"     , "narrator": "", "text": "リアルラブは$me$と追求しよう！"},
        { "location": "984/SEL"     , "narrator": "", "text": "映画化狙わないとね"},
        { "location": "985/ACT"     , "narrator": "", "text": "なんで！？"},
        { "location": "986/TALK"    , "narrator": "神楽", "text": "いや"},
        { "location": "987/TALK"    , "narrator": "神楽", "text": "なんとなく？"},
        { "location": "988/ACT"     , "narrator": "", "text": "リアルラブは$me$と追求しよう！"},
        { "location": "990/TALK"    , "narrator": "神楽", "text": "えっとえっと"},
        { "location": "991/TALK"    , "narrator": "神楽", "text": "どうしよっかな？？？"},
        { "location": "995/ACT"     , "narrator": "", "text": "映画化狙わないとね"},
        { "location": "996/TALK"    , "narrator": "神楽", "text": "イイネイイネ！"},
        { "location": "997/TALK"    , "narrator": "神楽", "text": "目指すはカンヌ映画祭"},
        { "location": "998/TALK"    , "narrator": "神楽", "text": "レッドカーペットを歩くのはぴょんこ！"},
        { "location": "999/TALK"    , "narrator": "神楽", "text": "ってそうなると原作も主演もぴょんこなの？"},
        { "location": "1000/TALK"   , "narrator": "神楽", "text": "えっそれってすごくない！？"},
        { "location": "1001/TALK"   , "narrator": "神楽", "text": "ぴょんこすごいまじですごい！"},
        { "location": "1003/TALK"   , "narrator": "神楽", "text": "いやなんていうかさ"},
        { "location": "1004/TALK"   , "narrator": "神楽", "text": "ケータイ小説のリアルって陳腐だし都市伝説レベルにありえないことだし"},
        { "location": "1005/TALK"   , "narrator": "神楽", "text": "独特な文化だなーって思って"},
        { "location": "1006/TALK"   , "narrator": "神楽", "text": "ちょっと興味あって"},
        { "location": "1007/TALK"   , "narrator": "神楽", "text": "やってみようかなーって"},
        { "location": "1009/SEL"    , "narrator": "", "text": "いややらなくてもいいでしょ…"},
        { "location": "1010/SEL"    , "narrator": "", "text": "現実から逃げたいのかな？"},
        { "location": "1011/SEL"    , "narrator": "", "text": "創作活動煮詰まってるの？"},
        { "location": "1012/ACT"    , "narrator": "", "text": "いややらなくてもいいでしょ…"},
        { "location": "1013/TALK"   , "narrator": "神楽", "text": "まずやってみないと"},
        { "location": "1014/TALK"   , "narrator": "神楽", "text": "適性があるかどうかもわからないよ？"},
        { "location": "1015/ACT"    , "narrator": "", "text": "現実から逃げたいのかな？"},
        { "location": "1016/TALK"   , "narrator": "神楽", "text": "まあね（真顔"},
        { "location": "1017/TALK"   , "narrator": "神楽", "text": "言わせんなよﾊﾞｶ"},
        { "location": "1018/ACT"    , "narrator": "", "text": "創作活動煮詰まってるの？"},
        { "location": "1019/TALK"   , "narrator": "神楽", "text": "煮詰まってるのは"},
        { "location": "1020/TALK"   , "narrator": "神楽", "text": "人生全般"},
        { "location": "1022/TALK"   , "narrator": "神楽", "text": "物語ってさ"},
        { "location": "1023/TALK"   , "narrator": "神楽", "text": "人を癒やす力があるんだって"},
        { "location": "1024/TALK"   , "narrator": "神楽", "text": "だったらいっそ、自分のためだけにものすごくシビアな物語を生んで"},
        { "location": "1025/TALK"   , "narrator": "神楽", "text": "それが全てうまくいくって話を作れば癒やされるかなって"},
        { "location": "1026/TALK"   , "narrator": "神楽", "text": "そーゆー"},
        { "location": "1027/SEL"    , "narrator": "", "text": "$me$が癒やしてあげる"},
        { "location": "1028/SEL"    , "narrator": "", "text": "$me$じゃ癒やしにならないのかな"},
        { "location": "1029/SEL"    , "narrator": "", "text": "むしろ$me$が癒やされたい！！！"},
        { "location": "1030/TALK"   , "narrator": "神楽", "text": "アレ"},
        { "location": "1031/TALK"   , "narrator": "神楽", "text": "疲れてるの"},
        { "location": "1032/TALK"   , "narrator": "神楽", "text": "要は"},
        { "location": "1035/ACT"    , "narrator": "", "text": "$me$が癒やしてあげる"},
        { "location": "1036/TALK"   , "narrator": "神楽", "text": "全力でね！！！！"},
        { "location": "1037/TALK"   , "narrator": "神楽", "text": "いやして"},
        { "location": "1038/ACT"    , "narrator": "", "text": "$me$じゃ癒やしにならないのかな"},
        { "location": "1039/TALK"   , "narrator": "神楽", "text": "なるっていうのは悔しい、、、"},
        { "location": "1040/TALK"   , "narrator": "神楽", "text": "要はそーゆーこと"},
        { "location": "1041/ACT"    , "narrator": "", "text": "むしろ$me$が癒やされたい！！！"},
        { "location": "1042/TALK"   , "narrator": "神楽", "text": "正直だなおい！！！！"},
        { "location": "1043/TALK"   , "narrator": "神楽", "text": "みんなそう思ってる！！！"},
        { "location": "1045/TALK"   , "narrator": "神楽", "text": "そんでもって参考にケータイ小説読んでみたけど"},
        { "location": "1046/TALK"   , "narrator": "神楽", "text": "エログロナンセンスの極み"},
        { "location": "1048/TALK"   , "narrator": "神楽", "text": "それを会話とポエムじみたモノローグというオブラートに包んでリアル女子高生のリアル体験がベースと銘打ってる"},
        { "location": "1049/TALK"   , "narrator": "神楽", "text": "特殊な世界なんだぴょん"},
        { "location": "1051/SEL"    , "narrator": "", "text": "何で時々昭和の言い回しが混じるの？"},
        { "location": "1052/SEL"    , "narrator": "", "text": "女子の妄想が爆発してるんだ"},
        { "location": "1053/SEL"    , "narrator": "", "text": "神楽はその世界になじめそうなの？"},
        { "location": "1054/ACT"    , "narrator": "", "text": "何で時々昭和の言い回しが混じるの？"},
        { "location": "1055/TALK"   , "narrator": "神楽", "text": "さあ？？？"},
        { "location": "1056/TALK"   , "narrator": "神楽", "text": "なんでだろうね～"},
        { "location": "1057/ACT"    , "narrator": "", "text": "女子の妄想が爆発してるんだ"},
        { "location": "1058/TALK"   , "narrator": "神楽", "text": "そうそう！"},
        { "location": "1059/TALK"   , "narrator": "神楽", "text": "びっくりする～～～"},
        { "location": "1060/ACT"    , "narrator": "", "text": "神楽はその世界になじめそうなの？"},
        { "location": "1061/TALK"   , "narrator": "神楽", "text": "どうかな～"},
        { "location": "1062/TALK"   , "narrator": "神楽", "text": "がんばらないとﾑﾘｶﾓ、、、"},
        { "location": "1064/TALK"   , "narrator": "神楽", "text": "そんな妄想だらけの世界を共有するコンテンツ"},
        { "location": "1065/TALK"   , "narrator": "神楽", "text": "それがケータイ小説"},
        { "location": "1067/SEL"    , "narrator": "", "text": "そうなんだ？"},
        { "location": "1068/SEL"    , "narrator": "", "text": "$me$は神楽と世界を共有したい"},
        { "location": "1069/ACT"    , "narrator": "", "text": "そうなんだ？"},
        { "location": "1070/TALK"   , "narrator": "神楽", "text": "そうなんだよ～"},
        { "location": "1072/TALK"   , "narrator": "神楽", "text": "居心地がいい人はハマっちゃうんだろうねっていう"},
        { "location": "1073/ACT"    , "narrator": "", "text": "$me$は神楽と世界を共有したい"},
        { "location": "1074/TALK"   , "narrator": "神楽", "text": "いいねその幻想"},
        { "location": "1075/TALK"   , "narrator": "神楽", "text": "それこそが愛の形♪"},
        { "location": "1077/TALK"   , "narrator": "神楽", "text": "なんかそういう"},
        { "location": "1078/TALK"   , "narrator": "神楽", "text": "身内だけのやさしくて許された世界"},
        { "location": "1079/TALK"   , "narrator": "神楽", "text": "憧れる、、、、"},
        { "location": "1080/TALK"   , "narrator": "神楽", "text": "けどそれってクリエイターとしては敗北なのかもなんて思ったり"},
        { "location": "1081/TALK"   , "narrator": "神楽", "text": "どうなんだろうね？？？？"},
        { "location": "1083/SEL"    , "narrator": "", "text": "そういうのが必要な時もあるよ"},
        { "location": "1084/SEL"    , "narrator": "", "text": "$me$は神楽の身内だから！"},
        { "location": "1085/SEL"    , "narrator": "", "text": "神楽の全てを許そう…"},
        { "location": "1086/ACT"    , "narrator": "", "text": "そういうのが必要な時もあるよ"},
        { "location": "1087/TALK"   , "narrator": "神楽", "text": "大人なの$handle$"},
        { "location": "1088/TALK"   , "narrator": "神楽", "text": "やさしみ、、、"},
        { "location": "1089/ACT"    , "narrator": "", "text": "$me$は神楽の身内だから！"},
        { "location": "1090/TALK"   , "narrator": "神楽", "text": "そっかそっかそっかー"},
        { "location": "1092/TALK"   , "narrator": "神楽", "text": "うんそうだよね♪"},
        { "location": "1093/ACT"    , "narrator": "", "text": "神楽の全てを許そう…"},
        { "location": "1094/TALK"   , "narrator": "神楽", "text": "あっなんかｴﾗｿｰ"},
        { "location": "1096/TALK"   , "narrator": "神楽", "text": "でも許された！！！！"},
        { "location": "1098/TALK"   , "narrator": "神楽", "text": "波瀾万丈なｾｰｼｭﾝを送ったぴょんこは"},
        { "location": "1099/TALK"   , "narrator": "神楽", "text": "$handle$という真実のトゥルーラブを得て"},
        { "location": "1100/TALK"   , "narrator": "神楽", "text": "深い眠りにつくのだった、、、、"}
    ]
}
