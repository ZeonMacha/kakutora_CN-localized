    [
        { "location": "81/SCENARIO", "narrator": "", "text": "410_掟破りの大型爆弾"},
        { "location": "106/TALK"   , "narrator": "みやび", "text": "ほれ"},
        { "location": "107/TALK"   , "narrator": "みやび", "text": "土産だ"},
        { "location": "108/TALK"   , "narrator": "みやび", "text": "遠慮はするな"},
        { "location": "110/SEL"    , "narrator": "", "text": "どうも"},
        { "location": "111/SEL"    , "narrator": "", "text": "っていうか、何？"},
        { "location": "112/SEL"    , "narrator": "", "text": "気持ちだけでいいや……"},
        { "location": "113/ACT"    , "narrator": "", "text": "どうも"},
        { "location": "114/TALK"   , "narrator": "みやび", "text": "無感動じゃの"},
        { "location": "115/ACT"    , "narrator": "", "text": "っていうか、何？"},
        { "location": "116/TALK"   , "narrator": "みやび", "text": "モダマぞね"},
        { "location": "117/ACT"    , "narrator": "", "text": "気持ちだけでいいや……"},
        { "location": "118/TALK"   , "narrator": "みやび", "text": "遠慮しいやねえ"},
        { "location": "120/TALK"   , "narrator": "みやび", "text": "それより"},
        { "location": "121/TALK"   , "narrator": "みやび", "text": "折り入って話があるぞね"},
        { "location": "123/SEL"    , "narrator": "", "text": "いい話だったら聞く"},
        { "location": "124/SEL"    , "narrator": "", "text": "面倒くさい"},
        { "location": "125/SEL"    , "narrator": "", "text": "みやびと$me$はラブラブ"},
        { "location": "126/ACT"    , "narrator": "", "text": "いい話だったら聞く"},
        { "location": "127/TALK"   , "narrator": "みやび", "text": "そうか"},
        { "location": "128/TALK"   , "narrator": "みやび", "text": "なら"},
        { "location": "130/TALK"   , "narrator": "みやび", "text": "やめておこう"},
        { "location": "131/ACT"    , "narrator": "", "text": "面倒くさい"},
        { "location": "132/TALK"   , "narrator": "みやび", "text": "話すともっと面倒なことになるのだ"},
        { "location": "133/TALK"   , "narrator": "みやび", "text": "やめておくか"},
        { "location": "134/ACT"    , "narrator": "", "text": "みやびと$me$はラブラブ"},
        { "location": "144/TALK"   , "narrator": "みやび", "text": "左様"},
        { "location": "145/TALK"   , "narrator": "みやび", "text": "それは動かしがたい事実"},
        { "location": "147/SEL"    , "narrator": "", "text": "だよねー"},
        { "location": "148/SEL"    , "narrator": "", "text": "急にどうしたの"},
        { "location": "149/SEL"    , "narrator": "", "text": "また冗談言ってるの？"},
        { "location": "150/ACT"    , "narrator": "", "text": "だよねー"},
        { "location": "151/ACT"    , "narrator": "", "text": "急にどうしたの"},
        { "location": "152/ACT"    , "narrator": "", "text": "また冗談言ってるの？"},
        { "location": "154/TALK"   , "narrator": "みやび", "text": "つまり"},
        { "location": "155/TALK"   , "narrator": "みやび", "text": "あれだ"},
        { "location": "156/TALK"   , "narrator": "みやび", "text": "$handle$ときちんとお付き合いというやつをしようと決めたぞね"},
        { "location": "158/SEL"    , "narrator": "", "text": "え？"},
        { "location": "159/SEL"    , "narrator": "", "text": "なんでまた"},
        { "location": "160/SEL"    , "narrator": "", "text": "今までは違ってたんだ……"},
        { "location": "161/ACT"    , "narrator": "", "text": "え？"},
        { "location": "162/TALK"   , "narrator": "みやび", "text": "えとはなんだ"},
        { "location": "163/TALK"   , "narrator": "みやび", "text": "えとは"},
        { "location": "164/ACT"    , "narrator": "", "text": "なんでまた"},
        { "location": "165/TALK"   , "narrator": "みやび", "text": "なんでというか"},
        { "location": "166/TALK"   , "narrator": "みやび", "text": "なんというか"},
        { "location": "167/ACT"    , "narrator": "", "text": "今までは違ってたんだ……"},
        { "location": "168/TALK"   , "narrator": "みやび", "text": "そういうことになるぞね"},
        { "location": "170/TALK"   , "narrator": "みやび", "text": "うちは悟ったぞね"},
        { "location": "171/TALK"   , "narrator": "みやび", "text": "今回の一件で"},
        { "location": "172/TALK"   , "narrator": "みやび", "text": "$handle$は"},
        { "location": "173/TALK"   , "narrator": "みやび", "text": "なんというか"},
        { "location": "174/TALK"   , "narrator": "みやび", "text": "しょうまっこと"},
        { "location": "175/TALK"   , "narrator": "みやび", "text": "危なっかしい"},
        { "location": "178/SEL"    , "narrator": "", "text": "そうかも"},
        { "location": "179/SEL"    , "narrator": "", "text": "意外と頼れるよ"},
        { "location": "180/SEL"    , "narrator": "", "text": "それはこっちの台詞"},
        { "location": "181/ACT"    , "narrator": "", "text": "そうかも"},
        { "location": "182/TALK"   , "narrator": "みやび", "text": "自覚はあったのか"},
        { "location": "183/TALK"   , "narrator": "みやび", "text": "そういうことだから"},
        { "location": "184/TALK"   , "narrator": "みやび", "text": "うちがこじゃんと面倒を見てやるきね"},
        { "location": "185/ACT"    , "narrator": "", "text": "意外と頼れるよ"},
        { "location": "186/TALK"   , "narrator": "みやび", "text": "そういうところが危ないというのだ"},
        { "location": "187/TALK"   , "narrator": "みやび", "text": "だからうちが"},
        { "location": "189/TALK"   , "narrator": "みやび", "text": "面倒を見るというのだ"},
        { "location": "190/ACT"    , "narrator": "", "text": "それはこっちの台詞"},
        { "location": "191/TALK"   , "narrator": "みやび", "text": "そんなわけなかろ"},
        { "location": "192/TALK"   , "narrator": "みやび", "text": "いいから"},
        { "location": "193/TALK"   , "narrator": "みやび", "text": "うちに面倒をみさせるちや"},
        { "location": "195/TALK"   , "narrator": "みやび", "text": "あと"},
        { "location": "196/TALK"   , "narrator": "みやび", "text": "文句も言わせろ"},
        { "location": "199/TALK"   , "narrator": "ボイスメール", "text": "他人事に一言"},
        { "location": "140/DIALOG" , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>900pt.</b></color></size>\nアップしました！"},
        { "location": "211/DIALOG" , "narrator": "Dialog_GETVoice", "text": "<color=green>【みやび】</color>のボイスメール\n<color=red>【他人事に一言】</color>\nをゲットしました！"}
