{
    "dir": "chap12/daydra/dd_ch02_12_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "12256",
        "cid": "ayami",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "進路相談"
    },
    "entry":
    [
        { "location": "311/SCENARIO", "narrator": "", "text": "進路相談"},
        { "location": "324/TALK"    , "narrator": "繭", "text": "キリト、小テストの点数、\nちょっと酷過ぎる。"},
        { "location": "326/TALK"    , "narrator": "キリト", "text": "…テスト勉強、\n結構頑張ったんだけどな。"},
        { "location": "328/TALK"    , "narrator": "雛", "text": "う～ん…まあ、留年する\n心配はなさそうだけど――"},
        { "location": "329/TALK"    , "narrator": "雛", "text": "もう１０点くらいは\nあった方がいいかも…。"},
        { "location": "332/TALK"    , "narrator": "キリト", "text": "だよなぁ…今は良いけど、\n後々不安だし…。"},
        { "location": "335/TALK"    , "narrator": "アーヤ", "text": "就職のこと？"},
        { "location": "337/TALK"    , "narrator": "キリト", "text": "そうっす。"},
        { "location": "338/TALK"    , "narrator": "キリト", "text": "情報管理庁管轄下の\nどっかには入れるのは\nわかってるけど――"},
        { "location": "339/TALK"    , "narrator": "キリト", "text": "どうせなら、それなりに\nデカい企業に入りたい\nっすからね。"},
        { "location": "341/TALK"    , "narrator": "雛", "text": "キリトもそんなこと\n考えてるんだ？"},
        { "location": "344/TALK"    , "narrator": "キリト", "text": "テストの後は特にな。"},
        { "location": "346/TALK"    , "narrator": "キリト", "text": "綾水先輩、俺の成績だと\nどの辺りに入れると\n思うっすか？"},
        { "location": "348/TALK"    , "narrator": "アーヤ", "text": "ど、どうかしら…？\n私もまだ大学生だから\nよくわからないけど――"},
        { "location": "349/TALK"    , "narrator": "アーヤ", "text": "お役所勤めは、\nちょっと厳しいかも…。"},
        { "location": "351/TALK"    , "narrator": "雛", "text": "ていうか、そういう\n仕事はキリトに\n向いてなさそう。"},
        { "location": "353/TALK"    , "narrator": "キリト", "text": "はぁ…さすがの俺も、\n今回ばかりは凹んだわ。"},
        { "location": "354/TALK"    , "narrator": "キリト", "text": "もう留年さえしなけりゃ\n良い、って思うように\nしちまおうかなぁ？"},
        { "location": "355/TALK"    , "narrator": "雛", "text": "…本気でヘコんじゃってる\nみたいだね。"},
        { "location": "356/TALK"    , "narrator": "繭", "text": "こんなにヘコんでる\nキリトは、珍しい。"},
        { "location": "358/TALK"    , "narrator": "繭", "text": "何とかして、元気付けて\nあげたいけど…。"},
        { "location": "363/TALK"    , "narrator": "アーヤ", "text": "相当ショックだった\nみたいね。"},
        { "location": "365/TALK"    , "narrator": "雛", "text": "元気のないキリトを\n見てると、こっちまで\n落ち込んじゃいます。"},
        { "location": "368/TALK"    , "narrator": "キリト", "text": "はぁ…。"},
        { "location": "370/TALK"    , "narrator": "アーヤ", "text": "どうすれば少しは元気に\nなってくれるかしら？"},
        { "location": "371/TALK"    , "narrator": "アーヤ", "text": "…コッソリ聞いてみよう。"},
        { "location": "383/TALK"    , "narrator": "アーヤ", "text": "相談に乗ってもらえる？"},
        { "location": "385/SEL"     , "narrator": "", "text": "先輩って呼んでくれたらね"},
        { "location": "386/ACT"     , "narrator": "", "text": "先輩って呼んでくれたらね"},
        { "location": "388/TALK"    , "narrator": "アーヤ", "text": "聞かれてた(-ω-;)"},
        { "location": "389/TALK"    , "narrator": "アーヤ", "text": "じゃあ、先輩"},
        { "location": "390/TALK"    , "narrator": "アーヤ", "text": "キリト君を元気付ける方法、一緒に考えてもらえる？"},
        { "location": "392/SEL"     , "narrator": "", "text": "得意なものを磨こう"},
        { "location": "393/SEL"     , "narrator": "", "text": "勉強を教えてあげよう"},
        { "location": "394/ACT"     , "narrator": "", "text": "得意なものを磨こう"},
        { "location": "395/TALK"    , "narrator": "アーヤ", "text": "それなら、キリト君も頑張れるかも"},
        { "location": "396/TALK"    , "narrator": "アーヤ", "text": "早速言ってみるわ(*^-ﾟ)v"},
        { "location": "408/TALK"    , "narrator": "アーヤ", "text": "キリトくんって、得意な\n科目はなんだったかしら？"},
        { "location": "410/TALK"    , "narrator": "キリト", "text": "えっと、部隊指揮と\n模擬戦っすね。"},
        { "location": "412/TALK"    , "narrator": "雛", "text": "その二つに関していえば、\nトップクラスだもんねー。"},
        { "location": "415/TALK"    , "narrator": "キリト", "text": "へへっ、まあな。"},
        { "location": "420/TALK"    , "narrator": "アーヤ", "text": "それなら、その二つだけは\n特に力を入れて学んだ方が\n良いわ。"},
        { "location": "421/TALK"    , "narrator": "アーヤ", "text": "極めれば、そのスキルを\n活かせる職場に、優先的に\n就職できるし。"},
        { "location": "423/TALK"    , "narrator": "キリト", "text": "なるほど…どうせなら\n得意なことが活かせる\n職場がいいよな。"},
        { "location": "426/TALK"    , "narrator": "アーヤ", "text": "そういうこと。"},
        { "location": "427/TALK"    , "narrator": "アーヤ", "text": "もちろん、苦手な科目は\n捨てて良い、ってわけじゃ\nないけど。"},
        { "location": "428/TALK"    , "narrator": "キリト", "text": "わかってるって。"},
        { "location": "429/TALK"    , "narrator": "キリト", "text": "サンキュ、綾水先輩。\nなんか、ちょっとだけ\n軽くなったっす。"},
        { "location": "430/TALK"    , "narrator": "アーヤ", "text": "よかった、何とか元気に\nなってくれたみたい…。"},
        { "location": "431/ACT"     , "narrator": "", "text": "勉強を教えてあげよう"},
        { "location": "433/TALK"    , "narrator": "アーヤ", "text": "そうね"},
        { "location": "434/TALK"    , "narrator": "アーヤ", "text": "勉強に協力すれば、少しは元気出してくれるかも"},
        { "location": "446/TALK"    , "narrator": "アーヤ", "text": "もしよければだけど、\n私が勉強を教える、って\nいうのはどうかしら？"},
        { "location": "449/TALK"    , "narrator": "キリト", "text": "えっ！？"},
        { "location": "451/TALK"    , "narrator": "アーヤ", "text": "多分、今やってる範囲の\n内容なら、教えることが\nできると思うんだけど…。"},
        { "location": "454/TALK"    , "narrator": "キリト", "text": "そりゃ、教えてもらえる\nなら嬉しいけど――"},
        { "location": "456/TALK"    , "narrator": "キリト", "text": "本当に良いんすか？\nバイトや大学もあるから\n忙しいのに…。"},
        { "location": "458/TALK"    , "narrator": "アーヤ", "text": "う～ん…毎日は無理かな。"},
        { "location": "459/TALK"    , "narrator": "アーヤ", "text": "けど、勉強でどうしても\nわからないことが\nあった時に――"},
        { "location": "461/TALK"    , "narrator": "アーヤ", "text": "聞いてきてくれれば\n教えることくらいの\nことは出来るわ。"},
        { "location": "462/TALK"    , "narrator": "キリト", "text": "…………。"},
        { "location": "463/TALK"    , "narrator": "キリト", "text": "綾水先輩…\nマジで助かるっす！！"},
        { "location": "464/TALK"    , "narrator": "雛", "text": "あ、あの！"},
        { "location": "465/TALK"    , "narrator": "雛", "text": "あたしも、文系の授業が\nちょっと苦手で…。"},
        { "location": "467/TALK"    , "narrator": "アーヤ", "text": "ええ、良いわよ。"},
        { "location": "468/TALK"    , "narrator": "雛", "text": "やったー！！\n綾水様に教えてもらえる\nなんて、感激です！"},
        { "location": "472/TALK"    , "narrator": "アーヤ", "text": "ふふっ…とりあえず、\n今日はテストの見直し\nから始めましょ。"},
        { "location": "473/TALK"    , "narrator": "キリト", "text": "今からっすか！？"},
        { "location": "474/TALK"    , "narrator": "アーヤ", "text": "早い方がいいでしょ？\n日向さんも、答案用紙\n出して。"},
        { "location": "476/TALK"    , "narrator": "雛", "text": "わかりました！\nキリト、頑張ろうね！"},
        { "location": "478/TALK"    , "narrator": "キリト", "text": "…そうだな。\nよっしゃー、次は絶対\n良い点取るぜ！！"},
        { "location": "479/TALK"    , "narrator": "繭", "text": "良かった…キリトが\n元気になって…。"},
        { "location": "323/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>7月1日　4:08 PM</color>\nとある平日の午後、学園中庭にて。"},
        { "location": "490/DIALOG"  , "narrator": "Dialog_GEThimegoto_ch02", "text": "【覚えめでたく覚えておらず】"}
    ]
}
