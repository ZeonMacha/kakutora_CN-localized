{
    "dir": "chap06/daydra/dd_ch04_06_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "6412",
        "cid": "miyabi",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "ＰＣ不調"
    },
    "entry":
    [
        { "location": "139/SCENARIO", "narrator": "", "text": "ＰＣ不調"},
        { "location": "150/TALK"    , "narrator": "アーヤ", "text": "…どう、\n直りそうかしら？"},
        { "location": "152/TALK"    , "narrator": "みやび", "text": "ふむ…安心しい。\nこのノートＰＣは\n壊れちょらんき。"},
        { "location": "154/TALK"    , "narrator": "みやび", "text": "ただ、スペックが\n激低で、何をするんも\n時間が掛かるだけやき。"},
        { "location": "155/TALK"    , "narrator": "アーヤ", "text": "…そんなに低いの？"},
        { "location": "157/TALK"    , "narrator": "みやび", "text": "ああ、かなり低いなぁ。\n新しそうやけんど、\nまさか買ってすぐなが？"},
        { "location": "158/TALK"    , "narrator": "アーヤ", "text": "少し前に\n買ったばかりよ。"},
        { "location": "159/TALK"    , "narrator": "アーヤ", "text": "店員さんに薦められて、\n値段もお手ごろだった\nからいいかなって…。"},
        { "location": "160/TALK"    , "narrator": "アーヤ", "text": "どうにか\nならないかしら？"},
        { "location": "163/TALK"    , "narrator": "みやび", "text": "…そうやなぁ？"},
        { "location": "164/SEL"     , "narrator": "", "text": "お手上げ、と言おう"},
        { "location": "165/SEL"     , "narrator": "", "text": "どうにかしてあげて"},
        { "location": "166/SEL"     , "narrator": "", "text": "腕の見せ所ですぜ！"},
        { "location": "169/TALK"    , "narrator": "みやび", "text": "そもそも、これで何を\nしよう思うて買ったが？"},
        { "location": "171/TALK"    , "narrator": "アーヤ", "text": "レポートとか書いたり、\nあとはネットを\n見るためかしら。"},
        { "location": "172/TALK"    , "narrator": "みやび", "text": "なるほど、基本文章を\n書くためか…。"},
        { "location": "173/TALK"    , "narrator": "みやび", "text": "けんど、このスペック\nやとそれだけでもスト\nレス溜まりそうやね。"},
        { "location": "174/TALK"    , "narrator": "アーヤ", "text": "だから困ってるのよ。\n本当、\nどうにかならない？"},
        { "location": "178/TALK"    , "narrator": "みやび", "text": "…今よりもちっくと\nマシに思えるくらい\nにはできそうやけんど―"},
        { "location": "180/TALK"    , "narrator": "みやび", "text": "それで構わんか？"},
        { "location": "182/TALK"    , "narrator": "アーヤ", "text": "文字を打つのと、\nネットを快適に\n見られれば十分よ。"},
        { "location": "183/TALK"    , "narrator": "みやび", "text": "まあ、それくらいなら\n多分どうにかなるちや。"},
        { "location": "184/TALK"    , "narrator": "みやび", "text": "不要なソフトを消すき、\nそれで幾分かは\n軽くなるはずや。"},
        { "location": "186/TALK"    , "narrator": "アーヤ", "text": "よかった…\n本当、みやびが\nいてくれて助かったわ。"},
        { "location": "187/TALK"    , "narrator": "みやび", "text": "まあ、今度ＰＣ買う\n時は、うちに聞いて\nからにしい。"},
        { "location": "189/ACT"     , "narrator": "", "text": "お手上げ、と言おう"},
        { "location": "209/TALK"    , "narrator": "みやび", "text": "…そうやね"},
        { "location": "210/TALK"    , "narrator": "みやび", "text": "このスペックじゃ、何したところで高が知れてるき"},
        { "location": "222/TALK"    , "narrator": "みやび", "text": "…すまんなぁ。\nさすがにこれは、\nお手上げ状態ちや。"},
        { "location": "223/TALK"    , "narrator": "みやび", "text": "エラーや変なソフトが\n原因いうなら、対処は\nできたけんど――"},
        { "location": "225/TALK"    , "narrator": "みやび", "text": "元々低い性能をどうにか\nするいうんは、もう改造\nするしかないがよ。"},
        { "location": "228/TALK"    , "narrator": "アーヤ", "text": "そう…。"},
        { "location": "229/TALK"    , "narrator": "みやび", "text": "すまんね。"},
        { "location": "231/TALK"    , "narrator": "アーヤ", "text": "ううん、いいのよ。\n安かったし、いい勉強\nにもなったから――"},
        { "location": "233/TALK"    , "narrator": "アーヤ", "text": "次からはあまり安い物を\n買わないようにするわ。"},
        { "location": "234/TALK"    , "narrator": "みやび", "text": "値段やのうて、まずは\nスペックを確認しい。"},
        { "location": "235/ACT"     , "narrator": "", "text": "どうにかしてあげて"},
        { "location": "256/TALK"    , "narrator": "みやび", "text": "どうにか言われてもなぁ…"},
        { "location": "257/TALK"    , "narrator": "みやび", "text": "まあ、やれる限りはやってみるがよ"},
        { "location": "270/TALK"    , "narrator": "みやび", "text": "今よりもちっくとマシに\n思えるくらいには\nできそうやけんど――"},
        { "location": "271/TALK"    , "narrator": "みやび", "text": "それで構わんか？"},
        { "location": "272/TALK"    , "narrator": "アーヤ", "text": "文字を打つのと、\nネットを快適に\n見られれば十分よ。"},
        { "location": "273/TALK"    , "narrator": "みやび", "text": "まあ、それくらいなら\n多分どうにかなるちや。"},
        { "location": "274/TALK"    , "narrator": "みやび", "text": "不要なソフトを消すき、\nそれで幾分かは\n軽くなるはずや。"},
        { "location": "276/TALK"    , "narrator": "アーヤ", "text": "よかった…\n本当、みやびが\nいてくれて助かったわ。"},
        { "location": "277/TALK"    , "narrator": "みやび", "text": "まあ、今度ＰＣ買う\n時は、うちに聞いて\nからにしい。"},
        { "location": "278/ACT"     , "narrator": "", "text": "腕の見せ所ですぜ！"},
        { "location": "300/TALK"    , "narrator": "みやび", "text": "面白いこと言うやないか、相棒…"},
        { "location": "302/TALK"    , "narrator": "みやび", "text": "…うちの本気、よう見とけや！！"},
        { "location": "313/TALK"    , "narrator": "みやび", "text": "よっしゃ、とりあえず\nバラすところから\n始めるぞね。"},
        { "location": "314/TALK"    , "narrator": "アーヤ", "text": "は？　バラすって…\nまさか分解！？"},
        { "location": "316/TALK"    , "narrator": "みやび", "text": "アーヤ、辛いと思うが\nハッキリ言わせてもらう\nけんど――"},
        { "location": "319/TALK"    , "narrator": "みやび", "text": "こんなクソスペック\nＰＣ、弄る程度では\nなーんも変わらんちや！"},
        { "location": "320/TALK"    , "narrator": "みやび", "text": "やるならハードから\nゴッソリ変えな意味が\nないぞね。"},
        { "location": "321/TALK"    , "narrator": "みやび", "text": "パーツはうちの部屋に\nある最新の物を使うき、\n安心してえいよ。"},
        { "location": "323/TALK"    , "narrator": "アーヤ", "text": "い、いいわよ別に！\nそこまで大げさなこと\nしなくても…。"},
        { "location": "324/TALK"    , "narrator": "みやび", "text": "そこまでせんと、\nこいつは最強ＰＣに\n生まれ変われん！"},
        { "location": "327/TALK"    , "narrator": "アーヤ", "text": "最強にしてなんて\n言ってないでしょ！？"},
        { "location": "328/TALK"    , "narrator": "みやび", "text": "とにかく、うちは\nこいつを超ハイ\nスペックに改造する！"},
        { "location": "329/TALK"    , "narrator": "みやび", "text": "こんなにヤル気に\nなったん久しぶりやき。"},
        { "location": "330/TALK"    , "narrator": "みやび", "text": "大船に乗った気で\n待っとれ。"},
        { "location": "333/TALK"    , "narrator": "アーヤ", "text": "…止めるのは\n無理そうね。"},
        { "location": "336/TALK"    , "narrator": "アーヤ", "text": "せめて、ＯＳだけは\n変なの入れないでね？"},
        { "location": "148/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>5月12日　7:44 PM</color>\nとある夜、アーヤの部屋で。"},
        { "location": "347/DIALOG"  , "narrator": "Dialog_GEThimegoto_ch04", "text": "【うちのマシンが火を噴く、か？】"}
    ]
}
