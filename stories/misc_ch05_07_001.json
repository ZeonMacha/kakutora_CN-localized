        "title": "Extra002 ヒメゴトチャット",
        "sub_title": "タイガーリリィは夜眠る"
    },
    "entry":
    [
        { "location": "1014/SCENARIO", "narrator": "", "text": "タイガーリリィは夜眠る"},
        { "location": "1039/TALK"    , "narrator": "神楽", "text": "タイガーリリィは夜にしか開かない白くて大きな花をずっと見たいと思っていた"},
        { "location": "1040/TALK"    , "narrator": "神楽", "text": "だけどタイガーリリィはその花の咲く場所を知らなかった"},
        { "location": "1041/TALK"    , "narrator": "神楽", "text": "その花の咲く時間に起きていられる自信もなかった"},
        { "location": "1043/SEL"     , "narrator": "", "text": "月下美人かな"},
        { "location": "1044/SEL"     , "narrator": "", "text": "$me$が一緒に起きててあげる"},
        { "location": "1045/SEL"     , "narrator": "", "text": "花を見ることはできたの？"},
        { "location": "1046/ACT"     , "narrator": "", "text": "月下美人かな"},
        { "location": "1047/TALK"    , "narrator": "神楽", "text": "これはお話の中だけの花だから"},
        { "location": "1048/TALK"    , "narrator": "神楽", "text": "現実には存在しない"},
        { "location": "1049/ACT"     , "narrator": "", "text": "$me$が一緒に起きててあげる"},
        { "location": "1051/TALK"    , "narrator": "神楽", "text": "それだったらタイガーリリィもきっと花が見れたわね"},
        { "location": "1053/TALK"    , "narrator": "神楽", "text": "それはきっと一生忘れられない思い出になったはず"},
        { "location": "1054/ACT"     , "narrator": "", "text": "花を見ることはできたの？"},
        { "location": "1055/TALK"    , "narrator": "神楽", "text": "続きがあるから"},
        { "location": "1057/TALK"    , "narrator": "神楽", "text": "タイガーリリィはその話をいつ聞いたかも憶えていなかった"},
        { "location": "1058/TALK"    , "narrator": "神楽", "text": "そして大きくなるにつれタイガーリリィはその話自体を忘れてしまった"},
        { "location": "1059/TALK"    , "narrator": "神楽", "text": "大人になったタイガーリリィはハネムーンの夜にその話を思い出した"},
        { "location": "1060/TALK"    , "narrator": "神楽", "text": "タイガーリリィは旦那さまにその話をしようとして、結局自分の心にしまっておくことにした"},
        { "location": "1061/TALK"    , "narrator": "神楽", "text": "どうしてだと思う？"},
        { "location": "1063/SEL"     , "narrator": "", "text": "仲が悪かったから"},
        { "location": "1064/SEL"     , "narrator": "", "text": "大人になったから"},
        { "location": "1065/SEL"     , "narrator": "", "text": "たいした話じゃないから"},
        { "location": "1066/ACT"     , "narrator": "", "text": "仲が悪かったから"},
        { "location": "1068/TALK"    , "narrator": "神楽", "text": "ある意味正しいけど"},
        { "location": "1069/TALK"    , "narrator": "神楽", "text": "もうそれでいいか"},
        { "location": "1070/ACT"     , "narrator": "", "text": "大人になったから"},
        { "location": "1071/TALK"    , "narrator": "神楽", "text": "正解"},
        { "location": "1072/TALK"    , "narrator": "神楽", "text": "絶対に辿り着けない場所だってわかっちゃったのよ"},
        { "location": "1074/TALK"    , "narrator": "神楽", "text": "昔の夢は"},
        { "location": "1075/ACT"     , "narrator": "", "text": "たいした話じゃないから"},
        { "location": "1076/TALK"    , "narrator": "神楽", "text": "まあ確かにそうではあるんだけど"},
        { "location": "1078/TALK"    , "narrator": "神楽", "text": "話せば聞いてもらえたとは思う"},
        { "location": "1079/TALK"    , "narrator": "神楽", "text": "旦那さまがタイガーリリィを愛しているなら"}
    ]
}
