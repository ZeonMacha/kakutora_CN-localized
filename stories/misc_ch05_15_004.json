        { "location": "4511/SCENARIO", "narrator": "", "text": "カノン"},
        { "location": "4536/TALK"    , "narrator": "神楽", "text": "カノンって言うとクラシックー！って感じだけど"},
        { "location": "4537/TALK"    , "narrator": "神楽", "text": "輪唱って言うと突然ランク落ち"},
        { "location": "4539/SEL"     , "narrator": "", "text": "今意味を知ったよ"},
        { "location": "4540/SEL"     , "narrator": "", "text": "だよねー"},
        { "location": "4541/SEL"     , "narrator": "", "text": "静かな湖畔の森のかげからー"},
        { "location": "4542/ACT"     , "narrator": "", "text": "今意味を知ったよ"},
        { "location": "4543/TALK"    , "narrator": "神楽", "text": "形式的なところでは同じなわけ"},
        { "location": "4544/ACT"     , "narrator": "", "text": "だよねー"},
        { "location": "4545/TALK"    , "narrator": "神楽", "text": "ねー？"},
        { "location": "4546/ACT"     , "narrator": "", "text": "静かな湖畔の森のかげからー"},
        { "location": "4548/TALK"    , "narrator": "神楽", "text": "もう起きちゃいかがとカッコウが鳴くー"},
        { "location": "4549/TALK"    , "narrator": "神楽", "text": "カッコーカッコーカッコカッコカコー♪"},
        { "location": "4550/TALK"    , "narrator": "神楽", "text": "ワンスモア！"},
        { "location": "4553/SEL"     , "narrator": "", "text": "yes!"},
        { "location": "4554/SEL"     , "narrator": "", "text": "まだやるの？"},
        { "location": "4555/SEL"     , "narrator": "", "text": "ついて来いよベイビー！"},
        { "location": "4557/TALK"    , "narrator": "神楽", "text": "いや"},
        { "location": "4558/TALK"    , "narrator": "神楽", "text": "やっぱいいわ"},
        { "location": "4559/ACT"     , "narrator": "", "text": "まだやるの？"},
        { "location": "4560/TALK"    , "narrator": "神楽", "text": "しなくてもいいかも？"},
        { "location": "4561/ACT"     , "narrator": "", "text": "ついて来いよベイビー！"},
        { "location": "4563/TALK"    , "narrator": "神楽", "text": "倒れるまで輪唱！！！！"},
        { "location": "4566/SEL"     , "narrator": "", "text": "クレイジーだなヒャッハー！"},
        { "location": "4567/SEL"     , "narrator": "", "text": "それでこそ神楽！"},
        { "location": "4568/SEL"     , "narrator": "", "text": "カノンの力が世界に満ちる…"},
        { "location": "4569/ACT"     , "narrator": "", "text": "クレイジーだなヒャッハー！"},
        { "location": "4570/TALK"    , "narrator": "神楽", "text": "そうじゃなきゃ輪唱じゃない！"},
        { "location": "4571/TALK"    , "narrator": "神楽", "text": "禁じられた音楽、それが輪唱！"},
        { "location": "4572/ACT"     , "narrator": "", "text": "それでこそ神楽！"},
        { "location": "4573/TALK"    , "narrator": "神楽", "text": "何を・・・！"},
        { "location": "4574/TALK"    , "narrator": "神楽", "text": "本当のぴょんこはこんなんじゃないから・・・！"},
        { "location": "4575/ACT"     , "narrator": "", "text": "カノンの力が世界に満ちる…"},
        { "location": "4576/TALK"    , "narrator": "神楽", "text": "おお、、、神よ、、、"},
        { "location": "4577/TALK"    , "narrator": "神楽", "text": "あなたはどこにおわすのか、、、"},
        { "location": "4581/TALK"    , "narrator": "神楽", "text": "なんて。実際は全然違う楽曲のこと指すし"},
