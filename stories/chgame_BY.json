    "entry":
    [
        { "location": "505/SCENARIO", "narrator": "", "text": "BYボス（つばめ）"},
        { "location": "531/TALK"    , "narrator": "つばめ", "text": "まさかこんなところまで\n来ちゃうなんて……。"},
        { "location": "532/TALK"    , "narrator": "つばめ", "text": "お城への門は\n絶対に通さないから！"},
        { "location": "533/TALK"    , "narrator": "千羽鶴", "text": "ラスボスが現れた。"},
        { "location": "535/TALK"    , "narrator": "千羽鶴", "text": "気をつけて。\n彼女は本当に強い。"},
        { "location": "537/TALK"    , "narrator": "つばめ", "text": "$handle$さん、\n騙されちゃだめだよ！"},
        { "location": "538/TALK"    , "narrator": "つばめ", "text": "この子は全然\nいい子なんかじゃない！"},
        { "location": "539/TALK"    , "narrator": "つばめ", "text": "わたしの方が、\nよっぽどいい子だから！\nお願い、信じて！"},
        { "location": "540/SEL"     , "narrator": "", "text": "それには同意する"},
        { "location": "541/SEL"     , "narrator": "", "text": "千羽鶴もいい子だよ"},
        { "location": "542/ACT"     , "narrator": "", "text": "それには同意する"},
        { "location": "543/TALK"    , "narrator": "つばめ", "text": "ありがとう、えへへ……"},
        { "location": "544/TALK"    , "narrator": "つばめ", "text": "でも、じゃあどうして、\nその子の味方をするの？"},
        { "location": "545/ACT"     , "narrator": "", "text": "千羽鶴もいい子だよ"},
        { "location": "546/TALK"    , "narrator": "つばめ", "text": "むーっ！"},
        { "location": "547/TALK"    , "narrator": "つばめ", "text": "どうしてわたしより\nその子の味方をするの？"},
        { "location": "549/SEL"     , "narrator": "", "text": "「非攻略対象」の「非」を取り去るため"},
        { "location": "550/ACT"     , "narrator": "", "text": "「非攻略対象」の「非」を取り去るため"},
        { "location": "552/TALK"    , "narrator": "つばめ", "text": "あわわっ！\nそんなとんでもない\nことを！"},
        { "location": "554/TALK"    , "narrator": "つばめ", "text": "ならばやっぱり\n死んでもここを\n通さないから！"},
        { "location": "555/TALK"    , "narrator": "千羽鶴", "text": "逢瀬つばめは\n本気みたい。\n先手必勝で行く。"},
        { "location": "558/TALK"    , "narrator": "千羽鶴", "text": "私は\n非攻略対象！"},
        { "location": "566/TALK"    , "narrator": "つばめ", "text": "むーっ！"},
        { "location": "569/TALK"    , "narrator": "千羽鶴", "text": "私は\n非攻略対象！"},
        { "location": "577/TALK"    , "narrator": "つばめ", "text": "むーっ！"},
        { "location": "579/TALK"    , "narrator": "つばめ", "text": "死んでもここは\n通さないんだから！"},
        { "location": "580/TALK"    , "narrator": "千羽鶴", "text": "貴方が死んだら\n普通に通れると\n思うけど？"},
        { "location": "581/TALK"    , "narrator": "つばめ", "text": "無理だよ。\nだって――"},
        { "location": "582/TALK"    , "narrator": "つばめ", "text": "死ぬときは\n貴方も一緒だもん！"},
        { "location": "583/TALK"    , "narrator": "千羽鶴", "text": "…！？\nま、まさか貴方、\nあの技を……！？"},
        { "location": "584/TALK"    , "narrator": "つばめ", "text": "えーいっ！"},
        { "location": "593/TALK"    , "narrator": "千羽鶴", "text": "たいへん。\n身構えて！"},
        { "location": "594/TALK"    , "narrator": "つばめ", "text": "貴方を取り込んで\nわたしもろとも死ぬ！！"},
        { "location": "596/TALK"    , "narrator": "千羽鶴", "text": "とりこまれる！！"},
        { "location": "597/SEL"     , "narrator": "", "text": "千羽鶴を守る！"},
        { "location": "598/ACT"     , "narrator": "", "text": "千羽鶴を守る！"},
        { "location": "606/TALK"    , "narrator": "つばめ", "text": "やあぁぁぁぁっ！！"},
        { "location": "619/TALK"    , "narrator": "つばめ", "text": "そ…そんな。"},
        { "location": "620/TALK"    , "narrator": "つばめ", "text": "まさか、\nとりこみが\n拒絶されるなんて…"},
        { "location": "621/TALK"    , "narrator": "千羽鶴", "text": "私だって\nレベルアップしてる。"},
        { "location": "622/TALK"    , "narrator": "千羽鶴", "text": "それに今回は\n$handle$も\nいるもの。"},
        { "location": "623/TALK"    , "narrator": "つばめ", "text": "どう……し…て…　…"},
        { "location": "636/TALK"    , "narrator": "千羽鶴", "text": "やったわ。\nラスボスつばめを倒した。"},
        { "location": "637/TALK"    , "narrator": "千羽鶴", "text": "これも全部、\n貴方のお陰。"},
        { "location": "638/SEL"     , "narrator": "", "text": "どういたしまして"},
        { "location": "639/ACT"     , "narrator": "", "text": "どういたしまして"},
        { "location": "641/TALK"    , "narrator": "千羽鶴", "text": "さあ、ついに伝説の秘宝\n『非消滅の宝玉』が眠る\nお城が目の前に。"},
        { "location": "642/TALK"    , "narrator": "千羽鶴", "text": "早く行きましょ。"},
        { "location": "512/DIALOG"  , "narrator": "NOTICE", "text": "敵が現れた！！"},
        { "location": "557/DIALOG"  , "narrator": "INFO", "text": "千羽鶴のこうげき！"},
        { "location": "564/DIALOG"  , "narrator": "INFO", "text": "ラスボスつばめに\n１０ポイントのダメージ"},
        { "location": "567/DIALOG"  , "narrator": "INFO", "text": "ラスボスつばめは\nちからをためている…"},
        { "location": "568/DIALOG"  , "narrator": "INFO", "text": "千羽鶴のこうげき！"},
        { "location": "575/DIALOG"  , "narrator": "INFO", "text": "ラスボスつばめに\n１５ポイントのダメージ"},
        { "location": "578/DIALOG"  , "narrator": "INFO", "text": "ラスボスつばめは\nちからをためている…"},
        { "location": "589/DIALOG"  , "narrator": "INFO", "text": "ラスボスつばめは\n捨て身の魔法をとなえた！"},
        { "location": "600/DIALOG"  , "narrator": "INFO", "text": "$handle$は\nシールドを張った！"},
        { "location": "635/DIALOG"  , "narrator": "INFO", "text": "<color=red>【Congraturations!!】</color>\nラスボスつばめを倒した！"}
    ]
}
