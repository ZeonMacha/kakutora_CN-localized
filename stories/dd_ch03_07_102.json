{
    "dir": "chap07/daydra/dd_ch03_07_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "7305",
        "cid": "gabriella",
        "title": "005 メインストーリー",
        "sub_title": "リーダーに望むものは＜後編＞"
    },
    "entry":
    [
        { "location": "289/SCENARIO", "narrator": "", "text": "リーダーに望むものは"},
        { "location": "306/TALK"    , "narrator": "アーヤ", "text": "…大丈夫かしら？\n気が立ってるような\n声だったけど。"},
        { "location": "307/SEL"     , "narrator": "", "text": "ガブリエラが不満ダラダラだからフォローして"},
        { "location": "308/ACT"     , "narrator": "", "text": "ガブリエラが不満ダラダラだからフォローして"},
        { "location": "327/TALK"    , "narrator": "アーヤ", "text": "え！？"},
        { "location": "329/TALK"    , "narrator": "アーヤ", "text": "どうして！？"},
        { "location": "330/TALK"    , "narrator": "アーヤ", "text": "作戦に不満があったのかしら？"},
        { "location": "332/SEL"     , "narrator": "", "text": "言葉が足りない"},
        { "location": "333/ACT"     , "narrator": "", "text": "言葉が足りない"},
        { "location": "335/TALK"    , "narrator": "アーヤ", "text": "作戦はちゃんと伝えたでしょ？"},
        { "location": "336/TALK"    , "narrator": "アーヤ", "text": "あれ以上"},
        { "location": "337/TALK"    , "narrator": "アーヤ", "text": "何も言うことないわ"},
        { "location": "339/SEL"     , "narrator": "", "text": "アーヤに頼ってもらいたんだよ"},
        { "location": "340/ACT"     , "narrator": "", "text": "アーヤに頼ってもらいたんだよ"},
        { "location": "342/TALK"    , "narrator": "アーヤ", "text": "頼ってる！"},
        { "location": "343/TALK"    , "narrator": "アーヤ", "text": "いつも"},
        { "location": "344/TALK"    , "narrator": "アーヤ", "text": "一番信頼してるし"},
        { "location": "346/SEL"     , "narrator": "", "text": "それ本人に言おう"},
        { "location": "347/ACT"     , "narrator": "", "text": "それ本人に言おう"},
        { "location": "349/TALK"    , "narrator": "アーヤ", "text": "何で！？"},
        { "location": "350/TALK"    , "narrator": "アーヤ", "text": "恥ずかしいし"},
        { "location": "352/TALK"    , "narrator": "アーヤ", "text": "それに"},
        { "location": "354/TALK"    , "narrator": "アーヤ", "text": "そういうの得意じゃない"},
        { "location": "356/SEL"     , "narrator": "", "text": "リーダーなんでしょ？"},
        { "location": "357/ACT"     , "narrator": "", "text": "リーダーなんでしょ？"},
        { "location": "360/TALK"    , "narrator": "アーヤ", "text": "まあ"},
        { "location": "361/TALK"    , "narrator": "アーヤ", "text": "作戦成功が第一だし"},
        { "location": "362/TALK"    , "narrator": "アーヤ", "text": "それに"},
        { "location": "363/TALK"    , "narrator": "アーヤ", "text": "言葉にしなきゃ"},
        { "location": "364/TALK"    , "narrator": "アーヤ", "text": "伝わらないわね"},
        { "location": "375/TALK"    , "narrator": "アーヤ", "text": "…どう伝えたら\nいいのかしら？"},
        { "location": "380/TALK"    , "narrator": "アーヤ", "text": "…ギャヴィ。\n一つ言い忘れてた。"},
        { "location": "381/TALK"    , "narrator": "透明ガブリエラ", "text": "もう、なによ！？\nこっちは集中してるん\nだから！"},
        { "location": "383/TALK"    , "narrator": "アーヤ", "text": "今回の作戦の成功は、\nギャヴィの肩に\n掛かってるわ。"},
        { "location": "384/TALK"    , "narrator": "透明ガブリエラ", "text": "でしょうね。\n銃はあたしだけしか\n使えないものね？"},
        { "location": "385/TALK"    , "narrator": "アーヤ", "text": "銃が使えるから\n頼んだんじゃないわ。"},
        { "location": "388/TALK"    , "narrator": "アーヤ", "text": "こんな重要な役目を\n任せられるのは――"},
        { "location": "389/TALK"    , "narrator": "アーヤ", "text": "一番信頼してる\nギャヴィしかいない\nって思ったからよ。"},
        { "location": "390/TALK"    , "narrator": "透明ガブリエラ", "text": "…………。"},
        { "location": "393/TALK"    , "narrator": "アーヤ", "text": "…もう一度聞くけど、\nできる？"},
        { "location": "394/TALK"    , "narrator": "透明ガブリエラ", "text": "当然！\n任せておきなさい！"},
        { "location": "397/TALK"    , "narrator": "アーヤ", "text": "…ありがとう。"},
        { "location": "402/TALK"    , "narrator": "アーヤ", "text": "ふぅ…。"},
        { "location": "414/TALK"    , "narrator": "アーヤ", "text": "これでいい？"},
        { "location": "416/SEL"     , "narrator": "", "text": "上出来"},
        { "location": "417/ACT"     , "narrator": "", "text": "上出来"},
        { "location": "419/TALK"    , "narrator": "アーヤ", "text": "そうかしら？"},
        { "location": "422/SEL"     , "narrator": "", "text": "ギャヴィは素敵な結果を出すよ"},
        { "location": "423/ACT"     , "narrator": "", "text": "ギャヴィは素敵な結果を出すよ"},
        { "location": "425/TALK"    , "narrator": "アーヤ", "text": "そう"},
        { "location": "426/TALK"    , "narrator": "アーヤ", "text": "それなら"},
        { "location": "427/TALK"    , "narrator": "アーヤ", "text": "私も最大限尽くさないと"},
        { "location": "428/TALK"    , "narrator": "アーヤ", "text": "それじゃ"},
        { "location": "430/SEL"     , "narrator": "", "text": "待って、もう一つ"},
        { "location": "431/ACT"     , "narrator": "", "text": "待って、もう一つ"},
        { "location": "433/TALK"    , "narrator": "アーヤ", "text": "なに？"},
        { "location": "435/SEL"     , "narrator": "", "text": "凄く素敵だったよ、リーダーとして"},
        { "location": "436/ACT"     , "narrator": "", "text": "凄く素敵だったよ、リーダーとして"},
        { "location": "439/TALK"    , "narrator": "アーヤ", "text": "そう？"},
        { "location": "440/TALK"    , "narrator": "アーヤ", "text": "よくわからないけど"},
        { "location": "443/TALK"    , "narrator": "アーヤ", "text": "ありがとう"},
        { "location": "455/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "457/TALK"    , "narrator": "アーヤ", "text": "よし、私も頑張ろう！"},
        { "location": "468/DIALOG"  , "narrator": "Dialog_chapter_ch03", "text": "【05 金色の髪のカグラ】"}
    ]
}
