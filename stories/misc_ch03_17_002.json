        { "location": "69/SCENARIO", "narrator": "", "text": "026_雨よ止まないで"},
        { "location": "94/TALK"    , "narrator": "ガブリエラ", "text": "泣き出しそうな空模様って"},
        { "location": "95/TALK"    , "narrator": "ガブリエラ", "text": "マルザンナはわかるかしら？"},
        { "location": "97/SEL"     , "narrator": "", "text": "雨が降りそうだってことだよね"},
        { "location": "98/SEL"     , "narrator": "", "text": "まあ普通に"},
        { "location": "99/SEL"     , "narrator": "", "text": "詩的な表現だよね"},
        { "location": "100/ACT"    , "narrator": "", "text": "雨が降りそうだってことだよね"},
        { "location": "101/TALK"   , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "102/TALK"   , "narrator": "ガブリエラ", "text": "よくできました"},
        { "location": "103/ACT"    , "narrator": "", "text": "まあ普通に"},
        { "location": "104/TALK"   , "narrator": "ガブリエラ", "text": "あら"},
        { "location": "105/TALK"   , "narrator": "ガブリエラ", "text": "そういうものなのね"},
        { "location": "106/ACT"    , "narrator": "", "text": "詩的な表現だよね"},
        { "location": "108/TALK"   , "narrator": "ガブリエラ", "text": "そうなのよｖｖｖｖｖ"},
        { "location": "109/TALK"   , "narrator": "ガブリエラ", "text": "素敵な言い方よね/////////////////"},
        { "location": "111/TALK"   , "narrator": "ガブリエラ", "text": "でもね"},
        { "location": "112/TALK"   , "narrator": "ガブリエラ", "text": "やっぱり雨はいやなのよ"},
        { "location": "114/SEL"    , "narrator": "", "text": "そういう展開？"},
        { "location": "115/SEL"    , "narrator": "", "text": "だよね"},
        { "location": "116/SEL"    , "narrator": "", "text": "止まない雨はないよ"},
        { "location": "117/ACT"    , "narrator": "", "text": "そういう展開？"},
        { "location": "118/TALK"   , "narrator": "ガブリエラ", "text": "そうよ"},
        { "location": "119/TALK"   , "narrator": "ガブリエラ", "text": "だって"},
        { "location": "121/TALK"   , "narrator": "ガブリエラ", "text": "濡れるのはいやでしょう？"},
        { "location": "122/TALK"   , "narrator": "ガブリエラ", "text": "それとも"},
        { "location": "123/TALK"   , "narrator": "ガブリエラ", "text": "マルザンナはそうじゃないのかしら？"},
        { "location": "124/ACT"    , "narrator": "", "text": "だよね"},
        { "location": "125/TALK"   , "narrator": "ガブリエラ", "text": "そうだわよね"},
        { "location": "126/TALK"   , "narrator": "ガブリエラ", "text": "やっぱりそこは"},
        { "location": "127/TALK"   , "narrator": "ガブリエラ", "text": "現実的に考えなきゃね"},
        { "location": "128/ACT"    , "narrator": "", "text": "止まない雨はないよ"},
        { "location": "130/TALK"   , "narrator": "ガブリエラ", "text": "あら"},
        { "location": "131/TALK"   , "narrator": "ガブリエラ", "text": "そう考えればいいのねｖｖｖ"},
        { "location": "132/TALK"   , "narrator": "ガブリエラ", "text": "マルザンナったら素敵ねｖｖｖｖｖｖ"},
        { "location": "134/TALK"   , "narrator": "ガブリエラ", "text": "私もそう思うことにするわ"}
    ]
