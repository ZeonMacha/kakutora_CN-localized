    "info": {
        "story_id": "60431",
        "cid": "miyabi",
        "title": "敵Ⅰ＜葛藤＞",
        "sub_title": "バトル中盤"
    },
    "entry":
    [
        { "location": "203/SCENARIO", "narrator": "", "text": "バトル中盤"},
        { "location": "212/TALK"    , "narrator": "潜在みやび", "text": "ふむ……\nやはりコイツが味方に\nついた方が勝ったか。"},
        { "location": "213/TALK"    , "narrator": "表層みやび", "text": "当然の結果やね。"},
        { "location": "214/SEL"     , "narrator": "", "text": "$me$と戦ったのはどっちなの？"},
        { "location": "215/ACT"     , "narrator": "", "text": "$me$と戦ったのはどっちなの？"},
        { "location": "217/TALK"    , "narrator": "潜在みやび", "text": "それを言っちゃあ\nお終いやき。"},
        { "location": "218/TALK"    , "narrator": "表層みやび", "text": "ああ、おしまいや、\nおしまいや！"},
        { "location": "219/TALK"    , "narrator": "潜在みやび", "text": "忘れないでくりゃあ。\n$handle$さんよお。"},
        { "location": "220/TALK"    , "narrator": "表層みやび", "text": "確かにうちとコイツ、\nどちらかはアンタの\n戦友だが――"},
        { "location": "221/TALK"    , "narrator": "潜在みやび", "text": "その上位レイヤーには\n二人の敵という\nステータスがあるきね。"},
        { "location": "222/TALK"    , "narrator": "表層みやび", "text": "すなわち四捨五入\nすると、あんたは\n敵ってこっちゃね。"},
        { "location": "223/SEL"     , "narrator": "", "text": "なんで$me$がみやびの敵なの？？"},
        { "location": "224/ACT"     , "narrator": "", "text": "なんで$me$がみやびの敵なの？？"},
        { "location": "226/TALK"    , "narrator": "表層みやび", "text": "自分の胸に\n聞いてみいや。"},
        { "location": "227/TALK"    , "narrator": "潜在みやび", "text": "すまんがうちは、\nそんなステレオタイプ\nな質問に引っかかり――"},
        { "location": "228/TALK"    , "narrator": "表層みやび", "text": "突然説明口調で真相を\n解説し出すような大根\nライターキャラやない。"},
        { "location": "229/TALK"    , "narrator": "潜在みやび", "text": "さあ、\nもう十分休んだぞね。"},
        { "location": "230/TALK"    , "narrator": "表層みやび", "text": "うむ。\n後半戦、行くちや！"}
    ]
}
