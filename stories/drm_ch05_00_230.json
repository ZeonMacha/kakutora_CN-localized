{
    "dir": "dramatics/daydra/drm_ch05_00_230.js",
    "type": "Episode",
    "info": {
        "story_id": "5023",
        "cid": "kagura",
        "title": "らぶとーく 第23話",
        "sub_title": "イチゴちゃんはイチゴちゃん"
    },
    "entry":
    [
        { "location": "1815/SCENARIO", "narrator": "", "text": "イチゴちゃんはイチゴちゃん"},
        { "location": "1827/TALK"    , "narrator": "つばめ", "text": "視聴覚室、\n視聴覚室…。"},
        { "location": "1829/TALK"    , "narrator": "神楽", "text": "…この先で合ってる\nみたいですよ。"},
        { "location": "1831/TALK"    , "narrator": "つばめ", "text": "よかったー。"},
        { "location": "1832/TALK"    , "narrator": "つばめ", "text": "わたしの方が校内\nわかってるつもり\nだったのに。"},
        { "location": "1833/TALK"    , "narrator": "つばめ", "text": "ごめんね。"},
        { "location": "1835/TALK"    , "narrator": "つばめ", "text": "卯月さんがいないと\nたどり着けなかったよ。\nありがとう。"},
        { "location": "1838/TALK"    , "narrator": "神楽", "text": "いえ、私こそ。\nこの授業が視聴覚室だって\n知らなかったですし。"},
        { "location": "1839/TALK"    , "narrator": "神楽", "text": "つばめさんが声を掛けて\nくれなかったら教室で\n待ちぼうけでした。"},
        { "location": "1840/SEL"     , "narrator": "", "text": "ドジっ子選手権でもしてるの？"},
        { "location": "1841/ACT"     , "narrator": "", "text": "ドジっ子選手権でもしてるの？"},
        { "location": "1860/TALK"    , "narrator": "神楽", "text": "なんですかそれ"},
        { "location": "1861/TALK"    , "narrator": "神楽", "text": "してませんよそんなの"},
        { "location": "1877/TALK"    , "narrator": "つばめ", "text": "二人ともサボったって\n思われちゃう\nところだったね。"},
        { "location": "1878/TALK"    , "narrator": "つばめ", "text": "勘違いしてた\nだけなのに……。"},
        { "location": "1879/SEL"     , "narrator": "", "text": "いっそサボろうよ"},
        { "location": "1880/ACT"     , "narrator": "", "text": "いっそサボろうよ"},
        { "location": "1900/TALK"    , "narrator": "神楽", "text": "真面目なJKですから"},
        { "location": "1901/TALK"    , "narrator": "神楽", "text": "無理ですよ♪"},
        { "location": "1917/TALK"    , "narrator": "神楽", "text": "そうならなくて\nよかったです。"},
        { "location": "1918/TALK"    , "narrator": "神楽", "text": "私あんまり学校\n来れてないですし…。"},
        { "location": "1919/TALK"    , "narrator": "つばめ", "text": "…そうだよね…。\n病気とかなの？"},
        { "location": "1920/TALK"    , "narrator": "神楽", "text": "え…。"},
        { "location": "1921/SEL"     , "narrator": "", "text": "メノウだって言えば？"},
        { "location": "1922/ACT"     , "narrator": "", "text": "メノウだって言えば？"},
        { "location": "1941/TALK"    , "narrator": "神楽", "text": "それ以外の回答で"},
        { "location": "1943/SEL"     , "narrator": "", "text": "秘密を知ったら死が訪れる"},
        { "location": "1944/SEL"     , "narrator": "", "text": "アタマの、とか？"},
        { "location": "1945/SEL"     , "narrator": "", "text": "不良少女だからでしょー"},
        { "location": "1946/ACT"     , "narrator": "", "text": "秘密を知ったら死が訪れる"},
        { "location": "1947/TALK"    , "narrator": "神楽", "text": "いっそそうする"},
        { "location": "1960/TALK"    , "narrator": "神楽", "text": "知りたいですか？"},
        { "location": "1961/TALK"    , "narrator": "つばめ", "text": "え、えと…。"},
        { "location": "1962/TALK"    , "narrator": "神楽", "text": "つばめさんは\n本当のことを…\n知りたいですか？"},
        { "location": "1963/ACT"     , "narrator": "", "text": "アタマの、とか？"},
        { "location": "1964/TALK"    , "narrator": "神楽", "text": "それは貴様だ"},
        { "location": "1977/TALK"    , "narrator": "神楽", "text": "そのことなんです\nけども……。"},
        { "location": "1978/ACT"     , "narrator": "", "text": "不良少女だからでしょー"},
        { "location": "1979/TALK"    , "narrator": "神楽", "text": "違うし"},
        { "location": "1991/TALK"    , "narrator": "神楽", "text": "病気といえば\n病気かもしれません。"},
        { "location": "1995/TALK"    , "narrator": "神楽", "text": "ただひとつだけ。\n先に言っておく\nことがあります。"},
        { "location": "1996/TALK"    , "narrator": "神楽", "text": "私が学校にあまり\n来ない理由。"},
        { "location": "1997/TALK"    , "narrator": "神楽", "text": "これが知られて\nしまったら。"},
        { "location": "1998/TALK"    , "narrator": "神楽", "text": "私は月に帰らねば\nなりません。"},
        { "location": "1999/TALK"    , "narrator": "つばめ", "text": "えっと、\n待って待って！"},
        { "location": "2000/TALK"    , "narrator": "つばめ", "text": "それ同じようなこと\n転校初日にも\n言ってたよね！？"},
        { "location": "2001/TALK"    , "narrator": "神楽", "text": "あ。\nばれました？"},
        { "location": "2003/TALK"    , "narrator": "つばめ", "text": "そんなの当たり前\nでしょ！"},
        { "location": "2005/TALK"    , "narrator": "つばめ", "text": "…あと、ごめんね。"},
        { "location": "2007/TALK"    , "narrator": "つばめ", "text": "言いたくないこと\nなんだよね。"},
        { "location": "2009/TALK"    , "narrator": "つばめ", "text": "ごめんね。\nもう聞かないから。"},
        { "location": "2012/TALK"    , "narrator": "神楽", "text": "…………。\nいいんです。\n謝らないで。"},
        { "location": "2015/TALK"    , "narrator": "神楽", "text": "それより授業、\n始まっちゃいますよ！"},
        { "location": "2016/TALK"    , "narrator": "つばめ", "text": "そうだね。\n急がなきゃ！"},
        { "location": "2023/TALK"    , "narrator": "神楽", "text": "全くもう……。"},
        { "location": "2038/TALK"    , "narrator": "ボイスメール", "text": "解放空間"},
        { "location": "1826/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>某月某日　10:55 AM</color>\nとある平日、付属学園高等部でのこと"},
        { "location": "2050/DIALOG"  , "narrator": "Dialog_GETVoice", "text": "<color=green>【神楽】</color>のボイスメール\n<color=red>【解放空間】</color>\nをゲットしました！"}
    ]
}
