        { "location": "5/SCENARIO", "narrator": "", "text": "TGSつばめ"},
        { "location": "25/TALK"   , "narrator": "つばめ", "text": "んー、いい天気！"},
        { "location": "26/TALK"   , "narrator": "つばめ", "text": "晴れてよかったぁ。\n昨日、天気予報では\n雨って言ってたんだよ？"},
        { "location": "27/SEL"    , "narrator": "", "text": "そうだったんだ？"},
        { "location": "28/SEL"    , "narrator": "", "text": "雨だったらがっかりだった"},
        { "location": "29/ACT"    , "narrator": "", "text": "そうだったんだ？"},
        { "location": "30/TALK"   , "narrator": "つばめ", "text": "あなたとのデートが\n雨になりませんようにー！"},
        { "location": "31/TALK"   , "narrator": "つばめ", "text": "って、お願いしたのが\nよかったのかも。"},
        { "location": "32/ACT"    , "narrator": "", "text": "雨だったらがっかりだった"},
        { "location": "33/TALK"   , "narrator": "つばめ", "text": "本当だよぉ。"},
        { "location": "34/TALK"   , "narrator": "つばめ", "text": "せっかくの海デートで\n雨とかだったら、\nションボリだったよね。"},
        { "location": "36/TALK"   , "narrator": "つばめ", "text": "でも、もし雨だったら\n屋内デートだったのかな？"},
        { "location": "37/TALK"   , "narrator": "つばめ", "text": "それも悪くなかったかも。\n水族館とか映画とかも\n楽しそうだし。"},
        { "location": "38/SEL"    , "narrator": "", "text": "そっちの方がよかった"},
        { "location": "39/SEL"    , "narrator": "", "text": "それじゃつばめの水着が見れない！"},
        { "location": "40/ACT"    , "narrator": "", "text": "そっちの方がよかった"},
        { "location": "41/TALK"   , "narrator": "つばめ", "text": "もしかして、\nどこかデートしたいとこ\nあった？"},
        { "location": "42/SEL"    , "narrator": "", "text": "つばめの部屋がいい"},
        { "location": "43/SEL"    , "narrator": "", "text": "屋内の流れるプールとか"},
        { "location": "44/ACT"    , "narrator": "", "text": "つばめの部屋で"},
        { "location": "46/TALK"   , "narrator": "つばめ", "text": "そ、それは、えっと…。\nちょっと恥ずかしいかも。"},
        { "location": "47/TALK"   , "narrator": "つばめ", "text": "いつも部屋で話したりは\nしてるけど、デートで、\nって言われると…。"},
        { "location": "48/TALK"   , "narrator": "つばめ", "text": "ちょっと、\n緊張しちゃうかも…。"},
        { "location": "49/TALK"   , "narrator": "つばめ", "text": "あ、あはは。\nドキドキ、止まらなく\nなっちゃった…。"},
        { "location": "50/ACT"    , "narrator": "", "text": "屋内の流れるプールとか"},
        { "location": "51/TALK"   , "narrator": "つばめ", "text": "それも楽しそうかも！"},
        { "location": "52/TALK"   , "narrator": "つばめ", "text": "そういうところだったら、\n大きな滑り台とかも\nありそうだよね？"},
        { "location": "54/TALK"   , "narrator": "つばめ", "text": "あなたと一緒に、\nピッタリくっついて\n滑ったりできるかも…。"},
        { "location": "55/TALK"   , "narrator": "つばめ", "text": "えへへ…恥ずかしいけど、\n一緒に滑った方が\n絶対楽しいよね。"},
        { "location": "57/ACT"    , "narrator": "", "text": "それじゃつばめの水着が見れない"},
        { "location": "58/TALK"   , "narrator": "つばめ", "text": "えっ…わ、わたしの水着、\n見たかったの…？"},
        { "location": "60/TALK"   , "narrator": "つばめ", "text": "…改めて言われると、\nちょっと恥ずかしいかも。"},
        { "location": "61/TALK"   , "narrator": "つばめ", "text": "でも、そんなに楽しみに\nしてもらえてたのは、\nちょっと嬉しいな…。"},
        { "location": "63/SEL"    , "narrator": "", "text": "ちょっと触っていい？"},
        { "location": "64/ACT"    , "narrator": "", "text": "ちょっと触っていい？"},
        { "location": "67/TALK"   , "narrator": "つばめ", "text": "う、うん…。\nくすぐったいのは\nダメだよ？"},
        { "location": "86/TALK"   , "narrator": "つばめ", "text": "えへへ…、\n優しいツンツンだね。"},
        { "location": "88/TALK"   , "narrator": "つばめ", "text": "あ、あんまりイタズラ\nしたらダメだよ…？"},
        { "location": "95/TALK"   , "narrator": "つばめ", "text": "む、むぎゅ～……。"},
        { "location": "96/TALK"   , "narrator": "つばめ", "text": "あ、あはは…、\nちょっと恥ずかしいかも。"},
        { "location": "99/TALK"   , "narrator": "つばめ", "text": "きゃぁっ！？"},
        { "location": "100/TALK"  , "narrator": "つばめ", "text": "ふ、普通に触るのは\nダメー！！"},
        { "location": "106/TALK"  , "narrator": "つばめ", "text": "お、お腹ツンツンするの、\n変な感じだよぉ…。"},
        { "location": "108/TALK"  , "narrator": "つばめ", "text": "く、くすぐったいから…、\n優しくだよ？"},
        { "location": "114/TALK"  , "narrator": "つばめ", "text": "えへへ…ナデナデ、\nうれしいな…。"},
        { "location": "116/TALK"  , "narrator": "つばめ", "text": "…頭の中、ぽーって\nしてきちゃいそうかも…。"},
        { "location": "123/TALK"  , "narrator": "つばめ", "text": "む、むぎゅ～……。"},
        { "location": "124/TALK"  , "narrator": "つばめ", "text": "あ、あはは…、\nちょっと恥ずかしいかも。"},
        { "location": "127/TALK"  , "narrator": "つばめ", "text": "きゃぁっ！？"},
        { "location": "128/TALK"  , "narrator": "つばめ", "text": "ふ、普通に触るのは\nダメー！！"},
        { "location": "134/TALK"  , "narrator": "つばめ", "text": "えへへ…、\nお腹ナデナデ、\n落ち着くから好きだよ。"},
        { "location": "136/TALK"  , "narrator": "つばめ", "text": "く、くすぐったいから…、\n優しくだよ？"},
