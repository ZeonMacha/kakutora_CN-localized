{
    "dir": "chap08/daydra/dd_ch02_08_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "8205",
        "cid": "ayami",
        "title": "005 メインストーリー",
        "sub_title": "先輩会議＜後編＞"
    },
    "entry":
    [
        { "location": "333/SCENARIO", "narrator": "", "text": "先輩会議"},
        { "location": "362/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "363/TALK"    , "narrator": "アーヤ", "text": "まあ、まだ入隊した\nばかりなんだから――"},
        { "location": "364/TALK"    , "narrator": "アーヤ", "text": "わからないのは\n当然よね。"},
        { "location": "365/TALK"    , "narrator": "アーヤ", "text": "一人で悩んでても\n仕方ないし――"},
        { "location": "366/TALK"    , "narrator": "アーヤ", "text": "いい機会だし、\n二人にも聞いて\nみよう。"},
        { "location": "367/TALK"    , "narrator": "アーヤ", "text": "…お待たせ。"},
        { "location": "369/TALK"    , "narrator": "ガブリエラ", "text": "で？　お姉さんから\n返事あった？"},
        { "location": "370/TALK"    , "narrator": "アーヤ", "text": "う、ううん。\n返事なしよ。"},
        { "location": "373/TALK"    , "narrator": "みやび", "text": "…その割には、\n結構長くポチポチ\nしちょったね？"},
        { "location": "374/TALK"    , "narrator": "アーヤ", "text": "き、既読付かないかと\n思って、色々送って\nたのよ。"},
        { "location": "375/TALK"    , "narrator": "アーヤ", "text": "まあ、無駄に終わった\nけどね…。"},
        { "location": "376/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "377/TALK"    , "narrator": "アーヤ", "text": "そ、それより！！"},
        { "location": "379/TALK"    , "narrator": "アーヤ", "text": "二人とも、卯月のこと\nどう思った？"},
        { "location": "382/TALK"    , "narrator": "ガブリエラ", "text": "どうって…適応力は\n高そうだし、即戦力\nにはなりそうよね。"},
        { "location": "383/TALK"    , "narrator": "ガブリエラ", "text": "まあ、それくらいで\nあとは普通でしょ。"},
        { "location": "386/TALK"    , "narrator": "アーヤ", "text": "それこそ普通じゃ\nないと思うわ。"},
        { "location": "387/TALK"    , "narrator": "アーヤ", "text": "初陣で、あれだけの\n動きをしたのよ？"},
        { "location": "388/TALK"    , "narrator": "アーヤ", "text": "コネクトしても、\n状況判断能力までは\n上がらないのに…。"},
        { "location": "389/TALK"    , "narrator": "ガブリエラ", "text": "あたしの銃と同じで、\n入隊前から訓練して\nたんじゃないの？"},
        { "location": "392/TALK"    , "narrator": "みやび", "text": "それはないやろ。\n日本はラブ＆ピースの\n国やぞ？"},
        { "location": "394/TALK"    , "narrator": "みやび", "text": "…いや、今の日本は\nラブ＆フェノメノン\nやったか。"},
        { "location": "397/TALK"    , "narrator": "ガブリエラ", "text": "じゃあ、本当に\n才能だけで、あれだけ\n動けた、ってこと？"},
        { "location": "398/TALK"    , "narrator": "アーヤ", "text": "…だけ、ってことは\nないと思うけど…。"},
        { "location": "400/TALK"    , "narrator": "みやび", "text": "ちゅうか、卯月は\n汗臭いこととは\n無縁そうな――"},
        { "location": "402/TALK"    , "narrator": "みやび", "text": "ゴージャスな香りが\nぷんぷんすると\n思わん？"},
        { "location": "405/TALK"    , "narrator": "アーヤ", "text": "あ、わかるわかる。\n確かにそんな感じ\nするかも。"},
        { "location": "407/TALK"    , "narrator": "みやび", "text": "名探偵みやびさんの\n推理では――"},
        { "location": "409/TALK"    , "narrator": "みやび", "text": "卯月は中々えいとこの\nお嬢様やと思うがよ。"},
        { "location": "410/TALK"    , "narrator": "みやび", "text": "喋り方や仕草の\n端々に――"},
        { "location": "411/TALK"    , "narrator": "みやび", "text": "うちら庶民とは違う\nオーラを感じるがよ。"},
        { "location": "414/TALK"    , "narrator": "ガブリエラ", "text": "ふーん…あたしは\nキャラ作りだと\n思ったけど？"},
        { "location": "416/TALK"    , "narrator": "みやび", "text": "まあ、ハズレちょる\nかもしれんけんどね。"},
        { "location": "418/TALK"    , "narrator": "アーヤ", "text": "信じるわよ。\nみやびのそういう直感\nって、大抵当たるし。"},
        { "location": "420/TALK"    , "narrator": "みやび", "text": "相手の見えない電脳\n空間で、何年も鍛えて\nきた観察能力や。"},
        { "location": "424/TALK"    , "narrator": "ガブリエラ", "text": "それ聞くと、ネット\nサーフィンもバカに\nできないわね…。"},
        { "location": "426/TALK"    , "narrator": "みやび", "text": "けんど、あいつの\n性格的な部分は、\nうちにもわからん。"},
        { "location": "427/TALK"    , "narrator": "ガブリエラ", "text": "どじっこ天然娘？"},
        { "location": "429/TALK"    , "narrator": "みやび", "text": "けんど、正念場での\n機転の利かせ方は――"},
        { "location": "431/TALK"    , "narrator": "みやび", "text": "ビックリするほど\nシャープやったし。"},
        { "location": "434/TALK"    , "narrator": "ガブリエラ", "text": "つまり、よくわから\nない、ってことね？"},
        { "location": "436/TALK"    , "narrator": "みやび", "text": "卯月についての\n情報が、あまりにも\n少な過ぎるんよ。"},
        { "location": "438/TALK"    , "narrator": "みやび", "text": "例えば、卯月の入隊\nした経緯についてや\nけんど――。"},
        { "location": "440/TALK"    , "narrator": "みやび", "text": "誰か、まほさんから\n聞いたか？"},
        { "location": "442/TALK"    , "narrator": "アーヤ", "text": "そういえば、\n何も説明が\nなかったわ。"},
        { "location": "445/TALK"    , "narrator": "ガブリエラ", "text": "あの新人みたいに、\n偶然見つかったんじゃ\nないの？"},
        { "location": "447/TALK"    , "narrator": "みやび", "text": "…まあ、今のところ\n偶然発見率が優勢\nやきね。"},
        { "location": "449/TALK"    , "narrator": "みやび", "text": "アーヤも、偶然\nフェノメノンに巻き\n込まれたけんど――"},
        { "location": "450/TALK"    , "narrator": "みやび", "text": "正気の状態で、たった\n一人で初収束をさせた\nのがきっかけやし。"},
        { "location": "452/TALK"    , "narrator": "アーヤ", "text": "ギャヴィは正式な\n招集だったのよね？"},
        { "location": "454/TALK"    , "narrator": "ガブリエラ", "text": "ええ、トライガジェッ\nトを持ってたから――"},
        { "location": "455/TALK"    , "narrator": "ガブリエラ", "text": "管理庁から正式に\n招集されたのよ。"},
        { "location": "457/TALK"    , "narrator": "みやび", "text": "うちは志願入隊で、\nつばめちゃんは\n偶然発見された、と。"},
        { "location": "459/TALK"    , "narrator": "ガブリエラ", "text": "あたしみたいに、\nどこかから発掘して\nきたんじゃないの？"},
        { "location": "460/TALK"    , "narrator": "アーヤ", "text": "でも、ギャヴィの時は\n館長から事前に話を\n聞いてたわ。"},
        { "location": "462/TALK"    , "narrator": "ガブリエラ", "text": "人数も増えたし、\n一々言うのも\n面倒だったんじゃない？"},
        { "location": "464/TALK"    , "narrator": "みやび", "text": "…まあ、ありえん話\nでもないな。"},
        { "location": "466/TALK"    , "narrator": "みやび", "text": "入隊経緯なんぞ、\nぶっちゃけ聞いても\n何にもならんし。"},
        { "location": "468/TALK"    , "narrator": "ガブリエラ", "text": "何にせよ、あの二人は\n揃って謎と裏があり\nそう、ってことね…。"},
        { "location": "471/TALK"    , "narrator": "みやび", "text": "そうやね。"},
        { "location": "473/TALK"    , "narrator": "みやび", "text": "つばめちゃんの、\nあの謎の力とかの\nこともあるし…。"},
        { "location": "475/TALK"    , "narrator": "アーヤ", "text": "…疑うのは\n嫌だけど――"},
        { "location": "476/TALK"    , "narrator": "アーヤ", "text": "三人態勢の時と\n同じようには\nいかなそうね…。"},
        { "location": "478/TALK"    , "narrator": "みやび", "text": "まあ、ネガティブな\n方向に考えても\nしゃあない。"},
        { "location": "479/TALK"    , "narrator": "みやび", "text": "期待の新人卯月と、\n不死身人間の\nつばめちゃん。"},
        { "location": "481/TALK"    , "narrator": "みやび", "text": "うちらの考えが杞憂\nやったら、二人は\nうちら以上に強い――"},
        { "location": "483/TALK"    , "narrator": "みやび", "text": "スーパートライナリー\nになって大活躍して\nくれるやろうし。"},
        { "location": "485/TALK"    , "narrator": "ガブリエラ", "text": "…それはそれで、\n面白くないわ。"},
        { "location": "487/TALK"    , "narrator": "アーヤ", "text": "そうね。\n疑いが晴れるのは\nいいことだけど――"},
        { "location": "488/TALK"    , "narrator": "アーヤ", "text": "私たち、先輩としての\n立場がなくなっちゃう\nものね。"},
        { "location": "489/TALK"    , "narrator": "みやび", "text": "まあ、ラクさせて\nもらえるんは\nありがたいけんど――"},
        { "location": "490/TALK"    , "narrator": "みやび", "text": "パワーインフレで\n戦力外っちゅうのは、\n面白くないな…。"},
        { "location": "491/TALK"    , "narrator": "アーヤ", "text": "あの子達に全部持って\nいかれないように、\n私達も頑張りましょ。"},
        { "location": "493/TALK"    , "narrator": "ガブリエラ", "text": "…悔しいけど、\n賛成よ。"},
        { "location": "494/TALK"    , "narrator": "ガブリエラ", "text": "あんなわけのわから\nない後輩に、負けて\nいられないわ！"},
        { "location": "506/DIALOG"  , "narrator": "Dialog_chapter_ch02", "text": "【06 史上最愛の作戦】"}
    ]
}
