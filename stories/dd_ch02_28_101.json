{
    "dir": "chap28/daydra/dd_ch02_28_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "28202",
        "cid": "ayami",
        "title": "002 メインストーリー",
        "sub_title": "兄弟姉妹の世界線＜前編＞"
    },
    "entry":
    [
        { "location": "8/SCENARIO", "narrator": "", "text": "いやげものをあなたに"},
        { "location": "30/TALK"   , "narrator": "みやび", "text": "お。\nおったおった。"},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "何？"},
        { "location": "34/TALK"   , "narrator": "みやび", "text": "さっきの通信改ざんの\n件とは別なんやけんど。"},
        { "location": "35/TALK"   , "narrator": "みやび", "text": "アーヤが見ておいた\n方がえいデータが\n見つかったき。"},
        { "location": "37/TALK"   , "narrator": "みやび", "text": "アーヤのスマホに\n入れといたぞね。"},
        { "location": "38/TALK"   , "narrator": "アーヤ", "text": "え？　どれどれ？"},
        { "location": "45/TALK"   , "narrator": "みやび", "text": "そこのフォルダぞね。"},
        { "location": "46/TALK"   , "narrator": "アーヤ", "text": "あ、これ？"},
        { "location": "47/TALK"   , "narrator": "みやび", "text": "そう、それ。\n今すぐ確認\nした方がえいぞね。"},
        { "location": "52/TALK"   , "narrator": "アーヤ", "text": "え、ちょっと！"},
        { "location": "53/TALK"   , "narrator": "アーヤ", "text": "そんなに重要な\n内容なのかしら……。"},
        { "location": "54/SEL"    , "narrator": "", "text": "$me$にも教えて"},
        { "location": "55/SEL"    , "narrator": "", "text": "世界がひっくり返るような話かも"},
        { "location": "56/ACT"    , "narrator": "", "text": "$me$にも教えて"},
        { "location": "67/TALK"   , "narrator": "アーヤ", "text": "確認したら"},
        { "location": "68/TALK"   , "narrator": "アーヤ", "text": "教えるわ"},
        { "location": "69/ACT"    , "narrator": "", "text": "世界がひっくり返るような話かも"},
        { "location": "80/TALK"   , "narrator": "アーヤ", "text": "まさか"},
        { "location": "81/TALK"   , "narrator": "アーヤ", "text": "って"},
        { "location": "82/TALK"   , "narrator": "アーヤ", "text": "言い切れないのが、、、"},
        { "location": "84/TALK"   , "narrator": "アーヤ", "text": "とりあえず"},
        { "location": "85/TALK"   , "narrator": "アーヤ", "text": "見てからね"},
        { "location": "90/TALK"   , "narrator": "アーヤ", "text": "えーと…。"},
        { "location": "91/TALK"   , "narrator": "アーヤ", "text": "「アヤちゃんに\nアンケートです！」"},
        { "location": "92/TALK"   , "narrator": "アーヤ", "text": "え？　何これ？"},
        { "location": "93/TALK"   , "narrator": "アーヤ", "text": "「今、アヤちゃんを\nモデルにした\nロボットを作ってるの」"},
        { "location": "94/TALK"   , "narrator": "アーヤ", "text": "「見た目じゃなくて\n性格がアヤちゃん。\nPRICS理論を実装するの」"},
        { "location": "95/TALK"   , "narrator": "アーヤ", "text": "「アヤちゃんみたいに\n考えて、色々憶えたり\n話したりするの」"},
        { "location": "96/TALK"   , "narrator": "アーヤ", "text": "「アヤちゃんの分身\nみたいなものかな？」"},
        { "location": "97/TALK"   , "narrator": "アーヤ", "text": "「だからアヤちゃんに\n名前を決めて欲しいな」"},
        { "location": "98/TALK"   , "narrator": "アーヤ", "text": "「１．アヤボットちゃん\n２．あやみんロボ\n３．綾水１．５号」"},
        { "location": "99/TALK"   , "narrator": "アーヤ", "text": "「写真を添付するね。\n一番似合う名前は\nどれかな？」"},
        { "location": "100/TALK"  , "narrator": "アーヤ", "text": "「かわいいでしょ！\nでもアヤちゃんも\nかわいいから自信持って」"},
        { "location": "101/TALK"  , "narrator": "アーヤ", "text": "………………。"},
        { "location": "103/TALK"  , "narrator": "アーヤ", "text": "なにこれ……。"},
        { "location": "104/SEL"   , "narrator": "", "text": "どうしたの？"},
        { "location": "105/SEL"   , "narrator": "", "text": "なんだったの？"},
        { "location": "106/ACT"   , "narrator": "", "text": "どうしたの？"},
        { "location": "116/TALK"  , "narrator": "アーヤ", "text": "やっぱり"},
        { "location": "117/TALK"  , "narrator": "アーヤ", "text": "姉は姉だわ、、、"},
        { "location": "118/ACT"   , "narrator": "", "text": "なんだったの？"},
        { "location": "128/TALK"  , "narrator": "アーヤ", "text": "どう説明すればいいか"},
        { "location": "129/TALK"  , "narrator": "アーヤ", "text": "悩むものだったわ"},
        { "location": "131/TALK"  , "narrator": "アーヤ", "text": "後でまとめて"},
        { "location": "132/TALK"  , "narrator": "アーヤ", "text": "教えるわ"},
        { "location": "133/TALK"  , "narrator": "アーヤ", "text": "もうひとつファイルあるし"},
        { "location": "137/TALK"  , "narrator": "アーヤ", "text": "どうせまた\n変なこと\nなんだろうけど…。"},
        { "location": "138/TALK"  , "narrator": "アーヤ", "text": "「アヤちゃんに出せるか\nどうかわからないけど。\n書くだけ書いておくね。」"},
        { "location": "139/TALK"  , "narrator": "アーヤ", "text": "「一日だけだけど\n家に帰れる日が\n作れそうなんだ」"},
        { "location": "140/TALK"  , "narrator": "アーヤ", "text": "「アヤちゃんにもずっと\n会えてないよね。\n会えるの楽しみ！」"},
        { "location": "141/TALK"  , "narrator": "アーヤ", "text": "「お土産、楽しみに\nしてて。すっごく\n面白いやつだから！」"},
        { "location": "142/TALK"  , "narrator": "アーヤ", "text": "「アヤちゃんの驚く顔\n早く見たいな。\nお姉ちゃんより」"},
        { "location": "146/TALK"  , "narrator": "アーヤ", "text": "…どうせまた\n変なロボットとか\nなんでしょ？"},
        { "location": "147/TALK"  , "narrator": "アーヤ", "text": "お姉ちゃんは\nいっつもそう\nなんだから……。"},
        { "location": "148/TALK"  , "narrator": "アーヤ", "text": "私が見たって\nわからないのに…。"},
        { "location": "196/TALK"  , "narrator": "アーヤ", "text": "　"},
        { "location": "211/TALK"  , "narrator": "アーヤの新司書", "text": "こんにちは、\n$handle$さん。"},
        { "location": "212/SEL"   , "narrator": "", "text": "新しい方か"},
        { "location": "213/SEL"   , "narrator": "", "text": "エヴェレットさんは見つかった？"},
        { "location": "214/ACT"   , "narrator": "", "text": "新しい方か"},
        { "location": "215/TALK"  , "narrator": "アーヤの新司書", "text": "はいはいそうですよ。\nごめんなさいね。"},
        { "location": "216/ACT"   , "narrator": "", "text": "エヴェレットさんは見つかった？"},
        { "location": "217/TALK"  , "narrator": "アーヤの新司書", "text": "まだ見つからないわね。"},
        { "location": "218/TALK"  , "narrator": "アーヤの新司書", "text": "ていうか、\n挨拶より先にそれ？"},
        { "location": "220/TALK"  , "narrator": "アーヤの新司書", "text": "まあでも、\n貴方の気持ちは\nわからなくもないわ。"},
        { "location": "221/TALK"  , "narrator": "アーヤの新司書", "text": "こんな愛想悪い\n人格となんて、少しも\n一緒にいたくないものね。"},
        { "location": "222/TALK"  , "narrator": "アーヤの新司書", "text": "まあこうやって、\nわざとこういう性格に\n見せているのも私の性。"},
        { "location": "223/SEL"   , "narrator": "", "text": "もっと1x司書さんのこと色々知りたい"},
        { "location": "224/SEL"   , "narrator": "", "text": "てか、あんたのこと全然わからないんだけど"},
        { "location": "225/ACT"   , "narrator": "", "text": "もっと1x司書さんのこと色々知りたい"},
        { "location": "226/TALK"  , "narrator": "アーヤの新司書", "text": "物好きね。"},
        { "location": "227/ACT"   , "narrator": "", "text": "てか、あんたのこと全然わからないんだけど"},
        { "location": "228/TALK"  , "narrator": "アーヤの新司書", "text": "随分と攻撃的ね。"},
        { "location": "230/TALK"  , "narrator": "アーヤの新司書", "text": "まあいいわ。\nそれじゃ私のこと\n教えてあげる。"},
        { "location": "231/TALK"  , "narrator": "アーヤの新司書", "text": "貴方が私の事を\n全然好きになれない\nようならば――"},
        { "location": "232/TALK"  , "narrator": "アーヤの新司書", "text": "それこそが、\nアーヤの中での\n私の存在意義。"},
        { "location": "233/SEL"   , "narrator": "", "text": "全然わからん"},
        { "location": "234/ACT"   , "narrator": "", "text": "全然わからん"},
        { "location": "236/TALK"  , "narrator": "アーヤの新司書", "text": "うーん、そうね…。"},
        { "location": "237/TALK"  , "narrator": "アーヤの新司書", "text": "例えば、ものすごく\n間の悪い状況とか、\n運が悪い状況――"},
        { "location": "238/TALK"  , "narrator": "アーヤの新司書", "text": "偶然と思われるそれを\nわざと作り出すのよ。\n本人は自覚できないけど。"},
        { "location": "239/TALK"  , "narrator": "アーヤの新司書", "text": "それをやっているのが\n私なの。"},
        { "location": "240/TALK"  , "narrator": "アーヤの新司書", "text": "改めまして。\n私は【白烏】と言います。"},
        { "location": "241/TALK"  , "narrator": "白烏", "text": "アーヤの潜在層の\n最奥に近い所にいる\n人格よ。"},
        { "location": "242/SEL"   , "narrator": "", "text": "名前言っちゃっていいの！？"},
        { "location": "243/ACT"   , "narrator": "", "text": "名前言っちゃっていいの！？"},
        { "location": "245/TALK"  , "narrator": "白烏", "text": "まあ、いいんじゃない？"},
        { "location": "246/TALK"  , "narrator": "白烏", "text": "それで貴方に支配される\nなら、それはそれで\n仕方のないことだし。"},
        { "location": "247/TALK"  , "narrator": "白烏", "text": "私が担う役割は、\n私自身を適度に不幸な\n状態に、維持し続ける事。"},
        { "location": "248/SEL"   , "narrator": "", "text": "それって本当にアーヤの人格なの？"},
        { "location": "249/SEL"   , "narrator": "", "text": "何となく察した"},
        { "location": "250/ACT"   , "narrator": "", "text": "それって本当にアーヤの人格なの？"},
        { "location": "251/TALK"  , "narrator": "白烏", "text": "ええ、もちろん。"},
        { "location": "252/ACT"   , "narrator": "", "text": "何となく察した"},
        { "location": "253/TALK"  , "narrator": "白烏", "text": "あら。\nもしかして貴方も\n私と同じタイプ？"},
        { "location": "255/TALK"  , "narrator": "白烏", "text": "まあ、一見自分にとって\n不利益としか思えない\n私でも、必要だからいる。"},
        { "location": "256/TALK"  , "narrator": "白烏", "text": "私という存在は、この\n私という人格によって、\n今の地位を得てるのよ。"},
        { "location": "257/SEL"   , "narrator": "", "text": "なるほど"},
        { "location": "258/SEL"   , "narrator": "", "text": "もうちょっと詳しく"},
        { "location": "259/ACT"   , "narrator": "", "text": "なるほど"},
        { "location": "260/TALK"  , "narrator": "白烏", "text": "まあ、そういうこと。"},
        { "location": "261/ACT"   , "narrator": "", "text": "もうちょっと詳しく"},
        { "location": "262/TALK"  , "narrator": "白烏", "text": "そうね。\nすごく乱暴な言い方を\nすると――"},
        { "location": "263/TALK"  , "narrator": "白烏", "text": "電車の遅延に\n遭遇しまくるのも。"},
        { "location": "264/TALK"  , "narrator": "白烏", "text": "欲しかったアイテムが\n売り切れてるのも。"},
        { "location": "265/TALK"  , "narrator": "白烏", "text": "最悪のタイミングで\n他人の地雷を踏むのも、\nその半数は無意識な演出。"},
        { "location": "266/TALK"  , "narrator": "白烏", "text": "頑張ってもトップに\nなれない悲劇のヒロイン。"},
        { "location": "267/TALK"  , "narrator": "白烏", "text": "永遠の２番。\nそれは自らが作り出して\nいる、台本ってこと。"},
        { "location": "268/TALK"  , "narrator": "白烏", "text": "もちろん、全部が全部\n作り出してるという\nわけじゃない。"},
        { "location": "269/TALK"  , "narrator": "白烏", "text": "でも、常に意図的にやって\nいれば、偶然の不幸も\nプラスされ平均を超える。"},
        { "location": "270/TALK"  , "narrator": "白烏", "text": "こういった不幸体質の\nレッテルを貼られることで\n世渡りが楽になる。"},
        { "location": "271/SEL"   , "narrator": "", "text": "わかる"},
        { "location": "272/SEL"   , "narrator": "", "text": "そうは思わない"},
        { "location": "273/ACT"   , "narrator": "", "text": "わかる"},
        { "location": "274/TALK"  , "narrator": "白烏", "text": "同情してくれるものね。"},
        { "location": "275/TALK"  , "narrator": "白烏", "text": "あと、仕方ないこととして\n罪に問われにくい\n存在になれる。"},
        { "location": "276/TALK"  , "narrator": "白烏", "text": "アーヤだし仕方ないよね、\nという言葉は、オール\nマイティパスだもの。"},
        { "location": "277/ACT"   , "narrator": "", "text": "そうは思わない"},
        { "location": "278/TALK"  , "narrator": "白烏", "text": "勿論デメリットもある。"},
        { "location": "279/TALK"  , "narrator": "白烏", "text": "当然だけど、強い人には\nこんな価値観はあり得ない\nということも解ってる。"},
        { "location": "280/TALK"  , "narrator": "白烏", "text": "けど、私はとっても弱い\n存在だから、こうやって\n身を守ってる。"},
        { "location": "281/TALK"  , "narrator": "白烏", "text": "他人に不幸体質を\n刷り込むことで、\nペナルティを免除できる。"},
        { "location": "282/TALK"  , "narrator": "白烏", "text": "それは、遅刻した理由から\n一番になれなかった\n理由まで、全てにおいて。"},
        { "location": "284/TALK"  , "narrator": "白烏", "text": "ね？\nびっくりするくらい\nかっこ悪いでしょ。"},
        { "location": "285/TALK"  , "narrator": "白烏", "text": "もちろん、意識して\nやってるわけじゃない。"},
        { "location": "286/TALK"  , "narrator": "白烏", "text": "けど、幼少期から培った\n私にとっての必勝法が、\nこの私というわけ。"},
        { "location": "287/SEL"   , "narrator": "", "text": "こういうマイナス要素って普通言わないよね？"},
        { "location": "288/SEL"   , "narrator": "", "text": "アーヤも大変だったんだね"},
        { "location": "289/ACT"   , "narrator": "", "text": "こういうマイナス要素って普通言わないよね？"},
        { "location": "290/TALK"  , "narrator": "白烏", "text": "言わないわね。\nそもそも無意識だから、\n言う事すらできないし。"},
        { "location": "291/TALK"  , "narrator": "白烏", "text": "けど、貴方は不幸にも\nココロに入ることが\nできる存在だった。"},
        { "location": "292/TALK"  , "narrator": "白烏", "text": "そして私も、不幸にも\nたまたまこんな人格が\n貴方と接してしまった。"},
        { "location": "293/TALK"  , "narrator": "白烏", "text": "まあでも、１つ私が\n前向きに思ってることを\n言うとね――"},
        { "location": "294/TALK"  , "narrator": "白烏", "text": "長くお付き合いする相手の\nことを、深く知ることが\n出来るのは幸せなこと。"},
        { "location": "295/TALK"  , "narrator": "白烏", "text": "お互いにとってね。\n私はそう思ってるけどな。"},
        { "location": "296/ACT"   , "narrator": "", "text": "アーヤも大変だったんだね"},
        { "location": "297/TALK"  , "narrator": "白烏", "text": "そうね。"},
        { "location": "298/TALK"  , "narrator": "白烏", "text": "確かに、\n色々大変だったから\n私が誕生したのはある。"},
        { "location": "299/TALK"  , "narrator": "白烏", "text": "そして褒められたことでは\nないけども、私は私に\nかなり得をさせてきた。"},
        { "location": "300/TALK"  , "narrator": "白烏", "text": "一種の防衛手段みたいな\nものね、私の存在は。"},
        { "location": "301/TALK"  , "narrator": "白烏", "text": "同情してくれた人は皆、\n私の味方に\nなってくれるもの。"},
        { "location": "303/TALK"  , "narrator": "白烏", "text": "……とまあこんな風に。"},
        { "location": "304/TALK"  , "narrator": "白烏", "text": "私が話せば話すほど、\n綾水という存在は\n泥だらけになるのよ。"},
        { "location": "305/TALK"  , "narrator": "白烏", "text": "でも、これだけは\n言っておくけど。"},
        { "location": "306/TALK"  , "narrator": "白烏", "text": "誰の心の中にも、\n私のような人格はいる。"},
        { "location": "307/TALK"  , "narrator": "白烏", "text": "ただ、私のように\n正直に暴露してないだけ。"},
        { "location": "308/TALK"  , "narrator": "白烏", "text": "私だって本音を言えば、\n貴方には引かれたくない。\n別れたくもない。"},
        { "location": "309/TALK"  , "narrator": "白烏", "text": "だって、私だって\nエヴェレットと同じくらい\n貴方が好きだから。"},
        { "location": "310/TALK"  , "narrator": "白烏", "text": "イチャイチャは\nしないけど。"},
        { "location": "311/TALK"  , "narrator": "白烏", "text": "まあ、\n前向きに考えるなら――"},
        { "location": "312/TALK"  , "narrator": "白烏", "text": "本人すら知らない本心を\n貴方は知ってくれたって\nことかしらね。"},
        { "location": "314/TALK"  , "narrator": "白烏", "text": "本当の愛って、相手の\n良いトコもダメなトコも\n全部受け入れる事だから。"},
        { "location": "315/TALK"  , "narrator": "白烏", "text": "そうしてくれたら\n嬉しいかな？"},
        { "location": "316/SEL"   , "narrator": "", "text": "話してくれてありがとう"},
        { "location": "317/SEL"   , "narrator": "", "text": "正直聞かなきゃよかった"},
        { "location": "318/ACT"   , "narrator": "", "text": "話してくれてありがとう"},
        { "location": "320/TALK"  , "narrator": "白烏", "text": "どういたしまして。"},
        { "location": "321/TALK"  , "narrator": "白烏", "text": "少しは身近に\n感じてもらえるように\nなったかしら。"},
        { "location": "322/ACT"   , "narrator": "", "text": "正直聞かなきゃよかった"},
        { "location": "324/TALK"  , "narrator": "白烏", "text": "ふふ。そうよね。"},
        { "location": "325/TALK"  , "narrator": "白烏", "text": "いつまでもカッコ良くて\n可愛くて、綺麗でいて\n欲しいものよね。"},
        { "location": "326/TALK"  , "narrator": "白烏", "text": "でも、そんなのは\n本当の彼女じゃないから。"},
        { "location": "327/TALK"  , "narrator": "白烏", "text": "貴方がこの話を聞いて\n今後現実の私とどう\nつき合うか――"},
        { "location": "328/TALK"  , "narrator": "白烏", "text": "それは、貴方が\n決めればいいこと。"},
        { "location": "329/TALK"  , "narrator": "白烏", "text": "変わらないなら素敵な\n事だし、疎遠になるなら\nそれもまた仕方ない。"},
        { "location": "330/TALK"  , "narrator": "白烏", "text": "どっちにしても、\n國政綾水にとっては\n人生の一幕だもの。"},
        { "location": "332/TALK"  , "narrator": "白烏", "text": "……というわけで、\nこれで私の自己紹介は\nおしまい。"},
        { "location": "333/TALK"  , "narrator": "白烏", "text": "少しは、私と一緒にいるの\n嫌だなって気持ち、\n和らいだ？"},
        { "location": "334/SEL"   , "narrator": "", "text": "和らいだ"},
        { "location": "335/SEL"   , "narrator": "", "text": "余計一緒にいたくなくなった"},
        { "location": "336/ACT"   , "narrator": "", "text": "和らいだ"},
        { "location": "337/TALK"  , "narrator": "白烏", "text": "よかった。"},
        { "location": "338/TALK"  , "narrator": "白烏", "text": "ちなみに、人格も\n不変の存在じゃない。"},
        { "location": "339/TALK"  , "narrator": "白烏", "text": "貴方のような影響力がある\n人と接してると、少し\n変化したりもする。"},
        { "location": "340/TALK"  , "narrator": "白烏", "text": "もし私の気持ちが\n変わったら、綾水は不幸\n体質ではなくなるかもね。"},
        { "location": "341/ACT"   , "narrator": "", "text": "余計一緒にいたくなくなった"},
        { "location": "342/TALK"  , "narrator": "白烏", "text": "あらら、\nそれは残念。"},
        { "location": "343/TALK"  , "narrator": "白烏", "text": "でも、人生そういうことも\nよくあるわよ。"},
        { "location": "344/TALK"  , "narrator": "白烏", "text": "憧れてる人のことを\n色々知ったら幻滅\nしちゃったとか。"},
        { "location": "345/TALK"  , "narrator": "白烏", "text": "たまたまそれが\n今回あっただけだから。"},
        { "location": "346/TALK"  , "narrator": "白烏", "text": "まあでも、私に幻滅しても\n現実の私とはずっと仲良く\nしてあげて欲しいかな。"},
        { "location": "348/TALK"  , "narrator": "白烏", "text": "他に何か、\n聞きたいことある？"},
        { "location": "349/SEL"   , "narrator": "", "text": "1xの司書には自分で志願したの？"},
        { "location": "350/SEL"   , "narrator": "", "text": "それよりエヴェレットは大丈夫なの？"},
        { "location": "351/ACT"   , "narrator": "", "text": "1xの司書には自分で志願したの？"},
        { "location": "352/TALK"  , "narrator": "白烏", "text": "いいえ。推薦。\n千羽鶴のね。"},
        { "location": "353/TALK"  , "narrator": "白烏", "text": "理由が知りたいんでしょ？\nなんでこんな人格が\n司書やってるのか。"},
        { "location": "354/TALK"  , "narrator": "白烏", "text": "けど結論から言えば、\n理由はわからない。\n勝手な憶測だけど――"},
        { "location": "355/TALK"  , "narrator": "白烏", "text": "セルフクランに近い\nところに位置する\n人格だからじゃないの？"},
        { "location": "356/SEL"   , "narrator": "", "text": "なるほど　"},
        { "location": "357/SEL"   , "narrator": "", "text": "セルフクランに近いところって？"},
        { "location": "358/SEL"   , "narrator": "", "text": "前の司書も推薦なの？"},
        { "location": "359/ACT"   , "narrator": "", "text": "なるほど　"},
        { "location": "360/ACT"   , "narrator": "", "text": "セルフクランに近いところって？"},
        { "location": "361/TALK"  , "narrator": "白烏", "text": "セルフクランは、\n私を形成する人格のボス。\n主人格と言われてる。"},
        { "location": "362/TALK"  , "narrator": "白烏", "text": "現実の私における\nアイデンティティの代表\nともいえる人格ね。"},
        { "location": "363/TALK"  , "narrator": "白烏", "text": "それは潜在意識の最も\n深い所にいて、私はその\n近くにいる存在ってこと。"},
        { "location": "364/ACT"   , "narrator": "", "text": "前の司書も推薦なの？"},
        { "location": "365/TALK"  , "narrator": "白烏", "text": "いいえ。"},
        { "location": "366/TALK"  , "narrator": "白烏", "text": "千羽鶴は、前の司書に\nついては、自由意志を\n大事にしたの。"},
        { "location": "367/TALK"  , "narrator": "白烏", "text": "例えば綾水なら、綾水の\n全ての人格で協議して\n決まった子を司書にした。"},
        { "location": "368/TALK"  , "narrator": "白烏", "text": "この方式のメリットは、\n前向きに司書制度を\n受け入れられること。"},
        { "location": "369/TALK"  , "narrator": "白烏", "text": "司書制度って単純に言えば\n自分の決断に外部の意見を\n取り入れることでしょ？"},
        { "location": "370/TALK"  , "narrator": "白烏", "text": "考え方次第では、超的な\n視点を持つ力とも取れるし\n逆に洗脳ともとれる。"},
        { "location": "371/TALK"  , "narrator": "白烏", "text": "でも、洗脳されてると\n思いつつ、この制度を\n受け入れる事はできない。"},
        { "location": "372/TALK"  , "narrator": "白烏", "text": "だから総意、すなわち\n現実の私は、前者だと\n思い込むことにした。"},
        { "location": "373/TALK"  , "narrator": "白烏", "text": "これは心の防衛機制による\n自己暗示に近いものが\nあるわね。"},
        { "location": "374/TALK"  , "narrator": "白烏", "text": "トライナリーとして\n超的な力を行使するには、\n司書は必須の制度なの。"},
        { "location": "375/TALK"  , "narrator": "白烏", "text": "それが自分に害をなすもの\nではないと思い込むことは\n心を護る上でとても重要。"},
        { "location": "376/TALK"  , "narrator": "白烏", "text": "その結果、総意としては\n最も受け入れやすい人格を\n司書にあてることになる。"},
        { "location": "377/TALK"  , "narrator": "白烏", "text": "私の場合、それが\nエヴェレットだったと\nいうわけね。"},
        { "location": "378/TALK"  , "narrator": "白烏", "text": "司書制度に肯定的な人格\nなら、当然接してくる\n存在にも好意的。"},
        { "location": "379/TALK"  , "narrator": "白烏", "text": "だから、前の司書が貴方に\n好意的なのは、当然と\nいうか必然に近いのよね。"},
        { "location": "380/TALK"  , "narrator": "白烏", "text": "そしてその影響は、\n現実の私にまで\n及んでいるわけだけど。"},
        { "location": "381/TALK"  , "narrator": "白烏", "text": "翻して私は、\nそうやって総意が選んだ\n司書じゃない。"},
        { "location": "382/TALK"  , "narrator": "白烏", "text": "いえ、まだ殆どの人格は\n私が司書をやってるなんて\n知りもしない。"},
        { "location": "383/TALK"  , "narrator": "白烏", "text": "司書の差し替えは\n秘密裏に行われたから。"},
        { "location": "384/TALK"  , "narrator": "白烏", "text": "で、なんで私が\n推薦されたかなんだけど、\nそれはわからない。"},
        { "location": "386/ACT"   , "narrator": "", "text": "それよりエヴェレットは大丈夫なの？"},
        { "location": "387/TALK"  , "narrator": "白烏", "text": "さあね。\nそれはわからない。"},
        { "location": "388/TALK"  , "narrator": "白烏", "text": "私も心配ではあるけど。"},
        { "location": "389/TALK"  , "narrator": "白烏", "text": "でも、あの子強かだし、\n多分誰かにサポート\nされてるから大丈夫。"},
        { "location": "390/SEL"   , "narrator": "", "text": "どうしてそう言い切れるの？"},
        { "location": "391/ACT"   , "narrator": "", "text": "どうしてそう言い切れるの？"},
        { "location": "393/TALK"  , "narrator": "白烏", "text": "司書権剥奪されてる\n筈なのに、前回しっかり\n司書業をやってたから。"},
        { "location": "394/TALK"  , "narrator": "白烏", "text": "扉。\n回してもらったわよね？"},
        { "location": "396/TALK"  , "narrator": "白烏", "text": "……と。ちょっと\n長話しちゃったわね。\nらしくない……。"},
        { "location": "398/TALK"  , "narrator": "白烏", "text": "それじゃ今回の葛藤を\n解決しましょ。"},
        { "location": "400/TALK"  , "narrator": "白烏", "text": "オープンプロセス、\n0x664番地から\n0x0FC番地へ。"},
        { "location": "422/TALK"  , "narrator": "白烏", "text": "完了。"},
        { "location": "424/TALK"  , "narrator": "白烏", "text": "……。"},
        { "location": "426/TALK"  , "narrator": "白烏", "text": "姉の葛藤ね。"},
        { "location": "427/TALK"  , "narrator": "白烏", "text": "なんていうか、もう\nレギュラー番組よね。"},
        { "location": "428/TALK"  , "narrator": "白烏", "text": "でも客観的に見て――"},
        { "location": "429/TALK"  , "narrator": "白烏", "text": "貴方が私のココロに介入\nするようになってから、\n姉への不満は減ってる。"},
        { "location": "430/TALK"  , "narrator": "白烏", "text": "綾水全体として、\n前ほどカリカリしなく\nなってるというか。"},
        { "location": "431/TALK"  , "narrator": "白烏", "text": "これも貴方のお陰ね。\nそれを良しとするか否かは\nあなた次第だけど。"},
        { "location": "432/SEL"   , "narrator": "", "text": "いい事だと思う"},
        { "location": "433/SEL"   , "narrator": "", "text": "どんな事でも精神操作には変わりない"},
        { "location": "434/ACT"   , "narrator": "", "text": "いい事だと思う"},
        { "location": "435/TALK"  , "narrator": "白烏", "text": "ならよかった。"},
        { "location": "436/TALK"  , "narrator": "白烏", "text": "まあ一般的に見て、\n姉妹なんだから仲が良い\n方がいいわよね。"},
        { "location": "437/ACT"   , "narrator": "", "text": "どんな事でも精神操作には変わりない"},
        { "location": "438/TALK"  , "narrator": "白烏", "text": "結構堅いのね。\n私はこういう改善は\n悪くないと思うけど。"},
        { "location": "439/TALK"  , "narrator": "白烏", "text": "心の中で人格が外の声に\n耳を傾けるのと、現実で\nそれをやること――"},
        { "location": "440/TALK"  , "narrator": "白烏", "text": "この２つは究極的には\n全く同じことだと思うし。"},
        { "location": "441/TALK"  , "narrator": "白烏", "text": "まあ、強いて言うなら、\n並列処理の二重学習だから\n吸収効率は高いわよね。"},
        { "location": "442/TALK"  , "narrator": "白烏", "text": "それが怖いってのも\n解らなくはないけど。"},
        { "location": "444/TALK"  , "narrator": "白烏", "text": "というわけで、\n今回も現実の私の\n心の安定、お願いします。"},
        { "location": "445/TALK"  , "narrator": "白烏", "text": "エヴェレットの件は\nもっと色々\n調べておくから。"},
        { "location": "446/SEL"   , "narrator": "", "text": "よろしく"},
        { "location": "447/SEL"   , "narrator": "", "text": "白烏のこと色々知れて嬉しかったよ"},
        { "location": "448/ACT"   , "narrator": "", "text": "よろしく"},
        { "location": "449/ACT"   , "narrator": "", "text": "白烏のこと色々知れて嬉しかったよ"},
        { "location": "450/TALK"  , "narrator": "白烏", "text": "はいはい。"},
        { "location": "451/TALK"  , "narrator": "白烏", "text": "何も出ませんけど。"},
        { "location": "453/TALK"  , "narrator": "白烏", "text": "というわけで、\n私と$handle$に\n素敵なココロの旅を！"},
        { "location": "29/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>9月4日　 4:56 PM</color>\nストライキ２日目、長野県松代アーヤの実家にて"},
        { "location": "161/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "163/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "165/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "167/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "169/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"}
    ]
}
