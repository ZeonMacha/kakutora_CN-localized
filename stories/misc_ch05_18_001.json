        { "location": "5644/SCENARIO", "narrator": "", "text": "古民家ものがたり"},
        { "location": "5669/TALK"    , "narrator": "神楽", "text": "みやびさんの実家、古民家ってやつみたい"},
        { "location": "5671/SEL"     , "narrator": "", "text": "いかにもだね"},
        { "location": "5672/SEL"     , "narrator": "", "text": "行ったことあるし"},
        { "location": "5673/SEL"     , "narrator": "", "text": "神楽の家は？"},
        { "location": "5674/ACT"     , "narrator": "", "text": "いかにもだね"},
        { "location": "5676/TALK"    , "narrator": "神楽", "text": "でしょでしょ！"},
        { "location": "5678/TALK"    , "narrator": "神楽", "text": "本当にいるんだ！？って思った！"},
        { "location": "5679/TALK"    , "narrator": "神楽", "text": "ああいうの全部お店か文化財になってると思ってたから！"},
        { "location": "5680/ACT"     , "narrator": "", "text": "行ったことあるし"},
        { "location": "5681/TALK"    , "narrator": "神楽", "text": "またまたー"},
        { "location": "5682/TALK"    , "narrator": "神楽", "text": "適当なことばっかり言って"},
        { "location": "5683/ACT"     , "narrator": "", "text": "神楽の家は？"},
        { "location": "5685/TALK"    , "narrator": "神楽", "text": "おしえない★"},
        { "location": "5687/TALK"    , "narrator": "神楽", "text": "昔の家ってメンテナンスも大変だし住むこと自体も辛かったりするぴょん？"},
        { "location": "5688/TALK"    , "narrator": "神楽", "text": "ぴょんこが一番つらいなって思うのは雨戸！"},
        { "location": "5689/TALK"    , "narrator": "神楽", "text": "あれ閉めると家の中真っ暗になっちゃうでしょ？"},
        { "location": "5690/TALK"    , "narrator": "神楽", "text": "ありえなーい"},
        { "location": "5693/SEL"     , "narrator": "", "text": "いや電気は来てるでしょ…"},
        { "location": "5694/SEL"     , "narrator": "", "text": "本当に住んだことないんだね…"},
        { "location": "5695/SEL"     , "narrator": "", "text": "$me$が側についてるから！"},
        { "location": "5696/ACT"     , "narrator": "", "text": "いや電気は来てるでしょ…"},
        { "location": "5697/TALK"    , "narrator": "神楽", "text": "停電したらどうするのって思わない？"},
        { "location": "5698/ACT"     , "narrator": "", "text": "本当に住んだことないんだね…"},
        { "location": "5699/TALK"    , "narrator": "神楽", "text": "当たり前！"},
        { "location": "5700/ACT"     , "narrator": "", "text": "$me$が側についてるから！"},
        { "location": "5702/TALK"    , "narrator": "神楽", "text": "えっ$handlek$が？（トゥンク"},
        { "location": "5703/TALK"    , "narrator": "神楽", "text": "とでも言うと思ったか！！！"},
        { "location": "5704/TALK"    , "narrator": "神楽", "text": "言うよ？"},
        { "location": "5705/TALK"    , "narrator": "神楽", "text": "言っちゃうぴょん！！！"},
        { "location": "5707/TALK"    , "narrator": "神楽", "text": "なんだろね？"},
        { "location": "5708/TALK"    , "narrator": "神楽", "text": "今の家とあんまり違いすぎるからもう別世界過ぎて震える"},
        { "location": "5710/TALK"    , "narrator": "神楽", "text": "ある意味ネトゲの家より異世界"},
