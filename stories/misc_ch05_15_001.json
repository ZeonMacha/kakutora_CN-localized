    "entry":
    [
        { "location": "4300/SCENARIO", "narrator": "", "text": "リセットしようか"},
        { "location": "4325/TALK"    , "narrator": "神楽", "text": "この世界のエンドロールは見たから"},
        { "location": "4326/TALK"    , "narrator": "神楽", "text": "リセットして新しい世界に移行しようと思ってる"},
        { "location": "4328/SEL"     , "narrator": "", "text": "神楽がＰＲＧの主人公だったとは"},
        { "location": "4329/SEL"     , "narrator": "", "text": "ゲームのしすぎ"},
        { "location": "4330/SEL"     , "narrator": "", "text": "$me$もリセットされちゃうの？"},
        { "location": "4331/ACT"     , "narrator": "", "text": "神楽がＰＲＧの主人公だったとは"},
        { "location": "4332/TALK"    , "narrator": "神楽", "text": "知らなかった？"},
        { "location": "4333/ACT"     , "narrator": "", "text": "ゲームのしすぎ"},
        { "location": "4334/TALK"    , "narrator": "神楽", "text": "違いますー"},
        { "location": "4336/TALK"    , "narrator": "神楽", "text": "ラノベ読んだりアニメ見たりアニソン聞いたりもしてますー！"},
        { "location": "4337/ACT"     , "narrator": "", "text": "$me$もリセットされちゃうの？"},
        { "location": "4339/TALK"    , "narrator": "神楽", "text": "そうなるとぴょんことの愛のメモリーもリセットされちゃうね☆彡"},
        { "location": "4340/TALK"    , "narrator": "神楽", "text": "それはぴょんことしては少し不本意"},
        { "location": "4341/TALK"    , "narrator": "神楽", "text": "うーんやっぱりやめとこうかな"},
        { "location": "4343/TALK"    , "narrator": "神楽", "text": "実際二周目の方が断然面白いＲＰＧとかあるけど"},
        { "location": "4345/TALK"    , "narrator": "神楽", "text": "あれはある程度その世界が理解できててなおかつシステム制限解禁とか隠しシナリオとか新しい要素があるから楽しいわけで"},
        { "location": "4346/TALK"    , "narrator": "神楽", "text": "全く同じルートだったら周回する意味ないんだよねこれがまた"},
        { "location": "4347/TALK"    , "narrator": "神楽", "text": "難しいね☆彡"}
    ]
}
