    [
        { "location": "72/SCENARIO", "narrator": "", "text": "000_お召し物"},
        { "location": "97/TALK"    , "narrator": "ガブリエラ", "text": "アーヤとみやびがね"},
        { "location": "98/TALK"    , "narrator": "ガブリエラ", "text": "浴衣を着せてくれたのよ"},
        { "location": "100/SEL"    , "narrator": "", "text": "よかったね"},
        { "location": "101/SEL"    , "narrator": "", "text": "きつくなかった？"},
        { "location": "102/SEL"    , "narrator": "", "text": "写真見せて"},
        { "location": "103/ACT"    , "narrator": "", "text": "よかったね"},
        { "location": "104/TALK"   , "narrator": "ガブリエラ", "text": "ええｖｖｖｖｖ"},
        { "location": "105/ACT"    , "narrator": "", "text": "きつくなかった？"},
        { "location": "106/TALK"   , "narrator": "ガブリエラ", "text": "きついっていうか"},
        { "location": "107/TALK"   , "narrator": "ガブリエラ", "text": "暑かったわね"},
        { "location": "108/ACT"    , "narrator": "", "text": "写真見せて"},
        { "location": "110/TALK"   , "narrator": "ガブリエラ", "text": "え"},
        { "location": "111/TALK"   , "narrator": "ガブリエラ", "text": "写真？"},
        { "location": "113/SEL"    , "narrator": "", "text": "撮ったんでしょ？"},
        { "location": "114/SEL"    , "narrator": "", "text": "ないの？"},
        { "location": "115/ACT"    , "narrator": "", "text": "撮ったんでしょ？"},
        { "location": "116/TALK"   , "narrator": "ガブリエラ", "text": "撮ったっていうか"},
        { "location": "118/TALK"   , "narrator": "ガブリエラ", "text": "撮られたわ"},
        { "location": "119/ACT"    , "narrator": "", "text": "ないの？"},
        { "location": "120/TALK"   , "narrator": "ガブリエラ", "text": "ないわけじゃ"},
        { "location": "121/TALK"   , "narrator": "ガブリエラ", "text": "ないんだけれど"},
        { "location": "123/TALK"   , "narrator": "ガブリエラ", "text": "特別よ//////////////////////"},
        { "location": "124/TALK"   , "narrator": "ガブリエラ", "text": "マルザンナだから見せるんだからね////////////"},
        { "location": "127/TALK"   , "narrator": "ガブリエラ", "text": "びっくりしたのは浴衣より下駄ね"},
        { "location": "128/TALK"   , "narrator": "ガブリエラ", "text": "鼻緒ですりむくから"},
        { "location": "129/TALK"   , "narrator": "ガブリエラ", "text": "ばんそうこうを貼っておきなさいって言われて"},
        { "location": "130/TALK"   , "narrator": "ガブリエラ", "text": "気を付けてはいたのよ"},
        { "location": "131/TALK"   , "narrator": "ガブリエラ", "text": "でもやっぱり"},
        { "location": "132/TALK"   , "narrator": "ガブリエラ", "text": "マメができてしまったの"},
        { "location": "134/SEL"    , "narrator": "", "text": "やっちゃったか"},
        { "location": "135/SEL"    , "narrator": "", "text": "仕方ないよね"},
        { "location": "136/SEL"    , "narrator": "", "text": "痛いの痛いの飛んでけー"},
        { "location": "137/ACT"    , "narrator": "", "text": "やっちゃったか"},
        { "location": "138/TALK"   , "narrator": "ガブリエラ", "text": "注意されていたのにね"},
        { "location": "139/TALK"   , "narrator": "ガブリエラ", "text": "油断してしまったのよ"},
        { "location": "140/ACT"    , "narrator": "", "text": "仕方ないよね"},
        { "location": "141/TALK"   , "narrator": "ガブリエラ", "text": "あんな罠があるなんて"},
        { "location": "142/TALK"   , "narrator": "ガブリエラ", "text": "思いもしなかったわ"},
        { "location": "143/ACT"    , "narrator": "", "text": "痛いの痛いの飛んでけー"},
        { "location": "145/TALK"   , "narrator": "ガブリエラ", "text": "マルザンナったら"},
        { "location": "146/TALK"   , "narrator": "ガブリエラ", "text": "子供にするみたいなことしないで"},
        { "location": "147/TALK"   , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "148/TALK"   , "narrator": "ガブリエラ", "text": "慰めてくれて"},
        { "location": "149/TALK"   , "narrator": "ガブリエラ", "text": "ありがとう"},
        { "location": "151/TALK"   , "narrator": "ガブリエラ", "text": "ちゃんと似合うかしら？って"},
        { "location": "152/TALK"   , "narrator": "ガブリエラ", "text": "不安だったけど"},
        { "location": "153/TALK"   , "narrator": "ガブリエラ", "text": "かわいいって言ってもらえたわ////////////"},
        { "location": "155/TALK"   , "narrator": "ガブリエラ", "text": "だからとてもとてもとても"},
        { "location": "156/TALK"   , "narrator": "ガブリエラ", "text": "嬉しかったわｖｖｖｖｖ"}
    ]
}
