        { "location": "720/TALK", "narrator": "プレイヤー", "text": "お着替えしてみよう"},
        { "location": "722/TALK", "narrator": "プレイヤー", "text": "違う服を着てほしいな"},
        { "location": "724/TALK", "narrator": "プレイヤー", "text": "よし、お着替えタイムだ！"},
        { "location": "730/TALK", "narrator": "プレイヤー", "text": "やあ"},
        { "location": "732/TALK", "narrator": "プレイヤー", "text": "こんにちは"},
        { "location": "734/TALK", "narrator": "プレイヤー", "text": "げんき？"},
        { "location": "737/TALK", "narrator": "神楽", "text": "ぴょんこを呼ぶ声"},
        { "location": "738/TALK", "narrator": "神楽", "text": "あなたはだあれ？"},
        { "location": "740/SEL" , "narrator": "", "text": "$handle$だよ"},
        { "location": "741/ACT" , "narrator": "", "text": "$handle$だよ"},
        { "location": "743/TALK", "narrator": "神楽", "text": "知ってるし"},
        { "location": "744/TALK", "narrator": "神楽", "text": "ぴょんこに用事ぴょん？"},
        { "location": "747/SEL" , "narrator": "", "text": "ちょっと着替えてほしいんだ"},
        { "location": "748/ACT" , "narrator": "", "text": "ちょっと着替えてほしいんだ"},
        { "location": "758/TALK", "narrator": "神楽", "text": "意味不明すぎ"},
        { "location": "759/TALK", "narrator": "神楽", "text": "でもまあ"},
        { "location": "760/TALK", "narrator": "神楽", "text": "優しいぴょんこは聞いてあげるのだった"},
        { "location": "762/TALK", "narrator": "神楽", "text": "は？"},
        { "location": "763/TALK", "narrator": "神楽", "text": "この服変だった？"},
        { "location": "764/TALK", "narrator": "神楽", "text": "なら着替えるけど"},
        { "location": "767/SEL" , "narrator": "", "text": "$me$が選ぶ"},
        { "location": "768/SEL" , "narrator": "", "text": "やっぱやめる"},
        { "location": "770/TALK", "narrator": "神楽", "text": "…………"},
        { "location": "773/TALK", "narrator": "神楽", "text": "リクエストないとか？"},
        { "location": "774/TALK", "narrator": "神楽", "text": "なら着ない"},
        { "location": "776/ACT" , "narrator": "", "text": "$me$が選ぶ"},
        { "location": "777/TALK", "narrator": "神楽", "text": "だと思った"},
        { "location": "778/TALK", "narrator": "神楽", "text": "どれを着てほしいと？"},
        { "location": "785/ACT" , "narrator": "", "text": "やっぱやめる"},
        { "location": "786/TALK", "narrator": "神楽", "text": "ありえネー"}
    ]
