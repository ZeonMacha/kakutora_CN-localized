    "entry":
    [
        { "location": "317/SCENARIO", "narrator": "", "text": "TGSガブリエラ"},
        { "location": "337/TALK"    , "narrator": "ガブリエラ", "text": "へえ、あたし達以外\n誰もいないなんて、\nちょっと驚いたわ。"},
        { "location": "338/TALK"    , "narrator": "ガブリエラ", "text": "まるでプライベート\nビーチに来てる\n気持ちになるわね。"},
        { "location": "339/SEL"     , "narrator": "", "text": "二人きりになりたくてね"},
        { "location": "340/SEL"     , "narrator": "", "text": "ガブリエラには静かな砂浜が似合う"},
        { "location": "341/ACT"     , "narrator": "", "text": "二人きりになりたくてね"},
        { "location": "342/TALK"    , "narrator": "ガブリエラ", "text": "きゅ、急になんてこと\n言うのよ！"},
        { "location": "343/TALK"    , "narrator": "ガブリエラ", "text": "そんな言い方されたら、\n変に意識しちゃう\nじゃない…。"},
        { "location": "344/ACT"     , "narrator": "", "text": "ガブリエラには静かな砂浜が似合う"},
        { "location": "345/TALK"    , "narrator": "ガブリエラ", "text": "へえ、さすがね。\nあたしの好みを\nよく理解してるじゃない。"},
        { "location": "346/TALK"    , "narrator": "ガブリエラ", "text": "さすがはあたしの\nコイビ――"},
        { "location": "347/TALK"    , "narrator": "ガブリエラ", "text": "…なんでもないわ。\nとにかく、褒めてあげる。"},
        { "location": "349/TALK"    , "narrator": "ガブリエラ", "text": "でも、こんなに広い\n砂浜にあたし達だけって\nいうのは。"},
        { "location": "350/TALK"    , "narrator": "ガブリエラ", "text": "ちょっとだけ寂しくて、\n寒い感じもするわ。"},
        { "location": "351/TALK"    , "narrator": "ガブリエラ", "text": "そう思わない？\nそれとも、あたしだけ？"},
        { "location": "352/SEL"     , "narrator": "", "text": "とても温かく感じてる"},
        { "location": "353/SEL"     , "narrator": "", "text": "抱きしめようか？"},
        { "location": "354/ACT"     , "narrator": "", "text": "とても温かく感じてる"},
        { "location": "355/TALK"    , "narrator": "ガブリエラ", "text": "まあ、日差しが強いから\nそう感じたとしても\n不思議じゃないけど。"},
        { "location": "356/SEL"     , "narrator": "", "text": "好きな子と一緒だからだよ"},
        { "location": "357/SEL"     , "narrator": "", "text": "ガブリエラの水着姿が過激で…"},
        { "location": "358/ACT"     , "narrator": "", "text": "好きな子と一緒だからだよ"},
        { "location": "359/TALK"    , "narrator": "ガブリエラ", "text": "なっ！？"},
        { "location": "360/TALK"    , "narrator": "ガブリエラ", "text": "ば、ばか…。\nよくも恥ずかしげもなく\nそんなこと言えるわね？"},
        { "location": "361/TALK"    , "narrator": "ガブリエラ", "text": "…でも、ちょっとだけ\n感謝してあげるわ。"},
        { "location": "362/TALK"    , "narrator": "ガブリエラ", "text": "あたしも、あなたと\n一緒で温かい気持ちに\nなってきた感じするし…。"},
        { "location": "363/ACT"     , "narrator": "", "text": "ガブリエラの水着姿が過激で…"},
        { "location": "364/TALK"    , "narrator": "ガブリエラ", "text": "なっ！？　ば、ばか！！\n変な目で見ないでよ！"},
        { "location": "365/TALK"    , "narrator": "ガブリエラ", "text": "あ…、別に見るなって\nわけじゃないし、むしろ\n見てはほしいけど…。"},
        { "location": "366/TALK"    , "narrator": "ガブリエラ", "text": "でも、あんまり変な目で\n見るのはダメ！\nそういうのいけないのよ？"},
        { "location": "368/ACT"     , "narrator": "", "text": "抱きしめようか？"},
        { "location": "369/TALK"    , "narrator": "ガブリエラ", "text": "は、はぁ！？"},
        { "location": "370/TALK"    , "narrator": "ガブリエラ", "text": "いいから！\nイヤじゃないけど、\nそ、外だし…。"},
        { "location": "371/TALK"    , "narrator": "ガブリエラ", "text": "ああもう…あんたが\n変なこと言うから、\n暑くなってきちゃった…。"},
        { "location": "373/SEL"     , "narrator": "", "text": "ごめん、ちょっと触らせて"},
        { "location": "374/ACT"     , "narrator": "", "text": "ごめん、ちょっと触らせて"},
        { "location": "376/TALK"    , "narrator": "ガブリエラ", "text": "えぇっ！？"},
        { "location": "377/TALK"    , "narrator": "ガブリエラ", "text": "…だ、誰かが来たら、\nすぐやめるわよ？"},
        { "location": "396/TALK"    , "narrator": "ガブリエラ", "text": "むぅ…いつまで経っても\n子供扱いして…。"},
        { "location": "398/TALK"    , "narrator": "ガブリエラ", "text": "…こ、子供っぽく\n思われそうだから…、\nちょっとだけよ？"},
        { "location": "405/TALK"    , "narrator": "ガブリエラ", "text": "…絶対故意に\n触ってるでしょ？"},
        { "location": "407/TALK"    , "narrator": "ガブリエラ", "text": "イヤッ！？"},
        { "location": "409/TALK"    , "narrator": "ガブリエラ", "text": "ば、バカバカバカ！！\nどこ触ってるのよ、\nエッチ！！"},
        { "location": "415/TALK"    , "narrator": "ガブリエラ", "text": "う～っ、どうして\nお腹触るのよぉ…。"},
        { "location": "418/TALK"    , "narrator": "ガブリエラ", "text": "ちょ、ちょっと待って！\nダメだってば！"},
        { "location": "419/TALK"    , "narrator": "ガブリエラ", "text": "その触り方、ちょっと…、\nえ、エッチっぽかった…。"},
        { "location": "425/TALK"    , "narrator": "ガブリエラ", "text": "むぅ…いつまで経っても\n子供扱いして…。"},
        { "location": "427/TALK"    , "narrator": "ガブリエラ", "text": "…こ、子供っぽく\n思われそうだから…、\nちょっとだけよ？"},
        { "location": "434/TALK"    , "narrator": "ガブリエラ", "text": "…絶対故意に\n触ってるでしょ？"},
        { "location": "436/TALK"    , "narrator": "ガブリエラ", "text": "イヤッ！？"},
        { "location": "438/TALK"    , "narrator": "ガブリエラ", "text": "ば、バカバカバカ！！\nどこ触ってるのよ、\nエッチ！！"},
        { "location": "444/TALK"    , "narrator": "ガブリエラ", "text": "う～っ、どうして\nお腹触るのよぉ…。"},
        { "location": "447/TALK"    , "narrator": "ガブリエラ", "text": "ちょ、ちょっと待って！\nダメだってば！"},
        { "location": "448/TALK"    , "narrator": "ガブリエラ", "text": "その触り方、ちょっと…、\nえ、エッチっぽかった…。"},
