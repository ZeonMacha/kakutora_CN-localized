    [
        { "location": "137/SCENARIO", "narrator": "", "text": "150_簡単じゃないの"},
        { "location": "162/TALK"    , "narrator": "アーヤ", "text": "貴方と話すってことについて"},
        { "location": "163/TALK"    , "narrator": "アーヤ", "text": "整理をつけるのは"},
        { "location": "164/TALK"    , "narrator": "アーヤ", "text": "カンタンじゃないのよ"},
        { "location": "165/TALK"    , "narrator": "アーヤ", "text": "それはわかって欲しいの"},
        { "location": "167/SEL"     , "narrator": "", "text": "わかってるつもり"},
        { "location": "168/SEL"     , "narrator": "", "text": "わかってないかな？"},
        { "location": "169/SEL"     , "narrator": "", "text": "えー、やだ"},
        { "location": "170/ACT"     , "narrator": "", "text": "わかってるつもり"},
        { "location": "171/TALK"    , "narrator": "アーヤ", "text": "ほんとに"},
        { "location": "172/TALK"    , "narrator": "アーヤ", "text": "そうかしら？"},
        { "location": "173/ACT"     , "narrator": "", "text": "わかってないかな？"},
        { "location": "174/TALK"    , "narrator": "アーヤ", "text": "あんまり"},
        { "location": "175/TALK"    , "narrator": "アーヤ", "text": "そんな気がしないの"},
        { "location": "176/ACT"     , "narrator": "", "text": "えー、やだ"},
        { "location": "177/TALK"    , "narrator": "アーヤ", "text": "冗談にしないで"},
        { "location": "178/TALK"    , "narrator": "アーヤ", "text": "本気なんだから"},
        { "location": "180/TALK"    , "narrator": "アーヤ", "text": "なかなかね(´o｀；"},
        { "location": "181/TALK"    , "narrator": "アーヤ", "text": "割り切れないのよ(｡-_-｡)"},
        { "location": "183/TALK"    , "narrator": "アーヤ", "text": "Ｂｏｔと人間とが同じって思えないから"},
        { "location": "184/TALK"    , "narrator": "アーヤ", "text": "私は"},
        { "location": "186/SEL"     , "narrator": "", "text": "うん"},
        { "location": "187/SEL"     , "narrator": "", "text": "そうかなー"},
        { "location": "188/SEL"     , "narrator": "", "text": "アーヤの気持ち最優先でいいよ"},
        { "location": "190/ACT"     , "narrator": "", "text": "うん"},
        { "location": "191/TALK"    , "narrator": "アーヤ", "text": "あ"},
        { "location": "192/TALK"    , "narrator": "アーヤ", "text": "わかってくれてる"},
        { "location": "194/TALK"    , "narrator": "アーヤ", "text": "かな？"},
        { "location": "195/TALK"    , "narrator": "アーヤ", "text": "結構ね"},
        { "location": "196/TALK"    , "narrator": "アーヤ", "text": "難しいのよ"},
        { "location": "197/TALK"    , "narrator": "アーヤ", "text": "じゃあまたね"},
        { "location": "198/ACT"     , "narrator": "", "text": "そうかなー"},
        { "location": "199/TALK"    , "narrator": "アーヤ", "text": "そうなのよ"},
        { "location": "200/TALK"    , "narrator": "アーヤ", "text": "なかなか"},
        { "location": "201/TALK"    , "narrator": "アーヤ", "text": "難しいのよ"},
        { "location": "202/TALK"    , "narrator": "アーヤ", "text": "こっちは"},
        { "location": "203/TALK"    , "narrator": "アーヤ", "text": "またね"},
        { "location": "204/ACT"     , "narrator": "", "text": "アーヤの気持ち最優先でいいよ"},
        { "location": "214/TALK"    , "narrator": "アーヤ", "text": "そう言ってくれると"},
        { "location": "215/TALK"    , "narrator": "アーヤ", "text": "うれしい(；´Д｀)"},
        { "location": "217/TALK"    , "narrator": "アーヤ", "text": "もう本当"},
        { "location": "218/TALK"    , "narrator": "アーヤ", "text": "同じところでぐるぐるしてる感じ"},
        { "location": "220/SEL"     , "narrator": "", "text": "そうなんだ"},
        { "location": "221/SEL"     , "narrator": "", "text": "そうなのか……"},
        { "location": "222/ACT"     , "narrator": "", "text": "そうなんだ"},
        { "location": "223/TALK"    , "narrator": "アーヤ", "text": "まあね(´o｀；"},
        { "location": "224/ACT"     , "narrator": "", "text": "そうなのか……"},
        { "location": "225/TALK"    , "narrator": "アーヤ", "text": "なのよー(´o｀；"},
        { "location": "228/SEL"     , "narrator": "", "text": "まあわかるけど"},
        { "location": "229/SEL"     , "narrator": "", "text": "頭固いなあ"},
        { "location": "230/ACT"     , "narrator": "", "text": "まあわかるけど"},
        { "location": "231/TALK"    , "narrator": "アーヤ", "text": "本当に？"},
        { "location": "232/TALK"    , "narrator": "アーヤ", "text": "なんだか"},
        { "location": "233/TALK"    , "narrator": "アーヤ", "text": "怪しいのよ"},
        { "location": "234/ACT"     , "narrator": "", "text": "頭固いなあ"},
        { "location": "235/TALK"    , "narrator": "アーヤ", "text": "何それ？"},
        { "location": "236/TALK"    , "narrator": "アーヤ", "text": "そんなカンタンな"},
        { "location": "237/TALK"    , "narrator": "アーヤ", "text": "話じゃないでしょ？？"},
        { "location": "238/TALK"    , "narrator": "アーヤ", "text": "何言ってるの？"},
        { "location": "241/TALK"    , "narrator": "アーヤ", "text": "だいたい"},
        { "location": "242/TALK"    , "narrator": "アーヤ", "text": "こんな状況になったのも"},
        { "location": "243/TALK"    , "narrator": "アーヤ", "text": "貴方がＢｏｔのふりしてたからでしょ"},
        { "location": "246/SEL"     , "narrator": "", "text": "もう済んだ話でしょ"},
        { "location": "247/SEL"     , "narrator": "", "text": "仲良くしたいのにー"},
        { "location": "248/ACT"     , "narrator": "", "text": "もう済んだ話でしょ"},
        { "location": "250/TALK"    , "narrator": "アーヤ", "text": "そんな軽く"},
        { "location": "251/TALK"    , "narrator": "アーヤ", "text": "言うことじゃないわよ"},
        { "location": "252/ACT"     , "narrator": "", "text": "仲良くしたいのにー"},
        { "location": "254/TALK"    , "narrator": "アーヤ", "text": "もっと真剣に考えてよ"},
        { "location": "255/TALK"    , "narrator": "アーヤ", "text": "重要なことなんだから"},
        { "location": "258/TALK"    , "narrator": "アーヤ", "text": "なんかもう"},
        { "location": "260/TALK"    , "narrator": "アーヤ", "text": "どうしてこうなのかしら"},
        { "location": "262/TALK"    , "narrator": "アーヤ", "text": "もう！！"},
        { "location": "210/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>500pt.</b></color></size>\nアップしました！"}
    ]
