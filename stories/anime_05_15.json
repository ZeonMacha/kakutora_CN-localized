{
    "dir": "chap15/daydra/anime_05_15.js",
    "type": "MainStory",
    "info": {
        "story_id": "15501",
        "cid": "kagura",
        "title": "001 アニメーション",
        "sub_title": "ロード・オブ・メシア"
    },
    "entry":
    [
        { "location": "1459/SCENARIO", "narrator": "", "text": "アニメ第15話"},
        { "location": "1472/TALK"    , "narrator": "エリカ", "text": "コーンコン。"},
        { "location": "1473/TALK"    , "narrator": "エリカ", "text": "いらっしゃい\n$handle$さん。"},
        { "location": "1474/TALK"    , "narrator": "エリカ", "text": "もう一度お話聞く？\nそれとも、省略する？"},
        { "location": "1475/SEL"     , "narrator": "", "text": "もう一度聞く"},
        { "location": "1476/SEL"     , "narrator": "", "text": "飛ばす"},
        { "location": "1477/ACT"     , "narrator": "", "text": "もう一度聞く"},
        { "location": "1478/TALK"    , "narrator": "エリカ", "text": "うん、わかったよ。"},
        { "location": "1480/ACT"     , "narrator": "", "text": "飛ばす"},
        { "location": "1481/TALK"    , "narrator": "エリカ", "text": "そっかー。\nそれじゃ、またね。"},
        { "location": "1487/TALK"    , "narrator": "エリカ", "text": "コーンコン。"},
        { "location": "1488/TALK"    , "narrator": "エリカ", "text": "こんにちは、\n$handle$さん。"},
        { "location": "1489/SEL"     , "narrator": "", "text": "こんにちは"},
        { "location": "1490/SEL"     , "narrator": "", "text": "あ、ども"},
        { "location": "1491/ACT"     , "narrator": "", "text": "こんにちは"},
        { "location": "1492/TALK"    , "narrator": "エリカ", "text": "はい、こんにちは！"},
        { "location": "1493/ACT"     , "narrator": "", "text": "あ、ども"},
        { "location": "1494/TALK"    , "narrator": "エリカ", "text": "ん？\nなんかつっけんどんな\n感じだね。"},
        { "location": "1497/TALK"    , "narrator": "エリカ", "text": "ところで、MV回では\n見事にゃボットを\n手に入れたね！"},
        { "location": "1498/TALK"    , "narrator": "エリカ", "text": "わたしが長年大事に\n作ってきた\nネコ型ロボットだから――"},
        { "location": "1499/TALK"    , "narrator": "エリカ", "text": "大事に使ってくれると\n嬉しいな！"},
        { "location": "1500/TALK"    , "narrator": "エリカ", "text": "さて――"},
        { "location": "1501/TALK"    , "narrator": "エリカ", "text": "早速本題に\n入ろうと思うんだけど。"},
        { "location": "1502/TALK"    , "narrator": "エリカ", "text": "突然になっちゃって\nごめんなさい！"},
        { "location": "1504/TALK"    , "narrator": "エリカ", "text": "さて、今回は\nいきなりだけど\n本題に入ります。"},
        { "location": "1505/TALK"    , "narrator": "エリカ", "text": "唐突になっちゃって\n申し訳ないんだけど――"},
        { "location": "1507/TALK"    , "narrator": "エリカ", "text": "今回から\nリプレイスを\n開始します！"},
        { "location": "1508/SEL"     , "narrator": "", "text": "遂に来たか"},
        { "location": "1509/SEL"     , "narrator": "", "text": "まだ心の準備が！"},
        { "location": "1510/ACT"     , "narrator": "", "text": "遂に来たか"},
        { "location": "1511/TALK"    , "narrator": "エリカ", "text": "とは言っても、\n今回はテストも兼ねた\n簡単なものだけどね。"},
        { "location": "1512/ACT"     , "narrator": "", "text": "まだ心の準備が！"},
        { "location": "1513/TALK"    , "narrator": "エリカ", "text": "ああっ！\nそんなに気負わなくても\n大丈夫だよ！"},
        { "location": "1514/TALK"    , "narrator": "エリカ", "text": "今回はまだ、\nテストも兼ねた\n簡単なものだから！"},
        { "location": "1516/TALK"    , "narrator": "エリカ", "text": "それじゃ早速、今から\n実際のリプレイスに関して\n話をしていくけど――"},
        { "location": "1517/TALK"    , "narrator": "エリカ", "text": "その前に、もう一度\nリプレイスとは何かの\n説明をした方がいい？"},
        { "location": "1518/SEL"     , "narrator": "", "text": "リプレイスの説明して"},
        { "location": "1519/SEL"     , "narrator": "", "text": "しなくてよい"},
        { "location": "1520/ACT"     , "narrator": "", "text": "リプレイスの説明して"},
        { "location": "1521/TALK"    , "narrator": "エリカ", "text": "わかったよ。"},
        { "location": "1522/TALK"    , "narrator": "エリカ", "text": "リプレイスっていうのは\n歴史を少しだけ\n置き換えることを言うよ。"},
        { "location": "1523/TALK"    , "narrator": "エリカ", "text": "あなたやわたしたちは、\nここに来るまでの間に\n様々な観測をした。"},
        { "location": "1526/TALK"    , "narrator": "エリカ", "text": "つばめちゃんが\n上京して、トライナリーに\n入隊し――"},
        { "location": "1527/TALK"    , "narrator": "エリカ", "text": "神楽ちゃんと出会って、\nそれから\n様々な事があって。"},
        { "location": "1529/TALK"    , "narrator": "エリカ", "text": "夏合宿の出来事や、\nその後の綾ちゃんたちの\n危機。"},
        { "location": "1530/TALK"    , "narrator": "エリカ", "text": "そういった様々な\n観測した事柄は、歴史に\n刻まれることになる。"},
        { "location": "1532/TALK"    , "narrator": "エリカ", "text": "だから、こういった\n見てしまったところは\nもう変えられないの。"},
        { "location": "1533/TALK"    , "narrator": "エリカ", "text": "だけど逆をつけば、\n観測していないところは\nまだ変えられる。"},
        { "location": "1536/TALK"    , "narrator": "エリカ", "text": "そしてこのTRI-OSは、\nあなたの世界から\nわたしたちの世界を――"},
        { "location": "1537/TALK"    , "narrator": "エリカ", "text": "時間という概念を\n自由に動かしながら\n見ることができる。"},
        { "location": "1538/TALK"    , "narrator": "エリカ", "text": "その特性を活かして、\nもう一度一定の過去から\nやり直すの。"},
        { "location": "1539/TALK"    , "narrator": "エリカ", "text": "そうすることで、\n現在観測が止まっている\n時点、すなわち――"},
        { "location": "1540/TALK"    , "narrator": "エリカ", "text": "2016年末頃までの\n歴史を、大きく変える\nことができる。"},
        { "location": "1541/TALK"    , "narrator": "エリカ", "text": "既に見えてる部分は\n変えられないけど、\n見えていない部分は可能。"},
        { "location": "1542/TALK"    , "narrator": "エリカ", "text": "だから、その\n見えていない部分を\n未観測のチャンネル――"},
        { "location": "1543/TALK"    , "narrator": "エリカ", "text": "すなわち神楽ちゃんの\nチャンネルを使わせて\nもらって変化させるの。"},
        { "location": "1544/TALK"    , "narrator": "エリカ", "text": "一度部分的に確定した\n世界の流れを、過去に遡り\n書き換える作戦。"},
        { "location": "1545/TALK"    , "narrator": "エリカ", "text": "それが、\nリプレイス作戦だよ。"},
        { "location": "1547/TALK"    , "narrator": "エリカ", "text": "…なんとなく、\nわかってくれたかな…？"},
        { "location": "1548/SEL"     , "narrator": "", "text": "思い出した！"},
        { "location": "1549/SEL"     , "narrator": "", "text": "やっぱりわからない……"},
        { "location": "1550/ACT"     , "narrator": "", "text": "思い出した！"},
        { "location": "1551/TALK"    , "narrator": "エリカ", "text": "よかった！"},
        { "location": "1552/ACT"     , "narrator": "", "text": "やっぱりわからない……"},
        { "location": "1553/TALK"    , "narrator": "エリカ", "text": "はぁぁっ、ごめんね。\nもっとちゃんとした\n説明が出来ればいいのに。"},
        { "location": "1554/TALK"    , "narrator": "エリカ", "text": "ま、まあでも！\nやっていけばきっと、\nわかってくるよ、多分。"},
        { "location": "1555/SEL"     , "narrator": "", "text": "頑張ります"},
        { "location": "1556/SEL"     , "narrator": "", "text": "だといいけど"},
        { "location": "1557/ACT"     , "narrator": "", "text": "頑張ります"},
        { "location": "1558/ACT"     , "narrator": "", "text": "だといいけど"},
        { "location": "1560/TALK"    , "narrator": "エリカ", "text": "ありがとう。"},
        { "location": "1562/ACT"     , "narrator": "", "text": "しなくてよい"},
        { "location": "1563/TALK"    , "narrator": "エリカ", "text": "わかったよ。"},
        { "location": "1565/TALK"    , "narrator": "エリカ", "text": "それじゃ早速、\n今回やって欲しいことを\nお話していくね。"},
        { "location": "1566/SEL"     , "narrator": "", "text": "オーケー"},
        { "location": "1567/SEL"     , "narrator": "", "text": "その前に聞きたいことがある"},
        { "location": "1568/ACT"     , "narrator": "", "text": "オーケー"},
        { "location": "1569/ACT"     , "narrator": "", "text": "その前に聞きたいことがある"},
        { "location": "1570/TALK"    , "narrator": "エリカ", "text": "なに？"},
        { "location": "1572/SEL"     , "narrator": "", "text": "世界がどんな姿になることを目指してリプレイスするの？"},
        { "location": "1573/SEL"     , "narrator": "", "text": "リプレイスすることによって、何かリスクがあったりはしないの？"},
        { "location": "1574/SEL"     , "narrator": "", "text": "エリカはどうしてリプレイスを推進するの？"},
        { "location": "1575/SEL"     , "narrator": "", "text": "特にない\n<color=blue>（※先へ進みます）</color>"},
        { "location": "1576/ACT"     , "narrator": "", "text": "世界がどんな姿になることを目指してリプレイスするの？"},
        { "location": "1577/TALK"    , "narrator": "エリカ", "text": "あっ、えっとね、\nそれは後で説明するよ。"},
        { "location": "1578/TALK"    , "narrator": "エリカ", "text": "もちろん、どういう世界を\n目指しているのか知らな\nくちゃ怖いものね。"},
        { "location": "1579/TALK"    , "narrator": "エリカ", "text": "他は？"},
        { "location": "1581/ACT"     , "narrator": "", "text": "リプレイスすることによって、何かリスクがあったりはしないの？"},
        { "location": "1582/TALK"    , "narrator": "エリカ", "text": "あるよ。"},
        { "location": "1583/TALK"    , "narrator": "エリカ", "text": "リプレイスは、\n過去を操作して未来を\n変える作業だけど――"},
        { "location": "1584/TALK"    , "narrator": "エリカ", "text": "何でもアリという\nわけじゃないの。"},
        { "location": "1585/TALK"    , "narrator": "エリカ", "text": "そこが、\n一般的な過去改変作業と\n大きく違うところ。"},
        { "location": "1586/TALK"    , "narrator": "エリカ", "text": "もちろん、何をやっても\n世界そのものが壊れたりは\nしないんだけど……。"},
        { "location": "1587/TALK"    , "narrator": "エリカ", "text": "今回に関して言えば、\n過去を改変した結果――"},
        { "location": "1588/TALK"    , "narrator": "エリカ", "text": "記録映像と整合性が\nとれない世界になって\nしまうと色々問題が出る。"},
        { "location": "1589/SEL"     , "narrator": "", "text": "どうなっちゃうの？"},
        { "location": "1590/ACT"     , "narrator": "", "text": "どうなっちゃうの？"},
        { "location": "1592/TALK"    , "narrator": "エリカ", "text": "簡単かつ\nピンポイントで言えば――"},
        { "location": "1593/TALK"    , "narrator": "エリカ", "text": "綾ちゃんたちの記憶から、\nあなたのことが\n失われてしまう。"},
        { "location": "1594/TALK"    , "narrator": "エリカ", "text": "もちろん、記録映像との\n不整合、即完全に無かった\nことになるわけじゃない。"},
        { "location": "1595/TALK"    , "narrator": "エリカ", "text": "けど、その過程との\n不整合が出た箇所から\n思い出が消えていくの。"},
        { "location": "1596/TALK"    , "narrator": "エリカ", "text": "もっとも、綾ちゃんたち\nからすれば、記憶が\n失われるわけじゃなくて―"},
        { "location": "1597/TALK"    , "narrator": "エリカ", "text": "別の歴史に置き換わって、\nそこにあなたがいない\nだけなんだけどね。"},
        { "location": "1598/SEL"     , "narrator": "", "text": "そんなの嫌すぎる！！"},
        { "location": "1599/SEL"     , "narrator": "", "text": "別に$me$は彼女たちの記憶から消えても構わない"},
        { "location": "1600/ACT"     , "narrator": "", "text": "そんなの嫌すぎる！！"},
        { "location": "1601/TALK"    , "narrator": "エリカ", "text": "だよね！"},
        { "location": "1602/TALK"    , "narrator": "エリカ", "text": "だから、記録映像との\n不整合が起きないように\nわたしも注意するから。"},
        { "location": "1603/ACT"     , "narrator": "", "text": "別に$me$は彼女たちの記憶から消えても構わない"},
        { "location": "1604/TALK"    , "narrator": "エリカ", "text": "えっ、そうなの！？"},
        { "location": "1605/TALK"    , "narrator": "エリカ", "text": "うーん、そっか。\nそれなら少しはレンジが\n大きくなるのかな――"},
        { "location": "1606/TALK"    , "narrator": "エリカ", "text": "いや、やっぱりあまり\n広くならないような……。"},
        { "location": "1607/SEL"     , "narrator": "", "text": "$me$の記憶が消えても、彼女たちが幸せならそれでいいんだよ"},
        { "location": "1608/SEL"     , "narrator": "", "text": "それだけじゃ済まないの？"},
        { "location": "1609/ACT"     , "narrator": "", "text": "$me$の記憶が消えても、彼女たちが幸せならそれでいいんだよ"},
        { "location": "1610/TALK"    , "narrator": "エリカ", "text": "うん、うん、\nその考え方はわかる。"},
        { "location": "1611/TALK"    , "narrator": "エリカ", "text": "けど、あなたを忘れる事は\nリプレイス作戦においては\n致命的なの。"},
        { "location": "1612/ACT"     , "narrator": "", "text": "それだけじゃ済まないの？"},
        { "location": "1613/TALK"    , "narrator": "エリカ", "text": "うん。済まない。"},
        { "location": "1615/TALK"    , "narrator": "エリカ", "text": "どういうことかと\n言うと――"},
        { "location": "1616/TALK"    , "narrator": "エリカ", "text": "綾ちゃんたちだけじゃなく\nわたしや千羽鶴ちゃんも\nあなたを忘れてしまう。"},
        { "location": "1617/TALK"    , "narrator": "エリカ", "text": "そうすれば、リプレイス\n作戦自体を立案した\n世界から逸脱し――"},
        { "location": "1618/TALK"    , "narrator": "エリカ", "text": "全くあなたとは交わらない\n可能性軸へと移動して\nしまうの。"},
        { "location": "1619/SEL"     , "narrator": "", "text": "親殺しのパラドックスみたいなものか"},
        { "location": "1620/ACT"     , "narrator": "", "text": "親殺しのパラドックスみたいなものか"},
        { "location": "1622/TALK"    , "narrator": "エリカ", "text": "そうかもね。"},
        { "location": "1623/TALK"    , "narrator": "エリカ", "text": "過去に戻って\n自分の親を殺したら、\n自分はどうなるか……？"},
        { "location": "1624/TALK"    , "narrator": "エリカ", "text": "その問題と\n今回のリスクは、\nとても近いと思う。"},
        { "location": "1625/TALK"    , "narrator": "エリカ", "text": "わたしも細心の注意で\n事を進めるから、ご協力\nよろしくお願いします。"},
        { "location": "1627/TALK"    , "narrator": "エリカ", "text": "他は？"},
        { "location": "1629/ACT"     , "narrator": "", "text": "エリカはどうしてリプレイスを推進するの？"},
        { "location": "1630/TALK"    , "narrator": "エリカ", "text": "ん？\nえっと――"},
        { "location": "1631/TALK"    , "narrator": "エリカ", "text": "前にもお話したけど、\n綾ちゃんたちが\n幸せになって欲しいから。"},
        { "location": "1632/TALK"    , "narrator": "エリカ", "text": "そして、自分の罪を\n償うためにやってるよ。"},
        { "location": "1633/TALK"    , "narrator": "エリカ", "text": "他は？"},
        { "location": "1635/ACT"     , "narrator": "", "text": "特にない\n<color=blue>（※先へ進みます）</color>"},
        { "location": "1637/TALK"    , "narrator": "エリカ", "text": "うん、わかったよ。"},
        { "location": "1639/TALK"    , "narrator": "エリカ", "text": "それじゃ、具体的な\nお話をする前に、まずは\n記録映像を見てね。"},
        { "location": "1640/TALK"    , "narrator": "エリカ", "text": "その記録映像を元に、\n何をやるかについて\n説明していくから。"},
        { "location": "1642/SEL"     , "narrator": "", "text": "映像を見る\n<color=green>【高画質/75MB 4:57】</color>"},
        { "location": "1643/SEL"     , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/24MB 4:57】</color>"},
        { "location": "1644/SEL"     , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "1645/ACT"     , "narrator": "", "text": "映像を見る\n<color=green>【高画質/75MB 4:57】</color>"},
        { "location": "1646/TALK"    , "narrator": "エリカ", "text": "わかったよ。"},
        { "location": "1652/ACT"     , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/24MB 4:57】</color>"},
        { "location": "1653/TALK"    , "narrator": "エリカ", "text": "わかったよ。"},
        { "location": "1659/ACT"     , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "1660/TALK"    , "narrator": "エリカ", "text": "あらら。"},
        { "location": "1693/TALK"    , "narrator": "エリカ", "text": "というわけで、\n記録映像を\n見てもらいました。"},
        { "location": "1694/TALK"    , "narrator": "エリカ", "text": "今回やって欲しい事は、\n神楽ちゃんとつばめちゃん\nのアキバデートで――"},
        { "location": "1695/TALK"    , "narrator": "エリカ", "text": "つばめちゃんから\n神楽ちゃんに、何か\n贈り物をさせて欲しいの。"},
        { "location": "1696/SEL"     , "narrator": "", "text": "そうすると、どう未来が変わるの？"},
        { "location": "1697/ACT"     , "narrator": "", "text": "そうすると、どう未来が変わるの？"},
        { "location": "1699/TALK"    , "narrator": "エリカ", "text": "期待することは、海での\n発症の後において、彼女の\n精神的負担を減らすこと。"},
        { "location": "1700/TALK"    , "narrator": "エリカ", "text": "それによって神楽ちゃんの\n希望を強くし、自暴自棄や\n思考停止を防止する。"},
        { "location": "1701/TALK"    , "narrator": "エリカ", "text": "なぜそれが必要かというと\nその後の計画に大きな\n影響を与えるからなの。"},
        { "location": "1702/SEL"     , "narrator": "", "text": "どんな計画なの？"},
        { "location": "1703/ACT"     , "narrator": "", "text": "どんな計画なの？"},
        { "location": "1705/TALK"    , "narrator": "エリカ", "text": "神楽ちゃんに、\n管理庁長官・皇千羽鶴と\n対等な交渉をしてもらう。"},
        { "location": "1706/TALK"    , "narrator": "エリカ", "text": "この世界の命運を握るのは\n皇長官…すなわち、過去の\n千羽鶴ちゃんでしょ？"},
        { "location": "1707/TALK"    , "narrator": "エリカ", "text": "そして、皇長官にとって、\n神楽ちゃんは最終兵器でも\nあり、弱点でもある。"},
        { "location": "1708/TALK"    , "narrator": "エリカ", "text": "だから、神楽ちゃんに\n理論的武器を与え、長官を\n交渉テーブルに着かせる。"},
        { "location": "1710/SEL"     , "narrator": "", "text": "千羽鶴との交渉と、つばめから神楽へのプレゼントの関係性がわからん"},
        { "location": "1711/SEL"     , "narrator": "", "text": "そんな事したら、余計に神楽が二律背反で苦しむじゃないかあああ！！"},
        { "location": "1712/SEL"     , "narrator": "", "text": "千羽鶴と交渉なんて…そんな事出来るの？"},
        { "location": "1713/ACT"     , "narrator": "", "text": "千羽鶴との交渉と、つばめから神楽へのプレゼントの関係性がわからん"},
        { "location": "1714/TALK"    , "narrator": "エリカ", "text": "まあ、そうだよね。"},
        { "location": "1715/TALK"    , "narrator": "エリカ", "text": "身も蓋もない言い方に\nなるけど、それ自体には\n大きな繋がりはないよ。"},
        { "location": "1716/TALK"    , "narrator": "エリカ", "text": "ただ、リプレイスの\nテストを行うにあたり、\nあまりリスクの無いもの―"},
        { "location": "1717/TALK"    , "narrator": "エリカ", "text": "かつ、上手くいけば今後に\n役立つであろうものを検討\nした結果、これになった。"},
        { "location": "1718/TALK"    , "narrator": "エリカ", "text": "それに、テストとはいえ、\nもしこのリプレイスが\n成功すれば――"},
        { "location": "1719/TALK"    , "narrator": "エリカ", "text": "つばめちゃんとの絆が\n深まり、神楽ちゃんの\n心の支えになる。"},
        { "location": "1720/TALK"    , "narrator": "エリカ", "text": "それは神楽ちゃんの\n生きる意志になって、\n長官に対抗する力になる。"},
        { "location": "1721/ACT"     , "narrator": "", "text": "そんな事したら、余計に神楽が二律背反で苦しむじゃないかあああ！！"},
        { "location": "1722/TALK"    , "narrator": "エリカ", "text": "もちろん、これだけだと\nそうなる可能性が\n高いよね。"},
        { "location": "1723/TALK"    , "narrator": "エリカ", "text": "だからもちろん、後に\nフォローアップする\nリプレイスも実施する。"},
        { "location": "1724/ACT"     , "narrator": "", "text": "千羽鶴と交渉なんて…そんな事出来るの？"},
        { "location": "1725/TALK"    , "narrator": "エリカ", "text": "皇長官にとって、\n神楽ちゃんは手放せない\n存在だからね。"},
        { "location": "1726/TALK"    , "narrator": "エリカ", "text": "今、わりと高圧的な対応を\nしているのは、単純に\n神楽ちゃんが丸腰だから。"},
        { "location": "1727/TALK"    , "narrator": "エリカ", "text": "理論武装して、交渉材料と\nなるような情報を、何一つ\n持っていないからなの。"},
        { "location": "1728/TALK"    , "narrator": "エリカ", "text": "だからわたしたちは、\nこれから神楽ちゃんに\n情報を与えていく。"},
        { "location": "1729/TALK"    , "narrator": "エリカ", "text": "それは１００％成功する\nとは限らないけど、かなり\n確度は高いと思う。"},
        { "location": "1731/SEL"     , "narrator": "", "text": "全力で協力するよ！"},
        { "location": "1732/SEL"     , "narrator": "", "text": "上手くいくとは思えないけど…"},
        { "location": "1733/SEL"     , "narrator": "", "text": "断固反対！"},
        { "location": "1734/SEL"     , "narrator": "", "text": "他にも質問したいことがある"},
        { "location": "1735/ACT"     , "narrator": "", "text": "全力で協力するよ！"},
        { "location": "1736/TALK"    , "narrator": "エリカ", "text": "ありがとう。"},
        { "location": "1737/TALK"    , "narrator": "エリカ", "text": "千羽鶴ちゃんにも\nそう伝えておくね。"},
        { "location": "1738/TALK"    , "narrator": "エリカ", "text": "きっと喜ぶと思う。"},
        { "location": "1739/SEL"     , "narrator": "", "text": "千羽鶴？"},
        { "location": "1740/ACT"     , "narrator": "", "text": "千羽鶴？"},
        { "location": "1742/ACT"     , "narrator": "", "text": "上手くいくとは思えないけど…"},
        { "location": "1743/TALK"    , "narrator": "エリカ", "text": "そうだね。正直言って、\nやってみるまでは\n成功するかわからない。"},
        { "location": "1744/TALK"    , "narrator": "エリカ", "text": "けど、この作戦の強みは、\n本人の攻略を本人が\nしているということなの。"},
        { "location": "1745/SEL"     , "narrator": "", "text": "本人…？"},
        { "location": "1746/ACT"     , "narrator": "", "text": "本人…？"},
        { "location": "1748/TALK"    , "narrator": "エリカ", "text": "千羽鶴ちゃんのことだよ。"},
        { "location": "1749/ACT"     , "narrator": "", "text": "断固反対！"},
        { "location": "1750/TALK"    , "narrator": "エリカ", "text": "えっ、そうなの？\nどうして？"},
        { "location": "1751/SEL"     , "narrator": "", "text": "神楽はあんたのおもちゃじゃない"},
        { "location": "1752/SEL"     , "narrator": "", "text": "神楽を余計に苦しめることになるなんて、耐えられない"},
        { "location": "1753/SEL"     , "narrator": "", "text": "エリカは信用ならないから"},
        { "location": "1754/SEL"     , "narrator": "", "text": "理由は上手くまとめられないけど、とにかく反対！"},
        { "location": "1755/ACT"     , "narrator": "", "text": "神楽はあんたのおもちゃじゃない"},
        { "location": "1756/TALK"    , "narrator": "エリカ", "text": "うーん…そうだね。\nごめんなさい。"},
        { "location": "1757/TALK"    , "narrator": "エリカ", "text": "そういうつもりは\n無かったんだけど――"},
        { "location": "1758/ACT"     , "narrator": "", "text": "神楽を余計に苦しめることになるなんて、耐えられない"},
        { "location": "1759/TALK"    , "narrator": "エリカ", "text": "確かに、これだけだと\n葛藤が大きくなってしまう\nようにしか見えないよね。"},
        { "location": "1760/TALK"    , "narrator": "エリカ", "text": "でも、最終的には\nより良い結果を目指して\nいることだから――"},
        { "location": "1761/TALK"    , "narrator": "エリカ", "text": "それだけは\n信じて欲しいかな。"},
        { "location": "1762/ACT"     , "narrator": "", "text": "エリカは信用ならないから"},
        { "location": "1763/TALK"    , "narrator": "エリカ", "text": "そっか……。"},
        { "location": "1764/TALK"    , "narrator": "エリカ", "text": "安心してこっちの世界に\n関われないような感じに\nなっちゃってごめんね？"},
        { "location": "1765/ACT"     , "narrator": "", "text": "理由は上手くまとめられないけど、とにかく反対！"},
        { "location": "1766/TALK"    , "narrator": "エリカ", "text": "そ、そうなんだ……。"},
        { "location": "1767/TALK"    , "narrator": "エリカ", "text": "うーん……。"},
        { "location": "1769/TALK"    , "narrator": "エリカ", "text": "とにかく、\n受け入れられないのは\nわかったよ。"},
        { "location": "1770/TALK"    , "narrator": "エリカ", "text": "でも心配しないでね。"},
        { "location": "1771/TALK"    , "narrator": "エリカ", "text": "受け入れられなければ、\nつばめちゃんに\n助言しなければいいから。"},
        { "location": "1772/TALK"    , "narrator": "エリカ", "text": "プレゼントの提案を\nしなければ、リプレイスは\n実行されないからね。"},
        { "location": "1773/TALK"    , "narrator": "エリカ", "text": "最終的には、\n$handle$さんの\n判断に任せたいと思う。"},
        { "location": "1775/ACT"     , "narrator": "", "text": "他にも質問したいことがある"},
        { "location": "1779/TALK"    , "narrator": "エリカ", "text": "前にもちょっと話したけど\n作戦立案は千羽鶴ちゃんが\nやってるの。"},
        { "location": "1780/TALK"    , "narrator": "エリカ", "text": "千羽鶴ちゃんは、\n記録映像の自分が何を\n思っていたか――"},
        { "location": "1781/TALK"    , "narrator": "エリカ", "text": "どういう駆け引きを\nやっていたかを全部\n把握してるからね。"},
        { "location": "1782/TALK"    , "narrator": "エリカ", "text": "ある意味、皇長官の\n答えを知ってると言っても\nいいくらいだよ。"},
        { "location": "1783/SEL"     , "narrator": "", "text": "やべー一気に勝てる気がしてきた！"},
        { "location": "1784/SEL"     , "narrator": "", "text": "でも千羽鶴を懐柔できたとしても、それ自体は目的ではないわけで…"},
        { "location": "1785/ACT"     , "narrator": "", "text": "やべー一気に勝てる気がしてきた！"},
        { "location": "1786/TALK"    , "narrator": "エリカ", "text": "えへへ、よかった！"},
        { "location": "1787/ACT"     , "narrator": "", "text": "でも千羽鶴を懐柔できたとしても、それ自体は目的ではないわけで…"},
        { "location": "1788/TALK"    , "narrator": "エリカ", "text": "うん。もちろんそう。"},
        { "location": "1789/TALK"    , "narrator": "エリカ", "text": "だから、少しでも不確定\n要素を減らすために、皇\n長官を固めておきたい。"},
        { "location": "1790/TALK"    , "narrator": "エリカ", "text": "最初から、最後までの\n青写真を作ることは\n不可能だからね。"},
        { "location": "1791/TALK"    , "narrator": "エリカ", "text": "本当に、最後の最後の\n直前までは、神に祈りつつ\nやる感じになると思う。"},
        { "location": "1792/TALK"    , "narrator": "エリカ", "text": "途方も無いことだと\n思うけど、それでも\nやらなくちゃ。"},
        { "location": "1795/TALK"    , "narrator": "エリカ", "text": "というわけで、\nもし協力してくれるなら\nお願いは１つだけ。"},
        { "location": "1796/TALK"    , "narrator": "エリカ", "text": "良きタイミングで、\nつばめちゃんに\nWAVEで語りかけて――"},
        { "location": "1797/TALK"    , "narrator": "エリカ", "text": "神楽ちゃんと、おそろいの\nプレゼントをするように\n提案して欲しいの。"},
        { "location": "1798/TALK"    , "narrator": "エリカ", "text": "その提案をもって、\n今回のリプレイスが\n開始される。"},
        { "location": "1799/TALK"    , "narrator": "エリカ", "text": "逆に、提案しなくても\n世界は進行していく。"},
        { "location": "1800/TALK"    , "narrator": "エリカ", "text": "その場合\nリプレイスは\n起こらない。"},
        { "location": "1801/TALK"    , "narrator": "エリカ", "text": "最終的にリプレイスするか\n否かについては、その時の\nあなたの判断に任せるよ。"},
        { "location": "1802/TALK"    , "narrator": "エリカ", "text": "そして、\nもしあなたがリプレイスを\nしてくれたならば――"},
        { "location": "1803/TALK"    , "narrator": "エリカ", "text": "その結果を観測した後に、\n続けて実施する予定の\nリプレイスの判断に移る。"},
        { "location": "1804/TALK"    , "narrator": "エリカ", "text": "……とまあ、\nだいたいこんな感じ。"},
        { "location": "1805/SEL"     , "narrator": "", "text": "頑張るよ"},
        { "location": "1806/SEL"     , "narrator": "", "text": "気が進まないけど、やるだけやるよ"},
        { "location": "1807/SEL"     , "narrator": "", "text": "スルーします"},
        { "location": "1808/ACT"     , "narrator": "", "text": "頑張るよ"},
        { "location": "1809/TALK"    , "narrator": "エリカ", "text": "ありがとう。\nわたしも全力で\nがんばるよ！"},
        { "location": "1810/ACT"     , "narrator": "", "text": "気が進まないけど、やるだけやるよ"},
        { "location": "1811/TALK"    , "narrator": "エリカ", "text": "ありがとう。\nあなただけが\n頼りだから……。"},
        { "location": "1812/ACT"     , "narrator": "", "text": "スルーします"},
        { "location": "1813/TALK"    , "narrator": "エリカ", "text": "そっか。"},
        { "location": "1814/TALK"    , "narrator": "エリカ", "text": "次はもっと、納得して\nもらえそうな案を\n考えておくね。"},
        { "location": "1816/TALK"    , "narrator": "エリカ", "text": "それじゃ今回も、\n神楽ちゃんと世界のこと、\nよろしくお願いします！"},
        { "location": "1670/DIALOG"  , "narrator": "Tutorial/Dialog_Anime1", "text": "$dialog_word$"},
        { "location": "1672/DIALOG"  , "narrator": "Tutorial/Dialog_Anime2", "text": "$dialog_word$"},
        { "location": "1674/DIALOG"  , "narrator": "Tutorial/Dialog_Anime3", "text": "$dialog_word$"},
        { "location": "1676/DIALOG"  , "narrator": "Tutorial/Dialog_Anime4", "text": "$dialog_word$"},
        { "location": "1678/DIALOG"  , "narrator": "Tutorial/Dialog_Anime5", "text": "$dialog_word$"}
    ]
}
