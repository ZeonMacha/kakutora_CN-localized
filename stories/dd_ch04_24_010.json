{
    "dir": "chap24/daydra/dd_ch04_24_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "24452",
        "cid": "miyabi",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "うさぎとデート"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "ウサギとデート"},
        { "location": "31/TALK"   , "narrator": "雛", "text": "つばめちゃん。\n早く学食いこ？"},
        { "location": "32/TALK"   , "narrator": "つばめ", "text": "あ、ちょっと待って。"},
        { "location": "35/TALK"   , "narrator": "みやび", "text": "おーい、うさぎー。\nおるかー？"},
        { "location": "37/TALK"   , "narrator": "繭", "text": "…はい？"},
        { "location": "39/TALK"   , "narrator": "つばめ", "text": "あ、みやびさん。\nどうしたんですか？"},
        { "location": "40/TALK"   , "narrator": "みやび", "text": "ん、ちくっとうさぎに\n用事があってな。"},
        { "location": "41/TALK"   , "narrator": "繭", "text": "何の御用でしょう？"},
        { "location": "42/TALK"   , "narrator": "みやび", "text": "ん…予定ないなら、\nこれからうちと\nデートせんか？"},
        { "location": "44/TALK"   , "narrator": "つばめ", "text": "えっ！？"},
        { "location": "46/TALK"   , "narrator": "雛", "text": "で、デート！？"},
        { "location": "47/TALK"   , "narrator": "繭", "text": "…………。"},
        { "location": "48/TALK"   , "narrator": "繭", "text": "わかりました。\n予定はないので、\nお付き合いいたします。"},
        { "location": "49/TALK"   , "narrator": "みやび", "text": "すまんなぁ。\nまっこと感謝するちや。"},
        { "location": "52/TALK"   , "narrator": "みやび", "text": "ちゅーわけやき、\nうさぎを借りるぞねー。"},
        { "location": "54/TALK"   , "narrator": "繭", "text": "二人とも、また。"},
        { "location": "60/TALK"   , "narrator": "雛", "text": "…ほ、本当のデートって\nわけじゃないよね？"},
        { "location": "62/TALK"   , "narrator": "つばめ", "text": "どうなんだろ？\nでも、二人ともとっても\n仲いいよね！"},
        { "location": "63/TALK"   , "narrator": "雛", "text": "だからちょっと\n疑っちゃうんじゃん。"},
        { "location": "65/TALK"   , "narrator": "雛", "text": "…それにしても、\nデートって、\nどこ行くんだろ…？"},
        { "location": "67/TALK"   , "narrator": "つばめ", "text": "まさか、学校サボって\nほんとにデート\nするのかなぁ？"},
        { "location": "68/TALK"   , "narrator": "雛", "text": "さすがにそれは……"},
        { "location": "69/TALK"   , "narrator": "雛", "text": "いや、やりかねないわ。"},
        { "location": "82/TALK"   , "narrator": "みやび", "text": "あ～、やっぱこの街は\n落ち着くなぁ…。"},
        { "location": "83/TALK"   , "narrator": "みやび", "text": "うちの好きなもんが\nたっくさん集まる、\n夢のパラダイスや！"},
        { "location": "85/TALK"   , "narrator": "みやび", "text": "うちはいずれ、\nアキバの中心に\n家作って引きこもるがよ。"},
        { "location": "87/TALK"   , "narrator": "繭", "text": "大きいのか小さいのか\n判断に困る夢ですね。"},
        { "location": "88/TALK"   , "narrator": "みやび", "text": "まあ、うちの夢の話は\n今はどうでもえい。"},
        { "location": "89/TALK"   , "narrator": "みやび", "text": "田舎にずーっといたり、\n卯月のことで溜まっちょった\nこのフラストレーション――"},
        { "location": "90/TALK"   , "narrator": "みやび", "text": "限界突破のメルトダウン\n起こす前に発散できて、\n一安心ぞね。"},
        { "location": "93/TALK"   , "narrator": "繭", "text": "ご実家のある街も、\n静かでよいところだと\n思いました。"},
        { "location": "94/TALK"   , "narrator": "繭", "text": "ですが、我々にとっては\nこういう街こそが\n癒しの場ですからね。"},
        { "location": "97/TALK"   , "narrator": "みやび", "text": "理解が早くて助かる。"},
        { "location": "98/TALK"   , "narrator": "みやび", "text": "けんど…誘いに行った時に\nちくっとも慌てんかったのは\n寂しかったちや…。"},
        { "location": "100/TALK"  , "narrator": "繭", "text": "多分こういうことだろうと\n予想はしていましたので。"},
        { "location": "101/TALK"  , "narrator": "みやび", "text": "むむむ、理解があり過ぎる\nっちゅうのも、考えもん\nやね…。"},
        { "location": "102/TALK"  , "narrator": "繭", "text": "それは重要なのでしょうか？"},
        { "location": "103/TALK"  , "narrator": "繭", "text": "今日の目的は、パーツを\n買ってフラストレーションを\n発散することでしょう？"},
        { "location": "104/TALK"  , "narrator": "みやび", "text": "そうやけんど、うさぎの\n可愛らしく慌てる姿も\n見れたらなぁ…。"},
        { "location": "107/TALK"  , "narrator": "繭", "text": "ご、ご冗談を…。"},
        { "location": "108/TALK"  , "narrator": "みやび", "text": "いやいや、まっことや。\nウソやないぞ？"},
        { "location": "110/TALK"  , "narrator": "繭", "text": "はぁ…バカなことを\n言わないでください。"},
        { "location": "111/TALK"  , "narrator": "繭", "text": "利益のないことをしても\n得るものなど何も\nありませんよ？"},
        { "location": "113/TALK"  , "narrator": "みやび", "text": "…うさぎが段々と、\nうちに対してドライに\nなってきちゅう気がする…。"},
        { "location": "115/TALK"  , "narrator": "繭", "text": "鍛えられましたので。\nみやび先輩直々に。"},
        { "location": "116/TALK"  , "narrator": "みやび", "text": "ふむ…。"},
        { "location": "129/TALK"  , "narrator": "みやび", "text": "というわけで"},
        { "location": "130/TALK"  , "narrator": "みやび", "text": "相棒の出番や"},
        { "location": "132/SEL"   , "narrator": "", "text": "$me$に何をしろと？"},
        { "location": "133/ACT"   , "narrator": "", "text": "$me$に何をしろと？"},
        { "location": "135/TALK"  , "narrator": "みやび", "text": "オーダー"},
        { "location": "136/TALK"  , "narrator": "みやび", "text": "うさぎの可愛いところを引き出す方法"},
        { "location": "137/TALK"  , "narrator": "みやび", "text": "というわけなのだ"},
        { "location": "138/TALK"  , "narrator": "みやび", "text": "どうにも最近"},
        { "location": "139/TALK"  , "narrator": "みやび", "text": "うさぎはドライな反応が過ぎる"},
        { "location": "140/TALK"  , "narrator": "みやび", "text": "悪くはないが"},
        { "location": "141/TALK"  , "narrator": "みやび", "text": "うちの中のうさぎは"},
        { "location": "142/TALK"  , "narrator": "みやび", "text": "そうじゃなくてな"},
        { "location": "143/TALK"  , "narrator": "みやび", "text": "わかるだろう？"},
        { "location": "145/SEL"   , "narrator": "", "text": "デートスポットへ誘ってみれば？"},
        { "location": "146/SEL"   , "narrator": "", "text": "今の繭も可愛いと思うけど？"},
        { "location": "147/ACT"   , "narrator": "", "text": "デートスポットへ誘ってみれば？"},
        { "location": "149/TALK"  , "narrator": "みやび", "text": "マジか"},
        { "location": "150/TALK"  , "narrator": "みやび", "text": "マジで言ってるのか？"},
        { "location": "151/TALK"  , "narrator": "みやび", "text": "まあ"},
        { "location": "152/TALK"  , "narrator": "みやび", "text": "昨日テレビで特集見たばかりで"},
        { "location": "153/TALK"  , "narrator": "みやび", "text": "ぶっちゃけた話"},
        { "location": "154/TALK"  , "narrator": "みやび", "text": "あてはある"},
        { "location": "158/TALK"  , "narrator": "みやび", "text": "行ってみよう"},
        { "location": "170/TALK"  , "narrator": "みやび", "text": "…よし、うさぎ。\n場所を変えるぞね。"},
        { "location": "171/TALK"  , "narrator": "繭", "text": "次はどこへ？"},
        { "location": "173/TALK"  , "narrator": "みやび", "text": "ゆりかもめに乗って、\nお台場へ行くちや。"},
        { "location": "174/TALK"  , "narrator": "繭", "text": "…お、お台場？\nみやび先輩が！？"},
        { "location": "175/TALK"  , "narrator": "みやび", "text": "うむ、遅くなるき、\n急いで行くぞね！"},
        { "location": "176/TALK"  , "narrator": "繭", "text": "は、はい…。"},
        { "location": "186/TALK"  , "narrator": "繭", "text": "…………。"},
        { "location": "187/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "189/TALK"  , "narrator": "繭", "text": "それで…お台場に来た\n理由はこれですか？"},
        { "location": "190/TALK"  , "narrator": "みやび", "text": "うむ…。"},
        { "location": "191/TALK"  , "narrator": "繭", "text": "何故観覧車なんですか？"},
        { "location": "193/TALK"  , "narrator": "みやび", "text": "デートゆうて誘ったやろ？"},
        { "location": "194/TALK"  , "narrator": "みやび", "text": "やき、まっことのデート\nスポットに来てみただけ\nなんやけんど…。"},
        { "location": "196/TALK"  , "narrator": "みやび", "text": "…ぶっちゃけつまらん。\nこんな巨大なゴンドラ乗って\n何が楽しいが？"},
        { "location": "197/TALK"  , "narrator": "繭", "text": "連れてきたみやび先輩が\n言いますか？"},
        { "location": "198/TALK"  , "narrator": "みやび", "text": "まあ、うるさい人混みから\n一時は確実に解放されるき、\n休憩タイムにはえいやろ。"},
        { "location": "199/TALK"  , "narrator": "みやび", "text": "うさぎも今のうちに\nリラックスしときぃ。"},
        { "location": "201/TALK"  , "narrator": "繭", "text": "この状況でそれは、\nちょっと難しいですね…。"},
        { "location": "202/TALK"  , "narrator": "みやび", "text": "高所恐怖症か？"},
        { "location": "203/TALK"  , "narrator": "繭", "text": "いえ…あ、はい…。\nそういうことにしておいて\nください…。"},
        { "location": "205/TALK"  , "narrator": "みやび", "text": "そうか…じゃ、下は見んで\n景色を眺めるんよ。"},
        { "location": "208/TALK"  , "narrator": "みやび", "text": "ほれ、見てみぃ。\n綺麗やぞ？"},
        { "location": "211/TALK"  , "narrator": "繭", "text": "…………。"},
        { "location": "212/TALK"  , "narrator": "繭", "text": "はい…とても綺麗です…。"},
        { "location": "215/TALK"  , "narrator": "みやび", "text": "はは、二人してらしくない\nことしちゅうなぁ。"},
        { "location": "218/TALK"  , "narrator": "繭", "text": "そうですね…。"},
        { "location": "219/TALK"  , "narrator": "繭", "text": "でも…嫌な気はしません…。"},
        { "location": "220/TALK"  , "narrator": "みやび", "text": "…そうやね。"},
        { "location": "224/TALK"  , "narrator": "みやび", "text": "…うさぎには\n言ったことあったっけか？"},
        { "location": "225/TALK"  , "narrator": "みやび", "text": "うちが本気モードになれる\n時間は、たった三分だけ、\nっちゅうのを…。"},
        { "location": "226/TALK"  , "narrator": "繭", "text": "…どうでしょうか？\nすみません、\n覚えていません。"},
        { "location": "228/TALK"  , "narrator": "繭", "text": "ですが、それが何か？"},
        { "location": "229/TALK"  , "narrator": "みやび", "text": "いや…せっかく、こうして\nゆっくり話せる場所に\nいるんやしね。"},
        { "location": "230/TALK"  , "narrator": "みやび", "text": "ちくっと…本気でうさぎに、\n真面目な話をさせてもらう\nがよ。"},
        { "location": "231/TALK"  , "narrator": "繭", "text": "…………。"},
        { "location": "233/TALK"  , "narrator": "みやび", "text": "改めて、ありがとう。"},
        { "location": "235/TALK"  , "narrator": "繭", "text": "えっ？"},
        { "location": "236/TALK"  , "narrator": "みやび", "text": "うさぎが横須賀まで\n来てくれたの…、\nまっこと嬉しかったちや。"},
        { "location": "237/TALK"  , "narrator": "みやび", "text": "あの時のうちは…いや、\n今もやけんど…、\n結構参っちょるがよ…。"},
        { "location": "238/TALK"  , "narrator": "みやび", "text": "やき…もしあの時、\nうさぎがいなかったら…、\nうちは潰れちょったはずや。"},
        { "location": "239/TALK"  , "narrator": "繭", "text": "そんな！　みやび先輩は\nそんなに弱くは――"},
        { "location": "241/TALK"  , "narrator": "みやび", "text": "弱いんよ…。\nそんな自分を偽っちょる\nだけや。"},
        { "location": "243/TALK"  , "narrator": "みやび", "text": "…見損なったか？"},
        { "location": "244/TALK"  , "narrator": "繭", "text": "…まさか。\nそんなはず、ないじゃ\nありませんか…。"},
        { "location": "245/TALK"  , "narrator": "繭", "text": "みやび先輩こそ、私を\n見損なわないでください。"},
        { "location": "246/TALK"  , "narrator": "みやび", "text": "…うん、そうやね。"},
        { "location": "248/TALK"  , "narrator": "みやび", "text": "タイムリミット近いき、\nすっと言わせてもらう\nけんど。"},
        { "location": "249/TALK"  , "narrator": "みやび", "text": "うさぎは…まっこと、\nうちにとって最高の\nパートナーや…。"},
        { "location": "250/TALK"  , "narrator": "みやび", "text": "心からそう思うてる…。"},
        { "location": "251/TALK"  , "narrator": "繭", "text": "…………。"},
        { "location": "252/TALK"  , "narrator": "繭", "text": "光栄です…。\n私も、本当に心から\nそう思います…。"},
        { "location": "253/TALK"  , "narrator": "繭", "text": "みやび先輩に、\nパートナーとして\n認められるなんて…。"},
        { "location": "255/TALK"  , "narrator": "みやび", "text": "そう思うてくれるが？"},
        { "location": "256/TALK"  , "narrator": "繭", "text": "はい…クイーン。"},
        { "location": "257/TALK"  , "narrator": "みやび", "text": "…よかった。"},
        { "location": "260/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "262/TALK"  , "narrator": "みやび", "text": "ちなみに、Ｆａｔａｌ\nＱｕｅｅｎの時は、\nちくっと違うんよ。"},
        { "location": "263/TALK"  , "narrator": "みやび", "text": "ＦａｔａｌＱｕｅｅｎに\nとってのうさぎは、\n嫁さんみたいなもんや。"},
        { "location": "264/TALK"  , "narrator": "繭", "text": "は…っ！？"},
        { "location": "265/TALK"  , "narrator": "繭", "text": "い、今、あの…えぇっ！？\n嫁ですか？"},
        { "location": "266/TALK"  , "narrator": "みやび", "text": "うむ、うさぎはうちの嫁、\nっちゅう感じや。"},
        { "location": "268/TALK"  , "narrator": "みやび", "text": "まあ、女のうちに嫁とか\n言われても、嬉しくないとは\n思うけんどな。"},
        { "location": "269/TALK"  , "narrator": "繭", "text": "そ、そんな！\nまさか！"},
        { "location": "270/TALK"  , "narrator": "繭", "text": "そっちも光栄です！\n本当…本気で、\nそう思います…。"},
        { "location": "271/TALK"  , "narrator": "みやび", "text": "…よかった。"},
        { "location": "272/TALK"  , "narrator": "繭", "text": "ですが、一つワガママを\n言わせていただきますと、\n逆がいいです。"},
        { "location": "273/TALK"  , "narrator": "みやび", "text": "…逆？"},
        { "location": "274/TALK"  , "narrator": "繭", "text": "はい。嫁役は私より、\nみやび先輩の方が\n的確かと思います。"},
        { "location": "276/TALK"  , "narrator": "繭", "text": "きっと…素敵なお嫁さんに\nなると思いますし…。"},
        { "location": "278/TALK"  , "narrator": "みやび", "text": "はは、そうかぁ？"},
        { "location": "279/TALK"  , "narrator": "みやび", "text": "…ん？　そういえば、\nちくっと前に\nウエディングドレス着たな。"},
        { "location": "281/TALK"  , "narrator": "繭", "text": "えぇっ！？"},
        { "location": "283/TALK"  , "narrator": "みやび", "text": "いや、ブライダルフェア\nっちゅうのに、みんなで\n遊びに行ったんよ。"},
        { "location": "284/TALK"  , "narrator": "みやび", "text": "その時に、なんとなくノリで\nウェディングドレスを\nしちゃくしてな…。"},
        { "location": "285/TALK"  , "narrator": "繭", "text": "み、みやび先輩が…、\nウェディングドレスを！？"},
        { "location": "286/TALK"  , "narrator": "みやび", "text": "…写真、見たい？"},
        { "location": "287/TALK"  , "narrator": "繭", "text": "も、もちろんです。\nウェディングドレス姿って、\nレア過ぎます！"},
        { "location": "289/TALK"  , "narrator": "みやび", "text": "なら、宝探しゲームや。"},
        { "location": "290/TALK"  , "narrator": "みやび", "text": "うちのサーバの\nどこかに、圧縮ファイルで\n置いてあるき。"},
        { "location": "291/TALK"  , "narrator": "みやび", "text": "見たければ、ハッキングして\n自力で手に入れるぞね。"},
        { "location": "293/TALK"  , "narrator": "繭", "text": "…いいでしょう。\n今夜中に、絶対に手に入れて\nみせます。"},
        { "location": "294/TALK"  , "narrator": "みやび", "text": "はは、報告楽しみに\nしてるぞね。"},
        { "location": "295/TALK"  , "narrator": "繭", "text": "はい…。"},
        { "location": "296/TALK"  , "narrator": "繭", "text": "ところで…みやび先輩の\n本気モード…三分間だけ\nでしたね？"},
        { "location": "297/TALK"  , "narrator": "みやび", "text": "そうやけんど、それが？"},
        { "location": "300/TALK"  , "narrator": "繭", "text": "…タイムリミットを\n迎えたのは、話のどの辺り\nですか？"},
        { "location": "301/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "302/TALK"  , "narrator": "みやび", "text": "そろそろ一周するき、\n降りる準備するがよ。"},
        { "location": "319/ACT"   , "narrator": "", "text": "今の繭も可愛いと思うけど？"},
        { "location": "321/TALK"  , "narrator": "みやび", "text": "否定できん"},
        { "location": "322/TALK"  , "narrator": "みやび", "text": "確かに可愛い"},
        { "location": "323/TALK"  , "narrator": "みやび", "text": "なるほど"},
        { "location": "324/TALK"  , "narrator": "みやび", "text": "うさぎはどうなろうと"},
        { "location": "325/TALK"  , "narrator": "みやび", "text": "可愛いままなのか"},
        { "location": "326/TALK"  , "narrator": "みやび", "text": "世紀の大発見レベルの衝撃"},
        { "location": "327/TALK"  , "narrator": "みやび", "text": "↑は大げさ度１００００００００％"},
        { "location": "339/TALK"  , "narrator": "みやび", "text": "…まあ、ドライなうさぎも、\nこれはこれで可愛いき、\nえいもんやね。"},
        { "location": "341/TALK"  , "narrator": "繭", "text": "な、何をバカな…。"},
        { "location": "342/TALK"  , "narrator": "みやび", "text": "いやいや、まっことの\nことぞね。"},
        { "location": "344/TALK"  , "narrator": "みやび", "text": "ちゅうか、うさぎは\nもとがえいきね。"},
        { "location": "345/TALK"  , "narrator": "みやび", "text": "当然と言っちゃそれまで\nなんやけんど…。"},
        { "location": "348/TALK"  , "narrator": "繭", "text": "…そ、それくらいにして\nいただけませんか？"},
        { "location": "349/TALK"  , "narrator": "みやび", "text": "いや、すまん。\nけんどな、まっこと\n嬉しがよ。"},
        { "location": "351/TALK"  , "narrator": "みやび", "text": "ほれ、うさぎがどんな奴か\n知らんかった頃、オッサンと\n思うてた言うたやろ？"},
        { "location": "352/TALK"  , "narrator": "みやび", "text": "もしそうやったら、\n冗談でデートとか言うたり\nできんかったやろうなぁ。"},
        { "location": "355/TALK"  , "narrator": "繭", "text": "…まあ、同性に対して\n言うのもどうかとは\n思いますが。"},
        { "location": "356/TALK"  , "narrator": "みやび", "text": "同好の士で、同年代の女子。\nしかも、見た目もえいと\nきちょる。"},
        { "location": "358/TALK"  , "narrator": "みやび", "text": "まっこと、\nありがたい存在や。\n拝んどくか。"},
        { "location": "359/TALK"  , "narrator": "繭", "text": "…少し、照れくさくは\nありますが…光栄です。"},
        { "location": "360/TALK"  , "narrator": "繭", "text": "みやび先輩にとって、\nありがたいと思えるような\n存在になれたなんて…。"},
        { "location": "361/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "362/TALK"  , "narrator": "繭", "text": "…………？"},
        { "location": "364/TALK"  , "narrator": "みやび", "text": "はぁ…やっぱうさぎ、\n前よかドライになっちょる\nなぁ…。"},
        { "location": "365/TALK"  , "narrator": "繭", "text": "えっ？"},
        { "location": "367/TALK"  , "narrator": "みやび", "text": "ちくっと前やったら、\nもっと照れて慌てちょった\nはずやのに…。"},
        { "location": "368/TALK"  , "narrator": "繭", "text": "なっ！？　まさか！\n今の言葉はそれを狙って\n言ったんですか！？"},
        { "location": "369/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "370/TALK"  , "narrator": "みやび", "text": "さて、どうやろね…。\nほれ、まだ買うものあるき、\n付き合うてくれちや。"},
        { "location": "374/TALK"  , "narrator": "繭", "text": "…見間違い？"},
        { "location": "375/TALK"  , "narrator": "繭", "text": "今、みやび先輩も\n少し赤くなってたような？"},
        { "location": "17/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>9月2日　 0:11 PM</color>\nとある平日の昼休み、付属学園つばめの教室にて"},
        { "location": "313/DIALOG", "narrator": "Dialog_GEThimegoto_ch04", "text": "【三分間の】"}
    ]
}
