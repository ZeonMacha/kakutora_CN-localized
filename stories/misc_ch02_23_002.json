    "entry":
    [
        { "location": "86/SCENARIO", "narrator": "", "text": "インク切れ"},
        { "location": "111/TALK"   , "narrator": "アーヤ", "text": "ボールペンに慣れてると"},
        { "location": "112/TALK"   , "narrator": "アーヤ", "text": "万年筆ってちょっと不便ね"},
        { "location": "114/SEL"    , "narrator": "", "text": "慣れだよ、慣れ"},
        { "location": "115/SEL"    , "narrator": "", "text": "万年筆なんて持ってたの"},
        { "location": "116/SEL"    , "narrator": "", "text": "いいよね万年筆"},
        { "location": "117/ACT"    , "narrator": "", "text": "慣れだよ、慣れ"},
        { "location": "118/TALK"   , "narrator": "アーヤ", "text": "まあ"},
        { "location": "120/TALK"   , "narrator": "アーヤ", "text": "そうなんだけどね"},
        { "location": "121/ACT"    , "narrator": "", "text": "万年筆なんて持ってたの"},
        { "location": "122/TALK"   , "narrator": "アーヤ", "text": "何よ"},
        { "location": "123/TALK"   , "narrator": "アーヤ", "text": "持ってたのよ"},
        { "location": "124/ACT"    , "narrator": "", "text": "いいよね万年筆"},
        { "location": "126/TALK"   , "narrator": "アーヤ", "text": "そうでしょ"},
        { "location": "127/TALK"   , "narrator": "アーヤ", "text": "やっぱりいいわよね"},
        { "location": "128/TALK"   , "narrator": "アーヤ", "text": "万年筆"},
        { "location": "130/TALK"   , "narrator": "アーヤ", "text": "でも万年筆って"},
        { "location": "131/TALK"   , "narrator": "アーヤ", "text": "インク残量がわからないのよね"},
        { "location": "133/TALK"   , "narrator": "アーヤ", "text": "そこだけがね"},
        { "location": "135/SEL"    , "narrator": "", "text": "使うのやめれば"},
        { "location": "136/SEL"    , "narrator": "", "text": "よし、クリア軸を開発しよう"},
        { "location": "137/SEL"    , "narrator": "", "text": "万年筆使ってると知的に見えるよ"},
        { "location": "138/ACT"    , "narrator": "", "text": "使うのやめれば"},
        { "location": "139/TALK"   , "narrator": "アーヤ", "text": "もう"},
        { "location": "140/TALK"   , "narrator": "アーヤ", "text": "わかってないのね"},
        { "location": "141/TALK"   , "narrator": "アーヤ", "text": "仕方ないけど"},
        { "location": "142/ACT"    , "narrator": "", "text": "よし、クリア軸を開発しよう"},
        { "location": "143/TALK"   , "narrator": "アーヤ", "text": "その発想はなかったわ"},
        { "location": "144/TALK"   , "narrator": "アーヤ", "text": "でも"},
        { "location": "145/TALK"   , "narrator": "アーヤ", "text": "万年筆っぽくなくなっちゃうわね"},
        { "location": "146/ACT"    , "narrator": "", "text": "万年筆使ってると知的に見えるよ"},
        { "location": "148/TALK"   , "narrator": "アーヤ", "text": "あ"},
        { "location": "149/TALK"   , "narrator": "アーヤ", "text": "やっぱりそう思う？"},
        { "location": "150/TALK"   , "narrator": "アーヤ", "text": "実はそう思うのよ私も"},
        { "location": "152/TALK"   , "narrator": "アーヤ", "text": "ミーハーとか"},
        { "location": "153/TALK"   , "narrator": "アーヤ", "text": "言わないでよね"}
    ]
}
