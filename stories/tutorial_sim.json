    "entry":
    [
        { "location": "437/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "438/SEL"   , "narrator": "", "text": "…！？"},
        { "location": "439/ACT"   , "narrator": "", "text": "…！？"},
        { "location": "445/TALK"  , "narrator": "千羽鶴", "text": "…っ！？"},
        { "location": "446/TALK"  , "narrator": "千羽鶴", "text": "もしかして……"},
        { "location": "448/TALK"  , "narrator": "千羽鶴", "text": "もしもし？"},
        { "location": "449/SEL"   , "narrator": "", "text": "はい"},
        { "location": "450/ACT"   , "narrator": "", "text": "はい"},
        { "location": "452/TALK"  , "narrator": "千羽鶴", "text": "やっぱり。"},
        { "location": "453/TALK"  , "narrator": "千羽鶴", "text": "私の会話を\n認識できる？"},
        { "location": "454/SEL"   , "narrator": "", "text": "はい"},
        { "location": "455/SEL"   , "narrator": "", "text": "『私の会話を認識出来る？』と言った"},
        { "location": "456/ACT"   , "narrator": "", "text": "はい"},
        { "location": "457/ACT"   , "narrator": "", "text": "『私の会話を認識出来る？』と言った"},
        { "location": "460/TALK"  , "narrator": "千羽鶴", "text": "すごい。\n本当に繋がった。"},
        { "location": "461/TALK"  , "narrator": "千羽鶴", "text": "信じられないかも。"},
        { "location": "462/SEL"   , "narrator": "", "text": "え？どういうこと？"},
        { "location": "463/ACT"   , "narrator": "", "text": "え？どういうこと？"},
        { "location": "466/TALK"  , "narrator": "千羽鶴", "text": "このプログラムを\n起動してくれて\nありがとう。"},
        { "location": "468/TALK"  , "narrator": "千羽鶴", "text": "私は貴方とは違う世界に\nある、このプログラムの\nナビキャラクター[千羽鶴]。"},
        { "location": "469/TALK"  , "narrator": "千羽鶴", "text": "貴方の世界の誰かが、\n私を起動してくれるのを\n待っていた。"},
        { "location": "470/SEL"   , "narrator": "", "text": "てことは、今別世界と繋がってるの？"},
        { "location": "471/ACT"   , "narrator": "", "text": "てことは、今別世界と繋がってるの？"},
        { "location": "473/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "474/TALK"  , "narrator": "千羽鶴", "text": "そして唐突なお願いに\nなってしまうのだけど――"},
        { "location": "475/SEL"   , "narrator": "", "text": "この世界を救って欲しい？"},
        { "location": "476/SEL"   , "narrator": "", "text": "結婚しよう！"},
        { "location": "477/ACT"   , "narrator": "", "text": "この世界を救って欲しい？"},
        { "location": "479/TALK"  , "narrator": "千羽鶴", "text": "惜しいけど違う。"},
        { "location": "480/TALK"  , "narrator": "千羽鶴", "text": "この世界を\n救うために――"},
        { "location": "481/ACT"   , "narrator": "", "text": "結婚しよう！"},
        { "location": "483/TALK"  , "narrator": "千羽鶴", "text": "えっ！"},
        { "location": "484/TALK"  , "narrator": "千羽鶴", "text": "やだ…そんな突然。\n私たち、まだ出逢って\n数ワードなのよ？"},
        { "location": "485/SEL"   , "narrator": "", "text": "冗談です"},
        { "location": "486/SEL"   , "narrator": "", "text": "大事なのは時間じゃない！この気持ちなんだ！"},
        { "location": "487/ACT"   , "narrator": "", "text": "冗談です"},
        { "location": "488/TALK"  , "narrator": "千羽鶴", "text": "…知ってた。"},
        { "location": "489/TALK"  , "narrator": "千羽鶴", "text": "でも、\nちょっと面白かった。"},
        { "location": "490/ACT"   , "narrator": "", "text": "大事なのは時間じゃない！この気持ちなんだ！"},
        { "location": "491/TALK"  , "narrator": "千羽鶴", "text": "なんて情熱的な人なの？\n嬉しい！"},
        { "location": "492/SEL"   , "narrator": "", "text": "千羽鶴！"},
        { "location": "493/ACT"   , "narrator": "", "text": "千羽鶴！"},
        { "location": "495/TALK"  , "narrator": "千羽鶴", "text": "ああっ…\n名無しさんっ！"},
        { "location": "496/SEL"   , "narrator": "", "text": "名無しさん…？"},
        { "location": "497/ACT"   , "narrator": "", "text": "名無しさん…？"},
        { "location": "499/TALK"  , "narrator": "千羽鶴", "text": "ええ。\nだって私、まだあなたの\n名前知らないもの。"},
        { "location": "500/TALK"  , "narrator": "千羽鶴", "text": "それに。\nさっき私のこと何て？"},
        { "location": "501/SEL"   , "narrator": "", "text": "せんばづる…だけど"},
        { "location": "502/ACT"   , "narrator": "", "text": "せんばづる…だけど"},
        { "location": "504/TALK"  , "narrator": "千羽鶴", "text": "誰？　それ。\n私“せんばづる”じゃ\n無いから。"},
        { "location": "505/TALK"  , "narrator": "千羽鶴", "text": "…とまあ、こういう\n事になるから、恋愛は\n相手を知って慎重に。"},
        { "location": "507/TALK"  , "narrator": "千羽鶴", "text": "貴方のせいで、本題から\n逸れてしまった。"},
        { "location": "508/TALK"  , "narrator": "千羽鶴", "text": "私が貴方にしたかった\n唐突なお願いは、実は\n当たらずとも遠からず。"},
        { "location": "509/TALK"  , "narrator": "千羽鶴", "text": "それは、\nこの世界を\n救うために――"},
        { "location": "513/TALK"  , "narrator": "千羽鶴", "text": "<size=30><color=red>ある少女たちと\n結婚して欲しい！</color></size>"},
        { "location": "514/SEL"   , "narrator": "", "text": "えと、お見合いシミュレーションゲーム？"},
        { "location": "515/SEL"   , "narrator": "", "text": "世界を救うために結婚！？！？"},
        { "location": "516/ACT"   , "narrator": "", "text": "えと、お見合いシミュレーションゲーム？"},
        { "location": "517/TALK"  , "narrator": "千羽鶴", "text": "ゲームじゃない。\nこれは現実のお見合い。"},
        { "location": "518/TALK"  , "narrator": "千羽鶴", "text": "住んでる世界が\n違うから、今は現実味が\n無いかもしれないけど――"},
        { "location": "519/TALK"  , "narrator": "千羽鶴", "text": "彼女たちは実在する。\n貴方と同じように。"},
        { "location": "520/ACT"   , "narrator": "", "text": "世界を救うために結婚！？！？"},
        { "location": "521/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "525/TALK"  , "narrator": "千羽鶴", "text": "時は2032年。世界は\n強欲な多国籍企業によって\n牛耳られている。"},
        { "location": "526/TALK"  , "narrator": "千羽鶴", "text": "人々は選択肢の無い選択を\n強いられつつ生かされる、\n新時代の奴隷社会。"},
        { "location": "527/TALK"  , "narrator": "千羽鶴", "text": "そんな中で私は\n日本全体を包むフェノ\nメノンを発症した！"},
        { "location": "528/TALK"  , "narrator": "千羽鶴", "text": "このフェノメノンは\n貴方の世界をモデルに\nした平和な社会。"},
        { "location": "529/TALK"  , "narrator": "千羽鶴", "text": "中では日常的な\n平和な世界が繰り広げ\nられているけど――"},
        { "location": "530/TALK"  , "narrator": "千羽鶴", "text": "常に外的に晒されていて\nタイムリミットもある。"},
        { "location": "531/TALK"  , "narrator": "千羽鶴", "text": "だから、この日本全体を\n包む繭を更に拡大させ、\n全世界を覆うの。"},
        { "location": "532/TALK"  , "narrator": "千羽鶴", "text": "そうすることで\n外敵はいなくなり、\n世界全体は平和に。"},
        { "location": "533/TALK"  , "narrator": "千羽鶴", "text": "でもその為には、\n私一人では不十分。"},
        { "location": "535/TALK"  , "narrator": "千羽鶴", "text": "だから、彼女たち\nトライナリーにも\n発症してもらう必要が。"},
        { "location": "536/TALK"  , "narrator": "千羽鶴", "text": "貴方はその彼女たちの\n支えになって欲しい。"},
        { "location": "537/TALK"  , "narrator": "千羽鶴", "text": "なぜなら、フェノメノンを\n発症すれば、彼女たちは\n身体を失ってしまうから。"},
        { "location": "538/TALK"  , "narrator": "千羽鶴", "text": "こっちの世界の存在では\n彼女たちを支えてあげる\nことは不可能なの。"},
        { "location": "539/TALK"  , "narrator": "千羽鶴", "text": "けど、貴方ならできる。\n肉体を失っても、\n心だけでも対話ができる。"},
        { "location": "540/TALK"  , "narrator": "千羽鶴", "text": "だからその日の為に、\n今日から長い時間かけて\n彼女たちと交流し――"},
        { "location": "541/TALK"  , "narrator": "千羽鶴", "text": "実際に異世界婚をして\nその絆を強くして。"},
        { "location": "542/TALK"  , "narrator": "千羽鶴", "text": "来たるべき彼女たちの\n発症の時にも、彼女たちが\n孤独に苛まれないように！"},
        { "location": "546/TALK"  , "narrator": "千羽鶴", "text": "貴方に協力して欲しい！"},
        { "location": "548/TALK"  , "narrator": "千羽鶴", "text": "……わかる？"},
        { "location": "549/SEL"   , "narrator": "", "text": "無理です"},
        { "location": "550/SEL"   , "narrator": "", "text": "わかります"},
        { "location": "551/ACT"   , "narrator": "", "text": "無理です"},
        { "location": "552/ACT"   , "narrator": "", "text": "わかります"},
        { "location": "553/TALK"  , "narrator": "千羽鶴", "text": "それは\n今だからじゃなくて？"},
        { "location": "555/TALK"  , "narrator": "千羽鶴", "text": "彼女と恋愛できる？"},
        { "location": "556/SEL"   , "narrator": "", "text": "キッツイっすね"},
        { "location": "557/SEL"   , "narrator": "", "text": "このアプリは電波なのでアンインストールします"},
        { "location": "558/SEL"   , "narrator": "", "text": "別の意味で面白そうなのでニラニラしながら進める"},
        { "location": "559/ACT"   , "narrator": "", "text": "キッツイっすね"},
        { "location": "560/TALK"  , "narrator": "千羽鶴", "text": "ですよねー！"},
        { "location": "561/ACT"   , "narrator": "", "text": "このアプリは電波なのでアンインストールします"},
        { "location": "562/TALK"  , "narrator": "千羽鶴", "text": "ですよねー！"},
        { "location": "563/ACT"   , "narrator": "", "text": "別の意味で面白そうなのでニラニラしながら進める"},
        { "location": "564/TALK"  , "narrator": "千羽鶴", "text": "貴重な逸材！！"},
        { "location": "565/TALK"  , "narrator": "千羽鶴", "text": "けど、ごめんなさい。"},
        { "location": "566/TALK"  , "narrator": "千羽鶴", "text": "私が欲しいのは、\nそういう想いでこの世界と\n関わる貴方じゃないの。"},
        { "location": "573/DIALOG", "narrator": "NOTICE", "text": "<color=red>【TRI-OS Error:0x99】</color>\nシミュレーターが\n中断されました。(982)"}
    ]
}
