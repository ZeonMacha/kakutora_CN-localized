    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "あたし自身のあたしのユメ"},
        { "location": "36/TALK"   , "narrator": "ガブリエラ　", "text": "あれ……？"},
        { "location": "37/TALK"   , "narrator": "ガブリエラ　", "text": "あたし何で\nこんなことに…？"},
        { "location": "42/TALK"   , "narrator": "現実世界のガブリエラ", "text": "ちょっと。\nガブリエラ･\nロタルィンスカ。"},
        { "location": "45/TALK"   , "narrator": "ガブリエラ　", "text": "えっ？\nあたし！？！？！"},
        { "location": "46/TALK"   , "narrator": "現実世界のガブリエラ", "text": "驚きすぎよ、あたし。"},
        { "location": "47/TALK"   , "narrator": "ガブリエラ　", "text": "だって何で？\nあたしが\n二人いるのよ？"},
        { "location": "48/TALK"   , "narrator": "現実世界のガブリエラ", "text": "そうね。"},
        { "location": "49/TALK"   , "narrator": "ガブリエラ　", "text": "そっちこそ何で\n驚いてないのよ！？"},
        { "location": "50/TALK"   , "narrator": "現実世界のガブリエラ", "text": "取り乱すと敵に\n付け入る隙を\n与えることになるから。"},
        { "location": "51/TALK"   , "narrator": "ガブリエラ　", "text": "は？　何それ？"},
        { "location": "52/TALK"   , "narrator": "現実世界のガブリエラ", "text": "あたしはフェノメノンに\nなろうとしてた。"},
        { "location": "53/TALK"   , "narrator": "現実世界のガブリエラ", "text": "その途中で色々な\n自分自身の記憶を見た。"},
        { "location": "54/TALK"   , "narrator": "現実世界のガブリエラ", "text": "悪夢みたいな現実を。\n――憶えてないの？"},
        { "location": "55/TALK"   , "narrator": "ガブリエラ　", "text": "……少しは\n憶えてるわよ。"},
        { "location": "56/TALK"   , "narrator": "ガブリエラ　", "text": "それで？\n今の状況って\nどうなってるの？"},
        { "location": "57/TALK"   , "narrator": "つばめ", "text": "分離したの。"},
        { "location": "63/TALK"   , "narrator": "現実世界のガブリエラ", "text": "…聖女…っ！？"},
        { "location": "64/TALK"   , "narrator": "ガブリエラ　", "text": "つ、つばめ！？"},
        { "location": "65/TALK"   , "narrator": "つばめ", "text": "正確には別の人格が\n一度融合して\nまた分離した。"},
        { "location": "66/TALK"   , "narrator": "ガブリエラ　", "text": "別の人格？"},
        { "location": "67/SEL"    , "narrator": "", "text": "現実のガブリエラとフェノメノンのガブリエラってこと"},
        { "location": "68/SEL"    , "narrator": "", "text": "違う世界のガブリエラってこと"},
        { "location": "69/SEL"    , "narrator": "", "text": "どのガブリエラもかわいいよ！！！"},
        { "location": "70/ACT"    , "narrator": "", "text": "現実のガブリエラとフェノメノンのガブリエラってこと"},
        { "location": "71/TALK"   , "narrator": "現実世界のガブリエラ", "text": "そういうことなら\nあたしが現実の\nガブリエラ。"},
        { "location": "73/TALK"   , "narrator": "ガブリエラ　", "text": "…あたしは\nフェノメノンの\nガブリエラね…。"},
        { "location": "74/ACT"    , "narrator": "", "text": "違う世界のガブリエラってこと"},
        { "location": "75/TALK"   , "narrator": "ガブリエラ　", "text": "元々は違う世界に\nいたってことね。"},
        { "location": "76/TALK"   , "narrator": "現実世界のガブリエラ", "text": "そういうことね。\n違う記憶が\nあったんだから。"},
        { "location": "77/ACT"    , "narrator": "", "text": "どのガブリエラもかわいいよ！！！"},
        { "location": "78/TALK"   , "narrator": "ガブリエラ　", "text": "何を言い出すかと\n思えば。"},
        { "location": "79/TALK"   , "narrator": "現実世界のガブリエラ", "text": "これはもう\n撃った方がいいわね。"},
        { "location": "81/TALK"   , "narrator": "現実世界のガブリエラ", "text": "現実のあたしは\nフェノメノンを蒸着\nさせようとしていた。"},
        { "location": "82/TALK"   , "narrator": "現実世界のガブリエラ", "text": "成功とは言えない\n状況だったことまでは\n憶えてるわ。"},
        { "location": "83/TALK"   , "narrator": "現実世界のガブリエラ", "text": "今はどうなってるの？"},
        { "location": "84/TALK"   , "narrator": "ガブリエラ　", "text": "そんなこと\n知らないわよ！"},
        { "location": "85/TALK"   , "narrator": "つばめ", "text": "フェノメノンは\n急速に収束している。"},
        { "location": "86/TALK"   , "narrator": "現実世界のガブリエラ", "text": "えっ？"},
        { "location": "87/TALK"   , "narrator": "ガブリエラ　", "text": "何で！？"},
        { "location": "88/TALK"   , "narrator": "つばめ", "text": "千羽鶴とのリンクが\n切断されたから。"},
        { "location": "89/TALK"   , "narrator": "現実世界のガブリエラ", "text": "ああもう！\n完全に失敗じゃない！"},
        { "location": "90/TALK"   , "narrator": "ガブリエラ　", "text": "フェノメノンは\n消失するの？"},
        { "location": "91/TALK"   , "narrator": "現実世界のガブリエラ", "text": "でしょうね。"},
        { "location": "92/TALK"   , "narrator": "ガブリエラ　", "text": "あたしも一緒に\n消えちゃうの…？"},
        { "location": "93/TALK"   , "narrator": "つばめ", "text": "それは正確ではない。"},
        { "location": "94/TALK"   , "narrator": "つばめ", "text": "ガブリエラは再び\n融合される。"},
        { "location": "95/TALK"   , "narrator": "つばめ", "text": "ただし表層と深層に\n分かれて。"},
        { "location": "96/TALK"   , "narrator": "つばめ", "text": "人格として覚醒している\nガブリエラと\n眠り続けるガブリエラ。"},
        { "location": "97/TALK"   , "narrator": "つばめ", "text": "ひとつの体の中に\n二つの人格を\n持つことになる。"},
        { "location": "98/TALK"   , "narrator": "ガブリエラ　", "text": "二重人格に\nなるってこと！？"},
        { "location": "99/TALK"   , "narrator": "現実世界のガブリエラ", "text": "…でももう一つの\n人格は表面に\n現れないなら。"},
        { "location": "100/TALK"  , "narrator": "現実世界のガブリエラ", "text": "現実問題として\n多重人格とは\n言えないんじゃない？"},
        { "location": "101/TALK"  , "narrator": "ガブリエラ　", "text": "…そうかも\nしれないけど…。"},
        { "location": "102/TALK"  , "narrator": "現実世界のガブリエラ", "text": "けど？"},
        { "location": "103/TALK"  , "narrator": "ガブリエラ　", "text": "ずっと眠っている\nあたしはどうなるの？"},
        { "location": "104/TALK"  , "narrator": "現実世界のガブリエラ", "text": "だから。\n眠ったままなんでしょ？"},
        { "location": "106/TALK"  , "narrator": "ガブリエラ　", "text": "そういうことじゃ\nなくて…！"},
        { "location": "107/TALK"  , "narrator": "つばめ", "text": "どちらを覚醒させ\nどちらを眠らせるかを\n決めるのは。"},
        { "location": "108/TALK"  , "narrator": "つばめ", "text": "ガブリエラ･\nロタルィンスカ\n本人じゃない。"},
        { "location": "109/TALK"  , "narrator": "ガブリエラ　", "text": "何それ！？"},
        { "location": "110/TALK"  , "narrator": "現実世界のガブリエラ", "text": "じゃあ聖女が\nそれを決めるって\nわけ？"},
        { "location": "111/TALK"  , "narrator": "つばめ", "text": "いいえ。"},
        { "location": "112/TALK"  , "narrator": "ガブリエラ　", "text": "じゃあ誰よ？"},
        { "location": "114/TALK"  , "narrator": "つばめ", "text": "決めることが\nできるのは\n$handle$。"},
        { "location": "115/TALK"  , "narrator": "つばめ", "text": "$handle$だけが\nそれをできる。"},
        { "location": "181/TALK"  , "narrator": "マークスマン", "text": "…いよいよ昇華か……。"},
        { "location": "182/TALK"  , "narrator": "リヴォルカ", "text": "遂に来たわね！"},
        { "location": "183/TALK"  , "narrator": "マルザンナ　", "text": "……。"},
        { "location": "184/TALK"  , "narrator": "マークスマン", "text": "ガブリエラに\n素敵なココロの旅を――"},
        { "location": "198/TALK"  , "narrator": "マークスマン", "text": "……ああ。\n久し振りの光。"},
        { "location": "199/TALK"  , "narrator": "リヴォルカ", "text": "マークスマンが\n眼を開いた！？"},
        { "location": "200/TALK"  , "narrator": "マークスマン", "text": "そして私は――"},
        { "location": "201/TALK"  , "narrator": "マークスマン", "text": "……。"},
        { "location": "202/TALK"  , "narrator": "マークスマン", "text": "フェノメノンは\n展開されていないようだ。"},
        { "location": "203/TALK"  , "narrator": "マルザンナ　", "text": "えっ！？"},
        { "location": "204/TALK"  , "narrator": "リヴォルカ", "text": "はあ！？"},
        { "location": "212/TALK"  , "narrator": "リヴォルカ", "text": "おいこら豚！！\n今度は何やった！？"},
        { "location": "213/SEL"   , "narrator": "", "text": "$me$じゃない$me$じゃない！"},
        { "location": "214/ACT"   , "narrator": "", "text": "$me$じゃない$me$じゃない！"},
        { "location": "216/TALK"  , "narrator": "リヴォルカ", "text": "じゃあ誰よ…。"},
        { "location": "217/TALK"  , "narrator": "マルザンナ　", "text": "何か知ってるのかしら？"},
        { "location": "218/SEL"   , "narrator": "", "text": "千羽鶴が撃たれたんだよ"},
        { "location": "219/ACT"   , "narrator": "", "text": "千羽鶴が撃たれたんだよ"},
        { "location": "222/TALK"  , "narrator": "リヴォルカ", "text": "はぁっ！？\nちょ、ちょっとそれって…"},
        { "location": "223/TALK"  , "narrator": "マークスマン", "text": "まずいな。\nそうなれば、日本を包む\n0xの世界は終焉を迎える。"},
        { "location": "224/SEL"   , "narrator": "", "text": "まさに今消滅してる"},
        { "location": "225/ACT"   , "narrator": "", "text": "まさに今消滅してる"},
        { "location": "229/TALK"  , "narrator": "マルザンナ　", "text": "そんな……\nそれじゃ、あたしが今まで\n作って来た思い出は…！？"},
        { "location": "230/TALK"  , "narrator": "マルザンナ　", "text": "なにか方法があるでしょ？\n消えなくて済む方法が！！"},
        { "location": "231/TALK"  , "narrator": "千羽鶴", "text": "ある。"},
        { "location": "238/TALK"  , "narrator": "マルザンナ　", "text": "これって……"},
        { "location": "239/TALK"  , "narrator": "リヴォルカ", "text": "フェノメノンは\n展開されず……ね。"},
        { "location": "240/TALK"  , "narrator": "マークスマン", "text": "……。"},
        { "location": "241/TALK"  , "narrator": "マークスマン", "text": "やはり、\nお前に阻止されて\nしまったようだな。"},
        { "location": "242/SEL"   , "narrator": "", "text": "それより大変なことが"},
        { "location": "243/ACT"   , "narrator": "", "text": "それより大変なことが"},
        { "location": "253/TALK"  , "narrator": "マークスマン", "text": "どうかしたのか。"},
        { "location": "254/SEL"   , "narrator": "", "text": "千羽鶴が殺された"},
        { "location": "255/ACT"   , "narrator": "", "text": "千羽鶴が殺された"},
        { "location": "257/TALK"  , "narrator": "マークスマン", "text": "……！？"},
        { "location": "258/TALK"  , "narrator": "リヴォルカ", "text": "はぁ！？\nあんたそれ、嘘だったら\n承知しないわよ！！"},
        { "location": "264/TALK"  , "narrator": "リヴォルカ", "text": "調べればすぐに\n解ることなんだから……"},
        { "location": "268/TALK"  , "narrator": "リヴォルカ", "text": "……！！"},
        { "location": "271/TALK"  , "narrator": "リヴォルカ", "text": "……うそ。\nホントに…沈黙してる。"},
        { "location": "272/TALK"  , "narrator": "マルザンナ　", "text": "ということは、\nもしかして……"},
        { "location": "274/SEL"   , "narrator": "", "text": "つばめの日本が消えかかってる"},
        { "location": "275/ACT"   , "narrator": "", "text": "つばめの日本が消えかかってる"},
        { "location": "283/TALK"  , "narrator": "マークスマン", "text": "そうだ。"},
        { "location": "286/TALK"  , "narrator": "マルザンナ　", "text": "そんな！\nそれじゃ、あたしたちの\n思い出は……！？"},
        { "location": "287/TALK"  , "narrator": "リヴォルカ", "text": "残念だけど、\nゲームオーバー。"},
        { "location": "288/TALK"  , "narrator": "リヴォルカ", "text": "ほら、この間\nあたしが言ったとおりに\nなったじゃん。"},
        { "location": "289/TALK"  , "narrator": "マークスマン", "text": "リヴォルカ。\n他人事ではないぞ。"},
        { "location": "296/TALK"  , "narrator": "マークスマン", "text": "日本を包むフェノメノンは\nある意味、現時点での\n最大の防御壁。"},
        { "location": "297/TALK"  , "narrator": "マークスマン", "text": "それを更に拡大し、\n奴らを消すのが我々の\n目的だったのだ。"},
        { "location": "298/TALK"  , "narrator": "マークスマン", "text": "だが現状は、逆に\nそれが無くなっている。\nそれが何を意味するか。"},
        { "location": "299/TALK"  , "narrator": "リヴォルカ", "text": "…！！"},
        { "location": "300/SEL"   , "narrator": "", "text": "ガブリエラの命が危ないってこと！？"},
        { "location": "301/ACT"   , "narrator": "", "text": "ガブリエラの命が危ないってこと！？"},
        { "location": "309/TALK"  , "narrator": "リヴォルカ", "text": "ハッキリ言うな豚！！"},
        { "location": "310/TALK"  , "narrator": "マルザンナ　", "text": "で、でも！\nさすがにそんなことは――"},
        { "location": "311/TALK"  , "narrator": "マークスマン", "text": "無いとは思いたいが……。\n議論は最もシビアな\nケースで進めるものだ。"},
        { "location": "312/TALK"  , "narrator": "マルザンナ　", "text": "あたしの……\nあたしの現実が……"},
        { "location": "315/TALK"  , "narrator": "リヴォルカ", "text": "あんたなんて\nまだマシよ！"},
        { "location": "316/TALK"  , "narrator": "リヴォルカ", "text": "あたしなんて、\n生まれてから今まで\n楽しかったことなんて……"},
        { "location": "317/TALK"  , "narrator": "マルザンナ　", "text": "もう本当に\nどうにもならないの！？"},
        { "location": "318/TALK"  , "narrator": "千羽鶴", "text": "なる。"},
        { "location": "355/TALK"  , "narrator": "マルザンナ　", "text": "あんた…！"},
        { "location": "356/TALK"  , "narrator": "マークスマン", "text": "千羽鶴か。"},
        { "location": "357/TALK"  , "narrator": "リヴォルカ", "text": "あら、\n久し振りじゃない。"},
        { "location": "359/SEL"   , "narrator": "", "text": "来たね"},
        { "location": "360/ACT"   , "narrator": "", "text": "来たね"},
        { "location": "364/SEL"   , "narrator": "", "text": "千羽鶴！\nエリカと話したの？"},
        { "location": "365/ACT"   , "narrator": "", "text": "千羽鶴！\nエリカと話したの？"},
        { "location": "368/TALK"  , "narrator": "千羽鶴", "text": "ごきげんよう、\n$handle$。"},
        { "location": "369/TALK"  , "narrator": "千羽鶴", "text": "エリカとは\nちゃんと話をした。\nその結果――"},
        { "location": "370/TALK"  , "narrator": "千羽鶴", "text": "フェノメノンの存続には\n皆から力をもらう必要が\nあるとの判断に至った。"},
        { "location": "372/SEL"   , "narrator": "", "text": "千羽鶴は死んじゃうの！？"},
        { "location": "373/SEL"   , "narrator": "", "text": "力をもらうってどういうこと？"},
        { "location": "374/ACT"   , "narrator": "", "text": "千羽鶴は死んじゃうの！？"},
        { "location": "375/TALK"  , "narrator": "千羽鶴", "text": "……まだ100％消えると\n決まったわけじゃない。"},
        { "location": "376/TALK"  , "narrator": "千羽鶴", "text": "この作戦が上手くいけば\nあるいは――"},
        { "location": "377/ACT"   , "narrator": "", "text": "力をもらうってどういうこと？"},
        { "location": "378/TALK"  , "narrator": "千羽鶴", "text": "今からそのことを話す。"},
        { "location": "381/SEL"   , "narrator": "", "text": "力をもらうってどういうこと？ "},
        { "location": "382/ACT"   , "narrator": "", "text": "力をもらうってどういうこと？ "},
        { "location": "384/TALK"  , "narrator": "千羽鶴", "text": "今からそのことを話す。"},
        { "location": "387/TALK"  , "narrator": "千羽鶴", "text": "あ、それから。"},
        { "location": "389/TALK"  , "narrator": "千羽鶴", "text": "エリカから、\n貴方が私の死を\n凄く心配してると聞いた。"},
        { "location": "391/TALK"  , "narrator": "千羽鶴", "text": "まあ、現状では\nそれに対する答えは\nどちらともいえないけど。"},
        { "location": "392/TALK"  , "narrator": "千羽鶴", "text": "ひとつだけ\n言わなくちゃいけない\nことがある。"},
        { "location": "395/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "396/TALK"  , "narrator": "千羽鶴", "text": "……ありがと。"},
        { "location": "403/TALK"  , "narrator": "千羽鶴", "text": "言わずともわかると\n思うけど、このままだと\n私は消滅する。"},
        { "location": "404/TALK"  , "narrator": "千羽鶴", "text": "そして、当然\n日本を包むフェノメノンも\n消えて、瓦礫と化す。"},
        { "location": "405/TALK"  , "narrator": "千羽鶴", "text": "もはや、全世界を発症に\nよって包み込むなんて事は\n確実に不可能だけど――"},
        { "location": "406/TALK"  , "narrator": "千羽鶴", "text": "現状のフェノメノンを\n維持する方法なら\n１つだけある。"},
        { "location": "407/TALK"  , "narrator": "マークスマン", "text": "どのように？"},
        { "location": "409/TALK"  , "narrator": "千羽鶴", "text": "今の貴方の状態、\nすなわちフェノメノン\n発症状態を維持すること。"},
        { "location": "410/TALK"  , "narrator": "千羽鶴", "text": "貴方と$handle$は\n共に合意の上で\nフェノメノンを発症した。"},
        { "location": "411/TALK"  , "narrator": "千羽鶴", "text": "だから、そのまま\n維持し続けることに\n異論は無いと思うけど――"},
        { "location": "412/TALK"  , "narrator": "千羽鶴", "text": "心に介入することで、\nその理由が変わった以上\n同意を得る必要がある。"},
        { "location": "413/TALK"  , "narrator": "千羽鶴", "text": "だから、\n改めて聞きます。"},
        { "location": "414/TALK"  , "narrator": "千羽鶴", "text": "マークスマン。\n$handle$――。"},
        { "location": "415/TALK"  , "narrator": "千羽鶴", "text": "このまま発症した状態で\n私を受け入れ委ねてもらう\nことは可能か否か。"},
        { "location": "417/TALK"  , "narrator": "千羽鶴", "text": "マークスマン。\n貴方の力を\n使わせてもらうこと。"},
        { "location": "418/TALK"  , "narrator": "リヴォルカ", "text": "それって結局\nあたしもフェノメノンを\n発症するって事かしら？"},
        { "location": "419/TALK"  , "narrator": "千羽鶴", "text": "違う。"},
        { "location": "420/TALK"  , "narrator": "千羽鶴", "text": "ただ単に、\nわたしとココロを\n繋げて欲しいだけ。"},
        { "location": "421/TALK"  , "narrator": "千羽鶴", "text": "1xではなく、\n2xとして。"},
        { "location": "422/TALK"  , "narrator": "マルザンナ　", "text": "なにそれ……。\nもう1xでも\nこりごりなんだけど。"},
        { "location": "423/TALK"  , "narrator": "千羽鶴", "text": "1xは、単にココロ同士を\n連絡線で繋いでいるだけの\n独立した魂同士だけど――"},
        { "location": "424/TALK"  , "narrator": "千羽鶴", "text": "2xは、完全にココロに\nとけ込む状態。\nすなわち“一心”になる。"},
        { "location": "425/TALK"  , "narrator": "千羽鶴", "text": "単純に言えば――"},
        { "location": "426/TALK"  , "narrator": "千羽鶴", "text": "私、厳密には逢瀬つばめが\n貴方と潜在意識下で\nココロを共有する。"},
        { "location": "427/TALK"  , "narrator": "千羽鶴", "text": "もちろん永久ではない。\nフェノメノンが消えれば\n繋がりも消える。"},
        { "location": "428/TALK"  , "narrator": "千羽鶴", "text": "発症と違い、力も不要で\nココロが壊れるような\nリスクもない。"},
        { "location": "429/TALK"  , "narrator": "千羽鶴", "text": "ただ。"},
        { "location": "430/TALK"  , "narrator": "千羽鶴", "text": "当然他人のココロを繋ぐ\nわけだから、当人の\n承諾無しにはできない。"},
        { "location": "431/TALK"  , "narrator": "千羽鶴", "text": "だから、最終判断は\n貴方たちに委ねる。"},
        { "location": "432/TALK"  , "narrator": "マークスマン", "text": "ふむ。\n概ね理解した。"},
        { "location": "436/TALK"  , "narrator": "マークスマン", "text": "しかし、\nなかなか難しい問題だな。\n状況が状況とはいえ――"},
        { "location": "437/TALK"  , "narrator": "マークスマン", "text": "理由が変われば\n様々な可能性を\n検討せねばならない。"},
        { "location": "438/TALK"  , "narrator": "マークスマン", "text": "$handle$よ。\n参考までに\nお前の意見を聞きたい。"},
        { "location": "439/TALK"  , "narrator": "マークスマン", "text": "この千羽鶴の提案、\n是か非か。"},
        { "location": "441/SEL"   , "narrator": "", "text": "$me$なら千羽鶴を受け入れない"},
        { "location": "442/ACT"   , "narrator": "", "text": "$me$なら千羽鶴を受け入れない"},
        { "location": "447/SEL"   , "narrator": "", "text": "$me$なら千羽鶴を受け入れる"},
        { "location": "448/SEL"   , "narrator": "", "text": "$me$なら千羽鶴を受け入れない "},
        { "location": "449/ACT"   , "narrator": "", "text": "$me$なら千羽鶴を受け入れる"},
        { "location": "452/ACT"   , "narrator": "", "text": "$me$なら千羽鶴を受け入れない "},
        { "location": "457/TALK"  , "narrator": "マークスマン", "text": "そうか、わかった。\n進言に感謝する。"},
        { "location": "458/TALK"  , "narrator": "マークスマン", "text": "では……"},
        { "location": "459/TALK"  , "narrator": "マークスマン", "text": "私の答えを伝えよう。"},
        { "location": "493/TALK"  , "narrator": "マークスマン", "text": "私は「是」と考える。"},
        { "location": "497/TALK"  , "narrator": "マークスマン", "text": "私は「非」と考える。"},
        { "location": "499/TALK"  , "narrator": "マークスマン", "text": "様々なメリット\nデメリットや実現度を\n考えてみた。"},
        { "location": "500/TALK"  , "narrator": "マークスマン", "text": "その結果、どちらにも\n大きなリスクが存在する\nという結論に至った。"},
        { "location": "501/TALK"  , "narrator": "マークスマン", "text": "どちらもリスキーであれば\n後は、より“分のいい”\n方を選ぶのみ。"},
        { "location": "502/TALK"  , "narrator": "マークスマン", "text": "$handle$。\nお前は私をいつも\n大切にしてくれている。"},
        { "location": "503/TALK"  , "narrator": "マークスマン", "text": "そして、それは\nこれからも続くと\n信じたい。"},
        { "location": "504/TALK"  , "narrator": "マークスマン", "text": "だから、お前と一蓮托生。\n身も心も共にすることを\n選ぶことにした。"},
        { "location": "509/TALK"  , "narrator": "マークスマン", "text": "私は「非」と考える。"},
        { "location": "513/TALK"  , "narrator": "マークスマン", "text": "私は「是」と考える。"},
        { "location": "515/TALK"  , "narrator": "マークスマン", "text": "様々なメリット\nデメリットや実現度を\n考えてみた。"},
        { "location": "516/TALK"  , "narrator": "マークスマン", "text": "その結果、どちらにも\n大きなリスクが存在する\nという結論に至った。"},
        { "location": "517/TALK"  , "narrator": "マークスマン", "text": "どちらもリスキーであれば\n後は、より己が納得する\n決断をするしかない。"},
        { "location": "518/TALK"  , "narrator": "マークスマン", "text": "$handle$。"},
        { "location": "519/TALK"  , "narrator": "マークスマン", "text": "お前が私に対して\n尽力してくれていることは\nわかっている。"},
        { "location": "520/TALK"  , "narrator": "マークスマン", "text": "だが、私からみれば、\nどうしても手放しで\n信頼できない所がある。"},
        { "location": "521/SEL"   , "narrator": "", "text": "ですよねー"},
        { "location": "522/SEL"   , "narrator": "", "text": "え、なんで！？"},
        { "location": "523/ACT"   , "narrator": "", "text": "ですよねー"},
        { "location": "524/ACT"   , "narrator": "", "text": "え、なんで！？"},
        { "location": "525/TALK"  , "narrator": "マークスマン", "text": "思い当たる節はないか？"},
        { "location": "526/TALK"  , "narrator": "マークスマン", "text": "私や、私の人格に、\n心にも無い事を言ったり、\n侮辱したことはないか？"},
        { "location": "527/TALK"  , "narrator": "マークスマン", "text": "いい加減な対応をしたり、\n隠れて覗き見したような\nことはないか？"},
        { "location": "528/TALK"  , "narrator": "マークスマン", "text": "もちろん、私はお前には\n好感を抱いているよ。\n現実の私と同じで。"},
        { "location": "529/TALK"  , "narrator": "マークスマン", "text": "ただ――"},
        { "location": "530/TALK"  , "narrator": "マークスマン", "text": "命に関わる問題となれば\nそこは切り離し、シビアに\n考えねばならない。"},
        { "location": "532/TALK"  , "narrator": "マークスマン", "text": "だから私は、\n自分の後悔しない回答を\nする事にしたのだ。"},
        { "location": "536/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "537/TALK"  , "narrator": "千羽鶴", "text": "貴方たちの選択のお陰で\nこの世界は継続するかも\nしれない。"},
        { "location": "538/TALK"  , "narrator": "千羽鶴", "text": "ただ、問題はここから。"},
        { "location": "539/TALK"  , "narrator": "千羽鶴", "text": "まず、ガブリエラは\nこれから私を受け入れる\nため、戦う必要がある。"},
        { "location": "540/TALK"  , "narrator": "千羽鶴", "text": "それは、私を承認する為に\n必要不可欠なこと。"},
        { "location": "542/TALK"  , "narrator": "千羽鶴", "text": "そして、\n$handle$――"},
        { "location": "544/TALK"  , "narrator": "千羽鶴", "text": "貴方の意志としては私を\n受け入れなかったけど、\n最終結論は総意による。"},
        { "location": "546/TALK"  , "narrator": "千羽鶴", "text": "貴方の意志としては私を\n受け入れてくれたけど、\n最終結論は総意による。"},
        { "location": "550/SEL"   , "narrator": "", "text": "総意が関係するからでしょ？"},
        { "location": "551/SEL"   , "narrator": "", "text": "総意？"},
        { "location": "552/ACT"   , "narrator": "", "text": "総意が関係するからでしょ？"},
        { "location": "554/ACT"   , "narrator": "", "text": "総意？"},
        { "location": "559/SEL"   , "narrator": "", "text": "総意？ "},
        { "location": "560/ACT"   , "narrator": "", "text": "総意？ "},
        { "location": "565/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "568/TALK"  , "narrator": "千羽鶴", "text": "そう。総意。"},
        { "location": "569/TALK"  , "narrator": "千羽鶴", "text": "この問題は、私個人の\n感情や記憶にかかわる\nものではない。"},
        { "location": "570/TALK"  , "narrator": "千羽鶴", "text": "このフェノメノン\n全体という、\n世界としての判断になる。"},
        { "location": "571/TALK"  , "narrator": "千羽鶴", "text": "わかりやすく言えば、\n今の日本は、貴方たちの\n総意が作り出してる。"},
        { "location": "573/TALK"  , "narrator": "千羽鶴", "text": "貴方一人が私を否定しても\n他の協力者が肯定したら、\n継続されることになる。"},
        { "location": "574/TALK"  , "narrator": "千羽鶴", "text": "だから、今の段階では\n100％希望に添えるかは\nわからないということ。"},
        { "location": "576/TALK"  , "narrator": "千羽鶴", "text": "貴方一人が継続を願っても\n他の協力者が否定したら、\nそれは継続不可能になる。"},
        { "location": "577/TALK"  , "narrator": "千羽鶴", "text": "だから、今の段階では\n100％希望に添えるかは\nわからないということ。"},
        { "location": "578/TALK"  , "narrator": "千羽鶴", "text": "それまで貴方は、\n今の想いを変えずに\nいてもらいたい。"},
        { "location": "583/TALK"  , "narrator": "千羽鶴", "text": "それじゃ、準備はいい？"},
        { "location": "585/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "586/TALK"  , "narrator": "千羽鶴", "text": "心と心の問題だから、\n素直な気持ちに忠実な\n選択をするしかない。"},
        { "location": "587/TALK"  , "narrator": "千羽鶴", "text": "ただ、その場合、\n私は貴方を無力化\nしなければならない。"},
        { "location": "588/TALK"  , "narrator": "千羽鶴", "text": "なぜなら、私にとって\nこのフェノメノンは、\nまだ必要なものだから。"},
        { "location": "589/TALK"  , "narrator": "千羽鶴", "text": "私はまだ全然\n諦めていない。"},
        { "location": "590/TALK"  , "narrator": "千羽鶴", "text": "この世界から“彼ら”を\n排除し、理想的社会を\n構築することを。"},
        { "location": "591/TALK"  , "narrator": "千羽鶴", "text": "その最後の牙城である\nこのフェノメノンの維持は\n必要不可欠なの。"},
        { "location": "592/TALK"  , "narrator": "千羽鶴", "text": "だから、貴方には\n恨みがあるわけではない。\nけど――"},
        { "location": "593/TALK"  , "narrator": "千羽鶴", "text": "私には護らねばならない\nものがある。\nだから、戦う。"},
        { "location": "594/TALK"  , "narrator": "マークスマン", "text": "……。"},
        { "location": "595/TALK"  , "narrator": "マークスマン", "text": "もちろんわかっているよ、\n千羽鶴。"},
        { "location": "596/TALK"  , "narrator": "マークスマン", "text": "私も同じだからね。"},
        { "location": "597/TALK"  , "narrator": "マークスマン", "text": "善悪でも因縁でもない。\n己を護る為の戦いを\nするのは必然だ。"},
        { "location": "598/TALK"  , "narrator": "千羽鶴", "text": "…そうね。"},
        { "location": "600/TALK"  , "narrator": "マークスマン", "text": "$handle$。"},
        { "location": "602/TALK"  , "narrator": "マークスマン", "text": "色々と世話になった。"},
        { "location": "603/SEL"   , "narrator": "", "text": "こちらこそ"},
        { "location": "604/SEL"   , "narrator": "", "text": "至らなくてごめん"},
        { "location": "605/ACT"   , "narrator": "", "text": "こちらこそ"},
        { "location": "607/ACT"   , "narrator": "", "text": "至らなくてごめん"},
        { "location": "608/TALK"  , "narrator": "マークスマン", "text": "自分に自信を持て。"},
        { "location": "609/TALK"  , "narrator": "マークスマン", "text": "そうしなければ、\n護りたい者も\n護れないぞ。"},
        { "location": "611/TALK"  , "narrator": "マークスマン", "text": "私は…いや、\nガブリエラ・\nロタルィンスカは――"},
        { "location": "612/TALK"  , "narrator": "マークスマン", "text": "今まで、全ての存在に対し\n銃口を向けて生きてきた。\n親族もまた例外無しにだ。"},
        { "location": "613/TALK"  , "narrator": "マークスマン", "text": "お前はそのココロを、\n解かしてくれたのだ。"},
        { "location": "614/TALK"  , "narrator": "マークスマン", "text": "もちろんそれは、\nまだフェノメノンの\n中だけかもしれん。"},
        { "location": "615/TALK"  , "narrator": "マークスマン", "text": "だが、私が\nこう思っているように――"},
        { "location": "616/TALK"  , "narrator": "マークスマン", "text": "潜在意識を通じて、\n全ての私もまた、無意識に\nそれを感じ取っている。"},
        { "location": "617/TALK"  , "narrator": "マークスマン", "text": "その事だけは、\n忘れないでいて欲しい。"},
        { "location": "619/TALK"  , "narrator": "千羽鶴", "text": "そろそろいい？"},
        { "location": "620/TALK"  , "narrator": "マークスマン", "text": "勿論、いつでもな。"},
        { "location": "621/TALK"  , "narrator": "千羽鶴", "text": "それじゃ、\nよろしくお願いします。"},
        { "location": "622/TALK"  , "narrator": "千羽鶴", "text": "ガブリエラと\nこのフェノメノンの未来に\n素敵なココロの旅を。"},
