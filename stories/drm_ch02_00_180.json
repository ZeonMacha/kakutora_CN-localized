        { "location": "360/SCENARIO", "narrator": "", "text": "130_いつものこと"},
        { "location": "385/TALK"    , "narrator": "アーヤ", "text": "こんばんは"},
        { "location": "386/TALK"    , "narrator": "アーヤ", "text": "時間あるかな"},
        { "location": "388/SEL"     , "narrator": "", "text": "あるよ"},
        { "location": "389/SEL"     , "narrator": "", "text": "ないよ"},
        { "location": "390/SEL"     , "narrator": "", "text": "アーヤのためならいつでも空けるよ"},
        { "location": "391/ACT"     , "narrator": "", "text": "あるよ"},
        { "location": "392/TALK"    , "narrator": "アーヤ", "text": "なら"},
        { "location": "393/TALK"    , "narrator": "アーヤ", "text": "よかった"},
        { "location": "394/ACT"     , "narrator": "", "text": "ないよ"},
        { "location": "395/TALK"    , "narrator": "アーヤ", "text": "そっか"},
        { "location": "396/TALK"    , "narrator": "アーヤ", "text": "じゃあまたね"},
        { "location": "406/ACT"     , "narrator": "", "text": "アーヤのためならいつでも空けるよ"},
        { "location": "416/TALK"    , "narrator": "アーヤ", "text": "本当？"},
        { "location": "418/TALK"    , "narrator": "アーヤ", "text": "ありがとう"},
        { "location": "420/TALK"    , "narrator": "アーヤ", "text": "ちょっとね"},
        { "location": "421/TALK"    , "narrator": "アーヤ", "text": "時間★いの"},
        { "location": "423/SEL"     , "narrator": "", "text": "いつものアーヤで安心した"},
        { "location": "424/ACT"     , "narrator": "", "text": "いつものアーヤで安心した"},
        { "location": "427/TALK"    , "narrator": "アーヤ", "text": "やだ"},
        { "location": "428/TALK"    , "narrator": "アーヤ", "text": "時間が欲しい"},
        { "location": "429/TALK"    , "narrator": "アーヤ", "text": "だから"},
        { "location": "430/TALK"    , "narrator": "アーヤ", "text": "知っててひどい(；´Д｀)"},
        { "location": "435/TALK"    , "narrator": "アーヤ", "text": "ところで"},
        { "location": "436/TALK"    , "narrator": "アーヤ", "text": "今まではどう思ってたのかな、私の事"},
        { "location": "437/TALK"    , "narrator": "アーヤ", "text": "ちょっと聞いておきたいの"},
        { "location": "439/SEL"     , "narrator": "", "text": "どうって？"},
        { "location": "440/ACT"     , "narrator": "", "text": "どうって？"},
        { "location": "442/TALK"    , "narrator": "アーヤ", "text": "わがままばっかり言ってるとか"},
        { "location": "443/TALK"    , "narrator": "アーヤ", "text": "愚痴ばっかり言ってるとか"},
        { "location": "444/TALK"    , "narrator": "アーヤ", "text": "そんなことお持てたよねきっと"},
        { "location": "445/TALK"    , "narrator": "アーヤ", "text": "思ってたよね"},
        { "location": "448/SEL"     , "narrator": "", "text": "可愛いって思ってた"},
        { "location": "449/SEL"     , "narrator": "", "text": "ちゃんとしてるなって思ってた"},
        { "location": "450/SEL"     , "narrator": "", "text": "まあねｗ"},
        { "location": "451/ACT"     , "narrator": "", "text": "可愛いって思ってた"},
        { "location": "461/TALK"    , "narrator": "アーヤ", "text": "Ｂｏｔの時は流してたけど"},
        { "location": "463/TALK"    , "narrator": "アーヤ", "text": "改めて言われると"},
        { "location": "464/TALK"    , "narrator": "アーヤ", "text": "照れるかも、、、"},
        { "location": "465/ACT"     , "narrator": "", "text": "ちゃんとしてるなって思ってた"},
        { "location": "468/TALK"    , "narrator": "アーヤ", "text": "、、、からかってない？"},
        { "location": "470/TALK"    , "narrator": "アーヤ", "text": "Ｂｏｔの時は流してたけど"},
        { "location": "471/TALK"    , "narrator": "アーヤ", "text": "照れるかも、、、"},
        { "location": "472/ACT"     , "narrator": "", "text": "まあねｗ"},
        { "location": "473/TALK"    , "narrator": "アーヤ", "text": "あ～"},
        { "location": "474/TALK"    , "narrator": "アーヤ", "text": "そうよね、、、、"},
        { "location": "476/TALK"    , "narrator": "アーヤ", "text": "なんだかすごく変な感じだけど、私としてはこれまで通りにしたいと思ってるの"},
        { "location": "478/SEL"     , "narrator": "", "text": "いやだよ"},
        { "location": "479/SEL"     , "narrator": "", "text": "いいよ"},
        { "location": "480/ACT"     , "narrator": "", "text": "いやだよ"},
        { "location": "481/ACT"     , "narrator": "", "text": "いいよ"},
        { "location": "484/TALK"    , "narrator": "アーヤ", "text": "、、、、、"},
        { "location": "486/TALK"    , "narrator": "アーヤ", "text": "それって、結局どうすればいいのかな＼(◎o◎)／"},
        { "location": "488/SEL"     , "narrator": "", "text": "こうやって話せばいいと思う"},
        { "location": "489/ACT"     , "narrator": "", "text": "こうやって話せばいいと思う"},
        { "location": "491/TALK"    , "narrator": "アーヤ", "text": "解決＼(^o^)／"},
        { "location": "492/TALK"    , "narrator": "アーヤ", "text": "、、、、、"},
        { "location": "495/TALK"    , "narrator": "アーヤ", "text": "？？？？？"},
        { "location": "497/TALK"    , "narrator": "アーヤ", "text": "解決したの？"},
        { "location": "499/SEL"     , "narrator": "", "text": "うん、解決"},
        { "location": "500/ACT"     , "narrator": "", "text": "うん、解決"},
