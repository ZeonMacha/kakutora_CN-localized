{
    "dir": "chap15/daydra/dd_ch02_15_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "15205",
        "cid": "ayami",
        "title": "005 メインストーリー",
        "sub_title": "ここは横須賀＜後編＞"
    },
    "entry":
    [
        { "location": "431/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "433/TALK"  , "narrator": "雛", "text": "綾水様、\nどうかしましたか？"},
        { "location": "435/TALK"  , "narrator": "アーヤ", "text": "…あ、ごめんなさい。\nぼーっとしちゃってたわ。"},
        { "location": "436/TALK"  , "narrator": "アーヤ", "text": "そろそろお昼時だし、\nどこかでランチでもどう？"},
        { "location": "437/TALK"  , "narrator": "アーヤ", "text": "電車旅の楽しさを\n教えてくれたお礼に、\n何でも奢るわ。"},
        { "location": "439/TALK"  , "narrator": "雛", "text": "いいんですか！？\nやったー！！"},
        { "location": "441/TALK"  , "narrator": "アーヤ", "text": "ふふっ…何がいいか、\nゆっくり考えて。"},
        { "location": "454/TALK"  , "narrator": "アーヤ", "text": "帰るのやめたわ(￣∇￣)"},
        { "location": "455/TALK"  , "narrator": "アーヤ", "text": "ランチ行ってくる(^^"},
        { "location": "457/SEL"   , "narrator": "", "text": "どんな心境の変化？"},
        { "location": "458/ACT"   , "narrator": "", "text": "どんな心境の変化？"},
        { "location": "460/TALK"  , "narrator": "アーヤ", "text": "やっぱり"},
        { "location": "461/TALK"  , "narrator": "アーヤ", "text": "このまま帰るなんて"},
        { "location": "462/TALK"  , "narrator": "アーヤ", "text": "ちょっと素っ気ないし(￣Д￣ )"},
        { "location": "463/TALK"  , "narrator": "アーヤ", "text": "それに"},
        { "location": "464/TALK"  , "narrator": "アーヤ", "text": "ランチ食べながらなら"},
        { "location": "465/TALK"  , "narrator": "アーヤ", "text": "何かしら"},
        { "location": "466/TALK"  , "narrator": "アーヤ", "text": "話題も見つかると思うの(*^.^*)"},
        { "location": "469/TALK"  , "narrator": "アーヤ", "text": "あと"},
        { "location": "470/TALK"  , "narrator": "アーヤ", "text": "日向さん"},
        { "location": "471/TALK"  , "narrator": "アーヤ", "text": "私に憧れてるって"},
        { "location": "472/TALK"  , "narrator": "アーヤ", "text": "言ってたから(｡-_-｡)"},
        { "location": "473/TALK"  , "narrator": "アーヤ", "text": "なら"},
        { "location": "474/TALK"  , "narrator": "アーヤ", "text": "喜んでくれるかなって(・・。)ゞ"},
        { "location": "478/TALK"  , "narrator": "アーヤ", "text": "私なら"},
        { "location": "479/TALK"  , "narrator": "アーヤ", "text": "憧れてる人と話せるの"},
        { "location": "480/TALK"  , "narrator": "アーヤ", "text": "嬉しいと思うから(^^"},
        { "location": "483/TALK"  , "narrator": "アーヤ", "text": "ちょっと自意識過剰？(-ω-;)"},
        { "location": "486/SEL"   , "narrator": "", "text": "今の雛は喜んでるよ"},
        { "location": "487/ACT"   , "narrator": "", "text": "今の雛は喜んでるよ"},
        { "location": "489/TALK"  , "narrator": "アーヤ", "text": "そうね"},
        { "location": "490/TALK"  , "narrator": "アーヤ", "text": "よかった(^^"},
        { "location": "502/TALK"  , "narrator": "アーヤ", "text": "…何食べたいか\n決まった？"},
        { "location": "504/TALK"  , "narrator": "雛", "text": "はい！　横須賀の\nグルメといったら、\nアレだと思います！"},
        { "location": "524/TALK"  , "narrator": "アーヤ", "text": "ご馳走様でした。"},
        { "location": "525/TALK"  , "narrator": "雛", "text": "綾水様、お味の方は\nいかがでしたか？"},
        { "location": "526/TALK"  , "narrator": "アーヤ", "text": "とっても\n美味しかったわ。"},
        { "location": "527/TALK"  , "narrator": "アーヤ", "text": "横浜海軍カレーって、\nレトルトのは食べた\nことあったけどね。"},
        { "location": "528/TALK"  , "narrator": "アーヤ", "text": "でも、\nやっぱり本場の味は、\nそれ以上に美味しい。"},
        { "location": "529/TALK"  , "narrator": "雛", "text": "よかったー。\n綾水様に気にいって\nいただけて…。"},
        { "location": "530/TALK"  , "narrator": "雛", "text": "カレーが嫌いだったら\nどうしよう…って、\n少し不安だったんですよ。"},
        { "location": "531/TALK"  , "narrator": "アーヤ", "text": "カレーは大好きよ。\n自分でも時々作るし。"},
        { "location": "532/TALK"  , "narrator": "雛", "text": "綾水様カレーかぁ。\nそれも食べてみたいかも。"},
        { "location": "534/TALK"  , "narrator": "アーヤ", "text": "ふふっ…。"},
        { "location": "535/TALK"  , "narrator": "アーヤ", "text": "…日向さん、\n楽しんでくれてるみたい。"},
        { "location": "536/TALK"  , "narrator": "アーヤ", "text": "やっぱり、あのまま\n帰らないでよかった。"},
        { "location": "537/TALK"  , "narrator": "雛", "text": "…そういえば――"},
        { "location": "538/TALK"  , "narrator": "雛", "text": "綾水様って、お鍋料理が\n得意なんですよね？"},
        { "location": "539/TALK"  , "narrator": "アーヤ", "text": "ええ…あら？\nでも日向さんに\n言ったかしら？"},
        { "location": "540/TALK"  , "narrator": "雛", "text": "いえ、つばめちゃんに\n聞いたんです。"},
        { "location": "541/TALK"  , "narrator": "雛", "text": "前に、綾水様が作って\nくれたことがあって、\n凄く美味しかったって。"},
        { "location": "542/TALK"  , "narrator": "アーヤ", "text": "ああ、\nそういうことね。"},
        { "location": "543/TALK"  , "narrator": "雛", "text": "はい。"},
        { "location": "544/TALK"  , "narrator": "雛", "text": "つばめちゃんから、\n綾水様の話は色々\n聞きますからねー。"},
        { "location": "545/TALK"  , "narrator": "雛", "text": "いつも気遣ってくれるし、\nすごく頼りになる\n素敵な先輩だ、って。"},
        { "location": "546/TALK"  , "narrator": "アーヤ", "text": "それ、本当なの？"},
        { "location": "547/TALK"  , "narrator": "雛", "text": "本当ですよ。"},
        { "location": "548/TALK"  , "narrator": "雛", "text": "綾水様みたいになりたい\nって、いつも嬉しそうに\n話してます。"},
        { "location": "550/TALK"  , "narrator": "アーヤ", "text": "そ、そう…。\nつばめがそんな\nことを…。"},
        { "location": "551/TALK"  , "narrator": "アーヤ", "text": "嬉しいんだけど…、\n知らないところで\n褒められるのって――"},
        { "location": "552/TALK"  , "narrator": "アーヤ", "text": "ちょっと照れるかも。"},
        { "location": "553/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "554/TALK"  , "narrator": "アーヤ", "text": "そ、そうだ！\n私からも聞きたいこと\nあったんだけど――"},
        { "location": "556/TALK"  , "narrator": "アーヤ", "text": "劇場のバイトはどう？\n学業に影響とか\n出てない？"},
        { "location": "557/TALK"  , "narrator": "雛", "text": "ご心配なく。\n成績の方は\n問題ありません！"},
        { "location": "558/TALK"  , "narrator": "雛", "text": "専攻してる授業が、\n元々あたしの趣味の\n延長なので――"},
        { "location": "559/TALK"  , "narrator": "雛", "text": "勉強しなくても\nそこそこいい点数は\n取れるくらいなんで。"},
        { "location": "560/TALK"  , "narrator": "アーヤ", "text": "ふーん…そういえば、\n日向さんの専攻って？"},
        { "location": "561/TALK"  , "narrator": "雛", "text": "システム系ですよー。"},
        { "location": "562/TALK"  , "narrator": "アーヤ", "text": "そうだったの？\nちょっと意外かも…。"},
        { "location": "563/TALK"  , "narrator": "雛", "text": "昔っから、機械工学が\n大好きで、そのまま\nここまで来ちゃいました。"},
        { "location": "564/TALK"  , "narrator": "アーヤ", "text": "好きなことをとことん\n極める、っていうのは\nいいことよ。"},
        { "location": "565/TALK"  , "narrator": "アーヤ", "text": "それにシステム系って\n私にはまったくわから\nない分野だから――"},
        { "location": "566/TALK"  , "narrator": "アーヤ", "text": "それが得意なんて、\nちょっと尊敬するわ。"},
        { "location": "568/TALK"  , "narrator": "雛", "text": "そ、そんな、\n尊敬だなんて…。"},
        { "location": "569/TALK"  , "narrator": "アーヤ", "text": "だって、本当に私には\nさっぱりだもの。"},
        { "location": "570/TALK"  , "narrator": "アーヤ", "text": "だから劇場にある\nシステムなんて、一度も\n触ったことないし。"},
        { "location": "572/TALK"  , "narrator": "雛", "text": "トライナリー関係の\nシステムですかぁ…。"},
        { "location": "573/TALK"  , "narrator": "雛", "text": "チラッと見たことが\nありますけど――"},
        { "location": "574/TALK"  , "narrator": "雛", "text": "ビックリするくらい\n最先端のマシンを\n使ってますよね？"},
        { "location": "575/TALK"  , "narrator": "アーヤ", "text": "そう、なのかしら？\n私もその辺りのことは\n詳しくなくて…。"},
        { "location": "576/TALK"  , "narrator": "雛", "text": "いや、凄いんですよ！\nＳＦ映画かよ、って\nくらいの設備ですし。"},
        { "location": "577/TALK"  , "narrator": "アーヤ", "text": "そこまで凄いもの\nだったんだ？"},
        { "location": "578/TALK"  , "narrator": "雛", "text": "そうですよー。"},
        { "location": "579/TALK"  , "narrator": "雛", "text": "やっぱりバックに\n政府がついていると、\n違いますよねー。"},
        { "location": "580/TALK"  , "narrator": "雛", "text": "…まあ、その割に\n宝の持ち腐れ感も\nありますけど。"},
        { "location": "581/TALK"  , "narrator": "アーヤ", "text": "というと？"},
        { "location": "582/TALK"  , "narrator": "雛", "text": "ハイテクな設備に\n追いついてない面が\n多々あるんですよ。"},
        { "location": "583/TALK"  , "narrator": "雛", "text": "例えばフェノメノン\nアラートが鳴った際の\n召集の仕方とか――"},
        { "location": "584/TALK"  , "narrator": "雛", "text": "ぶっちゃけ、\n超アナログじゃない\nですか？"},
        { "location": "586/TALK"  , "narrator": "アーヤ", "text": "そうかしら？\n私は気にしたこと\nないけど…。"},
        { "location": "587/TALK"  , "narrator": "雛", "text": "つばめちゃんから、\n聞いた話によると――"},
        { "location": "588/TALK"  , "narrator": "雛", "text": "アラートが鳴ると、\nまずスマホに連絡が\n来るんですよね？"},
        { "location": "589/TALK"  , "narrator": "雛", "text": "それを確認した後、\n各自が劇場か現場に\n向かうなんて――"},
        { "location": "590/TALK"  , "narrator": "雛", "text": "面倒過ぎますよ。\nっていうか、\n時間掛かり過ぎです。"},
        { "location": "591/TALK"  , "narrator": "雛", "text": "それに、電車にでも\n乗ってたりしたら\n大変ですよね？"},
        { "location": "592/TALK"  , "narrator": "雛", "text": "下手すると停車して、\n車内に閉じ込められる\n可能性もありますし。"},
        { "location": "593/TALK"  , "narrator": "アーヤ", "text": "…それ、わかるわ。\nちょっと前に\n経験したし…。"},
        { "location": "594/TALK"  , "narrator": "雛", "text": "ほら、やっぱり。"},
        { "location": "595/TALK"  , "narrator": "雛", "text": "隊員だけじゃなく、交通\n機関にまで同時にアラート\n出すのが変なんです。"},
        { "location": "596/TALK"  , "narrator": "雛", "text": "現場に向かう隊員の\n妨げになってますし。"},
        { "location": "597/TALK"  , "narrator": "アーヤ", "text": "でも、交通機関にも\nアラートを出さない\nわけにはいかないわ。"},
        { "location": "598/TALK"  , "narrator": "雛", "text": "それは当然です。"},
        { "location": "599/TALK"  , "narrator": "雛", "text": "でも、\nただ出してるだけじゃ\n意味がないんですよ。"},
        { "location": "600/TALK"  , "narrator": "雛", "text": "例えばですけど、\nスマホにはＧＰＳが\n付いてますよね？"},
        { "location": "601/TALK"  , "narrator": "雛", "text": "それで隊員の現在地を\n管理庁側が把握して\nおけば――"},
        { "location": "602/TALK"  , "narrator": "雛", "text": "有事の際も速やかに\n現場までの誘導が\n可能になります。"},
        { "location": "603/TALK"  , "narrator": "アーヤ", "text": "えっ……"},
        { "location": "605/TALK"  , "narrator": "アーヤ", "text": "なんかプライベートまで\n監視されそうでちょっと\n怖いけど……"},
        { "location": "606/TALK"  , "narrator": "雛", "text": "大丈夫ですよ。普段は\n物理的にオフにして\nおけばいいんですから。"},
        { "location": "607/TALK"  , "narrator": "雛", "text": "綾水様の恥ずかしい所を\n無駄に見られないように\nガッチリガードですよ！"},
        { "location": "608/TALK"  , "narrator": "アーヤ", "text": "そ、そうね……。"},
        { "location": "609/TALK"  , "narrator": "アーヤ", "text": "まあ確かに、管理庁側が\nこちらの場所を把握でき\nれば、何かと便利よね。"},
        { "location": "610/TALK"  , "narrator": "アーヤ", "text": "迎えの車だって\nすぐに寄越して\nもらえるはずだし。"},
        { "location": "611/TALK"  , "narrator": "雛", "text": "そうです。"},
        { "location": "612/TALK"  , "narrator": "雛", "text": "なのに、その程度の\nシステムが未だに構築\nされてないなんて。"},
        { "location": "613/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "614/TALK"  , "narrator": "アーヤ", "text": "今言ってた話、\n館長にもして\nもらえるかしら？"},
        { "location": "615/TALK"  , "narrator": "アーヤ", "text": "まあ、予算の都合で無理、\nって言われる可能性は\n高いけどね……。"},
        { "location": "616/TALK"  , "narrator": "雛", "text": "わかりましたー！"},
        { "location": "617/TALK"  , "narrator": "雛", "text": "もう少し考えをまとめたら\n東雲教官へも\n伝えておきますね。"},
        { "location": "618/TALK"  , "narrator": "アーヤ", "text": "ありがとう。"},
        { "location": "620/TALK"  , "narrator": "アーヤ", "text": "…日向さんは、\n心強い味方になって\nくれそうね。"},
        { "location": "621/TALK"  , "narrator": "雛", "text": "ほ、本当ですかー！？\n光栄です！"},
        { "location": "622/TALK"  , "narrator": "雛", "text": "この日向雛、綾水様の\nためならば！"},
        { "location": "623/TALK"  , "narrator": "雛", "text": "お手伝いから\n好みを捧げるまで、\n何でもやりますよ！！"},
        { "location": "624/TALK"  , "narrator": "アーヤ", "text": "…き、期待してるわ。"},
        { "location": "625/TALK"  , "narrator": "アーヤ", "text": "周囲に勘違いされ\nそうなことを言わなければ\n完璧なんだけどね…。"},
        { "location": "636/DIALOG", "narrator": "Dialog_chapter_ch02", "text": "【12 ピクシャル】"}
    ]
}
