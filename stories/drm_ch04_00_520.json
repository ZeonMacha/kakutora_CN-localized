    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "440_永遠も半ばを過ぎて"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "永久機関が存在し得ぬように"},
        { "location": "33/TALK"   , "narrator": "みやび", "text": "永遠というものは存在せぬのではないか"},
        { "location": "35/SEL"    , "narrator": "", "text": "もっと楽しい話をしようよ"},
        { "location": "36/SEL"    , "narrator": "", "text": "ないね！"},
        { "location": "37/SEL"    , "narrator": "", "text": "物理法則に反してるからね"},
        { "location": "38/ACT"    , "narrator": "", "text": "もっと楽しい話をしようよ"},
        { "location": "39/TALK"   , "narrator": "みやび", "text": "なんと"},
        { "location": "40/TALK"   , "narrator": "みやび", "text": "これ以上楽しい話が存在するだろうか"},
        { "location": "41/TALK"   , "narrator": "みやび", "text": "いや"},
        { "location": "43/TALK"   , "narrator": "みやび", "text": "ない"},
        { "location": "44/ACT"    , "narrator": "", "text": "ないね！"},
        { "location": "45/TALK"   , "narrator": "みやび", "text": "ないか"},
        { "location": "46/TALK"   , "narrator": "みやび", "text": "そうか"},
        { "location": "47/TALK"   , "narrator": "みやび", "text": "では"},
        { "location": "48/TALK"   , "narrator": "みやび", "text": "さらばだ"},
        { "location": "49/ACT"    , "narrator": "", "text": "物理法則に反してるからね"},
        { "location": "59/TALK"   , "narrator": "みやび", "text": "うむ"},
        { "location": "60/TALK"   , "narrator": "みやび", "text": "科学的な根拠ぞね"},
        { "location": "62/SEL"    , "narrator": "", "text": "でもみやびと$me$の仲は永遠だよ"},
        { "location": "63/ACT"    , "narrator": "", "text": "でもみやびと$me$の仲は永遠だよ"},
        { "location": "64/TALK"   , "narrator": "みやび", "text": "すぐそういうことを"},
        { "location": "65/TALK"   , "narrator": "みやび", "text": "簡単には信用できんな"},
        { "location": "68/SEL"    , "narrator": "", "text": "だって本当だし"},
        { "location": "69/SEL"    , "narrator": "", "text": "照れなくていいのに"},
        { "location": "70/SEL"    , "narrator": "", "text": "月が綺麗ですね"},
        { "location": "71/ACT"    , "narrator": "", "text": "だって本当だし"},
        { "location": "72/TALK"   , "narrator": "みやび", "text": "本当か"},
        { "location": "73/TALK"   , "narrator": "みやび", "text": "そうなのか"},
        { "location": "74/TALK"   , "narrator": "みやび", "text": "信じてやるぞね"},
        { "location": "75/ACT"    , "narrator": "", "text": "照れなくていいのに"},
        { "location": "76/TALK"   , "narrator": "みやび", "text": "照れてなどない"},
        { "location": "77/TALK"   , "narrator": "みやび", "text": "照れてなど"},
        { "location": "78/TALK"   , "narrator": "みやび", "text": "たぶん"},
        { "location": "79/ACT"    , "narrator": "", "text": "月が綺麗ですね"},
        { "location": "80/TALK"   , "narrator": "みやび", "text": "夏目漱石か"},
        { "location": "81/TALK"   , "narrator": "みやび", "text": "実は後世の創作という説もある"},
        { "location": "82/TALK"   , "narrator": "みやび", "text": "けんど"},
        { "location": "83/TALK"   , "narrator": "みやび", "text": "やっぱり"},
        { "location": "84/TALK"   , "narrator": "みやび", "text": "月はきれいぞね"},
        { "location": "86/SEL"    , "narrator": "", "text": "みやびの方がきれいだよ"},
        { "location": "87/SEL"    , "narrator": "", "text": "二人きりで月が見たいね"},
        { "location": "88/ACT"    , "narrator": "", "text": "みやびの方がきれいだよ"},
        { "location": "89/TALK"   , "narrator": "みやび", "text": "またまた"},
        { "location": "91/TALK"   , "narrator": "みやび", "text": "そんな本当のことを"},
        { "location": "92/ACT"    , "narrator": "", "text": "二人きりで月が見たいね"},
        { "location": "93/TALK"   , "narrator": "みやび", "text": "それは"},
        { "location": "95/TALK"   , "narrator": "みやび", "text": "どんなに美しい月が見えることか"},
        { "location": "97/TALK"   , "narrator": "みやび", "text": "夜の月もよいが"},
        { "location": "98/TALK"   , "narrator": "みやび", "text": "真昼の月のはかなさ"},
        { "location": "99/TALK"   , "narrator": "みやび", "text": "あれもよいものだの"},
        { "location": "101/SEL"   , "narrator": "", "text": "風流だね"},
        { "location": "102/SEL"   , "narrator": "", "text": "そういうものかな"},
        { "location": "103/ACT"   , "narrator": "", "text": "風流だね"},
        { "location": "104/TALK"  , "narrator": "みやび", "text": "な"},
        { "location": "105/ACT"   , "narrator": "", "text": "そういうものかな"},
        { "location": "106/TALK"  , "narrator": "みやび", "text": "おや"},
        { "location": "107/TALK"  , "narrator": "みやび", "text": "わからんか"},
        { "location": "109/TALK"  , "narrator": "みやび", "text": "まあ実際"},
        { "location": "110/TALK"  , "narrator": "みやび", "text": "なぜ月を見て切ない気持ちになるかといえば"},
        { "location": "112/TALK"  , "narrator": "みやび", "text": "昔のことを思い出すからだ"},
        { "location": "113/TALK"  , "narrator": "みやび", "text": "そう"},
        { "location": "114/TALK"  , "narrator": "みやび", "text": "それは"},
        { "location": "115/TALK"  , "narrator": "みやび", "text": "うちが祖父母と竹林近くの和風建築に住もうていたころの話"},
        { "location": "117/SEL"   , "narrator": "", "text": "またまた"},
        { "location": "118/SEL"   , "narrator": "", "text": "えと、何の話？"},
        { "location": "119/ACT"   , "narrator": "", "text": "またまた"},
        { "location": "120/TALK"  , "narrator": "みやび", "text": "いやいや"},
        { "location": "121/ACT"   , "narrator": "", "text": "えと、何の話？"},
        { "location": "122/TALK"  , "narrator": "みやび", "text": "あの話だ"},
        { "location": "124/TALK"  , "narrator": "みやび", "text": "いわゆる"},
        { "location": "125/TALK"  , "narrator": "みやび", "text": "竹取物語"},
        { "location": "127/SEL"   , "narrator": "", "text": "どんな無理難題もクリアしてみせる"},
        { "location": "128/SEL"   , "narrator": "", "text": "さすがにないわ"},
        { "location": "129/ACT"   , "narrator": "", "text": "どんな無理難題もクリアしてみせる"},
        { "location": "130/TALK"  , "narrator": "みやび", "text": "それは頼もしい"},
        { "location": "132/TALK"  , "narrator": "みやび", "text": "期待しておる"},
        { "location": "133/TALK"  , "narrator": "みやび", "text": "割と本気で"},
        { "location": "134/ACT"   , "narrator": "", "text": "さすがにないわ"},
        { "location": "135/TALK"  , "narrator": "みやび", "text": "こらこら"},
        { "location": "137/TALK"  , "narrator": "みやび", "text": "ものの例えだ"},
        { "location": "138/TALK"  , "narrator": "みやび", "text": "それに乗じて甘い言葉をささやけ"},
        { "location": "139/TALK"  , "narrator": "みやび", "text": "恋人同士とはそういうものだ"},
        { "location": "55/DIALOG" , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>1000pt.</b></color></size>\nアップしました！"}
