{
    "dir": "dramatics/daydra/drm_ch02_00_810.js",
    "type": "Episode",
    "info": {
        "story_id": "2081",
        "cid": "ayami",
        "title": "らぶとーく 第80話",
        "sub_title": "本当は全部決めてる"
    },
    "entry":
    [
        { "location": "305/TALK", "narrator": "アーヤ", "text": "さっきの話だけど…。"},
        { "location": "306/SEL" , "narrator": "", "text": "結婚の話？"},
        { "location": "307/SEL" , "narrator": "", "text": "晩ご飯の話だっけ"},
        { "location": "308/SEL" , "narrator": "", "text": "全部アーヤの好きにして"},
        { "location": "309/ACT" , "narrator": "", "text": "結婚の話？"},
        { "location": "310/TALK", "narrator": "アーヤ", "text": "…そうなんだけど…。"},
        { "location": "311/ACT" , "narrator": "", "text": "晩ご飯の話だっけ"},
        { "location": "312/TALK", "narrator": "アーヤ", "text": "もう！\n違うわよ！"},
        { "location": "313/ACT" , "narrator": "", "text": "全部アーヤの好きにして"},
        { "location": "314/TALK", "narrator": "アーヤ", "text": "…それはそれで\nつまんないわね。"},
        { "location": "316/TALK", "narrator": "アーヤ", "text": "もちろん正式な\n結婚式なんかじゃ\nないけど。"},
        { "location": "317/TALK", "narrator": "アーヤ", "text": "私自身の中で\n覚悟を決めたいから。"},
        { "location": "318/TALK", "narrator": "アーヤ", "text": "それなりに形に\nしておきたいの。"},
        { "location": "319/TALK", "narrator": "アーヤ", "text": "$handle$さんは\nどういうのがいい？"},
        { "location": "320/SEL" , "narrator": "", "text": "ゴンドラにスモーク"},
        { "location": "321/SEL" , "narrator": "", "text": "芸能人を呼ぶ"},
        { "location": "322/SEL" , "narrator": "", "text": "シャンパンタワー"},
        { "location": "323/ACT" , "narrator": "", "text": "ゴンドラにスモーク"},
        { "location": "324/TALK", "narrator": "アーヤ", "text": "バブル！？"},
        { "location": "325/ACT" , "narrator": "", "text": "芸能人を呼ぶ"},
        { "location": "326/TALK", "narrator": "アーヤ", "text": "そんな知り合い\nいないわよ。"},
        { "location": "327/TALK", "narrator": "アーヤ", "text": "…いやいたわね。\nいるけど…。"},
        { "location": "328/TALK", "narrator": "アーヤ", "text": "ちょっと無理が\nありすぎる感じ…。"},
        { "location": "329/ACT" , "narrator": "", "text": "シャンパンタワー"},
        { "location": "330/TALK", "narrator": "アーヤ", "text": "…ホストクラブ！？"},
        { "location": "332/TALK", "narrator": "アーヤ", "text": "…でもね。"},
        { "location": "333/TALK", "narrator": "アーヤ", "text": "こっちにいるのは\n私だけでしょ。"},
        { "location": "334/TALK", "narrator": "アーヤ", "text": "そういうのは\nなんていうか…\n結構シュールじゃない？"},
        { "location": "335/SEL" , "narrator": "", "text": "本気にしないで"},
        { "location": "336/SEL" , "narrator": "", "text": "冗談だから"},
        { "location": "337/SEL" , "narrator": "", "text": "アーヤはかわいいなあ"},
        { "location": "338/ACT" , "narrator": "", "text": "本気にしないで"},
        { "location": "340/TALK", "narrator": "アーヤ", "text": "えっ？\nそうなの！？\nひどい！"},
        { "location": "341/ACT" , "narrator": "", "text": "冗談だから"},
        { "location": "342/TALK", "narrator": "アーヤ", "text": "もー！\n本気にしたわよ！"},
        { "location": "343/ACT" , "narrator": "", "text": "アーヤはかわいいなあ"},
        { "location": "344/TALK", "narrator": "アーヤ", "text": "あれ！？\n冗談ってこと？"},
        { "location": "346/TALK", "narrator": "アーヤ", "text": "………やっぱり\n真面目にする\n話じゃないの…？"},
        { "location": "347/SEL" , "narrator": "", "text": "ごめん！\nはしゃぎすぎた"},
        { "location": "348/SEL" , "narrator": "", "text": "いや、照れちゃって…"},
        { "location": "349/SEL" , "narrator": "", "text": "真面目にするから！"},
        { "location": "350/ACT" , "narrator": "", "text": "ごめん！\nはしゃぎすぎた"},
        { "location": "351/TALK", "narrator": "アーヤ", "text": "…何よ…もう…。"},
        { "location": "352/ACT" , "narrator": "", "text": "いや、照れちゃって…"},
        { "location": "353/TALK", "narrator": "アーヤ", "text": "だからって……。"},
        { "location": "354/ACT" , "narrator": "", "text": "真面目にするから！"},
        { "location": "355/TALK", "narrator": "アーヤ", "text": "…いいけど……。"},
        { "location": "357/SEL" , "narrator": "", "text": "アーヤはどんなのが\nいいの？"},
        { "location": "358/SEL" , "narrator": "", "text": "アーヤが主役だから"},
        { "location": "359/SEL" , "narrator": "", "text": "思い出の式とかないの？"},
        { "location": "360/ACT" , "narrator": "", "text": "アーヤはどんなのが\nいいの？"},
        { "location": "361/TALK", "narrator": "アーヤ", "text": "私？"},
        { "location": "362/ACT" , "narrator": "", "text": "アーヤが主役だから"},
        { "location": "363/TALK", "narrator": "アーヤ", "text": "…そう言われると\n照れるわね…。"},
        { "location": "364/ACT" , "narrator": "", "text": "思い出の式とかないの？"},
        { "location": "365/TALK", "narrator": "アーヤ", "text": "思い出……。"},
        { "location": "367/TALK", "narrator": "アーヤ", "text": "そうね…。"},
        { "location": "368/TALK", "narrator": "アーヤ", "text": "何で見たのか\n忘れたけど。"},
        { "location": "369/TALK", "narrator": "アーヤ", "text": "ウエディングドレスで\nバイクにまたがってる\n花嫁を見たの。"},
        { "location": "370/TALK", "narrator": "アーヤ", "text": "あれだと一人でも\n絵になる感じだし。"},
        { "location": "371/TALK", "narrator": "アーヤ", "text": "…どう…？"},
        { "location": "372/SEL" , "narrator": "", "text": "なんか意外"},
        { "location": "373/SEL" , "narrator": "", "text": "格好いい！"},
        { "location": "374/SEL" , "narrator": "", "text": "ちょっと映画みたいだね"},
        { "location": "375/ACT" , "narrator": "", "text": "なんか意外"},
        { "location": "377/TALK", "narrator": "アーヤ", "text": "そう？"},
        { "location": "378/SEL" , "narrator": "", "text": "バイクがそんなに\n好きだったとは"},
        { "location": "379/SEL" , "narrator": "", "text": "和装がいいんだと\n思ってた"},
        { "location": "380/SEL" , "narrator": "", "text": "ひっそりしたいんだと\n思ってたから"},
        { "location": "381/ACT" , "narrator": "", "text": "バイクがそんなに\n好きだったとは"},
        { "location": "382/TALK", "narrator": "アーヤ", "text": "そこなの？"},
        { "location": "383/ACT" , "narrator": "", "text": "和装がいいんだと\n思ってた"},
        { "location": "384/TALK", "narrator": "アーヤ", "text": "そう見られてるのね。"},
        { "location": "385/ACT" , "narrator": "", "text": "ひっそりしたいんだと\n思ってたから"},
        { "location": "386/TALK", "narrator": "アーヤ", "text": "記念だもの。"},
        { "location": "388/ACT" , "narrator": "", "text": "格好いい！"},
        { "location": "389/TALK", "narrator": "アーヤ", "text": "でしょ？"},
        { "location": "390/TALK", "narrator": "アーヤ", "text": "よかった\nそう言ってもらえて。"},
        { "location": "391/ACT" , "narrator": "", "text": "ちょっと映画みたいだね"},
        { "location": "392/TALK", "narrator": "アーヤ", "text": "やっぱりそう思う？"},
        { "location": "393/SEL" , "narrator": "", "text": "フランス映画っぽい"},
        { "location": "394/SEL" , "narrator": "", "text": "ハリウッドアクション"},
        { "location": "395/SEL" , "narrator": "", "text": "新機軸のVシネかな"},
        { "location": "396/ACT" , "narrator": "", "text": "フランス映画っぽい"},
        { "location": "397/TALK", "narrator": "アーヤ", "text": "すごくいい感じ！"},
        { "location": "398/ACT" , "narrator": "", "text": "ハリウッドアクション"},
        { "location": "400/TALK", "narrator": "アーヤ", "text": "えー…。\nそんな方向の派手さは\nいらないわ……。"},
        { "location": "401/ACT" , "narrator": "", "text": "新機軸のVシネかな"},
        { "location": "403/TALK", "narrator": "アーヤ", "text": "新機軸すぎて\n内容の想像が\nつかないわ。"},
        { "location": "406/TALK", "narrator": "アーヤ", "text": "$handle$さんが\nそれで構わない\nならだけど……。"},
        { "location": "407/SEL" , "narrator": "", "text": "是非もない"},
        { "location": "408/SEL" , "narrator": "", "text": "むしろ見たい"},
        { "location": "409/SEL" , "narrator": "", "text": "今回はこれで\n勘弁してやる"},
        { "location": "410/ACT" , "narrator": "", "text": "是非もない"},
        { "location": "411/TALK", "narrator": "アーヤ", "text": "ずいぶん堅い\n言い方するのね。"},
        { "location": "412/ACT" , "narrator": "", "text": "むしろ見たい"},
        { "location": "413/TALK", "narrator": "アーヤ", "text": "本当？\nうれしい！"},
        { "location": "414/ACT" , "narrator": "", "text": "今回はこれで\n勘弁してやる"},
        { "location": "415/TALK", "narrator": "アーヤ", "text": "変な言い方\nしないで。"},
        { "location": "417/TALK", "narrator": "アーヤ", "text": "そうなったら\n場所なんかも\n探さないと。"},
        { "location": "418/TALK", "narrator": "アーヤ", "text": "ドレスの試着は\n一人でも大丈夫\nみたいだし。"},
        { "location": "419/TALK", "narrator": "アーヤ", "text": "あ。\n$handle$さんは\n試着したところ見たい？"},
        { "location": "420/SEL" , "narrator": "", "text": "脱いだとこが見たい"},
        { "location": "421/SEL" , "narrator": "", "text": "当日のお楽しみにしたい"},
        { "location": "422/SEL" , "narrator": "", "text": "$me$の衣装も探さないとね"},
        { "location": "423/ACT" , "narrator": "", "text": "脱いだとこが見たい"},
        { "location": "424/TALK", "narrator": "アーヤ", "text": "もう！\nそんなことばっかり！"},
        { "location": "425/ACT" , "narrator": "", "text": "当日のお楽しみにしたい"},
        { "location": "426/TALK", "narrator": "アーヤ", "text": "そういうの\nいいわね。"},
        { "location": "427/ACT" , "narrator": "", "text": "$me$の衣装も探さないとね"},
        { "location": "428/TALK", "narrator": "アーヤ", "text": "何着ても似合うわよ\n$handle$さんは。"},
        { "location": "440/TALK", "narrator": "アーヤ", "text": "……どう？"},
        { "location": "441/TALK", "narrator": "アーヤ", "text": "おかしくない？"},
        { "location": "442/SEL" , "narrator": "", "text": "何が？"},
        { "location": "443/SEL" , "narrator": "", "text": "似合ってる"},
        { "location": "444/SEL" , "narrator": "", "text": "世界で一番輝いてる"},
        { "location": "445/ACT" , "narrator": "", "text": "何が？"},
        { "location": "446/TALK", "narrator": "アーヤ", "text": "何がって\nドレスよ。"},
        { "location": "447/ACT" , "narrator": "", "text": "似合ってる"},
        { "location": "448/TALK", "narrator": "アーヤ", "text": "ありがとう。"},
        { "location": "449/ACT" , "narrator": "", "text": "世界で一番輝いてる"},
        { "location": "451/TALK", "narrator": "アーヤ", "text": "やだ\n褒め過ぎよ。"},
        { "location": "453/TALK", "narrator": "アーヤ", "text": "…ドレスは気に入ったのが\nあったけど。"},
        { "location": "454/TALK", "narrator": "アーヤ", "text": "場所は当日にならないと\nわからない部分があるわね。"},
        { "location": "455/SEL" , "narrator": "", "text": "天気とか関係するしね"},
        { "location": "456/SEL" , "narrator": "", "text": "いいところだと思うよ"},
        { "location": "457/SEL" , "narrator": "", "text": "成り行きに任せようよ"},
        { "location": "458/ACT" , "narrator": "", "text": "天気とか関係するしね"},
        { "location": "459/TALK", "narrator": "アーヤ", "text": "屋外だとそうよね。"},
        { "location": "460/ACT" , "narrator": "", "text": "いいところだと思うよ"},
        { "location": "461/TALK", "narrator": "アーヤ", "text": "よかった。\nそう言ってくれて。"},
        { "location": "462/ACT" , "narrator": "", "text": "成り行きに任せようよ"},
        { "location": "463/TALK", "narrator": "アーヤ", "text": "そうね。\nそういうのも大事よね。"},
        { "location": "465/TALK", "narrator": "アーヤ", "text": "本当は\n$handle$さんが隣に\nいて欲しいけど。"},
        { "location": "466/TALK", "narrator": "アーヤ", "text": "それはいつかの\n楽しみにとっておくわ。"},
        { "location": "467/SEL" , "narrator": "", "text": "そうだね"},
        { "location": "468/SEL" , "narrator": "", "text": "今日は今日でいい日だよ"},
        { "location": "469/SEL" , "narrator": "", "text": "来るといいよね…"},
        { "location": "470/ACT" , "narrator": "", "text": "そうだね"},
        { "location": "472/TALK", "narrator": "アーヤ", "text": "…いつか来るって\n信じてる。"},
        { "location": "473/ACT" , "narrator": "", "text": "今日は今日でいい日だよ"},
        { "location": "475/TALK", "narrator": "アーヤ", "text": "…そうね。\n本当に。"},
        { "location": "476/ACT" , "narrator": "", "text": "来るといいよね…"},
        { "location": "477/TALK", "narrator": "アーヤ", "text": "…どうなのかしら…。"},
        { "location": "478/TALK", "narrator": "アーヤ", "text": "なんて。\n弱気になっても\nしょうがないし。"},
        { "location": "479/TALK", "narrator": "アーヤ", "text": "楽しみはあるに\n越したことは\nないでしょ？"},
        { "location": "481/TALK", "narrator": "アーヤ", "text": "$handle$さんは\nどういうのが\n着たかった？"},
        { "location": "482/SEL" , "narrator": "", "text": "ウエディングドレス"},
        { "location": "483/SEL" , "narrator": "", "text": "羽織袴"},
        { "location": "484/SEL" , "narrator": "", "text": "綿帽子"},
        { "location": "485/SEL" , "narrator": "", "text": "ミニ丈のドレス"},
        { "location": "486/SEL" , "narrator": "", "text": "コスプレ衣装？"},
        { "location": "487/SEL" , "narrator": "", "text": "タキシード"},
        { "location": "488/ACT" , "narrator": "", "text": "ウエディングドレス"},
        { "location": "489/TALK", "narrator": "アーヤ", "text": "やっぱり？"},
        { "location": "490/ACT" , "narrator": "", "text": "羽織袴"},
        { "location": "491/TALK", "narrator": "アーヤ", "text": "それも格好いいわね。"},
        { "location": "492/ACT" , "narrator": "", "text": "綿帽子"},
        { "location": "493/TALK", "narrator": "アーヤ", "text": "ずいぶん古風なのね。"},
        { "location": "494/ACT" , "narrator": "", "text": "ミニ丈のドレス"},
        { "location": "495/TALK", "narrator": "アーヤ", "text": "そういうの\n見たことあるわ。"},
        { "location": "496/ACT" , "narrator": "", "text": "コスプレ衣装？"},
        { "location": "497/TALK", "narrator": "アーヤ", "text": "え？\nそれはさすがに…。"},
        { "location": "498/ACT" , "narrator": "", "text": "タキシード"},
        { "location": "499/TALK", "narrator": "アーヤ", "text": "こういう時じゃないと\n着れないものね。"},
        { "location": "501/TALK", "narrator": "アーヤ", "text": "そういえば。"},
        { "location": "502/TALK", "narrator": "アーヤ", "text": "式の話をしたら\nちょっと意外みたいな\n反応だったけど。"},
        { "location": "503/TALK", "narrator": "アーヤ", "text": "…やっぱりちょっと\n変だって思ったから？"},
        { "location": "505/TALK", "narrator": "アーヤ", "text": "こんな形で\n会えもしないのにって。"},
        { "location": "506/SEL" , "narrator": "", "text": "会えなくても愛してる"},
        { "location": "507/SEL" , "narrator": "", "text": "突然だから\nびっくりしただけ"},
        { "location": "508/SEL" , "narrator": "", "text": "むしろ待ってたよ？"},
        { "location": "509/ACT" , "narrator": "", "text": "会えなくても愛してる"},
        { "location": "510/TALK", "narrator": "アーヤ", "text": "…そう言ってくれるのは\nわかってた。"},
        { "location": "512/TALK", "narrator": "アーヤ", "text": "でも、変なことには\n変わりないわ。"},
        { "location": "513/SEL" , "narrator": "", "text": "…ごめんね"},
        { "location": "514/SEL" , "narrator": "", "text": "それでもいい"},
        { "location": "515/SEL" , "narrator": "", "text": "普通がいいんだ？"},
        { "location": "516/ACT" , "narrator": "", "text": "…ごめんね"},
        { "location": "517/TALK", "narrator": "アーヤ", "text": "…謝ってほしい\nわけじゃないの。"},
        { "location": "518/TALK", "narrator": "アーヤ", "text": "変でもどうしても\n$handle$さんの\n特別でいたいから。"},
        { "location": "519/TALK", "narrator": "アーヤ", "text": "…なんて。\n謝るのは私の方かも\nしれないわ。"},
        { "location": "520/ACT" , "narrator": "", "text": "それでもいい"},
        { "location": "521/TALK", "narrator": "アーヤ", "text": "うん。\nそうよね。"},
        { "location": "522/TALK", "narrator": "アーヤ", "text": "変でもなんでも\n構わないわよね…。"},
        { "location": "523/ACT" , "narrator": "", "text": "普通がいいんだ？"},
        { "location": "524/TALK", "narrator": "アーヤ", "text": "それは…そうね。"},
        { "location": "525/TALK", "narrator": "アーヤ", "text": "元々の自分が\nそういう考えなのかも\nしれないけど。"},
        { "location": "526/TALK", "narrator": "アーヤ", "text": "姉のせいもあるわ。\n普通が一番って\n思うのは。"},
        { "location": "527/TALK", "narrator": "アーヤ", "text": "それでもやっぱり\n$handle$さんは\n特別だから…。"},
        { "location": "529/ACT" , "narrator": "", "text": "突然だから\nびっくりしただけ"},
        { "location": "530/TALK", "narrator": "アーヤ", "text": "そう？"},
        { "location": "531/TALK", "narrator": "アーヤ", "text": "ならいいんだけど。"},
        { "location": "532/ACT" , "narrator": "", "text": "むしろ待ってたよ？"},
        { "location": "533/TALK", "narrator": "アーヤ", "text": "え？\nそうだったの！？"},
        { "location": "535/TALK", "narrator": "アーヤ", "text": "私ずっと悩んでた。"},
        { "location": "536/TALK", "narrator": "アーヤ", "text": "$handle$さんと\n会えるあてがないのに\n話したりすること。"},
        { "location": "537/TALK", "narrator": "アーヤ", "text": "これって建設的\nなのかしらって。"},
        { "location": "538/TALK", "narrator": "アーヤ", "text": "続けることに\n意味があるのかしら\nって。"},
        { "location": "539/TALK", "narrator": "アーヤ", "text": "でもね。\n気が付いたの。"},
        { "location": "540/TALK", "narrator": "アーヤ", "text": "$handle$さんと\n話すらできなく\nなる方が無理。"},
        { "location": "541/TALK", "narrator": "アーヤ", "text": "$handle$さんが\n特別じゃなくなる\n方が無理。"},
        { "location": "542/TALK", "narrator": "アーヤ", "text": "だからね。\nこんなだけど、\nけじめをつけたくて。"},
        { "location": "543/SEL" , "narrator": "", "text": "うん"},
        { "location": "544/SEL" , "narrator": "", "text": "ありがとう"},
        { "location": "545/SEL" , "narrator": "", "text": "笑ってよ"},
        { "location": "546/ACT" , "narrator": "", "text": "うん"},
        { "location": "548/TALK", "narrator": "アーヤ", "text": "付き合ってくれて\nありがとう。"},
        { "location": "549/ACT" , "narrator": "", "text": "ありがとう"},
        { "location": "551/TALK", "narrator": "アーヤ", "text": "…こちらこそ。"},
        { "location": "552/ACT" , "narrator": "", "text": "笑ってよ"},
        { "location": "553/TALK", "narrator": "アーヤ", "text": "…そうね。"},
        { "location": "555/TALK", "narrator": "アーヤ", "text": "今ここには\n私の好きなものしか\nないの。"},
        { "location": "556/TALK", "narrator": "アーヤ", "text": "そういう瞬間って\nすごく貴重で\n大事だと思わない？"},
