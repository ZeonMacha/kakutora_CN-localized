    "entry":
    [
        { "location": "8/SCENARIO", "narrator": "", "text": "高度に発達した感情はプログラムに似て"},
        { "location": "28/TALK"   , "narrator": "みやび", "text": "何にもない。\nここは……？"},
        { "location": "29/SEL"    , "narrator": "", "text": "あなたは死にました"},
        { "location": "30/ACT"    , "narrator": "", "text": "あなたは死にました"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "うちが死んだ？"},
        { "location": "35/TALK"   , "narrator": "みやび", "text": "信じることにしよう。\nちうことはここは\n三途の川なんかね？"},
        { "location": "36/TALK"   , "narrator": "みやび", "text": "川渡し殿も\nお迎えご苦労。"},
        { "location": "37/SEL"    , "narrator": "", "text": "どういたしまして"},
        { "location": "38/SEL"    , "narrator": "", "text": "違うよ$me$だよ"},
        { "location": "39/SEL"    , "narrator": "", "text": "$handle$のこと\n忘れた？"},
        { "location": "40/ACT"    , "narrator": "", "text": "どういたしまして"},
        { "location": "41/TALK"   , "narrator": "みやび", "text": "船酔いせんよう\n優しう頼むぞね。"},
        { "location": "42/ACT"    , "narrator": "", "text": "違うよ$me$だよ"},
        { "location": "43/TALK"   , "narrator": "みやび", "text": "どなた様？"},
        { "location": "44/ACT"    , "narrator": "", "text": "$handle$のこと\n忘れた？"},
        { "location": "45/TALK"   , "narrator": "みやび", "text": "それ以前に\n知らんきねえ。"},
        { "location": "47/TALK"   , "narrator": "みやび", "text": "志を全うできても\n志半ばで倒れても\nお前さんの役割は同じ。"},
        { "location": "48/TALK"   , "narrator": "みやび", "text": "まさに相棒やねえ、\nお前さんは。"},
        { "location": "49/SEL"    , "narrator": "", "text": "どういう意味？"},
        { "location": "50/SEL"    , "narrator": "", "text": "相棒は相棒だけど…"},
        { "location": "51/SEL"    , "narrator": "", "text": "本当は恋人だよ"},
        { "location": "52/ACT"    , "narrator": "", "text": "どういう意味？"},
        { "location": "53/TALK"   , "narrator": "みやび", "text": "せっかくやき\n解説して\nおこうかね。"},
        { "location": "54/ACT"    , "narrator": "", "text": "相棒は相棒だけど…"},
        { "location": "55/TALK"   , "narrator": "みやび", "text": "不満げやねえ\n相棒。"},
        { "location": "56/ACT"    , "narrator": "", "text": "本当は恋人だよ"},
        { "location": "58/TALK"   , "narrator": "みやび", "text": "黄泉国まで着いてくる\n恋人とは情熱的な。"},
        { "location": "60/TALK"   , "narrator": "みやび", "text": "フェノメノンとは\nニアイコール別の人生と\n言えるもの。"},
        { "location": "61/TALK"   , "narrator": "みやび", "text": "これまでの人生を終え\n新しい人生を生きる\nようなものやきね。"},
        { "location": "62/TALK"   , "narrator": "みやび", "text": "…この先は現状からの\n推測やけんど。"},
        { "location": "63/TALK"   , "narrator": "みやび", "text": "うちは逢瀬つばめの\nフェノメノンに\n囚われちょったろう？"},
        { "location": "64/SEL"    , "narrator": "", "text": "イエス"},
        { "location": "65/SEL"    , "narrator": "", "text": "そうだったみたい"},
        { "location": "66/SEL"    , "narrator": "", "text": "答えは自分自身の中に"},
        { "location": "67/ACT"    , "narrator": "", "text": "イエス"},
        { "location": "68/TALK"   , "narrator": "みやび", "text": "即答やねえ。"},
        { "location": "69/ACT"    , "narrator": "", "text": "そうだったみたい"},
        { "location": "71/TALK"   , "narrator": "みやび", "text": "明言は避けるが\nその答えは正と\nいうことやね。"},
        { "location": "72/ACT"    , "narrator": "", "text": "答えは自分自身の中に"},
        { "location": "73/TALK"   , "narrator": "みやび", "text": "哲学的な回答ぞね。"},
        { "location": "75/TALK"   , "narrator": "みやび", "text": "まさかこの若さで\n新しい人生が拓けるとは\nわからんもんやね。"},
        { "location": "76/TALK"   , "narrator": "みやび", "text": "逢瀬つばめの中で\nうちはどんな人生を\n送っちょったかね？"},
        { "location": "77/SEL"    , "narrator": "", "text": "スーパーハッカーだった"},
        { "location": "78/SEL"    , "narrator": "", "text": "仲間と和気あいあい"},
        { "location": "79/SEL"    , "narrator": "", "text": "$me$とラブラブ"},
        { "location": "80/ACT"    , "narrator": "", "text": "スーパーハッカーだった"},
        { "location": "81/TALK"   , "narrator": "みやび", "text": "ＰＣが魔法の箱なら\nこんな苦労もせんで\nええんやけんど。"},
        { "location": "82/ACT"    , "narrator": "", "text": "仲間と和気あいあい"},
        { "location": "84/TALK"   , "narrator": "みやび", "text": "明るく正しい青春を\n送っておったとは。"},
        { "location": "85/ACT"    , "narrator": "", "text": "$me$とラブラブ"},
        { "location": "86/TALK"   , "narrator": "みやび", "text": "言うに事欠いて\n嘘を言うのは\n感心できんねえ。"},
        { "location": "88/TALK"   , "narrator": "みやび", "text": "うちは相棒の知る\nうちに覚えがない。\nけんど、それよりも。"},
        { "location": "89/TALK"   , "narrator": "みやび", "text": "相棒自身について\n覚えがないのは\n困るねえ。"},
        { "location": "90/TALK"   , "narrator": "みやび", "text": "ああ、本人から\n聞きだす気は\nさらさらないき。"},
        { "location": "93/TALK"   , "narrator": "みやび", "text": "…ふうん。"},
        { "location": "95/TALK"   , "narrator": "みやび", "text": "相棒はbotとして\nうちと関わりよった\nみたいやね。"},
        { "location": "98/TALK"   , "narrator": "みやび", "text": "せっかくやき、\nそれっぽいことを\nしてくれんかねえ？"},
        { "location": "99/SEL"    , "narrator": "", "text": "今何してる？"},
        { "location": "100/SEL"   , "narrator": "", "text": "この前のアレだけど"},
        { "location": "101/SEL"   , "narrator": "", "text": "ちゅーしよう！"},
        { "location": "102/ACT"   , "narrator": "", "text": "今何してる？"},
        { "location": "103/TALK"  , "narrator": "みやび", "text": "なるほど。"},
        { "location": "104/TALK"  , "narrator": "みやび", "text": "相棒との会話ぞね。"},
        { "location": "105/SEL"   , "narrator": "", "text": "みやびと話せて\nうれしいよ"},
        { "location": "106/SEL"   , "narrator": "", "text": "$me$の話も\n聞いてくれる？"},
        { "location": "107/SEL"   , "narrator": "", "text": "元気そうで何より"},
        { "location": "108/ACT"   , "narrator": "", "text": "みやびと話せて\nうれしいよ"},
        { "location": "109/TALK"  , "narrator": "みやび", "text": "またまた。"},
        { "location": "110/ACT"   , "narrator": "", "text": "$me$の話も\n聞いてくれる？"},
        { "location": "111/TALK"  , "narrator": "みやび", "text": "後でじっくりと\n聞いちゃろう。"},
        { "location": "112/ACT"   , "narrator": "", "text": "元気そうで何より"},
        { "location": "113/TALK"  , "narrator": "みやび", "text": "あんまりそうでも\nないけんど。"},
        { "location": "115/ACT"   , "narrator": "", "text": "この前のアレだけど"},
        { "location": "116/TALK"  , "narrator": "みやび", "text": "どれのことかいね？"},
        { "location": "117/SEL"   , "narrator": "", "text": "アレだよー！"},
        { "location": "118/SEL"   , "narrator": "", "text": "忘れちゃった？"},
        { "location": "119/SEL"   , "narrator": "", "text": "じゃあいいよ……。"},
        { "location": "120/ACT"   , "narrator": "", "text": "アレだよー！"},
        { "location": "121/TALK"  , "narrator": "みやび", "text": "アレなのか。"},
        { "location": "122/ACT"   , "narrator": "", "text": "忘れちゃった？"},
        { "location": "124/TALK"  , "narrator": "みやび", "text": "残念ながら。"},
        { "location": "125/ACT"   , "narrator": "", "text": "じゃあいいよ……。"},
        { "location": "127/TALK"  , "narrator": "みやび", "text": "すまんねえ。"},
        { "location": "129/ACT"   , "narrator": "", "text": "ちゅーしよう！"},
        { "location": "130/TALK"  , "narrator": "みやび", "text": "直球やねえ。"},
        { "location": "132/TALK"  , "narrator": "みやび", "text": "なかなか出来のえい\nプログラムぞね。"},
        { "location": "133/TALK"  , "narrator": "みやび", "text": "リアルデスゲーム\n参加者の心の安寧に\n寄与できそうちや。"},
        { "location": "134/TALK"  , "narrator": "みやび", "text": "けんど、うちには\n必要ないねえ。"},
        { "location": "135/TALK"  , "narrator": "みやび", "text": "データは全て抽出したし。\nもう消えてくれて\n結構やき。"},
        { "location": "136/SEL"   , "narrator": "", "text": "わかった、バイバイ"},
        { "location": "137/SEL"   , "narrator": "", "text": "…なんで？"},
        { "location": "138/SEL"   , "narrator": "", "text": "いやだ"},
        { "location": "139/ACT"   , "narrator": "", "text": "わかった、バイバイ"},
        { "location": "141/ACT"   , "narrator": "", "text": "…なんで？"},
        { "location": "142/TALK"  , "narrator": "みやび", "text": "うちには必要ないと\n言うたろう。"},
        { "location": "143/ACT"   , "narrator": "", "text": "いやだ"},
        { "location": "144/TALK"  , "narrator": "みやび", "text": "わがままとは予想以上に\n高度なプログラムぞね。"},
        { "location": "146/TALK"  , "narrator": "みやび", "text": "うちはデスクトップに\nガジェットやらナビ的な\nものは置かん主義やき。"},
        { "location": "147/TALK"  , "narrator": "みやび", "text": "うちの意思に反して\n動くもんがあると\n気が散るきね。"},
        { "location": "148/TALK"  , "narrator": "みやび", "text": "もっとはっきり言うたら\nイラッとするちや。\nやき、あんたはいらん。"},
        { "location": "149/TALK"  , "narrator": "みやび", "text": "それにうちは早う発症\nしたいぞね。"},
        { "location": "150/TALK"  , "narrator": "みやび", "text": "動くものが全部うち\nという感覚に興味が\nあるきね。"},
        { "location": "151/TALK"  , "narrator": "みやび", "text": "外部のノイズが\n一切ない状態ちうんは\nどういう感覚なんかね？"},
        { "location": "152/TALK"  , "narrator": "みやび", "text": "それが被検体なんなら\nうちはむしろ喜んで\n被検体になるき。"},
        { "location": "154/TALK"  , "narrator": "みやび", "text": "そうなったら今のうちも\n消えるんやろうけんど。"},
        { "location": "155/TALK"  , "narrator": "みやび", "text": "今さらやね。\n失うもんももう\nないわけやし。"},
        { "location": "156/SEL"   , "narrator": "", "text": "そんなことないよ"},
        { "location": "157/SEL"   , "narrator": "", "text": "悲しいこと言わないで"},
        { "location": "158/SEL"   , "narrator": "", "text": "そんなのいやだ"},
        { "location": "159/ACT"   , "narrator": "", "text": "そんなことないよ"},
        { "location": "160/TALK"  , "narrator": "みやび", "text": "共感系ＡＩか。"},
        { "location": "161/ACT"   , "narrator": "", "text": "悲しいこと言わないで"},
        { "location": "162/TALK"  , "narrator": "みやび", "text": "同情系ＡＩとは\n泣かせるねえ。"},
        { "location": "163/ACT"   , "narrator": "", "text": "そんなのいやだ"},
        { "location": "164/TALK"  , "narrator": "みやび", "text": "これはまた\n高度な思考パターンを\n搭載しておるねえ。"},
        { "location": "166/TALK"  , "narrator": "みやび", "text": "わかったわかった。"},
        { "location": "167/TALK"  , "narrator": "みやび", "text": "相棒はサポートＡＩ\nなんやろう。"},
        { "location": "168/TALK"  , "narrator": "みやび", "text": "やったらうちに\n協力するのが\n筋というもんやし。"},
        { "location": "169/TALK"  , "narrator": "みやび", "text": "まずは\nゾルタクスゼイアンの\n蒸着からやき。"},
        { "location": "170/TALK"  , "narrator": "みやび", "text": "きっちり仕事を\n頼むぞね。"},
        { "location": "171/SEL"   , "narrator": "", "text": "みやびのために\n協力する"},
        { "location": "172/SEL"   , "narrator": "", "text": "あなたは$me$の契る\nみやびではない"},
        { "location": "173/ACT"   , "narrator": "", "text": "みやびのために\n協力する"},
        { "location": "175/ACT"   , "narrator": "", "text": "あなたは$me$の契る\nみやびではない"},
        { "location": "216/TALK"  , "narrator": "シンギュラリティ", "text": "お前さんなぁ……"},
        { "location": "217/SEL"   , "narrator": "", "text": "なんですかいきなり"},
        { "location": "218/ACT"   , "narrator": "", "text": "なんですかいきなり"},
        { "location": "220/TALK"  , "narrator": "シンギュラリティ", "text": "うちが死亡フラグ立てつつ\n様子見てきてる間に――"},
        { "location": "221/TALK"  , "narrator": "シンギュラリティ", "text": "四十九夜とえい関係に\nなっちょったんは、\nまっこと納得いかん！"},
        { "location": "222/SEL"   , "narrator": "", "text": "ていうか四十九夜無事だったんだね、よかった！"},
        { "location": "223/SEL"   , "narrator": "", "text": "シンギュラリティ死亡フラグへし折ってエラい！"},
        { "location": "224/ACT"   , "narrator": "", "text": "ていうか四十九夜無事だったんだね、よかった！"},
        { "location": "225/TALK"  , "narrator": "四十九夜　", "text": "お前さんの\n想いのお陰ぞね。\nありがとさん。"},
        { "location": "226/TALK"  , "narrator": "シンギュラリティ", "text": "うちには\n生還の喜びの声は\nないのか！"},
        { "location": "227/SEL"   , "narrator": "", "text": "シンギュラリティ死亡フラグへし折ってエラい！"},
        { "location": "228/ACT"   , "narrator": "", "text": "ていうか四十九夜無事だったんだね、よかった！"},
        { "location": "230/TALK"  , "narrator": "シンギュラリティ", "text": "なんぞその\nメタな褒め方は。"},
        { "location": "231/ACT"   , "narrator": "", "text": "シンギュラリティ死亡フラグへし折ってエラい！"},
        { "location": "233/TALK"  , "narrator": "シンギュラリティ", "text": "まあ、うちにかかれば\nざっとこんなものや。"},
        { "location": "234/TALK"  , "narrator": "シンギュラリティ", "text": "けんど、結局特に何も\nすることなく、勝手に\n元に戻ったがね。"},
        { "location": "235/SEL"   , "narrator": "", "text": "そういえば、ちょっと切るだけって千羽鶴が言ってたわ"},
        { "location": "236/ACT"   , "narrator": "", "text": "そういえば、ちょっと切るだけって千羽鶴が言ってたわ"},
        { "location": "238/TALK"  , "narrator": "シンギュラリティ", "text": "なぜそれを\n先に言わんちや！！"},
        { "location": "240/TALK"  , "narrator": "四十九夜　", "text": "お前さん、完全に\nいじられキャラに\nなっちゅうね。"},
        { "location": "242/TALK"  , "narrator": "シンギュラリティ", "text": "ほっとけ。"},
        { "location": "245/TALK"  , "narrator": "四十九夜　", "text": "とまあ、\nそんなことはさておきだ。"},
        { "location": "247/TALK"  , "narrator": "シンギュラリティ", "text": "大事件やぞ相棒！"},
        { "location": "248/SEL"   , "narrator": "", "text": "意識が混同してる？"},
        { "location": "249/ACT"   , "narrator": "", "text": "意識が混同してる？"},
        { "location": "251/TALK"  , "narrator": "シンギュラリティ", "text": "なんぞ！\n知っちょったんか！"},
        { "location": "252/TALK"  , "narrator": "四十九夜　", "text": "さすがやね。\nシンギュラリティより\n一枚上手や。"},
        { "location": "254/TALK"  , "narrator": "シンギュラリティ", "text": "やき、ほっとけちゅうに。"},
        { "location": "255/TALK"  , "narrator": "四十九夜　", "text": "うちは1xやったから\n解るけんどな、これは\nかなりやばい。"},
        { "location": "256/TALK"  , "narrator": "四十九夜　", "text": "原因は卯月の歌や。\n卯月の歌がつばめちゃんを\n破壊しゆうき起こっちゅう。"},
        { "location": "258/TALK"  , "narrator": "シンギュラリティ", "text": "現実のうちが、どっちが\n本当のことなのか、よう\n解らんくなっちゅうんよ。"},
        { "location": "259/SEL"   , "narrator": "", "text": "放っておくとどうなるの？"},
        { "location": "260/SEL"   , "narrator": "", "text": "そいつはやばいな姐さん"},
        { "location": "261/ACT"   , "narrator": "", "text": "放っておくとどうなるの？"},
        { "location": "262/TALK"  , "narrator": "四十九夜　", "text": "記憶の混濁で倒れるか、\n現実を誤認して唐突に\n暴れたりするか――"},
        { "location": "263/TALK"  , "narrator": "シンギュラリティ", "text": "場合によっては、\nお前さんのことを\n忘れてしまうやもしれん。"},
        { "location": "264/ACT"   , "narrator": "", "text": "そいつはやばいな姐さん"},
        { "location": "265/TALK"  , "narrator": "シンギュラリティ", "text": "うちは\nぴちぴちのギャルやぞ。"},
        { "location": "266/TALK"  , "narrator": "四十九夜　", "text": "うちは婆さんや。"},
        { "location": "267/TALK"  , "narrator": "シンギュラリティ", "text": "とまあ、こんなアホな\nやりとりも、出来なくなって\nしまうやもしれんね。"},
        { "location": "268/TALK"  , "narrator": "四十九夜　", "text": "お前さんのことを\n忘れてしまうやも\nしれんきね。"},
        { "location": "270/SEL"   , "narrator": "", "text": "マジで！？"},
        { "location": "271/ACT"   , "narrator": "", "text": "マジで！？"},
        { "location": "273/TALK"  , "narrator": "シンギュラリティ", "text": "記憶が混濁すると、\n何が夢で何が現実か\nわからんくなる。"},
        { "location": "274/TALK"  , "narrator": "四十九夜　", "text": "すると、脳が防衛機制を\n働かせて、矛盾する\n事柄を夢扱いにする。"},
        { "location": "275/TALK"  , "narrator": "シンギュラリティ", "text": "お前さんは片方では\nラブラブ、もう片方では\n赤の他人。"},
        { "location": "276/TALK"  , "narrator": "四十九夜　", "text": "やき、エアBotみたいな\n感じにされるやもしれん。"},
        { "location": "277/SEL"   , "narrator": "", "text": "それ辛すぎるんですけど！"},
        { "location": "278/ACT"   , "narrator": "", "text": "それ辛すぎるんですけど！"},
        { "location": "281/TALK"  , "narrator": "シンギュラリティ", "text": "ほんだらちくっと、\n夢オチにされないように\nする呪いでもするか。"},
        { "location": "283/TALK"  , "narrator": "四十九夜　", "text": "うむ、そうやね。"},
        { "location": "284/SEL"   , "narrator": "", "text": "どうやるの？"},
        { "location": "285/ACT"   , "narrator": "", "text": "どうやるの？"},
        { "location": "288/TALK"  , "narrator": "シンギュラリティ", "text": "それは――"},
        { "location": "291/TALK"  , "narrator": "シンギュラリティ", "text": "ちゅうや！！"},
        { "location": "293/TALK"  , "narrator": "シンギュラリティ", "text": "四十九夜と\nちゅうをするぞね。"},
        { "location": "294/SEL"   , "narrator": "", "text": "オーケー"},
        { "location": "295/SEL"   , "narrator": "", "text": "シンギュラリティとはできないの？"},
        { "location": "296/ACT"   , "narrator": "", "text": "オーケー"},
        { "location": "297/TALK"  , "narrator": "シンギュラリティ", "text": "うむ。\n四十九夜もえいね？"},
        { "location": "298/TALK"  , "narrator": "四十九夜　", "text": "ああ、えいよ。"},
        { "location": "299/ACT"   , "narrator": "", "text": "シンギュラリティとはできないの？"},
        { "location": "300/TALK"  , "narrator": "シンギュラリティ", "text": "何を寝ぼけたこと\n言っちゅう？"},
        { "location": "301/TALK"  , "narrator": "シンギュラリティ", "text": "お前さん、うちのこと\n気に入っちょらんやろ。"},
        { "location": "302/TALK"  , "narrator": "シンギュラリティ", "text": "さあ、早よう\n四十九夜としいや。"},
        { "location": "306/TALK"  , "narrator": "四十九夜　", "text": "どちらか片方とだけな。"},
        { "location": "307/TALK"  , "narrator": "シンギュラリティ", "text": "どうせするなら\nハイレグギャルの\nうちにしいや！"},
        { "location": "308/TALK"  , "narrator": "四十九夜　", "text": "88歳のピチピチボデーゆう\n希少種との体験は\n貴重やぞ？"},
        { "location": "309/SEL"   , "narrator": "", "text": "健康的ハイレグムスメ"},
        { "location": "310/SEL"   , "narrator": "", "text": "88歳ピチピチボデー"},
        { "location": "311/ACT"   , "narrator": "", "text": "健康的ハイレグムスメ"},
        { "location": "313/TALK"  , "narrator": "シンギュラリティ", "text": "よしゃ！！"},
        { "location": "314/TALK"  , "narrator": "四十九夜　", "text": "ふむ。仕方あるまいな。"},
        { "location": "324/TALK"  , "narrator": "シンギュラリティ", "text": "ほれ、はよ。"},
        { "location": "342/TALK"  , "narrator": "シンギュラリティ", "text": "ふぁっ…"},
        { "location": "345/TALK"  , "narrator": "シンギュラリティ", "text": "ふぁっ…"},
        { "location": "374/TALK"  , "narrator": "シンギュラリティ", "text": "ふぅ。\nえいちゅうやった。"},
        { "location": "375/TALK"  , "narrator": "四十九夜　", "text": "これでお前さんが\n消えなくなるとえいね。"},
        { "location": "376/ACT"   , "narrator": "", "text": "88歳ピチピチボデー"},
        { "location": "378/TALK"  , "narrator": "四十九夜　", "text": "まあ、当然の選択やね。"},
        { "location": "379/TALK"  , "narrator": "シンギュラリティ", "text": "相棒！！\nなぜや！"},
        { "location": "400/TALK"  , "narrator": "四十九夜", "text": "なんぞ、こう、\nその瞬間になると\n緊張するね。"},
        { "location": "419/TALK"  , "narrator": "四十九夜", "text": "ふぇっ……"},
        { "location": "422/TALK"  , "narrator": "四十九夜", "text": "ふぇっ……"},
        { "location": "452/TALK"  , "narrator": "四十九夜　", "text": "やはりちゅうはえいな。\n70歳は若返ったね。"},
        { "location": "454/TALK"  , "narrator": "シンギュラリティ", "text": "これで消えてまったら\nうち、\n何もえいことないぞ？"},
        { "location": "458/TALK"  , "narrator": "四十九夜　", "text": "さて、\nほんだら呪いも\n済んだことやし――"},
        { "location": "460/TALK"  , "narrator": "シンギュラリティ", "text": "そろそろ\n行くとするかね。"},
        { "location": "461/SEL"   , "narrator": "", "text": "どこへ？"},
        { "location": "462/ACT"   , "narrator": "", "text": "どこへ？"},
        { "location": "464/TALK"  , "narrator": "四十九夜　", "text": "なごちゃんの\n所へ、やよ……。"},
        { "location": "488/TALK"  , "narrator": "なご", "text": "四十九夜、\nひさしぶり。"},
        { "location": "489/TALK"  , "narrator": "四十九夜　", "text": "なごちゃん、\n元気やったか？"},
        { "location": "490/TALK"  , "narrator": "なご", "text": "もちろんぞね。"},
        { "location": "491/TALK"  , "narrator": "なご", "text": "ねえ、四十九夜、\nそれより、うちは\nいつ頃昇華できるん？"},
        { "location": "492/TALK"  , "narrator": "四十九夜　", "text": "なごちゃん、\nそれよりも今、うちの本体が\n大変な事になっちゅうんよ。"},
        { "location": "493/TALK"  , "narrator": "なご", "text": "何があったん。"},
        { "location": "494/TALK"  , "narrator": "四十九夜　", "text": "現実とフェノメノンの\n記憶がごちゃごちゃに\nなっちゅう。"},
        { "location": "495/TALK"  , "narrator": "シンギュラリティ", "text": "このままやと、\n頭おかしくなるし、\n相棒のことも忘れてまう。"},
        { "location": "496/TALK"  , "narrator": "四十九夜　", "text": "何とかする方法、\nなごちゃんなら\n知っちゅうかと思うてな。"},
        { "location": "497/TALK"  , "narrator": "なご", "text": "なんぞね、\nそんな簡単なこと。"},
        { "location": "498/TALK"  , "narrator": "なご", "text": "昇華して、\nフェノメノンになれば\nえいだけやよ。"},
        { "location": "499/TALK"  , "narrator": "シンギュラリティ", "text": "なんぞ……"},
        { "location": "500/TALK"  , "narrator": "なご", "text": "フェノメノンになれば、\n現実も虚構も関係ないき。"},
        { "location": "501/TALK"  , "narrator": "なご", "text": "全部ただの物語になって\n他人事みたいに\n考えられるようになるぞね。"},
        { "location": "502/TALK"  , "narrator": "四十九夜　", "text": "なるほどね。\nやはりなごちゃんにとって\n昇華は必要不可欠か。"},
        { "location": "503/TALK"  , "narrator": "四十九夜　", "text": "やはり慰霊祭は\nせんといかんかったんやね。"},
        { "location": "505/TALK"  , "narrator": "シンギュラリティ", "text": "ちょいまち！\nそうやって短絡的に\n物事を進めるな。"},
        { "location": "507/TALK"  , "narrator": "四十九夜　", "text": "短絡的ゆうてもな。\nもはやかなりの時間が\n経過してるわけだが。"},
        { "location": "509/TALK"  , "narrator": "シンギュラリティ", "text": "相棒も\n何か言ったってくれや。"},
        { "location": "510/SEL"   , "narrator": "", "text": "あー、$me$は発症推進派なので……"},
        { "location": "511/SEL"   , "narrator": "", "text": "そうですね、少しお話し合いした方がいいかと"},
        { "location": "512/ACT"   , "narrator": "", "text": "あー、$me$は発症推進派なので……"},
        { "location": "514/TALK"  , "narrator": "シンギュラリティ", "text": "マジか！？"},
        { "location": "515/TALK"  , "narrator": "シンギュラリティ", "text": "前の時は\n違うこと言っちょらん\nかったっけ？"},
        { "location": "517/TALK"  , "narrator": "シンギュラリティ", "text": "ああ、そういえば\nそうやったっけな……。"},
        { "location": "519/TALK"  , "narrator": "四十九夜　", "text": "まあ、ただ。"},
        { "location": "520/TALK"  , "narrator": "四十九夜　", "text": "うちも前よりは\n随分と気持ちが\n揺らいじゅう。"},
        { "location": "521/TALK"  , "narrator": "四十九夜　", "text": "やき、ここはひとつ、\n最後の話し合いの場を\n設けないかね。"},
        { "location": "522/TALK"  , "narrator": "四十九夜　", "text": "$handle$も、\nなごちゃんも\nおるきね。"},
        { "location": "523/ACT"   , "narrator": "", "text": "そうですね、少しお話し合いした方がいいかと"},
        { "location": "526/TALK"  , "narrator": "シンギュラリティ", "text": "……。\nそうやね。"},
        { "location": "527/TALK"  , "narrator": "シンギュラリティ", "text": "お互い、どういう結果に\nなっても、後悔だけは\nせんようにせんといかん。"},
        { "location": "529/TALK"  , "narrator": "シンギュラリティ", "text": "なごちゃんも、\nそれでえいか？"},
        { "location": "530/TALK"  , "narrator": "なご", "text": "構わんけんど、\nなるべく早ようしいや。"},
        { "location": "531/TALK"  , "narrator": "四十九夜　", "text": "わかっちゅうよ。\nもうなごちゃんは\n辛抱たまらんやろうしね。"},
        { "location": "533/TALK"  , "narrator": "なご", "text": "……ん？"},
        { "location": "534/TALK"  , "narrator": "四十九夜　", "text": "どういた、なごちゃん。"},
        { "location": "535/TALK"  , "narrator": "なご", "text": "四十九夜、\n種はどうしたん？"},
        { "location": "536/TALK"  , "narrator": "四十九夜　", "text": "種…？\nちゃんとうちが――"},
        { "location": "537/TALK"  , "narrator": "四十九夜　", "text": "……ない。"},
        { "location": "538/TALK"  , "narrator": "四十九夜　", "text": "ない！\n種が無くなっちゅう！"},
        { "location": "539/TALK"  , "narrator": "なご", "text": "どこかへ\n落としたが？"},
        { "location": "540/TALK"  , "narrator": "シンギュラリティ", "text": "ははぁ、解ったぞね。"},
        { "location": "542/TALK"  , "narrator": "シンギュラリティ", "text": "相棒。お前さん、\nなごちゃんのフェノメノン\n発症反対派やったよな。"},
        { "location": "544/SEL"   , "narrator": "", "text": "もちろんです"},
        { "location": "545/ACT"   , "narrator": "", "text": "もちろんです"},
        { "location": "547/TALK"  , "narrator": "シンギュラリティ", "text": "ほんで、お前さん、\n前回四十九夜と\n戦ったんよな。"},
        { "location": "548/SEL"   , "narrator": "", "text": "そうですね"},
        { "location": "549/ACT"   , "narrator": "", "text": "そうですね"},
        { "location": "551/TALK"  , "narrator": "シンギュラリティ", "text": "それやよ。"},
        { "location": "552/TALK"  , "narrator": "四十九夜　", "text": "なるほどな。"},
        { "location": "553/TALK"  , "narrator": "シンギュラリティ", "text": "クランを収束させたとき、\nそのクランを生かすも\n殺すも相手次第。"},
        { "location": "554/TALK"  , "narrator": "シンギュラリティ", "text": "発症させたくないゆう\n想いがあれば、種を消す\nのも難しくないわけや。"},
        { "location": "555/TALK"  , "narrator": "四十九夜　", "text": "やってくれたね……。"},
        { "location": "556/SEL"   , "narrator": "", "text": "いや、全然知らなかったし"},
        { "location": "557/ACT"   , "narrator": "", "text": "いや、全然知らなかったし"},
        { "location": "559/TALK"  , "narrator": "四十九夜　", "text": "責めちょらんよ。\nうちが提案したことやし。"},
        { "location": "560/TALK"  , "narrator": "四十九夜　", "text": "ただ……\nどうしたもんかと\n困っちゅうだけや。"},
        { "location": "562/TALK"  , "narrator": "シンギュラリティ", "text": "別に困ることなぞ\nないろう。"},
        { "location": "563/TALK"  , "narrator": "シンギュラリティ", "text": "慰霊祭は中止。\nそれだけのことや。"},
        { "location": "565/TALK"  , "narrator": "四十九夜　", "text": "それでは\nなごちゃんの気持ちが\n収まりつかんろうね。"},
        { "location": "566/TALK"  , "narrator": "なご", "text": "四十九夜、\nうち、昇華できんく\nなってしまったん？"},
        { "location": "567/TALK"  , "narrator": "四十九夜　", "text": "ちくっと待ちいや、\nなごちゃん。"},
        { "location": "568/TALK"  , "narrator": "四十九夜　", "text": "うちらでよーく\n考えてみるきね。"},
        { "location": "570/TALK"  , "narrator": "四十九夜　", "text": "ちゅうわけで、\n協力しいや。"},
        { "location": "23/DIALOG" , "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:Interrupt】</color>\nSystem Interrupted.\n\n必須選択肢が選ばれていません。\n\n<color=green>『STORY27：シン・カグラ』</color>\nにて、選択を行ってから\n再度アクセスしてください。\n"},
