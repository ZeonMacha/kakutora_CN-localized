        { "location": "5984/ACT"     , "narrator": "", "text": "神楽のためなら死ねる"},
        { "location": "5985/TALK"    , "narrator": "神楽", "text": "口ばっかりじゃないって証明してよね！"},
        { "location": "5987/TALK"    , "narrator": "神楽", "text": "ぴょんこが大変になった時でいいから"},
