        { "location": "5975/ACT"     , "narrator": "", "text": "$me$と神楽はもう出会っちゃったから！"},
        { "location": "5977/TALK"    , "narrator": "神楽", "text": "これって運命の出会いだったぴょん？"},
        { "location": "5978/TALK"    , "narrator": "神楽", "text": "$handlek$は本気でそう思ってる？"},
        { "location": "5979/TALK"    , "narrator": "神楽", "text": "だったら証明しないといけないぴょん"},
        { "location": "5981/SEL"     , "narrator": "", "text": "神楽のためなら死ねる"},
