{
    "dir": "chap22/daydra/dd_ch04_22_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "22456",
        "cid": "miyabi",
        "title": "Extra005 プレミアムストーリー",
        "sub_title": "真幌の相手"
    },
    "entry":
    [
        { "location": "305/SCENARIO", "narrator": "", "text": "真幌の相手"},
        { "location": "318/TALK"    , "narrator": "みやび", "text": "いや、何度誘われても\nうちは行かんきね。"},
        { "location": "320/TALK"    , "narrator": "つばめ", "text": "でも、こっちに来てから、\nほとんど家にこもりっ\nぱなしじゃないですか。"},
        { "location": "321/TALK"    , "narrator": "つばめ", "text": "海まですぐなんですし、\nちょっとだけでも\n泳ぎませんか？"},
        { "location": "323/TALK"    , "narrator": "アーヤ", "text": "そうよ、少しは身体を\n動かした方がいいわ。"},
        { "location": "325/TALK"    , "narrator": "みやび", "text": "毎朝まほさんの特訓で、\n汗かくほど動いてるき。"},
        { "location": "326/TALK"    , "narrator": "みやび", "text": "これ以上動く気は\nないちや。"},
        { "location": "329/TALK"    , "narrator": "アーヤ", "text": "まったく、本当に\n外出嫌いなんだから…。"},
        { "location": "331/TALK"    , "narrator": "アーヤ", "text": "まあ、砂浜にいるから\n気が変わったらいつでも\n来てね。"},
        { "location": "332/TALK"    , "narrator": "つばめ", "text": "待ってますね。"},
        { "location": "340/TALK"    , "narrator": "みやび", "text": "いや、待たれても\n行かんいうてるのに…。"},
        { "location": "343/TALK"    , "narrator": "真幌", "text": "せっかく目と鼻の先に、\nほとんど誰も来ない\n砂浜があるんだぞ？"},
        { "location": "344/TALK"    , "narrator": "真幌", "text": "行って、おもいっきり\n泳がないのはもったい\nないんじゃないか？"},
        { "location": "346/TALK"    , "narrator": "みやび", "text": "まほさん…朝の特訓が\n終わってからずっと\nゴロゴロしてますね。"},
        { "location": "347/TALK"    , "narrator": "みやび", "text": "まほさんこそ、\nちっくと海で動いた方が\nえいんやないですか？"},
        { "location": "348/TALK"    , "narrator": "真幌", "text": "そうは言うがな、\n早朝から指導する方も\n大変なんだぞ。"},
        { "location": "349/TALK"    , "narrator": "真幌", "text": "私の生活リズムは、\nみやびもよく知っている\nだろう？"},
        { "location": "353/TALK"    , "narrator": "みやび", "text": "…確かに、早寝早起きは\n大敵でしたね。"},
        { "location": "354/TALK"    , "narrator": "真幌", "text": "ああ…本当は夕方からに\n変更したいのだが――"},
        { "location": "355/TALK"    , "narrator": "真幌", "text": "それだと、遊び疲れて\n訓練にならない可能性も\n考えられるからな。"},
        { "location": "358/TALK"    , "narrator": "みやび", "text": "ありえますね。"},
        { "location": "359/TALK"    , "narrator": "みやび", "text": "まあ、早起きした分、\nここで昼寝して\n休んでてください。"},
        { "location": "360/TALK"    , "narrator": "みやび", "text": "うちはそろそろ、\n部屋に戻るんで…。"},
        { "location": "361/TALK"    , "narrator": "真幌", "text": "…………。"},
        { "location": "363/TALK"    , "narrator": "真幌", "text": "いや、やっぱりいかんな。"},
        { "location": "365/TALK"    , "narrator": "みやび", "text": "何がですか？"},
        { "location": "366/TALK"    , "narrator": "真幌", "text": "…今気づいたんだが――"},
        { "location": "368/TALK"    , "narrator": "真幌", "text": "教師が教え子の家に\n上がり込んで、一日中\nゴロゴロしているなど――"},
        { "location": "369/TALK"    , "narrator": "真幌", "text": "許されることでは\nないだろう？"},
        { "location": "371/TALK"    , "narrator": "みやび", "text": "…大分ゴロゴロした後で\n言われてもなぁ…。"},
        { "location": "372/TALK"    , "narrator": "真幌", "text": "よし、出かけるぞ。\nみやびも準備しろ。"},
        { "location": "373/TALK"    , "narrator": "みやび", "text": "は！？　うちもですか？"},
        { "location": "374/TALK"    , "narrator": "真幌", "text": "おまえ、こっち来てから\nほとんど家にいっぱなし\nらしいからな。"},
        { "location": "375/TALK"    , "narrator": "真幌", "text": "少しは外に出ないと、\n本当に体調崩すぞ？"},
        { "location": "377/TALK"    , "narrator": "みやび", "text": "いや、面倒ですし…。"},
        { "location": "378/TALK"    , "narrator": "真幌", "text": "そう言うな。\n昼飯くらいなら、\n何でも奢ってやるぞ？"},
        { "location": "380/TALK"    , "narrator": "みやび", "text": "…まほさん。\nもしかして、話し相手が\n欲しいがですか？"},
        { "location": "381/TALK"    , "narrator": "真幌", "text": "…まあ、一人で出かけても\n面白くはないからな。"},
        { "location": "382/TALK"    , "narrator": "真幌", "text": "どうする？"},
        { "location": "385/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "387/TALK"    , "narrator": "みやび", "text": "ちっくと、部屋のＰＣの\n状態だけ確認させて\nください。"},
        { "location": "388/TALK"    , "narrator": "真幌", "text": "わかった。\nゆっくりでいいぞ。"},
        { "location": "391/TALK"    , "narrator": "みやび", "text": "はぁ…さてと、どうした\nもんか…。"},
        { "location": "403/TALK"    , "narrator": "みやび", "text": "出掛けたくないー"},
        { "location": "405/SEL"     , "narrator": "", "text": "行きたくないって言えば？"},
        { "location": "406/ACT"     , "narrator": "", "text": "行きたくないって言えば？"},
        { "location": "408/TALK"    , "narrator": "みやび", "text": "いや"},
        { "location": "409/TALK"    , "narrator": "みやび", "text": "さすがにまほさん相手に、そこまでハッキリとは言えんよ"},
        { "location": "411/TALK"    , "narrator": "みやび", "text": "やき、遠回しに行きたくないことを伝えられればえいんやけんど…"},
        { "location": "412/TALK"    , "narrator": "みやび", "text": "まほさん、あれで鋭いき"},
        { "location": "413/TALK"    , "narrator": "みやび", "text": "すぐに遠回しに行きたくない言うてるってわかるやろうし"},
        { "location": "415/SEL"     , "narrator": "", "text": "何でも奢ってもらえるよ？"},
        { "location": "416/SEL"     , "narrator": "", "text": "どこに行く気なのかな？"},
        { "location": "417/ACT"     , "narrator": "", "text": "何でも奢ってもらえるよ？"},
        { "location": "419/TALK"    , "narrator": "みやび", "text": "一食数万する高級店でも行くか？"},
        { "location": "420/TALK"    , "narrator": "みやび", "text": "間違いなく、店ついた途端まほさんにキレられるけんど"},
        { "location": "421/TALK"    , "narrator": "みやび", "text": "…いや、それよりも食べたいもんあったわ"},
        { "location": "442/TALK"    , "narrator": "みやび", "text": "まほさん、さっき言うて\nましたが――"},
        { "location": "444/TALK"    , "narrator": "みやび", "text": "本当に何でも奢って\nくれるいうなら、\n食事だけ付き合います。"},
        { "location": "446/TALK"    , "narrator": "真幌", "text": "よし、決まりだ。\nでは行くとしよう。"},
        { "location": "464/TALK"    , "narrator": "ウェイトレス", "text": "お待たせしましたー。\nチョコレートパフェと\nカルボナーラになります。"},
        { "location": "467/TALK"    , "narrator": "みやび", "text": "うちや。"},
        { "location": "468/TALK"    , "narrator": "ウェイトレス", "text": "はい…ごゆっくりどうぞ。"},
        { "location": "474/TALK"    , "narrator": "みやび", "text": "さてと、いただきます。"},
        { "location": "475/TALK"    , "narrator": "真幌", "text": "…何故、よりにもよって\nファミレスを選んだ？"},
        { "location": "476/TALK"    , "narrator": "みやび", "text": "いや、こっち帰ってきて\nからいうもの――"},
        { "location": "477/TALK"    , "narrator": "みやび", "text": "魚中心の和食ばかりで、\nちっくと飽きてきてたが\nですよ。"},
        { "location": "478/TALK"    , "narrator": "みやび", "text": "それに、甘い物も\n食べたい思うてたところ\nでしたし…あむっ。"},
        { "location": "479/TALK"    , "narrator": "みやび", "text": "…うん、ファミレスの\nパフェは全国どこでも\n味が一緒で安心ちや。"},
        { "location": "480/TALK"    , "narrator": "真幌", "text": "…せっかく三戸浜まで\n来ているのだから――"},
        { "location": "481/TALK"    , "narrator": "真幌", "text": "美味い魚料理が\n食べたかったのだがな。"},
        { "location": "482/TALK"    , "narrator": "みやび", "text": "魚料理やったら、\n今日も夕飯ででますき。"},
        { "location": "483/TALK"    , "narrator": "みやび", "text": "わざわざ外で食べる\n必要ないですよ。"},
        { "location": "484/TALK"    , "narrator": "真幌", "text": "…そういうことか。"},
        { "location": "485/TALK"    , "narrator": "真幌", "text": "ここが地元で、更に言えば\nみやびほどの料理の腕が\nあれば――"},
        { "location": "486/TALK"    , "narrator": "真幌", "text": "魚料理など、わざわざ外に\n食べに行くものでは\nないのだろうな…。"},
        { "location": "487/ACT"     , "narrator": "", "text": "どこに行く気なのかな？"},
        { "location": "488/TALK"    , "narrator": "みやび", "text": "そういえば、聞いてなかったな"},
        { "location": "489/TALK"    , "narrator": "みやび", "text": "とりあえずそれ聞いてから、もう一度考えるとするか"},
        { "location": "514/TALK"    , "narrator": "みやび", "text": "まほさん、一つ聞きます\nけんど、どこに行こう\n思うてます？"},
        { "location": "516/TALK"    , "narrator": "真幌", "text": "どこかはわからんが、\n美味い物を食べに\n行きたいと思っていてな。"},
        { "location": "517/TALK"    , "narrator": "真幌", "text": "三崎マグロを使った\n料理を沢山出すような\n店が――"},
        { "location": "518/TALK"    , "narrator": "真幌", "text": "この辺りには色々と\nあるのだろう？"},
        { "location": "519/TALK"    , "narrator": "みやび", "text": "いや、うちに聞かれても\nわからんがですよ。"},
        { "location": "520/TALK"    , "narrator": "真幌", "text": "…何故だ？\nおまえの地元だろう？"},
        { "location": "521/TALK"    , "narrator": "みやび", "text": "知ってのとおり、\n母親の料理スキルが\n異様に高いき――"},
        { "location": "522/TALK"    , "narrator": "みやび", "text": "実家にいる時は、\n外食なんぞ数えるほどしか\nしたことないがですよ。"},
        { "location": "524/TALK"    , "narrator": "真幌", "text": "…………。"},
        { "location": "525/TALK"    , "narrator": "みやび", "text": "まあ、行くとしても\n外食は洋食だけでしたね。"},
        { "location": "526/TALK"    , "narrator": "真幌", "text": "…納得した。"},
        { "location": "528/TALK"    , "narrator": "真幌", "text": "おまえの母親の料理は、\n外で食べるよりも\n美味いからな。"},
        { "location": "529/TALK"    , "narrator": "みやび", "text": "そういうことです。"},
        { "location": "531/TALK"    , "narrator": "みやび", "text": "ちゅうか、まほさん。\nそんなに三崎マグロ\n食べたいなら――"},
        { "location": "532/TALK"    , "narrator": "みやび", "text": "卸売市場行って\n買うてきた方が\nえいですよ。"},
        { "location": "533/TALK"    , "narrator": "みやび", "text": "材料さえあれば、\nうちで色々作れますし。"},
        { "location": "534/TALK"    , "narrator": "みやび", "text": "その方が希望に沿ったもの\n作れますし、なにより、\n財布にも優しいですよ。"},
        { "location": "535/TALK"    , "narrator": "真幌", "text": "ふむ…いいかもしれんな。\nそっちの方が、美味い物が\n食べられそうだし…。"},
        { "location": "536/TALK"    , "narrator": "みやび", "text": "どうします？\nあれなら、作る用意して\n待ってますけんど？"},
        { "location": "537/TALK"    , "narrator": "真幌", "text": "ああ、そうしてくれ。\nちょっと卸売市場行って、\n材料を買ってくる。"},
        { "location": "538/TALK"    , "narrator": "真幌", "text": "今日の昼は三崎マグロの\nフルコースだ！"},
        { "location": "542/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "543/TALK"    , "narrator": "みやび", "text": "外出はしないで\n済みそうやけんど――"},
        { "location": "545/TALK"    , "narrator": "みやび", "text": "なんか、逆に面倒なことに\nなりゆう気がするな…。"},
        { "location": "316/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>8月25日　 1:42 PM</color>\n合宿中、みやびの実家でのこと"}
    ]
}
