    "dir": "chap21/battle/btev_sp05_01_00.js",
    "type": "EventQuest",
    "info": {
        "story_id": "10603",
        "cid": "all",
        "title": "【期間限定】夏は短しハジけよ乙女♪",
        "sub_title": "夏は短しハジけよ乙女♪＜訓練編＞"
    },
    "entry":
    [
        { "location": "8/SCENARIO", "narrator": "", "text": "夏は短しハジけよ乙女♪＜訓練編＞"},
        { "location": "24/TALK"   , "narrator": "アーヤ", "text": "ほら、ギャヴィ。\n早く走りなさいよ。"},
        { "location": "25/TALK"   , "narrator": "ガブリエラ", "text": "はぁ、はぁ…、\nも、もうダメ…。"},
        { "location": "26/TALK"   , "narrator": "アーヤ", "text": "だらしないわね。\nまだ砂浜十往復しか\nしてないでしょ？"},
        { "location": "27/TALK"   , "narrator": "ガブリエラ", "text": "しか！？\n十往復もすれば\n十分よ！"},
        { "location": "28/TALK"   , "narrator": "ガブリエラ", "text": "まったく…アーヤって、\n本当スポ根好きよね…。"},
        { "location": "29/TALK"   , "narrator": "ガブリエラ", "text": "あたしには\n付いてけないわ。"},
        { "location": "30/SEL"    , "narrator": "", "text": "そんなアーヤが素敵"},
        { "location": "31/SEL"    , "narrator": "", "text": "訓練は大事だよね"},
        { "location": "32/ACT"    , "narrator": "", "text": "そんなアーヤが素敵"},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "ほら、$handle$も\nこう言ってるわ。"},
        { "location": "34/TALK"   , "narrator": "ガブリエラ", "text": "ちょ、なによそれ！\nあたしは素敵じゃない\nっていうの！？"},
        { "location": "35/SEL"    , "narrator": "", "text": "いや、そういうわけでは…"},
        { "location": "36/SEL"    , "narrator": "", "text": "大人の魅力で負けてるし"},
        { "location": "37/ACT"    , "narrator": "", "text": "いや、そういうわけでは…"},
        { "location": "38/TALK"   , "narrator": "ガブリエラ", "text": "信じられないわ。"},
        { "location": "39/TALK"   , "narrator": "アーヤ", "text": "ギャヴィは素敵って\nいうよりかは、\n可愛い、よね？"},
        { "location": "40/TALK"   , "narrator": "ガブリエラ", "text": "…なんか、誤魔化されて\nる\n気がするんだけど？"},
        { "location": "41/TALK"   , "narrator": "アーヤ", "text": "本当よ。\nギャヴィのこと、\n可愛いと思うわ。"},
        { "location": "42/TALK"   , "narrator": "ガブリエラ", "text": "…まあ、そこまで言うな\nら\n信じなくはないけど。"},
        { "location": "43/ACT"    , "narrator": "", "text": "大人の魅力で負けてるし"},
        { "location": "45/ACT"    , "narrator": "", "text": "訓練は大事だよね"},
        { "location": "46/TALK"   , "narrator": "ガブリエラ", "text": "別に大事じゃないとは\n言ってないけど？"},
        { "location": "47/TALK"   , "narrator": "ガブリエラ", "text": "ただ、アーヤの場合は\n度を越してるのよ。"},
        { "location": "48/TALK"   , "narrator": "アーヤ", "text": "訓練って聞くと、\nなんだかテンション\n上がっちゃって…。"},
        { "location": "49/TALK"   , "narrator": "ガブリエラ", "text": "…リアルのアーヤも、\n内心こんなこと思いなが\nら"},
        { "location": "50/TALK"   , "narrator": "ガブリエラ", "text": "参加してるのかしら？"},
        { "location": "52/TALK"   , "narrator": "ガブリエラ", "text": "っていうか、アーヤが\n飛ばし過ぎると\n迷惑なのよ。"},
        { "location": "53/TALK"   , "narrator": "ガブリエラ", "text": "真面目にやってる\nあたし達が、サボッてる\nように見えちゃうでしょ？"},
        { "location": "54/TALK"   , "narrator": "アーヤ", "text": "そんなことないわ。"},
        { "location": "55/TALK"   , "narrator": "アーヤ", "text": "自分にできる、無理のな\nい\n範囲で訓練すればいい"},
        { "location": "56/TALK"   , "narrator": "アーヤ", "text": "だけなんだから。"},
        { "location": "57/TALK"   , "narrator": "ガブリエラ", "text": "…一番飛ばしてる人に\n言われても、あんまり\n説得力感じないんだけど？"},
        { "location": "58/TALK"   , "narrator": "ガブリエラ", "text": "まあ、今更もう\n何も言わないわよ。"},
        { "location": "59/SEL"    , "narrator": "", "text": "訓練もいいけど、遊べば？"},
        { "location": "60/ACT"    , "narrator": "", "text": "訓練もいいけど、遊べば？"},
        { "location": "62/TALK"   , "narrator": "ガブリエラ", "text": "さすがね、マルサンナ。\nとてもいいことを\n言うじゃない。"},
        { "location": "63/TALK"   , "narrator": "アーヤ", "text": "合宿で来てるのに、\n遊ぶっていうのは\nどうかと思うけど…。"},
        { "location": "64/TALK"   , "narrator": "ガブリエラ", "text": "はぁ…本当、アーヤって\nお堅いんだから…。"},
        { "location": "65/TALK"   , "narrator": "ガブリエラ", "text": "マルサンナ、\nなんとかして。"},
        { "location": "66/SEL"    , "narrator": "", "text": "海デートには最高のシチュだよ"},
        { "location": "67/SEL"    , "narrator": "", "text": "メンタルケアも大切"},
        { "location": "68/ACT"    , "narrator": "", "text": "海デートには最高のシチュだよ"},
        { "location": "69/TALK"   , "narrator": "アーヤ", "text": "…え？\nつまり、ギャヴィを\nデートに誘えと？"},
        { "location": "70/TALK"   , "narrator": "ガブリエラ", "text": "えっ！？"},
        { "location": "71/SEL"    , "narrator": "", "text": "いや、僕とだよ"},
        { "location": "72/SEL"    , "narrator": "", "text": "その通りだ"},
        { "location": "73/SEL"    , "narrator": "", "text": "僕とガブリエラでだよ"},
        { "location": "74/ACT"    , "narrator": "", "text": "いや、僕とだよ"},
        { "location": "75/ACT"    , "narrator": "", "text": "その通りだ"},
        { "location": "76/TALK"   , "narrator": "アーヤ", "text": "…ということらしいけど、\nデートする？"},
        { "location": "77/TALK"   , "narrator": "ガブリエラ", "text": "え、えっと…。"},
        { "location": "78/TALK"   , "narrator": "ガブリエラ", "text": "…い、いいわ。"},
        { "location": "79/TALK"   , "narrator": "アーヤ", "text": "するってこと？"},
        { "location": "80/TALK"   , "narrator": "ガブリエラ", "text": "ノー、ってこと！"},
        { "location": "81/TALK"   , "narrator": "ガブリエラ", "text": "したくないわけじゃ\nないけど…マルサンナを\n独りにさせちゃうし。"},
        { "location": "82/TALK"   , "narrator": "ガブリエラ", "text": "それに…。"},
        { "location": "83/TALK"   , "narrator": "アーヤ", "text": "それに…？"},
        { "location": "84/TALK"   , "narrator": "ガブリエラ", "text": "（…アーヤが自分から\n言ってきてくれないと、\n嬉しくないし…。）"},
        { "location": "85/TALK"   , "narrator": "ガブリエラ", "text": "…なんでもない。\nとにかく、しないわ。"},
        { "location": "86/ACT"    , "narrator": "", "text": "僕とガブリエラでだよ"},
        { "location": "88/TALK"   , "narrator": "ガブリエラ", "text": "でも、せっかくの海だし、\n楽しむことも必要だと\n思うわ。"},
        { "location": "89/TALK"   , "narrator": "ガブリエラ", "text": "だから、アーヤも\nちょっとは海を\n楽しんだら？"},
        { "location": "90/ACT"    , "narrator": "", "text": "メンタルケアも大切"},
        { "location": "91/TALK"   , "narrator": "ガブリエラ", "text": "そうそう、マルサンナの\n言う通りよ。"},
        { "location": "92/TALK"   , "narrator": "ガブリエラ", "text": "心の中まで鍛えてたら、\n脳筋になっちゃうわよ？"},
        { "location": "93/TALK"   , "narrator": "アーヤ", "text": "の、脳筋！？\nそれは…イヤかも…。"},
        { "location": "94/TALK"   , "narrator": "ガブリエラ", "text": "でしょ？\nだから、ちょっとくらい\n海を楽しみましょ。"},
        { "location": "96/TALK"   , "narrator": "アーヤ", "text": "…そうね。\nそれも悪くないかも\nしれないわね。"},
        { "location": "97/TALK"   , "narrator": "アーヤ", "text": "正直言うと、私も少し\n疲れてきてたところ\nだったし…。"},
        { "location": "98/TALK"   , "narrator": "ガブリエラ", "text": "す、少しね…。\nさすがだわ…。"},
        { "location": "99/TALK"   , "narrator": "アーヤ", "text": "でも…楽しむにしても、\nどう過ごしたらいいもの\nかしら？"},
        { "location": "100/TALK"  , "narrator": "アーヤ", "text": "泳いだりとかだと、\n多分そのまま遠泳とか\nしちゃいそうだし…。"},
        { "location": "101/TALK"  , "narrator": "ガブリエラ", "text": "のんびりと\n楽しむ方法、か…。"},
        { "location": "102/TALK"  , "narrator": "ガブリエラ", "text": "うーん…なにか浮かべば\nいいんだけど…。"},
        { "location": "103/TALK"  , "narrator": "アーヤ", "text": "…やっぱりここは。"},
        { "location": "104/TALK"  , "narrator": "ガブリエラ", "text": "マルサンナに\n協力してもらうのが\n一番よね。"},
        { "location": "105/SEL"   , "narrator": "", "text": "僕ですか！？"},
        { "location": "106/ACT"   , "narrator": "", "text": "僕ですか！？"},
        { "location": "108/TALK"  , "narrator": "ガブリエラ", "text": "そう。"},
        { "location": "109/TALK"  , "narrator": "ガブリエラ", "text": "あたし達がなにか思いつ\nく\nためには、きっかけが"},
        { "location": "110/TALK"  , "narrator": "ガブリエラ", "text": "必要だと思うの。"},
        { "location": "111/TALK"  , "narrator": "アーヤ", "text": "そのきっかけを、\n$handle$に\n作ってもらうわ。"},
        { "location": "112/TALK"  , "narrator": "ガブリエラ", "text": "というわけだから、\nマルサンナ…。"},
        { "location": "113/TALK"  , "narrator": "ガブリエラ", "text": "あとはよろしくね！"}
    ]
}
