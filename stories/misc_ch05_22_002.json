        { "location": "7123/SCENARIO", "narrator": "", "text": "虹色の魚は入道雲の夢を見るか？"},
        { "location": "7150/TALK"    , "narrator": "神楽", "text": "虹って意外と出るものみたいぴょん"},
        { "location": "7152/SEL"     , "narrator": "", "text": "そうなの？"},
        { "location": "7153/SEL"     , "narrator": "", "text": "あんまり見ないけど…"},
        { "location": "7154/SEL"     , "narrator": "", "text": "神楽と一緒に見てみたいなー"},
        { "location": "7155/ACT"     , "narrator": "", "text": "そうなの？"},
        { "location": "7156/TALK"    , "narrator": "神楽", "text": "そうみたい"},
        { "location": "7157/TALK"    , "narrator": "神楽", "text": "あんまり上向いて歩かないから気づいてないだけなのかな？"},
        { "location": "7158/ACT"     , "narrator": "", "text": "あんまり見ないけど…"},
        { "location": "7159/TALK"    , "narrator": "神楽", "text": "あ"},
        { "location": "7160/TALK"    , "narrator": "神楽", "text": "やっぱりそうぴょん？"},
        { "location": "7161/ACT"     , "narrator": "", "text": "神楽と一緒に見てみたいなー"},
        { "location": "7163/TALK"    , "narrator": "神楽", "text": "あー"},
        { "location": "7164/TALK"    , "narrator": "神楽", "text": "それいいかも"},
        { "location": "7166/TALK"    , "narrator": "神楽", "text": "ぴょんこも同じ気持ち～"},
        { "location": "7167/TALK"    , "narrator": "神楽", "text": "ってことにしとくね☆彡"},
        { "location": "7169/TALK"    , "narrator": "神楽", "text": "つばめさんが退院してから虹よく見るって言ってたからそうなのかなーって"},
        { "location": "7170/TALK"    , "narrator": "神楽", "text": "やっぱりレアだよね"},
        { "location": "7171/TALK"    , "narrator": "神楽", "text": "よしよし"}
    ]
