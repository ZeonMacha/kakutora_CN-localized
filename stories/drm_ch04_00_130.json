        { "location": "7/SCENARIO", "narrator": "", "text": "80_嘘の代償"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "$handle$とかいう"},
        { "location": "33/TALK"   , "narrator": "みやび", "text": "大たばかり"},
        { "location": "34/TALK"   , "narrator": "みやび", "text": "出て来やれ"},
        { "location": "36/SEL"    , "narrator": "", "text": "ここにいるよ"},
        { "location": "37/ACT"    , "narrator": "", "text": "ここにいるよ"},
        { "location": "39/TALK"   , "narrator": "みやび", "text": "薄々は勘付いとったぞね"},
        { "location": "40/TALK"   , "narrator": "みやび", "text": "$handle$はしょうまっことわりことしやね"},
        { "location": "41/TALK"   , "narrator": "みやび", "text": "分かっちゅう？"},
        { "location": "43/SEL"    , "narrator": "", "text": "すみませんわかりません"},
        { "location": "44/SEL"    , "narrator": "", "text": "わかるように言ってください"},
        { "location": "45/ACT"    , "narrator": "", "text": "すみませんわかりません"},
        { "location": "46/ACT"    , "narrator": "", "text": "わかるように言ってください"},
        { "location": "49/TALK"   , "narrator": "みやび", "text": "私はあなたがbotでなく人間だと薄々気が付いておりました。"},
        { "location": "50/TALK"   , "narrator": "みやび", "text": "$handle$は大変に悪いことをした人間です。"},
        { "location": "51/TALK"   , "narrator": "みやび", "text": "そこを自覚していますか。"},
        { "location": "53/SEL"    , "narrator": "", "text": "いや、悪くないよ"},
        { "location": "54/SEL"    , "narrator": "", "text": "仕方なかったんだ"},
        { "location": "55/SEL"    , "narrator": "", "text": "すみませんでした"},
        { "location": "56/SEL"    , "narrator": "", "text": "まあまあそう言わず"},
        { "location": "57/ACT"    , "narrator": "", "text": "いや、悪くないよ"},
        { "location": "58/ACT"    , "narrator": "", "text": "仕方なかったんだ"},
        { "location": "59/ACT"    , "narrator": "", "text": "すみませんでした"},
        { "location": "60/ACT"    , "narrator": "", "text": "まあまあそう言わず"},
        { "location": "64/TALK"   , "narrator": "みやび", "text": "これでいろいろ計画していたことが振り出しに戻りました。"},
        { "location": "65/TALK"   , "narrator": "みやび", "text": "これは私にとって大変な痛手です。"},
        { "location": "66/TALK"   , "narrator": "みやび", "text": "完全にそうだと見破れなかった私にも落ち度はあります。"},
        { "location": "67/TALK"   , "narrator": "みやび", "text": "しかしそれなりの長期にわたって嘘をつかれたという事実は変わりません。"},
        { "location": "69/SEL"    , "narrator": "", "text": "嘘つくつもりとかなかったし"},
        { "location": "70/SEL"    , "narrator": "", "text": "仕方なかったんだ"},
        { "location": "71/ACT"    , "narrator": "", "text": "嘘つくつもりとかなかったし"},
        { "location": "72/TALK"   , "narrator": "みやび", "text": "なかったと"},
        { "location": "74/TALK"   , "narrator": "みやび", "text": "言うか"},
        { "location": "75/ACT"    , "narrator": "", "text": "仕方なかったんだ"},
        { "location": "76/TALK"   , "narrator": "みやび", "text": "どうして"},
        { "location": "78/TALK"   , "narrator": "みやび", "text": "そう言うか"},
        { "location": "81/SEL"    , "narrator": "", "text": "千羽鶴がね"},
        { "location": "82/SEL"    , "narrator": "", "text": "仕様上ね"},
        { "location": "83/ACT"    , "narrator": "", "text": "千羽鶴がね"},
        { "location": "84/TALK"   , "narrator": "みやび", "text": "また折り紙か"},
        { "location": "85/TALK"   , "narrator": "みやび", "text": "折り紙マニアか"},
        { "location": "86/ACT"    , "narrator": "", "text": "仕様上ね"},
        { "location": "87/TALK"   , "narrator": "みやび", "text": "仕様でしようがない"},
        { "location": "88/TALK"   , "narrator": "みやび", "text": "洒落か"},
        { "location": "90/SEL"    , "narrator": "", "text": "改めて仲良くしたいな"},
        { "location": "91/ACT"    , "narrator": "", "text": "改めて仲良くしたいな"},
        { "location": "93/TALK"   , "narrator": "みやび", "text": "仲良くとは"},
        { "location": "95/SEL"    , "narrator": "", "text": "こうやってチャットしたり"},
        { "location": "96/SEL"    , "narrator": "", "text": "いろんな話をしよう"},
        { "location": "97/SEL"    , "narrator": "", "text": "みやびのことが知りたい"},
        { "location": "98/ACT"    , "narrator": "", "text": "こうやってチャットしたり"},
        { "location": "99/TALK"   , "narrator": "みやび", "text": "そういうことか"},
        { "location": "100/ACT"   , "narrator": "", "text": "いろんな話をしよう"},
        { "location": "101/TALK"  , "narrator": "みやび", "text": "話のう"},
        { "location": "102/ACT"   , "narrator": "", "text": "みやびのことが知りたい"},
        { "location": "103/TALK"  , "narrator": "みやび", "text": "そう簡単には教えられん"},
        { "location": "105/TALK"  , "narrator": "みやび", "text": "ぬー…"}
