{
    "dir": "chap06/daydra/dd_ch02_06_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "6256",
        "cid": "ayami",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "カップル現る"
    },
    "entry":
    [
        { "location": "318/SCENARIO", "narrator": "", "text": "カップル現る"},
        { "location": "338/TALK"    , "narrator": "みやび", "text": "おおっ…\n盛り上がっちゅう\nなぁ…。"},
        { "location": "341/TALK"    , "narrator": "アーヤ", "text": "こら、みやび。\n上映中なんだから、\n中を覗いたらダメよ？"},
        { "location": "344/TALK"    , "narrator": "みやび", "text": "おっ、えいところに\n来た。アーヤ、ちくっ\nと中を覗いてみぃ。"},
        { "location": "346/TALK"    , "narrator": "アーヤ", "text": "もぉ…何があるって\nいうのよ？"},
        { "location": "348/TALK"    , "narrator": "アーヤ", "text": "…ちょっ！？\nあ、あれなに！？"},
        { "location": "349/TALK"    , "narrator": "みやび", "text": "見てわからんがか？\n高校生のカップルや。"},
        { "location": "350/TALK"    , "narrator": "みやび", "text": "他に客がおらんのを\nえいことに、チュッチュ\nしまくりやね。"},
        { "location": "354/TALK"    , "narrator": "アーヤ", "text": "チュッチュじゃなくて、\nもっと凄いことに\nなってない？"},
        { "location": "357/TALK"    , "narrator": "みやび", "text": "ディープなやつやね。\n生で見たん初めてや\nけんど――"},
        { "location": "358/TALK"    , "narrator": "みやび", "text": "思うてたより、\nなんか…\n気色悪いな。"},
        { "location": "360/TALK"    , "narrator": "アーヤ", "text": "今どきの高校生って、\nあれが\n普通なのかしら…？"},
        { "location": "362/TALK"    , "narrator": "アーヤ", "text": "って、\nそうじゃなくて！"},
        { "location": "364/TALK"    , "narrator": "アーヤ", "text": "やっぱり、\n注意した方が\n良いのかしら？"},
        { "location": "365/TALK"    , "narrator": "みやび", "text": "いんや、今のところ\n注意する理由は\n見つからんよ。"},
        { "location": "366/TALK"    , "narrator": "みやび", "text": "映画館でイチャつく\n程度、極々普通で\n当たり前のことやき。"},
        { "location": "368/TALK"    , "narrator": "アーヤ", "text": "したこともないのに、\n何故堂々と言えるのか\n不思議でならないわ…。"},
        { "location": "370/TALK"    , "narrator": "アーヤ", "text": "でも、他のお客さんの\n迷惑に…。"},
        { "location": "373/TALK"    , "narrator": "みやび", "text": "客はあのカップル以外、\nだ～れもおらんぞ。"},
        { "location": "374/TALK"    , "narrator": "みやび", "text": "ちゅうか、注意なんぞ\nしてみぃ。"},
        { "location": "375/TALK"    , "narrator": "みやび", "text": "うちらが覗いてたん、\nバレるがよ？"},
        { "location": "376/TALK"    , "narrator": "アーヤ", "text": "そ、それはそうだけど…。"},
        { "location": "377/TALK"    , "narrator": "アーヤ", "text": "でも、盛り上がってこう、\nほら…わかるでしょ？"},
        { "location": "378/TALK"    , "narrator": "アーヤ", "text": "そうなってからじゃ\n遅いと思うし…。"},
        { "location": "379/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "381/TALK"    , "narrator": "みやび", "text": "想像力豊かやねぇ。\nそういうところ、\n可愛くてえいと思うんよ。"},
        { "location": "382/TALK"    , "narrator": "アーヤ", "text": "からかわないでよ、\nもう！"},
        { "location": "383/TALK"    , "narrator": "みやび", "text": "まあ、なんにせよ\nうちはもう飽きたき、\n退散するわ。"},
        { "location": "384/TALK"    , "narrator": "みやび", "text": "アーヤも、\nあまり夢中に\nならんようにな。"},
        { "location": "388/TALK"    , "narrator": "アーヤ", "text": "もう、勝手なんだから…。"},
        { "location": "389/TALK"    , "narrator": "アーヤ", "text": "でも、あの二人のこと、\n放っておいていいの\nかしら？"},
        { "location": "390/TALK"    , "narrator": "アーヤ", "text": "確かにキスしか\nしてないように\n見えるけど――"},
        { "location": "391/TALK"    , "narrator": "アーヤ", "text": "何かあるといけない\nから、やっぱり注意\nした方が良さそう…。"},
        { "location": "393/TALK"    , "narrator": "アーヤ", "text": "う～ん…。"},
        { "location": "405/TALK"    , "narrator": "アーヤ", "text": "キスしてるカップルがいるの"},
        { "location": "407/SEL"     , "narrator": "", "text": "普通でしょ？"},
        { "location": "408/ACT"     , "narrator": "", "text": "普通でしょ？"},
        { "location": "410/TALK"    , "narrator": "アーヤ", "text": "ごめん"},
        { "location": "411/TALK"    , "narrator": "アーヤ", "text": "聞き方が悪かった"},
        { "location": "412/TALK"    , "narrator": "アーヤ", "text": "劇場の中で、キスしてるカップルがいるの"},
        { "location": "413/TALK"    , "narrator": "アーヤ", "text": "他の場所でならいいけど"},
        { "location": "414/TALK"    , "narrator": "アーヤ", "text": "上映中の劇場でするのは、よくないと思うの(｀ヘ´) "},
        { "location": "415/TALK"    , "narrator": "アーヤ", "text": "注意した方がいいかしら？"},
        { "location": "417/SEL"     , "narrator": "", "text": "しばらく監視しよう"},
        { "location": "418/SEL"     , "narrator": "", "text": "アーヤ、硬過ぎ！"},
        { "location": "419/ACT"     , "narrator": "", "text": "しばらく監視しよう"},
        { "location": "420/TALK"    , "narrator": "アーヤ", "text": "まだ許容範囲？"},
        { "location": "421/TALK"    , "narrator": "アーヤ", "text": "じゃあ、監視するわ"},
        { "location": "432/TALK"    , "narrator": "アーヤ", "text": "このままいくとあの\n二人、絶対にもっと\n凄いことしそうだもの。"},
        { "location": "434/TALK"    , "narrator": "アーヤ", "text": "不純異性交遊なんて、\nうちの劇場から出す\nわけにはいかないわ。"},
        { "location": "435/TALK"    , "narrator": "アーヤ", "text": "…でも、さっきから\nずっとキスばかり…。"},
        { "location": "436/TALK"    , "narrator": "アーヤ", "text": "口、疲れそうだなぁ…。"},
        { "location": "440/TALK"    , "narrator": "真幌", "text": "何をやっているんだ？"},
        { "location": "442/TALK"    , "narrator": "アーヤ", "text": "あっ、館長！"},
        { "location": "443/TALK"    , "narrator": "真幌", "text": "上映中に劇場の中を\n覗くんじゃない。\nアーヤらしくもないな。"},
        { "location": "447/TALK"    , "narrator": "アーヤ", "text": "す、すみません。\nでも、その…。"},
        { "location": "448/TALK"    , "narrator": "真幌", "text": "…？\n中で何か起きてるのか？"},
        { "location": "450/TALK"    , "narrator": "アーヤ", "text": "あ、はい。\n実はその…。"},
        { "location": "453/TALK"    , "narrator": "真幌", "text": "ふむ…ああ、あれか。"},
        { "location": "456/TALK"    , "narrator": "アーヤ", "text": "カップルがいるの、\n見えますか？"},
        { "location": "457/TALK"    , "narrator": "真幌", "text": "ああ…カップルで\n映画館と来れば、\nだいたいこれだ。"},
        { "location": "460/TALK"    , "narrator": "真幌", "text": "…大丈夫だ。\n安心しろ、アーヤ。"},
        { "location": "461/TALK"    , "narrator": "アーヤ", "text": "えっ？"},
        { "location": "462/TALK"    , "narrator": "アーヤ", "text": "さすが館長。\n注意しに行くのね！"},
        { "location": "463/TALK"    , "narrator": "真幌", "text": "羨ましがらんでも、\nおまえもいずれは\n彼氏ができて――"},
        { "location": "464/TALK"    , "narrator": "真幌", "text": "あれくらい、\n普通にするように\nなるさ。"},
        { "location": "465/TALK"    , "narrator": "アーヤ", "text": "はい！"},
        { "location": "466/TALK"    , "narrator": "アーヤ", "text": "…って、え？\nあの、\nそうじゃなくて…。"},
        { "location": "467/TALK"    , "narrator": "真幌", "text": "落ち込むことはないぞ。\nアーヤは美人だから、\nその気になればすぐさ。"},
        { "location": "468/TALK"    , "narrator": "アーヤ", "text": "だ、だから、そういう\nことじゃなくて…。"},
        { "location": "469/TALK"    , "narrator": "真幌", "text": "わかったわかった。\nまあ、あまり気に\n病まずにいることだな。"},
        { "location": "473/TALK"    , "narrator": "アーヤ", "text": "ご、誤解なんです！\n館長ー！"},
        { "location": "474/ACT"     , "narrator": "", "text": "アーヤ、硬過ぎ！"},
        { "location": "476/TALK"    , "narrator": "アーヤ", "text": "あなたが甘過ぎるだけ！"},
        { "location": "477/TALK"    , "narrator": "アーヤ", "text": "公共良俗を乱すようなことは、許したらダメよ(｀ヘ´)"},
        { "location": "489/TALK"    , "narrator": "アーヤ", "text": "…でも、どうやって\n注意すればいいかしら？"},
        { "location": "490/TALK"    , "narrator": "アーヤ", "text": "みやびの言った通り、\n覗いてたのがバレたら、\n気まずくなるし…。"},
        { "location": "492/TALK"    , "narrator": "アーヤ", "text": "…あっ、館長。"},
        { "location": "496/TALK"    , "narrator": "真幌", "text": "ん？　どうかしたのか？"},
        { "location": "497/TALK"    , "narrator": "アーヤ", "text": "はい。実は劇場の中に、\n高校生のカップルが\nいるんですが――"},
        { "location": "501/TALK"    , "narrator": "アーヤ", "text": "ちょっと、その…\n不純異性交遊に\n発展しかけていて…。"},
        { "location": "502/TALK"    , "narrator": "真幌", "text": "なにっ？\nそれはマズいな。"},
        { "location": "503/TALK"    , "narrator": "真幌", "text": "営業停止になったら\nご先祖様に顔向けできん。\nそいつらはどこだ？"},
        { "location": "506/TALK"    , "narrator": "アーヤ", "text": "ここから覗いて\nください。正面の\n真ん中あたりの席です。"},
        { "location": "509/TALK"    , "narrator": "真幌", "text": "ふむ、どれどれ…。"},
        { "location": "511/TALK"    , "narrator": "アーヤ", "text": "さすがは館長。\nここはビシッと言って\nもらわなくちゃ！"},
        { "location": "512/TALK"    , "narrator": "真幌", "text": "…………？"},
        { "location": "515/TALK"    , "narrator": "真幌", "text": "おい、アーヤ…。\nどこが不純異性交遊だ？"},
        { "location": "518/TALK"    , "narrator": "アーヤ", "text": "え？\nカップルがいるの、\n見えませんか？"},
        { "location": "519/TALK"    , "narrator": "真幌", "text": "見えるが…キスくらい\nしかしていないように\n見えるんだが――"},
        { "location": "520/TALK"    , "narrator": "真幌", "text": "まさか、キスだけで\n不純異性交遊とか\n思っているのか？"},
        { "location": "522/TALK"    , "narrator": "アーヤ", "text": "だ、だって、普通の\nキスじゃないですよ？"},
        { "location": "523/TALK"    , "narrator": "アーヤ", "text": "凄くディープだし、\nなんか髪の毛とか\nかき上げてますし…。"},
        { "location": "524/TALK"    , "narrator": "真幌", "text": "それくらい普通だ。\n不純異性交遊でも\nなんでもない。"},
        { "location": "525/TALK"    , "narrator": "真幌", "text": "あれくらいのこと、\n当時の私もしていたぞ。"},
        { "location": "527/TALK"    , "narrator": "アーヤ", "text": "はぁ！？"},
        { "location": "528/TALK"    , "narrator": "真幌", "text": "どれだけディープでも、\n音を立てなければ\n注意する必要はない。"},
        { "location": "529/TALK"    , "narrator": "真幌", "text": "それと、硬過ぎるのは\n良くないぞ。"},
        { "location": "532/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "533/TALK"    , "narrator": "アーヤ", "text": "あれが…普通なの？"},
        { "location": "534/TALK"    , "narrator": "アーヤ", "text": "っていうか、\nもしかして\n私が遅れてる？"},
        { "location": "535/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "537/TALK"    , "narrator": "アーヤ", "text": "もういいわ。\n見なかったことに\nしよう…。"},
        { "location": "327/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>5月10日　4:14 PM</color>\nとある放課後、神楽坂トライナリーでのバイト中。"},
        { "location": "548/DIALOG"  , "narrator": "Dialog_GEThimegoto_ch02", "text": "【発展などしなくてよろしい】"}
    ]
}
