    [
        { "location": "160/SCENARIO", "narrator": "", "text": "空色ラビリンス"},
        { "location": "187/TALK"    , "narrator": "みやび", "text": "迷宮にはまり込んでしまったぞね"},
        { "location": "189/SEL"     , "narrator": "", "text": "またまた"},
        { "location": "190/SEL"     , "narrator": "", "text": "遊園地にでもいるの"},
        { "location": "191/SEL"     , "narrator": "", "text": "今助けに行くよ"},
        { "location": "192/ACT"     , "narrator": "", "text": "またまた"},
        { "location": "193/TALK"    , "narrator": "みやび", "text": "いやいや"},
        { "location": "194/TALK"    , "narrator": "みやび", "text": "そうなのだ"},
        { "location": "195/ACT"     , "narrator": "", "text": "遊園地にでもいるの"},
        { "location": "196/TALK"    , "narrator": "みやび", "text": "リアルの話ではない"},
        { "location": "197/ACT"     , "narrator": "", "text": "今助けに行くよ"},
        { "location": "199/TALK"    , "narrator": "みやび", "text": "おお"},
        { "location": "201/TALK"    , "narrator": "みやび", "text": "心強いの"},
        { "location": "202/TALK"    , "narrator": "みやび", "text": "さすが相棒"},
        { "location": "204/TALK"    , "narrator": "みやび", "text": "人の心は"},
        { "location": "205/TALK"    , "narrator": "みやび", "text": "ラビリンス"},
        { "location": "206/TALK"    , "narrator": "みやび", "text": "そういう話ぞね"},
        { "location": "208/SEL"     , "narrator": "", "text": "了解しました。"},
        { "location": "209/SEL"     , "narrator": "", "text": "そういうもんだよね"},
        { "location": "210/SEL"     , "narrator": "", "text": "みやびという迷宮をクリアしたい"},
        { "location": "211/ACT"     , "narrator": "", "text": "了解しました。"},
        { "location": "212/TALK"    , "narrator": "みやび", "text": "ずいぶん固いの"},
        { "location": "213/ACT"     , "narrator": "", "text": "そういうもんだよね"},
        { "location": "214/TALK"    , "narrator": "みやび", "text": "そうなのだ"},
        { "location": "215/ACT"     , "narrator": "", "text": "みやびという迷宮をクリアしたい"},
        { "location": "217/TALK"    , "narrator": "みやび", "text": "ほほう"},
        { "location": "218/TALK"    , "narrator": "みやび", "text": "できるなら"},
        { "location": "219/TALK"    , "narrator": "みやび", "text": "やってみよ"},
        { "location": "221/TALK"    , "narrator": "みやび", "text": "当事者というなら当事者"},
        { "location": "222/TALK"    , "narrator": "みやび", "text": "部外者というなら部外者"},
        { "location": "223/TALK"    , "narrator": "みやび", "text": "そんな微妙な距離感のラビリンス"},
        { "location": "224/TALK"    , "narrator": "みやび", "text": "飛び込む気はないが"},
        { "location": "225/TALK"    , "narrator": "みやび", "text": "飲み込まれるかもしれんぞね"}
    ]
