{
    "dir": "chap35/daydra/dd_ch01_35_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "35105",
        "cid": "tsubame",
        "title": "005 メインストーリー",
        "sub_title": "相容れないもの＜後編＞"
    },
    "entry":
    [
        { "location": "422/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "424/TALK"  , "narrator": "千羽鶴", "text": "なるほど。\n状況は把握した。"},
        { "location": "425/TALK"  , "narrator": "音羽", "text": "貴方に勝ち目はない。"},
        { "location": "426/TALK"  , "narrator": "音羽", "text": "私は既につばめちゃんと\nコネクトしてるし――"},
        { "location": "427/TALK"  , "narrator": "音羽", "text": "イシュリールを司る\n人格、カレンもまだ\n生きてる。"},
        { "location": "429/TALK"  , "narrator": "千羽鶴", "text": "……そうみたいね。"},
        { "location": "430/TALK"  , "narrator": "千羽鶴", "text": "で？\nどうするというの？"},
        { "location": "431/TALK"  , "narrator": "音羽", "text": "勘違いしないで欲しいのは\n私は貴方に危害を加える\nことが目的じゃない。"},
        { "location": "432/TALK"  , "narrator": "音羽", "text": "だから、これ以上何も\nしなければ、私も貴方に\n何もするつもりはない。"},
        { "location": "433/TALK"  , "narrator": "音羽", "text": "貴方には、神楽のこと\nとかで、色々と責任を\n果たす義務があるから。"},
        { "location": "434/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "435/TALK"  , "narrator": "音羽", "text": "けど、それは最悪、\n貴方で無くとも、\nできる事も知ってる。"},
        { "location": "436/TALK"  , "narrator": "音羽", "text": "だから、\n大人しくしていて。"},
        { "location": "437/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "438/TALK"  , "narrator": "音羽", "text": "つばめちゃん、\n早くこっちへ！"},
        { "location": "439/TALK"  , "narrator": "つばめ", "text": "は、はい！！"},
        { "location": "440/TALK"  , "narrator": "つばめ", "text": "お邪魔します！"},
        { "location": "447/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "449/SEL"   , "narrator": "", "text": "千羽鶴、大丈夫？\n何でも協力するよ？"},
        { "location": "450/ACT"   , "narrator": "", "text": "千羽鶴、大丈夫？\n何でも協力するよ？"},
        { "location": "452/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "453/SEL"   , "narrator": "", "text": "おーい"},
        { "location": "454/ACT"   , "narrator": "", "text": "おーい"},
        { "location": "457/SEL"   , "narrator": "", "text": "またロクでもないこと企んでるな！？"},
        { "location": "458/ACT"   , "narrator": "", "text": "またロクでもないこと企んでるな！？"},
        { "location": "460/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "461/SEL"   , "narrator": "", "text": "おい返事しろ！"},
        { "location": "462/ACT"   , "narrator": "", "text": "おい返事しろ！"},
        { "location": "465/SEL"   , "narrator": "", "text": "千羽鶴、何を考えてるの！？"},
        { "location": "466/ACT"   , "narrator": "", "text": "千羽鶴、何を考えてるの！？"},
        { "location": "468/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "469/SEL"   , "narrator": "", "text": "聞こえてない！？\n千羽鶴！！"},
        { "location": "470/ACT"   , "narrator": "", "text": "聞こえてない！？\n千羽鶴！！"},
        { "location": "483/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "485/TALK"  , "narrator": "つばめ", "text": "ここが、\n音羽さんの世界？"},
        { "location": "486/TALK"  , "narrator": "音羽", "text": "そう、\nわたしの世界。"},
        { "location": "487/TALK"  , "narrator": "音羽", "text": "そして、つばめちゃんと\n神楽をご招待するために\n作った世界。"},
        { "location": "489/TALK"  , "narrator": "つばめ", "text": "作った……世界？"},
        { "location": "491/TALK"  , "narrator": "つばめ", "text": "そういえば、\nどこかで見たような……"},
        { "location": "492/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "494/TALK"  , "narrator": "つばめ", "text": "あっ！\nこれってもしかして！！"},
        { "location": "495/TALK"  , "narrator": "音羽", "text": "そう、Wishreal…\nイシュリールの世界。"},
        { "location": "496/TALK"  , "narrator": "音羽", "text": "イシュリールの物語に\n出てきた、\nエルカドールの謳う丘。"},
        { "location": "499/TALK"  , "narrator": "つばめ", "text": "すごい……\n本当に謳う丘に\nいるみたい……！！"},
        { "location": "500/TALK"  , "narrator": "音羽", "text": "気に入って貰えて嬉しい。"},
        { "location": "501/TALK"  , "narrator": "音羽", "text": "でも、この世界は\n私の作り物だから、私が\n消えたら無くなるけど。"},
        { "location": "502/TALK"  , "narrator": "音羽", "text": "その時は、つばめちゃんも\n強制的に追い出される。\nごめんね。"},
        { "location": "504/TALK"  , "narrator": "つばめ", "text": "そんな、気にしなくても\n大丈夫です。"},
        { "location": "505/TALK"  , "narrator": "つばめ", "text": "たとえ、今無くなっ\nちゃったとしても、\nとても嬉しいから。"},
        { "location": "506/TALK"  , "narrator": "つばめ", "text": "わたしを……\nわたしの生きる力を\n支えてくれた世界だから。"},
        { "location": "507/TALK"  , "narrator": "音羽", "text": "……そっか。"},
        { "location": "508/TALK"  , "narrator": "音羽", "text": "それじゃ今から、\n神楽を呼び込むけど。"},
        { "location": "509/TALK"  , "narrator": "音羽", "text": "その前にちょっとだけ\n眠っていて欲しいの。"},
        { "location": "511/TALK"  , "narrator": "つばめ", "text": "え？\nそうなの？"},
        { "location": "512/TALK"  , "narrator": "音羽", "text": "うん。"},
        { "location": "513/TALK"  , "narrator": "音羽", "text": "つばめちゃんに対しても\n大事な準備があるから。"},
        { "location": "514/TALK"  , "narrator": "音羽", "text": "信用してもらえるか\nわからないけど、\nお願い出来る？"},
        { "location": "516/TALK"  , "narrator": "つばめ", "text": "もちろんです。\n宜しくお願いします！"},
        { "location": "517/TALK"  , "narrator": "音羽", "text": "ありがとう。"},
        { "location": "518/TALK"  , "narrator": "音羽", "text": "それじゃ、つばめちゃん\n目を瞑って。"},
        { "location": "519/TALK"  , "narrator": "つばめ", "text": "…はい。"},
        { "location": "520/TALK"  , "narrator": "音羽", "text": "少しゆっくり休んでね。"},
        { "location": "521/TALK"  , "narrator": "音羽", "text": "つばめちゃんと\n神楽に、\n素敵なココロの旅を――"},
        { "location": "418/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:Interrupt】</color>\nSystem Interrupted.\n\n必須選択肢が選ばれていません。\n\n<color=green>『STORY27：シン・カグラ』</color>\nにて、選択を行ってから\n再度アクセスしてください。\n"},
        { "location": "534/DIALOG", "narrator": "Dialog_chapter_ch01", "text": "【29 羽とアリス】"}
    ]
}
