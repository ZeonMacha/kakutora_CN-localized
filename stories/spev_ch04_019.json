    "info": {
        "story_id": "91012",
        "cid": "miyabi",
        "title": "【期間限定】誕生日イベント",
        "sub_title": "みやびの誕生日"
    },
    "entry":
    [
        { "location": "8/SCENARIO", "narrator": "", "text": "みやびの誕生日（復元）"},
        { "location": "20/TALK"   , "narrator": "みやび", "text": "む？\nなんぞこれは……"},
        { "location": "22/SEL"    , "narrator": "", "text": "お誕生日おめでとう！"},
        { "location": "23/ACT"    , "narrator": "", "text": "お誕生日おめでとう！"},
        { "location": "25/TALK"   , "narrator": "みやび", "text": "おおっ！\nそうか！"},
        { "location": "26/TALK"   , "narrator": "みやび", "text": "そういえば確かに、\nうちの誕生日は\n7月27日やったね。"},
        { "location": "27/TALK"   , "narrator": "みやび", "text": "普段誰も目出度がらんき、\n完全に忘れちょった。"},
        { "location": "28/SEL"    , "narrator": "", "text": "プレゼントあるよ"},
        { "location": "29/ACT"    , "narrator": "", "text": "プレゼントあるよ"},
        { "location": "31/TALK"   , "narrator": "みやび", "text": "マジか！"},
        { "location": "34/TALK"   , "narrator": "みやび", "text": "まさか、相棒から\nこのようなものを\nもらう事になるとは……"},
        { "location": "35/TALK"   , "narrator": "みやび", "text": "しかしあれか。\nここは定番の――"},
        { "location": "36/TALK"   , "narrator": "みやび", "text": "開けていい？"},
        { "location": "37/TALK"   , "narrator": "みやび", "text": "……という、\n嬉し恥ずかしイベントを\nやるべきなんやろか。"},
        { "location": "38/SEL"    , "narrator": "", "text": "もちろん開けて！"},
        { "location": "39/ACT"    , "narrator": "", "text": "もちろん開けて！"},
        { "location": "41/TALK"   , "narrator": "みやび", "text": "う、うむ……。"},
        { "location": "42/TALK"   , "narrator": "みやび", "text": "けんど、あれやぞ！\nうちはまだ、開けていい？\nと言ったわけではない。"},
        { "location": "43/TALK"   , "narrator": "みやび", "text": "そのことだけは\n努々忘れるな。"},
        { "location": "52/DIALOG" , "narrator": "", "text": "みやびのコスチューム\n<size=40><color=red><b>おかざリップ</b></color></size>\nをゲットしました！"},
        { "location": "55/TALK"   , "narrator": "みやび", "text": "おおっ！\nこれは――"},
        { "location": "57/TALK"   , "narrator": "みやび", "text": "さすがうちの相棒や！\nなんという\n独特のセンス！！"},
        { "location": "58/TALK"   , "narrator": "みやび", "text": "こんなものをプレゼント\nされるなど、予想だに\nせんかったぞね！"},
        { "location": "59/TALK"   , "narrator": "みやび", "text": "こんなサプライズ誕生日\nは\n初めてや……。"},
        { "location": "60/TALK"   , "narrator": "みやび", "text": "ありがとね…。"},
        { "location": "66/DIALOG" , "narrator": "", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "84/TALK"   , "narrator": "みやび", "text": "はあっ……。"},
        { "location": "85/TALK"   , "narrator": "みやび", "text": "なんぞ、今日のナデは\nいつもと違うて\nゾクゾクするぞね…。"},
        { "location": "88/DIALOG" , "narrator": "", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"},
        { "location": "89/TALK"   , "narrator": "みやび", "text": "はあっ……\nな、なんかまだ\nドキドキしゆう。"},
        { "location": "90/TALK"   , "narrator": "みやび", "text": "まっこと、\n心臓に悪い相棒やね。"},
        { "location": "91/SEL"    , "narrator": "", "text": "いつもと同じだけど？"},
        { "location": "92/SEL"    , "narrator": "", "text": "いつもの倍マジで愛情込めて\nタッチしました！"},
        { "location": "93/ACT"    , "narrator": "", "text": "いつもと同じだけど？"},
        { "location": "94/ACT"    , "narrator": "", "text": "いつもの倍マジで愛情込めて\nタッチしました！"},
        { "location": "95/TALK"   , "narrator": "みやび", "text": "まったく。そんなこと\nするから、うちの心臓に\n負荷がかかる。"},
        { "location": "96/TALK"   , "narrator": "みやび", "text": "ちゃんと責任とって\n身のまわりの介護を\nしいや。"},
        { "location": "98/TALK"   , "narrator": "みやび", "text": "とまあ、\nそんな戯れ言は\nこれくらいにして。"},
        { "location": "99/TALK"   , "narrator": "みやび", "text": "……。"},
        { "location": "100/TALK"  , "narrator": "みやび", "text": "今回はほんと、\nありがとな。\nまっこと嬉しかったぞね。"},
        { "location": "101/TALK"  , "narrator": "みやび", "text": "これからもずっと、\nうちの相棒でいてや。"},
        { "location": "104/DIALOG", "narrator": "", "text": "コスチューム\n<color=green>【おかざリップ】</color>は、\n夜時間にパジャマとして\n着せることができます。"}
    ]
}
