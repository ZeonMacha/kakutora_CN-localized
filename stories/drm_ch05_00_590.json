    "entry":
    [
        { "location": "914/SCENARIO", "narrator": "", "text": "チート"},
        { "location": "924/TALK"    , "narrator": "神楽", "text": "…………。"},
        { "location": "925/TALK"    , "narrator": "千羽鶴", "text": "あなたに全てを\n説明する理由はない。"},
        { "location": "926/TALK"    , "narrator": "千羽鶴", "text": "でも計画を伝える\nことによって\n効率化できるなら。"},
        { "location": "927/TALK"    , "narrator": "千羽鶴", "text": "そう思って説明を\nしていただけ。"},
        { "location": "928/TALK"    , "narrator": "千羽鶴", "text": "…でもそれは逆効果\nだったみたい。"},
        { "location": "929/TALK"    , "narrator": "千羽鶴", "text": "それが私の結論。"},
        { "location": "931/TALK"    , "narrator": "神楽", "text": "…………。"},
        { "location": "932/TALK"    , "narrator": "千羽鶴", "text": "自覚はある？"},
        { "location": "933/SEL"     , "narrator": "", "text": "神楽？"},
        { "location": "934/ACT"     , "narrator": "", "text": "神楽？"},
        { "location": "938/TALK"    , "narrator": "千羽鶴", "text": "…お友達から\n連絡が入った\nみたいだけど。"},
        { "location": "940/TALK"    , "narrator": "神楽", "text": "何でもない。"},
        { "location": "941/TALK"    , "narrator": "千羽鶴", "text": "ああそう。\nならいいけど。"},
        { "location": "942/SEL"     , "narrator": "", "text": "何か…大丈夫？"},
        { "location": "943/ACT"     , "narrator": "", "text": "何か…大丈夫？"},
        { "location": "961/TALK"    , "narrator": "神楽", "text": "大丈夫"},
        { "location": "962/TALK"    , "narrator": "神楽", "text": "心配しないで"},
        { "location": "964/SEL"     , "narrator": "", "text": "でも"},
        { "location": "965/SEL"     , "narrator": "", "text": "うん、ごめんね"},
        { "location": "966/SEL"     , "narrator": "", "text": "心配だな…"},
        { "location": "967/ACT"     , "narrator": "", "text": "でも"},
        { "location": "968/ACT"     , "narrator": "", "text": "うん、ごめんね"},
        { "location": "969/ACT"     , "narrator": "", "text": "心配だな…"},
        { "location": "981/TALK"    , "narrator": "千羽鶴", "text": "そのおもちゃで\n遊べるのも\nあと少し。"},
        { "location": "982/TALK"    , "narrator": "千羽鶴", "text": "それまでは好きに\nすればいい。"},
        { "location": "983/TALK"    , "narrator": "神楽", "text": "…………。"},
        { "location": "984/TALK"    , "narrator": "千羽鶴", "text": "ああ、そうだ。"},
        { "location": "985/TALK"    , "narrator": "千羽鶴", "text": "歌については\n練習する必要はない。"},
        { "location": "986/TALK"    , "narrator": "千羽鶴", "text": "こちらで全て\n整えておく。"},
        { "location": "987/TALK"    , "narrator": "千羽鶴", "text": "じゃあ。"},
        { "location": "994/TALK"    , "narrator": "神楽", "text": "…………。"},
        { "location": "1007/TALK"   , "narrator": "神楽", "text": "ごめんねお待たせ"},
        { "location": "1009/TALK"   , "narrator": "神楽", "text": "もうＷＡＶＥしても大丈夫ぴょん♪"},
        { "location": "1011/SEL"    , "narrator": "", "text": "いや…えっと…"},
        { "location": "1012/SEL"    , "narrator": "", "text": "待ってたは待ってたけど…"},
        { "location": "1013/SEL"    , "narrator": "", "text": "本当に大丈夫？？？"},
        { "location": "1014/ACT"    , "narrator": "", "text": "いや…えっと…"},
        { "location": "1015/TALK"   , "narrator": "神楽", "text": "困ってる？"},
        { "location": "1017/ACT"    , "narrator": "", "text": "待ってたは待ってたけど…"},
        { "location": "1020/ACT"    , "narrator": "", "text": "本当に大丈夫？？？"},
        { "location": "1021/TALK"   , "narrator": "神楽", "text": "どう思う？？？"},
        { "location": "1022/TALK"   , "narrator": "神楽", "text": "ねえどう思う？？？"},
        { "location": "1025/TALK"   , "narrator": "神楽", "text": "一言で言うと崖っぷち？？？"},
        { "location": "1026/TALK"   , "narrator": "神楽", "text": "ぴょんこの美貌や明晰な頭脳やアーティストとしての才能を持ってしても回避できない崖！！！"},
        { "location": "1028/SEL"    , "narrator": "", "text": "だよね…"},
        { "location": "1029/SEL"    , "narrator": "", "text": "どうにかしたいんだけど…"},
        { "location": "1030/SEL"    , "narrator": "", "text": "頑張りすぎないで"},
        { "location": "1031/ACT"    , "narrator": "", "text": "だよね…"},
        { "location": "1032/TALK"   , "narrator": "神楽", "text": "だよ！！！！"},
        { "location": "1033/TALK"   , "narrator": "神楽", "text": "どうすんだよ！！！"},
        { "location": "1035/ACT"    , "narrator": "", "text": "どうにかしたいんだけど…"},
        { "location": "1036/TALK"   , "narrator": "神楽", "text": "どうにかしろ！！！"},
        { "location": "1037/TALK"   , "narrator": "神楽", "text": "今すぐだ！！！"},
        { "location": "1039/ACT"    , "narrator": "", "text": "頑張りすぎないで"},
        { "location": "1040/TALK"   , "narrator": "神楽", "text": "立ち止まったら"},
        { "location": "1041/TALK"   , "narrator": "神楽", "text": "もう動けなくなるぴょん！！！"},
        { "location": "1044/TALK"   , "narrator": "神楽", "text": "いやﾏｼﾞﾃﾞﾏｼﾞﾃﾞ"},
        { "location": "1045/TALK"   , "narrator": "神楽", "text": "どうしてくれようってやつ！"},
        { "location": "1047/SEL"    , "narrator": "", "text": "わかる"},
        { "location": "1048/SEL"    , "narrator": "", "text": "ごめんね…"},
        { "location": "1049/SEL"    , "narrator": "", "text": "どうにかしたいな"},
        { "location": "1050/ACT"    , "narrator": "", "text": "わかる"},
        { "location": "1051/TALK"   , "narrator": "神楽", "text": "ホントに！？"},
        { "location": "1053/TALK"   , "narrator": "神楽", "text": "わかってくれるぴょん！？"},
        { "location": "1055/ACT"    , "narrator": "", "text": "ごめんね…"},
        { "location": "1056/TALK"   , "narrator": "神楽", "text": "あーあーあーあー"},
        { "location": "1057/TALK"   , "narrator": "神楽", "text": "いいってそういうのは"},
        { "location": "1059/ACT"    , "narrator": "", "text": "どうにかしたいな"},
        { "location": "1060/TALK"   , "narrator": "神楽", "text": "どうにかしてー"},
        { "location": "1061/TALK"   , "narrator": "神楽", "text": "本当にどうにかしてー"},
        { "location": "1065/TALK"   , "narrator": "神楽", "text": "ぶっちゃけ"},
        { "location": "1066/TALK"   , "narrator": "神楽", "text": "ずっとこんな状態だったわけですー"},
        { "location": "1067/TALK"   , "narrator": "神楽", "text": "ありえないでしょ！"},
        { "location": "1068/TALK"   , "narrator": "神楽", "text": "ほんとありえないでしょ！！！！"},
        { "location": "1070/SEL"    , "narrator": "", "text": "うん"},
        { "location": "1071/SEL"    , "narrator": "", "text": "何と言っていいか"},
        { "location": "1072/SEL"    , "narrator": "", "text": "よしよし"},
        { "location": "1073/ACT"    , "narrator": "", "text": "うん"},
        { "location": "1074/TALK"   , "narrator": "神楽", "text": "やっぱりだー"},
        { "location": "1075/TALK"   , "narrator": "神楽", "text": "ありえないー"},
        { "location": "1077/ACT"    , "narrator": "", "text": "何と言っていいか"},
        { "location": "1078/TALK"   , "narrator": "神楽", "text": "言葉もないって"},
        { "location": "1079/TALK"   , "narrator": "神楽", "text": "やべーまじやべー"},
        { "location": "1081/ACT"    , "narrator": "", "text": "よしよし"},
        { "location": "1082/TALK"   , "narrator": "神楽", "text": "あああああああ"},
        { "location": "1083/TALK"   , "narrator": "神楽", "text": "もっともっともっとー！！！"},
        { "location": "1086/TALK"   , "narrator": "神楽", "text": "なんて言ってても"},
        { "location": "1087/TALK"   , "narrator": "神楽", "text": "仕方ないし"},
        { "location": "1088/TALK"   , "narrator": "神楽", "text": "どうにもならないし"},
        { "location": "1089/TALK"   , "narrator": "神楽", "text": "はーあーあーあーあー"},
        { "location": "1090/TALK"   , "narrator": "神楽", "text": "どうにかなんねーかなーもー"},
        { "location": "1091/TALK"   , "narrator": "神楽", "text": "ﾅﾝﾃﾈ無茶振り"},
        { "location": "1092/TALK"   , "narrator": "神楽", "text": "ちょっと気持ち切り替えよっと"},
        { "location": "1093/TALK"   , "narrator": "神楽", "text": "じゃーねー"},
        { "location": "1108/TALK"   , "narrator": "神楽", "text": "…………。"},
        { "location": "1110/TALK"   , "narrator": "神楽", "text": "ふう……。"},
        { "location": "1113/SEL"    , "narrator": "", "text": "神楽"},
        { "location": "1114/ACT"    , "narrator": "", "text": "神楽"},
        { "location": "1132/TALK"   , "narrator": "神楽", "text": "あ"},
        { "location": "1133/TALK"   , "narrator": "神楽", "text": "どしたの$handle$"},
        { "location": "1135/SEL"    , "narrator": "", "text": "愛してる"},
        { "location": "1136/SEL"    , "narrator": "", "text": "ずっと側にいるから"},
        { "location": "1137/SEL"    , "narrator": "", "text": "最後は上手くいくって信じてて"},
        { "location": "1138/ACT"    , "narrator": "", "text": "愛してる"},
        { "location": "1139/TALK"   , "narrator": "神楽", "text": "そんなの"},
        { "location": "1140/TALK"   , "narrator": "神楽", "text": "ぴょんこの方が百億万倍愛してる！！！"},
        { "location": "1142/ACT"    , "narrator": "", "text": "ずっと側にいるから"},
        { "location": "1143/TALK"   , "narrator": "神楽", "text": "絶対だな！？"},
        { "location": "1144/TALK"   , "narrator": "神楽", "text": "絶対絶対絶対だからな！"},
        { "location": "1146/ACT"    , "narrator": "", "text": "最後は上手くいくって信じてて"},
        { "location": "1147/TALK"   , "narrator": "神楽", "text": "最後って"},
        { "location": "1148/TALK"   , "narrator": "神楽", "text": "いつのことなんだろうね？"},
        { "location": "1162/TALK"   , "narrator": "神楽", "text": "何を言い出すかと\n思ったら……。"},
        { "location": "1163/TALK"   , "narrator": "神楽", "text": "ふふふ……。"}
    ]
}
