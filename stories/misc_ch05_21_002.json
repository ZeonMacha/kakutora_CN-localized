    "entry":
    [
        { "location": "6664/SCENARIO", "narrator": "", "text": "冷戦日和"},
        { "location": "6691/TALK"    , "narrator": "神楽", "text": "そもそも関わりがあるようにすら見えなかったので"},
        { "location": "6692/TALK"    , "narrator": "神楽", "text": "二者間の冷戦が周囲に知れ渡るまでには"},
        { "location": "6693/TALK"    , "narrator": "神楽", "text": "しばらく時間がかかった"},
        { "location": "6695/SEL"     , "narrator": "", "text": "仲良くすればいいのに"},
        { "location": "6696/SEL"     , "narrator": "", "text": "誰かとケンカでもしたの？"},
        { "location": "6697/SEL"     , "narrator": "", "text": "$me$とは冷戦しないよね？？"},
        { "location": "6698/ACT"     , "narrator": "", "text": "仲良くすればいいのに"},
        { "location": "6699/TALK"    , "narrator": "神楽", "text": "そうできない事情があったぴょん"},
        { "location": "6700/ACT"     , "narrator": "", "text": "誰かとケンカでもしたの？"},
        { "location": "6701/TALK"    , "narrator": "神楽", "text": "ぴょんこの話じゃないぴょん"},
        { "location": "6704/ACT"     , "narrator": "", "text": "$me$とは冷戦しないよね？？"},
        { "location": "6706/TALK"    , "narrator": "神楽", "text": "それはどうかな？"},
        { "location": "6707/TALK"    , "narrator": "神楽", "text": "$handlek$次第かな？？"},
        { "location": "6708/TALK"    , "narrator": "神楽", "text": "なんてねしないぴょん！"},
        { "location": "6710/TALK"    , "narrator": "神楽", "text": "実際問題"},
        { "location": "6711/TALK"    , "narrator": "神楽", "text": "女子の国は常に冷戦"},
        { "location": "6712/TALK"    , "narrator": "神楽", "text": "冷戦日和じゃない日なんてないぴょん"},
        { "location": "6714/SEL"     , "narrator": "", "text": "女子こわ…"},
        { "location": "6715/SEL"     , "narrator": "", "text": "わかるー！"},
        { "location": "6716/SEL"     , "narrator": "", "text": "$me$はいつでも神楽の味方だよ"},
        { "location": "6717/ACT"     , "narrator": "", "text": "女子こわ…"},
        { "location": "6718/TALK"    , "narrator": "神楽", "text": "別に普通ー"},
        { "location": "6719/ACT"     , "narrator": "", "text": "わかるー！"},
        { "location": "6720/TALK"    , "narrator": "神楽", "text": "でっしょー！！！"},
        { "location": "6723/ACT"     , "narrator": "", "text": "$me$はいつでも神楽の味方だよ"},
        { "location": "6725/TALK"    , "narrator": "神楽", "text": "ふふん"},
        { "location": "6726/TALK"    , "narrator": "神楽", "text": "そういうやつが後ろから笑顔でぴょんこを撃つんだぴょん"},
        { "location": "6727/TALK"    , "narrator": "神楽", "text": "ぴょんこは騙されない！！"},
        { "location": "6728/TALK"    , "narrator": "神楽", "text": "でも$handlek$になら騙されてもいいぴょん"},
        { "location": "6729/TALK"    , "narrator": "神楽", "text": "なんてね？"},
        { "location": "6731/TALK"    , "narrator": "神楽", "text": "それでも女子は女子として自分の国を護るんだぴょん"},
        { "location": "6732/TALK"    , "narrator": "神楽", "text": "それが君主の務めだから"}
    ]
}
