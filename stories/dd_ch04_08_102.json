{
    "dir": "chap08/daydra/dd_ch04_08_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "8405",
        "cid": "miyabi",
        "title": "005 メインストーリー",
        "sub_title": "大胆勝負～Case3～＜後編＞"
    },
    "entry":
    [
        { "location": "304/SCENARIO", "narrator": "", "text": "大胆勝負～Case3～"},
        { "location": "320/TALK"    , "narrator": "みやび", "text": "…いや、いかん。\nちくっと冷静に\nならんと…。"},
        { "location": "321/TALK"    , "narrator": "みやび", "text": "つばめちゃんが\nスパイゆうんは、\nまだ未確定や。"},
        { "location": "322/TALK"    , "narrator": "みやび", "text": "なのに、いつの間にか\nスパイっちゅうことを\n前提に――"},
        { "location": "323/TALK"    , "narrator": "みやび", "text": "考えるように\nなっちょる…。"},
        { "location": "324/TALK"    , "narrator": "みやび", "text": "…最初っから\n決めつけて掛かったら\n真実なんぞ見えんな。"},
        { "location": "325/TALK"    , "narrator": "みやび", "text": "とにかく、\n今は落ち着かんと…。"},
        { "location": "326/SEL"     , "narrator": "", "text": "冷静になれた？"},
        { "location": "327/ACT"     , "narrator": "", "text": "冷静になれた？"},
        { "location": "344/TALK"    , "narrator": "みやび", "text": "うむ"},
        { "location": "345/TALK"    , "narrator": "みやび", "text": "今のうちは超クールやぞ"},
        { "location": "347/SEL"     , "narrator": "", "text": "それはよかった"},
        { "location": "348/ACT"     , "narrator": "", "text": "それはよかった"},
        { "location": "350/TALK"    , "narrator": "みやび", "text": "自分でも驚きや"},
        { "location": "351/TALK"    , "narrator": "みやび", "text": "自分の考えが間違っちょらんと"},
        { "location": "352/TALK"    , "narrator": "みやび", "text": "証拠もないのに信じとるとか"},
        { "location": "353/TALK"    , "narrator": "みやび", "text": "妄想と何も変わらん、いかんいかん"},
        { "location": "355/TALK"    , "narrator": "みやび", "text": "ちゅうか"},
        { "location": "356/TALK"    , "narrator": "みやび", "text": "唐突にクールになれたんが不思議なんやが"},
        { "location": "357/TALK"    , "narrator": "みやび", "text": "相棒の仕業か？"},
        { "location": "359/SEL"     , "narrator": "", "text": "きっかけを与えただけだよ"},
        { "location": "360/ACT"     , "narrator": "", "text": "きっかけを与えただけだよ"},
        { "location": "362/TALK"    , "narrator": "みやび", "text": "なるほど"},
        { "location": "364/TALK"    , "narrator": "みやび", "text": "相棒に助けられたようやね"},
        { "location": "365/TALK"    , "narrator": "みやび", "text": "ありがとな"},
        { "location": "367/TALK"    , "narrator": "みやび", "text": "またうちが変にムキになっとったら"},
        { "location": "368/TALK"    , "narrator": "みやび", "text": "その時はよろしくな"},
        { "location": "379/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "381/TALK"    , "narrator": "みやび", "text": "まほさん、\nそろそろうちも\n上がります。"},
        { "location": "383/TALK"    , "narrator": "真幌", "text": "そうか。\n今日もご苦労だった。"},
        { "location": "385/TALK"    , "narrator": "みやび", "text": "お疲れでしたー。"},
        { "location": "386/TALK"    , "narrator": "みやび", "text": "…銭湯にでも寄って、\n気持ち切り替えるか。"},
        { "location": "405/TALK"    , "narrator": "みやび", "text": "この時間になると、\n人が少なくて\n貸し切り状態やな。"},
        { "location": "406/TALK"    , "narrator": "透明神楽", "text": "じゃあ、手を上げて\nくださーい。"},
        { "location": "407/TALK"    , "narrator": "みやび", "text": "…卯月？\nなんや、来てたんか。"},
        { "location": "408/TALK"    , "narrator": "透明つばめ", "text": "ひやぁぁぁぁぁっ！！"},
        { "location": "409/TALK"    , "narrator": "透明神楽", "text": "あ、ごめんなさい。\n手が滑っちゃい\nました。"},
        { "location": "411/TALK"    , "narrator": "みやび", "text": "…何やってるが、\nあの子達？"},
        { "location": "412/TALK"    , "narrator": "みやび", "text": "…ちくっと待ってから\n入るか。"},
        { "location": "442/TALK"    , "narrator": "みやび", "text": "ふぅ…えい湯やねぇ。\n疲れが湯に染み出して\nいくようや…。"},
        { "location": "444/TALK"    , "narrator": "つばめ", "text": "そんなにお疲れなん\nですか？"},
        { "location": "446/TALK"    , "narrator": "みやび", "text": "そりゃそうやろ。\n学校にバイトに\n出撃やぞ？"},
        { "location": "448/TALK"    , "narrator": "みやび", "text": "休む暇ナッシングの、\nブラック企業真っ青な\n労働環境や。"},
        { "location": "450/TALK"    , "narrator": "つばめ", "text": "そうですか？\nわたし、ブラックには\n思いませんけど…。"},
        { "location": "451/TALK"    , "narrator": "神楽", "text": "私も、戦闘に関しては\n少し怖いですけど――"},
        { "location": "452/TALK"    , "narrator": "神楽", "text": "それ以外では、\n特にそうは感じま\nせん。"},
        { "location": "455/TALK"    , "narrator": "みやび", "text": "入隊したばっかで、\n新鮮に感じられちょる\nからやろうねぇ。"},
        { "location": "456/TALK"    , "narrator": "みやび", "text": "うちには、銭湯で\nじゃれ合ったりする\n元気は残っとらんよ。"},
        { "location": "458/TALK"    , "narrator": "つばめ", "text": "あ、あはは…、\n聞こえてたんですね。"},
        { "location": "459/TALK"    , "narrator": "みやび", "text": "声から判断して、\n卯月がセクハラ\nかましたんやろ？"},
        { "location": "461/TALK"    , "narrator": "神楽", "text": "スキンシップです！\n素敵な柔らかさ\nでした。"},
        { "location": "463/TALK"    , "narrator": "つばめ", "text": "い、言わないでよー！"},
        { "location": "465/TALK"    , "narrator": "みやび", "text": "まあ、仲がいいのは\nえいことやと思う\nけんど――"},
        { "location": "467/TALK"    , "narrator": "みやび", "text": "ああいうんは、\n銭湯でやらん方が\nえいと思うぞね。"},
        { "location": "473/TALK"    , "narrator": "つばめ", "text": "え、えっと…。"},
        { "location": "475/TALK"    , "narrator": "つばめ", "text": "あ、ああっ、そうだ。\nさっき劇場で――"},
        { "location": "476/TALK"    , "narrator": "つばめ", "text": "クランの皆さんと\n会ったんです。"},
        { "location": "477/TALK"    , "narrator": "みやび", "text": "そりゃ会うやろ。\nあそこはクランの家も\n兼ねてるきね。"},
        { "location": "478/TALK"    , "narrator": "つばめ", "text": "そうだったんですか？"},
        { "location": "480/TALK"    , "narrator": "みやび", "text": "なんや、まほさんから\nクランについて、\n何も聞いてないが？"},
        { "location": "483/TALK"    , "narrator": "つばめ", "text": "はい…卯月さんは？"},
        { "location": "486/TALK"    , "narrator": "神楽", "text": "私も聞いてません。"},
        { "location": "489/TALK"    , "narrator": "みやび", "text": "しゃあないなぁ…。\nなら――"},
        { "location": "490/TALK"    , "narrator": "みやび", "text": "うちが超簡単に、\nクランについての\n講義をしちゃるがよ。"},
        { "location": "493/TALK"    , "narrator": "つばめ", "text": "わぁ、ありがとう\nございます！"},
        { "location": "494/TALK"    , "narrator": "神楽", "text": "っていうか、\nここでするんですか？"},
        { "location": "495/TALK"    , "narrator": "神楽", "text": "公の場でするには、\n問題がありそうな\n話題なんじゃ…。"},
        { "location": "497/TALK"    , "narrator": "みやび", "text": "どうせ誰もおらんし、\nいたとしても――"},
        { "location": "498/TALK"    , "narrator": "みやび", "text": "アニメか漫画の話で\n盛り上がっちょる\nようにしか見えんよ。"},
        { "location": "499/TALK"    , "narrator": "みやび", "text": "じゃあ、まずは\n根本的な部分からの\n話やけんど――"},
        { "location": "500/TALK"    , "narrator": "みやび", "text": "クランとは何か？"},
        { "location": "505/TALK"    , "narrator": "つばめ", "text": "えっと…人間の魂が\n抜けだしたもの…、\nですよね？"},
        { "location": "507/TALK"    , "narrator": "みやび", "text": "それは知っちょる\nようやね。"},
        { "location": "508/TALK"    , "narrator": "みやび", "text": "で、そんな魂だけの\n丸裸な状態の\nクランを――"},
        { "location": "509/TALK"    , "narrator": "みやび", "text": "安全に保護できる\n特別な施設が、\nあの劇場ちや。"},
        { "location": "512/TALK"    , "narrator": "みやび", "text": "まあ、寂びれた古い\n劇場にしか見えん\nやろうけんど――"},
        { "location": "513/TALK"    , "narrator": "みやび", "text": "それ相応の特殊な\n造りになっちょる\nがよ。"},
        { "location": "515/TALK"    , "narrator": "つばめ", "text": "そ、そうだったん\nですか！"},
        { "location": "516/TALK"    , "narrator": "神楽", "text": "劇場兼秘密基地兼、\nクランのおうち…。"},
        { "location": "518/TALK"    , "narrator": "神楽", "text": "なんか、何でもあり\nって感じですね。"},
        { "location": "520/TALK"    , "narrator": "みやび", "text": "何でもありの方が\n秘密基地っぽくて\nワクワクするやろ？"},
        { "location": "522/TALK"    , "narrator": "つばめ", "text": "あ、あの！\n質問いいですか、\nみやび先生！？"},
        { "location": "525/TALK"    , "narrator": "みやび", "text": "うむ、許可する。\n言うてみぃ。"},
        { "location": "526/TALK"    , "narrator": "つばめ", "text": "その、クランを\n安全に保護するための\n特殊な造りって――"},
        { "location": "527/TALK"    , "narrator": "つばめ", "text": "具体的には\nどういったもの\nなんですか！？"},
        { "location": "530/TALK"    , "narrator": "みやび", "text": "うむ、知らん！"},
        { "location": "532/TALK"    , "narrator": "つばめ", "text": "えぇっ！？"},
        { "location": "535/TALK"    , "narrator": "みやび", "text": "ちゅうか、そんなもん\n知りたいと思うた\nこともなかったちや。"},
        { "location": "536/TALK"    , "narrator": "みやび", "text": "つばめちゃんは、\n建物の構造なんぞが\n気になるが？"},
        { "location": "538/TALK"    , "narrator": "つばめ", "text": "特殊っていうから、\nちょっと気になった\n程度ですけど…。"},
        { "location": "540/TALK"    , "narrator": "みやび", "text": "なら、うちらには\n理解の及ばん――"},
        { "location": "541/TALK"    , "narrator": "みやび", "text": "超技術が使われて\n作られちょる思うて\nおけばえいがよ。"},
        { "location": "542/TALK"    , "narrator": "みやび", "text": "その方が、秘密基地\nっぽくてえいやろ？"},
        { "location": "544/TALK"    , "narrator": "つばめ", "text": "うーん…。"},
        { "location": "547/TALK"    , "narrator": "神楽", "text": "…あの、私もさっき\nからずっと気になる\nことがあるんです。"},
        { "location": "548/TALK"    , "narrator": "みやび", "text": "言うてみ。"},
        { "location": "552/TALK"    , "narrator": "神楽", "text": "それです！\nみやびさんのその…、\n胸です！"},
        { "location": "553/TALK"    , "narrator": "みやび", "text": "…うちの胸じゃ、\nクランの保護は\nできんと思うがよ？"},
        { "location": "556/TALK"    , "narrator": "神楽", "text": "そうじゃなくて！"},
        { "location": "557/TALK"    , "narrator": "神楽", "text": "さっきから、\nみやびさんが\n動くたびに――"},
        { "location": "558/TALK"    , "narrator": "神楽", "text": "目の前で凄い揺れて、\n気になるんです！"},
        { "location": "560/TALK"    , "narrator": "つばめ", "text": "…そういえば、\nさっきからずっと\n動いてたような。"},
        { "location": "562/TALK"    , "narrator": "みやび", "text": "そりゃ動くやろ。\n身体から垂れ下がっ\nちょるんやき。"},
        { "location": "563/TALK"    , "narrator": "神楽", "text": "ていうか、\n大き過ぎです！"},
        { "location": "564/TALK"    , "narrator": "神楽", "text": "みやびさん、\n何センチあるん\nですか？"},
        { "location": "566/TALK"    , "narrator": "みやび", "text": "…手のひらから\nはみ出る程度、とだけ\n言うておこう。"},
        { "location": "568/TALK"    , "narrator": "つばめ", "text": "て、手のひらから\nはみ出るって…。"},
        { "location": "569/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "570/TALK"    , "narrator": "みやび", "text": "女の子の胸に\n興味あるなら、\n触ってもえいよ。"},
        { "location": "573/TALK"    , "narrator": "神楽", "text": "失礼な！\nみやびさんと比べたら\n小さいですけど――"},
        { "location": "574/TALK"    , "narrator": "神楽", "text": "私たちだって\n女の子です！"},
        { "location": "576/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "578/TALK"    , "narrator": "つばめ", "text": "や、やっぱり、\n触るのはいいです！"},
        { "location": "580/TALK"    , "narrator": "みやび", "text": "タダやぞ？"},
        { "location": "581/TALK"    , "narrator": "つばめ", "text": "でも、何だか\n緊張しちゃって…。"},
        { "location": "583/TALK"    , "narrator": "みやび", "text": "…卯月は？"},
        { "location": "585/TALK"    , "narrator": "神楽", "text": "遠慮します。\n欲しい気持ちが\n膨れ上がって――"},
        { "location": "586/TALK"    , "narrator": "神楽", "text": "引っ張っちゃうかも\nしれないので。"},
        { "location": "589/TALK"    , "narrator": "みやび", "text": "はぁ…こんなもんが\nほしいとか、\n理解できんなぁ。"},
        { "location": "590/TALK"    , "narrator": "みやび", "text": "重くて邪魔なだけで、\n何のメリットもない\n贅肉の塊やぞ？"},
        { "location": "593/TALK"    , "narrator": "つばめ", "text": "そ、それでも、\nちょっとくらいは\n欲しいですよ…。"},
        { "location": "595/TALK"    , "narrator": "神楽", "text": "そうです！\nなのに、重いとか\n邪魔だとか――"},
        { "location": "596/TALK"    , "narrator": "神楽", "text": "胸の大きい人は、\nいつも決まって\nそう言いますよね？"},
        { "location": "599/TALK"    , "narrator": "みやび", "text": "…小さい人も、\nいつもそう返して\nくるきね。"},
        { "location": "601/TALK"    , "narrator": "神楽", "text": "わ、私は小さいかも\nしれませんけど――"},
        { "location": "603/TALK"    , "narrator": "神楽", "text": "つばめさんは\n十分大きいです！"},
        { "location": "605/TALK"    , "narrator": "つばめ", "text": "そ、そうです！\nわたしは――"},
        { "location": "608/TALK"    , "narrator": "つばめ", "text": "って、えぇっ！？"},
        { "location": "609/TALK"    , "narrator": "神楽", "text": "つばめさんって、\n着痩せするタイプ\nなんですね。"},
        { "location": "611/TALK"    , "narrator": "つばめ", "text": "ちょ、卯月さん。\n恥ずかしいよぉ…。"},
        { "location": "613/TALK"    , "narrator": "みやび", "text": "…まっことこの二人、\n仲えいなぁ…。"},
        { "location": "624/DIALOG"  , "narrator": "Dialog_chapter_ch04", "text": "【06 史上最愛の作戦】"}
    ]
}
