{
    "dir": "chap32/daydra/dd_ch02_32_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "32205",
        "cid": "ayami",
        "title": "005 メインストーリー",
        "sub_title": "偶然は運命にも似て＜後編＞"
    },
    "entry":
    [
        { "location": "636/SCENARIO", "narrator": "", "text": "全ての偶然は運命にも似て"},
        { "location": "672/TALK"    , "narrator": "みやび", "text": "順調に文京ドームへ\n進んじゅう。"},
        { "location": "673/TALK"    , "narrator": "みやび", "text": "スピード以外は\n意外と安全運転かも\nしれんねえ…。"},
        { "location": "676/TALK"    , "narrator": "ガブリエラ", "text": "そんなのいやよ！\nせめてスピードを\n落とせないの？"},
        { "location": "677/TALK"    , "narrator": "アーヤ", "text": "止められれば\n何とかなる…！？"},
        { "location": "678/TALK"    , "narrator": "アーヤ", "text": "…あっ…！\nサイドブレーキ…！？"},
        { "location": "679/SEL"     , "narrator": "", "text": "ここ高速だよ！"},
        { "location": "680/SEL"     , "narrator": "", "text": "スピード出過ぎてるし！"},
        { "location": "681/ACT"     , "narrator": "", "text": "ここ高速だよ！"},
        { "location": "682/ACT"     , "narrator": "", "text": "スピード出過ぎてるし！"},
        { "location": "687/TALK"    , "narrator": "ガブリエラ", "text": "できるの！？"},
        { "location": "690/TALK"    , "narrator": "アーヤ", "text": "…いまのスピードだと\n却って危ないわ。\nそれは無理よ！"},
        { "location": "694/TALK"    , "narrator": "アーヤ", "text": "じゃあ\nどうすれば…！？"},
        { "location": "695/SEL"     , "narrator": "", "text": "まず落ち着こう"},
        { "location": "696/ACT"     , "narrator": "", "text": "まず落ち着こう"},
        { "location": "700/TALK"    , "narrator": "アーヤ", "text": "私以外に運転ができる\n人はいないんだから…。"},
        { "location": "701/SEL"     , "narrator": "", "text": "アーヤ"},
        { "location": "702/SEL"     , "narrator": "", "text": "深呼吸して"},
        { "location": "703/ACT"     , "narrator": "", "text": "アーヤ"},
        { "location": "704/ACT"     , "narrator": "", "text": "深呼吸して"},
        { "location": "708/TALK"    , "narrator": "アーヤ", "text": "冷静にならなきゃ…。"},
        { "location": "709/SEL"     , "narrator": "", "text": "落ち着けば大丈夫"},
        { "location": "710/ACT"     , "narrator": "", "text": "落ち着けば大丈夫"},
        { "location": "714/TALK"    , "narrator": "アーヤ", "text": "あ"},
        { "location": "720/TALK"    , "narrator": "アーヤ", "text": "メッセージ"},
        { "location": "722/SEL"     , "narrator": "", "text": "何度もしたよ"},
        { "location": "723/SEL"     , "narrator": "", "text": "気付いてくれてよかった"},
        { "location": "724/ACT"     , "narrator": "", "text": "何度もしたよ"},
        { "location": "725/TALK"    , "narrator": "アーヤ", "text": "してたの"},
        { "location": "726/ACT"     , "narrator": "", "text": "気付いてくれてよかった"},
        { "location": "727/TALK"    , "narrator": "アーヤ", "text": "今ね"},
        { "location": "729/TALK"    , "narrator": "アーヤ", "text": "$handle$さんは"},
        { "location": "730/TALK"    , "narrator": "アーヤ", "text": "味方よね"},
        { "location": "732/SEL"     , "narrator": "", "text": "当たり前でしょ"},
        { "location": "733/SEL"     , "narrator": "", "text": "なんで疑うかな"},
        { "location": "734/SEL"     , "narrator": "", "text": "他のポジションはないよ"},
        { "location": "735/ACT"     , "narrator": "", "text": "当たり前でしょ"},
        { "location": "736/TALK"    , "narrator": "アーヤ", "text": "そうよ"},
        { "location": "737/ACT"     , "narrator": "", "text": "なんで疑うかな"},
        { "location": "738/TALK"    , "narrator": "アーヤ", "text": "わからない"},
        { "location": "739/ACT"     , "narrator": "", "text": "他のポジションはないよ"},
        { "location": "740/TALK"    , "narrator": "アーヤ", "text": "だったわ"},
        { "location": "742/TALK"    , "narrator": "アーヤ", "text": "たすけて"},
        { "location": "743/TALK"    , "narrator": "アーヤ", "text": "わたｓ"},
        { "location": "744/TALK"    , "narrator": "アーヤ", "text": "しにたくない"},
        { "location": "746/SEL"     , "narrator": "", "text": "死なせない"},
        { "location": "747/SEL"     , "narrator": "", "text": "落ち着いて"},
        { "location": "748/SEL"     , "narrator": "", "text": "大丈夫だから"},
        { "location": "749/ACT"     , "narrator": "", "text": "死なせない"},
        { "location": "750/TALK"    , "narrator": "アーヤ", "text": "はい"},
        { "location": "751/ACT"     , "narrator": "", "text": "落ち着いて"},
        { "location": "752/TALK"    , "narrator": "アーヤ", "text": "おちつくわ"},
        { "location": "753/ACT"     , "narrator": "", "text": "大丈夫だから"},
        { "location": "754/TALK"    , "narrator": "アーヤ", "text": "大丈夫よね"},
        { "location": "757/SEL"     , "narrator": "", "text": "まず車内の装備を確認して"},
        { "location": "758/ACT"     , "narrator": "", "text": "まず車内の装備を確認して"},
        { "location": "759/TALK"    , "narrator": "アーヤ", "text": "ｗかったわ"},
        { "location": "766/TALK"    , "narrator": "アーヤ", "text": "二人とも。"},
        { "location": "767/TALK"    , "narrator": "アーヤ", "text": "アーケロンに\n何を積んだか\n憶えてる？"},
        { "location": "768/TALK"    , "narrator": "ガブリエラ", "text": "武器。\n対人用の武器を\n大量に積んだわ。"},
        { "location": "769/TALK"    , "narrator": "みやび", "text": "あとは音羽やね。"},
        { "location": "770/TALK"    , "narrator": "アーヤ", "text": "後は？"},
        { "location": "772/TALK"    , "narrator": "みやび", "text": "あ。"},
        { "location": "774/TALK"    , "narrator": "みやび", "text": "元々の装備に\n脱出用のポッドがある\nはずやけんど。"},
        { "location": "776/TALK"    , "narrator": "ガブリエラ", "text": "それ！\nまさに今\n使うものじゃない！？"},
        { "location": "777/TALK"    , "narrator": "アーヤ", "text": "じゃあポッドで…。"},
        { "location": "778/TALK"    , "narrator": "みやび", "text": "けんど、ポッドも\n乗っ取られとる\n可能性がある。"},
        { "location": "779/TALK"    , "narrator": "アーヤ", "text": "あ…。"},
        { "location": "781/TALK"    , "narrator": "ガブリエラ", "text": "じゃあここから\n脱出するには\n飛び降りるしかないの？"},
        { "location": "782/TALK"    , "narrator": "アーヤ", "text": "１２０キロ出てるのよ？\nそんなことしたら…！"},
        { "location": "783/SEL"     , "narrator": "", "text": "話は聞いた"},
        { "location": "784/ACT"     , "narrator": "", "text": "話は聞いた"},
        { "location": "795/TALK"    , "narrator": "アーヤ", "text": "しぬ"},
        { "location": "796/TALK"    , "narrator": "アーヤ", "text": "しにたくない"},
        { "location": "798/SEL"     , "narrator": "", "text": "焦らないで"},
        { "location": "799/SEL"     , "narrator": "", "text": "落ち着いて"},
        { "location": "800/SEL"     , "narrator": "", "text": "テンパりすぎ"},
        { "location": "801/ACT"     , "narrator": "", "text": "焦らないで"},
        { "location": "802/TALK"    , "narrator": "アーヤ", "text": "はい"},
        { "location": "803/ACT"     , "narrator": "", "text": "落ち着いて"},
        { "location": "804/TALK"    , "narrator": "アーヤ", "text": "でも"},
        { "location": "805/ACT"     , "narrator": "", "text": "テンパりすぎ"},
        { "location": "806/TALK"    , "narrator": "アーヤ", "text": "だって"},
        { "location": "809/SEL"     , "narrator": "", "text": "アーヤはリーダーでしょ"},
        { "location": "810/SEL"     , "narrator": "", "text": "アーヤが指揮を執らなきゃ"},
        { "location": "811/SEL"     , "narrator": "", "text": "アーヤが一番お姉さんでしょ"},
        { "location": "812/ACT"     , "narrator": "", "text": "アーヤはリーダーでしょ"},
        { "location": "813/TALK"    , "narrator": "アーヤ", "text": "そうだけど"},
        { "location": "814/ACT"     , "narrator": "", "text": "アーヤが指揮を執らなきゃ"},
        { "location": "815/TALK"    , "narrator": "アーヤ", "text": "とらなきゃいけないの"},
        { "location": "816/ACT"     , "narrator": "", "text": "アーヤが一番お姉さんでしょ"},
        { "location": "817/TALK"    , "narrator": "アーヤ", "text": "年はそうね"},
        { "location": "820/SEL"     , "narrator": "", "text": "みんなに見本を見せなきゃ"},
        { "location": "821/SEL"     , "narrator": "", "text": "士気向上はリーダーの役目"},
        { "location": "822/SEL"     , "narrator": "", "text": "格好いいアーヤでいようよ"},
        { "location": "823/ACT"     , "narrator": "", "text": "みんなに見本を見せなきゃ"},
        { "location": "824/TALK"    , "narrator": "アーヤ", "text": "そう"},
        { "location": "826/TALK"    , "narrator": "アーヤ", "text": "そうね"},
        { "location": "827/ACT"     , "narrator": "", "text": "士気向上はリーダーの役目"},
        { "location": "828/TALK"    , "narrator": "アーヤ", "text": "私リーダーだわ"},
        { "location": "829/ACT"     , "narrator": "", "text": "格好いいアーヤでいようよ"},
        { "location": "830/TALK"    , "narrator": "アーヤ", "text": "そんな"},
        { "location": "831/TALK"    , "narrator": "アーヤ", "text": "でも大事"},
        { "location": "834/SEL"     , "narrator": "", "text": "つばめを助けるんでしょ"},
        { "location": "835/SEL"     , "narrator": "", "text": "神楽のこと信じるんでしょ"},
        { "location": "836/SEL"     , "narrator": "", "text": "みんなで助からなきゃ"},
        { "location": "837/ACT"     , "narrator": "", "text": "つばめを助けるんでしょ"},
        { "location": "838/TALK"    , "narrator": "アーヤ", "text": "助けるわ"},
        { "location": "839/ACT"     , "narrator": "", "text": "神楽のこと信じるんでしょ"},
        { "location": "840/TALK"    , "narrator": "アーヤ", "text": "信じたいの"},
        { "location": "841/ACT"     , "narrator": "", "text": "みんなで助からなきゃ"},
        { "location": "842/TALK"    , "narrator": "アーヤ", "text": "それって大事なことよね"},
        { "location": "845/SEL"     , "narrator": "", "text": "ベストを尽くそう"},
        { "location": "846/SEL"     , "narrator": "", "text": "諦めるには早いよ"},
        { "location": "847/SEL"     , "narrator": "", "text": "まだできることはあるはず"},
        { "location": "848/ACT"     , "narrator": "", "text": "ベストを尽くそう"},
        { "location": "849/TALK"    , "narrator": "アーヤ", "text": "わかったわ"},
        { "location": "850/ACT"     , "narrator": "", "text": "諦めるには早いよ"},
        { "location": "851/TALK"    , "narrator": "アーヤ", "text": "そうよね"},
        { "location": "852/ACT"     , "narrator": "", "text": "まだできることはあるはず"},
        { "location": "853/TALK"    , "narrator": "アーヤ", "text": "そうだったわ"},
        { "location": "855/TALK"    , "narrator": "アーヤ", "text": "ありがとう"},
        { "location": "856/TALK"    , "narrator": "アーヤ", "text": "もう少し色々やってみる"},
        { "location": "857/TALK"    , "narrator": "アーヤ", "text": "$handle$さんがいてくれて"},
        { "location": "859/TALK"    , "narrator": "アーヤ", "text": "よかった"},
        { "location": "864/TALK"    , "narrator": "アーヤ", "text": "もしトライガジェットが\nなかったら\n$handle$さんとは…。"},
        { "location": "865/TALK"    , "narrator": "アーヤ", "text": "…あ！"},
        { "location": "866/TALK"    , "narrator": "みやび", "text": "どういた？\nポッドの活用法でも\n見つかったかね？"},
        { "location": "869/TALK"    , "narrator": "アーヤ", "text": "トライコネクト！\nこれを脱出の手段に\n使えないかしら？"},
        { "location": "871/TALK"    , "narrator": "ガブリエラ", "text": "え？\nそんなことできるの？"},
        { "location": "872/TALK"    , "narrator": "みやび", "text": "…確かに。\n今ならできるね。"},
        { "location": "873/TALK"    , "narrator": "みやび", "text": "音羽用にシステムを\n改造したき。"},
        { "location": "875/TALK"    , "narrator": "アーヤ", "text": "みやびがそう言うなら\n大丈夫よね。"},
        { "location": "876/TALK"    , "narrator": "みやび", "text": "落ち着き。\nあくまで理論上はって\nだけやき。"},
        { "location": "877/TALK"    , "narrator": "みやび", "text": "本番前に一度\n試してみんと。"},
        { "location": "878/TALK"    , "narrator": "ガブリエラ", "text": "今？"},
        { "location": "879/TALK"    , "narrator": "アーヤ", "text": "今しかないわね。"},
        { "location": "880/TALK"    , "narrator": "みやび", "text": "すぐ準備するきね。"},
        { "location": "883/TALK"    , "narrator": "アーヤ", "text": "$handle$さん\n本当にありがとう。"},
        { "location": "884/TALK"    , "narrator": "アーヤ", "text": "貴方は私の…。\nううん、私達の\n守護者ね。"},
        { "location": "885/TALK"    , "narrator": "アーヤ", "text": "もう疑ったりなんて\nしない。\nだから見守ってて…。"},
        { "location": "916/TALK"    , "narrator": "アーヤ", "text": "後はタイミングを\n計るだけね。"},
        { "location": "919/TALK"    , "narrator": "ガブリエラ", "text": "みやび、準備は\nどうなのよ？"},
        { "location": "921/TALK"    , "narrator": "みやび", "text": "脱出ポッドの\n射出準備ならとっくに\nできちゅうき。"},
        { "location": "922/TALK"    , "narrator": "みやび", "text": "それより二人は\nコネクトこじゃんと\nせんといかんよ。"},
        { "location": "923/TALK"    , "narrator": "アーヤ", "text": "もちろんよ。"},
        { "location": "924/TALK"    , "narrator": "ガブリエラ", "text": "当たり前でしょ。"},
        { "location": "925/TALK"    , "narrator": "アーヤ", "text": "それよりやっぱり\nスピードを落とす気は\nないみたいよ。"},
        { "location": "926/TALK"    , "narrator": "アーヤ", "text": "このまま文京ドームに\n突っ込ませる気\n満々ね。"},
        { "location": "927/TALK"    , "narrator": "みやび", "text": "脱出のタイミングは\nさっきの打ち合わせ\n通りに頼むちや。"},
        { "location": "928/TALK"    , "narrator": "ガブリエラ", "text": "オッケー。"},
        { "location": "929/TALK"    , "narrator": "アーヤ", "text": "何かあったら\nフォローするわ。"},
        { "location": "930/TALK"    , "narrator": "アーヤ", "text": "でも私、二人のこと\n信じてるから。"},
        { "location": "932/TALK"    , "narrator": "みやび", "text": "…泣かせるね。\nさすがはリーダーやき。"},
        { "location": "933/TALK"    , "narrator": "アーヤ", "text": "からかわないで。"},
        { "location": "939/TALK"    , "narrator": "みやび", "text": "…ＧＰＳ脱出目標まで\n１００ｍ。"},
        { "location": "940/TALK"    , "narrator": "みやび", "text": "５０ｍ。"},
        { "location": "941/TALK"    , "narrator": "みやび", "text": "３０ｍ。"},
        { "location": "942/TALK"    , "narrator": "みやび", "text": "２０ｍ。"},
        { "location": "943/TALK"    , "narrator": "みやび", "text": "１０ｍ。"},
        { "location": "945/TALK"    , "narrator": "アーヤ", "text": "$handle$さん\nありがとう……。"},
        { "location": "960/DIALOG"  , "narrator": "Dialog_chapter_ch02", "text": "【26 ホワイト・マイル】"}
    ]
}
