    "entry":
    [
        { "location": "160/SCENARIO", "narrator": "", "text": "040_故郷の風"},
        { "location": "186/TALK"    , "narrator": "ガブリエラ", "text": "ふるさとは遠きにありて思ふもの"},
        { "location": "187/TALK"    , "narrator": "ガブリエラ", "text": "そして悲しくうたふもの"},
        { "location": "189/SEL"     , "narrator": "", "text": "宿題でも出たの？"},
        { "location": "190/SEL"     , "narrator": "", "text": "ホームシックなのかな"},
        { "location": "191/SEL"     , "narrator": "", "text": "遠きみやこにかへらばや"},
        { "location": "192/TALK"    , "narrator": "ガブリエラ", "text": "こんな平仮名の使い方してたら読みにくくて仕方がないわよね"},
        { "location": "194/TALK"    , "narrator": "ガブリエラ", "text": "旧仮名遣いって言うらしいけど"},
        { "location": "206/ACT"     , "narrator": "", "text": "宿題でも出たの？"},
        { "location": "207/TALK"    , "narrator": "ガブリエラ", "text": "マルザンナったら・・・"},
        { "location": "209/TALK"    , "narrator": "ガブリエラ", "text": "そういうわけじゃないわ"},
        { "location": "210/TALK"    , "narrator": "ガブリエラ", "text": "少しだけこういう気分なだけなの"},
        { "location": "211/ACT"     , "narrator": "", "text": "ホームシックなのかな"},
        { "location": "222/TALK"    , "narrator": "ガブリエラ", "text": "マルザンナにはなんでもわかっちゃうのね"},
        { "location": "223/TALK"    , "narrator": "ガブリエラ", "text": "でも平気よ、ここにはマルザンナがいるものね"},
        { "location": "224/ACT"     , "narrator": "", "text": "遠きみやこにかへらばや"},
        { "location": "225/TALK"    , "narrator": "ガブリエラ", "text": "マルザンナも知ってるのね"},
        { "location": "226/TALK"    , "narrator": "ガブリエラ", "text": "それにしてもこの人、故郷と都のどっちにいるのかしら？"},
        { "location": "228/TALK"    , "narrator": "ガブリエラ", "text": "不思議よね"},
        { "location": "229/TALK"    , "narrator": "ガブリエラ", "text": "どうしても、って言って、いっぱい喧嘩して、やっと日本に来たのに"},
        { "location": "230/TALK"    , "narrator": "ガブリエラ", "text": "朝起きたらワルシャワじゃないことに気がついてがっかりするなんて"},
        { "location": "231/TALK"    , "narrator": "ガブリエラ", "text": "そんなこと・・・"},
        { "location": "232/TALK"    , "narrator": "ガブリエラ", "text": "向こうにいるときには・・・"},
        { "location": "233/TALK"    , "narrator": "ガブリエラ", "text": "考えもしなかったのに・・・"},
        { "location": "236/SEL"     , "narrator": "", "text": "元気出して"},
        { "location": "237/SEL"     , "narrator": "", "text": "日本には$handle$がいるよ"},
        { "location": "239/ACT"     , "narrator": "", "text": "元気出して"},
        { "location": "240/TALK"    , "narrator": "ガブリエラ", "text": "・・・うん・・・"},
        { "location": "241/TALK"    , "narrator": "ガブリエラ", "text": "そうだわね・・・"},
        { "location": "242/TALK"    , "narrator": "ガブリエラ", "text": "がんばんなきゃ、だね・・・"},
        { "location": "243/ACT"     , "narrator": "", "text": "日本には$handle$がいるよ"},
        { "location": "253/TALK"    , "narrator": "ガブリエラ", "text": "もう！"},
        { "location": "255/TALK"    , "narrator": "ガブリエラ", "text": "マルザンナったら、冗談ばっかり"},
        { "location": "256/TALK"    , "narrator": "ガブリエラ", "text": "$handle$なんて名前、どこから思いついたのかしら？"},
        { "location": "257/TALK"    , "narrator": "ガブリエラ", "text": "でも少し元気が出たわ"},
        { "location": "259/TALK"    , "narrator": "ガブリエラ", "text": "今日はもう寝るわね"},
        { "location": "261/SEL"     , "narrator": "", "text": "おやすみなさい"},
        { "location": "262/ACT"     , "narrator": "", "text": "おやすみなさい"},
        { "location": "264/TALK"    , "narrator": "ガブリエラ", "text": "おやすみなさい"},
        { "location": "218/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>500pt.</b></color></size>\nアップしました！"},
        { "location": "249/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>500pt.</b></color></size>\nアップしました！"}
