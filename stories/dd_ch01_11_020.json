{
    "dir": "chap11/daydra/dd_ch01_11_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "11156",
        "cid": "tsubame",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "手作りおにぎり"
    },
    "entry":
    [
        { "location": "360/SCENARIO", "narrator": "", "text": "手作りおにぎり"},
        { "location": "375/TALK"    , "narrator": "雛", "text": "あっ、つばめちゃんの\nお弁当、おにぎりなんだ？"},
        { "location": "378/TALK"    , "narrator": "つばめ", "text": "うん、余ってたご飯で\n作ってきたんだ。"},
        { "location": "379/TALK"    , "narrator": "キリト", "text": "けど、ちょっとデカくね？\n逢瀬っておにぎり作るの\n苦手なのか？"},
        { "location": "381/TALK"    , "narrator": "つばめ", "text": "卵焼きを入れてるから、\nどうしても大きく\nなっちゃうの。"},
        { "location": "382/TALK"    , "narrator": "キリト", "text": "…は？\nおにぎりの中に\n入ってるのか？"},
        { "location": "386/TALK"    , "narrator": "つばめ", "text": "うん。\nこれ、わたしが子供の頃に\n思いついたおにぎりで――"},
        { "location": "387/TALK"    , "narrator": "つばめ", "text": "幼稚園のお弁当にも、\nよく持っていったんだ。"},
        { "location": "389/TALK"    , "narrator": "雛", "text": "う～ん…ご飯と卵だから\n不味くはないと\n思うけど…。"},
        { "location": "390/TALK"    , "narrator": "キリト", "text": "絶対別々に食った方が\n美味いと思うぞ？"},
        { "location": "391/TALK"    , "narrator": "つばめ", "text": "そ、そんなことないよ。"},
        { "location": "392/TALK"    , "narrator": "つばめ", "text": "別々に食べてもいいけど、\n一緒に食べると、すっごく\n美味しいんだよ？"},
        { "location": "393/TALK"    , "narrator": "繭", "text": "少し大げさだと思う。"},
        { "location": "395/TALK"    , "narrator": "つばめ", "text": "そんなことないよ。\n本当に美味しいんだから。"},
        { "location": "396/TALK"    , "narrator": "キリト", "text": "そう言われてもなぁ…。"},
        { "location": "397/TALK"    , "narrator": "キリト", "text": "卵焼きじゃなくて、\n唐揚げとかなら\nまだわかるけどさ。"},
        { "location": "399/TALK"    , "narrator": "繭", "text": "コンビニで見たことある。\nあれなら美味しそう。"},
        { "location": "402/TALK"    , "narrator": "雛", "text": "温めてから食べると\nすっごく美味しいんだよ。"},
        { "location": "404/TALK"    , "narrator": "キリト", "text": "へぇ、今度買って\nみようかな？"},
        { "location": "406/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "427/TALK"    , "narrator": "つばめ", "text": "ショックだよー"},
        { "location": "430/SEL"     , "narrator": "", "text": "唐揚げに負けたね"},
        { "location": "431/ACT"     , "narrator": "", "text": "唐揚げに負けたね"},
        { "location": "433/TALK"    , "narrator": "つばめ", "text": "うん"},
        { "location": "434/TALK"    , "narrator": "つばめ", "text": "卵焼きのおにぎり、凄く美味しいんだよ？"},
        { "location": "435/TALK"    , "narrator": "つばめ", "text": "小さいころからずっと好きなのに…"},
        { "location": "436/TALK"    , "narrator": "つばめ", "text": "そんなに変じゃないよね？"},
        { "location": "438/SEL"     , "narrator": "", "text": "珍しいけど変じゃない"},
        { "location": "439/SEL"     , "narrator": "", "text": "ちょっとゲテモノかも"},
        { "location": "440/SEL"     , "narrator": "", "text": "食べてみたい"},
        { "location": "441/ACT"     , "narrator": "", "text": "珍しいけど変じゃない"},
        { "location": "442/TALK"    , "narrator": "つばめ", "text": "やっぱりそうだよね？"},
        { "location": "443/TALK"    , "narrator": "つばめ", "text": "珍しいけど、変じゃないよね？"},
        { "location": "454/ACT"     , "narrator": "", "text": "ちょっとゲテモノかも"},
        { "location": "455/TALK"    , "narrator": "つばめ", "text": "そんなことないもん！"},
        { "location": "456/TALK"    , "narrator": "つばめ", "text": "ただの卵焼きを、ご飯で普通に包んでるだけなんだし"},
        { "location": "457/TALK"    , "narrator": "つばめ", "text": "…でも、みんなもそんな風に見てるのかな？"},
        { "location": "458/TALK"    , "narrator": "つばめ", "text": "もしそうなら、ちょっと悲しいよ…"},
        { "location": "469/ACT"     , "narrator": "", "text": "食べてみたい"},
        { "location": "471/TALK"    , "narrator": "つばめ", "text": "本当！？"},
        { "location": "472/TALK"    , "narrator": "つばめ", "text": "そう言ってもらえると嬉しいよ"},
        { "location": "474/TALK"    , "narrator": "つばめ", "text": "わたしも、$handle$さんに作ってあげたいな"},
        { "location": "486/TALK"    , "narrator": "つばめ", "text": "…多めに作ってきたの、\n失敗だったみたい。"},
        { "location": "489/TALK"    , "narrator": "雛", "text": "ねえ、つばめちゃん。"},
        { "location": "490/TALK"    , "narrator": "雛", "text": "そのおにぎりだけど、\n一つ食べていい？"},
        { "location": "492/TALK"    , "narrator": "つばめ", "text": "えっ？"},
        { "location": "494/TALK"    , "narrator": "キリト", "text": "ひなこ、もしかして\n気になってたのか？"},
        { "location": "496/TALK"    , "narrator": "雛", "text": "まあねー。\n味は大体想像つくけど――"},
        { "location": "497/TALK"    , "narrator": "雛", "text": "つばめちゃんがそこまで\n美味しいっていうなら、\n食べてみようかな、って。"},
        { "location": "498/TALK"    , "narrator": "つばめ", "text": "ありがとう！\nそれじゃ、どれでも\n好きなの選んで。"},
        { "location": "500/TALK"    , "narrator": "雛", "text": "じゃあ、中くらいの\n大きさのを…。\nいただきまーす！"},
        { "location": "502/TALK"    , "narrator": "雛", "text": "はむっ！　んむんむ…。"},
        { "location": "503/TALK"    , "narrator": "つばめ", "text": "ど、どうかな？"},
        { "location": "505/TALK"    , "narrator": "雛", "text": "あっ…これ、思ってたより\n美味しいかも。"},
        { "location": "507/TALK"    , "narrator": "つばめ", "text": "やったぁ！"},
        { "location": "509/TALK"    , "narrator": "キリト", "text": "マジかよ？\nただの卵焼きが入った\nおにぎりだろ？"},
        { "location": "512/TALK"    , "narrator": "雛", "text": "そうなんだけど…\n卵焼きの中が半焼きに\nなっててね――"},
        { "location": "513/TALK"    , "narrator": "雛", "text": "齧ると中身が広がって、\n卵かけごはんみたいな\n味になるの。"},
        { "location": "514/TALK"    , "narrator": "繭", "text": "…想像つかないんだけど？"},
        { "location": "515/TALK"    , "narrator": "つばめ", "text": "まだまだあるから、\n二人も食べてみて。"},
        { "location": "520/TALK"    , "narrator": "キリト", "text": "お、おう…\nじゃあ、いただくぜ。"},
        { "location": "522/TALK"    , "narrator": "繭", "text": "…いただきます。\nあむっ。"},
        { "location": "523/TALK"    , "narrator": "つばめ", "text": "……どうかな？"},
        { "location": "525/TALK"    , "narrator": "キリト", "text": "やべぇ…\nマジで結構イケる。"},
        { "location": "526/TALK"    , "narrator": "繭", "text": "想像してたより甘くて、\n美味しい…落ち着く味。"},
        { "location": "527/TALK"    , "narrator": "つばめ", "text": "ね、美味しいでしょ！？"},
        { "location": "528/TALK"    , "narrator": "つばめ", "text": "一度食べてもらえれば\nわかってもらえると\n思ってたよ。"},
        { "location": "529/TALK"    , "narrator": "雛", "text": "つばめちゃん、\nおかわりしていい？"},
        { "location": "531/TALK"    , "narrator": "つばめ", "text": "うん、もちろん！\nいっぱいあるから\nみんなもおかわりしてね。"},
        { "location": "533/TALK"    , "narrator": "キリト", "text": "…なんか、納得いかねぇ\nのは俺だけか？"},
        { "location": "536/TALK"    , "narrator": "繭", "text": "私もだけど、\n美味しいのは\n事実なんだから――"},
        { "location": "537/TALK"    , "narrator": "繭", "text": "受け止める以外に\nないわ。"},
        { "location": "373/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>6月28日　12:07 PM</color>\n昼休み、学食にて。"}
    ]
}
