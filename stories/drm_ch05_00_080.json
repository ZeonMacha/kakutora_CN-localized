    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "フェノメノンという現象について"},
        { "location": "22/TALK"   , "narrator": "アーヤ", "text": "二人ともお疲れさま。\n体調はどう？\n怪我とかしてない？"},
        { "location": "24/TALK"   , "narrator": "つばめ", "text": "はい！\n大丈夫です！"},
        { "location": "26/TALK"   , "narrator": "アーヤ", "text": "卯月はどう？"},
        { "location": "27/TALK"   , "narrator": "神楽", "text": "…大丈夫です。"},
        { "location": "28/TALK"   , "narrator": "アーヤ", "text": "無理しないで…って\n言えないのが辛い\nところだけど。"},
        { "location": "29/TALK"   , "narrator": "アーヤ", "text": "できるだけ\nフォローしたいと\n思ってるから。"},
        { "location": "30/TALK"   , "narrator": "つばめ", "text": "アーヤさん…。"},
        { "location": "32/TALK"   , "narrator": "アーヤ", "text": "じゃあちょっと\nギャヴィとみやびの\nところに行ってくるわ。"},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "後はゆっくり\n休んでね。"},
        { "location": "37/TALK"   , "narrator": "神楽", "text": "お疲れさまでした、\nつばめさん。"},
        { "location": "38/TALK"   , "narrator": "つばめ", "text": "ううん、卯月さんこそ。\n助かったよ。"},
        { "location": "40/TALK"   , "narrator": "つばめ", "text": "わたしみんなの\n足引っ張って\nばかりだね。"},
        { "location": "41/TALK"   , "narrator": "つばめ", "text": "もっと\nがんばらなきゃ…。"},
        { "location": "42/TALK"   , "narrator": "神楽", "text": "大丈夫ですよ。"},
        { "location": "43/TALK"   , "narrator": "つばめ", "text": "…ありがとう。\n卯月さんは優しいね。"},
        { "location": "44/TALK"   , "narrator": "神楽", "text": "そんなこと\nないですよー！"},
        { "location": "45/TALK"   , "narrator": "神楽", "text": "つばめさんの方が\n優しいし\nかわいいですー！"},
        { "location": "47/TALK"   , "narrator": "つばめ", "text": "えっ！？"},
        { "location": "48/TALK"   , "narrator": "神楽", "text": "食べたくなっちゃい\nますー！\n食べていいですか？"},
        { "location": "49/TALK"   , "narrator": "つばめ", "text": "え、えっと……。"},
        { "location": "51/SEL"    , "narrator": "", "text": "どういう意味で？"},
        { "location": "52/ACT"    , "narrator": "", "text": "どういう意味で？"},
        { "location": "69/TALK"   , "narrator": "神楽", "text": "どういう意味でだと思いますか？"},
        { "location": "71/SEL"    , "narrator": "", "text": "性欲的な"},
        { "location": "72/SEL"    , "narrator": "", "text": "食欲的な"},
        { "location": "73/SEL"    , "narrator": "", "text": "睡眠欲？？？"},
        { "location": "74/ACT"    , "narrator": "", "text": "性欲的な"},
        { "location": "75/TALK"   , "narrator": "神楽", "text": "エッチですねー$handle$さんってば♪"},
        { "location": "86/TALK"   , "narrator": "神楽", "text": "これから二人っきりに\nなれるところに\n行きましょう！"},
        { "location": "87/TALK"   , "narrator": "つばめ", "text": "え、もう二人っきり\nだよ…？"},
        { "location": "89/TALK"   , "narrator": "神楽", "text": "そういう意味じゃ\nありませんよー！"},
        { "location": "90/TALK"   , "narrator": "神楽", "text": "でもそういうところも\nつばめさんらしくて\nかわいいです。"},
        { "location": "91/ACT"    , "narrator": "", "text": "食欲的な"},
        { "location": "92/TALK"   , "narrator": "神楽", "text": "なるほどです♪"},
        { "location": "93/TALK"   , "narrator": "神楽", "text": "了解しました★"},
        { "location": "104/TALK"  , "narrator": "神楽", "text": "というか\n甘いものでも\n食べに行きませんか？"},
        { "location": "105/TALK"  , "narrator": "つばめ", "text": "あ、そういう意味\nだったの？"},
        { "location": "106/ACT"   , "narrator": "", "text": "睡眠欲？？？"},
        { "location": "107/TALK"  , "narrator": "神楽", "text": "ぴょんこは食いしん坊キャラなんですか？"},
        { "location": "108/TALK"  , "narrator": "神楽", "text": "寝言でも食べたいとか言ってる系の？？？"},
        { "location": "109/TALK"  , "narrator": "神楽", "text": "そんなことを言う$handle$さんは不思議ちゃん枠ですね★"},
        { "location": "120/TALK"  , "narrator": "神楽", "text": "つばめさんは今\n何がしたいですか？"},
        { "location": "121/TALK"  , "narrator": "つばめ", "text": "わたし……？"},
        { "location": "123/TALK"  , "narrator": "つばめ", "text": "ちょっと疲れたし、\nお昼寝したいかも。"},
        { "location": "125/TALK"  , "narrator": "つばめ", "text": "そういえば\n卯月さんは寮に\n入る気はないの？"},
        { "location": "126/TALK"  , "narrator": "神楽", "text": "……そうですね。\n自宅もそんなに\n遠くないですし。"},
        { "location": "127/TALK"  , "narrator": "つばめ", "text": "そっかー。\nそうだよね。"},
        { "location": "128/TALK"  , "narrator": "つばめ", "text": "今日みたいな日に\n同じところに\n帰れたらいいなって。"},
        { "location": "129/TALK"  , "narrator": "つばめ", "text": "そう思ったけど\n卯月さんはおうちに\n帰る方がいいよね。"},
        { "location": "130/TALK"  , "narrator": "つばめ", "text": "わたしは卯月さんと\n一緒の方が\nうれしいけど。"},
        { "location": "131/TALK"  , "narrator": "神楽", "text": "……。"},
        { "location": "132/TALK"  , "narrator": "つばめ", "text": "変なこと言って\nごめんね。\nまた明日！"},
        { "location": "133/TALK"  , "narrator": "神楽", "text": "…ええ、また明日。"},
        { "location": "146/TALK"  , "narrator": "神楽", "text": "ぴょんこは何で今フェノメノンが発生しないのかって思ってるんですよ"},
        { "location": "148/TALK"  , "narrator": "神楽", "text": "どうしてだかわかりますか？"},
        { "location": "150/SEL"   , "narrator": "", "text": "ごめんわかんない"},
        { "location": "151/SEL"   , "narrator": "", "text": "ワーカホリックだから"},
        { "location": "152/SEL"   , "narrator": "", "text": "色々こじらせてるからじゃない？"},
        { "location": "153/ACT"   , "narrator": "", "text": "ごめんわかんない"},
        { "location": "154/TALK"  , "narrator": "神楽", "text": "そうですよね、、、"},
        { "location": "155/TALK"  , "narrator": "神楽", "text": "ちょっと整理できたらお話ししてもいいですか？"},
        { "location": "156/ACT"   , "narrator": "", "text": "ワーカホリックだから"},
        { "location": "157/TALK"  , "narrator": "神楽", "text": "そうかもしれませんね、、、"},
        { "location": "158/ACT"   , "narrator": "", "text": "色々こじらせてるからじゃない？"},
        { "location": "159/TALK"  , "narrator": "神楽", "text": "そんなぴょんことお友達でいてくれるんですよね？"},
        { "location": "162/TALK"  , "narrator": "神楽", "text": "お友達になったからってこんなぴょんこはいきなりディープすぎますか？"},
        { "location": "164/SEL"   , "narrator": "", "text": "ちょっとね"},
        { "location": "165/SEL"   , "narrator": "", "text": "むしろ大歓迎"},
        { "location": "166/SEL"   , "narrator": "", "text": "そんな神楽に萌える"},
        { "location": "167/ACT"   , "narrator": "", "text": "ちょっとね"},
        { "location": "168/TALK"  , "narrator": "神楽", "text": "そうですよね、、、ﾊﾝｾｲ、、、"},
        { "location": "170/ACT"   , "narrator": "", "text": "むしろ大歓迎"},
        { "location": "171/TALK"  , "narrator": "神楽", "text": "本当ですか？"},
        { "location": "172/TALK"  , "narrator": "神楽", "text": "だったらもっとディープな話をしちゃいますよっ★"},
        { "location": "175/ACT"   , "narrator": "", "text": "そんな神楽に萌える"},
        { "location": "176/TALK"  , "narrator": "神楽", "text": "もー$handle$さんったらー♪"},
        { "location": "177/TALK"  , "narrator": "神楽", "text": "ぴょんこも$handle$さんに萌えちゃいますっ♪"},
        { "location": "192/TALK"  , "narrator": "神楽", "text": "ふう……。"},
