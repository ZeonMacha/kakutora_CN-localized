{
    "dir": "chap09/daydra/dd_ch04_09_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "9402",
        "cid": "miyabi",
        "title": "002 メインストーリー",
        "sub_title": "コイガサキの日常＜前編＞"
    },
    "entry":
    [
        { "location": "8/SCENARIO", "narrator": "", "text": "コイガサキの日常"},
        { "location": "30/TALK"   , "narrator": "みやび", "text": "ん…んんっ…。"},
        { "location": "31/TALK"   , "narrator": "みやび", "text": "くぁ～…。\nもう朝かぁ…。"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "…………。"},
        { "location": "34/TALK"   , "narrator": "みやび", "text": "おはよう。\nとても暖かい。"},
        { "location": "35/TALK"   , "narrator": "みやび", "text": "…………。"},
        { "location": "36/TALK"   , "narrator": "みやび", "text": "二度寝こそこの世の\n至福。"},
        { "location": "37/TALK"   , "narrator": "みやび", "text": "…………。"},
        { "location": "39/TALK"   , "narrator": "みやび", "text": "準備しよ。"},
        { "location": "58/TALK"   , "narrator": "みやび", "text": "ふぅ…さっぱりや。"},
        { "location": "59/TALK"   , "narrator": "みやび", "text": "…と、早く着替えんと\n遅刻してまう。"},
        { "location": "60/SEL"    , "narrator": "", "text": "二度寝しないの？"},
        { "location": "61/ACT"    , "narrator": "", "text": "二度寝しないの？"},
        { "location": "66/TALK"   , "narrator": "みやび", "text": "…なんや？\nこんな朝っぱらから。"},
        { "location": "85/TALK"   , "narrator": "みやび", "text": "今日は気が向かんのだ"},
        { "location": "86/TALK"   , "narrator": "みやび", "text": "故にやめた"},
        { "location": "87/TALK"   , "narrator": "みやび", "text": "それだけや"},
        { "location": "88/TALK"   , "narrator": "みやび", "text": "以上"},
        { "location": "99/TALK"   , "narrator": "みやび", "text": "…………。"},
        { "location": "100/TALK"  , "narrator": "みやび", "text": "こいつ、どこまで\n見ちょるが？"},
        { "location": "101/TALK"  , "narrator": "みやび", "text": "…いや、うちが\nＷＡＶＥに出るから\nいかんのか。"},
        { "location": "103/TALK"  , "narrator": "みやび", "text": "なら、無視すれば\n見られることはない、\nっちゅうことか？"},
        { "location": "104/SEL"   , "narrator": "", "text": "色んなとこから見てるけどね"},
        { "location": "105/ACT"   , "narrator": "", "text": "色んなとこから見てるけどね"},
        { "location": "108/TALK"  , "narrator": "みやび", "text": "無視や無視。"},
        { "location": "109/TALK"  , "narrator": "みやび", "text": "すぅー…はぁー…。"},
        { "location": "111/TALK"  , "narrator": "みやび", "text": "…よし、外向け\nみやびさんモード\n発動や。"},
        { "location": "114/TALK"  , "narrator": "みやび", "text": "今日も頑張るか…。"},
        { "location": "131/TALK"  , "narrator": "みやび", "text": "…今日は混んじゅう\nみたいやね。"},
        { "location": "132/TALK"  , "narrator": "みやび", "text": "あんましやかましい\nとこで食べるんは\n気が引けるき――"},
        { "location": "133/TALK"  , "narrator": "みやび", "text": "外でちゃちゃっと\nすませてくるか。"},
        { "location": "135/TALK"  , "narrator": "みやび", "text": "…いや、今からじゃ\n午後の授業に\n間に合わんな…。"},
        { "location": "137/TALK"  , "narrator": "みやび", "text": "…どうしたものか？"},
        { "location": "138/SEL"   , "narrator": "", "text": "いつもならサボるのに"},
        { "location": "139/ACT"   , "narrator": "", "text": "いつもならサボるのに"},
        { "location": "141/TALK"  , "narrator": "みやび", "text": "…ちっ。"},
        { "location": "155/TALK"  , "narrator": "みやび", "text": "休み過ぎるとどうなるかわかるか？"},
        { "location": "156/TALK"  , "narrator": "みやび", "text": "来年も高校三年生をすることになるちや"},
        { "location": "157/TALK"  , "narrator": "みやび", "text": "留年、ダブり、クラスメイトが先輩に"},
        { "location": "158/TALK"  , "narrator": "みやび", "text": "笑えん"},
        { "location": "169/TALK"  , "narrator": "みやび", "text": "…しゃあない。\n腹ペコで授業受ける\nよりかはマシやき――"},
        { "location": "170/TALK"  , "narrator": "みやび", "text": "ここで済ますか…。"},
        { "location": "171/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "172/TALK"  , "narrator": "みやび", "text": "【本日の設定】"},
        { "location": "173/TALK"  , "narrator": "みやび", "text": "こいがさ子ちゃん：\n病弱で年中おなか\nいたい。"},
        { "location": "174/TALK"  , "narrator": "みやび", "text": "あいたたたた。\nきょうもおなか\nいたいよう。"},
        { "location": "175/TALK"  , "narrator": "みやび", "text": "だから学校には\n午後から行くよう。"},
        { "location": "176/TALK"  , "narrator": "みやび", "text": "…さて、\n何食うかなぁ？"},
        { "location": "191/TALK"  , "narrator": "みやび", "text": "ん～…。\n次は美術の授業か。"},
        { "location": "192/TALK"  , "narrator": "みやび", "text": "美術っちゅうんは、\nどうにも性に\n合わんなぁ。"},
        { "location": "193/TALK"  , "narrator": "みやび", "text": "それなりに才能のない\n人間には、苦痛以外の\n何でもない時間や…。"},
        { "location": "194/TALK"  , "narrator": "みやび", "text": "いっそのこと、また\nお腹痛くして\n早退でも……"},
        { "location": "195/TALK"  , "narrator": "みやび", "text": "……いや。"},
        { "location": "196/TALK"  , "narrator": "みやび", "text": "そういうわけにも\nいかんかね……。"},
        { "location": "198/TALK"  , "narrator": "みやび", "text": "美術ちゅうことは…\nアレやもんなぁ。"},
        { "location": "242/TALK"  , "narrator": "みやび", "text": "む。誰かと思えば\n$handle$か。"},
        { "location": "255/TALK"  , "narrator": "みやび", "text": "いたっ！"},
        { "location": "258/TALK"  , "narrator": "みやび", "text": "ふわっ！"},
        { "location": "261/TALK"  , "narrator": "みやび", "text": "ひいっ！"},
        { "location": "268/TALK"  , "narrator": "みやび", "text": "馬鹿者！\nうちは起きちゅう！"},
        { "location": "269/SEL"   , "narrator": "", "text": "前回の仕返しです"},
        { "location": "270/SEL"   , "narrator": "", "text": "あるえぇ？　起きてたの？"},
        { "location": "271/ACT"   , "narrator": "", "text": "前回の仕返しです"},
        { "location": "273/TALK"  , "narrator": "みやび", "text": "くっ、小癪な。\n悔しい！\nでも反論できんっ！"},
        { "location": "274/ACT"   , "narrator": "", "text": "あるえぇ？　起きてたの？"},
        { "location": "276/TALK"  , "narrator": "みやび", "text": "お前さんは\nいじめっ子か！"},
        { "location": "277/TALK"  , "narrator": "みやび", "text": "うちはいじめには\nちくっとトラウマがあるき\n気いつけや。"},
        { "location": "282/TALK"  , "narrator": "みやび", "text": "まあ、何にしてもや。\nお前さんがここにいる\nちゅうんは、アレやろ？"},
        { "location": "283/TALK"  , "narrator": "みやび", "text": "またうちの中に葛藤が\n発生しちゅうがやろ？"},
        { "location": "284/SEL"   , "narrator": "", "text": "その通り"},
        { "location": "285/ACT"   , "narrator": "", "text": "その通り"},
        { "location": "288/TALK"  , "narrator": "みやび", "text": "まったく、お前さんが\n来るときはいつも仕事や。"},
        { "location": "289/TALK"  , "narrator": "みやび", "text": "たまには葛藤が発生\nしちょらん時に、ゆっくり\n遊びにきいや。"},
        { "location": "294/TALK"  , "narrator": "みやび", "text": "オープンプロセス、\n0x815番地から\n0x2CC番地へ。"},
        { "location": "309/TALK"  , "narrator": "みやび", "text": "完了。"},
        { "location": "311/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "313/TALK"  , "narrator": "みやび", "text": "………。"},
        { "location": "315/TALK"  , "narrator": "みやび", "text": "なっ…！？"},
        { "location": "316/TALK"  , "narrator": "みやび", "text": "なんやって！？\n今回のこれ、本当に\nうちのことなんか？"},
        { "location": "317/TALK"  , "narrator": "みやび", "text": "まさかうちに、\nこんなココロが\nあろうとは。"},
        { "location": "318/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "319/SEL"   , "narrator": "", "text": "何があったの？"},
        { "location": "320/ACT"   , "narrator": "", "text": "何があったの？"},
        { "location": "322/TALK"  , "narrator": "みやび", "text": "秘密や。\nほれ、すっとクランを\n倒して来い。"},
        { "location": "323/SEL"   , "narrator": "", "text": "教えてくれたらすっと倒す"},
        { "location": "324/ACT"   , "narrator": "", "text": "教えてくれたらすっと倒す"},
        { "location": "326/TALK"  , "narrator": "みやび", "text": "なんとゆう\n鬼畜な取引や！"},
        { "location": "328/TALK"  , "narrator": "みやび", "text": "貴様本当に人間か！？"},
        { "location": "329/SEL"   , "narrator": "", "text": "どう考えても普通だと思うけど"},
        { "location": "330/ACT"   , "narrator": "", "text": "どう考えても普通だと思うけど"},
        { "location": "332/TALK"  , "narrator": "みやび", "text": "ぐぬぬ。\nああ言えばこうゆう。"},
        { "location": "333/TALK"  , "narrator": "みやび", "text": "わかったぞね。\n今回ばかりは、\n背に腹は替えられん。"},
        { "location": "334/TALK"  , "narrator": "みやび", "text": "ココロファイルナンバー\n04-886-39には、\nこう記されちょった。"},
        { "location": "335/TALK"  , "narrator": "みやび", "text": "今、現実のうちは、\n授業をサボりたくて\nたまらん。"},
        { "location": "336/TALK"  , "narrator": "みやび", "text": "けんど、１つだけ\n心残りがある。"},
        { "location": "337/TALK"  , "narrator": "みやび", "text": "いつも美術や体育で\nペアを組んじょる子が\nおるがやけんどな。"},
        { "location": "338/TALK"  , "narrator": "みやび", "text": "その子は、うちがいないと\nいつも独りぼっちなんよ。"},
        { "location": "339/TALK"  , "narrator": "みやび", "text": "確か今日の授業は\nペアになって写生やった\n気がしてるわけやが。"},
        { "location": "340/TALK"  , "narrator": "みやび", "text": "そうでなかったら\n出るだけ損やろ。"},
        { "location": "341/TALK"  , "narrator": "みやび", "text": "それに、あれや。"},
        { "location": "342/TALK"  , "narrator": "みやび", "text": "……その。"},
        { "location": "344/TALK"  , "narrator": "みやび", "text": "ちと、気恥ずかしいきね。"},
        { "location": "345/SEL"   , "narrator": "", "text": "やっぱりみやびは優しいね"},
        { "location": "346/ACT"   , "narrator": "", "text": "やっぱりみやびは優しいね"},
        { "location": "348/TALK"  , "narrator": "みやび", "text": "そうゆうわけや\nないけんど、ぼっちの\n辛さはよう知っちゅうき。"},
        { "location": "349/TALK"  , "narrator": "みやび", "text": "独りにしたら\nちと可哀想やと思うてな。"},
        { "location": "350/TALK"  , "narrator": "みやび", "text": "ま、そんな感じや。"},
        { "location": "351/TALK"  , "narrator": "みやび", "text": "けんど今、うちは\nサボる方に傾いちゅう。"},
        { "location": "352/TALK"  , "narrator": "みやび", "text": "クランが疼いちょるきね。"},
        { "location": "353/SEL"   , "narrator": "", "text": "優しいみやびが見たいから倒してくる"},
        { "location": "354/ACT"   , "narrator": "", "text": "優しいみやびが見たいから倒してくる"},
        { "location": "356/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "358/TALK"  , "narrator": "みやび", "text": "勝手にしいや。"},
        { "location": "359/TALK"  , "narrator": "みやび", "text": "なにはともあれ、\nうちと$handle$に\nえいココロの旅を。"},
        { "location": "23/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>5月13日　7:10 AM</color>\nとある平日の朝、みやびの部屋。"},
        { "location": "210/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "247/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "266/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"}
    ]
}
