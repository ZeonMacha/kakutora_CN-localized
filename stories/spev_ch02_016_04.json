    "entry":
    [
        { "location": "291/SCENARIO", "narrator": "", "text": "アイリッシュコーヒー"},
        { "location": "293/TALK"    , "narrator": "アーヤ", "text": "そうね、それじゃ"},
        { "location": "295/TALK"    , "narrator": "アーヤ", "text": "ちょっと変わり種を"},
        { "location": "296/TALK"    , "narrator": "アーヤ", "text": "それね、"},
        { "location": "297/TALK"    , "narrator": "アーヤ", "text": "完全に大人の飲み物なのよね"},
        { "location": "298/TALK"    , "narrator": "アーヤ", "text": "当たり前よね、お酒なんだし"},
        { "location": "300/SEL"     , "narrator": "", "text": "なに？"},
        { "location": "301/SEL"     , "narrator": "", "text": "アーヤはＯＫってこと？"},
        { "location": "302/SEL"     , "narrator": "", "text": "$me$との恋の味だよね"},
        { "location": "303/ACT"     , "narrator": "", "text": "なに？"},
        { "location": "304/TALK"    , "narrator": "アーヤ", "text": "ええとね"},
        { "location": "305/ACT"     , "narrator": "", "text": "アーヤはＯＫってこと？"},
        { "location": "306/TALK"    , "narrator": "アーヤ", "text": "もちろん！"},
        { "location": "307/ACT"     , "narrator": "", "text": "$me$との恋の味だよね"},
        { "location": "308/TALK"    , "narrator": "アーヤ", "text": "あら素敵"},
        { "location": "309/TALK"    , "narrator": "アーヤ", "text": "そういうのもいいわね"},
        { "location": "310/TALK"    , "narrator": "アーヤ", "text": "でも今は"},
        { "location": "311/TALK"    , "narrator": "アーヤ", "text": "残念だけど"},
        { "location": "312/TALK"    , "narrator": "アーヤ", "text": "違う話なの(・・。)ゞ"},
        { "location": "314/TALK"    , "narrator": "アーヤ", "text": "アイリッシュコーヒーって"},
        { "location": "315/TALK"    , "narrator": "アーヤ", "text": "カクテル知ってる？"},
        { "location": "317/SEL"     , "narrator": "", "text": "知らないし"},
        { "location": "318/SEL"     , "narrator": "", "text": "あれかー"},
        { "location": "319/SEL"     , "narrator": "", "text": "ホットカクテルだね"},
        { "location": "320/ACT"     , "narrator": "", "text": "知らないし"},
        { "location": "321/TALK"    , "narrator": "アーヤ", "text": "そうなのね"},
        { "location": "322/ACT"     , "narrator": "", "text": "あれかー"},
        { "location": "323/TALK"    , "narrator": "アーヤ", "text": "適当なこと"},
        { "location": "324/TALK"    , "narrator": "アーヤ", "text": "言ってない？"},
        { "location": "325/ACT"     , "narrator": "", "text": "ホットカクテルだね"},
        { "location": "326/TALK"    , "narrator": "アーヤ", "text": "そうそう"},
        { "location": "327/TALK"    , "narrator": "アーヤ", "text": "カクテルなのに"},
        { "location": "328/TALK"    , "narrator": "アーヤ", "text": "ホットなのよね"},
        { "location": "330/TALK"    , "narrator": "アーヤ", "text": "上にホイップクリームが"},
        { "location": "331/TALK"    , "narrator": "アーヤ", "text": "乗ってるから"},
        { "location": "332/TALK"    , "narrator": "アーヤ", "text": "ギャヴィが飲んでみたいって"},
        { "location": "333/TALK"    , "narrator": "アーヤ", "text": "言い出して"},
        { "location": "334/TALK"    , "narrator": "アーヤ", "text": "お酒なのに"},
        { "location": "336/SEL"     , "narrator": "", "text": "ノンアルコールで作れば"},
        { "location": "337/SEL"     , "narrator": "", "text": "大人になるまで我慢って言わなきゃ"},
        { "location": "338/ACT"     , "narrator": "", "text": "ノンアルコールで作れば"},
        { "location": "339/TALK"    , "narrator": "アーヤ", "text": "そうね"},
        { "location": "340/TALK"    , "narrator": "アーヤ", "text": "それならありかも"},
        { "location": "341/TALK"    , "narrator": "アーヤ", "text": "作ってあげようかな"},
        { "location": "342/ACT"     , "narrator": "", "text": "大人になるまで我慢って言わなきゃ"},
        { "location": "343/TALK"    , "narrator": "アーヤ", "text": "そうよね"},
        { "location": "344/TALK"    , "narrator": "アーヤ", "text": "未成年なんだもの"},
        { "location": "345/TALK"    , "narrator": "アーヤ", "text": "今は無理よね"}
    ]
}
