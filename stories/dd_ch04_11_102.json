{
    "dir": "chap11/daydra/dd_ch04_11_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "11405",
        "cid": "miyabi",
        "title": "005 メインストーリー",
        "sub_title": "ガブちゃんの真実は＜後編＞"
    },
    "entry":
    [
        { "location": "392/SCENARIO", "narrator": "", "text": "ガブちゃんの真実は"},
        { "location": "409/TALK"    , "narrator": "みやび", "text": "…ガブちゃんの中で\n引っかかっちょる\nこと…。"},
        { "location": "410/TALK"    , "narrator": "みやび", "text": "うーん…。"},
        { "location": "412/TALK"    , "narrator": "繭", "text": "…あの、みやび先輩。"},
        { "location": "413/TALK"    , "narrator": "繭", "text": "本当に大丈夫ですか？\nかなり深刻な悩みを\nお抱えのようですが。"},
        { "location": "415/TALK"    , "narrator": "みやび", "text": "悩みっちゅうほどの\nことでもないんや\nけんど…。"},
        { "location": "416/TALK"    , "narrator": "みやび", "text": "…そうや。\nこの子達にも一緒に\n考えてもらえば――"},
        { "location": "417/TALK"    , "narrator": "みやび", "text": "何かしら答えが\n見えてくるかも\nしれんな。"},
        { "location": "418/TALK"    , "narrator": "みやび", "text": "…せっかくや。\nもし迷惑じゃ\nなかったら――"},
        { "location": "419/TALK"    , "narrator": "みやび", "text": "ちくっと、\n知恵を貸して\nもらえんか？"},
        { "location": "420/TALK"    , "narrator": "繭", "text": "構いませんが…、\n私で力になれるので\nしょうか？"},
        { "location": "423/TALK"    , "narrator": "雛", "text": "私『たち』でしょ！？"},
        { "location": "424/TALK"    , "narrator": "みやび", "text": "力強い仲間になって\nくれる思うちょるよ。"},
        { "location": "425/TALK"    , "narrator": "みやび", "text": "…一応、名前は\n伏せとかんとな。"},
        { "location": "427/TALK"    , "narrator": "みやび", "text": "じゃあ、早速やが\n聞いてもらうぞね。\n実は昨日――"},
        { "location": "447/TALK"    , "narrator": "みやび", "text": "――っちゅうことが\nあったんよ。"},
        { "location": "448/TALK"    , "narrator": "雛", "text": "なるほどぉ…。"},
        { "location": "449/TALK"    , "narrator": "雛", "text": "そのツンデレの\nＡ子ちゃんって\nいうのが――"},
        { "location": "450/TALK"    , "narrator": "雛", "text": "好きな子のことを\n好きと認めない、と。"},
        { "location": "451/TALK"    , "narrator": "みやび", "text": "そう。\nまあ、認めんのは\nいつものことやが。"},
        { "location": "452/TALK"    , "narrator": "みやび", "text": "けんど、どうにも\nいつもの反応とは\n違ったきね――"},
        { "location": "453/TALK"    , "narrator": "みやび", "text": "何か、深い理由が\nあると思うがよ。"},
        { "location": "454/TALK"    , "narrator": "繭", "text": "…………。"},
        { "location": "455/TALK"    , "narrator": "雛", "text": "うーん…ただ単に\n超恥ずかしがり屋な\nだけなんじゃ？"},
        { "location": "456/TALK"    , "narrator": "みやび", "text": "それなら、いつもと\n同じ反応のはずや。"},
        { "location": "457/TALK"    , "narrator": "みやび", "text": "やけんど、あの時は\nそんなに怒って否定\nせんかったきね。"},
        { "location": "458/TALK"    , "narrator": "雛", "text": "うーん…、\nそれじゃあ…。"},
        { "location": "460/TALK"    , "narrator": "雛", "text": "あっ、わかった！\n立場の違いじゃ\nないですかー？"},
        { "location": "462/TALK"    , "narrator": "雛", "text": "ほら、王子様と\n平民の女の子的な\n感じの！"},
        { "location": "464/TALK"    , "narrator": "みやび", "text": "…残念ながら、\n二人とも一般市民の\nはずや。"},
        { "location": "465/TALK"    , "narrator": "みやび", "text": "どちらかが某国の\n貴族とかいう話、\n聞いたことないちや。"},
        { "location": "466/TALK"    , "narrator": "雛", "text": "あらら…。"},
        { "location": "467/TALK"    , "narrator": "雛", "text": "だとしたらもう、\n本当に好きじゃない\nとかは？"},
        { "location": "468/TALK"    , "narrator": "みやび", "text": "んー…、それはないと\n思うんやけんどなぁ。"},
        { "location": "469/TALK"    , "narrator": "雛", "text": "う～ん…。"},
        { "location": "470/TALK"    , "narrator": "繭", "text": "…………。"},
        { "location": "472/TALK"    , "narrator": "雛", "text": "って、まゆちん！？\nボーッとしてないで\n一緒に考えてよー。"},
        { "location": "474/TALK"    , "narrator": "繭", "text": "…はっ！？"},
        { "location": "475/TALK"    , "narrator": "みやび", "text": "すまんね。\n光月さんには\n退屈な話題やったか？"},
        { "location": "478/TALK"    , "narrator": "繭", "text": "す、すみません…。\nそういうわけでは\nないのですが…。"},
        { "location": "480/TALK"    , "narrator": "雛", "text": "まあ、まゆちんは\n興味なさそうな\n話ではあるよねー。"},
        { "location": "482/TALK"    , "narrator": "繭", "text": "そうじゃない！\nただ、私は――"},
        { "location": "483/TALK"    , "narrator": "繭", "text": "想定外のことだった\nから、驚いて思考が\n止まってただけ。"},
        { "location": "484/TALK"    , "narrator": "みやび", "text": "…想定外？"},
        { "location": "486/TALK"    , "narrator": "繭", "text": "はい…無礼を承知で\n言わせていただき\nます。"},
        { "location": "488/TALK"    , "narrator": "繭", "text": "みやび先輩が\n恋愛に対して――"},
        { "location": "489/TALK"    , "narrator": "繭", "text": "そこまで積極的に\n考えるタイプとは\n知らなかったので。"},
        { "location": "490/TALK"    , "narrator": "みやび", "text": "そうなが？"},
        { "location": "492/TALK"    , "narrator": "繭", "text": "…正確にいうなら、\n他者の恋愛に対して、\nでしょうか？"},
        { "location": "494/TALK"    , "narrator": "みやび", "text": "っ！？"},
        { "location": "496/TALK"    , "narrator": "雛", "text": "え？　何それ？\nどういうことー？"},
        { "location": "498/TALK"    , "narrator": "繭", "text": "…………。"},
        { "location": "499/TALK"    , "narrator": "みやび", "text": "…そ、そうやね。"},
        { "location": "501/TALK"    , "narrator": "みやび", "text": "ちくっと、らしくない\n話をしてしもうた\nようや。"},
        { "location": "502/TALK"    , "narrator": "みやび", "text": "…この前みたいに、\n相談されたわけでも\nないっちゅうに――"},
        { "location": "503/TALK"    , "narrator": "みやび", "text": "自分からこんなこと\n考えるとか…。"},
        { "location": "504/TALK"    , "narrator": "みやび", "text": "あー、いかんいかん。\nらしくないことして\nしもうたぁ…。"},
        { "location": "506/TALK"    , "narrator": "みやび", "text": "途中ですまんが、\nこの話おしまいな。"},
        { "location": "507/TALK"    , "narrator": "雛", "text": "えぇっ！？\nせっかく楽しくなって\nきたのに…。"},
        { "location": "508/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "522/TALK"    , "narrator": "みやび", "text": "うわがががががあああああああああ！！！"},
        { "location": "523/TALK"    , "narrator": "みやび", "text": "大恥かいた！！"},
        { "location": "524/TALK"    , "narrator": "みやび", "text": "赤っ恥や！！"},
        { "location": "526/SEL"     , "narrator": "", "text": "とにかく落ち着いて"},
        { "location": "527/ACT"     , "narrator": "", "text": "とにかく落ち着いて"},
        { "location": "530/TALK"    , "narrator": "みやび", "text": "ここでも赤っ恥かくとこやった"},
        { "location": "532/TALK"    , "narrator": "みやび", "text": "それにしても失態"},
        { "location": "533/TALK"    , "narrator": "みやび", "text": "うちらしくない"},
        { "location": "534/TALK"    , "narrator": "みやび", "text": "ちくっと前まで"},
        { "location": "535/TALK"    , "narrator": "みやび", "text": "みんなを完全に信じ切ってない"},
        { "location": "536/TALK"    , "narrator": "みやび", "text": "とかクールに言うた癖に"},
        { "location": "537/TALK"    , "narrator": "みやび", "text": "仲間の恋バナなんぞするとか"},
        { "location": "539/SEL"     , "narrator": "", "text": "丸くなったね"},
        { "location": "540/ACT"     , "narrator": "", "text": "丸くなったね"},
        { "location": "542/TALK"    , "narrator": "みやび", "text": "そうではない"},
        { "location": "543/TALK"    , "narrator": "みやび", "text": "そうなら恥ずかしがらん"},
        { "location": "544/TALK"    , "narrator": "みやび", "text": "これは不測の事態や"},
        { "location": "545/TALK"    , "narrator": "みやび", "text": "呑気過ぎた"},
        { "location": "546/TALK"    , "narrator": "みやび", "text": "まあ、気付けてよかったけんどな"},
        { "location": "548/SEL"     , "narrator": "", "text": "繭がみやびのことよく知ってたおかげだ"},
        { "location": "549/ACT"     , "narrator": "", "text": "繭がみやびのことよく知ってたおかげだ"},
        { "location": "552/TALK"    , "narrator": "みやび", "text": "それな"},
        { "location": "553/TALK"    , "narrator": "みやび", "text": "しかし驚きや"},
        { "location": "554/TALK"    , "narrator": "みやび", "text": "うちが他人にあんまし興味がないこと"},
        { "location": "555/TALK"    , "narrator": "みやび", "text": "指摘されたんは初めてのことや"},
        { "location": "556/TALK"    , "narrator": "みやび", "text": "あの子"},
        { "location": "557/TALK"    , "narrator": "みやび", "text": "いつうちのそれに気づいた？"},
        { "location": "559/TALK"    , "narrator": "みやび", "text": "ただの変わった子やないみたいやね"},
        { "location": "560/TALK"    , "narrator": "みやび", "text": "警戒が必要かもしれん"},
        { "location": "573/TALK"    , "narrator": "みやび", "text": "…まあ、らしくない\n自分に気付かせて\nくれたんやき――"},
        { "location": "574/TALK"    , "narrator": "みやび", "text": "ちくっと感謝は\nしちょるけんどね。"},
        { "location": "576/TALK"    , "narrator": "繭", "text": "…………。"},
        { "location": "577/TALK"    , "narrator": "繭", "text": "…よかった。\nいつものみやび先輩に\n戻って…。"},
        { "location": "579/TALK"    , "narrator": "繭", "text": "でも…さっきまでの\n恋バナに必死になる\nみやび先輩も――"},
        { "location": "580/TALK"    , "narrator": "繭", "text": "ちょっと可愛くて、\nレアだったかも…。"},
        { "location": "591/DIALOG"  , "narrator": "Dialog_chapter_ch04", "text": "【09 パーフェクトイエロー】"}
    ]
}
