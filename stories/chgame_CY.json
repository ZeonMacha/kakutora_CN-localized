    "entry":
    [
        { "location": "902/SCENARIO", "narrator": "", "text": "CY敵（ガブちゃん）"},
        { "location": "909/SEL"     , "narrator": "", "text": "あける"},
        { "location": "910/SEL"     , "narrator": "", "text": "あけない"},
        { "location": "911/ACT"     , "narrator": "", "text": "あける"},
        { "location": "912/ACT"     , "narrator": "", "text": "あけない"},
        { "location": "913/TALK"    , "narrator": "千羽鶴", "text": "じゃあ私がもらう。"},
        { "location": "937/TALK"    , "narrator": "ガブリエラ", "text": "呼ばれて飛び出て\nじゃじゃじゃじゃーん！"},
        { "location": "938/TALK"    , "narrator": "ガブリエラ", "text": "欲の皮が突っ張って\n宝箱を開るなんて\n愚かな人たちね！"},
        { "location": "939/SEL"     , "narrator": "", "text": "宝箱に入ってるなんてかわいい！"},
        { "location": "940/SEL"     , "narrator": "", "text": "欲の皮突っ張ってたわけじゃないよ！"},
        { "location": "941/ACT"     , "narrator": "", "text": "宝箱に入ってるなんてかわいい！"},
        { "location": "942/TALK"    , "narrator": "ガブリエラ", "text": "人のこと\n小さい言うな！"},
        { "location": "943/TALK"    , "narrator": "千羽鶴", "text": "小さいとは\n言ってないけど。"},
        { "location": "944/ACT"     , "narrator": "", "text": "欲の皮突っ張ってたわけじゃないよ！"},
        { "location": "945/TALK"    , "narrator": "ガブリエラ", "text": "口だけなら\n何とでも言えるわよね。"},
        { "location": "947/TALK"    , "narrator": "ガブリエラ", "text": "そんな減らず口叩いて\nいられるのもいまのうち。"},
        { "location": "948/TALK"    , "narrator": "ガブリエラ", "text": "今からあたしが\nあんたたちの身ぐるみを\n剥いであげるんだから！"},
        { "location": "949/SEL"     , "narrator": "", "text": "そうはさせるか！"},
        { "location": "950/SEL"     , "narrator": "", "text": "自分から脱ぎます！"},
        { "location": "951/ACT"     , "narrator": "", "text": "そうはさせるか！"},
        { "location": "952/TALK"    , "narrator": "ガブリエラ", "text": "ふーん、どうするの？\nいっておくけど、\nあたしは強いわよ？"},
        { "location": "954/TALK"    , "narrator": "千羽鶴", "text": "この子の言う通り。\n彼女はこけしのギャヴィ。"},
        { "location": "955/TALK"    , "narrator": "千羽鶴", "text": "その名の通り、\n１０ｋｍ先のこけしを\n打ち抜くことができる。"},
        { "location": "957/TALK"    , "narrator": "千羽鶴", "text": "決して逃げられない。"},
        { "location": "958/TALK"    , "narrator": "ガブリエラ", "text": "その通りよ。\n早速今から実演して\nあげるわね！"},
        { "location": "959/TALK"    , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "961/TALK"    , "narrator": "ガブリエラ", "text": "あら。これじゃないわ。"},
        { "location": "962/TALK"    , "narrator": "ガブリエラ", "text": "…ない……"},
        { "location": "963/TALK"    , "narrator": "ガブリエラ", "text": "ない！！\nあたしの大切な\nこけしが無いわ！"},
        { "location": "965/SEL"     , "narrator": "", "text": "こけしってこれ？"},
        { "location": "966/ACT"     , "narrator": "", "text": "こけしってこれ？"},
        { "location": "970/TALK"    , "narrator": "ガブリエラ", "text": "ああっ！\nそうよ、それよ！"},
        { "location": "971/TALK"    , "narrator": "ガブリエラ", "text": "どこにあったの！？"},
        { "location": "972/TALK"    , "narrator": "千羽鶴", "text": "道端に落ちてた。"},
        { "location": "973/TALK"    , "narrator": "ガブリエラ", "text": "ありがとう！\nありがとう！！"},
        { "location": "974/TALK"    , "narrator": "ガブリエラ", "text": "あんたたちは\n心の友よ！"},
        { "location": "975/TALK"    , "narrator": "ガブリエラ", "text": "お礼にここを\n通してあげる！"},
        { "location": "976/TALK"    , "narrator": "ガブリエラ", "text": "それじゃ、またね！"},
        { "location": "979/SEL"     , "narrator": "", "text": "ここってガブリエラの私有地？"},
        { "location": "980/ACT"     , "narrator": "", "text": "ここってガブリエラの私有地？"},
        { "location": "982/TALK"    , "narrator": "千羽鶴", "text": "いいえ。"},
        { "location": "984/TALK"    , "narrator": "千羽鶴", "text": "まあそんな\nどうでもいい事より、\n先を急ぎましょ。"},
        { "location": "996/SEL"     , "narrator": "", "text": "今のうちに逃げよう！"},
        { "location": "997/ACT"     , "narrator": "", "text": "今のうちに逃げよう！"},
        { "location": "999/TALK"    , "narrator": "千羽鶴", "text": "そうね。\n今なら上手く\n逃げられるかも。"},
        { "location": "1001/TALK"   , "narrator": "ガブリエラ", "text": "ああっ！\nこらーっ！"},
        { "location": "1002/TALK"   , "narrator": "ガブリエラ", "text": "逃がさないわよ！"},
        { "location": "1012/ACT"    , "narrator": "", "text": "自分から脱ぎます！"},
        { "location": "1013/TALK"   , "narrator": "ガブリエラ", "text": "きゃあああっ！"},
        { "location": "1015/TALK"   , "narrator": "ガブリエラ", "text": "変態よ！\n変態がいるわ！"},
        { "location": "908/DIALOG"  , "narrator": "INFO", "text": "宝箱を見つけた！"},
        { "location": "919/DIALOG"  , "narrator": "NOTICE", "text": "宝箱はミミックだった！"},
        { "location": "969/DIALOG"  , "narrator": "INFO", "text": "こけしのギャヴィに\n『こけし』を渡した！"},
        { "location": "1006/DIALOG" , "narrator": "INFO", "text": "千羽鶴にヒット！\n千羽鶴は\n10000ポイントのダメージ"},
        { "location": "1008/DIALOG" , "narrator": "INFO", "text": "千羽鶴は\n死んでしまった。"},
        { "location": "1019/DIALOG" , "narrator": "INFO", "text": "あなたは\nしにました。"}
    ]
}
