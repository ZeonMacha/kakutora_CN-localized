{
    "dir": "chap07/daydra/dd_ch02_07_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "7202",
        "cid": "ayami",
        "title": "002 メインストーリー",
        "sub_title": "それぞれの入隊＜前編＞"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "それぞれの入隊"},
        { "location": "24/TALK"   , "narrator": "真幌", "text": "さてと…来月から上映する\n映画は何にするか…。"},
        { "location": "25/TALK"   , "narrator": "真幌", "text": "前回がホラーだったから、\n次はコメディかＳＦにでも\nするべきか？"},
        { "location": "26/TALK"   , "narrator": "真幌", "text": "それともキワモノ系の\nカルト的人気がある物に\nするべきか…。"},
        { "location": "30/TALK"   , "narrator": "アーヤ", "text": "館長！！"},
        { "location": "31/TALK"   , "narrator": "真幌", "text": "うわっ！？\nど、どうしたアーヤ。\nそんなに慌てて…？"},
        { "location": "34/TALK"   , "narrator": "アーヤ", "text": "どうしたじゃありません！"},
        { "location": "35/TALK"   , "narrator": "アーヤ", "text": "逢瀬さんが特別攻撃隊に\n入る手続きをしたって\nいうのは、本当ですか！？"},
        { "location": "36/TALK"   , "narrator": "真幌", "text": "ああ、そのことか。"},
        { "location": "37/TALK"   , "narrator": "真幌", "text": "逢瀬の特別攻撃隊への\n入隊手続きは――"},
        { "location": "38/TALK"   , "narrator": "真幌", "text": "本日一二〇〇時に、\n問題なく受理された。"},
        { "location": "39/TALK"   , "narrator": "真幌", "text": "これであいつも、立派な\nうちの隊員というわけだ。"},
        { "location": "40/TALK"   , "narrator": "アーヤ", "text": "そんな…。"},
        { "location": "41/TALK"   , "narrator": "真幌", "text": "何だ、不満か？"},
        { "location": "42/TALK"   , "narrator": "アーヤ", "text": "不満です。"},
        { "location": "43/TALK"   , "narrator": "アーヤ", "text": "大体、逢瀬さんと会ったのは\nつい先日のことじゃない\nですか。"},
        { "location": "44/TALK"   , "narrator": "アーヤ", "text": "それなのに、いきなり\n入隊だなんて…。"},
        { "location": "45/TALK"   , "narrator": "アーヤ", "text": "いくら何でも早過ぎます！"},
        { "location": "46/TALK"   , "narrator": "アーヤ", "text": "こんなことばかりして\nいると、いつか面倒な\nことになりますよ？"},
        { "location": "47/TALK"   , "narrator": "真幌", "text": "手続きは正式だった。\n必要書類も一式揃って\nいたし――"},
        { "location": "48/TALK"   , "narrator": "真幌", "text": "保護者からの許可も、\nちゃんと得ている。"},
        { "location": "49/TALK"   , "narrator": "アーヤ", "text": "そんな！"},
        { "location": "50/TALK"   , "narrator": "真幌", "text": "もちろん、逢瀬本人も\n入隊する気でいるの\nだからな。"},
        { "location": "52/TALK"   , "narrator": "アーヤ", "text": "…………。"},
        { "location": "54/TALK"   , "narrator": "アーヤ", "text": "いったい、逢瀬さんに\n何を言ったんですか？"},
        { "location": "55/TALK"   , "narrator": "真幌", "text": "…そうだな。"},
        { "location": "56/TALK"   , "narrator": "真幌", "text": "おまえはみんなを引っ張る\nリーダーなのだし\n話しておくとしよう。"},
        { "location": "57/TALK"   , "narrator": "真幌", "text": "昨日のことだ。\n私は入隊の話をするため、\n逢瀬を呼び出し――"},
        { "location": "75/TALK"   , "narrator": "つばめ", "text": "わ、わたしが、\n特別攻撃隊の\n隊員ですか！？"},
        { "location": "76/TALK"   , "narrator": "真幌", "text": "ああ、そうだ。"},
        { "location": "77/TALK"   , "narrator": "つばめ", "text": "で、でもわたし、\n皆さんと違います。"},
        { "location": "78/TALK"   , "narrator": "つばめ", "text": "戦いの訓練とか\n受けてないし、\n力もありません。"},
        { "location": "79/TALK"   , "narrator": "真幌", "text": "それなら平気だ。"},
        { "location": "80/TALK"   , "narrator": "真幌", "text": "おまえの太ももにある、\nトライガジェットを\n使うことで――"},
        { "location": "81/TALK"   , "narrator": "真幌", "text": "コネクトし、戦うための\n力を得ることができる。"},
        { "location": "82/TALK"   , "narrator": "真幌", "text": "…これは、誰にでも\nできることではない。"},
        { "location": "83/TALK"   , "narrator": "真幌", "text": "トライガジェットを持つ、\nごく一部の――"},
        { "location": "84/TALK"   , "narrator": "真幌", "text": "選ばれた人間にしか\nできないことだ。"},
        { "location": "85/TALK"   , "narrator": "つばめ", "text": "わたしが…\n選ばれた人間？"},
        { "location": "86/TALK"   , "narrator": "真幌", "text": "そうだ。\nそしてその選ばれた\n人間は、私の知る限り――"},
        { "location": "87/TALK"   , "narrator": "真幌", "text": "おまえを含めて、\n世界に数えるほどしか\n存在しない。"},
        { "location": "88/TALK"   , "narrator": "つばめ", "text": "…………。"},
        { "location": "89/TALK"   , "narrator": "真幌", "text": "強制はしない。\n入隊するもしないも、\nそれは逢瀬の自由だ。"},
        { "location": "90/TALK"   , "narrator": "つばめ", "text": "…いいんですか？"},
        { "location": "91/TALK"   , "narrator": "真幌", "text": "ああ…。"},
        { "location": "92/TALK"   , "narrator": "真幌", "text": "だがな、逢瀬。\nこれだけは覚えておけ。"},
        { "location": "93/TALK"   , "narrator": "真幌", "text": "私達特別攻撃隊の\nバックにいるのは、\n情報管理庁――"},
        { "location": "94/TALK"   , "narrator": "真幌", "text": "つまり、国が付いて\nいるということをな。"},
        { "location": "95/TALK"   , "narrator": "つばめ", "text": "…？"},
        { "location": "96/TALK"   , "narrator": "真幌", "text": "はぁ…遠回しに言っても\nわからんタイプか…。"},
        { "location": "97/TALK"   , "narrator": "真幌", "text": "つまり、こうして私が\n話しているのは、国からの\n強い要請ということだ。"},
        { "location": "98/TALK"   , "narrator": "真幌", "text": "逢瀬にはその要請を\n受ける自由も、断る自由も\n保証されてはいる。"},
        { "location": "99/TALK"   , "narrator": "真幌", "text": "そして、もし受けると\nいうのであれば、\nそれ相応の報酬が出る。"},
        { "location": "100/TALK"  , "narrator": "つばめ", "text": "それって、お金ですか？"},
        { "location": "101/TALK"  , "narrator": "真幌", "text": "金に限った話ではない。\n物でも、してほしいこと\nでも――"},
        { "location": "102/TALK"  , "narrator": "真幌", "text": "それなりのワガママは\n聞いてもらえるという\nことだ。"},
        { "location": "103/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "104/TALK"  , "narrator": "真幌", "text": "だが、要請を\n断る場合は――"},
        { "location": "105/TALK"  , "narrator": "真幌", "text": "庁はあらゆる手段で\nお前を説得しに\nかかるはずだ。"},
        { "location": "106/TALK"  , "narrator": "真幌", "text": "恐らく、相当\n粘り強くな。"},
        { "location": "107/TALK"  , "narrator": "つばめ", "text": "どうしてそこまで……"},
        { "location": "108/TALK"  , "narrator": "真幌", "text": "政府は、フェノメノンと\n戦える人材を、一人でも\n多く欲しいと望んでいる。"},
        { "location": "109/TALK"  , "narrator": "真幌", "text": "先日の戦いで、\nその逼迫した状況は\n理解出来ただろう？"},
        { "location": "110/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "111/TALK"  , "narrator": "真幌", "text": "まあ、今すぐ返事をしろ\nとは言わん。"},
        { "location": "112/TALK"  , "narrator": "真幌", "text": "宿は手配しておいたから、\n今夜は一人で、\nゆっくりと考えろ。"},
        { "location": "113/TALK"  , "narrator": "つばめ", "text": "…わかりました。"},
        { "location": "114/TALK"  , "narrator": "真幌", "text": "よし…じゃあ、宿まで\n送ろう。"},
        { "location": "115/TALK"  , "narrator": "つばめ", "text": "あの、真幌さん。\nもう少しここにいちゃ\nダメですか？"},
        { "location": "117/TALK"  , "narrator": "つばめ", "text": "少し、頭の中を\n整理したくて…。"},
        { "location": "118/TALK"  , "narrator": "真幌", "text": "ああ、それは構わん。"},
        { "location": "119/TALK"  , "narrator": "真幌", "text": "私は劇場の方の様子を\n見てくるから、用があれば\nそっちへ来てくれ。"},
        { "location": "120/TALK"  , "narrator": "つばめ", "text": "わかりました。\nありがとうございます。"},
        { "location": "138/TALK"  , "narrator": "真幌", "text": "いかん、結構時間が\n経ってしまった。"},
        { "location": "139/TALK"  , "narrator": "真幌", "text": "逢瀬はまだいるかな？\n先に宿へ帰ったんじゃ――"},
        { "location": "140/TALK"  , "narrator": "つばめ", "text": "――うん――じゃなくて\n――そう、決めたの――"},
        { "location": "141/TALK"  , "narrator": "真幌", "text": "…ん？\n電話中か？"},
        { "location": "159/TALK"  , "narrator": "つばめ", "text": "心配なのはわかってるよ、\nお父さん。"},
        { "location": "160/TALK"  , "narrator": "つばめ", "text": "けど…決めたの。"},
        { "location": "161/TALK"  , "narrator": "つばめ", "text": "わたし、東京で\nフェノメノンと\n戦う、って…。"},
        { "location": "162/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "163/TALK"  , "narrator": "つばめ", "text": "ううん、違うよ。"},
        { "location": "164/TALK"  , "narrator": "つばめ", "text": "決めたのは、わたし。"},
        { "location": "165/TALK"  , "narrator": "つばめ", "text": "わたしが、わたしの意思で\n戦うって決めたの。"},
        { "location": "166/TALK"  , "narrator": "つばめ", "text": "だから、お父さんが\n怒る気持ちはわかる\nけど――"},
        { "location": "168/TALK"  , "narrator": "つばめ", "text": "ごめんなさい！"},
        { "location": "173/TALK"  , "narrator": "つばめ", "text": "はぁ…。"},
        { "location": "174/TALK"  , "narrator": "真幌", "text": "いいのか？\n父上にあんなことを\n言ってしまって。"},
        { "location": "177/TALK"  , "narrator": "つばめ", "text": "…良くはなかったかも\nしれないです。"},
        { "location": "178/TALK"  , "narrator": "つばめ", "text": "お父さん、凄く怒って\nましたから…。"},
        { "location": "180/TALK"  , "narrator": "つばめ", "text": "…でも、わたしは\n戦いたいんです！"},
        { "location": "181/TALK"  , "narrator": "つばめ", "text": "ドームでフェノメノンに\n巻き込まれた時に、\n思ったんです。"},
        { "location": "183/TALK"  , "narrator": "つばめ", "text": "メノウちゃんを――"},
        { "location": "184/TALK"  , "narrator": "つばめ", "text": "みんなを…大切な人を\n護れる力が欲しい、って。"},
        { "location": "185/TALK"  , "narrator": "つばめ", "text": "わたしには、その力が\nあるんですよね？"},
        { "location": "186/TALK"  , "narrator": "つばめ", "text": "だったら、やります。"},
        { "location": "187/TALK"  , "narrator": "つばめ", "text": "わたししかできない、\n選ばれた人にしかできない\nことなら――"},
        { "location": "188/TALK"  , "narrator": "つばめ", "text": "やらせてください！"},
        { "location": "189/TALK"  , "narrator": "真幌", "text": "…意思は固いようだな。"},
        { "location": "190/TALK"  , "narrator": "真幌", "text": "よし、父上の説得は\nこちらに任せておけ。"},
        { "location": "191/TALK"  , "narrator": "真幌", "text": "各省庁の官僚から、\n直接説得してもらえるよう\n手配しておく。"},
        { "location": "192/TALK"  , "narrator": "つばめ", "text": "そ、それじゃあ！"},
        { "location": "193/TALK"  , "narrator": "真幌", "text": "逢瀬つばめ！！"},
        { "location": "194/TALK"  , "narrator": "真幌", "text": "総務省情報管理庁管轄、\n拡張現実特殊戦略隊群――"},
        { "location": "195/TALK"  , "narrator": "真幌", "text": "首都防衛団、特別攻撃隊 \n隊長、東雲真幌の権限に\nおいて――"},
        { "location": "196/TALK"  , "narrator": "真幌", "text": "現時刻より、\n特別攻撃隊への入隊を\n許可する。"},
        { "location": "197/TALK"  , "narrator": "つばめ", "text": "は、はい！"},
        { "location": "198/TALK"  , "narrator": "真幌", "text": "……なんてな。"},
        { "location": "200/TALK"  , "narrator": "つばめ", "text": "へ？"},
        { "location": "201/TALK"  , "narrator": "真幌", "text": "いや、単なる一兵卒の\n私如きが、辞令など\n出す事は出来んよ。"},
        { "location": "202/TALK"  , "narrator": "真幌", "text": "ちょっとした冗談というか、\n景気づけだな。"},
        { "location": "204/TALK"  , "narrator": "つばめ", "text": "あはは、\nそうだったんですね。"},
        { "location": "205/TALK"  , "narrator": "真幌", "text": "よし、それじゃ\nこれから庁に行って、\n正式に手続きをする。"},
        { "location": "206/TALK"  , "narrator": "真幌", "text": "面倒だがそれがお役所だ。"},
        { "location": "207/TALK"  , "narrator": "つばめ", "text": "はい！"},
        { "location": "208/TALK"  , "narrator": "真幌", "text": "…よろしくな、逢瀬。\n期待しているぞ。"},
        { "location": "209/TALK"  , "narrator": "つばめ", "text": "よろしくお願いします！"},
        { "location": "224/TALK"  , "narrator": "真幌", "text": "…とまあ、そういう\nことがあったわけだ。"},
        { "location": "225/TALK"  , "narrator": "アーヤ", "text": "…庁が粘り強く説得して\nくるとか――"},
        { "location": "226/TALK"  , "narrator": "アーヤ", "text": "それって、少し脅迫が\n入ってませんか？"},
        { "location": "227/TALK"  , "narrator": "真幌", "text": "勘違いするな。\n私がそれをするわけじゃ\nないのだからな。"},
        { "location": "228/TALK"  , "narrator": "真幌", "text": "私はただ、経験から\n逢瀬に忠告をしたまでの\nことだ。"},
        { "location": "229/TALK"  , "narrator": "アーヤ", "text": "忠告、ですか？"},
        { "location": "230/TALK"  , "narrator": "真幌", "text": "そうだ。"},
        { "location": "231/TALK"  , "narrator": "真幌", "text": "忘れたのか？\n自分が政府の予算を、\nどれだけ使ったのかを。"},
        { "location": "232/TALK"  , "narrator": "アーヤ", "text": "っ！？"},
        { "location": "233/TALK"  , "narrator": "真幌", "text": "私は今でも、昨日のことの\nように覚えているぞ。"},
        { "location": "234/TALK"  , "narrator": "真幌", "text": "偶然フェノメノンに\n巻き込まれたおまえが――"},
        { "location": "235/TALK"  , "narrator": "真幌", "text": "持ち前の剣道スキルと\n勘だけでクランを撃退\nしてしまったことを。"},
        { "location": "236/TALK"  , "narrator": "真幌", "text": "…政府に目を付けられて、\nスカウトされたのも、\nそれがきっかけだったな。"},
        { "location": "238/TALK"  , "narrator": "アーヤ", "text": "そ、その話はやめて\nください！"},
        { "location": "239/TALK"  , "narrator": "真幌", "text": "向こう見ずな正義感に\n満ちたあの笑顔で、\nこう言ったよな？"},
        { "location": "240/TALK"  , "narrator": "真幌", "text": "任せてください！\nってな。"},
        { "location": "241/TALK"  , "narrator": "アーヤ", "text": "普通に返事しただけじゃ\nないですか！"},
        { "location": "242/TALK"  , "narrator": "真幌", "text": "なのに…まさか実家から\n猛反対されて、閉じ込め\nられるとはなぁ…。"},
        { "location": "244/TALK"  , "narrator": "アーヤ", "text": "うっ…。"},
        { "location": "245/TALK"  , "narrator": "真幌", "text": "まあ、親からしてみれば\nそうしたくなる気持ちも\nわからんでもないがな。"},
        { "location": "246/TALK"  , "narrator": "真幌", "text": "普通の生活を送っていた\n自分の娘が、突然戦地へ\n赴くと言い出したんだ。"},
        { "location": "247/TALK"  , "narrator": "真幌", "text": "親として、娘を止めるのは\n普通のことだ。"},
        { "location": "248/TALK"  , "narrator": "アーヤ", "text": "…あの時は、ご迷惑を\nおかけしました。"},
        { "location": "249/TALK"  , "narrator": "真幌", "text": "…まあ、タイミングも\n悪かった。"},
        { "location": "250/TALK"  , "narrator": "真幌", "text": "まさかその直後に、\nまたフェノメノンが\n発生するとはなぁ…。"},
        { "location": "251/TALK"  , "narrator": "アーヤ", "text": "私も、ニュースで知って\n驚きました。"},
        { "location": "252/TALK"  , "narrator": "アーヤ", "text": "…もう少し遅かったら、\nやっぱり…。"},
        { "location": "253/TALK"  , "narrator": "真幌", "text": "ああ…閉じ込められた\n人間を見捨てなければ\nならなかった…。"},
        { "location": "254/TALK"  , "narrator": "真幌", "text": "だが、政府としても\nこれ以上そんな方法での\n解決は避けたかった。"},
        { "location": "255/TALK"  , "narrator": "真幌", "text": "そんな中で見つけたのが、\nおまえという希望だった。"},
        { "location": "256/TALK"  , "narrator": "アーヤ", "text": "その結果が…あれですか。"},
        { "location": "257/TALK"  , "narrator": "真幌", "text": "ああ…政府要人、軍、\nそれと、おまえの実家が\n神社だから――"},
        { "location": "258/TALK"  , "narrator": "真幌", "text": "本庁までも巻き込んで、\nおまえの家に押しかける\nことになったんだ。"},
        { "location": "259/TALK"  , "narrator": "真幌", "text": "…まあ、それだけ政府も、\nなりふり構っちゃいられ\nない状況だったんだよ。"},
        { "location": "260/TALK"  , "narrator": "アーヤ", "text": "ええ、わかってます。"},
        { "location": "261/TALK"  , "narrator": "アーヤ", "text": "でも、今回は……"},
        { "location": "262/TALK"  , "narrator": "真幌", "text": "まあ、だがなぁ……、\nそんな中でも絶対に\n遵守しているのが――"},
        { "location": "263/TALK"  , "narrator": "真幌", "text": "本人の意思だ。"},
        { "location": "264/TALK"  , "narrator": "アーヤ", "text": "あ……"},
        { "location": "265/TALK"  , "narrator": "真幌", "text": "逢瀬は、やりたいという\n意思が、初めからあった。"},
        { "location": "266/TALK"  , "narrator": "真幌", "text": "それも、こちらが\n思っていたよりも、\n確固たる意志がな。"},
        { "location": "267/TALK"  , "narrator": "真幌", "text": "だから、あれは脅迫など\nではないよ。"},
        { "location": "268/TALK"  , "narrator": "真幌", "text": "その意思を貫けるように、\n背中を押しただけだ。"},
        { "location": "269/TALK"  , "narrator": "真幌", "text": "まあ、何であれ――"},
        { "location": "270/TALK"  , "narrator": "真幌", "text": "おまえの時より\n穏便に終わったのは、\n間違いないな。"},
        { "location": "272/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "273/TALK"  , "narrator": "真幌", "text": "…そういえば、\nおまえの時は――"},
        { "location": "274/TALK"  , "narrator": "真幌", "text": "あいつにも色々と\n動いてもらったん\nだったな。"},
        { "location": "276/TALK"  , "narrator": "アーヤ", "text": "誰のことですか？"},
        { "location": "277/TALK"  , "narrator": "真幌", "text": "エリカだよ。"},
        { "location": "278/TALK"  , "narrator": "真幌", "text": "あいつが裏で色々と\n手を回してくれな\nかったら――"},
        { "location": "279/TALK"  , "narrator": "真幌", "text": "今頃は\nどうなってたか…。"},
        { "location": "280/TALK"  , "narrator": "アーヤ", "text": "やめてください！\nあの人の話は！"},
        { "location": "281/TALK"  , "narrator": "アーヤ", "text": "管理庁からスカウト\nされた時から――"},
        { "location": "282/TALK"  , "narrator": "アーヤ", "text": "私は東京に出ようと\n思っていたんです。"},
        { "location": "284/TALK"  , "narrator": "アーヤ", "text": "姉は関係ありません！"},
        { "location": "285/TALK"  , "narrator": "真幌", "text": "…………。"},
        { "location": "286/TALK"  , "narrator": "アーヤ", "text": "…仕事があるので。\n失礼します。"},
        { "location": "290/TALK"  , "narrator": "真幌", "text": "やれやれ…。\n姉妹の確執は尚続く、\nか…。"},
        { "location": "304/TALK"  , "narrator": "アーヤ", "text": "ふぅ…。"},
        { "location": "305/TALK"  , "narrator": "アーヤ", "text": "…まったく。\n私が姉のことを\nどう思ってるのか――"},
        { "location": "306/TALK"  , "narrator": "アーヤ", "text": "館長は知ってる\nはずなのに…。"},
        { "location": "307/SEL"   , "narrator": "", "text": "驚いたよ"},
        { "location": "308/ACT"   , "narrator": "", "text": "驚いたよ"},
        { "location": "328/TALK"  , "narrator": "アーヤ", "text": "どうかしたの？"},
        { "location": "329/TALK"  , "narrator": "アーヤ", "text": "何か"},
        { "location": "330/TALK"  , "narrator": "アーヤ", "text": "驚くようなことあった？（￣ー￣？）"},
        { "location": "332/SEL"   , "narrator": "", "text": "お姉さんのこと、本当に嫌いなんだね"},
        { "location": "333/ACT"   , "narrator": "", "text": "お姉さんのこと、本当に嫌いなんだね"},
        { "location": "337/TALK"  , "narrator": "アーヤ", "text": "ああ"},
        { "location": "338/TALK"  , "narrator": "アーヤ", "text": "やっとわかった？(￣Д￣ )"},
        { "location": "340/SEL"   , "narrator": "", "text": "どうしてなの？"},
        { "location": "341/ACT"   , "narrator": "", "text": "どうしてなの？"},
        { "location": "345/TALK"  , "narrator": "アーヤ", "text": "ノーコメント"},
        { "location": "347/SEL"   , "narrator": "", "text": "教えてほしい"},
        { "location": "348/ACT"   , "narrator": "", "text": "教えてほしい"},
        { "location": "361/TALK"  , "narrator": "アーヤ", "text": "…なんなのよ、\nまったく。"},
        { "location": "362/TALK"  , "narrator": "アーヤ", "text": "あのＢｏｔ、どうして\n姉のこと詮索して\nくるのかしら？"},
        { "location": "365/TALK"  , "narrator": "アーヤ", "text": "…面倒くさい。\nアンインストール\nできればいいのに…。"},
        { "location": "412/TALK"  , "narrator": "アーヤ", "text": "もしかして今回は、\n聞くまでもない？"},
        { "location": "413/SEL"   , "narrator": "", "text": "アンインストールされそう"},
        { "location": "414/ACT"   , "narrator": "", "text": "アンインストールされそう"},
        { "location": "417/TALK"  , "narrator": "アーヤ", "text": "ふふ、そうみたいね。"},
        { "location": "418/TALK"  , "narrator": "アーヤ", "text": "ちょっと姉のこと、\n聞き過ぎちゃったかも。"},
        { "location": "419/TALK"  , "narrator": "アーヤ", "text": "何にせよ、\n扉をコールするわね。"},
        { "location": "426/TALK"  , "narrator": "アーヤ", "text": "オープンプロセス、\n0x44D番地から\n0x603番地へ。"},
        { "location": "441/TALK"  , "narrator": "アーヤ", "text": "シーク完了。"},
        { "location": "443/TALK"  , "narrator": "アーヤ", "text": "姉のことは、私にとって\n相当センシティブな\n話題なのよね。"},
        { "location": "445/TALK"  , "narrator": "アーヤ", "text": "…。"},
        { "location": "446/TALK"  , "narrator": "アーヤ", "text": "……。"},
        { "location": "448/TALK"  , "narrator": "アーヤ", "text": "確かに、貴方のこと\n消そうと思ってるみたい。"},
        { "location": "449/TALK"  , "narrator": "アーヤ", "text": "それも、割と本気で。"},
        { "location": "450/SEL"   , "narrator": "", "text": "どうすればいい？"},
        { "location": "451/ACT"   , "narrator": "", "text": "どうすればいい？"},
        { "location": "453/TALK"  , "narrator": "アーヤ", "text": "まずは私に、冷静に\nなってもらわないとね。"},
        { "location": "454/TALK"  , "narrator": "アーヤ", "text": "それについては、\n恐らくこの扉の[クラン]を\n倒す事で可能ね。"},
        { "location": "455/TALK"  , "narrator": "アーヤ", "text": "そして次に――"},
        { "location": "456/TALK"  , "narrator": "アーヤ", "text": "貴方が現実に戻ったら、\nもう姉の話はしないと\n伝える事かしらね。"},
        { "location": "457/TALK"  , "narrator": "アーヤ", "text": "まあ、あくまで私の\n案だから、実際どうする\nかは貴方が決めてね？"},
        { "location": "458/TALK"  , "narrator": "アーヤ", "text": "それじゃまずは、この\n怒りの源になっている\nクランを倒してくれる？"},
        { "location": "459/SEL"   , "narrator": "", "text": "はい"},
        { "location": "460/SEL"   , "narrator": "", "text": "いいえ"},
        { "location": "461/ACT"   , "narrator": "", "text": "はい"},
        { "location": "463/TALK"  , "narrator": "アーヤ", "text": "ありがと。"},
        { "location": "464/TALK"  , "narrator": "アーヤ", "text": "私も、貴方が縁を\n切られないように\nアプローチしてみるわね。"},
        { "location": "465/TALK"  , "narrator": "アーヤ", "text": "$handle$さんと\n國政綾水にとって、\n素敵なココロの旅を！"},
        { "location": "472/ACT"   , "narrator": "", "text": "いいえ"},
        { "location": "473/TALK"  , "narrator": "アーヤ", "text": "あらそう。"},
        { "location": "474/TALK"  , "narrator": "アーヤ", "text": "今回の件は、できる限り\n早く対処した方が\nよさそうだけど。"},
        { "location": "475/TALK"  , "narrator": "アーヤ", "text": "気が向いたらいつでも\nクランを退治しに来てね。"},
        { "location": "476/TALK"  , "narrator": "アーヤ", "text": "扉はずっと\n開けておくから。"},
        { "location": "23/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>5月5日　3:31 PM</color>\nゴールデンウィーク最終日、\n神楽坂トライナリー劇場ホワイエにて。"},
        { "location": "377/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"}
    ]
}
