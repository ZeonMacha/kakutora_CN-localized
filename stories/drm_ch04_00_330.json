    "entry":
    [
        { "location": "198/SCENARIO", "narrator": "", "text": "偶然だらけの赤い糸"},
        { "location": "211/TALK"    , "narrator": "ガブリエラ", "text": "うーん…\n迷うわ……。"},
        { "location": "212/TALK"    , "narrator": "ガブリエラ", "text": "季節限定って\n悪魔のささやきよね…。"},
        { "location": "213/TALK"    , "narrator": "ガブリエラ", "text": "でも\n人気ナンバーワンにも\n惹かれるし…。"},
        { "location": "214/TALK"    , "narrator": "みやび", "text": "うちもケーキを\n頼もうかね。"},
        { "location": "215/TALK"    , "narrator": "みやび", "text": "そんでガブちゃんと\nシェアすりゃええろう。"},
        { "location": "217/TALK"    , "narrator": "ガブリエラ", "text": "えっ！？\nいいの？"},
        { "location": "218/TALK"    , "narrator": "みやび", "text": "そのままじゃ\n決められそうに\nないけんね。"},
        { "location": "221/TALK"    , "narrator": "ガブリエラ", "text": "そんなこと\nないけど……。"},
        { "location": "222/TALK"    , "narrator": "ガブリエラ", "text": "でも今日は\nそうさせてもらうわ。"},
        { "location": "223/TALK"    , "narrator": "みやび", "text": "そうそう。"},
        { "location": "224/TALK"    , "narrator": "ガブリエラ", "text": "でもね、みやび。"},
        { "location": "225/TALK"    , "narrator": "みやび", "text": "何ぞね。"},
        { "location": "226/TALK"    , "narrator": "ガブリエラ", "text": "あたし、普段は\n決断は早いほうなの。"},
        { "location": "228/TALK"    , "narrator": "みやび", "text": "うん？"},
        { "location": "229/TALK"    , "narrator": "ガブリエラ", "text": "反射神経で\n決めるっていうの\nかしら。"},
        { "location": "230/TALK"    , "narrator": "ガブリエラ", "text": "そしてその勘は\nあまり外れないって\n思ってるわ。"},
        { "location": "231/TALK"    , "narrator": "みやび", "text": "…野性的やねえ。"},
        { "location": "232/TALK"    , "narrator": "ガブリエラ", "text": "戦場では大事な\n能力よ。"},
        { "location": "234/TALK"    , "narrator": "ガブリエラ", "text": "……はあ。"},
        { "location": "235/TALK"    , "narrator": "みやび", "text": "どういた？"},
        { "location": "237/TALK"    , "narrator": "ガブリエラ", "text": "……ん……。"},
        { "location": "238/TALK"    , "narrator": "ガブリエラ", "text": "恋愛でも\nそうだといいのにって\n思っただけ。"},
        { "location": "246/TALK"    , "narrator": "みやび", "text": "チキチキ"},
        { "location": "247/TALK"    , "narrator": "みやび", "text": "ガブちゃん恋愛相談会！"},
        { "location": "249/SEL"     , "narrator": "", "text": "ガブリエラの、なの？　ガブリエラが、なの？"},
        { "location": "250/SEL"     , "narrator": "", "text": "いや、話してるのみやびだよね"},
        { "location": "251/SEL"     , "narrator": "", "text": "うん、頑張って"},
        { "location": "252/ACT"     , "narrator": "", "text": "ガブリエラの、なの？　ガブリエラが、なの？"},
        { "location": "253/TALK"    , "narrator": "みやび", "text": "ご想像にお任せする"},
        { "location": "254/ACT"     , "narrator": "", "text": "いや、話してるのみやびだよね"},
        { "location": "255/TALK"    , "narrator": "みやび", "text": "うちはただのエージェント"},
        { "location": "256/TALK"    , "narrator": "みやび", "text": "クライアントはガブちゃんぞね"},
        { "location": "257/ACT"     , "narrator": "", "text": "うん、頑張って"},
        { "location": "258/TALK"    , "narrator": "みやび", "text": "ややや"},
        { "location": "259/TALK"    , "narrator": "みやび", "text": "他人事か"},
        { "location": "260/TALK"    , "narrator": "みやび", "text": "他人事だが"},
        { "location": "267/TALK"    , "narrator": "みやび", "text": "それはうちが聞いて\n大丈夫なことかね？"},
        { "location": "268/TALK"    , "narrator": "ガブリエラ", "text": "あ、別に深刻な\n話じゃないわ。\n一般論よ。"},
        { "location": "269/TALK"    , "narrator": "みやび", "text": "一般論、ねえ。"},
        { "location": "270/TALK"    , "narrator": "ガブリエラ", "text": "そういうみやびは\nどうなのよ？"},
        { "location": "271/TALK"    , "narrator": "みやび", "text": "うちか？"},
        { "location": "272/TALK"    , "narrator": "みやび", "text": "うちには恋人が\nもうおるけんね。"},
        { "location": "273/TALK"    , "narrator": "ガブリエラ", "text": "えっ！？\n誰！？"},
        { "location": "275/TALK"    , "narrator": "みやび", "text": "いつもチャットとか\nしとる相手。"},
        { "location": "276/TALK"    , "narrator": "ガブリエラ", "text": "本当に！？\n本当にそうなの！？"},
        { "location": "277/TALK"    , "narrator": "みやび", "text": "何ぞね。\nそのおどろきようは。"},
        { "location": "279/TALK"    , "narrator": "ガブリエラ", "text": "だって！"},
        { "location": "288/TALK"    , "narrator": "みやび", "text": "チキチキ"},
        { "location": "289/TALK"    , "narrator": "みやび", "text": "続・恋愛相談会！"},
        { "location": "291/SEL"     , "narrator": "", "text": "今度は何"},
        { "location": "292/SEL"     , "narrator": "", "text": "いや、聞いてたけど"},
        { "location": "293/ACT"     , "narrator": "", "text": "今度は何"},
        { "location": "294/TALK"    , "narrator": "みやび", "text": "何もかにも"},
        { "location": "295/ACT"     , "narrator": "", "text": "いや、聞いてたけど"},
        { "location": "296/TALK"    , "narrator": "みやび", "text": "ならわかろう"},
        { "location": "298/TALK"    , "narrator": "みやび", "text": "$handle$が恋人だと言うたら"},
        { "location": "299/TALK"    , "narrator": "みやび", "text": "ガブちゃんが取り乱しおった"},
        { "location": "301/SEL"     , "narrator": "", "text": "$me$も取り乱してるよ"},
        { "location": "302/SEL"     , "narrator": "", "text": "そうだろうね"},
        { "location": "303/SEL"     , "narrator": "", "text": "いっそ本当のことにしよう"},
        { "location": "304/ACT"     , "narrator": "", "text": "$me$も取り乱してるよ"},
        { "location": "305/TALK"    , "narrator": "みやび", "text": "なんで"},
        { "location": "307/SEL"     , "narrator": "", "text": "願望が現実になったから"},
        { "location": "308/ACT"     , "narrator": "", "text": "願望が現実になったから"},
        { "location": "309/TALK"    , "narrator": "みやび", "text": "冗談という言葉を知らんのか"},
        { "location": "310/TALK"    , "narrator": "みやび", "text": "$handle$め"},
        { "location": "312/ACT"     , "narrator": "", "text": "そうだろうね"},
        { "location": "313/TALK"    , "narrator": "みやび", "text": "なんだ"},
        { "location": "314/TALK"    , "narrator": "みやび", "text": "その落ち着きは"},
        { "location": "316/SEL"     , "narrator": "", "text": "$me$にとっては事実なだけだから"},
        { "location": "317/ACT"     , "narrator": "", "text": "$me$にとっては事実なだけだから"},
        { "location": "318/TALK"    , "narrator": "みやび", "text": "は"},
        { "location": "319/TALK"    , "narrator": "みやび", "text": "それはうちにとっては"},
        { "location": "320/TALK"    , "narrator": "みやび", "text": "事実ではないぞね"},
        { "location": "322/ACT"     , "narrator": "", "text": "いっそ本当のことにしよう"},
        { "location": "323/TALK"    , "narrator": "みやび", "text": "いっそとは"},
        { "location": "325/SEL"     , "narrator": "", "text": "$me$はみやびとつきあいたいと思ってた"},
        { "location": "326/ACT"     , "narrator": "", "text": "$me$はみやびとつきあいたいと思ってた"},
        { "location": "327/TALK"    , "narrator": "みやび", "text": "なぜ"},
        { "location": "328/TALK"    , "narrator": "みやび", "text": "そうなるか"},
        { "location": "329/TALK"    , "narrator": "みやび", "text": "理解不能だ"},
        { "location": "332/TALK"    , "narrator": "みやび", "text": "相談にならん！！！"},
        { "location": "338/TALK"    , "narrator": "ガブリエラ", "text": "……まあでも。"},
        { "location": "340/TALK"    , "narrator": "ガブリエラ", "text": "そういうこと\nなのね……。"},
        { "location": "341/TALK"    , "narrator": "ガブリエラ", "text": "そう、みやびは\n彼氏がいるのね…。"},
        { "location": "342/TALK"    , "narrator": "みやび", "text": "いやいや、\n今のは冗談ぞね。"},
        { "location": "344/TALK"    , "narrator": "ガブリエラ", "text": "……そうね。\n冗談なのね。"},
        { "location": "345/TALK"    , "narrator": "みやび", "text": "そう。\n納得してくれたかね。"},
        { "location": "346/TALK"    , "narrator": "ガブリエラ", "text": "うん。"},
        { "location": "349/TALK"    , "narrator": "ガブリエラ", "text": "……でも。\n悩みがあるなら\n相談してね。"},
        { "location": "351/TALK"    , "narrator": "みやび", "text": "いや、これは絶対\n誤解したままぞね。"},
        { "location": "209/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>某月某日　3:42 PM</color>\nとある休日の午後、某カフェにて。"}
    ]
}
