{
    "dir": "chap14/daydra/dd_ch04_14_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "14452",
        "cid": "miyabi",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "國政綾水は大忙し"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "アーヤＭＶ回１"},
        { "location": "20/TALK"   , "narrator": "アーヤ", "text": "えっと、こっちの\n資料は確か…。"},
        { "location": "21/TALK"   , "narrator": "アーヤ", "text": "あ、タブレットに\n保存してあるん\nだったかしら？"},
        { "location": "23/TALK"   , "narrator": "みやび", "text": "…ん？　アーヤか？"},
        { "location": "25/TALK"   , "narrator": "アーヤ", "text": "えーっと…、\n確か資料ファイルに\nまとめたような…。"},
        { "location": "26/TALK"   , "narrator": "みやび", "text": "…昼飯食いながらの\nレポート作り…。\n大学生は大変やねぇ。"},
        { "location": "31/TALK"   , "narrator": "アーヤ", "text": "うーん…。"},
        { "location": "44/TALK"   , "narrator": "みやび", "text": "…平和や。"},
        { "location": "45/TALK"   , "narrator": "みやび", "text": "客の来ない劇場で、\nぼんやり過ごすこの\n時間を――"},
        { "location": "47/TALK"   , "narrator": "みやび", "text": "平和以外の言葉で\n何と表現できる\nやろうか？"},
        { "location": "50/TALK"   , "narrator": "アーヤ", "text": "サボり、ね。\nお客さんがいなくても\n仕事はあるのよ？"},
        { "location": "53/TALK"   , "narrator": "みやび", "text": "今日やる予定の\n作業はとっくに\n終わらせたがよ。"},
        { "location": "55/TALK"   , "narrator": "みやび", "text": "…って、アーヤは\n何やってるが？"},
        { "location": "58/TALK"   , "narrator": "アーヤ", "text": "チラシの整理よ。\nみんな適当に\n置くから――"},
        { "location": "59/TALK"   , "narrator": "アーヤ", "text": "名前順に並べて\nおこうと思ってね。"},
        { "location": "60/TALK"   , "narrator": "みやび", "text": "結構な量あるなぁ。\nちゅうか、別に今日\nやらんでもえいやろ？"},
        { "location": "61/TALK"   , "narrator": "アーヤ", "text": "時間が余った時じゃ\nないと、中々手が\n回らないでしょ？"},
        { "location": "63/TALK"   , "narrator": "アーヤ", "text": "…そういえば、\n倉庫の奥に――"},
        { "location": "64/TALK"   , "narrator": "アーヤ", "text": "チラシが大量に\n入った段ボールが\nあったような…。"},
        { "location": "67/TALK"   , "narrator": "アーヤ", "text": "…怖いけど。\nちょっと見てくるわ。"},
        { "location": "71/TALK"   , "narrator": "みやび", "text": "…働きもんやねぇ。"},
        { "location": "88/TALK"   , "narrator": "アーヤ", "text": "――というわけで、\n現場での民間人の\n誘導人員を――"},
        { "location": "89/TALK"   , "narrator": "アーヤ", "text": "もう少し増やすよう、\n上に報告して頂けると\n助かります。"},
        { "location": "90/TALK"   , "narrator": "真幌", "text": "なるほど…。\n確かにそれは伝えて\nおく必要があるな。"},
        { "location": "91/TALK"   , "narrator": "アーヤ", "text": "はい…顔バレだけは、\n最も避けなければ\nいけないことなので。"},
        { "location": "92/TALK"   , "narrator": "真幌", "text": "そうだな。\n報告書にはその部分を\n強調して――"},
        { "location": "96/TALK"   , "narrator": "みやび", "text": "まほさーん。\nうち、そろそろ寮に\n戻りますがよ。"},
        { "location": "98/TALK"   , "narrator": "真幌", "text": "ん？　おお、そうか。\nお疲れさん。"},
        { "location": "100/TALK"  , "narrator": "みやび", "text": "アーヤも、\nもう終わりやろ？"},
        { "location": "104/TALK"  , "narrator": "アーヤ", "text": "ごめん、私は館長と\n話があるから…。"},
        { "location": "105/TALK"  , "narrator": "みやび", "text": "そうか…。\nじゃ、お先に。"},
        { "location": "106/TALK"  , "narrator": "アーヤ", "text": "お疲れ様。"},
        { "location": "108/TALK"  , "narrator": "真幌", "text": "…で？　他に何か\n気になったことは\nなかったか？"},
        { "location": "111/TALK"  , "narrator": "アーヤ", "text": "もう一点、大したこと\nではないんですが、\n現場で――"},
        { "location": "114/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "132/TALK"  , "narrator": "みやび", "text": "…あ、いかん。\n醤油が切れてたん\nやった。"},
        { "location": "134/TALK"  , "narrator": "ガブリエラ", "text": "仕方ないわね…。\nあたしの部屋から\n持ってきてあげるわ。"},
        { "location": "136/TALK"  , "narrator": "つばめ", "text": "いいよ、ガブちゃん。\n醤油ならわたしの\n部屋にもあるし。"},
        { "location": "139/TALK"  , "narrator": "ガブリエラ", "text": "ちょっと前に、\nとっても香りのいい\n醤油を見つけて――"},
        { "location": "140/TALK"  , "narrator": "ガブリエラ", "text": "今はそれ以外\n使いたくないのよ。"},
        { "location": "143/TALK"  , "narrator": "みやび", "text": "…醤油にまでこだわり\n持つようになったか。"},
        { "location": "144/TALK"  , "narrator": "みやび", "text": "ガブちゃんの\n日本人化が\n急加速しちょるな。"},
        { "location": "147/TALK"  , "narrator": "アーヤ", "text": "ただいま…。"},
        { "location": "148/TALK"  , "narrator": "つばめ", "text": "あ、おかえりなさい。\nずいぶん遅かった\nですね？"},
        { "location": "150/TALK"  , "narrator": "アーヤ", "text": "ちょっと、館長と\n話があってね。"},
        { "location": "151/TALK"  , "narrator": "つばめ", "text": "そうだったん\nですか…。"},
        { "location": "153/TALK"  , "narrator": "つばめ", "text": "あの、これからお夕飯\nみんなで作ろう、って\n話してて――"},
        { "location": "154/TALK"  , "narrator": "つばめ", "text": "アーヤさんも一緒に\nどうですか？"},
        { "location": "156/TALK"  , "narrator": "アーヤ", "text": "ごめんなさい。\nお誘いは嬉しいん\nだけど――"},
        { "location": "157/TALK"  , "narrator": "アーヤ", "text": "今夜はちょっと、\n勉強しようと\n思ってるの…。"},
        { "location": "158/TALK"  , "narrator": "みやび", "text": "勉強って…、\nそんな遅れてるが？"},
        { "location": "159/TALK"  , "narrator": "アーヤ", "text": "ちょっとね…、\n最近、復習とかあまり\nできてなくて。"},
        { "location": "161/TALK"  , "narrator": "アーヤ", "text": "だから、また今度ね。"},
        { "location": "165/TALK"  , "narrator": "つばめ", "text": "…残念ですね。"},
        { "location": "167/TALK"  , "narrator": "みやび", "text": "まあ、アーヤらしい\n理由やけんどね。"},
        { "location": "170/TALK"  , "narrator": "ガブリエラ", "text": "お待たせ。\n今、アーヤが\n帰って来なかった？"},
        { "location": "171/TALK"  , "narrator": "つばめ", "text": "うん。食事一緒に\nどうですか、って\n誘ったんだけど――"},
        { "location": "172/TALK"  , "narrator": "つばめ", "text": "お勉強が忙しくて、\n断られちゃった…。"},
        { "location": "173/SEL"   , "narrator": "", "text": "夜食でも作ってあげれば？"},
        { "location": "175/TALK"  , "narrator": "ガブリエラ", "text": "ふーん…別に、\n今日じゃなくても\nいいのに…。"},
        { "location": "178/TALK"  , "narrator": "みやび", "text": "気になったことを\n後回しに出来ん\n性格なんやろうね。"},
        { "location": "179/TALK"  , "narrator": "みやび", "text": "…まあ、頑張り過ぎ\nちょる気もする\nけんど…。"},
        { "location": "182/TALK"  , "narrator": "みやび", "text": "まあ、うちらは\nとりあえず夕食に\nするがよ。"},
        { "location": "184/TALK"  , "narrator": "つばめ", "text": "あ、そうですね。\nじゃあ、わたしの\n部屋に来てください。"},
        { "location": "186/TALK"  , "narrator": "ガブリエラ", "text": "もうお腹ペコペコよ。\nさっさと作って、\n食べたいわ…。"},
        { "location": "188/ACT"   , "narrator": "", "text": "夜食でも作ってあげれば？"},
        { "location": "204/TALK"  , "narrator": "みやび", "text": "いや"},
        { "location": "205/TALK"  , "narrator": "みやび", "text": "それは却下"},
        { "location": "206/TALK"  , "narrator": "みやび", "text": "うち的に面倒くさい"},
        { "location": "207/TALK"  , "narrator": "みやび", "text": "問答無用の大却下！"},
        { "location": "219/TALK"  , "narrator": "みやび", "text": "…ん？"},
        { "location": "222/TALK"  , "narrator": "つばめ", "text": "あ、えと…、\nごめんなさい。"},
        { "location": "223/TALK"  , "narrator": "つばめ", "text": "スマホの画面、\n見えちゃって…。"},
        { "location": "226/TALK"  , "narrator": "みやび", "text": "構わん構わん。\n大した話しちょらん\nかったし。"},
        { "location": "227/TALK"  , "narrator": "つばめ", "text": "あ、でもわたしも$handle$さんに\n賛成です！"},
        { "location": "228/TALK"  , "narrator": "つばめ", "text": "ガブちゃん。\nあとでアーヤさんの\nところに――"},
        { "location": "229/TALK"  , "narrator": "つばめ", "text": "お夜食持って行って\nあげようよ。"},
        { "location": "231/TALK"  , "narrator": "ガブリエラ", "text": "夜食ねぇ…。"},
        { "location": "232/TALK"  , "narrator": "つばめ", "text": "うん、いいでしょ？"},
        { "location": "233/TALK"  , "narrator": "ガブリエラ", "text": "うーん…そうね…。"},
        { "location": "234/TALK"  , "narrator": "ガブリエラ", "text": "最近のアーヤって、\nいつも疲れた\n顔してるし…。"},
        { "location": "237/TALK"  , "narrator": "ガブリエラ", "text": "仕方ないわね…。\nあたしも協力して\nあげるわ。"},
        { "location": "238/SEL"   , "narrator": "", "text": "みやびも作ってあげて"},
        { "location": "239/TALK"  , "narrator": "つばめ", "text": "うん。アーヤさんも、\nきっと喜んでくれる\nと思うよ。"},
        { "location": "241/TALK"  , "narrator": "ガブリエラ", "text": "べ、別に、アーヤを\n喜ばせたいわけじゃ\nなくて――"},
        { "location": "242/TALK"  , "narrator": "ガブリエラ", "text": "変に疲れた顔された\nままでいられるのが、\n嫌なだけよ！"},
        { "location": "245/TALK"  , "narrator": "みやび", "text": "あ～、すまんけんど、\nうちは夜食に関しては\nノータッチや。"},
        { "location": "247/TALK"  , "narrator": "つばめ", "text": "…$handle$さんにも\n言ってましたよね。"},
        { "location": "248/TALK"  , "narrator": "みやび", "text": "うむ、うちの気は\nまったく変わっちょ\nらんきね。"},
        { "location": "249/TALK"  , "narrator": "みやび", "text": "作るなら、\n二人で作りぃ。"},
        { "location": "252/TALK"  , "narrator": "ガブリエラ", "text": "まったく…、\nチームワークってのを\n知らないんだから…。"},
        { "location": "254/TALK"  , "narrator": "ガブリエラ", "text": "それじゃ、お夕飯が\n終わったら――"},
        { "location": "255/TALK"  , "narrator": "ガブリエラ", "text": "つばめはあたしと\n夜食を作る。\nそれでＯＫ？"},
        { "location": "258/TALK"  , "narrator": "つばめ", "text": "うん。\n頑張って美味しいの\n作ろうね。"},
        { "location": "259/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "272/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "273/TALK"  , "narrator": "みやび", "text": "…ん？\n０時過ぎたか…。"},
        { "location": "274/TALK"  , "narrator": "みやび", "text": "そろそろやな。"},
        { "location": "285/TALK"  , "narrator": "アーヤ", "text": "…ふぁ～。"},
        { "location": "286/TALK"  , "narrator": "アーヤ", "text": "…眠い。\nああ、でももう少し\n勉強進めたいし…。"},
        { "location": "287/TALK"  , "narrator": "アーヤ", "text": "…ギャヴィ達の夜食、\nやっぱり量が多かった\nみたい。"},
        { "location": "288/TALK"  , "narrator": "アーヤ", "text": "…どうしよう。\nちょっと仮眠を\nとって…。"},
        { "location": "290/TALK"  , "narrator": "アーヤ", "text": "いやいや、無理よ。\n絶対起きられないわ。"},
        { "location": "296/TALK"  , "narrator": "アーヤ", "text": "誰？\nあいてるわよ。"},
        { "location": "301/TALK"  , "narrator": "みやび", "text": "お邪魔するぞね。"},
        { "location": "303/TALK"  , "narrator": "アーヤ", "text": "こんな時間に来る\nなんて、\nどうかしたの？"},
        { "location": "304/TALK"  , "narrator": "みやび", "text": "…眠そうな顔やね。"},
        { "location": "305/TALK"  , "narrator": "みやび", "text": "あれか？\nガブちゃん達の\n持って来た夜食――"},
        { "location": "306/TALK"  , "narrator": "みやび", "text": "律儀に平らげて、\n腹いっぱいでネムネム\nコース爆進中やろ？"},
        { "location": "308/TALK"  , "narrator": "アーヤ", "text": "あはは…。\nよくわかったわね？"},
        { "location": "309/TALK"  , "narrator": "みやび", "text": "ちくっと考えれば\nわかることやき。"},
        { "location": "310/TALK"  , "narrator": "みやび", "text": "やけんど、断っても\nよかったと思うがよ。"},
        { "location": "311/TALK"  , "narrator": "みやび", "text": "寝てしまう言えば、\n二人とも納得したと\n思うし。"},
        { "location": "312/TALK"  , "narrator": "アーヤ", "text": "食べたかったのは\n本当よ。\nお腹も空いてたし。"},
        { "location": "313/TALK"  , "narrator": "アーヤ", "text": "それに、とっても\n美味しかったから\n残せなかったのよ。"},
        { "location": "314/TALK"  , "narrator": "みやび", "text": "…なるほど。\nなら、よかった\nっちゅうことか？"},
        { "location": "316/TALK"  , "narrator": "アーヤ", "text": "ええ…ふぁ～…。"},
        { "location": "317/TALK"  , "narrator": "みやび", "text": "…ちくっとでも、\n仮眠とった方が\nえいと思うよ。"},
        { "location": "318/TALK"  , "narrator": "みやび", "text": "うちはまだしばらく\n起きてるき――"},
        { "location": "320/TALK"  , "narrator": "みやび", "text": "二時間くらいしたら\n起こすけんど、\nどうする？"},
        { "location": "321/TALK"  , "narrator": "アーヤ", "text": "…お願いできる？\n正直、ちょっと\n限界なの…。"},
        { "location": "322/TALK"  , "narrator": "みやび", "text": "あい、了解や。"},
        { "location": "323/TALK"  , "narrator": "みやび", "text": "そうと決まれば、\nすっとベッド入りぃ。"},
        { "location": "325/TALK"  , "narrator": "アーヤ", "text": "ありがとう…。\nそれじゃ、おやすみ。"},
        { "location": "327/TALK"  , "narrator": "みやび", "text": "ん…おやすみ。"},
        { "location": "328/TALK"  , "narrator": "みやび", "text": "…喜んでもらえた\nみたいやし、\n来て正解やったな。"},
        { "location": "329/ACT"   , "narrator": "", "text": "みやびも作ってあげて"},
        { "location": "344/TALK"  , "narrator": "みやび", "text": "イジワルで作らん言うとるわけじゃない"},
        { "location": "345/TALK"  , "narrator": "みやび", "text": "が！！"},
        { "location": "346/TALK"  , "narrator": "みやび", "text": "そうまで言うなら"},
        { "location": "347/TALK"  , "narrator": "みやび", "text": "作っちゃる"},
        { "location": "348/TALK"  , "narrator": "みやび", "text": "冷たい人間と思われるんは"},
        { "location": "349/TALK"  , "narrator": "みやび", "text": "マジ心外"},
        { "location": "350/TALK"  , "narrator": "みやび", "text": "けんど"},
        { "location": "351/TALK"  , "narrator": "みやび", "text": "責任は取らん！"},
        { "location": "362/TALK"  , "narrator": "みやび", "text": "…じゃあ、何を作るか\n考えんとね。"},
        { "location": "363/TALK"  , "narrator": "ガブリエラ", "text": "夜食なんだし、\n身体が温まるものが\nいいと思うわ。"},
        { "location": "365/TALK"  , "narrator": "つばめ", "text": "夜食のラーメンは\nとっても美味しい！"},
        { "location": "366/TALK"  , "narrator": "つばめ", "text": "って、キリトくんが\n言ってたよ。"},
        { "location": "369/TALK"  , "narrator": "ガブリエラ", "text": "ラーメンなんて\nダメよ。"},
        { "location": "370/TALK"  , "narrator": "ガブリエラ", "text": "手軽に食べれるのを\n重視したいから、\n例えば――"},
        { "location": "371/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "387/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "388/TALK"  , "narrator": "アーヤ", "text": "ふぅ……。"},
        { "location": "389/TALK"  , "narrator": "アーヤ", "text": "やっぱり、\n復習サボり過ぎてた\nみたい。"},
        { "location": "390/TALK"  , "narrator": "アーヤ", "text": "忙しくても、\n勉強の時間だけは\n作らないと…。"},
        { "location": "395/TALK"  , "narrator": "アーヤ", "text": "あ、はーい。\n開いてるわよ。"},
        { "location": "400/TALK"  , "narrator": "ガブリエラ", "text": "お邪魔するわ。"},
        { "location": "404/TALK"  , "narrator": "つばめ", "text": "お疲れ様です。\nお勉強、どうですか？"},
        { "location": "405/TALK"  , "narrator": "アーヤ", "text": "ぼちぼちかしら…。\nでも、こんな時間に\nどうしたの？"},
        { "location": "408/TALK"  , "narrator": "みやび", "text": "勉強頑張っちょる\nアーヤのために、\n夜食作ってきたがよ。"},
        { "location": "409/TALK"  , "narrator": "アーヤ", "text": "本当！？\n嬉しいわ、ちょっと\nお腹も空いてて――"},
        { "location": "412/TALK"  , "narrator": "アーヤ", "text": "って…なんか、\n量多くない？"},
        { "location": "413/TALK"  , "narrator": "つばめ", "text": "お腹が減ってたら\n頭が働かないと\n思って――"},
        { "location": "414/TALK"  , "narrator": "つばめ", "text": "おにぎりと\nサンドイッチを\n沢山作ったんです。"},
        { "location": "416/TALK"  , "narrator": "ガブリエラ", "text": "体育会系なんだから、\nこれくらい少ない方\nでしょ？"},
        { "location": "418/TALK"  , "narrator": "アーヤ", "text": "そ、それにしても\nちょっと多い気が\nするけど…。"},
        { "location": "419/TALK"  , "narrator": "みやび", "text": "温かいスープも\n作ったき、これ飲んで\n身体温めるちや。"},
        { "location": "421/TALK"  , "narrator": "アーヤ", "text": "…食べられないことは\nない量だけど――"},
        { "location": "422/TALK"  , "narrator": "アーヤ", "text": "今こんなに食べたら、\nお腹いっぱいになって\n眠くなっちゃう…。"},
        { "location": "423/TALK"  , "narrator": "アーヤ", "text": "でも、私のために\n作ってくれたものを\n残せないし…。"},
        { "location": "424/TALK"  , "narrator": "アーヤ", "text": "そうだ！\nせめておにぎりか\nサンドイッチかに――"},
        { "location": "425/TALK"  , "narrator": "つばめ", "text": "このおにぎり、\nわたしが作ったん\nですよ。"},
        { "location": "426/TALK"  , "narrator": "つばめ", "text": "卵焼きが入ってて、\nわたしも大好きで\nよく食べるんです。"},
        { "location": "427/TALK"  , "narrator": "ガブリエラ", "text": "でも、食べるのは\nサンドイッチからに\nしなさいよ？"},
        { "location": "428/TALK"  , "narrator": "ガブリエラ", "text": "まずは軽い物から\n食べないとね。"},
        { "location": "429/TALK"  , "narrator": "つばめ", "text": "えーっ、ズルいよ\nガブちゃん。"},
        { "location": "431/TALK"  , "narrator": "アーヤ", "text": "…どっちかなんて、\n言い出せる空気じゃ\nないわ！"},
        { "location": "432/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "434/TALK"  , "narrator": "アーヤ", "text": "…あ、ありがとう。\nいただきます…。"},
        { "location": "435/TALK"  , "narrator": "ガブリエラ", "text": "夜中まで勉強する\nつもりなんでしょ？"},
        { "location": "436/TALK"  , "narrator": "ガブリエラ", "text": "それなら、しっかり\n食べないとダメよ。"},
        { "location": "437/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "450/TALK"  , "narrator": "みやび", "text": "ほれ見たことか"},
        { "location": "452/TALK"  , "narrator": "みやび", "text": "これでアーヤが寝落ちしたとしても"},
        { "location": "453/TALK"  , "narrator": "みやび", "text": "うちは知らんぞ"},
        { "location": "19/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>7月6日　0:33 PM</color>\nとある昼休み、学園内の学食にて。"}
    ]
}
