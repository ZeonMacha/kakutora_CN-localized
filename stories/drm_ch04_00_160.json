        { "location": "465/SEL"   , "narrator": "", "text": "操るのは劇場とみやび達だけで精いっぱいだって"},
        { "location": "466/ACT"   , "narrator": "", "text": "操るのは劇場とみやび達だけで精いっぱいだって"},
