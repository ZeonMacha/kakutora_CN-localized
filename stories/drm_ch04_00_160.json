    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "TRUEにしてFALSEは成立するや否や？"},
        { "location": "16/TALK"   , "narrator": "みやび", "text": "…よし！"},
        { "location": "28/TALK"   , "narrator": "みやび", "text": "相棒"},
        { "location": "29/TALK"   , "narrator": "みやび", "text": "今少し"},
        { "location": "41/TALK"   , "narrator": "みやび", "text": "いや、ここはダメや。"},
        { "location": "42/TALK"   , "narrator": "みやび", "text": "もっと、人目の少ない\nところに…。"},
        { "location": "56/TALK"   , "narrator": "みやび", "text": "よし、ここなら…。"},
        { "location": "68/TALK"   , "narrator": "みやび", "text": "すまんな"},
        { "location": "69/TALK"   , "narrator": "みやび", "text": "頼みがあるちや"},
        { "location": "71/SEL"    , "narrator": "", "text": "頼み？"},
        { "location": "72/ACT"    , "narrator": "", "text": "頼み？"},
        { "location": "74/TALK"   , "narrator": "みやび", "text": "そうや"},
        { "location": "75/TALK"   , "narrator": "みやび", "text": "実は"},
        { "location": "91/TALK"   , "narrator": "みやび", "text": "マズい！"},
        { "location": "94/TALK"   , "narrator": "女子高校生Ａ", "text": "昨日のテレビ見た？\nカッちんの出てるドラマ。"},
        { "location": "96/TALK"   , "narrator": "女子高校生Ｂ", "text": "ああ、見た見たー。\n面白かったよねー。"},
        { "location": "99/TALK"   , "narrator": "みやび", "text": "くっ、誰もいない場所は\nないのか…？"},
        { "location": "114/TALK"  , "narrator": "みやび", "text": "…よし、ここなら\nえいやろ。"},
        { "location": "126/TALK"  , "narrator": "みやび", "text": "何度もすまんな"},
        { "location": "127/TALK"  , "narrator": "みやび", "text": "どこに目があるかわからんき"},
        { "location": "129/SEL"   , "narrator": "", "text": "どういうこと？"},
        { "location": "130/ACT"   , "narrator": "", "text": "どういうこと？"},
        { "location": "132/TALK"  , "narrator": "みやび", "text": "噂を聞いた"},
        { "location": "133/TALK"  , "narrator": "みやび", "text": "この学校を裏で操っちょるんは"},
        { "location": "134/TALK"  , "narrator": "みやび", "text": "実はまほさんらしい"},
        { "location": "136/SEL"   , "narrator": "", "text": "マジで！？"},
        { "location": "137/ACT"   , "narrator": "", "text": "マジで！？"},
        { "location": "139/TALK"  , "narrator": "みやび", "text": "わからんき"},
        { "location": "140/TALK"  , "narrator": "みやび", "text": "相棒に調べてもらおう思うてる"},
        { "location": "141/TALK"  , "narrator": "みやび", "text": "そういうことやき"},
        { "location": "142/TALK"  , "narrator": "みやび", "text": "頼んだ"},
        { "location": "145/SEL"   , "narrator": "", "text": "無理"},
        { "location": "146/SEL"   , "narrator": "", "text": "知ってた"},
        { "location": "147/SEL"   , "narrator": "", "text": "やってみるけど"},
        { "location": "148/ACT"   , "narrator": "", "text": "無理"},
        { "location": "149/TALK"  , "narrator": "みやび", "text": "無理？"},
        { "location": "150/TALK"  , "narrator": "みやび", "text": "何故や？"},
        { "location": "152/TALK"  , "narrator": "みやび", "text": "本気になれ"},
        { "location": "153/TALK"  , "narrator": "みやび", "text": "出来るんやろ？"},
        { "location": "155/SEL"   , "narrator": "", "text": "知らないから無理"},
        { "location": "156/ACT"   , "narrator": "", "text": "知らないから無理"},
        { "location": "158/TALK"  , "narrator": "みやび", "text": "何やそれ？"},
        { "location": "159/TALK"  , "narrator": "みやび", "text": "調べる気ゼロ？"},
        { "location": "160/TALK"  , "narrator": "みやび", "text": "ガッカリや"},
        { "location": "173/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "174/TALK"  , "narrator": "みやび", "text": "上手くかわされたか？\nそれとも本気か…。"},
        { "location": "175/TALK"  , "narrator": "みやび", "text": "もうちっくと調べる\n必要がありそうやね…。"},
        { "location": "176/ACT"   , "narrator": "", "text": "知ってた"},
        { "location": "177/TALK"  , "narrator": "みやび", "text": "ほう"},
        { "location": "179/TALK"  , "narrator": "みやび", "text": "知ってたか"},
        { "location": "180/TALK"  , "narrator": "みやび", "text": "なら証拠を出しぃ"},
        { "location": "182/SEL"   , "narrator": "", "text": "証拠はない"},
        { "location": "183/ACT"   , "narrator": "", "text": "証拠はない"},
        { "location": "185/TALK"  , "narrator": "みやび", "text": "証拠がないならウソっちゅうことやな"},
        { "location": "186/TALK"  , "narrator": "みやび", "text": "適当なこと言うな"},
        { "location": "197/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "198/TALK"  , "narrator": "みやび", "text": "いや、もしかしたら\nこれも作戦か？"},
        { "location": "199/TALK"  , "narrator": "みやび", "text": "だとしたら、踊らされて\nたんは…うち！？"},
        { "location": "200/TALK"  , "narrator": "みやび", "text": "…もうちっくと調べる\n必要がありそうやね。"},
        { "location": "201/ACT"   , "narrator": "", "text": "やってみるけど"},
        { "location": "202/TALK"  , "narrator": "みやび", "text": "よし"},
        { "location": "204/TALK"  , "narrator": "みやび", "text": "どう調べる？"},
        { "location": "206/SEL"   , "narrator": "", "text": "ガブリエラに聞いてみる"},
        { "location": "207/SEL"   , "narrator": "", "text": "アーヤに聞いてみる"},
        { "location": "208/ACT"   , "narrator": "", "text": "ガブリエラに聞いてみる"},
        { "location": "229/TALK"  , "narrator": "ガブリエラ", "text": "ん？"},
        { "location": "241/TALK"  , "narrator": "ガブリエラ", "text": "どうかしたの？"},
        { "location": "243/TALK"  , "narrator": "ガブリエラ", "text": "こんなタイミングで声をかけてくるなんて"},
        { "location": "244/TALK"  , "narrator": "ガブリエラ", "text": "珍しいわね"},
        { "location": "246/SEL"   , "narrator": "", "text": "真幌が学校を裏で操ってるらしい"},
        { "location": "247/ACT"   , "narrator": "", "text": "真幌が学校を裏で操ってるらしい"},
        { "location": "250/TALK"  , "narrator": "ガブリエラ", "text": "は？"},
        { "location": "252/SEL"   , "narrator": "", "text": "真幌が学校を裏で操ってるらしい"},
        { "location": "253/ACT"   , "narrator": "", "text": "真幌が学校を裏で操ってるらしい"},
        { "location": "255/TALK"  , "narrator": "ガブリエラ", "text": "あ"},
        { "location": "256/TALK"  , "narrator": "ガブリエラ", "text": "うん"},
        { "location": "257/TALK"  , "narrator": "ガブリエラ", "text": "そう"},
        { "location": "259/TALK"  , "narrator": "ガブリエラ", "text": "凄いわね"},
        { "location": "270/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "271/TALK"  , "narrator": "ガブリエラ", "text": "何だったのかしら、\n今の？"},
        { "location": "282/SEL"   , "narrator": "", "text": "調べたよ！"},
        { "location": "283/ACT"   , "narrator": "", "text": "調べたよ！"},
        { "location": "298/TALK"  , "narrator": "みやび", "text": "でかした"},
        { "location": "300/TALK"  , "narrator": "みやび", "text": "どうやった"},
        { "location": "302/SEL"   , "narrator": "", "text": "凄いね、だって"},
        { "location": "303/ACT"   , "narrator": "", "text": "凄いね、だって"},
        { "location": "305/TALK"  , "narrator": "みやび", "text": "いや"},
        { "location": "306/TALK"  , "narrator": "みやび", "text": "ちょっと待て"},
        { "location": "307/TALK"  , "narrator": "みやび", "text": "どう調べた？"},
        { "location": "309/SEL"   , "narrator": "", "text": "ガブリエラに聞いた"},
        { "location": "310/ACT"   , "narrator": "", "text": "ガブリエラに聞いた"},
        { "location": "312/TALK"  , "narrator": "みやび", "text": "アホか！？"},
        { "location": "314/TALK"  , "narrator": "みやび", "text": "そりゃ調べたとは言わん！"},
        { "location": "315/TALK"  , "narrator": "みやび", "text": "もうえい！！"},
        { "location": "326/TALK"  , "narrator": "みやび", "text": "…期待外れやなぁ。"},
        { "location": "327/ACT"   , "narrator": "", "text": "アーヤに聞いてみる"},
        { "location": "345/TALK"  , "narrator": "アーヤ", "text": "あっ、すみません。\nちょっといいですか？"},
        { "location": "347/TALK"  , "narrator": "真幌", "text": "ああ、構わんぞ。"},
        { "location": "360/TALK"  , "narrator": "アーヤ", "text": "どうかしたの？"},
        { "location": "361/TALK"  , "narrator": "アーヤ", "text": "今"},
        { "location": "362/TALK"  , "narrator": "アーヤ", "text": "館長とお昼ご飯中なんだけど？"},
        { "location": "364/SEL"   , "narrator": "", "text": "真幌には気を付けろ"},
        { "location": "365/ACT"   , "narrator": "", "text": "真幌には気を付けろ"},
        { "location": "367/TALK"  , "narrator": "アーヤ", "text": "え？"},
        { "location": "369/TALK"  , "narrator": "アーヤ", "text": "意味わからないんだけど？"},
        { "location": "371/SEL"   , "narrator": "", "text": "真幌は学校を裏で操っている"},
        { "location": "372/ACT"   , "narrator": "", "text": "真幌は学校を裏で操っている"},
        { "location": "375/TALK"  , "narrator": "アーヤ", "text": "いや"},
        { "location": "376/TALK"  , "narrator": "アーヤ", "text": "ちょっと待って"},
        { "location": "378/TALK"  , "narrator": "アーヤ", "text": "どういうこと？"},
        { "location": "380/SEL"   , "narrator": "", "text": "みやびにその証拠を探せと言われてる"},
        { "location": "381/ACT"   , "narrator": "", "text": "みやびにその証拠を探せと言われてる"},
        { "location": "383/TALK"  , "narrator": "アーヤ", "text": "そう"},
        { "location": "384/TALK"  , "narrator": "アーヤ", "text": "ちょっと待ってて"},
        { "location": "396/TALK"  , "narrator": "真幌", "text": "どうした？"},
        { "location": "398/TALK"  , "narrator": "アーヤ", "text": "ちょっと変な噂を\n流してる人が\nいるみたいなんです。"},
        { "location": "399/TALK"  , "narrator": "アーヤ", "text": "館長が裏で\n学校を操ってる\nとかなんとか。"},
        { "location": "401/TALK"  , "narrator": "真幌", "text": "そんなことして\n何になるんだ。"},
        { "location": "402/TALK"  , "narrator": "アーヤ", "text": "ですよね。\nみやびも何を\n言い出してるのやら。"},
        { "location": "403/TALK"  , "narrator": "真幌", "text": "みやびも妙な冗談を\n思いついたもんだ。"},
        { "location": "404/TALK"  , "narrator": "真幌", "text": "操るのは劇場と\nみやび達だけで\n精いっぱいだと伝えとけ。"},
        { "location": "407/TALK"  , "narrator": "アーヤ", "text": "そう返しておきますね。"},
        { "location": "419/TALK"  , "narrator": "アーヤ", "text": "そういうことだから"},
        { "location": "420/TALK"  , "narrator": "アーヤ", "text": "みやびによろしく"},
        { "location": "422/SEL"   , "narrator": "", "text": "ＯＫ"},
