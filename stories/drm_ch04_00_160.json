        { "location": "483/TALK"  , "narrator": "みやび", "text": "いや"},
        { "location": "485/TALK"  , "narrator": "みやび", "text": "それはないやろ"},
        { "location": "486/TALK"  , "narrator": "みやび", "text": "相棒"},
        { "location": "487/TALK"  , "narrator": "みやび", "text": "後でまほさんに怒られるやん"},
        { "location": "488/TALK"  , "narrator": "みやび", "text": "うちが"},
        { "location": "490/TALK"  , "narrator": "みやび", "text": "どうしてくれる？"},
        { "location": "492/SEL"   , "narrator": "", "text": "噂はフェイクでＯＫ？"},
        { "location": "493/ACT"   , "narrator": "", "text": "噂はフェイクでＯＫ？"},
        { "location": "495/TALK"  , "narrator": "みやび", "text": "そうや"},
