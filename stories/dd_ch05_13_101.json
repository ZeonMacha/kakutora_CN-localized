{
    "dir": "chap13/daydra/dd_ch05_13_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "13502",
        "cid": "kagura",
        "title": "002 メインストーリー",
        "sub_title": "クリエイターズハイ＜前編＞"
    },
    "entry":
    [
        { "location": "33/TALK"   , "narrator": "神楽", "text": "――以上が、\n今回の報告になります。"},
        { "location": "34/TALK"   , "narrator": "千羽鶴", "text": "なるほど。\n報告ご苦労様。"},
        { "location": "35/TALK"   , "narrator": "千羽鶴", "text": "引き続きよろしく。"},
        { "location": "39/TALK"   , "narrator": "神楽", "text": "ふぅ…やっと終わった。"},
        { "location": "40/TALK"   , "narrator": "神楽", "text": "こんな大変なときに\n長電話だなんて…。"},
        { "location": "41/TALK"   , "narrator": "神楽", "text": "…とにかく、早いとこ\n完成させなくちゃ。"},
        { "location": "47/TALK"   , "narrator": "神楽", "text": "今度出る新曲の歌詞を！"},
        { "location": "49/TALK"   , "narrator": "神楽", "text": "…とは言ったものの、\nなんにも思い浮かばないん\nだけど…。"},
        { "location": "50/TALK"   , "narrator": "神楽", "text": "はぁ…どうしよう？\n明日の朝が締め切り\nなのに…。"},
        { "location": "51/TALK"   , "narrator": "神楽", "text": "…………。"},
        { "location": "55/TALK"   , "narrator": "神楽", "text": "…こういうときの\n落書きって、不思議なほど\n捗る…。"},
        { "location": "56/TALK"   , "narrator": "神楽", "text": "そうだ、ノートの端に\nパラパラ漫画を――"},
        { "location": "60/TALK"   , "narrator": "神楽", "text": "っ！？\nヤバッ、事務所から！！"},
        { "location": "76/TALK"   , "narrator": "神楽", "text": "も、もしもし…。"},
        { "location": "77/TALK"   , "narrator": "神楽", "text": "え？　あ、は、はい！\n大丈夫です、\n本当、順調ですから！"},
        { "location": "78/TALK"   , "narrator": "神楽", "text": "朝までには歌詞を\n提出しますから…、\nはい、はい、もちろん！"},
        { "location": "79/TALK"   , "narrator": "神楽", "text": "…わかりました。\n失礼します。"},
        { "location": "84/TALK"   , "narrator": "神楽", "text": "ふぅ…\nまさか催促の電話が\n来るなんて…。"},
        { "location": "85/TALK"   , "narrator": "神楽", "text": "…でも、ふふっ。"},
        { "location": "86/TALK"   , "narrator": "神楽", "text": "朝までには提出とか、\nふふふっ…。"},
        { "location": "87/SEL"    , "narrator": "", "text": "提出できるの？"},
        { "location": "88/ACT"    , "narrator": "", "text": "提出できるの？"},
        { "location": "104/TALK"  , "narrator": "神楽", "text": "どうにかします！"},
        { "location": "105/TALK"  , "narrator": "神楽", "text": "今言ったのは"},
        { "location": "106/TALK"  , "narrator": "神楽", "text": "もう後戻りできない"},
        { "location": "107/TALK"  , "narrator": "神楽", "text": "その気持ちを自分に植え付ける裏技"},
        { "location": "108/TALK"  , "narrator": "神楽", "text": "これでスピードアップ間違いなしですよ！！"},
        { "location": "110/TALK"  , "narrator": "神楽", "text": "さーやりますよー"},
        { "location": "111/TALK"  , "narrator": "神楽", "text": "ぴょん子はメノウちゃんモードに入りますよー！！"},
        { "location": "115/SEL"   , "narrator": "", "text": "なんかテンション上がってる？"},
        { "location": "116/SEL"   , "narrator": "", "text": "あの、頑張ってね"},
        { "location": "117/ACT"   , "narrator": "", "text": "なんかテンション上がってる？"},
        { "location": "118/TALK"  , "narrator": "神楽", "text": "夜にテンションが上がるのは自然なことでは？"},
        { "location": "119/TALK"  , "narrator": "神楽", "text": "異論は認めない！"},
        { "location": "121/ACT"   , "narrator": "", "text": "あの、頑張ってね"},
        { "location": "122/TALK"  , "narrator": "神楽", "text": "ぴょんぴょんぴょん♪"},
        { "location": "126/TALK"  , "narrator": "神楽", "text": "あっ！！！！！！！！"},
        { "location": "127/TALK"  , "narrator": "神楽", "text": "すごいことに気づきました"},
        { "location": "129/SEL"   , "narrator": "", "text": "なにに気づいたの？"},
        { "location": "130/ACT"   , "narrator": "", "text": "なにに気づいたの？"},
        { "location": "144/TALK"  , "narrator": "神楽", "text": "…スマホポチポチしてる\n暇があったら、一文字でも\n歌詞を考えなくちゃ…。"},
        { "location": "145/TALK"  , "narrator": "神楽", "text": "…そうよ。\n今回の曲はいつも以上に\n力を入れて…。"},
        { "location": "146/TALK"  , "narrator": "神楽", "text": "最高の曲にしないと\nいけないんだから。"},
        { "location": "147/TALK"  , "narrator": "神楽", "text": "そうじゃないと…。"},
        { "location": "161/TALK"  , "narrator": "透明つばめ", "text": "最近のメノウちゃん、\n歌ってても楽しそうじゃ\nなくて…。"},
        { "location": "162/TALK"  , "narrator": "透明神楽", "text": "…………。"},
        { "location": "163/TALK"  , "narrator": "透明つばめ", "text": "今も素敵だけど、\n昔はもっと素敵だった。"},
        { "location": "164/TALK"  , "narrator": "透明つばめ", "text": "歌ってるメノウちゃんは、\nいつもキラキラしてた\nのに…。"},
        { "location": "166/TALK"  , "narrator": "透明神楽", "text": "……ちっ！！"},
        { "location": "176/TALK"  , "narrator": "神楽", "text": "…楽しそうじゃないって、\n当然じゃない。"},
        { "location": "177/TALK"  , "narrator": "神楽", "text": "どれだけ作品を\nねじ曲げられてるか\n知りもしないで……"},
        { "location": "179/TALK"  , "narrator": "神楽", "text": "…でも。"},
        { "location": "180/TALK"  , "narrator": "神楽", "text": "つばめさんは、\nそれがわかるくらい\nメノウのこと……。"},
        { "location": "181/TALK"  , "narrator": "神楽", "text": "はぁっ……\n何なの、もう！"},
        { "location": "182/TALK"  , "narrator": "神楽", "text": "すごく悔しい。\n私、なんで今でも\n音楽続けてるんだろ。"},
        { "location": "183/TALK"  , "narrator": "神楽", "text": "せめて今作ってるの\nくらいは、つばめさんが…"},
        { "location": "184/TALK"  , "narrator": "神楽", "text": "――いえ。\n自分が好きになれる\n曲を創ってやるんだから。"},
        { "location": "192/TALK"  , "narrator": "神楽", "text": "――新曲の歌詞が\n完成致しました。"},
        { "location": "193/TALK"  , "narrator": "神楽", "text": "タイトルと一緒に\n確認ください…、と。"},
        { "location": "196/TALK"  , "narrator": "神楽", "text": "ん～～～～～～っ、\n終わったぁー！！"},
        { "location": "198/TALK"  , "narrator": "神楽", "text": "はぁ…、思ってたより\n時間掛かっちゃったなぁ。"},
        { "location": "199/TALK"  , "narrator": "神楽", "text": "…もう三時、か。\n早くベッドに入って――"},
        { "location": "200/TALK"  , "narrator": "神楽", "text": "って、あ～、そうだった。\nお風呂にも入らないと\nいけないんだ…。"},
        { "location": "201/TALK"  , "narrator": "神楽", "text": "…お風呂、起きてからに\nしようかな？"},
        { "location": "202/TALK"  , "narrator": "神楽", "text": "眠気と疲れで、\n結構限界だし…。"},
        { "location": "203/TALK"  , "narrator": "神楽", "text": "でも、サッパリしてから\nじゃないと寝付けない気も\nするし…う～ん…。"},
        { "location": "252/TALK"  , "narrator": "ぴょんこ", "text": "　"},
        { "location": "288/TALK"  , "narrator": "みやび", "text": "相棒。"},
        { "location": "289/TALK"  , "narrator": "ぴょんこ", "text": "こんにちぴょん♪"},
        { "location": "290/SEL"   , "narrator": "", "text": "ぴょん！（単品）"},
        { "location": "291/SEL"   , "narrator": "", "text": "ぴょん！（ぴょんこｽｷ予約バンドル品）"},
        { "location": "292/ACT"   , "narrator": "", "text": "ぴょん！（単品）"},
        { "location": "295/TALK"  , "narrator": "みやび", "text": "斬新な\nコミュニケーションやね。"},
        { "location": "296/ACT"   , "narrator": "", "text": "ぴょん！（ぴょんこｽｷ予約付き）"},
        { "location": "300/TALK"  , "narrator": "みやび", "text": "斬新な\nコミュニケーションやね。"},
        { "location": "303/TALK"  , "narrator": "ぴょんこ", "text": "ふたりは\nニコピョンですからね！\nそんな事より――"},
        { "location": "305/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんっ！\n遂に今回から\nぴょんこと旅行ですよ！"},
        { "location": "307/TALK"  , "narrator": "みやび", "text": "旅行ゆうよりかは\n出兵に近いけんどな。"},
        { "location": "308/TALK"  , "narrator": "ぴょんこ", "text": "遠く離れた異境の地で\n二人きりなんて――"},
        { "location": "309/TALK"  , "narrator": "みやび", "text": "異境の地＝集合意識野な。"},
        { "location": "311/TALK"  , "narrator": "ぴょんこ", "text": "何が起こるか\nわかりませんよねっ！"},
        { "location": "312/SEL"   , "narrator": "", "text": "二人きり？　みやびはいかないの？"},
        { "location": "313/SEL"   , "narrator": "", "text": "そうですね"},
        { "location": "314/SEL"   , "narrator": "", "text": "何が起こるか（意味深）"},
        { "location": "315/ACT"   , "narrator": "", "text": "二人きり？　みやびはいかないの？"},
        { "location": "318/TALK"  , "narrator": "みやび", "text": "いずれ合流するけんど、\n自分の世界から行く必要が\nあるき、一旦お別れやね。"},
        { "location": "319/TALK"  , "narrator": "みやび", "text": "送り出したらうちも自分の\nココロスフィアに戻って、\n準備してから行くきね。"},
        { "location": "320/ACT"   , "narrator": "", "text": "そうですね"},
        { "location": "323/ACT"   , "narrator": "", "text": "何が起こるか（意味深）"},
        { "location": "327/TALK"  , "narrator": "ぴょんこ", "text": "<size=35>（意味深）！</size>"},
        { "location": "329/TALK"  , "narrator": "ぴょんこ", "text": "どういう風に意味が\n深いのか、ハッキリここで\n言ってくださいっ！"},
        { "location": "332/TALK"  , "narrator": "ぴょんこ", "text": "さあっ！\nさあっ！！"},
        { "location": "333/SEL"   , "narrator": "", "text": "単に「生死を彷徨うようなことが沢山起きそう」って思っただけだよ"},
        { "location": "334/SEL"   , "narrator": "", "text": "わかってて言わせようとしてるでしょ"},
        { "location": "335/SEL"   , "narrator": "", "text": "言うとアプリがストアから消えてぴょんこと逢えなくなるよ？"},
        { "location": "336/ACT"   , "narrator": "", "text": "単に「生死を彷徨うようなことが沢山起きそう」って思っただけだよ"},
        { "location": "337/TALK"  , "narrator": "ぴょんこ", "text": "なーんだ。\nそんなことですか。"},
        { "location": "338/TALK"  , "narrator": "ぴょんこ", "text": "安心してください！"},
        { "location": "340/TALK"  , "narrator": "ぴょんこ", "text": "生きるも死ぬも、\nぴょんこと一緒ですっ！"},
        { "location": "341/TALK"  , "narrator": "ぴょんこ", "text": "一人だけ先に\nラクに逝かせたりなんか\nしませんよ？"},
        { "location": "342/ACT"   , "narrator": "", "text": "わかってて言わせようとしてるでしょ"},
        { "location": "343/TALK"  , "narrator": "ぴょんこ", "text": "え？\nわかってて？"},
        { "location": "344/TALK"  , "narrator": "ぴょんこ", "text": "なにをですか？\nなにをですか？？"},
        { "location": "346/TALK"  , "narrator": "ぴょんこ", "text": "もー、\n$handle$さんってば\nムッツリなんですからっ！"},
        { "location": "347/ACT"   , "narrator": "", "text": "言うとアプリがストアから消えてぴょんこと逢えなくなるよ？"},
        { "location": "348/TALK"  , "narrator": "ぴょんこ", "text": "それは困るぴょん。"},
        { "location": "349/TALK"  , "narrator": "ぴょんこ", "text": "では、では！"},
        { "location": "351/TALK"  , "narrator": "ぴょんこ", "text": "言葉にするのがダメでも、\n行動で示すのはオッケー\nですよね？？"},
        { "location": "352/TALK"  , "narrator": "ぴょんこ", "text": "楽しみにしてるぴょん♪\nふふふ…。"},
        { "location": "354/SEL"   , "narrator": "", "text": "あ、みやび寝ちゃってる"},
        { "location": "355/ACT"   , "narrator": "", "text": "あ、みやび寝ちゃってる"},
        { "location": "359/TALK"  , "narrator": "ぴょんこ", "text": "あらら、ほんとですね。"},
        { "location": "360/SEL"   , "narrator": "", "text": "盛り上がり過ぎちゃったね"},
        { "location": "361/SEL"   , "narrator": "", "text": "ぴょんこがくだらなさすぎたんだろうね"},
        { "location": "362/ACT"   , "narrator": "", "text": "盛り上がり過ぎちゃったね"},
        { "location": "364/TALK"  , "narrator": "ぴょんこ", "text": "ほんとですねっ♪"},
        { "location": "365/ACT"   , "narrator": "", "text": "ぴょんこがくだらなさすぎたんだろうね"},
        { "location": "367/TALK"  , "narrator": "ぴょんこ", "text": "同罪だっての。"},
        { "location": "369/TALK"  , "narrator": "ぴょんこ", "text": "それでは、みやびさんも\n眠ってしまいましたから―"},
        { "location": "370/TALK"  , "narrator": "ぴょんこ", "text": "この隙にひとつ、キスでも\nしちゃいませんかっ？"},
        { "location": "371/SEL"   , "narrator": "", "text": "する！"},
        { "location": "372/SEL"   , "narrator": "", "text": "遠慮しておきます"},
        { "location": "373/ACT"   , "narrator": "", "text": "する！"},
        { "location": "376/TALK"  , "narrator": "ぴょんこ", "text": "ふふふ～。"},
        { "location": "380/TALK"  , "narrator": "ぴょんこ", "text": "この背徳感、\nゾクゾクしませんかっ！"},
        { "location": "381/TALK"  , "narrator": "ぴょんこ", "text": "優しくしてくださいねっ！"},
        { "location": "402/TALK"  , "narrator": "ぴょんこ", "text": "ふわあっ！"},
        { "location": "406/TALK"  , "narrator": "ぴょんこ", "text": "ふわあっ！"},
        { "location": "413/TALK"  , "narrator": "ぴょんこ", "text": "とろけるようなキスって\nまさにこのことですねっ♪"},
        { "location": "415/TALK"  , "narrator": "ぴょんこ", "text": "温かくて\n柔らかい…。"},
        { "location": "417/TALK"  , "narrator": "ぴょんこ", "text": "昇天しちゃいそう♪♪♪"},
        { "location": "425/TALK"  , "narrator": "みやび", "text": "み～～～た～～～よ～～。"},
        { "location": "426/TALK"  , "narrator": "ぴょんこ", "text": "きゃっ！"},
        { "location": "427/SEL"   , "narrator": "", "text": "ここここれはこのそのあのどの！！！！"},
        { "location": "428/SEL"   , "narrator": "", "text": "おはようございます"},
        { "location": "429/SEL"   , "narrator": "", "text": "いやー、ハニーとのラブラブシーン見られちゃったよ"},
        { "location": "430/ACT"   , "narrator": "", "text": "ここここれはこのそのあのどの！！！！"},
        { "location": "431/TALK"  , "narrator": "みやび", "text": "うろたえるくらいなら\n最初からやらんければ\nえいのに。"},
        { "location": "432/ACT"   , "narrator": "", "text": "おはようございます"},
        { "location": "433/TALK"  , "narrator": "みやび", "text": "うむ。おはようさん。"},
        { "location": "434/ACT"   , "narrator": "", "text": "いやー、ハニーとのラブラブシーン見られちゃったよ"},
        { "location": "435/TALK"  , "narrator": "みやび", "text": "熱いね。"},
        { "location": "444/TALK"  , "narrator": "みやび", "text": "しっかし、あれやね。"},
        { "location": "445/TALK"  , "narrator": "みやび", "text": "うちには、お前さんが\nどういう神経しちゅうがか\nわからんよ。"},
        { "location": "446/TALK"  , "narrator": "みやび", "text": "とりあえず、今後\nお前さんは相棒から\n木偶の棒に格下げな。"},
        { "location": "449/TALK"  , "narrator": "みやび", "text": "しっかし、あれやね。"},
        { "location": "450/TALK"  , "narrator": "みやび", "text": "お前さん方には\n恥じらいちゅうものは\nないが？"},
        { "location": "451/SEL"   , "narrator": "", "text": "急に起きてきたのはみやびの方だし"},
        { "location": "452/SEL"   , "narrator": "", "text": "神楽への愛は止まることを知らない"},
        { "location": "453/ACT"   , "narrator": "", "text": "急に起きてきたのはみやびの方だし"},
        { "location": "454/TALK"  , "narrator": "みやび", "text": "何を事故みたいに……。"},
        { "location": "455/TALK"  , "narrator": "みやび", "text": "バクチは身を滅ぼすき、\n程々にな。"},
        { "location": "456/ACT"   , "narrator": "", "text": "神楽への愛は止まることを知らない"},
        { "location": "458/TALK"  , "narrator": "みやび", "text": "熱い熱い。\nうちもそれくらい\n言われたいものやね。"},
        { "location": "464/TALK"  , "narrator": "ぴょんこ", "text": "もっと～！\nもっと～！"},
        { "location": "465/SEL"   , "narrator": "", "text": "もう一度キスする"},
        { "location": "466/SEL"   , "narrator": "", "text": "終わりにしておく"},
        { "location": "467/ACT"   , "narrator": "", "text": "もう一度キスする"},
        { "location": "475/ACT"   , "narrator": "", "text": "終わりにしておく"},
        { "location": "477/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん。"},
        { "location": "478/TALK"  , "narrator": "みやび", "text": "んん……？"},
        { "location": "479/TALK"  , "narrator": "みやび", "text": "ふわあぁぁ…　…"},
        { "location": "481/TALK"  , "narrator": "みやび", "text": "たわいもない話は\nおわったが？"},
        { "location": "482/TALK"  , "narrator": "ぴょんこ", "text": "ギリギリセーフ\nでしたねっ♪"},
        { "location": "489/ACT"   , "narrator": "", "text": "遠慮しておきます"},
        { "location": "490/TALK"  , "narrator": "ぴょんこ", "text": "わかったぴょん。"},
        { "location": "491/TALK"  , "narrator": "みやび", "text": "んん……？"},
        { "location": "492/TALK"  , "narrator": "みやび", "text": "ふわあぁぁ…　…"},
        { "location": "494/TALK"  , "narrator": "みやび", "text": "たわいもない話は\n終わったが？"},
        { "location": "496/TALK"  , "narrator": "ぴょんこ", "text": "はい。\nいま丁度♪"},
        { "location": "500/TALK"  , "narrator": "みやび", "text": "ほんだら早速、\nお前さん方を共通意識野に\n送り出すぞね。"},
        { "location": "504/TALK"  , "narrator": "みやび", "text": "オープンプロセス、\n2xCE8番地から\nC5:0:000//0x000番地へ。"},
        { "location": "529/TALK"  , "narrator": "みやび", "text": "シーク完了。"},
        { "location": "531/TALK"  , "narrator": "みやび", "text": "ちゅうわけで、\nいてら。"},
        { "location": "532/SEL"   , "narrator": "", "text": "ちょっと待って！そもそも何しに行くのか聞いてないから！"},
        { "location": "533/SEL"   , "narrator": "", "text": "いってくる！"},
        { "location": "534/ACT"   , "narrator": "", "text": "ちょっと待って！そもそも何しに行くのか聞いてないから！"},
        { "location": "535/TALK"  , "narrator": "みやび", "text": "おお、そういえば。"},
        { "location": "537/TALK"  , "narrator": "ぴょんこ", "text": "そうですよー。\n私も聞いてませんし。"},
        { "location": "539/TALK"  , "narrator": "みやび", "text": "お前さんがその状態で\nノリノリで行こうとしてた\nのは、問題やぞ？"},
        { "location": "542/TALK"  , "narrator": "みやび", "text": "今から共通意識野に行って\n何をするか。\nそれは――"},
        { "location": "543/TALK"  , "narrator": "みやび", "text": "卯月の同化の元凶を\n突き止め、根本的な\n解決をすることやよ。"},
        { "location": "544/SEL"   , "narrator": "", "text": "あーなるほど"},
        { "location": "545/SEL"   , "narrator": "", "text": "同化ってなんだっけ？"},
        { "location": "546/ACT"   , "narrator": "", "text": "あーなるほど"},
        { "location": "547/ACT"   , "narrator": "", "text": "同化ってなんだっけ？"},
        { "location": "548/TALK"  , "narrator": "みやび", "text": "フェノメノンに巻込まれた\n時、その世界に記憶を\n書き換えられることや。"},
        { "location": "549/TALK"  , "narrator": "みやび", "text": "卯月はそれが起こらんよう\n仕掛けられていた筈やが、\n何故か同化しちゅう。"},
        { "location": "550/TALK"  , "narrator": "みやび", "text": "その謎と犯人を\n突き止めに行き、\n同化を阻止するがよ。"},
        { "location": "553/TALK"  , "narrator": "みやび", "text": "まあそんなわけやき、\nこの扉から集合意識野へ\n行っちょってや。"},
        { "location": "555/TALK"  , "narrator": "みやび", "text": "うちらもそれぞれ\n別々に向かうき、\nあとで合流や。"},
        { "location": "556/ACT"   , "narrator": "", "text": "いってくる！"},
        { "location": "558/TALK"  , "narrator": "みやび", "text": "ふむ。ほんだら、\nよろしゅう頼んだよ。"},
        { "location": "560/TALK"  , "narrator": "みやび", "text": "ほななー。"},
        { "location": "567/TALK"  , "narrator": "ぴょんこ", "text": "行っちゃいましたね。"},
        { "location": "568/SEL"   , "narrator": "", "text": "$me$たちも行く？"},
        { "location": "569/SEL"   , "narrator": "", "text": "本当に行くの？"},
        { "location": "570/ACT"   , "narrator": "", "text": "$me$たちも行く？"},
        { "location": "571/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこは行くつもり\nですけど？"},
        { "location": "572/ACT"   , "narrator": "", "text": "本当に行くの？"},
        { "location": "573/TALK"  , "narrator": "ぴょんこ", "text": "当たり前ですよっ！"},
        { "location": "574/TALK"  , "narrator": "ぴょんこ", "text": "同化するかしないかには、\nぴょんこの命が\nかかってるんですから！"},
        { "location": "576/TALK"  , "narrator": "ぴょんこ", "text": "ですがその前にっ！"},
        { "location": "577/SEL"   , "narrator": "", "text": "葛藤を解消しないとね"},
        { "location": "578/SEL"   , "narrator": "", "text": "その前に……？"},
        { "location": "579/ACT"   , "narrator": "", "text": "葛藤を解消しないとね"},
        { "location": "580/TALK"  , "narrator": "ぴょんこ", "text": "え？"},
        { "location": "581/TALK"  , "narrator": "ぴょんこ", "text": "違いますよ～っ！"},
        { "location": "582/ACT"   , "narrator": "", "text": "その前に……？"},
        { "location": "584/TALK"  , "narrator": "ぴょんこ", "text": "今回のキスチケ\nじゃんけんがまだじゃ\nないですかーっ！"},
        { "location": "585/SEL"   , "narrator": "", "text": "いやいやそんな事より葛藤ちゃんと処理しないとやばいからー！"},
        { "location": "586/SEL"   , "narrator": "", "text": "待ってましたっ！"},
        { "location": "587/ACT"   , "narrator": "", "text": "いやいやそんな事より葛藤ちゃんと処理しないとやばいからー！"},
        { "location": "588/TALK"  , "narrator": "ぴょんこ", "text": "いやいや今回の葛藤\n薄々読めてるんですけど、\nメチャくだらなくね？"},
        { "location": "589/TALK"  , "narrator": "ぴょんこ", "text": "あれでしょ、ほら、\n風呂入ってから寝るか、\n起きたら入るかっていう。"},
        { "location": "590/TALK"  , "narrator": "ぴょんこ", "text": "そんなもん\n自分で考えろよー。"},
        { "location": "591/SEL"   , "narrator": "", "text": "ぴょんこだって自分でしょ！"},
        { "location": "592/ACT"   , "narrator": "", "text": "ぴょんこだって自分でしょ！"},
        { "location": "594/TALK"  , "narrator": "ぴょんこ", "text": "まあ半分は\nそうだけどさー。"},
        { "location": "595/TALK"  , "narrator": "ぴょんこ", "text": "てかさー、\nみさみさが\n泣いちゃうよ？"},
        { "location": "596/TALK"  , "narrator": "ぴょんこ", "text": "神楽ちゃん、いつお風呂に\n入るかで悩んで心壊れる\n余りに繊細な子……。"},
        { "location": "597/TALK"  , "narrator": "ぴょんこ", "text": "母親としては\n辛いでしょそれ！"},
        { "location": "598/SEL"   , "narrator": "", "text": "そういう問題か！？"},
        { "location": "599/ACT"   , "narrator": "", "text": "そういう問題か！？"},
        { "location": "601/TALK"  , "narrator": "ぴょんこ", "text": "……まあ。"},
        { "location": "602/TALK"  , "narrator": "ぴょんこ", "text": "どっちでもいいですよ。"},
        { "location": "603/TALK"  , "narrator": "ぴょんこ", "text": "キスチケジャンケンでも、\n葛藤を解消するのでも。"},
        { "location": "604/SEL"   , "narrator": "", "text": "じゃあ、キスチケジャンケンで"},
        { "location": "605/SEL"   , "narrator": "", "text": "じゃあ、ココロの葛藤解消で"},
        { "location": "606/ACT"   , "narrator": "", "text": "じゃあ、キスチケジャンケンで"},
        { "location": "607/TALK"  , "narrator": "ぴょんこ", "text": "ですよねー！"},
        { "location": "609/TALK"  , "narrator": "ぴょんこ", "text": "それじゃ早速、サクッと\nやっちゃいましょう♪"},
        { "location": "611/TALK"  , "narrator": "ぴょんこ", "text": "と思いましたけど、\n既に事後でしたね…。"},
        { "location": "614/TALK"  , "narrator": "ぴょんこ", "text": "なーんて♪"},
        { "location": "615/TALK"  , "narrator": "ぴょんこ", "text": "正直者の\n$handle$さんは、\n今回も葛藤解消ですよね？"},
        { "location": "620/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんは、\n今キスチケを\n１枚も持っていませんね。"},
        { "location": "623/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんは、\n今キスチケを\n$pyonko_kissticket$枚持ってますね。"},
        { "location": "624/TALK"  , "narrator": "ぴょんこ", "text": "って！\n$pyonko_kissticket$枚！？"},
        { "location": "625/TALK"  , "narrator": "ぴょんこ", "text": "そういえばそうでした！\nおめでとうございます！"},
        { "location": "626/TALK"  , "narrator": "ぴょんこ", "text": "そしていよいよ、次回\n以降からご褒美の受付が\n開始されますよっ♪"},
        { "location": "627/TALK"  , "narrator": "ぴょんこ", "text": "具体的には、その時現実で\n私が着てる服をぴょんこも\n着て、キスしちゃいます♪"},
        { "location": "628/TALK"  , "narrator": "ぴょんこ", "text": "なので、次回以降ここに\nお越しの際には、是非！"},
        { "location": "629/TALK"  , "narrator": "ぴょんこ", "text": "お好みの服を\n着ておいてくださいね♪"},
        { "location": "630/TALK"  , "narrator": "ぴょんこ", "text": "あっ、でも！"},
        { "location": "631/TALK"  , "narrator": "ぴょんこ", "text": "今回ジャンケンに負けて\n2枚になっちゃったら、\n次回できませんので♪"},
        { "location": "632/TALK"  , "narrator": "ぴょんこ", "text": "今ならジャンケン見送りも\n可能ですけどどうします？"},
        { "location": "633/TALK"  , "narrator": "ぴょんこ", "text": "まあ、普通に考えたら\n見送った方がいいと\n思うんですよね♪"},
        { "location": "635/TALK"  , "narrator": "ぴょんこ", "text": "ただ、そんな中でも\nジャンケンしようという\n頭おか……"},
        { "location": "636/TALK"  , "narrator": "ぴょんこ", "text": "…いえ、勇者にはなんと！\n勝てば2枚ゲット、\n負けても1枚没収という―"},
        { "location": "637/TALK"  , "narrator": "ぴょんこ", "text": "スーパーサービス\nジャンケンに\nしちゃおうと思います♪"},
        { "location": "641/SEL"   , "narrator": "", "text": "見送る"},
        { "location": "642/SEL"   , "narrator": "", "text": "やる"},
        { "location": "643/ACT"   , "narrator": "", "text": "見送る"},
        { "location": "645/TALK"  , "narrator": "ぴょんこ", "text": "ですよねー。\n手堅い人生こそ\n幸せの第一歩！"},
        { "location": "647/ACT"   , "narrator": "", "text": "やる"},
        { "location": "648/TALK"  , "narrator": "ぴょんこ", "text": "おおっ！\n本気ですかっ！"},
        { "location": "652/TALK"  , "narrator": "ぴょんこ", "text": "それでは約束通り、\n今回はスーパーサービス\nジャンケンですよっ！"},
        { "location": "653/TALK"  , "narrator": "ぴょんこ", "text": "勝てばキスチケ2倍！\n負けても没収は1枚です。"},
        { "location": "658/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんは、\n今キスチケを\n$pyonko_kissticket$枚持ってますね。"},
        { "location": "662/TALK"  , "narrator": "ぴょんこ", "text": "それじゃ、\nいきますよっ！"},
        { "location": "682/TALK"  , "narrator": "ぴょんこ", "text": "ふわぁっ！\n負けちゃいました…。"},
        { "location": "690/TALK"  , "narrator": "ぴょんこ", "text": "約束通り、\nキスチケ２枚進呈ぴょん♪"},
        { "location": "698/TALK"  , "narrator": "ぴょんこ", "text": "約束通り、\nキスチケ１枚進呈ぴょん♪"},
        { "location": "707/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこの\n勝ちでーすっ♪"},
        { "location": "708/TALK"  , "narrator": "ぴょんこ", "text": "約束通り、\nキスチケ１枚没収ぴょん♪"},
        { "location": "713/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこの\n勝ちでーすっ♪"},
        { "location": "714/TALK"  , "narrator": "ぴょんこ", "text": "というわけで、\nプレゼントはナシ！！"},
        { "location": "721/TALK"  , "narrator": "ぴょんこ", "text": "ふぅ……\nとっても楽しかったです♪"},
        { "location": "724/TALK"  , "narrator": "ぴょんこ", "text": "って！\nああっ！！"},
        { "location": "725/TALK"  , "narrator": "ぴょんこ", "text": "おめでとうございます！\nキスチケ３枚\nゲットしちゃいましたね♪"},
        { "location": "726/TALK"  , "narrator": "ぴょんこ", "text": "いよいよ、次回以降から\nご褒美の受付が\n開始されますっ♪"},
        { "location": "727/TALK"  , "narrator": "ぴょんこ", "text": "具体的には、その時現実で\n私が着てる服をぴょんこも\n着て、キスしちゃいます♪"},
        { "location": "728/TALK"  , "narrator": "ぴょんこ", "text": "なので、次回以降ここに\nお越しの際には、是非！"},
        { "location": "729/TALK"  , "narrator": "ぴょんこ", "text": "お好みの服を\n着ておいてくださいね♪"},
        { "location": "731/ACT"   , "narrator": "", "text": "じゃあ、ココロの葛藤解消で"},
        { "location": "735/TALK"  , "narrator": "ぴょんこ", "text": "わかりましたぴょん。"},
        { "location": "737/TALK"  , "narrator": "ぴょんこ", "text": "でも…どうしましょうか。"},
        { "location": "738/SEL"   , "narrator": "", "text": "？"},
        { "location": "739/ACT"   , "narrator": "", "text": "？"},
        { "location": "741/TALK"  , "narrator": "ぴょんこ", "text": "ココロゲート、\n集合意識野への扉に\nセットされてますけど――"},
        { "location": "742/TALK"  , "narrator": "ぴょんこ", "text": "一度回したら、\nぴょんこではもうこの扉に\n戻せないんですよね。"},
        { "location": "743/SEL"   , "narrator": "", "text": "Oh…"},
        { "location": "746/TALK"  , "narrator": "ぴょんこ", "text": "それでも葛藤を\n対処するかどうか――"},
        { "location": "748/ACT"   , "narrator": "", "text": "待ってましたっ！"},
        { "location": "749/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん！！"},
        { "location": "755/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん？？"},
        { "location": "768/TALK"  , "narrator": "つばめ", "text": "卯月さーんヽ(*´∀｀)ノ"},
        { "location": "770/TALK"  , "narrator": "ぴょんこ", "text": "どうしたんですか？"},
        { "location": "771/TALK"  , "narrator": "つばめ", "text": "卯月さんこれからアカシックレコードっていうところに行くょね？"},
        { "location": "772/TALK"  , "narrator": "ぴょんこ", "text": "行きますけど"},
        { "location": "773/TALK"  , "narrator": "つばめ", "text": "そうすると、ココロの葛藤の解消が出来なくなっちゃうと思うんだょね(´・ω・｀)"},
        { "location": "774/TALK"  , "narrator": "ぴょんこ", "text": "そうですね"},
        { "location": "775/TALK"  , "narrator": "つばめ", "text": "だからね、今回はわたしが卯月さんの葛藤を解消するから"},
        { "location": "776/TALK"  , "narrator": "ぴょんこ", "text": "え？"},
        { "location": "777/TALK"  , "narrator": "つばめ", "text": "扉のアドレスだけ教えてくれれば、わたしが扉を回して解消しておくから、卯月さんはアカシクレコードに行ってきて！(*≧∀≦*) "},
        { "location": "778/TALK"  , "narrator": "ぴょんこ", "text": "ええっ、いいんですか？"},
        { "location": "779/TALK"  , "narrator": "つばめ", "text": "その為にお手伝いしに来てるんだし、WAVEだって交換したんだょ～～！"},
        { "location": "780/TALK"  , "narrator": "つばめ", "text": "だから、気にしないでね？"},
        { "location": "781/TALK"  , "narrator": "ぴょんこ", "text": "ありがとうございますぴょん♪"},
        { "location": "782/TALK"  , "narrator": "ぴょんこ", "text": "扉のアドレス調べますね"},
        { "location": "784/TALK"  , "narrator": "ぴょんこ", "text": "2x9FC番地だそうです♪"},
        { "location": "785/TALK"  , "narrator": "つばめ", "text": "ありがとぅぅぅぅ～～(*≧∀≦*) "},
        { "location": "786/TALK"  , "narrator": "つばめ", "text": "それじゃ、きおつけて行ってらっしゃい！"},
        { "location": "787/TALK"  , "narrator": "ぴょんこ", "text": "つばめさんも気をつけてくださいね"},
        { "location": "788/TALK"  , "narrator": "ぴょんこ", "text": "つばめさんとぴょんこに、素敵なココロの旅を♪"},
        { "location": "789/TALK"  , "narrator": "つばめ", "text": "素敵なココロの旅を！(●´人｀)"},
        { "location": "802/TALK"  , "narrator": "ぴょんこ", "text": "……解決、\nしちゃいましたね。"},
        { "location": "804/SEL"   , "narrator": "", "text": "お、おう"},
        { "location": "805/ACT"   , "narrator": "", "text": "お、おう"},
        { "location": "808/SEL"   , "narrator": "", "text": "お、おう"},
        { "location": "809/SEL"   , "narrator": "", "text": "えっと待って待って、それって$me$はジャンケン見送り損じゃん…"},
        { "location": "810/ACT"   , "narrator": "", "text": "お、おう"},
        { "location": "811/ACT"   , "narrator": "", "text": "えっと待って待って、それって$me$はジャンケン見送り損じゃん…"},
        { "location": "812/TALK"  , "narrator": "ぴょんこ", "text": "………。"},
        { "location": "813/TALK"  , "narrator": "ぴょんこ", "text": "まあ。"},
        { "location": "814/TALK"  , "narrator": "ぴょんこ", "text": "世の中なんて、\nそんなモンさぁ♪"},
        { "location": "815/TALK"  , "narrator": "ぴょんこ", "text": "この世はぶっちゃけ\n正直者に冷たいんですよ。"},
        { "location": "816/TALK"  , "narrator": "ぴょんこ", "text": "飄々と生きてるヤツが\n出世し、真面目にやっても\n馬鹿を見る人は見る。"},
        { "location": "817/TALK"  , "narrator": "ぴょんこ", "text": "世の中なんて、半分は\nギャンブルで、もう半分は\n要領の良さっすから。"},
        { "location": "818/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんが\n望む望まないにかかわらず\nクジ引かされてんですよ♪"},
        { "location": "819/TALK"  , "narrator": "ぴょんこ", "text": "ある意味公平？\nクククッ……。"},
        { "location": "820/TALK"  , "narrator": "ぴょんこ", "text": "でもね――"},
        { "location": "821/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこは、\n正直者がスキなんです。"},
        { "location": "822/TALK"  , "narrator": "ぴょんこ", "text": "ですから、誠実な\n$handle$さんが、\nショックで折れちゃって―"},
        { "location": "823/TALK"  , "narrator": "ぴょんこ", "text": "クズ人間になったりしたら\nぴょんこはとても悲しい。"},
        { "location": "824/TALK"  , "narrator": "ぴょんこ", "text": "なので今回は、\nサービスで１枚\nキスチケあげちゃいます♪"},
        { "location": "825/SEL"   , "narrator": "", "text": "やったー！！"},
        { "location": "826/ACT"   , "narrator": "", "text": "やったー！！"},
        { "location": "828/TALK"  , "narrator": "ぴょんこ", "text": "こういうことも\nありますから、絶対に\nクズにはならないでね？"},
        { "location": "829/TALK"  , "narrator": "ぴょんこ", "text": "そして、このクソゲー認定\n必至の現実を、頑張って\n一緒に生きてくぴょん♪"},
        { "location": "838/TALK"  , "narrator": "ぴょんこ", "text": "というわけで、\nせっかくつばめさんが\n手伝ってくれてますし！"},
        { "location": "839/TALK"  , "narrator": "ぴょんこ", "text": "集合意識野へ\n行っちゃいましょう♪"},
        { "location": "840/TALK"  , "narrator": "ぴょんこ", "text": "それでは、\n準備はいいですかっ！"},
        { "location": "842/SEL"   , "narrator": "", "text": "ぴょんこｽｷ"},
        { "location": "843/ACT"   , "narrator": "", "text": "ぴょんこｽｷ"},
        { "location": "847/TALK"  , "narrator": "ぴょんこ", "text": "きゃっ！\nここでですかっ！？"},
        { "location": "848/TALK"  , "narrator": "ぴょんこ", "text": "まさかここで来るなんて、\nちょっとビックリですっ！"},
        { "location": "849/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこも、\n$handle$さんの\nことが大好きですっ！"},
        { "location": "850/TALK"  , "narrator": "ぴょんこ", "text": "今回もふたりの共同作業、\n頑張りましょうねっ♪"},
        { "location": "852/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんと\nぴょんこに\n素敵なココロの旅を♪"},
        { "location": "863/TALK"  , "narrator": "ぴょんこ", "text": "……。"},
        { "location": "864/TALK"  , "narrator": "ぴょんこ", "text": "みんな私を\n助けてくれる。"},
        { "location": "865/TALK"  , "narrator": "ぴょんこ", "text": "……ありがとう。\nつばめさん、\n$handle$さん。"},
        { "location": "866/TALK"  , "narrator": "ぴょんこ", "text": "後でぴょんこも\nつばめさんに\n加勢しなくちゃですね。"},
        { "location": "882/TALK"  , "narrator": "エリカ", "text": "ストップ\nストップ\nストーップ！！"},
        { "location": "883/SEL"   , "narrator": "", "text": "エリカさん！？"},
        { "location": "884/ACT"   , "narrator": "", "text": "エリカさん！？"},
        { "location": "886/TALK"  , "narrator": "エリカ", "text": "ごめんね、\nほんとにごめん！"},
        { "location": "887/TALK"  , "narrator": "エリカ", "text": "ほんとは全て、\nあなたの気持ちが赴く\nままにさせてあげたいの。"},
        { "location": "888/TALK"  , "narrator": "エリカ", "text": "でも、今回の発言は\nあまりに未来に対する\n影響力が大きすぎて。"},
        { "location": "889/TALK"  , "narrator": "エリカ", "text": "今後に大きな支障が\n出ちゃいそうだったから\n切断させてもらいました。"},
        { "location": "890/SEL"   , "narrator": "", "text": "……ここは？"},
        { "location": "891/ACT"   , "narrator": "", "text": "……ここは？"},
        { "location": "893/TALK"  , "narrator": "エリカ", "text": "ブレークポイント。\nシステム領域だよ。"},
        { "location": "894/TALK"  , "narrator": "エリカ", "text": "本当は乱用したら\nいけない機能なんだけど。"},
        { "location": "895/TALK"  , "narrator": "エリカ", "text": "あなたの選択を\n軽視する行為でもあるし。"},
        { "location": "896/TALK"  , "narrator": "エリカ", "text": "でも今回は、それくらいの\nことだったということは\n解って欲しいかな。"},
        { "location": "897/TALK"  , "narrator": "エリカ", "text": "本当にごめんね。\nスタックポインタを最初に\n戻させてもらうから。"},
        { "location": "898/TALK"  , "narrator": "エリカ", "text": "それじゃ、またね。"},
        { "location": "28/DIALOG" , "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:Interrupt】</color>\nSystem Interrupted.\n\n必須選択肢が選ばれていません。\n\n<color=green>『STORY27：シン・カグラ』</color>\nにて、選択を行ってから\n再度アクセスしてください。\n"},
        { "location": "32/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>7月17日　7:36 PM</color>\nとある平日の夜、豊洲の神楽の自宅にて。"},
        { "location": "217/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "219/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "221/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "223/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "225/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "389/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "410/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"},
        { "location": "472/DIALOG", "narrator": "INFO", "text": "<color=green>【Tips】</color>\n\nみやびは毎回\n30％の確率で\n目を醒ますぞ！\n"},
        { "location": "639/DIALOG", "narrator": "Dialog_Notice", "text": "<color=green>【TRI-OS Plug-in:Libralian】</color>\n\nジャンケン自体は見送っても次回また挑戦できますが、スーパーサービスジャンケンは今回限りの施策となります。\n\n直後の選択肢で「見送る」を選択すると、次回ここに来てもスーパーサービスジャンケンにはなりませんのでご了承ください。\n"},
        { "location": "664/DIALOG", "narrator": "Dialog_Notice", "text": "<color=green>【TRI-OS Plug-in:Libralian】</color>\n\n<color=red>\nOKボタンを押すと、この選択は確定します。プレイの有無にかかわらず、以後やり直しはできなくなります。\n</color>\n以降ジャンケン終了までの間、通信環境が悪い場所などでの継続はお薦めしません。\n\nここでOKを押す前にアプリを終了（タスクキル）すれば、ギリギリキャンセル可能です。"},
        { "location": "692/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:Libralian】</color>\n\n<color=green>【キスチケ】</color>を\n２枚ゲットしました！"},
        { "location": "700/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:Libralian】</color>\n\n<color=green>【キスチケ】</color>を\n１枚ゲットしました！"},
        { "location": "710/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:Libralian】</color>\n\n<color=green>【キスチケ】</color>を\n１枚失いました…。"},
        { "location": "835/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:Libralian】</color>\n\n<color=green>【キスチケ】</color>を\n１枚ゲットしました！"},
        { "location": "873/DIALOG", "narrator": "NOTICE", "text": "<color=red>【TRI-OS Error:0x99】</color>\nココロスフィアとの回線が\n切断されました。(981)"}
