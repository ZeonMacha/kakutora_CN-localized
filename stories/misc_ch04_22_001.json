        { "location": "7/SCENARIO", "narrator": "", "text": "無抵抗という抵抗"},
        { "location": "34/TALK"   , "narrator": "みやび", "text": "何もせぬ"},
        { "location": "35/TALK"   , "narrator": "みやび", "text": "ああ"},
        { "location": "36/TALK"   , "narrator": "みやび", "text": "何もせぬとも"},
        { "location": "38/SEL"    , "narrator": "", "text": "今してることは？"},
        { "location": "39/SEL"    , "narrator": "", "text": "全力でさぼろうぜ！"},
        { "location": "40/SEL"    , "narrator": "", "text": "でも話はしてくれるんだね"},
        { "location": "41/ACT"    , "narrator": "", "text": "今してることは？"},
        { "location": "42/TALK"   , "narrator": "みやび", "text": "息をしている"},
        { "location": "43/TALK"   , "narrator": "みやび", "text": "いや"},
        { "location": "44/TALK"   , "narrator": "みやび", "text": "会話かの"},
        { "location": "45/ACT"    , "narrator": "", "text": "全力でさぼろうぜ！"},
        { "location": "46/TALK"   , "narrator": "みやび", "text": "そこまで"},
        { "location": "47/TALK"   , "narrator": "みやび", "text": "気合を入れずとも"},
        { "location": "48/ACT"    , "narrator": "", "text": "でも話はしてくれるんだね"},
        { "location": "50/TALK"   , "narrator": "みやび", "text": "まあな"},
        { "location": "51/TALK"   , "narrator": "みやび", "text": "これは"},
        { "location": "52/TALK"   , "narrator": "みやび", "text": "外すわけにはいかぬので"},
        { "location": "54/TALK"   , "narrator": "みやび", "text": "なんというか"},
        { "location": "55/TALK"   , "narrator": "みやび", "text": "ここしばらくは身辺の変化が激しすぎて"},
        { "location": "56/TALK"   , "narrator": "みやび", "text": "ついていけん"},
        { "location": "58/SEL"    , "narrator": "", "text": "そうだろうね"},
        { "location": "59/SEL"    , "narrator": "", "text": "それは甘え"},
        { "location": "60/SEL"    , "narrator": "", "text": "$me$がついてる"},
        { "location": "61/ACT"    , "narrator": "", "text": "そうだろうね"},
        { "location": "62/TALK"   , "narrator": "みやび", "text": "そうなのだ"},
        { "location": "63/TALK"   , "narrator": "みやび", "text": "だから"},
        { "location": "64/TALK"   , "narrator": "みやび", "text": "あえて何もせぬ"},
        { "location": "65/TALK"   , "narrator": "みやび", "text": "と"},
        { "location": "66/TALK"   , "narrator": "みやび", "text": "そんな気持ちに"},
        { "location": "68/TALK"   , "narrator": "みやび", "text": "なっておるのじゃよ"},
        { "location": "69/ACT"    , "narrator": "", "text": "それは甘え"},
        { "location": "70/TALK"   , "narrator": "みやび", "text": "$handle$は"},
        { "location": "71/TALK"   , "narrator": "みやび", "text": "しょうまっことへごながぁぞね"},
        { "location": "72/ACT"    , "narrator": "", "text": "$me$がついてる"},
        { "location": "74/TALK"   , "narrator": "みやび", "text": "うむ"},
        { "location": "75/TALK"   , "narrator": "みやび", "text": "そう思うと多少は気力が戻るぞね"},
        { "location": "76/TALK"   , "narrator": "みやび", "text": "あ"},
        { "location": "77/TALK"   , "narrator": "みやび", "text": "あくまで"},
        { "location": "78/TALK"   , "narrator": "みやび", "text": "多少だからの"},
        { "location": "80/TALK"   , "narrator": "みやび", "text": "だからといって"},
        { "location": "81/TALK"   , "narrator": "みやび", "text": "人生はリセットできんちや"}
