        "title": "Twitter Archive 003",
        "sub_title": "卯月画廊：お祭りガブちゃん♪"
    },
    "entry":
    [
        { "location": "27/TALK"   , "narrator": "透明アーヤ", "text": "卯月の描いたギャヴィ、\nとっても可愛いと思うわ。"},
        { "location": "28/TALK"   , "narrator": "透明神楽", "text": "ふふっ、自信作だったので\n褒めていただけると\n嬉しいです。"},
        { "location": "29/TALK"   , "narrator": "透明神楽", "text": "ガブちゃんも、\n気に入ってくれましたか？"},
        { "location": "30/TALK"   , "narrator": "透明ガブリエラ", "text": "ええ、とっても素敵で\n気に入ったわ。"},
        { "location": "32/TALK"   , "narrator": "透明神楽", "text": "やった！"},
        { "location": "33/TALK"   , "narrator": "透明ガブリエラ", "text": "ただ…本当に着るなら、\nもう少し布が多い方が\nいいけど…。"},
        { "location": "34/TALK"   , "narrator": "透明アーヤ", "text": "確かに布は少ないけど、\nこれはこれで可愛いと\n思うけど？"},
        { "location": "35/TALK"   , "narrator": "透明ガブリエラ", "text": "そ、そうかしら？"},
        { "location": "37/TALK"   , "narrator": "透明神楽", "text": "粋な江戸っ子、って\n感じをイメージして\n描いたんですよ。"},
        { "location": "38/TALK"   , "narrator": "透明神楽", "text": "それに、これくらい\nじゃないとお神輿は\n担げませんよ？"},
        { "location": "40/TALK"   , "narrator": "透明ガブリエラ", "text": "そ、そうなんだ…。\n男の人は上半身裸で\n担いだりしてるものね。"},
        { "location": "41/TALK"   , "narrator": "透明ガブリエラ", "text": "そういえば、ふんどしも\n付けなきゃいけない、って\nアーヤが言ってたわ。"},
        { "location": "42/TALK"   , "narrator": "透明アーヤ", "text": "そ、そのことは\n忘れていいから…。"},
        { "location": "44/TALK"   , "narrator": "透明ガブリエラ", "text": "なんで？\nっていうか、この絵には\nふんどし描いてないの？"},
        { "location": "45/TALK"   , "narrator": "透明神楽", "text": "ごめんなさい…。\nさすがに、それを描く\n勇気ありませんでした…。"},
        { "location": "46/TALK"   , "narrator": "透明ガブリエラ", "text": "…？\nまあ、これはこれで\n可愛いからいいけどね。"},
        { "location": "47/SEL"    , "narrator": "（選択肢）", "text": "おへそ可愛い！"},
        { "location": "48/SEL"    , "narrator": "（選択肢）", "text": "ハッピガブリエラ、可愛いね"},
        { "location": "49/ACT"    , "narrator": "", "text": "おへそ可愛い！"},
        { "location": "55/TALK"   , "narrator": "ガブリエラ", "text": "マルザンナ！"},
        { "location": "57/TALK"   , "narrator": "ガブリエラ", "text": "そういうところ見たらダメよ！"},
        { "location": "58/TALK"   , "narrator": "ガブリエラ", "text": "見えてはいるけど"},
        { "location": "59/TALK"   , "narrator": "ガブリエラ", "text": "ジッと見るのは"},
        { "location": "60/TALK"   , "narrator": "ガブリエラ", "text": "失礼よ"},
        { "location": "61/SEL"    , "narrator": "（選択肢）", "text": "あまりにも可愛くて"},
        { "location": "62/SEL"    , "narrator": "（選択肢）", "text": "失礼だったかな？"},
        { "location": "63/ACT"    , "narrator": "", "text": "あまりにも可愛くて"},
        { "location": "64/TALK"   , "narrator": "ガブリエラ", "text": "だからって見ないの"},
        { "location": "66/TALK"   , "narrator": "ガブリエラ", "text": "絵の中の私だけど"},
        { "location": "67/TALK"   , "narrator": "ガブリエラ", "text": "恥ずかしくなってくるわ"},
        { "location": "68/ACT"    , "narrator": "", "text": "失礼だったかな？"},
        { "location": "69/TALK"   , "narrator": "ガブリエラ", "text": "服を褒めずにおへそ褒めるとか"},
        { "location": "70/TALK"   , "narrator": "ガブリエラ", "text": "レディに対する態度ではないわ"},
        { "location": "72/TALK"   , "narrator": "ガブリエラ", "text": "まずは服を見なさいよ"},
        { "location": "73/TALK"   , "narrator": "ガブリエラ", "text": "服を見なさいよ"},
        { "location": "75/ACT"    , "narrator": "", "text": "ハッピガブリエラ、可愛いね"},
        { "location": "81/TALK"   , "narrator": "ガブリエラ", "text": "ありがと"},
        { "location": "83/TALK"   , "narrator": "ガブリエラ", "text": "神楽は本当に絵が上手"},
        { "location": "84/TALK"   , "narrator": "ガブリエラ", "text": "ちょっと元気なかったけど"},
        { "location": "85/TALK"   , "narrator": "ガブリエラ", "text": "この絵のおかげで"},
        { "location": "86/TALK"   , "narrator": "ガブリエラ", "text": "元気出たわ"},
        { "location": "87/SEL"    , "narrator": "（選択肢）", "text": "元気なかったの？"},
        { "location": "88/ACT"    , "narrator": "", "text": "元気なかったの？"},
        { "location": "90/TALK"   , "narrator": "ガブリエラ", "text": "花火の写真を見てたら"},
        { "location": "91/TALK"   , "narrator": "ガブリエラ", "text": "ちょっと"},
        { "location": "92/TALK"   , "narrator": "ガブリエラ", "text": "ホームシックになっちゃったの"},
        { "location": "93/TALK"   , "narrator": "ガブリエラ", "text": "ハッキリ言わないけど"},
        { "location": "94/TALK"   , "narrator": "ガブリエラ", "text": "私のこと"},
        { "location": "95/TALK"   , "narrator": "ガブリエラ", "text": "元気づけるために描いてくれたみたい"},
        { "location": "99/TALK"   , "narrator": "ガブリエラ", "text": "お祭りといえば浴衣かと思ったけど"},
        { "location": "100/TALK"  , "narrator": "ガブリエラ", "text": "こういうスタイルもいいわね"},
        { "location": "101/TALK"  , "narrator": "ガブリエラ", "text": "今度お祭り行く時は"},
        { "location": "103/TALK"  , "narrator": "ガブリエラ", "text": "ハッピで参加しようかしら？"},
        { "location": "104/SEL"   , "narrator": "（選択肢）", "text": "かっこいいと思うよ"},
        { "location": "105/SEL"   , "narrator": "（選択肢）", "text": "サラシは過激だからシャツを着よう"},
        { "location": "106/ACT"   , "narrator": "", "text": "一度付けてもいいかもね"},
        { "location": "107/TALK"  , "narrator": "ガブリエラ", "text": "マルザンナもそう思う？"},
        { "location": "108/TALK"  , "narrator": "ガブリエラ", "text": "浴衣は素敵だけど"},
        { "location": "109/TALK"  , "narrator": "ガブリエラ", "text": "ハッピはかっこいい"},
        { "location": "110/TALK"  , "narrator": "ガブリエラ", "text": "そう思うでしょ？"},
        { "location": "111/ACT"   , "narrator": "", "text": "サラシは過激だからシャツを着よう"},
        { "location": "112/TALK"  , "narrator": "ガブリエラ", "text": "そうかしら？"},
        { "location": "113/TALK"  , "narrator": "ガブリエラ", "text": "結構気に入ってるんだけど"},
        { "location": "114/TALK"  , "narrator": "ガブリエラ", "text": "かっこいいでしょ//////"},
        { "location": "115/SEL"   , "narrator": "（選択肢）", "text": "かっこいいとは思うよ"},
        { "location": "116/SEL"   , "narrator": "（選択肢）", "text": "ちょっと目のやり場に困る…"},
        { "location": "117/ACT"   , "narrator": "", "text": "かっこいいとは思うよ"},
        { "location": "118/TALK"  , "narrator": "ガブリエラ", "text": "でしょ？"},
        { "location": "119/TALK"  , "narrator": "ガブリエラ", "text": "それにハッピ着てる女の人は"},
        { "location": "120/TALK"  , "narrator": "ガブリエラ", "text": "みんなこの格好なんだから"},
        { "location": "121/TALK"  , "narrator": "ガブリエラ", "text": "一人だけ違ったら変だもの"},
        { "location": "122/ACT"   , "narrator": "", "text": "ちょっと目のやり場に困る…"},
        { "location": "123/TALK"  , "narrator": "ガブリエラ", "text": "そうかしら？"},
        { "location": "125/TALK"  , "narrator": "ガブリエラ", "text": "言われたら"},
        { "location": "126/TALK"  , "narrator": "ガブリエラ", "text": "ちょっと恥ずかしくなってきたかも////////"},
        { "location": "128/TALK"  , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "129/TALK"  , "narrator": "ガブリエラ", "text": "やっぱり着てみたいわ"},
        { "location": "132/TALK"  , "narrator": "ガブリエラ", "text": "早速"},
        { "location": "133/TALK"  , "narrator": "ガブリエラ", "text": "近くでお祭りやらないか調べるから"},
        { "location": "134/TALK"  , "narrator": "ガブリエラ", "text": "お話はまた夜にね"},
        { "location": "142/DIALOG", "narrator": "", "text": "このシナリオの元になっている\nTwitterの会話ログを見ますか？"}
    ]
}
