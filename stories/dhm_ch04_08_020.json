    "entry":
    [
        { "location": "85/SCENARIO", "narrator": "", "text": "000_第七藝術"},
        { "location": "110/TALK"   , "narrator": "みやび", "text": "ネットオークションで落札したフィルム"},
        { "location": "111/TALK"   , "narrator": "みやび", "text": "使えると思うか？"},
        { "location": "114/SEL"    , "narrator": "", "text": "使えるんでしょ？"},
        { "location": "115/SEL"    , "narrator": "", "text": "フレームバイフレーム変換が必要かな"},
        { "location": "116/SEL"    , "narrator": "", "text": "どうかな"},
        { "location": "117/ACT"    , "narrator": "", "text": "使えるんでしょ？"},
        { "location": "119/TALK"   , "narrator": "みやび", "text": "さあ"},
        { "location": "120/TALK"   , "narrator": "みやび", "text": "どうじゃろうか"},
        { "location": "121/ACT"    , "narrator": "", "text": "フレームバイフレーム変換が必要かな"},
        { "location": "122/TALK"   , "narrator": "みやび", "text": "ふむ"},
        { "location": "123/TALK"   , "narrator": "みやび", "text": "やり方はあるのか"},
        { "location": "124/ACT"    , "narrator": "", "text": "どうかな"},
        { "location": "125/TALK"   , "narrator": "みやび", "text": "この"},
        { "location": "126/TALK"   , "narrator": "みやび", "text": "無責任男め"},
        { "location": "129/TALK"   , "narrator": "みやび", "text": "しかしまあ"},
        { "location": "130/TALK"   , "narrator": "みやび", "text": "まほさんの説教から逃れるためとはいえ"},
        { "location": "131/TALK"   , "narrator": "みやび", "text": "情報収集に時間がかかったぞね"},
        { "location": "133/SEL"    , "narrator": "", "text": "そんな説教されるの？"},
        { "location": "134/SEL"    , "narrator": "", "text": "映画に詳しくなった？"},
        { "location": "135/SEL"    , "narrator": "", "text": "何度も通用するかな？"},
        { "location": "136/ACT"    , "narrator": "", "text": "そんな説教されるの？"},
        { "location": "137/TALK"   , "narrator": "みやび", "text": "いや"},
        { "location": "138/TALK"   , "narrator": "みやび", "text": "ホントのところは検索が楽しくなって探しまくっただけぞね"},
        { "location": "139/TALK"   , "narrator": "みやび", "text": "そういうこともある"},
        { "location": "140/ACT"    , "narrator": "", "text": "映画に詳しくなった？"},
        { "location": "141/TALK"   , "narrator": "みやび", "text": "タイトルだけな"},
        { "location": "142/TALK"   , "narrator": "みやび", "text": "まほさん好みの古い映画の法則は"},
        { "location": "143/TALK"   , "narrator": "みやび", "text": "キワモノタイトル"},
        { "location": "144/TALK"   , "narrator": "みやび", "text": "それもどうなのか"},
        { "location": "145/TALK"   , "narrator": "みやび", "text": "嫌いじゃないけどな"},
        { "location": "146/ACT"    , "narrator": "", "text": "何度も通用するかな？"},
        { "location": "148/TALK"   , "narrator": "みやび", "text": "いい質問ではないか"},
        { "location": "149/TALK"   , "narrator": "みやび", "text": "策は打ってある"},
        { "location": "150/TALK"   , "narrator": "みやび", "text": "いや"},
        { "location": "151/TALK"   , "narrator": "みやび", "text": "それ以前にまほさんは意外と単純ゆえ"},
        { "location": "152/TALK"   , "narrator": "みやび", "text": "大丈夫と見る"},
        { "location": "153/TALK"   , "narrator": "みやび", "text": "ま"},
        { "location": "154/TALK"   , "narrator": "みやび", "text": "念のためよさげなアルコールでも見繕っとくぞね"}
    ]
}
