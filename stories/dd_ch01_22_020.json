{
    "dir": "chap22/daydra/dd_ch01_22_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "22156",
        "cid": "tsubame",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "神楽との距離"
    },
    "entry":
    [
        { "location": "255/SCENARIO", "narrator": "", "text": "神楽との距離"},
        { "location": "267/TALK"    , "narrator": "つばめ", "text": "あれ？\n神楽ちゃん、いませんか？"},
        { "location": "270/TALK"    , "narrator": "アーヤ", "text": "どこに行ったのかしら？\nさっきまでここにいたん\nだけど…。"},
        { "location": "271/TALK"    , "narrator": "アーヤ", "text": "散歩にでも行ったの\nかもしれないわ。\nＷＡＶＥ送ってみたら？"},
        { "location": "272/TALK"    , "narrator": "つばめ", "text": "そうしてみます。"},
        { "location": "280/TALK"    , "narrator": "つばめ", "text": "えっと…\n今、どこにいるの？"},
        { "location": "281/TALK"    , "narrator": "つばめ", "text": "送信、っと。"},
        { "location": "282/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "286/TALK"    , "narrator": "つばめ", "text": "あ、返ってきた。\nえっと――"},
        { "location": "287/TALK"    , "narrator": "つばめ", "text": "コンビニに行ってきます。\n欲しい物があったら\n言ってください…。"},
        { "location": "289/TALK"    , "narrator": "つばめ", "text": "…コンビニ行くなら、\n誘ってくれれば\n良かったのに。"},
        { "location": "290/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "297/TALK"    , "narrator": "つばめ", "text": "神楽ちゃん、やっぱりまだ落ち込んでるのかな？"},
        { "location": "298/TALK"    , "narrator": "つばめ", "text": "なんとなくだけど、ちょっと距離を開けられてる気がするの"},
        { "location": "299/TALK"    , "narrator": "つばめ", "text": "今も、こんな時間に一人でコンビニに行っちゃうし…"},
        { "location": "300/TALK"    , "narrator": "つばめ", "text": "…それとも、わたしの考え過ぎかな？"},
        { "location": "302/SEL"     , "narrator": "", "text": "避けられてるみたい"},
        { "location": "303/SEL"     , "narrator": "", "text": "今から追いかければ？"},
        { "location": "304/SEL"     , "narrator": "", "text": "アイスでも頼もうよ"},
        { "location": "305/ACT"     , "narrator": "", "text": "避けられてるみたい"},
        { "location": "308/TALK"    , "narrator": "つばめ", "text": "やっぱり、そうなのかな？"},
        { "location": "309/TALK"    , "narrator": "つばめ", "text": "一応仲直りはしたんだけど"},
        { "location": "310/TALK"    , "narrator": "つばめ", "text": "…でも、やっぱり何か引っかかるかも"},
        { "location": "321/TALK"    , "narrator": "つばめ", "text": "…よし、決めた！"},
        { "location": "332/TALK"    , "narrator": "神楽", "text": "…………。"},
        { "location": "333/TALK"    , "narrator": "つばめ", "text": "いた！\n神楽ちゃーん！"},
        { "location": "348/TALK"    , "narrator": "神楽", "text": "つばめさん！？"},
        { "location": "350/TALK"    , "narrator": "つばめ", "text": "はぁ、はぁ…よかったぁ。\n行き違いにならなくて。"},
        { "location": "351/TALK"    , "narrator": "神楽", "text": "走ってきたんですか！？\nそんなに息切らせて…。"},
        { "location": "354/TALK"    , "narrator": "つばめ", "text": "はぁ、はぁ…うん。"},
        { "location": "355/TALK"    , "narrator": "つばめ", "text": "どうしても、神楽ちゃんに\n会いたくて…。"},
        { "location": "356/TALK"    , "narrator": "神楽", "text": "えっ？"},
        { "location": "358/TALK"    , "narrator": "つばめ", "text": "二人っきりで、\nお話したかったの。"},
        { "location": "361/TALK"    , "narrator": "神楽", "text": "…つばめさん、さっきから\n狙ってドキッとさせること\n言ってませんか？"},
        { "location": "362/TALK"    , "narrator": "つばめ", "text": "えっ？\nえっと、よくわからないん\nだけど…。"},
        { "location": "366/TALK"    , "narrator": "神楽", "text": "…そうですよね。\nつばめさんはそういう\nタイプじゃありませんし。"},
        { "location": "368/TALK"    , "narrator": "神楽", "text": "それはともかく、\n別にここまで来なくても\n良かったじゃないですか。"},
        { "location": "369/TALK"    , "narrator": "神楽", "text": "話なら、私が帰ってから\nでもできるのに…。"},
        { "location": "370/TALK"    , "narrator": "つばめ", "text": "それだと、神楽ちゃんに\n逃げられちゃいそうな\n気がするし…。"},
        { "location": "373/TALK"    , "narrator": "神楽", "text": "…………。"},
        { "location": "374/TALK"    , "narrator": "つばめ", "text": "神楽ちゃんのことは、\nこれでも結構わかってる\nつもりだよ。"},
        { "location": "375/TALK"    , "narrator": "神楽", "text": "…………。"},
        { "location": "376/TALK"    , "narrator": "つばめ", "text": "間違ってた？"},
        { "location": "381/TALK"    , "narrator": "神楽", "text": "…本当、つばめさんって\n狙わずに相手をドキッと\nさせる天才ですね。"},
        { "location": "382/TALK"    , "narrator": "神楽", "text": "そこまでわかられてると、\n少しだけ悔しいです。"},
        { "location": "383/TALK"    , "narrator": "つばめ", "text": "そうなの？"},
        { "location": "385/TALK"    , "narrator": "神楽", "text": "そうですよ。\nけど、私だって負けて\nませんよ。"},
        { "location": "386/TALK"    , "narrator": "神楽", "text": "私も、つばめさんからの\n返信をもらった時――"},
        { "location": "388/TALK"    , "narrator": "神楽", "text": "多分追いかけてくる、\nって思ってましたし。"},
        { "location": "389/TALK"    , "narrator": "つばめ", "text": "えっ、そうなの！？"},
        { "location": "390/TALK"    , "narrator": "神楽", "text": "何ヶ月一緒にいると\n思ってるんですか？"},
        { "location": "391/TALK"    , "narrator": "神楽", "text": "私だって、つばめさんの\nことは結構わかっている\nつもりなんですよ？"},
        { "location": "392/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "394/TALK"    , "narrator": "つばめ", "text": "嬉しいけど、ちょっとだけ\n恥ずかしいかも。"},
        { "location": "396/TALK"    , "narrator": "神楽", "text": "最初に言い出したのは\nつばめさんの方じゃ\nないですか、もぅ…。"},
        { "location": "398/TALK"    , "narrator": "つばめ", "text": "えへへ…。"},
        { "location": "399/TALK"    , "narrator": "つばめ", "text": "少し遠回りして、\nお散歩しながら帰らない？"},
        { "location": "400/TALK"    , "narrator": "つばめ", "text": "わたし、もう少しだけ\n神楽ちゃんとお話したいな。"},
        { "location": "402/TALK"    , "narrator": "神楽", "text": "…………。"},
        { "location": "403/TALK"    , "narrator": "つばめ", "text": "ダメ？"},
        { "location": "404/TALK"    , "narrator": "神楽", "text": "いえ…私も、もう少し\nつばめさんとお話したい\nです。"},
        { "location": "405/TALK"    , "narrator": "神楽", "text": "こっち来てから、あんまり\nお話してませんでしたし。"},
        { "location": "407/TALK"    , "narrator": "つばめ", "text": "うん！"},
        { "location": "408/TALK"    , "narrator": "つばめ", "text": "わたし、夜の砂浜に\n行ってみたいな。"},
        { "location": "410/TALK"    , "narrator": "神楽", "text": "そんなところに\n誘うなんて――"},
        { "location": "412/TALK"    , "narrator": "神楽", "text": "つばめさん、もしかして\nまた押し倒されたいとか\n思ってませんか？"},
        { "location": "415/TALK"    , "narrator": "つばめ", "text": "えぇっ！？\nち、違うよぉ！"},
        { "location": "417/TALK"    , "narrator": "神楽", "text": "ふふっ、冗談ですよ。"},
        { "location": "420/TALK"    , "narrator": "神楽", "text": "つばめさんが慌てる、\n可愛いところを\n見たかっただけです。"},
        { "location": "437/ACT"     , "narrator": "", "text": "今から追いかければ？"},
        { "location": "438/TALK"    , "narrator": "つばめ", "text": "そうしようかな？"},
        { "location": "439/TALK"    , "narrator": "つばめ", "text": "それなら、歩きながらお話もできるし"},
        { "location": "444/TALK"    , "narrator": "つばめ", "text": "えっと…わたしも今から\n行くよ、と…送信！"},
        { "location": "445/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "449/TALK"    , "narrator": "つばめ", "text": "あ、返ってきた。"},
        { "location": "450/TALK"    , "narrator": "つばめ", "text": "…もう終わるところなので\n良いです…。"},
        { "location": "452/TALK"    , "narrator": "つばめ", "text": "はぁ…。"},
        { "location": "454/TALK"    , "narrator": "つばめ", "text": "やっぱり、避けられ\nてるのかも…。"},
        { "location": "455/TALK"    , "narrator": "つばめ", "text": "合宿中に、もう一度\n機会を見つけて二人きりで\n話したいな…。"},
        { "location": "456/ACT"     , "narrator": "", "text": "アイスでも頼もうよ"},
        { "location": "458/TALK"    , "narrator": "つばめ", "text": "わたしの考え過ぎってこと？"},
        { "location": "459/TALK"    , "narrator": "つばめ", "text": "そうなのかな？"},
        { "location": "465/TALK"    , "narrator": "つばめ", "text": "う～ん…。"},
        { "location": "466/TALK"    , "narrator": "つばめ", "text": "でも、仲直りはちゃんと\nしたんだし…。"},
        { "location": "467/TALK"    , "narrator": "つばめ", "text": "…そうだよね？\n多分、考え過ぎだよね。"},
        { "location": "468/TALK"    , "narrator": "つばめ", "text": "それじゃあ、アイスを\n買ってきてください。\n送信！"},
        { "location": "480/TALK"    , "narrator": "神楽", "text": "…ただいま戻りました。"},
        { "location": "482/TALK"    , "narrator": "つばめ", "text": "あ、おかえりなさい、\n神楽ちゃん。"},
        { "location": "485/TALK"    , "narrator": "神楽", "text": "つばめさん。\n頼まれていたアイス、\nこれで良いですか？"},
        { "location": "487/TALK"    , "narrator": "つばめ", "text": "うん、ありがと！"},
        { "location": "488/TALK"    , "narrator": "神楽", "text": "…………。"},
        { "location": "489/TALK"    , "narrator": "つばめ", "text": "神楽ちゃん？"},
        { "location": "492/TALK"    , "narrator": "神楽", "text": "はぁ…いえ、いいんです。"},
        { "location": "493/TALK"    , "narrator": "神楽", "text": "もしかしたら、なんて\n思ってた私がバカでした。"},
        { "location": "496/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "499/TALK"    , "narrator": "つばめ", "text": "わたし、何かしちゃったの\nかな？"},
        { "location": "264/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>8月27日　 4:22 PM</color>\n合宿中、みやびの実家でのこと"},
        { "location": "431/DIALOG"  , "narrator": "Dialog_GEThimegoto_ch01", "text": "【手と手の間】"}
    ]
}
