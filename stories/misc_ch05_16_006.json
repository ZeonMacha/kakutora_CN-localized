    [
        { "location": "5127/SCENARIO", "narrator": "", "text": "ニジゲンモドキ"},
        { "location": "5152/TALK"    , "narrator": "神楽", "text": "２．５次元舞台ってあるじゃないですかー"},
        { "location": "5153/TALK"    , "narrator": "神楽", "text": "ぴょんこ０．５の部分が気になってしょうがないんですけどー？"},
        { "location": "5155/SEL"     , "narrator": "", "text": "人の子よ…ついに次元の隙間に気付いてしまったのか…"},
        { "location": "5156/SEL"     , "narrator": "", "text": "いや別に"},
        { "location": "5157/SEL"     , "narrator": "", "text": "どっちつかずだよね"},
        { "location": "5158/ACT"     , "narrator": "", "text": "人の子よ…ついに次元の隙間に気付いてしまったのか…"},
        { "location": "5160/TALK"    , "narrator": "神楽", "text": "おお神よ、、、"},
        { "location": "5162/TALK"    , "narrator": "神楽", "text": "これが深淵に至る隙間なのですね、、、"},
        { "location": "5163/ACT"     , "narrator": "", "text": "いや別に"},
        { "location": "5164/TALK"    , "narrator": "神楽", "text": "あれ変だな"},
        { "location": "5165/ACT"     , "narrator": "", "text": "どっちつかずだよね"},
        { "location": "5166/TALK"    , "narrator": "神楽", "text": "でしょー？"},
        { "location": "5168/TALK"    , "narrator": "神楽", "text": "いや意図してることはわかるぴょん"},
        { "location": "5169/TALK"    , "narrator": "神楽", "text": "二次元でも三次元でもないんだ！むしろ両方のいいとこどりなんだ！みたいなさ！"},
        { "location": "5170/TALK"    , "narrator": "神楽", "text": "でもほら、、、正直どっちのよさもなくなってるっていうか、、、ちょっとアレだよね！？ってのもあるからさ、、、"},
        { "location": "5172/SEL"     , "narrator": "", "text": "ああ（察し）"},
        { "location": "5173/SEL"     , "narrator": "", "text": "それ言っちゃいけないやつ"},
        { "location": "5174/SEL"     , "narrator": "", "text": "神楽はいつでも最高でしょ？"},
        { "location": "5175/ACT"     , "narrator": "", "text": "ああ（察し）"},
        { "location": "5176/TALK"    , "narrator": "神楽", "text": "あれは誰得なんだろうね？"},
        { "location": "5178/TALK"    , "narrator": "神楽", "text": "ほんとどうにかならないのかなー"},
        { "location": "5179/ACT"     , "narrator": "", "text": "それ言っちゃいけないやつ"},
        { "location": "5180/TALK"    , "narrator": "神楽", "text": "あえてタブーに切り込むのがぴょんこだから！"},
        { "location": "5181/TALK"    , "narrator": "神楽", "text": "本当は$handlek$もそう思ってるんでしょ？"},
        { "location": "5182/TALK"    , "narrator": "神楽", "text": "素直になるぴょん♪"},
        { "location": "5183/ACT"     , "narrator": "", "text": "神楽はいつでも最高でしょ？"},
        { "location": "5185/TALK"    , "narrator": "神楽", "text": "そんな話してないしー"},
        { "location": "5186/TALK"    , "narrator": "神楽", "text": "でも$handlek$がぴょんこのこと好きで好きで好きで好きで仕方ないことは理解いたしました"},
        { "location": "5187/TALK"    , "narrator": "神楽", "text": "かわいいね$handlek$♪"},
        { "location": "5189/TALK"    , "narrator": "神楽", "text": "なでなでしてあげるぴょん"}
    ]
}
