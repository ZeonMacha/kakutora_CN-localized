{
    "dir": "chap22/daydra/anime_05_22.js",
    "type": "MainStory",
    "info": {
        "story_id": "22501",
        "cid": "kagura",
        "title": "001 アニメーション",
        "sub_title": "独白"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "アニメ第22話"},
        { "location": "21/TALK"   , "narrator": "エリカ", "text": "コーンコン。"},
        { "location": "22/TALK"   , "narrator": "エリカ", "text": "いらっしゃい\n$handle$さん。"},
        { "location": "23/TALK"   , "narrator": "エリカ", "text": "もう一度お話聞く？\nそれとも、省略する？"},
        { "location": "24/SEL"    , "narrator": "", "text": "もう一度聞く"},
        { "location": "25/SEL"    , "narrator": "", "text": "飛ばす"},
        { "location": "26/ACT"    , "narrator": "", "text": "もう一度聞く"},
        { "location": "27/TALK"   , "narrator": "エリカ", "text": "うん、わかったよ。"},
        { "location": "29/ACT"    , "narrator": "", "text": "飛ばす"},
        { "location": "30/TALK"   , "narrator": "エリカ", "text": "そっかー。\nそれじゃ、またね。"},
        { "location": "37/TALK"   , "narrator": "エリカ", "text": "コーンコン。"},
        { "location": "38/TALK"   , "narrator": "エリカ", "text": "いらっしゃい\n$handle$さん。"},
        { "location": "40/TALK"   , "narrator": "エリカ", "text": "いきなりだけど、\n本題に入るよ。"},
        { "location": "41/TALK"   , "narrator": "エリカ", "text": "前回、\nにゃぼにゃすティー！の\n時にお話もらっていた件。"},
        { "location": "42/TALK"   , "narrator": "エリカ", "text": "そもそも長官自体が\n出てこなかったっていう\nあの件なんだけどね。"},
        { "location": "43/TALK"   , "narrator": "エリカ", "text": "色々調べて見たところ、\nちょっと心当たりが\n見つかったの。"},
        { "location": "44/TALK"   , "narrator": "エリカ", "text": "貴方を含む総意全体のうち\nおよそ１割に当たる人達の\nデイドラ時間がズレてる。"},
        { "location": "45/TALK"   , "narrator": "エリカ", "text": "そして、貴方もその\nズレた時間でデイドラを\n再生していた一人なの。"},
        { "location": "46/TALK"   , "narrator": "エリカ", "text": "どうしてこっちで指定した\n時間帯からズレた所を再生\nしてたのかは、まだ不明。"},
        { "location": "47/TALK"   , "narrator": "エリカ", "text": "TRI-OSのバグなのか、\nそれとも何らかの\nシステム故障なのか。"},
        { "location": "48/TALK"   , "narrator": "エリカ", "text": "もうちょっと調べてみて、\n何か解ったら千羽鶴ちゃん\nから報告してもらうね。"},
        { "location": "49/TALK"   , "narrator": "エリカ", "text": "早く直すから\nもうちょっとだけ\n待っていてね？"},
        { "location": "50/SEL"    , "narrator": "", "text": "ていうかエリカさん、もしかしてこの件には噛んでないの？"},
        { "location": "51/ACT"    , "narrator": "", "text": "ていうかエリカさん、もしかしてこの件には噛んでないの？"},
        { "location": "53/TALK"   , "narrator": "エリカ", "text": "え？\nなんのこと！？"},
        { "location": "54/SEL"    , "narrator": "", "text": "原初のつばめがラブラブルートと世界に関わるルートを分けたことだよ"},
        { "location": "55/ACT"    , "narrator": "", "text": "原初のつばめがラブラブルートと世界に関わるルートを分けたことだよ"},
        { "location": "61/TALK"   , "narrator": "エリカ", "text": "前回は、特にリプレイスを\nせずに進行した感じかな？"},
        { "location": "62/TALK"   , "narrator": "エリカ", "text": "参考までに、リプレイスを\nしなかった理由を教えて\nくれると嬉しいな。"},
        { "location": "63/SEL"    , "narrator": "", "text": "前にも言ったけど、作戦に賛同できないから"},
        { "location": "64/SEL"    , "narrator": "", "text": "えっと、どこでリプレイスできたのかわかりませんでした"},
        { "location": "65/SEL"    , "narrator": "", "text": "やっぱり千羽鶴がかわいそう"},
        { "location": "66/SEL"    , "narrator": "", "text": "神楽の人生をねじ曲げることはできない"},
        { "location": "67/ACT"    , "narrator": "", "text": "前にも言ったけど、作戦に賛同できないから"},
        { "location": "69/TALK"   , "narrator": "エリカ", "text": "そっか、わかったよ。"},
        { "location": "70/TALK"   , "narrator": "エリカ", "text": "ならそのまま、その想いを\n持っていて欲しいかな。"},
        { "location": "71/ACT"    , "narrator": "", "text": "えっと、どこでリプレイスできたのかわかりませんでした"},
        { "location": "73/TALK"   , "narrator": "エリカ", "text": "あっ、ちょっと\n解りづらかったかな？"},
        { "location": "74/TALK"   , "narrator": "エリカ", "text": "前回、ココロゲートから\n戻った後に、長官の正体を\n伝える選択があって。"},
        { "location": "75/TALK"   , "narrator": "エリカ", "text": "あなたはそこで、\n何も言わない方を\n選んでると思うの。"},
        { "location": "76/TALK"   , "narrator": "エリカ", "text": "そこがリプレイス\nポイントになってるよ。"},
        { "location": "77/TALK"   , "narrator": "エリカ", "text": "よかったら、\nもう一度やってみてね？"},
        { "location": "78/ACT"    , "narrator": "", "text": "やっぱり千羽鶴がかわいそう"},
        { "location": "80/TALK"   , "narrator": "エリカ", "text": "そっかー。"},
        { "location": "81/TALK"   , "narrator": "エリカ", "text": "でも、その行動を依頼して\nいるのもまた千羽鶴ちゃん\nだったりするから――"},
        { "location": "82/TALK"   , "narrator": "エリカ", "text": "その理由で反対する場合、\n今の千羽鶴ちゃんが\n可哀想だったりしない？"},
        { "location": "83/TALK"   , "narrator": "エリカ", "text": "あっ、ごめんね、\n今のは単にわたしが\n思ったことだから……。"},
        { "location": "84/TALK"   , "narrator": "エリカ", "text": "あなたが長官の思想や\n立場を大事にしたいと\n思うなら、いいと思うよ。"},
        { "location": "85/ACT"    , "narrator": "", "text": "神楽の人生をねじ曲げることはできない"},
        { "location": "87/TALK"   , "narrator": "エリカ", "text": "そうだね。"},
        { "location": "88/TALK"   , "narrator": "エリカ", "text": "それを言われると、\n確かにそうなんだけどね。"},
        { "location": "89/TALK"   , "narrator": "エリカ", "text": "わたしからしてみれば、\n神楽ちゃんの人生にとって\n悪い事ではないと思うけど"},
        { "location": "90/TALK"   , "narrator": "エリカ", "text": "そこは人それぞれだから。"},
        { "location": "91/TALK"   , "narrator": "エリカ", "text": "そもそも他人の人生に\n介入すること自体が\nダメって考えもあるし。"},
        { "location": "92/TALK"   , "narrator": "エリカ", "text": "だから、\nそれでいいと思うよ。"},
        { "location": "94/TALK"   , "narrator": "エリカ", "text": "ただ、そんなあなたに、\nわたしから１つだけ\nお願いがあって。"},
        { "location": "95/TALK"   , "narrator": "エリカ", "text": "もし、生理的に\n受け付けない、とかで\nなければ――"},
        { "location": "96/TALK"   , "narrator": "エリカ", "text": "試しに、リプレイスする\n選択もしつつ、色々な\n結果を見て欲しいの。"},
        { "location": "99/TALK"   , "narrator": "エリカ", "text": "前回はリプレイスに\n協力してくれて\nありがとう。"},
        { "location": "101/TALK"  , "narrator": "エリカ", "text": "でも、ちょっとだけ\n困ったことがあって。"},
        { "location": "102/SEL"   , "narrator": "", "text": "どうしたの？"},
        { "location": "103/SEL"   , "narrator": "", "text": "また何かやらかした？"},
        { "location": "104/ACT"   , "narrator": "", "text": "どうしたの？"},
        { "location": "105/ACT"   , "narrator": "", "text": "また何かやらかした？"},
        { "location": "106/TALK"  , "narrator": "エリカ", "text": "うーん、\nやらかした…か。\n確かにわたしのせいかも。"},
        { "location": "108/TALK"  , "narrator": "エリカ", "text": "あのね――"},
        { "location": "109/TALK"  , "narrator": "エリカ", "text": "前回のリプレイスでは、\n長官に嘘をつくように\n仕掛けてもらったよね？"},
        { "location": "110/TALK"  , "narrator": "エリカ", "text": "千羽鶴ちゃんも、\n十中八九あの場面では\n嘘をつくだろうって……"},
        { "location": "111/TALK"  , "narrator": "エリカ", "text": "自分の考え方からすれば\n嘘をつかないという選択は\n早々できないって。"},
        { "location": "112/TALK"  , "narrator": "エリカ", "text": "そう言っていたんだよね。\nけど――"},
        { "location": "113/TALK"  , "narrator": "エリカ", "text": "長官は、神楽ちゃんに\n自分がつばめちゃんの\nクランだと伝えた。"},
        { "location": "114/TALK"  , "narrator": "エリカ", "text": "これは、わたしたちに\nとってはすごい誤算で。"},
        { "location": "115/TALK"  , "narrator": "エリカ", "text": "今、次の作戦を考えていた\nところだったの。"},
        { "location": "116/SEL"   , "narrator": "", "text": "それは大変だね"},
        { "location": "117/SEL"   , "narrator": "", "text": "ごめんなさい"},
        { "location": "118/ACT"   , "narrator": "", "text": "それは大変だね"},
        { "location": "119/TALK"  , "narrator": "エリカ", "text": "ありがとう。\nでも大丈夫。"},
        { "location": "120/TALK"  , "narrator": "エリカ", "text": "リプレイスは決められた\nレールの上を行くような\n単純なものじゃない。"},
        { "location": "121/TALK"  , "narrator": "エリカ", "text": "こういったイレギュラーも\n発生するって、最初から\n覚悟はしてたからね。"},
        { "location": "123/TALK"  , "narrator": "エリカ", "text": "というか、今回の件は\n実はそんなに悲観視は\nしてないんだ。"},
        { "location": "124/TALK"  , "narrator": "エリカ", "text": "というのも、あの後\nまほちゃんに相談するよう\n言ってくれたでしょ？"},
        { "location": "125/TALK"  , "narrator": "エリカ", "text": "あれのお陰で、\n神楽ちゃんが長官の嘘を\n１つ見つけてるから。"},
        { "location": "127/ACT"   , "narrator": "", "text": "ごめんなさい"},
        { "location": "128/TALK"  , "narrator": "エリカ", "text": "え？\nどうしたの？\n急に謝っちゃって……。"},
        { "location": "129/SEL"   , "narrator": "", "text": "原初のつばめに言われて、$me$が千羽鶴に正直に言うよう進言した"},
        { "location": "130/ACT"   , "narrator": "", "text": "原初のつばめに言われて、$me$が千羽鶴に正直に言うよう進言した"},
        { "location": "135/TALK"  , "narrator": "エリカ", "text": "原初の……？"},
        { "location": "136/TALK"  , "narrator": "エリカ", "text": "え"},
        { "location": "137/TALK"  , "narrator": "エリカ", "text": "えええええええっ！！"},
        { "location": "138/TALK"  , "narrator": "エリカ", "text": "いつ！？"},
        { "location": "139/SEL"   , "narrator": "", "text": "前回だけど"},
        { "location": "140/ACT"   , "narrator": "", "text": "前回だけど"},
        { "location": "142/TALK"  , "narrator": "エリカ", "text": "どこで！？"},
        { "location": "143/SEL"   , "narrator": "", "text": "ここで"},
        { "location": "144/ACT"   , "narrator": "", "text": "ここで"},
        { "location": "146/TALK"  , "narrator": "エリカ", "text": "それはちょっと\nあり得ないんだけど……"},
        { "location": "147/SEL"   , "narrator": "", "text": "毎回会ってるよ！"},
        { "location": "148/SEL"   , "narrator": "", "text": "でもエリカも前に「また会いに来るかも」って言ってたよね？"},
        { "location": "149/ACT"   , "narrator": "", "text": "毎回会ってるよ！"},
        { "location": "150/TALK"  , "narrator": "エリカ", "text": "毎回！？\nそうなんだ……うーん。"},
        { "location": "151/ACT"   , "narrator": "", "text": "でもエリカも前に「また会いに来るかも」って言ってたよね？"},
        { "location": "152/TALK"  , "narrator": "エリカ", "text": "確かに言ったよ？"},
        { "location": "153/TALK"  , "narrator": "エリカ", "text": "でも、それ以降\n一度も顔を出してない\n状況だったし――"},
        { "location": "155/TALK"  , "narrator": "エリカ", "text": "えっと、ちなみに\n直前に会ったのは、いつ？"},
        { "location": "156/SEL"   , "narrator": "", "text": "エピソード１６のここ"},
        { "location": "157/ACT"   , "narrator": "", "text": "エピソード１６のここ"},
        { "location": "159/TALK"  , "narrator": "エリカ", "text": "エピソード１６…？"},
        { "location": "161/TALK"  , "narrator": "エリカ", "text": "やっぱり……。"},
        { "location": "162/TALK"  , "narrator": "エリカ", "text": "エピソード１６は、\nここが使われたという\nログは残ってないね。"},
        { "location": "163/TALK"  , "narrator": "エリカ", "text": "他には、１４，１０，８\nそれと５と２。"},
        { "location": "164/TALK"  , "narrator": "エリカ", "text": "これらは、わたしも\n千羽鶴ちゃんも、誰も\n使ってない。"},
        { "location": "165/SEL"   , "narrator": "", "text": "幽霊！？"},
        { "location": "166/SEL"   , "narrator": "", "text": "$me$の言葉が信用出来ないの？"},
        { "location": "167/ACT"   , "narrator": "", "text": "幽霊！？"},
        { "location": "168/TALK"  , "narrator": "エリカ", "text": "そういうのは\n無いと思うけど……"},
        { "location": "169/ACT"   , "narrator": "", "text": "$me$の言葉が信用出来ないの？"},
        { "location": "170/TALK"  , "narrator": "エリカ", "text": "信用してるよぅ。\nただ、データとして\n何も残ってないだけで。"},
        { "location": "172/TALK"  , "narrator": "エリカ", "text": "ひとつ可能性があると\nするならば……。"},
        { "location": "173/TALK"  , "narrator": "エリカ", "text": "別レイヤーからの\nアクセスというのは\nあるかもしれない。"},
        { "location": "174/SEL"   , "narrator": "", "text": "別レイヤーって？"},
        { "location": "175/SEL"   , "narrator": "", "text": "もうちょっと解りやすく言って"},
        { "location": "176/ACT"   , "narrator": "", "text": "別レイヤーって？"},
        { "location": "177/ACT"   , "narrator": "", "text": "もうちょっと解りやすく言って"},
        { "location": "179/TALK"  , "narrator": "エリカ", "text": "時間、空間、異世界――"},
        { "location": "180/TALK"  , "narrator": "エリカ", "text": "いわゆる3次元空間上では\n行き来出来ない場所を\n総じて別レイヤーと言う。"},
        { "location": "186/TALK"  , "narrator": "エリカ", "text": "例えば、今、わたしと\n千羽鶴ちゃんが、連絡を\nとりあってやれてるのは―"},
        { "location": "187/TALK"  , "narrator": "エリカ", "text": "二人が同じ時間軸で\n同期した状態だから。"},
        { "location": "188/TALK"  , "narrator": "エリカ", "text": "もう少し具体的に言うと、"},
        { "location": "189/TALK"  , "narrator": "エリカ", "text": "わたしも彼女も、\n一度日本のフェノメノンが\n瓦解する危機を経て――"},
        { "location": "190/TALK"  , "narrator": "エリカ", "text": "その後2016年3月の観測に\n戻り、そこからもずっと\n共にしている。"},
        { "location": "191/TALK"  , "narrator": "エリカ", "text": "だから、今CH05に\n出入りしてるわたしと\n千羽鶴ちゃんは――"},
        { "location": "192/TALK"  , "narrator": "エリカ", "text": "互いを認識も出来るし、\nある程度ログから行動も\n把握することが出来るの。"},
        { "location": "193/TALK"  , "narrator": "エリカ", "text": "けど、別レイヤーだと\nそれはできない。"},
        { "location": "194/TALK"  , "narrator": "エリカ", "text": "わかりやすい\n例を挙げると――"},
        { "location": "195/TALK"  , "narrator": "エリカ", "text": "今いるこのエピソード１７\nでも、CH01～CH04を\n利用する千羽鶴ちゃんは、"},
        { "location": "196/TALK"  , "narrator": "エリカ", "text": "CH05のわたしたちを\n認識することができない。"},
        { "location": "197/TALK"  , "narrator": "エリカ", "text": "わたしたちも実際、\nCH01～CH04を\n直接認識は出来ず――"},
        { "location": "198/TALK"  , "narrator": "エリカ", "text": "何故知ってるかといえば、\n過去に歩んできたから\nというアナログな理由。"},
        { "location": "199/TALK"  , "narrator": "エリカ", "text": "それと同じように、\nもし原初のつばめちゃんが\n別レイヤにいる場合――"},
        { "location": "200/TALK"  , "narrator": "エリカ", "text": "わたしたちから\n彼女を認識することは\nできない。"},
        { "location": "205/SEL"   , "narrator": "", "text": "じゃあ、エリカと千羽鶴は、原初のつばめとは絶対に繋がれないってこと？"},
        { "location": "206/ACT"   , "narrator": "", "text": "じゃあ、エリカと千羽鶴は、原初のつばめとは絶対に繋がれないってこと？"},
        { "location": "208/TALK"  , "narrator": "エリカ", "text": "少なくとも、現状では。"},
        { "location": "209/TALK"  , "narrator": "エリカ", "text": "彼女の接続している\n接続元のアドレスとか、\nわかればまた別だけど…。"},
        { "location": "210/TALK"  , "narrator": "エリカ", "text": "――っと！"},
        { "location": "211/TALK"  , "narrator": "エリカ", "text": "とにかく、そっちの方は\n何か手がかりを\n探ってみるけど！"},
        { "location": "212/TALK"  , "narrator": "エリカ", "text": "問題は、その\n原初のつばめちゃんが――"},
        { "location": "214/TALK"  , "narrator": "エリカ", "text": "ルートを分けてる？\nラブラブルート？？\nそれはどういう事かな？"},
        { "location": "215/SEL"   , "narrator": "", "text": "トライナリーやエリカさんたちとラブラブするだけのアプリにしてくれたの"},
        { "location": "216/ACT"   , "narrator": "", "text": "トライナリーやエリカさんたちとラブラブするだけのアプリにしてくれたの"},
        { "location": "218/TALK"  , "narrator": "エリカ", "text": "えっ！？\nえっ！？！？\nそれって――"},
        { "location": "219/TALK"  , "narrator": "エリカ", "text": "原初のつばめちゃんが\nTRI-OSの管理者権限を\n持ってるってこと？？"},
        { "location": "220/TALK"  , "narrator": "エリカ", "text": "うーん……。\nまあとにかく――"},
        { "location": "222/TALK"  , "narrator": "エリカ", "text": "リプレイスを操作してる？"},
        { "location": "223/TALK"  , "narrator": "エリカ", "text": "それについての\n詳しい話を、他にも\n教えてもらえないかな？"},
        { "location": "224/SEL"   , "narrator": "", "text": "「わたしは誰よりも自分のことを解ってるから信じて」みたいな感じだった"},
        { "location": "225/ACT"   , "narrator": "", "text": "「わたしは誰よりも自分のことを解ってるから信じて」みたいな感じだった"},
        { "location": "227/TALK"  , "narrator": "エリカ", "text": "……。"},
        { "location": "228/TALK"  , "narrator": "エリカ", "text": "なるほど。"},
        { "location": "230/TALK"  , "narrator": "エリカ", "text": "何にしても、\n状況はわかったよ。"},
        { "location": "231/TALK"  , "narrator": "エリカ", "text": "この件は、千羽鶴ちゃんと\n相談して、状況を確認して\nいこうと思う。"},
        { "location": "232/TALK"  , "narrator": "エリカ", "text": "だから少しの間、\nわたしたちに\n預けてもらえないかな。"},
        { "location": "233/SEL"   , "narrator": "", "text": "$me$はこれからどうすれば？"},
        { "location": "234/ACT"   , "narrator": "", "text": "$me$はこれからどうすれば？"},
        { "location": "236/TALK"  , "narrator": "エリカ", "text": "今すぐ何か\n出来るわけでもないし――"},
        { "location": "237/TALK"  , "narrator": "エリカ", "text": "あまりヘンな動きをすると\n状況がオオゴトになって\nしまうかもしれないから、"},
        { "location": "238/TALK"  , "narrator": "エリカ", "text": "今まで通り、\n流れに沿って観測を\n続けて欲しいかな。"},
        { "location": "239/TALK"  , "narrator": "エリカ", "text": "何かあれば、すぐに\n報告してもらえると\n嬉しいです。"},
        { "location": "240/SEL"   , "narrator": "", "text": "わかったよ"},
        { "location": "241/ACT"   , "narrator": "", "text": "わかったよ"},
        { "location": "243/TALK"  , "narrator": "エリカ", "text": "ありがとう。"},
        { "location": "245/TALK"  , "narrator": "エリカ", "text": "まあ、ただ今回の件は\n実はそんなに悲観視は\nしてないんだ。"},
        { "location": "246/TALK"  , "narrator": "エリカ", "text": "というのも、あの後\nまほちゃんに相談するよう\n言ってくれたでしょ？"},
        { "location": "247/TALK"  , "narrator": "エリカ", "text": "あれのお陰で、\n神楽ちゃんが長官の嘘を\n１つ見つけてるから。"},
        { "location": "248/TALK"  , "narrator": "エリカ", "text": "その選択が、\nうまく事を運ぶのを\n祈ってる感じかな。"},
        { "location": "251/TALK"  , "narrator": "エリカ", "text": "でもね――"},
        { "location": "252/TALK"  , "narrator": "エリカ", "text": "今回の1件で、\n改めて思ったことが\nあって。"},
        { "location": "253/SEL"   , "narrator": "", "text": "なに？"},
        { "location": "254/ACT"   , "narrator": "", "text": "なに？"},
        { "location": "256/TALK"  , "narrator": "エリカ", "text": "もしかすると、\nあなたにとって、\nこのリプレイス作戦は――"},
        { "location": "257/TALK"  , "narrator": "エリカ", "text": "あまり歓迎できない\nものなのかな？…って。"},
        { "location": "259/TALK"  , "narrator": "エリカ", "text": "計画は順調！"},
        { "location": "260/TALK"  , "narrator": "エリカ", "text": "千羽鶴ちゃんが\n予測した通り、\n長官は嘘の発言をした。"},
        { "location": "261/TALK"  , "narrator": "エリカ", "text": "後はどうやって\nそれを使って\n交渉するかだけど――"},
        { "location": "262/TALK"  , "narrator": "エリカ", "text": "それについては、\n次回千羽鶴ちゃんから\n説明してもらうね。"},
        { "location": "263/TALK"  , "narrator": "エリカ", "text": "ところで。"},
        { "location": "264/TALK"  , "narrator": "エリカ", "text": "あなたはリプレイス作戦を\n滞りなく遂行してくれて\nいるけど――"},
        { "location": "266/TALK"  , "narrator": "エリカ", "text": "本当のところ、\nどう思ってる？"},
        { "location": "267/TALK"  , "narrator": "エリカ", "text": "この作戦は、\n良い作戦だと思う？"},
        { "location": "269/SEL"   , "narrator": "", "text": "そもそも一度もリプレイスに関わってないです……"},
        { "location": "270/ACT"   , "narrator": "", "text": "そもそも一度もリプレイスに関わってないです……"},
        { "location": "272/TALK"  , "narrator": "エリカ", "text": "あっ、そっか……。"},
        { "location": "273/TALK"  , "narrator": "エリカ", "text": "デイドラで、別の時間軸を\n参照しちゃってるんだった\nよね。"},
        { "location": "274/TALK"  , "narrator": "エリカ", "text": "とにかく、状況について\n調査はするけど――"},
        { "location": "275/TALK"  , "narrator": "エリカ", "text": "今回のリプレイスの\n確定前には間に合わない\nかもしれない。"},
        { "location": "276/SEL"   , "narrator": "", "text": "そもそも世界に関わらない選択をしたのは$me$だから、そこは気にしないで"},
        { "location": "277/SEL"   , "narrator": "", "text": "まあ、仕方ないか"},
        { "location": "278/ACT"   , "narrator": "", "text": "そもそも世界に関わらない選択をしたのは$me$だから、そこは気にしないで"},
        { "location": "280/TALK"  , "narrator": "エリカ", "text": "そっか。\n気遣ってくれて\nありがとう。"},
        { "location": "281/ACT"   , "narrator": "", "text": "まあ、仕方ないか"},
        { "location": "282/TALK"  , "narrator": "エリカ", "text": "ごめんね。"},
        { "location": "284/TALK"  , "narrator": "エリカ", "text": "何にしても、一刻も早く\n状況を把握して\n改善するからね。"},
        { "location": "285/TALK"  , "narrator": "エリカ", "text": "それじゃ……"},
        { "location": "286/TALK"  , "narrator": "エリカ", "text": "記録映像でも\n見ていく？"},
        { "location": "289/SEL"   , "narrator": "", "text": "思う"},
        { "location": "290/SEL"   , "narrator": "", "text": "どうだろうね"},
        { "location": "291/ACT"   , "narrator": "", "text": "思う"},
        { "location": "292/TALK"  , "narrator": "エリカ", "text": "そっか！\nそれは嬉しいよ。"},
        { "location": "293/TALK"  , "narrator": "エリカ", "text": "けど、できれば\n１つだけお願いがあって。"},
        { "location": "294/ACT"   , "narrator": "", "text": "どうだろうね"},
        { "location": "298/TALK"  , "narrator": "エリカ", "text": "もし可能なら、様々な\n選択の可能性を\n観測して欲しいの。"},
        { "location": "299/SEL"   , "narrator": "", "text": "色んな選択肢を試すってこと？"},
        { "location": "300/ACT"   , "narrator": "", "text": "色んな選択肢を試すってこと？"},
        { "location": "302/TALK"  , "narrator": "エリカ", "text": "そう。"},
        { "location": "305/TALK"  , "narrator": "エリカ", "text": "神楽ちゃんの\nフェノメノンが\n収束するとき――"},
        { "location": "306/TALK"  , "narrator": "エリカ", "text": "今回の\n第一次リプレイス作戦は\nマージされて確定する。"},
        { "location": "307/TALK"  , "narrator": "エリカ", "text": "世界進行法による確定は、\nエピソード２０。"},
        { "location": "308/TALK"  , "narrator": "エリカ", "text": "そこにソイルトンの\n量子アニーリングを\n予約してある。"},
        { "location": "309/TALK"  , "narrator": "エリカ", "text": "それまでは何度でも、\n貴方が関わる世界の流れを\n変える事ができるから――"},
        { "location": "310/TALK"  , "narrator": "エリカ", "text": "もし時間が許すなら、\n可能な限り色々な流れを\n体験して欲しいの。"},
        { "location": "311/TALK"  , "narrator": "エリカ", "text": "もちろん、わたしたちは\n神楽ちゃんが主導権を握る\n未来を計画してる。"},
        { "location": "312/TALK"  , "narrator": "エリカ", "text": "それは、わたしたちが\n考え得る上で最高の\n作戦だと思ってるけど――"},
        { "location": "313/TALK"  , "narrator": "エリカ", "text": "けど、それは机上の空論\nでしかないのも事実で。"},
        { "location": "314/TALK"  , "narrator": "エリカ", "text": "だから、\n実際にあなたに様々な\n選択をしてもらって――"},
        { "location": "315/TALK"  , "narrator": "エリカ", "text": "それぞれの\n“選択した結果の未来”を\n観測して欲しいの。"},
        { "location": "316/TALK"  , "narrator": "エリカ", "text": "そうすることで、わたしや\n千羽鶴ちゃんが気づいて\nいない穴を見つけられる。"},
        { "location": "317/SEL"   , "narrator": "", "text": "その結果、$me$はエリカさんの作戦とは違う結果を選ぶかもしれないよ？"},
        { "location": "318/ACT"   , "narrator": "", "text": "その結果、$me$はエリカさんの作戦とは違う結果を選ぶかもしれないよ？"},
        { "location": "320/TALK"  , "narrator": "エリカ", "text": "もちろん、\nそれならそれでいいよ。"},
        { "location": "321/TALK"  , "narrator": "エリカ", "text": "さっきも言ったけど、\n今回の作戦が、絶対的に\n正しいとは思ってない。"},
        { "location": "322/TALK"  , "narrator": "エリカ", "text": "パラメトリック理論に\n基づく世界進行法は――"},
        { "location": "323/TALK"  , "narrator": "エリカ", "text": "多数の思考によって\n多角的に分析した結果の\n解を出すものでもある。"},
        { "location": "324/TALK"  , "narrator": "エリカ", "text": "あなたたちの総意が出した\nその解が、今回の作戦と\n違うものであるなら――"},
        { "location": "325/TALK"  , "narrator": "エリカ", "text": "それは、今回の作戦が\nベストなものではないと\nいうことを意味する。"},
        { "location": "326/TALK"  , "narrator": "エリカ", "text": "もちろん、あなたたちが\nわたしたちの幸せを考えて\nくれている前提だけど。"},
        { "location": "327/TALK"  , "narrator": "エリカ", "text": "でも、そのあたりは\nあまり心配してないかな。"},
        { "location": "328/TALK"  , "narrator": "エリカ", "text": "あなたは……"},
        { "location": "329/TALK"  , "narrator": "エリカ", "text": "綾ちゃんたちや、\n千羽鶴ちゃんを\n大切に想ってくれている。"},
        { "location": "330/TALK"  , "narrator": "エリカ", "text": "だからこそ、悪意を持って\nこの世界を潰す選択を\nしないと思ってるから。"},
        { "location": "331/SEL"   , "narrator": "", "text": "信頼してくれてありがとう"},
        { "location": "332/SEL"   , "narrator": "", "text": "けど、彼女たちと世界を天秤にかけるような状況も起こりうるよね？"},
        { "location": "333/SEL"   , "narrator": "", "text": "残念だけど、色々思うところがあり、今はそっちの世界潰れろって思ってる"},
        { "location": "334/ACT"   , "narrator": "", "text": "信頼してくれてありがとう"},
        { "location": "335/TALK"  , "narrator": "エリカ", "text": "うん。"},
        { "location": "336/TALK"  , "narrator": "エリカ", "text": "こっちこそ、\nずっとつき合ってくれて\nありがとう。"},
        { "location": "337/ACT"   , "narrator": "", "text": "けど、彼女たちと世界を天秤にかけるような状況も起こりうるよね？"},
        { "location": "338/TALK"  , "narrator": "エリカ", "text": "そうだね。\nけど――"},
        { "location": "339/TALK"  , "narrator": "エリカ", "text": "わたしはそこについては、\n最終的には大きな問題には\nならないと思ってるの。"},
        { "location": "340/TALK"  , "narrator": "エリカ", "text": "綾ちゃんたちを大事に\n思うってことは、幸せに\n暮らせる事を願うこと。"},
        { "location": "341/TALK"  , "narrator": "エリカ", "text": "ならば、そのフィールドで\nある世界もまた、どういう\n状態であれ大事にする。"},
        { "location": "342/TALK"  , "narrator": "エリカ", "text": "そう思ってるから。"},
        { "location": "343/ACT"   , "narrator": "", "text": "残念だけど、色々思うところがあり、今はそっちの世界潰れろって思ってる"},
        { "location": "344/TALK"  , "narrator": "エリカ", "text": "そっか。"},
        { "location": "345/TALK"  , "narrator": "エリカ", "text": "……。"},
        { "location": "346/TALK"  , "narrator": "エリカ", "text": "じゃあ、正直に教えて\nくれたから、わたしも\n１つ正直に言うね。"},
        { "location": "347/TALK"  , "narrator": "エリカ", "text": "パラメトリック理論に\n基づく世界進行法は、\nセーフティネットでもある。"},
        { "location": "348/TALK"  , "narrator": "エリカ", "text": "すなわち、悪意のある\n世界操作や、極端な思想の\n個人がいたとしても――"},
        { "location": "349/TALK"  , "narrator": "エリカ", "text": "最終的には誰もが70点と\n思えるような結果を出せる\n手法でもあるから。"},
        { "location": "350/TALK"  , "narrator": "エリカ", "text": "もちろん少数の悪意は、\n少数でも何らかの形で\n反映されてしまうけど――"},
        { "location": "351/TALK"  , "narrator": "エリカ", "text": "それが主幹線になることは\n限りなく少ない。"},
        { "location": "352/TALK"  , "narrator": "エリカ", "text": "それが、この世界進行法の\n最大の長所とも言える。"},
        { "location": "353/TALK"  , "narrator": "エリカ", "text": "同じ理由で、短所もまた\nあるんだけど。"},
        { "location": "354/TALK"  , "narrator": "エリカ", "text": "とにかく。\nそういうわけで、悪意は\n反映されにくい。"},
        { "location": "355/TALK"  , "narrator": "エリカ", "text": "もちろん、総意の殆どが\n悪意のある人達だったら\n話は別だけどね……。"},
        { "location": "356/TALK"  , "narrator": "エリカ", "text": "それはまたちょっと\n別の問題とも\nいえることだから。"},
        { "location": "357/TALK"  , "narrator": "エリカ", "text": "いずれにせよ、\nわたしの考えは\n変わらないよ。"},
        { "location": "358/TALK"  , "narrator": "エリカ", "text": "千羽鶴ちゃんが選んだ\nあなただから、わたしは\nあなたを信じる。"},
        { "location": "360/TALK"  , "narrator": "エリカ", "text": "というわけで――"},
        { "location": "361/TALK"  , "narrator": "エリカ", "text": "マージされる\nエピソード２０までの間、\nよろしくお願いします！"},
        { "location": "362/SEL"   , "narrator": "", "text": "最善を尽くすよ"},
        { "location": "363/SEL"   , "narrator": "", "text": "それはそうと、最終的にエリカがどうしたいか解らないと判断できない"},
        { "location": "364/ACT"   , "narrator": "", "text": "最善を尽くすよ"},
        { "location": "365/TALK"  , "narrator": "エリカ", "text": "頼りにしてるからね！"},
        { "location": "366/ACT"   , "narrator": "", "text": "それはそうと、最終的にエリカがどうしたいか解らないと判断できない"},
        { "location": "367/TALK"  , "narrator": "エリカ", "text": "そうだね。"},
        { "location": "368/TALK"  , "narrator": "エリカ", "text": "さすがにリプレイスの\n確定前に共有しないと、\n判断できないよね。"},
        { "location": "369/TALK"  , "narrator": "エリカ", "text": "まだできるかどうか、\n確証がない事も、計画に\n含まれているから――"},
        { "location": "370/TALK"  , "narrator": "エリカ", "text": "本当は、それらが全部\n確実になってからに\nしたかったんだけどね。"},
        { "location": "371/TALK"  , "narrator": "エリカ", "text": "でも、わたしも\n千羽鶴ちゃんと、\n同じ事を話していて。"},
        { "location": "372/TALK"  , "narrator": "エリカ", "text": "結論としては、\n次のエピソードで\n千羽鶴ちゃんが伝えます。"},
        { "location": "373/SEL"   , "narrator": "", "text": "わかった"},
        { "location": "374/ACT"   , "narrator": "", "text": "わかった"},
        { "location": "377/TALK"  , "narrator": "エリカ", "text": "ありがと。"},
        { "location": "378/TALK"  , "narrator": "エリカ", "text": "それじゃ、\n現状についての報告は\nおしまい。"},
        { "location": "379/TALK"  , "narrator": "エリカ", "text": "次に、今回神楽ちゃんの\nデイドラでお願いしたい\nことを伝えるけど――"},
        { "location": "380/TALK"  , "narrator": "エリカ", "text": "その前に、記録映像を\n見ていくのはどうかな？"},
        { "location": "383/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/100MB 6:28】</color>"},
        { "location": "384/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/33MB 6:28】</color>"},
        { "location": "385/SEL"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "386/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/100MB 6:28】</color>"},
        { "location": "387/TALK"  , "narrator": "エリカ", "text": "わかったよ。"},
        { "location": "393/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/33MB 6:28】</color>"},
        { "location": "394/TALK"  , "narrator": "エリカ", "text": "わかったよ。"},
        { "location": "400/ACT"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "401/TALK"  , "narrator": "エリカ", "text": "あらら。"},
        { "location": "434/TALK"  , "narrator": "エリカ", "text": "――というわけで、\n神楽ちゃんのフェノメノン\n発生前夜だね。"},
        { "location": "435/TALK"  , "narrator": "エリカ", "text": "ここから３エピソードで\nリプレイスの総意が\nFIXされることになる。"},
        { "location": "436/TALK"  , "narrator": "エリカ", "text": "だから、それまでに\n色んなことを試して\nもらえたら嬉しいな。"},
        { "location": "438/TALK"  , "narrator": "エリカ", "text": "さて、それじゃ、\n今回やって欲しい事の\nお願いだけど――"},
        { "location": "440/TALK"  , "narrator": "エリカ", "text": "とりあえず、原因が\n判明するまでは、今のまま\n観測を続けていて欲しい。"},
        { "location": "441/TALK"  , "narrator": "エリカ", "text": "もしかしたら、\nその中に何か発見が\nあるかもしれないし。"},
        { "location": "442/TALK"  , "narrator": "エリカ", "text": "何かあったら、\nわたしか千羽鶴ちゃんに\n報告してね。"},
        { "location": "445/TALK"  , "narrator": "エリカ", "text": "さっきも少し\nお話したことだけど――"},
        { "location": "446/TALK"  , "narrator": "エリカ", "text": "よければ、リプレイスする\n方の選択も、してみて\nもらえたら嬉しいな。"},
        { "location": "447/TALK"  , "narrator": "エリカ", "text": "それで、やっぱり\n納得いかない、という\nことであれば――"},
        { "location": "448/TALK"  , "narrator": "エリカ", "text": "エピソード２０の\n確定タイミングまでに\n元に戻してもらえれば。"},
        { "location": "449/TALK"  , "narrator": "エリカ", "text": "ただ、もちろんこれも\n強制じゃないから、\n無理にはしなくていいよ？"},
        { "location": "450/TALK"  , "narrator": "エリカ", "text": "でも、もしこのまま\nリプレイスせずに\n進むなら――"},
        { "location": "451/TALK"  , "narrator": "エリカ", "text": "そのついでに１つだけ\nお願いしたい事があって。"},
        { "location": "452/SEL"   , "narrator": "", "text": "なに？"},
        { "location": "453/ACT"   , "narrator": "", "text": "なに？"},
        { "location": "460/TALK"  , "narrator": "エリカ", "text": "長官に本当の事を\n言わせちゃった件について\n対策を考えてみたの。"},
        { "location": "462/TALK"  , "narrator": "エリカ", "text": "長官が本当の事を\n言っちゃった件について、\n対策を考えてみたの。"},
        { "location": "464/TALK"  , "narrator": "エリカ", "text": "もう一度エピソード\n１５からやり直すのも、\n１つの手段だけど――"},
        { "location": "465/TALK"  , "narrator": "エリカ", "text": "もう１つ、ちょっと\n気にかかることがあって。"},
        { "location": "466/SEL"   , "narrator": "", "text": "気になること？"},
        { "location": "467/ACT"   , "narrator": "", "text": "気になること？"},
        { "location": "469/TALK"  , "narrator": "エリカ", "text": "そう。"},
        { "location": "471/TALK"  , "narrator": "エリカ", "text": "覚えてるかどうか……\nううん、観測したかどうか\nわからないけど――"},
        { "location": "472/TALK"  , "narrator": "エリカ", "text": "今回のエピソード１７は\nガブリエラちゃんの司書が\n反乱を起こした回なの。"},
        { "location": "478/TALK"  , "narrator": "エリカ", "text": "司書に伝達される指示を\n無視して、敢えて正反対の\n葛藤を勝たせた。"},
        { "location": "479/TALK"  , "narrator": "エリカ", "text": "それによって、\n千羽鶴ちゃんは\n色々苦労したんだけど――"},
        { "location": "480/TALK"  , "narrator": "エリカ", "text": "今回のリプレイス作戦では\nそれも正してみたくて。"},
        { "location": "484/SEL"   , "narrator": "", "text": "そうするとどうなるの？"},
        { "location": "485/ACT"   , "narrator": "", "text": "そうするとどうなるの？"},
        { "location": "487/TALK"  , "narrator": "エリカ", "text": "わからない。"},
        { "location": "488/TALK"  , "narrator": "エリカ", "text": "けど、少なくとも、\n千羽鶴ちゃんが計算した\n通りの動きになるから――"},
        { "location": "489/TALK"  , "narrator": "エリカ", "text": "本来想定していた道程に\n近くなって、予測が\n立てやすくなるかな。"},
        { "location": "490/TALK"  , "narrator": "エリカ", "text": "残滓整理みたいな感じに\nなっちゃって申し訳ない\nけど、お願いします。"},
        { "location": "491/SEL"   , "narrator": "", "text": "で、どうすれば？"},
        { "location": "492/ACT"   , "narrator": "", "text": "で、どうすれば？"},
        { "location": "494/TALK"  , "narrator": "エリカ", "text": "神楽ちゃんの\nココロスフィアに行って"},
        { "location": "495/TALK"  , "narrator": "エリカ", "text": "司書かそれ以上の存在に\nお願いしてみて\nもらえないかな？"},
        { "location": "496/TALK"  , "narrator": "エリカ", "text": "特に怪しまれなければ、\n移動自体は簡単にさせて\nもらえると思うから。"},
        { "location": "497/TALK"  , "narrator": "エリカ", "text": "どうか、\nご検討お願いします！"},
        { "location": "500/TALK"  , "narrator": "エリカ", "text": "今のところ順調に推移して\nいるから、こっちからの\nお願いは無いかな。"},
        { "location": "501/TALK"  , "narrator": "エリカ", "text": "さっきもお話したように、\n色々な可能性を\n観測して――"},
        { "location": "502/TALK"  , "narrator": "エリカ", "text": "あなたなりの答えを\n固めてくれると\n嬉しいかな。"},
        { "location": "507/TALK"  , "narrator": "エリカ", "text": "あ、それと、\n神楽ちゃんの同化について\nなんだけど――"},
        { "location": "508/TALK"  , "narrator": "エリカ", "text": "前回、改ざんポイントを\n見つけてくれたお陰で、\n何とか出来そうだよ。"},
        { "location": "509/TALK"  , "narrator": "エリカ", "text": "ただ、どうしても\nぴょんこちゃんの\n2xとしての力が必要で。"},
        { "location": "510/TALK"  , "narrator": "エリカ", "text": "一応、ぴょんこちゃんには\n協力して欲しいってメール\n送ってはあるけど――"},
        { "location": "511/TALK"  , "narrator": "エリカ", "text": "もしぴょんこちゃんに\n逢うことがあったら、\n支援して欲しいかな。"},
        { "location": "512/TALK"  , "narrator": "エリカ", "text": "もちろん、あなたが\nそれを望むならで\nいいんだけどね。"},
        { "location": "513/SEL"   , "narrator": "", "text": "任せておいて"},
        { "location": "514/SEL"   , "narrator": "", "text": "気が向いたら"},
        { "location": "515/ACT"   , "narrator": "", "text": "任せておいて"},
        { "location": "516/TALK"  , "narrator": "エリカ", "text": "ありがとう！"},
        { "location": "517/ACT"   , "narrator": "", "text": "気が向いたら"},
        { "location": "518/TALK"  , "narrator": "エリカ", "text": "うん。"},
        { "location": "520/TALK"  , "narrator": "エリカ", "text": "今回のことが\n上手くいけば――"},
        { "location": "521/TALK"  , "narrator": "エリカ", "text": "神楽ちゃんの同化を防いで\nぴょんこちゃん消滅を\n阻止できるだけでなく、"},
        { "location": "522/TALK"  , "narrator": "エリカ", "text": "わたしたちが考える\nリプレイス作戦の確度を\n相当上げる事ができる。"},
        { "location": "523/SEL"   , "narrator": "", "text": "どうして？"},
        { "location": "524/ACT"   , "narrator": "", "text": "どうして？"},
        { "location": "526/TALK"  , "narrator": "エリカ", "text": "ぴょんこちゃんと一緒に\n行く場所は、Redinessの\n中枢とも言うべき場所。"},
        { "location": "527/TALK"  , "narrator": "エリカ", "text": "そこには、Rediness\n開発者の間でも都市伝説と\n言われているものがある。"},
        { "location": "528/SEL"   , "narrator": "", "text": "何それ"},
        { "location": "529/ACT"   , "narrator": "", "text": "何それ"},
        { "location": "531/TALK"  , "narrator": "エリカ", "text": "Redinessがフェノメノンを\n生成することを可能とする\n基幹システム――"},
        { "location": "534/TALK"  , "narrator": "エリカ", "text": "ライフギャザーと\n呼ばれるシステムの\n一群だよ。"},
        { "location": "535/SEL"   , "narrator": "", "text": "ライフギャザーだって！？"},
        { "location": "536/ACT"   , "narrator": "", "text": "ライフギャザーだって！？"},
        { "location": "538/TALK"  , "narrator": "エリカ", "text": "えっ！？\n知ってるの？"},
        { "location": "539/SEL"   , "narrator": "", "text": "神楽のお父さんが作ったやつでしょ？"},
        { "location": "540/ACT"   , "narrator": "", "text": "神楽のお父さんが作ったやつでしょ？"},
        { "location": "542/TALK"  , "narrator": "エリカ", "text": "そう言われてるね。"},
        { "location": "543/TALK"  , "narrator": "エリカ", "text": "エンタングルが\nUDUKIを潰した時に\n奪ったと言われてる技術。"},
        { "location": "544/TALK"  , "narrator": "エリカ", "text": "けど、\nそんなものは\n都市伝説で――"},
        { "location": "545/TALK"  , "narrator": "エリカ", "text": "実際はエンタングルが\n自社開発した、ライフ\nギャザーとは別の物……。"},
        { "location": "546/SEL"   , "narrator": "", "text": "それは嘘だ！神楽のお父さんが作ったのが奪われたんだよ"},
        { "location": "547/SEL"   , "narrator": "", "text": "そうだったの！？"},
        { "location": "548/ACT"   , "narrator": "", "text": "それは嘘だ！神楽のお父さんが作ったのが奪われたんだよ"},
        { "location": "549/TALK"  , "narrator": "エリカ", "text": "うん。正直言うと、\nわたしもそう思ってる。"},
        { "location": "550/TALK"  , "narrator": "エリカ", "text": "けど、Rediness技術者\n界隈でその話をすると、\nすごい軽蔑されるの。"},
        { "location": "551/ACT"   , "narrator": "", "text": "そうだったの！？"},
        { "location": "552/TALK"  , "narrator": "エリカ", "text": "それが常識となってるよ。"},
        { "location": "553/TALK"  , "narrator": "エリカ", "text": "ライフギャザーを\n奪ったなんて、\n陰謀論に過ぎないって。"},
        { "location": "554/TALK"  , "narrator": "エリカ", "text": "けど、わたしは\n陰謀論じゃなくて、\n事実だと思ってる。"},
        { "location": "558/TALK"  , "narrator": "エリカ", "text": "とにかく、その\nライフギャザーまで\n到達することができれば"},
        { "location": "559/TALK"  , "narrator": "エリカ", "text": "今回の作戦にとって\n大きなプラスになるの。"},
        { "location": "560/TALK"  , "narrator": "エリカ", "text": "そして、その為には\nぴょんこちゃんの力が\n必要かもしれない。"},
        { "location": "561/TALK"  , "narrator": "エリカ", "text": "だから、どうか\nよろしくお願いします。"},
        { "location": "562/TALK"  , "narrator": "エリカ", "text": "それじゃ今回も、\nお互い頑張ろうね。"},
        { "location": "184/DIALOG", "narrator": "Event/Dialog_EventPicTallNW", "text": "レイヤーの概念"},
        { "location": "411/DIALOG", "narrator": "Tutorial/Dialog_Anime1", "text": "$dialog_word$"},
        { "location": "413/DIALOG", "narrator": "Tutorial/Dialog_Anime2", "text": "$dialog_word$"},
        { "location": "415/DIALOG", "narrator": "Tutorial/Dialog_Anime3", "text": "$dialog_word$"},
        { "location": "417/DIALOG", "narrator": "Tutorial/Dialog_Anime4", "text": "$dialog_word$"},
        { "location": "419/DIALOG", "narrator": "Tutorial/Dialog_Anime5", "text": "$dialog_word$"},
        { "location": "476/DIALOG", "narrator": "Event/Dialog_EventPicTallNW", "text": "ガブリエラの司書の乱"}
    ]
}
