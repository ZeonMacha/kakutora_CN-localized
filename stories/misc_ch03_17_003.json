        { "location": "148/SCENARIO", "narrator": "", "text": "気まぐれ交差点"},
        { "location": "173/TALK"    , "narrator": "ガブリエラ", "text": "信号待ちをしていて"},
        { "location": "174/TALK"    , "narrator": "ガブリエラ", "text": "赤だけど車が来なかった時は"},
        { "location": "175/TALK"    , "narrator": "ガブリエラ", "text": "渡ったりするでしょう？"},
        { "location": "177/SEL"     , "narrator": "", "text": "するする！"},
        { "location": "178/SEL"     , "narrator": "", "text": "状況によるかな"},
        { "location": "179/SEL"     , "narrator": "", "text": "ガブはそんな子なの？"},
        { "location": "180/ACT"     , "narrator": "", "text": "するする！"},
        { "location": "181/TALK"    , "narrator": "ガブリエラ", "text": "そうよね"},
        { "location": "183/TALK"    , "narrator": "ガブリエラ", "text": "するわよねｖｖ"},
        { "location": "184/ACT"     , "narrator": "", "text": "状況によるかな"},
        { "location": "185/TALK"    , "narrator": "ガブリエラ", "text": "確かに"},
        { "location": "186/TALK"    , "narrator": "ガブリエラ", "text": "状況の見極めは大事だわ"},
        { "location": "187/ACT"     , "narrator": "", "text": "ガブはそんな子なの？"},
        { "location": "189/TALK"    , "narrator": "ガブリエラ", "text": "え"},
        { "location": "190/TALK"    , "narrator": "ガブリエラ", "text": "おかしいのかしら？"},
        { "location": "192/SEL"     , "narrator": "", "text": "ちょっとからかってみたかっただけ"},
        { "location": "193/SEL"     , "narrator": "", "text": "新しいガブを知った"},
        { "location": "194/ACT"     , "narrator": "", "text": "ちょっとからかってみたかっただけ"},
        { "location": "195/TALK"    , "narrator": "ガブリエラ", "text": "もう"},
        { "location": "196/TALK"    , "narrator": "ガブリエラ", "text": "マルザンナったら"},
        { "location": "197/ACT"     , "narrator": "", "text": "新しいガブを知った"},
        { "location": "198/TALK"    , "narrator": "ガブリエラ", "text": "いやだわ"},
        { "location": "199/TALK"    , "narrator": "ガブリエラ", "text": "マルザンナったら"},
        { "location": "202/TALK"    , "narrator": "ガブリエラ", "text": "ところがね"},
        { "location": "203/TALK"    , "narrator": "ガブリエラ", "text": "つばめったら"},
        { "location": "204/TALK"    , "narrator": "ガブリエラ", "text": "きちんと信号を守るのよ"},
        { "location": "206/SEL"     , "narrator": "", "text": "真面目なんだね"},
        { "location": "207/SEL"     , "narrator": "", "text": "融通が利かないね"},
        { "location": "208/SEL"     , "narrator": "", "text": "先輩として何か言ったの？"},
        { "location": "209/ACT"     , "narrator": "", "text": "真面目なんだね"},
        { "location": "210/TALK"    , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "212/TALK"    , "narrator": "ガブリエラ", "text": "そうかもしれないわ"},
        { "location": "213/ACT"     , "narrator": "", "text": "融通が利かないね"},
        { "location": "214/TALK"    , "narrator": "ガブリエラ", "text": "そういうことに"},
        { "location": "215/TALK"    , "narrator": "ガブリエラ", "text": "なるのかしら"},
        { "location": "216/ACT"     , "narrator": "", "text": "先輩として何か言ったの？"},
        { "location": "218/TALK"    , "narrator": "ガブリエラ", "text": "そういうわけじゃないわ"},
        { "location": "219/TALK"    , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "220/TALK"    , "narrator": "ガブリエラ", "text": "先輩として何か言ってあげればよかったわね"},
        { "location": "221/TALK"    , "narrator": "ガブリエラ", "text": "次回はそうするわ"},
        { "location": "223/TALK"    , "narrator": "ガブリエラ", "text": "あのこらしいといえば"},
        { "location": "224/TALK"    , "narrator": "ガブリエラ", "text": "あのこらしいわよね"},
        { "location": "225/TALK"    , "narrator": "ガブリエラ", "text": "って"},
        { "location": "226/TALK"    , "narrator": "ガブリエラ", "text": "一緒に帰ってて"},
        { "location": "227/TALK"    , "narrator": "ガブリエラ", "text": "そう思っただけなの"},
        { "location": "228/TALK"    , "narrator": "ガブリエラ", "text": "それだけよ！"}
    ]
