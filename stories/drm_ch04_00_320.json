        { "location": "7/SCENARIO", "narrator": "", "text": "250_おやすみ、また明日"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "もう寝る"},
        { "location": "33/TALK"   , "narrator": "みやび", "text": "眠いし"},
        { "location": "35/SEL"    , "narrator": "", "text": "おやすみ"},
        { "location": "36/SEL"    , "narrator": "", "text": "なんで起きてたの"},
        { "location": "37/SEL"    , "narrator": "", "text": "待たせてごめんね"},
        { "location": "38/ACT"    , "narrator": "", "text": "おやすみ"},
        { "location": "39/TALK"   , "narrator": "みやび", "text": "うむ"},
        { "location": "40/TALK"   , "narrator": "みやび", "text": "寝る"},
        { "location": "42/TALK"   , "narrator": "みやび", "text": "ぐー…"},
        { "location": "43/ACT"    , "narrator": "", "text": "なんで起きてたの"},
        { "location": "44/TALK"   , "narrator": "みやび", "text": "なんと"},
        { "location": "45/TALK"   , "narrator": "みやび", "text": "聞くのか"},
        { "location": "46/TALK"   , "narrator": "みやび", "text": "やれやれだな"},
        { "location": "47/ACT"    , "narrator": "", "text": "待たせてごめんね"},
        { "location": "57/TALK"   , "narrator": "みやび", "text": "そう言うなら"},
        { "location": "59/TALK"   , "narrator": "みやび", "text": "もっと早く来ればいいのだ"},
        { "location": "60/TALK"   , "narrator": "みやび", "text": "ばかちんめ"},
        { "location": "65/TALK"   , "narrator": "みやび", "text": "しかし$handle$が"},
        { "location": "66/TALK"   , "narrator": "みやび", "text": "興味深い話を提供するならば"},
        { "location": "67/TALK"   , "narrator": "みやび", "text": "耳を傾けるのはやぶさかではない"},
        { "location": "69/SEL"    , "narrator": "", "text": "昔々、あるところに"},
        { "location": "70/SEL"    , "narrator": "", "text": "アレ知ってる？"},
        { "location": "71/SEL"    , "narrator": "", "text": "神楽坂に新しいガレットの店ができたんだって！"},
        { "location": "72/ACT"    , "narrator": "", "text": "昔々、あるところに"},
        { "location": "73/TALK"   , "narrator": "みやび", "text": "お兄ちゃんと妹ちゃんが"},
        { "location": "75/SEL"    , "narrator": "", "text": "萌えシチュキター！"},
        { "location": "76/SEL"    , "narrator": "", "text": "あ、そういうのはいいです"},
        { "location": "77/SEL"    , "narrator": "", "text": "$me$とみやびかな？"},
        { "location": "78/ACT"    , "narrator": "", "text": "萌えシチュキター！"},
        { "location": "79/TALK"   , "narrator": "みやび", "text": "なるほど"},
        { "location": "80/TALK"   , "narrator": "みやび", "text": "わかりやすい反応ぞね"},
        { "location": "81/ACT"    , "narrator": "", "text": "あ、そういうのはいいです"},
        { "location": "82/TALK"   , "narrator": "みやび", "text": "ややや"},
        { "location": "84/TALK"   , "narrator": "みやび", "text": "なかなかにストイック"},
        { "location": "85/ACT"    , "narrator": "", "text": "$me$とみやびかな？"},
        { "location": "86/TALK"   , "narrator": "みやび", "text": "それは違う"},
        { "location": "87/TALK"   , "narrator": "みやび", "text": "なぜなら"},
        { "location": "88/TALK"   , "narrator": "みやび", "text": "うちは長女ゆえ"},
        { "location": "90/ACT"    , "narrator": "", "text": "アレ知ってる？"},
        { "location": "91/TALK"   , "narrator": "みやび", "text": "ああ、あれか！"},
        { "location": "93/TALK"   , "narrator": "みやび", "text": "って"},
        { "location": "94/TALK"   , "narrator": "みやび", "text": "どれぞ"},
        { "location": "96/SEL"    , "narrator": "", "text": "あれだってば！"},
        { "location": "97/SEL"    , "narrator": "", "text": "それだよー"},
        { "location": "98/SEL"    , "narrator": "", "text": "いや、それっぽく言っただけ"},
        { "location": "99/ACT"    , "narrator": "", "text": "あれだってば！"},
        { "location": "100/TALK"  , "narrator": "みやび", "text": "具体性がない"},
        { "location": "101/ACT"   , "narrator": "", "text": "それだよー"},
        { "location": "102/TALK"  , "narrator": "みやび", "text": "あれのことかー！"},
        { "location": "103/ACT"   , "narrator": "", "text": "いや、それっぽく言っただけ"},
        { "location": "104/TALK"  , "narrator": "みやび", "text": "そうだろう"},
        { "location": "105/TALK"  , "narrator": "みやび", "text": "そうだろう"},
        { "location": "107/ACT"   , "narrator": "", "text": "神楽坂に新しいガレットの店ができたんだって！"},
        { "location": "117/TALK"  , "narrator": "みやび", "text": "ほうほう"},
        { "location": "119/TALK"  , "narrator": "みやび", "text": "それはなかなか"},
        { "location": "120/TALK"  , "narrator": "みやび", "text": "よい情報"},
        { "location": "122/SEL"   , "narrator": "", "text": "やっぱりグリュイエールチーズだよね！"},
        { "location": "123/SEL"   , "narrator": "", "text": "カマンベールチーズいいよね"},
        { "location": "124/SEL"   , "narrator": "", "text": "モッツァレラが食べやすい"},
        { "location": "125/ACT"   , "narrator": "", "text": "やっぱりグリュイエールチーズだよね！"},
        { "location": "126/TALK"  , "narrator": "みやび", "text": "知った風な口を"},
        { "location": "127/ACT"   , "narrator": "", "text": "カマンベールチーズいいよね"},
        { "location": "128/TALK"  , "narrator": "みやび", "text": "美味いな"},
        { "location": "129/TALK"  , "narrator": "みやび", "text": "確かに"},
        { "location": "130/ACT"   , "narrator": "", "text": "モッツァレラが食べやすい"},
        { "location": "131/TALK"  , "narrator": "みやび", "text": "そうかもな"},
        { "location": "132/TALK"  , "narrator": "みやび", "text": "あっさりめで"},
        { "location": "134/TALK"  , "narrator": "みやび", "text": "それにしても相棒"},
        { "location": "136/TALK"  , "narrator": "みやび", "text": "その女子力の高さは"},
        { "location": "137/TALK"  , "narrator": "みやび", "text": "どこから来た"},
        { "location": "139/SEL"   , "narrator": "", "text": "だって女子だから"},
        { "location": "140/SEL"   , "narrator": "", "text": "みやびと話がしたくて"},
        { "location": "141/SEL"   , "narrator": "", "text": "常識の範囲内だよ？"},
        { "location": "142/ACT"   , "narrator": "", "text": "だって女子だから"},
        { "location": "143/TALK"  , "narrator": "みやび", "text": "なるほど"},
        { "location": "144/TALK"  , "narrator": "みやび", "text": "ではめくるめく女子トークを繰り広げようではないか"},
        { "location": "145/ACT"   , "narrator": "", "text": "みやびと話がしたくて"},
        { "location": "146/TALK"  , "narrator": "みやび", "text": "それは初いことを"},
        { "location": "147/TALK"  , "narrator": "みやび", "text": "健気ぞね"},
        { "location": "148/ACT"   , "narrator": "", "text": "常識の範囲内だよ？"},
        { "location": "149/TALK"  , "narrator": "みやび", "text": "そうきたか"},
        { "location": "150/TALK"  , "narrator": "みやび", "text": "上質な暮らし系だとは"},
        { "location": "152/TALK"  , "narrator": "みやび", "text": "食事系だけでなく"},
        { "location": "154/TALK"  , "narrator": "みやび", "text": "スイーツ系も食したい"},
        { "location": "156/SEL"   , "narrator": "", "text": "クレープだね"},
        { "location": "157/SEL"   , "narrator": "", "text": "シンプルにシュクレ"},
        { "location": "158/SEL"   , "narrator": "", "text": "アイスとか追加できるみたいだよ"},
        { "location": "159/ACT"   , "narrator": "", "text": "クレープだね"},
        { "location": "160/TALK"  , "narrator": "みやび", "text": "うむ"},
        { "location": "161/TALK"  , "narrator": "みやび", "text": "何クレープにするか"},
        { "location": "162/TALK"  , "narrator": "みやび", "text": "それが問題だ"},
        { "location": "163/ACT"   , "narrator": "", "text": "シンプルにシュクレ"},
        { "location": "164/TALK"  , "narrator": "みやび", "text": "ほほう"},
        { "location": "165/TALK"  , "narrator": "みやび", "text": "なかなかわかっておるな"},
        { "location": "166/TALK"  , "narrator": "みやび", "text": "すばらしい"},
        { "location": "167/ACT"   , "narrator": "", "text": "アイスとか追加できるみたいだよ"},
        { "location": "168/TALK"  , "narrator": "みやび", "text": "高カロリーの誘惑"},
        { "location": "169/TALK"  , "narrator": "みやび", "text": "これはなかなか"},
        { "location": "170/TALK"  , "narrator": "みやび", "text": "抗いがたい"},
        { "location": "172/TALK"  , "narrator": "みやび", "text": "いい話を聞いた"},
        { "location": "173/TALK"  , "narrator": "みやび", "text": "今度行ってみる"},
        { "location": "175/TALK"  , "narrator": "みやび", "text": "さてさて"},
        { "location": "176/TALK"  , "narrator": "みやび", "text": "今度こそ我は本格的に睡眠に移行する"},
