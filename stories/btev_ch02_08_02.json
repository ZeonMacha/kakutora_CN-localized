{
    "dir": "chap08/battle/btev_ch02_08_02.js",
    "type": "",
    "info": {
        "story_id": "22015",
        "cid": "",
        "title": "015 ココロスフィアストーリー【Lv05】",
        "sub_title": "転落人生＜帰結＞"
    },
    "entry":
    [
        { "location": "640/SCENARIO", "narrator": "", "text": "転落人生"},
        { "location": "654/TALK"    , "narrator": "アーヤ", "text": "酷い……\n私の世界なのに…っ…"},
        { "location": "655/TALK"    , "narrator": "分身アーヤ", "text": "貴方の言い分もわかる。\nけど、もっと自信を\n持ってもいいと思う。"},
        { "location": "656/TALK"    , "narrator": "分身アーヤ", "text": "確かに卯月は強いし\n逢瀬さんだって謎の\n力を持ってる。"},
        { "location": "657/TALK"    , "narrator": "分身アーヤ", "text": "けど、私だって\nちゃんと戦えてるし――"},
        { "location": "658/TALK"    , "narrator": "分身アーヤ", "text": "リーダーとして\nちゃんとやれてる。"},
        { "location": "660/TALK"    , "narrator": "アーヤ", "text": "…だといいけど。"},
        { "location": "661/TALK"    , "narrator": "アーヤ", "text": "私の不安が\n的中しなければ\nいいんだけどね。"},
        { "location": "665/TALK"    , "narrator": "アーヤ", "text": "特に最近の私は、\n全然なってない。"},
        { "location": "666/TALK"    , "narrator": "アーヤ", "text": "こんな体たらくじゃ\n後輩に追い抜かれるのも\n時間の問題よ……。"},
        { "location": "667/TALK"    , "narrator": "分身アーヤ", "text": "……。"},
        { "location": "668/TALK"    , "narrator": "アーヤ", "text": "高校の時の\n私を思い出して……。"},
        { "location": "682/TALK"    , "narrator": "アーヤ", "text": "ありがとう、\n手伝ってくれて。"},
        { "location": "683/TALK"    , "narrator": "アーヤ", "text": "これで私も\n少しはポジティブに\n考えられるようになる。"},
        { "location": "684/SEL"     , "narrator": "（選択肢）", "text": "よかった"},
        { "location": "685/SEL"     , "narrator": "（選択肢）", "text": "どうしてそんなに焦ってるの？"},
        { "location": "686/ACT"     , "narrator": "", "text": "よかった"},
        { "location": "687/TALK"    , "narrator": "アーヤ", "text": "ええ。"},
        { "location": "688/ACT"     , "narrator": "", "text": "どうしてそんなに焦ってるの？"},
        { "location": "689/TALK"    , "narrator": "アーヤ", "text": "んー……"},
        { "location": "690/TALK"    , "narrator": "アーヤ", "text": "どうしてかしらね。\n私は焦ってないし、\nわからないかも。"},
        { "location": "691/SEL"     , "narrator": "（選択肢）", "text": "自分のことでしょ？"},
        { "location": "692/ACT"     , "narrator": "", "text": "自分のことでしょ？"},
        { "location": "694/TALK"    , "narrator": "アーヤ", "text": "確かに私だけど、\nでもさっきの私と\n今の私は別の人格。"},
        { "location": "695/TALK"    , "narrator": "アーヤ", "text": "私にとっては、卯月も\n逢瀬さんもすごいけど\nそれはそれ。"},
        { "location": "696/TALK"    , "narrator": "アーヤ", "text": "私は私で、ちゃんと\nリーダーとしての責務を\n全うするだけなの。"},
        { "location": "698/TALK"    , "narrator": "アーヤ", "text": "ああっ！\nいけない！"},
        { "location": "699/TALK"    , "narrator": "アーヤ", "text": "私って今、長距離走の\n途中だったわよね？"},
        { "location": "700/SEL"     , "narrator": "（選択肢）", "text": "そうだけど、まだやるの？"},
        { "location": "701/ACT"     , "narrator": "", "text": "そうだけど、まだやるの？"},
        { "location": "703/TALK"    , "narrator": "アーヤ", "text": "もちろんよ。"},
        { "location": "705/TALK"    , "narrator": "アーヤ", "text": "この世界をハッピー\nエンドで終わらせ\nなくちゃいけない。"},
        { "location": "706/TALK"    , "narrator": "アーヤ", "text": "そうしないと、現実の\n私の気持ちが曇った\nままになっちゃうから。"},
        { "location": "707/SEL"     , "narrator": "（選択肢）", "text": "その格好で？"},
        { "location": "708/ACT"     , "narrator": "", "text": "その格好で？"},
        { "location": "710/TALK"    , "narrator": "アーヤ", "text": "まさか。\nちゃんと着替えるわよ。"},
        { "location": "711/SEL"     , "narrator": "（選択肢）", "text": "頑張って！"},
        { "location": "712/ACT"     , "narrator": "", "text": "頑張って！"},
        { "location": "715/TALK"    , "narrator": "アーヤ", "text": "ええ。\nありがと！"},
        { "location": "734/TALK"    , "narrator": "透明アーヤ", "text": "だいぶ距離を\n開けられちゃったわね。"},
        { "location": "736/TALK"    , "narrator": "透明アーヤ", "text": "でもこれくらいなら\nまだ大丈夫。"},
        { "location": "737/TALK"    , "narrator": "透明アーヤ", "text": "逆転のチャンスは\n十分にあるわ。"},
        { "location": "738/SEL"     , "narrator": "（選択肢）", "text": "応援してるよ！"},
        { "location": "739/SEL"     , "narrator": "（選択肢）", "text": "さっきの格好のままで走って欲しかった"},
        { "location": "740/SEL"     , "narrator": "（選択肢）", "text": "$me$はアーヤのダイナミックな揺れに夢中です"},
        { "location": "741/ACT"     , "narrator": "", "text": "応援してるよ！"},
        { "location": "745/TALK"    , "narrator": "透明アーヤ", "text": "ありがと！"},
        { "location": "747/TALK"    , "narrator": "透明アーヤ", "text": "$handle$が\n応援してくれると\nとても心強いわ。"},
        { "location": "751/TALK"    , "narrator": "透明アーヤ", "text": "んーっ！\n頑張らなくちゃ！"},
        { "location": "752/ACT"     , "narrator": "", "text": "さっきの格好のままで走って欲しかった"},
        { "location": "754/TALK"    , "narrator": "透明アーヤ", "text": "冗談やめて。\nお気に入りの服なのに\n汗だくになっちゃう。"},
        { "location": "755/ACT"     , "narrator": "", "text": "$me$はアーヤのダイナミックな揺れに夢中です"},
        { "location": "758/TALK"    , "narrator": "透明アーヤ", "text": "はいはい。\n何の揺れのことかは\nわかりませんけど？"},
        { "location": "760/TALK"    , "narrator": "透明アーヤ", "text": "高校生の時は、剣道\nするにも邪魔だし嫌\nだったけど――"},
        { "location": "761/TALK"    , "narrator": "透明アーヤ", "text": "今はオシャレし甲斐\nあるから、よかったと\n思ってる。"},
        { "location": "763/TALK"    , "narrator": "透明アーヤ", "text": "でもそう思ってるのは\nここだけの\n秘密だからね？"},
        { "location": "793/TALK"    , "narrator": "つばめ", "text": "はぁ…はぁ……\nつかれたー！"},
        { "location": "794/TALK"    , "narrator": "神楽", "text": "アーヤちゃんの\n追い上げが凄くて\nビックリでした。"},
        { "location": "795/TALK"    , "narrator": "つばめ", "text": "ホントだよー。"},
        { "location": "797/TALK"    , "narrator": "アーヤ", "text": "途中ちょっと\n気を抜いちゃったしね。"},
        { "location": "798/TALK"    , "narrator": "アーヤ", "text": "最後くらいは\n本気だしておかないと。"},
        { "location": "806/TALK"    , "narrator": "真幌", "text": "３人ほぼ同着１位で\nゴールとはな。"},
        { "location": "807/TALK"    , "narrator": "真幌", "text": "まあ、逢瀬は途中\n迷子になっていた\nわけだが……。"},
        { "location": "808/TALK"    , "narrator": "つばめ", "text": "えへへ、\nごめんなさい…。"},
        { "location": "811/TALK"    , "narrator": "真幌", "text": "アーヤは後半の\n追い上げが凄くて\nびっくりしたぞ。"},
        { "location": "812/TALK"    , "narrator": "真幌", "text": "これからもその調子で\n頑張ってくれよ、\n生徒会長。"},
        { "location": "813/TALK"    , "narrator": "アーヤ", "text": "はいっ！"},
        { "location": "816/TALK"    , "narrator": "アーヤ", "text": "ホントにありがと、\n$handle$！"},
        { "location": "817/SEL"     , "narrator": "（選択肢）", "text": "どういたしまして！"},
        { "location": "818/ACT"     , "narrator": "", "text": "どういたしまして！"},
        { "location": "837/TALK"    , "narrator": "千羽鶴", "text": "お疲れさま。"},
        { "location": "838/TALK"    , "narrator": "千羽鶴", "text": "今回も華麗な\nココロ裁きだった。"},
        { "location": "839/SEL"     , "narrator": "（選択肢）", "text": "どうも！"},
        { "location": "840/SEL"     , "narrator": "（選択肢）", "text": "うーん…"},
        { "location": "841/ACT"     , "narrator": "", "text": "どうも！"},
        { "location": "842/TALK"    , "narrator": "千羽鶴", "text": "この調子で\n次もお願いね。"},
        { "location": "843/ACT"     , "narrator": "", "text": "うーん…"},
        { "location": "844/TALK"    , "narrator": "千羽鶴", "text": "どうしたの？"},
        { "location": "845/SEL"     , "narrator": "（選択肢）", "text": "警戒する心を消して良かったのかな"},
        { "location": "846/SEL"     , "narrator": "（選択肢）", "text": "アーヤのダイナミック揺れをもっと見ていたかった"},
        { "location": "847/ACT"     , "narrator": "", "text": "警戒する心を消して良かったのかな"},
        { "location": "848/TALK"    , "narrator": "千羽鶴", "text": "さあ？\nそれはわからない。"},
        { "location": "849/TALK"    , "narrator": "千羽鶴", "text": "もしかしたら後で\nもっと酷いことに\nなるかも。"},
        { "location": "850/TALK"    , "narrator": "千羽鶴", "text": "でも、今の彼女が先へ\n進むには、この結果は\n悪くなかったと思う。"},
        { "location": "851/TALK"    , "narrator": "千羽鶴", "text": "あくまで私見だけど。"},
        { "location": "852/SEL"     , "narrator": "（選択肢）", "text": "フォローありがとう"},
        { "location": "853/ACT"     , "narrator": "", "text": "フォローありがとう"},
        { "location": "855/TALK"    , "narrator": "千羽鶴", "text": "どういたしまして。"},
        { "location": "856/ACT"     , "narrator": "", "text": "アーヤのダイナミック揺れをもっと見ていたかった"},
        { "location": "857/TALK"    , "narrator": "千羽鶴", "text": "もう一回このお話を\n見ればいいだけ。"},
        { "location": "858/TALK"    , "narrator": "千羽鶴", "text": "後悔する前に\n頭と指を使う。"},
        { "location": "859/TALK"    , "narrator": "千羽鶴", "text": "それじゃまた。"}
    ]
}
