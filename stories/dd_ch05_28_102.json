{
    "dir": "chap28/daydra/dd_ch05_28_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "28505",
        "cid": "kagura",
        "title": "005 メインストーリー",
        "sub_title": "史上最大の気苦労＜後編＞"
    },
    "entry":
    [
        { "location": "1710/TALK"  , "narrator": "繭", "text": "…………。"},
        { "location": "1711/TALK"  , "narrator": "神楽", "text": "繭さん？"},
        { "location": "1713/TALK"  , "narrator": "繭", "text": "…なに、この情報？"},
        { "location": "1716/TALK"  , "narrator": "雛", "text": "って、ヤバいーっ！！\nまゆちん、\n急いでセーブして！"},
        { "location": "1717/TALK"  , "narrator": "雛", "text": "このままじゃ熱で\nチップが死んじゃう！"},
        { "location": "1718/TALK"  , "narrator": "繭", "text": "なんとか冷まして！\nこれ、スゴい情報！"},
        { "location": "1719/TALK"  , "narrator": "雛", "text": "えぇっ！？"},
        { "location": "1720/TALK"  , "narrator": "雛", "text": "こんなことなら、水冷に\nしとくんだったー…。"},
        { "location": "1722/TALK"  , "narrator": "神楽", "text": "あの、氷でよければ\n冷蔵庫に沢山――"},
        { "location": "1724/TALK"  , "narrator": "雛", "text": "すぐに氷嚢にして\n持ってきて！"},
        { "location": "1725/TALK"  , "narrator": "神楽", "text": "は、はいっ！"},
        { "location": "1729/TALK"  , "narrator": "繭", "text": "…こんな情報、\n想定外。\nすごい…なにこれ？"},
        { "location": "1730/TALK"  , "narrator": "繭", "text": "こんな時に、\nみやび先輩が\nいてくれたら…。"},
        { "location": "1731/TALK"  , "narrator": "繭", "text": "…ちがう。\nちがうから、繭。"},
        { "location": "1732/TALK"  , "narrator": "繭", "text": "今は私が、\nみやび先輩を\n守る立場だから！"},
        { "location": "1733/TALK"  , "narrator": "繭", "text": "私が解析する。\n今まで、みやび先輩が\nやってきたように…。"},
        { "location": "1734/TALK"  , "narrator": "繭", "text": "……。"},
        { "location": "1735/TALK"  , "narrator": "繭", "text": "あともう少しで――"},
        { "location": "1736/TALK"  , "narrator": "繭", "text": "っ！！\nやばっ！！"},
        { "location": "1748/TALK"  , "narrator": "繭", "text": "……大丈夫。\n大丈夫だから。"},
        { "location": "1749/TALK"  , "narrator": "繭", "text": "何もない、\n何もない……\nきっと大丈夫……"},
        { "location": "1776/TALK"  , "narrator": "繭", "text": "…………。"},
        { "location": "1778/TALK"  , "narrator": "神楽", "text": "ひなこさん、\nチップの方は\nどうですか？"},
        { "location": "1779/TALK"  , "narrator": "雛", "text": "ギリギリセーフ。\nもう少し遅かったら\n溶けてたかも…。"},
        { "location": "1780/TALK"  , "narrator": "雛", "text": "それで、まゆちん。\nどうだった？"},
        { "location": "1781/TALK"  , "narrator": "繭", "text": "…ダメだ。"},
        { "location": "1782/TALK"  , "narrator": "繭", "text": "私程度の力じゃ…。\nなにもわからない。"},
        { "location": "1783/TALK"  , "narrator": "神楽", "text": "なにもって…、\n少しでもわかった\nことはないんですか？"},
        { "location": "1784/TALK"  , "narrator": "繭", "text": "とりあえず、実験用に\nSIMカードを1枚\n作ることができた。"},
        { "location": "1785/TALK"  , "narrator": "繭", "text": "けれども…鍵。"},
        { "location": "1786/TALK"  , "narrator": "雛", "text": "カギ？"},
        { "location": "1788/TALK"  , "narrator": "繭", "text": "アウターキーと、\nインナーキーという\n二つの鍵があって…。"},
        { "location": "1789/TALK"  , "narrator": "繭", "text": "それが無ければ\n起動は出来ないみたい。"},
        { "location": "1790/TALK"  , "narrator": "繭", "text": "わかれば、恐らく\nトライガジェットの\nほぼ全ての情報と――"},
        { "location": "1791/TALK"  , "narrator": "繭", "text": "操作が出来るように\nなるはず。"},
        { "location": "1792/TALK"  , "narrator": "神楽", "text": "じゃあ、その鍵を\n見つけ出せれば――"},
        { "location": "1793/TALK"  , "narrator": "繭", "text": "けど、その二つの\nキーは、絶望的に\n見つからない…。"},
        { "location": "1794/TALK"  , "narrator": "雛", "text": "…………。"},
        { "location": "1796/TALK"  , "narrator": "神楽", "text": "…万事休す、ですか？"},
        { "location": "1797/TALK"  , "narrator": "繭", "text": "…………。"},
        { "location": "1798/SEL"   , "narrator": "", "text": "アウターキーは5ec41bf64dX_"},
        { "location": "1799/ACT"   , "narrator": "", "text": "アウターキーは5ec41bf64dX_"},
        { "location": "1807/TALK"  , "narrator": "神楽", "text": "…？"},
        { "location": "1808/TALK"  , "narrator": "繭", "text": "それと、ちょっとだけ\n気がかりなことがあった。\n二人とも聞いて――"},
        { "location": "1809/TALK"  , "narrator": "神楽", "text": "えっ、これって！！"},
        { "location": "1810/TALK"  , "narrator": "雛", "text": "どうしたの？"},
        { "location": "1812/TALK"  , "narrator": "神楽", "text": "…アウターキー、\nわかったかも\nしれません。"},
        { "location": "1814/TALK"  , "narrator": "繭", "text": "！？　どういうこと？"},
        { "location": "1816/TALK"  , "narrator": "神楽", "text": "説明はＷＡＶＥで。\n招待するから\n入ってください。"},
        { "location": "1826/TALK"  , "narrator": "システム", "text": "繭さんが入室しました"},
        { "location": "1827/TALK"  , "narrator": "システム", "text": "雛さんが入室しました"},
        { "location": "1828/SEL"   , "narrator": "", "text": "ようこそ二人とも"},
        { "location": "1829/ACT"   , "narrator": "", "text": "ようこそ二人とも"},
        { "location": "1831/TALK"  , "narrator": "繭", "text": "この人がアウターキーを？"},
        { "location": "1832/TALK"  , "narrator": "神楽", "text": "そうですよ"},
        { "location": "1834/TALK"  , "narrator": "雛", "text": "それって本物なの？"},
        { "location": "1836/SEL"   , "narrator": "", "text": "本物だよ"},
        { "location": "1837/SEL"   , "narrator": "", "text": "入れてみればわかる"},
        { "location": "1838/ACT"   , "narrator": "", "text": "本物だよ"},
        { "location": "1839/TALK"  , "narrator": "神楽", "text": "この人は信じても大丈夫です"},
        { "location": "1841/TALK"  , "narrator": "雛", "text": "でも、どうやって知ったのかな？"},
        { "location": "1842/TALK"  , "narrator": "繭", "text": "今はどうでもいい"},
        { "location": "1843/ACT"   , "narrator": "", "text": "入れてみればわかる"},
        { "location": "1844/TALK"  , "narrator": "雛", "text": "不安煽ってるようにしか聞こえないよ！？"},
        { "location": "1845/TALK"  , "narrator": "神楽", "text": "この人は信じても大丈夫です"},
        { "location": "1847/TALK"  , "narrator": "神楽", "text": "ﾀﾌﾞﾝ、、、"},
        { "location": "1849/TALK"  , "narrator": "繭", "text": "卯月さんが言うなら信じるけど"},
        { "location": "1851/TALK"  , "narrator": "繭", "text": "インナーキーもわからなければ"},
        { "location": "1852/TALK"  , "narrator": "繭", "text": "意味がない"},
        { "location": "1853/SEL"   , "narrator": "", "text": "それは入れる必要がない"},
        { "location": "1854/ACT"   , "narrator": "", "text": "それは入れる必要がない"},
        { "location": "1856/TALK"  , "narrator": "繭", "text": "？"},
        { "location": "1857/TALK"  , "narrator": "繭", "text": "アウターキーだけでいいと？"},
        { "location": "1858/SEL"   , "narrator": "", "text": "アウターキーだけ入れたらトライガジェットの全てを掌握できる"},
        { "location": "1859/ACT"   , "narrator": "", "text": "アウターキーだけ入れたらトライガジェットの全てを掌握できる"},
        { "location": "1861/TALK"  , "narrator": "雛", "text": "神楽ちゃん解説よろ"},
        { "location": "1862/TALK"  , "narrator": "神楽", "text": "そう言われても"},
        { "location": "1863/TALK"  , "narrator": "神楽", "text": "私もイミフですし、、、"},
        { "location": "1865/SEL"   , "narrator": "", "text": "方法は、繭ならすぐわかるはず"},
        { "location": "1866/ACT"   , "narrator": "", "text": "方法は、繭ならすぐわかるはず"},
        { "location": "1868/TALK"  , "narrator": "雛", "text": "まゆちん解説よろ"},
        { "location": "1869/TALK"  , "narrator": "繭", "text": "今はわからない"},
        { "location": "1870/TALK"  , "narrator": "繭", "text": "アウターキー入れたら"},
        { "location": "1871/TALK"  , "narrator": "繭", "text": "わかるってことだと思う"},
        { "location": "1872/SEL"   , "narrator": "", "text": "そういうこと"},
        { "location": "1873/ACT"   , "narrator": "", "text": "そういうこと"},
        { "location": "1875/TALK"  , "narrator": "繭", "text": "わかった"},
        { "location": "1876/TALK"  , "narrator": "神楽", "text": "じゃああとは"},
        { "location": "1877/TALK"  , "narrator": "神楽", "text": "繭さんにお任せってことですね"},
        { "location": "1879/SEL"   , "narrator": "", "text": "雛にも一つお願いがある"},
        { "location": "1880/ACT"   , "narrator": "", "text": "雛にも一つお願いがある"},
        { "location": "1882/TALK"  , "narrator": "雛", "text": "あたし？"},
        { "location": "1883/TALK"  , "narrator": "雛", "text": "まゆちんみたいなことできないんだけど"},
        { "location": "1884/SEL"   , "narrator": "", "text": "必要な機材を作って欲しい"},
        { "location": "1885/ACT"   , "narrator": "", "text": "必要な機材を作って欲しい"},
        { "location": "1887/TALK"  , "narrator": "雛", "text": "オーケーオーケーいくらでもつくるよー！！"},
        { "location": "1888/TALK"  , "narrator": "雛", "text": "盛り上がって参りました！"},
        { "location": "1890/SEL"   , "narrator": "", "text": "何を作るかはまた後で指示するから、まずはファイルを読んでおいて"},
        { "location": "1891/ACT"   , "narrator": "", "text": "何を作るかはまた後で指示するから、まずはファイルを読んでおいて"},
        { "location": "1893/TALK"  , "narrator": "雛", "text": "らじゃー！"},
        { "location": "1894/TALK"  , "narrator": "繭", "text": "わかりました"},
        { "location": "1928/TALK"  , "narrator": "繭", "text": "…東雲教官……？"},
        { "location": "1929/TALK"  , "narrator": "雛", "text": "教官？\n向こうから掛けて\nくるなんて珍しいね？"},
        { "location": "1934/TALK"  , "narrator": "繭", "text": "……はい。"},
        { "location": "1935/TALK"  , "narrator": "繭", "text": "………はい。"},
        { "location": "1936/TALK"  , "narrator": "神楽", "text": "……。"},
        { "location": "1937/TALK"  , "narrator": "繭", "text": "わかりました。\n急ぎます。"},
        { "location": "1940/TALK"  , "narrator": "雛", "text": "教官、なんだって？"},
        { "location": "1942/TALK"  , "narrator": "繭", "text": "ごめん。"},
        { "location": "1943/TALK"  , "narrator": "繭", "text": "本当にごめん。"},
        { "location": "1944/TALK"  , "narrator": "神楽", "text": "どうしたんですか？"},
        { "location": "1946/TALK"  , "narrator": "繭", "text": "さっき私、ヘマした。\nごめん！！"},
        { "location": "1947/TALK"  , "narrator": "雛", "text": "え……それって……"},
        { "location": "1949/TALK"  , "narrator": "繭", "text": "すぐにここから\n逃げないとまずい！"},
        { "location": "1951/TALK"  , "narrator": "神楽", "text": "……っ。"},
        { "location": "1952/TALK"  , "narrator": "神楽", "text": "わかりました。\nすぐに行きましょう！"},
        { "location": "1953/TALK"  , "narrator": "繭", "text": "卯月さん！"},
        { "location": "1954/TALK"  , "narrator": "神楽", "text": "はいっ！"},
        { "location": "1955/TALK"  , "narrator": "繭", "text": "これを渡しておく。"},
        { "location": "1956/TALK"  , "narrator": "神楽", "text": "SIM…カードですか？"},
        { "location": "1957/TALK"  , "narrator": "繭", "text": "そう。\n中身については、\n走りながら話す。"},
        { "location": "1958/TALK"  , "narrator": "繭", "text": "これだけでも\n渡しておけば、\n万一捕まってもきっと――"},
        { "location": "1959/TALK"  , "narrator": "雛", "text": "早く、早く！！"},
        { "location": "1989/TALK"  , "narrator": "繭", "text": "…！！"},
        { "location": "1990/TALK"  , "narrator": "雛", "text": "囲まれた！！"},
        { "location": "1991/TALK"  , "narrator": "神楽", "text": "遅かった……。"},
        { "location": "1992/TALK"  , "narrator": "千羽鶴", "text": "卯月神楽。\n光月繭。\n日向雛。"},
        { "location": "1993/TALK"  , "narrator": "千羽鶴", "text": "情報管理庁特Aクラス\nサーバーへの不正アクセス\n及びハッキング容疑で――"},
        { "location": "1994/TALK"  , "narrator": "千羽鶴", "text": "その身柄を\n拘束する。"},
        { "location": "1739/DIALOG", "narrator": "Dialog_Alert", "text": "<color=red>【TRI-OS Notice:0x99】</color>\nRedinessカーネルにおける一般保護領域1xFFFに例外が発生しました。\n\nTRI-OSを再起動します。\n(0xFF)"},
        { "location": "1747/DIALOG", "narrator": "INFO", "text": "<color=red>【TRI-OS Information:0x23】</color>\nTRI-OSは深刻な問題の解決に成功しました。量子接続フック1xFFFに新規アドレスを定義しました。\n\n今回の再起動による情報の欠落など障害の情報はありません。\n(0x00)"},
        { "location": "2007/DIALOG", "narrator": "Dialog_chapter_ch05", "text": "【23 エクセプション】"},
        { "location": "2019/DIALOG", "narrator": "Dialog_chapter_ch05", "text": "【23 エクセプション】"}
    ]
}
