        "title": "005 メインストーリー",
        "sub_title": "新メンバー？＜後編＞"
    },
    "entry":
    [
        { "location": "622/SCENARIO", "narrator": "", "text": "新メンバー？"},
        { "location": "644/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "648/TALK"    , "narrator": "つばめ", "text": "…ありがと、みんな。\nとっても心強いよ。"},
        { "location": "650/TALK"    , "narrator": "雛", "text": "そう思ってくれる？"},
        { "location": "652/TALK"    , "narrator": "つばめ", "text": "うん！"},
        { "location": "653/TALK"    , "narrator": "雛", "text": "そっか…よかったぁ！"},
        { "location": "654/TALK"    , "narrator": "雛", "text": "もしかしたら、\nつばめちゃんを\n困らせたりとか――"},
        { "location": "655/TALK"    , "narrator": "雛", "text": "迷惑に思われたりとか\nしたらどうしよう、\nって不安だったんだ。"},
        { "location": "656/TALK"    , "narrator": "ヒカル", "text": "逢瀬さんに内緒で、\nここまで話を進めて\nしまいましたからね。"},
        { "location": "657/TALK"    , "narrator": "雛", "text": "うん…お節介って\n思われたらどうしよう\nって――"},
        { "location": "658/TALK"    , "narrator": "雛", "text": "実は、ちょっとだけ\n怖かったんだ。"},
        { "location": "659/TALK"    , "narrator": "つばめ", "text": "ひなこちゃん…。\nわたし、そんな風に\n思ってないよ。"},
        { "location": "662/TALK"    , "narrator": "つばめ", "text": "学校だけじゃなくて、\nバイトでも一緒に\nいられるなんて――"},
        { "location": "663/TALK"    , "narrator": "つばめ", "text": "とっても嬉しいよ！"},
        { "location": "664/TALK"    , "narrator": "雛", "text": "えへへ…よかったぁ。"},
        { "location": "665/TALK"    , "narrator": "繭", "text": "…………。"},
        { "location": "666/TALK"    , "narrator": "キリト", "text": "へへっ…さてと――"},
        { "location": "667/TALK"    , "narrator": "キリト", "text": "教官に言われた\n倉庫の整理、さっさと\n済ませちまうか。"},
        { "location": "669/TALK"    , "narrator": "神楽", "text": "場所はわかりますか？"},
        { "location": "671/TALK"    , "narrator": "ヒカル", "text": "いえ…案内して\nもらえると\n助かります。"},
        { "location": "674/TALK"    , "narrator": "神楽", "text": "わかりました。\nでは、ついてきて\nください。"},
        { "location": "676/TALK"    , "narrator": "キリト", "text": "じゃあ、また後でな！"},
        { "location": "685/TALK"    , "narrator": "雛", "text": "そうだ！　あたしも\n教官に言われてること\nあるんだった！"},
        { "location": "687/TALK"    , "narrator": "雛", "text": "まゆちん、手伝って。"},
        { "location": "689/TALK"    , "narrator": "繭", "text": "拒否。\n私の仕事じゃない。"},
        { "location": "690/TALK"    , "narrator": "雛", "text": "部長命令ですー！\nほら、来て来て。"},
        { "location": "693/TALK"    , "narrator": "繭", "text": "…貸しにしとくわ。"},
        { "location": "707/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "719/TALK"    , "narrator": "つばめ", "text": "わたし"},
        { "location": "720/TALK"    , "narrator": "つばめ", "text": "ひなこちゃん達に"},
        { "location": "721/TALK"    , "narrator": "つばめ", "text": "謝った方がぃぃかな？(´・ω・｀)"},
        { "location": "724/SEL"     , "narrator": "", "text": "どういうこと？"},
        { "location": "725/ACT"     , "narrator": "", "text": "どういうこと？"},
        { "location": "727/TALK"    , "narrator": "つばめ", "text": "わたしね"},
        { "location": "728/TALK"    , "narrator": "つばめ", "text": "みんなが"},
        { "location": "729/TALK"    , "narrator": "つばめ", "text": "ぉ手伝ぃしてくれるの聞ぃて"},
        { "location": "730/TALK"    , "narrator": "つばめ", "text": "やめてほしぃな、って"},
        { "location": "731/TALK"    , "narrator": "つばめ", "text": "思っちゃったの(o´Д`)=з"},
        { "location": "734/SEL"     , "narrator": "", "text": "それはどうして？"},
        { "location": "735/ACT"     , "narrator": "", "text": "それはどうして？"},
        { "location": "737/TALK"    , "narrator": "つばめ", "text": "だって"},
        { "location": "738/TALK"    , "narrator": "つばめ", "text": "ひなこちゃん達は普通の人だから"},
        { "location": "739/TALK"    , "narrator": "つばめ", "text": "フェノメノンとは戦ぇなぃでしょ？ヾ(｡>﹏<｡)ﾉﾞ"},
        { "location": "740/TALK"    , "narrator": "つばめ", "text": "それなのに手伝ぅなんて"},
        { "location": "741/TALK"    , "narrator": "つばめ", "text": "危険だと思ったの(´ｪ｀；)三(；´ｪ｀)"},
        { "location": "744/TALK"    , "narrator": "つばめ", "text": "わたし"},
        { "location": "745/TALK"    , "narrator": "つばめ", "text": "自分が戦ぇるからって"},
        { "location": "746/TALK"    , "narrator": "つばめ", "text": "ぃぃ気分になってたの\nかなぁ？(o´Д`)=з"},
        { "location": "747/TALK"    , "narrator": "つばめ", "text": "ひなこちゃん達は"},
        { "location": "748/TALK"    , "narrator": "つばめ", "text": "純粋にわたし達のことを思って"},
        { "location": "749/TALK"    , "narrator": "つばめ", "text": "手伝ぅって言ってくれたのに"},
        { "location": "750/TALK"    , "narrator": "つばめ", "text": "失礼なこと考ぇちゃって(´つω・｀)ｼｭﾝ"},
        { "location": "754/TALK"    , "narrator": "つばめ", "text": "だから"},
        { "location": "755/TALK"    , "narrator": "つばめ", "text": "本当はぁりがとぅとか嬉しぃじゃなくて"},
        { "location": "756/TALK"    , "narrator": "つばめ", "text": "ごめんなさぃって"},
        { "location": "757/TALK"    , "narrator": "つばめ", "text": "言わなきゃぃけなぃのかも(´･ω･｀) "},
        { "location": "759/SEL"     , "narrator": "", "text": "みんなそんなの望んでない"},
        { "location": "760/SEL"     , "narrator": "", "text": "危険なのは事実"},
        { "location": "761/ACT"     , "narrator": "", "text": "みんなそんなの望んでない"},
        { "location": "762/TALK"    , "narrator": "つばめ", "text": "そぅなのかなぁ？"},
        { "location": "763/TALK"    , "narrator": "つばめ", "text": "でも"},
        { "location": "764/TALK"    , "narrator": "つばめ", "text": "失礼なこと思っちゃったのは本当なんだよ？(o´Д`)=з"},
        { "location": "766/SEL"     , "narrator": "", "text": "素直にみんなの気持ち受け取ろうよ"},
        { "location": "767/ACT"     , "narrator": "", "text": "素直にみんなの気持ち受け取ろうよ"},
        { "location": "770/TALK"    , "narrator": "つばめ", "text": "ぁりがと(*´ω｀*)"},
        { "location": "771/TALK"    , "narrator": "つばめ", "text": "$handle$さんの言ぅ通りかも"},
        { "location": "772/TALK"    , "narrator": "つばめ", "text": "ひなこちゃん達の気持ちを素直に受け止めること"},
        { "location": "773/TALK"    , "narrator": "つばめ", "text": "それが一番大事だよね(´∀｀*)ｳﾌﾌ"},
        { "location": "785/TALK"    , "narrator": "つばめ", "text": "…なんか、心の中が\nスッキリした気分。"},
        { "location": "786/TALK"    , "narrator": "つばめ", "text": "$handle$さんに\n相談してよかった…。"},
        { "location": "787/ACT"     , "narrator": "", "text": "危険なのは事実"},
        { "location": "788/TALK"    , "narrator": "つばめ", "text": "そぅかもしれなぃけど"},
        { "location": "789/TALK"    , "narrator": "つばめ", "text": "みんなのこと信頼してなかったみたぃな"},
        { "location": "790/TALK"    , "narrator": "つばめ", "text": "そんな気がしちゃって(o´Д`)=з"},
        { "location": "791/TALK"    , "narrator": "つばめ", "text": "何だか悲しぃ気持ちになるの(´つω・｀)ｼｭﾝ"},
        { "location": "793/SEL"     , "narrator": "", "text": "でも、今は違うんでしょ？"},
        { "location": "794/ACT"     , "narrator": "", "text": "でも、今は違うんでしょ？"},
        { "location": "796/TALK"    , "narrator": "つばめ", "text": "ぅん"},
        { "location": "797/TALK"    , "narrator": "つばめ", "text": "今はもぅそんな風に思ってなぃよ(*´︶`*)"},
        { "location": "799/SEL"     , "narrator": "", "text": "その気持ちを忘れないことが大切"},
        { "location": "800/ACT"     , "narrator": "", "text": "その気持ちを忘れないことが大切"},
        { "location": "803/TALK"    , "narrator": "つばめ", "text": "ぁりがと(*´ω｀*)"},
        { "location": "805/TALK"    , "narrator": "つばめ", "text": "$handle$さんの言ぅ通りかも"},
        { "location": "806/TALK"    , "narrator": "つばめ", "text": "それが一番大事だよね(´∀｀*)ｳﾌﾌ"},
        { "location": "817/TALK"    , "narrator": "つばめ", "text": "…なんか、心の中が\nスッキリした気分。"},
        { "location": "818/TALK"    , "narrator": "つばめ", "text": "$handle$さんに\n相談してよかった…。"},
        { "location": "830/DIALOG"  , "narrator": "Dialog_chapter_ch01", "text": "【10 江戸川橋物語】"}
    ]
}
