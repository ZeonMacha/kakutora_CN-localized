    "type": "",
    "info": {
        "story_id": "23004",
        "cid": "",
        "title": "004 ココロスフィアストーリー【Lv02】",
        "sub_title": "壊されるココロⅠ＜提起＞"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "壊されるココロ１"},
        { "location": "13/DIALOG" , "narrator": "", "text": "<size=40>KOKORO-Lv. 02</size>\nGABRIELLA\n\n<size=45>壊されるココロⅠ</size>\n<size=35>～妄想の逆襲～</size>"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "つ、つばめ…"},
        { "location": "34/TALK"   , "narrator": "ガブリエラ", "text": "……ちゃん？"},
        { "location": "35/TALK"   , "narrator": "つばめ", "text": "え？\nどうしたの？\nガブちゃん。"},
        { "location": "36/TALK"   , "narrator": "ガブリエラ", "text": "あ、いや！\nその！"},
        { "location": "37/TALK"   , "narrator": "ガブリエラ", "text": "あたし、つばめちゃん\nとお友達になりたい\nなぁ……なんて！"},
        { "location": "39/TALK"   , "narrator": "つばめ", "text": "あはは！　なんだ\nそんなことかぁ。"},
        { "location": "42/TALK"   , "narrator": "つばめ", "text": "ダメに\n決まってるじゃん。\nバカじゃないの！？"},
        { "location": "43/TALK"   , "narrator": "ガブリエラ", "text": "うわああっ！\nご、ごめんなさい！\nごめんなさいっ！"},
        { "location": "45/TALK"   , "narrator": "つばめ", "text": "お前さあ、\nいつもわたしに何を\nしてるか自覚あんの？"},
        { "location": "46/TALK"   , "narrator": "ガブリエラ", "text": "は、はいっ…"},
        { "location": "47/TALK"   , "narrator": "つばめ", "text": "迷惑とかウザイとか\n足手まといとか\nリスクだとか！"},
        { "location": "48/TALK"   , "narrator": "つばめ", "text": "年下のくせに先輩とか\n呼ばせるし新人とか\nフザケた呼び方するし！"},
        { "location": "50/TALK"   , "narrator": "ガブリエラ", "text": "……ご、\nごめんなさい…"},
        { "location": "53/TALK"   , "narrator": "つばめ", "text": "まあでも、\nそれももう過去のこと\nだし、水に流すよ。"},
        { "location": "54/TALK"   , "narrator": "ガブリエラ", "text": "え！？\nほんとに？"},
        { "location": "55/TALK"   , "narrator": "つばめ", "text": "もちろんだよ。\nそのかわり――"},
        { "location": "58/TALK"   , "narrator": "つばめ", "text": "お前のクランを\n粉々にぶっ壊して\nからな！"},
        { "location": "60/TALK"   , "narrator": "ガブリエラ", "text": "いやああああああああ\nああああああああああ\nああああああああ！！"},
        { "location": "61/SEL"    , "narrator": "（選択肢）", "text": "ちょ、ちょっと待て！"},
        { "location": "62/ACT"    , "narrator": "", "text": "ちょ、ちょっと待て！"},
        { "location": "65/TALK"   , "narrator": "ガブリエラ", "text": "ひぇ……っ？"},
        { "location": "67/TALK"   , "narrator": "つばめ", "text": "ちょっと、\nアンタ誰よ。"},
        { "location": "80/TALK"   , "narrator": "ガブリエラ", "text": "え、ええええっ！\nあたしだったの？"},
        { "location": "82/TALK"   , "narrator": "表層ガブリエラ", "text": "そうよ。　　　　"},
        { "location": "83/TALK"   , "narrator": "表層ガブリエラ", "text": "あんたがあまりに\nオメデタイこと考えて\nるからお灸を据えたの。"},
        { "location": "84/TALK"   , "narrator": "ガブリエラ", "text": "お、オメデタイって！"},
        { "location": "85/TALK"   , "narrator": "表層ガブリエラ", "text": "いいこと！？\n軟弱なあたし。"},
        { "location": "86/TALK"   , "narrator": "表層ガブリエラ", "text": "逢瀬つばめは\n危険な存在よ。"},
        { "location": "87/TALK"   , "narrator": "表層ガブリエラ", "text": "友達になろうとか、\n仲良くなろうとか、\nそんな事思わないで！"},
        { "location": "88/TALK"   , "narrator": "ガブリエラ", "text": "な、軟弱ですって！？"},
        { "location": "89/TALK"   , "narrator": "ガブリエラ", "text": "これから同じ仲間に\nなる子なのよ！？"},
        { "location": "90/TALK"   , "narrator": "ガブリエラ", "text": "つばめにビビってる\nあんたの方が、よほど\n軟弱よ。"},
        { "location": "91/TALK"   , "narrator": "表層ガブリエラ", "text": "あら、言ったわね。\nこうなったらもう、\n勝負するしかないわね。"},
        { "location": "92/TALK"   , "narrator": "ガブリエラ", "text": "望むところよ。"},
        { "location": "93/TALK"   , "narrator": "ガブリエラ", "text": "つばめはあんたが\n思ってるような\n怖い子じゃないわ。"},
        { "location": "94/TALK"   , "narrator": "ガブリエラ", "text": "あたしが勝って、\nそれを証明してあげる。"},
        { "location": "95/SEL"    , "narrator": "（選択肢）", "text": "あ、あのー"},
        { "location": "96/ACT"    , "narrator": "", "text": "あ、あのー"},
        { "location": "103/TALK"  , "narrator": "ガブリエラ", "text": "で？\nあんたはどっちに\n力を貸してくれるの？"},
        { "location": "104/SEL"   , "narrator": "（選択肢）", "text": "仲良くなりたいガブリエラ"},
        { "location": "105/SEL"   , "narrator": "（選択肢）", "text": "警戒するガブリエラ"},
        { "location": "106/ACT"   , "narrator": "", "text": "仲良くなりたいガブリエラ"},
        { "location": "110/TALK"  , "narrator": "表層ガブリエラ", "text": "ふん。\n所詮外野は\n無責任なものね。"},
        { "location": "111/TALK"  , "narrator": "表層ガブリエラ", "text": "やっぱり\n自分を守れるのは\nあたしだけ。"},
        { "location": "112/TALK"  , "narrator": "表層ガブリエラ", "text": "最強のクランで\nあんたたちを\nぶっ壊してあげる。"},
        { "location": "114/TALK"  , "narrator": "ガブリエラ", "text": "それは\nこっちのセリフよ！"},
        { "location": "121/ACT"   , "narrator": "", "text": "警戒するガブリエラ"},
        { "location": "122/TALK"  , "narrator": "ガブリエラ", "text": "えええっ！！\nなんでよ！"},
        { "location": "127/TALK"  , "narrator": "表層ガブリエラ", "text": "当然の選択ね。"},
        { "location": "128/TALK"  , "narrator": "表層ガブリエラ", "text": "今までのつばめを\n見ていれば誰でも\nわかることよ。"},
        { "location": "129/TALK"  , "narrator": "表層ガブリエラ", "text": "どう考えても普通じゃ\nないわ、あの子。\nそうでしょ？"},
        { "location": "130/SEL"   , "narrator": "（選択肢）", "text": "うむ"},
        { "location": "131/ACT"   , "narrator": "", "text": "うむ"},
        { "location": "136/TALK"  , "narrator": "ガブリエラ", "text": "そんなことないわよ！"},
        { "location": "137/TALK"  , "narrator": "ガブリエラ", "text": "確かに変な力を\n持ってはいるけど――"},
        { "location": "138/TALK"  , "narrator": "ガブリエラ", "text": "あたしを壊そうと\nしたりなんて絶対\nしないわよ。"},
        { "location": "144/TALK"  , "narrator": "表層ガブリエラ", "text": "本当に\nしょうがないあたし。"},
        { "location": "145/TALK"  , "narrator": "表層ガブリエラ", "text": "あんたはあたしの\nココロには不要な\n存在よ。"},
        { "location": "146/TALK"  , "narrator": "表層ガブリエラ", "text": "今すぐ\n消してあげるわ。"},
        { "location": "147/TALK"  , "narrator": "ガブリエラ", "text": "あたしのクランに\n勝てたらね！"},
        { "location": "166/DIALOG", "narrator": "", "text": "<color=black><size=50><b>つばめに対する気持ちを整理させ\n彼女のココロを安定させよ！</b></size></color>\n\n\n\nガブリエラは、逢瀬つばめを\n非常に危険な存在として捉えている。\nそれはドーム戦の最中に\n人が変わったようになったことが\n原因ではあるが、同時に普通の友達として\n仲良くなりたいという気持ちも存在する。\n\n今回はどちらの味方についても構わない。\n彼女の気持ちを整理して、ココロを成長させよう！\n\n"}
    ]
}
