    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "セピア色には早すぎて"},
        { "location": "34/TALK"   , "narrator": "アーヤ", "text": "合宿で撮った集合写真"},
        { "location": "35/TALK"   , "narrator": "アーヤ", "text": "シェアしようと思ってたんだけど"},
        { "location": "36/TALK"   , "narrator": "アーヤ", "text": "見直すの辛いわ(´o｀；"},
        { "location": "38/SEL"    , "narrator": "", "text": "卯月が写ってるやつだね"},
        { "location": "39/SEL"    , "narrator": "", "text": "みんなで撮ったやつだね"},
        { "location": "40/SEL"    , "narrator": "", "text": "$me$が写ってないからでしょ"},
        { "location": "41/ACT"    , "narrator": "", "text": "卯月が写ってるやつだね"},
        { "location": "42/TALK"   , "narrator": "アーヤ", "text": "そう"},
        { "location": "43/ACT"    , "narrator": "", "text": "みんなで撮ったやつだね"},
        { "location": "44/TALK"   , "narrator": "アーヤ", "text": "まあそうね"},
        { "location": "45/ACT"    , "narrator": "", "text": "$me$が写ってないからでしょ"},
        { "location": "46/TALK"   , "narrator": "アーヤ", "text": "なんでよ"},
        { "location": "47/TALK"   , "narrator": "アーヤ", "text": "写ってる方が"},
        { "location": "48/TALK"   , "narrator": "アーヤ", "text": "こわいでしょ！"},
        { "location": "51/SEL"    , "narrator": "", "text": "撮った時の思い出は変わらない"},
        { "location": "52/SEL"    , "narrator": "", "text": "もう見ない方がいい"},
        { "location": "53/SEL"    , "narrator": "", "text": "どう思ってる？"},
        { "location": "54/ACT"    , "narrator": "", "text": "撮った時の思い出は変わらない"},
        { "location": "57/TALK"   , "narrator": "アーヤ", "text": "そう"},
        { "location": "58/TALK"   , "narrator": "アーヤ", "text": "思いたいけど"},
        { "location": "59/TALK"   , "narrator": "アーヤ", "text": "実際その瞬間は"},
        { "location": "61/TALK"   , "narrator": "アーヤ", "text": "楽しかったけど"},
        { "location": "64/TALK"   , "narrator": "アーヤ", "text": "どうしてもね"},
        { "location": "65/TALK"   , "narrator": "アーヤ", "text": "そう割り切れないわ"},
        { "location": "66/TALK"   , "narrator": "アーヤ", "text": "なかなか"},
        { "location": "67/ACT"    , "narrator": "", "text": "もう見ない方がいい"},
        { "location": "69/TALK"   , "narrator": "アーヤ", "text": "そうね"},
        { "location": "70/TALK"   , "narrator": "アーヤ", "text": "そう思うけど"},
        { "location": "71/TALK"   , "narrator": "アーヤ", "text": "なぜか見ちゃうの"},
        { "location": "72/ACT"    , "narrator": "", "text": "どう思ってる？"},
        { "location": "74/TALK"   , "narrator": "アーヤ", "text": "よくわからない"},
        { "location": "75/TALK"   , "narrator": "アーヤ", "text": "それが正直な気持ち"},
        { "location": "77/TALK"   , "narrator": "アーヤ", "text": "もちろん卯月は"},
        { "location": "78/TALK"   , "narrator": "アーヤ", "text": "本当のことを隠してたんだし"},
        { "location": "79/TALK"   , "narrator": "アーヤ", "text": "ばれないように嘘もついてた"},
        { "location": "80/TALK"   , "narrator": "アーヤ", "text": "だけど"},
        { "location": "81/TALK"   , "narrator": "アーヤ", "text": "それはそれで"},
        { "location": "82/TALK"   , "narrator": "アーヤ", "text": "辛かったんじゃないかしら"},
        { "location": "83/TALK"   , "narrator": "アーヤ", "text": "だからって"},
        { "location": "84/TALK"   , "narrator": "アーヤ", "text": "裏切られたことには"},
        { "location": "85/TALK"   , "narrator": "アーヤ", "text": "変わりないし"},
        { "location": "86/TALK"   , "narrator": "アーヤ", "text": "嘘に気づけなかったことにも"},
        { "location": "87/TALK"   , "narrator": "アーヤ", "text": "腹が立つのよ"},
        { "location": "90/TALK"   , "narrator": "アーヤ", "text": "簡単に整理つかないわ"},
        { "location": "92/TALK"   , "narrator": "アーヤ", "text": "こればっかりは"}
    ]
}
