{
    "dir": "chap21/daydra/dd_ch04_21_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "21402",
        "cid": "miyabi",
        "title": "002 メインストーリー",
        "sub_title": "こじゃんと元気キャラ＜前編＞"
    },
    "entry":
    [
        { "location": "52/TALK"   , "narrator": "つばめ", "text": "…あれ？\nもうすぐお昼！？"},
        { "location": "55/TALK"   , "narrator": "神楽", "text": "えっ！　もうそんな\n時間ですか！？"},
        { "location": "56/TALK"   , "narrator": "つばめ", "text": "……そうみたい…。"},
        { "location": "57/TALK"   , "narrator": "つばめ", "text": "お休み、\n半日無駄に\nしちゃったね…。"},
        { "location": "60/TALK"   , "narrator": "アーヤ", "text": "今日は仕方ないわ。\nみんな昨日の疲れも\n残ってると思うし。"},
        { "location": "62/TALK"   , "narrator": "神楽", "text": "アーヤさんも、\n昨日の訓練キツいと\n思いました？"},
        { "location": "64/TALK"   , "narrator": "アーヤ", "text": "さすがにね…。\n後半はもうヘトヘト\nだったわ。"},
        { "location": "65/TALK"   , "narrator": "つばめ", "text": "わたし、疲れすぎて\nよく覚えてません…。"},
        { "location": "68/TALK"   , "narrator": "ガブリエラ", "text": "つばめ、帰ってきて\nお風呂入ったら\nすぐ寝ちゃったものね。"},
        { "location": "70/TALK"   , "narrator": "アーヤ", "text": "ギャヴィだって、\nお夕飯食べながら\nウトウトしてたわよ？"},
        { "location": "71/TALK"   , "narrator": "ガブリエラ", "text": "う、うるさいわね！\n寝なかったんだから\nいいでしょ？"},
        { "location": "74/TALK"   , "narrator": "神楽", "text": "…この分だと、\n午後も無駄にしちゃい\nそうですね。"},
        { "location": "76/TALK"   , "narrator": "アーヤ", "text": "…まあ、\n体を休ませる、って\nいうのも訓練のうち。"},
        { "location": "77/TALK"   , "narrator": "アーヤ", "text": "本番で疲れ切ってたら\n困るものね。"},
        { "location": "78/TALK"   , "narrator": "つばめ", "text": "うう…、とっても\n勿体ないことしてる\n気がします…。"},
        { "location": "82/TALK"   , "narrator": "みやび", "text": "なんや？\nみんな、昼間っから\nダラダラしよって…。"},
        { "location": "84/TALK"   , "narrator": "ガブリエラ", "text": "そりゃ、みやびは\n昨日の訓練\n出てないから。"},
        { "location": "85/TALK"   , "narrator": "ガブリエラ", "text": "疲れてる\nわけがないわよ。"},
        { "location": "86/TALK"   , "narrator": "みやび", "text": "何言うてるが？\nちゃんと参加しちょっ\nたやろ。"},
        { "location": "89/TALK"   , "narrator": "アーヤ", "text": "でも、みやびは\n後方支援だった\nじゃない。"},
        { "location": "90/TALK"   , "narrator": "アーヤ", "text": "モニターの前と\n体を動かすのじゃ\n違うわよ。"},
        { "location": "92/TALK"   , "narrator": "みやび", "text": "戦場の全体を把握する\nっちゅうんは、結構\n大変なんやぞ？"},
        { "location": "95/TALK"   , "narrator": "神楽", "text": "でも、翌日に残る\n肉体的な疲れは\nないじゃないですか。"},
        { "location": "96/TALK"   , "narrator": "神楽", "text": "こっちは一日中、\n真幌さんにしごかれて\n大変だったんです。"},
        { "location": "97/TALK"   , "narrator": "みやび", "text": "うん、見ちょったき\nわかるがよ。"},
        { "location": "98/TALK"   , "narrator": "ガブリエラ", "text": "だったら、少しは\nあたし達を労わり\nなさいよね。"},
        { "location": "100/TALK"  , "narrator": "つばめ", "text": "…お昼ご飯食べたら、\nわたし、ちょっと\nお昼寝します…。"},
        { "location": "102/TALK"  , "narrator": "アーヤ", "text": "私もそうしよう\nかしら？"},
        { "location": "104/TALK"  , "narrator": "神楽", "text": "午後はみんなで\nお昼寝になりそう\nですね。"},
        { "location": "106/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "118/TALK"  , "narrator": "みやび", "text": "何とも変な気分である"},
        { "location": "119/TALK"  , "narrator": "みやび", "text": "うちが元気で"},
        { "location": "120/TALK"  , "narrator": "みやび", "text": "みんながヘロヘロ"},
        { "location": "122/SEL"   , "narrator": "", "text": "昨日そんなに大変だったの？"},
        { "location": "123/ACT"   , "narrator": "", "text": "昨日そんなに大変だったの？"},
        { "location": "125/TALK"  , "narrator": "みやび", "text": "東雲真幌教官プレゼンツ・夜までぶっ続け模擬戦！！"},
        { "location": "126/TALK"  , "narrator": "みやび", "text": "って感じやった"},
        { "location": "128/SEL"   , "narrator": "", "text": "それは疲れるね"},
        { "location": "129/ACT"   , "narrator": "", "text": "それは疲れるね"},
        { "location": "131/TALK"  , "narrator": "みやび", "text": "だから今日は一日休み"},
        { "location": "132/TALK"  , "narrator": "みやび", "text": "まほさんの飴と鞭の飴や"},
        { "location": "133/TALK"  , "narrator": "みやび", "text": "こんな状態じゃ訓練にならんし"},
        { "location": "137/TALK"  , "narrator": "みやび", "text": "けんど"},
        { "location": "138/TALK"  , "narrator": "みやび", "text": "うちはこんだけ元気なわけで"},
        { "location": "141/TALK"  , "narrator": "みやび", "text": "いつもとは逆に"},
        { "location": "142/TALK"  , "narrator": "みやび", "text": "うちがみんなを遊びに連れだしてみるというのも面白いかもしれん"},
        { "location": "143/TALK"  , "narrator": "みやび", "text": "うちがみんなを振り回すチャンス到来！"},
        { "location": "145/TALK"  , "narrator": "みやび", "text": "ナイスアイデアではないだろうか"},
        { "location": "148/TALK"  , "narrator": "みやび", "text": "とも思うたが"},
        { "location": "149/TALK"  , "narrator": "みやび", "text": "やはりのんびりする"},
        { "location": "160/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "162/TALK"  , "narrator": "みやび", "text": "そんなの、\nうちのキャラや\nないな…。"},
        { "location": "226/TALK"  , "narrator": "みやび", "text": "　"},
        { "location": "249/SEL"   , "narrator": "", "text": "！？？"},
        { "location": "250/ACT"   , "narrator": "", "text": "！？？"},
        { "location": "272/TALK"  , "narrator": "みやび", "text": "エヘヘ、ナデナデサレテ、\nトッテモウレシイゾネ"},
        { "location": "275/TALK"  , "narrator": "みやび", "text": "キャーソンナトコサワル\nナンテエッツー！"},
        { "location": "278/TALK"  , "narrator": "みやび", "text": "オナカヲナデルノガ\nスキナノ？　モーフェチ\nズムタロウナンダカラァー"},
        { "location": "283/SEL"   , "narrator": "", "text": "なんだこれ…"},
        { "location": "284/ACT"   , "narrator": "", "text": "なんだこれ…"},
        { "location": "289/TALK"  , "narrator": "みやび", "text": "うちの人形"},
        { "location": "290/TALK"  , "narrator": "みやび", "text": "ココロスフィアに来たら叩き起こすのが日課になっていたであろう。急にそれがしかも２回も続くとなれば、禁断症状で苦しむかと思ってな"},
        { "location": "291/TALK"  , "narrator": "みやび", "text": "みやびさんの気遣いは職人級！褒め称えよ"},
        { "location": "292/SEL"   , "narrator": "", "text": "いや…これはちょっと……"},
        { "location": "293/SEL"   , "narrator": "", "text": "お持ち帰りしていいですか？"},
        { "location": "294/ACT"   , "narrator": "", "text": "いや…これはちょっと……"},
        { "location": "295/TALK"  , "narrator": "みやび", "text": "贅沢者め"},
        { "location": "296/TALK"  , "narrator": "みやび", "text": "そのような言葉は、うちをサクッと救出できるくらいの力をつけてから言うがいい"},
        { "location": "297/ACT"   , "narrator": "", "text": "お持ち帰りしていいですか？"},
        { "location": "298/TALK"  , "narrator": "みやび", "text": "否"},
        { "location": "299/TALK"  , "narrator": "みやび", "text": "まっこと変態さんやね、お前さんは"},
        { "location": "300/TALK"  , "narrator": "みやび", "text": "勿論褒め言葉として受け取っておけ"},
        { "location": "301/TALK"  , "narrator": "みやび", "text": "オマエサンノナカデハナー"},
        { "location": "305/SEL"   , "narrator": "", "text": "みやび！？"},
        { "location": "306/ACT"   , "narrator": "", "text": "みやび！？"},
        { "location": "308/TALK"  , "narrator": "みやび", "text": "どうした？そんな驚くようなこと言ったか"},
        { "location": "309/SEL"   , "narrator": "", "text": "もう一人みやびが来た"},
        { "location": "310/ACT"   , "narrator": "", "text": "もう一人みやびが来た"},
        { "location": "312/TALK"  , "narrator": "みやび", "text": "は"},
        { "location": "329/SEL"   , "narrator": "", "text": "人形消されたよ！"},
        { "location": "330/ACT"   , "narrator": "", "text": "人形消されたよ！"},
        { "location": "332/TALK"  , "narrator": "みやび", "text": "いやそんな"},
        { "location": "334/TALK"  , "narrator": "みやび", "text": "いかんそいつはうちのか"},
        { "location": "339/TALK"  , "narrator": "みやび", "text": "楽しそうやね。"},
        { "location": "340/SEL"   , "narrator": "", "text": "君は何のみやびなの？"},
        { "location": "341/ACT"   , "narrator": "", "text": "君は何のみやびなの？"},
        { "location": "343/TALK"  , "narrator": "みやび", "text": "面白い聞き方するね。"},
        { "location": "344/TALK"  , "narrator": "みやび", "text": "うちは今回から\nココロの司書に任命された\n人格や。よろしくね。"},
        { "location": "345/SEL"   , "narrator": "", "text": "前の司書は？"},
        { "location": "346/SEL"   , "narrator": "", "text": "司書なら既に足りてます"},
        { "location": "347/ACT"   , "narrator": "", "text": "前の司書は？"},
        { "location": "348/ACT"   , "narrator": "", "text": "司書なら既に足りてます"},
        { "location": "349/TALK"  , "narrator": "みやび", "text": "ハナから攻撃的で\nみやびさんは辛いぞね。"},
        { "location": "350/TALK"  , "narrator": "みやび", "text": "うちとも前任のように\n仲良くやってや。"},
        { "location": "352/TALK"  , "narrator": "みやび", "text": "前任は、２回の無断欠勤を\nしたために、契約に則り\n解任された。"},
        { "location": "353/SEL"   , "narrator": "", "text": "回線切ったのも君なの？"},
        { "location": "354/ACT"   , "narrator": "", "text": "回線切ったのも君なの？"},
        { "location": "356/TALK"  , "narrator": "みやび", "text": "然り。"},
        { "location": "357/TALK"  , "narrator": "みやび", "text": "司書でなくなった元司書は\nお前さんと話す資格が\n無くなっちゅう。"},
        { "location": "358/TALK"  , "narrator": "みやび", "text": "よって、無条件で\n回線を切断した。\nそれだけのことぞね。"},
        { "location": "361/TALK"  , "narrator": "みやび", "text": "そこの"},
        { "location": "362/TALK"  , "narrator": "みやび", "text": "うちは何も聞いていない。よって拒否権を発動する"},
        { "location": "370/TALK"  , "narrator": "みやび", "text": "CHAT窓を"},
        { "location": "371/TALK"  , "narrator": "みやび", "text": "シャットダウンする権利はない"},
        { "location": "379/TALK"  , "narrator": "みやび", "text": "人権侵害"},
        { "location": "384/TALK"  , "narrator": "みやび", "text": "ほんだら、\nすっと仕事するぞね。"},
        { "location": "388/TALK"  , "narrator": "みやび", "text": "オープンプロセス、\n0x111番地から\n0xF38番地へ。"},
        { "location": "389/SEL"   , "narrator": "", "text": "いや待って待って！"},
        { "location": "390/ACT"   , "narrator": "", "text": "いや待って待って！"},
        { "location": "411/TALK"  , "narrator": "みやび", "text": "完了。"},
        { "location": "414/TALK"  , "narrator": "みやび", "text": "さてさて、\nうちは普段どんな\n悩みを持っちゅうんかね。"},
        { "location": "415/TALK"  , "narrator": "みやび", "text": "……ふむ。\nなるほど。\nこんな感じぞね。"},
        { "location": "418/SEL"   , "narrator": "", "text": "こんな感じ…って！\nちょっと！"},
        { "location": "419/ACT"   , "narrator": "", "text": "こんな感じ…って！\nちょっと！"},
        { "location": "421/TALK"  , "narrator": "みやび", "text": "いてら。"},
        { "location": "432/TALK"  , "narrator": "みやび", "text": "さて。"},
        { "location": "433/TALK"  , "narrator": "みやび", "text": "消しに行くか。"},
        { "location": "51/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>8月22日　 11:40 AM</color>\n合宿中、みやびの実家でのこと"},
        { "location": "191/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "193/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "195/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "197/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "199/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "258/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "281/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"},
        { "location": "338/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:WaveSystem】</color>\n\n回線が強制切断されました。\n(002)"},
        { "location": "366/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:WaveSystem】</color>\n\n回線が強制切断されました。\n(002)"},
        { "location": "375/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:WaveSystem】</color>\n\n回線が強制切断されました。\n(002)"},
        { "location": "383/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:WaveSystem】</color>\n\n回線が強制切断されました。\n(002)"},
