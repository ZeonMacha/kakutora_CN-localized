    "entry":
    [
        { "location": "301/SCENARIO", "narrator": "", "text": "出陣"},
        { "location": "323/TALK"    , "narrator": "つばめ", "text": "ううん"},
        { "location": "324/TALK"    , "narrator": "つばめ", "text": "こういうこと"},
        { "location": "325/TALK"    , "narrator": "つばめ", "text": "前にもあったから"},
        { "location": "326/TALK"    , "narrator": "つばめ", "text": "わかるの(o´Д`)=з"},
        { "location": "330/SEL"     , "narrator": "", "text": "積極的に話してみようよ"},
        { "location": "331/ACT"     , "narrator": "", "text": "積極的に話してみようよ"},
        { "location": "333/TALK"    , "narrator": "つばめ", "text": "無理だよ"},
        { "location": "334/TALK"    , "narrator": "つばめ", "text": "きっと"},
        { "location": "335/TALK"    , "narrator": "つばめ", "text": "余計嫌われちゃう(´つω・｀)ｼｭﾝ"},
        { "location": "336/TALK"    , "narrator": "つばめ", "text": "そんなの"},
        { "location": "337/TALK"    , "narrator": "つばめ", "text": "悲しいよ・゜・(ノД`)・゜・"},
        { "location": "339/SEL"     , "narrator": "", "text": "このままの方が悲しいよ"},
        { "location": "340/ACT"     , "narrator": "", "text": "このままの方が悲しいよ"},
        { "location": "342/TALK"    , "narrator": "つばめ", "text": "そうかもしれないけど"},
        { "location": "344/TALK"    , "narrator": "つばめ", "text": "怖いの"},
        { "location": "345/TALK"    , "narrator": "つばめ", "text": "仲良くなりたい人に"},
        { "location": "346/TALK"    , "narrator": "つばめ", "text": "引かれちゃうのって"},
        { "location": "348/SEL"     , "narrator": "", "text": "思いっきりが足りないからそうなる"},
        { "location": "349/ACT"     , "narrator": "", "text": "思いっきりが足りないからそうなる"},
        { "location": "351/TALK"    , "narrator": "つばめ", "text": "そんなことない"},
        { "location": "352/TALK"    , "narrator": "つばめ", "text": "前の時だって"},
        { "location": "353/TALK"    , "narrator": "つばめ", "text": "頑張ったもん"},
        { "location": "355/SEL"     , "narrator": "", "text": "足りないよ"},
        { "location": "356/ACT"     , "narrator": "", "text": "足りないよ"},
        { "location": "358/TALK"    , "narrator": "つばめ", "text": "そうかな？"},
        { "location": "360/TALK"    , "narrator": "つばめ", "text": "何が足りないのかな？"},
        { "location": "362/SEL"     , "narrator": "", "text": "もっと仲良くなりたい、って気持ちを出していけ"},
        { "location": "363/ACT"     , "narrator": "", "text": "もっと仲良くなりたい、って気持ちを出していけ"},
        { "location": "366/SEL"     , "narrator": "", "text": "とにかく、話さなくちゃ"},
        { "location": "367/ACT"     , "narrator": "", "text": "とにかく、話さなくちゃ"},
        { "location": "369/TALK"    , "narrator": "つばめ", "text": "ちゃんと話せば"},
        { "location": "370/TALK"    , "narrator": "つばめ", "text": "少しは仲良くなれるかな？(´･ω･｀) "},
        { "location": "371/TALK"    , "narrator": "つばめ", "text": "嫌われたままでいられるのは嫌だよ(´つω・｀)ｼｭﾝ"},
        { "location": "373/SEL"     , "narrator": "", "text": "頑張れ、つばめ！"},
        { "location": "374/ACT"     , "narrator": "", "text": "頑張れ、つばめ！"},
        { "location": "376/TALK"    , "narrator": "つばめ", "text": "ありがと(≧ω≦)"},
        { "location": "377/TALK"    , "narrator": "つばめ", "text": "でも"},
        { "location": "378/TALK"    , "narrator": "つばめ", "text": "なんて話しかければいいかな？(´･ω･｀) "},
        { "location": "379/TALK"    , "narrator": "つばめ", "text": "急だから話題も思いつかないし…"},
        { "location": "381/SEL"     , "narrator": "", "text": "手を繋ごう、と言おう"},
        { "location": "382/SEL"     , "narrator": "", "text": "帰ったら食事しようと誘おう"},
        { "location": "383/ACT"     , "narrator": "", "text": "手を繋ごう、と言おう"},
        { "location": "384/TALK"    , "narrator": "つばめ", "text": "それいいかもヽ(*´∀｀)ノ"},
        { "location": "385/TALK"    , "narrator": "つばめ", "text": "早速言ってみるね(๑･ㅂ･)و☆"},
        { "location": "417/TALK"    , "narrator": "つばめ", "text": "あの、せんぱい。"},
        { "location": "419/TALK"    , "narrator": "ガブリエラ", "text": "…何よ？"},
        { "location": "420/TALK"    , "narrator": "つばめ", "text": "え、えっと…。"},
        { "location": "421/TALK"    , "narrator": "つばめ", "text": "…よかったら、\nわたしと手を繋いで\nもらえませんか？"},
        { "location": "422/TALK"    , "narrator": "ガブリエラ", "text": "っ！？"},
        { "location": "425/TALK"    , "narrator": "ガブリエラ", "text": "は？　いや、何？\n急に何言い出すの？"},
        { "location": "427/TALK"    , "narrator": "つばめ", "text": "だ、だって、こんな\n不気味なところ\n歩いてると――"},
        { "location": "428/TALK"    , "narrator": "つばめ", "text": "何か不安な気持ちに\nなってくるじゃない\nですか。"},
        { "location": "429/TALK"    , "narrator": "つばめ", "text": "だから、よかったら\n手を握ってもらえたら\n嬉しいなぁ、って…。"},
        { "location": "430/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "432/TALK"    , "narrator": "ガブリエラ", "text": "絶対に嫌。\n子供じゃあるまいし。"},
        { "location": "433/TALK"    , "narrator": "つばめ", "text": "そ、そうですか…。"},
        { "location": "435/TALK"    , "narrator": "アーヤ", "text": "ギャヴィ、そんなに\nイジワル言わないの。"},
        { "location": "438/TALK"    , "narrator": "ガブリエラ", "text": "な、なによ？\nまた新人の味方するわけ？"},
        { "location": "439/TALK"    , "narrator": "アーヤ", "text": "新人だと思うなら、\n手くらい繋いであげても\nいいんじゃない？"},
        { "location": "442/TALK"    , "narrator": "ガブリエラ", "text": "むっ…。"},
        { "location": "443/TALK"    , "narrator": "つばめ", "text": "……。"},
        { "location": "444/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "445/TALK"    , "narrator": "ガブリエラ", "text": "やっぱり嫌よ。"},
        { "location": "446/TALK"    , "narrator": "ガブリエラ", "text": "フェノメノンの中で、\nわざわざリスクを冒すような\nことしたくないし。"},
        { "location": "447/TALK"    , "narrator": "つばめ", "text": "…？\nリスク……って…？"},
        { "location": "448/TALK"    , "narrator": "アーヤ", "text": "まったく、イジワル\nなんだから…。"},
        { "location": "451/TALK"    , "narrator": "ガブリエラ", "text": "イジワルじゃない！\n何よ、もう…。"},
        { "location": "452/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "453/ACT"     , "narrator": "", "text": "帰ったら食事しようと誘おう"},
        { "location": "454/TALK"    , "narrator": "つばめ", "text": "それなら自然かも(*´︶`*)"},
        { "location": "455/TALK"    , "narrator": "つばめ", "text": "早速誘ってみる(๑･ㅂ･)و☆"},
        { "location": "485/TALK"    , "narrator": "つばめ", "text": "あ、あの、せんぱい。\nこれが終わった後の\n予定って、ありますか？"},
        { "location": "487/TALK"    , "narrator": "ガブリエラ", "text": "何でそんなこと聞くのよ？"},
        { "location": "488/TALK"    , "narrator": "つばめ", "text": "もし予定がないなら、\n一緒に食事に行きま\nせんか？"},
        { "location": "489/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "491/TALK"    , "narrator": "ガブリエラ", "text": "いや、え？\n何でこのタイミングで\n急にそんなこと聞くわけ？"},
        { "location": "493/TALK"    , "narrator": "つばめ", "text": "考えてみたらわたし、\nまだせんぱいのことって\nよく知らないし――"},
        { "location": "494/TALK"    , "narrator": "つばめ", "text": "せんぱいも、わたしのこと\n知らないと思うから――"},
        { "location": "495/TALK"    , "narrator": "つばめ", "text": "食事でもしながら、\n色々お話したいと\n思ったんです。"},
        { "location": "497/TALK"    , "narrator": "アーヤ", "text": "それ、いいじゃない。\nそうすれば少しは\n距離も縮まるだろうし。"},
        { "location": "498/TALK"    , "narrator": "アーヤ", "text": "行ってあげたら？"},
        { "location": "501/TALK"    , "narrator": "ガブリエラ", "text": "ちょ、やめてよアーヤ！\nあたしは行かないわよ？"},
        { "location": "502/TALK"    , "narrator": "つばめ", "text": "もしかして、予定とか\nありましたか？"},
        { "location": "505/TALK"    , "narrator": "ガブリエラ", "text": "そうじゃないけど…。"},
        { "location": "506/TALK"    , "narrator": "ガブリエラ", "text": "得体のしれない奴と\n食事しても、美味しく\n食べられないわ。"},
        { "location": "507/TALK"    , "narrator": "アーヤ", "text": "ちょっと、ギャヴィ！"},
        { "location": "510/TALK"    , "narrator": "ガブリエラ", "text": "アーヤも！\nそうやって新人の肩ばっか\n持たないでよ！"},
        { "location": "511/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "524/TALK"    , "narrator": "つばめ", "text": "ダメだったよ…ヽ(；▽；)ノ"},
        { "location": "525/TALK"    , "narrator": "つばめ", "text": "やっぱり"},
        { "location": "526/TALK"    , "narrator": "つばめ", "text": "嫌われてるみたい(´つω・｀)ｼｭﾝ"},
        { "location": "528/SEL"     , "narrator": "", "text": "大丈夫だよ"},
        { "location": "529/ACT"     , "narrator": "", "text": "大丈夫だよ"},
        { "location": "531/TALK"    , "narrator": "つばめ", "text": "そう思う？"},
        { "location": "532/TALK"    , "narrator": "つばめ", "text": "$handle$さんは強いね"},
        { "location": "534/SEL"     , "narrator": "", "text": "少しずつ距離を近づければいい"},
        { "location": "535/ACT"     , "narrator": "", "text": "少しずつ距離を近づければいい"},
        { "location": "537/TALK"    , "narrator": "つばめ", "text": "少しずつ…"},
        { "location": "538/TALK"    , "narrator": "つばめ", "text": "近づけるかな？"},
        { "location": "540/SEL"     , "narrator": "", "text": "嫌われてるわけじゃないと思うし"},
        { "location": "541/ACT"     , "narrator": "", "text": "嫌われてるわけじゃないと思うし"},
        { "location": "543/TALK"    , "narrator": "つばめ", "text": "本当にそう思う？"},
        { "location": "544/TALK"    , "narrator": "つばめ", "text": "わたしにはわからない"},
        { "location": "545/TALK"    , "narrator": "つばめ", "text": "ううん"},
        { "location": "546/TALK"    , "narrator": "つばめ", "text": "今のなし"},
        { "location": "547/TALK"    , "narrator": "つばめ", "text": "だって"},
        { "location": "548/TALK"    , "narrator": "つばめ", "text": "わたしはせんぱいと仲良くなりたいと思ってるから"},
        { "location": "549/TALK"    , "narrator": "つばめ", "text": "弱気になってちゃだめだよねヽ(･ω･ )ゝ☆"},
        { "location": "551/SEL"     , "narrator": "", "text": "応援してるぞ！"},
        { "location": "552/ACT"     , "narrator": "", "text": "応援してるぞ！"},
        { "location": "554/TALK"    , "narrator": "つばめ", "text": "ありがと(*´ω｀*)"},
        { "location": "555/TALK"    , "narrator": "つばめ", "text": "あなたの言葉信じて"},
        { "location": "556/TALK"    , "narrator": "つばめ", "text": "頑張ってみる！(๑･ㅂ･)و☆"},
        { "location": "601/TALK"    , "narrator": "アーヤ", "text": "…そろそろ出口ね。"},
        { "location": "602/TALK"    , "narrator": "アーヤ", "text": "各自、準備はいい？\n行くわよ！"},
        { "location": "614/DIALOG"  , "narrator": "Dialog_chapter_ch01", "text": "【04 レッドサイト】"}
    ]
}
