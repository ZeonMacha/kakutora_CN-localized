{
    "dir": "chap18/daydra/dd_ch05_18_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "18502",
        "cid": "kagura",
        "title": "002 メインストーリー",
        "sub_title": "トップヲタか友達か＜前編＞"
    },
    "entry":
    [
        { "location": "2574/TALK"  , "narrator": "神楽", "text": "――いえ、ですから\nそうではなくて…。"},
        { "location": "2575/TALK"  , "narrator": "千羽鶴", "text": "言い訳はいい。\n私が聞きたいのは、\nあなたの答え。"},
        { "location": "2576/TALK"  , "narrator": "千羽鶴", "text": "逢瀬つばめを壊すのか、\nそれとも壊さないのか。\nハッキリしてほしいだけ。"},
        { "location": "2577/TALK"  , "narrator": "神楽", "text": "だから、そんな簡単に\n答えられないと\n言ってるじゃないですか。"},
        { "location": "2578/TALK"  , "narrator": "千羽鶴", "text": "そうかしら？"},
        { "location": "2579/TALK"  , "narrator": "千羽鶴", "text": "母親を助けるという\n目的があるのだから、\n簡単だと思うけど？"},
        { "location": "2580/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "2581/TALK"  , "narrator": "神楽", "text": "私が言えるのは以上です。\n忙しいんで切りますよ。"},
        { "location": "2587/TALK"  , "narrator": "神楽", "text": "…簡単だと思う？\n他人事だからって、\n適当なこと言って！"},
        { "location": "2588/TALK"  , "narrator": "神楽", "text": "簡単じゃないから、\nこんなに悩んでるのに…。"},
        { "location": "2589/TALK"  , "narrator": "神楽", "text": "つばめさんは、\n私の…、親友だから…。"},
        { "location": "2591/TALK"  , "narrator": "神楽", "text": "でも…、私はまだ、\n卯月神楽のままなの？"},
        { "location": "2592/TALK"  , "narrator": "神楽", "text": "つばめさんにとって、\nもしも私がフレイメノウに\nなってたとしたら…。"},
        { "location": "2594/TALK"  , "narrator": "神楽", "text": "そうなったら、私…。"},
        { "location": "2595/TALK"  , "narrator": "神楽", "text": "…メノウのこと\nバラしやがって、\nあのクソゴミが…。"},
        { "location": "2597/SEL"   , "narrator": "", "text": "バレたのがそんなに問題？"},
        { "location": "2598/ACT"   , "narrator": "", "text": "バレたのがそんなに問題？"},
        { "location": "2615/TALK"  , "narrator": "神楽", "text": "問題というか"},
        { "location": "2618/TALK"  , "narrator": "神楽", "text": "知られたくなかったんです"},
        { "location": "2621/TALK"  , "narrator": "神楽", "text": "今まで私とお友達になってくれた子達は"},
        { "location": "2622/TALK"  , "narrator": "神楽", "text": "私をフレイメノウとして見ていて"},
        { "location": "2623/TALK"  , "narrator": "神楽", "text": "メノウの友達というステータス欲しさに近づいてきた子達ばかりだったんです"},
        { "location": "2624/TALK"  , "narrator": "神楽", "text": "でも、つばめさんは違う"},
        { "location": "2625/TALK"  , "narrator": "神楽", "text": "私をメノウじゃなくて"},
        { "location": "2626/TALK"  , "narrator": "神楽", "text": "ただの、卯月神楽として見てくれて"},
        { "location": "2627/TALK"  , "narrator": "神楽", "text": "それでもお友達になってくれた"},
        { "location": "2629/TALK"  , "narrator": "神楽", "text": "それが嬉しくて"},
        { "location": "2632/TALK"  , "narrator": "神楽", "text": "だから、私の正体がバレたことで"},
        { "location": "2633/TALK"  , "narrator": "神楽", "text": "今までの子達みたいに"},
        { "location": "2634/TALK"  , "narrator": "神楽", "text": "私のことを"},
        { "location": "2635/TALK"  , "narrator": "神楽", "text": "フレイメノウとして見るようになってたら"},
        { "location": "2638/TALK"  , "narrator": "神楽", "text": "私も、今までのような気持ちで"},
        { "location": "2639/TALK"  , "narrator": "神楽", "text": "つばめさんを見られない"},
        { "location": "2640/TALK"  , "narrator": "神楽", "text": "だってそれは"},
        { "location": "2641/TALK"  , "narrator": "神楽", "text": "卯月神楽とお友達になったつばめさんじゃないから"},
        { "location": "2643/SEL"   , "narrator": "", "text": "神楽はどうしたいの？"},
        { "location": "2644/SEL"   , "narrator": "", "text": "つばめのこと、信用してないんだ？"},
        { "location": "2645/SEL"   , "narrator": "", "text": "自分勝手すぎるよ"},
        { "location": "2646/ACT"   , "narrator": "", "text": "神楽はどうしたいの？"},
        { "location": "2647/TALK"  , "narrator": "神楽", "text": "なんですかその質問？"},
        { "location": "2648/TALK"  , "narrator": "神楽", "text": "わからないから悩んでるんじゃないですか"},
        { "location": "2649/TALK"  , "narrator": "神楽", "text": "っていうか"},
        { "location": "2650/TALK"  , "narrator": "神楽", "text": "人が悩んでるときに話しかけておいて"},
        { "location": "2651/TALK"  , "narrator": "神楽", "text": "助言の一つもないとか"},
        { "location": "2652/TALK"  , "narrator": "神楽", "text": "意味がわからない"},
        { "location": "2653/TALK"  , "narrator": "神楽", "text": "暇つぶしに話したいだけなら、他を当たってください"},
        { "location": "2665/ACT"   , "narrator": "", "text": "つばめのこと、信用してないんだ？"},
        { "location": "2666/TALK"  , "narrator": "神楽", "text": "私がメノウだと知ったから、私をメノウとして見るようになる"},
        { "location": "2667/TALK"  , "narrator": "神楽", "text": "つばめさんをそんな子だと思っているのか"},
        { "location": "2668/TALK"  , "narrator": "神楽", "text": "そう聞きたいんでしょう？"},
        { "location": "2669/TALK"  , "narrator": "神楽", "text": "言われるまでもなく、思ってませんよ"},
        { "location": "2670/TALK"  , "narrator": "神楽", "text": "でもね、$handle$さん"},
        { "location": "2672/TALK"  , "narrator": "神楽", "text": "絶対にそうじゃないという保証、あるんですか？"},
        { "location": "2673/TALK"  , "narrator": "神楽", "text": "つばめさんは、フレイメノウのことが大好きです"},
        { "location": "2674/TALK"  , "narrator": "神楽", "text": "その気持ちが、卯月神楽への想いより勝る可能性がないと"},
        { "location": "2675/TALK"  , "narrator": "神楽", "text": "どうして言えるんですか？"},
        { "location": "2676/TALK"  , "narrator": "神楽", "text": "それくらい、つばめさんにとってのフレイメノウは"},
        { "location": "2677/TALK"  , "narrator": "神楽", "text": "なによりも特別な存在"},
        { "location": "2678/TALK"  , "narrator": "神楽", "text": "だから、私はこの世界に来たんです"},
        { "location": "2679/TALK"  , "narrator": "神楽", "text": "その事実があるんだから"},
        { "location": "2680/TALK"  , "narrator": "神楽", "text": "完全に信じられないのは当然です"},
        { "location": "2681/ACT"   , "narrator": "", "text": "自分勝手すぎるよ"},
        { "location": "2682/TALK"  , "narrator": "神楽", "text": "そうかもしれないけど"},
        { "location": "2683/TALK"  , "narrator": "神楽", "text": "今まで自分と仲のよかったお友達が"},
        { "location": "2684/TALK"  , "narrator": "神楽", "text": "ある日突然、自分の違う一面の自分と仲良くなり"},
        { "location": "2685/TALK"  , "narrator": "神楽", "text": "そっちとばかり一緒にいることを願うようになったとしたら？"},
        { "location": "2686/TALK"  , "narrator": "神楽", "text": "それはもう、私"},
        { "location": "2687/TALK"  , "narrator": "神楽", "text": "卯月神楽のお友達ではなくなってしまうのと同じです"},
        { "location": "2688/TALK"  , "narrator": "神楽", "text": "それを不安に思わないことこそ"},
        { "location": "2689/TALK"  , "narrator": "神楽", "text": "つばめさんを大切にしていない証拠じゃないんですか？"},
        { "location": "2690/TALK"  , "narrator": "神楽", "text": "私は"},
        { "location": "2691/TALK"  , "narrator": "神楽", "text": "大切だからこそ不安なんです"},
        { "location": "2692/TALK"  , "narrator": "神楽", "text": "大切な人を"},
        { "location": "2693/TALK"  , "narrator": "神楽", "text": "母と音羽を失ってるから"},
        { "location": "2694/TALK"  , "narrator": "神楽", "text": "楽観はできません"},
        { "location": "2696/TALK"  , "narrator": "神楽", "text": "本当は信じたい"},
        { "location": "2697/TALK"  , "narrator": "神楽", "text": "けど、フレイメノウじゃなくて"},
        { "location": "2698/TALK"  , "narrator": "神楽", "text": "１００％、卯月神楽のことを想ってくれている"},
        { "location": "2699/TALK"  , "narrator": "神楽", "text": "それを知ることができなければ、私は"},
        { "location": "2702/SEL"   , "narrator": "", "text": "メノウを辞める、とか"},
        { "location": "2703/SEL"   , "narrator": "", "text": "任務のことを話そう"},
        { "location": "2704/ACT"   , "narrator": "", "text": "メノウを辞める、とか"},
        { "location": "2706/TALK"  , "narrator": "神楽", "text": "ダメですよ"},
        { "location": "2707/TALK"  , "narrator": "神楽", "text": "メノウを辞めても、メノウであった事実は変えられないし"},
        { "location": "2708/TALK"  , "narrator": "神楽", "text": "それに"},
        { "location": "2709/TALK"  , "narrator": "神楽", "text": "辞める気ないから"},
        { "location": "2710/TALK"  , "narrator": "神楽", "text": "創作は私にとって命と同じ、それに"},
        { "location": "2711/TALK"  , "narrator": "神楽", "text": "親友の"},
        { "location": "2712/TALK"  , "narrator": "神楽", "text": "音羽への裏切りにもなるから"},
        { "location": "2713/TALK"  , "narrator": "神楽", "text": "絶対にできません"},
        { "location": "2714/ACT"   , "narrator": "", "text": "任務のことを話そう"},
        { "location": "2718/SEL"   , "narrator": "", "text": "じゃあ、任務のことを話そう"},
        { "location": "2719/ACT"   , "narrator": "", "text": "じゃあ、任務のことを話そう"},
        { "location": "2723/TALK"  , "narrator": "神楽", "text": "その方法は"},
        { "location": "2726/TALK"  , "narrator": "神楽", "text": "ダメです"},
        { "location": "2727/TALK"  , "narrator": "神楽", "text": "もし話したところで"},
        { "location": "2728/TALK"  , "narrator": "神楽", "text": "一緒にいい解決方法探そうよ、メノウちゃんのためなら頑張るよ"},
        { "location": "2729/TALK"  , "narrator": "神楽", "text": "なんて言われたら？"},
        { "location": "2730/TALK"  , "narrator": "神楽", "text": "つばめさんの助けにはなりますよね"},
        { "location": "2731/TALK"  , "narrator": "神楽", "text": "自分が狙われているって"},
        { "location": "2732/TALK"  , "narrator": "神楽", "text": "知ることができるから"},
        { "location": "2733/TALK"  , "narrator": "神楽", "text": "でもそれじゃ"},
        { "location": "2734/TALK"  , "narrator": "神楽", "text": "私の助けには全然ならないじゃないですか"},
        { "location": "2735/TALK"  , "narrator": "神楽", "text": "つばめさんが心配なのはわかるけど"},
        { "location": "2736/TALK"  , "narrator": "神楽", "text": "私のことも、少しは考えて！"},
        { "location": "2738/SEL"   , "narrator": "", "text": "なにもする気ないでしょ？"},
        { "location": "2739/ACT"   , "narrator": "", "text": "なにもする気ないでしょ？"},
        { "location": "2742/TALK"  , "narrator": "神楽", "text": "なんですかそれ？"},
        { "location": "2744/TALK"  , "narrator": "神楽", "text": "なにもする気がないなら"},
        { "location": "2745/TALK"  , "narrator": "神楽", "text": "こんなに苦しんで"},
        { "location": "2746/TALK"  , "narrator": "神楽", "text": "悩んでる私はなんなの？"},
        { "location": "2747/TALK"  , "narrator": "神楽", "text": "それを言うなら"},
        { "location": "2748/TALK"  , "narrator": "神楽", "text": "なにもいい案を出さないで好き放題言ってるおまえはなんなの？"},
        { "location": "2749/TALK"  , "narrator": "神楽", "text": "本当に困ってるときに助けてもくれない役立たずよ！！"},
        { "location": "2751/SEL"   , "narrator": "", "text": "助けたいんだよ！！だから$me$も色々考えてるけど！"},
        { "location": "2752/SEL"   , "narrator": "", "text": "ごめんね、でも本当に神楽のこと大事だし心配だから"},
        { "location": "2753/ACT"   , "narrator": "", "text": "助けたいんだよ！！だから$me$も色々考えてるけど！"},
        { "location": "2754/TALK"  , "narrator": "神楽", "text": "逆ギレするな"},
        { "location": "2755/TALK"  , "narrator": "神楽", "text": "もういいです"},
        { "location": "2756/ACT"   , "narrator": "", "text": "ごめんね、でも本当に神楽のこと大事だし心配だから"},
        { "location": "2759/TALK"  , "narrator": "神楽", "text": "私こそごめんなさい"},
        { "location": "2760/TALK"  , "narrator": "神楽", "text": "ちょっと期待しすぎでした"},
        { "location": "2761/TALK"  , "narrator": "神楽", "text": "でも私だって$handle$さんのこと"},
        { "location": "2774/TALK"  , "narrator": "神楽", "text": "こんなに辛くて、\n苦しくて、押しつぶされて\nしまいそうなのに…。"},
        { "location": "2822/TALK"  , "narrator": "ぴょんこ", "text": "　"},
        { "location": "2847/TALK"  , "narrator": "みやび", "text": "相棒。"},
        { "location": "2848/SEL"   , "narrator": "", "text": "ぴょんこは見つかった！？"},
        { "location": "2849/ACT"   , "narrator": "", "text": "ぴょんこは見つかった！？"},
        { "location": "2851/TALK"  , "narrator": "みやび", "text": "いや、わからん"},
        { "location": "2852/TALK"  , "narrator": "みやび", "text": "完全に検索範囲から消えている"},
        { "location": "2853/TALK"  , "narrator": "みやび", "text": "ちゅうわけで"},
        { "location": "2854/TALK"  , "narrator": "みやび", "text": "うちも引き続き卯月のサポートをするき、お前さんも早く改ざん部分を見つけ出せ"},
        { "location": "2855/TALK"  , "narrator": "みやび", "text": "全てはそれからだ"},
        { "location": "2856/SEL"   , "narrator": "", "text": "わかった"},
        { "location": "2857/SEL"   , "narrator": "", "text": "みやび"},
        { "location": "2858/ACT"   , "narrator": "", "text": "わかった"},
        { "location": "2859/ACT"   , "narrator": "", "text": "みやび"},
        { "location": "2860/TALK"  , "narrator": "みやび", "text": "む"},
        { "location": "2861/SEL"   , "narrator": "", "text": "神楽の為に色々してくれてありがとう"},
        { "location": "2862/SEL"   , "narrator": "", "text": "$me$の為に色々してくれてありがとう"},
        { "location": "2863/ACT"   , "narrator": "", "text": "神楽の為に色々してくれてありがとう"},
        { "location": "2864/TALK"  , "narrator": "みやび", "text": "これぞ腐れ縁"},
        { "location": "2865/TALK"  , "narrator": "みやび", "text": "まあ、いろいろとシンパシーを感じたりもするのですよ、お年頃の娘故に"},
        { "location": "2866/TALK"  , "narrator": "みやび", "text": "うちはまだ８８歳やきね"},
        { "location": "2867/TALK"  , "narrator": "みやび", "text": "人には誰しも事情がある。それが他人から絶対理解されなくとも、本人にとってはその人生の全てやき"},
        { "location": "2868/TALK"  , "narrator": "みやび", "text": "そんなとき、どうしてやればいいか"},
        { "location": "2869/TALK"  , "narrator": "みやび", "text": "わかる範疇で、手助けしちゃる。重くも無く、軽くも無い"},
        { "location": "2870/TALK"  , "narrator": "みやび", "text": "相手も気が楽"},
        { "location": "2871/TALK"  , "narrator": "みやび", "text": "それだけのことぞね"},
        { "location": "2872/ACT"   , "narrator": "", "text": "$me$の為に色々してくれてありがとう"},
        { "location": "2873/TALK"  , "narrator": "みやび", "text": "問題です"},
        { "location": "2874/TALK"  , "narrator": "みやび", "text": "$handle$とうちはなんぞね"},
        { "location": "2875/SEL"   , "narrator": "", "text": "相棒"},
        { "location": "2876/SEL"   , "narrator": "", "text": "最愛棒"},
        { "location": "2877/ACT"   , "narrator": "", "text": "相棒"},
        { "location": "2878/TALK"  , "narrator": "みやび", "text": "その通り"},
        { "location": "2879/ACT"   , "narrator": "", "text": "最愛棒"},
        { "location": "2880/TALK"  , "narrator": "みやび", "text": "照れる"},
        { "location": "2882/TALK"  , "narrator": "みやび", "text": "そうなれば、互いが互いのために尽力を尽くすのは息を吸うのと何がちがうのか"},
        { "location": "2885/TALK"  , "narrator": "みやび", "text": "健闘を祈る"},
        { "location": "2897/TALK"  , "narrator": "拘束されし者", "text": "ようこそ、\n記憶の空間へ。"},
        { "location": "2898/TALK"  , "narrator": "拘束されし者", "text": "今回も前回に引き続き、\n卯月神楽の記憶を辿り、\n整合性を確認していく。"},
        { "location": "2899/TALK"  , "narrator": "拘束されし者", "text": "共有する記憶に\n違和感を感じたら、\nそれを申告するように。"},
        { "location": "2900/TALK"  , "narrator": "拘束されし者", "text": "今回共有する記憶は、\nFreyMENOWとしての\n彼女の思い出になる。"},
        { "location": "2901/TALK"  , "narrator": "拘束されし者", "text": "そしてそれは、\n彼女自身の小中学生時代の\n記憶でもある。"},
        { "location": "2902/TALK"  , "narrator": "拘束されし者", "text": "さあ、時間も残り僅かだ。\n前置きも何も無いが、\n早速記憶にダイブしよう。"},
        { "location": "2903/TALK"  , "narrator": "拘束されし者", "text": "今回も\n$handle$に\n素敵な記憶の旅を――"},
        { "location": "2916/TALK"  , "narrator": "拘束されし者", "text": "FreyMENOWは、日本の\nアーティスト、作詞家、\nストーリーテラー。"},
        { "location": "2917/TALK"  , "narrator": "拘束されし者", "text": "デビューのきっかけは、\n歌手としてではなく、\n子役として。"},
        { "location": "2918/TALK"  , "narrator": "拘束されし者", "text": "卯月神楽は小学校の頃から\n演劇が大好きだった。"},
        { "location": "2922/TALK"  , "narrator": "拘束されし者", "text": "高学年になって、\n豊洲に越してきてからも\nそれは変わらず。"},
        { "location": "2923/TALK"  , "narrator": "拘束されし者", "text": "転校先の区立小学校で\n出逢った、演劇好きの\n如月音羽と親友になる。"},
        { "location": "2924/TALK"  , "narrator": "拘束されし者", "text": "その後、神楽は両親の教育\n方針もあり、ミッション系\nの私立女子中へ進学。"},
        { "location": "2925/TALK"  , "narrator": "拘束されし者", "text": "如月音羽もまた、\n同じ中学へと進学し、\n二人は絆を深めていった。"},
        { "location": "2926/TALK"  , "narrator": "拘束されし者", "text": "中学に進学してからも、\nお互い演劇部に入り、\n日々部活動にいそしむ。"},
        { "location": "2927/TALK"  , "narrator": "拘束されし者", "text": "そして、すぐに運命の\nオーディションが\n訪れることになる。"},
        { "location": "2931/TALK"  , "narrator": "拘束されし者", "text": "このオーディションで\n神楽は子役として合格し、\n音羽は落選した。"},
        { "location": "2932/TALK"  , "narrator": "拘束されし者", "text": "子役ではあるが、歌唱が\n重要な要素となっている\n役割だったため――"},
        { "location": "2933/TALK"  , "narrator": "拘束されし者", "text": "彼女の持ち前の歌唱力が\n強力な武器となった。"},
        { "location": "2934/TALK"  , "narrator": "拘束されし者", "text": "そしてこの頃から、\n音羽との関係には少し\n変化が出てくる。"},
        { "location": "2935/TALK"  , "narrator": "拘束されし者", "text": "物理的に時間がなくなり\n一緒に遊ぶ機会が減った\nということも確かにある。"},
        { "location": "2936/TALK"  , "narrator": "拘束されし者", "text": "けれどもやはり、自分が\n落選し、神楽が採用された\nことは大きかったようだ。"},
        { "location": "2937/TALK"  , "narrator": "拘束されし者", "text": "表面上は否定しつつも、\nやはりそういうドロッと\nしたものは出てしまう。"},
        { "location": "2938/TALK"  , "narrator": "拘束されし者", "text": "二人は徐々に\n話す機会も減り、\n疎遠になっていった。"},
        { "location": "2942/TALK"  , "narrator": "拘束されし者", "text": "神楽はといえば、\nドラマ収録後に\nスカウトがあり――"},
        { "location": "2943/TALK"  , "narrator": "拘束されし者", "text": "ここから本格的に、\nFreyMENOWとしての\n活動が始まることになる。"},
        { "location": "2944/TALK"  , "narrator": "拘束されし者", "text": "スカウトを受けた事務所は\nサンセットミュージック。\n小規模な芸能事務所だ。"},
        { "location": "2945/TALK"  , "narrator": "拘束されし者", "text": "それもあって、大々的な\n活動ができたわけでは\nなかったが――"},
        { "location": "2946/TALK"  , "narrator": "拘束されし者", "text": "その分、かなりの部分で\n自由にやらせてもらう\nことができた。"},
        { "location": "2947/TALK"  , "narrator": "拘束されし者", "text": "そしてFreyMENOWは、\n着実に、コアなファンを\n増やしていくことになる。"},
        { "location": "2951/TALK"  , "narrator": "拘束されし者", "text": "一方で、プライベートに\nついてはなかなかの\n修羅場続きだ。"},
        { "location": "2952/TALK"  , "narrator": "拘束されし者", "text": "音羽とは\n疎遠になって\n遊ぶこともなくなり。"},
        { "location": "2953/TALK"  , "narrator": "拘束されし者", "text": "寄ってくる友達は\n芸能人としての\n魅力に取り憑かれている。"},
        { "location": "2954/TALK"  , "narrator": "拘束されし者", "text": "無駄にお嬢様学校という\nこともあり、下町育ちの\n神楽には肌に合わず――"},
        { "location": "2955/TALK"  , "narrator": "拘束されし者", "text": "しかし大企業社長令嬢と\nいう格もあるため、周囲は\n距離感がつかめない。"},
        { "location": "2956/TALK"  , "narrator": "拘束されし者", "text": "よって、卯月神楽は\n割と浮いた存在だった。"},
        { "location": "2957/TALK"  , "narrator": "拘束されし者", "text": "それもあって、\nガブリエラの境遇を理解\nできるのかもしれない。"},
        { "location": "2961/TALK"  , "narrator": "拘束されし者", "text": "家庭では、父親が\n頑なに芸能デビューを\n反対し続けていた。"},
        { "location": "2962/TALK"  , "narrator": "拘束されし者", "text": "父親本人には自覚がなく\nとも、周囲が自粛する\n行動をとるため――"},
        { "location": "2963/TALK"  , "narrator": "拘束されし者", "text": "スポンサー番組などから\n見送りをされたりする事も\n何度かあった。"},
        { "location": "2964/TALK"  , "narrator": "拘束されし者", "text": "それでいて、周囲からは\n大企業の社長を父に持つ\nという偏見もあった。"},
        { "location": "2965/TALK"  , "narrator": "拘束されし者", "text": "その為、何か大きな事を\n為し得れば、それはコネ\nだろうと揶揄された。"},
        { "location": "2969/TALK"  , "narrator": "拘束されし者", "text": "しかし、そんな中でも\n彼女は精力的に\n活動を続けていた。"},
        { "location": "2970/TALK"  , "narrator": "拘束されし者", "text": "沢山のファンと共に、\n自分の世界を描き続ける。"},
        { "location": "2971/TALK"  , "narrator": "拘束されし者", "text": "それこそが、彼女に\nとっては何物にも代え難い\n幸せだったからだ。"},
        { "location": "2972/TALK"  , "narrator": "拘束されし者", "text": "卯月神楽は少なくとも、\nサンセットミュージックの\n時代においては――"},
        { "location": "2973/TALK"  , "narrator": "拘束されし者", "text": "自身の創作だけを信じて、\n突き進んできたのだ。"},
        { "location": "2981/TALK"  , "narrator": "拘束されし者", "text": "ライブラリ\nEOF/."},
        { "location": "2982/TALK"  , "narrator": "拘束されし者", "text": "今回の検索範囲における\n全文リードを終了した。"},
        { "location": "2983/TALK"  , "narrator": "拘束されし者", "text": "今回何か、\n違和感を感じたところは？"},
        { "location": "2984/SEL"   , "narrator": "", "text": "無いと思う"},
        { "location": "2985/SEL"   , "narrator": "", "text": "ぴょんこは無事なの？"},
        { "location": "2986/ACT"   , "narrator": "", "text": "無いと思う"},
        { "location": "2987/TALK"  , "narrator": "拘束されし者", "text": "わかった。"},
        { "location": "2988/ACT"   , "narrator": "", "text": "ぴょんこは無事なの？"},
        { "location": "2989/TALK"  , "narrator": "拘束されし者", "text": "それは記憶を辿る事とは\n無関係の話であろう。"},
        { "location": "2990/TALK"  , "narrator": "拘束されし者", "text": "その答えは、\n私が回答するまでもない。"},
        { "location": "2992/TALK"  , "narrator": "拘束されし者", "text": "次回は更に、\n先へと進めていく。"},
        { "location": "3007/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん♪"},
        { "location": "3008/SEL"   , "narrator": "", "text": "ぴょんこおおおおおおお！！"},
        { "location": "3009/SEL"   , "narrator": "", "text": "無事だったのか"},
        { "location": "3010/SEL"   , "narrator": "", "text": "トイレ？"},
        { "location": "3011/SEL"   , "narrator": "", "text": "ぴょんこｽｷ"},
        { "location": "3012/ACT"   , "narrator": "", "text": "ぴょんこおおおおおおお！！"},
        { "location": "3013/TALK"  , "narrator": "ぴょんこ", "text": "ど、どうしたんですかっ！\nそんなに\n感極まっちゃってっ！！"},
        { "location": "3014/ACT"   , "narrator": "", "text": "無事だったのか"},
        { "location": "3015/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん？"},
        { "location": "3016/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこは元々\n無事ですぴょん。"},
        { "location": "3017/ACT"   , "narrator": "", "text": "トイレ？"},
        { "location": "3018/TALK"  , "narrator": "ぴょんこ", "text": "お花摘みって言わないと、\n学校では先輩から\nネチネチ教育されますよ？"},
        { "location": "3019/ACT"   , "narrator": "", "text": "ぴょんこｽｷ"},
        { "location": "3022/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんぴょんぴょん♪"},
        { "location": "3025/SEL"   , "narrator": "", "text": "もう二度と戻ってこないかと"},
        { "location": "3026/ACT"   , "narrator": "", "text": "もう二度と戻ってこないかと"},
        { "location": "3028/TALK"  , "narrator": "ぴょんこ", "text": "もー。\nちょっと留守にしただけで\n大げさですぴょん。"},
        { "location": "3029/SEL"   , "narrator": "", "text": "みやびから聞いたよ"},
        { "location": "3030/ACT"   , "narrator": "", "text": "みやびから聞いたよ"},
        { "location": "3032/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん。"},
        { "location": "3033/SEL"   , "narrator": "", "text": "もしかして、わかってたの？"},
        { "location": "3034/ACT"   , "narrator": "", "text": "もしかして、わかってたの？"},
        { "location": "3036/TALK"  , "narrator": "ぴょんこ", "text": "そりゃ、ね。\n自分の事ですから。"},
        { "location": "3037/TALK"  , "narrator": "ぴょんこ", "text": "というわけで！"},
        { "location": "3038/TALK"  , "narrator": "ぴょんこ", "text": "せっかく戻って来れた\nわけですし、この隙に\nキスチケジャンケンをっ♪"},
        { "location": "3039/SEL"   , "narrator": "", "text": "そんな事やってる場合じゃないでしょ"},
        { "location": "3040/ACT"   , "narrator": "", "text": "そんな事やってる場合じゃないでしょ"},
        { "location": "3042/TALK"  , "narrator": "ぴょんこ", "text": "……。"},
        { "location": "3043/TALK"  , "narrator": "ぴょんこ", "text": "いいえ。\nやってる場合ですぴょん。"},
        { "location": "3044/TALK"  , "narrator": "ぴょんこ", "text": "ねえ、\n$handle$さん。"},
        { "location": "3046/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこは\n$handle$さんの\nことが大好きです。"},
        { "location": "3047/TALK"  , "narrator": "ぴょんこ", "text": "でも、いずれ必ず\n別れの時が来ます。"},
        { "location": "3049/TALK"  , "narrator": "ぴょんこ", "text": "ハッピーエンドでも、\nバッドエンドでも――"},
        { "location": "3050/TALK"  , "narrator": "ぴょんこ", "text": "どちらにしても、\n今の状態を維持することは\nできません。"},
        { "location": "3051/TALK"  , "narrator": "ぴょんこ", "text": "ハイブリッド人格の\nぴょんこは、\n生きられないんですよ。"},
        { "location": "3052/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこが生きてる限り、\n現実の私は心の底から\n笑うことができない。"},
        { "location": "3053/TALK"  , "narrator": "ぴょんこ", "text": "みさみさがあのままでは、\n無理なのわかりますよね？"},
        { "location": "3054/TALK"  , "narrator": "ぴょんこ", "text": "ですから、どっちみち\n近いうちにお別れなのは\n間違いなかったんです。"},
        { "location": "3055/TALK"  , "narrator": "ぴょんこ", "text": "ただそれが、\n予想より遙かに\n早かっただけで。"},
        { "location": "3056/SEL"   , "narrator": "", "text": "ぴょんこ別れたくないよ！！行かないでよ！"},
        { "location": "3057/SEL"   , "narrator": "", "text": "覚悟はしてた"},
        { "location": "3058/SEL"   , "narrator": "", "text": "まだ消えると決まったわけじゃない"},
        { "location": "3059/ACT"   , "narrator": "", "text": "ぴょんこ別れたくないよ！！行かないでよ！"},
        { "location": "3061/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこに言われても\n困るぴょん。"},
        { "location": "3062/ACT"   , "narrator": "", "text": "覚悟はしてた"},
        { "location": "3063/TALK"  , "narrator": "ぴょんこ", "text": "おっとな～～♪"},
        { "location": "3064/ACT"   , "narrator": "", "text": "まだ消えると決まったわけじゃない"},
        { "location": "3065/TALK"  , "narrator": "ぴょんこ", "text": "確かにそうですよね♪\nとはいえ既に足下が\n消えかかってますけどね。"},
        { "location": "3067/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さん。"},
        { "location": "3068/TALK"  , "narrator": "ぴょんこ", "text": "『今を生きる』って\n言葉、知ってますか？"},
        { "location": "3069/SEL"   , "narrator": "", "text": "知ってる"},
        { "location": "3070/SEL"   , "narrator": "", "text": "教えて"},
        { "location": "3071/ACT"   , "narrator": "", "text": "知ってる"},
        { "location": "3072/ACT"   , "narrator": "", "text": "教えて"},
        { "location": "3073/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん♪"},
        { "location": "3074/TALK"  , "narrator": "ぴょんこ", "text": "もしも\n$handle$さんが\n明日死ぬとわかってたら―"},
        { "location": "3075/TALK"  , "narrator": "ぴょんこ", "text": "今から何をしますか？"},
        { "location": "3076/TALK"  , "narrator": "ぴょんこ", "text": "まあ、喰って寝て\n好きなコトやって有り金\n全部使い切るとか――"},
        { "location": "3077/TALK"  , "narrator": "ぴょんこ", "text": "そういうクソみたいな事\nしか思いつかない\nようであれば……。"},
        { "location": "3078/TALK"  , "narrator": "ぴょんこ", "text": "それはまだ、死に対して\n本気で考えてないのだと\n思います。"},
        { "location": "3079/TALK"  , "narrator": "ぴょんこ", "text": "明日死ぬとわかってたら、\n今この瞬間に死が訪れても\n決して後悔しないよう――"},
        { "location": "3080/TALK"  , "narrator": "ぴょんこ", "text": "毎日を全力で生きる。\nそうなると思うんです。"},
        { "location": "3081/TALK"  , "narrator": "ぴょんこ", "text": "それが、\n『今を生きる』って\nことなんです。"},
        { "location": "3083/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこはずっと、\nそれを実践してきました。"},
        { "location": "3085/TALK"  , "narrator": "ぴょんこ", "text": "毎回、\n$handle$さんに\nスキだと告げて。"},
        { "location": "3087/TALK"  , "narrator": "ぴょんこ", "text": "それが波風立つことでも、\nあとで後悔しない選択を\nして。"},
        { "location": "3088/TALK"  , "narrator": "ぴょんこ", "text": "助けてくれる皆さんには\n都度、感謝の気持ちを\n伝えてきて。"},
        { "location": "3089/TALK"  , "narrator": "ぴょんこ", "text": "毎回、やりきったなーと\n思えることを目標にして\n生きてきました。"},
        { "location": "3090/TALK"  , "narrator": "ぴょんこ", "text": "だからぴょんこは、今\n$handle$さんと\nお別れでも――"},
        { "location": "3091/TALK"  , "narrator": "ぴょんこ", "text": "お別れでも。"},
        { "location": "3092/TALK"  , "narrator": "ぴょんこ", "text": "寂しいですけど、でも\n後悔は無いんです♪"},
        { "location": "3093/TALK"  , "narrator": "ぴょんこ", "text": "だから、\nこんな状況でも、懲りずに\n言い続けるんです。"},
        { "location": "3094/TALK"  , "narrator": "ぴょんこ", "text": "キスチケジャンケンを\nやりましょう♪…って！"},
        { "location": "3095/TALK"  , "narrator": "ぴょんこ", "text": "ひとつでも多く、\n$handle$さんとの\n思い出を作りたくて。"},
        { "location": "3096/TALK"  , "narrator": "ぴょんこ", "text": "ですから、\nやってくれませんか？"},
        { "location": "3097/TALK"  , "narrator": "ぴょんこ", "text": "今回で最後に\nなるかもしれませんし。"},
        { "location": "3099/SEL"   , "narrator": "", "text": "もちろんやるよ！"},
        { "location": "3100/SEL"   , "narrator": "", "text": "$me$には大切な人がいるから、できません"},
        { "location": "3101/ACT"   , "narrator": "", "text": "もちろんやるよ！"},
        { "location": "3102/TALK"  , "narrator": "ぴょんこ", "text": "ありがとうございますっ！"},
        { "location": "3108/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんは、\n今キスチケを\n１枚も持っていませんね。"},
        { "location": "3111/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんは、\n今キスチケを\n$pyonko_kissticket$枚持ってますね。"},
        { "location": "3115/TALK"  , "narrator": "ぴょんこ", "text": "今、$handle$さんは\n$pyonko_kissticket$枚のキスチケを\n持っていますね♪"},
        { "location": "3117/TALK"  , "narrator": "ぴょんこ", "text": "3枚以上持っている間は\n何度でも特別なキッスが\n出来ちゃいますよっ！"},
        { "location": "3118/TALK"  , "narrator": "ぴょんこ", "text": "今回もどうですかっ！"},
        { "location": "3120/TALK"  , "narrator": "ぴょんこ", "text": "というわけで！\nおめでとうございます！"},
        { "location": "3121/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんは、\nキスチケを3枚以上\n獲得してますので！"},
        { "location": "3122/TALK"  , "narrator": "ぴょんこ", "text": "今から特別なキッスを\n進呈しちゃいまーす♪"},
        { "location": "3125/SEL"   , "narrator": "", "text": "やったー！"},
        { "location": "3126/SEL"   , "narrator": "", "text": "今！？"},
        { "location": "3127/SEL"   , "narrator": "", "text": "今はそういう気分じゃないから、また今度で"},
        { "location": "3128/ACT"   , "narrator": "", "text": "やったー！"},
        { "location": "3129/ACT"   , "narrator": "", "text": "今！？"},
        { "location": "3130/TALK"  , "narrator": "ぴょんこ", "text": "今じゃなきゃ\nいつやるんですかっ！？"},
        { "location": "3131/TALK"  , "narrator": "ぴょんこ", "text": "今でしょ！"},
        { "location": "3132/SEL"   , "narrator": "", "text": "古くない？"},
        { "location": "3133/ACT"   , "narrator": "", "text": "古くない？"},
        { "location": "3135/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん？"},
        { "location": "3136/ACT"   , "narrator": "", "text": "今はそういう気分じゃないから、また今度で"},
        { "location": "3137/TALK"  , "narrator": "ぴょんこ", "text": "わかったぴょん。"},
        { "location": "3138/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこはいつでも\nオッケーですから、\n気が向いた時にどうぞ♪"},
        { "location": "3142/TALK"  , "narrator": "ぴょんこ", "text": "というわけで今回は、\n$handle$さんの\n好きな服で好きな所に！"},
        { "location": "3143/TALK"  , "narrator": "ぴょんこ", "text": "これからぴょんこは、\n今、現実の私が着てる服に\n着替えてきます♪"},
        { "location": "3144/TALK"  , "narrator": "ぴょんこ", "text": "いっぱい\n楽しんじゃって\nくださいねっ！"},
        { "location": "3154/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん♪"},
        { "location": "3155/TALK"  , "narrator": "ぴょんこ", "text": "どうですかっ？\nそれでは――"},
        { "location": "3157/SEL"   , "narrator": "", "text": "頬、唇"},
        { "location": "3158/SEL"   , "narrator": "", "text": "胸"},
        { "location": "3159/SEL"   , "narrator": "", "text": "おなか"},
        { "location": "3160/ACT"   , "narrator": "", "text": "頬、唇"},
        { "location": "3164/ACT"   , "narrator": "", "text": "胸"},
        { "location": "3169/ACT"   , "narrator": "", "text": "おなか"},
        { "location": "3191/TALK"  , "narrator": "ぴょんこ", "text": "ふわあっ！"},
        { "location": "3194/TALK"  , "narrator": "ぴょんこ", "text": "ふわあっ！"},
        { "location": "3197/TALK"  , "narrator": "ぴょんこ", "text": "ふわあっ！"},
        { "location": "3200/TALK"  , "narrator": "ぴょんこ", "text": "ふわあっ！"},
        { "location": "3203/TALK"  , "narrator": "ぴょんこ", "text": "ふわあっ！"},
        { "location": "3206/TALK"  , "narrator": "ぴょんこ", "text": "ふわあっ！"},
        { "location": "3215/TALK"  , "narrator": "ぴょんこ", "text": "まさに\nメルティキッス♪"},
        { "location": "3217/TALK"  , "narrator": "ぴょんこ", "text": "温かくて\n柔らかい…。"},
        { "location": "3219/TALK"  , "narrator": "ぴょんこ", "text": "もっともっとー♪"},
        { "location": "3223/TALK"  , "narrator": "ぴょんこ", "text": "な、なんだか\n思ったよりも全然\nドキドキしますねっ！"},
        { "location": "3225/TALK"  , "narrator": "ぴょんこ", "text": "不思議と\n嫌じゃないぴょん♪"},
        { "location": "3227/TALK"  , "narrator": "ぴょんこ", "text": "かまかま～～♪"},
        { "location": "3231/TALK"  , "narrator": "ぴょんこ", "text": "おなかって……\nキスされると\nくすぐったいんですねっ…"},
        { "location": "3233/TALK"  , "narrator": "ぴょんこ", "text": "デリケートなので\n優しくしてくださいねっ！"},
        { "location": "3235/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんぴょん♪"},
        { "location": "3238/SEL"   , "narrator": "", "text": "もう一度"},
        { "location": "3239/SEL"   , "narrator": "", "text": "もうやめる"},
        { "location": "3240/ACT"   , "narrator": "", "text": "もう一度"},
        { "location": "3242/ACT"   , "narrator": "", "text": "もうやめる"},
        { "location": "3260/TALK"  , "narrator": "ぴょんこ", "text": "はぁっ。\n想像以上に\n恥ずかしいですね……。"},
        { "location": "3261/TALK"  , "narrator": "ぴょんこ", "text": "でも、とっても\n素敵な時間でした♪"},
        { "location": "3262/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこはいつでも\nオッケーですから、\nまたしましょうね♪"},
        { "location": "3269/TALK"  , "narrator": "ぴょんこ", "text": "というわけで！\nジャンケンしましょう、\nジャンケン♪"},
        { "location": "3272/TALK"  , "narrator": "ぴょんこ", "text": "それじゃ、\nいきますよっ！"},
        { "location": "3274/TALK"  , "narrator": "ぴょんこ", "text": "と思いましたけど、\n既に事後でしたね…。"},
        { "location": "3296/TALK"  , "narrator": "ぴょんこ", "text": "ふわぁっ！\n負けちゃいました…。"},
        { "location": "3300/TALK"  , "narrator": "ぴょんこ", "text": "約束通り、\nキスチケ１枚進呈ぴょん♪"},
        { "location": "3306/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこの\n勝ちでーすっ♪"},
        { "location": "3307/TALK"  , "narrator": "ぴょんこ", "text": "約束通り、\nキスチケ１枚没収ぴょん♪"},
        { "location": "3312/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこの\n勝ちでーすっ♪"},
        { "location": "3313/TALK"  , "narrator": "ぴょんこ", "text": "というわけで、\nプレゼントはナシ！！"},
        { "location": "3319/TALK"  , "narrator": "ぴょんこ", "text": "ふぅ……\nとっても楽しかったです♪"},
        { "location": "3323/TALK"  , "narrator": "ぴょんこ", "text": "って！\nああっ！！"},
        { "location": "3324/TALK"  , "narrator": "ぴょんこ", "text": "おめでとうございます！\nキスチケ３枚以上\nゲットしちゃいましたね♪"},
        { "location": "3325/TALK"  , "narrator": "ぴょんこ", "text": "というわけで！\n早速今から特別なキッスを\n進呈しちゃいまーす♪"},
        { "location": "3333/TALK"  , "narrator": "ぴょんこ", "text": "キスチケ３枚ためて、\n特別なキッスも\nしちゃいましたし。"},
        { "location": "3334/TALK"  , "narrator": "ぴょんこ", "text": "ほんと、ぴょんこは\nもうこれで悔いは……"},
        { "location": "3336/TALK"  , "narrator": "ぴょんこ", "text": "でも、結局特別なキッスは\nできませんでしたね。"},
        { "location": "3338/TALK"  , "narrator": "ぴょんこ", "text": "……。"},
        { "location": "3340/TALK"  , "narrator": "ぴょんこ", "text": "普通のでよければ。"},
        { "location": "3341/TALK"  , "narrator": "ぴょんこ", "text": "キス、\nしてくれませんか？"},
        { "location": "3361/TALK"  , "narrator": "ぴょんこ", "text": "ふわあっ！"},
        { "location": "3365/TALK"  , "narrator": "ぴょんこ", "text": "ふわあっ！"},
        { "location": "3371/TALK"  , "narrator": "ぴょんこ", "text": "とろけるようなキスって\nまさにこのことですねっ♪"},
        { "location": "3372/TALK"  , "narrator": "ぴょんこ", "text": "ありがとうございます。\n最後に\nいい思い出が……"},
        { "location": "3374/ACT"   , "narrator": "", "text": "$me$には大切な人がいるから、できません"},
        { "location": "3375/TALK"  , "narrator": "ぴょんこ", "text": "わかりました♪\n正直に言ってくれて\nありがとうございますっ！"},
        { "location": "3377/TALK"  , "narrator": "ぴょんこ", "text": "なんて言ってるけど、\nどういうわけか、\n何度かやってんだよなー。"},
        { "location": "3379/TALK"  , "narrator": "ぴょんこ", "text": "それじゃ、最後にひとつ、\nぴょんこの我が侭\n聞いて下さい。"},
        { "location": "3381/TALK"  , "narrator": "ぴょんこ", "text": "あたま、ナデナデして\nいただけませんか？"},
        { "location": "3382/TALK"  , "narrator": "ぴょんこ", "text": "それくらいなら、\n彼女さんに怒られたり\nしないと思いますし。"},
        { "location": "3401/TALK"  , "narrator": "ぴょんこ", "text": "ふわあっ！"},
        { "location": "3405/TALK"  , "narrator": "ぴょんこ", "text": "ふわあっ！"},
        { "location": "3411/TALK"  , "narrator": "ぴょんこ", "text": "なんだかすごく\n温かい気持ちに\nなりますね♪"},
        { "location": "3412/TALK"  , "narrator": "ぴょんこ", "text": "ありがとうございます。\n最後に\nいい思い出が……"},
        { "location": "3415/TALK"  , "narrator": "ぴょんこ", "text": "……。"},
        { "location": "3416/SEL"   , "narrator": "", "text": "ぴょんこ…？"},
        { "location": "3417/ACT"   , "narrator": "", "text": "ぴょんこ…？"},
        { "location": "3419/TALK"  , "narrator": "ぴょんこ", "text": "……ないで……"},
        { "location": "3420/SEL"   , "narrator": "", "text": "ぴょんこ！？"},
        { "location": "3421/ACT"   , "narrator": "", "text": "ぴょんこ！？"},
        { "location": "3423/TALK"  , "narrator": "ぴょんこ", "text": "消えないで……"},
        { "location": "3424/TALK"  , "narrator": "ぴょんこ", "text": "消えちゃやだよ…\nこの思い出……っ"},
        { "location": "3425/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんとの\n思い出が消えちゃうなんて\nいやだぁぁぁぁっ！！"},
        { "location": "3426/TALK"  , "narrator": "ぴょんこ", "text": "いやだああああっっ！！！"},
        { "location": "3427/SEL"   , "narrator": "", "text": "ぴょんこ！！"},
        { "location": "3428/ACT"   , "narrator": "", "text": "ぴょんこ！！"},
        { "location": "2573/DIALOG", "narrator": "Dialog_EventData", "text": "<color=green>8月1日　5:34 PM</color>\n神楽の自室にて"},
        { "location": "2787/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "2789/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "2791/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "2793/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "2795/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "2844/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Information:0x03】</color>\nココロスフィアとの通信を\n復元しました。(101)"},
        { "location": "3179/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "3210/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"},
        { "location": "3278/DIALOG", "narrator": "Dialog_Notice", "text": "<color=green>【TRI-OS Plug-in:Libralian】</color>\n\n<color=red>\nOKボタンを押すと、この選択は確定します。プレイの有無にかかわらず、以後やり直しはできなくなります。\n</color>\n以降ジャンケン終了までの間、通信環境が悪い場所などでの継続はお薦めしません。\n\nここでOKを押す前にアプリを終了（タスクキル）すれば、ギリギリキャンセル可能です。"},
        { "location": "3302/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:Libralian】</color>\n\n<color=green>【キスチケ】</color>を\n１枚ゲットしました！"},
        { "location": "3309/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:Libralian】</color>\n\n<color=green>【キスチケ】</color>を\n１枚失いました…。"},
        { "location": "3348/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "3369/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"},
        { "location": "3388/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "3409/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"},
        { "location": "3435/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:librarian】</color>\n司書が存在しません。(p12)"},
        { "location": "3441/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Information:0x11】</color>\n\nKokoro-Gate\n<color=blue>[Address:2x9D6]</color>\nsave succeed !\nAnd hibernation a gate.\n\n時空間整合性維持のため、\nココロゲートを一旦停止し\n現実世界に戻ります。\n(102)\n"}
