{
    "dir": "chap12/daydra/dd_ch03_12_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "12305",
        "cid": "gabriella",
        "title": "005 メインストーリー",
        "sub_title": "口添えを頼まれて＜後編＞"
    },
    "entry":
    [
        { "location": "505/SCENARIO", "narrator": "", "text": "口添えを頼まれて"},
        { "location": "522/TALK"    , "narrator": "ガブリエラ", "text": "…やっぱり、\nこのまま\n放っておけないわ。"},
        { "location": "524/TALK"    , "narrator": "ガブリエラ", "text": "口添えを引き受けた\n以上は――"},
        { "location": "526/TALK"    , "narrator": "ガブリエラ", "text": "できる限りの\nフォローする\n責任はあるし。"},
        { "location": "529/TALK"    , "narrator": "ガブリエラ", "text": "…ねえ、まほ。\n全員雇っちゃっても\nいいんじゃない？"},
        { "location": "531/TALK"    , "narrator": "真幌", "text": "勘弁してくれ…。\nおまえまで何を\n言い出すんだ？"},
        { "location": "532/TALK"    , "narrator": "ガブリエラ", "text": "雇った方がメリット\nあるから言ってる\nのよ。"},
        { "location": "534/TALK"    , "narrator": "ガブリエラ", "text": "トライナリーの仕事\nだけじゃなくて――"},
        { "location": "535/TALK"    , "narrator": "ガブリエラ", "text": "劇場の仕事だって、\n今よりラクになると\n思うし。"},
        { "location": "537/TALK"    , "narrator": "ガブリエラ", "text": "それに、男の子達が\n入れば力仕事を\n任せられるでしょ？"},
        { "location": "539/TALK"    , "narrator": "真幌", "text": "…………。"},
        { "location": "540/TALK"    , "narrator": "キリト", "text": "ち、力仕事なら\n任せてくださいよ。\nなっ！？"},
        { "location": "541/TALK"    , "narrator": "ヒカル", "text": "え、ええ…。\n通常攻撃隊の訓練で\n鍛えられているので。"},
        { "location": "544/TALK"    , "narrator": "真幌", "text": "いや、しかし…。"},
        { "location": "545/TALK"    , "narrator": "ガブリエラ", "text": "それにね、この子達は\nあたしに口添えを\n頼んできたのよ？"},
        { "location": "546/TALK"    , "narrator": "ガブリエラ", "text": "まほに頼んだって、\n十中八九断られるって\nわかってるのに。"},
        { "location": "547/TALK"    , "narrator": "ガブリエラ", "text": "そんな行動力があるん\nだから、もし断ったり\nしても――"},
        { "location": "548/TALK"    , "narrator": "ガブリエラ", "text": "勝手に劇場の手伝いを\nし出す可能性もあると\n思うのよ。"},
        { "location": "550/TALK"    , "narrator": "ガブリエラ", "text": "そうなったら、\n余計面倒なことに\nなるんじゃない？"},
        { "location": "551/TALK"    , "narrator": "真幌", "text": "…………。"},
        { "location": "553/TALK"    , "narrator": "雛", "text": "その通りです。\nやっちゃうかも\nしれませんよ！！"},
        { "location": "554/TALK"    , "narrator": "ガブリエラ", "text": "ほらね？"},
        { "location": "557/TALK"    , "narrator": "ガブリエラ", "text": "だったらあたし達の\n手元に置いといて――"},
        { "location": "558/TALK"    , "narrator": "ガブリエラ", "text": "望み通り、ここで\nこき使ってやれば\nいいじゃない。"},
        { "location": "560/TALK"    , "narrator": "ガブリエラ", "text": "望みを叶えてやれば、\nまほの気にしてる\n情報っていうのも――"},
        { "location": "561/TALK"    , "narrator": "ガブリエラ", "text": "外に漏らしたりする\n心配はないはずよ。"},
        { "location": "563/TALK"    , "narrator": "繭", "text": "約束します。\n二度と口には\n出しません。"},
        { "location": "565/TALK"    , "narrator": "真幌", "text": "…………。"},
        { "location": "566/TALK"    , "narrator": "真幌", "text": "はぁ…確かに、\nギャヴィの言う通り\nだな。"},
        { "location": "568/TALK"    , "narrator": "雛", "text": "じゃ、じゃあ、\nいいんですか！？"},
        { "location": "569/TALK"    , "narrator": "真幌", "text": "その代わり！"},
        { "location": "571/TALK"    , "narrator": "真幌", "text": "もしもおまえ達が\n何か問題を起こした\n場合には――"},
        { "location": "573/TALK"    , "narrator": "真幌", "text": "その責任は、\nギャヴィに\n取ってもらう。"},
        { "location": "575/TALK"    , "narrator": "ヒカル", "text": "えっ！？\nガブリエラさんは\n関係ありませんよ。"},
        { "location": "577/TALK"    , "narrator": "真幌", "text": "口添えを引き受けた\n時点で大ありだ。"},
        { "location": "579/TALK"    , "narrator": "真幌", "text": "…どうする？"},
        { "location": "582/TALK"    , "narrator": "ガブリエラ", "text": "…わかったわ。\nその時は、あたしが\n責任取るわよ。"},
        { "location": "584/TALK"    , "narrator": "雛", "text": "ガブリエラちゃん！\nさすがにそれは…。"},
        { "location": "587/TALK"    , "narrator": "ガブリエラ", "text": "何よ？\n問題起こそうと\n思ってるわけ？"},
        { "location": "589/TALK"    , "narrator": "雛", "text": "そうじゃないけど…。"},
        { "location": "590/TALK"    , "narrator": "ガブリエラ", "text": "なら問題ないわ。"},
        { "location": "592/TALK"    , "narrator": "真幌", "text": "そうか…。\nでは、決まりだな。"},
        { "location": "593/TALK"    , "narrator": "真幌", "text": "おまえ達には、\n今日からこの劇場で\n働いてもらうぞ。"},
        { "location": "595/TALK"    , "narrator": "キリト", "text": "ま、マジですか！？\nマジでいいんですか？"},
        { "location": "597/TALK"    , "narrator": "真幌", "text": "ああ…許可する。"},
        { "location": "599/TALK"    , "narrator": "雛", "text": "や、やったぁー！！"},
        { "location": "601/TALK"    , "narrator": "ヒカル", "text": "まさか、許可して\n頂けるなんて…。"},
        { "location": "603/TALK"    , "narrator": "キリト", "text": "全部ガブリエラの\nおかげだな！"},
        { "location": "605/TALK"    , "narrator": "雛", "text": "ガブリエラちゃんに\n頼んでよかったー。\nありがと！"},
        { "location": "608/TALK"    , "narrator": "ガブリエラ", "text": "あ、あたしが\nラクしたかった\nだけよ。"},
        { "location": "609/TALK"    , "narrator": "ガブリエラ", "text": "人手が増えれば\nシフトの回数も\n減るだろうし…。"},
        { "location": "611/TALK"    , "narrator": "雛", "text": "それでも感謝だよ！\nガブリエラちゃん\n大好き！！"},
        { "location": "612/TALK"    , "narrator": "雛", "text": "絶対、責任取らせる\nような問題は起こさ\nないからね！"},
        { "location": "615/TALK"    , "narrator": "ガブリエラ", "text": "はいはい…。\nまあ、期待してるわ。"},
        { "location": "617/TALK"    , "narrator": "真幌", "text": "よし、男子二人は\n私に付いて来い。"},
        { "location": "618/TALK"    , "narrator": "真幌", "text": "早速力仕事を\nしてもらうぞ。"},
        { "location": "619/TALK"    , "narrator": "キリト", "text": "了解っす！"},
        { "location": "620/TALK"    , "narrator": "ヒカル", "text": "わかりました。"},
        { "location": "629/TALK"    , "narrator": "雛", "text": "まゆちん。\nあたし達も\n頑張ろうね！"},
        { "location": "630/TALK"    , "narrator": "繭", "text": "…………。"},
        { "location": "631/TALK"    , "narrator": "雛", "text": "あれ、まゆちん？"},
        { "location": "632/TALK"    , "narrator": "繭", "text": "…………。"},
        { "location": "641/TALK"    , "narrator": "雛", "text": "まゆちん！？"},
        { "location": "642/TALK"    , "narrator": "雛", "text": "…気絶してる。"},
        { "location": "643/TALK"    , "narrator": "ガブリエラ", "text": "まほの気迫を\n真正面から受けたん\nだし、当然よ。"},
        { "location": "645/TALK"    , "narrator": "ガブリエラ", "text": "じゃ、最初の仕事よ。\n楽屋に運んで寝かして\nあげなさい。"},
        { "location": "646/TALK"    , "narrator": "雛", "text": "初仕事りょーかい！\nほら、まゆちん\n行くよー。"},
        { "location": "650/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "652/TALK"    , "narrator": "ガブリエラ", "text": "はぁ…。"},
        { "location": "664/TALK"    , "narrator": "ガブリエラ", "text": "面倒なこと引き受けちゃったわ"},
        { "location": "665/TALK"    , "narrator": "ガブリエラ", "text": "口添えするだけの話のはずだったのに"},
        { "location": "666/TALK"    , "narrator": "ガブリエラ", "text": "あの子達が問題起こしたら、その責任を取らなくちゃいけないとか"},
        { "location": "667/TALK"    , "narrator": "ガブリエラ", "text": "おもいっきり貧乏くじ引いた感じだわ"},
        { "location": "669/SEL"     , "narrator": "", "text": "みんな喜んでくれたね"},
        { "location": "670/ACT"     , "narrator": "", "text": "みんな喜んでくれたね"},
        { "location": "672/TALK"    , "narrator": "ガブリエラ", "text": "望み通りの結果になったんだもの、喜んで当然よ"},
        { "location": "673/TALK"    , "narrator": "ガブリエラ", "text": "これで喜ばなかったら、私の立場もないし"},
        { "location": "674/TALK"    , "narrator": "ガブリエラ", "text": "まあ、何であれ問題だけは起こさないで欲しいわね"},
        { "location": "677/SEL"     , "narrator": "", "text": "ガブリエラ、かっこよかったよ"},
        { "location": "678/SEL"     , "narrator": "", "text": "頭が痛いね"},
        { "location": "679/ACT"     , "narrator": "", "text": "ガブリエラ、かっこよかったよ"},
        { "location": "680/TALK"    , "narrator": "ガブリエラ", "text": "なんのこと？"},
        { "location": "681/TALK"    , "narrator": "ガブリエラ", "text": "私、そんなこと言われるようなことしたかしら？"},
        { "location": "682/TALK"    , "narrator": "ガブリエラ", "text": "よくわからないけど、とりあえず、ありがと"},
        { "location": "693/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "696/TALK"    , "narrator": "ガブリエラ", "text": "ふふっ…。"},
        { "location": "697/ACT"     , "narrator": "", "text": "頭が痛いね"},
        { "location": "698/TALK"    , "narrator": "ガブリエラ", "text": "まったくその通りよね"},
        { "location": "699/TALK"    , "narrator": "ガブリエラ", "text": "本当、バカなこと引き受けちゃったわ"},
        { "location": "700/TALK"    , "narrator": "ガブリエラ", "text": "これからのバイト生活、不安でいっぱいだわ"},
        { "location": "711/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "714/TALK"    , "narrator": "ガブリエラ", "text": "でも、劇場が賑やかに\nなりそうで、ちょっと\n楽しみ…。"},
        { "location": "726/DIALOG"  , "narrator": "Dialog_chapter_ch03", "text": "【10 江戸川橋物語】"}
    ]
}
