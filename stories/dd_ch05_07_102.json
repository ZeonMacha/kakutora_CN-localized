{
    "dir": "chap07/daydra/dd_ch05_07_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "7505",
        "cid": "kagura",
        "title": "005 メインストーリー",
        "sub_title": "なれあい＜後編＞"
    },
    "entry":
    [
        { "location": "643/TALK"  , "narrator": "つばめ", "text": "…卯月さん？"},
        { "location": "645/TALK"  , "narrator": "神楽", "text": "え？\nなんですか？"},
        { "location": "646/TALK"  , "narrator": "つばめ", "text": "ううん。\n急に黙っちゃったから、\nどうしたのかな、って…。"},
        { "location": "648/TALK"  , "narrator": "神楽", "text": "ごめんなさい。\nちょっと、考え事を\nしてただけです…。"},
        { "location": "649/TALK"  , "narrator": "神楽", "text": "…冷静にならなくちゃ。"},
        { "location": "650/TALK"  , "narrator": "神楽", "text": "この子は、私の聞いてた\n逢瀬つばめとは、\nまったく違う子…。"},
        { "location": "651/TALK"  , "narrator": "神楽", "text": "でも、逢瀬つばめである\nことに間違いはない。"},
        { "location": "652/TALK"  , "narrator": "神楽", "text": "その証拠に――"},
        { "location": "653/TALK"  , "narrator": "ガブリエラ", "text": "ここにいたの？"},
        { "location": "658/TALK"  , "narrator": "ガブリエラ", "text": "新人同士、\n仲良くお喋り？"},
        { "location": "660/TALK"  , "narrator": "神楽", "text": "はい…なにかご用ですか？"},
        { "location": "662/TALK"  , "narrator": "ガブリエラ", "text": "用ってほどの事じゃ\nないんだけど…。"},
        { "location": "663/TALK"  , "narrator": "ガブリエラ", "text": "まあ、先輩として\n一応言っておこうかと\n思ってね。"},
        { "location": "665/TALK"  , "narrator": "ガブリエラ", "text": "神楽、あんた初陣のくせに\n中々やるじゃない。"},
        { "location": "666/TALK"  , "narrator": "ガブリエラ", "text": "アーヤもみやびも、\nあんたの動きを見て\n驚いてたわ。"},
        { "location": "667/TALK"  , "narrator": "神楽", "text": "あ、ありがとう\nございます。"},
        { "location": "668/TALK"  , "narrator": "ガブリエラ", "text": "ま、カマを引っかけて\n転んだのを引いても、\n十分合格点よ。"},
        { "location": "669/TALK"  , "narrator": "ガブリエラ", "text": "これからも頑張んなさい。"},
        { "location": "671/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "672/TALK"  , "narrator": "つばめ", "text": "あ、あの、えっと…。"},
        { "location": "674/TALK"  , "narrator": "ガブリエラ", "text": "言うまでもないけど、\nあんたはダメダメよ。"},
        { "location": "676/TALK"  , "narrator": "つばめ", "text": "あうっ…。"},
        { "location": "677/TALK"  , "narrator": "ガブリエラ", "text": "なんの活躍もしないで、\nピンチになるばっかりの\n足手まといだったし。"},
        { "location": "678/TALK"  , "narrator": "ガブリエラ", "text": "そのくせ、最後の最後に\n美味しいとこだけ\n持ってくなんて…。"},
        { "location": "679/TALK"  , "narrator": "ガブリエラ", "text": "てか、コネクトの仕方\nアーヤに教わってたのに、\nなんでできなかったわけ？"},
        { "location": "681/TALK"  , "narrator": "つばめ", "text": "だ、だって、急なこと\nだったから…。"},
        { "location": "683/TALK"  , "narrator": "神楽", "text": "…そんな無防備な\n気持ちで、フェノメノンの\n中に入ったなんて。"},
        { "location": "684/TALK"  , "narrator": "神楽", "text": "ただの自殺行為…。\nそれとも、絶対的な\n自信があったから？"},
        { "location": "685/TALK"  , "narrator": "ガブリエラ", "text": "まあ、とりあえず\n今日のところは\n見逃すけど…。"},
        { "location": "686/TALK"  , "narrator": "ガブリエラ", "text": "次からは手抜きしないで、\n本気で戦いなさいよ？"},
        { "location": "688/TALK"  , "narrator": "ガブリエラ", "text": "あんたと違って、\nこっちはみんな\n命がけなんだから…。"},
        { "location": "689/TALK"  , "narrator": "つばめ", "text": "て、手抜きなんか\nしてないよ！"},
        { "location": "690/TALK"  , "narrator": "つばめ", "text": "確かに、今日は\nダメダメだったかも\nしれないけど…。"},
        { "location": "691/TALK"  , "narrator": "つばめ", "text": "わたし、本気で戦ったよ。\nわたしも、死にたいなんて\n思ってないから。"},
        { "location": "692/TALK"  , "narrator": "ガブリエラ", "text": "ウソでしょ？\n全然信じられないわ。"},
        { "location": "693/TALK"  , "narrator": "つばめ", "text": "ほ、本当だよ！"},
        { "location": "694/TALK"  , "narrator": "ガブリエラ", "text": "じゃあ、なんでこの間の\nドームの時みたいに――"},
        { "location": "695/TALK"  , "narrator": "つばめ", "text": "え？"},
        { "location": "696/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "698/TALK"  , "narrator": "ガブリエラ", "text": "なんでもない…。\nもういいわよ。"},
        { "location": "699/TALK"  , "narrator": "つばめ", "text": "あ、あの、ガブちゃん。\nわたし、次は絶対に\nもっと頑張るから…。"},
        { "location": "702/TALK"  , "narrator": "ガブリエラ", "text": "も、もういいって\n言ってるでしょ！"},
        { "location": "703/TALK"  , "narrator": "ガブリエラ", "text": "とにかく、あたしからの\n話は以上だから。\nそれじゃ！"},
        { "location": "707/TALK"  , "narrator": "つばめ", "text": "…どうしたんだろう？\n急に怒るのやめちゃった\nみたいだけど…。"},
        { "location": "708/TALK"  , "narrator": "神楽", "text": "…さあ？"},
        { "location": "709/TALK"  , "narrator": "神楽", "text": "あのドーム戦で、\nこの子は確かに音羽の\nクランを破壊した。"},
        { "location": "710/TALK"  , "narrator": "神楽", "text": "逢瀬つばめであるという\n証拠は、それで十分。"},
        { "location": "712/TALK"  , "narrator": "つばめ", "text": "怒るのもイヤになる\nくらい、\n呆れさせちゃったのかな？"},
        { "location": "713/TALK"  , "narrator": "神楽", "text": "…さあ？\n私にもわからないです。"},
        { "location": "714/TALK"  , "narrator": "神楽", "text": "警戒、もしくは怯えてたの\nどちらかに決まってるわ。"},
        { "location": "715/TALK"  , "narrator": "神楽", "text": "考えるまでもなく\nわかることなのに…。"},
        { "location": "717/TALK"  , "narrator": "つばめ", "text": "…どうしよう。\n謝りに行った方が\nいいかな？"},
        { "location": "718/TALK"  , "narrator": "神楽", "text": "…本気なのかしら？\nそれとも、演技？"},
        { "location": "719/TALK"  , "narrator": "神楽", "text": "私がカマを引っかけて、\nワザと転んだときの\nこともそう。"},
        { "location": "720/TALK"  , "narrator": "神楽", "text": "逢瀬つばめの力を\n引き出すために、\nわざとピンチになれば…。"},
        { "location": "721/TALK"  , "narrator": "神楽", "text": "ドームで見せた力を\n発揮するかと思ったのに、\n結局なにもしなかった。"},
        { "location": "722/TALK"  , "narrator": "神楽", "text": "それも含めて、すべてが\n逢瀬つばめの自分を\n偽る演技だとしたら――"},
        { "location": "723/TALK"  , "narrator": "神楽", "text": "相当な役者だわ…。\n仲間の命すら気にかけない\nくらいなんだから…。"},
        { "location": "724/TALK"  , "narrator": "つばめ", "text": "ねえ、卯月さん。\nどうしたらいいと思う？"},
        { "location": "725/TALK"  , "narrator": "神楽", "text": "…あまりしつこくしても\n気分を害するだけだと\n思いますし。"},
        { "location": "726/TALK"  , "narrator": "神楽", "text": "今度の出撃の時に\n頑張って、\n名誉挽回しましょう！"},
        { "location": "727/TALK"  , "narrator": "つばめ", "text": "…できるかな？"},
        { "location": "728/TALK"  , "narrator": "神楽", "text": "私も手伝いますから、\n一緒に頑張りましょう。"},
        { "location": "729/TALK"  , "narrator": "つばめ", "text": "卯月さん…。\nありがとう。\nわたし、頑張れそうだよ！"},
        { "location": "730/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "731/TALK"  , "narrator": "神楽", "text": "どちらにせよ、この子が\n危険な存在であることに\n変わりはなんだから…。"},
        { "location": "732/TALK"  , "narrator": "神楽", "text": "なにがあろうと、\n警戒を怠らないように\n気をつけないと。"},
        { "location": "741/DIALOG", "narrator": "Dialog_chapter_ch05", "text": "【05 金色の髪のカグラ】"},
        { "location": "753/DIALOG", "narrator": "Dialog_chapter_ch05", "text": "【05 金色の髪のカグラ】"}
    ]
}
