    "entry":
    [
        { "location": "853/SCENARIO", "narrator": "", "text": "役割と義務"},
        { "location": "872/TALK"    , "narrator": "アーヤ", "text": "…これは…！？"},
        { "location": "873/TALK"    , "narrator": "アーヤ", "text": "…逢瀬つばめの中の\n私の記憶が…\n流れ込んで来る…！"},
        { "location": "874/TALK"    , "narrator": "アーヤ", "text": "$handle$が\n言ってた内容が\nわかったわ…！"},
        { "location": "876/TALK"    , "narrator": "アーヤ", "text": "でもこれってよくない\n事態だわ…。"},
        { "location": "877/TALK"    , "narrator": "アーヤ", "text": "早くこの状態を\n解決しなきゃ…。"},
        { "location": "878/TALK"    , "narrator": "アーヤ", "text": "つばめの世界を\n蒸着させて\nセカイを開く。"},
        { "location": "879/TALK"    , "narrator": "アーヤ", "text": "早くしなきゃ…！"},
        { "location": "880/TALK"    , "narrator": "アーヤ", "text": "$handle$\n手伝って！"},
        { "location": "881/SEL"     , "narrator": "", "text": "ちょっと待って"},
        { "location": "882/SEL"     , "narrator": "", "text": "今はそれよりすることが"},
        { "location": "883/ACT"     , "narrator": "", "text": "ちょっと待って"},
        { "location": "884/TALK"    , "narrator": "アーヤ", "text": "待てないわ！"},
        { "location": "885/ACT"     , "narrator": "", "text": "今はそれよりすることが"},
        { "location": "886/TALK"    , "narrator": "アーヤ", "text": "最優先なのはこっちよ！"},
        { "location": "888/TALK"    , "narrator": "アーヤ", "text": "この状態が長く\n続くのはまずいのよ。"},
        { "location": "889/TALK"    , "narrator": "アーヤ", "text": "すぐにでも日本を覆う\n繭を取り払って\n外と中を繋げないと…！"},
        { "location": "904/TALK"    , "narrator": "アーヤ", "text": "うわっ！"},
        { "location": "905/TALK"    , "narrator": "アーヤ", "text": "ちょっとあなた\n何をしたの！？"},
        { "location": "906/SEL"     , "narrator": "", "text": "$me$は何もしていない"},
        { "location": "907/SEL"     , "narrator": "", "text": "濡れ衣だ"},
        { "location": "908/SEL"     , "narrator": "", "text": "$me$にもわからない"},
        { "location": "909/ACT"     , "narrator": "", "text": "$me$は何もしていない"},
        { "location": "910/TALK"    , "narrator": "アーヤ", "text": "直接じゃなくても\n心当たりはないの？"},
        { "location": "911/ACT"     , "narrator": "", "text": "濡れ衣だ"},
        { "location": "912/TALK"    , "narrator": "アーヤ", "text": "何もしてないの？"},
        { "location": "913/ACT"     , "narrator": "", "text": "$me$にもわからない"},
        { "location": "914/TALK"    , "narrator": "アーヤ", "text": "思いつくことはないの？"},
        { "location": "932/TALK"    , "narrator": "高校生アーヤ", "text": "…？"},
        { "location": "934/TALK"    , "narrator": "高校生アーヤ", "text": "ここは……？"},
