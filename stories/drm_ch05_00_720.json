    "entry":
    [
        { "location": "190/SCENARIO", "narrator": "", "text": "歌うことは私の全てだったから"},
        { "location": "215/TALK"    , "narrator": "神楽", "text": "ぴょんこのパパはすごく退屈な人だったぴょん"},
        { "location": "217/SEL"     , "narrator": "", "text": "それでも好きだったんでしょ？"},
        { "location": "218/SEL"     , "narrator": "", "text": "つまんない人だったんだ？"},
        { "location": "219/ACT"     , "narrator": "", "text": "それでも好きだったんでしょ？"},
        { "location": "221/TALK"    , "narrator": "神楽", "text": "当たり前"},
        { "location": "223/TALK"    , "narrator": "神楽", "text": "ぴょんこのパパだから"},
        { "location": "225/TALK"    , "narrator": "神楽", "text": "でも"},
        { "location": "226/TALK"    , "narrator": "神楽", "text": "それだけじゃなくて"},
        { "location": "227/TALK"    , "narrator": "神楽", "text": "良くも悪くもすごい技術者だったから"},
        { "location": "228/TALK"    , "narrator": "神楽", "text": "そういうの格好いいなって"},
        { "location": "229/TALK"    , "narrator": "神楽", "text": "尊敬してた"},
        { "location": "231/SEL"     , "narrator": "", "text": "$me$も尊敬されたいな"},
        { "location": "232/SEL"     , "narrator": "", "text": "そうだったんだ"},
        { "location": "233/SEL"     , "narrator": "", "text": "天才とアレはってやつか……"},
        { "location": "234/ACT"     , "narrator": "", "text": "$me$も尊敬されたいな"},
        { "location": "235/TALK"    , "narrator": "神楽", "text": "ぴょんこはー"},
        { "location": "236/TALK"    , "narrator": "神楽", "text": "$handle$のことー"},
        { "location": "237/TALK"    , "narrator": "神楽", "text": "ちょうそんけいしてるしー"},
        { "location": "239/ACT"     , "narrator": "", "text": "そうだったんだ"},
        { "location": "240/TALK"    , "narrator": "神楽", "text": "そうなんだ"},
        { "location": "241/ACT"     , "narrator": "", "text": "天才とアレはってやつか……"},
        { "location": "242/TALK"    , "narrator": "神楽", "text": "それそれ！"},
        { "location": "244/TALK"    , "narrator": "神楽", "text": "ただパパは"},
        { "location": "245/TALK"    , "narrator": "神楽", "text": "勉強が大好きでいっぱい勉強して技術者になったから"},
        { "location": "246/TALK"    , "narrator": "神楽", "text": "勉強が世界で一番大事だと思っていたぴょん"},
        { "location": "247/TALK"    , "narrator": "神楽", "text": "だからぴょんこにも会うたびに勉強してるかってそればっかり"},
        { "location": "250/SEL"     , "narrator": "", "text": "やる気なくなっちゃうね"},
        { "location": "251/SEL"     , "narrator": "", "text": "お父さんなりの愛情だったんだよ"},
        { "location": "252/SEL"     , "narrator": "", "text": "あんまり顔を合わさなかったのかな"},
        { "location": "253/ACT"     , "narrator": "", "text": "やる気なくなっちゃうね"},
        { "location": "254/TALK"    , "narrator": "神楽", "text": "普通はそう思うよね"},
        { "location": "255/TALK"    , "narrator": "神楽", "text": "子供の気持ちわかってないぴょん！"},
        { "location": "256/ACT"     , "narrator": "", "text": "お父さんなりの愛情だったんだよ"},
        { "location": "257/TALK"    , "narrator": "神楽", "text": "知ってるけどー"},
        { "location": "259/TALK"    , "narrator": "神楽", "text": "知ってるけどさー？"},
        { "location": "260/ACT"     , "narrator": "", "text": "あんまり顔を合わさなかったのかな"},
        { "location": "261/TALK"    , "narrator": "神楽", "text": "まあね"},
        { "location": "262/TALK"    , "narrator": "神楽", "text": "会社に泊まり込んで開発してたりとか"},
        { "location": "263/TALK"    , "narrator": "神楽", "text": "そういうのすごく多くて"},
        { "location": "265/TALK"    , "narrator": "神楽", "text": "それに音楽とか全然興味なくて"},
        { "location": "266/TALK"    , "narrator": "神楽", "text": "ぴょんこが何やってるかもわかんなかったと思う"},
        { "location": "268/SEL"     , "narrator": "", "text": "親って無理解だよね"},
        { "location": "269/SEL"     , "narrator": "", "text": "ちょっとさみしいね"},
        { "location": "270/SEL"     , "narrator": "", "text": "お互いすれ違ってたんだね"},
        { "location": "271/ACT"     , "narrator": "", "text": "親って無理解だよね"},
        { "location": "272/TALK"    , "narrator": "神楽", "text": "あーね！"},
        { "location": "273/TALK"    , "narrator": "神楽", "text": "ｾｲｼｭﾝっぽいフレーズ！"},
        { "location": "274/ACT"     , "narrator": "", "text": "ちょっとさみしいね"},
        { "location": "275/TALK"    , "narrator": "神楽", "text": "わかってくれる？"},
        { "location": "277/TALK"    , "narrator": "神楽", "text": "$handle$ﾔｻｽｨ、、、、"},
        { "location": "278/ACT"     , "narrator": "", "text": "お互いすれ違ってたんだね"},
        { "location": "279/TALK"    , "narrator": "神楽", "text": "そうかもね"},
        { "location": "281/TALK"    , "narrator": "神楽", "text": "パパはそんなだったけど"},
        { "location": "282/TALK"    , "narrator": "神楽", "text": "ぴょんこにはママも音羽もいたし"},
        { "location": "283/TALK"    , "narrator": "神楽", "text": "すっごく不満ってわけじゃなかったぴょん"},
        { "location": "285/SEL"     , "narrator": "", "text": "ならいいんだけど…"},
        { "location": "286/SEL"     , "narrator": "", "text": "今は$me$もいるよ"},
        { "location": "287/ACT"     , "narrator": "", "text": "ならいいんだけど…"},
        { "location": "289/TALK"    , "narrator": "神楽", "text": "うん"},
        { "location": "290/TALK"    , "narrator": "神楽", "text": "平気"},
        { "location": "291/TALK"    , "narrator": "神楽", "text": "平気ぴょん"},
        { "location": "292/ACT"     , "narrator": "", "text": "今は$me$もいるよ"},
        { "location": "294/TALK"    , "narrator": "神楽", "text": "だね"},
        { "location": "295/TALK"    , "narrator": "神楽", "text": "$handle$が"},
        { "location": "296/TALK"    , "narrator": "神楽", "text": "いてくれるぴょん、、、"},
        { "location": "299/SEL"     , "narrator": "", "text": "無理して笑わないで"},
        { "location": "300/SEL"     , "narrator": "", "text": "泣きたい時は泣いていいから"},
        { "location": "301/SEL"     , "narrator": "", "text": "$me$にできることはある？"},
        { "location": "302/ACT"     , "narrator": "", "text": "無理して笑わないで"},
        { "location": "303/TALK"    , "narrator": "神楽", "text": "そんなこと"},
        { "location": "304/TALK"    , "narrator": "神楽", "text": "しちゃうけど"},
        { "location": "305/TALK"    , "narrator": "神楽", "text": "今日はそれも無理"},
        { "location": "306/ACT"     , "narrator": "", "text": "泣きたい時は泣いていいから"},
        { "location": "307/TALK"    , "narrator": "神楽", "text": "だってそんなことしたら"},
        { "location": "308/TALK"    , "narrator": "神楽", "text": "もうぴょんこは立ち上がれない"},
        { "location": "309/TALK"    , "narrator": "神楽", "text": "そうなっちゃうかもだし"},
        { "location": "310/ACT"     , "narrator": "", "text": "$me$にできることはある？"},
        { "location": "311/TALK"    , "narrator": "神楽", "text": "わかんない"},
        { "location": "312/TALK"    , "narrator": "神楽", "text": "けど"},
        { "location": "313/TALK"    , "narrator": "神楽", "text": "側にいて"},
        { "location": "316/TALK"    , "narrator": "神楽", "text": "ごめん"},
        { "location": "317/TALK"    , "narrator": "神楽", "text": "今日はもう寝る"},
        { "location": "319/SEL"     , "narrator": "", "text": "神楽"},
        { "location": "320/ACT"     , "narrator": "", "text": "神楽"},
        { "location": "323/SEL"     , "narrator": "", "text": "おやすみ、いい夢を"},
        { "location": "324/SEL"     , "narrator": "", "text": "$me$は神楽の味方だから"},
        { "location": "325/SEL"     , "narrator": "", "text": "明日はきっといい日になるよ"},
        { "location": "326/ACT"     , "narrator": "", "text": "おやすみ、いい夢を"},
        { "location": "328/TALK"    , "narrator": "神楽", "text": "おやすみ"},
        { "location": "329/ACT"     , "narrator": "", "text": "$me$は神楽の味方だから"},
        { "location": "332/ACT"     , "narrator": "", "text": "明日はきっといい日になるよ"},
        { "location": "334/TALK"    , "narrator": "神楽", "text": "だといいね"},
        { "location": "336/ACT"     , "narrator": "", "text": "つまんない人だったんだ？"},
        { "location": "337/TALK"    , "narrator": "神楽", "text": "かもね"}
