    [
        { "location": "251/SCENARIO", "narrator": "", "text": "ラブという名の元に"},
        { "location": "278/TALK"    , "narrator": "神楽", "text": "ぴょんこ合宿初日すごくがんばった！"},
        { "location": "279/TALK"    , "narrator": "神楽", "text": "$handle$とこうやって話すのだけを心の支えにして頑張った！"},
        { "location": "280/TALK"    , "narrator": "神楽", "text": "だからほめて～～～～！！！"},
        { "location": "281/TALK"    , "narrator": "神楽", "text": "褒めて褒めて褒めて～～～～～～！！！！！"},
        { "location": "283/SEL"     , "narrator": "", "text": "偉い偉い"},
        { "location": "284/SEL"     , "narrator": "", "text": "無理しすぎないで"},
        { "location": "285/SEL"     , "narrator": "", "text": "今日はゆっくり休んで"},
        { "location": "286/ACT"     , "narrator": "", "text": "偉い偉い"},
        { "location": "287/TALK"    , "narrator": "神楽", "text": "ﾔｯﾀー！！！"},
        { "location": "288/ACT"     , "narrator": "", "text": "無理しすぎないで"},
        { "location": "289/TALK"    , "narrator": "神楽", "text": "それは大丈夫～～"},
        { "location": "290/ACT"     , "narrator": "", "text": "今日はゆっくり休んで"},
        { "location": "291/TALK"    , "narrator": "神楽", "text": "そうするー"},
        { "location": "293/TALK"    , "narrator": "神楽", "text": "あーあーあーあー"},
        { "location": "295/TALK"    , "narrator": "神楽", "text": "それにしてもみんな体力ありすぎ！"},
        { "location": "296/TALK"    , "narrator": "神楽", "text": "ぴょんこついてけない"},
        { "location": "298/SEL"     , "narrator": "", "text": "それは大変だね"},
        { "location": "299/SEL"     , "narrator": "", "text": "えっ、神楽ってすごい体力あるよね確か"},
        { "location": "300/SEL"     , "narrator": "", "text": "トライナリーは脳筋勢なの？"},
        { "location": "301/ACT"     , "narrator": "", "text": "それは大変だね"},
        { "location": "302/TALK"    , "narrator": "神楽", "text": "そうなの～～～"},
        { "location": "303/TALK"    , "narrator": "神楽", "text": "ぴょんこついてくの無理ぃ、、、"},
        { "location": "304/ACT"     , "narrator": "", "text": "えっ、神楽ってすごい体力あるよね確か"},
        { "location": "305/TALK"    , "narrator": "神楽", "text": "ぴょんこが体育会系だって～？"},
        { "location": "307/ACT"     , "narrator": "", "text": "トライナリーは脳筋勢なの？"},
        { "location": "308/TALK"    , "narrator": "神楽", "text": "脳みそが筋肉でできてる人たち？？？"},
        { "location": "309/TALK"    , "narrator": "神楽", "text": "ある意味ｿｳｶﾓﾅー"},
        { "location": "311/TALK"    , "narrator": "神楽", "text": "えっとね"},
        { "location": "312/TALK"    , "narrator": "神楽", "text": "$handle$とぴょんこは恋人同士でしょでしょでしょ？"},
        { "location": "314/SEL"     , "narrator": "", "text": "そうだよ！"},
        { "location": "315/SEL"     , "narrator": "", "text": "少なくとも$me$はそう思ってる"},
        { "location": "316/SEL"     , "narrator": "", "text": "もしかして…違うの？"},
        { "location": "317/ACT"     , "narrator": "", "text": "そうだよ！"},
        { "location": "318/TALK"    , "narrator": "神楽", "text": "だよね"},
        { "location": "319/TALK"    , "narrator": "神楽", "text": "そうだよね"},
        { "location": "320/ACT"     , "narrator": "", "text": "少なくとも$me$はそう思ってる"},
        { "location": "321/TALK"    , "narrator": "神楽", "text": "$handle$だけじゃないし！"},
        { "location": "322/TALK"    , "narrator": "神楽", "text": "ぴょんこもそう思ってるし！"},
        { "location": "323/ACT"     , "narrator": "", "text": "もしかして…違うの？"},
        { "location": "324/TALK"    , "narrator": "神楽", "text": "えっえっえっえっ"},
        { "location": "327/TALK"    , "narrator": "神楽", "text": "そこはのろけるところでそー！！！"},
        { "location": "328/TALK"    , "narrator": "神楽", "text": "わかってないな$handle$！！！"},
        { "location": "329/TALK"    , "narrator": "神楽", "text": "けしからん"},
        { "location": "330/TALK"    , "narrator": "神楽", "text": "実にけしからん！！！！！"},
        { "location": "332/TALK"    , "narrator": "神楽", "text": "ぴょんこの恋人なら好きって言ってくれなきゃﾔﾀﾞﾔﾀﾞ！！！"},
        { "location": "334/SEL"     , "narrator": "", "text": "えっと…どうしたの急に"},
        { "location": "335/SEL"     , "narrator": "", "text": "そんなに合宿辛いの？"},
        { "location": "336/SEL"     , "narrator": "", "text": "好きに決まってるけど…"},
        { "location": "337/ACT"     , "narrator": "", "text": "えっと…どうしたの急に"},
        { "location": "338/TALK"    , "narrator": "神楽", "text": "そういう気分になっちゃったんです"},
        { "location": "339/TALK"    , "narrator": "神楽", "text": "ぴょんこはさみしいと○んじゃううさぎさんだから"},
        { "location": "340/ACT"     , "narrator": "", "text": "そんなに合宿辛いの？"},
        { "location": "341/TALK"    , "narrator": "神楽", "text": "辛いは辛いけど～～～"},
        { "location": "342/TALK"    , "narrator": "神楽", "text": "今は心の隙間が一番辛いんです～～"},
        { "location": "343/ACT"     , "narrator": "", "text": "好きに決まってるけど…"},
        { "location": "344/TALK"    , "narrator": "神楽", "text": "けどけどけどけど？？？"},
        { "location": "346/TALK"    , "narrator": "神楽", "text": "その先の台詞はよ！！！！"},
        { "location": "349/TALK"    , "narrator": "神楽", "text": "ﾃﾞﾓ、、、、、、、、"},
        { "location": "350/TALK"    , "narrator": "神楽", "text": "こういうの"},
        { "location": "351/TALK"    , "narrator": "神楽", "text": "重すぎだよね？？？？"},
        { "location": "353/SEL"     , "narrator": "", "text": "もしかして計算なの？"},
        { "location": "354/SEL"     , "narrator": "", "text": "それも含めて受け止めるから"},
        { "location": "355/SEL"     , "narrator": "", "text": "むしろ萌える"},
        { "location": "356/ACT"     , "narrator": "", "text": "もしかして計算なの？"},
        { "location": "357/TALK"    , "narrator": "神楽", "text": "自分でもよくわからないけど"},
        { "location": "358/TALK"    , "narrator": "神楽", "text": "やっぱり計算だったらダメなのかな？？？"},
        { "location": "359/ACT"     , "narrator": "", "text": "それも含めて受け止めるから"},
        { "location": "360/TALK"    , "narrator": "神楽", "text": "やっぱり$handle$ﾔｻｼｰ、、、"},
        { "location": "361/ACT"     , "narrator": "", "text": "むしろ萌える"},
        { "location": "364/TALK"    , "narrator": "神楽", "text": "特殊すぎるｱﾚｗｗｗｗｗｗｗ"},
        { "location": "366/TALK"    , "narrator": "神楽", "text": "だがそこがいい（ｷﾘｯ"},
        { "location": "370/SEL"     , "narrator": "", "text": "神楽？"},
        { "location": "371/SEL"     , "narrator": "", "text": "寝ちゃった？"},
        { "location": "372/SEL"     , "narrator": "", "text": "疲れてるならまた後にしよう"},
        { "location": "373/ACT"     , "narrator": "", "text": "神楽？"},
        { "location": "374/TALK"    , "narrator": "神楽", "text": "どうしたぴょん？"},
        { "location": "375/ACT"     , "narrator": "", "text": "寝ちゃった？"},
        { "location": "376/TALK"    , "narrator": "神楽", "text": "起きてる超起きてる！"},
        { "location": "377/ACT"     , "narrator": "", "text": "疲れてるならまた後にしよう"},
        { "location": "378/TALK"    , "narrator": "神楽", "text": "疲れてるけど"},
        { "location": "379/TALK"    , "narrator": "神楽", "text": "もうちょっとお話ししたいぴょん、、、"},
        { "location": "384/TALK"    , "narrator": "神楽", "text": "$handle$は"},
        { "location": "385/TALK"    , "narrator": "神楽", "text": "ぴょんこのこと好きなんでしょ？？"},
        { "location": "387/SEL"     , "narrator": "", "text": "好きだってば"},
        { "location": "388/SEL"     , "narrator": "", "text": "好きっていうか愛してる"},
        { "location": "389/SEL"     , "narrator": "", "text": "当然でしょ！"},
        { "location": "390/ACT"     , "narrator": "", "text": "好きだってば"},
        { "location": "392/TALK"    , "narrator": "神楽", "text": "ちょっと投げやりになってない？？？"},
        { "location": "393/ACT"     , "narrator": "", "text": "好きっていうか愛してる"},
        { "location": "395/TALK"    , "narrator": "神楽", "text": "ｱｲｼﾃﾙ、、、"},
        { "location": "396/TALK"    , "narrator": "神楽", "text": "やーもーｷｭｰﾝ！！！"},
        { "location": "399/ACT"     , "narrator": "", "text": "当然でしょ！"},
        { "location": "401/TALK"    , "narrator": "神楽", "text": "えっらそー"},
        { "location": "402/TALK"    , "narrator": "神楽", "text": "その返事は違うでしょ～～～！？"},
        { "location": "407/TALK"    , "narrator": "神楽", "text": "ぴょんこはねー"},
        { "location": "408/TALK"    , "narrator": "神楽", "text": "恋人には好きって言ったら好きって返して欲しいの"},
        { "location": "409/TALK"    , "narrator": "神楽", "text": "そーゆーの必要でしょ"},
        { "location": "410/TALK"    , "narrator": "神楽", "text": "むしろそれなしで恋人同士とかｱﾘｴﾅｽ！！！！"},
        { "location": "412/SEL"     , "narrator": "", "text": "そんなキャラだっけ？"},
        { "location": "413/SEL"     , "narrator": "", "text": "好きだよ神楽"},
        { "location": "414/SEL"     , "narrator": "", "text": "ずっと側にいるから心配しないで"},
        { "location": "415/ACT"     , "narrator": "", "text": "そんなキャラだっけ？"},
        { "location": "417/TALK"    , "narrator": "神楽", "text": "ぴょんこはぴょんこでしかないから"},
        { "location": "418/TALK"    , "narrator": "神楽", "text": "どんなぴょんこでも"},
        { "location": "419/ACT"     , "narrator": "", "text": "好きだよ神楽"},
        { "location": "420/TALK"    , "narrator": "神楽", "text": "ぴょんこも$handle$のことｽｷｽｷｽｰ！！！"},
        { "location": "422/ACT"     , "narrator": "", "text": "ずっと側にいるから心配しないで"},
        { "location": "424/TALK"    , "narrator": "神楽", "text": "未来より今の時間の方がうんと大切じゃない？？？"},
        { "location": "425/TALK"    , "narrator": "神楽", "text": "ぴょんこはそう思っちゃうんだけどﾅｰ"},
