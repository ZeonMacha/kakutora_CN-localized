        "sub_title": "ガタンゴトンと揺れながら"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "026_ガタンゴトンと揺れながら"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "旅行というものは"},
        { "location": "33/TALK"   , "narrator": "みやび", "text": "日常からの解放"},
        { "location": "34/TALK"   , "narrator": "みやび", "text": "つまりサボってどこかに行くのは"},
        { "location": "35/TALK"   , "narrator": "みやび", "text": "正当なアレなんじゃよ"},
        { "location": "37/SEL"    , "narrator": "", "text": "怒られてなかったっけ？"},
        { "location": "38/SEL"    , "narrator": "", "text": "そうだな若人よ"},
        { "location": "39/SEL"    , "narrator": "", "text": "そういうもん？"},
        { "location": "40/ACT"    , "narrator": "", "text": "怒られてなかったっけ？"},
        { "location": "41/TALK"   , "narrator": "みやび", "text": "当然"},
        { "location": "43/TALK"   , "narrator": "みやび", "text": "怒られた"},
        { "location": "44/ACT"    , "narrator": "", "text": "そうだな若人よ"},
        { "location": "45/TALK"   , "narrator": "みやび", "text": "年長者ぶるか"},
        { "location": "46/TALK"   , "narrator": "みやび", "text": "$handle$め"},
        { "location": "47/ACT"    , "narrator": "", "text": "そういうもん？"},
        { "location": "48/TALK"   , "narrator": "みやび", "text": "わからんなら"},
        { "location": "49/TALK"   , "narrator": "みやび", "text": "仕様がない"},
        { "location": "50/TALK"   , "narrator": "みやび", "text": "仕様がないは"},
        { "location": "51/TALK"   , "narrator": "みやび", "text": "ダブルミーニング"},
        { "location": "53/TALK"   , "narrator": "みやび", "text": "そんなわけで"},
        { "location": "54/TALK"   , "narrator": "みやび", "text": "機会があったらまた行く所存"},
        { "location": "56/SEL"    , "narrator": "", "text": "次は誰と行きたい？"},
        { "location": "57/SEL"    , "narrator": "", "text": "次は泊りがけだ"},
        { "location": "58/SEL"    , "narrator": "", "text": "次は二人きりで行こう"},
        { "location": "59/ACT"    , "narrator": "", "text": "次は誰と行きたい？"},
        { "location": "61/TALK"   , "narrator": "みやび", "text": "ガブちゃんかの"},
        { "location": "63/TALK"   , "narrator": "みやび", "text": "付き合ってくれそうだし"},
        { "location": "65/TALK"   , "narrator": "みやび", "text": "ただ隠し事はできそうにないゆえ"},
        { "location": "66/TALK"   , "narrator": "みやび", "text": "直前で拉致か"},
        { "location": "67/ACT"    , "narrator": "", "text": "次は泊りがけだ"},
        { "location": "68/TALK"   , "narrator": "みやび", "text": "せやな"},
        { "location": "69/TALK"   , "narrator": "みやび", "text": "って"},
        { "location": "70/TALK"   , "narrator": "みやび", "text": "失踪事件となってしまう可能性を憂慮"},
        { "location": "72/TALK"   , "narrator": "みやび", "text": "故に却下だ"},
        { "location": "73/ACT"    , "narrator": "", "text": "次は二人きりで行こう"},
        { "location": "75/TALK"   , "narrator": "みやび", "text": "常にスマホでの会話のみになってしまうではないか"},
        { "location": "76/TALK"   , "narrator": "みやび", "text": "旅には"},
        { "location": "77/TALK"   , "narrator": "みやび", "text": "女子トークとか"},
        { "location": "78/TALK"   , "narrator": "みやび", "text": "そういったものが必要"},
        { "location": "79/TALK"   , "narrator": "みやび", "text": "とはいえ"},
        { "location": "80/TALK"   , "narrator": "みやび", "text": "$handle$となら"},
        { "location": "81/TALK"   , "narrator": "みやび", "text": "考えてやらんでもない"}
    ]
}
