        { "location": "7/SCENARIO", "narrator": "", "text": "034_刺繍糸No.8"},
        { "location": "32/TALK"   , "narrator": "アーヤ", "text": "刺繍糸の番号"},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "何か知ってる？"},
        { "location": "35/SEL"    , "narrator": "", "text": "強さかな"},
        { "location": "36/SEL"    , "narrator": "", "text": "色番号"},
        { "location": "37/SEL"    , "narrator": "", "text": "アーヤは答えを知ってるの？"},
        { "location": "38/ACT"    , "narrator": "", "text": "強さかな"},
        { "location": "39/TALK"   , "narrator": "アーヤ", "text": "そうそう"},
        { "location": "40/TALK"   , "narrator": "アーヤ", "text": "って"},
        { "location": "42/TALK"   , "narrator": "アーヤ", "text": "そんなわけないでしょ"},
        { "location": "45/TALK"   , "narrator": "アーヤ", "text": "いや待って"},
        { "location": "46/TALK"   , "narrator": "アーヤ", "text": "ミシン意図の場合正解なのよね"},
        { "location": "47/TALK"   , "narrator": "アーヤ", "text": "糸ね"},
        { "location": "48/ACT"    , "narrator": "", "text": "色番号"},
        { "location": "50/TALK"   , "narrator": "アーヤ", "text": "んー"},
        { "location": "52/TALK"   , "narrator": "アーヤ", "text": "惜しい"},
        { "location": "53/TALK"   , "narrator": "アーヤ", "text": "ってことはないか"},
        { "location": "54/ACT"    , "narrator": "", "text": "アーヤは答えを知ってるの？"},
        { "location": "56/TALK"   , "narrator": "アーヤ", "text": "もちろん"},
        { "location": "57/TALK"   , "narrator": "アーヤ", "text": "知らなきゃ問題ださないわ"},
        { "location": "59/TALK"   , "narrator": "アーヤ", "text": "降参って言うなら"},
        { "location": "60/TALK"   , "narrator": "アーヤ", "text": "答えを教えてもいいわよ"},
        { "location": "62/TALK"   , "narrator": "アーヤ", "text": "答えがわかったら"},
        { "location": "63/TALK"   , "narrator": "アーヤ", "text": "貴方のハンカチに刺繍をしてあげるわ"}
    ]
