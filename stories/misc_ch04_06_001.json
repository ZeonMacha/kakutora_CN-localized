    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "05_003_フムフム男爵の憂鬱"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "ふむふむ"},
        { "location": "33/TALK"   , "narrator": "みやび", "text": "ふむふむ"},
        { "location": "34/TALK"   , "narrator": "みやび", "text": "ふむふむ"},
        { "location": "37/SEL"    , "narrator": "", "text": "ごめん、何？"},
        { "location": "38/SEL"    , "narrator": "", "text": "踏むの？"},
        { "location": "39/SEL"    , "narrator": "", "text": "さてはあのこと？"},
        { "location": "40/ACT"    , "narrator": "", "text": "ごめん、何？"},
        { "location": "41/TALK"   , "narrator": "みやび", "text": "フムフム男爵を"},
        { "location": "43/TALK"   , "narrator": "みやび", "text": "知らんかね"},
        { "location": "44/ACT"    , "narrator": "", "text": "踏むの？"},
        { "location": "45/TALK"   , "narrator": "みやび", "text": "その予定はないが"},
        { "location": "46/TALK"   , "narrator": "みやび", "text": "踏まれたいのか？"},
        { "location": "47/ACT"    , "narrator": "", "text": "さてはあのこと？"},
        { "location": "49/TALK"   , "narrator": "みやび", "text": "そうだ"},
        { "location": "51/TALK"   , "narrator": "みやび", "text": "あのことだ"},
        { "location": "52/TALK"   , "narrator": "みやび", "text": "速やかに教えたまえ"},
        { "location": "54/TALK"   , "narrator": "みやび", "text": "まあそんなことより"},
        { "location": "55/TALK"   , "narrator": "みやび", "text": "新人が増えた故"},
        { "location": "56/TALK"   , "narrator": "みやび", "text": "フォーメーション等考え直さねばならぬのだ"},
        { "location": "58/SEL"    , "narrator": "", "text": "みやびが？"},
        { "location": "59/SEL"    , "narrator": "", "text": "どうするの？"},
        { "location": "60/ACT"    , "narrator": "", "text": "みやびが？"},
        { "location": "63/TALK"   , "narrator": "みやび", "text": "うちが"},
        { "location": "64/TALK"   , "narrator": "みやび", "text": "ぞね"},
        { "location": "65/ACT"    , "narrator": "", "text": "どうするの？"},
        { "location": "68/TALK"   , "narrator": "みやび", "text": "どうって"},
        { "location": "70/TALK"   , "narrator": "みやび", "text": "色々シュミレーションして"},
        { "location": "72/TALK"   , "narrator": "みやび", "text": "効率化は大事ぞね"},
        { "location": "73/TALK"   , "narrator": "みやび", "text": "早く仕事を片付けることにより"},
        { "location": "74/TALK"   , "narrator": "みやび", "text": "余暇が充実するのだ"},
        { "location": "75/TALK"   , "narrator": "みやび", "text": "そのために力を注ぐのは"},
        { "location": "76/TALK"   , "narrator": "みやび", "text": "当然であろうぞ"}
    ]
}
