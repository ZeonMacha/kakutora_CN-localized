    [
        { "location": "173/SCENARIO", "narrator": "", "text": "027_白色のクレヨン"},
        { "location": "198/TALK"    , "narrator": "アーヤ", "text": "小さい頃"},
        { "location": "199/TALK"    , "narrator": "アーヤ", "text": "白いクレヨンの使い道がわからなかったのよね"},
        { "location": "201/SEL"     , "narrator": "", "text": "床に落書き"},
        { "location": "202/SEL"     , "narrator": "", "text": "未だにわからないけど"},
        { "location": "203/SEL"     , "narrator": "", "text": "後から重ねるんだよね"},
        { "location": "204/ACT"     , "narrator": "", "text": "床に落書き"},
        { "location": "206/TALK"    , "narrator": "アーヤ", "text": "こらこら"},
        { "location": "209/TALK"    , "narrator": "アーヤ", "text": "ダメでしょ(--#)"},
        { "location": "210/ACT"     , "narrator": "", "text": "未だにわからないけど"},
        { "location": "211/TALK"    , "narrator": "アーヤ", "text": "クレヨン使わないか"},
        { "location": "212/ACT"     , "narrator": "", "text": "後から重ねるんだよね"},
        { "location": "214/TALK"    , "narrator": "アーヤ", "text": "そうそう"},
        { "location": "215/TALK"    , "narrator": "アーヤ", "text": "他の色の上に乗せるのよね"},
        { "location": "216/TALK"    , "narrator": "アーヤ", "text": "城を"},
        { "location": "218/TALK"    , "narrator": "アーヤ", "text": "白を使えるようになったら"},
        { "location": "219/TALK"    , "narrator": "アーヤ", "text": "ちょっと絵の表現力が上がるわよね"},
        { "location": "221/SEL"     , "narrator": "", "text": "でもクレヨンでしょ"},
        { "location": "222/SEL"     , "narrator": "", "text": "レベルアップだね"},
        { "location": "223/SEL"     , "narrator": "", "text": "アーヤの絵が見たいな"},
        { "location": "224/ACT"     , "narrator": "", "text": "でもクレヨンでしょ"},
        { "location": "225/TALK"    , "narrator": "アーヤ", "text": "馬鹿にしない"},
        { "location": "226/TALK"    , "narrator": "アーヤ", "text": "クレヨンって結構すごいんだから＼(^O^)／"},
        { "location": "227/ACT"     , "narrator": "", "text": "レベルアップだね"},
        { "location": "228/TALK"    , "narrator": "アーヤ", "text": "そうね"},
        { "location": "230/TALK"    , "narrator": "アーヤ", "text": "その通りだわ"},
        { "location": "231/ACT"     , "narrator": "", "text": "アーヤの絵が見たいな"},
        { "location": "233/TALK"    , "narrator": "アーヤ", "text": "あら"},
        { "location": "234/TALK"    , "narrator": "アーヤ", "text": "本気で言ってるのかしら？"},
        { "location": "235/TALK"    , "narrator": "アーヤ", "text": "見せてあげてもいいわ"},
        { "location": "236/TALK"    , "narrator": "アーヤ", "text": "そのうちね"}
    ]
}
