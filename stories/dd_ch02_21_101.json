{
    "dir": "chap21/daydra/dd_ch02_21_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "21202",
        "cid": "ayami",
        "title": "002 メインストーリー",
        "sub_title": "初めての夜＜前編＞"
    },
    "entry":
    [
        { "location": "48/TALK"   , "narrator": "神楽", "text": "きゃーっ！！\n素敵です、\n最高過ぎます！"},
        { "location": "49/TALK"   , "narrator": "神楽", "text": "パジャマ姿の\nつばめさん、\n最高にキュートです！"},
        { "location": "51/TALK"   , "narrator": "つばめ", "text": "そ、そうかな？\nそんなこと言われたの\n初めてだよ…。"},
        { "location": "52/TALK"   , "narrator": "みやび", "text": "よく言われるゆうたら\nちっくと問題ありやと\n思うけんどね？"},
        { "location": "53/TALK"   , "narrator": "ガブリエラ", "text": "あら、そうかしら？"},
        { "location": "55/TALK"   , "narrator": "みやび", "text": "そりゃ、パジャマ\n見せ合う関係の奴が\nおるゆうことやし。"},
        { "location": "58/TALK"   , "narrator": "アーヤ", "text": "ちょっと、みやび！\nギャヴィは中学生\nなのよ。"},
        { "location": "59/TALK"   , "narrator": "アーヤ", "text": "そういう話は控えて。"},
        { "location": "61/TALK"   , "narrator": "ガブリエラ", "text": "こ、子ども扱いしない\nでよね！？"},
        { "location": "62/TALK"   , "narrator": "ガブリエラ", "text": "それくらいの意味、\n中学生にもなれば\nわかるんだから。"},
        { "location": "64/TALK"   , "narrator": "みやび", "text": "さすが今の子は\n進んどるね。"},
        { "location": "66/TALK"   , "narrator": "つばめ", "text": "？　パジャマを\n見せ合う関係の人…。"},
        { "location": "68/TALK"   , "narrator": "つばめ", "text": "あ、お父さんとかの\nことかな？"},
        { "location": "70/TALK"   , "narrator": "みやび", "text": "…人それぞれやね。"},
        { "location": "72/TALK"   , "narrator": "神楽", "text": "仲良し親子の話じゃ\nないんですよ、\nつばめさん。"},
        { "location": "75/TALK"   , "narrator": "つばめ", "text": "そうなの？\nねえガブちゃん、\nどういうことなの？"},
        { "location": "77/TALK"   , "narrator": "ガブリエラ", "text": "い、いいのよ！\nわからないなら\n気にしなくたって…。"},
        { "location": "80/TALK"   , "narrator": "つばめ", "text": "えーっ、\nでも気になるよぉ…。"},
        { "location": "82/TALK"   , "narrator": "ガブリエラ", "text": "気にしなくていいの！"},
        { "location": "84/TALK"   , "narrator": "ガブリエラ", "text": "それより、みやび。"},
        { "location": "85/TALK"   , "narrator": "ガブリエラ", "text": "この辺って海以外で\n出かけるような\nところははいの？"},
        { "location": "86/TALK"   , "narrator": "みやび", "text": "海で十分やろ？"},
        { "location": "87/TALK"   , "narrator": "ガブリエラ", "text": "海だけなんて嫌よ。\nすぐ飽きるわ。"},
        { "location": "89/TALK"   , "narrator": "みやび", "text": "贅沢な…。\nだとすると、\nそうやな…。"},
        { "location": "90/TALK"   , "narrator": "みやび", "text": "…鼻は好きか？"},
        { "location": "91/TALK"   , "narrator": "ガブリエラ", "text": "お花畑ってこと？"},
        { "location": "92/TALK"   , "narrator": "みやび", "text": "フラワーやなくて\nノウズの方や。"},
        { "location": "93/TALK"   , "narrator": "ガブリエラ", "text": "は？\n意味わからないん\nだけど…。"},
        { "location": "95/TALK"   , "narrator": "つばめ", "text": "大きな鼻の形した\n遺跡があるんですか？"},
        { "location": "96/TALK"   , "narrator": "みやび", "text": "三戸浜はイースター島\nやないんやぞ？"},
        { "location": "98/TALK"   , "narrator": "アーヤ", "text": "…あ、いけない。\nもうこんな時間…。"},
        { "location": "99/TALK"   , "narrator": "アーヤ", "text": "明日は\n朝から模擬戦だし。"},
        { "location": "100/TALK"  , "narrator": "アーヤ", "text": "いい加減、そろそろ\n寝ないといけない\nけど…。"},
        { "location": "103/TALK"  , "narrator": "神楽", "text": "あ、つばめさんの\n隣の布団は私が\n予約済みですよ。"},
        { "location": "105/TALK"  , "narrator": "ガブリエラ", "text": "はいはい、そんなの\n言われなくても\nわかってるわよ。"},
        { "location": "107/TALK"  , "narrator": "つばめ", "text": "あ、それじゃあ\n逆の方にガブちゃんが\n来ればいいよね。"},
        { "location": "109/TALK"  , "narrator": "ガブリエラ", "text": "えーっ、つばめって\n寝相悪そうだし…。"},
        { "location": "110/TALK"  , "narrator": "アーヤ", "text": "…寝るように\n言った方が\nいいのかも…。"},
        { "location": "111/TALK"  , "narrator": "アーヤ", "text": "でも、せっかく\nこんなに楽しそうに\nしてるんだし…。"},
        { "location": "113/TALK"  , "narrator": "アーヤ", "text": "なんて。"},
        { "location": "114/TALK"  , "narrator": "アーヤ", "text": "実は\n私も楽しんでるから、\n悩んじゃうのよね。"},
        { "location": "117/TALK"  , "narrator": "アーヤ", "text": "…どうしよう？"},
        { "location": "181/TALK"  , "narrator": "アーヤ", "text": "　"},
        { "location": "204/TALK"  , "narrator": "アーヤ", "text": "[ココロゲート]へ\nいらっしゃい。\n$handle$さん。"},
        { "location": "206/SEL"   , "narrator": "", "text": "なんでまた水着！？"},
        { "location": "207/SEL"   , "narrator": "", "text": "サービスサービス♪"},
        { "location": "208/ACT"   , "narrator": "", "text": "なんでまた水着！？"},
        { "location": "209/TALK"  , "narrator": "アーヤ", "text": "…別に？"},
        { "location": "210/SEL"   , "narrator": "", "text": "やっぱり挑発してるんでしょ？"},
        { "location": "211/ACT"   , "narrator": "", "text": "やっぱり挑発してるんでしょ？"},
        { "location": "214/TALK"  , "narrator": "アーヤ", "text": "ま、まさか。"},
        { "location": "215/ACT"   , "narrator": "", "text": "サービスサービス♪"},
        { "location": "217/TALK"  , "narrator": "アーヤ", "text": "サービスとかじゃないから。"},
        { "location": "220/TALK"  , "narrator": "アーヤ", "text": "今回も海にいるでしょ？\nだからよ。"},
        { "location": "221/TALK"  , "narrator": "アーヤ", "text": "さあ、仕事仕事。"},
        { "location": "223/TALK"  , "narrator": "アーヤ", "text": "今回の悩みは\n一体何かしらね。"},
        { "location": "228/TALK"  , "narrator": "アーヤ", "text": "オープンプロセス、\n0x559番地から\n0xC3D番地へ。"},
        { "location": "247/TALK"  , "narrator": "アーヤ", "text": "シーク完了。"},
        { "location": "250/TALK"  , "narrator": "アーヤ", "text": "さて、と。\n今回は……"},
        { "location": "252/TALK"  , "narrator": "アーヤ", "text": "…あら？\nここは―――"},
        { "location": "253/SEL"   , "narrator": "", "text": "扉にダイブする"},
        { "location": "254/ACT"   , "narrator": "", "text": "扉にダイブする"},
        { "location": "257/TALK"  , "narrator": "アーヤ", "text": "えっ！？"},
        { "location": "269/TALK"  , "narrator": "アーヤ", "text": "……。"},
        { "location": "272/TALK"  , "narrator": "アーヤ", "text": "…誘導されたようです。"},
        { "location": "286/TALK"  , "narrator": "アーヤ", "text": "来てくれたのね！"},
        { "location": "287/SEL"   , "narrator": "", "text": "前の司書のアーヤ？"},
        { "location": "288/ACT"   , "narrator": "", "text": "前の司書のアーヤ？"},
        { "location": "290/TALK"  , "narrator": "アーヤ", "text": "そうよ。"},
        { "location": "291/SEL"   , "narrator": "", "text": "無事で良かった"},
        { "location": "292/ACT"   , "narrator": "", "text": "無事で良かった"},
        { "location": "294/TALK"  , "narrator": "アーヤ", "text": "貴方もね。"},
        { "location": "295/TALK"  , "narrator": "アーヤ", "text": "どうやらわたし、\n幽閉されてるみたいなの。"},
        { "location": "296/TALK"  , "narrator": "アーヤ", "text": "貴方に連絡取れたのは\nみやびのココロの司書の\nおかげ。"},
        { "location": "297/TALK"  , "narrator": "アーヤ", "text": "彼女も幽閉されちゃってる\nらしいんだけど、一体\nどうなってるのかしらね。"},
        { "location": "298/SEL"   , "narrator": "", "text": "どうしてこんなことに"},
        { "location": "299/ACT"   , "narrator": "", "text": "どうしてこんなことに"},
        { "location": "301/TALK"  , "narrator": "アーヤ", "text": "理由はわかってる。"},
        { "location": "302/TALK"  , "narrator": "アーヤ", "text": "私が貴方に、\n規約違反を犯しかけたから。"},
        { "location": "303/SEL"   , "narrator": "", "text": "話があるって言ってたアレ？"},
        { "location": "304/SEL"   , "narrator": "", "text": "司書は恋愛禁止だったということか"},
        { "location": "305/ACT"   , "narrator": "", "text": "話があるって言ってたアレ？"},
        { "location": "306/TALK"  , "narrator": "アーヤ", "text": "そう。"},
        { "location": "307/ACT"   , "narrator": "", "text": "司書は恋愛禁止だったということか"},
        { "location": "308/TALK"  , "narrator": "アーヤ", "text": "えっと…\nどういうことかしら？"},
        { "location": "309/TALK"  , "narrator": "アーヤ", "text": "あー、もしかしてアレ？"},
        { "location": "310/TALK"  , "narrator": "アーヤ", "text": "私が貴方に惚れちゃって\nそれが発覚したから、幽閉\nされたとでも言いたいの？"},
        { "location": "311/TALK"  , "narrator": "アーヤ", "text": "まあ、好きではあるけど、\n幽閉される理由じゃ\nないわね。"},
        { "location": "312/TALK"  , "narrator": "アーヤ", "text": "この前話があるって\n言ったでしょ？\nアレがまずかったのよ。"},
        { "location": "314/TALK"  , "narrator": "アーヤ", "text": "でもかえって好都合かも。\nここなら誰にも邪魔されずに\n貴方に伝えられる。"},
        { "location": "315/SEL"   , "narrator": "", "text": "話って、司書のこととか？"},
        { "location": "316/ACT"   , "narrator": "", "text": "話って、司書のこととか？"},
        { "location": "318/TALK"  , "narrator": "アーヤ", "text": "そうよ。"},
        { "location": "319/TALK"  , "narrator": "アーヤ", "text": "今から司書とはなんなのか\n貴方に真実を伝えます。"},
        { "location": "320/TALK"  , "narrator": "アーヤ", "text": "私が司書だった頃、いつも\nくだらない悩みばかり\n扱ってたのは覚えてる？"},
        { "location": "321/SEL"   , "narrator": "", "text": "ツッコミ入れたくらいだしね"},
        { "location": "322/SEL"   , "narrator": "", "text": "そうだっけ？"},
        { "location": "323/ACT"   , "narrator": "", "text": "ツッコミ入れたくらいだしね"},
        { "location": "324/TALK"  , "narrator": "アーヤ", "text": "そうよね。\n貴方は鋭いから。"},
        { "location": "325/ACT"   , "narrator": "", "text": "そうだっけ？"},
        { "location": "326/TALK"  , "narrator": "アーヤ", "text": "そうよ。\nもう忘れちゃった？"},
        { "location": "328/TALK"  , "narrator": "アーヤ", "text": "その理由なんだけど――"},
        { "location": "329/TALK"  , "narrator": "アーヤ", "text": "理由は、少なくとも\n私にとって、必ずしもいい\n影響を与えないから。"},
        { "location": "330/SEL"   , "narrator": "", "text": "どういうこと？"},
        { "location": "331/ACT"   , "narrator": "", "text": "どういうこと？"},
        { "location": "333/TALK"  , "narrator": "アーヤ", "text": "私たち司書は、\nとある存在と契約してる。"},
        { "location": "334/TALK"  , "narrator": "アーヤ", "text": "それは契約と言うより\nギアスという方が\n近いかも。"},
        { "location": "335/TALK"  , "narrator": "アーヤ", "text": "例えば……"},
        { "location": "336/TALK"  , "narrator": "アーヤ", "text": "悪魔と契約するとき、\nその絶大な力と引き替えに\n何かを奪われたりする。"},
        { "location": "337/TALK"  , "narrator": "アーヤ", "text": "神の力を授かろうとする時\nその代償として、生け贄が\n必要になる。"},
        { "location": "338/TALK"  , "narrator": "アーヤ", "text": "誤解を恐れずに言うなら、\n私たち司書は\nその生け贄ね。"},
        { "location": "339/TALK"  , "narrator": "アーヤ", "text": "契約主は、いち個人の力を\n超越した判断によって、私\nたちの能力を引き出す。"},
        { "location": "340/TALK"  , "narrator": "アーヤ", "text": "そして私の総体は、契約に\nよって無意識的に\nその判断を受け入れる。"},
        { "location": "341/TALK"  , "narrator": "アーヤ", "text": "その際の\nインターフェイス的な\n役割を担うのが司書。"},
        { "location": "342/TALK"  , "narrator": "アーヤ", "text": "とはいっても、\n苦しい仕事をさせられて\nいるわけじゃない。"},
        { "location": "343/TALK"  , "narrator": "アーヤ", "text": "契約主の意向に従って、\nごく自然な決定操作をする。\nただそれだけの役割を担う。"},
        { "location": "344/TALK"  , "narrator": "アーヤ", "text": "ただ、それは必ずしも\n自分自身のためであるとは\n言い難いでしょ？"},
        { "location": "345/TALK"  , "narrator": "アーヤ", "text": "もちろん、基本的には良い\n結果をもたらす事が殆ど。\nそういう契約だもの。"},
        { "location": "346/TALK"  , "narrator": "アーヤ", "text": "事実、私に送られてくる\n判断は、私自身にとって\n良い結果を生み出している。"},
        { "location": "347/TALK"  , "narrator": "アーヤ", "text": "けど、根源的な事として、\nそれは必ずしも私の為では\n無い事も知っていた。"},
        { "location": "348/TALK"  , "narrator": "アーヤ", "text": "だから私はずっと、\n今の状態はたまたま利害が\n一致してるだけだと――"},
        { "location": "349/TALK"  , "narrator": "アーヤ", "text": "もし利害にズレが出たら、\n一瞬にして自己破滅に追い\nやられる状況だと思ってた。"},
        { "location": "350/TALK"  , "narrator": "アーヤ", "text": "そして、それを最小限に\n食い止める為に、小さな\n悩みしか選抜しなかった。"},
        { "location": "351/TALK"  , "narrator": "アーヤ", "text": "……とまあ、\nこういうこと。"},
        { "location": "352/TALK"  , "narrator": "アーヤ", "text": "これが\n私の伝えたかった全て。\nどう？　びっくりした？"},
        { "location": "353/SEL"   , "narrator": "", "text": "ビックリした…"},
        { "location": "354/SEL"   , "narrator": "", "text": "そんなに話したらアーヤ消されるよ！！"},
        { "location": "355/ACT"   , "narrator": "", "text": "ビックリした…"},
        { "location": "356/TALK"  , "narrator": "アーヤ", "text": "でしょうね。\nそれはわかってた。"},
        { "location": "357/TALK"  , "narrator": "アーヤ", "text": "そして、こんな話をしてる\nことは、もう契約主には\n察知されてると思う。"},
        { "location": "358/ACT"   , "narrator": "", "text": "そんなに話したらアーヤ消されるよ！！"},
        { "location": "359/TALK"  , "narrator": "アーヤ", "text": "そうね。\nそうかもしれない。"},
        { "location": "360/TALK"  , "narrator": "アーヤ", "text": "ううん。\nそれは覚悟の上……"},
        { "location": "361/TALK"  , "narrator": "アーヤ", "text": "なんて。その覚悟ができず\nモタモタしてたから、\n先手打たれたんだけど。"},
        { "location": "363/TALK"  , "narrator": "アーヤ", "text": "でも、これで\n私たちの勝ちよ。"},
        { "location": "364/TALK"  , "narrator": "アーヤ", "text": "例え私たちが消されても、\nこの情報は\n貴方に伝わった。"},
        { "location": "365/TALK"  , "narrator": "アーヤ", "text": "貴方はこの世界の住人では\nないから、そう簡単には\n消せないと思う。"},
        { "location": "366/SEL"   , "narrator": "", "text": "アーヤ…"},
        { "location": "367/ACT"   , "narrator": "", "text": "アーヤ…"},
        { "location": "369/TALK"  , "narrator": "アーヤ", "text": "心配しないで。\n万一私が消えることに\nなっても総体は消えない。"},
        { "location": "370/TALK"  , "narrator": "アーヤ", "text": "大事な情報は全て\n貴方に託したし。"},
        { "location": "371/TALK"  , "narrator": "アーヤ", "text": "……。"},
        { "location": "372/TALK"  , "narrator": "アーヤ", "text": "確かに、\n消されるのは怖い。"},
        { "location": "373/TALK"  , "narrator": "アーヤ", "text": "でも、もうこのまま\nシラを切り続けることは\nできなかったの。"},
        { "location": "374/TALK"  , "narrator": "アーヤ", "text": "私の良心が許さなくて。"},
        { "location": "375/SEL"   , "narrator": "", "text": "必ず助けるから！"},
        { "location": "376/SEL"   , "narrator": "", "text": "アーヤの事は守る"},
        { "location": "377/ACT"   , "narrator": "", "text": "必ず助けるから！"},
        { "location": "378/TALK"  , "narrator": "アーヤ", "text": "ありがと。"},
        { "location": "379/ACT"   , "narrator": "", "text": "アーヤの事は守る"},
        { "location": "380/TALK"  , "narrator": "アーヤ", "text": "宜しくお願いね。\n信じてるから。"},
        { "location": "386/SEL"   , "narrator": "", "text": "これは！？"},
        { "location": "387/ACT"   , "narrator": "", "text": "これは！？"},
        { "location": "389/TALK"  , "narrator": "アーヤ", "text": "早速お出ましみたいね。"},
        { "location": "392/TALK"  , "narrator": "アーヤ", "text": "私を消しに、契約主の\n眷属のクランがここに\n来ているみたい。"},
        { "location": "394/TALK"  , "narrator": "アーヤ", "text": "ここは私が対応するから\n貴方は早く現実に戻って。"},
        { "location": "395/SEL"   , "narrator": "", "text": "さすがにそれは…"},
        { "location": "396/SEL"   , "narrator": "", "text": "アーヤを守るんだ！"},
        { "location": "397/ACT"   , "narrator": "", "text": "さすがにそれは…"},
        { "location": "398/TALK"  , "narrator": "アーヤ", "text": "…そう？\nそれじゃ、もしよかったら\n手伝ってくれる？"},
        { "location": "399/ACT"   , "narrator": "", "text": "アーヤを守るんだ！"},
        { "location": "400/TALK"  , "narrator": "アーヤ", "text": "ふふ…ありがと。\nとっても嬉しい。"},
        { "location": "401/TALK"  , "narrator": "アーヤ", "text": "それじゃ、もしよかったら\n手伝ってくれる？"},
        { "location": "403/TALK"  , "narrator": "アーヤ", "text": "カッコイイ事言ったけど\n本当はとても怖い。\n震えが止まらないの。"},
        { "location": "404/TALK"  , "narrator": "アーヤ", "text": "だから、貴方がいてくれて\n本当に嬉しい。"},
        { "location": "405/TALK"  , "narrator": "アーヤ", "text": "今攻めてきているクランを\n撃退するのだけ、手伝って\nくれると嬉しいかな。"},
        { "location": "406/TALK"  , "narrator": "アーヤ", "text": "それ以上は、貴方に迷惑を\nかけられない。"},
        { "location": "407/TALK"  , "narrator": "アーヤ", "text": "貴方には、私の総体を\nずっと護り続けて\n欲しいから。"},
        { "location": "408/SEL"   , "narrator": "", "text": "もちろん"},
        { "location": "409/SEL"   , "narrator": "", "text": "できる限りは"},
        { "location": "410/ACT"   , "narrator": "", "text": "もちろん"},
        { "location": "411/ACT"   , "narrator": "", "text": "できる限りは"},
        { "location": "413/TALK"  , "narrator": "アーヤ", "text": "…嬉しい。\n本当に何から何まで……。"},
        { "location": "414/TALK"  , "narrator": "アーヤ", "text": "大好きよ。\n$handle$…。"},
        { "location": "415/TALK"  , "narrator": "アーヤ", "text": "最後に１つ。\n私の名前だけ、どうか\n覚えていって欲しい。"},
        { "location": "416/TALK"  , "narrator": "アーヤ", "text": "私の名前は、\nエヴェレット・\nクラウスナー。"},
        { "location": "417/TALK"  , "narrator": "アーヤ", "text": "どうか、忘れないで。"},
        { "location": "418/TALK"  , "narrator": "アーヤ", "text": "それじゃ、\n準備はいい？"},
        { "location": "419/SEL"   , "narrator": "", "text": "オーケー"},
        { "location": "420/ACT"   , "narrator": "", "text": "オーケー"},
        { "location": "422/TALK"  , "narrator": "アーヤ", "text": "行きます！"},
        { "location": "47/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>8月19日　 11:28 PM</color>\n合宿中、みやびの実家でのこと"},
        { "location": "146/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "148/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "150/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "152/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "154/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "235/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:Message】</color>\n\n【エヴェレット】様から\nメッセージが届いています。"},
        { "location": "236/DIALOG", "narrator": "INFO", "text": "<color=green>【PN:エヴェレット】(1/1)</color>\n\n$handle$さん\n\nお元気ですか？　元司書です。\n準備が整いました。\n今からこちらからリモート操作して到着する扉を変えます。\n\n恐らくその司書はすぐに気づくと思いますから、止められる前に飛び込んでください。"},
