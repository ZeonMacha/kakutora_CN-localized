{
    "dir": "chap00/daydra/spev_ch04_003.js",
    "type": "",
    "info": {
        "story_id": "4003",
        "cid": "",
        "title": "スペシャルエピソード",
        "sub_title": "美味しく食べるのが一番"
    },
    "entry":
    [
        { "location": "23/TALK" , "narrator": "透明みやび", "text": "むぐむぐ…。\nしっかし不思議な\n話やねぇ。"},
        { "location": "24/TALK" , "narrator": "透明みやび", "text": "どうってことない\n味付けのこーんな\n食べ物も――"},
        { "location": "25/TALK" , "narrator": "透明みやび", "text": "祭りで食べると\n不思議と美味しく\n感じられてしまう。"},
        { "location": "28/TALK" , "narrator": "透明みやび", "text": "これはあれやね。\n一種の催眠状態に\nあるゆうことか？"},
        { "location": "29/TALK" , "narrator": "透明みやび", "text": "つまりお祭りは\nフェノメノンの中と\n似ていると結論する。"},
        { "location": "30/TALK" , "narrator": "透明つばめ", "text": "なるほどぉ。\n言われてみると\nそんな感じしますね！"},
        { "location": "32/TALK" , "narrator": "透明みやび", "text": "…つばめちゃん、\nまっこと詐欺には\n気をつけてな。"},
        { "location": "34/TALK" , "narrator": "透明つばめ", "text": "え？　それって\nどういう――"},
        { "location": "36/TALK" , "narrator": "透明つばめ", "text": "って、みやびさん！\n胸元が大変なことに\nなってます！"},
        { "location": "38/TALK" , "narrator": "透明みやび", "text": "うむ、少し前に\nまた成長の兆しを\n見せよって――"},
        { "location": "39/TALK" , "narrator": "透明つばめ", "text": "違います！\n見えちゃいそう\nってことです！"},
        { "location": "41/TALK" , "narrator": "透明つばめ", "text": "すみません、\n直しますね！"},
        { "location": "45/TALK" , "narrator": "透明みやび", "text": "んっ…すまんなぁ。\n手間かけさせて。"},
        { "location": "47/TALK" , "narrator": "透明みやび", "text": "美味いもん食べると、\n自然とずり落ちて\nくるがよ。"},
        { "location": "48/TALK" , "narrator": "透明つばめ", "text": "…ちょっと、\n食べ過ぎな気が\nするんですけど…。"},
        { "location": "49/TALK" , "narrator": "透明みやび", "text": "美味いもんは\nたらふく食わんと\n勿体ないちや。"},
        { "location": "50/TALK" , "narrator": "透明つばめ", "text": "けど、体重増えちゃい\nますよ？"},
        { "location": "51/TALK" , "narrator": "透明みやび", "text": "確かに、食べれば\nおデブさんになる\nリスクはある。"},
        { "location": "52/TALK" , "narrator": "透明みやび", "text": "けんど、食べんと\n人は大きくなれん\nぞね。"},
        { "location": "53/TALK" , "narrator": "透明つばめ", "text": "大きく、ですか？"},
        { "location": "54/TALK" , "narrator": "透明みやび", "text": "そうや。\nつばめちゃんは\nまだ成長期やき――"},
        { "location": "56/TALK" , "narrator": "透明みやび", "text": "しっかり食べんと\n大きくなれんよ。"},
        { "location": "57/TALK" , "narrator": "透明つばめ", "text": "…みやびさんは、\nいっぱい食べたから\n大きいんですね？"},
        { "location": "58/TALK" , "narrator": "透明みやび", "text": "？　うちはそんなに\n食わんき、大きくは\nないやろ。"},
        { "location": "59/TALK" , "narrator": "透明つばめ", "text": "大きいですよ！"},
        { "location": "62/TALK" , "narrator": "透明みやび", "text": "？　そうかぁ？"},
        { "location": "63/SEL"  , "narrator": "（選択肢）", "text": "何の話かわかってる？"},
        { "location": "64/ACT"  , "narrator": "", "text": "何の話か分かってる？"},
        { "location": "71/TALK" , "narrator": "みやび", "text": "わからん"},
        { "location": "73/TALK" , "narrator": "みやび", "text": "わからんなぁ"},
        { "location": "74/TALK" , "narrator": "みやび", "text": "何のことをトークってるのか"},
        { "location": "75/TALK" , "narrator": "みやび", "text": "どうぞうちに教えてプリーズ"},
        { "location": "76/SEL"  , "narrator": "（選択肢）", "text": "態度のことだよ"},
        { "location": "77/SEL"  , "narrator": "（選択肢）", "text": "身長のことだよ"},
        { "location": "78/SEL"  , "narrator": "（選択肢）", "text": "胸のことだよ"},
        { "location": "79/ACT"  , "narrator": "", "text": "態度のことだよ"},
        { "location": "80/TALK" , "narrator": "みやび", "text": "なるほどなるほど"},
        { "location": "81/TALK" , "narrator": "みやび", "text": "そんなわけあるか！"},
        { "location": "83/TALK" , "narrator": "みやび", "text": "胸の話以外にあるわけない！"},
        { "location": "85/TALK" , "narrator": "みやび", "text": "ここぞとばかりに悪口を言うとは"},
        { "location": "87/TALK" , "narrator": "みやび", "text": "相棒はワルと見た"},
        { "location": "88/ACT"  , "narrator": "", "text": "身長のことだよ"},
        { "location": "89/TALK" , "narrator": "みやび", "text": "つばめちゃんよりはデカいな"},
        { "location": "90/TALK" , "narrator": "みやび", "text": "しかし相棒は初心すぎる"},
        { "location": "91/TALK" , "narrator": "みやび", "text": "つばめちゃんが言うてるのは"},
        { "location": "92/TALK" , "narrator": "みやび", "text": "胸の話であろう"},
        { "location": "94/TALK" , "narrator": "みやび", "text": "胸、おっぱい、バスト、わかるか？"},
        { "location": "95/ACT"  , "narrator": "", "text": "胸のことだよ"},
        { "location": "96/TALK" , "narrator": "みやび", "text": "恥じらいもなくハッキリ言うとは"},
        { "location": "98/TALK" , "narrator": "みやび", "text": "嫌いではない"},
        { "location": "99/TALK" , "narrator": "みやび", "text": "むしろ好感度アップアップ"},
        { "location": "100/TALK", "narrator": "みやび", "text": "溺れているわけではない"},
        { "location": "103/TALK", "narrator": "みやび", "text": "つばめちゃんはアレか？"},
        { "location": "104/TALK", "narrator": "みやび", "text": "大きくなる方法知りたい？"},
        { "location": "106/TALK", "narrator": "みやび", "text": "そう思うてえいのだろうか？"},
        { "location": "107/TALK", "narrator": "みやび", "text": "だとすると"},
        { "location": "108/TALK", "narrator": "みやび", "text": "止めないといかんな"},
        { "location": "109/SEL" , "narrator": "（選択肢）", "text": "どうして？"},
        { "location": "110/ACT" , "narrator": "", "text": "どうして？"},
        { "location": "112/TALK", "narrator": "みやび", "text": "胸は脂肪である"},
        { "location": "113/TALK", "narrator": "みやび", "text": "一般的に女性は脂肪がつくことを良しとしない"},
        { "location": "114/TALK", "narrator": "みやび", "text": "肥満を嫌うからである"},
        { "location": "115/TALK", "narrator": "みやび", "text": "故にうちには止める義務がある"},
        { "location": "116/TALK", "narrator": "みやび", "text": "つばめちゃんの涙は見たくない！"},
        { "location": "118/TALK", "narrator": "みやび", "text": "↑（かっこえいと思うたなら拍手）"},
        { "location": "121/SEL" , "narrator": "（選択肢）", "text": "胸はそれでいいの！"},
        { "location": "122/SEL" , "narrator": "（選択肢）", "text": "みやびのそういうところ好きだなぁ"},
        { "location": "123/SEL" , "narrator": "（選択肢）", "text": "パチパチパチ！！"},
        { "location": "124/ACT" , "narrator": "", "text": "胸はそれでいいの！"},
        { "location": "125/TALK", "narrator": "みやび", "text": "かもしれん"},
        { "location": "126/TALK", "narrator": "みやび", "text": "しかしちくっと考えてほしい"},
        { "location": "127/TALK", "narrator": "みやび", "text": "胸も贅肉も脂肪に違いはなく"},
        { "location": "128/TALK", "narrator": "みやび", "text": "胸より腹やら腕やら足やら尻に付く"},
        { "location": "129/SEL" , "narrator": "（選択肢）", "text": "夢がないよ！"},
        { "location": "130/ACT" , "narrator": "", "text": "夢がないよ！"},
        { "location": "132/TALK", "narrator": "みやび", "text": "リアルの話やき"},
        { "location": "133/TALK", "narrator": "みやび", "text": "ドリームに惑わされてはいかん"},
        { "location": "134/TALK", "narrator": "みやび", "text": "ＯＫ？"},
        { "location": "135/ACT" , "narrator": "", "text": "みやびのそういうところ好きだなぁ"},
        { "location": "136/TALK", "narrator": "みやび", "text": "趣味悪っ！？"},
        { "location": "138/TALK", "narrator": "みやび", "text": "改善すべきと提案する"},
        { "location": "139/TALK", "narrator": "みやび", "text": "まあ"},
        { "location": "140/TALK", "narrator": "みやび", "text": "でないとうちのようなヘンテコ娘"},
        { "location": "141/TALK", "narrator": "みやび", "text": "とっくに切り捨てられてたか"},
        { "location": "142/TALK", "narrator": "みやび", "text": "そう考えると"},
        { "location": "143/TALK", "narrator": "みやび", "text": "趣味悪くてありがとう"},
        { "location": "144/TALK", "narrator": "みやび", "text": "こう言うべきか？"},
        { "location": "145/ACT" , "narrator": "", "text": "パチパチパチ！！"},
        { "location": "146/TALK", "narrator": "みやび", "text": "盛大な拍手に感謝感激"},
        { "location": "148/TALK", "narrator": "みやび", "text": "とはいえ"},
        { "location": "149/TALK", "narrator": "みやび", "text": "文字で拍手されても嬉しくはない"},
        { "location": "152/TALK", "narrator": "みやび", "text": "しっかし"},
        { "location": "153/TALK", "narrator": "みやび", "text": "女の胸は大きい方がえいものなのだろうか？"},
        { "location": "154/TALK", "narrator": "みやび", "text": "趣味は人それぞれというが"},
        { "location": "155/TALK", "narrator": "みやび", "text": "相棒はその辺どうなが？"},
        { "location": "156/SEL" , "narrator": "（選択肢）", "text": "大きい方が好きです"},
        { "location": "157/SEL" , "narrator": "（選択肢）", "text": "ペッタンコ万歳！！"},
        { "location": "158/SEL" , "narrator": "（選択肢）", "text": "あまり考えたことがない"},
        { "location": "159/ACT" , "narrator": "", "text": "大きい方が好きです"},
        { "location": "160/TALK", "narrator": "みやび", "text": "スケベな正直は良いスケベ"},
        { "location": "161/TALK", "narrator": "みやび", "text": "つまり相棒は良いスケベ"},
        { "location": "162/TALK", "narrator": "みやび", "text": "誇りに思ってえいよ"},
        { "location": "163/TALK", "narrator": "みやび", "text": "少なくとも"},
        { "location": "164/TALK", "narrator": "みやび", "text": "うちは嫌いじゃない"},
        { "location": "165/ACT" , "narrator": "", "text": "ペッタンコ万歳！！"},
        { "location": "168/TALK", "narrator": "みやび", "text": "危険人物認定に十分な発言やね"},
        { "location": "169/TALK", "narrator": "みやび", "text": "まあ"},
        { "location": "170/TALK", "narrator": "みやび", "text": "うちもペッタンコに憧れはするが"},
        { "location": "171/ACT" , "narrator": "", "text": "あまり考えたことがない"},
        { "location": "174/TALK", "narrator": "みやび", "text": "それはそれで不健全極まりないな"},
        { "location": "175/TALK", "narrator": "みやび", "text": "まあ興味は人それぞれ"},
        { "location": "176/TALK", "narrator": "みやび", "text": "胸やなくて尻に興味があるのかもしれんが"},
        { "location": "177/TALK", "narrator": "みやび", "text": "いずれ詳しく聞きだすとしよう"},
        { "location": "179/TALK", "narrator": "みやび", "text": "では"},
        { "location": "180/TALK", "narrator": "みやび", "text": "たまには上品に別れの挨拶"},
        { "location": "182/TALK", "narrator": "みやび", "text": "ウフフごきげんよう"},
        { "location": "184/TALK", "narrator": "透明みやび", "text": "…………。"},
        { "location": "186/TALK", "narrator": "透明みやび", "text": "まあ、つばめちゃんの\n気持ちもわかる\nけんど――"},
        { "location": "188/TALK", "narrator": "透明みやび", "text": "体重が増えるっちゅう\n心配は、増えてから\nすればえいがよ。"},
        { "location": "189/TALK", "narrator": "透明みやび", "text": "今はお互い肥満体系や\nないんやし――"},
        { "location": "190/TALK", "narrator": "透明みやび", "text": "美味いもんを楽しく\n食わんと、勿体ない\nぞね。"},
        { "location": "192/TALK", "narrator": "透明つばめ", "text": "…かっこいいけど、\nマネする勇気\nありませんよぉ…。"}
    ]
}
