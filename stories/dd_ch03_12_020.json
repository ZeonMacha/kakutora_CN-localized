{
    "dir": "chap12/daydra/dd_ch03_12_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "12356",
        "cid": "gabriella",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "みんなのお友達は？"
    },
    "entry":
    [
        { "location": "235/SCENARIO", "narrator": "", "text": "みんなのお友達は？"},
        { "location": "258/TALK"    , "narrator": "雛", "text": "キリトー、そこのゴミを\n外に出しといてー。"},
        { "location": "260/TALK"    , "narrator": "キリト", "text": "すっげぇ量あるな…\nヒカル、手伝ってくれ。"},
        { "location": "262/TALK"    , "narrator": "ヒカル", "text": "わかりました。"},
        { "location": "263/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "271/TALK"    , "narrator": "つばめ", "text": "ガブちゃん、\nどうかしたんですか？"},
        { "location": "272/TALK"    , "narrator": "ガブリエラ", "text": "別に…ただ、ここも\n賑やかになったな、って\n思っただけ。"},
        { "location": "273/TALK"    , "narrator": "ガブリエラ", "text": "っていうか、\nつばめって\n結構友達多いのね？"},
        { "location": "274/TALK"    , "narrator": "つばめ", "text": "そう言ってもらえると\n嬉しいな。"},
        { "location": "276/TALK"    , "narrator": "つばめ", "text": "みんな、わたしの\n自慢のお友達だから。"},
        { "location": "277/TALK"    , "narrator": "つばめ", "text": "そういえば、\nガブちゃんの\nお友達は？"},
        { "location": "278/TALK"    , "narrator": "ガブリエラ", "text": "あ、あたしの友達！？"},
        { "location": "279/TALK"    , "narrator": "つばめ", "text": "はい！"},
        { "location": "280/TALK"    , "narrator": "ガブリエラ", "text": "友達、友達ね…。\nえーっと…。"},
        { "location": "281/SEL"     , "narrator": "", "text": "いる、とだけ答えておこう"},
        { "location": "282/SEL"     , "narrator": "", "text": "ちょっと待って考える"},
        { "location": "283/SEL"     , "narrator": "", "text": "$me$を友達だと思って"},
        { "location": "286/TALK"    , "narrator": "ガブリエラ", "text": "ど、どうしよう。"},
        { "location": "287/TALK"    , "narrator": "ガブリエラ", "text": "まさかいないなんて\n言えるわけないし…。"},
        { "location": "289/TALK"    , "narrator": "つばめ", "text": "ガブちゃん？"},
        { "location": "291/TALK"    , "narrator": "ガブリエラ", "text": "これ以上黙ってたら、\nさすがに怪しく\n思われるかも…。"},
        { "location": "296/TALK"    , "narrator": "雛", "text": "何で悩んじゃうかなー？\nそんなの、超簡単じゃん。"},
        { "location": "298/TALK"    , "narrator": "ガブリエラ", "text": "ど、どういう意味？"},
        { "location": "299/TALK"    , "narrator": "雛", "text": "あたし達を指差して、\nあんな友達、って言えば\nそれでＯＫでしょ？"},
        { "location": "301/TALK"    , "narrator": "ガブリエラ", "text": "えっ……。"},
        { "location": "302/TALK"    , "narrator": "雛", "text": "だって、あたし達だって\nガブリエラちゃんの\n友達なんだし。ね？"},
        { "location": "306/TALK"    , "narrator": "キリト", "text": "おう、当然じゃん！"},
        { "location": "308/TALK"    , "narrator": "ヒカル", "text": "ひなこさんの\n言うとおりですよ。"},
        { "location": "311/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "312/TALK"    , "narrator": "雛", "text": "あれ？　どうかしたの？"},
        { "location": "313/TALK"    , "narrator": "ガブリエラ", "text": "あ…あたし、向こうで\n仕事があるから！"},
        { "location": "321/TALK"    , "narrator": "つばめ", "text": "あ、ガブちゃん？"},
        { "location": "331/TALK"    , "narrator": "ガブリエラ", "text": "はぁ、はぁ…ふぅ…。"},
        { "location": "333/TALK"    , "narrator": "ガブリエラ", "text": "危なかった…涙出ちゃう\nところだったわ…。"},
        { "location": "335/TALK"    , "narrator": "ガブリエラ", "text": "でも、そっか…。\nひなこ達は、\nあたしのお友達なんだ。"},
        { "location": "337/ACT"     , "narrator": "", "text": "いる、とだけ答えておこう"},
        { "location": "357/TALK"    , "narrator": "ガブリエラ", "text": "そっけなく答える作戦ね"},
        { "location": "358/TALK"    , "narrator": "ガブリエラ", "text": "さすがはマルザンナ、頼りになるわ♪"},
        { "location": "369/TALK"    , "narrator": "ガブリエラ", "text": "友達ならいるわ。"},
        { "location": "371/TALK"    , "narrator": "つばめ", "text": "…はい？"},
        { "location": "372/TALK"    , "narrator": "ガブリエラ", "text": "だから、友達はいるから。\nわかった？"},
        { "location": "374/TALK"    , "narrator": "つばめ", "text": "えっと…どういう人達\nなのかを知りたいん\nだけど…。"},
        { "location": "375/TALK"    , "narrator": "ガブリエラ", "text": "し、しまった！\nこれじゃ答えになって\nないじゃない！"},
        { "location": "376/TALK"    , "narrator": "ガブリエラ", "text": "マルザンナへの聞き方が\n間違ってたみたい。\nうー、どうしよう…。"},
        { "location": "377/TALK"    , "narrator": "つばめ", "text": "えっと、ガブちゃん？"},
        { "location": "378/TALK"    , "narrator": "ガブリエラ", "text": "…ふ、普通よ。"},
        { "location": "379/TALK"    , "narrator": "ガブリエラ", "text": "別に、特に変わったところ\nなんてない、普通の友達\nしかいないの！"},
        { "location": "380/TALK"    , "narrator": "ガブリエラ", "text": "じゃあ、あたしは向こうで\n仕事があるから！"},
        { "location": "381/TALK"    , "narrator": "ガブリエラ", "text": "友達がいないってこと、\nバレてないかしら？"},
        { "location": "388/TALK"    , "narrator": "つばめ", "text": "普通の友達かぁ…。"},
        { "location": "390/TALK"    , "narrator": "つばめ", "text": "ひなこちゃん達みたいな、\nキャラの濃い子達じゃ\nない、ってことかな？"},
        { "location": "391/ACT"     , "narrator": "", "text": "ちょっと待って考える"},
        { "location": "399/TALK"    , "narrator": "ガブリエラ", "text": "まさか、マルザンナ！？\n何かいい方法があるの？"},
        { "location": "400/TALK"    , "narrator": "ガブリエラ", "text": "ちょっと待って。\n今、ＷＡＶＥが来た\nみたいだから。"},
        { "location": "414/TALK"    , "narrator": "ガブリエラ", "text": "考えてから言ってきて！"},
        { "location": "415/TALK"    , "narrator": "ガブリエラ", "text": "何か良い方法があるのかと思って期待したのに…"},
        { "location": "416/TALK"    , "narrator": "ガブリエラ", "text": "もういいわ、自分で考える！"},
        { "location": "428/TALK"    , "narrator": "ガブリエラ", "text": "とは言ったものの、\nなんて答えようかしら…。"},
        { "location": "431/TALK"    , "narrator": "雛", "text": "何で悩んじゃうかなー？\nそんなの、超簡単じゃん。"},
        { "location": "433/TALK"    , "narrator": "ガブリエラ", "text": "ど、どういう意味？"},
        { "location": "434/TALK"    , "narrator": "雛", "text": "あたし達を指差して、\nあんな友達、って言えば\nそれでＯＫでしょ？"},
        { "location": "436/TALK"    , "narrator": "ガブリエラ", "text": "えっ……。"},
        { "location": "437/TALK"    , "narrator": "雛", "text": "だって、あたし達だって\nガブリエラちゃんの\n友達なんだし。ね？"},
        { "location": "441/TALK"    , "narrator": "キリト", "text": "おう、当然じゃん！"},
        { "location": "443/TALK"    , "narrator": "ヒカル", "text": "ひなこさんの\n言うとおりですよ。"},
        { "location": "446/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "447/TALK"    , "narrator": "雛", "text": "あれ？　どうかしたの？"},
        { "location": "448/TALK"    , "narrator": "ガブリエラ", "text": "あ…あたし、向こうで\n仕事があるから！"},
        { "location": "456/TALK"    , "narrator": "つばめ", "text": "あ、ガブちゃん！？"},
        { "location": "466/TALK"    , "narrator": "ガブリエラ", "text": "はぁ、はぁ…ふぅ…。"},
        { "location": "468/TALK"    , "narrator": "ガブリエラ", "text": "危なかった…涙出ちゃう\nところだったわ…。"},
        { "location": "470/TALK"    , "narrator": "ガブリエラ", "text": "でも、そっか…。\nひなこ達は、\nあたしのお友達なんだ。"},
        { "location": "471/TALK"    , "narrator": "ガブリエラ", "text": "あとでマルザンナに\n自慢しちゃお。"},
        { "location": "488/ACT"     , "narrator": "", "text": "$me$を友達だと思って"},
        { "location": "495/TALK"    , "narrator": "ガブリエラ", "text": "っ！？　そうだ！！"},
        { "location": "496/TALK"    , "narrator": "ガブリエラ", "text": "私の友達は、凄く素敵で\n頼りになる人なの。"},
        { "location": "497/TALK"    , "narrator": "ガブリエラ", "text": "相談にも乗ってくれるし、\n秘密を打ち明けたりも\nできる――"},
        { "location": "498/TALK"    , "narrator": "ガブリエラ", "text": "とっても素敵な人よ。"},
        { "location": "499/TALK"    , "narrator": "つばめ", "text": "…何だか、\n凄い人なんですね。"},
        { "location": "503/TALK"    , "narrator": "雛", "text": "っていうか、それ誰？\nすっごく気になるよー！"},
        { "location": "505/TALK"    , "narrator": "ガブリエラ", "text": "ちょ、いきなり話に\n混ざらないでよ！"},
        { "location": "506/TALK"    , "narrator": "雛", "text": "ガブリエラちゃんに\nそこまで言わせるような\n友達がいるなんて――"},
        { "location": "508/TALK"    , "narrator": "雛", "text": "そんなの聞いたら\n気になっちゃうって。\n二人もそう思うでしょ？"},
        { "location": "514/TALK"    , "narrator": "キリト", "text": "当然だろ。\nマジでどんなヤツなんだ？"},
        { "location": "516/TALK"    , "narrator": "ヒカル", "text": "一度、僕らもお会いして\nみたいです。"},
        { "location": "517/TALK"    , "narrator": "ガブリエラ", "text": "えぇっ！？\nそ、そう言われても…。"},
        { "location": "519/TALK"    , "narrator": "雛", "text": "まあ、無理にとは言わない\nけど、いつかは紹介して\nもらえると嬉しいなぁ。"},
        { "location": "522/TALK"    , "narrator": "ガブリエラ", "text": "あ、あはは…\n考えとくわ。"},
        { "location": "524/TALK"    , "narrator": "ガブリエラ", "text": "…多分、無理だろうけど。"},
        { "location": "538/TALK"    , "narrator": "ガブリエラ", "text": "やっぱり、あなただったのね！"},
        { "location": "539/TALK"    , "narrator": "ガブリエラ", "text": "スマホが震えた瞬間、あなたのことを思い出したわ"},
        { "location": "540/TALK"    , "narrator": "ガブリエラ", "text": "マルザンナは私の、秘密のお友達だものね"},
        { "location": "541/TALK"    , "narrator": "ガブリエラ", "text": "ありがと、マルザンナ///"},
        { "location": "246/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>7月2日　10:12 AM</color>\nとある初夏の週末、神楽坂トライナリー劇場にて。"},
        { "location": "482/DIALOG"  , "narrator": "Dialog_GEThimegoto_ch03", "text": "【秘密はここだけ】"}
    ]
}
