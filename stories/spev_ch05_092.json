        "title": "ぴょんこのサマー大作戦♪",
        "sub_title": "ぴょんこのサマー大作戦♪⑤【神楽編】"
    },
    "entry":
    [
        { "location": "20/DIALOG" , "narrator": "", "text": "<color=green>本イベントは\n<color=red>2017年7月12日～8月16日</color>に\n配信されたものです。</color>\n\nイベント内で告知されている内容、表示されるリンク先のページなどは配信当時のものとなっています。"},
        { "location": "21/DIALOG" , "narrator": "", "text": "<color=green>8月4日　1:21 PM</color>\nとある金曜日の午後、シャッツキステ店内にて。"},
        { "location": "22/TALK"   , "narrator": "神楽", "text": "…？"},
        { "location": "23/TALK"   , "narrator": "神楽", "text": "あっ！\n$handle$――"},
        { "location": "25/TALK"   , "narrator": "神楽", "text": "さん…ですね、まだ。"},
        { "location": "26/TALK"   , "narrator": "神楽", "text": "お久し振りです。\nお元気でしたか？"},
        { "location": "27/TALK"   , "narrator": "神楽", "text": "って、そっちからだと\n久し振りっていう程でも\nありませんよね。"},
        { "location": "28/SEL"    , "narrator": "（選択肢）", "text": "？？"},
        { "location": "29/ACT"    , "narrator": "", "text": "？？"},
        { "location": "31/TALK"   , "narrator": "神楽", "text": "いえ、いいんです！\n独り言ですから。"},
        { "location": "32/TALK"   , "narrator": "神楽", "text": "それより、今日はとても\n嬉しいことがあったから、\n貴方と共有したくて。"},
        { "location": "33/TALK"   , "narrator": "神楽", "text": "前に私、薄い本を\n書いてましたよね。"},
        { "location": "34/TALK"   , "narrator": "神楽", "text": "あの本、結局\nイベントには\n出さなかったんです。"},
        { "location": "35/SEL"    , "narrator": "（選択肢）", "text": "どうして！？"},
        { "location": "36/SEL"    , "narrator": "（選択肢）", "text": "ああ…お察しします"},
        { "location": "37/ACT"    , "narrator": "", "text": "どうして！？"},
        { "location": "38/TALK"   , "narrator": "神楽", "text": "2016年の夏。"},
        { "location": "39/TALK"   , "narrator": "神楽", "text": "つばめさんとこのお店に\n来た後、何があったか\n覚えてますか？"},
        { "location": "41/TALK"   , "narrator": "神楽", "text": "とてもそんなことを\nできる状況では\nなかったですよね。"},
        { "location": "42/TALK"   , "narrator": "神楽", "text": "ぴょんこ、\nさすがにそこまで\n精神図太くないので！"},
        { "location": "43/ACT"    , "narrator": "", "text": "ああ…お察しします"},
        { "location": "45/TALK"   , "narrator": "神楽", "text": "ふふ、さすがですね。"},
        { "location": "46/TALK"   , "narrator": "神楽", "text": "それでこそ、\n将来の――"},
        { "location": "48/TALK"   , "narrator": "神楽", "text": "って、そんなことは\nどうでもいいんです。"},
        { "location": "49/TALK"   , "narrator": "神楽", "text": "それでですね、\n色々考えたんですけど。"},
        { "location": "50/TALK"   , "narrator": "神楽", "text": "あの時の本を、やっぱり\nイベントで頒布することに\nしたんです。"},
        { "location": "51/SEL"    , "narrator": "（選択肢）", "text": "おめでとう！"},
        { "location": "52/ACT"    , "narrator": "", "text": "おめでとう！"},
        { "location": "54/TALK"   , "narrator": "神楽", "text": "ふふ。\nありがとうございます！"},
        { "location": "55/TALK"   , "narrator": "神楽", "text": "で、せっかくだから、\n貴方にも見てもらえたら、\nって思っていて…"},
        { "location": "56/TALK"   , "narrator": "神楽", "text": "色々方法を模索して\nいたんですけど！"},
        { "location": "57/TALK"   , "narrator": "神楽", "text": "みやびさんや、とある人が\n協力してくれて、それが\n叶っちゃいました！"},
        { "location": "58/SEL"    , "narrator": "（選択肢）", "text": "どういうこと！？"},
        { "location": "59/ACT"    , "narrator": "", "text": "どういうこと！？"},
        { "location": "61/TALK"   , "narrator": "神楽", "text": "$handle$さんの\n世界のコミックイベントで\n委託頒布しちゃいます！"},
        { "location": "62/SEL"    , "narrator": "（選択肢）", "text": "えーー！！"},
        { "location": "63/SEL"    , "narrator": "（選択肢）", "text": "想像はしてた"},
        { "location": "64/ACT"    , "narrator": "", "text": "えーー！！"},
        { "location": "65/TALK"   , "narrator": "神楽", "text": "ふふっ！\n驚いてくれて嬉しいです！"},
        { "location": "66/TALK"   , "narrator": "神楽", "text": "私もとっても\nビックリしましたから。"},
        { "location": "67/ACT"    , "narrator": "", "text": "想像はしてた"},
        { "location": "68/TALK"   , "narrator": "神楽", "text": "え？\nそうなんですか？"},
        { "location": "69/TALK"   , "narrator": "神楽", "text": "もしかして\n$handle$さんって\nエスパーですか？"},
        { "location": "70/TALK"   , "narrator": "神楽", "text": "それとも、\nアカシックレコーダー\nだったりしません？"},
        { "location": "71/SEL"    , "narrator": "（選択肢）", "text": "じ、実は…"},
        { "location": "72/ACT"    , "narrator": "", "text": "じ、実は…"},
        { "location": "74/TALK"   , "narrator": "神楽", "text": "なーんちゃって！\n単なるマグレですよね。"},
        { "location": "76/TALK"   , "narrator": "神楽", "text": "とにかく！\nそういうわけですので！"},
        { "location": "77/TALK"   , "narrator": "神楽", "text": "もし興味あれば、\nイベントでお手にとって\nみてください！"},
        { "location": "79/TALK"   , "narrator": "神楽", "text": "当時の事なので、\n今見返すと、ちょっと\n恥ずかしいですけど……"},
        { "location": "80/TALK"   , "narrator": "神楽", "text": "でも、あの時の精一杯の\n全力だったことには\n間違いないので！"},
        { "location": "83/DIALOG" , "narrator": "", "text": "チラ見せ①"},
        { "location": "84/TALK"   , "narrator": "神楽", "text": "内容は、\n４コマとか――"},
        { "location": "86/DIALOG" , "narrator": "", "text": "チラ見せ②"},
        { "location": "87/TALK"   , "narrator": "神楽", "text": "みんなに協力してもらった\nショートストーリーとか。"},
        { "location": "89/DIALOG" , "narrator": "", "text": "チラ見せ③"},
        { "location": "91/TALK"   , "narrator": "神楽", "text": "あとは、寄せ書きなんかも\nあったりしますよ！"},
        { "location": "94/TALK"   , "narrator": "神楽", "text": "興味あったら、\n是非ぴょんこの黒歴史を\n堪能しちゃってください！"},
        { "location": "95/SEL"    , "narrator": "（選択肢）", "text": "自分で黒歴史言うんだ"},
        { "location": "96/ACT"    , "narrator": "", "text": "自分で黒歴史言うんだ"},
        { "location": "98/TALK"   , "narrator": "神楽", "text": "まあ実際、あと10年も\nすれば完璧に黒歴史です。"},
        { "location": "99/TALK"   , "narrator": "神楽", "text": "でもいいじゃないですか。\n今楽しくて\nやめられないならそれで。"},
        { "location": "100/TALK"  , "narrator": "神楽", "text": "それに――"},
        { "location": "101/TALK"  , "narrator": "神楽", "text": "手に取りたいと\n思った貴方は、\n同じ穴の狢ですよ？"},
        { "location": "102/TALK"  , "narrator": "神楽", "text": "そこは覚悟しておいた方が\nいいと思います♪"},
        { "location": "103/TALK"  , "narrator": "神楽", "text": "あとですね、\nもし読む機会があれば、\n是非感想もお願いします♪"},
        { "location": "104/TALK"  , "narrator": "神楽", "text": "同人作家にとっては、\n感想こそが次へのカテ\nですからね！"},
        { "location": "106/TALK"  , "narrator": "神楽", "text": "…っと。\nだいぶ長話を\nしちゃいましたね！"},
        { "location": "107/TALK"  , "narrator": "神楽", "text": "それじゃ、今回は\nこの辺で。"},
        { "location": "108/TALK"  , "narrator": "神楽", "text": "委託本を取りに行って\nくれる時は、熱中症に\n気をつけてくださいね！"},
        { "location": "109/DIALOG", "narrator": "", "text": "神楽の同人誌の\n詳細情報を見ますか？"}
    ]
}
