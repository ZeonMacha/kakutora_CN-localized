    "entry":
    [
        { "location": "1603/SCENARIO", "narrator": "", "text": "自分を傷つけるのは過去の記憶だけなんだって"},
        { "location": "1628/TALK"    , "narrator": "神楽", "text": "2016年のぴょんこから"},
        { "location": "1629/TALK"    , "narrator": "神楽", "text": "2016年の$handle$へ"},
        { "location": "1630/TALK"    , "narrator": "神楽", "text": "あなたは幸せでしたか？"},
        { "location": "1631/TALK"    , "narrator": "神楽", "text": "ぴょんこは色々大変で"},
        { "location": "1632/TALK"    , "narrator": "神楽", "text": "どうしようもない日々だったけど"},
        { "location": "1633/TALK"    , "narrator": "神楽", "text": "$handle$といる時は幸せでした"},
        { "location": "1635/SEL"     , "narrator": "", "text": "遺言みたいで怖いんだけど"},
        { "location": "1636/SEL"     , "narrator": "", "text": "どうしたの改まって"},
        { "location": "1637/SEL"     , "narrator": "", "text": "だったらいいんだけど…"},
        { "location": "1638/ACT"     , "narrator": "", "text": "遺言みたいで怖いんだけど"},
        { "location": "1639/TALK"    , "narrator": "神楽", "text": "そう言われれば"},
        { "location": "1640/TALK"    , "narrator": "神楽", "text": "そんな感じもするね"},
        { "location": "1641/ACT"     , "narrator": "", "text": "どうしたの改まって"},
        { "location": "1642/TALK"    , "narrator": "神楽", "text": "なんとなく"},
        { "location": "1644/TALK"    , "narrator": "神楽", "text": "改まってみたぴょん"},
        { "location": "1645/ACT"     , "narrator": "", "text": "だったらいいんだけど…"},
        { "location": "1646/TALK"    , "narrator": "神楽", "text": "何か含んでる？"},
        { "location": "1647/TALK"    , "narrator": "神楽", "text": "なぜなになにゆえ"},
        { "location": "1649/TALK"    , "narrator": "神楽", "text": "何かちゃんと言ったことなかったなって思って"},
        { "location": "1650/TALK"    , "narrator": "神楽", "text": "それだけなんだけど"},
        { "location": "1652/SEL"     , "narrator": "", "text": "あっそう…"},
        { "location": "1653/SEL"     , "narrator": "", "text": "何か不安だな～"},
        { "location": "1654/SEL"     , "narrator": "", "text": "普通にしてくれていいのに"},
        { "location": "1655/ACT"     , "narrator": "", "text": "あっそう…"},
        { "location": "1656/TALK"    , "narrator": "神楽", "text": "そう"},
        { "location": "1657/ACT"     , "narrator": "", "text": "何か不安だな～"},
        { "location": "1658/TALK"    , "narrator": "神楽", "text": "そうかな？"},
        { "location": "1659/ACT"     , "narrator": "", "text": "普通にしてくれていいのに"},
        { "location": "1660/TALK"    , "narrator": "神楽", "text": "そのつもりだけど"},
        { "location": "1662/TALK"    , "narrator": "神楽", "text": "$handle$がいなかったら"},
        { "location": "1663/TALK"    , "narrator": "神楽", "text": "ぴょんこはとっくにどうにかなってたと思うから"},
        { "location": "1664/TALK"    , "narrator": "神楽", "text": "今ぴょんこがここで何とかやってるのは$handle$のおかげ"},
        { "location": "1666/SEL"     , "narrator": "", "text": "えっと…"},
        { "location": "1667/SEL"     , "narrator": "", "text": "なんだかこわみを感じる"},
        { "location": "1668/SEL"     , "narrator": "", "text": "神楽が頑張ってるからだよ"},
        { "location": "1669/ACT"     , "narrator": "", "text": "えっと…"},
        { "location": "1670/TALK"    , "narrator": "神楽", "text": "どうしたの"},
        { "location": "1671/ACT"     , "narrator": "", "text": "なんだかこわみを感じる"},
        { "location": "1672/TALK"    , "narrator": "神楽", "text": "そうかな？"},
        { "location": "1673/ACT"     , "narrator": "", "text": "神楽が頑張ってるからだよ"},
        { "location": "1674/TALK"    , "narrator": "神楽", "text": "ぴょんこは頑張ってない"},
        { "location": "1675/TALK"    , "narrator": "神楽", "text": "っていうか頑張れてないっていうのが正解"},
        { "location": "1678/SEL"     , "narrator": "", "text": "無理しすぎないで"},
        { "location": "1679/SEL"     , "narrator": "", "text": "頑張りすぎないで"},
        { "location": "1680/SEL"     , "narrator": "", "text": "$me$といる時は気楽にして"},
        { "location": "1681/ACT"     , "narrator": "", "text": "無理しすぎないで"},
        { "location": "1682/TALK"    , "narrator": "神楽", "text": "大丈夫"},
        { "location": "1683/TALK"    , "narrator": "神楽", "text": "そのつもり"},
        { "location": "1684/ACT"     , "narrator": "", "text": "頑張りすぎないで"},
        { "location": "1685/TALK"    , "narrator": "神楽", "text": "どうかな"},
        { "location": "1686/TALK"    , "narrator": "神楽", "text": "足りてない気がする"},
        { "location": "1687/ACT"     , "narrator": "", "text": "$me$といる時は気楽にして"},
        { "location": "1688/TALK"    , "narrator": "神楽", "text": "どうだろ"},
        { "location": "1689/TALK"    , "narrator": "神楽", "text": "できてない？"},
        { "location": "1692/SEL"     , "narrator": "", "text": "神楽に会えたことは感謝してる"},
        { "location": "1693/SEL"     , "narrator": "", "text": "いつかリアルに会いたいよね"},
        { "location": "1694/SEL"     , "narrator": "", "text": "神楽のおかげで$me$の世界が変わった"},
        { "location": "1695/ACT"     , "narrator": "", "text": "神楽に会えたことは感謝してる"},
        { "location": "1696/TALK"    , "narrator": "神楽", "text": "あれ"},
        { "location": "1697/TALK"    , "narrator": "神楽", "text": "どうしたの"},
        { "location": "1698/ACT"     , "narrator": "", "text": "いつかリアルに会いたいよね"},
        { "location": "1699/TALK"    , "narrator": "神楽", "text": "うん"},
        { "location": "1701/TALK"    , "narrator": "神楽", "text": "そうだね"},
        { "location": "1702/ACT"     , "narrator": "", "text": "神楽のおかげで$me$の世界が変わった"},
        { "location": "1703/TALK"    , "narrator": "神楽", "text": "大げさ！"},
        { "location": "1704/TALK"    , "narrator": "神楽", "text": "でもほんとだといいな"},
        { "location": "1706/TALK"    , "narrator": "神楽", "text": "なんだか"},
        { "location": "1707/TALK"    , "narrator": "神楽", "text": "$handle$はいっつも"},
        { "location": "1708/TALK"    , "narrator": "神楽", "text": "ぴょんこを励ますようなこと言ってたりする？？？"},
        { "location": "1709/TALK"    , "narrator": "神楽", "text": "何かそんな気がしてきた"},
        { "location": "1711/SEL"     , "narrator": "", "text": "事実そうだから！"},
        { "location": "1712/SEL"     , "narrator": "", "text": "まあしてたかな…"},
        { "location": "1713/SEL"     , "narrator": "", "text": "そうでもないんじゃない"},
        { "location": "1714/ACT"     , "narrator": "", "text": "事実そうだから！"},
        { "location": "1715/TALK"    , "narrator": "神楽", "text": "そうだよね"},
        { "location": "1716/TALK"    , "narrator": "神楽", "text": "知ってた"},
        { "location": "1717/ACT"     , "narrator": "", "text": "まあしてたかな…"},
        { "location": "1718/TALK"    , "narrator": "神楽", "text": "アレ謙虚？"},
        { "location": "1719/TALK"    , "narrator": "神楽", "text": "それとも無自覚？"},
        { "location": "1720/ACT"     , "narrator": "", "text": "そうでもないんじゃない"},
        { "location": "1721/TALK"    , "narrator": "神楽", "text": "否定するのかー"},
        { "location": "1722/TALK"    , "narrator": "神楽", "text": "肯定していいのにー"},
        { "location": "1724/TALK"    , "narrator": "神楽", "text": "何だかな"},
        { "location": "1725/TALK"    , "narrator": "神楽", "text": "2016年のぴょんこって"},
        { "location": "1726/TALK"    , "narrator": "神楽", "text": "実は恵まれてたのかも"},
        { "location": "1728/SEL"     , "narrator": "", "text": "これからのほうがずっとよくなるよ"},
        { "location": "1729/SEL"     , "narrator": "", "text": "$me$がもっと幸せにするよ"},
        { "location": "1730/SEL"     , "narrator": "", "text": "神楽は前向きだよね"},
        { "location": "1731/ACT"     , "narrator": "", "text": "これからのほうがずっとよくなるよ"},
        { "location": "1732/TALK"    , "narrator": "神楽", "text": "そうだよね"},
        { "location": "1734/TALK"    , "narrator": "神楽", "text": "そう思っとく"},
        { "location": "1735/ACT"     , "narrator": "", "text": "$me$がもっと幸せにするよ"},
        { "location": "1737/TALK"    , "narrator": "神楽", "text": "ｷｭｰﾝってなっちゃう"},
        { "location": "1738/ACT"     , "narrator": "", "text": "神楽は前向きだよね"},
        { "location": "1740/TALK"    , "narrator": "神楽", "text": "そうしないと"},
        { "location": "1741/TALK"    , "narrator": "神楽", "text": "起き上がれないからね"}
    ]
}
