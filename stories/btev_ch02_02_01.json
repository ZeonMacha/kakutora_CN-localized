    "info": {
        "story_id": "60211",
        "cid": "ayami",
        "title": "己の敵は己＜葛藤＞",
        "sub_title": "バトル中盤"
    },
    "entry":
    [
        { "location": "280/SCENARIO", "narrator": "", "text": "バトル中盤"},
        { "location": "289/TALK"    , "narrator": "潜在アーヤ", "text": "…なかなかやるわね。"},
        { "location": "290/TALK"    , "narrator": "表層アーヤ", "text": "それくらい\n意志が硬いってことよ。"},
        { "location": "291/TALK"    , "narrator": "潜在アーヤ", "text": "もっと他のメンバーを\n信用して、任せても\nいいと思うんだけど。"},
        { "location": "292/TALK"    , "narrator": "表層アーヤ", "text": "そういう\n問題じゃない！"},
        { "location": "293/TALK"    , "narrator": "表層アーヤ", "text": "リーダーである私が\n行かなかったら……"},
        { "location": "294/TALK"    , "narrator": "潜在アーヤ", "text": "行かなかったら？"},
        { "location": "295/TALK"    , "narrator": "表層アーヤ", "text": "リーダーとしての\n責任感が欠如してると\n思われかねない。"},
        { "location": "296/TALK"    , "narrator": "潜在アーヤ", "text": "まあそうかもね。\nでも……"},
        { "location": "297/TALK"    , "narrator": "潜在アーヤ", "text": "今の貴方の言葉の中に\n本音がしっかり\nダダ漏れていたわよ。"},
        { "location": "298/TALK"    , "narrator": "表層アーヤ", "text": "え！？"},
        { "location": "299/TALK"    , "narrator": "潜在アーヤ", "text": "ううん、でもいいの。\nそれは私の守備範囲\nじゃないから。"},
        { "location": "300/TALK"    , "narrator": "潜在アーヤ", "text": "それより、\n次は絶対に負けない。"},
        { "location": "301/TALK"    , "narrator": "潜在アーヤ", "text": "とっておきの\n[クラン]を\n用意してあるし。"},
        { "location": "303/TALK"    , "narrator": "潜在アーヤ", "text": "絶対に勝って\n$handle$さんと\nデートするんだから。"},
        { "location": "304/TALK"    , "narrator": "表層アーヤ", "text": "させないわよ！"}
    ]
}
