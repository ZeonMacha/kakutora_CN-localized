        "title": "スペシャルエピソード",
        "sub_title": "襲来、はらぺこ狼女の恐怖"
    },
    "entry":
    [
        { "location": "26/TALK" , "narrator": "透明つばめ", "text": "がおーっ！！"},
        { "location": "30/TALK" , "narrator": "透明つばめ", "text": "食べちゃうぞー！！"},
        { "location": "32/SEL"  , "narrator": "（選択肢）", "text": "…………"},
        { "location": "33/ACT"  , "narrator": "", "text": "…………"},
        { "location": "36/TALK" , "narrator": "透明つばめ", "text": "あ、あれ？"},
        { "location": "39/TALK" , "narrator": "透明つばめ", "text": "がおがおーっ！！\n食べられたくなかったら\n食べ物を出せー！！"},
        { "location": "40/SEL"  , "narrator": "（選択肢）", "text": "何をやってるの？"},
        { "location": "41/SEL"  , "narrator": "（選択肢）", "text": "あはは、かわいいなぁ"},
        { "location": "42/ACT"  , "narrator": "", "text": "何をやってるの？"},
        { "location": "45/TALK" , "narrator": "透明つばめ", "text": "えぇっ！！\nこ、怖くないの？"},
        { "location": "46/TALK" , "narrator": "透明つばめ", "text": "わたし、狼だよ？\n狼女だよ！？\nがおがおがおーっ！！"},
        { "location": "47/ACT"  , "narrator": "", "text": "あはは、かわいいなぁ"},
        { "location": "49/TALK" , "narrator": "透明つばめ", "text": "えっ…そ、そうかな？\nえへへ…。"},
        { "location": "51/TALK" , "narrator": "透明つばめ", "text": "じゃなくって！\n怖くないの！？"},
        { "location": "53/TALK" , "narrator": "透明つばめ", "text": "ほら、狼だよ？\n狼女なんだよ！？\nがおーがおーっ！！"},
        { "location": "60/TALK" , "narrator": "透明つばめ", "text": "あわわっ！？"},
        { "location": "62/TALK" , "narrator": "透明つばめ", "text": "うぅぅ…、\nお、お腹空いたよぉ…。"},
        { "location": "63/TALK" , "narrator": "透明つばめ", "text": "さっきのカレー、\n我慢してでも食べれば\nよかったかも…。"},
        { "location": "64/SEL"  , "narrator": "（選択肢）", "text": "好き嫌いはダメ！"},
        { "location": "65/SEL"  , "narrator": "（選択肢）", "text": "美味しかったよ"},
        { "location": "66/ACT"  , "narrator": "", "text": "好き嫌いはダメ！"},
        { "location": "68/TALK" , "narrator": "透明つばめ", "text": "好き嫌いとかいう\n問題じゃないよ！"},
        { "location": "69/TALK" , "narrator": "透明つばめ", "text": "魔物除けを狼女の\nわたしが食べたら、\nお腹痛くなっちゃうの！"},
        { "location": "70/ACT"  , "narrator": "", "text": "美味しかったよ"},
        { "location": "72/TALK" , "narrator": "透明つばめ", "text": "わたしが逃げた後、\n普通に食べてたの！？"},
        { "location": "73/TALK" , "narrator": "透明つばめ", "text": "うぅぅぅぅ…ズルい！！"},
        { "location": "75/TALK" , "narrator": "透明つばめ", "text": "わたしだって狼女じゃ\nなかったら、あのカレー\n食べれたのに…。"},
        { "location": "83/TALK" , "narrator": "透明つばめ", "text": "よ、余計なお喋りは\nここまでだよ！"},
        { "location": "84/TALK" , "narrator": "透明つばめ", "text": "さあ、美味しいご飯を\nくれないと、あなたを\n食べちゃうぞー！"},
        { "location": "85/SEL"  , "narrator": "（選択肢）", "text": "どうぞどうぞ"},
        { "location": "86/SEL"  , "narrator": "（選択肢）", "text": "どうやって食べるの？"},
        { "location": "87/ACT"  , "narrator": "", "text": "どうぞどうぞ"},
        { "location": "90/TALK" , "narrator": "透明つばめ", "text": "えっ、いいの！？\nやったー！"},
        { "location": "91/TALK" , "narrator": "透明つばめ", "text": "それじゃあ遠慮なく――"},
        { "location": "92/TALK" , "narrator": "透明つばめ", "text": "って、あれ？"},
        { "location": "93/ACT"  , "narrator": "", "text": "どうやって食べるの？"},
        { "location": "95/TALK" , "narrator": "透明つばめ", "text": "どうやってって、\nもちろん――"},
        { "location": "96/TALK" , "narrator": "透明つばめ", "text": "…あ、あれ？"},
        { "location": "99/TALK" , "narrator": "透明つばめ", "text": "そういえば、\nわたしって人間食べたこと\nまだなかったんだ…。"},
        { "location": "100/TALK", "narrator": "透明つばめ", "text": "お父さんは、人間なんて\n頭からガブッといけば\nいい、って言ってたけど。"},
        { "location": "101/TALK", "narrator": "透明つばめ", "text": "でも…どう考えても\nわたしの口に入る\n大きさじゃないし…。"},
        { "location": "102/TALK", "narrator": "透明つばめ", "text": "食べやすい方法って、\nどんなのがあるのかな？"},
        { "location": "103/SEL" , "narrator": "（選択肢）", "text": "$me$に聞いてどうする？"},
        { "location": "104/ACT" , "narrator": "", "text": "$me$に聞いてどうする？"},
        { "location": "106/TALK", "narrator": "透明つばめ", "text": "そ、そうだよね…。\nうう、どうしよう…。"},
        { "location": "107/TALK", "narrator": "透明つばめ", "text": "っていうか、そもそも\nこんなところで食べるのも\nお行儀悪いし…。"},
        { "location": "109/TALK", "narrator": "透明つばめ", "text": "あ、そうだ！\n今からうちに来ない？"},
        { "location": "111/TALK", "narrator": "透明つばめ", "text": "お父さんもいるから、\nきっと美味しい料理に\nしてくれると思うよ！"},
        { "location": "112/SEL" , "narrator": "（選択肢）", "text": "行きません"},
        { "location": "113/ACT" , "narrator": "", "text": "行きません"},
        { "location": "117/TALK", "narrator": "透明つばめ", "text": "だ、だよねぇ…。"},
        { "location": "118/TALK", "narrator": "透明つばめ", "text": "はぁ…お腹空きすぎて\n頭働かないみたい…。"},
        { "location": "119/TALK", "narrator": "透明つばめ", "text": "わたし、もしかして\n狼女向いてないのかなぁ？"},
        { "location": "120/SEL" , "narrator": "（選択肢）", "text": "お菓子あるけど、食べる？"},
        { "location": "121/ACT" , "narrator": "", "text": "お菓子あるけど、食べる？"},
        { "location": "124/TALK", "narrator": "透明つばめ", "text": "えっ、\nお菓子持ってるの！？"},
        { "location": "125/SEL" , "narrator": "（選択肢）", "text": "$me$を食べないならあげる"},
        { "location": "126/SEL" , "narrator": "（選択肢）", "text": "食べたいならあげるよ"},
        { "location": "127/ACT" , "narrator": "", "text": "$me$を食べないならあげる"},
        { "location": "128/TALK", "narrator": "透明つばめ", "text": "う、うん！\n約束するよ！"},
        { "location": "129/TALK", "narrator": "透明つばめ", "text": "食べたことない人間より、\nお菓子の方がいいもん！"},
        { "location": "130/ACT" , "narrator": "", "text": "食べたいならあげるよ"},
        { "location": "131/TALK", "narrator": "透明つばめ", "text": "いいの！？\nありがとー！！"},
        { "location": "133/TALK", "narrator": "透明つばめ", "text": "あむっ…。"},
        { "location": "134/TALK", "narrator": "透明つばめ", "text": "わぁ、美味しい！"},
        { "location": "135/TALK", "narrator": "透明つばめ", "text": "こんなに美味しいお菓子、\n久しぶりに食べたかも。"},
        { "location": "136/TALK", "narrator": "透明つばめ", "text": "…こんなに美味しい\nお菓子持ってるなら…。"},
        { "location": "137/TALK", "narrator": "透明つばめ", "text": "あなたを食べるより、\nあなたからお菓子を\nもらう方がいいかも。"},
        { "location": "138/TALK", "narrator": "透明つばめ", "text": "人間より、お菓子の方が\n美味しいと思うし。"},
        { "location": "139/SEL" , "narrator": "（選択肢）", "text": "それがいいよ"},
        { "location": "140/ACT" , "narrator": "", "text": "それがいいよ"},
        { "location": "142/TALK", "narrator": "透明つばめ", "text": "うん、そうだよね！"},
        { "location": "143/TALK", "narrator": "透明つばめ", "text": "それじゃ、今日から\nあなたとわたしは\nお友達だよ。"},
        { "location": "145/TALK", "narrator": "透明つばめ", "text": "えへへ…、\nお菓子のこと、\nよろしくね。"}
    ]
}
