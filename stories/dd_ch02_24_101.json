{
    "dir": "chap24/daydra/dd_ch02_24_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "24202",
        "cid": "ayami",
        "title": "002 メインストーリー",
        "sub_title": "貴方を憂う手紙＜前編＞"
    },
    "entry":
    [
        { "location": "31/TALK"   , "narrator": "ガブリエラ", "text": "あーあ、\n午後からむぎまるで\n話し合いかぁ…。"},
        { "location": "32/TALK"   , "narrator": "アーヤ", "text": "気が乗らなそうね。"},
        { "location": "34/TALK"   , "narrator": "ガブリエラ", "text": "そりゃそうでしょ。"},
        { "location": "35/TALK"   , "narrator": "ガブリエラ", "text": "神楽が裏切っただけなら\nともかく、管理庁まで\n関わってたんだから。"},
        { "location": "37/TALK"   , "narrator": "ガブリエラ", "text": "正直、話し合って\nどうにかなるレベルの\nことじゃないわよ。"},
        { "location": "38/TALK"   , "narrator": "アーヤ", "text": "別に、今後の対策を\n練るだけが目的じゃ\nないわ。"},
        { "location": "39/TALK"   , "narrator": "アーヤ", "text": "話し合って、お互いの\n気持ちを確かめるのも\n大切なことよ。"},
        { "location": "41/TALK"   , "narrator": "ガブリエラ", "text": "気持ちねぇ…。"},
        { "location": "42/TALK"   , "narrator": "アーヤ", "text": "ええ…ギャヴィは\n卯月の裏切りを\n許せないと思ってる？"},
        { "location": "43/TALK"   , "narrator": "ガブリエラ", "text": "当然でしょ？"},
        { "location": "44/TALK"   , "narrator": "アーヤ", "text": "うん、そうよね。\n私もギャヴィと\n同じ気持ちよ。"},
        { "location": "45/TALK"   , "narrator": "アーヤ", "text": "…でも、つばめなら\nどう答えるかしら？"},
        { "location": "46/TALK"   , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "48/TALK"   , "narrator": "アーヤ", "text": "多分、許せない、\nなんて思わないんじゃ\nないかしら？"},
        { "location": "49/TALK"   , "narrator": "ガブリエラ", "text": "…だと思うわ。"},
        { "location": "50/TALK"   , "narrator": "ガブリエラ", "text": "天然でお人好しで、\nバカみたいに人のこと\n信じちゃうし。"},
        { "location": "51/TALK"   , "narrator": "ガブリエラ", "text": "しかも、神楽とは\n一番仲もよかったでしょ？"},
        { "location": "52/TALK"   , "narrator": "ガブリエラ", "text": "だから、敵として\n見るなんて、絶対に\nできないと思うわ。"},
        { "location": "53/TALK"   , "narrator": "ガブリエラ", "text": "てか、下手したら\n庇ったりするわよ？"},
        { "location": "54/TALK"   , "narrator": "アーヤ", "text": "…そうね。"},
        { "location": "56/TALK"   , "narrator": "アーヤ", "text": "私、つばめのそういう\nところって、嫌いじゃ\nないの。"},
        { "location": "57/TALK"   , "narrator": "アーヤ", "text": "どんな相手にも\n優しくできるのって、\n凄いことだと思うし。"},
        { "location": "58/TALK"   , "narrator": "ガブリエラ", "text": "悪いとことでも\nあると思うけど？"},
        { "location": "59/TALK"   , "narrator": "アーヤ", "text": "…わかってる。"},
        { "location": "60/TALK"   , "narrator": "アーヤ", "text": "でも、もし今つばめが\nそんな気持ちでいると\nしたら、それは問題よ。"},
        { "location": "61/TALK"   , "narrator": "アーヤ", "text": "下手をすれば、\n全滅の危機にも\nなりかねないんだし…。"},
        { "location": "62/TALK"   , "narrator": "アーヤ", "text": "だから、話し合いでは\nそのことをきっちりと\n言い聞かせたいの。"},
        { "location": "63/TALK"   , "narrator": "ガブリエラ", "text": "つばめに理解して\nもらうため？"},
        { "location": "64/TALK"   , "narrator": "アーヤ", "text": "そういうことよ。"},
        { "location": "65/TALK"   , "narrator": "ガブリエラ", "text": "…聞く耳持たないと\n思うけど？"},
        { "location": "68/TALK"   , "narrator": "アーヤ", "text": "だからって無視は\nできないでしょ？"},
        { "location": "69/TALK"   , "narrator": "アーヤ", "text": "あの子が卯月のことを\n大切に思ってるのは\nわかってる。"},
        { "location": "70/TALK"   , "narrator": "アーヤ", "text": "でも、卯月が今現在\n敵だってことも\n事実よ。"},
        { "location": "73/TALK"   , "narrator": "アーヤ", "text": "そんな相手のために、\n私たちは全滅する\nリスクを抱えられない。"},
        { "location": "74/TALK"   , "narrator": "アーヤ", "text": "無条件に\n卯月を信じたりする\nことはできない。"},
        { "location": "75/TALK"   , "narrator": "アーヤ", "text": "それは、しっかりと\nつばめに伝えないと\nいけないことよ。"},
        { "location": "76/TALK"   , "narrator": "ガブリエラ", "text": "…聞き入れてくれる\nとは思えないけど？"},
        { "location": "77/TALK"   , "narrator": "アーヤ", "text": "全部は無理でしょうね。"},
        { "location": "78/TALK"   , "narrator": "アーヤ", "text": "でも、それを伝えておく\nだけでも違うと思うわ。"},
        { "location": "79/TALK"   , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "80/TALK"   , "narrator": "アーヤ", "text": "どう思う？"},
        { "location": "81/TALK"   , "narrator": "ガブリエラ", "text": "…まあ、何もしないで\n全滅なんてのは\n嫌だしね。"},
        { "location": "83/TALK"   , "narrator": "ガブリエラ", "text": "やれるだけのことは\nやっておく、っていうのは\n賛成よ。"},
        { "location": "84/TALK"   , "narrator": "アーヤ", "text": "…よかった。"},
        { "location": "85/TALK"   , "narrator": "ガブリエラ", "text": "でも、無理だと思う\nって気持ちに\n変わりないけど。"},
        { "location": "86/TALK"   , "narrator": "アーヤ", "text": "わかってる。\n一緒に説得してくれる\nだけで十分よ。"},
        { "location": "87/TALK"   , "narrator": "ガブリエラ", "text": "はぁ…面倒だなぁ…。"},
        { "location": "88/TALK"   , "narrator": "ガブリエラ", "text": "…やっぱり、\nまほが帰ってくるの\n待った方がよくない？"},
        { "location": "89/TALK"   , "narrator": "アーヤ", "text": "…………。"},
        { "location": "90/TALK"   , "narrator": "ガブリエラ", "text": "え？　なによ。\nまさかまだ連絡が\n来ないの？"},
        { "location": "91/TALK"   , "narrator": "アーヤ", "text": "うん…電話かけても、\nすぐに留守電に\nなっちゃって…。"},
        { "location": "92/TALK"   , "narrator": "ガブリエラ", "text": "…まさかだけど。"},
        { "location": "93/TALK"   , "narrator": "ガブリエラ", "text": "管理庁の話に行って、\nそのまま捕まった…、\nとか？"},
        { "location": "94/TALK"   , "narrator": "アーヤ", "text": "…わからないけど、\n可能性ゼロとは\n言えないわよね。"},
        { "location": "95/TALK"   , "narrator": "アーヤ", "text": "管理庁は、神楽と\n繋がってるわけだし。"},
        { "location": "97/TALK"   , "narrator": "アーヤ", "text": "…そういえば、\nこの前飲みに行った\n時に――"},
        { "location": "115/TALK"  , "narrator": "真幌", "text": "私は思っているんだ。"},
        { "location": "116/TALK"  , "narrator": "真幌", "text": "…私も、そう長くは\nないかもしれん。"},
        { "location": "117/TALK"  , "narrator": "アーヤ", "text": "…え？"},
        { "location": "118/TALK"  , "narrator": "真幌", "text": "私に何かあったら、\nトライナリーや\n劇場を仕切れ。"},
        { "location": "119/TALK"  , "narrator": "真幌", "text": "おまえに\n任せたぞ。"},
        { "location": "141/TALK"  , "narrator": "アーヤ", "text": "…まさか館長、\nこうなることを\n予想してたの？"},
        { "location": "143/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "144/TALK"  , "narrator": "アーヤ", "text": "館長がいない間、\nギャヴィ達を護るのが\n私の仕事だもの。"},
        { "location": "145/TALK"  , "narrator": "アーヤ", "text": "館長だって、\nそう望んでいるはず。"},
        { "location": "146/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "147/TALK"  , "narrator": "アーヤ", "text": "でも…館長のことは\n気になるわ。"},
        { "location": "148/TALK"  , "narrator": "アーヤ", "text": "…管理庁に行ってみるべき\nなのかしら？"},
        { "location": "196/TALK"  , "narrator": "千羽鶴", "text": "　"},
        { "location": "239/TALK"  , "narrator": "千羽鶴", "text": "ようこそ、\n國政綾水の\nココロスフィアへ。"},
        { "location": "242/TALK"  , "narrator": "千羽鶴", "text": "國政綾水の\nココロゲートでも\n話をしたけども――"},
        { "location": "244/TALK"  , "narrator": "千羽鶴", "text": "ガブリエラの\nココロゲートでも\n話をしたけども――"},
        { "location": "246/TALK"  , "narrator": "千羽鶴", "text": "恋ヶ崎みやびの\nココロゲートでも\n話をしたけども――"},
        { "location": "248/TALK"  , "narrator": "千羽鶴", "text": "次回から、\n彼女たちの心のメンテは\n私が直接やることにする。"},
        { "location": "249/TALK"  , "narrator": "千羽鶴", "text": "というわけで、\n今回だけはクランの\n消去を手伝って欲しい。"},
        { "location": "251/SEL"   , "narrator": "", "text": "なんで千羽鶴が！？"},
        { "location": "252/ACT"   , "narrator": "", "text": "なんで千羽鶴が！？"},
        { "location": "254/TALK"  , "narrator": "千羽鶴", "text": "前回のメンテナンスで\n権限拡大をしたから。"},
        { "location": "255/TALK"  , "narrator": "千羽鶴", "text": "これからは、\n私が直接ココロゲートを\n管理することにする。"},
        { "location": "256/SEL"   , "narrator": "", "text": "なにそれすごい"},
        { "location": "257/SEL"   , "narrator": "", "text": "なにそれやばい"},
        { "location": "258/ACT"   , "narrator": "", "text": "なにそれすごい"},
        { "location": "259/TALK"  , "narrator": "千羽鶴", "text": "本当は最初から\nこうしておく\nべきだった。"},
        { "location": "260/TALK"  , "narrator": "千羽鶴", "text": "だから、途中から\n方針転換をして\n準備はしていた。"},
        { "location": "261/TALK"  , "narrator": "千羽鶴", "text": "けど、OSの機能制限で\nなかなかできず。\nようやく前回実現した。"},
        { "location": "262/ACT"   , "narrator": "", "text": "なにそれやばい"},
        { "location": "263/TALK"  , "narrator": "千羽鶴", "text": "やばくなんかない。"},
        { "location": "264/TALK"  , "narrator": "千羽鶴", "text": "元々の想定では\n私が直接介入する\n予定だったんだから。"},
        { "location": "265/TALK"  , "narrator": "千羽鶴", "text": "けど、OSの機能制限で\nそれはできなかった。\nだから前回調整した。"},
        { "location": "267/SEL"   , "narrator": "", "text": "でも、チュートリアルでは$me$にしか出来ない役割だと…"},
        { "location": "268/ACT"   , "narrator": "", "text": "でも、チュートリアルでは$me$にしか出来ない役割だと…"},
        { "location": "270/TALK"  , "narrator": "千羽鶴", "text": "そうね。"},
        { "location": "271/SEL"   , "narrator": "", "text": "どうして、やろうと思えば自分でできたのに$me$にやらせたの？"},
        { "location": "272/ACT"   , "narrator": "", "text": "どうして、やろうと思えば自分でできたのに$me$にやらせたの？"},
        { "location": "274/TALK"  , "narrator": "千羽鶴", "text": "彼女の自由意志によって、\n理想的な世界を創造する\n道程を進んで欲しかった。"},
        { "location": "275/TALK"  , "narrator": "千羽鶴", "text": "私が介入するということは\n洗脳することと同義。"},
        { "location": "276/TALK"  , "narrator": "千羽鶴", "text": "私は貴方と違い、\n自身だけでクランを\n対処できない。"},
        { "location": "277/TALK"  , "narrator": "千羽鶴", "text": "よって、私にできることは\nクランが出る前に\nココロを固めること――"},
        { "location": "278/TALK"  , "narrator": "千羽鶴", "text": "すなわち、\n洗脳することだけ。"},
        { "location": "279/TALK"  , "narrator": "千羽鶴", "text": "けど、それは極力\n避けたかった。"},
        { "location": "280/TALK"  , "narrator": "千羽鶴", "text": "だから、クランに介入\nできる貴方にお願いした。"},
        { "location": "281/TALK"  , "narrator": "千羽鶴", "text": "そうすれば、\n彼女の意志である\nココロの司書と協力し――"},
        { "location": "282/TALK"  , "narrator": "千羽鶴", "text": "彼女自らの意志として\n理想的な未来を\n歩むことができる。"},
        { "location": "283/TALK"  , "narrator": "千羽鶴", "text": "誤算だったのは、\n初代ココロの司書たち。"},
        { "location": "284/SEL"   , "narrator": "", "text": "そこを予測して動かなかったのは落ち度じゃない？"},
        { "location": "285/SEL"   , "narrator": "", "text": "どうして洗脳ではなく、自由意志を重視したの？"},
        { "location": "286/ACT"   , "narrator": "", "text": "そこを予測して動かなかったのは落ち度じゃない？"},
        { "location": "287/TALK"  , "narrator": "千羽鶴", "text": "人のココロを、\n全く介入せず予測するのは\n何より難しい計算。"},
        { "location": "288/TALK"  , "narrator": "千羽鶴", "text": "複数の人間の自由意志を\n保持しつつ、未来を予測\nするのは神業に近い。"},
        { "location": "289/TALK"  , "narrator": "千羽鶴", "text": "その為、上手くいかない\n場合の対応策も用意しつつ\n運用を試みている。"},
        { "location": "290/SEL"   , "narrator": "", "text": "もしかして、それが新しい司書？"},
        { "location": "291/ACT"   , "narrator": "", "text": "もしかして、それが新しい司書？"},
        { "location": "293/TALK"  , "narrator": "千羽鶴", "text": "そう。\nそれが第一の対応策。"},
        { "location": "294/TALK"  , "narrator": "千羽鶴", "text": "半分だけ彼女の意志を\n残した状態で、もう半分を\n意図的に動かせる存在――"},
        { "location": "295/TALK"  , "narrator": "千羽鶴", "text": "半人格による\nココロの制御。"},
        { "location": "296/TALK"  , "narrator": "千羽鶴", "text": "これは例えるなら\n心臓ペースメーカーに\n近い。"},
        { "location": "297/TALK"  , "narrator": "千羽鶴", "text": "免疫力に抵抗されず、\n人工的なシステムによって\n人をサポートする。"},
        { "location": "298/TALK"  , "narrator": "千羽鶴", "text": "そして、それでも\n難しいと判断した場合は、\n私が介入する予定だった。"},
        { "location": "299/TALK"  , "narrator": "千羽鶴", "text": "これは完全なる洗脳に\nなるから、代償が伴う。"},
        { "location": "300/TALK"  , "narrator": "千羽鶴", "text": "けど、それを加味しても\nやらねばならないときが\n来たらやるつもりだった。"},
        { "location": "301/ACT"   , "narrator": "", "text": "どうして洗脳ではなく、自由意志を重視したの？"},
        { "location": "302/TALK"  , "narrator": "千羽鶴", "text": "洗脳による\n未来の創造では\n欠落するものがある。"},
        { "location": "303/TALK"  , "narrator": "千羽鶴", "text": "極力その欠落を\n抑えつつ未来を\n選択せねばならない。"},
        { "location": "304/SEL"   , "narrator": "", "text": "何が欠落するの？"},
        { "location": "305/ACT"   , "narrator": "", "text": "何が欠落するの？"},
        { "location": "307/TALK"  , "narrator": "千羽鶴", "text": "強い意志と精神力。"},
        { "location": "309/TALK"  , "narrator": "千羽鶴", "text": "いずれにせよ、\n既に私自身が介入する\nことで決定した。"},
        { "location": "311/TALK"  , "narrator": "千羽鶴", "text": "だから、これによって\n貴方は、少しだけ重荷が\nおりることになる。"},
        { "location": "312/TALK"  , "narrator": "千羽鶴", "text": "これからは、ココロの中に\n方針を与える必要は\nなくなるから――"},
        { "location": "313/TALK"  , "narrator": "千羽鶴", "text": "思う存分、彼女と\nイチャイチャするだけで\nオッケー！"},
        { "location": "314/SEL"   , "narrator": "", "text": "やったー！"},
        { "location": "315/SEL"   , "narrator": "", "text": "えー"},
        { "location": "316/ACT"   , "narrator": "", "text": "やったー！"},
        { "location": "317/TALK"  , "narrator": "千羽鶴", "text": "というわけで、\n次回からはココロゲートに\n来なくてもいい。"},
        { "location": "318/ACT"   , "narrator": "", "text": "えー"},
        { "location": "319/TALK"  , "narrator": "千羽鶴", "text": "意外。"},
        { "location": "320/TALK"  , "narrator": "千羽鶴", "text": "そこで嫌がられるとは\n思ってもみなかった。"},
        { "location": "321/TALK"  , "narrator": "千羽鶴", "text": "ココロゲートと\nクランのデリートは\nかなり負担だったのでは。"},
        { "location": "322/SEL"   , "narrator": "", "text": "まあ、ね…"},
        { "location": "323/SEL"   , "narrator": "", "text": "いや、楽しかった"},
        { "location": "324/ACT"   , "narrator": "", "text": "まあ、ね…"},
        { "location": "325/TALK"  , "narrator": "千羽鶴", "text": "じゃあどうして\nえーなの？"},
        { "location": "326/ACT"   , "narrator": "", "text": "いや、楽しかった"},
        { "location": "327/TALK"  , "narrator": "千羽鶴", "text": "そうなのね。\nかわった人。"},
        { "location": "328/SEL"   , "narrator": "", "text": "司書たちとラブラブ中だったし"},
        { "location": "329/SEL"   , "narrator": "", "text": "バトル出来なくなるの辛い"},
        { "location": "330/SEL"   , "narrator": "", "text": "お話の核心が見られるから"},
        { "location": "331/SEL"   , "narrator": "", "text": "どっちかというと千羽鶴に任せるのが心配"},
        { "location": "332/ACT"   , "narrator": "", "text": "司書たちとラブラブ中だったし"},
        { "location": "333/TALK"  , "narrator": "千羽鶴", "text": "禁断の恋ね。\n誰とラブラブしたのか\n教えて。"},
        { "location": "334/SEL"   , "narrator": "", "text": "つばめの元司書"},
        { "location": "335/SEL"   , "narrator": "", "text": "つばめの新司書"},
        { "location": "336/SEL"   , "narrator": "", "text": "アーヤの元司書"},
        { "location": "337/SEL"   , "narrator": "", "text": "アーヤの新司書"},
        { "location": "338/SEL"   , "narrator": "", "text": "ガブリエラの司書"},
        { "location": "339/SEL"   , "narrator": "", "text": "みやびの元司書"},
        { "location": "340/SEL"   , "narrator": "", "text": "みやびの新司書"},
        { "location": "341/SEL"   , "narrator": "", "text": "冗談でした"},
        { "location": "342/ACT"   , "narrator": "", "text": "つばめの元司書"},
        { "location": "344/ACT"   , "narrator": "", "text": "つばめの新司書"},
        { "location": "346/ACT"   , "narrator": "", "text": "アーヤの元司書"},
        { "location": "348/ACT"   , "narrator": "", "text": "アーヤの新司書"},
        { "location": "350/ACT"   , "narrator": "", "text": "ガブリエラの司書"},
        { "location": "352/ACT"   , "narrator": "", "text": "みやびの元司書"},
        { "location": "354/ACT"   , "narrator": "", "text": "みやびの新司書"},
        { "location": "356/ACT"   , "narrator": "", "text": "冗談でした"},
        { "location": "359/TALK"  , "narrator": "千羽鶴", "text": "なるほど。"},
        { "location": "360/ACT"   , "narrator": "", "text": "バトル出来なくなるの辛い"},
        { "location": "361/TALK"  , "narrator": "千羽鶴", "text": "それなら安心して。"},
        { "location": "362/TALK"  , "narrator": "千羽鶴", "text": "これからも要所要所で\n手伝ってもらうから。"},
        { "location": "363/ACT"   , "narrator": "", "text": "お話の核心が見られるから"},
        { "location": "364/TALK"  , "narrator": "千羽鶴", "text": "それなら安心して。"},
        { "location": "365/TALK"  , "narrator": "千羽鶴", "text": "私が毎回\n語ってあげるから。"},
        { "location": "366/ACT"   , "narrator": "", "text": "どっちかというと千羽鶴に任せるのが心配"},
        { "location": "367/TALK"  , "narrator": "千羽鶴", "text": "それって、私を\n信用できないってこと？"},
        { "location": "368/SEL"   , "narrator": "", "text": "イエス！"},
        { "location": "369/SEL"   , "narrator": "", "text": "そういうわけじゃないけど、"},
        { "location": "370/ACT"   , "narrator": "", "text": "イエス！"},
        { "location": "371/TALK"  , "narrator": "千羽鶴", "text": "なるほど。"},
        { "location": "372/TALK"  , "narrator": "千羽鶴", "text": "それは残念。"},
        { "location": "373/ACT"   , "narrator": "", "text": "そういうわけじゃないけど、"},
        { "location": "374/TALK"  , "narrator": "千羽鶴", "text": "煮え切らない人。"},
        { "location": "379/TALK"  , "narrator": "千羽鶴", "text": "いずれにせよ、\n貴方がどう思おうが\n状況はかわらない。"},
        { "location": "380/TALK"  , "narrator": "千羽鶴", "text": "今後貴方には、現実の\n彼女をめいっぱい\n支えてあげて欲しい。"},
        { "location": "381/TALK"  , "narrator": "千羽鶴", "text": "さて、そんな状況では\nあるのだけど――"},
        { "location": "382/TALK"  , "narrator": "千羽鶴", "text": "今回ばかりは\n貴方の力が必要だから\n協力して欲しい。"},
        { "location": "383/SEL"   , "narrator": "", "text": "あれ？$me$は必要ないのでは？"},
        { "location": "384/ACT"   , "narrator": "", "text": "あれ？$me$は必要ないのでは？"},
        { "location": "386/TALK"  , "narrator": "千羽鶴", "text": "今回だけは\nまだ不十分なところが\nあるから。"},
        { "location": "387/TALK"  , "narrator": "千羽鶴", "text": "前回の調整からあまり\n時間がなくて、完全な形\nでの対応ができなかった。"},
        { "location": "388/TALK"  , "narrator": "千羽鶴", "text": "次回からは全部\n私の手でやる。"},
        { "location": "390/SEL"   , "narrator": "", "text": "わかった"},
        { "location": "391/SEL"   , "narrator": "", "text": "それはそうと、アーヤの司書はどうなった？"},
        { "location": "392/ACT"   , "narrator": "", "text": "わかった"},
        { "location": "393/TALK"  , "narrator": "千羽鶴", "text": "よろしく。"},
        { "location": "394/ACT"   , "narrator": "", "text": "それはそうと、アーヤの司書はどうなった？"},
        { "location": "395/TALK"  , "narrator": "千羽鶴", "text": "その役割は\n終了する。"},
        { "location": "396/TALK"  , "narrator": "千羽鶴", "text": "よって\n消滅することになる。"},
        { "location": "397/SEL"   , "narrator": "", "text": "え！？　普通の人格に戻るんじゃなくて！？"},
        { "location": "398/ACT"   , "narrator": "", "text": "え！？　普通の人格に戻るんじゃなくて！？"},
        { "location": "400/TALK"  , "narrator": "千羽鶴", "text": "二代目の司書は、\n司書として\n新たに起こした人格。"},
        { "location": "401/TALK"  , "narrator": "千羽鶴", "text": "よって、\n司書が不要になれば\nバラすだけ。"},
        { "location": "402/SEL"   , "narrator": "", "text": "初代は？"},
        { "location": "403/ACT"   , "narrator": "", "text": "初代は？"},
        { "location": "405/TALK"  , "narrator": "千羽鶴", "text": "初代は\n事を起こしすぎてる。"},
        { "location": "406/TALK"  , "narrator": "千羽鶴", "text": "今後の設計には\n害悪になる。\nだから消滅させる。"},
        { "location": "407/SEL"   , "narrator": "", "text": "確かにだいぶ暴れたからね、仕方ない"},
        { "location": "408/SEL"   , "narrator": "", "text": "初代司書が言っていた契約者って千羽鶴でしょう？"},
        { "location": "409/ACT"   , "narrator": "", "text": "確かにだいぶ暴れたからね、仕方ない"},
        { "location": "410/TALK"  , "narrator": "千羽鶴", "text": "そう。\n仕方ない。"},
        { "location": "411/TALK"  , "narrator": "千羽鶴", "text": "残念だけど、\nもう再教育してる\n時間はない。"},
        { "location": "412/ACT"   , "narrator": "", "text": "初代司書が言っていた契約者って千羽鶴でしょう？"},
        { "location": "413/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "414/SEL"   , "narrator": "", "text": "利害が一致しなくなったら自分に牙を剥くって言ってたけど本当だね"},
        { "location": "415/ACT"   , "narrator": "", "text": "利害が一致しなくなったら自分に牙を剥くって言ってたけど本当だね"},
        { "location": "417/TALK"  , "narrator": "千羽鶴", "text": "全てはこの先の\n幸せを願ってのこと。"},
        { "location": "418/TALK"  , "narrator": "千羽鶴", "text": "決して國政綾水を\n傷つけたいわけじゃない。"},
        { "location": "419/TALK"  , "narrator": "千羽鶴", "text": "けど、時にそれは\n茨の道になることもある。"},
        { "location": "420/TALK"  , "narrator": "千羽鶴", "text": "彼女…初代司書には\nそれがわからないだけ。"},
        { "location": "422/TALK"  , "narrator": "千羽鶴", "text": "さあ、それじゃ\nそろそろよろしく。"},
        { "location": "450/TALK"  , "narrator": "千羽鶴", "text": "貴方とこの世界に\n素敵なココロの旅を。"},
        { "location": "30/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>9月3日　 10:03 AM</color>\nとある休日の午前中、寮「とらいあんぐる」アーヤの部屋にて"},
        { "location": "161/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "163/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "165/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "167/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "169/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"}
    ]
}
