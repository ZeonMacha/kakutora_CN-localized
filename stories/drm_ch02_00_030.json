{
    "dir": "dramatics/daydra/drm_ch02_00_030.js",
    "type": "Episode",
    "info": {
        "story_id": "2003",
        "cid": "ayami",
        "title": "らぶとーく 第03話",
        "sub_title": "記憶のかけら"
    },
    "entry":
    [
        { "location": "345/SCENARIO", "narrator": "", "text": "記憶のかけら"},
        { "location": "362/TALK"    , "narrator": "みやび", "text": "前にテレビだか\n雑誌だかで見たことが\nあるけんど――"},
        { "location": "363/TALK"    , "narrator": "みやび", "text": "マイペースなんは\n長女の特徴らしいぞね。"},
        { "location": "364/TALK"    , "narrator": "アーヤ", "text": "そうなの？"},
        { "location": "365/TALK"    , "narrator": "みやび", "text": "つばめちゃんが\nいい例ぞね。"},
        { "location": "366/TALK"    , "narrator": "みやび", "text": "長女ちゅうか\n一人っ子やけんど。"},
        { "location": "367/TALK"    , "narrator": "みやび", "text": "それにうちや。"},
        { "location": "368/TALK"    , "narrator": "アーヤ", "text": "…ああ、確かに！"},
        { "location": "369/TALK"    , "narrator": "みやび", "text": "やき、そんな姉を持った\n次女は、長女を反面教師に\nキッチリさんになるんよ。"},
        { "location": "370/TALK"    , "narrator": "アーヤ", "text": "あはは…まあ、なんとなく\nわかる気がするわ。"},
        { "location": "372/TALK"    , "narrator": "アーヤ", "text": "本当、マイペースな姉を\n持つと苦労するのよ。"},
        { "location": "373/TALK"    , "narrator": "みやび", "text": "…そんなお姉さんの話を\nしちゃあくれんかね。"},
        { "location": "375/TALK"    , "narrator": "アーヤ", "text": "……………………\n…………………。"},
        { "location": "377/TALK"    , "narrator": "みやび", "text": "…ツンデレやね。"},
        { "location": "378/TALK"    , "narrator": "アーヤ", "text": "……………………\nそういうんじゃないわ。"},
        { "location": "379/TALK"    , "narrator": "アーヤ", "text": "ただ姉なんかの\n話をしたくないだけよ。"},
        { "location": "380/TALK"    , "narrator": "みやび", "text": "そうなるとうちも\n嫌われゆうことになるん\nかね…。"},
        { "location": "381/TALK"    , "narrator": "アーヤ", "text": "違うわ。\nそういうことじゃない。"},
        { "location": "382/TALK"    , "narrator": "アーヤ", "text": "あの人に比べれば、\nみやびなんてまだまだ\nしっかり者だし。"},
        { "location": "383/TALK"    , "narrator": "みやび", "text": "…まっこと、色々と\n苦労してきたんやね。"},
        { "location": "384/TALK"    , "narrator": "アーヤ", "text": "まあね…。"},
        { "location": "386/TALK"    , "narrator": "アーヤ", "text": "そういえば、マイペースは\n長女の特徴、って言ってた\nけど――"},
        { "location": "387/TALK"    , "narrator": "アーヤ", "text": "男兄弟の場合でも\nそうなのかしら？"},
        { "location": "388/TALK"    , "narrator": "みやび", "text": "さあ？　トライナリーには\n男兄弟いる子はおらんき、\n知りようないけんど。"},
        { "location": "389/TALK"    , "narrator": "アーヤ", "text": "そうよね…。"},
        { "location": "391/TALK"    , "narrator": "アーヤ", "text": "じゃあ、\nＢｏｔに聞いてみるわ。"},
        { "location": "397/TALK"    , "narrator": "アーヤ", "text": "質問"},
        { "location": "398/TALK"    , "narrator": "アーヤ", "text": "男兄弟の長男って"},
        { "location": "399/TALK"    , "narrator": "アーヤ", "text": "マイペースだったりする？（￣ー￣？）"},
        { "location": "401/SEL"     , "narrator": "", "text": "まずはマイペースの定義からだね"},
        { "location": "402/SEL"     , "narrator": "", "text": "マイペースすぎて登山するレベル"},
        { "location": "403/SEL"     , "narrator": "", "text": "だと思うよ"},
        { "location": "404/ACT"     , "narrator": "", "text": "まずはマイペースの定義からだね"},
        { "location": "405/TALK"    , "narrator": "アーヤ", "text": "え"},
        { "location": "406/TALK"    , "narrator": "アーヤ", "text": "なんか面倒くさいわね"},
        { "location": "407/ACT"     , "narrator": "", "text": "マイペースすぎて登山するレベル"},
        { "location": "408/TALK"    , "narrator": "アーヤ", "text": "意味がわからないわ"},
        { "location": "409/TALK"    , "narrator": "アーヤ", "text": "でもこれ"},
        { "location": "410/TALK"    , "narrator": "アーヤ", "text": "マイペースと言えなくはないか"},
        { "location": "411/ACT"     , "narrator": "", "text": "だと思うよ"},
        { "location": "412/TALK"    , "narrator": "アーヤ", "text": "そうなんだ(*^o^*)"},
        { "location": "413/TALK"    , "narrator": "アーヤ", "text": "っていうか"},
        { "location": "414/TALK"    , "narrator": "アーヤ", "text": "そんなこともわかるんだ？"},
        { "location": "416/TALK"    , "narrator": "アーヤ", "text": "そうだ"},
        { "location": "417/TALK"    , "narrator": "アーヤ", "text": "もしかして"},
        { "location": "418/TALK"    , "narrator": "アーヤ", "text": "兄弟いたりする？(￣∇￣)"},
        { "location": "420/SEL"     , "narrator": "", "text": "姉妹ならいるよ"},
        { "location": "421/SEL"     , "narrator": "", "text": "兄弟も姉妹もいないし"},
        { "location": "422/SEL"     , "narrator": "", "text": "実は６人兄弟で…"},
        { "location": "423/SEL"     , "narrator": "", "text": "お姉様とお呼び！"},
        { "location": "424/SEL"     , "narrator": "", "text": "アーヤとは魂の兄弟だから"},
        { "location": "425/ACT"     , "narrator": "", "text": "姉妹ならいるよ"},
        { "location": "426/TALK"    , "narrator": "アーヤ", "text": "冗談も言えるのね(-.-;)"},
        { "location": "427/ACT"     , "narrator": "", "text": "兄弟も姉妹もいないし"},
        { "location": "428/TALK"    , "narrator": "アーヤ", "text": "まあそうよね(￣Д￣ )"},
        { "location": "429/ACT"     , "narrator": "", "text": "実は６人兄弟で…"},
        { "location": "430/TALK"    , "narrator": "アーヤ", "text": "いや"},
        { "location": "431/TALK"    , "narrator": "アーヤ", "text": "さすがにそれは盛り過ぎだから(￣Д￣ )"},
        { "location": "432/ACT"     , "narrator": "", "text": "お姉様とお呼び！"},
        { "location": "433/TALK"    , "narrator": "アーヤ", "text": "お"},
        { "location": "434/TALK"    , "narrator": "アーヤ", "text": "お姉様！？"},
        { "location": "435/TALK"    , "narrator": "アーヤ", "text": "とは呼ばないかな、、、"},
        { "location": "436/ACT"     , "narrator": "", "text": "アーヤとは魂の兄弟だから"},
        { "location": "437/TALK"    , "narrator": "アーヤ", "text": "ソウルメイト？"},
        { "location": "438/TALK"    , "narrator": "アーヤ", "text": "ソウルブラザー？"},
        { "location": "439/TALK"    , "narrator": "アーヤ", "text": "なんか"},
        { "location": "440/TALK"    , "narrator": "アーヤ", "text": "例えが古くない？(-ω-;)"},
        { "location": "442/TALK"    , "narrator": "アーヤ", "text": "っていうか"},
        { "location": "443/TALK"    , "narrator": "アーヤ", "text": "Ｂｏｔに兄弟がいるとか"},
        { "location": "444/TALK"    , "narrator": "アーヤ", "text": "あるわけないわよね"},
        { "location": "452/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "454/TALK"    , "narrator": "みやび", "text": "どうかしたが？"},
        { "location": "456/TALK"    , "narrator": "アーヤ", "text": "ううん。\n別に。"},
        { "location": "457/TALK"    , "narrator": "アーヤ", "text": "ただ、男兄弟って\n気楽でいいかもって\n思っただけよ。"},
        { "location": "458/TALK"    , "narrator": "みやび", "text": "そうかねえ。"},
        { "location": "459/TALK"    , "narrator": "みやび", "text": "隣の芝生は青いって\nだけやないかねえ。"},
        { "location": "460/TALK"    , "narrator": "アーヤ", "text": "……。"},
        { "location": "461/TALK"    , "narrator": "アーヤ", "text": "そういうことに\nしておくわ。"},
        { "location": "462/TALK"    , "narrator": "アーヤ", "text": "そういうみやびは\nどうなの？"},
        { "location": "464/TALK"    , "narrator": "みやび", "text": "うちか？"},
        { "location": "465/TALK"    , "narrator": "みやび", "text": "うちは…。"},
        { "location": "466/TALK"    , "narrator": "みやび", "text": "その話をすると\nアーヤはうちという\nスーパハッカーを失う。"},
        { "location": "467/TALK"    , "narrator": "みやび", "text": "それでもよいなら\n話すぞね。"},
        { "location": "468/TALK"    , "narrator": "アーヤ", "text": "またまた。\n冗談ばっかり。"},
        { "location": "469/TALK"    , "narrator": "アーヤ", "text": "でもそうね。\nお互い話したくない\n話はあるものね。"},
        { "location": "470/TALK"    , "narrator": "アーヤ", "text": "そういうことでしょ？"},
        { "location": "471/TALK"    , "narrator": "みやび", "text": "……。"},
        { "location": "472/TALK"    , "narrator": "アーヤ", "text": "わかったわ。\n紳士協定を\n結びましょう。"},
        { "location": "473/TALK"    , "narrator": "アーヤ", "text": "私はみやびの兄弟に\nついて聞かない。"},
        { "location": "474/TALK"    , "narrator": "アーヤ", "text": "だからみやびも\n私の姉については\nもう聞かないで。"},
        { "location": "476/TALK"    , "narrator": "アーヤ", "text": "どう？"},
        { "location": "477/TALK"    , "narrator": "みやび", "text": "……。\nうちにはちっくと\n不利な条件ぞね。"},
        { "location": "478/TALK"    , "narrator": "アーヤ", "text": "そうかしら。\nいい条件だと\n思うけど。"},
        { "location": "479/TALK"    , "narrator": "アーヤ", "text": "じゃあ、\n協定成立ね。"},
        { "location": "360/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>5月某日　4:41 PM</color>\n放課後、神楽坂付近のカフェにて。"}
    ]
}
