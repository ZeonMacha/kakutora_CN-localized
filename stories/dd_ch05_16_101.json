{
    "dir": "chap16/daydra/dd_ch05_16_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "16502",
        "cid": "kagura",
        "title": "002 メインストーリー",
        "sub_title": "十六方塞がり＜前編＞"
    },
    "entry":
    [
        { "location": "44/TALK"   , "narrator": "ガブリエラ", "text": "アプリゲームかぁ…、\n課金すれば強くなれる\nとかだったら――"},
        { "location": "46/TALK"   , "narrator": "ガブリエラ", "text": "今回は楽勝なん\nだけどなぁ…。"},
        { "location": "49/TALK"   , "narrator": "アーヤ", "text": "あら、どうして？"},
        { "location": "51/TALK"   , "narrator": "ガブリエラ", "text": "そりゃ、あたしらの\nバックには管理庁が\n付いてるんだもの。"},
        { "location": "53/TALK"   , "narrator": "神楽", "text": "…………。"},
        { "location": "54/TALK"   , "narrator": "神楽", "text": "どうして。"},
        { "location": "55/TALK"   , "narrator": "神楽", "text": "どうして私のマンションが、\n巻き込まれなくちゃ\nいけないの？"},
        { "location": "59/TALK"   , "narrator": "つばめ", "text": "卯月さんも、\nそう思わない？"},
        { "location": "60/TALK"   , "narrator": "神楽", "text": "広い東京で、\nよりにもよって\nうちとか…。"},
        { "location": "61/TALK"   , "narrator": "神楽", "text": "あまりにも不運すぎるわ。\nどうして私ばかり、\nこんな目に…。"},
        { "location": "62/TALK"   , "narrator": "つばめ", "text": "卯月さん？"},
        { "location": "65/TALK"   , "narrator": "神楽", "text": "えっ！？　あ、はい。\nどうかしましたか？"},
        { "location": "66/TALK"   , "narrator": "つばめ", "text": "あ、ううん…。\n大したことじゃないん\nだけど…。"},
        { "location": "67/TALK"   , "narrator": "つばめ", "text": "…大丈夫？\nちょっと元気がない\nみたいだけど…。"},
        { "location": "68/TALK"   , "narrator": "神楽", "text": "…ありがとう、\nつばめさん。"},
        { "location": "69/TALK"   , "narrator": "神楽", "text": "心配してくれる気持ちは\n嬉しいけど、こればかりは\n言えないんです…。"},
        { "location": "71/TALK"   , "narrator": "神楽", "text": "そ、そんなこと\nないですよ。"},
        { "location": "72/TALK"   , "narrator": "神楽", "text": "ほら、いつも通り\n私は元気ですから…。"},
        { "location": "73/TALK"   , "narrator": "つばめ", "text": "無理してない？\n何だか、全然元気に\n見えないんだけど…。"},
        { "location": "76/TALK"   , "narrator": "神楽", "text": "大丈夫です。\nつばめさんの\n思い過ごしですよ…。"},
        { "location": "77/TALK"   , "narrator": "つばめ", "text": "…そう？\nそれならいいん\nだけど…。"},
        { "location": "79/TALK"   , "narrator": "神楽", "text": "…………。"},
        { "location": "82/TALK"   , "narrator": "つばめ", "text": "…………。"},
        { "location": "84/TALK"   , "narrator": "神楽", "text": "そこは信じちゃう辺り、\nやっぱりつばめさんだなぁ。"},
        { "location": "85/TALK"   , "narrator": "神楽", "text": "…ママが大変なことに\nなってるのに、元気なわけ\nないじゃない。"},
        { "location": "89/TALK"   , "narrator": "神楽", "text": "本当は、こうやって\n笑顔になるだけでも、\n辛くて堪らないのに…。"},
        { "location": "90/TALK"   , "narrator": "神楽", "text": "…そうよ。"},
        { "location": "91/TALK"   , "narrator": "神楽", "text": "見ず知らずの発症者より、\n私にはママの方が\n大切なんだから。"},
        { "location": "92/TALK"   , "narrator": "神楽", "text": "どうにかして、\nママのところに\n行く方法はないかしら？"},
        { "location": "93/TALK"   , "narrator": "つばめ", "text": "…………。"},
        { "location": "95/TALK"   , "narrator": "神楽", "text": "もしかして――"},
        { "location": "96/TALK"   , "narrator": "神楽", "text": "つばめさんにお願いしたら、\nどうにかなるんじゃ…。"},
        { "location": "97/TALK"   , "narrator": "神楽", "text": "うちがフェノメノンに\n取り込まれた、って…。"},
        { "location": "98/TALK"   , "narrator": "神楽", "text": "ママが、残されてるって\n話せば…。"},
        { "location": "99/TALK"   , "narrator": "神楽", "text": "そうよ、つばめさんなら\nきっと協力してくれるわ！"},
        { "location": "101/TALK"  , "narrator": "神楽", "text": "…お願いしよう。"},
        { "location": "102/TALK"  , "narrator": "神楽", "text": "私は早く、ママの\nところに行かなきゃ\nならないんだから！"},
        { "location": "150/TALK"  , "narrator": "ぴょんこ", "text": "　"},
        { "location": "184/TALK"  , "narrator": "拘束されし者", "text": "ようこそ、\n曼荼羅の世界へ。"},
        { "location": "185/TALK"  , "narrator": "ぴょんこ", "text": "えっ！？"},
        { "location": "186/SEL"   , "narrator": "", "text": "！？"},
        { "location": "187/ACT"   , "narrator": "", "text": "！？"},
        { "location": "189/TALK"  , "narrator": "拘束されし者", "text": "ここには生きとし生ける\nもの全ての記憶と、その\n繋がりにリンクしている。"},
        { "location": "190/TALK"  , "narrator": "つばめ", "text": "えっと、\nあなたは誰ですか！？"},
        { "location": "191/TALK"  , "narrator": "つばめ", "text": "さっき『神楽ちゃんは\n同化した方がいい』って\n言ったのはあなたですか？"},
        { "location": "192/TALK"  , "narrator": "拘束されし者", "text": "いや、私ではない。"},
        { "location": "193/TALK"  , "narrator": "拘束されし者", "text": "むしろ私は、\n“それ”から貴方たちを\n護る為にここにいるのだ。"},
        { "location": "194/SEL"   , "narrator": "", "text": "“それ”って誰？？"},
        { "location": "195/SEL"   , "narrator": "", "text": "あんた誰？？"},
        { "location": "196/ACT"   , "narrator": "", "text": "“それ”って誰？？"},
        { "location": "197/ACT"   , "narrator": "", "text": "あんた誰？？"},
        { "location": "205/TALK"  , "narrator": "拘束されし者", "text": "お前は……\n遠き平行世界の意志か。"},
        { "location": "206/TALK"  , "narrator": "拘束されし者", "text": "それよりも重要なことを、\n今から私は、お前たちに\n伝えねばならない。"},
        { "location": "211/TALK"  , "narrator": "拘束されし者", "text": "お前たちは、卯月神楽が\n逢瀬つばめの世界に同化\nするのを防ごうとしている"},
        { "location": "212/TALK"  , "narrator": "拘束されし者", "text": "しかし残念ながら、同化は\n一旦始まってしまうと、\nどんどん進行してしまう。"},
        { "location": "213/TALK"  , "narrator": "拘束されし者", "text": "すなわち――"},
        { "location": "214/TALK"  , "narrator": "拘束されし者", "text": "とある意志が\n卯月神楽の同化を望み、\n具体的な行動に出た。"},
        { "location": "215/TALK"  , "narrator": "拘束されし者", "text": "それにより、現在\n卯月神楽はつばめ世界の\n住人となっている。"},
        { "location": "216/TALK"  , "narrator": "拘束されし者", "text": "記憶の改ざんと同化は、\nそこにいるつばめたちの\n尽力により鈍化してるが―"},
        { "location": "217/TALK"  , "narrator": "拘束されし者", "text": "それでも進行を完全に\n食い止める事はできない。"},
        { "location": "218/TALK"  , "narrator": "拘束されし者", "text": "なぜなら、１つには\n外の世界との再接続が\nまだ行われていないこと。"},
        { "location": "219/TALK"  , "narrator": "拘束されし者", "text": "そしてもう１つには、\n一度混濁してしまった\n記憶は――"},
        { "location": "220/TALK"  , "narrator": "拘束されし者", "text": "放っておけばより混乱し、\n自然にその崩壊は大きく\nなっていくこと。"},
        { "location": "221/TALK"  , "narrator": "拘束されし者", "text": "それは例えるなら、\n崩れ始めた砂の壁や、\nなだれと同じなのだ。"},
        { "location": "222/TALK"  , "narrator": "ぴょんこ", "text": "そう。"},
        { "location": "223/TALK"  , "narrator": "ぴょんこ", "text": "最初は１つの記憶が\n改ざんされるだけ。"},
        { "location": "226/TALK"  , "narrator": "ぴょんこ", "text": "けれどもその改ざんが元で\nそれに関連する記憶に\n矛盾が生じて――"},
        { "location": "227/TALK"  , "narrator": "ぴょんこ", "text": "脳はその矛盾を\n拒絶するあまり、\nその記憶を改ざんする。"},
        { "location": "229/TALK"  , "narrator": "ぴょんこ", "text": "そうやって、徐々に\n記憶が書き換わって\nいってしまう。"},
        { "location": "230/TALK"  , "narrator": "つばめ", "text": "ええ……？"},
        { "location": "231/TALK"  , "narrator": "拘束されし者", "text": "その通り。"},
        { "location": "236/TALK"  , "narrator": "拘束されし者", "text": "つばめたちは、\nその記憶の\n改ざんに対し――"},
        { "location": "237/TALK"  , "narrator": "拘束されし者", "text": "ありのままの今の姿と\n想いを伝えることで、\n現実味を維持している。"},
        { "location": "238/TALK"  , "narrator": "拘束されし者", "text": "それが目に見える証拠と\nなって、記憶の改ざんに\n抵抗しているに過ぎない。"},
        { "location": "239/TALK"  , "narrator": "拘束されし者", "text": "だが、その行為を\n永久に続ければ、神楽の\n精神が持たないだろう。"},
        { "location": "240/TALK"  , "narrator": "拘束されし者", "text": "その目的に関係無く、\n他者の精神への介入に\n他ならないのだから。"},
        { "location": "241/TALK"  , "narrator": "つばめ", "text": "じゃあ、\nどうすればいいんですか！"},
        { "location": "242/TALK"  , "narrator": "つばめ", "text": "どうすれば、神楽ちゃんは\n今の神楽ちゃんのままで\nいられるんですか？"},
        { "location": "243/TALK"  , "narrator": "拘束されし者", "text": "私がお前たちに\n伝えたい事は、\nまさにそのことだ。"},
        { "location": "244/TALK"  , "narrator": "拘束されし者", "text": "その方法を教え、\n具体的に実践の手助けを\nする為、ここに誘導した。"},
        { "location": "245/TALK"  , "narrator": "つばめ", "text": "教えてください！"},
        { "location": "246/TALK"  , "narrator": "拘束されし者", "text": "まず――"},
        { "location": "247/TALK"  , "narrator": "拘束されし者", "text": "フェノメノンが他者を\n同化させるのに、全記憶を\n操作したりはしない。"},
        { "location": "248/TALK"  , "narrator": "拘束されし者", "text": "それは、過去の一点の\nひとつの記憶の改ざん\nのみを行うのが常である。"},
        { "location": "249/TALK"  , "narrator": "拘束されし者", "text": "それだけでいい。"},
        { "location": "250/TALK"  , "narrator": "拘束されし者", "text": "後は脳が勝手に整合性を\n取るために、嘘の記憶を\n補完し始めるからだ。"},
        { "location": "251/TALK"  , "narrator": "拘束されし者", "text": "その改ざんポイントが\nどこなのか、どんな捏造か\nわかりさえすれば――"},
        { "location": "252/TALK"  , "narrator": "拘束されし者", "text": "その記憶を元に戻し、\nなし崩し的な記憶の\n崩壊を止められる。"},
        { "location": "253/TALK"  , "narrator": "拘束されし者", "text": "同時に、誰がそれを\nやったのかも、\nわかるかもしれない。"},
        { "location": "254/SEL"   , "narrator": "", "text": "犯人がわかるの！？"},
        { "location": "255/ACT"   , "narrator": "", "text": "犯人がわかるの！？"},
        { "location": "257/TALK"  , "narrator": "拘束されし者", "text": "その通りだ。"},
        { "location": "258/TALK"  , "narrator": "拘束されし者", "text": "改ざんポイントには、\n改ざんした存在の\n思念がまとわりつく。"},
        { "location": "259/TALK"  , "narrator": "拘束されし者", "text": "だから、改ざんポイントを\n突き止めることこそが、\n全ての解決に繋がる。"},
        { "location": "260/TALK"  , "narrator": "ぴょんこ", "text": "で、どうすれば？"},
        { "location": "261/TALK"  , "narrator": "拘束されし者", "text": "過去の１点から、\n卯月神楽の記憶を遡り、\n見ていくことになる。"},
        { "location": "262/TALK"  , "narrator": "拘束されし者", "text": "そして、それができる\n存在は唯一人――"},
        { "location": "263/TALK"  , "narrator": "拘束されし者", "text": "記憶を俯瞰出来る存在、\n“遠き平行世界の意志”\nのみだ。"},
        { "location": "270/TALK"  , "narrator": "つばめ", "text": "$handle$さん\nだけ……？"},
        { "location": "271/TALK"  , "narrator": "ぴょんこ", "text": "………。"},
        { "location": "276/TALK"  , "narrator": "ぴょんこ", "text": "！！"},
        { "location": "289/TALK"  , "narrator": "ガブリエラ", "text": "そっちはどう？"},
        { "location": "290/TALK"  , "narrator": "ガブリエラ", "text": "まだかかりそうかしらね？"},
        { "location": "292/TALK"  , "narrator": "ぴょんこ", "text": "まだまだ始まったばかりです"},
        { "location": "293/TALK"  , "narrator": "ガブリエラ", "text": "葛藤起きてるけど、処理しちゃっていい？"},
        { "location": "294/TALK"  , "narrator": "ぴょんこ", "text": "すみません、お願いします"},
        { "location": "296/TALK"  , "narrator": "ぴょんこ", "text": "2xD43番地です"},
        { "location": "298/TALK"  , "narrator": "ガブリエラ", "text": "あんたはそっちに専念なさい"},
        { "location": "299/TALK"  , "narrator": "ガブリエラ", "text": "余裕ができたらいくわ"},
        { "location": "300/TALK"  , "narrator": "ぴょんこ", "text": "ありがとうございます♪"},
        { "location": "301/TALK"  , "narrator": "ぴょんこ", "text": "私も行けるようなら応戦にいきますねっ！"},
        { "location": "302/TALK"  , "narrator": "ガブリエラ", "text": "まあ、無理しないで"},
        { "location": "315/TALK"  , "narrator": "ぴょんこ", "text": "ありがとう、\nガブちゃん……。"},
        { "location": "338/TALK"  , "narrator": "ぴょんこ", "text": "なんだか\nすごいことに\nなってきましたね。"},
        { "location": "339/SEL"   , "narrator": "", "text": "大丈夫？"},
        { "location": "340/SEL"   , "narrator": "", "text": "あれ？つばめは？"},
        { "location": "341/SEL"   , "narrator": "", "text": "ぴょんこｽｷ"},
        { "location": "342/ACT"   , "narrator": "", "text": "大丈夫？"},
        { "location": "343/TALK"  , "narrator": "ぴょんこ", "text": "はい。"},
        { "location": "344/ACT"   , "narrator": "", "text": "あれ？つばめは？"},
        { "location": "345/TALK"  , "narrator": "ぴょんこ", "text": "ちょっと一人で\n心の整理をしたかったので\n外してもらいました。"},
        { "location": "346/ACT"   , "narrator": "", "text": "ぴょんこｽｷ"},
        { "location": "349/TALK"  , "narrator": "ぴょんこ", "text": "ふふふっ。"},
        { "location": "350/TALK"  , "narrator": "ぴょんこ", "text": "こんな時にもブレない\n$handle$さんが\n大好きです♪"},
        { "location": "352/TALK"  , "narrator": "ぴょんこ", "text": "あーあ、\nそれにしてもですよ？"},
        { "location": "353/TALK"  , "narrator": "ぴょんこ", "text": "ついに私の過去の\n思い出が、赤裸々に\nなってしまうんですね。"},
        { "location": "354/TALK"  , "narrator": "ぴょんこ", "text": "これってほら、\nアレですよ？"},
        { "location": "355/TALK"  , "narrator": "ぴょんこ", "text": "お付き合いもだいぶ\n深まったときに、実家に\nご挨拶にお邪魔して――"},
        { "location": "356/TALK"  , "narrator": "ぴょんこ", "text": "そのとき相手の両親に\n娘の子供の頃のアルバムを\n見せられるのと同じです♪"},
        { "location": "357/SEL"   , "narrator": "", "text": "うわ、めちゃくちゃ嫌な儀式のやつだ"},
        { "location": "358/SEL"   , "narrator": "", "text": "うわ、なんか興奮してきた"},
        { "location": "359/SEL"   , "narrator": "", "text": "わかる"},
        { "location": "360/ACT"   , "narrator": "", "text": "うわ、めちゃくちゃ嫌な儀式のやつだ"},
        { "location": "361/TALK"  , "narrator": "ぴょんこ", "text": "ですよねー！"},
        { "location": "362/ACT"   , "narrator": "", "text": "うわ、なんか興奮してきた"},
        { "location": "363/TALK"  , "narrator": "ぴょんこ", "text": "うわー\nへんたいがいるー。"},
        { "location": "364/TALK"  , "narrator": "ぴょんこ", "text": "おまわりさん\nこっちです！"},
        { "location": "365/ACT"   , "narrator": "", "text": "わかる"},
        { "location": "367/TALK"  , "narrator": "ぴょんこ", "text": "だから～。"},
        { "location": "368/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこが\n何を言いたいか、\nもうわかってますよね？"},
        { "location": "369/SEL"   , "narrator": "", "text": "？"},
        { "location": "370/SEL"   , "narrator": "", "text": "言いたいことはわかるけど、そっとしておいて"},
        { "location": "371/SEL"   , "narrator": "", "text": "結婚しよう"},
        { "location": "372/ACT"   , "narrator": "", "text": "？"},
        { "location": "373/TALK"  , "narrator": "ぴょんこ", "text": "わざとならドエスですね。\n天然なら唐変木です。"},
        { "location": "374/ACT"   , "narrator": "", "text": "言いたいことはわかるけど、そっとしておいて"},
        { "location": "375/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんってば\nシャイなんだからー。"},
        { "location": "376/ACT"   , "narrator": "", "text": "結婚しよう"},
        { "location": "378/TALK"  , "narrator": "ぴょんこ", "text": "こらこらこらこら、\n先走るなー。"},
        { "location": "380/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこに言わせるなんて\nほんとに――"},
        { "location": "384/SEL"   , "narrator": "", "text": "ぴょんこ！？"},
        { "location": "385/ACT"   , "narrator": "", "text": "ぴょんこ！？"},
        { "location": "387/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん！？！？"},
        { "location": "388/TALK"  , "narrator": "ぴょんこ", "text": "どうしたぴょん？"},
        { "location": "389/SEL"   , "narrator": "", "text": "今ボーッとしてなかった？"},
        { "location": "390/SEL"   , "narrator": "", "text": "いや、なんでもない"},
        { "location": "391/ACT"   , "narrator": "", "text": "今ボーッとしてなかった？"},
        { "location": "392/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん？\nそんなことないぴょん。"},
        { "location": "393/ACT"   , "narrator": "", "text": "いや、なんでもない"},
        { "location": "394/TALK"  , "narrator": "ぴょんこ", "text": "今日の\n$handle$さんは\nちょっとおかしいぴょん。"},
        { "location": "395/TALK"  , "narrator": "ぴょんこ", "text": "まあ、\nおかしいのは今に始まった\n事じゃないけどな。"},
        { "location": "397/TALK"  , "narrator": "ぴょんこ", "text": "そんなことより～～～～。"},
        { "location": "398/TALK"  , "narrator": "ぴょんこ", "text": "いよいよ決死行が\n始まるわけですよ、\n$handle$さん！"},
        { "location": "399/SEL"   , "narrator": "", "text": "お、おう"},
        { "location": "400/SEL"   , "narrator": "", "text": "望むところ"},
        { "location": "401/ACT"   , "narrator": "", "text": "お、おう"},
        { "location": "402/ACT"   , "narrator": "", "text": "望むところ"},
        { "location": "404/TALK"  , "narrator": "ぴょんこ", "text": "きゃっ♪"},
        { "location": "405/TALK"  , "narrator": "ぴょんこ", "text": "……ｽｷ。"},
        { "location": "407/TALK"  , "narrator": "ぴょんこ", "text": "ですから、\nあと何回できるか\nわからないわけですよっ！"},
        { "location": "408/TALK"  , "narrator": "ぴょんこ", "text": "というわけで♪"},
        { "location": "409/TALK"  , "narrator": "ぴょんこ", "text": "レッツプレイ\nキスチケジャンケン♪"},
        { "location": "410/SEL"   , "narrator": "", "text": "やるやる！"},
        { "location": "411/SEL"   , "narrator": "", "text": "いや、遠慮します"},
        { "location": "412/ACT"   , "narrator": "", "text": "やるやる！"},
        { "location": "418/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんは、\n今キスチケを\n１枚も持っていませんね。"},
        { "location": "421/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんは、\n今キスチケを\n$pyonko_kissticket$枚持ってますね。"},
        { "location": "425/TALK"  , "narrator": "ぴょんこ", "text": "今、$handle$さんは\n$pyonko_kissticket$枚のキスチケを\n持っていますね♪"},
        { "location": "427/TALK"  , "narrator": "ぴょんこ", "text": "3枚以上持っている間は\n何度でも特別なキッスが\n出来ちゃいますよっ！"},
        { "location": "428/TALK"  , "narrator": "ぴょんこ", "text": "今回もどうですかっ！"},
        { "location": "430/TALK"  , "narrator": "ぴょんこ", "text": "というわけで！\nおめでとうございます！"},
        { "location": "431/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんは、\nキスチケを3枚以上\n獲得してますので！"},
        { "location": "432/TALK"  , "narrator": "ぴょんこ", "text": "今から特別なキッスを\n進呈しちゃいまーす♪"},
        { "location": "435/SEL"   , "narrator": "", "text": "やったー！"},
        { "location": "436/SEL"   , "narrator": "", "text": "今！？"},
        { "location": "437/SEL"   , "narrator": "", "text": "今はそういう気分じゃないから、また今度で"},
        { "location": "438/ACT"   , "narrator": "", "text": "やったー！"},
        { "location": "439/ACT"   , "narrator": "", "text": "今！？"},
        { "location": "440/TALK"  , "narrator": "ぴょんこ", "text": "今じゃなきゃ\nいつやるんですかっ！？"},
        { "location": "441/TALK"  , "narrator": "ぴょんこ", "text": "今でしょ！"},
        { "location": "442/SEL"   , "narrator": "", "text": "古くない？"},
        { "location": "443/ACT"   , "narrator": "", "text": "古くない？"},
        { "location": "445/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん？"},
        { "location": "446/ACT"   , "narrator": "", "text": "今はそういう気分じゃないから、また今度で"},
        { "location": "447/TALK"  , "narrator": "ぴょんこ", "text": "わかったぴょん。"},
        { "location": "448/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこはいつでも\nオッケーですから、\n気が向いた時にどうぞ♪"},
        { "location": "452/TALK"  , "narrator": "ぴょんこ", "text": "というわけで今回は、\n$handle$さんの\n好きな服で好きな所に！"},
        { "location": "453/TALK"  , "narrator": "ぴょんこ", "text": "これからぴょんこは、\n今、現実の私が着てる服に\n着替えてきます♪"},
        { "location": "454/TALK"  , "narrator": "ぴょんこ", "text": "いっぱい\n楽しんじゃって\nくださいねっ！"},
        { "location": "464/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん♪"},
        { "location": "465/TALK"  , "narrator": "ぴょんこ", "text": "どうですかっ？\nそれでは――"},
        { "location": "467/SEL"   , "narrator": "", "text": "頬、唇"},
        { "location": "468/SEL"   , "narrator": "", "text": "胸"},
        { "location": "469/SEL"   , "narrator": "", "text": "おなか"},
        { "location": "470/ACT"   , "narrator": "", "text": "頬、唇"},
        { "location": "474/ACT"   , "narrator": "", "text": "胸"},
        { "location": "479/ACT"   , "narrator": "", "text": "おなか"},
        { "location": "501/TALK"  , "narrator": "ぴょんこ", "text": "ふわあっ！"},
        { "location": "504/TALK"  , "narrator": "ぴょんこ", "text": "ふわあっ！"},
        { "location": "507/TALK"  , "narrator": "ぴょんこ", "text": "ふわあっ！"},
        { "location": "510/TALK"  , "narrator": "ぴょんこ", "text": "ふわあっ！"},
        { "location": "513/TALK"  , "narrator": "ぴょんこ", "text": "ふわあっ！"},
        { "location": "516/TALK"  , "narrator": "ぴょんこ", "text": "ふわあっ！"},
        { "location": "525/TALK"  , "narrator": "ぴょんこ", "text": "まさに\nメルティキッス♪"},
        { "location": "527/TALK"  , "narrator": "ぴょんこ", "text": "温かくて\n柔らかい…。"},
        { "location": "529/TALK"  , "narrator": "ぴょんこ", "text": "もっともっとー♪"},
        { "location": "533/TALK"  , "narrator": "ぴょんこ", "text": "な、なんだか\n思ったよりも全然\nドキドキしますねっ！"},
        { "location": "535/TALK"  , "narrator": "ぴょんこ", "text": "不思議と\n嫌じゃないぴょん♪"},
        { "location": "537/TALK"  , "narrator": "ぴょんこ", "text": "かまかま～～♪"},
        { "location": "541/TALK"  , "narrator": "ぴょんこ", "text": "おなかって……\nキスされると\nくすぐったいんですねっ…"},
        { "location": "543/TALK"  , "narrator": "ぴょんこ", "text": "デリケートなので\n優しくしてくださいねっ！"},
        { "location": "545/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんぴょん♪"},
        { "location": "548/SEL"   , "narrator": "", "text": "もう一度"},
        { "location": "549/SEL"   , "narrator": "", "text": "もうやめる"},
        { "location": "550/ACT"   , "narrator": "", "text": "もう一度"},
        { "location": "552/ACT"   , "narrator": "", "text": "もうやめる"},
        { "location": "570/TALK"  , "narrator": "ぴょんこ", "text": "はぁっ。\n想像以上に\n恥ずかしいですね……。"},
        { "location": "571/TALK"  , "narrator": "ぴょんこ", "text": "でも、とっても\n素敵な時間でした♪"},
        { "location": "572/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこはいつでも\nオッケーですから、\nまたしましょうね♪"},
        { "location": "579/TALK"  , "narrator": "ぴょんこ", "text": "というわけで！\nジャンケンしましょう、\nジャンケン♪"},
        { "location": "582/TALK"  , "narrator": "ぴょんこ", "text": "それじゃ、\nいきますよっ！"},
        { "location": "584/TALK"  , "narrator": "ぴょんこ", "text": "と思いましたけど、\n既に事後でしたね…。"},
        { "location": "606/TALK"  , "narrator": "ぴょんこ", "text": "ふわぁっ！\n負けちゃいました…。"},
        { "location": "610/TALK"  , "narrator": "ぴょんこ", "text": "約束通り、\nキスチケ１枚進呈ぴょん♪"},
        { "location": "616/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこの\n勝ちでーすっ♪"},
        { "location": "617/TALK"  , "narrator": "ぴょんこ", "text": "約束通り、\nキスチケ１枚没収ぴょん♪"},
        { "location": "622/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこの\n勝ちでーすっ♪"},
        { "location": "623/TALK"  , "narrator": "ぴょんこ", "text": "というわけで、\nプレゼントはナシ！！"},
        { "location": "629/TALK"  , "narrator": "ぴょんこ", "text": "ふぅ……\nとっても楽しかったです♪"},
        { "location": "633/TALK"  , "narrator": "ぴょんこ", "text": "って！\nああっ！！"},
        { "location": "634/TALK"  , "narrator": "ぴょんこ", "text": "おめでとうございます！\nキスチケ３枚以上\nゲットしちゃいましたね♪"},
        { "location": "635/TALK"  , "narrator": "ぴょんこ", "text": "というわけで！\n早速今から特別なキッスを\n進呈しちゃいまーす♪"},
        { "location": "642/ACT"   , "narrator": "", "text": "いや、遠慮します"},
        { "location": "643/TALK"  , "narrator": "ぴょんこ", "text": "えーっ…\nいけず～ぅ。"},
        { "location": "646/TALK"  , "narrator": "ぴょんこ", "text": "……。"},
        { "location": "647/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さん。"},
        { "location": "648/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこがこんな事を\n言うのは、ちょっと\nキャラじゃないですけど。"},
        { "location": "650/TALK"  , "narrator": "ぴょんこ", "text": "いつも私のことを\n大切にしてくれて\nありがとうございます。"},
        { "location": "652/TALK"  , "narrator": "ぴょんこ", "text": "これから貴方が向かう、\n私の記憶の旅は、私の\n今までの生き様です。"},
        { "location": "653/TALK"  , "narrator": "ぴょんこ", "text": "それを見て、貴方が私に\n失望してしまわないか、\n正直言えば怖いです。"},
        { "location": "654/TALK"  , "narrator": "ぴょんこ", "text": "でも、例えそこで、\n貴方がどんな心変わりを\nしたとしても――"},
        { "location": "655/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこと今まで\n遊んできた思い出や、\nぴょんこの想いは……"},
        { "location": "656/TALK"  , "narrator": "ぴょんこ", "text": "決して消えることは\nありませんから。"},
        { "location": "657/TALK"  , "narrator": "ぴょんこ", "text": "……大好きです、\n$handle$さん。"},
        { "location": "658/SEL"   , "narrator": "", "text": "ぴょんこ……"},
        { "location": "659/SEL"   , "narrator": "", "text": "やめてそれ死亡フラグくさいよ"},
        { "location": "660/ACT"   , "narrator": "", "text": "ぴょんこ……"},
        { "location": "662/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんっ！"},
        { "location": "663/ACT"   , "narrator": "", "text": "やめてそれ死亡フラグくさいよ"},
        { "location": "665/TALK"  , "narrator": "ぴょんこ", "text": "そんなもの\nぴょんこがチートで\n蹴り倒してくれるわです！"},
        { "location": "666/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんっ！"},
        { "location": "670/TALK"  , "narrator": "アーヤ", "text": "うわー、\n今回は大変だったわー。"},
        { "location": "671/TALK"  , "narrator": "ぴょんこ", "text": "やっぱね。"},
        { "location": "673/TALK"  , "narrator": "アーヤ", "text": "え？"},
        { "location": "43/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>7月24日　5:34 PM</color>\n豊洲で発生したフェノメノンの内部にて。"},
        { "location": "115/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "117/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "119/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "121/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "123/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "183/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Information:0x02】</color>\nココロスフィアとの通信が\n回復しました。(110)"},
        { "location": "489/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "520/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"},
        { "location": "588/DIALOG", "narrator": "Dialog_Notice", "text": "<color=green>【TRI-OS Plug-in:Libralian】</color>\n\n<color=red>\nOKボタンを押すと、この選択は確定します。プレイの有無にかかわらず、以後やり直しはできなくなります。\n</color>\n以降ジャンケン終了までの間、通信環境が悪い場所などでの継続はお薦めしません。\n\nここでOKを押す前にアプリを終了（タスクキル）すれば、ギリギリキャンセル可能です。"},
        { "location": "612/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:Libralian】</color>\n\n<color=green>【キスチケ】</color>を\n１枚ゲットしました！"},
        { "location": "619/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:Libralian】</color>\n\n<color=green>【キスチケ】</color>を\n１枚失いました…。"},
        { "location": "678/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Information:0x11】</color>\n\nKokoro-Gate\n<color=blue>[Address:2xD43]</color>\nsave succeed !\nAnd hibernation a gate.\n\n時空間整合性維持のため、\nココロゲートを一旦停止し\n現実世界に戻ります。\n(102)\n"}
    ]
