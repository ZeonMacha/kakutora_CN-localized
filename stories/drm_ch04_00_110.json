        { "location": "122/SCENARIO", "narrator": "", "text": "60_人生津々浦々"},
        { "location": "148/TALK"    , "narrator": "みやび", "text": "観念して"},
        { "location": "149/TALK"    , "narrator": "みやび", "text": "本当のことを言え"},
        { "location": "152/SEL"     , "narrator": "", "text": "許してください"},
        { "location": "153/SEL"     , "narrator": "", "text": "えっと……何の話？"},
        { "location": "154/SEL"     , "narrator": "", "text": "みやびにはいつも本気"},
        { "location": "155/ACT"     , "narrator": "", "text": "許してください"},
        { "location": "156/TALK"    , "narrator": "みやび", "text": "まあまあ"},
        { "location": "157/TALK"    , "narrator": "みやび", "text": "そう言わず"},
        { "location": "158/ACT"     , "narrator": "", "text": "えっと……何の話？"},
        { "location": "159/TALK"    , "narrator": "みやび", "text": "それは"},
        { "location": "160/TALK"    , "narrator": "みやび", "text": "アレの話だ"},
        { "location": "161/ACT"     , "narrator": "", "text": "みやびにはいつも本気"},
        { "location": "171/TALK"    , "narrator": "みやび", "text": "ふむ"},
        { "location": "173/TALK"    , "narrator": "みやび", "text": "いい心がけ"},
        { "location": "174/TALK"    , "narrator": "みやび", "text": "ならば"},
        { "location": "175/TALK"    , "narrator": "みやび", "text": "それを証明してもらおう"},
        { "location": "177/TALK"    , "narrator": "みやび", "text": "$handle$は"},
        { "location": "178/TALK"    , "narrator": "みやび", "text": "トライナリー全員と話しているな？"},
        { "location": "180/SEL"     , "narrator": "", "text": "秘密"},
        { "location": "181/SEL"     , "narrator": "", "text": "ノーコメント"},
        { "location": "182/SEL"     , "narrator": "", "text": "やきもち妬いてる？"},
        { "location": "183/ACT"     , "narrator": "", "text": "秘密"},
        { "location": "185/TALK"    , "narrator": "みやび", "text": "ほほう"},
        { "location": "186/TALK"    , "narrator": "みやび", "text": "それは"},
        { "location": "187/TALK"    , "narrator": "みやび", "text": "肯定と見るぞ？"},
        { "location": "189/SEL"     , "narrator": "", "text": "どうぞ"},
        { "location": "190/SEL"     , "narrator": "", "text": "好きにすれば"},
        { "location": "191/ACT"     , "narrator": "", "text": "どうぞ"},
        { "location": "192/TALK"    , "narrator": "みやび", "text": "なるほど"},
        { "location": "193/TALK"    , "narrator": "みやび", "text": "それでいいのか"},
        { "location": "194/ACT"     , "narrator": "", "text": "好きにすれば"},
        { "location": "195/TALK"    , "narrator": "みやび", "text": "ほう"},
        { "location": "196/TALK"    , "narrator": "みやび", "text": "勝手に解釈しよう"},
        { "location": "198/TALK"    , "narrator": "みやび", "text": "さらばだ"},
        { "location": "199/ACT"     , "narrator": "", "text": "ノーコメント"},
        { "location": "200/TALK"    , "narrator": "みやび", "text": "政治家か！"},
        { "location": "201/TALK"    , "narrator": "みやび", "text": "全く"},
        { "location": "202/TALK"    , "narrator": "みやび", "text": "一筋縄ではいかぬ"},
        { "location": "203/TALK"    , "narrator": "みやび", "text": "ぬぬぬぬぬ"},
        { "location": "204/ACT"     , "narrator": "", "text": "やきもち妬いてる？"},
        { "location": "216/TALK"    , "narrator": "みやび", "text": "そう思うがいい"},
        { "location": "217/TALK"    , "narrator": "みやび", "text": "$handle$め"},
        { "location": "218/TALK"    , "narrator": "みやび", "text": "$handle$のくせに！"},
