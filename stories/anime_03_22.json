    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "アニメ第22話"},
        { "location": "47/TALK"   , "narrator": "千羽鶴", "text": "ごきげんよう、\n$handle$。"},
        { "location": "49/TALK"   , "narrator": "千羽鶴", "text": "いつも通り、今回も\n逢瀬つばめの解説を\nするだけでいい？"},
        { "location": "51/TALK"   , "narrator": "千羽鶴", "text": "いつも通り、今回も\n國政綾水の解説を\nするだけでいい？"},
        { "location": "53/TALK"   , "narrator": "千羽鶴", "text": "いつも通り、今回も\nガブリエラの解説を\nするだけでいい？"},
        { "location": "55/TALK"   , "narrator": "千羽鶴", "text": "いつも通り、今回も\n恋ヶ崎みやびの解説を\nするだけでいい？"},
        { "location": "57/SEL"    , "narrator": "", "text": "はい"},
        { "location": "58/SEL"    , "narrator": "", "text": "いいえ"},
        { "location": "59/ACT"    , "narrator": "", "text": "はい"},
        { "location": "61/TALK"   , "narrator": "千羽鶴", "text": "よかった。\n私も助かる。\nこれぞWIN-WINね。"},
        { "location": "63/ACT"    , "narrator": "", "text": "いいえ"},
        { "location": "64/TALK"   , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "71/TALK"   , "narrator": "千羽鶴", "text": "<size=45>どーん！</size>"},
        { "location": "72/SEL"    , "narrator": "", "text": "いきなり！？\nどうしたの？"},
        { "location": "73/ACT"    , "narrator": "", "text": "いきなり！？\nどうしたの？"},
        { "location": "75/TALK"   , "narrator": "千羽鶴", "text": "前回大事件が起きた。\n心当たりがある人は\n正直に手を上げて。"},
        { "location": "76/TALK"   , "narrator": "千羽鶴", "text": "ちー怒らないから。"},
        { "location": "86/SEL"    , "narrator": "", "text": "わ、わかりません"},
        { "location": "87/SEL"    , "narrator": "", "text": "あるような気がする"},
        { "location": "88/ACT"    , "narrator": "", "text": "わ、わかりません"},
        { "location": "91/TALK"   , "narrator": "千羽鶴", "text": "<size=45>こーら！</size>"},
        { "location": "92/SEL"    , "narrator": "", "text": "ホントにわからないんだけど！"},
        { "location": "93/ACT"    , "narrator": "", "text": "ホントにわからないんだけど！"},
        { "location": "95/TALK"   , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "96/TALK"   , "narrator": "千羽鶴", "text": "貴方は私がずっとお願い\nしていたことを履行せず、\nそれすらも忘れたと。"},
        { "location": "97/TALK"   , "narrator": "千羽鶴", "text": "私との関係なんて、\nそんなものだったのね。"},
        { "location": "98/SEL"    , "narrator": "", "text": "何の事か、教えてもらってもいいですか？"},
        { "location": "99/ACT"    , "narrator": "", "text": "何の事か、教えてもらってもいいですか？"},
        { "location": "101/ACT"   , "narrator": "", "text": "あるような気がする"},
        { "location": "102/TALK"  , "narrator": "千羽鶴", "text": "<size=45>こーら！</size>"},
        { "location": "103/SEL"   , "narrator": "", "text": "怒らないって言ったじゃん！"},
        { "location": "104/ACT"   , "narrator": "", "text": "怒らないって言ったじゃん！"},
        { "location": "107/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "109/TALK"  , "narrator": "千羽鶴", "text": "今のは怒ったんじゃない。\nちょっと喉が渇いただけ。"},
        { "location": "110/SEL"   , "narrator": "", "text": "コーラ…？"},
        { "location": "111/SEL"   , "narrator": "", "text": "シャキーン！"},
        { "location": "112/ACT"   , "narrator": "", "text": "コーラ…？"},
        { "location": "113/ACT"   , "narrator": "", "text": "シャキーン！"},
        { "location": "116/TALK"  , "narrator": "千羽鶴", "text": "と、とにかく！"},
        { "location": "118/TALK"  , "narrator": "千羽鶴", "text": "貴方には心当たりがある。\nよって有罪！"},
        { "location": "119/SEL"   , "narrator": "", "text": "一応何の事か、教えてもらってもいいですか？"},
        { "location": "120/ACT"   , "narrator": "", "text": "何の事か、教えてもらってもいいですか？"},
        { "location": "124/SEL"   , "narrator": "", "text": "身に覚えがありません！"},
        { "location": "125/ACT"   , "narrator": "", "text": "身に覚えがありません！"},
        { "location": "127/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "128/TALK"  , "narrator": "千羽鶴", "text": "そうね。\n確かに貴方自身は\n何もやっていない。"},
        { "location": "129/TALK"  , "narrator": "千羽鶴", "text": "けど貴方たち、そちらの\nセカイの【総意】としては\nとんでもない事やってる。"},
        { "location": "130/SEL"   , "narrator": "", "text": "要するに、他の人がやってるってこと？"},
        { "location": "131/ACT"   , "narrator": "", "text": "要するに、他の人がやってるってこと？"},
        { "location": "133/TALK"  , "narrator": "千羽鶴", "text": "そう。\nよって――"},
        { "location": "136/TALK"  , "narrator": "千羽鶴", "text": "<size=40>連帯責任！</size>"},
        { "location": "137/SEL"   , "narrator": "", "text": "そんなぁ～(TT)"},
        { "location": "138/SEL"   , "narrator": "", "text": "他の人が何をやったのか教えて？"},
        { "location": "139/ACT"   , "narrator": "", "text": "そんなぁ～(TT)"},
        { "location": "140/TALK"  , "narrator": "千羽鶴", "text": "泣いてもダメ。\nそれくらいのことを\nしたんだから。"},
        { "location": "141/SEL"   , "narrator": "", "text": "他の人は一体何をしたんだ！？"},
        { "location": "142/ACT"   , "narrator": "", "text": "他の人は一体何をしたんだ！？"},
        { "location": "144/ACT"   , "narrator": "", "text": "他の人が何をやったのか教えて？"},
        { "location": "145/TALK"  , "narrator": "千羽鶴", "text": "ええ。"},
        { "location": "150/TALK"  , "narrator": "千羽鶴", "text": "貴方は前回、國政綾水と\nガブリエラのココロの\nサポートをサボった。"},
        { "location": "152/TALK"  , "narrator": "千羽鶴", "text": "貴方は前回、國政綾水の\nココロサポートを\nサボった。"},
        { "location": "154/TALK"  , "narrator": "千羽鶴", "text": "貴方は前回、ガブリエラの\nココロサポートを\nサボった。"},
        { "location": "156/TALK"  , "narrator": "千羽鶴", "text": "貴方の世界の住人の大半が\n私との約束を破った。"},
        { "location": "157/TALK"  , "narrator": "千羽鶴", "text": "國政綾水、もしくは\nガブリエラのココロ\nサポートをサボったの。"},
        { "location": "159/TALK"  , "narrator": "千羽鶴", "text": "そのせいで、\n蝶が羽ばたいてしまった。"},
        { "location": "160/SEL"   , "narrator": "", "text": "蝶？なに？"},
        { "location": "161/SEL"   , "narrator": "", "text": "歴史が変わっちゃったんだね"},
        { "location": "162/ACT"   , "narrator": "", "text": "蝶？なに？"},
        { "location": "163/TALK"  , "narrator": "千羽鶴", "text": "バタフライエフェクト。"},
        { "location": "164/TALK"  , "narrator": "千羽鶴", "text": "些細な事でも、未来は\n大きく変わってしまう\nという物事の例え。"},
        { "location": "165/ACT"   , "narrator": "", "text": "歴史が変わっちゃったんだね"},
        { "location": "166/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "168/TALK"  , "narrator": "千羽鶴", "text": "私の緻密な計算結果を\n貴方は狂わせてしまった。"},
        { "location": "169/TALK"  , "narrator": "千羽鶴", "text": "お陰で世界線は更に\n誤差を大きく生み、\nエンディングは遠のいた！"},
        { "location": "171/SEL"   , "narrator": "", "text": "ごめんね？"},
        { "location": "172/SEL"   , "narrator": "", "text": "それは本当に彼女たちのためなのかな？"},
        { "location": "173/ACT"   , "narrator": "", "text": "ごめんね？"},
        { "location": "174/TALK"  , "narrator": "千羽鶴", "text": "いや。\n許さない。"},
        { "location": "175/ACT"   , "narrator": "", "text": "それは本当に彼女たちのためなのかな？"},
        { "location": "176/TALK"  , "narrator": "千羽鶴", "text": "少なくとも私は\nそう思ってやってる。"},
        { "location": "177/TALK"  , "narrator": "千羽鶴", "text": "彼女たちと\nこのセカイのためだと。"},
        { "location": "180/SEL"   , "narrator": "", "text": "酷い奴らだ！"},
        { "location": "181/SEL"   , "narrator": "", "text": "それは本当に彼女たちのためなのかな？"},
        { "location": "182/ACT"   , "narrator": "", "text": "酷い奴らだ！"},
        { "location": "183/TALK"  , "narrator": "千羽鶴", "text": "そうね。"},
        { "location": "184/TALK"  , "narrator": "千羽鶴", "text": "でもそれは、\n貴方の世界の人たちが\nやってしまったこと。"},
        { "location": "185/ACT"   , "narrator": "", "text": "それは本当に彼女たちのためなのかな？"},
        { "location": "186/TALK"  , "narrator": "千羽鶴", "text": "少なくとも私は\nそう思ってやってる。"},
        { "location": "187/TALK"  , "narrator": "千羽鶴", "text": "彼女たちと\nこのセカイのためだと。"},
        { "location": "190/TALK"  , "narrator": "千羽鶴", "text": "というわけで、\nちーと貴方は――"},
        { "location": "193/TALK"  , "narrator": "千羽鶴", "text": "<size=45>絶</size>"},
        { "location": "196/TALK"  , "narrator": "千羽鶴", "text": "<size=70>交</size>"},
        { "location": "200/SEL"   , "narrator": "", "text": "エー…"},
        { "location": "201/ACT"   , "narrator": "", "text": "エー…"},
        { "location": "203/TALK"  , "narrator": "千羽鶴", "text": "エーって言ってもダメ。"},
        { "location": "206/TALK"  , "narrator": "千羽鶴", "text": "絶交した二人は\n口を訊かないのが流儀。"},
        { "location": "209/TALK"  , "narrator": "千羽鶴", "text": "というわけで、ここからはチャットで会話をすることにする。"},
        { "location": "211/SEL"   , "narrator": "", "text": "そんなー！"},
        { "location": "212/SEL"   , "narrator": "", "text": "これは新鮮！"},
        { "location": "213/ACT"   , "narrator": "", "text": "そんなー！"},
        { "location": "214/TALK"  , "narrator": "千羽鶴", "text": "泣いてもダメ。"},
        { "location": "215/ACT"   , "narrator": "", "text": "これは新鮮！"},
        { "location": "216/TALK"  , "narrator": "千羽鶴", "text": "ポジティブな人。"},
        { "location": "218/TALK"  , "narrator": "千羽鶴", "text": "話を戻すと、一度バタフライエフェクトが発生してしまうと、もとの理想的な世界線に近づけるためにはかなりのパワーを要する。ちょっとズレたからちょっと戻す、みたいなのは難しい。"},
        { "location": "219/TALK"  , "narrator": "千羽鶴", "text": "世界線はいわば一方通行の道。１から２へ進むのは一瞬でも２から１へは１年かかることもある。"},
        { "location": "221/TALK"  , "narrator": "千羽鶴", "text": "貴方が前回、彼女たちのココロゲートで葛藤の解消を行わなかったことによって、いわばナビが示した道とは違う道に入ってしまったわけだけど、その道は全部一方通行だから。"},
        { "location": "223/TALK"  , "narrator": "千羽鶴", "text": "貴方の世界に住む不特定大半が前回、彼女たちのココロゲートで葛藤の解消を行わなかったことによって、いわばナビが示した道とは違う道に入ってしまったわけだけど、その道は全部一方通行だから。"},
        { "location": "225/TALK"  , "narrator": "千羽鶴", "text": "本来なら一方通行の道なりに従って、グルグルと延々迂回しながらもとの道に戻る方法を考えつつ進んでいかなければならない。けど私たちにはもう時間がない。"},
        { "location": "227/SEL"   , "narrator": "", "text": "ちーちゃん長いよ"},
        { "location": "228/SEL"   , "narrator": "", "text": "ちーちゃんは怒ると延々長文メールを送りつけてくるタイプだ"},
        { "location": "229/ACT"   , "narrator": "", "text": "ちーちゃん長いよ"},
        { "location": "230/TALK"  , "narrator": "千羽鶴", "text": "仕方ない。説明する為だから。"},
        { "location": "231/ACT"   , "narrator": "", "text": "ちーちゃんは怒ると延々長文メールを送りつけてくるタイプだ"},
        { "location": "232/TALK"  , "narrator": "千羽鶴", "text": "！？"},
        { "location": "234/TALK"  , "narrator": "千羽鶴", "text": "続きを。"},
        { "location": "235/TALK"  , "narrator": "千羽鶴", "text": "そのため、私はこれから逆走ルートを計算することにする。貴方にとってはちょっとビックリすることもあるかもしれない。でも、もう逆走するしかない。"},
        { "location": "237/SEL"   , "narrator": "", "text": "もう仲直りしようよ"},
        { "location": "238/SEL"   , "narrator": "", "text": "普通にお話しよ？"},
        { "location": "239/ACT"   , "narrator": "", "text": "もう仲直りしようよ"},
        { "location": "240/TALK"  , "narrator": "千羽鶴", "text": "やだ"},
        { "location": "241/ACT"   , "narrator": "", "text": "普通にお話しよ？"},
        { "location": "242/TALK"  , "narrator": "千羽鶴", "text": "きらい"},
        { "location": "244/TALK"  , "narrator": "千羽鶴", "text": "とはいえ"},
        { "location": "245/TALK"  , "narrator": "千羽鶴", "text": "貴方を失ってしまうのは私にとっても不利益だから、"},
        { "location": "246/TALK"  , "narrator": "千羽鶴", "text": "悩み中。"},
        { "location": "248/SEL"   , "narrator": "", "text": "ちーちゃん好き"},
        { "location": "249/SEL"   , "narrator": "", "text": "ちーちゃん嫌い"},
        { "location": "250/SEL"   , "narrator": "", "text": "ちーちゃんとデートしたい"},
        { "location": "251/ACT"   , "narrator": "", "text": "ちーちゃん好き"},
        { "location": "252/TALK"  , "narrator": "千羽鶴", "text": "非攻略対象。"},
        { "location": "254/ACT"   , "narrator": "", "text": "ちーちゃん嫌い"},
        { "location": "255/TALK"  , "narrator": "千羽鶴", "text": "がーん！！！"},
        { "location": "257/ACT"   , "narrator": "", "text": "ちーちゃんとデートしたい"},
        { "location": "258/TALK"  , "narrator": "千羽鶴", "text": "気が散る。"},
        { "location": "261/TALK"  , "narrator": "千羽鶴", "text": "まあでも"},
        { "location": "262/TALK"  , "narrator": "千羽鶴", "text": "今回は"},
        { "location": "263/TALK"  , "narrator": "千羽鶴", "text": "仲直りしようと思う。"},
        { "location": "265/TALK"  , "narrator": "千羽鶴", "text": "その代わりというわけじゃないけど、もしまだやってないようならこのOSの評価をつけて欲しい。"},
        { "location": "266/TALK"  , "narrator": "千羽鶴", "text": "この評価は、TRI-OSの異世界間通信の精度を上げるためにとても重要。ホントはもっと早くやってもらうべきだった。"},
        { "location": "267/TALK"  , "narrator": "千羽鶴", "text": "貴方の協力が必要なの。だからお願いします。"},
        { "location": "271/TALK"  , "narrator": "千羽鶴", "text": "ありがと。"},
        { "location": "272/TALK"  , "narrator": "千羽鶴", "text": "ちーはご満悦。"},
        { "location": "274/TALK"  , "narrator": "千羽鶴", "text": "「後にする」はいつするの？"},
        { "location": "275/TALK"  , "narrator": "千羽鶴", "text": "信じてるから。"},
        { "location": "278/TALK"  , "narrator": "千羽鶴", "text": "その代わり"},
        { "location": "279/TALK"  , "narrator": "千羽鶴", "text": "もう嫌いとか言わないで。"},
        { "location": "283/TALK"  , "narrator": "千羽鶴", "text": "ただいま。"},
        { "location": "284/SEL"   , "narrator": "", "text": "おかえり！"},
        { "location": "285/SEL"   , "narrator": "", "text": "結婚しよう！"},
        { "location": "286/ACT"   , "narrator": "", "text": "おかえり！"},
        { "location": "287/TALK"  , "narrator": "千羽鶴", "text": "ええ。"},
        { "location": "288/ACT"   , "narrator": "", "text": "結婚しよう！"},
        { "location": "291/TALK"  , "narrator": "千羽鶴", "text": "<size=40>私非！！</size>"},
        { "location": "292/SEL"   , "narrator": "", "text": "なに！？"},
        { "location": "293/ACT"   , "narrator": "", "text": "なに！？"},
        { "location": "295/TALK"  , "narrator": "千羽鶴", "text": "毎回言うには\n長くて疲れるから、\n短縮型を作ってみた。"},
        { "location": "296/TALK"  , "narrator": "千羽鶴", "text": "読み方は任せる。\n「しひ！」でも\n「わたひ！」でも。"},
        { "location": "298/TALK"  , "narrator": "千羽鶴", "text": "というわけで、少し\nなごみモード、及び\nラブい系モードは終了。"},
        { "location": "299/TALK"  , "narrator": "千羽鶴", "text": "真面目な話に戻る。"},
        { "location": "300/TALK"  , "narrator": "千羽鶴", "text": "今からいつも通り\n記録映像を見てもらう\nことになるけど。"},
        { "location": "301/TALK"  , "narrator": "千羽鶴", "text": "当初予定していた\n筋書きより、割と大胆に\n流れを変更している。"},
        { "location": "302/TALK"  , "narrator": "千羽鶴", "text": "その理由は\n先ほど言ったとおり。\n逆走せざるを得ないから。"},
        { "location": "303/TALK"  , "narrator": "千羽鶴", "text": "その為、当初はかなり\n平穏に終わらせる予定\nだった筋書きは変更。"},
        { "location": "304/TALK"  , "narrator": "千羽鶴", "text": "彼女たちにとって、\nかなりの痛みを伴う\nルートへ舵を切る。"},
        { "location": "305/TALK"  , "narrator": "千羽鶴", "text": "そうせざるを得なく\nなったことは\n理解して欲しい。"},
        { "location": "306/TALK"  , "narrator": "千羽鶴", "text": "彼女たちの司書が\n私の理想に反旗を翻す以上\n仕方のないことなの。"},
        { "location": "308/SEL"   , "narrator": "", "text": "$me$も同罪だよね"},
        { "location": "309/SEL"   , "narrator": "", "text": "$me$は司書にそそのかされただけだよ"},
        { "location": "310/ACT"   , "narrator": "", "text": "$me$も同罪だよね"},
        { "location": "311/TALK"  , "narrator": "千羽鶴", "text": "んー、まあ。\n普通に接してたのなら\n完全に同罪だけど……"},
        { "location": "312/TALK"  , "narrator": "千羽鶴", "text": "異世界間交流だし、\n今回はギリギリセーフ。"},
        { "location": "313/TALK"  , "narrator": "千羽鶴", "text": "貴方に出来る事は\n限られてるし。"},
        { "location": "314/TALK"  , "narrator": "千羽鶴", "text": "今回は司書の暴走が\n原因だから、貴方に\n直接的な罪はない。"},
        { "location": "315/ACT"   , "narrator": "", "text": "$me$は司書にそそのかされただけだよ"},
        { "location": "316/TALK"  , "narrator": "千羽鶴", "text": "まあ…そうね。"},
        { "location": "317/TALK"  , "narrator": "千羽鶴", "text": "確かに、\n貴方に出来る事は\n限られてる。"},
        { "location": "319/SEL"   , "narrator": "", "text": "よかった！"},
        { "location": "320/SEL"   , "narrator": "", "text": "なんか後ろめたい"},
        { "location": "321/SEL"   , "narrator": "", "text": "でもそれなら、なんで開口一番怒ったの？"},
        { "location": "322/ACT"   , "narrator": "", "text": "よかった！"},
        { "location": "323/TALK"  , "narrator": "千羽鶴", "text": "ええ。"},
        { "location": "324/ACT"   , "narrator": "", "text": "なんか後ろめたい"},
        { "location": "325/TALK"  , "narrator": "千羽鶴", "text": "優しい人。"},
        { "location": "326/ACT"   , "narrator": "", "text": "でもそれなら、なんで開口一番怒ったの？"},
        { "location": "327/TALK"  , "narrator": "千羽鶴", "text": "まあ、それは…、\nちょっと貴方に\n愚痴ってみたかっただけ。"},
        { "location": "330/SEL"   , "narrator": "", "text": "で、$me$もその連帯責任だと"},
        { "location": "331/ACT"   , "narrator": "", "text": "で、$me$もその連帯責任だと"},
        { "location": "333/TALK"  , "narrator": "千羽鶴", "text": "まあ、それは…、\nちょっと貴方に\n愚痴ってみたかっただけ。"},
        { "location": "334/SEL"   , "narrator": "", "text": "えー！？"},
        { "location": "335/ACT"   , "narrator": "", "text": "えー！？"},
        { "location": "337/TALK"  , "narrator": "千羽鶴", "text": "最近肩が凝っちゃって、\n発散させたくて。\nだから貴方に罪はない。"},
        { "location": "339/TALK"  , "narrator": "千羽鶴", "text": "ていうか、\nインパクト\nあったでしょ？"},
        { "location": "340/TALK"  , "narrator": "千羽鶴", "text": "普通に説明するより\n頭に焼き付いたと思う。"},
        { "location": "341/TALK"  , "narrator": "千羽鶴", "text": "私にとっては、\nそれくらい衝撃的な\n出来事だったから。"},
        { "location": "342/TALK"  , "narrator": "千羽鶴", "text": "というわけで、\n次は貴方が\n衝撃を受ける番。"},
        { "location": "344/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/100MB 6:28】</color>"},
        { "location": "345/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/33MB 6:28】</color>"},
        { "location": "346/SEL"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "347/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/100MB 6:28】</color>"},
        { "location": "348/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "354/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/33MB 6:28】</color>"},
        { "location": "355/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "361/ACT"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "362/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "395/TALK"  , "narrator": "千羽鶴", "text": "というわけで、"},
        { "location": "396/TALK"  , "narrator": "千羽鶴", "text": "最大幸福な未来へ続く道を\n維持する為に、少々困難な\n道へと進むことになった。"},
        { "location": "397/TALK"  , "narrator": "千羽鶴", "text": "何かあれば。"},
        { "location": "399/SEL"   , "narrator": "", "text": "最大幸福な未来に進む為に最大不幸っぽい状況になってるんですが"},
        { "location": "400/SEL"   , "narrator": "", "text": "神楽のアレは何が起こったの？"},
        { "location": "401/SEL"   , "narrator": "", "text": "神楽が展開した世界の中で出てきてた背後霊みたいなのは何？"},
        { "location": "402/SEL"   , "narrator": "", "text": "特にない \n<color=blue>（※先へ進みます）</color>"},
        { "location": "403/ACT"   , "narrator": "", "text": "最大幸福な未来に進む為に最大不幸っぽい状況になってるんですが"},
        { "location": "404/TALK"  , "narrator": "千羽鶴", "text": "そうね。\n過程だから。"},
        { "location": "405/TALK"  , "narrator": "千羽鶴", "text": "例えば貴方は学生の頃、\n塾や部活なんかを\nやっていたことはある？"},
        { "location": "406/SEL"   , "narrator": "", "text": "やっていた"},
        { "location": "407/SEL"   , "narrator": "", "text": "やってない"},
        { "location": "408/SEL"   , "narrator": "", "text": "現在進行形です"},
        { "location": "409/ACT"   , "narrator": "", "text": "やっていた"},
        { "location": "410/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "411/ACT"   , "narrator": "", "text": "やってない"},
        { "location": "412/TALK"  , "narrator": "千羽鶴", "text": "なるほど。\nじゃあ想像して。"},
        { "location": "413/ACT"   , "narrator": "", "text": "現在進行形です"},
        { "location": "414/TALK"  , "narrator": "千羽鶴", "text": "頑張って。"},
        { "location": "416/TALK"  , "narrator": "千羽鶴", "text": "やってる最中、\n凄く嫌な時が\nあったと思う。"},
        { "location": "417/TALK"  , "narrator": "千羽鶴", "text": "もっと言えば、\n学校に通うこと自体を\nそう思ってるかも。"},
        { "location": "418/TALK"  , "narrator": "千羽鶴", "text": "でも、それは将来において\n基本的幸福を享受する\nために必要なこと。"},
        { "location": "419/TALK"  , "narrator": "千羽鶴", "text": "少し視点を変えた\n例も挙げてみる。"},
        { "location": "420/TALK"  , "narrator": "千羽鶴", "text": "親は概ね、\n子供の幸せを願う故に、\n敢えて厳しくする。"},
        { "location": "421/TALK"  , "narrator": "千羽鶴", "text": "親が子供に勉強しろと\n言うのは、経験によって\n未来を想像できるから。"},
        { "location": "422/TALK"  , "narrator": "千羽鶴", "text": "でも、\n子供は経験が無いから\n未来を想像できない。"},
        { "location": "423/TALK"  , "narrator": "千羽鶴", "text": "それと今回の件は\n完全に当てはまる。"},
        { "location": "424/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "426/ACT"   , "narrator": "", "text": "神楽のアレは何が起こったの？"},
        { "location": "430/TALK"  , "narrator": "千羽鶴", "text": "これのこと？"},
        { "location": "431/SEL"   , "narrator": "", "text": "そうです"},
        { "location": "432/SEL"   , "narrator": "", "text": "違う"},
        { "location": "433/ACT"   , "narrator": "", "text": "そうです"},
        { "location": "434/TALK"  , "narrator": "千羽鶴", "text": "確かに\n気になるのもわかる。"},
        { "location": "435/TALK"  , "narrator": "千羽鶴", "text": "普通、どんなに怒りに\n満ちあふれたとしても、\nこうはならないもの。"},
        { "location": "436/TALK"  , "narrator": "千羽鶴", "text": "結論から言うと、\nこれはクランが心の中で\n活性化している状態。"},
        { "location": "437/TALK"  , "narrator": "千羽鶴", "text": "彼女がそうであったように\nこの後大抵の場合は\nフェノメノンを発症する。"},
        { "location": "438/SEL"   , "narrator": "", "text": "そこまで思い詰めたの？"},
        { "location": "439/ACT"   , "narrator": "", "text": "そこまで思い詰めたの？"},
        { "location": "441/TALK"  , "narrator": "千羽鶴", "text": "確かに、会話内容や\n起こっている事件から\nすれば疑問なのはわかる。"},
        { "location": "442/TALK"  , "narrator": "千羽鶴", "text": "愛する人が殺されたり、\n有り金全部溶かしたとか\nそういうわけじゃないし。"},
        { "location": "443/TALK"  , "narrator": "千羽鶴", "text": "でも、感情の抑揚は\n人それぞれ。"},
        { "location": "444/TALK"  , "narrator": "千羽鶴", "text": "バックボーンや\n大事にしていることも、\n彼女にしかわからない。"},
        { "location": "445/TALK"  , "narrator": "千羽鶴", "text": "だから、それらが刺激\nされれば、どんな状況\nでも発症はあり得る。"},
        { "location": "446/TALK"  , "narrator": "千羽鶴", "text": "大きな力が\nプラスされれば。"},
        { "location": "447/SEL"   , "narrator": "", "text": "大きな力って！？"},
        { "location": "448/ACT"   , "narrator": "", "text": "大きな力って！？"},
        { "location": "450/TALK"  , "narrator": "千羽鶴", "text": "外的な力。"},
        { "location": "451/TALK"  , "narrator": "千羽鶴", "text": "クランを分離するための\n特別な力。"},
        { "location": "454/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "456/ACT"   , "narrator": "", "text": "違う"},
        { "location": "459/TALK"  , "narrator": "千羽鶴", "text": "じゃあこれ？"},
        { "location": "460/SEL"   , "narrator": "", "text": "そうです"},
        { "location": "461/SEL"   , "narrator": "", "text": "違う"},
        { "location": "462/ACT"   , "narrator": "", "text": "そうです"},
        { "location": "463/TALK"  , "narrator": "千羽鶴", "text": "これは\nフェノメノンの境界線、\n不確定電子の雲。"},
        { "location": "464/TALK"  , "narrator": "千羽鶴", "text": "俗に言う繭。"},
        { "location": "465/SEL"   , "narrator": "", "text": "こんな形だっけ？"},
        { "location": "466/ACT"   , "narrator": "", "text": "こんな形だっけ？"},
        { "location": "468/TALK"  , "narrator": "千羽鶴", "text": "人による。"},
        { "location": "469/TALK"  , "narrator": "千羽鶴", "text": "丸い時もあれば、\n竜巻のような時もある。"},
        { "location": "470/TALK"  , "narrator": "千羽鶴", "text": "ただ、卯月神楽の\nフェノメノンはとても\n強力ではある。"},
        { "location": "471/TALK"  , "narrator": "千羽鶴", "text": "それと、本人が\nある程度コントロールして\n作り出せる点も他と違う。"},
        { "location": "472/SEL"   , "narrator": "", "text": "なんだってーーーー！？"},
        { "location": "473/ACT"   , "narrator": "", "text": "なんだってーーーー！？"},
        { "location": "475/TALK"  , "narrator": "千羽鶴", "text": "貴方もそろそろ気づいて\nいるでしょうけど、\n彼女は特殊な存在。"},
        { "location": "476/TALK"  , "narrator": "千羽鶴", "text": "少なくとも、私の世界の\n日本においては。"},
        { "location": "479/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "481/ACT"   , "narrator": "", "text": "違う"},
        { "location": "484/TALK"  , "narrator": "千羽鶴", "text": "じゃあ\n私には何の事か\nわからない。"},
        { "location": "485/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "489/ACT"   , "narrator": "", "text": "神楽が展開した世界の中で出てきてた背後霊みたいなのは何？"},
        { "location": "493/TALK"  , "narrator": "千羽鶴", "text": "これのこと？"},
        { "location": "494/SEL"   , "narrator": "", "text": "そうです"},
        { "location": "495/ACT"   , "narrator": "", "text": "そうです"},
        { "location": "497/TALK"  , "narrator": "千羽鶴", "text": "卯月神楽が常に\nコネクトしているクラン。"},
        { "location": "498/TALK"  , "narrator": "千羽鶴", "text": "貴方はもう、\nずっと前から\n知っているはず。"},
        { "location": "499/TALK"  , "narrator": "千羽鶴", "text": "卯月神楽は、他の\nトライナリーより\n頭一つ抜きんでて強い。"},
        { "location": "500/TALK"  , "narrator": "千羽鶴", "text": "それはなぜか。\nこのクランが常に\nコネクトされているから。"},
        { "location": "501/SEL"   , "narrator": "", "text": "そんなことできるの！？"},
        { "location": "502/SEL"   , "narrator": "", "text": "誰が送ってるの！？"},
        { "location": "503/SEL"   , "narrator": "", "text": "このクランはどんなクランなの？"},
        { "location": "504/ACT"   , "narrator": "", "text": "そんなことできるの！？"},
        { "location": "505/TALK"  , "narrator": "千羽鶴", "text": "もちろん。"},
        { "location": "506/TALK"  , "narrator": "千羽鶴", "text": "そこに関しては、\n特に特別な要素はない。"},
        { "location": "507/TALK"  , "narrator": "千羽鶴", "text": "単に、トライガジェットを\n起動した瞬間に、自動で\nコネクトされるだけ。"},
        { "location": "508/TALK"  , "narrator": "千羽鶴", "text": "スタートアップ\nバッチ処理みたいなもの。"},
        { "location": "509/ACT"   , "narrator": "", "text": "誰が送ってるの！？"},
        { "location": "510/TALK"  , "narrator": "千羽鶴", "text": "もちろん、情報管理庁。"},
        { "location": "511/ACT"   , "narrator": "", "text": "このクランはどんなクランなの？"},
        { "location": "512/TALK"  , "narrator": "千羽鶴", "text": "どんなクランか。"},
        { "location": "513/TALK"  , "narrator": "千羽鶴", "text": "それを話す前に、\n貴方は心の準備をする\n必要があるかもしれない。"},
        { "location": "514/TALK"  , "narrator": "千羽鶴", "text": "なぜなら、\n貴方はこのクランを\n知っているから。"},
        { "location": "515/SEL"   , "narrator": "", "text": "詳しく！"},
        { "location": "516/ACT"   , "narrator": "", "text": "詳しく！"},
        { "location": "518/TALK"  , "narrator": "千羽鶴", "text": "そうね。\nいずれわかることだし。"},
        { "location": "519/TALK"  , "narrator": "千羽鶴", "text": "答えから言えば、彼女は\n貴方が一番最初に出逢い、\nそして倒したクラン。"},
        { "location": "521/TALK"  , "narrator": "千羽鶴", "text": "覚えてる？\n彼女のこと。"},
        { "location": "522/SEL"   , "narrator": "", "text": "チュートリアルの時の！？"},
        { "location": "523/ACT"   , "narrator": "", "text": "チュートリアルの時の！？"},
        { "location": "525/TALK"  , "narrator": "千羽鶴", "text": "そう。\n貴方には本当に\n感謝してる。"},
        { "location": "526/TALK"  , "narrator": "千羽鶴", "text": "貴方があのとき、\n彼女を捕獲してくれたから\n今がある。"},
        { "location": "527/TALK"  , "narrator": "千羽鶴", "text": "彼女の捕獲は、\nこの計画において\n重要な要素だった。"},
        { "location": "528/TALK"  , "narrator": "千羽鶴", "text": "けど、私だけでは\n彼女の捕獲は無理だった。"},
        { "location": "529/TALK"  , "narrator": "千羽鶴", "text": "貴方は接続３０分で、\n既にこの世界に対して\n大きな貢献をしていたの。"},
        { "location": "530/SEL"   , "narrator": "", "text": "名前は！？"},
        { "location": "531/SEL"   , "narrator": "", "text": "誰のクランなの！？"},
        { "location": "532/ACT"   , "narrator": "", "text": "名前は！？"},
        { "location": "533/ACT"   , "narrator": "", "text": "誰のクランなの！？"},
        { "location": "536/TALK"  , "narrator": "千羽鶴", "text": "…………。"},
        { "location": "539/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "541/ACT"   , "narrator": "", "text": "特にない \n<color=blue>（※先へ進みます）</color>"},
        { "location": "543/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "550/TALK"  , "narrator": "千羽鶴", "text": "さて、今回の\n逢瀬つばめだけど。"},
        { "location": "551/TALK"  , "narrator": "千羽鶴", "text": "記録映像で、卯月神楽は\n発症したわけだけど、\nそこまでの軌道を作る。"},
        { "location": "552/TALK"  , "narrator": "千羽鶴", "text": "その為、事件の少し前、\n卯月神楽が不安定になって\nいる時に焦点を当てる。"},
        { "location": "553/TALK"  , "narrator": "千羽鶴", "text": "そして貴方には、\n卯月神楽が発症するための\n礎を築いてもらう。"},
        { "location": "554/TALK"  , "narrator": "千羽鶴", "text": "理不尽かもしれないけど\nその先にある最大幸福の\n世界の為に頑張って。"},
        { "location": "558/TALK"  , "narrator": "千羽鶴", "text": "さて、今回の\n國政綾水だけど。"},
        { "location": "559/TALK"  , "narrator": "千羽鶴", "text": "珍しいシチュエーションを\n見てもらおうと思う。"},
        { "location": "560/TALK"  , "narrator": "千羽鶴", "text": "それは、\n東雲真幌との\n食事のシーン。"},
        { "location": "561/TALK"  , "narrator": "千羽鶴", "text": "それ自体は特段何の\n変哲もないものだけど、\nそこでの会話が重要。"},
        { "location": "562/TALK"  , "narrator": "千羽鶴", "text": "國政綾水にとっては、\n今後の気構えを作る為の\nきっかけになる。"},
        { "location": "563/TALK"  , "narrator": "千羽鶴", "text": "貴方には、そこで彼女の\n気構えを作る為の\nお膳立てをして欲しい。"},
        { "location": "564/TALK"  , "narrator": "千羽鶴", "text": "それが後の大事件において\n大きな力となるから。"},
        { "location": "568/TALK"  , "narrator": "千羽鶴", "text": "さて、今回の\nガブリエラだけど。"},
        { "location": "569/TALK"  , "narrator": "千羽鶴", "text": "彼女は今、逢瀬つばめと\n卯月神楽の仲に少しだけ\n妬いている。"},
        { "location": "570/TALK"  , "narrator": "千羽鶴", "text": "それ自体は微笑ましい\n事だけど――"},
        { "location": "571/TALK"  , "narrator": "千羽鶴", "text": "記録映像にもあるとおり、\n彼女たちの未来は\n非常に険しい。"},
        { "location": "572/TALK"  , "narrator": "千羽鶴", "text": "それを少しでも早く\n決着つけるには、彼女の\n判断力が鍵を握る。"},
        { "location": "573/TALK"  , "narrator": "千羽鶴", "text": "単刀直入に言うと、卯月\n神楽が逢瀬つばめを壊そう\nとしている事を伝えて。"},
        { "location": "574/TALK"  , "narrator": "千羽鶴", "text": "そして彼女に決断させ、\n気持ちの整理をつけさせて\n欲しい。"},
        { "location": "575/TALK"  , "narrator": "千羽鶴", "text": "その事が後に\n彼女たちを助けることに\n繋がっていく。"},
        { "location": "579/TALK"  , "narrator": "千羽鶴", "text": "さて、今回の\n恋ヶ崎みやびだけど。"},
        { "location": "580/TALK"  , "narrator": "千羽鶴", "text": "彼女はついに、\n情報管理庁の深部を\n探ろうとしている。"},
        { "location": "581/TALK"  , "narrator": "千羽鶴", "text": "その事について\n支援してあげて欲しい。"},
        { "location": "582/TALK"  , "narrator": "千羽鶴", "text": "それは必ずしも\n私にとっては\n有益なことではない。"},
        { "location": "583/TALK"  , "narrator": "千羽鶴", "text": "けど、将来的には\n必要不可欠な行動だから。"},
        { "location": "586/TALK"  , "narrator": "千羽鶴", "text": "それと――"},
        { "location": "587/TALK"  , "narrator": "千羽鶴", "text": "私は今回の件で\nひとつ反省した。"},
        { "location": "588/TALK"  , "narrator": "千羽鶴", "text": "今までもずっと\n気にはなっていたけども、\nTRI-OSが邪魔をする。"},
        { "location": "589/TALK"  , "narrator": "千羽鶴", "text": "その為、貴方と\n彼女たちとの交流が\n十分に行えていない。"},
        { "location": "590/TALK"  , "narrator": "千羽鶴", "text": "もっとOSへの権限を\n拡大し、貴方にもより\n多くの手段を提供したい。"},
        { "location": "591/TALK"  , "narrator": "千羽鶴", "text": "少なくとも、有事の際に\n貴方への支援ができるよう\n介入措置を導入しないと。"},
        { "location": "592/TALK"  , "narrator": "千羽鶴", "text": "そんなわけで、\n少し隠るかもしれないけど\n心配しないで。"},
        { "location": "593/TALK"  , "narrator": "千羽鶴", "text": "それじゃ、\n今回もよろしく。\n健闘を祈ってる。"},
