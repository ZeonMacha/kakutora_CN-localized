{
    "dir": "chap15/daydra/dd_ch01_15_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "15156",
        "cid": "tsubame",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "ファンクラブ"
    },
    "entry":
    [
        { "location": "245/SCENARIO", "narrator": "", "text": "ファンクラブ"},
        { "location": "260/TALK"    , "narrator": "雛", "text": "うわぁ、つばめちゃんの\nお弁当、凄い豪華ー！"},
        { "location": "262/TALK"    , "narrator": "キリト", "text": "うぉ、本当だ！\n手が込んでるな…。"},
        { "location": "264/TALK"    , "narrator": "繭", "text": "これ、全部手作り？\n冷凍食品が一つも入って\nないようだけど…。"},
        { "location": "266/TALK"    , "narrator": "つばめ", "text": "そうみたいだね。"},
        { "location": "267/TALK"    , "narrator": "繭", "text": "？　逢瀬さんが\n作ったんじゃないの？"},
        { "location": "270/TALK"    , "narrator": "つばめ", "text": "実はこのお弁当、\n中等部の女の子に\n貰ったものなの。"},
        { "location": "271/TALK"    , "narrator": "雛", "text": "ガブリエラちゃん以外に、\n中等部のお友達がいるの？"},
        { "location": "274/TALK"    , "narrator": "つばめ", "text": "お友達じゃないんだけど、\nその――"},
        { "location": "275/TALK"    , "narrator": "つばめ", "text": "中等部にね、特別攻撃隊の\nファンクラブがあるん\nだって。"},
        { "location": "276/TALK"    , "narrator": "繭", "text": "ああ…そういうこと。"},
        { "location": "278/TALK"    , "narrator": "キリト", "text": "へぇ…けど、新人なのに\nもう弁当くれるような\nファンがいるなんて――"},
        { "location": "279/TALK"    , "narrator": "キリト", "text": "逢瀬、凄ぇじゃん！\nさすがは特別攻撃隊\n期待の新星！！"},
        { "location": "283/TALK"    , "narrator": "つばめ", "text": "も、もぉ、\nからかわないでよぉ…。"},
        { "location": "284/TALK"    , "narrator": "ガブリエラ", "text": "いや、実際のとこ、\nあんたって結構人気ある\nみたいよ？"},
        { "location": "296/TALK"    , "narrator": "雛", "text": "あ、ガブリエラちゃん。"},
        { "location": "299/TALK"    , "narrator": "つばめ", "text": "人気って…どの辺りが？"},
        { "location": "301/TALK"    , "narrator": "ガブリエラ", "text": "あたしが知るわけ\nないじゃん。"},
        { "location": "304/TALK"    , "narrator": "ガブリエラ", "text": "けど、教室でもあんたの\n話してる子、よく見るわ。"},
        { "location": "306/TALK"    , "narrator": "雛", "text": "…まあ、つばめちゃんは\n特別攻撃隊の人の中だと、\n一番近づきやすいし――"},
        { "location": "307/TALK"    , "narrator": "雛", "text": "性格的にも、年下から\n人気が出るのは\nわからなくもないかな？"},
        { "location": "310/TALK"    , "narrator": "キリト", "text": "天然だしな。"},
        { "location": "313/TALK"    , "narrator": "繭", "text": "押しにも弱い。"},
        { "location": "314/TALK"    , "narrator": "つばめ", "text": "あ、あのー、本人の前で\n言うのはどうかと思うよ？"},
        { "location": "316/TALK"    , "narrator": "ガブリエラ", "text": "でもまあ、実際それが\n人気の理由じゃないの？"},
        { "location": "319/TALK"    , "narrator": "つばめ", "text": "そっか…。"},
        { "location": "320/TALK"    , "narrator": "つばめ", "text": "なんか、嬉しいな。\nそんな風にわたしのこと、\n好きでいてくれるなんて。"},
        { "location": "321/TALK"    , "narrator": "つばめ", "text": "…でも、お弁当貰うのは\n今回で最後にしないと…。"},
        { "location": "322/SEL"     , "narrator": "", "text": "貰っておけばいいじゃん"},
        { "location": "323/SEL"     , "narrator": "", "text": "悲しまれると思う"},
        { "location": "324/SEL"     , "narrator": "", "text": "ていうか、お礼しなきゃ"},
        { "location": "326/TALK"    , "narrator": "ガブリエラ", "text": "不味かったの？"},
        { "location": "330/TALK"    , "narrator": "つばめ", "text": "ううん、凄く美味しいよ！"},
        { "location": "331/TALK"    , "narrator": "つばめ", "text": "けど、やっぱり物を\n貰うのは良くないもん。"},
        { "location": "334/TALK"    , "narrator": "キリト", "text": "それくらいいいじゃん。\n向こうが勝手に作って\nくれてるんだし。"},
        { "location": "337/TALK"    , "narrator": "つばめ", "text": "そういうわけには\nいかないよ。"},
        { "location": "340/TALK"    , "narrator": "つばめ", "text": "気持ちは凄く嬉しいし、\n本当に善意でしてくれてる\nくのはわかるけど――"},
        { "location": "341/TALK"    , "narrator": "つばめ", "text": "だからって、毎日お弁当を\nもらっていい理由には\nならないもん。"},
        { "location": "342/TALK"    , "narrator": "つばめ", "text": "それに、こんなに凄い\nお弁当だと、作るのに\n時間が掛かると思うし。"},
        { "location": "343/TALK"    , "narrator": "つばめ", "text": "お弁当箱を返すとき、\nこれだけはしっかりと\n伝えておくつもりだよ。"},
        { "location": "345/TALK"    , "narrator": "ガブリエラ", "text": "はぁ…そういうところも、\nあんたが人気の理由\nなんじゃないの？"},
        { "location": "346/TALK"    , "narrator": "雛", "text": "ああ、確かに。"},
        { "location": "347/TALK"    , "narrator": "つばめ", "text": "どういうこと？"},
        { "location": "349/TALK"    , "narrator": "雛", "text": "天然娘に見えるけど、\nしっかりしてるところは\nしっかりしてるところ。"},
        { "location": "350/TALK"    , "narrator": "つばめ", "text": "だ、だから、天然天然って\n言わないでよぉ！"},
        { "location": "352/ACT"     , "narrator": "", "text": "貰っておけばいいじゃん"},
        { "location": "373/TALK"    , "narrator": "つばめ", "text": "ううん、ダメだよ"},
        { "location": "374/TALK"    , "narrator": "つばめ", "text": "こういうことはきちんとしておかないと"},
        { "location": "386/TALK"    , "narrator": "キリト", "text": "もったいねぇなぁ。\nせっかく作ってもらえる\nってのに…。"},
        { "location": "389/TALK"    , "narrator": "つばめ", "text": "気持ちは凄く嬉しいし、\n本当に善意でしてくれてる\nくのはわかるけど――"},
        { "location": "392/TALK"    , "narrator": "つばめ", "text": "だからって、毎日お弁当を\nもらっていい理由には\nならないもん。"},
        { "location": "393/TALK"    , "narrator": "つばめ", "text": "それに、こんなに凄い\nお弁当だと、作るのにも\n時間が掛かると思うし。"},
        { "location": "394/TALK"    , "narrator": "つばめ", "text": "お弁当箱を返すとき、\nこれだけはしっかりと\n伝えておくつもりだよ。"},
        { "location": "396/TALK"    , "narrator": "ガブリエラ", "text": "はぁ…そういうところも、\nあんたが人気の理由\nなんじゃないの？"},
        { "location": "397/TALK"    , "narrator": "雛", "text": "ああ、確かに。"},
        { "location": "398/TALK"    , "narrator": "つばめ", "text": "どういうこと？"},
        { "location": "399/TALK"    , "narrator": "雛", "text": "天然娘に見えるけど、\nしっかりしてるところは\nしっかりしてるところ。"},
        { "location": "400/TALK"    , "narrator": "つばめ", "text": "だ、だから、天然天然って\n言わないでよぉ！"},
        { "location": "401/ACT"     , "narrator": "", "text": "悲しまれると思う"},
        { "location": "423/TALK"    , "narrator": "つばめ", "text": "そうかな？"},
        { "location": "424/TALK"    , "narrator": "つばめ", "text": "さすがに、悲しまれたりはしないと思うけど…"},
        { "location": "435/TALK"    , "narrator": "つばめ", "text": "…わたしがお弁当を\n受け取らないって\n言ったら――"},
        { "location": "436/TALK"    , "narrator": "つばめ", "text": "もしかして、悲しまれ\nたりするかな？"},
        { "location": "437/TALK"    , "narrator": "雛", "text": "その子、つばめちゃんの\n大ファンなんでしょ？"},
        { "location": "438/TALK"    , "narrator": "雛", "text": "応援してるつばめちゃんに\n食べてもらいたくて、\nお弁当作ったのに――"},
        { "location": "439/TALK"    , "narrator": "雛", "text": "受け取れません、って\n言われたらねー…。"},
        { "location": "440/TALK"    , "narrator": "キリト", "text": "悲しまないわけねぇよな。"},
        { "location": "442/TALK"    , "narrator": "つばめ", "text": "うっ…そ、そっか…。"},
        { "location": "443/TALK"    , "narrator": "繭", "text": "けど、逢瀬さんが困るなら\n受け取らない方がいいと\n思う。"},
        { "location": "444/TALK"    , "narrator": "繭", "text": "そんな風に受け取られてる\nって後で知ったら――"},
        { "location": "445/TALK"    , "narrator": "繭", "text": "そっちの方がショック\n大きいと思うし。"},
        { "location": "448/TALK"    , "narrator": "つばめ", "text": "じゃ、じゃあ、やっぱり\n断った方がいいのかな？"},
        { "location": "449/TALK"    , "narrator": "繭", "text": "その方がいいと思う。\n悲しまれはすると\n思うけど。"},
        { "location": "452/TALK"    , "narrator": "つばめ", "text": "うう…なんだか、\n断り難い気持ちになって\nきちゃったよぉ…。"},
        { "location": "453/ACT"     , "narrator": "", "text": "ていうか、お礼しなきゃ"},
        { "location": "475/TALK"    , "narrator": "つばめ", "text": "いけない、すっかり忘れてた！"},
        { "location": "476/TALK"    , "narrator": "つばめ", "text": "教えてくれてありがと"},
        { "location": "487/TALK"    , "narrator": "つばめ", "text": "…お弁当のお礼には、\nやっぱりお弁当で返すのが\n一番かな？"},
        { "location": "489/TALK"    , "narrator": "ガブリエラ", "text": "それ、おもいっきり\n逆効果だから。"},
        { "location": "492/TALK"    , "narrator": "キリト", "text": "弁当渡せば、逢瀬から\nお礼に弁当貰える、って\n思う奴らが出てくるぞ？"},
        { "location": "496/TALK"    , "narrator": "つばめ", "text": "えっ！？"},
        { "location": "497/TALK"    , "narrator": "つばめ", "text": "で、でも、返すときに\nもうこれっきりにして、\nってお願いするし…。"},
        { "location": "498/TALK"    , "narrator": "繭", "text": "その子はわかっても、\n他の子達はそうじゃない。"},
        { "location": "499/TALK"    , "narrator": "繭", "text": "きっとみんな真似して、\n一度はお弁当を渡そう、\nって思うはず。"},
        { "location": "502/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "503/TALK"    , "narrator": "つばめ", "text": "普通に断った方が、\nよさそうだね。"},
        { "location": "504/TALK"    , "narrator": "雛", "text": "…けど、困った子達が\nいるんだなぁ。"},
        { "location": "505/TALK"    , "narrator": "雛", "text": "ファンクラブ作るなら、\n事前に本人に確認を取って\nからにしてほしいよね？"},
        { "location": "508/TALK"    , "narrator": "繭", "text": "おまえが言うな！"},
        { "location": "511/TALK"    , "narrator": "キリト", "text": "トライナリー応援団とか\n作ったの誰だったっけか？"},
        { "location": "513/TALK"    , "narrator": "雛", "text": "ファンクラブと応援団は、\n似て非なるものなの！"},
        { "location": "514/TALK"    , "narrator": "ガブリエラ", "text": "…人気者って、大変ね。"},
        { "location": "517/TALK"    , "narrator": "つばめ", "text": "あはは…でも、嬉しいよ。"},
        { "location": "258/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>7月19日　0:06 PM</color>\nとある平日の昼休み、附属学園つばめの教室にて。"},
        { "location": "529/DIALOG"  , "narrator": "Dialog_GEThimegoto_ch01", "text": "【言葉足らず、気持ち知らず】"}
    ]
}
