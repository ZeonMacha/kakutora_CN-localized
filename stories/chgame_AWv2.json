    "entry":
    [
        { "location": "1499/SCENARIO", "narrator": "", "text": "AW落とし物（ガブのこけし）"},
        { "location": "1504/TALK"    , "narrator": "千羽鶴", "text": "ここには、\nガブリエラの大好きな\nこけしが落ちていた。"},
        { "location": "1505/TALK"    , "narrator": "千羽鶴", "text": "彼女がこけしを\nどうしてあれほどまでに、\nこよなく愛するのか。"},
        { "location": "1506/TALK"    , "narrator": "千羽鶴", "text": "それは――"},
        { "location": "1509/TALK"    , "narrator": "千羽鶴", "text": "<size=40>彼女の神秘！</size>"},
        { "location": "1511/TALK"    , "narrator": "千羽鶴", "text": "……。"},
        { "location": "1512/TALK"    , "narrator": "千羽鶴", "text": "実は良く知らない。"}
    ]
}
