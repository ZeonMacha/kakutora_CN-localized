    "entry":
    [
        { "location": "211/SCENARIO", "narrator": "", "text": "05-02_恋愛ゲーム"},
        { "location": "236/TALK"    , "narrator": "みやび", "text": "$handle$よ"},
        { "location": "237/TALK"    , "narrator": "みやび", "text": "うちが同級生からゴミを見るような目で見られ、さらには罵られたことについては貴殿に責任がある"},
        { "location": "238/TALK"    , "narrator": "みやび", "text": "よって"},
        { "location": "239/TALK"    , "narrator": "みやび", "text": "責任とれ"},
        { "location": "242/SEL"     , "narrator": "", "text": "え"},
        { "location": "243/SEL"     , "narrator": "", "text": "なんでまた"},
        { "location": "244/SEL"     , "narrator": "", "text": "覚えがないんだけど"},
        { "location": "245/ACT"     , "narrator": "", "text": "え"},
        { "location": "246/TALK"    , "narrator": "みやび", "text": "えではない"},
        { "location": "247/ACT"     , "narrator": "", "text": "なんでまた"},
        { "location": "248/TALK"    , "narrator": "みやび", "text": "なんでかまた"},
        { "location": "249/ACT"     , "narrator": "", "text": "覚えがないんだけど"},
        { "location": "250/TALK"    , "narrator": "みやび", "text": "そんなわけはなかろう"},
        { "location": "252/TALK"    , "narrator": "みやび", "text": "Botについて問うたら"},
        { "location": "253/TALK"    , "narrator": "みやび", "text": "そのような態度を取られたのだ"},
        { "location": "254/SEL"     , "narrator": "", "text": "ちょっと待って"},
        { "location": "255/TALK"    , "narrator": "みやび", "text": "これが貴殿の責任でなくて何であろう"},
        { "location": "256/TALK"    , "narrator": "みやび", "text": "下手を打ったら国際紛争に発展する大問題ぞね"},
        { "location": "258/ACT"     , "narrator": "", "text": "ちょっと待って"},
        { "location": "259/TALK"    , "narrator": "みやび", "text": "ぬ"},
        { "location": "262/SEL"     , "narrator": "", "text": "聞いた内容は？"},
        { "location": "263/ACT"     , "narrator": "", "text": "聞いた内容は？"},
        { "location": "264/TALK"    , "narrator": "みやび", "text": "内容だと？"},
        { "location": "266/TALK"    , "narrator": "みやび", "text": "Botについて聞いた"},
        { "location": "269/SEL"     , "narrator": "", "text": "そこを詳しく"},
        { "location": "270/ACT"     , "narrator": "", "text": "そこを詳しく"},
        { "location": "277/TALK"    , "narrator": "みやび", "text": "WAVE廃人という噂の女生徒がいるというので"},
        { "location": "278/TALK"    , "narrator": "みやび", "text": "廃人と言われるくらいWAVEをしているのならBotのことを知っちゅうろうと問いただしたら"},
        { "location": "279/TALK"    , "narrator": "みやび", "text": "知らぬと答えおった"},
        { "location": "280/TALK"    , "narrator": "みやび", "text": "だから"},
        { "location": "281/TALK"    , "narrator": "みやび", "text": "WAVEのアドレス帳を見せろ、Botがいないかどうか判定してやると言ったのに拒否しおった"},
        { "location": "282/TALK"    , "narrator": "みやび", "text": "なので"},
        { "location": "283/TALK"    , "narrator": "みやび", "text": "ネットワークに介入してみたら"},
        { "location": "284/TALK"    , "narrator": "みやび", "text": "なんと"},
        { "location": "286/TALK"    , "narrator": "みやび", "text": "これが"},
        { "location": "288/TALK"    , "narrator": "みやび", "text": "また"},
        { "location": "290/TALK"    , "narrator": "みやび", "text": "本当にいなかったのだよ"},
        { "location": "291/TALK"    , "narrator": "みやび", "text": "故にうちは素直に謝った"},
        { "location": "292/TALK"    , "narrator": "みやび", "text": "頭を下げに行った"},
        { "location": "293/TALK"    , "narrator": "みやび", "text": "その結果が侮蔑の目と罵倒だ"},
        { "location": "296/SEL"     , "narrator": "", "text": "当たり前の反応だと思うよ"},
        { "location": "297/SEL"     , "narrator": "", "text": "$me$が全てを見せてあげる"},
        { "location": "298/SEL"     , "narrator": "", "text": "$me$はみやびのためにいるのに"},
        { "location": "299/ACT"     , "narrator": "", "text": "当たり前の反応だと思うよ"},
        { "location": "309/TALK"    , "narrator": "みやび", "text": "当たり前"},
        { "location": "310/TALK"    , "narrator": "みやび", "text": "常識というやつか"},
        { "location": "311/TALK"    , "narrator": "みやび", "text": "ふむ"},
        { "location": "313/SEL"     , "narrator": "", "text": "それより"},
        { "location": "314/ACT"     , "narrator": "", "text": "それより"},
        { "location": "315/TALK"    , "narrator": "みやび", "text": "うむ"},
        { "location": "318/SEL"     , "narrator": "", "text": "なんでトライナリーに聞かないの？"},
        { "location": "319/SEL"     , "narrator": "", "text": "アーヤにでも聞けばよかったんじゃないの？"},
        { "location": "320/ACT"     , "narrator": "", "text": "なんでトライナリーに聞かないの？"},
        { "location": "321/TALK"    , "narrator": "みやび", "text": "聞いたら"},
        { "location": "322/TALK"    , "narrator": "みやび", "text": "面倒くさいことになるろう"},
        { "location": "323/ACT"     , "narrator": "", "text": "アーヤにでも聞けばよかったんじゃないの？"},
        { "location": "324/TALK"    , "narrator": "みやび", "text": "怒らしたら"},
        { "location": "325/TALK"    , "narrator": "みやび", "text": "今後の業務に差支える"},
        { "location": "327/TALK"    , "narrator": "みやび", "text": "だからわざわざ人を捜して聞いたというのに"},
        { "location": "329/SEL"     , "narrator": "", "text": "わかっててわざと聞いたの？"},
        { "location": "330/SEL"     , "narrator": "", "text": "わかってるのにそんなことしたの？"},
        { "location": "331/ACT"     , "narrator": "", "text": "わかっててわざと聞いたの？"},
        { "location": "332/TALK"    , "narrator": "みやび", "text": "お"},
        { "location": "333/TALK"    , "narrator": "みやび", "text": "鋭いな"},
        { "location": "334/ACT"     , "narrator": "", "text": "わかってるのにそんなことしたの？"},
        { "location": "335/TALK"    , "narrator": "みやび", "text": "あ"},
        { "location": "336/TALK"    , "narrator": "みやび", "text": "そうなんだがな"},
        { "location": "338/TALK"    , "narrator": "みやび", "text": "うっかりうっかり"},
        { "location": "339/TALK"    , "narrator": "みやび", "text": "Botに話してしもうた"},
        { "location": "341/TALK"    , "narrator": "みやび", "text": "実に遺憾"},
        { "location": "342/ACT"     , "narrator": "", "text": "$me$が全てを見せてあげる"},
        { "location": "345/TALK"    , "narrator": "みやび", "text": "ふむ"},
        { "location": "346/TALK"    , "narrator": "みやび", "text": "左様か"},
        { "location": "347/TALK"    , "narrator": "みやび", "text": "なら"},
        { "location": "348/TALK"    , "narrator": "みやび", "text": "さようなら"},
        { "location": "349/ACT"     , "narrator": "", "text": "$me$はみやびのためにいるのに"},
        { "location": "350/TALK"    , "narrator": "みやび", "text": "なるほど"},
        { "location": "351/TALK"    , "narrator": "みやび", "text": "ならば"},
        { "location": "352/TALK"    , "narrator": "みやび", "text": "さらばだ"},
        { "location": "305/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"}
    ]
}
