{
    "dir": "chap13/daydra/anime_03_13.js",
    "type": "MainStory",
    "info": {
        "story_id": "13301",
        "cid": "gabriella",
        "title": "001 アニメーション",
        "sub_title": "江戸川橋物語"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "アニメ第13話"},
        { "location": "47/TALK"   , "narrator": "千羽鶴", "text": "ごきげんよう。\n現在國政綾水強化週間の\n千羽鶴です。"},
        { "location": "49/TALK"   , "narrator": "千羽鶴", "text": "いつも通り、今回も\n逢瀬つばめの解説を\nするだけでいい？"},
        { "location": "51/TALK"   , "narrator": "千羽鶴", "text": "いつも通り、今回も\n國政綾水の解説を\nするだけでいい？"},
        { "location": "53/TALK"   , "narrator": "千羽鶴", "text": "いつも通り、今回も\nガブリエラの解説を\nするだけでいい？"},
        { "location": "55/TALK"   , "narrator": "千羽鶴", "text": "いつも通り、今回も\n恋ヶ崎みやびの解説を\nするだけでいい？"},
        { "location": "57/SEL"    , "narrator": "", "text": "はい"},
        { "location": "58/SEL"    , "narrator": "", "text": "いいえ"},
        { "location": "59/ACT"    , "narrator": "", "text": "はい"},
        { "location": "61/TALK"   , "narrator": "千羽鶴", "text": "よかった。\n私も助かる。\nこれぞWIN-WINね。"},
        { "location": "63/ACT"    , "narrator": "", "text": "いいえ"},
        { "location": "64/TALK"   , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "71/TALK"   , "narrator": "千羽鶴", "text": "<color=red><size=40>次回予告！！</size></color>"},
        { "location": "72/SEL"    , "narrator": "", "text": "まだ今回すら始まってないんですけど！"},
        { "location": "73/ACT"    , "narrator": "", "text": "まだ今回すら始まってないんですけど！"},
        { "location": "75/TALK"   , "narrator": "千羽鶴", "text": "もちろん\n今回分は、ある。"},
        { "location": "76/TALK"   , "narrator": "千羽鶴", "text": "けど、このタイミングと\nこのインパクトが重要\nだったので、敢えて。"},
        { "location": "77/SEL"    , "narrator": "", "text": "ど、どうぞ"},
        { "location": "78/ACT"    , "narrator": "", "text": "ど、どうぞ"},
        { "location": "82/TALK"   , "narrator": "千羽鶴", "text": "<size=35>次回！</size>"},
        { "location": "85/TALK"   , "narrator": "千羽鶴", "text": "<size=40>衝撃の！</size>"},
        { "location": "86/SEL"    , "narrator": "", "text": "最終回！？"},
        { "location": "87/SEL"    , "narrator": "", "text": "首…"},
        { "location": "88/SEL"    , "narrator": "", "text": "黙って見ている"},
        { "location": "89/ACT"    , "narrator": "", "text": "最終回！？"},
        { "location": "90/TALK"   , "narrator": "千羽鶴", "text": "えっ！？\nまさか！"},
        { "location": "91/TALK"   , "narrator": "千羽鶴", "text": "どうして\nそう思ったの？"},
        { "location": "92/SEL"    , "narrator": "", "text": "ノリで言ってみただけ"},
        { "location": "93/SEL"    , "narrator": "", "text": "何となく雰囲気的に"},
        { "location": "94/ACT"    , "narrator": "", "text": "ノリで言ってみただけ"},
        { "location": "95/ACT"    , "narrator": "", "text": "何となく雰囲気的に"},
        { "location": "97/TALK"   , "narrator": "千羽鶴", "text": "そんな理由で\nそんな衝撃的なことを\n言わないで。"},
        { "location": "98/TALK"   , "narrator": "千羽鶴", "text": "私たちの人生にも\nそして世界にも、\n最終回という文字はない。"},
        { "location": "99/TALK"   , "narrator": "千羽鶴", "text": "もしあるとしたら、\nそれは回線が\n切れたときだけ。"},
        { "location": "100/TALK"  , "narrator": "千羽鶴", "text": "それも、\n貴方たちの世界にだけ\n訪れる最終回でしかない。"},
        { "location": "101/ACT"   , "narrator": "", "text": "首…"},
        { "location": "102/TALK"  , "narrator": "千羽鶴", "text": "首、なに？"},
        { "location": "103/SEL"   , "narrator": "", "text": "いえ、前にそんなシーンが公開されていて……"},
        { "location": "104/SEL"   , "narrator": "", "text": "あ、いや、千羽鶴がクビになるのかと"},
        { "location": "105/ACT"   , "narrator": "", "text": "いえ、前にそんなシーンが公開されていて……"},
        { "location": "109/TALK"  , "narrator": "千羽鶴", "text": "ああ、これのこと。"},
        { "location": "110/TALK"  , "narrator": "千羽鶴", "text": "付け忘れたけど\n<color=blue>（※イメージです）</color>\nだから。"},
        { "location": "113/TALK"  , "narrator": "千羽鶴", "text": "まさか、あの仲良しの\n度を超した２人が、本気で\nこんな事をすると思った？"},
        { "location": "114/SEL"   , "narrator": "", "text": "前回の記録映像を見てから、信憑性が増した"},
        { "location": "115/SEL"   , "narrator": "", "text": "世の中何があってもおかしくない"},
        { "location": "116/ACT"   , "narrator": "", "text": "前回の記録映像を見てから、信憑性が増した"},
        { "location": "117/TALK"  , "narrator": "千羽鶴", "text": "ちょっとNGワード言われた\nからって首締めてたら――"},
        { "location": "118/TALK"  , "narrator": "千羽鶴", "text": "命と刑務所が\nいくつあっても足りない！"},
        { "location": "119/ACT"   , "narrator": "", "text": "世の中何があってもおかしくない"},
        { "location": "120/TALK"  , "narrator": "千羽鶴", "text": "いい答え。\nその通り。"},
        { "location": "121/TALK"  , "narrator": "千羽鶴", "text": "世の中の事実は、\n貴方の想像を\n遥かに超えている。"},
        { "location": "122/TALK"  , "narrator": "千羽鶴", "text": "フィクション作品なんて、\n現実の奇天烈さに比べたら\n常識すぎて入眠必至。"},
        { "location": "123/TALK"  , "narrator": "千羽鶴", "text": "その事実を知らなかった\nのなら、今後はその構えで\n現実を生きて欲しい。"},
        { "location": "125/TALK"  , "narrator": "千羽鶴", "text": "というわけで、\n全然違う。"},
        { "location": "126/ACT"   , "narrator": "", "text": "あ、いや、千羽鶴がクビになるのかと"},
        { "location": "127/TALK"  , "narrator": "千羽鶴", "text": "そう。\n貴方がそう思うなら\nそうなのかもしれない。"},
        { "location": "128/TALK"  , "narrator": "千羽鶴", "text": "<color=blue>【貴方の愛で、\n　私はクビになる――】</color>"},
        { "location": "129/TALK"  , "narrator": "千羽鶴", "text": "まあ、結論から言うと、\nそれはない。"},
        { "location": "131/ACT"   , "narrator": "", "text": "黙って見ている"},
        { "location": "132/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "134/TALK"  , "narrator": "千羽鶴", "text": "………。"},
        { "location": "136/TALK"  , "narrator": "千羽鶴", "text": "どうして\n何も言わないの？\nそこ、ボケる所だから。"},
        { "location": "137/SEL"   , "narrator": "", "text": "いや、素直に待ってたんだけど"},
        { "location": "138/SEL"   , "narrator": "", "text": "敢えて黙ってた"},
        { "location": "139/ACT"   , "narrator": "", "text": "いや、素直に待ってたんだけど"},
        { "location": "140/TALK"  , "narrator": "千羽鶴", "text": "そんな従順なことでは\nこの世の中は\n渡っていけない。"},
        { "location": "141/TALK"  , "narrator": "千羽鶴", "text": "相手がボケて欲しいと\n思った時にボケられる\n能力は、人生を左右する。"},
        { "location": "142/TALK"  , "narrator": "千羽鶴", "text": "是非これを機に\n私で鍛えるのがいい。"},
        { "location": "143/ACT"   , "narrator": "", "text": "敢えて黙ってた"},
        { "location": "145/TALK"  , "narrator": "千羽鶴", "text": "もしかして貴方、ドＳ？"},
        { "location": "149/TALK"  , "narrator": "千羽鶴", "text": "正解は――"},
        { "location": "152/TALK"  , "narrator": "千羽鶴", "text": "次回！衝撃の國政綾水\nミュージックビデオ回！\n略して――"},
        { "location": "156/SEL"   , "narrator": "", "text": "キター！！"},
        { "location": "157/SEL"   , "narrator": "", "text": "なんですかそれ"},
        { "location": "158/SEL"   , "narrator": "", "text": "略す必要ある？"},
        { "location": "159/ACT"   , "narrator": "", "text": "キター！！"},
        { "location": "160/TALK"  , "narrator": "千羽鶴", "text": "喜んでもらえて何より。"},
        { "location": "161/ACT"   , "narrator": "", "text": "なんですかそれ"},
        { "location": "162/TALK"  , "narrator": "千羽鶴", "text": "これから説明する。"},
        { "location": "163/ACT"   , "narrator": "", "text": "略す必要ある？"},
        { "location": "164/TALK"  , "narrator": "千羽鶴", "text": "黙れ。"},
        { "location": "168/TALK"  , "narrator": "千羽鶴", "text": "そう。私は前回の記録\n映像が終わった後、\n時間を掛けて考えた。"},
        { "location": "169/TALK"  , "narrator": "千羽鶴", "text": "そして１つの\n結論に至った。"},
        { "location": "170/TALK"  , "narrator": "千羽鶴", "text": "貴方がどんな生き方や\n選択をしようと、\nそれは貴方の自由。"},
        { "location": "171/TALK"  , "narrator": "千羽鶴", "text": "けど私は、貴方の自由\n意志とは関係なく、常に\n使命遂行に全力投球する。"},
        { "location": "172/TALK"  , "narrator": "千羽鶴", "text": "貴方が彼女たちとゴール\nインする為、あらゆる\n手段を講じるべきだと！"},
        { "location": "177/TALK"  , "narrator": "千羽鶴", "text": "というわけで、\nその第一回目として\n國政綾水を用意した。"},
        { "location": "178/TALK"  , "narrator": "千羽鶴", "text": "彼女のかっこいいところ、\n彼女の可愛いところ、\n彼女の色っぽいところ。"},
        { "location": "181/TALK"  , "narrator": "千羽鶴", "text": "色んなシーンを\nこの一本に詰め込んでる。"},
        { "location": "182/TALK"  , "narrator": "千羽鶴", "text": "そしてなんと、BGMは\nイメージソングとして\n彼女自身が歌っている。"},
        { "location": "185/TALK"  , "narrator": "千羽鶴", "text": "すなわちこれは、\n正真正銘、國政綾水の\nミュージックビデオ！"},
        { "location": "186/SEL"   , "narrator": "", "text": "他のトライナリーの子は？"},
        { "location": "187/ACT"   , "narrator": "", "text": "他のトライナリーの子は？"},
        { "location": "189/TALK"  , "narrator": "千羽鶴", "text": "もちろん随時\n公開していく予定。"},
        { "location": "190/TALK"  , "narrator": "千羽鶴", "text": "基本的に、トライナリーの\n入隊順にお披露目して\nいこうと思ってる。"},
        { "location": "193/TALK"  , "narrator": "千羽鶴", "text": "というわけで、\n次回は國政綾水を\n十分堪能して欲しい。"},
        { "location": "194/TALK"  , "narrator": "千羽鶴", "text": "ミュージックビデオ\n以外にも、彼女を愛でる\n企画を考えてるから。"},
        { "location": "196/TALK"  , "narrator": "千羽鶴", "text": "というわけで、\n本題に戻ろうと思う。"},
        { "location": "197/TALK"  , "narrator": "千羽鶴", "text": "さて、今回の記録映像\nは、次回の國政綾水回の\n前夜祭的な内容。"},
        { "location": "198/TALK"  , "narrator": "千羽鶴", "text": "今までとは違う、\n彼女の個人的な\nエピソードになる。"},
        { "location": "199/TALK"  , "narrator": "千羽鶴", "text": "故に今回ばかりは\nあらすじではなく、\n映像を見て欲しい。"},
        { "location": "200/TALK"  , "narrator": "千羽鶴", "text": "あらすじで説明しても\n何の意味も無い回だから。"},
        { "location": "202/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/81MB 5:05】</color>"},
        { "location": "203/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/26MB 5:05】</color>"},
        { "location": "204/SEL"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "205/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/81MB 5:05】</color>"},
        { "location": "206/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "212/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/26MB 5:05】</color>"},
        { "location": "213/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "219/ACT"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "220/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "221/TALK"  , "narrator": "千羽鶴", "text": "残念だけど、いろいろ\n事情があってのことだと\n思うから。"},
        { "location": "222/TALK"  , "narrator": "千羽鶴", "text": "家に帰ったら、是非\n映像記録の方も\n見てみて欲しい。"},
        { "location": "223/TALK"  , "narrator": "千羽鶴", "text": "それではどうぞ。"},
        { "location": "256/TALK"  , "narrator": "千羽鶴", "text": "――というわけで、\n前回に引き続き\n今回も日常回。"},
        { "location": "257/TALK"  , "narrator": "千羽鶴", "text": "國政綾水とガブリエラの\nとても微笑ましい\nエピソードだった。"},
        { "location": "258/TALK"  , "narrator": "千羽鶴", "text": "感想などあれば。"},
        { "location": "260/SEL"   , "narrator": "", "text": "確かに今回は、とてもほのぼのしていたね"},
        { "location": "261/SEL"   , "narrator": "", "text": "千羽鶴がそう言うってことは、何か裏があるのでは？"},
        { "location": "262/SEL"   , "narrator": "", "text": "ガブちゃんはアーヤのことが好きなの？"},
        { "location": "263/SEL"   , "narrator": "", "text": "結局今回のクランを発症した子はどうなったの？"},
        { "location": "264/SEL"   , "narrator": "", "text": "アーヤは保育園のことやサークルのことは、みんなには言ってないんだ"},
        { "location": "265/SEL"   , "narrator": "", "text": "特にない \n<color=blue>（※先へ進みます）</color>"},
        { "location": "266/ACT"   , "narrator": "", "text": "確かに今回は、とてもほのぼのしていたね"},
        { "location": "267/TALK"  , "narrator": "千羽鶴", "text": "にやり。"},
        { "location": "268/SEL"   , "narrator": "", "text": "やっぱり裏があるのか！？"},
        { "location": "269/SEL"   , "narrator": "", "text": "動揺させようとしてる？"},
        { "location": "270/ACT"   , "narrator": "", "text": "やっぱり裏があるのか！？"},
        { "location": "276/TALK"  , "narrator": "千羽鶴", "text": "パブロフの犬。"},
        { "location": "277/TALK"  , "narrator": "千羽鶴", "text": "別名刷り込みとも言う。"},
        { "location": "278/TALK"  , "narrator": "千羽鶴", "text": "私がひねった事を\n言い続けることで、\nそれを疑わなくなる。"},
        { "location": "279/TALK"  , "narrator": "千羽鶴", "text": "これも情報操作の\n基本となる手法の１つ\nだから、覚えておいて。"},
        { "location": "280/SEL"   , "narrator": "", "text": "はい"},
        { "location": "281/SEL"   , "narrator": "", "text": "別名、オオカミ少年って言わなかったっけ？"},
        { "location": "282/ACT"   , "narrator": "", "text": "はい"},
        { "location": "283/TALK"  , "narrator": "千羽鶴", "text": "素直でいい子。"},
        { "location": "284/ACT"   , "narrator": "", "text": "別名、オオカミ少年って言わなかったっけ？"},
        { "location": "285/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "286/TALK"  , "narrator": "千羽鶴", "text": "ちーポイント\nマイナス１点。"},
        { "location": "288/ACT"   , "narrator": "", "text": "動揺させようとしてる？"},
        { "location": "289/TALK"  , "narrator": "千羽鶴", "text": "なるほど。\nなかなか冷静ね。\nいい調子。"},
        { "location": "290/TALK"  , "narrator": "千羽鶴", "text": "前回と今回で、\n私は同じ事を言った。"},
        { "location": "291/TALK"  , "narrator": "千羽鶴", "text": "とても微笑ましい\nエピソードであると。"},
        { "location": "292/TALK"  , "narrator": "千羽鶴", "text": "しかし実際は、前回は\n全く微笑ましくなんて\nなかった。"},
        { "location": "293/TALK"  , "narrator": "千羽鶴", "text": "人は一度そういった\n事態に遭遇すると、\nそれに影響される。"},
        { "location": "294/TALK"  , "narrator": "千羽鶴", "text": "この行動「学習」は、\n人間活動に重要ではある、\nけど反面、脆い所もある。"},
        { "location": "295/TALK"  , "narrator": "千羽鶴", "text": "本来単純であるはずの\nことすらも複雑に考え、\n誤認してしまうこと。"},
        { "location": "296/TALK"  , "narrator": "千羽鶴", "text": "今回はそのテストを\nしてみた。"},
        { "location": "298/TALK"  , "narrator": "千羽鶴", "text": "そして貴方は、見事\nその罠にはまらずに、\nこの回答を選んだ――"},
        { "location": "299/TALK"  , "narrator": "千羽鶴", "text": "フリをしてるけど残念。\nこの回答よりも前に、\n疑ってるのを知ってる。"},
        { "location": "302/TALK"  , "narrator": "千羽鶴", "text": "<color=red><size=40>残念！</size></color>"},
        { "location": "303/TALK"  , "narrator": "千羽鶴", "text": "でも、こうやって\n反復学習するのは\nとてもよいこと。"},
        { "location": "304/TALK"  , "narrator": "千羽鶴", "text": "これからも頑張って、\n生きる為の力を\n身に付けていって欲しい。"},
        { "location": "311/TALK"  , "narrator": "千羽鶴", "text": "そして貴方は見事、\nこのテストに合格した。"},
        { "location": "312/TALK"  , "narrator": "千羽鶴", "text": "観念や学習の罠に\nまどわされず、正直な\n気持ちを大事にする。"},
        { "location": "313/TALK"  , "narrator": "千羽鶴", "text": "とても大切なこと。"},
        { "location": "314/TALK"  , "narrator": "千羽鶴", "text": "そのサバイバル能力を\n大事にして、貴方の世界で\n生き抜いていって欲しい。"},
        { "location": "317/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "319/ACT"   , "narrator": "", "text": "千羽鶴がそう言うってことは、何か裏があるのでは？"},
        { "location": "320/TALK"  , "narrator": "千羽鶴", "text": "はい、罠にはまった。"},
        { "location": "321/SEL"   , "narrator": "", "text": "罠…？"},
        { "location": "322/ACT"   , "narrator": "", "text": "罠…？"},
        { "location": "329/TALK"  , "narrator": "千羽鶴", "text": "そう。\nこれは罠。"},
        { "location": "330/TALK"  , "narrator": "千羽鶴", "text": "前回と今回で、\n私は同じ事を言った。"},
        { "location": "331/TALK"  , "narrator": "千羽鶴", "text": "とても微笑ましい\nエピソードであると。"},
        { "location": "332/TALK"  , "narrator": "千羽鶴", "text": "しかし実際は、前回は\n全く微笑ましくなんて\nなかった。"},
        { "location": "333/TALK"  , "narrator": "千羽鶴", "text": "人は一度そういった\n事態に遭遇すると、\nそれに影響される。"},
        { "location": "334/TALK"  , "narrator": "千羽鶴", "text": "この行動「学習」は、\n人間活動に重要ではある、\nけど反面、脆い所もある。"},
        { "location": "335/TALK"  , "narrator": "千羽鶴", "text": "本来単純であるはずの\nことすらも複雑に考え、\n誤認してしまうこと。"},
        { "location": "336/TALK"  , "narrator": "千羽鶴", "text": "今回はそのテストを\nしてみた。"},
        { "location": "337/TALK"  , "narrator": "千羽鶴", "text": "そして貴方は私の思惑\n通り、今回も何か裏が\nあると疑った。"},
        { "location": "340/TALK"  , "narrator": "千羽鶴", "text": "<color=red><size=40>残念！</size></color>"},
        { "location": "341/TALK"  , "narrator": "千羽鶴", "text": "でも、こうやって\n反復学習するのは\nとてもよいこと。"},
        { "location": "342/TALK"  , "narrator": "千羽鶴", "text": "これからも頑張って、\n生きる為の力を\n身に付けていって欲しい。"},
        { "location": "343/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "345/ACT"   , "narrator": "", "text": "ガブちゃんはアーヤのことが好きなの？"},
        { "location": "346/TALK"  , "narrator": "千羽鶴", "text": "これで嫌いだったら、\nガブリエラはすごい狡猾。"},
        { "location": "347/TALK"  , "narrator": "千羽鶴", "text": "…と、私見は\nこれくらいにしておく。"},
        { "location": "348/TALK"  , "narrator": "千羽鶴", "text": "他人のプライバシーに\n勝手に踏み入った回答は\nしてはいけない。"},
        { "location": "349/TALK"  , "narrator": "千羽鶴", "text": "ガブリエラの本心を\n知りたければ、やはり\n彼女に聞くしかない。"},
        { "location": "350/TALK"  , "narrator": "千羽鶴", "text": "アーヤに対する気持ちが\n重要なものであれば、\n貴方にも打ち明けるはず。"},
        { "location": "351/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "353/ACT"   , "narrator": "", "text": "結局今回のクランを発症した子はどうなったの？"},
        { "location": "357/TALK"  , "narrator": "千羽鶴", "text": "今回の発症者、\n二階堂愛瑠は、少し\n特異なケースと言える。"},
        { "location": "358/TALK"  , "narrator": "千羽鶴", "text": "通常、収束させるためには\n発症者当人の想いや目的を\n阻止するのが常。"},
        { "location": "359/TALK"  , "narrator": "千羽鶴", "text": "でも今回は、彼女に\n同調することこそが、\n収束条件だった。"},
        { "location": "360/TALK"  , "narrator": "千羽鶴", "text": "トライナリーたちにとって\nこのようなケースは初めて\nだったから驚いたみたい。"},
        { "location": "361/TALK"  , "narrator": "千羽鶴", "text": "けど、収束条件に法則性は\n無いため、当然今回の\nような事もある。"},
        { "location": "362/TALK"  , "narrator": "千羽鶴", "text": "珍しいことではあるけど\n決して例外的なものでは\nない。"},
        { "location": "363/TALK"  , "narrator": "千羽鶴", "text": "愛瑠の発症原因や、収束\n条件については、まとめ\n次第貴方に共有する。"},
        { "location": "364/TALK"  , "narrator": "千羽鶴", "text": "その時まで\nもうしばらく待ってて。"},
        { "location": "367/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "369/ACT"   , "narrator": "", "text": "アーヤは保育園のことやサークルのことは、みんなには言ってないんだ"},
        { "location": "370/TALK"  , "narrator": "千羽鶴", "text": "ヒミツにしてるみたい。"},
        { "location": "371/TALK"  , "narrator": "千羽鶴", "text": "本人は、その事自体も\n重荷になっていた\nようだけど。"},
        { "location": "372/TALK"  , "narrator": "千羽鶴", "text": "だから今回意図せずして\nガブリエラにバレたのは、\n結果的に良かったかも。"},
        { "location": "373/TALK"  , "narrator": "千羽鶴", "text": "彼女のココロの負担は\nかなり軽減されている\nようだから。"},
        { "location": "374/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "376/ACT"   , "narrator": "", "text": "特にない \n<color=blue>（※先へ進みます）</color>"},
        { "location": "378/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "385/TALK"  , "narrator": "千羽鶴", "text": "さて、今回の\n逢瀬つばめについて。"},
        { "location": "386/TALK"  , "narrator": "千羽鶴", "text": "記録映像で紹介した\nメルティ戦について、\nその裏側を見てもらう。"},
        { "location": "387/TALK"  , "narrator": "千羽鶴", "text": "彼女はメルティ戦には\n参戦していない。"},
        { "location": "388/TALK"  , "narrator": "千羽鶴", "text": "では國政綾水らが\n戦っている最中、\n何をやっていたのか。"},
        { "location": "389/TALK"  , "narrator": "千羽鶴", "text": "今回のエピソードでは\nそこにスポットを\n当ててみる。"},
        { "location": "390/TALK"  , "narrator": "千羽鶴", "text": "今回のエピソードは\nさして重要ではないから\n気楽に楽しんできて。"},
        { "location": "394/TALK"  , "narrator": "千羽鶴", "text": "さて、今回の\n國政綾水について\nなんだけども。"},
        { "location": "395/TALK"  , "narrator": "千羽鶴", "text": "記録映像にもあった\nメルティ戦。"},
        { "location": "396/TALK"  , "narrator": "千羽鶴", "text": "まさにその中で発生\nしていた、彼女のココロの\n葛藤にスポットを当てる。"},
        { "location": "397/TALK"  , "narrator": "千羽鶴", "text": "この葛藤の解消は、\nメルティ戦の結末に\n大きな影響を与える。"},
        { "location": "398/TALK"  , "narrator": "千羽鶴", "text": "故に、貴方には\n解決に向けて\n頑張ってもらいたい。"},
        { "location": "402/TALK"  , "narrator": "千羽鶴", "text": "さて、今回の\nガブリエラについて\nなんだけども。"},
        { "location": "403/TALK"  , "narrator": "千羽鶴", "text": "彼女については、\n國政綾水との関係について\n焦点を当ててみる。"},
        { "location": "404/TALK"  , "narrator": "千羽鶴", "text": "具体的には、國政綾水に\nバイクで送ってもらった\n直後のエピソードとなる。"},
        { "location": "405/TALK"  , "narrator": "千羽鶴", "text": "彼女には本来、\n別の目的があった。"},
        { "location": "406/TALK"  , "narrator": "千羽鶴", "text": "けど、非常に重要な\n選択をした後に、國政\n綾水の後を追う事になる。"},
        { "location": "407/TALK"  , "narrator": "千羽鶴", "text": "その葛藤の解消について\n貴方に協力して欲しい。"},
        { "location": "411/TALK"  , "narrator": "千羽鶴", "text": "さて、今回の\n恋ヶ崎みやびについて\nなんだけども。"},
        { "location": "412/TALK"  , "narrator": "千羽鶴", "text": "今回もまた、彼女に\nついては、別の重要な\nシーンを見てもらう。"},
        { "location": "413/TALK"  , "narrator": "千羽鶴", "text": "今回はハッカーとしての\n彼女の一面について。"},
        { "location": "414/TALK"  , "narrator": "千羽鶴", "text": "彼女には様々な面が\nあるため、毎回何を\n見せるか非常に迷う。"},
        { "location": "415/TALK"  , "narrator": "千羽鶴", "text": "今回のシーンでは、\n彼女の今後にとって\n重要な決断をする"},
        { "location": "416/TALK"  , "narrator": "千羽鶴", "text": "その局面において、\n是非彼女を支援して\nあげて欲しい。"},
        { "location": "418/TALK"  , "narrator": "千羽鶴", "text": "それじゃ、健闘を――"},
        { "location": "419/TALK"  , "narrator": "千羽鶴", "text": "――と、そういえば。"},
        { "location": "420/TALK"  , "narrator": "千羽鶴", "text": "前回の<color=green>『一度しか答えない\n選択肢』</color>について、\n他の回答を調べてみた？"},
        { "location": "421/SEL"   , "narrator": "", "text": "調べてみたよ"},
        { "location": "422/SEL"   , "narrator": "", "text": "調べたし、SNSにアップもした"},
        { "location": "423/SEL"   , "narrator": "", "text": "何もしなかった"},
        { "location": "424/ACT"   , "narrator": "", "text": "調べてみたよ"},
        { "location": "425/TALK"  , "narrator": "千羽鶴", "text": "そう。\nそれは素敵。"},
        { "location": "426/ACT"   , "narrator": "", "text": "調べたし、SNSにアップもした"},
        { "location": "427/TALK"  , "narrator": "千羽鶴", "text": "それはとっても素敵！"},
        { "location": "428/ACT"   , "narrator": "", "text": "何もしなかった"},
        { "location": "429/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "431/TALK"  , "narrator": "千羽鶴", "text": "情報に貪欲になることは\nとても素晴らしいこと。"},
        { "location": "432/TALK"  , "narrator": "千羽鶴", "text": "そして、自分の持つ事実的\n情報をシェアすることは、\nとても重要なこと。"},
        { "location": "433/TALK"  , "narrator": "千羽鶴", "text": "多角的な視点による\n情報の取得は、きっと\n貴方を助けることになる。"},
        { "location": "434/TALK"  , "narrator": "千羽鶴", "text": "それじゃ今回も頑張って。"},
        { "location": "435/TALK"  , "narrator": "千羽鶴", "text": "貴方の今後に\nグッドラック。"},
        { "location": "108/DIALOG", "narrator": "Event/Dialog_EventPicWideNW", "text": "う ら ら か な 春 の 木 漏 れ 日 の 中 、\n君 は 私 に 告 白 を し た ― 。"},
        { "location": "176/DIALOG", "narrator": "Event/Dialog_EventPicWideNW", "text": "國 政 綾 水 (21) 、 待 望 の グ ラ ビ ア デ ビ ュ ー 。"},
        { "location": "180/DIALOG", "narrator": "Event/Dialog_EventPicWideNW", "text": "國 政 綾 水 (21) 、 待 望 の グ ラ ビ ア デ ビ ュ ー 。"},
        { "location": "233/DIALOG", "narrator": "Tutorial/Dialog_Anime1", "text": "$dialog_word$"},
        { "location": "235/DIALOG", "narrator": "Tutorial/Dialog_Anime2", "text": "$dialog_word$"},
        { "location": "237/DIALOG", "narrator": "Tutorial/Dialog_Anime3", "text": "$dialog_word$"},
        { "location": "239/DIALOG", "narrator": "Tutorial/Dialog_Anime4", "text": "$dialog_word$"},
        { "location": "241/DIALOG", "narrator": "Tutorial/Dialog_Anime5", "text": "$dialog_word$"}
    ]
