    "entry":
    [
        { "location": "233/SCENARIO", "narrator": "", "text": "250_すれ違い以前だわ"},
        { "location": "258/TALK"    , "narrator": "ガブリエラ", "text": "あー・・・"},
        { "location": "260/SEL"     , "narrator": "", "text": "どうしたの？"},
        { "location": "261/SEL"     , "narrator": "", "text": "もしかして甘味屋でのこと？"},
        { "location": "262/ACT"     , "narrator": "", "text": "どうしたの？"},
        { "location": "263/TALK"    , "narrator": "ガブリエラ", "text": "どうしたのじゃないわよ"},
        { "location": "264/TALK"    , "narrator": "ガブリエラ", "text": "甘味屋さんでのことよ"},
        { "location": "265/TALK"    , "narrator": "ガブリエラ", "text": "もう！"},
        { "location": "266/ACT"     , "narrator": "", "text": "もしかして甘味屋でのこと？"},
        { "location": "267/TALK"    , "narrator": "ガブリエラ", "text": "そうよ"},
        { "location": "268/TALK"    , "narrator": "ガブリエラ", "text": "甘味屋さんでのことよ"},
        { "location": "270/TALK"    , "narrator": "ガブリエラ", "text": "$handle$は本気出してないわよね"},
        { "location": "271/TALK"    , "narrator": "ガブリエラ", "text": "それとも"},
        { "location": "272/TALK"    , "narrator": "ガブリエラ", "text": "私にだけそうなのかしら？"},
        { "location": "275/SEL"     , "narrator": "", "text": "いつでも本気だよ"},
        { "location": "276/SEL"     , "narrator": "", "text": "ちょっと意地悪したくなって"},
        { "location": "277/SEL"     , "narrator": "", "text": "どうして信じてくれないの"},
        { "location": "278/ACT"     , "narrator": "", "text": "いつでも本気だよ"},
        { "location": "288/TALK"    , "narrator": "ガブリエラ", "text": "そうかしら？"},
        { "location": "289/TALK"    , "narrator": "ガブリエラ", "text": "どうもそうは思えないのよね・・・"},
        { "location": "290/ACT"     , "narrator": "", "text": "ちょっと意地悪したくなって"},
        { "location": "291/TALK"    , "narrator": "ガブリエラ", "text": "まああ！"},
        { "location": "293/TALK"    , "narrator": "ガブリエラ", "text": "ひどいこと言うのね！"},
        { "location": "294/ACT"     , "narrator": "", "text": "どうして信じてくれないの"},
        { "location": "295/TALK"    , "narrator": "ガブリエラ", "text": "えっ"},
        { "location": "296/TALK"    , "narrator": "ガブリエラ", "text": "そんなつもりじゃ・・・"},
        { "location": "298/TALK"    , "narrator": "ガブリエラ", "text": "とにかく！"},
        { "location": "299/TALK"    , "narrator": "ガブリエラ", "text": "みんなにはヒカルくんとの仲を詮索されたくないの！"},
        { "location": "300/TALK"    , "narrator": "ガブリエラ", "text": "だから貴方にどうすればいいか聞いたのに"},
        { "location": "301/TALK"    , "narrator": "ガブリエラ", "text": "全然役に立たなかったじゃないの！"},
        { "location": "303/SEL"     , "narrator": "", "text": "ごめんね"},
        { "location": "304/SEL"     , "narrator": "", "text": "そんなこともあるって"},
        { "location": "305/SEL"     , "narrator": "", "text": "次は任せて！"},
        { "location": "306/ACT"     , "narrator": "", "text": "ごめんね"},
        { "location": "307/TALK"    , "narrator": "ガブリエラ", "text": "・・・"},
        { "location": "308/TALK"    , "narrator": "ガブリエラ", "text": "まあいいわよ"},
        { "location": "309/ACT"     , "narrator": "", "text": "そんなこともあるって"},
        { "location": "310/TALK"    , "narrator": "ガブリエラ", "text": "それじゃ困るのよ"},
        { "location": "311/TALK"    , "narrator": "ガブリエラ", "text": "もう！"},
        { "location": "312/ACT"     , "narrator": "", "text": "次は任せて！"},
        { "location": "313/TALK"    , "narrator": "ガブリエラ", "text": "いっつも口ばっかりなんだから・・・"},
        { "location": "314/TALK"    , "narrator": "ガブリエラ", "text": "本当にお願いよ？"},
        { "location": "316/TALK"    , "narrator": "ガブリエラ", "text": "$handle$だから言っているのよ？"},
        { "location": "317/TALK"    , "narrator": "ガブリエラ", "text": "わかってて？"},
        { "location": "320/SEL"     , "narrator": "", "text": "うん"},
        { "location": "321/SEL"     , "narrator": "", "text": "ありがとう"},
        { "location": "322/SEL"     , "narrator": "", "text": "$handle$のことも気にして"},
        { "location": "324/ACT"     , "narrator": "", "text": "うん"},
        { "location": "326/TALK"    , "narrator": "ガブリエラ", "text": "本当にわかっているのかしら？"},
        { "location": "327/TALK"    , "narrator": "ガブリエラ", "text": "頼んだからね！"},
        { "location": "328/ACT"     , "narrator": "", "text": "ありがとう"},
        { "location": "330/TALK"    , "narrator": "ガブリエラ", "text": "別にお礼なんていいわよ"},
        { "location": "331/TALK"    , "narrator": "ガブリエラ", "text": "ちゃんとしてくれればいいだけなんだから"},
        { "location": "332/TALK"    , "narrator": "ガブリエラ", "text": "頼んだからね！"},
        { "location": "333/ACT"     , "narrator": "", "text": "$handle$のことも気にして"},
        { "location": "343/TALK"    , "narrator": "ガブリエラ", "text": "何を言い出すの！？"},
        { "location": "344/TALK"    , "narrator": "ガブリエラ", "text": "貴方がちゃんとしてくれればいいだけよ！？"},
        { "location": "345/TALK"    , "narrator": "ガブリエラ", "text": "わかってて？"},
        { "location": "346/TALK"    , "narrator": "ガブリエラ", "text": "それに"},
        { "location": "347/TALK"    , "narrator": "ガブリエラ", "text": "みんなにいい顔をしているのはそっちじゃないの・・・"},
        { "location": "349/TALK"    , "narrator": "ガブリエラ", "text": "とにかく！"},
        { "location": "350/TALK"    , "narrator": "ガブリエラ", "text": "頼んだからね！"},
        { "location": "352/TALK"    , "narrator": "ガブリエラ", "text": "メッセージも送っておくから"},
        { "location": "353/TALK"    , "narrator": "ガブリエラ", "text": "聞いておいてよね！"},
        { "location": "354/TALK"    , "narrator": "ガブリエラ", "text": "ちゃんと伝わってないと困るから！"},
        { "location": "357/TALK"    , "narrator": "ボイスメール", "text": "当たり前でしょう！？"},
        { "location": "284/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>600pt.</b></color></size>\nアップしました！"},
        { "location": "339/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>600pt.</b></color></size>\nアップしました！"},
