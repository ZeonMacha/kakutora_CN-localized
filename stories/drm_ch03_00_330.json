    "entry":
    [
        { "location": "157/SCENARIO", "narrator": "", "text": "330_あいつはいいやつ"},
        { "location": "182/TALK"    , "narrator": "ガブリエラ", "text": "いいやつってどういう意味なのかしら？"},
        { "location": "184/SEL"     , "narrator": "", "text": "言葉通りの意味"},
        { "location": "185/SEL"     , "narrator": "", "text": "恋愛対象外って意味"},
        { "location": "186/ACT"     , "narrator": "", "text": "言葉通りの意味"},
        { "location": "187/TALK"    , "narrator": "ガブリエラ", "text": "その意味がわからないから聞いているのよ"},
        { "location": "188/TALK"    , "narrator": "ガブリエラ", "text": "もう！"},
        { "location": "189/ACT"     , "narrator": "", "text": "恋愛対象外って意味"},
        { "location": "190/TALK"    , "narrator": "ガブリエラ", "text": "そうなの？"},
        { "location": "191/TALK"    , "narrator": "ガブリエラ", "text": "だったら雛の言うことがおかしいことになるわよ？"},
        { "location": "193/TALK"    , "narrator": "ガブリエラ", "text": "あのね"},
        { "location": "194/TALK"    , "narrator": "ガブリエラ", "text": "雛がヒカルくんのことをいいやつだって言ったのよ"},
        { "location": "195/TALK"    , "narrator": "ガブリエラ", "text": "だからおすすめするって言ったのよ"},
        { "location": "196/TALK"    , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "198/TALK"    , "narrator": "ガブリエラ", "text": "それって"},
        { "location": "199/TALK"    , "narrator": "ガブリエラ", "text": "好きってことじゃないのかしら？"},
        { "location": "201/SEL"     , "narrator": "", "text": "わかってないな"},
        { "location": "202/ACT"     , "narrator": "", "text": "わかってないな"},
        { "location": "204/TALK"    , "narrator": "ガブリエラ", "text": "んまあ！"},
        { "location": "205/TALK"    , "narrator": "ガブリエラ", "text": "じゃあ$handle$はわかってるっていうのかしら？"},
        { "location": "207/SEL"     , "narrator": "", "text": "$handle$とガブの関係みたいなもの"},
        { "location": "208/SEL"     , "narrator": "", "text": "友達以上じゃないってこと"},
        { "location": "209/SEL"     , "narrator": "", "text": "適当なことを言われただけ"},
        { "location": "210/ACT"     , "narrator": "", "text": "$handle$とガブの関係みたいなもの"},
        { "location": "211/ACT"     , "narrator": "", "text": "友達以上じゃないってこと"},
        { "location": "212/ACT"     , "narrator": "", "text": "適当なことを言われただけ"},
        { "location": "214/TALK"    , "narrator": "ガブリエラ", "text": "そういうことなのね"},
        { "location": "216/TALK"    , "narrator": "ガブリエラ", "text": "やっぱりわからないわ"},
        { "location": "218/SEL"     , "narrator": "", "text": "$handle$と付き合えばわかるよ"},
        { "location": "219/SEL"     , "narrator": "", "text": "まだ子供なんだね"},
        { "location": "220/SEL"     , "narrator": "", "text": "雛にもう一度聞けば"},
        { "location": "221/ACT"     , "narrator": "", "text": "$handle$と付き合えばわかるよ"},
        { "location": "231/TALK"    , "narrator": "ガブリエラ", "text": "えっ"},
        { "location": "232/TALK"    , "narrator": "ガブリエラ", "text": "そういうのはなしよ！？"},
        { "location": "233/TALK"    , "narrator": "ガブリエラ", "text": "なしだからね"},
        { "location": "234/ACT"     , "narrator": "", "text": "まだ子供なんだね"},
        { "location": "235/TALK"    , "narrator": "ガブリエラ", "text": "まあ！"},
        { "location": "236/TALK"    , "narrator": "ガブリエラ", "text": "ばかにしないでちょうだい！"},
        { "location": "237/ACT"     , "narrator": "", "text": "雛にもう一度聞けば"},
        { "location": "238/TALK"    , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "239/TALK"    , "narrator": "ガブリエラ", "text": "そうするしかないかしら"},
        { "location": "241/TALK"    , "narrator": "ガブリエラ", "text": "あっ"},
        { "location": "242/TALK"    , "narrator": "ガブリエラ", "text": "今わかったわ"},
        { "location": "243/TALK"    , "narrator": "ガブリエラ", "text": "$handle$みたいなのを"},
        { "location": "244/TALK"    , "narrator": "ガブリエラ", "text": "いいやつって言うんじゃないかしら"},
        { "location": "246/SEL"     , "narrator": "", "text": "そうかな"},
        { "location": "247/SEL"     , "narrator": "", "text": "どうかな"},
        { "location": "248/ACT"     , "narrator": "", "text": "そうかな"},
        { "location": "249/ACT"     , "narrator": "", "text": "どうかな"},
        { "location": "251/TALK"    , "narrator": "ガブリエラ", "text": "うん"},
        { "location": "252/TALK"    , "narrator": "ガブリエラ", "text": "きっとそうよ！"},
        { "location": "253/TALK"    , "narrator": "ガブリエラ", "text": "それとも"},
        { "location": "254/TALK"    , "narrator": "ガブリエラ", "text": "$handle$は悪いやつなの？"},
        { "location": "256/SEL"     , "narrator": "", "text": "まあね…"},
        { "location": "257/SEL"     , "narrator": "", "text": "まさか！"},
        { "location": "258/ACT"     , "narrator": "", "text": "まあね…"},
        { "location": "268/TALK"    , "narrator": "ガブリエラ", "text": "えっ…"},
        { "location": "269/TALK"    , "narrator": "ガブリエラ", "text": "$handle$が悪いやつだったなんて…"},
        { "location": "270/TALK"    , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "271/TALK"    , "narrator": "ガブリエラ", "text": "私"},
        { "location": "272/TALK"    , "narrator": "ガブリエラ", "text": "本当はいいやつだって知っていてよ？"},
        { "location": "274/TALK"    , "narrator": "ガブリエラ", "text": "あっ"},
        { "location": "275/TALK"    , "narrator": "ガブリエラ", "text": "使用人としてだから！！！！！！"},
        { "location": "277/TALK"    , "narrator": "ガブリエラ", "text": "誤解しないでよね！！！！！！！！"},
        { "location": "278/ACT"     , "narrator": "", "text": "まさか！"},
        { "location": "280/TALK"    , "narrator": "ガブリエラ", "text": "そうよね"},
        { "location": "281/TALK"    , "narrator": "ガブリエラ", "text": "$handle$はいいやつ"},
        { "location": "282/TALK"    , "narrator": "ガブリエラ", "text": "間違いないわ"},
        { "location": "285/TALK"    , "narrator": "ボイスメール", "text": "人畜無害"},
        { "location": "303/TALK"    , "narrator": "ガブリエラ", "text": "ね？"},
        { "location": "227/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>800pt.</b></color></size>\nアップしました！"},
        { "location": "264/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>800pt.</b></color></size>\nアップしました！"},
        { "location": "297/DIALOG"  , "narrator": "Dialog_GETVoice", "text": "<color=green>【ガブリエラ】</color>のボイスメール\n<color=red>【人畜無害】</color>\nをゲットしました！"}
    ]
}
