{
    "dir": "chap40/daydra/last_event_010.js",
    "type": "",
    "info": {
        "story_id": "12202",
        "cid": "",
        "title": "ラストストーリー",
        "sub_title": "つばめより～はじめての帰省"
    },
    "entry":
    [
        { "location": "23/TALK"   , "narrator": "つばめ", "text": "んー…、神楽ちゃん\nまだかなぁ？"},
        { "location": "29/TALK"   , "narrator": "つばめ", "text": "あ、神楽ちゃん…。"},
        { "location": "30/TALK"   , "narrator": "つばめ", "text": "そっかぁ…。\n急なお仕事なら\n仕方ないよね…。"},
        { "location": "31/TALK"   , "narrator": "つばめ", "text": "ていうか、\nわたしは行かなくても\n良かったのかな――"},
        { "location": "32/SEL"    , "narrator": "（選択肢）", "text": "ドタキャン？"},
        { "location": "33/ACT"    , "narrator": "", "text": "ドタキャン？"},
        { "location": "36/TALK"   , "narrator": "つばめ", "text": "えっ！？\n$handle$さん？"},
        { "location": "37/SEL"    , "narrator": "（選択肢）", "text": "そうだよ"},
        { "location": "38/ACT"    , "narrator": "", "text": "そうだよ"},
        { "location": "40/TALK"   , "narrator": "つばめ", "text": "えぇーっ！？\nどうして、普通に\nお話しできるの！？"},
        { "location": "41/SEL"    , "narrator": "（選択肢）", "text": "ライフギャザーを掌握して、無敵の人になったから"},
        { "location": "42/ACT"    , "narrator": "", "text": "ライフギャザーを掌握して、無敵の人になったから"},
        { "location": "44/TALK"   , "narrator": "つばめ", "text": "す、すごい！\nそんなスゴい人に\nなっちゃったんだ？"},
        { "location": "45/SEL"    , "narrator": "（選択肢）", "text": "喜んでくれてる？"},
        { "location": "46/ACT"    , "narrator": "", "text": "喜んでくれてる？"},
        { "location": "48/TALK"   , "narrator": "つばめ", "text": "うん。"},
        { "location": "49/TALK"   , "narrator": "つばめ", "text": "だって、これからは\n普通にお話しできるん\nでしょ？"},
        { "location": "50/TALK"   , "narrator": "つばめ", "text": "とっても嬉しいよ。"},
        { "location": "51/TALK"   , "narrator": "つばめ", "text": "そうだ。\n今日ってこれから、\nちょっと時間ある？"},
        { "location": "52/TALK"   , "narrator": "つばめ", "text": "$handle$さんと、\nもっと色々お話し\nしたいな。"},
        { "location": "53/SEL"    , "narrator": "（選択肢）", "text": "$me$も話したい"},
        { "location": "54/SEL"    , "narrator": "（選択肢）", "text": "デートだね！"},
        { "location": "55/ACT"    , "narrator": "", "text": "$me$も話したい"},
        { "location": "56/TALK"   , "narrator": "つばめ", "text": "えへへ、よかった。"},
        { "location": "57/ACT"    , "narrator": "", "text": "デートだね！"},
        { "location": "59/TALK"   , "narrator": "つばめ", "text": "えへへ…、\nうん、デートだよ。"},
        { "location": "61/TALK"   , "narrator": "つばめ", "text": "え、えへへ…。\nそうなっちゃうかな？"},
        { "location": "65/TALK"   , "narrator": "つばめ", "text": "それじゃ、行こっか。"},
        { "location": "86/TALK"   , "narrator": "透明つばめ", "text": "ごめんね、\n急にこんなお願い\nしちゃって。"},
        { "location": "87/SEL"    , "narrator": "（選択肢）", "text": "つばめのワガママには慣れてる"},
        { "location": "88/SEL"    , "narrator": "（選択肢）", "text": "いや、嬉しいよ"},
        { "location": "89/ACT"    , "narrator": "", "text": "つばめのワガママには慣れてる"},
        { "location": "91/TALK"   , "narrator": "透明つばめ", "text": "わたし、そんなに\nワガママ言ってた！？"},
        { "location": "92/TALK"   , "narrator": "透明つばめ", "text": "自分ではぜんぜん\n気付かなかったよ…。\nごめんね…。"},
        { "location": "93/ACT"    , "narrator": "", "text": "いや、嬉しいよ"},
        { "location": "94/TALK"   , "narrator": "透明つばめ", "text": "そう言ってもらえると\nわたしも嬉しいな。"},
        { "location": "98/TALK"   , "narrator": "透明つばめ", "text": "…………。"},
        { "location": "99/SEL"    , "narrator": "（選択肢）", "text": "どうしたの？"},
        { "location": "100/ACT"   , "narrator": "", "text": "どうしたの？"},
        { "location": "104/TALK"  , "narrator": "透明つばめ", "text": "あ、うん。\nちょっと、色んなこと\n思い出してて…。"},
        { "location": "105/TALK"  , "narrator": "透明つばめ", "text": "$handle$さんと\n会ってから今まで…。"},
        { "location": "106/TALK"  , "narrator": "透明つばめ", "text": "色んなことが\nあったなぁ、って…。"},
        { "location": "107/SEL"   , "narrator": "（選択肢）", "text": "何が一番思い出深い？"},
        { "location": "108/SEL"   , "narrator": "（選択肢）", "text": "それがあったからこその平和だ"},
        { "location": "109/ACT"   , "narrator": "", "text": "何が一番思い出深い？"},
        { "location": "111/TALK"  , "narrator": "透明つばめ", "text": "一番はやっぱり、\n$handle$さんと\n出会えたことだよ。"},
        { "location": "112/TALK"  , "narrator": "透明つばめ", "text": "$handle$さんは\n何が一番思い出深い？"},
        { "location": "113/SEL"   , "narrator": "（選択肢）", "text": "$me$も一緒だ"},
        { "location": "114/SEL"   , "narrator": "（選択肢）", "text": "つばめと神楽がテルマエでイチャついてたこと"},
        { "location": "115/SEL"   , "narrator": "（選択肢）", "text": "つばめとガブリエラの仲直り"},
        { "location": "116/SEL"   , "narrator": "（選択肢）", "text": "つばめと夜に一緒に話した毎日"},
        { "location": "117/SEL"   , "narrator": "（選択肢）", "text": "つばめが管理庁に捕まったこと"},
        { "location": "118/ACT"   , "narrator": "", "text": "$me$も一緒だ"},
        { "location": "119/TALK"  , "narrator": "透明つばめ", "text": "えへへ、やっぱり？"},
        { "location": "120/TALK"  , "narrator": "透明つばめ", "text": "あの日から今日まで、\n色んなこと、いっぱい\nお話ししたよね。"},
        { "location": "121/ACT"   , "narrator": "", "text": "つばめと神楽がテルマエでイチャついてたこと"},
        { "location": "122/TALK"  , "narrator": "透明つばめ", "text": "あ、あったね、\nそんなことも…。"},
        { "location": "124/TALK"  , "narrator": "透明つばめ", "text": "っていうか、\n女の子のお風呂を\n覗いたらダメだよ！"},
        { "location": "125/ACT"   , "narrator": "", "text": "つばめとガブリエラの仲直り"},
        { "location": "126/TALK"  , "narrator": "透明つばめ", "text": "あはは、ガブちゃん、\n最初はいっつも\n怒ってたよね。"},
        { "location": "127/TALK"  , "narrator": "透明つばめ", "text": "もうすっかり\n忘れちゃってたよ。"},
        { "location": "128/TALK"  , "narrator": "透明つばめ", "text": "だって今は、\nとっても仲良し\nだもん。"},
        { "location": "130/TALK"  , "narrator": "透明つばめ", "text": "…でも、ガブちゃんの\n前では言っちゃ\nダメだよ？"},
        { "location": "131/TALK"  , "narrator": "透明つばめ", "text": "きっと、照れて\n怒っちゃうと思うし。"},
        { "location": "132/ACT"   , "narrator": "", "text": "つばめと夜に一緒に話した毎日"},
        { "location": "133/TALK"  , "narrator": "透明つばめ", "text": "色んなこと、\n沢山お話ししたよね。"},
        { "location": "134/TALK"  , "narrator": "透明つばめ", "text": "その日にあった\nちょっとしたこと\nとか…。"},
        { "location": "136/TALK"  , "narrator": "透明つばめ", "text": "わたしの、悩みとか\n聞いてもらったりも\nして…。"},
        { "location": "137/TALK"  , "narrator": "透明つばめ", "text": "いっつも、沢山元気\nもらってたよ。"},
        { "location": "138/ACT"   , "narrator": "", "text": "つばめが管理庁に捕まったこと"},
        { "location": "140/TALK"  , "narrator": "透明つばめ", "text": "あの時は…とっても\n辛くて悲しかった…。"},
        { "location": "141/TALK"  , "narrator": "透明つばめ", "text": "神楽ちゃんが\nずっと悲しそうな顔\nしてたし。"},
        { "location": "142/TALK"  , "narrator": "透明つばめ", "text": "それに…。"},
        { "location": "145/TALK"  , "narrator": "透明つばめ", "text": "$handle$さんと\nお話しすることも\nできなかったし。"},
        { "location": "146/TALK"  , "narrator": "透明つばめ", "text": "…大好きなあなたと\nあんなに離れてたの、\n初めてだったから。"},
        { "location": "148/TALK"  , "narrator": "透明つばめ", "text": "$handle$さんと\nお話しすることも\nできなくて…。"},
        { "location": "151/ACT"   , "narrator": "", "text": "それがあったからこその平和だ"},
        { "location": "152/TALK"  , "narrator": "透明つばめ", "text": "ホントだよね。"},
        { "location": "155/TALK"  , "narrator": "透明つばめ", "text": "…ふふっ、思い出すと\n本当に色んなことが\nあったよね。"},
        { "location": "157/TALK"  , "narrator": "透明つばめ", "text": "でも、もし\n$handle$さんと\n出逢えなかったら――"},
        { "location": "158/TALK"  , "narrator": "透明つばめ", "text": "わたし、\nどうなっちゃって\nいたんだろう。"},
        { "location": "159/TALK"  , "narrator": "透明つばめ", "text": "……。"},
        { "location": "160/TALK"  , "narrator": "透明つばめ", "text": "正直、あまり\n明るい未来を\n想像出来ないかも…。"},
        { "location": "161/SEL"   , "narrator": "（選択肢）", "text": "つばめは一人でもしっかりやれる子だから大丈夫だったと思うよ"},
        { "location": "162/SEL"   , "narrator": "（選択肢）", "text": "どんな人生も楽有れば苦ありだよ"},
        { "location": "163/ACT"   , "narrator": "", "text": "つばめは一人でもしっかりやれる子だから大丈夫だったと思うよ"},
        { "location": "165/TALK"  , "narrator": "透明つばめ", "text": "えへへ…そうかな？"},
        { "location": "166/ACT"   , "narrator": "", "text": "どんな人生も楽有れば苦ありだよ"},
        { "location": "168/TALK"  , "narrator": "透明つばめ", "text": "…そうだよね。"},
        { "location": "169/TALK"  , "narrator": "透明つばめ", "text": "きっと、今とは全然\n違うけど、楽しい事も\n大変なことも――"},
        { "location": "170/TALK"  , "narrator": "透明つばめ", "text": "どっちもいっぱい\nあったよね。"},
        { "location": "173/TALK"  , "narrator": "透明つばめ", "text": "でもやっぱり、\n今のわたしは――"},
        { "location": "174/TALK"  , "narrator": "透明つばめ", "text": "$handle$さんと\n一緒に暮らして、\n作ってきたわたしだから。"},
        { "location": "175/TALK"  , "narrator": "透明つばめ", "text": "それで、わたしは\n今のわたしが\n大好きだから。"},
        { "location": "176/TALK"  , "narrator": "透明つばめ", "text": "だから、今のわたしを\n作ってくれた\n$handle$さんは――"},
        { "location": "177/TALK"  , "narrator": "透明つばめ", "text": "わたしにとっては、\n大切な人なんだ。"},
        { "location": "179/TALK"  , "narrator": "透明つばめ", "text": "だから、改めて\nありがとう。"},
        { "location": "180/SEL"   , "narrator": "（選択肢）", "text": "$me$もつばめと出逢ってから変わったよ、だからありがとう"},
        { "location": "181/SEL"   , "narrator": "（選択肢）", "text": "どういたしまして"},
        { "location": "182/ACT"   , "narrator": "", "text": "$me$もつばめと出逢ってから変わったよ、だからありがとう"},
        { "location": "184/TALK"  , "narrator": "透明つばめ", "text": "えっ！\nそうなの！？"},
        { "location": "185/TALK"  , "narrator": "透明つばめ", "text": "そっかー…\nなんだか嬉しいな。"},
        { "location": "186/TALK"  , "narrator": "透明つばめ", "text": "わたしみたいに\nなんの取り柄もなくても\n人を変えられるんだね。"},
        { "location": "187/SEL"   , "narrator": "（選択肢）", "text": "そういうこと言うもんじゃないよ、つばめには素敵なところが沢山ある！"},
        { "location": "188/SEL"   , "narrator": "（選択肢）", "text": "そうだよ"},
        { "location": "189/ACT"   , "narrator": "", "text": "そういうこと言うもんじゃないよ、つばめには素敵なところが沢山ある！"},
        { "location": "191/TALK"  , "narrator": "透明つばめ", "text": "うーん、\nたとえば……？"},
        { "location": "192/SEL"   , "narrator": "（選択肢）", "text": "女神のように優しいよね"},
        { "location": "193/SEL"   , "narrator": "（選択肢）", "text": "女神のように可愛いよね"},
        { "location": "194/SEL"   , "narrator": "（選択肢）", "text": "やると決めたことは最後まで諦めないよね"},
        { "location": "195/SEL"   , "narrator": "（選択肢）", "text": "どんな時でも一生懸命だよね"},
        { "location": "196/ACT"   , "narrator": "", "text": "女神のように優しいよね"},
        { "location": "198/TALK"  , "narrator": "透明つばめ", "text": "そ、そうかな……えへへ。"},
        { "location": "199/TALK"  , "narrator": "透明つばめ", "text": "$handle$さんに\nそう言われると、ホントに\nそう思えるから不思議。"},
        { "location": "200/ACT"   , "narrator": "", "text": "女神のように可愛いよね"},
        { "location": "202/TALK"  , "narrator": "透明つばめ", "text": "え！？\nそ、そうかな……？"},
        { "location": "203/TALK"  , "narrator": "透明つばめ", "text": "なんか神楽ちゃんと\nお話してる気分だよ。"},
        { "location": "204/ACT"   , "narrator": "", "text": "やると決めたことは最後まで諦めないよね"},
        { "location": "206/TALK"  , "narrator": "透明つばめ", "text": "えへへ……そうかも、\nわたし強情だから。"},
        { "location": "207/TALK"  , "narrator": "透明つばめ", "text": "でも――"},
        { "location": "208/TALK"  , "narrator": "透明つばめ", "text": "$handle$さんに\nとっては、それは\nいいことなんだね。"},
        { "location": "209/TALK"  , "narrator": "透明つばめ", "text": "じゃあ、これからも\nそうやって\n頑張っていくね！"},
        { "location": "210/ACT"   , "narrator": "", "text": "どんな時でも一生懸命だよね"},
        { "location": "212/TALK"  , "narrator": "透明つばめ", "text": "えへへ……そうかな？"},
        { "location": "213/TALK"  , "narrator": "透明つばめ", "text": "でも――"},
        { "location": "214/TALK"  , "narrator": "透明つばめ", "text": "$handle$さんが\nそう言ってくれるなら\nきっとそうなんだね。"},
        { "location": "215/TALK"  , "narrator": "透明つばめ", "text": "わたしは、わたしなりに\nいつも頑張ってる\nだけだけど――"},
        { "location": "216/TALK"  , "narrator": "透明つばめ", "text": "そう言ってもらえると\nすごく嬉しいよ。"},
        { "location": "218/ACT"   , "narrator": "", "text": "そうだよ"},
        { "location": "220/TALK"  , "narrator": "透明つばめ", "text": "えへへ…。"},
        { "location": "222/ACT"   , "narrator": "", "text": "どういたしまして"},
        { "location": "225/TALK"  , "narrator": "透明つばめ", "text": "…………。"},
        { "location": "226/TALK"  , "narrator": "透明つばめ", "text": "あの、ね…。\n笑われちゃうかも\nしれないけど…。"},
        { "location": "227/TALK"  , "narrator": "透明つばめ", "text": "これからも、\nわたしのことずっと、\n見ててくれる？"},
        { "location": "228/SEL"   , "narrator": "（選択肢）", "text": "当然だ"},
        { "location": "229/SEL"   , "narrator": "（選択肢）", "text": "どうしたの？"},
        { "location": "230/ACT"   , "narrator": "", "text": "当然だ"},
        { "location": "233/TALK"  , "narrator": "透明つばめ", "text": "…そうだよね。\n$handle$さんとは\n夫婦なんだもん。"},
        { "location": "235/TALK"  , "narrator": "透明つばめ", "text": "不安にならないで、\n信じてなくちゃ\nダメだよね。"},
        { "location": "238/TALK"  , "narrator": "透明つばめ", "text": "…そうだよね。\n$handle$さんは\nわたしの恋人だもん。"},
        { "location": "240/TALK"  , "narrator": "透明つばめ", "text": "不安にならないで、\n信じてなくちゃ\nダメだよね。"},
        { "location": "242/TALK"  , "narrator": "透明つばめ", "text": "…よかった。"},
        { "location": "243/TALK"  , "narrator": "透明つばめ", "text": "とっても安心したよ。"},
        { "location": "245/ACT"   , "narrator": "", "text": "どうしたの？"},
        { "location": "247/TALK"  , "narrator": "透明つばめ", "text": "なんでかな？\n急に不安な気持ちに\nなっちゃって…。"},
        { "location": "248/TALK"  , "narrator": "透明つばめ", "text": "変だよね。\n理由もなくこんな\n気持ちになるなんて。"},
        { "location": "250/TALK"  , "narrator": "透明つばめ", "text": "ごめんね。\n今の質問、忘れて。"},
        { "location": "251/SEL"   , "narrator": "（選択肢）", "text": "ちゃんと見てるよ"},
        { "location": "252/SEL"   , "narrator": "（選択肢）", "text": "いられる間は、ずっと一緒にいるよ"},
        { "location": "253/ACT"   , "narrator": "", "text": "ちゃんと見てるよ"},
        { "location": "255/TALK"  , "narrator": "透明つばめ", "text": "…よかった。"},
        { "location": "256/TALK"  , "narrator": "透明つばめ", "text": "それ聞いたら、\n一気に心が軽く\nなったかも。"},
        { "location": "257/ACT"   , "narrator": "", "text": "いられる間は、ずっと一緒にいるよ"},
        { "location": "259/TALK"  , "narrator": "透明つばめ", "text": "…うん。"},
        { "location": "261/TALK"  , "narrator": "透明つばめ", "text": "$handle$さんの\nその言葉、\n信じてるよ。"},
        { "location": "281/TALK"  , "narrator": "つばめ", "text": "…暗くなっちゃったね。"},
        { "location": "282/TALK"  , "narrator": "つばめ", "text": "あーあ、普通に\nお話しできるって\nわかってたなら…。"},
        { "location": "283/TALK"  , "narrator": "つばめ", "text": "もっと早い時間から\n遊びに行ってたのに。"},
        { "location": "284/TALK"  , "narrator": "つばめ", "text": "わたしね、\n$handle$さんに…。"},
        { "location": "285/TALK"  , "narrator": "つばめ", "text": "静岡を案内して\nあげたいんだ。"},
        { "location": "286/TALK"  , "narrator": "つばめ", "text": "ってうか、\n$handle$さんは\n静岡行ったことある？"},
        { "location": "287/SEL"   , "narrator": "（選択肢）", "text": "無いから楽しみ"},
        { "location": "288/SEL"   , "narrator": "（選択肢）", "text": "行ったことはあるよ"},
        { "location": "289/SEL"   , "narrator": "（選択肢）", "text": "静岡在住です"},
        { "location": "290/ACT"   , "narrator": "", "text": "無いから楽しみ"},
        { "location": "291/TALK"  , "narrator": "つばめ", "text": "そ、そうなんだ…。"},
        { "location": "292/TALK"  , "narrator": "つばめ", "text": "それじゃあ、\n$handle$さんの\n静岡初体験は…。"},
        { "location": "293/TALK"  , "narrator": "つばめ", "text": "わたしと一緒で\n決まりだね！"},
        { "location": "294/ACT"   , "narrator": "", "text": "行ったことはあるよ"},
        { "location": "295/TALK"  , "narrator": "つばめ", "text": "そっかぁ。\nじゃあ、初めてじゃ\nないんだ？"},
        { "location": "296/TALK"  , "narrator": "つばめ", "text": "ちょっと残念だけど、\n行ったことないところ\nとか、案内するね。"},
        { "location": "297/ACT"   , "narrator": "", "text": "静岡在住です"},
        { "location": "298/TALK"  , "narrator": "つばめ", "text": "えぇっ、\nそうだったの！？"},
        { "location": "299/TALK"  , "narrator": "つばめ", "text": "うーん…知らなそうな\n隠れ家とかって、\nあったかなぁ…。"},
        { "location": "302/TALK"  , "narrator": "つばめ", "text": "わたしも、昔はあまり\n出歩かなかったから\n詳しくなかったし…。"},
        { "location": "303/TALK"  , "narrator": "つばめ", "text": "だから実は、\n実家に帰ったときに\n色々調べてたんだ！"},
        { "location": "304/TALK"  , "narrator": "つばめ", "text": "$handle$さんに\n喜んでもらえたら\nいいなぁって思って。"},
        { "location": "305/SEL"   , "narrator": "（選択肢）", "text": "気付かなかったよ"},
        { "location": "306/ACT"   , "narrator": "", "text": "気付かなかったよ"},
        { "location": "309/TALK"  , "narrator": "つばめ", "text": "$handle$さんを\n驚かせたかった\nからね。"},
        { "location": "310/TALK"  , "narrator": "つばめ", "text": "バレちゃわないように\n調べるの、結構大変\nだったけど…。"},
        { "location": "311/TALK"  , "narrator": "つばめ", "text": "一緒に見て回るのを\n想像しながらだった\nから…。"},
        { "location": "312/TALK"  , "narrator": "つばめ", "text": "あの時間も、\n楽しかったなぁ。"},
        { "location": "313/TALK"  , "narrator": "つばめ", "text": "絶対、一緒に\n静岡行こうね！"},
        { "location": "315/SEL"   , "narrator": "（選択肢）", "text": "行こう行こう！"},
        { "location": "316/SEL"   , "narrator": "（選択肢）", "text": "実はつばめに伝えなければならないことがある"},
        { "location": "317/ACT"   , "narrator": "", "text": "行こう行こう！"},
        { "location": "318/TALK"  , "narrator": "つばめ", "text": "楽しみ～！！"},
        { "location": "319/TALK"  , "narrator": "つばめ", "text": "…それじゃ、またね？"},
        { "location": "321/ACT"   , "narrator": "", "text": "実はつばめに伝えなければならないことがある"},
        { "location": "326/TALK"  , "narrator": "つばめ", "text": "え！？\nえっと…なにかな？"},
        { "location": "327/SEL"   , "narrator": "（選択肢）", "text": "あと数日で回線が切れてしまって、もうお別れなんだ"},
        { "location": "328/ACT"   , "narrator": "", "text": "あと数日で回線が切れてしまって、もうお別れなんだ"},
        { "location": "330/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "331/TALK"  , "narrator": "つばめ", "text": "そっか…。\n何となく、その事かなと\n思ってたよ。"},
        { "location": "332/SEL"   , "narrator": "（選択肢）", "text": "なんでわかったの！？"},
        { "location": "333/ACT"   , "narrator": "", "text": "なんでわかったの！？"},
        { "location": "335/TALK"  , "narrator": "つばめ", "text": "自分でも\nよくわからないけど、\nなんか空気っていうか。"},
        { "location": "336/TALK"  , "narrator": "つばめ", "text": "空を見てたら、\nもしかしたらもう、\nお別れなのかも…って。"},
        { "location": "337/TALK"  , "narrator": "つばめ", "text": "でも、\n気のせいの方が\n良かったけどね…。"},
        { "location": "338/SEL"   , "narrator": "（選択肢）", "text": "ごめんね"},
        { "location": "339/ACT"   , "narrator": "", "text": "ごめんね"},
        { "location": "341/TALK"  , "narrator": "つばめ", "text": "えっ？　なんで\n$handle$さんが\n謝るの！？"},
        { "location": "342/TALK"  , "narrator": "つばめ", "text": "回線が切れるのは\n$handle$さんの\nせいじゃないし。"},
        { "location": "343/TALK"  , "narrator": "つばめ", "text": "それに、どんな\nお友達だって、いつかは\n別れの時が来るもん。"},
        { "location": "344/TALK"  , "narrator": "つばめ", "text": "それと同じだよ。"},
        { "location": "345/TALK"  , "narrator": "つばめ", "text": "もちろん、\nどうしたって\n寂しいけど……。"},
        { "location": "346/TALK"  , "narrator": "つばめ", "text": "……っ…。"},
        { "location": "347/SEL"   , "narrator": "（選択肢）", "text": "つばめ、愛してるよ"},
        { "location": "348/SEL"   , "narrator": "（選択肢）", "text": "つばめといた時間は、ホントに楽しかった"},
        { "location": "349/ACT"   , "narrator": "", "text": "つばめ、愛してるよ"},
        { "location": "351/TALK"  , "narrator": "つばめ", "text": "わたしも\n愛してるよ！！！"},
        { "location": "352/TALK"  , "narrator": "つばめ", "text": "すごくすごくすごーく\n愛してるよ！？"},
        { "location": "354/TALK"  , "narrator": "つばめ", "text": "わたしも\n大好きだよ？"},
        { "location": "356/ACT"   , "narrator": "", "text": "つばめといた時間は、ホントに楽しかった"},
        { "location": "357/TALK"  , "narrator": "つばめ", "text": "わたしも、\n$handle$さんと\nいられて楽しかったよ。"},
        { "location": "358/TALK"  , "narrator": "つばめ", "text": "本当に、今までの\n思い出の中で、一番\n楽しい想い出になってる。"},
        { "location": "360/TALK"  , "narrator": "つばめ", "text": "…だから、ありがとう。"},
        { "location": "361/TALK"  , "narrator": "つばめ", "text": "こうして想いをちゃんと\n伝えることができて、\nよかった……。"},
        { "location": "362/TALK"  , "narrator": "つばめ", "text": "お別れのこと、\n教えてくれて\n本当にありがとう。"},
        { "location": "364/TALK"  , "narrator": "つばめ", "text": "え！？\nえっと…なにかな？"},
        { "location": "365/SEL"   , "narrator": "（選択肢）", "text": "あと数日で回線が切れてしまって、もうお別れなんだ"},
        { "location": "366/SEL"   , "narrator": "（選択肢）", "text": "可愛いつばめが大好きだよってことを伝えたくて"},
        { "location": "367/ACT"   , "narrator": "", "text": "あと数日で回線が切れてしまって、もうお別れなんだ"},
        { "location": "368/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "369/TALK"  , "narrator": "つばめ", "text": "…そっか。"},
        { "location": "370/TALK"  , "narrator": "つばめ", "text": "いつかは来ると\n思ってたよ。"},
        { "location": "371/TALK"  , "narrator": "つばめ", "text": "だから、全然平気だよ。"},
        { "location": "372/TALK"  , "narrator": "つばめ", "text": "けど……やっぱり……"},
        { "location": "373/TALK"  , "narrator": "つばめ", "text": "今は少しだけ\n泣いちゃうかも……っ。"},
        { "location": "374/SEL"   , "narrator": "（選択肢）", "text": "…ごめんね"},
        { "location": "375/ACT"   , "narrator": "", "text": "…ごめんね"},
        { "location": "377/TALK"  , "narrator": "つばめ", "text": "違うの！\nあやまらないで…。"},
        { "location": "378/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "379/TALK"  , "narrator": "つばめ", "text": "いつ頃\nいなくなっちゃうのかな…"},
        { "location": "380/SEL"   , "narrator": "（選択肢）", "text": "あと数日したら…"},
        { "location": "381/ACT"   , "narrator": "", "text": "あと数日したら…"},
        { "location": "383/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "384/TALK"  , "narrator": "つばめ", "text": "そんなに…すぐなんだ…。"},
        { "location": "385/TALK"  , "narrator": "つばめ", "text": "…ううん、大丈夫だよ。\nちゃんと整理つけるから。"},
        { "location": "386/TALK"  , "narrator": "つばめ", "text": "時間、短いから\n間に合うかわからないけど\nでも、ちゃんとやるから。"},
        { "location": "387/TALK"  , "narrator": "つばめ", "text": "でもやっぱり\n今は無理かも……っ"},
        { "location": "388/TALK"  , "narrator": "つばめ", "text": "…っ……うっ…"},
        { "location": "389/SEL"   , "narrator": "（選択肢）", "text": "つばめ…"},
        { "location": "390/ACT"   , "narrator": "", "text": "つばめ…"},
        { "location": "392/TALK"  , "narrator": "つばめ", "text": "ごめんね……っ、\nこんなつもりじゃ\nなかったんだけど…っ…"},
        { "location": "393/TALK"  , "narrator": "つばめ", "text": "でもっ……\nありがとう……"},
        { "location": "394/TALK"  , "narrator": "つばめ", "text": "ちゃんと言ってくれて。"},
        { "location": "395/TALK"  , "narrator": "つばめ", "text": "わたしね、\n$handle$さんは\n命の恩人だと思ってるの。"},
        { "location": "396/TALK"  , "narrator": "つばめ", "text": "横須賀で死のうと思った\nわたしを助けてくれて。"},
        { "location": "397/TALK"  , "narrator": "つばめ", "text": "神楽ちゃんとの戦いで\n一度死んだのだって\n助けてくれて。"},
        { "location": "398/TALK"  , "narrator": "つばめ", "text": "だから、この命は\n絶対に大事にするから。"},
        { "location": "399/TALK"  , "narrator": "つばめ", "text": "それだけは、\n絶対に伝えたくて。"},
        { "location": "400/SEL"   , "narrator": "（選択肢）", "text": "$me$もつばめのために、自分の命は大事にするよ"},
        { "location": "401/ACT"   , "narrator": "", "text": "$me$もつばめのために、自分の命は大事にするよ"},
        { "location": "403/TALK"  , "narrator": "つばめ", "text": "ありがとう……。"},
        { "location": "404/TALK"  , "narrator": "つばめ", "text": "わたし、\n$handle$さんが\n死んじゃったら……"},
        { "location": "405/TALK"  , "narrator": "つばめ", "text": "きっと、\n生きていけなく\nなっちゃうから……。"},
        { "location": "406/TALK"  , "narrator": "つばめ", "text": "だから、約束だよ？"},
        { "location": "407/SEL"   , "narrator": "（選択肢）", "text": "約束だ"},
        { "location": "408/ACT"   , "narrator": "", "text": "約束だ"},
        { "location": "410/TALK"  , "narrator": "つばめ", "text": "うん。\n…えへへ。"},
        { "location": "411/ACT"   , "narrator": "", "text": "可愛いつばめが大好きだよってことを伝えたくて"},
        { "location": "412/TALK"  , "narrator": "つばめ", "text": "えっ！？"},
        { "location": "413/TALK"  , "narrator": "つばめ", "text": "…そ、そんなこと\n急に言われても……。"},
        { "location": "414/TALK"  , "narrator": "つばめ", "text": "もちろん嬉しいけど"},
        { "location": "415/TALK"  , "narrator": "つばめ", "text": "…えっと……"},
        { "location": "416/TALK"  , "narrator": "つばめ", "text": "わたしも大好きだよ？\n…えへへ。"},
        { "location": "417/TALK"  , "narrator": "つばめ", "text": "…それじゃ、またね？"},
        { "location": "423/TALK"  , "narrator": "つばめ", "text": "……それじゃ、\nなんだか名残惜しいけど。"},
        { "location": "424/TALK"  , "narrator": "つばめ", "text": "また逢える日まで。\n今までずっと…\nありがとう。"},
        { "location": "427/TALK"  , "narrator": "つばめ", "text": "ところで、あのね？"},
        { "location": "428/TALK"  , "narrator": "つばめ", "text": "もしかしたら、もう\n間に合わないのかも\nしれないけど……。"},
        { "location": "429/SEL"   , "narrator": "（選択肢）", "text": "どうしたの？"},
        { "location": "430/ACT"   , "narrator": "", "text": "どうしたの？"},
        { "location": "432/TALK"  , "narrator": "つばめ", "text": "えっと――"},
        { "location": "433/TALK"  , "narrator": "つばめ", "text": "$handle$さんに\n一緒にいて欲しい\nことがあって……。"},
        { "location": "434/TALK"  , "narrator": "つばめ", "text": "実は、明日から掛川に\n帰省するんだけど……。"},
        { "location": "435/SEL"   , "narrator": "（選択肢）", "text": "お父さんとケンカでもしてるの？"},
        { "location": "436/ACT"   , "narrator": "", "text": "お父さんとケンカでもしてるの？"},
        { "location": "438/TALK"  , "narrator": "つばめ", "text": "ううん、\nそうじゃなくて……"},
        { "location": "439/TALK"  , "narrator": "つばめ", "text": "えっと、\nそうじゃないんだけど"},
        { "location": "440/TALK"  , "narrator": "つばめ", "text": "わたし一人だと\nどうしたらいいか\n解らなくなりそうで。"},
        { "location": "441/TALK"  , "narrator": "つばめ", "text": "あの！\nとにかく！\n一緒に来てくれますかっ！"},
        { "location": "442/SEL"   , "narrator": "（選択肢）", "text": "あ、はい"},
        { "location": "443/ACT"   , "narrator": "", "text": "あ、はい"},
        { "location": "445/TALK"  , "narrator": "つばめ", "text": "わぁ～、よかったぁ～！\nありがとう！"},
        { "location": "451/DIALOG", "narrator": "", "text": "そして翌日。\n\n静岡県掛川市、\nつばめの実家にて――。"},
        { "location": "466/TALK"  , "narrator": "つばめ", "text": "お父さん、\nただいまー……。"},
        { "location": "467/TALK"  , "narrator": "千羽鶴", "text": "ただいま。"},
        { "location": "468/SEL"   , "narrator": "（選択肢）", "text": "は！？！？"},
        { "location": "469/ACT"   , "narrator": "", "text": "は！？！？"},
        { "location": "472/TALK"  , "narrator": "啓介", "text": "早かったな。"},
        { "location": "474/TALK"  , "narrator": "つばめ", "text": "う、うん。"},
        { "location": "475/TALK"  , "narrator": "啓介", "text": "夕飯はどうする。"},
        { "location": "476/TALK"  , "narrator": "つばめ", "text": "えっと、久し振りに\nげんこつハンバーグ\n食べに行きたいな…。"},
        { "location": "478/TALK"  , "narrator": "千羽鶴", "text": "さんまの塩焼き。"},
        { "location": "479/TALK"  , "narrator": "啓介", "text": "相変わらずその、\n二人して好みが全然\n違うのを何とかしろ。"},
        { "location": "480/TALK"  , "narrator": "つばめ", "text": "あ、あはは……"},
        { "location": "481/TALK"  , "narrator": "啓介", "text": "どっちでもいいが、\n夕飯出かけるまでに\nひとつに絞っておけ。"},
        { "location": "483/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "484/TALK"  , "narrator": "つばめ", "text": "はぁ……。"},
        { "location": "486/TALK"  , "narrator": "千羽鶴", "text": "げんこつハンバーグって\n痛いの？"},
        { "location": "488/TALK"  , "narrator": "つばめ", "text": "えっ？"},
        { "location": "489/TALK"  , "narrator": "つばめ", "text": "あっ、ううん、違うよ。\nゲンコツくらい大きくて\n丸いハンバーグなんだ。"},
        { "location": "490/TALK"  , "narrator": "つばめ", "text": "わたしの大好物で。"},
        { "location": "491/TALK"  , "narrator": "千羽鶴", "text": "……そう。"},
        { "location": "492/TALK"  , "narrator": "千羽鶴", "text": "それじゃ、今日は\n私もそれにする。"},
        { "location": "493/SEL"   , "narrator": "（選択肢）", "text": "まてまてまてまて！"},
        { "location": "494/ACT"   , "narrator": "", "text": "まてまてまてまて！"},
        { "location": "500/TALK"  , "narrator": "つばめ", "text": "$handle$さん。"},
        { "location": "501/TALK"  , "narrator": "千羽鶴", "text": "どうしたの？"},
        { "location": "502/SEL"   , "narrator": "（選択肢）", "text": "どうなってるの！？"},
        { "location": "503/ACT"   , "narrator": "", "text": "どうなってるの！？"},
        { "location": "506/TALK"  , "narrator": "千羽鶴", "text": "見ての通り。\n逢瀬千羽鶴になった。"},
        { "location": "507/TALK"  , "narrator": "千羽鶴", "text": "今後ともよろしく。"},
        { "location": "508/SEL"   , "narrator": "（選択肢）", "text": "あ…はい……"},
        { "location": "509/ACT"   , "narrator": "", "text": "あ…はい……"},
        { "location": "511/TALK"  , "narrator": "千羽鶴", "text": "少しだけ\n真面目に説明する。"},
        { "location": "512/TALK"  , "narrator": "千羽鶴", "text": "今までの世界は\nフェノメノンだったから\n私が法だった。"},
        { "location": "513/TALK"  , "narrator": "千羽鶴", "text": "蒸着した現在、\n表面上はなだらかに\n繋がったように見えるけど"},
        { "location": "514/TALK"  , "narrator": "千羽鶴", "text": "実際は、細かい所で\n幾つかごまかしている\nところがあって。"},
        { "location": "515/TALK"  , "narrator": "千羽鶴", "text": "それを解決しないと\n正常に蒸着が\n出来なかったの。"},
        { "location": "516/TALK"  , "narrator": "千羽鶴", "text": "その主だったところは、\n私が作ったオリジナルの\n要素の部分で。"},
        { "location": "517/TALK"  , "narrator": "千羽鶴", "text": "その中でも、情報管理庁\nまわりは、割と色々\n白黒つける必要があった。"},
        { "location": "518/TALK"  , "narrator": "千羽鶴", "text": "その中の１つに、\n私の戸籍問題があった。"},
        { "location": "519/TALK"  , "narrator": "千羽鶴", "text": "あとは、言わなくても\n分かってもらえると思う！"},
        { "location": "520/SEL"   , "narrator": "（選択肢）", "text": "全て把握した！"},
        { "location": "521/SEL"   , "narrator": "（選択肢）", "text": "でも、長官は…？"},
        { "location": "522/ACT"   , "narrator": "", "text": "全て把握した！"},
        { "location": "523/TALK"  , "narrator": "千羽鶴", "text": "よかった。"},
        { "location": "524/TALK"  , "narrator": "つばめ", "text": "わたしは\n急に双子の妹が出来て\n目が回ってるよ……。"},
        { "location": "525/SEL"   , "narrator": "（選択肢）", "text": "つばめはその改変、理解してるんだ"},
        { "location": "526/ACT"   , "narrator": "", "text": "つばめはその改変、理解してるんだ"},
        { "location": "528/TALK"  , "narrator": "千羽鶴", "text": "つばめは私自身だから、\n蒸着時の整合性についての\n記憶は全部残る。"},
        { "location": "529/TALK"  , "narrator": "千羽鶴", "text": "だから、唯一\n整合性の調整をしたことを\n知る人物になってる。"},
        { "location": "530/ACT"   , "narrator": "", "text": "でも、長官は…？"},
        { "location": "531/TALK"  , "narrator": "千羽鶴", "text": "もうやめたから。"},
        { "location": "532/TALK"  , "narrator": "千羽鶴", "text": "齢15歳で長官とか、\n今の現実の世界常識では\nどう考えても無理だった。"},
        { "location": "533/TALK"  , "narrator": "千羽鶴", "text": "こんなことなら、\n長官とかミミッチイこと\nいわず――"},
        { "location": "536/TALK"  , "narrator": "千羽鶴", "text": "世襲制の皇帝でも\n名乗っておけばよかった！"},
        { "location": "537/SEL"   , "narrator": "（選択肢）", "text": "お、おう…"},
        { "location": "538/ACT"   , "narrator": "", "text": "お、おう…"},
        { "location": "541/TALK"  , "narrator": "千羽鶴", "text": "というわけで、\n今の長官は四角ダルマ。"},
        { "location": "542/TALK"  , "narrator": "千羽鶴", "text": "元通常攻撃隊の\n幕僚長ね。"},
        { "location": "543/SEL"   , "narrator": "（選択肢）", "text": "色々変わったんだね"},
        { "location": "544/ACT"   , "narrator": "", "text": "色々変わったんだね"},
        { "location": "546/TALK"  , "narrator": "千羽鶴", "text": "ええ。\n見えないところで\n色々変わってる。"},
        { "location": "552/TALK"  , "narrator": "啓介", "text": "夕飯までまだ\nだいぶ時間があるで――"},
        { "location": "553/TALK"  , "narrator": "啓介", "text": "もしアレなら、\n花鳥園でも\n行って来たらどうだ。"},
        { "location": "555/TALK"  , "narrator": "千羽鶴", "text": "花鳥園ってなに？"},
        { "location": "557/TALK"  , "narrator": "つばめ", "text": "色んな鳥が\n放し飼いになってる\nところなんだよね。"},
        { "location": "558/TALK"  , "narrator": "つばめ", "text": "ペンギンとかもいて\n凄く可愛いんだ。"},
        { "location": "560/TALK"  , "narrator": "千羽鶴", "text": "行く！"},
        { "location": "561/TALK"  , "narrator": "つばめ", "text": "えっ？\n行くの？"},
        { "location": "582/TALK"  , "narrator": "千羽鶴", "text": "…すごい！"},
        { "location": "583/TALK"  , "narrator": "つばめ", "text": "いろんな種類の\n鳥がいるんだよ。"},
        { "location": "584/TALK"  , "narrator": "つばめ", "text": "前にガブちゃんと来たとき\nガブちゃんかなり\n喜んでたっけ。"},
        { "location": "587/TALK"  , "narrator": "千羽鶴", "text": "わかる！"},
        { "location": "589/TALK"  , "narrator": "千羽鶴", "text": "あっ、あそこにいる\n目が大きいのかわいい！"},
        { "location": "591/TALK"  , "narrator": "千羽鶴", "text": "近くに行って\n見てくる！"},
        { "location": "594/TALK"  , "narrator": "つばめ", "text": "あっ！\nちょっと！"},
        { "location": "595/TALK"  , "narrator": "つばめ", "text": "はぁ……。"},
        { "location": "596/SEL"   , "narrator": "（選択肢）", "text": "千羽鶴、楽しそうだね"},
        { "location": "597/ACT"   , "narrator": "", "text": "千羽鶴、楽しそうだね"},
        { "location": "600/TALK"  , "narrator": "つばめ", "text": "ほんとだね。"},
        { "location": "601/TALK"  , "narrator": "つばめ", "text": "長官さんやってたときは、\n殆ど管理庁から出たこと\n無かったんだって。"},
        { "location": "602/TALK"  , "narrator": "つばめ", "text": "だから、色んなものを\n見せてあげたいなって\n思ってるんだ。"},
        { "location": "603/SEL"   , "narrator": "（選択肢）", "text": "つばめは優しいね"},
        { "location": "604/SEL"   , "narrator": "（選択肢）", "text": "つばめは千羽鶴を恨んでないの？"},
        { "location": "605/ACT"   , "narrator": "", "text": "つばめは優しいね"},
        { "location": "606/TALK"  , "narrator": "つばめ", "text": "ううん、\nそういうのじゃないよ。"},
        { "location": "607/TALK"  , "narrator": "つばめ", "text": "千羽鶴さんは今まで\nずっと、何も楽しい事を\nせずに頑張って来たから。"},
        { "location": "608/TALK"  , "narrator": "つばめ", "text": "わたしが見て来た\n楽しい事を、いっぱい\n紹介したいの。"},
        { "location": "609/TALK"  , "narrator": "つばめ", "text": "……といっても、\nわたしも大して\n沢山は無いんだけど。"},
        { "location": "610/ACT"   , "narrator": "", "text": "つばめは千羽鶴を恨んでないの？"},
        { "location": "611/TALK"  , "narrator": "つばめ", "text": "うーん、\n恨んではいないかな。"},
        { "location": "612/TALK"  , "narrator": "つばめ", "text": "もちろん、地下室に\n閉じこめられたり、\n痛いことされたけど。"},
        { "location": "613/TALK"  , "narrator": "つばめ", "text": "でも、千羽鶴さんも\n自分の使命に一生懸命\nだっただけだから。"},
        { "location": "614/TALK"  , "narrator": "つばめ", "text": "今、そういうこと\nされるなら嫌だけど、\nもうそんな事ないし。"},
        { "location": "615/TALK"  , "narrator": "つばめ", "text": "だから、今は二人で\n楽しめるようになるのが\n一番だと思ってるよ。"},
        { "location": "617/TALK"  , "narrator": "千羽鶴", "text": "あああっ！\nちょっと！\nなにをっ……"},
        { "location": "619/TALK"  , "narrator": "つばめ", "text": "千羽鶴さんっ！？"},
        { "location": "620/TALK"  , "narrator": "千羽鶴", "text": "逢瀬つばめ！\n来て！\nお願いはやく！"},
        { "location": "621/TALK"  , "narrator": "つばめ", "text": "今行きますっ！"},
        { "location": "663/TALK"  , "narrator": "百鶴　", "text": "すごいことに\nなりましたね！\nカレンさん。"},
        { "location": "664/TALK"  , "narrator": "カレン", "text": "わたしの想像をも\n超えてましたっ！"},
        { "location": "665/TALK"  , "narrator": "百鶴　", "text": "ていうか、あなた。"},
        { "location": "666/TALK"  , "narrator": "カレン", "text": "はい？"},
        { "location": "667/TALK"  , "narrator": "百鶴　", "text": "何ですか\nその格好は。"},
        { "location": "668/TALK"  , "narrator": "カレン", "text": "あ、いや、これはですね！"},
        { "location": "669/TALK"  , "narrator": "カレン", "text": "百鶴さんと同じ服だと、\nどっちがどっちか\n解らなくなりますよね！"},
        { "location": "670/TALK"  , "narrator": "カレン", "text": "だから、\n違う服にしようかと！"},
        { "location": "671/TALK"  , "narrator": "百鶴　", "text": "えっと。"},
        { "location": "672/TALK"  , "narrator": "百鶴　", "text": "その１。\n目元を見れば\n解りますよね？"},
        { "location": "673/TALK"  , "narrator": "百鶴　", "text": "その２。\nで、なんで\nメノウの衣装なんですか？"},
        { "location": "674/TALK"  , "narrator": "カレン", "text": "えっと……\nそれは……っ…"},
        { "location": "676/TALK"  , "narrator": "カレン", "text": "一度\n着てみたかったんですっ！"},
        { "location": "677/TALK"  , "narrator": "百鶴　", "text": "最初から\nそう言えばいいんですよ。"},
        { "location": "678/SEL"   , "narrator": "（選択肢）", "text": "二人とも元気そうでよかった"},
        { "location": "679/ACT"   , "narrator": "", "text": "二人とも元気そうでよかった"},
        { "location": "682/TALK"  , "narrator": "百鶴　", "text": "誰かと思えば\n$handle$さん\nでしたか。"},
        { "location": "684/TALK"  , "narrator": "カレン", "text": "$handle$さんっ！"},
        { "location": "685/TALK"  , "narrator": "百鶴　", "text": "聞いて下さい。\n我が主が大変なことに！"},
        { "location": "686/TALK"  , "narrator": "百鶴　", "text": "このままだと\n恐ろしいことが…っ！"},
        { "location": "687/SEL"   , "narrator": "（選択肢）", "text": "なに！？"},
        { "location": "688/ACT"   , "narrator": "", "text": "なに！？"},
        { "location": "692/TALK"  , "narrator": "百鶴　", "text": "きっとわたしも\n逢瀬百鶴として\n三女にされてしまいます！"},
        { "location": "694/TALK"  , "narrator": "カレン", "text": "…無いと思います。"},
        { "location": "695/SEL"   , "narrator": "（選択肢）", "text": "それ凄くいい！！"},
        { "location": "696/SEL"   , "narrator": "（選択肢）", "text": "実は密かにそうなる展開を期待してない？"},
        { "location": "697/ACT"   , "narrator": "", "text": "それ凄くいい！！"},
        { "location": "698/TALK"  , "narrator": "百鶴　", "text": "えっ、マジ？"},
        { "location": "699/TALK"  , "narrator": "百鶴　", "text": "$handle$さんに\nそう言われたら、もう\n名乗るしかありません！"},
        { "location": "700/TALK"  , "narrator": "百鶴　", "text": "これからは、\n逢瀬百鶴15歳三女で\nおねがいします。"},
        { "location": "701/ACT"   , "narrator": "", "text": "実は密かにそうなる展開を期待してない？"},
        { "location": "702/TALK"  , "narrator": "百鶴　", "text": "えっ……？"},
        { "location": "703/TALK"  , "narrator": "カレン", "text": "……。"},
        { "location": "704/TALK"  , "narrator": "百鶴　", "text": "ま"},
        { "location": "707/TALK"  , "narrator": "百鶴　", "text": "まさか！"},
        { "location": "710/TALK"  , "narrator": "百鶴　", "text": "そんなわけ\nありませんし！"},
        { "location": "713/TALK"  , "narrator": "百鶴　", "text": "まったく、そんな事\n言い出すから貴方はずっと\n■■野郎なんですよ！"},
        { "location": "714/TALK"  , "narrator": "百鶴　", "text": "…はぁ。"},
        { "location": "715/SEL"   , "narrator": "（選択肢）", "text": "…ホントか？"},
        { "location": "716/ACT"   , "narrator": "", "text": "…ホントか？"},
        { "location": "720/TALK"  , "narrator": "カレン", "text": "ところで\n$handle$さん。"},
        { "location": "721/TALK"  , "narrator": "百鶴　", "text": "どうやら貴方とは\nお別れの時が\n近づいているようですね。"},
        { "location": "722/SEL"   , "narrator": "（選択肢）", "text": "そうなんだよね…"},
        { "location": "723/ACT"   , "narrator": "", "text": "そうなんだよね…"},
        { "location": "726/TALK"  , "narrator": "カレン", "text": "正直言って、\nメチャクチャ寂しいです！"},
        { "location": "727/TALK"  , "narrator": "カレン", "text": "$handle$さんは\n命の恩人ですし。"},
        { "location": "728/TALK"  , "narrator": "カレン", "text": "わたしが百鶴さんに\n殺されそうになった時にも\n助けてくれましたし。"},
        { "location": "730/TALK"  , "narrator": "百鶴　", "text": "いやそれ\n本人の前で言いますか？\n真実ですけど。"},
        { "location": "731/TALK"  , "narrator": "カレン", "text": "$handle$さんと\n一緒にスイーツを\n食べるのが夢でした。"},
        { "location": "732/TALK"  , "narrator": "百鶴　", "text": "毎日わたしと\n食べてるじゃないですか。"},
        { "location": "733/TALK"  , "narrator": "カレン", "text": "けど、それももう\n叶わない夢に\nなっちゃうんですね…。"},
        { "location": "734/TALK"  , "narrator": "百鶴　", "text": "まあそう悲観的に――"},
        { "location": "739/TALK"  , "narrator": "カレン", "text": "$handle$さん\n大好きですっ！！"},
        { "location": "740/TALK"  , "narrator": "百鶴　", "text": "あああっ！！\n油断したっ！！"},
        { "location": "745/TALK"  , "narrator": "百鶴　", "text": "ダーリンすきすきすき！"},
        { "location": "748/TALK"  , "narrator": "カレン", "text": "$handle$さん\n愛してますッ！！"},
        { "location": "751/TALK"  , "narrator": "百鶴　", "text": "ダーリン愛してる～～！！"},
        { "location": "753/TALK"  , "narrator": "カレン", "text": "わたしが先に\n好きになりましたっ！！"},
        { "location": "755/TALK"  , "narrator": "百鶴　", "text": "わたしの愛の方が\n激重ですから！"},
        { "location": "756/SEL"   , "narrator": "（選択肢）", "text": "カレン愛してるよ"},
        { "location": "757/SEL"   , "narrator": "（選択肢）", "text": "百鶴愛してるよ"},
        { "location": "758/SEL"   , "narrator": "（選択肢）", "text": "二人とも大好き"},
        { "location": "759/ACT"   , "narrator": "", "text": "カレン愛してるよ"},
        { "location": "762/TALK"  , "narrator": "カレン", "text": "ふああっ！！"},
        { "location": "764/TALK"  , "narrator": "カレン", "text": "とっても嬉しいですっ！"},
        { "location": "766/TALK"  , "narrator": "百鶴　", "text": "ちっ……\n年の功って奴ですね。"},
        { "location": "767/ACT"   , "narrator": "", "text": "百鶴愛してるよ"},
        { "location": "770/TALK"  , "narrator": "百鶴　", "text": "マジっすか！"},
        { "location": "772/TALK"  , "narrator": "百鶴　", "text": "あぁん、\nダーリンあいしてゆ。"},
        { "location": "774/TALK"  , "narrator": "カレン", "text": "しょぼん……。"},
        { "location": "775/ACT"   , "narrator": "", "text": "二人とも大好き"},
        { "location": "779/TALK"  , "narrator": "カレン", "text": "ああっ！"},
        { "location": "782/TALK"  , "narrator": "百鶴　", "text": "逃げましたね。"},
        { "location": "783/TALK"  , "narrator": "カレン", "text": "まあでも、\n$handle$さん\nらしいですよね。"},
        { "location": "784/TALK"  , "narrator": "百鶴　", "text": "まったく！\nそういうところですよ！"},
        { "location": "787/TALK"  , "narrator": "カレン", "text": "$handle$さん。\nあと僅かだと思いますが\nつばめをお願いします。"},
        { "location": "789/TALK"  , "narrator": "百鶴　", "text": "元わが主、\n次女の千羽鶴も\nよろしく頼みますよ。"},
        { "location": "790/SEL"   , "narrator": "（選択肢）", "text": "もちろんだよ"},
        { "location": "791/ACT"   , "narrator": "", "text": "もちろんだよ"},
        { "location": "793/TALK"  , "narrator": "百鶴　", "text": "おっ！\nそんな話を\nしているうちに！"},
        { "location": "794/TALK"  , "narrator": "カレン", "text": "姉妹愛が\n芽生え始めてますね！"},
        { "location": "795/SEL"   , "narrator": "（選択肢）", "text": "どういうこと？"},
        { "location": "796/ACT"   , "narrator": "", "text": "どういうこと？"},
        { "location": "798/TALK"  , "narrator": "百鶴　", "text": "要するに、とっとと\n現実に戻って二人を\n見守りやがれって事ですよ"},
        { "location": "799/TALK"  , "narrator": "カレン", "text": "$handle$さん、\n本当にいろいろ\nありがとうございました。"},
        { "location": "800/TALK"  , "narrator": "カレン", "text": "いつか、また会える日が\n来たときには――"},
        { "location": "801/TALK"  , "narrator": "カレン", "text": "一緒に\nスイーツ食べ放題に\n行きましょうね！"},
        { "location": "802/TALK"  , "narrator": "百鶴　", "text": "その前にダーリンを\nコタツの部屋に\n監禁します。"},
        { "location": "803/SEL"   , "narrator": "（選択肢）", "text": "どっちも楽しみにしてるよ"},
        { "location": "804/ACT"   , "narrator": "", "text": "どっちも楽しみにしてるよ"},
        { "location": "806/TALK"  , "narrator": "カレン", "text": "はいっ！"},
        { "location": "807/TALK"  , "narrator": "百鶴　", "text": "いつもながら\n模範解答野郎ですね。"},
        { "location": "808/TALK"  , "narrator": "カレン", "text": "それでは、\n$handle$さんと\nつばめファミリーに"},
        { "location": "809/TALK"  , "narrator": "百鶴　", "text": "素敵なココロの旅を。"},
        { "location": "836/TALK"  , "narrator": "千羽鶴", "text": "……すごい。\n綺麗な星空。"},
        { "location": "837/TALK"  , "narrator": "つばめ", "text": "東京だと、\nこんなに沢山は\n見えないもんね。"},
        { "location": "838/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "840/TALK"  , "narrator": "つばめ", "text": "明日は、\nお母さんのところに\nお見舞いに行くって。"},
        { "location": "841/TALK"  , "narrator": "千羽鶴", "text": "……そう。"},
        { "location": "842/TALK"  , "narrator": "つばめ", "text": "どうしたの？"},
        { "location": "843/TALK"  , "narrator": "千羽鶴", "text": "……なんか、\n緊張する。"},
        { "location": "845/TALK"  , "narrator": "つばめ", "text": "大丈夫だよ。\nお母さんは、\nとっても優しいから。"},
        { "location": "848/TALK"  , "narrator": "千羽鶴", "text": "……うん。"},
        { "location": "849/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "851/TALK"  , "narrator": "千羽鶴", "text": "今日はいろいろありがと。"},
        { "location": "853/TALK"  , "narrator": "つばめ", "text": "えっ？"},
        { "location": "855/TALK"  , "narrator": "千羽鶴", "text": "花鳥園は楽しかったし、\nゲンコツハンバーグも\n美味しかった。"},
        { "location": "856/TALK"  , "narrator": "つばめ", "text": "良かった。"},
        { "location": "857/TALK"  , "narrator": "千羽鶴", "text": "でも、エミューに\n追いかけられたときは、\n正直言って死を覚悟した！"},
        { "location": "858/TALK"  , "narrator": "つばめ", "text": "大げさだよぉ……。"},
        { "location": "859/TALK"  , "narrator": "千羽鶴", "text": "確かに少し\n大げさだったかも。"},
        { "location": "860/TALK"  , "narrator": "千羽鶴", "text": "けど、\nほんとに怖かった。"},
        { "location": "861/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "864/TALK"  , "narrator": "千羽鶴", "text": "お姉ちゃんが\n助けに来てくれたから\n嬉しかった。"},
        { "location": "866/TALK"  , "narrator": "つばめ", "text": "えっ？\nいま、なんて……"},
        { "location": "869/TALK"  , "narrator": "千羽鶴", "text": "二度は言わない。"},
        { "location": "871/TALK"  , "narrator": "つばめ", "text": "あはは……。"},
        { "location": "872/TALK"  , "narrator": "千羽鶴", "text": "それと……。\nお姉ちゃんも私のことは\n千羽鶴さん禁止。"},
        { "location": "873/TALK"  , "narrator": "つばめ", "text": "えっと、\nじゃあなんて呼べば\nいいのかな…？"},
        { "location": "874/TALK"  , "narrator": "千羽鶴", "text": "千羽鶴でいい。\n妹なんだから。"},
        { "location": "875/TALK"  , "narrator": "つばめ", "text": "え、ええっ！？\nわたし、呼び捨てって\nあまり慣れてなくて……"},
        { "location": "876/TALK"  , "narrator": "千羽鶴", "text": "じゃあ……"},
        { "location": "877/TALK"  , "narrator": "千羽鶴", "text": "ちーでいい。"},
        { "location": "878/TALK"  , "narrator": "つばめ", "text": "あ、そっか！\nそれじゃ、これからは\nちーちゃんって呼ぶね。"},
        { "location": "881/TALK"  , "narrator": "千羽鶴", "text": "……うん。"},
        { "location": "883/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "885/TALK"  , "narrator": "千羽鶴", "text": "今まで、\n本当にごめんなさい。"},
        { "location": "886/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "887/TALK"  , "narrator": "千羽鶴", "text": "貴方には沢山\n酷いことをした。\n壊そうとした。"},
        { "location": "888/TALK"  , "narrator": "つばめ", "text": "…うん。"},
        { "location": "890/TALK"  , "narrator": "千羽鶴", "text": "でも、それでも\n貴方は受け入れてくれた。"},
        { "location": "891/TALK"  , "narrator": "つばめ", "text": "もちろんだよ。\nだって、ちーちゃんは\nわたしだもん。"},
        { "location": "892/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "893/TALK"  , "narrator": "つばめ", "text": "わたしだって、わたし\n自身に嫌なことやダメな\nこと、いっぱいしてるし。"},
        { "location": "894/TALK"  , "narrator": "つばめ", "text": "でもそれは、\n必要だから\n仕方なかったり。"},
        { "location": "895/TALK"  , "narrator": "つばめ", "text": "自分が怠け癖が\nあるから仕方なかったり。"},
        { "location": "896/TALK"  , "narrator": "つばめ", "text": "そういうものだと\n思うんだ。"},
        { "location": "897/TALK"  , "narrator": "つばめ", "text": "それを受け入れられ\nなかったら、絶対に\n自分を好きになれないし。"},
        { "location": "898/TALK"  , "narrator": "つばめ", "text": "受け入れてるから、\n今の自分が好きで\nいられるんだと思う。"},
        { "location": "900/TALK"  , "narrator": "つばめ", "text": "ちーちゃんも、\nその中の一人なんだよ。"},
        { "location": "902/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "904/TALK"  , "narrator": "千羽鶴", "text": "ありがと、\nお姉ちゃん。"},
        { "location": "906/TALK"  , "narrator": "つばめ", "text": "でもね、\nホントのこと言うと。"},
        { "location": "907/TALK"  , "narrator": "つばめ", "text": "わたし、姉妹が\n欲しかったんだ。"},
        { "location": "908/TALK"  , "narrator": "つばめ", "text": "だから、\n夢が叶っちゃった。\nえへへ……。"},
        { "location": "910/TALK"  , "narrator": "千羽鶴", "text": "それなら\n私だって！！"},
        { "location": "912/TALK"  , "narrator": "つばめ", "text": "えっ？"},
        { "location": "913/TALK"  , "narrator": "千羽鶴", "text": "…夢が叶った。"},
        { "location": "915/TALK"  , "narrator": "千羽鶴", "text": "普通の女子高生として\n普通の生活をする夢。"},
        { "location": "916/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "917/TALK"  , "narrator": "千羽鶴", "text": "普通に学校に通って、\n普通に勉強して。"},
        { "location": "918/TALK"  , "narrator": "千羽鶴", "text": "普通にクラブ活動して、\n放課後にカフェで\n美味しいケーキ食べて。"},
        { "location": "919/TALK"  , "narrator": "千羽鶴", "text": "沢山友達作って、\nそして恋をする。"},
        { "location": "920/TALK"  , "narrator": "つばめ", "text": "ちーちゃん……。"},
        { "location": "921/TALK"  , "narrator": "つばめ", "text": "できるよ、\nこれから一杯。"},
        { "location": "923/TALK"  , "narrator": "千羽鶴", "text": "楽しみ。"},
        { "location": "924/TALK"  , "narrator": "千羽鶴", "text": "でも、そうすると――"},
        { "location": "925/TALK"  , "narrator": "千羽鶴", "text": "お姉ちゃんは、\n恋のライバルに\nなるかもしれない。"},
        { "location": "926/TALK"  , "narrator": "つばめ", "text": "えっ？"},
        { "location": "927/TALK"  , "narrator": "つばめ", "text": "え―――――――っ！！"},
        { "location": "929/TALK"  , "narrator": "千羽鶴", "text": "なんて冗談。\nどーん！"},
        { "location": "930/TALK"  , "narrator": "つばめ", "text": "ひどいーっ！"},
        { "location": "931/TALK"  , "narrator": "千羽鶴", "text": "実は本気。"},
        { "location": "932/TALK"  , "narrator": "つばめ", "text": "もっと酷いーっ！"},
        { "location": "938/DIALOG", "narrator": "", "text": "これから一杯、一杯、\nいろんな楽しい事を\n二人でしていこうね。\n\n二人は一人だったんだから。\n楽しい事も、\n嬉しいことも、\nこれからは一緒だよ。\n\nね、ちーちゃん。"},
        { "location": "940/DIALOG", "narrator": "", "text": "ありがとう、\n$handle$さん。\n\nわたしは今、\n最高に幸せです――。"}
    ]
}
