        "title": "スペシャルエピソード",
        "sub_title": "ガブリエラの日常"
    },
    "entry":
    [
        { "location": "21/TALK" , "narrator": "透明ガブリエラ", "text": "ん～、これいいなぁ。"},
        { "location": "22/TALK" , "narrator": "透明ガブリエラ", "text": "でも、ちょっと\nお値段張るのが\n気になるかも…。"},
        { "location": "23/TALK" , "narrator": "透明ガブリエラ", "text": "端数の３００円が\nなければなぁ…。"},
        { "location": "25/TALK" , "narrator": "透明アーヤ", "text": "…真剣に見てるわね。"},
        { "location": "29/TALK" , "narrator": "透明ガブリエラ", "text": "え…あ、アーヤ！？\nどうしてここに\nいるの！？"},
        { "location": "30/TALK" , "narrator": "透明アーヤ", "text": "ツーリングがてら、\nちょっと浅草見物でも\nしようと思ってね。"},
        { "location": "31/TALK" , "narrator": "透明アーヤ", "text": "まさか、ギャヴィに\n会えるとは思わな\nかったけど。"},
        { "location": "33/TALK" , "narrator": "透明ガブリエラ", "text": "そ、そうね…。\n浅草も広いし。"},
        { "location": "34/TALK" , "narrator": "透明アーヤ", "text": "うん…ところで――"},
        { "location": "35/TALK" , "narrator": "透明アーヤ", "text": "その手に持ってる\n変なこけし、何？"},
        { "location": "37/TALK" , "narrator": "透明ガブリエラ", "text": "どこが変なのよ？\nとっても可愛い\nでしょ？"},
        { "location": "38/TALK" , "narrator": "透明アーヤ", "text": "でも、顔つきがその、\nちょっとスケベっぽい\nような…。"},
        { "location": "39/TALK" , "narrator": "透明アーヤ", "text": "あ、ほらそっちの。\n女の子の顔してるのが\n可愛いと思うけど？"},
        { "location": "41/TALK" , "narrator": "透明ガブリエラ", "text": "ここにあるこけし、\n全部女の子よ？"},
        { "location": "42/TALK" , "narrator": "透明アーヤ", "text": "そっちのよ、ほら。\nおかっぱ頭で\n口紅が付いてる――"},
        { "location": "43/TALK" , "narrator": "透明ガブリエラ", "text": "沢山あり過ぎて\nわからないから。"},
        { "location": "47/TALK" , "narrator": "透明ガブリエラ", "text": "っていうか、\nあたしの趣味の\n時間を邪魔しないで！"},
        { "location": "48/TALK" , "narrator": "透明アーヤ", "text": "はいはい…。\nあ、私も向こうの\nお店見てくるわ。"},
        { "location": "51/TALK" , "narrator": "透明ガブリエラ", "text": "まったく…。"},
        { "location": "53/TALK" , "narrator": "ガブリエラ", "text": "アーヤはダメよね"},
        { "location": "54/TALK" , "narrator": "ガブリエラ", "text": "こけしの可愛さがわからないんだもの"},
        { "location": "55/TALK" , "narrator": "ガブリエラ", "text": "スケベっぽいだなんて失礼だわ"},
        { "location": "56/TALK" , "narrator": "ガブリエラ", "text": "マルザンナはどう思う？"},
        { "location": "57/SEL"  , "narrator": "（選択肢）", "text": "そういう顔のも実際あるよ"},
        { "location": "58/SEL"  , "narrator": "（選択肢）", "text": "それが可愛いんだよね"},
        { "location": "59/SEL"  , "narrator": "（選択肢）", "text": "ガブリエラの顔の方が可愛い"},
        { "location": "60/ACT"  , "narrator": "", "text": "そういう顔のも実際あるよ"},
        { "location": "61/TALK" , "narrator": "ガブリエラ", "text": "でもこれは違うわよ"},
        { "location": "64/TALK" , "narrator": "ガブリエラ", "text": "見方によってはそう見えるかもしれないけれど"},
        { "location": "65/TALK" , "narrator": "ガブリエラ", "text": "これはそういうのとは違うのよ"},
        { "location": "66/TALK" , "narrator": "ガブリエラ", "text": "沢山こけしを見てきた私が言うんだから"},
        { "location": "67/TALK" , "narrator": "ガブリエラ", "text": "間違いないわ"},
        { "location": "68/ACT"  , "narrator": "", "text": "それが可愛いんだよね"},
        { "location": "69/TALK" , "narrator": "ガブリエラ", "text": "そう言ってくれると信じていたわ"},
        { "location": "70/TALK" , "narrator": "ガブリエラ", "text": "色んな表情の子がいるのが魅力的なのよね"},
        { "location": "71/TALK" , "narrator": "ガブリエラ", "text": "それがわかるなんて"},
        { "location": "73/TALK" , "narrator": "ガブリエラ", "text": "さすがは私の使用人ね"},
        { "location": "76/SEL"  , "narrator": "（選択肢）", "text": "お褒めに預かり光栄です"},
        { "location": "77/ACT"  , "narrator": "", "text": "お褒めに預かり光栄です"},
        { "location": "79/TALK" , "narrator": "ガブリエラ", "text": "うんうん、いいこいいこ"},
        { "location": "80/ACT"  , "narrator": "", "text": "ガブリエラの顔の方が可愛い"},
        { "location": "83/TALK" , "narrator": "ガブリエラ", "text": "こけしの顔と比べられるのは"},
        { "location": "85/TALK" , "narrator": "ガブリエラ", "text": "さすがに反応に困るわね"},
        { "location": "86/TALK" , "narrator": "ガブリエラ", "text": "マルザンナは褒めるのが下手なのかしら？"},
        { "location": "87/TALK" , "narrator": "ガブリエラ", "text": "でも許してあげるわよ"},
        { "location": "88/TALK" , "narrator": "ガブリエラ", "text": "気持ちだけは伝わったし"},
        { "location": "92/TALK" , "narrator": "ガブリエラ", "text": "でも何だかモヤモヤするわね"},
        { "location": "93/TALK" , "narrator": "ガブリエラ", "text": "アーヤがあんな変なこと言うから"},
        { "location": "94/TALK" , "narrator": "ガブリエラ", "text": "そんな風に見えてきちゃった感じするわね"},
        { "location": "95/TALK" , "narrator": "ガブリエラ", "text": "うーん・・・"},
        { "location": "97/TALK" , "narrator": "ガブリエラ", "text": "やっぱり買うのやめようかしら？"},
        { "location": "98/SEL"  , "narrator": "（選択肢）", "text": "気になってたなら買うべき"},
        { "location": "99/SEL"  , "narrator": "（選択肢）", "text": "色んな顔の子がいた方が楽しい"},
        { "location": "100/SEL" , "narrator": "（選択肢）", "text": "やめた方が良い気がするなぁ"},
        { "location": "101/ACT" , "narrator": "", "text": "気になったなら買うべき"},
        { "location": "102/TALK", "narrator": "ガブリエラ", "text": "そうよね"},
        { "location": "104/TALK", "narrator": "ガブリエラ", "text": "決めたわマルザンナ"},
        { "location": "105/TALK", "narrator": "ガブリエラ", "text": "やっぱりこの子買ってくるわね"},
        { "location": "106/SEL" , "narrator": "（選択肢）", "text": "それがいいと思うよ"},
        { "location": "107/ACT" , "narrator": "", "text": "それがいいと思うよ"},
        { "location": "109/TALK", "narrator": "ガブリエラ", "text": "そう思うわよね？"},
        { "location": "111/TALK", "narrator": "ガブリエラ", "text": "それにもしそんな理由で買わなかったら"},
        { "location": "112/TALK", "narrator": "ガブリエラ", "text": "この子が可哀そうだものね"},
        { "location": "113/TALK", "narrator": "ガブリエラ", "text": "背中を押してくれてありがと"},
        { "location": "114/TALK", "narrator": "ガブリエラ", "text": "それじゃあ買ってくるわね"},
        { "location": "115/ACT" , "narrator": "", "text": "色んな顔の子がいた方が楽しい"},
        { "location": "118/TALK", "narrator": "ガブリエラ", "text": "そうなのよ！"},
        { "location": "119/TALK", "narrator": "ガブリエラ", "text": "素晴らしいわマルザンナ！"},
        { "location": "120/TALK", "narrator": "ガブリエラ", "text": "こけしは色んな子がいるから、表情はその子の個性だと思うのよ"},
        { "location": "121/SEL" , "narrator": "（選択肢）", "text": "同感だね"},
        { "location": "122/ACT" , "narrator": "", "text": "同感だね"},
        { "location": "124/TALK", "narrator": "ガブリエラ", "text": "気が合って嬉しいわ"},
        { "location": "126/TALK", "narrator": "ガブリエラ", "text": "それと"},
        { "location": "127/TALK", "narrator": "ガブリエラ", "text": "こけしのことを『子』って言ってくれたのも"},
        { "location": "129/TALK", "narrator": "ガブリエラ", "text": "私ね"},
        { "location": "130/TALK", "narrator": "ガブリエラ", "text": "こけしってお人形と同じ感覚で見てるから"},
        { "location": "131/TALK", "narrator": "ガブリエラ", "text": "この子、とか、あの子、って言っちゃうのよ"},
        { "location": "132/TALK", "narrator": "ガブリエラ", "text": "だから、マルザンナにもそう言ってもらえたのが"},
        { "location": "133/TALK", "narrator": "ガブリエラ", "text": "ちょっと嬉しかったわ"},
        { "location": "136/TALK", "narrator": "ガブリエラ", "text": "じゃあ買ってくるわ"},
        { "location": "137/TALK", "narrator": "ガブリエラ", "text": "また後でお話しましょうね"},
        { "location": "138/ACT" , "narrator": "", "text": "やめた方が良い気がするなぁ"},
        { "location": "141/TALK", "narrator": "ガブリエラ", "text": "まだまだね、マルザンナ"},
        { "location": "143/TALK", "narrator": "ガブリエラ", "text": "ここはちょっと凹んでる私のことを"},
        { "location": "144/TALK", "narrator": "ガブリエラ", "text": "上手くフォローするところよ？"},
        { "location": "145/TALK", "narrator": "ガブリエラ", "text": "私も期待していたのに・・・"},
        { "location": "147/TALK", "narrator": "ガブリエラ", "text": "そんなことじゃ私の使用人失格よ？"},
        { "location": "148/SEL" , "narrator": "（選択肢）", "text": "修行が足りなかった"},
        { "location": "149/ACT" , "narrator": "", "text": "修行が足りなかった"},
        { "location": "151/TALK", "narrator": "ガブリエラ", "text": "素直でよろしい"},
        { "location": "153/TALK", "narrator": "ガブリエラ", "text": "精進して素晴らしい使用人に成長してくれることを"},
        { "location": "154/TALK", "narrator": "ガブリエラ", "text": "私も楽しみにしているわね"}
    ]
}
