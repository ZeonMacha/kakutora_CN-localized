        "title": "スペシャルエピソード",
        "sub_title": "卯月神楽と呪いのチョコ"
    },
    "entry":
    [
        { "location": "214/TALK", "narrator": "透明神楽", "text": "これでよし、と……"},
        { "location": "215/TALK", "narrator": "透明神楽", "text": "できました～～っ♪"},
        { "location": "217/TALK", "narrator": "透明神楽", "text": "ふふふっ。\n我ながら良い出来ですっ♪"},
        { "location": "218/SEL" , "narrator": "（選択肢）", "text": "そ、それって…"},
        { "location": "219/ACT" , "narrator": "", "text": "そ、それって…"},
        { "location": "225/TALK", "narrator": "神楽", "text": "力作だとおもいませんか！！！！"},
        { "location": "226/SEL" , "narrator": "（選択肢）", "text": "神楽って器用なんだね"},
        { "location": "227/SEL" , "narrator": "（選択肢）", "text": "ちょっとセンス悪くない？"},
        { "location": "228/ACT" , "narrator": "", "text": "神楽って器用なんだね"},
        { "location": "229/TALK", "narrator": "神楽", "text": "わーいわーい♪"},
        { "location": "230/TALK", "narrator": "神楽", "text": "$handlek$に褒められた♪"},
        { "location": "231/TALK", "narrator": "神楽", "text": "そんな$handlek$が"},
        { "location": "234/TALK", "narrator": "神楽", "text": "試練が待ち受けているのだった…ぴょん♪"},
        { "location": "237/SEL" , "narrator": "（選択肢）", "text": "なんですかそれは"},
        { "location": "238/ACT" , "narrator": "", "text": "なんですかそれは"},
        { "location": "240/TALK", "narrator": "神楽", "text": "$handlek$はぴょんこのことｽｷ？"},
        { "location": "241/SEL" , "narrator": "（選択肢）", "text": "ｽｷです"},
        { "location": "242/SEL" , "narrator": "（選択肢）", "text": "いや、別に"},
        { "location": "243/ACT" , "narrator": "", "text": "ｽｷです"},
        { "location": "244/TALK", "narrator": "神楽", "text": "ほんとに～～～？"},
        { "location": "246/TALK", "narrator": "神楽", "text": "どれくらいｽｷ？"},
        { "location": "247/SEL" , "narrator": "（選択肢）", "text": "死ぬほど愛してるよ！！"},
        { "location": "248/SEL" , "narrator": "（選択肢）", "text": "普通に友人として"},
        { "location": "249/ACT" , "narrator": "", "text": "死ぬほど愛してるよ！！"},
        { "location": "252/TALK", "narrator": "神楽", "text": "嬉しい♪"},
        { "location": "254/TALK", "narrator": "神楽", "text": "じゃあこれ食べても平気ですよねっ♪"},
        { "location": "255/TALK", "narrator": "神楽", "text": "死・ぬ・ほ・ど"},
        { "location": "256/TALK", "narrator": "神楽", "text": "愛してるんですから♪"},
        { "location": "257/ACT" , "narrator": "", "text": "普通に友人として"},
        { "location": "258/TALK", "narrator": "神楽", "text": "あー、これアカンわー"},
        { "location": "260/TALK", "narrator": "神楽", "text": "絶対今から死亡するパターンだわー"},
        { "location": "261/TALK", "narrator": "神楽", "text": "ご愁傷様ぴょん"},
        { "location": "263/ACT" , "narrator": "", "text": "いや、別に"},
        { "location": "264/TALK", "narrator": "神楽", "text": "ぴょん"},
        { "location": "265/TALK", "narrator": "神楽", "text": "それじゃ、ぴょんこのチョコはいらないよね"},
        { "location": "266/TALK", "narrator": "神楽", "text": "ばーい"},
        { "location": "269/ACT" , "narrator": "", "text": "ちょっとセンス悪くない？"},
        { "location": "270/TALK", "narrator": "神楽", "text": "は！？"},
        { "location": "272/TALK", "narrator": "神楽", "text": "始めは些細な事だった。$handle$も軽い気持ちで茶化そうとしただけだったのかもしれない。けれどもそれは2人の関係に小さな亀裂を生むことになった。"},
        { "location": "273/TALK", "narrator": "神楽", "text": "掛け違えたボタンのように、それは決して元に戻ることは無かった。小さな亀裂は気づけば大きな裂け目となり、お互いは口を開けば傷つけ合う関係に。"},
        { "location": "274/TALK", "narrator": "神楽", "text": "ああっ、あれから何度目の満月が訪れたのだろう。あんなに愛し合っていた2人は、今や扉を開ける音にすら精神を蝕まれ、お互いの存在に怯えて暮らすようになったのだ！"},
        { "location": "275/SEL" , "narrator": "（選択肢）", "text": "即興で物語作れるのすごいよね！"},
        { "location": "276/SEL" , "narrator": "（選択肢）", "text": "そんなに怯えてるなら別居すればいいのに"},
        { "location": "277/SEL" , "narrator": "（選択肢）", "text": "話戻すけど軽い気持ちでは言ってないんで"},
        { "location": "278/ACT" , "narrator": "", "text": "即興で物語作れるのすごいよね！"},
        { "location": "279/TALK", "narrator": "神楽", "text": "わーいわーい♪"},
        { "location": "281/TALK", "narrator": "神楽", "text": "$handlek$に褒められた♪"},
        { "location": "282/TALK", "narrator": "神楽", "text": "だがしかし！！！"},
        { "location": "283/TALK", "narrator": "神楽", "text": "それは本心か、はたまたお世辞なのか！それはこれから赤裸々になるのだぴょん！"},
        { "location": "284/TALK", "narrator": "神楽", "text": "試される$handlek$！！"},
        { "location": "285/ACT" , "narrator": "", "text": "そんなに怯えてるなら別居すればいいのに"},
        { "location": "286/TALK", "narrator": "神楽", "text": "ここに乙女心がわからないクズがいます"},
        { "location": "287/TALK", "narrator": "神楽", "text": "まあいいですぴょん。創作は人それぞれ千差万別。好みの差はどうしたってあるぴょん。"},
        { "location": "288/TALK", "narrator": "神楽", "text": "それがおいおい2人を分かつことになろうとも、思想と言論の自由は何人たりとも妨げてはならないのだぴょん"},
        { "location": "289/SEL" , "narrator": "（選択肢）", "text": "神楽と離れたくないよぅ"},
        { "location": "290/SEL" , "narrator": "（選択肢）", "text": "まあその時は仕方ないよね"},
        { "location": "291/ACT" , "narrator": "", "text": "神楽と離れたくないよぅ"},
        { "location": "292/TALK", "narrator": "神楽", "text": "離れたくなくても運命の歯車は無情なのだぴょん。"},
        { "location": "293/TALK", "narrator": "神楽", "text": "そしてその審判は今から下るのだぴょん！！"},
        { "location": "294/ACT" , "narrator": "", "text": "まあその時は仕方ないよね"},
        { "location": "296/TALK", "narrator": "神楽", "text": "今ちょっとキュンとした"},
        { "location": "297/TALK", "narrator": "神楽", "text": "カッコイイ♪"},
        { "location": "298/TALK", "narrator": "神楽", "text": "でもそれが本心かどうかは、今から赤裸々にわかってしまうのだぴょん"},
        { "location": "300/ACT" , "narrator": "", "text": "話戻すけど軽い気持ちでは言ってないんで"},
        { "location": "301/TALK", "narrator": "神楽", "text": "止まれ！KY警察だ！"},
        { "location": "303/TALK", "narrator": "神楽", "text": "$handlek$にとっては、話題をぶり返してまで否定するくらい大事なことなのぴょん…？"},
        { "location": "304/SEL" , "narrator": "（選択肢）", "text": "そうです"},
        { "location": "305/SEL" , "narrator": "（選択肢）", "text": "ちょっとからかっただけぴょん♪"},
        { "location": "306/ACT" , "narrator": "", "text": "そうです"},
        { "location": "307/TALK", "narrator": "神楽", "text": "わかりましたぴょん"},
        { "location": "308/TALK", "narrator": "神楽", "text": "じゃあ、$handlek$には、ぴょんこの愛がぎゅっと詰まったチョコはお預けぴょん"},
        { "location": "309/TALK", "narrator": "神楽", "text": "またねー"},
        { "location": "311/ACT" , "narrator": "", "text": "ちょっとからかっただけぴょん♪"},
        { "location": "312/TALK", "narrator": "神楽", "text": "STOP!キャラ泥棒"},
        { "location": "313/TALK", "narrator": "神楽", "text": "というわけで、キャラ泥$handle$には罰を受けてもらうぴょん！"},
        { "location": "318/SEL" , "narrator": "（選択肢）", "text": "な、何をしようというのです？"},
        { "location": "319/ACT" , "narrator": "", "text": "な、何をしようというのです？"},
        { "location": "321/TALK", "narrator": "神楽", "text": "今ぴょんこがハムしてるチョコですけど"},
        { "location": "322/TALK", "narrator": "神楽", "text": "実は呪いがかかってるのです"},
        { "location": "323/TALK", "narrator": "神楽", "text": "このチョコを食べた者は、ぴょんこへの愛の想いが強ければ強いほど長く、そして強烈な苦しみを味わうことになるのです"},
        { "location": "324/TALK", "narrator": "神楽", "text": "というわけでﾄﾞｿﾞｰ"},
        { "location": "325/SEL" , "narrator": "（選択肢）", "text": "それ$me$は絶対一生猛烈に苦しみ続けるってことじゃん！！！"},
        { "location": "326/SEL" , "narrator": "（選択肢）", "text": "$me$はそこそこ苦しむのかな"},
        { "location": "327/SEL" , "narrator": "（選択肢）", "text": "それなら$me$は食べても安心じゃん"},
        { "location": "328/ACT" , "narrator": "", "text": "それ$me$は絶対一生猛烈に苦しみ続けるってことじゃん！！！"},
        { "location": "331/TALK", "narrator": "神楽", "text": "ぴょん！！！！"},
        { "location": "332/TALK", "narrator": "神楽", "text": "さあさあ、食べますか？食べませんか？"},
        { "location": "333/ACT" , "narrator": "", "text": "$me$はそこそこ苦しむのかな"},
        { "location": "334/TALK", "narrator": "神楽", "text": "あーなんか日和ってるー"},
        { "location": "336/TALK", "narrator": "神楽", "text": "テンションさがるわー"},
        { "location": "337/TALK", "narrator": "神楽", "text": "ぴょんこは激しいのがすき"},
        { "location": "338/TALK", "narrator": "神楽", "text": "ヌルい恋愛は退屈しちゃうの"},
        { "location": "339/TALK", "narrator": "神楽", "text": "$handlek$用のチョコはあとでコンビニで買ってくるぴょん"},
        { "location": "340/TALK", "narrator": "神楽", "text": "作って損したぴょん"},
        { "location": "341/TALK", "narrator": "神楽", "text": "じゃねー"},
        { "location": "343/ACT" , "narrator": "", "text": "それなら$me$は食べても安心じゃん"},
        { "location": "344/TALK", "narrator": "神楽", "text": "ちな"},
        { "location": "345/TALK", "narrator": "神楽", "text": "ぴょんこのことを愛していない人や、クソゴミが食べると"},
        { "location": "346/TALK", "narrator": "神楽", "text": "即死！！！"},
        { "location": "348/TALK", "narrator": "神楽", "text": "ぴょん。"},
        { "location": "349/TALK", "narrator": "神楽", "text": "だから食べない方がいいぴょん"},
        { "location": "350/TALK", "narrator": "神楽", "text": "じゃねー"},
        { "location": "353/SEL" , "narrator": "（選択肢）", "text": "そんなの食べるに決まってんだろ！！！（ヤケクソ"},
        { "location": "354/SEL" , "narrator": "（選択肢）", "text": "遠慮します…"},
        { "location": "355/ACT" , "narrator": "", "text": "そんなの食べるに決まってんだろ！！！（ヤケクソ"},
        { "location": "356/TALK", "narrator": "神楽", "text": "若者よ、命を粗末にしてはなりませんよ？"},
        { "location": "357/TALK", "narrator": "神楽", "text": "でも"},
        { "location": "358/TALK", "narrator": "神楽", "text": "うれしい"},
        { "location": "359/TALK", "narrator": "神楽", "text": "から"},
        { "location": "360/TALK", "narrator": "神楽", "text": "ぴょんこも一緒に食べて一緒に苦しむます！！！！！"},
        { "location": "361/SEL" , "narrator": "（選択肢）", "text": "自爆しちゃっていいの！？"},
        { "location": "362/SEL" , "narrator": "（選択肢）", "text": "苦しむますってヘンだよ！"},
        { "location": "363/ACT" , "narrator": "", "text": "自爆しちゃっていいの！？"},
        { "location": "364/TALK", "narrator": "神楽", "text": "うん"},
        { "location": "365/ACT" , "narrator": "", "text": "苦しむますってヘンだよ！"},
        { "location": "366/TALK", "narrator": "神楽", "text": "いやソコどーでもいいから"},
        { "location": "370/TALK", "narrator": "神楽", "text": "マジレスすると"},
        { "location": "371/TALK", "narrator": "神楽", "text": "これは、$handlek$とぴょんこの人生の物語"},
        { "location": "372/TALK", "narrator": "神楽", "text": "恋は呪い"},
        { "location": "373/TALK", "narrator": "神楽", "text": "強く恋すればするほどその苦しみは増し、重くなるの"},
        { "location": "374/TALK", "narrator": "神楽", "text": "食べなければ苦しまないのに、どうして食べてしまうの？"},
        { "location": "375/TALK", "narrator": "神楽", "text": "愛すれば愛するほど離れられなくなって、籍入れちゃったら一生の呪いになってしまうのに"},
        { "location": "376/TALK", "narrator": "神楽", "text": "だからね、ぴょんこは"},
        { "location": "377/TALK", "narrator": "神楽", "text": "そこまで決死の覚悟でぴょんこの事を愛してくれる人となら、その呪いを一緒に受けたいって思うの"},
        { "location": "378/TALK", "narrator": "神楽", "text": "だってそうしたら、$handlek$が辛いとき、それをどうすることもできなくても"},
        { "location": "379/TALK", "narrator": "神楽", "text": "一緒に泣いたり分かち合ったりすることくらいはできるから"},
        { "location": "380/TALK", "narrator": "神楽", "text": "ﾅﾝﾃﾈ-------!!!!!!"},
        { "location": "384/SEL" , "narrator": "（選択肢）", "text": "照れ隠しする神楽ｶﾜｲｲ！！"},
        { "location": "385/SEL" , "narrator": "（選択肢）", "text": "口に咥えてるチョコ、溶けちゃってるよ？"},
        { "location": "386/ACT" , "narrator": "", "text": "照れ隠しする神楽ｶﾜｲｲ！！"},
        { "location": "389/TALK", "narrator": "神楽", "text": "ﾑｯｶｰｰｰｰｰ!!"},
        { "location": "391/TALK", "narrator": "神楽", "text": "前言撤回ぴょん"},
        { "location": "392/TALK", "narrator": "神楽", "text": "ぴょんこが食べた分は全部$handlek$に無理矢理喰わす"},
        { "location": "393/TALK", "narrator": "神楽", "text": "1人で呪われてくださいぴょん"},
        { "location": "394/SEL" , "narrator": "（選択肢）", "text": "どうやって無理矢理喰わせるの？"},
        { "location": "395/ACT" , "narrator": "", "text": "どうやって無理矢理喰わせるの？"},
        { "location": "397/TALK", "narrator": "神楽", "text": "いわせんなﾊﾞｰｶﾊﾞｰｶ"},
        { "location": "398/ACT" , "narrator": "", "text": "口に咥えてるチョコ、溶けちゃってるよ？"},
        { "location": "400/TALK", "narrator": "神楽", "text": "知ってた"},
        { "location": "401/TALK", "narrator": "神楽", "text": "でもいいの"},
        { "location": "402/TALK", "narrator": "神楽", "text": "きっと$handlek$が全部舐め取ってくれるから"},
        { "location": "406/ACT" , "narrator": "", "text": "遠慮します…"},
        { "location": "409/TALK", "narrator": "神楽", "text": "うんうん"},
        { "location": "410/TALK", "narrator": "神楽", "text": "$handlek$は正気の沙汰だぴょん♪"},
        { "location": "411/TALK", "narrator": "神楽", "text": "精神が健全な証拠！"},
        { "location": "412/TALK", "narrator": "神楽", "text": "せいぜい人生長生きしてね！ぴょんこからのお願いだぴょん♪"},
        { "location": "414/TALK", "narrator": "神楽", "text": "それじゃまたねー"}
    ]
}
