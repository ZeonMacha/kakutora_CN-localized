        { "location": "187/SCENARIO", "narrator": "", "text": "021_真剣な落書き"},
        { "location": "212/TALK"    , "narrator": "アーヤ", "text": "ボランティアで行った保育園の子たちが"},
        { "location": "213/TALK"    , "narrator": "アーヤ", "text": "メッセージカードをくれたの(*^.^*)"},
        { "location": "215/SEL"     , "narrator": "", "text": "字がかけるの？"},
        { "location": "216/SEL"     , "narrator": "", "text": "保育士の先生じゃなくて？"},
        { "location": "217/SEL"     , "narrator": "", "text": "そういうのうれしいね"},
        { "location": "218/ACT"     , "narrator": "", "text": "字がかけるの？"},
        { "location": "219/TALK"    , "narrator": "アーヤ", "text": "賭ける子もいるわよ"},
        { "location": "221/TALK"    , "narrator": "アーヤ", "text": "書ける子も"},
        { "location": "222/ACT"     , "narrator": "", "text": "保育士の先生じゃなくて？"},
        { "location": "223/TALK"    , "narrator": "アーヤ", "text": "先生がまとめて"},
        { "location": "224/TALK"    , "narrator": "アーヤ", "text": "くれたんだけどね"},
        { "location": "225/ACT"     , "narrator": "", "text": "そういうのうれしいね"},
        { "location": "228/TALK"    , "narrator": "アーヤ", "text": "自分でもびっくりしちゃうくらい嬉しかったわ"},
        { "location": "230/TALK"    , "narrator": "アーヤ", "text": "お礼を言われるのが目的じゃなかったけど"},
        { "location": "231/TALK"    , "narrator": "アーヤ", "text": "すごくうれしい(^-^*)(･･*)(^-^*)(･･*)"},
        { "location": "239/TALK"    , "narrator": "アーヤ", "text": "お芝居の絵とか"},
        { "location": "240/TALK"    , "narrator": "アーヤ", "text": "勝手に続きを書いてる子とかもいて"},
        { "location": "241/TALK"    , "narrator": "アーヤ", "text": "面白い"},
        { "location": "243/SEL"     , "narrator": "", "text": "フリーダムな"},
        { "location": "244/SEL"     , "narrator": "", "text": "アーヤのための物語を紡ぐよ……"},
        { "location": "245/SEL"     , "narrator": "", "text": "それってただの落書きじゃ"},
        { "location": "246/ACT"     , "narrator": "", "text": "フリーダムな"},
        { "location": "247/TALK"    , "narrator": "アーヤ", "text": "子供らしくていいじゃない"},
        { "location": "248/TALK"    , "narrator": "アーヤ", "text": "何度も見直しちゃうわ"},
        { "location": "249/TALK"    , "narrator": "アーヤ", "text": "楽しくて"},
        { "location": "250/ACT"     , "narrator": "", "text": "アーヤのための物語を紡ぐよ……"},
        { "location": "252/TALK"    , "narrator": "アーヤ", "text": "あら(☆｡☆)"},
        { "location": "253/TALK"    , "narrator": "アーヤ", "text": "それは素敵ね"},
        { "location": "254/TALK"    , "narrator": "アーヤ", "text": "楽しみにしてるわ(*^.^*)"},
        { "location": "255/ACT"     , "narrator": "", "text": "それってただの落書きじゃ"},
        { "location": "256/TALK"    , "narrator": "アーヤ", "text": "そんな飯川"},
        { "location": "258/TALK"    , "narrator": "アーヤ", "text": "言い方"},
        { "location": "259/TALK"    , "narrator": "アーヤ", "text": "するとか"},
        { "location": "260/TALK"    , "narrator": "アーヤ", "text": "わかってないあね（｀皿´ )"}
    ]
