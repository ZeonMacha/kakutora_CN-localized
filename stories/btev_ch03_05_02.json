{
    "dir": "chap05/battle/btev_ch03_05_02.js",
    "type": "",
    "info": {
        "story_id": "23006",
        "cid": "",
        "title": "006 ココロスフィアストーリー【Lv02】",
        "sub_title": "壊されるココロⅠ＜帰結＞"
    },
    "entry":
    [
        { "location": "172/SCENARIO", "narrator": "", "text": "壊されるココロ２"},
        { "location": "187/TALK"    , "narrator": "表層ガブリエラ", "text": "くっ……まさか\nここまでとはね。"},
        { "location": "188/TALK"    , "narrator": "ガブリエラ", "text": "ざまぁ見なさいよ。"},
        { "location": "189/TALK"    , "narrator": "表層ガブリエラ", "text": "出直してくるわ。\nすぐに戻ってくるから\n覚悟しておきなさい。"},
        { "location": "199/TALK"    , "narrator": "ガブリエラ", "text": "はぁ…。"},
        { "location": "213/TALK"    , "narrator": "ガブリエラ", "text": "改めてありがと。\n助かったわ。"},
        { "location": "214/SEL"     , "narrator": "（選択肢）", "text": "つばめと仲良くなりたいのは本心なの？"},
        { "location": "215/ACT"     , "narrator": "", "text": "つばめと仲良くなりたいのは本心なの？"},
        { "location": "217/TALK"    , "narrator": "ガブリエラ", "text": "は、はぁ！？\n何を突然\n言い出すのかしら？"},
        { "location": "218/TALK"    , "narrator": "ガブリエラ", "text": "当たり前でしょ！"},
        { "location": "219/SEL"     , "narrator": "（選択肢）", "text": "ホントに？　下心とかない？"},
        { "location": "220/ACT"     , "narrator": "", "text": "ホントに？\n下心とかない？"},
        { "location": "222/TALK"    , "narrator": "ガブリエラ", "text": "いや、\nそれは……その…"},
        { "location": "223/TALK"    , "narrator": "ガブリエラ", "text": "はぁ…\nあんたには\n敵わないわ。"},
        { "location": "224/TALK"    , "narrator": "ガブリエラ", "text": "確かに無いと言えば\n嘘になるわね。"},
        { "location": "225/TALK"    , "narrator": "ガブリエラ", "text": "あんたはあたしに\n協力してくれたから\n教えてあげるわ。"},
        { "location": "226/TALK"    , "narrator": "ガブリエラ", "text": "丁度アイツも\nいなくなってるし。"},
        { "location": "227/TALK"    , "narrator": "ガブリエラ", "text": "本当のこというと……"},
        { "location": "228/TALK"    , "narrator": "ガブリエラ", "text": "あたし、つばめに\n壊して欲しいココロが\nあるの。"},
        { "location": "229/SEL"     , "narrator": "（選択肢）", "text": "バカ、早まるな！"},
        { "location": "230/ACT"     , "narrator": "", "text": "バカ、早まるな！"},
        { "location": "232/TALK"    , "narrator": "ガブリエラ", "text": "違うのよ。\nそれじゃ、こう言えば\nいいかしら？"},
        { "location": "233/TALK"    , "narrator": "ガブリエラ", "text": "『消して欲しい\n記憶がある』って。"},
        { "location": "234/TALK"    , "narrator": "ガブリエラ", "text": "あたしのココロの\n中には、黒いヴェール\nに包まれた所がある。"},
        { "location": "235/TALK"    , "narrator": "ガブリエラ", "text": "その中にある記憶は\n封印されていて、出て\nくることは無いけど―"},
        { "location": "236/TALK"    , "narrator": "ガブリエラ", "text": "その記憶はあたし\n全体にもの凄い\n不利益を与えてるの。"},
        { "location": "237/SEL"     , "narrator": "（選択肢）", "text": "例えば？"},
        { "location": "238/ACT"     , "narrator": "", "text": "例えば？"},
        { "location": "240/TALK"    , "narrator": "ガブリエラ", "text": "トラウマとか、\n…あと、恐怖症？"},
        { "location": "241/SEL"     , "narrator": "（選択肢）", "text": "何の？"},
        { "location": "242/ACT"     , "narrator": "", "text": "何の？"},
        { "location": "244/TALK"    , "narrator": "ガブリエラ", "text": "教えない。"},
        { "location": "245/TALK"    , "narrator": "ガブリエラ", "text": "でも、あんたと\n長い付き合いになる\nようなことがあれば―"},
        { "location": "246/TALK"    , "narrator": "ガブリエラ", "text": "いずれ教える時も\n来るかもしれないわね。"},
        { "location": "248/TALK"    , "narrator": "ガブリエラ", "text": "その前に、\n気づかれちゃうかも\nしれないけど。"},
        { "location": "249/TALK"    , "narrator": "ガブリエラ", "text": "だから、\nその部分を粉々にして\nもらいたいのよ。"},
        { "location": "250/TALK"    , "narrator": "ガブリエラ", "text": "つばめは壊した時の\n記憶がないって\n言ってるけど――"},
        { "location": "251/TALK"    , "narrator": "ガブリエラ", "text": "多分何らかの形で\nココロの奥底では\n認識してると思うの。"},
        { "location": "252/SEL"     , "narrator": "（選択肢）", "text": "危険じゃない？"},
        { "location": "253/ACT"     , "narrator": "", "text": "危険じゃない？"},
        { "location": "255/TALK"    , "narrator": "ガブリエラ", "text": "そうね。\nでも――"},
        { "location": "256/TALK"    , "narrator": "ガブリエラ", "text": "もう嫌なのよ。\n自分のトラウマと\nつき合っていくのは。"},
        { "location": "257/SEL"     , "narrator": "（選択肢）", "text": "よし、そのトラウマを壊しにいこう！"},
        { "location": "258/ACT"     , "narrator": "", "text": "よし、そのトラウマを壊しにいこう！"},
        { "location": "260/TALK"    , "narrator": "ガブリエラ", "text": "はあ！？\n何言ってるの！？"},
        { "location": "261/SEL"     , "narrator": "（選択肢）", "text": "壊しちゃえば、そんな危険なことしなくて済むし"},
        { "location": "262/ACT"     , "narrator": "", "text": "壊しちゃえば、そんな危険なことしなくて済むし"},
        { "location": "264/TALK"    , "narrator": "ガブリエラ", "text": "それはそうだけど……"},
        { "location": "265/TALK"    , "narrator": "ガブリエラ", "text": "トラウマや恐怖症って\n心の奥底にあるもの\nだし、すごい強固なの。"},
        { "location": "266/TALK"    , "narrator": "ガブリエラ", "text": "そんな簡単に壊せる\nものじゃないわ。"},
        { "location": "267/SEL"     , "narrator": "（選択肢）", "text": "やるだけやってみようよ"},
        { "location": "268/ACT"     , "narrator": "", "text": "やるだけやってみようよ"},
        { "location": "271/TALK"    , "narrator": "ガブリエラ", "text": "うーん……"},
        { "location": "272/TALK"    , "narrator": "ガブリエラ", "text": "そうね、わかったわ。\n上手くいくかは\nわからないけど。"},
        { "location": "273/TALK"    , "narrator": "ガブリエラ", "text": "次、あんたがココロの\n中に来たとき、そこへ\n案内してあげる。"},
        { "location": "284/TALK"    , "narrator": "ガブリエラ", "text": "くっ……\n何て事なの？"},
        { "location": "286/TALK"    , "narrator": "表層ガブリエラ", "text": "当然の結果ね。"},
        { "location": "287/TALK"    , "narrator": "ガブリエラ", "text": "一度撤退ね。\nすぐに戻ってくるから\n待ってらっしゃい。"},
        { "location": "296/TALK"    , "narrator": "表層ガブリエラ", "text": "……。"},
        { "location": "307/TALK"    , "narrator": "表層ガブリエラ", "text": "ありがとう。\nお陰であたし自身を\n守ることができたわ。"},
        { "location": "308/TALK"    , "narrator": "表層ガブリエラ", "text": "でもまさか、あたしを\n支援してくれるとは\n思わなかった。"},
        { "location": "309/SEL"     , "narrator": "（選択肢）", "text": "つばめには裏があると思うから"},
        { "location": "310/ACT"     , "narrator": "", "text": "つばめには裏があると思うから"},
        { "location": "312/TALK"    , "narrator": "表層ガブリエラ", "text": "その通り。あの子に\n近づいてはダメ。"},
        { "location": "313/TALK"    , "narrator": "表層ガブリエラ", "text": "ただでさえあたしは\n壊される可能性が\n高いんだから……"},
        { "location": "314/SEL"     , "narrator": "（選択肢）", "text": "え？どういうこと？"},
        { "location": "315/ACT"     , "narrator": "", "text": "え？どういうこと？"},
        { "location": "317/TALK"    , "narrator": "表層ガブリエラ", "text": "え？　いえ、\nなんでもないのよ。"},
        { "location": "318/SEL"     , "narrator": "（選択肢）", "text": "え―――――― …"},
        { "location": "319/ACT"     , "narrator": "", "text": "え―――――― …"},
        { "location": "321/TALK"    , "narrator": "表層ガブリエラ", "text": "わ、わかったわよ。\nあんたには借りが\nあるし…仕方ないわね。"},
        { "location": "322/TALK"    , "narrator": "表層ガブリエラ", "text": "あたし、\nフェノメノンを発症\nしやすい体質なのよ。"},
        { "location": "323/SEL"     , "narrator": "（選択肢）", "text": "そういうの、あるの！？"},
        { "location": "324/ACT"     , "narrator": "", "text": "そういうの、あるの！？"},
        { "location": "326/TALK"    , "narrator": "表層ガブリエラ", "text": "うーん、\nちょっと誤解を招く\n言い方だったかも。"},
        { "location": "327/TALK"    , "narrator": "表層ガブリエラ", "text": "ココロの中に大きな\nトラウマがあって――"},
        { "location": "329/TALK"    , "narrator": "表層ガブリエラ", "text": "発症のトリガーに\nなりやすいのよ。"},
        { "location": "330/SEL"     , "narrator": "（選択肢）", "text": "なるほど…"},
        { "location": "331/ACT"     , "narrator": "", "text": "なるほど…"},
        { "location": "333/TALK"    , "narrator": "表層ガブリエラ", "text": "もし発症したら\n当然みんなに迷惑\nかけるし――"},
        { "location": "334/TALK"    , "narrator": "表層ガブリエラ", "text": "その時つばめに\n壊されちゃうかも\nしれない。"},
        { "location": "335/TALK"    , "narrator": "表層ガブリエラ", "text": "だから、あたしの\n傍からつばめを\n排除しないと。"},
        { "location": "336/TALK"    , "narrator": "表層ガブリエラ", "text": "目標は、\nトライナリーからの\n除隊よ！"},
        { "location": "337/SEL"     , "narrator": "（選択肢）", "text": "つばめ、悲しむよ？"},
        { "location": "338/SEL"     , "narrator": "（選択肢）", "text": "その通り！　除隊せよ！"},
        { "location": "339/ACT"     , "narrator": "", "text": "つばめ、悲しむよ？"},
        { "location": "340/TALK"    , "narrator": "表層ガブリエラ", "text": "うっ……"},
        { "location": "341/TALK"    , "narrator": "表層ガブリエラ", "text": "うるさいわね。\nいいのよ、あんな奴。"},
        { "location": "342/TALK"    , "narrator": "表層ガブリエラ", "text": "……。"},
        { "location": "343/TALK"    , "narrator": "表層ガブリエラ", "text": "なんて割り切れたら\nもっと事態は進展\nしてたかもね。"},
        { "location": "344/ACT"     , "narrator": "", "text": "その通り！\n除隊せよ！"},
        { "location": "345/TALK"    , "narrator": "表層ガブリエラ", "text": "えっ……ええっ？\nなんかノリノリね！"},
        { "location": "346/TALK"    , "narrator": "表層ガブリエラ", "text": "ま、まあでも。"},
        { "location": "347/TALK"    , "narrator": "表層ガブリエラ", "text": "鬼の中にも仏がいる\nって言うし。"},
        { "location": "348/TALK"    , "narrator": "表層ガブリエラ", "text": "出来ればそうしないで\n何とか解決したい\nところよね。"},
        { "location": "350/SEL"     , "narrator": "（選択肢）", "text": "よし、そのトラウマを壊しにいこう！"},
        { "location": "351/ACT"     , "narrator": "", "text": "よし、そのトラウマを壊しにいこう！"},
        { "location": "353/TALK"    , "narrator": "表層ガブリエラ", "text": "はあ！？\n何言ってるの！？"},
        { "location": "354/SEL"     , "narrator": "（選択肢）", "text": "壊しちゃえば、発症しにくくなるでしょ？"},
        { "location": "355/ACT"     , "narrator": "", "text": "壊しちゃえば、発症しにくくなるでしょ？"},
        { "location": "357/TALK"    , "narrator": "表層ガブリエラ", "text": "それはそうだけど……"},
        { "location": "358/TALK"    , "narrator": "表層ガブリエラ", "text": "トラウマや恐怖症って\n心の奥底にあるもの\nだし、すごい強固なの。"},
        { "location": "359/TALK"    , "narrator": "表層ガブリエラ", "text": "そんな簡単に壊せる\nものじゃないわ。"},
        { "location": "360/SEL"     , "narrator": "（選択肢）", "text": "やるだけやってみようよ"},
        { "location": "361/ACT"     , "narrator": "", "text": "やるだけやってみようよ"},
        { "location": "364/TALK"    , "narrator": "表層ガブリエラ", "text": "うーん……"},
        { "location": "365/TALK"    , "narrator": "表層ガブリエラ", "text": "そうね、わかったわ。\n上手くいくかは\nわからないけど。"},
        { "location": "366/TALK"    , "narrator": "表層ガブリエラ", "text": "次、あんたがココロの\n中に来たとき、そこへ\n案内してあげるわ。"}
    ]
}
