{
    "dir": "chap11/daydra/dd_ch02_11_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "11202",
        "cid": "ayami",
        "title": "002 メインストーリー",
        "sub_title": "その彼女嫉妬につき＜前編＞"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "恋について"},
        { "location": "25/TALK"   , "narrator": "アーヤ", "text": "ごめんね。\n時間作ってもらっ\nちゃって。"},
        { "location": "27/TALK"   , "narrator": "小夜", "text": "いいのいいの。\n別に予定があった\nわけじゃないんだし。"},
        { "location": "28/TALK"   , "narrator": "小夜", "text": "でも、珍しいね？\nアーヤが相談したい\nことがあるなんて。"},
        { "location": "30/TALK"   , "narrator": "アーヤ", "text": "うん…相談っていうか\nなんていうか…。"},
        { "location": "31/TALK"   , "narrator": "アーヤ", "text": "実は――"},
        { "location": "59/TALK"   , "narrator": "小夜", "text": "…なるほど。\nギャヴィちゃんが\n恋を、ね…。"},
        { "location": "61/TALK"   , "narrator": "アーヤ", "text": "だと思うんだけど、\n本人は違うって\n言い張ってて…。"},
        { "location": "62/TALK"   , "narrator": "小夜", "text": "いや、どうみても\nそれ恋でしょ？"},
        { "location": "64/TALK"   , "narrator": "アーヤ", "text": "やっぱりそうよね…。"},
        { "location": "65/TALK"   , "narrator": "小夜", "text": "でも、そっかぁ…。\nそれって初恋かな？"},
        { "location": "66/TALK"   , "narrator": "アーヤ", "text": "うーん…、\nあの様子からすると\n多分ね。"},
        { "location": "67/TALK"   , "narrator": "小夜", "text": "ふーん…海外の子は\nもっと進んでるかと\n思ったけど――"},
        { "location": "68/TALK"   , "narrator": "小夜", "text": "意外とそうでも\nないのかしら？"},
        { "location": "70/TALK"   , "narrator": "アーヤ", "text": "そ、そうね…。"},
        { "location": "71/TALK"   , "narrator": "アーヤ", "text": "…ギャヴィは男の人が\n苦手だから仕方ないん\nだけど。"},
        { "location": "72/TALK"   , "narrator": "小夜", "text": "他の子達はギャヴィ\nちゃんの言ったこと\n信じたの？"},
        { "location": "74/TALK"   , "narrator": "アーヤ", "text": "少なくとも、\n一人は信じてたと\n思うわ。"},
        { "location": "75/TALK"   , "narrator": "アーヤ", "text": "その子、恋愛には\n凄く疎い感じの\n子だし…。"},
        { "location": "76/TALK"   , "narrator": "小夜", "text": "…なんか、アーヤも\nそうだけど――"},
        { "location": "77/TALK"   , "narrator": "小夜", "text": "トライナリーの子って\nみんな恋愛に疎い感じ\nするわね。"},
        { "location": "79/TALK"   , "narrator": "アーヤ", "text": "…否定できないかも。"},
        { "location": "80/TALK"   , "narrator": "小夜", "text": "日本はその方面の\n教育に対して――"},
        { "location": "81/TALK"   , "narrator": "小夜", "text": "世界より遅れてる、\nってことなのかしら？"},
        { "location": "82/TALK"   , "narrator": "アーヤ", "text": "ギャヴィは日本人じゃ\nないんだけどね…。"},
        { "location": "83/TALK"   , "narrator": "ガブリエラ", "text": "…あら？"},
        { "location": "86/TALK"   , "narrator": "ガブリエラ", "text": "アーヤもお昼？"},
        { "location": "88/TALK"   , "narrator": "アーヤ", "text": "ギャヴィじゃない。\nそっちもお昼？"},
        { "location": "89/TALK"   , "narrator": "ガブリエラ", "text": "まあね。"},
        { "location": "92/TALK"   , "narrator": "つばめ", "text": "ガブちゃーん、\nちょっと待ってよー。"},
        { "location": "93/TALK"   , "narrator": "アーヤ", "text": "あら？　逢瀬さんも\n一緒だったんだ？"},
        { "location": "95/TALK"   , "narrator": "つばめ", "text": "はい。\n一緒にお昼食べる\n約束してたんです。"},
        { "location": "98/TALK"   , "narrator": "ガブリエラ", "text": "ちょ、つばめ！\n余計なこと言わないで\nいいから！"},
        { "location": "99/TALK"   , "narrator": "アーヤ", "text": "ふふっ、いつの間に\n仲良くなったの\nかしら？"},
        { "location": "101/TALK"  , "narrator": "小夜", "text": "…ねえ、アーヤ。"},
        { "location": "103/TALK"  , "narrator": "アーヤ", "text": "え？"},
        { "location": "104/TALK"  , "narrator": "アーヤ", "text": "ああ、そうだったわ。"},
        { "location": "105/TALK"  , "narrator": "アーヤ", "text": "ねえ、二人とも。\nもしよければ\n一緒に食べない？"},
        { "location": "106/TALK"  , "narrator": "つばめ", "text": "え？　でも…。"},
        { "location": "108/TALK"  , "narrator": "アーヤ", "text": "二人に、私の友達を\n紹介したいの。"},
        { "location": "135/TALK"  , "narrator": "アーヤ", "text": "えっと、ギャヴィは\n会ったことある\nわよね？"},
        { "location": "136/TALK"  , "narrator": "アーヤ", "text": "この子は私の大学の\n友達で――"},
        { "location": "137/TALK"  , "narrator": "小夜", "text": "倉沢小夜。\nよろしくね。"},
        { "location": "139/TALK"  , "narrator": "つばめ", "text": "わたし、少し前に\nこの学校に転入して\nきました――"},
        { "location": "140/TALK"  , "narrator": "つばめ", "text": "逢瀬つばめです。\nよ、よろしくお願い\nします！"},
        { "location": "141/TALK"  , "narrator": "小夜", "text": "あはは、いい子だね。"},
        { "location": "143/TALK"  , "narrator": "つばめ", "text": "そ、そうですか？"},
        { "location": "144/TALK"  , "narrator": "小夜", "text": "うん、間違いなし！"},
        { "location": "145/TALK"  , "narrator": "ガブリエラ", "text": "はじめまして、じゃ\nないですけど、\nあたしは――"},
        { "location": "146/TALK"  , "narrator": "小夜", "text": "ガブリエラちゃん\nだよね？"},
        { "location": "147/TALK"  , "narrator": "ガブリエラ", "text": "あ、はい。\nアーヤから聞いてたん\nですね？"},
        { "location": "148/TALK"  , "narrator": "小夜", "text": "うん。\nアーヤお気に入りの\n子だよね？"},
        { "location": "150/TALK"  , "narrator": "ガブリエラ", "text": "えっ！？"},
        { "location": "152/TALK"  , "narrator": "アーヤ", "text": "お気に入りって…、\nそんなこと言った\nかしら？"},
        { "location": "153/TALK"  , "narrator": "小夜", "text": "だって、一番よく\n話に出るじゃん。"},
        { "location": "157/TALK"  , "narrator": "ガブリエラ", "text": "そ、そうなんだ…。\nなんか、嬉しいな。"},
        { "location": "158/TALK"  , "narrator": "小夜", "text": "とりあえず、\nよろしくね。\nギャヴィちゃん。"},
        { "location": "161/TALK"  , "narrator": "ガブリエラ", "text": "ぎゃ、\nギャヴィちゃん！？"},
        { "location": "162/TALK"  , "narrator": "小夜", "text": "ん？　ダメだった？"},
        { "location": "165/TALK"  , "narrator": "ガブリエラ", "text": "い、いえ…ギャヴィに\nちゃん付けされるの、\n初めてなんで…。"},
        { "location": "166/TALK"  , "narrator": "小夜", "text": "つばめちゃんは…、\nつばめちゃんで\nいいかな？"},
        { "location": "170/TALK"  , "narrator": "つばめ", "text": "は、はい。\n倉沢さんの呼びやすい\n言い方で構いません。"},
        { "location": "171/TALK"  , "narrator": "小夜", "text": "じゃあ、\nつばめちゃんで。"},
        { "location": "172/TALK"  , "narrator": "小夜", "text": "あと、私のことは\n小夜でいいよ。"},
        { "location": "173/TALK"  , "narrator": "つばめ", "text": "わ、わかりました…。\nえと…小夜、先輩。"},
        { "location": "174/TALK"  , "narrator": "小夜", "text": "あはは、そんなに\n固くならなくても\nいいのに。"},
        { "location": "175/TALK"  , "narrator": "小夜", "text": "まあ、話してるうちに\n慣れてきてくれる\nかな？"},
        { "location": "203/TALK"  , "narrator": "小夜", "text": "へぇ、つばめちゃんは\n静岡から来たんだ？"},
        { "location": "205/TALK"  , "narrator": "つばめ", "text": "はい。\n小夜さんは行ったこと\nありますか？"},
        { "location": "206/TALK"  , "narrator": "小夜", "text": "熱海くらいなら\n行ったことあるよ。"},
        { "location": "207/TALK"  , "narrator": "小夜", "text": "でも、観光地じゃない\n場所ものんびり見に\n行ってみたいなぁ。"},
        { "location": "209/TALK"  , "narrator": "つばめ", "text": "なら、その時は\nわたしが案内\nしましょうか？"},
        { "location": "210/TALK"  , "narrator": "小夜", "text": "え、いいの？"},
        { "location": "211/TALK"  , "narrator": "つばめ", "text": "はい！\n地元のことなら\n任せてください。"},
        { "location": "212/TALK"  , "narrator": "小夜", "text": "わぁ、頼もしい！\nその時は絶対に\nお願いするねー。"},
        { "location": "214/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "217/TALK"  , "narrator": "ガブリエラ", "text": "…なんか、すっごい\n意気投合してない？"},
        { "location": "219/TALK"  , "narrator": "アーヤ", "text": "あはは…小夜は\n人と仲良くなるのが\n得意だからね。"},
        { "location": "220/TALK"  , "narrator": "ガブリエラ", "text": "…小夜さんも、\n幼児児童教育学科\nなのよね？"},
        { "location": "222/TALK"  , "narrator": "ガブリエラ", "text": "それってつまり、\n子供の相手が得意\nなんじゃ…。"},
        { "location": "223/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "224/TALK"  , "narrator": "ガブリエラ", "text": "それが答えね…。"},
        { "location": "226/TALK"  , "narrator": "つばめ", "text": "あはは、\nそれ本当ですか？"},
        { "location": "227/TALK"  , "narrator": "小夜", "text": "信じられないけど、\n本当なのよ。"},
        { "location": "228/TALK"  , "narrator": "小夜", "text": "私もアレを見た時は\n本当ビックリしたわ。"},
        { "location": "231/TALK"  , "narrator": "アーヤ", "text": "…それにしても、\n逢瀬さんのこんな\n楽しそうな顔――"},
        { "location": "232/TALK"  , "narrator": "アーヤ", "text": "私といる時は、\n一度も見たこと\nないかも…。"},
        { "location": "234/TALK"  , "narrator": "アーヤ", "text": "結構仲良くしてる\nつもりだったけど――"},
        { "location": "235/TALK"  , "narrator": "アーヤ", "text": "もしかして、\nそう思ってるのは\n私だけだった、とか？"},
        { "location": "237/TALK"  , "narrator": "小夜", "text": "あ、そうだ！\nそれじゃ今度――"},
        { "location": "238/TALK"  , "narrator": "小夜", "text": "つばめちゃんも\n一緒に行ってみない？"},
        { "location": "239/TALK"  , "narrator": "つばめ", "text": "いいんですか？"},
        { "location": "240/TALK"  , "narrator": "小夜", "text": "もちろん！"},
        { "location": "241/TALK"  , "narrator": "小夜", "text": "私も、もっともっと\nつばめちゃんと\n仲良くなりたいし。"},
        { "location": "243/TALK"  , "narrator": "つばめ", "text": "楽しみです！"},
        { "location": "245/TALK"  , "narrator": "小夜", "text": "そうだ！\nＷＡＶＥアカ登録\nしようよ。"},
        { "location": "246/TALK"  , "narrator": "小夜", "text": "ギャヴィちゃんも\nよかったら、登録して\nほしいな。"},
        { "location": "248/TALK"  , "narrator": "ガブリエラ", "text": "あたしも\nいいんですか？"},
        { "location": "249/TALK"  , "narrator": "小夜", "text": "もちろん。"},
        { "location": "251/TALK"  , "narrator": "つばめ", "text": "それじゃ、わたしから\n申請しますね。"},
        { "location": "253/TALK"  , "narrator": "小夜", "text": "…うん、登録完了！\nそれじゃ記念に…。"},
        { "location": "254/TALK"  , "narrator": "つばめ", "text": "あはは、\n可愛いスタンプ！"},
        { "location": "255/TALK"  , "narrator": "小夜", "text": "私のお気に入りなの。\nつばめちゃんは、\nどんなの使ってるの？"},
        { "location": "256/TALK"  , "narrator": "つばめ", "text": "わたしは、えっと…。"},
        { "location": "257/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "258/TALK"  , "narrator": "アーヤ", "text": "何か、面白くないわ。"},
        { "location": "302/TALK"  , "narrator": "アーヤ", "text": "[ココロゲート]へ\nいらっしゃい。\n$handle$さん。"},
        { "location": "303/TALK"  , "narrator": "アーヤ", "text": "もう完全に\n顔なじみに\nなっちゃったわね。"},
        { "location": "304/TALK"  , "narrator": "アーヤ", "text": "そうそう。\n今日は１つ、聞いてみたい\nことがあったのよ。"},
        { "location": "305/TALK"  , "narrator": "アーヤ", "text": "現実の私とやりとりを\n始めてからそれなりに\n時間が経ったけど――"},
        { "location": "307/TALK"  , "narrator": "アーヤ", "text": "今、私のこと\nどう思ってる？"},
        { "location": "308/SEL"   , "narrator": "", "text": "今のところ想像してた通り"},
        { "location": "309/SEL"   , "narrator": "", "text": "思ってたのとちょっと違った"},
        { "location": "310/SEL"   , "narrator": "", "text": "いい女"},
        { "location": "311/SEL"   , "narrator": "", "text": "とてもいいとおもいます"},
        { "location": "312/ACT"   , "narrator": "", "text": "今のところ想像してた通り"},
        { "location": "313/TALK"  , "narrator": "アーヤ", "text": "そう……。\nどんなの想像してたの？"},
        { "location": "314/SEL"   , "narrator": "", "text": "カッコイイ"},
        { "location": "315/SEL"   , "narrator": "", "text": "可愛い"},
        { "location": "316/ACT"   , "narrator": "", "text": "カッコイイ"},
        { "location": "319/TALK"  , "narrator": "アーヤ", "text": "ふふ、嬉しい。\nありがと。"},
        { "location": "321/ACT"   , "narrator": "", "text": "可愛い"},
        { "location": "324/TALK"  , "narrator": "アーヤ", "text": "ええっ！\nそうなの？"},
        { "location": "325/TALK"  , "narrator": "アーヤ", "text": "あまりそう言われたこと\n無かったから\nちょっと新鮮ね。"},
        { "location": "328/ACT"   , "narrator": "", "text": "思ってたのとちょっと違った"},
        { "location": "330/TALK"  , "narrator": "アーヤ", "text": "そうなの？\nそれは良い意味？\n悪い意味？"},
        { "location": "331/SEL"   , "narrator": "", "text": "もちろん良い意味でだよ"},
        { "location": "332/SEL"   , "narrator": "", "text": "悪い意味でかな"},
        { "location": "333/ACT"   , "narrator": "", "text": "もちろん良い意味でだよ"},
        { "location": "334/TALK"  , "narrator": "アーヤ", "text": "ふふ、良かった。\nでも、どう違ったのか\nちょっと気になるかも。"},
        { "location": "335/SEL"   , "narrator": "", "text": "可愛くて甘えん坊ちゃんだった"},
        { "location": "336/SEL"   , "narrator": "", "text": "守ってあげたくなるタイプだった"},
        { "location": "337/ACT"   , "narrator": "", "text": "可愛くて甘えん坊ちゃんだった"},
        { "location": "338/TALK"  , "narrator": "アーヤ", "text": "それって\n良い意味なのかしらね。"},
        { "location": "340/ACT"   , "narrator": "", "text": "守ってあげたくなるタイプだった"},
        { "location": "341/TALK"  , "narrator": "アーヤ", "text": "そ、そうなの？"},
        { "location": "342/TALK"  , "narrator": "アーヤ", "text": "よくわからないけど、\nそれじゃ、守って\nもらっちゃおうかな。"},
        { "location": "345/ACT"   , "narrator": "", "text": "悪い意味でかな"},
        { "location": "347/TALK"  , "narrator": "アーヤ", "text": "あらら。\nそれは問題ね。\nどんな風に？"},
        { "location": "348/SEL"   , "narrator": "", "text": "結構撃たれ弱くない？"},
        { "location": "349/SEL"   , "narrator": "", "text": "気にしいすぎ"},
        { "location": "350/ACT"   , "narrator": "", "text": "結構撃たれ弱くない？"},
        { "location": "351/TALK"  , "narrator": "アーヤ", "text": "あー、確かに\nそうかもしれないわね。"},
        { "location": "352/TALK"  , "narrator": "アーヤ", "text": "人の意見を\n気にしちゃう方だし。"},
        { "location": "354/ACT"   , "narrator": "", "text": "気にしいすぎ"},
        { "location": "355/TALK"  , "narrator": "アーヤ", "text": "あー、そうね。"},
        { "location": "357/TALK"  , "narrator": "アーヤ", "text": "私ってば、\nいつも人の目ばっかり\n気にしてるものね。"},
        { "location": "361/ACT"   , "narrator": "", "text": "いい女"},
        { "location": "364/TALK"  , "narrator": "アーヤ", "text": "なぁに？\nその言い方。"},
        { "location": "365/TALK"  , "narrator": "アーヤ", "text": "ちょっと\nアダルトな感じね。\nどうしてそう思うの？"},
        { "location": "366/SEL"   , "narrator": "", "text": "包容力があるよね"},
        { "location": "367/SEL"   , "narrator": "", "text": "面倒見が良い"},
        { "location": "368/SEL"   , "narrator": "", "text": "胸が大きい"},
        { "location": "369/SEL"   , "narrator": "", "text": "うなじと脇が最高"},
        { "location": "370/ACT"   , "narrator": "", "text": "包容力があるよね"},
        { "location": "371/TALK"  , "narrator": "アーヤ", "text": "ほんと？\n嬉しいわ！"},
        { "location": "372/TALK"  , "narrator": "アーヤ", "text": "私にとって\n一番の言葉かも。"},
        { "location": "373/SEL"   , "narrator": "", "text": "$me$も包まれたい"},
        { "location": "374/ACT"   , "narrator": "", "text": "$me$も包まれたい"},
        { "location": "377/TALK"  , "narrator": "アーヤ", "text": "ふふ、はいはい。\nそれじゃまた今度ね。"},
        { "location": "379/ACT"   , "narrator": "", "text": "面倒見が良い"},
        { "location": "380/TALK"  , "narrator": "アーヤ", "text": "あら、嬉しい。\nそう思ってくれてるの？"},
        { "location": "381/SEL"   , "narrator": "", "text": "ギャヴィに懐かれてるよね"},
        { "location": "382/SEL"   , "narrator": "", "text": "子供ウケよさそう"},
        { "location": "383/ACT"   , "narrator": "", "text": "ギャヴィに懐かれてるよね"},
        { "location": "385/TALK"  , "narrator": "アーヤ", "text": "あー…、そうね。\nあれは懐いてるって\n言うのかしらね。"},
        { "location": "387/ACT"   , "narrator": "", "text": "子供ウケよさそう"},
        { "location": "388/TALK"  , "narrator": "アーヤ", "text": "ほんと？\nだとしたら嬉しいかも。"},
        { "location": "389/TALK"  , "narrator": "アーヤ", "text": "子供は大好きなのよね。"},
        { "location": "390/SEL"   , "narrator": "", "text": "保育士さんに向いてそう"},
        { "location": "391/SEL"   , "narrator": "", "text": "子供は何人がいいですか？"},
        { "location": "392/ACT"   , "narrator": "", "text": "保育士さんに向いてそう"},
        { "location": "393/TALK"  , "narrator": "アーヤ", "text": "やった！"},
        { "location": "394/TALK"  , "narrator": "アーヤ", "text": "実は保育士になりたいって\n思ってるのよね。"},
        { "location": "396/ACT"   , "narrator": "", "text": "子供は何人がいいですか？"},
        { "location": "398/TALK"  , "narrator": "アーヤ", "text": "えっと、２人――"},
        { "location": "399/TALK"  , "narrator": "アーヤ", "text": "って！\n何の話させてるのよ。"},
        { "location": "403/ACT"   , "narrator": "", "text": "胸が大きい"},
        { "location": "404/TALK"  , "narrator": "アーヤ", "text": "はいはい、ありがと。"},
        { "location": "405/TALK"  , "narrator": "アーヤ", "text": "人を牛みたいに\n言わないでくれる？"},
        { "location": "406/SEL"   , "narrator": "", "text": "$me$も包まれたい"},
        { "location": "407/ACT"   , "narrator": "", "text": "$me$も包まれたい"},
        { "location": "409/TALK"  , "narrator": "アーヤ", "text": "こっちに来れたらね。"},
        { "location": "411/ACT"   , "narrator": "", "text": "うなじと脇が最高"},
        { "location": "414/TALK"  , "narrator": "アーヤ", "text": "えええっ！？\nちょ、ちょっと\n何それ……。"},
        { "location": "415/SEL"   , "narrator": "", "text": "夜のアーヤが美しいです"},
        { "location": "416/SEL"   , "narrator": "", "text": "アーヤは肩出してるの好きだよね"},
        { "location": "417/ACT"   , "narrator": "", "text": "夜のアーヤが美しいです"},
        { "location": "419/TALK"  , "narrator": "アーヤ", "text": "そ、それって\n褒められてるのかしら…。"},
        { "location": "421/ACT"   , "narrator": "", "text": "アーヤは肩出してるの好きだよね"},
        { "location": "423/TALK"  , "narrator": "アーヤ", "text": "え？"},
        { "location": "424/TALK"  , "narrator": "アーヤ", "text": "あ、ええ、まあ……"},
        { "location": "426/TALK"  , "narrator": "アーヤ", "text": "そうね。\n確かに好きかも。"},
        { "location": "427/TALK"  , "narrator": "アーヤ", "text": "胸から上に布がまとわり\nついてるの、ちょっと\nうっとうしいのよね。"},
        { "location": "431/ACT"   , "narrator": "", "text": "とてもいいとおもいます"},
        { "location": "433/TALK"  , "narrator": "アーヤ", "text": "なあに？\nその小学生並みの感想。"},
        { "location": "437/TALK"  , "narrator": "アーヤ", "text": "何にしても\nご協力ありがと。"},
        { "location": "438/TALK"  , "narrator": "アーヤ", "text": "貴方が私をどう思ってるか\n良くわかったわ。"},
        { "location": "439/SEL"   , "narrator": "", "text": "その情報をどうするの？"},
        { "location": "440/ACT"   , "narrator": "", "text": "その情報をどうするの？"},
        { "location": "442/TALK"  , "narrator": "アーヤ", "text": "え？"},
        { "location": "443/TALK"  , "narrator": "アーヤ", "text": "いえ、\nどうもしないわよ？"},
        { "location": "444/TALK"  , "narrator": "アーヤ", "text": "……っと、それより\n本題に入らなくちゃ。"},
        { "location": "446/TALK"  , "narrator": "アーヤ", "text": "扉をコールするわね。"},
        { "location": "451/TALK"  , "narrator": "アーヤ", "text": "オープンプロセス、\n0x71D番地から\n0xEC5番地へ。"},
        { "location": "466/TALK"  , "narrator": "アーヤ", "text": "シーク完了。"},
        { "location": "468/TALK"  , "narrator": "アーヤ", "text": "さて、\n今回は何かしらね。"},
        { "location": "470/TALK"  , "narrator": "アーヤ", "text": "……。"},
        { "location": "471/SEL"   , "narrator": "", "text": "どうしたの？"},
        { "location": "472/ACT"   , "narrator": "", "text": "どうしたの？"},
        { "location": "475/TALK"  , "narrator": "アーヤ", "text": "いえ。\n我ながら……何というか、\n恥ずかしい女だなって。"},
        { "location": "476/TALK"  , "narrator": "アーヤ", "text": "本人わかってないけど、\nココロファイル02-224-13\nによると――"},
        { "location": "477/TALK"  , "narrator": "アーヤ", "text": "小夜のこと、ちょっと\n嫉妬してるみたい。"},
        { "location": "478/SEL"   , "narrator": "", "text": "つばめのことで？"},
        { "location": "479/SEL"   , "narrator": "", "text": "もしかして百合展開！？"},
        { "location": "480/ACT"   , "narrator": "", "text": "つばめのことで？"},
        { "location": "481/TALK"  , "narrator": "アーヤ", "text": "そう。"},
        { "location": "482/ACT"   , "narrator": "", "text": "もしかして百合展開！？"},
        { "location": "483/TALK"  , "narrator": "アーヤ", "text": "は？"},
        { "location": "484/TALK"  , "narrator": "アーヤ", "text": "ちょっと、\n何を期待してるの？"},
        { "location": "485/TALK"  , "narrator": "アーヤ", "text": "そういうのじゃなくて！\n…もう。"},
        { "location": "487/TALK"  , "narrator": "アーヤ", "text": "要はね、\n小夜は今日初めて\n会ったわけでしょう？"},
        { "location": "488/TALK"  , "narrator": "アーヤ", "text": "のに、もう仲良く\nなってるから……。"},
        { "location": "489/TALK"  , "narrator": "アーヤ", "text": "翻って私は、もうだいぶ\n立つのに、まだ逢瀬さんに\n距離取られてる気がして。"},
        { "location": "490/SEL"   , "narrator": "", "text": "先輩として尊敬してるんだよ"},
        { "location": "491/SEL"   , "narrator": "", "text": "この前押し倒してたのに？"},
        { "location": "492/ACT"   , "narrator": "", "text": "先輩として尊敬してるんだよ"},
        { "location": "493/TALK"  , "narrator": "アーヤ", "text": "うーん、\nそうなのかしら。"},
        { "location": "494/TALK"  , "narrator": "アーヤ", "text": "実は逢瀬さん、内心は\n私のこと、とっつきづらい\n口うるさい女だって……"},
        { "location": "495/ACT"   , "narrator": "", "text": "この前押し倒してたのに？"},
        { "location": "499/TALK"  , "narrator": "アーヤ", "text": "こらこら！\n押し倒して無いから！"},
        { "location": "501/TALK"  , "narrator": "アーヤ", "text": "あれは逢瀬さんに\n護身術を教えてあげて\nいただけで、逢瀬さんが―"},
        { "location": "503/SEL"   , "narrator": "", "text": "わかった！！"},
        { "location": "504/ACT"   , "narrator": "", "text": "わかった！！"},
        { "location": "507/TALK"  , "narrator": "アーヤ", "text": "え！？\nなにが？"},
        { "location": "508/SEL"   , "narrator": "", "text": "なんで距離を感じるのかだよ"},
        { "location": "509/ACT"   , "narrator": "", "text": "なんで距離を感じるのかだよ"},
        { "location": "511/TALK"  , "narrator": "アーヤ", "text": "え？\nなにかしら？？"},
        { "location": "512/SEL"   , "narrator": "", "text": "逢瀬さんって呼んでるから"},
        { "location": "513/ACT"   , "narrator": "", "text": "逢瀬さんって呼んでるから"},
        { "location": "515/TALK"  , "narrator": "アーヤ", "text": "あ……"},
        { "location": "516/TALK"  , "narrator": "アーヤ", "text": "ああ、それは確かに、\nイメージ的に距離を\n感じるかも。"},
        { "location": "517/SEL"   , "narrator": "", "text": "どうしてギャヴィみたいに名前で呼ばないの？"},
        { "location": "518/ACT"   , "narrator": "", "text": "どうしてギャヴィみたいに名前で呼ばないの？"},
        { "location": "521/TALK"  , "narrator": "アーヤ", "text": "うーん、なんか\nなりゆきっていうか……"},
        { "location": "522/TALK"  , "narrator": "アーヤ", "text": "最初にそう呼んじゃって、\nただそれだけなんだけど。"},
        { "location": "523/TALK"  , "narrator": "アーヤ", "text": "途中で変えるのもなんか\nビックリされそうで、\nちょっと恥ずかしいし。"},
        { "location": "524/SEL"   , "narrator": "", "text": "これから「つばめ」って呼んでみたら？"},
        { "location": "525/ACT"   , "narrator": "", "text": "これから「つばめ」って呼んでみたら？"},
        { "location": "527/TALK"  , "narrator": "アーヤ", "text": "うーん……\n確かにそれで解消しそうな\n気もするわね。"},
        { "location": "528/TALK"  , "narrator": "アーヤ", "text": "やってみるように\n働きかけてみようかしら。"},
        { "location": "529/SEL"   , "narrator": "", "text": "おお、司書が仕事してる！"},
        { "location": "530/ACT"   , "narrator": "", "text": "おお、司書が仕事してる！"},
        { "location": "532/TALK"  , "narrator": "アーヤ", "text": "いつも怠けてる人みたいに\nいわないで。"},
        { "location": "533/TALK"  , "narrator": "アーヤ", "text": "でもね、多分――"},
        { "location": "539/TALK"  , "narrator": "アーヤ", "text": "ね？"},
        { "location": "543/TALK"  , "narrator": "アーヤ", "text": "来ちゃうわけ。\nクランさんが。"},
        { "location": "545/TALK"  , "narrator": "アーヤ", "text": "申し訳無いけど、\nお願いできるかしら？"},
        { "location": "546/SEL"   , "narrator": "", "text": "言い出しっぺだしね"},
        { "location": "547/ACT"   , "narrator": "", "text": "言い出しっぺだしね"},
        { "location": "550/TALK"  , "narrator": "アーヤ", "text": "ありがと。\nホント助かるわ。"},
        { "location": "551/TALK"  , "narrator": "アーヤ", "text": "それじゃ、行くわよ？"},
        { "location": "552/TALK"  , "narrator": "アーヤ", "text": "$handle$さんと\n國政綾水にとって、\n素敵なココロの旅を！"},
        { "location": "22/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>6月20日　0:14 PM</color>\nランチタイム、附属学園学食にて。"},
        { "location": "270/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"}
    ]
}
