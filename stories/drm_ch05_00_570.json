    "entry":
    [
        { "location": "460/SCENARIO", "narrator": "", "text": "そんなに古い話でもないけど"},
        { "location": "485/TALK"    , "narrator": "神楽", "text": "花咲き病患者の話を憶えてる？"},
        { "location": "486/TALK"    , "narrator": "神楽", "text": "体に花が宿るようになる病気の話"},
        { "location": "487/TALK"    , "narrator": "神楽", "text": "それからそれを隠して結局死んでしまった少女の話"},
        { "location": "489/SEL"     , "narrator": "", "text": "フランス映画だっけ"},
        { "location": "490/SEL"     , "narrator": "", "text": "小説にそういうのあったな…"},
        { "location": "491/SEL"     , "narrator": "", "text": "神楽の作った話だね"},
        { "location": "492/ACT"     , "narrator": "", "text": "フランス映画だっけ"},
        { "location": "493/TALK"    , "narrator": "神楽", "text": "あーあるねー"},
        { "location": "494/TALK"    , "narrator": "神楽", "text": "それじゃないから"},
        { "location": "504/ACT"     , "narrator": "", "text": "小説にそういうのあったな…"},
        { "location": "505/TALK"    , "narrator": "神楽", "text": "意外と文学系？"},
        { "location": "506/TALK"    , "narrator": "神楽", "text": "でも残念違うやつ"},
        { "location": "516/ACT"     , "narrator": "", "text": "神楽の作った話だね"},
        { "location": "517/TALK"    , "narrator": "神楽", "text": "そうそれ"},
        { "location": "520/SEL"     , "narrator": "", "text": "次のアルバムに使うの？"},
        { "location": "521/SEL"     , "narrator": "", "text": "映画化でも狙ってる？"},
        { "location": "522/SEL"     , "narrator": "", "text": "話を変えたいのかな？"},
        { "location": "523/ACT"     , "narrator": "", "text": "次のアルバムに使うの？"},
        { "location": "524/TALK"    , "narrator": "神楽", "text": "そういうわけじゃないけど"},
        { "location": "525/ACT"     , "narrator": "", "text": "映画化でも狙ってる？"},
        { "location": "526/TALK"    , "narrator": "神楽", "text": "それいいね！"},
        { "location": "527/TALK"    , "narrator": "神楽", "text": "ぴょんこは原作者にしてメインヒロイン"},
        { "location": "528/TALK"    , "narrator": "神楽", "text": "ってこの話前もした？？？"},
        { "location": "529/ACT"     , "narrator": "", "text": "話を変えたいのかな？"},
        { "location": "530/TALK"    , "narrator": "神楽", "text": "そういうことになるのかな"},
        { "location": "531/TALK"    , "narrator": "神楽", "text": "どうだろう"},
        { "location": "533/TALK"    , "narrator": "神楽", "text": "ぴょんこが設定した主人公は"},
        { "location": "534/TALK"    , "narrator": "神楽", "text": "結構スクールカーストの上位にいる子で"},
        { "location": "535/TALK"    , "narrator": "神楽", "text": "先生の評判もいい子なんだぴょん"},
        { "location": "537/SEL"     , "narrator": "", "text": "ちょっと苦手なタイプ…"},
        { "location": "538/SEL"     , "narrator": "", "text": "$me$みたいだね！"},
        { "location": "539/SEL"     , "narrator": "", "text": "フランスにもスクールカーストってあるんだ…"},
        { "location": "540/ACT"     , "narrator": "", "text": "ちょっと苦手なタイプ…"},
        { "location": "542/TALK"    , "narrator": "神楽", "text": "じゃあこの話おしまい！"},
        { "location": "552/ACT"     , "narrator": "", "text": "$me$みたいだね！"},
        { "location": "553/TALK"    , "narrator": "神楽", "text": "おっとー"},
        { "location": "555/TALK"    , "narrator": "神楽", "text": "すごい自信だね$handle$"},
        { "location": "556/TALK"    , "narrator": "神楽", "text": "なんてね"},
        { "location": "557/TALK"    , "narrator": "神楽", "text": "そういうのぴょんこは嫌いじゃない♪"},
        { "location": "558/TALK"    , "narrator": "神楽", "text": "生きていくのに自信って絶対必要だし"},
        { "location": "559/ACT"     , "narrator": "", "text": "フランスにもスクールカーストってあるんだ…"},
        { "location": "560/TALK"    , "narrator": "神楽", "text": "それはね？"},
        { "location": "562/TALK"    , "narrator": "神楽", "text": "当たり前にあるでしょ～"},
        { "location": "563/TALK"    , "narrator": "神楽", "text": "学生ってそういうの気にするし"},
        { "location": "564/TALK"    , "narrator": "神楽", "text": "特に女子ならなおさら"},
        { "location": "566/TALK"    , "narrator": "神楽", "text": "いい子だからこそ"},
        { "location": "567/TALK"    , "narrator": "神楽", "text": "自分の病を誰にも打ち明けることができなくて"},
        { "location": "568/TALK"    , "narrator": "神楽", "text": "周りが病気に気づいたころにはもう手遅れだった"},
        { "location": "570/SEL"     , "narrator": "", "text": "あり得る話だ"},
        { "location": "571/SEL"     , "narrator": "", "text": "無理してたんだね"},
        { "location": "572/SEL"     , "narrator": "", "text": "神楽は大丈夫？"},
        { "location": "573/ACT"     , "narrator": "", "text": "あり得る話だ"},
        { "location": "574/TALK"    , "narrator": "神楽", "text": "そうでしょ"},
        { "location": "575/TALK"    , "narrator": "神楽", "text": "抱え込んじゃう子だったら"},
        { "location": "576/TALK"    , "narrator": "神楽", "text": "あり得る話だ"},
        { "location": "586/ACT"     , "narrator": "", "text": "無理してたんだね"},
        { "location": "587/TALK"    , "narrator": "神楽", "text": "そうかもね"},
        { "location": "588/TALK"    , "narrator": "神楽", "text": "いい子で居ることとか"},
        { "location": "589/TALK"    , "narrator": "神楽", "text": "病気を隠してたこととかね"},
        { "location": "599/ACT"     , "narrator": "", "text": "神楽は大丈夫？"},
        { "location": "602/TALK"    , "narrator": "神楽", "text": "ぴょんこのどこが心配？"},
        { "location": "604/SEL"     , "narrator": "", "text": "ちゃんとご飯食べてる？"},
        { "location": "605/SEL"     , "narrator": "", "text": "よく眠れてる？"},
        { "location": "606/SEL"     , "narrator": "", "text": "体内で植物育ててない？"},
        { "location": "607/ACT"     , "narrator": "", "text": "ちゃんとご飯食べてる？"},
        { "location": "608/TALK"    , "narrator": "神楽", "text": "一応ね"},
        { "location": "610/TALK"    , "narrator": "神楽", "text": "カロリー計算とかしてるし♪"},
        { "location": "611/ACT"     , "narrator": "", "text": "よく眠れてる？"},
        { "location": "612/TALK"    , "narrator": "神楽", "text": "創作してると目が冴えて遅くまで起きてることもあるぴょん"},
        { "location": "613/ACT"     , "narrator": "", "text": "体内で植物育ててない？"},
        { "location": "614/TALK"    , "narrator": "神楽", "text": "えっ怖っ"},
        { "location": "615/TALK"    , "narrator": "神楽", "text": "ってそういう話だったね花咲き病"},
        { "location": "618/TALK"    , "narrator": "神楽", "text": "真面目な話"},
        { "location": "619/TALK"    , "narrator": "神楽", "text": "大丈夫って答える方が不安じゃない？？？"},
        { "location": "620/TALK"    , "narrator": "神楽", "text": "ぴょんこの今の環境って"},
        { "location": "622/SEL"     , "narrator": "", "text": "そうなんだよね…"},
        { "location": "623/SEL"     , "narrator": "", "text": "だから心配してるんだって！"},
        { "location": "624/SEL"     , "narrator": "", "text": "自覚があるならまだましかもね"},
        { "location": "625/ACT"     , "narrator": "", "text": "そうなんだよね…"},
        { "location": "626/TALK"    , "narrator": "神楽", "text": "でしょ！"},
        { "location": "627/TALK"    , "narrator": "神楽", "text": "今さら！"},
        { "location": "628/ACT"     , "narrator": "", "text": "だから心配してるんだって！"},
        { "location": "629/TALK"    , "narrator": "神楽", "text": "うん"},
        { "location": "630/TALK"    , "narrator": "神楽", "text": "ｱﾘｶﾞﾄ、、、"},
        { "location": "631/ACT"     , "narrator": "", "text": "自覚があるならまだましかもね"},
        { "location": "632/TALK"    , "narrator": "神楽", "text": "ましって比較対象おかしいし"},
