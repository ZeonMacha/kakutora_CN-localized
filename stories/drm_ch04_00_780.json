    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "680_緩衝地帯から"},
        { "location": "31/TALK"   , "narrator": "みやび", "text": "長い間待たせたぞね"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "うちは様々な調査を行っていたぞね"},
        { "location": "33/TALK"   , "narrator": "みやび", "text": "世界の深淵に関わり、根幹を揺るがす調査ぞね"},
        { "location": "34/TALK"   , "narrator": "みやび", "text": "というのは冗談だ。"},
        { "location": "35/TALK"   , "narrator": "みやび", "text": "が"},
        { "location": "36/TALK"   , "narrator": "みやび", "text": "それに近い何かを掴んだと$handle$に報告しようぞ"},
        { "location": "38/SEL"    , "narrator": "", "text": "嫌われたと思ってた"},
        { "location": "39/ACT"    , "narrator": "", "text": "嫌われたと思ってた"},
        { "location": "42/TALK"   , "narrator": "みやび", "text": "それは"},
        { "location": "44/TALK"   , "narrator": "みやび", "text": "違うぞね"},
        { "location": "46/SEL"    , "narrator": "", "text": "いなくなった理由を教えて"},
        { "location": "47/SEL"    , "narrator": "", "text": "さみしくて仕方なかった"},
        { "location": "48/ACT"    , "narrator": "", "text": "いなくなった理由を教えて"},
        { "location": "50/TALK"   , "narrator": "みやび", "text": "それも"},
        { "location": "51/TALK"   , "narrator": "みやび", "text": "話さねばならぬの"},
        { "location": "52/TALK"   , "narrator": "みやび", "text": "そのうちに"},
        { "location": "61/ACT"    , "narrator": "", "text": "さみしくて仕方なかった"},
        { "location": "62/TALK"   , "narrator": "みやび", "text": "実はうちもそうだったぞね"},
        { "location": "64/SEL"    , "narrator": "", "text": "じゃあなんで"},
        { "location": "65/SEL"    , "narrator": "", "text": "本当に？"},
        { "location": "66/SEL"    , "narrator": "", "text": "そう思っててくれたんだ"},
        { "location": "67/ACT"    , "narrator": "", "text": "じゃあなんで"},
        { "location": "69/TALK"   , "narrator": "みやび", "text": "なんでかな"},
        { "location": "72/TALK"   , "narrator": "みやび", "text": "自分でもわからんぞね"},
        { "location": "73/ACT"    , "narrator": "", "text": "本当に？"},
        { "location": "74/TALK"   , "narrator": "みやび", "text": "ほんとうぞね"},
        { "location": "77/TALK"   , "narrator": "みやび", "text": "この気持ちが本物なら"},
        { "location": "78/ACT"    , "narrator": "", "text": "そう思っててくれたんだ"},
        { "location": "79/TALK"   , "narrator": "みやび", "text": "当たり前ぞね"},
        { "location": "80/TALK"   , "narrator": "みやび", "text": "そんなもん"},
        { "location": "81/TALK"   , "narrator": "みやび", "text": "ばかちんが"},
        { "location": "83/TALK"   , "narrator": "みやび", "text": "さっき"},
        { "location": "84/TALK"   , "narrator": "みやび", "text": "調査で何かを掴んだち言うたが"},
        { "location": "85/TALK"   , "narrator": "みやび", "text": "こうやって話していると"},
        { "location": "87/TALK"   , "narrator": "みやび", "text": "自信がなくなってくる"},
        { "location": "89/SEL"    , "narrator": "", "text": "ごめん、意味がわからない"},
        { "location": "90/SEL"    , "narrator": "", "text": "みやびはみやびだよ"},
        { "location": "91/ACT"    , "narrator": "", "text": "ごめん、意味がわからない"},
        { "location": "92/TALK"   , "narrator": "みやび", "text": "そうだろうな"},
        { "location": "93/TALK"   , "narrator": "みやび", "text": "自分でも"},
        { "location": "94/TALK"   , "narrator": "みやび", "text": "わからんぞね"},
        { "location": "103/ACT"   , "narrator": "", "text": "みやびはみやびだよ"},
        { "location": "105/TALK"  , "narrator": "みやび", "text": "そう"},
        { "location": "106/TALK"  , "narrator": "みやび", "text": "言ってくれるのはありがたい"},
        { "location": "108/TALK"  , "narrator": "みやび", "text": "しかしうちは"},
        { "location": "109/TALK"  , "narrator": "みやび", "text": "$handle$が$handle$だと"},
        { "location": "110/TALK"  , "narrator": "みやび", "text": "うれしいが"},
        { "location": "113/TALK"  , "narrator": "みやび", "text": "困るのだ"},
        { "location": "115/SEL"   , "narrator": "", "text": "困らなくていいよ"},
        { "location": "116/SEL"   , "narrator": "", "text": "それでいいんだよ"},
        { "location": "117/ACT"   , "narrator": "", "text": "困らなくていいよ"},
        { "location": "118/TALK"  , "narrator": "みやび", "text": "そうなんだろうな"},
        { "location": "119/TALK"  , "narrator": "みやび", "text": "普通は"},
        { "location": "128/ACT"   , "narrator": "", "text": "それでいいんだよ"},
        { "location": "130/TALK"  , "narrator": "みやび", "text": "端的に自分の状態を説明できぬ"},
        { "location": "132/TALK"  , "narrator": "みやび", "text": "そんなのでいいと言うのか"},
        { "location": "134/SEL"   , "narrator": "", "text": "いいよ"},
        { "location": "135/SEL"   , "narrator": "", "text": "それで普通だから"},
        { "location": "136/ACT"   , "narrator": "", "text": "いいよ"},
        { "location": "137/TALK"  , "narrator": "みやび", "text": "そうか"},
        { "location": "138/TALK"  , "narrator": "みやび", "text": "$handle$のくせに"},
        { "location": "139/TALK"  , "narrator": "みやび", "text": "格好いいではないか"},
        { "location": "140/ACT"   , "narrator": "", "text": "それで普通だから"},
        { "location": "141/TALK"  , "narrator": "みやび", "text": "そうか"},
        { "location": "142/TALK"  , "narrator": "みやび", "text": "普通か"},
        { "location": "143/TALK"  , "narrator": "みやび", "text": "そういうものか"}
