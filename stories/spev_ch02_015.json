    "entry":
    [
        { "location": "21/TALK" , "narrator": "透明アーヤ", "text": "さて、らんちゅうさん。\nこれをかき混ぜて\nもらえる？"},
        { "location": "22/TALK" , "narrator": "透明らんちゅうさん", "text": "わ、わかったよ～…。"},
        { "location": "24/TALK" , "narrator": "透明アーヤ", "text": "って、まだそっちの\n作業が\n終わってなかったのね…。"},
        { "location": "25/TALK" , "narrator": "透明らんちゅうさん", "text": "ごめんなさい…。\n私、ゆっくり\nしすぎてて…。"},
        { "location": "27/TALK" , "narrator": "透明アーヤ", "text": "ううん、大丈夫よ。\n慌てないで\nゆっくりやってね。"},
        { "location": "28/SEL"  , "narrator": "（選択肢）", "text": "らんちゅうさんとチョコ作り？"},
        { "location": "29/ACT"  , "narrator": "", "text": "らんちゅうさんとチョコ作り？"},
        { "location": "32/TALK" , "narrator": "アーヤ", "text": "ええ、そうなの"},
        { "location": "33/TALK" , "narrator": "アーヤ", "text": "らんちゅうさんもチョコを作ってみたかったみたい(^^"},
        { "location": "34/TALK" , "narrator": "アーヤ", "text": "慣れないみたいだけど頑張ってくれてるわ"},
        { "location": "35/TALK" , "narrator": "アーヤ", "text": "そういえば"},
        { "location": "36/TALK" , "narrator": "アーヤ", "text": "$handle$にも聞いておかなくちゃ"},
        { "location": "37/SEL"  , "narrator": "（選択肢）", "text": "なにを聞きたいの？"},
        { "location": "38/ACT"  , "narrator": "", "text": "なにを聞きたいの？"},
        { "location": "40/TALK" , "narrator": "アーヤ", "text": "チョコが好きかどうかよ( ・_・)σﾞ"},
        { "location": "41/TALK" , "narrator": "アーヤ", "text": "もしかして嫌いだった？"},
        { "location": "42/SEL"  , "narrator": "（選択肢）", "text": "大好きだよ！"},
        { "location": "43/SEL"  , "narrator": "（選択肢）", "text": "甘過ぎないのがいいな"},
        { "location": "44/SEL"  , "narrator": "（選択肢）", "text": "ビターなのが好き"},
        { "location": "45/ACT"  , "narrator": "", "text": "大好きだよ！"},
        { "location": "47/TALK" , "narrator": "アーヤ", "text": "よかった(*^^*)"},
        { "location": "49/TALK" , "narrator": "アーヤ", "text": "それなら大丈夫ね"},
        { "location": "50/ACT"  , "narrator": "", "text": "甘過ぎないのがいいな"},
        { "location": "52/TALK" , "narrator": "アーヤ", "text": "甘過ぎるのは嫌い？"},
        { "location": "53/TALK" , "narrator": "アーヤ", "text": "それじゃ甘さ控えめにするわ(￣∇￣)"},
        { "location": "54/ACT"  , "narrator": "", "text": "ビターなのが好き"},
        { "location": "56/TALK" , "narrator": "アーヤ", "text": "そうだったの？"},
        { "location": "57/TALK" , "narrator": "アーヤ", "text": "ビター系も美味しいわよね"},
        { "location": "58/TALK" , "narrator": "アーヤ", "text": "それじゃちょっと大人な感じにするわ(*^^*)"},
        { "location": "60/TALK" , "narrator": "アーヤ", "text": "でもバレンタインに手作りチョコなんて"},
        { "location": "61/TALK" , "narrator": "アーヤ", "text": "今まで作ったことないから"},
        { "location": "62/TALK" , "narrator": "アーヤ", "text": "上手くできるかしら？"},
        { "location": "63/SEL"  , "narrator": "（選択肢）", "text": "そうだったの？"},
        { "location": "64/SEL"  , "narrator": "（選択肢）", "text": "料理上手だから大丈夫だよ"},
        { "location": "65/ACT"  , "narrator": "", "text": "そうだったの？"},
        { "location": "67/TALK" , "narrator": "アーヤ", "text": "知ってるでしょ？"},
        { "location": "69/TALK" , "narrator": "アーヤ", "text": "剣道一筋だったから(>_<)"},
        { "location": "70/TALK" , "narrator": "アーヤ", "text": "作ってプレゼントするなんてしたことないわ"},
        { "location": "71/ACT"  , "narrator": "", "text": "料理上手だから大丈夫だよ"},
        { "location": "73/TALK" , "narrator": "アーヤ", "text": "ありがとう(^^"},
        { "location": "75/TALK" , "narrator": "アーヤ", "text": "作り慣れないモノだから"},
        { "location": "76/TALK" , "narrator": "アーヤ", "text": "ちょっとだけ不安だけど"},
        { "location": "77/TALK" , "narrator": "アーヤ", "text": "期待に応えるため頑張るわ(^ε^)-☆!!"},
        { "location": "80/TALK" , "narrator": "透明アーヤ", "text": "さて、と…。"},
        { "location": "81/TALK" , "narrator": "透明らんちゅうさん", "text": "お、お待たせ。\n次はなにをすれば\nいいの？"},
        { "location": "82/TALK" , "narrator": "透明アーヤ", "text": "ああ、らんちゅうさん。\nそっちのは終わった？"},
        { "location": "83/TALK" , "narrator": "透明らんちゅうさん", "text": "う、うん…。\n急いだけど、\n遅くなっちゃった…。"},
        { "location": "84/TALK" , "narrator": "透明アーヤ", "text": "大丈夫よ。\n自分のペースで\nやってくれたらいいから。"},
        { "location": "85/TALK" , "narrator": "透明アーヤ", "text": "ムリに慌てないで、\n楽しく作りましょ。"},
        { "location": "86/TALK" , "narrator": "透明らんちゅうさん", "text": "…うん。\nありがとう。"},
        { "location": "87/TALK" , "narrator": "透明アーヤ", "text": "それじゃあ、\n次はこっちの作業を\nお願いね。"},
        { "location": "88/TALK" , "narrator": "透明らんちゅうさん", "text": "わかったよ～♪"},
        { "location": "91/TALK" , "narrator": "透明アーヤ", "text": "…ふふっ。"},
        { "location": "93/SEL"  , "narrator": "（選択肢）", "text": "アーヤ、面倒見がいいね"},
        { "location": "94/SEL"  , "narrator": "（選択肢）", "text": "らんちゅうさん、可愛いね"},
        { "location": "95/ACT"  , "narrator": "", "text": "アーヤ、面倒見がいいね"},
        { "location": "97/TALK" , "narrator": "アーヤ", "text": "そう？"},
        { "location": "98/TALK" , "narrator": "アーヤ", "text": "らんちゅうさんが可愛いから"},
        { "location": "99/TALK" , "narrator": "アーヤ", "text": "放っておけないのかも(￣∇￣*)ゞ"},
        { "location": "100/SEL" , "narrator": "（選択肢）", "text": "アーヤだって可愛いよ"},
        { "location": "101/SEL" , "narrator": "（選択肢）", "text": "気持ちはわからなくもない"},
        { "location": "102/ACT" , "narrator": "", "text": "アーヤだって可愛いよ"},
        { "location": "103/TALK", "narrator": "アーヤ", "text": "ありがとう(^^"},
        { "location": "104/TALK", "narrator": "アーヤ", "text": "$handle$に言われると嬉しいわ"},
        { "location": "105/TALK", "narrator": "アーヤ", "text": "ちょっと恥ずかしいけど"},
        { "location": "106/ACT" , "narrator": "", "text": "気持ちはわからなくもない"},
        { "location": "107/TALK", "narrator": "アーヤ", "text": "$handle$もそう思う？"},
        { "location": "108/TALK", "narrator": "アーヤ", "text": "でもこっちの作業も止まっちゃうから"},
        { "location": "109/TALK", "narrator": "アーヤ", "text": "ほどほどにしないと(*ﾉ∀`*) "},
        { "location": "111/ACT" , "narrator": "", "text": "らんちゅうさん、可愛いね"},
        { "location": "113/TALK", "narrator": "アーヤ", "text": "そうね"},
        { "location": "115/TALK", "narrator": "アーヤ", "text": "だから私もつい構っちゃうのかも"},
        { "location": "116/TALK", "narrator": "アーヤ", "text": "でも"},
        { "location": "117/TALK", "narrator": "アーヤ", "text": "ちょっとヤキモチ焼いちゃうかも( ・_・)σﾞ"},
        { "location": "118/SEL" , "narrator": "（選択肢）", "text": "アーヤだって可愛いよ　"},
        { "location": "119/SEL" , "narrator": "（選択肢）", "text": "ヤキモチ焼いてるアーヤ、可愛い"},
        { "location": "120/ACT" , "narrator": "", "text": "アーヤだって可愛いよ　"},
        { "location": "121/TALK", "narrator": "アーヤ", "text": "付け足した感が凄いんだけど？(-ω-;)"},
        { "location": "122/TALK", "narrator": "アーヤ", "text": "なんてね"},
        { "location": "123/TALK", "narrator": "アーヤ", "text": "そう言ってもらえて嬉しいわ(^^"},
        { "location": "124/ACT" , "narrator": "", "text": "ヤキモチ焼いてるアーヤ、可愛い"},
        { "location": "125/TALK", "narrator": "アーヤ", "text": "恥ずかしいから！(>_<)"},
        { "location": "127/TALK", "narrator": "アーヤ", "text": "料理集中できなくなって"},
        { "location": "128/TALK", "narrator": "アーヤ", "text": "チョコ失敗したら大変でしょ？"},
        { "location": "129/TALK", "narrator": "アーヤ", "text": "まったく(-.-;)"},
        { "location": "130/TALK", "narrator": "アーヤ", "text": "まぁ"},
        { "location": "131/TALK", "narrator": "アーヤ", "text": "嬉しかったけど(・・。)ゞ"},
        { "location": "134/TALK", "narrator": "アーヤ", "text": "チョコ楽しみにしててね(^з^)-☆"}
    ]
