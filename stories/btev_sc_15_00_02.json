{
    "dir": "chap00/battle/btev_sc_15_00_02.js",
    "type": "",
    "info": {
        "story_id": "155",
        "cid": "",
        "title": "【EXストーリー】マジマジ魔法少女",
        "sub_title": "シンクロストーリー"
    },
    "entry":
    [
        { "location": "189/SCENARIO", "narrator": "", "text": "【結果】スウィーティーメルティ♪"},
        { "location": "205/TALK"    , "narrator": "神楽", "text": "お帰りなさいませ。\nよい旅でしたか？"},
        { "location": "206/TALK"    , "narrator": "神楽", "text": "$handle$さまが\n頑張ってくれたお陰で\n『コネクト』は完了です。"},
        { "location": "207/TALK"    , "narrator": "神楽", "text": "めるちゃんの\nココロの中の\n抵抗は消えました。"},
        { "location": "208/TALK"    , "narrator": "神楽", "text": "$handle$さまと\n繋がる準備が\nできたのです。"},
        { "location": "209/SEL"     , "narrator": "（選択肢）", "text": "次が『シンクロ』だよね"},
        { "location": "210/ACT"     , "narrator": "", "text": "次が『シンクロ』だよね"},
        { "location": "212/TALK"    , "narrator": "神楽", "text": "そうです！\nご名答！"},
        { "location": "213/TALK"    , "narrator": "神楽", "text": "シンクロをすると、\nめるちゃんの想いが\n流れ込みます。"},
        { "location": "214/TALK"    , "narrator": "神楽", "text": "$handle$さまは、\nどうかそれを受け入れて\nあげてくださいませ。"},
        { "location": "215/TALK"    , "narrator": "神楽", "text": "準備はいかがですか？"},
        { "location": "216/SEL"     , "narrator": "（選択肢）", "text": "できた"},
        { "location": "217/SEL"     , "narrator": "（選択肢）", "text": "まだ"},
        { "location": "218/ACT"     , "narrator": "", "text": "できた"},
        { "location": "219/TALK"    , "narrator": "神楽", "text": "承知しました。\nそれではココロを\n繋げます。"},
        { "location": "220/ACT"     , "narrator": "", "text": "まだ"},
        { "location": "222/TALK"    , "narrator": "神楽", "text": "まだ、ですか…。"},
        { "location": "223/TALK"    , "narrator": "神楽", "text": "それでは一旦ここで\nお別れですね。"},
        { "location": "224/TALK"    , "narrator": "神楽", "text": "準備ができたら\nお戻りください。"},
        { "location": "232/TALK"    , "narrator": "神楽", "text": "EXEC_SYNC_SPHERE/."},
        { "location": "245/DIALOG"  , "narrator": "", "text": "おかあさん、またきっと会えるよね……？"},
        { "location": "252/DIALOG"  , "narrator": "", "text": "クランイラスト先読み"},
        { "location": "263/DIALOG"  , "narrator": "", "text": "二階堂める（にかいどうめる）。７歳女児。目黒区自由が丘在住。\n\n父親が開業医という、ある意味恵まれた環境に生まれ、親の愛を目一杯受けて育つ。\n母親も地域のリーダーとして活躍し、家を留守にする事が多く、幼少期はベビーシッターと過ごすことが多かった。そのため、彼女の心の友はいつだってテレビだった。"},
        { "location": "264/DIALOG"  , "narrator": "", "text": "すなわちめるは、とてもおませさんに育っていったのである。その為口調は、同年代の女児に比べると非常に大人びており、それ故に浮いてもいたが、彼女自身が非常に面倒見が良い子だったこともあり、同時に人気者でもあった。"},
        { "location": "265/DIALOG"  , "narrator": "", "text": "そんな幸せな日々に、一つの大きな不幸が訪れる。大好きだった母親が交通事故で死亡してしまったのである。父親とは殆ど一緒に過ごしたことのないめるは、完全に孤立してしまったのだ。\n\nまだ幼い彼女は、まだ「死」というものをハッキリと理解することができない。火葬場でエレベーターのような扉の焼却室に入っていった母親は、見えないエレベータで天国へ向かい、またいずれ下りてくるだろうと考えていたのだ。"},
        { "location": "270/DIALOG"  , "narrator": "", "text": "だがその日は一向に訪れない。お空の国へ出かけていったお母さんに会いたい…。その想いは日に日に募り、ある夜その想いは爆発し、めるは母親のいない寂しさに号泣してしまった。"},
        { "location": "271/DIALOG"  , "narrator": "", "text": "そんな時、満月の見える窓辺に喋る猫が現れ、めるに１つのペンダントをくれたのだ。それを月にかざすことで、めるは魔法少女スウィーティーメルティに変身することができるようになったのである。"},
        { "location": "276/DIALOG"  , "narrator": "", "text": "魔法の箒でお母さんのいる天国へ向かうめる。だがその道すがらには、沢山の魔女たちが待ち構えていたのであった。"},
        { "location": "277/DIALOG"  , "narrator": "", "text": "当然、猫が出てきた段階で既に発症している。彼女のフェノメノンは、母親の住む天国へ行きたいという想いと、それは叶わないという想いが、魔法少女と魔女という相反するものを生み出したのである。"},
        { "location": "294/TALK"    , "narrator": "神楽", "text": "これがめるちゃんの\n想いです。"},
        { "location": "295/SEL"     , "narrator": "（選択肢）", "text": "人生って理不尽だよね"},
        { "location": "296/SEL"     , "narrator": "（選択肢）", "text": "強くはなれなかったんだ"},
        { "location": "297/SEL"     , "narrator": "（選択肢）", "text": "魔法少女萌えー！"},
        { "location": "298/ACT"     , "narrator": "", "text": "人生って理不尽だよね"},
        { "location": "299/TALK"    , "narrator": "神楽", "text": "そうですね。\n私もそう思いました。"},
        { "location": "300/ACT"     , "narrator": "", "text": "強くはなれなかったんだ"},
        { "location": "301/TALK"    , "narrator": "神楽", "text": "…………。"},
        { "location": "303/TALK"    , "narrator": "神楽", "text": "だってまだ、\n７歳だったん\nですよ…？"},
        { "location": "304/ACT"     , "narrator": "", "text": "魔法少女萌えー！"},
        { "location": "305/TALK"    , "narrator": "神楽", "text": "ある意味素直な\n感想ですね。\nいっそ清々しいです。"},
        { "location": "307/TALK"    , "narrator": "神楽", "text": "魔法少女は\nやはり少女で\nあるべきです。"},
        { "location": "308/TALK"    , "narrator": "神楽", "text": "ステッキのセンスも\n衣装のセンスも\nめるちゃんは最高です。"},
        { "location": "309/TALK"    , "narrator": "神楽", "text": "…でも本当は\nそれだけじゃ\nないんです。"},
        { "location": "310/TALK"    , "narrator": "神楽", "text": "お母さんに\n愛されたい。\n抱きしめて欲しい。"},
        { "location": "311/TALK"    , "narrator": "神楽", "text": "甘えたい。\nわがままを言いたい。\n頭を撫でて欲しい。"},
        { "location": "312/TALK"    , "narrator": "神楽", "text": "その単純で切実な\nお母さんを慕う心。"},
        { "location": "313/TALK"    , "narrator": "神楽", "text": "なんだか似てるね、と\nめるちゃんに\n言われてしまいました。"},
        { "location": "314/TALK"    , "narrator": "神楽", "text": "そんなところも含めて\nめるちゃんと私は\n仲良しになったんです。"},
        { "location": "315/SEL"     , "narrator": "（選択肢）", "text": "へー"},
        { "location": "316/SEL"     , "narrator": "（選択肢）", "text": "$me$にも甘えていいよ"},
        { "location": "317/ACT"     , "narrator": "", "text": "へー"},
        { "location": "318/ACT"     , "narrator": "", "text": "$me$にも甘えていいよ"},
        { "location": "319/TALK"    , "narrator": "神楽", "text": "…それは遠慮\nしておきますね…。"},
        { "location": "321/TALK"    , "narrator": "神楽", "text": "さて。"},
        { "location": "322/TALK"    , "narrator": "神楽", "text": "今日からめるちゃんと\n$handle$さまは\nつながりました。"},
        { "location": "323/TALK"    , "narrator": "神楽", "text": "めるちゃんをどうぞ\nかわいがって\nやってくださいね。"},
        { "location": "324/SEL"     , "narrator": "（選択肢）", "text": "もちろん"},
        { "location": "325/SEL"     , "narrator": "（選択肢）", "text": "どうかな"},
        { "location": "326/ACT"     , "narrator": "", "text": "もちろん"},
        { "location": "327/TALK"    , "narrator": "神楽", "text": "少し寂しがり屋ですが\nとてもいい子です。"},
        { "location": "328/ACT"     , "narrator": "", "text": "どうかな"},
        { "location": "329/TALK"    , "narrator": "神楽", "text": "そんなこと言ってたら\nめるちゃんに\nやり込められますよ？"},
        { "location": "331/TALK"    , "narrator": "神楽", "text": "どうかこれからも\nよろしくお願い\nいたします。"},
        { "location": "333/TALK"    , "narrator": "神楽", "text": "では今回は\nこれで失礼いたします。"}
    ]
}
