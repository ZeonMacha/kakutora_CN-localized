        { "location": "2485/TALK", "narrator": "プレイヤー", "text": "お着替えしてみよう"},
        { "location": "2487/TALK", "narrator": "プレイヤー", "text": "違う服を着てほしいな"},
        { "location": "2489/TALK", "narrator": "プレイヤー", "text": "よし、お着替えタイムだ！"},
        { "location": "2495/TALK", "narrator": "プレイヤー", "text": "やあ"},
        { "location": "2497/TALK", "narrator": "プレイヤー", "text": "こんにちは"},
        { "location": "2499/TALK", "narrator": "プレイヤー", "text": "げんき？"},
        { "location": "2502/TALK", "narrator": "神楽", "text": "ぴょんこを呼ぶ声"},
        { "location": "2503/TALK", "narrator": "神楽", "text": "あなたはだあれ？"},
        { "location": "2505/SEL" , "narrator": "", "text": "$handle$だよ"},
        { "location": "2506/ACT" , "narrator": "", "text": "$handle$だよ"},
        { "location": "2508/TALK", "narrator": "神楽", "text": "知ってるし"},
        { "location": "2509/TALK", "narrator": "神楽", "text": "ぴょんこに用事ぴょん？"},
        { "location": "2512/SEL" , "narrator": "", "text": "ちょっと着替えてほしいんだ"},
        { "location": "2513/ACT" , "narrator": "", "text": "ちょっと着替えてほしいんだ"},
        { "location": "2523/TALK", "narrator": "神楽", "text": "意味不明すぎ"},
        { "location": "2524/TALK", "narrator": "神楽", "text": "でもまあ"},
        { "location": "2525/TALK", "narrator": "神楽", "text": "優しいぴょんこは聞いてあげるのだった"},
        { "location": "2527/TALK", "narrator": "神楽", "text": "は？"},
        { "location": "2528/TALK", "narrator": "神楽", "text": "この服変だった？"},
        { "location": "2529/TALK", "narrator": "神楽", "text": "なら着替えるけど"},
        { "location": "2532/SEL" , "narrator": "", "text": "$me$が選ぶ"},
        { "location": "2533/SEL" , "narrator": "", "text": "やっぱやめる"},
        { "location": "2535/TALK", "narrator": "神楽", "text": "…………"},
        { "location": "2538/TALK", "narrator": "神楽", "text": "リクエストないとか？"},
        { "location": "2539/TALK", "narrator": "神楽", "text": "なら着ない"},
        { "location": "2541/ACT" , "narrator": "", "text": "$me$が選ぶ"},
        { "location": "2542/TALK", "narrator": "神楽", "text": "だと思った"},
        { "location": "2543/TALK", "narrator": "神楽", "text": "どれを着てほしいと？"},
        { "location": "2550/ACT" , "narrator": "", "text": "やっぱやめる"},
        { "location": "2551/TALK", "narrator": "神楽", "text": "ありえネー"}
    ]
