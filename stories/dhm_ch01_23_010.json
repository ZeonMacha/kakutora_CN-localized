        { "location": "49/TALK"   , "narrator": "つばめ", "text": "どうにかなったかな？"},
        { "location": "52/SEL"    , "narrator": "", "text": "そんなことはない"},
        { "location": "53/SEL"    , "narrator": "", "text": "無理だよ"},
        { "location": "54/SEL"    , "narrator": "", "text": "どうだったんだろうね"},
