        { "location": "56/TALK"   , "narrator": "つばめ", "text": "そっかな。。。"},
        { "location": "57/ACT"    , "narrator": "", "text": "無理だよ"},
        { "location": "58/TALK"   , "narrator": "つばめ", "text": "でもってやっぱり"},
        { "location": "59/TALK"   , "narrator": "つばめ", "text": "思っちゃうよ"},
        { "location": "60/ACT"    , "narrator": "", "text": "どうだったんだろうね"},
        { "location": "61/TALK"   , "narrator": "つばめ", "text": "わかんなぃょね"},
        { "location": "63/TALK"   , "narrator": "つばめ", "text": "でも"},
