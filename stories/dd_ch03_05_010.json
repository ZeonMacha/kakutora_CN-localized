{
    "dir": "chap05/daydra/dd_ch03_05_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "5352",
        "cid": "gabriella",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "テストの結果"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "テストの結果"},
        { "location": "19/TALK"   , "narrator": "みやび", "text": "しっかし、\nガブちゃんは\nまっこと頭がえいね。"},
        { "location": "22/TALK"   , "narrator": "ガブリエラ", "text": "小テストで\n満点取ったくらいで\n大げさよ。"},
        { "location": "24/TALK"   , "narrator": "ガブリエラ", "text": "中間や期末と違って\n出題範囲も狭いんだし。"},
        { "location": "26/TALK"   , "narrator": "みやび", "text": "けんど、満点なんて\nそう簡単に取れる\nもんやないがよ。"},
        { "location": "29/TALK"   , "narrator": "ガブリエラ", "text": "っていうか、あたしは\nとっくに中学レベルの\n勉強は済ませてあるの。"},
        { "location": "30/TALK"   , "narrator": "ガブリエラ", "text": "だからこれは当然の\n結果。いちいち喜んで\nられないわ。"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "はぁ…\n冷めちゅうなぁ…。"},
        { "location": "33/TALK"   , "narrator": "みやび", "text": "例えそうやとしても、\n１００点取ったことには\n変わりないんやし――"},
        { "location": "34/TALK"   , "narrator": "みやび", "text": "そのことを喜ぶんは、\n何もおかしくはないと\n思うがよ？"},
        { "location": "35/SEL"    , "narrator": "", "text": "嫌な人に思われちゃうよ？"},
        { "location": "36/SEL"    , "narrator": "", "text": "喜ばなきゃ変だよ"},
        { "location": "37/SEL"    , "narrator": "", "text": "$me$が代わりに喜ぶよ"},
        { "location": "40/TALK"   , "narrator": "ガブリエラ", "text": "そう言われても…。"},
        { "location": "41/TALK"   , "narrator": "みやび", "text": "まあ、無理に喜べとは\n言わんき――"},
        { "location": "42/TALK"   , "narrator": "みやび", "text": "そこまで深く考えること\nないがよ。"},
        { "location": "45/TALK"   , "narrator": "みやび", "text": "やけんど、あんまし\n喜ばんでいるんも――"},
        { "location": "46/TALK"   , "narrator": "みやび", "text": "せっかくの可愛さが\n台無しになって\n勿体無いがよ。"},
        { "location": "48/TALK"   , "narrator": "ガブリエラ", "text": "うっ……。"},
        { "location": "50/TALK"   , "narrator": "ガブリエラ", "text": "…べ、別に！\nそういうの\n気にしないし。"},
        { "location": "51/TALK"   , "narrator": "みやび", "text": "ちっくと気にした方が\nえいと思うけんど…。"},
        { "location": "52/TALK"   , "narrator": "みやび", "text": "まあ、その方が\nガブちゃんらしくは\nあるな。"},
        { "location": "54/ACT"    , "narrator": "", "text": "嫌な人に思われちゃうよ？"},
        { "location": "82/TALK"   , "narrator": "ガブリエラ", "text": "それは嫌かも…"},
        { "location": "95/TALK"   , "narrator": "ガブリエラ", "text": "マルザンナの言う\nとおり、嫌なヤツに\n思われちゃうかも。"},
        { "location": "96/TALK"   , "narrator": "ガブリエラ", "text": "満点自体は凄いもの\nなんだから――"},
        { "location": "97/TALK"   , "narrator": "ガブリエラ", "text": "喜ぶときは喜ばないと\nエレガントでは\nないわね。"},
        { "location": "99/TALK"   , "narrator": "ガブリエラ", "text": "…みやびの言う通りね。"},
        { "location": "101/TALK"  , "narrator": "みやび", "text": "ようやく理解したがか？"},
        { "location": "102/TALK"  , "narrator": "ガブリエラ", "text": "ええ…とっくに\n習ったとか、そういう\nのは別にして――"},
        { "location": "103/TALK"  , "narrator": "ガブリエラ", "text": "完璧に覚えてる、って\n証明にもなるんだし。\n喜んでおくべきよね。"},
        { "location": "104/TALK"  , "narrator": "ガブリエラ", "text": "反省するわ。"},
        { "location": "107/TALK"  , "narrator": "みやび", "text": "反省やのうて\n喜べ言っちゅうに…。"},
        { "location": "108/ACT"   , "narrator": "", "text": "喜ばなきゃ変だよ"},
        { "location": "127/TALK"  , "narrator": "ガブリエラ", "text": "無理に喜ぶ方が変よ"},
        { "location": "139/TALK"  , "narrator": "ガブリエラ", "text": "そうよ、いくら\n周りから凄いと\n思われたって――"},
        { "location": "140/TALK"  , "narrator": "ガブリエラ", "text": "それで無理に\n喜ばなきゃいけない\n理由なんてないわ。"},
        { "location": "143/TALK"  , "narrator": "ガブリエラ", "text": "うん、やっぱり無理。"},
        { "location": "145/TALK"  , "narrator": "みやび", "text": "言い切りおったか。"},
        { "location": "146/TALK"  , "narrator": "ガブリエラ", "text": "日本の中学レベルの\n問題じゃ、達成感も\n皆無だし――"},
        { "location": "147/TALK"  , "narrator": "ガブリエラ", "text": "一々こんなことで\n喜んだら、キリが\nなくなっちゃうわ。"},
        { "location": "150/TALK"  , "narrator": "みやび", "text": "…この性格じゃ\n同級生に友達なんて\nできないのも当然やね。"},
        { "location": "151/ACT"   , "narrator": "", "text": "$me$が代わりに喜ぶよ"},
        { "location": "179/TALK"  , "narrator": "ガブリエラ", "text": "ありがとう、マルザンナ"},
        { "location": "180/TALK"  , "narrator": "ガブリエラ", "text": "それなら、私の分までうんと喜んでちょうだい"},
        { "location": "192/TALK"  , "narrator": "ガブリエラ", "text": "…ふふっ。"},
        { "location": "193/TALK"  , "narrator": "みやび", "text": "おっ、やっとわかって\nもらえたようやね。"},
        { "location": "195/TALK"  , "narrator": "ガブリエラ", "text": "えっ、何が？"},
        { "location": "196/TALK"  , "narrator": "みやび", "text": "えい笑顔に\nなっちゅうよ。"},
        { "location": "198/TALK"  , "narrator": "ガブリエラ", "text": "えっ！？"},
        { "location": "200/TALK"  , "narrator": "ガブリエラ", "text": "本当だ！\nなんか口元が自然と\n緩んじゃってる。"},
        { "location": "201/TALK"  , "narrator": "みやび", "text": "簡単思うたとしても、\n満点を取った時は\n素直に喜ぶ。"},
        { "location": "202/TALK"  , "narrator": "みやび", "text": "その方が自然やし、\n可愛くてえいと思うよ。"},
        { "location": "204/TALK"  , "narrator": "ガブリエラ", "text": "…満点が嬉しくて\n笑ってるわけじゃ\nないんだけど…。"},
        { "location": "205/TALK"  , "narrator": "ガブリエラ", "text": "でも、あたしのことで\n喜んでくれる人がいる\nのって、嬉しいな。"},
        { "location": "18/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>5月13日　4:51 PM</color>\nとある日の夕方、神楽坂トライナリー付近の路地にて。"},
        { "location": "60/DIALOG" , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"},
        { "location": "157/DIALOG", "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"}
    ]
}
