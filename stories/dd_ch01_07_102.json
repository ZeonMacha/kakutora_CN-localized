    "entry":
    [
        { "location": "496/SCENARIO", "narrator": "", "text": "決意を伝える決意"},
        { "location": "521/SEL"     , "narrator": "", "text": "お父さんの話、ウソでしょ？"},
        { "location": "522/ACT"     , "narrator": "", "text": "お父さんの話、ウソでしょ？"},
        { "location": "524/TALK"    , "narrator": "つばめ", "text": "ぇっ！？(ﾟ△ﾟ;ﾉ)ﾉ"},
        { "location": "528/TALK"    , "narrator": "つばめ", "text": "どぅしてそぅ思ぅの？"},
        { "location": "530/SEL"     , "narrator": "", "text": "つばめはウソが下手"},
        { "location": "531/ACT"     , "narrator": "", "text": "つばめはウソが下手"},
        { "location": "534/TALK"    , "narrator": "つばめ", "text": "ごめんなさぃ(´･ω･｀) "},
        { "location": "536/TALK"    , "narrator": "つばめ", "text": "$handle$さんの言ぅ通り"},
        { "location": "537/TALK"    , "narrator": "つばめ", "text": "ぉ父さん"},
        { "location": "538/TALK"    , "narrator": "つばめ", "text": "許してくれてなぃの(o´Д`)=з"},
        { "location": "539/TALK"    , "narrator": "つばめ", "text": "説得しよぅと思ったんだけど"},
        { "location": "540/TALK"    , "narrator": "つばめ", "text": "結局時間なくて(´・ω・｀)"},
        { "location": "541/TALK"    , "narrator": "つばめ", "text": "無理やり押し切った形で電話切っちゃったから"},
        { "location": "542/TALK"    , "narrator": "つばめ", "text": "まだ仲直りしてなぃの(´つω・｀)ｼｭﾝ"},
        { "location": "545/SEL"     , "narrator": "", "text": "ダメでしょ、それ"},
        { "location": "546/ACT"     , "narrator": "", "text": "ダメでしょ、それ"},
        { "location": "548/TALK"    , "narrator": "つばめ", "text": "わかってるけど"},
        { "location": "549/TALK"    , "narrator": "つばめ", "text": "話し辛くて(o´Д`)=з"},
        { "location": "550/TALK"    , "narrator": "つばめ", "text": "ぉ父さんも"},
        { "location": "551/TALK"    , "narrator": "つばめ", "text": "ぁれから連絡してこなぃし"},
        { "location": "552/TALK"    , "narrator": "つばめ", "text": "嫌われちゃったのかな？・゜・(ノД`)・゜・"},
        { "location": "555/SEL"     , "narrator": "", "text": "つばめを心配してのことだから、嫌われてないよ"},
        { "location": "556/SEL"     , "narrator": "", "text": "すぐに連絡して謝るべき"},
        { "location": "557/SEL"     , "narrator": "", "text": "つばめはお父さんが大好きなんだね"},
        { "location": "558/ACT"     , "narrator": "", "text": "つばめを心配してのことだから、嫌われてないよ"},
        { "location": "560/TALK"    , "narrator": "つばめ", "text": "ぁりがとう(*´ω｀*)"},
        { "location": "561/TALK"    , "narrator": "つばめ", "text": "$handle$さんにそぅ言われると"},
        { "location": "562/TALK"    , "narrator": "つばめ", "text": "そんな気がしてきたよ"},
        { "location": "565/TALK"    , "narrator": "つばめ", "text": "わたし、ぉ父さんに謝る！(๑･ㅂ･)و☆"},
        { "location": "576/TALK"    , "narrator": "つばめ", "text": "…なんて送ろうかな？"},
        { "location": "577/TALK"    , "narrator": "つばめ", "text": "ただ、ごめんなさい、\nだけだと素っ気ない\n感じだし…。"},
        { "location": "582/TALK"    , "narrator": "つばめ", "text": "わわっ！？\nめ、メール…。"},
        { "location": "584/TALK"    , "narrator": "つばめ", "text": "お父さん！？"},
        { "location": "585/TALK"    , "narrator": "つばめ", "text": "『…母さんと話した。\n母さんは、つばめが\nやりたいことなら――"},
        { "location": "586/TALK"    , "narrator": "つばめ", "text": "やらせてあげたい、\nとのこと。"},
        { "location": "587/TALK"    , "narrator": "つばめ", "text": "母さんに免じて、\n今回の件は暫定的に\n許すことにする』"},
        { "location": "588/TALK"    , "narrator": "つばめ", "text": "…お父さん。"},
        { "location": "589/TALK"    , "narrator": "つばめ", "text": "『けど、毎日メールでも\n電話でも、ちゃんと\n連絡をよこすこと。"},
        { "location": "590/TALK"    , "narrator": "つばめ", "text": "数日中に一度そっちへ\n行く。明日からの学校、\n頑張れ』"},
        { "location": "591/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "592/TALK"    , "narrator": "つばめ", "text": "ありがとう…、\nお父さん…お母さん。"},
        { "location": "593/TALK"    , "narrator": "つばめ", "text": "…へ、返事しなきゃ。"},
        { "location": "594/TALK"    , "narrator": "つばめ", "text": "ありがとう、\nお父さん、お母さん。"},
        { "location": "595/TALK"    , "narrator": "つばめ", "text": "わたし、頑張るから！"},
        { "location": "596/TALK"    , "narrator": "つばめ", "text": "何があったか、\n毎日必ず連絡するね。"},
        { "location": "597/TALK"    , "narrator": "つばめ", "text": "週末、一度おうちに\n帰ります。"},
        { "location": "598/TALK"    , "narrator": "つばめ", "text": "いっぱいお土産\n買ってくね！"},
        { "location": "599/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "601/TALK"    , "narrator": "つばめ", "text": "大好きなお父さんへ！"},
        { "location": "602/ACT"     , "narrator": "", "text": "すぐに連絡して謝るべき"},
        { "location": "603/TALK"    , "narrator": "つばめ", "text": "時間が経つと"},
        { "location": "604/TALK"    , "narrator": "つばめ", "text": "謝り難くなっちゃぅよねヾ(｡>﹏<｡)ﾉﾞ"},
        { "location": "605/TALK"    , "narrator": "つばめ", "text": "わかった"},
        { "location": "607/ACT"     , "narrator": "", "text": "つばめはお父さんが大好きなんだね"},
        { "location": "608/TALK"    , "narrator": "つばめ", "text": "ぅん(*´︶`*)"},
        { "location": "609/TALK"    , "narrator": "つばめ", "text": "ぉ母さん"},
        { "location": "610/TALK"    , "narrator": "つばめ", "text": "わたしと同じ病気で"},
        { "location": "611/TALK"    , "narrator": "つばめ", "text": "ずっと入退院を繰り返してるの(´･ω･｀) "},
        { "location": "612/TALK"    , "narrator": "つばめ", "text": "だからわたし"},
        { "location": "613/TALK"    , "narrator": "つばめ", "text": "ぉ父さんと二人でぃる時間が多かったの"},
        { "location": "614/TALK"    , "narrator": "つばめ", "text": "ぁぁ見ぇてぉ父さん"},
        { "location": "615/TALK"    , "narrator": "つばめ", "text": "すごく料理が上手なんだよ(´∀｀*)ｳﾌﾌ"},
        { "location": "616/TALK"    , "narrator": "つばめ", "text": "忙しぃのにぃつも作ってくれて"},
        { "location": "617/TALK"    , "narrator": "つばめ", "text": "ぶっきらぼうだけど"},
        { "location": "619/TALK"    , "narrator": "つばめ", "text": "すごく優しぃ人なの (*´∀`*)"},
        { "location": "621/SEL"     , "narrator": "", "text": "でも、結婚相手は大変そう"},
        { "location": "622/ACT"     , "narrator": "", "text": "でも、結婚相手は大変そう"},
        { "location": "624/TALK"    , "narrator": "つばめ", "text": "ぅーん"},
        { "location": "626/TALK"    , "narrator": "つばめ", "text": "ちょっと大変かも(´ｪ｀；)三(；´ｪ｀)"},
        { "location": "628/TALK"    , "narrator": "つばめ", "text": "話してたら"},
        { "location": "629/TALK"    , "narrator": "つばめ", "text": "気持ちが軽くなってきたよ(´∀｀*)ｳﾌﾌ"},
        { "location": "642/DIALOG"  , "narrator": "Dialog_chapter_ch01", "text": "【05 金色の髪のカグラ】"}
    ]
}
