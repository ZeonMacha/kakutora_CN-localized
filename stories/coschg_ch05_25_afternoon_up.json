        { "location": "2857/TALK", "narrator": "プレイヤー", "text": "お着替えしてみよう"},
        { "location": "2859/TALK", "narrator": "プレイヤー", "text": "違う服を着てほしいな"},
        { "location": "2861/TALK", "narrator": "プレイヤー", "text": "よし、お着替えタイムだ！"},
        { "location": "2867/TALK", "narrator": "プレイヤー", "text": "やあ"},
        { "location": "2869/TALK", "narrator": "プレイヤー", "text": "こんにちは"},
        { "location": "2871/TALK", "narrator": "プレイヤー", "text": "げんき？"},
        { "location": "2874/TALK", "narrator": "神楽", "text": "ぴょんこを呼ぶ声"},
        { "location": "2875/TALK", "narrator": "神楽", "text": "あなたはだあれ？"},
        { "location": "2877/SEL" , "narrator": "", "text": "$handle$だよ"},
        { "location": "2878/ACT" , "narrator": "", "text": "$handle$だよ"},
        { "location": "2880/TALK", "narrator": "神楽", "text": "知ってるし"},
        { "location": "2881/TALK", "narrator": "神楽", "text": "ぴょんこに用事ぴょん？"},
        { "location": "2884/SEL" , "narrator": "", "text": "ちょっと着替えてほしいんだ"},
        { "location": "2885/ACT" , "narrator": "", "text": "ちょっと着替えてほしいんだ"},
        { "location": "2895/TALK", "narrator": "神楽", "text": "意味不明すぎ"},
        { "location": "2896/TALK", "narrator": "神楽", "text": "でもまあ"},
        { "location": "2897/TALK", "narrator": "神楽", "text": "優しいぴょんこは聞いてあげるのだった"},
        { "location": "2899/TALK", "narrator": "神楽", "text": "は？"},
        { "location": "2900/TALK", "narrator": "神楽", "text": "この服変だった？"},
        { "location": "2901/TALK", "narrator": "神楽", "text": "なら着替えるけど"},
        { "location": "2904/SEL" , "narrator": "", "text": "$me$が選ぶ"},
        { "location": "2905/SEL" , "narrator": "", "text": "やっぱやめる"},
        { "location": "2907/TALK", "narrator": "神楽", "text": "…………"},
        { "location": "2910/TALK", "narrator": "神楽", "text": "リクエストないとか？"},
        { "location": "2911/TALK", "narrator": "神楽", "text": "なら着ない"},
        { "location": "2913/ACT" , "narrator": "", "text": "$me$が選ぶ"},
        { "location": "2914/TALK", "narrator": "神楽", "text": "だと思った"},
        { "location": "2915/TALK", "narrator": "神楽", "text": "どれを着てほしいと？"},
        { "location": "2922/ACT" , "narrator": "", "text": "やっぱやめる"},
        { "location": "2923/TALK", "narrator": "神楽", "text": "ありえネー"}
    ]
