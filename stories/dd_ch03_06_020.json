{
    "dir": "chap06/daydra/dd_ch03_06_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "6356",
        "cid": "gabriella",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "ミスコン"
    },
    "entry":
    [
        { "location": "443/SCENARIO", "narrator": "", "text": "ミスコン"},
        { "location": "459/TALK"    , "narrator": "ガブリエラ", "text": "…今回の特集記事、\nあんまり\n面白くないわね。"},
        { "location": "460/TALK"    , "narrator": "ガブリエラ", "text": "これといって\n欲しい服も\n載ってないし…。"},
        { "location": "461/TALK"    , "narrator": "ガブリエラ", "text": "…ん？\n読者モデル募集？"},
        { "location": "462/TALK"    , "narrator": "ガブリエラ", "text": "書類審査合格後、\nコンテストで優勝したら\n専属モデルデビュー…。"},
        { "location": "464/TALK"    , "narrator": "ガブリエラ", "text": "読者モデルかぁ…。"},
        { "location": "465/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "469/TALK"    , "narrator": "みやび", "text": "興味あるんか？"},
        { "location": "472/TALK"    , "narrator": "ガブリエラ", "text": "きゃあっ！？"},
        { "location": "474/TALK"    , "narrator": "ガブリエラ", "text": "み、みやび！？\n急に声かけないでよ！\n驚いたじゃない！？"},
        { "location": "475/TALK"    , "narrator": "みやび", "text": "読者モデル、\n応募してみたら\nどうや？"},
        { "location": "478/TALK"    , "narrator": "ガブリエラ", "text": "はぁ？\n絶対にしないわよ。"},
        { "location": "482/TALK"    , "narrator": "みやび", "text": "ほう…なら…。"},
        { "location": "484/TALK"    , "narrator": "ガブリエラ", "text": "言っとくけど、勝手に\n応募されて、仮に合格\nしても――"},
        { "location": "485/TALK"    , "narrator": "ガブリエラ", "text": "あたしは辞退するから。"},
        { "location": "488/TALK"    , "narrator": "みやび", "text": "…察しがえいな、\nガブちゃん。"},
        { "location": "489/TALK"    , "narrator": "みやび", "text": "まあ、ガブちゃんの\nことやき多分断るとは\n思うちょったけんど――"},
        { "location": "490/TALK"    , "narrator": "みやび", "text": "ちくっと勿体ない\n気もするがよ。"},
        { "location": "491/TALK"    , "narrator": "ガブリエラ", "text": "勿体ない？"},
        { "location": "492/TALK"    , "narrator": "みやび", "text": "ガブちゃんの可愛さを、\n大勢の人に見せられん\nことちや。"},
        { "location": "493/SEL"     , "narrator": "", "text": "興味ないの？"},
        { "location": "494/SEL"     , "narrator": "", "text": "優勝間違いなしだよ！"},
        { "location": "495/SEL"     , "narrator": "", "text": "ガブリエラを見られたくない"},
        { "location": "497/TALK"    , "narrator": "ガブリエラ", "text": "大袈裟過ぎだってば。"},
        { "location": "498/TALK"    , "narrator": "みやび", "text": "まあ、ちっくとだけな。"},
        { "location": "499/TALK"    , "narrator": "みやび", "text": "けんど、可愛い思うは\n本当やき、応募だけ\nしてみたらどうかね。"},
        { "location": "501/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "504/TALK"    , "narrator": "ガブリエラ", "text": "まあ、正直言って\n憧れるし――"},
        { "location": "505/TALK"    , "narrator": "ガブリエラ", "text": "可愛いって言って\nもらえるのも、\n嬉しいと思うわ。"},
        { "location": "506/TALK"    , "narrator": "ガブリエラ", "text": "けど…嫌なのよ。\nこういうのって…。"},
        { "location": "507/TALK"    , "narrator": "みやび", "text": "こういうのって、\nコンテストのことなが？"},
        { "location": "509/TALK"    , "narrator": "ガブリエラ", "text": "うん…。"},
        { "location": "510/TALK"    , "narrator": "みやび", "text": "…嫌いいうよりは、\n苦手、っちゅう感じ\nかもしれんなぁ。"},
        { "location": "511/TALK"    , "narrator": "みやび", "text": "…まあ、そこまで\n嫌ならこれ以上は\n勧めんぞね。"},
        { "location": "512/TALK"    , "narrator": "みやび", "text": "けんど、\nちっくとでも興味が\nあるんやったら――"},
        { "location": "513/TALK"    , "narrator": "みやび", "text": "いつかは出よう思える\nようになるがよ。"},
        { "location": "515/TALK"    , "narrator": "ガブリエラ", "text": "…そうかしら？"},
        { "location": "516/TALK"    , "narrator": "みやび", "text": "そうちや。"},
        { "location": "518/TALK"    , "narrator": "みやび", "text": "コンテストの壇上に\n上がって、可愛さを\n振りまくガブちゃん。"},
        { "location": "519/TALK"    , "narrator": "みやび", "text": "そんなガブちゃんの\n可愛さに当てられて、\n鼻血を出す男達の姿が―"},
        { "location": "520/TALK"    , "narrator": "みやび", "text": "目に浮かんでくるぞね。"},
        { "location": "521/TALK"    , "narrator": "ガブリエラ", "text": "そんな可愛さ嫌よ！"},
        { "location": "522/TALK"    , "narrator": "ガブリエラ", "text": "っていうか、\nリアルだとそれ\n大惨事じゃない？"},
        { "location": "524/TALK"    , "narrator": "みやび", "text": "…大惨事やね。"},
        { "location": "526/TALK"    , "narrator": "みやび", "text": "ガブちゃんの可愛さは\n兵器並みやきね。"},
        { "location": "529/TALK"    , "narrator": "ガブリエラ", "text": "そんな可愛さ持って\nないし、持ちたくも\nないわよ…。"},
        { "location": "531/ACT"     , "narrator": "", "text": "興味ないの？"},
        { "location": "535/TALK"    , "narrator": "ガブリエラ", "text": "ごめん、\nちょっとタイム。\n何か来たみたい。"},
        { "location": "536/TALK"    , "narrator": "みやび", "text": "ん、ゆっくりでえいよ。"},
        { "location": "553/TALK"    , "narrator": "ガブリエラ", "text": "興味ないわけじゃないわ"},
        { "location": "554/TALK"    , "narrator": "ガブリエラ", "text": "けど…仮に合格したら、コンテストでしょ？"},
        { "location": "555/TALK"    , "narrator": "ガブリエラ", "text": "そうなったら、男の人達に沢山見られることになるし…"},
        { "location": "557/SEL"     , "narrator": "", "text": "怖い？"},
        { "location": "558/ACT"     , "narrator": "", "text": "怖い？"},
        { "location": "560/TALK"    , "narrator": "ガブリエラ", "text": "想像するだけでも怖いわ"},
        { "location": "561/TALK"    , "narrator": "ガブリエラ", "text": "だから、嫌なの！"},
        { "location": "574/TALK"    , "narrator": "ガブリエラ", "text": "お待たせ…。"},
        { "location": "575/TALK"    , "narrator": "みやび", "text": "大丈夫がか？\nちっくと顔色悪い\nみたいやけんど…。"},
        { "location": "577/TALK"    , "narrator": "ガブリエラ", "text": "へ、平気よ。\n何でもないから。"},
        { "location": "578/TALK"    , "narrator": "みやび", "text": "…そんなに\nコンテストの\n話が嫌だったが？"},
        { "location": "580/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "581/TALK"    , "narrator": "ガブリエラ", "text": "まあ、正直言って\n憧れるし――"},
        { "location": "582/TALK"    , "narrator": "ガブリエラ", "text": "可愛いって言って\nもらえるのも、\n嬉しいと思うわ。"},
        { "location": "583/TALK"    , "narrator": "ガブリエラ", "text": "けど…嫌なのよ。\nこういうのって…。"},
        { "location": "584/TALK"    , "narrator": "みやび", "text": "…そうやったがね。"},
        { "location": "585/TALK"    , "narrator": "みやび", "text": "…嫌いいうよりは、\n苦手、っちゅう感じ\nかもしれんなぁ。"},
        { "location": "586/TALK"    , "narrator": "みやび", "text": "…まあ、そこまで\n嫌ならこれ以上は\n勧めんぞね。"},
        { "location": "587/TALK"    , "narrator": "みやび", "text": "けんど、\nちっくとでも興味が\nあるんやったら――"},
        { "location": "588/TALK"    , "narrator": "みやび", "text": "いつかは出よう思える\nようになるがよ。"},
        { "location": "589/TALK"    , "narrator": "ガブリエラ", "text": "…そうかしら？"},
        { "location": "590/TALK"    , "narrator": "みやび", "text": "そうちや。"},
        { "location": "592/TALK"    , "narrator": "みやび", "text": "コンテストの壇上に\n上がって、可愛さを\n振りまくガブちゃん。"},
        { "location": "593/TALK"    , "narrator": "みやび", "text": "そんなガブちゃんの\n可愛さに当てられて、\n鼻血を出す男達の姿が―"},
        { "location": "594/TALK"    , "narrator": "みやび", "text": "目に浮かんでくるぞね。"},
        { "location": "595/TALK"    , "narrator": "ガブリエラ", "text": "そんな可愛さ嫌よ！"},
        { "location": "596/TALK"    , "narrator": "ガブリエラ", "text": "っていうか、\nリアルだとそれ\n大惨事じゃない？"},
        { "location": "598/TALK"    , "narrator": "みやび", "text": "…大惨事やね。"},
        { "location": "600/TALK"    , "narrator": "みやび", "text": "ガブちゃんの可愛さは\n兵器並みやきね。"},
        { "location": "603/TALK"    , "narrator": "ガブリエラ", "text": "そんな可愛さ持って\nないし、持ちたくも\nないわよ…。"},
        { "location": "604/ACT"     , "narrator": "", "text": "優勝間違いなしだよ！"},
        { "location": "625/TALK"    , "narrator": "ガブリエラ", "text": "言い過ぎよ、マルザンナったら…"},
        { "location": "626/TALK"    , "narrator": "ガブリエラ", "text": "でも、ありがと"},
        { "location": "639/TALK"    , "narrator": "ガブリエラ", "text": "まあ、\n何を言われようと\n出る気はないけど――"},
        { "location": "640/TALK"    , "narrator": "ガブリエラ", "text": "せっかく\n褒められてるんだし？"},
        { "location": "641/TALK"    , "narrator": "ガブリエラ", "text": "これからも今の状態を\n維持する努力だけは\nしようと思うわ。"},
        { "location": "643/TALK"    , "narrator": "みやび", "text": "はぁ…勿体ない。\n宝の持ち腐れやなぁ。"},
        { "location": "645/TALK"    , "narrator": "ガブリエラ", "text": "そんなに言うなら、\nみやびが出てみれば\nいいじゃない。"},
        { "location": "646/TALK"    , "narrator": "ガブリエラ", "text": "あたしなんかより、\n全然合格する可能性\nありそうだし。"},
        { "location": "647/TALK"    , "narrator": "みやび", "text": "そう言って\nもらえるんは、\nうちも嬉しいけんど――"},
        { "location": "648/TALK"    , "narrator": "みやび", "text": "人様に見せられるような\nボディしとらんき、\n丁重に辞退するがよ。"},
        { "location": "651/TALK"    , "narrator": "ガブリエラ", "text": "…その発言、かなり\n敵を作りそうだから、\n控えた方が良いわよ？"},
        { "location": "668/ACT"     , "narrator": "", "text": "ガブリエラを見られたくない"},
        { "location": "688/TALK"    , "narrator": "ガブリエラ", "text": "あら、マルザンナって独占欲強いのかしら？"},
        { "location": "689/TALK"    , "narrator": "ガブリエラ", "text": "言われなくても出ないから、安心して"},
        { "location": "702/TALK"    , "narrator": "ガブリエラ", "text": "とにかく、あたしは\nこういうの興味ないの。"},
        { "location": "704/TALK"    , "narrator": "ガブリエラ", "text": "何言われたって、\n絶対に出ないわよ？"},
        { "location": "706/TALK"    , "narrator": "みやび", "text": "…そうやったがか。"},
        { "location": "707/TALK"    , "narrator": "みやび", "text": "募集ページのとこで\n手が止まってたように\n見えたんやが…。"},
        { "location": "708/TALK"    , "narrator": "みやび", "text": "うちの勘違いだった\nみたいやね。"},
        { "location": "711/TALK"    , "narrator": "ガブリエラ", "text": "そ、そういうこと。\nはい、興味ないから、\nこの話おしまいね！"},
        { "location": "715/TALK"    , "narrator": "ガブリエラ", "text": "…観察力凄過ぎるわ。\nもしかして、ウソついた\nのがバレてるかしら？"},
        { "location": "451/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>5月7日　5:14 PM</color>\nＧＷ期間中、\n神楽坂トライナリー楽屋にて。"},
        { "location": "662/DIALOG"  , "narrator": "Dialog_GEThimegoto_ch03", "text": "【見えなくなるから、と人は言う】"}
    ]
}
