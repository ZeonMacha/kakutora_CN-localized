    "entry":
    [
        { "location": "431/SCENARIO", "narrator": "", "text": "470_情熱的に愛してね"},
        { "location": "456/TALK"    , "narrator": "アーヤ", "text": "スペイン料理って食べたことある？"},
        { "location": "458/SEL"     , "narrator": "", "text": "あるよ"},
        { "location": "459/SEL"     , "narrator": "", "text": "ないよ"},
        { "location": "460/SEL"     , "narrator": "", "text": "今度行こうよ"},
        { "location": "461/ACT"     , "narrator": "", "text": "あるよ"},
        { "location": "462/TALK"    , "narrator": "アーヤ", "text": "あるのね"},
        { "location": "463/ACT"     , "narrator": "", "text": "ないよ"},
        { "location": "464/TALK"    , "narrator": "アーヤ", "text": "ないかー"},
        { "location": "465/ACT"     , "narrator": "", "text": "今度行こうよ"},
        { "location": "475/TALK"    , "narrator": "アーヤ", "text": "あら"},
        { "location": "476/TALK"    , "narrator": "アーヤ", "text": "いいわね"},
        { "location": "478/TALK"    , "narrator": "アーヤ", "text": "連れてって(=^0^=)"},
        { "location": "480/TALK"    , "narrator": "アーヤ", "text": "なんかね"},
        { "location": "481/TALK"    , "narrator": "アーヤ", "text": "味付けとか日本人この実なんだって"},
        { "location": "483/SEL"     , "narrator": "", "text": "木の実なの？"},
        { "location": "484/SEL"     , "narrator": "", "text": "好み、だよね"},
        { "location": "485/ACT"     , "narrator": "", "text": "木の実なの？"},
        { "location": "486/TALK"    , "narrator": "アーヤ", "text": "え？"},
        { "location": "487/TALK"    , "narrator": "アーヤ", "text": "あ"},
        { "location": "489/TALK"    , "narrator": "アーヤ", "text": "好みね"},
        { "location": "490/TALK"    , "narrator": "アーヤ", "text": "好み！！"},
        { "location": "491/ACT"     , "narrator": "", "text": "好み、だよね"},
        { "location": "492/TALK"    , "narrator": "アーヤ", "text": "あ"},
        { "location": "493/TALK"    , "narrator": "アーヤ", "text": "そうよ"},
        { "location": "495/TALK"    , "narrator": "アーヤ", "text": "好みよ！"},
        { "location": "498/TALK"    , "narrator": "アーヤ", "text": "パエリアじゃなくて"},
        { "location": "499/TALK"    , "narrator": "アーヤ", "text": "パエージャって言い方の方が"},
        { "location": "500/TALK"    , "narrator": "アーヤ", "text": "スペイン語に近いらしいわ"},
        { "location": "502/SEL"     , "narrator": "", "text": "ふーん"},
        { "location": "503/SEL"     , "narrator": "", "text": "さよけ"},
        { "location": "504/ACT"     , "narrator": "", "text": "ふーん"},
        { "location": "505/ACT"     , "narrator": "", "text": "さよけ"},
        { "location": "507/TALK"    , "narrator": "アーヤ", "text": "あら"},
        { "location": "508/TALK"    , "narrator": "アーヤ", "text": "なんだか乗り気じゃないのね"},
        { "location": "509/TALK"    , "narrator": "アーヤ", "text": "もっとこう"},
        { "location": "511/TALK"    , "narrator": "アーヤ", "text": "スペインっぽい"},
        { "location": "512/TALK"    , "narrator": "アーヤ", "text": "情熱的な回答が欲しいわ"},
        { "location": "514/SEL"     , "narrator": "", "text": "$me$の心が欲しいのかい……"},
        { "location": "515/SEL"     , "narrator": "", "text": "愛してるよセニョリータ"},
        { "location": "516/SEL"     , "narrator": "", "text": "日本人ですから"},
        { "location": "517/ACT"     , "narrator": "", "text": "$me$の心が欲しいのかい……"},
        { "location": "518/TALK"    , "narrator": "アーヤ", "text": "そうね"},
        { "location": "519/TALK"    , "narrator": "アーヤ", "text": "欲しいわ"},
        { "location": "520/TALK"    , "narrator": "アーヤ", "text": "だって"},
        { "location": "521/TALK"    , "narrator": "アーヤ", "text": "私の心はもう"},
        { "location": "522/TALK"    , "narrator": "アーヤ", "text": "貴方のものなんだから"},
        { "location": "523/ACT"     , "narrator": "", "text": "愛してるよセニョリータ"},
        { "location": "524/TALK"    , "narrator": "アーヤ", "text": "そうそう"},
        { "location": "525/TALK"    , "narrator": "アーヤ", "text": "そういうのが欲しいのよ"},
        { "location": "526/TALK"    , "narrator": "アーヤ", "text": "でも"},
        { "location": "527/TALK"    , "narrator": "アーヤ", "text": "私の方が"},
        { "location": "528/TALK"    , "narrator": "アーヤ", "text": "きっとずっと愛してるわ"},
        { "location": "529/ACT"     , "narrator": "", "text": "日本人ですから"},
        { "location": "530/TALK"    , "narrator": "アーヤ", "text": "もう"},
        { "location": "531/TALK"    , "narrator": "アーヤ", "text": "仕方ないわね"},
        { "location": "537/TALK"    , "narrator": "ボイスメール", "text": "シェリーに口づけ"},
        { "location": "471/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>1000pt.</b></color></size>\nアップしました！"},
        { "location": "549/DIALOG"  , "narrator": "Dialog_GETVoice", "text": "<color=green>【アーヤ】</color>のボイスメール\n<color=red>【シェリーに口づけ】</color>\nをゲットしました！"}
    ]
}
