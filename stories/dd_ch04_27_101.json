{
    "dir": "chap27/daydra/dd_ch04_27_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "27402",
        "cid": "miyabi",
        "title": "002 メインストーリー",
        "sub_title": "迷宮物語＜前編＞"
    },
    "entry":
    [
        { "location": "8/SCENARIO", "narrator": "", "text": "迷宮とはラビリンスにも似て（似て？）"},
        { "location": "35/TALK"   , "narrator": "みやび", "text": "エリカさんからの\n荷物を全部\n確認したぞね。"},
        { "location": "36/TALK"   , "narrator": "アーヤ", "text": "どう？\n何かわかった？"},
        { "location": "37/TALK"   , "narrator": "みやび", "text": "解析はこれからや\nけんど。"},
        { "location": "38/TALK"   , "narrator": "みやび", "text": "ひとつ毛色の違う\nデータがあったき。"},
        { "location": "39/TALK"   , "narrator": "みやび", "text": "これだけ先に\n検証しようかと\n思うとる。"},
        { "location": "40/TALK"   , "narrator": "ガブリエラ", "text": "そういうものなの？"},
        { "location": "42/TALK"   , "narrator": "みやび", "text": "うちは小さいものから\n片付けていく派やき。"},
        { "location": "43/TALK"   , "narrator": "みやび", "text": "と\nその前に…。"},
        { "location": "55/TALK"   , "narrator": "みやび", "text": "驚け相棒"},
        { "location": "56/TALK"   , "narrator": "みやび", "text": "アーヤの姉は実在した"},
        { "location": "57/SEL"    , "narrator": "", "text": "知ってる"},
        { "location": "58/SEL"    , "narrator": "", "text": "話したことあるし"},
        { "location": "59/SEL"    , "narrator": "", "text": "秘密だったのに"},
        { "location": "60/ACT"    , "narrator": "", "text": "黄色いスイカの方が甘く感じない？"},
        { "location": "61/TALK"   , "narrator": "みやび", "text": "いや"},
        { "location": "63/TALK"   , "narrator": "みやび", "text": "レア感は感じるが"},
        { "location": "64/ACT"    , "narrator": "", "text": "晩ご飯何かな"},
        { "location": "65/TALK"   , "narrator": "みやび", "text": "腹減りか"},
        { "location": "66/TALK"   , "narrator": "みやび", "text": "まず空腹を収めろ"},
        { "location": "67/ACT"    , "narrator": "", "text": "天ぷらは天つゆ派なんだ"},
        { "location": "68/TALK"   , "narrator": "みやび", "text": "薄口醤油なら"},
        { "location": "69/TALK"   , "narrator": "みやび", "text": "天つゆだな"},
        { "location": "71/TALK"   , "narrator": "みやび", "text": "いや"},
        { "location": "73/TALK"   , "narrator": "みやび", "text": "そんなことは"},
        { "location": "74/TALK"   , "narrator": "みやび", "text": "どうでもよく"},
        { "location": "75/TALK"   , "narrator": "みやび", "text": "アーヤの姉さんが"},
        { "location": "76/TALK"   , "narrator": "みやび", "text": "コンタクトしてきたんだぞ？"},
        { "location": "80/TALK"   , "narrator": "みやび", "text": "む"},
        { "location": "81/TALK"   , "narrator": "みやび", "text": "なんぞこれ"},
        { "location": "83/SEL"    , "narrator": "", "text": "エリカさんからパッチだよ"},
        { "location": "84/SEL"    , "narrator": "", "text": "それすごい重要なやつ"},
        { "location": "85/ACT"    , "narrator": "", "text": "松代オブザデッドってゾンビ映画どうかな"},
        { "location": "86/TALK"   , "narrator": "みやび", "text": "興味はある"},
        { "location": "87/TALK"   , "narrator": "みやび", "text": "企画が通ったら"},
        { "location": "88/TALK"   , "narrator": "みやび", "text": "ショッピングセンターに立てこもるヒロインをやりたい"},
        { "location": "89/ACT"    , "narrator": "", "text": "長野って海がないよね"},
        { "location": "90/TALK"   , "narrator": "みやび", "text": "高知には海も山もあるぞ"},
        { "location": "91/TALK"   , "narrator": "みやび", "text": "あと土佐犬もおる"},
        { "location": "93/TALK"   , "narrator": "みやび", "text": "なあ$handle$"},
        { "location": "94/TALK"   , "narrator": "みやび", "text": "平時ならむしろ気になる話題だが"},
        { "location": "95/TALK"   , "narrator": "みやび", "text": "今はもっと大事な話をしたいのだ"},
        { "location": "97/SEL"    , "narrator": "", "text": "$me$もそう思ってる"},
        { "location": "98/SEL"    , "narrator": "", "text": "だから答えがおかしいんだって"},
        { "location": "99/SEL"    , "narrator": "", "text": "もういい加減にして"},
        { "location": "100/ACT"   , "narrator": "", "text": "もういい加減にして"},
        { "location": "101/ACT"   , "narrator": "", "text": "もういい加減にして"},
        { "location": "102/ACT"   , "narrator": "", "text": "もういい加減にして"},
        { "location": "104/TALK"  , "narrator": "みやび", "text": "そう言いたいのは"},
        { "location": "105/TALK"  , "narrator": "みやび", "text": "こっちの方だが"},
        { "location": "106/TALK"  , "narrator": "みやび", "text": "わかっておるのか"},
        { "location": "107/TALK"  , "narrator": "みやび", "text": "$handle$め"},
        { "location": "109/SEL"   , "narrator": "", "text": "わかってるけど"},
        { "location": "110/SEL"   , "narrator": "", "text": "どうしようもないんだって"},
        { "location": "111/SEL"   , "narrator": "", "text": "もー！！！"},
        { "location": "112/SEL"   , "narrator": "", "text": "みやび助けて"},
        { "location": "113/SEL"   , "narrator": "", "text": "困ってるんだよ$me$だって"},
        { "location": "114/ACT"   , "narrator": "", "text": "もー！！！"},
        { "location": "115/ACT"   , "narrator": "", "text": "もー！！！"},
        { "location": "116/ACT"   , "narrator": "", "text": "もー！！！"},
        { "location": "117/ACT"   , "narrator": "", "text": "もー！！！"},
        { "location": "118/ACT"   , "narrator": "", "text": "もー！！！"},
        { "location": "120/TALK"  , "narrator": "みやび", "text": "$handle$の気持ちは"},
        { "location": "121/TALK"  , "narrator": "みやび", "text": "ようわかった"},
        { "location": "122/TALK"  , "narrator": "みやび", "text": "もうえい！"},
        { "location": "133/TALK"  , "narrator": "ガブリエラ", "text": "みやび？"},
        { "location": "136/TALK"  , "narrator": "みやび", "text": "どういた？"},
        { "location": "138/TALK"  , "narrator": "アーヤ", "text": "なんか変な\nメッセージでも\n届いたの？"},
        { "location": "139/TALK"  , "narrator": "アーヤ", "text": "なんだか怖い\n顔になってるから。"},
        { "location": "140/TALK"  , "narrator": "みやび", "text": "いや別に。"},
        { "location": "141/TALK"  , "narrator": "アーヤ", "text": "…だったら\nいいんだけど…。"},
        { "location": "143/TALK"  , "narrator": "みやび", "text": "変というか。"},
        { "location": "144/TALK"  , "narrator": "みやび", "text": "せっかく物事が\n進展するという時に。"},
        { "location": "145/TALK"  , "narrator": "みやび", "text": "ふざけたことばかり\n言ってくるとは。"},
        { "location": "147/TALK"  , "narrator": "みやび", "text": "うちは相棒を\n買い被りすぎ\nちょったかねえ…。"},
        { "location": "195/TALK"  , "narrator": "みやび", "text": "　"},
        { "location": "211/TALK"  , "narrator": "シンギュラリティ", "text": "コイガサキは\n寝ているようだ。"},
        { "location": "231/TALK"  , "narrator": "シンギュラリティ", "text": "これやね！"},
        { "location": "234/TALK"  , "narrator": "シンギュラリティ", "text": "キャーエッチー！"},
        { "location": "237/TALK"  , "narrator": "シンギュラリティ", "text": "キャーマニアックー！"},
        { "location": "241/TALK"  , "narrator": "シンギュラリティ", "text": "寝ているところを襲うとは\n$handle$も\nなかなか隅に置けんね。"},
        { "location": "242/SEL"   , "narrator": "", "text": "タヌキ寝入りじゃん"},
        { "location": "243/SEL"   , "narrator": "", "text": "もっと過激に襲いかかりたい"},
        { "location": "244/ACT"   , "narrator": "", "text": "タヌキ寝入りじゃん"},
        { "location": "245/TALK"  , "narrator": "シンギュラリティ", "text": "そこは\nお約束っちゅうやつやよ。"},
        { "location": "246/ACT"   , "narrator": "", "text": "もっと過激に襲いかかりたい"},
        { "location": "248/TALK"  , "narrator": "シンギュラリティ", "text": "お。\n$handle$の中の\n竜を目覚めさせたか。"},
        { "location": "249/TALK"  , "narrator": "シンギュラリティ", "text": "だがしかし！\nインターフェイスの\n限界があるね。"},
        { "location": "250/TALK"  , "narrator": "シンギュラリティ", "text": "お前さんの環境では、\nグルグル回してパンツを\n見るのが関の山であろう。"},
        { "location": "252/SEL"   , "narrator": "", "text": "今回も無駄にテンション高いね"},
        { "location": "253/ACT"   , "narrator": "", "text": "今回も無駄にテンション高いね"},
        { "location": "255/TALK"  , "narrator": "シンギュラリティ", "text": "うむ！"},
        { "location": "256/TALK"  , "narrator": "シンギュラリティ", "text": "翻してお前さんは\n随分と死相が出ちゅう\nけんど、どういたが？"},
        { "location": "257/SEL"   , "narrator": "", "text": "OSのせいで現実のみやびに失望された！"},
        { "location": "258/ACT"   , "narrator": "", "text": "OSのせいで現実のみやびに失望された！"},
        { "location": "260/TALK"  , "narrator": "シンギュラリティ", "text": "ふむ、なるほど。"},
        { "location": "261/TALK"  , "narrator": "シンギュラリティ", "text": "けんど、そんな筈は\nないんやけんどな。"},
        { "location": "262/TALK"  , "narrator": "シンギュラリティ", "text": "ちくっと\n調べてみるか。"},
        { "location": "268/TALK"  , "narrator": "シンギュラリティ", "text": "オープンプロセス――"},
        { "location": "269/TALK"  , "narrator": "シンギュラリティ", "text": "なんぞ、\nまだ情報阻害\nされちゅうが…。"},
        { "location": "270/SEL"   , "narrator": "", "text": "エリカさんが【0x86F】だって"},
        { "location": "271/ACT"   , "narrator": "", "text": "エリカさんが【0x86F】だって"},
        { "location": "273/TALK"  , "narrator": "シンギュラリティ", "text": "おお、さすがエリカさん。\nぬかりないな。"},
        { "location": "274/TALK"  , "narrator": "シンギュラリティ", "text": "オープンプロセス、\n0x121番地から\n0x86F番地へ。"},
        { "location": "296/TALK"  , "narrator": "シンギュラリティ", "text": "完了。"},
        { "location": "298/TALK"  , "narrator": "シンギュラリティ", "text": "……。"},
        { "location": "300/TALK"  , "narrator": "シンギュラリティ", "text": "………む。"},
        { "location": "301/TALK"  , "narrator": "シンギュラリティ", "text": "中と外\n両方から攻めて\nきちゅうが？"},
        { "location": "302/TALK"  , "narrator": "シンギュラリティ", "text": "誰や、\n内から攻めてるんは……"},
        { "location": "303/TALK"  , "narrator": "シンギュラリティ", "text": "……。"},
        { "location": "304/TALK"  , "narrator": "シンギュラリティ", "text": "って、そんなアホな。"},
        { "location": "305/SEL"   , "narrator": "", "text": "何かヤバイ事になってるの！？"},
        { "location": "306/ACT"   , "narrator": "", "text": "何かヤバイ事になってるの！？"},
        { "location": "308/TALK"  , "narrator": "シンギュラリティ", "text": "ん？"},
        { "location": "309/TALK"  , "narrator": "シンギュラリティ", "text": "いんや、大丈夫や。"},
        { "location": "310/TALK"  , "narrator": "シンギュラリティ", "text": "それより喜べ。\nお前さんは全く\n失望などされておらんよ。"},
        { "location": "311/TALK"  , "narrator": "シンギュラリティ", "text": "ちくっとうちの\n虫の居所が\n悪かっただけやき。"},
        { "location": "312/TALK"  , "narrator": "シンギュラリティ", "text": "虫の居所を悪くしてる\nクランを倒せば、後は\nトントン拍子や。"},
        { "location": "313/TALK"  , "narrator": "シンギュラリティ", "text": "あとはお前さんがキリッと\nしてれば、うちも余裕で\n惚れ直すき。"},
        { "location": "314/TALK"  , "narrator": "シンギュラリティ", "text": "寧ろ怪我の功名やね！"},
        { "location": "315/SEL"   , "narrator": "", "text": "よかった！"},
        { "location": "316/SEL"   , "narrator": "", "text": "何か問題があったんじゃないの？"},
        { "location": "317/ACT"   , "narrator": "", "text": "よかった！"},
        { "location": "318/TALK"  , "narrator": "シンギュラリティ", "text": "うむ。"},
        { "location": "319/TALK"  , "narrator": "シンギュラリティ", "text": "ほんだらさっさと\nクランを倒してきいや。"},
        { "location": "320/ACT"   , "narrator": "", "text": "何か問題があったんじゃないの？"},
        { "location": "322/TALK"  , "narrator": "シンギュラリティ", "text": "あるある。\nもちろんある。"},
        { "location": "323/TALK"  , "narrator": "シンギュラリティ", "text": "うちのココロの中には\n毎分毎秒星の数ほどの\n問題が渦巻いちゅう。"},
        { "location": "324/TALK"  , "narrator": "シンギュラリティ", "text": "だが心配するな相棒よ。\nお前さんには、\nこれっぽっちも関係ない。"},
        { "location": "325/TALK"  , "narrator": "シンギュラリティ", "text": "それより、\nとっととうちの虫の居所を\n矯正してくれんかね。"},
        { "location": "326/TALK"  , "narrator": "シンギュラリティ", "text": "うちとしてもまっこと\n気持ち悪いき、はよ\n誤解を解いてや。"},
        { "location": "328/TALK"  , "narrator": "シンギュラリティ", "text": "とゆうわけで、\nうちと$handle$に\n素敵なココロの旅を！"},
        { "location": "339/TALK"  , "narrator": "シンギュラリティ", "text": "……。"},
        { "location": "340/TALK"  , "narrator": "シンギュラリティ", "text": "……おかしいね。"},
        { "location": "341/TALK"  , "narrator": "シンギュラリティ", "text": "1x空間は、既に千羽鶴の\n影響下からは切り離され\nちゅう筈やけんど。"},
        { "location": "342/TALK"  , "narrator": "シンギュラリティ", "text": "まあ……。\nそう簡単には…\nといったところかね。"},
        { "location": "343/TALK"  , "narrator": "シンギュラリティ", "text": "問題は、千羽鶴がまだ\nアイツを雇っているか\nどうかやね……。"},
        { "location": "344/TALK"  , "narrator": "シンギュラリティ", "text": "調べに行ってみるか。"},
        { "location": "34/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>9月3日　 11:43 PM</color>\n長野県松代、アーヤの実家でのこと"},
        { "location": "79/DIALOG" , "narrator": "INFO", "text": "<color=green>【TRI-OS FILE:TOUCH】</color>\n\n<color=red>[FILE]\nTRI-OS Update\nRevision 2.11.2951E.pp\n</color>\n\nパッチパッケージを\n転送しました。"},
        { "location": "160/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "162/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "164/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "166/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "168/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "217/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "240/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"}
    ]
}
