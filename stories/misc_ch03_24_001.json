        { "location": "7/SCENARIO", "narrator": "", "text": "034_その美しき響き"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "テロルって"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "響きが可愛いわよねvvvvv"},
        { "location": "35/SEL"    , "narrator": "", "text": "テロリズムの略だよ？"},
        { "location": "36/SEL"    , "narrator": "", "text": "ごめん、よくわからない"},
        { "location": "37/SEL"    , "narrator": "", "text": "ルの響きのかわいさは異常"},
        { "location": "38/ACT"    , "narrator": "", "text": "テロリズムの略だよ？"},
        { "location": "39/TALK"   , "narrator": "ガブリエラ", "text": "知っているわよ"},
        { "location": "41/TALK"   , "narrator": "ガブリエラ", "text": "純粋な音の響きの話よ"},
        { "location": "42/ACT"    , "narrator": "", "text": "ごめん、よくわからない"},
        { "location": "43/TALK"   , "narrator": "ガブリエラ", "text": "そうなのね"},
        { "location": "44/TALK"   , "narrator": "ガブリエラ", "text": "どう言えば伝わるかしら・・・"},
        { "location": "45/ACT"    , "narrator": "", "text": "ルの響きのかわいさは異常"},
        { "location": "47/TALK"   , "narrator": "ガブリエラ", "text": "そうなのよｖｖｖｖ"},
        { "location": "48/TALK"   , "narrator": "ガブリエラ", "text": "チロルとかチルチルミチルとか"},
        { "location": "50/TALK"   , "narrator": "ガブリエラ", "text": "ルってかわいいわよねｖｖｖｖｖ"},
        { "location": "52/TALK"   , "narrator": "ガブリエラ", "text": "ルってかわいいけど"},
        { "location": "53/TALK"   , "narrator": "ガブリエラ", "text": "るだとそうでもないのよね"},
        { "location": "54/TALK"   , "narrator": "ガブリエラ", "text": "ひらがなだと"},
        { "location": "55/TALK"   , "narrator": "ガブリエラ", "text": "よ"},
        { "location": "56/TALK"   , "narrator": "ガブリエラ", "text": "が一番かわいいと思うわ"},
        { "location": "58/SEL"    , "narrator": "", "text": "ますますわからない"},
        { "location": "59/SEL"    , "narrator": "", "text": "「ひ」のほうがかわいいよ"},
        { "location": "60/SEL"    , "narrator": "", "text": "ガブが一番かわいいよ"},
        { "location": "61/ACT"    , "narrator": "", "text": "ますますわからない"},
        { "location": "62/TALK"   , "narrator": "ガブリエラ", "text": "$marzanna$は"},
        { "location": "63/TALK"   , "narrator": "ガブリエラ", "text": "日本語にもうちょっと敏感になった方がよくってよ"},
        { "location": "64/TALK"   , "narrator": "ガブリエラ", "text": "こんな素敵な言葉なんだから"},
        { "location": "65/ACT"    , "narrator": "", "text": "「ひ」のほうがかわいいよ"},
        { "location": "66/TALK"   , "narrator": "ガブリエラ", "text": "ひもいいわよねvvvvv"},
        { "location": "67/TALK"   , "narrator": "ガブリエラ", "text": "コロンとした感じが可愛らしいわｖｖｖｖ"},
        { "location": "68/TALK"   , "narrator": "ガブリエラ", "text": "ひを見る目が変わりそうだわｖｖ"},
        { "location": "69/ACT"    , "narrator": "", "text": "ガブが一番かわいいよ"},
        { "location": "71/TALK"   , "narrator": "ガブリエラ", "text": "そんなことを言っているわけじゃないのよ"},
        { "location": "72/TALK"   , "narrator": "ガブリエラ", "text": "ひらがなの可愛らしさについてのお話よ？"},
        { "location": "73/TALK"   , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "74/TALK"   , "narrator": "ガブリエラ", "text": "どうせなら私だって可愛い方がいいし"},
        { "location": "75/TALK"   , "narrator": "ガブリエラ", "text": "そんな$marzanna$もかわいいわ"},
        { "location": "76/TALK"   , "narrator": "ガブリエラ", "text": "いいこねｖｖｖｖｖｖ"}
    ]
