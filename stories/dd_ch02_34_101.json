{
    "dir": "chap34/daydra/dd_ch02_34_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "34202",
        "cid": "ayami",
        "title": "002 メインストーリー",
        "sub_title": "それは砂の器＜前編＞"
    },
    "entry":
    [
        { "location": "8/SCENARIO", "narrator": "", "text": "それは砂の器"},
        { "location": "26/TALK"   , "narrator": "アーヤ", "text": "痛っ…。"},
        { "location": "27/TALK"   , "narrator": "アーヤ", "text": "…しっかりしなきゃ。"},
        { "location": "28/TALK"   , "narrator": "アーヤ", "text": "さっき突然\nコネクトが解除されて…\n卯月が悪魔に変身して…。"},
        { "location": "29/TALK"   , "narrator": "アーヤ", "text": "っ…。"},
        { "location": "30/TALK"   , "narrator": "アーヤ", "text": "まず現状を把握しなきゃ。\nボケっとしてる\n場合じゃない。"},
        { "location": "35/TALK"   , "narrator": "アーヤ", "text": "はい。\nこちら國政。"},
        { "location": "36/TALK"   , "narrator": "透明みやび", "text": "うちぞね。"},
        { "location": "37/TALK"   , "narrator": "アーヤ", "text": "みやびなの？"},
        { "location": "38/TALK"   , "narrator": "透明みやび", "text": "こっちも使えんように\nなっちょったらどう\nしようかと思うちょった。"},
        { "location": "39/TALK"   , "narrator": "透明みやび", "text": "ちっくと不便やけんど\n孤立するよりは\n百万倍ましぞね。"},
        { "location": "40/TALK"   , "narrator": "アーヤ", "text": "…そうね。"},
        { "location": "41/TALK"   , "narrator": "透明みやび", "text": "ところで。"},
        { "location": "42/TALK"   , "narrator": "透明みやび", "text": "気づいちょったかよ。\nここがフェノメノン\nやって。"},
        { "location": "43/TALK"   , "narrator": "アーヤ", "text": "そんな…だって\n繭は発生して\nなかったわよ？"},
        { "location": "44/TALK"   , "narrator": "アーヤ", "text": "あ、元々つばめの\nフェノメノンの中\nだって言いたいの？"},
        { "location": "45/TALK"   , "narrator": "透明みやび", "text": "それやったらなんぼか\nましだったかも\n知れんねえ。"},
        { "location": "46/TALK"   , "narrator": "透明みやび", "text": "今、うちらは卯月の\nフェノメノンの中に\n居るがよ。"},
        { "location": "49/TALK"   , "narrator": "アーヤ", "text": "え！？"},
        { "location": "50/TALK"   , "narrator": "透明みやび", "text": "システムアラートが\n出ちゅう。\n発症者卯月神楽で。"},
        { "location": "51/TALK"   , "narrator": "アーヤ", "text": "……。"},
        { "location": "52/TALK"   , "narrator": "透明みやび", "text": "劇場の00Vが\nバグってない限りは\nそういう現状ぞね。"},
        { "location": "54/TALK"   , "narrator": "アーヤ", "text": "……そんな感覚\n全くなかったわ。"},
        { "location": "55/TALK"   , "narrator": "アーヤ", "text": "頭痛のせい…？"},
        { "location": "56/TALK"   , "narrator": "透明みやび", "text": "それだけつばめと\n卯月のがリニアに\n繋がっとるんやろうね。"},
        { "location": "57/TALK"   , "narrator": "透明みやび", "text": "深読みすれば千羽鶴が\nやったんやろうと\n思うちや。"},
        { "location": "58/TALK"   , "narrator": "透明みやび", "text": "卯月のフェノメノンは\n千羽鶴がコントロール\nしちゅうかもしれん。"},
        { "location": "59/TALK"   , "narrator": "アーヤ", "text": "そんなことできるの？"},
        { "location": "60/TALK"   , "narrator": "透明みやび", "text": "…あくまで憶測やき。"},
        { "location": "61/TALK"   , "narrator": "透明みやび", "text": "けんど、そう考えると\n色々辻褄が合うがよ。"},
        { "location": "62/TALK"   , "narrator": "アーヤ", "text": "他の人の意見が\n聞きたいわ。"},
        { "location": "64/TALK"   , "narrator": "アーヤ", "text": "……。"},
        { "location": "67/TALK"   , "narrator": "アーヤ", "text": "あれ？"},
        { "location": "68/TALK"   , "narrator": "アーヤ", "text": "どうして……？"},
        { "location": "69/TALK"   , "narrator": "アーヤ", "text": "$handle$さんの\nアカウントが\n見つからない？"},
        { "location": "70/TALK"   , "narrator": "アーヤ", "text": "リストをソートしても\nない…。"},
        { "location": "71/TALK"   , "narrator": "アーヤ", "text": "一覧で表示しても…。\nどういうことなの！？"},
        { "location": "72/TALK"   , "narrator": "透明みやび", "text": "アーヤ？"},
        { "location": "73/TALK"   , "narrator": "アーヤ", "text": "ごめんごめん。\nみやび以上に詳しい\n人間なんていないわね。"},
        { "location": "74/TALK"   , "narrator": "透明みやび", "text": "エリカさんなら\nうち以上にわかると\n思うけんど？"},
        { "location": "75/TALK"   , "narrator": "透明みやび", "text": "姉妹間の極秘\nホットラインなんぞ\n存在せんかいね？"},
        { "location": "76/TALK"   , "narrator": "透明みやび", "text": "そうしたら今の\n状態も――"},
        { "location": "77/TALK"   , "narrator": "アーヤ", "text": "ないわ。\nそんなもの。"},
        { "location": "78/TALK"   , "narrator": "アーヤ", "text": "$handle$さんとは\nもう連絡が\n取れないの？"},
        { "location": "79/TALK"   , "narrator": "アーヤ", "text": "お姉ちゃんならそれも\nどうにかしてくれたり\nするの？"},
        { "location": "80/TALK"   , "narrator": "アーヤ", "text": "でも本当に連絡なんて\nつけようがないもの。"},
        { "location": "81/TALK"   , "narrator": "アーヤ", "text": "私さっき約束した\nばっかりなのに。"},
        { "location": "82/TALK"   , "narrator": "アーヤ", "text": "絶対死なないって。\n$handle$さんと\n結婚するって。"},
        { "location": "83/TALK"   , "narrator": "アーヤ", "text": "どっちも\n実現できないの？"},
        { "location": "84/TALK"   , "narrator": "アーヤ", "text": "違う。"},
        { "location": "85/TALK"   , "narrator": "アーヤ", "text": "私は幸せになるの。\n私は幸せになるの。"},
        { "location": "86/TALK"   , "narrator": "透明みやび", "text": "アーヤ？"},
        { "location": "87/TALK"   , "narrator": "アーヤ", "text": "$handle$さん\n$handle$さん！"},
        { "location": "88/TALK"   , "narrator": "アーヤ", "text": "いくら探しても\n見つからないとか。"},
        { "location": "89/TALK"   , "narrator": "アーヤ", "text": "――嘘だ。"},
        { "location": "90/TALK"   , "narrator": "アーヤ", "text": "嫌だ嫌だ嫌だ\nそんなのやだ！！！！"},
        { "location": "91/TALK"   , "narrator": "アーヤ", "text": "私達ずっと一緒だって。\n絶対どこにも\n行かないって。"},
        { "location": "92/TALK"   , "narrator": "アーヤ", "text": "$handle$さんは\n絶対側にいてくれるって\n信じてたのに…！"},
        { "location": "127/SEL"   , "narrator": "", "text": "大変大変！！"},
        { "location": "128/TALK"  , "narrator": "昇華エヴェレット", "text": "ぐああああっ……！！\nたすけ…て……"},
        { "location": "129/ACT"   , "narrator": "", "text": "大変大変！！"},
        { "location": "131/SEL"   , "narrator": "", "text": "えっ！？　なに！？"},
        { "location": "132/ACT"   , "narrator": "", "text": "えっ！？　なに！？"},
        { "location": "134/TALK"  , "narrator": "昇華エヴェレット", "text": "$handle$…さん？"},
        { "location": "142/TALK"  , "narrator": "白烏", "text": "切断完了。"},
        { "location": "143/SEL"   , "narrator": "", "text": "エヴェレット！！"},
        { "location": "144/SEL"   , "narrator": "", "text": "白烏！！"},
        { "location": "145/ACT"   , "narrator": "", "text": "エヴェレット！！"},
        { "location": "146/TALK"  , "narrator": "白烏", "text": "あら、\n$handle$さん。"},
        { "location": "147/TALK"  , "narrator": "白烏", "text": "とりあえずは\nこれでひと安心ね。"},
        { "location": "148/SEL"   , "narrator": "", "text": "エヴェレットに何があったの！？"},
        { "location": "149/ACT"   , "narrator": "", "text": "エヴェレットに何があったの！？"},
        { "location": "151/TALK"  , "narrator": "白烏", "text": "発症して暴れたから\n切断したわ。"},
        { "location": "152/TALK"  , "narrator": "白烏", "text": "危ないところだった――"},
        { "location": "153/SEL"   , "narrator": "", "text": "消したの！？"},
        { "location": "154/ACT"   , "narrator": "", "text": "消したの！？"},
        { "location": "156/TALK"  , "narrator": "白烏", "text": "ええ。"},
        { "location": "157/SEL"   , "narrator": "", "text": "なんでそんなこと！"},
        { "location": "158/ACT"   , "narrator": "", "text": "なんでそんなこと！"},
        { "location": "160/TALK"  , "narrator": "白烏", "text": "……。"},
        { "location": "161/TALK"  , "narrator": "白烏", "text": "えっと。"},
        { "location": "162/TALK"  , "narrator": "白烏", "text": "邪魔だったから？"},
        { "location": "163/ACT"   , "narrator": "", "text": "白烏！！"},
        { "location": "165/TALK"  , "narrator": "白烏", "text": "あら、\n$handle$さん。"},
        { "location": "166/SEL"   , "narrator": "", "text": "エヴェレットに何をした！！"},
        { "location": "167/ACT"   , "narrator": "", "text": "エヴェレットに何をした！！"},
        { "location": "169/TALK"  , "narrator": "白烏", "text": "……。"},
        { "location": "170/TALK"  , "narrator": "白烏", "text": "えっと。"},
        { "location": "171/TALK"  , "narrator": "白烏", "text": "消した。\n邪魔だったから。"},
        { "location": "174/SEL"   , "narrator": "", "text": "許さない！"},
        { "location": "175/SEL"   , "narrator": "", "text": "何があったのかちゃんと教えて"},
        { "location": "176/ACT"   , "narrator": "", "text": "許さない！"},
        { "location": "178/TALK"  , "narrator": "白烏", "text": "えっと、なんか\n頭が混乱してきてない？"},
        { "location": "179/TALK"  , "narrator": "白烏", "text": "まあいいわ、\nどうぞどうぞ。"},
        { "location": "181/TALK"  , "narrator": "白烏", "text": "はいはい、\nどうぞどうぞ。"},
        { "location": "183/TALK"  , "narrator": "白烏", "text": "私も手加減は\nしないけど。"},
        { "location": "186/ACT"   , "narrator": "", "text": "何があったのかちゃんと教えて"},
        { "location": "187/TALK"  , "narrator": "白烏", "text": "面倒くさい。"},
        { "location": "189/TALK"  , "narrator": "白烏", "text": "どうして私のココロの中の\n問題を、貴方に説明\nしなくちゃいけないの？"},
        { "location": "191/SEL"   , "narrator": "", "text": "アーヤは$me$にとって大切な人だから"},
        { "location": "192/SEL"   , "narrator": "", "text": "顛末に興味があるので"},
        { "location": "193/ACT"   , "narrator": "", "text": "アーヤは$me$にとって大切な人だから"},
        { "location": "195/TALK"  , "narrator": "白烏", "text": "……。"},
        { "location": "196/TALK"  , "narrator": "白烏", "text": "じゃあ、私の事は？\n好き？　嫌い？"},
        { "location": "197/SEL"   , "narrator": "", "text": "好き"},
        { "location": "198/SEL"   , "narrator": "", "text": "嫌い"},
        { "location": "199/ACT"   , "narrator": "", "text": "好き"},
        { "location": "200/TALK"  , "narrator": "白烏", "text": "どこが？"},
        { "location": "201/SEL"   , "narrator": "", "text": "事務的なところ"},
        { "location": "202/SEL"   , "narrator": "", "text": "アーヤの一部なところ"},
        { "location": "203/SEL"   , "narrator": "", "text": "わからない"},
        { "location": "204/ACT"   , "narrator": "", "text": "事務的なところ"},
        { "location": "205/TALK"  , "narrator": "白烏", "text": "無理に作らなくても\nいいから。"},
        { "location": "206/ACT"   , "narrator": "", "text": "アーヤの一部なところ"},
        { "location": "207/TALK"  , "narrator": "白烏", "text": "それって、\n私のことが好きって事じゃ\nないんだけど。"},
        { "location": "208/ACT"   , "narrator": "", "text": "わからない"},
        { "location": "209/TALK"  , "narrator": "白烏", "text": "でしょうね。"},
        { "location": "211/TALK"  , "narrator": "白烏", "text": "貴方は別に、\n私の事は好きじゃない。\nいい？"},
        { "location": "212/ACT"   , "narrator": "", "text": "嫌い"},
        { "location": "213/TALK"  , "narrator": "白烏", "text": "正直者。\n何が嫌い？"},
        { "location": "214/SEL"   , "narrator": "", "text": "事務的なところ"},
        { "location": "215/SEL"   , "narrator": "", "text": "愛を囁いても応えてくれないところ"},
        { "location": "216/SEL"   , "narrator": "", "text": "わからない"},
        { "location": "217/ACT"   , "narrator": "", "text": "事務的なところ"},
        { "location": "218/TALK"  , "narrator": "白烏", "text": "まあ、そうでしょうね。"},
        { "location": "219/ACT"   , "narrator": "", "text": "愛を囁いても応えてくれないところ"},
        { "location": "220/TALK"  , "narrator": "白烏", "text": "まあ、\nそういう人格だしね。"},
        { "location": "221/ACT"   , "narrator": "", "text": "わからない"},
        { "location": "222/TALK"  , "narrator": "白烏", "text": "漠然と嫌いなのね。"},
        { "location": "224/TALK"  , "narrator": "白烏", "text": "いずれにせよ、\n貴方は私の事が嫌い。\nそうでしょう？"},
        { "location": "226/SEL"   , "narrator": "", "text": "はい"},
        { "location": "227/SEL"   , "narrator": "", "text": "いいえ"},
        { "location": "228/ACT"   , "narrator": "", "text": "はい"},
        { "location": "229/TALK"  , "narrator": "白烏", "text": "私がいるから\nアーヤが面倒くさい女に\nなっちゃってるの。"},
        { "location": "230/SEL"   , "narrator": "", "text": "それは嫌だな"},
        { "location": "231/SEL"   , "narrator": "", "text": "面倒くさいのが可愛い"},
        { "location": "232/ACT"   , "narrator": "", "text": "それは嫌だな"},
        { "location": "233/TALK"  , "narrator": "白烏", "text": "じゃあ、\n解決方法を１つ。"},
        { "location": "234/TALK"  , "narrator": "白烏", "text": "私をアーヤの心から\nたたき出せばいい。"},
        { "location": "236/ACT"   , "narrator": "", "text": "面倒くさいのが可愛い"},
        { "location": "237/TALK"  , "narrator": "白烏", "text": "でも私の事は\n嫌いなんでしょう？"},
        { "location": "238/TALK"  , "narrator": "白烏", "text": "だんだん何言ってるのか\nわからなくなって\nきてるわよ？"},
        { "location": "239/SEL"   , "narrator": "", "text": "白烏は嫌いだから面倒くさいのは可愛くない"},
        { "location": "240/SEL"   , "narrator": "", "text": "面倒くさいのが可愛いから白烏は大正義"},
        { "location": "241/ACT"   , "narrator": "", "text": "白烏は嫌いだから面倒くさいのは可愛くない"},
        { "location": "242/TALK"  , "narrator": "白烏", "text": "わかった。\nそれじゃ、私と貴方で\n戦いましょうか。"},
        { "location": "243/TALK"  , "narrator": "白烏", "text": "貴方が勝てば、\n私は國政綾水の心に\n影響を及ぼさなくなる。"},
        { "location": "244/TALK"  , "narrator": "白烏", "text": "貴方が負ければ\n私の心から追い出される。\nいい？"},
        { "location": "245/SEL"   , "narrator": "", "text": "もうそれでいいです"},
        { "location": "246/SEL"   , "narrator": "", "text": "ダメ"},
        { "location": "247/ACT"   , "narrator": "", "text": "もうそれでいいです"},
        { "location": "248/TALK"  , "narrator": "白烏", "text": "オーケー。\nそれじゃ、そうしましょ。"},
        { "location": "250/ACT"   , "narrator": "", "text": "ダメ"},
        { "location": "251/TALK"  , "narrator": "白烏", "text": "じゃあどうするの？\n言ってること\n矛盾してない？"},
        { "location": "252/SEL"   , "narrator": "", "text": "白烏はいなくちゃダメ"},
        { "location": "253/ACT"   , "narrator": "", "text": "白烏はいなくちゃダメ"},
        { "location": "255/TALK"  , "narrator": "白烏", "text": "じゃあ聞くけど。"},
        { "location": "256/TALK"  , "narrator": "白烏", "text": "私とエヴェレット、\nどっちかしか残れない場合\nエヴェレットを見捨てる？"},
        { "location": "259/ACT"   , "narrator": "", "text": "面倒くさいのが可愛いから白烏は大正義"},
        { "location": "260/TALK"  , "narrator": "白烏", "text": "あはははは！！\nおかしい！"},
        { "location": "261/TALK"  , "narrator": "白烏", "text": "もう自分が何言ってるか\n判らなくなってない？"},
        { "location": "264/ACT"   , "narrator": "", "text": "いいえ"},
        { "location": "265/TALK"  , "narrator": "白烏", "text": "はぁ～～～……。"},
        { "location": "266/TALK"  , "narrator": "白烏", "text": "なんかもう、\n疲れて来ちゃったわ。"},
        { "location": "267/SEL"   , "narrator": "", "text": "$me$も"},
        { "location": "268/SEL"   , "narrator": "", "text": "$me$は楽しい"},
        { "location": "269/ACT"   , "narrator": "", "text": "$me$も"},
        { "location": "270/TALK"  , "narrator": "白烏", "text": "じゃあそろそろ\nお終いにして、\n決着つけない？"},
        { "location": "271/SEL"   , "narrator": "", "text": "そうしよう"},
        { "location": "272/SEL"   , "narrator": "", "text": "そうしない"},
        { "location": "273/ACT"   , "narrator": "", "text": "そうしよう"},
        { "location": "274/TALK"  , "narrator": "白烏", "text": "オーケー。\nそれじゃお互い\n手加減なしで。"},
        { "location": "276/ACT"   , "narrator": "", "text": "そうしない"},
        { "location": "277/TALK"  , "narrator": "白烏", "text": "はい、わかりました。\nもう降参。"},
        { "location": "279/ACT"   , "narrator": "", "text": "$me$は楽しい"},
        { "location": "280/TALK"  , "narrator": "白烏", "text": "はぁぁ…本気！？"},
        { "location": "281/TALK"  , "narrator": "白烏", "text": "もういいわ、\n私が悪かったわよ。\n降参降参。"},
        { "location": "284/TALK"  , "narrator": "白烏", "text": "貴方の粘り勝ちね。"},
        { "location": "285/TALK"  , "narrator": "白烏", "text": "観念してちゃんと\nお話するわ。"},
        { "location": "286/TALK"  , "narrator": "白烏", "text": "……で、\n元の話って\nなんだっけ？"},
        { "location": "288/SEL"   , "narrator": "", "text": "白烏はめんどくさカワイイ源泉だという件"},
        { "location": "289/SEL"   , "narrator": "", "text": "白烏はアーヤにとって有害だという件"},
        { "location": "290/SEL"   , "narrator": "", "text": "白烏は何故罪を背負おうとするのかについて"},
        { "location": "291/SEL"   , "narrator": "", "text": "白烏は何故$me$と戦おうとするのかについて"},
        { "location": "292/SEL"   , "narrator": "", "text": "白烏が許しがたいことをした件について"},
        { "location": "293/SEL"   , "narrator": "", "text": "ごめん、忘れた…"},
        { "location": "294/ACT"   , "narrator": "", "text": "白烏はめんどくさカワイイ源泉だということ"},
        { "location": "295/TALK"  , "narrator": "白烏", "text": "……。\nそれ、ついさっき\n出たばかりの話題よね。"},
        { "location": "296/TALK"  , "narrator": "白烏", "text": "真面目に答えて？"},
        { "location": "298/ACT"   , "narrator": "", "text": "白烏はアーヤにとって有害だという件"},
        { "location": "299/TALK"  , "narrator": "白烏", "text": "そうだったわね。\nそれじゃ、アーヤの為に\n戦わなくちゃ。"},
        { "location": "300/TALK"  , "narrator": "白烏", "text": "とはいえ、私だって\nタダやられるのは嫌。\n手加減ナシで行くわよ？"},
        { "location": "302/ACT"   , "narrator": "", "text": "白烏は何故罪を背負おうとするのかについて"},
        { "location": "305/TALK"  , "narrator": "白烏", "text": "………。"},
        { "location": "306/TALK"  , "narrator": "白烏", "text": "……どうして？\nどうしてそう思ったの？"},
        { "location": "307/SEL"   , "narrator": "", "text": "理由聞いてるのに、ずっと答えず無理矢理戦わせようとしてた"},
        { "location": "308/ACT"   , "narrator": "", "text": "理由聞いてるのに、ずっと答えず無理矢理戦わせようとしてた"},
        { "location": "310/TALK"  , "narrator": "白烏", "text": "はぁ……。"},
        { "location": "311/TALK"  , "narrator": "白烏", "text": "まさかここまで\n追い詰められるなんて。"},
        { "location": "313/TALK"  , "narrator": "白烏", "text": "もう降参。\n本当に降参よ。"},
        { "location": "314/TALK"  , "narrator": "白烏", "text": "貴方、\n本っっっっっ当ーーーに、\n面倒くさい人ね。"},
        { "location": "315/SEL"   , "narrator": "", "text": "アーヤほどじゃないよ"},
        { "location": "316/ACT"   , "narrator": "", "text": "アーヤほどじゃないよ"},
        { "location": "318/TALK"  , "narrator": "白烏", "text": "え？"},
        { "location": "319/TALK"  , "narrator": "白烏", "text": "……ふふ。"},
        { "location": "320/TALK"  , "narrator": "白烏", "text": "あははははは！\nおかしい！"},
        { "location": "321/TALK"  , "narrator": "白烏", "text": "確かにそうかも！\n私ってホントに\n面倒くさい女だものね！"},
        { "location": "322/SEL"   , "narrator": "", "text": "…もしかして、内心キレてる？"},
        { "location": "323/ACT"   , "narrator": "", "text": "…もしかして、内心キレてる？"},
        { "location": "325/TALK"  , "narrator": "白烏", "text": "え？\nまさか。\n本当におかしくて！"},
        { "location": "326/TALK"  , "narrator": "白烏", "text": "貴方ってホントに、\n私の事よく見てるなって。"},
        { "location": "327/TALK"  , "narrator": "白烏", "text": "それに、とっても\n私の事を考えてくれてる。"},
        { "location": "328/TALK"  , "narrator": "白烏", "text": "だってそうでしょ？\nそうでなければ、\n今頃私と戦ってるわ。"},
        { "location": "329/TALK"  , "narrator": "白烏", "text": "イラッとするくらい\n貴方は粘り強かった。"},
        { "location": "330/TALK"  , "narrator": "白烏", "text": "まあ、貴方も\n相当イラッと\nしたでしょうけど。"},
        { "location": "331/TALK"  , "narrator": "白烏", "text": "……。"},
        { "location": "332/TALK"  , "narrator": "白烏", "text": "正直言うと、今でも\n何も考えずに私と戦って\n欲しかったと思ってる。"},
        { "location": "333/TALK"  , "narrator": "白烏", "text": "でも、きっと貴方は\n納得しないと思うし――"},
        { "location": "334/TALK"  , "narrator": "白烏", "text": "それは、こんな私でも\n綾水の一部として大事に\nしてくれてるからよね。"},
        { "location": "336/TALK"  , "narrator": "白烏", "text": "だから、私も貴方の愛に\n応えるべく、ちゃんと\n説明したいと思います。"},
        { "location": "337/TALK"  , "narrator": "白烏", "text": "エヴェレットは\n発症しちゃったのよ。"},
        { "location": "338/TALK"  , "narrator": "白烏", "text": "理由は、貴方の\nWAVEアカウントが\n無くなったから。"},
        { "location": "339/TALK"  , "narrator": "白烏", "text": "もう二度と、貴方と\n連絡を取り合えなくなる―"},
        { "location": "340/TALK"  , "narrator": "白烏", "text": "そんな気持ちが、最も\n貴方を愛する人格である\n彼女を発症させたの。"},
        { "location": "341/TALK"  , "narrator": "白烏", "text": "影響力の強い人格が\n発症すると、セルフ\nクランが影響を受けるわ。"},
        { "location": "342/TALK"  , "narrator": "白烏", "text": "だから私は、\n彼女を一時的に\n切り離した。"},
        { "location": "343/TALK"  , "narrator": "白烏", "text": "落ち着いたら\nまた戻すつもり\nだったけど。"},
        { "location": "344/SEL"   , "narrator": "", "text": "それって白烏全然悪くなくね？"},
        { "location": "345/SEL"   , "narrator": "", "text": "白烏って、セルフクラン発症させたい派じゃなかった？"},
        { "location": "346/ACT"   , "narrator": "", "text": "それって白烏全然悪くなくね？"},
        { "location": "347/TALK"  , "narrator": "白烏", "text": "そう思って欲しく\n無かったから、\n煙に巻いてたんだけどね。"},
        { "location": "348/TALK"  , "narrator": "白烏", "text": "でもきっと、今なら\nそんな事しなくても、\n賛同してくれるかな。"},
        { "location": "349/ACT"   , "narrator": "", "text": "白烏って、セルフクラン発症させたい派じゃなかった？"},
        { "location": "350/TALK"  , "narrator": "白烏", "text": "確かに前はそうだった。\nけど、今は違うわ。"},
        { "location": "351/TALK"  , "narrator": "白烏", "text": "それが原因で、\n水鏡の神子に消され\nかけたりしてるけど。"},
        { "location": "352/TALK"  , "narrator": "白烏", "text": "それでね、それに関係ある\nことで、協力して欲しい\nことがあるんだけど。"},
        { "location": "354/SEL"   , "narrator": "", "text": "なに？"},
        { "location": "355/ACT"   , "narrator": "", "text": "なに？"},
        { "location": "357/TALK"  , "narrator": "白烏", "text": "私、これから発症するから\n倒してもらえないかしら。"},
        { "location": "358/SEL"   , "narrator": "", "text": "なんでそうなるの！？"},
        { "location": "359/ACT"   , "narrator": "", "text": "なんでそうなるの！？"},
        { "location": "361/TALK"  , "narrator": "白烏", "text": "水鏡の神子を\n昇華させないために\n必要なことなのよ。"},
        { "location": "362/TALK"  , "narrator": "白烏", "text": "$handle$さんは、\nフェノメノンの発症には\n種が必要って話知ってる？"},
        { "location": "363/SEL"   , "narrator": "", "text": "聞いた事ある"},
        { "location": "364/SEL"   , "narrator": "", "text": "なんだっけそれ"},
        { "location": "365/ACT"   , "narrator": "", "text": "聞いた事ある"},
        { "location": "366/TALK"  , "narrator": "白烏", "text": "じゃあ、説明は不要ね。"},
        { "location": "367/ACT"   , "narrator": "", "text": "なんだっけそれ"},
        { "location": "368/TALK"  , "narrator": "白烏", "text": "発症することと、\nフェノメノンの発生は\n似て非なるもの。"},
        { "location": "369/TALK"  , "narrator": "白烏", "text": "セルフクランの発症は\nそれ自体は悟りに繋がる\nものでしかないの。"},
        { "location": "370/TALK"  , "narrator": "白烏", "text": "そこに「種」と\n「エネルギー」が加わり\nフェノメノンになる。"},
        { "location": "371/TALK"  , "narrator": "白烏", "text": "そうでなければ、\n今頃世界はフェノメノン\nだらけになってるわ。"},
        { "location": "373/TALK"  , "narrator": "白烏", "text": "その「種」というのが\n私そのものなのよ。"},
        { "location": "374/SEL"   , "narrator": "", "text": "なんだって！？"},
        { "location": "375/ACT"   , "narrator": "", "text": "なんだって！？"},
        { "location": "377/TALK"  , "narrator": "白烏", "text": "厳密には、\n1xと言われる人格が\n「種」そのものなの。"},
        { "location": "378/TALK"  , "narrator": "白烏", "text": "1xは、外の何かとの\nハイブリッド人格だって\n知ってるわよね。"},
        { "location": "379/TALK"  , "narrator": "白烏", "text": "その「外の何か」に\n「種」と言われるものが\n仕込まれてる。"},
        { "location": "380/TALK"  , "narrator": "白烏", "text": "すなわち私は\n爆弾持ちってこと。"},
        { "location": "381/SEL"   , "narrator": "", "text": "じゃあ、アーヤ達が戦ってきた発症者も1x人格がいたってこと！？"},
        { "location": "382/ACT"   , "narrator": "", "text": "じゃあ、アーヤ達が戦ってきた発症者も1x人格がいたってこと！？"},
        { "location": "384/TALK"  , "narrator": "白烏", "text": "そこまでは私にも\n解らないかな。"},
        { "location": "385/TALK"  , "narrator": "白烏", "text": "でも、エネルギーを\n呼び込む必要があるし、\n何かされてるとは思う。"},
        { "location": "386/TALK"  , "narrator": "白烏", "text": "とにかく、\n話を戻すと。"},
        { "location": "387/TALK"  , "narrator": "白烏", "text": "私から爆弾を\n除去しなければならない。"},
        { "location": "388/TALK"  , "narrator": "白烏", "text": "最も手っ取り早いのは、\n私を倒して、綾水に影響\nできなくすること。"},
        { "location": "389/TALK"  , "narrator": "白烏", "text": "貴方にお願いするのは\n酷かもだけど、今なら\n分かってもらえると思う。"},
        { "location": "390/TALK"  , "narrator": "白烏", "text": "私がいなくなることが\n綾水にとって、幸せに\n繋がる事だって。"},
        { "location": "391/TALK"  , "narrator": "白烏", "text": "……とまあね、そんな事を\n以前貴方に話そうとして\n消されたんだけど。"},
        { "location": "392/TALK"  , "narrator": "白烏", "text": "今回、やっと言えたわ。"},
        { "location": "393/TALK"  , "narrator": "白烏", "text": "というわけで、\n宜しくお願いします。"},
        { "location": "394/SEL"   , "narrator": "", "text": "わかりました"},
        { "location": "395/SEL"   , "narrator": "", "text": "白烏はどうして発症否定派になったの？"},
        { "location": "396/ACT"   , "narrator": "", "text": "わかりました"},
        { "location": "397/TALK"  , "narrator": "白烏", "text": "ありがとう。\nとっても嬉しい……"},
        { "location": "398/ACT"   , "narrator": "", "text": "白烏はどうして発症否定派になったの？"},
        { "location": "400/TALK"  , "narrator": "白烏", "text": "それは。"},
        { "location": "401/TALK"  , "narrator": "白烏", "text": "今の実験圃場に囚われて\nいる國政綾水と、貴方との\n人生も悪くないかなって。"},
        { "location": "402/TALK"  , "narrator": "白烏", "text": "軽い理由で\nごめんなさいね。"},
        { "location": "404/TALK"  , "narrator": "白烏", "text": "さて、それじゃ私、\n発症するから。"},
        { "location": "405/TALK"  , "narrator": "白烏", "text": "貴方の返事は聞かない。\nわかりきってるもの。"},
        { "location": "408/ACT"   , "narrator": "", "text": "白烏は何故$me$と戦おうとするのかについて"},
        { "location": "409/TALK"  , "narrator": "白烏", "text": "それは、\n私が貴方と戦いたいから。"},
        { "location": "410/TALK"  , "narrator": "白烏", "text": "というわけで。\nせっかくだから、\n戦っておきましょうか。"},
        { "location": "412/ACT"   , "narrator": "", "text": "白烏が許しがたいことをした件について"},
        { "location": "413/TALK"  , "narrator": "白烏", "text": "そう。正解。\n私は許しがたい事をした。"},
        { "location": "414/TALK"  , "narrator": "白烏", "text": "…って。\nずっとそう\n言ってたんだけど。"},
        { "location": "415/TALK"  , "narrator": "白烏", "text": "いいのよ？\n思う存分ぶん殴って。"},
        { "location": "416/TALK"  , "narrator": "白烏", "text": "私もやられないように\n応戦はするけどね。\nお互い手加減ナシで。"},
        { "location": "418/ACT"   , "narrator": "", "text": "ごめん、忘れた…"},
        { "location": "419/TALK"  , "narrator": "白烏", "text": "もう、仕方ないわね。"},
        { "location": "420/TALK"  , "narrator": "白烏", "text": "もう一度最初から\nお話してみる？"},
        { "location": "421/SEL"   , "narrator": "", "text": "そうする"},
        { "location": "422/SEL"   , "narrator": "", "text": "もう結構です"},
        { "location": "423/ACT"   , "narrator": "", "text": "そうする"},
        { "location": "424/TALK"  , "narrator": "白烏", "text": "オッケー。\nそれじゃ改めて――"},
        { "location": "427/ACT"   , "narrator": "", "text": "もう結構です"},
        { "location": "428/TALK"  , "narrator": "白烏", "text": "そうよね。"},
        { "location": "429/TALK"  , "narrator": "白烏", "text": "それじゃ、\nせっかくだし\n戦っておきましょうか。"},
        { "location": "437/TALK"  , "narrator": "白烏", "text": "じゃあ１つ聞くけど。"},
        { "location": "438/TALK"  , "narrator": "白烏", "text": "大事なアーヤの延命の為に\n私の行動が正しいとしたら\nエヴェレットは見捨てる？"},
        { "location": "440/SEL"   , "narrator": "", "text": "やむを得ず見捨てる"},
        { "location": "441/SEL"   , "narrator": "", "text": "絶対見捨てない"},
        { "location": "442/ACT"   , "narrator": "", "text": "やむを得ず見捨てる"},
        { "location": "443/TALK"  , "narrator": "白烏", "text": "なら私のとった行動と\n合致するじゃない。"},
        { "location": "444/TALK"  , "narrator": "白烏", "text": "実際そういう事だし、\nこれで万事解決じゃない？"},
        { "location": "447/ACT"   , "narrator": "", "text": "絶対見捨てない"},
        { "location": "448/TALK"  , "narrator": "白烏", "text": "それだとアーヤが\n助からないんだってば。"},
        { "location": "449/SEL"   , "narrator": "", "text": "例え話でしょ？"},
        { "location": "450/SEL"   , "narrator": "", "text": "絶対に両方とも助ける！"},
        { "location": "451/ACT"   , "narrator": "", "text": "例え話でしょ？"},
        { "location": "452/TALK"  , "narrator": "白烏", "text": "例えじゃないから。\nホントの話。"},
        { "location": "453/TALK"  , "narrator": "白烏", "text": "真剣に考えて。"},
        { "location": "455/ACT"   , "narrator": "", "text": "絶対に両方とも助ける！"},
        { "location": "456/TALK"  , "narrator": "白烏", "text": "その方法は\n１つだけあるけど。"},
        { "location": "457/TALK"  , "narrator": "白烏", "text": "私を消滅させること。\nどうする？"},
        { "location": "459/SEL"   , "narrator": "", "text": "ならばそれで"},
        { "location": "460/SEL"   , "narrator": "", "text": "それは絶対ダメ！"},
        { "location": "461/ACT"   , "narrator": "", "text": "ならばそれで"},
        { "location": "462/TALK"  , "narrator": "白烏", "text": "オッケー。\nそれじゃどうぞ。"},
        { "location": "463/TALK"  , "narrator": "白烏", "text": "私も手加減しないわよ。"},
        { "location": "465/ACT"   , "narrator": "", "text": "それは絶対ダメ！"},
        { "location": "466/TALK"  , "narrator": "白烏", "text": "はぁぁ……。\nなんかもう疲れてきたわ。"},
        { "location": "467/TALK"  , "narrator": "白烏", "text": "どうしてそこまで\n頑ななのよ……。"},
        { "location": "474/TALK"  , "narrator": "白烏", "text": "大丈夫だってば。\n國政綾水本体はちゃんと\n生きてるから。"},
        { "location": "475/TALK"  , "narrator": "白烏", "text": "これで問題解決でしょ？"},
        { "location": "477/ACT"   , "narrator": "", "text": "顛末に興味があるので"},
        { "location": "479/TALK"  , "narrator": "白烏", "text": "さっきも同じ事を\n聞いたような……。"},
        { "location": "480/TALK"  , "narrator": "白烏", "text": "そんなに私の顛末に\n興味あるの？\nどうして？"},
        { "location": "481/SEL"   , "narrator": "", "text": "好きな人に興味があるのは当然"},
        { "location": "482/SEL"   , "narrator": "", "text": "どんな死に様か見たい"},
        { "location": "483/ACT"   , "narrator": "", "text": "好きな人に興味があるのは当然"},
        { "location": "484/TALK"  , "narrator": "白烏", "text": "まあ、その気持ちは\n解るけど……。"},
        { "location": "485/TALK"  , "narrator": "白烏", "text": "でも、好きなら尚更\n放って置いてもらえた方が\n嬉しいんだけど。"},
        { "location": "486/TALK"  , "narrator": "白烏", "text": "そういうわけには\nいかないの？"},
        { "location": "488/ACT"   , "narrator": "", "text": "どんな死に様か見たい"},
        { "location": "489/TALK"  , "narrator": "白烏", "text": "じゃあ、戦いますか。"},
        { "location": "490/TALK"  , "narrator": "白烏", "text": "私も貴方がどんな風に\n犬死にするか見たいし。"},
        { "location": "494/TALK"  , "narrator": "白烏", "text": "好奇心は大事よね。"},
        { "location": "495/TALK"  , "narrator": "白烏", "text": "まあでも、\n大したことは\n無かったんだけどね。"},
        { "location": "496/TALK"  , "narrator": "白烏", "text": "私がエヴェレットに\nむかついて、ココロの\n中から追い出しただけ。"},
        { "location": "497/TALK"  , "narrator": "白烏", "text": "以上、おしまい。"},
        { "location": "500/TALK"  , "narrator": "白烏", "text": "で？\n貴方はどうしたいの？"},
        { "location": "501/SEL"   , "narrator": "", "text": "白烏を倒す"},
        { "location": "502/SEL"   , "narrator": "", "text": "エヴェレットを助ける"},
        { "location": "503/ACT"   , "narrator": "", "text": "白烏を倒す"},
        { "location": "504/TALK"  , "narrator": "白烏", "text": "はい、オッケー。"},
        { "location": "505/TALK"  , "narrator": "白烏", "text": "それじゃ、\nお互い手加減ナシでね。"},
        { "location": "507/ACT"   , "narrator": "", "text": "エヴェレットを助ける"},
        { "location": "508/TALK"  , "narrator": "白烏", "text": "どうやって助ける？"},
        { "location": "510/SEL"   , "narrator": "", "text": "まず、白烏がエヴェレットに何をしたか聞く"},
        { "location": "511/SEL"   , "narrator": "", "text": "まず、エヴェレットがどうなったのか聞く"},
        { "location": "512/ACT"   , "narrator": "", "text": "まず、白烏がエヴェレットに何をしたか聞く"},
        { "location": "513/TALK"  , "narrator": "白烏", "text": "さっきも話したとおり、\n精神の切断をしたのよ。"},
        { "location": "514/ACT"   , "narrator": "", "text": "まず、エヴェレットがどうなったのか聞く"},
        { "location": "515/TALK"  , "narrator": "白烏", "text": "さっきも話したとおり、\n精神が切断されたのよ。"},
        { "location": "517/SEL"   , "narrator": "", "text": "どうやったら精神を元に戻せるの？"},
        { "location": "518/SEL"   , "narrator": "", "text": "切断するとどうなるの？"},
        { "location": "519/ACT"   , "narrator": "", "text": "どうやったら精神を元に戻せるの？"},
        { "location": "520/TALK"  , "narrator": "白烏", "text": "私がその気になれば\nすぐに戻せるけど？"},
        { "location": "521/ACT"   , "narrator": "", "text": "切断するとどうなるの？"},
        { "location": "522/TALK"  , "narrator": "白烏", "text": "エヴェレットは人格として\n機能しなくなり、\n視覚的にも消えるわね。"},
        { "location": "524/SEL"   , "narrator": "", "text": "戻してください"},
        { "location": "525/SEL"   , "narrator": "", "text": "戻せ！"},
        { "location": "526/ACT"   , "narrator": "", "text": "戻してください"},
        { "location": "527/TALK"  , "narrator": "白烏", "text": "嫌です。\nそんなの解りきってる\nことでしょ？"},
        { "location": "528/TALK"  , "narrator": "白烏", "text": "私が、さっき、\n切断したばかりなのよ？"},
        { "location": "530/SEL"   , "narrator": "", "text": "力尽くで戻してやる"},
        { "location": "531/SEL"   , "narrator": "", "text": "どういう事情で切断なんかしたのさ"},
        { "location": "532/SEL"   , "narrator": "", "text": "うむむ……"},
        { "location": "533/ACT"   , "narrator": "", "text": "力尽くで戻してやる"},
        { "location": "534/TALK"  , "narrator": "白烏", "text": "いいわよ。\nこっちも\n手加減しないけど。"},
        { "location": "536/ACT"   , "narrator": "", "text": "どういう事情で切断なんかしたのさ"},
        { "location": "539/ACT"   , "narrator": "", "text": "うむむ……"},
        { "location": "540/TALK"  , "narrator": "白烏", "text": "私と戦って\n勝ったらエヴェレットを\n元に戻してもいいわよ？"},
        { "location": "541/SEL"   , "narrator": "", "text": "わかった、戦う"},
        { "location": "542/SEL"   , "narrator": "", "text": "いや、それはちょっと"},
        { "location": "543/ACT"   , "narrator": "", "text": "わかった、戦う"},
        { "location": "544/TALK"  , "narrator": "白烏", "text": "了解。\n手加減はナシよ！"},
        { "location": "546/ACT"   , "narrator": "", "text": "いや、それはちょっと"},
        { "location": "547/TALK"  , "narrator": "白烏", "text": "どういうこと？\nそれじゃ\nどうしたいの。"},
        { "location": "551/ACT"   , "narrator": "", "text": "戻せ！"},
        { "location": "552/TALK"  , "narrator": "白烏", "text": "恐喝？"},
        { "location": "553/TALK"  , "narrator": "白烏", "text": "いいわよ、\nそれじゃお望み通り\n戻してあげるわ。"},
        { "location": "554/TALK"  , "narrator": "白烏", "text": "貴方が私に\n戦って勝てたらね！"},
        { "location": "567/TALK"  , "narrator": "白烏", "text": "……。"},
        { "location": "568/TALK"  , "narrator": "白烏", "text": "我が力を\n全て解放する――"},
        { "location": "580/TALK"  , "narrator": "昇華白烏", "text": "$handle$さん。\n國政綾水のこと、\nどうかよろしくね。"},
        { "location": "581/TALK"  , "narrator": "昇華白烏", "text": "エヴェレットも、\n貴方が安心させて\nあげられるはず。"},
        { "location": "582/SEL"   , "narrator": "", "text": "色々ありがとう"},
        { "location": "583/SEL"   , "narrator": "", "text": "やっぱり止めようよ！"},
        { "location": "584/ACT"   , "narrator": "", "text": "色々ありがとう"},
        { "location": "585/TALK"  , "narrator": "昇華白烏", "text": "こちらこそ。"},
        { "location": "586/TALK"  , "narrator": "昇華白烏", "text": "お陰で、良心の呵責に\n苛まれずに済む。"},
        { "location": "587/ACT"   , "narrator": "", "text": "やっぱり止めようよ！"},
        { "location": "588/TALK"  , "narrator": "昇華白烏", "text": "大丈夫。"},
        { "location": "589/TALK"  , "narrator": "昇華白烏", "text": "私がどうなるかは、\n貴方の想い次第だし。"},
        { "location": "590/TALK"  , "narrator": "昇華白烏", "text": "それに、貴方が負けるって\nこともありますからね？"},
        { "location": "592/TALK"  , "narrator": "昇華白烏", "text": "改めて、\nいつも色々ありがとう。"},
        { "location": "593/TALK"  , "narrator": "昇華白烏", "text": "そして――"},
        { "location": "594/TALK"  , "narrator": "昇華白烏", "text": "どうか私の幸せのため、\nお手合わせ、\nよろしくお願いします！"},
        { "location": "596/SEL"   , "narrator": "", "text": "昇華した！？"},
        { "location": "597/ACT"   , "narrator": "", "text": "昇華した！？"},
        { "location": "599/TALK"  , "narrator": "昇華白烏", "text": "こうしなくちゃ\nフェアじゃないでしょ？"},
        { "location": "600/TALK"  , "narrator": "昇華白烏", "text": "かりそめの司書の姿じゃ\n貴方は私に指一本\n触れることはできない。"},
        { "location": "601/TALK"  , "narrator": "昇華白烏", "text": "けど、こうすることで\n貴方は私と戦うことが\nできるんだもの。"},
        { "location": "602/TALK"  , "narrator": "昇華白烏", "text": "それじゃ遠慮なく\n行かせてもらいます！"},
        { "location": "24/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>9月11日　 6:19 PM</color>\n文京ドーム内での戦闘中"},
