    "dir": "chap00/daydra/spev_notice_cd_01_07.js",
    "type": "",
    "info": {
        "story_id": "91057",
        "cid": "",
        "title": "007 アフターストーリー",
        "sub_title": "卯月神楽の思い出"
    },
    "entry":
    [
        { "location": "1804/DIALOG", "narrator": "", "text": "<color=green>某月某日　1:35 PM</color>\nとある休日、神楽坂トライナリー楽屋にて。"},
        { "location": "1805/TALK"  , "narrator": "神楽", "text": "――というわけで、\nイベント時には\n客席の方も解放して…。"},
        { "location": "1806/TALK"  , "narrator": "神楽", "text": "映画の上映や、\nちょっとした舞台として\n使おうと思ってるんです。"},
        { "location": "1807/TALK"  , "narrator": "真幌", "text": "なるほどな…。\nそのイベントに合った\n映画を流すということか。"},
        { "location": "1809/TALK"  , "narrator": "神楽", "text": "はい、その通りです。"},
        { "location": "1810/TALK"  , "narrator": "神楽", "text": "それで、イベントを\n行う際には、アーヤさんの\n助けも必要なんです。"},
        { "location": "1811/TALK"  , "narrator": "神楽", "text": "そのイベントに合わせた、\n限定メニューがあった方が\nいいと思いませんか？"},
        { "location": "1812/TALK"  , "narrator": "アーヤ", "text": "あ～…、なるほどね。\n確かに必要かも…。"},
        { "location": "1813/TALK"  , "narrator": "真幌", "text": "限定という言葉で\n注文を増やすつもりか？"},
        { "location": "1814/TALK"  , "narrator": "神楽", "text": "限定の魔力は\n凄まじいんですよ？"},
        { "location": "1815/TALK"  , "narrator": "神楽", "text": "つばめさん。\nこの前発売したメノウの\n限定ファンブック…。"},
        { "location": "1816/TALK"  , "narrator": "神楽", "text": "確か、二冊くらい\n買ってましたよね？"},
        { "location": "1818/TALK"  , "narrator": "つばめ", "text": "う、うん…限定なのに、\n破れたり汚れたりしたら\nイヤだったから、つい…。"},
        { "location": "1819/TALK"  , "narrator": "神楽", "text": "ね？"},
        { "location": "1820/TALK"  , "narrator": "真幌", "text": "なるほど。\n限定の言葉の魔力は\n理解した。"},
        { "location": "1822/TALK"  , "narrator": "アーヤ", "text": "やっぱり、卯月を\nイベント担当にしたのは\n正解だったわね。"},
        { "location": "1823/TALK"  , "narrator": "神楽", "text": "それは、開店後に\n実際のイベントを\n開催して…。"},
        { "location": "1824/TALK"  , "narrator": "神楽", "text": "その結果を見てからじゃ\nないと、わかりませんよ？"},
        { "location": "1827/TALK"  , "narrator": "つばめ", "text": "大丈夫だよ。\n絶対成功するって\n信じてるよ！"},
        { "location": "1829/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1831/TALK"  , "narrator": "神楽", "text": "じゃ、じゃあ、まずは\n開店イベントについて、\nアーヤさん…。"},
        { "location": "1832/TALK"  , "narrator": "神楽", "text": "あと、みやびさんも\n一緒に打ち合わせ\nしたいんですが。"},
        { "location": "1833/TALK"  , "narrator": "アーヤ", "text": "わかったわ。\nつばめ、みやびのこと\n呼んできてもらえる？"},
        { "location": "1834/TALK"  , "narrator": "つばめ", "text": "わかりましたー。"},
        { "location": "1835/TALK"  , "narrator": "神楽", "text": "お願いしますね、\nつばめさん。"},
        { "location": "1856/TALK"  , "narrator": "神楽", "text": "ふぅ…。\nお風呂、\n先にいただきましたー。"},
        { "location": "1857/TALK"  , "narrator": "つばめ", "text": "さっぱりした？"},
        { "location": "1858/TALK"  , "narrator": "神楽", "text": "はい。すみません、\n先にいただいちゃって。"},
        { "location": "1859/TALK"  , "narrator": "つばめ", "text": "お泊まりに来た人を\n待たせられないよ。"},
        { "location": "1860/TALK"  , "narrator": "神楽", "text": "そうじゃなくて、\n一緒に入りたかったなぁ、\nってことなんですけど…。"},
        { "location": "1861/TALK"  , "narrator": "つばめ", "text": "う、うちのお風呂に\n二人で入るのは\n狭いと思うよ？"},
        { "location": "1862/TALK"  , "narrator": "神楽", "text": "……そうでしょうか？"},
        { "location": "1864/TALK"  , "narrator": "つばめ", "text": "えぇっ！？\nえ、えっと…。"},
        { "location": "1865/TALK"  , "narrator": "つばめ", "text": "あ、そういえば！\n神楽ちゃんはアレ、\nなににするか決めたの？"},
        { "location": "1866/TALK"  , "narrator": "神楽", "text": "アレっていうと、\n食器のことですよね？"},
        { "location": "1867/TALK"  , "narrator": "神楽", "text": "みんなもう決めたのに、\n待たせてしまって\nますよね…。"},
        { "location": "1868/TALK"  , "narrator": "つばめ", "text": "あ、急かしてるわけじゃ\nないよ。"},
        { "location": "1870/TALK"  , "narrator": "つばめ", "text": "ただ、神楽ちゃんが\nなにを選ぶのか、\nちょっと気になって…。"},
        { "location": "1871/TALK"  , "narrator": "神楽", "text": "…マグカップ。"},
        { "location": "1872/TALK"  , "narrator": "つばめ", "text": "え？"},
        { "location": "1873/TALK"  , "narrator": "神楽", "text": "私、マグカップに\nしようかな？"},
        { "location": "1874/TALK"  , "narrator": "つばめ", "text": "マグカップ？"},
        { "location": "1875/TALK"  , "narrator": "神楽", "text": "はい。マグカップです。"},
        { "location": "1876/TALK"  , "narrator": "神楽", "text": "私の大好きなラノベに、\nちょっと憧れてるシーンが\nあって…。"},
        { "location": "1877/TALK"  , "narrator": "つばめ", "text": "どんなの？"},
        { "location": "1878/TALK"  , "narrator": "神楽", "text": "主人公とヒロインが、\n最後の最後でようやく\n結ばれて…。"},
        { "location": "1880/TALK"  , "narrator": "神楽", "text": "朝を迎えるんです。"},
        { "location": "1881/TALK"  , "narrator": "つばめ", "text": "えっ！？"},
        { "location": "1883/TALK"  , "narrator": "神楽", "text": "その時、二人揃って\n同じマグカップを使って、\nお茶を飲むんですけど…。"},
        { "location": "1884/TALK"  , "narrator": "神楽", "text": "そのシーンに、\nずっと前から憧れてて…。"},
        { "location": "1885/TALK"  , "narrator": "つばめ", "text": "そ、そうなんだ…。\nなんか、ちょっとだけ\n大人なラノベだね。"},
        { "location": "1887/TALK"  , "narrator": "神楽", "text": "興味がおありなら\nお貸ししますよ？"},
        { "location": "1888/TALK"  , "narrator": "つばめ", "text": "えぇっ！？\nえ、えっとぉ…。"},
        { "location": "1889/TALK"  , "narrator": "つばめ", "text": "わ、わたしも、\nお風呂行ってくるね！"},
        { "location": "1895/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1896/TALK"  , "narrator": "神楽", "text": "ごめんなさい、\nつばめさん。\nウソついちゃって…。"},
        { "location": "1897/SEL"   , "narrator": "（選択肢）", "text": "ウソだったの？"},
        { "location": "1898/ACT"   , "narrator": "", "text": "ウソだったの？"},
        { "location": "1916/TALK"  , "narrator": "神楽", "text": "呪"},
        { "location": "1917/TALK"  , "narrator": "神楽", "text": "ああ、不幸な$handle$。貴方に罪はありません。ただ貴方は前世のカルマを抱えているだけなのです。たまたまぴょんこのウソバレの瞬間に立ち会ってしまい、その真実を知ってしまっただけなのです。それを知った者は呪われ、未来永劫、何千回何万回輪廻転生しようとも、苦しみ続ける魂となってしまうのです。"},
        { "location": "1918/TALK"  , "narrator": "神楽", "text": "呪呪呪呪呪呪呪呪呪"},
        { "location": "1920/SEL"   , "narrator": "（選択肢）", "text": "ごめんなさい"},
        { "location": "1921/SEL"   , "narrator": "（選択肢）", "text": "いつも見てるのくらい知ってるでしょ"},
        { "location": "1922/ACT"   , "narrator": "", "text": "ごめんなさい"},
        { "location": "1923/TALK"  , "narrator": "神楽", "text": "冗談ぴょん♪"},
        { "location": "1924/TALK"  , "narrator": "神楽", "text": "ああー$handle$のかわいさに癒されるーーー"},
        { "location": "1925/ACT"   , "narrator": "", "text": "いつも見てるのくらい知ってるでしょ"},
        { "location": "1926/TALK"  , "narrator": "神楽", "text": "うざ"},
        { "location": "1927/TALK"  , "narrator": "神楽", "text": "だいたい人のプライバシー勝手に覗き見ておいて何その態度"},
        { "location": "1928/TALK"  , "narrator": "神楽", "text": "どうせ今の姿だって見えてるんでしょラッキースケベ"},
        { "location": "1929/TALK"  , "narrator": "神楽", "text": "あなたがわざとやってるわけじゃないのもわかってるし、それを回避できないのもわかってるけど、その自覚あるならもうちょっと言い方ってものがあるとおもうんだけど、ホントしねよ"},
        { "location": "1931/TALK"  , "narrator": "神楽", "text": "まあ、さっきの理由がウソっていうのは本当"},
        { "location": "1932/TALK"  , "narrator": "神楽", "text": "真実は別の扉の中に"},
        { "location": "1933/TALK"  , "narrator": "神楽", "text": "そしてその扉は、月神楽にしか開くことのできない固い封印によって護られているのです"},
        { "location": "1934/TALK"  , "narrator": "神楽", "text": "ですから仕方ないのです。嘘をついたわけではなく、封印の放つ呪いによって、ぴょんこは先ほどの理由こそが真実であると思い込まされているのですから"},
        { "location": "1935/TALK"  , "narrator": "神楽", "text": "そうしないと、月神楽が悶え死んでしまうのです！！！！！！！"},
        { "location": "1937/SEL"   , "narrator": "（選択肢）", "text": "で、本当の理由は？"},
        { "location": "1938/SEL"   , "narrator": "（選択肢）", "text": "月神楽が悶え死ぬ様を見て萌え死にたい者がここにいます！！"},
        { "location": "1939/ACT"   , "narrator": "", "text": "で、本当の理由は？"},
        { "location": "1940/TALK"  , "narrator": "神楽", "text": "つまんねー\nのれよ"},
        { "location": "1941/TALK"  , "narrator": "神楽", "text": "直訳：人に言うのが恥ずかしいから言いたくない"},
        { "location": "1942/TALK"  , "narrator": "神楽", "text": "わかれ"},
        { "location": "1943/TALK"  , "narrator": "神楽", "text": "いくら人生経験浅かったとしてもわかれ、それくらい"},
        { "location": "1945/SEL"   , "narrator": "（選択肢）", "text": "わかってるけど知りたいから聞いた"},
        { "location": "1946/SEL"   , "narrator": "（選択肢）", "text": "不器用でごめんね？"},
        { "location": "1947/ACT"   , "narrator": "", "text": "わかってるけど知りたいから聞いた"},
        { "location": "1950/TALK"  , "narrator": "神楽", "text": "絶対言わない"},
        { "location": "1951/TALK"  , "narrator": "神楽", "text": "じゃあね、ばいばい"},
        { "location": "1962/TALK"  , "narrator": "神楽", "text": "……はぁ。"},
        { "location": "1964/ACT"   , "narrator": "", "text": "不器用でごめんね？"},
        { "location": "1965/TALK"  , "narrator": "神楽", "text": "知ってた"},
        { "location": "1966/TALK"  , "narrator": "神楽", "text": "モチベ下がりまくりだったけど、ちょっと復活した"},
        { "location": "1967/TALK"  , "narrator": "神楽", "text": "だから教えてあげる"},
        { "location": "1969/ACT"   , "narrator": "", "text": "月神楽が悶え死ぬ様を見て萌え死にたい者がここにいます！！"},
        { "location": "1970/TALK"  , "narrator": "神楽", "text": "悶え無理心中！！！"},
        { "location": "1971/TALK"  , "narrator": "神楽", "text": "いやでも、そんないうほど大したものじゃないし、萌え死ぬとか多分ないと思う"},
        { "location": "1973/SEL"   , "narrator": "（選択肢）", "text": "わくわく！！"},
        { "location": "1974/ACT"   , "narrator": "", "text": "わくわく！！"},
        { "location": "1978/TALK"  , "narrator": "神楽", "text": "ハードルあげちゃったぴょん"},
        { "location": "1979/TALK"  , "narrator": "神楽", "text": "けどそこまで言うからには話すけど、共に呪いも放つから苦しむがよい"},
        { "location": "1984/TALK"  , "narrator": "神楽", "text": "私達がドームで戦った後のこと"},
        { "location": "1985/TALK"  , "narrator": "神楽", "text": "あの後みんなで"},
        { "location": "1986/TALK"  , "narrator": "神楽", "text": "劇場の楽屋で一泊したの"},
        { "location": "1987/TALK"  , "narrator": "神楽", "text": "みんなで雑魚寝"},
        { "location": "1989/SEL"   , "narrator": "（選択肢）", "text": "マグカップ関係なくない？"},
        { "location": "1990/ACT"   , "narrator": "", "text": "マグカップ関係なくない？"},
        { "location": "1992/TALK"  , "narrator": "神楽", "text": "まだ話の途中だぴょん"},
        { "location": "1993/TALK"  , "narrator": "神楽", "text": "雑魚寝＝睡眠となれば次に来るのは"},
        { "location": "1995/SEL"   , "narrator": "（選択肢）", "text": "…くるのは？"},
        { "location": "1996/SEL"   , "narrator": "（選択肢）", "text": "百●展開キタコレ！"},
        { "location": "1997/ACT"   , "narrator": "", "text": "…くるのは？"},
        { "location": "1998/TALK"  , "narrator": "神楽", "text": "当然目覚め"},
        { "location": "2001/TALK"  , "narrator": "神楽", "text": "その時に"},
        { "location": "2002/TALK"  , "narrator": "神楽", "text": "みんなでお茶を飲んだんですよ"},
        { "location": "2003/TALK"  , "narrator": "神楽", "text": "劇場に置いてあるみんなのマグカップで"},
        { "location": "2005/TALK"  , "narrator": "神楽", "text": "私は部屋の隅でずっと小さくなっていたんだけど、アーヤさんが紅茶いれてくれて"},
        { "location": "2006/TALK"  , "narrator": "神楽", "text": "ちゃんと眠れた？って声かけてくれて"},
        { "location": "2009/TALK"  , "narrator": "神楽", "text": "裏切り者の私のことを"},
        { "location": "2010/TALK"  , "narrator": "神楽", "text": "みんな責めもしないで"},
        { "location": "2011/TALK"  , "narrator": "神楽", "text": "受け入れてくれて"},
        { "location": "2014/TALK"  , "narrator": "神楽", "text": "図々しい話かもしれないけど"},
        { "location": "2015/TALK"  , "narrator": "神楽", "text": "私もみんなの仲間なんだって実感しちゃって"},
        { "location": "2018/TALK"  , "narrator": "神楽", "text": "以上"},
        { "location": "2019/TALK"  , "narrator": "神楽", "text": "返信不要"},
        { "location": "2020/TALK"  , "narrator": "神楽", "text": "呪いは郵送しておきます"},
        { "location": "2031/TALK"  , "narrator": "神楽", "text": "……。"},
        { "location": "2032/ACT"   , "narrator": "", "text": "百●展開キタコレ！"},
        { "location": "2033/TALK"  , "narrator": "神楽", "text": "ふざけんなクズ"},
        { "location": "2044/TALK"  , "narrator": "神楽", "text": "……はぁ。"}
    ]
}
