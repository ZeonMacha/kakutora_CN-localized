{
    "dir": "chap00/battle/btev_sc_05_00_01.js",
    "type": "",
    "info": {
        "story_id": "56",
        "cid": "",
        "title": "【EXストーリー】粛清の刃",
        "sub_title": "コネクトストーリー"
    },
    "entry":
    [
        { "location": "6/SCENARIO", "narrator": "", "text": "【導入】ヒストンシャペロン"},
        { "location": "12/DIALOG" , "narrator": "", "text": "<size=40>CURAN STORY. 03</size>\nAYAMI KUNIMASA\n\n<size=45>武島ちづる</size>\n<size=35>～美しい国～</size>"},
        { "location": "28/TALK"   , "narrator": "アーヤ", "text": "いらっしゃい。\n待ってたわ。\n$handle$さん。"},
        { "location": "29/TALK"   , "narrator": "アーヤ", "text": "ここは、私たち\nトライナリーと、\nクランたちとの交差点。"},
        { "location": "30/TALK"   , "narrator": "アーヤ", "text": "ココロとココロが\n出逢い、共鳴し、\nそして繋がりあう場所。"},
        { "location": "38/SEL"    , "narrator": "（選択肢）", "text": "概要説明を飛ばす"},
        { "location": "39/SEL"    , "narrator": "（選択肢）", "text": "もう一度聞く"},
        { "location": "40/ACT"    , "narrator": "", "text": "概要説明を飛ばす"},
        { "location": "41/TALK"   , "narrator": "アーヤ", "text": "というわけで、\n早速今回のクランを\n紹介するわね。"},
        { "location": "43/ACT"    , "narrator": "", "text": "もう一度聞く"},
        { "location": "48/TALK"   , "narrator": "アーヤ", "text": "ここでは、普段私たちを\n助けてくれるサーバント\nクランを紹介するわね。"},
        { "location": "49/TALK"   , "narrator": "アーヤ", "text": "それから貴方が直接\n彼女たちと繋がれる\nよう、手続きをするわ。"},
        { "location": "50/SEL"    , "narrator": "（選択肢）", "text": "アニメのクランが使えるようになる？"},
        { "location": "51/ACT"    , "narrator": "", "text": "アニメのクランが使えるようになる？"},
        { "location": "53/TALK"   , "narrator": "アーヤ", "text": "そうね。\n手続きが無事に\n完了すればね。"},
        { "location": "54/TALK"   , "narrator": "アーヤ", "text": "ここでは一度に一人だけ\nクランを紹介していくわ。"},
        { "location": "55/TALK"   , "narrator": "アーヤ", "text": "そして彼女との【儀式】\nによって、貴方とココロを\n繋げるの。"},
        { "location": "56/TALK"   , "narrator": "アーヤ", "text": "【儀式】は『コネクト』\nと『シンクロ』の２つ。"},
        { "location": "58/TALK"   , "narrator": "アーヤ", "text": "『コネクト』は、貴方と\nクランが物理的に繋がる\nための儀式。"},
        { "location": "59/TALK"   , "narrator": "アーヤ", "text": "バトルをして\n彼女と貴方の中にある、\n抵抗勢力を無力化するの。"},
        { "location": "61/TALK"   , "narrator": "アーヤ", "text": "次の『シンクロ』では、\nクランの過去を知り、\n共感する必要があるわ。"},
        { "location": "62/TALK"   , "narrator": "アーヤ", "text": "これは、クランの過去の\n物語をシェアすること。\n心が通じあうために必要。"},
        { "location": "64/TALK"   , "narrator": "アーヤ", "text": "ここまで、\nわかったかな？"},
        { "location": "65/TALK"   , "narrator": "アーヤ", "text": "もし、入るセクターを\n間違えていたなら\n今からでも退場できるわ。"},
        { "location": "66/SEL"    , "narrator": "（選択肢）", "text": "ううん、先に進む"},
        { "location": "67/SEL"    , "narrator": "（選択肢）", "text": "間違えた！　退場する！"},
        { "location": "68/SEL"    , "narrator": "（選択肢）", "text": "お姉さん口調なのは何で？"},
        { "location": "69/ACT"    , "narrator": "", "text": "ううん、先に進む"},
        { "location": "70/TALK"   , "narrator": "アーヤ", "text": "わかったわ。\nじゃあ早速、今回の\nクランを紹介するわね。"},
        { "location": "71/ACT"    , "narrator": "", "text": "間違えた！　退場する！"},
        { "location": "72/TALK"   , "narrator": "アーヤ", "text": "あら。\nおっちょこちょいね。"},
        { "location": "73/TALK"   , "narrator": "アーヤ", "text": "じゃ、ここで\nお別れね。"},
        { "location": "75/TALK"   , "narrator": "アーヤ", "text": "また気が向いたら\n来ればいいわ。"},
        { "location": "76/TALK"   , "narrator": "アーヤ", "text": "$handle$さんと\nわたしに、\n素敵なココロの旅を。"},
        { "location": "78/ACT"    , "narrator": "", "text": "お姉さん口調なのは何で？"},
        { "location": "80/TALK"   , "narrator": "アーヤ", "text": "そういうつもりでも\nなかったんだけど…。"},
        { "location": "81/TALK"   , "narrator": "アーヤ", "text": "ナビゲーター\nらしくしようと\n思ったのよ。"},
        { "location": "82/TALK"   , "narrator": "アーヤ", "text": "デリケートな\n話なんかもあるから\nこんな感じで行くわね。"},
        { "location": "83/TALK"   , "narrator": "アーヤ", "text": "それでは早速、今回の\nクランを紹介するわ。"},
        { "location": "92/TALK"   , "narrator": "アーヤ", "text": "オープンプロセス、\n0x227番地から\n0xFFF番地へ。"},
        { "location": "93/TALK"   , "narrator": "アーヤ", "text": "共通意識野を経由、\n外部スフィアへ接続。"},
        { "location": "94/TALK"   , "narrator": "アーヤ", "text": "EXEC_SEEK_SECTOR\n=>Link() EXT_SPHERE/."},
        { "location": "119/TALK"  , "narrator": "アーヤ", "text": "シーク完了。"},
        { "location": "120/TALK"  , "narrator": "アーヤ", "text": "さて――。"},
        { "location": "122/TALK"  , "narrator": "アーヤ", "text": "今回、貴方に\n紹介するクランは\n<color=red>【ヒストンシャペロン】</color>。"},
        { "location": "124/TALK"  , "narrator": "アーヤ", "text": "千代田区永田町にて\n発症。"},
        { "location": "125/TALK"  , "narrator": "アーヤ", "text": "発症した人の名前は、\n武島ちづる、当時\n３４歳。"},
        { "location": "126/TALK"  , "narrator": "アーヤ", "text": "ココロファイルナンバー\nE02-350-82によれば、\n発症の原因は……"},
        { "location": "127/TALK"  , "narrator": "アーヤ", "text": "『真実を日本国民に、\nそして全世界に\n告げるため』。"},
        { "location": "128/TALK"  , "narrator": "アーヤ", "text": "なんて言うと\n抽象的すぎて\nわからないわね。"},
        { "location": "129/TALK"  , "narrator": "アーヤ", "text": "自分が秘書をしていた\n代議士の死が\n仕組まれたものだった。"},
        { "location": "130/TALK"  , "narrator": "アーヤ", "text": "そして自分自身も\n謂われのない汚職疑惑で\n逮捕された。"},
        { "location": "131/TALK"  , "narrator": "アーヤ", "text": "このままでは真実が\n闇に葬られてしまう\nという焦りと無念。"},
        { "location": "132/TALK"  , "narrator": "アーヤ", "text": "ならばこの身に\n代えてでも――と\n思ったのね。"},
        { "location": "133/TALK"  , "narrator": "アーヤ", "text": "その気持ち、よくわかる。"},
        { "location": "134/SEL"   , "narrator": "（選択肢）", "text": "アーヤらしいというか"},
        { "location": "135/SEL"   , "narrator": "（選択肢）", "text": "ひょっとして担当がアーヤなのって"},
        { "location": "136/ACT"   , "narrator": "", "text": "アーヤらしいというか"},
        { "location": "137/ACT"   , "narrator": "", "text": "ひょっとして担当がアーヤなのって"},
        { "location": "139/TALK"  , "narrator": "アーヤ", "text": "ええ。\nご推察通り。"},
        { "location": "140/TALK"  , "narrator": "アーヤ", "text": "このセクタでは、クランと\n一番相性がいい\nトライナリーが語るの。"},
        { "location": "141/TALK"  , "narrator": "アーヤ", "text": "シャペロンの語り手が\n私なのは、私が一番\nシャペロンに近いから。"},
        { "location": "142/TALK"  , "narrator": "アーヤ", "text": "だから他の子は\n他のトライナリーが\n担当するわ。"},
        { "location": "143/SEL"   , "narrator": "（選択肢）", "text": "シャペロンについてもっと教えて"},
        { "location": "144/ACT"   , "narrator": "", "text": "シャペロンについてもっと教えて"},
        { "location": "146/TALK"  , "narrator": "アーヤ", "text": "今はまだちょっと\n難しいわね。"},
        { "location": "147/TALK"  , "narrator": "アーヤ", "text": "$handle$さんが、\nシャペロンと精神を\n共有できたら。"},
        { "location": "148/TALK"  , "narrator": "アーヤ", "text": "もう少し\n話せることも\nあるけれど。"},
        { "location": "149/SEL"   , "narrator": "（選択肢）", "text": "わかった"},
        { "location": "150/SEL"   , "narrator": "（選択肢）", "text": "ケチだなー"},
        { "location": "151/SEL"   , "narrator": "（選択肢）", "text": "共有しないとダメ？"},
        { "location": "152/ACT"   , "narrator": "", "text": "わかった"},
        { "location": "153/TALK"  , "narrator": "アーヤ", "text": "よかった。\n$handle$さんは\nいいひとね。"},
        { "location": "154/ACT"   , "narrator": "", "text": "ケチだなー"},
        { "location": "155/TALK"  , "narrator": "アーヤ", "text": "違うわ。\n必要な過程\nだからよ。"},
        { "location": "156/ACT"   , "narrator": "", "text": "共有しないとダメ？"},
        { "location": "157/TALK"  , "narrator": "アーヤ", "text": "そうね。\nそうじゃないと\n意味がないから。"},
        { "location": "159/TALK"  , "narrator": "アーヤ", "text": "じゃあ復習ね。"},
        { "location": "160/TALK"  , "narrator": "アーヤ", "text": "まずは『コネクト』の\nプロセスから。"},
        { "location": "161/TALK"  , "narrator": "アーヤ", "text": "具体的には、\n彼女の抵抗する意志と\n戦うこと。"},
        { "location": "162/TALK"  , "narrator": "アーヤ", "text": "それが終われば、\n彼女は貴方に色々\n教えてくれるはず。"},
        { "location": "163/TALK"  , "narrator": "アーヤ", "text": "$handle$さんが\nそれを共有すれば、\n『シンクロ』は完了。"},
        { "location": "164/TALK"  , "narrator": "アーヤ", "text": "『コネクト』『シンクロ』\n両方完了することで、\n貴方と彼女は繋がるの。"},
        { "location": "165/SEL"   , "narrator": "（選択肢）", "text": "晴れて【シャペロン】が使えるってこと？"},
        { "location": "166/ACT"   , "narrator": "", "text": "晴れて【シャペロン】が使えるってこと？"},
        { "location": "168/TALK"  , "narrator": "アーヤ", "text": "そう。"},
        { "location": "169/TALK"  , "narrator": "アーヤ", "text": "その時には私の話も\n少しだけ聞いて欲しい。"},
        { "location": "170/TALK"  , "narrator": "アーヤ", "text": "でもまずは『シンクロ』\nまで完了させること。\nそれが目標ね。"},
        { "location": "171/TALK"  , "narrator": "アーヤ", "text": "それでは早速、\nシャペロンの世界に\nアクセスしましょう。"},
        { "location": "173/TALK"  , "narrator": "アーヤ", "text": "$handle$さんと\n私とシャペロンに、\n素敵なココロの旅を！"}
    ]
}
