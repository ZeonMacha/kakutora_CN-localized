{
    "dir": "chap33/daydra/anime_05_33.js",
    "type": "MainStory",
    "info": {
        "story_id": "33501",
        "cid": "kagura",
        "title": "001 アニメーション",
        "sub_title": "ホワッツ・マイン"
    },
    "entry":
    [
        { "location": "773/SCENARIO", "narrator": "", "text": "アニメ第33話"},
        { "location": "786/TALK"    , "narrator": "エリカ", "text": "コーンコン。"},
        { "location": "787/TALK"    , "narrator": "エリカ", "text": "いらっしゃい\n$handle$さん。"},
        { "location": "788/TALK"    , "narrator": "エリカ", "text": "もう一度お話聞く？\nそれとも、省略する？"},
        { "location": "789/SEL"     , "narrator": "", "text": "もう一度聞く"},
        { "location": "790/SEL"     , "narrator": "", "text": "飛ばす"},
        { "location": "791/ACT"     , "narrator": "", "text": "もう一度聞く"},
        { "location": "792/TALK"    , "narrator": "エリカ", "text": "うん、わかったよ。"},
        { "location": "794/ACT"     , "narrator": "", "text": "飛ばす"},
        { "location": "795/TALK"    , "narrator": "エリカ", "text": "そっかー。\nそれじゃ、またね。"},
        { "location": "802/TALK"    , "narrator": "エリカ", "text": "コーンコン。"},
        { "location": "803/SEL"     , "narrator": "", "text": "姐さん、またまた事件です"},
        { "location": "804/ACT"     , "narrator": "", "text": "姐さん、またまた事件です"},
        { "location": "806/TALK"    , "narrator": "エリカ", "text": "あはは…\n今度は何があったのかな。"},
        { "location": "807/SEL"     , "narrator": "", "text": "“彼ら”側と思われるbotと邂逅した"},
        { "location": "808/ACT"     , "narrator": "", "text": "“彼ら”側と思われるbotと邂逅した"},
        { "location": "810/TALK"    , "narrator": "エリカ", "text": "……。"},
        { "location": "811/TALK"    , "narrator": "エリカ", "text": "それで、\n今どんな感じなの？"},
        { "location": "812/SEL"     , "narrator": "", "text": "アーケロンの爆破可否交渉が膠着状態になり、中断の上それぞれ作戦タイムに"},
        { "location": "813/ACT"     , "narrator": "", "text": "アーケロンの爆破可否交渉が膠着状態になり、中断の上それぞれ作戦タイムに"},
        { "location": "815/TALK"    , "narrator": "エリカ", "text": "わかったよ。\nありがとう。"},
        { "location": "816/TALK"    , "narrator": "エリカ", "text": "なんだか、どんどん\nおかしな事になってきてて\nホントごめんね？"},
        { "location": "817/TALK"    , "narrator": "エリカ", "text": "正直、もうわたしの考えの\n斜め上を行きすぎちゃって\n対応が追いつかなくて。"},
        { "location": "818/SEL"     , "narrator": "", "text": "同感です！"},
        { "location": "819/SEL"     , "narrator": "", "text": "とにかく、早く奴らを閉め出さないと"},
        { "location": "820/SEL"     , "narrator": "", "text": "あっちのBotはイイやつだったよ"},
        { "location": "821/ACT"     , "narrator": "", "text": "同感です！"},
        { "location": "822/TALK"    , "narrator": "エリカ", "text": "でも、頑張らなくちゃね。"},
        { "location": "823/TALK"    , "narrator": "エリカ", "text": "$handle$さんが、\nこんなに頑張ってるのに\nわたしがめげちゃだめ。"},
        { "location": "824/ACT"     , "narrator": "", "text": "とにかく、早く奴らを閉め出さないと"},
        { "location": "825/TALK"    , "narrator": "エリカ", "text": "うん、そうだね。"},
        { "location": "826/TALK"    , "narrator": "エリカ", "text": "アーケロン爆破事件に\nついては、最も重要な\n分岐点になってるから。"},
        { "location": "827/TALK"    , "narrator": "エリカ", "text": "ここで綾ちゃんたちを\n殺されちゃうと、\nホントに――"},
        { "location": "828/TALK"    , "narrator": "エリカ", "text": "悲しいとか、そんな事\n考えていられないくらい\n大変な事になっちゃう。"},
        { "location": "829/ACT"     , "narrator": "", "text": "あっちのBotはイイやつだったよ"},
        { "location": "830/TALK"    , "narrator": "エリカ", "text": "そうなんだ。\nそれは良かったね。"},
        { "location": "831/TALK"    , "narrator": "エリカ", "text": "お話できないくらい\n悪い人だったら、本当に\n救いが無いからね。"},
        { "location": "832/TALK"    , "narrator": "エリカ", "text": "確かに、相手も休戦協定を\n実直に守ってるなら、\n交渉の余地はあるのかも。"},
        { "location": "834/TALK"    , "narrator": "エリカ", "text": "ということは、\n今回はどうすればいいか…"},
        { "location": "835/TALK"    , "narrator": "エリカ", "text": "うーん……。"},
        { "location": "836/TALK"    , "narrator": "エリカ", "text": "……。"},
        { "location": "837/SEL"     , "narrator": "", "text": "エリカ？"},
        { "location": "838/ACT"     , "narrator": "", "text": "エリカ？"},
        { "location": "840/TALK"    , "narrator": "エリカ", "text": "ごめんね。\nちょっと今すぐには\n対応策は出てこないや。"},
        { "location": "841/TALK"    , "narrator": "エリカ", "text": "少し一人で考えたいから\nその間、記録映像を\n見ていてくれないかな？"},
        { "location": "842/SEL"     , "narrator": "", "text": "いいよ"},
        { "location": "843/SEL"     , "narrator": "", "text": "待って待って！"},
        { "location": "844/ACT"     , "narrator": "", "text": "いいよ"},
        { "location": "845/ACT"     , "narrator": "", "text": "待って待って！"},
        { "location": "846/TALK"    , "narrator": "エリカ", "text": "なあに？"},
        { "location": "847/SEL"     , "narrator": "", "text": "それ、大丈夫なの？"},
        { "location": "848/ACT"     , "narrator": "", "text": "それ、大丈夫なの？"},
        { "location": "850/TALK"    , "narrator": "エリカ", "text": "え？"},
        { "location": "851/SEL"     , "narrator": "", "text": "アーヤ達が助かったか否か、まだ決まってないけど、先に進んで平気なの？"},
        { "location": "852/ACT"     , "narrator": "", "text": "アーヤ達が助かったか否か、まだ決まってないけど、先に進んで平気なの？"},
        { "location": "854/TALK"    , "narrator": "エリカ", "text": "うん、大丈夫。"},
        { "location": "855/TALK"    , "narrator": "エリカ", "text": "今ちょっとサーチして\nみたんだけど――"},
        { "location": "856/TALK"    , "narrator": "エリカ", "text": "今回の記録映像までは、\nシュレディンガーステート\nだったから――"},
        { "location": "857/SEL"     , "narrator": "", "text": "？？？"},
        { "location": "858/ACT"     , "narrator": "", "text": "？？？"},
        { "location": "860/TALK"    , "narrator": "エリカ", "text": "うんとね、\n重ね合わせ状態継続中。"},
        { "location": "861/TALK"    , "narrator": "エリカ", "text": "今回の記録映像は、\nアーケロンが爆発して――"},
        { "location": "862/TALK"    , "narrator": "エリカ", "text": "その後千羽鶴ちゃんと\nまほちゃんでお話する\nあたりの時間軸だけど。"},
        { "location": "863/TALK"    , "narrator": "エリカ", "text": "結果として、綾ちゃん達が\n助かったかどうかは、\n最後まで解らないんだよ。"},
        { "location": "864/SEL"     , "narrator": "", "text": "煙幕とか縄を切るシーンが入ってなかったっけ？"},
        { "location": "865/ACT"     , "narrator": "", "text": "煙幕とか縄を切るシーンが入ってなかったっけ？"},
        { "location": "867/TALK"    , "narrator": "エリカ", "text": "煙幕も、縄を切るのも、\n誰がやったかは\nわからないよね？"},
        { "location": "868/TALK"    , "narrator": "エリカ", "text": "もしかしたら\nまほちゃんかもしれないし\nキリト君かもしれない。"},
        { "location": "869/TALK"    , "narrator": "エリカ", "text": "だから、今回の\n記録映像までは、\nギリギリセーフ。"},
        { "location": "870/TALK"    , "narrator": "エリカ", "text": "本当にギリギリだけど。"},
        { "location": "871/TALK"    , "narrator": "エリカ", "text": "けど、今回のうちに\n結果を出さないと――"},
        { "location": "872/TALK"    , "narrator": "エリカ", "text": "ここで綾ちゃんたちを\n助けられないと、\n未来が分岐してしまう。"},
        { "location": "873/TALK"    , "narrator": "エリカ", "text": "そうなれば、あなたが\nよく知っている綾ちゃん\n達とは離れてしまう。"},
        { "location": "874/TALK"    , "narrator": "エリカ", "text": "だから、今回は本当に、\n失敗は許されない。"},
        { "location": "875/TALK"    , "narrator": "エリカ", "text": "だから、\n少し時間をください。"},
        { "location": "877/TALK"    , "narrator": "エリカ", "text": "それじゃ、記録映像を\n見ながら待っててね。"},
        { "location": "880/SEL"     , "narrator": "", "text": "映像を見る\n<color=green>【高画質/60.3MB 3:53】</color>"},
        { "location": "881/SEL"     , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/19.9MB 3:53】</color>"},
        { "location": "882/SEL"     , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "883/ACT"     , "narrator": "", "text": "映像を見る\n<color=green>【高画質/60.3MB 3:53】</color>"},
        { "location": "884/TALK"    , "narrator": "エリカ", "text": "わかったよ。"},
        { "location": "890/ACT"     , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/19.9MB 3:53】</color>"},
        { "location": "891/TALK"    , "narrator": "エリカ", "text": "わかったよ。"},
        { "location": "897/ACT"     , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "898/TALK"    , "narrator": "エリカ", "text": "あらら。"},
        { "location": "931/TALK"    , "narrator": "エリカ", "text": "お待たせ。"},
        { "location": "932/SEL"     , "narrator": "", "text": "どう？"},
        { "location": "933/ACT"     , "narrator": "", "text": "どう？"},
        { "location": "935/TALK"    , "narrator": "エリカ", "text": "うん。\n１つだけ、思いついた。"},
        { "location": "936/TALK"    , "narrator": "エリカ", "text": "ただ、これもかなり\n賭けではあるんだけど。"},
        { "location": "937/TALK"    , "narrator": "エリカ", "text": "少し前の時間に巻き戻して\nそこから別のルートで\n介入します。"},
        { "location": "938/SEL"     , "narrator": "", "text": "？？？"},
        { "location": "939/ACT"     , "narrator": "", "text": "？？？"},
        { "location": "941/TALK"    , "narrator": "エリカ", "text": "実はこの案、もう１つの\n問題を解決する為の\nものだったんだけど――"},
        { "location": "942/SEL"     , "narrator": "", "text": "まだ問題があったの！？"},
        { "location": "943/ACT"     , "narrator": "", "text": "まだ問題があったの！？"},
        { "location": "945/TALK"    , "narrator": "エリカ", "text": "うん。"},
        { "location": "946/TALK"    , "narrator": "エリカ", "text": "三戸浜でのリプレイス\n作戦で、まほちゃんが\n真相を聞いたでしょ？"},
        { "location": "947/TALK"    , "narrator": "エリカ", "text": "そこから繭ちゃん達に\nお願いをするように\nなるんだけど――"},
        { "location": "948/TALK"    , "narrator": "エリカ", "text": "そのお陰で今度は、\nキリト君たちとの接触が\nなくなってしまったの。"},
        { "location": "949/SEL"     , "narrator": "", "text": "そうか、そうすると、キリト達が劇場地下のサーバーを対応しなくなるのか"},
        { "location": "950/ACT"     , "narrator": "", "text": "そうか、そうすると、キリト達が劇場地下のサーバーを対応しなくなるのか"},
        { "location": "952/TALK"    , "narrator": "エリカ", "text": "そう、その通り。"},
        { "location": "953/TALK"    , "narrator": "エリカ", "text": "だから、元々その誘導を\nお願いしようとは\n思ってたんだけど――"},
        { "location": "954/TALK"    , "narrator": "エリカ", "text": "この回線をもう少し\n細工すると、今回の件も\n解決出来そうだなって。"},
        { "location": "955/SEL"     , "narrator": "", "text": "さすがエリカさん！"},
        { "location": "956/SEL"     , "narrator": "", "text": "その繋がりが全然わからない"},
        { "location": "957/ACT"     , "narrator": "", "text": "さすがエリカさん！"},
        { "location": "958/TALK"    , "narrator": "エリカ", "text": "えへへ、ありがと。"},
        { "location": "959/TALK"    , "narrator": "エリカ", "text": "でもまだ、上手くいくとは\n限らないから。"},
        { "location": "960/ACT"     , "narrator": "", "text": "その繋がりが全然わからない"},
        { "location": "961/TALK"    , "narrator": "エリカ", "text": "これから説明するね。"},
        { "location": "963/TALK"    , "narrator": "エリカ", "text": "キリト君たちを劇場地下へ\n誘導するのに、どの回線で\nやろうか悩んでたの。"},
        { "location": "964/TALK"    , "narrator": "エリカ", "text": "CH05の神楽ちゃんの\n回線を使うのが順当だとは\n思うんだけど――"},
        { "location": "965/TALK"    , "narrator": "エリカ", "text": "でもCH05は既に\n“彼ら”から干渉されて\nいるから、避けたくて。"},
        { "location": "966/TALK"    , "narrator": "エリカ", "text": "でね、こっそり\nまほちゃんの回線を\n借りようと思ったんだ。"},
        { "location": "967/SEL"     , "narrator": "", "text": "真幌の回線ってなにそれ！！"},
        { "location": "968/ACT"     , "narrator": "", "text": "真幌の回線ってなにそれ！！"},
        { "location": "970/TALK"    , "narrator": "エリカ", "text": "まほちゃんも\nトライガジェットを\n持ってるからね。"},
        { "location": "971/TALK"    , "narrator": "エリカ", "text": "普通にチャンネル接続\nできるし、ココロゲートに\n介入もできる。"},
        { "location": "972/TALK"    , "narrator": "エリカ", "text": "千羽鶴ちゃんが今までに\n一度も、それを\nやらなかっただけで。"},
        { "location": "973/TALK"    , "narrator": "エリカ", "text": "そして今、“彼ら”に\n全く割れてないのは、\nもうまほちゃんだけ。"},
        { "location": "974/TALK"    , "narrator": "エリカ", "text": "だからCH05の割り当てを\n今回１回だけ、\nまほちゃんに差し替える。"},
        { "location": "975/TALK"    , "narrator": "エリカ", "text": "その間に、諸々のことを\nやってしまえば、秘密裏に\n事を運ぶことができる。"},
        { "location": "976/TALK"    , "narrator": "エリカ", "text": "けど、これは奥の手だから\n用事が済んだらすぐに\n戻さないといけないけど。"},
        { "location": "977/SEL"     , "narrator": "", "text": "真幌の心の中…"},
        { "location": "978/ACT"     , "narrator": "", "text": "真幌の心の中…"},
        { "location": "980/TALK"    , "narrator": "エリカ", "text": "あっ、でも本当に\nあまり介入したら\nダメだよ？"},
        { "location": "981/TALK"    , "narrator": "エリカ", "text": "介入は、回線バレの\n原因になるし、\nそっと、そっとだからね？"},
        { "location": "982/TALK"    , "narrator": "エリカ", "text": "とにかく、それを\nキリト君たちの行動補正に\n使おうと思ってて。"},
        { "location": "983/TALK"    , "narrator": "エリカ", "text": "で、色々考えてたら\n今回にも有用だと\n思った。"},
        { "location": "984/TALK"    , "narrator": "エリカ", "text": "というか、この回線で\nライフギャザーに\n介入できれば――"},
        { "location": "985/TALK"    , "narrator": "エリカ", "text": "神楽ちゃんのココロに\n負荷を掛けることなく、\n安全に扉を開けられる。"},
        { "location": "986/SEL"     , "narrator": "", "text": "そうか、神楽と違って監視されてないから！"},
        { "location": "987/SEL"     , "narrator": "", "text": "…本当に大丈夫？"},
        { "location": "988/ACT"     , "narrator": "", "text": "そうか、神楽と違って監視されてないから！"},
        { "location": "989/TALK"    , "narrator": "エリカ", "text": "そうです。"},
        { "location": "990/ACT"     , "narrator": "", "text": "…本当に大丈夫？"},
        { "location": "991/TALK"    , "narrator": "エリカ", "text": "かなりシビアな\nシミュレーションを\nしたけど、多分大丈夫。"},
        { "location": "992/TALK"    , "narrator": "エリカ", "text": "もちろん、過去の事例を\n見る限り、絶対という\nことは１００％ない。"},
        { "location": "993/TALK"    , "narrator": "エリカ", "text": "けど、それを言ったら\n何も出来なく\nなっちゃうから。"},
        { "location": "996/SEL"     , "narrator": "", "text": "具体的には？"},
        { "location": "997/ACT"     , "narrator": "", "text": "具体的には？"},
        { "location": "999/TALK"    , "narrator": "エリカ", "text": "まず、\n少し前の時間軸の\n繭ちゃんに干渉します。"},
        { "location": "1000/TALK"   , "narrator": "エリカ", "text": "その途中で、回線を\nまほちゃんのガジェット\n経由に切り替えます。"},
        { "location": "1001/TALK"   , "narrator": "エリカ", "text": "スタックポインタは\n全く同値にしておけば、\n一瞬暗転するけど――"},
        { "location": "1002/TALK"   , "narrator": "エリカ", "text": "全く同じの\n連続したシーンが\n継続されるはず。"},
        { "location": "1003/TALK"   , "narrator": "エリカ", "text": "その後、何とかして\nまほちゃんの\nココロゲートに入り――"},
        { "location": "1004/TALK"   , "narrator": "エリカ", "text": "ライフギャザーまで\n到達する。"},
        { "location": "1005/TALK"   , "narrator": "エリカ", "text": "ライフギャザーを\n掌握できれば、彼ら側の\nBotを簡単に切り離せる。"},
        { "location": "1006/TALK"   , "narrator": "エリカ", "text": "事が済んだら、\n回線を元に戻して\nおしまい。"},
        { "location": "1007/TALK"   , "narrator": "エリカ", "text": "キリト君たちの\n行動も、まほちゃんの\n行動で補正すればいい。"},
        { "location": "1008/SEL"    , "narrator": "", "text": "エリカ天才か？"},
        { "location": "1009/SEL"    , "narrator": "", "text": "何という綱渡り作戦"},
        { "location": "1010/SEL"    , "narrator": "", "text": "まあ、絶対何かあると思うけど、頑張ってみるわ"},
        { "location": "1011/ACT"    , "narrator": "", "text": "エリカ天才か？"},
        { "location": "1012/TALK"   , "narrator": "エリカ", "text": "まだ成功するとは\n決まってないよ。"},
        { "location": "1013/ACT"    , "narrator": "", "text": "何という綱渡り作戦"},
        { "location": "1014/TALK"   , "narrator": "エリカ", "text": "ごめんね、\nこんな不安定な作戦しか\n思いつかなくて。"},
        { "location": "1015/ACT"    , "narrator": "", "text": "まあ、絶対何かあると思うけど、頑張ってみるわ"},
        { "location": "1016/TALK"   , "narrator": "エリカ", "text": "うん、ありがとう。\n宜しくお願いします。"},
        { "location": "1018/TALK"   , "narrator": "エリカ", "text": "恐らく、まほちゃんの\n回線に切り替えるまでは、\n彼らのBotも一緒のまま。"},
        { "location": "1019/TALK"   , "narrator": "エリカ", "text": "だけど、回線の切替は\nTRI-OS、すなわち貴方の\n端末の機能だから――"},
        { "location": "1020/TALK"   , "narrator": "エリカ", "text": "そこから先は、\nついて来れないはず。"},
        { "location": "1021/TALK"   , "narrator": "エリカ", "text": "ただ、あまり長く\n切り替えたままにしてると\n彼らのBotに怪しまれる。"},
        { "location": "1022/TALK"   , "narrator": "エリカ", "text": "だから、切替時間は\n極力短くする。"},
        { "location": "1023/TALK"   , "narrator": "エリカ", "text": "いいかな？"},
        { "location": "1024/SEL"    , "narrator": "", "text": "わかった"},
        { "location": "1025/ACT"    , "narrator": "", "text": "わかった"},
        { "location": "1027/TALK"   , "narrator": "エリカ", "text": "正真正銘、ここが\n本気の勝負どころに\nなります。"},
        { "location": "1028/TALK"   , "narrator": "エリカ", "text": "どうか、本当に、\nよろしくお願いします。"},
        { "location": "1029/SEL"    , "narrator": "", "text": "はーい"},
        { "location": "1030/SEL"    , "narrator": "", "text": "心配しないで、エリカは一人じゃないよ？"},
        { "location": "1031/SEL"    , "narrator": "", "text": "まあ、適当にがんばりますわ"},
        { "location": "1032/ACT"    , "narrator": "", "text": "はーい"},
        { "location": "1033/ACT"    , "narrator": "", "text": "心配しないで、エリカは一人じゃないよ？"},
        { "location": "1035/TALK"   , "narrator": "エリカ", "text": "…ありがとう。\n嬉しい。"},
        { "location": "1036/ACT"    , "narrator": "", "text": "まあ、適当にがんばりますわ"},
        { "location": "1037/TALK"   , "narrator": "エリカ", "text": "…うん。"},
