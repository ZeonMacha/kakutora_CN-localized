        { "location": "472/TALK", "narrator": "神楽", "text": "意味不明すぎ"},
        { "location": "473/TALK", "narrator": "神楽", "text": "でもまあ"},
        { "location": "474/TALK", "narrator": "神楽", "text": "優しいぴょんこは聞いてあげるのだった"},
