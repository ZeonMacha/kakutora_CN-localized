    "entry":
    [
        { "location": "282/SCENARIO", "narrator": "", "text": "100_交渉は背中合わせで"},
        { "location": "307/TALK"    , "narrator": "みやび", "text": "おるかね"},
        { "location": "310/SEL"     , "narrator": "", "text": "待ってた"},
        { "location": "311/SEL"     , "narrator": "", "text": "何か用？"},
        { "location": "312/SEL"     , "narrator": "", "text": "いるよ"},
        { "location": "313/ACT"     , "narrator": "", "text": "待ってた"},
        { "location": "324/TALK"    , "narrator": "みやび", "text": "ふむ"},
        { "location": "325/TALK"    , "narrator": "みやび", "text": "よい心がけ"},
        { "location": "327/SEL"     , "narrator": "", "text": "話してくれてうれしいよ"},
        { "location": "328/SEL"     , "narrator": "", "text": "心配してた"},
        { "location": "329/ACT"     , "narrator": "", "text": "話してくれてうれしいよ"},
        { "location": "330/TALK"    , "narrator": "みやび", "text": "ふむ"},
        { "location": "331/TALK"    , "narrator": "みやび", "text": "左様か"},
        { "location": "332/ACT"     , "narrator": "", "text": "心配してた"},
        { "location": "333/TALK"    , "narrator": "みやび", "text": "そうなのか"},
        { "location": "335/TALK"    , "narrator": "みやび", "text": "色々考えたのだが"},
        { "location": "336/TALK"    , "narrator": "みやび", "text": "$handle$の本意はどこにあるのか"},
        { "location": "337/TALK"    , "narrator": "みやび", "text": "結局わからなんだ"},
        { "location": "339/SEL"     , "narrator": "", "text": "みやびが好きなだけ"},
        { "location": "340/SEL"     , "narrator": "", "text": "敵じゃないし"},
        { "location": "341/ACT"     , "narrator": "", "text": "みやびが好きなだけ"},
        { "location": "342/TALK"    , "narrator": "みやび", "text": "これはまた"},
        { "location": "343/TALK"    , "narrator": "みやび", "text": "悲劇のラブロマンス"},
        { "location": "344/ACT"     , "narrator": "", "text": "敵じゃないし"},
        { "location": "345/TALK"    , "narrator": "みやび", "text": "映画では"},
        { "location": "347/TALK"    , "narrator": "みやび", "text": "スパイは皆そう言うのだ"},
        { "location": "349/TALK"    , "narrator": "みやび", "text": "なんというか"},
        { "location": "350/TALK"    , "narrator": "みやび", "text": "話ができぬままなのもつまらん"},
        { "location": "351/TALK"    , "narrator": "みやび", "text": "というわけで"},
        { "location": "352/TALK"    , "narrator": "みやび", "text": "仲間になれ"},
        { "location": "354/SEL"     , "narrator": "", "text": "既に仲間だし"},
        { "location": "355/SEL"     , "narrator": "", "text": "恋人がいいな"},
        { "location": "356/SEL"     , "narrator": "", "text": "きびダンゴはもらえないの？"},
        { "location": "357/ACT"     , "narrator": "", "text": "既に仲間だし"},
        { "location": "358/TALK"    , "narrator": "みやび", "text": "ほう"},
        { "location": "360/TALK"    , "narrator": "みやび", "text": "そういう認識か"},
        { "location": "361/TALK"    , "narrator": "みやび", "text": "心に留めておこう"},
        { "location": "362/ACT"     , "narrator": "", "text": "恋人がいいな"},
        { "location": "363/TALK"    , "narrator": "みやび", "text": "それはない"},
        { "location": "364/TALK"    , "narrator": "みやび", "text": "なぜなら"},
        { "location": "365/TALK"    , "narrator": "みやび", "text": "理由はないからだ"},
        { "location": "366/ACT"     , "narrator": "", "text": "きびダンゴはもらえないの？"},
        { "location": "367/TALK"    , "narrator": "みやび", "text": "そのうちに"},
        { "location": "368/TALK"    , "narrator": "みやび", "text": "作ってやろう"},
        { "location": "369/TALK"    , "narrator": "みやび", "text": "機微ダンゴ"},
        { "location": "371/TALK"    , "narrator": "みやび", "text": "ひとまずは"},
        { "location": "372/TALK"    , "narrator": "みやび", "text": "これでも聞いておけ"},
        { "location": "373/TALK"    , "narrator": "みやび", "text": "恥ずかしいけど……うちの気持ちｖ"},
        { "location": "376/TALK"    , "narrator": "ボイスメール", "text": "甘くはないぞ天下り"},
        { "location": "394/ACT"     , "narrator": "", "text": "何か用？"},
        { "location": "397/TALK"    , "narrator": "みやび", "text": "いや"},
        { "location": "399/TALK"    , "narrator": "みやび", "text": "特には"},
        { "location": "400/ACT"     , "narrator": "", "text": "いるよ"},
        { "location": "402/TALK"    , "narrator": "みやび", "text": "なるほど"},
        { "location": "403/TALK"    , "narrator": "みやび", "text": "存在を確認"},
        { "location": "320/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>500pt.</b></color></size>\nアップしました！"},
        { "location": "388/DIALOG"  , "narrator": "Dialog_GETVoice", "text": "<color=green>【みやび】</color>のボイスメール\n<color=red>【甘くはないぞ天下り】</color>\nをゲットしました！"}
    ]
}
