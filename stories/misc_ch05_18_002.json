        { "location": "5724/SCENARIO", "narrator": "", "text": "レンチンっ★"},
        { "location": "5749/TALK"    , "narrator": "神楽", "text": "魔法みたいだね"},
        { "location": "5750/TALK"    , "narrator": "神楽", "text": "電子レンジは"},
        { "location": "5751/TALK"    , "narrator": "神楽", "text": "おお文明の利器"},
        { "location": "5753/SEL"     , "narrator": "", "text": "高度に発達した科学は魔法と区別が付かない"},
        { "location": "5754/SEL"     , "narrator": "", "text": "ちゃんと料理しなよｗ"},
        { "location": "5755/SEL"     , "narrator": "", "text": "ああ素晴らしき電子レンジ"},
        { "location": "5756/ACT"     , "narrator": "", "text": "高度に発達した科学は魔法と区別が付かない"},
        { "location": "5758/TALK"    , "narrator": "神楽", "text": "それだ！"},
        { "location": "5760/TALK"    , "narrator": "神楽", "text": "$handlek$もぴょんこも魔法使いだね！"},
        { "location": "5761/TALK"    , "narrator": "神楽", "text": "きゃるるるん（バンクカット変身音）"},
        { "location": "5762/ACT"     , "narrator": "", "text": "ちゃんと料理しなよｗ"},
        { "location": "5763/TALK"    , "narrator": "神楽", "text": "うっさい"},
        { "location": "5764/TALK"    , "narrator": "神楽", "text": "ばーかばーかばーか"},
        { "location": "5765/ACT"     , "narrator": "", "text": "ああ素晴らしき電子レンジ"},
        { "location": "5766/TALK"    , "narrator": "神楽", "text": "るる素晴らしき電子レンジ"},
        { "location": "5768/TALK"    , "narrator": "神楽", "text": "ぴょんこのトリビア★"},
        { "location": "5769/TALK"    , "narrator": "神楽", "text": "基本的に野菜の加熱はレンチンより蒸した方が甘くなるがトウモロコシだけは変わらない"},
        { "location": "5770/TALK"    , "narrator": "神楽", "text": "よってトウモロコシの加熱は皮付きのまま電子レンジで行うべし"},
        { "location": "5772/SEL"     , "narrator": "", "text": "へーへーへーへー"},
        { "location": "5773/SEL"     , "narrator": "", "text": "うち元々蒸し器ないから"},
        { "location": "5774/SEL"     , "narrator": "", "text": "神楽と一緒に食べたいな"},
        { "location": "5775/ACT"     , "narrator": "", "text": "へーへーへーへー"},
        { "location": "5776/TALK"    , "narrator": "神楽", "text": "半信半疑で試してみたら本当だったぴょん！"},
        { "location": "5777/ACT"     , "narrator": "", "text": "うち元々蒸し器ないから"},
        { "location": "5778/TALK"    , "narrator": "神楽", "text": "レンチン一択だね！"},
        { "location": "5779/ACT"     , "narrator": "", "text": "神楽と一緒に食べたいな"},
        { "location": "5781/TALK"    , "narrator": "神楽", "text": "ぴょんこのレンチン野菜が食べたいぴょん？"},
        { "location": "5782/TALK"    , "narrator": "神楽", "text": "わかったー腕によりをかけてレンチンするぴょん♪"},
        { "location": "5783/TALK"    , "narrator": "神楽", "text": "全部食べてね☆彡"},
        { "location": "5785/TALK"    , "narrator": "神楽", "text": "レレレレンジ"},
        { "location": "5786/TALK"    , "narrator": "神楽", "text": "でもぴょんこは普通に料理もできますぴょん"},
        { "location": "5787/TALK"    , "narrator": "神楽", "text": "見くびるんじゃねーぞ？"}
