{
    "dir": "chap06/daydra/dd_ch03_06_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "6305",
        "cid": "gabriella",
        "title": "005 メインストーリー",
        "sub_title": "出陣【Case：ガブリエラ】＜後編＞"
    },
    "entry":
    [
        { "location": "267/SCENARIO", "narrator": "", "text": "出陣【ギャヴィから見たCase】"},
        { "location": "296/TALK"    , "narrator": "ガブリエラ", "text": "…この手を握れば、\n仲直りできる…かな？"},
        { "location": "297/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "309/TALK"    , "narrator": "ガブリエラ", "text": "っ！？"},
        { "location": "312/TALK"    , "narrator": "ガブリエラ", "text": "絶対に嫌。\n子供じゃあるまいし。"},
        { "location": "313/TALK"    , "narrator": "つばめ", "text": "そ、そうですか…。"},
        { "location": "315/TALK"    , "narrator": "アーヤ", "text": "ギャヴィ、そんなに\nイジワル言わないの。"},
        { "location": "318/TALK"    , "narrator": "ガブリエラ", "text": "な、なによ？\nまた新人の味方するわけ？"},
        { "location": "319/TALK"    , "narrator": "アーヤ", "text": "新人だと思うなら、\n手くらい繋いであげても\nいいんじゃない？"},
        { "location": "322/TALK"    , "narrator": "ガブリエラ", "text": "むっ…。"},
        { "location": "323/TALK"    , "narrator": "つばめ", "text": "……。"},
        { "location": "324/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "325/TALK"    , "narrator": "ガブリエラ", "text": "やっぱりダメよ。"},
        { "location": "326/TALK"    , "narrator": "ガブリエラ", "text": "絶対に気を許したらダメ。\n自分の直感を信じなくちゃ。"},
        { "location": "327/TALK"    , "narrator": "ガブリエラ", "text": "やっぱり嫌よ。"},
        { "location": "328/TALK"    , "narrator": "ガブリエラ", "text": "フェノメノンの中で、\nわざわざリスクを冒すような\nことしたくないし。"},
        { "location": "330/TALK"    , "narrator": "つばめ", "text": "…？\nリスク……って…？"},
        { "location": "331/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "343/TALK"    , "narrator": "ガブリエラ", "text": "私って嫌な子かも"},
        { "location": "344/TALK"    , "narrator": "ガブリエラ", "text": "マルザンナもそう思う？"},
        { "location": "346/SEL"     , "narrator": "", "text": "そんなことないよ"},
        { "location": "347/ACT"     , "narrator": "", "text": "そんなことないよ"},
        { "location": "349/TALK"    , "narrator": "ガブリエラ", "text": "ありがとう"},
        { "location": "350/TALK"    , "narrator": "ガブリエラ", "text": "でも、そんなことあるわ"},
        { "location": "351/TALK"    , "narrator": "ガブリエラ", "text": "多分つばめは、怖いからだけじゃなくて"},
        { "location": "352/TALK"    , "narrator": "ガブリエラ", "text": "私のことを気遣って、言ってくれてるんだと思う"},
        { "location": "353/TALK"    , "narrator": "ガブリエラ", "text": "突っぱねた対応しちゃってるし"},
        { "location": "355/SEL"     , "narrator": "", "text": "つばめのことが嫌いなの？"},
        { "location": "356/ACT"     , "narrator": "", "text": "つばめのことが嫌いなの？"},
        { "location": "358/TALK"    , "narrator": "ガブリエラ", "text": "そうじゃないの"},
        { "location": "359/TALK"    , "narrator": "ガブリエラ", "text": "つばめのことは嫌いじゃないの"},
        { "location": "360/TALK"    , "narrator": "ガブリエラ", "text": "けど"},
        { "location": "361/TALK"    , "narrator": "ガブリエラ", "text": "凄く怖いの"},
        { "location": "362/TALK"    , "narrator": "ガブリエラ", "text": "あのドームでの戦いの時に見せたあの雰囲気"},
        { "location": "363/TALK"    , "narrator": "ガブリエラ", "text": "それに、あの目"},
        { "location": "364/TALK"    , "narrator": "ガブリエラ", "text": "ポーランドにいた頃に何度か見たことがあるの"},
        { "location": "365/TALK"    , "narrator": "ガブリエラ", "text": "あの目は"},
        { "location": "367/TALK"    , "narrator": "ガブリエラ", "text": "やっぱり、何でもない"},
        { "location": "368/TALK"    , "narrator": "ガブリエラ", "text": "今はフェノメノンのことに集中しなくちゃ"},
        { "location": "369/TALK"    , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "370/TALK"    , "narrator": "ガブリエラ", "text": "また後でお話聞いてね"},
        { "location": "415/TALK"    , "narrator": "アーヤ", "text": "…そろそろ出口ね。"},
        { "location": "416/TALK"    , "narrator": "アーヤ", "text": "各自、準備はいい？\n行くわよ！"},
        { "location": "427/DIALOG"  , "narrator": "Dialog_chapter_ch03", "text": "【04 レッドサイト】"}
    ]
}
