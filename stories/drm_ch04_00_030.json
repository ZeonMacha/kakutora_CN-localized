    "entry":
    [
        { "location": "379/SCENARIO", "narrator": "", "text": "それが事実、あれだったとして"},
        { "location": "391/TALK"    , "narrator": "みやび", "text": "推論に基づいて\n検証するしか\nないけんど。"},
        { "location": "392/TALK"    , "narrator": "みやび", "text": "うちだけでは解析の\n精度が上げられん…。"},
        { "location": "393/TALK"    , "narrator": "みやび", "text": "どうしたものか…。"},
        { "location": "398/TALK"    , "narrator": "みやび", "text": "どうぞー。"},
        { "location": "404/TALK"    , "narrator": "アーヤ", "text": "突然ごめんね。\n今、大丈夫？"},
        { "location": "406/TALK"    , "narrator": "みやび", "text": "どういたが？\n真剣な顔して。"},
        { "location": "407/TALK"    , "narrator": "アーヤ", "text": "……。\nやっぱり\nわかっちゃった？"},
        { "location": "410/TALK"    , "narrator": "アーヤ", "text": "これから\nすごく変なことを\n言うかもしれない。"},
        { "location": "413/TALK"    , "narrator": "アーヤ", "text": "でもまじめに\n考えてほしいの。"},
        { "location": "414/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "416/TALK"    , "narrator": "アーヤ", "text": "ううん。きっと、\n私よりみやびの方が\n先に気づいてる。"},
        { "location": "417/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "419/TALK"    , "narrator": "アーヤ", "text": "トライガジェットの\nＢｏｔについて。"},
        { "location": "421/TALK"    , "narrator": "アーヤ", "text": "ちょっとあれ、\n機械的じゃない\nところあるわよね？"},
        { "location": "422/TALK"    , "narrator": "みやび", "text": "いつ、\nそう思うた？"},
        { "location": "423/TALK"    , "narrator": "アーヤ", "text": "改めて考えなきゃって\n思ったのはこの前の\n映画の話の時。"},
        { "location": "424/TALK"    , "narrator": "みやび", "text": "アーヤが\n怖い話かと聞いた時の\nことかよ？"},
        { "location": "425/TALK"    , "narrator": "アーヤ", "text": "…そうね。"},
        { "location": "426/TALK"    , "narrator": "みやび", "text": "だったら\n言いたいことの\n想像はついちゅう。"},
        { "location": "427/TALK"    , "narrator": "みやび", "text": "Ｂｏｔは人間かも\nしれん、と\n言いたいろう。"},
        { "location": "429/TALK"    , "narrator": "アーヤ", "text": "……みやびの口から\n言ってくれて\nホッとしたわ。"},
        { "location": "430/TALK"    , "narrator": "アーヤ", "text": "自分の頭が\nおかしいのかもって\n思ってたから。"},
        { "location": "431/TALK"    , "narrator": "みやび", "text": "いや。"},
        { "location": "443/TALK"    , "narrator": "みやび", "text": "よう"},
        { "location": "445/TALK"    , "narrator": "みやび", "text": "相棒"},
        { "location": "447/SEL"     , "narrator": "", "text": "呼んだ？"},
        { "location": "448/SEL"     , "narrator": "", "text": "ＹＯ！　ＹＯ！　ラップだＹＯ！"},
        { "location": "449/SEL"     , "narrator": "", "text": "もっと色気のある呼びかけがいいなー"},
        { "location": "450/ACT"     , "narrator": "", "text": "呼んだ？"},
        { "location": "451/TALK"    , "narrator": "みやび", "text": "呼ばれたぞ"},
        { "location": "452/SEL"     , "narrator": "", "text": "そうみたい"},
        { "location": "453/SEL"     , "narrator": "", "text": "忙しいんだけど"},
        { "location": "454/SEL"     , "narrator": "", "text": "ひょっとして暇？"},
        { "location": "455/ACT"     , "narrator": "", "text": "そうみたい"},
        { "location": "456/TALK"    , "narrator": "みやび", "text": "他人事か"},
        { "location": "457/TALK"    , "narrator": "みやび", "text": "のらりくらりだの"},
        { "location": "458/SEL"     , "narrator": "", "text": "ひねもすのたりのたりだよ"},
        { "location": "459/ACT"     , "narrator": "", "text": "ひねもすのたりのたりだよ"},
        { "location": "460/TALK"    , "narrator": "みやび", "text": "そうか"},
        { "location": "461/TALK"    , "narrator": "みやび", "text": "それは失礼した"},
        { "location": "463/ACT"     , "narrator": "", "text": "忙しいんだけど"},
        { "location": "464/TALK"    , "narrator": "みやび", "text": "またまた"},
        { "location": "465/TALK"    , "narrator": "みやび", "text": "即答しておいて"},
        { "location": "466/SEL"     , "narrator": "", "text": "それはまた別問題"},
        { "location": "467/ACT"     , "narrator": "", "text": "それはまた別問題"},
        { "location": "468/TALK"    , "narrator": "みやび", "text": "なるほど"},
        { "location": "469/TALK"    , "narrator": "みやび", "text": "うまく問題をすり替えたな"},
        { "location": "471/ACT"     , "narrator": "", "text": "ひょっとして暇？"},
        { "location": "472/TALK"    , "narrator": "みやび", "text": "いや"},
        { "location": "474/TALK"    , "narrator": "みやび", "text": "絶賛大忙しぞね"},
        { "location": "475/SEL"     , "narrator": "", "text": "じゃあ失礼しますね"},
        { "location": "476/ACT"     , "narrator": "", "text": "じゃあ失礼しますね"},
        { "location": "477/TALK"    , "narrator": "みやび", "text": "空気を読んできおった"},
        { "location": "478/TALK"    , "narrator": "みやび", "text": "こざかしいの"},
        { "location": "481/ACT"     , "narrator": "", "text": "ＹＯ！　ＹＯ！　ラップだＹＯ！"},
        { "location": "482/TALK"    , "narrator": "みやび", "text": "ラッパーの風上にも置けん安易さ"},
        { "location": "483/SEL"     , "narrator": "", "text": "ラップは大衆芸術だからね"},
        { "location": "484/ACT"     , "narrator": "", "text": "ラップは大衆芸術だからね"},
        { "location": "485/TALK"    , "narrator": "みやび", "text": "キャッチーさが売りと"},
        { "location": "486/TALK"    , "narrator": "みやび", "text": "そういうことか"},
        { "location": "488/ACT"     , "narrator": "", "text": "もっと色気のある呼びかけがいいなー"},
        { "location": "489/TALK"    , "narrator": "みやび", "text": "これ以上色気づくと人類が滅ぶぞ"},
        { "location": "490/SEL"     , "narrator": "", "text": "みやびと$me$だけ残ればいいでしょ"},
        { "location": "491/ACT"     , "narrator": "", "text": "みやびと$me$だけ残ればいいでしょ"},
        { "location": "492/TALK"    , "narrator": "みやび", "text": "セカイ系"},
        { "location": "493/TALK"    , "narrator": "みやび", "text": "あるいはディストピア恋愛ドラマ"},
        { "location": "494/TALK"    , "narrator": "みやび", "text": "今回は遠慮しておこう"},
        { "location": "508/TALK"    , "narrator": "みやび", "text": "かなり突拍子もない\n会話をしても\nはぐらかしなし。"},
        { "location": "509/TALK"    , "narrator": "みやび", "text": "こんな会話パターンを\n用意するのは\n尋常ではないぞね。"},
        { "location": "510/TALK"    , "narrator": "みやび", "text": "人間だと考える方が\nうちには自然や。"},
        { "location": "511/TALK"    , "narrator": "アーヤ", "text": "……。"},
        { "location": "512/TALK"    , "narrator": "みやび", "text": "もちろん現時点では\nあくまで仮定の話や。"},
        { "location": "514/TALK"    , "narrator": "みやび", "text": "検証して確定するには\nアーヤの協力が\n必要ぞね。"},
        { "location": "517/TALK"    , "narrator": "アーヤ", "text": "私の？"},
        { "location": "518/TALK"    , "narrator": "みやび", "text": "Ｂｏｔとの会話ログ。\nそれを提供しちゃあ\nくれんろうか。"},
        { "location": "521/TALK"    , "narrator": "アーヤ", "text": "……！"},
        { "location": "522/TALK"    , "narrator": "みやび", "text": "プライバシーに\n関わることやきね。"},
        { "location": "523/TALK"    , "narrator": "みやび", "text": "決心がついたら、で\nええけんど。"},
        { "location": "525/TALK"    , "narrator": "アーヤ", "text": "……。"},
        { "location": "526/TALK"    , "narrator": "アーヤ", "text": "ちょっと、\n考えさせて。"},
        { "location": "527/TALK"    , "narrator": "みやび", "text": "……えい答えを\n期待しちょる。"},
        { "location": "390/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>5月某日　5:35 PM</color>\n放課後、寮とらいあんぐるのみやびの部屋にて。"}
    ]
