        "title": "SideStory002 ストーリー",
        "sub_title": "FILE01.閃光"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "東京編１話"},
        { "location": "16/DIALOG" , "narrator": "", "text": "<color=green>9月4日　 9:32 AM</color>\nとある日曜、附属学園校門前にて。"},
        { "location": "25/TALK"   , "narrator": "雛", "text": "はぁ…。"},
        { "location": "27/TALK"   , "narrator": "繭", "text": "…十回目。\nいい加減ウザいんだけど？"},
        { "location": "29/TALK"   , "narrator": "雛", "text": "だって、心配なんだよー。\nつばめちゃんからの連絡、\nまだ来ないし…。"},
        { "location": "30/TALK"   , "narrator": "雛", "text": "いつもだったら連絡も\nナシに、こんなに遅れる\nことないもん。"},
        { "location": "31/TALK"   , "narrator": "雛", "text": "ましてや今日は、\n遊びに行く約束だよ！？"},
        { "location": "32/TALK"   , "narrator": "繭", "text": "…………。"},
        { "location": "33/TALK"   , "narrator": "雛", "text": "そうだ。\nまゆちん、みやび先輩に\n聞いてみてよ。"},
        { "location": "34/TALK"   , "narrator": "キリト", "text": "聞くだけ無駄だぞ。"},
        { "location": "36/TALK"   , "narrator": "繭", "text": "えっ！？"},
        { "location": "40/TALK"   , "narrator": "キリト", "text": "多分、送っても返事は\n戻ってこないだろうし…。"},
        { "location": "43/TALK"   , "narrator": "雛", "text": "キリト！"},
        { "location": "46/TALK"   , "narrator": "キリト", "text": "おっす、数日振りだな。"},
        { "location": "47/TALK"   , "narrator": "雛", "text": "おっすじゃないよ！\nずっと連絡してたのに！？"},
        { "location": "48/TALK"   , "narrator": "キリト", "text": "わりぃ…。\n外部との連絡、\n禁止されててさ…。"},
        { "location": "49/TALK"   , "narrator": "繭", "text": "…………。"},
        { "location": "52/TALK"   , "narrator": "キリト", "text": "いや、俺を睨まれても\n困るんだけど…。"},
        { "location": "53/TALK"   , "narrator": "繭", "text": "なにを知ってる？"},
        { "location": "54/TALK"   , "narrator": "雛", "text": "え？"},
        { "location": "55/TALK"   , "narrator": "繭", "text": "返事が戻ってこないって、\nどういうこと？"},
        { "location": "56/TALK"   , "narrator": "キリト", "text": "…ここじゃ話せない。"},
        { "location": "57/TALK"   , "narrator": "キリト", "text": "ヒカルが屋上にいるから、\n付いてきてくれ。"},
        { "location": "73/TALK"   , "narrator": "雛", "text": "そんな…。\nつばめちゃんが、管理庁に\n捕まったなんて…。"},
        { "location": "74/TALK"   , "narrator": "キリト", "text": "俺が甘かったんだよ。"},
        { "location": "75/TALK"   , "narrator": "キリト", "text": "逢瀬が隠れてるの、\n黙ってりゃバレないと\n思ったから…。"},
        { "location": "77/TALK"   , "narrator": "ヒカル", "text": "キリトのせいじゃないよ。"},
        { "location": "78/TALK"   , "narrator": "ヒカル", "text": "あの場では、あれ以上の\nことはできなかったし…。"},
        { "location": "80/TALK"   , "narrator": "繭", "text": "…他のみんなは？"},
        { "location": "82/TALK"   , "narrator": "ヒカル", "text": "無事に脱出したのは\n確かだけど、\nどこに行ったかまでは…。"},
        { "location": "86/TALK"   , "narrator": "繭", "text": "…確かめる。"},
        { "location": "87/TALK"   , "narrator": "雛", "text": "…つばめちゃんが\n管理庁に捕まっちゃって、\nみんなは行方不明…。"},
        { "location": "88/TALK"   , "narrator": "雛", "text": "それに、キリト達は\n謹慎処分なんて…。"},
        { "location": "89/TALK"   , "narrator": "雛", "text": "こんなの、酷過ぎるよ…。"},
        { "location": "91/TALK"   , "narrator": "キリト", "text": "…いや、別に俺たちの\n謹慎はいいんだよ。"},
        { "location": "92/TALK"   , "narrator": "キリト", "text": "むしろ、そうなってくれて\nありがたいくらいだしな。"},
        { "location": "93/TALK"   , "narrator": "ヒカル", "text": "うん…今の管理庁の\nやり方には、\n賛同できないしね。"},
        { "location": "95/TALK"   , "narrator": "キリト", "text": "襲撃の前に警告できれば\nよかったんだが…、\nそれも無理でさ…。"},
        { "location": "96/TALK"   , "narrator": "雛", "text": "…そっか。"},
        { "location": "98/TALK"   , "narrator": "雛", "text": "ずっと連絡が取れなく\n心配してたけど…。"},
        { "location": "100/TALK"  , "narrator": "雛", "text": "二人も、大変な想い\nしてたんだね…。"},
        { "location": "102/TALK"  , "narrator": "ヒカル", "text": "心配かけたみたいで、\nすみません…。"},
        { "location": "103/TALK"  , "narrator": "ヒカル", "text": "でも、ちょっと嬉しいな。\n気にされてないと\n思ってたから…。"},
        { "location": "105/TALK"  , "narrator": "雛", "text": "もぉ、友達と何日も\n連絡取れなかったら、\n普通心配するって！"},
        { "location": "108/TALK"  , "narrator": "ヒカル", "text": "あ、あはは…、\nそうだよね…。"},
        { "location": "109/TALK"  , "narrator": "ヒカル", "text": "友達かぁ…。\nまあ、そうだよね…。"},
        { "location": "110/TALK"  , "narrator": "繭", "text": "…………。"},
        { "location": "112/TALK"  , "narrator": "キリト", "text": "繭、さっきから\nなにやってんだ？"},
        { "location": "113/TALK"  , "narrator": "繭", "text": "みやび先輩に\nＷＡＶＥを送ってる…。"},
        { "location": "114/TALK"  , "narrator": "キリト", "text": "なにか来たのか？"},
        { "location": "115/TALK"  , "narrator": "繭", "text": "…既読もつかない。"},
        { "location": "117/TALK"  , "narrator": "ヒカル", "text": "多分、居場所がバレるのを\n恐れてるんじゃないかな？"},
        { "location": "119/TALK"  , "narrator": "雛", "text": "そっか…。"},
        { "location": "120/TALK"  , "narrator": "雛", "text": "じゃあ、あたし達だけで\nやるしかない、って\nことだね。"},
        { "location": "121/TALK"  , "narrator": "キリト", "text": "やるって、何をだ？"},
        { "location": "123/TALK"  , "narrator": "雛", "text": "つばめちゃん救出作戦に\n決まってるでしょー？"},
        { "location": "124/TALK"  , "narrator": "雛", "text": "綾水様達だって、\n今は管理庁に追われてる\n身なんだし…。"},
        { "location": "125/TALK"  , "narrator": "雛", "text": "その点、あたし達なら\n管理庁に目を付けられても\nいないから――"},
        { "location": "129/TALK"  , "narrator": "繭", "text": "無謀すぎる。"},
        { "location": "130/TALK"  , "narrator": "キリト", "text": "繭の言う通りだ。\nさすがにそれは\n無茶過ぎるだろ？"},
        { "location": "131/TALK"  , "narrator": "キリト", "text": "第一、逢瀬がどこに\n捕まってるのかも\nわからないんだぞ？"},
        { "location": "132/TALK"  , "narrator": "雛", "text": "キリト達なら\n知ることができるんじゃ\nないの？"},
        { "location": "134/TALK"  , "narrator": "ヒカル", "text": "あの、ひなこさん。\n僕達謹慎中なんだけど…。"},
        { "location": "135/TALK"  , "narrator": "ヒカル", "text": "まあ、仮に謹慎中じゃ\nなかったとしても\n無理だと思うよ？"},
        { "location": "136/TALK"  , "narrator": "ヒカル", "text": "僕達は通常攻撃隊の、\n一番下っ端だし…。"},
        { "location": "137/TALK"  , "narrator": "キリト", "text": "色々質問しても、\n答えてもらえないことが\nほとんどだったもんな。"},
        { "location": "138/TALK"  , "narrator": "繭", "text": "…そんな扱いだったの？"},
        { "location": "139/TALK"  , "narrator": "キリト", "text": "まあ、まだ学生だしな。\n正式な隊員になるまでは\n仕方ねぇんだよ…。"},
        { "location": "141/TALK"  , "narrator": "雛", "text": "そっか…。\nうーん、どうしたら\nいいのかなぁ？"},
        { "location": "142/TALK"  , "narrator": "ヒカル", "text": "…ひなこさん。\n本気で逢瀬さんのことを\n助けるつもりですか？"},
        { "location": "144/TALK"  , "narrator": "雛", "text": "当然だよ！"},
        { "location": "145/TALK"  , "narrator": "雛", "text": "ヒカルくんは、\nつばめちゃんのこと\n助けたくないの？"},
        { "location": "146/TALK"  , "narrator": "ヒカル", "text": "まさか！\n本音を言えば僕だって…。"},
        { "location": "147/TALK"  , "narrator": "キリト", "text": "ひなこ…俺達だって、\n逢瀬を見捨てたいわけじゃ\nないんだ。"},
        { "location": "148/TALK"  , "narrator": "キリト", "text": "けど…わかんだろ？\n相手は管理庁なんだぜ？"},
        { "location": "149/TALK"  , "narrator": "繭", "text": "素人が束になって、\nどうにかなるような\n相手じゃない。"},
        { "location": "151/TALK"  , "narrator": "雛", "text": "そんなのわかってるよ。"},
        { "location": "152/TALK"  , "narrator": "雛", "text": "でも、もしつばめちゃんが\n今のあたし達の\n立場だったら…。"},
        { "location": "153/TALK"  , "narrator": "雛", "text": "絶対、助けるために\n動くと思うの。"},
        { "location": "154/TALK"  , "narrator": "雛", "text": "覚えてるかな？\n夏休み前にあったこと…。"},
        { "location": "171/TALK"  , "narrator": "雛", "text": "どうしよう…。\nマジで見つからないよー。"},
        { "location": "173/TALK"  , "narrator": "キリト", "text": "小さいもんだからな。\nさすがに、もう諦めたら\nどうなんだ？"},
        { "location": "175/TALK"  , "narrator": "雛", "text": "だ、ダメだよー！\nあたしの宝物の\n一つなんだから…。"},
        { "location": "178/TALK"  , "narrator": "つばめ", "text": "あれ…？\n二人とも、どうしたの？"},
        { "location": "181/TALK"  , "narrator": "雛", "text": "あ、つばめちゃん！\nブロマイド見なかった？"},
        { "location": "185/TALK"  , "narrator": "つばめ", "text": "ブロマイド？\nそれって、アイドルとかの\n写真のことだよね？"},
        { "location": "186/TALK"  , "narrator": "キリト", "text": "アイドル、か…。\nまあ、ひなこから見れば\nアイドルなのか？"},
        { "location": "189/TALK"  , "narrator": "つばめ", "text": "どういうこと？"},
        { "location": "190/TALK"  , "narrator": "キリト", "text": "なんとか、っていう、\n寝台列車のブロマイド\nなんだってさ。"},
        { "location": "191/TALK"  , "narrator": "キリト", "text": "普通に土産物屋で\n売ってるような\nブロマイドなんだろ？"},
        { "location": "194/TALK"  , "narrator": "雛", "text": "そうだけど、思い出が\nたっぷり詰まってるの！"},
        { "location": "199/TALK"  , "narrator": "つばめ", "text": "大変！\nそれじゃ、わたしも\n一緒に探すよ！"},
        { "location": "201/TALK"  , "narrator": "雛", "text": "い、いいよー。\nだってつばめちゃん、\n今日はバイトの日でしょ？"},
        { "location": "202/TALK"  , "narrator": "キリト", "text": "遅刻したら、東雲教官や\nガブリエラに\n怒られるんじゃね？"},
        { "location": "206/TALK"  , "narrator": "つばめ", "text": "でも…ひなこちゃんの\n大切なものなんでしょ？"},
        { "location": "209/TALK"  , "narrator": "雛", "text": "だからって、バイトがある\nつばめちゃんに\n迷惑はかけられないよ。"},
        { "location": "210/TALK"  , "narrator": "雛", "text": "あたしは大丈夫だから、\nつばめちゃんは\nバイト頑張ってきてね。"},
        { "location": "213/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "225/TALK"  , "narrator": "つばめ", "text": "こぅぃぅ場合って"},
        { "location": "227/TALK"  , "narrator": "つばめ", "text": "どうするのが"},
        { "location": "228/TALK"  , "narrator": "つばめ", "text": "正しぃのかな？(´･ω･｀) "},
        { "location": "230/SEL"   , "narrator": "（選択肢）", "text": "どういう場合のこと？"},
        { "location": "231/ACT"   , "narrator": "", "text": "どういう場合のこと？"},
        { "location": "233/TALK"  , "narrator": "つばめ", "text": "ひなこちゃんの失くした物"},
        { "location": "234/TALK"  , "narrator": "つばめ", "text": "わたしも"},
        { "location": "235/TALK"  , "narrator": "つばめ", "text": "一緒に探したぃのo(*･ﾛ･*)o、"},
        { "location": "236/TALK"  , "narrator": "つばめ", "text": "でも"},
        { "location": "237/TALK"  , "narrator": "つばめ", "text": "バイトがぁるんだから"},
        { "location": "238/TALK"  , "narrator": "つばめ", "text": "そっちを優先しろって(o´Д`)=з"},
        { "location": "242/TALK"  , "narrator": "つばめ", "text": "ひなこちゃんの言ってること"},
        { "location": "243/TALK"  , "narrator": "つばめ", "text": "正しいと思ぅ(´･ω･｀) "},
        { "location": "244/TALK"  , "narrator": "つばめ", "text": "だけど"},
        { "location": "245/TALK"  , "narrator": "つばめ", "text": "それでぃぃのかな？(･Д･｀)"},
        { "location": "247/SEL"   , "narrator": "（選択肢）", "text": "雛の言う通りだと思う"},
        { "location": "248/SEL"   , "narrator": "（選択肢）", "text": "手伝ってあげてほしい"},
        { "location": "249/SEL"   , "narrator": "（選択肢）", "text": "大切なのはつばめの意志だ"},
        { "location": "250/ACT"   , "narrator": "", "text": "雛の言う通りだと思う"},
        { "location": "251/TALK"  , "narrator": "つばめ", "text": "そっか"},
        { "location": "254/TALK"  , "narrator": "つばめ", "text": "わかったよ(*´︶`*)"},
        { "location": "266/TALK"  , "narrator": "つばめ", "text": "それじゃあ、\nひなこちゃん。\n悪いんだけどわたし…。"},
        { "location": "267/TALK"  , "narrator": "雛", "text": "うん、アルバイト\n頑張ってねー。"},
        { "location": "268/TALK"  , "narrator": "キリト", "text": "俺も一緒に探すから、\n心配いらねぇよ。"},
        { "location": "269/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "271/TALK"  , "narrator": "キリト", "text": "ほら、逢瀬。\n本当に遅刻するぞ？"},
        { "location": "274/TALK"  , "narrator": "つばめ", "text": "…やっぱり、\n放っておけないよ！"},
        { "location": "275/ACT"   , "narrator": "", "text": "手伝ってあげてほしい"},
        { "location": "276/TALK"  , "narrator": "つばめ", "text": "$handle$さん"},
        { "location": "278/TALK"  , "narrator": "つばめ", "text": "ぁりがと(*´︶`*)"},
        { "location": "279/TALK"  , "narrator": "つばめ", "text": "わたし"},
        { "location": "280/TALK"  , "narrator": "つばめ", "text": "やっぱり手伝ぅね(≧ω≦)"},
        { "location": "291/ACT"   , "narrator": "", "text": "大切なのはつばめの意志だ"},
        { "location": "292/TALK"  , "narrator": "つばめ", "text": "わたしの意志は"},
        { "location": "293/TALK"  , "narrator": "つばめ", "text": "もう決まってるよ"},
        { "location": "295/TALK"  , "narrator": "つばめ", "text": "悩むことなかったんだね(●´ω｀●)ゞ"},
        { "location": "296/TALK"  , "narrator": "つばめ", "text": "気づかせてくれて"},
        { "location": "297/TALK"  , "narrator": "つばめ", "text": "ぁりがと(*≧∀≦*) "},
        { "location": "311/TALK"  , "narrator": "つばめ", "text": "ひなこちゃん。\nやっぱり、わたしも\n手伝うよ！"},
        { "location": "312/TALK"  , "narrator": "雛", "text": "ちょ、つばめちゃん！\nあたしの話聞いてた？"},
        { "location": "313/TALK"  , "narrator": "キリト", "text": "今日はシフトの人数も\n少ないんだし、\n行かないとマズいだろ？"},
        { "location": "316/TALK"  , "narrator": "つばめ", "text": "電車一本分だけ！\nそれくらいなら、\nそんなに怒られないし…。"},
        { "location": "317/TALK"  , "narrator": "雛", "text": "でも…。"},
        { "location": "318/TALK"  , "narrator": "つばめ", "text": "それに、今のまま\nバイトに行っても、\n集中できないと思うの…。"},
        { "location": "319/TALK"  , "narrator": "つばめ", "text": "だから、お願い。\nわたしにも探し物の\nお手伝いさせて？"},
        { "location": "320/TALK"  , "narrator": "雛", "text": "…………。"},
        { "location": "321/TALK"  , "narrator": "雛", "text": "もぅ…本当に電車一本分\nだけだからね？"},
        { "location": "323/TALK"  , "narrator": "つばめ", "text": "ほんとう！？\nありがとう、\nひなこちゃん。"},
        { "location": "324/TALK"  , "narrator": "キリト", "text": "逢瀬が礼を言うのは\n変じゃないか？"},
        { "location": "327/TALK"  , "narrator": "つばめ", "text": "あ、あれ、そうかな？"},
        { "location": "328/TALK"  , "narrator": "雛", "text": "あはは、こちらこそ\nありがとうだよー。"},
        { "location": "330/TALK"  , "narrator": "キリト", "text": "まったく…。\nそんじゃ、さっさと\n探すの再開しようぜ。"},
        { "location": "346/TALK"  , "narrator": "ヒカル", "text": "…なるほど。\nそんなことがあったんだ？"},
        { "location": "348/TALK"  , "narrator": "キリト", "text": "ああ…結局あの後、\n逢瀬が見つけて\nくれたんだよな？"},
        { "location": "349/TALK"  , "narrator": "雛", "text": "うん…。\n電車、三本分くらい\n遅くなっちゃったけど…。"},
        { "location": "350/TALK"  , "narrator": "繭", "text": "…逢瀬さんらしいわ。"},
        { "location": "351/TALK"  , "narrator": "繭", "text": "どこか抜けてて、\n危なっかしいのに…。"},
        { "location": "352/TALK"  , "narrator": "繭", "text": "呆れるくらいお節介で、\n困ってる人がいたら\n見捨てられない性格。"},
        { "location": "353/TALK"  , "narrator": "ヒカル", "text": "…いい子だよね。\n逢瀬さんって。"},
        { "location": "354/TALK"  , "narrator": "キリト", "text": "ああ…ちょっとだけ\n頼りない感じだけどな。"},
        { "location": "355/TALK"  , "narrator": "雛", "text": "そこも含めて\nつばめちゃんの\n魅力だと思うなー。"},
        { "location": "359/TALK"  , "narrator": "ヒカル", "text": "…多分、東雲教官に\nバレたら確実に怒られると\n思うけど…。"},
        { "location": "360/TALK"  , "narrator": "ヒカル", "text": "このままってわけには、\nいかないよね？"},
        { "location": "362/TALK"  , "narrator": "キリト", "text": "…そうだな。"},
        { "location": "364/TALK"  , "narrator": "雛", "text": "じゃ、じゃあ、キリト達も\n手伝ってくれるの！？"},
        { "location": "366/TALK"  , "narrator": "キリト", "text": "ただし！\n俺たちで逢瀬を助ける、\nってのはナシだぞ？"},
        { "location": "367/TALK"  , "narrator": "キリト", "text": "さすがにそれは無謀だし、\n上手くいく可能性は、\n考えるまでもないしな。"},
        { "location": "368/TALK"  , "narrator": "雛", "text": "じゃあ、どうするの？"},
        { "location": "369/TALK"  , "narrator": "キリト", "text": "…綾水先輩達と、\nどうにか連絡を\n取るんだよ。"},
        { "location": "370/TALK"  , "narrator": "キリト", "text": "俺たちだけで\n逢瀬を助けるなんて、\n絶対に無理な話だ。"},
        { "location": "371/TALK"  , "narrator": "キリト", "text": "だから、先輩たちと連絡を\n取ってから、サポートする\n形で俺たちは動く。"},
        { "location": "372/TALK"  , "narrator": "キリト", "text": "それなら、無理な話でも\nないからな。"},
        { "location": "373/TALK"  , "narrator": "ヒカル", "text": "まあ、逢瀬さんの救出を\n手伝うってだけでも、\n危険に変わりないけど…。"},
        { "location": "374/TALK"  , "narrator": "ヒカル", "text": "ひなこさん。\nそれで納得して\nもらえますか？"},
        { "location": "375/TALK"  , "narrator": "雛", "text": "…もちろんだよ。"},
        { "location": "376/TALK"  , "narrator": "雛", "text": "キリト、ヒカルくん…。\nワガママ聞いてくれて\nありがと。"},
        { "location": "377/TALK"  , "narrator": "キリト", "text": "礼はいらねぇよ。"},
        { "location": "378/TALK"  , "narrator": "キリト", "text": "俺たちだって、本当は\n逢瀬のこと助けたいと\n思ってたんだからな。"},
        { "location": "379/TALK"  , "narrator": "ヒカル", "text": "そういうことです。"},
        { "location": "381/TALK"  , "narrator": "ヒカル", "text": "…ただ、問題はどうやって\n綾水先輩達と連絡を取るか\nということだけど…。"},
        { "location": "382/TALK"  , "narrator": "キリト", "text": "ＷＡＶＥ送っても\n無反応だし、\nそうだなぁ…。"},
        { "location": "383/TALK"  , "narrator": "雛", "text": "うーん…。"},
        { "location": "384/TALK"  , "narrator": "繭", "text": "…身近な人に\n聞いてみるのは？"},
        { "location": "387/TALK"  , "narrator": "雛", "text": "え？　どういうこと？"},
        { "location": "390/TALK"  , "narrator": "繭", "text": "綾水先輩達の居場所、\n心当たりありそうな人に\n聞くの。"},
        { "location": "391/TALK"  , "narrator": "繭", "text": "まあ、それ以外の方法は\n思いつかないけど。"},
        { "location": "393/TALK"  , "narrator": "キリト", "text": "けど、身近な人って\n誰のことだよ？"},
        { "location": "394/TALK"  , "narrator": "キリト", "text": "知る限りだと、俺たちが\n一番身近な気するし…。"},
        { "location": "397/TALK"  , "narrator": "雛", "text": "あっ！！"},
        { "location": "399/TALK"  , "narrator": "ヒカル", "text": "うわっ！？\nど、どうしたんですか！？"},
        { "location": "400/TALK"  , "narrator": "雛", "text": "いる、いるよ！！\nとっても身近な人で、\nあたし達よりももっと…。"},
        { "location": "401/TALK"  , "narrator": "雛", "text": "綾水様のこと\n知ってる人が！！"}
    ]
}
