    [
        { "location": "6970/SCENARIO", "narrator": "", "text": "セイラーの企て"},
        { "location": "6997/TALK"    , "narrator": "神楽", "text": "日本でセーラー服っていえば"},
        { "location": "6998/TALK"    , "narrator": "神楽", "text": "女学生の制服だよね？"},
        { "location": "7000/SEL"     , "narrator": "", "text": "長崎の女子校が最古参らしい"},
        { "location": "7001/SEL"     , "narrator": "", "text": "三つ編みに三つ折りソックス！"},
        { "location": "7002/SEL"     , "narrator": "", "text": "神楽も着て欲しいな～"},
        { "location": "7003/ACT"     , "narrator": "", "text": "長崎の女子校が最古参らしい"},
        { "location": "7004/TALK"    , "narrator": "神楽", "text": "マジで？"},
        { "location": "7006/TALK"    , "narrator": "神楽", "text": "長崎グッジョブ！"},
        { "location": "7007/ACT"     , "narrator": "", "text": "三つ編みに三つ折りソックス！"},
        { "location": "7008/TALK"    , "narrator": "神楽", "text": "古の女学生！！！"},
        { "location": "7009/ACT"     , "narrator": "", "text": "神楽も着て欲しいな～"},
        { "location": "7011/TALK"    , "narrator": "神楽", "text": "ぴょんこに！？"},
        { "location": "7013/TALK"    , "narrator": "神楽", "text": "そんなことしたらぴょんこ一人だけ超絶かわいい感じになっちゃうしー"},
        { "location": "7014/TALK"    , "narrator": "神楽", "text": "平たく言うと無理じゃね？"},
        { "location": "7016/TALK"    , "narrator": "神楽", "text": "でもセーラーって元々は海軍の制服だったわけじゃないですかー"},
        { "location": "7017/TALK"    , "narrator": "神楽", "text": "方向性違いすぎ！"},
        { "location": "7019/SEL"     , "narrator": "", "text": "バンドだったら解散する事態"},
        { "location": "7020/SEL"     , "narrator": "", "text": "不思議だよね"},
        { "location": "7021/SEL"     , "narrator": "", "text": "神楽が可愛かったら何でもいい"},
        { "location": "7022/ACT"     , "narrator": "", "text": "バンドだったら解散する事態"},
        { "location": "7023/TALK"    , "narrator": "神楽", "text": "ほんそれ！"},
        { "location": "7024/ACT"     , "narrator": "", "text": "不思議だよね"},
        { "location": "7025/TALK"    , "narrator": "神楽", "text": "なんでこうなったｗ"},
        { "location": "7026/ACT"     , "narrator": "", "text": "神楽が可愛かったら何でもいい"},
        { "location": "7028/TALK"    , "narrator": "神楽", "text": "いつもいつも同じ反応されても～～～"},
        { "location": "7029/TALK"    , "narrator": "神楽", "text": "反応に困っちゃうぴょん"},
        { "location": "7031/TALK"    , "narrator": "神楽", "text": "愛の言葉はもっとひねってくれないとー！"},
        { "location": "7032/TALK"    , "narrator": "神楽", "text": "月が綺麗ですねみたいに！！！"},
        { "location": "7033/TALK"    , "narrator": "神楽", "text": "やぼなひとねもう！"},
        { "location": "7035/TALK"    , "narrator": "神楽", "text": "そんでもってセーラー服は持ってってもいいらしいぴょん"},
        { "location": "7036/TALK"    , "narrator": "神楽", "text": "もらっとけー！"}
    ]
