        "title": "001 アニメーション",
        "sub_title": "EXE_TSuBaMe"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "アニメ第38話"},
        { "location": "52/TALK"   , "narrator": "赤髪千羽鶴", "text": "こんにちは、\n$handle$さん。"},
        { "location": "53/TALK"   , "narrator": "赤髪千羽鶴", "text": "私の動画、\nもう一度見ますか？"},
        { "location": "54/SEL"    , "narrator": "", "text": "はい"},
        { "location": "55/SEL"    , "narrator": "", "text": "いいえ"},
        { "location": "56/ACT"    , "narrator": "", "text": "はい"},
        { "location": "57/TALK"   , "narrator": "赤髪千羽鶴", "text": "わかりました。"},
        { "location": "59/ACT"    , "narrator": "", "text": "いいえ"},
        { "location": "60/TALK"   , "narrator": "赤髪千羽鶴", "text": "わかりました。"},
        { "location": "61/TALK"   , "narrator": "赤髪千羽鶴", "text": "それじゃ、また。"},
        { "location": "66/TALK"   , "narrator": "赤髪千羽鶴", "text": "こんにちは、\n$handle$さん。"},
        { "location": "67/SEL"    , "narrator": "", "text": "えっと…どちら様でしょうか"},
        { "location": "68/SEL"    , "narrator": "", "text": "赤い千羽鶴だ！！"},
        { "location": "69/ACT"    , "narrator": "", "text": "えっと…どちら様でしょうか"},
        { "location": "70/TALK"   , "narrator": "赤髪千羽鶴", "text": "つばめですよ、\n逢瀬つばめ。"},
        { "location": "71/ACT"    , "narrator": "", "text": "赤い千羽鶴だ！！"},
        { "location": "72/TALK"   , "narrator": "赤髪千羽鶴", "text": "なんだか不思議な\n言われ方ですね……。"},
        { "location": "73/TALK"   , "narrator": "赤髪千羽鶴", "text": "私からすれば、クランの\n千羽鶴こそ“白いわたし”\nなんですが。"},
        { "location": "74/TALK"   , "narrator": "赤髪千羽鶴", "text": "まあでも、\n積み上げてきた思い出が\n違いますもんね。"},
        { "location": "75/TALK"   , "narrator": "赤髪千羽鶴", "text": "改めまして。\nわたしは逢瀬つばめです。"},
        { "location": "77/TALK"   , "narrator": "赤髪千羽鶴", "text": "本当の姿で、\n貴方の前に立つのは\n初めてだったかな…？"},
        { "location": "78/SEL"    , "narrator": "", "text": "でも、どうしていきなり？"},
        { "location": "79/ACT"    , "narrator": "", "text": "でも、どうしていきなり？"},
        { "location": "81/TALK"   , "narrator": "赤髪千羽鶴", "text": "いきなり出てきたか、\nですよね？"},
        { "location": "82/TALK"   , "narrator": "赤髪千羽鶴", "text": "それは、TRI-OSが\nモード変更され、\n実行されていた――"},
        { "location": "83/TALK"   , "narrator": "赤髪千羽鶴", "text": "“パラメトリック理論\nによる世界進行法”の\n解が出たからです。"},
        { "location": "84/SEL"    , "narrator": "", "text": "つばめが難しい事を言ってる！！"},
        { "location": "85/SEL"    , "narrator": "", "text": "やはり中身はちー"},
        { "location": "86/ACT"    , "narrator": "", "text": "つばめが難しい事を言ってる！！"},
        { "location": "87/TALK"   , "narrator": "赤髪千羽鶴", "text": "えっと……"},
        { "location": "88/TALK"   , "narrator": "赤髪千羽鶴", "text": "どうリアクションしたら\nいいのかわかりません。"},
        { "location": "89/ACT"    , "narrator": "", "text": "やはり中身はちー"},
        { "location": "90/TALK"   , "narrator": "赤髪千羽鶴", "text": "まあ、そうですね。\nそれは間違ってないです。"},
        { "location": "92/TALK"   , "narrator": "赤髪千羽鶴", "text": "$handle$さん含む\n総意である皆さんは、前回\nその想いを示しました。"},
        { "location": "93/TALK"   , "narrator": "赤髪千羽鶴", "text": "そして、\nその総意の結果によって\nわたしは今ここにいます。"},
        { "location": "94/SEL"    , "narrator": "", "text": "えっと、てことは…"},
        { "location": "95/ACT"    , "narrator": "", "text": "えっと、てことは…"},
        { "location": "97/TALK"   , "narrator": "赤髪千羽鶴", "text": "お陰様で、フェノメノンは\n現状維持を保つことが\n可能となりました！"},
        { "location": "98/SEL"    , "narrator": "", "text": "おめでとう！！"},
        { "location": "99/SEL"    , "narrator": "", "text": "残念……"},
        { "location": "100/SEL"   , "narrator": "", "text": "フェノメノンを維持するのに、本物のつばめが出てくるのはおかしくない？"},
        { "location": "101/ACT"   , "narrator": "", "text": "おめでとう！！"},
        { "location": "102/TALK"  , "narrator": "赤髪千羽鶴", "text": "ありがとうございます！"},
        { "location": "103/ACT"   , "narrator": "", "text": "残念……"},
        { "location": "104/TALK"  , "narrator": "赤髪千羽鶴", "text": "あっ……\nもしかして、フェノメノン\n飛散賛成でしたか？"},
        { "location": "105/TALK"  , "narrator": "赤髪千羽鶴", "text": "すみませんでした。\n余計なことを\n言ってしまって。"},
        { "location": "106/TALK"  , "narrator": "赤髪千羽鶴", "text": "でも、残念ながら\n世界は既に維持する方向で\n収束しています。"},
        { "location": "107/TALK"  , "narrator": "赤髪千羽鶴", "text": "ですから、今回は\nどうか諦めてください。"},
        { "location": "108/ACT"   , "narrator": "", "text": "フェノメノンを維持するのに、本物のつばめが出てくるのはおかしくない？"},
        { "location": "109/TALK"  , "narrator": "赤髪千羽鶴", "text": "え？\nそうですか？"},
        { "location": "110/TALK"  , "narrator": "赤髪千羽鶴", "text": "うーん……"},
        { "location": "111/TALK"  , "narrator": "赤髪千羽鶴", "text": "あ……何となくですけど、\n言いたいことが\nわかりました。"},
        { "location": "112/TALK"  , "narrator": "赤髪千羽鶴", "text": "後ほど説明しますね。"},
        { "location": "114/TALK"  , "narrator": "赤髪千羽鶴", "text": "さて。"},
        { "location": "115/TALK"  , "narrator": "赤髪千羽鶴", "text": "$handle$さんは、\nこの結果に協力してくれた\n功労者の一人です。"},
        { "location": "116/TALK"  , "narrator": "赤髪千羽鶴", "text": "ですから、任意で\nその過程と最終的な結果を\n見る権利があります。"},
        { "location": "117/TALK"  , "narrator": "赤髪千羽鶴", "text": "見ていきますか？"},
        { "location": "118/SEL"   , "narrator": "", "text": "見る"},
        { "location": "119/SEL"   , "narrator": "", "text": "見ない"},
        { "location": "120/TALK"  , "narrator": "赤髪千羽鶴", "text": "……まあ、見たところで\n何か変わるわけでは\nありませんが……。"},
        { "location": "121/ACT"   , "narrator": "", "text": "見る"},
        { "location": "122/TALK"  , "narrator": "赤髪千羽鶴", "text": "わかりました。\nやっぱり\n気になりますよね。"},
        { "location": "123/TALK"  , "narrator": "赤髪千羽鶴", "text": "それでは、\n１つずつ伝えていきます。"},
        { "location": "124/TALK"  , "narrator": "赤髪千羽鶴", "text": "まず、フェノメノンを\n維持するだけの力が\n得られたか、ですが――"},
        { "location": "125/TALK"  , "narrator": "赤髪千羽鶴", "text": "こちらは、ギリギリ\n得られたというのが\n正直なところです。"},
        { "location": "126/TALK"  , "narrator": "赤髪千羽鶴", "text": "維持に必要な要項は、\n千羽鶴の想いを日本全土に\n住む人達に届ける力――"},
        { "location": "127/TALK"  , "narrator": "赤髪千羽鶴", "text": "乱暴に言えば、中継して\n想いを増幅する中継塔が\n何本建てられるかです。"},
        { "location": "128/TALK"  , "narrator": "赤髪千羽鶴", "text": "中継塔の役割を、\n千羽鶴は、トライナリーの\n３名に依頼しました。"},
        { "location": "129/TALK"  , "narrator": "赤髪千羽鶴", "text": "卯月さんだけ依頼して\nいないのは、仲間はずれ\nとかではなくて――"},
        { "location": "130/TALK"  , "narrator": "赤髪千羽鶴", "text": "卯月さんのトライ\nガジェットだけは、\n私の管理下に無い為です。"},
        { "location": "131/TALK"  , "narrator": "赤髪千羽鶴", "text": "意味、わかりますよね？"},
        { "location": "132/TALK"  , "narrator": "赤髪千羽鶴", "text": "では早速、その３名の\nセルフクランがどう\n判断したかを開示します。"},
        { "location": "133/TALK"  , "narrator": "赤髪千羽鶴", "text": "これらの結果は、\n対向時間 2017年\n11月21日0時のものです。"},
        { "location": "140/TALK"  , "narrator": "赤髪千羽鶴", "text": "まず、アーヤさんの\nセルフクラン『水鏡の\n神子』の結果です。"},
        { "location": "141/TALK"  , "narrator": "赤髪千羽鶴", "text": "上が彼女の決断です。\nほぼ全会一致とも言うべき\n状況で受け入れています。"},
        { "location": "142/TALK"  , "narrator": "赤髪千羽鶴", "text": "そして下が、あなたたち\n総意が判断したものと\nなります。"},
        { "location": "143/TALK"  , "narrator": "赤髪千羽鶴", "text": "アーヤさんは、やっぱり\n$handle$さんたちに\n委ねる割合が大きいです。"},
        { "location": "150/TALK"  , "narrator": "赤髪千羽鶴", "text": "次はガブちゃんのセルフ\nクラン『マークスマン』の\n結果となります。"},
        { "location": "151/TALK"  , "narrator": "赤髪千羽鶴", "text": "彼女はかなりの割合で\n$handle$さんに\n懐疑的だったようです。"},
        { "location": "152/TALK"  , "narrator": "赤髪千羽鶴", "text": "下の集計、あなたたちの\n総意は、アーヤさんと同じ\n高い水準を維持してます。"},
        { "location": "159/TALK"  , "narrator": "赤髪千羽鶴", "text": "最後に、みやびさんの\nセルフクラン『なご』の\n結果です。"},
        { "location": "160/TALK"  , "narrator": "赤髪千羽鶴", "text": "マークスマンほどでは\nありませんが、水鏡の神子\nよりは懐疑的です。"},
        { "location": "161/TALK"  , "narrator": "赤髪千羽鶴", "text": "下の集計は、やはり同じく\n千羽鶴の受け入れ賛成に\n高い水準を維持してます。"},
        { "location": "166/TALK"  , "narrator": "赤髪千羽鶴", "text": "さて、\nこれらの結果を踏まえた\n確定未来をお伝えします。"},
        { "location": "167/TALK"  , "narrator": "赤髪千羽鶴", "text": "わたしに力を\n与えるかどうかを判断する\nのはセルフクランです。"},
        { "location": "168/TALK"  , "narrator": "赤髪千羽鶴", "text": "結果を見て分かる通り、\n力の共有は3名とも\n承諾をいただきました。"},
        { "location": "169/TALK"  , "narrator": "赤髪千羽鶴", "text": "間一髪ではありましたが、\n3名全員からの協力を\n得られましたので――"},
        { "location": "170/TALK"  , "narrator": "赤髪千羽鶴", "text": "フェノメノンを現状維持\nできる力を得られたことに\nなります。"},
        { "location": "171/TALK"  , "narrator": "赤髪千羽鶴", "text": "正直にお話ししますと、\n実は測定２日前までは、\nマークスマンは非でした。"},
        { "location": "172/TALK"  , "narrator": "赤髪千羽鶴", "text": "“協力しない”選択が、\n５０％を超えて\nいたのです。"},
        { "location": "173/TALK"  , "narrator": "赤髪千羽鶴", "text": "それを逆転させたのは、\n$handle$さん達の\n尽力によるものでしょう。"},
        { "location": "174/TALK"  , "narrator": "赤髪千羽鶴", "text": "また、世界を形づくる為の\n情報を送って戴いている\n$handle$さん達――"},
        { "location": "175/TALK"  , "narrator": "赤髪千羽鶴", "text": "すなわち、総意の結果も\n下側の円グラフからわかる\n通り、存続となりました！"},
        { "location": "177/TALK"  , "narrator": "赤髪千羽鶴", "text": "その結果、顕在する記憶は\nフェノメノンの内側の\nものとなりました。"},
        { "location": "178/TALK"  , "narrator": "赤髪千羽鶴", "text": "ですから、今後お付き合い\nする彼女たちもまた、従来\nからの継続になります。"},
        { "location": "179/SEL"   , "narrator": "", "text": "よかった！"},
        { "location": "180/SEL"   , "narrator": "", "text": "どうしてマークスマンは否定が多いんだろうか"},
        { "location": "181/ACT"   , "narrator": "", "text": "よかった！"},
        { "location": "182/TALK"  , "narrator": "赤髪千羽鶴", "text": "ありがとうございます！"},
        { "location": "183/ACT"   , "narrator": "", "text": "どうしてマークスマンは否定が多いんだろうか"},
        { "location": "184/TALK"  , "narrator": "赤髪千羽鶴", "text": "それは、マークスマンの\n出生の事情を考えるに、\n仕方ないことかと。"},
        { "location": "185/TALK"  , "narrator": "赤髪千羽鶴", "text": "セルフクランたちにも\nやはり、好き嫌いや\n先入観はあります。"},
        { "location": "186/TALK"  , "narrator": "赤髪千羽鶴", "text": "$handle$さんの\n発言も、その想いとは\n違う解釈をされたり――"},
        { "location": "187/TALK"  , "narrator": "赤髪千羽鶴", "text": "良かれと思って言った\nことでで、逆に邪魔を\nされてると思われたり。"},
        { "location": "188/TALK"  , "narrator": "赤髪千羽鶴", "text": "そういったことは、\nマークスマンに限らず、\n必ずあります。"},
        { "location": "189/TALK"  , "narrator": "赤髪千羽鶴", "text": "セルフクランたちだって\n神ではなく、\n一個人の一人格ですから。"},
        { "location": "190/TALK"  , "narrator": "赤髪千羽鶴", "text": "ただ、その中でも\nマークスマンが極端に\n厳しいのは、恐らく――"},
        { "location": "191/TALK"  , "narrator": "赤髪千羽鶴", "text": "彼女がまだ純粋で幼く、\n周囲全てに銃口を向けて\n生きているからかと。"},
        { "location": "192/TALK"  , "narrator": "赤髪千羽鶴", "text": "セルフクランが、\nとっても臆病なだけ\nなのだと思います。"},
        { "location": "193/TALK"  , "narrator": "赤髪千羽鶴", "text": "だから、大事なのは\n彼女達に受け入れて\nもらえるかよりも――"},
        { "location": "194/TALK"  , "narrator": "赤髪千羽鶴", "text": "彼女達がした選択を\n受け入れてあげられるか\nだと思っています。"},
        { "location": "195/TALK"  , "narrator": "赤髪千羽鶴", "text": "どんな答えでも、\nそれが彼女達の、その時の\n精一杯だと思うので！"},
        { "location": "196/TALK"  , "narrator": "赤髪千羽鶴", "text": "それと、\nとても大事なことを\nもう１点。"},
        { "location": "197/TALK"  , "narrator": "赤髪千羽鶴", "text": "セルフクランに拒否される\nのは、彼女に拒否されるの\nとは全然違います。"},
        { "location": "198/TALK"  , "narrator": "赤髪千羽鶴", "text": "例えば、恋人だったり\n結婚したりしている\n相手でもそうですけど。"},
        { "location": "199/TALK"  , "narrator": "赤髪千羽鶴", "text": "重要な人生の岐路では、\n何でもかんでも相方の\n意見を鵜呑みにはしません。"},
        { "location": "200/TALK"  , "narrator": "赤髪千羽鶴", "text": "でも、だからといって\n愛してないわけじゃ\nないんです。"},
        { "location": "201/TALK"  , "narrator": "赤髪千羽鶴", "text": "ですから、もし\n受け入れられなくても\n落ち込まないでください。"},
        { "location": "202/TALK"  , "narrator": "赤髪千羽鶴", "text": "そもそも、あなたのことが\n好きでもないなら、\n意見は問いませんし――"},
        { "location": "203/TALK"  , "narrator": "赤髪千羽鶴", "text": "正直なこたえを\n$handle$さんに\n伝えたりもしませんから。"},
        { "location": "204/TALK"  , "narrator": "赤髪千羽鶴", "text": "……とまあ、\nそんな感じでしょうか。\n答えになりましたか？"},
        { "location": "205/SEL"   , "narrator": "", "text": "なったよ"},
        { "location": "206/SEL"   , "narrator": "", "text": "腑に落ちない"},
        { "location": "207/ACT"   , "narrator": "", "text": "なったよ"},
        { "location": "208/TALK"  , "narrator": "赤髪千羽鶴", "text": "よかったです。"},
        { "location": "209/ACT"   , "narrator": "", "text": "腑に落ちない"},
        { "location": "210/TALK"  , "narrator": "赤髪千羽鶴", "text": "そうですか……。"},
        { "location": "211/TALK"  , "narrator": "赤髪千羽鶴", "text": "でも、わたしの力量では\nこれ以上の説明は\nできません。"},
        { "location": "212/TALK"  , "narrator": "赤髪千羽鶴", "text": "ごめんなさい。"},
        { "location": "215/TALK"  , "narrator": "赤髪千羽鶴", "text": "では、次に移ります。"},
        { "location": "216/TALK"  , "narrator": "赤髪千羽鶴", "text": "セルフクランだった\n千羽鶴が、どのような\n立ち位置に落ち着いたか。"},
        { "location": "221/TALK"  , "narrator": "赤髪千羽鶴", "text": "こちらが結果となります。"},
        { "location": "222/TALK"  , "narrator": "赤髪千羽鶴", "text": "ここから導き出される\n未来とは――"},
        { "location": "223/TALK"  , "narrator": "赤髪千羽鶴", "text": "セルフクラン・カレンの\n傘下に千羽鶴が入り、\n世界を維持する未来です。"},
        { "location": "228/TALK"  , "narrator": "赤髪千羽鶴", "text": "これが、今回の世界に\nおいて得られた未来。"},
        { "location": "229/TALK"  , "narrator": "赤髪千羽鶴", "text": "セルフクラン・カレンの\n下でのフェノメノン維持を\n確立した未来です。"},
        { "location": "230/TALK"  , "narrator": "赤髪千羽鶴", "text": "もちろん、今説明した\nことは、トピック的な\nものでしかありません。"},
        { "location": "231/TALK"  , "narrator": "赤髪千羽鶴", "text": "“パラメトリック理論に\n基づく世界選択法”の解は\nもっと細かく複雑です。"},
        { "location": "232/TALK"  , "narrator": "赤髪千羽鶴", "text": "ですから、少ない母集団の\n想いさえも、どこかに、\n何かの形で反映されます。"},
        { "location": "233/TALK"  , "narrator": "赤髪千羽鶴", "text": "ただ、それらは実際に、\n世界に触れてみないと\nわからないかもしれません。"},
        { "location": "234/TALK"  , "narrator": "赤髪千羽鶴", "text": "そしてそれこそが、\n今回の収束によって出来た\n世界の全てなんです。"},
        { "location": "235/TALK"  , "narrator": "赤髪千羽鶴", "text": "ちなみに、何故私が\n原初の逢瀬つばめの\n姿をしてるかですが――"},
        { "location": "236/TALK"  , "narrator": "赤髪千羽鶴", "text": "お察しの通り、\n千羽鶴が逢瀬つばめ本体に\n回帰したからです。"},
        { "location": "237/TALK"  , "narrator": "赤髪千羽鶴", "text": "ただ、これはわたしの\nエゴでしかないのかも\nしれませんが――"},
        { "location": "238/TALK"  , "narrator": "赤髪千羽鶴", "text": "フェノメノンの中では、\nこれからも今まで通りの\n姿でいさせてください。"},
        { "location": "239/TALK"  , "narrator": "赤髪千羽鶴", "text": "なぜなら、それさえも\nわたしの世界の一部だと\n思うからです。"},
        { "location": "240/TALK"  , "narrator": "赤髪千羽鶴", "text": "わたしがわたしの姿を\nしていること。貴方が\n貴方であること――"},
        { "location": "241/TALK"  , "narrator": "赤髪千羽鶴", "text": "どれかひとつが\n変わっても、世界は\n変わってしまいます。"},
        { "location": "242/TALK"  , "narrator": "赤髪千羽鶴", "text": "ですからわたしは、\nこれからも同じわたしで\n在り続けます。"},
        { "location": "243/TALK"  , "narrator": "赤髪千羽鶴", "text": "……。"},
        { "location": "244/TALK"  , "narrator": "赤髪千羽鶴", "text": "なんて。\n正直に言うと、あの髪型\nお気に入りなんです。"},
        { "location": "245/TALK"  , "narrator": "赤髪千羽鶴", "text": "研究施設では、\nこの髪型しかさせて\nもらえませんでしたから。"},
        { "location": "246/TALK"  , "narrator": "赤髪千羽鶴", "text": "というわけで、\nわたしからの報告は\n以上となります。"},
        { "location": "247/TALK"  , "narrator": "赤髪千羽鶴", "text": "長々と話して\nしまいましたが、ご清聴\nありがとうございました。"},
        { "location": "248/SEL"   , "narrator": "", "text": "ありがとう！"},
        { "location": "249/SEL"   , "narrator": "", "text": "これからどうなるの？"},
        { "location": "250/ACT"   , "narrator": "", "text": "ありがとう！"},
        { "location": "251/TALK"  , "narrator": "赤髪千羽鶴", "text": "いえ。\nお役に立てて何よりです。"},
        { "location": "252/ACT"   , "narrator": "", "text": "これからどうなるの？"},
        { "location": "253/TALK"  , "narrator": "赤髪千羽鶴", "text": "それはわたしにも\nわかりません。"},
        { "location": "254/TALK"  , "narrator": "赤髪千羽鶴", "text": "今決まっている現実とは、\nカレンのフェノメノンが\n継続展開されることだけ。"},
        { "location": "255/TALK"  , "narrator": "赤髪千羽鶴", "text": "これからそれが\nどうなっていくのか。"},
        { "location": "256/TALK"  , "narrator": "赤髪千羽鶴", "text": "ずっと続くのか、\n“彼ら”によって、すぐに\n潰されるのか。"},
        { "location": "257/TALK"  , "narrator": "赤髪千羽鶴", "text": "それすらも、\n私にはわかりません。"},
        { "location": "258/SEL"   , "narrator": "", "text": "なるほど"},
        { "location": "259/SEL"   , "narrator": "", "text": "怖いこと言わないで"},
        { "location": "260/ACT"   , "narrator": "", "text": "なるほど"},
        { "location": "261/ACT"   , "narrator": "", "text": "怖いこと言わないで"},
        { "location": "262/TALK"  , "narrator": "赤髪千羽鶴", "text": "すみません。\nでも、そうですよね。"},
        { "location": "263/TALK"  , "narrator": "赤髪千羽鶴", "text": "暗い未来はいくらでも\n思い描けますが、\n新しい未来も同じです。"},
        { "location": "264/TALK"  , "narrator": "赤髪千羽鶴", "text": "もっとポジティブに\n生きないと\nいけませんよね。"},
        { "location": "267/ACT"   , "narrator": "", "text": "見ない"},
        { "location": "268/TALK"  , "narrator": "赤髪千羽鶴", "text": "わかりました。"},
        { "location": "269/TALK"  , "narrator": "赤髪千羽鶴", "text": "それでは結果報告は\nこれでお終いです。"},
        { "location": "271/TALK"  , "narrator": "赤髪千羽鶴", "text": "えー……、さて。\nこんな状況ですから――"},
        { "location": "272/TALK"  , "narrator": "赤髪千羽鶴", "text": "$handle$さんは\n恐らくすぐにでも未来を\n覗きたいでしょうが。"},
        { "location": "273/TALK"  , "narrator": "赤髪千羽鶴", "text": "残念ながら、\n今はOSさんのモードが\n変わっちゃってます。"},
        { "location": "274/TALK"  , "narrator": "赤髪千羽鶴", "text": "ですから、今すぐに\nこの先の状況を見ることは\nできません。"},
        { "location": "275/TALK"  , "narrator": "赤髪千羽鶴", "text": "OSさんがリブートして\nもとのモードに戻るまで\nお休みなんです。"},
        { "location": "276/SEL"   , "narrator": "", "text": "残念……"},
        { "location": "277/SEL"   , "narrator": "", "text": "でも、えいもん見せてくれるんやろ？ほれほれ"},
        { "location": "278/ACT"   , "narrator": "", "text": "残念……"},
        { "location": "279/TALK"  , "narrator": "赤髪千羽鶴", "text": "ごめんなさい。"},
        { "location": "281/TALK"  , "narrator": "赤髪千羽鶴", "text": "で、でもですね。"},
        { "location": "282/TALK"  , "narrator": "赤髪千羽鶴", "text": "このまま何もナシは\nあまりにも申し訳\nありませんから――"},
        { "location": "283/TALK"  , "narrator": "赤髪千羽鶴", "text": "楽しめるかわかりませんが\nちょっとしたものを\n用意してきました。"},
        { "location": "284/SEL"   , "narrator": "", "text": "やったー！！"},
        { "location": "285/ACT"   , "narrator": "", "text": "やったー！！"},
        { "location": "288/TALK"  , "narrator": "赤髪千羽鶴", "text": "ああっ！\nでも、全然大した\nものじゃないですよ！？"},
        { "location": "289/ACT"   , "narrator": "", "text": "でも、えいもん見せてくれるんやろ？ほれほれ"},
        { "location": "292/TALK"  , "narrator": "赤髪千羽鶴", "text": "<size=40>どーん！！</size>"},
        { "location": "293/TALK"  , "narrator": "赤髪千羽鶴", "text": "って！\n何やってるんですかね\nわたしは！？"},
        { "location": "294/TALK"  , "narrator": "赤髪千羽鶴", "text": "えっと！\nえいもんっていうほど\nイイモノじゃないです！"},
        { "location": "295/TALK"  , "narrator": "赤髪千羽鶴", "text": "でも、\n暇つぶしにはなるかなと\n思って……。"},
        { "location": "297/TALK"  , "narrator": "赤髪千羽鶴", "text": "ちょっとだけ\n歌を歌ってみたんです。"},
        { "location": "298/TALK"  , "narrator": "赤髪千羽鶴", "text": "$handle$さんと\n出逢ってすぐの頃のこと、\n思い出して。"},
        { "location": "299/TALK"  , "narrator": "赤髪千羽鶴", "text": "あの時、フェノメノンの\n中にいるわたし、\n逢瀬つばめと――"},
        { "location": "300/TALK"  , "narrator": "赤髪千羽鶴", "text": "もう一人のわたし、\n皇千羽鶴が出逢いました。"},
        { "location": "301/TALK"  , "narrator": "赤髪千羽鶴", "text": "そうです。\n$handle$さんが\n引き合わせてくれました。"},
        { "location": "302/TALK"  , "narrator": "赤髪千羽鶴", "text": "それ自体はポジティブな\n引き合わせでは\nありませんでしたが……。"},
        { "location": "303/TALK"  , "narrator": "赤髪千羽鶴", "text": "でも、それも含めて、\n今の今まであなたが\n関わってくれた――"},
        { "location": "304/TALK"  , "narrator": "赤髪千羽鶴", "text": "その全てが、\n今を作り出しています。"},
        { "location": "305/TALK"  , "narrator": "赤髪千羽鶴", "text": "$handle$さんが\nあの時引き合わせて\nくれていなかったら。"},
        { "location": "306/TALK"  , "narrator": "赤髪千羽鶴", "text": "もしかしたら、\nとっくにこの世界は\n無くなっていたかもです。"},
        { "location": "307/TALK"  , "narrator": "赤髪千羽鶴", "text": "全ての選択に\n絶対的な間違いなんて\nありません。"},
        { "location": "308/TALK"  , "narrator": "赤髪千羽鶴", "text": "例えその瞬間は\n不幸なことになったと\nしても――"},
        { "location": "309/TALK"  , "narrator": "赤髪千羽鶴", "text": "その事がなければ、\nその後の幸せな思い出も、\n全部無くなります。"},
        { "location": "311/TALK"  , "narrator": "赤髪千羽鶴", "text": "だから、\nありがとう。\n$handle$さん。"},
        { "location": "312/TALK"  , "narrator": "赤髪千羽鶴", "text": "わたしたちみんなに\n沢山の幸せを\nプレゼントしてくれて。"},
        { "location": "313/TALK"  , "narrator": "赤髪千羽鶴", "text": "そんな\n感謝の気持ちを込めて、\n贈りたいと思います。"},
        { "location": "314/TALK"  , "narrator": "赤髪千羽鶴", "text": "大好きな\n$handle$さんへ――"},
        { "location": "316/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/40MB 2:35】</color>"},
        { "location": "317/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/14MB 2:35】</color>"},
        { "location": "318/SEL"   , "narrator": "", "text": "スキップする"},
        { "location": "319/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/40MB 2:35】</color>"},
        { "location": "320/TALK"  , "narrator": "赤髪千羽鶴", "text": "はい。"},
        { "location": "326/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/14MB 2:35】</color>"},
        { "location": "327/TALK"  , "narrator": "赤髪千羽鶴", "text": "はい。"},
        { "location": "333/ACT"   , "narrator": "", "text": "スキップする"},
        { "location": "334/TALK"  , "narrator": "赤髪千羽鶴", "text": "そうですか。\nわかりました。"},
        { "location": "335/TALK"  , "narrator": "赤髪千羽鶴", "text": "ちょっと寂しいですが、\nまた気が向いたら\n見に来てくださいね。"},
        { "location": "354/TALK"  , "narrator": "赤髪千羽鶴", "text": "……。"},
        { "location": "355/TALK"  , "narrator": "赤髪千羽鶴", "text": "こうしてまじまじと\n見られると、なんだか\n恥ずかしいですね。"},
        { "location": "356/SEL"   , "narrator": "", "text": "超かわいかった！"},
        { "location": "357/SEL"   , "narrator": "", "text": "確かにこれは恥ずかしい"},
        { "location": "358/ACT"   , "narrator": "", "text": "超かわいかった！"},
        { "location": "359/TALK"  , "narrator": "赤髪千羽鶴", "text": "はぁっ……\nそ、そんなこと\nありませんから…！"},
        { "location": "360/TALK"  , "narrator": "赤髪千羽鶴", "text": "…って、よくよく考えたら\nわたしの事じゃなくて、\n繭の中のつばめですよね。"},
        { "location": "361/TALK"  , "narrator": "赤髪千羽鶴", "text": "確かにフェノメノンの\n中のつばめは\n可愛いと思います！！"},
        { "location": "363/TALK"  , "narrator": "赤髪千羽鶴", "text": "わたしがいつも、こんな\n可愛い子になれたら……\nって思ってた子なんです。"},
        { "location": "364/TALK"  , "narrator": "赤髪千羽鶴", "text": "だから、これからもどうか\n可愛がってくれたら\n嬉しいです。"},
        { "location": "365/SEL"   , "narrator": "", "text": "もちろんだよ！"},
        { "location": "366/SEL"   , "narrator": "", "text": "原初のつばめも可愛いよ"},
        { "location": "367/ACT"   , "narrator": "", "text": "もちろんだよ！"},
        { "location": "369/TALK"  , "narrator": "赤髪千羽鶴", "text": "ありがとうございます！"},
        { "location": "370/ACT"   , "narrator": "", "text": "原初のつばめも可愛いよ"},
        { "location": "372/TALK"  , "narrator": "赤髪千羽鶴", "text": "そんなことありません。"},
        { "location": "373/TALK"  , "narrator": "赤髪千羽鶴", "text": "それはまだ\nわたしのことを\nよく知らないからです。"},
        { "location": "374/TALK"  , "narrator": "赤髪千羽鶴", "text": "でも、知らないことは\n知らないままの方が\nいいこともあります。"},
        { "location": "375/TALK"  , "narrator": "赤髪千羽鶴", "text": "そんなことより、\n繭の中のつばめを\n可愛がってあげて下さい。"},
        { "location": "376/TALK"  , "narrator": "赤髪千羽鶴", "text": "宜しくお願いします！"},
        { "location": "378/ACT"   , "narrator": "", "text": "確かにこれは恥ずかしい"},
        { "location": "379/TALK"  , "narrator": "赤髪千羽鶴", "text": "あはは……\nやっぱりそうですよね。"},
        { "location": "380/TALK"  , "narrator": "赤髪千羽鶴", "text": "さすがにちょっと\nやり過ぎですよね。"},
        { "location": "381/TALK"  , "narrator": "赤髪千羽鶴", "text": "ひきますよね……。"},
        { "location": "382/TALK"  , "narrator": "赤髪千羽鶴", "text": "……。"},
        { "location": "383/SEL"   , "narrator": "", "text": "そんなことないよ？"},
        { "location": "384/SEL"   , "narrator": "", "text": "ソンナコトナイヨ？"},
        { "location": "385/ACT"   , "narrator": "", "text": "そんなことないよ？"},
        { "location": "387/TALK"  , "narrator": "赤髪千羽鶴", "text": "ほんとですか？"},
        { "location": "389/TALK"  , "narrator": "赤髪千羽鶴", "text": "良かったです！"},
        { "location": "390/TALK"  , "narrator": "赤髪千羽鶴", "text": "フェノメノンの中のつばめ\n可愛いと思いませんか？"},
        { "location": "392/TALK"  , "narrator": "赤髪千羽鶴", "text": "わたしがいつも、こんな\n可愛い子になれたら……\nって思ってた子なんです。"},
        { "location": "394/TALK"  , "narrator": "赤髪千羽鶴", "text": "だから、これからもどうか\n可愛がってくれたら\n嬉しいです。"},
        { "location": "395/ACT"   , "narrator": "", "text": "ソンナコトナイヨ？"},
        { "location": "396/TALK"  , "narrator": "赤髪千羽鶴", "text": "……。"},
        { "location": "397/TALK"  , "narrator": "赤髪千羽鶴", "text": "嘘ですよね。"},
        { "location": "398/TALK"  , "narrator": "赤髪千羽鶴", "text": "いえ、いいんです。\n人の好みは\nそれぞれですから。"},
        { "location": "401/TALK"  , "narrator": "赤髪千羽鶴", "text": "ところで、わたし\n１つだけ心残りが\nあるんですけど。"},
        { "location": "402/SEL"   , "narrator": "", "text": "どうしたの？"},
        { "location": "403/ACT"   , "narrator": "", "text": "どうしたの？"},
        { "location": "405/TALK"  , "narrator": "赤髪千羽鶴", "text": "実は今回のMVですが、\nわたしのお気に入りの\n部分が無いんです。"},
        { "location": "406/TALK"  , "narrator": "赤髪千羽鶴", "text": "尺の問題で、\nバッサリと。"},
        { "location": "407/SEL"   , "narrator": "", "text": "そ、そうなんだ"},
        { "location": "408/SEL"   , "narrator": "", "text": "尺の問題て…世知辛いね…"},
        { "location": "409/ACT"   , "narrator": "", "text": "そ、そうなんだ"},
        { "location": "410/TALK"  , "narrator": "赤髪千羽鶴", "text": "はい。"},
        { "location": "411/ACT"   , "narrator": "", "text": "尺の問題て…世知辛いね…"},
        { "location": "412/TALK"  , "narrator": "赤髪千羽鶴", "text": "ホントですよ…。"},
        { "location": "418/TALK"  , "narrator": "赤髪千羽鶴", "text": "なので、\n是非フルバージョンを\n聴いて下さい！"},
        { "location": "419/TALK"  , "narrator": "赤髪千羽鶴", "text": "途中のところ、\nすごい頑張ったので！"},
        { "location": "420/TALK"  , "narrator": "赤髪千羽鶴", "text": "その部分を\n聴いて欲しいんです。"},
        { "location": "421/TALK"  , "narrator": "赤髪千羽鶴", "text": "それで、その中に\n隠してる言葉を\n当ててみてください！"},
        { "location": "422/TALK"  , "narrator": "赤髪千羽鶴", "text": "あ、でも、これは\n世界の謎とかそういうの\nじゃなくて――"},
        { "location": "423/TALK"  , "narrator": "赤髪千羽鶴", "text": "タダのお遊びなので、\n気が向いたらでいいです。"},
        { "location": "424/TALK"  , "narrator": "赤髪千羽鶴", "text": "ちょっと\n$handle$さんと\n遊びたいなって思って…。"},
        { "location": "426/TALK"  , "narrator": "赤髪千羽鶴", "text": "ほんと、\nそれだけなので！"},
        { "location": "430/SEL"   , "narrator": "", "text": "すごい気になる！"},
        { "location": "431/SEL"   , "narrator": "", "text": "まあ、気が向いたらね"},
        { "location": "432/ACT"   , "narrator": "", "text": "すごい気になる！"},
        { "location": "434/TALK"  , "narrator": "赤髪千羽鶴", "text": "ホントですか？\n嬉しいです！"},
        { "location": "435/TALK"  , "narrator": "赤髪千羽鶴", "text": "是非挑戦してみて\nください！"},
        { "location": "436/TALK"  , "narrator": "赤髪千羽鶴", "text": "それで、\n答えがわかったら\n教えてくださいね。"},
        { "location": "437/ACT"   , "narrator": "", "text": "まあ、気が向いたらね"},
        { "location": "439/TALK"  , "narrator": "赤髪千羽鶴", "text": "そうですね。\nそんなくらいで\nいいと思います。"},
        { "location": "442/TALK"  , "narrator": "赤髪千羽鶴", "text": "とまあ、\nそんな感じでしょうか。"},
        { "location": "443/TALK"  , "narrator": "赤髪千羽鶴", "text": "あ！\nまだありました！"},
        { "location": "448/TALK"  , "narrator": "赤髪千羽鶴", "text": "わたしのお話を最新まで\n見ると、お土産もいっぱい\nもらえるんです！"},
        { "location": "449/TALK"  , "narrator": "赤髪千羽鶴", "text": "なので、よかったら\n見ていってください。"},
        { "location": "454/TALK"  , "narrator": "赤髪千羽鶴", "text": "……だいぶ時間\n経っちゃいましたね。"},
        { "location": "455/TALK"  , "narrator": "赤髪千羽鶴", "text": "そろそろOSさんの\nリブートも\n終わると思います。"},
        { "location": "456/TALK"  , "narrator": "赤髪千羽鶴", "text": "次に来てくれる時には、\nきっと未来へ進むことが\nできるはずです。"},
        { "location": "457/TALK"  , "narrator": "赤髪千羽鶴", "text": "そのときわたしが\nここにいるかどうかは\nわかりませんが――"},
        { "location": "458/SEL"   , "narrator": "", "text": "またお話したい"},
        { "location": "459/SEL"   , "narrator": "", "text": "次はエリカさんかな"},
        { "location": "460/SEL"   , "narrator": "", "text": "ソイルトンカムバック"},
        { "location": "461/ACT"   , "narrator": "", "text": "またお話したい"},
        { "location": "463/TALK"  , "narrator": "赤髪千羽鶴", "text": "あ、\nありがとうございます…。"},
        { "location": "464/ACT"   , "narrator": "", "text": "次はエリカさんかな"},
        { "location": "466/TALK"  , "narrator": "赤髪千羽鶴", "text": "きっとそうだと\n思います。"},
        { "location": "467/ACT"   , "narrator": "", "text": "ソイルトンカムバック"},
        { "location": "469/TALK"  , "narrator": "赤髪千羽鶴", "text": "ソイルトンさんと\nお話してると\n楽しいですよね。"},
        { "location": "471/TALK"  , "narrator": "赤髪千羽鶴", "text": "いずれにしても、\nこの世界を引き続き\nよろしくお願いします。"},
        { "location": "472/TALK"  , "narrator": "赤髪千羽鶴", "text": "それじゃ、また\nお逢いできる日まで。"},
        { "location": "473/TALK"  , "narrator": "赤髪千羽鶴", "text": "あなたと\nこの世界の皆さんに、\n素敵なココロの旅を。"},
        { "location": "139/DIALOG", "narrator": "Event/Dialog_EventPicTallNW", "text": "PARAMETRIC REPORT.\n【水鏡の神子】"},
