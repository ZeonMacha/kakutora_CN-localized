        { "location": "158/DIALOG", "narrator": "Event/Dialog_EventPicTallNW", "text": "PARAMETRIC REPORT.\n【なご】"},
        { "location": "220/DIALOG", "narrator": "Event/Dialog_EventPicTallNW", "text": "PARAMETRIC REPORT.\n【千羽鶴とカレン】"},
