        "title": "001 アニメーション",
        "sub_title": "キュウ・カグラ"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "アニメ第34話"},
        { "location": "20/TALK"   , "narrator": "千羽鶴", "text": "ごきげんよう、\n$handle$。"},
        { "location": "21/TALK"   , "narrator": "千羽鶴", "text": "もう一度\n私との会話を\n再現する？"},
        { "location": "22/SEL"    , "narrator": "", "text": "はい"},
        { "location": "23/SEL"    , "narrator": "", "text": "いいえ"},
        { "location": "24/ACT"    , "narrator": "", "text": "はい"},
        { "location": "25/TALK"   , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "27/ACT"    , "narrator": "", "text": "いいえ"},
        { "location": "28/TALK"   , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "34/TALK"   , "narrator": "千羽鶴", "text": "ごきげんよう、\n$handle$。"},
        { "location": "35/SEL"    , "narrator": "", "text": "こんにちは"},
        { "location": "36/SEL"    , "narrator": "", "text": "ちーちゃん？"},
        { "location": "37/ACT"    , "narrator": "", "text": "こんにちは"},
        { "location": "38/ACT"    , "narrator": "", "text": "ちーちゃん？"},
        { "location": "39/TALK"   , "narrator": "千羽鶴", "text": "なに？"},
        { "location": "40/SEL"    , "narrator": "", "text": "なんか雰囲気が…"},
        { "location": "41/ACT"    , "narrator": "", "text": "なんか雰囲気が…"},
        { "location": "43/TALK"   , "narrator": "千羽鶴", "text": "今回は、\n記念すべき回だから。"},
        { "location": "45/TALK"   , "narrator": "千羽鶴", "text": "リプレイス前の\nこのセクションは、\n特別な時間だった。"},
        { "location": "46/TALK"   , "narrator": "千羽鶴", "text": "何があったか覚えてる？"},
        { "location": "47/SEL"    , "narrator": "", "text": "千羽鶴とのディベートと、重大な選択をした"},
        { "location": "48/SEL"    , "narrator": "", "text": "千羽鶴とファーストキスをした"},
        { "location": "49/ACT"    , "narrator": "", "text": "千羽鶴とのディベートと、重大な選択をした"},
        { "location": "50/TALK"   , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "51/ACT"    , "narrator": "", "text": "千羽鶴とファーストキスをした"},
        { "location": "54/TALK"   , "narrator": "千羽鶴", "text": "……覚えてたとは。"},
        { "location": "56/TALK"   , "narrator": "千羽鶴", "text": "そんな\n後世に役に立たないことは\n忘れて。"},
        { "location": "57/TALK"   , "narrator": "千羽鶴", "text": "でも――"},
        { "location": "59/TALK"   , "narrator": "千羽鶴", "text": "残念ながら、\n私もよく覚えてる。"},
        { "location": "60/TALK"   , "narrator": "千羽鶴", "text": "私が初めて、\n一人の少女として、\n私として身を委ねた日。"},
        { "location": "61/TALK"   , "narrator": "千羽鶴", "text": "そして、それができる\n相手を見つけた日。"},
        { "location": "62/TALK"   , "narrator": "千羽鶴", "text": "そんな日のことを、\n忘れてしまうわけがない。"},
        { "location": "63/SEL"    , "narrator": "", "text": "愛してるよ"},
        { "location": "64/SEL"    , "narrator": "", "text": "千羽鶴を本当の意味で支えられて嬉しかった"},
        { "location": "65/ACT"    , "narrator": "", "text": "愛してるよ"},
        { "location": "66/TALK"   , "narrator": "千羽鶴", "text": "……うん。"},
        { "location": "67/TALK"   , "narrator": "千羽鶴", "text": "<size=15>私も好き。</size>"},
        { "location": "68/ACT"    , "narrator": "", "text": "千羽鶴を本当の意味で支えられて嬉しかった"},
        { "location": "69/TALK"   , "narrator": "千羽鶴", "text": "ええ。"},
        { "location": "70/TALK"   , "narrator": "千羽鶴", "text": "今でも思う。\n貴方がいてくれて\nよかったと。"},
        { "location": "73/TALK"   , "narrator": "千羽鶴", "text": "けど、今回の主題は\nこの件じゃない。"},
        { "location": "74/TALK"   , "narrator": "千羽鶴", "text": "こっちは後回しで、\n本題に話を戻すと――"},
        { "location": "75/TALK"   , "narrator": "千羽鶴", "text": "私とのディベートをし、\n貴方が世界に対する\n重大な選択をした回。"},
        { "location": "77/TALK"   , "narrator": "千羽鶴", "text": "してないから。"},
        { "location": "78/TALK"   , "narrator": "千羽鶴", "text": "私とのディベートをし、\n貴方が世界に対する\n重大な選択をした回。"},
        { "location": "81/TALK"   , "narrator": "千羽鶴", "text": "まさにこの時。\n私は世界の状況と\n戦略を全てさらけ出し――"},
        { "location": "82/TALK"   , "narrator": "千羽鶴", "text": "貴方の意見を総意で問う\nということを行った。"},
        { "location": "83/TALK"   , "narrator": "千羽鶴", "text": "思えば、リプレイスの\n要である総意が、具体的に\n使われたのも、ここが初。"},
        { "location": "85/TALK"   , "narrator": "千羽鶴", "text": "そしてこの時、\n貴方が出した回答は――"},
        { "location": "86/TALK"   , "narrator": "千羽鶴", "text": "私の理想的社会創造を\n支持し、トライナリーの\n発症を容認する、だった。"},
        { "location": "87/TALK"   , "narrator": "千羽鶴", "text": "結果として大きな流れは\nこちらには向かなかった\nけど――"},
        { "location": "88/TALK"   , "narrator": "千羽鶴", "text": "貴方の選択は、私に\nとても強い希望の光を\nもたらした。"},
        { "location": "89/TALK"   , "narrator": "千羽鶴", "text": "今でもそのことを\n感謝せずにはいられない。"},
        { "location": "91/TALK"   , "narrator": "千羽鶴", "text": "そしてこの時、\n貴方が出した回答は――"},
        { "location": "92/TALK"   , "narrator": "千羽鶴", "text": "私の理想的社会創造は\n賛同するがトライナリーの\n発症は容認せず、だった。"},
        { "location": "93/TALK"   , "narrator": "千羽鶴", "text": "私が貴方をこの世界に\n繋げた目的を考えれば\n順当とも言える回答。"},
        { "location": "95/TALK"   , "narrator": "千羽鶴", "text": "そしてこの時、\n貴方が出した回答は――"},
        { "location": "96/TALK"   , "narrator": "千羽鶴", "text": "私の理想的社会創造は\n支持しないが、好感は\n持てる、という回答。"},
        { "location": "98/TALK"   , "narrator": "千羽鶴", "text": "そしてこの時、\n貴方が出した回答は――"},
        { "location": "99/TALK"   , "narrator": "千羽鶴", "text": "もう二度と目の前に\n現れないで欲しい、という\nものだった。"},
        { "location": "101/TALK"  , "narrator": "千羽鶴", "text": "最初はとても\n残念だったけど、\n後に和解できてよかった。"},
        { "location": "102/TALK"  , "narrator": "千羽鶴", "text": "貴方がどんな理由で、\n私を拒絶したのかも、\nわかってよかった。"},
        { "location": "103/TALK"  , "narrator": "千羽鶴", "text": "先入観でモノを見る事は\n他人の本質を見失う事だと\nこのとき学習した。"},
        { "location": "104/TALK"  , "narrator": "千羽鶴", "text": "だから、ありがとう。"},
        { "location": "106/TALK"  , "narrator": "千羽鶴", "text": "今でもそのままでは\nあるけれども――"},
        { "location": "107/TALK"  , "narrator": "千羽鶴", "text": "でも、もう\n時効ってことでいい？"},
        { "location": "108/TALK"  , "narrator": "千羽鶴", "text": "あれから色んなことが\nあって、随分と時間も\n経ってしまった。"},
        { "location": "109/TALK"  , "narrator": "千羽鶴", "text": "そういったものが、\n解決してくれる何かも\nあると思うから。"},
        { "location": "112/TALK"  , "narrator": "千羽鶴", "text": "当時の私にとっては、\n総意というものは\n“扱うもの”ではなく――"},
        { "location": "113/TALK"  , "narrator": "千羽鶴", "text": "“扱われるもの”だった。"},
        { "location": "114/SEL"   , "narrator": "", "text": "？？"},
        { "location": "115/ACT"   , "narrator": "", "text": "？？"},
        { "location": "117/TALK"  , "narrator": "千羽鶴", "text": "覚えてる？"},
        { "location": "118/TALK"  , "narrator": "千羽鶴", "text": "この時の総意は、決して\n私にとって、ポジティブな\nものではなかったこと。"},
        { "location": "119/TALK"  , "narrator": "千羽鶴", "text": "総意の主催者は私ではなく\n“彼ら”であり、\nその目的は未来の統合。"},
        { "location": "120/SEL"   , "narrator": "", "text": "未来の統合ってなに？"},
        { "location": "121/ACT"   , "narrator": "", "text": "未来の統合ってなに？"},
        { "location": "123/TALK"  , "narrator": "千羽鶴", "text": "あまり難しく\n考えなくてもいい。"},
        { "location": "124/TALK"  , "narrator": "千羽鶴", "text": "貴方がリプレイス作戦で\nやってきたこと、それが\n未来の統合そのもの。"},
        { "location": "125/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "126/TALK"  , "narrator": "千羽鶴", "text": "うーん……"},
        { "location": "127/TALK"  , "narrator": "千羽鶴", "text": "今回は記念回でもあるし、\n丁度いいから「総意」に\nついて少しお話しましょ。"},
        { "location": "128/SEL"   , "narrator": "", "text": "わーい！"},
        { "location": "129/SEL"   , "narrator": "", "text": "そういう話は結構です"},
        { "location": "130/ACT"   , "narrator": "", "text": "わーい！"},
        { "location": "131/TALK"  , "narrator": "千羽鶴", "text": "総意というシステムの\n目的は、世界の行く末を\n拡散させないこと。"},
        { "location": "132/TALK"  , "narrator": "千羽鶴", "text": "普段から世界は、\n貴方たちが自由に発言する\n事で徐々に拡散していく。"},
        { "location": "133/TALK"  , "narrator": "千羽鶴", "text": "極論、１０人が違う選択を\nし続ければ、いずれ未来は\n１０に別れてしまう。"},
        { "location": "134/TALK"  , "narrator": "千羽鶴", "text": "すなわち、\n１０個の平行世界に\n分散してしまう。"},
        { "location": "135/TALK"  , "narrator": "千羽鶴", "text": "そうならないよう、\n世界が別れてしまいそうな\n重大決議においては、"},
        { "location": "136/TALK"  , "narrator": "千羽鶴", "text": "総意という、\n一つの大きな流れに\nまとめることをする。"},
        { "location": "137/SEL"   , "narrator": "", "text": "なぜまとめないといけないの？"},
        { "location": "138/ACT"   , "narrator": "", "text": "なぜまとめないといけないの？"},
        { "location": "140/TALK"  , "narrator": "千羽鶴", "text": "もう、あまりにも\n色んな情報が氾濫して、\n忘れてるかもだけど。"},
        { "location": "141/TALK"  , "narrator": "千羽鶴", "text": "今のこの\nフェノメノンは――"},
        { "location": "142/TALK"  , "narrator": "千羽鶴", "text": "貴方たちの見ている、\n貴方たちの世界を\n雛形にしている。"},
        { "location": "143/TALK"  , "narrator": "千羽鶴", "text": "そして、その世界の\n正確性やディテールは\n母数によって変わる。"},
        { "location": "144/TALK"  , "narrator": "千羽鶴", "text": "すなわち、母数が多い程\n正確な世界を複写でき、\n確固たる基盤を形成する。"},
        { "location": "145/TALK"  , "narrator": "千羽鶴", "text": "母数が減れば、いわゆる\nトンデモな世界になる\n隙を作ることになる。"},
        { "location": "146/TALK"  , "narrator": "千羽鶴", "text": "思い出した？"},
        { "location": "147/SEL"   , "narrator": "", "text": "覚えてたよ"},
        { "location": "148/SEL"   , "narrator": "", "text": "忘れてたよ"},
        { "location": "149/ACT"   , "narrator": "", "text": "覚えてたよ"},
        { "location": "150/TALK"  , "narrator": "千羽鶴", "text": "さすが、優秀。"},
        { "location": "151/ACT"   , "narrator": "", "text": "忘れてたよ"},
        { "location": "152/TALK"  , "narrator": "千羽鶴", "text": "実は私も、\n半ば忘れてた。"},
        { "location": "153/TALK"  , "narrator": "千羽鶴", "text": "だから復習も兼ねて、\n原点をなぞっている。"},
        { "location": "155/TALK"  , "narrator": "千羽鶴", "text": "とにかく、総意をとる\nことは、私達の世界の\n品質維持に重要なの。"},
        { "location": "156/TALK"  , "narrator": "千羽鶴", "text": "ここで、\n話を最初に戻すと――"},
        { "location": "157/TALK"  , "narrator": "千羽鶴", "text": "リプレイス前のこの回で\n行われた総意は、彼らが\n主催したもので。"},
        { "location": "158/TALK"  , "narrator": "千羽鶴", "text": "私はそれを受けることが\n決まっていた。"},
        { "location": "159/TALK"  , "narrator": "千羽鶴", "text": "そうしなければ、確かに\nこの繭内の日本は、徐々に\n正確性を失っていき――"},
        { "location": "160/TALK"  , "narrator": "千羽鶴", "text": "終いには、沢山の、\n少しずつ異なった現実味の\nない平行世界に分散する。"},
        { "location": "161/TALK"  , "narrator": "千羽鶴", "text": "そう、例えば、カレンが\n言っていたような――"},
        { "location": "162/TALK"  , "narrator": "千羽鶴", "text": "「輝けるメノウ社会」が\n本当に実現してしまう。"},
        { "location": "163/TALK"  , "narrator": "千羽鶴", "text": "それ自体は、\nフェノメノンとしては\n自由でいいのだけど。"},
        { "location": "164/TALK"  , "narrator": "千羽鶴", "text": "昇華させ、現実に蒸着\nさせることを考えれば、\n非常に良くないこと。"},
        { "location": "165/TALK"  , "narrator": "千羽鶴", "text": "だから、世界を誰に任せ\nどう扱っていくかという\n最大の分岐については、"},
        { "location": "166/TALK"  , "narrator": "千羽鶴", "text": "“彼ら”の指示云々以前に\n確実にやっておかなくては\nならないものだった。"},
        { "location": "167/TALK"  , "narrator": "千羽鶴", "text": "リプレイス作戦で、\n総意を積極的に使ってるの\nとは対称的でしょう？"},
        { "location": "168/SEL"   , "narrator": "", "text": "確かに"},
        { "location": "169/SEL"   , "narrator": "", "text": "でもそれって、彼らの思うつぼだったのでは？"},
        { "location": "170/ACT"   , "narrator": "", "text": "確かに"},
        { "location": "171/ACT"   , "narrator": "", "text": "でもそれって、彼らの思うつぼだったのでは？"},
        { "location": "172/TALK"  , "narrator": "千羽鶴", "text": "そうでもない。"},
        { "location": "173/TALK"  , "narrator": "千羽鶴", "text": "なぜなら、\nその総意の質問として、\n何をテーマとするか――"},
        { "location": "174/TALK"  , "narrator": "千羽鶴", "text": "すなわち、どういった\n将来像に焦点を当てるかは\n私に委ねられていたから。"},
        { "location": "175/TALK"  , "narrator": "千羽鶴", "text": "ただ、その結果を見て、\nその後彼らが外側から\n何らかの措置をすること、"},
        { "location": "176/TALK"  , "narrator": "千羽鶴", "text": "それ自体は、\n大方予想がついていた。"},
        { "location": "177/TALK"  , "narrator": "千羽鶴", "text": "だから、総意をとって\nその結果を即座に世界に\n反映できるものにした。"},
        { "location": "178/TALK"  , "narrator": "千羽鶴", "text": "すなわち、理想は、\n総意直後にトライナリーは\n昇華をし――"},
        { "location": "179/TALK"  , "narrator": "千羽鶴", "text": "フュージョンクランと共に\n世界全体をフェノメノンで\n覆うというシナリオ。"},
        { "location": "180/TALK"  , "narrator": "千羽鶴", "text": "この間に、彼らに\n何らかの手出しをされたら\nアウトだったから。"},
        { "location": "181/TALK"  , "narrator": "千羽鶴", "text": "だから、直球即決案件を\n提示する他なかった。"},
        { "location": "182/SEL"   , "narrator": "", "text": "なるほど"},
        { "location": "183/ACT"   , "narrator": "", "text": "なるほど"},
        { "location": "187/TALK"  , "narrator": "千羽鶴", "text": "と、まあ。\n過去話はこれくらいにして\n閑話休題。"},
        { "location": "188/ACT"   , "narrator": "", "text": "そういう話は結構です"},
        { "location": "189/TALK"  , "narrator": "千羽鶴", "text": "わかった。\nまあ、その気持ちは\nわからなくもない。"},
        { "location": "190/TALK"  , "narrator": "千羽鶴", "text": "とにかく。"},
        { "location": "192/TALK"  , "narrator": "千羽鶴", "text": "今回は、初めての\n世界を収束させる総意選択\nから、丁度一周回した。"},
        { "location": "193/TALK"  , "narrator": "千羽鶴", "text": "そして、今だからこそ、\nあなたに問いたい\nひとつの質問がある。"},
        { "location": "194/TALK"  , "narrator": "千羽鶴", "text": "貴方にとって、\n総意とはなんでしたか？"},
        { "location": "195/SEL"   , "narrator": "", "text": "えっと、それは"},
        { "location": "198/ACT"   , "narrator": "", "text": "えっと、それは"},
        { "location": "200/TALK"  , "narrator": "千羽鶴", "text": "今すぐに\n答える必要はない。"},
        { "location": "201/TALK"  , "narrator": "千羽鶴", "text": "貴方も日々忙しさに\n追われていると思うし――"},
        { "location": "202/TALK"  , "narrator": "千羽鶴", "text": "まずは初心に返って、\n今回の記録映像を見て\nみるといいかもしれない。"},
        { "location": "203/TALK"  , "narrator": "千羽鶴", "text": "色々なことがあった。\n世界も心情も、毎日\n目まぐるしく変わってきた"},
        { "location": "204/TALK"  , "narrator": "千羽鶴", "text": "今回の記録映像は、そんな\n今までのことを、ゆっくり\n考えながら見るといい。"},
        { "location": "205/TALK"  , "narrator": "千羽鶴", "text": "私もそうするから。"},
        { "location": "208/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/59.5MB 3:49】</color>"},
        { "location": "209/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/19.7MB 3:49】</color>"},
        { "location": "210/SEL"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "211/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/59.5MB 3:49】</color>"},
        { "location": "212/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "218/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/19.7MB 3:49】</color>"},
        { "location": "219/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "225/ACT"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "226/TALK"  , "narrator": "千羽鶴", "text": "そう……。"},
        { "location": "259/TALK"  , "narrator": "千羽鶴", "text": "というわけで。"},
        { "location": "262/TALK"  , "narrator": "千羽鶴", "text": "<color=green>【今のちーが\n昔のちーを斬る！】</color>"},
        { "location": "263/SEL"   , "narrator": "", "text": "ワーパチパチ"},
        { "location": "264/ACT"   , "narrator": "", "text": "ワーパチパチ"},
        { "location": "266/TALK"  , "narrator": "千羽鶴", "text": "と思ったけど、\n今回はだいたい\n前半でやってしまった。"},
        { "location": "267/SEL"   , "narrator": "", "text": "あらら"},
        { "location": "268/ACT"   , "narrator": "", "text": "あらら"},
        { "location": "270/TALK"  , "narrator": "千羽鶴", "text": "それより！"},
        { "location": "271/TALK"  , "narrator": "千羽鶴", "text": "今貴方はデイドラにおいて\nライフギャザーの\n中にいると思うけど。"},
        { "location": "272/TALK"  , "narrator": "千羽鶴", "text": "いよいよ今回、\nライフギャザーの中を\n駆けめぐる事になる。"},
        { "location": "273/TALK"  , "narrator": "千羽鶴", "text": "ライフギャザーの解明は\n私達にとっても\n最重要案件になってる。"},
        { "location": "274/TALK"  , "narrator": "千羽鶴", "text": "だからこそ、貴方には\nそこに全力で関わって\n欲しいと思ってる。"},
        { "location": "275/TALK"  , "narrator": "千羽鶴", "text": "というわけで、\n今回はデイドラの形式を\n少し変えてみた。"},
        { "location": "276/TALK"  , "narrator": "千羽鶴", "text": "ライフギャザーの案件に\n集中できるように、\n最初からフックを掛けた。"},
        { "location": "277/SEL"   , "narrator": "", "text": "ということは？"},
        { "location": "278/ACT"   , "narrator": "", "text": "ということは？"},
        { "location": "280/TALK"  , "narrator": "千羽鶴", "text": "デイドラシステムに\nアクセスしたら、\nそこはライフギャザー。"},
        { "location": "281/TALK"  , "narrator": "千羽鶴", "text": "どうか今回は、\nライフギャザー攻略に\n集中して欲しい！"},
        { "location": "282/SEL"   , "narrator": "", "text": "あ、でも、なりすまし問題の方は大丈夫なの？"},
        { "location": "283/ACT"   , "narrator": "", "text": "あ、でも、なりすまし問題の方は大丈夫なの？"},
        { "location": "285/TALK"  , "narrator": "千羽鶴", "text": "それはそれで、\nとても大きな\n問題ではある。"},
        { "location": "286/TALK"  , "narrator": "千羽鶴", "text": "けれども、ライフ\nギャザーを掌握できれば、\nなりすましは駆逐可能。"},
        { "location": "287/TALK"  , "narrator": "千羽鶴", "text": "だから、今は\nなりすましをどうするかは\n一旦脇においておいて――"},
        { "location": "288/TALK"  , "narrator": "千羽鶴", "text": "ライフギャザーに\n集中した方がいい。"},
        { "location": "289/SEL"   , "narrator": "", "text": "オーケー"},
        { "location": "290/ACT"   , "narrator": "", "text": "オーケー"},
        { "location": "292/TALK"  , "narrator": "千羽鶴", "text": "ただ、完全に野放しにする\nわけにはいかないので。"},
        { "location": "293/TALK"  , "narrator": "千羽鶴", "text": "ライフギャザーから\nログアウトした際には、"},
        { "location": "294/TALK"  , "narrator": "千羽鶴", "text": "記録映像のポインタに\n飛ぶように、エリカに\nセットしてもらっておく。"},
        { "location": "295/TALK"  , "narrator": "千羽鶴", "text": "但し、そこで相手方と\n遭遇し、何かを言われても\n何もしないで欲しい。"},
        { "location": "296/TALK"  , "narrator": "千羽鶴", "text": "今の流れは、一見こちらが\n不利であって、向こうが\n有利な状況になってる。"},
        { "location": "297/TALK"  , "narrator": "千羽鶴", "text": "だから、貴方が焦るような\nことを、色々言われるかも\nしれない。"},
        { "location": "298/TALK"  , "narrator": "千羽鶴", "text": "でも、今は時間を稼ぎ\nライフギャザーを解析する\nことを最優先で。"},
        { "location": "299/SEL"   , "narrator": "", "text": "わかった"},
        { "location": "300/ACT"   , "narrator": "", "text": "わかった"},
        { "location": "302/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "303/TALK"  , "narrator": "千羽鶴", "text": "って。"},
        { "location": "304/TALK"  , "narrator": "千羽鶴", "text": "私が直接指示してた。\nルール違反だった。"},
        { "location": "305/SEL"   , "narrator": "", "text": "ほんとだね"},
        { "location": "306/SEL"   , "narrator": "", "text": "久し振りに千羽鶴とブリーフィング出来て楽しかった"},
        { "location": "307/ACT"   , "narrator": "", "text": "ほんとだね"},
        { "location": "309/TALK"  , "narrator": "千羽鶴", "text": "うむ、反省。"},
        { "location": "311/TALK"  , "narrator": "千羽鶴", "text": "けど、今は過去最高に\n重要な局面だから、\nどうか許して欲しい。"},
        { "location": "312/ACT"   , "narrator": "", "text": "久し振りに千羽鶴とブリーフィング出来て楽しかった"},
        { "location": "313/TALK"  , "narrator": "千羽鶴", "text": "そう言ってもらえると\n私も嬉しい。"},
        { "location": "314/TALK"  , "narrator": "千羽鶴", "text": "今は過去最高に重要な\n局面だから、こうして\n直接できて良かった。"},
        { "location": "316/TALK"  , "narrator": "千羽鶴", "text": "というわけで、\n今回の作戦会議は\nこれでお終い。"},
        { "location": "317/TALK"  , "narrator": "千羽鶴", "text": "さて、記録映像前に\n話していた件だけど。"},
        { "location": "318/SEL"   , "narrator": "", "text": "$me$にとっての総意とは何だったか…だっけ？"},
        { "location": "319/ACT"   , "narrator": "", "text": "$me$にとっての総意とは何だったか…だっけ？"},
        { "location": "321/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "322/TALK"  , "narrator": "千羽鶴", "text": "この問いについては、\n私の方にも少し準備が\n必要だと気づいた。"},
        { "location": "323/TALK"  , "narrator": "千羽鶴", "text": "だから、今回はまだ\n聞くのをやめる。"},
        { "location": "324/TALK"  , "narrator": "千羽鶴", "text": "お互い、時間を掛けて\nじっくり思い返して\nみるのがいいと思う。"},
        { "location": "325/TALK"  , "narrator": "千羽鶴", "text": "また改めて、\nこの件についてお話する\n場を創ろうと思う。"},
        { "location": "326/TALK"  , "narrator": "千羽鶴", "text": "その代わり、今回は\nちょっとお茶目な質問を\nさせてもらっていい？"},
        { "location": "327/SEL"   , "narrator": "", "text": "なに？"},
        { "location": "328/ACT"   , "narrator": "", "text": "なに？"},
        { "location": "330/TALK"  , "narrator": "千羽鶴", "text": "ただの興味として\n聞くだけだから、一周回\n記念に答えていって。"},
        { "location": "331/TALK"  , "narrator": "千羽鶴", "text": "今の貴方なら、\n何を選択するのか、ただ\n見てみたいだけだから。"},
        { "location": "332/TALK"  , "narrator": "千羽鶴", "text": "$handle$。\n今の貴方なら、\nどれを選びますか？"},
        { "location": "335/SEL"   , "narrator": "", "text": "千羽鶴の理想的社会創造を支持し、トライナリーの発症を容認する"},
        { "location": "336/SEL"   , "narrator": "", "text": "千羽鶴の理想的社会創造は賛同するが、トライナリーの発症は容認できない"},
        { "location": "337/SEL"   , "narrator": "", "text": "千羽鶴の理想的社会創造は支持できないが、千羽鶴に好感は持てる"},
        { "location": "338/SEL"   , "narrator": "", "text": "もう二度と目の前に現れないで欲しい"},
        { "location": "339/ACT"   , "narrator": "", "text": "千羽鶴の理想的社会創造を支持し、トライナリーの発症を容認する"},
        { "location": "342/ACT"   , "narrator": "", "text": "千羽鶴の理想的社会創造は賛同するが、トライナリーの発症は容認できない"},
        { "location": "345/ACT"   , "narrator": "", "text": "千羽鶴の理想的社会創造は支持できないが、千羽鶴に好感は持てる"},
        { "location": "348/ACT"   , "narrator": "", "text": "もう二度と目の前に現れないで欲しい"},
        { "location": "353/TALK"  , "narrator": "千羽鶴", "text": "ありがとう。"},
        { "location": "354/TALK"  , "narrator": "千羽鶴", "text": "今でも\nそう言ってくれるのは、\n本当に嬉しい。"},
        { "location": "355/TALK"  , "narrator": "千羽鶴", "text": "人のココロとは\n難しいもの。"},
        { "location": "356/TALK"  , "narrator": "千羽鶴", "text": "だからこそ、世界とは\n難しくて、いつだって\n奇跡で溢れている。"},
        { "location": "359/TALK"  , "narrator": "千羽鶴", "text": "ありがとう、\n正直に答えてくれて。"},
        { "location": "360/TALK"  , "narrator": "千羽鶴", "text": "貴方は本当に、\n彼女たちのことを\n大切に想ってくれてる。"},
        { "location": "361/TALK"  , "narrator": "千羽鶴", "text": "今でも、そのことは\n純粋に感謝をしている。"},
        { "location": "362/TALK"  , "narrator": "千羽鶴", "text": "これからも、可能な限り\n彼女たちの傍にいて\nあげてほしい。"},
        { "location": "365/TALK"  , "narrator": "千羽鶴", "text": "ありがとう、\n正直に答えてくれて。"},
        { "location": "366/TALK"  , "narrator": "千羽鶴", "text": "この頃考えていた\n理想社会の構想は、やはり\n未熟だったと思う。"},
        { "location": "367/TALK"  , "narrator": "千羽鶴", "text": "それを指摘してくれてる\n貴方には、ちゃんと\nお礼を言いたい。"},
        { "location": "368/TALK"  , "narrator": "千羽鶴", "text": "今のリプレイス作戦も、\nどんな結果をもたらすか\nまだわからないけど――"},
        { "location": "369/TALK"  , "narrator": "千羽鶴", "text": "貴方は変わらず、\n正直な気持ちを私に\n伝えて欲しい。"},
        { "location": "372/TALK"  , "narrator": "千羽鶴", "text": "それは残念。"},
        { "location": "374/TALK"  , "narrator": "千羽鶴", "text": "その点において、\n当時と特に考え方は\n変わってないのね。"},
        { "location": "375/TALK"  , "narrator": "千羽鶴", "text": "ならば、その上でも\nずっと関わってくれたこと\n感謝せねばならない。"},
        { "location": "376/TALK"  , "narrator": "千羽鶴", "text": "私という障害が\nありながらも、ずっと\n関わってくれたこと。"},
        { "location": "377/TALK"  , "narrator": "千羽鶴", "text": "この世界と共に\nいてくれてありがとう。"},
        { "location": "379/TALK"  , "narrator": "千羽鶴", "text": "前の回答は違っていたから\nリプレイス作戦のうちに\n嫌いになっちゃった？"},
        { "location": "380/TALK"  , "narrator": "千羽鶴", "text": "いずれにせよ、\n私の至らなさについては\n謝罪しようと思う。"},
        { "location": "381/TALK"  , "narrator": "千羽鶴", "text": "あと少しで、こちらの\n世界の問題も解決すると\n思うから――"},
        { "location": "382/TALK"  , "narrator": "千羽鶴", "text": "どうか、その時までは\n辛抱してつき合って\nもらえたら嬉しく思う。"},
        { "location": "388/TALK"  , "narrator": "千羽鶴", "text": "というわけで、\n今回はこれで――"},
        { "location": "389/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "390/SEL"   , "narrator": "", "text": "？？"},
        { "location": "391/ACT"   , "narrator": "", "text": "？？"},
        { "location": "395/TALK"  , "narrator": "千羽鶴", "text": "考え中。"},
        { "location": "396/SEL"   , "narrator": "", "text": "何を？"},
        { "location": "397/ACT"   , "narrator": "", "text": "何を？"},
        { "location": "399/TALK"  , "narrator": "千羽鶴", "text": "もう一つの記念日でも\nあるわけだけど、\nそれも祝うか否か。"},
        { "location": "400/SEL"   , "narrator": "", "text": "何の記念日？"},
        { "location": "401/ACT"   , "narrator": "", "text": "何の記念日？"},
        { "location": "404/TALK"  , "narrator": "千羽鶴", "text": "<size=15>ちゅーちゅー記念日。</size>"},
        { "location": "405/SEL"   , "narrator": "", "text": "祝うべき！！！！！"},
        { "location": "406/SEL"   , "narrator": "", "text": "それはいいや"},
        { "location": "407/ACT"   , "narrator": "", "text": "祝うべき！！！！！"},
        { "location": "409/TALK"  , "narrator": "千羽鶴", "text": "…そう。"},
        { "location": "410/TALK"  , "narrator": "千羽鶴", "text": "貴方がそこまで言うなら\n仕方ない。"},
        { "location": "424/TALK"  , "narrator": "千羽鶴", "text": "…っ！！"},
        { "location": "425/TALK"  , "narrator": "千羽鶴", "text": "あの時の想いが蘇る。"},
        { "location": "428/TALK"  , "narrator": "千羽鶴", "text": "…っ！！"},
        { "location": "429/TALK"  , "narrator": "千羽鶴", "text": "あの時の想いが蘇る。"},
        { "location": "438/TALK"  , "narrator": "千羽鶴", "text": "……また、ちょっとだけ\n幸せだった。"},
        { "location": "439/SEL"   , "narrator": "", "text": "$me$も幸せだった"},
        { "location": "440/SEL"   , "narrator": "", "text": "千羽鶴がかわいかった"},
        { "location": "441/ACT"   , "narrator": "", "text": "$me$も幸せだった"},
        { "location": "443/TALK"  , "narrator": "千羽鶴", "text": "…よかった。"},
        { "location": "445/ACT"   , "narrator": "", "text": "千羽鶴がかわいかった"},
        { "location": "448/TALK"  , "narrator": "千羽鶴", "text": "……ばか。\n前と同じこと言うのは\nパワーワードだから禁止。"},
        { "location": "452/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "453/TALK"  , "narrator": "千羽鶴", "text": "しなくて良かったの？"},
        { "location": "454/TALK"  , "narrator": "千羽鶴", "text": "まあ、私は\n構わないけど。"},
        { "location": "456/TALK"  , "narrator": "千羽鶴", "text": "それじゃ、今度こそ\n本当にここで。"},
        { "location": "457/TALK"  , "narrator": "千羽鶴", "text": "お仕事がんばってね、\nあなた。"},
        { "location": "458/ACT"   , "narrator": "", "text": "それはいいや"},
        { "location": "460/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "461/TALK"  , "narrator": "千羽鶴", "text": "それじゃ、今回は\nここでおしまい。"},
        { "location": "462/TALK"  , "narrator": "千羽鶴", "text": "ライフギャザーのこと、\nどうかよろしく。"},
        { "location": "465/TALK"  , "narrator": "千羽鶴", "text": "と思ったけど、\nこれだけはやっておく。"},
        { "location": "468/TALK"  , "narrator": "千羽鶴", "text": "<size=40>どーん！！</size>"},
        { "location": "469/SEL"   , "narrator": "", "text": "キター！！"},
        { "location": "470/ACT"   , "narrator": "", "text": "キター！！"},
        { "location": "472/TALK"  , "narrator": "千羽鶴", "text": "まだ今日は\n一度もやってなかったし。\nそれに――"},
        { "location": "473/TALK"  , "narrator": "千羽鶴", "text": "いつ、また原初状態に\n上書きされるか\nわからないから。"},
        { "location": "474/SEL"   , "narrator": "", "text": "悲しいこと言わないで"},
        { "location": "475/SEL"   , "narrator": "", "text": "やれるうちに一杯やっておこう！"},
        { "location": "476/ACT"   , "narrator": "", "text": "悲しいこと言わないで"},
        { "location": "477/TALK"  , "narrator": "千羽鶴", "text": "契約だから仕方ない。"},
        { "location": "478/ACT"   , "narrator": "", "text": "やれるうちに一杯やっておこう！"},
        { "location": "479/TALK"  , "narrator": "千羽鶴", "text": "……何度でも\n「どーん」しちゃう\nコーナーでも作る？"},
        { "location": "480/TALK"  , "narrator": "千羽鶴", "text": "まあ、そんなことより、\n今はライフギャザー。"},
        { "location": "482/TALK"  , "narrator": "千羽鶴", "text": "というわけで、今度こそ\n本当にお終い。"},
        { "location": "483/TALK"  , "narrator": "千羽鶴", "text": "今回もどうか、\n頑張って欲しい！"},
        { "location": "236/DIALOG", "narrator": "Tutorial/Dialog_Anime1", "text": "$dialog_word$"},
        { "location": "238/DIALOG", "narrator": "Tutorial/Dialog_Anime2", "text": "$dialog_word$"},
        { "location": "240/DIALOG", "narrator": "Tutorial/Dialog_Anime3", "text": "$dialog_word$"},
        { "location": "242/DIALOG", "narrator": "Tutorial/Dialog_Anime4", "text": "$dialog_word$"},
        { "location": "244/DIALOG", "narrator": "Tutorial/Dialog_Anime5", "text": "$dialog_word$"},
        { "location": "334/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:Chiharu】</color>\n\n貴方の今の想いを、\n私に教えてください。\n\nやり直しできます。"},
        { "location": "416/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "418/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:Chiharu】</color>\n\n貴方がそこまで言うから\n仕方なく記念日の特別。"},
        { "location": "433/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"}
