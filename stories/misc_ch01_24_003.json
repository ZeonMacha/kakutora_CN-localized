    "entry":
    [
        { "location": "173/SCENARIO", "narrator": "", "text": "036_揺れてもいいかな"},
        { "location": "198/TALK"    , "narrator": "つばめ", "text": "みやびさんがね"},
        { "location": "199/TALK"    , "narrator": "つばめ", "text": "備えなさいだって"},
        { "location": "201/SEL"     , "narrator": "", "text": "備えあれば患いなし"},
        { "location": "202/SEL"     , "narrator": "", "text": "備えあれば憂いなし"},
        { "location": "203/SEL"     , "narrator": "", "text": "愛の嵐に備えないとね"},
        { "location": "204/ACT"     , "narrator": "", "text": "備えあれば患いなし"},
        { "location": "206/TALK"    , "narrator": "つばめ", "text": "ちゅうい？"},
        { "location": "209/SEL"     , "narrator": "", "text": "「うれい」だよ"},
        { "location": "210/ACT"     , "narrator": "", "text": "「うれい」だよ"},
        { "location": "212/TALK"    , "narrator": "つばめ", "text": "そういう書き方もありなの？"},
        { "location": "214/SEL"     , "narrator": "", "text": "むしろこっちが正しいよ"},
        { "location": "215/ACT"     , "narrator": "", "text": "むしろこっちが正しいよ"},
        { "location": "216/TALK"    , "narrator": "つばめ", "text": "そうなんだ？"},
        { "location": "217/TALK"    , "narrator": "つばめ", "text": "難しいね"},
        { "location": "219/ACT"     , "narrator": "", "text": "備えあれば憂いなし"},
        { "location": "220/TALK"    , "narrator": "つばめ", "text": "そぅそぅ"},
        { "location": "222/TALK"    , "narrator": "つばめ", "text": "そぅだって言ってたょ"},
        { "location": "223/ACT"     , "narrator": "", "text": "愛の嵐に備えないとね"},
        { "location": "225/TALK"    , "narrator": "つばめ", "text": "愛の"},
        { "location": "226/TALK"    , "narrator": "つばめ", "text": "嵐って"},
        { "location": "227/TALK"    , "narrator": "つばめ", "text": "備えたら大丈夫なのかな"},
        { "location": "229/TALK"    , "narrator": "つばめ", "text": "道具とかじゃなくて"},
        { "location": "230/TALK"    , "narrator": "つばめ", "text": "気持ちの問題だって"},
        { "location": "232/SEL"     , "narrator": "", "text": "確かに"},
        { "location": "233/SEL"     , "narrator": "", "text": "一理ある"},
        { "location": "234/SEL"     , "narrator": "", "text": "つばめの気持ちはどんな感じ？"},
        { "location": "235/ACT"     , "narrator": "", "text": "確かに"},
        { "location": "236/TALK"    , "narrator": "つばめ", "text": "そっか"},
        { "location": "237/TALK"    , "narrator": "つばめ", "text": "やっぱりそうなんだね"},
        { "location": "238/TALK"    , "narrator": "つばめ", "text": "わかったょ"},
        { "location": "239/ACT"     , "narrator": "", "text": "一理ある"},
        { "location": "240/TALK"    , "narrator": "つばめ", "text": "ぁれ"},
        { "location": "241/TALK"    , "narrator": "つばめ", "text": "そのくらいの感じなの"},
        { "location": "242/TALK"    , "narrator": "つばめ", "text": "結構大事なことだって思ったんだけどな"},
        { "location": "243/TALK"    , "narrator": "つばめ", "text": "人それぞれだょね"},
        { "location": "244/ACT"     , "narrator": "", "text": "つばめの気持ちはどんな感じ？"},
        { "location": "248/TALK"    , "narrator": "つばめ", "text": "まだ"},
        { "location": "249/TALK"    , "narrator": "つばめ", "text": "準備できてなかったかも"},
        { "location": "250/TALK"    , "narrator": "つばめ", "text": "だけど"},
        { "location": "251/TALK"    , "narrator": "つばめ", "text": "準備しなきゃねって気持ちになったよ"},
        { "location": "252/TALK"    , "narrator": "つばめ", "text": "備えなきゃね"}
    ]
}
