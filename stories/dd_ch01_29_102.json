{
    "dir": "chap29/daydra/dd_ch01_29_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "29105",
        "cid": "tsubame",
        "title": "005 メインストーリー",
        "sub_title": "小さな箱の中と外＜後編＞"
    },
    "entry":
    [
        { "location": "625/SCENARIO", "narrator": "", "text": "細い糸をつなげてみたら"},
        { "location": "649/TALK"    , "narrator": "つばめ", "text": "……。"},
        { "location": "650/TALK"    , "narrator": "つばめ", "text": "はぁ…\nやっぱり無理かも。"},
        { "location": "651/TALK"    , "narrator": "つばめ", "text": "通信が筒抜けになったら、\n神楽ちゃんにも迷惑\nかけちゃうかもだし……。"},
        { "location": "652/TALK"    , "narrator": "つばめ", "text": "大人しくしていた方が\nいいよね…。"},
        { "location": "653/TALK"    , "narrator": "神楽", "text": "どうしますか？\nつばめさん。"},
        { "location": "654/TALK"    , "narrator": "つばめ", "text": "あっ…えっと……"},
        { "location": "655/TALK"    , "narrator": "つばめ", "text": "やっぱり大人しく\nしていることにするよ。"},
        { "location": "656/TALK"    , "narrator": "神楽", "text": "……そうですか。"},
        { "location": "657/TALK"    , "narrator": "神楽", "text": "そうですね。\nその方が無難かも\nしれません。"},
        { "location": "658/TALK"    , "narrator": "神楽", "text": "もしかしたら、通信した\n瞬間に、射殺されちゃって\nいたかもしれませんしね。"},
        { "location": "659/TALK"    , "narrator": "つばめ", "text": "ええええっ！！\nそそそそんな……！"},
        { "location": "660/TALK"    , "narrator": "神楽", "text": "妄想ですよ。\nただ、あらゆる可能性の\n１つだとは思いますけど。"},
        { "location": "661/TALK"    , "narrator": "つばめ", "text": "なんだぁ……。"},
        { "location": "682/TALK"    , "narrator": "つばめ", "text": "決めた。"},
        { "location": "683/TALK"    , "narrator": "つばめ", "text": "神楽ちゃんの言うこと\n試すことにする。"},
        { "location": "684/TALK"    , "narrator": "つばめ", "text": "お願いします。\n繋げてください。"},
        { "location": "685/TALK"    , "narrator": "神楽", "text": "…いいんですか？"},
        { "location": "686/TALK"    , "narrator": "つばめ", "text": "うん。"},
        { "location": "687/TALK"    , "narrator": "つばめ", "text": "神楽ちゃんがそこまで\n言うんだから\n本当なんでしょ？"},
        { "location": "688/TALK"    , "narrator": "つばめ", "text": "だったらわたし\n$handle$さんと\nお話ししときたい。"},
        { "location": "689/TALK"    , "narrator": "つばめ", "text": "お話しできないまま\n死んじゃうのは\nイヤだから。"},
        { "location": "692/TALK"    , "narrator": "神楽", "text": "そう、ですか……。"},
        { "location": "693/TALK"    , "narrator": "つばめ", "text": "うん。"},
        { "location": "696/TALK"    , "narrator": "神楽", "text": "…ではひとつ交換条件。"},
        { "location": "697/TALK"    , "narrator": "神楽", "text": "話し終わったら\n切らないでそのまま\nスマホを貸してください。"},
        { "location": "698/TALK"    , "narrator": "つばめ", "text": "わかった。"},
        { "location": "709/TALK"    , "narrator": "神楽", "text": "……。\n完了です。"},
        { "location": "717/TALK"    , "narrator": "つばめ", "text": "$handle$さん？"},
        { "location": "719/SEL"     , "narrator": "", "text": "やっと繋がった！"},
        { "location": "720/SEL"     , "narrator": "", "text": "ずっとメッセージ送ってたのに"},
        { "location": "721/SEL"     , "narrator": "", "text": "つばめは大丈夫？"},
        { "location": "722/ACT"     , "narrator": "", "text": "やっと繋がった！"},
        { "location": "723/TALK"    , "narrator": "つばめ", "text": "え"},
        { "location": "724/TALK"    , "narrator": "つばめ", "text": "やっぱりそうなの"},
        { "location": "725/ACT"     , "narrator": "", "text": "ずっとメッセージ送ってたのに"},
        { "location": "726/TALK"    , "narrator": "つばめ", "text": "そんなの"},
        { "location": "728/TALK"    , "narrator": "つばめ", "text": "全然届いてないよ"},
        { "location": "729/ACT"     , "narrator": "", "text": "つばめは大丈夫？"},
        { "location": "730/TALK"    , "narrator": "つばめ", "text": "平気だよ"},
        { "location": "731/TALK"    , "narrator": "つばめ", "text": "一応ね"},
        { "location": "736/SEL"     , "narrator": "", "text": "大変みたいだけど"},
        { "location": "737/SEL"     , "narrator": "", "text": "話できてよかった"},
        { "location": "738/SEL"     , "narrator": "", "text": "うれしくて泣きそう"},
        { "location": "739/ACT"     , "narrator": "", "text": "大変みたいだけど"},
        { "location": "740/TALK"    , "narrator": "つばめ", "text": "大変だけど"},
        { "location": "742/TALK"    , "narrator": "つばめ", "text": "神楽ちゃんもいるし"},
        { "location": "743/ACT"     , "narrator": "", "text": "話できてよかった"},
        { "location": "744/TALK"    , "narrator": "つばめ", "text": "うん"},
        { "location": "746/TALK"    , "narrator": "つばめ", "text": "ぁたしも"},
        { "location": "747/ACT"     , "narrator": "", "text": "うれしくて泣きそう"},
        { "location": "748/TALK"    , "narrator": "つばめ", "text": "そんなこと言わないで"},
        { "location": "749/TALK"    , "narrator": "つばめ", "text": "ぁたしも泣いちゃう"},
        { "location": "751/TALK"    , "narrator": "つばめ", "text": "それでね"},
        { "location": "752/TALK"    , "narrator": "つばめ", "text": "もしかしたら"},
        { "location": "753/TALK"    , "narrator": "つばめ", "text": "これが最後のお話になるかもしれないの"},
        { "location": "755/SEL"     , "narrator": "", "text": "そんなことはさせない"},
        { "location": "756/SEL"     , "narrator": "", "text": "$me$が助けるから"},
        { "location": "757/SEL"     , "narrator": "", "text": "それはいやだな…"},
        { "location": "758/ACT"     , "narrator": "", "text": "そんなことはさせない"},
        { "location": "759/TALK"    , "narrator": "つばめ", "text": "うん"},
        { "location": "760/TALK"    , "narrator": "つばめ", "text": "ありがとう"},
        { "location": "761/ACT"     , "narrator": "", "text": "$me$が助けるから"},
        { "location": "762/TALK"    , "narrator": "つばめ", "text": "絶対だよ？"},
        { "location": "763/TALK"    , "narrator": "つばめ", "text": "信じてるから"},
        { "location": "764/ACT"     , "narrator": "", "text": "それはいやだな…"},
        { "location": "765/TALK"    , "narrator": "つばめ", "text": "そうだよね"},
        { "location": "766/TALK"    , "narrator": "つばめ", "text": "わたしもいやだよ"},
        { "location": "768/TALK"    , "narrator": "つばめ", "text": "こうやって"},
        { "location": "769/TALK"    , "narrator": "つばめ", "text": "$handle$さんと"},
        { "location": "770/TALK"    , "narrator": "つばめ", "text": "お話しできて"},
        { "location": "771/TALK"    , "narrator": "つばめ", "text": "うれしい"},
        { "location": "773/SEL"     , "narrator": "", "text": "また話そう"},
        { "location": "774/SEL"     , "narrator": "", "text": "いつだって話せるようになるよ"},
        { "location": "775/SEL"     , "narrator": "", "text": "$me$もうれしい"},
        { "location": "776/ACT"     , "narrator": "", "text": "また話そう"},
        { "location": "777/TALK"    , "narrator": "つばめ", "text": "うん"},
        { "location": "778/TALK"    , "narrator": "つばめ", "text": "またね"},
        { "location": "780/TALK"    , "narrator": "つばめ", "text": "絶対だよ"},
        { "location": "781/ACT"     , "narrator": "", "text": "いつだって話せるようになるよ"},
        { "location": "782/TALK"    , "narrator": "つばめ", "text": "そうだね"},
        { "location": "783/TALK"    , "narrator": "つばめ", "text": "いつも"},
        { "location": "785/TALK"    , "narrator": "つばめ", "text": "お話ししようね"},
        { "location": "786/ACT"     , "narrator": "", "text": "$me$もうれしい"},
        { "location": "787/TALK"    , "narrator": "つばめ", "text": "よかった"},
        { "location": "788/TALK"    , "narrator": "つばめ", "text": "でもわたしのほうが"},
        { "location": "790/TALK"    , "narrator": "つばめ", "text": "絶対うれしいからね"},
        { "location": "792/TALK"    , "narrator": "つばめ", "text": "あ"},
        { "location": "794/TALK"    , "narrator": "つばめ", "text": "神楽ちゃんに"},
        { "location": "795/TALK"    , "narrator": "つばめ", "text": "代わるね"},
        { "location": "802/TALK"    , "narrator": "つばめ", "text": "今宵はどのような物語をお望みでしょう？"},
        { "location": "804/SEL"     , "narrator": "", "text": "は？"},
        { "location": "805/SEL"     , "narrator": "", "text": "夜神楽して"},
        { "location": "806/ACT"     , "narrator": "", "text": "は？"},
        { "location": "808/TALK"    , "narrator": "つばめ", "text": "わからないなら"},
        { "location": "809/TALK"    , "narrator": "つばめ", "text": "それでいいです"},
        { "location": "810/ACT"     , "narrator": "", "text": "夜神楽して"},
        { "location": "812/TALK"    , "narrator": "つばめ", "text": "なるほど"},
        { "location": "813/TALK"    , "narrator": "つばめ", "text": "そういうことですか"},
        { "location": "816/SEL"     , "narrator": "", "text": "何の話？"},
        { "location": "817/SEL"     , "narrator": "", "text": "解説して"},
        { "location": "818/SEL"     , "narrator": "", "text": "卯月って電波なの？"},
        { "location": "819/ACT"     , "narrator": "", "text": "何の話？"},
        { "location": "821/TALK"    , "narrator": "つばめ", "text": "そのうちわかる話です"},
        { "location": "822/ACT"     , "narrator": "", "text": "解説して"},
        { "location": "824/TALK"    , "narrator": "つばめ", "text": "まさか"},
        { "location": "825/TALK"    , "narrator": "つばめ", "text": "それは無理です"},
        { "location": "826/ACT"     , "narrator": "", "text": "卯月って電波なの？"},
        { "location": "828/TALK"    , "narrator": "つばめ", "text": "そう思うなら"},
        { "location": "829/TALK"    , "narrator": "つばめ", "text": "そうなんでしょうね"},
        { "location": "832/TALK"    , "narrator": "つばめ", "text": "通信終了"},
        { "location": "833/TALK"    , "narrator": "つばめ", "text": "切断します"},
        { "location": "846/TALK"    , "narrator": "つばめ", "text": "ありがとう\n神楽ちゃん。"},
        { "location": "848/TALK"    , "narrator": "神楽", "text": "いいえ。"},
        { "location": "852/TALK"    , "narrator": "神楽", "text": "それより、\n先につばめさんに\n謝っておきますね。"},
        { "location": "853/TALK"    , "narrator": "つばめ", "text": "え？"},
        { "location": "865/TALK"    , "narrator": "透明神楽", "text": "ごめんなさい。"},
        { "location": "866/TALK"    , "narrator": "透明神楽", "text": "私はきっと、あなたを\n殺してしまう。"},
        { "location": "868/TALK"    , "narrator": "透明神楽", "text": "正確には\n「殺させられてしまう」。"},
        { "location": "869/TALK"    , "narrator": "透明神楽", "text": "ごめんなさい。\nこれを止めることは\nできないんです。"},
        { "location": "870/TALK"    , "narrator": "透明神楽", "text": "私がどう頑張っても\n止められないんです。"},
        { "location": "871/TALK"    , "narrator": "透明つばめ", "text": "えと……。\n神楽…ちゃん…？"},
        { "location": "872/TALK"    , "narrator": "透明神楽", "text": "おかしいことを\n言っているのは\nわかっています。"},
        { "location": "873/TALK"    , "narrator": "透明神楽", "text": "本当にごめんなさい。"},
        { "location": "874/TALK"    , "narrator": "透明神楽", "text": "だけど。"},
        { "location": "875/TALK"    , "narrator": "透明神楽", "text": "私はあなたのことが\n大好きです。"},
        { "location": "876/TALK"    , "narrator": "透明神楽", "text": "つばめさんのことが\n大好きなんです。"},
        { "location": "877/TALK"    , "narrator": "透明つばめ", "text": "わたしも。"},
        { "location": "878/TALK"    , "narrator": "透明つばめ", "text": "神楽ちゃんのことが\n大好きだよ。"},
        { "location": "879/TALK"    , "narrator": "透明つばめ", "text": "だから――"},
        { "location": "882/TALK"    , "narrator": "透明神楽", "text": "！"},
        { "location": "894/DIALOG"  , "narrator": "Dialog_chapter_ch01", "text": "【MV EXE_MiYABi】"}
    ]
}
