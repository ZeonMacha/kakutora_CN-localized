    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "600_溺れる予感"},
        { "location": "32/TALK"   , "narrator": "アーヤ", "text": "私結構"},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "泳げるのよ"},
        { "location": "35/SEL"    , "narrator": "", "text": "そうなんだ"},
        { "location": "36/SEL"    , "narrator": "", "text": "長野って海ないよね"},
        { "location": "37/SEL"    , "narrator": "", "text": "今度$me$と海に行こう"},
        { "location": "38/ACT"    , "narrator": "", "text": "そうなんだ"},
        { "location": "39/TALK"   , "narrator": "アーヤ", "text": "そうなのよ"},
        { "location": "40/ACT"    , "narrator": "", "text": "長野って海ないよね"},
        { "location": "41/TALK"   , "narrator": "アーヤ", "text": "ないけど(-.-;)"},
        { "location": "42/TALK"   , "narrator": "アーヤ", "text": "授業で習うわよ"},
        { "location": "43/ACT"    , "narrator": "", "text": "今度$me$と海に行こう"},
        { "location": "53/TALK"   , "narrator": "アーヤ", "text": "そうね"},
        { "location": "54/TALK"   , "narrator": "アーヤ", "text": "絶対"},
        { "location": "55/TALK"   , "narrator": "アーヤ", "text": "プライベートビーチが理想だけど"},
        { "location": "56/TALK"   , "narrator": "アーヤ", "text": "そうすると海外になっちゃうわよね(・・。)ゞ"},
        { "location": "58/TALK"   , "narrator": "アーヤ", "text": "あ"},
        { "location": "59/TALK"   , "narrator": "アーヤ", "text": "静岡にすごくきれいな浜があるんだって"},
        { "location": "60/TALK"   , "narrator": "アーヤ", "text": "そこなんかいいかも♪"},
        { "location": "62/TALK"   , "narrator": "アーヤ", "text": "$handle$さんは"},
        { "location": "63/TALK"   , "narrator": "アーヤ", "text": "泳げる人？"},
        { "location": "65/SEL"    , "narrator": "", "text": "トライアスロン強化選手"},
        { "location": "66/SEL"    , "narrator": "", "text": "人並みには"},
        { "location": "67/SEL"    , "narrator": "", "text": "カナヅチ"},
        { "location": "68/SEL"    , "narrator": "", "text": "結構泳げる"},
        { "location": "69/SEL"    , "narrator": "", "text": "クロールなら"},
        { "location": "70/SEL"    , "narrator": "", "text": "犬かき専門"},
        { "location": "71/ACT"    , "narrator": "", "text": "トライアスロン強化選手"},
        { "location": "72/TALK"   , "narrator": "アーヤ", "text": "それって"},
        { "location": "73/TALK"   , "narrator": "アーヤ", "text": "冗談よね？"},
        { "location": "74/ACT"    , "narrator": "", "text": "人並みには"},
        { "location": "75/TALK"   , "narrator": "アーヤ", "text": "人並みって"},
        { "location": "76/TALK"   , "narrator": "アーヤ", "text": "どのくらいなのかしら"},
        { "location": "77/ACT"    , "narrator": "", "text": "カナヅチ"},
        { "location": "78/TALK"   , "narrator": "アーヤ", "text": "そうなのね"},
        { "location": "79/ACT"    , "narrator": "", "text": "結構泳げる"},
        { "location": "80/TALK"   , "narrator": "アーヤ", "text": "そうなのね"},
        { "location": "82/TALK"   , "narrator": "アーヤ", "text": "すごいわね"},
        { "location": "83/ACT"    , "narrator": "", "text": "クロールなら"},
        { "location": "84/TALK"   , "narrator": "アーヤ", "text": "あら"},
        { "location": "85/TALK"   , "narrator": "アーヤ", "text": "ちょっと格好いいわ"},
        { "location": "86/ACT"    , "narrator": "", "text": "犬かき専門"},
        { "location": "87/TALK"   , "narrator": "アーヤ", "text": "それは泳ぎ？"},
        { "location": "88/TALK"   , "narrator": "アーヤ", "text": "よね、一応"},
        { "location": "90/TALK"   , "narrator": "アーヤ", "text": "私は授業で習ったけど"},
        { "location": "91/TALK"   , "narrator": "アーヤ", "text": "プール授業がないところもあるみたいだし"},
        { "location": "92/TALK"   , "narrator": "アーヤ", "text": "逆にスクールに行って習う人もいるものね"},
        { "location": "94/SEL"    , "narrator": "", "text": "アーヤの水着が見れたらそれでいいんだ"},
        { "location": "95/SEL"    , "narrator": "", "text": "$me$の特訓受けてみる？"},
        { "location": "96/ACT"    , "narrator": "", "text": "アーヤの水着が見れたらそれでいいんだ"},
        { "location": "97/TALK"   , "narrator": "アーヤ", "text": "え"},
        { "location": "99/TALK"   , "narrator": "アーヤ", "text": "何言い出すの"},
        { "location": "101/SEL"   , "narrator": "", "text": "本気なのに"},
        { "location": "102/SEL"   , "narrator": "", "text": "ダメかな？"},
        { "location": "103/ACT"   , "narrator": "", "text": "本気なのに"},
        { "location": "104/TALK"  , "narrator": "アーヤ", "text": "すぐに"},
        { "location": "105/TALK"  , "narrator": "アーヤ", "text": "そんなことばっかり"},
        { "location": "106/ACT"   , "narrator": "", "text": "ダメかな？"},
        { "location": "107/TALK"  , "narrator": "アーヤ", "text": "えと"},
        { "location": "108/TALK"  , "narrator": "アーヤ", "text": "ダメってことはないけど、、、"},
        { "location": "110/ACT"   , "narrator": "", "text": "$me$の特訓受けてみる？"},
        { "location": "111/TALK"  , "narrator": "アーヤ", "text": "あら"},
        { "location": "112/TALK"  , "narrator": "アーヤ", "text": "コーチしてくれるのかしら？"},
        { "location": "113/TALK"  , "narrator": "アーヤ", "text": "私結構泳げるのよ？"},
        { "location": "114/TALK"  , "narrator": "アーヤ", "text": "コーチより"},
        { "location": "115/TALK"  , "narrator": "アーヤ", "text": "泳げるかもよ？"},
        { "location": "117/TALK"  , "narrator": "アーヤ", "text": "でもね"},
        { "location": "118/TALK"  , "narrator": "アーヤ", "text": "最近"},
        { "location": "119/TALK"  , "narrator": "アーヤ", "text": "溺れそうなの"},
        { "location": "121/SEL"   , "narrator": "", "text": "矛盾してる"},
        { "location": "122/SEL"   , "narrator": "", "text": "本当は泳げないんじゃない"},
        { "location": "123/SEL"   , "narrator": "", "text": "水難注意"},
        { "location": "124/ACT"   , "narrator": "", "text": "矛盾してる"},
        { "location": "125/TALK"  , "narrator": "アーヤ", "text": "してないわ"},
        { "location": "126/ACT"   , "narrator": "", "text": "本当は泳げないんじゃない"},
        { "location": "127/TALK"  , "narrator": "アーヤ", "text": "違うわよ"},
        { "location": "128/ACT"   , "narrator": "", "text": "水難注意"},
        { "location": "129/TALK"  , "narrator": "アーヤ", "text": "そうかもね"},
        { "location": "132/TALK"  , "narrator": "アーヤ", "text": "海とかプールの話じゃないの"},
        { "location": "133/TALK"  , "narrator": "アーヤ", "text": "溺れるのは"},
        { "location": "134/TALK"  , "narrator": "アーヤ", "text": "貴方との恋よ"},
        { "location": "49/DIALOG" , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>1000pt.</b></color></size>\nアップしました！"}
    ]
