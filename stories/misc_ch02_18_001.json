        { "location": "7/SCENARIO", "narrator": "", "text": "025_屋上ロマンス"},
        { "location": "32/TALK"   , "narrator": "アーヤ", "text": "学園漫画とかだと屋上のシーンってよく出てくるけど"},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "実際は立ち入り禁止区域よね"},
        { "location": "35/SEL"    , "narrator": "", "text": "危ないからね"},
        { "location": "36/SEL"    , "narrator": "", "text": "何か読んだの？"},
        { "location": "37/SEL"    , "narrator": "", "text": "アーヤのためなら解放するよ"},
        { "location": "38/ACT"    , "narrator": "", "text": "危ないからね"},
        { "location": "39/TALK"   , "narrator": "アーヤ", "text": "そうなのよね"},
        { "location": "40/TALK"   , "narrator": "アーヤ", "text": "仕方ないのかしら"},
        { "location": "41/ACT"    , "narrator": "", "text": "何か読んだの？"},
        { "location": "42/TALK"   , "narrator": "アーヤ", "text": "呼んだって言うか"},
        { "location": "44/TALK"   , "narrator": "アーヤ", "text": "読んだっていうか"},
        { "location": "45/TALK"   , "narrator": "アーヤ", "text": "長年の疑問？"},
        { "location": "46/ACT"    , "narrator": "", "text": "アーヤのためなら解放するよ"},
        { "location": "48/TALK"   , "narrator": "アーヤ", "text": "あら"},
        { "location": "49/TALK"   , "narrator": "アーヤ", "text": "素敵だわ"},
        { "location": "51/TALK"   , "narrator": "アーヤ", "text": "そういうのいいわね"},
        { "location": "53/TALK"   , "narrator": "アーヤ", "text": "まあ"},
        { "location": "54/TALK"   , "narrator": "アーヤ", "text": "屋上に上がれても"},
        { "location": "55/TALK"   , "narrator": "アーヤ", "text": "今日は曇り空だから"},
        { "location": "56/TALK"   , "narrator": "アーヤ", "text": "星も見えないけどね"}
    ]
