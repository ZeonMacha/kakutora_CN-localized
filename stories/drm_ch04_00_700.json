        { "location": "7/SCENARIO", "narrator": "", "text": "600_繋がれる"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "ネットワークはオープンたれ"},
        { "location": "33/TALK"   , "narrator": "みやび", "text": "www創立者の言葉だ"},
        { "location": "35/SEL"    , "narrator": "", "text": "元は軍事用だよ"},
        { "location": "36/SEL"    , "narrator": "", "text": "そうなんだ"},
        { "location": "37/SEL"    , "narrator": "", "text": "$me$とみやびはクローズド"},
        { "location": "38/ACT"    , "narrator": "", "text": "元は軍事用だよ"},
        { "location": "39/TALK"   , "narrator": "みやび", "text": "しかし今は"},
        { "location": "40/TALK"   , "narrator": "みやび", "text": "民生用に転用されている"},
        { "location": "41/ACT"    , "narrator": "", "text": "そうなんだ"},
        { "location": "42/TALK"   , "narrator": "みやび", "text": "うむ"},
        { "location": "44/TALK"   , "narrator": "みやび", "text": "美しき助け合いの世界"},
        { "location": "45/ACT"    , "narrator": "", "text": "$me$とみやびはクローズド"},
        { "location": "55/TALK"   , "narrator": "みやび", "text": "当然だの"},
        { "location": "56/TALK"   , "narrator": "みやび", "text": "この世界戦線は"},
        { "location": "57/TALK"   , "narrator": "みやび", "text": "境界の果てにある"},
        { "location": "59/TALK"   , "narrator": "みやび", "text": "そしてwwwの矛盾"},
        { "location": "60/TALK"   , "narrator": "みやび", "text": "悪用を防ぐため"},
        { "location": "61/TALK"   , "narrator": "みやび", "text": "情報は暗号化される"},
        { "location": "63/SEL"    , "narrator": "", "text": "セキュリティ対策は大事"},
        { "location": "64/SEL"    , "narrator": "", "text": "そんなもんじゃない？"},
        { "location": "65/ACT"    , "narrator": "", "text": "セキュリティ対策は大事"},
        { "location": "66/TALK"   , "narrator": "みやび", "text": "うむ"},
        { "location": "67/TALK"   , "narrator": "みやび", "text": "確かにそうではある"},
        { "location": "68/ACT"    , "narrator": "", "text": "そんなもんじゃない？"},
        { "location": "69/TALK"   , "narrator": "みやび", "text": "なんと"},
        { "location": "71/TALK"   , "narrator": "みやび", "text": "達観した発言"},
        { "location": "73/TALK"   , "narrator": "みやび", "text": "かように世界は矛盾に満ちておる"},
        { "location": "74/TALK"   , "narrator": "みやび", "text": "つまりだ"},
        { "location": "75/TALK"   , "narrator": "みやび", "text": "相棒よ"},
        { "location": "77/SEL"    , "narrator": "", "text": "みやびのことが好きなのは矛盾しないよ"},
        { "location": "78/SEL"    , "narrator": "", "text": "えーと、要は$me$が好きってこと？"},
        { "location": "79/SEL"    , "narrator": "", "text": "相棒じゃなくて恋人だよ"},
        { "location": "80/ACT"    , "narrator": "", "text": "みやびのことが好きなのは矛盾しないよ"},
        { "location": "81/TALK"   , "narrator": "みやび", "text": "うちを好きだという時点で"},
        { "location": "82/TALK"   , "narrator": "みやび", "text": "矛盾しちょろう"},
        { "location": "83/TALK"   , "narrator": "みやび", "text": "ばかちんが"},
        { "location": "84/ACT"    , "narrator": "", "text": "えーと、要は$me$が好きってこと？"},
        { "location": "85/TALK"   , "narrator": "みやび", "text": "図々しいな"},
        { "location": "86/TALK"   , "narrator": "みやび", "text": "その通りだ"},
        { "location": "87/TALK"   , "narrator": "みやび", "text": "ばかちんめ"},
        { "location": "88/ACT"    , "narrator": "", "text": "相棒じゃなくて恋人だよ"},
        { "location": "89/TALK"   , "narrator": "みやび", "text": "そんな世間一般の言い方"},
        { "location": "90/TALK"   , "narrator": "みやび", "text": "我々の領域に入れてくるな"},
        { "location": "91/TALK"   , "narrator": "みやび", "text": "照れるぞね"},
