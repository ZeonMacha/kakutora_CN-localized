        "title": "002 メインストーリー",
        "sub_title": "羽ばたき征く蒼い空に＜前編＞"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "花々と鳥たちの楽園で"},
        { "location": "34/TALK"   , "narrator": "ガブリエラ", "text": "…で。"},
        { "location": "36/TALK"   , "narrator": "ガブリエラ", "text": "あたしたち何で\n静岡にいるわけ？"},
        { "location": "38/TALK"   , "narrator": "アーヤ", "text": "つばめのお父さんに\n連れてきてもらった\nからでしょ。"},
        { "location": "39/TALK"   , "narrator": "アーヤ", "text": "不思議な空間ね。\n放し飼いの鳥と花って\nちょっと天国みたい。"},
        { "location": "40/TALK"   , "narrator": "ガブリエラ", "text": "…悪くはないけど…。"},
        { "location": "41/TALK"   , "narrator": "ガブリエラ", "text": "長野に行くって話は\nどうなったの？"},
        { "location": "43/TALK"   , "narrator": "アーヤ", "text": "そのうちね。"},
        { "location": "44/TALK"   , "narrator": "ガブリエラ", "text": "もう！"},
        { "location": "45/TALK"   , "narrator": "アーヤ", "text": "だって本当に洒落に\nならないのよ。\nあの祭祀をする時は。"},
        { "location": "46/TALK"   , "narrator": "アーヤ", "text": "行くのはいいけど\n帰ってこれなかったら\n困るでしょ？"},
        { "location": "59/TALK"   , "narrator": "ガブリエラ", "text": "ねえ$handle$"},
        { "location": "60/TALK"   , "narrator": "ガブリエラ", "text": "本当だと思う？"},
        { "location": "62/SEL"    , "narrator": "", "text": "ガチでしょ"},
        { "location": "63/SEL"    , "narrator": "", "text": "もしかしたらそんなこともあるかも"},
        { "location": "64/SEL"    , "narrator": "", "text": "$me$も危険な目には遭ってほしくないな"},
        { "location": "65/ACT"    , "narrator": "", "text": "ガチでしょ"},
        { "location": "66/TALK"   , "narrator": "ガブリエラ", "text": "やっぱりそうなのかしら"},
        { "location": "67/TALK"   , "narrator": "ガブリエラ", "text": "怖いわよね"},
        { "location": "69/ACT"    , "narrator": "", "text": "もしかしたらそんなこともあるかも"},
        { "location": "70/TALK"   , "narrator": "ガブリエラ", "text": "うーん・・・"},
        { "location": "71/TALK"   , "narrator": "ガブリエラ", "text": "半信半疑なわけね"},
        { "location": "72/TALK"   , "narrator": "ガブリエラ", "text": "でも本当っぽいのよね・・・"},
        { "location": "74/ACT"    , "narrator": "", "text": "$me$も危険な目には遭ってほしくないな"},
        { "location": "75/TALK"   , "narrator": "ガブリエラ", "text": "えっ/////////////////////"},
        { "location": "76/TALK"   , "narrator": "ガブリエラ", "text": "わかったわｖｖｖｖ"},
        { "location": "89/TALK"   , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "92/TALK"   , "narrator": "アーヤ", "text": "ほらあそこ。\n可愛い小鳥が\n止まってるわよ。"},
        { "location": "94/TALK"   , "narrator": "ガブリエラ", "text": "小鳥じゃなくて\nコガネメキシコインコ。"},
        { "location": "95/TALK"   , "narrator": "ガブリエラ", "text": "…やっぱり正面から\n撮るべきかしらね。\n…ふふ。"},
        { "location": "97/TALK"   , "narrator": "アーヤ", "text": "ぶつくさ言ってるけど\n結構ご機嫌よね…。"},
        { "location": "99/TALK"   , "narrator": "ガブリエラ", "text": "みやびと神楽も\n来ればよかったのに。"},
        { "location": "100/TALK"  , "narrator": "アーヤ", "text": "卯月は音楽活動が\n最優先だもの。\n仕方ないわ。"},
        { "location": "102/TALK"  , "narrator": "ガブリエラ", "text": "わからないのはみやびよ。\n旅行はバーチャルで\n十分とか。"},
        { "location": "103/TALK"  , "narrator": "ガブリエラ", "text": "プログラミングの方が\nリアルとか。\n意味わかんない。"},
        { "location": "104/TALK"  , "narrator": "ガブリエラ", "text": "うん、いいポーズ！\nどの子もいい子ね。"},
        { "location": "106/TALK"  , "narrator": "ガブリエラ", "text": "…そういえば\nつばめは？"},
        { "location": "107/TALK"  , "narrator": "アーヤ", "text": "先に移動してたわよ。"},
        { "location": "108/TALK"  , "narrator": "ガブリエラ", "text": "えっ？　いつの間に…。"},
        { "location": "109/TALK"  , "narrator": "アーヤ", "text": "私たちもそろそろ\n移動しましょう。"},
        { "location": "141/TALK"  , "narrator": "ガブリエラ", "text": "あっ、いたいた。"},
        { "location": "143/TALK"  , "narrator": "つばめ", "text": "だもんで\n別に危なくないって\n言ってるら！"},
        { "location": "144/TALK"  , "narrator": "啓介", "text": "危ないだよ！\nお前、さっき\nくちばし見たら！"},
        { "location": "145/TALK"  , "narrator": "啓介", "text": "あんなデカイくちばしで\n突かれてみいや。\n死んじまうで！？"},
        { "location": "146/TALK"  , "narrator": "つばめ", "text": "だからぁ、エミューは\n駝鳥より全然ちっちゃい\nだで大丈夫だって……。"},
        { "location": "147/TALK"  , "narrator": "つばめ", "text": "大体危ない鳥だったら\n餌なんか売ってるわけ\nないら！"},
        { "location": "148/TALK"  , "narrator": "啓介", "text": "おまえは生き物を\n甘く見過ぎ！"},
        { "location": "149/TALK"  , "narrator": "啓介", "text": "言葉だって\n喋れないだで！？\nこの鳥は！"},
        { "location": "150/TALK"  , "narrator": "つばめ", "text": "はぁ…？\nそんなん\n当たり前だら……。"},
        { "location": "151/TALK"  , "narrator": "つばめ", "text": "大体鳥が言葉わかったら\nわけわかんないん\nですけど。"},
        { "location": "152/TALK"  , "narrator": "つばめ", "text": "ていうか、\nそんなんで危険じゃ\nなくなるわけないし。"},
        { "location": "153/TALK"  , "narrator": "啓介", "text": "通じんより\n通じる方がいいに\n決まってるら……。"},
        { "location": "155/TALK"  , "narrator": "つばめ", "text": "もー…お父さんの\n言ってること、全然\n意味わかんないだけん。"},
        { "location": "156/TALK"  , "narrator": "つばめ", "text": "ていうかさぁ、\nまさにこれが言葉\n通じないってことだら。"},
        { "location": "157/TALK"  , "narrator": "啓介", "text": "なんだと！？"},
        { "location": "159/TALK"  , "narrator": "つばめ", "text": "あーもういい！"},
        { "location": "160/TALK"  , "narrator": "つばめ", "text": "わたしエミューに餌\nやりにいってくるで。"},
        { "location": "161/TALK"  , "narrator": "つばめ", "text": "お父さんは\nここで待っててや！\n来んでいいに！？"},
        { "location": "165/TALK"  , "narrator": "啓介", "text": "おいこらぁ！\n待ちなさい！"},
        { "location": "166/TALK"  , "narrator": "啓介", "text": "お父さんの話を聞け！！\nこら！　つばめ！！"},
        { "location": "189/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "190/TALK"  , "narrator": "アーヤ", "text": "……。"},
        { "location": "193/TALK"  , "narrator": "ガブリエラ", "text": "…っていうか、\nつばめのあれ、\n何語？"},
        { "location": "195/TALK"  , "narrator": "アーヤ", "text": "…たぶん静岡の方言。\n遠州弁、って\n言うんだっけ。"},
        { "location": "196/TALK"  , "narrator": "ガブリエラ", "text": "あんな話し方も\nするんだ、つばめ。"},
        { "location": "197/TALK"  , "narrator": "ガブリエラ", "text": "それにケンカも\nしたりするんだ…。"},
        { "location": "198/TALK"  , "narrator": "アーヤ", "text": "どこの父親もそうよね。\n娘が心配で仕方ないの。"},
        { "location": "199/TALK"  , "narrator": "アーヤ", "text": "こっちはもう子供じゃ\nないのにって\nケンカになっちゃう。"},
        { "location": "200/TALK"  , "narrator": "ガブリエラ", "text": "アーヤもお父さんと\nケンカしたりするの？"},
        { "location": "201/TALK"  , "narrator": "アーヤ", "text": "…そりゃするわよ。\n私だって。"},
        { "location": "202/TALK"  , "narrator": "ガブリエラ", "text": "そう…。"},
        { "location": "204/TALK"  , "narrator": "アーヤ", "text": "私たちもエミューの\nところに行こうか。"},
        { "location": "205/TALK"  , "narrator": "ガブリエラ", "text": "…先に行ってて。"},
        { "location": "208/TALK"  , "narrator": "ガブリエラ", "text": "あたし少し一人で\n見て回ってくる。"},
        { "location": "213/TALK"  , "narrator": "アーヤ", "text": "ギャヴィ…？"},
        { "location": "261/TALK"  , "narrator": "ガブリエラ", "text": "　"},
        { "location": "292/TALK"  , "narrator": "マルザンナ", "text": "あっ！\n$handle$、\nいらっしゃい！"},
        { "location": "293/TALK"  , "narrator": "リヴォルカ　", "text": "うわっ、ブタクサっ！"},
        { "location": "294/SEL"   , "narrator": "", "text": "やあ、マルザンナ"},
        { "location": "295/SEL"   , "narrator": "", "text": "よお、リヴォルカたん"},
        { "location": "296/ACT"   , "narrator": "", "text": "やあ、マルザンナ"},
        { "location": "297/TALK"  , "narrator": "マルザンナ", "text": "うふふ～。"},
        { "location": "298/TALK"  , "narrator": "マルザンナ", "text": "どうしたの？\nあなた♪"},
        { "location": "299/TALK"  , "narrator": "リヴォルカ　", "text": "ちょっ！　豚！\nあたしに挨拶ナシとか\n舐めてるのかしら？"},
        { "location": "300/SEL"   , "narrator": "", "text": "ああ、ども"},
        { "location": "301/SEL"   , "narrator": "", "text": "リヴォルカたん"},
        { "location": "302/ACT"   , "narrator": "", "text": "ああ、ども"},
        { "location": "303/TALK"  , "narrator": "リヴォルカ　", "text": "はぁ…\nこれだから豚は……"},
        { "location": "304/ACT"   , "narrator": "", "text": "リヴォルカたん"},
        { "location": "305/TALK"  , "narrator": "リヴォルカ　", "text": "きもっ！\n“たん”とか言うな！"},
        { "location": "306/SEL"   , "narrator": "", "text": "肝とタンは美味しいよね！"},
        { "location": "307/SEL"   , "narrator": "", "text": "肝とタンは苦手"},
        { "location": "308/ACT"   , "narrator": "", "text": "肝とタンは美味しいよね！"},
        { "location": "309/TALK"  , "narrator": "リヴォルカ　", "text": "臓物は\n苦手なのよね。"},
        { "location": "310/TALK"  , "narrator": "リヴォルカ　", "text": "ていうか、そんなのが\n好きだから豚って\nいわれるのよ。"},
        { "location": "311/ACT"   , "narrator": "", "text": "肝とタンは苦手"},
        { "location": "312/TALK"  , "narrator": "リヴォルカ　", "text": "あたしもなのよね。"},
        { "location": "313/TALK"  , "narrator": "リヴォルカ　", "text": "…って、豚と同じに\nなっちゃったわ。"},
        { "location": "316/ACT"   , "narrator": "", "text": "よお、リヴォルカたん"},
        { "location": "317/TALK"  , "narrator": "リヴォルカ　", "text": "あたしに挨拶するなんて\n100年早いわよ豚。"},
        { "location": "318/TALK"  , "narrator": "リヴォルカ　", "text": "ていうか、キモイから\n“たん”とか言うな！"},
        { "location": "319/TALK"  , "narrator": "マルザンナ", "text": "ごめんね、\n$handle$…\n相変わらずで。"},
        { "location": "322/SEL"   , "narrator": "", "text": "そっちは大丈夫そう？"},
        { "location": "323/SEL"   , "narrator": "", "text": "そんなのんびりしてていいの？"},
        { "location": "324/ACT"   , "narrator": "", "text": "そっちは大丈夫そう？"},
        { "location": "325/TALK"  , "narrator": "マルザンナ", "text": "ええ、お陰様で。"},
        { "location": "327/TALK"  , "narrator": "マルザンナ", "text": "マークスマンの\n昇華も問題なくできて、\n千羽鶴に協力してるわ。"},
        { "location": "329/TALK"  , "narrator": "マルザンナ", "text": "マークスマンの\n2x接続も問題なくできて、\n千羽鶴に協力してるわ。"},
        { "location": "331/TALK"  , "narrator": "マルザンナ", "text": "まあ、そうは言っても\n手放しにハッピーエンド\nとは言えないけど。"},
        { "location": "332/TALK"  , "narrator": "リヴォルカ　", "text": "この世界は未だに\n予測不能な危うさがあるし\n豚も健在だし。"},
        { "location": "333/TALK"  , "narrator": "マルザンナ", "text": "けど、何もしてない\nわけじゃないのよ？"},
        { "location": "334/ACT"   , "narrator": "", "text": "そんなのんびりしてていいの？"},
        { "location": "335/TALK"  , "narrator": "マルザンナ", "text": "もちろん、\n何もしてないわけじゃ\nないのよ？"},
        { "location": "337/TALK"  , "narrator": "リヴォルカ　", "text": "まあ、実際にやってるのは\nエリカだけど。"},
        { "location": "338/TALK"  , "narrator": "マルザンナ", "text": "$handle$ももう\n聞いてると思うけど、\n既に作戦は進行中よ。"},
        { "location": "339/TALK"  , "narrator": "リヴォルカ　", "text": "わりとまどろっこしい\n作戦だけどね。"},
        { "location": "340/TALK"  , "narrator": "マルザンナ", "text": "過去の不確定な事象を\n確定させつつ、今のこの\n瞬間の状況を変える――"},
        { "location": "341/TALK"  , "narrator": "マルザンナ", "text": "途方も無い話よね。"},
        { "location": "342/TALK"  , "narrator": "リヴォルカ　", "text": "その為に\n神楽のチャンネルも\n作るんでしょ？"},
        { "location": "343/TALK"  , "narrator": "リヴォルカ　", "text": "大丈夫かしら？"},
        { "location": "345/TALK"  , "narrator": "マルザンナ", "text": "ううん、\n全然大丈夫なんかじゃ\nないわよ？"},
        { "location": "347/TALK"  , "narrator": "マルザンナ", "text": "チャンネルが出来るって\nことは、神楽ともあたし\nみたいに交流できる。"},
        { "location": "348/TALK"  , "narrator": "マルザンナ", "text": "それって、\nライバルが増えるって\nことじゃない！"},
        { "location": "349/TALK"  , "narrator": "リヴォルカ　", "text": "あー、そういうことね。"},
        { "location": "350/TALK"  , "narrator": "リヴォルカ　", "text": "別にいいわよ、\n豚の一匹や二匹――"},
        { "location": "351/TALK"  , "narrator": "リヴォルカ　", "text": "……。"},
        { "location": "353/TALK"  , "narrator": "リヴォルカ　", "text": "で！？\nあんたの考えは！？"},
        { "location": "355/TALK"  , "narrator": "マルザンナ", "text": "……。"},
        { "location": "356/SEL"   , "narrator": "", "text": "ガブリエラ一筋だから心配しなくて大丈夫"},
        { "location": "357/SEL"   , "narrator": "", "text": "うーん、どうかな…？"},
        { "location": "358/SEL"   , "narrator": "", "text": "ごめん、元々神楽が好きなんだ"},
        { "location": "359/ACT"   , "narrator": "", "text": "ガブリエラ一筋だから心配しなくて大丈夫"},
        { "location": "361/TALK"  , "narrator": "リヴォルカ　", "text": "うわっ、キモっ！"},
        { "location": "362/TALK"  , "narrator": "マルザンナ", "text": "良かったわ♪\nリヴォルカも\n嬉しそうだし！"},
        { "location": "364/TALK"  , "narrator": "リヴォルカ　", "text": "どう見たら\nそう見えるのよ！"},
        { "location": "365/ACT"   , "narrator": "", "text": "うーん、どうかな…？"},
        { "location": "367/TALK"  , "narrator": "マルザンナ", "text": "まあ、大変！！"},
        { "location": "368/TALK"  , "narrator": "リヴォルカ　", "text": "優柔不断な豚ね！"},
        { "location": "369/ACT"   , "narrator": "", "text": "ごめん、元々神楽が好きなんだ"},
        { "location": "371/TALK"  , "narrator": "リヴォルカ　", "text": "あ……"},
        { "location": "372/TALK"  , "narrator": "マルザンナ", "text": "そうだったのね……。"},
        { "location": "373/TALK"  , "narrator": "リヴォルカ　", "text": "ま、まあ\n別にいいんじゃない？\n豚の一匹や二匹！"},
        { "location": "374/TALK"  , "narrator": "リヴォルカ　", "text": "それに、\n嘘つかれるより\nよっぽどいいし。"},
        { "location": "375/TALK"  , "narrator": "マルザンナ", "text": "そうよね！\n正直に答えてくれて\nありがとう。"},
        { "location": "378/TALK"  , "narrator": "リヴォルカ　", "text": "で、\n話は変わるけど。"},
        { "location": "379/TALK"  , "narrator": "リヴォルカ　", "text": "今回は何の用なのよ。"},
        { "location": "380/SEL"   , "narrator": "", "text": "心の葛藤を解消しに来た"},
        { "location": "381/ACT"   , "narrator": "", "text": "心の葛藤を解消しに来た"},
        { "location": "383/TALK"  , "narrator": "マルザンナ", "text": "まあ！\nとっても久し振りね！"},
        { "location": "385/TALK"  , "narrator": "リヴォルカ　", "text": "あーそれ、\nそういえばあたし\nやったこと無いわね。"},
        { "location": "387/TALK"  , "narrator": "マルザンナ", "text": "そうだったわね！\n一度やってみる？"},
        { "location": "388/TALK"  , "narrator": "リヴォルカ　", "text": "んー……"},
        { "location": "391/TALK"  , "narrator": "リヴォルカ　", "text": "まあ、一度\nやってみようかしらね。\n司書なんだし。"},
        { "location": "393/TALK"  , "narrator": "リヴォルカ　", "text": "失敗しても\n被害が行くのは豚だし。"},
        { "location": "394/SEL"   , "narrator": "", "text": "ブヒィィィィ！！"},
        { "location": "395/SEL"   , "narrator": "", "text": "いや、被害被るのは遠慮願います"},
        { "location": "396/ACT"   , "narrator": "", "text": "ブヒィィィィ！！"},
        { "location": "397/TALK"  , "narrator": "リヴォルカ　", "text": "あら、\nそんなに喜んじゃって。\nホントに変態ね。"},
        { "location": "398/ACT"   , "narrator": "", "text": "いや、被害被るのは遠慮願います"},
        { "location": "399/TALK"  , "narrator": "リヴォルカ　", "text": "あたしが回した扉に\n入れないっていうの\nかしら？"},
        { "location": "401/TALK"  , "narrator": "リヴォルカ　", "text": "まあいいわ。\nいずれにせよ、豚に\n拒否権なんて無いんだし。"},
        { "location": "403/TALK"  , "narrator": "リヴォルカ　", "text": "ええっと……"},
        { "location": "404/TALK"  , "narrator": "マルザンナ", "text": "頑張って！\nリヴォルカ！"},
        { "location": "405/TALK"  , "narrator": "リヴォルカ　", "text": "お、オープンプロセス、\n0xF9E番地から\n0x6CC番地へ。"},
        { "location": "410/TALK"  , "narrator": "リヴォルカ　", "text": "ああっ！\n動いたっ！\n動いたっ！！"},
        { "location": "412/TALK"  , "narrator": "マルザンナ", "text": "…！！"},
        { "location": "413/TALK"  , "narrator": "マルザンナ", "text": "ストーップ！！"},
        { "location": "414/TALK"  , "narrator": "リヴォルカ　", "text": "えっ！？"},
        { "location": "415/TALK"  , "narrator": "リヴォルカ　", "text": "ストップ！\nストップ！"},
        { "location": "423/TALK"  , "narrator": "リヴォルカ　", "text": "……ふぅ。"},
        { "location": "426/TALK"  , "narrator": "リヴォルカ　", "text": "さあ、ちゃんと\n回してやったわよ！\n早く入りなさいよ！"},
        { "location": "427/TALK"  , "narrator": "マルザンナ", "text": "ダメダメ！\n葛藤を読み上げなくちゃ！"},
        { "location": "429/TALK"  , "narrator": "リヴォルカ　", "text": "あ、ああっ……\nえっと――"},
        { "location": "431/TALK"  , "narrator": "リヴォルカ　", "text": "あー……。"},
        { "location": "432/TALK"  , "narrator": "リヴォルカ　", "text": "家族のことを思い出して\n落ち込んじゃったのね。"},
        { "location": "433/TALK"  , "narrator": "リヴォルカ　", "text": "まったく、\n気合いが足りないのよ。"},
        { "location": "434/TALK"  , "narrator": "リヴォルカ　", "text": "今だって\n楽しい事は\nいっぱい――"},
        { "location": "435/TALK"  , "narrator": "リヴォルカ　", "text": "……。"},
        { "location": "437/TALK"  , "narrator": "リヴォルカ　", "text": "ほら！\n読み上げたんだから、\nさっさと行ってきて頂戴。"},
        { "location": "438/SEL"   , "narrator": "", "text": "不安しかない"},
        { "location": "439/SEL"   , "narrator": "", "text": "リヴォルカかわいいーーー！"},
        { "location": "440/SEL"   , "narrator": "", "text": "ヴヒ！"},
        { "location": "441/ACT"   , "narrator": "", "text": "不安しかない"},
        { "location": "443/TALK"  , "narrator": "マルザンナ", "text": "大丈夫よ。\n扉はちゃんと\n正常に回ってるから。"},
        { "location": "444/TALK"  , "narrator": "リヴォルカ　", "text": "だいたい豚の分際で\n心配だなんて、\n一億年早いのよ。"},
        { "location": "445/TALK"  , "narrator": "リヴォルカ　", "text": "早くいつものように\nブヒィィィィ！！って\n扉に突進したら？"},
        { "location": "446/ACT"   , "narrator": "", "text": "リヴォルカかわいいーーー！"},
        { "location": "447/TALK"  , "narrator": "リヴォルカ　", "text": "は……\nはあああああっ！？"},
        { "location": "448/TALK"  , "narrator": "リヴォルカ　", "text": "寝ぼけたこと\n言ってないで！！"},
        { "location": "449/TALK"  , "narrator": "リヴォルカ　", "text": "早くいつものように、\nブヒィィィィ！！って\n扉に突進しなさいよね！"},
        { "location": "450/ACT"   , "narrator": "", "text": "ヴヒ！"},
        { "location": "451/TALK"  , "narrator": "リヴォルカ　", "text": "……。"},
        { "location": "452/TALK"  , "narrator": "リヴォルカ　", "text": "何よその\nちょっと発音良さそうな\n豚は…？"},
        { "location": "453/TALK"  , "narrator": "リヴォルカ　", "text": "いいからさっさと\nブヒィィィィ！！って\n扉に突進しなさいよ！"},
        { "location": "455/SEL"   , "narrator": "", "text": "ブヒィィィィ！！"},
        { "location": "456/SEL"   , "narrator": "", "text": "いつもの決め台詞言ってください"},
        { "location": "457/ACT"   , "narrator": "", "text": "ブヒィィィィ！！"},
        { "location": "458/ACT"   , "narrator": "", "text": "いつもの決め台詞言ってください"},
        { "location": "459/TALK"  , "narrator": "リヴォルカ　", "text": "本っっ当に！\n注文の多い豚ね……"},
        { "location": "460/TALK"  , "narrator": "リヴォルカ　", "text": "はいはい…"},
        { "location": "462/TALK"  , "narrator": "リヴォルカ　", "text": "豚とあたしに\n素敵なココロの旅を。"},
        { "location": "483/TALK"  , "narrator": "リヴォルカ", "text": "はぁぁぁ……"},
        { "location": "484/TALK"  , "narrator": "リヴォルカ", "text": "――って！！\nなんであんたが\nまだココにいるのよ！"},
        { "location": "485/TALK"  , "narrator": "リヴォルカ", "text": "いや……\nあたしがここに残ってた\nだけだったわ……。"},
        { "location": "486/SEL"   , "narrator": "", "text": "何か用？"},
        { "location": "487/SEL"   , "narrator": "", "text": "二人きりだね"},
        { "location": "488/ACT"   , "narrator": "", "text": "何か用？"},
        { "location": "489/TALK"  , "narrator": "リヴォルカ", "text": "え！？\nいや…別に……"},
        { "location": "490/ACT"   , "narrator": "", "text": "二人きりだね"},
        { "location": "491/TALK"  , "narrator": "リヴォルカ", "text": "そういうキモイの\nやめてくれる？"},
        { "location": "493/TALK"  , "narrator": "リヴォルカ", "text": "その、なに？"},
        { "location": "494/TALK"  , "narrator": "リヴォルカ", "text": "ちょっとあんたに\n言っておきたいことが\nあっただけよ。"},
        { "location": "495/TALK"  , "narrator": "リヴォルカ", "text": "マークスマンの\n発症前後では、あんたに\nちょっと助けられたし。"},
        { "location": "497/TALK"  , "narrator": "リヴォルカ", "text": "まだそのお礼も\nちゃんと\n言ってなかったし――"},
        { "location": "498/TALK"  , "narrator": "リヴォルカ", "text": "こ、これは社交辞令よ？\nお礼言うのは、戦士として\n最低限のマナーだし！"},
        { "location": "499/TALK"  , "narrator": "リヴォルカ", "text": "その、だから……"},
        { "location": "500/TALK"  , "narrator": "リヴォルカ", "text": "いろいろありがと…。"},
        { "location": "501/TALK"  , "narrator": "リヴォルカ", "text": "はい、おしまい！！"},
        { "location": "502/SEL"   , "narrator": "", "text": "どういたしまして"},
        { "location": "503/SEL"   , "narrator": "", "text": "チューはないの？"},
        { "location": "504/ACT"   , "narrator": "", "text": "どういたしまして"},
        { "location": "506/TALK"  , "narrator": "リヴォルカ", "text": "それだけ！\nそれじゃ、ばいばい…。"},
        { "location": "507/ACT"   , "narrator": "", "text": "チューはないの？"},
        { "location": "510/TALK"  , "narrator": "リヴォルカ", "text": "はぁ！？\nな、何を馬鹿なことを\n言ってるのよ！！"},
        { "location": "526/TALK"  , "narrator": "リヴォルカ", "text": "ふわあっ！！"},
        { "location": "527/TALK"  , "narrator": "リヴォルカ", "text": "ななななななっ！！"},
        { "location": "531/TALK"  , "narrator": "リヴォルカ", "text": "ふわあっ！！"},
        { "location": "532/TALK"  , "narrator": "リヴォルカ", "text": "ななななななっ！！"},
        { "location": "539/TALK"  , "narrator": "リヴォルカ", "text": "な、何勝手に\nやってるのよ！！"},
        { "location": "542/TALK"  , "narrator": "リヴォルカ", "text": "<size=35>バカ！</size>"},
        { "location": "545/TALK"  , "narrator": "リヴォルカ", "text": "<size=38>アホ！</size>"},
        { "location": "548/TALK"  , "narrator": "リヴォルカ", "text": "<size=42>豚！</size>"},
        { "location": "549/SEL"   , "narrator": "", "text": "ごめんね？　嫌だった？"},
        { "location": "550/SEL"   , "narrator": "", "text": "もう一度ちゅう"},
        { "location": "551/ACT"   , "narrator": "", "text": "ごめんね？　嫌だった？"},
        { "location": "552/TALK"  , "narrator": "リヴォルカ", "text": "そ、そんなの\n決まってるじゃない！"},
        { "location": "553/TALK"  , "narrator": "リヴォルカ", "text": "い、嫌なわけ――"},
        { "location": "558/TALK"  , "narrator": "リヴォルカ", "text": "えいっ！"},
        { "location": "559/TALK"  , "narrator": "リヴォルカ", "text": "それだけ！\nばいばい…。"},
        { "location": "560/ACT"   , "narrator": "", "text": "もう一度ちゅう"},
        { "location": "565/TALK"  , "narrator": "リヴォルカ", "text": "それだけ！\nばいばい…。"},
        { "location": "570/TALK"  , "narrator": "リヴォルカ　", "text": "やっぱり嫌。\n豚の為に扉回すとか\n労力の無駄よね。"},
        { "location": "572/TALK"  , "narrator": "マルザンナ", "text": "そう？\nそれじゃ、\nあたしが回すわね♪"},
        { "location": "574/TALK"  , "narrator": "マルザンナ", "text": "オープンプロセス、\n0xF9E番地から\n0x6CC番地へ。"},
        { "location": "599/TALK"  , "narrator": "マルザンナ", "text": "シーク完了。"},
        { "location": "602/TALK"  , "narrator": "マルザンナ", "text": "えっとそれで、\n今回の悩みは…っと。"},
        { "location": "604/TALK"  , "narrator": "マルザンナ", "text": "ああ……。\n家族のことを思い出して\n落ち込んじゃったのね。"},
        { "location": "605/TALK"  , "narrator": "マルザンナ", "text": "というわけなの。\nお願い出来るかしら\n$handle$？"},
        { "location": "607/TALK"  , "narrator": "リヴォルカ　", "text": "仮にもあたしなんだから\n豚に色目使わないでよね。"},
        { "location": "608/SEL"   , "narrator": "", "text": "もちろん"},
        { "location": "609/ACT"   , "narrator": "", "text": "もちろん"},
        { "location": "611/TALK"  , "narrator": "マルザンナ", "text": "ありがとう！\n$handle$、\n大好き。"},
        { "location": "612/TALK"  , "narrator": "マルザンナ", "text": "それじゃ、\n今回もズバッと\nやってきちゃってね？"},
        { "location": "615/TALK"  , "narrator": "マルザンナ", "text": "$handle$と\nあたしに\n素敵なココロの旅を！"},
        { "location": "630/TALK"  , "narrator": "マルザンナ", "text": "――なんて♪"},
        { "location": "631/SEL"   , "narrator": "", "text": "マルザンナ？"},
        { "location": "632/ACT"   , "narrator": "", "text": "マルザンナ？"},
        { "location": "634/TALK"  , "narrator": "マルザンナ", "text": "あたしだけ\n居残っちゃった。\nふふ♪"},
        { "location": "635/SEL"   , "narrator": "", "text": "どうしたの？"},
        { "location": "636/ACT"   , "narrator": "", "text": "どうしたの？"},
        { "location": "638/TALK"  , "narrator": "マルザンナ", "text": "だって！"},
        { "location": "639/TALK"  , "narrator": "マルザンナ", "text": "最近ずっと色々あって\n緊迫してたでしょ？"},
        { "location": "640/TALK"  , "narrator": "マルザンナ", "text": "全然$handle$と\nゆっくり出来なかったし、\nだからちょっとだけ。"},
        { "location": "641/TALK"  , "narrator": "マルザンナ", "text": "それに、お礼も\n言わなくちゃだし。"},
        { "location": "642/TALK"  , "narrator": "マルザンナ", "text": "改めて、今回の件は\n本当にありがと。"},
        { "location": "643/TALK"  , "narrator": "マルザンナ", "text": "嬉しかったのは、あんたが\nこのつばめの世界を\n支持してくれたこと。"},
        { "location": "644/TALK"  , "narrator": "マルザンナ", "text": "もちろんそれは、\nあたしにとっての得でしか\nないかもしれないけど。"},
        { "location": "645/TALK"  , "narrator": "マルザンナ", "text": "あたしにとっては、\nこの世界が全てだから。"},
        { "location": "646/TALK"  , "narrator": "マルザンナ", "text": "あたし、最近思うのよ。"},
        { "location": "647/TALK"  , "narrator": "マルザンナ", "text": "世界中の全ての人を\n救えないときもある。"},
        { "location": "648/TALK"  , "narrator": "マルザンナ", "text": "その時に、誰を救うのかは\n理屈じゃなくて、想いが\n決めるってこと。"},
        { "location": "649/TALK"  , "narrator": "マルザンナ", "text": "$handle$は、\nあたしを選んでくれた。"},
        { "location": "650/TALK"  , "narrator": "マルザンナ", "text": "そのことが、\nすごく嬉しいの。"},
        { "location": "651/TALK"  , "narrator": "マルザンナ", "text": "だから……すき。"},
        { "location": "652/SEL"   , "narrator": "", "text": "マルザンナ…"},
        { "location": "653/SEL"   , "narrator": "", "text": "ありがとう"},
        { "location": "654/ACT"   , "narrator": "", "text": "マルザンナ…"},
        { "location": "673/TALK"  , "narrator": "マルザンナ", "text": "ひぁっ…"},
        { "location": "674/TALK"  , "narrator": "マルザンナ", "text": "すごくすき……。"},
        { "location": "678/TALK"  , "narrator": "マルザンナ", "text": "ひぁっ…"},
        { "location": "679/TALK"  , "narrator": "マルザンナ", "text": "すごくすき……。"},
        { "location": "687/TALK"  , "narrator": "マルザンナ", "text": "は、はいはい。\nおしまいおしまい！"},
        { "location": "688/TALK"  , "narrator": "マルザンナ", "text": "と、とにかく！"},
        { "location": "689/TALK"  , "narrator": "マルザンナ", "text": "今回は、\n$handle$に\nお礼したかっただけだし。"},
        { "location": "690/TALK"  , "narrator": "マルザンナ", "text": "他に何も無いから、\nもう行くわね！"},
        { "location": "691/SEL"   , "narrator": "", "text": "またね"},
        { "location": "692/SEL"   , "narrator": "", "text": "またちゅうしようね"},
        { "location": "693/ACT"   , "narrator": "", "text": "またね"},
        { "location": "695/TALK"  , "narrator": "マルザンナ", "text": "ええ。"},
        { "location": "696/TALK"  , "narrator": "マルザンナ", "text": "それじゃ、今回の\nクラン退治、よろしくね。"},
        { "location": "697/ACT"   , "narrator": "", "text": "またちゅうしようね"},
        { "location": "698/TALK"  , "narrator": "マルザンナ", "text": "……。"},
        { "location": "699/TALK"  , "narrator": "マルザンナ", "text": "…うん。"},
        { "location": "700/TALK"  , "narrator": "マルザンナ", "text": "それじゃ、今回の\nクラン退治、よろしくね。"},
        { "location": "702/TALK"  , "narrator": "マルザンナ", "text": "ばいばい。"},
        { "location": "703/ACT"   , "narrator": "", "text": "ありがとう"},
        { "location": "705/TALK"  , "narrator": "マルザンナ", "text": "……。"},
        { "location": "706/TALK"  , "narrator": "マルザンナ", "text": "と、とにかく！"},
        { "location": "707/TALK"  , "narrator": "マルザンナ", "text": "今回は、\n$handle$に\nお礼したかっただけだし。"},
        { "location": "709/TALK"  , "narrator": "マルザンナ", "text": "他に何も無いから、\nもう行くわね！"},
        { "location": "710/SEL"   , "narrator": "", "text": "またね"},
        { "location": "711/ACT"   , "narrator": "", "text": "またね"},
        { "location": "713/TALK"  , "narrator": "マルザンナ", "text": "ええ。"},
        { "location": "714/TALK"  , "narrator": "マルザンナ", "text": "それじゃ、今回の\nクラン退治、よろしくね。"},
        { "location": "715/TALK"  , "narrator": "マルザンナ", "text": "ばいばい。"},
        { "location": "28/DIALOG" , "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:Interrupt】</color>\nSystem Interrupted.\n\n必須選択肢が選ばれていません。\n\n<color=green>『STORY27：シン・カグラ』</color>\nにて、選択を行ってから\n再度アクセスしてください。\n"},
        { "location": "32/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>10月30日　1:15 PM</color>\nとある休日、静岡県花鳥園にて"},
        { "location": "226/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "228/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "230/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "232/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "234/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "514/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:librarian】</color>\n今ですっ！\n(p87)"},
        { "location": "518/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "536/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"},
        { "location": "661/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:librarian】</color>\n彼女は性格的に\n5秒以上放置されると\n耐えられなくなります。\n(p87)"},
        { "location": "665/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "683/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"}
    ]
