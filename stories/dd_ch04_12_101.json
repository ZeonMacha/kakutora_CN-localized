{
    "dir": "chap12/daydra/dd_ch04_12_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "12402",
        "cid": "miyabi",
        "title": "002 メインストーリー",
        "sub_title": "偶然の出会い＜前編＞"
    },
    "entry":
    [
        { "location": "8/SCENARIO", "narrator": "", "text": "偶然の出会い"},
        { "location": "33/TALK"   , "narrator": "みやび", "text": "…中々えい味やった。"},
        { "location": "34/TALK"   , "narrator": "みやび", "text": "ネットで見た情報は、\nガセじゃなかったな。"},
        { "location": "35/SEL"    , "narrator": "", "text": "一人でティータイム？"},
        { "location": "36/ACT"    , "narrator": "", "text": "一人でティータイム？"},
        { "location": "38/TALK"   , "narrator": "みやび", "text": "ん？"},
        { "location": "47/TALK"   , "narrator": "みやび", "text": "うむ"},
        { "location": "48/TALK"   , "narrator": "みやび", "text": "ネットで見たんよ"},
        { "location": "49/TALK"   , "narrator": "みやび", "text": "ここのメイド喫茶のケーキは絶品やってな"},
        { "location": "51/SEL"    , "narrator": "", "text": "メイド喫茶！？"},
        { "location": "52/ACT"    , "narrator": "", "text": "メイド喫茶！？"},
        { "location": "54/TALK"   , "narrator": "みやび", "text": "別に驚くことやないやろ？"},
        { "location": "55/TALK"   , "narrator": "みやび", "text": "ちゅうか、まだ締めの紅茶タイム満喫中やき"},
        { "location": "56/TALK"   , "narrator": "みやび", "text": "話は後や"},
        { "location": "63/TALK"   , "narrator": "みやび", "text": "さて…追加するか、\nやめておくか…。"},
        { "location": "70/TALK"   , "narrator": "繭", "text": "お疲れ様、お先に。"},
        { "location": "72/TALK"   , "narrator": "繭", "text": "…………。"},
        { "location": "73/TALK"   , "narrator": "繭", "text": "っ！？"},
        { "location": "74/TALK"   , "narrator": "みやび", "text": "せっかく来たんやし、\nやはり頼んだ方が\nえいかもしれんな。"},
        { "location": "76/TALK"   , "narrator": "みやび", "text": "あー、すみませーん。"},
        { "location": "81/TALK"   , "narrator": "繭", "text": "みやび先輩！？"},
        { "location": "84/TALK"   , "narrator": "みやび", "text": "んっ？"},
        { "location": "85/TALK"   , "narrator": "みやび", "text": "この子は…えーと、\nなんやったっけか…。"},
        { "location": "87/TALK"   , "narrator": "繭", "text": "みやび先輩…。\nこんなところで\n何を――"},
        { "location": "93/TALK"   , "narrator": "ウェイトレス", "text": "お待たせしましたー♪"},
        { "location": "95/TALK"   , "narrator": "ウェイトレス", "text": "あら、光月さん？"},
        { "location": "98/TALK"   , "narrator": "みやび", "text": "ああ、光月さん。\n奇遇やね。"},
        { "location": "102/TALK"  , "narrator": "繭", "text": "あ、は、はい！\n本当に奇遇というか、\n何故ここに！？"},
        { "location": "103/TALK"  , "narrator": "みやび", "text": "お茶しに来たちや。\nで、光月さんは？"},
        { "location": "105/TALK"  , "narrator": "繭", "text": "わ、私は…。"},
        { "location": "106/TALK"  , "narrator": "ウェイトレス", "text": "まだいたんだ？\n光月さん、今日の\nシフトは――"},
        { "location": "110/TALK"  , "narrator": "繭", "text": "シフォンケーキ！！"},
        { "location": "112/TALK"  , "narrator": "ウェイトレス", "text": "はい？"},
        { "location": "113/TALK"  , "narrator": "繭", "text": "シフォンケーキと\n紅茶のセット！！"},
        { "location": "114/TALK"  , "narrator": "ウェイトレス", "text": "え、えーっと…。"},
        { "location": "117/TALK"  , "narrator": "みやび", "text": "あ、うちは紅茶と\n桃のタルトで。"},
        { "location": "118/TALK"  , "narrator": "繭", "text": "今すぐ！　大至急！！"},
        { "location": "120/TALK"  , "narrator": "ウェイトレス", "text": "あ、はい！\nかしこまりましたぁ。"},
        { "location": "122/TALK"  , "narrator": "繭", "text": "…………。"},
        { "location": "125/TALK"  , "narrator": "みやび", "text": "…とりあえず、\n座ったらどうや？"},
        { "location": "128/TALK"  , "narrator": "繭", "text": "はい…すみません…。"},
        { "location": "155/TALK"  , "narrator": "みやび", "text": "…こんなところで\n会うなんて、\n奇遇やね。"},
        { "location": "156/TALK"  , "narrator": "繭", "text": "あ、はい…。"},
        { "location": "158/TALK"  , "narrator": "みやび", "text": "光月さんも、\nケーキ食べに来たが？"},
        { "location": "159/TALK"  , "narrator": "繭", "text": "はい…。"},
        { "location": "160/TALK"  , "narrator": "みやび", "text": "ん…そう…。"},
        { "location": "161/TALK"  , "narrator": "繭", "text": "…………。"},
        { "location": "162/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "164/TALK"  , "narrator": "繭", "text": "あ、あの…私が\nここにいたこと、\nみんなには…。"},
        { "location": "165/TALK"  , "narrator": "みやび", "text": "ん？\nああ、言わんよ。"},
        { "location": "167/TALK"  , "narrator": "みやび", "text": "光月さんが\nメイド喫茶の常連\nっちゅうのは――"},
        { "location": "168/TALK"  , "narrator": "みやび", "text": "うちと光月さん、\n二人だけの秘密や。"},
        { "location": "170/TALK"  , "narrator": "繭", "text": "ふ、二人だけ！？\n光栄です！"},
        { "location": "172/TALK"  , "narrator": "みやび", "text": "？　そう？"},
        { "location": "174/TALK"  , "narrator": "繭", "text": "…常連と思われたのは\n心外だけど――"},
        { "location": "175/TALK"  , "narrator": "繭", "text": "バイトしてるのが\nバレるよりはマシだと\n思わなければ。"},
        { "location": "176/TALK"  , "narrator": "みやび", "text": "…ここ、\nケーキ美味いね。"},
        { "location": "179/TALK"  , "narrator": "繭", "text": "そ、そうですね…。"},
        { "location": "180/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "183/TALK"  , "narrator": "繭", "text": "…け、ケーキ、\nお好きなんですか？"},
        { "location": "184/TALK"  , "narrator": "みやび", "text": "いや、実はどっちかと\nいえば苦手な方やき。\nけんど、ここのは美味い。"},
        { "location": "186/TALK"  , "narrator": "繭", "text": "そうなんですか…。"},
        { "location": "188/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "190/TALK"  , "narrator": "みやび", "text": "居心地悪いちや…。"},
        { "location": "191/TALK"  , "narrator": "みやび", "text": "まあ、よく知らん子\nなんやし、仕方ない。"},
        { "location": "192/TALK"  , "narrator": "みやび", "text": "…けんど、せっかく\nこうして同じ席に\n座ってるんやし――"},
        { "location": "193/TALK"  , "narrator": "みやび", "text": "もうちくっと話を\n引き出す努力をして\nみるか…。"},
        { "location": "194/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "196/TALK"  , "narrator": "みやび", "text": "けんど、面倒くさ\nそうやなぁ…。"},
        { "location": "239/TALK"  , "narrator": "みやび", "text": "来よったね。"},
        { "location": "259/TALK"  , "narrator": "みやび", "text": "うむ。\n今日も元気で何よりや。"},
        { "location": "262/TALK"  , "narrator": "みやび", "text": "今日もエロいな、\nお前さんは。"},
        { "location": "265/TALK"  , "narrator": "みやび", "text": "今日もフェチ全開やね、\nお前さんは。"},
        { "location": "269/TALK"  , "narrator": "みやび", "text": "みやびさん\n５ポイントゲット。"},
        { "location": "271/TALK"  , "narrator": "みやび", "text": "ほんで……！"},
        { "location": "276/TALK"  , "narrator": "みやび", "text": "１１ポイント貯まった\nことにより、ボーナスが\n発生しました！"},
        { "location": "277/SEL"   , "narrator": "", "text": "半端すぎる…"},
        { "location": "278/SEL"   , "narrator": "", "text": "なんでわざわざ素数？"},
        { "location": "279/ACT"   , "narrator": "", "text": "半端すぎる…"},
        { "location": "280/TALK"  , "narrator": "みやび", "text": "そんなの\nうちの勝手やき。"},
        { "location": "281/TALK"  , "narrator": "みやび", "text": "うちは素数をこよなく\n愛するんや。"},
        { "location": "282/ACT"   , "narrator": "", "text": "なんでわざわざ素数？"},
        { "location": "283/TALK"  , "narrator": "みやび", "text": "む。\nえいところに気づいたね。"},
        { "location": "285/TALK"  , "narrator": "みやび", "text": "うちは素数が大好きやき、\n区切りがえい数字とは\n素数のことぞね。"},
        { "location": "287/TALK"  , "narrator": "みやび", "text": "というわけで、\n早速$handle$から\n賞品をもらうぞね。"},
        { "location": "288/SEL"   , "narrator": "", "text": "何をあげればいいの？"},
        { "location": "289/SEL"   , "narrator": "", "text": "ちゅうをあげます！"},
        { "location": "290/ACT"   , "narrator": "", "text": "何をあげればいいの？"},
        { "location": "291/TALK"  , "narrator": "みやび", "text": "うむ。まあ順当に考えれば\n物質的なものが一般的な\n回答になるわけやけんど…"},
        { "location": "292/TALK"  , "narrator": "みやび", "text": "現状うちの物的欲求は、\n管理庁から貰ったスパコン\nによって満たされちょる。"},
        { "location": "293/TALK"  , "narrator": "みやび", "text": "お前さんにそれを超える\n物的賞品は無理やろうき、\n精神的賞品にしちゃる。"},
        { "location": "315/TALK"  , "narrator": "みやび", "text": "ほれ、\nうちを撫でて癒すちや。"},
        { "location": "333/TALK"  , "narrator": "みやび", "text": "ふぁっ…"},
        { "location": "336/TALK"  , "narrator": "みやび", "text": "いたっ！\nそれで癒やせると\n思うんか？"},
        { "location": "358/TALK"  , "narrator": "みやび", "text": "ふむ。\nえい癒しやった。"},
        { "location": "359/TALK"  , "narrator": "みやび", "text": "次は何を\n賞品として\nもらうことにするかね。"},
        { "location": "360/ACT"   , "narrator": "", "text": "ちゅうをあげます！"},
        { "location": "363/TALK"  , "narrator": "みやび", "text": "なんぞ、またちゅーか。"},
        { "location": "364/TALK"  , "narrator": "みやび", "text": "前にうちのどこぞの人格と\nちゅーをしちょらんかった\nかね？"},
        { "location": "365/SEL"   , "narrator": "", "text": "バレてたか！"},
        { "location": "366/ACT"   , "narrator": "", "text": "バレてたか！"},
        { "location": "368/TALK"  , "narrator": "みやび", "text": "当然や。\n司書やきね。"},
        { "location": "370/TALK"  , "narrator": "みやび", "text": "持て余すヒマをフル活用\nして、興味あることは\n調べ尽くす。"},
        { "location": "371/SEL"   , "narrator": "", "text": "ちゅーに興味有るんだ！"},
        { "location": "372/ACT"   , "narrator": "", "text": "ちゅーに興味有るんだ！"},
        { "location": "375/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "377/TALK"  , "narrator": "みやび", "text": "興味あるんは\nちゅーやない！\nお前さんの習性や。"},
        { "location": "378/TALK"  , "narrator": "みやび", "text": "ほんでたった今、\nお前さんは『ちゅーちゅー\n依存症』やと判明した。"},
        { "location": "381/TALK"  , "narrator": "みやび", "text": "…まあ、べつに\nちゅーをもらうこと自体は\nえいけんど――"},
        { "location": "382/TALK"  , "narrator": "みやび", "text": "こんなバーチャルなうちと\nちゅーしても、何も進展\nせんし、満たされんぞね。"},
        { "location": "383/SEL"   , "narrator": "", "text": "これはみやびへの賞品なので$me$が満たされるかどうかは関係無い！"},
        { "location": "384/ACT"   , "narrator": "", "text": "これはみやびへの賞品なので$me$が満たされるかどうかは関係無い！"},
        { "location": "387/TALK"  , "narrator": "みやび", "text": "お前さん、それ\n本気でゆうちょるんか？"},
        { "location": "388/TALK"  , "narrator": "みやび", "text": "もしそうなら\nとんだ自惚れ屋やね……"},
        { "location": "389/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "390/TALK"  , "narrator": "みやび", "text": "…んー、まあ。\nえいか、それで。\nまだ１回目の賞品やしな。"},
        { "location": "412/TALK"  , "narrator": "みやび", "text": "ほれ、\n貰っちゃるき、はよ。"},
        { "location": "430/TALK"  , "narrator": "みやび", "text": "ふぁっ…"},
        { "location": "433/TALK"  , "narrator": "みやび", "text": "ふぁっ…"},
        { "location": "456/TALK"  , "narrator": "みやび", "text": "ふむ。\nまあ、ザ・１回目！\nちゅう感じやね。"},
        { "location": "457/SEL"   , "narrator": "", "text": "てことは、２回目の賞品はちゅー以上のことを…"},
        { "location": "458/ACT"   , "narrator": "", "text": "てことは、２回目の賞品はちゅー以上のことを…"},
        { "location": "462/TALK"  , "narrator": "みやび", "text": "ないない。\n今度はちゃんと資産価値が\n出るものをもらうき。"},
        { "location": "465/TALK"  , "narrator": "みやび", "text": "さて、賞品ももらった\nことやし、真面目に\n仕事でもするか。"},
        { "location": "472/TALK"  , "narrator": "みやび", "text": "オープンプロセス、\n0x492番地から\n0x559番地へ。"},
        { "location": "487/TALK"  , "narrator": "みやび", "text": "完了。"},
        { "location": "489/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "491/TALK"  , "narrator": "みやび", "text": "………。"},
        { "location": "493/TALK"  , "narrator": "みやび", "text": "なるほどなぁ。\nうちらしい、\n合理的な悩みやね。"},
        { "location": "494/SEL"   , "narrator": "", "text": "繭に興味があるの？"},
        { "location": "495/ACT"   , "narrator": "", "text": "繭に興味があるの？"},
        { "location": "497/TALK"  , "narrator": "みやび", "text": "いや、ない。"},
        { "location": "498/TALK"  , "narrator": "みやび", "text": "けんど、\nこのまま何も喋らず帰ると\n後悔する気がするちや。"},
        { "location": "499/SEL"   , "narrator": "", "text": "理由は？"},
        { "location": "500/ACT"   , "narrator": "", "text": "理由は？"},
        { "location": "502/TALK"  , "narrator": "みやび", "text": "色々あるけんど、\n面倒くさいんやね。"},
        { "location": "503/TALK"  , "narrator": "みやび", "text": "あの子らが、うちの劇場で\nバイトするように\nなったんはしっちゅうか？"},
        { "location": "504/SEL"   , "narrator": "", "text": "はい"},
        { "location": "505/SEL"   , "narrator": "", "text": "いいえ"},
        { "location": "506/ACT"   , "narrator": "", "text": "はい"},
        { "location": "507/ACT"   , "narrator": "", "text": "いいえ"},
        { "location": "509/TALK"  , "narrator": "みやび", "text": "まあそんなわけやき、\n今後わりと頻繁に顔を\n合わせることになる。"},
        { "location": "511/TALK"  , "narrator": "みやび", "text": "そんな相手をぞんざいに\nして、今後気まずく\nなったら大変ぞね。"},
        { "location": "512/TALK"  , "narrator": "みやび", "text": "うち、\n出社拒否してまうやも\nしれんよ。"},
        { "location": "513/TALK"  , "narrator": "みやび", "text": "つばめちゃんの友達ちゅう\nこともあるき、逃げ道が\nないしね。"},
        { "location": "514/SEL"   , "narrator": "", "text": "確かにみやびらしい思考"},
        { "location": "515/ACT"   , "narrator": "", "text": "確かにみやびらしい思考"},
        { "location": "517/TALK"  , "narrator": "みやび", "text": "納得してくれて\nなによりや。"},
        { "location": "518/TALK"  , "narrator": "みやび", "text": "やき、ここで逃げるんは\n簡単やけんど、それは\nいかんちゅう結論や。"},
        { "location": "519/TALK"  , "narrator": "みやび", "text": "とはいえ、逃げたいと\n考える自分に荷担しゆう\nクランもおる。"},
        { "location": "520/TALK"  , "narrator": "みやび", "text": "ちゅうわけで、すっと\nソイツを排除しいや。\nよろしく頼んだぞね。"},
        { "location": "521/TALK"  , "narrator": "みやび", "text": "うちと$handle$に\nえいココロの旅を。"},
        { "location": "31/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>7月9日　2:41 PM</color>\nとある休日の午後、秋葉原にある某メイドカフェにて。"},
        { "location": "208/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "245/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "268/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"},
        { "location": "321/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "340/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"},
        { "location": "418/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "437/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"}
    ]
}
