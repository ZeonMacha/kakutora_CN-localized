        { "location": "625/TALK", "narrator": "プレイヤー", "text": "お着替えしてみよう"},
        { "location": "627/TALK", "narrator": "プレイヤー", "text": "違う服を着てほしいな"},
        { "location": "629/TALK", "narrator": "プレイヤー", "text": "よし、お着替えタイムだ！"},
        { "location": "635/TALK", "narrator": "プレイヤー", "text": "やあ"},
        { "location": "637/TALK", "narrator": "プレイヤー", "text": "こんにちは"},
        { "location": "639/TALK", "narrator": "プレイヤー", "text": "げんき？"},
        { "location": "642/TALK", "narrator": "神楽", "text": "ぴょんこを呼ぶ声"},
        { "location": "643/TALK", "narrator": "神楽", "text": "あなたはだあれ？"},
        { "location": "645/SEL" , "narrator": "", "text": "$handle$だよ"},
        { "location": "646/ACT" , "narrator": "", "text": "$handle$だよ"},
        { "location": "648/TALK", "narrator": "神楽", "text": "知ってるし"},
        { "location": "649/TALK", "narrator": "神楽", "text": "ぴょんこに用事ぴょん？"},
        { "location": "652/SEL" , "narrator": "", "text": "ちょっと着替えてほしいんだ"},
        { "location": "653/ACT" , "narrator": "", "text": "ちょっと着替えてほしいんだ"},
        { "location": "663/TALK", "narrator": "神楽", "text": "意味不明すぎ"},
        { "location": "664/TALK", "narrator": "神楽", "text": "でもまあ"},
        { "location": "665/TALK", "narrator": "神楽", "text": "優しいぴょんこは聞いてあげるのだった"},
        { "location": "667/TALK", "narrator": "神楽", "text": "は？"},
        { "location": "668/TALK", "narrator": "神楽", "text": "この服変だった？"},
        { "location": "669/TALK", "narrator": "神楽", "text": "なら着替えるけど"},
        { "location": "672/SEL" , "narrator": "", "text": "$me$が選ぶ"},
        { "location": "673/SEL" , "narrator": "", "text": "やっぱやめる"},
        { "location": "675/TALK", "narrator": "神楽", "text": "…………"},
        { "location": "678/TALK", "narrator": "神楽", "text": "リクエストないとか？"},
        { "location": "679/TALK", "narrator": "神楽", "text": "なら着ない"},
        { "location": "681/ACT" , "narrator": "", "text": "$me$が選ぶ"},
        { "location": "682/TALK", "narrator": "神楽", "text": "だと思った"},
        { "location": "683/TALK", "narrator": "神楽", "text": "どれを着てほしいと？"},
        { "location": "690/ACT" , "narrator": "", "text": "やっぱやめる"},
        { "location": "691/TALK", "narrator": "神楽", "text": "ありえネー"}
