{
    "dir": "chap04/battle/btev_ch04_04_00.js",
    "type": "",
    "info": {
        "story_id": "24001",
        "cid": "",
        "title": "001 ココロスフィアストーリー【Lv01】",
        "sub_title": "敵Ⅰ＜提起＞"
    },
    "entry":
    [
        { "location": "5/SCENARIO", "narrator": "", "text": "バトル導入"},
        { "location": "29/TALK"   , "narrator": "千羽鶴", "text": "ようこそ。\nここは恋ヶ崎みやびの\n精神世界――"},
        { "location": "30/TALK"   , "narrator": "千羽鶴", "text": "通称<color=red>【[ココロスフィア]】</color>\nと呼ばれている場所。"},
        { "location": "31/TALK"   , "narrator": "千羽鶴", "text": "ここでは彼女は\nあなたと普通に\n対話できる。"},
        { "location": "32/TALK"   , "narrator": "千羽鶴", "text": "彼女の心に直接\n語りかけることで、\n心を動かすの。"},
        { "location": "33/TALK"   , "narrator": "千羽鶴", "text": "早速、彼女を呼んで\n対話をしてみましょ。"},
        { "location": "42/DIALOG" , "narrator": "", "text": "<size=40>KOKORO-Lv. 01</size>\nMIYABI - KOIGASAKI\n\n<size=45>敵Ⅰ</size>\n<size=35>～黎明編～</size>"},
        { "location": "51/TALK"   , "narrator": "潜在みやび", "text": "ようこそ\nすとれんじゃー。"},
        { "location": "52/TALK"   , "narrator": "表層みやび", "text": "ようこそ\nあうぇい。"},
        { "location": "53/SEL"    , "narrator": "（選択肢）", "text": "こんにちは"},
        { "location": "54/ACT"    , "narrator": "", "text": "こんにちは"},
        { "location": "57/TALK"   , "narrator": "潜在みやび", "text": "いや、今は\n「おはよう」やき。"},
        { "location": "58/TALK"   , "narrator": "表層みやび", "text": "いやいや、今は\n「こんばんは」やね。"},
        { "location": "59/TALK"   , "narrator": "潜在みやび", "text": "それはそうと。"},
        { "location": "60/TALK"   , "narrator": "表層みやび", "text": "なんぞ用かね？"},
        { "location": "61/SEL"    , "narrator": "（選択肢）", "text": "単刀直入に言うと、みやびのココロを支えに来ました"},
        { "location": "62/ACT"    , "narrator": "", "text": "単刀直入に言うと、みやびのココロを支えに来ました"},
        { "location": "64/TALK"   , "narrator": "潜在みやび", "text": "ココロを支える！\nなんぞ、そんなこと\nせんでも。"},
        { "location": "65/TALK"   , "narrator": "表層みやび", "text": "うちのココロは\n強力接着剤でバッチ\n固定されちゅうよ？"},
        { "location": "66/SEL"    , "narrator": "（選択肢）", "text": "（）"},
        { "location": "67/SEL"    , "narrator": "（選択肢）", "text": "帰ります"},
        { "location": "69/TALK"   , "narrator": "潜在みやび", "text": "反応に\n困っちょるね。"},
        { "location": "71/TALK"   , "narrator": "表層みやび", "text": "ふむ。\n案外ちょろいな。"},
        { "location": "72/ACT"    , "narrator": "", "text": "帰ります"},
        { "location": "73/TALK"   , "narrator": "潜在みやび", "text": "いやいや、\nもう少しくつろいで\nいきや。"},
        { "location": "74/TALK"   , "narrator": "表層みやび", "text": "まだ何も\n話しちょらんきね。"},
        { "location": "76/SEL"    , "narrator": "（選択肢）", "text": "二人は仲良しなの？それとも対立中？"},
        { "location": "77/ACT"    , "narrator": "", "text": "二人は仲良しなの？それとも対立中？"},
        { "location": "79/TALK"   , "narrator": "潜在みやび", "text": "ふむ。"},
        { "location": "80/TALK"   , "narrator": "表層みやび", "text": "いい質問やね。"},
        { "location": "81/TALK"   , "narrator": "潜在みやび", "text": "もちろんうちらは\n全く意見が合わん。"},
        { "location": "82/TALK"   , "narrator": "表層みやび", "text": "正直、今すぐにでも\n消してやりたいぞね。"},
        { "location": "83/TALK"   , "narrator": "潜在みやび", "text": "けんどな、なんで人間\nがここまで繁殖できた\nかしっちゅうか？"},
        { "location": "84/TALK"   , "narrator": "表層みやび", "text": "それは、より強烈な\n敵が出よった時には\n結託するからやね。"},
        { "location": "85/SEL"    , "narrator": "（選択肢）", "text": "敵って、もしかして……"},
        { "location": "86/ACT"    , "narrator": "", "text": "敵って、もしかして……"},
        { "location": "90/TALK"   , "narrator": "潜在みやび", "text": "まあ、あんたが敵とは\nいえ、うちかコイツの\nどっちかは――"},
        { "location": "91/TALK"   , "narrator": "表層みやび", "text": "あんたを味方に付けて\n戦いたいと思っちゅう。"},
        { "location": "92/TALK"   , "narrator": "潜在みやび", "text": "当然ソイツは、\nうちのココロを支えて\n欲しいちゃんや。"},
        { "location": "93/TALK"   , "narrator": "表層みやび", "text": "さて、問題や。\nどっちやと思う？"},
        { "location": "94/SEL"    , "narrator": "（選択肢）", "text": "伊号ちゃん"},
        { "location": "95/SEL"    , "narrator": "（選択肢）", "text": "呂号ちゃん"},
        { "location": "96/SEL"    , "narrator": "（選択肢）", "text": "だめ。この中にはいないよ！"},
        { "location": "97/ACT"    , "narrator": "", "text": "伊号ちゃん"},
        { "location": "98/TALK"   , "narrator": "表層みやび", "text": "なるほど、\nそれがアンタの答えか。"},
        { "location": "99/ACT"    , "narrator": "", "text": "呂号ちゃん"},
        { "location": "100/TALK"  , "narrator": "潜在みやび", "text": "なるほど、\nそれがアンタの答えか。"},
        { "location": "101/ACT"   , "narrator": "", "text": "だめ。この中にはいないよ！"},
        { "location": "107/DIALOG", "narrator": "", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"},
        { "location": "111/TALK"  , "narrator": "表層みやび", "text": "いない？\nそれがアンタの答えか。"},
        { "location": "112/SEL"   , "narrator": "（選択肢）", "text": "うん！"},
        { "location": "113/ACT"   , "narrator": "", "text": "うん！"},
        { "location": "116/TALK"  , "narrator": "表層みやび", "text": "ひっ！！"},
        { "location": "117/TALK"  , "narrator": "潜在みやび", "text": "大当た～～り～～！"},
        { "location": "118/TALK"  , "narrator": "表層みやび", "text": "…なわけないぞね。"},
        { "location": "120/TALK"  , "narrator": "表層みやび", "text": "まあ、こんなことして\n遊んでる暇は無いぞね。"},
        { "location": "121/TALK"  , "narrator": "潜在みやび", "text": "うむ。決着は早急に\nつけねばいかんきね。"},
        { "location": "122/SEL"   , "narrator": "（選択肢）", "text": "全然ワケ分からないんですけど"},
        { "location": "123/ACT"   , "narrator": "", "text": "全然ワケ分からないんですけど"},
        { "location": "125/TALK"  , "narrator": "表層みやび", "text": "当たり前よや。"},
        { "location": "126/TALK"  , "narrator": "潜在みやび", "text": "意図的に\nやっちょるきね。"},
        { "location": "127/TALK"  , "narrator": "表層みやび", "text": "まあこうやって\nアンタのやる気を\n削げば……"},
        { "location": "128/TALK"  , "narrator": "潜在みやび", "text": "うちは大助かりや。"},
        { "location": "129/TALK"  , "narrator": "表層みやび", "text": "とか言ってるコイツは\nフェイクやきね。\n大助かりはうちや。"},
        { "location": "130/TALK"  , "narrator": "潜在みやび", "text": "まあ、こんなうちでも\n力貸してくれるゆう\nなら、戦い参加してや。"},
        { "location": "131/TALK"  , "narrator": "表層みやび", "text": "参加してくれるなら\nうちは大助かりやね。"},
        { "location": "132/TALK"  , "narrator": "潜在みやび", "text": "いや、それはうちや。"},
        { "location": "133/SEL"   , "narrator": "（選択肢）", "text": "そのままの格好で戦うの？"},
        { "location": "134/ACT"   , "narrator": "", "text": "そのままの格好で戦うの？"},
        { "location": "136/TALK"  , "narrator": "表層みやび", "text": "まさか。"},
        { "location": "137/TALK"  , "narrator": "潜在みやび", "text": "アンタの見えない所で\nひとりは着替えて――"},
        { "location": "138/TALK"  , "narrator": "表層みやび", "text": "もう一人は\n[クラン]を吐き出すぞね。"},
        { "location": "139/TALK"  , "narrator": "潜在みやび", "text": "まあ、そんな感じや\nけんど、気が向いたら\n戦いに参加しいや。"},
        { "location": "140/SEL"   , "narrator": "（選択肢）", "text": "望むところだ！"},
        { "location": "141/SEL"   , "narrator": "（選択肢）", "text": "遠慮します"},
        { "location": "142/ACT"   , "narrator": "", "text": "望むところ"},
        { "location": "143/TALK"  , "narrator": "表層みやび", "text": "ふむ。\n物好きなやつも\nいたものやね。"},
        { "location": "144/TALK"  , "narrator": "潜在みやび", "text": "それにしてもあれやね、\nノリノリなアンタに\n内心焦っちょるに――"},
        { "location": "145/ACT"   , "narrator": "", "text": "遠慮します"},
        { "location": "151/DIALOG", "narrator": "", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"},
        { "location": "155/TALK"  , "narrator": "表層みやび", "text": "ふむ。\nまともな人間やね。"},
        { "location": "156/TALK"  , "narrator": "潜在みやび", "text": "こんなワケワカらん\n乙女の戦争に、首を\n突っ込まんわけやしね。"},
        { "location": "157/TALK"  , "narrator": "表層みやび", "text": "だがしかし！"},
        { "location": "158/TALK"  , "narrator": "潜在みやび", "text": "駄菓子菓子！"},
        { "location": "159/TALK"  , "narrator": "表層みやび", "text": "アンタはすでに\n戦いの渦に巻き\n込まれているちや！"},
        { "location": "160/TALK"  , "narrator": "潜在みやび", "text": "残念やけど、\n運命は変えられんきね。"},
        { "location": "161/SEL"   , "narrator": "（選択肢）", "text": "え！？！？"},
        { "location": "162/ACT"   , "narrator": "", "text": "え！？！？"},
        { "location": "164/TALK"  , "narrator": "表層みやび", "text": "要するに、\nうちらの戦闘への\n参加は――"},
        { "location": "165/TALK"  , "narrator": "潜在みやび", "text": "生まれついたときから\n決まっていた、アンタ\nの定めやったきね。"},
        { "location": "166/SEL"   , "narrator": "（選択肢）", "text": "出来レースかよ"},
        { "location": "167/ACT"   , "narrator": "", "text": "出来レースかよ"},
        { "location": "169/TALK"  , "narrator": "表層みやび", "text": "それにしても、\nそんな過酷な定めが\n降りかかっていても―"},
        { "location": "171/TALK"  , "narrator": "潜在みやび", "text": "ハードボイルド決めて\n余裕かましてるうちは\n主演女優賞ものやね。"},
        { "location": "172/TALK"  , "narrator": "表層みやび", "text": "あっ、それってつまり、\nあんたが頑固系みやび\nさんってことか！"},
        { "location": "173/TALK"  , "narrator": "表層みやび", "text": "てっきりうちやと\n思っちょったが！\nここへ来て新発見が！"},
        { "location": "175/TALK"  , "narrator": "潜在みやび", "text": "えっ！\nあんたやったんか！\nうちもビックリや！"},
        { "location": "176/SEL"   , "narrator": "（選択肢）", "text": "もういいからバトルしませんか？"},
        { "location": "177/ACT"   , "narrator": "", "text": "もういいからバトルしませんか？"},
        { "location": "179/TALK"  , "narrator": "潜在みやび", "text": "うむ。\nいいツッコミやね。"},
        { "location": "180/TALK"  , "narrator": "表層みやび", "text": "このままいつまで\nボケ倒し続けるのか\nひやひやしてたぞね。"},
        { "location": "181/TALK"  , "narrator": "潜在みやび", "text": "ほいたら一丁\n本気でやり合いますか。"},
        { "location": "182/TALK"  , "narrator": "表層みやび", "text": "うちかアンタ、\nどっちかは内心\nビビっちょるがよな。"},
        { "location": "183/TALK"  , "narrator": "潜在みやび", "text": "うむ。\n自分でもどっちなのか\n全くわからんぞね。"},
        { "location": "184/TALK"  , "narrator": "表層みやび", "text": "さあ、覚悟を決めて\n行くちや！"},
        { "location": "185/TALK"  , "narrator": "潜在みやび", "text": "行くぞね！！"},
        { "location": "197/DIALOG", "narrator": "", "text": "<color=black><size=50><b>貴方を混乱させる\nみやび達を駆逐せよ！</b></size></color>\n\n\n\n貴方のことを不要だと言い、\n混乱させつつも排斥しようとするみやび。\n\nしかしそれは、本人すらも良く解っていない\n己の混乱故に出来上がった世界なのだ。\n\n自身がみやびのココロスフィアにいられるように、\nそしてみやびのココロの安定のために、\nこの戦いをくぐり抜けよう。"}
    ]
}
