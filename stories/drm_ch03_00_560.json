        { "location": "7/SCENARIO", "narrator": "", "text": "580_花言葉"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "パンジーの花言葉"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "紫色なら「貴方のことで頭がいっぱい」"},
        { "location": "34/TALK"   , "narrator": "ガブリエラ", "text": "黄色なら「思い出」"},
        { "location": "35/TALK"   , "narrator": "ガブリエラ", "text": "白色だったら「愛という思い」"},
        { "location": "37/TALK"   , "narrator": "ガブリエラ", "text": "それからね"},
        { "location": "39/SEL"    , "narrator": "", "text": "まだあるの"},
        { "location": "40/SEL"    , "narrator": "", "text": "当ててみようか"},
        { "location": "41/ACT"    , "narrator": "", "text": "まだあるの"},
        { "location": "42/TALK"   , "narrator": "ガブリエラ", "text": "あるに決まってるじゃないの"},
        { "location": "43/ACT"    , "narrator": "", "text": "当ててみようか"},
        { "location": "53/TALK"   , "narrator": "ガブリエラ", "text": "あら"},
        { "location": "54/TALK"   , "narrator": "ガブリエラ", "text": "貴方にできるかしら？"},
        { "location": "55/TALK"   , "narrator": "ガブリエラ", "text": "できるものならおやりなさいな"},
        { "location": "58/SEL"    , "narrator": "", "text": "ヒント出して"},
        { "location": "59/ACT"    , "narrator": "", "text": "ヒント出して"},
        { "location": "60/TALK"   , "narrator": "ガブリエラ", "text": "もう"},
        { "location": "61/TALK"   , "narrator": "ガブリエラ", "text": "きたいしちゃったじゃないの・・・"},
        { "location": "64/TALK"   , "narrator": "ガブリエラ", "text": "いいこと？"},
        { "location": "65/TALK"   , "narrator": "ガブリエラ", "text": "花言葉にはね"},
        { "location": "66/TALK"   , "narrator": "ガブリエラ", "text": "色ごとの花言葉と"},
        { "location": "67/TALK"   , "narrator": "ガブリエラ", "text": "花全部を指す花言葉があるの"},
        { "location": "69/SEL"    , "narrator": "", "text": "あっそう"},
        { "location": "70/SEL"    , "narrator": "", "text": "よく知ってるね"},
        { "location": "71/ACT"    , "narrator": "", "text": "あっそう"},
        { "location": "72/TALK"   , "narrator": "ガブリエラ", "text": "もう"},
        { "location": "73/TALK"   , "narrator": "ガブリエラ", "text": "すごく重要なお話よ？"},
        { "location": "74/ACT"    , "narrator": "", "text": "よく知ってるね"},
        { "location": "75/TALK"   , "narrator": "ガブリエラ", "text": "そうかしら？"},
        { "location": "76/TALK"   , "narrator": "ガブリエラ", "text": "乙女の常識よ？"},
        { "location": "78/TALK"   , "narrator": "ガブリエラ", "text": "それでね"},
        { "location": "80/TALK"   , "narrator": "ガブリエラ", "text": "パンジーの花言葉は"},
        { "location": "84/SEL"    , "narrator": "", "text": "どうしたの"},
        { "location": "85/SEL"    , "narrator": "", "text": "何かあった？"},
        { "location": "86/ACT"    , "narrator": "", "text": "どうしたの"},
        { "location": "87/ACT"    , "narrator": "", "text": "何かあった？"},
        { "location": "90/TALK"   , "narrator": "ガブリエラ", "text": "その前に"},
        { "location": "91/TALK"   , "narrator": "ガブリエラ", "text": "パンジーはポーランドの花なの"},
        { "location": "92/TALK"   , "narrator": "ガブリエラ", "text": "そのことを知っているのかしら？"},
        { "location": "94/SEL"    , "narrator": "", "text": "知ってた"},
        { "location": "95/SEL"    , "narrator": "", "text": "知らなかった"},
        { "location": "96/ACT"    , "narrator": "", "text": "知ってた"},
        { "location": "97/ACT"    , "narrator": "", "text": "知らなかった"},
        { "location": "99/TALK"   , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "100/TALK"  , "narrator": "ガブリエラ", "text": "じゃあ花言葉を言うわね"},
        { "location": "102/TALK"  , "narrator": "ガブリエラ", "text": "私を思って"},
        { "location": "104/TALK"  , "narrator": "ガブリエラ", "text": "そういうことなのよ"},
        { "location": "106/TALK"  , "narrator": "ガブリエラ", "text": "じゃあ"},
        { "location": "107/TALK"  , "narrator": "ガブリエラ", "text": "そういうことだから！！！！！！"},
        { "location": "49/DIALOG" , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>1000pt.</b></color></size>\nアップしました！"}
