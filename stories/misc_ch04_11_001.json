    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "013_総天然肉球の魅力"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "時に$handle$よ"},
        { "location": "33/TALK"   , "narrator": "みやび", "text": "肉球は天然と人工のどちらが好きかね"},
        { "location": "35/SEL"    , "narrator": "", "text": "質問の意味がわかりません"},
        { "location": "36/SEL"    , "narrator": "", "text": "やっぱり天然かな"},
        { "location": "37/SEL"    , "narrator": "", "text": "肉球は全て素晴らしい"},
        { "location": "39/TALK"   , "narrator": "みやび", "text": "にくきゅうだぞ？"},
        { "location": "46/ACT"    , "narrator": "", "text": "質問の意味がわかりません"},
        { "location": "47/TALK"   , "narrator": "みやび", "text": "なんと"},
        { "location": "48/ACT"    , "narrator": "", "text": "やっぱり天然かな"},
        { "location": "49/TALK"   , "narrator": "みやび", "text": "天然原理主義者め"},
        { "location": "50/ACT"    , "narrator": "", "text": "肉球は全て素晴らしい"},
        { "location": "52/TALK"   , "narrator": "みやび", "text": "また分かった風な口を"},
        { "location": "53/TALK"   , "narrator": "みやび", "text": "まあ"},
        { "location": "54/TALK"   , "narrator": "みやび", "text": "その通りだが"},
        { "location": "56/TALK"   , "narrator": "みやび", "text": "そして皆に肉球を付けるとすれば"},
        { "location": "57/TALK"   , "narrator": "みやび", "text": "それは天然か人工か？"},
        { "location": "58/SEL"    , "narrator": "", "text": "だから何の話？"},
        { "location": "59/SEL"    , "narrator": "", "text": "後付けだから人工かな"},
        { "location": "60/SEL"    , "narrator": "", "text": "天然！　天然！　天然！"},
        { "location": "62/TALK"   , "narrator": "みやび", "text": "こんな簡単なこともわからんのか？"},
        { "location": "69/ACT"    , "narrator": "", "text": "だから何の話？"},
        { "location": "70/TALK"   , "narrator": "みやび", "text": "即ち"},
        { "location": "71/TALK"   , "narrator": "みやび", "text": "肉球の話ぞね"},
        { "location": "72/ACT"    , "narrator": "", "text": "後付けだから人工かな"},
        { "location": "73/TALK"   , "narrator": "みやび", "text": "ふむ"},
        { "location": "74/TALK"   , "narrator": "みやび", "text": "ご名答"},
        { "location": "75/TALK"   , "narrator": "みやび", "text": "正しすぎてつまらんちや"},
        { "location": "76/ACT"    , "narrator": "", "text": "天然！　天然！　天然！"},
        { "location": "77/TALK"   , "narrator": "みやび", "text": "熱意は受け取った"},
        { "location": "79/TALK"   , "narrator": "みやび", "text": "要は"},
        { "location": "80/TALK"   , "narrator": "みやび", "text": "秋葉原には肉球を纏う女子が接待する店があると聞く"},
        { "location": "81/TALK"   , "narrator": "みやび", "text": "$handle$の見解を述べよ"},
        { "location": "82/SEL"    , "narrator": "", "text": "みやびがするならなんでもいい"},
        { "location": "83/SEL"    , "narrator": "", "text": "興味ない"},
        { "location": "84/SEL"    , "narrator": "", "text": "肉球最高！！！！！"},
        { "location": "85/TALK"   , "narrator": "みやび", "text": "ということだ"},
        { "location": "86/ACT"    , "narrator": "", "text": "みやびがするならなんでもいい"},
        { "location": "88/TALK"   , "narrator": "みやび", "text": "なんでもいいとは"},
        { "location": "89/TALK"   , "narrator": "みやび", "text": "わらわが聞いておるのは"},
        { "location": "90/TALK"   , "narrator": "みやび", "text": "にくきゅうだぞ？"},
        { "location": "91/TALK"   , "narrator": "みやび", "text": "それを何でもいいとは"},
        { "location": "92/TALK"   , "narrator": "みやび", "text": "なんなんだ！"},
        { "location": "93/ACT"    , "narrator": "", "text": "興味ない"},
        { "location": "94/TALK"   , "narrator": "みやび", "text": "なるほど"},
        { "location": "95/TALK"   , "narrator": "みやび", "text": "クールジャパン、かっこ悪いということか"},
        { "location": "96/ACT"    , "narrator": "", "text": "肉球最高！！！！！"},
        { "location": "97/TALK"   , "narrator": "みやび", "text": "うわ"},
        { "location": "98/TALK"   , "narrator": "みやび", "text": "本気も本気ぞね"},
        { "location": "100/TALK"  , "narrator": "みやび", "text": "とりあえず"},
        { "location": "101/TALK"  , "narrator": "みやび", "text": "$handle$の肉球にかける思い"},
        { "location": "102/TALK"  , "narrator": "みやび", "text": "受け取ったぞね"}
    ]
}
