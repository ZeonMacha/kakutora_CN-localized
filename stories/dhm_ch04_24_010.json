    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "三分間の"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "うさぎに三分間モードを"},
        { "location": "33/TALK"   , "narrator": "みやび", "text": "見せてしまったぞね"},
        { "location": "34/TALK"   , "narrator": "みやび", "text": "しかもデートスポットの観覧車の中で"},
        { "location": "36/SEL"    , "narrator": "", "text": "そうだね"},
        { "location": "37/SEL"    , "narrator": "", "text": "別に羨ましくないし"},
        { "location": "38/SEL"    , "narrator": "", "text": "$me$だけの秘密だったのに"},
        { "location": "39/ACT"    , "narrator": "", "text": "そうだね"},
        { "location": "40/TALK"   , "narrator": "みやび", "text": "うむ"},
        { "location": "42/TALK"   , "narrator": "みやび", "text": "やってしもうた"},
        { "location": "43/ACT"    , "narrator": "", "text": "別に羨ましくないし"},
        { "location": "44/TALK"   , "narrator": "みやび", "text": "そうであろう"},
        { "location": "45/TALK"   , "narrator": "みやび", "text": "$handle$にはいつも"},
        { "location": "46/TALK"   , "narrator": "みやび", "text": "見せまくっておるきね"},
        { "location": "47/ACT"    , "narrator": "", "text": "$me$だけの秘密だったのに"},
        { "location": "48/TALK"   , "narrator": "みやび", "text": "$handle$とうちには"},
        { "location": "49/TALK"   , "narrator": "みやび", "text": "もっとたくさん"},
        { "location": "50/TALK"   , "narrator": "みやび", "text": "秘密があろうがね"},
        { "location": "52/TALK"   , "narrator": "みやび", "text": "正直な話"},
        { "location": "53/TALK"   , "narrator": "みやび", "text": "この先うちがどうなるかはわからん"},
        { "location": "54/TALK"   , "narrator": "みやび", "text": "後悔先に立たずで"},
        { "location": "55/TALK"   , "narrator": "みやび", "text": "うさぎに言い残したのだ"},
        { "location": "57/SEL"    , "narrator": "", "text": "遺言みたいだよ？"},
        { "location": "58/SEL"    , "narrator": "", "text": "繭も喜んでた"},
        { "location": "59/SEL"    , "narrator": "", "text": "$me$には何もなし？"},
        { "location": "60/ACT"    , "narrator": "", "text": "遺言みたいだよ？"},
        { "location": "61/TALK"   , "narrator": "みやび", "text": "かもしれんね"},
        { "location": "62/TALK"   , "narrator": "みやび", "text": "でも"},
        { "location": "63/TALK"   , "narrator": "みやび", "text": "死ぬ気はないぞ"},
        { "location": "64/TALK"   , "narrator": "みやび", "text": "安心せい$handle$"},
        { "location": "67/TALK"   , "narrator": "みやび", "text": "それとうちの相棒は"},
        { "location": "69/TALK"   , "narrator": "みやび", "text": "$handle$だけぞね"},
        { "location": "70/TALK"   , "narrator": "みやび", "text": "安心しとけ"},
        { "location": "71/ACT"    , "narrator": "", "text": "繭も喜んでた"},
        { "location": "72/TALK"   , "narrator": "みやび", "text": "うむ"},
        { "location": "73/TALK"   , "narrator": "みやび", "text": "引かれるかと心配しとったが"},
        { "location": "74/TALK"   , "narrator": "みやび", "text": "杞憂だった"},
        { "location": "75/TALK"   , "narrator": "みやび", "text": "うちも安心できたし"},
        { "location": "76/TALK"   , "narrator": "みやび", "text": "うさぎもそうだったぞね"},
        { "location": "79/TALK"   , "narrator": "みやび", "text": "あ"},
        { "location": "80/TALK"   , "narrator": "みやび", "text": "これはいわゆるハッカーの仲間意識とかその類い"},
        { "location": "81/TALK"   , "narrator": "みやび", "text": "相棒として認めておるのは"},
        { "location": "82/TALK"   , "narrator": "みやび", "text": "$handle$だけぞね"},
        { "location": "83/ACT"    , "narrator": "", "text": "$me$には何もなし？"},
        { "location": "85/TALK"   , "narrator": "みやび", "text": "ぬ"},
        { "location": "86/TALK"   , "narrator": "みやび", "text": "欲しいのか"},
        { "location": "88/SEL"    , "narrator": "", "text": "当たり前でしょ！"},
        { "location": "89/SEL"    , "narrator": "", "text": "いいからください"},
        { "location": "90/SEL"    , "narrator": "", "text": "何もないの…？"},
        { "location": "91/ACT"    , "narrator": "", "text": "当たり前でしょ！"},
        { "location": "92/TALK"   , "narrator": "みやび", "text": "そうか"},
        { "location": "93/ACT"    , "narrator": "", "text": "いいからください"},
        { "location": "94/TALK"   , "narrator": "みやび", "text": "ううむ"},
        { "location": "95/ACT"    , "narrator": "", "text": "何もないの…？"},
        { "location": "96/TALK"   , "narrator": "みやび", "text": "ないというか"},
        { "location": "98/TALK"   , "narrator": "みやび", "text": "その"},
        { "location": "99/TALK"   , "narrator": "みやび", "text": "なんだ"},
        { "location": "101/TALK"  , "narrator": "みやび", "text": "$handle$とは常に一緒におる"},
        { "location": "102/TALK"  , "narrator": "みやび", "text": "生活の一部のようなもの"},
        { "location": "103/TALK"  , "narrator": "みやび", "text": "やき"},
        { "location": "104/TALK"  , "narrator": "みやび", "text": "特別な何かというのは"},
        { "location": "106/SEL"   , "narrator": "", "text": "でも欲しいんだもん！"},
        { "location": "107/SEL"   , "narrator": "", "text": "ごまかそうとしてない？"},
        { "location": "108/SEL"   , "narrator": "", "text": "…まあ仕方ないか…"},
        { "location": "109/ACT"   , "narrator": "", "text": "でも欲しいんだもん！"},
        { "location": "110/TALK"  , "narrator": "みやび", "text": "そう言われても"},
        { "location": "111/ACT"   , "narrator": "", "text": "ごまかそうとしてない？"},
        { "location": "112/TALK"  , "narrator": "みやび", "text": "本心やき"},
        { "location": "113/ACT"   , "narrator": "", "text": "…まあ仕方ないか…"},
        { "location": "114/TALK"  , "narrator": "みやび", "text": "納得してくれたかね"},
        { "location": "116/TALK"  , "narrator": "みやび", "text": "それにしても$handle$"},
        { "location": "117/TALK"  , "narrator": "みやび", "text": "貴殿は意外と"},
        { "location": "118/TALK"  , "narrator": "みやび", "text": "やきもち妬きぞね"},
        { "location": "120/SEL"   , "narrator": "", "text": "違うし"},
        { "location": "121/SEL"   , "narrator": "", "text": "その通りだ！"},
        { "location": "122/SEL"   , "narrator": "", "text": "みやび相手だとそうなるよ…"},
        { "location": "123/ACT"   , "narrator": "", "text": "違うし"},
        { "location": "124/TALK"  , "narrator": "みやび", "text": "意地を張るのも"},
        { "location": "126/TALK"  , "narrator": "みやび", "text": "そそるねえ"},
        { "location": "127/ACT"   , "narrator": "", "text": "その通りだ！"},
        { "location": "128/TALK"  , "narrator": "みやび", "text": "居直りか"},
        { "location": "130/TALK"  , "narrator": "みやび", "text": "かわいいやつめ"},
        { "location": "131/ACT"   , "narrator": "", "text": "みやび相手だとそうなるよ…"},
        { "location": "132/TALK"  , "narrator": "みやび", "text": "みやびさんの魅力に"},
        { "location": "133/TALK"  , "narrator": "みやび", "text": "メロメロいうことやね"},
        { "location": "135/TALK"  , "narrator": "みやび", "text": "全くもう"},
        { "location": "136/TALK"  , "narrator": "みやび", "text": "うちが一番話す相手は"},
        { "location": "137/TALK"  , "narrator": "みやび", "text": "$handle$ぞね"},
        { "location": "138/TALK"  , "narrator": "みやび", "text": "わからんちんめ"}
    ]
}
