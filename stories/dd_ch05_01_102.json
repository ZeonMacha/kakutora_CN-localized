{
    "dir": "chap01/daydra/dd_ch05_01_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "1504",
        "cid": "kagura",
        "title": "004 メインストーリー",
        "sub_title": "世界線歳差＜後編＞"
    },
    "entry":
    [
        { "location": "709/TALK"  , "narrator": "神楽", "text": "はぁ……\n疲れた。"},
        { "location": "715/TALK"  , "narrator": "神楽", "text": "…音羽から？"},
        { "location": "720/TALK"  , "narrator": "音羽", "text": "今日はありがとう、久し振りに会えて嬉しかった"},
        { "location": "723/TALK"  , "narrator": "神楽", "text": "また遊びに行くから"},
        { "location": "724/TALK"  , "narrator": "神楽", "text": "絶対にライブには来ないでね"},
        { "location": "726/TALK"  , "narrator": "音羽", "text": "わかってる"},
        { "location": "728/TALK"  , "narrator": "音羽", "text": "ねえ、神楽"},
        { "location": "729/TALK"  , "narrator": "音羽", "text": "私にできることがあれば、なんでも言ってね"},
        { "location": "730/TALK"  , "narrator": "神楽", "text": "ありがとう"},
        { "location": "732/TALK"  , "narrator": "音羽", "text": "それとね、神楽"},
        { "location": "734/TALK"  , "narrator": "音羽", "text": "ずっと謝りたかったことがあるの"},
        { "location": "735/TALK"  , "narrator": "神楽", "text": "なに？"},
        { "location": "737/TALK"  , "narrator": "音羽", "text": "本当は会ったときに言うべきだったんだろうけど"},
        { "location": "739/TALK"  , "narrator": "音羽", "text": "すごいドキドキするんだけど"},
        { "location": "741/TALK"  , "narrator": "音羽", "text": "でも、ずっとずっと後悔してたし"},
        { "location": "742/TALK"  , "narrator": "音羽", "text": "ずっとごめんなさいって"},
        { "location": "743/TALK"  , "narrator": "音羽", "text": "思ってたことがあって"},
        { "location": "744/TALK"  , "narrator": "音羽", "text": "言いそびれちゃって"},
        { "location": "745/TALK"  , "narrator": "音羽", "text": "前に神楽が私を頼ってきたとき"},
        { "location": "746/TALK"  , "narrator": "音羽", "text": "私"},
        { "location": "748/TALK"  , "narrator": "音羽", "text": "ちょっとだけ優越感に浸ってた"},
        { "location": "750/TALK"  , "narrator": "音羽", "text": "でも、神楽が色々打ち明けてくれて"},
        { "location": "751/TALK"  , "narrator": "音羽", "text": "それを聞いて自分が嫌で仕方なくなって"},
        { "location": "752/TALK"  , "narrator": "音羽", "text": "それであの時以来合わせる顔も無くて"},
        { "location": "753/TALK"  , "narrator": "音羽", "text": "そうこうしてるうちに、神楽はフランスにいっちゃって"},
        { "location": "754/TALK"  , "narrator": "音羽", "text": "だから"},
        { "location": "755/TALK"  , "narrator": "音羽", "text": "今回は絶対に神楽の力になりたい"},
        { "location": "756/TALK"  , "narrator": "音羽", "text": "何を言っても信じて貰えないかもだけど"},
        { "location": "757/TALK"  , "narrator": "音羽", "text": "でもこの気持ちをどうしても伝えたくて"},
        { "location": "759/TALK"  , "narrator": "神楽", "text": "わかってる"},
        { "location": "760/TALK"  , "narrator": "神楽", "text": "ありがとう"},
        { "location": "763/TALK"  , "narrator": "神楽", "text": "また辛くなったら遊びに行くね"},
        { "location": "776/TALK"  , "narrator": "神楽", "text": "…今のって、なに？"},
        { "location": "777/TALK"  , "narrator": "神楽", "text": "まさか、私のことを\n動揺させるために…。"},
        { "location": "779/TALK"  , "narrator": "神楽", "text": "この世界が用意した\n筋書き、ってこと？"},
        { "location": "791/TALK"  , "narrator": "神楽", "text": "この世界が用意した\n筋書き、ってこと？"},
        { "location": "792/TALK"  , "narrator": "神楽", "text": "…酷すぎる。"},
        { "location": "794/TALK"  , "narrator": "神楽", "text": "私の親友に、こんなウソの\nシナリオと罪悪感を\n思い込ませるなんて…。"},
        { "location": "795/TALK"  , "narrator": "神楽", "text": "逢瀬つばめ…、\nどれだけ狡猾なの？"},
        { "location": "797/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "798/SEL"   , "narrator": "", "text": "つばめは狡猾なんかじゃないよ？"},
        { "location": "799/ACT"   , "narrator": "", "text": "つばめは狡猾なんかじゃないよ？"},
        { "location": "815/TALK"  , "narrator": "神楽", "text": "これは……"},
        { "location": "817/TALK"  , "narrator": "神楽", "text": "これが、ナビ？\n平行世界の…。"},
        { "location": "818/TALK"  , "narrator": "神楽", "text": "確か、$handle$…\nだったっけ…？"},
        { "location": "824/TALK"  , "narrator": "神楽", "text": "はじめまして$handle$さん"},
        { "location": "826/TALK"  , "narrator": "神楽", "text": "$handle$さんは日本語で対話するんですね"},
        { "location": "827/TALK"  , "narrator": "神楽", "text": "日本人なんですか？"},
        { "location": "829/TALK"  , "narrator": "神楽", "text": "こことは違うどこか"},
        { "location": "830/TALK"  , "narrator": "神楽", "text": "遠い世界の"},
        { "location": "832/SEL"   , "narrator": "", "text": "意外と近いかもしれないよ"},
        { "location": "833/SEL"   , "narrator": "", "text": "アイアム日本人？"},
        { "location": "834/SEL"   , "narrator": "", "text": "よく知ってるね"},
        { "location": "835/ACT"   , "narrator": "", "text": "意外と近いかもしれないよ"},
        { "location": "836/TALK"  , "narrator": "神楽", "text": "近いんですか？"},
        { "location": "837/TALK"  , "narrator": "神楽", "text": "でも世界が違う時点で遠いような気がしますけど"},
        { "location": "838/TALK"  , "narrator": "神楽", "text": "そういうものじゃないんですか？"},
        { "location": "840/SEL"   , "narrator": "", "text": "実はよく知らないんだよね"},
        { "location": "841/ACT"   , "narrator": "", "text": "実はよく知らないんだよね"},
        { "location": "844/TALK"  , "narrator": "神楽", "text": "そうなんですか？"},
        { "location": "845/ACT"   , "narrator": "", "text": "アイアム日本人？"},
        { "location": "846/TALK"  , "narrator": "神楽", "text": "質問してるのはこっちですけど"},
        { "location": "847/TALK"  , "narrator": "神楽", "text": "色々とツッコミどころ満載ですよそれ？"},
        { "location": "848/ACT"   , "narrator": "", "text": "よく知ってるね"},
        { "location": "849/TALK"  , "narrator": "神楽", "text": "やっぱり"},
        { "location": "850/TALK"  , "narrator": "神楽", "text": "こちらも事前に教わっていますので"},
        { "location": "852/SEL"   , "narrator": "", "text": "$me$のプライバシーはどこへ？"},
        { "location": "853/SEL"   , "narrator": "", "text": "知ってくれてて嬉しい"},
        { "location": "854/ACT"   , "narrator": "", "text": "$me$のプライバシーはどこへ？"},
        { "location": "855/TALK"  , "narrator": "神楽", "text": "私に聞かれてもそれは困りますけど"},
        { "location": "856/TALK"  , "narrator": "神楽", "text": "気にするほどじゃないと思いますよ？"},
        { "location": "857/TALK"  , "narrator": "神楽", "text": "あなた個人の話は聞いてませんし"},
        { "location": "858/ACT"   , "narrator": "", "text": "知ってくれてて嬉しい"},
        { "location": "859/TALK"  , "narrator": "神楽", "text": "そうなんですか？"},
        { "location": "860/TALK"  , "narrator": "神楽", "text": "よくわからないけど"},
        { "location": "861/TALK"  , "narrator": "神楽", "text": "喜んでもらえているならよかったです"},
        { "location": "864/TALK"  , "narrator": "神楽", "text": "とりあえぞこれから色々とお世話になると思うので"},
        { "location": "865/TALK"  , "narrator": "神楽", "text": "よろしくお願いします"},
        { "location": "867/SEL"   , "narrator": "", "text": "ＯＫ、任せろ！"},
        { "location": "868/SEL"   , "narrator": "", "text": "大船に乗った気でいてくれ！"},
        { "location": "869/ACT"   , "narrator": "", "text": "ＯＫ、任せろ！"},
        { "location": "870/ACT"   , "narrator": "", "text": "大船に乗った気でいてくれ！"},
        { "location": "873/TALK"  , "narrator": "神楽", "text": "あの、本当に、"},
        { "location": "874/TALK"  , "narrator": "神楽", "text": "こことは違う世界の方ですか？"},
        { "location": "876/SEL"   , "narrator": "", "text": "そうだけど、どうして？"},
        { "location": "877/ACT"   , "narrator": "", "text": "そうだけど、どうして？"},
        { "location": "879/TALK"  , "narrator": "神楽", "text": "なんか"},
        { "location": "880/TALK"  , "narrator": "神楽", "text": "想像していたのと違うというか"},
        { "location": "883/TALK"  , "narrator": "神楽", "text": "$handle$さんのことを教えてくれたのって"},
        { "location": "884/TALK"  , "narrator": "神楽", "text": "私の上司に当たる人間や"},
        { "location": "885/TALK"  , "narrator": "神楽", "text": "科学者と呼ばれる方々だったので"},
        { "location": "886/TALK"  , "narrator": "神楽", "text": "失礼ですが"},
        { "location": "887/TALK"  , "narrator": "神楽", "text": "もっととても真面目でユーモアとか持ってない人を想像していました"},
        { "location": "889/SEL"   , "narrator": "", "text": "ごめんねー"},
        { "location": "890/ACT"   , "narrator": "", "text": "ごめんねー"},
        { "location": "893/TALK"  , "narrator": "神楽", "text": "なんか"},
        { "location": "894/TALK"  , "narrator": "神楽", "text": "緩すぎて気が抜けてきました"},
        { "location": "896/SEL"   , "narrator": "", "text": "それはそうと、つばめは狡猾なんかじゃないよ"},
        { "location": "897/ACT"   , "narrator": "", "text": "それはそうと、つばめは狡猾なんかじゃないよ"},
        { "location": "900/TALK"  , "narrator": "神楽", "text": "そうなんですか？"},
        { "location": "901/TALK"  , "narrator": "神楽", "text": "まあいいですけど"},
        { "location": "902/TALK"  , "narrator": "神楽", "text": "それなら"},
        { "location": "903/TALK"  , "narrator": "神楽", "text": "$handle$さんが知っている逢瀬つばめのこと"},
        { "location": "904/TALK"  , "narrator": "神楽", "text": "私にも教えてください"},
        { "location": "905/TALK"  , "narrator": "神楽", "text": "事前に知っておいた方が"},
        { "location": "906/TALK"  , "narrator": "神楽", "text": "優位に立てると思うので"},
        { "location": "908/SEL"   , "narrator": "", "text": "つばめはドジっ子だよ"},
        { "location": "909/SEL"   , "narrator": "", "text": "つばめはメノウファンだよ"},
        { "location": "910/SEL"   , "narrator": "", "text": "つばめは優しい子だよ"},
        { "location": "911/ACT"   , "narrator": "", "text": "つばめはドジっ子だよ"},
        { "location": "912/TALK"  , "narrator": "神楽", "text": "なんですかそれ？"},
        { "location": "913/TALK"  , "narrator": "神楽", "text": "真面目に聞いてるんだから"},
        { "location": "914/TALK"  , "narrator": "神楽", "text": "真面目に答えてください"},
        { "location": "916/SEL"   , "narrator": "", "text": "本当のことだよ？"},
        { "location": "917/ACT"   , "narrator": "", "text": "本当のことだよ？"},
        { "location": "920/TALK"  , "narrator": "神楽", "text": "わかりましたもういいです"},
        { "location": "921/ACT"   , "narrator": "", "text": "つばめはメノウファンだよ"},
        { "location": "922/TALK"  , "narrator": "神楽", "text": "それは知ってます"},
        { "location": "923/TALK"  , "narrator": "神楽", "text": "だからこそ私がここにいるんです"},
        { "location": "924/TALK"  , "narrator": "神楽", "text": "他にもっとないんですか？"},
        { "location": "925/TALK"  , "narrator": "神楽", "text": "私の任務が上手くいくような情報は？"},
        { "location": "927/SEL"   , "narrator": "", "text": "構え過ぎないで大丈夫だと思うけど？"},
        { "location": "928/ACT"   , "narrator": "", "text": "構え過ぎないで大丈夫だと思うけど？"},
        { "location": "930/TALK"  , "narrator": "神楽", "text": "時間の無駄でした"},
        { "location": "931/TALK"  , "narrator": "神楽", "text": "もういいです"},
        { "location": "932/ACT"   , "narrator": "", "text": "つばめは優しい子だよ"},
        { "location": "934/TALK"  , "narrator": "神楽", "text": "は？"},
        { "location": "935/TALK"  , "narrator": "神楽", "text": "それって冗談？"},
        { "location": "936/TALK"  , "narrator": "神楽", "text": "全然面白くないんですけど？"},
        { "location": "938/SEL"   , "narrator": "", "text": "事実なんだけど"},
        { "location": "939/ACT"   , "narrator": "", "text": "事実なんだけど"},
        { "location": "941/TALK"  , "narrator": "神楽", "text": "それ以上ふざけたこと言わないでもらえます？"},
        { "location": "942/TALK"  , "narrator": "神楽", "text": "殺しますよ？"},
        { "location": "956/TALK"  , "narrator": "神楽", "text": "…役立たず。\n期待しすぎたかしら？"},
        { "location": "957/TALK"  , "narrator": "神楽", "text": "まあ、いいわ。\n私は歌うだけなんだから…。"},
        { "location": "959/TALK"  , "narrator": "神楽", "text": "正直こんな歌、\n歌うのも嫌だけど…。"},
        { "location": "960/TALK"  , "narrator": "神楽", "text": "逢瀬つばめを\n壊すためだもの。\n喜んで歌ってやる。"},
        { "location": "961/TALK"  , "narrator": "神楽", "text": "たった一度だけの、\n貴方だけの歌を…。"},
        { "location": "963/TALK"  , "narrator": "神楽", "text": "この歌は、\n貴方にあげます。"},
        { "location": "964/TALK"  , "narrator": "神楽", "text": "地獄まで持って行って、\n永遠に苦しめばいい、\n逢瀬つばめ。"},
        { "location": "969/TALK"  , "narrator": "神楽", "text": "…今度はなによ？"},
        { "location": "981/TALK"  , "narrator": "SAKI@USS", "text": "お疲れ様ですメノウさん。ＵＳＳの早希です"},
        { "location": "983/TALK"  , "narrator": "SAKI@USS", "text": "本日はお忙しい中のＭｔｇありがとうございました"},
        { "location": "984/TALK"  , "narrator": "SAKI@USS", "text": "早速ではございますが、本日の打ち合わせの内容についてリマインダをさせていただきます"},
        { "location": "985/TALK"  , "narrator": "SAKI@USS", "text": "4/2 全体リハ（通し1回目）\n4/5 物販委託リステル様打ち合わせ14:00～\n4/5 演出打ち16:00～"},
        { "location": "986/TALK"  , "narrator": "SAKI@USS", "text": "4/9 語り打ち（音効：尼崎）26:00～\n4/10 全体リハ（通し2回目）\n4/12 機材Mtg（場所：USSフォルテ）\n4/15 奏者様最終Mtg18:00～"},
        { "location": "987/TALK"  , "narrator": "SAKI@USS", "text": "4/20 最終調整リハ（通し3回目）\n4/23 Voチェック15:00～\n4/27 直前取材11:00～/15:00～/19:00～"},
        { "location": "988/TALK"  , "narrator": "SAKI@USS", "text": "5/1 最終全体チェック4:00～ / 21:00～\n5/2 前日リハ8:00～\n5/3 ゲネプロ・本公演"},
        { "location": "989/TALK"  , "narrator": "SAKI@USS", "text": "取り急ぎは4/2の全体リハ宜しくお願い申し上げます"},
        { "location": "990/TALK"  , "narrator": "SAKI@USS", "text": "開始は朝7時と早いです。前日の体調管理には十分お気をつけ下さい"},
        { "location": "991/TALK"  , "narrator": "SAKI@USS", "text": "それでは、用件のみですが失礼致します。"},
        { "location": "993/TALK"  , "narrator": "神楽", "text": "お疲れ様でした。よろしくお願いします"},
        { "location": "1004/TALK" , "narrator": "神楽", "text": "はぁぁぁぁ～…。"},
        { "location": "1005/TALK" , "narrator": "神楽", "text": "どうせウソの世界なのに、\nどうしてこんなことまで\nしなきゃならないの？"},
        { "location": "1006/TALK" , "narrator": "神楽", "text": "っていうか、こんな細かい\nところまでリアリティに\nする必要あるわけ？"},
        { "location": "1007/TALK" , "narrator": "神楽", "text": "フェノメノンなんだから、\nぶっつけ本番でも\n問題ないんじゃ――"},
        { "location": "1009/TALK" , "narrator": "神楽", "text": "――リアリティ。"},
        { "location": "1010/TALK" , "narrator": "神楽", "text": "そう、この世界は\nある意味においての\n本物…。"},
        { "location": "1022/TALK" , "narrator": "神楽", "text": "質問があります"},
        { "location": "1023/TALK" , "narrator": "神楽", "text": "私のいるこの日本は"},
        { "location": "1024/TALK" , "narrator": "神楽", "text": "貴方の世界が作っている"},
        { "location": "1025/TALK" , "narrator": "神楽", "text": "そうですよね？"},
        { "location": "1027/SEL"  , "narrator": "", "text": "よく知ってるね！"},
        { "location": "1028/SEL"  , "narrator": "", "text": "そうだったの！？"},
        { "location": "1029/ACT"  , "narrator": "", "text": "よく知ってるね！"},
        { "location": "1030/TALK" , "narrator": "神楽", "text": "一応色々教えられてはいますから"},
        { "location": "1031/TALK" , "narrator": "神楽", "text": "さすがに右も左もわからない状態で"},
        { "location": "1032/TALK" , "narrator": "神楽", "text": "こんなところへ来ません"},
        { "location": "1033/ACT"  , "narrator": "", "text": "そうだったの！？"},
        { "location": "1034/TALK" , "narrator": "神楽", "text": "私はそう教えられましたけど"},
        { "location": "1035/TALK" , "narrator": "神楽", "text": "貴方は教えてもらってないの？"},
        { "location": "1036/TALK" , "narrator": "神楽", "text": "まあいいですけど"},
        { "location": "1038/TALK" , "narrator": "神楽", "text": "だからこの世界には"},
        { "location": "1039/TALK" , "narrator": "神楽", "text": "私の今いる日本には"},
        { "location": "1040/TALK" , "narrator": "神楽", "text": "私の知識には存在しないものも沢山あります"},
        { "location": "1041/TALK" , "narrator": "神楽", "text": "貴方の存在は"},
        { "location": "1042/TALK" , "narrator": "神楽", "text": "そういったことを教えてくれるのでしょうか？"},
        { "location": "1044/SEL"  , "narrator": "", "text": "もちろんだよ"},
        { "location": "1045/SEL"  , "narrator": "", "text": "手取り足取り教えるよ"},
        { "location": "1046/ACT"  , "narrator": "", "text": "もちろんだよ"},
        { "location": "1047/TALK" , "narrator": "神楽", "text": "そうですか"},
        { "location": "1048/TALK" , "narrator": "神楽", "text": "ではよろしくお願いしますね"},
        { "location": "1049/ACT"  , "narrator": "", "text": "手取り足取り教えるよ"},
        { "location": "1050/TALK" , "narrator": "神楽", "text": "それはご親切に"},
