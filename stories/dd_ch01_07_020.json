{
    "dir": "chap07/daydra/dd_ch01_07_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "7156",
        "cid": "tsubame",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "将来の夢は？"
    },
    "entry":
    [
        { "location": "227/SCENARIO", "narrator": "", "text": "将来の夢は？"},
        { "location": "245/TALK"    , "narrator": "アーヤ", "text": "そういえば、つばめは\n将来の夢ってあるの？"},
        { "location": "247/TALK"    , "narrator": "つばめ", "text": "えっ？　急にどうしたん\nですか？"},
        { "location": "248/TALK"    , "narrator": "アーヤ", "text": "ちょっと気になってね。"},
        { "location": "249/TALK"    , "narrator": "アーヤ", "text": "私もつばめも、いずれは\n学生を終えて社会人に\nなるでしょ？"},
        { "location": "250/TALK"    , "narrator": "アーヤ", "text": "その時、つばめはどんな\n風になりたいのかな、って\n思ったの。"},
        { "location": "252/TALK"    , "narrator": "つばめ", "text": "う～ん…将来ですかぁ…。"},
        { "location": "253/TALK"    , "narrator": "アーヤ", "text": "あ、無理に言わなくて\nいいから。"},
        { "location": "254/TALK"    , "narrator": "アーヤ", "text": "秘密にしてるなら、\n無理に言わないで。"},
        { "location": "255/TALK"    , "narrator": "つばめ", "text": "そうじゃないんです。\nただ、その…。"},
        { "location": "256/SEL"     , "narrator": "", "text": "なりたいものはないの？"},
        { "location": "257/SEL"     , "narrator": "", "text": "一生トライナリー宣言！"},
        { "location": "258/SEL"     , "narrator": "", "text": "お嫁さんとかは？"},
        { "location": "261/TALK"    , "narrator": "つばめ", "text": "どうしよう…\nわたし、そういうの\n考えたことないのに…。"},
        { "location": "262/TALK"    , "narrator": "つばめ", "text": "でも、高校生にもなって\n将来の夢がないなんて、\nちょっと変かな？"},
        { "location": "263/TALK"    , "narrator": "つばめ", "text": "でも、他に言うこと\n思いつかないし…。"},
        { "location": "267/TALK"    , "narrator": "つばめ", "text": "実は、まだよくわからない\nんです。"},
        { "location": "268/TALK"    , "narrator": "アーヤ", "text": "そうなの？"},
        { "location": "269/TALK"    , "narrator": "つばめ", "text": "はい…"},
        { "location": "271/TALK"    , "narrator": "つばめ", "text": "自分が何をしたいのか、\n何が得意なのか――"},
        { "location": "272/TALK"    , "narrator": "つばめ", "text": "まだ、自分でもよく\nわかってなくて…。"},
        { "location": "274/TALK"    , "narrator": "つばめ", "text": "…変ですか？"},
        { "location": "275/TALK"    , "narrator": "アーヤ", "text": "どうかしら？\n私の周りにはいなかった\nタイプだけど――"},
        { "location": "276/TALK"    , "narrator": "アーヤ", "text": "変とまでは思わないわ。"},
        { "location": "277/TALK"    , "narrator": "つばめ", "text": "本当ですか？"},
        { "location": "278/TALK"    , "narrator": "アーヤ", "text": "ええ。"},
        { "location": "280/TALK"    , "narrator": "アーヤ", "text": "将来の夢、\n早く見つかると\n良いわね。"},
        { "location": "282/ACT"     , "narrator": "", "text": "なりたいものはないの？"},
        { "location": "294/TALK"    , "narrator": "つばめ", "text": "ないの"},
        { "location": "295/TALK"    , "narrator": "つばめ", "text": "信じられないと思うけど、本当に…"},
        { "location": "302/TALK"    , "narrator": "つばめ", "text": "実は、まだよくわからない\nんです。"},
        { "location": "304/TALK"    , "narrator": "アーヤ", "text": "そうなの？"},
        { "location": "306/TALK"    , "narrator": "つばめ", "text": "はい…"},
        { "location": "307/TALK"    , "narrator": "つばめ", "text": "自分が何をしたいのか、\n何が得意なのか――"},
        { "location": "308/TALK"    , "narrator": "つばめ", "text": "まだ、自分でもよく\nわかってなくて…。"},
        { "location": "310/TALK"    , "narrator": "つばめ", "text": "…変ですか？"},
        { "location": "311/TALK"    , "narrator": "アーヤ", "text": "どうかしら？\n私の周りにはいなかった\nタイプだけど――"},
        { "location": "312/TALK"    , "narrator": "アーヤ", "text": "変とまでは思わないわ。"},
        { "location": "313/TALK"    , "narrator": "つばめ", "text": "本当ですか？"},
        { "location": "314/TALK"    , "narrator": "アーヤ", "text": "ええ。"},
        { "location": "316/TALK"    , "narrator": "アーヤ", "text": "将来の夢、\n早く見つかると\n良いわね。"},
        { "location": "317/ACT"     , "narrator": "", "text": "一生トライナリー宣言"},
        { "location": "329/TALK"    , "narrator": "つばめ", "text": "一生！？"},
        { "location": "331/TALK"    , "narrator": "つばめ", "text": "…一生、戦えるのかな？"},
        { "location": "337/TALK"    , "narrator": "つばめ", "text": "でも、今のわたしが\nできることといったら――"},
        { "location": "338/TALK"    , "narrator": "つばめ", "text": "トライナリーとして\n戦うことだけだし…。"},
        { "location": "341/TALK"    , "narrator": "つばめ", "text": "うん、決めた。\n今決めました。"},
        { "location": "342/TALK"    , "narrator": "つばめ", "text": "わたしの夢は生涯現役。\n一生トライナリーとして\n戦い続けます！"},
        { "location": "344/TALK"    , "narrator": "アーヤ", "text": "い、一生！？\nそれ、かなり大変よ？"},
        { "location": "346/TALK"    , "narrator": "アーヤ", "text": "段々と身体もついて\nいかなくなると思うし。"},
        { "location": "347/TALK"    , "narrator": "つばめ", "text": "そうならないように、\n頑張って鍛えます！"},
        { "location": "350/TALK"    , "narrator": "アーヤ", "text": "あはは…頼もしいわね。"},
        { "location": "351/TALK"    , "narrator": "アーヤ", "text": "…けど、できれば私達が\n現役の間に――"},
        { "location": "352/TALK"    , "narrator": "アーヤ", "text": "フェノメノン被害が\n収束して、トライナリーも\n解散――"},
        { "location": "353/TALK"    , "narrator": "アーヤ", "text": "そうなるのが一番よね。"},
        { "location": "354/ACT"     , "narrator": "", "text": "お嫁さんとかは？"},
        { "location": "368/TALK"    , "narrator": "つばめ", "text": "お嫁さんかぁ…"},
        { "location": "370/TALK"    , "narrator": "つばめ", "text": "…それ、いいかも"},
        { "location": "377/TALK"    , "narrator": "つばめ", "text": "あの…笑いませんか？"},
        { "location": "379/TALK"    , "narrator": "アーヤ", "text": "努力するわ。"},
        { "location": "380/TALK"    , "narrator": "つばめ", "text": "えっと…お、お嫁さんに、\nなりたいなぁ、\nなんて…。"},
        { "location": "381/TALK"    , "narrator": "アーヤ", "text": "……え？"},
        { "location": "384/TALK"    , "narrator": "つばめ", "text": "ウエディングドレスに、\nちょっと憧れてるんです。"},
        { "location": "385/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "386/TALK"    , "narrator": "つばめ", "text": "あ、アーヤさん？"},
        { "location": "387/TALK"    , "narrator": "アーヤ", "text": "驚いた…。\nつばめって、そういうの\n興味ないと思ってたわ。"},
        { "location": "388/TALK"    , "narrator": "つばめ", "text": "ありますよ。\nだって、すっごく綺麗じゃ\nないですか！"},
        { "location": "389/TALK"    , "narrator": "つばめ", "text": "前に、結婚式場の前で\n真っ白のドレスを着た\n人を見たことがあって――"},
        { "location": "390/TALK"    , "narrator": "つばめ", "text": "それが本当に綺麗で、\nいつかはわたしも\n着るんだ、って――"},
        { "location": "392/TALK"    , "narrator": "つばめ", "text": "そう思ってたんです。"},
        { "location": "393/TALK"    , "narrator": "アーヤ", "text": "そうだったんだ？"},
        { "location": "394/TALK"    , "narrator": "つばめ", "text": "…笑いませんか？"},
        { "location": "395/TALK"    , "narrator": "アーヤ", "text": "笑わないわよ。\n可愛くていい夢じゃない。"},
        { "location": "396/TALK"    , "narrator": "アーヤ", "text": "それならまずは、\n素敵なパートナーを\n見つけないとね。"},
        { "location": "397/TALK"    , "narrator": "アーヤ", "text": "ウェディングドレスは\n相手がいないと着れないん\nだから。"},
        { "location": "398/TALK"    , "narrator": "つばめ", "text": "え？　あ、ああ…\nそういえばそうですね。"},
        { "location": "400/TALK"    , "narrator": "つばめ", "text": "そっか…あれを着るなら\n結婚する人を見つけないと\nいけないんだよね。"},
        { "location": "401/TALK"    , "narrator": "つばめ", "text": "でも、パートナーかぁ…\nそういうの、よくわから\nないんだけどなぁ…。"},
        { "location": "242/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>5月8日　11:15 AM</color>\nとある路地で、買い物の帰りに。"},
        { "location": "412/DIALOG"  , "narrator": "Dialog_GEThimegoto_ch01", "text": "【病める時も健やかな時も】"}
    ]
}
