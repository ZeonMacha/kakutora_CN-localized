        { "location": "7/SCENARIO", "narrator": "", "text": "それはギフト"},
        { "location": "34/TALK"   , "narrator": "ガブリエラ", "text": "天賦の才能を"},
        { "location": "35/TALK"   , "narrator": "ガブリエラ", "text": "ギフトって言うんですって"},
        { "location": "37/SEL"    , "narrator": "", "text": "そうみたいね"},
        { "location": "38/SEL"    , "narrator": "", "text": "知らなかったんだ"},
        { "location": "39/SEL"    , "narrator": "", "text": "ガブリエラ自体が$me$にとってのギフト"},
        { "location": "40/ACT"    , "narrator": "", "text": "そうみたいね"},
        { "location": "41/TALK"   , "narrator": "ガブリエラ", "text": "そうなのよね"},
        { "location": "42/ACT"    , "narrator": "", "text": "知らなかったんだ"},
        { "location": "43/TALK"   , "narrator": "ガブリエラ", "text": "そうよ"},
        { "location": "44/TALK"   , "narrator": "ガブリエラ", "text": "知らなかったのよ"},
        { "location": "45/ACT"    , "narrator": "", "text": "ガブリエラ自体が$me$にとってのギフト"},
        { "location": "47/TALK"   , "narrator": "ガブリエラ", "text": "あら///"},
        { "location": "48/TALK"   , "narrator": "ガブリエラ", "text": "そんなこと言われると照れちゃうわ//////"},
        { "location": "50/TALK"   , "narrator": "ガブリエラ", "text": "$marzanna$ったらｖｖｖｖ"},
        { "location": "52/TALK"   , "narrator": "ガブリエラ", "text": "みんな生まれる時に"},
        { "location": "53/TALK"   , "narrator": "ガブリエラ", "text": "ギフトを受けて生まれてくるらしいけど"},
        { "location": "54/TALK"   , "narrator": "ガブリエラ", "text": "じゃあ"},
        { "location": "55/TALK"   , "narrator": "ガブリエラ", "text": "トライナリーのみんなは"},
        { "location": "56/TALK"   , "narrator": "ガブリエラ", "text": "トライナリーであることが"},
        { "location": "57/TALK"   , "narrator": "ガブリエラ", "text": "ギフトなのかしら？"},
        { "location": "59/SEL"    , "narrator": "", "text": "そうかもね"},
        { "location": "60/SEL"    , "narrator": "", "text": "どうだろう"},
        { "location": "61/ACT"    , "narrator": "", "text": "そうかもね"},
        { "location": "62/TALK"   , "narrator": "ガブリエラ", "text": "そうなのかしら？"},
        { "location": "63/TALK"   , "narrator": "ガブリエラ", "text": "なんだか少し"},
        { "location": "64/TALK"   , "narrator": "ガブリエラ", "text": "考えてしまうわね"},
        { "location": "65/ACT"    , "narrator": "", "text": "どうだろう"},
        { "location": "66/TALK"   , "narrator": "ガブリエラ", "text": "そうよね"},
        { "location": "67/TALK"   , "narrator": "ガブリエラ", "text": "そんなの$marzanna$にも"},
        { "location": "69/TALK"   , "narrator": "ガブリエラ", "text": "わからないわよね"},
        { "location": "70/TALK"   , "narrator": "ガブリエラ", "text": "ちょっと聞いてみただけだから"},
