        "title": "Extra008 ヒメゴトチャット",
        "sub_title": "モナルーム？　モナムール！"
    },
    "entry":
    [
        { "location": "113/SCENARIO", "narrator": "", "text": "021_モナルーム？　モナムール！"},
        { "location": "138/TALK"    , "narrator": "みやび", "text": "人が親切になるのは"},
        { "location": "139/TALK"    , "narrator": "みやび", "text": "どういう時だろうな"},
        { "location": "142/SEL"     , "narrator": "", "text": "幸せな時"},
        { "location": "143/SEL"     , "narrator": "", "text": "修業中"},
        { "location": "144/SEL"     , "narrator": "", "text": "恋してる時"},
        { "location": "145/ACT"     , "narrator": "", "text": "幸せな時"},
        { "location": "146/TALK"    , "narrator": "みやび", "text": "幸せか"},
        { "location": "147/TALK"    , "narrator": "みやび", "text": "ふむ"},
        { "location": "148/ACT"     , "narrator": "", "text": "修業中"},
        { "location": "149/TALK"    , "narrator": "みやび", "text": "それも"},
        { "location": "150/TALK"    , "narrator": "みやび", "text": "一理ある"},
        { "location": "151/ACT"     , "narrator": "", "text": "恋してる時"},
        { "location": "152/TALK"    , "narrator": "みやび", "text": "恋とは"},
        { "location": "153/TALK"    , "narrator": "みやび", "text": "どういうことだ？"},
        { "location": "155/TALK"    , "narrator": "みやび", "text": "まあなんだ"},
        { "location": "156/TALK"    , "narrator": "みやび", "text": "まほさんが妙にうちに親切だったちや"},
        { "location": "157/TALK"    , "narrator": "みやび", "text": "なんでだと思う？"},
        { "location": "160/SEL"     , "narrator": "", "text": "就職の話、聞かれてたよ"},
        { "location": "161/SEL"     , "narrator": "", "text": "何か仕事を任されるのかも"},
        { "location": "162/SEL"     , "narrator": "", "text": "アプローチされてるんだよ"},
        { "location": "163/ACT"     , "narrator": "", "text": "就職の話、聞かれてたよ"},
        { "location": "164/TALK"    , "narrator": "みやび", "text": "理解した"},
        { "location": "165/TALK"    , "narrator": "みやび", "text": "まあ今のところは"},
        { "location": "166/TALK"    , "narrator": "みやび", "text": "やぶさかではない"},
        { "location": "171/TALK"    , "narrator": "みやび", "text": "しかし"},
        { "location": "172/TALK"    , "narrator": "みやび", "text": "別の選択肢を取ることにした場合"},
        { "location": "173/TALK"    , "narrator": "みやび", "text": "面倒そうじゃの"},
        { "location": "176/ACT"     , "narrator": "", "text": "何か仕事を任されるのかも"},
        { "location": "177/TALK"    , "narrator": "みやび", "text": "大人の交渉術というやつか"},
        { "location": "178/TALK"    , "narrator": "みやび", "text": "その策略には乗らん！"},
        { "location": "179/TALK"    , "narrator": "みやび", "text": "ということで"},
        { "location": "180/TALK"    , "narrator": "みやび", "text": "協力せよ、相棒"},
        { "location": "181/TALK"    , "narrator": "みやび", "text": "シゴトはせぬ"},
        { "location": "182/TALK"    , "narrator": "みやび", "text": "仕事はせぬぞ！"},
        { "location": "183/ACT"     , "narrator": "", "text": "アプローチされてるんだよ"},
        { "location": "193/TALK"    , "narrator": "みやび", "text": "ぬ"},
        { "location": "194/TALK"    , "narrator": "みやび", "text": "何的アプローチぞね？"},
        { "location": "197/SEL"     , "narrator": "", "text": "恋"},
        { "location": "198/SEL"     , "narrator": "", "text": "ラブ"},
        { "location": "199/SEL"     , "narrator": "", "text": "百合"},
        { "location": "200/ACT"     , "narrator": "", "text": "恋"},
        { "location": "202/TALK"    , "narrator": "みやび", "text": "恋だとう？"},
        { "location": "203/ACT"     , "narrator": "", "text": "ラブ"},
        { "location": "205/TALK"    , "narrator": "みやび", "text": "ラブかよ！"},
        { "location": "206/ACT"     , "narrator": "", "text": "百合"},
        { "location": "207/TALK"    , "narrator": "みやび", "text": "隠語表現まで使うとは"},
        { "location": "209/TALK"    , "narrator": "みやび", "text": "年の差がありすぎるのではないか"},
        { "location": "212/TALK"    , "narrator": "みやび", "text": "いや"},
        { "location": "213/TALK"    , "narrator": "みやび", "text": "そういうことではなく"},
        { "location": "214/TALK"    , "narrator": "みやび", "text": "貴殿の冗談はちっくと笑えん"},
        { "location": "216/SEL"     , "narrator": "", "text": "本気"},
        { "location": "217/SEL"     , "narrator": "", "text": "ガチ"},
        { "location": "218/ACT"     , "narrator": "", "text": "本気"},
        { "location": "219/TALK"    , "narrator": "みやび", "text": "いやいやいやいや"},
        { "location": "220/TALK"    , "narrator": "みやび", "text": "ないわー"},
        { "location": "221/ACT"     , "narrator": "", "text": "ガチ"},
        { "location": "222/TALK"    , "narrator": "みやび", "text": "またまた"},
        { "location": "223/TALK"    , "narrator": "みやび", "text": "ご冗談を"},
        { "location": "189/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"}
    ]
}
