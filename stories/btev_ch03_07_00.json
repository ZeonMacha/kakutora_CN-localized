{
    "dir": "chap07/battle/btev_ch03_07_00.js",
    "type": "",
    "info": {
        "story_id": "23010",
        "cid": "",
        "title": "010 ココロスフィアストーリー【Lv04】",
        "sub_title": "オールニーズユー＜提起＞"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "オールニーズユー"},
        { "location": "13/DIALOG" , "narrator": "", "text": "<size=40>KOKORO-Lv. 04</size>\nGABRIELLA\n\n<size=45>オールニーズユー</size>\n<size=35>～あたしは如何ほど必要ですか？～</size>"},
        { "location": "26/TALK"   , "narrator": "アーヤ", "text": "ギャヴィさん。"},
        { "location": "28/TALK"   , "narrator": "ガブリエラ", "text": "は、はい、國政部長。\nなんでしょうか？"},
        { "location": "31/TALK"   , "narrator": "アーヤ", "text": "あなた、確か……\n銃器スキルの\n専門だったっけ？"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "は、はい！\nそうです！"},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "他に何か、役にたつ\nスキルって\n持ってたかしら？"},
        { "location": "36/TALK"   , "narrator": "ガブリエラ", "text": "え？\nそれは……\n特に無いです。"},
        { "location": "39/TALK"   , "narrator": "アーヤ", "text": "そう。"},
        { "location": "42/TALK"   , "narrator": "アーヤ", "text": "正直今、我が社では\n銃器スキルは\n要らないのよね。"},
        { "location": "44/TALK"   , "narrator": "ガブリエラ", "text": "え！？"},
        { "location": "48/TALK"   , "narrator": "千羽鶴", "text": "それじゃ。\n健闘を祈る。"},
        { "location": "53/TALK"   , "narrator": "アーヤ", "text": "今年の社のビジョンが\n【突撃と破壊】に\nなったから。"},
        { "location": "55/TALK"   , "narrator": "アーヤ", "text": "正直もう\nスキル的に\n役に立たないのよ。"},
        { "location": "57/TALK"   , "narrator": "ガブリエラ", "text": "そ、そんな！\nいきなりは酷いです！"},
        { "location": "58/TALK"   , "narrator": "アーヤ", "text": "そうは言っても\n会社の方針だから。"},
        { "location": "59/TALK"   , "narrator": "アーヤ", "text": "まあ、銃のスキルを\n必要としてる会社も\nあると思うし――"},
        { "location": "60/TALK"   , "narrator": "アーヤ", "text": "この機会にその\nキャリアを活かせる\n会社に転職する方が…"},
        { "location": "61/SEL"    , "narrator": "（選択肢）", "text": "残りたいって言うんだ！"},
        { "location": "62/SEL"    , "narrator": "（選択肢）", "text": "こんな会社やめちまえ！"},
        { "location": "63/ACT"    , "narrator": "", "text": "残りたいって言うんだ！"},
        { "location": "66/TALK"   , "narrator": "ガブリエラ", "text": "え！？\nあ、うん。"},
        { "location": "68/TALK"   , "narrator": "ガブリエラ", "text": "の、残りたいです！"},
        { "location": "71/TALK"   , "narrator": "アーヤ", "text": "うーん、\nそうは言ってもね。"},
        { "location": "73/TALK"   , "narrator": "アーヤ", "text": "うちに残っても、\n今後何のチャンスも\n無いわよ？"},
        { "location": "74/ACT"    , "narrator": "", "text": "こんな会社やめちまえ！"},
        { "location": "75/TALK"   , "narrator": "ガブリエラ", "text": "えええっ！？"},
        { "location": "77/TALK"   , "narrator": "ガブリエラ", "text": "そんな急に無理よ！！"},
        { "location": "82/TALK"   , "narrator": "アーヤ", "text": "まあ、よく考えてみて。\nそれと、\n残念だけど――"},
        { "location": "83/TALK"   , "narrator": "アーヤ", "text": "今期からギャヴィさん\n配属プロジェクトは\n特に無いから。"},
        { "location": "84/TALK"   , "narrator": "アーヤ", "text": "それじゃ。"},
        { "location": "86/TALK"   , "narrator": "アーヤ", "text": "はぁ、忙しい忙しい。"},
        { "location": "89/TALK"   , "narrator": "ガブリエラ", "text": "…そ、そんな……。"},
        { "location": "100/TALK"  , "narrator": "ガブリエラ", "text": "はぁ……\nまさかこんな事に\nなるなんて。"},
        { "location": "101/TALK"  , "narrator": "ガブリエラ", "text": "銃器スキル以外にも\n色んなキャリアを\n積んでおけばよかった。"},
        { "location": "102/TALK"  , "narrator": "ガブリエラ", "text": "……銃も\nおもちゃのコルク銃に\n替えられちゃったし。"},
        { "location": "104/TALK"  , "narrator": "ガブリエラ", "text": "はぁ……。"},
        { "location": "106/TALK"  , "narrator": "つばめ", "text": "せんぱい！"},
        { "location": "108/TALK"  , "narrator": "ガブリエラ", "text": "あら、つばめ。"},
        { "location": "109/TALK"  , "narrator": "つばめ", "text": "わたし来期から\n新プロジェクトの\n副主任になりました！"},
        { "location": "111/TALK"  , "narrator": "ガブリエラ", "text": "え！？\nあ、そう……。\nよ、よかったわね。"},
        { "location": "113/TALK"  , "narrator": "つばめ", "text": "せんぱいは次は\n何のプロジェクト\nやるんですか？"},
        { "location": "114/TALK"  , "narrator": "ガブリエラ", "text": "え？\n何だっていいでしょ？"},
        { "location": "115/TALK"  , "narrator": "つばめ", "text": "えー、\nもったいぶらずに\n教えてくださいよ。"},
        { "location": "116/TALK"  , "narrator": "ガブリエラ", "text": "……あんた、\nあたしのこと\n聞いてないの？"},
        { "location": "117/TALK"  , "narrator": "つばめ", "text": "もちろん聞いてますよ。\nわざとに決まってる\nじゃないですか！"},
        { "location": "118/TALK"  , "narrator": "ガブリエラ", "text": "まさか、いじめ！？\n……まさか、\nまさかね。"},
        { "location": "122/TALK"  , "narrator": "つばめ", "text": "それにしても、\nなんかオフィスが\n暑くないですか？"},
        { "location": "123/TALK"  , "narrator": "ガブリエラ", "text": "……誰かが\nエアコンの設定\n触ったんじゃないの？"},
        { "location": "124/TALK"  , "narrator": "つばめ", "text": "せんぱい、温度\n下げてもらって\nいいですか？"},
        { "location": "125/TALK"  , "narrator": "ガブリエラ", "text": "はぁ！？\nなんであたしが！"},
        { "location": "126/TALK"  , "narrator": "つばめ", "text": "せんぱいならここから\n銃で、壁にあるリモコン\nボタン押せますよね？"},
        { "location": "127/TALK"  , "narrator": "ガブリエラ", "text": "いや、それくらい\nできるけど……"},
        { "location": "128/TALK"  , "narrator": "つばめ", "text": "もう銃スキルなんて\nそれくらいの価値しか\nないんですから――"},
        { "location": "129/TALK"  , "narrator": "つばめ", "text": "早くリモコンの温度\n下げるボタンを狙い\n撃ちしてください！"},
        { "location": "131/TALK"  , "narrator": "ガブリエラ", "text": "…っ……。\nわ、わかったわよ。"},
        { "location": "183/TALK"  , "narrator": "ガブリエラ", "text": "…はい。\n３℃度下げたわよ。"},
        { "location": "184/TALK"  , "narrator": "つばめ", "text": "ありがとう\nございます！"},
        { "location": "185/TALK"  , "narrator": "つばめ", "text": "それじゃせんぱい、\nわたし会議なので\n行きますね！"},
        { "location": "186/TALK"  , "narrator": "つばめ", "text": "新しい職場でも\n頑張ってください！"},
        { "location": "190/TALK"  , "narrator": "ガブリエラ", "text": "ちょ！\nちょっと…"},
        { "location": "193/TALK"  , "narrator": "みやび", "text": "ガブちゃん！"},
        { "location": "194/TALK"  , "narrator": "ガブリエラ", "text": "あら、みやび……。"},
        { "location": "195/TALK"  , "narrator": "みやび", "text": "すまんがちくっと\n喉が渇いたき――"},
        { "location": "196/TALK"  , "narrator": "みやび", "text": "そこの窓から外の\n自販機でほうじ茶\n買うてくれんか。"},
        { "location": "197/TALK"  , "narrator": "ガブリエラ", "text": "はぁ！？\n自分で買いに\n行きなさいよ！"},
        { "location": "198/TALK"  , "narrator": "みやび", "text": "ガブちゃん……\nここ、５階やぞ？"},
        { "location": "199/TALK"  , "narrator": "みやび", "text": "うちを１階まで\n行かせる気か？"},
        { "location": "201/TALK"  , "narrator": "ガブリエラ", "text": "……はあ！？"},
        { "location": "202/TALK"  , "narrator": "みやび", "text": "その無価値な\n銃器スキルに価値を\n見いだしてやったのに。"},
        { "location": "204/TALK"  , "narrator": "みやび", "text": "…ここから買うて\nくれれば次の部会で\nヨイショしちゃるよ？"},
        { "location": "205/TALK"  , "narrator": "ガブリエラ", "text": "わ、わかったわよ！"},
        { "location": "233/TALK"  , "narrator": "みやび", "text": "流石ガブちゃん。\n的確にほうじ茶の\nボタン押したね。"},
        { "location": "235/TALK"  , "narrator": "みやび", "text": "それじゃ、すぐに\n取ってきてや。"},
        { "location": "237/TALK"  , "narrator": "ガブリエラ", "text": "はぁ！？\nなっ……"},
        { "location": "238/TALK"  , "narrator": "ガブリエラ", "text": "それじゃここから\n銃でボタン押す意味\n無いじゃない……！"},
        { "location": "241/TALK"  , "narrator": "神楽", "text": "ガブちゃん。"},
        { "location": "242/TALK"  , "narrator": "ガブリエラ", "text": "神楽……。\nまさか、あんたも…"},
        { "location": "244/TALK"  , "narrator": "神楽", "text": "どうしたんですか？\nそんな険しい顔して。"},
        { "location": "245/TALK"  , "narrator": "ガブリエラ", "text": "あんたもあたしに\n何か頼み事を\nしに来たのかしら…？"},
        { "location": "247/TALK"  , "narrator": "神楽", "text": "違いますよ。\nお花を摘みに行った\n帰りです。"},
        { "location": "248/TALK"  , "narrator": "ガブリエラ", "text": "なんだ、\nよかったわ…。"},
        { "location": "251/TALK"  , "narrator": "ガブリエラ", "text": "……？"},
        { "location": "253/TALK"  , "narrator": "ガブリエラ", "text": "なんか水の音が\nするんだけど……？"},
        { "location": "255/TALK"  , "narrator": "神楽", "text": "ああっ！\nそういえば！"},
        { "location": "256/TALK"  , "narrator": "神楽", "text": "手を洗ってそのまま\n水道出しっ放し\nでした…っ！"},
        { "location": "259/TALK"  , "narrator": "ガブリエラ", "text": "何やってるんだか…。"},
        { "location": "260/TALK"  , "narrator": "神楽", "text": "すみません、\nガブちゃん水道の蛇口\n締めてください！"},
        { "location": "261/TALK"  , "narrator": "ガブリエラ", "text": "何であたしが！"},
        { "location": "262/TALK"  , "narrator": "神楽", "text": "銃でここから蛇口\n狙い撃ちすれば\n締められますよね？"},
        { "location": "263/TALK"  , "narrator": "神楽", "text": "それくらいしか\n価値が無いスキル\nなんですから――"},
        { "location": "266/TALK"  , "narrator": "神楽", "text": "やってくれたって\nいいじゃないですか。"},
        { "location": "267/TALK"  , "narrator": "ガブリエラ", "text": "…っ。\nなんで？なんで\nあたしがこんな目に！"},
        { "location": "297/TALK"  , "narrator": "神楽", "text": "さすが\nガブちゃんですっ！"},
        { "location": "298/TALK"  , "narrator": "神楽", "text": "それじゃ私、\nこれから役員会に\n行ってきますね。"},
        { "location": "299/TALK"  , "narrator": "ガブリエラ", "text": "あんた、いつの間に\n役員になってるのよ！"},
        { "location": "300/TALK"  , "narrator": "神楽", "text": "入社してすぐですよ。\nだって私は――"},
        { "location": "301/TALK"  , "narrator": "神楽", "text": "鎌、飛行、柔術、\nアクロバットに\n斬撃、突撃――"},
        { "location": "302/TALK"  , "narrator": "神楽", "text": "更に歌って踊れて\n絵もお話も\n描けちゃいますから♪"},
        { "location": "306/TALK"  , "narrator": "神楽", "text": "一点集中型の\nガブちゃんと違って\n潰しがきくんですよっ。"},
        { "location": "308/TALK"  , "narrator": "神楽", "text": "それじゃです♪"},
        { "location": "312/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "313/TALK"  , "narrator": "ガブリエラ", "text": "………。"},
        { "location": "314/TALK"  , "narrator": "ガブリエラ", "text": "こんな会社、\nもうやめたい……。"},
        { "location": "315/TALK"  , "narrator": "ガブリエラ", "text": "やめてやる！"},
        { "location": "316/SEL"   , "narrator": "（選択肢）", "text": "待って待って！"},
        { "location": "317/SEL"   , "narrator": "（選択肢）", "text": "そうだそうだ！"},
        { "location": "318/ACT"   , "narrator": "", "text": "待って待って！"},
        { "location": "320/TALK"  , "narrator": "ガブリエラ", "text": "ううん、もう無理！"},
        { "location": "321/ACT"   , "narrator": "", "text": "そうだそうだ！"},
        { "location": "323/TALK"  , "narrator": "ガブリエラ", "text": "$handle$もそう\n思ってくれるのね！"},
        { "location": "326/TALK"  , "narrator": "ガブリエラ", "text": "あたしは雑用や鞄持ち\nみたいな仕事する為に\n来たんじゃないわ！"},
        { "location": "327/TALK"  , "narrator": "ガブリエラ", "text": "こんなことしか\n出来ないなら\n別の仕事につく！"},
        { "location": "332/TALK"  , "narrator": "アーヤ", "text": "そうね。\nそれがいいと思うわ。"},
        { "location": "334/TALK"  , "narrator": "ガブリエラ", "text": "部長！？"},
        { "location": "336/TALK"  , "narrator": "アーヤ", "text": "貴方の力を必要とする\n場所は他に沢山ある。\n例えば――"},
        { "location": "337/TALK"  , "narrator": "アーヤ", "text": "ポーランドとか。"},
        { "location": "339/TALK"  , "narrator": "ガブリエラ", "text": "…っ。"},
        { "location": "340/TALK"  , "narrator": "アーヤ", "text": "今、祖国は\n内戦状態なんでしょ？"},
        { "location": "341/TALK"  , "narrator": "アーヤ", "text": "貴方の力が\n役にたつと\n思うんだけど？"},
        { "location": "343/TALK"  , "narrator": "ガブリエラ", "text": "……そうね。"},
        { "location": "344/SEL"   , "narrator": "（選択肢）", "text": "待て！コイツを倒そう！"},
        { "location": "345/SEL"   , "narrator": "（選択肢）", "text": "確かに、それがいいかもね"},
        { "location": "346/ACT"   , "narrator": "", "text": "待て！コイツを倒そう！"},
        { "location": "352/DIALOG", "narrator": "", "text": "ゴキゲンポイントが\n<size=40><color=red><b>500pt.</b></color></size>\nアップしました！"},
        { "location": "358/TALK"  , "narrator": "ガブリエラ", "text": "え、えええ！？\n國政部長を！？\n無理よそんなの！"},
        { "location": "359/SEL"   , "narrator": "（選択肢）", "text": "これはアーヤじゃないよ"},
        { "location": "360/ACT"   , "narrator": "", "text": "これはアーヤじゃないよ"},
        { "location": "363/TALK"  , "narrator": "ガブリエラ", "text": "何を言ってるの！？"},
        { "location": "364/SEL"   , "narrator": "（選択肢）", "text": "ガブリエラの別人格が化けてると思う"},
        { "location": "365/ACT"   , "narrator": "", "text": "ガブリエラの別人格が化けてると思う"},
        { "location": "367/TALK"  , "narrator": "ガブリエラ", "text": "そんなハズは…"},
        { "location": "368/SEL"   , "narrator": "（選択肢）", "text": "今までもそうだったよ"},
        { "location": "369/ACT"   , "narrator": "", "text": "今までもそうだったよ"},
        { "location": "372/TALK"  , "narrator": "ガブリエラ", "text": "信じられない！"},
        { "location": "373/SEL"   , "narrator": "（選択肢）", "text": "いいから信じろ！！"},
        { "location": "374/SEL"   , "narrator": "（選択肢）", "text": "本当だよ！"},
        { "location": "375/ACT"   , "narrator": "", "text": "いいから信じろ！！"},
        { "location": "381/DIALOG", "narrator": "", "text": "ゴキゲンポイントが\n<size=40><color=red><b>500pt.</b></color></size>\nアップしました！"},
        { "location": "385/TALK"  , "narrator": "ガブリエラ", "text": "ひっ……！！"},
        { "location": "386/TALK"  , "narrator": "ガブリエラ", "text": "わ、わかったわ。\nどうすればいいの…？"},
        { "location": "387/SEL"   , "narrator": "（選択肢）", "text": "アーヤを攻撃して倒す。その銃でね。"},
        { "location": "388/ACT"   , "narrator": "", "text": "アーヤを攻撃して倒す。その銃でね。"},
        { "location": "391/TALK"  , "narrator": "アーヤ", "text": "ちょっと貴方。\n何を言ってるの！？"},
        { "location": "393/TALK"  , "narrator": "アーヤ", "text": "上司に逆らったら\n即刻クビよ！？"},
        { "location": "396/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "397/TALK"  , "narrator": "ガブリエラ", "text": "…っ！"},
        { "location": "398/TALK"  , "narrator": "アーヤ", "text": "…そう。わかった。\nそれじゃお望み通り\nクビにしてあげる。"},
        { "location": "399/TALK"  , "narrator": "アーヤ", "text": "物理的に\n首を切ることでね！"},
        { "location": "401/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "402/TALK"  , "narrator": "アーヤ", "text": "出でよ、クラン！"},
        { "location": "414/DIALOG", "narrator": "", "text": "<color=black><size=50><b>パワハラ上司と化した\nアーヤを倒せ！</b></size></color>\n\n\n\nガブリエラの心の中で\nとある心配が元となって暴走した\nアーヤのイメージ。\n\n無理難題を吹っかけてくる\nアーヤの虚像を倒し、\nその出現のルーツを探ろう。"},
        { "location": "416/ACT"   , "narrator": "", "text": "本当だよ！"},
        { "location": "417/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "419/TALK"  , "narrator": "ガブリエラ", "text": "やっぱり無理。\nあたし、ポーランドに\n帰ろうかしら。"},
        { "location": "420/SEL"   , "narrator": "（選択肢）", "text": "考え直せ！"},
        { "location": "421/ACT"   , "narrator": "", "text": "考え直せ！"},
        { "location": "423/TALK"  , "narrator": "アーヤ", "text": "そうね。\nそれが懸命な判断。"},
        { "location": "424/TALK"  , "narrator": "アーヤ", "text": "早速今日にでも\n退社手続きを\nしておくわ。"},
        { "location": "425/TALK"  , "narrator": "アーヤ", "text": "今までお疲れさま。"},
        { "location": "439/TALK"  , "narrator": "千羽鶴", "text": "惜しい。"},
        { "location": "440/TALK"  , "narrator": "千羽鶴", "text": "やり方は間違ってない。"},
        { "location": "441/TALK"  , "narrator": "千羽鶴", "text": "後もう一押しね。"},
        { "location": "460/ACT"   , "narrator": "", "text": "確かに、それがいいかもね"},
        { "location": "461/TALK"  , "narrator": "ガブリエラ", "text": "……そう。"},
