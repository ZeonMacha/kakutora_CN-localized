    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "650_瀕死のミス・イノセント"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "マルザンナのことを"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "おぼえているかしら？"},
        { "location": "35/SEL"    , "narrator": "", "text": "おぼえてる"},
        { "location": "36/SEL"    , "narrator": "", "text": "もう忘れた"},
        { "location": "37/SEL"    , "narrator": "", "text": "私がマルザンナよ、久しぶりね"},
        { "location": "38/ACT"    , "narrator": "", "text": "おぼえてる"},
        { "location": "39/TALK"   , "narrator": "ガブリエラ", "text": "そう"},
        { "location": "40/TALK"   , "narrator": "ガブリエラ", "text": "そうよね"},
        { "location": "41/ACT"    , "narrator": "", "text": "もう忘れた"},
        { "location": "42/TALK"   , "narrator": "ガブリエラ", "text": "そう"},
        { "location": "44/TALK"   , "narrator": "ガブリエラ", "text": "残念だわ"},
        { "location": "45/ACT"    , "narrator": "", "text": "私がマルザンナよ、久しぶりね"},
        { "location": "55/TALK"   , "narrator": "ガブリエラ", "text": "ごきげんよう、マルザンナ"},
        { "location": "56/TALK"   , "narrator": "ガブリエラ", "text": "いい子にしてたかしら？"},
        { "location": "58/TALK"   , "narrator": "ガブリエラ", "text": "私ね"},
        { "location": "59/TALK"   , "narrator": "ガブリエラ", "text": "貴方がマルザンナのふりをしていてくれた時"},
        { "location": "60/TALK"   , "narrator": "ガブリエラ", "text": "お話するのがとても楽しかったわ"},
        { "location": "61/TALK"   , "narrator": "ガブリエラ", "text": "だから"},
        { "location": "62/TALK"   , "narrator": "ガブリエラ", "text": "マルザンナが貴方だってわかった時"},
        { "location": "63/TALK"   , "narrator": "ガブリエラ", "text": "もうお話するもんかって思ったのよ"},
        { "location": "64/TALK"   , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "65/TALK"   , "narrator": "ガブリエラ", "text": "最初から$handle$は$handle$だったのよね"},
        { "location": "67/SEL"    , "narrator": "", "text": "マルザンナに会いたいの？"},
        { "location": "68/SEL"    , "narrator": "", "text": "$handle$じゃダメなのかな"},
        { "location": "69/ACT"    , "narrator": "", "text": "マルザンナに会いたいの？"},
        { "location": "70/TALK"   , "narrator": "ガブリエラ", "text": "違うの"},
        { "location": "71/TALK"   , "narrator": "ガブリエラ", "text": "そうじゃないのよ"},
        { "location": "72/ACT"    , "narrator": "", "text": "$handle$じゃダメなのかな"},
        { "location": "73/TALK"   , "narrator": "ガブリエラ", "text": "ダメじゃないの"},
        { "location": "74/TALK"   , "narrator": "ガブリエラ", "text": "ダメじゃなくて"},
        { "location": "76/TALK"   , "narrator": "ガブリエラ", "text": "私、マルザンナのことを考えて胸が苦しくなったりしなかったわ"},
        { "location": "77/TALK"   , "narrator": "ガブリエラ", "text": "マルザンナには嫉妬なんてしなかったわ"},
        { "location": "78/SEL"    , "narrator": "", "text": "マルザンナって呼んでいいよ"},
        { "location": "79/SEL"    , "narrator": "", "text": "$handle$のモテ期キター！"},
        { "location": "80/TALK"   , "narrator": "ガブリエラ", "text": "$handle$のことは好きなはずなのに"},
        { "location": "81/TALK"   , "narrator": "ガブリエラ", "text": "マルザンナのままでいてくれたらよかったのにって思ったりもするの"},
        { "location": "82/TALK"   , "narrator": "ガブリエラ", "text": "かわいいお人形さんで"},
        { "location": "84/ACT"    , "narrator": "", "text": "マルザンナって呼んでいいよ"},
        { "location": "85/TALK"   , "narrator": "ガブリエラ", "text": "マルザンナじゃないって"},
        { "location": "87/TALK"   , "narrator": "ガブリエラ", "text": "ずっと言ってたくせに"},
        { "location": "88/TALK"   , "narrator": "ガブリエラ", "text": "そんなこと言うなんて"},
        { "location": "89/TALK"   , "narrator": "ガブリエラ", "text": "おかしいわ"},
        { "location": "90/ACT"    , "narrator": "", "text": "$handle$のモテ期キター！"},
        { "location": "91/TALK"   , "narrator": "ガブリエラ", "text": "もう/////////////////////////"},
        { "location": "92/TALK"   , "narrator": "ガブリエラ", "text": "変な言い方しないでちょうだい"},
        { "location": "93/TALK"   , "narrator": "ガブリエラ", "text": "からかわないで！！"},
        { "location": "96/TALK"   , "narrator": "ガブリエラ", "text": "マルザンナ"},
        { "location": "98/SEL"    , "narrator": "", "text": "なあに？"},
        { "location": "99/ACT"    , "narrator": "", "text": "なあに？"},
        { "location": "101/TALK"  , "narrator": "ガブリエラ", "text": "・・・変なの"},
        { "location": "102/TALK"  , "narrator": "ガブリエラ", "text": "マルザンナ"},
        { "location": "104/SEL"   , "narrator": "", "text": "何かあったのかしら？"},
        { "location": "105/ACT"   , "narrator": "", "text": "何かあったのかしら？"},
        { "location": "107/TALK"  , "narrator": "ガブリエラ", "text": "私"},
        { "location": "108/TALK"  , "narrator": "ガブリエラ", "text": "マルザンナのこと"},
        { "location": "109/TALK"  , "narrator": "ガブリエラ", "text": "だいすきよ"},
        { "location": "111/SEL"   , "narrator": "", "text": "私もよ、ガブリエラ"},
        { "location": "112/ACT"   , "narrator": "", "text": "私もよ、ガブリエラ"},
        { "location": "115/TALK"  , "narrator": "ガブリエラ", "text": "ありがとう"},
        { "location": "116/TALK"  , "narrator": "ガブリエラ", "text": "だいすき"},
        { "location": "121/TALK"  , "narrator": "ボイスメール", "text": "優しい嘘を信じてる"},
        { "location": "51/DIALOG" , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>1000pt.</b></color></size>\nアップしました！"},
        { "location": "133/DIALOG", "narrator": "Dialog_GETVoice", "text": "<color=green>【ガブリエラ】</color>のボイスメール\n<color=red>【優しい嘘を信じてる】</color>\nをゲットしました！"}
    ]
