{
    "dir": "chap22/daydra/dd_ch04_22_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "22452",
        "cid": "miyabi",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "七五三の話"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "七五三の話"},
        { "location": "23/TALK"   , "narrator": "アーヤ", "text": "あの…ごめんなさい。\n入るなって言われた\n部屋に入っちゃって。"},
        { "location": "26/TALK"   , "narrator": "ガブリエラ", "text": "違う、悪いのはあたしで、\nアーヤは何も悪くは――"},
        { "location": "28/TALK"   , "narrator": "みやび", "text": "もう怒っちょらんよ。"},
        { "location": "31/TALK"   , "narrator": "みやび", "text": "二人とも、この部屋に\n入った責任を取って――"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "この部屋で一晩を\n明かしたんやき。"},
        { "location": "34/TALK"   , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "35/TALK"   , "narrator": "アーヤ", "text": "けど、驚いたわ。"},
        { "location": "37/TALK"   , "narrator": "アーヤ", "text": "まさかみやびの家に、\n悪霊を封じ込めている\n部屋があったなんて…。"},
        { "location": "38/TALK"   , "narrator": "みやび", "text": "…………。"},
        { "location": "40/TALK"   , "narrator": "ガブリエラ", "text": "けど、大丈夫なの？\nまたこの部屋の中に\n入ったりして――"},
        { "location": "41/TALK"   , "narrator": "ガブリエラ", "text": "悪霊が何かしてきたり\nしない？"},
        { "location": "42/TALK"   , "narrator": "みやび", "text": "…その心配はないき、\n安心してえいよ。"},
        { "location": "43/TALK"   , "narrator": "ガブリエラ", "text": "けど…。"},
        { "location": "44/TALK"   , "narrator": "みやび", "text": "この部屋の本当の秘密を、\n今から二人に話す。"},
        { "location": "46/TALK"   , "narrator": "みやび", "text": "本当は、言わんでえいかと\n思うたけんど――"},
        { "location": "47/TALK"   , "narrator": "みやび", "text": "うちも、ちっくと\nやり過ぎたところが\nあったき――"},
        { "location": "49/TALK"   , "narrator": "みやび", "text": "二人には、ちゃんと\n説明しておこうと\n思うたが。"},
        { "location": "52/TALK"   , "narrator": "アーヤ", "text": "…本当の秘密って？"},
        { "location": "55/TALK"   , "narrator": "みやび", "text": "…この部屋はな、うちの\n妹の部屋やったんよ。"},
        { "location": "56/TALK"   , "narrator": "ガブリエラ", "text": "妹？\nみやび、妹がいるの？"},
        { "location": "58/TALK"   , "narrator": "みやび", "text": "正確には、いた、やね。\n七五三（なごみ）ゆう\n妹で――"},
        { "location": "59/TALK"   , "narrator": "みやび", "text": "うちはいつも、\nなごちゃん言うてた。"},
        { "location": "61/TALK"   , "narrator": "みやび", "text": "…ずっと前に、\n死んでしもうたがね。"},
        { "location": "62/TALK"   , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "64/TALK"   , "narrator": "アーヤ", "text": "病気だったの？"},
        { "location": "66/TALK"   , "narrator": "みやび", "text": "…フェノメノンに\n巻き込まれたちや。"},
        { "location": "67/TALK"   , "narrator": "みやび", "text": "あの頃は、まだうちら\nみたいな存在もいない\n時代やったき――"},
        { "location": "68/TALK"   , "narrator": "みやび", "text": "発症したら隔離し\n巻き込まれた人間は、\n全員…。"},
        { "location": "70/TALK"   , "narrator": "アーヤ", "text": "…覚えてるわ。"},
        { "location": "71/TALK"   , "narrator": "アーヤ", "text": "当時は、全員を殺すしか\nなかったのよね。"},
        { "location": "72/TALK"   , "narrator": "ガブリエラ", "text": "じゃあ、\nみやびの妹は…。"},
        { "location": "73/TALK"   , "narrator": "みやび", "text": "…そういうことや。"},
        { "location": "74/TALK"   , "narrator": "アーヤ", "text": "…………。"},
        { "location": "76/TALK"   , "narrator": "みやび", "text": "この部屋、見てのとおり\n人形が沢山あるやろ？"},
        { "location": "77/TALK"   , "narrator": "みやび", "text": "これな…全部、うちが\n揃えたものなが。"},
        { "location": "79/TALK"   , "narrator": "みやび", "text": "お人形遊びが\n好きな子やったきね――"},
        { "location": "80/TALK"   , "narrator": "みやび", "text": "うちの部屋にある程度\n置いた物を――"},
        { "location": "81/TALK"   , "narrator": "みやび", "text": "こうして、お土産に\n持ってきて並べるように\nしてるんよ。"},
        { "location": "83/TALK"   , "narrator": "ガブリエラ", "text": "…そういえば、そこに\n置いてある人形、みやびの\n部屋で見たことある。"},
        { "location": "85/TALK"   , "narrator": "みやび", "text": "人形には、想いが宿る\nいうきね。"},
        { "location": "86/TALK"   , "narrator": "みやび", "text": "ちっくとでも、うちの\n想いがなごちゃんに\n届けばえいと思うてな。"},
        { "location": "88/TALK"   , "narrator": "みやび", "text": "…今でもな、この部屋で\nなごちゃんと話したり――"},
        { "location": "90/TALK"   , "narrator": "みやび", "text": "人形遊びをしたりする\nこともある。"},
        { "location": "91/TALK"   , "narrator": "みやび", "text": "そういう部屋なが。\nこの部屋はな…。"},
        { "location": "93/TALK"   , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "97/TALK"   , "narrator": "アーヤ", "text": "…どうして？"},
        { "location": "98/TALK"   , "narrator": "アーヤ", "text": "どうして、そのことを\n最初に言ってくれな\nかったの？"},
        { "location": "101/TALK"  , "narrator": "みやび", "text": "なんでって…\n普通そんな話聞いたら\nドン引きやろ？"},
        { "location": "102/TALK"  , "narrator": "みやび", "text": "普通の人には、\n理解できる話やないし。"},
        { "location": "103/TALK"  , "narrator": "ガブリエラ", "text": "…何言ってるのよ。"},
        { "location": "106/TALK"  , "narrator": "ガブリエラ", "text": "そんなことで、引いたり\nなんかしないわよ。"},
        { "location": "108/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "111/TALK"  , "narrator": "アーヤ", "text": "ごめんね、みやび…\nそんな大切な部屋だ\nなんて、知らなくて――"},
        { "location": "112/TALK"  , "narrator": "アーヤ", "text": "あなたの大切な場所を、\n踏みにじるようなこと\nして…。"},
        { "location": "115/TALK"  , "narrator": "ガブリエラ", "text": "…ごめんなさい。"},
        { "location": "118/TALK"  , "narrator": "みやび", "text": "…大袈裟やね。"},
        { "location": "120/TALK"  , "narrator": "みやび", "text": "ほら、もうえいから、\n涙拭きぃ。"},
        { "location": "121/TALK"  , "narrator": "みやび", "text": "わかってもらえたなら、\nそれでえいよ。"},
        { "location": "124/TALK"  , "narrator": "アーヤ", "text": "…うん。"},
        { "location": "126/TALK"  , "narrator": "アーヤ", "text": "…あれ？"},
        { "location": "128/TALK"  , "narrator": "アーヤ", "text": "つまり、悪霊は\nいなかった、って\nことよね？"},
        { "location": "129/TALK"  , "narrator": "みやび", "text": "もちろんや。\nなごちゃんは悪霊や\nないちや。"},
        { "location": "132/TALK"  , "narrator": "ガブリエラ", "text": "アーヤ、怖がり過ぎよ。"},
        { "location": "134/TALK"  , "narrator": "アーヤ", "text": "そうじゃなくて――"},
        { "location": "135/TALK"  , "narrator": "アーヤ", "text": "私達が、悪霊が本当に\nいる、って信じたのは――"},
        { "location": "137/TALK"  , "narrator": "アーヤ", "text": "この部屋に入ってから、\n私達に色んな怪現象が\n起きたからなのよ？"},
        { "location": "139/TALK"  , "narrator": "ガブリエラ", "text": "…あっ、そうよ！"},
        { "location": "141/TALK"  , "narrator": "ガブリエラ", "text": "この部屋に悪霊が封じて\nあるって話がウソなら――"},
        { "location": "144/TALK"  , "narrator": "ガブリエラ", "text": "今まであたし達に起きた\n変なことって…まさか！！"},
        { "location": "148/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "149/SEL"   , "narrator": "", "text": "何をやったの？"},
        { "location": "150/SEL"   , "narrator": "", "text": "やってないことにしたら？"},
        { "location": "152/TALK"  , "narrator": "みやび", "text": "しまった…ちっくと\n調子に乗ってイタズラ\nしまくったこと――"},
        { "location": "153/TALK"  , "narrator": "みやび", "text": "すっかり忘れちょった。"},
        { "location": "154/TALK"  , "narrator": "ガブリエラ", "text": "どうなのよ、みやび！？"},
        { "location": "162/TALK"  , "narrator": "みやび", "text": "正解や。\nあれは全部、うちが一人で\nやったことや。"},
        { "location": "163/TALK"  , "narrator": "みやび", "text": "早朝や深夜に、怪奇現象に\n見えるイタズラを\n頑張って仕込んだぞね。"},
        { "location": "164/TALK"  , "narrator": "みやび", "text": "一人でやるんは、\n結構大変だったんよ？"},
        { "location": "166/TALK"  , "narrator": "アーヤ", "text": "あ、あのねぇ…。\nいくら何でも、ちょっと\nやり過ぎよ。"},
        { "location": "167/TALK"  , "narrator": "みやび", "text": "アーヤはともかく、\nガブちゃんはオカルトを\n信じとらんき――"},
        { "location": "168/TALK"  , "narrator": "みやび", "text": "徹底的にやる必要が\nある思うたがよ。"},
        { "location": "169/TALK"  , "narrator": "ガブリエラ", "text": "やり過ぎよ！"},
        { "location": "170/TALK"  , "narrator": "ガブリエラ", "text": "最初は平気だったけど――"},
        { "location": "171/TALK"  , "narrator": "ガブリエラ", "text": "何度も何度も変なこと\nばっか起きて、本気で\n怖かったんだから！"},
        { "location": "172/TALK"  , "narrator": "みやび", "text": "けんど、おかげで\nえいこともあったやろ？"},
        { "location": "173/TALK"  , "narrator": "ガブリエラ", "text": "良いことなんて\nないわよ。"},
        { "location": "175/TALK"  , "narrator": "みやび", "text": "あったやないか。\nもう忘れたが？"},
        { "location": "176/TALK"  , "narrator": "みやび", "text": "一晩中、アーヤとここで\nイチャイチャできたや\nないか。"},
        { "location": "178/TALK"  , "narrator": "アーヤ", "text": "えっ！？"},
        { "location": "181/TALK"  , "narrator": "ガブリエラ", "text": "い、イチャイチャなんか\nしてないわ！"},
        { "location": "184/TALK"  , "narrator": "アーヤ", "text": "そ、そうよ！"},
        { "location": "185/TALK"  , "narrator": "アーヤ", "text": "あれは、怖がってた\nギャヴィを落ち着かせ\nようとしてただけで…。"},
        { "location": "187/TALK"  , "narrator": "ガブリエラ", "text": "いや、違うでしょ？\n怖がってたのは\nアーヤの方じゃん。"},
        { "location": "189/TALK"  , "narrator": "アーヤ", "text": "はぁ！？　あの時は\n明らかにあなたの方が\n怖がってたじゃない！"},
        { "location": "190/TALK"  , "narrator": "ガブリエラ", "text": "た、確かに怖かったけど、\nアーヤの方が絶対怖がって\nたから！"},
        { "location": "192/TALK"  , "narrator": "みやび", "text": "ここで痴話ゲンカは\nやめてもらえるか？"},
        { "location": "193/TALK"  , "narrator": "みやび", "text": "なごちゃんの教育に\n悪いきね。"},
        { "location": "195/TALK"  , "narrator": "アーヤ", "text": "痴話ゲンカじゃないから！"},
        { "location": "197/TALK"  , "narrator": "ガブリエラ", "text": "変なこと言わないで！"},
        { "location": "199/TALK"  , "narrator": "みやび", "text": "やれやれ…。\nまあ、見てて楽しくは\nあるけんどね。"},
        { "location": "202/TALK"  , "narrator": "みやび", "text": "…なごちゃんも、\n楽しい思うてくれてる\nとえいな…。"},
        { "location": "203/ACT"   , "narrator": "", "text": "何をやったの？"},
        { "location": "223/TALK"  , "narrator": "みやび", "text": "悪霊の存在を信じさせよう思うて"},
        { "location": "224/TALK"  , "narrator": "みやび", "text": "それっぽいイタズラをちっくとな"},
        { "location": "236/ACT"   , "narrator": "", "text": "やってないことにしたら？"},
        { "location": "255/TALK"  , "narrator": "みやび", "text": "面白そうやけんど"},
        { "location": "256/TALK"  , "narrator": "みやび", "text": "多分、ウソ言うてもバレると思うんよ"},
        { "location": "269/TALK"  , "narrator": "ガブリエラ", "text": "あれって全部、\nあんたの仕業だったの！？"},
        { "location": "270/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "273/TALK"  , "narrator": "みやび", "text": "うちは何もしとらんがよ。"},
        { "location": "275/TALK"  , "narrator": "みやび", "text": "けんど、二人が悪いこと\nしたんは事実やき――"},
        { "location": "276/TALK"  , "narrator": "みやび", "text": "なごちゃんが怒って、\nめっ、てしに来たんかも\nしれんな。"},
        { "location": "278/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "279/TALK"  , "narrator": "ガブリエラ", "text": "…ウソね。"},
        { "location": "280/TALK"  , "narrator": "アーヤ", "text": "バレバレよ。\n今時そんなオチ、\nホラー小説でもないわ。"},
        { "location": "284/TALK"  , "narrator": "みやび", "text": "…やっぱし、\nバレバレやったか。"},
        { "location": "285/TALK"  , "narrator": "アーヤ", "text": "まあ、いくらなんでも\n出来過ぎてるしね。"},
        { "location": "286/TALK"  , "narrator": "ガブリエラ", "text": "っていうか、妹のせいに\nしてんじゃないわよ。"},
        { "location": "287/TALK"  , "narrator": "ガブリエラ", "text": "あとで仏壇に向かって\n謝りなさいよ？"},
        { "location": "288/TALK"  , "narrator": "みやび", "text": "…そうやね。"},
        { "location": "289/TALK"  , "narrator": "アーヤ", "text": "いや、謝るのは私達も\n同じだから。"},
        { "location": "290/TALK"  , "narrator": "アーヤ", "text": "部屋を覗いたり、\nドア破って入ったり\nしたんだから…。"},
        { "location": "291/TALK"  , "narrator": "ガブリエラ", "text": "あ、あれはわざとじゃ\nないし！"},
        { "location": "292/TALK"  , "narrator": "ガブリエラ", "text": "っていうか、一晩部屋で\n過ごしたんだから、\nそれで帳消しよ。"},
        { "location": "294/TALK"  , "narrator": "アーヤ", "text": "なるわけないでしょ。"},
        { "location": "295/TALK"  , "narrator": "みやび", "text": "そうやね"},
        { "location": "297/TALK"  , "narrator": "みやび", "text": "二人とも、一晩中ここで\nイチャイチャしてた\nだけやし。"},
        { "location": "20/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>8月26日　 9:13 AM</color>\n合宿中、みやびの実家でのこと"}
    ]
}
