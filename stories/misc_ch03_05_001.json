        { "location": "7/SCENARIO", "narrator": "", "text": "001_空想の缶詰"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "あの子たち元気にしてるかしら？"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "なんてことを私は"},
        { "location": "34/TALK"   , "narrator": "ガブリエラ", "text": "マシュマロココアを飲みながら"},
        { "location": "35/TALK"   , "narrator": "ガブリエラ", "text": "思ったりするのです"},
        { "location": "38/SEL"    , "narrator": "", "text": "あの子たちって？"},
        { "location": "39/SEL"    , "narrator": "", "text": "この時期ココアって汗かかない？"},
        { "location": "40/SEL"    , "narrator": "", "text": "元気だといいよね"},
        { "location": "41/ACT"    , "narrator": "", "text": "あの子たちって？"},
        { "location": "42/TALK"   , "narrator": "ガブリエラ", "text": "マルザンナのお友達よ"},
        { "location": "43/ACT"    , "narrator": "", "text": "この時期ココアって汗かかない？"},
        { "location": "44/TALK"   , "narrator": "ガブリエラ", "text": "じゃあアイスココアにするわ"},
        { "location": "45/ACT"    , "narrator": "", "text": "元気だといいね"},
        { "location": "55/TALK"   , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "56/TALK"   , "narrator": "ガブリエラ", "text": "だったらいいわね"},
        { "location": "59/TALK"   , "narrator": "ガブリエラ", "text": "ワルシャワに置いてきたマルザンナのお友達のこと"},
        { "location": "60/TALK"   , "narrator": "ガブリエラ", "text": "聞きたいかしら？"},
        { "location": "62/SEL"    , "narrator": "", "text": "ガブが持ってたぬいぐみとか人形のこと？"},
        { "location": "63/ACT"    , "narrator": "", "text": "ガブが持ってたぬいぐみとか人形のこと？"},
        { "location": "66/TALK"   , "narrator": "ガブリエラ", "text": "そういう言い方になるのね"},
        { "location": "67/TALK"   , "narrator": "ガブリエラ", "text": "マルザンナは会ったことないものね"},
        { "location": "69/TALK"   , "narrator": "ガブリエラ", "text": "仕方ないわよね・・・・"},
        { "location": "72/SEL"    , "narrator": "", "text": "なんかごめんね"},
        { "location": "73/SEL"    , "narrator": "", "text": "そうだね…"},
        { "location": "74/SEL"    , "narrator": "", "text": "お友達の話を聞かせてくれる？"},
        { "location": "75/ACT"    , "narrator": "", "text": "なんかごめんね"},
        { "location": "76/TALK"   , "narrator": "ガブリエラ", "text": "ううん、構わないのよ？"},
        { "location": "77/TALK"   , "narrator": "ガブリエラ", "text": "突然だったものね・・・？"},
        { "location": "80/ACT"    , "narrator": "", "text": "そうだね…"},
        { "location": "81/TALK"   , "narrator": "ガブリエラ", "text": "そうだわよね・・・"},
        { "location": "82/TALK"   , "narrator": "ガブリエラ", "text": "突然そんなこと言われてもそんな風になっちゃうわよね・・・"},
        { "location": "85/ACT"    , "narrator": "", "text": "お友達の話を聞かせてくれる？"},
        { "location": "95/TALK"   , "narrator": "ガブリエラ", "text": "聞いてくれるのかしら？"},
        { "location": "96/TALK"   , "narrator": "ガブリエラ", "text": "マルザンナのお友達の話ｖ"},
        { "location": "97/TALK"   , "narrator": "ガブリエラ", "text": "きっと仲良くなりたいって思うわよ？"},
        { "location": "98/TALK"   , "narrator": "ガブリエラ", "text": "みんないいこたちばかりだもの！"},
        { "location": "101/TALK"  , "narrator": "ガブリエラ", "text": "あっ"},
        { "location": "102/TALK"  , "narrator": "ガブリエラ", "text": "でもね、勘違いしないで？"},
        { "location": "103/TALK"  , "narrator": "ガブリエラ", "text": "私が今一番大切に思っているのはマルザンナなの"},
        { "location": "104/TALK"  , "narrator": "ガブリエラ", "text": "あの子たちには悪いと思うけど・・・・"},
        { "location": "106/SEL"   , "narrator": "", "text": "大丈夫だよ"},
        { "location": "107/SEL"   , "narrator": "", "text": "嬉しいわ"},
        { "location": "108/ACT"   , "narrator": "", "text": "大丈夫だよ"},
        { "location": "109/TALK"  , "narrator": "ガブリエラ", "text": "そうよね"},
        { "location": "110/TALK"  , "narrator": "ガブリエラ", "text": "きっとわかってくれるわ"},
        { "location": "111/ACT"   , "narrator": "", "text": "嬉しいわ"},
        { "location": "112/TALK"  , "narrator": "ガブリエラ", "text": "そうなのね？"},
        { "location": "113/TALK"  , "narrator": "ガブリエラ", "text": "よかったわ"},
        { "location": "114/TALK"  , "narrator": "ガブリエラ", "text": "私もだいすきよ"},
