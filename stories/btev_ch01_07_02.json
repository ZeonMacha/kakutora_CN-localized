{
    "dir": "chap07/battle/btev_ch01_07_02.js",
    "type": "",
    "info": {
        "story_id": "21012",
        "cid": "",
        "title": "012 ココロスフィアストーリー【Lv04】",
        "sub_title": "仁王門＜帰結＞"
    },
    "entry":
    [
        { "location": "145/SCENARIO", "narrator": "", "text": "仁王門"},
        { "location": "156/TALK"    , "narrator": "啓介", "text": "…まさか\n私のパワーに\n勝るとはな。"},
        { "location": "158/TALK"    , "narrator": "啓介", "text": "だがよいか！"},
        { "location": "159/TALK"    , "narrator": "啓介", "text": "あー……"},
        { "location": "161/SEL"     , "narrator": "（選択肢）", "text": "あ、$handle$です"},
        { "location": "162/ACT"     , "narrator": "", "text": "あ、$handle$です"},
        { "location": "164/TALK"    , "narrator": "啓介", "text": "ふむ、ありがとう。"},
        { "location": "165/TALK"    , "narrator": "啓介", "text": "だがよいか！\n$handle$よ！"},
        { "location": "166/TALK"    , "narrator": "啓介", "text": "このつばめに\n騙されるな！"},
        { "location": "167/TALK"    , "narrator": "啓介", "text": "私はまだつばめの\n東京滞在を許した\nわけではないのだ。"},
        { "location": "168/TALK"    , "narrator": "啓介", "text": "現実の私が許さぬ\n限り、私は何度でも\n復活するだろう。"},
        { "location": "169/TALK"    , "narrator": "啓介", "text": "それだけは\n覚えておくがいい。"},
        { "location": "182/TALK"    , "narrator": "つばめ", "text": "……。"},
        { "location": "183/SEL"     , "narrator": "（選択肢）", "text": "許してないって本当？"},
        { "location": "184/ACT"     , "narrator": "", "text": "許してないって本当？"},
        { "location": "186/TALK"    , "narrator": "つばめ", "text": "え？"},
        { "location": "189/TALK"    , "narrator": "つばめ", "text": "…え、えへへ。\n実はそうなんだ。"},
        { "location": "190/SEL"     , "narrator": "（選択肢）", "text": "そんな気はしてた"},
        { "location": "191/SEL"     , "narrator": "（選択肢）", "text": "それってやばくない？"},
        { "location": "192/ACT"     , "narrator": "", "text": "そんな気はしてた"},
        { "location": "193/TALK"    , "narrator": "つばめ", "text": "ええっ？\nそうなの？"},
        { "location": "194/SEL"     , "narrator": "（選択肢）", "text": "顔に出てたよ"},
        { "location": "195/ACT"     , "narrator": "", "text": "顔に出てたよ"},
        { "location": "197/TALK"    , "narrator": "つばめ", "text": "そうなんだ…。"},
        { "location": "198/TALK"    , "narrator": "つばめ", "text": "$handle$さんは\nすごいね！\nなんでもわかっちゃう。"},
        { "location": "200/TALK"    , "narrator": "つばめ", "text": "本当のこと言うと、\nケンカしちゃって\nそのままなんだ。"},
        { "location": "202/TALK"    , "narrator": "つばめ", "text": "だってお父さんが\n強情なんだもん！"},
        { "location": "203/ACT"     , "narrator": "", "text": "それってやばくない？"},
        { "location": "204/TALK"    , "narrator": "つばめ", "text": "うーん、確かに\nちょっとまずいかも。"},
        { "location": "205/TALK"    , "narrator": "つばめ", "text": "とはいっても、少しの\n間わたしとお父さんが\n気まずいだけだよね。"},
        { "location": "207/SEL"     , "narrator": "（選択肢）", "text": "無理矢理実家に連れもどされるよ"},
        { "location": "208/ACT"     , "narrator": "", "text": "無理矢理実家に連れもどされるよ"},
        { "location": "210/TALK"    , "narrator": "つばめ", "text": "えええっ！？\nそうなの！？"},
        { "location": "211/SEL"     , "narrator": "（選択肢）", "text": "未成年においては親権が何より強いからね"},
        { "location": "212/ACT"     , "narrator": "", "text": "未成年においては親権が何より強いからね"},
        { "location": "215/TALK"    , "narrator": "つばめ", "text": "どどどどどうしよう！"},
        { "location": "217/TALK"    , "narrator": "つばめ", "text": "帰りたくない…\nううん、\nまだ帰れないよ。"},
        { "location": "218/SEL"     , "narrator": "（選択肢）", "text": "相談にのるよ？"},
        { "location": "219/ACT"     , "narrator": "", "text": "相談にのるよ？"},
        { "location": "223/TALK"    , "narrator": "つばめ", "text": "…ありがとう。"},
        { "location": "225/TALK"    , "narrator": "つばめ", "text": "えっと、それじゃ\nまずはどうすれば\nいいかなぁ…。"},
        { "location": "226/SEL"     , "narrator": "（選択肢）", "text": "状況を教えて"},
        { "location": "227/SEL"     , "narrator": "（選択肢）", "text": "今度リアルのお父さんを紹介して"},
        { "location": "228/ACT"     , "narrator": "", "text": "状況を教えて"},
        { "location": "229/TALK"    , "narrator": "つばめ", "text": "ああっ！\nそ、そうだね！"},
        { "location": "230/TALK"    , "narrator": "つばめ", "text": "それじゃまずは\nお父さんと何があったか\n伝えるね。"},
        { "location": "231/ACT"     , "narrator": "", "text": "今度リアルのお父さんを紹介して"},
        { "location": "233/TALK"    , "narrator": "つばめ", "text": "え？\nいいけど……"},
        { "location": "234/TALK"    , "narrator": "つばめ", "text": "多分殆どお話ししないで\n終わっちゃうと思うよ？"},
        { "location": "235/TALK"    , "narrator": "つばめ", "text": "うちのお父さん、\n仕事以外に趣味って\n無い人だから――"},
        { "location": "236/TALK"    , "narrator": "つばめ", "text": "多分、お友達に\nなるのは大変なんじゃ\nないかなぁ？"},
        { "location": "237/SEL"     , "narrator": "（選択肢）", "text": "……意味分かってる？"},
        { "location": "238/SEL"     , "narrator": "（選択肢）", "text": "結婚前提のお付き合いをさせてくださいって言うだけだよ"},
        { "location": "239/ACT"     , "narrator": "", "text": "……意味分かってる？"},
        { "location": "240/TALK"    , "narrator": "つばめ", "text": "え？"},
        { "location": "241/TALK"    , "narrator": "つばめ", "text": "うーん、\nよくわかんないや。"},
        { "location": "242/ACT"     , "narrator": "", "text": "結婚前提のお付き合いをさせてくださいって言うだけだよ"},
        { "location": "244/TALK"    , "narrator": "つばめ", "text": "へぇ、そうなんだ。\n$handle$さん、\n結婚するんだねー！"},
        { "location": "246/TALK"    , "narrator": "つばめ", "text": "おめでとう！\n誰とするの？"},
        { "location": "247/SEL"     , "narrator": "（選択肢）", "text": "つばめのお父さんの娘さんだよ…"},
        { "location": "248/ACT"     , "narrator": "", "text": "つばめのお父さんの娘さんだよ…"},
        { "location": "251/TALK"    , "narrator": "つばめ", "text": "わたしのお父さんの娘？"},
        { "location": "252/TALK"    , "narrator": "つばめ", "text": "って、わたし！"},
        { "location": "254/TALK"    , "narrator": "つばめ", "text": "ええええええっ…！？"},
        { "location": "255/TALK"    , "narrator": "つばめ", "text": "意味が分かりません！"},
        { "location": "256/SEL"     , "narrator": "（選択肢）", "text": "冗談です"},
        { "location": "257/SEL"     , "narrator": "（選択肢）", "text": "本気です"},
        { "location": "258/ACT"     , "narrator": "", "text": "冗談です"},
        { "location": "260/TALK"    , "narrator": "つばめ", "text": "もぅ！\n冗談はダメだよ！"},
        { "location": "261/ACT"     , "narrator": "", "text": "本気です"},
        { "location": "264/TALK"    , "narrator": "つばめ", "text": "もーーーっ！"},
        { "location": "265/TALK"    , "narrator": "つばめ", "text": "こういうときに\n冗談言ったら\nダメなんだよ！"},
        { "location": "270/TALK"    , "narrator": "つばめ", "text": "とにかくっ！"},
        { "location": "271/TALK"    , "narrator": "つばめ", "text": "まずは今お父さんと\nどうなってるかを\n伝えるね。"},
        { "location": "275/TALK"    , "narrator": "つばめ", "text": "本当は恥ずかしいから\nあまり誰かに見せたく\nないんだけど……。"},
        { "location": "294/DIALOG"  , "narrator": "", "text": "これは、\n真幌さんからトライナリー入隊について\nお話があった日の夜。\n\n楽屋でのこと――。"},
        { "location": "295/TALK"    , "narrator": "つばめ", "text": "だから！\n私が自分で決めた\nことでもあるの！"},
        { "location": "296/DIALOG"  , "narrator": "", "text": "お父さんに電話をした時には\n既に政府の人が実家に行って\nわたしのトライナリー入隊について\n説明していた。"},
        { "location": "297/TALK"    , "narrator": "啓介", "text": "そんなの許さん！\nすぐ帰ってこい！"},
        { "location": "300/TALK"    , "narrator": "つばめ", "text": "いやだよ！\n私だってやりたいん\nだもん！"},
        { "location": "301/TALK"    , "narrator": "啓介", "text": "何故そこまで\n頑なになる！"},
        { "location": "304/TALK"    , "narrator": "つばめ", "text": "わたしだって\nお母さんに何か\nしてあげたいの！"},
        { "location": "305/DIALOG"  , "narrator": "", "text": "トライナリーへの入隊は\n大きな生命のリスクが伴う。\n\nだから政府はその対価として、\n現実的に可能な限りの\n隊員の希望を１つ、\n実現してくれるという\n契約になっている。"},
        { "location": "306/DIALOG"  , "narrator": "", "text": "わたしはその契約で、\nお母さんの病気を治してもらえるよう\n政府の人にお願いした。\n\nお父さんとお母さんは\n高いお金を使って\n自分よりも先に、\n私の病気を治してくれたから―。"},
        { "location": "307/TALK"    , "narrator": "つばめ", "text": "お母さんに\n早く元気になって\n欲しいし――"},
        { "location": "308/TALK"    , "narrator": "つばめ", "text": "わたしそれを\n政府の人に\nお願いしたから！"},
        { "location": "309/TALK"    , "narrator": "啓介", "text": "馬鹿者！！"},
        { "location": "310/TALK"    , "narrator": "啓介", "text": "子供はそんなこと\n考えなくていいんだ！"},
        { "location": "312/TALK"    , "narrator": "つばめ", "text": "わたしはもう\n子供じゃありません！"},
        { "location": "314/TALK"    , "narrator": "つばめ", "text": "もう十分大人に\nなったんだよ！"},
        { "location": "315/TALK"    , "narrator": "啓介", "text": "バカも休み休み言え！\nとにかくダメだ！\nすぐ帰ってこい！"},
        { "location": "317/TALK"    , "narrator": "つばめ", "text": "いやだ！"},
        { "location": "318/TALK"    , "narrator": "啓介", "text": "ダメだ！"},
        { "location": "320/TALK"    , "narrator": "つばめ", "text": "お父さん嫌い！！"},
        { "location": "335/TALK"    , "narrator": "つばめ", "text": "結局この時の電話は\nケンカしたまま\n切っちゃって――"},
        { "location": "337/TALK"    , "narrator": "つばめ", "text": "その後もずっと\n一度もお話して\nないんだよね。"},
        { "location": "338/TALK"    , "narrator": "つばめ", "text": "……えっと、\nどう思う？"},
        { "location": "339/TALK"    , "narrator": "つばめ", "text": "わたしの言ってること\nそんなにダメかな？"},
        { "location": "340/SEL"     , "narrator": "（選択肢）", "text": "つばめの気持ちはわかる"},
        { "location": "341/SEL"     , "narrator": "（選択肢）", "text": "お父さんの気持ちはわかる"},
        { "location": "342/SEL"     , "narrator": "（選択肢）", "text": "二人の気持ちはどっちもわかる"},
        { "location": "343/ACT"     , "narrator": "", "text": "つばめの気持ちはわかる"},
        { "location": "344/TALK"    , "narrator": "つばめ", "text": "ありがとう。\nそう言ってもらえて\n少し安心したよ。"},
        { "location": "345/ACT"     , "narrator": "", "text": "お父さんの気持ちはわかる"},
        { "location": "347/TALK"    , "narrator": "つばめ", "text": "えっ！\nどうして！？"},
        { "location": "348/SEL"     , "narrator": "（選択肢）", "text": "つばめに危ないことをして欲しくないんだよ"},
        { "location": "349/SEL"     , "narrator": "（選択肢）", "text": "つばめと離れたくないんだよ"},
        { "location": "350/ACT"     , "narrator": "", "text": "つばめに危ないことをして欲しくないんだよ"},
        { "location": "351/TALK"    , "narrator": "つばめ", "text": "それは……\nそうかもしれないけど…"},
        { "location": "352/ACT"     , "narrator": "", "text": "つばめと離れたくないんだよ"},
        { "location": "353/TALK"    , "narrator": "つばめ", "text": "わたしだって、\n一人は心細いよ？"},
        { "location": "355/TALK"    , "narrator": "つばめ", "text": "でも、わたし\n今回はどうしても\nやりたいの！"},
        { "location": "356/ACT"     , "narrator": "", "text": "二人の気持ちはどっちもわかる"},
        { "location": "358/TALK"    , "narrator": "つばめ", "text": "うっ……\nその言い方はずるいよ。"},
        { "location": "359/SEL"     , "narrator": "（選択肢）", "text": "本当にそう思うんだって"},
        { "location": "360/SEL"     , "narrator": "（選択肢）", "text": "大人の対応"},
        { "location": "361/ACT"     , "narrator": "", "text": "本当にそう思うんだって"},
        { "location": "363/TALK"    , "narrator": "つばめ", "text": "そっか。\n真剣に考えてくれて\nありがとう。"},
        { "location": "364/ACT"     , "narrator": "", "text": "大人の対応"},
        { "location": "365/TALK"    , "narrator": "つばめ", "text": "そういうのを\n大人の対応って\nいうんだ。"},
        { "location": "366/TALK"    , "narrator": "つばめ", "text": "よくわからないわたしは\nやっぱり子供なのかな。"},
        { "location": "369/TALK"    , "narrator": "つばめ", "text": "わたしね、お母さんに\nずっと助けられて\n生きてきたんだ。"},
        { "location": "370/TALK"    , "narrator": "つばめ", "text": "だからどうしても、\nお母さんに恩返し\nしたくて。"},
        { "location": "371/TALK"    , "narrator": "つばめ", "text": "自分の力がみんなの\n役に立って、お母さん\nも幸せにできるなら――"},
        { "location": "372/TALK"    , "narrator": "つばめ", "text": "こんなにいいことは\nないよねって、そう\n思ったんだ。"},
        { "location": "373/TALK"    , "narrator": "つばめ", "text": "だからね、お父さんに\nもう一度話してみようと\n思う。"},
        { "location": "375/TALK"    , "narrator": "つばめ", "text": "わかってもらえるまで\n何度でも。"},
        { "location": "377/TALK"    , "narrator": "つばめ", "text": "時間はかかるかも\nしれないけど、自分で\n決めた事だもん。"},
        { "location": "378/TALK"    , "narrator": "つばめ", "text": "頑張るよ。"},
        { "location": "380/TALK"    , "narrator": "つばめ", "text": "こんな風に思えるのも\n$handle$さんの\nお陰だよ？"},
        { "location": "381/TALK"    , "narrator": "つばめ", "text": "これからも色々\n相談しちゃうかもだけど\nその時はよろしくね。"},
        { "location": "382/SEL"     , "narrator": "（選択肢）", "text": "まかせておけ！"},
        { "location": "383/SEL"     , "narrator": "（選択肢）", "text": "程々に"},
        { "location": "384/SEL"     , "narrator": "（選択肢）", "text": "そのかわり、お義父さん紹介してね？"},
        { "location": "385/ACT"     , "narrator": "", "text": "まかせておけ！"},
        { "location": "387/TALK"    , "narrator": "つばめ", "text": "えへへ、ありがと。"},
        { "location": "392/TALK"    , "narrator": "つばめ", "text": "今回は\n本当にありがとう。"},
        { "location": "393/ACT"     , "narrator": "", "text": "程々に"},
        { "location": "394/TALK"    , "narrator": "つばめ", "text": "うん、それでいいよ？"},
        { "location": "397/TALK"    , "narrator": "つばめ", "text": "今回は\n本当にありがとう。"},
        { "location": "398/ACT"     , "narrator": "", "text": "そのかわり、お義父さん紹介してね？"},
        { "location": "399/TALK"    , "narrator": "つばめ", "text": "えっ！？\nなんでそうなるの？"},
        { "location": "400/TALK"    , "narrator": "つばめ", "text": "まあいいけど、\nでもどうやって\n紹介すればいいのかな。"},
        { "location": "401/SEL"     , "narrator": "（選択肢）", "text": "「友だちです」って"},
        { "location": "402/SEL"     , "narrator": "（選択肢）", "text": "「フィアンセです」って"},
        { "location": "403/SEL"     , "narrator": "（選択肢）", "text": "「手合わせ願いたい」って"},
        { "location": "404/ACT"     , "narrator": "", "text": "「友だちです」って"},
        { "location": "406/TALK"    , "narrator": "つばめ", "text": "んー、いいけど――"},
        { "location": "408/TALK"    , "narrator": "つばめ", "text": "スルーされて\n終わりだと思うなぁ。"},
        { "location": "409/TALK"    , "narrator": "つばめ", "text": "うちのお父さん、\n自分と関係無いことは\n話さない人だから。"},
        { "location": "410/ACT"     , "narrator": "", "text": "「フィアンセです」って"},
        { "location": "412/TALK"    , "narrator": "つばめ", "text": "えええっ！！\nそれはやめた方が\nいいよ。"},
        { "location": "413/TALK"    , "narrator": "つばめ", "text": "多分わたしのスマホ\n壊されちゃうよ。"},
        { "location": "414/TALK"    , "narrator": "つばめ", "text": "でも、もし\n$handle$さんと\n出逢うことができて――"},
        { "location": "415/TALK"    , "narrator": "つばめ", "text": "二人とも好きに\nなっちゃったら\n覚悟決めないとね。"},
        { "location": "417/TALK"    , "narrator": "つばめ", "text": "そのときは\nがんばってね。"},
        { "location": "418/ACT"     , "narrator": "", "text": "「手合わせ願いたい」って"},
        { "location": "420/TALK"    , "narrator": "つばめ", "text": "えええっ！！\nそれはやめた方が\nいいよ。"},
        { "location": "421/TALK"    , "narrator": "つばめ", "text": "うちのお父さん、\n柔道すごく強いんだよ。"},
        { "location": "422/SEL"     , "narrator": "（選択肢）", "text": "望むところ"},
        { "location": "423/SEL"     , "narrator": "（選択肢）", "text": "囲碁か将棋でお願いします…"},
        { "location": "424/ACT"     , "narrator": "", "text": "望むところ"},
        { "location": "425/TALK"    , "narrator": "つばめ", "text": "$handle$さんも\n柔道強いんだ！"},
        { "location": "426/TALK"    , "narrator": "つばめ", "text": "それじゃ、逢えたら\n是非紹介するね。"},
        { "location": "427/TALK"    , "narrator": "つばめ", "text": "最近柔道できなくて\n溜め込んでる\nみたいだから。"},
        { "location": "428/ACT"     , "narrator": "", "text": "囲碁か将棋でお願いします…"},
        { "location": "429/TALK"    , "narrator": "つばめ", "text": "あ、そっちなんだ。"},
        { "location": "430/TALK"    , "narrator": "つばめ", "text": "でもそっちも\nお父さん結構\n強いんだよね。"},
        { "location": "433/TALK"    , "narrator": "つばめ", "text": "とは言ってるけど、\nなんかわたしね…"},
        { "location": "434/TALK"    , "narrator": "つばめ", "text": "$handle$さんを\nお父さんに会わせる\n事になるんじゃって――"},
        { "location": "435/TALK"    , "narrator": "つばめ", "text": "そんな気もしてるんだ。\n理由はわからないけど。"},
        { "location": "436/TALK"    , "narrator": "つばめ", "text": "もちろん、\n$handle$さん\n次第だけどね。"},
        { "location": "438/TALK"    , "narrator": "つばめ", "text": "話が逸れちゃったけど、\n今回はありがとう。"},
        { "location": "440/TALK"    , "narrator": "つばめ", "text": "わたし、お父さんが\n許してくれるまで\nちゃんと説得するよ。"},
        { "location": "442/TALK"    , "narrator": "つばめ", "text": "家族だもんね。\nえへへ……。"},
        { "location": "444/TALK"    , "narrator": "つばめ", "text": "それじゃ、またね！"},
        { "location": "470/TALK"    , "narrator": "千羽鶴", "text": "なかなかの\nココロ裁き。\n順風満帆ね。"},
        { "location": "471/SEL"     , "narrator": "（選択肢）", "text": "つばめのお父さんと会ったぜ！"},
        { "location": "472/SEL"     , "narrator": "（選択肢）", "text": "つばめのお父さんは本物？"},
        { "location": "473/ACT"     , "narrator": "", "text": "つばめのお父さんと会ったぜ！"},
        { "location": "474/TALK"    , "narrator": "千羽鶴", "text": "つばめの心の中のね。"},
        { "location": "475/ACT"     , "narrator": "", "text": "つばめのお父さんは本物？"},
        { "location": "476/TALK"    , "narrator": "千羽鶴", "text": "いいえ。"},
        { "location": "478/TALK"    , "narrator": "千羽鶴", "text": "貴方が出逢った\n逢瀬つばめの父、\n啓介は彼女の妄想。"},
        { "location": "480/TALK"    , "narrator": "千羽鶴", "text": "ここは\n逢瀬つばめの\n心の中。"},
        { "location": "482/TALK"    , "narrator": "千羽鶴", "text": "そこで出てくる人物は\n全て、彼女が想い描く\n勝手な人物像。"},
        { "location": "483/SEL"     , "narrator": "（選択肢）", "text": "じゃあ、全部嘘ってこと？"},
        { "location": "484/ACT"     , "narrator": "", "text": "じゃあ、全部嘘ってこと？"},
        { "location": "486/TALK"    , "narrator": "千羽鶴", "text": "いいえ。"},
        { "location": "487/TALK"    , "narrator": "千羽鶴", "text": "もちろん、合っている\n部分は多い。でも――"},
        { "location": "488/TALK"    , "narrator": "千羽鶴", "text": "その一部は、自分に\n都合のいいようにねじ\n曲げられていたり――"},
        { "location": "489/TALK"    , "narrator": "千羽鶴", "text": "先入観で\n作られていたり――"},
        { "location": "490/TALK"    , "narrator": "千羽鶴", "text": "自分をよく見せる\nためにわざと印象悪く\n見せる時もある。"},
        { "location": "491/TALK"    , "narrator": "千羽鶴", "text": "貴方も他人に誰かの\n話をするときに、\nそういう事しない？"},
        { "location": "492/SEL"     , "narrator": "（選択肢）", "text": "しますね…"},
        { "location": "493/SEL"     , "narrator": "（選択肢）", "text": "しません！"},
        { "location": "494/ACT"     , "narrator": "", "text": "しますね…"},
        { "location": "495/TALK"    , "narrator": "千羽鶴", "text": "正直者ね。素敵。"},
        { "location": "496/ACT"     , "narrator": "", "text": "しません！"},
        { "location": "497/TALK"    , "narrator": "千羽鶴", "text": "正直者なのね…。\n世渡り大変そう。"},
        { "location": "499/TALK"    , "narrator": "千羽鶴", "text": "心の中では\nそれがよりリアリティを\nもって再現される。"},
        { "location": "500/TALK"    , "narrator": "千羽鶴", "text": "だから、細心の注意を\nするように。"},
        { "location": "501/TALK"    , "narrator": "千羽鶴", "text": "まあでも……"},
        { "location": "502/TALK"    , "narrator": "千羽鶴", "text": "何度か痛い目を見れば\nなれると思うから\n心配しなくても大丈夫。"},
        { "location": "503/TALK"    , "narrator": "千羽鶴", "text": "それじゃ、\n現実世界に送還する。"},
        { "location": "505/TALK"    , "narrator": "千羽鶴", "text": "貴方にも良い夢を――。"}
    ]
}
