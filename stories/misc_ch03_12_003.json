        { "location": "209/TALK"    , "narrator": "ガブリエラ", "text": "紅茶には"},
        { "location": "210/TALK"    , "narrator": "ガブリエラ", "text": "はちみつよね"},
        { "location": "212/SEL"     , "narrator": "", "text": "どうかな……"},
        { "location": "213/SEL"     , "narrator": "", "text": "コーヒー派なんで"},
        { "location": "214/SEL"     , "narrator": "", "text": "はちみつだよね！"},
        { "location": "215/ACT"     , "narrator": "", "text": "どうかな……"},
        { "location": "216/TALK"    , "narrator": "ガブリエラ", "text": "はちみつよ！"},
        { "location": "217/TALK"    , "narrator": "ガブリエラ", "text": "はちみつ！"},
        { "location": "218/ACT"     , "narrator": "", "text": "コーヒー派なんで"},
        { "location": "219/TALK"    , "narrator": "ガブリエラ", "text": "あら？"},
        { "location": "220/TALK"    , "narrator": "ガブリエラ", "text": "そうなのね？"},
        { "location": "221/ACT"     , "narrator": "", "text": "はちみつだよね！"},
        { "location": "223/TALK"    , "narrator": "ガブリエラ", "text": "そうよね♪"},
        { "location": "224/TALK"    , "narrator": "ガブリエラ", "text": "はちみつに決まっているわよねｖ"},
        { "location": "226/TALK"    , "narrator": "ガブリエラ", "text": "砂糖だと紅茶が黒くならないし"},
        { "location": "227/TALK"    , "narrator": "ガブリエラ", "text": "物足りないわ"},
        { "location": "229/SEL"     , "narrator": "", "text": "ごめん意味がわからない"},
        { "location": "230/SEL"     , "narrator": "", "text": "そこなの？"},
        { "location": "231/SEL"     , "narrator": "", "text": "タンニンがタンニン鉄になるからだね"},
        { "location": "232/ACT"     , "narrator": "", "text": "ごめん意味がわからない"},
        { "location": "233/TALK"    , "narrator": "ガブリエラ", "text": "えっ"},
        { "location": "234/TALK"    , "narrator": "ガブリエラ", "text": "そうかしら？？？"},
        { "location": "235/ACT"     , "narrator": "", "text": "そこなの？"},
        { "location": "236/TALK"    , "narrator": "ガブリエラ", "text": "えっ"},
        { "location": "237/TALK"    , "narrator": "ガブリエラ", "text": "おかしいかしら？？？"},
        { "location": "238/ACT"     , "narrator": "", "text": "タンニンがタンニン鉄になるからだね"},
        { "location": "240/TALK"    , "narrator": "ガブリエラ", "text": "何なのかしらそれ？"},
        { "location": "242/SEL"     , "narrator": "", "text": "はちみつには鉄分が含まれている"},
        { "location": "243/ACT"     , "narrator": "", "text": "はちみつには鉄分が含まれている"},
        { "location": "244/TALK"    , "narrator": "ガブリエラ", "text": "そうなのね"},
        { "location": "247/SEL"     , "narrator": "", "text": "それが紅茶のタンニンと結びつく"},
        { "location": "248/ACT"     , "narrator": "", "text": "それが紅茶のタンニンと結びつく"},
        { "location": "249/TALK"    , "narrator": "ガブリエラ", "text": "ふうん？"},
        { "location": "252/SEL"     , "narrator": "", "text": "タンニン鉄が紅茶を黒く見せる"},
        { "location": "253/ACT"     , "narrator": "", "text": "タンニン鉄が紅茶を黒く見せる"},
        { "location": "254/TALK"    , "narrator": "ガブリエラ", "text": "そういうことなのね！"},
        { "location": "257/TALK"    , "narrator": "ガブリエラ", "text": "はちみつの出てくるカフェが"},
        { "location": "258/TALK"    , "narrator": "ガブリエラ", "text": "もっと増えればいいのに"},
        { "location": "259/TALK"    , "narrator": "ガブリエラ", "text": "少ないわよね"},
        { "location": "260/TALK"    , "narrator": "ガブリエラ", "text": "んー・・・"}
