{
    "dir": "dramatics/daydra/drm_ch04_00_350.js",
    "type": "Episode",
    "info": {
        "story_id": "4035",
        "cid": "miyabi",
        "title": "らぶとーく 第35話",
        "sub_title": "ラブという名の何か"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "ラブという名の何か"},
        { "location": "18/TALK"   , "narrator": "みやび", "text": "ほぅ…あの掲示板で\nアクセス規制されたが？"},
        { "location": "19/TALK"   , "narrator": "繭", "text": "はい。\n正直、お手上げ状態です。"},
        { "location": "20/TALK"   , "narrator": "みやび", "text": "アクセス規制程度で\n音を上げてたら、\nハッカーの名が泣くぞね？"},
        { "location": "22/TALK"   , "narrator": "繭", "text": "ですが、あそこの掲示板の\n鉄壁のセキュリティは\n知っているでしょう？"},
        { "location": "23/TALK"   , "narrator": "繭", "text": "今まで何人のハッカーが、\nあのシステム内への\n侵入を試み――"},
        { "location": "24/TALK"   , "narrator": "繭", "text": "悉く失敗して、\n不正アクセス者として\n規制を受けたか…。"},
        { "location": "25/TALK"   , "narrator": "みやび", "text": "うちもちっくと\n見に行ったがよ。"},
        { "location": "26/TALK"   , "narrator": "みやび", "text": "管理人、相当の\n手練れやね。"},
        { "location": "28/TALK"   , "narrator": "みやび", "text": "そつがない、ゆう\nレベルやない。"},
        { "location": "29/TALK"   , "narrator": "みやび", "text": "隙がない。\n見事なもんや。"},
        { "location": "30/TALK"   , "narrator": "みやび", "text": "その掲示板にハッキング\nするゆうんは、挑戦状を\n叩きつけるも同等や。"},
        { "location": "31/TALK"   , "narrator": "みやび", "text": "それでアクセス規制だけで\n済んでるき、ありがたく\n思わんといかんよ。"},
        { "location": "33/TALK"   , "narrator": "繭", "text": "…リベンジするためにも、\n相談に乗っていただけ\nませんか？"},
        { "location": "35/TALK"   , "narrator": "みやび", "text": "それは構わんが…。"},
        { "location": "38/TALK"   , "narrator": "みやび", "text": "そうや、なら$handle$も\n混ぜて話そう。"},
        { "location": "39/TALK"   , "narrator": "繭", "text": "…本気ですか？"},
        { "location": "40/TALK"   , "narrator": "繭", "text": "彼はこの手の会話には、\nあまり慣れていないように\n思いますので――"},
        { "location": "41/TALK"   , "narrator": "繭", "text": "話したとしても会話に\nついてこれないと\n思うのですが…。"},
        { "location": "43/TALK"   , "narrator": "みやび", "text": "まあ、素人だからこそ\n聞いて勉強しろっちゅう\nことや。"},
        { "location": "51/TALK"   , "narrator": "みやび", "text": "ちりんちりん"},
        { "location": "52/TALK"   , "narrator": "みやび", "text": "Ｋｎｏｃｋ　Ｋｎｏｃｋ！"},
        { "location": "54/SEL"    , "narrator": "", "text": "呼んだ？"},
        { "location": "55/SEL"    , "narrator": "", "text": "待ってたよ"},
        { "location": "56/SEL"    , "narrator": "", "text": "今忙しい"},
        { "location": "57/ACT"    , "narrator": "", "text": "呼んだ？"},
        { "location": "58/TALK"   , "narrator": "みやび", "text": "うむ"},
        { "location": "60/TALK"   , "narrator": "みやび", "text": "貴殿はいつも反応するな"},
        { "location": "62/SEL"    , "narrator": "", "text": "反応したら悪い？"},
        { "location": "63/ACT"    , "narrator": "", "text": "反応したら悪い？"},
        { "location": "66/TALK"   , "narrator": "みやび", "text": "反応に文句はない"},
        { "location": "67/TALK"   , "narrator": "みやび", "text": "だが"},
        { "location": "68/TALK"   , "narrator": "みやび", "text": "その返しは悪い！"},
        { "location": "69/TALK"   , "narrator": "みやび", "text": "残念！！"},
        { "location": "75/TALK"   , "narrator": "みやび", "text": "…まったく。"},
        { "location": "76/TALK"   , "narrator": "繭", "text": "みやび先輩？\n$handle$さんは\nどうしたんですか？"},
        { "location": "78/TALK"   , "narrator": "みやび", "text": "気が変わっただけちや。"},
        { "location": "79/TALK"   , "narrator": "みやび", "text": "今日はウサギと二人で、\nじっくり語り合うことに\nしたがよ。"},
        { "location": "80/TALK"   , "narrator": "繭", "text": "はぁ…いえ、それは\n光栄ではありますが…。"},
        { "location": "81/TALK"   , "narrator": "繭", "text": "…あの一瞬でみやび先輩の\n機嫌を害せるなんて…\nただ者じゃない。"},
        { "location": "82/ACT"    , "narrator": "", "text": "待ってたよ"},
        { "location": "83/TALK"   , "narrator": "みやび", "text": "うむ"},
        { "location": "84/TALK"   , "narrator": "みやび", "text": "そうだろう"},
        { "location": "85/TALK"   , "narrator": "みやび", "text": "私もあなたと喋りたかったの☆"},
        { "location": "86/TALK"   , "narrator": "みやび", "text": "なんてキャラではないけんど"},
        { "location": "87/TALK"   , "narrator": "みやび", "text": "うちも相棒と喋りたかったぞね"},
        { "location": "89/SEL"    , "narrator": "", "text": "それで、どうかしたの？"},
        { "location": "90/ACT"    , "narrator": "", "text": "それで、どうかしたの？"},
        { "location": "92/TALK"   , "narrator": "みやび", "text": "大胆ね"},
        { "location": "93/TALK"   , "narrator": "みやび", "text": "いやん"},
        { "location": "95/SEL"    , "narrator": "", "text": "何が！？"},
        { "location": "96/ACT"    , "narrator": "", "text": "何が！？"},
        { "location": "98/TALK"   , "narrator": "みやび", "text": "いや"},
        { "location": "99/TALK"   , "narrator": "みやび", "text": "ウサギに見せつけたい"},
        { "location": "100/TALK"  , "narrator": "みやび", "text": "うちらの仲の良さ！"},
        { "location": "101/TALK"  , "narrator": "みやび", "text": "うちらの友情は凄い！"},
        { "location": "103/TALK"  , "narrator": "みやび", "text": "友情以上やき！"},
        { "location": "104/TALK"  , "narrator": "みやび", "text": "フレンドの上はハイパーフレンド？"},
        { "location": "105/TALK"  , "narrator": "みやび", "text": "もしくは"},
        { "location": "107/TALK"  , "narrator": "みやび", "text": "そんなもんどうでもえい！"},
        { "location": "108/TALK"  , "narrator": "みやび", "text": "とにかく見せつけよう"},
        { "location": "109/TALK"  , "narrator": "みやび", "text": "アーユ－レディー？"},
        { "location": "111/SEL"   , "narrator": "", "text": "わざわざしなくて良くない？"},
        { "location": "112/SEL"   , "narrator": "", "text": "準備はＯＫだ"},
        { "location": "113/ACT"   , "narrator": "", "text": "わざわざしなくて良くない？"},
        { "location": "115/TALK"  , "narrator": "みやび", "text": "いや"},
        { "location": "116/TALK"  , "narrator": "みやび", "text": "まあそうだが"},
        { "location": "118/TALK"  , "narrator": "みやび", "text": "面白そうだし"},
        { "location": "119/TALK"  , "narrator": "みやび", "text": "そう"},
        { "location": "120/TALK"  , "narrator": "みやび", "text": "絶対面白い"},
        { "location": "122/TALK"  , "narrator": "みやび", "text": "やるべきなのだ！"},
        { "location": "123/TALK"  , "narrator": "みやび", "text": "声を上げよ"},
        { "location": "124/TALK"  , "narrator": "みやび", "text": "見せてやろうと！"},
        { "location": "126/SEL"   , "narrator": "", "text": "いや、見せなくていいでしょ？"},
        { "location": "127/ACT"   , "narrator": "", "text": "いや、見せなくていいでしょ？"},
        { "location": "130/TALK"  , "narrator": "みやび", "text": "なー"},
        { "location": "131/TALK"  , "narrator": "みやび", "text": "うあーうあー"},
        { "location": "132/TALK"  , "narrator": "みやび", "text": "なんやそれー"},
        { "location": "133/TALK"  , "narrator": "みやび", "text": "萎える―マジ萎えるー"},
        { "location": "135/TALK"  , "narrator": "みやび", "text": "まあ"},
        { "location": "136/TALK"  , "narrator": "みやび", "text": "ならえいわ"},
        { "location": "143/TALK"  , "narrator": "みやび", "text": "はぁ…。"},
        { "location": "144/TALK"  , "narrator": "繭", "text": "…何かありましたか？"},
        { "location": "146/TALK"  , "narrator": "みやび", "text": "ん…。"},
        { "location": "148/TALK"  , "narrator": "みやび", "text": "いや、何でもないちや。"},
        { "location": "149/TALK"  , "narrator": "繭", "text": "そうですか？"},
        { "location": "150/TALK"  , "narrator": "繭", "text": "何となく、落ち込んでいる\nように見えるのですが？"},
        { "location": "151/TALK"  , "narrator": "みやび", "text": "いや、平気や。"},
        { "location": "152/TALK"  , "narrator": "みやび", "text": "期待を裏切られて\nしもうて、ちっくと\nつまらんだけや…。"},
        { "location": "155/TALK"  , "narrator": "みやび", "text": "はぁ…何か不味ったか？\nいや、うちが間違うなど\nありえんちや…多分…。"},
        { "location": "156/TALK"  , "narrator": "繭", "text": "…何があったのか、\n気になる…。"},
        { "location": "157/ACT"   , "narrator": "", "text": "準備はＯＫだ"},
        { "location": "159/TALK"  , "narrator": "みやび", "text": "感謝"},
        { "location": "160/TALK"  , "narrator": "みやび", "text": "感激"},
        { "location": "161/TALK"  , "narrator": "みやび", "text": "雨有られ"},
        { "location": "163/TALK"  , "narrator": "みやび", "text": "おのれクソ変換機能！！"},
        { "location": "164/TALK"  , "narrator": "みやび", "text": "とりあえずウサギ召喚！"},
        { "location": "167/TALK"  , "narrator": "ラビットアニマ", "text": "こんにちは"},
        { "location": "168/TALK"  , "narrator": "みやび", "text": "よし"},
        { "location": "169/TALK"  , "narrator": "みやび", "text": "楽しく話そう"},
        { "location": "171/TALK"  , "narrator": "ラビットアニマ", "text": "しかし$handle$さんは、本当に話に付いてこれる"},
        { "location": "172/TALK"  , "narrator": "ラビットアニマ", "text": "？"},
        { "location": "174/SEL"   , "narrator": "", "text": "結構不安"},
        { "location": "175/ACT"   , "narrator": "", "text": "結構不安"},
        { "location": "177/TALK"  , "narrator": "みやび", "text": "安心せよ"},
        { "location": "178/TALK"  , "narrator": "みやび", "text": "うちが手取り足取り教えてあげちゃう"},
        { "location": "179/TALK"  , "narrator": "みやび", "text": "実際に触れはせんけんど"},
        { "location": "181/TALK"  , "narrator": "ラビットアニマ", "text": "？"},
        { "location": "182/TALK"  , "narrator": "ラビットアニマ", "text": "テンション高いですね？"},
        { "location": "183/SEL"   , "narrator": "", "text": "みやびは安くない女だからな"},
        { "location": "184/ACT"   , "narrator": "", "text": "みやびは安くない女だからな"},
        { "location": "186/TALK"  , "narrator": "みやび", "text": "その言い方にトキメキ感じた"},
        { "location": "187/TALK"  , "narrator": "みやび", "text": "トキメキよくわからんけど"},
        { "location": "190/TALK"  , "narrator": "ラビットアニマ", "text": "本当大丈夫ですか？"},
        { "location": "191/TALK"  , "narrator": "ラビットアニマ", "text": "ていうか、凄い楽しそうな顔してますが？"},
        { "location": "192/TALK"  , "narrator": "みやび", "text": "リアルを見るな"},
        { "location": "193/TALK"  , "narrator": "みやび", "text": "チャット画面を見よ"},
        { "location": "194/TALK"  , "narrator": "みやび", "text": "現実から目を反らせ"},
        { "location": "196/TALK"  , "narrator": "ラビットアニマ", "text": "意味が違ってしまいます"},
        { "location": "197/TALK"  , "narrator": "みやび", "text": "あ"},
        { "location": "198/TALK"  , "narrator": "みやび", "text": "相棒はリアルやぞ？"},
        { "location": "199/TALK"  , "narrator": "みやび", "text": "顔知らんけんど"},
        { "location": "200/TALK"  , "narrator": "みやび", "text": "リア友や"},
        { "location": "201/TALK"  , "narrator": "みやび", "text": "画面内のリア友？"},
        { "location": "202/TALK"  , "narrator": "みやび", "text": "メルヘン童話みたいや"},
        { "location": "204/TALK"  , "narrator": "ラビットアニマ", "text": "とりあえず"},
        { "location": "205/TALK"  , "narrator": "ラビットアニマ", "text": "本題に移りましょう"},
        { "location": "206/TALK"  , "narrator": "みやび", "text": "遊び過ぎた"},
        { "location": "208/TALK"  , "narrator": "ラビットアニマ", "text": "過ぎましたね"},
        { "location": "209/TALK"  , "narrator": "ラビットアニマ", "text": "早く本題に移りましょう"},
        { "location": "210/TALK"  , "narrator": "みやび", "text": "あいあい"},
        { "location": "211/TALK"  , "narrator": "みやび", "text": "相棒にもわかりやすいように"},
        { "location": "212/TALK"  , "narrator": "みやび", "text": "手取り足取り教えながらな"},
        { "location": "214/SEL"   , "narrator": "", "text": "手足触ってもらえるの？"},
        { "location": "215/ACT"   , "narrator": "", "text": "手足触ってもらえるの？"},
        { "location": "217/TALK"  , "narrator": "みやび", "text": "ほほぅ？"},
        { "location": "218/TALK"  , "narrator": "みやび", "text": "さわさわしてえいがかぁ？"},
        { "location": "223/ACT"   , "narrator": "", "text": "今忙しい"},
        { "location": "224/TALK"  , "narrator": "みやび", "text": "マジか？"},
        { "location": "225/TALK"  , "narrator": "みやび", "text": "いつもは平気なのに"},
        { "location": "226/TALK"  , "narrator": "みやび", "text": "いや"},
        { "location": "227/TALK"  , "narrator": "みやび", "text": "わかったぞ"},
        { "location": "228/TALK"  , "narrator": "みやび", "text": "ツンデレモードやな？"},
        { "location": "231/SEL"   , "narrator": "", "text": "別にみやびと話したくないわけじゃないんだからね！"},
        { "location": "232/ACT"   , "narrator": "", "text": "別にみやびと話したくないわけじゃないんだからね！"},
        { "location": "234/TALK"  , "narrator": "みやび", "text": "やはりか！"},
        { "location": "236/TALK"  , "narrator": "みやび", "text": "ツンデレさんめ"},
        { "location": "237/TALK"  , "narrator": "みやび", "text": "じゃあ"},
        { "location": "238/TALK"  , "narrator": "みやび", "text": "また別の機会にな"}
    ]
}
