        { "location": "462/TALK", "narrator": "神楽", "text": "知ってるし"},
        { "location": "463/TALK", "narrator": "神楽", "text": "ぴょんこに用事ぴょん？"},
        { "location": "466/SEL" , "narrator": "", "text": "ちょっと着替えてほしいんだ"},
        { "location": "467/ACT" , "narrator": "", "text": "ちょっと着替えてほしいんだ"},
        { "location": "477/TALK", "narrator": "神楽", "text": "意味不明すぎ"},
        { "location": "478/TALK", "narrator": "神楽", "text": "でもまあ"},
        { "location": "479/TALK", "narrator": "神楽", "text": "優しいぴょんこは聞いてあげるのだった"},
        { "location": "481/TALK", "narrator": "神楽", "text": "は？"},
        { "location": "482/TALK", "narrator": "神楽", "text": "この服変だった？"},
        { "location": "483/TALK", "narrator": "神楽", "text": "なら着替えるけど"},
