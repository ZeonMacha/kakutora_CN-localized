        { "location": "443/TALK", "narrator": "プレイヤー", "text": "よし、お着替えタイムだ！"},
        { "location": "449/TALK", "narrator": "プレイヤー", "text": "やあ"},
        { "location": "451/TALK", "narrator": "プレイヤー", "text": "こんにちは"},
        { "location": "453/TALK", "narrator": "プレイヤー", "text": "げんき？"},
        { "location": "456/TALK", "narrator": "神楽", "text": "ぴょんこを呼ぶ声"},
        { "location": "457/TALK", "narrator": "神楽", "text": "あなたはだあれ？"},
