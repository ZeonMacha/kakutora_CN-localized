    "entry":
    [
        { "location": "118/SCENARIO", "narrator": "", "text": "020_昼下がりなら午睡ぞね"},
        { "location": "143/TALK"    , "narrator": "みやび", "text": "昼間寝ても寝ても"},
        { "location": "144/TALK"    , "narrator": "みやび", "text": "眠いのはどういうことかね"},
        { "location": "147/SEL"     , "narrator": "", "text": "寝すぎ"},
        { "location": "148/SEL"     , "narrator": "", "text": "実は眠り姫だから"},
        { "location": "149/SEL"     , "narrator": "", "text": "夜遅くまで起きてるから"},
        { "location": "150/ACT"     , "narrator": "", "text": "寝すぎ"},
        { "location": "151/TALK"    , "narrator": "みやび", "text": "そうかな"},
        { "location": "152/ACT"     , "narrator": "", "text": "実は眠り姫だから"},
        { "location": "153/TALK"    , "narrator": "みやび", "text": "そういうことは"},
        { "location": "154/TALK"    , "narrator": "みやび", "text": "ガブちゃんに言ってやれ"},
        { "location": "155/ACT"     , "narrator": "", "text": "夜遅くまで起きてるから"},
        { "location": "157/TALK"    , "narrator": "みやび", "text": "おお"},
        { "location": "158/TALK"    , "narrator": "みやび", "text": "ばれていたか"},
        { "location": "159/TALK"    , "narrator": "みやび", "text": "侮れん"},
        { "location": "161/TALK"    , "narrator": "みやび", "text": "そんなわけで"},
        { "location": "162/TALK"    , "narrator": "みやび", "text": "昼寝の時間を増やそうかと"},
        { "location": "164/SEL"     , "narrator": "", "text": "じゃあ添い寝してあげる"},
        { "location": "165/SEL"     , "narrator": "", "text": "夜寝ようよ"},
        { "location": "166/SEL"     , "narrator": "", "text": "いいんじゃない"},
        { "location": "167/ACT"     , "narrator": "", "text": "じゃあ添い寝してあげる"},
        { "location": "169/TALK"    , "narrator": "みやび", "text": "それはなかなか"},
        { "location": "170/TALK"    , "narrator": "みやび", "text": "シュールな光景が"},
        { "location": "171/TALK"    , "narrator": "みやび", "text": "気に入った"},
        { "location": "173/TALK"    , "narrator": "みやび", "text": "よしよし"},
        { "location": "174/ACT"     , "narrator": "", "text": "夜寝ようよ"},
        { "location": "175/TALK"    , "narrator": "みやび", "text": "まあ"},
        { "location": "176/TALK"    , "narrator": "みやび", "text": "正論だ"},
        { "location": "177/ACT"     , "narrator": "", "text": "いいんじゃない"},
        { "location": "178/TALK"    , "narrator": "みやび", "text": "いいかな？？"},
        { "location": "179/TALK"    , "narrator": "みやび", "text": "いいよー！"},
        { "location": "181/TALK"    , "narrator": "みやび", "text": "しかしこの計画には問題が"},
        { "location": "182/TALK"    , "narrator": "みやび", "text": "平日は学校ちうもんがあるぞね"},
        { "location": "184/TALK"    , "narrator": "みやび", "text": "昼休み以上睡眠をとるわけにはいかんぞね"},
        { "location": "185/TALK"    , "narrator": "みやび", "text": "計画失敗！！！"}
    ]
