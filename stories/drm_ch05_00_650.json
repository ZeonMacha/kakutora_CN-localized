        { "location": "887/TALK"    , "narrator": "神楽", "text": "いいんだけど、、、"},
        { "location": "888/ACT"     , "narrator": "", "text": "いやそんなことないでしょ"},
        { "location": "889/TALK"    , "narrator": "神楽", "text": "なんで？"},
        { "location": "890/TALK"    , "narrator": "神楽", "text": "そんなに落ち着いていられるの？？？"},
