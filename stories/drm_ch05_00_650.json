        { "location": "874/TALK"    , "narrator": "神楽", "text": "ココロはひとつだったとしても"},
        { "location": "875/TALK"    , "narrator": "神楽", "text": "物理的な距離が遠すぎるじゃん？"},
        { "location": "876/TALK"    , "narrator": "神楽", "text": "不安になるじゃん？？？"},
        { "location": "878/SEL"     , "narrator": "", "text": "まあねえ…"},
        { "location": "879/SEL"     , "narrator": "", "text": "不安にさせてごめん"},
        { "location": "880/SEL"     , "narrator": "", "text": "いやそんなことないでしょ"},
        { "location": "881/ACT"     , "narrator": "", "text": "まあねえ…"},
