{
    "dir": "chap15/daydra/dd_ch05_15_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "15505",
        "cid": "kagura",
        "title": "005 メインストーリー",
        "sub_title": "オンラインなのに＜後編＞"
    },
    "entry":
    [
        { "location": "1925/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1927/TALK"  , "narrator": "つばめ", "text": "えっと…それで、卯月さん。\nわたしはどれを買えば\nいいのかな？"},
        { "location": "1928/TALK"  , "narrator": "神楽", "text": "…それは――"},
        { "location": "1929/TALK"  , "narrator": "つばめ", "text": "それは？"},
        { "location": "1931/TALK"  , "narrator": "神楽", "text": "…自分で探してみて\nください。"},
        { "location": "1932/TALK"  , "narrator": "つばめ", "text": "えぇっ！？\nわ、わたし一人で選ぶの？"},
        { "location": "1933/TALK"  , "narrator": "神楽", "text": "なんの情報もない状態で、\nピンときた一冊を選ぶ、\nなんて経験は…。"},
        { "location": "1934/TALK"  , "narrator": "神楽", "text": "まさに、この一回だけしか\nありません。"},
        { "location": "1936/TALK"  , "narrator": "神楽", "text": "それを無駄にしたら、\n今後ずーっと後悔することに\nなっちゃいますよ？"},
        { "location": "1937/TALK"  , "narrator": "つばめ", "text": "そ、そっか…。\nうん、わかったよ。"},
        { "location": "1938/TALK"  , "narrator": "つばめ", "text": "卯月さんの言うとおりに、\nわたし、自分で選んでくる！"},
        { "location": "1939/TALK"  , "narrator": "神楽", "text": "素敵な一冊が見つかることを\n祈ってますね。"},
        { "location": "1940/TALK"  , "narrator": "つばめ", "text": "うん。\nそれじゃ、探してくるね！"},
        { "location": "1943/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1955/TALK"  , "narrator": "神楽", "text": "自分なりの答えが出た気がします"},
        { "location": "1956/TALK"  , "narrator": "神楽", "text": "もしかしたら"},
        { "location": "1957/TALK"  , "narrator": "神楽", "text": "私の単なる誇大妄想に過ぎないかもしれませんけど"},
        { "location": "1958/TALK"  , "narrator": "神楽", "text": "聞いてもらえますか？"},
        { "location": "1960/TALK"  , "narrator": "神楽", "text": "$handle$さんの答えが必要なので"},
        { "location": "1962/SEL"   , "narrator": "", "text": "どういうこと？"},
        { "location": "1963/ACT"   , "narrator": "", "text": "どういうこと？"},
        { "location": "1965/TALK"  , "narrator": "神楽", "text": "私はこう思ってるんです"},
        { "location": "1966/TALK"  , "narrator": "神楽", "text": "$handle$さんは多分"},
        { "location": "1967/TALK"  , "narrator": "神楽", "text": "私達の未来でなにが起きるのかを知っている"},
        { "location": "1968/TALK"  , "narrator": "神楽", "text": "それなのに"},
        { "location": "1969/TALK"  , "narrator": "神楽", "text": "なにが起きるのかは言ってくれない"},
        { "location": "1972/TALK"  , "narrator": "神楽", "text": "言えないのかもしれませんが"},
        { "location": "1973/TALK"  , "narrator": "神楽", "text": "だから今からする話を聞いて"},
        { "location": "1974/TALK"  , "narrator": "神楽", "text": "$handle$さんがいいと思うかどうか"},
        { "location": "1975/TALK"  , "narrator": "神楽", "text": "それを聞きたいんです"},
        { "location": "1977/SEL"   , "narrator": "", "text": "それくらいなら多分大丈夫"},
        { "location": "1978/SEL"   , "narrator": "", "text": "とりあえず聞かせて"},
        { "location": "1979/ACT"   , "narrator": "", "text": "それくらいなら多分大丈夫"},
        { "location": "1980/TALK"  , "narrator": "神楽", "text": "だといいんですけど"},
        { "location": "1981/ACT"   , "narrator": "", "text": "とりあえず聞かせて"},
        { "location": "1982/TALK"  , "narrator": "神楽", "text": "そうですね"},
        { "location": "1983/TALK"  , "narrator": "神楽", "text": "判断はお任せします"},
        { "location": "1985/TALK"  , "narrator": "神楽", "text": "私はここにいるつばめさんのことを"},
        { "location": "1986/TALK"  , "narrator": "神楽", "text": "よく知ってます"},
        { "location": "1987/TALK"  , "narrator": "神楽", "text": "とっても優しくて"},
        { "location": "1988/TALK"  , "narrator": "神楽", "text": "色んなことに一生懸命の"},
        { "location": "1989/TALK"  , "narrator": "神楽", "text": "可愛い普通の女の子です"},
        { "location": "1993/TALK"  , "narrator": "神楽", "text": "ドームでのことは今でも引っかかるけど"},
        { "location": "1994/TALK"  , "narrator": "神楽", "text": "決めました"},
        { "location": "1995/TALK"  , "narrator": "神楽", "text": "ずっとつばめさんの隣にいて感じたこと"},
        { "location": "1996/TALK"  , "narrator": "神楽", "text": "それを信じてみようって"},
        { "location": "1997/TALK"  , "narrator": "神楽", "text": "だから私"},
        { "location": "2000/TALK"  , "narrator": "神楽", "text": "つばめさんを破壊しないで済む方法があるのなら"},
        { "location": "2001/TALK"  , "narrator": "神楽", "text": "それを探したいんです"},
        { "location": "2002/TALK"  , "narrator": "神楽", "text": "破壊しなければいけないタイミングがいつ来るのか"},
        { "location": "2003/TALK"  , "narrator": "神楽", "text": "それは私にもわからないけど"},
        { "location": "2004/TALK"  , "narrator": "神楽", "text": "せめてそれまでは探してみよう"},
        { "location": "2005/TALK"  , "narrator": "神楽", "text": "そう決めたんです"},
        { "location": "2008/TALK"  , "narrator": "神楽", "text": "どう思いますか？"},
        { "location": "2009/TALK"  , "narrator": "神楽", "text": "私の出したこの答えについて"},
        { "location": "2010/TALK"  , "narrator": "神楽", "text": "感想だけでも聞かせてほしいんです"},
        { "location": "2013/SEL"   , "narrator": "", "text": "全面的に応援するよ"},
        { "location": "2014/SEL"   , "narrator": "", "text": "破壊するのはやめないんだ？"},
        { "location": "2015/SEL"   , "narrator": "", "text": "時間の無駄だ"},
        { "location": "2016/ACT"   , "narrator": "", "text": "全面的に応援するよ"},
        { "location": "2017/TALK"  , "narrator": "神楽", "text": "ありがとうございます"},
        { "location": "2018/TALK"  , "narrator": "神楽", "text": "私が求めていた答えの中でも"},
        { "location": "2019/TALK"  , "narrator": "神楽", "text": "最高の答えです"},
        { "location": "2030/TALK"  , "narrator": "神楽", "text": "…やっぱり、成功するか\nどうかは答えてくれな\nかったか。"},
        { "location": "2031/TALK"  , "narrator": "神楽", "text": "でも、応援するって\n言ってくれたって\nことは…。"},
        { "location": "2032/TALK"  , "narrator": "神楽", "text": "成功する可能性が\nあるのかも！"},
        { "location": "2033/TALK"  , "narrator": "神楽", "text": "…やってみる価値は\nありそうね。"},
        { "location": "2034/ACT"   , "narrator": "", "text": "破壊するのはやめないんだ？"},
        { "location": "2035/TALK"  , "narrator": "神楽", "text": "それは当然です"},
        { "location": "2036/TALK"  , "narrator": "神楽", "text": "私はつばめさん以外にも"},
        { "location": "2037/TALK"  , "narrator": "神楽", "text": "お母さんや音羽のことも助けたい"},
        { "location": "2038/TALK"  , "narrator": "神楽", "text": "そして"},
        { "location": "2039/TALK"  , "narrator": "神楽", "text": "お母さんと音羽と比べたら"},
        { "location": "2040/TALK"  , "narrator": "神楽", "text": "つばめさんはその下ですから"},
        { "location": "2043/TALK"  , "narrator": "神楽", "text": "これだけは言っておきます"},
        { "location": "2044/TALK"  , "narrator": "神楽", "text": "お母さんと音羽を犠牲にしてまで"},
        { "location": "2045/TALK"  , "narrator": "神楽", "text": "つばめさんを助ける気はありません"},
        { "location": "2046/TALK"  , "narrator": "神楽", "text": "でももし"},
        { "location": "2047/TALK"  , "narrator": "神楽", "text": "三人とも幸せになる方法があるのであれば"},
        { "location": "2048/TALK"  , "narrator": "神楽", "text": "それを探してみたい"},
        { "location": "2049/TALK"  , "narrator": "神楽", "text": "そう思っただけなので"},
        { "location": "2052/TALK"  , "narrator": "神楽", "text": "聞きたいことは聞けましたので"},
        { "location": "2053/TALK"  , "narrator": "神楽", "text": "もういいです"},
        { "location": "2054/TALK"  , "narrator": "神楽", "text": "ありがとうございました"},
        { "location": "2065/TALK"  , "narrator": "神楽", "text": "いいと思うかどうかを\n聞きたかったのに。"},
        { "location": "2066/TALK"  , "narrator": "神楽", "text": "これじゃあ、聞いた意味が\nなかったわ…。"},
        { "location": "2067/ACT"   , "narrator": "", "text": "時間の無駄だ"},
        { "location": "2069/TALK"  , "narrator": "神楽", "text": "率直な意見ありがとうございました"},
        { "location": "2080/TALK"  , "narrator": "神楽", "text": "…時間の無駄って、\nなにそれ？"},
        { "location": "2081/TALK"  , "narrator": "神楽", "text": "$handle$が\n知らないだけで…。"},
        { "location": "2082/TALK"  , "narrator": "神楽", "text": "もしかしたらいい方法が\nあるかもしれないのに…。"},
        { "location": "2083/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "2084/TALK"  , "narrator": "神楽", "text": "でも、もしも本当に\n時間の無駄だったら…。"},
        { "location": "2085/TALK"  , "narrator": "神楽", "text": "なにもせずに、\n私はその日が来るのを\n待つってこと？"},
        { "location": "2086/TALK"  , "narrator": "神楽", "text": "そんなこと…。"},
        { "location": "2091/TALK"  , "narrator": "つばめ", "text": "卯月さーん。"},
        { "location": "2095/TALK"  , "narrator": "つばめ", "text": "ごめんねー。\nお待たせしちゃったかな？"},
        { "location": "2097/TALK"  , "narrator": "神楽", "text": "いえ…どうでした？\nなにか気になる本、\n見つかりましたか？"},
        { "location": "2098/TALK"  , "narrator": "つばめ", "text": "うん。\nとっても面白そうな本、\n見つけてきたよ。"},
        { "location": "2100/TALK"  , "narrator": "神楽", "text": "本当ですか？\n早く見せてください。"},
        { "location": "2101/TALK"  , "narrator": "つばめ", "text": "えへへ…わたしが\n見つけてきた本は、\nこれでーす！"},
        { "location": "2102/TALK"  , "narrator": "神楽", "text": "これって…、\nスウィーティ・メルティ\nですか？"},
        { "location": "2104/TALK"  , "narrator": "つばめ", "text": "そうだよ。\nほら、この前の出撃のこと、\n覚えてる？"},
        { "location": "2105/TALK"  , "narrator": "つばめ", "text": "現場に向かってるときに、\n車の中で卯月さんが…。"},
        { "location": "2106/TALK"  , "narrator": "つばめ", "text": "これの変身ポーズとか\n名乗りとか、\n教えてくれたでしょ？"},
        { "location": "2108/TALK"  , "narrator": "神楽", "text": "あ、ああ…そういえば\nそんなこともありましたね。"},
        { "location": "2109/TALK"  , "narrator": "つばめ", "text": "この本を見つけたとき、\nその時のことを\n思い出したの。"},
        { "location": "2110/TALK"  , "narrator": "つばめ", "text": "ちょっと恥ずかしかった\nけど…、楽しかったな、\nって…。"},
        { "location": "2111/TALK"  , "narrator": "つばめ", "text": "だから、一度本物の\nメルティがどんなのかを\n見てみたくなったんだ。"},
        { "location": "2112/TALK"  , "narrator": "神楽", "text": "なるほど…。\nふふっ。"},
        { "location": "2113/TALK"  , "narrator": "つばめ", "text": "え、なんで笑うの？\nわたし変なこと言った？"},
        { "location": "2114/TALK"  , "narrator": "神楽", "text": "そうじゃないんです。"},
        { "location": "2115/TALK"  , "narrator": "神楽", "text": "私との思い出を理由に\n選んでくれたことが、\n嬉しくて…。"},
        { "location": "2116/TALK"  , "narrator": "つばめ", "text": "えへへ…よかった。\n卯月さんにも\n喜んでもらえて。"},
        { "location": "2117/TALK"  , "narrator": "つばめ", "text": "それじゃ、ちょっと\n買ってくるね。"},
        { "location": "2131/TALK"  , "narrator": "つばめ", "text": "えへへ、面白そう。\n早く読みたいなぁ…。"},
        { "location": "2132/TALK"  , "narrator": "つばめ", "text": "…あ、そうだ。"},
        { "location": "2144/TALK"  , "narrator": "つばめ", "text": "$handle$さ～ん"},
        { "location": "2145/TALK"  , "narrator": "つばめ", "text": "メルティのラノベ発見だょ(*≧∀≦*) "},
        { "location": "2146/TALK"  , "narrator": "つばめ", "text": "前から読みたかったんだ～(´∀｀*)ｳﾌﾌ"},
        { "location": "2147/TALK"  , "narrator": "つばめ", "text": "近所になかったから"},
        { "location": "2148/TALK"  , "narrator": "つばめ", "text": "とっても嬉しぃ(*´∀｀*)ｖ"},
        { "location": "2150/SEL"   , "narrator": "", "text": "連れてきてくれた神楽に感謝だね"},
        { "location": "2151/ACT"   , "narrator": "", "text": "連れてきてくれた神楽に感謝だね"},
        { "location": "2153/TALK"  , "narrator": "つばめ", "text": "ぅん"},
        { "location": "2154/SEL"   , "narrator": "", "text": "つばめは神楽のことが好き？\n<color=blue>(※スルー可能）</color>"},
        { "location": "2155/TALK"  , "narrator": "つばめ", "text": "あ"},
        { "location": "2156/TALK"  , "narrator": "つばめ", "text": "レジ行かなくちゃ"},
        { "location": "2157/TALK"  , "narrator": "つばめ", "text": "それじゃ$handle$さん、またね"},
        { "location": "2158/TALK"  , "narrator": "つばめ", "text": "卯月さん待たせちゃってるから"},
        { "location": "2177/ACT"   , "narrator": "", "text": "つばめは神楽のことが好き？\n<color=blue>(※スルー可能）</color>"},
        { "location": "2181/TALK"  , "narrator": "つばめ", "text": "えー"},
        { "location": "2182/TALK"  , "narrator": "つばめ", "text": "もちろん好きだょ～～～"},
        { "location": "2184/TALK"  , "narrator": "つばめ", "text": "卯月さんはいつもわたしに幸せを沢山くれるんだょ"},
        { "location": "2185/TALK"  , "narrator": "つばめ", "text": "今回だって、初めてのアキバだったけど、とっても楽しくて"},
        { "location": "2186/TALK"  , "narrator": "つばめ", "text": "わたしも卯月さんに、なにかぉ礼したぃけど"},
        { "location": "2188/SEL"   , "narrator": "", "text": "お揃いのものを二人で持ったらすごく良さそう"},
        { "location": "2189/ACT"   , "narrator": "", "text": "お揃いのものを二人で持ったらすごく良さそう"},
        { "location": "2191/TALK"  , "narrator": "つばめ", "text": "それぃぃねぇ～～～！"},
        { "location": "2194/TALK"  , "narrator": "つばめ", "text": "でも、ここじゃムリかも(´･ω･｀) "},
        { "location": "2195/TALK"  , "narrator": "つばめ", "text": "本しか売ってなさそぅだし"},
        { "location": "2196/TALK"  , "narrator": "つばめ", "text": "ぉ礼は今度"},
        { "location": "2197/TALK"  , "narrator": "つばめ", "text": "改めてかな_(┐「ε:)_"},
        { "location": "2208/TALK"  , "narrator": "つばめ", "text": "…あれ？\nあそこに\n置いてあるのって――"},
        { "location": "2230/TALK"  , "narrator": "つばめ", "text": "ごめんねー。\nお待たせしちゃった\nかな？"},
        { "location": "2232/TALK"  , "narrator": "神楽", "text": "いえ、私も新刊の\nチェックをしてたから\n大丈夫ですよ。"},
        { "location": "2234/TALK"  , "narrator": "神楽", "text": "それじゃあ、\n次のお店へ案内しますね。"},
        { "location": "2235/TALK"  , "narrator": "つばめ", "text": "あ、ちょっと待って。\n実はレジの前で、\nこんなの見つけたんだ。"},
        { "location": "2236/TALK"  , "narrator": "神楽", "text": "それは…ああ、\nメルティーの\nキーホルダーですね。"},
        { "location": "2237/TALK"  , "narrator": "つばめ", "text": "うん。ミルクティーと\nアップルティーので\n間違いないかな？"},
        { "location": "2238/TALK"  , "narrator": "神楽", "text": "はい。でも、主役の\nスウィーティーは\n買わなかったんですか？"},
        { "location": "2239/TALK"  , "narrator": "つばめ", "text": "うん…三つだと、\nスウィーティーだけ\n余っちゃうから…。"},
        { "location": "2240/TALK"  , "narrator": "つばめ", "text": "卯月さん。\nアップルティーの方、\nもらってくれる？"},
        { "location": "2241/TALK"  , "narrator": "神楽", "text": "えっ？\nこれ、もらっちゃっても\nいいんですか？"},
        { "location": "2242/TALK"  , "narrator": "つばめ", "text": "うん、今日秋葉原に\n連れてきてくれた\nお礼だよ。"},
        { "location": "2243/TALK"  , "narrator": "つばめ", "text": "…本当は、ハンカチとか\nお菓子とかにしようかな\nって思ったんだけど…。"},
        { "location": "2245/TALK"  , "narrator": "つばめ", "text": "秋葉原じゃ、そういうの\n売ってる気がしなくて…。"},
        { "location": "2246/TALK"  , "narrator": "神楽", "text": "…そんな、気を遣わなくて\nいいのに…。"},
        { "location": "2247/TALK"  , "narrator": "つばめ", "text": "ご、ごめんね。\nお礼がキーホルダー\nなんかで。"},
        { "location": "2248/TALK"  , "narrator": "つばめ", "text": "でも、さっきも言ったけど\n一緒にポーズの練習を\nしたの…。"},
        { "location": "2249/TALK"  , "narrator": "つばめ", "text": "本当に楽しかったんだ。"},
        { "location": "2251/TALK"  , "narrator": "つばめ", "text": "だから、これが売ってるの\n見た瞬間に思ったの。"},
        { "location": "2252/TALK"  , "narrator": "つばめ", "text": "卯月さんとお揃いで\n持てたら嬉しいな、って。"},
        { "location": "2253/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "2254/TALK"  , "narrator": "つばめ", "text": "って、ごめんね！\nムリに押しつけるつもりは\nないんだけど、えっと…。"},
        { "location": "2255/TALK"  , "narrator": "神楽", "text": "…ありがとう、\nつばめさん。"},
        { "location": "2256/TALK"  , "narrator": "神楽", "text": "このキーホルダー、\n大切にしますね。"},
        { "location": "2257/TALK"  , "narrator": "つばめ", "text": "…ごめんね。\n押しつけたみたいに\nなっちゃったかな？"},
        { "location": "2258/TALK"  , "narrator": "神楽", "text": "そんなことないです。\nつばめさんとお揃いなんて\nとっても嬉しいですよ。"},
        { "location": "2259/TALK"  , "narrator": "神楽", "text": "帰ったら、学校の鞄に\n付けさせてもらいますね。"},
        { "location": "2260/TALK"  , "narrator": "つばめ", "text": "が、学校の鞄に付けるの？"},
        { "location": "2261/TALK"  , "narrator": "神楽", "text": "はい。つばめさんも、\n帰ったら\n付けてくださいね。"},
        { "location": "2263/TALK"  , "narrator": "つばめ", "text": "わ、わたしも！？"},
        { "location": "2264/TALK"  , "narrator": "神楽", "text": "もちろんです。\nせっかくつばめさんとの\nお揃いなんだから…。"},
        { "location": "2265/TALK"  , "narrator": "神楽", "text": "一緒に付けて、私達が\nラブラブなところを\n見せつけちゃいましょう！"},
        { "location": "2266/TALK"  , "narrator": "つばめ", "text": "ら、ラブラブ！？"},
        { "location": "2268/TALK"  , "narrator": "神楽", "text": "はい。\nペアリングみたいな\nものですし。"},
        { "location": "2269/TALK"  , "narrator": "つばめ", "text": "えぇっ！？　そ、そういう\nつもりじゃなかったん\nだけど…。"},
        { "location": "2270/TALK"  , "narrator": "神楽", "text": "つ、つばめさんは、\n私のこと、\nキライなんですか…っ？"},
        { "location": "2272/TALK"  , "narrator": "つばめ", "text": "ち、違うよ！"},
        { "location": "2273/TALK"  , "narrator": "つばめ", "text": "わたしも卯月さんのこと、\nとっても大好きだよ！"},
        { "location": "2274/TALK"  , "narrator": "神楽", "text": "ちょ、声が大きいです！\n周りの人達に\n見られちゃってますから！"},
        { "location": "2276/TALK"  , "narrator": "つばめ", "text": "えっ、あ…、\nご、ごめんなさい…。"},
        { "location": "2277/TALK"  , "narrator": "神楽", "text": "まあ、私は別に\n気にしませんけどねー。"},
        { "location": "2278/TALK"  , "narrator": "つばめ", "text": "わ、わたしは\n気にするよー。"},
        { "location": "2279/TALK"  , "narrator": "神楽", "text": "ふふっ…。"},
        { "location": "2280/TALK"  , "narrator": "神楽", "text": "優しくて、可愛くて、\nちょっとだけ天然な\nつばめさん…。"},
        { "location": "2282/TALK"  , "narrator": "神楽", "text": "…壊したくないな。\nこんないい子を…。"},
        { "location": "2292/DIALOG", "narrator": "Dialog_chapter_ch05", "text": "【12 ピクシャル】"},
        { "location": "2304/DIALOG", "narrator": "Dialog_chapter_ch05", "text": "【12 ピクシャル】"}
    ]
}
