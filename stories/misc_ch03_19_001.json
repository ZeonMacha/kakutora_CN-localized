        { "location": "57/SEL"    , "narrator": "", "text": "そっか"},
        { "location": "58/SEL"    , "narrator": "", "text": "今回満喫すればいいよ"},
        { "location": "59/SEL"    , "narrator": "", "text": "今度$me$と行こうよ"},
        { "location": "60/ACT"    , "narrator": "", "text": "そっか"},
