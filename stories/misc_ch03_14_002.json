        { "location": "87/SCENARIO", "narrator": "", "text": "000_写真立てが欲しいの"},
        { "location": "112/TALK"   , "narrator": "ガブリエラ", "text": "写真立てが欲しいのよね"},
        { "location": "113/TALK"   , "narrator": "ガブリエラ", "text": "どこで買えばいいかしら"},
        { "location": "115/SEL"    , "narrator": "", "text": "100均"},
        { "location": "116/SEL"    , "narrator": "", "text": "写真館とか？"},
        { "location": "117/SEL"    , "narrator": "", "text": "どういうのが欲しいの？"},
        { "location": "118/ACT"    , "narrator": "", "text": "100均"},
        { "location": "119/TALK"   , "narrator": "ガブリエラ", "text": "お値段を考えると100均がいいのかしらね"},
        { "location": "120/ACT"    , "narrator": "", "text": "写真館とか？"},
        { "location": "121/TALK"   , "narrator": "ガブリエラ", "text": "このあたりだとどこにあるかしら？"},
        { "location": "122/ACT"    , "narrator": "", "text": "どういうのが欲しいの？"},
        { "location": "124/TALK"   , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "126/TALK"   , "narrator": "ガブリエラ", "text": "アンティーク調のがいいの"},
        { "location": "127/TALK"   , "narrator": "ガブリエラ", "text": "かわいいのがいいわ"},
        { "location": "129/TALK"   , "narrator": "ガブリエラ", "text": "部屋に写真を飾りたいのよ"},
        { "location": "131/SEL"    , "narrator": "", "text": "デジタルフォトフレームの方がいいんじゃない"},
        { "location": "132/SEL"    , "narrator": "", "text": "いい思い出があるんだね"},
        { "location": "133/SEL"    , "narrator": "", "text": "$me$とガブの写真だよね"},
        { "location": "134/ACT"    , "narrator": "", "text": "デジタルフォトフレームの方がいいんじゃない"},
        { "location": "135/TALK"   , "narrator": "ガブリエラ", "text": "え"},
        { "location": "136/TALK"   , "narrator": "ガブリエラ", "text": "そうかしら"},
        { "location": "137/TALK"   , "narrator": "ガブリエラ", "text": "たくさん飾りたい写真があるわけじゃないのよね"},
        { "location": "138/TALK"   , "narrator": "ガブリエラ", "text": "どうしようかしら"},
        { "location": "139/ACT"    , "narrator": "", "text": "いい思い出があるんだね"},
        { "location": "141/TALK"   , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "142/TALK"   , "narrator": "ガブリエラ", "text": "いい思い出なのかもね"},
        { "location": "143/ACT"    , "narrator": "", "text": "$me$とガブの写真だよね"},
        { "location": "145/TALK"   , "narrator": "ガブリエラ", "text": "あらｖｖｖ"},
        { "location": "147/TALK"   , "narrator": "ガブリエラ", "text": "それも飾らないといけないわねｖｖｖ"},
        { "location": "148/TALK"   , "narrator": "ガブリエラ", "text": "どの写真がいいかしらね？"},
        { "location": "150/TALK"   , "narrator": "ガブリエラ", "text": "アーヤなんかは"},
        { "location": "151/TALK"   , "narrator": "ガブリエラ", "text": "写真をピンで留めたりしているけれど"},
        { "location": "152/TALK"   , "narrator": "ガブリエラ", "text": "私はちゃんと写真立てに入れたいのよ"},
        { "location": "153/TALK"   , "narrator": "ガブリエラ", "text": "だって写真が痛むでしょう？"},
        { "location": "155/SEL"    , "narrator": "", "text": "気にしすぎ"},
        { "location": "156/SEL"    , "narrator": "", "text": "確かにね"},
        { "location": "157/SEL"    , "narrator": "", "text": "全部データにすればいいよ"},
        { "location": "158/ACT"    , "narrator": "", "text": "気にしすぎ"},
        { "location": "159/TALK"   , "narrator": "ガブリエラ", "text": "そうかしら？"},
        { "location": "160/TALK"   , "narrator": "ガブリエラ", "text": "そんなことはないと思うわよ"},
        { "location": "161/ACT"    , "narrator": "", "text": "確かにね"},
        { "location": "162/TALK"   , "narrator": "ガブリエラ", "text": "そうよね"},
        { "location": "163/TALK"   , "narrator": "ガブリエラ", "text": "ちゃんとしたいのよね"},
        { "location": "164/ACT"    , "narrator": "", "text": "全部データにすればいいよ"},
        { "location": "165/TALK"   , "narrator": "ガブリエラ", "text": "データで持っていても"},
        { "location": "166/TALK"   , "narrator": "ガブリエラ", "text": "プリントしたい写真もあるのよ"}
    ]
