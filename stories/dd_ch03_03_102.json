{
    "dir": "chap03/daydra/dd_ch03_03_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "3304",
        "cid": "gabriella",
        "title": "004 メインストーリー",
        "sub_title": "ガブリエラという存在＜後編＞"
    },
    "entry":
    [
        { "location": "458/SCENARIO", "narrator": "", "text": "ガブリエラという存在"},
        { "location": "483/TALK"    , "narrator": "千羽鶴", "text": "現実世界へ\nおかえりなさい。"},
        { "location": "484/TALK"    , "narrator": "千羽鶴", "text": "貴方が彼女のココロの中で\n奮闘してくれたお陰で、\n彼女の心は安定した。"},
        { "location": "485/TALK"    , "narrator": "千羽鶴", "text": "あとは貴方から直接、\n彼女にアドバイスをして、\n背中を一押しするだけ。"},
        { "location": "486/TALK"    , "narrator": "千羽鶴", "text": "さて、\nその方法だけど。"},
        { "location": "492/TALK"    , "narrator": "千羽鶴", "text": "WAVEというチャット\nツールのシステムを\n作ってみた。"},
        { "location": "493/TALK"    , "narrator": "千羽鶴", "text": "あなたの世界にも、\n似たものがあるかも\nしれないけど。"},
        { "location": "494/TALK"    , "narrator": "千羽鶴", "text": "そして、彼女のWAVEに\nあなたを登録して\nおいた。"},
        { "location": "495/SEL"     , "narrator": "", "text": "なるほど"},
        { "location": "496/ACT"     , "narrator": "", "text": "なるほど"},
        { "location": "498/TALK"    , "narrator": "千羽鶴", "text": "でも「bot」として\nだけど。"},
        { "location": "499/SEL"     , "narrator": "", "text": "なんでBot！？"},
        { "location": "500/ACT"     , "narrator": "", "text": "なんでBot！？"},
        { "location": "502/TALK"    , "narrator": "千羽鶴", "text": "いきなり知らない人が\nフレンド登録されて\nいたらまずいでしょう。"},
        { "location": "503/SEL"     , "narrator": "", "text": "そんなところにリアリティを持たせなくても"},
        { "location": "504/ACT"     , "narrator": "", "text": "そんなところにリアリティを持たせなくても"},
        { "location": "506/TALK"    , "narrator": "千羽鶴", "text": "「あなた」は「あなた」\nなんだから。"},
        { "location": "507/TALK"    , "narrator": "千羽鶴", "text": "幼馴染み設定とか、\nそんな都合のいい\nものはないから。"},
        { "location": "508/TALK"    , "narrator": "千羽鶴", "text": "そこはリアリティを\n持って欲しい。"},
        { "location": "509/TALK"    , "narrator": "千羽鶴", "text": "そういうわけだから、\n彼女からの抵抗は\nあまり無いはず。"},
        { "location": "510/SEL"     , "narrator": "", "text": "でもBotじゃねえ…"},
        { "location": "511/ACT"     , "narrator": "", "text": "でもBotじゃねえ…"},
        { "location": "513/TALK"    , "narrator": "千羽鶴", "text": "私はあくまで\n自然な出逢いと機会を\n与えただけ。"},
        { "location": "514/TALK"    , "narrator": "千羽鶴", "text": "どう運用するかは\nあなたが決めていい。"},
        { "location": "515/TALK"    , "narrator": "千羽鶴", "text": "すぐに「bot」では\nないと伝えてもいいし、\nそのままでもいい。"},
        { "location": "516/TALK"    , "narrator": "千羽鶴", "text": "そこはあなたの\nセンスに任せる。"},
        { "location": "520/TALK"    , "narrator": "千羽鶴", "text": "さあ、彼女の新しい物語が\n始まろうとしている。"},
        { "location": "521/TALK"    , "narrator": "千羽鶴", "text": "チャットツールWAVEを\n使って、彼女を支えて\nいってほしい。"},
        { "location": "534/TALK"    , "narrator": "ガブリエラ", "text": "落ち着いて！\n集中しなくちゃ…！"},
        { "location": "535/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "537/TALK"    , "narrator": "ガブリエラ", "text": "…あ、あれ？"},
        { "location": "540/TALK"    , "narrator": "ガブリエラ", "text": "なんか、急に気持ちが\n落ち着いて――。"},
        { "location": "541/SEL"     , "narrator": "", "text": "どう？　落ち着いた？"},
        { "location": "542/ACT"     , "narrator": "", "text": "どう？　落ち着いた？"},
        { "location": "550/TALK"    , "narrator": "ガブリエラ", "text": "わっ！？\nだ、誰よ、こんな時に――"},
        { "location": "562/TALK"    , "narrator": "ガブリエラ", "text": "え？　何これ…。\nBot？"},
        { "location": "563/TALK"    , "narrator": "ガブリエラ", "text": "Botって何？"},
        { "location": "564/TALK"    , "narrator": "ガブリエラ", "text": "そんな機能あったかしら？"},
        { "location": "566/SEL"     , "narrator": "", "text": "今日からお世話になります"},
        { "location": "567/ACT"     , "narrator": "", "text": "今日からお世話になります"},
        { "location": "573/TALK"    , "narrator": "ガブリエラ", "text": "？"},
        { "location": "574/TALK"    , "narrator": "ガブリエラ", "text": "意味が分からない"},
        { "location": "575/TALK"    , "narrator": "ガブリエラ", "text": "説明してよ"},
        { "location": "577/SEL"     , "narrator": "", "text": "心が落ち着いたのわかる？"},
        { "location": "578/ACT"     , "narrator": "", "text": "心が落ち着いたのわかる？"},
        { "location": "580/TALK"    , "narrator": "ガブリエラ", "text": "え？"},
        { "location": "581/TALK"    , "narrator": "ガブリエラ", "text": "何でそのこと知ってるの？"},
        { "location": "583/SEL"     , "narrator": "", "text": "$me$が心の中を整理したから"},
        { "location": "584/ACT"     , "narrator": "", "text": "$me$が心の中を整理したから"},
        { "location": "586/TALK"    , "narrator": "ガブリエラ", "text": "は？"},
        { "location": "587/TALK"    , "narrator": "ガブリエラ", "text": "もっと詳しく説明して"},
        { "location": "589/SEL"     , "narrator": "", "text": "ガブリエラの心にダイブした"},
        { "location": "590/ACT"     , "narrator": "", "text": "ガブリエラの心にダイブした"},
        { "location": "593/TALK"    , "narrator": "ガブリエラ", "text": "？"},
        { "location": "595/TALK"    , "narrator": "ガブリエラ", "text": "意味が分からないから"},
        { "location": "596/TALK"    , "narrator": "ガブリエラ", "text": "っていうかダイブって何？"},
        { "location": "597/TALK"    , "narrator": "ガブリエラ", "text": "人の心に勝手に入ったってこと？"},
        { "location": "598/TALK"    , "narrator": "ガブリエラ", "text": "ウソでもそういうこと言わないで"},
        { "location": "599/TALK"    , "narrator": "ガブリエラ", "text": "ゾッとするわ"},
        { "location": "608/TALK"    , "narrator": "ガブリエラ", "text": "まったく、何なのよ今の？"},
        { "location": "610/TALK"    , "narrator": "ガブリエラ", "text": "けど…なんだろう？"},
        { "location": "612/TALK"    , "narrator": "ガブリエラ", "text": "こんなに落ち着いた\n気持ちになったの、\n生まれて初めてかも…。"},
        { "location": "613/TALK"    , "narrator": "ガブリエラ", "text": "集中しようだなんて\n思わなくても、自然と\n集中できる…。"},
        { "location": "615/TALK"    , "narrator": "ガブリエラ", "text": "…もしかして――"},
        { "location": "616/TALK"    , "narrator": "ガブリエラ", "text": "アーヤが前に言ってた\n『明鏡止水』って、\nこういうこと？"},
        { "location": "618/TALK"    , "narrator": "ガブリエラ", "text": "…アーヤは、いつもこんな\n気持ちで剣道の試合を\nしてたのかしら？"},
        { "location": "619/TALK"    , "narrator": "ガブリエラ", "text": "だとしたら――"},
        { "location": "621/TALK"    , "narrator": "ガブリエラ", "text": "何だか、素敵かも。"},
        { "location": "622/TALK"    , "narrator": "ガブリエラ", "text": "…あの、[Bot]とかいう\n変な奴の言ってたこと、\n本当なのかしら？"},
        { "location": "624/TALK"    , "narrator": "ガブリエラ", "text": "…って、ダメ。\n今は集中しないと。"},
        { "location": "625/TALK"    , "narrator": "ガブリエラ", "text": "あとで、全部まとめて\nまほに聞けばいいんだし。"},
        { "location": "626/SEL"     , "narrator": "", "text": "まほって誰？"},
        { "location": "627/ACT"     , "narrator": "", "text": "まほって誰？"},
        { "location": "633/TALK"    , "narrator": "ガブリエラ", "text": "うわっ！？\nまた来たし！"},
        { "location": "643/TALK"    , "narrator": "ガブリエラ", "text": "私達の隊長よ"},
        { "location": "644/TALK"    , "narrator": "ガブリエラ", "text": "特別攻撃隊の隊長で神楽坂トライナリーの館長の東雲真幌"},
        { "location": "645/TALK"    , "narrator": "ガブリエラ", "text": "以上説明終わり"},
        { "location": "646/TALK"    , "narrator": "ガブリエラ", "text": "集中するから帰るまで声かけ禁止！"},
        { "location": "656/TALK"    , "narrator": "ガブリエラ", "text": "ふぅ…。"},
        { "location": "658/TALK"    , "narrator": "ガブリエラ", "text": "よしっ！！"},
        { "location": "666/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "667/TALK"    , "narrator": "ガブリエラ", "text": "大丈夫…今の様子なら、\nあいつはもうすぐ…。"},
        { "location": "678/TALK"    , "narrator": "ガブリエラ", "text": "…よし、来る！！"},
        { "location": "692/TALK"    , "narrator": "ガブリエラ", "text": "今だ！！"},
        { "location": "532/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>5月3日　1:59 PM</color>\nFreyMENOWライブ中に発生した\nフェノメノンドーム戦にて。"}
    ]
}
