        "title": "016 ココロスフィアストーリー【Lv06】",
        "sub_title": "チャプター９＜提起＞"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "壊されるココロ３"},
        { "location": "14/DIALOG" , "narrator": "", "text": "<size=40>DOOR-No. 502</size>\nGABRIELLA\n\n<size=45>壊されるココロ</size>\n<size=35>～暗黒世界～</size>"},
        { "location": "26/TALK"   , "narrator": "ガブリエラ", "text": "来たわね。"},
        { "location": "27/SEL"    , "narrator": "（選択肢）", "text": "これが？"},
        { "location": "28/ACT"    , "narrator": "", "text": "これが？"},
        { "location": "30/TALK"   , "narrator": "ガブリエラ", "text": "そうよ。\nあたしのココロの中に\nある暗黒部分。"},
        { "location": "31/TALK"   , "narrator": "ガブリエラ", "text": "この中に何があるか\nもはやあたしにすら\n知る術は無いの。"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "もっとも知る気なんて\nサラサラ無いけど。"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "とにかく、一刻も早く\n片付けたいところ\nなんだけど……"},
        { "location": "34/SEL"    , "narrator": "（選択肢）", "text": "けど？"},
        { "location": "35/ACT"    , "narrator": "", "text": "けど？"},
        { "location": "37/TALK"   , "narrator": "ガブリエラ", "text": "こんな暗黒ですら\nそれを守るクランが\nいるの。"},
        { "location": "38/TALK"   , "narrator": "ガブリエラ", "text": "まずはそいつらと\n戦わないと、\n手が出せない。"},
        { "location": "39/TALK"   , "narrator": "ガブリエラ", "text": "準備はいい！？"},
        { "location": "40/SEL"    , "narrator": "（選択肢）", "text": "もちろん！"},
        { "location": "41/ACT"    , "narrator": "", "text": "もちろん！"},
        { "location": "43/TALK"   , "narrator": "ガブリエラ", "text": "pojmowanie."},
        { "location": "44/TALK"   , "narrator": "ガブリエラ", "text": "それじゃ\n行くわよ！"}
    ]
}
