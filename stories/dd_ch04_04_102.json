{
    "dir": "chap04/daydra/dd_ch04_04_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "4404",
        "cid": "miyabi",
        "title": "004 メインストーリー",
        "sub_title": "恋ヶ崎みやびという存在＜後編＞"
    },
    "entry":
    [
        { "location": "397/SCENARIO", "narrator": "", "text": "恋ヶ崎みやびという存在"},
        { "location": "420/TALK"    , "narrator": "千羽鶴", "text": "現実世界へ\nおかえりなさい。"},
        { "location": "421/TALK"    , "narrator": "千羽鶴", "text": "貴方が彼女のココロの中で\n奮闘してくれたお陰で、\n彼女の心は安定した。"},
        { "location": "422/TALK"    , "narrator": "千羽鶴", "text": "あとは貴方から直接、\n彼女にアドバイスをして、\n背中を一押しするだけ。"},
        { "location": "423/TALK"    , "narrator": "千羽鶴", "text": "さて、\nその方法だけど。"},
        { "location": "429/TALK"    , "narrator": "千羽鶴", "text": "WAVEというチャット\nツールのシステムを\n作ってみた。"},
        { "location": "430/TALK"    , "narrator": "千羽鶴", "text": "あなたの世界にも、\n似たものがあるかも\nしれないけど。"},
        { "location": "431/TALK"    , "narrator": "千羽鶴", "text": "そして、彼女のWAVEに\nあなたを登録して\nおいた。"},
        { "location": "432/SEL"     , "narrator": "", "text": "なるほど"},
        { "location": "433/ACT"     , "narrator": "", "text": "なるほど"},
        { "location": "435/TALK"    , "narrator": "千羽鶴", "text": "でも「bot」として\nだけど。"},
        { "location": "436/SEL"     , "narrator": "", "text": "なんでBot！？"},
        { "location": "437/ACT"     , "narrator": "", "text": "なんでBot！？"},
        { "location": "439/TALK"    , "narrator": "千羽鶴", "text": "いきなり知らない人が\nフレンド登録されて\nいたらまずいでしょう。"},
        { "location": "440/SEL"     , "narrator": "", "text": "そんなところにリアリティを持たせなくても"},
        { "location": "441/ACT"     , "narrator": "", "text": "そんなところにリアリティを持たせなくても"},
        { "location": "443/TALK"    , "narrator": "千羽鶴", "text": "「あなた」は「あなた」\nなんだから。"},
        { "location": "444/TALK"    , "narrator": "千羽鶴", "text": "幼馴染み設定とか、\nそんな都合のいい\nものはないから。"},
        { "location": "445/TALK"    , "narrator": "千羽鶴", "text": "そこはリアリティを\n持って欲しい。"},
        { "location": "446/TALK"    , "narrator": "千羽鶴", "text": "そういうわけだから、\n彼女からの抵抗は\nあまり無いはず。"},
        { "location": "447/SEL"     , "narrator": "", "text": "でもBotじゃねえ…"},
        { "location": "448/ACT"     , "narrator": "", "text": "でもBotじゃねえ…"},
        { "location": "450/TALK"    , "narrator": "千羽鶴", "text": "私はあくまで\n自然な出逢いと機会を\n与えただけ。"},
        { "location": "451/TALK"    , "narrator": "千羽鶴", "text": "どう運用するかは\nあなたが決めていい。"},
        { "location": "452/TALK"    , "narrator": "千羽鶴", "text": "すぐに「bot」では\nないと伝えてもいいし、\nそのままでもいい。"},
        { "location": "453/TALK"    , "narrator": "千羽鶴", "text": "そこはあなたの\nセンスに任せる。"},
        { "location": "457/TALK"    , "narrator": "千羽鶴", "text": "さあ、彼女の新しい物語が\n始まろうとしている。"},
        { "location": "458/TALK"    , "narrator": "千羽鶴", "text": "チャットツールWAVEを\n使って、彼女を支えて\nいってほしい。"},
        { "location": "470/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "471/TALK"    , "narrator": "みやび", "text": "…なんや？"},
        { "location": "472/TALK"    , "narrator": "みやび", "text": "なんか急に\nつっかかりが取れた\nような……"},
        { "location": "473/SEL"     , "narrator": "", "text": "今回のやる気喪失、なごちゃんが関係してたりする？"},
        { "location": "474/ACT"     , "narrator": "", "text": "今回のやる気喪失、なごちゃんが関係してたりする？"},
        { "location": "478/TALK"    , "narrator": "みやび", "text": "はぁ…誰や、\nこんな時にWAVEなんぞ――"},
        { "location": "479/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "484/TALK"    , "narrator": "みやび", "text": "っ！？"},
        { "location": "492/TALK"    , "narrator": "みやび", "text": "あんた、何者や？"},
        { "location": "494/SEL"     , "narrator": "", "text": "botです"},
        { "location": "495/SEL"     , "narrator": "", "text": "みやびを助けに来た"},
        { "location": "496/ACT"     , "narrator": "", "text": "Botです"},
        { "location": "498/TALK"    , "narrator": "みやび", "text": "確かにそう書いちゅうね"},
        { "location": "499/TALK"    , "narrator": "みやび", "text": "けんど"},
        { "location": "500/ACT"     , "narrator": "", "text": "みやびを助けに来た"},
        { "location": "501/TALK"    , "narrator": "みやび", "text": "は？"},
        { "location": "502/TALK"    , "narrator": "みやび", "text": "画面にはBotと表示されちゅうけんどBotに助けられる筋合いはない、てゆうか"},
        { "location": "504/TALK"    , "narrator": "みやび", "text": "まっことＡＩなが？"},
        { "location": "506/SEL"     , "narrator": "", "text": "その話はあとだ"},
        { "location": "507/ACT"     , "narrator": "", "text": "その話はあとだ"},
        { "location": "509/TALK"    , "narrator": "みやび", "text": "誤魔化すなや"},
        { "location": "511/SEL"     , "narrator": "", "text": "まだ助かるかもしれないんだよ！"},
        { "location": "512/ACT"     , "narrator": "", "text": "まだ助かるかもしれないんだよ！"},
        { "location": "514/TALK"    , "narrator": "みやび", "text": "まだそんなこと言うてるが？"},
        { "location": "516/SEL"     , "narrator": "", "text": "頑張ろうよ！"},
        { "location": "517/ACT"     , "narrator": "", "text": "頑張ろうよ！"},
        { "location": "519/TALK"    , "narrator": "みやび", "text": "軽いな"},
        { "location": "520/TALK"    , "narrator": "みやび", "text": "うちはな"},
        { "location": "521/TALK"    , "narrator": "みやび", "text": "そういう話を軽々しく言うヤツは"},
        { "location": "522/TALK"    , "narrator": "みやび", "text": "大嫌いなんや"},
        { "location": "535/TALK"    , "narrator": "みやび", "text": "…腹立たしいヤツや。"},
        { "location": "536/TALK"    , "narrator": "みやび", "text": "まさか、なごちゃんの\nことを知っちゅうとは…。"},
        { "location": "537/TALK"    , "narrator": "みやび", "text": "…やはり、うちを攪乱する\nために、管理庁が仕掛けて\nきた刺客か…？"},
        { "location": "538/TALK"    , "narrator": "みやび", "text": "…いや、うちだけ\nピンポイントで狙われる\nようなこと――"},
        { "location": "539/TALK"    , "narrator": "みやび", "text": "管理庁にした覚えないん\nやけんど…。"},
        { "location": "540/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "541/TALK"    , "narrator": "みやび", "text": "やけんど――"},
        { "location": "542/TALK"    , "narrator": "みやび", "text": "もしそうやとしたら、\nうちがやることは\n一つやね。"},
        { "location": "543/TALK"    , "narrator": "みやび", "text": "徹底抗戦や！"},
        { "location": "555/TALK"    , "narrator": "みやび", "text": "賭けをせんか？"},
        { "location": "557/SEL"     , "narrator": "", "text": "賭けの内容は？"},
        { "location": "558/ACT"     , "narrator": "", "text": "賭けの内容は？"},
        { "location": "560/TALK"    , "narrator": "みやび", "text": "うちらがこの戦いに勝ったら"},
        { "location": "561/TALK"    , "narrator": "みやび", "text": "あんたのアカウントの秘密鍵をよこしや"},
        { "location": "562/TALK"    , "narrator": "みやび", "text": "この条件を飲むなら、戦いを継続しちゃる"},
        { "location": "563/TALK"    , "narrator": "みやび", "text": "どうや？"},
        { "location": "565/SEL"     , "narrator": "", "text": "もし負けたら？"},
        { "location": "566/SEL"     , "narrator": "", "text": "いいよ"},
        { "location": "567/ACT"     , "narrator": "", "text": "もし負けたら？"},
        { "location": "568/TALK"    , "narrator": "みやび", "text": "うちらが死ぬだけや"},
        { "location": "571/TALK"    , "narrator": "みやび", "text": "まあ、賭け言うたけんど"},
        { "location": "572/TALK"    , "narrator": "みやび", "text": "勝った時はご褒美くれ言うことや"},
        { "location": "573/TALK"    , "narrator": "みやび", "text": "褒美の一つも出さんで、人を動かせる思うが？"},
        { "location": "575/SEL"     , "narrator": "", "text": "わかった、いいよ"},
        { "location": "576/ACT"     , "narrator": "", "text": "わかった、いいよ"},
        { "location": "578/ACT"     , "narrator": "", "text": "いいよ"},
        { "location": "580/TALK"    , "narrator": "みやび", "text": "決まりや"},
        { "location": "581/TALK"    , "narrator": "みやび", "text": "あんたがどんなロジックで動いているか、今は見当もつかん"},
        { "location": "582/TALK"    , "narrator": "みやび", "text": "けんど、この戦いが終わったら、すぐに暴いちゃるき"},
        { "location": "583/TALK"    , "narrator": "みやび", "text": "待っちょりや"},
        { "location": "584/TALK"    , "narrator": "みやび", "text": "モチベーション上がってきた(^Д^)ｷﾞｬﾊ"},
        { "location": "585/TALK"    , "narrator": "みやび", "text": "久々に戦い頑張れそうや"},
        { "location": "587/SEL"     , "narrator": "", "text": "勝ったら好きにしていいよ"},
        { "location": "588/SEL"     , "narrator": "", "text": "絶対負けたりしないでね"},
        { "location": "589/ACT"     , "narrator": "", "text": "勝ったら好きにしていいよ"},
        { "location": "590/TALK"    , "narrator": "みやび", "text": "言質取ったきね"},
        { "location": "591/TALK"    , "narrator": "みやび", "text": "みやびさん"},
        { "location": "592/TALK"    , "narrator": "みやび", "text": "本気モードで行くちや"},
        { "location": "593/ACT"     , "narrator": "", "text": "絶対負けたりしないでね"},
        { "location": "594/TALK"    , "narrator": "みやび", "text": "賭けの相手を心配？"},
        { "location": "595/TALK"    , "narrator": "みやび", "text": "変なBotや"},
        { "location": "596/TALK"    , "narrator": "みやび", "text": "まあえい"},
        { "location": "597/TALK"    , "narrator": "みやび", "text": "賭けは賭けやし"},
        { "location": "598/TALK"    , "narrator": "みやび", "text": "みやびさん"},
        { "location": "599/TALK"    , "narrator": "みやび", "text": "本気モードで行くぞね"},
        { "location": "613/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "616/TALK"    , "narrator": "みやび", "text": "よし、行くちや！！"},
        { "location": "469/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>5月3日　2:07 PM</color>\nFreyMENOWライブ中に発生した\nフェノメノンドーム戦にて。"}
    ]
}
