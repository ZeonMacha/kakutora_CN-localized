{
    "dir": "chap09/daydra/dd_ch03_09_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "9356",
        "cid": "gabriella",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "先輩以外の呼び方"
    },
    "entry":
    [
        { "location": "386/SCENARIO", "narrator": "", "text": "先輩以外の呼び方"},
        { "location": "400/TALK"    , "narrator": "つばめ", "text": "あっ、せんぱーい！"},
        { "location": "405/TALK"    , "narrator": "ガブリエラ", "text": "ちょ、ちょっと新入り！"},
        { "location": "406/TALK"    , "narrator": "ガブリエラ", "text": "中等部で先輩って\n呼ばないでって、\n前にも言ったでしょ！？"},
        { "location": "409/TALK"    , "narrator": "つばめ", "text": "ああっ、\nご、ごめんなさい！"},
        { "location": "410/TALK"    , "narrator": "ガブリエラ", "text": "…あんた、ほんっとーに\n空気が読めないわね。"},
        { "location": "411/TALK"    , "narrator": "ガブリエラ", "text": "メチャクチャ周りから\n変な目で見られてるのに、\nどうして気づかないの？"},
        { "location": "412/TALK"    , "narrator": "ガブリエラ", "text": "とにかく、ここで先輩って\n呼ぶのは禁止よ。"},
        { "location": "413/TALK"    , "narrator": "つばめ", "text": "でも、それじゃあなんて\n呼んだらいいんですか？"},
        { "location": "416/TALK"    , "narrator": "ガブリエラ", "text": "そ、そうね…\nちょっと待ちなさい。"},
        { "location": "430/TALK"    , "narrator": "ガブリエラ", "text": "マルザンナ、質問があるの"},
        { "location": "431/TALK"    , "narrator": "ガブリエラ", "text": "新入りの私の呼び方なんだけど"},
        { "location": "432/TALK"    , "narrator": "ガブリエラ", "text": "中等部で先輩っていうのは、変に目立つでしょう？"},
        { "location": "433/TALK"    , "narrator": "ガブリエラ", "text": "他に良い呼び方ってあるかしら？"},
        { "location": "434/TALK"    , "narrator": "ガブリエラ", "text": "でも、呼び捨てとガブちゃんは禁止よ。"},
        { "location": "436/SEL"     , "narrator": "", "text": "ガブちゃんで諦めよう"},
        { "location": "437/SEL"     , "narrator": "", "text": "普通は呼び捨てじゃない？"},
        { "location": "438/SEL"     , "narrator": "", "text": "ギャヴィは？"},
        { "location": "439/ACT"     , "narrator": "", "text": "ガブちゃんで諦めよう"},
        { "location": "440/TALK"    , "narrator": "ガブリエラ", "text": "諦められないから聞いてるのよ、もぅ！"},
        { "location": "453/TALK"    , "narrator": "ガブリエラ", "text": "まったく、使えないんだから…。"},
        { "location": "454/TALK"    , "narrator": "ガブリエラ", "text": "先輩とガブちゃん以外で、\n新人があたしを呼ぶと\nしたら…。"},
        { "location": "456/TALK"    , "narrator": "ガブリエラ", "text": "う～ん…。"},
        { "location": "457/TALK"    , "narrator": "つばめ", "text": "じゃあ中等部では、\nやっほー、とか、おーい、\nって呼ぶのは？"},
        { "location": "459/TALK"    , "narrator": "ガブリエラ", "text": "それ、すっごい目立ちそう\nなんだけど…。"},
        { "location": "460/TALK"    , "narrator": "ガブリエラ", "text": "まあ、高等部のトライ\nナリーメンバーがいる、\nってだけでも――"},
        { "location": "461/TALK"    , "narrator": "ガブリエラ", "text": "普通に目立ちはすると\n思うけど。"},
        { "location": "464/TALK"    , "narrator": "つばめ", "text": "そっかぁ…。\nこういう時、みんなと違う\n制服って不便ですね。"},
        { "location": "465/TALK"    , "narrator": "ガブリエラ", "text": "そうね…って――"},
        { "location": "466/TALK"    , "narrator": "ガブリエラ", "text": "そういう話をしてるん\nじゃない！"},
        { "location": "467/TALK"    , "narrator": "ガブリエラ", "text": "やっぱり、あんたは\n今まで通り先輩って\n呼んでくれればいいわ。"},
        { "location": "468/TALK"    , "narrator": "ガブリエラ", "text": "それ以外の呼び方されても\nしっくり来ないと思うし。"},
        { "location": "470/TALK"    , "narrator": "つばめ", "text": "わかりました。"},
        { "location": "472/TALK"    , "narrator": "つばめ", "text": "じゃあ、これからも\nせんぱいって呼びますね！"},
        { "location": "475/TALK"    , "narrator": "ガブリエラ", "text": "でも、ここでは声の\nボリュームを下げて\n呼びなさい！"},
        { "location": "476/ACT"     , "narrator": "", "text": "普通は呼び捨てじゃない？"},
        { "location": "477/TALK"    , "narrator": "ガブリエラ", "text": "それはそうだけど…"},
        { "location": "478/TALK"    , "narrator": "ガブリエラ", "text": "呼び捨てかぁ"},
        { "location": "479/TALK"    , "narrator": "ガブリエラ", "text": "嫌だけど"},
        { "location": "480/TALK"    , "narrator": "ガブリエラ", "text": "一度試してみるわ"},
        { "location": "492/TALK"    , "narrator": "ガブリエラ", "text": "よし、新人！\nあたしを呼び捨てにして\nみなさい。"},
        { "location": "495/TALK"    , "narrator": "つばめ", "text": "ガブちゃん！\nすっごく嫌な予感しか\nしないんだけど！？"},
        { "location": "498/TALK"    , "narrator": "ガブリエラ", "text": "サラッとガブちゃん\n言うな！"},
        { "location": "499/TALK"    , "narrator": "ガブリエラ", "text": "いいから早くしなさい！\n早く早く！"},
        { "location": "501/TALK"    , "narrator": "つばめ", "text": "わ、わかりました…"},
        { "location": "503/TALK"    , "narrator": "つばめ", "text": "ガブリエラ。"},
        { "location": "505/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "506/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "509/TALK"    , "narrator": "ガブリエラ", "text": "絶対却下ね。"},
        { "location": "510/TALK"    , "narrator": "つばめ", "text": "だから言ったのにー！"},
        { "location": "512/TALK"    , "narrator": "ガブリエラ", "text": "やっぱり、あんたは\n今まで通り先輩って\n呼んでくれればいいわ。"},
        { "location": "513/TALK"    , "narrator": "ガブリエラ", "text": "それ以外の呼び方されても\nしっくり来ないと思うし。"},
        { "location": "514/TALK"    , "narrator": "つばめ", "text": "わかりました。"},
        { "location": "516/TALK"    , "narrator": "つばめ", "text": "じゃあ、これからも\nせんぱいって呼びますね！"},
        { "location": "519/TALK"    , "narrator": "ガブリエラ", "text": "でも、ここでは声の\nボリュームを下げて\n呼びなさい！"},
        { "location": "520/ACT"     , "narrator": "", "text": "ギャヴィは？"},
        { "location": "523/TALK"    , "narrator": "ガブリエラ", "text": "新入りがギャヴィ？"},
        { "location": "524/TALK"    , "narrator": "ガブリエラ", "text": "アーヤや真幌ならまだしも新入りには合わないような…"},
        { "location": "525/TALK"    , "narrator": "ガブリエラ", "text": "一応試してみるけど"},
        { "location": "538/TALK"    , "narrator": "ガブリエラ", "text": "よし、新人！\nギャヴィって呼んで\nみなさい。"},
        { "location": "539/TALK"    , "narrator": "つばめ", "text": "それってアーヤさんや\n真幌さんみたいな\n呼び方ですよね？"},
        { "location": "541/TALK"    , "narrator": "ガブリエラ", "text": "そうよ。\nほら、早く。"},
        { "location": "543/TALK"    , "narrator": "つばめ", "text": "うん、ギャヴィ。"},
        { "location": "545/TALK"    , "narrator": "ガブリエラ", "text": "…………？"},
        { "location": "547/TALK"    , "narrator": "ガブリエラ", "text": "もう一回言ってみて。"},
        { "location": "548/TALK"    , "narrator": "つばめ", "text": "ギャヴィ。"},
        { "location": "550/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "552/TALK"    , "narrator": "ガブリエラ", "text": "何かしら？\nこの、どこがどうとは\n言えないんだけど――"},
        { "location": "553/TALK"    , "narrator": "ガブリエラ", "text": "なんか違う感じがして\nムズムズするわ。"},
        { "location": "554/TALK"    , "narrator": "つばめ", "text": "発音が変とか？"},
        { "location": "556/TALK"    , "narrator": "ガブリエラ", "text": "っていうか――"},
        { "location": "558/TALK"    , "narrator": "ガブリエラ", "text": "新人にギャヴィって\n呼ばれるのが、なんとなく\n気に入らないだけかも。"},
        { "location": "561/TALK"    , "narrator": "つばめ", "text": "呼べって言ったのは\nせんぱいなのにぃ…。"},
        { "location": "563/TALK"    , "narrator": "ガブリエラ", "text": "やっぱり、あんたは\n今まで通り先輩って\n呼んでくれればいいわ。"},
        { "location": "564/TALK"    , "narrator": "ガブリエラ", "text": "それ以外の呼び方されても\nしっくり来ないと思うし。"},
        { "location": "566/TALK"    , "narrator": "つばめ", "text": "わかりました。"},
        { "location": "568/TALK"    , "narrator": "つばめ", "text": "じゃあ、これからも\nせんぱいって呼びますね！"},
        { "location": "571/TALK"    , "narrator": "ガブリエラ", "text": "でも、ここでは声の\nボリュームを下げて\n呼びなさい！"},
        { "location": "393/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>5月30日　9:40 AM</color>\nとある平日の午前中、\n附属学園中等部廊下にて。"},
        { "location": "582/DIALOG"  , "narrator": "Dialog_GEThimegoto_ch03", "text": "【慣れたりするかしら】"},
        { "location": "593/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>1000pt.</b></color></size>\nアップしました！"}
    ]
}
