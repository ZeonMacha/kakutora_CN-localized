    "entry":
    [
        { "location": "18/DIALOG" , "narrator": "", "text": "<color=green>4月12日　3:12 PM</color>\nいつの年かの2E113世界における、神楽坂トライナリーホワイエにて。"},
        { "location": "31/TALK"   , "narrator": "アーヤ", "text": "掃除終わった？"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "もうとっくに\n終わってるわよ。"},
        { "location": "35/TALK"   , "narrator": "つばめ", "text": "はーい！\n完了です！"},
        { "location": "36/TALK"   , "narrator": "神楽", "text": "こっちも大丈夫ですよ。"},
        { "location": "38/TALK"   , "narrator": "アーヤ", "text": "わー、ありがとう。\n助かるわー。"},
        { "location": "39/TALK"   , "narrator": "アーヤ", "text": "最初は一人で\n全部やってたから。\n大変だったのよ。"},
        { "location": "40/TALK"   , "narrator": "つばめ", "text": "そうだったんですね。"},
        { "location": "42/TALK"   , "narrator": "ガブリエラ", "text": "何よ。"},
        { "location": "43/TALK"   , "narrator": "ガブリエラ", "text": "あたしがちゃんと\n手伝ってたでしょ。\nここに来てからは。"},
        { "location": "44/TALK"   , "narrator": "神楽", "text": "そういえば、\nもうそろそろ一年に\nなるんですよね。"},
        { "location": "45/TALK"   , "narrator": "神楽", "text": "今の５人が\n集まってから。"},
        { "location": "46/TALK"   , "narrator": "アーヤ", "text": "そうね。"},
        { "location": "47/TALK"   , "narrator": "神楽", "text": "何か記念イベント的な\nことしません？\nせっかくだし。"},
        { "location": "49/TALK"   , "narrator": "つばめ", "text": "あっ！\n賛成！"},
        { "location": "52/TALK"   , "narrator": "ガブリエラ", "text": "…悪くは\nないんじゃない。"},
        { "location": "53/TALK"   , "narrator": "神楽", "text": "温泉とかどうですか？\n慰安旅行っぽく。"},
        { "location": "54/TALK"   , "narrator": "アーヤ", "text": "いいアイディアだけど。"},
        { "location": "55/TALK"   , "narrator": "アーヤ", "text": "館長がどう言うかね。"},
        { "location": "56/TALK"   , "narrator": "アーヤ", "text": "……ちょっと\n聞いてくるわ。"},
        { "location": "59/TALK"   , "narrator": "つばめ", "text": "温泉かー。"},
        { "location": "61/TALK"   , "narrator": "神楽", "text": "静岡は温泉地\nありますもんね。"},
        { "location": "62/TALK"   , "narrator": "神楽", "text": "おすすめの温泉とか\nありますか？"},
        { "location": "64/TALK"   , "narrator": "つばめ", "text": "……あんまり\n詳しくないんだ…。"},
        { "location": "66/TALK"   , "narrator": "つばめ", "text": "ごめんね。"},
        { "location": "67/TALK"   , "narrator": "神楽", "text": "あっ別に\n謝ることじゃ\nないですよ！"},
        { "location": "74/TALK"   , "narrator": "みやび", "text": "何や何や。\nつまみ食いでも\nしたんかね。"},
        { "location": "77/TALK"   , "narrator": "つばめ", "text": "えっ！？\n違いますよー。"},
        { "location": "78/TALK"   , "narrator": "つばめ", "text": "温泉でも行きたいって\n話をしてたんです。"},
        { "location": "79/TALK"   , "narrator": "みやび", "text": "おー。\nええねえ。"},
        { "location": "80/TALK"   , "narrator": "みやび", "text": "決まったらうちも\n参加させて欲しいぞね。"},
        { "location": "81/TALK"   , "narrator": "つばめ", "text": "もちろんです！"},
        { "location": "84/TALK"   , "narrator": "つばめ", "text": "って、どっか\n行っちゃった…。"},
        { "location": "87/TALK"   , "narrator": "神楽", "text": "マイペースなのが\nみやびさんの\n持ち味ですよね。"},
        { "location": "93/TALK"   , "narrator": "アーヤ", "text": "館長からＯＫが\n出たわよ。"},
        { "location": "94/TALK"   , "narrator": "アーヤ", "text": "東京近郊なら\nいざって時は\nヘリを出すって。"},
        { "location": "96/TALK"   , "narrator": "ガブリエラ", "text": "そうならないことを\nお願いしたいわ。"},
        { "location": "97/TALK"   , "narrator": "アーヤ", "text": "…まあそうだけど。"},
        { "location": "98/TALK"   , "narrator": "アーヤ", "text": "で？\n温泉にするの？"},
        { "location": "99/TALK"   , "narrator": "つばめ", "text": "わたしはどこでも…。"},
        { "location": "100/TALK"  , "narrator": "神楽", "text": "温泉！\n温泉を希望します！"},
        { "location": "102/TALK"  , "narrator": "ガブリエラ", "text": "……何なの\nその気合い…。"},
        { "location": "114/TALK"  , "narrator": "つばめ", "text": "ねぇねぇ|д･´)"},
        { "location": "116/SEL"   , "narrator": "（選択肢）", "text": "はいはい"},
        { "location": "117/ACT"   , "narrator": "", "text": "はいはい"},
        { "location": "118/TALK"  , "narrator": "つばめ", "text": "東京の近くでオススメの温泉ある？"},
        { "location": "120/SEL"   , "narrator": "（選択肢）", "text": "よくわかんない"},
        { "location": "121/SEL"   , "narrator": "（選択肢）", "text": "あるっちゃあるかな"},
        { "location": "122/SEL"   , "narrator": "（選択肢）", "text": "好きに決めればいいよ"},
        { "location": "123/ACT"   , "narrator": "", "text": "よくわかんない"},
        { "location": "124/TALK"  , "narrator": "つばめ", "text": "そっかー"},
        { "location": "125/ACT"   , "narrator": "", "text": "あるっちゃあるかな"},
        { "location": "126/TALK"  , "narrator": "つばめ", "text": "ぇっとそれは"},
        { "location": "127/TALK"  , "narrator": "つばめ", "text": "ぁるのないの？"},
        { "location": "128/TALK"  , "narrator": "つばめ", "text": "ょくわかんなぃ_(┐「ε:)_"},
        { "location": "129/ACT"   , "narrator": "", "text": "好きに決めればいいよ"},
        { "location": "130/TALK"  , "narrator": "つばめ", "text": "そぅ？"},
        { "location": "131/TALK"  , "narrator": "つばめ", "text": "$handle$さんにも聞いてみたかったのにな"},
        { "location": "143/TALK"  , "narrator": "神楽", "text": "秩父だと日帰りも\nできますし。"},
        { "location": "145/TALK"  , "narrator": "ガブリエラ", "text": "行ったことないから\nちょうどいいかも。"},
        { "location": "147/TALK"  , "narrator": "アーヤ", "text": "泊まってもいいって。\nなんだかご機嫌\nだったのよ、館長。"},
        { "location": "159/TALK"  , "narrator": "つばめ", "text": "秩父になりそうだょ"},
        { "location": "160/TALK"  , "narrator": "つばめ", "text": "どんなとこなのかな？"},
        { "location": "162/SEL"   , "narrator": "（選択肢）", "text": "$me$の地元"},
        { "location": "163/SEL"   , "narrator": "（選択肢）", "text": "よく知らないんだ"},
        { "location": "164/SEL"   , "narrator": "（選択肢）", "text": "楽しみだね"},
        { "location": "165/ACT"   , "narrator": "", "text": "$me$の地元"},
        { "location": "166/TALK"  , "narrator": "つばめ", "text": "そぅなの？"},
        { "location": "168/TALK"  , "narrator": "つばめ", "text": "すっごく楽しみになってきた"},
        { "location": "169/ACT"   , "narrator": "", "text": "よく知らないんだ"},
        { "location": "170/TALK"  , "narrator": "つばめ", "text": "そっか"},
        { "location": "172/TALK"  , "narrator": "つばめ", "text": "でもぁたしも"},
        { "location": "173/ACT"   , "narrator": "", "text": "楽しみだね"},
        { "location": "174/TALK"  , "narrator": "つばめ", "text": "ぅんヽ(〃´∀`〃)ﾉ"},
        { "location": "176/TALK"  , "narrator": "つばめ", "text": "みんな一緒だし"},
        { "location": "178/SEL"   , "narrator": "（選択肢）", "text": "ところで"},
        { "location": "179/ACT"   , "narrator": "", "text": "ところで"},
        { "location": "180/TALK"  , "narrator": "つばめ", "text": "なぁに？"},
        { "location": "182/SEL"   , "narrator": "（選択肢）", "text": "$me$たち出会って一周年だよ"},
        { "location": "183/SEL"   , "narrator": "（選択肢）", "text": "$me$も一緒に行きたいな"},
        { "location": "184/SEL"   , "narrator": "（選択肢）", "text": "秩父なら案内できるよ"},
        { "location": "185/ACT"   , "narrator": "", "text": "$me$たち出会って一周年だよ"},
        { "location": "186/TALK"  , "narrator": "つばめ", "text": "そぅだね"},
        { "location": "187/TALK"  , "narrator": "つばめ", "text": "そぅだ"},
        { "location": "188/TALK"  , "narrator": "つばめ", "text": "$handle$さんも一緒だともっと楽しぃよね"},
        { "location": "189/ACT"   , "narrator": "", "text": "$me$も一緒に行きたいな"},
        { "location": "190/TALK"  , "narrator": "つばめ", "text": "ぅんぅん"},
        { "location": "191/TALK"  , "narrator": "つばめ", "text": "大歓迎ヾ(*´ｴ`*)ﾉ"},
        { "location": "192/ACT"   , "narrator": "", "text": "秩父なら案内できるよ"},
        { "location": "193/TALK"  , "narrator": "つばめ", "text": "本当？"},
        { "location": "194/TALK"  , "narrator": "つばめ", "text": "案内してもらわなきゃ"},
        { "location": "208/TALK"  , "narrator": "つばめ", "text": "$handle$さんも\n行きたいって。"},
        { "location": "211/TALK"  , "narrator": "ガブリエラ", "text": "え！？"},
        { "location": "212/TALK"  , "narrator": "アーヤ", "text": "それはダメ！"},
        { "location": "214/TALK"  , "narrator": "つばめ", "text": "え？\nどうして？"},
        { "location": "217/TALK"  , "narrator": "ガブリエラ", "text": "どうしてって！\nだって、ねえ……。"},
        { "location": "219/TALK"  , "narrator": "アーヤ", "text": "そうよ…。\n浴衣とか……。"},
        { "location": "220/TALK"  , "narrator": "ガブリエラ", "text": "とにかく無理\n絶対無理！"},
        { "location": "222/TALK"  , "narrator": "アーヤ", "text": "無理だから！"},
        { "location": "226/DIALOG", "narrator": "", "text": "\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n　　　　　　To be continued !"}
    ]
}
