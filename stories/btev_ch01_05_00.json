    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "綺麗すぎる湖１"},
        { "location": "13/DIALOG" , "narrator": "", "text": "<size=40>KOKORO-Lv. 02</size>\nTSUBAME - OHSE\n\n<size=45>綺麗すぎる湖Ⅰ</size>\n<size=35>～源～</size>"},
        { "location": "25/TALK"   , "narrator": "表層つばめ", "text": "……。"},
        { "location": "27/TALK"   , "narrator": "表層つばめ", "text": "………。"},
        { "location": "30/TALK"   , "narrator": "表層つばめ", "text": "…。"},
        { "location": "32/SEL"    , "narrator": "（選択肢）", "text": "また悩んでるの？"},
        { "location": "33/ACT"    , "narrator": "", "text": "こんにちは"},
        { "location": "36/TALK"   , "narrator": "表層つばめ", "text": "あ…あなたは……"},
        { "location": "37/SEL"    , "narrator": "（選択肢）", "text": "そうです、私が$handle$です"},
        { "location": "38/ACT"    , "narrator": "", "text": "そうです、私が$handle$です"},
        { "location": "40/TALK"   , "narrator": "表層つばめ", "text": "そう、$handle$。\nココロレベル０１でも\n助けてくれたよね。"},
        { "location": "41/SEL"    , "narrator": "（選択肢）", "text": "今度はどうしたの？"},
        { "location": "42/ACT"    , "narrator": "", "text": "今度はどうしたの？"},
        { "location": "44/TALK"   , "narrator": "表層つばめ", "text": "うん、実は……その、"},
        { "location": "45/TALK"   , "narrator": "表層つばめ", "text": "わたし多分、\n他のみんなとは上手く\nやっていけないと思う。"},
        { "location": "46/SEL"    , "narrator": "（選択肢）", "text": "他のみんなって、トライナリーのメンバーのこと？"},
        { "location": "47/ACT"    , "narrator": "", "text": "他のみんなって、トライナリーのメンバーのこと？"},
        { "location": "49/TALK"   , "narrator": "表層つばめ", "text": "うん。"},
        { "location": "50/TALK"   , "narrator": "表層つばめ", "text": "一緒の教室にいるだけ\nの人と違うでしょ、\n任務あるし。"},
        { "location": "51/TALK"   , "narrator": "表層つばめ", "text": "これからもその度に\n気まずくなると思うと\n憂鬱で。"},
        { "location": "52/SEL"    , "narrator": "（選択肢）", "text": "普通に友達になれると思うけど？"},
        { "location": "53/SEL"    , "narrator": "（選択肢）", "text": "トライナリーは変人揃いだから大丈夫！"},
        { "location": "54/ACT"    , "narrator": "", "text": "普通に友達になれると思うけど？"},
        { "location": "55/TALK"   , "narrator": "表層つばめ", "text": "無理だよ。\n今までだって\nそうだったもん。"},
        { "location": "56/ACT"    , "narrator": "", "text": "トライナリーは変人揃いだから大丈夫！"},
        { "location": "57/TALK"   , "narrator": "表層つばめ", "text": "え、ええええっ！\nそうか……な…"},
        { "location": "58/TALK"   , "narrator": "表層つばめ", "text": "……あ、うん…\n確かにそうかも……。"},
        { "location": "59/TALK"   , "narrator": "表層つばめ", "text": "でもやっぱり、\nきっと友達には\nなれないよ。"},
        { "location": "60/TALK"   , "narrator": "表層つばめ", "text": "今までだって\nそうだったもん。"},
        { "location": "62/TALK"   , "narrator": "表層つばめ", "text": "最初は話しかけて\nくれるけど、段々\n遠くなっちゃって…"},
        { "location": "63/SEL"    , "narrator": "（選択肢）", "text": "なんでだろうね"},
        { "location": "64/ACT"    , "narrator": "", "text": "なんでだろうね"},
        { "location": "66/TALK"   , "narrator": "表層つばめ", "text": "わからない。"},
        { "location": "67/TALK"   , "narrator": "表層つばめ", "text": "いつの間にか、\nみんな話してくれなく\nなっちゃうから……"},
        { "location": "68/SEL"    , "narrator": "（選択肢）", "text": "ココロの奥に答えがあるかも"},
        { "location": "69/ACT"    , "narrator": "", "text": "ココロの奥に答えがあるかも"},
        { "location": "71/TALK"   , "narrator": "表層つばめ", "text": "そうかもしれないけど\nどこにあるのか\nわからないし……"},
        { "location": "72/SEL"    , "narrator": "（選択肢）", "text": "一緒に探そう"},
        { "location": "73/ACT"    , "narrator": "", "text": "一緒に探そう"},
        { "location": "75/TALK"   , "narrator": "表層つばめ", "text": "え、でも……\n悪いよ。"},
        { "location": "76/SEL"    , "narrator": "（選択肢）", "text": "大丈夫。経験則上、本気で探そうと思えば、すぐに手がかりがやってくる"},
        { "location": "77/ACT"    , "narrator": "", "text": "大丈夫。経験則上、本気で探そうと思えば、すぐに手がかりがやってくる"},
        { "location": "79/TALK"   , "narrator": "表層つばめ", "text": "そ、そうなの！？"},
        { "location": "81/TALK"   , "narrator": "表層つばめ", "text": "も、もちろん\nそれが分かるなら\n本気で探すよ！！"},
        { "location": "83/TALK"   , "narrator": "潜在つばめ", "text": "そうはいかない。"},
        { "location": "90/TALK"   , "narrator": "表層つばめ", "text": "え！？\nあなたは？"},
        { "location": "92/TALK"   , "narrator": "潜在つばめ", "text": "記憶の鍵番をしている\nわたしだよ。"},
        { "location": "93/SEL"    , "narrator": "（選択肢）", "text": "ほら、出てきた！"},
        { "location": "94/ACT"    , "narrator": "", "text": "ほら、出てきた！"},
        { "location": "96/TALK"   , "narrator": "潜在つばめ", "text": "$handle$だっけ？\nあなた、余計なこと\nしないで。"},
        { "location": "97/TALK"   , "narrator": "潜在つばめ", "text": "ココロの中には\n忘れてしまった方が\nいいこともある。"},
        { "location": "98/TALK"   , "narrator": "潜在つばめ", "text": "それを封印するのが\nわたしの仕事。\nだから――"},
        { "location": "99/TALK"   , "narrator": "潜在つばめ", "text": "それを妨害するなら\n実力をもって\n排除する。"},
        { "location": "100/TALK"  , "narrator": "表層つばめ", "text": "えええっ！！"},
        { "location": "104/TALK"  , "narrator": "表層つばめ", "text": "$handle$、\nどどどどうしよう……"},
        { "location": "105/SEL"   , "narrator": "（選択肢）", "text": "戦おう。$me$も手伝うから"},
        { "location": "106/ACT"   , "narrator": "", "text": "戦おう。$me$も手伝うから"},
        { "location": "108/TALK"  , "narrator": "表層つばめ", "text": "で、でも……"},
        { "location": "109/SEL"   , "narrator": "（選択肢）", "text": "友達作りたいんでしょ？"},
        { "location": "110/ACT"   , "narrator": "", "text": "友達作りたいんでしょ？"},
        { "location": "112/TALK"  , "narrator": "表層つばめ", "text": "う、うん……"},
        { "location": "113/SEL"   , "narrator": "（選択肢）", "text": "じゃあ、ヒントを見つけなきゃ"},
        { "location": "114/ACT"   , "narrator": "", "text": "じゃあ、ヒントを見つけなきゃ"},
        { "location": "116/TALK"  , "narrator": "表層つばめ", "text": "そう……だね。"},
        { "location": "117/TALK"  , "narrator": "表層つばめ", "text": "……。"},
        { "location": "121/TALK"  , "narrator": "表層つばめ", "text": "鍵番さん、\nごめんなさい。"},
        { "location": "122/TALK"  , "narrator": "表層つばめ", "text": "邪魔するなら、\nわたしも戦うよ。"},
        { "location": "123/TALK"  , "narrator": "潜在つばめ", "text": "そう。残念だよ。"},
        { "location": "124/TALK"  , "narrator": "潜在つばめ", "text": "わたしの眷属の\nクランを見たら\nきっと後悔するよ？"},
        { "location": "125/TALK"  , "narrator": "表層つばめ", "text": "そ、そんなこと\nないよ！！"},
        { "location": "126/TALK"  , "narrator": "潜在つばめ", "text": "わかった。\nそれじゃ戦おう。"},
        { "location": "127/TALK"  , "narrator": "潜在つばめ", "text": "あなたが勝ったら、\n貴方の見たい記憶を\n１つあげる。"},
        { "location": "128/TALK"  , "narrator": "潜在つばめ", "text": "見る場合は\n自己責任で。\nいい？"},
        { "location": "129/TALK"  , "narrator": "表層つばめ", "text": "もちろんだよ。"},
        { "location": "130/TALK"  , "narrator": "潜在つばめ", "text": "わかった。\nそれじゃあ――"},
        { "location": "131/TALK"  , "narrator": "潜在つばめ", "text": "いくよ！　　　"},
        { "location": "143/DIALOG", "narrator": "", "text": "<color=black><size=50><b>記憶を封印する鍵番を倒し\n過去の記憶を蘇らせよ！</b></size></color>\n\n\n\nなぜか、友達が離れていってしまうという\n悩みを抱えるつばめ。\n理由がわからないのは、\n鍵番がその原因を隠しているから！？\n\nつばめが成長する為にも、記憶の封印を解くのだ！\n\n\n\n\n"}
    ]
}
