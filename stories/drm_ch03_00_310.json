        { "location": "189/SCENARIO", "narrator": "", "text": "310_攻略レベル01"},
        { "location": "214/TALK"    , "narrator": "ガブリエラ", "text": "たったひとつの願いがあるの"},
        { "location": "215/TALK"    , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "218/TALK"    , "narrator": "ガブリエラ", "text": "近い未来に現実になるでしょう"},
        { "location": "219/TALK"    , "narrator": "ガブリエラ", "text": "だってそうでしょう？"},
        { "location": "224/TALK"    , "narrator": "ボイスメール", "text": "乙女のテーマ"},
        { "location": "242/SEL"     , "narrator": "", "text": "占いでもしたの？"},
        { "location": "243/SEL"     , "narrator": "", "text": "預言者になるの？"},
        { "location": "244/SEL"     , "narrator": "", "text": "$handle$との未来の話？"},
        { "location": "246/TALK"    , "narrator": "ガブリエラ", "text": "なんてvvvvv"},
        { "location": "248/TALK"    , "narrator": "ガブリエラ", "text": "そうなっちゃったらvvvv"},
        { "location": "249/TALK"    , "narrator": "ガブリエラ", "text": "どうしようかしら/////////////////"},
        { "location": "252/ACT"     , "narrator": "", "text": "占いでもしたの？"},
        { "location": "253/TALK"    , "narrator": "ガブリエラ", "text": "やだ"},
        { "location": "255/TALK"    , "narrator": "ガブリエラ", "text": "占いなんかじゃないわ"},
        { "location": "256/ACT"     , "narrator": "", "text": "預言者になるの？"},
        { "location": "257/TALK"    , "narrator": "ガブリエラ", "text": "違うわ"},
        { "location": "258/TALK"    , "narrator": "ガブリエラ", "text": "私の運命のことよ"},
        { "location": "259/ACT"     , "narrator": "", "text": "$handle$との未来の話？"},
        { "location": "260/TALK"    , "narrator": "ガブリエラ", "text": "なんでそうなるのかしら"},
        { "location": "262/TALK"    , "narrator": "ガブリエラ", "text": "二回続けて同じところでヒカルくんに会ったでしょ？"},
        { "location": "263/TALK"    , "narrator": "ガブリエラ", "text": "二回もよ？"},
        { "location": "264/TALK"    , "narrator": "ガブリエラ", "text": "これって運命だと思うのよね"},
        { "location": "266/TALK"    , "narrator": "ガブリエラ", "text": "そうでしょう？"},
        { "location": "268/SEL"     , "narrator": "", "text": "そうだね"},
        { "location": "269/SEL"     , "narrator": "", "text": "どうかな……"},
        { "location": "270/ACT"     , "narrator": "", "text": "そうだね"},
        { "location": "271/ACT"     , "narrator": "", "text": "どうかな……"},
        { "location": "273/TALK"    , "narrator": "ガブリエラ", "text": "運命に決まってるじゃないの！"},
        { "location": "275/SEL"     , "narrator": "", "text": "そうだね　"},
        { "location": "276/SEL"     , "narrator": "", "text": "うーん……"},
        { "location": "277/SEL"     , "narrator": "", "text": "あ、はい"},
        { "location": "278/ACT"     , "narrator": "", "text": "そうだね　"},
        { "location": "279/ACT"     , "narrator": "", "text": "うーん……"},
        { "location": "280/ACT"     , "narrator": "", "text": "あ、はい"},
        { "location": "282/TALK"    , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "283/TALK"    , "narrator": "ガブリエラ", "text": "まあ"},
        { "location": "284/TALK"    , "narrator": "ガブリエラ", "text": "多少は貴方のおかげもあると思っているのよ"},
        { "location": "287/SEL"     , "narrator": "", "text": "そうだね　　"},
        { "location": "288/SEL"     , "narrator": "", "text": "どうかな……"},
        { "location": "289/SEL"     , "narrator": "", "text": "$handle$に乗り替えようよ"},
        { "location": "290/ACT"     , "narrator": "", "text": "そうだね　　"},
        { "location": "291/TALK"    , "narrator": "ガブリエラ", "text": "そうなのよ"},
        { "location": "292/TALK"    , "narrator": "ガブリエラ", "text": "ちょっとだけだけどね"},
        { "location": "293/ACT"     , "narrator": "", "text": "どうかな……"},
        { "location": "294/TALK"    , "narrator": "ガブリエラ", "text": "歯切れが悪いのね"},
        { "location": "295/ACT"     , "narrator": "", "text": "$handle$に乗り替えようよ"},
        { "location": "305/TALK"    , "narrator": "ガブリエラ", "text": "えっ"},
        { "location": "308/SEL"     , "narrator": "", "text": "好きだから"},
        { "location": "309/SEL"     , "narrator": "", "text": "大事にするから"},
        { "location": "310/SEL"     , "narrator": "", "text": "きみの一番の理解者だと思ってる"},
        { "location": "311/ACT"     , "narrator": "", "text": "好きだから"},
        { "location": "312/ACT"     , "narrator": "", "text": "大事にするから"},
        { "location": "313/ACT"     , "narrator": "", "text": "きみの一番の理解者だと思ってる"},
        { "location": "316/TALK"    , "narrator": "ガブリエラ", "text": "何を言い出すかと思えば・・・！"},
        { "location": "317/TALK"    , "narrator": "ガブリエラ", "text": "貴方は私の使用人よ？？？？"},
        { "location": "318/TALK"    , "narrator": "ガブリエラ", "text": "貴方と私が付き合うとか、そんなのおかしいわよ？？"},
        { "location": "320/TALK"    , "narrator": "ガブリエラ", "text": "大体、ほかの子達にもそんなこと言ったりしてるんでしょう？"},
        { "location": "321/TALK"    , "narrator": "ガブリエラ", "text": "とにかく"},
        { "location": "322/TALK"    , "narrator": "ガブリエラ", "text": "それはありえないわ"},
        { "location": "323/TALK"    , "narrator": "ガブリエラ", "text": "絶対に"},
        { "location": "325/TALK"    , "narrator": "ガブリエラ", "text": "運命は私とヒカルくんの周りを回っているのよ"},
        { "location": "326/TALK"    , "narrator": "ガブリエラ", "text": "これは絶対のことなんだから"},
        { "location": "327/TALK"    , "narrator": "ガブリエラ", "text": "貴方もサポートに徹してちょうだいね"},
        { "location": "236/DIALOG"  , "narrator": "Dialog_GETVoice", "text": "<color=green>【ガブリエラ】</color>のボイスメール\n<color=red>【乙女のテーマ】</color>\nをゲットしました！"},
        { "location": "301/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>800pt.</b></color></size>\nアップしました！"}
