        "title": "Extra002 プレミアムストーリー",
        "sub_title": "風邪気味"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "風邪気味"},
        { "location": "28/TALK"   , "narrator": "ガブリエラ", "text": "つばめ、なんか顔が\n赤くなってない？"},
        { "location": "30/TALK"   , "narrator": "つばめ", "text": "えっ…そういえば、\nちょっと顔が熱く\nなってるような…。"},
        { "location": "31/TALK"   , "narrator": "ガブリエラ", "text": "それ、風邪じゃないの？\n寮に戻って寝た方が\nいいんじゃない？"},
        { "location": "32/TALK"   , "narrator": "つばめ", "text": "い、いえ、大丈夫です！\nお仕事もあるのに、\n休んでられませんし――"},
        { "location": "33/TALK"   , "narrator": "つばめ", "text": "これくらいなら、\n動いてればラクに\nなりますよ。"},
        { "location": "35/TALK"   , "narrator": "ガブリエラ", "text": "…まあ、あんたが\nそう言うなら構わない\nけど…。"},
        { "location": "37/TALK"   , "narrator": "ガブリエラ", "text": "熱は夕方になると上がる、\nっていうから、\n無理しない方がいいわよ。"},
        { "location": "41/TALK"   , "narrator": "つばめ", "text": "…ガブちゃん\nわたしのこと\n心配してくれてたみたい。"},
        { "location": "43/TALK"   , "narrator": "つばめ", "text": "…素直に聞いておけば\nよかったかな？"},
        { "location": "55/TALK"   , "narrator": "つばめ", "text": "っ、コホッ！\nケホケホッ…！"},
        { "location": "56/TALK"   , "narrator": "つばめ", "text": "…意識したら、なんだか\n身体がダルくなって\nきちゃったかも。"},
        { "location": "57/SEL"    , "narrator": "", "text": "休んだ方が良い"},
        { "location": "58/SEL"    , "narrator": "", "text": "メール送信：ガブリエラ"},
        { "location": "59/SEL"    , "narrator": "", "text": "風邪薬は飲んでおいて"},
        { "location": "61/TALK"   , "narrator": "つばめ", "text": "でも、もう少しで\nお掃除終わるし――"},
        { "location": "62/TALK"   , "narrator": "つばめ", "text": "それくらいだったら、\nどうにか頑張れるかも。"},
        { "location": "65/TALK"   , "narrator": "つばめ", "text": "えっと、雑誌はこっちに\n置いて、小物はとりあえず\nこっちに…。"},
        { "location": "66/TALK"   , "narrator": "つばめ", "text": "…………。"},
        { "location": "67/TALK"   , "narrator": "つばめ", "text": "気持ち悪いかも…。\nちょっとだけ休もう…。"},
        { "location": "68/TALK"   , "narrator": "つばめ", "text": "ふぅ…\nけほっ、ゲホゲホッ！"},
        { "location": "69/TALK"   , "narrator": "つばめ", "text": "…………。"},
        { "location": "84/TALK"   , "narrator": "つばめ", "text": "う、うぅん…。"},
        { "location": "85/TALK"   , "narrator": "つばめ", "text": "…あれ？\nここって…。"},
        { "location": "87/TALK"   , "narrator": "真幌", "text": "ようやく目を覚ましたな。"},
        { "location": "90/TALK"   , "narrator": "アーヤ", "text": "つばめ、大丈夫？"},
        { "location": "92/TALK"   , "narrator": "つばめ", "text": "真幌さん…アーヤさんも？"},
        { "location": "93/TALK"   , "narrator": "つばめ", "text": "あれ……？\nわたし、楽屋にいた\nはずじゃ…。"},
        { "location": "94/TALK"   , "narrator": "真幌", "text": "覚えていないのか？\n楽屋で眠ったまま、\n起きる気配がなくてな。"},
        { "location": "95/TALK"   , "narrator": "真幌", "text": "私とアーヤで、\n部屋まで運んだんだ。"},
        { "location": "96/TALK"   , "narrator": "つばめ", "text": "そうだったんですか…。"},
        { "location": "98/TALK"   , "narrator": "アーヤ", "text": "もぅ、体調が悪いなら\n休まないとダメじゃない。"},
        { "location": "99/TALK"   , "narrator": "アーヤ", "text": "こんなに顔、真っ赤に\nしちゃって…。"},
        { "location": "100/TALK"  , "narrator": "つばめ", "text": "すみません…\nでも、休むと迷惑が…。"},
        { "location": "101/TALK"  , "narrator": "真幌", "text": "体調を悪くされる方が\n迷惑だ。"},
        { "location": "102/TALK"  , "narrator": "真幌", "text": "いいか、逢瀬。\n今後は今日みたいな\n無茶は絶対に禁止だ。"},
        { "location": "103/TALK"  , "narrator": "真幌", "text": "具合が悪い時は休み、\n少しでも早く回復する\nこと――"},
        { "location": "104/TALK"  , "narrator": "真幌", "text": "それも仕事の内だぞ？"},
        { "location": "105/TALK"  , "narrator": "つばめ", "text": "…ごめんなさい。"},
        { "location": "106/TALK"  , "narrator": "真幌", "text": "わかればそれでいい。\nアーヤ、あとは任せた。"},
        { "location": "109/TALK"  , "narrator": "アーヤ", "text": "じゃあ、おかゆでも\n作ってくるから、\n大人しく寝てるのよ？"},
        { "location": "114/TALK"  , "narrator": "つばめ", "text": "はぁ…\n余計迷惑かけちゃった。"},
        { "location": "115/TALK"  , "narrator": "つばめ", "text": "早く治して、\nちゃんと謝ろう…。"},
        { "location": "116/ACT"   , "narrator": "", "text": "休んだ方が良い"},
        { "location": "133/TALK"  , "narrator": "つばめ", "text": "そんなに具合悪く見えるかな？"},
        { "location": "145/TALK"  , "narrator": "つばめ", "text": "ちょっと動いてれば、\n気にならなくなりそう\nなんだけど"},
        { "location": "146/TALK"  , "narrator": "つばめ", "text": "…でも、\nちょっとだけ休んで、\nそれから動こうかな？"},
        { "location": "147/TALK"  , "narrator": "つばめ", "text": "けほっ、けほっ…\n何だか、気持ち悪い\nかも…。"},
        { "location": "149/TALK"  , "narrator": "つばめ", "text": "…やだなぁ。"},
        { "location": "150/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "166/TALK"  , "narrator": "つばめ", "text": "う、うぅん…。"},
        { "location": "167/TALK"  , "narrator": "つばめ", "text": "…あれ？\nここって…。"},
        { "location": "170/TALK"  , "narrator": "真幌", "text": "ようやく目を覚ましたな。"},
        { "location": "173/TALK"  , "narrator": "アーヤ", "text": "つばめ、大丈夫？"},
        { "location": "176/TALK"  , "narrator": "つばめ", "text": "真幌さん…アーヤさんも？"},
        { "location": "178/TALK"  , "narrator": "つばめ", "text": "あれ……？\nわたし、楽屋にいた\nはずじゃ…。"},
        { "location": "179/TALK"  , "narrator": "真幌", "text": "覚えていないのか？\n楽屋で眠ったまま、\n起きる気配がなくてな。"},
        { "location": "180/TALK"  , "narrator": "真幌", "text": "私とアーヤで、\n部屋まで運んだんだ。"},
        { "location": "182/TALK"  , "narrator": "つばめ", "text": "そうだったんですか…。"},
        { "location": "184/TALK"  , "narrator": "アーヤ", "text": "もぅ、体調が悪いなら\n休まないとダメじゃない。"},
        { "location": "185/TALK"  , "narrator": "アーヤ", "text": "こんなに顔、真っ赤に\nしちゃって…。"},
        { "location": "186/TALK"  , "narrator": "つばめ", "text": "すみません…\nでも、休むと迷惑が…。"},
        { "location": "187/TALK"  , "narrator": "真幌", "text": "余計体調を悪くされる方が\n迷惑だ。"},
        { "location": "188/TALK"  , "narrator": "真幌", "text": "いいか、逢瀬。\n今後は今日みたいな\n無茶は絶対に禁止だ。"},
        { "location": "189/TALK"  , "narrator": "真幌", "text": "具合が悪い時は休み、\n少しでも早く回復する\nこと――"},
        { "location": "190/TALK"  , "narrator": "真幌", "text": "それも仕事の内だぞ？"},
        { "location": "193/TALK"  , "narrator": "つばめ", "text": "…ごめんなさい。"},
        { "location": "194/TALK"  , "narrator": "真幌", "text": "わかればそれでいい。\nアーヤ、あとは任せた。"},
        { "location": "197/TALK"  , "narrator": "アーヤ", "text": "じゃあ、おかゆでも\n作ってくるから、\n大人しく寝てるのよ？"},
        { "location": "201/TALK"  , "narrator": "つばめ", "text": "はぁ…\n余計迷惑かけちゃった。"},
        { "location": "202/TALK"  , "narrator": "つばめ", "text": "早く治して、\nちゃんと謝ろう…。"},
        { "location": "203/ACT"   , "narrator": "", "text": "メール送信：ガブリエラ"},
        { "location": "209/TALK"  , "narrator": "つばめ", "text": "あれ？"},
        { "location": "210/TALK"  , "narrator": "つばめ", "text": "あれ！？\nガブちゃんにメール\n送っちゃってる！"},
        { "location": "211/TALK"  , "narrator": "つばめ", "text": "どうしよう…\nわたし、何もしてない\nのに…。"},
        { "location": "217/TALK"  , "narrator": "ガブリエラ", "text": "まったく、何なのよ？\nわざわざメールで\n呼び出すなんて！"},
        { "location": "220/TALK"  , "narrator": "つばめ", "text": "ご、ごめんなさい！\n間違って送っちゃった\nみたいで…"},
        { "location": "222/TALK"  , "narrator": "つばめ", "text": "ゲホゲホッ！"},
        { "location": "224/TALK"  , "narrator": "ガブリエラ", "text": "…ちょっと、本格的に\n風邪じゃない。"},
        { "location": "225/TALK"  , "narrator": "ガブリエラ", "text": "もういいから、\n寮で寝てなさいよ。"},
        { "location": "227/TALK"  , "narrator": "つばめ", "text": "そんな、大げさですよ。\nこれくらいなら\n心配いりませんから…。"},
        { "location": "228/TALK"  , "narrator": "ガブリエラ", "text": "あんたじゃなくて、\nお客の心配をしてるのよ！"},
        { "location": "229/TALK"  , "narrator": "ガブリエラ", "text": "映画を見に来たお客に、\nあんたの風邪がうつるかも\nしれないのよ？"},
        { "location": "230/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "232/TALK"  , "narrator": "ガブリエラ", "text": "わかったら、さっさと\n寮に戻って寝なさい。"},
        { "location": "233/TALK"  , "narrator": "つばめ", "text": "…わかりました。"},
        { "location": "234/TALK"  , "narrator": "つばめ", "text": "ありがとうございます。\nそれじゃあ、今日は\n帰って休みますね。"},
        { "location": "236/TALK"  , "narrator": "ガブリエラ", "text": "風邪薬飲むの\n忘れないでよ？"},
        { "location": "237/TALK"  , "narrator": "つばめ", "text": "はい！"},
        { "location": "242/TALK"  , "narrator": "ガブリエラ", "text": "……はぁ。"},
        { "location": "244/TALK"  , "narrator": "ガブリエラ", "text": "…まあ、お客なんて\n来ないんだから、\nうつらないんだけどね。"},
        { "location": "245/ACT"   , "narrator": "", "text": "風邪薬は飲んでおいて"},
        { "location": "262/TALK"  , "narrator": "つばめ", "text": "救急箱の中に入ってたから、すぐに飲むよ"},
        { "location": "263/TALK"  , "narrator": "つばめ", "text": "実は、結構ギリギリだったんだ…頭痛くて"},
        { "location": "274/TALK"  , "narrator": "つばめ", "text": "…風邪薬の存在、\n言われるまで思いも\nしなかったな…。"},
        { "location": "275/TALK"  , "narrator": "つばめ", "text": "熱で頭が働かないのかも。\n飲んだら、少しだけ\n休憩しよ…。"},
        { "location": "15/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>7月30日　1:23 PM</color>\n夏休み初日の午後、神楽坂トライナリー劇場でのバイト中にて。"}
    ]
}
