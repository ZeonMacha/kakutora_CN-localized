{
    "dir": "chap11/daydra/dd_ch05_11_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "11502",
        "cid": "kagura",
        "title": "002 メインストーリー",
        "sub_title": "独占禁止法？＜前編＞"
    },
    "entry":
    [
        { "location": "1018/TALK"  , "narrator": "つばめ", "text": "――そういうわけで、\n週末はひなこちゃん達と\nおでかけするの。"},
        { "location": "1020/TALK"  , "narrator": "ガブリエラ", "text": "ふーん…、\n神楽も一緒なの？"},
        { "location": "1022/TALK"  , "narrator": "神楽", "text": "いえ、その日は私、\n用事があって…。"},
        { "location": "1023/TALK"  , "narrator": "つばめ", "text": "ガブちゃんの予定は？"},
        { "location": "1024/TALK"  , "narrator": "神楽", "text": "ちょ、つばめさん。\nそんな風に呼んだら――"},
        { "location": "1025/TALK"  , "narrator": "ガブリエラ", "text": "部屋でゆっくりする\n予定だけど…。"},
        { "location": "1026/TALK"  , "narrator": "神楽", "text": "…え？"},
        { "location": "1028/TALK"  , "narrator": "つばめ", "text": "じゃあ、ガブちゃんも\n一緒に行こうよ。"},
        { "location": "1029/TALK"  , "narrator": "ガブリエラ", "text": "い、いいわよ。\nあたしが行ったって\n仕方ないし…。"},
        { "location": "1030/TALK"  , "narrator": "つばめ", "text": "そんなことないよ。\nみんなも絶対喜ぶと\n思うから！"},
        { "location": "1033/TALK"  , "narrator": "ガブリエラ", "text": "…し、仕方ないわね。\nそこまで言うなら、\n付き合ってあげるわ。"},
        { "location": "1035/TALK"  , "narrator": "つばめ", "text": "やったぁー！"},
        { "location": "1037/TALK"  , "narrator": "神楽", "text": "…なんか、二人の仲が\nよくなってるような…？"},
        { "location": "1039/TALK"  , "narrator": "神楽", "text": "…って、そんなの私には\n関係ないわね。"},
        { "location": "1078/TALK"  , "narrator": "みやび", "text": "ふぃ～、労働の後の\n風呂は極上ちや…。"},
        { "location": "1081/TALK"  , "narrator": "ガブリエラ", "text": "年寄りみたいなこと\n言わないでよ。"},
        { "location": "1084/TALK"  , "narrator": "みやび", "text": "なに言うちょるが。\nうちはガブちゃんより\n年寄りぞね。"},
        { "location": "1086/TALK"  , "narrator": "アーヤ", "text": "私の隣で年寄り年寄り\n言わないでもらえる？"},
        { "location": "1093/TALK"  , "narrator": "神楽", "text": "…あれ？\n皆さんも来てたんですか？"},
        { "location": "1096/TALK"  , "narrator": "アーヤ", "text": "あら、お疲れ様。\n卯月の方も\n終わったみたいね。"},
        { "location": "1097/TALK"  , "narrator": "みやび", "text": "残業お疲れさん。"},
        { "location": "1100/TALK"  , "narrator": "ガブリエラ", "text": "ほら、神楽もさっさと\n身体洗っちゃいなさいよ。\n風邪引くわよ？"},
        { "location": "1102/TALK"  , "narrator": "神楽", "text": "あ、はい。"},
        { "location": "1119/TALK"  , "narrator": "みやび", "text": "…そういえば、\n気になっちゅうことが\nあるんやけんど。"},
        { "location": "1121/TALK"  , "narrator": "アーヤ", "text": "なにかあったの？"},
        { "location": "1123/TALK"  , "narrator": "みやび", "text": "うむ…ガブちゃん。\nつばめちゃんと\nなにかあったが？"},
        { "location": "1127/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1129/TALK"  , "narrator": "ガブリエラ", "text": "えっ、どうして？"},
        { "location": "1131/TALK"  , "narrator": "みやび", "text": "今日、学校で二人が\n話しちょったのを\n見たんやけんど…。"},
        { "location": "1132/TALK"  , "narrator": "みやび", "text": "数日前までに比べて、\n仲良しさんになっちょる\nように見えたがよ。"},
        { "location": "1134/TALK"  , "narrator": "アーヤ", "text": "あら、そうなの？"},
        { "location": "1138/TALK"  , "narrator": "ガブリエラ", "text": "べ、別に…。\nなんにもなかったから。"},
        { "location": "1139/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1140/TALK"  , "narrator": "みやび", "text": "ふふん、\nまあ、そういうことに\nしておくぞね。"},
        { "location": "1143/TALK"  , "narrator": "ガブリエラ", "text": "な、なによそれ？\n信じなさいって！"},
        { "location": "1147/TALK"  , "narrator": "神楽", "text": "えー、それならちゃんと\n教えてくださいよー。"},
        { "location": "1148/TALK"  , "narrator": "神楽", "text": "今日のガブちゃんと\nつばめさん、\nとっても仲良しで…。"},
        { "location": "1149/TALK"  , "narrator": "神楽", "text": "私もずーっと\n気になってたんです。"},
        { "location": "1153/TALK"  , "narrator": "ガブリエラ", "text": "だ、だから仲良しに\nなったわけじゃ…。"},
        { "location": "1154/TALK"  , "narrator": "神楽", "text": "じゃあ、\n何があったんですか？"},
        { "location": "1157/TALK"  , "narrator": "ガブリエラ", "text": "うっ…もぉ、神楽は\nつばめのことになると\nしつこいんだから…。"},
        { "location": "1159/TALK"  , "narrator": "ガブリエラ", "text": "…っていうか、\n別につばめのことは\n嫌ってたわけじゃないわ。"},
        { "location": "1160/TALK"  , "narrator": "アーヤ", "text": "え、そうだったの？"},
        { "location": "1162/TALK"  , "narrator": "ガブリエラ", "text": "だって、嫌う理由なんて\nないじゃない。"},
        { "location": "1163/TALK"  , "narrator": "ガブリエラ", "text": "なんか、いつも色んな事に\n一生懸命で…。"},
        { "location": "1164/TALK"  , "narrator": "ガブリエラ", "text": "特に、他人の幸せのため\nとかになると、\n特に張り切るでしょ？"},
        { "location": "1165/TALK"  , "narrator": "ガブリエラ", "text": "…まあ、元が天然だから、\n勘違いと空回りも\nつきものだけど…。"},
        { "location": "1166/TALK"  , "narrator": "みやび", "text": "夏祭りの時の\nガブちゃんにしたの\nみたいなか？"},
        { "location": "1168/TALK"  , "narrator": "ガブリエラ", "text": "そ、そうだけど…、\nその話はもう忘れて！"},
        { "location": "1169/TALK"  , "narrator": "神楽", "text": "…嫌いじゃなかった、\nっていうのは\nわかりましたけど…。"},
        { "location": "1170/TALK"  , "narrator": "神楽", "text": "距離を開けるのを\nやめたのは、\nどうしてなんですか？"},
        { "location": "1172/TALK"  , "narrator": "ガブリエラ", "text": "…バカみたいに\n思えたのよ。"},
        { "location": "1173/TALK"  , "narrator": "ガブリエラ", "text": "普通に一生懸命で\nいい子ちゃんな\nつばめに対して…。"},
        { "location": "1174/TALK"  , "narrator": "ガブリエラ", "text": "いつまでもあんな態度を\n取ってる自分がね。"},
        { "location": "1175/TALK"  , "narrator": "神楽", "text": "…そうだったんですか。"},
        { "location": "1177/TALK"  , "narrator": "アーヤ", "text": "ふふっ、よかった。\nギャヴィとつばめが\n仲良くなってくれて。"},
        { "location": "1179/TALK"  , "narrator": "ガブリエラ", "text": "いや、だから別に\n仲良くなったわけじゃ…。"},
        { "location": "1180/TALK"  , "narrator": "神楽", "text": "でも、つばめさんも\nとっても嬉しそうでした。"},
        { "location": "1182/TALK"  , "narrator": "神楽", "text": "見てる私も\n嬉しかったです。"},
        { "location": "1183/TALK"  , "narrator": "みやび", "text": "少人数のチームやきね。\n仲良しさんでいるんが\n一番ぞね。"},
        { "location": "1184/TALK"  , "narrator": "ガブリエラ", "text": "…まあ、それについては\n否定しないけど。"},
        { "location": "1186/TALK"  , "narrator": "神楽", "text": "…本当、よかった。"},
        { "location": "1187/TALK"  , "narrator": "神楽", "text": "…あれ？"},
        { "location": "1188/TALK"  , "narrator": "アーヤ", "text": "どうかした？"},
        { "location": "1190/TALK"  , "narrator": "神楽", "text": "あ、いえ…。"},
        { "location": "1194/TALK"  , "narrator": "神楽", "text": "今…私、喜んでた…？"},
        { "location": "1195/TALK"  , "narrator": "神楽", "text": "つばめさんとガブちゃんが\n仲良くなったの…。"},
        { "location": "1196/TALK"  , "narrator": "神楽", "text": "演技じゃなくて、\n本当に喜んでた…。"},
        { "location": "1198/TALK"  , "narrator": "神楽", "text": "っ！！"},
        { "location": "1199/TALK"  , "narrator": "神楽", "text": "なに考えてるの！？\nつばめさんは、\n音羽を壊したのよ？"},
        { "location": "1201/TALK"  , "narrator": "神楽", "text": "だから、絶対に好きに\nなったりしたら\nいけないのに…。"},
        { "location": "1250/TALK"  , "narrator": "ぴょんこ", "text": "　"},
        { "location": "1291/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこです♪"},
        { "location": "1293/TALK"  , "narrator": "アーヤ", "text": "こんにちは。"},
        { "location": "1294/SEL"   , "narrator": "", "text": "前回は…大丈夫そうだね"},
        { "location": "1295/SEL"   , "narrator": "", "text": "落ち着いたところで、アーヤに聞きたいことがある"},
        { "location": "1296/ACT"   , "narrator": "", "text": "前回は…大丈夫そうだね"},
        { "location": "1297/TALK"  , "narrator": "ぴょんこ", "text": "もちのろんですよっ！"},
        { "location": "1298/TALK"  , "narrator": "ぴょんこ", "text": "実に平和なものでした。"},
        { "location": "1299/TALK"  , "narrator": "アーヤ", "text": "…そうね。"},
        { "location": "1300/ACT"   , "narrator": "", "text": "落ち着いたところで、アーヤに聞きたいことがある"},
        { "location": "1301/TALK"  , "narrator": "アーヤ", "text": "え？\nなあに？"},
        { "location": "1302/SEL"   , "narrator": "", "text": "アーヤたちはどの時間のどの世界から来たアーヤたちなの？"},
        { "location": "1303/ACT"   , "narrator": "", "text": "アーヤたちはどの時間のどの世界から来たアーヤたちなの？"},
        { "location": "1305/TALK"  , "narrator": "アーヤ", "text": "ああ、それね。"},
        { "location": "1307/TALK"  , "narrator": "アーヤ", "text": "私たちは2016年末頃の、\n姉が過去への介入を\n始めた時期から来てる。"},
        { "location": "1309/SEL"   , "narrator": "", "text": "ぴょんこｽｷ"},
        { "location": "1311/TALK"  , "narrator": "アーヤ", "text": "もちろん、\nリプレイス作戦に\n協力するということで。"},
        { "location": "1313/ACT"   , "narrator": "", "text": "ぴょんこｽｷ"},
        { "location": "1316/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん！！！"},
        { "location": "1323/TALK"  , "narrator": "アーヤ", "text": "もちろん、\nリプレイス作戦に\n協力するということで。"},
        { "location": "1325/TALK"  , "narrator": "アーヤ", "text": "とはいっても、今回の\nようなことが起こると\nわかってたわけじゃなく。"},
        { "location": "1326/TALK"  , "narrator": "アーヤ", "text": "何かあったときの\n対処要員として、\n協力してるという感じ。"},
        { "location": "1327/SEL"   , "narrator": "", "text": "警備員みたいな感じ？"},
        { "location": "1328/SEL"   , "narrator": "", "text": "過去にタイムスリップしてきている！？"},
        { "location": "1329/ACT"   , "narrator": "", "text": "警備員みたいな感じ？"},
        { "location": "1330/TALK"  , "narrator": "アーヤ", "text": "まあ、\nそう思ってくれていて\n問題ないわ。"},
        { "location": "1331/ACT"   , "narrator": "", "text": "過去にタイムスリップしてきている！？"},
        { "location": "1332/TALK"  , "narrator": "アーヤ", "text": "うーん。\nそれともちょっと\n違うかな。"},
        { "location": "1333/TALK"  , "narrator": "アーヤ", "text": "ココロスフィア…ていうか\n量子サーバー？　の中は、\n時間の概念が無いから。"},
        { "location": "1334/TALK"  , "narrator": "アーヤ", "text": "アドレスさえわかれば、\n特定の日時の特定の人物へ\n歩き感覚で行ける感じ？"},
        { "location": "1336/TALK"  , "narrator": "アーヤ", "text": "ざっくりとした\n説明になっちゃったけど、\nだいたいそんな感じ？"},
        { "location": "1337/SEL"   , "narrator": "", "text": "ありがとう"},
        { "location": "1338/ACT"   , "narrator": "", "text": "ありがとう"},
        { "location": "1341/TALK"  , "narrator": "アーヤ", "text": "さて、それじゃ私は\nそろそろ自分の心に\n戻るわね。"},
        { "location": "1343/TALK"  , "narrator": "アーヤ", "text": "あっと、最後にぴょんこ、\nWAVEアカウント\n教えてもらっていい？"},
        { "location": "1345/TALK"  , "narrator": "ぴょんこ", "text": "あ、はい！\nいいですよ？"},
        { "location": "1346/SEL"   , "narrator": "", "text": "またWAVEアカウント？"},
        { "location": "1347/ACT"   , "narrator": "", "text": "またWAVEアカウント？"},
        { "location": "1349/TALK"  , "narrator": "アーヤ", "text": "……。"},
        { "location": "1350/TALK"  , "narrator": "ぴょんこ", "text": "………。"},
        { "location": "1353/TALK"  , "narrator": "アーヤ", "text": "ありがと。"},
        { "location": "1355/TALK"  , "narrator": "ぴょんこ", "text": "いえ――"},
        { "location": "1356/TALK"  , "narrator": "アーヤ", "text": "もうちょっとしたら、\n今度はギャヴィが\n来ると思うから。"},
        { "location": "1357/TALK"  , "narrator": "ぴょんこ", "text": "わかりました。"},
        { "location": "1359/TALK"  , "narrator": "アーヤ", "text": "それじゃ二人とも、\n素敵な心の旅を。"},
        { "location": "1369/TALK"  , "narrator": "ぴょんこ", "text": "ふふふ～。"},
        { "location": "1370/TALK"  , "narrator": "ぴょんこ", "text": "さっきぴょんこが\n目配せしたのに\n気づいてくれたんですね♪"},
        { "location": "1371/SEL"   , "narrator": "", "text": "可愛かったよ"},
        { "location": "1372/SEL"   , "narrator": "", "text": "愛のシグナル受け取ったよ"},
        { "location": "1373/ACT"   , "narrator": "", "text": "可愛かったよ"},
        { "location": "1374/TALK"  , "narrator": "ぴょんこ", "text": "ふふふ～。"},
        { "location": "1375/ACT"   , "narrator": "", "text": "愛のシグナル受け取ったよ"},
        { "location": "1377/TALK"  , "narrator": "ぴょんこ", "text": "よかったですっ♪\nまた目一杯飛ばしますね！"},
        { "location": "1378/TALK"  , "narrator": "ぴょんこ", "text": "頭がジリジリと\n燃えちゃうくらいにっ！"},
        { "location": "1381/TALK"  , "narrator": "ぴょんこ", "text": "ところで\nところでっ！"},
        { "location": "1384/TALK"  , "narrator": "ぴょんこ", "text": "さあっ！\nさあっ！"},
        { "location": "1386/TALK"  , "narrator": "ぴょんこ", "text": "今ですよっ！\n今しかありません！"},
        { "location": "1387/TALK"  , "narrator": "ぴょんこ", "text": "この貴重な微小時間を\n有効活用しなかったら、\n後で大後悔しますっ！"},
        { "location": "1388/TALK"  , "narrator": "ぴょんこ", "text": "ガブちゃんが来るか、\nココロゲートが\nぶっ壊れるかっ！！"},
        { "location": "1389/TALK"  , "narrator": "ぴょんこ", "text": "その直前まで、\n二人で遊んで遊んで\n遊び倒しましょうっ♪"},
        { "location": "1390/SEL"   , "narrator": "", "text": "前者はいいけど後者はやばすぎない！？"},
        { "location": "1391/ACT"   , "narrator": "", "text": "前者はいいけど後者はやばすぎない！？"},
        { "location": "1393/TALK"  , "narrator": "ぴょんこ", "text": "壊れる直前に\nやめて仕事すれば\nいいんですよ！"},
        { "location": "1394/TALK"  , "narrator": "ぴょんこ", "text": "この限界ギリギリ感、\nパなくないですかっ！！"},
        { "location": "1395/TALK"  , "narrator": "ぴょんこ", "text": "ゾクゾクしてきた～～っ！"},
        { "location": "1396/SEL"   , "narrator": "", "text": "わかる"},
        { "location": "1397/SEL"   , "narrator": "", "text": "何かの依存症では…？"},
        { "location": "1398/ACT"   , "narrator": "", "text": "わかる"},
        { "location": "1399/TALK"  , "narrator": "ぴょんこ", "text": "ナカーマ♪"},
        { "location": "1400/ACT"   , "narrator": "", "text": "何かの依存症では…？"},
        { "location": "1401/TALK"  , "narrator": "ぴょんこ", "text": "そうですっ！\nぴょんこは\nリミットアディクション！"},
        { "location": "1403/TALK"  , "narrator": "ぴょんこ", "text": "というわけで、\n早速キスチケ\nジャンケンしませんかっ！"},
        { "location": "1404/TALK"  , "narrator": "ぴょんこ", "text": "勝ったら１枚進呈。\n負けたら１枚没収ですよ？"},
        { "location": "1405/SEL"   , "narrator": "", "text": "やる"},
        { "location": "1406/SEL"   , "narrator": "", "text": "やらない"},
        { "location": "1407/SEL"   , "narrator": "", "text": "キスチケってなに？"},
        { "location": "1408/ACT"   , "narrator": "", "text": "やる"},
        { "location": "1412/TALK"  , "narrator": "ぴょんこ", "text": "なーんて♪\n既にジャンケン\nしてますよねっ！"},
        { "location": "1416/TALK"  , "narrator": "ぴょんこ", "text": "ふふっ♪\nそうこなくちゃですっ！"},
        { "location": "1419/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんは、\n今キスチケを\n１枚も持っていませんね。"},
        { "location": "1421/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんは、\n今キスチケを\n$pyonko_kissticket$枚持ってますね。"},
        { "location": "1423/TALK"  , "narrator": "ぴょんこ", "text": "それじゃ、\nいきますよっ！"},
        { "location": "1441/TALK"  , "narrator": "ぴょんこ", "text": "ふわぁっ！\n負けちゃいました…。"},
        { "location": "1442/TALK"  , "narrator": "ぴょんこ", "text": "約束通り、\nキスチケ１枚進呈ぴょん♪"},
        { "location": "1450/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこの\n勝ちでーすっ♪"},
        { "location": "1451/TALK"  , "narrator": "ぴょんこ", "text": "約束通り、\nキスチケ１枚没収ぴょん♪"},
        { "location": "1456/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこの\n勝ちでーすっ♪"},
        { "location": "1457/TALK"  , "narrator": "ぴょんこ", "text": "というわけで、\nプレゼントはナシ！！"},
        { "location": "1464/TALK"  , "narrator": "ぴょんこ", "text": "ふぅ……\nとっても楽しかったです♪"},
        { "location": "1468/TALK"  , "narrator": "ぴょんこ", "text": "って！\nああっ！！"},
        { "location": "1469/TALK"  , "narrator": "ぴょんこ", "text": "おめでとうございます！\nキスチケ３枚\nゲットしちゃいましたね♪"},
        { "location": "1470/TALK"  , "narrator": "ぴょんこ", "text": "それじゃ早速――"},
        { "location": "1472/ACT"   , "narrator": "", "text": "やらない"},
        { "location": "1474/ACT"   , "narrator": "", "text": "キスチケってなに？"},
        { "location": "1475/TALK"  , "narrator": "ぴょんこ", "text": "３枚集めると、\nぴょんこと素敵なキスが\nできるチケットです♪"},
        { "location": "1476/TALK"  , "narrator": "ぴょんこ", "text": "ジャンケンして\n$handle$さんが\n勝ったら進呈しますけど…"},
        { "location": "1477/TALK"  , "narrator": "ぴょんこ", "text": "逆に負けたら、\n一枚没収しますっ！"},
        { "location": "1478/TALK"  , "narrator": "ぴょんこ", "text": "ジャンケンは\n1回しかできませんから、\n一発勝負ですよっ♪"},
        { "location": "1479/TALK"  , "narrator": "ぴょんこ", "text": "さあっ。\nやりますか？\nやりませんかっ！"},
        { "location": "1480/SEL"   , "narrator": "", "text": "やる"},
        { "location": "1481/SEL"   , "narrator": "", "text": "やらない"},
        { "location": "1482/ACT"   , "narrator": "", "text": "やる"},
        { "location": "1484/ACT"   , "narrator": "", "text": "やらない"},
        { "location": "1501/TALK"  , "narrator": "ぴょんこ", "text": "きたっ！！"},
        { "location": "1502/SEL"   , "narrator": "", "text": "来たね"},
        { "location": "1503/ACT"   , "narrator": "", "text": "来たね"},
        { "location": "1506/TALK"  , "narrator": "ぴょんこ", "text": "はぁ……"},
        { "location": "1507/TALK"  , "narrator": "ぴょんこ", "text": "せっかくの\nちゅータイムだったのに\n残念でしたね。"},
        { "location": "1508/TALK"  , "narrator": "ぴょんこ", "text": "落ち着いたときに\nじっくりやりましょうね。"},
        { "location": "1510/TALK"  , "narrator": "ぴょんこ", "text": "はぁ、これで今回も\n二人だけの時間は\nおしまいですね…。"},
        { "location": "1514/TALK"  , "narrator": "ガブリエラ", "text": "ちょっと、ぴょんこ！"},
        { "location": "1524/TALK"  , "narrator": "ぴょんこ", "text": "ガブちゃん！"},
        { "location": "1525/TALK"  , "narrator": "ガブリエラ", "text": "何モタモタしてるのよ。\nさっさとクランを\n倒しにいくわよ！"},
        { "location": "1526/TALK"  , "narrator": "ぴょんこ", "text": "あっ、えっと、\nそれがまだ扉を\n回してなくて……"},
        { "location": "1527/TALK"  , "narrator": "ガブリエラ", "text": "はあっ！？"},
        { "location": "1528/TALK"  , "narrator": "ガブリエラ", "text": "あんたたち、\n今まで何やってたのよ。"},
        { "location": "1529/SEL"   , "narrator": "", "text": "ごめん"},
        { "location": "1530/SEL"   , "narrator": "", "text": "ちょっと楽しいことを…"},
        { "location": "1531/ACT"   , "narrator": "", "text": "ごめん"},
        { "location": "1533/TALK"  , "narrator": "ガブリエラ", "text": "謝るくらいなら\n準備しておきなさいよ。\n生き残る気あんの！？"},
        { "location": "1534/TALK"  , "narrator": "ぴょんこ", "text": "もちろんですっ！"},
        { "location": "1535/ACT"   , "narrator": "", "text": "ちょっと楽しいことを…"},
        { "location": "1539/TALK"  , "narrator": "ガブリエラ", "text": "はあっ！？\nな、なによ、\nたのしいことって……"},
        { "location": "1541/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんってば\nガブちゃんにその言い方は\n刺激が強すぎですよっ！"},
        { "location": "1543/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "1545/TALK"  , "narrator": "ガブリエラ", "text": "二人していっぺん\nラグナロクにでも\n行ってくればいいのよ……"},
        { "location": "1548/TALK"  , "narrator": "ガブリエラ", "text": "ほら！\n早く扉を回して！"},
        { "location": "1550/TALK"  , "narrator": "ぴょんこ", "text": "は、はいっ！"},
        { "location": "1553/TALK"  , "narrator": "ぴょんこ", "text": "オープンプロセス、\n2x99F番地から\n2xACD番地へ。"},
        { "location": "1578/TALK"  , "narrator": "ぴょんこ", "text": "シーク完了。"},
        { "location": "1580/TALK"  , "narrator": "ぴょんこ", "text": "今回の悩みは…と……"},
        { "location": "1582/TALK"  , "narrator": "ぴょんこ", "text": "……。"},
        { "location": "1583/TALK"  , "narrator": "ぴょんこ", "text": "音羽を壊した\nつばめさんへの\n憎しみと――"},
        { "location": "1584/TALK"  , "narrator": "ぴょんこ", "text": "普段のかわいい\nつばめさんへの愛情が\n二律背反を起こしてます。"},
        { "location": "1585/SEL"   , "narrator": "", "text": "今回のは強い葛藤なの？"},
        { "location": "1586/ACT"   , "narrator": "", "text": "今回のは強い葛藤なの？"},
        { "location": "1589/TALK"  , "narrator": "ぴょんこ", "text": "かなり強いと思います！"},
        { "location": "1590/TALK"  , "narrator": "ぴょんこ", "text": "早くクランを倒して\n心を落ち着かせないと！"},
        { "location": "1591/TALK"  , "narrator": "ガブリエラ", "text": "なかなか強そうね。\n腕が鳴るわ。"},
        { "location": "1593/TALK"  , "narrator": "ぴょんこ", "text": "すみません、\nご迷惑お掛けしちゃって。"},
        { "location": "1594/TALK"  , "narrator": "ガブリエラ", "text": "もう…何言ってるのよ。\nあたしが自分で\nここに来てるんだから。"},
        { "location": "1596/TALK"  , "narrator": "ガブリエラ", "text": "……その。"},
        { "location": "1597/TALK"  , "narrator": "ガブリエラ", "text": "友達でしょ？"},
        { "location": "1598/TALK"  , "narrator": "ぴょんこ", "text": "…！！"},
        { "location": "1599/TALK"  , "narrator": "ぴょんこ", "text": "はいっ！"},
        { "location": "1602/TALK"  , "narrator": "ガブリエラ", "text": "それじゃ、いくわよ！"},
        { "location": "1604/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんも、\nよろしくお願いしますっ！"},
        { "location": "1605/TALK"  , "narrator": "ぴょんこ", "text": "ガブちゃんとぴょんこと\n$handle$さんに、\n素敵なココロの旅をっ！"},
        { "location": "1012/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:Interrupt】</color>\nSystem Interrupted.\n\n必須選択肢が選ばれていません。\n\n<color=green>『STORY27：シン・カグラ』</color>\nにて、選択を行ってから\n再度アクセスしてください。\n"},
        { "location": "1016/DIALOG", "narrator": "Dialog_EventData", "text": "<color=green>6月8日　6:12 PM</color>\nとある平日の放課後、下校途中での出来事。"},
        { "location": "1215/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "1217/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "1219/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "1221/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "1223/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "1425/DIALOG", "narrator": "Dialog_Notice", "text": "<color=green>【TRI-OS Plug-in:Libralian】</color>\n\n<color=red>\nOKボタンを押すと、この選択は確定します。プレイの有無にかかわらず、以後やり直しはできなくなります。\n</color>\n以降ジャンケン終了までの間、通信環境が悪い場所などでの継続はお薦めしません。\n\nここでOKを押す前にアプリを終了（タスクキル）すれば、ギリギリキャンセル可能です。"},
        { "location": "1444/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:Libralian】</color>\n\n<color=green>【キスチケ】</color>を\n１枚ゲットしました！"},
        { "location": "1453/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:Libralian】</color>\n\n<color=green>【キスチケ】</color>を\n１枚失いました…。"}
    ]
}
