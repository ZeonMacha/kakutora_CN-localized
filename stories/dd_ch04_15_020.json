{
    "dir": "chap15/daydra/dd_ch04_15_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "15456",
        "cid": "miyabi",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "忘れ物"
    },
    "entry":
    [
        { "location": "247/SCENARIO", "narrator": "", "text": "忘れ物"},
        { "location": "273/TALK"    , "narrator": "雛", "text": "東雲教官、\nちょっといいですか？"},
        { "location": "275/TALK"    , "narrator": "真幌", "text": "どうした？"},
        { "location": "276/TALK"    , "narrator": "雛", "text": "今、キリトと劇場内の\n清掃をしてたら、\n忘れ物を見つけたんです。"},
        { "location": "279/TALK"    , "narrator": "みやび", "text": "珍しいこともあるんやね。"},
        { "location": "280/TALK"    , "narrator": "真幌", "text": "客が少ないからな。\nそれで、その忘れ物とは\n何なんだ？"},
        { "location": "283/TALK"    , "narrator": "キリト", "text": "これっすよ。"},
        { "location": "284/TALK"    , "narrator": "真幌", "text": "…本屋の紙袋か？"},
        { "location": "285/TALK"    , "narrator": "キリト", "text": "中に本もちゃんと\n入ってますよ。"},
        { "location": "286/TALK"    , "narrator": "キリト", "text": "まあ、あんまり褒められた\n内容のもんじゃないっす\nけどね。"},
        { "location": "287/TALK"    , "narrator": "真幌", "text": "まったく…そんな本を\n忘れていくなんて、\nどんな奴なんだ？"},
        { "location": "288/TALK"    , "narrator": "みやび", "text": "今日は二人しかお客は\n来てないがですよ。"},
        { "location": "289/TALK"    , "narrator": "みやび", "text": "確か、一人は四十代\nくらいのサラリーマン\nっぽい人で――"},
        { "location": "290/TALK"    , "narrator": "みやび", "text": "もう一人はうちの学生さん\nだったはずですよ。"},
        { "location": "291/TALK"    , "narrator": "雛", "text": "まあ、どっちが忘れたに\nしても、取りには来ないと\n思いますけどねー。"},
        { "location": "292/TALK"    , "narrator": "真幌", "text": "小金井、一週間以内に\nその本を取りに来る奴が\nいなければ――"},
        { "location": "293/TALK"    , "narrator": "真幌", "text": "持って帰っていいぞ。"},
        { "location": "294/TALK"    , "narrator": "キリト", "text": "マジっすか！？\nよっしゃぁ！！"},
        { "location": "295/TALK"    , "narrator": "真幌", "text": "じゃあ、後は任せたぞ。"},
        { "location": "297/TALK"    , "narrator": "キリト", "text": "へへっ、一週間後が\n待ち遠しいぜ。"},
        { "location": "300/TALK"    , "narrator": "みやび", "text": "男の子やねぇ…。"},
        { "location": "301/TALK"    , "narrator": "みやび", "text": "けんど、どんな本なのか\nちっくと気になるな…。"},
        { "location": "302/TALK"    , "narrator": "みやび", "text": "キリト君、その本うちに\n貸してもらえんか？"},
        { "location": "304/TALK"    , "narrator": "キリト", "text": "いいっすけど…\nあげないっすよ？"},
        { "location": "307/TALK"    , "narrator": "雛", "text": "まだキリトの物じゃ\nないってば。"},
        { "location": "309/TALK"    , "narrator": "みやび", "text": "いや、欲しいんやなくて、\nどんな本かが気になった\nだけやき。"},
        { "location": "312/TALK"    , "narrator": "雛", "text": "そういえば、あたしも\nまだ見てないんです\nよねー。"},
        { "location": "313/TALK"    , "narrator": "みやび", "text": "ふむ、どれどれ…。"},
        { "location": "314/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "315/TALK"    , "narrator": "雛", "text": "う、うわぁ…\nなんか、露骨というか、\n開放的というか…。"},
        { "location": "316/TALK"    , "narrator": "みやび", "text": "うん…そうかぁ…\nキリト君はこういう系が\n好きなんやね？"},
        { "location": "317/TALK"    , "narrator": "雛", "text": "なんか、意外かも…。"},
        { "location": "320/TALK"    , "narrator": "キリト", "text": "う、うっせぇな！"},
        { "location": "321/TALK"    , "narrator": "キリト", "text": "健全な男なら、\n誰だってそういうのが\n好きなんだよ。"},
        { "location": "322/TALK"    , "narrator": "みやび", "text": "…まあ、間違っては\nいないと思うけんど――"},
        { "location": "323/TALK"    , "narrator": "みやび", "text": "しっかし…こんな本が\n売ってるんやね？"},
        { "location": "324/TALK"    , "narrator": "雛", "text": "ビックリですよね…。\nこれをレジに持って行ける\n神経が信じられません。"},
        { "location": "334/TALK"    , "narrator": "男子高校生", "text": "あ、あの！！\nすみません！！"},
        { "location": "337/TALK"    , "narrator": "キリト", "text": "ん？　誰だ？"},
        { "location": "338/TALK"    , "narrator": "キリト", "text": "じゃなくて、\nいらっしゃいませ！"},
        { "location": "340/TALK"    , "narrator": "雛", "text": "申し訳ありません。\n本日の上映はもう\n終了で…。"},
        { "location": "342/TALK"    , "narrator": "男子高校生", "text": "あの、そうじゃなくて、\nその――"},
        { "location": "344/TALK"    , "narrator": "男子高校生", "text": "本の忘れ物！\nありませんでしたか？"},
        { "location": "345/TALK"    , "narrator": "キリト", "text": "…こいつか！！"},
        { "location": "346/TALK"    , "narrator": "雛", "text": "この人だったの！？"},
        { "location": "348/TALK"    , "narrator": "みやび", "text": "ああ、彼の本やったか。"},
        { "location": "349/SEL"     , "narrator": "", "text": "本を袋にしまって！！"},
        { "location": "350/SEL"     , "narrator": "", "text": "中身の確認をしてもらおう"},
        { "location": "353/TALK"    , "narrator": "男子高校生", "text": "紙袋に入った状態で\n忘れていったと思うん\nですけど…。"},
        { "location": "354/TALK"    , "narrator": "キリト", "text": "…あ、ああ、はい。\nちゃんとありましたよ。"},
        { "location": "355/TALK"    , "narrator": "男子高校生", "text": "ほ、本当ですか！？"},
        { "location": "358/TALK"    , "narrator": "キリト", "text": "今さっき見つけたばかり\nですよ。\nね、みやび先輩？"},
        { "location": "360/TALK"    , "narrator": "みやび", "text": "うん…これやね？"},
        { "location": "362/TALK"    , "narrator": "男子高校生", "text": "っ！？"},
        { "location": "364/TALK"    , "narrator": "雛", "text": "ちょっ！？"},
        { "location": "366/TALK"    , "narrator": "キリト", "text": "み、みやび先輩！？"},
        { "location": "368/TALK"    , "narrator": "みやび", "text": "ん？　どうしたが？"},
        { "location": "369/TALK"    , "narrator": "キリト", "text": "本！　袋から出っぱなし\nだから！！"},
        { "location": "372/TALK"    , "narrator": "みやび", "text": "…ああ、そうやった。"},
        { "location": "373/TALK"    , "narrator": "みやび", "text": "まあ、忘れ物の中身を\n確認せんといかんのは\n規則やき――"},
        { "location": "375/TALK"    , "narrator": "みやび", "text": "それで開けただけぞね。\nこの本でえいがか？"},
        { "location": "377/TALK"    , "narrator": "男子高校生", "text": "あ、あぅ…あ、その…。"},
        { "location": "378/TALK"    , "narrator": "男子高校生", "text": "し、失礼しましたー！！"},
        { "location": "384/TALK"    , "narrator": "雛", "text": "お、お客様！？"},
        { "location": "385/TALK"    , "narrator": "雛", "text": "…に、逃げちゃったよ？"},
        { "location": "387/TALK"    , "narrator": "キリト", "text": "…かわいそうに。\n同じ男として同情するぜ。"},
        { "location": "391/TALK"    , "narrator": "みやび", "text": "…まあ、一週間もあれば、\nもう一度くらい取りに\n来るんやろうね。"},
        { "location": "393/TALK"    , "narrator": "キリト", "text": "絶対に来ませんって！"},
        { "location": "395/ACT"     , "narrator": "", "text": "本を袋にしまって！！"},
        { "location": "414/TALK"    , "narrator": "みやび", "text": "相棒、ナイスサポートや！"},
        { "location": "426/TALK"    , "narrator": "みやび", "text": "気付かれんように、\nそっと袋に戻して…。"},
        { "location": "427/TALK"    , "narrator": "みやび", "text": "…よし。"},
        { "location": "429/TALK"    , "narrator": "みやび", "text": "忘れ物いうんは、\nこれのことですか？"},
        { "location": "430/TALK"    , "narrator": "男子高校生", "text": "そ、そうです！\nこれ、これです！！"},
        { "location": "431/TALK"    , "narrator": "キリト", "text": "座席の上に置いたままに\nなってましたよ。"},
        { "location": "432/TALK"    , "narrator": "男子高校生", "text": "すみません…上映中、\n隣の席に置いていたら\n忘れてしまって…。"},
        { "location": "433/TALK"    , "narrator": "男子高校生", "text": "と、とにかく、\n無事に見つかって\n安心しました！"},
        { "location": "434/TALK"    , "narrator": "雛", "text": "これからは気を付けて\nくださいね。"},
        { "location": "435/TALK"    , "narrator": "男子高校生", "text": "はい！！\nありがとう\nございました！！"},
        { "location": "440/TALK"    , "narrator": "雛", "text": "…行っちゃった。\n凄く嬉しそうだったね。"},
        { "location": "442/TALK"    , "narrator": "キリト", "text": "そりゃそうだろうよ。\nこっちはその逆だって\nのに…。"},
        { "location": "445/TALK"    , "narrator": "みやび", "text": "キリト君、これで本を\nもらえなくなっちゅう\nたきね。"},
        { "location": "447/TALK"    , "narrator": "キリト", "text": "こんなことなら、\n見つけた時に一通り\n目を通しとくんだったぜ。"},
        { "location": "449/TALK"    , "narrator": "雛", "text": "そんなに欲しかったの？"},
        { "location": "451/TALK"    , "narrator": "みやび", "text": "男の子やし、そう思うんは\n当然やと思うんよ。"},
        { "location": "452/TALK"    , "narrator": "みやび", "text": "本に載ってた女の子より\n可愛くはないけんど――"},
        { "location": "455/TALK"    , "narrator": "みやび", "text": "それでもえいなら、\n代わりにうちの胸でも\n見るが？"},
        { "location": "456/TALK"    , "narrator": "キリト", "text": "…え？\nい、いいんすか！？"},
        { "location": "458/TALK"    , "narrator": "雛", "text": "…………。"},
        { "location": "459/TALK"    , "narrator": "キリト", "text": "って、冗談！！\n冗談っすから！！"},
        { "location": "461/TALK"    , "narrator": "キリト", "text": "あ、劇場の清掃が\nまだ途中だから、\nまた後で！！"},
        { "location": "466/TALK"    , "narrator": "雛", "text": "はぁ…男ってのは、\nまったく…。"},
        { "location": "469/TALK"    , "narrator": "みやび", "text": "可愛くてからかい甲斐が\nあって、中々面白いぞね。"},
        { "location": "471/TALK"    , "narrator": "雛", "text": "…あんまり、キリトを\nからかわないであげて\nくださいね？"},
        { "location": "488/ACT"     , "narrator": "", "text": "中身の確認をしてもらおう"},
        { "location": "506/TALK"    , "narrator": "みやび", "text": "そういえば、そういう規則になってたんやったわ"},
        { "location": "519/TALK"    , "narrator": "みやび", "text": "じゃあ、一度本を袋に\n戻して…。"},
        { "location": "521/TALK"    , "narrator": "キリト", "text": "みやび先輩。\nこの人がさっきの本の\n持ち主さんみたいっす。"},
        { "location": "524/TALK"    , "narrator": "男子高校生", "text": "あっ、それです！\nその紙袋ですよ！"},
        { "location": "526/TALK"    , "narrator": "みやび", "text": "あ～、申し訳ないけんど、\nこのまますぐには\nお返しできないがですよ。"},
        { "location": "527/TALK"    , "narrator": "男子高校生", "text": "な、何でですか！？\nそれ、俺のですって。"},
        { "location": "528/TALK"    , "narrator": "みやび", "text": "なら、この袋の中の\n本のタイトルを言うて\nもらえますか？"},
        { "location": "530/TALK"    , "narrator": "男子高校生", "text": "！？"},
        { "location": "532/TALK"    , "narrator": "雛", "text": "ちょ、みやび先輩！？"},
        { "location": "534/TALK"    , "narrator": "みやび", "text": "これが本当にこの人の\n物かを確認するだけや。"},
        { "location": "536/TALK"    , "narrator": "みやび", "text": "言うておくけんど、\nちゃんとこの劇場の\n規則にあるんよ。"},
        { "location": "537/TALK"    , "narrator": "みやび", "text": "間違いがあったら\n許されんきね。"},
        { "location": "539/TALK"    , "narrator": "雛", "text": "そ、それはそうです\nけど…。"},
        { "location": "541/TALK"    , "narrator": "キリト", "text": "みやび先輩。\nあの本のタイトルを\n言わせるのは酷っすよ？"},
        { "location": "542/TALK"    , "narrator": "男子高校生", "text": "み、見たんですか！？"},
        { "location": "544/TALK"    , "narrator": "キリト", "text": "あ、それは、えっと…。"},
        { "location": "545/TALK"    , "narrator": "みやび", "text": "忘れ物の中身を確認する\nんは、当然のことです。"},
        { "location": "546/TALK"    , "narrator": "みやび", "text": "中身がわからんことには、\nこちらも対処できません\nきね。"},
        { "location": "549/TALK"    , "narrator": "男子高校生", "text": "うっ…。"},
        { "location": "550/TALK"    , "narrator": "みやび", "text": "最低限の確認ですよ。"},
        { "location": "551/TALK"    , "narrator": "みやび", "text": "それで…本のタイトルを\n言うてもらえますか？"},
        { "location": "554/TALK"    , "narrator": "男子高校生", "text": "え、えと、そのぉ…\nば、バク…。"},
        { "location": "555/TALK"    , "narrator": "みやび", "text": "ばく？"},
        { "location": "556/TALK"    , "narrator": "男子高校生", "text": "ば、ばく…ばくに…\nう、うぅ…。"},
        { "location": "558/TALK"    , "narrator": "男子高校生", "text": "すみません！\n俺の勘違いでしたぁ！！"},
        { "location": "564/TALK"    , "narrator": "キリト", "text": "お、お客さん！？"},
        { "location": "566/TALK"    , "narrator": "雛", "text": "あ～あ…まあ、そりゃ\n逃げて当然だよねー。"},
        { "location": "569/TALK"    , "narrator": "雛", "text": "あのタイトルを女の人に\n言うのは、かなり酷って\nいうか――"},
        { "location": "570/TALK"    , "narrator": "雛", "text": "拷問に近いものが\nあるしー。"},
        { "location": "571/TALK"    , "narrator": "キリト", "text": "…哀れだ。"},
        { "location": "574/TALK"    , "narrator": "みやび", "text": "…規則通りとはいえ、\nかわいそうなことした\nかもしれんなぁ。"},
        { "location": "577/TALK"    , "narrator": "真幌", "text": "いや、何も問題はない。"},
        { "location": "579/TALK"    , "narrator": "みやび", "text": "まほさん、\n見てたがですか…。"},
        { "location": "581/TALK"    , "narrator": "真幌", "text": "みやびの対応は、\n何一つ間違えては\nいなかった。"},
        { "location": "582/TALK"    , "narrator": "真幌", "text": "気に病む必要はないぞ。"},
        { "location": "583/TALK"    , "narrator": "みやび", "text": "…まほさんが言うなら、\nもう気にしませんちや。"},
        { "location": "585/TALK"    , "narrator": "真幌", "text": "それでいい。\nそれはそうと、\n今の客だが――"},
        { "location": "586/TALK"    , "narrator": "真幌", "text": "うちの学園の\n制服だったな？"},
        { "location": "587/TALK"    , "narrator": "キリト", "text": "そ、そういえば\n確かに…。"},
        { "location": "588/TALK"    , "narrator": "真幌", "text": "確か、高等部の二年に\n似たような奴がいた\n気がするんでな。"},
        { "location": "590/TALK"    , "narrator": "真幌", "text": "忘れ物の本は、私から\n彼に返しておくとしよう。"},
        { "location": "592/TALK"    , "narrator": "みやび", "text": "了解です。\nそれじゃ、よろしく\n頼みますがよ。"},
        { "location": "594/TALK"    , "narrator": "キリト", "text": "…あの本、教師から\n手渡されることに\nなるのか。"},
        { "location": "596/TALK"    , "narrator": "キリト", "text": "…想像するだけで、\n胃がキリキリしてくる\n気がするぜ…。"},
        { "location": "258/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>7月12日　17:12 PM</color>\nとある初夏の放課後、神楽坂トライナリー劇場でのバイト中のこと。"},
        { "location": "482/DIALOG"  , "narrator": "Dialog_GEThimegoto_ch04", "text": "【今は原始ではないのでね】"}
    ]
}
