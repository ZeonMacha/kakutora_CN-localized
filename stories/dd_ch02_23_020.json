{
    "dir": "chap23/daydra/dd_ch02_23_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "23256",
        "cid": "ayami",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "合宿の記念"
    },
    "entry":
    [
        { "location": "240/SCENARIO", "narrator": "", "text": "合宿の記念"},
        { "location": "255/TALK"    , "narrator": "アーヤ", "text": "…もう一枚。"},
        { "location": "260/TALK"    , "narrator": "アーヤ", "text": "…ん、ＯＫ。\n綺麗に撮れたわ。"},
        { "location": "263/TALK"    , "narrator": "みやび", "text": "よかったね。\nじゃ、そろそろ帰るか。"},
        { "location": "266/TALK"    , "narrator": "アーヤ", "text": "何言ってるのよ。\nまだ一枚目でしょ？"},
        { "location": "269/TALK"    , "narrator": "みやび", "text": "一枚とれば十分やろ？"},
        { "location": "270/TALK"    , "narrator": "みやび", "text": "っちゅうか、こんなとこの\n写真撮る必要あるか？"},
        { "location": "271/TALK"    , "narrator": "アーヤ", "text": "東京に戻る前に、\n記念に撮っておきたいのよ。"},
        { "location": "272/TALK"    , "narrator": "みやび", "text": "今の時代、地図アプリで\nいくらでも写真なんぞ\n見れるやろ？"},
        { "location": "273/TALK"    , "narrator": "アーヤ", "text": "自分で撮る写真は\nそういうのとは違うの。"},
        { "location": "275/TALK"    , "narrator": "アーヤ", "text": "それに、案内してくれる\n約束なんだから、\n文句言わないの。"},
        { "location": "277/TALK"    , "narrator": "みやび", "text": "とほほ…。\nじゃあ、次は見飽きた\n砂浜に行くぞね。"},
        { "location": "278/TALK"    , "narrator": "アーヤ", "text": "見飽きた、は余計でしょ？"},
        { "location": "292/TALK"    , "narrator": "みやび", "text": "…海なんぞ撮っても、\n何も楽しくないやろ？"},
        { "location": "294/TALK"    , "narrator": "アーヤ", "text": "そんなことないわ。\n特に今日は波も穏やかで、\n綺麗に撮れるし。"},
        { "location": "295/TALK"    , "narrator": "みやび", "text": "南国の透き通った海の方が\n綺麗やと思うけんどなぁ。"},
        { "location": "297/TALK"    , "narrator": "アーヤ", "text": "思い出なんだからいいのよ。\nほら、みやびもついでに\nポーズ付けて。"},
        { "location": "298/TALK"    , "narrator": "みやび", "text": "…いやん。"},
        { "location": "304/TALK"    , "narrator": "みやび", "text": "撮ったが！？"},
        { "location": "305/TALK"    , "narrator": "アーヤ", "text": "撮るって言ったでしょ。\n次は港に行きたいわ。"},
        { "location": "306/TALK"    , "narrator": "みやび", "text": "…今日のアーヤは、\n一味違う気がするちや。"},
        { "location": "318/TALK"    , "narrator": "アーヤ", "text": "うーん…、\nちょっと暗いかしら？"},
        { "location": "322/TALK"    , "narrator": "アーヤ", "text": "みやびも一緒に入って。\n最高の笑顔でね。"},
        { "location": "324/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "329/TALK"    , "narrator": "アーヤ", "text": "ん、完璧！\nありがとう、いい写真\n沢山撮れたわ。"},
        { "location": "330/TALK"    , "narrator": "みやび", "text": "五十八枚や。\n沢山どころの騒ぎやない。"},
        { "location": "332/TALK"    , "narrator": "みやび", "text": "ちゅうか、いつから\n写真なんぞ趣味にしたが？"},
        { "location": "334/TALK"    , "narrator": "アーヤ", "text": "前から風景写真を\n撮るのは好きだったのよ。"},
        { "location": "335/TALK"    , "narrator": "アーヤ", "text": "ま、スマホのカメラで\nばっかりだったけど。"},
        { "location": "337/TALK"    , "narrator": "みやび", "text": "それが、そんな立派な\nカメラ持つまでに\n進化したゆうわけか。"},
        { "location": "338/TALK"    , "narrator": "アーヤ", "text": "みやびもやってみたら？\nスマホのカメラから\n初めてみるといいわ。"},
        { "location": "339/TALK"    , "narrator": "みやび", "text": "そんなもんに\n大切な容量使いたく\nないちや。"},
        { "location": "340/TALK"    , "narrator": "アーヤ", "text": "そう言うと思った。"},
        { "location": "341/TALK"    , "narrator": "アーヤ", "text": "じゃ、次行きましょ。"},
        { "location": "343/TALK"    , "narrator": "みやび", "text": "そう言うと思うたがよ。"},
        { "location": "354/TALK"    , "narrator": "アーヤ", "text": "いい写真沢山撮れたわ。\nありがとう、みやび。"},
        { "location": "355/TALK"    , "narrator": "みやび", "text": "…うん。"},
        { "location": "356/TALK"    , "narrator": "アーヤ", "text": "元気ないわね。\n大丈夫？"},
        { "location": "357/TALK"    , "narrator": "みやび", "text": "あれだけ歩かされれば、\nうちじゃなくても\nヘロヘロになるがよ。"},
        { "location": "360/TALK"    , "narrator": "アーヤ", "text": "あ、あはは…。"},
        { "location": "361/TALK"    , "narrator": "みやび", "text": "…まあ、えい写真撮れて\n満足したゆうなら、\nそれでえいけんど。"},
        { "location": "363/TALK"    , "narrator": "アーヤ", "text": "ええ、大満足よ。\n容量いっぱいに撮ったから、\n整理するのが楽しみ。"},
        { "location": "364/TALK"    , "narrator": "アーヤ", "text": "そうだ、東京帰ったら\nデータ渡す？"},
        { "location": "365/TALK"    , "narrator": "みやび", "text": "あのなぁ…忘れちょるかも\nしれんけんど、\nここはうちの地元やぞ？"},
        { "location": "366/TALK"    , "narrator": "みやび", "text": "地元の写真なんぞもらっても\n仕方ないやろ。"},
        { "location": "367/TALK"    , "narrator": "アーヤ", "text": "逆じゃない？\n地元だからこそ\n撮らなきゃダメでしょ。"},
        { "location": "368/TALK"    , "narrator": "アーヤ", "text": "時が経てば、景色なんて\nどんどん変わっていくのよ？"},
        { "location": "370/TALK"    , "narrator": "アーヤ", "text": "だから、今見ている光景を\n写真にして、思い出として\n残すんじゃない。"},
        { "location": "371/TALK"    , "narrator": "みやび", "text": "あ～、無駄や無駄。\nちくっと考えてみぃ。"},
        { "location": "372/TALK"    , "narrator": "みやび", "text": "うちが地元の写真なんぞ\n見返しながら、思い出を\n楽しむタイプに見えるか？"},
        { "location": "373/TALK"    , "narrator": "アーヤ", "text": "それを言われると…、\nうーん…。"},
        { "location": "374/SEL"     , "narrator": "", "text": "見直したくなる写真を撮ろう"},
        { "location": "376/TALK"    , "narrator": "みやび", "text": "写真を見返しながら、\nセンチメンタル気分に浸る\nうちを想像してみぃ。"},
        { "location": "378/TALK"    , "narrator": "みやび", "text": "ちくっとホラーな\n光景やと思うぞ？"},
        { "location": "379/TALK"    , "narrator": "アーヤ", "text": "ホラーはさすがに\n言い過ぎでしょ。"},
        { "location": "380/TALK"    , "narrator": "みやび", "text": "けんど、世にも不可思議\nアメイジングな姿なのは\n間違いない。"},
        { "location": "384/TALK"    , "narrator": "みやび", "text": "ちゅうわけやき、\n周囲のためにも\n写真は必要ないがよ。"},
        { "location": "385/TALK"    , "narrator": "アーヤ", "text": "はいはい…。"},
        { "location": "386/TALK"    , "narrator": "アーヤ", "text": "でも、気が変わった時は\nいつでも言ってね。"},
        { "location": "388/ACT"     , "narrator": "", "text": "見直したくなる写真を撮ろう"},
        { "location": "402/TALK"    , "narrator": "アーヤ", "text": "簡単に言わないで(-ω-;)"},
        { "location": "403/TALK"    , "narrator": "アーヤ", "text": "そんなの"},
        { "location": "404/TALK"    , "narrator": "アーヤ", "text": "簡単に撮れないから(￣Д￣ )"},
        { "location": "406/SEL"     , "narrator": "", "text": "記念写真なら大丈夫"},
        { "location": "407/ACT"     , "narrator": "", "text": "記念写真なら大丈夫"},
        { "location": "409/TALK"    , "narrator": "アーヤ", "text": "記念写真ね"},
        { "location": "410/TALK"    , "narrator": "アーヤ", "text": "あ(☆｡☆)"},
        { "location": "411/TALK"    , "narrator": "アーヤ", "text": "いいこと思いついた(*^o^*)"},
        { "location": "416/TALK"    , "narrator": "アーヤ", "text": "みやび、予定変更よ。\nこの後もう一度港に\n行きましょ。"},
        { "location": "418/TALK"    , "narrator": "みやび", "text": "はぁ！？　まだ撮るんか？"},
        { "location": "420/TALK"    , "narrator": "アーヤ", "text": "うん。\nでも、今度はちょっと\n特別なのをね。"},
        { "location": "421/TALK"    , "narrator": "みやび", "text": "…？"},
        { "location": "438/TALK"    , "narrator": "アーヤ", "text": "卯月、もうちょっとだけ\nつばめに近寄った方が\nいいかも。"},
        { "location": "440/TALK"    , "narrator": "神楽", "text": "いいんですか？\nそれじゃあ遠慮なく\n抱きしめちゃいますね。"},
        { "location": "443/TALK"    , "narrator": "つばめ", "text": "そ、そこまでしなくても\n大丈夫じゃないかな？"},
        { "location": "444/TALK"    , "narrator": "神楽", "text": "でも、そんなこと言って\n見切れちゃったら、\n悲しいです…。"},
        { "location": "449/TALK"    , "narrator": "アーヤ", "text": "近寄るのはちょっとで\nいいんだけど…。"},
        { "location": "450/TALK"    , "narrator": "ガブリエラ", "text": "ポーズはどうする？\nみんな同じポーズ？\nそれとも各自自由？"},
        { "location": "451/TALK"    , "narrator": "アーヤ", "text": "自由でいいと思うわ。\n今からポーズ決めるのも\n面倒だし。"},
        { "location": "453/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "454/TALK"    , "narrator": "アーヤ", "text": "ほら、みやび。\nもっと楽しそうな顔\nしなさいよ。"},
        { "location": "455/TALK"    , "narrator": "みやび", "text": "そう言われてもなぁ…。\nこれ、合宿記念の写真やろ？"},
        { "location": "456/TALK"    , "narrator": "みやび", "text": "合宿ゆうてもうちには\n帰省と変わらんのやし、\n記念感ゼロやし…。"},
        { "location": "457/TALK"    , "narrator": "アーヤ", "text": "そんなことないわ。\nいい思い出になるはずよ。"},
        { "location": "458/TALK"    , "narrator": "みやび", "text": "そうやろか？"},
        { "location": "459/TALK"    , "narrator": "アーヤ", "text": "そうよ。"},
        { "location": "460/TALK"    , "narrator": "アーヤ", "text": "全員揃って三戸浜に来れる\nようなことが、またある\n保証もないんだし。"},
        { "location": "461/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "463/TALK"    , "narrator": "ガブリエラ", "text": "まあ、そうよね…。\n基本的にフェノメノンは\n都内にしか出ないんだし。"},
        { "location": "465/TALK"    , "narrator": "ガブリエラ", "text": "そんな頻繁に全員で\n東京離れるわけには\nいかないものね。"},
        { "location": "466/TALK"    , "narrator": "アーヤ", "text": "そういうこと。"},
        { "location": "467/TALK"    , "narrator": "みやび", "text": "ふぅむ…。"},
        { "location": "468/TALK"    , "narrator": "アーヤ", "text": "まあ、撮ったからって\nすぐ見直す写真になるとは\n限らないわ。"},
        { "location": "469/TALK"    , "narrator": "アーヤ", "text": "何年、何十年も後に、\n思い出として楽しむのが\n記念写真なんだし。"},
        { "location": "470/TALK"    , "narrator": "みやび", "text": "そういうもんなが？"},
        { "location": "471/TALK"    , "narrator": "アーヤ", "text": "そういうもんよ、\n多分ね。"},
        { "location": "473/TALK"    , "narrator": "ガブリエラ", "text": "ねえ、いい加減そろそろ\n撮っちゃわない？\n待ってるの退屈なんだけど？"},
        { "location": "474/TALK"    , "narrator": "アーヤ", "text": "はいはい。\nそういうわけだから、\nみやびも笑顔でね。"},
        { "location": "475/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "477/TALK"    , "narrator": "神楽", "text": "つばめさん。\nほら、ポーズ撮って\nください。"},
        { "location": "479/TALK"    , "narrator": "つばめ", "text": "う、うん。"},
        { "location": "481/TALK"    , "narrator": "ガブリエラ", "text": "オッケー。\nいつでもいいわよ。"},
        { "location": "482/TALK"    , "narrator": "アーヤ", "text": "それじゃ撮るわよー。\n３・２・１…。"},
        { "location": "487/TALK"    , "narrator": "みやび", "text": "ちーず、ぞね。"},
        { "location": "492/TALK"    , "narrator": "アーヤ", "text": "は！？"},
        { "location": "493/TALK"    , "narrator": "みやび", "text": "どうや？\n上手に撮れた？"},
        { "location": "496/TALK"    , "narrator": "つばめ", "text": "あの、みやびさんって\n写真にあまり興味が\nなかったんじゃ…？"},
        { "location": "498/TALK"    , "narrator": "みやび", "text": "うむ、ぶっちゃけないな。"},
        { "location": "500/TALK"    , "narrator": "ガブリエラ", "text": "いや、説得力ないから。\n一番ノリノリでポーズ\n決めてたじゃない。"},
        { "location": "501/TALK"    , "narrator": "神楽", "text": "もしかしてみやびさん、\n本当は撮りたかったん\nですか？"},
        { "location": "503/TALK"    , "narrator": "みやび", "text": "いつか思い出になる日が\n来るかもしれんのやろ？"},
        { "location": "504/TALK"    , "narrator": "みやび", "text": "なら、見返した時に\n笑える写真にした方が\nえいと思うたがよ。"},
        { "location": "505/TALK"    , "narrator": "みやび", "text": "何でこんなノリノリで\n写真撮っちょるんかって、\n笑えると思うし。"},
        { "location": "507/TALK"    , "narrator": "ガブリエラ", "text": "何もそんなネタ\n仕込まなくてもいいのに…。"},
        { "location": "509/TALK"    , "narrator": "つばめ", "text": "う～ん…わたしも何か、\n見返した時に楽しめること\nすればよかったかな？"},
        { "location": "511/TALK"    , "narrator": "神楽", "text": "下手をすると恥ずかしい\n思い出になっちゃうから、\nオススメはしませんよ？"},
        { "location": "513/TALK"    , "narrator": "アーヤ", "text": "まったく…。\nまあ、素敵な写真に\nなったからいいわよ。"},
        { "location": "515/TALK"    , "narrator": "アーヤ", "text": "…それに、みやびも少しは\n見返そうって気持ちになって\nくれたみたいだし。"},
        { "location": "516/TALK"    , "narrator": "アーヤ", "text": "…私にとっては、\nこれも一つの思い出に\nなったかも。"},
        { "location": "251/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>8月19日　 5:34 PM</color>\n合宿中、みやびの実家近くでのこと"},
        { "location": "527/DIALOG"  , "narrator": "Dialog_GEThimegoto_ch02", "text": "【セピア色には早すぎて】"}
    ]
}
