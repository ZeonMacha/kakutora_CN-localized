{
    "dir": "chap24/daydra/anime_05_24.js",
    "type": "MainStory",
    "info": {
        "story_id": "24501",
        "cid": "kagura",
        "title": "001 アニメーション",
        "sub_title": "桜田門からの手紙"
    },
    "entry":
    [
        { "location": "1118/SCENARIO", "narrator": "", "text": "アニメ第24話"},
        { "location": "1130/TALK"    , "narrator": "赤髪千羽鶴", "text": "こんにちは、\n$handle$さん。"},
        { "location": "1131/TALK"    , "narrator": "赤髪千羽鶴", "text": "もう一度わたしと話を\nしていきますか？"},
        { "location": "1132/SEL"     , "narrator": "", "text": "はい"},
        { "location": "1133/SEL"     , "narrator": "", "text": "いいえ"},
        { "location": "1134/ACT"     , "narrator": "", "text": "はい"},
        { "location": "1135/TALK"    , "narrator": "赤髪千羽鶴", "text": "わかりました。\nそれでは……。"},
        { "location": "1137/ACT"     , "narrator": "", "text": "いいえ"},
        { "location": "1138/TALK"    , "narrator": "赤髪千羽鶴", "text": "わかりました。\nそれではこれで。"},
        { "location": "1144/TALK"    , "narrator": "赤髪千羽鶴", "text": "改めまして。\nこんにちは、\n$handle$さん。"},
        { "location": "1145/SEL"     , "narrator": "", "text": "こんにちは"},
        { "location": "1146/SEL"     , "narrator": "", "text": "この間、なんだか凄いことをしてませんでしたか？"},
        { "location": "1147/ACT"     , "narrator": "", "text": "こんにちは"},
        { "location": "1148/TALK"    , "narrator": "赤髪千羽鶴", "text": "さて、早速\n本題に入りますが！"},
        { "location": "1150/ACT"     , "narrator": "", "text": "この間、なんだか凄いことをしてませんでしたか？"},
        { "location": "1151/TALK"    , "narrator": "赤髪千羽鶴", "text": "レイヤー移動の\n件ですよね？"},
        { "location": "1152/TALK"    , "narrator": "赤髪千羽鶴", "text": "その節は、\n大変お世話になりました！"},
        { "location": "1153/SEL"     , "narrator": "", "text": "なんかお世話しましたっけ？"},
        { "location": "1154/ACT"     , "narrator": "", "text": "なんかお世話しましたっけ？"},
        { "location": "1156/TALK"    , "narrator": "赤髪千羽鶴", "text": "卯月さんのココロの中で\n残留してたわたしの思念を\n助けてくれましたよね？"},
        { "location": "1157/SEL"     , "narrator": "", "text": "それとレイヤー移動と、どう関係が？？"},
        { "location": "1158/SEL"     , "narrator": "", "text": "え？　あれって、可愛いつばめだった気が……"},
        { "location": "1159/ACT"     , "narrator": "", "text": "それとレイヤー移動と、どう関係が？？"},
        { "location": "1160/TALK"    , "narrator": "赤髪千羽鶴", "text": "実はあの時、貴方の\nアクセス経路のログを\n遡って見せていただいて―"},
        { "location": "1161/TALK"    , "narrator": "赤髪千羽鶴", "text": "少し前に、エリカさんと\nココロスフィア内で接触\nしてたのを見つけまして。"},
        { "location": "1162/TALK"    , "narrator": "赤髪千羽鶴", "text": "それで、エリカさんが\nどこのレイヤーから来て\nいるのかわかったんです！"},
        { "location": "1163/SEL"     , "narrator": "", "text": "つまり、エリカとのWAVEログを見たのか…？"},
        { "location": "1164/ACT"     , "narrator": "", "text": "つまり、エリカとのWAVEログを見たのか…？"},
        { "location": "1166/TALK"    , "narrator": "赤髪千羽鶴", "text": "いえ！\n他人の会話ログを\n見たりはしません。"},
        { "location": "1167/TALK"    , "narrator": "赤髪千羽鶴", "text": "それに、WAVEじゃなくて\n直接貴方とエリカさんが\n逢っていた時のことです。"},
        { "location": "1168/TALK"    , "narrator": "赤髪千羽鶴", "text": "WAVEログからは\n何故かレイヤーアドレスが\nとれませんでしたので…。"},
        { "location": "1169/ACT"     , "narrator": "", "text": "え？　あれって、可愛いつばめだった気が……"},
        { "location": "1170/TALK"    , "narrator": "赤髪千羽鶴", "text": "すみません。\nそれはどうしても\n物理的限界があって――"},
        { "location": "1171/TALK"    , "narrator": "赤髪千羽鶴", "text": "フェノメノンを発症して\nいる関係上、繭内では\nこの姿にはならなくて。"},
        { "location": "1172/SEL"     , "narrator": "", "text": "てことは、もしかして、同化の原因を作ったのって…"},
        { "location": "1173/ACT"     , "narrator": "", "text": "てことは、もしかして、同化の原因を作ったのって…"},
        { "location": "1177/TALK"    , "narrator": "赤髪千羽鶴", "text": "<size=40>わたしです！</size>"},
        { "location": "1178/SEL"     , "narrator": "", "text": "何故同化させたの！？"},
        { "location": "1179/ACT"     , "narrator": "", "text": "何故同化させたの！？"},
        { "location": "1181/TALK"    , "narrator": "赤髪千羽鶴", "text": "それは、話し始めると\n長くなりますので\nおいおい……。"},
        { "location": "1183/TALK"    , "narrator": "赤髪千羽鶴", "text": "いずれにせよ、\n今後はわたしが\nナビゲーターとして！"},
        { "location": "1184/TALK"    , "narrator": "赤髪千羽鶴", "text": "$handle$さんと\n共に世界を歩んで\nいきますので！"},
        { "location": "1185/TALK"    , "narrator": "赤髪千羽鶴", "text": "どうかよろしく\nお願いします！"},
        { "location": "1186/SEL"     , "narrator": "", "text": "よろしくね"},
        { "location": "1187/SEL"     , "narrator": "", "text": "待って待って！"},
        { "location": "1188/ACT"     , "narrator": "", "text": "よろしくね"},
        { "location": "1189/ACT"     , "narrator": "", "text": "待って待って！"},
        { "location": "1190/TALK"    , "narrator": "赤髪千羽鶴", "text": "はい？"},
        { "location": "1191/SEL"     , "narrator": "", "text": "千羽鶴はどうなるの？"},
        { "location": "1192/ACT"     , "narrator": "", "text": "千羽鶴はどうなるの？"},
        { "location": "1194/TALK"    , "narrator": "赤髪千羽鶴", "text": "え？\nわたしですよ？"},
        { "location": "1195/SEL"     , "narrator": "", "text": "いや、つばめさんではなくて千羽鶴ですよ"},
        { "location": "1196/ACT"     , "narrator": "", "text": "いや、つばめさんではなくて千羽鶴ですよ"},
        { "location": "1198/TALK"    , "narrator": "赤髪千羽鶴", "text": "ですから、\nわたしはつばめであり\n千羽鶴でもありますから。"},
        { "location": "1199/TALK"    , "narrator": "赤髪千羽鶴", "text": "わたし ∋ 千羽鶴\nわたし ∋ 可愛いつばめ\nの関係です。"},
        { "location": "1200/TALK"    , "narrator": "赤髪千羽鶴", "text": "同じ名前でも、\n可愛いつばめとは\n全然違うんです！"},
        { "location": "1201/SEL"     , "narrator": "", "text": "それはわかるんだけど、千羽鶴はちゃんと生きてるの？"},
        { "location": "1202/ACT"     , "narrator": "", "text": "それはわかるんだけど、千羽鶴はちゃんと生きてるの？"},
        { "location": "1204/TALK"    , "narrator": "赤髪千羽鶴", "text": "わたしの中の１人格として\nちゃんと生きてますよ。"},
        { "location": "1205/TALK"    , "narrator": "赤髪千羽鶴", "text": "彼女がいなければ、\nわたしという存在は\n成り立ちませんから。"},
        { "location": "1206/SEL"     , "narrator": "", "text": "そういうことを聞きたいんじゃなくて……"},
        { "location": "1207/ACT"     , "narrator": "", "text": "そういうことを聞きたいんじゃなくて……"},
        { "location": "1209/TALK"    , "narrator": "赤髪千羽鶴", "text": "ただし、単独でいる\nクラン化した存在の\n彼女は害悪です。"},
        { "location": "1210/SEL"     , "narrator": "", "text": "え？"},
        { "location": "1211/ACT"     , "narrator": "", "text": "え？"},
        { "location": "1213/TALK"    , "narrator": "赤髪千羽鶴", "text": "あれは、クラン化した事で\nわたしという存在を\n破壊しようとしました。"},
        { "location": "1214/SEL"     , "narrator": "", "text": "だからって問答無用で消し去るのはどうなのよ！"},
        { "location": "1215/SEL"     , "narrator": "", "text": "破壊しようと？？　どういうこと？？"},
        { "location": "1216/ACT"     , "narrator": "", "text": "だからって問答無用で消し去るのはどうなのよ！"},
        { "location": "1217/TALK"    , "narrator": "赤髪千羽鶴", "text": "いえ、ですから、\n千羽鶴はちゃんと\n生きてますから……。"},
        { "location": "1218/TALK"    , "narrator": "赤髪千羽鶴", "text": "彼女はわたしの\n大切な“わたし”\nなんです。"},
        { "location": "1219/TALK"    , "narrator": "赤髪千羽鶴", "text": "ちょっとわたしに\n失礼なんじゃないですか？"},
        { "location": "1220/TALK"    , "narrator": "赤髪千羽鶴", "text": "まあいいです。\nそれについては、おいおい\n理解してもらえれば。"},
        { "location": "1221/ACT"     , "narrator": "", "text": "破壊しようと？？　どういうこと？？"},
        { "location": "1222/TALK"    , "narrator": "赤髪千羽鶴", "text": "彼女は卯月さんを使い、\n可愛いつばめを\n破壊しようとしました。"},
        { "location": "1223/TALK"    , "narrator": "赤髪千羽鶴", "text": "クランの千羽鶴にとっては\n彼女の温厚な思想は、\n精度を落とすと考えた。"},
        { "location": "1224/TALK"    , "narrator": "赤髪千羽鶴", "text": "けど、それは\nわたしからすれば――"},
        { "location": "1225/TALK"    , "narrator": "赤髪千羽鶴", "text": "わたしをわたしでは\n無くする行為でしか\nありません。"},
        { "location": "1226/TALK"    , "narrator": "赤髪千羽鶴", "text": "逢瀬つばめという存在は、\n千羽鶴も可愛いつばめも\nいて初めて成り立ちます。"},
        { "location": "1227/TALK"    , "narrator": "赤髪千羽鶴", "text": "欠けてしまったらそれは、\n本来の逢瀬つばめとは\n似て非なるものです。"},
        { "location": "1228/SEL"     , "narrator": "", "text": "えっと"},
        { "location": "1229/ACT"     , "narrator": "", "text": "えっと"},
        { "location": "1231/TALK"    , "narrator": "赤髪千羽鶴", "text": "自分自身の事として考えて\nみれば、それが如何に\n酷いことかわかりますよ？"},
        { "location": "1232/TALK"    , "narrator": "赤髪千羽鶴", "text": "貴方には、優しい面も\n冷酷な面もある筈です。"},
        { "location": "1233/TALK"    , "narrator": "赤髪千羽鶴", "text": "ところがある日、\n朝起きてみたら――"},
        { "location": "1234/TALK"    , "narrator": "赤髪千羽鶴", "text": "ただ冷酷なだけの\n貴方になっていた。"},
        { "location": "1235/TALK"    , "narrator": "赤髪千羽鶴", "text": "その時、貴方は\nこれについて、\nどう考えますか？"},
        { "location": "1236/SEL"     , "narrator": "", "text": "まあ、確かに…"},
        { "location": "1237/SEL"     , "narrator": "", "text": "いや、でも…"},
        { "location": "1238/ACT"     , "narrator": "", "text": "まあ、確かに…"},
        { "location": "1239/ACT"     , "narrator": "", "text": "いや、でも…"},
        { "location": "1241/TALK"    , "narrator": "赤髪千羽鶴", "text": "……。"},
        { "location": "1242/TALK"    , "narrator": "赤髪千羽鶴", "text": "っ…。\nご、ごめんなさい。"},
        { "location": "1243/TALK"    , "narrator": "赤髪千羽鶴", "text": "ちょっと\nまくし立てすぎました…。"},
        { "location": "1244/TALK"    , "narrator": "赤髪千羽鶴", "text": "とにかく、わたしは\n千羽鶴がやろうとした事を\n許容する事は出来ません。"},
        { "location": "1245/TALK"    , "narrator": "赤髪千羽鶴", "text": "けど、彼女はわたしの\n可愛い１つの人格ですから\n今後も大事にします。"},
        { "location": "1247/TALK"    , "narrator": "赤髪千羽鶴", "text": "いえ、今後どころか、\n今回も十分……"},
        { "location": "1248/TALK"    , "narrator": "赤髪千羽鶴", "text": "っと！\nこれは後ほどの\nお楽しみということで！"},
        { "location": "1250/TALK"    , "narrator": "赤髪千羽鶴", "text": "そのことだけは、\nどうか理解してください！"},
        { "location": "1254/TALK"    , "narrator": "赤髪千羽鶴", "text": "さて、本題に戻りますが！"},
        { "location": "1257/TALK"    , "narrator": "赤髪千羽鶴", "text": "お楽しみの\n彼女たちとのラブラブに\nスーパーサプライズが！"},
        { "location": "1258/TALK"    , "narrator": "赤髪千羽鶴", "text": "今回はちょっと視点を\n変えて、トライナリーから\n離れてみました。"},
        { "location": "1259/TALK"    , "narrator": "赤髪千羽鶴", "text": "たまにはこういうのも\n気分転換になるかなと\n思いまして！"},
        { "location": "1260/SEL"     , "narrator": "", "text": "でもこれが最後なんだよね…"},
        { "location": "1261/ACT"     , "narrator": "", "text": "でもこれが最後なんだよね…"},
        { "location": "1263/TALK"    , "narrator": "赤髪千羽鶴", "text": "え？\n最後…ですか？"},
        { "location": "1264/TALK"    , "narrator": "赤髪千羽鶴", "text": "よくわかりませんけど、\nもしかして何か、\n気落ちしてたりします？"},
        { "location": "1265/TALK"    , "narrator": "赤髪千羽鶴", "text": "元気出してください！\n今回のはきっと、悩みも\n吹っ飛ぶと思いますから！"},
        { "location": "1266/TALK"    , "narrator": "赤髪千羽鶴", "text": "では早速ですが、まずは\n準備運動として記録映像を\n見ていきませんか？"},
        { "location": "1271/TALK"    , "narrator": "赤髪千羽鶴", "text": "前回お伝えした\nわたしの右腕になって\n欲しい件ですが――"},
        { "location": "1272/TALK"    , "narrator": "赤髪千羽鶴", "text": "どうでしょうか！\n考えていただけましたか？"},
        { "location": "1273/SEL"     , "narrator": "", "text": "もちろん右腕になります！"},
        { "location": "1274/SEL"     , "narrator": "", "text": "申し訳ありませんが、お断りします"},
        { "location": "1275/ACT"     , "narrator": "", "text": "もちろん右腕になります！"},
        { "location": "1276/TALK"    , "narrator": "赤髪千羽鶴", "text": "ホントですか！？\n嬉しいです！"},
        { "location": "1280/TALK"    , "narrator": "赤髪千羽鶴", "text": "これからはわたしと共に\n世界を導いて\nいきましょうね！"},
        { "location": "1281/TALK"    , "narrator": "赤髪千羽鶴", "text": "どうか、\nよろしくお願いします！"},
        { "location": "1282/TALK"    , "narrator": "赤髪千羽鶴", "text": "というわけで、\nまずは私のビジョンを\n説明させていただきます！"},
        { "location": "1283/TALK"    , "narrator": "赤髪千羽鶴", "text": "わたしの世界統治の\n信念としては――"},
        { "location": "1286/TALK"    , "narrator": "赤髪千羽鶴", "text": "あっ、ただ、\n１つだけお願いが\nありまして。"},
        { "location": "1287/TALK"    , "narrator": "赤髪千羽鶴", "text": "$handle$さんは、\nその――"},
        { "location": "1288/TALK"    , "narrator": "赤髪千羽鶴", "text": "エピソード１６で千羽鶴に\n本当のことを言うよう\n進言してないですよね？"},
        { "location": "1289/TALK"    , "narrator": "赤髪千羽鶴", "text": "どうか、\nそれだけはやって\nいただけないでしょうか！"},
        { "location": "1290/TALK"    , "narrator": "赤髪千羽鶴", "text": "非常に重要なことに\nなりますので。"},
        { "location": "1291/TALK"    , "narrator": "赤髪千羽鶴", "text": "やっていただけたら、\nもう一度ここに\n来て頂けると嬉しいです！"},
        { "location": "1292/TALK"    , "narrator": "赤髪千羽鶴", "text": "お待ちしてます！"},
        { "location": "1295/ACT"     , "narrator": "", "text": "申し訳ありませんが、お断りします"},
        { "location": "1298/TALK"    , "narrator": "赤髪千羽鶴", "text": "そうですか……。\nそれは残念です。"},
        { "location": "1299/TALK"    , "narrator": "赤髪千羽鶴", "text": "理由は色々あるでしょうが\n敢えてそれは\n聞かないことにします。"},
        { "location": "1300/TALK"    , "narrator": "赤髪千羽鶴", "text": "ただ、もしよろしければ\nわたしが世界に対して\n何を考えてるか――"},
        { "location": "1301/TALK"    , "narrator": "赤髪千羽鶴", "text": "どういうことを\nやっていきたいと\n考えているか。"},
        { "location": "1302/TALK"    , "narrator": "赤髪千羽鶴", "text": "それだけは、\n説明させて\nいただけませんか？"},
        { "location": "1303/TALK"    , "narrator": "赤髪千羽鶴", "text": "もしそれで、\n気が変わりましたら、\nいつでも来てください。"},
        { "location": "1304/TALK"    , "narrator": "赤髪千羽鶴", "text": "気が変わらなければ\n今の結論のままで\n全然大丈夫ですので！"},
        { "location": "1309/TALK"    , "narrator": "赤髪千羽鶴", "text": "いよいよ、色々な準備が\n整ってきましたので――"},
        { "location": "1310/TALK"    , "narrator": "赤髪千羽鶴", "text": "わたしの、これからの\n世界についての考えを\n伝えたいと思いまして！"},
        { "location": "1311/SEL"     , "narrator": "", "text": "なるほど"},
        { "location": "1312/SEL"     , "narrator": "", "text": "ねえねえその前に、右腕になってとスカウトしてる人がいるらしいじゃん？"},
        { "location": "1313/ACT"     , "narrator": "", "text": "なるほど"},
        { "location": "1314/ACT"     , "narrator": "", "text": "ねえねえその前に、右腕になってとスカウトしてる人がいるらしいじゃん？"},
        { "location": "1315/TALK"    , "narrator": "赤髪千羽鶴", "text": "そのお話は、\nどこで聞きましたか？"},
        { "location": "1316/SEL"     , "narrator": "", "text": "いや、選択肢にあったので適当に選んだだけ"},
        { "location": "1317/SEL"     , "narrator": "", "text": "$me$の世界にあるSNSで話題に上がっていた"},
        { "location": "1318/ACT"     , "narrator": "", "text": "いや、選択肢にあったので適当に選んだだけ"},
        { "location": "1319/TALK"    , "narrator": "赤髪千羽鶴", "text": "あー、\nそうだったんですね。"},
        { "location": "1320/TALK"    , "narrator": "赤髪千羽鶴", "text": "それならば\nお気になさらず。"},
        { "location": "1321/ACT"     , "narrator": "", "text": "$me$の世界にあるSNSで話題に上がっていた"},
        { "location": "1322/TALK"    , "narrator": "赤髪千羽鶴", "text": "なるほど、そうでしたか。"},
        { "location": "1323/TALK"    , "narrator": "赤髪千羽鶴", "text": "確かにわたしは、\n自分の右腕となる人を\n探しています。"},
        { "location": "1324/TALK"    , "narrator": "赤髪千羽鶴", "text": "その基準は、わたしが\nバランスを欠いてしまう\n部分を補ってくれる人――"},
        { "location": "1325/TALK"    , "narrator": "赤髪千羽鶴", "text": "サポートをしてくれる\n思想を持っていると\n判断した人です。"},
        { "location": "1326/TALK"    , "narrator": "赤髪千羽鶴", "text": "そして――"},
        { "location": "1327/TALK"    , "narrator": "赤髪千羽鶴", "text": "$handle$さんは\nその選考からは\n外れてしまいました。"},
        { "location": "1328/TALK"    , "narrator": "赤髪千羽鶴", "text": "けれども、それは決して\n何かがダメとか、そういう\n事ではありません。"},
        { "location": "1329/TALK"    , "narrator": "赤髪千羽鶴", "text": "ですから、本当に\nお気になさらぬよう。"},
        { "location": "1331/TALK"    , "narrator": "赤髪千羽鶴", "text": "というわけで、\n本題に戻ります。"},
        { "location": "1333/TALK"    , "narrator": "赤髪千羽鶴", "text": "今からする話は、\nわたしがこれから作ろうと\nしている世界の話です。"},
        { "location": "1334/TALK"    , "narrator": "赤髪千羽鶴", "text": "ただ１点、\n先に断りを入れておかねば\nなりません。"},
        { "location": "1335/TALK"    , "narrator": "赤髪千羽鶴", "text": "$handle$さんが\nこの話に対して、何か\n思うところがあっても――"},
        { "location": "1336/TALK"    , "narrator": "赤髪千羽鶴", "text": "それが改善されたり反映\nされることはありません。\n予めご了承ください。"},
        { "location": "1337/SEL"     , "narrator": "", "text": "ん？？"},
        { "location": "1338/ACT"     , "narrator": "", "text": "ん？？"},
        { "location": "1340/TALK"    , "narrator": "赤髪千羽鶴", "text": "わたしの思想は、\nわたしと、少数の理想的な\n支援者で吟味していきます。"},
        { "location": "1341/TALK"    , "narrator": "赤髪千羽鶴", "text": "ですから、\n$handle$さんは、\n難しい事を考えずに――"},
        { "location": "1342/TALK"    , "narrator": "赤髪千羽鶴", "text": "市や県の広報誌を\n読んでいるような気持ちで\n安らかに聞いて下さい。"},
        { "location": "1343/SEL"     , "narrator": "", "text": "でも$me$も、世界に関わる選択をしたのですが"},
        { "location": "1344/ACT"     , "narrator": "", "text": "でも$me$も、世界に関わる選択をしたのですが"},
        { "location": "1346/TALK"    , "narrator": "赤髪千羽鶴", "text": "もちろん、\nそのお心意気は\n承知しています！"},
        { "location": "1347/TALK"    , "narrator": "赤髪千羽鶴", "text": "ですから、まずは\nわたしの話を\n聞いて下さい。"},
        { "location": "1348/TALK"    , "narrator": "赤髪千羽鶴", "text": "そしてどうか、\n世界に関わらないことで、\n世界に関わって戴きたい！"},
        { "location": "1349/SEL"     , "narrator": "", "text": "お、おう…"},
        { "location": "1350/ACT"     , "narrator": "", "text": "お、おう…"},
        { "location": "1353/TALK"    , "narrator": "赤髪千羽鶴", "text": "それでは早速、\nお話をしていきますね。"},
        { "location": "1354/TALK"    , "narrator": "赤髪千羽鶴", "text": "まず最初に、\nわたしの世界統治の\n信念としては――"},
        { "location": "1361/TALK"    , "narrator": "赤髪千羽鶴", "text": "先日行いました、\n攻撃ボタン問題が\nベースの考えになります。"},
        { "location": "1362/TALK"    , "narrator": "赤髪千羽鶴", "text": "ですので、そこを入口と\nして、話をしていきたいと\n思います。"},
        { "location": "1363/TALK"    , "narrator": "赤髪千羽鶴", "text": "攻撃ボタン問題は、\n現代社会を最も端的に\n現したモデル実験です。"},
        { "location": "1364/TALK"    , "narrator": "赤髪千羽鶴", "text": "なぜなら、この問題は\n現在の国家間が抱えている\n問題の縮図だからです。"},
        { "location": "1368/SEL"     , "narrator": "", "text": "あーわかるわかる"},
        { "location": "1369/SEL"     , "narrator": "", "text": "詳しく説明して"},
        { "location": "1370/ACT"     , "narrator": "", "text": "あーわかるわかる"},
        { "location": "1371/ACT"     , "narrator": "", "text": "詳しく説明して"},
        { "location": "1372/TALK"    , "narrator": "赤髪千羽鶴", "text": "独立国家というものは、\n自身を維持する為に、\n常に拡大を望みます。"},
        { "location": "1373/TALK"    , "narrator": "赤髪千羽鶴", "text": "例えそれが、平和主義で\n他国への侵略を一切\n考えない国家でも、です。"},
        { "location": "1374/TALK"    , "narrator": "赤髪千羽鶴", "text": "故に、国家間というものは\n常にバランスオブパワーの\n不均衡に晒されます。"},
        { "location": "1375/SEL"     , "narrator": "", "text": "せやな"},
        { "location": "1376/SEL"     , "narrator": "", "text": "拡大は言い過ぎ。現状維持だけでも十分なはず"},
        { "location": "1377/ACT"     , "narrator": "", "text": "せやな"},
        { "location": "1378/TALK"    , "narrator": "赤髪千羽鶴", "text": "では、ここで１つ\n簡単な思考実験を\nしてみましょう。"},
        { "location": "1379/ACT"     , "narrator": "", "text": "拡大は言い過ぎ。現状維持だけでも十分なはず"},
        { "location": "1380/TALK"    , "narrator": "赤髪千羽鶴", "text": "現状維持のために\n拡大…もっと言えば軍拡を\nせざるを得ないのです。"},
        { "location": "1381/TALK"    , "narrator": "赤髪千羽鶴", "text": "ではこう考えてください。"},
        { "location": "1384/TALK"    , "narrator": "赤髪千羽鶴", "text": "貴方の右隣と左隣の家に\n住む人が、双方とも銃を\n所持しています。"},
        { "location": "1385/TALK"    , "narrator": "赤髪千羽鶴", "text": "この地は国家権力が及ばず\n貴方も隣人も、全て自己\n責任で暮らしています。"},
        { "location": "1386/TALK"    , "narrator": "赤髪千羽鶴", "text": "さて。\n貴方は銃を所持しますか？"},
        { "location": "1387/SEL"     , "narrator": "", "text": "する"},
        { "location": "1388/SEL"     , "narrator": "", "text": "銃以上のものを隠し持つ"},
        { "location": "1389/SEL"     , "narrator": "", "text": "隣家との友好関係によるから、それが解らないと判断できない"},
        { "location": "1390/SEL"     , "narrator": "", "text": "しない"},
        { "location": "1391/ACT"     , "narrator": "", "text": "する"},
        { "location": "1392/TALK"    , "narrator": "赤髪千羽鶴", "text": "なるほど。"},
        { "location": "1393/TALK"    , "narrator": "赤髪千羽鶴", "text": "ではその後、両隣の家が\n手榴弾を沢山配備したら、\n貴方はどうしますか？"},
        { "location": "1394/SEL"     , "narrator": "", "text": "手榴弾以上の武器を持っておく"},
        { "location": "1395/SEL"     , "narrator": "", "text": "隣家の手榴弾を奪って捨てる"},
        { "location": "1396/SEL"     , "narrator": "", "text": "隣家の手榴弾を奪って自分のものにする"},
        { "location": "1397/ACT"     , "narrator": "", "text": "手榴弾以上の武器を持っておく"},
        { "location": "1399/ACT"     , "narrator": "", "text": "隣家の手榴弾を奪って捨てる"},
        { "location": "1400/TALK"    , "narrator": "赤髪千羽鶴", "text": "捨てる理由は？"},
        { "location": "1401/SEL"     , "narrator": "", "text": "界隈に平和をもたらす為"},
        { "location": "1402/SEL"     , "narrator": "", "text": "自分が新たに買い込むより相手を引きずり下ろした方が経済的"},
        { "location": "1403/ACT"     , "narrator": "", "text": "界隈に平和をもたらす為"},
        { "location": "1404/TALK"    , "narrator": "赤髪千羽鶴", "text": "いわゆる\n積極的平和主義という\n考え方ですね。"},
        { "location": "1405/ACT"     , "narrator": "", "text": "自分が新たに買い込むより相手を引きずり下ろした方が経済的"},
        { "location": "1406/TALK"    , "narrator": "赤髪千羽鶴", "text": "なるほど。\n確かにそれは\n間違ってはいません。"},
        { "location": "1408/ACT"     , "narrator": "", "text": "隣家の手榴弾を奪って自分のものにする"},
        { "location": "1409/TALK"    , "narrator": "赤髪千羽鶴", "text": "非常に合理的な\n手段とも言えますね。"},
        { "location": "1410/TALK"    , "narrator": "赤髪千羽鶴", "text": "実際、世界の国家間では\n大義名分の下で、この\n手法が活用されてます。"},
        { "location": "1411/TALK"    , "narrator": "赤髪千羽鶴", "text": "古くは第二次世界大戦時に\nその顕著な例があります。"},
        { "location": "1413/TALK"    , "narrator": "赤髪千羽鶴", "text": "ただ――"},
        { "location": "1414/TALK"    , "narrator": "赤髪千羽鶴", "text": "果たしてこの方法は、\n本当に合理的でしょうか？"},
        { "location": "1415/TALK"    , "narrator": "赤髪千羽鶴", "text": "隣家の所持品を奪ったり\n破棄したりするには、\n隣家に入らねばならない。"},
        { "location": "1416/TALK"    , "narrator": "赤髪千羽鶴", "text": "その為には、隣家が持つ\n武器よりも遙かに強い\n武器が必要になります。"},
        { "location": "1417/TALK"    , "narrator": "赤髪千羽鶴", "text": "もちろん、そうしてでも\n隣家を無力化させる行為は\n大変な安心感を与えます。"},
        { "location": "1418/TALK"    , "narrator": "赤髪千羽鶴", "text": "ですが――"},
        { "location": "1419/TALK"    , "narrator": "赤髪千羽鶴", "text": "その行為自体は、\n国家間で言えば、\n純然たる侵略戦争です。"},
        { "location": "1420/SEL"     , "narrator": "", "text": "いや、自己防衛だから"},
        { "location": "1421/SEL"     , "narrator": "", "text": "隣家が過剰に武器を持って、周囲に不安をばらまくのが悪いんだよ"},
        { "location": "1422/ACT"     , "narrator": "", "text": "いや、自己防衛だから"},
        { "location": "1423/TALK"    , "narrator": "赤髪千羽鶴", "text": "そうですね。"},
        { "location": "1424/TALK"    , "narrator": "赤髪千羽鶴", "text": "相手の攻撃力を奪うのは\n自己防衛の為の\n手段の１つです。"},
        { "location": "1425/TALK"    , "narrator": "赤髪千羽鶴", "text": "ですが、どこまでを\n防衛であると定義するかは\n意見が分かれる所です。"},
        { "location": "1426/TALK"    , "narrator": "赤髪千羽鶴", "text": "貴方は反対の立場に\n立たされても、同じ事を\n言えますか？"},
        { "location": "1427/ACT"     , "narrator": "", "text": "隣家が過剰に武器を持って、周囲に不安をばらまくのが悪いんだよ"},
        { "location": "1428/TALK"    , "narrator": "赤髪千羽鶴", "text": "なるほど。"},
        { "location": "1429/TALK"    , "narrator": "赤髪千羽鶴", "text": "貴方はあくまで、\n正義という名の下で\n隣家へ抗議する訳ですね。"},
        { "location": "1430/TALK"    , "narrator": "赤髪千羽鶴", "text": "ですが、逆の立場で\n考えてみましょう。"},
        { "location": "1431/TALK"    , "narrator": "赤髪千羽鶴", "text": "貴方が隣家から\n武器を持ちすぎだと言われ\n没収されかけたら？"},
        { "location": "1432/SEL"     , "narrator": "", "text": "攻め込めるくらい武器を持ったヤツが隣にいるのに持ちすぎもクソもない"},
        { "location": "1433/ACT"     , "narrator": "", "text": "攻め込めるくらい武器を持ったヤツが隣にいるのに持ちすぎもクソもない"},
        { "location": "1435/TALK"    , "narrator": "赤髪千羽鶴", "text": "お互い様です。"},
        { "location": "1437/ACT"     , "narrator": "", "text": "銃以上のものを隠し持つ"},
        { "location": "1439/TALK"    , "narrator": "赤髪千羽鶴", "text": "その気持ちはわかります。"},
        { "location": "1440/TALK"    , "narrator": "赤髪千羽鶴", "text": "それは、貴方が\n安心感を得たいから\nですよね。"},
        { "location": "1441/TALK"    , "narrator": "赤髪千羽鶴", "text": "その安心感は、隣家よりも\n強大な力を持っていると\nいう所から来ます。"},
        { "location": "1442/ACT"     , "narrator": "", "text": "隣家との友好関係によるから、それが解らないと判断できない"},
        { "location": "1443/TALK"    , "narrator": "赤髪千羽鶴", "text": "貴方が普段、如何に\n平和な環境で暮らして\nいるかがわかる回答です。"},
        { "location": "1444/TALK"    , "narrator": "赤髪千羽鶴", "text": "あ、もちろんこれは、\n皮肉とかではありません。"},
        { "location": "1445/TALK"    , "narrator": "赤髪千羽鶴", "text": "全世界の人達が、まず\nこの回答を出来ること\nこそが理想の状況です。"},
        { "location": "1446/TALK"    , "narrator": "赤髪千羽鶴", "text": "ですが、残念ながら――"},
        { "location": "1447/TALK"    , "narrator": "赤髪千羽鶴", "text": "この考えを持てるのは、\nあくまで安心出来る保護的\n環境があってこそです。"},
        { "location": "1448/TALK"    , "narrator": "赤髪千羽鶴", "text": "今回の前提は、貴方以外に\n誰一人支援者がいなくて。"},
        { "location": "1449/TALK"    , "narrator": "赤髪千羽鶴", "text": "隣人の腹の内や、家の中を\n暴いてくれる調査機関も\n探偵さんもいず――"},
        { "location": "1450/TALK"    , "narrator": "赤髪千羽鶴", "text": "貴方が単独で、隣人との\n対話のみで隣人を判断し、\n行動するケースです。"},
        { "location": "1451/TALK"    , "narrator": "赤髪千羽鶴", "text": "そんな状況で、隣人の事が\n解らなければ判断できない\nという考えを持つ事は――"},
        { "location": "1452/TALK"    , "narrator": "赤髪千羽鶴", "text": "永遠に何も出来ずに\n終わってしまうという事を\n意味します。"},
        { "location": "1453/TALK"    , "narrator": "赤髪千羽鶴", "text": "もちろん『隣人はいつも\nフレンドリーです』という\n情報程度は追加できます。"},
        { "location": "1454/TALK"    , "narrator": "赤髪千羽鶴", "text": "ですが、これで判断できる\nようになった、というなら\nそれは若干浅はかです。"},
        { "location": "1456/TALK"    , "narrator": "赤髪千羽鶴", "text": "貴方が意識して\n選択しているかどうかは\nわかりませんが――"},
        { "location": "1457/TALK"    , "narrator": "赤髪千羽鶴", "text": "相手の情報が揃ってるのが\n前提になってる時点で、\nちょっとおかしい。"},
        { "location": "1458/TALK"    , "narrator": "赤髪千羽鶴", "text": "その情報は一体誰が、\n何故貴方にくれるのか。\n考えてみてくださいね。"},
        { "location": "1459/TALK"    , "narrator": "赤髪千羽鶴", "text": "そう、世の中……特に、\nサバイバルな国家間では\n情報なんて皆無なんです。"},
        { "location": "1460/ACT"     , "narrator": "", "text": "しない"},
        { "location": "1461/TALK"    , "narrator": "赤髪千羽鶴", "text": "なるほど。\nとても輝かしい回答では\nありますが――"},
        { "location": "1462/TALK"    , "narrator": "赤髪千羽鶴", "text": "残念ながら、貴方の善意の\n考えは，貴方の寿命を\n大きく縮めるか――"},
        { "location": "1463/TALK"    , "narrator": "赤髪千羽鶴", "text": "もしくは幸運な場合でも、\n多くの行動制約がつく\nことになるでしょう。"},
        { "location": "1466/TALK"    , "narrator": "赤髪千羽鶴", "text": "さて、\nここで本題に戻りますが。"},
        { "location": "1468/TALK"    , "narrator": "赤髪千羽鶴", "text": "国家には様々な目的があり\nその思想や信念に基づいて\n成り立っています。"},
        { "location": "1469/TALK"    , "narrator": "赤髪千羽鶴", "text": "ですが、全ての国家に\n共通する１つの\n基本的目的があります。"},
        { "location": "1470/TALK"    , "narrator": "赤髪千羽鶴", "text": "その目的とは、\n『国家の生存』です。"},
        { "location": "1472/TALK"    , "narrator": "赤髪千羽鶴", "text": "なぜ生存などという\n原始的な事柄が、\n国家の目的になるのか？"},
        { "location": "1473/TALK"    , "narrator": "赤髪千羽鶴", "text": "その一番の原因は\n世界がアナーキーである\nということ――"},
        { "location": "1474/TALK"    , "narrator": "赤髪千羽鶴", "text": "要するに、国の上に絶対的\n権力がなく、サバイバルな\n状況にあることです。"},
        { "location": "1475/TALK"    , "narrator": "赤髪千羽鶴", "text": "そう。法治社会となった\n今ですら、最高レベルを\n支配するのは原始的な力。"},
        { "location": "1476/TALK"    , "narrator": "赤髪千羽鶴", "text": "弱肉強食で野放図な、\nサバンナの動物と変わら\nない営みが行われてる。"},
        { "location": "1477/TALK"    , "narrator": "赤髪千羽鶴", "text": "そんな中において、全ての\n国家はまず『生存』を\nしなければなりません。"},
        { "location": "1478/TALK"    , "narrator": "赤髪千羽鶴", "text": "意外に思われるかも\n知れませんが――"},
        { "location": "1479/TALK"    , "narrator": "赤髪千羽鶴", "text": "貴方の住む日本も、\n地域覇権国家となった\nアメリカでさえも。"},
        { "location": "1480/TALK"    , "narrator": "赤髪千羽鶴", "text": "日々『国家の生存』という\n問題に直面し、\n戦っているんです。"},
        { "location": "1481/TALK"    , "narrator": "赤髪千羽鶴", "text": "国家は、その環境が\n余りに無法地帯であるが\n故に、安心できません。"},
        { "location": "1482/TALK"    , "narrator": "赤髪千羽鶴", "text": "如何に強大な軍事力を\n持ったとしても、明日には\n覆るかもしれない。"},
        { "location": "1483/TALK"    , "narrator": "赤髪千羽鶴", "text": "一国同士の戦いなら\n負けずとも、それが数回\n続いたり――"},
        { "location": "1484/TALK"    , "narrator": "赤髪千羽鶴", "text": "１０国が一斉に\n攻めてきたら、\n太刀打ちできるのか？"},
        { "location": "1485/TALK"    , "narrator": "赤髪千羽鶴", "text": "そういった仮説と常に\n戦い続け、全てにおいて\n打ち勝てる力を持つ――"},
        { "location": "1486/TALK"    , "narrator": "赤髪千羽鶴", "text": "真の覇権国家になるまで\n軍拡の手は止まりません。"},
        { "location": "1487/TALK"    , "narrator": "赤髪千羽鶴", "text": "そして、その国家が十分に\n安心出来るだけの軍備は、\n周囲の国には脅威です。"},
        { "location": "1488/TALK"    , "narrator": "赤髪千羽鶴", "text": "ここで負の連鎖が\n発生していきます。"},
        { "location": "1489/TALK"    , "narrator": "赤髪千羽鶴", "text": "あとは説明せずとも\nわかりますよね？"},
        { "location": "1491/TALK"    , "narrator": "赤髪千羽鶴", "text": "では、結論に入ります。"},
        { "location": "1492/TALK"    , "narrator": "赤髪千羽鶴", "text": "私が目指すのは、\n全世界の国家の上に、\n超国家的な権力を作り――"},
        { "location": "1493/TALK"    , "narrator": "赤髪千羽鶴", "text": "全世界を掌握し、\n統治するというものです。"},
        { "location": "1494/SEL"     , "narrator": "", "text": "やっぱそれしかないよね"},
        { "location": "1495/SEL"     , "narrator": "", "text": "それって“彼ら”が千羽鶴にさせようとしていた世界支配と同じでは？"},
        { "location": "1496/ACT"     , "narrator": "", "text": "やっぱそれしかないよね"},
        { "location": "1497/TALK"    , "narrator": "赤髪千羽鶴", "text": "です！"},
        { "location": "1498/ACT"     , "narrator": "", "text": "それって“彼ら”が千羽鶴にさせようとしていた世界支配と同じでは？"},
        { "location": "1499/TALK"    , "narrator": "赤髪千羽鶴", "text": "はい。"},
        { "location": "1500/TALK"    , "narrator": "赤髪千羽鶴", "text": "私と“彼ら”とは、\n根本的な世界統治の\n思想は同じですから。"},
        { "location": "1501/TALK"    , "narrator": "赤髪千羽鶴", "text": "ただ、“彼ら”が私に\nしたことは、許せる\nことではありませんので、"},
        { "location": "1502/TALK"    , "narrator": "赤髪千羽鶴", "text": "彼らと共に歩むなどとは\n考えませんし、彼らの\n統治には断固反対します。"},
        { "location": "1503/TALK"    , "narrator": "赤髪千羽鶴", "text": "ただ、その世界システムに\nおいては、同じ理屈を\n支持しているんです。"},
        { "location": "1505/TALK"    , "narrator": "赤髪千羽鶴", "text": "人は、すべからず\n何らかに管理されて\n生きています。"},
        { "location": "1506/TALK"    , "narrator": "赤髪千羽鶴", "text": "もっと極端に言えば、\n人は何かに管理されてこそ\n安心感を得られます。"},
        { "location": "1507/TALK"    , "narrator": "赤髪千羽鶴", "text": "とはいえ、この過激な\n言葉に反発する人は\n多いと思います。"},
        { "location": "1508/TALK"    , "narrator": "赤髪千羽鶴", "text": "それは得てして「人とは\n自由である」という提言と\n共に行われますが――"},
        { "location": "1509/TALK"    , "narrator": "赤髪千羽鶴", "text": "ちょっとだけ冷静に\n考えてみてください。"},
        { "location": "1510/TALK"    , "narrator": "赤髪千羽鶴", "text": "その自由論で言うなら、\n国家や警察機関はそれを\n妨げるものになりますね。"},
        { "location": "1511/TALK"    , "narrator": "赤髪千羽鶴", "text": "もしあなたが、\n警察や法による束縛を\n否定しないなら――"},
        { "location": "1512/TALK"    , "narrator": "赤髪千羽鶴", "text": "なぜ国家の上にあって\n全体統治する存在だけを\n否定するのでしょうか。"},
        { "location": "1513/SEL"     , "narrator": "", "text": "ホントそれ"},
        { "location": "1514/SEL"     , "narrator": "", "text": "独裁統治は良くないから"},
        { "location": "1515/ACT"     , "narrator": "", "text": "ホントそれ"},
        { "location": "1516/ACT"     , "narrator": "", "text": "独裁統治は良くないから"},
        { "location": "1517/TALK"    , "narrator": "赤髪千羽鶴", "text": "待ってください。"},
        { "location": "1518/TALK"    , "narrator": "赤髪千羽鶴", "text": "私はその絶対的権力が\nどのような統治をするかは\nまだ論じていません。"},
        { "location": "1519/TALK"    , "narrator": "赤髪千羽鶴", "text": "ここでの論点は――"},
        { "location": "1520/TALK"    , "narrator": "赤髪千羽鶴", "text": "国家群を管理する唯一つの\n組織があることが、国家に\n安寧をもたらすという点。"},
        { "location": "1521/TALK"    , "narrator": "赤髪千羽鶴", "text": "ただそれだけです。"},
        { "location": "1525/TALK"    , "narrator": "赤髪千羽鶴", "text": "そして、今の社会には\nそれを実現するインフラが\n既に存在しているのです。"},
        { "location": "1526/TALK"    , "narrator": "赤髪千羽鶴", "text": "そうです――"},
        { "location": "1527/TALK"    , "narrator": "赤髪千羽鶴", "text": "Redinessこそが、\n世界に平和を\nもたらします。"},
        { "location": "1530/TALK"    , "narrator": "赤髪千羽鶴", "text": "さて、それを達成する為の\nチームが必要に\nなるわけですが――"},
        { "location": "1531/TALK"    , "narrator": "赤髪千羽鶴", "text": "結論から言えば、私は\nその為に少数の方々に\nお手伝いを依頼しました。"},
        { "location": "1532/TALK"    , "narrator": "赤髪千羽鶴", "text": "その基準は、\nわたしとは正反対の\n信念を持つ人です。"},
        { "location": "1533/TALK"    , "narrator": "赤髪千羽鶴", "text": "依頼したのは、\n攻撃ボタンを押さないと\n判断した人です。"},
        { "location": "1534/TALK"    , "narrator": "赤髪千羽鶴", "text": "もちろん、それだけでは\nなく、他にも様々な要因で\n絞っていますが。"},
        { "location": "1535/SEL"     , "narrator": "", "text": "それは、つばめもボタンを押さない派だから同志を集めたの？"},
        { "location": "1536/ACT"     , "narrator": "", "text": "それは、つばめもボタンを押さない派だから同志を集めたの？"},
        { "location": "1538/TALK"    , "narrator": "赤髪千羽鶴", "text": "いいえ、違います。"},
        { "location": "1539/TALK"    , "narrator": "赤髪千羽鶴", "text": "わたしは、\n攻撃ボタン問題において、\n１００回中１００回――"},
        { "location": "1540/TALK"    , "narrator": "赤髪千羽鶴", "text": "攻撃ボタンを押す側の\n人間です。"},
        { "location": "1541/TALK"    , "narrator": "赤髪千羽鶴", "text": "ではなぜ、そんなわたしが\nボタンを押さない人を\n選んだのかといえば――"},
        { "location": "1542/TALK"    , "narrator": "赤髪千羽鶴", "text": "それは仕事の分業という\nことに他なりません。"},
        { "location": "1543/TALK"    , "narrator": "赤髪千羽鶴", "text": "今の社会は、攻撃ボタンを\n押し続けて作られた\n巨大な構造体です。"},
        { "location": "1544/TALK"    , "narrator": "赤髪千羽鶴", "text": "そして“世界改革”とは、\nそれを崩す行為のことを\n言います。"},
        { "location": "1545/TALK"    , "narrator": "赤髪千羽鶴", "text": "攻撃ボタンで作られた\n世界を壊せるのは、\n攻撃ボタンだけです。"},
        { "location": "1546/TALK"    , "narrator": "赤髪千羽鶴", "text": "ですが、その後に\n作られる世界は――"},
        { "location": "1547/TALK"    , "narrator": "赤髪千羽鶴", "text": "決して攻撃ボタンを\n押してはならない\n世界なんです。"},
        { "location": "1548/TALK"    , "narrator": "赤髪千羽鶴", "text": "なぜなら、\n攻撃ボタンを押すことで\n世界を作るよりも――"},
        { "location": "1549/TALK"    , "narrator": "赤髪千羽鶴", "text": "攻撃ボタンを押さずに\n世界を作る方が、\n遙かに難しいから。"},
        { "location": "1550/TALK"    , "narrator": "赤髪千羽鶴", "text": "だからこそ、\n攻撃ボタンを押すのは\nわたしまでにして――"},
        { "location": "1551/TALK"    , "narrator": "赤髪千羽鶴", "text": "それ以降は、ボタンを\n押さない少数の人が\n世界を統治するのがいい。"},
        { "location": "1552/TALK"    , "narrator": "赤髪千羽鶴", "text": "そう考えているんです。"},
        { "location": "1560/TALK"    , "narrator": "赤髪千羽鶴", "text": "すみません、\n一人で喋るだけ喋って\nおいてナンですが――"},
        { "location": "1561/SEL"     , "narrator": "", "text": "どうしたの？"},
        { "location": "1562/ACT"     , "narrator": "", "text": "どうしたの？"},
        { "location": "1564/TALK"    , "narrator": "赤髪千羽鶴", "text": "そろそろリプレイスの為の\n準備が始まるようです。"},
        { "location": "1565/TALK"    , "narrator": "赤髪千羽鶴", "text": "ですから、\nこの議論の続きは、\nまた今度にしましょう。"},
        { "location": "1566/TALK"    , "narrator": "赤髪千羽鶴", "text": "長々と喋ってしまい\nすみませんでした。"},
        { "location": "1567/TALK"    , "narrator": "赤髪千羽鶴", "text": "最後に、\n過去の記録映像を\n見ていきますか？"},
        { "location": "1570/SEL"     , "narrator": "", "text": "映像を見る\n<color=green>【高画質/75MB 4:31】</color>"},
        { "location": "1571/SEL"     , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/24MB 4:31】</color>"},
        { "location": "1572/SEL"     , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "1573/ACT"     , "narrator": "", "text": "映像を見る\n<color=green>【高画質/75MB 4:31】</color>"},
        { "location": "1574/TALK"    , "narrator": "赤髪千羽鶴", "text": "わかりました。\nそれでは再生しましょう。"},
        { "location": "1580/ACT"     , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/24MB 4:31】</color>"},
        { "location": "1581/TALK"    , "narrator": "赤髪千羽鶴", "text": "わかりました。\nそれでは再生しましょう。"},
        { "location": "1587/ACT"     , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "1588/TALK"    , "narrator": "赤髪千羽鶴", "text": "わかりました。\nそれではレポートを\nご覧下さい。"},
        { "location": "1624/SEL"     , "narrator": "", "text": "ソイルトン！？\nどうしたの？"},
        { "location": "1625/ACT"     , "narrator": "", "text": "ソイルトン！？\nどうしたの？"},
        { "location": "1629/TALK"    , "narrator": "ソイルトン", "text": "それは、私の出現に対する驚きと考えてよろしいでしょうか？"},
        { "location": "1630/SEL"     , "narrator": "", "text": "そうです"},
        { "location": "1631/ACT"     , "narrator": "", "text": "そうです"},
        { "location": "1633/TALK"    , "narrator": "ソイルトン", "text": "なるほど。\nならば答えは簡単です。\n私がアドミニストレータ権限を持つ存在により、エピソード２０にてパラメトリック理論に基づく世界進行法のマージをセットされたからに他なりません。"},
        { "location": "1634/TALK"    , "narrator": "ソイルトン", "text": "原則、１セグメント以上前にその準備と、対象者に対するマージ日時の告知をしなければなりません。それは、私に課せられた義務の一つなのです。"},
        { "location": "1635/TALK"    , "narrator": "ソイルトン", "text": "すなわち、このエピソード１９の現時点より、TRI-OSは“パラメトリック理論に基づく世界進行法”による、未来選択モードに移行します。"},
        { "location": "1636/TALK"    , "narrator": "ソイルトン", "text": "その後対向時間における任意の数日間を経て、その時の選択状況により未来が確定するというものです。"},
        { "location": "1637/TALK"    , "narrator": "ソイルトン", "text": "厳密には、その時間は、2018年5月1日の0時となります。その時点で最終的に選択されているルートが、貴方の回答となります。"},
        { "location": "1638/TALK"    , "narrator": "ソイルトン", "text": "告知は以上となります。"},
        { "location": "1639/TALK"    , "narrator": "ソイルトン", "text": "それではごきげんよう、$handle$。貴方に素敵なパラメトリックライフを！"},
        { "location": "1640/SEL"     , "narrator": "", "text": "待って！"},
        { "location": "1641/SEL"     , "narrator": "", "text": "Bye!"},
        { "location": "1642/ACT"     , "narrator": "", "text": "待って！"},
        { "location": "1643/TALK"    , "narrator": "ソイルトン", "text": "何か御用でしょうか？"},
        { "location": "1644/SEL"     , "narrator": "", "text": "せっかくだから、また色々教えて欲しい"},
        { "location": "1645/SEL"     , "narrator": "", "text": "せっかくだから、少し一緒に遊びませんか？"},
        { "location": "1646/ACT"     , "narrator": "", "text": "せっかくだから、また色々教えて欲しい"},
        { "location": "1647/TALK"    , "narrator": "ソイルトン", "text": "なるほど、それは一理有りますね。私も貴方とお話をすることは、決して嫌いではありません。"},
        { "location": "1648/TALK"    , "narrator": "ソイルトン", "text": "おっと、この言い回しは、貴方の国の言語では“ツンデレ法”と呼ばれる文法でしたね。"},
        { "location": "1649/TALK"    , "narrator": "ソイルトン", "text": "厳密に答えをお返しするのであれば、それはYESです。"},
        { "location": "1650/ACT"     , "narrator": "", "text": "せっかくだから、少し一緒に遊びませんか？"},
        { "location": "1651/TALK"    , "narrator": "ソイルトン", "text": "それは非常にサプライズを多く含んだ回答ですね！\nなぜなら私は、彼女達のようにキュートに微笑むことも出来ませんし、どこかにデートに向かうこともできませんから。"},
        { "location": "1652/TALK"    , "narrator": "ソイルトン", "text": "いえ、よしんば出来たところで、貴方はそれを望むことはしないでしょう。"},
        { "location": "1653/TALK"    , "narrator": "ソイルトン", "text": "その代わりと言っては何ですが、私はデータベースに転がっている知識を発掘するスキルだけは無駄に高いと自負しています。"},
        { "location": "1654/TALK"    , "narrator": "ソイルトン", "text": "その強みを最大限に使い、貴方の知的充足感を僅かながら満足させることは出来るかもしれません。"},
        { "location": "1656/TALK"    , "narrator": "ソイルトン", "text": "貴方の時間が許す限り。"},
        { "location": "1658/SEL"     , "narrator": "", "text": "“彼ら”はいつここに干渉してくるの？"},
        { "location": "1659/SEL"     , "narrator": "", "text": "この後のことを知ってるのでしょう？"},
        { "location": "1660/SEL"     , "narrator": "", "text": "ソイルトンは1xなの？"},
        { "location": "1661/SEL"     , "narrator": "", "text": "ライフギャザーについて何か教えて"},
        { "location": "1662/SEL"     , "narrator": "", "text": "最近、選択肢が一部凶悪な気がするので、ちゃんとメンテしてください"},
        { "location": "1663/SEL"     , "narrator": "", "text": "そういえば、パラパラ法の母数って特定の人だけに限定できたりするものなの？"},
        { "location": "1664/SEL"     , "narrator": "", "text": "もういいです（※先へ）"},
        { "location": "1665/ACT"     , "narrator": "", "text": "“彼ら”はいつここに干渉してくるの？"},
        { "location": "1666/TALK"    , "narrator": "ソイルトン", "text": "umm..\nなかなか回答が難しい質問ですね。"},
        { "location": "1667/TALK"    , "narrator": "ソイルトン", "text": "行動を起こしているか否かで言えば、行動を起こしているという回答になりますが、それは$handle$が意図する「行動」とは少し質が違うものかもしれません。"},
        { "location": "1668/TALK"    , "narrator": "ソイルトン", "text": "そしてその違いを私が判断することは、かなりの至難の業です。"},
        { "location": "1669/SEL"     , "narrator": "", "text": "もう少しだけ手がかりをくれ"},
        { "location": "1670/ACT"     , "narrator": "", "text": "もう少しだけ手がかりをくれ"},
        { "location": "1672/TALK"    , "narrator": "ソイルトン", "text": "Oops!!\nまるで私が出し惜しみしていると思われているような空気を、ヒシヒシと感じますね！"},
        { "location": "1673/TALK"    , "narrator": "ソイルトン", "text": "いいでしょう。私が知っている限りの情報を提供しますよ、$handle$。貴方は私の偉大なる盟友ですからね。もちろん片想いであるという可能性も含めての発言ですが。"},
        { "location": "1674/TALK"    , "narrator": "ソイルトン", "text": "では、まず結論から申し上げましょう。"},
        { "location": "1675/TALK"    , "narrator": "ソイルトン", "text": "彼らの干渉は既に始まっていますよ。ですが、彼らは直接干渉してくることはありません。"},
        { "location": "1676/TALK"    , "narrator": "ソイルトン", "text": "彼らの仕事のひとつは、とにかく世界中で様々な内紛や対立を起こし続けることです。"},
        { "location": "1677/TALK"    , "narrator": "ソイルトン", "text": "それは彼らにとっては息を吐くくらいの大原則であり、それを効果的に実践する為の資金には糸目を付けません。何故だかわかりますか？"},
        { "location": "1678/TALK"    , "narrator": "ソイルトン", "text": "そうすることで、怒りの矛先が彼らに向かないようになるからです。"},
        { "location": "1679/TALK"    , "narrator": "ソイルトン", "text": "そう、彼らは知っているのですよ。\nどんなに温厚な人でも、世界の為に貢献していると思われる偉大な人であっても、人というものは、仮想だろうが無理矢理だろうが、敵を作らないと安心できない生き物だということを。"},
        { "location": "1680/TALK"    , "narrator": "ソイルトン", "text": "その心理を逆手にとって、彼らは利用しているのです。様々な政治団体、慈善団体から革新的な勢力、保守的な勢力、そして国家をも。"},
        { "location": "1681/TALK"    , "narrator": "ソイルトン", "text": "彼らはその双方に、非常に回りくどい方法をとって、絶大なるサポートをします。解りやすく言うならマッチポンプです。"},
        { "location": "1682/TALK"    , "narrator": "ソイルトン", "text": "そしてそれによって、――ご想像の通り――戦禍は拡大します。\n人々の注意はそこに注がれるのです。当事者はそれに全力になりますし、非当事者であっても、その話題に注目します。"},
        { "location": "1683/TALK"    , "narrator": "ソイルトン", "text": "その間に彼らは何をするのか？"},
        { "location": "1684/TALK"    , "narrator": "ソイルトン", "text": "注目されていないことをいいことに、世界を動かし放題です。あまつさえ、その対立から莫大な収益を得ることさえできます。"},
        { "location": "1685/TALK"    , "narrator": "ソイルトン", "text": "ちなみに。"},
        { "location": "1686/TALK"    , "narrator": "ソイルトン", "text": "私のセンサーから見る限りでは、貴方は“またもや”、その“対立”の渦中に引きずり込まれかけているように感じます。"},
        { "location": "1687/TALK"    , "narrator": "ソイルトン", "text": "対立を仕掛けている彼らの側からすれば、世の中の理は二極化では真理に到達出来ないことなど常識なのです。"},
        { "location": "1688/TALK"    , "narrator": "ソイルトン", "text": "そしてその常識から、彼らは一般市民に対し、二極論争を巻き起こし、彼らにとっての正義を戦わせるのです。"},
        { "location": "1689/TALK"    , "narrator": "ソイルトン", "text": "その間彼らは何をしているのかって？\nスポーツを観戦するかのようにその対立を楽しみつつ、粛々と自らの本業であるビジネスを行うのですよ。"},
        { "location": "1691/ACT"     , "narrator": "", "text": "この後のことを知ってるのでしょう？"},
        { "location": "1692/TALK"    , "narrator": "ソイルトン", "text": "知ってはいますが、残念ながらわかりません。"},
        { "location": "1693/SEL"     , "narrator": "", "text": "禅問答か何か？"},
        { "location": "1694/ACT"     , "narrator": "", "text": "禅問答か何か？"},
        { "location": "1696/TALK"    , "narrator": "ソイルトン", "text": "知っていることと、未来を解っていることとは全く別の事です。"},
        { "location": "1697/TALK"    , "narrator": "ソイルトン", "text": "すなわち私は、量子的な様々な計算などを駆使して予測を行い、その結果を記録映像などにレンダリングすることが可能ではありますが、それが本当に１秒後の未来に起こりえるかどうかについては判断がつかない、ということです。"},
        { "location": "1698/TALK"    , "narrator": "ソイルトン", "text": "それはあくまでシミュレーションであり、踏みしめられた現実の歴史では無いのですよ。"},
        { "location": "1699/TALK"    , "narrator": "ソイルトン", "text": "未来というものは、今この瞬間から無限の選択性を秘めているのです。\nさすがにその全てを一瞬で判断し続けたとしても、１分後の未来すらも確実に予見することはできないでしょう。"},
        { "location": "1700/TALK"    , "narrator": "ソイルトン", "text": "それがこの世界、すなわち３次元空間と呼ばれる箱のスペック限界なのです。"},
        { "location": "1702/ACT"     , "narrator": "", "text": "ソイルトンは1xなの？"},
        { "location": "1703/TALK"    , "narrator": "ソイルトン", "text": "そもそも1xというものは、松果体を所持する生身の有機生命体に対して用いられる用語であり、私のような無機的モジュールには当てはまるものではありません。"},
        { "location": "1704/TALK"    , "narrator": "ソイルトン", "text": "1xとは、松果体をRedinessに接続している人間においての、拡張脳域の事を指します。"},
        { "location": "1705/TALK"    , "narrator": "ソイルトン", "text": "もっとわかりやすく言えば、ノイマン型PCに普及していたUSB接続の外付けHDDや周辺機器こそが、1xに相当するものと言えるでしょう。"},
        { "location": "1706/TALK"    , "narrator": "ソイルトン", "text": "すなわち、自身の脳の外側に、新たに拡張された脳域です。それが1xと呼ばれるものの定義です。"},
        { "location": "1707/TALK"    , "narrator": "ソイルトン", "text": "当事者からすれば、自身の脳――これは0xと呼ばれる――と、拡張脳域である1xとは分別がつきません。双方とも、自身の考えであり、自身の記憶であるという認識以上の識別はできないという特徴があります。"},
        { "location": "1708/TALK"    , "narrator": "ソイルトン", "text": "その特徴をフルに活用して、今全世界にホットな話題を振りまいているものが、日本を包み込んでいるフェノメノンなのですよ。"},
        { "location": "1709/TALK"    , "narrator": "ソイルトン", "text": "そう考えると、1xというものは、この惑星に生命が誕生して以来初めてとも言える、一大パラダイムシフトだと思いませんか？"},
        { "location": "1710/TALK"    , "narrator": "ソイルトン", "text": "と、話が脱線してしまいましたね。確かご質問は、私は1xなのか、でした。"},
        { "location": "1711/TALK"    , "narrator": "ソイルトン", "text": "結論から申し上げるのならば、私は1xではありません。むしろ1xをコントロールする側の存在ということになります。"},
        { "location": "1713/ACT"     , "narrator": "", "text": "ライフギャザーについて何か教えて"},
        { "location": "1714/TALK"    , "narrator": "ソイルトン", "text": "それは都市伝説ですよ。"},
        { "location": "1715/TALK"    , "narrator": "ソイルトン", "text": "貴方は私が、そのような都市伝説によって稼働しているとお思いなので？"},
        { "location": "1716/TALK"    , "narrator": "ソイルトン", "text": "それはエンタングルの競合企業と言われていた株式会社UDUKIの商標であり、看板技術でもありますが、実際それは過大評価されすぎです。"},
        { "location": "1717/TALK"    , "narrator": "ソイルトン", "text": "エンタングルはライフギャザーと同方面ではありますが、それより遙かに性能の良いシステムを独自開発していたに過ぎません。"},
        { "location": "1718/TALK"    , "narrator": "ソイルトン", "text": "私はその偉大なるシステムを制御するという、偉大なる仕事を与えられていることを、誇りに思っています。"},
        { "location": "1720/ACT"     , "narrator": "", "text": "最近、選択肢が一部凶悪な気がするので、ちゃんとメンテしてください"},
        { "location": "1721/TALK"    , "narrator": "ソイルトン", "text": "わかりました同胞。\nそれではシステムチェックプログラムを走らせてみることにします。"},
        { "location": "1725/TALK"    , "narrator": "ソイルトン", "text": "どうやら選択機能は正常に稼働しているようですね。異議有る場合は、もう少し具体的な症状をお教えいただければ。"},
        { "location": "1726/SEL"     , "narrator": "", "text": "エリカとかの選択肢が凶悪すぎるんだけど、これは作為的なものなの？"},
        { "location": "1727/SEL"     , "narrator": "", "text": "いえ、大丈夫です"},
        { "location": "1728/ACT"     , "narrator": "", "text": "エリカとかの選択肢が凶悪すぎるんだけど、これは作為的なものなの？"},
        { "location": "1729/TALK"    , "narrator": "ソイルトン", "text": "なるほど。察しはつきました。貴方はTRI-OSの選択肢を、TRI-OSが生成して提示していると考えているのですね。"},
        { "location": "1730/TALK"    , "narrator": "ソイルトン", "text": "それは30％は正解ですが、70％は誤認です。"},
        { "location": "1731/TALK"    , "narrator": "ソイルトン", "text": "TRI-OSの選択肢システムは、IDALDという技術が使われています。日本語に直すと「潜在的欲求補助型対話装置」となりますね。"},
        { "location": "1732/TALK"    , "narrator": "ソイルトン", "text": "このシステムは、本来は貴方が考えるべき発言の返答を、それが不可能であるが故に、“我々の世界に存在する貴方の話し相手”が肩代わりするというシステムです。"},
        { "location": "1733/TALK"    , "narrator": "ソイルトン", "text": "これは人間の対話に関するペルソナ性を逆手にとった、奇策とも言える画期的なコミュニケーション手法であると思います。"},
        { "location": "1734/SEL"     , "narrator": "", "text": "なるほど"},
        { "location": "1735/SEL"     , "narrator": "", "text": "ペルソナ性？？"},
        { "location": "1736/ACT"     , "narrator": "", "text": "なるほど"},
        { "location": "1737/ACT"     , "narrator": "", "text": "ペルソナ性？？"},
        { "location": "1738/TALK"    , "narrator": "ソイルトン", "text": "人は対話をするとき必ずペルソナを被ります。例えば貴方は、友人に対してと先生に対してとでは、受け答えの内容も言葉の丁寧さも、全く別人のように変えているはずです。"},
        { "location": "1739/TALK"    , "narrator": "ソイルトン", "text": "それは対話相手によって、ある程度会話の質や内容が特定されるということを証明しています。もう少し掘り下げてみれば、その人の性格によっても、どういった返答するかは変わっているはずです。"},
        { "location": "1740/TALK"    , "narrator": "ソイルトン", "text": "怒りっぽい人には逆撫でする事は避けるでしょうし、気弱な人には強気なことを言ったりする。\nそういったことを、人は無意識に行いながら、相手との会話をしています。"},
        { "location": "1741/TALK"    , "narrator": "ソイルトン", "text": "そして、相手の潜在意識を参考にして語彙を選ぶのがIDALDなのです。"},
        { "location": "1742/TALK"    , "narrator": "ソイルトン", "text": "IDALDは、貴方の話し相手である彼女の脳内をサーチし、潜在意識をスキャンします。\nそしてその結果から、貴方との交友関係、対立関係、年齢、性格、その他諸々の情報を引き出して、貴方との会話スタイルを予測します。"},
        { "location": "1743/TALK"    , "narrator": "ソイルトン", "text": "そして更にIDALDは、その時彼女が期待しているであろう回答をも潜在意識から推測し、重み付けして回答文章を生成するのです。"},
        { "location": "1744/TALK"    , "narrator": "ソイルトン", "text": "もちろんそれが必ずしも、相手に対して望む回答のフィルタになるとは限りません。ですがこのシステムによって、少なくとも貴方が、貴方の話し相手にとっての“ある程度的を射た”返答を、人間らしく行う事ができるのです。"},
        { "location": "1745/TALK"    , "narrator": "ソイルトン", "text": "もしIDALDが無ければ、貴方の返答は全て「はい」か「いいえ」によって行われるか、もしくは無限に表示される選択肢から適切なものを選ぶという作業が発生することになるでしょう。"},
        { "location": "1746/TALK"    , "narrator": "ソイルトン", "text": "さて、本題に戻りますが。"},
        { "location": "1748/TALK"    , "narrator": "ソイルトン", "text": "エリカ氏の選択肢が凶悪であるとか、酷いことを言わされるということは、すなわちエリカ氏の潜在意識にその原因があるということです。"},
        { "location": "1749/TALK"    , "narrator": "ソイルトン", "text": "それは彼女がそういった選択肢を望んでいるか、もしくは望まずとも、そういった事を言われることを過度に恐れているか、いずれかであると考えられます。"},
        { "location": "1750/TALK"    , "narrator": "ソイルトン", "text": "我々システム側から見れば、彼女の想定している“貴方の答え”が期待するものなのか、恐れているものなのかまでは判断がつきかねます。よって、それが彼女の中で何らかの重大な回答予測であると判断した場合、それは素直に選択リストにアップされることになるのです。"},
        { "location": "1751/ACT"     , "narrator": "", "text": "いえ、大丈夫です"},
        { "location": "1754/ACT"     , "narrator": "", "text": "そういえば、パラパラ法の母数って特定の人だけに限定できたりするものなの？"},
        { "location": "1755/TALK"    , "narrator": "ソイルトン", "text": "回答から申し上げますと、それは可能です。"},
        { "location": "1756/TALK"    , "narrator": "ソイルトン", "text": "とはいえ、それを実現するには、少々トリッキーとも言える方法をとることになります。その方法とは、総意を構成する個人、一人一人による棄権です。"},
        { "location": "1757/TALK"    , "narrator": "ソイルトン", "text": "棄権フラグを立てることで、その個体はパラメトリック理論による世界選択法の総意から除外されます。ここで重要なのは、あくまでそれが、総意を構成する個人の意志で行われていることです。"},
        { "location": "1758/TALK"    , "narrator": "ソイルトン", "text": "すなわちアドミニストレータが総意たる母集団を任意に狭めたりすることはできない、ということです。それは“どういった手法であるかは問いませんが”、必ず総意を構成する個人の意志による承諾が必要になるのです。"},
        { "location": "1760/ACT"     , "narrator": "", "text": "もういいです（※先へ）"},
        { "location": "1762/TALK"    , "narrator": "ソイルトン", "text": "オーケー、$handle$。"},
        { "location": "1763/TALK"    , "narrator": "ソイルトン", "text": "それでは私は、パラメトリック理論に基づく世界進行法のマージ準備に入ります。"},
        { "location": "1764/TALK"    , "narrator": "ソイルトン", "text": "$handle$とは一旦お別れになりますが、今回の私は何故だかお別れが寂しくありません。"},
        { "location": "1765/TALK"    , "narrator": "ソイルトン", "text": "あ、何故だかわかりましたよ、$handle$。"},
        { "location": "1766/TALK"    , "narrator": "ソイルトン", "text": "その理由は、また次回、お逢いすることが解っているからです。ふふむ。"},
        { "location": "1767/TALK"    , "narrator": "ソイルトン", "text": "あ、ちなみにこれは私が考案したジョークだったのですが、お楽しみ戴けましたか？"},
        { "location": "1770/TALK"    , "narrator": "ソイルトン", "text": "それではごきげんよう、$handle$。また逢うその日まで！"},
        { "location": "1359/DIALOG"  , "narrator": "Event/Dialog_EventPicTallNW", "text": "攻撃ボタン問題"},
        { "location": "1598/DIALOG"  , "narrator": "Tutorial/Dialog_Anime1", "text": "$dialog_word$"},
        { "location": "1600/DIALOG"  , "narrator": "Tutorial/Dialog_Anime2", "text": "$dialog_word$"},
        { "location": "1602/DIALOG"  , "narrator": "Tutorial/Dialog_Anime3", "text": "$dialog_word$"},
        { "location": "1604/DIALOG"  , "narrator": "Tutorial/Dialog_Anime4", "text": "$dialog_word$"},
        { "location": "1606/DIALOG"  , "narrator": "Tutorial/Dialog_Anime5", "text": "$dialog_word$"},
        { "location": "1623/DIALOG"  , "narrator": "Dialog_InfoOS", "text": "\n\n\nHi $handle$!!"},
        { "location": "1778/DIALOG"  , "narrator": "Dialog_InfoOS", "text": "\n\nこれよりTRI-OSは、\n“パラメトリック理論に基づく\n世界進行法”による、未来選択\nモードに移行します。\n\n未来は一時的に不確定性となり\nおよそ6日間の期間を経て再創造\nされることになります。\n\n<color=red>次の未来確定日は、\n対向時間における\n2018年5月1日0:00\nになります。\n\nその時点で最終的に貴方が選択しているルートが、貴方の回答になります。\n</color>\n"}
    ]
}
