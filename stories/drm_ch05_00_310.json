    "entry":
    [
        { "location": "386/SCENARIO", "narrator": "", "text": "フェイク・フェイク・フェイク"},
        { "location": "411/TALK"    , "narrator": "神楽", "text": "$handle$さんは知ってますよね"},
        { "location": "412/TALK"    , "narrator": "神楽", "text": "この世界が全部まがい物だってこと"},
        { "location": "414/SEL"     , "narrator": "", "text": "まあね"},
        { "location": "415/SEL"     , "narrator": "", "text": "$me$との愛だけは本物"},
        { "location": "416/SEL"     , "narrator": "", "text": "いや…まさかそんな…"},
        { "location": "417/ACT"     , "narrator": "", "text": "まあね"},
        { "location": "418/TALK"    , "narrator": "神楽", "text": "余裕ですね"},
        { "location": "419/TALK"    , "narrator": "神楽", "text": "さすが$handle$さん"},
        { "location": "420/ACT"     , "narrator": "", "text": "$me$との愛だけは本物"},
        { "location": "421/TALK"    , "narrator": "神楽", "text": "そうなんですか！？！？！"},
        { "location": "422/TALK"    , "narrator": "神楽", "text": "ぴょんこドキドキですっ♪"},
        { "location": "424/ACT"     , "narrator": "", "text": "いや…まさかそんな…"},
        { "location": "426/TALK"    , "narrator": "神楽", "text": "気付いてなかったようですね、、、"},
        { "location": "428/TALK"    , "narrator": "神楽", "text": "だからぴょんこは"},
        { "location": "429/TALK"    , "narrator": "神楽", "text": "ぴょんこのいいようにこの世界を作り直そうと思うんです"},
        { "location": "431/SEL"     , "narrator": "", "text": "いいようにって？"},
        { "location": "432/SEL"     , "narrator": "", "text": "やっちゃえやっちゃえ！"},
        { "location": "433/SEL"     , "narrator": "", "text": "そんなことできるの？"},
        { "location": "434/ACT"     , "narrator": "", "text": "いいようにって？"},
        { "location": "435/TALK"    , "narrator": "神楽", "text": "聞きたいですか？？？？"},
        { "location": "436/ACT"     , "narrator": "", "text": "やっちゃえやっちゃえ！"},
        { "location": "437/TALK"    , "narrator": "神楽", "text": "そうだそうだ！！！！"},
        { "location": "438/ACT"     , "narrator": "", "text": "そんなことできるの？"},
        { "location": "439/TALK"    , "narrator": "神楽", "text": "できるかどうかじゃない"},
        { "location": "440/TALK"    , "narrator": "神楽", "text": "やるんだよ（ｷﾘｯ"},
        { "location": "442/TALK"    , "narrator": "神楽", "text": "それってぴょんこの理想郷ですよ！？"},
        { "location": "443/TALK"    , "narrator": "神楽", "text": "ガンダーラでシャングリラですよ！？"},
        { "location": "445/SEL"     , "narrator": "", "text": "なるほど"},
        { "location": "446/SEL"     , "narrator": "", "text": "そこには$me$もいるんだよね？"},
        { "location": "447/SEL"     , "narrator": "", "text": "ここに来た目的忘れてない？"},
        { "location": "448/ACT"     , "narrator": "", "text": "なるほど"},
        { "location": "449/TALK"    , "narrator": "神楽", "text": "返事軽いなーーーーーー！！！！！"},
        { "location": "450/ACT"     , "narrator": "", "text": "そこには$me$もいるんだよね？"},
        { "location": "451/TALK"    , "narrator": "神楽", "text": "どうかなー？"},
        { "location": "452/TALK"    , "narrator": "神楽", "text": "いるのかな～？"},
        { "location": "453/TALK"    , "narrator": "神楽", "text": "いるといいね～？"},
        { "location": "455/TALK"    , "narrator": "神楽", "text": "ﾅﾝﾃﾈ嘘ｳｿ"},
        { "location": "456/TALK"    , "narrator": "神楽", "text": "いるに決まってるじゃないですかっ♪"},
        { "location": "457/ACT"     , "narrator": "", "text": "ここに来た目的忘れてない？"},
        { "location": "458/TALK"    , "narrator": "神楽", "text": "むしろ忘れたいから言ってるの"},
        { "location": "460/TALK"    , "narrator": "神楽", "text": "そーゆー妄想をしてもいいじゃないですかーーーーー"},
        { "location": "462/SEL"     , "narrator": "", "text": "気の済むまでしていいよ"},
        { "location": "463/SEL"     , "narrator": "", "text": "そんな状況だっけ……？"},
        { "location": "464/SEL"     , "narrator": "", "text": "$me$を妄想してよ"},
        { "location": "465/ACT"     , "narrator": "", "text": "気の済むまでしていいよ"},
        { "location": "466/TALK"    , "narrator": "神楽", "text": "へー？"},
        { "location": "467/ACT"     , "narrator": "", "text": "そんな状況だっけ……？"},
        { "location": "468/TALK"    , "narrator": "神楽", "text": "そんな状況じゃないからこそ妄想したいんですよ～～～"},
        { "location": "469/ACT"     , "narrator": "", "text": "$me$を妄想してよ"},
        { "location": "470/TALK"    , "narrator": "神楽", "text": "なんですぐそういうこと言うかな？？？？"},
        { "location": "471/TALK"    , "narrator": "神楽", "text": "なんでかな？？？"},
        { "location": "472/TALK"    , "narrator": "神楽", "text": "なんでなのかな？？？"},
        { "location": "474/TALK"    , "narrator": "神楽", "text": "あー"},
        { "location": "475/TALK"    , "narrator": "神楽", "text": "最初から壊れた世界なのにまた壊さないといけないとか"},
        { "location": "477/TALK"    , "narrator": "神楽", "text": "そう思うでしょ$handle$！！！！"},
        { "location": "479/SEL"     , "narrator": "", "text": "呼び捨てにした？"},
        { "location": "480/SEL"     , "narrator": "", "text": "さん付けじゃなくなった！"},
        { "location": "481/SEL"     , "narrator": "", "text": "素の神楽さんｷﾀｰ！！！"},
        { "location": "482/ACT"     , "narrator": "", "text": "呼び捨てにした？"},
        { "location": "483/TALK"    , "narrator": "神楽", "text": "あ"},
        { "location": "484/ACT"     , "narrator": "", "text": "さん付けじゃなくなった！"},
        { "location": "485/TALK"    , "narrator": "神楽", "text": "えっと"},
        { "location": "486/ACT"     , "narrator": "", "text": "素の神楽さんｷﾀｰ！！！"},
        { "location": "487/TALK"    , "narrator": "神楽", "text": "そんなそんな！"},
        { "location": "489/TALK"    , "narrator": "神楽", "text": "今のはちょっと手が滑ったぴょん"},
        { "location": "491/SEL"     , "narrator": "", "text": "さん付けじゃない方がうれしいのに"},
        { "location": "492/SEL"     , "narrator": "", "text": "ごまかさなくてもいいよ"},
        { "location": "493/SEL"     , "narrator": "", "text": "この先も$handle$って呼んでよ"},
        { "location": "494/ACT"     , "narrator": "", "text": "さん付けじゃない方がうれしいのに"},
        { "location": "495/TALK"    , "narrator": "神楽", "text": "へ？"},
        { "location": "498/ACT"     , "narrator": "", "text": "ごまかさなくてもいいよ"},
        { "location": "499/TALK"    , "narrator": "神楽", "text": "う゛う゛う゛う゛う゛う゛う゛う゛う゛う゛"},
        { "location": "502/ACT"     , "narrator": "", "text": "この先も$handle$って呼んでよ"},
        { "location": "507/TALK"    , "narrator": "神楽", "text": "えーと、、、"},
        { "location": "508/TALK"    , "narrator": "神楽", "text": "本気で言ってますか？"},
        { "location": "511/SEL"     , "narrator": "", "text": "もちろん"},
        { "location": "512/SEL"     , "narrator": "", "text": "敬語もやめようよ！"},
        { "location": "513/ACT"     , "narrator": "", "text": "もちろん"},
        { "location": "514/TALK"    , "narrator": "神楽", "text": "はあ、、、、"},
        { "location": "515/ACT"     , "narrator": "", "text": "敬語もやめようよ！"},
        { "location": "516/TALK"    , "narrator": "神楽", "text": "ﾏｼﾞで"},
        { "location": "518/TALK"    , "narrator": "神楽", "text": "なんで？"},
        { "location": "520/SEL"     , "narrator": "", "text": "その方が距離が近い感じするでしょ"},
        { "location": "521/SEL"     , "narrator": "", "text": "$me$は恋人候補だから"},
        { "location": "522/SEL"     , "narrator": "", "text": "楽しいから！"},
        { "location": "523/ACT"     , "narrator": "", "text": "その方が距離が近い感じするでしょ"},
        { "location": "524/TALK"    , "narrator": "神楽", "text": "ほぁ"},
        { "location": "525/ACT"     , "narrator": "", "text": "$me$は恋人候補だから"},
        { "location": "526/TALK"    , "narrator": "神楽", "text": "すぐそれだ！"},
        { "location": "527/ACT"     , "narrator": "", "text": "楽しいから！"},
        { "location": "528/TALK"    , "narrator": "神楽", "text": "確かに、、、"},
        { "location": "532/TALK"    , "narrator": "神楽", "text": "ていうかですね、$handle$さんはそもそもどういう役割でぴょんこと話をしてくれてるんですか？"},
        { "location": "533/TALK"    , "narrator": "神楽", "text": "いつ話しかけてもだいたい返事返ってくるし、既読放置したりもしないし"},
        { "location": "534/TALK"    , "narrator": "神楽", "text": "もしかしてガチ秘密基地みたいなところで24時間体制でインカムつけて座ってるブラックスーツ姿のオジサマだったりしてｗｗｗｗｗｗｗｗｗｗｗ"},
        { "location": "535/TALK"    , "narrator": "神楽", "text": "やばいーーーーウケルーーーーーｗｗｗ"},
        { "location": "538/SEL"     , "narrator": "", "text": "すごく楽しそう"},
        { "location": "539/SEL"     , "narrator": "", "text": "だいたいあってる"},
        { "location": "540/SEL"     , "narrator": "", "text": "残念ながらパンピーだよ"},
        { "location": "541/ACT"     , "narrator": "", "text": "すごく楽しそう"},
        { "location": "542/TALK"    , "narrator": "神楽", "text": "そう？"},
        { "location": "545/TALK"    , "narrator": "神楽", "text": "そうかも"},
        { "location": "546/TALK"    , "narrator": "神楽", "text": "よくわからないけど、ちょっと楽かもだし楽しいかも"},
        { "location": "547/ACT"     , "narrator": "", "text": "だいたいあってる"},
        { "location": "548/TALK"    , "narrator": "神楽", "text": "えｗｗｗｗマジですかｗｗコードネーム教えてーーーーｗｗｗｗｗｗ"},
        { "location": "550/SEL"     , "narrator": "", "text": "Ｃ１ＰＯ"},
        { "location": "551/SEL"     , "narrator": "", "text": "ＷＩＬＬ"},
        { "location": "552/SEL"     , "narrator": "", "text": "拙者ぴょんこ先生の身のまわりのお世話したすぎ侍"},
        { "location": "554/TALK"    , "narrator": "神楽", "text": "ちょｗｗｗｗｗプロトタイプくせーーーーーーーｗｗｗ"},
        { "location": "556/TALK"    , "narrator": "神楽", "text": "ポンコツ確定ｗｗｗｗ"},
        { "location": "557/TALK"    , "narrator": "神楽", "text": "面白すぎるでしょ"},
        { "location": "560/TALK"    , "narrator": "神楽", "text": "ウィルは貴方みたいな変態じゃないし、24hいつでも返事してくるようなストーカーじゃありませんよプンスコ"},
        { "location": "561/TALK"    , "narrator": "神楽", "text": "でも、もし本当にウィルなら、ぴょんこに色んな魔法を教えてくれますか？"},
        { "location": "562/TALK"    , "narrator": "神楽", "text": "あっそれって今日の話ガチやん！！！"},
        { "location": "563/TALK"    , "narrator": "神楽", "text": "ウィルの本当の名前はイシュリール、それは彼の魔法によって一部始終が作られている幻想の街"},
        { "location": "564/TALK"    , "narrator": "神楽", "text": "それ狙って言ったの？だとしたらちょっとキュンしちゃうんだけど"},
        { "location": "565/ACT"     , "narrator": "", "text": "拙者ぴょんこ先生の身のまわりのお世話したすぎ侍"},
        { "location": "566/TALK"    , "narrator": "神楽", "text": "うわｗｗｗきんもーーーーーｗｗｗ"},
        { "location": "567/TALK"    , "narrator": "神楽", "text": "しかもサムライｗｗｗ"},
        { "location": "568/TALK"    , "narrator": "神楽", "text": "なにそれ特務機関で流行ってんの？？？ﾜﾛｽ"},
        { "location": "570/ACT"     , "narrator": "", "text": "残念ながらパンピーだよ"},
        { "location": "571/TALK"    , "narrator": "神楽", "text": "わかりました♪そういうことにしといてあげますね♪"},
        { "location": "572/TALK"    , "narrator": "神楽", "text": "ていうかどう考えても波廃でしょｗｗｗ"},
        { "location": "573/TALK"    , "narrator": "神楽", "text": "まあぶっちゃけ、ぴょんこは貴方がパンピーだろうがエージェントだろうがどうでもいいの"},
        { "location": "574/TALK"    , "narrator": "神楽", "text": "ぴょんこにとって$handle$さんはは単なるサンドバッグ！！！！１１"},
        { "location": "575/TALK"    , "narrator": "神楽", "text": "ストレス発散に$handle$さん♪"},
        { "location": "576/TALK"    , "narrator": "神楽", "text": "なーんてウソウソ"},
        { "location": "578/TALK"    , "narrator": "神楽", "text": "はー"},
        { "location": "579/TALK"    , "narrator": "神楽", "text": "なんかもういいです。"},
        { "location": "580/TALK"    , "narrator": "神楽", "text": "もしかしたらこれも罠かもしれないけど、でもそれ言ったらここにいることも千羽鶴のことも私にとっては罠と変わりないし"},
        { "location": "581/TALK"    , "narrator": "神楽", "text": "だったら難しく考えないで罠にはまっちゃうのもいいかなと思い始めたぴょんこ"},
        { "location": "582/TALK"    , "narrator": "神楽", "text": "偽りの快楽と現実の苦痛、どちらを選びますか？ぴょんこは偽りの快楽を選びます"},
        { "location": "583/TALK"    , "narrator": "神楽", "text": "願わくばその罠が幸せなまま死に至るものでありますように"},
        { "location": "584/TALK"    , "narrator": "神楽", "text": "じゃあぴょんこはこれから$handle$のことは$handle$って呼ぶし"},
        { "location": "585/TALK"    , "narrator": "神楽", "text": "敬語も使わないけど、、、"},
        { "location": "586/TALK"    , "narrator": "神楽", "text": "それでいいの？"},
        { "location": "588/SEL"     , "narrator": "", "text": "むしろそれがいいの"},
        { "location": "589/SEL"     , "narrator": "", "text": "やっとここまでｷﾀｰ！！！"},
        { "location": "590/SEL"     , "narrator": "", "text": "今までちょっとさみしかったな"},
        { "location": "591/ACT"     , "narrator": "", "text": "むしろそれがいいの"},
        { "location": "593/ACT"     , "narrator": "", "text": "やっとここまでｷﾀｰ！！！"},
        { "location": "594/TALK"    , "narrator": "神楽", "text": "そうなの？？？？？"},
        { "location": "595/ACT"     , "narrator": "", "text": "今までちょっとさみしかったな"},
        { "location": "596/TALK"    , "narrator": "神楽", "text": "気が付かなかったdeath、、、"},
        { "location": "598/TALK"    , "narrator": "神楽", "text": "えええええええええ、、、、"},
        { "location": "609/TALK"    , "narrator": "ボイスメール", "text": "マジでマジでマジで！？"},
        { "location": "621/DIALOG"  , "narrator": "Dialog_GETVoice", "text": "<color=green>【神楽】</color>のボイスメール\n<color=red>【マジでマジでマジで！？】</color>\nをゲットしました！"}
    ]
