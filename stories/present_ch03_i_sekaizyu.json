        { "location": "695/TALK", "narrator": "ガブリエラ", "text": "え？"},
        { "location": "696/TALK", "narrator": "ガブリエラ", "text": "世界樹と不思議のダンジョン２？"},
        { "location": "697/TALK", "narrator": "ガブリエラ", "text": "２が出るなんて聞いたことないけど"},
        { "location": "698/TALK", "narrator": "ガブリエラ", "text": "偽物？"},
        { "location": "700/SEL" , "narrator": "", "text": "実はこれ、本物なんだ"},
        { "location": "701/ACT" , "narrator": "", "text": "実はこれ、本物なんだ"},
        { "location": "703/TALK", "narrator": "ガブリエラ", "text": "本物！？"},
        { "location": "704/TALK", "narrator": "ガブリエラ", "text": "こんなのもらっていいの！？"},
        { "location": "705/TALK", "narrator": "ガブリエラ", "text": "嬉しいけど"},
        { "location": "706/TALK", "narrator": "ガブリエラ", "text": "発売も発表もされてないのに"},
        { "location": "707/TALK", "narrator": "ガブリエラ", "text": "大丈夫なの！？"},
        { "location": "709/SEL" , "narrator": "", "text": "正規に手に入れたものだからね"},
        { "location": "710/ACT" , "narrator": "", "text": "正規に手に入れたものだからね"},
        { "location": "712/TALK", "narrator": "ガブリエラ", "text": "マルザンナって"},
        { "location": "713/TALK", "narrator": "ガブリエラ", "text": "スゴい人脈を持ってるのね"},
        { "location": "715/SEL" , "narrator": "", "text": "気にしないで楽しんで"},
        { "location": "716/ACT" , "narrator": "", "text": "気にしないで楽しんで"},
        { "location": "718/TALK", "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "719/TALK", "narrator": "ガブリエラ", "text": "せっかくマルザンナが手に入れてきたくれたんだもの"},
        { "location": "720/TALK", "narrator": "ガブリエラ", "text": "楽しませてもらうわ"},
        { "location": "721/TALK", "narrator": "ガブリエラ", "text": "ありがと"}
