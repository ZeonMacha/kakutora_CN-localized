        { "location": "7/SCENARIO", "narrator": "", "text": "畳水練準4級"},
        { "location": "34/TALK"   , "narrator": "つばめ", "text": "体が痛ぃょ"},
        { "location": "35/TALK"   , "narrator": "つばめ", "text": "日焼けと"},
