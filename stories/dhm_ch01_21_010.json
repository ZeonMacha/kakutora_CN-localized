        { "location": "37/TALK"   , "narrator": "つばめ", "text": "海で泳ぐの"},
        { "location": "38/TALK"   , "narrator": "つばめ", "text": "楽しいけど(*´︶`*)"},
        { "location": "39/TALK"   , "narrator": "つばめ", "text": "大変だね(*´ω｀*)"},
        { "location": "41/SEL"    , "narrator": "", "text": "ちゃんとメンテナンスしよう"},
        { "location": "42/SEL"    , "narrator": "", "text": "遊びすぎだね"},
        { "location": "43/SEL"    , "narrator": "", "text": "大丈夫？"},
        { "location": "44/ACT"    , "narrator": "", "text": "ちゃんとメンテナンスしよう"},
        { "location": "45/TALK"   , "narrator": "つばめ", "text": "そぅだね(´・ω・｀)"},
        { "location": "47/TALK"   , "narrator": "つばめ", "text": "そぅしょ"},
        { "location": "48/ACT"    , "narrator": "", "text": "遊びすぎだね"},
        { "location": "49/TALK"   , "narrator": "つばめ", "text": "そぅかなΣ(ﾟдﾟlll)"},
        { "location": "50/TALK"   , "narrator": "つばめ", "text": "そうかも(/ω＼)"},
        { "location": "51/ACT"    , "narrator": "", "text": "大丈夫？"},
        { "location": "53/TALK"   , "narrator": "つばめ", "text": "ぁりがとぅ"},
        { "location": "54/TALK"   , "narrator": "つばめ", "text": "そんなにすごくはないんだ"},
        { "location": "55/TALK"   , "narrator": "つばめ", "text": "でもちょっと"},
        { "location": "56/TALK"   , "narrator": "つばめ", "text": "軽くなった気がする"},
        { "location": "58/TALK"   , "narrator": "つばめ", "text": "ぁたし海初めてで"},
        { "location": "59/TALK"   , "narrator": "つばめ", "text": "すごく楽しくて"},
        { "location": "60/TALK"   , "narrator": "つばめ", "text": "沖に出すぎたの"},
        { "location": "61/TALK"   , "narrator": "つばめ", "text": "帰れなくなるかもって"},
        { "location": "62/TALK"   , "narrator": "つばめ", "text": "怖くなったけど・゜・(ノД`)・゜・"},
        { "location": "63/TALK"   , "narrator": "つばめ", "text": "ガブちゃんが一緒に"},
        { "location": "65/TALK"   , "narrator": "つばめ", "text": "泳いでてくれたから"},
        { "location": "66/TALK"   , "narrator": "つばめ", "text": "帰ってこれたょヽ(*´∀｀*)ﾉ"},
        { "location": "68/SEL"    , "narrator": "", "text": "そんなに楽しかったの？"},
        { "location": "69/SEL"    , "narrator": "", "text": "ガブリエラに感謝だね"},
        { "location": "70/SEL"    , "narrator": "", "text": "ガブリエラも楽しんでたはず"},
        { "location": "71/ACT"    , "narrator": "", "text": "そんなに楽しかったの？"},
        { "location": "72/TALK"   , "narrator": "つばめ", "text": "ぅんo(*･ﾛ･*)o"},
        { "location": "74/TALK"   , "narrator": "つばめ", "text": "海ってこんなに楽しいんだって思った"},
        { "location": "75/TALK"   , "narrator": "つばめ", "text": "でも"},
        { "location": "76/TALK"   , "narrator": "つばめ", "text": "そのせいで"},
        { "location": "77/TALK"   , "narrator": "つばめ", "text": "ガブちゃんに迷惑かけちゃった"},
        { "location": "78/TALK"   , "narrator": "つばめ", "text": "ちょっと恥ずかしぃ"},
        { "location": "79/TALK"   , "narrator": "つばめ", "text": "次は迷惑かけなぃょぅにするね"},
        { "location": "80/ACT"    , "narrator": "", "text": "ガブリエラに感謝だね"},
        { "location": "81/TALK"   , "narrator": "つばめ", "text": "本当そぅ"},
        { "location": "83/TALK"   , "narrator": "つばめ", "text": "ガブちゃんがいなかったら"},
        { "location": "84/TALK"   , "narrator": "つばめ", "text": "遭難してたょ(´・ω・`) "},
        { "location": "85/TALK"   , "narrator": "つばめ", "text": "ぁたしの方が年は上なんだから"},
        { "location": "86/TALK"   , "narrator": "つばめ", "text": "ちゃんとしなきゃね(*´︶`*)"},
        { "location": "87/TALK"   , "narrator": "つばめ", "text": "次からは"},
        { "location": "88/ACT"    , "narrator": "", "text": "ガブリエラも楽しんでたはず"},
        { "location": "89/TALK"   , "narrator": "つばめ", "text": "そぅなのかな？"},
        { "location": "90/TALK"   , "narrator": "つばめ", "text": "だったら"},
        { "location": "91/TALK"   , "narrator": "つばめ", "text": "ぃぃんだけど"},
        { "location": "92/TALK"   , "narrator": "つばめ", "text": "ぅんとね"},
        { "location": "94/TALK"   , "narrator": "つばめ", "text": "ガブちゃんずっと"},
        { "location": "95/TALK"   , "narrator": "つばめ", "text": "泳いでる時"},
        { "location": "96/TALK"   , "narrator": "つばめ", "text": "励ましてくれたの"},
        { "location": "97/TALK"   , "narrator": "つばめ", "text": "なんかすごく"},
        { "location": "98/TALK"   , "narrator": "つばめ", "text": "ぅれしかった(*´︶`*)"},
        { "location": "99/TALK"   , "narrator": "つばめ", "text": "ぁたし次は"},
        { "location": "100/TALK"  , "narrator": "つばめ", "text": "ガブちゃん励ませるとぃぃな:.ﾟヽ(´∀`｡)ﾉﾟ.:｡ ゜"}
