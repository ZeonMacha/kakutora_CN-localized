        { "location": "1053/TALK"  , "narrator": "みやび", "text": "その自己満足を極めたい"},
        { "location": "1054/TALK"  , "narrator": "みやび", "text": "そういう気分やきね"},
        { "location": "1056/SEL"   , "narrator": "", "text": "美味しいものを食べさせたいよね"},
        { "location": "1057/SEL"   , "narrator": "", "text": "$me$も食べたいよ"},
        { "location": "1058/SEL"   , "narrator": "", "text": "みんな楽しみにしてるよ"},
        { "location": "1059/ACT"   , "narrator": "", "text": "美味しいものを食べさせたいよね"},
        { "location": "1060/TALK"  , "narrator": "みやび", "text": "わかるか？"},
        { "location": "1061/ACT"   , "narrator": "", "text": "$me$も食べたいよ"},
        { "location": "1062/TALK"  , "narrator": "みやび", "text": "いつか絶対に実現させよう"},
        { "location": "1063/ACT"   , "narrator": "", "text": "みんな楽しみにしてるよ"},
        { "location": "1064/TALK"  , "narrator": "みやび", "text": "そうに決まっておる"},
        { "location": "1076/TALK"  , "narrator": "みやび", "text": "待たせたな。"},
        { "location": "1077/TALK"  , "narrator": "みやび", "text": "さてクイズ。\nみやびさんは何を\n作るつもりでしょう。"},
        { "location": "1078/TALK"  , "narrator": "神楽", "text": "刺身は絶対に\nありますよね。"},
        { "location": "1079/TALK"  , "narrator": "アーヤ", "text": "そうよね。\n柵でマグロを\n買ってたもの。"},
        { "location": "1080/TALK"  , "narrator": "神楽", "text": "後はなんでしょう？\nうーん……。"},
        { "location": "1081/TALK"  , "narrator": "みやび", "text": "まずいものは\n出さんきね。\n期待しちょって。"},
        { "location": "1082/TALK"  , "narrator": "アーヤ", "text": "それは絶対。\n楽しみにしてるわ。"},
        { "location": "1083/TALK"  , "narrator": "神楽", "text": "私もです！"},
        { "location": "1084/TALK"  , "narrator": "みやび", "text": "よしよし。"},
        { "location": "1085/TALK"  , "narrator": "みやび", "text": "二人は運動もしちょるし。\n特に美味しく\n感じるろうね。"},
        { "location": "1086/TALK"  , "narrator": "アーヤ", "text": "そこなの！？"},
        { "location": "1087/TALK"  , "narrator": "神楽", "text": "またまた、もう！"},
        { "location": "1088/TALK"  , "narrator": "みやび", "text": "あはははは。"},
        { "location": "1089/ACT"   , "narrator": "", "text": "アーヤに声を掛ける"},
        { "location": "1090/TALK"  , "narrator": "みやび", "text": "アーヤのスマホ\n鳴らんかった？"},
        { "location": "1091/TALK"  , "narrator": "アーヤ", "text": "後でいいわよ。"},
        { "location": "1092/TALK"  , "narrator": "みやび", "text": "まあそう言わず。\n急用かもしれんし。"},
        { "location": "1093/TALK"  , "narrator": "アーヤ", "text": "……。"},
        { "location": "1094/TALK"  , "narrator": "アーヤ", "text": "じゃあちょっと\n出るわね。"},
        { "location": "1106/SEL"   , "narrator": "", "text": "車で運べばいいのに"},
        { "location": "1107/ACT"   , "narrator": "", "text": "車で運べばいいのに"},
