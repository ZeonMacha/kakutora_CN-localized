        { "location": "1034/TALK"  , "narrator": "みやび", "text": "そうでもない"},
        { "location": "1035/ACT"   , "narrator": "", "text": "手伝っていい？"},
        { "location": "1036/TALK"  , "narrator": "みやび", "text": "弟子は募集しとらん"},
        { "location": "1037/TALK"  , "narrator": "みやび", "text": "そもそも$handle$は相棒やき"},
        { "location": "1039/TALK"  , "narrator": "みやび", "text": "料理の出来を決めるのは"},
        { "location": "1040/TALK"  , "narrator": "みやび", "text": "食材と仕込みぞね"},
        { "location": "1042/SEL"   , "narrator": "", "text": "なんか本格的"},
        { "location": "1043/SEL"   , "narrator": "", "text": "家庭料理だから適当でも"},
        { "location": "1044/SEL"   , "narrator": "", "text": "ますます食べてみたい"},
        { "location": "1045/ACT"   , "narrator": "", "text": "なんか本格的"},
        { "location": "1046/TALK"  , "narrator": "みやび", "text": "当然"},
        { "location": "1047/ACT"   , "narrator": "", "text": "家庭料理だから適当でも"},
        { "location": "1048/TALK"  , "narrator": "みやび", "text": "そうはいかん"},
        { "location": "1049/ACT"   , "narrator": "", "text": "ますます食べてみたい"},
        { "location": "1050/TALK"  , "narrator": "みやび", "text": "だろう（ドヤ顔で"},
