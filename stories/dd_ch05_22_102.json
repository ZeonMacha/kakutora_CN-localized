        { "location": "1187/TALK"  , "narrator": "アーヤ", "text": "本当に\n調子がいいんだから\nもう……。"},
        { "location": "1219/SEL"   , "narrator": "", "text": "千羽鶴はウソをついた、契約違反だ"},
        { "location": "1220/ACT"   , "narrator": "", "text": "千羽鶴はウソをついた、契約違反だ"},
        { "location": "1222/TALK"  , "narrator": "神楽", "text": "契約"},
        { "location": "1225/TALK"  , "narrator": "神楽", "text": "そうだ"},
        { "location": "1246/TALK"  , "narrator": "千羽鶴", "text": "私は、皇千羽鶴。\n逢瀬つばめではない。"},
        { "location": "1247/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1248/TALK"  , "narrator": "千羽鶴", "text": "…………。"},
        { "location": "1249/TALK"  , "narrator": "神楽", "text": "…わかりました。\n変なことを聞いて\nすみません。"},
        { "location": "1250/TALK"  , "narrator": "千羽鶴", "text": "わかってくれたなら\nそれでいい。"},
        { "location": "1251/TALK"  , "narrator": "神楽", "text": "はい…、\nよくわかりました。"},
        { "location": "1252/TALK"  , "narrator": "神楽", "text": "あなたがウソつきだ\nっていうのがね…。"},
        { "location": "1256/TALK"  , "narrator": "神楽", "text": "…すみません。\nどちら様ですか？"},
        { "location": "1257/TALK"  , "narrator": "千羽鶴", "text": "私は…、この世界で\nフェノメノンを対処する\n組織…。"},
        { "location": "1258/TALK"  , "narrator": "千羽鶴", "text": "情報管理庁に所属する\nエージェント。"},
        { "location": "1259/TALK"  , "narrator": "神楽", "text": "管理庁…エージェント？"},
        { "location": "1286/TALK"  , "narrator": "神楽", "text": "皇千羽鶴は契約に違反した"},
        { "location": "1287/TALK"  , "narrator": "神楽", "text": "けど"},
        { "location": "1288/TALK"  , "narrator": "神楽", "text": "だからって今の私にはどうすることもできません、、、"},
        { "location": "1290/SEL"   , "narrator": "", "text": "$me$に考えがあるから安心して"},
        { "location": "1291/ACT"   , "narrator": "", "text": "$me$に考えがあるから安心して"},
        { "location": "1293/TALK"  , "narrator": "神楽", "text": "考え？"},
        { "location": "1294/TALK"  , "narrator": "神楽", "text": "なにをするつもりですか？"},
        { "location": "1296/SEL"   , "narrator": "", "text": "神楽はつばめを壊さなくていいんだよ"},
        { "location": "1297/ACT"   , "narrator": "", "text": "神楽はつばめを壊さなくていいんだよ"},
        { "location": "1299/TALK"  , "narrator": "神楽", "text": "でも"},
        { "location": "1300/TALK"  , "narrator": "神楽", "text": "壊すって契約だから"},
        { "location": "1303/SEL"   , "narrator": "", "text": "先に契約を破ったのは千羽鶴だ"},
        { "location": "1304/ACT"   , "narrator": "", "text": "先に契約を破ったのは千羽鶴だ"},
        { "location": "1306/TALK"  , "narrator": "神楽", "text": "そうですけど"},
        { "location": "1309/TALK"  , "narrator": "神楽", "text": "でも"},
        { "location": "1313/SEL"   , "narrator": "", "text": "例えフェノメノンを発症しても大丈夫"},
        { "location": "1314/ACT"   , "narrator": "", "text": "例えフェノメノンを発症しても大丈夫"},
        { "location": "1318/SEL"   , "narrator": "", "text": "神楽はつばめを壊さなくていいんだ"},
        { "location": "1319/ACT"   , "narrator": "", "text": "神楽はつばめを壊さなくていいんだ"},
        { "location": "1322/TALK"  , "narrator": "神楽", "text": "あなたは"},
        { "location": "1323/TALK"  , "narrator": "神楽", "text": "もしかして"},
        { "location": "1324/TALK"  , "narrator": "神楽", "text": "こうなると見越してたんですか？"},
        { "location": "1326/TALK"  , "narrator": "神楽", "text": "だから私に"},
        { "location": "1327/TALK"  , "narrator": "神楽", "text": "つばめさんの真実を話したんですね？"},
        { "location": "1329/SEL"   , "narrator": "", "text": "そうだよ"},
        { "location": "1330/ACT"   , "narrator": "", "text": "そうだよ"},
        { "location": "1332/TALK"  , "narrator": "神楽", "text": "千羽鶴がウソをつくとわかってて？"},
        { "location": "1334/TALK"  , "narrator": "神楽", "text": "だから任せて、と"},
        { "location": "1337/SEL"   , "narrator": "", "text": "まあね"},
        { "location": "1338/ACT"   , "narrator": "", "text": "まあね"},
        { "location": "1340/TALK"  , "narrator": "神楽", "text": "やっぱり"},
        { "location": "1342/TALK"  , "narrator": "神楽", "text": "どうしてですか？"},
        { "location": "1343/TALK"  , "narrator": "神楽", "text": "どうしてあなたは"},
        { "location": "1344/TALK"  , "narrator": "神楽", "text": "そんなことまでわかるんですか？"},
        { "location": "1346/SEL"   , "narrator": "", "text": "$me$は未来から来た時空管理警察フューチャーマンだからさ"},
        { "location": "1347/SEL"   , "narrator": "", "text": "今は教えられない"},
        { "location": "1348/ACT"   , "narrator": "", "text": "$me$は未来から来た時空管理警察フューチャーマンだからさ"},
        { "location": "1350/TALK"  , "narrator": "神楽", "text": "うわダサｗｗｗｗｗｗｗｗｗｗ"},
        { "location": "1352/TALK"  , "narrator": "神楽", "text": "フューチャーマンさんでしたかｗｗｗｗｗｗｗｗｗｗ"},
        { "location": "1353/TALK"  , "narrator": "神楽", "text": "でもなるほどなっとく"},
        { "location": "1354/TALK"  , "narrator": "神楽", "text": "時空管理警察の方なら"},
        { "location": "1355/TALK"  , "narrator": "神楽", "text": "知ってて当然ですね"},
        { "location": "1356/TALK"  , "narrator": "神楽", "text": "どんな組織かは知らないけど"},
        { "location": "1357/TALK"  , "narrator": "神楽", "text": "それじゃあ"},
        { "location": "1358/TALK"  , "narrator": "神楽", "text": "今回の件が解決した後には"},
        { "location": "1359/TALK"  , "narrator": "神楽", "text": "ぴょんこ先生がそのネタで超ダサい同人誌描いてあげますね！"},
        { "location": "1360/TALK"  , "narrator": "神楽", "text": "当然"},
        { "location": "1362/TALK"  , "narrator": "神楽", "text": "あなたの実名入りでｗｗｗｗｗｗｗｗ"},
        { "location": "1363/ACT"   , "narrator": "", "text": "今は教えられない"},
        { "location": "1364/TALK"  , "narrator": "神楽", "text": "ですよねー"},
        { "location": "1365/TALK"  , "narrator": "神楽", "text": "じゃあ"},
        { "location": "1366/TALK"  , "narrator": "神楽", "text": "無事終わったら"},
        { "location": "1367/TALK"  , "narrator": "神楽", "text": "その手品のタネ教えてくださいね"},
        { "location": "1369/SEL"   , "narrator": "", "text": "全部教えるよ、無事終えたらね"},
        { "location": "1370/ACT"   , "narrator": "", "text": "全部教えるよ、無事終えたらね"},
        { "location": "1373/TALK"  , "narrator": "神楽", "text": "ちょ"},
        { "location": "1375/TALK"  , "narrator": "神楽", "text": "そこまでいくと死亡フラグっぽいからｗｗｗｗｗｗ"},
        { "location": "1378/TALK"  , "narrator": "神楽", "text": "なんだか"},
        { "location": "1379/TALK"  , "narrator": "神楽", "text": "少し気がラクになりました"},
        { "location": "1380/TALK"  , "narrator": "神楽", "text": "あなたのおかげですね"},
        { "location": "1381/SEL"   , "narrator": "", "text": "神楽"},
        { "location": "1382/TALK"  , "narrator": "神楽", "text": "もう少しだけ"},
        { "location": "1383/TALK"  , "narrator": "神楽", "text": "頑張れるかもしれないです"},
        { "location": "1388/TALK"  , "narrator": "神楽", "text": "ありがとう"},
        { "location": "1402/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1403/TALK"  , "narrator": "神楽", "text": "でも、これで全てが\n解決したわけじゃ\nないのよね…。"},
        { "location": "1404/TALK"  , "narrator": "神楽", "text": "確かに、千羽鶴が\nウソをついていれば、\nそれは契約違反…。"},
        { "location": "1405/TALK"  , "narrator": "神楽", "text": "私がつばめさんを\n壊す契約は、\nなかったものとなる。"},
        { "location": "1407/TALK"  , "narrator": "神楽", "text": "けど、つばめさんを\n壊さなかったと\nしたら…。"},
        { "location": "1408/TALK"  , "narrator": "神楽", "text": "ママと音羽は…。\n誰が助けてくれる？"},
        { "location": "1409/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1410/TALK"  , "narrator": "神楽", "text": "結局…千羽鶴と\n彼ら以外に…。"},
        { "location": "1411/TALK"  , "narrator": "神楽", "text": "ママと音羽を\n助けられる人は\nいないんだし…。"},
        { "location": "1412/TALK"  , "narrator": "神楽", "text": "…あれ？"},
        { "location": "1413/TALK"  , "narrator": "神楽", "text": "でも、千羽鶴が\nつばめさんのセルフ\nクランということは。"},
        { "location": "1414/TALK"  , "narrator": "神楽", "text": "音羽を壊したのは、\nつばめさんなのに\n変わりないんじゃ…。"},
        { "location": "1415/TALK"  , "narrator": "神楽", "text": "今は別人でも、\nもし二人が元の一人に\n戻ったら…。"},
        { "location": "1416/TALK"  , "narrator": "神楽", "text": "――ッ！？\nそうか、わかった！"},
        { "location": "1417/TALK"  , "narrator": "神楽", "text": "彼らが言っていた\nつばめさんは、\n恐らく――"},
        { "location": "1418/TALK"  , "narrator": "神楽", "text": "千羽鶴が分離する前の\nつばめさんのこと！"},
        { "location": "1419/TALK"  , "narrator": "神楽", "text": "もしそうなら、\nもしこの世界が\nなくなったら…。"},
        { "location": "1420/TALK"  , "narrator": "神楽", "text": "その時は、\nつばめさんは――"},
        { "location": "1421/SEL"   , "narrator": "", "text": "神楽、落ち着いて！"},
        { "location": "1422/ACT"   , "narrator": "", "text": "神楽、落ち着いて！"},
        { "location": "1426/TALK"  , "narrator": "神楽", "text": "…$handlek$？\n言い忘れたことでも\nあったのかしら？"},
        { "location": "1429/TALK"  , "narrator": "つばめ", "text": "…神楽ちゃん"},
        { "location": "1432/TALK"  , "narrator": "神楽", "text": "……え？"},
        { "location": "1434/ACT"   , "narrator": "", "text": "神楽"},
        { "location": "1435/TALK"  , "narrator": "神楽", "text": "はい？"},
        { "location": "1437/SEL"   , "narrator": "", "text": "神楽のこと、いつも見守ってるから"},
        { "location": "1438/ACT"   , "narrator": "", "text": "神楽のこと、いつも見守ってるから"},
        { "location": "1440/TALK"  , "narrator": "神楽", "text": "通報しましたっ！"},
        { "location": "1441/TALK"  , "narrator": "神楽", "text": "ストーカーですねッｗｗｗｗｗ"},
        { "location": "1443/SEL"   , "narrator": "", "text": "絶対に幸せにするから"},
        { "location": "1444/ACT"   , "narrator": "", "text": "絶対に幸せにするから"},
        { "location": "1446/TALK"  , "narrator": "神楽", "text": "なんですかもー"},
        { "location": "1447/TALK"  , "narrator": "神楽", "text": "それじゃプロポーズみたいですよー？"},
        { "location": "1448/TALK"  , "narrator": "神楽", "text": "空気嫁ー"},
        { "location": "1450/SEL"   , "narrator": "", "text": "頑張ってね"},
        { "location": "1451/ACT"   , "narrator": "", "text": "頑張ってね"},
        { "location": "1469/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "1470/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$の\n言ってたこと、\n本当なのかしら？"},
        { "location": "1471/TALK"  , "narrator": "ガブリエラ", "text": "神楽が、つばめを\n壊そうとしてる\nなんて…。"},
        { "location": "1472/TALK"  , "narrator": "ガブリエラ", "text": "まさかね。\nあんなに仲がいいのに\nそんなこと…。"},
        { "location": "1473/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "1474/TALK"  , "narrator": "ガブリエラ", "text": "でも…もしも本当に\nそうだったら…。"},
        { "location": "1475/TALK"  , "narrator": "ガブリエラ", "text": "…確かめないと。\n最悪の事態に\nなるまえに…。"},
        { "location": "1502/TALK"  , "narrator": "ガブリエラ", "text": "…来たわね。"},
        { "location": "1504/TALK"  , "narrator": "神楽", "text": "どうしたんですか？\nこんな時間に\n呼び出すなんて…。"},
        { "location": "1505/TALK"  , "narrator": "ガブリエラ", "text": "悪かったわね。\nみんなには\n聞かれたくなくて…。"},
        { "location": "1506/TALK"  , "narrator": "神楽", "text": "…込み入った\n話ですか？"},
        { "location": "1507/TALK"  , "narrator": "ガブリエラ", "text": "アンタの返答次第では\nそうなるわね。"},
        { "location": "1508/TALK"  , "narrator": "ガブリエラ", "text": "ねえ、神楽。\nあんたさ――"},
        { "location": "1509/TALK"  , "narrator": "ガブリエラ", "text": "つばめのことを\n壊そうとしてるって、\n本当なの？"},
        { "location": "1510/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1511/TALK"  , "narrator": "ガブリエラ", "text": "どうなのよ？"},
        { "location": "1513/TALK"  , "narrator": "神楽", "text": "…それ、\n誰から聞きました？"},
        { "location": "1514/TALK"  , "narrator": "ガブリエラ", "text": "秘密よ。"},
        { "location": "1516/TALK"  , "narrator": "神楽", "text": "…まあ、聞かなくても\nわかりますけどね。"},
        { "location": "1518/TALK"  , "narrator": "神楽", "text": "…それで？\nそれが本当なら、\nどうするんですか？"},
        { "location": "1519/TALK"  , "narrator": "ガブリエラ", "text": "そりゃもちろん、\nあんたには\n死んでもらうわ。"},
        { "location": "1520/TALK"  , "narrator": "神楽", "text": "…冗談ですよね？"},
        { "location": "1521/TALK"  , "narrator": "ガブリエラ", "text": "本気よ。\nあたしは\nソルジャーだもの。"},
        { "location": "1522/TALK"  , "narrator": "ガブリエラ", "text": "もしも本当につばめを\n壊そうとしてるなら、\nあんたは敵よ。"},
        { "location": "1523/TALK"  , "narrator": "ガブリエラ", "text": "敵に情けは無用。\nそうでしょ？"},
        { "location": "1524/TALK"  , "narrator": "神楽", "text": "…つばめさんの\n味方なんですね。"},
        { "location": "1525/TALK"  , "narrator": "ガブリエラ", "text": "つばめだからじゃ\nないわ。"},
        { "location": "1526/TALK"  , "narrator": "ガブリエラ", "text": "コトを起こそうと\nしているのなら、\n誰だって同じ…。"},
        { "location": "1527/TALK"  , "narrator": "ガブリエラ", "text": "本当に本当なら、\nあたしも本気で\n容赦しない。"},
        { "location": "1528/TALK"  , "narrator": "ガブリエラ", "text": "もしも冗談なら、\n今すぐ冗談と言えば\n許してあげるわ。"},
        { "location": "1529/TALK"  , "narrator": "神楽", "text": "…冗談？\nまさか。"},
        { "location": "1530/TALK"  , "narrator": "神楽", "text": "こんなこと、\n冗談で言ったりなんか\nしませんよ。"},
        { "location": "1531/TALK"  , "narrator": "神楽", "text": "それこそ…、\n冗談でもつばめさんに\n対して…。"},
        { "location": "1532/TALK"  , "narrator": "神楽", "text": "壊すだなんて…、\n口が裂けても\n言えません…。"},
        { "location": "1535/TALK"  , "narrator": "ガブリエラ", "text": "そう…。\n本気なんだ…。"},
        { "location": "1539/TALK"  , "narrator": "ガブリエラ", "text": "それなら――っ！！"},
        { "location": "1540/TALK"  , "narrator": "真幌", "text": "こら。"},
        { "location": "1551/TALK"  , "narrator": "ガブリエラ", "text": "いたっ！？"},
        { "location": "1555/TALK"  , "narrator": "真幌", "text": "まったく、\n何をしているかと\n思えば…。"},
        { "location": "1557/TALK"  , "narrator": "神楽", "text": "ま、真幌さん！？"},
        { "location": "1560/TALK"  , "narrator": "ガブリエラ", "text": "まほ！？"},
        { "location": "1563/TALK"  , "narrator": "真幌", "text": "…こんな夜更けに、\n物騒なケンカを\nするな。"},
        { "location": "1567/TALK"  , "narrator": "ガブリエラ", "text": "べ、別に、\nケンカなんて…。"},
        { "location": "1568/TALK"  , "narrator": "真幌", "text": "なにもなかったとは\n言わせんぞ？"},
        { "location": "1571/TALK"  , "narrator": "ガブリエラ", "text": "うっ…っていうか、\nどうしてまほが\nここにいるのよ！？"},
        { "location": "1572/TALK"  , "narrator": "真幌", "text": "こんな夜中に、\n可愛い部員が二人も\nいなくなったんだ。"},
        { "location": "1573/TALK"  , "narrator": "真幌", "text": "顧問の私には\n探す責任が\nあるんだよ。"},
        { "location": "1575/TALK"  , "narrator": "真幌", "text": "…で？\n今回のケンカ――"},
        { "location": "1576/TALK"  , "narrator": "真幌", "text": "いや…、殺し合いの\n発端はなんだ？"},
        { "location": "1578/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1581/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "1582/TALK"  , "narrator": "真幌", "text": "ふむ…そうか…。"},
        { "location": "1584/TALK"  , "narrator": "真幌", "text": "おい、ギャヴィ。\nおまえはもう帰れ。"},
        { "location": "1588/TALK"  , "narrator": "ガブリエラ", "text": "はぁ！？\nなんであたしだけ――"},
        { "location": "1589/TALK"  , "narrator": "真幌", "text": "命令だ！\n今すぐ帰れ。"},
        { "location": "1590/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "1597/TALK"  , "narrator": "真幌", "text": "…さて。\nなにかワケありの\nようだな？"},
        { "location": "1598/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1599/TALK"  , "narrator": "真幌", "text": "まあ、無理にとは\n言わんよ。"},
        { "location": "1600/TALK"  , "narrator": "真幌", "text": "だが…、もし私を\n信頼してくれるなら、\n言ってくれ。"},
        { "location": "1601/TALK"  , "narrator": "真幌", "text": "どんなことでも、\n決しておまえの\n敵には回らない。"},
        { "location": "1602/TALK"  , "narrator": "真幌", "text": "そう約束しよう。"},
        { "location": "1604/TALK"  , "narrator": "真幌", "text": "例え…仮にだが、\nおまえの悩みが…。"},
        { "location": "1605/TALK"  , "narrator": "真幌", "text": "人殺しをしてしまった\nことだったと\nしてもだ。"},
        { "location": "1607/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1608/SEL"   , "narrator": "", "text": "真幌に全てを打ち明けるべきだ"},
        { "location": "1609/SEL"   , "narrator": "", "text": "（※何も言わない）"},
        { "location": "1610/ACT"   , "narrator": "", "text": "真幌に全てを打ち明けるべきだ"},
        { "location": "1617/ACT"   , "narrator": "", "text": "（※何も言わない）"},
        { "location": "1624/TALK"  , "narrator": "神楽", "text": "……いえ。\n特に何かあったわけでは\nありませんから。"},
        { "location": "1625/TALK"  , "narrator": "真幌", "text": "……そうか。\nならいいのだが。"},
        { "location": "1626/TALK"  , "narrator": "真幌", "text": "…さて、そろそろ\n暗くなる。"},
        { "location": "1627/TALK"  , "narrator": "真幌", "text": "みんなも待っている\nだろうからな。\n戻るとしよう。"},
        { "location": "1628/TALK"  , "narrator": "神楽", "text": "…はい。"},
        { "location": "1629/TALK"  , "narrator": "真幌", "text": "…なあ、卯月。"},
        { "location": "1630/TALK"  , "narrator": "真幌", "text": "悩みがあるなら、\n本当になんでも\n言うんだぞ？"},
        { "location": "1631/TALK"  , "narrator": "真幌", "text": "いつだって\n頼ってくれて\n構わないんだからな？"},
        { "location": "1632/TALK"  , "narrator": "神楽", "text": "…はい。"},
        { "location": "1660/TALK"  , "narrator": "神楽", "text": "真幌さん…。\n真幌さんは――"},
        { "location": "1661/TALK"  , "narrator": "神楽", "text": "皇千羽鶴という人を、\nご存じですか？"},
        { "location": "1663/TALK"  , "narrator": "真幌", "text": "…ああ、知っている。\n話があるなら続けろ。"},
        { "location": "1664/TALK"  , "narrator": "神楽", "text": "…はい。\n実は――"},
        { "location": "1680/TALK"  , "narrator": "真幌", "text": "――なるほどな。"},
        { "location": "1681/TALK"  , "narrator": "真幌", "text": "おまえは皇千羽鶴と、\n秘密裏に契約を\n交わしていた。"},
        { "location": "1682/TALK"  , "narrator": "真幌", "text": "そして、いずれ\n逢瀬を殺害しなければ\nならない、か…。"},
        { "location": "1683/TALK"  , "narrator": "神楽", "text": "…はい。"},
        { "location": "1685/TALK"  , "narrator": "神楽", "text": "つばめさんのことを\n殺さなければ…。"},
        { "location": "1686/TALK"  , "narrator": "神楽", "text": "私の母が、殺されて\nしまうんです…。"},
        { "location": "1687/TALK"  , "narrator": "真幌", "text": "…まあ、そんなこと\nだろうとは思ったよ。"},
        { "location": "1688/TALK"  , "narrator": "真幌", "text": "…だが、わからんな。"},
        { "location": "1690/TALK"  , "narrator": "真幌", "text": "皇千羽鶴は、\nなぜ逢瀬のことを\n殺そうとしている？"},
        { "location": "1693/TALK"  , "narrator": "神楽", "text": "そ、それは…。"},
        { "location": "1695/TALK"  , "narrator": "真幌", "text": "…無理に言う\n必要はない。"},
        { "location": "1696/TALK"  , "narrator": "真幌", "text": "詮索はしない。\n事情は、\n言いたければ言え。"},
        { "location": "1697/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1698/TALK"  , "narrator": "真幌", "text": "卯月は、皇千羽鶴が\nエージェントとしか\n聞いていないんだな？"},
        { "location": "1700/TALK"  , "narrator": "神楽", "text": "はい…違うんですか？"},
        { "location": "1701/TALK"  , "narrator": "真幌", "text": "皇千羽鶴。\n彼女は、情報管理庁の\n長官だ。"},
        { "location": "1703/TALK"  , "narrator": "神楽", "text": "ッ！？\n本当ですか！？"},
        { "location": "1704/TALK"  , "narrator": "真幌", "text": "ああ…、しかし、\nなぜ長官が逢瀬を\n殺そうとするのか…？"},
        { "location": "1705/TALK"  , "narrator": "真幌", "text": "…いや、いずれにせよ\nそれが事実ならば。"},
        { "location": "1706/TALK"  , "narrator": "真幌", "text": "私は隊長として、\nおまえと逢瀬のことを\n守らねばならない。"},
        { "location": "1707/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1708/TALK"  , "narrator": "真幌", "text": "卯月、私はさっき、\nおまえの敵には\n回らんと言ったな？"},
        { "location": "1709/TALK"  , "narrator": "神楽", "text": "…はい。"},
        { "location": "1710/TALK"  , "narrator": "真幌", "text": "私は、管理庁に\n探りを入れる。"},
        { "location": "1711/TALK"  , "narrator": "真幌", "text": "そしてなにが\n目的なのかの\n裏を取らねばならん。"},
        { "location": "1712/TALK"  , "narrator": "真幌", "text": "その間、私は全力で\nおまえと逢瀬を\n保護すると約束する。"},
        { "location": "1713/TALK"  , "narrator": "真幌", "text": "だから、おまえには\n如何なることが\nあったとしても。"},
        { "location": "1714/TALK"  , "narrator": "真幌", "text": "逢瀬に手をかける\nようなことは\nしないでほしい。"},
        { "location": "1715/TALK"  , "narrator": "神楽", "text": "…その頼みを、\n私が聞けなかったと\nしたら？"},
        { "location": "1716/TALK"  , "narrator": "真幌", "text": "私は…さっきの約束を\n破らなければならない\nことになる…。"},
        { "location": "1717/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1718/TALK"  , "narrator": "真幌", "text": "特別攻撃隊隊長という\n立場にいる者として、\nより健全に――"},
        { "location": "1719/TALK"  , "narrator": "真幌", "text": "隊が機能する方を\n選択する必要が\nあるからだ。"},
        { "location": "1720/TALK"  , "narrator": "神楽", "text": "…指揮官として、\nまっとうなことだと\n思いますよ。"},
        { "location": "1721/TALK"  , "narrator": "真幌", "text": "…そうなったとしても\n恨まんでくれよ？"},
        { "location": "1722/TALK"  , "narrator": "真幌", "text": "その代わり、事情を\n聞いた以上は私も\n最善を尽くす。"},
        { "location": "1723/TALK"  , "narrator": "真幌", "text": "だから卯月も、\n最悪の結果にならん\nように。"},
        { "location": "1724/TALK"  , "narrator": "真幌", "text": "最善を尽くして\nほしい…。"},
        { "location": "1725/TALK"  , "narrator": "真幌", "text": "私が望むのは、\nそれだけだ。"},
        { "location": "1726/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1727/TALK"  , "narrator": "真幌", "text": "…ありがとう、\n卯月。"},
        { "location": "1728/TALK"  , "narrator": "真幌", "text": "言い難いこと\nだったろうに、\n打ち明けてくれて…。"},
        { "location": "1729/TALK"  , "narrator": "神楽", "text": "真幌さん…。"},
        { "location": "1730/TALK"  , "narrator": "真幌", "text": "…先に戻る。\nおまえも、\n遅くなるなよ。"},
        { "location": "1749/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "1751/TALK"  , "narrator": "ガブリエラ", "text": "ぐすっ、うぅ…。\nうぅぅ…………。"},
        { "location": "1752/SEL"   , "narrator": "", "text": "ガブリエラは優しいね"},
        { "location": "1753/ACT"   , "narrator": "", "text": "ガブリエラは優しいね"},
        { "location": "1767/TALK"  , "narrator": "プレイヤー", "text": "ガブリエラは優しいね"},
        { "location": "1769/TALK"  , "narrator": "ガブリエラ", "text": "私が優しい？"},
        { "location": "1771/TALK"  , "narrator": "ガブリエラ", "text": "どういうこと？"},
        { "location": "1773/SEL"   , "narrator": "", "text": "神楽を敵として見るのが辛いんでしょ？"},
        { "location": "1774/ACT"   , "narrator": "", "text": "神楽を敵として見るのが辛いんでしょ？"},
        { "location": "1777/TALK"  , "narrator": "ガブリエラ", "text": "やっぱり"},
        { "location": "1778/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$には隠せないわね"},
        { "location": "1780/SEL"   , "narrator": "", "text": "優しい子なのはよく知ってるからね"},
        { "location": "1781/ACT"   , "narrator": "", "text": "優しい子なのはよく知ってるからね"},
        { "location": "1783/TALK"  , "narrator": "ガブリエラ", "text": "ありがとう"},
        { "location": "1785/TALK"  , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "1786/TALK"  , "narrator": "ガブリエラ", "text": "本当に優しい子なら"},
        { "location": "1787/TALK"  , "narrator": "ガブリエラ", "text": "死んでもらうなんて"},
        { "location": "1788/TALK"  , "narrator": "ガブリエラ", "text": "言わないんじゃないかしら？"},
        { "location": "1790/TALK"  , "narrator": "ガブリエラ", "text": "でも良かったわ"},
        { "location": "1791/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$から神楽のコトを聞いてて"},
        { "location": "1792/TALK"  , "narrator": "ガブリエラ", "text": "おかげでなにがあっても動じずに"},
        { "location": "1793/TALK"  , "narrator": "ガブリエラ", "text": "冷静に対処できると思うから"},
        { "location": "1795/SEL"   , "narrator": "", "text": "なにがあっても神楽を信じてあげて"},
        { "location": "1796/SEL"   , "narrator": "", "text": "神楽を信用したらダメだ"},
        { "location": "1797/ACT"   , "narrator": "", "text": "なにがあっても神楽を信じてあげて"},
        { "location": "1799/TALK"  , "narrator": "ガブリエラ", "text": "この状況で？"},
        { "location": "1800/TALK"  , "narrator": "ガブリエラ", "text": "無茶を言うのね"},
        { "location": "1801/TALK"  , "narrator": "ガブリエラ", "text": "それができれば"},
        { "location": "1803/TALK"  , "narrator": "ガブリエラ", "text": "私もいいとは思うけど"},
        { "location": "1804/ACT"   , "narrator": "", "text": "神楽を信用したらダメだ"},
        { "location": "1805/TALK"  , "narrator": "ガブリエラ", "text": "言われなくてもわかってるわ"},
        { "location": "1806/TALK"  , "narrator": "ガブリエラ", "text": "っていうか"},
        { "location": "1807/TALK"  , "narrator": "ガブリエラ", "text": "信じるとか無理だもの"},
        { "location": "1810/TALK"  , "narrator": "ガブリエラ", "text": "誤解だったらいいのにとは"},
        { "location": "1811/TALK"  , "narrator": "ガブリエラ", "text": "思ってもいるけど"},
        { "location": "1813/TALK"  , "narrator": "ガブリエラ", "text": "あたしは軍人なの"},
        { "location": "1814/TALK"  , "narrator": "ガブリエラ", "text": "自分の気持ちよりも"},
        { "location": "1815/TALK"  , "narrator": "ガブリエラ", "text": "優先しなければならないことがある"},
        { "location": "1820/TALK"  , "narrator": "ガブリエラ", "text": "決めた"},
        { "location": "1821/TALK"  , "narrator": "ガブリエラ", "text": "今日は寝ないで"},
        { "location": "1822/TALK"  , "narrator": "ガブリエラ", "text": "朝まで神様に祈るわ"},
        { "location": "1823/TALK"  , "narrator": "ガブリエラ", "text": "少しでも"},
        { "location": "1826/TALK"  , "narrator": "ガブリエラ", "text": "私の願いが届くように"},
        { "location": "1850/DIALOG", "narrator": "Dialog_chapter_ch05", "text": "【18 ブラック・クラン】"},
        { "location": "1862/DIALOG", "narrator": "Dialog_chapter_ch05", "text": "【18 ブラック・クラン】"}
    ]
}
