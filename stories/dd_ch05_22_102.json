        { "location": "915/ACT"    , "narrator": "", "text": "代わってあげたいよ"},
        { "location": "916/TALK"   , "narrator": "神楽", "text": "そんなこと$handle$には、、、"},
        { "location": "917/TALK"   , "narrator": "神楽", "text": "してして代わってー"},
        { "location": "918/ACT"    , "narrator": "", "text": "じゃあ頑張れ！"},
        { "location": "919/TALK"   , "narrator": "神楽", "text": "まーね"},
        { "location": "920/TALK"   , "narrator": "神楽", "text": "がんばるしー"},
        { "location": "921/TALK"   , "narrator": "神楽", "text": "だからほめてね♪"},
        { "location": "922/ACT"    , "narrator": "", "text": "よしよし偉いぞ"},
        { "location": "925/TALK"   , "narrator": "神楽", "text": "もっともっともっとー！！！！"},
        { "location": "927/TALK"   , "narrator": "神楽", "text": "こういうの全部宅配してもらえばいいのにね？"},
        { "location": "928/TALK"   , "narrator": "神楽", "text": "なんでしないのかな？"},
        { "location": "930/SEL"    , "narrator": "", "text": "ケチだから"},
        { "location": "931/SEL"    , "narrator": "", "text": "宅配地域外なんじゃない"},
        { "location": "932/SEL"    , "narrator": "", "text": "神楽に意地悪したいんだよ…"},
        { "location": "933/ACT"    , "narrator": "", "text": "ケチだから"},
        { "location": "934/TALK"   , "narrator": "神楽", "text": "うわー"},
        { "location": "935/TALK"   , "narrator": "神楽", "text": "Disり系パワーワードいただきましたー！！！"},
        { "location": "936/TALK"   , "narrator": "神楽", "text": "でもそうかも？"},
        { "location": "937/TALK"   , "narrator": "神楽", "text": "違うかも？"},
        { "location": "938/ACT"    , "narrator": "", "text": "宅配地域外なんじゃない"},
        { "location": "939/TALK"   , "narrator": "神楽", "text": "配達圏外！"},
        { "location": "940/TALK"   , "narrator": "神楽", "text": "ヤバいそれヤバい"},
        { "location": "941/TALK"   , "narrator": "神楽", "text": "でもありうる"},
        { "location": "943/ACT"    , "narrator": "", "text": "神楽に意地悪したいんだよ…"},
        { "location": "944/TALK"   , "narrator": "神楽", "text": "やだこわい"},
        { "location": "946/TALK"   , "narrator": "神楽", "text": "でもさー"},
        { "location": "947/TALK"   , "narrator": "神楽", "text": "こうやって買出しに付き合わなかったら"},
        { "location": "948/TALK"   , "narrator": "神楽", "text": "ちょっとピンとこなかったかも"},
        { "location": "950/SEL"    , "narrator": "", "text": "何が？"},
        { "location": "951/ACT"    , "narrator": "", "text": "何が？"},
        { "location": "952/TALK"   , "narrator": "神楽", "text": "全員分の食材の重さとか量とか"},
        { "location": "953/TALK"   , "narrator": "神楽", "text": "あと手間とかね"},
        { "location": "954/TALK"   , "narrator": "神楽", "text": "これかなり大変ぴょん"},
        { "location": "955/TALK"   , "narrator": "神楽", "text": "一人分と違ってさ～"},
        { "location": "957/SEL"    , "narrator": "", "text": "そこに気が付く神楽は偉い"},
        { "location": "958/SEL"    , "narrator": "", "text": "$me$にも作ってよ"},
        { "location": "959/SEL"    , "narrator": "", "text": "今夜はご馳走だ！"},
        { "location": "960/ACT"    , "narrator": "", "text": "そこに気が付く神楽は偉い"},
        { "location": "962/ACT"    , "narrator": "", "text": "$me$にも作ってよ"},
        { "location": "963/TALK"   , "narrator": "神楽", "text": "いいけどー"},
        { "location": "964/TALK"   , "narrator": "神楽", "text": "$handle$もぴょんこに作ってよね？"},
        { "location": "965/ACT"    , "narrator": "", "text": "今夜はご馳走だ！"},
        { "location": "967/TALK"   , "narrator": "神楽", "text": "ってテンション高いな！？"},
        { "location": "969/TALK"   , "narrator": "神楽", "text": "文句ばっかり言ってるけどさ"},
        { "location": "970/TALK"   , "narrator": "神楽", "text": "この風景は結構好き"},
        { "location": "971/TALK"   , "narrator": "神楽", "text": "夕暮れってセンチメンタルだし"},
        { "location": "972/TALK"   , "narrator": "神楽", "text": "ただちょっとね"},
        { "location": "973/TALK"   , "narrator": "神楽", "text": "ぴょんこは隠し事があるから"},
        { "location": "974/TALK"   , "narrator": "神楽", "text": "気づまりな部分もあるワケ"},
        { "location": "976/SEL"    , "narrator": "", "text": "わかるよ…"},
        { "location": "977/SEL"    , "narrator": "", "text": "今は忘れよう"},
        { "location": "978/SEL"    , "narrator": "", "text": "$me$が色々聞くから"},
        { "location": "979/ACT"    , "narrator": "", "text": "わかるよ…"},
        { "location": "980/TALK"   , "narrator": "神楽", "text": "$handle$はわかってくれるよね"},
        { "location": "981/TALK"   , "narrator": "神楽", "text": "頼りにしてるぴょん"},
        { "location": "982/ACT"    , "narrator": "", "text": "今は忘れよう"},
        { "location": "984/TALK"   , "narrator": "神楽", "text": "それがいいぴょん"},
        { "location": "985/ACT"    , "narrator": "", "text": "$me$が色々聞くから"},
        { "location": "987/TALK"   , "narrator": "神楽", "text": "そうでなきゃ！"},
        { "location": "988/TALK"   , "narrator": "神楽", "text": "ぴょんこだけのためにそう言ってくれなきゃ！"},
        { "location": "1001/TALK"  , "narrator": "みやび", "text": "今日の夕食は\n期待して欲しいぞね。"},
        { "location": "1002/TALK"  , "narrator": "神楽", "text": "楽しみにしてます！"},
        { "location": "1003/TALK"  , "narrator": "アーヤ", "text": "それだけは\n信用してるわ。"},
        { "location": "1004/TALK"  , "narrator": "みやび", "text": "他にも信用して\n欲しいけんどねえ…。"},
        { "location": "1005/ACT"   , "narrator": "", "text": "みやびに声を掛ける"},
        { "location": "1006/TALK"  , "narrator": "みやび", "text": "あーちょっと\n待った待った。"},
        { "location": "1018/TALK"  , "narrator": "みやび", "text": "みやびさん参上！"},
        { "location": "1020/SEL"   , "narrator": "", "text": "今日はみやびが夕食当番？"},
        { "location": "1021/ACT"   , "narrator": "", "text": "今日はみやびが夕食当番？"},
        { "location": "1023/TALK"  , "narrator": "みやび", "text": "そういう役職はない"},
