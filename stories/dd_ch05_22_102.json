        { "location": "1112/SEL"   , "narrator": "", "text": "それは残念"},
        { "location": "1113/SEL"   , "narrator": "", "text": "レンタカーとかもないの？"},
        { "location": "1114/SEL"   , "narrator": "", "text": "大変だね…"},
        { "location": "1115/ACT"   , "narrator": "", "text": "それは残念"},
        { "location": "1116/TALK"  , "narrator": "アーヤ", "text": "ちょっとね"},
        { "location": "1117/ACT"   , "narrator": "", "text": "レンタカーとかもないの？"},
        { "location": "1118/TALK"  , "narrator": "アーヤ", "text": "あるけど予約が面倒なのよね"},
        { "location": "1119/ACT"   , "narrator": "", "text": "大変だね…"},
        { "location": "1120/TALK"  , "narrator": "アーヤ", "text": "そうでもないけど"},
        { "location": "1122/TALK"  , "narrator": "アーヤ", "text": "うちの田舎だったら車がないと生活できないから"},
        { "location": "1123/TALK"  , "narrator": "アーヤ", "text": "みんな免許取るけど"},
        { "location": "1124/TALK"  , "narrator": "アーヤ", "text": "この辺りだと取らなくても普段はあんまり困らないのよね"},
        { "location": "1125/TALK"  , "narrator": "アーヤ", "text": "さすがにこういう時は欲しいけど＼(^O^)／"},
        { "location": "1127/SEL"   , "narrator": "", "text": "だから免許取ったの？"},
        { "location": "1128/SEL"   , "narrator": "", "text": "そういうもんかー"},
        { "location": "1129/SEL"   , "narrator": "", "text": "うちもそうだよ"},
        { "location": "1130/ACT"   , "narrator": "", "text": "だから免許取ったの？"},
        { "location": "1131/TALK"  , "narrator": "アーヤ", "text": "それもあるかも"},
        { "location": "1132/ACT"   , "narrator": "", "text": "そういうもんかー"},
        { "location": "1133/TALK"  , "narrator": "アーヤ", "text": "そうなのよね"},
        { "location": "1134/ACT"   , "narrator": "", "text": "うちもそうだよ"},
        { "location": "1135/TALK"  , "narrator": "アーヤ", "text": "わかってくれる？"},
        { "location": "1137/TALK"  , "narrator": "アーヤ", "text": "東京ほど移動が電車頼みじゃないけど"},
        { "location": "1138/TALK"  , "narrator": "アーヤ", "text": "うちの田舎ほどどこに行くにも大変じゃないし"},
        { "location": "1139/TALK"  , "narrator": "アーヤ", "text": "これはこれで楽しいんだけどね(*^^*)"},
        { "location": "1141/SEL"   , "narrator": "", "text": "$me$も行きたいなー"},
        { "location": "1142/SEL"   , "narrator": "", "text": "前向きなのはいいことだ"},
        { "location": "1143/SEL"   , "narrator": "", "text": "楽しそうで嫉妬！"},
        { "location": "1144/ACT"   , "narrator": "", "text": "$me$も行きたいなー"},
        { "location": "1145/TALK"  , "narrator": "アーヤ", "text": "一緒に歩ければ楽しいと思うわ"},
        { "location": "1146/TALK"  , "narrator": "アーヤ", "text": "$handle$さんと"},
        { "location": "1147/ACT"   , "narrator": "", "text": "前向きなのはいいことだ"},
        { "location": "1148/TALK"  , "narrator": "アーヤ", "text": "それが取り柄だもの"},
        { "location": "1149/TALK"  , "narrator": "アーヤ", "text": "褒めてくれてありがと"},
        { "location": "1150/ACT"   , "narrator": "", "text": "楽しそうで嫉妬！"},
        { "location": "1151/TALK"  , "narrator": "アーヤ", "text": "またそんなこと"},
        { "location": "1152/TALK"  , "narrator": "アーヤ", "text": "$handle$さんと話すのが一番楽しいのに"},
        { "location": "1154/TALK"  , "narrator": "アーヤ", "text": "次回の荷物持ちの時は"},
        { "location": "1155/TALK"  , "narrator": "アーヤ", "text": "車を出すことを提案するわ"},
        { "location": "1156/TALK"  , "narrator": "アーヤ", "text": "アドバイスありがと(^з^)-☆"},
        { "location": "1158/SEL"   , "narrator": "", "text": "どういたしまして"},
        { "location": "1159/SEL"   , "narrator": "", "text": "役に立ててうれしいよ"},
        { "location": "1160/SEL"   , "narrator": "", "text": "本当は$me$が助手席に乗りたい"},
        { "location": "1161/ACT"   , "narrator": "", "text": "どういたしまして"},
        { "location": "1162/TALK"  , "narrator": "アーヤ", "text": "また後でね"},
        { "location": "1163/ACT"   , "narrator": "", "text": "役に立ててうれしいよ"},
        { "location": "1164/TALK"  , "narrator": "アーヤ", "text": "私は話すだけでうれしいわ"},
        { "location": "1165/ACT"   , "narrator": "", "text": "本当は$me$が助手席に乗りたい"},
        { "location": "1166/TALK"  , "narrator": "アーヤ", "text": "じゃあナビはお任せするわ"},
