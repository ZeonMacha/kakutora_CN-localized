        { "location": "1027/SEL"   , "narrator": "", "text": "$me$も食べたいなー"},
        { "location": "1028/SEL"   , "narrator": "", "text": "大変だね"},
        { "location": "1029/SEL"   , "narrator": "", "text": "手伝っていい？"},
        { "location": "1030/ACT"   , "narrator": "", "text": "$me$も食べたいなー"},
        { "location": "1031/TALK"  , "narrator": "みやび", "text": "うちも食べさせたい"},
        { "location": "1032/TALK"  , "narrator": "みやび", "text": "あれやこれやを"},
