{
    "dir": "chap18/daydra/dd_ch02_18_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "18202",
        "cid": "ayami",
        "title": "002 メインストーリー",
        "sub_title": "其は詮索か友愛か＜前編＞"
    },
    "entry":
    [
        { "location": "24/TALK"   , "narrator": "アーヤ", "text": "…サークルで使う\n人形、完成！"},
        { "location": "25/TALK"   , "narrator": "アーヤ", "text": "買い物にでも\n行ってみようかしら？"},
        { "location": "29/TALK"   , "narrator": "アーヤ", "text": "あっ…。"},
        { "location": "30/TALK"   , "narrator": "アーヤ", "text": "メノウのＣＭ…。\nベストアルバムが\n出たんだ…。"},
        { "location": "31/TALK"   , "narrator": "アーヤ", "text": "…………。"},
        { "location": "32/TALK"   , "narrator": "アーヤ", "text": "メイクしてるから、\nパッと見じゃ全然\nわからないわ…。"},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "これが\n卯月だってこと…。"},
        { "location": "34/TALK"   , "narrator": "アーヤ", "text": "…………。"},
        { "location": "46/TALK"   , "narrator": "アーヤ", "text": "ダメね(-ω-;)"},
        { "location": "47/TALK"   , "narrator": "アーヤ", "text": "私"},
        { "location": "48/TALK"   , "narrator": "アーヤ", "text": "卯月のこと"},
        { "location": "49/TALK"   , "narrator": "アーヤ", "text": "全然知らなかった(; ;)"},
        { "location": "51/SEL"    , "narrator": "", "text": "メノウだったこと？"},
        { "location": "52/ACT"    , "narrator": "", "text": "メノウだったこと？"},
        { "location": "54/TALK"   , "narrator": "アーヤ", "text": "それもある（；￢＿￢）"},
        { "location": "55/TALK"   , "narrator": "アーヤ", "text": "けど"},
        { "location": "56/TALK"   , "narrator": "アーヤ", "text": "この前のフェノメノン"},
        { "location": "57/TALK"   , "narrator": "アーヤ", "text": "卯月の家が巻き込まれてたのも"},
        { "location": "58/TALK"   , "narrator": "アーヤ", "text": "全然知らなくて(>_<)"},
        { "location": "62/TALK"   , "narrator": "アーヤ", "text": "だから"},
        { "location": "63/TALK"   , "narrator": "アーヤ", "text": "キツいこと言っちゃって(; ;)"},
        { "location": "65/SEL"    , "narrator": "", "text": "間違ったことは言ってない"},
        { "location": "66/ACT"    , "narrator": "", "text": "間違ったことは言ってない"},
        { "location": "68/TALK"   , "narrator": "アーヤ", "text": "わかってる"},
        { "location": "69/TALK"   , "narrator": "アーヤ", "text": "あの時怒ったことを後悔はしてないわ"},
        { "location": "70/TALK"   , "narrator": "アーヤ", "text": "みんなを危険な目に合わせたのは事実だし"},
        { "location": "71/TALK"   , "narrator": "アーヤ", "text": "でも"},
        { "location": "72/TALK"   , "narrator": "アーヤ", "text": "卯月のことほとんど知らないのも事実(´o｀；"},
        { "location": "73/TALK"   , "narrator": "アーヤ", "text": "知らな過ぎるっていうのも"},
        { "location": "74/TALK"   , "narrator": "アーヤ", "text": "やっぱり問題あると思うから(>_<)"},
        { "location": "75/TALK"   , "narrator": "アーヤ", "text": "みやびに頼んで"},
        { "location": "76/TALK"   , "narrator": "アーヤ", "text": "卯月の情報を手に入れるとか(-ω-;)"},
        { "location": "79/TALK"   , "narrator": "アーヤ", "text": "やっぱり今のなし(>_<)"},
        { "location": "81/SEL"    , "narrator": "", "text": "アーヤは知りたくないの？"},
        { "location": "82/ACT"    , "narrator": "", "text": "アーヤは知りたくないの？"},
        { "location": "84/TALK"   , "narrator": "アーヤ", "text": "知りたいとは思うけど"},
        { "location": "85/TALK"   , "narrator": "アーヤ", "text": "プライバシーの侵害までするのは"},
        { "location": "86/TALK"   , "narrator": "アーヤ", "text": "やり過ぎだと思うし(￣Д￣ )"},
        { "location": "89/TALK"   , "narrator": "アーヤ", "text": "もちろん"},
        { "location": "90/TALK"   , "narrator": "アーヤ", "text": "気にはなるけど"},
        { "location": "156/TALK"  , "narrator": "アーヤ", "text": "　"},
        { "location": "165/TALK"  , "narrator": "アーヤ", "text": "[ココロゲート]へ\nいらっしゃい。\n$handle$さん。"},
        { "location": "166/SEL"   , "narrator": "", "text": "あれ！？"},
        { "location": "167/ACT"   , "narrator": "", "text": "あれ！？"},
        { "location": "170/TALK"  , "narrator": "アーヤ", "text": "え！？\nな、なに？？"},
        { "location": "171/SEL"   , "narrator": "", "text": "前回いなかったよね？"},
        { "location": "172/SEL"   , "narrator": "", "text": "別のアーヤさん？"},
        { "location": "173/ACT"   , "narrator": "", "text": "前回いなかったよね？"},
        { "location": "174/TALK"  , "narrator": "アーヤ", "text": "え…！？"},
        { "location": "175/TALK"  , "narrator": "アーヤ", "text": "ああ～、\nごめんなさい。"},
        { "location": "176/TALK"  , "narrator": "アーヤ", "text": "相変わらず私ってば\nタイミング悪いわよね。"},
        { "location": "177/TALK"  , "narrator": "アーヤ", "text": "ちょっと野暮用で\nゲートから外してた\nだけなの。"},
        { "location": "178/SEL"   , "narrator": "", "text": "よかった。更迭されたのかと思った"},
        { "location": "179/SEL"   , "narrator": "", "text": "野暮用？どんな？"},
        { "location": "180/ACT"   , "narrator": "", "text": "よかった。更迭されたのかと思った"},
        { "location": "181/TALK"  , "narrator": "アーヤ", "text": "ふふ。\nまさか。"},
        { "location": "182/ACT"   , "narrator": "", "text": "野暮用？どんな？"},
        { "location": "183/TALK"  , "narrator": "アーヤ", "text": "そんな不躾な質問は\n感心しないわね。"},
        { "location": "184/TALK"  , "narrator": "アーヤ", "text": "野暮用は\n野暮用よ？"},
        { "location": "186/ACT"   , "narrator": "", "text": "別のアーヤさん？"},
        { "location": "187/TALK"  , "narrator": "アーヤ", "text": "え？\nどういうこと？"},
        { "location": "188/TALK"  , "narrator": "アーヤ", "text": "突然意味の分からないこと\n言わないでちょうだい？"},
        { "location": "189/TALK"  , "narrator": "アーヤ", "text": "ミステリー小説とかじゃ\nないんだから。"},
        { "location": "191/TALK"  , "narrator": "アーヤ", "text": "それじゃ早速、\n仕事しましょ？"},
        { "location": "192/SEL"   , "narrator": "", "text": "オーケー"},
        { "location": "193/SEL"   , "narrator": "", "text": "ちょっと待って！"},
        { "location": "194/ACT"   , "narrator": "", "text": "オーケー"},
        { "location": "195/ACT"   , "narrator": "", "text": "ちょっと待って！"},
        { "location": "196/TALK"  , "narrator": "アーヤ", "text": "ええっ？\nな、なあに？"},
        { "location": "197/SEL"   , "narrator": "", "text": "この前言ってた「言わなければならない事」は？"},
        { "location": "198/SEL"   , "narrator": "", "text": "この前ジャンケンで負けて、次は服脱いでくれるって言ったじゃん"},
        { "location": "199/ACT"   , "narrator": "", "text": "「言わなければならないこと」は？"},
        { "location": "200/TALK"  , "narrator": "アーヤ", "text": "え？"},
        { "location": "201/TALK"  , "narrator": "アーヤ", "text": "ああ、アレね。"},
        { "location": "202/TALK"  , "narrator": "アーヤ", "text": "アレはもういいの。\n解決しちゃったから。"},
        { "location": "203/TALK"  , "narrator": "アーヤ", "text": "お騒がせしちゃって\nごめんなさいね。"},
        { "location": "204/ACT"   , "narrator": "", "text": "この前ジャンケンで負けて、次は服脱いでくれるって言ったじゃん"},
        { "location": "206/TALK"  , "narrator": "アーヤ", "text": "は！？\n私、そんなこと――！！"},
        { "location": "207/SEL"   , "narrator": "", "text": "ごめん、ちょっと言ってみたかっただけ"},
        { "location": "208/SEL"   , "narrator": "", "text": "やっぱり別のアーヤさんだったか"},
        { "location": "209/ACT"   , "narrator": "", "text": "ごめん、ちょっと言ってみたかっただけ"},
        { "location": "210/TALK"  , "narrator": "アーヤ", "text": "…はぁ。もう、\nビックリさせないで。"},
        { "location": "211/TALK"  , "narrator": "アーヤ", "text": "冗談でも言っていいことと\n悪い事がありますからね？"},
        { "location": "212/ACT"   , "narrator": "", "text": "やっぱり別のアーヤさんだったか"},
        { "location": "214/TALK"  , "narrator": "アーヤ", "text": "ワケのわからないこと\n言わないで！"},
        { "location": "215/TALK"  , "narrator": "アーヤ", "text": "確かに…負けたけど！\nまさか本当にやれって\n言うとは思わなかったのよ。"},
        { "location": "216/TALK"  , "narrator": "アーヤ", "text": "はぁ……\nもう仕方ないわね。"},
        { "location": "231/TALK"  , "narrator": "アーヤ", "text": "はい、これでいい？"},
        { "location": "232/TALK"  , "narrator": "アーヤ", "text": "これ以上はもう\n絶対無理だから！"},
        { "location": "233/SEL"   , "narrator": "", "text": "ガンプクガンプク"},
        { "location": "234/SEL"   , "narrator": "", "text": "へー、なるほどね"},
        { "location": "235/ACT"   , "narrator": "", "text": "ガンプクガンプク"},
        { "location": "237/TALK"  , "narrator": "アーヤ", "text": "呆れた……。"},
        { "location": "238/TALK"  , "narrator": "アーヤ", "text": "はいはい、\n鼻の下伸ばしてないで、\n仕事仕事。"},
        { "location": "239/ACT"   , "narrator": "", "text": "へー、なるほどね"},
        { "location": "240/TALK"  , "narrator": "アーヤ", "text": "一応私にだって羞恥心は\nあるんですからね？"},
        { "location": "241/TALK"  , "narrator": "アーヤ", "text": "はいはい、\nもう仕事するわよ？"},
        { "location": "247/TALK"  , "narrator": "アーヤ", "text": "それじゃ改めて、\n今回の悩みを\n検索するわね。"},
        { "location": "252/TALK"  , "narrator": "アーヤ", "text": "オープンプロセス、\n0x307番地から\n0xBCF番地へ。"},
        { "location": "267/TALK"  , "narrator": "アーヤ", "text": "シーク完了。"},
        { "location": "270/TALK"  , "narrator": "アーヤ", "text": "さて、と。\n今回は……"},
        { "location": "272/TALK"  , "narrator": "アーヤ", "text": "あー……。"},
        { "location": "273/TALK"  , "narrator": "アーヤ", "text": "確かにこれは\n悩めるところよね。"},
        { "location": "274/TALK"  , "narrator": "アーヤ", "text": "卯月のことは\n本当にわからないこと\nだらけだったし――"},
        { "location": "275/TALK"  , "narrator": "アーヤ", "text": "過去にも何度かお茶して\n話したことあるけど、\n全然わからないのよ。"},
        { "location": "276/TALK"  , "narrator": "アーヤ", "text": "空を掴むような\n感じっていうか。"},
        { "location": "277/TALK"  , "narrator": "アーヤ", "text": "だから今回は、少しでも\n情報を集めた方がいいかな\nって思ったんだけど。"},
        { "location": "278/TALK"  , "narrator": "アーヤ", "text": "でもやっぱり、\n後で後悔しそうなのよね。\nやったことを。"},
        { "location": "279/TALK"  , "narrator": "アーヤ", "text": "だから今回はパス。"},
        { "location": "280/TALK"  , "narrator": "アーヤ", "text": "というわけで、\nその方向で\nお願いしていい？"},
        { "location": "281/SEL"   , "narrator": "", "text": "いいよ"},
        { "location": "282/SEL"   , "narrator": "", "text": "やだ"},
        { "location": "283/ACT"   , "narrator": "", "text": "いいよ"},
        { "location": "284/TALK"  , "narrator": "アーヤ", "text": "ふふ、ありがと。"},
        { "location": "285/ACT"   , "narrator": "", "text": "やだ"},
        { "location": "286/TALK"  , "narrator": "アーヤ", "text": "ええっ！？"},
        { "location": "287/TALK"  , "narrator": "アーヤ", "text": "うーん、やっぱり今日の\n$handle$さんは\n何かヘンね。"},
        { "location": "288/TALK"  , "narrator": "アーヤ", "text": "もしかして貴方、\nなりすましじゃない？\n正直に白状しなさい。"},
        { "location": "289/SEL"   , "narrator": "", "text": "いつもと同じだよ"},
        { "location": "290/SEL"   , "narrator": "", "text": "そっちこそ、前と違う司書でしょ？"},
        { "location": "291/ACT"   , "narrator": "", "text": "いつもと同じだよ"},
        { "location": "292/TALK"  , "narrator": "アーヤ", "text": "どうかしら。"},
        { "location": "293/TALK"  , "narrator": "アーヤ", "text": "とは言っても、\n調べる術はないのよね。"},
        { "location": "294/TALK"  , "narrator": "アーヤ", "text": "とにかく信じてるから、\n例えあなたが同じ人でも\n別人でも――"},
        { "location": "295/TALK"  , "narrator": "アーヤ", "text": "私のココロの平穏の為にも\nクランは倒して！"},
        { "location": "296/SEL"   , "narrator": "", "text": "はい、頑張りますよ"},
        { "location": "297/ACT"   , "narrator": "", "text": "はい、頑張りますよ"},
        { "location": "299/TALK"  , "narrator": "アーヤ", "text": "はぁ、よかった。"},
        { "location": "300/ACT"   , "narrator": "", "text": "そっちこそ、前と違う司書でしょ？"},
        { "location": "301/TALK"  , "narrator": "アーヤ", "text": "はぁ……。\nだから――"},
        { "location": "302/TALK"  , "narrator": "アーヤ", "text": "って、まあその気持ちは\nわからなくないわね。"},
        { "location": "303/TALK"  , "narrator": "アーヤ", "text": "私だって、貴方が別人じゃ\nないかって疑ったり\nしてるワケだし……。"},
        { "location": "304/TALK"  , "narrator": "アーヤ", "text": "お互い、それを確定できる\n証拠すら、ろくに取れない\n状況だもの。"},
        { "location": "305/TALK"  , "narrator": "アーヤ", "text": "とにかく。私は貴方の\nことを信じるから、貴方も\n私を信じて。"},
        { "location": "306/SEL"   , "narrator": "", "text": "はいはい"},
        { "location": "307/ACT"   , "narrator": "", "text": "はいはい"},
        { "location": "309/TALK"  , "narrator": "アーヤ", "text": "はぁ、よかった。"},
        { "location": "313/SEL"   , "narrator": "", "text": "それにしても、判断がガブリエラと正反対で面白い"},
        { "location": "314/ACT"   , "narrator": "", "text": "それにしても、判断がガブリエラと正反対で面白い"},
        { "location": "316/TALK"  , "narrator": "アーヤ", "text": "え？　それって、\nギャヴィも卯月のことで\n悩んでたってこと？"},
        { "location": "317/SEL"   , "narrator": "", "text": "そう。そして「ちゃんと相手を知る」ことを選んでる"},
        { "location": "318/ACT"   , "narrator": "", "text": "そう。そして「ちゃんと相手を知る」ことを選んでる"},
        { "location": "320/TALK"  , "narrator": "アーヤ", "text": "…そうなのね。"},
        { "location": "321/TALK"  , "narrator": "アーヤ", "text": "やっぱりギャヴィは\n凄いわ。"},
        { "location": "322/TALK"  , "narrator": "アーヤ", "text": "貴方はどう思う？"},
        { "location": "323/SEL"   , "narrator": "", "text": "アーヤの考えに近い"},
        { "location": "324/SEL"   , "narrator": "", "text": "ガブリエラの考えに近い"},
        { "location": "325/ACT"   , "narrator": "", "text": "アーヤの考えに近い"},
        { "location": "326/TALK"  , "narrator": "アーヤ", "text": "ふふ、ありがと。\n嘘でも嬉しい。"},
        { "location": "327/TALK"  , "narrator": "アーヤ", "text": "正直、自分のそういう所\n臆病で嫌いなの。"},
        { "location": "328/TALK"  , "narrator": "アーヤ", "text": "でも、そう言って\nもらえると、少しだけ\n許された気がするから。"},
        { "location": "329/TALK"  , "narrator": "アーヤ", "text": "これからも貴方には、\nずっと綾水の傍に\nいて欲しい。"},
        { "location": "330/ACT"   , "narrator": "", "text": "ガブリエラの考えに近い"},
        { "location": "331/TALK"  , "narrator": "アーヤ", "text": "やっぱりそうよね。"},
        { "location": "332/TALK"  , "narrator": "アーヤ", "text": "貴方はギャヴィにとって\nいいパートナーに\nなれると思うわ。"},
        { "location": "333/TALK"  , "narrator": "アーヤ", "text": "あの子の性格や思想は、\n日本で暮らすにはちょっと\n辛いかもって思う。"},
        { "location": "334/TALK"  , "narrator": "アーヤ", "text": "でも、貴方みたいに彼女に\n共感出来る人が傍にいれば\nきっと幸せだと思うの。"},
        { "location": "335/TALK"  , "narrator": "アーヤ", "text": "だから、これからも\nギャヴィのことを\n宜しくお願いね。"},
        { "location": "338/TALK"  , "narrator": "アーヤ", "text": "それじゃ、行くわよ？"},
        { "location": "339/TALK"  , "narrator": "アーヤ", "text": "$handle$さんと\n國政綾水にとって、\n素敵なココロの旅を！"},
        { "location": "22/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>7月27日　2:22 PM</color>\nとある夏休み直前の平日、寮「とらいあんぐる」アーヤの部屋。"},
        { "location": "121/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "123/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "125/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "127/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "129/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"}
    ]
}
