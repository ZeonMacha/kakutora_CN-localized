        "title": "005 メインストーリー",
        "sub_title": "兄弟姉妹の世界線＜後編＞"
    },
    "entry":
    [
        { "location": "465/SCENARIO", "narrator": "", "text": "兄弟姉妹の世界線"},
        { "location": "487/TALK"    , "narrator": "アーヤ", "text": "……。"},
        { "location": "488/TALK"    , "narrator": "みやび", "text": "確認できたかね？"},
        { "location": "491/TALK"    , "narrator": "アーヤ", "text": "ええ。\nありがとう。"},
        { "location": "492/TALK"    , "narrator": "みやび", "text": "私的な内容やと\n最初気付かんかったき\n読んでしもうた。"},
        { "location": "493/TALK"    , "narrator": "みやび", "text": "すまんかったぞね。"},
        { "location": "494/TALK"    , "narrator": "アーヤ", "text": "ああ。\nいいのよそれは。\n気にしないで。"},
        { "location": "495/TALK"    , "narrator": "アーヤ", "text": "…それより…。"},
        { "location": "496/TALK"    , "narrator": "アーヤ", "text": "もしみやびが妹\nだったら。姉はきっと\n楽しかったでしょうね。"},
        { "location": "497/TALK"    , "narrator": "みやび", "text": "うちがエリカさんの\n妹だったら？"},
        { "location": "498/TALK"    , "narrator": "アーヤ", "text": "そう。"},
        { "location": "499/TALK"    , "narrator": "アーヤ", "text": "話も合うし、教えがいも\nあるだろうし。\nみやびも楽しいでしょ？"},
        { "location": "501/TALK"    , "narrator": "みやび", "text": "エリカさんが姉やったら\nうちはハッカーには\nなってないぞね。"},
        { "location": "502/TALK"    , "narrator": "みやび", "text": "やき、楽しくは\nないろうねえ。"},
        { "location": "503/TALK"    , "narrator": "アーヤ", "text": "え？"},
        { "location": "504/TALK"    , "narrator": "みやび", "text": "プロゲーマーか\n天才美人棋士にでも\nなってたろうね。"},
        { "location": "507/TALK"    , "narrator": "アーヤ", "text": "天才美人棋士、って…。"},
        { "location": "509/TALK"    , "narrator": "みやび", "text": "ああ。\n将棋打ちの棋士ぞね。"},
        { "location": "512/TALK"    , "narrator": "アーヤ", "text": "ええと\nそこじゃなくて…。"},
        { "location": "513/SEL"     , "narrator": "", "text": "自分で美人って言う？"},
        { "location": "514/SEL"     , "narrator": "", "text": "自分のこと天才とか言う？"},
        { "location": "515/ACT"     , "narrator": "", "text": "自分で美人って言う？"},
        { "location": "531/TALK"    , "narrator": "アーヤ", "text": "それがみやびの"},
        { "location": "532/TALK"    , "narrator": "アーヤ", "text": "みやびたる所以よ"},
        { "location": "533/ACT"     , "narrator": "", "text": "自分のこと天才とか言う？"},
        { "location": "549/TALK"    , "narrator": "アーヤ", "text": "実際天才だから"},
        { "location": "550/TALK"    , "narrator": "アーヤ", "text": "仕方ないわ"},
        { "location": "552/TALK"    , "narrator": "アーヤ", "text": "でも対応に困るわ、、、"},
        { "location": "554/SEL"     , "narrator": "", "text": "ビシッと突っ込んでよ！"},
        { "location": "555/SEL"     , "narrator": "", "text": "まあみやびらしいけど"},
        { "location": "556/ACT"     , "narrator": "", "text": "ビシッと突っ込んでよ！"},
        { "location": "557/TALK"    , "narrator": "アーヤ", "text": "いちいち言うのも"},
        { "location": "558/TALK"    , "narrator": "アーヤ", "text": "ばからしい気もするわ"},
        { "location": "559/ACT"     , "narrator": "", "text": "まあみやびらしいけど"},
        { "location": "560/TALK"    , "narrator": "アーヤ", "text": "本当そうよね"},
        { "location": "561/TALK"    , "narrator": "アーヤ", "text": "不思議ちゃんなのよ"},
        { "location": "573/TALK"    , "narrator": "みやび", "text": "エリカさんは本物の\n天才やき。"},
        { "location": "574/TALK"    , "narrator": "みやび", "text": "超えられん身内の\n後ろ姿を見続けるのには\n耐えられん。"},
        { "location": "577/TALK"    , "narrator": "アーヤ", "text": "…そういうもの？"},
        { "location": "578/TALK"    , "narrator": "みやび", "text": "アーヤはどうなが？\nもしアーヤの方が\nお姉さんやったら？"},
        { "location": "579/TALK"    , "narrator": "アーヤ", "text": "私が姉だったら…。"},
        { "location": "581/TALK"    , "narrator": "アーヤ", "text": "多分エリカには\n文句ばっかり\n言ってたと思う。"},
        { "location": "582/TALK"    , "narrator": "アーヤ", "text": "とにかく普通にして\n普通にしてって\n強制してた気がする。"},
        { "location": "583/TALK"    , "narrator": "アーヤ", "text": "そのせいで余計\n変人になりそう。"},
        { "location": "584/TALK"    , "narrator": "アーヤ", "text": "ってことは今の方が\nましかもね。"},
        { "location": "585/TALK"    , "narrator": "アーヤ", "text": "ずれてはいるけど\n姉っぽいことを\nしてみたりするし…。"},
        { "location": "586/TALK"    , "narrator": "みやび", "text": "長女にはお手本が\nないきね。"},
        { "location": "588/TALK"    , "narrator": "みやび", "text": "どうしてもそうなって\nしまうぞね。"},
        { "location": "589/TALK"    , "narrator": "アーヤ", "text": "…そうなのかも。"},
        { "location": "590/TALK"    , "narrator": "みやび", "text": "しかもエリカさんは\n普通の思考回路では\nないしねえ。"},
        { "location": "591/TALK"    , "narrator": "みやび", "text": "アーヤが困惑するような\n愛情表現をして\nしまうんやろねえ。"},
        { "location": "592/TALK"    , "narrator": "アーヤ", "text": "そうなのかもね。"},
        { "location": "593/TALK"    , "narrator": "アーヤ", "text": "…やっぱりみやびは\nどんな環境でも\nハッカーになる気がする。"},
        { "location": "594/TALK"    , "narrator": "アーヤ", "text": "なんて、ありえない\n可能性の話をしても\n仕方ないけど。"},
        { "location": "595/TALK"    , "narrator": "みやび", "text": "別の視点から物事を\n見る手段としては\n有効だと思うちや。"},
        { "location": "596/TALK"    , "narrator": "アーヤ", "text": "…そうね。"},
        { "location": "608/TALK"    , "narrator": "アーヤ", "text": "さっきのファイル"},
        { "location": "609/TALK"    , "narrator": "アーヤ", "text": "姉からの私信だったわ"},
        { "location": "610/TALK"    , "narrator": "アーヤ", "text": "あの人なりに"},
        { "location": "611/TALK"    , "narrator": "アーヤ", "text": "私のこと気にしてくれてるみたい"},
        { "location": "612/TALK"    , "narrator": "アーヤ", "text": "理解はしにくいけど"},
        { "location": "614/SEL"     , "narrator": "", "text": "それでもうれしいでしょ"},
        { "location": "615/SEL"     , "narrator": "", "text": "色々あるんだね"},
        { "location": "616/SEL"     , "narrator": "", "text": "アーヤこそ素直になりなよ"},
        { "location": "617/ACT"     , "narrator": "", "text": "それでもうれしいでしょ"},
        { "location": "618/TALK"    , "narrator": "アーヤ", "text": "まあ"},
        { "location": "619/TALK"    , "narrator": "アーヤ", "text": "少しはね"},
        { "location": "620/ACT"     , "narrator": "", "text": "色々あるんだね"},
        { "location": "621/TALK"    , "narrator": "アーヤ", "text": "そりゃ"},
        { "location": "622/TALK"    , "narrator": "アーヤ", "text": "あるわよ"},
        { "location": "623/ACT"     , "narrator": "", "text": "アーヤこそ素直になりなよ"},
        { "location": "624/TALK"    , "narrator": "アーヤ", "text": "何よ"},
        { "location": "625/TALK"    , "narrator": "アーヤ", "text": "もー！"},
        { "location": "637/TALK"    , "narrator": "アーヤ", "text": "色んなことが無事に\n片づいたら\n会えるから。"},
        { "location": "638/TALK"    , "narrator": "アーヤ", "text": "その時はもう少し\n優しくしよう。"},
        { "location": "640/TALK"    , "narrator": "アーヤ", "text": "…かなり努力が\n必要そうだけど…。"},
        { "location": "651/DIALOG"  , "narrator": "Dialog_chapter_ch02", "text": "【23 エクセプション】"}
    ]
}
