        "title": "Extra002 ヒメゴトチャット",
        "sub_title": "詔がまだだから"
    },
    "entry":
    [
        { "location": "4764/SCENARIO", "narrator": "", "text": "詔がまだだから"},
        { "location": "4789/TALK"    , "narrator": "神楽", "text": "詔（みことのり）とは"},
        { "location": "4790/TALK"    , "narrator": "神楽", "text": "天皇の命令、またその命令を直接に伝える文書のことである"},
        { "location": "4792/SEL"     , "narrator": "", "text": "社会科の授業かな？"},
        { "location": "4793/SEL"     , "narrator": "", "text": "テストに出る？"},
        { "location": "4794/SEL"     , "narrator": "", "text": "神楽と$me$の結婚命令が出たの？"},
        { "location": "4795/ACT"     , "narrator": "", "text": "社会科の授業かな？"},
        { "location": "4796/TALK"    , "narrator": "神楽", "text": "あえて言うなら日本史？"},
        { "location": "4797/ACT"     , "narrator": "", "text": "テストに出る？"},
        { "location": "4798/TALK"    , "narrator": "神楽", "text": "出ないんじゃない"},
        { "location": "4799/ACT"     , "narrator": "", "text": "神楽と$me$の結婚命令が出たの？"},
        { "location": "4801/TALK"    , "narrator": "神楽", "text": "出るといいね！"},
        { "location": "4803/TALK"    , "narrator": "神楽", "text": "でも残念！"},
        { "location": "4804/TALK"    , "narrator": "神楽", "text": "そういうのはないんだなー"},
        { "location": "4806/TALK"    , "narrator": "神楽", "text": "何かと言うと"},
        { "location": "4807/TALK"    , "narrator": "神楽", "text": "この街に首都を移す詔は出ないままだったってことなんだけど"},
        { "location": "4809/SEL"     , "narrator": "", "text": "いや出てたよね？"},
        { "location": "4810/SEL"     , "narrator": "", "text": "そっちはそうじゃなかったんだ"},
        { "location": "4811/SEL"     , "narrator": "", "text": "神楽が住んでるだけで首都扱いだよ！"},
        { "location": "4812/ACT"     , "narrator": "", "text": "いや出てたよね？"},
        { "location": "4813/TALK"    , "narrator": "神楽", "text": "公文書扱いじゃないし"},
        { "location": "4814/TALK"    , "narrator": "神楽", "text": "中身だって名称を変更するってだけの話だし"},
        { "location": "4815/TALK"    , "narrator": "神楽", "text": "事実上そうなってるだけって話なんだけどなー"},
        { "location": "4816/ACT"     , "narrator": "", "text": "そっちはそうじゃなかったんだ"},
        { "location": "4817/TALK"    , "narrator": "神楽", "text": "なんか結構ややこしい話になりそうな予感"},
        { "location": "4819/TALK"    , "narrator": "神楽", "text": "やめとこっと"},
        { "location": "4820/ACT"     , "narrator": "", "text": "神楽が住んでるだけで首都扱いだよ！"},
        { "location": "4822/TALK"    , "narrator": "神楽", "text": "いいこと言った！"},
        { "location": "4823/TALK"    , "narrator": "神楽", "text": "それでいいよね？"},
        { "location": "4824/TALK"    , "narrator": "神楽", "text": "よしよし$handlek$"},
        { "location": "4825/TALK"    , "narrator": "神楽", "text": "ぴょんこが許す！これテストに出していいぴょん！"}
    ]
}
