        { "location": "146/SCENARIO", "narrator": "", "text": "024_デジタルと温もり"},
        { "location": "171/TALK"    , "narrator": "つばめ", "text": "そぃえばね"},
        { "location": "172/TALK"    , "narrator": "つばめ", "text": "アキバに変なお店ばっかりあるところがぁったょo(*･ﾛ･*)o"},
        { "location": "174/SEL"     , "narrator": "", "text": "そんな店に行っちゃだめ"},
        { "location": "175/SEL"     , "narrator": "", "text": "変なって？"},
        { "location": "176/ACT"     , "narrator": "", "text": "そんな店に行っちゃだめ"},
        { "location": "177/TALK"    , "narrator": "つばめ", "text": "ぇ(´ｪ｀；)三(；´ｪ｀)"},
        { "location": "179/TALK"    , "narrator": "つばめ", "text": "そぅなの？"},
        { "location": "180/ACT"     , "narrator": "", "text": "変なって？"},
        { "location": "181/TALK"    , "narrator": "つばめ", "text": "ぇっとね(･Д･｀)"},
        { "location": "183/TALK"    , "narrator": "つばめ", "text": "なんかコードばっかりおぃてるぉ店とか"},
        { "location": "184/TALK"    , "narrator": "つばめ", "text": "電球ばっかりおぃてるお店とか"},
        { "location": "185/TALK"    , "narrator": "つばめ", "text": "そぅぃぅの"},
        { "location": "187/SEL"     , "narrator": "", "text": "あー、そっちか"},
        { "location": "188/SEL"     , "narrator": "", "text": "あるよね"},
        { "location": "189/SEL"     , "narrator": "", "text": "元々はそういう店しかなかったんだよ"},
        { "location": "190/ACT"     , "narrator": "", "text": "あー、そっちか"},
        { "location": "191/TALK"    , "narrator": "つばめ", "text": "そっちって"},
        { "location": "192/TALK"    , "narrator": "つばめ", "text": "別のがあるのかな？"},
        { "location": "193/ACT"     , "narrator": "", "text": "あるよね"},
        { "location": "194/TALK"    , "narrator": "つばめ", "text": "やっぱり"},
        { "location": "195/TALK"    , "narrator": "つばめ", "text": "知ってるの"},
        { "location": "196/ACT"     , "narrator": "", "text": "元々はそういう店しかなかったんだよ"},
        { "location": "198/TALK"    , "narrator": "つばめ", "text": "そぅなんだ"},
        { "location": "200/TALK"    , "narrator": "つばめ", "text": "詳しぃねヽ(*´∀｀*)ﾉ"},
        { "location": "202/TALK"    , "narrator": "つばめ", "text": "でね"},
        { "location": "203/TALK"    , "narrator": "つばめ", "text": "買うものはなぃんだけど"},
        { "location": "204/TALK"    , "narrator": "つばめ", "text": "見学するのが面白かったヽ(･ω･ )ゝ✧"},
        { "location": "206/SEL"     , "narrator": "", "text": "商売の邪魔しないようにね"},
        { "location": "207/SEL"     , "narrator": "", "text": "そっか"},
        { "location": "208/SEL"     , "narrator": "", "text": "気になるものがあったら教えて"},
        { "location": "209/ACT"     , "narrator": "", "text": "商売の邪魔しないようにね"},
        { "location": "210/TALK"    , "narrator": "つばめ", "text": "ぁ"},
        { "location": "211/TALK"    , "narrator": "つばめ", "text": "そぅだょね(´・ω・`) "},
        { "location": "212/TALK"    , "narrator": "つばめ", "text": "気を付けますヽ(･ω･ )ゝ☆"},
        { "location": "213/ACT"     , "narrator": "", "text": "そっか"},
        { "location": "214/TALK"    , "narrator": "つばめ", "text": "ぅん"},
        { "location": "215/TALK"    , "narrator": "つばめ", "text": "ぁぁぃぅの中々見れなぃね(*´︶`*)"},
        { "location": "216/ACT"     , "narrator": "", "text": "気になるものがあったら教えて"},
        { "location": "218/TALK"    , "narrator": "つばめ", "text": "なんで？"},
        { "location": "220/TALK"    , "narrator": "つばめ", "text": "ぁ"},
        { "location": "221/TALK"    , "narrator": "つばめ", "text": "色々教えてくれるのかな？"},
        { "location": "222/TALK"    , "narrator": "つばめ", "text": "じゃぁ今度"},
        { "location": "223/TALK"    , "narrator": "つばめ", "text": "教えちゃぅね(・ω<) ﾃﾍﾍﾟﾛ"}
