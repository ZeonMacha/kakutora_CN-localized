{
    "dir": "chap00/daydra/spev_comike_2018_030.js",
    "type": "",
    "info": {
        "story_id": "91073",
        "cid": "",
        "title": "がすとちゃんサマー大作戦♪",
        "sub_title": "作戦３：ソラノキヲク秘密の打合せ♪"
    },
    "entry":
    [
        { "location": "695/SCENARIO", "narrator": "", "text": "メノウ"},
        { "location": "715/DIALOG"  , "narrator": "", "text": "このエピソードは、とある夜のWAVEによる打ち合わせをそのまま記録したものです。\n\n一部、ネタバレ要素であると感じてしまう箇所もあるかもしれませんので、視聴は自己責任でお願いします。\n\nエピソードを見ますか？"},
        { "location": "721/TALK"    , "narrator": "神楽", "text": "んーと…"},
        { "location": "722/TALK"    , "narrator": "神楽", "text": "『FreyMENOWとして、\nファンの皆様へ』"},
        { "location": "723/TALK"    , "narrator": "神楽", "text": "『卯月神楽として、\nトライナリーのみんなへ』"},
        { "location": "724/TALK"    , "narrator": "神楽", "text": "……。"},
        { "location": "725/TALK"    , "narrator": "神楽", "text": "『そして』"},
        { "location": "726/TALK"    , "narrator": "神楽", "text": "『遠い彼方の世界にいる』"},
        { "location": "727/TALK"    , "narrator": "神楽", "text": "………。"},
        { "location": "728/TALK"    , "narrator": "神楽", "text": "『私の大切な人へ』"},
        { "location": "729/TALK"    , "narrator": "神楽", "text": "……うーん、\nどうしよ……。"},
        { "location": "730/TALK"    , "narrator": "神楽", "text": "ちょっと電波？\nていうか、"},
        { "location": "731/TALK"    , "narrator": "神楽", "text": "なんかこれだと\n恋人いる宣言みたいかな…"},
        { "location": "732/TALK"    , "narrator": "神楽", "text": "……。"},
        { "location": "733/TALK"    , "narrator": "神楽", "text": "まあ、恋愛禁止の\nアイドルじゃ\nあるまいし――"},
        { "location": "734/TALK"    , "narrator": "神楽", "text": "うーん……でも、"},
        { "location": "735/TALK"    , "narrator": "神楽", "text": "やっぱり\n発狂する人\n出るかなぁ。"},
        { "location": "736/TALK"    , "narrator": "神楽", "text": "ほんと、\n後書きって難しい。"},
        { "location": "743/TALK"    , "narrator": "SAKI@USS", "text": "こんばんは、アップサイドの早希です。"},
        { "location": "745/TALK"    , "narrator": "神楽", "text": "こんばんは～"},
        { "location": "747/TALK"    , "narrator": "SAKI@USS", "text": "早速ですが、色校上がりましたのでご確認お願いします。"},
        { "location": "748/TALK"    , "narrator": "神楽", "text": "ほんとですか！早く！！"},
        { "location": "750/TALK"    , "narrator": "SAKI@USS", "text": "ジャケです。"},
        { "location": "751/TALK"    , "narrator": "SAKI@USS", "text": "デザイナーから上がってきたのはもっと原色でしたけど、歌詞が絵の具をテーマにしていましたので、淡い感じに修正してもらいました。如何ですか？"},
        { "location": "752/TALK"    , "narrator": "神楽", "text": "すごく素敵です！！"},
        { "location": "753/TALK"    , "narrator": "神楽", "text": "これで！"},
        { "location": "755/TALK"    , "narrator": "SAKI@USS", "text": "承知しました。では次に"},
        { "location": "756/TALK"    , "narrator": "SAKI@USS", "text": "ブックですね"},
        { "location": "757/TALK"    , "narrator": "SAKI@USS", "text": "絵本と同じ仕様の上製本ですので、１C箔押し風印刷です。箔ではありませんが、高級感と渋みを前に押し出す感じにしてみました"},
        { "location": "758/TALK"    , "narrator": "神楽", "text": "すごーーーーい！"},
        { "location": "760/TALK"    , "narrator": "SAKI@USS", "text": "ではこれで。"},
        { "location": "761/TALK"    , "narrator": "SAKI@USS", "text": "CDのレーベル面です。"},
        { "location": "762/TALK"    , "narrator": "SAKI@USS", "text": "これだけ入稿が早いので、このWAVEでFIXとさせて欲しいのですが、問題有ればすぐに突っ込み入れて下さい。"},
        { "location": "763/TALK"    , "narrator": "神楽", "text": "かわいい！！"},
        { "location": "764/TALK"    , "narrator": "神楽", "text": "ていうか、もしかしてこれって"},
        { "location": "765/TALK"    , "narrator": "神楽", "text": "あれですか！？！？"},
        { "location": "766/TALK"    , "narrator": "神楽", "text": "イルカの置物あるし！！"},
        { "location": "768/TALK"    , "narrator": "SAKI@USS", "text": "気づいてもらえてよかったです。アレですね。"},
        { "location": "769/TALK"    , "narrator": "神楽", "text": "すごい！！！ちょっと感動しました。そうきたか！"},
        { "location": "770/TALK"    , "narrator": "神楽", "text": "これ、皆さんすごい感動すると思います！よく考えつきましたね、さすが早希さん"},
        { "location": "772/TALK"    , "narrator": "SAKI@USS", "text": "いえ、何となく今までのメノウさんの傾向から、こういうのが良いのかなと思いまして。ちょっと博打でしたが、喜んでもらえて何よりです。"},
        { "location": "773/TALK"    , "narrator": "神楽", "text": "喜びました！とても！！"},
        { "location": "775/TALK"    , "narrator": "SAKI@USS", "text": "ありがとうございます。ではこれで進めても？"},
        { "location": "776/TALK"    , "narrator": "神楽", "text": "是非！！"},
        { "location": "778/TALK"    , "narrator": "SAKI@USS", "text": "では進めます。"},
        { "location": "779/TALK"    , "narrator": "SAKI@USS", "text": "というわけで、本文以外はこれでFIXですね、"},
        { "location": "780/TALK"    , "narrator": "SAKI@USS", "text": "残りは本文なのですが"},
        { "location": "781/TALK"    , "narrator": "SAKI@USS", "text": "現在、物語は既に戴いてますので、残りはメノウさんの後書きと、奥付ですね。"},
        { "location": "782/TALK"    , "narrator": "SAKI@USS", "text": "後書きは明日の朝が〆切ですが、何とかなりそうでしょうか？"},
        { "location": "783/TALK"    , "narrator": "神楽", "text": "大丈夫だと思います。今半分くらい書き上げましたので"},
        { "location": "784/TALK"    , "narrator": "神楽", "text": "ところで、丁度いいのでひとつご意見を伺いたいのですけど"},
        { "location": "786/TALK"    , "narrator": "SAKI@USS", "text": "もちろんです"},
        { "location": "787/TALK"    , "narrator": "神楽", "text": "『そして、遠い彼方の世界にいる、私の大切な人へ――』"},
        { "location": "788/TALK"    , "narrator": "神楽", "text": "これ、ファン視点で見たときに、どう思います？危険ですかね？"},
        { "location": "791/TALK"    , "narrator": "SAKI@USS", "text": "私の主観ですが、恐らくはさほど大きな問題にはならないかと思います。決定的なことは言ってませんから、何か炎上が発生しても、ファンの方の自浄作用が働くかと"},
        { "location": "792/TALK"    , "narrator": "SAKI@USS", "text": "あ、ちなみに、"},
        { "location": "793/TALK"    , "narrator": "SAKI@USS", "text": "これって、あの方の事ですよね？メノウさんがいつも仰ってる、別世界の"},
        { "location": "795/TALK"    , "narrator": "神楽", "text": "そうですそうです！"},
        { "location": "796/TALK"    , "narrator": "神楽", "text": "今回、異世界盤も同時リリースしますよね、だからどうしても伝えたいんですけど"},
        { "location": "797/TALK"    , "narrator": "神楽", "text": "本音を言えば、ファンの皆さんにも私のことをちゃんと知って欲しくて"},
        { "location": "798/TALK"    , "narrator": "神楽", "text": "ほら、新しい事務所作ったのだって、そういう想いからですし、一貫したものにしたいなって"},
        { "location": "800/TALK"    , "narrator": "SAKI@USS", "text": "想いはわかります"},
        { "location": "801/TALK"    , "narrator": "神楽", "text": "なので、わりとチャレンジャーなのは承知の上ですが"},
        { "location": "803/TALK"    , "narrator": "SAKI@USS", "text": "そこまでお考えであれば、全く問題無いかと思います"},
        { "location": "804/TALK"    , "narrator": "SAKI@USS", "text": "むしろ、そこまで想われている彼方の大切な人が羨ましい限りです"},
        { "location": "805/TALK"    , "narrator": "神楽", "text": "むー"},
        { "location": "806/TALK"    , "narrator": "神楽", "text": "ちょっと恥ずかしいのでやめてください！"},
        { "location": "808/TALK"    , "narrator": "SAKI@USS", "text": "独身女へのお駄賃だと想っていただければ"},
        { "location": "809/TALK"    , "narrator": "神楽", "text": "早希さん美人なんですから、すぐにいい人見つかりますよ"},
        { "location": "810/TALK"    , "narrator": "神楽", "text": "ていうか、私当ててあげましょうか"},
        { "location": "812/TALK"    , "narrator": "SAKI@USS", "text": "どっきりどきどき"},
        { "location": "813/TALK"    , "narrator": "神楽", "text": "自分からわざと恋人作らないようにしてますよね"},
        { "location": "815/TALK"    , "narrator": "SAKI@USS", "text": "仕事相手とは厳禁ですから"},
        { "location": "816/TALK"    , "narrator": "神楽", "text": "それ、わかります"},
        { "location": "817/TALK"    , "narrator": "神楽", "text": "私もそう思ってましたし今もそう思ってますしおすし"},
        { "location": "819/TALK"    , "narrator": "SAKI@USS", "text": "鉄則ですよね"},
        { "location": "820/TALK"    , "narrator": "SAKI@USS", "text": "物語に関しては校正がてら一通り拝読させていただきました。今回も素敵な幻想世界でした！"},
        { "location": "821/TALK"    , "narrator": "SAKI@USS", "text": "物語や演出の疑問点については、後で、MAに関することと一緒にWAVデータで質問させていただきます。"},
        { "location": "822/TALK"    , "narrator": "神楽", "text": "ありがとうございます！"},
        { "location": "824/TALK"    , "narrator": "SAKI@USS", "text": "ところで、気づいてしまったのですが、アレって逆さまに読むとアレですよね"},
        { "location": "826/TALK"    , "narrator": "神楽", "text": "おーーーー！"},
        { "location": "827/TALK"    , "narrator": "神楽", "text": "すごいですね早希さんそこに気づくとはシビアコですっ！"},
        { "location": "829/TALK"    , "narrator": "SAKI@USS", "text": "長いの見た時に、正気か？と思いましたが、いやまて、と思いまして。"},
        { "location": "831/TALK"    , "narrator": "神楽", "text": "ダテにメノウ専属ずっとやってませんね～ふふふ"},
        { "location": "834/TALK"    , "narrator": "SAKI@USS", "text": "ダテでなくて良かったです"},
        { "location": "835/TALK"    , "narrator": "SAKI@USS", "text": "音源も聴かせていただきました"},
        { "location": "836/TALK"    , "narrator": "神楽", "text": "どうでしたか？"},
        { "location": "838/TALK"    , "narrator": "SAKI@USS", "text": "よくあんなに沢山喋りましたね。確かスタジオ３ｈしか押さえてなかったのでは？"},
        { "location": "839/TALK"    , "narrator": "神楽", "text": "バッチコーイですよ"},
        { "location": "840/TALK"    , "narrator": "神楽", "text": "主旋律30分ハモ15分多重1時間、語り１時間でファイナルアンサー！"},
        { "location": "842/TALK"    , "narrator": "SAKI@USS", "text": "さすがです、私もまた現場お邪魔したかったです"},
        { "location": "843/TALK"    , "narrator": "神楽", "text": "今回レーベル違いますからね、でも会社有給とって友人扱いで来て頂いても良かったんですよ？？ふふふ～"},
        { "location": "845/TALK"    , "narrator": "SAKI@USS", "text": "当日は外せない会議が２件有りましたので"},
        { "location": "846/TALK"    , "narrator": "神楽", "text": "わかってます"},
        { "location": "848/TALK"    , "narrator": "SAKI@USS", "text": "それで早速、幾つかの物語における疑問点等なのですが"},
        { "location": "849/TALK"    , "narrator": "神楽", "text": "よろしくお願いします"},
        { "location": "851/TALK"    , "narrator": "システム", "text": "音声ファイルを送りました\n【clip001.wav】"},
        { "location": "856/TALK"    , "narrator": "SAKI@USS", "text": "この冒頭の部分ですが、BGMからの入りになってるところ、音量調整ナシで大丈夫ですか？"},
        { "location": "857/TALK"    , "narrator": "SAKI@USS", "text": "わりと最初のところは大きめにして、語りが入ったら絞る形が一般的かと思いました"},
        { "location": "858/TALK"    , "narrator": "神楽", "text": "ですよねー、ただ、そこはあまりそうしたくなくて"},
        { "location": "859/TALK"    , "narrator": "神楽", "text": "あくまでピアノと語り部の朗読ステージみたいな感じを出したくて"},
        { "location": "861/TALK"    , "narrator": "SAKI@USS", "text": "ああ、吟遊詩人的な？"},
        { "location": "862/TALK"    , "narrator": "神楽", "text": "似たようなものですね"},
        { "location": "863/TALK"    , "narrator": "神楽", "text": "逆にラストはそうしてましたよね、アレは演出だからです"},
        { "location": "865/TALK"    , "narrator": "SAKI@USS", "text": "承知しました"},
        { "location": "866/TALK"    , "narrator": "SAKI@USS", "text": "では次ですが"},
        { "location": "867/TALK"    , "narrator": "システム", "text": "音声ファイルを送りました\n【clip002.wav】"},
        { "location": "872/TALK"    , "narrator": "SAKI@USS", "text": "これ、比喩長くないですか？"},
        { "location": "873/TALK"    , "narrator": "神楽", "text": "あー"},
        { "location": "874/TALK"    , "narrator": "神楽", "text": "あーあーあー"},
        { "location": "876/TALK"    , "narrator": "SAKI@USS", "text": "失言？"},
        { "location": "877/TALK"    , "narrator": "神楽", "text": "いえ"},
        { "location": "878/TALK"    , "narrator": "神楽", "text": "よくわかるので"},
        { "location": "879/TALK"    , "narrator": "神楽", "text": "ここ悩んだんですよね、とっちゃおうかとも思ったんですけど"},
        { "location": "880/TALK"    , "narrator": "神楽", "text": "いや、ていうか、書きながら、アップサイドでのリリースだったら絶対これ無いだろうなーって思って書いていたんですけど"},
        { "location": "882/TALK"    , "narrator": "SAKI@USS", "text": "なるほど"},
        { "location": "883/TALK"    , "narrator": "神楽", "text": "今回は自主レーベルなので、スキにやらせて頂きました"},
        { "location": "884/TALK"    , "narrator": "神楽", "text": "要するに、"},
        { "location": "885/TALK"    , "narrator": "神楽", "text": "スキなんだからいいじゃねえかよー！それが答えだ！"},
        { "location": "886/TALK"    , "narrator": "神楽", "text": "という奴です、すみません"},
        { "location": "888/TALK"    , "narrator": "SAKI@USS", "text": "いえ、いいんですよ。今まで通りのツッコミを入れてるだけですし"},
        { "location": "889/TALK"    , "narrator": "SAKI@USS", "text": "好きなものをお作りになるのが良いかと思います"},
        { "location": "890/TALK"    , "narrator": "SAKI@USS", "text": "もう、誰もそれを曲げる人はいませんから"},
        { "location": "891/TALK"    , "narrator": "神楽", "text": "ふふふ～♪"},
        { "location": "893/TALK"    , "narrator": "SAKI@USS", "text": "で、次が最後で"},
        { "location": "894/TALK"    , "narrator": "システム", "text": "音声ファイルを送りました\n【clip003.wav】"},
        { "location": "899/TALK"    , "narrator": "SAKI@USS", "text": "ここ、かなりチャレンジャーだなと思いました"},
        { "location": "900/TALK"    , "narrator": "神楽", "text": "大事な事なんです"},
        { "location": "902/TALK"    , "narrator": "SAKI@USS", "text": "わかります"},
        { "location": "903/TALK"    , "narrator": "SAKI@USS", "text": "ただ"},
        { "location": "904/TALK"    , "narrator": "SAKI@USS", "text": "メノウさんがこれを本当に伝えたい方に伝わったとき、場合によっては結構お辛いかとも思いましたので"},
        { "location": "905/TALK"    , "narrator": "神楽", "text": "ですね"},
        { "location": "906/TALK"    , "narrator": "神楽", "text": "全て承知の上です"},
        { "location": "907/TALK"    , "narrator": "神楽", "text": "その後の展開も含めて、全部自分の正直な想いだから、丸めずに直球で勝負することにしました"},
        { "location": "908/TALK"    , "narrator": "神楽", "text": "それがネイエ流です"},
        { "location": "910/TALK"    , "narrator": "SAKI@USS", "text": "わかりました"},
        { "location": "911/TALK"    , "narrator": "SAKI@USS", "text": "随分と方針を変えられたんですね"},
        { "location": "912/TALK"    , "narrator": "神楽", "text": "もう実名も出しますしね"},
        { "location": "914/TALK"    , "narrator": "SAKI@USS", "text": "正直驚きを隠せないでいます。それだけメノウさんにとって重大な転機があったのでしょうけど"},
        { "location": "915/TALK"    , "narrator": "神楽", "text": "察して下さい"},
        { "location": "917/TALK"    , "narrator": "SAKI@USS", "text": "大丈夫です"},
        { "location": "918/TALK"    , "narrator": "SAKI@USS", "text": "私からは、ソラノキヲクに関しては以上です"},
        { "location": "919/TALK"    , "narrator": "神楽", "text": "ありがとうございました！"},
        { "location": "920/TALK"    , "narrator": "神楽", "text": "ごめんなさい、全然お給料にもならない事をお願いしてしまって"},
        { "location": "922/TALK"    , "narrator": "SAKI@USS", "text": "好きでやってますから、お気になさりませぬよう"},
        { "location": "923/TALK"    , "narrator": "SAKI@USS", "text": "色校データも会社には一切持っていっていませんので、ご心配なく"},
        { "location": "924/TALK"    , "narrator": "神楽", "text": "その辺は全然心配してないので大丈夫です！"},
        { "location": "925/TALK"    , "narrator": "神楽", "text": "それより心配なことが！"},
        { "location": "927/TALK"    , "narrator": "SAKI@USS", "text": "なんでしょうか？"},
        { "location": "928/TALK"    , "narrator": "神楽", "text": "本当に来れますか？"},
        { "location": "930/TALK"    , "narrator": "SAKI@USS", "text": "あの話ですよね"},
        { "location": "931/TALK"    , "narrator": "SAKI@USS", "text": "大丈夫です、ただ、あと１週間待ってください"},
        { "location": "932/TALK"    , "narrator": "SAKI@USS", "text": "外堀を固めてからでないと、色々危険なので"},
        { "location": "933/TALK"    , "narrator": "神楽", "text": "さすが早希さん"},
        { "location": "934/TALK"    , "narrator": "神楽", "text": "そういうの、色々教わりたいです"},
        { "location": "936/TALK"    , "narrator": "SAKI@USS", "text": "お役に立てるなら"},
        { "location": "937/TALK"    , "narrator": "神楽", "text": "立てます立てます！"},
        { "location": "938/TALK"    , "narrator": "神楽", "text": "早く来てくださいねっ！！"},
        { "location": "939/TALK"    , "narrator": "神楽", "text": "最高の紅茶とケーキを用意してお待ちしております♪"},
        { "location": "941/TALK"    , "narrator": "SAKI@USS", "text": "ありがとうございます"},
        { "location": "942/TALK"    , "narrator": "SAKI@USS", "text": "それでは本日は、これで失礼致します。まだ本業が残ってますので"},
        { "location": "943/TALK"    , "narrator": "神楽", "text": "お疲れさまです、、"},
        { "location": "946/TALK"    , "narrator": "SAKI@USS", "text": "今度お薦めスタンプ紹介してください"},
        { "location": "952/TALK"    , "narrator": "神楽", "text": "ふぅ…。"},
        { "location": "953/TALK"    , "narrator": "神楽", "text": "よーし、\n頑張って後書き\n書いちゃおう！"},
        { "location": "955/TALK"    , "narrator": "神楽", "text": "書きたいことが\nそのまま書けるって\n幸せなことなのね。"},
        { "location": "957/TALK"    , "narrator": "神楽", "text": "『沢山の、私にとっての\n大切な人達へ、\nこの物語が――』"},
        { "location": "961/DIALOG"  , "narrator": "", "text": "$handlek$。\n\nあなたの元に、\nこの想いが\n届きますように。"},
        { "location": "962/DIALOG"  , "narrator": "", "text": "そしていつか二人で、\n真っ白な空に描きましょうね。\n\n二人の想い出を――。"},
        { "location": "965/DIALOG"  , "narrator": "", "text": "KADOKAWAブース\nCD『ソラノキヲク』の\n詳細情報を見ますか？"}
    ]
}
