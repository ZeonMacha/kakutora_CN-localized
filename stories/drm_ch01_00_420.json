{
    "dir": "dramatics/daydra/drm_ch01_00_420.js",
    "type": "Episode",
    "info": {
        "story_id": "1042",
        "cid": "tsubame",
        "title": "らぶとーく 第42話",
        "sub_title": "探究心のその先は"
    },
    "entry":
    [
        { "location": "115/SCENARIO", "narrator": "", "text": "探究心のその先は"},
        { "location": "127/TALK"    , "narrator": "みやび", "text": "…あれ？\nつばめちゃん、休憩？"},
        { "location": "128/TALK"    , "narrator": "つばめ", "text": "はい。\n丁度お茶を入れようと\n思ってたんですけど――"},
        { "location": "129/TALK"    , "narrator": "つばめ", "text": "みやびさんもどうですか？"},
        { "location": "131/TALK"    , "narrator": "みやび", "text": "うちはえいよ。"},
        { "location": "132/TALK"    , "narrator": "みやび", "text": "それより、つばめちゃんに\n聞きたいことがあるがよ。"},
        { "location": "133/TALK"    , "narrator": "つばめ", "text": "わたしに、ですか？"},
        { "location": "134/TALK"    , "narrator": "みやび", "text": "うん…つばめちゃんは、\nうちが思うていた以上に、\n探求心を持っているやろ？"},
        { "location": "135/TALK"    , "narrator": "つばめ", "text": "そ、そうですか？\n自分ではわからないん\nですけど…。"},
        { "location": "136/TALK"    , "narrator": "みやび", "text": "気付いとらんかったか。\nまあ、つばめちゃん\nらしくはあるけんど――"},
        { "location": "137/TALK"    , "narrator": "みやび", "text": "Ｂｏｔのこと然り、\n卯月のこと然り――"},
        { "location": "138/TALK"    , "narrator": "みやび", "text": "探求心が強いき、\n肩入れが過ぎるんや\nないが？"},
        { "location": "139/TALK"    , "narrator": "つばめ", "text": "…そう、なんでしょうか？"},
        { "location": "140/TALK"    , "narrator": "みやび", "text": "少なくとも、\nうちはそう思うてる。"},
        { "location": "141/TALK"    , "narrator": "みやび", "text": "けんど、肩入れするんは\nつばめちゃんの自由や\nけんど――"},
        { "location": "142/TALK"    , "narrator": "みやび", "text": "その先に、１００％の\n理解は存在すると思う？"},
        { "location": "144/TALK"    , "narrator": "つばめ", "text": "？　す、すみません。\nどういう意味ですか？"},
        { "location": "145/TALK"    , "narrator": "みやび", "text": "１００％わかりあうことが\nできるんか、っちゅう\nことや。"},
        { "location": "146/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "147/TALK"    , "narrator": "みやび", "text": "まあ、答えたくないなら\n答えんでもえいよ。"},
        { "location": "148/TALK"    , "narrator": "みやび", "text": "ちっくと興味があって\n聞いただけやき。"},
        { "location": "149/TALK"    , "narrator": "みやび", "text": "考えまとまったらで\nえいき、答えてもらえると\n嬉しいちや。"},
        { "location": "151/TALK"    , "narrator": "つばめ", "text": "…どうなんだろ？\nわたしの思ってること、\n変なのかな？"},
        { "location": "163/TALK"    , "narrator": "つばめ", "text": "聞きたぃことがあるの"},
        { "location": "164/TALK"    , "narrator": "つばめ", "text": "探求心の先に１００％の理解はあるのかって"},
        { "location": "165/TALK"    , "narrator": "つばめ", "text": "みやびさんの聞かれたの"},
        { "location": "166/TALK"    , "narrator": "つばめ", "text": "わたしはぁると思ぅんだけど"},
        { "location": "167/TALK"    , "narrator": "つばめ", "text": "ぉかしくなぃよね？(´・ω・｀)"},
        { "location": "169/SEL"     , "narrator": "", "text": "あるの？"},
        { "location": "170/SEL"     , "narrator": "", "text": "わかりあえないものだと思う"},
        { "location": "171/SEL"     , "narrator": "", "text": "理解しあえてると思うけど？"},
        { "location": "172/ACT"     , "narrator": "", "text": "あるの？"},
        { "location": "173/TALK"    , "narrator": "つばめ", "text": "わたしはぁると思ってる"},
        { "location": "174/TALK"    , "narrator": "つばめ", "text": "だって"},
        { "location": "175/TALK"    , "narrator": "つばめ", "text": "わたしは知りたぃもの"},
        { "location": "186/TALK"    , "narrator": "つばめ", "text": "…わたしは、\nあると思ってます。"},
        { "location": "187/TALK"    , "narrator": "みやび", "text": "ほう…なんでや？"},
        { "location": "188/TALK"    , "narrator": "つばめ", "text": "だって、理解し合うことが\n出来なかったら、\n寂しいじゃないですか。"},
        { "location": "189/TALK"    , "narrator": "つばめ", "text": "それに、そう思ってるから\nこそ、知りたい、って\n思うんですし…。"},
        { "location": "190/TALK"    , "narrator": "みやび", "text": "…なるほど。"},
        { "location": "191/TALK"    , "narrator": "みやび", "text": "相手を１００％理解する\nいうことはできる。"},
        { "location": "192/TALK"    , "narrator": "みやび", "text": "つばめちゃんは、\nそう思うとるんやね？"},
        { "location": "193/TALK"    , "narrator": "つばめ", "text": "…はい。"},
        { "location": "194/TALK"    , "narrator": "みやび", "text": "…それが、つばめちゃんの\n考えいうことやね。"},
        { "location": "196/TALK"    , "narrator": "みやび", "text": "それを聞けてスッキリ\nしたちや。\nありがとな。"},
        { "location": "200/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "201/TALK"    , "narrator": "つばめ", "text": "わたし、間違って\nないよね？"},
        { "location": "202/ACT"     , "narrator": "", "text": "わかりあえないものだと思う"},
        { "location": "203/TALK"    , "narrator": "つばめ", "text": "$handle$さんはそぅ思ぅの？"},
        { "location": "204/TALK"    , "narrator": "つばめ", "text": "そぅなのかな？(; ;)"},
        { "location": "215/TALK"    , "narrator": "つばめ", "text": "…みやびさんは――"},
        { "location": "216/TALK"    , "narrator": "つばめ", "text": "分かり合えないと思ってる\nから、そんな質問を\nしたんですか？"},
        { "location": "218/TALK"    , "narrator": "みやび", "text": "…さあ、どうやろね？"},
        { "location": "219/TALK"    , "narrator": "みやび", "text": "ただ、つばめちゃんが\nどう思うてるか気になった\nだけやき――"},
        { "location": "221/TALK"    , "narrator": "みやび", "text": "うち自身は、そんなこと\n考えたことないのかも\nしれん。"},
        { "location": "222/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "223/TALK"    , "narrator": "みやび", "text": "まあ、望んでいた答えや\nないけんど、答えては\nくれたき――"},
        { "location": "225/TALK"    , "narrator": "みやび", "text": "それで満足するちや。"},
        { "location": "228/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "229/TALK"    , "narrator": "つばめ", "text": "やっぱり、分かり合え\nないって思ってるのかな？"},
        { "location": "230/ACT"     , "narrator": "", "text": "理解しあえてると思うけど？"},
        { "location": "231/TALK"    , "narrator": "つばめ", "text": "$handle$さんはそぅ思ぅの？"},
        { "location": "232/TALK"    , "narrator": "つばめ", "text": "残念だけど"},
        { "location": "233/TALK"    , "narrator": "つばめ", "text": "それはなぃと思ぅよ(；´Д｀)"},
        { "location": "244/TALK"    , "narrator": "つばめ", "text": "…あの、みやびさん。"},
        { "location": "245/TALK"    , "narrator": "つばめ", "text": "理解とか、わかりあうって\nことを――"},
        { "location": "246/TALK"    , "narrator": "つばめ", "text": "数値で言えるもの\nなんですか？"},
        { "location": "247/TALK"    , "narrator": "みやび", "text": "じゃあ言い方変えて、\n完璧に理解できると\n思う？"},
        { "location": "249/TALK"    , "narrator": "つばめ", "text": "えぇっ！？"},
        { "location": "250/TALK"    , "narrator": "みやび", "text": "別に数値で教えてほしい\n言うてるわけやないんよ。"},
        { "location": "251/TALK"    , "narrator": "みやび", "text": "肩入れすることで、\n相手をちゃんと理解\nできるんか――"},
        { "location": "252/TALK"    , "narrator": "みやび", "text": "それを聞きたいだけや。\n数値を知りたいわけや\nない。"},
        { "location": "253/TALK"    , "narrator": "つばめ", "text": "は、はあ…そういうこと\nですか…。"},
        { "location": "254/TALK"    , "narrator": "みやび", "text": "まあ、今のつばめちゃんの\n答えで、大体はわかった\nちや。"},
        { "location": "255/TALK"    , "narrator": "つばめ", "text": "えっ、もういいんですか？"},
        { "location": "256/TALK"    , "narrator": "みやび", "text": "うん、十分や。"},
        { "location": "257/TALK"    , "narrator": "みやび", "text": "変な質問して\nすまんかったね。"},
        { "location": "260/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "262/TALK"    , "narrator": "つばめ", "text": "本当に、ちゃんと\nわかってもらえたのかな？"},
        { "location": "125/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>8月某日　 3:20 PM</color>\n合宿中、みやびの実家でのこと"}
    ]
}
