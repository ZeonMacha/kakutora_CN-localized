{
    "dir": "chap16/daydra/dd_ch02_16_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "16202",
        "cid": "ayami",
        "title": "002 メインストーリー",
        "sub_title": "誰でもない父だから＜前編＞"
    },
    "entry":
    [
        { "location": "33/TALK"   , "narrator": "神楽", "text": "つばめさん。\nこの新刊なんか\nよさそうですよ。"},
        { "location": "35/TALK"   , "narrator": "つばめ", "text": "ちょ！？　卯月さん！\nこんなの\n読んでるの？"},
        { "location": "36/TALK"   , "narrator": "神楽", "text": "んー……。\nこれはまだ全年齢向け\nみたいですから。"},
        { "location": "38/TALK"   , "narrator": "神楽", "text": "私たちが読んでも\nたぶん問題は\nありませんよ。"},
        { "location": "41/TALK"   , "narrator": "つばめ", "text": "そ、そうなのかなぁ？"},
        { "location": "43/TALK"   , "narrator": "神楽", "text": "ほら、つばめさん。\n次は向こうの棚を\n見に行きましょう。"},
        { "location": "63/TALK"   , "narrator": "アーヤ", "text": "はぁ…。"},
        { "location": "64/TALK"   , "narrator": "アーヤ", "text": "せっかくのお休み\nだったのに…。"},
        { "location": "65/TALK"   , "narrator": "啓介", "text": "くっ、なんと狭くて\n歩きにくい本屋だ。"},
        { "location": "67/TALK"   , "narrator": "啓介", "text": "しかも、どれもこれも\n薄い割に恐ろしく高い\n本ばかりだ。"},
        { "location": "70/TALK"   , "narrator": "啓介", "text": "こんな店に、\nつばめは何をしに\n来ているんだ？"},
        { "location": "71/TALK"   , "narrator": "アーヤ", "text": "…………。"},
        { "location": "72/SEL"    , "narrator": "", "text": "どういう状況？"},
        { "location": "73/SEL"    , "narrator": "", "text": "不倫はダメだ！"},
        { "location": "74/ACT"    , "narrator": "", "text": "どういう状況？"},
        { "location": "90/TALK"   , "narrator": "アーヤ", "text": "タスケテー(T_T)"},
        { "location": "91/TALK"   , "narrator": "アーヤ", "text": "まさか"},
        { "location": "92/TALK"   , "narrator": "アーヤ", "text": "こんなことになるとは思わなくて"},
        { "location": "94/TALK"   , "narrator": "アーヤ", "text": "実は…"},
        { "location": "105/ACT"   , "narrator": "", "text": "不倫はダメだ！"},
        { "location": "121/TALK"  , "narrator": "アーヤ", "text": "不倫なわけないでしょ(--#)"},
        { "location": "122/TALK"  , "narrator": "アーヤ", "text": "そうじゃなくて"},
        { "location": "123/TALK"  , "narrator": "アーヤ", "text": "実は…"},
        { "location": "165/TALK"  , "narrator": "つばめ", "text": "お待たせー。\n今日はよろしくね。"},
        { "location": "167/TALK"  , "narrator": "神楽", "text": "任せてください。\n面白いお店を\n色々紹介しますね！"},
        { "location": "170/TALK"  , "narrator": "アーヤ", "text": "あら？　二人とも\n出かけるの？"},
        { "location": "172/TALK"  , "narrator": "つばめ", "text": "はい。卯月さんに、\n秋葉原を案内して\nもらうんです。"},
        { "location": "173/TALK"  , "narrator": "アーヤ", "text": "そう…、\n楽しんできてね。"},
        { "location": "174/TALK"  , "narrator": "つばめ", "text": "はい！\n卯月さん、行こ。"},
        { "location": "181/TALK"  , "narrator": "アーヤ", "text": "…さてと、私もバイク\n持ってこなきゃ。"},
        { "location": "185/TALK"  , "narrator": "アーヤ", "text": "視線…後ろから！？"},
        { "location": "188/TALK"  , "narrator": "アーヤ", "text": "そこ！　路地裏に\n隠れてる不審者、\n出てきなさい！"},
        { "location": "189/TALK"  , "narrator": "アーヤ", "text": "言うとおりにしないと\n通報するわよ！"},
        { "location": "193/TALK"  , "narrator": "啓介", "text": "いや、待ってくれ。"},
        { "location": "195/TALK"  , "narrator": "啓介", "text": "…疑わしいことを\nしたのは謝るが、\n不審者ではない。"},
        { "location": "197/TALK"  , "narrator": "アーヤ", "text": "えっ！？\nつばめのお父さんじゃ\nないですか！"},
        { "location": "198/TALK"  , "narrator": "アーヤ", "text": "こんなところで\n何をしてるんですか？"},
        { "location": "199/TALK"  , "narrator": "アーヤ", "text": "っていうか、\nいつこちらへ？"},
        { "location": "201/TALK"  , "narrator": "啓介", "text": "順番に説明するが、\n今日の始発の新幹線で\n東京へ来たんだ。"},
        { "location": "202/TALK"  , "narrator": "啓介", "text": "私の娘が、東京で\nどんな暮らしを\nしているのか。"},
        { "location": "203/TALK"  , "narrator": "啓介", "text": "気にならない親が\nいるわけない。"},
        { "location": "205/TALK"  , "narrator": "アーヤ", "text": "…あ、あの、\nまさかとは\n思いますが…。"},
        { "location": "206/TALK"  , "narrator": "アーヤ", "text": "朝からずっと\nこの場所で張り込み\nしてたんですか？"},
        { "location": "208/TALK"  , "narrator": "啓介", "text": "もちろんだ。\nバレては元も子も\nないからな。"},
        { "location": "211/TALK"  , "narrator": "アーヤ", "text": "…本当、\n過保護な人なのね。"},
        { "location": "212/TALK"  , "narrator": "アーヤ", "text": "でも、つばめさんなら\nたった今、外出して\nしまいましたよ？"},
        { "location": "214/TALK"  , "narrator": "啓介", "text": "むっ、そうだった。\nすぐに追わねば。"},
        { "location": "216/TALK"  , "narrator": "啓介", "text": "君は確か…綾水さん\nだったかな？"},
        { "location": "217/TALK"  , "narrator": "啓介", "text": "私のことは、娘には\n内緒で頼むよ。"},
        { "location": "222/TALK"  , "narrator": "アーヤ", "text": "ふぅ…、\nビックリした。"},
        { "location": "223/TALK"  , "narrator": "アーヤ", "text": "悪い人ではないと\n思うけど、ね。"},
        { "location": "224/TALK"  , "narrator": "アーヤ", "text": "過保護が過ぎて、\nつばめがちょっと\nかわいそうかも…。"},
        { "location": "225/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "226/TALK"  , "narrator": "アーヤ", "text": "あのお父さん、\nまさか秋葉原まで\n追うつもりかしら？"},
        { "location": "227/TALK"  , "narrator": "アーヤ", "text": "だとしたら…、\n大変なことに\nなるかも。"},
        { "location": "228/TALK"  , "narrator": "アーヤ", "text": "あのお父さんの\nことだもの。"},
        { "location": "229/TALK"  , "narrator": "アーヤ", "text": "何かのタイミングで\n飛び出していったり\nしそうだし。"},
        { "location": "230/TALK"  , "narrator": "アーヤ", "text": "でもそうなったら、\n多分つばめも黙っては\nいないと思うし。"},
        { "location": "231/TALK"  , "narrator": "アーヤ", "text": "…まさか、秋葉原の\nど真ん中で大喧嘩？"},
        { "location": "232/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "233/TALK"  , "narrator": "アーヤ", "text": "か、関わらない方が\nよさそうね。"},
        { "location": "234/TALK"  , "narrator": "アーヤ", "text": "そんなことしたら、\n絶対面倒なことに\nなるんだから。"},
        { "location": "235/TALK"  , "narrator": "アーヤ", "text": "隊員の家族のことに\nまで、私が関わること\nないのよね。"},
        { "location": "236/TALK"  , "narrator": "アーヤ", "text": "うん、関係ないわ。\n私も買い物に\n行かないと…。"},
        { "location": "284/TALK"  , "narrator": "アーヤ", "text": "　"},
        { "location": "300/TALK"  , "narrator": "アーヤ", "text": "[ココロゲート]へ\nいらっしゃい。\n$handle$さん。"},
        { "location": "301/SEL"   , "narrator": "", "text": "どうしたの？怖い顔して"},
        { "location": "302/ACT"   , "narrator": "", "text": "どうしたの？怖い顔して"},
        { "location": "304/TALK"  , "narrator": "アーヤ", "text": "えっと。\nそれは……"},
        { "location": "305/TALK"  , "narrator": "アーヤ", "text": "$handle$さんに\n言わなければならない\nことがあります。"},
        { "location": "306/SEL"   , "narrator": "", "text": "告白！？"},
        { "location": "307/SEL"   , "narrator": "", "text": "なに？"},
        { "location": "308/ACT"   , "narrator": "", "text": "告白！？"},
        { "location": "309/TALK"  , "narrator": "アーヤ", "text": "……。"},
        { "location": "310/TALK"  , "narrator": "アーヤ", "text": "やっぱりいいわ。"},
        { "location": "311/SEL"   , "narrator": "", "text": "ならばよし"},
        { "location": "312/SEL"   , "narrator": "", "text": "えー、冗談です！"},
        { "location": "313/ACT"   , "narrator": "", "text": "ならばよし"},
        { "location": "314/TALK"  , "narrator": "アーヤ", "text": "そう。"},
        { "location": "316/ACT"   , "narrator": "", "text": "えー、冗談です！"},
        { "location": "317/TALK"  , "narrator": "アーヤ", "text": "もう…。\n冗談も\n時と場所をを選んでね。"},
        { "location": "320/ACT"   , "narrator": "", "text": "なに？"},
        { "location": "322/TALK"  , "narrator": "アーヤ", "text": "えと……ね。"},
        { "location": "323/TALK"  , "narrator": "アーヤ", "text": "実は…"},
        { "location": "324/TALK"  , "narrator": "アーヤ", "text": "言っておきたいことが\nあるんだけど……"},
        { "location": "325/TALK"  , "narrator": "アーヤ", "text": "……。"},
        { "location": "326/TALK"  , "narrator": "アーヤ", "text": "うーん……"},
        { "location": "327/SEL"   , "narrator": "", "text": "……？"},
        { "location": "328/ACT"   , "narrator": "", "text": "……？"},
        { "location": "330/TALK"  , "narrator": "アーヤ", "text": "……。"},
        { "location": "331/TALK"  , "narrator": "アーヤ", "text": "ごめんなさい！\nやっぱり今回はナシ！"},
        { "location": "332/SEL"   , "narrator": "", "text": "えー！？"},
        { "location": "333/SEL"   , "narrator": "", "text": "言いたくなったらいつでも言ってね"},
        { "location": "334/ACT"   , "narrator": "", "text": "えー！？"},
        { "location": "335/TALK"  , "narrator": "アーヤ", "text": "ごめんなさい。\nホントにごめんね。"},
        { "location": "336/ACT"   , "narrator": "", "text": "言いたくなったらいつでも言ってね"},
        { "location": "337/TALK"  , "narrator": "アーヤ", "text": "ありがとう…。\n$handle$さんは\n優しいのね。"},
        { "location": "338/TALK"  , "narrator": "アーヤ", "text": "その優しさに応える\nためにも、早く心を\n決めなくちゃね……。"},
        { "location": "340/TALK"  , "narrator": "アーヤ", "text": "でも、次回は言う。\n絶対……言うから。"},
        { "location": "341/SEL"   , "narrator": "", "text": "待ってます"},
        { "location": "342/ACT"   , "narrator": "", "text": "待ってます"},
        { "location": "344/TALK"  , "narrator": "アーヤ", "text": "うん。"},
        { "location": "348/TALK"  , "narrator": "アーヤ", "text": "それじゃ今日も早速、\n何を悩んでるのか\n検索するわね。"},
        { "location": "353/TALK"  , "narrator": "アーヤ", "text": "オープンプロセス、\n0x853番地から\n0x773番地へ。"},
        { "location": "375/TALK"  , "narrator": "アーヤ", "text": "シーク完了。"},
        { "location": "378/TALK"  , "narrator": "アーヤ", "text": "さて、と。\n今回は……"},
        { "location": "380/TALK"  , "narrator": "アーヤ", "text": "あー……。"},
        { "location": "381/TALK"  , "narrator": "アーヤ", "text": "今回はすごいことに\nなってるわね。"},
        { "location": "382/SEL"   , "narrator": "", "text": "つばめのお父さんすごいよね"},
        { "location": "383/SEL"   , "narrator": "", "text": "アーヤのお父さんって確か…"},
        { "location": "384/ACT"   , "narrator": "", "text": "つばめのお父さんすごいよね"},
        { "location": "385/TALK"  , "narrator": "アーヤ", "text": "ホントにね。\nまるでうちの父を\n見てるみたい。"},
        { "location": "386/ACT"   , "narrator": "", "text": "アーヤのお父さんって確か…"},
        { "location": "387/TALK"  , "narrator": "アーヤ", "text": "あら？\nどこかで父の話を\nしたことあったっけ？"},
        { "location": "388/TALK"  , "narrator": "アーヤ", "text": "まあ確かに、つばめの\nお父さんを見てると\nちょっと被るわね。"},
        { "location": "390/TALK"  , "narrator": "アーヤ", "text": "だからこそ、\n放っておけないんだけど。"},
        { "location": "391/SEL"   , "narrator": "", "text": "それじゃやっぱり、本心では一緒にいてあげたいんだね"},
        { "location": "392/ACT"   , "narrator": "", "text": "それじゃやっぱり、本心では一緒にいてあげたいんだね"},
        { "location": "394/TALK"  , "narrator": "アーヤ", "text": "あ、そうそう。\nごめんなさい。"},
        { "location": "395/TALK"  , "narrator": "アーヤ", "text": "今回はやっぱり、\n一緒にいた方がいいだろう\nって思ってるのよね。"},
        { "location": "396/TALK"  , "narrator": "アーヤ", "text": "うちの父と同じなら――"},
        { "location": "397/TALK"  , "narrator": "アーヤ", "text": "悪い人じゃないのは\nわかるけど、ちょっと\n危なっかしいっていうか。"},
        { "location": "398/TALK"  , "narrator": "アーヤ", "text": "多分、つばめの事になると\n暴走しちゃうような\nタイプだと思うし。"},
        { "location": "399/SEL"   , "narrator": "", "text": "アーヤのお父さんもそうなの？"},
        { "location": "400/ACT"   , "narrator": "", "text": "アーヤのお父さんもそうなの？"},
        { "location": "402/TALK"  , "narrator": "アーヤ", "text": "うちはちょっとだけ\n違うかな。"},
        { "location": "403/TALK"  , "narrator": "アーヤ", "text": "なんていうか、\n厳しさの方向が。"},
        { "location": "404/TALK"  , "narrator": "アーヤ", "text": "つばめのお父さんは、\nつばめを愛するあまり、\nつばめを制限してる感じ？"},
        { "location": "405/TALK"  , "narrator": "アーヤ", "text": "うちの場合はもっと、\nなんていうか――"},
        { "location": "406/TALK"  , "narrator": "アーヤ", "text": "人様に迷惑かけないよう\n厳しく言われ続けたって\n感じかしらね。"},
        { "location": "407/SEL"   , "narrator": "", "text": "だからそんなに凛とした立派な人になったんだね"},
        { "location": "408/SEL"   , "narrator": "", "text": "だからそんなにカタブツになっちゃったんだね"},
        { "location": "409/ACT"   , "narrator": "", "text": "だからそんなに凛とした立派な人になったんだね"},
        { "location": "411/TALK"  , "narrator": "アーヤ", "text": "え……。"},
        { "location": "412/TALK"  , "narrator": "アーヤ", "text": "全然立派なんかじゃ\nないから。"},
        { "location": "413/TALK"  , "narrator": "アーヤ", "text": "他人に迷惑かけないフリを\nしてるだけ。"},
        { "location": "414/TALK"  , "narrator": "アーヤ", "text": "実際は逆で、凄く迷惑\nかけてるって自覚してる。"},
        { "location": "415/SEL"   , "narrator": "", "text": "そう思えるのって凄いと思うよ"},
        { "location": "416/SEL"   , "narrator": "", "text": "自分の方こそ、最近エッチなことばかり聞いて迷惑かけてごめんね"},
        { "location": "417/ACT"   , "narrator": "", "text": "そう思えるのって凄いと思うよ"},
        { "location": "418/TALK"  , "narrator": "アーヤ", "text": "…ありがと。\nいつも支えてくれて、\nホントに感謝してる。"},
        { "location": "419/TALK"  , "narrator": "アーヤ", "text": "貴方にだけは\n絶対に迷惑を\nかけたくない。"},
        { "location": "420/TALK"  , "narrator": "アーヤ", "text": "けど…\nもう少しだけ\n時間をください。ね？"},
        { "location": "421/ACT"   , "narrator": "", "text": "自分の方こそ、最近エッチなことばかり聞いて迷惑かけてごめんね"},
        { "location": "423/TALK"  , "narrator": "アーヤ", "text": "ほんとよ！\nもう…。"},
        { "location": "424/TALK"  , "narrator": "アーヤ", "text": "まあでも、別に\n嫌っていうわけじゃ\nなかったけどね。"},
        { "location": "425/SEL"   , "narrator": "", "text": "それじゃこれからもエッチなこと聞きます！"},
        { "location": "426/ACT"   , "narrator": "", "text": "それじゃこれからもエッチなこと聞きます！"},
        { "location": "428/TALK"  , "narrator": "アーヤ", "text": "それはダメ！"},
        { "location": "429/SEL"   , "narrator": "", "text": "言ってることが矛盾してるよ"},
        { "location": "430/ACT"   , "narrator": "", "text": "言ってることが矛盾してるよ"},
        { "location": "432/TALK"  , "narrator": "アーヤ", "text": "もうっ！"},
        { "location": "433/TALK"  , "narrator": "アーヤ", "text": "ここではもっと\n大人の対応を\nして欲しいわね…。"},
        { "location": "435/ACT"   , "narrator": "", "text": "だからそんなにカタブツになっちゃったんだね"},
        { "location": "436/TALK"  , "narrator": "アーヤ", "text": "あはは……。\n確かにそれはあるかも。"},
        { "location": "437/TALK"  , "narrator": "アーヤ", "text": "やっぱりダメよね、\n融通利かない人に\nなっちゃって。"},
        { "location": "438/TALK"  , "narrator": "アーヤ", "text": "でも、親の躾って\n本当に効果絶大よね。"},
        { "location": "439/TALK"  , "narrator": "アーヤ", "text": "いつだって人様の迷惑に\nなってないかばっかり\n考えて生活してるもの。"},
        { "location": "440/TALK"  , "narrator": "アーヤ", "text": "だから、貴方にも\nあまり迷惑を掛けたく\nないんだけど……。"},
        { "location": "441/TALK"  , "narrator": "アーヤ", "text": "もうちょっとだけ\n待ってね。"},
        { "location": "443/TALK"  , "narrator": "アーヤ", "text": "それじゃ、そろそろ\nクランを倒しに\n行きましょうか？"},
        { "location": "444/TALK"  , "narrator": "アーヤ", "text": "つばめのお父さんを\n助けてあげたいしね。"},
        { "location": "445/SEL"   , "narrator": "", "text": "オーケー"},
        { "location": "446/ACT"   , "narrator": "", "text": "オーケー"},
        { "location": "448/TALK"  , "narrator": "アーヤ", "text": "$handle$さんと\n國政綾水にとって、\n素敵なココロの旅を！"},
        { "location": "460/TALK"  , "narrator": "アーヤ", "text": "はぁ……。\nほんと、ダメな私。"},
        { "location": "461/TALK"  , "narrator": "アーヤ", "text": "でも、\n変わらなくちゃ…。"},
        { "location": "462/TALK"  , "narrator": "アーヤ", "text": "$handle$さんの\n為にも――。"},
        { "location": "31/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>7月24日　3:48 PM</color>\nフェノメノン発生の直前、秋葉原某書店にて。"},
        { "location": "249/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
