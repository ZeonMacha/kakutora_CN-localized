    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "ハリウッド映画ばりの（注：自己申告）"},
        { "location": "19/TALK"   , "narrator": "みやび", "text": "映画館のバイトは\n拘束時間が\n長く感じるきね。"},
        { "location": "20/TALK"   , "narrator": "みやび", "text": "楽しく過ごして\nみたいと常々\n思うとるんよ。"},
        { "location": "21/TALK"   , "narrator": "みやび", "text": "ライブビューイングとか\nどうかいね。"},
        { "location": "23/TALK"   , "narrator": "つばめ", "text": "楽しそうですね！"},
        { "location": "24/TALK"   , "narrator": "つばめ", "text": "メノウちゃんの\nライブとか\n観たいです！"},
        { "location": "25/TALK"   , "narrator": "みやび", "text": "ああ。\nそう言い出す\n気はしちょった。"},
        { "location": "26/TALK"   , "narrator": "繭", "text": "ライブ中継\nですか……。"},
        { "location": "28/TALK"   , "narrator": "繭", "text": "インターネット回線の\n方が手軽ではありますが。"},
        { "location": "29/TALK"   , "narrator": "繭", "text": "専用回線を確保する\n方向ですか？"},
        { "location": "31/TALK"   , "narrator": "みやび", "text": "そこは考えどころ\nなんよねえ。"},
        { "location": "34/TALK"   , "narrator": "つばめ", "text": "え、えと……？"},
        { "location": "35/TALK"   , "narrator": "繭", "text": "帯域。セキュリティ。\n双方のエンコード形式…。"},
        { "location": "36/TALK"   , "narrator": "つばめ", "text": "ま、まゆちん？"},
        { "location": "37/TALK"   , "narrator": "みやび", "text": "……。"},
        { "location": "49/TALK"   , "narrator": "みやび", "text": "光月繭"},
        { "location": "50/TALK"   , "narrator": "みやび", "text": "通称まゆちん"},
        { "location": "51/TALK"   , "narrator": "みやび", "text": "彼女はハッカーや否や？"},
        { "location": "53/SEL"    , "narrator": "", "text": "ハッカーだよ"},
        { "location": "54/SEL"    , "narrator": "", "text": "違うんじゃない"},
        { "location": "55/SEL"    , "narrator": "", "text": "みやびと話が合うんだね"},
        { "location": "56/ACT"    , "narrator": "", "text": "ハッカーだよ"},
        { "location": "57/TALK"   , "narrator": "みやび", "text": "そうか"},
        { "location": "58/TALK"   , "narrator": "みやび", "text": "って"},
        { "location": "59/TALK"   , "narrator": "みやび", "text": "そうなのか？"},
        { "location": "60/ACT"    , "narrator": "", "text": "違うんじゃない"},
        { "location": "61/TALK"   , "narrator": "みやび", "text": "それがわからんから"},
        { "location": "62/TALK"   , "narrator": "みやび", "text": "聞いておるのだ"},
        { "location": "63/TALK"   , "narrator": "みやび", "text": "$handle$め"},
        { "location": "64/ACT"    , "narrator": "", "text": "みやびと話が合うんだね"},
        { "location": "65/TALK"   , "narrator": "みやび", "text": "それは肯定だ"},
        { "location": "66/TALK"   , "narrator": "みやび", "text": "しかし"},
        { "location": "67/TALK"   , "narrator": "みやび", "text": "そこではないのだ"},
        { "location": "69/TALK"   , "narrator": "みやび", "text": "専攻学科を考えると"},
        { "location": "70/TALK"   , "narrator": "みやび", "text": "不思議ではないのだが"},
        { "location": "71/TALK"   , "narrator": "みやび", "text": "それにしても"},
        { "location": "73/SEL"    , "narrator": "", "text": "ちょっと悔しいな"},
        { "location": "74/ACT"    , "narrator": "", "text": "ちょっと悔しいな"},
        { "location": "75/TALK"   , "narrator": "みやび", "text": "ぬ？"},
        { "location": "78/SEL"    , "narrator": "", "text": "$me$より光月さんの方が気になるんでしょ"},
        { "location": "79/SEL"    , "narrator": "", "text": "みやびと盛り上がる話ができる子だから"},
        { "location": "80/SEL"    , "narrator": "", "text": "$handle$の方がみやびのこと好きなのに"},
        { "location": "81/ACT"    , "narrator": "", "text": "$me$より光月さんの方が気になるんでしょ"},
        { "location": "82/TALK"   , "narrator": "みやび", "text": "お"},
        { "location": "83/TALK"   , "narrator": "みやび", "text": "嫉妬か？"},
        { "location": "84/TALK"   , "narrator": "みやび", "text": "いっちょまえじゃの"},
        { "location": "85/ACT"    , "narrator": "", "text": "みやびと盛り上がる話ができる子だから"},
        { "location": "86/TALK"   , "narrator": "みやび", "text": "それは"},
        { "location": "87/TALK"   , "narrator": "みやび", "text": "$handle$が努力すれば"},
        { "location": "88/TALK"   , "narrator": "みやび", "text": "なんとかなる話ぞね"},
        { "location": "89/ACT"    , "narrator": "", "text": "$handle$の方がみやびのこと好きなのに"},
        { "location": "90/TALK"   , "narrator": "みやび", "text": "好き嫌いか"},
        { "location": "91/TALK"   , "narrator": "みやび", "text": "なんという"},
        { "location": "94/TALK"   , "narrator": "みやび", "text": "何なんだ？"},
        { "location": "98/TALK"   , "narrator": "みやび", "text": "まあ"},
        { "location": "99/TALK"   , "narrator": "みやび", "text": "ここでは"},
        { "location": "100/TALK"  , "narrator": "みやび", "text": "結論は出んぞね"},
        { "location": "112/TALK"  , "narrator": "みやび", "text": "光月さん。"},
        { "location": "114/TALK"  , "narrator": "繭", "text": "あ、はい！"},
        { "location": "115/TALK"  , "narrator": "みやび", "text": "話に出してみたけんど、\n残念ながらうちに\n決定権はないぞね。"},
        { "location": "117/TALK"  , "narrator": "繭", "text": "…そうなんですね…。"},
        { "location": "118/TALK"  , "narrator": "みやび", "text": "ただ、もし実現すると\nいう話になった時は\n相談させて欲しいちや。"},
        { "location": "120/TALK"  , "narrator": "繭", "text": "はい、ぜひ！"},
        { "location": "121/TALK"  , "narrator": "つばめ", "text": "まゆちんはすごいんだね。\nみやびさんに相談\nされるなんて。"},
        { "location": "123/TALK"  , "narrator": "つばめ", "text": "わたし、全然\n言ってることが\nわからなかったよ…。"},
        { "location": "125/TALK"  , "narrator": "繭", "text": "逢瀬さんは\nそれでいいんだよ。"},
        { "location": "127/TALK"  , "narrator": "つばめ", "text": "そ、そう、かな…？"},
        { "location": "128/TALK"  , "narrator": "みやび", "text": "そうそう。\n適材適所ちう\nやつやねえ。"}
    ]
}
