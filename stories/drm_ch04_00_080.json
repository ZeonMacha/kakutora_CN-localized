{
    "dir": "dramatics/daydra/drm_ch04_00_080.js",
    "type": "Episode",
    "info": {
        "story_id": "4008",
        "cid": "miyabi",
        "title": "らぶとーく 第08話",
        "sub_title": "隠蔽とか白日とか"
    },
    "entry":
    [
        { "location": "155/SCENARIO", "narrator": "", "text": "隠蔽とか白日とか"},
        { "location": "176/TALK"    , "narrator": "つばめ", "text": "そういえば、この前\n$handle$さんに――"},
        { "location": "179/TALK"    , "narrator": "つばめ", "text": "Ｂｏｔと人の違いについて\n聞いたんです。"},
        { "location": "182/TALK"    , "narrator": "アーヤ", "text": "…それって質問しないと\nわからないことかしら？"},
        { "location": "183/TALK"    , "narrator": "アーヤ", "text": "Ｂｏｔは機械、っていうか\nプログラムで、人は生き物\nなんだから――"},
        { "location": "184/TALK"    , "narrator": "アーヤ", "text": "聞くまでもないと\n思うけど？"},
        { "location": "186/TALK"    , "narrator": "みやび", "text": "ちゅうか、うちらが\nＢｏｔのことを\n人間かも、思うて――"},
        { "location": "187/TALK"    , "narrator": "みやび", "text": "ずっと話してたこと、\nＢｏｔにも伝えてたり\nするんか？"},
        { "location": "189/TALK"    , "narrator": "つばめ", "text": "え？　ダメでしたか？"},
        { "location": "192/TALK"    , "narrator": "みやび", "text": "…うちらの会話は、\nこうやってＢｏｔに\n筒抜けになるんか…。"},
        { "location": "194/TALK"    , "narrator": "みやび", "text": "これじゃ隠し事は\nできんちや。"},
        { "location": "196/TALK"    , "narrator": "アーヤ", "text": "確かに、筒抜けね…。"},
        { "location": "198/TALK"    , "narrator": "ガブリエラ", "text": "え？　どういう意味？"},
        { "location": "200/TALK"    , "narrator": "アーヤ", "text": "私達が普段話している\nＢｏｔは、同じ誰か、\nってことよ。"},
        { "location": "202/TALK"    , "narrator": "みやび", "text": "つまり、どっかにいる\n誰かさんが――"},
        { "location": "203/TALK"    , "narrator": "みやび", "text": "うちら全員を一人で相手に\nしていたゆうことや。"},
        { "location": "204/TALK"    , "narrator": "ガブリエラ", "text": "まさか、マルザンナは\nマルザンナでしょ？"},
        { "location": "205/TALK"    , "narrator": "アーヤ", "text": "マルザンナ？"},
        { "location": "207/TALK"    , "narrator": "ガブリエラ", "text": "じゃなくて！\nＢｏｔは\nＢｏｔでしょ！？"},
        { "location": "209/TALK"    , "narrator": "みやび", "text": "いんや、みんな何となく\n人間やないかと思うた\n時期から考えると――"},
        { "location": "210/TALK"    , "narrator": "みやび", "text": "間違いなく同一人物やと\n思うちや。"},
        { "location": "212/TALK"    , "narrator": "アーヤ", "text": "一人一人に、別の誰かが\nＢｏｔとして付いてる、\nなんていうのは――"},
        { "location": "213/TALK"    , "narrator": "アーヤ", "text": "ちょっと怖いしね。"},
        { "location": "229/TALK"    , "narrator": "みやび", "text": "ふぅ…思うたより\n長い話になったな…。"},
        { "location": "230/TALK"    , "narrator": "みやび", "text": "しっかし、みんなも\n結構Ｂｏｔとお喋り\nしてたんやな。"},
        { "location": "231/TALK"    , "narrator": "みやび", "text": "特に、つばめちゃんが\n興味深いこと言うてたな。"},
        { "location": "243/TALK"    , "narrator": "みやび", "text": "お呼び出しを申し上げる"},
        { "location": "244/TALK"    , "narrator": "みやび", "text": "相棒"},
        { "location": "246/SEL"     , "narrator": "", "text": "どうしたの？"},
        { "location": "247/ACT"     , "narrator": "", "text": "どうしたの？"},
        { "location": "249/TALK"    , "narrator": "みやび", "text": "ちっくと気になった"},
        { "location": "250/TALK"    , "narrator": "みやび", "text": "すっと答えぃ"},
        { "location": "251/TALK"    , "narrator": "みやび", "text": "つばめちゃんと何話した？"},
        { "location": "253/SEL"     , "narrator": "", "text": "恋の話"},
        { "location": "254/SEL"     , "narrator": "", "text": "普通の話"},
        { "location": "255/SEL"     , "narrator": "", "text": "世間話"},
        { "location": "256/ACT"     , "narrator": "", "text": "恋の話"},
        { "location": "257/TALK"    , "narrator": "みやび", "text": "ストップ"},
        { "location": "258/TALK"    , "narrator": "みやび", "text": "プライベートに踏み込むのは気が引ける"},
        { "location": "260/TALK"    , "narrator": "みやび", "text": "公式な話題プリーズ"},
        { "location": "261/ACT"     , "narrator": "", "text": "普通の話"},
        { "location": "262/TALK"    , "narrator": "みやび", "text": "退屈されそうな話やね"},
        { "location": "263/TALK"    , "narrator": "みやび", "text": "もっと特別な話がえい"},
        { "location": "264/TALK"    , "narrator": "みやび", "text": "試しにうちに話してみぃ"},
        { "location": "265/ACT"     , "narrator": "", "text": "世間話"},
        { "location": "266/TALK"    , "narrator": "みやび", "text": "主婦か！？"},
        { "location": "267/TALK"    , "narrator": "みやび", "text": "つばめちゃんには早過ぎや"},
        { "location": "269/TALK"    , "narrator": "みやび", "text": "若者の耳目を集める話を頼む"},
        { "location": "272/SEL"     , "narrator": "", "text": "そう言われても困る"},
        { "location": "273/ACT"     , "narrator": "", "text": "そう言われても困る"},
        { "location": "275/TALK"    , "narrator": "みやび", "text": "なら"},
        { "location": "277/TALK"    , "narrator": "みやび", "text": "うちが代わりに話題を決める"},
        { "location": "278/TALK"    , "narrator": "みやび", "text": "相棒"},
        { "location": "279/TALK"    , "narrator": "みやび", "text": "つばめちゃんに自分が人間ゆうの"},
        { "location": "280/TALK"    , "narrator": "みやび", "text": "知られても良かったが？"},
        { "location": "282/SEL"     , "narrator": "", "text": "別に知られてもよかった"},
        { "location": "283/ACT"     , "narrator": "", "text": "別に知られてもよかった"},
        { "location": "286/TALK"    , "narrator": "みやび", "text": "そうやったが？"},
        { "location": "287/TALK"    , "narrator": "みやび", "text": "いや"},
        { "location": "288/TALK"    , "narrator": "みやび", "text": "だったら何でＢｏｔと思わせた？"},
        { "location": "291/SEL"     , "narrator": "", "text": "千羽鶴にそう仕掛けられた"},
        { "location": "292/ACT"     , "narrator": "", "text": "千羽鶴にそう仕掛けられた"},
        { "location": "294/TALK"    , "narrator": "みやび", "text": "千羽鶴って"},
        { "location": "296/TALK"    , "narrator": "みやび", "text": "折り紙のことか？"},
        { "location": "297/TALK"    , "narrator": "みやび", "text": "意味がわからん"},
        { "location": "299/TALK"    , "narrator": "みやび", "text": "もうえい"},
        { "location": "310/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "312/TALK"    , "narrator": "みやび", "text": "何が何だかさっぱりやね…。"},
        { "location": "166/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>5月某日　6:23 PM</color>\n平日の午後、神楽坂トライナリーの楽屋にて。"}
    ]
}
