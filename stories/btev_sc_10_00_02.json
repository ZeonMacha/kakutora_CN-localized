{
    "dir": "chap00/battle/btev_sc_10_00_02.js",
    "type": "",
    "info": {
        "story_id": "105",
        "cid": "",
        "title": "【EXストーリー】スーパーメナー",
        "sub_title": "シンクロストーリー"
    },
    "entry":
    [
        { "location": "539/SCENARIO", "narrator": "", "text": "【結果】モーフィアス"},
        { "location": "555/TALK"    , "narrator": "神楽", "text": "お帰りなさいませ。\nよい旅でしたか？"},
        { "location": "556/TALK"    , "narrator": "神楽", "text": "$handle$さまが\n頑張ってくれたお陰で\n『コネクト』は完了です。"},
        { "location": "557/TALK"    , "narrator": "神楽", "text": "モーフィアスの\nココロの中の\n抵抗は消えました。"},
        { "location": "558/TALK"    , "narrator": "神楽", "text": "$handle$さまと\n繋がる準備が\nできたのです。"},
        { "location": "559/SEL"     , "narrator": "（選択肢）", "text": "次が『シンクロ』だよね"},
        { "location": "560/ACT"     , "narrator": "", "text": "次が『シンクロ』だよね"},
        { "location": "562/TALK"    , "narrator": "神楽", "text": "そうです！\nご名答！"},
        { "location": "563/TALK"    , "narrator": "神楽", "text": "シンクロをすると、\nモーフィアスの想いが\n流れ込みます。"},
        { "location": "564/TALK"    , "narrator": "神楽", "text": "$handle$さまは、\nどうかそれを受け入れて\nあげてくださいませ。"},
        { "location": "565/TALK"    , "narrator": "神楽", "text": "準備はいかがですか？"},
        { "location": "566/SEL"     , "narrator": "（選択肢）", "text": "できた"},
        { "location": "567/SEL"     , "narrator": "（選択肢）", "text": "まだ"},
        { "location": "568/ACT"     , "narrator": "", "text": "できた"},
        { "location": "569/TALK"    , "narrator": "神楽", "text": "承知しました。\nそれではココロを\n繋げます。"},
        { "location": "570/ACT"     , "narrator": "", "text": "まだ"},
        { "location": "572/TALK"    , "narrator": "神楽", "text": "まだ、ですか…。"},
        { "location": "573/TALK"    , "narrator": "神楽", "text": "それでは一旦ここで\nお別れですね。"},
        { "location": "574/TALK"    , "narrator": "神楽", "text": "準備ができたら\nお戻りください。"},
        { "location": "582/TALK"    , "narrator": "神楽", "text": "EXEC_SYNC_SPHERE/."},
        { "location": "595/DIALOG"  , "narrator": "", "text": "俺の世界では俺が法、\n刃向かうヤツはリアルBANだお――"},
        { "location": "610/DIALOG"  , "narrator": "", "text": "朝倉祥太郎（あさくらしょうたろう）。\n23歳男。千葉県佐倉市在住。"},
        { "location": "611/DIALOG"  , "narrator": "", "text": "子供の頃からゲームが大好きで、社会人になるまではコンシューマゲーム三昧だったが、お金を稼げるようになってからはスマホゲームやネットゲームに夢中になる。"},
        { "location": "612/DIALOG"  , "narrator": "", "text": "昼間会社に行き、夜は寝る間も惜しんでネトゲ。そんな生活をしているため、当然仕事の効率も上がらず、社内では三流社員として皆から冷たい視線を浴びていた。"},
        { "location": "613/DIALOG"  , "narrator": "", "text": "それでも彼は、そんなことはどうでも良かった。夜のネトゲ界では、彼はトップスターだったからだ。"},
        { "location": "614/DIALOG"  , "narrator": "", "text": "国内売上No1のスマホゲーム「カプセル＆ドラゴン（カプドラ）」で、彼は半年間ランキング首位をキープし続けていたのである。"},
        { "location": "615/DIALOG"  , "narrator": "", "text": "それもそのはず、彼のこの１年間での課金総額は1000万をもくだらない。"},
        { "location": "616/DIALOG"  , "narrator": "", "text": "当然給料だけでは賄えず、貯金を食いつぶし、親から借り、そしてローンをしてまで維持し続けているのだ。なお「モーフィアス」はゲームでのハンドル名。"},
        { "location": "617/DIALOG"  , "narrator": "", "text": "借金があるにもかかわらず、しばらくは祥太郎にとって理想の世界が展開された。大手ゲーム誌などでも取り上げられ、名前が世に出たこともあった。"},
        { "location": "618/DIALOG"  , "narrator": "", "text": "だが、それが良くなかったのかもしれない。\nとあるカプドラ大型アップデートの日、彼は没落した。"},
        { "location": "623/DIALOG"  , "narrator": "", "text": "アップデートされたプログラムには些細なセキュリティホールのバグがあった。"},
        { "location": "624/DIALOG"  , "narrator": "", "text": "それを悪用した数名のユーザーによって、祥太郎は戦利品の大半（それも殆どがUR）を奪われた。その結果、祥太郎は下位に転落してしまったのだ。"},
        { "location": "625/DIALOG"  , "narrator": "", "text": "そのバグはすぐに修正されたが、祥太郎のアイテムが戻ってくることはなかった。"},
        { "location": "626/DIALOG"  , "narrator": "", "text": "祥太郎は運営に抗議したが、全てを保障してくれることもなく、祥太郎は失意のどん底に落ちる。"},
        { "location": "627/DIALOG"  , "narrator": "", "text": "自分が注ぎ込んできた1000万という課金総額。自分は1000万を顔も知らない誰かに奪われてしまったのだ。"},
        { "location": "628/DIALOG"  , "narrator": "", "text": "祥太郎は運営と課金して得たアイテムを奪ったユーザーを呪った。"},
        { "location": "629/DIALOG"  , "narrator": "", "text": "それだけでなく楽しくプレイしている普通のユーザー、全てのゲームユーザーも呪った。"},
        { "location": "634/DIALOG"  , "narrator": "", "text": "祥太郎にとってゲームの中での王座とは、リアル以上に重要な事だったからだ。"},
        { "location": "635/DIALOG"  , "narrator": "", "text": "それを奪ったユーザーはもちろん、自分が失意のどん底にいるにも関わらずゲームを楽しんでいるユーザーも許せないと呪った。そして祥太郎は発症した。"},
        { "location": "636/DIALOG"  , "narrator": "", "text": "全てのネトゲユーザーを、絶対に這い上がれない課金地獄とランキング地獄に落として永遠に彷徨い続けさせるために、リアルネットゲーム世界を構築したのである。"},
        { "location": "653/TALK"    , "narrator": "神楽", "text": "これがモーフィアスの\n呪いです。"},
        { "location": "654/SEL"     , "narrator": "（選択肢）", "text": "なんだかなあ"},
        { "location": "655/SEL"     , "narrator": "（選択肢）", "text": "身につまされる"},
        { "location": "656/SEL"     , "narrator": "（選択肢）", "text": "運営ひどくない？"},
        { "location": "657/ACT"     , "narrator": "", "text": "なんだかなあ"},
        { "location": "658/TALK"    , "narrator": "神楽", "text": "お気持ち\nお察しします。"},
        { "location": "659/ACT"     , "narrator": "", "text": "身につまされる"},
        { "location": "660/TALK"    , "narrator": "神楽", "text": "$handle$さまには\nお心当たりが\nおありなんですね。"},
        { "location": "661/ACT"     , "narrator": "", "text": "運営ひどくない？"},
        { "location": "662/TALK"    , "narrator": "神楽", "text": "多少はそういう\n気持ちもありますが。"},
        { "location": "663/TALK"    , "narrator": "神楽", "text": "それまでの行いも…\nということでは\nないのでしょうか？"},
        { "location": "665/TALK"    , "narrator": "神楽", "text": "モーフィアスの強みは\nゲームというシステムを\n熟知しているところです。"},
        { "location": "666/TALK"    , "narrator": "神楽", "text": "裏技やハック、バグ技。\nいわゆるチートな\n能力を持っています。"},
        { "location": "667/TALK"    , "narrator": "神楽", "text": "$handle$さまを\n助けることが\nできるでしょう。"},
        { "location": "668/SEL"     , "narrator": "（選択肢）", "text": "もちろん"},
        { "location": "669/SEL"     , "narrator": "（選択肢）", "text": "うーん…"},
        { "location": "670/ACT"     , "narrator": "", "text": "もちろん"},
        { "location": "671/TALK"    , "narrator": "神楽", "text": "能力だけは\n高いですから。\nこのゴミは。"},
        { "location": "672/ACT"     , "narrator": "", "text": "うーん…"},
        { "location": "673/TALK"    , "narrator": "神楽", "text": "試してみるのも\n一興かと。"},
        { "location": "675/TALK"    , "narrator": "神楽", "text": "ゲームの世界とはいえ\nトップに上り詰めた\nことがあるのは。"},
        { "location": "676/TALK"    , "narrator": "神楽", "text": "認めてあげても\nよいと思うのです。"},
        { "location": "677/SEL"     , "narrator": "（選択肢）", "text": "ツンデレなの？"},
        { "location": "678/SEL"     , "narrator": "（選択肢）", "text": "確かにそうかも"},
        { "location": "679/ACT"     , "narrator": "", "text": "ツンデレなの？"},
        { "location": "680/TALK"    , "narrator": "神楽", "text": "違います。\n断じて違うのです。"},
        { "location": "681/ACT"     , "narrator": "", "text": "確かにそうかも"},
        { "location": "682/TALK"    , "narrator": "神楽", "text": "そうでしょう？\nわかってくださって\nうれしいです。"},
        { "location": "684/TALK"    , "narrator": "神楽", "text": "モーフィアスは\n極端すぎる部分が\nありますが。"},
        { "location": "685/TALK"    , "narrator": "神楽", "text": "そうでなければ\n到底トップには\nなれなかったでしょう。"},
        { "location": "686/TALK"    , "narrator": "神楽", "text": "それはどの世界でも\n同じだと思うのです。"},
        { "location": "687/TALK"    , "narrator": "神楽", "text": "仕事でも趣味でも\n学業でも。"},
        { "location": "688/SEL"     , "narrator": "（選択肢）", "text": "それって実体験？"},
        { "location": "689/SEL"     , "narrator": "（選択肢）", "text": "神楽って意外と優しいよね"},
        { "location": "690/ACT"     , "narrator": "", "text": "それって実体験？"},
        { "location": "691/TALK"    , "narrator": "神楽", "text": "…ええと、まあ…\n…そうです。"},
        { "location": "692/ACT"     , "narrator": "", "text": "神楽って意外と優しいよね"},
        { "location": "693/TALK"    , "narrator": "神楽", "text": "私はいつでも\n優しいんですよ？"},
        { "location": "695/TALK"    , "narrator": "神楽", "text": "さて。"},
        { "location": "696/TALK"    , "narrator": "神楽", "text": "今日からモーフィアスと\n$handle$さまは\nつながりました。"},
        { "location": "697/TALK"    , "narrator": "神楽", "text": "モーフィアスはぜひ\nこき使って\nやればいいと思います。"},
        { "location": "698/TALK"    , "narrator": "神楽", "text": "足蹴にされるのは\nご褒美みたいですし。"},
        { "location": "699/TALK"    , "narrator": "神楽", "text": "またの機会が\nありましたら\nお会いしましょう。"},
        { "location": "700/TALK"    , "narrator": "神楽", "text": "では今回は\nこれで失礼いたします。"}
    ]
}
