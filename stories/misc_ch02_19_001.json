        { "location": "57/SEL"    , "narrator": "", "text": "それでいいじゃん"},
        { "location": "58/SEL"    , "narrator": "", "text": "$me$の推しはアーヤだからね"},
        { "location": "59/ACT"    , "narrator": "", "text": "それでいいじゃん"},
