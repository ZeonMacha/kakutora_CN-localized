        { "location": "39/SEL"    , "narrator": "", "text": "いや、哲学者でしょ"},
        { "location": "40/SEL"    , "narrator": "", "text": "そうだったんだ"},
        { "location": "41/SEL"    , "narrator": "", "text": "でもアーヤがセンターだよね"},
        { "location": "42/ACT"    , "narrator": "", "text": "いや、哲学者でしょ"},
