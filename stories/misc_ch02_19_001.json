        { "location": "45/TALK"   , "narrator": "アーヤ", "text": "それじゃ話はおしまいね"},
        { "location": "46/ACT"    , "narrator": "", "text": "そうだったんだ"},
        { "location": "47/TALK"   , "narrator": "アーヤ", "text": "あれ"},
        { "location": "48/TALK"   , "narrator": "アーヤ", "text": "信じるの"},
