{
    "dir": "chap07/daydra/dd_ch03_07_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "7352",
        "cid": "gabriella",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "電車に揺られて"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "電車に揺られて"},
        { "location": "18/TALK"   , "narrator": "ガブリエラ", "text": "はぁ、はぁ…。"},
        { "location": "20/TALK"   , "narrator": "ガブリエラ", "text": "大遅刻だわ。\nもう二時限目が終わる\n時間じゃない…。"},
        { "location": "23/TALK"   , "narrator": "アーヤ", "text": "ちょっと、ギャヴィ。\n今頃登校なの？"},
        { "location": "27/TALK"   , "narrator": "ガブリエラ", "text": "うわっ、また面倒なのと\n会っちゃったわ…。"},
        { "location": "29/TALK"   , "narrator": "アーヤ", "text": "何か言った？"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "べ、別に何も…。"},
        { "location": "34/TALK"   , "narrator": "アーヤ", "text": "それより、こんな時間に\n登校なんて、\n何かあったの？"},
        { "location": "36/TALK"   , "narrator": "アーヤ", "text": "トライナリーの出動以外で\n遅刻したこと、一度も\nなかったのに…。"},
        { "location": "37/TALK"   , "narrator": "ガブリエラ", "text": "はぁ…やっぱり聞かれる\nわよね…。"},
        { "location": "38/TALK"   , "narrator": "ガブリエラ", "text": "でも、電車の中で寝ちゃった\nなんて言ったら、呆れられると\n思うし…。"},
        { "location": "39/SEL"    , "narrator": "", "text": "正直に言おう"},
        { "location": "40/SEL"    , "narrator": "", "text": "遊んでた、と言おう"},
        { "location": "41/SEL"    , "narrator": "", "text": "眠りの魔法に掛かってた"},
        { "location": "44/TALK"   , "narrator": "アーヤ", "text": "…まあ、無理に言えとは\nいわないけど――"},
        { "location": "45/TALK"   , "narrator": "アーヤ", "text": "事故とかに巻き込まれた\nわけじゃないのよね？"},
        { "location": "47/TALK"   , "narrator": "ガブリエラ", "text": "そんなわけないでしょ？\nケガしてるわけじゃないん\nだし。"},
        { "location": "48/TALK"   , "narrator": "アーヤ", "text": "そうだけど…。"},
        { "location": "52/TALK"   , "narrator": "ガブリエラ", "text": "なんでもないってば。\nその…ちょっと色々\nあったの。"},
        { "location": "54/TALK"   , "narrator": "アーヤ", "text": "色々って何よ？"},
        { "location": "58/TALK"   , "narrator": "ガブリエラ", "text": "えっと…長くなるから\n帰ってからね。"},
        { "location": "60/TALK"   , "narrator": "ガブリエラ", "text": "それじゃ！"},
        { "location": "66/TALK"   , "narrator": "アーヤ", "text": "あ、ちょっと…！"},
        { "location": "68/TALK"   , "narrator": "アーヤ", "text": "…まあ、何かあったわけじゃ\nないみたいだし、よかったわ。"},
        { "location": "70/ACT"    , "narrator": "", "text": "正直に言おう"},
        { "location": "76/TALK"   , "narrator": "ガブリエラ", "text": "ちょっとごめん！"},
        { "location": "92/TALK"   , "narrator": "ガブリエラ", "text": "…マルザンナは、私に正直でいろと言うのね？"},
        { "location": "93/TALK"   , "narrator": "ガブリエラ", "text": "わかったわ、私、正直になる！"},
        { "location": "105/TALK"  , "narrator": "アーヤ", "text": "どうしたの？\n何か大切な用事？"},
        { "location": "107/TALK"  , "narrator": "ガブリエラ", "text": "うん、ちょっとね…。"},
        { "location": "109/TALK"  , "narrator": "ガブリエラ", "text": "…正直に言うわ。"},
        { "location": "111/TALK"  , "narrator": "ガブリエラ", "text": "いつもと同じ電車には\n乗ったんだけど、\nその――"},
        { "location": "112/TALK"  , "narrator": "ガブリエラ", "text": "いつの間にか寝ちゃって、\n目を覚ましたのが、\nついさっきで…。"},
        { "location": "116/TALK"  , "narrator": "アーヤ", "text": "ついさっきって…\n二時間くらい電車で\n寝てたの！？"},
        { "location": "117/TALK"  , "narrator": "ガブリエラ", "text": "…まあ、そうなるわね。\n自分でもビックリだけど。"},
        { "location": "118/TALK"  , "narrator": "アーヤ", "text": "はぁ…呆れた。\nよく電車の中で\nそんなに眠れたわね。"},
        { "location": "121/TALK"  , "narrator": "ガブリエラ", "text": "し、仕方ないじゃない！\nあたしだってビックリ\nしてるんだから…。"},
        { "location": "122/TALK"  , "narrator": "アーヤ", "text": "夜更かしでもしたの？"},
        { "location": "123/TALK"  , "narrator": "ガブリエラ", "text": "してないって！\n子供じゃないんだから！"},
        { "location": "124/TALK"  , "narrator": "アーヤ", "text": "そっか…。"},
        { "location": "125/TALK"  , "narrator": "アーヤ", "text": "…まあ、こういう日も\nあるわよね。"},
        { "location": "126/TALK"  , "narrator": "ガブリエラ", "text": "え？"},
        { "location": "128/TALK"  , "narrator": "アーヤ", "text": "学校生活、バイト、それに\nトライナリー…。"},
        { "location": "129/TALK"  , "narrator": "アーヤ", "text": "そんな生活をしてれば、\n突然疲れが出るときも\nあるわよ。"},
        { "location": "132/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "134/TALK"  , "narrator": "アーヤ", "text": "無理しないで、疲れたら\n早退しなさいよ。\nそれじゃ、また後で。"},
        { "location": "136/TALK"  , "narrator": "ガブリエラ", "text": "…何よ、もっと怒るかと\n思ったのに。"},
        { "location": "137/TALK"  , "narrator": "ガブリエラ", "text": "心配してくれたんだ…\nちょっと、嬉しいな。"},
        { "location": "138/ACT"   , "narrator": "", "text": "遊んでた、と言おう"},
        { "location": "158/TALK"  , "narrator": "ガブリエラ", "text": "どうしちゃったの急に！？\nマルザンナしっかりして！"},
        { "location": "159/TALK"  , "narrator": "ガブリエラ", "text": "もしかして、具合でも悪かった？"},
        { "location": "160/TALK"  , "narrator": "ガブリエラ", "text": "ちょっとゆっくりしてて。アーヤと話しちゃうから。"},
        { "location": "171/TALK"  , "narrator": "アーヤ", "text": "何かあったの？\n凄い慌ててたみたい\nだけど…。"},
        { "location": "172/TALK"  , "narrator": "ガブリエラ", "text": "うん。\n友達がちょっと、具合を\n悪くしちゃってて…。"},
        { "location": "173/TALK"  , "narrator": "アーヤ", "text": "お友達が…？\nなるほど、それが遅れた\n理由ね。"},
        { "location": "175/TALK"  , "narrator": "ガブリエラ", "text": "え？"},
        { "location": "177/TALK"  , "narrator": "アーヤ", "text": "具合が悪くなったお友達を\n家まで送り届けてたん\nでしょ？"},
        { "location": "178/TALK"  , "narrator": "アーヤ", "text": "それならそうと、\n早く言ってくれれば\nいいのに。"},
        { "location": "180/TALK"  , "narrator": "ガブリエラ", "text": "…なんか、凄い勘違い\nされちゃってるけど、\nこれはラッキーだわ。"},
        { "location": "181/TALK"  , "narrator": "アーヤ", "text": "早く良くなるといいわね。\nそれじゃ、またね。"},
        { "location": "183/TALK"  , "narrator": "ガブリエラ", "text": "ふぅ…"},
        { "location": "184/TALK"  , "narrator": "ガブリエラ", "text": "って、落ち着いてる\n場合じゃないわ！"},
        { "location": "196/TALK"  , "narrator": "ガブリエラ", "text": "ちょっと、マルザンナ！"},
        { "location": "197/TALK"  , "narrator": "ガブリエラ", "text": "あなた本当に大丈夫なの？"},
        { "location": "199/SEL"   , "narrator": "", "text": "こうなることを予想してた"},
        { "location": "200/SEL"   , "narrator": "", "text": "具合が悪いみたい"},
        { "location": "201/ACT"   , "narrator": "", "text": "こうなることを予想してた"},
        { "location": "202/TALK"  , "narrator": "ガブリエラ", "text": "そ、そうだったの！？"},
        { "location": "203/TALK"  , "narrator": "ガブリエラ", "text": "凄いわマルザンナ！"},
        { "location": "205/TALK"  , "narrator": "ガブリエラ", "text": "でも、私を心配させたところだけは減点よ"},
        { "location": "216/ACT"   , "narrator": "", "text": "具合が悪いみたい"},
        { "location": "217/TALK"  , "narrator": "ガブリエラ", "text": "やっぱりそうだったのね"},
        { "location": "218/TALK"  , "narrator": "ガブリエラ", "text": "今日はゆっくり休んでいてね"},
        { "location": "230/ACT"   , "narrator": "", "text": "眠りの魔法に掛かってた"},
        { "location": "251/TALK"  , "narrator": "ガブリエラ", "text": "マルザンナ、なんて素敵で可愛らしいことを言うの！？"},
        { "location": "252/TALK"  , "narrator": "ガブリエラ", "text": "でも、きっとアーヤには通用しないわ"},
        { "location": "253/TALK"  , "narrator": "ガブリエラ", "text": "そんなこと言ったら、物凄く怖い顔で怒られちゃう…"},
        { "location": "254/TALK"  , "narrator": "ガブリエラ", "text": "だから、違う方法を考えてみるわ"},
        { "location": "266/TALK"  , "narrator": "ガブリエラ", "text": "…なんて言ったけど、\n何も浮かばないから\n相談したのよね…。"},
        { "location": "267/TALK"  , "narrator": "アーヤ", "text": "ギャヴィ…話の途中って\nこと忘れてない？"},
        { "location": "268/TALK"  , "narrator": "ガブリエラ", "text": "…し、信じてるわ、\nマルザンナ！"},
        { "location": "270/TALK"  , "narrator": "ガブリエラ", "text": "…ま…魔法が…。"},
        { "location": "271/TALK"  , "narrator": "アーヤ", "text": "…は？"},
        { "location": "272/TALK"  , "narrator": "ガブリエラ", "text": "魔法のせいで、その…"},
        { "location": "273/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "274/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "276/TALK"  , "narrator": "アーヤ", "text": "ギャヴィ、大丈夫？"},
        { "location": "280/TALK"  , "narrator": "ガブリエラ", "text": "えっ！？\nな、なに！？"},
        { "location": "282/TALK"  , "narrator": "アーヤ", "text": "具合が悪かったりしない？"},
        { "location": "283/TALK"  , "narrator": "ガブリエラ", "text": "だ、大丈夫だから！\n変な心配しないでよ。"},
        { "location": "286/TALK"  , "narrator": "アーヤ", "text": "魔法のせいで遅刻なんて\n言われたら、心配して\n当然でしょ！？"},
        { "location": "287/TALK"  , "narrator": "アーヤ", "text": "まったく、具合が悪く\nなったら早退するのよ。"},
        { "location": "293/TALK"  , "narrator": "ガブリエラ", "text": "はぁ…変な勘違い\nされちゃったわ。"},
        { "location": "294/TALK"  , "narrator": "ガブリエラ", "text": "けど、本当の理由を\n聞かれないで乗り切れは\nしたわね。"},
        { "location": "295/TALK"  , "narrator": "ガブリエラ", "text": "でも、本当に驚いたわ。\nあんな理由で乗り切れる\nなんて、もしかして――"},
        { "location": "297/TALK"  , "narrator": "ガブリエラ", "text": "マルザンナこそ、\n本当は魔法使いなのかも\nしれないわね。"},
        { "location": "17/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>5月18日　9:49 AM</color>\nとある朝、学園敷地内にて。"},
        { "location": "308/DIALOG", "narrator": "Dialog_GEThimegoto_ch03", "text": "【魔法使いと弟子】"}
    ]
}
