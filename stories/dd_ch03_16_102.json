{
    "dir": "chap16/daydra/dd_ch03_16_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "16305",
        "cid": "gabriella",
        "title": "005 メインストーリー",
        "sub_title": "プライベートタイム＜後編＞"
    },
    "entry":
    [
        { "location": "311/TALK"  , "narrator": "ガブリエラ", "text": "…でも、カプドラって\n共通の話題が\nあるし。"},
        { "location": "312/TALK"  , "narrator": "ガブリエラ", "text": "話に困るようなことは\nないのよね？"},
        { "location": "313/TALK"  , "narrator": "ガブリエラ", "text": "第一、悪い人たちじゃ\nないのは間違いないん\nだし。"},
        { "location": "314/TALK"  , "narrator": "ガブリエラ", "text": "あたし、ちょっと\n警戒し過ぎだった\nかも…。"},
        { "location": "318/TALK"  , "narrator": "ガブリエラ", "text": "…わかったわ。\n戦力は多いに越した\nことないものね。"},
        { "location": "319/TALK"  , "narrator": "雛", "text": "やった！\nじゃあ決まりだね。"},
        { "location": "320/TALK"  , "narrator": "雛", "text": "お店混んじゃう前に、\n急ご！"},
        { "location": "341/TALK"  , "narrator": "ガブリエラ", "text": "あっ、ヤバい！\nクリティカル\nもらっちゃった！"},
        { "location": "342/TALK"  , "narrator": "繭", "text": "即回復。"},
        { "location": "344/TALK"  , "narrator": "ガブリエラ", "text": "早ッ！？"},
        { "location": "347/TALK"  , "narrator": "雛", "text": "まゆちんはサポート\n極めてるからねー。"},
        { "location": "349/TALK"  , "narrator": "繭", "text": "状況を一歩離れた\nところから見れるのが\n気に入ってる。"},
        { "location": "351/TALK"  , "narrator": "繭", "text": "…そろそろトドメ。\nガブリエラ、\nスキル発動。"},
        { "location": "353/TALK"  , "narrator": "ガブリエラ", "text": "おっけー。\n発動！"},
        { "location": "355/TALK"  , "narrator": "雛", "text": "やった、倒したよ！\nこれでステージ６\nクリアー！"},
        { "location": "356/TALK"  , "narrator": "繭", "text": "今日はここまで。"},
        { "location": "357/TALK"  , "narrator": "繭", "text": "７からはレベルが\n一気に上がるから\n準備しないと。"},
        { "location": "358/TALK"  , "narrator": "繭", "text": "レベル上げ\nしとかしないと\n瞬殺確実だよ。"},
        { "location": "359/TALK"  , "narrator": "雛", "text": "そっかぁ…攻略までの\n道のりは遠いなぁ…。"},
        { "location": "362/TALK"  , "narrator": "ガブリエラ", "text": "っていうか、繭は\nどこでそんな情報\n手に入れてくるのよ？"},
        { "location": "363/TALK"  , "narrator": "繭", "text": "…普通にウェブ検索で\n出てくる程度の情報\nだから…。"},
        { "location": "364/TALK"  , "narrator": "繭", "text": "あっ。"},
        { "location": "367/TALK"  , "narrator": "雛", "text": "なになに？"},
        { "location": "368/TALK"  , "narrator": "繭", "text": "今日のギガスマート\nエキスポ、終わった\nみたい。"},
        { "location": "370/TALK"  , "narrator": "ガブリエラ", "text": "それって、\n確か国際展示場で\nやってるやつよね。"},
        { "location": "371/TALK"  , "narrator": "ガブリエラ", "text": "ゲームのイベント\nだったかしら？"},
        { "location": "374/TALK"  , "narrator": "雛", "text": "そうそう、ギガスマ。\n一度行ってみたいん\nだよねー。"},
        { "location": "378/TALK"  , "narrator": "繭", "text": "明日行けば？"},
        { "location": "381/TALK"  , "narrator": "雛", "text": "まゆちんも一緒に\n来てくれるなら！"},
        { "location": "383/TALK"  , "narrator": "繭", "text": "断る、面倒くさい。"},
        { "location": "385/TALK"  , "narrator": "ガブリエラ", "text": "あっ、\nもしかして！"},
        { "location": "386/TALK"  , "narrator": "ガブリエラ", "text": "今回のカプドラの\nイベントって\nギガスマに合わせて？"},
        { "location": "388/TALK"  , "narrator": "繭", "text": "そう…。だからこの\nイベントは三日限定の\n超短期間。"},
        { "location": "389/TALK"  , "narrator": "繭", "text": "それに、期間限定の\nレアドロップキャラも\nいるみたい。"},
        { "location": "390/TALK"  , "narrator": "ガブリエラ", "text": "ふーん…まあ、確率が\n超低くて取れないとは\n思うけど。"},
        { "location": "393/TALK"  , "narrator": "雛", "text": "あはは、それを\n言っちゃおしまい\nだよー。"},
        { "location": "394/TALK"  , "narrator": "繭", "text": "あとそのキャラ、\n意外と可愛くない。"},
        { "location": "395/TALK"  , "narrator": "繭", "text": "だから、無理してまで\n取る必要ないと思う。"},
        { "location": "396/TALK"  , "narrator": "繭", "text": "能力値も微妙だし。"},
        { "location": "397/TALK"  , "narrator": "ガブリエラ", "text": "なにそれ？\nだったらやる必要\nないじゃない。"},
        { "location": "398/TALK"  , "narrator": "雛", "text": "いや、でもレアに\n違いはないし。"},
        { "location": "399/TALK"  , "narrator": "ガブリエラ", "text": "あたしは、かわいい\nキャラだけを選んで\n使うようにしてるの。"},
        { "location": "400/TALK"  , "narrator": "ガブリエラ", "text": "かわいくないなら\nたとえレアだと\nしても興味ないわ。"},
        { "location": "401/TALK"  , "narrator": "雛", "text": "こだわりが\nあるんだねぇ。"},
        { "location": "402/TALK"  , "narrator": "ガブリエラ", "text": "まあね。"},
        { "location": "404/TALK"  , "narrator": "ガブリエラ", "text": "あとは、\nイベント戦なんかより\nマッチングバトル。"},
        { "location": "405/TALK"  , "narrator": "ガブリエラ", "text": "こっちの方が\nカプドラは\n面白いと思うのよ。"},
        { "location": "406/TALK"  , "narrator": "雛", "text": "えー、そうかなー？"},
        { "location": "407/TALK"  , "narrator": "雛", "text": "あたし、全然勝てない\nからほとんどやって\nないよ…。"},
        { "location": "408/TALK"  , "narrator": "ガブリエラ", "text": "ガチ勢が多いのよね。\nあたしもほとんど\n勝てないし。"},
        { "location": "414/TALK"  , "narrator": "ガブリエラ", "text": "だけど、今の戦いで\nちょっと安定して\nきた感じよね。"},
        { "location": "415/TALK"  , "narrator": "ガブリエラ", "text": "マッチングバトル、\n一回だけやってみよう\nかしら？"},
        { "location": "419/TALK"  , "narrator": "雛", "text": "おっ、頑張れ\nガブリエラちゃーん！"},
        { "location": "423/TALK"  , "narrator": "繭", "text": "…マッチング、\n攻略法…情報は…。"},
        { "location": "425/TALK"  , "narrator": "繭", "text": "っ！！　ダメ！！\nマッチングは\nやらないで！"},
        { "location": "427/TALK"  , "narrator": "ガブリエラ", "text": "えっ！？\nな、なんでよ？"},
        { "location": "428/TALK"  , "narrator": "繭", "text": "いいから、早く！\nキャンセルして！"},
        { "location": "433/TALK"  , "narrator": "ガブリエラ", "text": "う、うん…。\nしたけど…。"},
        { "location": "436/TALK"  , "narrator": "雛", "text": "繭ちん、どうしたの？"},
        { "location": "438/TALK"  , "narrator": "繭", "text": "…バグがあるらしい。"},
        { "location": "439/TALK"  , "narrator": "雛", "text": "へえ、カプドラに\nバグなんて珍しいね。\nどんなバグなの"},
        { "location": "441/TALK"  , "narrator": "繭", "text": "…かなりヤバめ。"},
        { "location": "442/TALK"  , "narrator": "繭", "text": "マッチング中に、\nある操作を行うと――"},
        { "location": "443/TALK"  , "narrator": "繭", "text": "勝敗無関係に、\n戦利品を自分の物に\nできるみたい。"},
        { "location": "446/TALK"  , "narrator": "ガブリエラ", "text": "はぁ！？　それって、\nメチャクチャヤバい\nじゃない！"},
        { "location": "448/TALK"  , "narrator": "繭", "text": "大炎上で運営土下座\nレベルのとんでもない\nバグ。"},
        { "location": "451/TALK"  , "narrator": "雛", "text": "うわぁ、それマジで\nヤバ過ぎるよぉ。"},
        { "location": "452/TALK"  , "narrator": "雛", "text": "マッチングの戦利品\nだって、超レア物も\n入るんだしさ。"},
        { "location": "453/TALK"  , "narrator": "雛", "text": "それを無条件に\n取られたら、泣いても\n泣ききれないね…。"},
        { "location": "457/TALK"  , "narrator": "繭", "text": "だから、マッチングは\nやらない方がいい。"},
        { "location": "458/TALK"  , "narrator": "繭", "text": "公式がこのバグに\n気づいて、パッチを\n充てるまでは。"},
        { "location": "459/TALK"  , "narrator": "ガブリエラ", "text": "え！？　\n公式、このバグに\n気づいてないの！？"},
        { "location": "460/TALK"  , "narrator": "繭", "text": "気づいてない。"},
        { "location": "461/TALK"  , "narrator": "繭", "text": "気づいているのは、\n超ディープな一部の\nプレイヤーだけ。"},
        { "location": "462/TALK"  , "narrator": "繭", "text": "多分、世界で数十人\nいるかいないかだと\n思う。"},
        { "location": "465/TALK"  , "narrator": "ガブリエラ", "text": "だから、何でそんな\n情報を知ってるのよ？"},
        { "location": "466/TALK"  , "narrator": "繭", "text": "…………。"},
        { "location": "467/TALK"  , "narrator": "繭", "text": "まあ…知る手段は\nいくらでもあるから。"},
        { "location": "468/TALK"  , "narrator": "ガブリエラ", "text": "どんな手段よ？"},
        { "location": "470/TALK"  , "narrator": "繭", "text": "…………。"},
        { "location": "474/TALK"  , "narrator": "ガブリエラ", "text": "わかったわ。\nもう聞かないわよ。"},
        { "location": "478/TALK"  , "narrator": "雛", "text": "でもさー…。"},
        { "location": "479/TALK"  , "narrator": "雛", "text": "そんなバグがあるのに\n放っておいたら\n大変なことにならない？"},
        { "location": "480/TALK"  , "narrator": "ガブリエラ", "text": "そうよね。"},
        { "location": "481/TALK"  , "narrator": "ガブリエラ", "text": "これが知れ渡ったり\nしたら、大炎上する\nことになるわね。"},
        { "location": "483/TALK"  , "narrator": "繭", "text": "それもアプリゲーの\n楽しみの一つ。"},
        { "location": "485/TALK"  , "narrator": "雛", "text": "まゆちん悪趣味ー。"},
        { "location": "486/SEL"   , "narrator": "", "text": "今のうちにそのバグ使おう！"},
        { "location": "487/SEL"   , "narrator": "", "text": "被害者が出てるかも"},
        { "location": "488/SEL"   , "narrator": "", "text": "運営に報告すれば？"},
        { "location": "489/ACT"   , "narrator": "", "text": "今のうちにそのバグ使おう！"},
        { "location": "505/TALK"  , "narrator": "ガブリエラ", "text": "使うわけないでしょう？"},
        { "location": "506/TALK"  , "narrator": "ガブリエラ", "text": "だってそれは不正だもの"},
        { "location": "507/TALK"  , "narrator": "ガブリエラ", "text": "ゲームはルールがあるから"},
        { "location": "508/TALK"  , "narrator": "ガブリエラ", "text": "初めて楽しめるものなのよ？"},
        { "location": "509/TALK"  , "narrator": "ガブリエラ", "text": "それを無視したら"},
        { "location": "510/TALK"  , "narrator": "ガブリエラ", "text": "ゲームではなくなってしまうわ"},
        { "location": "511/TALK"  , "narrator": "ガブリエラ", "text": "そうじゃなくて？"},
        { "location": "512/ACT"   , "narrator": "", "text": "被害者が出てるかも"},
        { "location": "528/TALK"  , "narrator": "ガブリエラ", "text": "かもではないと思うわ"},
        { "location": "529/TALK"  , "narrator": "ガブリエラ", "text": "そのバグが発覚しているということは"},
        { "location": "530/TALK"  , "narrator": "ガブリエラ", "text": "誰かが確かめたということだし"},
        { "location": "531/TALK"  , "narrator": "ガブリエラ", "text": "きっと"},
        { "location": "532/TALK"  , "narrator": "ガブリエラ", "text": "今も被害者の数が増えているはずよ"},
        { "location": "533/TALK"  , "narrator": "ガブリエラ", "text": "このまま放ってはおけないわね"},
        { "location": "534/ACT"   , "narrator": "", "text": "運営に報告すれば？"},
        { "location": "550/TALK"  , "narrator": "ガブリエラ", "text": "それがいいわね"},
        { "location": "551/TALK"  , "narrator": "ガブリエラ", "text": "知っている人が少ない今なら"},
        { "location": "552/TALK"  , "narrator": "ガブリエラ", "text": "被害を最小限に抑えられると思うし"},
        { "location": "557/TALK"  , "narrator": "ガブリエラ", "text": "とにかく、早いとこ\n公式に報告した方が\nいいわね。"},
        { "location": "559/TALK"  , "narrator": "繭", "text": "…もう？"},
        { "location": "562/TALK"  , "narrator": "ガブリエラ", "text": "もうって何よ？\n早くしないと被害が\n大きくなるでしょ？"},
        { "location": "564/TALK"  , "narrator": "繭", "text": "大規模炎上するの、\n見たかったのに…。"},
        { "location": "567/TALK"  , "narrator": "ガブリエラ", "text": "…バグのこと、\n掲示板に書き込んだり\nするんじゃないわよ？"},
        { "location": "578/DIALOG", "narrator": "Dialog_chapter_ch03", "text": "【13 電脳料理人】"}
    ]
}
