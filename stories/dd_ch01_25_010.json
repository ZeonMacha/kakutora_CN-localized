{
    "dir": "chap25/daydra/dd_ch01_25_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "25152",
        "cid": "tsubame",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "襲撃前夜＜つばめ編＞"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "襲撃前夜～つばめ編～"},
        { "location": "26/TALK"   , "narrator": "アーヤ", "text": "――というわけで、\n館長からいつ連絡が\n来るかわからない。"},
        { "location": "27/TALK"   , "narrator": "アーヤ", "text": "だから、今夜はみんな、\n劇場に泊まってもらうわ。"},
        { "location": "29/TALK"   , "narrator": "みやび", "text": "やっぱそうなるかぁ…。\nまあ、しゃあないな。"},
        { "location": "30/TALK"   , "narrator": "アーヤ", "text": "それと、外部と連絡を\nする場合は、間違っても\nストの話はしないこと。"},
        { "location": "31/TALK"   , "narrator": "アーヤ", "text": "みんな、いい？"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "りょーかい。"},
        { "location": "34/TALK"   , "narrator": "つばめ", "text": "わかりました…。"},
        { "location": "36/TALK"   , "narrator": "ガブリエラ", "text": "言うわけないでしょ？\n機密漏えいに\nなっちゃうし…。"},
        { "location": "37/TALK"   , "narrator": "アーヤ", "text": "うん…それじゃみんな、\nよろしくね。"},
        { "location": "39/TALK"   , "narrator": "つばめ", "text": "…わたしたち、\nどうなっちゃうんだろ？"},
        { "location": "41/TALK"   , "narrator": "ガブリエラ", "text": "まったく、情けない声\n出して…頼りないわねぇ。"},
        { "location": "42/TALK"   , "narrator": "つばめ", "text": "ガブちゃんは\n不安じゃないの？"},
        { "location": "43/TALK"   , "narrator": "ガブリエラ", "text": "不安に決まってるでしょ？"},
        { "location": "44/TALK"   , "narrator": "ガブリエラ", "text": "でも、不安だからって\n暗くなってても\n仕方ないじゃない。"},
        { "location": "46/TALK"   , "narrator": "つばめ", "text": "…………。"},
        { "location": "47/TALK"   , "narrator": "つばめ", "text": "ガブちゃんは、\nやっぱり強いなぁ…。"},
        { "location": "49/TALK"   , "narrator": "つばめ", "text": "わたしも、いつまでも\n新人じゃないんだから、\nしっかりしなきゃ…。"},
        { "location": "55/TALK"   , "narrator": "つばめ", "text": "あっ…。"},
        { "location": "56/TALK"   , "narrator": "つばめ", "text": "…ひなこちゃんだ。"},
        { "location": "63/TALK"   , "narrator": "雛", "text": "つばめちゃーん"},
        { "location": "65/TALK"   , "narrator": "雛", "text": "ちょっとお話ししたいんだけど"},
        { "location": "66/TALK"   , "narrator": "雛", "text": "今って平気？"},
        { "location": "67/TALK"   , "narrator": "雛", "text": "なんか"},
        { "location": "68/TALK"   , "narrator": "雛", "text": "ちょっと暇なんだー"},
        { "location": "71/TALK"   , "narrator": "雛", "text": "つばめちゃーん"},
        { "location": "72/TALK"   , "narrator": "雛", "text": "きづいてー"},
        { "location": "83/TALK"   , "narrator": "つばめ", "text": "…ごめん、ひなこちゃん。"},
        { "location": "84/TALK"   , "narrator": "つばめ", "text": "今は…どうしても\nダメなの…。"},
        { "location": "85/TALK"   , "narrator": "つばめ", "text": "…………。"},
        { "location": "86/SEL"    , "narrator": "", "text": "返事はいいの？"},
        { "location": "87/ACT"    , "narrator": "", "text": "返事はいいの？"},
        { "location": "91/TALK"   , "narrator": "つばめ", "text": "…………。"},
        { "location": "105/TALK"  , "narrator": "つばめ", "text": "ぅん(´･ω･｀) "},
        { "location": "106/TALK"  , "narrator": "つばめ", "text": "本当は"},
        { "location": "107/TALK"  , "narrator": "つばめ", "text": "返したぃけど(･Д･｀)"},
        { "location": "108/TALK"  , "narrator": "つばめ", "text": "ァーヤさんから"},
        { "location": "109/TALK"  , "narrator": "つばめ", "text": "ストのこと"},
        { "location": "111/TALK"  , "narrator": "つばめ", "text": "外部に言うの禁止って言われてるから(o´Д`)=з"},
        { "location": "113/SEL"   , "narrator": "", "text": "普通に話すのはいいんでしょ？"},
        { "location": "114/SEL"   , "narrator": "", "text": "堅苦しいなぁ…"},
        { "location": "115/ACT"   , "narrator": "", "text": "普通に話すのも禁止なの？"},
        { "location": "116/TALK"  , "narrator": "つばめ", "text": "そぅじゃなぃけど"},
        { "location": "117/ACT"   , "narrator": "", "text": "堅苦しいなぁ…"},
        { "location": "118/TALK"  , "narrator": "つばめ", "text": "仕方なぃよ"},
        { "location": "119/TALK"  , "narrator": "つばめ", "text": "まだ"},
        { "location": "120/TALK"  , "narrator": "つばめ", "text": "管理庁にも言ってなぃみたぃだし(o´Д`)=з"},
        { "location": "123/TALK"  , "narrator": "つばめ", "text": "それに"},
        { "location": "125/TALK"  , "narrator": "つばめ", "text": "わたしって"},
        { "location": "126/TALK"  , "narrator": "つばめ", "text": "意志が弱ぃから(´つω・｀)ｼｭﾝ"},
        { "location": "129/TALK"  , "narrator": "つばめ", "text": "もしかしたら"},
        { "location": "130/TALK"  , "narrator": "つばめ", "text": "ひなこちゃんに"},
        { "location": "131/TALK"  , "narrator": "つばめ", "text": "甘ぇたくなって"},
        { "location": "132/TALK"  , "narrator": "つばめ", "text": "言っちゃぅかもしれなぃ(/ω＼)"},
        { "location": "135/TALK"  , "narrator": "つばめ", "text": "だから辛ぃけど"},
        { "location": "136/TALK"  , "narrator": "つばめ", "text": "何も返せなぃ(´・ω・｀)"},
        { "location": "138/SEL"   , "narrator": "", "text": "雛達なら秘密にしてくれる"},
        { "location": "139/SEL"   , "narrator": "", "text": "そう思えるつばめは強いよ"},
        { "location": "140/SEL"   , "narrator": "", "text": "仕事だから仕方ないよ"},
        { "location": "141/ACT"   , "narrator": "", "text": "雛達なら秘密にしてくれる"},
        { "location": "142/TALK"  , "narrator": "つばめ", "text": "ぅん"},
        { "location": "144/TALK"  , "narrator": "つばめ", "text": "でも"},
        { "location": "145/TALK"  , "narrator": "つばめ", "text": "心配させちゃぅし(o´Д`)=з"},
        { "location": "146/TALK"  , "narrator": "つばめ", "text": "手伝ぅって言ぅかも"},
        { "location": "147/TALK"  , "narrator": "つばめ", "text": "ってぃぅか"},
        { "location": "148/TALK"  , "narrator": "つばめ", "text": "絶対言ぅと思ぅから"},
        { "location": "149/TALK"  , "narrator": "つばめ", "text": "やっぱり言えなぃよ(´つω・｀)ｼｭﾝ"},
        { "location": "150/ACT"   , "narrator": "", "text": "そう思えるつばめは強いよ"},
        { "location": "151/TALK"  , "narrator": "つばめ", "text": "本当にそぅなのかな？(･Д･｀)"},
        { "location": "152/TALK"  , "narrator": "つばめ", "text": "強かったら"},
        { "location": "153/TALK"  , "narrator": "つばめ", "text": "こんなに悩まなぃよ"},
        { "location": "155/SEL"   , "narrator": "", "text": "$me$は強いと信じてるよ"},
        { "location": "156/SEL"   , "narrator": "", "text": "悩むのが弱い証拠じゃないよ"},
        { "location": "157/ACT"   , "narrator": "", "text": "$me$は強いと信じてるよ"},
        { "location": "160/TALK"  , "narrator": "つばめ", "text": "ぁりがと(*´︶`*)"},
        { "location": "162/TALK"  , "narrator": "つばめ", "text": "$handle1$が信じてくれてるなら"},
        { "location": "163/TALK"  , "narrator": "つばめ", "text": "頑張らなぃとダメだねo(*･ﾛ･*)o、"},
        { "location": "165/TALK"  , "narrator": "つばめ", "text": "元気出たよ(๑･ㅂ･)و☆"},
        { "location": "166/ACT"   , "narrator": "", "text": "悩むのが弱い証拠じゃないよ"},
        { "location": "167/TALK"  , "narrator": "つばめ", "text": "そぅなのかな？"},
        { "location": "168/TALK"  , "narrator": "つばめ", "text": "でも"},
        { "location": "169/TALK"  , "narrator": "つばめ", "text": "$handle1$がそぅ言ぅなら"},
        { "location": "170/TALK"  , "narrator": "つばめ", "text": "きっとそぅなのかも(*´︶`*)"},
        { "location": "172/ACT"   , "narrator": "", "text": "仕事だから仕方ないよ"},
        { "location": "173/TALK"  , "narrator": "つばめ", "text": "わかってるよ"},
        { "location": "174/TALK"  , "narrator": "つばめ", "text": "仕事だから"},
        { "location": "175/TALK"  , "narrator": "つばめ", "text": "言ぇなぃって"},
        { "location": "178/TALK"  , "narrator": "つばめ", "text": "でも"},
        { "location": "180/TALK"  , "narrator": "つばめ", "text": "そんな風に割り切れたら"},
        { "location": "181/TALK"  , "narrator": "つばめ", "text": "悩まなぃですんだのかな？(o´Д`)=з"},
        { "location": "195/TALK"  , "narrator": "つばめ", "text": "はぁ…。"},
        { "location": "211/TALK"  , "narrator": "雛", "text": "…あれ？\nまだ既読ついてない…。"},
        { "location": "212/TALK"  , "narrator": "雛", "text": "どうしたんだろ…。\nつばめちゃんが\nなにも返さないなんて…。"},
        { "location": "213/TALK"  , "narrator": "雛", "text": "いつもなら、なにかしら\nすぐに返すのに。\n今日は既読すらつかない。"},
        { "location": "216/TALK"  , "narrator": "雛", "text": "…なにかあったのかな？"},
        { "location": "217/TALK"  , "narrator": "雛", "text": "…………。"},
        { "location": "221/TALK"  , "narrator": "透明繭", "text": "…はい？"},
        { "location": "222/TALK"  , "narrator": "雛", "text": "あ、まゆちんごめんね。\n急に電話かけて…。"},
        { "location": "223/TALK"  , "narrator": "透明繭", "text": "…どうかした？\n様子が変だけど。"},
        { "location": "224/TALK"  , "narrator": "雛", "text": "うん…今、つばめちゃんに\nＷＡＶＥを送ったの。"},
        { "location": "225/TALK"  , "narrator": "雛", "text": "けど、返信も既読も\nなんにも付かないんだ…。"},
        { "location": "226/TALK"  , "narrator": "透明繭", "text": "忙しいんじゃない？"},
        { "location": "227/TALK"  , "narrator": "雛", "text": "かもしれないけど、\nいつもは絶対に既読は\nつけるでしょ？"},
        { "location": "228/TALK"  , "narrator": "雛", "text": "三戸浜のこともあるし…、\nなにかあったのかもって\n心配で…。"},
        { "location": "229/TALK"  , "narrator": "透明繭", "text": "…………。"},
        { "location": "230/TALK"  , "narrator": "透明繭", "text": "わかった。\n私からも聞いてみる。"},
        { "location": "231/TALK"  , "narrator": "雛", "text": "ありがと…。\nごめんね、急に電話して。"},
        { "location": "232/TALK"  , "narrator": "透明繭", "text": "…連絡付いたら\nすぐにかけ直すから。\n少し待ってて。"},
        { "location": "233/TALK"  , "narrator": "雛", "text": "うん、よろしくね。"},
        { "location": "237/TALK"  , "narrator": "雛", "text": "はぁ…。"},
        { "location": "238/TALK"  , "narrator": "雛", "text": "この数日、本当に変なこと\nばっかり起きてるなぁ…。"},
        { "location": "239/TALK"  , "narrator": "雛", "text": "神楽ちゃんが裏切ったり、\nキリト達は突然待機任務で\n連絡取れないし…。"},
        { "location": "240/TALK"  , "narrator": "雛", "text": "…………。"},
        { "location": "241/TALK"  , "narrator": "雛", "text": "キリト達、大丈夫かな？"},
        { "location": "242/TALK"  , "narrator": "雛", "text": "待機任務とか言ってるけど\nキリト達はまだ学生で、\n訓練生なのに…。"},
        { "location": "243/TALK"  , "narrator": "雛", "text": "…危ないことしてなければ\nいいけど。"},
        { "location": "244/TALK"  , "narrator": "雛", "text": "はぁ…。"},
        { "location": "246/TALK"  , "narrator": "雛", "text": "キリト…あんたになにか\nあったら、まゆちんが\nマジ悲しむんだからね？"},
        { "location": "247/TALK"  , "narrator": "雛", "text": "もし泣かせるような\nことになったら…。"},
        { "location": "248/TALK"  , "narrator": "雛", "text": "あたし、\n嫌いになっちゃうからね！"},
        { "location": "25/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>9月3日　 5:44 PM</color>\nストライキ開始当日、神楽坂トライナリー楽屋にて"}
    ]
}
