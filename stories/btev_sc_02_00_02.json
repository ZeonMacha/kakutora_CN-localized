{
    "dir": "chap00/battle/btev_sc_02_00_02.js",
    "type": "",
    "info": {
        "story_id": "25",
        "cid": "",
        "title": "【EXストーリー】秘めたる野望",
        "sub_title": "シンクロストーリー"
    },
    "entry":
    [
        { "location": "183/SCENARIO", "narrator": "", "text": "【結果】クワイエットコルト"},
        { "location": "200/TALK"    , "narrator": "ガブリエラ", "text": "あら。\n終わったみたいね。"},
        { "location": "201/TALK"    , "narrator": "ガブリエラ", "text": "『コネクト』は無事に\n完了したわ。"},
        { "location": "202/TALK"    , "narrator": "ガブリエラ", "text": "つまり\n$handle$と\n繋がる準備ができた。"},
        { "location": "203/SEL"     , "narrator": "（選択肢）", "text": "次は『シンクロ』だっけ"},
        { "location": "204/ACT"     , "narrator": "", "text": "次は『シンクロ』だっけ"},
        { "location": "206/TALK"    , "narrator": "ガブリエラ", "text": "ちゃんと憶えて\nいるのね\n$handle$は。"},
        { "location": "207/TALK"    , "narrator": "ガブリエラ", "text": "シンクロすると、\n発症前の想いが\n流れ込むから。"},
        { "location": "208/TALK"    , "narrator": "ガブリエラ", "text": "$handle$は、\nそれを受け入れ\nなきゃいけないわ。"},
        { "location": "209/TALK"    , "narrator": "ガブリエラ", "text": "覚悟はできていて？"},
        { "location": "210/SEL"     , "narrator": "（選択肢）", "text": "はい"},
        { "location": "211/SEL"     , "narrator": "（選択肢）", "text": "いいえ"},
        { "location": "212/ACT"     , "narrator": "", "text": "はい"},
        { "location": "213/TALK"    , "narrator": "ガブリエラ", "text": "よい返事だわね。\nなら、ココロを\n繋げてよ。"},
        { "location": "214/ACT"     , "narrator": "", "text": "いいえ"},
        { "location": "216/TALK"    , "narrator": "ガブリエラ", "text": "……そう簡単には\n決められなくて\n当然だけど……。"},
        { "location": "217/TALK"    , "narrator": "ガブリエラ", "text": "仕方がないわ。\n一旦中止。\nさよならね。"},
        { "location": "218/TALK"    , "narrator": "ガブリエラ", "text": "準備ができたら\nまたいらっしゃい。"},
        { "location": "226/TALK"    , "narrator": "ガブリエラ", "text": "EXEC_SYNC_SPHERE/."},
        { "location": "254/DIALOG"  , "narrator": "", "text": "北原成人（きたはらなると）。24歳。世田谷区雪谷大塚に両親と共に住む。\n\n成人には兄と弟がいるが、二人とも就職を機に家を出ている。兄と弟が一流大学を卒業し中央省庁の官僚になる中、成人だけがFラン大学を卒業し、その後ニートになってしまった。"},
        { "location": "255/DIALOG"  , "narrator": "", "text": "Fランとはいえ法学部を選んだ動機は、幼い頃から理不尽に思っていた社会のルールを徹底的に暴くことだった。しかしその過程で道を誤った。\n\nきっかけは大学在籍時。この国のために貢献するとはどういうことなのかを考えて日本及び他国の事例を調べているうちに、本当に貢献する意味があるのかという疑問を抱き、迷走する。"},
        { "location": "256/DIALOG"  , "narrator": "", "text": "勉強だけをやってきた兄弟たちと違い、成人は雑学が大好きだった。特に西洋の法律に関する雑学知識は誰よりも上。また、真の自由はアメリカにあると考えている。"},
        { "location": "257/DIALOG"  , "narrator": "", "text": "発症当時は、アメリカで可決されている銃規制法案が、国民にどのように受け入れられているかについて彼の興味を引き続けていた。\n\nお役所のロボットになってしまった兄弟と違い、自分はちゃんと自分の頭で考えている、というのが成人の主張である。"},
        { "location": "262/DIALOG"  , "narrator": "", "text": "成人がいつも考えているのは、国民全員の最大幸福と現在の法体制、どうやったら官僚のずる賢い知恵から国民の血税を守れるか、である。すなわち、もはや成人にとって、兄も弟も敵なのだ。\n\nしかし兄たちにとって成人はただのニート。その思想は決して怠惰なものではなかったにせよ、受け入れられるものではない。"},
        { "location": "263/DIALOG"  , "narrator": "", "text": "正月に家族全員が集まったとき、ついに兄弟たちが親に混じって成人に攻撃を仕掛けてきた。成人は官僚こそがこの国を腐敗させている、と、ニートしながらも勉強していた様々な問題を吹っかける。\n\nしかし親兄弟もバカではない。最終的に、知識だけあっても何もできなければクズだ、という意味のことを言われてしまう。成人は議論をやめ、部屋に閉じこもってしまう。"},
        { "location": "268/DIALOG"  , "narrator": "", "text": "確かに自分はクズだ。だけど、この世界はもっとクズだ。\n確かに力がない自分は何もできていないけど、なまじ力がある兄弟は、この国を更に悪化させている。\n\n俺に力があれば、力さえあれば――その想いが極まって発症。\n\n日本のように癒着による出世や上限関係ストレス、能力があっても花開けない世界を呪い、真の能力至上主義社会を作り出したのだ。"},
        { "location": "269/DIALOG"  , "narrator": "", "text": "そこでは能力がある者が街を支配し、能力のない者、自分の力で生きていけない者は死んで行く過酷な世界だった。"},
        { "location": "286/TALK"    , "narrator": "ガブリエラ", "text": "これが【コルト】、\n成人の記憶。\nそして想い。"},
        { "location": "287/SEL"     , "narrator": "（選択肢）", "text": "身につまされる"},
        { "location": "288/SEL"     , "narrator": "（選択肢）", "text": "ちょっと世間知らずかな……"},
        { "location": "289/SEL"     , "narrator": "（選択肢）", "text": "今の世界とあんまり違わないような"},
        { "location": "290/ACT"     , "narrator": "", "text": "身につまされる"},
        { "location": "291/TALK"    , "narrator": "ガブリエラ", "text": "$handle$は\n優しくて\n強い人なのね。"},
        { "location": "292/ACT"     , "narrator": "", "text": "ちょっと世間知らずかな……"},
        { "location": "293/TALK"    , "narrator": "ガブリエラ", "text": "そうかしら。\n理想があるのは\n尊いことじゃなくて？"},
        { "location": "294/ACT"     , "narrator": "", "text": "今の世界とあんまり違わないような"},
        { "location": "295/TALK"    , "narrator": "ガブリエラ", "text": "確かにね。\nあたしも実は\nそう思ったのよね。"},
        { "location": "297/TALK"    , "narrator": "ガブリエラ", "text": "ただあたしはね。\n理想を持ち続ける、\nそのことに共感した。"},
        { "location": "298/TALK"    , "narrator": "ガブリエラ", "text": "そのせいで家族と\n衝突することに\nなったことにも。"},
        { "location": "300/TALK"    , "narrator": "ガブリエラ", "text": "…知っていたかしら。\nあたしが父に\n勘当されていること。"},
        { "location": "307/SEL"     , "narrator": "（選択肢）", "text": "知ってた"},
        { "location": "308/SEL"     , "narrator": "（選択肢）", "text": "知らなかったよ……"},
        { "location": "309/SEL"     , "narrator": "（選択肢）", "text": "またまたご冗談ばかり"},
        { "location": "310/ACT"     , "narrator": "", "text": "知ってた"},
        { "location": "311/TALK"    , "narrator": "ガブリエラ", "text": "…そうよね。"},
        { "location": "312/ACT"     , "narrator": "", "text": "知らなかったよ……"},
        { "location": "313/TALK"    , "narrator": "ガブリエラ", "text": "…言ってなかった\nかしらね。"},
        { "location": "314/ACT"     , "narrator": "", "text": "またまたご冗談ばかり"},
        { "location": "315/TALK"    , "narrator": "ガブリエラ", "text": "こんなこと\n冗談で言える\nわけがないわ。"},
        { "location": "318/TALK"    , "narrator": "ガブリエラ", "text": "あーもう。\n湿っぽい話は\nここまでにするわ。"},
        { "location": "319/TALK"    , "narrator": "ガブリエラ", "text": "【コルト】は銃の\n名手でもあるの。"},
        { "location": "320/TALK"    , "narrator": "ガブリエラ", "text": "あたしがライフルを\n扱うからシンパシーを\n感じたみたい。"},
        { "location": "321/SEL"     , "narrator": "（選択肢）", "text": "だからコルトなんだ"},
        { "location": "322/SEL"     , "narrator": "（選択肢）", "text": "銃仲間なんだね"},
        { "location": "323/SEL"     , "narrator": "（選択肢）", "text": "そこで相性が決まったんだ"},
        { "location": "324/ACT"     , "narrator": "", "text": "だからコルトなんだ"},
        { "location": "325/TALK"    , "narrator": "ガブリエラ", "text": "そういうことに\nなるわね。"},
        { "location": "326/ACT"     , "narrator": "", "text": "銃仲間なんだね"},
        { "location": "327/TALK"    , "narrator": "ガブリエラ", "text": "目指すところが\n同じなのよね。"},
        { "location": "328/ACT"     , "narrator": "", "text": "そこで相性が決まったんだ"},
        { "location": "329/TALK"    , "narrator": "ガブリエラ", "text": "銃火器を扱えるのは\nあたしだけだもの。"},
        { "location": "331/TALK"    , "narrator": "ガブリエラ", "text": "でも。\n『コネクト』と\n『シンクロ』のおかげで。"},
        { "location": "333/TALK"    , "narrator": "ガブリエラ", "text": "$handle$も\n【コルト】が理解\nできたでしょう？"},
        { "location": "334/TALK"    , "narrator": "ガブリエラ", "text": "【コルト】はいい\n戦力になるわ。"},
        { "location": "335/TALK"    , "narrator": "ガブリエラ", "text": "もちろん\n戦い方次第だ\nけれども。"},
        { "location": "336/TALK"    , "narrator": "ガブリエラ", "text": "もし他の属性を持つ\nクランが気になったら\nまた来ればいいわ。"},
        { "location": "337/TALK"    , "narrator": "ガブリエラ", "text": "あたしと相性が\nいい子なら\n紹介してよ。"}
    ]
}
