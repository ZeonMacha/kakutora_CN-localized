{
    "dir": "chap21/daydra/dd_ch02_21_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "21205",
        "cid": "ayami",
        "title": "005 メインストーリー",
        "sub_title": "初めての夜＜後編＞"
    },
    "entry":
    [
        { "location": "473/TALK"   , "narrator": "アーヤ", "text": "…よし、決めた！"},
        { "location": "485/TALK"   , "narrator": "アーヤ", "text": "ごめん(>_<)"},
        { "location": "486/TALK"   , "narrator": "アーヤ", "text": "お願いがあるんだけど"},
        { "location": "487/TALK"   , "narrator": "アーヤ", "text": "日付変わったら"},
        { "location": "489/TALK"   , "narrator": "アーヤ", "text": "教えてくれる？(￣∇￣)"},
        { "location": "491/SEL"    , "narrator": "", "text": "合宿なのに夜更かし？"},
        { "location": "492/ACT"    , "narrator": "", "text": "合宿なのに夜更かし？"},
        { "location": "494/TALK"   , "narrator": "アーヤ", "text": "いけないのはわかってる"},
        { "location": "496/TALK"   , "narrator": "アーヤ", "text": "けど"},
        { "location": "497/TALK"   , "narrator": "アーヤ", "text": "凄く楽しくて(￣∇￣*)ゞ"},
        { "location": "498/TALK"   , "narrator": "アーヤ", "text": "それに"},
        { "location": "499/TALK"   , "narrator": "アーヤ", "text": "こうやって"},
        { "location": "500/TALK"   , "narrator": "アーヤ", "text": "夜に全員集まるの"},
        { "location": "501/TALK"   , "narrator": "アーヤ", "text": "寮だとできないから"},
        { "location": "502/TALK"   , "narrator": "アーヤ", "text": "今日くらいはいいでしょ？( ・_・)σﾞ"},
        { "location": "504/SEL"    , "narrator": "", "text": "思い出になりそう"},
        { "location": "505/SEL"    , "narrator": "", "text": "明日は雨になるかも"},
        { "location": "506/ACT"    , "narrator": "", "text": "思い出になりそう"},
        { "location": "507/TALK"   , "narrator": "アーヤ", "text": "ええ(^^"},
        { "location": "508/TALK"   , "narrator": "アーヤ", "text": "楽しい思い出にね(*^o^*)"},
        { "location": "509/ACT"    , "narrator": "", "text": "明日は雨になるかも"},
        { "location": "510/TALK"   , "narrator": "アーヤ", "text": "もしそうなったら"},
        { "location": "511/TALK"   , "narrator": "アーヤ", "text": "明日の模擬戦は中止ね(*^^*)"},
        { "location": "512/TALK"   , "narrator": "アーヤ", "text": "まあ"},
        { "location": "513/TALK"   , "narrator": "アーヤ", "text": "晴れてもらいたいけど(｡-_-｡)"},
        { "location": "514/TALK"   , "narrator": "アーヤ", "text": "やっぱり"},
        { "location": "515/TALK"   , "narrator": "アーヤ", "text": "ちゃんと訓練しないと"},
        { "location": "516/TALK"   , "narrator": "アーヤ", "text": "これからのこと考えると"},
        { "location": "517/TALK"   , "narrator": "アーヤ", "text": "不安だから(-ω-;)"},
        { "location": "529/TALK"   , "narrator": "アーヤ", "text": "…ま、今日くらいは\nいいわよね。"},
        { "location": "530/TALK"   , "narrator": "みやび", "text": "…しかし、この時間に\nみんな一緒って\n珍しいねえ。"},
        { "location": "532/TALK"   , "narrator": "つばめ", "text": "そうですね。\n寮だと、みんな自分の\n部屋にいますし。"},
        { "location": "534/TALK"   , "narrator": "みやび", "text": "そうやろ？"},
        { "location": "535/TALK"   , "narrator": "みやび", "text": "せっかくやきね。\nみんなでゲームでも\nやらんかいね？"},
        { "location": "536/TALK"   , "narrator": "ガブリエラ", "text": "ゲーム？\nボードゲームでも\nするの？"},
        { "location": "538/TALK"   , "narrator": "みやび", "text": "んな気の利いたもん、\nうちにはないがよ。"},
        { "location": "539/TALK"   , "narrator": "みやび", "text": "けんど、スマホで\n同じゲーム落とせば\n全員で遊べるちや。"},
        { "location": "540/TALK"   , "narrator": "つばめ", "text": "わぁ、楽しそう！"},
        { "location": "542/TALK"   , "narrator": "アーヤ", "text": "面白そうね。\n私は賛成よ。"},
        { "location": "544/TALK"   , "narrator": "神楽", "text": "私も賛成です。"},
        { "location": "546/TALK"   , "narrator": "神楽", "text": "けど――\n罰ゲームは\nどうするんですか？"},
        { "location": "550/TALK"   , "narrator": "つばめ", "text": "えっ！\n罰ゲームありなの！？"},
        { "location": "552/TALK"   , "narrator": "ガブリエラ", "text": "バカね。\nリスクがなくちゃ\n楽しめないでしょ？"},
        { "location": "554/TALK"   , "narrator": "みやび", "text": "確かに。"},
        { "location": "555/TALK"   , "narrator": "みやび", "text": "ほいたら…負けたら\n自分の恥ずかしい話を\nする、っちゅーことで。"},
        { "location": "556/TALK"   , "narrator": "アーヤ", "text": "…ありがちだけど、\n結構重いわね。"},
        { "location": "569/TALK"   , "narrator": "ガブリエラ", "text": "あたしは賛成よ。\nそれでいきましょ。"},
        { "location": "570/TALK"   , "narrator": "みやび", "text": "じゃあ決まりやね。\n今から言うゲームを\nダウンロードよろー。"},
        { "location": "572/TALK"   , "narrator": "つばめ", "text": "ドキドキするよぉ…。\n頑張ろうね、\n神楽ちゃん！"},
        { "location": "574/TALK"   , "narrator": "神楽", "text": "はい。つばめさんの\n恥ずかしい話を聞き\nたいです！"},
        { "location": "576/TALK"   , "narrator": "神楽", "text": "だから\n一生懸命頑張ります！"},
        { "location": "577/TALK"   , "narrator": "つばめ", "text": "えぇーっ！？"},
        { "location": "580/TALK"   , "narrator": "アーヤ", "text": "ふふっ、誰が負けるの\nかしらね？"},
        { "location": "581/SEL"    , "narrator": "", "text": "アーヤが負けるように操作する"},
        { "location": "582/SEL"    , "narrator": "", "text": "つばめが負けるように操作する"},
        { "location": "583/SEL"    , "narrator": "", "text": "ガブリエラが負けるように操作する"},
        { "location": "584/SEL"    , "narrator": "", "text": "神楽が負けるように操作する"},
        { "location": "585/SEL"    , "narrator": "", "text": "みやびが負けるように操作する"},
        { "location": "586/ACT"    , "narrator": "", "text": "アーヤが負けるように操作する"},
        { "location": "629/TALK"   , "narrator": "ガブリエラ", "text": "じゃあ、罰ゲームは\n最下位のアーヤで\n決まりね。"},
        { "location": "634/TALK"   , "narrator": "アーヤ", "text": "はぁ…やっぱり\nスマホゲームって\n苦手だわ…。"},
        { "location": "636/TALK"   , "narrator": "みやび", "text": "今更言うても\n遅いがよ。"},
        { "location": "637/TALK"   , "narrator": "ガブリエラ", "text": "そういうこと。\nほら、早く恥ずかしい\n話しなさいよ。"},
        { "location": "639/TALK"   , "narrator": "アーヤ", "text": "わかってるわよ。\n負けは負けなんだし、\nちゃんと話すわ。"},
        { "location": "640/TALK"   , "narrator": "つばめ", "text": "アーヤさん、\n頑張ってください！"},
        { "location": "643/TALK"   , "narrator": "アーヤ", "text": "う～ん…、\n恥ずかしい話ねぇ…。"},
        { "location": "644/TALK"   , "narrator": "アーヤ", "text": "…最近だと、\nどんなことがあった\nかしら？"},
        { "location": "645/TALK"   , "narrator": "アーヤ", "text": "あっ、そうだ！\n前に人形劇で\nセリフ間違えたの。"},
        { "location": "646/TALK"   , "narrator": "アーヤ", "text": "続ければよかったのに\n固まっちゃって\n子供たちに笑われたわ。"},
        { "location": "647/TALK"   , "narrator": "アーヤ", "text": "でもあれ、\nアドリブしようが\nなかったし…。"},
        { "location": "648/TALK"   , "narrator": "アーヤ", "text": "狼が怖くて巣穴に\n逃げたウサギのなのに。"},
        { "location": "649/TALK"   , "narrator": "アーヤ", "text": "「こんなところへ\n隠れても無駄だぁ」\nなんて言っちゃって。"},
        { "location": "651/TALK"   , "narrator": "アーヤ", "text": "うまいつなげ方なんて\nとっさに思いつかない\nわよ…。"},
        { "location": "652/TALK"   , "narrator": "アーヤ", "text": "そりゃ、笑われる\nわよね…。"},
        { "location": "654/TALK"   , "narrator": "神楽", "text": "…アーヤさん、\nどうしちゃったん\nですかね？"},
        { "location": "656/TALK"   , "narrator": "ガブリエラ", "text": "さ、さあ？\nなんか、色々考えてる\nみたいだけど…。"},
        { "location": "657/TALK"   , "narrator": "アーヤ", "text": "って、人形劇の話は\n言えないわ！"},
        { "location": "658/TALK"   , "narrator": "アーヤ", "text": "恥ずかしい以前に、\nサークルのことが\nバレちゃうし…。"},
        { "location": "660/TALK"   , "narrator": "アーヤ", "text": "でも、あの時は本当、\n顔から火が出るくらい\nヤバかったなぁ…。"},
        { "location": "661/TALK"   , "narrator": "アーヤ", "text": "…思い出すだけでも\nキツいかも。"},
        { "location": "663/TALK"   , "narrator": "つばめ", "text": "あ、アーヤさん、\n大丈夫なんですか？"},
        { "location": "665/TALK"   , "narrator": "みやび", "text": "なーんか\n勝手に恥ずかしがって\n悶えちょるなぁ。"},
        { "location": "666/TALK"   , "narrator": "みやび", "text": "それはそれで\n見物やけんどね。"},
        { "location": "669/TALK"   , "narrator": "神楽", "text": "う～ん…これじゃあ、\nしばらく話してもらえ\nなさそうですね…。"},
        { "location": "671/TALK"   , "narrator": "ガブリエラ", "text": "そうね。\nでもまあ、\nいいんじゃないの？"},
        { "location": "672/TALK"   , "narrator": "ガブリエラ", "text": "恥ずかしい話のネタに\nなるようなことは\n現在進行形なわけだし。"},
        { "location": "677/TALK"   , "narrator": "みやび", "text": "…今の様子撮影して、\n後で見せちゃるかね。"},
        { "location": "678/ACT"    , "narrator": "", "text": "つばめが負けるように操作する"},
        { "location": "720/TALK"   , "narrator": "つばめ", "text": "うう、負けましたぁ。"},
        { "location": "723/TALK"   , "narrator": "ガブリエラ", "text": "じゃあ、罰ゲームは\n最下位のつばめで\n決まりね。"},
        { "location": "729/TALK"   , "narrator": "神楽", "text": "つばめさん、\nとびっきり可愛いのを\nお願いしますね！"},
        { "location": "730/TALK"   , "narrator": "つばめ", "text": "そ、そう言われ\nても…う～ん…。"},
        { "location": "732/TALK"   , "narrator": "ガブリエラ", "text": "悩むことないでしょ？"},
        { "location": "733/TALK"   , "narrator": "ガブリエラ", "text": "あんたの天然エピソードを\n話せばいいだけなんだし。"},
        { "location": "735/TALK"   , "narrator": "みやび", "text": "いや、ガブちゃん。\n天然な子にそれを\n求めるのは酷や。"},
        { "location": "736/TALK"   , "narrator": "みやび", "text": "それに気づけんから\n天然なんやし。"},
        { "location": "738/TALK"   , "narrator": "ガブリエラ", "text": "ああ、なるほど。"},
        { "location": "739/TALK"   , "narrator": "アーヤ", "text": "はいはい、そういう\nこと言わないの。"},
        { "location": "742/TALK"   , "narrator": "つばめ", "text": "う～ん…。"},
        { "location": "743/TALK"   , "narrator": "つばめ", "text": "あっ、そうだ！"},
        { "location": "744/TALK"   , "narrator": "つばめ", "text": "これ、静岡にいた頃の\n話なんですけど。"},
        { "location": "745/TALK"   , "narrator": "つばめ", "text": "一度だけ、お父さんに\nお弁当を作ったことが\nあるんです。"},
        { "location": "747/TALK"   , "narrator": "アーヤ", "text": "へぇ、そんなこと\nしてたんだ？"},
        { "location": "749/TALK"   , "narrator": "つばめ", "text": "一回だけですけどね。"},
        { "location": "750/TALK"   , "narrator": "つばめ", "text": "それで、その時に\n作ったおにぎりで\n失敗しちゃって…。"},
        { "location": "753/TALK"   , "narrator": "ガブリエラ", "text": "はぁ！？　おにぎりで\n何を失敗するのよ？"},
        { "location": "756/TALK"   , "narrator": "神楽", "text": "お塩とお砂糖を\n間違えた、とか\nですか？"},
        { "location": "757/TALK"   , "narrator": "つばめ", "text": "もぉー、いくら\nわたしでもそんな\n間違いしないよ！"},
        { "location": "759/TALK"   , "narrator": "つばめ", "text": "えっとね。"},
        { "location": "760/TALK"   , "narrator": "つばめ", "text": "具の入ってるのと\n入ってないの。\n二種類作ったの。"},
        { "location": "761/TALK"   , "narrator": "つばめ", "text": "でも、具なしのおにぎり\nだけをお弁当箱に\n詰めちゃったんだ…。"},
        { "location": "763/TALK"   , "narrator": "アーヤ", "text": "じゃあ、その日の\nお父さんのお昼は\nおにぎりだけ？"},
        { "location": "764/TALK"   , "narrator": "アーヤ", "text": "おかずは\n入れなかったの？"},
        { "location": "766/TALK"   , "narrator": "つばめ", "text": "はい…。"},
        { "location": "768/TALK"   , "narrator": "みやび", "text": "あ～、それ地味に\nキツいなぁ…。"},
        { "location": "769/TALK"   , "narrator": "つばめ", "text": "ですよねぇ…。"},
        { "location": "770/TALK"   , "narrator": "つばめ", "text": "でも、仕事から\n帰ってきた\nお父さんがね。"},
        { "location": "771/TALK"   , "narrator": "つばめ", "text": "美味しかったから\nまた頼む、って。"},
        { "location": "772/TALK"   , "narrator": "つばめ", "text": "恥ずかしいし\nごめんねって\n感じでしたよ…。"},
        { "location": "774/TALK"   , "narrator": "みやび", "text": "…なるほどなぁ。"},
        { "location": "776/TALK"   , "narrator": "つばめ", "text": "はい…以上、わたしの\n恥ずかしい話でした。"},
        { "location": "778/TALK"   , "narrator": "ガブリエラ", "text": "う～ん…、確かに\n恥ずかしい話では\nあるみたいだけど…。"},
        { "location": "780/TALK"   , "narrator": "アーヤ", "text": "あら、私はよかったと\n思うけど？"},
        { "location": "781/TALK"   , "narrator": "アーヤ", "text": "つばめらしい感じが\nする、面白い話だと\n思ったわ。"},
        { "location": "782/TALK"   , "narrator": "神楽", "text": "私もです。"},
        { "location": "783/TALK"   , "narrator": "神楽", "text": "つばめさんらしい\n可愛いおっちょこ\nちょいだと思います。"},
        { "location": "785/TALK"   , "narrator": "みやび", "text": "しっかし、お父さんは\n災難やったなぁ。"},
        { "location": "787/TALK"   , "narrator": "アーヤ", "text": "ふふっ、案外本気で\n喜んでたのかも\nしれないわよ？"},
        { "location": "788/TALK"   , "narrator": "アーヤ", "text": "具が入ってなくても、\nつばめが作った物に\n違いはないんだし。"},
        { "location": "790/TALK"   , "narrator": "ガブリエラ", "text": "つばめのお父さん、\n超親バカだもんねー。"},
        { "location": "791/TALK"   , "narrator": "つばめ", "text": "…………。"},
        { "location": "793/TALK"   , "narrator": "つばめ", "text": "よかった…。\nみんな、楽しんで\nくれたみたいで。"},
        { "location": "794/TALK"   , "narrator": "つばめ", "text": "ちょっと恥ずかし\nかったけど、\n話して正解だったな。"},
        { "location": "795/ACT"    , "narrator": "", "text": "ガブリエラが負けるように操作する"},
        { "location": "838/TALK"   , "narrator": "ガブリエラ", "text": "はぁ…罰ゲームとか\n決めなければ\nよかったわ…。"},
        { "location": "840/TALK"   , "narrator": "アーヤ", "text": "今更言っても\nもう遅いわ。"},
        { "location": "841/TALK"   , "narrator": "アーヤ", "text": "それじゃ、ギャヴィ。\n恥ずかしい話\nお願いね。"},
        { "location": "846/TALK"   , "narrator": "ガブリエラ", "text": "ああ、はいはい。\n今話すわよ、\nえっと…。"},
        { "location": "847/TALK"   , "narrator": "ガブリエラ", "text": "…そうね…。\n日本に来た最初の頃の\n話なんだけど…。"},
        { "location": "848/TALK"   , "narrator": "ガブリエラ", "text": "電車の乗り換えを\n間違えて、大変な\nことになったわ。"},
        { "location": "850/TALK"   , "narrator": "みやび", "text": "ほぅ、そんなことが\nあったが？"},
        { "location": "851/TALK"   , "narrator": "ガブリエラ", "text": "うん…気づいたら、\n千葉の方まで\n行っちゃってて…。"},
        { "location": "854/TALK"   , "narrator": "神楽", "text": "ああ、総武線に\n乗っちゃったん\nですね？"},
        { "location": "856/TALK"   , "narrator": "ガブリエラ", "text": "そういうことよ…。"},
        { "location": "858/TALK"   , "narrator": "ガブリエラ", "text": "っていうか、今でも\n思うのよ！"},
        { "location": "859/TALK"   , "narrator": "ガブリエラ", "text": "新宿駅広過ぎだから！\nしかも路線が多すぎる\nのも問題よ！"},
        { "location": "860/TALK"   , "narrator": "ガブリエラ", "text": "あんな初見殺しな駅で\nまともに乗り換え\nなんてできないわよ！"},
        { "location": "862/TALK"   , "narrator": "つばめ", "text": "あ、あはは…、\nなんかわかるかも…。"},
        { "location": "863/TALK"   , "narrator": "アーヤ", "text": "…あ、ああ！\n思い出したわ！"},
        { "location": "864/TALK"   , "narrator": "アーヤ", "text": "それってあの時よね？"},
        { "location": "865/TALK"   , "narrator": "アーヤ", "text": "ギャヴィが乗る電車\n間違えて帰れないって\n連絡してきた時の話。"},
        { "location": "866/TALK"   , "narrator": "アーヤ", "text": "私がバイクで迎えに\n行ったわね。"},
        { "location": "867/TALK"   , "narrator": "ガブリエラ", "text": "…そうよ。"},
        { "location": "869/TALK"   , "narrator": "アーヤ", "text": "あの時は慌てたわ。"},
        { "location": "870/TALK"   , "narrator": "アーヤ", "text": "ギャヴィから半泣きで\n助けを求められたん\nだもの。"},
        { "location": "872/TALK"   , "narrator": "ガブリエラ", "text": "ちょ、何よそれ！？\n泣いたりなんて\nしてないから！"},
        { "location": "875/TALK"   , "narrator": "アーヤ", "text": "ごめんごめん。"},
        { "location": "876/TALK"   , "narrator": "アーヤ", "text": "…でも、凄く心細かった\nわよね……？"},
        { "location": "877/TALK"   , "narrator": "アーヤ", "text": "慣れない土地で、\nいきなり一人ぼっちに\nなったんだし…。"},
        { "location": "879/TALK"   , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "880/TALK"   , "narrator": "アーヤ", "text": "慣れてないんだから、\n私がもっと気にする\nべきだったわ。"},
        { "location": "882/TALK"   , "narrator": "アーヤ", "text": "あの時はごめんね、\nギャヴィ…。"},
        { "location": "884/TALK"   , "narrator": "ガブリエラ", "text": "ちょ！？　アーヤが\n謝る必要ないでしょ？"},
        { "location": "885/TALK"   , "narrator": "ガブリエラ", "text": "不慣れなのに、一人で\n外出したあたしが\nいけなかったんだし。"},
        { "location": "887/TALK"   , "narrator": "アーヤ", "text": "でも……。"},
        { "location": "888/TALK"   , "narrator": "ガブリエラ", "text": "でもじゃない！\n悪いのはあたしなの！"},
        { "location": "889/TALK"   , "narrator": "ガブリエラ", "text": "だから、勝手に自分の\nせいだなんて思わない\nでよね？"},
        { "location": "892/TALK"   , "narrator": "ガブリエラ", "text": "子ども扱いされてる\nみたいで\n余計恥ずかしいわよ！"},
        { "location": "894/TALK"   , "narrator": "みやび", "text": "…このやり取りが\n見てて恥ずかしいん\nやけんどね。"},
        { "location": "897/TALK"   , "narrator": "神楽", "text": "ですよねぇ。\n本人気づいてない\nみたいですけど…。"},
        { "location": "898/ACT"    , "narrator": "", "text": "神楽が負けるように操作する"},
        { "location": "941/TALK"   , "narrator": "神楽", "text": "はぁ…私の負けです。"},
        { "location": "943/TALK"   , "narrator": "ガブリエラ", "text": "残念だったわね。\n罰ゲームは神楽で\n決まりよ！"},
        { "location": "949/TALK"   , "narrator": "ガブリエラ", "text": "けど、神楽にとっての\n恥ずかしい話って、\nどんなのかしら？"},
        { "location": "950/TALK"   , "narrator": "みやび", "text": "うーん、なんやろね？\nそういうもんとは\n無縁な感じよね。"},
        { "location": "951/TALK"   , "narrator": "みやび", "text": "全く想像つかんがよ。"},
        { "location": "954/TALK"   , "narrator": "アーヤ", "text": "恥ずかしい話なんて\nない、とか言ったり\nして。"},
        { "location": "956/TALK"   , "narrator": "ガブリエラ", "text": "いや、さすがに\nそれはないでしょ。"},
        { "location": "957/TALK"   , "narrator": "ガブリエラ", "text": "っていうか、それじゃ\n罰ゲームにならない\nじゃない。"},
        { "location": "959/TALK"   , "narrator": "神楽", "text": "うーん…恥ずかしい話\nですか…。\nそうですねぇ…。"},
        { "location": "960/TALK"   , "narrator": "神楽", "text": "間違えて学校の先生を\nお母さんと言っちゃっ\nたとか。"},
        { "location": "961/TALK"   , "narrator": "神楽", "text": "あ、お砂糖と塩を\n間違えたこととかは\nどうですか？"},
        { "location": "963/TALK"   , "narrator": "ガブリエラ", "text": "それ、恥ずかしい話\nっていうの？"},
        { "location": "964/TALK"   , "narrator": "みやび", "text": "うっかりミス話やね。"},
        { "location": "965/TALK"   , "narrator": "神楽", "text": "じゃあ、\n銭湯で着替えてた時の\nハプニングとか。"},
        { "location": "966/TALK"   , "narrator": "みやび", "text": "おお。\n期待やね。"},
        { "location": "967/TALK"   , "narrator": "神楽", "text": "実は\n男湯と女湯を\n間違えてて……。"},
        { "location": "970/TALK"   , "narrator": "つばめ", "text": "えっ！？"},
        { "location": "972/TALK"   , "narrator": "神楽", "text": "なんて。\n嘘ですよー？"},
        { "location": "974/TALK"   , "narrator": "つばめ", "text": "……もー…\n脅かさないでよー…。"},
        { "location": "976/TALK"   , "narrator": "ガブリエラ", "text": "そんなのに\nだまされるのは\nつばめくらいよ…。"},
        { "location": "978/TALK"   , "narrator": "ガブリエラ", "text": "そんな捏造\nエピソードは\nいらないから！"},
        { "location": "979/TALK"   , "narrator": "ガブリエラ", "text": "もっとこう、ないの？\n他に！？"},
        { "location": "981/TALK"   , "narrator": "神楽", "text": "う～ん…。"},
        { "location": "982/TALK"   , "narrator": "神楽", "text": "…………。"},
        { "location": "983/TALK"   , "narrator": "神楽", "text": "あっ！"},
        { "location": "985/TALK"   , "narrator": "みやび", "text": "おっ、何か思い出し\nたな？"},
        { "location": "986/TALK"   , "narrator": "ガブリエラ", "text": "何を思い出したの？"},
        { "location": "988/TALK"   , "narrator": "神楽", "text": "…あ、あの…二年前の\nことなんですけど…。"},
        { "location": "990/TALK"   , "narrator": "神楽", "text": "私…っていうか、\nメノウの時の\n話でいいですか？"},
        { "location": "994/TALK"   , "narrator": "つばめ", "text": "えっ！？\n聞きたい！\n聞きたい！"},
        { "location": "995/TALK"   , "narrator": "神楽", "text": "…じゃあ話しますね。\n武道館でライブを\nやったんです…。"},
        { "location": "996/TALK"   , "narrator": "アーヤ", "text": "…急に規模が大きく\nなったわね。"},
        { "location": "998/TALK"   , "narrator": "神楽", "text": "それで…歌の途中で\nうっかり歌詞を\n忘れちゃったんです。"},
        { "location": "999/TALK"   , "narrator": "神楽", "text": "だから即興で、\n全然違う歌詞を作って\n歌ったんです。"},
        { "location": "1002/TALK"  , "narrator": "つばめ", "text": "えぇっ！？"},
        { "location": "1004/TALK"  , "narrator": "つばめ", "text": "二年前のライブなら、\nわたしＤＶＤ持ってる\nけど……。"},
        { "location": "1005/TALK"  , "narrator": "つばめ", "text": "そんなところ\nあったっけ？"},
        { "location": "1007/TALK"  , "narrator": "神楽", "text": "ＤＶＤには\n別の日の分が収録され\nましたからね。"},
        { "location": "1009/TALK"  , "narrator": "つばめ", "text": "そうなんだぁ…。\nどんな歌詞だったの？"},
        { "location": "1012/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1013/TALK"  , "narrator": "ガブリエラ", "text": "え、なになに？\nそんなヤバい歌詞に\nなったの？"},
        { "location": "1014/TALK"  , "narrator": "神楽", "text": "あ、いえ…そんなに\n問題のある歌詞じゃ\nないんですけど…。"},
        { "location": "1016/TALK"  , "narrator": "神楽", "text": "元の歌詞は『籠の中の\n小鳥はいつか羽ばたく\n世界へ』なんです。"},
        { "location": "1018/TALK"  , "narrator": "神楽", "text": "それを『籠の中の羊は\nいつか羽ばたく空へ』\nと歌ってしまって…。"},
        { "location": "1020/TALK"  , "narrator": "アーヤ", "text": "ああ、羊が羽ばたく、\nっていうのはちょっと\n変かもね。"},
        { "location": "1022/TALK"  , "narrator": "みやび", "text": "いや、籠の中の羊、の\n部分の方が問題あり\nやろ？"},
        { "location": "1024/TALK"  , "narrator": "みやび", "text": "普通に考えて、\n籠壊れるやろ？"},
        { "location": "1026/TALK"  , "narrator": "アーヤ", "text": "あ、そうよね。"},
        { "location": "1028/TALK"  , "narrator": "つばめ", "text": "でも、籠が鋼鉄製なら\n壊れないんじゃない\nですか？"},
        { "location": "1029/TALK"  , "narrator": "ガブリエラ", "text": "いや、それもっと\nヤバいでしょ？"},
        { "location": "1030/TALK"  , "narrator": "ガブリエラ", "text": "籠の中、超グロい\nことになっちゃう\nじゃない…。"},
        { "location": "1032/TALK"  , "narrator": "アーヤ", "text": "…あ、なるほど。\nだから羊が空へ\n羽ばたくわけね。"},
        { "location": "1034/TALK"  , "narrator": "ガブリエラ", "text": "あ、なるほど。\nそれは気づかなかっ\nたわ。"},
        { "location": "1036/TALK"  , "narrator": "みやび", "text": "しっかし、そんな歌詞を\nよく即興で\n思いつくねえ。"},
        { "location": "1038/TALK"  , "narrator": "みやび", "text": "一流アーティストの\n感性っちゅうのは\n凄いもんやねぇ。"},
        { "location": "1040/TALK"  , "narrator": "神楽", "text": "じ、自分でも心の中で\n突っ込み入れながら\n歌ってたんです！"},
        { "location": "1042/TALK"  , "narrator": "神楽", "text": "はい、もうこの話は\nおしまいです！"},
        { "location": "1044/TALK"  , "narrator": "ガブリエラ", "text": "他にもそういう\n間違いしたこと\nあるの？"},
        { "location": "1046/TALK"  , "narrator": "神楽", "text": "もーっ！\n一回話したんだから\n許してください！"},
        { "location": "1049/TALK"  , "narrator": "つばめ", "text": "…ネットで探せば、\nどこかに映像残って\nたりしないかな？"},
        { "location": "1050/ACT"   , "narrator": "", "text": "みやびが負けるように操作する"},
        { "location": "1093/TALK"  , "narrator": "みやび", "text": "あー、しくったぁ。\nうちの負けながよ。"},
        { "location": "1094/TALK"  , "narrator": "ガブリエラ", "text": "残念だったわね。\nそれじゃ、早速話して\nもらおうかしら。"},
        { "location": "1099/TALK"  , "narrator": "みやび", "text": "しっかし、恥ずかしい\n話かぁ…。\nそうやなぁ…。"},
        { "location": "1101/TALK"  , "narrator": "みやび", "text": "…じゃあ、うちがまだ\n神奈川に引っ越す前の\n話をするがよ。"},
        { "location": "1102/TALK"  , "narrator": "みやび", "text": "あの頃のうちは、\nどこにでもおる、\n夢見がちな少女やった。"},
        { "location": "1103/TALK"  , "narrator": "みやび", "text": "ハッカーに憧れる\nどこにでもおる\nいたいけな女の子。"},
        { "location": "1106/TALK"  , "narrator": "アーヤ", "text": "えと…どこにでも？"},
        { "location": "1108/TALK"  , "narrator": "神楽", "text": "ハッカー界では\nよくある話、って\nことじゃないですか？"},
        { "location": "1110/TALK"  , "narrator": "みやび", "text": "その憧れるに\n至った理由が\nこれまた女子。"},
        { "location": "1111/TALK"  , "narrator": "みやび", "text": "有名ハッカーの\n男の人に、憧れた\nからながよ。"},
        { "location": "1114/TALK"  , "narrator": "ガブリエラ", "text": "えっ！？　みやびが\n男の人に！？"},
        { "location": "1116/TALK"  , "narrator": "アーヤ", "text": "へぇ…、みやびが\n男の人にねぇ…。\nちょっと意外かも。"},
        { "location": "1118/TALK"  , "narrator": "神楽", "text": "…もしかして、\nそれが恥ずかしい話\nですか？"},
        { "location": "1120/TALK"  , "narrator": "みやび", "text": "いや…問題は\nここからなんよ。"},
        { "location": "1121/TALK"  , "narrator": "みやび", "text": "うちな、その人の\nインタビューを\n雑誌で見たぞね。"},
        { "location": "1123/TALK"  , "narrator": "みやび", "text": "そいで。\nその人の…まあ、\nあれや…。"},
        { "location": "1124/TALK"  , "narrator": "みやび", "text": "好みの女の子の服装、\nっちゅうのを、\nずっとしてたぞね…。"},
        { "location": "1128/TALK"  , "narrator": "つばめ", "text": "和服じゃないん\nですか？"},
        { "location": "1130/TALK"  , "narrator": "みやび", "text": "うむ…これはマジで\n恥ずかしい話やき、\nすぐ忘れてほしい。"},
        { "location": "1131/TALK"  , "narrator": "みやび", "text": "…ゴスロリや。"},
        { "location": "1135/TALK"  , "narrator": "つばめ", "text": "な、なんですかそれ！\n絶対ウソでしょ！？"},
        { "location": "1137/TALK"  , "narrator": "ガブリエラ", "text": "そうよ、みやびが\nゴスロリとか、\n考えられないわ！"},
        { "location": "1139/TALK"  , "narrator": "みやび", "text": "…そうかいね？"},
        { "location": "1141/TALK"  , "narrator": "ガブリエラ", "text": "だって考えられない\nもの。\nねぇ？"},
        { "location": "1143/TALK"  , "narrator": "アーヤ", "text": "そうねぇ…。\nイメージ的に、\n和服と真逆だし。"},
        { "location": "1144/TALK"  , "narrator": "つばめ", "text": "着物のイメージ\nですもんね。\nみやびさんって。"},
        { "location": "1146/TALK"  , "narrator": "アーヤ", "text": "…でも、正直言うと\nウソって感じも\nしないのよねぇ。"},
        { "location": "1147/TALK"  , "narrator": "アーヤ", "text": "みやびって、今でも\n洋服じゃなくて\n和服でしょ？"},
        { "location": "1148/TALK"  , "narrator": "アーヤ", "text": "だから、理由があれば\nゴスロリ服だって\n着ると思うのよ。"},
        { "location": "1151/TALK"  , "narrator": "ガブリエラ", "text": "そ、そうかしら。\nでもゴスロリよ？"},
        { "location": "1153/TALK"  , "narrator": "アーヤ", "text": "ゴスロリ風の浴衣も\nあるんだし。"},
        { "location": "1154/TALK"  , "narrator": "アーヤ", "text": "今だって\n着ててもおかしくは\nないと思うわよ？"},
        { "location": "1156/TALK"  , "narrator": "神楽", "text": "…確かに、普段着てる\n着物だってミニスカ\nタイプですもんね。"},
        { "location": "1157/TALK"  , "narrator": "神楽", "text": "ゴスロリ衣装を着てた\nとしても…う～ん、\n変じゃないかも…。"},
        { "location": "1158/TALK"  , "narrator": "ガブリエラ", "text": "…やっぱりあたし、\nみやびのイメージって\n着物なのよね……。"},
        { "location": "1160/TALK"  , "narrator": "つばめ", "text": "そうだよね。\nわたしもそう思うよ。"},
        { "location": "1162/TALK"  , "narrator": "神楽", "text": "そうでしょうか？\nでもやっぱり…。"},
        { "location": "1166/TALK"  , "narrator": "みやび", "text": "…なんや、この展開？"},
        { "location": "1168/TALK"  , "narrator": "みやび", "text": "ツッコミが入ると\n思うて言うた\n冗談やったのに。"},
        { "location": "1170/TALK"  , "narrator": "みやび", "text": "素直すぎるぞね\nみんな……。"},
        { "location": "1182/DIALOG", "narrator": "Dialog_chapter_ch02", "text": "【17 告白】"}
    ]
}
