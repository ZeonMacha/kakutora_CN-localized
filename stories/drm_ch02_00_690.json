    [
        { "location": "152/SCENARIO", "narrator": "", "text": "610_お嫌いかしら"},
        { "location": "177/TALK"    , "narrator": "アーヤ", "text": "バスタイムはあんまり"},
        { "location": "178/TALK"    , "narrator": "アーヤ", "text": "短くしたくないのよね"},
        { "location": "180/SEL"     , "narrator": "", "text": "シャワーでよくない？"},
        { "location": "181/SEL"     , "narrator": "", "text": "そういうものなの"},
        { "location": "182/SEL"     , "narrator": "", "text": "女らしさアップだね"},
        { "location": "183/ACT"     , "narrator": "", "text": "シャワーでよくない？"},
        { "location": "184/TALK"    , "narrator": "アーヤ", "text": "そういうわけには"},
        { "location": "186/TALK"    , "narrator": "アーヤ", "text": "いかないわ"},
        { "location": "187/ACT"     , "narrator": "", "text": "そういうものなの"},
        { "location": "188/TALK"    , "narrator": "アーヤ", "text": "そうよ"},
        { "location": "189/ACT"     , "narrator": "", "text": "女らしさアップだね"},
        { "location": "199/TALK"    , "narrator": "アーヤ", "text": "そうかしら"},
        { "location": "200/TALK"    , "narrator": "アーヤ", "text": "そうならいいんだけど"},
        { "location": "202/TALK"    , "narrator": "アーヤ", "text": "特別な時は"},
        { "location": "203/TALK"    , "narrator": "アーヤ", "text": "とっておきのバスボム使ってみたりね"},
        { "location": "205/SEL"     , "narrator": "", "text": "バスボムって何？"},
        { "location": "206/SEL"     , "narrator": "", "text": "$me$も使うよ！"},
        { "location": "207/SEL"     , "narrator": "", "text": "あんまり好きじゃないかも"},
        { "location": "208/ACT"     , "narrator": "", "text": "バスボムって何？"},
        { "location": "209/TALK"    , "narrator": "アーヤ", "text": "入浴剤よ"},
        { "location": "211/TALK"    , "narrator": "アーヤ", "text": "丸い形の"},
        { "location": "212/TALK"    , "narrator": "アーヤ", "text": "泡がすごく出るやつね"},
        { "location": "213/TALK"    , "narrator": "アーヤ", "text": "お高いのが玉に瑕ね"},
        { "location": "214/ACT"     , "narrator": "", "text": "$me$も使うよ！"},
        { "location": "215/TALK"    , "narrator": "アーヤ", "text": "あらそうなの？"},
        { "location": "216/TALK"    , "narrator": "アーヤ", "text": "おすすめのとかある？"},
        { "location": "217/ACT"     , "narrator": "", "text": "あんまり好きじゃないかも"},
        { "location": "218/TALK"    , "narrator": "アーヤ", "text": "そうなのね"},
        { "location": "219/TALK"    , "narrator": "アーヤ", "text": "ちょっとだけ残念だわ"},
        { "location": "222/TALK"    , "narrator": "アーヤ", "text": "あとは半身浴ね"},
        { "location": "225/SEL"     , "narrator": "", "text": "色々やってるんだね"},
        { "location": "226/SEL"     , "narrator": "", "text": "バスタイム楽しいよね"},
        { "location": "227/ACT"     , "narrator": "", "text": "色々やってるんだね"},
        { "location": "228/TALK"    , "narrator": "アーヤ", "text": "そうね"},
        { "location": "229/ACT"     , "narrator": "", "text": "バスタイム楽しいよね"},
        { "location": "230/TALK"    , "narrator": "アーヤ", "text": "楽しいわよね"},
        { "location": "232/TALK"    , "narrator": "アーヤ", "text": "どうせなら"},
        { "location": "233/TALK"    , "narrator": "アーヤ", "text": "きれいになりたいもの"},
        { "location": "234/TALK"    , "narrator": "アーヤ", "text": "貴方のために"},
        { "location": "236/SEL"     , "narrator": "", "text": "十分きれいだよ"},
        { "location": "237/SEL"     , "narrator": "", "text": "これ以上綺麗にならなくても"},
        { "location": "238/SEL"     , "narrator": "", "text": "いい心がけだ"},
        { "location": "239/ACT"     , "narrator": "", "text": "十分きれいだよ"},
        { "location": "240/TALK"    , "narrator": "アーヤ", "text": "あら"},
        { "location": "241/TALK"    , "narrator": "アーヤ", "text": "お世辞でも嬉しいわ"},
        { "location": "242/ACT"     , "narrator": "", "text": "これ以上綺麗にならなくても"},
        { "location": "243/TALK"    , "narrator": "アーヤ", "text": "そんなことばっかり"},
        { "location": "244/TALK"    , "narrator": "アーヤ", "text": "もう！"},
        { "location": "245/ACT"     , "narrator": "", "text": "いい心がけだ"},
        { "location": "246/TALK"    , "narrator": "アーヤ", "text": "なんだか偉そうね"},
        { "location": "248/TALK"    , "narrator": "アーヤ", "text": "少しでもきれいになりたいのが"},
        { "location": "249/TALK"    , "narrator": "アーヤ", "text": "乙女心よ"},
        { "location": "250/TALK"    , "narrator": "アーヤ", "text": "わかって欲しいのよ"},
        { "location": "252/SEL"     , "narrator": "", "text": "わかってるってば"},
        { "location": "253/SEL"     , "narrator": "", "text": "前向きに努力する"},
        { "location": "254/ACT"     , "narrator": "", "text": "わかってるってば"},
        { "location": "255/TALK"    , "narrator": "アーヤ", "text": "本当かしら？"},
        { "location": "256/TALK"    , "narrator": "アーヤ", "text": "なんて"},
        { "location": "257/TALK"    , "narrator": "アーヤ", "text": "信用してるわ(^ε^)-☆!!"},
        { "location": "260/ACT"     , "narrator": "", "text": "前向きに努力する"},
        { "location": "261/TALK"    , "narrator": "アーヤ", "text": "ずいぶん固い言い方をするのね(;^_^A"},
        { "location": "262/TALK"    , "narrator": "アーヤ", "text": "まあいいけど"},
        { "location": "263/TALK"    , "narrator": "アーヤ", "text": "努力してね☆"},
        { "location": "267/TALK"    , "narrator": "ボイスメール", "text": "女子力は鍛えるものや否や"},
        { "location": "195/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>1000pt.</b></color></size>\nアップしました！"},
