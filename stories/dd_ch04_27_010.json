        "title": "SideStory005 ストーリー",
        "sub_title": "FILE04.辛抱"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "東京編４話"},
        { "location": "23/DIALOG" , "narrator": "", "text": "<color=green>9月4日　 2:02 PM</color>\nストライキ中、長野県松代アーヤの実家にて"},
        { "location": "26/TALK"   , "narrator": "ガブリエラ", "text": "ほら、これよ。\n劇場の掲示板の、\nこの書き込みを見て！"},
        { "location": "27/TALK"   , "narrator": "アーヤ", "text": "投稿者は…電子ウサギ？\nウサギって、まさか…。"},
        { "location": "28/TALK"   , "narrator": "みやび", "text": "…ガブちゃん、\nなんて書きこんどるか\n読んでもらえん？"},
        { "location": "30/TALK"   , "narrator": "ガブリエラ", "text": "うん…えっと…。"},
        { "location": "31/TALK"   , "narrator": "ガブリエラ", "text": "劇場、\nとうとう閉鎖でしょうか？"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "売店で売ってる店員さん\n手作りのたこ焼きが\n美味しかったのに残念。"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "もし店員さんが見てるなら\n連絡ください"},
        { "location": "35/TALK"   , "narrator": "ガブリエラ", "text": "…以上よ。\nこの書き込み、どう思う？"},
        { "location": "37/TALK"   , "narrator": "みやび", "text": "…多分、うさぎ達本人が\n書き込んだものやろうね。"},
        { "location": "38/TALK"   , "narrator": "みやび", "text": "しかも、わかりやすい\n暗号散りばめちょるし…。"},
        { "location": "39/TALK"   , "narrator": "ガブリエラ", "text": "管理庁のヤツラが繭達を\n語ってる可能性は？"},
        { "location": "40/TALK"   , "narrator": "アーヤ", "text": "…多分無いわね。"},
        { "location": "41/TALK"   , "narrator": "アーヤ", "text": "みやびが光月さんのことを\nうさぎって呼んでるのは\n聞かれたとしても…。"},
        { "location": "42/TALK"   , "narrator": "アーヤ", "text": "たこ焼きの話題までは、\n出してくると思わないし。"},
        { "location": "44/TALK"   , "narrator": "みやび", "text": "劇場の売店で、\nたこ焼きなんぞ\n売ったことないきね。"},
        { "location": "45/TALK"   , "narrator": "みやび", "text": "それに、ガブちゃんが\nたこ焼き作りが得意なの\n知ってるのは極一部や。"},
        { "location": "47/TALK"   , "narrator": "みやび", "text": "間違いない。\nこれはうさぎ達本人の\n書き込み確定や。"},
        { "location": "49/TALK"   , "narrator": "アーヤ", "text": "…困ったわね。"},
        { "location": "50/TALK"   , "narrator": "アーヤ", "text": "連絡しなければ、\nいずれ諦めると思って\nいたんだけど…。"},
        { "location": "52/TALK"   , "narrator": "ガブリエラ", "text": "どんどん違う方法を\n試しそうよね…。"},
        { "location": "53/TALK"   , "narrator": "アーヤ", "text": "そうね…。\nあの子達の行動力、\n甘く見てたわ…。"},
        { "location": "54/TALK"   , "narrator": "みやび", "text": "そうやねぇ…。"},
        { "location": "56/TALK"   , "narrator": "みやび", "text": "で、どうするが？\nなにか返信する？"},
        { "location": "57/TALK"   , "narrator": "アーヤ", "text": "…………。"},
        { "location": "59/TALK"   , "narrator": "アーヤ", "text": "…ううん。\nやめておきましょ。"},
        { "location": "62/TALK"   , "narrator": "ガブリエラ", "text": "それって、巻き込みたく\nないって思ってるから？"},
        { "location": "63/TALK"   , "narrator": "ガブリエラ", "text": "だとしたら、\nもう手遅れじゃない？"},
        { "location": "65/TALK"   , "narrator": "アーヤ", "text": "わかってる。"},
        { "location": "66/TALK"   , "narrator": "アーヤ", "text": "それでも…返さなければ\nこれ以上の深入りは\nできないと思うの…。"},
        { "location": "67/TALK"   , "narrator": "アーヤ", "text": "私達との連絡なしに、\n何かできるとは\n考えにくいし。"},
        { "location": "68/TALK"   , "narrator": "みやび", "text": "そうやろか？\n逆にもっと必死になって\n動く可能性もあるがよ？"},
        { "location": "69/TALK"   , "narrator": "アーヤ", "text": "…かもしれないわ。"},
        { "location": "73/TALK"   , "narrator": "ガブリエラ", "text": "…どっちにしろ、\n完全に止めることは\nできない、ってことね？"},
        { "location": "74/TALK"   , "narrator": "ガブリエラ", "text": "でも…これ以上\n巻き込みたくない、って\n考えには…賛成かな。"},
        { "location": "75/TALK"   , "narrator": "ガブリエラ", "text": "このままだと、取り返し\nつかないところまで\n踏み込んできそうだし…。"},
        { "location": "77/TALK"   , "narrator": "アーヤ", "text": "…ごめんなさい。\n私も、この件に関しては\nはっきりと自信持てない。"},
        { "location": "78/TALK"   , "narrator": "みやび", "text": "気にする必要ないぞね。"},
        { "location": "79/TALK"   , "narrator": "みやび", "text": "冷たい言い方やけんど、\nあの子らはトライナリーの\nメンバーやないきね。"},
        { "location": "80/TALK"   , "narrator": "みやび", "text": "あの子らのことまで、\nアーヤが責任持つ必要は\nまったくないちや。"},
        { "location": "81/TALK"   , "narrator": "アーヤ", "text": "…………。"},
        { "location": "84/TALK"   , "narrator": "ガブリエラ", "text": "…一旦さ、\nひなこ達のことは\n忘れた方がよくない？"},
        { "location": "85/TALK"   , "narrator": "ガブリエラ", "text": "今は自分たちのことで\n頭がいっぱいなのに…。"},
        { "location": "86/TALK"   , "narrator": "ガブリエラ", "text": "ひなこ達のことまで\n考えてたら、\nこっちが動けなくなるわ。"},
        { "location": "88/TALK"   , "narrator": "アーヤ", "text": "…そうね。\n一旦、日向さん達のことは\n忘れましょ。"},
        { "location": "90/TALK"   , "narrator": "みやび", "text": "…………。"},
        { "location": "103/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "104/TALK"  , "narrator": "みやび", "text": "アーヤには反対される\n思うて、言わんかった\nけんど…。"},
        { "location": "105/TALK"  , "narrator": "みやび", "text": "うさぎには…、\nRabbitAnimaに\nだけには伝えんと…。"},
        { "location": "106/TALK"  , "narrator": "みやび", "text": "勝手に管理庁に\nサイバー攻撃せんとも\n限らんし…。"},
        { "location": "109/TALK"  , "narrator": "みやび", "text": "…アーヤ、すまん。"},
        { "location": "119/TALK"  , "narrator": "ヒカル", "text": "…どう？\n掲示板、なにか返事は？"},
        { "location": "120/TALK"  , "narrator": "繭", "text": "…来てない。"},
        { "location": "122/TALK"  , "narrator": "ヒカル", "text": "そう…。\nいい考えだと思ったん\nだけど…。"},
        { "location": "124/TALK"  , "narrator": "繭", "text": "キリトにしては、\n珍しくさえた考えだと\n思う。"},
        { "location": "125/TALK"  , "narrator": "繭", "text": "いつもなら、こんな方法\n絶対に思いつかない。"},
        { "location": "127/TALK"  , "narrator": "ヒカル", "text": "そ、そうかな？"},
        { "location": "128/TALK"  , "narrator": "繭", "text": "間違いない。"},
        { "location": "129/TALK"  , "narrator": "繭", "text": "…まさか。"},
        { "location": "130/TALK"  , "narrator": "繭", "text": "連絡の取れなかった\n数日の間に、\n脳改造されたとか？"},
        { "location": "131/TALK"  , "narrator": "ヒカル", "text": "あはは、それはないよ。\nずっと一緒にいた僕が\n保証するよ。"},
        { "location": "132/TALK"  , "narrator": "繭", "text": "…本当に？"},
        { "location": "133/TALK"  , "narrator": "ヒカル", "text": "本当です。"},
        { "location": "134/TALK"  , "narrator": "ヒカル", "text": "脳改造どころか、\n出撃の命令が来るまで\nなにもなくて…。"},
        { "location": "135/TALK"  , "narrator": "ヒカル", "text": "暇過ぎて地獄だ、って\n辛過ぎる、って不満ばかり\n言ってたなぁ…。"},
        { "location": "136/TALK"  , "narrator": "繭", "text": "…ふふっ。"},
        { "location": "137/TALK"  , "narrator": "繭", "text": "昔から、退屈するの\n嫌いだったから…。"},
        { "location": "138/TALK"  , "narrator": "ヒカル", "text": "そうなの？"},
        { "location": "140/TALK"  , "narrator": "繭", "text": "ええ。\n…成長してないわ。"},
        { "location": "141/TALK"  , "narrator": "ヒカル", "text": "…変わらない、って\n言ってあげればいいのに。"},
        { "location": "142/TALK"  , "narrator": "ヒカル", "text": "でも、そっか…繭さんと\nキリトって、幼馴染って\n言ってたっけ…。"},
        { "location": "143/TALK"  , "narrator": "ヒカル", "text": "他にも、子供の頃から\n変わってないところって\nあるの？"},
        { "location": "145/TALK"  , "narrator": "繭", "text": "…………。"},
        { "location": "152/TALK"  , "narrator": "繭", "text": "…メール？\n今どき珍し――"},
        { "location": "154/TALK"  , "narrator": "繭", "text": "っ！？　これは…。"},
        { "location": "156/TALK"  , "narrator": "ヒカル", "text": "誰からですか？"},
        { "location": "157/TALK"  , "narrator": "繭", "text": "…みやび先輩から。"},
        { "location": "158/TALK"  , "narrator": "ヒカル", "text": "ほ、本当に！？"},
        { "location": "159/TALK"  , "narrator": "繭", "text": "アドレスは違うけど…、\n間違いない。"},
        { "location": "160/TALK"  , "narrator": "ヒカル", "text": "…なんて、\n書いてあるんですか？"},
        { "location": "161/TALK"  , "narrator": "繭", "text": "…場所は言えないが無事。\n今はそれ以上言えない。"},
        { "location": "162/TALK"  , "narrator": "繭", "text": "…これだけ。\n手掛かりになるような\nことは、書いてない…。"},
        { "location": "163/TALK"  , "narrator": "ヒカル", "text": "…どうにかして\n聞きだすことはできない？"},
        { "location": "164/TALK"  , "narrator": "繭", "text": "やってみるけど…、\n多分無駄だと思うわ…。"},
        { "location": "177/TALK"  , "narrator": "みやび", "text": "…やっぱり来たか。"},
        { "location": "178/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "179/TALK"  , "narrator": "みやび", "text": "予想通りの返事やな。\nさすがはうさぎや。"},
        { "location": "181/TALK"  , "narrator": "みやび", "text": "…けんど、さすがに\n危険やろうし…。"},
        { "location": "182/SEL"   , "narrator": "（選択肢）", "text": "なんて送られてきたの？"},
        { "location": "183/ACT"   , "narrator": "", "text": "なんて送られてきたの？"},
        { "location": "191/TALK"  , "narrator": "みやび", "text": "手助けしたい"},
        { "location": "192/TALK"  , "narrator": "みやび", "text": "その一言である"},
        { "location": "193/TALK"  , "narrator": "みやび", "text": "短くて明快でわかりやすい内容"},
        { "location": "194/TALK"  , "narrator": "みやび", "text": "素晴らしい"},
        { "location": "196/SEL"   , "narrator": "（選択肢）", "text": "なんて返すつもり？"},
        { "location": "197/ACT"   , "narrator": "", "text": "なんて返すつもり？"},
        { "location": "199/TALK"  , "narrator": "みやび", "text": "返さない"},
        { "location": "201/TALK"  , "narrator": "みやび", "text": "あくまでFatalQueenとして"},
        { "location": "202/TALK"  , "narrator": "みやび", "text": "RabbitAnimaに連絡をしたまで"},
        { "location": "203/TALK"  , "narrator": "みやび", "text": "これ以上の連絡は"},
        { "location": "204/TALK"  , "narrator": "みやび", "text": "不要である"},
        { "location": "207/TALK"  , "narrator": "みやび", "text": "今の状況は"},
        { "location": "208/TALK"  , "narrator": "みやび", "text": "マジでヤバい"},
        { "location": "209/TALK"  , "narrator": "みやび", "text": "これ以上巻き込む気は"},
        { "location": "210/TALK"  , "narrator": "みやび", "text": "毛頭ないぞね"},
        { "location": "212/SEL"   , "narrator": "（選択肢）", "text": "まだそんなこと言ってるの？"},
        { "location": "213/SEL"   , "narrator": "（選択肢）", "text": "それでいいと思う"},
        { "location": "214/ACT"   , "narrator": "", "text": "まだそんなこと言ってるの？"},
        { "location": "215/TALK"  , "narrator": "みやび", "text": "既に巻き込んでいる"},
        { "location": "216/TALK"  , "narrator": "みやび", "text": "それは理解している"},
        { "location": "217/TALK"  , "narrator": "みやび", "text": "キリトくん達が"},
        { "location": "218/TALK"  , "narrator": "みやび", "text": "謹慎処分を食らったこと"},
        { "location": "219/TALK"  , "narrator": "みやび", "text": "アーヤから聞かされたのでな"},
        { "location": "220/TALK"  , "narrator": "みやび", "text": "しかし"},
        { "location": "221/TALK"  , "narrator": "みやび", "text": "だとしても"},
        { "location": "222/TALK"  , "narrator": "みやび", "text": "これ以上はいかん"},
        { "location": "223/TALK"  , "narrator": "みやび", "text": "これ以上巻き込ませて"},
        { "location": "224/TALK"  , "narrator": "みやび", "text": "危険な目には合わせられんのだ"},
        { "location": "225/ACT"   , "narrator": "", "text": "それでいいと思う"},
        { "location": "226/TALK"  , "narrator": "みやび", "text": "そう思うか？"},
        { "location": "227/TALK"  , "narrator": "みやび", "text": "聞いて安心したぞね"},
        { "location": "228/TALK"  , "narrator": "みやび", "text": "助けを求めれば"},
        { "location": "229/TALK"  , "narrator": "みやび", "text": "うさぎ達のことだ"},
        { "location": "230/TALK"  , "narrator": "みやび", "text": "必ず協力を申し出る"},
        { "location": "231/TALK"  , "narrator": "みやび", "text": "命の危険も顧みずに"},
        { "location": "234/TALK"  , "narrator": "みやび", "text": "そんなこと"},
        { "location": "235/TALK"  , "narrator": "みやび", "text": "させるわけにはいかないのだ"},
        { "location": "239/TALK"  , "narrator": "みやび", "text": "いかんな"},
        { "location": "240/TALK"  , "narrator": "みやび", "text": "これ以上話していると"},
        { "location": "241/TALK"  , "narrator": "みやび", "text": "決意が揺らぐ"},
        { "location": "242/TALK"  , "narrator": "みやび", "text": "すまんが落ちるぞ"},
        { "location": "253/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "255/TALK"  , "narrator": "みやび", "text": "気持ちは嬉しい…。\nまっこと嬉しいが…。"},
        { "location": "256/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "257/TALK"  , "narrator": "みやび", "text": "気持ちだけは、\n確かに受け取ったぞね。"}
    ]
}
