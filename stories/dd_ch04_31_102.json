{
    "dir": "chap31/daydra/dd_ch04_31_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "31405",
        "cid": "miyabi",
        "title": "005 メインストーリー",
        "sub_title": "不可視可視の問題＜後編＞"
    },
    "entry":
    [
        { "location": "440/SCENARIO", "narrator": "", "text": "話は聞いた。いやもっと聞かせてくれ"},
        { "location": "459/TALK"    , "narrator": "真幌", "text": "音羽がコンタクトを\n取ってきたのか？"},
        { "location": "460/TALK"    , "narrator": "みやび", "text": "騙りでなければ\nそうなりますね。"},
        { "location": "461/TALK"    , "narrator": "真幌", "text": "…私にも見せてくれ。"},
        { "location": "462/TALK"    , "narrator": "みやび", "text": "もちろんです。"},
        { "location": "474/TALK"    , "narrator": "みやび", "text": "こちらはみやび"},
        { "location": "475/TALK"    , "narrator": "みやび", "text": "トライナリーの一員"},
        { "location": "477/TALK"    , "narrator": "音羽", "text": "はい"},
        { "location": "478/TALK"    , "narrator": "音羽", "text": "知っています"},
        { "location": "479/TALK"    , "narrator": "音羽", "text": "まずは感謝とお詫びを"},
        { "location": "480/TALK"    , "narrator": "みやび", "text": "それはこちらからすべきこと"},
        { "location": "482/TALK"    , "narrator": "音羽", "text": "それから今こちらには"},
        { "location": "483/TALK"    , "narrator": "音羽", "text": "アーヤさんとガブリエラさんがいます"},
        { "location": "484/TALK"    , "narrator": "みやび", "text": "それを聞いて安心した"},
        { "location": "486/TALK"    , "narrator": "音羽", "text": "それからエリカさんも"},
        { "location": "487/TALK"    , "narrator": "みやび", "text": "なんとうらやましい話"},
        { "location": "489/TALK"    , "narrator": "音羽", "text": "今は作戦会議中です"},
        { "location": "490/TALK"    , "narrator": "音羽", "text": "そしてみやびさんにお願いがあります"},
        { "location": "491/TALK"    , "narrator": "みやび", "text": "うちに？"},
        { "location": "493/TALK"    , "narrator": "音羽", "text": "今回の作戦には技術サポートが不可欠です"},
        { "location": "494/TALK"    , "narrator": "音羽", "text": "劇場システムのプログラムの書き換えが必要です"},
        { "location": "495/TALK"    , "narrator": "みやび", "text": "意外"},
        { "location": "496/TALK"    , "narrator": "みやび", "text": "音羽さんがそげなことにも詳しかったとは"},
        { "location": "498/TALK"    , "narrator": "音羽", "text": "いえこれは"},
        { "location": "499/TALK"    , "narrator": "音羽", "text": "エリカさんからの要望です"},
        { "location": "500/TALK"    , "narrator": "音羽", "text": "みやびさんならできる"},
        { "location": "501/TALK"    , "narrator": "音羽", "text": "アドバイスをと"},
        { "location": "502/TALK"    , "narrator": "みやび", "text": "なんと"},
        { "location": "516/TALK"    , "narrator": "真幌", "text": "この非常時に\nうれしそうだな\nみやび。"},
        { "location": "518/TALK"    , "narrator": "みやび", "text": "大人のくせに\nからかうのは\nなしですよ。"},
        { "location": "519/SEL"     , "narrator": "", "text": "やったね！"},
        { "location": "520/ACT"     , "narrator": "", "text": "やったね！"},
        { "location": "538/TALK"    , "narrator": "みやび", "text": "$handle$までそう言うか"},
        { "location": "540/SEL"     , "narrator": "", "text": "うれしいくせに"},
        { "location": "541/SEL"     , "narrator": "", "text": "なんかうれしくて"},
        { "location": "542/SEL"     , "narrator": "", "text": "本当は嫉妬の嵐"},
        { "location": "543/ACT"     , "narrator": "", "text": "うれしいくせに"},
        { "location": "544/TALK"    , "narrator": "みやび", "text": "うれしいに"},
        { "location": "545/TALK"    , "narrator": "みやび", "text": "決まっておるわ"},
        { "location": "546/ACT"     , "narrator": "", "text": "なんかうれしくて"},
        { "location": "547/TALK"    , "narrator": "みやび", "text": "それは何か"},
        { "location": "549/TALK"    , "narrator": "みやび", "text": "心の友というやつか"},
        { "location": "550/ACT"     , "narrator": "", "text": "本当は嫉妬の嵐"},
        { "location": "551/TALK"    , "narrator": "みやび", "text": "なんと"},
        { "location": "552/TALK"    , "narrator": "みやび", "text": "うちの心は$handle$のものぞね"},
        { "location": "564/TALK"    , "narrator": "みやび", "text": "夜も寝んとエリカさんの\nデータを読み込んだ\n意味があったぞね…！"},
        { "location": "565/TALK"    , "narrator": "みやび", "text": "まさかこんな展開に\nなるとは…！"},
        { "location": "568/TALK"    , "narrator": "みやび", "text": "アドレスの割出しと\n修復は自動化\nできますき。"},
        { "location": "569/TALK"    , "narrator": "みやび", "text": "うちは音羽の話を\n聞くことにします。"},
        { "location": "570/TALK"    , "narrator": "真幌", "text": "…ああ。\n頼んだぞ。"},
        { "location": "583/TALK"    , "narrator": "みやび", "text": "ではまず…"},
        { "location": "596/DIALOG"  , "narrator": "Dialog_chapter_ch04", "text": "【25 ワールド・スピード】"}
    ]
}
