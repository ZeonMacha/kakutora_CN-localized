        "title": "【EXストーリー】秘めたる野望",
        "sub_title": "コネクトストーリー"
    },
    "entry":
    [
        { "location": "6/SCENARIO", "narrator": "", "text": "【導入】クワイエットコルト"},
        { "location": "12/DIALOG" , "narrator": "", "text": "<size=40>CURAN STORY. 02</size>\nGABRIELLA\n\n<size=45>北原成人</size>\n<size=35>～孤高にはなりきれず～</size>"},
        { "location": "34/TALK"   , "narrator": "ガブリエラ", "text": "やっと来たわね。\n待ちくたびれたわ、\n$handle$。"},
        { "location": "35/TALK"   , "narrator": "ガブリエラ", "text": "ここはね。私たち\nトライナリーと、\nクランたちとの交差点。"},
        { "location": "36/TALK"   , "narrator": "ガブリエラ", "text": "ココロとココロが\n出逢って、共鳴して、\n最後に繋がりあう場所。"},
        { "location": "38/SEL"    , "narrator": "（選択肢）", "text": "概要説明を飛ばす"},
        { "location": "39/SEL"    , "narrator": "（選択肢）", "text": "もう一度聞く"},
        { "location": "40/ACT"    , "narrator": "", "text": "概要説明を飛ばす"},
        { "location": "41/TALK"   , "narrator": "ガブリエラ", "text": "というわけで、\n早速今回のクランを\n紹介するわ。"},
        { "location": "43/ACT"    , "narrator": "", "text": "もう一度聞く"},
        { "location": "48/TALK"   , "narrator": "ガブリエラ", "text": "ここでは、普段私たちを\n助けてくれるサーバント\nクランを紹介するの。"},
        { "location": "49/TALK"   , "narrator": "ガブリエラ", "text": "そして、貴方が直接\n彼女たちと繋がれる\nように手続きをする場所。"},
        { "location": "50/SEL"    , "narrator": "（選択肢）", "text": "直接繋がるとどうなるの？"},
        { "location": "51/ACT"    , "narrator": "", "text": "直接繋がるとどうなるの？"},
        { "location": "54/TALK"   , "narrator": "ガブリエラ", "text": "クランたちとの\n相互理解が深まるという\n感じかしらね。"},
        { "location": "55/TALK"   , "narrator": "ガブリエラ", "text": "このセクターでは、\nクラン一人にスポットを\n当てて紹介するわ。"},
        { "location": "56/TALK"   , "narrator": "ガブリエラ", "text": "そして彼女との【儀式】\nによって、貴方とココロを\n繋げるの。"},
        { "location": "57/TALK"   , "narrator": "ガブリエラ", "text": "【儀式】には『コネクト』\nと『シンクロ』の２つが\nあるわ。"},
        { "location": "59/TALK"   , "narrator": "ガブリエラ", "text": "『コネクト』は、貴方と\nクランが物理的に繋がる\nための儀式なのよ。"},
        { "location": "60/TALK"   , "narrator": "ガブリエラ", "text": "これは、バトルをする事で\n彼女と貴方の中にある、\n抵抗勢力を無力化する。"},
        { "location": "62/TALK"   , "narrator": "ガブリエラ", "text": "次の『シンクロ』では、\nクランの過去を知り、\n共感しなさい。"},
        { "location": "63/TALK"   , "narrator": "ガブリエラ", "text": "クランの過去の\n物語をシェアすることで、\n心が通うようになるわ。"},
        { "location": "65/TALK"   , "narrator": "ガブリエラ", "text": "ここまで、\n大丈夫かしら。"},
        { "location": "66/TALK"   , "narrator": "ガブリエラ", "text": "もし、入るセクターを\n間違えたならば\n今からでも退場できてよ。"},
        { "location": "67/SEL"    , "narrator": "（選択肢）", "text": "大丈夫、先に進んで"},
        { "location": "68/SEL"    , "narrator": "（選択肢）", "text": "間違えたから退場する"},
        { "location": "69/SEL"    , "narrator": "（選択肢）", "text": "なんでそんな女王様っぽいの？"},
        { "location": "70/ACT"    , "narrator": "", "text": "大丈夫、先に進んで"},
        { "location": "71/TALK"   , "narrator": "ガブリエラ", "text": "いいのね？\nじゃあ、今回の\nクランを紹介するわ。"},
        { "location": "72/ACT"    , "narrator": "", "text": "間違えたから退場する"},
        { "location": "74/TALK"   , "narrator": "ガブリエラ", "text": "え、\n何なのよそれ！？"},
        { "location": "75/TALK"   , "narrator": "ガブリエラ", "text": "じゃあさっさと\n出て行きなさい。"},
        { "location": "76/TALK"   , "narrator": "ガブリエラ", "text": "でも、\n気が変わったら。"},
        { "location": "78/TALK"   , "narrator": "ガブリエラ", "text": "$handle$と\nあたしに、\n素敵なココロの旅を。"},
        { "location": "80/ACT"    , "narrator": "", "text": "なんでそんな女王様っぽいの？"},
        { "location": "81/TALK"   , "narrator": "ガブリエラ", "text": "別に。\n理由なんて\nなくてよ。"},
        { "location": "82/TALK"   , "narrator": "ガブリエラ", "text": "でもクランとの\n【儀式】は友達に\nなるのとは違うもの。"},
        { "location": "83/TALK"   , "narrator": "ガブリエラ", "text": "真面目にすれば\n自然とこうなる\nものでしょう？"},
        { "location": "84/TALK"   , "narrator": "ガブリエラ", "text": "むしろ\n$handle$も\n改まるべきだわ。"},
        { "location": "85/TALK"   , "narrator": "ガブリエラ", "text": "そんなことより。\n今回のクランを\n紹介してよ。"},
        { "location": "94/TALK"   , "narrator": "ガブリエラ", "text": "オープンプロセス、\n0x53F番地から\n0xFFF番地へ。"},
        { "location": "95/TALK"   , "narrator": "ガブリエラ", "text": "共通意識野を経由、\n外部スフィアへ接続。"},
        { "location": "96/TALK"   , "narrator": "ガブリエラ", "text": "EXEC_SEEK_SECTOR\n=>Link() EXT_SPHERE/."},
        { "location": "121/TALK"  , "narrator": "ガブリエラ", "text": "シーク完了ね。"},
        { "location": "122/TALK"  , "narrator": "ガブリエラ", "text": "さて――。"},
        { "location": "123/TALK"  , "narrator": "ガブリエラ", "text": "今回、貴方に\n紹介するクランは\n<color=red>【クワイエット・コルト】</color>"},
        { "location": "127/TALK"  , "narrator": "ガブリエラ", "text": "発症は2016年1月1日。\n自宅でしかも元旦になんて\nぞっとしないわ。"},
        { "location": "128/TALK"  , "narrator": "ガブリエラ", "text": "発症する前の名前は\n北原成人。\n年齢は24歳。"},
        { "location": "129/TALK"  , "narrator": "ガブリエラ", "text": "ココロファイルナンバー\nE03-153-51によると、\n発症の原因は……"},
        { "location": "130/TALK"  , "narrator": "ガブリエラ", "text": "家族との\n意見の相違。"},
        { "location": "131/TALK"  , "narrator": "ガブリエラ", "text": "ニートな自分と\n官僚になった兄弟、\nそれを比較する親。"},
        { "location": "132/TALK"  , "narrator": "ガブリエラ", "text": "それだけ聞くと\n成人が全面的に\n悪いみたいだわね。"},
        { "location": "133/TALK"  , "narrator": "ガブリエラ", "text": "そうじゃないのよ。\n成人は理想が\n高すぎたのよ。"},
        { "location": "134/TALK"  , "narrator": "ガブリエラ", "text": "世間の理不尽が\n許せなかった。\n特に官僚の。"},
        { "location": "135/TALK"  , "narrator": "ガブリエラ", "text": "なのに世間や親が\n認めるのは兄弟の方。"},
        { "location": "136/TALK"  , "narrator": "ガブリエラ", "text": "腐敗の温床を\n是正するという志を\n持つ自分はニート。"},
        { "location": "137/TALK"  , "narrator": "ガブリエラ", "text": "自分に力さえあれば\nこんな理不尽を\n変えられる。"},
        { "location": "138/TALK"  , "narrator": "ガブリエラ", "text": "そんな思いが\n【コルト】と弱肉強食の\n世界を生んだのよ。"},
        { "location": "139/SEL"   , "narrator": "（選択肢）", "text": "弱肉強食ねえ"},
        { "location": "140/SEL"   , "narrator": "（選択肢）", "text": "コルトは負けないの？"},
        { "location": "141/ACT"   , "narrator": "", "text": "弱肉強食ねえ"},
        { "location": "142/TALK"  , "narrator": "ガブリエラ", "text": "自分で生きる\n能力がないものに\n待つのは死のみ。"},
        { "location": "143/TALK"  , "narrator": "ガブリエラ", "text": "残酷すぎる\n世界だわよね。"},
        { "location": "144/ACT"   , "narrator": "", "text": "コルトは負けないの？"},
        { "location": "146/TALK"  , "narrator": "ガブリエラ", "text": "というより、\n負ける気がない、と\n言うべきでしょうね。"},
        { "location": "147/TALK"  , "narrator": "ガブリエラ", "text": "世界の創造主は\n全てを支配\nできるのだから。"},
        { "location": "149/TALK"  , "narrator": "ガブリエラ", "text": "その考え、\n全部が間違ってるとは\n思わなくてよ。"},
        { "location": "150/SEL"   , "narrator": "（選択肢）", "text": "ガブリエラは\nそこに共感したんだ"},
        { "location": "151/SEL"   , "narrator": "（選択肢）", "text": "だからガブリエラが仕切ってるんだ"},
        { "location": "152/ACT"   , "narrator": "", "text": "ガブリエラは\nそこに共感したんだ"},
        { "location": "153/TALK"  , "narrator": "ガブリエラ", "text": "それだけじゃないわ。\nあたしと相性が\nいい理由は。"},
        { "location": "154/ACT"   , "narrator": "", "text": "だからガブリエラが仕切ってるんだ"},
        { "location": "155/TALK"  , "narrator": "ガブリエラ", "text": "そうね。"},
        { "location": "156/TALK"  , "narrator": "ガブリエラ", "text": "結果的に一番\n相性のいい\nクランの一人だわね。"},
        { "location": "158/TALK"  , "narrator": "ガブリエラ", "text": "そして\n$handle$。"},
        { "location": "159/TALK"  , "narrator": "ガブリエラ", "text": "貴方は【コルト】と\n『コネクト』の\nプロセスを行いなさい。"},
        { "location": "160/TALK"  , "narrator": "ガブリエラ", "text": "コルトの抵抗する\n意思と戦って\n勝ちなさい。"},
        { "location": "161/TALK"  , "narrator": "ガブリエラ", "text": "そうすれば【コルト】と\n『シンクロ』することが\nできるようになるわ。"},
        { "location": "162/SEL"   , "narrator": "（選択肢）", "text": "とりあえずやってみる"},
        { "location": "163/SEL"   , "narrator": "（選択肢）", "text": "ガブリエラとはコネクトできないの？"},
        { "location": "164/ACT"   , "narrator": "", "text": "とりあえずやってみる"},
        { "location": "165/TALK"  , "narrator": "ガブリエラ", "text": "そうね。\n勝ちなさい、\n$handle$。"},
        { "location": "166/TALK"  , "narrator": "ガブリエラ", "text": "アクセス開始。\n$handle$に\n素敵なココロの旅を！"},
        { "location": "167/ACT"   , "narrator": "", "text": "ガブリエラとはコネクトできないの？"},
        { "location": "168/TALK"  , "narrator": "ガブリエラ", "text": "そういう場所じゃ\nないわ。"},
        { "location": "169/TALK"  , "narrator": "ガブリエラ", "text": "でも勝つことが\nできたなら。"},
        { "location": "171/TALK"  , "narrator": "ガブリエラ", "text": "だから\n勝ちなさい、\n$handle$。"},
        { "location": "172/TALK"  , "narrator": "ガブリエラ", "text": "アクセス開始。\n$handle$に\n素敵なココロの旅を！"}
    ]
}
