{
    "dir": "chap33/daydra/dd_ch05_33_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "33502",
        "cid": "kagura",
        "title": "002 メインストーリー",
        "sub_title": "１年Ａ組珠緒先生＜前編＞"
    },
    "entry":
    [
        { "location": "2289/TALK"  , "narrator": "雛", "text": "…まゆちん、\nこれって、罠かな？"},
        { "location": "2290/TALK"  , "narrator": "繭", "text": "わからない…。\nでも、急に解放される\nとは思えない…。"},
        { "location": "2295/TALK"  , "narrator": "珠緒先生", "text": "二人とも、早く出て！"},
        { "location": "2297/TALK"  , "narrator": "雛", "text": "え、えぇっ！？\nたまちゃん\nせんせい！？"},
        { "location": "2299/TALK"  , "narrator": "繭", "text": "どうしてここに！？"},
        { "location": "2300/TALK"  , "narrator": "珠緒先生", "text": "まほちゃんに\n頼まれてね。\n助けに来たの。"},
        { "location": "2302/TALK"  , "narrator": "繭", "text": "こんな危険なところへ\n一人で来たのですか？"},
        { "location": "2303/TALK"  , "narrator": "珠緒先生", "text": "こう見えても、\n私だって管理庁の\n一職員なのよ？"},
        { "location": "2304/TALK"  , "narrator": "珠緒先生", "text": "舐めてもらっちゃ\n困るわ。"},
        { "location": "2305/TALK"  , "narrator": "雛", "text": "ってことはまさか、\nたまちゃんせんせい\nって…。"},
        { "location": "2306/TALK"  , "narrator": "雛", "text": "影の特別攻撃隊の\n一人だったとか！？"},
        { "location": "2307/TALK"  , "narrator": "珠緒先生", "text": "あ、いや、先生はそういう\n暴力的なことは\nちょっと…。"},
        { "location": "2308/TALK"  , "narrator": "雛", "text": "やっぱねー。\n背も低いから\n強そうに見えないし。"},
        { "location": "2317/TALK"  , "narrator": "雛", "text": "イタッ！？\nげ、げんこつした！！\n暴力的じゃん！"},
        { "location": "2318/TALK"  , "narrator": "珠緒先生", "text": "身長のことを言われて\n黙ってられるほど、\n心は大きくありません！"},
        { "location": "2320/TALK"  , "narrator": "雛", "text": "が、外見に合った\nミニマムな心…？"},
        { "location": "2321/TALK"  , "narrator": "珠緒先生", "text": "なにか言いました？"},
        { "location": "2322/TALK"  , "narrator": "雛", "text": "いえなにも\nごめんなさいー！"},
        { "location": "2323/TALK"  , "narrator": "繭", "text": "そんなことより、\n卯月さんはどこに\nいるんですか？"},
        { "location": "2324/TALK"  , "narrator": "珠緒先生", "text": "あの子は…多分、\nここにはいないわ。"},
        { "location": "2325/TALK"  , "narrator": "珠緒先生", "text": "かなり特別な所に\n連れて行かれたんじゃ\nないかとは思うけど。"},
        { "location": "2326/TALK"  , "narrator": "雛", "text": "神楽ちゃん…。"},
        { "location": "2328/TALK"  , "narrator": "珠緒先生", "text": "…とにかく、\nここでのんびりしては\nいられないわ。"},
        { "location": "2329/TALK"  , "narrator": "珠緒先生", "text": "早くここから\n逃げましょ。"},
        { "location": "2373/TALK"  , "narrator": "珠緒先生", "text": "ここなら安全よ。\n二人とも、\nラクにしてて。"},
        { "location": "2374/TALK"  , "narrator": "雛", "text": "いや～、娑婆の空気は\n美味いねぇー。"},
        { "location": "2375/TALK"  , "narrator": "繭", "text": "…眩しい。"},
        { "location": "2376/TALK"  , "narrator": "雛", "text": "ずーっと暗い牢屋に\nいたからねー。"},
        { "location": "2377/TALK"  , "narrator": "キリト", "text": "おっ、無事だったか！"},
        { "location": "2386/TALK"  , "narrator": "キリト", "text": "お勤め、\nごくろーさん。"},
        { "location": "2387/TALK"  , "narrator": "繭", "text": "キリト！？"},
        { "location": "2393/TALK"  , "narrator": "ヒカル", "text": "よかった…。\n二人とも、\n無事だったみたいで。"},
        { "location": "2395/TALK"  , "narrator": "雛", "text": "ヒカルくんも！\n二人とも来てたんだ？"},
        { "location": "2396/TALK"  , "narrator": "キリト", "text": "たまちゃんに\n呼ばれてな。"},
        { "location": "2397/TALK"  , "narrator": "キリト", "text": "…二人とも、マジで\nケガとかしてないか？"},
        { "location": "2398/TALK"  , "narrator": "雛", "text": "大丈夫だよー。\n牢屋に入れられてた\nだけだったし。"},
        { "location": "2399/TALK"  , "narrator": "繭", "text": "床が硬くて、\n少し身体が痛い。"},
        { "location": "2400/TALK"  , "narrator": "キリト", "text": "元気ってことだな。"},
        { "location": "2401/TALK"  , "narrator": "ヒカル", "text": "先生も無事だった\nみたいだし、\n一安心だね。"},
        { "location": "2403/TALK"  , "narrator": "珠緒先生", "text": "先生は生徒を助ける\nプロフェッショナル\nだもの。"},
        { "location": "2404/TALK"  , "narrator": "キリト", "text": "おっ、普段と違って\n頼りがいがあるな。"},
        { "location": "2405/TALK"  , "narrator": "珠緒先生", "text": "こらー、普段は\n頼りがいないみたいな\nこと言わないの！"},
        { "location": "2406/TALK"  , "narrator": "雛", "text": "あはは、でも本当、\nたまちゃんせんせい\nには感謝してるよー。"},
        { "location": "2407/TALK"  , "narrator": "繭", "text": "…キリト達も、\nこんなところにいて\n大丈夫なの？"},
        { "location": "2408/TALK"  , "narrator": "キリト", "text": "自宅謹慎になってる\nから、バレたら\nマジでヤバいな。"},
        { "location": "2409/TALK"  , "narrator": "ヒカル", "text": "けど、珠緒先生に\n頼まれたら\n断れないよ。"},
        { "location": "2410/TALK"  , "narrator": "ヒカル", "text": "先生は東雲教官の\n味方だからね。"},
        { "location": "2413/TALK"  , "narrator": "珠緒先生", "text": "友達、っていう方が\n近いかしら？"},
        { "location": "2414/TALK"  , "narrator": "珠緒先生", "text": "だから、管理庁に\n逆らうことになっても\n助けなくちゃって思った。"},
        { "location": "2415/TALK"  , "narrator": "キリト", "text": "へえ…、先生って、\n義理高い人\nだったんだな？"},
        { "location": "2416/TALK"  , "narrator": "珠緒先生", "text": "友達は大切にしろ、\nって教える側だもの。\n実践しないと。"},
        { "location": "2418/TALK"  , "narrator": "珠緒先生", "text": "と、それじゃ私は\nちょっとやること\nあるから…。"},
        { "location": "2420/TALK"  , "narrator": "珠緒先生", "text": "みんなはしばらく、\nここで休んでいて。"},
        { "location": "2427/TALK"  , "narrator": "雛", "text": "ふぅ…。\nなんか、変な感じ。"},
        { "location": "2428/TALK"  , "narrator": "雛", "text": "さっきまで牢屋に\nいたなんて、\n信じられないよ…。"},
        { "location": "2429/TALK"  , "narrator": "ヒカル", "text": "なんにせよ、本当に\n無事でよかったよ。"},
        { "location": "2430/TALK"  , "narrator": "繭", "text": "…それはそうと、\n今の状況について\n詳しく知りたい。"},
        { "location": "2431/TALK"  , "narrator": "繭", "text": "私達が\n捕まっている間に、\nなにがあったの？"},
        { "location": "2432/TALK"  , "narrator": "キリト", "text": "それは…。"},
        { "location": "2434/TALK"  , "narrator": "雛", "text": "…つばめちゃんが\n捕まったのは\n知ってるよ。"},
        { "location": "2436/TALK"  , "narrator": "キリト", "text": "…ワルい。\n庇おうと思ったんだ\nけど、ダメだった…。"},
        { "location": "2437/TALK"  , "narrator": "ヒカル", "text": "キリトのせいじゃ\nないよ。"},
        { "location": "2438/TALK"  , "narrator": "ヒカル", "text": "あれは、僕たちには\nどうすることも\nできなかったから…。"},
        { "location": "2439/TALK"  , "narrator": "繭", "text": "…みやび先輩達は？"},
        { "location": "2441/TALK"  , "narrator": "キリト", "text": "さあ？　行方不明だ。\nこっちからの連絡にも\n応答なしだし…。"},
        { "location": "2442/TALK"  , "narrator": "ヒカル", "text": "ということは、\nみやび先輩達は\n捕まってないんだ？"},
        { "location": "2443/TALK"  , "narrator": "繭", "text": "逢瀬さんが捕まった\nとしか、卯月さんは\n言ってなかった。"},
        { "location": "2444/TALK"  , "narrator": "キリト", "text": "卯月から？\nスパイの言葉を\n信用していいのか？"},
        { "location": "2445/TALK"  , "narrator": "雛", "text": "ち、違うよ！\n確かにスパイは\nしてたけど…。"},
        { "location": "2446/TALK"  , "narrator": "雛", "text": "しなくちゃいけない\n理由があったんだよ！"},
        { "location": "2447/TALK"  , "narrator": "キリト", "text": "なんだ、それ？"},
        { "location": "2448/TALK"  , "narrator": "繭", "text": "…私が話す。\n実は――"},
        { "location": "2463/TALK"  , "narrator": "繭", "text": "――これが、\n卯月さんがみんなを\nスパイしていた理由。"},
        { "location": "2464/TALK"  , "narrator": "キリト", "text": "いや、ちょっと待て。\n情報量多過ぎだ！"},
        { "location": "2465/TALK"  , "narrator": "ヒカル", "text": "卯月さんがスパイを\nしていた理由は、\nよくわかったけど…。"},
        { "location": "2466/TALK"  , "narrator": "ヒカル", "text": "この世界…日本が、\nフェノメノンの中に\nある世界だなんて…。"},
        { "location": "2467/TALK"  , "narrator": "雛", "text": "信じられないけど、\n本当の話だよ。"},
        { "location": "2468/TALK"  , "narrator": "雛", "text": "それ以外にも、\nフェノメノンが…。"},
        { "location": "2469/TALK"  , "narrator": "雛", "text": "人工的に造られたもの\nっていうのも\nわかったし。"},
        { "location": "2470/TALK"  , "narrator": "キリト", "text": "まさか！\n自然現象みたいな\nもんだろ？"},
        { "location": "2471/TALK"  , "narrator": "繭", "text": "世間一般には、\nそう思われてる。"},
        { "location": "2472/TALK"  , "narrator": "繭", "text": "でも真実は、\n人の手で\n生み出されたもの。"},
        { "location": "2473/TALK"  , "narrator": "繭", "text": "その証拠に、\n卯月さんのトライ\nガジェットには…。"},
        { "location": "2474/TALK"  , "narrator": "繭", "text": "発症するための機能が\n組み込まれてた。"},
        { "location": "2476/TALK"  , "narrator": "キリト", "text": "…マジかよ。\n今いる、俺たちの\nこの世界が…。"},
        { "location": "2477/TALK"  , "narrator": "キリト", "text": "全部ニセモノだった\nなんて…。"},
        { "location": "2478/TALK"  , "narrator": "ヒカル", "text": "…卯月さんは？\n彼女は、今はどこに？"},
        { "location": "2479/TALK"  , "narrator": "繭", "text": "わからない…。"},
        { "location": "2480/TALK"  , "narrator": "繭", "text": "でも、間違いなく\nロクな目には\nあっていないはず。"},
        { "location": "2482/TALK"  , "narrator": "ヒカル", "text": "…絶望的だね。"},
        { "location": "2483/TALK"  , "narrator": "ヒカル", "text": "トライナリーの\nみんなとは連絡が\n取れないし。"},
        { "location": "2484/TALK"  , "narrator": "ヒカル", "text": "管理庁の長官は、\nこの世界を悪い方に\n変えようとしている。"},
        { "location": "2485/TALK"  , "narrator": "ヒカル", "text": "そのために、\n逢瀬さんを破壊――"},
        { "location": "2486/TALK"  , "narrator": "ヒカル", "text": "殺そうとしている。"},
        { "location": "2488/TALK"  , "narrator": "キリト", "text": "…けど、それが\nわかったなら、\nこうしてられないな。"},
        { "location": "2490/TALK"  , "narrator": "キリト", "text": "俺たちも、あいつらを\n助けるために\n動こうぜ！"},
        { "location": "2491/TALK"  , "narrator": "雛", "text": "賛成！こんなところで\nのんびりしてられ\nないよ。"},
        { "location": "2493/TALK"  , "narrator": "ヒカル", "text": "今すぐ！？\nそれは無理だよ。"},
        { "location": "2495/TALK"  , "narrator": "キリト", "text": "なに言ってんだよ！\nこのまま黙って\nいられないだろ！？"},
        { "location": "2496/TALK"  , "narrator": "繭", "text": "無闇に動いても\n自滅するだけ。"},
        { "location": "2497/TALK"  , "narrator": "繭", "text": "というより、\n次動いたらアウト。"},
        { "location": "2499/TALK"  , "narrator": "雛", "text": "危険なことなのは\nわかってるよ。"},
        { "location": "2500/TALK"  , "narrator": "雛", "text": "牢屋でも、そのことは\n言ったでしょ？"},
        { "location": "2502/TALK"  , "narrator": "繭", "text": "状況が違う。\n今は、本当に動くだけ\nでも危険な状況よ。"},
        { "location": "2503/TALK"  , "narrator": "キリト", "text": "けど、あいつらは\n友達じゃないか。\n見捨てるのかよ！？"},
        { "location": "2505/TALK"  , "narrator": "ヒカル", "text": "そんな言い方は\nないだろ？"},
        { "location": "2506/TALK"  , "narrator": "ヒカル", "text": "けど、下手に動けば\n彼女たちだけじゃ\nなくて…。"},
        { "location": "2507/TALK"  , "narrator": "ヒカル", "text": "僕たち全員、みんな\n殺されることになる\nかもしれないんだ。"},
        { "location": "2508/TALK"  , "narrator": "キリト", "text": "危険は承知だろ！？"},
        { "location": "2509/TALK"  , "narrator": "ヒカル", "text": "意味の無い無駄死に\nしても仕方ないだろ！"},
        { "location": "2510/TALK"  , "narrator": "珠緒先生", "text": "こらー！！"},
        { "location": "2524/TALK"  , "narrator": "珠緒先生", "text": "なに考えてるの！\nこんな状況で\nケンカだなんて…！"},
        { "location": "2527/TALK"  , "narrator": "雛", "text": "たまちゃん\nせんせい…。"},
        { "location": "2529/TALK"  , "narrator": "珠緒先生", "text": "一体、どうしたの？\n先生に話しなさい！"},
        { "location": "2530/TALK"  , "narrator": "繭", "text": "…これからのことに\nついての話です。"},
        { "location": "2531/TALK"  , "narrator": "キリト", "text": "先生。俺たち、\n逢瀬達を助けに\n行こうと思うんだ。"},
        { "location": "2533/TALK"  , "narrator": "珠緒先生", "text": "えぇっ！？"},
        { "location": "2535/TALK"  , "narrator": "ヒカル", "text": "作戦もないのに、\n無闇に行くのは\n反対だよ。"},
        { "location": "2536/TALK"  , "narrator": "キリト", "text": "そうしてる間に、\n逢瀬達がどうなるか\nわからないだろ。"},
        { "location": "2537/TALK"  , "narrator": "雛", "text": "そうだよ。\n今すぐにでも、\n助けに行こう！"},
        { "location": "2539/TALK"  , "narrator": "珠緒先生", "text": "なに言ってるの！\nそんなのダメに\n決まってるでしょ！？"},
        { "location": "2540/TALK"  , "narrator": "珠緒先生", "text": "今、あなた達は\n外に出るだけでも\n危険なのよ？"},
        { "location": "2541/TALK"  , "narrator": "キリト", "text": "わかってるけど、\nこのまま黙っては\nいられないだろ！"},
        { "location": "2543/TALK"  , "narrator": "珠緒先生", "text": "なんの策もなく、\nあなた達が出て行って\nなにができるの！？"},
        { "location": "2544/TALK"  , "narrator": "雛", "text": "ここにいたって\nなにもできないよ！"},
        { "location": "2545/TALK"  , "narrator": "雛", "text": "それなら、\n出て行って少しでも\n何かしたいの！"},
        { "location": "2547/TALK"  , "narrator": "珠緒先生", "text": "考えもなしに\n出て行ったって…。"},
        { "location": "2548/TALK"  , "narrator": "雛", "text": "なら、たまちゃん\nせんせいもなにか\n考えて！"},
        { "location": "2549/TALK"  , "narrator": "雛", "text": "先生は生徒を助ける\nプロフェッショナル\nだって…。"},
        { "location": "2550/TALK"  , "narrator": "雛", "text": "さっき言ったじゃん！"},
        { "location": "2551/TALK"  , "narrator": "珠緒先生", "text": "い、言ったけど、\nえっと…。"},
        { "location": "2552/TALK"  , "narrator": "雛", "text": "それに、せんせいも\n東雲教官と同じ、\n管理庁の職員でしょ？"},
        { "location": "2553/TALK"  , "narrator": "雛", "text": "なら、東雲教官と\n同じように動ける\nはずじゃん！"},
        { "location": "2554/TALK"  , "narrator": "珠緒先生", "text": "…………。"},
        { "location": "2556/TALK"  , "narrator": "珠緒先生", "text": "確かに、私も\nまほちゃんと同じ\n権限は持ってる。"},
        { "location": "2557/TALK"  , "narrator": "珠緒先生", "text": "それなのに、\n自分からはなにも\nしようとしていない。"},
        { "location": "2558/TALK"  , "narrator": "珠緒先生", "text": "…でも、管理庁に\n逆らったりしたら、\n法律を破ることに…。"},
        { "location": "2559/TALK"  , "narrator": "珠緒先生", "text": "でも、日向さん達を\n助けたことには、\n後悔はないわ。"},
        { "location": "2560/TALK"  , "narrator": "珠緒先生", "text": "法律的には正しくない\n行動だけど…。"},
        { "location": "2561/TALK"  , "narrator": "珠緒先生", "text": "教師として、人として\n正しい行動だと\n思ったから。"},
        { "location": "2562/TALK"  , "narrator": "珠緒先生", "text": "…………。"},
        { "location": "2563/SEL"   , "narrator": "", "text": "つばめを助けてほしい"},
        { "location": "2564/ACT"   , "narrator": "", "text": "つばめを助けてほしい"},
        { "location": "2583/TALK"  , "narrator": "繭", "text": "…えっ、この人は。"},
        { "location": "2585/TALK"  , "narrator": "雛", "text": "まゆちん？"},
        { "location": "2586/TALK"  , "narrator": "繭", "text": "みんな、パーティー\nトークにするから、\n入ってきて。"},
        { "location": "2588/TALK"  , "narrator": "繭", "text": "先生も、\nお願いします。"},
        { "location": "2590/TALK"  , "narrator": "珠緒先生", "text": "もう、今度は\nなんなの？"},
        { "location": "2607/TALK"  , "narrator": "雛", "text": "$handle$さんもあたし達と同じなんだね！"},
        { "location": "2609/TALK"  , "narrator": "キリト", "text": "雛の友達か？"},
        { "location": "2611/TALK"  , "narrator": "繭", "text": "卯月さんの協力者"},
        { "location": "2613/TALK"  , "narrator": "雛", "text": "すっごい頼りになる味方だよ！"},
        { "location": "2615/TALK"  , "narrator": "珠緒先生", "text": "うちの生徒がお世話になっております"},
        { "location": "2617/TALK"  , "narrator": "ヒカル", "text": "それで、お話しというのは？"},
        { "location": "2619/SEL"   , "narrator": "", "text": "つばめを助けてほしい"},
        { "location": "2620/ACT"   , "narrator": "", "text": "つばめを助けてほしい"},
        { "location": "2622/TALK"  , "narrator": "キリト", "text": "もちろんそのつもりだ"},
        { "location": "2624/TALK"  , "narrator": "雛", "text": "絶対つばめちゃんを助けてみせるから"},
        { "location": "2626/TALK"  , "narrator": "繭", "text": "焚きつけないで"},
        { "location": "2627/TALK"  , "narrator": "繭", "text": "なんの策もないまま動いたところで"},
        { "location": "2628/TALK"  , "narrator": "繭", "text": "待ってるのは最悪の結末だけ"},
        { "location": "2630/TALK"  , "narrator": "雛", "text": "なにもしなくても結末は同じだと思うけど？"},
        { "location": "2632/TALK"  , "narrator": "繭", "text": "否定はしない"},
        { "location": "2634/TALK"  , "narrator": "珠緒先生", "text": "逢瀬さんを助けたいという気持ちは伝わりますけど"},
        { "location": "2635/TALK"  , "narrator": "珠緒先生", "text": "生徒を焚きつけるのはやめてください！"},
        { "location": "2637/SEL"   , "narrator": "", "text": "助けてもらわないと困る"},
        { "location": "2638/SEL"   , "narrator": "", "text": "このままじゃ歴史が変わっちゃう"},
        { "location": "2639/ACT"   , "narrator": "", "text": "助けてもらわないと困る"},
        { "location": "2640/TALK"  , "narrator": "ヒカル", "text": "僕たちだって助けたい気持ちはあります"},
        { "location": "2641/TALK"  , "narrator": "ヒカル", "text": "助けられるものなら、今すぐにでも助けに行きたい"},
        { "location": "2642/TALK"  , "narrator": "ヒカル", "text": "けど、僕たちの力でそれが可能とは思えません"},
        { "location": "2644/ACT"   , "narrator": "", "text": "このままじゃ歴史が変わっちゃう"},
        { "location": "2645/TALK"  , "narrator": "ヒカル", "text": "なんの話ですか？"},
        { "location": "2647/TALK"  , "narrator": "キリト", "text": "そんなタイムトラベラーみたいなこと急に言われても"},
        { "location": "2648/TALK"  , "narrator": "キリト", "text": "反応に困るぞ？"},
        { "location": "2650/TALK"  , "narrator": "雛", "text": "でも、事実かも"},
        { "location": "2651/TALK"  , "narrator": "雛", "text": "この人って、普通の人じゃないっぽいし"},
        { "location": "2653/TALK"  , "narrator": "繭", "text": "そもそも、この人が誰でどういう人なのかもちゃんとは知らないんだけど"},
        { "location": "2655/TALK"  , "narrator": "珠緒先生", "text": "知らない相手と連絡を取り合うのは危険でしょ！"},
        { "location": "2657/TALK"  , "narrator": "繭", "text": "リアルで会うわけじゃないから問題ありません"},
        { "location": "2659/SEL"   , "narrator": "", "text": "信じなくていいから、つばめを助けて！"},
        { "location": "2660/ACT"   , "narrator": "", "text": "信じなくていいから、つばめを助けて！"},
        { "location": "2662/TALK"  , "narrator": "ヒカル", "text": "僕たちだって助けたい気持ちはあります"},
        { "location": "2663/TALK"  , "narrator": "ヒカル", "text": "助けられるものなら、今すぐにでも助けに行きたい"},
        { "location": "2664/TALK"  , "narrator": "ヒカル", "text": "けど、僕たちの力でそれが可能とは思えません"},
        { "location": "2667/TALK"  , "narrator": "繭", "text": "ちょっと待って"},
        { "location": "2668/TALK"  , "narrator": "繭", "text": "もしかして、逢瀬さんを助けるための方法を"},
        { "location": "2669/TALK"  , "narrator": "繭", "text": "なにか知ってるとか？"},
        { "location": "2671/SEL"   , "narrator": "", "text": "君たちがなにをすればいいか"},
        { "location": "2672/ACT"   , "narrator": "", "text": "君たちがなにをすればいいか"},
        { "location": "2674/TALK"  , "narrator": "キリト", "text": "マジか！？"},
        { "location": "2676/TALK"  , "narrator": "珠緒先生", "text": "ダメです！"},
        { "location": "2677/TALK"  , "narrator": "珠緒先生", "text": "さっきも言いましたけど、生徒を焚きつけないでください！"},
        { "location": "2678/TALK"  , "narrator": "珠緒先生", "text": "もしこの子達の身になにかあったら"},
        { "location": "2679/TALK"  , "narrator": "珠緒先生", "text": "どう責任を取るつもりですか？"},
        { "location": "2681/TALK"  , "narrator": "繭", "text": "いえ、責任を取る必要はありません"},
        { "location": "2682/TALK"  , "narrator": "繭", "text": "可能性があるのであれば"},
        { "location": "2683/TALK"  , "narrator": "繭", "text": "私達は、自分で動くことを決めますので"},
        { "location": "2685/TALK"  , "narrator": "雛", "text": "おおっ、まゆちん！！"},
        { "location": "2687/TALK"  , "narrator": "ヒカル", "text": "僕も同感です"},
        { "location": "2689/TALK"  , "narrator": "キリト", "text": "さっきまであんな反対してたのにか？"},
        { "location": "2691/TALK"  , "narrator": "ヒカル", "text": "上手くいく可能性がゼロなら、今でも反対してるよ"},
        { "location": "2692/TALK"  , "narrator": "ヒカル", "text": "でも、少しでも可能性があるというなら"},
        { "location": "2693/TALK"  , "narrator": "ヒカル", "text": "それがどれだけ小さくても、僕は動くよ"},
        { "location": "2694/TALK"  , "narrator": "ヒカル", "text": "逢瀬さんは大切な友達だからね"},
        { "location": "2696/TALK"  , "narrator": "雛", "text": "ヒカルくん、かっこいいー！！"},
        { "location": "2698/TALK"  , "narrator": "珠緒先生", "text": "絶対にダメです！！"},
        { "location": "2700/TALK"  , "narrator": "雛", "text": "じゃあ、たまちゃんせんせいはつばめちゃんを放っておいていいと思ってるの？"},
        { "location": "2702/TALK"  , "narrator": "珠緒先生", "text": "それも絶対ダメです！！"},
        { "location": "2703/TALK"  , "narrator": "珠緒先生", "text": "でも、だからってこんなこと許せるはずがないでしょう？"},
        { "location": "2705/TALK"  , "narrator": "キリト", "text": "たまちゃん、今日はやけに頑固だな"},
        { "location": "2707/TALK"  , "narrator": "珠緒先生", "text": "先生なんだから当然です！"},
        { "location": "2709/TALK"  , "narrator": "ヒカル", "text": "それを決めるのは、話を聞いてからでも遅くないと思うけど？"},
        { "location": "2711/TALK"  , "narrator": "繭", "text": "そうね"},
        { "location": "2712/TALK"  , "narrator": "繭", "text": "私達がなにをすればいいのかを教えて"},
        { "location": "2714/SEL"   , "narrator": "", "text": "真幌に連絡を取って、連係プレーをとるんだ"},
        { "location": "2715/ACT"   , "narrator": "", "text": "真幌に連絡を取って、連係プレーをとるんだ"},
        { "location": "2717/TALK"  , "narrator": "キリト", "text": "ハードル高すぎじゃね？"},
        { "location": "2719/TALK"  , "narrator": "雛", "text": "東雲教官に連絡って"},
        { "location": "2720/TALK"  , "narrator": "雛", "text": "それ絶対怒鳴られて断られるフラグのような"},
        { "location": "2722/TALK"  , "narrator": "ヒカル", "text": "東雲教官、そういうところ本当にきっちりしてるからね"},
        { "location": "2724/TALK"  , "narrator": "雛", "text": "それ無理、却下ー"},
        { "location": "2726/SEL"   , "narrator": "", "text": "珠緒先生が一緒ならＯＫしてくれるよ"},
        { "location": "2727/ACT"   , "narrator": "", "text": "珠緒先生が一緒ならＯＫしてくれるよ"},
        { "location": "2729/TALK"  , "narrator": "珠緒先生", "text": "はい！？"},
        { "location": "2731/TALK"  , "narrator": "ヒカル", "text": "なるほど"},
        { "location": "2732/TALK"  , "narrator": "ヒカル", "text": "僕たち生徒だけならダメかもしれないけど"},
        { "location": "2733/TALK"  , "narrator": "ヒカル", "text": "先生で、管理庁職員でもある珠緒先生が一緒なら"},
        { "location": "2734/TALK"  , "narrator": "ヒカル", "text": "納得してくれる可能性はあるかも"},
        { "location": "2736/TALK"  , "narrator": "繭", "text": "先生、教官への連絡お願いします"},
        { "location": "2738/TALK"  , "narrator": "珠緒先生", "text": "バカなこと言わないでください！"},
        { "location": "2739/TALK"  , "narrator": "珠緒先生", "text": "そんなことまほちゃんに言ったら"},
        { "location": "2740/TALK"  , "narrator": "珠緒先生", "text": "私が怒鳴られるじゃないですか！"},
        { "location": "2742/TALK"  , "narrator": "キリト", "text": "たまちゃんも教官のこと怖いのか"},
        { "location": "2744/TALK"  , "narrator": "珠緒先生", "text": "怒ったまほちゃん、本当怖いのよ？"},
        { "location": "2746/TALK"  , "narrator": "雛", "text": "知ってるよー"},
        { "location": "2748/TALK"  , "narrator": "キリト", "text": "マジ泣きそうになるレベルだよな"},
        { "location": "2750/TALK"  , "narrator": "ヒカル", "text": "頭真っ白になるよね"},
        { "location": "2752/TALK"  , "narrator": "繭", "text": "気絶した経験アリ"},
        { "location": "2754/SEL"   , "narrator": "", "text": "生徒のためだ、連絡するだけでもして！"},
        { "location": "2755/ACT"   , "narrator": "", "text": "生徒のためだ、連絡するだけでもして！"},
        { "location": "2757/TALK"  , "narrator": "繭", "text": "私もそうしてもらいたいです"},
        { "location": "2758/TALK"  , "narrator": "繭", "text": "もししていただけないのであれば"},
        { "location": "2759/TALK"  , "narrator": "繭", "text": "最悪、私達だけで独断で動くことになる可能性も出てきますが？"},
        { "location": "2761/TALK"  , "narrator": "雛", "text": "確実にそうなると思うよー"},
        { "location": "2763/TALK"  , "narrator": "キリト", "text": "まあ、当然だよな"},
        { "location": "2765/TALK"  , "narrator": "ヒカル", "text": "すみません、僕も同意見です"},
        { "location": "2767/TALK"  , "narrator": "珠緒先生", "text": "ああもう！！"},
        { "location": "2768/TALK"  , "narrator": "珠緒先生", "text": "じゃあ、もしまほちゃんが許可しなかった場合は"},
        { "location": "2769/TALK"  , "narrator": "珠緒先生", "text": "絶対に動かないと約束しなさい！"},
        { "location": "2770/TALK"  , "narrator": "珠緒先生", "text": "それなら、連絡を取るだけはしてあげます"},
        { "location": "2772/TALK"  , "narrator": "繭", "text": "異議無し、よろしくお願いします"},
        { "location": "2774/SEL"   , "narrator": "", "text": "いい生徒達だね、先生"},
        { "location": "2775/SEL"   , "narrator": "", "text": "よろしく、たまちゃん"},
        { "location": "2776/ACT"   , "narrator": "", "text": "いい生徒達だね、先生"},
        { "location": "2777/TALK"  , "narrator": "珠緒先生", "text": "自慢の生徒達ですよ"},
        { "location": "2778/TALK"  , "narrator": "珠緒先生", "text": "いい子過ぎて暴走気味ではありますけどね"},
        { "location": "2779/ACT"   , "narrator": "", "text": "よろしく、たまちゃん"},
        { "location": "2780/TALK"  , "narrator": "珠緒先生", "text": "ちゃんと、珠緒先生と呼んでください！"},
        { "location": "2786/TALK"  , "narrator": "珠緒先生", "text": "はぁ…まほちゃん、\n絶対怒ると思うん\nだけどなぁ…。"},
        { "location": "2816/TALK"  , "narrator": "真幌", "text": "ふむ…やはり、\n今のままでは東京に\n戻ることすら困難か。"},
        { "location": "2817/TALK"  , "narrator": "みやび", "text": "うちらが都内に入った\n瞬間、国交省の\nカメラに見られて…。"},
        { "location": "2819/TALK"  , "narrator": "みやび", "text": "あっという間に\n一網打尽コース\n確定ながですよ。"},
        { "location": "2820/TALK"  , "narrator": "真幌", "text": "…頭が痛いな。\nさて、\nどうしたものか…。"},
        { "location": "2827/TALK"  , "narrator": "真幌", "text": "ん…？\n珠緒からか。"},
        { "location": "2828/TALK"  , "narrator": "みやび", "text": "なに言うてきてます？"},
        { "location": "2829/TALK"  , "narrator": "真幌", "text": "…………。"},
        { "location": "2830/TALK"  , "narrator": "真幌", "text": "はぁ…なにをやって\nいるんだ。\nあいつらは…。"},
        { "location": "2831/TALK"  , "narrator": "みやび", "text": "問題ですか？"},
        { "location": "2832/TALK"  , "narrator": "真幌", "text": "逢瀬のことを\n助けようと…。"},
        { "location": "2833/TALK"  , "narrator": "真幌", "text": "日向達が動こうと\nしているらしい。"},
        { "location": "2835/TALK"  , "narrator": "みやび", "text": "あ～、あの子達なら\n不思議じゃないが\nですよ。"},
        { "location": "2836/TALK"  , "narrator": "真幌", "text": "まったく、\nあいつらは…。"},
        { "location": "2837/TALK"  , "narrator": "真幌", "text": "…まあ、珠緒が一緒\nならば、無茶なことは\nさせないだろう。"},
        { "location": "2838/TALK"  , "narrator": "真幌", "text": "それに、手伝いが\nほしいというのも\n事実だからな。"},
        { "location": "2839/TALK"  , "narrator": "真幌", "text": "…しかし、こちらから\n既読をつけてしまえば\n足がついてしまうし。"},
        { "location": "2841/TALK"  , "narrator": "みやび", "text": "…どうするがですか？"},
        { "location": "2842/TALK"  , "narrator": "真幌", "text": "…どうしたものかな。"},
        { "location": "2892/TALK"  , "narrator": "真幌", "text": "　"},
        { "location": "2907/TALK"  , "narrator": "真幌", "text": "何者だ！"},
        { "location": "2908/SEL"   , "narrator": "", "text": "$handle$です！"},
        { "location": "2909/SEL"   , "narrator": "", "text": "エリカさんの友達です！"},
        { "location": "2910/SEL"   , "narrator": "", "text": "結婚してください！"},
        { "location": "2911/ACT"   , "narrator": "", "text": "$handle$です！"},
        { "location": "2912/TALK"  , "narrator": "真幌", "text": "知らん！"},
        { "location": "2914/ACT"   , "narrator": "", "text": "エリカさんの友達です！"},
        { "location": "2915/TALK"  , "narrator": "真幌", "text": "エリカの…？\nまたアイツ、\n余計なことをしてるな…？"},
        { "location": "2916/TALK"  , "narrator": "真幌", "text": "いや、待て。ちゃんと\n確認する必要がある。"},
        { "location": "2917/TALK"  , "narrator": "真幌", "text": "エリカの友人というなら\nわかるだろう。"},
        { "location": "2918/TALK"  , "narrator": "真幌", "text": "アイツが作っている\n迷惑きわまりない機械の\n名前を言ってみろ。"},
        { "location": "2919/SEL"   , "narrator": "", "text": "にゃもット"},
        { "location": "2920/SEL"   , "narrator": "", "text": "にゃボッチ"},
        { "location": "2921/SEL"   , "narrator": "", "text": "にゅボット"},
        { "location": "2922/SEL"   , "narrator": "", "text": "にゃボット"},
        { "location": "2923/SEL"   , "narrator": "", "text": "にやボット"},
        { "location": "2924/SEL"   , "narrator": "", "text": "にゃポット"},
        { "location": "2925/ACT"   , "narrator": "", "text": "にゃもット"},
        { "location": "2927/ACT"   , "narrator": "", "text": "にゃボッチ"},
        { "location": "2929/ACT"   , "narrator": "", "text": "にゅボット"},
        { "location": "2931/ACT"   , "narrator": "", "text": "にゃボット"},
        { "location": "2933/ACT"   , "narrator": "", "text": "にやボット"},
        { "location": "2935/ACT"   , "narrator": "", "text": "にゃポット"},
        { "location": "2939/ACT"   , "narrator": "", "text": "結婚してください！"},
        { "location": "2940/TALK"  , "narrator": "真幌", "text": "未亡人のこの私に\n求婚とは、良い度胸だな。"},
        { "location": "2941/TALK"  , "narrator": "真幌", "text": "ならば、冥土の土産に\n教えてやろう。"},
        { "location": "2942/TALK"  , "narrator": "真幌", "text": "私は夫を先のヨーロッパ\n戦線で亡くしている。"},
        { "location": "2943/TALK"  , "narrator": "真幌", "text": "私の刻は、\nそこから一秒も\n刻まれていないのだ。"},
        { "location": "2944/SEL"   , "narrator": "", "text": "$me$が癒したい"},
        { "location": "2945/SEL"   , "narrator": "", "text": "ごめんなさい"},
        { "location": "2946/ACT"   , "narrator": "", "text": "$me$が癒したい"},
        { "location": "2947/TALK"  , "narrator": "真幌", "text": "今はまだ、\n癒しは必要ない。"},
        { "location": "2948/TALK"  , "narrator": "真幌", "text": "癒しよりも大事なものを、\nこの思い出から\n享受しているからな。"},
        { "location": "2949/TALK"  , "narrator": "真幌", "text": "私が言いたいのは、\nそれだけだ。"},
        { "location": "2950/ACT"   , "narrator": "", "text": "ごめんなさい"},
        { "location": "2951/TALK"  , "narrator": "真幌", "text": "謝るような\nことではない。"},
        { "location": "2952/TALK"  , "narrator": "真幌", "text": "ただ、\nそういうことなだけだ。"},
        { "location": "2957/TALK"  , "narrator": "真幌", "text": "はぁ……。"},
        { "location": "2958/TALK"  , "narrator": "真幌", "text": "どうやら\n本物らしいな、\n残念ながら。"},
        { "location": "2959/TALK"  , "narrator": "真幌", "text": "であれば、\n如何なる要件だ。"},
        { "location": "2960/SEL"   , "narrator": "", "text": "心の葛藤を処理しに来ました"},
        { "location": "2961/ACT"   , "narrator": "", "text": "心の葛藤を処理しに来ました"},
        { "location": "2963/TALK"  , "narrator": "真幌", "text": "そういうものは\n不要なのだがな……。"},
        { "location": "2964/TALK"  , "narrator": "真幌", "text": "まあ、エリカが仕向けた\n事なのであれば、何か\n裏があるのだろうが。"},
        { "location": "2965/TALK"  , "narrator": "真幌", "text": "まあいい。\n様子を見てみるか。"},
        { "location": "2966/TALK"  , "narrator": "真幌", "text": "オープンプロセス、\n0x042番地から\n0x911番地へ。"},
        { "location": "2990/TALK"  , "narrator": "真幌", "text": "シーク完了。"},
        { "location": "2992/TALK"  , "narrator": "真幌", "text": "で、どのような\n悩みなんだ？"},
        { "location": "2995/TALK"  , "narrator": "真幌", "text": "……。"},
        { "location": "2996/TALK"  , "narrator": "真幌", "text": "馬鹿馬鹿しい。"},
        { "location": "2997/TALK"  , "narrator": "真幌", "text": "生徒に危険な事を\nさせられるわけがない。"},
        { "location": "2998/SEL"   , "narrator": "", "text": "レポートには何て書いてあったの？"},
        { "location": "2999/ACT"   , "narrator": "", "text": "レポートには何て書いてあったの？"},
        { "location": "3001/TALK"  , "narrator": "真幌", "text": "珠緒からの連絡に対し、\n協力を要請するか否かで\n悩んでいるそうだ。"},
        { "location": "3002/SEL"   , "narrator": "", "text": "それだけじゃなくて、本当のところどうしたいかも書かれてる筈だよ"},
        { "location": "3003/ACT"   , "narrator": "", "text": "それだけじゃなくて、本当のところどうしたいかも書かれてる筈だよ"},
        { "location": "3005/TALK"  , "narrator": "真幌", "text": "……。"},
        { "location": "3006/TALK"  , "narrator": "真幌", "text": "腐ってもエリカの差し金と\nいったところか。"},
        { "location": "3007/TALK"  , "narrator": "真幌", "text": "書かれていることは――"},
        { "location": "3008/TALK"  , "narrator": "真幌", "text": "信頼して、冷静に考え、\n出来ることを協力して\nもらえ…だそうだ。"},
        { "location": "3009/TALK"  , "narrator": "真幌", "text": "しかしだな……"},
        { "location": "3010/SEL"   , "narrator": "", "text": "能力を見くびってるの？"},
        { "location": "3011/SEL"   , "narrator": "", "text": "たまちゃん先生そんなに頼りにならないの？"},
        { "location": "3012/ACT"   , "narrator": "", "text": "能力を見くびってるの？"},
        { "location": "3013/TALK"  , "narrator": "真幌", "text": "まさか。"},
        { "location": "3014/TALK"  , "narrator": "真幌", "text": "アイツ等は、下手な実戦\n部隊より、スキルは高い。"},
        { "location": "3015/TALK"  , "narrator": "真幌", "text": "ただ、経験が\nなさ過ぎるんだ。"},
        { "location": "3016/SEL"   , "narrator": "", "text": "だから経験させるんじゃないの？無理のない範囲で"},
        { "location": "3017/ACT"   , "narrator": "", "text": "だから経験させるんじゃないの？無理のない範囲で"},
        { "location": "3019/ACT"   , "narrator": "", "text": "たまちゃん先生そんなに頼りにならないの？"},
        { "location": "3020/TALK"  , "narrator": "真幌", "text": "まさか。"},
        { "location": "3021/TALK"  , "narrator": "真幌", "text": "むしろアイツは……"},
        { "location": "3022/TALK"  , "narrator": "真幌", "text": "いや、いい。"},
        { "location": "3023/SEL"   , "narrator": "", "text": "なになになに！！"},
        { "location": "3024/ACT"   , "narrator": "", "text": "なになになに！！"},
        { "location": "3026/TALK"  , "narrator": "真幌", "text": "…失言だったな。"},
        { "location": "3027/TALK"  , "narrator": "真幌", "text": "アイツはバカっぽく\n見えるけどな、\nとんでもない奴だぞ。"},
        { "location": "3028/TALK"  , "narrator": "真幌", "text": "私自身、珠緒がいなければ\nアウトだった事だって、\n数え切れない程ある。"},
        { "location": "3029/TALK"  , "narrator": "真幌", "text": "けど、今回は\nそういう問題じゃ\nないだろう。"},
        { "location": "3030/SEL"   , "narrator": "", "text": "たまちゃん先生に同情するよ…"},
        { "location": "3031/ACT"   , "narrator": "", "text": "たまちゃん先生に同情するよ…"},
        { "location": "3034/TALK"  , "narrator": "真幌", "text": "……。\nはぁ…全く。"},
        { "location": "3035/TALK"  , "narrator": "真幌", "text": "何故私が、お前のような\nポッと出てきた奴に\n諭されないといけない。"},
        { "location": "3036/TALK"  , "narrator": "真幌", "text": "まあいい、わかった。\nわかったよ。"},
        { "location": "3037/TALK"  , "narrator": "真幌", "text": "珠緒の得意分野で\n１つ頼みたいことがある。\nそれを頼むことにしよう。"},
        { "location": "3038/SEL"   , "narrator": "", "text": "おおっ！！"},
        { "location": "3039/ACT"   , "narrator": "", "text": "おおっ！！"},
        { "location": "3041/TALK"  , "narrator": "真幌", "text": "というわけで、\nここからはお前の\n役目なんだろ。"},
        { "location": "3042/SEL"   , "narrator": "", "text": "え？"},
        { "location": "3043/SEL"   , "narrator": "", "text": "まあ、そうっすね"},
        { "location": "3044/ACT"   , "narrator": "", "text": "え？"},
        { "location": "3045/TALK"  , "narrator": "真幌", "text": "え？　じゃないだろ。\n知らないとでも\n思ってるのか？"},
        { "location": "3046/TALK"  , "narrator": "真幌", "text": "クランの退治に\n行ってくるんだろう？"},
        { "location": "3047/ACT"   , "narrator": "", "text": "まあ、そうっすね"},
        { "location": "3048/TALK"  , "narrator": "真幌", "text": "それじゃ、\nクランの退治は\n任せたぞ。"},
        { "location": "3057/TALK"  , "narrator": "エリカ", "text": "まほちゃん、の人格さん、こんにちは！"},
        { "location": "3058/TALK"  , "narrator": "真幌", "text": "エリカか、なんでまた"},
        { "location": "3060/TALK"  , "narrator": "エリカ", "text": "急にごめんね、２つお話があって"},
        { "location": "3061/TALK"  , "narrator": "エリカ", "text": "１つめは、今回$handle$さんに行ってもらいはしたんだけど、葛藤の解消は、つばめちゃんにお願いすることになるってことで"},
        { "location": "3062/TALK"  , "narrator": "真幌", "text": "逢瀬？"},
        { "location": "3064/TALK"  , "narrator": "エリカ", "text": "そう、ちょっと細かい話は後でするけど"},
        { "location": "3065/TALK"  , "narrator": "エリカ", "text": "２つめは、$handle$さんをこれから連れて行ってもいいかな？ってこと"},
        { "location": "3066/TALK"  , "narrator": "真幌", "text": "デートか"},
        { "location": "3068/TALK"  , "narrator": "エリカ", "text": "ちがうよーーーーーー！！！"},
        { "location": "3069/SEL"   , "narrator": "", "text": "違います"},
        { "location": "3070/SEL"   , "narrator": "", "text": "そんな断言しなくても！"},
        { "location": "3071/ACT"   , "narrator": "", "text": "違います"},
        { "location": "3072/TALK"  , "narrator": "エリカ", "text": "冷静にそう言われると、ちょっとションボリしちゃうけど、、、"},
        { "location": "3073/TALK"  , "narrator": "真幌", "text": "まんざらでもなさそうな"},
        { "location": "3075/ACT"   , "narrator": "", "text": "そんな断言しなくても！"},
        { "location": "3076/TALK"  , "narrator": "エリカ", "text": "あっごめんなさい"},
        { "location": "3078/TALK"  , "narrator": "エリカ", "text": "とにかく、とっても重大な用事があるからごめんね"},
        { "location": "3079/TALK"  , "narrator": "真幌", "text": "構わない、話は終わってる"},
        { "location": "3081/TALK"  , "narrator": "エリカ", "text": "ありがとう！"},
        { "location": "3082/TALK"  , "narrator": "エリカ", "text": "すぐに転送するね、$handle$さんよろしくお願いします！"},
        { "location": "3087/TALK"  , "narrator": "真幌", "text": "お前も大変なのに\n好かれてるな。"},
        { "location": "3088/SEL"   , "narrator": "", "text": "いずれプロポーズする予定です！"},
        { "location": "3089/SEL"   , "narrator": "", "text": "いえ、可愛いと思います！"},
        { "location": "3090/SEL"   , "narrator": "", "text": "いえ、有能だと思います"},
        { "location": "3091/SEL"   , "narrator": "", "text": "確かに、センスが破壊的"},
        { "location": "3092/SEL"   , "narrator": "", "text": "ホント辛い"},
        { "location": "3093/ACT"   , "narrator": "", "text": "いずれプロポーズする予定です！"},
        { "location": "3094/TALK"  , "narrator": "真幌", "text": "奴の友人として\n忠告しておく。\nやめとけ。"},
        { "location": "3095/ACT"   , "narrator": "", "text": "いえ、可愛いと思います！"},
        { "location": "3096/TALK"  , "narrator": "真幌", "text": "いいセンスしてるな。\nお似合いだ。"},
        { "location": "3097/ACT"   , "narrator": "", "text": "いえ、有能だと思います"},
        { "location": "3098/TALK"  , "narrator": "真幌", "text": "まあ、そこは\n否定しないがな。"},
        { "location": "3099/ACT"   , "narrator": "", "text": "確かに、センスが破壊的"},
        { "location": "3100/TALK"  , "narrator": "真幌", "text": "全くだ。\nネコ型のアレは\n殺す気かと思ったぞ。"},
        { "location": "3101/ACT"   , "narrator": "", "text": "ホント辛い"},
        { "location": "3102/TALK"  , "narrator": "真幌", "text": "何だ、随分と\n溜めていそうだな。"},
        { "location": "3104/TALK"  , "narrator": "真幌", "text": "まあいい、\nいずれにせよ、そろそろ\nお別れのようだ。"},
        { "location": "3105/TALK"  , "narrator": "真幌", "text": "珍しい体験を\nさせてもらったよ。"},
        { "location": "3106/SEL"   , "narrator": "", "text": "こちらこそ"},
        { "location": "3107/SEL"   , "narrator": "", "text": "いつもみんなを護ってくれてありがとう"},
        { "location": "3108/SEL"   , "narrator": "", "text": "真幌さん応援してます、大好きです！"},
        { "location": "3109/ACT"   , "narrator": "", "text": "こちらこそ"},
        { "location": "3110/TALK"  , "narrator": "真幌", "text": "ああ。"},
        { "location": "3111/ACT"   , "narrator": "", "text": "いつもみんなを護ってくれてありがとう"},
        { "location": "3112/TALK"  , "narrator": "真幌", "text": "それが業務であって。"},
        { "location": "3113/TALK"  , "narrator": "真幌", "text": "それが生きがいだからな。"},
        { "location": "3115/TALK"  , "narrator": "真幌", "text": "けど、そう言ってくれる\n奴がいると――"},
        { "location": "3116/TALK"  , "narrator": "真幌", "text": "性懲りもなく、\n少しばかり\n頬が緩んでしまうな。"},
        { "location": "3117/ACT"   , "narrator": "", "text": "真幌さん応援してます、大好きです！"},
        { "location": "3120/TALK"  , "narrator": "真幌", "text": "おだてても\n何も出んぞ。"},
        { "location": "3122/TALK"  , "narrator": "真幌", "text": "こんな落ち武者のような\n女に好きとか言う前に、\nもっと見る所があるだろ。"},
        { "location": "3123/TALK"  , "narrator": "真幌", "text": "まあ、だがしかし、だ。\nそんな事を言われたのは\n久し振りだが――"},
        { "location": "3124/TALK"  , "narrator": "真幌", "text": "正直に言えば、\n悪い気はしないな。"},
        { "location": "3128/TALK"  , "narrator": "真幌", "text": "っと。\n旅立ちの時が\n来たようだぞ。"},
        { "location": "3129/TALK"  , "narrator": "真幌", "text": "エリカに\n振り回されっぱなしで\n大変だと思うが――"},
        { "location": "3130/TALK"  , "narrator": "真幌", "text": "身体は資本だ。\n無理はするな。"},
        { "location": "3131/SEL"   , "narrator": "", "text": "ありがとう！"},
        { "location": "3132/SEL"   , "narrator": "", "text": "真幌さんもね"},
        { "location": "3133/ACT"   , "narrator": "", "text": "ありがとう！"},
        { "location": "3134/ACT"   , "narrator": "", "text": "真幌さんもね"},
        { "location": "3136/TALK"  , "narrator": "真幌", "text": "ああ。"},
        { "location": "3137/TALK"  , "narrator": "真幌", "text": "それでは改めて、\n$handle$隊員。"},
        { "location": "3138/TALK"  , "narrator": "真幌", "text": "両世界間における\n秩序、平穏と繁栄を願って\n素敵なココロの旅を！"},
        { "location": "3167/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんっ！"},
        { "location": "3168/TALK"  , "narrator": "月神楽　", "text": "遅かったですね。\n思わず不吉なことを\n考えちゃいましたよ？"},
        { "location": "3169/SEL"   , "narrator": "", "text": "ぴょんこｽｷ"},
        { "location": "3170/SEL"   , "narrator": "", "text": "不吉なことってどんな？"},
        { "location": "3171/SEL"   , "narrator": "", "text": "二人ともこんにちは"},
        { "location": "3172/ACT"   , "narrator": "", "text": "ぴょんこｽｷ"},
        { "location": "3177/TALK"  , "narrator": "ぴょんこ", "text": "きゃーーーーっ！"},
        { "location": "3178/TALK"  , "narrator": "ぴょんこ", "text": "わざわざ月ちゃんの前で\n言う所がポイント\n高すぎですっ！！"},
        { "location": "3179/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこも～\n$handle$さんが～\nだいだいだーいすきです！"},
        { "location": "3181/TALK"  , "narrator": "月神楽　", "text": "後で髪の毛１本\n戴きますね。"},
        { "location": "3182/ACT"   , "narrator": "", "text": "不吉なことってどんな？"},
        { "location": "3185/TALK"  , "narrator": "月神楽　", "text": "えっと、例えば――"},
        { "location": "3187/TALK"  , "narrator": "月神楽　", "text": "どこかの地下室に\n監禁されて、手足を\n縛られ目隠しされて！"},
        { "location": "3188/TALK"  , "narrator": "月神楽　", "text": "昔から貴方のことを\n大好きだったのに見向きも\nされなかった恨みを！"},
        { "location": "3189/TALK"  , "narrator": "月神楽　", "text": "ここで一気に大爆発\nされちゃって、\nいろんなことをっ！"},
        { "location": "3190/TALK"  , "narrator": "ぴょんこ", "text": "それって\nぴょんこのことぴょん？"},
        { "location": "3192/TALK"  , "narrator": "月神楽　", "text": "私のことですよ？"},
        { "location": "3193/ACT"   , "narrator": "", "text": "二人ともこんにちは"},
        { "location": "3194/TALK"  , "narrator": "ぴょんこ", "text": "は！？"},
        { "location": "3195/TALK"  , "narrator": "月神楽　", "text": "クソみたいに\nつまらない挨拶ですね。"},
        { "location": "3196/SEL"   , "narrator": "", "text": "フルボッコすぎでしょ！"},
        { "location": "3197/ACT"   , "narrator": "", "text": "フルボッコすぎでしょ！"},
        { "location": "3199/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこ達を\n楽しませようという\n自覚がないぴょん！"},
        { "location": "3200/TALK"  , "narrator": "月神楽　", "text": "まあ、所詮私達なんて\nそんな程度の関係って\nことですよね。"},
        { "location": "3201/SEL"   , "narrator": "", "text": "いやいや…"},
        { "location": "3202/SEL"   , "narrator": "", "text": "実際そうなんだけどね"},
        { "location": "3203/ACT"   , "narrator": "", "text": "いやいや…"},
        { "location": "3205/TALK"  , "narrator": "月神楽　", "text": "冗談ですよ♪"},
        { "location": "3206/ACT"   , "narrator": "", "text": "実際そうなんだけどね"},
        { "location": "3209/TALK"  , "narrator": "ぴょんこ", "text": "つかさー、お前ぴょんこに\n$pyonko_suki$回もぴょんこｽｷって\n言ったじゃねーか！"},
        { "location": "3210/TALK"  , "narrator": "ぴょんこ", "text": "もういいです、\n今までのぴょんこｽｷは\n全部取り消しときますわ。"},
        { "location": "3212/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん。"},
        { "location": "3213/TALK"  , "narrator": "月神楽　", "text": "まあ、\n薄々感じてはいたので、\n別にどうでもいいです。"},
        { "location": "3218/TALK"  , "narrator": "月神楽　", "text": "とまあ、そんな事で\n時間を潰してる暇は\nないんです。"},
        { "location": "3221/TALK"  , "narrator": "ぴょんこ", "text": "エリカさんから、\n可及的健やかに、認証を\n通過するようにと！"},
        { "location": "3223/TALK"  , "narrator": "月神楽　", "text": "可及的速やかにだぞおい。"},
        { "location": "3224/TALK"  , "narrator": "ぴょんこ", "text": "そうですぴょん！"},
        { "location": "3226/TALK"  , "narrator": "月神楽　", "text": "通過自体は\n簡単なんですけど、"},
        { "location": "3228/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんを\n待たなくてはいけなくて。"},
        { "location": "3229/SEL"   , "narrator": "", "text": "そうなんだ"},
        { "location": "3230/ACT"   , "narrator": "", "text": "そうなんだ"},
        { "location": "3232/TALK"  , "narrator": "月神楽　", "text": "はい。\n認証して入ったら、\nすぐに封鎖するんです。"},
        { "location": "3233/TALK"  , "narrator": "ぴょんこ", "text": "すぐに認証鍵を\n変えるってエリカさんが\n言ってました。"},
        { "location": "3234/TALK"  , "narrator": "月神楽　", "text": "要するに、\nライフギャザーの\n中は――"},
        { "location": "3235/TALK"  , "narrator": "月神楽　", "text": "私とぴょんこと\n$handle$さんだけの\n密室ということです♪"},
        { "location": "3236/TALK"  , "narrator": "ぴょんこ", "text": "中から外に出る事も\nできないのだぴょん♪"},
        { "location": "3237/SEL"   , "narrator": "", "text": "それって確か、神楽の人格では無くなってしまうのでは！？"},
        { "location": "3238/ACT"   , "narrator": "", "text": "それって確か、神楽の人格では無くなってしまうのでは！？"},
        { "location": "3240/TALK"  , "narrator": "月神楽　", "text": "いいんです。\n私も前回で、\n覚悟を決めましたから。"},
        { "location": "3241/TALK"  , "narrator": "ぴょんこ", "text": "進むも地獄、\n残るも地獄。\nそれなら――"},
        { "location": "3242/TALK"  , "narrator": "月神楽　", "text": "進んだ方が\nメリットが\n大きいですよね♪"},
        { "location": "3243/TALK"  , "narrator": "ぴょんこ", "text": "それに～、\n$handle$さんと\n一緒にいられますしっ！"},
        { "location": "3245/TALK"  , "narrator": "ぴょんこ", "text": "邪魔なのも\n一緒ですけど。"},
        { "location": "3247/TALK"  , "narrator": "月神楽　", "text": "リフレクション！"},
        { "location": "3249/TALK"  , "narrator": "月神楽　", "text": "……なので、\n$handle$さんも、\n一緒に入らないと。"},
        { "location": "3251/TALK"  , "narrator": "ぴょんこ", "text": "後からは入れないって\n事ですぴょん♪"},
        { "location": "3252/SEL"   , "narrator": "", "text": "なるほど、だいたいわかった"},
        { "location": "3253/ACT"   , "narrator": "", "text": "なるほど、だいたいわかった"},
        { "location": "3256/TALK"  , "narrator": "月神楽　", "text": "それじゃ、説明も一通り\n済んだところで、\nぴょんこ、いきますよ。"},
        { "location": "3257/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん♪"},
        { "location": "3259/TALK"  , "narrator": "ぴょんこ", "text": "はあっ！！"},
        { "location": "3264/TALK"  , "narrator": "月神楽　", "text": "ふんっ！"},
        { "location": "3269/TALK"  , "narrator": "月神楽　", "text": "それでは参りましょう！"},
        { "location": "3270/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこと！"},
        { "location": "3271/TALK"  , "narrator": "月神楽　", "text": "月と！"},
        { "location": "3272/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さん！"},
        { "location": "3273/TALK"  , "narrator": "月神楽　", "text": "卯月神楽に！"},
        { "location": "3274/TALK"  , "narrator": "ぴょんこ", "text": "素敵な"},
        { "location": "3275/TALK"  , "narrator": "月神楽　", "text": "ココロの旅を！"},
        { "location": "3296/SEL"   , "narrator": "", "text": "ここが、ライフギャザーの中…？"},
        { "location": "3297/ACT"   , "narrator": "", "text": "ここが、ライフギャザーの中…？"},
