        "title": "005 メインストーリー",
        "sub_title": "偶然は運命にも似て＜後編＞"
    },
    "entry":
    [
        { "location": "687/SCENARIO", "narrator": "", "text": "空だって飛べる（はず）"},
        { "location": "724/TALK"    , "narrator": "みやび", "text": "…ああああもう！"},
        { "location": "725/TALK"    , "narrator": "みやび", "text": "自分でも笑えるくらい\nひどい文字ぞね…！"},
        { "location": "726/SEL"     , "narrator": "", "text": "そんなことはいいから"},
        { "location": "727/ACT"     , "narrator": "", "text": "そんなことはいいから"},
        { "location": "736/TALK"    , "narrator": "みやび", "text": "よくない"},
        { "location": "737/TALK"    , "narrator": "みやび", "text": "大事"},
        { "location": "738/TALK"    , "narrator": "みやび", "text": "読めん"},
        { "location": "740/TALK"    , "narrator": "みやび", "text": "このままやと"},
        { "location": "742/SEL"     , "narrator": "", "text": "遺言とか必要ないから"},
        { "location": "743/SEL"     , "narrator": "", "text": "生きる手段を探そう"},
        { "location": "744/SEL"     , "narrator": "", "text": "生存戦略をとろう"},
        { "location": "745/ACT"     , "narrator": "", "text": "遺言とか必要ないから"},
        { "location": "746/TALK"    , "narrator": "みやび", "text": "そだ"},
        { "location": "747/TALK"    , "narrator": "みやび", "text": "うそだ"},
        { "location": "748/ACT"     , "narrator": "", "text": "生きる手段を探そう"},
        { "location": "749/TALK"    , "narrator": "みやび", "text": "どやって"},
        { "location": "750/ACT"     , "narrator": "", "text": "生存戦略をとろう"},
        { "location": "751/TALK"    , "narrator": "みやび", "text": "言い言葉だ"},
        { "location": "754/SEL"     , "narrator": "", "text": "プログラミングできる？"},
        { "location": "755/SEL"     , "narrator": "", "text": "コード書こう"},
        { "location": "756/SEL"     , "narrator": "", "text": "みやびの得意技を使おう"},
        { "location": "757/ACT"     , "narrator": "", "text": "プログラミングできる？"},
        { "location": "758/TALK"    , "narrator": "みやび", "text": "今か"},
        { "location": "759/TALK"    , "narrator": "みやび", "text": "酔狂な"},
        { "location": "760/TALK"    , "narrator": "みやび", "text": "できるが"},
        { "location": "761/ACT"     , "narrator": "", "text": "コード書こう"},
        { "location": "763/TALK"    , "narrator": "みやび", "text": "原初のコード"},
        { "location": "764/TALK"    , "narrator": "みやび", "text": "美しき"},
        { "location": "765/ACT"     , "narrator": "", "text": "みやびの得意技を使おう"},
        { "location": "766/TALK"    , "narrator": "みやび", "text": "ハッキング"},
        { "location": "767/TALK"    , "narrator": "みやび", "text": "する気か"},
        { "location": "768/TALK"    , "narrator": "みやび", "text": "今まさに"},
        { "location": "774/TALK"    , "narrator": "みやび", "text": "$handle$は\n一体何を……。"},
        { "location": "778/TALK"    , "narrator": "アーヤ", "text": "トライコネクト！\nこれを脱出の手段に\n使えないかしら？"},
        { "location": "779/TALK"    , "narrator": "ガブリエラ", "text": "え？\nそんなことできるの？"},
        { "location": "780/TALK"    , "narrator": "みやび", "text": "…確かに。\n今ならできるね。"},
        { "location": "781/TALK"    , "narrator": "みやび", "text": "音羽用にシステムを\n改造したき。"},
        { "location": "782/TALK"    , "narrator": "みやび", "text": "けんど、それだけ\nやったら敵の目を\n欺けんかもしれん。"},
        { "location": "783/TALK"    , "narrator": "ガブリエラ", "text": "それなら脱出ポッドを\n使うのはどう？"},
        { "location": "785/TALK"    , "narrator": "アーヤ", "text": "…いい手ね。私達が\n乗ってると思わせれば\nいいんじゃない。"},
        { "location": "786/TALK"    , "narrator": "みやび", "text": "さすがに爆発は\nさせられんかね。"},
        { "location": "788/TALK"    , "narrator": "ガブリエラ", "text": "ポッドを？"},
        { "location": "789/TALK"    , "narrator": "みやび", "text": "ただ射出された\nだけやったら\nすぐに鹵獲されるき。"},
        { "location": "791/TALK"    , "narrator": "みやび", "text": "爆発できるなら\n現場の混乱も狙えるし。"},
        { "location": "792/TALK"    , "narrator": "アーヤ", "text": "救命のためのものだから\nそう簡単には\n壊せないわ。"},
        { "location": "794/TALK"    , "narrator": "ガブリエラ", "text": "そうね。でも\nそう見せかけることは\n可能よ。"},
        { "location": "795/TALK"    , "narrator": "ガブリエラ", "text": "積み込んだ武器の中に\n発煙手榴弾がある。\nこれを使えばいいわ。"},
        { "location": "797/TALK"    , "narrator": "みやび", "text": "煙はどのくらい\n広がるもんなんかね？"},
        { "location": "799/TALK"    , "narrator": "ガブリエラ", "text": "ここにあるものを\n全部ポッドに\nぶち込んだなら。"},
        { "location": "800/TALK"    , "narrator": "ガブリエラ", "text": "ざっと１００ｍと\nいったところかしら。"},
        { "location": "801/TALK"    , "narrator": "アーヤ", "text": "そんなに！？"},
        { "location": "802/TALK"    , "narrator": "みやび", "text": "派手やねえ。\n気に入った。"},
        { "location": "804/TALK"    , "narrator": "みやび", "text": "じゃ、うちは起爆用の\nリモコンでも\n作ろうかね。"},
        { "location": "807/TALK"    , "narrator": "ガブリエラ", "text": "発煙手榴弾の\n設置は任せて。"},
        { "location": "808/TALK"    , "narrator": "アーヤ", "text": "じゃあ私は\nトライコネクトの\n確認をしておくわね。"},
        { "location": "840/TALK"    , "narrator": "ガブリエラ", "text": "みやび、準備は\nどうなのよ？"},
        { "location": "843/TALK"    , "narrator": "みやび", "text": "脱出ポッドの\n射出準備ならとっくに\nできちゅうき。"},
        { "location": "844/TALK"    , "narrator": "みやび", "text": "それより二人は\nコネクトこじゃんと\nせんといかんよ。"},
        { "location": "846/TALK"    , "narrator": "アーヤ", "text": "もちろんよ。"},
        { "location": "847/TALK"    , "narrator": "ガブリエラ", "text": "当たり前でしょ。"},
        { "location": "848/TALK"    , "narrator": "アーヤ", "text": "それよりやっぱり\nスピードを落とす気は\nないみたいよ。"},
        { "location": "849/TALK"    , "narrator": "アーヤ", "text": "このまま文京ドームに\n突っ込ませる気\n満々ね。"},
        { "location": "850/TALK"    , "narrator": "みやび", "text": "脱出のタイミングは\nさっきの打ち合わせ\n通りに頼むちや。"},
        { "location": "852/TALK"    , "narrator": "みやび", "text": "おっと、いかん。\nこっちを\n忘れちょったがよ。"},
        { "location": "864/TALK"    , "narrator": "みやび", "text": "生存および奪還作戦"},
        { "location": "865/TALK"    , "narrator": "みやび", "text": "これより決行"},
        { "location": "866/TALK"    , "narrator": "みやび", "text": "うちへの助言感謝する"},
        { "location": "867/TALK"    , "narrator": "みやび", "text": "最愛を込めて"},
        { "location": "869/SEL"     , "narrator": "", "text": "成功するよ"},
        { "location": "870/SEL"     , "narrator": "", "text": "生きて！"},
        { "location": "871/SEL"     , "narrator": "", "text": "死ぬ気でやってみよう"},
        { "location": "872/ACT"     , "narrator": "", "text": "成功するよ"},
        { "location": "873/TALK"    , "narrator": "みやび", "text": "失敗したら"},
        { "location": "874/TALK"    , "narrator": "みやび", "text": "あの世で会おうぞ"},
        { "location": "875/TALK"    , "narrator": "みやび", "text": "アドレスを取得せよ"},
        { "location": "876/ACT"     , "narrator": "", "text": "生きて！"},
        { "location": "877/TALK"    , "narrator": "みやび", "text": "たとえ死んでも"},
        { "location": "878/TALK"    , "narrator": "みやび", "text": "相棒はうちの相棒ぞね"},
        { "location": "879/TALK"    , "narrator": "みやび", "text": "それは永久不滅"},
        { "location": "880/ACT"     , "narrator": "", "text": "死ぬ気でやってみよう"},
        { "location": "881/TALK"    , "narrator": "みやび", "text": "本末転倒になったら"},
        { "location": "882/TALK"    , "narrator": "みやび", "text": "どうするつもりか"},
        { "location": "883/TALK"    , "narrator": "みやび", "text": "ばかちんが"},
        { "location": "896/TALK"    , "narrator": "みやび", "text": "…ＧＰＳ脱出目標まで\n１００ｍ。"},
        { "location": "897/TALK"    , "narrator": "みやび", "text": "５０ｍ。"},
        { "location": "898/TALK"    , "narrator": "みやび", "text": "３０ｍ。"},
        { "location": "899/TALK"    , "narrator": "みやび", "text": "２０ｍ。"},
        { "location": "900/TALK"    , "narrator": "みやび", "text": "１０ｍ。"},
        { "location": "901/TALK"    , "narrator": "みやび", "text": "$handle$に\n最大の感謝を。"},
        { "location": "916/DIALOG"  , "narrator": "Dialog_chapter_ch04", "text": "【26 ホワイト・マイル】"}
    ]
}
