        { "location": "164/SCENARIO", "narrator": "", "text": "000_ソラミミハミング"},
        { "location": "189/TALK"    , "narrator": "ガブリエラ", "text": "楽しい時に歌う歌って"},
        { "location": "190/TALK"    , "narrator": "ガブリエラ", "text": "あるかしら？"},
        { "location": "192/SEL"     , "narrator": "", "text": "あるよ"},
        { "location": "193/SEL"     , "narrator": "", "text": "ないかも"},
        { "location": "194/SEL"     , "narrator": "", "text": "ガブへのラブソング"},
        { "location": "195/ACT"     , "narrator": "", "text": "あるよ"},
        { "location": "196/TALK"    , "narrator": "ガブリエラ", "text": "あるのね"},
        { "location": "197/ACT"     , "narrator": "", "text": "ないかも"},
        { "location": "198/TALK"    , "narrator": "ガブリエラ", "text": "そうなの"},
        { "location": "199/ACT"     , "narrator": "", "text": "ガブへのラブソング"},
        { "location": "201/TALK"    , "narrator": "ガブリエラ", "text": "マルザンナったら///////"},
        { "location": "202/TALK"    , "narrator": "ガブリエラ", "text": "もう/////////////////"},
        { "location": "203/TALK"    , "narrator": "ガブリエラ", "text": "意味も解らず使う言葉じゃなくってよ////"},
        { "location": "205/SEL"     , "narrator": "", "text": "ガブにはあるの？"},
        { "location": "206/ACT"     , "narrator": "", "text": "ガブにはあるの？"},
        { "location": "208/TALK"    , "narrator": "ガブリエラ", "text": "私？"},
        { "location": "210/TALK"    , "narrator": "ガブリエラ", "text": "あるような"},
        { "location": "211/TALK"    , "narrator": "ガブリエラ", "text": "ないような"},
        { "location": "213/SEL"     , "narrator": "", "text": "どっち？"},
        { "location": "214/SEL"     , "narrator": "", "text": "無理に言わなくてもいいよ"},
        { "location": "215/ACT"     , "narrator": "", "text": "どっち？"},
        { "location": "216/TALK"    , "narrator": "ガブリエラ", "text": "どっちって言えばいいのかしら"},
        { "location": "217/TALK"    , "narrator": "ガブリエラ", "text": "自分でもよくわからないのよ"},
        { "location": "218/ACT"     , "narrator": "", "text": "無理に言わなくてもいいよ"},
        { "location": "220/TALK"    , "narrator": "ガブリエラ", "text": "マルザンナは本当にやさしい子ね"},
        { "location": "221/TALK"    , "narrator": "ガブリエラ", "text": "いいこだわ"},
        { "location": "223/TALK"    , "narrator": "ガブリエラ", "text": "あ"},
        { "location": "224/TALK"    , "narrator": "ガブリエラ", "text": "そういえばみやびが言っていたわ"},
        { "location": "225/TALK"    , "narrator": "ガブリエラ", "text": "銭湯では必ず歌わないといけない歌があるんですって"},
        { "location": "227/SEL"     , "narrator": "", "text": "あるある"},
        { "location": "228/SEL"     , "narrator": "", "text": "なんだろう"},
        { "location": "229/SEL"     , "narrator": "", "text": "騙されてるよ"},
        { "location": "230/ACT"     , "narrator": "", "text": "あるある"},
        { "location": "231/TALK"    , "narrator": "ガブリエラ", "text": "やっぱり"},
        { "location": "232/TALK"    , "narrator": "ガブリエラ", "text": "そうなのね"},
        { "location": "233/TALK"    , "narrator": "ガブリエラ", "text": "頑張って覚えなきゃね"},
        { "location": "234/ACT"     , "narrator": "", "text": "なんだろう"},
        { "location": "235/TALK"    , "narrator": "ガブリエラ", "text": "あら"},
        { "location": "236/TALK"    , "narrator": "ガブリエラ", "text": "マルザンナも知らないのね"},
        { "location": "237/TALK"    , "narrator": "ガブリエラ", "text": "今度ちゃんとみやびに聞いておくわね"},
        { "location": "238/TALK"    , "narrator": "ガブリエラ", "text": "待っててね"},
        { "location": "239/ACT"     , "narrator": "", "text": "騙されてるよ"},
        { "location": "241/TALK"    , "narrator": "ガブリエラ", "text": "そうなの？"},
        { "location": "242/TALK"    , "narrator": "ガブリエラ", "text": "ひどいわみやびったら"},
        { "location": "243/TALK"    , "narrator": "ガブリエラ", "text": "からかうなんて"},
        { "location": "244/TALK"    , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "245/TALK"    , "narrator": "ガブリエラ", "text": "マルザンナが教えてくれたから"},
        { "location": "246/TALK"    , "narrator": "ガブリエラ", "text": "もう騙されないわよ"}
    ]
}
