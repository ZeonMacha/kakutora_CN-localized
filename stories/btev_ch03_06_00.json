        "title": "007 ココロスフィアストーリー【Lv03】",
        "sub_title": "壊されるココロⅡ＜提起＞"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "壊されるココロ３"},
        { "location": "13/DIALOG" , "narrator": "", "text": "<size=40>KOKORO-Lv. 03</size>\nGABRIELLA\n\n<size=45>壊されるココロⅡ</size>\n<size=35>～暗黒世界～</size>"},
        { "location": "26/TALK"   , "narrator": "ガブリエラ", "text": "来たわね。"},
        { "location": "27/SEL"    , "narrator": "（選択肢）", "text": "これが？"},
        { "location": "28/ACT"    , "narrator": "", "text": "これが？"},
        { "location": "30/TALK"   , "narrator": "ガブリエラ", "text": "そうよ。\nあたしのココロの中に\nある暗黒部分。"},
        { "location": "31/TALK"   , "narrator": "ガブリエラ", "text": "この中に何があるか\nもはやあたしにすら\n知る術は無いの。"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "もっとも知る気なんて\nサラサラ無いけど。"},
        { "location": "34/TALK"   , "narrator": "ガブリエラ", "text": "とにかく、一刻も早く\n片付けたいところ\nなんだけど……"},
        { "location": "35/SEL"    , "narrator": "（選択肢）", "text": "けど？"},
        { "location": "36/ACT"    , "narrator": "", "text": "けど？"},
        { "location": "38/TALK"   , "narrator": "ガブリエラ", "text": "こんな暗黒ですら\nそれを守るクランが\nいるの。"},
        { "location": "39/TALK"   , "narrator": "ガブリエラ", "text": "まずはそいつらと\n戦わないと、\n手が出せない。"},
        { "location": "40/TALK"   , "narrator": "ガブリエラ", "text": "準備はいい！？"},
        { "location": "41/SEL"    , "narrator": "（選択肢）", "text": "もちろん！"},
        { "location": "42/ACT"    , "narrator": "", "text": "もちろん！"},
        { "location": "44/TALK"   , "narrator": "ガブリエラ", "text": "pojmowanie."},
        { "location": "45/TALK"   , "narrator": "ガブリエラ", "text": "それじゃ\n行くわよ！"},
        { "location": "56/DIALOG" , "narrator": "", "text": "<color=black><size=50><b>心の奥底にある\nトラウマを破壊せよ！</b></size></color>\n\n\n\n\nガブリエラのココロの根っこにあるトラウマ。\n\nその真相は完全に封印されており、\nガブリエラ本人も分からないという。\n\n封印されたトラウマの黒い渦を攻略し、\n彼女の過去に何があったのかを暴こう。\n\n"}
    ]
}
