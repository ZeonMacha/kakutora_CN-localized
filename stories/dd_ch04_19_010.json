{
    "dir": "chap19/daydra/dd_ch04_19_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "19452",
        "cid": "miyabi",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "みやびの部屋"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "みやびの部屋"},
        { "location": "23/TALK"   , "narrator": "みやび", "text": "…やっぱし、実家はえい\nもんやね。"},
        { "location": "26/TALK"   , "narrator": "みやび", "text": "なんちゅうても、\n愛しのスパコン、\n不可思議ちゃんもおるし！"},
        { "location": "27/TALK"   , "narrator": "みやび", "text": "たまには一泊二日でも\nえいき――"},
        { "location": "28/TALK"   , "narrator": "みやび", "text": "不可思議ちゃん触りに\n帰るようにした方が\nえいかもしれんね。"},
        { "location": "30/TALK"   , "narrator": "みやび", "text": "…しっかし。"},
        { "location": "32/TALK"   , "narrator": "繭", "text": "…………。"},
        { "location": "35/TALK"   , "narrator": "みやび", "text": "まさか、ウサギがうちより\n先に部屋にいるとは、\n思わんかったわ。"},
        { "location": "39/TALK"   , "narrator": "みやび", "text": "はぁ…。"},
        { "location": "41/TALK"   , "narrator": "繭", "text": "っ！？\nす、すみません！"},
        { "location": "42/TALK"   , "narrator": "繭", "text": "久しぶりのご実家だと\nいうのに――"},
        { "location": "44/TALK"   , "narrator": "繭", "text": "私のような邪魔者が\nいたら、くつろげません\nよね？"},
        { "location": "46/TALK"   , "narrator": "みやび", "text": "いや、そんなことないき。"},
        { "location": "47/TALK"   , "narrator": "みやび", "text": "この部屋にうち以外の\n人間がいるんが、ちっくと\n珍しいだけちや。"},
        { "location": "49/TALK"   , "narrator": "繭", "text": "…そうなんですか？"},
        { "location": "50/TALK"   , "narrator": "みやび", "text": "うちと家族を抜かすと、\n数人しか入ったこと\nないきね。"},
        { "location": "52/TALK"   , "narrator": "繭", "text": "…光栄です！"},
        { "location": "54/TALK"   , "narrator": "繭", "text": "…それにしても、\n凄いですね。"},
        { "location": "55/TALK"   , "narrator": "繭", "text": "まさかご実家に、\nこんなスパコンを\nお持ちであったとは――"},
        { "location": "56/TALK"   , "narrator": "繭", "text": "想像もしませんでした。"},
        { "location": "57/TALK"   , "narrator": "みやび", "text": "まあ、正式には借り物\nいうことになっちゅう\nけんどね。"},
        { "location": "58/TALK"   , "narrator": "繭", "text": "借り物、ですか？"},
        { "location": "60/TALK"   , "narrator": "みやび", "text": "なんや、まほさんから\n聞いてないが？"},
        { "location": "61/TALK"   , "narrator": "みやび", "text": "うちのこのスパコン\n『不可思議』はな――"},
        { "location": "62/TALK"   , "narrator": "みやび", "text": "フェノメノンのことを\n調べるいう目的で、\n国から借りゆう物やき――"},
        { "location": "63/TALK"   , "narrator": "みやび", "text": "完全にうちの物や\nないんよ。"},
        { "location": "64/TALK"   , "narrator": "繭", "text": "そういうことだったの\nですか…。"},
        { "location": "65/TALK"   , "narrator": "繭", "text": "どうして東雲教官が、\nみやび先輩のご実家の\nＰＣを――"},
        { "location": "66/TALK"   , "narrator": "繭", "text": "私にチェックしに行けと\n命じたのか、ずっと\n謎だったのですが――"},
        { "location": "67/TALK"   , "narrator": "繭", "text": "それを聞いて\n納得しました。"},
        { "location": "68/TALK"   , "narrator": "みやび", "text": "数億円はする借り物やき、\n状態の確認をして\nおきたいんやろうね。"},
        { "location": "69/TALK"   , "narrator": "繭", "text": "いらぬ心配ですね。\nこれといって、\n異常は見られません。"},
        { "location": "71/TALK"   , "narrator": "繭", "text": "…申し訳ありません、\nみやび先輩。"},
        { "location": "72/TALK"   , "narrator": "みやび", "text": "ん？"},
        { "location": "74/TALK"   , "narrator": "繭", "text": "出来る限り、早急に\n終わらせて出ていきます\nので…。"},
        { "location": "75/TALK"   , "narrator": "みやび", "text": "…………。"},
        { "location": "76/TALK"   , "narrator": "みやび", "text": "ウサギも、うちと同じ\nタイプの人間やき。"},
        { "location": "77/TALK"   , "narrator": "みやび", "text": "自分のＰＣに触られる\n抵抗、よぉわかっちょるん\nやろうなぁ…。"},
        { "location": "79/TALK"   , "narrator": "みやび", "text": "…けんど。"},
        { "location": "91/TALK"   , "narrator": "みやび", "text": "相棒"},
        { "location": "92/TALK"   , "narrator": "みやび", "text": "ウサギに対して"},
        { "location": "93/TALK"   , "narrator": "みやび", "text": "出ていけオーラ出てるか？"},
        { "location": "95/SEL"    , "narrator": "", "text": "え？　出してなかったの？"},
        { "location": "96/SEL"    , "narrator": "", "text": "お茶でも出してあげたら？"},
        { "location": "97/ACT"    , "narrator": "", "text": "え？　出してなかったの？"},
        { "location": "98/TALK"   , "narrator": "みやび", "text": "そうか…"},
        { "location": "99/TALK"   , "narrator": "みやび", "text": "謝罪案件だ"},
        { "location": "111/TALK"  , "narrator": "みやび", "text": "あー、ウサギ。"},
        { "location": "112/TALK"  , "narrator": "みやび", "text": "もしうちが、さっさと\n部屋から出ていけオーラ\n出しちょるとしたら――"},
        { "location": "114/TALK"  , "narrator": "みやび", "text": "それは謝る。\nすまんな。"},
        { "location": "116/TALK"  , "narrator": "繭", "text": "えっ！？"},
        { "location": "118/TALK"  , "narrator": "みやび", "text": "ウサギやって、\nまほさんに言われて――"},
        { "location": "119/TALK"  , "narrator": "みやび", "text": "仕方なくチェックしに\n来ちゅうんやし。"},
        { "location": "121/TALK"  , "narrator": "みやび", "text": "邪魔者みたいに思わて、\nえい気持ちはせん\nやろうし…。"},
        { "location": "122/TALK"  , "narrator": "繭", "text": "いえ、良いんです！\n謝らないでください！"},
        { "location": "123/TALK"  , "narrator": "繭", "text": "そもそも、東雲教官の\n命令とはいえ――"},
        { "location": "124/TALK"  , "narrator": "繭", "text": "みやび先輩の部屋に入り\n作業するのですから――"},
        { "location": "126/TALK"  , "narrator": "繭", "text": "事前に連絡して、\n許可を頂くべきでした。"},
        { "location": "127/TALK"  , "narrator": "みやび", "text": "そんな余裕、\n多分なかったんやろ？"},
        { "location": "129/TALK"  , "narrator": "繭", "text": "それは…まあ…。"},
        { "location": "131/TALK"  , "narrator": "繭", "text": "だとしても、自室は\n自分にとっては神聖な\n場所です。"},
        { "location": "132/TALK"  , "narrator": "繭", "text": "そこに他人が入るの\nだから、不快感を\n抱くのは当然のことです。"},
        { "location": "133/TALK"  , "narrator": "みやび", "text": "…なるほどな。"},
        { "location": "135/TALK"  , "narrator": "繭", "text": "それに、私がみやび\n先輩の立場だったら――"},
        { "location": "136/TALK"  , "narrator": "繭", "text": "間違いなく、出ていけ\nオーラを出していたと\n思いますし。"},
        { "location": "138/TALK"  , "narrator": "繭", "text": "なので、みやび先輩が\n私に対して謝罪する\n必要はありません。"},
        { "location": "139/TALK"  , "narrator": "みやび", "text": "…わかった。\nじゃあ、もう謝らんよ。"},
        { "location": "140/TALK"  , "narrator": "繭", "text": "ありがとうございます。\nでは、作業を急ぎます。"},
        { "location": "141/ACT"   , "narrator": "", "text": "お茶でも出してあげたら？"},
        { "location": "142/TALK"  , "narrator": "みやび", "text": "うっかりしてた"},
        { "location": "154/TALK"  , "narrator": "みやび", "text": "ウサギ、すまん。"},
        { "location": "156/TALK"  , "narrator": "繭", "text": "はい？"},
        { "location": "157/TALK"  , "narrator": "みやび", "text": "ウサギはお客さんやのに、\n茶の一つも出しちょらん\nかった。"},
        { "location": "158/TALK"  , "narrator": "みやび", "text": "すぐに持ってくるき、\n作業続けててな。"},
        { "location": "160/TALK"  , "narrator": "繭", "text": "いえ、そんな！"},
        { "location": "161/TALK"  , "narrator": "繭", "text": "自分は逢瀬さん達とは\n違う、招かれざる客です。"},
        { "location": "162/TALK"  , "narrator": "繭", "text": "なので、そんな気を\n使わないでください。"},
        { "location": "163/TALK"  , "narrator": "みやび", "text": "これくらいのこと、\n気にする必要ないがよ。"},
        { "location": "164/TALK"  , "narrator": "みやび", "text": "それに、せっかく\nうちの実家まで\n来てくれたんやし。"},
        { "location": "165/TALK"  , "narrator": "みやび", "text": "茶でも飲みながら、\nのんびり話でもするぞね。"},
        { "location": "167/TALK"  , "narrator": "繭", "text": "あっ…。"},
        { "location": "168/TALK"  , "narrator": "繭", "text": "みやび先輩の部屋で、\n二人きりで話、か…。"},
        { "location": "169/TALK"  , "narrator": "繭", "text": "嬉しいような、\n緊張するような…。\nでも、来てよかった…。"},
        { "location": "22/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>8月17日　 1:15 PM</color>\n合宿初日、みやびの部屋にて"}
    ]
}
