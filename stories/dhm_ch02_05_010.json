        "title": "Extra004 ヒメゴトチャット",
        "sub_title": "もしかして：初恋"
    },
    "entry":
    [
        { "location": "103/SCENARIO", "narrator": "", "text": "000_もしかして：初恋"},
        { "location": "128/TALK"    , "narrator": "アーヤ", "text": "昼間言ってた箱型ブランコね"},
        { "location": "129/TALK"    , "narrator": "アーヤ", "text": "ホントは"},
        { "location": "130/TALK"    , "narrator": "アーヤ", "text": "男の子と乗ったことがあるのよね"},
        { "location": "133/SEL"     , "narrator": "", "text": "好きだった子？"},
        { "location": "134/SEL"     , "narrator": "", "text": "そいつ羨ましい…"},
        { "location": "135/SEL"     , "narrator": "", "text": "ちょっと意外だ"},
        { "location": "136/ACT"     , "narrator": "", "text": "好きだった子？"},
        { "location": "137/TALK"    , "narrator": "アーヤ", "text": "まあね"},
        { "location": "138/TALK"    , "narrator": "アーヤ", "text": "幼稚園児の時点でモテる男子だったわ"},
        { "location": "139/TALK"    , "narrator": "アーヤ", "text": "って"},
        { "location": "140/TALK"    , "narrator": "アーヤ", "text": "気付いちゃったわ"},
        { "location": "142/TALK"    , "narrator": "アーヤ", "text": "その時同じ子が好きだった子"},
        { "location": "143/TALK"    , "narrator": "アーヤ", "text": "今ブランコの相手と付き合ってる"},
        { "location": "144/TALK"    , "narrator": "アーヤ", "text": "うわ"},
        { "location": "145/TALK"    , "narrator": "アーヤ", "text": "人生初の失恋"},
        { "location": "146/TALK"    , "narrator": "アーヤ", "text": "気付きたくなかたわ"},
        { "location": "147/ACT"     , "narrator": "", "text": "そいつ羨ましい…"},
        { "location": "157/TALK"    , "narrator": "アーヤ", "text": "え"},
        { "location": "158/TALK"    , "narrator": "アーヤ", "text": "幼稚園の時の話だから"},
        { "location": "159/TALK"    , "narrator": "アーヤ", "text": "妬かなくていいのよ"},
        { "location": "161/TALK"    , "narrator": "アーヤ", "text": "やきもちとか"},
        { "location": "163/ACT"     , "narrator": "", "text": "ちょっと意外だ"},
        { "location": "164/TALK"    , "narrator": "アーヤ", "text": "あ"},
        { "location": "165/TALK"    , "narrator": "アーヤ", "text": "なにそれ(￣Д￣ )"},
        { "location": "166/TALK"    , "narrator": "アーヤ", "text": "私にだってそんな思い出くらいあるわよ"},
        { "location": "167/TALK"    , "narrator": "アーヤ", "text": "ぷんすか！"},
        { "location": "153/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"}
    ]
}
