{
    "dir": "chap10/daydra/dd_ch03_10_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "10305",
        "cid": "gabriella",
        "title": "005 メインストーリー",
        "sub_title": "七夕祭りへ行きません？＜後編＞"
    },
    "entry":
    [
        { "location": "319/SCENARIO", "narrator": "", "text": "七夕祭りへ行きません？"},
        { "location": "352/TALK"    , "narrator": "ガブリエラ", "text": "と、とにかく！\nあたしはあんた達とは\n絶対に――"},
        { "location": "353/TALK"    , "narrator": "ガブリエラ", "text": "絶対に、その…。"},
        { "location": "354/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "357/TALK"    , "narrator": "ガブリエラ", "text": "…私、最低だわ。"},
        { "location": "358/TALK"    , "narrator": "ガブリエラ", "text": "つばめの力のことは、\n確かに怖いけど――"},
        { "location": "359/TALK"    , "narrator": "ガブリエラ", "text": "一緒に行くの断った\nのは、違う理由だから\nなのに。"},
        { "location": "360/TALK"    , "narrator": "ガブリエラ", "text": "平和ボケしてる\nみんなに、勝手に\nイライラして――"},
        { "location": "361/TALK"    , "narrator": "ガブリエラ", "text": "それを、つばめに\n八つ当たりする\nなんて…最低過ぎ…。"},
        { "location": "362/TALK"    , "narrator": "ガブリエラ", "text": "…謝らないと。\n今のは、絶対に\n謝らなきゃ！"},
        { "location": "364/TALK"    , "narrator": "ガブリエラ", "text": "…ぜ――"},
        { "location": "366/TALK"    , "narrator": "神楽", "text": "ぜ？"},
        { "location": "367/TALK"    , "narrator": "ガブリエラ", "text": "…前言、撤回するわ。"},
        { "location": "368/TALK"    , "narrator": "ガブリエラ", "text": "って、これ全然謝罪に\nなってないー！！"},
        { "location": "370/TALK"    , "narrator": "神楽", "text": "な、何ですかそれ！？\nまさかそれで謝ってる\nつもりなんですか！？"},
        { "location": "371/TALK"    , "narrator": "みやび", "text": "ガブちゃんの性格は、\nうちらもよーく知っ\nちょるけんど――"},
        { "location": "373/TALK"    , "narrator": "みやび", "text": "謝るべき時に謝らん\nっちゅうのは、\n許されんことぞね。"},
        { "location": "375/TALK"    , "narrator": "ガブリエラ", "text": "あ、う…。"},
        { "location": "376/TALK"    , "narrator": "ガブリエラ", "text": "…どうしよう。\n二人とも、本気で\n怒ってる…。"},
        { "location": "377/TALK"    , "narrator": "ガブリエラ", "text": "でも、ここまで言って\nおいて今更謝るなんて\nかっこ悪いこと――"},
        { "location": "378/TALK"    , "narrator": "ガブリエラ", "text": "…ああ、もう。\nまだ頑固なプライドが\n邪魔してる…。"},
        { "location": "379/TALK"    , "narrator": "神楽", "text": "ガブちゃん！"},
        { "location": "380/TALK"    , "narrator": "みやび", "text": "謝りぃ！"},
        { "location": "382/TALK"    , "narrator": "ガブリエラ", "text": "人の気も知らないで！"},
        { "location": "384/TALK"    , "narrator": "つばめ", "text": "や、やめてください！"},
        { "location": "389/TALK"    , "narrator": "つばめ", "text": "卯月さんも、\nみやびさんも――"},
        { "location": "390/TALK"    , "narrator": "つばめ", "text": "ガブちゃんのこと、\n怒らないであげて\nください…。"},
        { "location": "392/TALK"    , "narrator": "ガブリエラ", "text": "…新人。"},
        { "location": "393/TALK"    , "narrator": "神楽", "text": "で、でも！\nさっきのは絶対に\n言い過ぎですよ。"},
        { "location": "395/TALK"    , "narrator": "つばめ", "text": "あれは、わたし達が\nいけないんだよ。"},
        { "location": "396/TALK"    , "narrator": "つばめ", "text": "わたし達が、一緒に\nお祭りに行かない\n理由を――"},
        { "location": "398/TALK"    , "narrator": "つばめ", "text": "無理やり聞き出した\nから、こんなことに\nなったんだし…。"},
        { "location": "399/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "401/TALK"    , "narrator": "みやび", "text": "…つばめちゃんは\n怒っちょらんが？"},
        { "location": "402/TALK"    , "narrator": "つばめ", "text": "はい…っていうか、\n感謝してます。"},
        { "location": "403/TALK"    , "narrator": "ガブリエラ", "text": "なっ、はぁ！？\n何でそうなるのよ！？"},
        { "location": "404/TALK"    , "narrator": "つばめ", "text": "だって…わたし達が\nしつこく聞かなかっ\nたら――"},
        { "location": "405/TALK"    , "narrator": "つばめ", "text": "絶対に本当の理由は\n言わなかったでしょ？"},
        { "location": "406/TALK"    , "narrator": "つばめ", "text": "それって、ちょっとは\nわたしのこと――"},
        { "location": "407/TALK"    , "narrator": "つばめ", "text": "思ってくれてる証拠\nなのかなぁ、って\n思ったから…。"},
        { "location": "409/TALK"    , "narrator": "みやび", "text": "呆れるほどの\nポジティブシンキング\n娘やなぁ…。"},
        { "location": "411/TALK"    , "narrator": "つばめ", "text": "えへへ…、\nそれくらいしか\n取り柄ないんで…。"},
        { "location": "412/TALK"    , "narrator": "つばめ", "text": "でも、せんぱい。\nこれならどうですか？"},
        { "location": "413/TALK"    , "narrator": "ガブリエラ", "text": "な、なによ？"},
        { "location": "414/TALK"    , "narrator": "つばめ", "text": "お祭りの日までに、\nせんぱいが嫌がってる\nわたしの力のこと――"},
        { "location": "415/TALK"    , "narrator": "つばめ", "text": "わたしが、\n解明してみせます！"},
        { "location": "416/TALK"    , "narrator": "ガブリエラ", "text": "っ！？"},
        { "location": "419/TALK"    , "narrator": "神楽", "text": "え、えぇっ！？"},
        { "location": "420/TALK"    , "narrator": "神楽", "text": "ちょ、つばめさん！\nいくらなんでも\nそれは…。"},
        { "location": "422/TALK"    , "narrator": "みやび", "text": "１００パー不可能な\nことやと思うちや。"},
        { "location": "423/TALK"    , "narrator": "つばめ", "text": "そ、そうかもしれま\nせんけど、でも――"},
        { "location": "424/TALK"    , "narrator": "つばめ", "text": "わたし、せんぱいを\n絶対にお祭りに連れて\nいきたいんです！"},
        { "location": "425/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "426/TALK"    , "narrator": "つばめ", "text": "だから、この力の\n正体がわかったら――"},
        { "location": "428/TALK"    , "narrator": "つばめ", "text": "その時は…、\n一緒にお祭り行って\nくれますか？"},
        { "location": "429/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "430/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "431/TALK"    , "narrator": "ガブリエラ", "text": "…本当、しつこいん\nだから。"},
        { "location": "432/TALK"    , "narrator": "ガブリエラ", "text": "っていうか、\n連れてく、ってのは\n変でしょ？"},
        { "location": "433/TALK"    , "narrator": "ガブリエラ", "text": "あたしは一人でも\n行こうとしてるん\nだから。"},
        { "location": "434/TALK"    , "narrator": "つばめ", "text": "そ、そうかな？"},
        { "location": "435/TALK"    , "narrator": "ガブリエラ", "text": "そうよ。\nまったく…。"},
        { "location": "437/TALK"    , "narrator": "ガブリエラ", "text": "…でも、いいわ。\nそこまで言うなら、\n一緒に行ってあげる。"},
        { "location": "438/TALK"    , "narrator": "つばめ", "text": "…え？"},
        { "location": "441/TALK"    , "narrator": "神楽", "text": "が、ガブちゃん！\n今のって…。"},
        { "location": "442/TALK"    , "narrator": "ガブリエラ", "text": "本気よ、本気。\nあんたのその――"},
        { "location": "443/TALK"    , "narrator": "ガブリエラ", "text": "…しつこさには、\nさすがに負けたわ。"},
        { "location": "445/TALK"    , "narrator": "つばめ", "text": "…や、やったー！\nやったよ、卯月さん、\nみやびさん！"},
        { "location": "446/TALK"    , "narrator": "みやび", "text": "す、凄いやないか、\nつばめちゃん。"},
        { "location": "447/TALK"    , "narrator": "みやび", "text": "あの一度嫌と言うたら\n絶対に首を縦に振らん\nガブちゃんを――"},
        { "location": "448/TALK"    , "narrator": "みやび", "text": "根負けさせるなんて、\nトライナリー初の\nできごとや。"},
        { "location": "450/TALK"    , "narrator": "神楽", "text": "つばめさんの気持ちが\n通じたんですよ。\nよかったですね！"},
        { "location": "451/TALK"    , "narrator": "つばめ", "text": "そ、そんなこと\nないよぉ…。"},
        { "location": "453/TALK"    , "narrator": "ガブリエラ", "text": "…実際、\nそうなんだけどね。"},
        { "location": "454/TALK"    , "narrator": "ガブリエラ", "text": "あんな純粋な頼み方\nされて、断れるわけ\nないわ…。"},
        { "location": "456/TALK"    , "narrator": "ガブリエラ", "text": "とりあえず、これで\nつばめの希望は叶える\nことになるけど…。"},
        { "location": "468/TALK"    , "narrator": "ガブリエラ", "text": "ねえ、マルザンナ"},
        { "location": "469/TALK"    , "narrator": "ガブリエラ", "text": "私、これだけでいいのかしら？"},
        { "location": "470/TALK"    , "narrator": "ガブリエラ", "text": "本当はちゃんと謝らないといけないのはわかってるけど"},
        { "location": "472/TALK"    , "narrator": "ガブリエラ", "text": "やっぱり、どうしてもごめんねって言葉が出てこなくて…。"},
        { "location": "473/TALK"    , "narrator": "ガブリエラ", "text": "何か、他にいい方法はないかしら？"},
        { "location": "475/SEL"     , "narrator": "", "text": "楽しみにしてることを伝えればいい"},
        { "location": "476/ACT"     , "narrator": "", "text": "楽しみにしてることを伝えればいい"},
        { "location": "478/TALK"    , "narrator": "ガブリエラ", "text": "それでいいの？"},
        { "location": "479/TALK"    , "narrator": "ガブリエラ", "text": "本当に、それだけで平気？"},
        { "location": "480/TALK"    , "narrator": "ガブリエラ", "text": "またつばめに悲しい顔させたり"},
        { "location": "481/TALK"    , "narrator": "ガブリエラ", "text": "神楽達を怒らせたりとかしない？"},
        { "location": "483/SEL"     , "narrator": "", "text": "そんなビクついてると、逆に気を使われるよ？"},
        { "location": "484/ACT"     , "narrator": "", "text": "そんなビクついてると、逆に気を使われるよ？"},
        { "location": "486/TALK"    , "narrator": "ガブリエラ", "text": "そう言われても"},
        { "location": "488/TALK"    , "narrator": "ガブリエラ", "text": "今は難しいわ"},
        { "location": "490/SEL"     , "narrator": "", "text": "つばめは超頑張ったのに…"},
        { "location": "491/ACT"     , "narrator": "", "text": "つばめは超頑張ったのに…"},
        { "location": "493/TALK"    , "narrator": "ガブリエラ", "text": "それズルい！"},
        { "location": "495/TALK"    , "narrator": "ガブリエラ", "text": "わかった、わかったわ！"},
        { "location": "496/TALK"    , "narrator": "ガブリエラ", "text": "でも、もしこれで変なことになったら"},
        { "location": "498/TALK"    , "narrator": "ガブリエラ", "text": "マルザンナが責任取りなさいよ！？"},
        { "location": "510/TALK"    , "narrator": "ガブリエラ", "text": "…いつもの調子、\nいつもの調子で…。"},
        { "location": "512/TALK"    , "narrator": "つばめ", "text": "じゃあ、せんぱい。\n当日は一緒に行くって\nことで決まりですね！"},
        { "location": "513/TALK"    , "narrator": "ガブリエラ", "text": "え、ええ…でも、\nえっと…。"},
        { "location": "514/TALK"    , "narrator": "ガブリエラ", "text": "そ、そう！\n一つ条件追加よ！"},
        { "location": "516/TALK"    , "narrator": "つばめ", "text": "えぇっ！？"},
        { "location": "518/TALK"    , "narrator": "神楽", "text": "はぁ…、\n今度はなんですか？"},
        { "location": "519/TALK"    , "narrator": "ガブリエラ", "text": "あたしを誘ったのは\nあんたなんだから――"},
        { "location": "520/TALK"    , "narrator": "ガブリエラ", "text": "責任もって、\nあたしのことを\nエスコートすること！"},
        { "location": "521/TALK"    , "narrator": "つばめ", "text": "エスコートって…、\nえっと…。"},
        { "location": "522/TALK"    , "narrator": "ガブリエラ", "text": "つ、つまり！"},
        { "location": "523/TALK"    , "narrator": "ガブリエラ", "text": "あんたが、あたしを\n楽しませてくれれば\nいい、ってことよ。"},
        { "location": "524/TALK"    , "narrator": "つばめ", "text": "あっ、なるほど。\nそれなら任せて\nください！"},
        { "location": "526/TALK"    , "narrator": "ガブリエラ", "text": "…偉く自信満々ね。"},
        { "location": "527/TALK"    , "narrator": "ガブリエラ", "text": "言っとくけど、\n一生の思い出に\n残るくらい――"},
        { "location": "528/TALK"    , "narrator": "ガブリエラ", "text": "楽しい気持ちにさせろ\nってことよ？"},
        { "location": "530/TALK"    , "narrator": "つばめ", "text": "はい、わかってます。"},
        { "location": "531/TALK"    , "narrator": "つばめ", "text": "せんぱいの思い出に\n残るくらい――"},
        { "location": "532/TALK"    , "narrator": "つばめ", "text": "楽しいお祭りに、\n絶対します！"},
        { "location": "533/TALK"    , "narrator": "つばめ", "text": "だから、期待してて\nくださいね。"},
        { "location": "534/TALK"    , "narrator": "ガブリエラ", "text": "…そう。\nじゃ、期待してるわ。"},
        { "location": "536/TALK"    , "narrator": "ガブリエラ", "text": "…つばめとお祭りを\n一緒に楽しみたい、\nって気持ち――"},
        { "location": "537/TALK"    , "narrator": "ガブリエラ", "text": "上手く伝わった\nかしら？"},
        { "location": "539/TALK"    , "narrator": "みやび", "text": "ガブちゃんにしては、\n甘い条件やねぇ。"},
        { "location": "541/TALK"    , "narrator": "神楽", "text": "でも、今の私達には\n丁度いい条件じゃ\nないですか。"},
        { "location": "542/TALK"    , "narrator": "つばめ", "text": "みやびさんが考えて\nくれた、ロマンチック\n大作戦で――"},
        { "location": "543/TALK"    , "narrator": "つばめ", "text": "絶対に、せんぱいの\n思い出に残るお祭りに\nしてみせます！"},
        { "location": "546/TALK"    , "narrator": "神楽", "text": "ふふっ、お祭り当日が\n楽しみです。"},
        { "location": "557/DIALOG"  , "narrator": "Dialog_chapter_ch03", "text": "【08 HANABI】"}
    ]
}
