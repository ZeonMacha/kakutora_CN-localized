{
    "dir": "chap21/daydra/dd_ch03_21_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "21352",
        "cid": "gabriella",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "恋ヶ崎家の味"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "恋ヶ崎家の味"},
        { "location": "22/TALK"   , "narrator": "ガブリエラ", "text": "…ちょっと、つばめ。\n昼間からゴロゴロして\nないでよ。"},
        { "location": "24/TALK"   , "narrator": "つばめ", "text": "ううっ…でも、何だか\n凄くダルくて…。"},
        { "location": "26/TALK"   , "narrator": "アーヤ", "text": "そういえば、朝の訓練の\n後から元気ないわね。"},
        { "location": "28/TALK"   , "narrator": "神楽", "text": "軽い夏バテかも\nしれませんよ？"},
        { "location": "31/TALK"   , "narrator": "つばめ", "text": "そうなのかなぁ？"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "まったく…他人様の家で\nだらしない…。"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "ほら、これ味見させて\nあげるから、シャキッと\nしなさい。"},
        { "location": "36/TALK"   , "narrator": "つばめ", "text": "…これって、サラダ？"},
        { "location": "39/TALK"   , "narrator": "アーヤ", "text": "ギャヴィが作ったの？"},
        { "location": "43/TALK"   , "narrator": "ガブリエラ", "text": "うん、みやびのお母さんに\nお願いして、作り方を\n教えてもらってね――"},
        { "location": "44/TALK"   , "narrator": "ガブリエラ", "text": "とりあえず、簡単に\n作れるさっぱり味の\nサラダを教わったの。"},
        { "location": "45/TALK"   , "narrator": "ガブリエラ", "text": "夏バテ対策にもなる、って\n聞いたから、今のつばめに\n丁度いいんじゃない？"},
        { "location": "47/TALK"   , "narrator": "つばめ", "text": "う、うん…あむっ…。"},
        { "location": "48/TALK"   , "narrator": "つばめ", "text": "…えっ？"},
        { "location": "51/TALK"   , "narrator": "ガブリエラ", "text": "な、なに？\n不味かった？"},
        { "location": "54/TALK"   , "narrator": "つばめ", "text": "これ…ガブちゃんが\n作ったの？"},
        { "location": "55/TALK"   , "narrator": "ガブリエラ", "text": "そうよ。\n教わりながらだけど…。"},
        { "location": "56/TALK"   , "narrator": "神楽", "text": "味はどうなんですか？"},
        { "location": "57/TALK"   , "narrator": "つばめ", "text": "美味しいよ。\nううん、凄く美味しい！"},
        { "location": "58/TALK"   , "narrator": "ガブリエラ", "text": "やった、大成功！"},
        { "location": "60/TALK"   , "narrator": "つばめ", "text": "本当に凄いよ。\n凄く美味しい！"},
        { "location": "62/TALK"   , "narrator": "ガブリエラ", "text": "…みやびのお母さんの\n教え方が、凄く上手\nだったからよ。"},
        { "location": "64/TALK"   , "narrator": "神楽", "text": "…あの、私もいいですか？"},
        { "location": "65/TALK"   , "narrator": "アーヤ", "text": "私もいい？"},
        { "location": "67/TALK"   , "narrator": "ガブリエラ", "text": "仕方ないわね…。\nはい、どうぞ。"},
        { "location": "71/TALK"   , "narrator": "神楽", "text": "ありがとうございます。\nそれじゃ…あむっ。"},
        { "location": "72/TALK"   , "narrator": "神楽", "text": "…本当だ。\nこれ、本当に美味しい\nですよ！"},
        { "location": "74/TALK"   , "narrator": "神楽", "text": "ドレッシングも自分で\n作ったんですか？"},
        { "location": "76/TALK"   , "narrator": "ガブリエラ", "text": "ええ、市販品もいいけど、\n作った方が楽しいから、\nって教えてもらったわ。"},
        { "location": "80/TALK"   , "narrator": "神楽", "text": "最高です！\n程よく酸っぱくて、\n身体がシャキッとします！"},
        { "location": "82/TALK"   , "narrator": "アーヤ", "text": "凄いわ、ギャヴィ。\nこれ本当に美味しい！"},
        { "location": "83/TALK"   , "narrator": "つばめ", "text": "朝ごはんで出たら\n嬉しいですね。"},
        { "location": "84/TALK"   , "narrator": "アーヤ", "text": "そうね。\n和食とも、パンとも\n合いそうな味だし。"},
        { "location": "86/TALK"   , "narrator": "神楽", "text": "暑くて食欲ない時も、\nこれなら食べられますよ。"},
        { "location": "88/TALK"   , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "100/TALK"  , "narrator": "ガブリエラ", "text": "なんか、予想してたよりも美味しい物ができちゃったみたい"},
        { "location": "101/TALK"  , "narrator": "ガブリエラ", "text": "みやびのお母さんの教え方が、凄く上手だったからだと思うけど"},
        { "location": "102/TALK"  , "narrator": "ガブリエラ", "text": "こんなに美味しいって言ってもらえるもの作ったの、初めてかも"},
        { "location": "103/TALK"  , "narrator": "ガブリエラ", "text": "自分の作った物を美味しいって言ってもらうのって、凄く嬉しい！"},
        { "location": "105/SEL"   , "narrator": "", "text": "全部食べられちゃうよ？"},
        { "location": "106/SEL"   , "narrator": "", "text": "一人でも作れる？"},
        { "location": "107/SEL"   , "narrator": "", "text": "みやびのお母さん凄過ぎ"},
        { "location": "108/ACT"   , "narrator": "", "text": "全部食べられちゃうよ？"},
        { "location": "109/TALK"  , "narrator": "ガブリエラ", "text": "え？"},
        { "location": "121/TALK"  , "narrator": "ガブリエラ", "text": "ちょ、あんた達食べ過ぎ！\n半分近くなくなってる\nじゃない！？"},
        { "location": "123/TALK"  , "narrator": "アーヤ", "text": "あっ…ご、ごめん！\n凄く美味しくて、つい…。"},
        { "location": "126/TALK"  , "narrator": "神楽", "text": "わ、私もです…。\nつい手が止まらなく\nなちゃって…。"},
        { "location": "127/TALK"  , "narrator": "ガブリエラ", "text": "そう言ってもらえるのは\n嬉しいけど…。"},
        { "location": "128/TALK"  , "narrator": "ガブリエラ", "text": "一応それ、あたしの\nお昼ご飯でもあったん\nだけど…。"},
        { "location": "129/TALK"  , "narrator": "ガブリエラ", "text": "はぁ…まあ、いいわ。\nそこまで気に入って\nもらえたなら――"},
        { "location": "130/TALK"  , "narrator": "ガブリエラ", "text": "悪い気はしないし。"},
        { "location": "131/TALK"  , "narrator": "ガブリエラ", "text": "あたしは新しいの\n作るから、それは\n食べちゃっていいわよ。"},
        { "location": "134/TALK"  , "narrator": "アーヤ", "text": "またこのサラダ作るの？"},
        { "location": "135/TALK"  , "narrator": "ガブリエラ", "text": "そうだけど…。"},
        { "location": "136/TALK"  , "narrator": "アーヤ", "text": "それなら、私達の分も\n作ってもらいたいな。"},
        { "location": "138/TALK"  , "narrator": "ガブリエラ", "text": "まだ食べるつもり？"},
        { "location": "140/TALK"  , "narrator": "アーヤ", "text": "だって、本当に凄く\n美味しいんだもの。"},
        { "location": "142/TALK"  , "narrator": "神楽", "text": "私も、もう少し食べたい\nです。"},
        { "location": "143/TALK"  , "narrator": "つばめ", "text": "わたしも。\nお願いガブちゃん。"},
        { "location": "145/TALK"  , "narrator": "ガブリエラ", "text": "はぁ…\n本当、仕方ないわね。"},
        { "location": "146/TALK"  , "narrator": "ガブリエラ", "text": "少し時間かかるけど、\nそれでもいいなら\n作ってあげるから――"},
        { "location": "147/TALK"  , "narrator": "ガブリエラ", "text": "だらしない格好して\nないで、ちゃんと\n待ってるのよ？"},
        { "location": "150/TALK"  , "narrator": "つばめ", "text": "うん！"},
        { "location": "151/TALK"  , "narrator": "ガブリエラ", "text": "…じゃあ、\nちょっと待ってなさい。"},
        { "location": "152/TALK"  , "narrator": "ガブリエラ", "text": "…なんか、料理の楽しさに\n目覚めちゃうかも。"},
        { "location": "153/ACT"   , "narrator": "", "text": "一人でも作れる？"},
        { "location": "155/TALK"  , "narrator": "ガブリエラ", "text": "もちろん、ちゃんとメモは取ってあるもの"},
        { "location": "156/TALK"  , "narrator": "ガブリエラ", "text": "これさえあれば、一人でも問題なく作れるわ"},
        { "location": "167/TALK"  , "narrator": "アーヤ", "text": "ねえ、ギャヴィ。\nサラダ以外にも\n何か教わったの？"},
        { "location": "170/TALK"  , "narrator": "ガブリエラ", "text": "ううん、まだサラダしか\n教わってないけど――"},
        { "location": "171/TALK"  , "narrator": "ガブリエラ", "text": "また後で、違うのを\n教えてくれるって\n言ってたわ。"},
        { "location": "173/TALK"  , "narrator": "神楽", "text": "何を教えてもらえるかは\n聞いてないんですか？"},
        { "location": "174/TALK"  , "narrator": "ガブリエラ", "text": "うん、その時までの\nお楽しみだって。"},
        { "location": "176/TALK"  , "narrator": "つばめ", "text": "そうなんだ…。\n出来上がったら、\nまた味見させてね。"},
        { "location": "179/TALK"  , "narrator": "ガブリエラ", "text": "…そう来ると思った。\nじゃあ、少し多めに\n作るようにするわ。"},
        { "location": "180/ACT"   , "narrator": "", "text": "みやびのお母さん凄過ぎ"},
        { "location": "181/TALK"  , "narrator": "ガブリエラ", "text": "もぅ、ここはあたしを褒めるところじゃないの？"},
        { "location": "195/TALK"  , "narrator": "ガブリエラ", "text": "はぁ…。"},
        { "location": "198/TALK"  , "narrator": "神楽", "text": "ため息なんか吐いて、\nどうしたんですか？"},
        { "location": "199/TALK"  , "narrator": "ガブリエラ", "text": "…別に、何でもないわ。"},
        { "location": "201/TALK"  , "narrator": "つばめ", "text": "もしかして、ガブちゃんも\n夏バテ気味？"},
        { "location": "202/TALK"  , "narrator": "つばめ", "text": "このサラダ食べて、\nシャキッとした方が\nいいよ。"},
        { "location": "205/TALK"  , "narrator": "ガブリエラ", "text": "そうね、ありが――"},
        { "location": "207/TALK"  , "narrator": "ガブリエラ", "text": "って、あたしが作った\nサラダでしょ！"},
        { "location": "209/TALK"  , "narrator": "アーヤ", "text": "この合宿、ギャヴィに\nとっては料理合宿も\n兼ねたものになりそうね。"},
        { "location": "210/TALK"  , "narrator": "神楽", "text": "ここで美味しい料理の\n作り方をいっぱい教わ\nって――"},
        { "location": "211/TALK"  , "narrator": "神楽", "text": "東京に帰ってから、\n美味しい物作って\n食べさせてくださいね。"},
        { "location": "214/TALK"  , "narrator": "つばめ", "text": "こんなに美味しいなら、\n毎日だって喜んで\n食べるよ。"},
        { "location": "217/TALK"  , "narrator": "ガブリエラ", "text": "自分で作るの怠けたい\nだけでしょ？\nまったく…。"},
        { "location": "218/TALK"  , "narrator": "ガブリエラ", "text": "…まあ、こんなに沢山\n褒めてもらえるなら――"},
        { "location": "219/TALK"  , "narrator": "ガブリエラ", "text": "たまには良いかしら？"},
        { "location": "20/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>8月21日　 1:48 PM</color>\n合宿中、みやびの実家でのこと"}
    ]
}
