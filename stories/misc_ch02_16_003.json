    [
        { "location": "159/SCENARIO", "narrator": "", "text": "00-00_それが夢なの"},
        { "location": "184/TALK"    , "narrator": "アーヤ", "text": "電車の中で"},
        { "location": "185/TALK"    , "narrator": "アーヤ", "text": "ぐずってる子がいたから"},
        { "location": "186/TALK"    , "narrator": "アーヤ", "text": "あやしてたら"},
        { "location": "187/TALK"    , "narrator": "アーヤ", "text": "その子のお母さんにびっくりされちゃったわ"},
        { "location": "189/SEL"     , "narrator": "", "text": "不審者だ"},
        { "location": "190/SEL"     , "narrator": "", "text": "知らない子なんだよね？"},
        { "location": "191/SEL"     , "narrator": "", "text": "あやすのが上手かったからでしょ"},
        { "location": "192/ACT"     , "narrator": "", "text": "不審者だ"},
        { "location": "193/TALK"    , "narrator": "アーヤ", "text": "違うわよ"},
        { "location": "194/ACT"     , "narrator": "", "text": "知らない子なんだよね？"},
        { "location": "195/TALK"    , "narrator": "アーヤ", "text": "当たり前でしょ"},
        { "location": "196/ACT"     , "narrator": "", "text": "あやすのが上手かったからでしょ"},
        { "location": "198/TALK"    , "narrator": "アーヤ", "text": "そうだったみたい"},
        { "location": "200/TALK"    , "narrator": "アーヤ", "text": "若いのにお上手ねって"},
        { "location": "201/TALK"    , "narrator": "アーヤ", "text": "言われたわ"},
        { "location": "203/TALK"    , "narrator": "アーヤ", "text": "子供とか赤ちゃんがいると"},
        { "location": "204/TALK"    , "narrator": "アーヤ", "text": "つい目が行っちゃうのよね"},
        { "location": "206/SEL"     , "narrator": "", "text": "そうなんだ"},
        { "location": "207/SEL"     , "narrator": "", "text": "$me$は苦手かな"},
        { "location": "208/SEL"     , "narrator": "", "text": "自分の子供が早く欲しかったりする？"},
        { "location": "209/ACT"     , "narrator": "", "text": "そうなんだ"},
        { "location": "210/TALK"    , "narrator": "アーヤ", "text": "気になっちゃうのよね"},
        { "location": "211/TALK"    , "narrator": "アーヤ", "text": "どうしても"},
        { "location": "212/ACT"     , "narrator": "", "text": "$me$は苦手かな"},
        { "location": "213/TALK"    , "narrator": "アーヤ", "text": "そういう人も"},
        { "location": "214/TALK"    , "narrator": "アーヤ", "text": "いるわよね"},
        { "location": "215/ACT"     , "narrator": "", "text": "自分の子供が早く欲しかったりする？"},
        { "location": "219/TALK"    , "narrator": "アーヤ", "text": "まあね"},
        { "location": "220/TALK"    , "narrator": "アーヤ", "text": "そんなこと考えたりするわよ"},
        { "location": "221/TALK"    , "narrator": "アーヤ", "text": "あ"},
        { "location": "222/TALK"    , "narrator": "アーヤ", "text": "みんなには"},
        { "location": "223/TALK"    , "narrator": "アーヤ", "text": "絶対言わないでよ"},
        { "location": "225/SEL"     , "narrator": "", "text": "言わないよ"},
        { "location": "226/SEL"     , "narrator": "", "text": "言うかも"},
        { "location": "227/ACT"     , "narrator": "", "text": "言わないよ"},
        { "location": "228/TALK"    , "narrator": "アーヤ", "text": "絶対ね"},
        { "location": "229/TALK"    , "narrator": "アーヤ", "text": "絶対"},
        { "location": "230/TALK"    , "narrator": "アーヤ", "text": "絶対だからね"},
        { "location": "231/ACT"     , "narrator": "", "text": "言うかも"},
        { "location": "232/TALK"    , "narrator": "アーヤ", "text": "ひどい"},
        { "location": "233/TALK"    , "narrator": "アーヤ", "text": "言わないでよね"},
        { "location": "235/TALK"    , "narrator": "アーヤ", "text": "絶対に"}
    ]
}
