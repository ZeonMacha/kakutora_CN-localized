        { "location": "94/TALK" , "narrator": "ガブリエラ", "text": "ウソ！？"},
        { "location": "96/TALK" , "narrator": "ガブリエラ", "text": "このチケット、取れたの！？"},
        { "location": "97/TALK" , "narrator": "ガブリエラ", "text": "ありがとう、凄く見たかったのよ！"},
        { "location": "100/SEL" , "narrator": "", "text": "喜んでもらえて嬉しいよ"},
        { "location": "101/ACT" , "narrator": "", "text": "喜んでもらえて嬉しいよ"},
        { "location": "104/TALK", "narrator": "ガブリエラ", "text": "あっ"},
        { "location": "105/TALK", "narrator": "ガブリエラ", "text": "でもこのチケットの指定日"},
        { "location": "106/TALK", "narrator": "ガブリエラ", "text": "バイトのシフトが入ってる日だわ"},
        { "location": "107/TALK", "narrator": "ガブリエラ", "text": "もしかしたら、行けないかも"},
        { "location": "110/SEL" , "narrator": "", "text": "変わってもらえば？"},
        { "location": "111/ACT" , "narrator": "", "text": "変わってもらえば？"},
        { "location": "114/TALK", "narrator": "ガブリエラ", "text": "それしかないわね"},
        { "location": "115/TALK", "narrator": "ガブリエラ", "text": "私も、クラスの子達みたいに"},
        { "location": "116/TALK", "narrator": "ガブリエラ", "text": "バイトなんかしないで、好きなことできる時間が"},
        { "location": "117/TALK", "narrator": "ガブリエラ", "text": "せめてもう少しだけ欲しいわ"},
        { "location": "118/TALK", "narrator": "ガブリエラ", "text": "一度、まほに直訴してみようかしら？"}
