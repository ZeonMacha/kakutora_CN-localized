{
    "dir": "chap05/daydra/dd_ch03_05_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "5302",
        "cid": "gabriella",
        "title": "002 メインストーリー",
        "sub_title": "むぎまるであたたまる＜前編＞"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "むぎまるであたたまる"},
        { "location": "27/TALK"   , "narrator": "ガブリエラ", "text": "あむっ…。"},
        { "location": "28/TALK"   , "narrator": "ガブリエラ", "text": "ん～、美味しぃ！"},
        { "location": "29/TALK"   , "narrator": "ガブリエラ", "text": "やっぱりここの紅茶まんは\n最高よね。"},
        { "location": "31/TALK"   , "narrator": "ガブリエラ", "text": "…あれ？"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "でも確か、今日は絶対に\nよもぎマンヂウにしようと\nしてたような…。"},
        { "location": "34/TALK"   , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "37/TALK"   , "narrator": "ガブリエラ", "text": "まあ、仕方ないわね。\n紅茶まんはあたしの\nナンバーワンだもの。"},
        { "location": "38/TALK"   , "narrator": "ガブリエラ", "text": "紅茶なのに抹茶と合う、\nってところも、\n良いのよね。"},
        { "location": "49/TALK"   , "narrator": "みやび", "text": "…………。"},
        { "location": "67/TALK"   , "narrator": "ガブリエラ", "text": "ん？"},
        { "location": "87/TALK"   , "narrator": "ガブリエラ", "text": "えっ！？\nみ、みやび！？"},
        { "location": "90/TALK"   , "narrator": "みやび", "text": "ああ、やっぱし\nガブちゃんやったか。"},
        { "location": "91/TALK"   , "narrator": "ガブリエラ", "text": "ちょ、どうしてここに\nいるのよ！？"},
        { "location": "92/TALK"   , "narrator": "みやび", "text": "店の前を歩いちょったら、\n店の中に見覚えのある\nツインテールが――"},
        { "location": "93/TALK"   , "narrator": "みやび", "text": "こう、ピッコピッコ\n動いちゅうの見えたき、\n確かめにきたちや。"},
        { "location": "95/TALK"   , "narrator": "ガブリエラ", "text": "そういうことじゃ\nなくて…。"},
        { "location": "118/TALK"  , "narrator": "みやび", "text": "ちゅうか、ガブちゃん。\n昼休みに電車に乗って\n外食ゆうことは――"},
        { "location": "119/TALK"  , "narrator": "みやび", "text": "午後の授業出る気、\nないやろ？"},
        { "location": "120/TALK"  , "narrator": "ガブリエラ", "text": "ちゃんと時間は\n調べてあるわ。"},
        { "location": "121/TALK"  , "narrator": "ガブリエラ", "text": "５０分の電車に乗れば、\n駅からダッシュでギリギリ\n間に合うのよ。"},
        { "location": "122/TALK"  , "narrator": "みやび", "text": "食うてすぐ走るが？\nあんまし身体にえいとは\n思えんけんど――"},
        { "location": "123/TALK"  , "narrator": "みやび", "text": "ちゅうか、そんなに\nこの店が好きなんか？"},
        { "location": "124/TALK"  , "narrator": "ガブリエラ", "text": "美味しいから好きよ。"},
        { "location": "125/TALK"  , "narrator": "ガブリエラ", "text": "それに、毎日学食だと\n飽きるじゃない。"},
        { "location": "126/TALK"  , "narrator": "ガブリエラ", "text": "たまにはこうやって、\n外で食べる食事も\nいいものよ。"},
        { "location": "127/TALK"  , "narrator": "みやび", "text": "ダッシュで帰らんと\nいかんのも含めてか？"},
        { "location": "128/TALK"  , "narrator": "ガブリエラ", "text": "…まあ、必要な代償よ。"},
        { "location": "129/TALK"  , "narrator": "ガブリエラ", "text": "っていうか、みやびは\nどうなのよ？"},
        { "location": "130/TALK"  , "narrator": "ガブリエラ", "text": "こんな時間にのんびりと\n店に入って来るなんて――"},
        { "location": "131/TALK"  , "narrator": "ガブリエラ", "text": "絶対に午後の授業出る気\nないでしょ？"},
        { "location": "133/TALK"  , "narrator": "みやび", "text": "うちはえいんよ。"},
        { "location": "134/TALK"  , "narrator": "ガブリエラ", "text": "何がえいのよ？"},
        { "location": "137/TALK"  , "narrator": "みやび", "text": "あー、すみませーん。"},
        { "location": "140/TALK"  , "narrator": "ウェイトレス", "text": "お待たせいたしました。\nご注文をどうぞ。"},
        { "location": "141/TALK"  , "narrator": "みやび", "text": "特製冷たい美味しい\nセットを一つ。"},
        { "location": "143/TALK"  , "narrator": "みやび", "text": "マンヂウは…ガブちゃんは\n何にしたが？"},
        { "location": "144/TALK"  , "narrator": "ガブリエラ", "text": "紅茶まん。"},
        { "location": "146/TALK"  , "narrator": "みやび", "text": "じゃあ、それで。"},
        { "location": "147/TALK"  , "narrator": "ウェイトレス", "text": "承りました。\n少々お待ちください。"},
        { "location": "151/TALK"  , "narrator": "みやび", "text": "…しっかし、抹茶に\n紅茶ちゅう組み合わせは\nどうなん？"},
        { "location": "152/TALK"  , "narrator": "ガブリエラ", "text": "意外と合うのよ。\n不安なら他の頼めば\nよかったじゃない。"},
        { "location": "153/TALK"  , "narrator": "みやび", "text": "たまには変化を付けよう\n思うたんよ。"},
        { "location": "154/TALK"  , "narrator": "みやび", "text": "ちなみに、うちのお勧めは\n白地につぶあんや。"},
        { "location": "155/TALK"  , "narrator": "ガブリエラ", "text": "シンプル過ぎない？\nだったらチョコまんとかに\nすればいいじゃない。"},
        { "location": "156/TALK"  , "narrator": "みやび", "text": "そこはせめて白地にチーズ\nとかを勧めてくるところや\nないが？"},
        { "location": "157/TALK"  , "narrator": "みやび", "text": "まあ、美味い店いうんは、\nシンプルな物もまっこと\n美味いんよ。"},
        { "location": "158/TALK"  , "narrator": "ガブリエラ", "text": "ふーん…白地つぶあんは\nまだ食べたことないから、\n今度来た時に――"},
        { "location": "159/TALK"  , "narrator": "ガブリエラ", "text": "って、話逸らしたって\nことは、やっぱり午後の\n授業サボるつもりね？"},
        { "location": "160/TALK"  , "narrator": "みやび", "text": "ガブちゃん、\nうちは不良やないちや。"},
        { "location": "161/TALK"  , "narrator": "みやび", "text": "自主的に校外学習をしよう\n思うてるだけぞね。"},
        { "location": "162/TALK"  , "narrator": "ガブリエラ", "text": "いや、それサボりじゃ――"},
        { "location": "163/TALK"  , "narrator": "みやび", "text": "まあ、そんなことは\n今はどうでもえい話や。"},
        { "location": "164/TALK"  , "narrator": "みやび", "text": "せっかくガブちゃんと\n会えたんやし、ちっくと\n聞きたいことがあるんよ。"},
        { "location": "165/TALK"  , "narrator": "ガブリエラ", "text": "…何よ？"},
        { "location": "166/TALK"  , "narrator": "みやび", "text": "今日入ってきた新人。\n逢瀬つばめちゃんの\nことや。"},
        { "location": "167/TALK"  , "narrator": "みやび", "text": "あの子のこと、どう思う？"},
        { "location": "168/TALK"  , "narrator": "ガブリエラ", "text": "どうって、別に――"},
        { "location": "169/TALK"  , "narrator": "ガブリエラ", "text": "またお守しなくちゃ\nいけないのが増えたな、\nってくらいね。"},
        { "location": "170/TALK"  , "narrator": "ガブリエラ", "text": "みやびの時だって、\n最初の頃は大変だったん\nだから。"},
        { "location": "171/TALK"  , "narrator": "みやび", "text": "捏造は感心せんね。"},
        { "location": "172/TALK"  , "narrator": "みやび", "text": "うちは優等生やったき。\nガブちゃん、そんな\n苦労しちょらんろ？"},
        { "location": "173/TALK"  , "narrator": "ガブリエラ", "text": "…それこそ捏造でしょ？"},
        { "location": "174/TALK"  , "narrator": "みやび", "text": "過去はいくらでも\n捏造できるきね。"},
        { "location": "177/TALK"  , "narrator": "ガブリエラ", "text": "…みやびと話すのって、\nやっぱ疲れるわ。"},
        { "location": "178/TALK"  , "narrator": "みやび", "text": "まあ、うちの話は\nどうでもえいんよ。"},
        { "location": "179/TALK"  , "narrator": "みやび", "text": "今はつばめちゃんの話や。"},
        { "location": "182/TALK"  , "narrator": "ガブリエラ", "text": "…別に、あんな奴のこと\n話す必要ないでしょ？"},
        { "location": "183/TALK"  , "narrator": "みやび", "text": "ん？　ガブちゃんは\nつばめちゃんのこと、\nあんまし好きやないが？"},
        { "location": "184/TALK"  , "narrator": "みやび", "text": "うちはあの子に、\nかなり興味津々なんや\nけんどね。"},
        { "location": "185/TALK"  , "narrator": "ガブリエラ", "text": "…まあ、理由はなんとなく\nわかるわ。"},
        { "location": "186/TALK"  , "narrator": "ガブリエラ", "text": "ドームでのことよね？"},
        { "location": "187/TALK"  , "narrator": "みやび", "text": "うん…あの子は絶対に、\n何か裏があるに違いない。"},
        { "location": "188/TALK"  , "narrator": "みやび", "text": "ドームでのあれは、\n明らかに普通やなかった。"},
        { "location": "190/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "191/TALK"  , "narrator": "みやび", "text": "ガブちゃんはどう思う？"},
        { "location": "192/TALK"  , "narrator": "ガブリエラ", "text": "…どう思うも何も、\n決まってるじゃない。"},
        { "location": "193/TALK"  , "narrator": "ガブリエラ", "text": "あんな奴と一緒になんて、\n戦えないわ。"},
        { "location": "194/TALK"  , "narrator": "ガブリエラ", "text": "あの時のあいつ、\n明らかにおかしかったし。"},
        { "location": "195/TALK"  , "narrator": "ガブリエラ", "text": "不安要素になるような\n人間を仲間に加えるとか、\n絶対に反対よ。"},
        { "location": "196/TALK"  , "narrator": "みやび", "text": "う～ん…まあ、確かに\nちっくと不安ではある\nけんど――"},
        { "location": "197/TALK"  , "narrator": "みやび", "text": "あの力が毎回出るなら、\nうちらもめっちゃ楽できる\nんやない？"},
        { "location": "199/TALK"  , "narrator": "ガブリエラ", "text": "そんなの、絶対ダメよ！"},
        { "location": "200/TALK"  , "narrator": "ガブリエラ", "text": "みやびだって\n知ってるでしょ？"},
        { "location": "201/TALK"  , "narrator": "ガブリエラ", "text": "あいつのせいで、\n発症者のクランが\nどうなったのか…。"},
        { "location": "202/TALK"  , "narrator": "みやび", "text": "…もちろんや。"},
        { "location": "203/TALK"  , "narrator": "ガブリエラ", "text": "だったら！"},
        { "location": "204/TALK"  , "narrator": "みやび", "text": "楽できる言うたんは、\n冗談や。"},
        { "location": "205/TALK"  , "narrator": "みやび", "text": "けんど、つばめちゃんの\nあの能力には、興味ある。"},
        { "location": "206/TALK"  , "narrator": "みやび", "text": "クランを、あそこまで\n無残に破壊する能力、\n初めて見たきね。"},
        { "location": "207/TALK"  , "narrator": "ガブリエラ", "text": "興味って…。"},
        { "location": "209/TALK"  , "narrator": "ガブリエラ", "text": "…やっぱり、みやびは\nどうかしてるわ。"},
        { "location": "210/TALK"  , "narrator": "ガブリエラ", "text": "自分が壊されるかも\nしれないのに、興味が\nあるなんて…。"},
        { "location": "211/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "212/TALK"  , "narrator": "ガブリエラ", "text": "でも…あたしも、\nあの力が何なのか\n気になってる…。"},
        { "location": "213/TALK"  , "narrator": "ガブリエラ", "text": "これって、あの力に\n興味を持ってる、って\nことなの？"},
        { "location": "214/TALK"  , "narrator": "ガブリエラ", "text": "…どうして？\nこんなに怖いって\n思ってるのに…。"},
        { "location": "215/TALK"  , "narrator": "みやび", "text": "…ガブちゃん？\n顔色悪いけんど、\nどうかしたが？"},
        { "location": "217/TALK"  , "narrator": "ガブリエラ", "text": "な、何でもないわ。\n別に…。"},
        { "location": "218/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "219/TALK"  , "narrator": "ガブリエラ", "text": "まさか、まさかあたし\n興味を持ってるのは\nあの子の力じゃなくて…"},
        { "location": "265/TALK"  , "narrator": "ガブリエラ", "text": "来たわね！"},
        { "location": "266/TALK"  , "narrator": "ガブリエラ", "text": "今回のあたしも、また\nかなりイイカンジに\n膠着しちゃってるもんね。"},
        { "location": "267/TALK"  , "narrator": "ガブリエラ", "text": "それじゃ早速、\nその【問題の扉】を\nオープン♪"},
        { "location": "274/TALK"  , "narrator": "ガブリエラ", "text": "オープンプロセス、\n0x119番地から\n0x58C番地へ。"},
        { "location": "289/TALK"  , "narrator": "ガブリエラ", "text": "シーク完了♪"},
        { "location": "291/TALK"  , "narrator": "ガブリエラ", "text": "さて、今回は\n何があったのかしら。"},
        { "location": "292/TALK"  , "narrator": "ガブリエラ", "text": "…。"},
        { "location": "293/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "294/TALK"  , "narrator": "ガブリエラ", "text": "あー、そっか。"},
        { "location": "295/TALK"  , "narrator": "ガブリエラ", "text": "まさに、うら若き\n乙女心と、ソルジャーの\n生存本能のバトルね！"},
        { "location": "296/SEL"   , "narrator": "", "text": "なにそのギャップ"},
        { "location": "297/ACT"   , "narrator": "", "text": "なにそのギャップ"},
        { "location": "299/TALK"  , "narrator": "ガブリエラ", "text": "まあ、あたしの生まれは\n戦禍のポーランドだから。"},
        { "location": "300/SEL"   , "narrator": "", "text": "ポーランドって戦争中なの！？"},
        { "location": "301/ACT"   , "narrator": "", "text": "ポーランドって戦争中なの！？"},
        { "location": "303/TALK"  , "narrator": "ガブリエラ", "text": "あくまで\nあたしの世界はね。"},
        { "location": "304/TALK"  , "narrator": "ガブリエラ", "text": "$handle$の世界は\n平和なのかもだけど。"},
        { "location": "305/TALK"  , "narrator": "ガブリエラ", "text": "第二次冷戦と言われる\nロシアとNATOの戦いで、\n代理戦争の餌食になった。"},
        { "location": "306/SEL"   , "narrator": "", "text": "そうなんだ……"},
        { "location": "307/ACT"   , "narrator": "", "text": "そうなんだ……"},
        { "location": "309/TALK"  , "narrator": "ガブリエラ", "text": "まあ、この辺の話は\nもしかしたら後ほど\nどこかで語れるかも。"},
        { "location": "310/TALK"  , "narrator": "ガブリエラ", "text": "興味あれば、その時に\n詳しく教えるわね。"},
        { "location": "311/TALK"  , "narrator": "ガブリエラ", "text": "何にしても、今は\nそういう難しい話は、\nおいておいて……と。"},
        { "location": "312/TALK"  , "narrator": "ガブリエラ", "text": "そんな環境で育ったから\n必要以上に周りに警戒心を\n持ってるのは確かね。"},
        { "location": "313/TALK"  , "narrator": "ガブリエラ", "text": "生存に対する危機感は\n他の誰よりも心の奥底に\nこびりついてると思う。"},
        { "location": "314/SEL"   , "narrator": "", "text": "で、本人としてはどうしたいの？"},
        { "location": "315/ACT"   , "narrator": "", "text": "で、本人としてはどうしたいの？"},
        { "location": "317/TALK"  , "narrator": "ガブリエラ", "text": "ココロファイルナンバー\n03-541-22によると、\n既に心は決まってるわね。"},
        { "location": "318/TALK"  , "narrator": "ガブリエラ", "text": "あたしは\n逢瀬つばめとの距離を\n縮めたいと思ってる。"},
        { "location": "319/TALK"  , "narrator": "ガブリエラ", "text": "もう１つの本能は、\nあの子のことを安全だと\n伝えているのよ。"},
        { "location": "320/SEL"   , "narrator": "", "text": "$me$も安全だと思う"},
        { "location": "321/SEL"   , "narrator": "", "text": "$me$は危険だと思う"},
        { "location": "322/ACT"   , "narrator": "", "text": "$me$も安全だと思う"},
        { "location": "323/TALK"  , "narrator": "ガブリエラ", "text": "そうよね～♪\nつばめ、あんなに\n可愛いのに！"},
        { "location": "324/TALK"  , "narrator": "ガブリエラ", "text": "あたしってば、\nなんでこんなに\n意地っ張りなのかしら。"},
        { "location": "325/TALK"  , "narrator": "ガブリエラ", "text": "とにかく！\nそういうわけだから、\n今回もよろしくね♪"},
        { "location": "327/TALK"  , "narrator": "ガブリエラ", "text": "あたしと\n$handle$にとって\n素敵なココロの旅を！"},
        { "location": "334/ACT"   , "narrator": "", "text": "$me$は危険だと思う"},
        { "location": "335/TALK"  , "narrator": "ガブリエラ", "text": "そう、残念ね。でも\n確かに、まだ安全だって\n保証は無いものね。"},
        { "location": "336/TALK"  , "narrator": "ガブリエラ", "text": "ただそうなってくると、\nトライナリーとして一緒に\nいるのも難しいわよね。"},
        { "location": "337/TALK"  , "narrator": "ガブリエラ", "text": "そっちの扉を無理矢理\n開ける事もできるけど…"},
        { "location": "338/TALK"  , "narrator": "ガブリエラ", "text": "そうすると色々面倒な\nことになるから、\nあたしは嫌かな～。"},
        { "location": "340/TALK"  , "narrator": "ガブリエラ", "text": "まあいいわ。\n気が向いたらまた来てね。"},
        { "location": "26/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>５月８日　12:08 PM</color>\nWAVE戦前日、昼休みの合間に\n神楽坂カフェ「むぎまる２」にて。"},
        { "location": "231/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"}
    ]
}
