    "entry":
    [
        { "location": "94/SCENARIO", "narrator": "", "text": "05_000_イミテーションの真実"},
        { "location": "119/TALK"   , "narrator": "みやび", "text": "イミテーション"},
        { "location": "121/SEL"    , "narrator": "", "text": "ゴールド"},
        { "location": "122/SEL"    , "narrator": "", "text": "映画の話？"},
        { "location": "123/SEL"    , "narrator": "", "text": "$me$とみやびの仲は真実"},
        { "location": "124/ACT"    , "narrator": "", "text": "ゴールド"},
        { "location": "125/TALK"   , "narrator": "みやび", "text": "金ということか？"},
        { "location": "126/TALK"   , "narrator": "みやび", "text": "イミテーションということは"},
        { "location": "127/TALK"   , "narrator": "みやび", "text": "純度が低いのか"},
        { "location": "128/ACT"    , "narrator": "", "text": "映画の話？"},
        { "location": "129/TALK"   , "narrator": "みやび", "text": "チューリングとエニグマ暗号"},
        { "location": "130/TALK"   , "narrator": "みやび", "text": "ハッカー必見ぞね"},
        { "location": "131/ACT"    , "narrator": "", "text": "$me$とみやびの仲は真実"},
        { "location": "133/TALK"   , "narrator": "みやび", "text": "いいことを言う"},
        { "location": "135/TALK"   , "narrator": "みやび", "text": "しかし"},
        { "location": "136/TALK"   , "narrator": "みやび", "text": "それこそがイミテーション"},
        { "location": "137/TALK"   , "narrator": "みやび", "text": "かもしらんぞね"},
        { "location": "139/TALK"   , "narrator": "みやび", "text": "そしてだ"},
        { "location": "140/TALK"   , "narrator": "みやび", "text": "イミテーションというからには"},
        { "location": "141/TALK"   , "narrator": "みやび", "text": "本物が必ず存在する"},
        { "location": "143/SEL"    , "narrator": "", "text": "まあね"},
        { "location": "144/ACT"    , "narrator": "", "text": "まあね"},
        { "location": "146/TALK"   , "narrator": "みやび", "text": "イミテーションは"},
        { "location": "147/TALK"   , "narrator": "みやび", "text": "本物を越えられぬのだろうか"},
        { "location": "149/SEL"    , "narrator": "", "text": "青は藍より出でて藍より青し"},
        { "location": "150/SEL"    , "narrator": "", "text": "できないやつは何をやってもダメ"},
        { "location": "151/SEL"    , "narrator": "", "text": "超えた時点でイミテーションではない"},
        { "location": "152/ACT"    , "narrator": "", "text": "青は藍より出でて藍より青し"},
        { "location": "153/TALK"   , "narrator": "みやび", "text": "なるほど"},
        { "location": "154/TALK"   , "narrator": "みやび", "text": "出藍の誉れ"},
        { "location": "155/TALK"   , "narrator": "みやび", "text": "と"},
        { "location": "156/TALK"   , "narrator": "みやび", "text": "いうことか"},
        { "location": "157/ACT"    , "narrator": "", "text": "できないやつは何をやってもダメ"},
        { "location": "158/TALK"   , "narrator": "みやび", "text": "なんと"},
        { "location": "160/TALK"   , "narrator": "みやび", "text": "身も蓋もない"},
        { "location": "161/TALK"   , "narrator": "みやび", "text": "しかし"},
        { "location": "162/TALK"   , "narrator": "みやび", "text": "正しいな"},
        { "location": "163/ACT"    , "narrator": "", "text": "超えた時点でイミテーションではない"},
        { "location": "164/TALK"   , "narrator": "みやび", "text": "確かに"},
        { "location": "165/TALK"   , "narrator": "みやび", "text": "理屈上ではそうなるな"},
        { "location": "166/TALK"   , "narrator": "みやび", "text": "ふむ"},
        { "location": "167/TALK"   , "narrator": "みやび", "text": "参考になった"}
    ]
}
