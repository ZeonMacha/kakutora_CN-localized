    "entry":
    [
        { "location": "134/SCENARIO", "narrator": "", "text": "390_ありがとう、おめでとう"},
        { "location": "146/TALK"    , "narrator": "ラビットアニマ", "text": "結果は大成功"},
        { "location": "147/TALK"    , "narrator": "ラビットアニマ", "text": "そう思っていいですよね"},
        { "location": "149/SEL"     , "narrator": "", "text": "まあね"},
        { "location": "150/SEL"     , "narrator": "", "text": "だったらいいけど"},
        { "location": "151/SEL"     , "narrator": "", "text": "背中を押してくれたおかげだよ"},
        { "location": "152/ACT"     , "narrator": "", "text": "まあね"},
        { "location": "154/TALK"    , "narrator": "ラビットアニマ", "text": "余裕ですね"},
        { "location": "155/TALK"    , "narrator": "ラビットアニマ", "text": "あなたにとっては"},
        { "location": "156/TALK"    , "narrator": "ラビットアニマ", "text": "当然のことなんでしょうね"},
        { "location": "157/ACT"     , "narrator": "", "text": "だったらいいけど"},
        { "location": "159/TALK"    , "narrator": "ラビットアニマ", "text": "気弱ですね"},
        { "location": "160/TALK"    , "narrator": "ラビットアニマ", "text": "大丈夫"},
        { "location": "161/TALK"    , "narrator": "ラビットアニマ", "text": "みやびさんは"},
        { "location": "162/TALK"    , "narrator": "ラビットアニマ", "text": "空元気でなく元気になりました"},
        { "location": "163/ACT"     , "narrator": "", "text": "背中を押してくれたおかげだよ"},
        { "location": "175/TALK"    , "narrator": "ラビットアニマ", "text": "余計なことをしたって思って"},
        { "location": "176/TALK"    , "narrator": "ラビットアニマ", "text": "あの後落ち込んでいました"},
        { "location": "178/TALK"    , "narrator": "ラビットアニマ", "text": "でも"},
        { "location": "179/TALK"    , "narrator": "ラビットアニマ", "text": "そう言ってもらえて"},
        { "location": "180/TALK"    , "narrator": "ラビットアニマ", "text": "よかったです"},
        { "location": "182/SEL"     , "narrator": "", "text": "これからもよろしく"},
        { "location": "183/SEL"     , "narrator": "", "text": "今度二人で遊ぼうよ"},
        { "location": "184/ACT"     , "narrator": "", "text": "これからもよろしく"},
        { "location": "186/TALK"    , "narrator": "ラビットアニマ", "text": "はい"},
        { "location": "187/TALK"    , "narrator": "ラビットアニマ", "text": "こちらこそ"},
        { "location": "188/TALK"    , "narrator": "ラビットアニマ", "text": "よろしくお願いします"},
        { "location": "189/ACT"     , "narrator": "", "text": "今度二人で遊ぼうよ"},
        { "location": "191/TALK"    , "narrator": "ラビットアニマ", "text": "またまた"},
        { "location": "192/TALK"    , "narrator": "ラビットアニマ", "text": "そういうことは"},
        { "location": "193/TALK"    , "narrator": "ラビットアニマ", "text": "みやびさんに言ってくださいね"},
        { "location": "169/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>900pt.</b></color></size>\nアップしました！"}
    ]
}
