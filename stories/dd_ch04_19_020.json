{
    "dir": "chap19/daydra/dd_ch04_19_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "19456",
        "cid": "miyabi",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "家族写真"
    },
    "entry":
    [
        { "location": "175/SCENARIO", "narrator": "", "text": "家族写真"},
        { "location": "185/TALK"    , "narrator": "みやび", "text": "…ははっ、懐かしいな。"},
        { "location": "186/TALK"    , "narrator": "みやび", "text": "まさか、昔のアルバムが\n出てくるとは…。"},
        { "location": "188/TALK"    , "narrator": "みやび", "text": "…これ、うちか？\nでっかい口開けて\n大笑いしてるが…。"},
        { "location": "190/TALK"    , "narrator": "みやび", "text": "こっちのは、初めて\n料理した時の写真やね。"},
        { "location": "191/TALK"    , "narrator": "みやび", "text": "…焦げ焦げの魚と、\n明らかに色の薄い味噌汁\nやなぁ…。"},
        { "location": "193/TALK"    , "narrator": "みやび", "text": "もうちっくと上手に\nできてた思うてた\nけんど――"},
        { "location": "195/TALK"    , "narrator": "みやび", "text": "思い出補正やったか…。"},
        { "location": "196/TALK"    , "narrator": "みやび", "text": "…しっかし、懐かしい\n気持ちもあるけんど、\n何となく、恥ずかしいな。"},
        { "location": "197/SEL"     , "narrator": "", "text": "見たい見たい！"},
        { "location": "199/TALK"    , "narrator": "みやび", "text": "今の自分とはかけ離れた\n姿やからか？"},
        { "location": "201/TALK"    , "narrator": "みやび", "text": "…うわっ、こっちのは\n初めて逆上がりした時の\n写真や！"},
        { "location": "202/TALK"    , "narrator": "みやび", "text": "…これ、本当にうちか？"},
        { "location": "205/TALK"    , "narrator": "みやび", "text": "…こっちは、家族写真か。"},
        { "location": "206/TALK"    , "narrator": "みやび", "text": "ははっ、二人とも\n若いなぁ…。"},
        { "location": "207/TALK"    , "narrator": "みやび", "text": "……あっ。"},
        { "location": "208/TALK"    , "narrator": "みやび", "text": "…なごちゃん。"},
        { "location": "222/TALK"    , "narrator": "つばめ", "text": "みやびさーん、\nどこですかー？"},
        { "location": "225/TALK"    , "narrator": "神楽", "text": "部屋の方には\nいませんでした。"},
        { "location": "226/TALK"    , "narrator": "つばめ", "text": "こっちもだよ。"},
        { "location": "227/TALK"    , "narrator": "つばめ", "text": "どこに行ったんだろう？\nもうすぐ夕飯なのに…。"},
        { "location": "228/TALK"    , "narrator": "神楽", "text": "もしかして、散歩にでも\n行ったんじゃないですか？"},
        { "location": "229/TALK"    , "narrator": "つばめ", "text": "そうかも。\nわたし、ＷＡＶＥ\n送ってみるよ。"},
        { "location": "230/TALK"    , "narrator": "神楽", "text": "はい、お願いし――"},
        { "location": "231/TALK"    , "narrator": "神楽", "text": "あっ、みやびさん！"},
        { "location": "238/TALK"    , "narrator": "みやび", "text": "…なんや？\nさっきから何度も何度も\n呼びまくって…。"},
        { "location": "239/TALK"    , "narrator": "神楽", "text": "みやびさん…\nどこにいたんですか？"},
        { "location": "241/TALK"    , "narrator": "みやび", "text": "…手洗いや。"},
        { "location": "244/TALK"    , "narrator": "つばめ", "text": "えっ？　でも、奥にある\n木戸の部屋から出てきた\nような…。"},
        { "location": "247/TALK"    , "narrator": "みやび", "text": "それで、何の用や？"},
        { "location": "248/TALK"    , "narrator": "つばめ", "text": "あ、はい…。\nもうすぐお夕飯の\n時間ですよ？"},
        { "location": "249/TALK"    , "narrator": "みやび", "text": "…もうそんな時間か。\nありがとな、二人とも。"},
        { "location": "250/TALK"    , "narrator": "神楽", "text": "…どうかしたんですか？\n何だか、いつもより\n元気ないみたいです。"},
        { "location": "251/TALK"    , "narrator": "神楽", "text": "それに、目の下も\n腫れてますし…。"},
        { "location": "252/TALK"    , "narrator": "みやび", "text": "…大したことやない。"},
        { "location": "253/TALK"    , "narrator": "みやび", "text": "うち、潮風が苦手でな。\n薬を飲まんと、すぐに目が\nこうなるがよ。"},
        { "location": "254/TALK"    , "narrator": "つばめ", "text": "そうだったんですか？\nじゃあ、すぐに薬を\n飲まなきゃ…。"},
        { "location": "255/TALK"    , "narrator": "みやび", "text": "さっき飲んだき、\nもう平気や。"},
        { "location": "256/TALK"    , "narrator": "みやび", "text": "…ほれ、夕飯やろ？\nわかったから、\n先に行きぃ。"},
        { "location": "257/TALK"    , "narrator": "神楽", "text": "わかりました…。\nつばめさん、\n行きましょう。"},
        { "location": "260/TALK"    , "narrator": "つばめ", "text": "あ、うん…。"},
        { "location": "263/SEL"     , "narrator": "", "text": "みやび、平気？"},
        { "location": "264/SEL"     , "narrator": "", "text": "さっきの写真が原因？"},
        { "location": "265/SEL"     , "narrator": "", "text": "ご飯食べて元気出して"},
        { "location": "269/TALK"    , "narrator": "みやび", "text": "はぁ…。"},
        { "location": "270/TALK"    , "narrator": "みやび", "text": "…誤魔化せたか？\nまったく、こんな時に\nタイミングが悪い…。"},
        { "location": "274/TALK"    , "narrator": "みやび", "text": "…顔洗って、\n夕飯にするか。"},
        { "location": "275/TALK"    , "narrator": "みやび", "text": "これ以上待たせると、\nまた誰か来るかも\nしれんし…。"},
        { "location": "277/ACT"     , "narrator": "", "text": "みやび、平気？"},
        { "location": "295/TALK"    , "narrator": "みやび", "text": "さっきつばめちゃんにも、平気言うたの聞いてなかったが？"},
        { "location": "296/TALK"    , "narrator": "みやび", "text": "同じこと、二度も言わせんなや"},
        { "location": "308/ACT"     , "narrator": "", "text": "さっきの写真が原因？"},
        { "location": "326/TALK"    , "narrator": "みやび", "text": "潮風言うたの、聞いてなかったが？"},
        { "location": "327/TALK"    , "narrator": "みやび", "text": "相棒の考え過ぎや"},
        { "location": "339/ACT"     , "narrator": "", "text": "ご飯食べて元気出して"},
        { "location": "358/TALK"    , "narrator": "みやび", "text": "気を利かせてるのか天然なのかはわからんけんど"},
        { "location": "359/TALK"    , "narrator": "みやび", "text": "今はその反応がありがたいちや"},
        { "location": "375/ACT"     , "narrator": "", "text": "見たい見たい！"},
        { "location": "393/TALK"    , "narrator": "みやび", "text": "相棒、すまんけんど、今はちょっと黙っときぃ"},
        { "location": "395/TALK"    , "narrator": "みやび", "text": "久しぶりに思い出に浸って楽しんどる最中やき"},
        { "location": "396/TALK"    , "narrator": "みやび", "text": "すまんけんど、電源切っとくな"},
        { "location": "183/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>8月17日　 7:15 PM</color>\n合宿初日の夜、みやびの部屋にて"}
    ]
}
