    "info": {
        "story_id": "3017",
        "cid": "gabriella",
        "title": "らぶとーく  第17話",
        "sub_title": "知ってるんだから"
    },
    "entry":
    [
        { "location": "468/SCENARIO", "narrator": "", "text": "知ってるんだから"},
        { "location": "480/TALK"    , "narrator": "ガブリエラ", "text": "ふぅ…。"},
        { "location": "481/TALK"    , "narrator": "ガブリエラ", "text": "…やっぱり、今日は\n変な気分かも。"},
        { "location": "482/TALK"    , "narrator": "ガブリエラ", "text": "一日中モヤモヤした\n気持ちが続いてるし――"},
        { "location": "483/TALK"    , "narrator": "ガブリエラ", "text": "でも、体調が悪い、って\nわけじゃないし…。"},
        { "location": "484/TALK"    , "narrator": "ガブリエラ", "text": "…せっかくカフェに\n来たってのに、これじゃ\n楽しくないわ…。"},
        { "location": "486/TALK"    , "narrator": "ガブリエラ", "text": "はぁ…。"},
        { "location": "487/SEL"     , "narrator": "", "text": "おーい"},
        { "location": "488/ACT"     , "narrator": "", "text": "おーい"},
        { "location": "499/TALK"    , "narrator": "ガブリエラ", "text": "何よ？"},
        { "location": "501/SEL"     , "narrator": "", "text": "退屈してるんじゃないかって"},
        { "location": "502/SEL"     , "narrator": "", "text": "何してるの？"},
        { "location": "503/SEL"     , "narrator": "", "text": "ガブリエラのことが気になって"},
        { "location": "504/ACT"     , "narrator": "", "text": "退屈してるんじゃないかって"},
        { "location": "505/TALK"    , "narrator": "ガブリエラ", "text": "してないわよ"},
        { "location": "506/TALK"    , "narrator": "ガブリエラ", "text": "今、優雅にティータイムを楽しんでいるところなんだから"},
        { "location": "507/TALK"    , "narrator": "ガブリエラ", "text": "邪魔しないで"},
        { "location": "509/SEL"     , "narrator": "", "text": "怒ってる？"},
        { "location": "510/ACT"     , "narrator": "", "text": "怒ってる？"},
        { "location": "512/TALK"    , "narrator": "ガブリエラ", "text": "は？　なんで？"},
        { "location": "514/TALK"    , "narrator": "ガブリエラ", "text": "っていうか、私だけに構ってていいの？"},
        { "location": "515/TALK"    , "narrator": "ガブリエラ", "text": "他の子達と話すのに忙しいんでしょうし"},
        { "location": "516/TALK"    , "narrator": "ガブリエラ", "text": "こういうところ、まめよね？"},
        { "location": "519/ACT"     , "narrator": "", "text": "何してるの？"},
        { "location": "520/TALK"    , "narrator": "ガブリエラ", "text": "別に"},
        { "location": "521/TALK"    , "narrator": "ガブリエラ", "text": "期間限定ケーキを食べにきたのよ"},
        { "location": "522/TALK"    , "narrator": "ガブリエラ", "text": "それだけ"},
        { "location": "524/SEL"     , "narrator": "", "text": "機嫌悪い？"},
        { "location": "525/ACT"     , "narrator": "", "text": "機嫌悪い？"},
        { "location": "527/TALK"    , "narrator": "ガブリエラ", "text": "は？　なんで？"},
        { "location": "529/TALK"    , "narrator": "ガブリエラ", "text": "っていうか、他の子達と話すのに忙しいんでしょ？"},
        { "location": "530/TALK"    , "narrator": "ガブリエラ", "text": "私に気を使って話す必要、なくってよ"},
        { "location": "533/ACT"     , "narrator": "", "text": "ガブリエラのことが気になって"},
        { "location": "534/TALK"    , "narrator": "ガブリエラ", "text": "あら、さすがねマルザンナ"},
        { "location": "535/TALK"    , "narrator": "ガブリエラ", "text": "口がお上手なことで"},
        { "location": "536/TALK"    , "narrator": "ガブリエラ", "text": "そうやって、みんなとも仲良くなったのかしら？"},
        { "location": "539/SEL"     , "narrator": "", "text": "何のこと？"},
        { "location": "540/ACT"     , "narrator": "", "text": "何のこと？"},
        { "location": "542/TALK"    , "narrator": "ガブリエラ", "text": "何でもないわ"},
        { "location": "543/TALK"    , "narrator": "ガブリエラ", "text": "私だけじゃなくって"},
        { "location": "544/TALK"    , "narrator": "ガブリエラ", "text": "みんなのことも気になってるくせに"},
        { "location": "552/TALK"    , "narrator": "ガブリエラ", "text": "はぁ…余計楽しく\nなくなってきたかも…。"},
        { "location": "553/TALK"    , "narrator": "ガブリエラ", "text": "もう、帰ろうかしら…。"}
    ]
}
