    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "002_新約童話もございます"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "ねえマルザンナ"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "貴方が童話をすすめてくれたから"},
        { "location": "34/TALK"   , "narrator": "ガブリエラ", "text": "私借りて読んでみたわ"},
        { "location": "37/SEL"    , "narrator": "", "text": "そう"},
        { "location": "38/SEL"    , "narrator": "", "text": "いいこね"},
        { "location": "39/SEL"    , "narrator": "", "text": "難しくなかった？"},
        { "location": "40/ACT"    , "narrator": "", "text": "そう"},
        { "location": "41/TALK"   , "narrator": "ガブリエラ", "text": "そうなの"},
        { "location": "42/TALK"   , "narrator": "ガブリエラ", "text": "面白かったわ"},
        { "location": "43/ACT"    , "narrator": "", "text": "いいこね"},
        { "location": "45/TALK"   , "narrator": "ガブリエラ", "text": "あら"},
        { "location": "47/TALK"   , "narrator": "ガブリエラ", "text": "いいこなのはマルザンナよｖｖｖｖ"},
        { "location": "48/ACT"    , "narrator": "", "text": "難しくなかった？"},
        { "location": "49/TALK"   , "narrator": "ガブリエラ", "text": "あら"},
        { "location": "50/TALK"   , "narrator": "ガブリエラ", "text": "私日本語かなり上手なのよ"},
        { "location": "51/TALK"   , "narrator": "ガブリエラ", "text": "知っているでしょう？"},
        { "location": "53/TALK"   , "narrator": "ガブリエラ", "text": "こどもむけのわりに"},
        { "location": "54/TALK"   , "narrator": "ガブリエラ", "text": "面白かったわ"},
        { "location": "56/SEL"    , "narrator": "", "text": "何を読んだの？"},
        { "location": "57/SEL"    , "narrator": "", "text": "色々読みたくなった？"},
        { "location": "58/SEL"    , "narrator": "", "text": "桃太郎じゃないの？"},
        { "location": "59/ACT"    , "narrator": "", "text": "何を読んだの？"},
        { "location": "60/TALK"   , "narrator": "ガブリエラ", "text": "金太郎よ！"},
        { "location": "62/TALK"   , "narrator": "ガブリエラ", "text": "あんなスリリングな話だとは思わなかったわ"},
        { "location": "64/SEL"    , "narrator": "", "text": "スリリング？"},
        { "location": "65/SEL"    , "narrator": "", "text": "そんな話だったっけ？"},
        { "location": "66/ACT"    , "narrator": "", "text": "スリリング？"},
        { "location": "67/TALK"   , "narrator": "ガブリエラ", "text": "そうよ"},
        { "location": "68/TALK"   , "narrator": "ガブリエラ", "text": "スリルに満ちていたわ"},
        { "location": "69/ACT"    , "narrator": "", "text": "そんな話だったっけ？"},
        { "location": "70/TALK"   , "narrator": "ガブリエラ", "text": "当然よ！"},
        { "location": "72/TALK"   , "narrator": "ガブリエラ", "text": "クマと"},
        { "location": "73/TALK"   , "narrator": "ガブリエラ", "text": "そう、恐ろしい猛獣"},
        { "location": "74/TALK"   , "narrator": "ガブリエラ", "text": "クマと相撲を取るのよ！"},
        { "location": "75/TALK"   , "narrator": "ガブリエラ", "text": "そんな恐ろしいことをしてのける"},
        { "location": "76/TALK"   , "narrator": "ガブリエラ", "text": "金太郎って素敵///////////////"},
        { "location": "78/SEL"    , "narrator": "", "text": "そうなんだ…"},
        { "location": "79/SEL"    , "narrator": "", "text": "かっこよくて良かったね"},
        { "location": "80/SEL"    , "narrator": "", "text": "新解釈…"},
        { "location": "81/ACT"    , "narrator": "", "text": "そうなんだ…"},
        { "location": "82/TALK"   , "narrator": "ガブリエラ", "text": "そうよ"},
        { "location": "84/TALK"   , "narrator": "ガブリエラ", "text": "マルザンナも読んでみるといいと思うわｖｖｖ"},
        { "location": "85/TALK"   , "narrator": "ガブリエラ", "text": "金太郎が本当に格好いいから///////////////"},
        { "location": "86/ACT"    , "narrator": "", "text": "かっこよくて良かったね"},
        { "location": "87/TALK"   , "narrator": "ガブリエラ", "text": "ええｖｖｖ"},
        { "location": "89/TALK"   , "narrator": "ガブリエラ", "text": "金太郎が本当に格好いいの///////////////"},
        { "location": "90/TALK"   , "narrator": "ガブリエラ", "text": "マルザンナも読んでみればわかるわよｖｖｖ"},
        { "location": "91/ACT"    , "narrator": "", "text": "新解釈…"},
        { "location": "92/TALK"   , "narrator": "ガブリエラ", "text": "そんなことないわよ！"},
        { "location": "93/TALK"   , "narrator": "ガブリエラ", "text": "みんな金太郎に夢中になのよｖｖｖ"},
        { "location": "95/TALK"   , "narrator": "ガブリエラ", "text": "だから有名なんだと思うわよ？"},
        { "location": "97/ACT"    , "narrator": "", "text": "色々読みたくなった？"},
        { "location": "98/TALK"   , "narrator": "ガブリエラ", "text": "もちろん！"},
        { "location": "99/TALK"   , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "100/TALK"  , "narrator": "ガブリエラ", "text": "みやびにごんぎつねは気を付けろって言われたわ"},
        { "location": "101/TALK"  , "narrator": "ガブリエラ", "text": "タイトルからすると"},
        { "location": "103/TALK"  , "narrator": "ガブリエラ", "text": "きつね狩りの話かなにかなのかしら？"},
        { "location": "104/TALK"  , "narrator": "ガブリエラ", "text": "気になるから"},
        { "location": "105/TALK"  , "narrator": "ガブリエラ", "text": "今度はこれを読んでみようと思うわ"},
        { "location": "106/ACT"   , "narrator": "", "text": "桃太郎じゃないの？"},
        { "location": "107/TALK"  , "narrator": "ガブリエラ", "text": "あら"},
        { "location": "108/TALK"  , "narrator": "ガブリエラ", "text": "そのお話はもう知っていてよ？"},
        { "location": "109/TALK"  , "narrator": "ガブリエラ", "text": "犬とサルと"},
        { "location": "112/TALK"  , "narrator": "ガブリエラ", "text": "もう一匹家来がいたわよね"},
        { "location": "113/TALK"  , "narrator": "ガブリエラ", "text": "ちょっとおぼえてないわ"},
        { "location": "114/TALK"  , "narrator": "ガブリエラ", "text": "次はこれを読もうかしら"}
    ]
}
