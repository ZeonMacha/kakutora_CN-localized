{
    "dir": "chap17/daydra/dd_ch03_17_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "17302",
        "cid": "gabriella",
        "title": "002 メインストーリー",
        "sub_title": "マナーか娯楽か＜前編＞"
    },
    "entry":
    [
        { "location": "35/TALK"   , "narrator": "ガブリエラ", "text": "はぁ…やっと、\n帰ってこれたわ。"},
        { "location": "36/TALK"   , "narrator": "アーヤ", "text": "暗くなる前には\n帰れると思ったん\nだけどね。"},
        { "location": "37/TALK"   , "narrator": "ガブリエラ", "text": "まったく、神楽が\n勝手なこと\nしてくれたから。"},
        { "location": "39/TALK"   , "narrator": "つばめ", "text": "でも、\n神楽ちゃんは…。"},
        { "location": "40/TALK"   , "narrator": "ガブリエラ", "text": "ああ、はいはい。\nつばめは神楽の味方\nだったわね。"},
        { "location": "42/TALK"   , "narrator": "つばめ", "text": "そういうわけじゃ…。"},
        { "location": "43/TALK"   , "narrator": "ガブリエラ", "text": "敵のあたしは退散する\nから、好きなだけ\n言ってなさいよ。"},
        { "location": "44/TALK"   , "narrator": "アーヤ", "text": "…私も疲れたし、\n報告したら寮に\n戻るわ。"},
        { "location": "45/TALK"   , "narrator": "つばめ", "text": "…………。"},
        { "location": "64/TALK"   , "narrator": "ガブリエラ", "text": "はぁ…まったく、\nやってらんないわ。"},
        { "location": "65/TALK"   , "narrator": "ガブリエラ", "text": "何よ、つばめったら。\nあんなに神楽のこと\n庇って…。"},
        { "location": "66/TALK"   , "narrator": "ガブリエラ", "text": "…つばめがメノウの\nファンなのは\n知ってる。"},
        { "location": "67/TALK"   , "narrator": "ガブリエラ", "text": "でもあたしは\nファンでもなんでも\nないんだから！"},
        { "location": "68/TALK"   , "narrator": "ガブリエラ", "text": "…あたしも、\nもう帰ろうかな？"},
        { "location": "74/TALK"   , "narrator": "雛", "text": "あ～、疲れた。\nやっと終わったねー。"},
        { "location": "76/TALK"   , "narrator": "雛", "text": "…あれ？"},
        { "location": "78/TALK"   , "narrator": "ガブリエラ", "text": "ああ、いたんだ？"},
        { "location": "79/TALK"   , "narrator": "雛", "text": "ガブリエラちゃん！\n帰ってたの？\nおかえりー！"},
        { "location": "82/TALK"   , "narrator": "繭", "text": "…無事だった\nみたいね。"},
        { "location": "83/TALK"   , "narrator": "ガブリエラ", "text": "ええ、まあね。"},
        { "location": "84/TALK"   , "narrator": "ガブリエラ", "text": "…あたし達の代わりに\n劇場のことやって\nくれてたの？"},
        { "location": "85/TALK"   , "narrator": "雛", "text": "あたしだけねー。"},
        { "location": "86/TALK"   , "narrator": "繭", "text": "私はみやび先輩の\n手伝いをしてた。"},
        { "location": "88/TALK"   , "narrator": "ガブリエラ", "text": "みやびの手伝いが\nできるなんて、\n凄いじゃない。"},
        { "location": "90/TALK"   , "narrator": "繭", "text": "別に…簡単な手伝い\nしかしてないし…。"},
        { "location": "91/TALK"   , "narrator": "雛", "text": "それより、聞いたよ。"},
        { "location": "92/TALK"   , "narrator": "雛", "text": "今日のフェノメノン\nってアプリゲームが\n原因なんだって？"},
        { "location": "93/TALK"   , "narrator": "ガブリエラ", "text": "…まあね…。"},
        { "location": "94/TALK"   , "narrator": "雛", "text": "もしかして、この前の\nバグが原因だったり\nする？"},
        { "location": "95/TALK"   , "narrator": "ガブリエラ", "text": "…そうよ。\nやっぱり、被害者が\n出てたみたいね。"},
        { "location": "96/TALK"   , "narrator": "雛", "text": "そうだったんだ…。"},
        { "location": "97/TALK"   , "narrator": "雛", "text": "あの後、すぐに報告\nしたのに。"},
        { "location": "98/TALK"   , "narrator": "雛", "text": "すぐ対応して\nもらえてたら\n違ってたのかな。"},
        { "location": "100/TALK"  , "narrator": "繭", "text": "仕方ない部分は\nあるわ。"},
        { "location": "101/TALK"  , "narrator": "繭", "text": "報告即対応なんて\n神対応の域。"},
        { "location": "102/TALK"  , "narrator": "繭", "text": "簡単にできる\nわけない。"},
        { "location": "104/TALK"  , "narrator": "雛", "text": "そりゃそうだけど、\n結局それが原因で\n炎上しちゃったし。"},
        { "location": "105/TALK"  , "narrator": "雛", "text": "おまけに、\n発症者まで出ちゃった\nわけでしょ？"},
        { "location": "107/TALK"  , "narrator": "ガブリエラ", "text": "そういうことよ。\nなんか、やりきれない\n気持ちになるわ…。"},
        { "location": "109/TALK"  , "narrator": "繭", "text": "は？　何で？"},
        { "location": "111/TALK"  , "narrator": "ガブリエラ", "text": "何でって、あたしが\nもっと真剣に対応する\nように言えば――"},
        { "location": "112/TALK"  , "narrator": "繭", "text": "そんなことする\n必要ないし、\n気にする必要もない。"},
        { "location": "113/TALK"  , "narrator": "繭", "text": "責任があるのは\nバグを生んだ公式と、\n発症者自身だから。"},
        { "location": "115/TALK"  , "narrator": "ガブリエラ", "text": "はぁ？　発症者には\n責任ないでしょ？"},
        { "location": "116/TALK"  , "narrator": "繭", "text": "ある。"},
        { "location": "117/TALK"  , "narrator": "繭", "text": "あのゲームは\nプレイヤー同士が\nネット対戦できる。"},
        { "location": "118/TALK"  , "narrator": "繭", "text": "そういうゲームには、\n即死レベルのバグが\n生じる危険性が伴う。"},
        { "location": "119/TALK"  , "narrator": "繭", "text": "その覚悟もなく\n遊んでた方にも\n責任はあるはず。"},
        { "location": "121/TALK"  , "narrator": "ガブリエラ", "text": "…それはちょっと、\n酷じゃないかしら？"},
        { "location": "122/TALK"  , "narrator": "ガブリエラ", "text": "それに、繭だって\n言ってたじゃない。"},
        { "location": "123/TALK"  , "narrator": "ガブリエラ", "text": "バグの存在を知ってる\nのは数十人くらいだ、\nって。"},
        { "location": "125/TALK"  , "narrator": "繭", "text": "でも、その後すぐに\n炎上して、大勢が\n知ることになった。"},
        { "location": "126/TALK"  , "narrator": "繭", "text": "知ろうと思えば、\n簡単に知ることが\nできたということ。"},
        { "location": "127/TALK"  , "narrator": "繭", "text": "なのにそのバグの\n被害にあった\nわけでしょ。"},
        { "location": "128/TALK"  , "narrator": "繭", "text": "それは\n情報のチェックを\n怠っていたってこと。"},
        { "location": "129/TALK"  , "narrator": "雛", "text": "んー。\n責任って言い方は\nしっくりこないけど。"},
        { "location": "130/TALK"  , "narrator": "雛", "text": "発症者になっちゃう\nくらい、熱を入れてた\nゲームなんでしょ？"},
        { "location": "132/TALK"  , "narrator": "繭", "text": "それなのに情報の\nチェックしてないって\nいうのが不思議。"},
        { "location": "134/TALK"  , "narrator": "繭", "text": "ウェブ情報を\n制覇する者は\nこの世を制する。"},
        { "location": "135/TALK"  , "narrator": "繭", "text": "情弱はこの世から\n排除される。\nそれがネットの世界。"},
        { "location": "136/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "137/TALK"  , "narrator": "ガブリエラ", "text": "でも、もしもあの時、\nあたしが運営会社に\n電話してたら…。"},
        { "location": "139/TALK"  , "narrator": "ガブリエラ", "text": "ううん、電話しても\nすぐにどうなるかは\nわからないか。"},
        { "location": "140/TALK"  , "narrator": "ガブリエラ", "text": "でも、すぐに\n対処して\nくれていたら。"},
        { "location": "142/TALK"  , "narrator": "ガブリエラ", "text": "発症せずに\nすんだ可能性は\nあるわけよね…。"},
        { "location": "143/TALK"  , "narrator": "ガブリエラ", "text": "…今更そんなこと\n思ったって、後悔しか\nできないけど…。"},
        { "location": "214/TALK"  , "narrator": "ガブリエラ", "text": "あ、$handle$！\nいらっしゃい！"},
        { "location": "215/TALK"  , "narrator": "ガブリエラ", "text": "今日も元気に\n検索しちゃうわね！"},
        { "location": "216/SEL"   , "narrator": "", "text": "いつも元気だね"},
        { "location": "217/ACT"   , "narrator": "", "text": "いつも元気だね"},
        { "location": "219/TALK"  , "narrator": "ガブリエラ", "text": "もちろんよ。"},
        { "location": "220/TALK"  , "narrator": "ガブリエラ", "text": "あたしが元気でいなければ\n現実のあたしも元気が\nなくなっちゃうもの。"},
        { "location": "221/TALK"  , "narrator": "ガブリエラ", "text": "それじゃ\n張り切っていくわよ。"},
        { "location": "228/TALK"  , "narrator": "ガブリエラ", "text": "オープンプロセス、\n0x58F番地から\n0x224番地へ。"},
        { "location": "243/TALK"  , "narrator": "ガブリエラ", "text": "シーク完了っ♪"},
        { "location": "247/TALK"  , "narrator": "ガブリエラ", "text": "それで、\n今回のあたしの\n総意は……っと。"},
        { "location": "248/TALK"  , "narrator": "ガブリエラ", "text": "……んー、なるほど。"},
        { "location": "249/TALK"  , "narrator": "ガブリエラ", "text": "まあ、そうよねぇ。"},
        { "location": "250/SEL"   , "narrator": "", "text": "何が？"},
        { "location": "251/ACT"   , "narrator": "", "text": "何が？"},
        { "location": "253/TALK"  , "narrator": "ガブリエラ", "text": "バグに気づいたけど運営に\n報告しなかった事を気に\nしてるあたしがいるのよ。"},
        { "location": "254/TALK"  , "narrator": "ガブリエラ", "text": "$handle$は\nどう思う？"},
        { "location": "255/SEL"   , "narrator": "", "text": "報告すべきだと思う"},
        { "location": "256/SEL"   , "narrator": "", "text": "運営の責任なんだからしなくても悪くない"},
        { "location": "257/ACT"   , "narrator": "", "text": "報告すべきだと思う"},
        { "location": "258/TALK"  , "narrator": "ガブリエラ", "text": "まあ、すてきね！"},
        { "location": "259/TALK"  , "narrator": "ガブリエラ", "text": "でもそれは、自分にとって\nいいことがあるから？\nそれとも義務ってこと？"},
        { "location": "260/SEL"   , "narrator": "", "text": "報告すれば快適に遊べるようになるよ"},
        { "location": "261/SEL"   , "narrator": "", "text": "報告は義務だと思う"},
        { "location": "262/ACT"   , "narrator": "", "text": "報告すれば快適に遊べるようになるよ"},
        { "location": "263/TALK"  , "narrator": "ガブリエラ", "text": "確かにそうね。\n運営が頑張れば、だけど。"},
        { "location": "264/TALK"  , "narrator": "ガブリエラ", "text": "でもそれと、今あたしが\n抱えている罪悪感は\n全然別物よね。"},
        { "location": "265/ACT"   , "narrator": "", "text": "報告は義務だと思う"},
        { "location": "266/TALK"  , "narrator": "ガブリエラ", "text": "すごいわね！"},
        { "location": "267/TALK"  , "narrator": "ガブリエラ", "text": "$handle$のような\n人が、ゲームを支えて\nいるのかもしれないわね。"},
        { "location": "268/TALK"  , "narrator": "ガブリエラ", "text": "とはいえ、もしそうでも\n罪悪感を抱くのとは\nちょっと違うと思うのよ。"},
        { "location": "270/ACT"   , "narrator": "", "text": "運営の責任なんだからしなくても悪くない"},
        { "location": "271/TALK"  , "narrator": "ガブリエラ", "text": "そうね、その通り。\nあたしと同じ考えね。"},
        { "location": "272/TALK"  , "narrator": "ガブリエラ", "text": "遊んでる側が\n罪悪感を抱くような\n理由なんて無いのよ。"},
        { "location": "273/TALK"  , "narrator": "ガブリエラ", "text": "ちゃんと作った人が\n責任持って直さなくちゃ。"},
        { "location": "275/TALK"  , "narrator": "ガブリエラ", "text": "だから、今回も迷いを\n晴らすのを手伝って\nもらえないかしら。"},
        { "location": "276/TALK"  , "narrator": "ガブリエラ", "text": "そうしないと、今後\n純粋にゲームを楽しむ事が\nできなくなっちゃう。"},
        { "location": "277/TALK"  , "narrator": "ガブリエラ", "text": "というわけで、\nよろしくお願いね。"},
        { "location": "278/TALK"  , "narrator": "ガブリエラ", "text": "あたしと\n$handle$にとって\n素敵なココロの旅を！"},
        { "location": "33/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>7月24日　7:59 PM</color>\nフェノメノン戦終了後、神楽坂トライナリー劇場にて。"},
        { "location": "173/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "175/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "177/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "179/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "181/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"}
    ]
}
