{
    "dir": "chap37/daydra/dd_ch04_37_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "37405",
        "cid": "miyabi",
        "title": "005 メインストーリー",
        "sub_title": "たったひとつの＜後編＞"
    },
    "entry":
    [
        { "location": "708/TALK"  , "narrator": "みやび", "text": "運命とか。\n大げさな言葉は\n嫌いやけんど。"},
        { "location": "709/TALK"  , "narrator": "みやび", "text": "この判決は運命と\n呼ぶしかないろうね。"},
        { "location": "711/SEL"   , "narrator": "", "text": "元気？"},
        { "location": "712/SEL"   , "narrator": "", "text": "少し話せる？"},
        { "location": "713/SEL"   , "narrator": "", "text": "$me$を恨んでる？"},
        { "location": "714/ACT"   , "narrator": "", "text": "元気？"},
        { "location": "715/TALK"  , "narrator": "みやび", "text": "どう思う？"},
        { "location": "716/ACT"   , "narrator": "", "text": "少し話せる？"},
        { "location": "717/TALK"  , "narrator": "みやび", "text": "それはどうかいね？"},
        { "location": "718/ACT"   , "narrator": "", "text": "$me$を恨んでる？"},
        { "location": "719/TALK"  , "narrator": "みやび", "text": "聞く必要はないろう。"},
        { "location": "722/SEL"   , "narrator": "", "text": "元気？"},
        { "location": "723/SEL"   , "narrator": "", "text": "少し話せる？"},
        { "location": "724/SEL"   , "narrator": "", "text": "$me$を恨んでる？"},
        { "location": "725/ACT"   , "narrator": "", "text": "元気？"},
        { "location": "726/TALK"  , "narrator": "みやび", "text": "$handle$と\nこうやって話が\nできる程度には。"},
        { "location": "727/ACT"   , "narrator": "", "text": "少し話せる？"},
        { "location": "728/TALK"  , "narrator": "みやび", "text": "そうやね。\nうちも話したい\nことがあるき。"},
        { "location": "729/ACT"   , "narrator": "", "text": "$me$を恨んでる？"},
        { "location": "730/TALK"  , "narrator": "みやび", "text": "またまた。\nわかっとるくせに。"},
        { "location": "733/TALK"  , "narrator": "みやび", "text": "この先がまだ\n確定せんうちに。"},
        { "location": "734/TALK"  , "narrator": "みやび", "text": "$handle$に\n言っておきたい\nことがある。"},
        { "location": "735/SEL"   , "narrator": "", "text": "何だろう？"},
        { "location": "736/SEL"   , "narrator": "", "text": "期待していい？"},
        { "location": "737/SEL"   , "narrator": "", "text": "あんまり聞きたくないな…"},
        { "location": "738/ACT"   , "narrator": "", "text": "何だろう？"},
        { "location": "739/TALK"  , "narrator": "みやび", "text": "わからんかねえ？"},
        { "location": "740/ACT"   , "narrator": "", "text": "期待していい？"},
        { "location": "741/TALK"  , "narrator": "みやび", "text": "思い切り\nしてええき。"},
        { "location": "742/ACT"   , "narrator": "", "text": "あんまり聞きたくないな…"},
        { "location": "743/TALK"  , "narrator": "みやび", "text": "まあそう言わんと\n聞いたらえいき。"},
        { "location": "745/TALK"  , "narrator": "みやび", "text": "うちがトライナリーに\n加わったんは、\nなごちゃんのため。"},
        { "location": "746/TALK"  , "narrator": "みやび", "text": "…というのはつばめが\nねつ造したうちの\n過去やけんど。"},
        { "location": "747/TALK"  , "narrator": "みやび", "text": "それが明らかに\nなる前のうちは\nそう固く信じとった。"},
        { "location": "748/TALK"  , "narrator": "みやび", "text": "やき、うちは\n他の子たちと\n馴れ合う気はなかった。"},
        { "location": "749/TALK"  , "narrator": "みやび", "text": "むしろ全員敵くらいに\n思うちょった。"},
        { "location": "750/TALK"  , "narrator": "みやび", "text": "ほいてそれを\n悟られるわけには\nいかんかった。"},
        { "location": "751/TALK"  , "narrator": "みやび", "text": "そういや\n相棒のことは一番\n疑うちょったね。"},
        { "location": "752/TALK"  , "narrator": "みやび", "text": "すまんかった。"},
        { "location": "753/SEL"   , "narrator": "", "text": "いや別に"},
        { "location": "754/SEL"   , "narrator": "", "text": "今はラブラブだから平気"},
        { "location": "755/SEL"   , "narrator": "", "text": "そんなこともあったね"},
        { "location": "756/ACT"   , "narrator": "", "text": "いや別に"},
        { "location": "757/TALK"  , "narrator": "みやび", "text": "相棒は心が広いねえ。"},
        { "location": "758/ACT"   , "narrator": "", "text": "今はラブラブだから平気"},
        { "location": "759/TALK"  , "narrator": "みやび", "text": "闇雲すぎるほどに\nポジティブやねえ。"},
        { "location": "760/ACT"   , "narrator": "", "text": "そんなこともあったね"},
        { "location": "761/TALK"  , "narrator": "みやび", "text": "もちろん\n今は違うけんど。"},
        { "location": "763/TALK"  , "narrator": "みやび", "text": "疑心暗鬼だったうちを\n見守ってくれたんは\n$handle$やった。"},
        { "location": "764/TALK"  , "narrator": "みやび", "text": "そのおかげでうちは\n少し人を信じることを\n憶えられたと思う。"},
        { "location": "765/TALK"  , "narrator": "みやび", "text": "人に背中を預けることを\n憶えられたと思う。"},
        { "location": "766/TALK"  , "narrator": "みやび", "text": "いくら感謝しても\nし足りん。\nありがとう。"},
        { "location": "767/SEL"   , "narrator": "", "text": "いえいえ"},
        { "location": "768/SEL"   , "narrator": "", "text": "どういたしまして"},
        { "location": "769/SEL"   , "narrator": "", "text": "元々みやびは素直だったよ"},
        { "location": "770/ACT"   , "narrator": "", "text": "いえいえ"},
        { "location": "771/TALK"  , "narrator": "みやび", "text": "もっとドヤ顔を\nしてくるかと\n思うちょったけんど。"},
        { "location": "772/TALK"  , "narrator": "みやび", "text": "そう改まられると\n調子が狂う。"},
        { "location": "773/ACT"   , "narrator": "", "text": "どういたしまして"},
        { "location": "774/TALK"  , "narrator": "みやび", "text": "本当に感謝する。"},
        { "location": "775/ACT"   , "narrator": "", "text": "元々みやびは素直だったよ"},
        { "location": "776/TALK"  , "narrator": "みやび", "text": "…それは\n$handle$の\n買い被りぞね。"},
        { "location": "778/TALK"  , "narrator": "みやび", "text": "今こうやって\n話ができるんも。"},
        { "location": "779/TALK"  , "narrator": "みやび", "text": "想定外と\n不確定要素の\n積み重ねの結果ぞね。"},
        { "location": "780/TALK"  , "narrator": "みやび", "text": "この先世界が\n軌道修正して\n新しうなったら。"},
        { "location": "781/TALK"  , "narrator": "みやび", "text": "こんなことももう\nできんかもしれんぞね。"},
        { "location": "782/TALK"  , "narrator": "みやび", "text": "けんどうちは\n信じとるき。"},
        { "location": "783/TALK"  , "narrator": "みやび", "text": "$handle$が\nずっとうちの側に\nいてくれることを。"},
        { "location": "784/TALK"  , "narrator": "みやび", "text": "うちが魂だけになっても\n相棒がうちを\n見失わんことを。"},
        { "location": "785/TALK"  , "narrator": "みやび", "text": "……これって\n何なんやろうね？"},
        { "location": "786/TALK"  , "narrator": "みやび", "text": "愛とか恋とか\nそういう次元は\nとっくに超えた何か。"},
        { "location": "787/TALK"  , "narrator": "みやび", "text": "存在自体がうちで\nうちが$handle$\nみたいな。"},
        { "location": "788/TALK"  , "narrator": "みやび", "text": "……大げさに\n思うとる？"},
        { "location": "789/TALK"  , "narrator": "みやび", "text": "うちはしょうまっこと\nそういう気持ちで\nおるき。"},
        { "location": "790/TALK"  , "narrator": "みやび", "text": "いや、違うねえ。"},
        { "location": "791/TALK"  , "narrator": "みやび", "text": "言葉にできんくらい\nもっと大きい気持ちで\nそう思うとるき。"},
        { "location": "792/TALK"  , "narrator": "みやび", "text": "$handle$も\nそういう気持ちやと\n信じとるき。"},
        { "location": "793/TALK"  , "narrator": "みやび", "text": "…違うかねえ？"},
        { "location": "795/SEL"   , "narrator": "", "text": "愛してる。ずっと一緒だから"},
        { "location": "796/SEL"   , "narrator": "", "text": "これからも共に支え合っていこう"},
        { "location": "797/SEL"   , "narrator": "", "text": "これからも頑張ってね"},
        { "location": "798/SEL"   , "narrator": "", "text": "役に立てて良かったよ"},
        { "location": "799/ACT"   , "narrator": "", "text": "愛してる。ずっと一緒だから"},
        { "location": "800/TALK"  , "narrator": "みやび", "text": "…光栄やき。"},
        { "location": "801/ACT"   , "narrator": "", "text": "これからも共に支え合っていこう"},
        { "location": "802/TALK"  , "narrator": "みやび", "text": "…やね。"},
        { "location": "803/ACT"   , "narrator": "", "text": "これからも頑張ってね"},
        { "location": "804/TALK"  , "narrator": "みやび", "text": "$handle$も\nがんばれ。\nばかちんが。"},
        { "location": "805/ACT"   , "narrator": "", "text": "役に立てて良かったよ"},
        { "location": "806/TALK"  , "narrator": "みやび", "text": "過去形か。\nツンデレめ。"},
        { "location": "809/SEL"   , "narrator": "", "text": "愛してる。ずっと一緒だから"},
        { "location": "810/SEL"   , "narrator": "", "text": "これからも共に支え合っていこう"},
        { "location": "811/SEL"   , "narrator": "", "text": "これからも頑張ってね"},
        { "location": "812/SEL"   , "narrator": "", "text": "役に立てて良かったよ"},
        { "location": "813/ACT"   , "narrator": "", "text": "愛してる。ずっと一緒だから"},
        { "location": "814/TALK"  , "narrator": "みやび", "text": "愛か。"},
        { "location": "815/TALK"  , "narrator": "みやび", "text": "そんな次元を超えて\n一緒やと言うとるのに。"},
        { "location": "816/ACT"   , "narrator": "", "text": "これからも共に支え合っていこう"},
        { "location": "817/TALK"  , "narrator": "みやび", "text": "共に、というのが\n$handle$らしいね。"},
        { "location": "818/ACT"   , "narrator": "", "text": "これからも頑張ってね"},
        { "location": "819/TALK"  , "narrator": "みやび", "text": "こらこらこらこら。"},
        { "location": "820/TALK"  , "narrator": "みやび", "text": "$handle$も一緒に\n頑張ってくれんと。"},
        { "location": "821/ACT"   , "narrator": "", "text": "役に立てて良かったよ"},
        { "location": "822/TALK"  , "narrator": "みやび", "text": "なかなかに食えんねえ。\nそういうところも\nええけんど。"},
        { "location": "824/TALK"  , "narrator": "みやび", "text": "$handle$にとっては\n当たり前やったかも\nしれんけんど。"},
        { "location": "825/TALK"  , "narrator": "みやび", "text": "うちを選択して\nくれたんは。"},
        { "location": "826/TALK"  , "narrator": "みやび", "text": "涙が出そうなほど\nうれしかったぞね。"},
        { "location": "829/TALK"  , "narrator": "みやび", "text": "この世界の歪みは\n大きゅうなりすぎた。"},
        { "location": "830/TALK"  , "narrator": "みやび", "text": "やき、相棒の選択は\n実現されんかも\nしれんらしいね。"},
        { "location": "831/TALK"  , "narrator": "みやび", "text": "けんど、それでも\n$handle$は\n真剣に悩んでくれた。"},
        { "location": "832/TALK"  , "narrator": "みやび", "text": "そうしてこの世界を\n繋げていくために\n一票を投じた。"},
        { "location": "833/TALK"  , "narrator": "みやび", "text": "白紙委任も棄権もせず\n決めてくれた。"},
        { "location": "834/TALK"  , "narrator": "みやび", "text": "そう簡単にできる\nことではないと\n思うとる。"},
        { "location": "835/TALK"  , "narrator": "みやび", "text": "そのことにも感謝する。\nありがとう。"},
        { "location": "836/TALK"  , "narrator": "みやび", "text": "そしてその結果が\nどうやったとしても。"},
        { "location": "837/TALK"  , "narrator": "みやび", "text": "うちはそれが\nベストやと信じとる。"},
        { "location": "838/TALK"  , "narrator": "みやび", "text": "うちにとっても\n世界にとっても。"},
        { "location": "841/SEL"   , "narrator": "", "text": "$me$のこと信じてて"},
        { "location": "842/SEL"   , "narrator": "", "text": "みやびの幸せしか考えてないから"},
        { "location": "843/SEL"   , "narrator": "", "text": "ありがとう。愛してる"},
        { "location": "844/ACT"   , "narrator": "", "text": "$me$のこと信じてて"},
        { "location": "845/TALK"  , "narrator": "みやび", "text": "…そうやね。"},
        { "location": "846/ACT"   , "narrator": "", "text": "みやびの幸せしか考えてないから"},
        { "location": "847/TALK"  , "narrator": "みやび", "text": "…それはうち全体の\n幸せやろう？"},
        { "location": "848/ACT"   , "narrator": "", "text": "ありがとう。愛してる"},
        { "location": "849/TALK"  , "narrator": "みやび", "text": "さようなら。"},
        { "location": "852/SEL"   , "narrator": "", "text": "$me$のこと信じてて"},
        { "location": "853/SEL"   , "narrator": "", "text": "みやびの幸せしか考えてないから"},
        { "location": "854/SEL"   , "narrator": "", "text": "ありがとう。愛してる"},
        { "location": "855/ACT"   , "narrator": "", "text": "$me$のこと信じてて"},
        { "location": "856/TALK"  , "narrator": "みやび", "text": "やき、信じとると\n言うちょるき。"},
        { "location": "857/TALK"  , "narrator": "みやび", "text": "$handle$は\n心配しいやねえ。"},
        { "location": "858/ACT"   , "narrator": "", "text": "みやびの幸せしか考えてないから"},
        { "location": "859/TALK"  , "narrator": "みやび", "text": "うちは$handle$の\n幸せしか考えとらんよ。"},
        { "location": "860/TALK"  , "narrator": "みやび", "text": "えい勝負やね。\nうちらは。"},
        { "location": "861/ACT"   , "narrator": "", "text": "ありがとう。愛してる"},
        { "location": "862/TALK"  , "narrator": "みやび", "text": "うちの愛は\nテラバイト単位ぞね。"},
        { "location": "863/TALK"  , "narrator": "みやび", "text": "感謝も同等やき。"},
        { "location": "867/TALK"  , "narrator": "みやび", "text": "ああ、えいことを\n思いついた。"},
        { "location": "868/TALK"  , "narrator": "みやび", "text": "今度会うた時は\n高知の海で\nデートしよう。"},
        { "location": "869/TALK"  , "narrator": "みやび", "text": "心配せんでも\n魂同士なら\n一瞬で着けるろう。"},
        { "location": "870/TALK"  , "narrator": "みやび", "text": "魂だけになったら\n溺れる心配もないき。"},
        { "location": "871/TALK"  , "narrator": "みやび", "text": "一日中、\n波打ち際を……。"},
