        { "location": "4225/SCENARIO", "narrator": "", "text": "回廊怪談"},
        { "location": "4250/TALK"    , "narrator": "神楽", "text": "人って見かけによらなすぎる"},
        { "location": "4251/TALK"    , "narrator": "神楽", "text": "アーヤさん、怪談とかホラーとかもんのすごく苦手みたい"},
        { "location": "4253/SEL"     , "narrator": "", "text": "それは意外"},
        { "location": "4254/SEL"     , "narrator": "", "text": "色々あるんだよ…"},
        { "location": "4255/SEL"     , "narrator": "", "text": "神楽は平気なの？"},
        { "location": "4256/ACT"     , "narrator": "", "text": "それは意外"},
        { "location": "4257/TALK"    , "narrator": "神楽", "text": "でしょ"},
        { "location": "4258/ACT"     , "narrator": "", "text": "色々あるんだよ…"},
        { "location": "4259/TALK"    , "narrator": "神楽", "text": "何か知ってる風に言っちゃって"},
        { "location": "4260/ACT"     , "narrator": "", "text": "神楽は平気なの？"},
        { "location": "4262/TALK"    , "narrator": "神楽", "text": "あれ心配してくれてるの$handlek$"},
        { "location": "4264/TALK"    , "narrator": "神楽", "text": "ひょっとして$handlek$って優しい人なの？"},
        { "location": "4265/TALK"    , "narrator": "神楽", "text": "ぴょんこ照れちゃう♪"},
        { "location": "4267/TALK"    , "narrator": "神楽", "text": "そんなだから映画館の当番もホラーの日なんかは代わってもらったりしてるみたいぴょん"},
        { "location": "4268/TALK"    , "narrator": "神楽", "text": "どんだけよ？"},
        { "location": "4270/SEL"     , "narrator": "", "text": "そんなにダメなんだ"},
        { "location": "4271/SEL"     , "narrator": "", "text": "うん、あれは仕方ないよ"},
        { "location": "4272/SEL"     , "narrator": "", "text": "神楽も怖いなら$me$がどうにかする"},
        { "location": "4273/ACT"     , "narrator": "", "text": "そんなにダメなんだ"},
        { "location": "4274/TALK"    , "narrator": "神楽", "text": "すごすぎじゃない？"},
        { "location": "4275/TALK"    , "narrator": "神楽", "text": "そこまでだったら逆になんか仕掛けたくなるよね"},
        { "location": "4276/TALK"    , "narrator": "神楽", "text": "後が面倒くさそうだからやらないけど★"},
        { "location": "4277/ACT"     , "narrator": "", "text": "うん、あれは仕方ないよ"},
        { "location": "4278/TALK"    , "narrator": "神楽", "text": "なんか含んでるー！"},
        { "location": "4279/TALK"    , "narrator": "神楽", "text": "$me$知ってるアピールとか！"},
        { "location": "4280/TALK"    , "narrator": "神楽", "text": "感じ悪ーい！"},
        { "location": "4281/ACT"     , "narrator": "", "text": "神楽も怖いなら$me$がどうにかする"},
        { "location": "4283/TALK"    , "narrator": "神楽", "text": "ぴょんこは全然平気だから"},
        { "location": "4285/TALK"    , "narrator": "神楽", "text": "気にしないで☆彡"},
        { "location": "4286/TALK"    , "narrator": "神楽", "text": "でも$handlek$ったら頼りになるー！"},
