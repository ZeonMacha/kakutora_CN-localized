{
    "dir": "chap15/daydra/dd_ch01_15_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "15102",
        "cid": "tsubame",
        "title": "002 メインストーリー",
        "sub_title": "薄い本の森＜前編＞"
    },
    "entry":
    [
        { "location": "31/TALK"   , "narrator": "神楽", "text": "つばめさん！\nこの本なんか\nすごくいいですよ！"},
        { "location": "32/TALK"   , "narrator": "神楽", "text": "このサークルの本は\nどれもオススメなん\nですけど――"},
        { "location": "33/TALK"   , "narrator": "神楽", "text": "特にこの新刊は\nサービスシーン\n満載なんです！"},
        { "location": "35/TALK"   , "narrator": "つばめ", "text": "ちょ！？　この本、\n表紙が裸の女の子\nなんだけど！？"},
        { "location": "37/TALK"   , "narrator": "神楽", "text": "何言ってるんですか。\nちゃんと水着を\n着てますよ？"},
        { "location": "38/TALK"   , "narrator": "つばめ", "text": "これ水着なの！？\n紐にしか見えないん\nだけど…。"},
        { "location": "40/TALK"   , "narrator": "神楽", "text": "じゃあ、こっちの本は\nどうですか？"},
        { "location": "41/TALK"   , "narrator": "つばめ", "text": "…それは普通の\n漫画かな？"},
        { "location": "42/TALK"   , "narrator": "神楽", "text": "表紙だけだと\nそう見えますけど、\n中身は――"},
        { "location": "43/TALK"   , "narrator": "つばめ", "text": "も、もういいよぉ！"},
        { "location": "45/TALK"   , "narrator": "神楽", "text": "つばめさん、ちょっと\n耐性なさ過ぎですよっ！"},
        { "location": "46/TALK"   , "narrator": "神楽", "text": "可愛いですけど、\nそれじゃ秋葉原では\n生きていけません！"},
        { "location": "49/TALK"   , "narrator": "つばめ", "text": "卯月さんは\n慣れ過ぎだと\n思うんだけどなぁ…。"},
        { "location": "50/TALK"   , "narrator": "つばめ", "text": "っていうか、\n思ったことが\nあるんだけど――"},
        { "location": "51/TALK"   , "narrator": "つばめ", "text": "卯月さんは、\nこういう本\n持ってるの？"},
        { "location": "52/TALK"   , "narrator": "神楽", "text": "いえ、私も買ったことは\nないんです。"},
        { "location": "53/TALK"   , "narrator": "神楽", "text": "でも、こういう本がある、\nっていうのは、前から\n知ってたので。"},
        { "location": "54/TALK"   , "narrator": "つばめ", "text": "そうなんだ？\nちょっと安心したかも…。"},
        { "location": "55/TALK"   , "narrator": "つばめ", "text": "でも、あれ？\nそれならどうして\nこのお店に来たの？"},
        { "location": "57/TALK"   , "narrator": "神楽", "text": "もちろん、つばめさんを\nビックリさせるためです。"},
        { "location": "58/TALK"   , "narrator": "神楽", "text": "二人で来る初めての\n秋葉原ですからね。"},
        { "location": "59/TALK"   , "narrator": "神楽", "text": "ずっと忘れられない、\n思い出に残るようなものに\nしたかったんです。"},
        { "location": "60/TALK"   , "narrator": "つばめ", "text": "もう十分忘れられない\n思い出になったと思うよ。"},
        { "location": "61/TALK"   , "narrator": "神楽", "text": "そうですか？\nまあ、つばめさんが\nそういうなら…。"},
        { "location": "63/TALK"   , "narrator": "神楽", "text": "あっ！"},
        { "location": "64/TALK"   , "narrator": "つばめ", "text": "どうしたの？"},
        { "location": "65/TALK"   , "narrator": "神楽", "text": "えっと…実は、とっても\nおすすめな本があるのを\n思い出したんです。"},
        { "location": "66/TALK"   , "narrator": "神楽", "text": "探してきますから、\nちょっとだけ\n待っててくださいね。"},
        { "location": "69/TALK"   , "narrator": "つばめ", "text": "えっ！？\nちょっと、卯月さん！"},
        { "location": "71/TALK"   , "narrator": "つばめ", "text": "…こんなところに\n一人だけ残されても、\n困るんだけど…。"},
        { "location": "75/TALK"   , "narrator": "つばめ", "text": "うぅ、どっちを\n見てもエッチな本\nばっかり…。"},
        { "location": "78/TALK"   , "narrator": "つばめ", "text": "…………。"},
        { "location": "80/TALK"   , "narrator": "つばめ", "text": "でも、凄いなぁ…。"},
        { "location": "81/TALK"   , "narrator": "つばめ", "text": "これ全部、そういう\n本だなんて…"},
        { "location": "82/SEL"    , "narrator": "", "text": "もしかして、興味ある？"},
        { "location": "83/ACT"    , "narrator": "", "text": "もしかして、興味ある？"},
        { "location": "100/TALK"  , "narrator": "つばめ", "text": "興味ってなに！？(ﾟ△ﾟ;ﾉ)ﾉ"},
        { "location": "102/SEL"   , "narrator": "", "text": "読みたいのかな、と…"},
        { "location": "103/ACT"   , "narrator": "", "text": "読みたいのかな、と…"},
        { "location": "105/TALK"  , "narrator": "つばめ", "text": "違ぅよ！(´ｪ｀；)三(；´ｪ｀)"},
        { "location": "107/TALK"  , "narrator": "つばめ", "text": "わたし"},
        { "location": "108/TALK"  , "narrator": "つばめ", "text": "そんなこと思ってなぃよo(*･ﾛ･*)o、"},
        { "location": "109/TALK"  , "narrator": "つばめ", "text": "ただ"},
        { "location": "110/TALK"  , "narrator": "つばめ", "text": "こんなにたくさん"},
        { "location": "111/TALK"  , "narrator": "つばめ", "text": "そぅぃぅ本に囲まれたことなぃから(/ω＼)"},
        { "location": "112/TALK"  , "narrator": "つばめ", "text": "ちょっと"},
        { "location": "115/TALK"  , "narrator": "つばめ", "text": "緊張？"},
        { "location": "118/TALK"  , "narrator": "つばめ", "text": "ぅぅん"},
        { "location": "119/TALK"  , "narrator": "つばめ", "text": "ちょっと違ぅかも(･Д･｀)"},
        { "location": "120/TALK"  , "narrator": "つばめ", "text": "困る？"},
        { "location": "121/TALK"  , "narrator": "つばめ", "text": "それが近ぃかも(*´︶`*)"},
        { "location": "123/TALK"  , "narrator": "つばめ", "text": "でも"},
        { "location": "126/TALK"  , "narrator": "つばめ", "text": "でも"},
        { "location": "127/TALK"  , "narrator": "つばめ", "text": "卯月さん"},
        { "location": "128/TALK"  , "narrator": "つばめ", "text": "とっても楽しそぅだった(≧艸≦*)"},
        { "location": "131/TALK"  , "narrator": "つばめ", "text": "ちょっとだけ"},
        { "location": "133/TALK"  , "narrator": "つばめ", "text": "読んでみよぅかな？(●´ω｀●)ゞｴﾍﾍ"},
        { "location": "134/TALK"  , "narrator": "つばめ", "text": "読んでみたら"},
        { "location": "135/TALK"  , "narrator": "つばめ", "text": "そんなにえっちじゃないかもしれないしヾ(｡>﹏<｡)ﾉﾞ"},
        { "location": "136/TALK"  , "narrator": "つばめ", "text": "卯月さんと"},
        { "location": "137/TALK"  , "narrator": "つばめ", "text": "一緒に話せること"},
        { "location": "138/TALK"  , "narrator": "つばめ", "text": "増ぇるし(灬・ω・灬)"},
        { "location": "141/TALK"  , "narrator": "つばめ", "text": "でもちょっと"},
        { "location": "144/TALK"  , "narrator": "つばめ", "text": "ぅ～ん"},
        { "location": "244/TALK"  , "narrator": "アーヤ", "text": "こんにちは、\n$handle$さん。"},
        { "location": "247/TALK"  , "narrator": "アーヤ", "text": "また会えたわね。"},
        { "location": "250/SEL"   , "narrator": "", "text": "なんでアーヤがいるの！？"},
        { "location": "251/ACT"   , "narrator": "", "text": "なんでアーヤがいるの！？"},
        { "location": "253/TALK"  , "narrator": "アーヤ", "text": "ビックリしたでしょ？"},
        { "location": "254/TALK"  , "narrator": "アーヤ", "text": "ココロの中でもみんなと\n親睦を深めようと思って、\n回ってみることにしたの。"},
        { "location": "255/TALK"  , "narrator": "アーヤ", "text": "せっかく\n行き来できるように\nなったんだしね。"},
        { "location": "256/SEL"   , "narrator": "", "text": "ココロの中って行き来出来るの！？"},
        { "location": "257/ACT"   , "narrator": "", "text": "ココロの中って行き来出来るの！？"},
        { "location": "259/TALK"  , "narrator": "アーヤ", "text": "実は私も驚いてる。"},
        { "location": "260/TALK"  , "narrator": "アーヤ", "text": "いつの間にか、\n普通に行き来できるように\nなっていたのよね。"},
        { "location": "261/TALK"  , "narrator": "アーヤ", "text": "とはいっても、\n[ココロゲート]まで\nみたいだけど。"},
        { "location": "262/TALK"  , "narrator": "アーヤ", "text": "だから今回は、みんなの\n[ココロゲート]にお邪魔\nしようかと思ってる。"},
        { "location": "263/TALK"  , "narrator": "アーヤ", "text": "よろしくね。"},
        { "location": "264/SEL"   , "narrator": "", "text": "なんか不思議な感じ"},
        { "location": "265/SEL"   , "narrator": "", "text": "なんか怖い"},
        { "location": "266/ACT"   , "narrator": "", "text": "なんか不思議な感じ"},
        { "location": "267/TALK"  , "narrator": "アーヤ", "text": "ほんとね。\n$chrname$の心の中に私が\nいるのはちょっと変かも。"},
        { "location": "268/ACT"   , "narrator": "", "text": "なんか怖い"},
        { "location": "269/TALK"  , "narrator": "アーヤ", "text": "そうなの？"},
        { "location": "270/TALK"  , "narrator": "アーヤ", "text": "まあ確かに、他の人の\n心の中を侵蝕している\nようにも見えるけど。"},
        { "location": "271/TALK"  , "narrator": "アーヤ", "text": "でも、扉の外はパブリック\nスペースだから、\nプライバシーは守られる。"},
        { "location": "272/TALK"  , "narrator": "アーヤ", "text": "私も最初はちょっと\n怖かったけど、そんな感じ\nだから心配しないで。"},
        { "location": "275/TALK"  , "narrator": "アーヤ", "text": "ところで、つばめの司書が\n見当たらないんだけど、\nどこにいるか知らない？"},
        { "location": "276/SEL"   , "narrator": "", "text": "更迭されました"},
        { "location": "277/ACT"   , "narrator": "", "text": "更迭されました"},
        { "location": "280/TALK"  , "narrator": "アーヤ", "text": "え！？\nなにそれ！\nそんな事ってあるの？"},
        { "location": "281/TALK"  , "narrator": "アーヤ", "text": "それじゃ、これから\nつばめにココロの司書は\nいないってこと？"},
        { "location": "282/SEL"   , "narrator": "", "text": "新しい司書が来るらしいよ"},
        { "location": "283/ACT"   , "narrator": "", "text": "新しい司書が来るらしいよ"},
        { "location": "285/TALK"  , "narrator": "アーヤ", "text": "そうなのね。\n本当に、\n人のココロそれぞれね。"},
        { "location": "286/TALK"  , "narrator": "アーヤ", "text": "そんなことが\nあるなんて、夢にも\n思わなかったわ。"},
        { "location": "287/TALK"  , "narrator": "アーヤ", "text": "でも、そうしたら\n困ったわね。"},
        { "location": "288/TALK"  , "narrator": "アーヤ", "text": "私はつばめの司書に\n挨拶に来たのにいないし。"},
        { "location": "289/TALK"  , "narrator": "アーヤ", "text": "貴方はきっと、現実の\nつばめが悩んでるから\nここに来てるんでしょ？"},
        { "location": "290/SEL"   , "narrator": "", "text": "そう"},
        { "location": "291/ACT"   , "narrator": "", "text": "そう"},
        { "location": "293/TALK"  , "narrator": "アーヤ", "text": "でも、司書がいなくちゃ\n扉も呼べないものね。"},
        { "location": "294/TALK"  , "narrator": "アーヤ", "text": "んー……"},
        { "location": "295/TALK"  , "narrator": "アーヤ", "text": "あ、そうだ！\n私が検索してみようか？\nつばめのココロの扉。"},
        { "location": "296/SEL"   , "narrator": "", "text": "出来るの！？"},
        { "location": "297/SEL"   , "narrator": "", "text": "危険だからやめて！"},
        { "location": "298/ACT"   , "narrator": "", "text": "出来るの！？"},
        { "location": "299/TALK"  , "narrator": "アーヤ", "text": "ええ、多分。"},
        { "location": "300/TALK"  , "narrator": "アーヤ", "text": "ネットワークが\n切り替わってる\nハズだから……。"},
        { "location": "302/TALK"  , "narrator": "アーヤ", "text": "あ、やっぱり。"},
        { "location": "303/TALK"  , "narrator": "アーヤ", "text": "つばめのココロ検索が\n出てきた。"},
        { "location": "304/SEL"   , "narrator": "", "text": "すごい！"},
        { "location": "305/SEL"   , "narrator": "", "text": "セキュリティユルすぎじゃない？"},
        { "location": "306/ACT"   , "narrator": "", "text": "すごい！"},
        { "location": "308/TALK"  , "narrator": "アーヤ", "text": "ふふ、すごいでしょ。"},
        { "location": "309/TALK"  , "narrator": "アーヤ", "text": "なんて。\n実はわかってたのよね。"},
        { "location": "310/TALK"  , "narrator": "アーヤ", "text": "司書のコールシステムって\n決められたフォーマットで\n動いてるから。"},
        { "location": "311/ACT"   , "narrator": "", "text": "セキュリティユルすぎじゃない？"},
        { "location": "312/TALK"  , "narrator": "アーヤ", "text": "そんな事ないわよ。\n司書にしかできないもの。"},
        { "location": "313/TALK"  , "narrator": "アーヤ", "text": "それに、動かせばすぐに\nその世界の司書は\nわかるようになってるし。"},
        { "location": "314/SEL"   , "narrator": "", "text": "でも$me$にも動かせたよ？"},
        { "location": "315/ACT"   , "narrator": "", "text": "でも$me$にも動かせたよ？"},
        { "location": "317/TALK"  , "narrator": "アーヤ", "text": "え！？\nそうなの？"},
        { "location": "318/TALK"  , "narrator": "アーヤ", "text": "すごい。\n貴方、司書としての\n資格もあるのね。"},
        { "location": "319/SEL"   , "narrator": "", "text": "よくわからないけど"},
        { "location": "320/ACT"   , "narrator": "", "text": "よくわからないけど"},
        { "location": "323/ACT"   , "narrator": "", "text": "危険だからやめて！"},
        { "location": "325/TALK"  , "narrator": "アーヤ", "text": "え？\n危険？？\nどうして？"},
        { "location": "326/SEL"   , "narrator": "", "text": "アーヤも更迭されるよ！"},
        { "location": "327/ACT"   , "narrator": "", "text": "アーヤも更迭されるよ！"},
        { "location": "329/TALK"  , "narrator": "アーヤ", "text": "そうなの？"},
        { "location": "334/TALK"  , "narrator": "アーヤ", "text": "あ。\nメールみたい。"},
        { "location": "337/TALK"  , "narrator": "アーヤ", "text": "司書長からね。"},
        { "location": "338/SEL"   , "narrator": "", "text": "そんな人いるの？"},
        { "location": "339/ACT"   , "narrator": "", "text": "そんな人いるの？"},
        { "location": "342/TALK"  , "narrator": "アーヤ", "text": "人って言うか、精神？\n人格…ってのも違うし、\n説明しづらいけど。"},
        { "location": "343/TALK"  , "narrator": "アーヤ", "text": "……。"},
        { "location": "344/TALK"  , "narrator": "アーヤ", "text": "つばめのココロの総意から\n連絡があって、今回は私に\n代行して欲しいって。"},
        { "location": "345/SEL"   , "narrator": "", "text": "そうなんだ！"},
        { "location": "346/SEL"   , "narrator": "", "text": "うそでしょ！"},
        { "location": "347/ACT"   , "narrator": "", "text": "そうなんだ！"},
        { "location": "348/TALK"  , "narrator": "アーヤ", "text": "ええ。\nなので、改めまして――"},
        { "location": "349/ACT"   , "narrator": "", "text": "うそでしょ！"},
        { "location": "350/TALK"  , "narrator": "アーヤ", "text": "嘘なんかつかないわよ。"},
        { "location": "352/TALK"  , "narrator": "アーヤ", "text": "前にも言ったけど、\n司書は本当の事だけを\n伝えるのよ。"},
        { "location": "355/TALK"  , "narrator": "アーヤ", "text": "知らないと思うけど、\n司書は本当のことしか\n言わないんです。"},
        { "location": "357/TALK"  , "narrator": "アーヤ", "text": "というわけで――"},
        { "location": "359/TALK"  , "narrator": "アーヤ", "text": "つばめの１日司書に\n任命されたアーヤです！\nよろしくね。"},
        { "location": "360/SEL"   , "narrator": "", "text": "お、おう…"},
        { "location": "361/ACT"   , "narrator": "", "text": "お、おう…"},
        { "location": "364/TALK"  , "narrator": "アーヤ", "text": "それじゃ早速、\n扉をコールするわね。"},
        { "location": "369/TALK"  , "narrator": "アーヤ", "text": "オープンプロセス、\n0x218番地から\n0x568番地へ。"},
        { "location": "384/TALK"  , "narrator": "アーヤ", "text": "シーク完了。"},
        { "location": "386/TALK"  , "narrator": "アーヤ", "text": "さて、\nどんなことで\n悩んでるのかしら……と。"},
        { "location": "388/TALK"  , "narrator": "アーヤ", "text": "……。"},
        { "location": "389/TALK"  , "narrator": "アーヤ", "text": "あー、なるほど。\nそういうお年頃だものね。"},
        { "location": "390/TALK"  , "narrator": "アーヤ", "text": "ここはひとつ、つばめの\nココロが期待してる通り、\n読む方へ導きましょ。"},
        { "location": "391/SEL"   , "narrator": "", "text": "あー、やっぱり読みたがってたのか"},
        { "location": "392/SEL"   , "narrator": "", "text": "アーヤはつばめと同じお年頃のころは、どうだったの？"},
        { "location": "393/ACT"   , "narrator": "", "text": "あー、やっぱり読みたがってたのか"},
        { "location": "394/TALK"  , "narrator": "アーヤ", "text": "まあ、興味が出ちゃうのは\n仕方ないわよね。"},
        { "location": "395/TALK"  , "narrator": "アーヤ", "text": "特につばめは、そっちの\n方は遅れてそうだし。"},
        { "location": "396/TALK"  , "narrator": "アーヤ", "text": "やっぱりそういう方面も\nちゃんと教えないと\nダメかしら……。"},
        { "location": "397/SEL"   , "narrator": "", "text": "確かに。危ないよね"},
        { "location": "398/SEL"   , "narrator": "", "text": "キマシタワー！！"},
        { "location": "399/ACT"   , "narrator": "", "text": "確かに。危ないよね"},
        { "location": "400/TALK"  , "narrator": "アーヤ", "text": "そうよ、危ないのよ。"},
        { "location": "401/TALK"  , "narrator": "アーヤ", "text": "よくわからない状況で、\nそのうち大変なことに\nなっちゃうかも……。"},
        { "location": "402/TALK"  , "narrator": "アーヤ", "text": "やっぱり私がちゃんと\n気をつけるよう\n言わないとダメね。"},
        { "location": "403/TALK"  , "narrator": "アーヤ", "text": "でも今はとにかく、\nつばめのココロを\n解決しなくちゃ。"},
        { "location": "404/ACT"   , "narrator": "", "text": "キマシタワー！！"},
        { "location": "405/TALK"  , "narrator": "アーヤ", "text": "なぁに？\nキマシタワーって。"},
        { "location": "406/SEL"   , "narrator": "", "text": "手取り足取り教えるんでしょ？"},
        { "location": "407/ACT"   , "narrator": "", "text": "手取り足取り教えるんでしょ？"},
        { "location": "409/TALK"  , "narrator": "アーヤ", "text": "なにを！？"},
        { "location": "410/TALK"  , "narrator": "アーヤ", "text": "単に、大人の交際の\n常識を教えるだけよ。"},
        { "location": "411/TALK"  , "narrator": "アーヤ", "text": "今のつばめは\n危なっかしくて、\nボーイフレンドなんて……"},
        { "location": "412/TALK"  , "narrator": "アーヤ", "text": "……貴方もね。"},
        { "location": "413/TALK"  , "narrator": "アーヤ", "text": "まあとにかく、\n今はつばめのココロを\n解決しなくちゃ。"},
        { "location": "415/ACT"   , "narrator": "", "text": "アーヤはつばめと同じお年頃のころは、どうだったの？"},
        { "location": "417/TALK"  , "narrator": "アーヤ", "text": "え？　私？"},
        { "location": "418/TALK"  , "narrator": "アーヤ", "text": "私はそのお年頃は\n剣道一直線だったから。"},
        { "location": "419/SEL"   , "narrator": "", "text": "本当に？司書は本当の事しか言わないはずだけど？"},
        { "location": "420/SEL"   , "narrator": "", "text": "流石アーヤ。司書の言う事だし信じるよ"},
        { "location": "421/ACT"   , "narrator": "", "text": "本当に？司書は本当の事しか言わないはずだけど？"},
        { "location": "422/TALK"  , "narrator": "アーヤ", "text": "本当の事です！"},
        { "location": "423/TALK"  , "narrator": "アーヤ", "text": "一字一句全て、全部\n本当のことよ。失礼ね！"},
        { "location": "424/ACT"   , "narrator": "", "text": "流石アーヤ。司書の言う事だし信じるよ"},
        { "location": "426/TALK"  , "narrator": "アーヤ", "text": "ありがと。"},
        { "location": "427/SEL"   , "narrator": "", "text": "真面目少女だったんだね"},
        { "location": "428/SEL"   , "narrator": "", "text": "じゃあ、エッチなことに興味があったかを「はい」か「いいえ」で答えて？"},
        { "location": "429/ACT"   , "narrator": "", "text": "真面目少女だったんだね"},
        { "location": "430/TALK"  , "narrator": "アーヤ", "text": "もちろんよ。中学の頃から\n学級委員と生徒会長は\n欠かしたことが無いのよ？"},
        { "location": "431/ACT"   , "narrator": "", "text": "じゃあ、エッチなことに興味があったかを「はい」か「いいえ」で答えて？"},
        { "location": "433/TALK"  , "narrator": "アーヤ", "text": "え………"},
        { "location": "434/TALK"  , "narrator": "アーヤ", "text": "だからさっき、\n剣道一直線だったって……"},
        { "location": "435/SEL"   , "narrator": "", "text": "答えになってないよ？"},
        { "location": "436/ACT"   , "narrator": "", "text": "答えになってないよ？"},
        { "location": "438/TALK"  , "narrator": "アーヤ", "text": "拒否権を発動します！"},
        { "location": "439/SEL"   , "narrator": "", "text": "うぐう"},
        { "location": "440/SEL"   , "narrator": "", "text": "ならば今回はココロの解決に協力しません"},
        { "location": "441/ACT"   , "narrator": "", "text": "うぐう"},
        { "location": "442/TALK"  , "narrator": "アーヤ", "text": "ふふーん。"},
        { "location": "443/ACT"   , "narrator": "", "text": "ならば今回はココロの解決に協力しません"},
        { "location": "445/TALK"  , "narrator": "アーヤ", "text": "うわ汚い！"},
        { "location": "446/SEL"   , "narrator": "", "text": "ごく普通の交渉ですけど？"},
        { "location": "447/ACT"   , "narrator": "", "text": "ごく普通の交渉ですけど？"},
        { "location": "450/TALK"  , "narrator": "アーヤ", "text": "………。"},
        { "location": "451/TALK"  , "narrator": "アーヤ", "text": "……………………………\n……………………………\n…………………………。"},
        { "location": "452/TALK"  , "narrator": "アーヤ", "text": "……………………………\n……………………………\n……………………はぃ。"},
        { "location": "453/SEL"   , "narrator": "", "text": "やっぱりエッチだったんだね！！"},
        { "location": "454/SEL"   , "narrator": "", "text": "具体的にはどんなことを？"},
        { "location": "455/SEL"   , "narrator": "", "text": "アーヤかわいい"},
        { "location": "456/ACT"   , "narrator": "", "text": "やっぱりエッチだったんだね！！"},
        { "location": "459/TALK"  , "narrator": "アーヤ", "text": "もう！！\nそんなハッキリ\n言わないで！"},
        { "location": "460/TALK"  , "narrator": "アーヤ", "text": "そうよ！\n悪かったわね！"},
        { "location": "461/TALK"  , "narrator": "アーヤ", "text": "この年頃はみんなそうよ！\n女の子同士の会話だって\n普通にそんな感じだし！"},
        { "location": "462/SEL"   , "narrator": "", "text": "わかったわかった、ごめんね？"},
        { "location": "463/ACT"   , "narrator": "", "text": "わかったわかった、ごめんね？"},
        { "location": "466/TALK"  , "narrator": "アーヤ", "text": "……もう。\n知らない！"},
        { "location": "467/ACT"   , "narrator": "", "text": "具体的にはどんなことを？"},
        { "location": "469/TALK"  , "narrator": "アーヤ", "text": "……。"},
        { "location": "470/TALK"  , "narrator": "アーヤ", "text": "それを言わないと\n協力しないというなら\n私、帰ります。"},
        { "location": "471/SEL"   , "narrator": "", "text": "わかった、もういいよ、ごめんね？"},
        { "location": "472/ACT"   , "narrator": "", "text": "わかった、もういいよ、ごめんね？"},
        { "location": "474/TALK"  , "narrator": "アーヤ", "text": "よかった。\nわかってくれればいいの。"},
        { "location": "476/TALK"  , "narrator": "アーヤ", "text": "その話をするには、\nもうちょっと深い仲に\nならないとダメよね。"},
        { "location": "478/ACT"   , "narrator": "", "text": "アーヤかわいい"},
        { "location": "480/TALK"  , "narrator": "アーヤ", "text": "うー……。\nずるいわよ、それ。"},
        { "location": "481/TALK"  , "narrator": "アーヤ", "text": "怒りたくても\n怒れないじゃない…。"},
        { "location": "486/TALK"  , "narrator": "アーヤ", "text": "まあとにかく！"},
        { "location": "487/TALK"  , "narrator": "アーヤ", "text": "今は私の事より\nつばめのことよ！"},
        { "location": "488/TALK"  , "narrator": "アーヤ", "text": "彼女の成長の為にも\n私たちが頑張らないと。"},
        { "location": "490/TALK"  , "narrator": "アーヤ", "text": "それじゃ、\n準備はいい？"},
        { "location": "491/TALK"  , "narrator": "アーヤ", "text": "$handle$さんと\nつばめにとって、\n素敵なココロの旅を！"},
        { "location": "29/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>7月24日　2:55 PM</color>\nとある休日、秋葉原某所にある書店にて。"},
        { "location": "174/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "176/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "178/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "180/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "182/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"}
