        { "location": "805/TALK"   , "narrator": "つばめ", "text": "そっか…。"},
        { "location": "807/TALK"   , "narrator": "つばめ", "text": "別に場所なんか\n探す必要ないよね。"},
        { "location": "808/TALK"   , "narrator": "つばめ", "text": "カッターでも、\n車に飛び込んでも、\n簡単に死ねるんだし…。"},
        { "location": "809/TALK"   , "narrator": "つばめ", "text": "バカみたい…。\n場所なんか探す\n必要なかったのに。"},
        { "location": "812/SEL"    , "narrator": "", "text": "$me$はどうなるの？"},
        { "location": "813/ACT"    , "narrator": "", "text": "$me$はどうなるの？"},
        { "location": "830/TALK"   , "narrator": "つばめ", "text": "$handle$さん"},
        { "location": "831/TALK"   , "narrator": "つばめ", "text": "今までありがとう"},
        { "location": "832/SEL"    , "narrator": "", "text": "これから先も作ろうよ"},
        { "location": "833/SEL"    , "narrator": "", "text": "いい恋人じゃなかったのかな"},
        { "location": "834/SEL"    , "narrator": "", "text": "一人で決めないで"},
        { "location": "835/TALK"   , "narrator": "つばめ", "text": "わたしあなたに会えて"},
        { "location": "836/TALK"   , "narrator": "つばめ", "text": "幸せだった"},
        { "location": "838/ACT"    , "narrator": "", "text": "これから先も作ろうよ"},
        { "location": "839/TALK"   , "narrator": "つばめ", "text": "ごめんね"},
        { "location": "840/ACT"    , "narrator": "", "text": "いい恋人じゃなかったのかな"},
        { "location": "841/TALK"   , "narrator": "つばめ", "text": "そんなことないよ！"},
        { "location": "842/ACT"    , "narrator": "", "text": "一人で決めないで"},
        { "location": "843/TALK"   , "narrator": "つばめ", "text": "最後のわがままだから"},
        { "location": "845/SEL"    , "narrator": "", "text": "死なないで"},
        { "location": "846/SEL"    , "narrator": "", "text": "生きていこうよ"},
        { "location": "847/SEL"    , "narrator": "", "text": "バカなことはやめて"},
        { "location": "848/TALK"   , "narrator": "つばめ", "text": "ごめんね"},
        { "location": "849/TALK"   , "narrator": "つばめ", "text": "幸せになってね"},
        { "location": "850/ACT"    , "narrator": "", "text": "死なないで"},
        { "location": "852/TALK"   , "narrator": "つばめ", "text": "無理だよ"},
        { "location": "853/ACT"    , "narrator": "", "text": "生きていこうよ"},
        { "location": "855/TALK"   , "narrator": "つばめ", "text": "ダメだよ"},
        { "location": "856/ACT"    , "narrator": "", "text": "バカなことはやめて"},
        { "location": "857/TALK"   , "narrator": "つばめ", "text": "バカだもん"},
        { "location": "859/TALK"   , "narrator": "つばめ", "text": "だって"},
        { "location": "860/TALK"   , "narrator": "つばめ", "text": "わたしが死ななきゃ"},
        { "location": "861/TALK"   , "narrator": "つばめ", "text": "神楽ちゃん"},
        { "location": "862/TALK"   , "narrator": "つばめ", "text": "助けられないんだよ？"},
        { "location": "863/TALK"   , "narrator": "つばめ", "text": "神楽ちゃんを助けるの"},
        { "location": "864/TALK"   , "narrator": "つばめ", "text": "そのためなんだから"},
        { "location": "866/TALK"   , "narrator": "つばめ", "text": "ねえわたし"},
        { "location": "867/TALK"   , "narrator": "つばめ", "text": "間違ってる？"},
        { "location": "869/SEL"    , "narrator": "", "text": "自己犠牲なんて間違ってる"},
        { "location": "870/SEL"    , "narrator": "", "text": "つばめが死んだら悲しいよ"},
        { "location": "871/ACT"    , "narrator": "", "text": "自己犠牲なんて間違ってる"},
        { "location": "872/TALK"   , "narrator": "つばめ", "text": "そう"},
        { "location": "873/TALK"   , "narrator": "つばめ", "text": "なの"},
        { "location": "874/TALK"   , "narrator": "つばめ", "text": "かな"},
        { "location": "875/ACT"    , "narrator": "", "text": "つばめが死んだら悲しいよ"},
        { "location": "878/TALK"   , "narrator": "つばめ", "text": "でも"},
        { "location": "879/TALK"   , "narrator": "つばめ", "text": "神楽ちゃんが苦しんでるの"},
        { "location": "880/TALK"   , "narrator": "つばめ", "text": "わたしも悲しいから"},
        { "location": "882/SEL"    , "narrator": "", "text": "$me$が悲しいのは構わないんだ…？"},
        { "location": "883/SEL"    , "narrator": "", "text": "つばめは$me$にとって大切な人だ"},
        { "location": "884/SEL"    , "narrator": "", "text": "つばめが悲しいと$me$も悲しい"},
        { "location": "885/ACT"    , "narrator": "", "text": "$me$が悲しいのは構わないんだ…？"},
        { "location": "887/TALK"   , "narrator": "つばめ", "text": "そんなことは"},
        { "location": "888/TALK"   , "narrator": "つばめ", "text": "ないけど"},
        { "location": "889/TALK"   , "narrator": "つばめ", "text": "でも"},
        { "location": "890/ACT"    , "narrator": "", "text": "つばめは$me$にとって大切な人だ"},
        { "location": "892/TALK"   , "narrator": "つばめ", "text": "ありがとう"},
        { "location": "893/TALK"   , "narrator": "つばめ", "text": "でも"},
        { "location": "894/ACT"    , "narrator": "", "text": "つばめが悲しいと$me$も悲しい"},
        { "location": "895/TALK"   , "narrator": "つばめ", "text": "だったら"},
        { "location": "896/TALK"   , "narrator": "つばめ", "text": "わかってくれるよね"},
        { "location": "898/TALK"   , "narrator": "つばめ", "text": "神楽ちゃんは"},
        { "location": "900/TALK"   , "narrator": "つばめ", "text": "わたしにとって大切な友達だから"},
        { "location": "901/TALK"   , "narrator": "つばめ", "text": "それに"},
        { "location": "902/TALK"   , "narrator": "つばめ", "text": "メノウちゃんに恩返ししたいの"},
        { "location": "904/SEL"    , "narrator": "", "text": "恩返しになんてならないよ"},
        { "location": "905/SEL"    , "narrator": "", "text": "その気持ちは否定しないけど"},
        { "location": "906/SEL"    , "narrator": "", "text": "もっと根本的な部分の話をしたい"},
        { "location": "907/ACT"    , "narrator": "", "text": "恩返しになんてならないよ"},
        { "location": "908/TALK"   , "narrator": "つばめ", "text": "そんなわけない"},
        { "location": "909/ACT"    , "narrator": "", "text": "その気持ちは否定しないけど"},
        { "location": "910/TALK"   , "narrator": "つばめ", "text": "だったらわかってくれるよね"},
        { "location": "911/ACT"    , "narrator": "", "text": "もっと根本的な部分の話をしたい"},
        { "location": "912/TALK"   , "narrator": "つばめ", "text": "根本的って？"},
        { "location": "915/SEL"    , "narrator": "", "text": "えーと"},
        { "location": "916/ACT"    , "narrator": "", "text": "えーと"},
        { "location": "918/TALK"   , "narrator": "つばめ", "text": "はい"},
        { "location": "919/SEL"    , "narrator": "", "text": "つばめは$me$のこと嫌い？"},
        { "location": "920/ACT"    , "narrator": "", "text": "つばめは$me$のこと嫌い？"},
        { "location": "924/TALK"   , "narrator": "つばめ", "text": "好き"},
        { "location": "927/TALK"   , "narrator": "つばめ", "text": "大好き"},
        { "location": "928/TALK"   , "narrator": "つばめ", "text": "大好きだよ"},
        { "location": "930/TALK"   , "narrator": "つばめ", "text": "いつもずっと一緒にいてくれてお話ししてくれて相談に乗ってくれて助けてくれて"},
        { "location": "931/TALK"   , "narrator": "つばめ", "text": "いつもいつも"},
        { "location": "932/TALK"   , "narrator": "つばめ", "text": "いつも$handle$さんと"},
        { "location": "935/TALK"   , "narrator": "つばめ", "text": "もっと一緒にいたいってお話ししたいって"},
        { "location": "938/TALK"   , "narrator": "つばめ", "text": "もっと"},
        { "location": "941/TALK"   , "narrator": "つばめ", "text": "やっぱり"},
        { "location": "942/TALK"   , "narrator": "つばめ", "text": "わたし"},
        { "location": "945/TALK"   , "narrator": "つばめ", "text": "しにたくない"},
        { "location": "946/TALK"   , "narrator": "つばめ", "text": "神楽ちゃん助けたいのに死にたくない"},
        { "location": "947/TALK"   , "narrator": "つばめ", "text": "死にたくない"},
        { "location": "949/SEL"    , "narrator": "", "text": "他の方法を考えようよ"},
        { "location": "950/SEL"    , "narrator": "", "text": "それで当たり前だから"},
        { "location": "951/SEL"    , "narrator": "", "text": "そう言ってくれてよかった……"},
        { "location": "952/ACT"    , "narrator": "", "text": "他の方法を考えようよ"},
        { "location": "953/TALK"   , "narrator": "つばめ", "text": "他の方法が"},
        { "location": "954/TALK"   , "narrator": "つばめ", "text": "あるのかな。。。？"},
        { "location": "955/ACT"    , "narrator": "", "text": "それで当たり前だから"},
        { "location": "956/TALK"   , "narrator": "つばめ", "text": "そうなの。。。？"},
        { "location": "957/TALK"   , "narrator": "つばめ", "text": "本当に。。。？"},
        { "location": "958/ACT"    , "narrator": "", "text": "そう言ってくれてよかった……"},
        { "location": "959/TALK"   , "narrator": "つばめ", "text": "えと"},
        { "location": "960/TALK"   , "narrator": "つばめ", "text": "ごめんね"},
        { "location": "962/TALK"   , "narrator": "つばめ", "text": "うん"},
        { "location": "963/TALK"   , "narrator": "つばめ", "text": "わたし"},
        { "location": "964/TALK"   , "narrator": "つばめ", "text": "本当は"},
        { "location": "965/TALK"   , "narrator": "つばめ", "text": "死にたくない"},
        { "location": "966/TALK"   , "narrator": "つばめ", "text": "死にたくないよ"},
        { "location": "979/TALK"   , "narrator": "つばめ", "text": "ごめん…。\nごめんね、\n神楽ちゃん…。"},
        { "location": "981/TALK"   , "narrator": "つばめ", "text": "ごめんなさい、\n$handle$さん…。"},
        { "location": "982/TALK"   , "narrator": "つばめ", "text": "…………。"},
        { "location": "985/TALK"   , "narrator": "つばめ", "text": "…ありがとう…、\n$handle$さん…。"},
        { "location": "1005/TALK"  , "narrator": "つばめ", "text": "わぁ…。"},
        { "location": "1010/TALK"  , "narrator": "つばめ", "text": "…綺麗な花火。"},
        { "location": "1012/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "1024/TALK"  , "narrator": "つばめ", "text": "$handle$さん(´・ω・`) "},
        { "location": "1025/TALK"  , "narrator": "つばめ", "text": "わかる？"},
        { "location": "1026/TALK"  , "narrator": "つばめ", "text": "凄い花火だよ(*≧∀≦*) "},
        { "location": "1028/SEL"   , "narrator": "", "text": "そうみたいだね"},
        { "location": "1029/ACT"   , "narrator": "", "text": "そうみたいだね"},
        { "location": "1031/TALK"  , "narrator": "つばめ", "text": "うん(*´︶`*)"},
        { "location": "1032/TALK"  , "narrator": "つばめ", "text": "とっても素敵で綺麗(´∀｀*)ｳﾌﾌ"},
        { "location": "1033/TALK"  , "narrator": "つばめ", "text": "でも"},
        { "location": "1036/TALK"  , "narrator": "つばめ", "text": "さっき死んじゃってたら"},
        { "location": "1037/TALK"  , "narrator": "つばめ", "text": "見れなかったんだよね"},
        { "location": "1040/TALK"  , "narrator": "つばめ", "text": "来年も"},
        { "location": "1041/TALK"  , "narrator": "つばめ", "text": "また見に来たいな"},
        { "location": "1042/TALK"  , "narrator": "つばめ", "text": "$handle$さんと(*´ω｀*)"},
        { "location": "1045/TALK"  , "narrator": "つばめ", "text": "神楽ちゃんも一緒に"},
        { "location": "1047/SEL"   , "narrator": "", "text": "二人きりの方がいいな"},
        { "location": "1048/SEL"   , "narrator": "", "text": "楽しみにしてるよ"},
        { "location": "1049/ACT"   , "narrator": "", "text": "二人きりの方がいいな"},
        { "location": "1050/ACT"   , "narrator": "", "text": "楽しみにしてるよ"},
        { "location": "1052/TALK"  , "narrator": "つばめ", "text": "うん(*´︶`*)"},
        { "location": "1053/TALK"  , "narrator": "つばめ", "text": "叶えるために"},
        { "location": "1054/TALK"  , "narrator": "つばめ", "text": "わたし"},
        { "location": "1055/TALK"  , "narrator": "つばめ", "text": "頑張る！(๑･ㅂ･)و☆"},
        { "location": "1066/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "1070/TALK"  , "narrator": "つばめ", "text": "…来年も、絶対に\n見にこよう…。"},
        { "location": "1073/SEL"   , "narrator": "", "text": "端末操作：雛へ通話"},
        { "location": "1074/ACT"   , "narrator": "", "text": "端末操作：雛へ通話"},
        { "location": "1079/TALK"  , "narrator": "雛", "text": "もしもし？"},
        { "location": "1080/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "1081/TALK"  , "narrator": "雛", "text": "つばめちゃん？\nおーい、もしもーし！"},
        { "location": "1082/TALK"  , "narrator": "つばめ", "text": "…あ、あれ？"},
        { "location": "1085/TALK"  , "narrator": "雛", "text": "もしもーし！"},
        { "location": "1086/TALK"  , "narrator": "つばめ", "text": "ひなこちゃん！？\nえ、でもどうして、\n勝手に…。"},
        { "location": "1087/TALK"  , "narrator": "雛", "text": "あれ？　もしかして\n間違ってかけちゃった\n感じ？"},
        { "location": "1088/TALK"  , "narrator": "つばめ", "text": "…もしかして、\n$handle$さんが\nかけたのかな？"},
        { "location": "1089/TALK"  , "narrator": "雛", "text": "つばめちゃん？"},
        { "location": "1091/TALK"  , "narrator": "つばめ", "text": "あ、うん。\n間違っちゃったの、\nごめんね。"},
        { "location": "1092/TALK"  , "narrator": "雛", "text": "あはは、つばめちゃん\nらしいなー。"},
        { "location": "1093/TALK"  , "narrator": "雛", "text": "そういえば、前にも\n一度あったよね？"},
        { "location": "1094/TALK"  , "narrator": "雛", "text": "すっごい朝早くに、\n寝ぼけてかけて\nきちゃったこと。"},
        { "location": "1095/TALK"  , "narrator": "つばめ", "text": "あ、あの時は\n本当にごめんね…。"},
        { "location": "1096/TALK"  , "narrator": "つばめ", "text": "携帯の目覚まし止める\nつもりが、ひなこちゃんに\n電話しちゃって…。"},
        { "location": "1097/TALK"  , "narrator": "雛", "text": "いいのいいのー。\nそういうのって\nあるあるだし。"},
        { "location": "1098/TALK"  , "narrator": "つばめ", "text": "…ふふっ。\nそう言ってもらえると\n安心するよ…。"},
        { "location": "1099/TALK"  , "narrator": "雛", "text": "うん…。"},
        { "location": "1100/TALK"  , "narrator": "つばめ", "text": "…………？\nひなこちゃん？"},
        { "location": "1101/TALK"  , "narrator": "雛", "text": "あ、ごめんごめん。\nちょっと、その…。"},
        { "location": "1102/TALK"  , "narrator": "雛", "text": "ほら、あたし達が\n東京に帰った日のこと、\n覚えてる？"},
        { "location": "1103/TALK"  , "narrator": "雛", "text": "つばめちゃん、\n駅まで見送りに\n来てくれたでしょ？"},
        { "location": "1104/TALK"  , "narrator": "つばめ", "text": "うん…。"},
        { "location": "1105/TALK"  , "narrator": "雛", "text": "あの時ね、\nすっごく嬉しかったよ。"},
        { "location": "1106/TALK"  , "narrator": "雛", "text": "けど…、同じくらい、\nすっごく寂しく\nなっちゃったんだ。"},
        { "location": "1107/TALK"  , "narrator": "雛", "text": "つばめちゃんが\n東京に帰ってくるまで、\n会えないんだな、って…。"},
        { "location": "1108/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "1109/TALK"  , "narrator": "雛", "text": "だから、つばめちゃんの\n声が聞けて、\nすっごく嬉しいよー！"},
        { "location": "1110/TALK"  , "narrator": "雛", "text": "間違いに感謝だねー。"},
        { "location": "1111/TALK"  , "narrator": "つばめ", "text": "…ひなこちゃん。"},
        { "location": "1112/TALK"  , "narrator": "雛", "text": "それで？　こっちには\nいつ帰ってくるの？"},
        { "location": "1113/TALK"  , "narrator": "つばめ", "text": "…今日の夜には。\n今、横須賀に\n寄り道してるけど…。"},
        { "location": "1114/TALK"  , "narrator": "雛", "text": "うわ、マジ！？\n何そのサプライズ！！"},
        { "location": "1115/TALK"  , "narrator": "雛", "text": "じゃあ、明日には\nつばめちゃんと会えるね。"},
        { "location": "1116/TALK"  , "narrator": "つばめ", "text": "…うん。"},
        { "location": "1117/TALK"  , "narrator": "雛", "text": "キリトもヒカルくんも\nまゆちんも、\nみんな待ってるよ。"},
        { "location": "1118/TALK"  , "narrator": "雛", "text": "だから寄り道しないで、\nちゃんと帰ってきてね。\nおっけー？"},
        { "location": "1120/TALK"  , "narrator": "つばめ", "text": "…うん。\nちゃんと帰るよ。"},
        { "location": "1121/TALK"  , "narrator": "雛", "text": "よかったー。"},
        { "location": "1122/TALK"  , "narrator": "雛", "text": "それじゃ、\nまた明日ねー。"},
        { "location": "1123/TALK"  , "narrator": "つばめ", "text": "うん…。\nありがと…。"},
        { "location": "1129/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "1130/TALK"  , "narrator": "つばめ", "text": "不思議だな…。\nなんでなんだろ？"},
        { "location": "1132/TALK"  , "narrator": "つばめ", "text": "ついさっきまで、\nあんなに死にたいって\n思ってたのに。"},
        { "location": "1133/TALK"  , "narrator": "つばめ", "text": "今は、わたし…、\n死にたくないと\n思ってる…。"},
        { "location": "1134/TALK"  , "narrator": "つばめ", "text": "…死にたくない。\n死にたくないよ…。"},
        { "location": "1135/TALK"  , "narrator": "つばめ", "text": "ひなこちゃん達に\n会いたい…。"},
        { "location": "1136/TALK"  , "narrator": "つばめ", "text": "神楽ちゃんとも、\nもっといっぱい\n一緒にいたい。"},
        { "location": "1137/TALK"  , "narrator": "つばめ", "text": "わたし…、\n死にたくないよぉ…。"},
        { "location": "1157/TALK"  , "narrator": "つばめ", "text": "わぁ…。"},
        { "location": "1161/TALK"  , "narrator": "つばめ", "text": "…綺麗な花火。"},
        { "location": "1162/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "1163/TALK"  , "narrator": "つばめ", "text": "でも、やっぱり\n一人で見るのは、\nちょっと寂しいな…。"},
        { "location": "1164/SEL"   , "narrator": "", "text": "$me$はいつも一緒だよ"},
        { "location": "1165/ACT"   , "narrator": "", "text": "$me$はいつも一緒だよ"},
        { "location": "1182/TALK"  , "narrator": "つばめ", "text": "そうだね"},
        { "location": "1183/TALK"  , "narrator": "つばめ", "text": "ひなこちゃんに電話してくれてぁりがとぉ"},
        { "location": "1187/TALK"  , "narrator": "つばめ", "text": "次は"},
        { "location": "1188/TALK"  , "narrator": "つばめ", "text": "$handle$さんととなり同士で花火見られるとぃぃな"},
        { "location": "1189/TALK"  , "narrator": "つばめ", "text": "これからもずっと"},
        { "location": "1190/TALK"  , "narrator": "つばめ", "text": "一緒にぃてね"},
        { "location": "1203/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "1204/TALK"  , "narrator": "つばめ", "text": "来年の花火大会は、\nひなこちゃん達も誘って、\n大勢で見に来たいな。"},
        { "location": "1205/TALK"  , "narrator": "つばめ", "text": "それに…その時は\n神楽ちゃんも\n一緒に…。"},
        { "location": "1210/TALK"  , "narrator": "つばめ", "text": "…死にたいなんて、\n言ってられないよね。"},
        { "location": "1212/TALK"  , "narrator": "つばめ", "text": "絶対、来年もこの花火を\n見にこよう…。"},
        { "location": "1213/TALK"  , "narrator": "つばめ", "text": "みんなで…絶対に…。"},
        { "location": "1226/DIALOG", "narrator": "Dialog_chapter_ch01", "text": "【19 三戸浜からの手紙】"}
    ]
}
