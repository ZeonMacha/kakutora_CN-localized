{
    "dir": "chap37/daydra/dd_ch03_37_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "37305",
        "cid": "gabriella",
        "title": "005 メインストーリー",
        "sub_title": "あたし自身のあたしのユメ＜後編＞"
    },
    "entry":
    [
        { "location": "653/TALK"  , "narrator": "ガブリエラ", "text": "運命なんて\n全然ロマンチックじゃ\nないものなのね。"},
        { "location": "654/TALK"  , "narrator": "ガブリエラ", "text": "どうしようもない\n現実と同じなんて\nがっかりだわ。"},
        { "location": "656/SEL"   , "narrator": "", "text": "元気？"},
        { "location": "657/SEL"   , "narrator": "", "text": "少し話せる？"},
        { "location": "658/SEL"   , "narrator": "", "text": "$me$を恨んでる？"},
        { "location": "659/ACT"   , "narrator": "", "text": "元気？"},
        { "location": "660/TALK"  , "narrator": "ガブリエラ", "text": "元気だと思う？"},
        { "location": "661/ACT"   , "narrator": "", "text": "少し話せる？"},
        { "location": "662/TALK"  , "narrator": "ガブリエラ", "text": "いいわよ。\n話しても。"},
        { "location": "663/ACT"   , "narrator": "", "text": "$me$を恨んでる？"},
        { "location": "664/TALK"  , "narrator": "ガブリエラ", "text": "そう思ったり\nするんだ？"},
        { "location": "667/SEL"   , "narrator": "", "text": "元気？"},
        { "location": "668/SEL"   , "narrator": "", "text": "少し話せる？"},
        { "location": "669/SEL"   , "narrator": "", "text": "$me$を恨んでる？"},
        { "location": "670/ACT"   , "narrator": "", "text": "元気？"},
        { "location": "671/TALK"  , "narrator": "ガブリエラ", "text": "そうね。\n割と元気。"},
        { "location": "672/ACT"   , "narrator": "", "text": "少し話せる？"},
        { "location": "674/TALK"  , "narrator": "ガブリエラ", "text": "あたしも少し\n話したかったところよ。"},
        { "location": "675/ACT"   , "narrator": "", "text": "$me$を恨んでる？"},
        { "location": "676/TALK"  , "narrator": "ガブリエラ", "text": "どうして\nそう思うの？"},
        { "location": "679/TALK"  , "narrator": "ガブリエラ", "text": "$handle$は\nこの世界について\n選択をしたけど。"},
        { "location": "680/TALK"  , "narrator": "ガブリエラ", "text": "それは確定じゃ\nないのよね。"},
        { "location": "681/SEL"   , "narrator": "", "text": "どうなんだろ"},
        { "location": "682/SEL"   , "narrator": "", "text": "ほぼ確定だから"},
        { "location": "683/SEL"   , "narrator": "", "text": "半々ってとこじゃない"},
        { "location": "684/ACT"   , "narrator": "", "text": "どうなんだろ"},
        { "location": "685/TALK"  , "narrator": "ガブリエラ", "text": "わからないのね…。"},
        { "location": "686/ACT"   , "narrator": "", "text": "ほぼ確定だから"},
        { "location": "688/TALK"  , "narrator": "ガブリエラ", "text": "そうでしょうね。"},
        { "location": "689/TALK"  , "narrator": "ガブリエラ", "text": "じゃなきゃわざわざ\n決めさせないもの。"},
        { "location": "690/ACT"   , "narrator": "", "text": "半々ってとこじゃない"},
        { "location": "692/TALK"  , "narrator": "ガブリエラ", "text": "そんなことないでしょ？"},
        { "location": "693/TALK"  , "narrator": "ガブリエラ", "text": "わざわざ指名して\n決めさせたんだもの。"},
        { "location": "695/TALK"  , "narrator": "ガブリエラ", "text": "この先もう\n話せない可能性が\nあるから言っておくわ。"},
        { "location": "696/TALK"  , "narrator": "ガブリエラ", "text": "なんだかんだで\nあたし$handle$に\n感謝しているの。"},
        { "location": "697/TALK"  , "narrator": "ガブリエラ", "text": "日本に来て\n全然習慣も\n違っていて。"},
        { "location": "698/TALK"  , "narrator": "ガブリエラ", "text": "それでなくても\n話せない時に\n色々話してくれたこと。"},
        { "location": "699/TALK"  , "narrator": "ガブリエラ", "text": "すぐに意地を張って\nふてくされるあたしを\n見ていてくれたこと。"},
        { "location": "700/TALK"  , "narrator": "ガブリエラ", "text": "今はそれでいいよって\n言ってくれたこと。"},
        { "location": "701/TALK"  , "narrator": "ガブリエラ", "text": "そのおかげで、\nあたし少し人に\n優しくなれた。"},
        { "location": "702/TALK"  , "narrator": "ガブリエラ", "text": "$handle$みたいに\n優しくなろうって\nそう思えた。"},
        { "location": "703/SEL"   , "narrator": "", "text": "がんばってたもんね"},
        { "location": "704/SEL"   , "narrator": "", "text": "たまには泣いてもいいんだよ"},
        { "location": "705/SEL"   , "narrator": "", "text": "元々優しい子だったよ"},
        { "location": "706/ACT"   , "narrator": "", "text": "がんばってたもんね"},
        { "location": "707/TALK"  , "narrator": "ガブリエラ", "text": "…うん。\nあたしなりにだけどね。"},
        { "location": "708/ACT"   , "narrator": "", "text": "たまには泣いてもいいんだよ"},
        { "location": "709/TALK"  , "narrator": "ガブリエラ", "text": "そうね。"},
        { "location": "710/TALK"  , "narrator": "ガブリエラ", "text": "こうやって\n$handle$と\n話せるうちに。"},
        { "location": "711/ACT"   , "narrator": "", "text": "元々優しい子だったよ"},
        { "location": "712/TALK"  , "narrator": "ガブリエラ", "text": "…そんなことを\n言ってくれるのは\n$handle$だけよ。"},
        { "location": "714/TALK"  , "narrator": "ガブリエラ", "text": "$handle$は\n優しい。"},
        { "location": "715/SEL"   , "narrator": "", "text": "ガブリエラにだけだよ"},
        { "location": "716/SEL"   , "narrator": "", "text": "そうかな？"},
        { "location": "717/SEL"   , "narrator": "", "text": "そんなことないし"},
        { "location": "718/ACT"   , "narrator": "", "text": "ガブリエラにだけだよ"},
        { "location": "719/TALK"  , "narrator": "ガブリエラ", "text": "絶対の絶対の\n絶対にそう？\nあたしにだけ？"},
        { "location": "720/TALK"  , "narrator": "ガブリエラ", "text": "なんてね。\n知ってる。\nそんなことは。"},
        { "location": "721/ACT"   , "narrator": "", "text": "そうかな？"},
        { "location": "722/TALK"  , "narrator": "ガブリエラ", "text": "そうよ。"},
        { "location": "723/ACT"   , "narrator": "", "text": "そんなことないし"},
        { "location": "724/TALK"  , "narrator": "ガブリエラ", "text": "そういうの\n謙遜って言うんでしょ。"},
        { "location": "726/TALK"  , "narrator": "ガブリエラ", "text": "ねえ$handle$。\nこの先あたしが\n魂だけになっても。"},
        { "location": "727/TALK"  , "narrator": "ガブリエラ", "text": "$handle$は\nずっとあたしの\n側にいて。"},
        { "location": "729/TALK"  , "narrator": "ガブリエラ", "text": "いつもあたしを\n感じていて。"},
        { "location": "730/TALK"  , "narrator": "ガブリエラ", "text": "今こうやって\n話してるみたいに。"},
        { "location": "731/TALK"  , "narrator": "ガブリエラ", "text": "ううん、今より\nずっと深いところで。"},
        { "location": "732/TALK"  , "narrator": "ガブリエラ", "text": "空を見上げたら\n月や星や太陽が\n見えるみたいに。"},
        { "location": "733/TALK"  , "narrator": "ガブリエラ", "text": "当たり前にあたしの\n側にいて。"},
        { "location": "734/TALK"  , "narrator": "ガブリエラ", "text": "息をするみたいに\nあたしのことを\n感じていて。"},
        { "location": "735/TALK"  , "narrator": "ガブリエラ", "text": "あなたの心臓が\nあたしの魂。"},
        { "location": "736/TALK"  , "narrator": "ガブリエラ", "text": "そう思ったら\n怖いものなんて\nないような気がする。"},
        { "location": "737/TALK"  , "narrator": "ガブリエラ", "text": "だって$handle$が\nいるだけであたしは\n震えるから。"},
        { "location": "738/TALK"  , "narrator": "ガブリエラ", "text": "あたしの魂が\n喜びで震えるから。"},
        { "location": "739/TALK"  , "narrator": "ガブリエラ", "text": "だからこの先もずっと\nあたしを感じて。"},
        { "location": "740/TALK"  , "narrator": "ガブリエラ", "text": "あなたのセカイに\nあたしをいさせて。"},
        { "location": "741/TALK"  , "narrator": "ガブリエラ", "text": "あたしのセカイは\nあなたの一部でしか\nないから。"},
        { "location": "742/TALK"  , "narrator": "ガブリエラ", "text": "あたしのセカイの\nどんな場所にも\nあなたがいるから。"},
        { "location": "744/SEL"   , "narrator": "", "text": "愛してる。ずっと一緒だから"},
        { "location": "745/SEL"   , "narrator": "", "text": "これからも共に支え合っていこう"},
        { "location": "746/SEL"   , "narrator": "", "text": "これからも頑張ってね"},
        { "location": "747/SEL"   , "narrator": "", "text": "役に立てて良かったよ"},
        { "location": "748/ACT"   , "narrator": "", "text": "愛してる。ずっと一緒だから"},
        { "location": "749/TALK"  , "narrator": "ガブリエラ", "text": "ちゃんと魂のあたしを\n見分けてね。"},
        { "location": "750/ACT"   , "narrator": "", "text": "これからも共に支え合っていこう"},
        { "location": "751/TALK"  , "narrator": "ガブリエラ", "text": "そのガブリエラは\nそのガブリエラ？"},
        { "location": "752/ACT"   , "narrator": "", "text": "これからも頑張ってね"},
        { "location": "753/TALK"  , "narrator": "ガブリエラ", "text": "…当たり前よ。"},
        { "location": "754/ACT"   , "narrator": "", "text": "役に立てて良かったよ"},
        { "location": "755/TALK"  , "narrator": "ガブリエラ", "text": "…そんなの全然だわ。"},
        { "location": "758/SEL"   , "narrator": "", "text": "愛してる。ずっと一緒だから"},
        { "location": "759/SEL"   , "narrator": "", "text": "これからも共に支え合っていこう"},
        { "location": "760/SEL"   , "narrator": "", "text": "これからも頑張ってね"},
        { "location": "761/SEL"   , "narrator": "", "text": "役に立てて良かったよ"},
        { "location": "762/ACT"   , "narrator": "", "text": "愛してる。ずっと一緒だから"},
        { "location": "763/TALK"  , "narrator": "ガブリエラ", "text": "あたしの方がその\n百万倍愛してる。"},
        { "location": "764/TALK"  , "narrator": "ガブリエラ", "text": "何があっても一緒。\n永遠に一緒。"},
        { "location": "765/ACT"   , "narrator": "", "text": "これからも共に支え合っていこう"},
        { "location": "766/TALK"  , "narrator": "ガブリエラ", "text": "もうちょっと\nロマンティックに\n言ってほしいのよ？"},
        { "location": "767/TALK"  , "narrator": "ガブリエラ", "text": "…でも好きよ。\nそんなところも。"},
        { "location": "768/ACT"   , "narrator": "", "text": "これからも頑張ってね"},
        { "location": "769/TALK"  , "narrator": "ガブリエラ", "text": "何よ。"},
        { "location": "770/TALK"  , "narrator": "ガブリエラ", "text": "もっと優しく\n言ってくれても\nいいと思うの。"},
        { "location": "771/ACT"   , "narrator": "", "text": "役に立てて良かったよ"},
        { "location": "772/TALK"  , "narrator": "ガブリエラ", "text": "…そんな言い方\n冷たくないかしら？"},
        { "location": "774/TALK"  , "narrator": "ガブリエラ", "text": "最終的な結果は\nまだわからないけど。"},
        { "location": "775/TALK"  , "narrator": "ガブリエラ", "text": "$handle$が\nあたしを選んで\nくれたことは。"},
        { "location": "776/TALK"  , "narrator": "ガブリエラ", "text": "とてもとてもとても\n嬉しかったの。"},
        { "location": "777/TALK"  , "narrator": "ガブリエラ", "text": "ありがとう。"},
        { "location": "782/TALK"  , "narrator": "ガブリエラ", "text": "この先がどうなるかは\n$handle$にすら\nわからない。"},
        { "location": "783/TALK"  , "narrator": "ガブリエラ", "text": "でもあたしね。"},
        { "location": "784/TALK"  , "narrator": "ガブリエラ", "text": "$handle$の\n決断は正しいって\n信じてる。"},
        { "location": "785/TALK"  , "narrator": "ガブリエラ", "text": "あたしをずっと見てて。\n別のあたしも知ってて。"},
        { "location": "786/TALK"  , "narrator": "ガブリエラ", "text": "色んなことを考えて。\n真面目に出した\n答えなんでしょ。"},
        { "location": "787/TALK"  , "narrator": "ガブリエラ", "text": "普段はふざけたこと\nばかり言ってても。"},
        { "location": "788/TALK"  , "narrator": "ガブリエラ", "text": "ピンチの時は必ず\nあたしを助けてくれた。"},
        { "location": "789/TALK"  , "narrator": "ガブリエラ", "text": "あたしが泣きそうな夜は\nずっとそばに\nついててくれた。"},
        { "location": "790/TALK"  , "narrator": "ガブリエラ", "text": "そんな$handle$が\n出した答えだもの。"},
        { "location": "791/TALK"  , "narrator": "ガブリエラ", "text": "どんなだったとしても\n正解以外の\n答えはないわ。"},
        { "location": "794/SEL"   , "narrator": "", "text": "ありがとう"},
        { "location": "795/SEL"   , "narrator": "", "text": "ごめんね"},
        { "location": "796/SEL"   , "narrator": "", "text": "幸せになって"},
        { "location": "797/ACT"   , "narrator": "", "text": "ありがとう"},
        { "location": "798/TALK"  , "narrator": "ガブリエラ", "text": "少しだけさよならね。"},
        { "location": "799/ACT"   , "narrator": "", "text": "ごめんね"},
        { "location": "800/TALK"  , "narrator": "ガブリエラ", "text": "…なんで謝るの？"},
        { "location": "801/ACT"   , "narrator": "", "text": "幸せになって"},
        { "location": "802/TALK"  , "narrator": "ガブリエラ", "text": "…なるに決まってる。"},
        { "location": "805/SEL"   , "narrator": "", "text": "ありがとう"},
        { "location": "806/SEL"   , "narrator": "", "text": "ごめんね"},
        { "location": "807/SEL"   , "narrator": "", "text": "幸せになって"},
        { "location": "808/ACT"   , "narrator": "", "text": "ありがとう"},
        { "location": "809/TALK"  , "narrator": "ガブリエラ", "text": "それはあたしの\n台詞だわ。"},
        { "location": "810/TALK"  , "narrator": "ガブリエラ", "text": "ありがとう\n$handle$。"},
        { "location": "811/ACT"   , "narrator": "", "text": "ごめんね"},
        { "location": "812/TALK"  , "narrator": "ガブリエラ", "text": "変なこと言うのね。"},
        { "location": "813/TALK"  , "narrator": "ガブリエラ", "text": "$handle$は\n悪いことなんて\nしてないでしょ？"},
        { "location": "814/ACT"   , "narrator": "", "text": "幸せになって"},
        { "location": "815/TALK"  , "narrator": "ガブリエラ", "text": "当然よ！"},
        { "location": "816/TALK"  , "narrator": "ガブリエラ", "text": "でもそのためには\n$handle$が\n必要なの！"},
        { "location": "649/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:Interrupt】</color>\nSystem Interrupted.\n\n必須選択肢が選ばれていません。\n\n<color=green>『STORY27：シン・カグラ』</color>\nにて、選択を行ってから\n再度アクセスしてください。\n"},
