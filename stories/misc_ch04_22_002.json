    "entry":
    [
        { "location": "93/SCENARIO", "narrator": "", "text": "胸の内、隠し事"},
        { "location": "120/TALK"   , "narrator": "みやび", "text": "誰の心の中にも"},
        { "location": "121/TALK"   , "narrator": "みやび", "text": "不可侵の領域があるのだ"},
        { "location": "123/SEL"    , "narrator": "", "text": "そうだね"},
        { "location": "124/SEL"    , "narrator": "", "text": "むしろそこを暴きたい"},
        { "location": "125/SEL"    , "narrator": "", "text": "$me$はみやびに全部を見せるよ"},
        { "location": "126/ACT"    , "narrator": "", "text": "そうだね"},
        { "location": "127/TALK"   , "narrator": "みやび", "text": "そうなのだ"},
        { "location": "128/TALK"   , "narrator": "みやび", "text": "そこには触れず"},
        { "location": "129/TALK"   , "narrator": "みやび", "text": "そっと見守るがよかろうぞ"},
        { "location": "130/ACT"    , "narrator": "", "text": "むしろそこを暴きたい"},
        { "location": "131/TALK"   , "narrator": "みやび", "text": "ああ"},
        { "location": "132/TALK"   , "narrator": "みやび", "text": "そう思うこともあるぞね"},
        { "location": "133/TALK"   , "narrator": "みやび", "text": "だが"},
        { "location": "134/TALK"   , "narrator": "みやび", "text": "感心せん"},
        { "location": "135/TALK"   , "narrator": "みやび", "text": "自分自身が同じことをされたら"},
        { "location": "136/TALK"   , "narrator": "みやび", "text": "と思ったが"},
        { "location": "137/TALK"   , "narrator": "みやび", "text": "そういうのに快楽を憶える口なら"},
        { "location": "138/TALK"   , "narrator": "みやび", "text": "仕方ないぞね"},
        { "location": "139/ACT"    , "narrator": "", "text": "$me$はみやびに全部を見せるよ"},
        { "location": "141/TALK"   , "narrator": "みやび", "text": "なるほど"},
        { "location": "142/TALK"   , "narrator": "みやび", "text": "その覚悟があるということか"},
        { "location": "143/TALK"   , "narrator": "みやび", "text": "しかしだ"},
        { "location": "144/TALK"   , "narrator": "みやび", "text": "プライベートは"},
        { "location": "146/TALK"   , "narrator": "みやび", "text": "大事にするべきだ"},
        { "location": "147/TALK"   , "narrator": "みやび", "text": "相棒"}
    ]
}
