        "title": "009 ココロスフィアストーリー【Lv03】",
        "sub_title": "壊されるココロⅡ＜帰結＞"
    },
    "entry":
    [
        { "location": "62/SCENARIO", "narrator": "", "text": "壊されるココロ４"},
        { "location": "77/TALK"    , "narrator": "ガブリエラ", "text": "やったわ！\nガーディアンクランを\n倒せたっ！"},
        { "location": "78/TALK"    , "narrator": "ガブリエラ", "text": "これで後は\n本体をぶっ壊せば！"},
        { "location": "89/TALK"    , "narrator": "ガブリエラ", "text": "ひっ！！"},
        { "location": "90/TALK"    , "narrator": "ガブリエラ", "text": "あんた誰よ！"},
        { "location": "91/TALK"    , "narrator": "？？？", "text": "あたし　は　あなた"},
        { "location": "92/TALK"    , "narrator": "？？？", "text": "とらうま　に\nおびえる　あなた"},
        { "location": "93/TALK"    , "narrator": "ガブリエラ", "text": "……　…っ…"},
        { "location": "94/SEL"     , "narrator": "（選択肢）", "text": "ガブリエラ？？"},
        { "location": "95/ACT"     , "narrator": "", "text": "ガブリエラ？？"},
        { "location": "97/TALK"    , "narrator": "？？？", "text": "あたし　を\nけそうと　するの？"},
        { "location": "98/TALK"    , "narrator": "？？？", "text": "それが　なにを\nいみ　するか"},
        { "location": "99/TALK"    , "narrator": "？？？", "text": "いま\nおしえて　あげる"},
        { "location": "100/SEL"    , "narrator": "（選択肢）", "text": "去れ！！！"},
        { "location": "115/TALK"   , "narrator": "ガブリエラ", "text": "いやああああああああ\nああああああああああ\nあああああああっ！！"},
        { "location": "130/TALK"   , "narrator": "ガブリエラ", "text": "…うっ……\n…　ううっ…ぐすっ…"},
        { "location": "131/SEL"    , "narrator": "（選択肢）", "text": "大丈夫！？"},
        { "location": "132/ACT"    , "narrator": "", "text": "大丈夫！？"},
        { "location": "134/TALK"   , "narrator": "ガブリエラ", "text": "もう……っ…\nぐすっ…"},
        { "location": "135/TALK"   , "narrator": "ガブリエラ", "text": "……しにたい…　…"},
        { "location": "136/ACT"    , "narrator": "", "text": "去れ！！！"},
        { "location": "157/TALK"   , "narrator": "ガブリエラ", "text": "…っ……はぁ…\n……　…っ…はぁっ…"},
        { "location": "158/TALK"   , "narrator": "ガブリエラ", "text": "あんたが…っ……\n助けてくれたの…？"},
        { "location": "159/SEL"    , "narrator": "（選択肢）", "text": "多分"},
        { "location": "160/ACT"    , "narrator": "", "text": "多分"},
        { "location": "162/TALK"   , "narrator": "ガブリエラ", "text": "……ありがと…"},
        { "location": "163/SEL"    , "narrator": "（選択肢）", "text": "大丈夫？"},
        { "location": "164/ACT"    , "narrator": "", "text": "大丈夫？"},
        { "location": "166/TALK"   , "narrator": "ガブリエラ", "text": "うん……\nもう平気。"},
        { "location": "167/TALK"   , "narrator": "ガブリエラ", "text": "でも……"},
        { "location": "168/TALK"   , "narrator": "ガブリエラ", "text": "やっぱりトラウマを\n自分で破壊するなんて\n無理なのかしら……"},
        { "location": "169/SEL"    , "narrator": "（選択肢）", "text": "まだ何か方法があるかもしれない"},
        { "location": "170/ACT"    , "narrator": "", "text": "まだ何か方法があるかもしれない"},
        { "location": "172/TALK"   , "narrator": "ガブリエラ", "text": "……うん。\nそうね。"},
        { "location": "173/TALK"   , "narrator": "ガブリエラ", "text": "でも、どうして\nあんたは、あたしに\n力を貸してくれるの？"},
        { "location": "174/SEL"    , "narrator": "（選択肢）", "text": "好きだから"},
        { "location": "175/SEL"    , "narrator": "（選択肢）", "text": "なんか気になる"},
        { "location": "176/ACT"    , "narrator": "", "text": "好きだから"},
        { "location": "178/TALK"   , "narrator": "ガブリエラ", "text": "ええっ！？\nちょっと何を急に\n言い出すのよ！"},
        { "location": "179/TALK"   , "narrator": "ガブリエラ", "text": "でも、ありがと。\n純粋に嬉しい。"},
        { "location": "180/TALK"   , "narrator": "ガブリエラ", "text": "と、とにかく\nこのままここにいても\n仕方ないわね。"},
        { "location": "181/TALK"   , "narrator": "ガブリエラ", "text": "あたしももっと\n強くならなくちゃ\nいけないと思うし――"},
        { "location": "182/TALK"   , "narrator": "ガブリエラ", "text": "また準備ができたら\n作戦を考えたいの。"},
        { "location": "183/TALK"   , "narrator": "ガブリエラ", "text": "その時はまた、\nよければ、その――"},
        { "location": "184/TALK"   , "narrator": "ガブリエラ", "text": "つ、つきあって\n欲しいかも……。"},
        { "location": "185/SEL"    , "narrator": "（選択肢）", "text": "もちろん"},
        { "location": "186/ACT"    , "narrator": "", "text": "もちろん"},
        { "location": "189/TALK"   , "narrator": "ガブリエラ", "text": "ありがとう。\nまたよろしくね。"},
        { "location": "190/ACT"    , "narrator": "", "text": "なんか気になる"},
        { "location": "191/TALK"   , "narrator": "ガブリエラ", "text": "そっか…。でも\n無理はしないで。"},
        { "location": "192/TALK"   , "narrator": "ガブリエラ", "text": "気が向いたら\nまたつき合ってよね。"}
    ]
}
