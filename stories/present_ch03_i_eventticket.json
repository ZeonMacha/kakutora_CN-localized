        { "location": "132/TALK", "narrator": "ガブリエラ", "text": "あら、このイベント"},
        { "location": "134/TALK", "narrator": "ガブリエラ", "text": "嬉しいわ"},
        { "location": "135/TALK", "narrator": "ガブリエラ", "text": "丁度見に行きたいと思ってたの"},
        { "location": "138/SEL" , "narrator": "", "text": "イベントにはよく行くの？"},
        { "location": "139/ACT" , "narrator": "", "text": "イベントにはよく行くの？"},
        { "location": "142/TALK", "narrator": "ガブリエラ", "text": "興味があるのだけよ"},
        { "location": "143/TALK", "narrator": "ガブリエラ", "text": "展示会とかお祭りとか"},
        { "location": "144/TALK", "narrator": "ガブリエラ", "text": "日本の文化が見れるイベント限定だけどね"},
        { "location": "147/SEL" , "narrator": "", "text": "それ以外は？"},
        { "location": "148/ACT" , "narrator": "", "text": "それ以外は？"},
        { "location": "151/TALK", "narrator": "ガブリエラ", "text": "それ以外はあまり行かないけど"},
        { "location": "152/TALK", "narrator": "ガブリエラ", "text": "興味があれば行くようにしてるわ"},
        { "location": "153/TALK", "narrator": "ガブリエラ", "text": "そういえば"},
        { "location": "154/TALK", "narrator": "ガブリエラ", "text": "この前相撲のチケットを買ったんだったわ"},
        { "location": "155/TALK", "narrator": "ガブリエラ", "text": "まずはそっちから先に使うことになりそうね"}
    ]
