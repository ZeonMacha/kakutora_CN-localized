    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "野暮でもいいのに"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "みんなとテーマパーク行ったの"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "楽しかったけど"},
        { "location": "34/TALK"   , "narrator": "ガブリエラ", "text": "それだけじゃなくて"},
        { "location": "35/TALK"   , "narrator": "ガブリエラ", "text": "やっぱり"},
        { "location": "36/TALK"   , "narrator": "ガブリエラ", "text": "ちゃんとお礼を言った方が"},
        { "location": "37/TALK"   , "narrator": "ガブリエラ", "text": "よかったんじゃないかしら"},
        { "location": "39/SEL"    , "narrator": "", "text": "そのうち恩返ししよう"},
        { "location": "40/SEL"    , "narrator": "", "text": "伝わってると思うよ？"},
        { "location": "41/SEL"    , "narrator": "", "text": "全部解決したら言えばいい"},
        { "location": "42/ACT"    , "narrator": "", "text": "そのうち恩返ししよう"},
        { "location": "44/TALK"   , "narrator": "ガブリエラ", "text": "恩返し"},
        { "location": "46/TALK"   , "narrator": "ガブリエラ", "text": "恩返しね"},
        { "location": "47/TALK"   , "narrator": "ガブリエラ", "text": "何がいいかしら"},
        { "location": "49/SEL"    , "narrator": "", "text": "お菓子とか"},
        { "location": "50/SEL"    , "narrator": "", "text": "ガブリエラのキス"},
        { "location": "51/SEL"    , "narrator": "", "text": "詩を書いてあげれば"},
        { "location": "52/ACT"    , "narrator": "", "text": "お菓子とか"},
        { "location": "53/TALK"   , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "55/TALK"   , "narrator": "ガブリエラ", "text": "それがいいかも"},
        { "location": "56/TALK"   , "narrator": "ガブリエラ", "text": "何を作ろうかしら"},
        { "location": "57/TALK"   , "narrator": "ガブリエラ", "text": "楽しみだわ"},
        { "location": "58/ACT"    , "narrator": "", "text": "ガブリエラのキス"},
        { "location": "59/TALK"   , "narrator": "ガブリエラ", "text": "何を言い出すの！？"},
        { "location": "60/TALK"   , "narrator": "ガブリエラ", "text": "日本でキスは特別な意味でしょ！"},
        { "location": "61/TALK"   , "narrator": "ガブリエラ", "text": "そんなことしないわよ"},
        { "location": "62/TALK"   , "narrator": "ガブリエラ", "text": "もう！"},
        { "location": "63/ACT"    , "narrator": "", "text": "詩を書いてあげれば"},
        { "location": "64/TALK"   , "narrator": "ガブリエラ", "text": "それはちょっと"},
        { "location": "66/TALK"   , "narrator": "ガブリエラ", "text": "恥ずかしいわ"},
        { "location": "67/TALK"   , "narrator": "ガブリエラ", "text": "だからやめておくわね"},
        { "location": "69/ACT"    , "narrator": "", "text": "伝わってると思うよ？"},
        { "location": "70/TALK"   , "narrator": "ガブリエラ", "text": "それは"},
        { "location": "71/TALK"   , "narrator": "ガブリエラ", "text": "そうだと思うけど"},
        { "location": "72/TALK"   , "narrator": "ガブリエラ", "text": "やっぱりお礼を言わないと"},
        { "location": "73/TALK"   , "narrator": "ガブリエラ", "text": "落ち着かないわ"},
        { "location": "74/TALK"   , "narrator": "ガブリエラ", "text": "改まっていうのは"},
        { "location": "75/TALK"   , "narrator": "ガブリエラ", "text": "少し恥ずかしいけど・・・"},
        { "location": "76/ACT"    , "narrator": "", "text": "全部解決したら言えばいい"},
        { "location": "77/TALK"   , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "79/TALK"   , "narrator": "ガブリエラ", "text": "それがいいわ"},
        { "location": "80/TALK"   , "narrator": "ガブリエラ", "text": "そのためには色々準備しないとね"}
    ]
