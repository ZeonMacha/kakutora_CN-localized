{
    "dir": "chap00/daydra/spev_ch04_004.js",
    "type": "",
    "info": {
        "story_id": "4004",
        "cid": "",
        "title": "スペシャルエピソード",
        "sub_title": "カーテンの向こうから"
    },
    "entry":
    [
        { "location": "15/TALK" , "narrator": "透明みやび", "text": "うーむ…。"},
        { "location": "16/TALK" , "narrator": "透明みやび", "text": "何とも変な感じやけんど、\nこれ、大丈夫なんやろか？"},
        { "location": "17/TALK" , "narrator": "透明みやび", "text": "相棒、言われた通り\n着てみたけんど、\nやはり脱いでえい？"},
        { "location": "18/SEL"  , "narrator": "（選択肢）", "text": "見せてくれた後でね"},
        { "location": "19/ACT"  , "narrator": "", "text": "見せてくれた後でね"},
        { "location": "22/TALK" , "narrator": "透明みやび", "text": "何という鬼畜な所業。\n相棒のそういうところ、\n嫌いではないけんど…。"},
        { "location": "23/TALK" , "narrator": "透明みやび", "text": "目が潰れても、\n慰謝料は払わんぞ？"},
        { "location": "36/TALK" , "narrator": "透明みやび", "text": "はぁ…どうや？\nこれで満足か？"},
        { "location": "37/SEL"  , "narrator": "（選択肢）", "text": "和服以外のみやび、レアだ！"},
        { "location": "38/ACT"  , "narrator": "", "text": "和服以外のみやび、レアだ！"},
        { "location": "41/TALK" , "narrator": "透明みやび", "text": "相棒が見たい言うたき、\n仕方なく着てやっちょるん\nやろうが。"},
        { "location": "43/TALK" , "narrator": "透明みやび", "text": "…しっかし、洋服なんぞ\nまともに着たん、\nどれくらいぶりやろ？"},
        { "location": "44/TALK" , "narrator": "透明みやび", "text": "相変わらず窮屈で、\nまるで拘束されちょる\n気分になる服や…。"},
        { "location": "45/TALK" , "narrator": "透明みやび", "text": "まっこと、みんなは\nよくこんなもん着れると\n不思議でならん。"},
        { "location": "46/SEL"  , "narrator": "（選択肢）", "text": "でも、カワイイよ"},
        { "location": "47/ACT"  , "narrator": "", "text": "でも、カワイイよ"},
        { "location": "50/TALK" , "narrator": "透明みやび", "text": "…マジで言うてる？"},
        { "location": "52/TALK" , "narrator": "透明みやび", "text": "うちにはこんな服の\nどこがえいのか、\nさっぱりわからんがよ。"},
        { "location": "53/TALK" , "narrator": "透明みやび", "text": "…ちゅうか、\nぶっちゃけお世辞やろ？"},
        { "location": "54/TALK" , "narrator": "透明みやび", "text": "和服以外は似合わんとか\n思うてるんちゃう？"},
        { "location": "55/SEL"  , "narrator": "（選択肢）", "text": "和服より似合ってると思う"},
        { "location": "56/SEL"  , "narrator": "（選択肢）", "text": "和服も洋服も似合うと思う"},
        { "location": "57/ACT"  , "narrator": "", "text": "和服より似合ってると思う"},
        { "location": "59/TALK" , "narrator": "透明みやび", "text": "うーん…それはそれで\nちくっと引っかかるんや\nけんど…。"},
        { "location": "60/TALK" , "narrator": "透明みやび", "text": "まあ、褒め言葉には\n違いないき、\n素直に喜ぶとするぞね。"},
        { "location": "61/ACT"  , "narrator": "", "text": "和服も洋服も似合うと思う"},
        { "location": "62/TALK" , "narrator": "透明みやび", "text": "うち、和服も洋服もいける\nハイブリッドな女\nやったんか…。"},
        { "location": "63/TALK" , "narrator": "透明みやび", "text": "それはビックリ、大発見。\nうちは新たな自分を\n知ることに成功した。"},
        { "location": "66/TALK" , "narrator": "透明みやび", "text": "…ちゅうか、いい加減\n引っ込んでえいか？"},
        { "location": "67/SEL"  , "narrator": "（選択肢）", "text": "可愛い姿、もっと見たい"},
        { "location": "68/ACT"  , "narrator": "", "text": "可愛い姿、もっと見たい"},
        { "location": "70/TALK" , "narrator": "透明みやび", "text": "いや、そう可愛い\n連呼されるんも困る\nっちゅうか…。"},
        { "location": "71/TALK" , "narrator": "透明みやび", "text": "ほれ、わかるやろ？\n窮屈で息苦しいんよ。"},
        { "location": "72/TALK" , "narrator": "透明みやび", "text": "やき、そろそろ脱いで\n肺いっぱいに空気を\n吸い込みたいちや。"},
        { "location": "73/SEL"  , "narrator": "（選択肢）", "text": "今日はその格好でいてほしい"},
        { "location": "74/SEL"  , "narrator": "（選択肢）", "text": "照れてる？"},
        { "location": "75/ACT"  , "narrator": "", "text": "今日はその格好でいてほしい"},
        { "location": "78/TALK" , "narrator": "透明みやび", "text": "…マジで言うてるが？"},
        { "location": "79/TALK" , "narrator": "透明みやび", "text": "別に、服なんぞ洋服や\nなくても構わんやろ。"},
        { "location": "80/TALK" , "narrator": "透明みやび", "text": "それともあれか？"},
        { "location": "81/TALK" , "narrator": "透明みやび", "text": "相棒は和服女は\n嫌いなが？"},
        { "location": "82/ACT"  , "narrator": "", "text": "照れてる？"},
        { "location": "84/TALK" , "narrator": "透明みやび", "text": "…………。"},
        { "location": "85/TALK" , "narrator": "透明みやび", "text": "いや、恥ずかしいだけや。"},
        { "location": "86/TALK" , "narrator": "透明みやび", "text": "こんな肩やら足やらが\n出まくりの服着れば、\n当然のことやろ？"},
        { "location": "87/SEL"  , "narrator": "（選択肢）", "text": "露出少ない服を選ぶよ"},
        { "location": "88/ACT"  , "narrator": "", "text": "露出少ない服を選ぶよ"},
        { "location": "92/TALK" , "narrator": "透明みやび", "text": "ちょ！？　いやいや、\nそういうことを言うてる\nわけやなくて！"},
        { "location": "93/TALK" , "narrator": "透明みやび", "text": "ちゅうか、うちのこと\nからかっちゅうやろ？"},
        { "location": "95/SEL"  , "narrator": "（選択肢）", "text": "今のみやび、すごく可愛くて"},
        { "location": "96/ACT"  , "narrator": "", "text": "今のみやび、すごく可愛くて"},
        { "location": "98/TALK" , "narrator": "透明みやび", "text": "いや、もう可愛い\n言うのやめぃ。"},
        { "location": "99/TALK" , "narrator": "透明みやび", "text": "そんな何度も言われると、\nむずむずした気持ちに\nなるき…。"},
        { "location": "100/SEL" , "narrator": "（選択肢）", "text": "でも、本当可愛くて…"},
        { "location": "101/SEL" , "narrator": "（選択肢）", "text": "じゃあ、素敵だよ"},
        { "location": "102/ACT" , "narrator": "", "text": "でも、本当可愛くて…"},
        { "location": "103/TALK", "narrator": "透明みやび", "text": "やき、可愛いはもう――"},
        { "location": "105/TALK", "narrator": "透明みやび", "text": "…いや、もうえい。\nわかった、これ以上は\n文句言わん。"},
        { "location": "106/ACT" , "narrator": "", "text": "じゃあ、素敵だよ"},
        { "location": "107/TALK", "narrator": "透明みやび", "text": "っ！？"},
        { "location": "110/TALK", "narrator": "透明みやび", "text": "…あー…素敵なぁ…。"},
        { "location": "111/TALK", "narrator": "透明みやび", "text": "んー……。"},
        { "location": "112/TALK", "narrator": "透明みやび", "text": "…いや、考えるのやめや。\nちゅうか、顔熱くて\n何も思いつかんし。"},
        { "location": "113/TALK", "narrator": "透明みやび", "text": "わかった、もうこれ以上\n服について文句は言わん。"},
        { "location": "115/TALK", "narrator": "透明みやび", "text": "今日一日、この服着て\nデートしちゃる。"},
        { "location": "117/TALK", "narrator": "透明みやび", "text": "やき、これ以上\n可愛い言うんは禁止な。"},
        { "location": "118/TALK", "narrator": "透明みやび", "text": "それでどうや？"},
        { "location": "119/SEL" , "narrator": "（選択肢）", "text": "自然に言っちゃうかも"},
        { "location": "120/ACT" , "narrator": "", "text": "自然に言っちゃうかも"},
        { "location": "122/TALK", "narrator": "透明みやび", "text": "その時はペナルティとして\n相棒の個人情報が一つずつ\nネットに流れるぞね。"},
        { "location": "123/TALK", "narrator": "透明みやび", "text": "ほれ、いつまでも更衣室で\n漫才やっちょったら、\n店に迷惑かかる。"},
        { "location": "125/TALK", "narrator": "透明みやび", "text": "時間も勿体ないし、\nデートのつづきを\n楽しむとするがよ。"},
        { "location": "139/SEL" , "narrator": "（選択肢）", "text": "こんなデートをしたいんだ！"},
        { "location": "140/ACT" , "narrator": "", "text": "こんなデートをしたいんだ！"},
        { "location": "142/TALK", "narrator": "みやび", "text": "なるほどなるほど"},
        { "location": "143/TALK", "narrator": "みやび", "text": "理解した"},
        { "location": "144/TALK", "narrator": "みやび", "text": "うちの感想を言わせてもらうと"},
        { "location": "145/TALK", "narrator": "みやび", "text": "映"},
        { "location": "146/TALK", "narrator": "みやび", "text": "画"},
        { "location": "147/TALK", "narrator": "みやび", "text": "化"},
        { "location": "148/TALK", "narrator": "みやび", "text": "決"},
        { "location": "149/TALK", "narrator": "みやび", "text": "定"},
        { "location": "151/TALK", "narrator": "みやび", "text": "と言いたくなるレベルの"},
        { "location": "152/TALK", "narrator": "みやび", "text": "見事なフィクション"},
        { "location": "153/TALK", "narrator": "みやび", "text": "妄想ストーリー"},
        { "location": "154/TALK", "narrator": "みやび", "text": "相棒には"},
        { "location": "155/TALK", "narrator": "みやび", "text": "一流妄想家の称号を与えよう"},
        { "location": "158/SEL" , "narrator": "（選択肢）", "text": "現実になりませんか？"},
        { "location": "159/ACT" , "narrator": "", "text": "現実になりませんか？"},
        { "location": "161/TALK", "narrator": "みやび", "text": "人間に不可能はない"},
        { "location": "162/TALK", "narrator": "みやび", "text": "頑張れ"},
        { "location": "163/TALK", "narrator": "みやび", "text": "うちも洋服着たくないので"},
        { "location": "164/TALK", "narrator": "みやび", "text": "実現しないよう頑張る"},
        { "location": "165/TALK", "narrator": "みやび", "text": "互いに頑張ろう"}
    ]
}
