        "title": "002 メインストーリー",
        "sub_title": "再交渉＜前編＞"
    },
    "entry":
    [
        { "location": "2964/TALK"  , "narrator": "千羽鶴", "text": "はぁ……。"},
        { "location": "2965/TALK"  , "narrator": "千羽鶴", "text": "息つく暇も無いとは\nまさにこのこと。"},
        { "location": "2966/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "2967/TALK"  , "narrator": "千羽鶴", "text": "クランだって、\n休みたい時はある！"},
        { "location": "2968/TALK"  , "narrator": "千羽鶴", "text": "どーん！"},
        { "location": "2969/TALK"  , "narrator": "千羽鶴", "text": "なんて――"},
        { "location": "2970/SEL"   , "narrator": "", "text": "リアルどーんキター！"},
        { "location": "2971/SEL"   , "narrator": "", "text": "お疲れさまです！"},
        { "location": "2972/ACT"   , "narrator": "", "text": "リアルどーんキター！"},
        { "location": "2981/TALK"  , "narrator": "千羽鶴", "text": "ここは情報管理庁"},
        { "location": "2982/TALK"  , "narrator": "千羽鶴", "text": "私は長官"},
        { "location": "2983/TALK"  , "narrator": "千羽鶴", "text": "よって、そういったWAVEを送ってこないで欲しい"},
        { "location": "2984/TALK"  , "narrator": "千羽鶴", "text": "バレたら公務員の職務専念義務違反を追求されかねない"},
        { "location": "2986/SEL"   , "narrator": "", "text": "$me$は千羽鶴の任務の結果として存在する成果物である故大丈夫"},
        { "location": "2987/ACT"   , "narrator": "", "text": "$me$は千羽鶴の任務の結果として存在する成果物である故大丈夫"},
        { "location": "2989/TALK"  , "narrator": "千羽鶴", "text": "なるほど"},
        { "location": "2990/TALK"  , "narrator": "千羽鶴", "text": "一理を通り越して五里くらいある"},
        { "location": "2991/TALK"  , "narrator": "千羽鶴", "text": "ゴリゴリ"},
        { "location": "2992/ACT"   , "narrator": "", "text": "お疲れさまです！"},
        { "location": "3001/TALK"  , "narrator": "千羽鶴", "text": "ありがとう"},
        { "location": "3002/TALK"  , "narrator": "千羽鶴", "text": "勤務中なのでこれで"},
        { "location": "3005/SEL"   , "narrator": "", "text": "クランだって休もうよ"},
        { "location": "3006/ACT"   , "narrator": "", "text": "クランだって休もうよ"},
        { "location": "3008/TALK"  , "narrator": "千羽鶴", "text": "そういうわけにはいかない"},
        { "location": "3009/TALK"  , "narrator": "千羽鶴", "text": "私は長官だから"},
        { "location": "3010/TALK"  , "narrator": "千羽鶴", "text": "ていうか、貴方は本当に$handle$？"},
        { "location": "3012/SEL"   , "narrator": "", "text": "そうだよ"},
        { "location": "3013/ACT"   , "narrator": "", "text": "そうだよ"},
        { "location": "3015/TALK"  , "narrator": "千羽鶴", "text": "よくよく考えずともWAVEアカウント教えた記憶がない"},
        { "location": "3017/SEL"   , "narrator": "", "text": "未来の千羽鶴から教えてもらったんだよ"},
        { "location": "3018/ACT"   , "narrator": "", "text": "未来の千羽鶴から教えてもらったんだよ"},
        { "location": "3020/TALK"  , "narrator": "千羽鶴", "text": "なるほど"},
        { "location": "3021/TALK"  , "narrator": "千羽鶴", "text": "貴方がそう言うならそうなんでしょう"},
        { "location": "3023/SEL"   , "narrator": "", "text": "根を詰めると身体に毒だよ、遊びに行こうよ"},
        { "location": "3024/ACT"   , "narrator": "", "text": "根を詰めると身体に毒だよ、遊びに行こうよ"},
        { "location": "3026/TALK"  , "narrator": "千羽鶴", "text": "パパラッチに追われて貴方と一緒にサボってるところを激写されて"},
        { "location": "3027/TALK"  , "narrator": "千羽鶴", "text": "あとでそれを元に糾弾されたり裁判に掛けられたり"},
        { "location": "3028/TALK"  , "narrator": "千羽鶴", "text": "更迭されたらどうするの？"},
        { "location": "3030/SEL"   , "narrator": "", "text": "一緒に激写されることはない！悲しいけど"},
        { "location": "3031/SEL"   , "narrator": "", "text": "籍を入れて一生幸せにします！"},
        { "location": "3032/ACT"   , "narrator": "", "text": "一緒に激写されることはない！悲しいけど"},
        { "location": "3033/TALK"  , "narrator": "千羽鶴", "text": "あ、そういえばそうね、$handle$は頭がいい"},
        { "location": "3034/TALK"  , "narrator": "千羽鶴", "text": "けどやっぱり、一人だとしても仕事をサボっているところを見られたら大変"},
        { "location": "3035/ACT"   , "narrator": "", "text": "籍を入れて一生幸せにします！"},
        { "location": "3037/TALK"  , "narrator": "千羽鶴", "text": "それもいいかも"},
        { "location": "3038/TALK"  , "narrator": "千羽鶴", "text": "じゃあその一環として"},
        { "location": "3039/TALK"  , "narrator": "千羽鶴", "text": "早くこっちの世界に来て"},
        { "location": "3041/TALK"  , "narrator": "千羽鶴", "text": "と言いたいところだけど、そもそもそれは長期計画であって今この瞬間の私の疲れをどうにかできるものじゃない"},
        { "location": "3044/SEL"   , "narrator": "", "text": "じゃあ、公務ならいいんでしょ？"},
        { "location": "3045/ACT"   , "narrator": "", "text": "じゃあ、公務ならいいんでしょ？"},
        { "location": "3047/TALK"  , "narrator": "千羽鶴", "text": "もちろん"},
        { "location": "3049/SEL"   , "narrator": "", "text": "ならば、$me$と実地調査に行きましょう"},
        { "location": "3050/ACT"   , "narrator": "", "text": "ならば、$me$と実地調査に行きましょう"},
        { "location": "3052/TALK"  , "narrator": "千羽鶴", "text": "どこへ？"},
        { "location": "3053/TALK"  , "narrator": "千羽鶴", "text": "どんな用件で？"},
        { "location": "3055/SEL"   , "narrator": "", "text": "フェノメノンの発生ポイントの視察とそれによる発生分布の分析、今後の予測"},
        { "location": "3056/ACT"   , "narrator": "", "text": "フェノメノンの発生ポイントの視察とそれによる発生分布の分析、今後の予測"},
        { "location": "3058/TALK"  , "narrator": "千羽鶴", "text": "なるほど"},
        { "location": "3059/TALK"  , "narrator": "千羽鶴", "text": "でもなぜ貴方と？"},
        { "location": "3061/SEL"   , "narrator": "", "text": "千羽鶴は公務効率化の為に$me$と接続したのでは？"},
        { "location": "3062/SEL"   , "narrator": "", "text": "今、その調査が重要であると$me$が判断したからです！"},
        { "location": "3063/ACT"   , "narrator": "", "text": "千羽鶴は公務効率化の為に$me$と接続したのでは？"},
        { "location": "3064/TALK"  , "narrator": "千羽鶴", "text": "正論"},
        { "location": "3065/TALK"  , "narrator": "千羽鶴", "text": "けど"},
        { "location": "3067/TALK"  , "narrator": "千羽鶴", "text": "むー"},
        { "location": "3068/ACT"   , "narrator": "", "text": "今、その調査が重要であると$me$が判断したからです！"},
        { "location": "3069/TALK"  , "narrator": "千羽鶴", "text": "なるほど"},
        { "location": "3070/TALK"  , "narrator": "千羽鶴", "text": "超的存在からの命令では仕方がない"},
        { "location": "3072/TALK"  , "narrator": "千羽鶴", "text": "けど"},
        { "location": "3097/TALK"  , "narrator": "神楽", "text": "どうして！？"},
        { "location": "3098/TALK"  , "narrator": "千羽鶴", "text": "なにが？"},
        { "location": "3099/TALK"  , "narrator": "神楽", "text": "とぼけないで！"},
        { "location": "3100/TALK"  , "narrator": "神楽", "text": "海で、フェノメノンを\n壊した理由を\n聞いてるの！"},
        { "location": "3101/TALK"  , "narrator": "神楽", "text": "どうしてあんなこと\nしたの！？"},
        { "location": "3102/TALK"  , "narrator": "千羽鶴", "text": "…あの場で四人と\n戦っていたら…、\n貴方は勝っていた。"},
        { "location": "3103/TALK"  , "narrator": "千羽鶴", "text": "それに、あの時の\nクランの偏在の仕方を\n考えるに…。"},
        { "location": "3104/TALK"  , "narrator": "千羽鶴", "text": "恐らく、彼女たちは\n五体満足では\nいられなかったはず。"},
        { "location": "3105/TALK"  , "narrator": "千羽鶴", "text": "…そうなると、\n私自身の\n都合にも悪い。"},
        { "location": "3106/TALK"  , "narrator": "千羽鶴", "text": "だからフェノメノンを\n破壊し、\n貴方を隔離した。"},
        { "location": "3107/TALK"  , "narrator": "神楽", "text": "…でも、私を隔離する\n必要なんて――"},
        { "location": "3108/TALK"  , "narrator": "千羽鶴", "text": "必要はあった。"},
        { "location": "3109/TALK"  , "narrator": "千羽鶴", "text": "あれだけの状況を\n引き起こして\nおきながら…。"},
        { "location": "3110/TALK"  , "narrator": "千羽鶴", "text": "あの場に貴方を\n残していったら、\nどうなっていたか…。"},
        { "location": "3111/TALK"  , "narrator": "千羽鶴", "text": "彼女たちは、\n貴方を罰したんじゃ\nないかしら？"},
        { "location": "3112/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "3114/TALK"  , "narrator": "千羽鶴", "text": "よくて糾弾。\n悪くて、リンチされる\n可能性もあったはず。"},
        { "location": "3115/TALK"  , "narrator": "神楽", "text": "…わかってる。\nそんなの…。"},
        { "location": "3116/TALK"  , "narrator": "千羽鶴", "text": "でも、そうなれば\n貴方は再度発症する\n可能性もあった。"},
        { "location": "3117/TALK"  , "narrator": "千羽鶴", "text": "…私としては、\n生きてもらわなければ\nならない。"},
        { "location": "3118/TALK"  , "narrator": "千羽鶴", "text": "彼女たちにも、\n貴方にも…。"},
        { "location": "3119/TALK"  , "narrator": "千羽鶴", "text": "…いずれにせよ、\nフェノメノン中断の\n理由と…。"},
        { "location": "3120/TALK"  , "narrator": "千羽鶴", "text": "共通するということ。\n納得できたかしら？"},
        { "location": "3121/TALK"  , "narrator": "神楽", "text": "…わかりました。"},
        { "location": "3122/TALK"  , "narrator": "千羽鶴", "text": "そう…、それじゃあ、\n今度は私の番。"},
        { "location": "3123/TALK"  , "narrator": "千羽鶴", "text": "少なくとも私は、\n十分な時間を\n与えたうえで…。"},
        { "location": "3124/TALK"  , "narrator": "千羽鶴", "text": "フェノメノン\nアラートを発令した。"},
        { "location": "3125/TALK"  , "narrator": "千羽鶴", "text": "なのに、貴方は\n逢瀬つばめのことを\n破壊できなかった。"},
        { "location": "3126/TALK"  , "narrator": "千羽鶴", "text": "…どうして？\nいったい、\n何をしていたの？"},
        { "location": "3127/TALK"  , "narrator": "神楽", "text": "そ、それは…。"},
        { "location": "3128/TALK"  , "narrator": "千羽鶴", "text": "…まだ迷ってる？"},
        { "location": "3129/TALK"  , "narrator": "千羽鶴", "text": "言ったはず。\n逢瀬つばめを破壊する\nコトに関して…。"},
        { "location": "3130/TALK"  , "narrator": "千羽鶴", "text": "貴方にデメリットは、\n一切無い。"},
        { "location": "3131/TALK"  , "narrator": "千羽鶴", "text": "そして、逢瀬つばめに\n対して抱いている\n好意は。"},
        { "location": "3132/TALK"  , "narrator": "千羽鶴", "text": "現実ではない、\n作られた\nニセモノだと…。"},
        { "location": "3133/TALK"  , "narrator": "神楽", "text": "違う！"},
        { "location": "3134/TALK"  , "narrator": "神楽", "text": "あなたに言われて、\nずっと考えたわ。"},
        { "location": "3135/TALK"  , "narrator": "神楽", "text": "何度も頭を悩ませて、\n苦しみながら考えて、\n答えを出したの。"},
        { "location": "3136/TALK"  , "narrator": "神楽", "text": "例え今生きている\nつばめさんが\nニセモノだとしても。"},
        { "location": "3137/TALK"  , "narrator": "神楽", "text": "そのつばめさんと\n一緒に作ってきた\n思い出は、本物…。"},
        { "location": "3138/TALK"  , "narrator": "神楽", "text": "だからそれは、\n私の中で残る…。"},
        { "location": "3140/TALK"  , "narrator": "神楽", "text": "私が死ぬまで、一生、\n本物として残る…。"},
        { "location": "3141/TALK"  , "narrator": "神楽", "text": "私の、大切な\n思い出として…。"},
        { "location": "3142/TALK"  , "narrator": "千羽鶴", "text": "…………。"},
        { "location": "3144/TALK"  , "narrator": "神楽", "text": "わかってくれますか？"},
        { "location": "3145/TALK"  , "narrator": "千羽鶴", "text": "…理解不能。"},
        { "location": "3146/TALK"  , "narrator": "千羽鶴", "text": "貴方はもう少し、\n頭のいい子だと\n思っていたんだけど。"},
        { "location": "3147/TALK"  , "narrator": "千羽鶴", "text": "…まあ、いい。"},
        { "location": "3148/TALK"  , "narrator": "千羽鶴", "text": "少なくとも、貴方が\n契約違反をしたことに\n変わりはない。"},
        { "location": "3149/TALK"  , "narrator": "神楽", "text": "ふざけないで！！"},
        { "location": "3150/TALK"  , "narrator": "神楽", "text": "勝手にフェノメノンを\n破壊しておいて、\n契約違反ですって！？"},
        { "location": "3151/TALK"  , "narrator": "千羽鶴", "text": "認めないつもり？"},
        { "location": "3152/TALK"  , "narrator": "神楽", "text": "当然よ！！"},
        { "location": "3153/TALK"  , "narrator": "千羽鶴", "text": "…では聞くけど、\nあのまま一時間\n待っていたら…。"},
        { "location": "3154/TALK"  , "narrator": "千羽鶴", "text": "貴方は、逢瀬つばめを\n破壊した？"},
        { "location": "3155/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "3156/TALK"  , "narrator": "千羽鶴", "text": "例えニセモノでも、\n貴方にとっては\n本物の逢瀬つばめを。"},
        { "location": "3157/TALK"  , "narrator": "千羽鶴", "text": "貴方は、破壊してたと\n断言できる？"},
        { "location": "3158/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "3161/SEL"   , "narrator": "", "text": "契約違反じゃない"},
        { "location": "3162/ACT"   , "narrator": "", "text": "契約違反じゃない"},
        { "location": "3183/TALK"  , "narrator": "神楽", "text": "どうしてですか？"},
        { "location": "3184/SEL"   , "narrator": "", "text": "真幌から聞いたよね、千羽鶴は長官であることを偽ってた"},
        { "location": "3185/ACT"   , "narrator": "", "text": "真幌から聞いたよね、千羽鶴は長官であることを偽ってた"},
        { "location": "3188/TALK"  , "narrator": "神楽", "text": "確かにそうですけど"},
        { "location": "3191/TALK"  , "narrator": "神楽", "text": "それは前にも聞きましたけど"},
        { "location": "3193/TALK"  , "narrator": "神楽", "text": "でも、どうすれば"},
        { "location": "3195/SEL"   , "narrator": "", "text": "$me$を信じて任せて！"},
        { "location": "3196/ACT"   , "narrator": "", "text": "$me$を信じて任せて！"},
        { "location": "3249/TALK"  , "narrator": "月神楽", "text": "　"},
        { "location": "3273/TALK"  , "narrator": "月神楽", "text": "ようこそ、\n卯月神楽の\nココロスフィアへ♪"},
        { "location": "3275/TALK"  , "narrator": "月神楽", "text": "今宵の語りもまた、\n月神楽がお付き合い\n致します。"},
        { "location": "3276/SEL"   , "narrator": "", "text": "今日も綺麗だね"},
        { "location": "3277/SEL"   , "narrator": "", "text": "扉回さなくていいの？"},
        { "location": "3278/SEL"   , "narrator": "", "text": "ぴょんこから何か連絡は？"},
        { "location": "3279/ACT"   , "narrator": "", "text": "今日も綺麗だね"},
        { "location": "3281/TALK"  , "narrator": "月神楽", "text": "ふふふ～～♪\n嬉しいですっ！"},
        { "location": "3283/ACT"   , "narrator": "", "text": "扉回さなくていいの？"},
        { "location": "3284/TALK"  , "narrator": "月神楽", "text": "もちろん回しますよ？\nその時にはゲートに\n移動しますよ～♪"},
        { "location": "3286/ACT"   , "narrator": "", "text": "ぴょんこから何か連絡は？"},
        { "location": "3288/TALK"  , "narrator": "月神楽", "text": "はぁ……。\n一声目から\nぴょんこですか。"},
        { "location": "3289/TALK"  , "narrator": "月神楽", "text": "今のところ何の連絡も\nありませんよ。"},
        { "location": "3290/TALK"  , "narrator": "月神楽", "text": "何か来たら\nちゃんとお伝えしますし。"},
        { "location": "3291/TALK"  , "narrator": "月神楽", "text": "それより。"},
        { "location": "3292/TALK"  , "narrator": "月神楽", "text": "$handle$さん、\nデリカシーが無いって\n言われたりしませんか？"},
        { "location": "3293/TALK"  , "narrator": "月神楽", "text": "貴方にとっては一番大事な\nコトなのでしょうけど、\n会話にはリズムがある。"},
        { "location": "3294/TALK"  , "narrator": "月神楽", "text": "それを読めないと、\n人生苦労しますよ？"},
        { "location": "3295/SEL"   , "narrator": "", "text": "そういうの苦手なんだよね"},
        { "location": "3296/SEL"   , "narrator": "", "text": "余計なお世話だよ"},
        { "location": "3297/ACT"   , "narrator": "", "text": "そういうの苦手なんだよね"},
        { "location": "3299/TALK"  , "narrator": "月神楽", "text": "わかりますっ！\nでも安心してください♪"},
        { "location": "3300/TALK"  , "narrator": "月神楽", "text": "この月神楽が、\nこれから手取り足取り\n教えて差し上げます♪"},
        { "location": "3301/ACT"   , "narrator": "", "text": "余計なお世話だよ"},
        { "location": "3302/TALK"  , "narrator": "月神楽", "text": "はーん。"},
        { "location": "3303/TALK"  , "narrator": "月神楽", "text": "まあいいですけど。"},
        { "location": "3306/TALK"  , "narrator": "月神楽", "text": "さて――"},
        { "location": "3307/TALK"  , "narrator": "月神楽", "text": "今回はちゃんと、\n葛藤発生による割り込みで\nここに来てますよね♪"},
        { "location": "3308/TALK"  , "narrator": "月神楽", "text": "それじゃ早速、\n今回の葛藤を確認してから\n作戦会議しませんか？"},
        { "location": "3309/SEL"   , "narrator": "", "text": "オーケー"},
        { "location": "3310/SEL"   , "narrator": "", "text": "作戦会議？"},
        { "location": "3311/ACT"   , "narrator": "", "text": "オーケー"},
        { "location": "3312/ACT"   , "narrator": "", "text": "作戦会議？"},
        { "location": "3313/TALK"  , "narrator": "月神楽", "text": "はい♪"},
        { "location": "3315/TALK"  , "narrator": "月神楽", "text": "前回はタイミング悪く\n“お預け”に\nなっちゃいましたしね。"},
        { "location": "3320/TALK"  , "narrator": "月神楽", "text": "オープンプロセス、\n0xF3C番地から\n0x503番地へ。"},
        { "location": "3331/TALK"  , "narrator": "月神楽", "text": "シーク完了ですね～。"},
        { "location": "3332/TALK"  , "narrator": "月神楽", "text": "で、今回の\n葛藤の内容は？…と。"},
        { "location": "3333/SEL"   , "narrator": "", "text": "扉のところに行かなくてもできるのか……"},
        { "location": "3334/ACT"   , "narrator": "", "text": "扉のところに行かなくてもできるのか……"},
        { "location": "3337/TALK"  , "narrator": "月神楽", "text": "はい♪\nできないと\n思ってましたか？"},
        { "location": "3338/TALK"  , "narrator": "月神楽", "text": "そういうのも\n思い込みの\n１つですよねっ！"},
        { "location": "3340/TALK"  , "narrator": "月神楽", "text": "ではでは、\nどんな葛藤か見て――"},
        { "location": "3342/TALK"  , "narrator": "月神楽", "text": "……は？"},
        { "location": "3343/TALK"  , "narrator": "月神楽", "text": "なんですか、これ？"},
        { "location": "3344/SEL"   , "narrator": "", "text": "何があったの？"},
        { "location": "3345/ACT"   , "narrator": "", "text": "何があったの？"},
        { "location": "3347/TALK"  , "narrator": "月神楽", "text": "……。"},
        { "location": "3348/TALK"  , "narrator": "月神楽", "text": "読み上げて\nあげましょうか？"},
        { "location": "3349/TALK"  , "narrator": "月神楽", "text": "<color=green>ちょっぴり気になる\nあの人に、実地調査に\n誘われちゃった皇長官♪</color>"},
        { "location": "3351/TALK"  , "narrator": "月神楽", "text": "<color=green>ハートはドキドキなのに\n最後の一歩が\n踏み出せない。</color>"},
        { "location": "3353/TALK"  , "narrator": "月神楽", "text": "<color=green>だってわたし、\n長官なんだもん！</color>"},
        { "location": "3354/TALK"  , "narrator": "月神楽", "text": "だーっ、これ！"},
        { "location": "3355/TALK"  , "narrator": "月神楽", "text": "好きにしろよー。\n人の恋路なんて\nしらねーよもー。"},
        { "location": "3356/SEL"   , "narrator": "", "text": "ま、まあまあ落ち着いて（震え声）"},
        { "location": "3357/ACT"   , "narrator": "", "text": "ま、まあまあ落ち着いて（震え声）"},
        { "location": "3359/TALK"  , "narrator": "月神楽", "text": "まあいいですけど。\nどうせどんな葛藤でも\n私は扉を回すだけ。"},
        { "location": "3360/TALK"  , "narrator": "月神楽", "text": "汗水垂らして働くのは\n$handle$さん\nですからね～♪"},
        { "location": "3361/TALK"  , "narrator": "月神楽", "text": "というわけで、\nあとはヨロシクです。"},
        { "location": "3364/TALK"  , "narrator": "月神楽", "text": "……ふむふむ、なるほど。"},
        { "location": "3365/TALK"  , "narrator": "月神楽", "text": "なんだかちょっと、\nビビっちゃってる\nみたいですねっ！"},
        { "location": "3366/SEL"   , "narrator": "", "text": "ビビってる？？"},
        { "location": "3367/ACT"   , "narrator": "", "text": "ビビってる？？"},
        { "location": "3369/TALK"  , "narrator": "月神楽", "text": "こう見えて、\n卯月神楽ってわりと\n臆病なんですよ。"},
        { "location": "3370/TALK"  , "narrator": "月神楽", "text": "特に千羽鶴みたいな\n何を出してくるか\n分からないのには弱くて。"},
        { "location": "3371/TALK"  , "narrator": "月神楽", "text": "ですから、このままだと\nせっかくの貴方の作戦も\n遂行できないかもですよ？"},
        { "location": "3372/TALK"  , "narrator": "月神楽", "text": "なのでっ！\n臆病風を吹かせるクランを\n撃退しちゃいましょうか♪"},
        { "location": "3373/SEL"   , "narrator": "", "text": "まあ、そうなるよね"},
        { "location": "3374/ACT"   , "narrator": "", "text": "まあ、そうなるよね"},
        { "location": "3376/TALK"  , "narrator": "月神楽", "text": "ですですっ♪"},
        { "location": "3378/SEL"   , "narrator": "", "text": "あれ？　作戦会議って、もう終わっちゃったんじゃね？"},
        { "location": "3379/ACT"   , "narrator": "", "text": "あれ？　作戦会議って、もう終わっちゃったんじゃね？"},
        { "location": "3381/TALK"  , "narrator": "月神楽", "text": "え？\nまさか。"},
        { "location": "3382/TALK"  , "narrator": "月神楽", "text": "ここからが\n本番ですよっ♪"},
        { "location": "3383/TALK"  , "narrator": "月神楽", "text": "さぁ、\n$handle$さんっ！\n私と――"},
        { "location": "3388/SEL"   , "narrator": "", "text": "ぴょんこ！？"},
        { "location": "3389/ACT"   , "narrator": "", "text": "ぴょんこ！？"},
        { "location": "3392/TALK"  , "narrator": "月神楽", "text": "は！？"},
        { "location": "3393/TALK"  , "narrator": "月神楽", "text": "はいはい、もうメール\n読み終わりましたか？"},
        { "location": "3394/TALK"  , "narrator": "月神楽", "text": "それでは続きを――"},
        { "location": "3398/TALK"  , "narrator": "月神楽", "text": "こっちへ来て\n一緒に――"},
        { "location": "3402/TALK"  , "narrator": "月神楽", "text": "……。"},
        { "location": "3406/TALK"  , "narrator": "月神楽", "text": "……もう――"},
        { "location": "3410/TALK"  , "narrator": "月神楽", "text": "――もういいです。\n扉へ行きましょう。"},
        { "location": "3427/TALK"  , "narrator": "月神楽", "text": "それじゃ、\n$handle$さん――"},
        { "location": "3428/TALK"  , "narrator": "月神楽", "text": "久し振りになりますが、\nココロの葛藤処理、\nよろしくお願いしますね。"},
        { "location": "3429/SEL"   , "narrator": "", "text": "はい"},
        { "location": "3430/SEL"   , "narrator": "", "text": "また今度ゆっくり色々聞かせてくれ"},
        { "location": "3431/ACT"   , "narrator": "", "text": "はい"},
        { "location": "3432/ACT"   , "narrator": "", "text": "また今度ゆっくり色々聞かせてくれ"},
        { "location": "3433/TALK"  , "narrator": "月神楽", "text": "それは、お誘いと\n受け取っても\nよろしいですか♪"},
        { "location": "3434/SEL"   , "narrator": "", "text": "もちろんです"},
        { "location": "3435/SEL"   , "narrator": "", "text": "いや、それは"},
        { "location": "3436/ACT"   , "narrator": "", "text": "もちろんです"},
        { "location": "3438/TALK"  , "narrator": "月神楽", "text": "ふふふ～～♪"},
        { "location": "3439/ACT"   , "narrator": "", "text": "いや、それは"},
        { "location": "3440/TALK"  , "narrator": "月神楽", "text": "冗談ですよ♪"},
        { "location": "3441/TALK"  , "narrator": "月神楽", "text": "真面目なんですね。\n可愛い♪♪"},
        { "location": "3444/TALK"  , "narrator": "月神楽", "text": "ではでは、\n行ってらっしゃいませ♪"},
        { "location": "3446/TALK"  , "narrator": "月神楽", "text": "寂しいから、\n早く帰ってきてね？"},
        { "location": "3451/SEL"   , "narrator": "", "text": "えっ！？"},
        { "location": "3452/ACT"   , "narrator": "", "text": "えっ！？"},
        { "location": "3454/TALK"  , "narrator": "月神楽", "text": "卯月神楽と\n$handle$さんに\n素敵なココロの旅を♪"},
        { "location": "3455/SEL"   , "narrator": "", "text": "ちょっ！！"},
        { "location": "3456/ACT"   , "narrator": "", "text": "ちょっ！！"},
        { "location": "2963/DIALOG", "narrator": "Dialog_EventData", "text": "<color=green>8月30日　9:44 AM</color>\n情報管理庁庁舎にて"},
        { "location": "3096/DIALOG", "narrator": "Dialog_EventData", "text": "<color=green>8月30日　11:05 AM</color>\n情報管理庁地下にて"},
        { "location": "3214/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "3216/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "3218/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "3220/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "3222/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "3386/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:Message】</color>\n\n【ぴょんこ】様から\nメッセージが届いています。"},
        { "location": "3387/DIALOG", "narrator": "INFO", "text": "<color=green>【PN:ぴょんこ】(1/1)</color>\n\n$handle$さ～～ん♪\nお元気ですか～～～っ！\nぴょんこですよっ！\n"},
        { "location": "3396/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:Message】</color>\n\n【ぴょんこ】様から\nメッセージが届いています。"},
        { "location": "3397/DIALOG", "narrator": "INFO", "text": "<color=green>【PN:ぴょんこ】(1/1)</color>\n\nぴょんこは今、量子サーバーの中とやらを頑張って探索中ですっ！\n\nＲＰＧみたいで楽しいですよ♪　やくそうとどくけしそうを見つけました♪\n"},
        { "location": "3400/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:Message】</color>\n\n【ぴょんこ】様から\nメッセージが届いています。"},
        { "location": "3401/DIALOG", "narrator": "INFO", "text": "<color=green>【PN:ぴょんこ】(1/1)</color>\n\nぴょんこって、わりと宝物見つけるの上手なんですよね～～ふふーん、自画自賛ですっ！\n\nこの調子でとっとと回線の切替をして、凱旋しちゃいますよ～～♪"},
        { "location": "3404/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:Message】</color>\n\n【ぴょんこ】様から\nメッセージが届いています。"},
        { "location": "3405/DIALOG", "narrator": "INFO", "text": "<color=green>【PN:ぴょんこ】(1/1)</color>\n\n光の速さで戻りますからっ、$handle$さんも、首を長ーくして、待っててくださいね♪\n"},
        { "location": "3408/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:Message】</color>\n\n【ぴょんこ】様から\nメッセージが届いています。"},
        { "location": "3409/DIALOG", "narrator": "INFO", "text": "<color=green>【PN:ぴょんこ】(1/1)</color>\n\n<size=400>ｽｷ</size>\n"},
        { "location": "3449/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:Message】</color>\n\n【ぴょんこ】様から\nメッセージが届いています。"},
        { "location": "3450/DIALOG", "narrator": "INFO", "text": "<color=green>【PN:ぴょんこ】(1/1)</color>\n\nぴょん！！！\n\nライフギャザー認証まで\n到達したぴょん！！\n\nあと少しなのに\nなんかいｔｔｔｔｔｔｔｔ"}
    ]
}
