{
    "dir": "chap12/daydra/dd_ch05_12_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "12502",
        "cid": "kagura",
        "title": "002 メインストーリー",
        "sub_title": "つばめさんを○したい？＜前編＞"
    },
    "entry":
    [
        { "location": "1910/TALK"  , "narrator": "神楽", "text": "さてと…つばめさん、\n帰りましょう。"},
        { "location": "1913/TALK"  , "narrator": "つばめ", "text": "あ、ごめんね。\n今日はちょっと\n寄るところがあるの。"},
        { "location": "1914/TALK"  , "narrator": "神楽", "text": "そうなんですか？"},
        { "location": "1915/TALK"  , "narrator": "神楽", "text": "今日は劇場もお休みですし、\n私も付き合いますよ。"},
        { "location": "1916/TALK"  , "narrator": "つばめ", "text": "ううん、大丈夫だよ。\n付き合わせるのも悪いし…。"},
        { "location": "1917/TALK"  , "narrator": "つばめ", "text": "それじゃ、また明日ね。"},
        { "location": "1921/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1922/TALK"  , "narrator": "神楽", "text": "怪しい…。\nどこに行くのかしら？"},
        { "location": "1940/TALK"  , "narrator": "つばめ", "text": "えーっと、劇場の鍵は…。"},
        { "location": "1947/TALK"  , "narrator": "神楽", "text": "…用事って、劇場？"},
        { "location": "1948/TALK"  , "narrator": "神楽", "text": "お休みの劇場に用事って、\nなんなのかしら？"},
        { "location": "1964/TALK"  , "narrator": "神楽", "text": "…ん？"},
        { "location": "1965/TALK"  , "narrator": "神楽", "text": "楽屋に忘れ物でも\n取りに来たのかと\n思ったのに…。"},
        { "location": "1966/TALK"  , "narrator": "神楽", "text": "どこ行ったの？"},
        { "location": "1980/TALK"  , "narrator": "神楽", "text": "…ここにもいない。"},
        { "location": "1981/TALK"  , "narrator": "神楽", "text": "映写室や倉庫にいるとは\n思えないし…う～ん…。"},
        { "location": "1982/TALK"  , "narrator": "神楽", "text": "…もうちょっと\n探してみよう。"},
        { "location": "1984/TALK"  , "narrator": "神楽", "text": "他につばめさんが\n行きそうなところは…。"},
        { "location": "1985/TALK"  , "narrator": "神楽", "text": "…あっ。"},
        { "location": "1986/TALK"  , "narrator": "神楽", "text": "いた、つばめさん。\nあんなところでなにを――"},
        { "location": "1987/TALK"  , "narrator": "神楽", "text": "っ！？"},
        { "location": "1998/TALK"  , "narrator": "神楽", "text": "音羽！！"},
        { "location": "1999/TALK"  , "narrator": "神楽", "text": "なんで？\nどうしてつばめさんが\n音羽の前にいるの？"},
        { "location": "2000/TALK"  , "narrator": "神楽", "text": "劇場に誰もいない日に、\n私にも内緒でコソコソと\n会いに来るなんて――"},
        { "location": "2001/TALK"  , "narrator": "神楽", "text": "まさか！！"},
        { "location": "2013/TALK"  , "narrator": "神楽", "text": "っ！！"},
        { "location": "2014/TALK"  , "narrator": "神楽", "text": "させない…。"},
        { "location": "2015/TALK"  , "narrator": "神楽", "text": "これ以上、音羽のことを\n傷つけさせはしない！！"},
        { "location": "2017/TALK"  , "narrator": "神楽", "text": "例え殺してでも、\n絶対に――！！"},
        { "location": "2066/TALK"  , "narrator": "ぴょんこ", "text": "　"},
        { "location": "2106/TALK"  , "narrator": "ガブリエラ", "text": "あら、\n$handle$。"},
        { "location": "2108/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん♪"},
        { "location": "2110/SEL"   , "narrator": "", "text": "ふたりとも大丈夫だった？"},
        { "location": "2111/ACT"   , "narrator": "", "text": "ふたりとも大丈夫だった？"},
        { "location": "2115/SEL"   , "narrator": "", "text": "ふたりとも大丈夫だった？"},
        { "location": "2116/SEL"   , "narrator": "", "text": "ぴょんこｽｷ"},
        { "location": "2117/ACT"   , "narrator": "", "text": "ふたりとも大丈夫だった？"},
        { "location": "2119/TALK"  , "narrator": "ガブリエラ", "text": "ええ。\nあの程度のクラン、\nなんてことないわ。"},
        { "location": "2121/TALK"  , "narrator": "ぴょんこ", "text": "ガブちゃんのお陰で、\n今回も精神崩壊せずに\nいられました♪"},
        { "location": "2123/TALK"  , "narrator": "ガブリエラ", "text": "ちょ、ちょっと……\nその言い方はかなり\nクルものがあるんだけど。"},
        { "location": "2124/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん？"},
        { "location": "2125/ACT"   , "narrator": "", "text": "ぴょんこｽｷ"},
        { "location": "2128/TALK"  , "narrator": "ガブリエラ", "text": "はぁっ！？"},
        { "location": "2129/TALK"  , "narrator": "ぴょんこ", "text": "ええええっ！！"},
        { "location": "2130/TALK"  , "narrator": "ぴょんこ", "text": "ガブちゃんの――"},
        { "location": "2133/TALK"  , "narrator": "ぴょんこ", "text": "<size=35>目の前で！！</size>"},
        { "location": "2136/TALK"  , "narrator": "ぴょんこ", "text": "<size=40>愛の囁き！？</size>"},
        { "location": "2138/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "2141/TALK"  , "narrator": "ガブリエラ", "text": "……ちょっと。あんた。"},
        { "location": "2142/TALK"  , "narrator": "ガブリエラ", "text": "……　…"},
        { "location": "2143/TALK"  , "narrator": "ガブリエラ", "text": "いや、いい。"},
        { "location": "2144/TALK"  , "narrator": "ガブリエラ", "text": "あたし、もう帰るから。"},
        { "location": "2145/SEL"   , "narrator": "", "text": "え？　あ、ああ…"},
        { "location": "2146/SEL"   , "narrator": "", "text": "ちょっとまって！！"},
        { "location": "2147/ACT"   , "narrator": "", "text": "え？　あ、ああ…"},
        { "location": "2148/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "2151/TALK"  , "narrator": "ぴょんこ", "text": "…ぴょん？"},
        { "location": "2153/ACT"   , "narrator": "", "text": "ちょっとまって！！"},
        { "location": "2154/TALK"  , "narrator": "ガブリエラ", "text": "……何よ。"},
        { "location": "2155/SEL"   , "narrator": "", "text": "ごめん、ちょっとふざけてただけで…度が過ぎた"},
        { "location": "2156/SEL"   , "narrator": "", "text": "ごめん、神楽の方が好きになっちゃって。ほんとにごめん！！"},
        { "location": "2157/ACT"   , "narrator": "", "text": "ごめん、ちょっとふざけてただけで…度が過ぎた"},
        { "location": "2158/TALK"  , "narrator": "ガブリエラ", "text": "やっていい冗談と\nダメな冗談が\n有ると思うんだけど。"},
        { "location": "2159/TALK"  , "narrator": "ガブリエラ", "text": "違うかな。"},
        { "location": "2160/SEL"   , "narrator": "", "text": "はい、すみません……"},
        { "location": "2161/SEL"   , "narrator": "", "text": "ごめんなさい"},
        { "location": "2162/ACT"   , "narrator": "", "text": "はい、すみません……"},
        { "location": "2163/ACT"   , "narrator": "", "text": "ごめんなさい"},
        { "location": "2165/TALK"  , "narrator": "ガブリエラ", "text": "今度やったら、\nもう別れるから。\nいい？"},
        { "location": "2166/SEL"   , "narrator": "", "text": "はい"},
        { "location": "2167/ACT"   , "narrator": "", "text": "はい"},
        { "location": "2169/TALK"  , "narrator": "ガブリエラ", "text": "…うん。"},
        { "location": "2170/TALK"  , "narrator": "ガブリエラ", "text": "じゃあ、もういいわ。"},
        { "location": "2171/ACT"   , "narrator": "", "text": "ごめん、神楽の方が好きになっちゃって。ほんとにごめん！！"},
        { "location": "2172/TALK"  , "narrator": "ガブリエラ", "text": "…そっか。"},
        { "location": "2173/TALK"  , "narrator": "ガブリエラ", "text": "それじゃ仕方ないわね。"},
        { "location": "2176/TALK"  , "narrator": "ぴょんこ", "text": "…えっ"},
        { "location": "2177/TALK"  , "narrator": "ぴょんこ", "text": "えっと！"},
        { "location": "2178/TALK"  , "narrator": "ぴょんこ", "text": "だっ、\n大丈夫なんですかっ！？"},
        { "location": "2185/TALK"  , "narrator": "ガブリエラ", "text": "……ちょっと。\nあんたたち。"},
        { "location": "2187/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん？"},
        { "location": "2188/TALK"  , "narrator": "ガブリエラ", "text": "そういうのは、\n二人きりの時だけに\nしなさいよ！"},
        { "location": "2189/SEL"   , "narrator": "", "text": "すみません、軽率でした"},
        { "location": "2190/SEL"   , "narrator": "", "text": "羨ましくなったとか？"},
        { "location": "2191/ACT"   , "narrator": "", "text": "すみません、軽率でした"},
        { "location": "2194/TALK"  , "narrator": "ガブリエラ", "text": "わ、わかればいいのよ。\nわかれば。"},
        { "location": "2195/ACT"   , "narrator": "", "text": "羨ましくなったとか？"},
        { "location": "2198/TALK"  , "narrator": "ガブリエラ", "text": "ち、違うわよ！！"},
        { "location": "2199/TALK"  , "narrator": "ガブリエラ", "text": "べっ、べつに、\n羨ましいとか、\nそういうのじゃないの！"},
        { "location": "2200/TALK"  , "narrator": "ガブリエラ", "text": "日本人ならもうちょっと、\n奥ゆかしさとかそういう\n国民性を大事にしなさい！"},
        { "location": "2201/SEL"   , "narrator": "", "text": "はーい"},
        { "location": "2202/SEL"   , "narrator": "", "text": "ワタシニホンジンデハアリマセン"},
        { "location": "2203/ACT"   , "narrator": "", "text": "はーい"},
        { "location": "2205/TALK"  , "narrator": "ガブリエラ", "text": "わ、わかればいいのよ。\nわかれば。"},
        { "location": "2206/ACT"   , "narrator": "", "text": "ワタシニホンジンデハアリマセン"},
        { "location": "2208/TALK"  , "narrator": "ぴょんこ", "text": "ええっ！！\nそうだったんですかっ！"},
        { "location": "2210/TALK"  , "narrator": "ガブリエラ", "text": "あたしもちょっと\nびっくりしたわね。"},
        { "location": "2230/TALK"  , "narrator": "ぴょんこ", "text": "ええっ！？"},
        { "location": "2231/SEL"   , "narrator": "", "text": "早っ！"},
        { "location": "2232/ACT"   , "narrator": "", "text": "早っ！"},
        { "location": "2234/TALK"  , "narrator": "ガブリエラ", "text": "どういうこと…！？"},
        { "location": "2235/TALK"  , "narrator": "ガブリエラ", "text": "まさか、あたしが戦った\nタイミングが遅かったから\n崩壊が近づいてる……！？"},
        { "location": "2240/TALK"  , "narrator": "ガブリエラ", "text": "きゃあっ！！"},
        { "location": "2241/TALK"  , "narrator": "ぴょんこ", "text": "もしくは、\n葛藤がかなり強いのかも\nしれませんねっ！"},
        { "location": "2243/SEL"   , "narrator": "", "text": "そういえば今回、ちょっと強そうだった"},
        { "location": "2244/ACT"   , "narrator": "", "text": "そういえば今回、ちょっと強そうだった"},
        { "location": "2249/TALK"  , "narrator": "ぴょんこ", "text": "回しますっ！"},
        { "location": "2250/TALK"  , "narrator": "ぴょんこ", "text": "オープンプロセス、\n2x118番地から\n2xFC1番地へ。"},
        { "location": "2276/TALK"  , "narrator": "ぴょんこ", "text": "シーク完了。"},
        { "location": "2280/TALK"  , "narrator": "ぴょんこ", "text": "今回の悩みはっ！！"},
        { "location": "2281/TALK"  , "narrator": "ぴょんこ", "text": "……。"},
        { "location": "2282/TALK"  , "narrator": "ぴょんこ", "text": "いけない……。\n怒りと焦りで頭の中が\n真っ白になってる……"},
        { "location": "2285/TALK"  , "narrator": "ガブリエラ", "text": "早く対処しなくちゃ……"},
        { "location": "2289/TALK"  , "narrator": "ガブリエラ", "text": "あーもう、\nみやびはまだ\n来ないのかしら！"},
        { "location": "2291/TALK"  , "narrator": "ぴょんこ", "text": "ガブちゃんが\nもう一度戦うことは\n出来ないんですかっ！"},
        { "location": "2293/TALK"  , "narrator": "ガブリエラ", "text": "できればそうしたいけど、\n今それをやるのは\n危険なのよ。"},
        { "location": "2294/SEL"   , "narrator": "", "text": "危険！？　神楽が？\nガブリエラが？"},
        { "location": "2295/ACT"   , "narrator": "", "text": "危険！？　神楽が？\nガブリエラが？"},
        { "location": "2298/TALK"  , "narrator": "ガブリエラ", "text": "主に神楽よ。"},
        { "location": "2300/TALK"  , "narrator": "ガブリエラ", "text": "本来は、他人のココロの\n中でこんな風に好き勝手\nしたらダメなのよ。"},
        { "location": "2301/TALK"  , "narrator": "ガブリエラ", "text": "一人の存在が長居したり、\nココロの中で大きな事を\n動かしたりするのは危険。"},
        { "location": "2302/TALK"  , "narrator": "ガブリエラ", "text": "影響力が強すぎて、\nココロがそれを自分の\n意志だと錯覚しちゃうの。"},
        { "location": "2303/TALK"  , "narrator": "ガブリエラ", "text": "特に葛藤処理、要するに\nクランとのバトルへの\n介入は影響が大きいわ。"},
        { "location": "2304/TALK"  , "narrator": "ガブリエラ", "text": "だから、同じ人が\n長居をすると、それだけで\n意識が混濁して――"},
        { "location": "2305/SEL"   , "narrator": "", "text": "洗脳みたいな感じになるってこと？"},
        { "location": "2306/ACT"   , "narrator": "", "text": "洗脳みたいな感じになるってこと？"},
        { "location": "2308/TALK"  , "narrator": "ガブリエラ", "text": "まさにその通りね。"},
        { "location": "2309/TALK"  , "narrator": "ガブリエラ", "text": "だから、あたしが\n二回連続で戦うことによる\n影響力はわりと大きいの。"},
        { "location": "2310/TALK"  , "narrator": "ガブリエラ", "text": "でも、いざという時には\nあたしが戦った方がまだ\nマシだから――"},
        { "location": "2312/TALK"  , "narrator": "ガブリエラ", "text": "限界ギリギリまで\nここにいるわ。"},
        { "location": "2314/TALK"  , "narrator": "ぴょんこ", "text": "ガブちゃん……\nありがとうございます！"},
        { "location": "2315/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "2316/TALK"  , "narrator": "ぴょんこ", "text": "………。"},
        { "location": "2317/TALK"  , "narrator": "ガブリエラ", "text": "ねえ、ぴょんこ。"},
        { "location": "2318/TALK"  , "narrator": "ぴょんこ", "text": "はい。"},
        { "location": "2319/TALK"  , "narrator": "ガブリエラ", "text": "あんたって、\n神楽に対してどれくらい\n影響力があるの？"},
        { "location": "2320/TALK"  , "narrator": "ぴょんこ", "text": "え？\nそうですね……"},
        { "location": "2321/TALK"  , "narrator": "ぴょんこ", "text": "今のところ、\n結構大きいと思います。"},
        { "location": "2322/TALK"  , "narrator": "ガブリエラ", "text": "そう……。"},
        { "location": "2323/TALK"  , "narrator": "ぴょんこ", "text": "…ぴょん？"},
        { "location": "2324/TALK"  , "narrator": "ガブリエラ", "text": "あ、ううん。\nなんでもないの。"},
        { "location": "2325/SEL"   , "narrator": "", "text": "？？"},
        { "location": "2326/SEL"   , "narrator": "", "text": "溜め込むの良くないよー？"},
        { "location": "2327/ACT"   , "narrator": "", "text": "？？"},
        { "location": "2328/ACT"   , "narrator": "", "text": "溜め込むの良くないよー？"},
        { "location": "2329/TALK"  , "narrator": "ガブリエラ", "text": "いや……うーん……"},
        { "location": "2330/TALK"  , "narrator": "ガブリエラ", "text": "大したことじゃ\nないのよ。だから――"},
        { "location": "2332/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "2333/TALK"  , "narrator": "ガブリエラ", "text": "神楽さ、この時期って\n一人で溜め込んでて\n大変だったじゃない。"},
        { "location": "2334/TALK"  , "narrator": "ガブリエラ", "text": "あたし、そんなこと\n全然知らなくて、だいぶ\n冷たい態度取ったけど――"},
        { "location": "2336/TALK"  , "narrator": "ガブリエラ", "text": "でも、今は違うから。"},
        { "location": "2337/TALK"  , "narrator": "ぴょんこ", "text": "え？"},
        { "location": "2338/TALK"  , "narrator": "ガブリエラ", "text": "あたし、神楽のこと\n応援してるから。"},
        { "location": "2339/TALK"  , "narrator": "ガブリエラ", "text": "何があっても、\n絶対にその先には\n素敵な未来があるから。"},
        { "location": "2340/TALK"  , "narrator": "ぴょんこ", "text": "ガブちゃん……"},
        { "location": "2341/TALK"  , "narrator": "ガブリエラ", "text": "だから、\n精一杯頑張んなさいね。"},
        { "location": "2342/TALK"  , "narrator": "ガブリエラ", "text": "そ、それだけ！\nさあ、わかったらさっさと\n解決するわよ！"},
        { "location": "2343/TALK"  , "narrator": "ぴょんこ", "text": "はいっ！"},
        { "location": "2345/TALK"  , "narrator": "ガブリエラ", "text": "未来の事実とかは言えない\nけど、気持ちくらいは\n伝えてもいいわよね！"},
        { "location": "2346/SEL"   , "narrator": "", "text": "$me$が許す！"},
        { "location": "2347/SEL"   , "narrator": "", "text": "$me$に言われても…"},
        { "location": "2348/ACT"   , "narrator": "", "text": "$me$が許す！"},
        { "location": "2350/TALK"  , "narrator": "ガブリエラ", "text": "…よかった。"},
        { "location": "2351/ACT"   , "narrator": "", "text": "$me$に言われても…"},
        { "location": "2353/TALK"  , "narrator": "ガブリエラ", "text": "もーっ！"},
        { "location": "2354/TALK"  , "narrator": "ガブリエラ", "text": "そういう時は\n嘘でも「いい」って\n言って欲しいのよ……。"},
        { "location": "2360/TALK"  , "narrator": "ぴょんこ", "text": "きゃあっ！！"},
        { "location": "2361/TALK"  , "narrator": "ガブリエラ", "text": "そろそろ限界みたいね。\nやっぱりあたしが\nやるしか――"},
        { "location": "2367/TALK"  , "narrator": "みやび", "text": "すまんね、\nだいぶ待たせた。"},
        { "location": "2368/SEL"   , "narrator": "", "text": "みやび！！"},
        { "location": "2369/ACT"   , "narrator": "", "text": "みやび！！"},
        { "location": "2371/TALK"  , "narrator": "ガブリエラ", "text": "みやび！！\nあんたちょっと\n遅すぎだから！"},
        { "location": "2372/TALK"  , "narrator": "みやび", "text": "そのようやね。"},
        { "location": "2374/TALK"  , "narrator": "みやび", "text": "ちくっと\n準備をしちょったき……"},
        { "location": "2375/TALK"  , "narrator": "みやび", "text": "ところでガブちゃん、\n波垢の交換は\n済んじゅう？"},
        { "location": "2377/TALK"  , "narrator": "ガブリエラ", "text": "ああっ！！\nまだだったわ！"},
        { "location": "2380/TALK"  , "narrator": "ガブリエラ", "text": "ぴょんこ、\nアカウント交換いい？"},
        { "location": "2382/TALK"  , "narrator": "ぴょんこ", "text": "あ、はいっ！"},
        { "location": "2385/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "2386/TALK"  , "narrator": "ぴょんこ", "text": "………。"},
        { "location": "2387/SEL"   , "narrator": "", "text": "なんでみんなWAVEアカウント交換してるの？"},
        { "location": "2388/ACT"   , "narrator": "", "text": "なんでみんなWAVEアカウント交換してるの？"},
        { "location": "2390/TALK"  , "narrator": "みやび", "text": "波で繋がっちょれば、\n影響を与えずに互いが\n状況を把握できる。"},
        { "location": "2391/TALK"  , "narrator": "みやび", "text": "まあ、リモートアクセス\nみたいなものやね。"},
        { "location": "2392/TALK"  , "narrator": "みやび", "text": "それと――"},
        { "location": "2393/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "2394/TALK"  , "narrator": "みやび", "text": "いや、これはまだえいか。"},
        { "location": "2395/SEL"   , "narrator": "", "text": "？？？"},
        { "location": "2396/ACT"   , "narrator": "", "text": "？？？"},
        { "location": "2400/TALK"  , "narrator": "ガブリエラ", "text": "登録したわよ。"},
        { "location": "2402/TALK"  , "narrator": "ぴょんこ", "text": "こちらも完了しました♪"},
        { "location": "2404/TALK"  , "narrator": "みやび", "text": "うちも\nセットアップ完了や。"},
        { "location": "2405/TALK"  , "narrator": "ガブリエラ", "text": "それじゃ、\nあたしはこれで\n自分とこに戻るわね。"},
        { "location": "2407/TALK"  , "narrator": "ガブリエラ", "text": "素敵なココロの旅をー。"},
        { "location": "2410/SEL"   , "narrator": "", "text": "セットアップって？"},
        { "location": "2411/ACT"   , "narrator": "", "text": "セットアップって？"},
        { "location": "2414/TALK"  , "narrator": "みやび", "text": "うむ。\nセットアップやよ。"},
        { "location": "2415/TALK"  , "narrator": "ぴょんこ", "text": "何の…ですか？"},
        { "location": "2417/TALK"  , "narrator": "みやび", "text": "お前さんたちを\n量子サーバー経由で\n共通意識野、すなわち――"},
        { "location": "2418/TALK"  , "narrator": "みやび", "text": "アカシックレコードに\n送る。"},
        { "location": "2419/SEL"   , "narrator": "", "text": "アカシックレコード！？"},
        { "location": "2420/ACT"   , "narrator": "", "text": "アカシックレコード！？"},
        { "location": "2423/TALK"  , "narrator": "みやび", "text": "うむ。"},
        { "location": "2424/TALK"  , "narrator": "みやび", "text": "まあ、だがしかし。\nその前にな――"},
        { "location": "2425/TALK"  , "narrator": "みやび", "text": "この惨状を\n何とかせんといかんね。"},
        { "location": "2427/TALK"  , "narrator": "みやび", "text": "詳しい説明は後や。\nぴょんこちゃん、\n準備はえいか？"},
        { "location": "2429/TALK"  , "narrator": "ぴょんこ", "text": "はいっ！"},
        { "location": "2431/TALK"  , "narrator": "みやび", "text": "ほんだらいくぞね。"},
        { "location": "2434/TALK"  , "narrator": "みやび", "text": "うちら３人に\n素敵なココロの旅を。"},
        { "location": "2456/TALK"  , "narrator": "エリカ", "text": "ストップ\nストップ\nストーップ！！"},
        { "location": "2457/SEL"   , "narrator": "", "text": "エリカさん！？"},
        { "location": "2458/ACT"   , "narrator": "", "text": "エリカさん！？"},
        { "location": "2460/TALK"  , "narrator": "エリカ", "text": "ごめんね、\nほんとにごめん！"},
        { "location": "2461/TALK"  , "narrator": "エリカ", "text": "ほんとは全て、\nあなたの気持ちが赴く\nままにさせてあげたいの。"},
        { "location": "2462/TALK"  , "narrator": "エリカ", "text": "でも、今回の発言は\nあまりに未来に対する\n影響力が大きすぎて。"},
        { "location": "2463/TALK"  , "narrator": "エリカ", "text": "今後に大きな支障が\n出ちゃいそうだったから\n切断させてもらいました。"},
        { "location": "2464/SEL"   , "narrator": "", "text": "……ここは？"},
        { "location": "2465/ACT"   , "narrator": "", "text": "……ここは？"},
        { "location": "2467/TALK"  , "narrator": "エリカ", "text": "ブレークポイント。\nシステム領域だよ。"},
        { "location": "2468/TALK"  , "narrator": "エリカ", "text": "本当は乱用したら\nいけない機能なんだけど。"},
        { "location": "2469/TALK"  , "narrator": "エリカ", "text": "あなたの選択を\n軽視する行為でもあるし。"},
        { "location": "2470/TALK"  , "narrator": "エリカ", "text": "でも今回は、それくらいの\nことだったということは\n解って欲しいかな。"},
        { "location": "2471/TALK"  , "narrator": "エリカ", "text": "本当にごめんね。\nスタックポインタを最初に\n戻させてもらうから。"},
        { "location": "2472/TALK"  , "narrator": "エリカ", "text": "それじゃ、またね。"},
        { "location": "1901/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:Interrupt】</color>\nSystem Interrupted.\n\n必須選択肢が選ばれていません。\n\n<color=green>『STORY27：シン・カグラ』</color>\nにて、選択を行ってから\n再度アクセスしてください。\n"},
        { "location": "1905/DIALOG", "narrator": "Dialog_EventData", "text": "<color=green>6月26日　3:35 PM</color>\nとある平日の放課後、附属学園つばめの教室にて。"},
        { "location": "2031/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "2033/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "2035/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "2037/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "2039/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "2447/DIALOG", "narrator": "NOTICE", "text": "<color=red>【TRI-OS Error:0x99】</color>\nココロスフィアとの回線が\n切断されました。(981)"}
    ]
}
