        "title": "Extra004 ヒメゴトチャット",
        "sub_title": "杞憂なればこそ"
    },
    "entry":
    [
        { "location": "89/SCENARIO", "narrator": "", "text": "05_004_杞憂なればこそ"},
        { "location": "114/TALK"   , "narrator": "みやび", "text": "色々考えを巡らせて"},
        { "location": "115/TALK"   , "narrator": "みやび", "text": "それが杞憂だったら"},
        { "location": "116/TALK"   , "narrator": "みやび", "text": "どうするぞね"},
        { "location": "119/SEL"    , "narrator": "", "text": "安心する"},
        { "location": "120/SEL"    , "narrator": "", "text": "戸惑う"},
        { "location": "121/SEL"    , "narrator": "", "text": "とりあえず寝る"},
        { "location": "122/ACT"    , "narrator": "", "text": "安心する"},
        { "location": "123/TALK"   , "narrator": "みやび", "text": "油断大敵"},
        { "location": "124/ACT"    , "narrator": "", "text": "戸惑う"},
        { "location": "125/TALK"   , "narrator": "みやび", "text": "唖然失笑"},
        { "location": "126/ACT"    , "narrator": "", "text": "とりあえず寝る"},
        { "location": "128/TALK"   , "narrator": "みやび", "text": "気宇壮大"},
        { "location": "129/TALK"   , "narrator": "みやび", "text": "それでこそ我が相棒"},
        { "location": "133/TALK"   , "narrator": "みやび", "text": "とりあえず"},
        { "location": "134/TALK"   , "narrator": "みやび", "text": "人が一人増えたことは"},
        { "location": "135/TALK"   , "narrator": "みやび", "text": "プラスに働きそうだと思うのだ"},
        { "location": "137/SEL"    , "narrator": "", "text": "よかったね"},
        { "location": "138/SEL"    , "narrator": "", "text": "不安なことがあったの？"},
        { "location": "139/SEL"    , "narrator": "", "text": "ポジティブシンキングだね"},
        { "location": "140/ACT"    , "narrator": "", "text": "よかったね"},
        { "location": "141/TALK"   , "narrator": "みやび", "text": "うむ"},
        { "location": "142/TALK"   , "narrator": "みやび", "text": "まあな"},
        { "location": "143/ACT"    , "narrator": "", "text": "不安なことがあったの？"},
        { "location": "144/TALK"   , "narrator": "みやび", "text": "ないわけがない"},
        { "location": "145/TALK"   , "narrator": "みやび", "text": "そうは思わんか"},
        { "location": "146/ACT"    , "narrator": "", "text": "ポジティブシンキングだね"},
        { "location": "147/TALK"   , "narrator": "みやび", "text": "闇雲なポジティブさは"},
        { "location": "148/TALK"   , "narrator": "みやび", "text": "危険思想に迷い込むぞ"},
        { "location": "152/TALK"   , "narrator": "みやび", "text": "冷静に考えれば"},
        { "location": "153/TALK"   , "narrator": "みやび", "text": "心配したり調整したりするのは"},
        { "location": "154/TALK"   , "narrator": "みやび", "text": "うちでなく、まほさんの仕事ぞね"},
        { "location": "156/TALK"   , "narrator": "みやび", "text": "そんなわけで"},
        { "location": "157/TALK"   , "narrator": "みやび", "text": "うちの心配は杞憂に終わったぞね"}
    ]
}
