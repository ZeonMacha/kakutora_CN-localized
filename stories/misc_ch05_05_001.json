        { "location": "7/SCENARIO", "narrator": "", "text": "迷子になんてなりません"},
        { "location": "32/TALK"   , "narrator": "神楽", "text": "こんばんはいるかな？"},
        { "location": "33/TALK"   , "narrator": "神楽", "text": "ぴょんこ参上ですぴょん♪"},
        { "location": "42/SEL"    , "narrator": "", "text": "ぴょんこｷﾀ―――(ﾟ∀ﾟ)―――― !!"},
        { "location": "43/SEL"    , "narrator": "", "text": "ぴょんこが一人称のキャラなの？"},
        { "location": "44/SEL"    , "narrator": "", "text": "これからよろしく！"},
        { "location": "45/ACT"    , "narrator": "", "text": "ぴょんこｷﾀ―――(ﾟ∀ﾟ)―――― !!"},
        { "location": "46/TALK"   , "narrator": "神楽", "text": "来ましたけど"},
        { "location": "47/TALK"   , "narrator": "神楽", "text": "まるでぴょんこを知ってるみたいな言い方ですね？？？"},
        { "location": "48/ACT"    , "narrator": "", "text": "ぴょんこが一人称のキャラなの？"},
        { "location": "49/TALK"   , "narrator": "神楽", "text": "そうなのですぴょん♪"},
        { "location": "50/TALK"   , "narrator": "神楽", "text": "かわいいでしょ～～～？"},
        { "location": "51/ACT"    , "narrator": "", "text": "これからよろしく！"},
        { "location": "52/TALK"   , "narrator": "神楽", "text": "よろしくですぴょん"},
        { "location": "54/TALK"   , "narrator": "神楽", "text": "ぴょんこはやっぱりおしゃべりは楽しくなくちゃって思うんですよねっ"},
        { "location": "55/TALK"   , "narrator": "神楽", "text": "どう思いますか？"},
        { "location": "56/SEL"    , "narrator": "", "text": "その通りだと思う"},
        { "location": "57/SEL"    , "narrator": "", "text": "タメ口でｵｹ"},
        { "location": "58/SEL"    , "narrator": "", "text": "神楽とならどんな話でも嬉しい"},
        { "location": "59/ACT"    , "narrator": "", "text": "その通りだと思う"},
        { "location": "60/TALK"   , "narrator": "神楽", "text": "理解が早くてうれしいぴょん♪"},
        { "location": "61/ACT"    , "narrator": "", "text": "タメ口でｵｹ"},
        { "location": "62/TALK"   , "narrator": "神楽", "text": "そうなのかーりょ！"},
        { "location": "63/ACT"    , "narrator": "", "text": "神楽とならどんな話でも嬉しい"},
        { "location": "64/TALK"   , "narrator": "神楽", "text": "ｸﾞﾌﾌ、、、"},
        { "location": "65/TALK"   , "narrator": "神楽", "text": "ﾔｻｽｨｰね★"},
        { "location": "68/TALK"   , "narrator": "神楽", "text": "ぴょんこはウサギだから"},
        { "location": "69/TALK"   , "narrator": "神楽", "text": "迷子になんてならないの"},
        { "location": "70/SEL"    , "narrator": "", "text": "野生の勘ってこと？"},
        { "location": "71/SEL"    , "narrator": "", "text": "いや、意味わからん"},
        { "location": "72/SEL"    , "narrator": "", "text": "今日もかわいいね"},
        { "location": "73/ACT"    , "narrator": "", "text": "野生の勘ってこと？"},
        { "location": "75/TALK"   , "narrator": "神楽", "text": "そうなのだぴょん"},
        { "location": "76/TALK"   , "narrator": "神楽", "text": "よくわかったわね$handlek$"},
        { "location": "77/TALK"   , "narrator": "神楽", "text": "ほめてあげる"},
        { "location": "78/TALK"   , "narrator": "神楽", "text": "えらいえらい♪"},
        { "location": "81/ACT"    , "narrator": "", "text": "いや、意味わからん"},
        { "location": "82/TALK"   , "narrator": "神楽", "text": "は？"},
        { "location": "84/TALK"   , "narrator": "神楽", "text": "そういう返しが面白いと思ってるの？？？"},
        { "location": "85/TALK"   , "narrator": "神楽", "text": "意味わからんのはこっちだから"},
        { "location": "87/ACT"    , "narrator": "", "text": "今日もかわいいね"},
        { "location": "88/TALK"   , "narrator": "神楽", "text": "そんなのわかりきってるけど"},
        { "location": "89/TALK"   , "narrator": "神楽", "text": "そう言えるのは偉い"},
        { "location": "90/TALK"   , "narrator": "神楽", "text": "ま、当然の反応だろうけど"},
        { "location": "93/TALK"   , "narrator": "神楽", "text": "どうしてそんなことを言うかと言えば"},
        { "location": "94/TALK"   , "narrator": "神楽", "text": "トライナリーで迷子になった子がいるから"},
        { "location": "96/SEL"    , "narrator": "", "text": "つばめでしょ！"},
        { "location": "97/SEL"    , "narrator": "", "text": "え、アーヤが！？"},
        { "location": "98/SEL"    , "narrator": "", "text": "ガブリエラはまだ日本に慣れてないから…"},
        { "location": "99/SEL"    , "narrator": "", "text": "みやびかー"},
        { "location": "100/ACT"   , "narrator": "", "text": "つばめでしょ！"},
        { "location": "101/TALK"  , "narrator": "神楽", "text": "ぴょん♪♪"},
        { "location": "103/TALK"  , "narrator": "神楽", "text": "って"},
        { "location": "104/TALK"  , "narrator": "神楽", "text": "わかりやすすぎてクイズにならないけど"},
        { "location": "105/TALK"  , "narrator": "神楽", "text": "ぴょんこはそれでも心配した"},
        { "location": "106/ACT"   , "narrator": "", "text": "え、アーヤが！？"},
        { "location": "107/TALK"  , "narrator": "神楽", "text": "まさか！！！！"},
        { "location": "108/TALK"  , "narrator": "神楽", "text": "でもそんなことがあったら絶対に隠しそう"},
        { "location": "109/ACT"   , "narrator": "", "text": "ガブリエラはまだ日本に慣れてないから…"},
        { "location": "110/TALK"  , "narrator": "神楽", "text": "確かにありそう"},
        { "location": "111/TALK"  , "narrator": "神楽", "text": "でもガブちゃんの日本語はネイティブレベルぴょん"},
        { "location": "112/TALK"  , "narrator": "神楽", "text": "迷ってもなんとかなりそう"},
        { "location": "113/ACT"   , "narrator": "", "text": "みやびかー"},
        { "location": "114/TALK"  , "narrator": "神楽", "text": "みやびさんは部屋の中が常に迷子らしいぴょん♪"},
        { "location": "115/TALK"  , "narrator": "神楽", "text": "どれだけ壮絶な汚部屋なのか興味津々"},
        { "location": "116/TALK"  , "narrator": "神楽", "text": "ハウスキーパー雇えばいいのにね♪"},
        { "location": "120/TALK"  , "narrator": "神楽", "text": "そしてぴょんこは思った"},
        { "location": "121/TALK"  , "narrator": "神楽", "text": "ぴょんこが迷子になったら$handlek$はぴょんこを迎えに来てくれますか？"},
        { "location": "123/SEL"   , "narrator": "", "text": "何があっても駆けつける"},
        { "location": "124/SEL"   , "narrator": "", "text": "え…無理でしょ"},
        { "location": "125/SEL"   , "narrator": "", "text": "ヒマだったら行く"},
        { "location": "126/ACT"   , "narrator": "", "text": "何があっても駆けつける"},
        { "location": "128/TALK"  , "narrator": "神楽", "text": "やだ、、、やさしい/////"},
        { "location": "129/TALK"  , "narrator": "神楽", "text": "絶対来てね♪"},
        { "location": "130/TALK"  , "narrator": "神楽", "text": "素敵なダーリン♪♪"},
        { "location": "131/ACT"   , "narrator": "", "text": "え…無理でしょ"},
        { "location": "132/TALK"  , "narrator": "神楽", "text": "ああ？"},
        { "location": "133/TALK"  , "narrator": "神楽", "text": "なんじゃそりゃ"},
        { "location": "134/ACT"   , "narrator": "", "text": "ヒマだったら行く"},
        { "location": "135/TALK"  , "narrator": "神楽", "text": "そっか"},
