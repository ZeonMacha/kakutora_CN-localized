    "entry":
    [
        { "location": "197/SCENARIO", "narrator": "", "text": "05-02_わたしはしにました"},
        { "location": "222/TALK"    , "narrator": "つばめ", "text": "アーヤさんは"},
        { "location": "223/TALK"    , "narrator": "つばめ", "text": "ウソつく人じゃなぃ"},
        { "location": "224/TALK"    , "narrator": "つばめ", "text": "けど"},
        { "location": "225/TALK"    , "narrator": "つばめ", "text": "ちょっと"},
        { "location": "228/SEL"     , "narrator": "", "text": "何の話？"},
        { "location": "229/SEL"     , "narrator": "", "text": "詳しく聞いていい？"},
        { "location": "230/ACT"     , "narrator": "", "text": "何の話？"},
        { "location": "231/TALK"    , "narrator": "つばめ", "text": "ぅんとね(･Д･｀)"},
        { "location": "232/ACT"     , "narrator": "", "text": "詳しく聞いていい？"},
        { "location": "233/TALK"    , "narrator": "つばめ", "text": "聞いてくれるの？"},
        { "location": "235/TALK"    , "narrator": "つばめ", "text": "ぁたし"},
        { "location": "236/TALK"    , "narrator": "つばめ", "text": "ね"},
        { "location": "237/TALK"    , "narrator": "つばめ", "text": "死んだんだって"},
        { "location": "238/TALK"    , "narrator": "つばめ", "text": "ぁたし気絶してただけって思ってたけど"},
        { "location": "239/TALK"    , "narrator": "つばめ", "text": "そのとき"},
        { "location": "240/TALK"    , "narrator": "つばめ", "text": "死んでたんだって"},
        { "location": "243/SEL"     , "narrator": "", "text": "今話してるよね？"},
        { "location": "244/SEL"     , "narrator": "", "text": "今は生きてるの？"},
        { "location": "245/ACT"     , "narrator": "", "text": "今話してるよね？"},
        { "location": "246/TALK"    , "narrator": "つばめ", "text": "ぅん"},
        { "location": "247/TALK"    , "narrator": "つばめ", "text": "そうなんだけど(´・ω・｀)"},
        { "location": "248/ACT"     , "narrator": "", "text": "今は生きてるの？"},
        { "location": "249/TALK"    , "narrator": "つばめ", "text": "それがね"},
        { "location": "250/TALK"    , "narrator": "つばめ", "text": "ょくわからなぃんだ(´・ω・｀)"},
        { "location": "252/TALK"    , "narrator": "つばめ", "text": "だからね"},
        { "location": "253/TALK"    , "narrator": "つばめ", "text": "ひょっとしたらここゎ"},
        { "location": "254/TALK"    , "narrator": "つばめ", "text": "死後の世界なのかなって"},
        { "location": "256/TALK"    , "narrator": "つばめ", "text": "だって"},
        { "location": "257/TALK"    , "narrator": "つばめ", "text": "ぁたしがトライナリーに入ることになったとか"},
        { "location": "258/TALK"    , "narrator": "つばめ", "text": "ょく考えたらおかしぃし"},
        { "location": "259/TALK"    , "narrator": "つばめ", "text": "夢の世界なのかなって"},
        { "location": "260/TALK"    , "narrator": "つばめ", "text": "どう思う？"},
        { "location": "262/SEL"     , "narrator": "", "text": "夢も現も幻"},
        { "location": "263/SEL"     , "narrator": "", "text": "ほっぺたつねってみれば？"},
        { "location": "264/SEL"     , "narrator": "", "text": "つばめがいる世界こそが現実"},
        { "location": "265/ACT"     , "narrator": "", "text": "夢も現も幻"},
        { "location": "270/TALK"    , "narrator": "つばめ", "text": "なんだか"},
        { "location": "272/TALK"    , "narrator": "つばめ", "text": "ょくわからなぃです"},
        { "location": "273/ACT"     , "narrator": "", "text": "ほっぺたつねってみれば？"},
        { "location": "274/TALK"    , "narrator": "つばめ", "text": "痛かった"},
        { "location": "275/TALK"    , "narrator": "つばめ", "text": "けど"},
        { "location": "276/TALK"    , "narrator": "つばめ", "text": "わかんなぃままなの"},
        { "location": "277/ACT"     , "narrator": "", "text": "つばめがいる世界こそが現実"},
        { "location": "287/TALK"    , "narrator": "つばめ", "text": "そぅかな？"},
        { "location": "288/TALK"    , "narrator": "つばめ", "text": "そぅだょね？"},
        { "location": "290/TALK"    , "narrator": "つばめ", "text": "あとね"},
        { "location": "291/TALK"    , "narrator": "つばめ", "text": "心臓一突きされたって聞いたの"},
        { "location": "292/TALK"    , "narrator": "つばめ", "text": "でも怪我してないの"},
        { "location": "294/SEL"     , "narrator": "", "text": "見せてみて"},
        { "location": "295/ACT"     , "narrator": "", "text": "見せてみて"},
        { "location": "296/TALK"    , "narrator": "つばめ", "text": "ぅん"},
        { "location": "297/TALK"    , "narrator": "つばめ", "text": "確認してくれる？"},
        { "location": "300/SEL"     , "narrator": "", "text": "こらこら"},
        { "location": "301/SEL"     , "narrator": "", "text": "警戒心を持ちなさい"},
        { "location": "302/SEL"     , "narrator": "", "text": "冗談だよ"},
        { "location": "303/ACT"     , "narrator": "", "text": "こらこら"},
        { "location": "304/TALK"    , "narrator": "つばめ", "text": "ぁれ？"},
        { "location": "305/TALK"    , "narrator": "つばめ", "text": "ダメなことなの！？！？！？"},
        { "location": "306/ACT"     , "narrator": "", "text": "警戒心を持ちなさい"},
        { "location": "307/TALK"    , "narrator": "つばめ", "text": "どぅして？"},
        { "location": "308/TALK"    , "narrator": "つばめ", "text": "$handle$になら平気だよ？"},
        { "location": "309/ACT"     , "narrator": "", "text": "冗談だよ"},
        { "location": "310/TALK"    , "narrator": "つばめ", "text": "ぇ？"},
        { "location": "311/TALK"    , "narrator": "つばめ", "text": "そうだったの？"},
        { "location": "317/TALK"    , "narrator": "つばめ", "text": "$handle$でも"},
        { "location": "318/TALK"    , "narrator": "つばめ", "text": "わからなぃのかぁ・・・(´ｪ｀；)三(；´ｪ｀)"},
        { "location": "319/TALK"    , "narrator": "つばめ", "text": "死んだって言われても"},
        { "location": "320/TALK"    , "narrator": "つばめ", "text": "ピンとこないまんまなんだ"},
        { "location": "321/TALK"    , "narrator": "つばめ", "text": "あ"},
        { "location": "322/TALK"    , "narrator": "つばめ", "text": "そういえばね"},
        { "location": "323/TALK"    , "narrator": "つばめ", "text": "死んだ後のぁたし"},
        { "location": "324/TALK"    , "narrator": "つばめ", "text": "人が変わったみたいになって"},
        { "location": "325/TALK"    , "narrator": "つばめ", "text": "クラン壊したんだって"},
        { "location": "326/TALK"    , "narrator": "つばめ", "text": "それも全然覚えてないんだ"},
        { "location": "328/SEL"     , "narrator": "", "text": "夢遊病だね"},
        { "location": "329/SEL"     , "narrator": "", "text": "ウソつかれたんじゃない？"},
        { "location": "330/SEL"     , "narrator": "", "text": "スマホで撮影とかしてないの？"},
        { "location": "331/ACT"     , "narrator": "", "text": "夢遊病だね"},
        { "location": "332/TALK"    , "narrator": "つばめ", "text": "ぇっ"},
        { "location": "333/TALK"    , "narrator": "つばめ", "text": "そぅぃぅこと"},
        { "location": "334/TALK"    , "narrator": "つばめ", "text": "じゃないと思うけど・・・"},
        { "location": "335/ACT"     , "narrator": "", "text": "ウソつかれたんじゃない？"},
        { "location": "336/TALK"    , "narrator": "つばめ", "text": "ぅそ"},
        { "location": "338/TALK"    , "narrator": "つばめ", "text": "なのかな・・・"},
        { "location": "339/ACT"     , "narrator": "", "text": "スマホで撮影とかしてないの？"},
        { "location": "340/TALK"    , "narrator": "つばめ", "text": "そんなの"},
        { "location": "341/TALK"    , "narrator": "つばめ", "text": "なぃょ"},
        { "location": "343/TALK"    , "narrator": "つばめ", "text": "誰か"},
        { "location": "345/TALK"    , "narrator": "つばめ", "text": "本当のことおしえてくれなぃかな"},
        { "location": "347/SEL"     , "narrator": "", "text": "$me$が知ってる"},
        { "location": "348/SEL"     , "narrator": "", "text": "そのうちあえるかも"},
        { "location": "349/ACT"     , "narrator": "", "text": "$me$が知ってる"},
        { "location": "350/TALK"    , "narrator": "つばめ", "text": "ホント！？"},
        { "location": "351/TALK"    , "narrator": "つばめ", "text": "$handle$は"},
        { "location": "352/TALK"    , "narrator": "つばめ", "text": "やっぱりすごぃね(*´︶`*)"},
        { "location": "355/ACT"     , "narrator": "", "text": "そのうちあえるかも"},
        { "location": "365/TALK"    , "narrator": "つばめ", "text": "会えるのかな"},
        { "location": "366/TALK"    , "narrator": "つばめ", "text": "ぅん"},
        { "location": "367/TALK"    , "narrator": "つばめ", "text": "そぅだょね(*´︶`*)"},
        { "location": "369/TALK"    , "narrator": "つばめ", "text": "なんだか"},
        { "location": "370/TALK"    , "narrator": "つばめ", "text": "眠くなってきちゃった"},
        { "location": "372/TALK"    , "narrator": "つばめ", "text": "ぇとね"},
        { "location": "373/TALK"    , "narrator": "つばめ", "text": "眠るまで一緒にぃてくれる？"},
        { "location": "375/SEL"     , "narrator": "", "text": "いるよ"},
        { "location": "376/SEL"     , "narrator": "", "text": "安心してお休み"},
        { "location": "377/ACT"     , "narrator": "", "text": "いるよ"},
        { "location": "378/TALK"    , "narrator": "つばめ", "text": "ぅん"},
        { "location": "379/TALK"    , "narrator": "つばめ", "text": "ぁりがとぅ"},
        { "location": "380/ACT"     , "narrator": "", "text": "安心してお休み"},
        { "location": "390/TALK"    , "narrator": "つばめ", "text": "$handle$は"},
        { "location": "391/TALK"    , "narrator": "つばめ", "text": "たよりになるね"},
        { "location": "393/TALK"    , "narrator": "つばめ", "text": "ぁたしね"},
        { "location": "394/TALK"    , "narrator": "つばめ", "text": "一人暮らしって初めてなんだ"},
        { "location": "395/TALK"    , "narrator": "つばめ", "text": "だからちょっと心細いなって思っちゃったの"},
        { "location": "396/TALK"    , "narrator": "つばめ", "text": "でも"},
        { "location": "398/TALK"    , "narrator": "つばめ", "text": "$handle$がいてくれると"},
        { "location": "399/TALK"    , "narrator": "つばめ", "text": "あんしんできるの"},
        { "location": "400/TALK"    , "narrator": "つばめ", "text": "ぁりがとぅ"},
        { "location": "283/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"},
        { "location": "361/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"},
