    "entry":
    [
        { "location": "301/SCENARIO", "narrator": "", "text": "170_ハッカーの条件"},
        { "location": "326/TALK"    , "narrator": "みやび", "text": "伝授しようぞ"},
        { "location": "327/TALK"    , "narrator": "みやび", "text": "ハッカー心得"},
        { "location": "329/SEL"     , "narrator": "", "text": "また映画でも観たの？"},
        { "location": "330/SEL"     , "narrator": "", "text": "あ、はい"},
        { "location": "331/SEL"     , "narrator": "", "text": "ご指導よろしくお願いします！"},
        { "location": "332/ACT"     , "narrator": "", "text": "また映画でも観たの？"},
        { "location": "333/TALK"    , "narrator": "みやび", "text": "いや"},
        { "location": "334/TALK"    , "narrator": "みやび", "text": "小説だ"},
        { "location": "335/TALK"    , "narrator": "みやび", "text": "IT系スパイ小説"},
        { "location": "336/ACT"     , "narrator": "", "text": "あ、はい"},
        { "location": "337/TALK"    , "narrator": "みやび", "text": "どうにも"},
        { "location": "339/TALK"    , "narrator": "みやび", "text": "覇気がないの"},
        { "location": "340/ACT"     , "narrator": "", "text": "ご指導よろしくお願いします！"},
        { "location": "350/TALK"    , "narrator": "みやび", "text": "うむ"},
        { "location": "351/TALK"    , "narrator": "みやび", "text": "よい返事"},
        { "location": "352/TALK"    , "narrator": "みやび", "text": "しかし"},
        { "location": "353/TALK"    , "narrator": "みやび", "text": "迎合はハッカーの恥であるぞ"},
        { "location": "355/TALK"    , "narrator": "みやび", "text": "つまり世界は解決を待ち"},
        { "location": "356/TALK"    , "narrator": "みやび", "text": "一度解かれた問題は二度と問題とならず"},
        { "location": "357/SEL"     , "narrator": "", "text": "どこまで続ける気？"},
        { "location": "358/SEL"     , "narrator": "", "text": "それより楽しい話をしようよ"},
        { "location": "359/SEL"     , "narrator": "", "text": "生き生きしてるみやびは素敵"},
        { "location": "360/TALK"    , "narrator": "みやび", "text": "退屈、ましてや単純作業は害悪でしかなく"},
        { "location": "361/TALK"    , "narrator": "みやび", "text": "自由こそが正義"},
        { "location": "362/TALK"    , "narrator": "みやび", "text": "そうして一番大事なことは"},
        { "location": "363/TALK"    , "narrator": "みやび", "text": "心構えは技能の代用にならぬ"},
        { "location": "364/TALK"    , "narrator": "みやび", "text": "知識と技能"},
        { "location": "365/TALK"    , "narrator": "みやび", "text": "それがハッカーに必要なこと"},
        { "location": "366/ACT"     , "narrator": "", "text": "どこまで続ける気？"},
        { "location": "367/TALK"    , "narrator": "みやび", "text": "お"},
        { "location": "368/TALK"    , "narrator": "みやび", "text": "興味なしか"},
        { "location": "370/TALK"    , "narrator": "みやび", "text": "残念"},
        { "location": "371/ACT"     , "narrator": "", "text": "それより楽しい話をしようよ"},
        { "location": "372/TALK"    , "narrator": "みやび", "text": "これ以上楽しい話は"},
        { "location": "373/TALK"    , "narrator": "みやび", "text": "この世に存在せんぞ"},
        { "location": "374/TALK"    , "narrator": "みやび", "text": "この阿呆が"},
        { "location": "375/ACT"     , "narrator": "", "text": "生き生きしてるみやびは素敵"},
        { "location": "385/TALK"    , "narrator": "みやび", "text": "うちはいつでもぴちぴちぞね"},
        { "location": "386/TALK"    , "narrator": "みやび", "text": "例えれば"},
        { "location": "387/TALK"    , "narrator": "みやび", "text": "例えれば"},
        { "location": "388/TALK"    , "narrator": "みやび", "text": "いい答えが思いつかんが"},
        { "location": "389/TALK"    , "narrator": "みやび", "text": "とにかく"},
        { "location": "390/TALK"    , "narrator": "みやび", "text": "生き生きのぴちぴちぞね"},
        { "location": "393/SEL"     , "narrator": "", "text": "ハッカーって結局オタクってこと？"},
        { "location": "394/SEL"     , "narrator": "", "text": "今はギークとか言うんじゃないの？"},
        { "location": "395/SEL"     , "narrator": "", "text": "クラッカーとは違うの？"},
        { "location": "396/ACT"     , "narrator": "", "text": "ハッカーって結局オタクってこと？"},
        { "location": "397/TALK"    , "narrator": "みやび", "text": "オタクとは"},
        { "location": "398/TALK"    , "narrator": "みやび", "text": "どういうことだ"},
        { "location": "400/SEL"     , "narrator": "", "text": "なんかマニア？"},
        { "location": "401/SEL"     , "narrator": "", "text": "興味あることにはこだわる系"},
        { "location": "402/ACT"     , "narrator": "", "text": "なんかマニア？"},
        { "location": "403/TALK"    , "narrator": "みやび", "text": "収集癖とかそういうことか"},
        { "location": "404/TALK"    , "narrator": "みやび", "text": "データの蓄積は"},
        { "location": "405/TALK"    , "narrator": "みやび", "text": "解析が前提ぞ"},
        { "location": "406/ACT"     , "narrator": "", "text": "興味あることにはこだわる系"},
        { "location": "407/TALK"    , "narrator": "みやび", "text": "こだわりなしに"},
        { "location": "408/TALK"    , "narrator": "みやび", "text": "何の人生か"},
        { "location": "410/ACT"     , "narrator": "", "text": "今はギークとか言うんじゃないの？"},
        { "location": "411/TALK"    , "narrator": "みやび", "text": "ほう"},
        { "location": "412/TALK"    , "narrator": "みやび", "text": "どこでそんな言葉を覚えた"},
        { "location": "414/SEL"     , "narrator": "", "text": "ネットで"},
        { "location": "415/SEL"     , "narrator": "", "text": "天啓を受けて"},
        { "location": "416/ACT"     , "narrator": "", "text": "ネットで"},
        { "location": "417/TALK"    , "narrator": "みやび", "text": "凡庸だが"},
        { "location": "418/TALK"    , "narrator": "みやび", "text": "納得の答え"},
        { "location": "419/ACT"     , "narrator": "", "text": "天啓を受けて"},
        { "location": "420/TALK"    , "narrator": "みやび", "text": "なるほど"},
        { "location": "421/TALK"    , "narrator": "みやび", "text": "スピリチュアル系とは思わなんだ"},
        { "location": "422/TALK"    , "narrator": "みやび", "text": "それは一番"},
        { "location": "423/TALK"    , "narrator": "みやび", "text": "ハッカーとは遠い場所のもの"},
        { "location": "425/ACT"     , "narrator": "", "text": "クラッカーとは違うの？"},
        { "location": "426/TALK"    , "narrator": "みやび", "text": "違うな"},
        { "location": "427/TALK"    , "narrator": "みやび", "text": "断じて"},
        { "location": "429/TALK"    , "narrator": "みやび", "text": "さてさて"},
        { "location": "430/TALK"    , "narrator": "みやび", "text": "ハッカーであり続けるためには"},
        { "location": "431/TALK"    , "narrator": "みやび", "text": "心構えと技術の習得が必要なわけだが"},
        { "location": "433/SEL"     , "narrator": "", "text": "心構えはできてるよ！"},
        { "location": "434/SEL"     , "narrator": "", "text": "技術は超一流だけど？"},
        { "location": "435/ACT"     , "narrator": "", "text": "心構えはできてるよ！"},
        { "location": "436/TALK"    , "narrator": "みやび", "text": "ほほう"},
        { "location": "437/ACT"     , "narrator": "", "text": "技術は超一流だけど？"},
        { "location": "438/TALK"    , "narrator": "みやび", "text": "いやいや"},
        { "location": "439/TALK"    , "narrator": "みやび", "text": "それはなかろ"},
        { "location": "441/TALK"    , "narrator": "みやび", "text": "どうせなら"},
        { "location": "442/TALK"    , "narrator": "みやび", "text": "充実した人生を送ろうとはおもわんかね？"},
        { "location": "444/SEL"     , "narrator": "", "text": "二度寝が一番楽しいよね"},
        { "location": "445/SEL"     , "narrator": "", "text": "みやびと話せて充実してるし"},
        { "location": "446/ACT"     , "narrator": "", "text": "二度寝が一番楽しいよね"},
        { "location": "447/TALK"    , "narrator": "みやび", "text": "確かに"},
        { "location": "448/TALK"    , "narrator": "みやび", "text": "それは何事にも替え難い"},
        { "location": "449/TALK"    , "narrator": "みやび", "text": "甘美な時間"},
        { "location": "451/SEL"     , "narrator": "", "text": "二度寝最高！"},
        { "location": "452/ACT"     , "narrator": "", "text": "二度寝最高！"},
        { "location": "453/TALK"    , "narrator": "みやび", "text": "二度寝最高！！！！！！"},
        { "location": "454/TALK"    , "narrator": "みやび", "text": "って"},
        { "location": "455/TALK"    , "narrator": "みやび", "text": "テンション高くいうことなのか"},
        { "location": "457/TALK"    , "narrator": "みやび", "text": "これは"},
        { "location": "459/ACT"     , "narrator": "", "text": "みやびと話せて充実してるし"},
        { "location": "460/TALK"    , "narrator": "みやび", "text": "まあ"},
        { "location": "461/TALK"    , "narrator": "みやび", "text": "それは何よりだが"},
        { "location": "462/TALK"    , "narrator": "みやび", "text": "そればかりでは"},
        { "location": "463/TALK"    , "narrator": "みやび", "text": "いかんろう"},
        { "location": "465/TALK"    , "narrator": "みやび", "text": "そんなわけで"},
        { "location": "466/TALK"    , "narrator": "みやび", "text": "精進せよ相棒"},
        { "location": "467/TALK"    , "narrator": "みやび", "text": "そしてうちもまた"},
        { "location": "468/TALK"    , "narrator": "みやび", "text": "腕を磨くと宣言しておく"},
        { "location": "346/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>600pt.</b></color></size>\nアップしました！"},
        { "location": "381/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>600pt.</b></color></size>\nアップしました！"}
    ]
}
