{
    "dir": "chap10/daydra/dd_ch05_10_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "10505",
        "cid": "kagura",
        "title": "005 メインストーリー",
        "sub_title": "私は卯月神楽？＜後編＞"
    },
    "entry":
    [
        { "location": "828/TALK"  , "narrator": "神楽", "text": "はぁ…。"},
        { "location": "830/TALK"  , "narrator": "神楽", "text": "あー、ダメ…。\n全然内容が\n頭に入らない…。"},
        { "location": "831/TALK"  , "narrator": "神楽", "text": "今までは、どんなに\n疲れてるときでも\n夢中で読んでたのになぁ。"},
        { "location": "835/TALK"  , "narrator": "神楽", "text": "あっ！"},
        { "location": "840/TALK"  , "narrator": "つばめ", "text": "お弁当タィムーヽ(*´∀｀*)ﾉ"},
        { "location": "841/TALK"  , "narrator": "つばめ", "text": "まゆちんから"},
        { "location": "842/TALK"  , "narrator": "つばめ", "text": "卵焼きのぉ裾分け(*´﹃｀*)"},
        { "location": "844/TALK"  , "narrator": "神楽", "text": "美味しそうですね"},
        { "location": "846/TALK"  , "narrator": "雛", "text": "☆ゲキウマ☆"},
        { "location": "847/TALK"  , "narrator": "繭", "text": "実は冷凍食品"},
        { "location": "848/TALK"  , "narrator": "つばめ", "text": "ぇっ！？(ﾟ△ﾟ;ﾉ)ﾉ"},
        { "location": "849/TALK"  , "narrator": "繭", "text": "冗談"},
        { "location": "850/TALK"  , "narrator": "神楽", "text": "繭さんも冗談って言うんですね"},
        { "location": "853/TALK"  , "narrator": "雛", "text": "かなりレアー"},
        { "location": "854/TALK"  , "narrator": "神楽", "text": "見ていたらお腹空いてきました"},
        { "location": "855/TALK"  , "narrator": "神楽", "text": "私もそろそろお昼にしようかな？"},
        { "location": "858/TALK"  , "narrator": "神楽", "text": "？"},
        { "location": "860/TALK"  , "narrator": "つばめ", "text": "神楽ちゃん"},
        { "location": "861/TALK"  , "narrator": "つばめ", "text": "ぉ昼まだだったの？(´･ω･｀) "},
        { "location": "862/TALK"  , "narrator": "神楽", "text": "食欲なかったんですけど"},
        { "location": "863/TALK"  , "narrator": "神楽", "text": "お弁当の写真見たら空いてきました"},
        { "location": "866/TALK"  , "narrator": "神楽", "text": "なにを食べるべきか"},
        { "location": "869/TALK"  , "narrator": "つばめ", "text": "わたしもそぅ思ぅ(≧ω≦)"},
        { "location": "870/TALK"  , "narrator": "神楽", "text": "はい？"},
        { "location": "872/TALK"  , "narrator": "つばめ", "text": "わー(ﾟ△ﾟ;ﾉ)ﾉ"},
        { "location": "873/TALK"  , "narrator": "つばめ", "text": "ごめんなさいー"},
        { "location": "874/TALK"  , "narrator": "つばめ", "text": "こっちで話してたこと"},
        { "location": "875/TALK"  , "narrator": "つばめ", "text": "ぅっかりＷＡＶＥに送っちゃった(/ω＼)(/ω＼)ﾊｽﾞｶｼｰｨ"},
        { "location": "877/TALK"  , "narrator": "雛", "text": "すごいよつばめちゃん"},
        { "location": "878/TALK"  , "narrator": "雛", "text": "そんなうっかり"},
        { "location": "879/TALK"  , "narrator": "雛", "text": "つばめちゃんしかできないよ"},
        { "location": "880/TALK"  , "narrator": "繭", "text": "ひなこも似たようなことした"},
        { "location": "881/TALK"  , "narrator": "雛", "text": "いつ？"},
        { "location": "882/TALK"  , "narrator": "繭", "text": "おかゆって言ったし"},
        { "location": "883/TALK"  , "narrator": "神楽", "text": "なんの話ですか？"},
        { "location": "885/TALK"  , "narrator": "雛", "text": "そうだ、おかゆ！"},
        { "location": "886/TALK"  , "narrator": "雛", "text": "おかゆだよ神楽ちゃん！"},
        { "location": "887/TALK"  , "narrator": "神楽", "text": "？？？？？"},
        { "location": "889/TALK"  , "narrator": "雛", "text": "神楽ちゃんのお昼ごはん"},
        { "location": "890/TALK"  , "narrator": "神楽", "text": "ああ"},
        { "location": "891/TALK"  , "narrator": "神楽", "text": "おかゆいいですね"},
        { "location": "892/TALK"  , "narrator": "神楽", "text": "優しい味で癒やされそうです"},
        { "location": "895/TALK"  , "narrator": "繭", "text": "もっと普通のでいいと思うけど？"},
        { "location": "896/TALK"  , "narrator": "繭", "text": "風邪ってわけじゃないんだし"},
        { "location": "897/TALK"  , "narrator": "神楽", "text": "じゃあなにかオススメは？"},
        { "location": "899/TALK"  , "narrator": "繭", "text": "唐揚げとか"},
        { "location": "900/TALK"  , "narrator": "神楽", "text": "急に油っこくなったような？"},
        { "location": "902/TALK"  , "narrator": "繭", "text": "美味しいから"},
        { "location": "903/TALK"  , "narrator": "神楽", "text": "食べてるんですか？"},
        { "location": "905/TALK"  , "narrator": "繭", "text": "レモンはないけど"},
        { "location": "906/TALK"  , "narrator": "繭", "text": "ひなこが持ってきてないから"},
        { "location": "907/TALK"  , "narrator": "神楽", "text": "食べてる唐揚げ"},
        { "location": "908/TALK"  , "narrator": "神楽", "text": "ひなこさんのだったんですね"},
        { "location": "911/TALK"  , "narrator": "神楽", "text": "ところでつばめさんは？"},
        { "location": "912/TALK"  , "narrator": "繭", "text": "ひなこと話に夢中"},
        { "location": "913/TALK"  , "narrator": "繭", "text": "おかゆナンバーワンの味について"},
        { "location": "917/TALK"  , "narrator": "神楽", "text": "ごめんなさい"},
        { "location": "918/TALK"  , "narrator": "神楽", "text": "ちょっと目眩がするので落ちますね"},
        { "location": "921/TALK"  , "narrator": "繭", "text": "お大事に"},
        { "location": "925/TALK"  , "narrator": "神楽", "text": "まあ、リアルの方が\n盛り上がるから…。"},
        { "location": "927/TALK"  , "narrator": "神楽", "text": "こっちがついでになるのは\n仕方ないんだけど。"},
        { "location": "929/TALK"  , "narrator": "神楽", "text": "…でも、つばめさんまで\n私を構わないなんて、\n信じられない！"},
        { "location": "930/TALK"  , "narrator": "神楽", "text": "いつもなら卯月さん\n卯月さんしつこいくらい\n構って――"},
        { "location": "931/TALK"  , "narrator": "神楽", "text": "…私、なに考えてるの？"},
        { "location": "932/TALK"  , "narrator": "神楽", "text": "これじゃまるで、\n私がつばめさん達と\n話すのを…。"},
        { "location": "933/TALK"  , "narrator": "神楽", "text": "楽しみにしてる\nみたい…。"},
        { "location": "936/TALK"  , "narrator": "神楽", "text": "…ううん、まさか。\nそんなことない。"},
        { "location": "937/TALK"  , "narrator": "神楽", "text": "ひなこさんや繭さんと\n話すのが楽しいだけで…。"},
        { "location": "938/TALK"  , "narrator": "神楽", "text": "つばめさんと話すのが\n楽しい、ってわけじゃ\nない。"},
        { "location": "939/TALK"  , "narrator": "神楽", "text": "きっとそうよ。\nそうじゃなきゃ…。"},
        { "location": "940/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "942/TALK"  , "narrator": "神楽", "text": "はぁ…やっぱり、\n疲れてるのかなぁ？"},
        { "location": "951/DIALOG", "narrator": "Dialog_chapter_ch05", "text": "【08 HANABI】"},
        { "location": "963/DIALOG", "narrator": "Dialog_chapter_ch05", "text": "【08 HANABI】"}
    ]
}
