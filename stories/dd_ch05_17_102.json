    "entry":
    [
        { "location": "2021/TALK"  , "narrator": "神楽", "text": "…よし、おしまいっ！"},
        { "location": "2022/TALK"  , "narrator": "神楽", "text": "ふぅ…、集中したせいか、\n思ってたよりも\n早く終わったわ。"},
        { "location": "2024/TALK"  , "narrator": "神楽", "text": "…とりあえず、\nお風呂入って\nさっぱりしてこよう。"},
        { "location": "2041/TALK"  , "narrator": "神楽", "text": "さっぱりした…。"},
        { "location": "2042/TALK"  , "narrator": "神楽", "text": "…もうこんな時間。\nいつもだったらとっくに\n寝てるけど…。"},
        { "location": "2043/TALK"  , "narrator": "神楽", "text": "今日は気分もいいし、\n久しぶりに絵でも\n描いてみようかな。"},
        { "location": "2058/TALK"  , "narrator": "神楽", "text": "ふぅ…。\nこんなところかしら？"},
        { "location": "2059/TALK"  , "narrator": "神楽", "text": "王道ファンタジー風な\n絵にしたけど…。"},
        { "location": "2060/TALK"  , "narrator": "神楽", "text": "会心の出来だわ。\nお色気要素を出さなくて\n正解だったみたい。"},
        { "location": "2061/TALK"  , "narrator": "神楽", "text": "ふふっ…、たまには\nこういう絵も描くように\nしようかな？"},
        { "location": "2067/TALK"  , "narrator": "神楽", "text": "え？"},
        { "location": "2088/TALK"  , "narrator": "透明モーフィアス", "text": "うひょーっ！！\nメノウたんの自作絵\n激写ーッ！！"},
        { "location": "2090/TALK"  , "narrator": "神楽", "text": "そうだ…。\nこいつがいたんだった…。"},
        { "location": "2091/TALK"  , "narrator": "神楽", "text": "っていうか、そのデジカメ\n私のじゃないですか！！"},
        { "location": "2092/TALK"  , "narrator": "透明モーフィアス", "text": "んふふふふ、\nちょーっとだけ\n借りてるよぉ。"},
        { "location": "2093/TALK"  , "narrator": "神楽", "text": "人のカメラを\n勝手に使わないで！\nデリカシーなさ過ぎ！！"},
        { "location": "2094/TALK"  , "narrator": "神楽", "text": "っていうか、\n今までなにやってたの？"},
        { "location": "2095/TALK"  , "narrator": "透明モーフィアス", "text": "気になる？\nメノウたんを守るために\n頑張ってたんだよ。"},
        { "location": "2096/TALK"  , "narrator": "神楽", "text": "…はい？"},
        { "location": "2097/TALK"  , "narrator": "透明モーフィアス", "text": "掲示板に張り付いて、\nメノウたんのアンチを\nぶっつぶしてたのさ。"},
        { "location": "2098/TALK"  , "narrator": "神楽", "text": "ちょ、私のタブレットで\n変な書き込みしないで！！"},
        { "location": "2101/TALK"  , "narrator": "透明モーフィアス", "text": "メノウたんの自作絵\nうｐしまーす！！"},
        { "location": "2102/TALK"  , "narrator": "透明モーフィアス", "text": "ハンドルネームは、\n『メノウたんの\nかれぴっぴ』と…。"},
        { "location": "2103/TALK"  , "narrator": "神楽", "text": "…おい、人の話を\n聞けよコラ！！"},
        { "location": "2123/TALK"  , "narrator": "透明モーフィアス", "text": "ぬおおっ！？"},
        { "location": "2124/TALK"  , "narrator": "神楽", "text": "あんまり勝手なことばかり\nしてると…\n本気で壊すぞおい！！"},
        { "location": "2125/TALK"  , "narrator": "透明モーフィアス", "text": "うっ…こ、壊されるのは\nちょっとイヤかも…。"},
        { "location": "2126/TALK"  , "narrator": "神楽", "text": "なら、\n大人しく出ていけ！"},
        { "location": "2127/TALK"  , "narrator": "透明モーフィアス", "text": "ふ、ふひひ…、\n怒ったメノウたんも\n堪らないなぁ…。"},
        { "location": "2129/TALK"  , "narrator": "神楽", "text": "…………………。"},
        { "location": "2131/TALK"  , "narrator": "神楽", "text": "はぁ…もう、怒る気力も\nわかないわ…。"},
        { "location": "2138/TALK"  , "narrator": "神楽", "text": "何か他にいい方法を\n考えなくちゃ……"},
        { "location": "2139/TALK"  , "narrator": "神楽", "text": "……。"},
        { "location": "2141/TALK"  , "narrator": "神楽", "text": "…っ！！"},
        { "location": "2142/TALK"  , "narrator": "神楽", "text": "うーん……\nでもこれは……"},
        { "location": "2143/TALK"  , "narrator": "神楽", "text": "……。"},
        { "location": "2144/TALK"  , "narrator": "神楽", "text": "まあ……"},
        { "location": "2156/TALK"  , "narrator": "神楽", "text": "ねーねー"},
        { "location": "2158/SEL"   , "narrator": "", "text": "なに？"},
        { "location": "2159/ACT"   , "narrator": "", "text": "なに？"},
        { "location": "2161/TALK"  , "narrator": "神楽", "text": "あのね、ぴょんこと$handle$さん"},
        { "location": "2162/TALK"  , "narrator": "神楽", "text": "つきあおうぜー"},
        { "location": "2164/SEL"   , "narrator": "", "text": "やったあああああああ！！"},
        { "location": "2165/SEL"   , "narrator": "", "text": "いいよ"},
        { "location": "2166/SEL"   , "narrator": "", "text": "どうしたの！？急に"},
        { "location": "2167/ACT"   , "narrator": "", "text": "やったあああああああ！！"},
        { "location": "2168/TALK"  , "narrator": "神楽", "text": "いや、その"},
        { "location": "2169/TALK"  , "narrator": "神楽", "text": "そういう事にしておこうってだけですから"},
        { "location": "2170/ACT"   , "narrator": "", "text": "いいよ"},
        { "location": "2171/TALK"  , "narrator": "神楽", "text": "ちょｗｗｗｗｗナチュラルすぎる！！！！"},
        { "location": "2172/TALK"  , "narrator": "神楽", "text": "ということにしておいていい？ってだけなんですけどね"},
        { "location": "2173/ACT"   , "narrator": "", "text": "どうしたの！？急に"},
        { "location": "2174/TALK"  , "narrator": "神楽", "text": "そういうことにしておくだけです"},
        { "location": "2176/TALK"  , "narrator": "神楽", "text": "あの粗大ゴミを追い出すにはこれが一番かと"},
        { "location": "2177/TALK"  , "narrator": "神楽", "text": "というわけで一瞬だけお付き合いしてるってことにして、追い出しにご協力お願いします！！！"},
        { "location": "2179/SEL"   , "narrator": "", "text": "オーケー"},
        { "location": "2180/SEL"   , "narrator": "", "text": "うまくいくのかな"},
        { "location": "2181/ACT"   , "narrator": "", "text": "オーケー"},
        { "location": "2182/ACT"   , "narrator": "", "text": "うまくいくのかな"},
        { "location": "2183/TALK"  , "narrator": "神楽", "text": "それは$handle$さん次第"},
        { "location": "2196/TALK"  , "narrator": "神楽", "text": "はぁ～～～"},
        { "location": "2199/TALK"  , "narrator": "神楽", "text": "おい、ゴミクズ。"},
        { "location": "2200/TALK"  , "narrator": "透明モーフィアス", "text": "あ？"},
        { "location": "2201/TALK"  , "narrator": "神楽", "text": "もう遊びはお終いです。"},
        { "location": "2202/TALK"  , "narrator": "神楽", "text": "今日はこれから\n私の大切な人が来るので、\n出ていってください。"},
        { "location": "2203/TALK"  , "narrator": "透明モーフィアス", "text": "大切な人？？"},
        { "location": "2204/TALK"  , "narrator": "神楽", "text": "ちゃんと言わないと\nわからないんですか？\nだからゴミクズなんだよ。"},
        { "location": "2205/TALK"  , "narrator": "神楽", "text": "恋人です！"},
        { "location": "2206/TALK"  , "narrator": "神楽", "text": "こ・い・び・と！！"},
        { "location": "2207/TALK"  , "narrator": "透明モーフィアス", "text": "あ～、なーんだぁ。\nこいびとかぁ～～～"},
        { "location": "2217/TALK"  , "narrator": "透明モーフィアス", "text": "こいびと？？"},
        { "location": "2218/TALK"  , "narrator": "透明モーフィアス", "text": "……。"},
        { "location": "2225/TALK"  , "narrator": "透明モーフィアス", "text": "ぎょえぇぇぇぇぇ！！！\nこここここここここ\nこいびとだってぇ～！？"},
        { "location": "2226/TALK"  , "narrator": "透明モーフィアス", "text": "ぼぼぼぼぼ\n僕のメノウたんに\n恋人などいない！！"},
        { "location": "2227/TALK"  , "narrator": "神楽", "text": "…お前の中ではね。"},
        { "location": "2228/TALK"  , "narrator": "透明モーフィアス", "text": "嘘だ！\n騙されないぞ！"},
        { "location": "2229/TALK"  , "narrator": "透明モーフィアス", "text": "会うまでは\n絶対に信じないっ！！"},
        { "location": "2230/TALK"  , "narrator": "神楽", "text": "あぁ、そうですか。\nまあいいですけど。"},
        { "location": "2235/TALK"  , "narrator": "神楽", "text": "あっ。\nなーんて言ってたら\nWAVE来たっ！"},
        { "location": "2240/TALK"  , "narrator": "システム", "text": "神楽 さんが\nモーフィアス さんを\n招待しました。"},
        { "location": "2241/TALK"  , "narrator": "神楽", "text": "愛する$handle$♪まだ～～～？"},
        { "location": "2242/TALK"  , "narrator": "神楽", "text": "早くきて～～～～♪♪"},
        { "location": "2244/SEL"   , "narrator": "", "text": "もう着くよ"},
        { "location": "2245/SEL"   , "narrator": "", "text": "誰だモーフィアスってあぁぁん？？"},
        { "location": "2246/ACT"   , "narrator": "", "text": "もう着くよ"},
        { "location": "2247/TALK"  , "narrator": "透明モーフィアス", "text": "おいこら！$handle$とかいうやつ！"},
        { "location": "2248/TALK"  , "narrator": "透明モーフィアス", "text": "メノウたんの何なんだよおい、ぶっ飛ばすぞ\n(　ﾟДﾟ)ｳﾞｫｹ!!"},
        { "location": "2250/SEL"   , "narrator": "", "text": "やれやれ、身の程知らずが"},
        { "location": "2251/SEL"   , "narrator": "", "text": "結婚を前提にお付き合いしている者です"},
        { "location": "2252/ACT"   , "narrator": "", "text": "やれやれ、身の程知らずが"},
        { "location": "2253/TALK"  , "narrator": "透明モーフィアス", "text": "ハァ？凸(ﾟДﾟ#)ﾔﾝﾉｶｺﾞﾙｧ!!"},
        { "location": "2254/TALK"  , "narrator": "透明モーフィアス", "text": "ヤレヤレ、身の程知らずはどっちなんだかΣ(´∀｀；)"},
        { "location": "2255/TALK"  , "narrator": "透明モーフィアス", "text": "これからここに来るんだって？来れるモンなら来てみろよ。ボッコボコにしてやんよ\nｱｧ?( ´Д｀)σ)Д`)ｧｩｧｩ"},
        { "location": "2256/TALK"  , "narrator": "透明モーフィアス", "text": "ここはメノウたんとボクの愛の巣になったんだよ、お前が入り込める余地はない\n○|￣|＿ =3 ﾌﾞｯ"},
        { "location": "2257/ACT"   , "narrator": "", "text": "結婚を前提にお付き合いしている者です"},
        { "location": "2260/TALK"  , "narrator": "透明モーフィアス", "text": "メノウたんとケコーン？？？ありえないわー"},
        { "location": "2261/TALK"  , "narrator": "透明モーフィアス", "text": "メノウたんが結婚するわけないしｗｗｗｗ"},
        { "location": "2262/TALK"  , "narrator": "神楽", "text": "あ、そう、そういえばそれ！"},
        { "location": "2263/TALK"  , "narrator": "神楽", "text": "$handle$ハンコ押してくれた？"},
        { "location": "2264/TALK"  , "narrator": "神楽", "text": "婚姻届そろそろ出さないと、もう待ちくたびれちゃったんだけど"},
        { "location": "2266/SEL"   , "narrator": "", "text": "えー？昨日婚姻届受け取ったばかりじゃないか。しょうがないなぁ"},
        { "location": "2267/SEL"   , "narrator": "", "text": "あ、ごめん。そういえばもう印鑑押して役所に出しちゃった"},
        { "location": "2268/ACT"   , "narrator": "", "text": "えー？昨日婚姻届受け取ったばかりじゃないか。しょうがないなぁ"},
        { "location": "2269/TALK"  , "narrator": "神楽", "text": "もう２４時間もたってるーーーー！！"},
        { "location": "2270/TALK"  , "narrator": "神楽", "text": "はやく～～はやく～～～"},
        { "location": "2271/ACT"   , "narrator": "", "text": "あ、ごめん。そういえばもう印鑑押して役所に出しちゃった"},
        { "location": "2272/TALK"  , "narrator": "神楽", "text": "えぇぇぇっ！！ほんと？"},
        { "location": "2274/TALK"  , "narrator": "神楽", "text": "嬉しい～～～！！"},
        { "location": "2275/TALK"  , "narrator": "神楽", "text": "$handle$愛してる！！！"},
        { "location": "2276/TALK"  , "narrator": "神楽", "text": "じゃあ次はお式をどうするかよね、今日来たらお話しよ？"},
        { "location": "2279/TALK"  , "narrator": "透明モーフィアス", "text": "な"},
        { "location": "2280/TALK"  , "narrator": "神楽", "text": "ねえねえ、そろそろ着く？"},
        { "location": "2281/TALK"  , "narrator": "神楽", "text": "着く前に粗大ゴミ捨ててくるから、急がなくっちゃ♪"},
        { "location": "2282/TALK"  , "narrator": "神楽", "text": "ってわけだよ粗大ゴミ。出てけ"},
        { "location": "2284/TALK"  , "narrator": "透明モーフィアス", "text": "嘘だ!!"},
        { "location": "2285/TALK"  , "narrator": "透明モーフィアス", "text": "嘘だ嘘だ嘘だ嘘だ嘘だ嘘だ嘘だ嘘だ"},
        { "location": "2286/TALK"  , "narrator": "透明モーフィアス", "text": "会うまで信じないぞΣm9(　ﾟдﾟ)"},
        { "location": "2288/SEL"   , "narrator": "", "text": "仕方ないな、……面倒くさいし、○すか"},
        { "location": "2289/ACT"   , "narrator": "", "text": "仕方ないな、……面倒くさいし、○すか"},
        { "location": "2292/ACT"   , "narrator": "", "text": "誰だモーフィアスってあぁぁん？？"},
        { "location": "2293/TALK"  , "narrator": "透明モーフィアス", "text": "ハァ…口の聞き方も知らないクズか(　ﾟдﾟ)ﾎﾟｶｰﾝ"},
        { "location": "2294/TALK"  , "narrator": "透明モーフィアス", "text": "ボクはメノウたんと同棲してるんだぞ、お前の居場所なんてネーヨm9(^Д^)ﾌﾟｷﾞｬｰ"},
        { "location": "2295/TALK"  , "narrator": "神楽", "text": "愛する$handle$、助けてっ！"},
        { "location": "2296/TALK"  , "narrator": "神楽", "text": "私この粗大ゴミに粘着されてるんですっ！！"},
        { "location": "2299/TALK"  , "narrator": "透明モーフィアス", "text": "このゴミってだれ？あ、わかった$handle$とか言うヤツのことか！大丈夫だよメノウちゃんボクが護ってあげるからｸﾞﾍﾍ"},
        { "location": "2301/SEL"   , "narrator": "", "text": "……面倒くさいし、○すか"},
        { "location": "2302/SEL"   , "narrator": "", "text": "可哀想なヤツすぎて同情を隠せない"},
        { "location": "2303/ACT"   , "narrator": "", "text": "……面倒くさいし、○すか"},
        { "location": "2304/ACT"   , "narrator": "", "text": "可哀想なヤツすぎて同情を隠せない"},
        { "location": "2305/TALK"  , "narrator": "透明モーフィアス", "text": "ハァ？"},
        { "location": "2306/TALK"  , "narrator": "透明モーフィアス", "text": "(●)ω(●)なにいってんだこいつ"},
        { "location": "2307/TALK"  , "narrator": "透明モーフィアス", "text": " (´A`)つ☆ﾍﾟﾁﾍﾟﾁ\n　と＿⌒))\n　　 (_ﾉﾉ"},
        { "location": "2309/SEL"   , "narrator": "", "text": "生きてること自体が可哀想過ぎるので介錯してやるか"},
        { "location": "2310/ACT"   , "narrator": "", "text": "生きてること自体が可哀想過ぎるので介錯してやるか"},
        { "location": "2313/TALK"  , "narrator": "透明モーフィアス", "text": "通報しますた！！\n　(ﾟДﾟ)\n　@(　)>\n　／ >"},
        { "location": "2315/TALK"  , "narrator": "神楽", "text": "おいゴミ"},
        { "location": "2316/TALK"  , "narrator": "神楽", "text": "$handle$の警告は聞いておいた方がいいよ？"},
        { "location": "2317/TALK"  , "narrator": "神楽", "text": "私の愛する人は手を使わずにクラン壊せちゃうから"},
        { "location": "2319/TALK"  , "narrator": "透明モーフィアス", "text": "pgr!!!どうやってｗｗｗ\n( ´,_ゝ｀)ﾌﾟｯ"},
        { "location": "2321/SEL"   , "narrator": "", "text": "ココロアドレス教えてもらえたら、内部から破壊できるけど"},
        { "location": "2322/ACT"   , "narrator": "", "text": "ココロアドレス教えてもらえたら、内部から破壊できるけど"},
        { "location": "2324/TALK"  , "narrator": "透明モーフィアス", "text": "は"},
        { "location": "2325/TALK"  , "narrator": "透明モーフィアス", "text": "ココロアドレスなんて教えるわけねーだろ可哀想なヤツ\nm9(^Д^)9mﾌﾟｷﾞｬｰ!!"},
        { "location": "2327/TALK"  , "narrator": "神楽", "text": "$handle$にプレゼント♪"},
        { "location": "2331/SEL"   , "narrator": "", "text": "3E:55:81:6F:99:7E@0x552やるか"},
        { "location": "2332/ACT"   , "narrator": "", "text": "3E:55:81:6F:99:7E@0x552やるか"},
        { "location": "2334/TALK"  , "narrator": "透明モーフィアス", "text": "本当に通報してやる！！！"},
        { "location": "2335/TALK"  , "narrator": "神楽", "text": "いいけど本当に粗大ゴミになるからね"},
        { "location": "2337/SEL"   , "narrator": "", "text": "いま月島だからあと１０分で着くよ"},
        { "location": "2338/ACT"   , "narrator": "", "text": "いま月島だからあと１０分で着くよ"},
        { "location": "2340/TALK"  , "narrator": "神楽", "text": "嬉しい♪♪♪"},
        { "location": "2342/TALK"  , "narrator": "神楽", "text": "今夜は寝かさないからね～～～"},
        { "location": "2343/TALK"  , "narrator": "神楽", "text": "かまかまかまかま～～"},
        { "location": "2344/TALK"  , "narrator": "神楽", "text": "ずっとかまかまする～～～"},
        { "location": "2346/SEL"   , "narrator": "", "text": "モー豚、行った時にまだいたら破壊するから"},
        { "location": "2347/SEL"   , "narrator": "", "text": "神楽愛してるよ"},
        { "location": "2348/ACT"   , "narrator": "", "text": "モー豚、行った時にまだいたら破壊するから"},
        { "location": "2349/ACT"   , "narrator": "", "text": "神楽愛してるよ"},
        { "location": "2351/TALK"  , "narrator": "神楽", "text": "それじゃ待ってるね～～♪"},
        { "location": "2352/TALK"  , "narrator": "神楽", "text": "[物蔭]・*）ｱｲｼﾃﾙ"},
        { "location": "2353/TALK"  , "narrator": "神楽", "text": "|彡ｻｯ"},
        { "location": "2365/TALK"  , "narrator": "神楽", "text": "だって。"},
        { "location": "2369/TALK"  , "narrator": "透明モーフィアス", "text": "ぼっ…\nボクを売ったなぁぁっ！！"},
        { "location": "2370/TALK"  , "narrator": "神楽", "text": "元々買ってないし。"},
        { "location": "2371/TALK"  , "narrator": "神楽", "text": "早く出ていかないと\nほんとに壊されますよ？"},
        { "location": "2372/TALK"  , "narrator": "透明モーフィアス", "text": "こんなの……"},
        { "location": "2373/TALK"  , "narrator": "透明モーフィアス", "text": "こんなのボクの\nメノウたんじゃない！！"},
        { "location": "2374/TALK"  , "narrator": "神楽", "text": "やっとわかって\nくれたんですねっ！"},
        { "location": "2375/TALK"  , "narrator": "透明モーフィアス", "text": "全部掲示板に\n暴露してやる！！"},
        { "location": "2376/TALK"  , "narrator": "神楽", "text": "ソースひとつない\n書き込みを誰が信じるのか\n楽しみですねっ！"},
        { "location": "2377/TALK"  , "narrator": "透明モーフィアス", "text": "…っ。"},
        { "location": "2378/TALK"  , "narrator": "神楽", "text": "今！　すぐ！\n劇場に帰れば、今回の\nことは全部許します。"},
        { "location": "2379/TALK"  , "narrator": "神楽", "text": "けど$handle$が\n来たときにまだいたら――"},
        { "location": "2380/TALK"  , "narrator": "透明モーフィアス", "text": "うわあぁぁぁん！！"},
        { "location": "2381/TALK"  , "narrator": "透明モーフィアス", "text": "メノウたん最低！！\nファンやめます！！"},
        { "location": "2383/TALK"  , "narrator": "神楽", "text": "わぁぁい！！"},
        { "location": "2385/TALK"  , "narrator": "透明モーフィアス", "text": "覚えてろーっ！"},
        { "location": "2392/TALK"  , "narrator": "神楽", "text": "……。"},
        { "location": "2393/TALK"  , "narrator": "神楽", "text": "ふぅ……。"},
        { "location": "2408/TALK"  , "narrator": "神楽", "text": "お陰様で、ゴミを駆除できました\nありがとうございます♪"},
        { "location": "2410/SEL"   , "narrator": "", "text": "どういたしまして"},
        { "location": "2411/SEL"   , "narrator": "", "text": "モーフィアス大丈夫か？"},
        { "location": "2412/ACT"   , "narrator": "", "text": "どういたしまして"},
        { "location": "2413/ACT"   , "narrator": "", "text": "モーフィアス大丈夫か？"},
        { "location": "2414/TALK"  , "narrator": "神楽", "text": "大丈夫ですよ。こんなことでへこたれるタマじゃないと思いますし"},
        { "location": "2415/TALK"  , "narrator": "神楽", "text": "例えそうだとしても、アレがやったことは絶対に許さないからいいんです"},
        { "location": "2417/TALK"  , "narrator": "神楽", "text": "それにしても$handle$さんの恋人役、迫真の演技でしたね♪"},
        { "location": "2419/SEL"   , "narrator": "", "text": "神楽も本気かと思うほどだったよ"},
        { "location": "2420/SEL"   , "narrator": "", "text": "演技じゃなくて本心だから"},
        { "location": "2421/ACT"   , "narrator": "", "text": "神楽も本気かと思うほどだったよ"},
        { "location": "2422/TALK"  , "narrator": "神楽", "text": "私は役者ですから♪"},
        { "location": "2424/TALK"  , "narrator": "神楽", "text": "この手のことをやらせたら強いですよっ♪"},
        { "location": "2425/TALK"  , "narrator": "神楽", "text": "自慢げ！！フンッ♪"},
        { "location": "2427/SEL"   , "narrator": "", "text": "神楽かわいい"},
        { "location": "2428/SEL"   , "narrator": "", "text": "そりゃそうか"},
        { "location": "2429/ACT"   , "narrator": "", "text": "神楽かわいい"},
        { "location": "2430/TALK"  , "narrator": "神楽", "text": "$handle$さんもとてもいい演技でした！"},
        { "location": "2431/TALK"  , "narrator": "神楽", "text": "ドラマの子役やった時に教えてもらったんですけど"},
        { "location": "2432/TALK"  , "narrator": "神楽", "text": "演技してる間はそれが演技じゃなくて、１００％その子が自分だと思えなかったら負けなんだそうです"},
        { "location": "2433/TALK"  , "narrator": "神楽", "text": "その子と本当の自分が共存しちゃうと、その役は死んでしまうんだって"},
        { "location": "2434/TALK"  , "narrator": "神楽", "text": "その後のライブでも毎回リハの時からその言葉を思い出してやってるんです"},
        { "location": "2435/TALK"  , "narrator": "神楽", "text": "ちな、迫真の演技で恋愛ドラマやってる主演の二人は恋に落ちやすいんですって"},
        { "location": "2436/TALK"  , "narrator": "神楽", "text": "$handle$さんからもちょっとそういうのが伝わってきてドキドキしちゃいました♪"},
        { "location": "2438/SEL"   , "narrator": "", "text": "神楽は本当に創作に真剣なんだね"},
        { "location": "2439/SEL"   , "narrator": "", "text": "だって演技じゃ無くて本気だから"},
        { "location": "2440/ACT"   , "narrator": "", "text": "神楽は本当に創作に真剣なんだね"},
        { "location": "2441/TALK"  , "narrator": "神楽", "text": "そうですよ！"},
        { "location": "2442/TALK"  , "narrator": "神楽", "text": "そう言ってもらえて嬉しい"},
        { "location": "2443/TALK"  , "narrator": "神楽", "text": "あまりこういう話できる人もいないし、言ってくれる人もいませんでしたから"},
        { "location": "2444/ACT"   , "narrator": "", "text": "だって演技じゃ無くて本気だから"},
        { "location": "2448/TALK"  , "narrator": "神楽", "text": "そういう事を言ってるんじゃなくて"},
        { "location": "2450/SEL"   , "narrator": "", "text": "ごめん"},
        { "location": "2451/SEL"   , "narrator": "", "text": "本当に本気だから"},
        { "location": "2452/ACT"   , "narrator": "", "text": "ごめん"},
        { "location": "2453/TALK"  , "narrator": "神楽", "text": "いえ、私こそごめんなさい"},
        { "location": "2454/ACT"   , "narrator": "", "text": "本当に本気だから"},
        { "location": "2457/TALK"  , "narrator": "神楽", "text": "今は"},
        { "location": "2458/TALK"  , "narrator": "神楽", "text": "ちょっと"},
        { "location": "2460/TALK"  , "narrator": "神楽", "text": "また今度にしませんか？"},
        { "location": "2463/ACT"   , "narrator": "", "text": "そりゃそうか"},
        { "location": "2465/ACT"   , "narrator": "", "text": "演技じゃなくて本心だから"},
        { "location": "2468/TALK"  , "narrator": "神楽", "text": "とにかく、今回は助かりました"},
        { "location": "2469/TALK"  , "narrator": "神楽", "text": "これでしばらくは静かにしてるでしょう"},
        { "location": "2471/SEL"   , "narrator": "", "text": "でも、ちょっと安心した"},
        { "location": "2472/SEL"   , "narrator": "", "text": "$me$も踏まれたい…"},
        { "location": "2473/ACT"   , "narrator": "", "text": "でも、ちょっと安心した"},
        { "location": "2474/TALK"  , "narrator": "神楽", "text": "なにがですか？"},
        { "location": "2475/TALK"  , "narrator": "神楽", "text": "今の私のおかれた状況を見て"},
        { "location": "2476/TALK"  , "narrator": "神楽", "text": "なにを安心したんですか？"},
        { "location": "2478/SEL"   , "narrator": "", "text": "元気な神楽が見れたから"},
        { "location": "2479/ACT"   , "narrator": "", "text": "元気な神楽が見れたから"},
        { "location": "2482/TALK"  , "narrator": "神楽", "text": "確かにここ数日で"},
        { "location": "2483/TALK"  , "narrator": "神楽", "text": "今日は一番気持ちがラクです"},
        { "location": "2484/TALK"  , "narrator": "神楽", "text": "クソゴミのウザさが"},
        { "location": "2485/TALK"  , "narrator": "神楽", "text": "色々紛らわせてくれたのは事実です"},
        { "location": "2486/TALK"  , "narrator": "神楽", "text": "認めますよ"},
        { "location": "2487/TALK"  , "narrator": "神楽", "text": "でも"},
        { "location": "2488/TALK"  , "narrator": "神楽", "text": "これ以上は私の精神衛生的によくないのも事実です"},
        { "location": "2489/TALK"  , "narrator": "神楽", "text": "それに、それよりも"},
        { "location": "2492/TALK"  , "narrator": "神楽", "text": "今回は$handle$さんと色々できて楽しかったから"},
        { "location": "2493/ACT"   , "narrator": "", "text": "$me$も踏まれたい…"},
        { "location": "2495/TALK"  , "narrator": "神楽", "text": "突然そんなカミングアウトされても"},
        { "location": "2496/TALK"  , "narrator": "神楽", "text": "ただただ困るだけで"},
        { "location": "2498/TALK"  , "narrator": "神楽", "text": "でも、いつも色々お世話になってますから"},
        { "location": "2499/TALK"  , "narrator": "神楽", "text": "できることなら踏んであげたいですけど"},
        { "location": "2501/TALK"  , "narrator": "神楽", "text": "嘘です冗談です！"},
        { "location": "2502/TALK"  , "narrator": "神楽", "text": "私はそんなことしませんから！"},
        { "location": "2503/TALK"  , "narrator": "神楽", "text": "$handle$さんも、そういう変なこと言ったらダメですよ？"},
        { "location": "2515/TALK"  , "narrator": "神楽", "text": "……ふふっ。"},
        { "location": "2516/TALK"  , "narrator": "神楽", "text": "今も色々辛いし、\nこれからも色々あるけど…"},
        { "location": "2517/TALK"  , "narrator": "神楽", "text": "でも、今だけは――"},
        { "location": "2520/TALK"  , "narrator": "神楽", "text": "ちょっとだけ幸せかも。"},
        { "location": "2529/DIALOG", "narrator": "Dialog_chapter_ch05", "text": "【14 神楽学校やめるってよ】"},
        { "location": "2541/DIALOG", "narrator": "Dialog_chapter_ch05", "text": "【14 神楽学校やめるってよ】"}
    ]
}
