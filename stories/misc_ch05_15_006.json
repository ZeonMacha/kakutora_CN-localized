        { "location": "4715/TALK"    , "narrator": "神楽", "text": "ホーリー穴ホーリー"},
        { "location": "4717/SEL"     , "narrator": "", "text": "なんか混じった"},
        { "location": "4718/SEL"     , "narrator": "", "text": "結論がおかしい"},
        { "location": "4719/SEL"     , "narrator": "", "text": "$me$を埋めないでくださいガクガクブルブル"},
        { "location": "4720/ACT"     , "narrator": "", "text": "なんか混じった"},
        { "location": "4721/TALK"    , "narrator": "神楽", "text": "そうかも？"},
        { "location": "4722/ACT"     , "narrator": "", "text": "結論がおかしい"},
        { "location": "4723/TALK"    , "narrator": "神楽", "text": "そうなのかな？"},
        { "location": "4724/ACT"     , "narrator": "", "text": "$me$を埋めないでくださいガクガクブルブル"},
        { "location": "4726/TALK"    , "narrator": "神楽", "text": "いいねその怯え切った表情"},
        { "location": "4728/TALK"    , "narrator": "神楽", "text": "いいこだね？もっと震えて？"},
        { "location": "4729/TALK"    , "narrator": "神楽", "text": "ステキなぴょんこの$handlek$ちゃん♪"},
        { "location": "4731/TALK"    , "narrator": "神楽", "text": "ぴょんこちょっと不安なんだぴょん"},
        { "location": "4732/TALK"    , "narrator": "神楽", "text": "$handlek$はぴょんこに幸せになって欲しいって思ってますか？"},
        { "location": "4735/SEL"     , "narrator": "", "text": "もちろん"},
        { "location": "4736/SEL"     , "narrator": "", "text": "どうかな…"},
        { "location": "4737/SEL"     , "narrator": "", "text": "二人で幸せになろう"},
        { "location": "4738/ACT"     , "narrator": "", "text": "もちろん"},
        { "location": "4739/TALK"    , "narrator": "神楽", "text": "軽いなーもー"},
        { "location": "4740/TALK"    , "narrator": "神楽", "text": "まーいいけど"},
        { "location": "4741/ACT"     , "narrator": "", "text": "どうかな…"},
        { "location": "4742/TALK"    , "narrator": "神楽", "text": "ハァァァァァ！？！？！？"},
        { "location": "4743/TALK"    , "narrator": "神楽", "text": "ありえナス！！！"},
        { "location": "4744/ACT"     , "narrator": "", "text": "二人で幸せになろう"},
        { "location": "4746/TALK"    , "narrator": "神楽", "text": "二人で、、、？"},
        { "location": "4747/TALK"    , "narrator": "神楽", "text": "なんて甘美な響き"},
        { "location": "4748/TALK"    , "narrator": "神楽", "text": "ヤンデレに注がれる$handlek$の愛、、、"},
        { "location": "4749/TALK"    , "narrator": "神楽", "text": "たまらんね！！！！"}
