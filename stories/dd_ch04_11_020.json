{
    "dir": "chap11/daydra/dd_ch04_11_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "11456",
        "cid": "miyabi",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "調理実習"
    },
    "entry":
    [
        { "location": "256/SCENARIO", "narrator": "", "text": "調理実習"},
        { "location": "273/TALK"    , "narrator": "みやび", "text": "う～ん…。"},
        { "location": "274/SEL"     , "narrator": "", "text": "悩みごと？"},
        { "location": "276/TALK"    , "narrator": "みやび", "text": "どうしたもんか？"},
        { "location": "277/TALK"    , "narrator": "みやび", "text": "まあ、作った以上\n食べはするけんど――"},
        { "location": "278/TALK"    , "narrator": "みやび", "text": "見た目がこれやしなぁ…。"},
        { "location": "279/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "282/TALK"    , "narrator": "みやび", "text": "まあ、小腹が空いた\n時にでも、ちまちま\n食べればえいか。"},
        { "location": "284/ACT"     , "narrator": "", "text": "悩みごと？"},
        { "location": "303/TALK"    , "narrator": "みやび", "text": "そんな大層なもんやないちや"},
        { "location": "304/TALK"    , "narrator": "みやび", "text": "今日、調理実習でクッキーを作ったんやけんど"},
        { "location": "305/TALK"    , "narrator": "みやび", "text": "ウサギの形にするつもりが、崩れてボロボロになちゅうたがよ"},
        { "location": "308/SEL"     , "narrator": "", "text": "料理上手なのに！？"},
        { "location": "309/ACT"     , "narrator": "", "text": "料理上手なのに！？"},
        { "location": "312/TALK"    , "narrator": "みやび", "text": "うちの得意料理は和食限定やき、クッキーは専門外や"},
        { "location": "313/TALK"    , "narrator": "みやび", "text": "…まあ、簡単に見えたき、上手くいく思うたんやけんどね"},
        { "location": "315/TALK"    , "narrator": "みやび", "text": "そのクッキーをどうするかを、考え中なんよ"},
        { "location": "317/SEL"     , "narrator": "", "text": "食べたいな"},
        { "location": "318/SEL"     , "narrator": "", "text": "みんなのお茶菓子にしよう"},
        { "location": "319/SEL"     , "narrator": "", "text": "残念だけど捨てよう"},
        { "location": "320/ACT"     , "narrator": "", "text": "食べたいな"},
        { "location": "322/TALK"    , "narrator": "みやび", "text": "相棒にやったら食べさせてもえいけんど"},
        { "location": "324/TALK"    , "narrator": "みやび", "text": "まあ、ここにいないき、無理な話やね"},
        { "location": "325/TALK"    , "narrator": "みやび", "text": "…ちゅうか、美味いかどうかの確認もまだやき、ちっくと食べてみるちや"},
        { "location": "336/TALK"    , "narrator": "みやび", "text": "…見た目は美味そうには\n見えんけんど、どれ…。"},
        { "location": "337/TALK"    , "narrator": "みやび", "text": "あむっ……。"},
        { "location": "339/TALK"    , "narrator": "みやび", "text": "…ん？"},
        { "location": "340/TALK"    , "narrator": "みやび", "text": "なんや、見た目の割に\n味は普通やね。"},
        { "location": "341/TALK"    , "narrator": "みやび", "text": "美味くも不味くもない、\nただのクッキー…とでも\n言うんやろか？"},
        { "location": "342/TALK"    , "narrator": "みやび", "text": "んむんむ…しかし…\nあむっ…物足りんな。"},
        { "location": "343/TALK"    , "narrator": "みやび", "text": "甘さが足らんわけやない\nけんど、何か決定的な\nものが――"},
        { "location": "345/TALK"    , "narrator": "みやび", "text": "ああ、バニラビーンズの\n香りが足りないんやな。"},
        { "location": "346/TALK"    , "narrator": "みやび", "text": "決定的なミスは…\n多分それくらいか？"},
        { "location": "347/TALK"    , "narrator": "みやび", "text": "んむんむんむ…。"},
        { "location": "352/TALK"    , "narrator": "ガブリエラ", "text": "ちょっとみやび、\n仕事中に何食べてるのよ？"},
        { "location": "354/TALK"    , "narrator": "みやび", "text": "んっ…ああ、調理実習で\n作ったクッキーや。"},
        { "location": "355/TALK"    , "narrator": "ガブリエラ", "text": "えっ、みやびって\nクッキーとか作るの！？"},
        { "location": "356/TALK"    , "narrator": "ガブリエラ", "text": "あたしにもちょうだい。\nみやびのクッキー、\n食べてみたいわ。"},
        { "location": "358/TALK"    , "narrator": "みやび", "text": "えいけんど、あんまし\n期待すると――"},
        { "location": "359/TALK"    , "narrator": "みやび", "text": "って、すまんなぁ。\nうっかり全部食べて\nしもうた。"},
        { "location": "360/TALK"    , "narrator": "ガブリエラ", "text": "はぁ！？\n全部食べちゃったの！？"},
        { "location": "362/TALK"    , "narrator": "みやび", "text": "一つ残らず、\nうちのお腹に入って\nしまったようや。"},
        { "location": "365/TALK"    , "narrator": "ガブリエラ", "text": "そんなに美味しかった\nなら、少しくらい残して\nおいてくれても――"},
        { "location": "366/TALK"    , "narrator": "ガブリエラ", "text": "良かったのに…。"},
        { "location": "368/TALK"    , "narrator": "みやび", "text": "…期待してるほど、\n美味い味やないんよ？"},
        { "location": "369/TALK"    , "narrator": "ガブリエラ", "text": "みやびが料理上手なのは\nみんな知ってるん\nだから――"},
        { "location": "371/TALK"    , "narrator": "ガブリエラ", "text": "そんなのウソって\nバレバレよ？"},
        { "location": "372/TALK"    , "narrator": "みやび", "text": "いや、そう思うてくれ\nるんは嬉しいけんど…。"},
        { "location": "373/TALK"    , "narrator": "みやび", "text": "…わかった。\nじゃあ、ガブちゃんの\nために――"},
        { "location": "374/TALK"    , "narrator": "みやび", "text": "今度クッキー作るき、\nそれでえいか？"},
        { "location": "377/TALK"    , "narrator": "ガブリエラ", "text": "やった！\nさすがみやびね！"},
        { "location": "378/TALK"    , "narrator": "ガブリエラ", "text": "多めに作る分には\n全然かまわないから。\n楽しみにしてるわ。"},
        { "location": "382/TALK"    , "narrator": "みやび", "text": "…ちっくと、クッキーの\n練習しといた方が、\nえいかもしれんな。"},
        { "location": "384/TALK"    , "narrator": "みやび", "text": "はぁ…しゃあないなぁ…。"},
        { "location": "401/ACT"     , "narrator": "", "text": "みんなのお茶菓子にしよう"},
        { "location": "402/TALK"    , "narrator": "みやび", "text": "このボロボロのをみんなに食べさせるんは、ちっくと気が引けるぞね"},
        { "location": "403/TALK"    , "narrator": "みやび", "text": "…けんど、うちが初めて作ったクッキーやき"},
        { "location": "404/TALK"    , "narrator": "みやび", "text": "みんなに感想聞いた方が、今後の参考にはなるか"},
        { "location": "415/TALK"    , "narrator": "みやび", "text": "…よし。\nみんなを集めるぞね。"},
        { "location": "431/TALK"    , "narrator": "みやび", "text": "…ちゅうわけやき、\n味の保証はできん\nけんど――"},
        { "location": "432/TALK"    , "narrator": "みやび", "text": "それでもえいなら、\n食べてもらえんか？"},
        { "location": "435/TALK"    , "narrator": "ガブリエラ", "text": "あたしはもらうわ。"},
        { "location": "437/TALK"    , "narrator": "ガブリエラ", "text": "みやびの作ったものなら、\n不味くはならないと\n思うし。"},
        { "location": "439/TALK"    , "narrator": "つばめ", "text": "わたしも、いただきます。"},
        { "location": "440/TALK"    , "narrator": "みやび", "text": "…美味い保証はない\n言うてるのに。"},
        { "location": "442/TALK"    , "narrator": "アーヤ", "text": "私もいただくわ。"},
        { "location": "443/TALK"    , "narrator": "みやび", "text": "…超絶不味くても、\n怒らんでくれな？"},
        { "location": "445/TALK"    , "narrator": "アーヤ", "text": "怒ったりしないって。\nあむっ…。"},
        { "location": "447/TALK"    , "narrator": "ガブリエラ", "text": "んむんむ…。"},
        { "location": "450/TALK"    , "narrator": "ガブリエラ", "text": "…なんだ、\n美味しいじゃん。"},
        { "location": "451/TALK"    , "narrator": "みやび", "text": "…美味しい？"},
        { "location": "452/TALK"    , "narrator": "つばめ", "text": "はい、これ美味しいです。\nみやびさん、心配し過ぎ\nですよ。"},
        { "location": "453/TALK"    , "narrator": "ガブリエラ", "text": "サクサク感が少ないのと、\n甘さがちょっとだけ\n足りないけど――"},
        { "location": "455/TALK"    , "narrator": "ガブリエラ", "text": "普通に美味しいわね。\nアーヤもそう思うでしょ？"},
        { "location": "458/TALK"    , "narrator": "アーヤ", "text": "うん、美味しいわ。"},
        { "location": "460/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "462/TALK"    , "narrator": "アーヤ", "text": "不満なの？"},
        { "location": "463/TALK"    , "narrator": "みやび", "text": "いや…なんちゅうか、\n面白くてな。"},
        { "location": "467/TALK"    , "narrator": "みやび", "text": "和食を食べた時と違う、\nこのなんとも言えん\n微妙な反応が――"},
        { "location": "468/TALK"    , "narrator": "みやび", "text": "新鮮に感じるんよ。"},
        { "location": "470/TALK"    , "narrator": "ガブリエラ", "text": "…それ、面白いの？"},
        { "location": "471/TALK"    , "narrator": "みやび", "text": "うん、中々面白いちや。"},
        { "location": "473/TALK"    , "narrator": "みやび", "text": "今度はプリン作りに\n挑戦して、またみんなに\n食べてもらうか…。"},
        { "location": "476/TALK"    , "narrator": "つばめ", "text": "えっ、プリンですか！？\nやったー！"},
        { "location": "477/TALK"    , "narrator": "ガブリエラ", "text": "実験台にされるのは\nちょっと気に入らない\nけど――"},
        { "location": "478/TALK"    , "narrator": "ガブリエラ", "text": "美味しいプリンが\n食べれるなら、\nあたしも協力するわ。"},
        { "location": "480/TALK"    , "narrator": "みやび", "text": "どんな反応が見られるか、\n今から楽しみや。"},
        { "location": "482/TALK"    , "narrator": "アーヤ", "text": "…そうやって面白いから\n作ってるうちに――"},
        { "location": "483/TALK"    , "narrator": "アーヤ", "text": "知らず知らずの間に、\n極めていくタイプなのかも\nしれないわね…。"},
        { "location": "484/ACT"     , "narrator": "", "text": "残念だけど捨てよう"},
        { "location": "485/TALK"    , "narrator": "みやび", "text": "それは本気か？"},
        { "location": "486/TALK"    , "narrator": "みやび", "text": "冗談やとしても、うちはそういうの大嫌いや"},
        { "location": "487/TALK"    , "narrator": "みやび", "text": "うちが作った物を捨てろ言われて、怒ってるわけやないぞ？"},
        { "location": "488/TALK"    , "narrator": "みやび", "text": "軽い気持ちで食べ物を粗末にしよう思うんが許せないちや"},
        { "location": "499/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "501/TALK"    , "narrator": "みやび", "text": "ちっくと、熱くなり\n過ぎたか。"},
        { "location": "506/TALK"    , "narrator": "ガブリエラ", "text": "みやび、暇ならこっちの\n作業手伝っ――"},
        { "location": "508/TALK"    , "narrator": "ガブリエラ", "text": "うわ、何それ？\nボロボロのクッキー？"},
        { "location": "510/TALK"    , "narrator": "みやび", "text": "ん…うちが初めて作った\nクッキーちや。"},
        { "location": "511/TALK"    , "narrator": "ガブリエラ", "text": "…みやび、クッキー\n作ったことなかったんだ？"},
        { "location": "512/TALK"    , "narrator": "ガブリエラ", "text": "なんか意外だわ。"},
        { "location": "513/TALK"    , "narrator": "みやび", "text": "うちの得意料理は\n和食専門やきね。"},
        { "location": "515/TALK"    , "narrator": "みやび", "text": "こういう洋菓子は\nどうにも苦手ちや。"},
        { "location": "516/TALK"    , "narrator": "ガブリエラ", "text": "ふーん…。"},
        { "location": "517/TALK"    , "narrator": "ガブリエラ", "text": "ねえ、一つちょうだい。\n味見してみたいわ。"},
        { "location": "518/TALK"    , "narrator": "みやび", "text": "味の保証はできない\nけんど、それでも\nよければな。"},
        { "location": "520/TALK"    , "narrator": "ガブリエラ", "text": "構わないわ。\nじゃあ、一つ貰うね。"},
        { "location": "522/TALK"    , "narrator": "ガブリエラ", "text": "あむっ…んむんむ…。"},
        { "location": "523/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "527/TALK"    , "narrator": "みやび", "text": "…不味かった？"},
        { "location": "529/TALK"    , "narrator": "ガブリエラ", "text": "不味くはないけど――"},
        { "location": "531/TALK"    , "narrator": "ガブリエラ", "text": "ちょっと、みやびが\n作ったとは思えない\n味だわ。"},
        { "location": "532/TALK"    , "narrator": "みやび", "text": "？"},
        { "location": "534/TALK"    , "narrator": "ガブリエラ", "text": "凄く美味しいとは\n思えない、ってことよ。"},
        { "location": "536/TALK"    , "narrator": "みやび", "text": "そうか…ちっくと\n悔しいな…。"},
        { "location": "537/TALK"    , "narrator": "ガブリエラ", "text": "まあ、及第点以上の\n味なのは間違いない\nから――"},
        { "location": "538/TALK"    , "narrator": "ガブリエラ", "text": "悔しがる必要はないん\nじゃない？\n初めて作ったんだし。"},
        { "location": "540/TALK"    , "narrator": "みやび", "text": "…ガブちゃんはハッキリ\n言うてくれるから\n好きちや。"},
        { "location": "542/TALK"    , "narrator": "ガブリエラ", "text": "味見なんだから\nハッキリ言わないと\n意味ないじゃん。"},
        { "location": "543/TALK"    , "narrator": "ガブリエラ", "text": "もう一つちょうだい。"},
        { "location": "544/TALK"    , "narrator": "みやび", "text": "一つと言わず、\n全部持っていって\n構わんよ。"},
        { "location": "546/TALK"    , "narrator": "ガブリエラ", "text": "えっ、いいの！？\nやった！"},
        { "location": "547/TALK"    , "narrator": "ガブリエラ", "text": "今夜勉強する時の、\n夜食代わりにさせて\nもらうわ。"},
        { "location": "548/TALK"    , "narrator": "みやび", "text": "…ガブちゃんは\nえい子やね。"},
        { "location": "549/TALK"    , "narrator": "みやび", "text": "見た目が悪いき、\n捨てろとか言わんし。"},
        { "location": "551/TALK"    , "narrator": "ガブリエラ", "text": "そんな理由で捨てろとか、\n言うはずないじゃない。"},
        { "location": "553/TALK"    , "narrator": "みやび", "text": "…それを聞いて、\nちっくと安心したぞね。"},
        { "location": "556/TALK"    , "narrator": "みやび", "text": "ありがとな、ガブちゃん。"},
        { "location": "557/TALK"    , "narrator": "ガブリエラ", "text": "？　え、ええ…\nどういたしまして…？"},
        { "location": "264/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>6月30日　4:03 PM</color>\nとある平日、神楽坂トライナリー劇場でのバイト中のこと。"},
        { "location": "395/DIALOG"  , "narrator": "Dialog_GEThimegoto_ch04", "text": "【スイーツの甘きことなし】"}
    ]
}
