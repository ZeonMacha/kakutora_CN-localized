{
    "dir": "chap28/daydra/anime_01_28.js",
    "type": "MainStory",
    "info": {
        "story_id": "28101",
        "cid": "tsubame",
        "title": "001 アニメーション",
        "sub_title": "トークン・リング"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "アニメ第28話"},
        { "location": "48/TALK"   , "narrator": "エリカ", "text": "こんにちは、\n$handle$さん。"},
        { "location": "50/TALK"   , "narrator": "エリカ", "text": "前に色々話したから、\n今回はつばめちゃんの\nお話をするだけでもいい？"},
        { "location": "52/TALK"   , "narrator": "エリカ", "text": "前に色々話したから、\n今回は綾ちゃんの\nお話をするだけでもいい？"},
        { "location": "54/TALK"   , "narrator": "エリカ", "text": "前に色々話したから、\n今回はガブリエラちゃんの\nお話をするだけでもいい？"},
        { "location": "56/TALK"   , "narrator": "エリカ", "text": "前に色々話したから、\n今回はみやびちゃんの\nお話をするだけでもいい？"},
        { "location": "58/SEL"    , "narrator": "", "text": "はい"},
        { "location": "59/SEL"    , "narrator": "", "text": "いいえ"},
        { "location": "60/ACT"    , "narrator": "", "text": "はい"},
        { "location": "62/TALK"   , "narrator": "エリカ", "text": "うん、わかった。"},
        { "location": "64/ACT"    , "narrator": "", "text": "いいえ"},
        { "location": "66/TALK"   , "narrator": "エリカ", "text": "はーい。\nそれじゃ、少しだけ\n巻き戻しするね？"},
        { "location": "72/TALK"   , "narrator": "エリカ", "text": "こんにちは。"},
        { "location": "73/TALK"   , "narrator": "エリカ", "text": "今回も来てくれて\nありがとう。"},
        { "location": "74/TALK"   , "narrator": "エリカ", "text": "前回は色々助かったよ。"},
        { "location": "75/TALK"   , "narrator": "エリカ", "text": "わたし、長野に\n帰省できなかったでしょ？"},
        { "location": "76/TALK"   , "narrator": "エリカ", "text": "だから、どうしようか\nずっと悩んでたんだ。"},
        { "location": "77/TALK"   , "narrator": "エリカ", "text": "でも、あなたが凄く\n頑張ってくれているお陰で\n順調に物事が進んでる。"},
        { "location": "78/SEL"    , "narrator": "", "text": "よかった！"},
        { "location": "79/SEL"    , "narrator": "", "text": "その事なんだけど"},
        { "location": "80/ACT"    , "narrator": "", "text": "よかった！"},
        { "location": "81/TALK"   , "narrator": "エリカ", "text": "うん。"},
        { "location": "83/ACT"    , "narrator": "", "text": "その事なんだけど"},
        { "location": "84/TALK"   , "narrator": "エリカ", "text": "どうしたの？"},
        { "location": "85/SEL"    , "narrator": "", "text": "なんか釈然としない"},
        { "location": "86/ACT"    , "narrator": "", "text": "なんか釈然としない"},
        { "location": "89/TALK"   , "narrator": "エリカ", "text": "え！？"},
        { "location": "90/TALK"   , "narrator": "エリカ", "text": "えっと、わたし\n何かヘンなことしたかな。"},
        { "location": "91/SEL"    , "narrator": "", "text": "わからないことが多すぎて"},
        { "location": "92/ACT"    , "narrator": "", "text": "わからないことが多すぎて"},
        { "location": "95/TALK"   , "narrator": "エリカ", "text": "あー、なるほど。\nうーん…どうしようかな。"},
        { "location": "96/TALK"   , "narrator": "エリカ", "text": "実はその点については、\nわたしもちょっと\n気になってたんだよね。"},
        { "location": "97/TALK"   , "narrator": "エリカ", "text": "千羽鶴ちゃんがあなたに\nどこまで、どんな事を\n教えてきたのか。"},
        { "location": "98/TALK"   , "narrator": "エリカ", "text": "そして、綾ちゃんたちの\nどんな所を、デイドラで\n見せてきていたのか。"},
        { "location": "99/TALK"   , "narrator": "エリカ", "text": "色々と説明が足りていない\n所がありそうな気は\nするんだけど――"},
        { "location": "100/TALK"  , "narrator": "エリカ", "text": "だからといって、\n一から全部お話したら\n全然時間が足りないし。"},
        { "location": "101/TALK"  , "narrator": "エリカ", "text": "そんな話を延々続けたら、\nあなたも退屈しちゃうか\n回線切っちゃうでしょ？"},
        { "location": "102/TALK"  , "narrator": "エリカ", "text": "だから「この辺は多分、\n知らないかな～」って所を\n予想してお話してた。"},
        { "location": "103/TALK"  , "narrator": "エリカ", "text": "けど、それだと全然\n説明が不十分だってこと\nなら、ちゃんと説明する。"},
        { "location": "104/TALK"  , "narrator": "エリカ", "text": "ただ、それでも１から\n全部ってわけには\nいかないと思うから……"},
        { "location": "105/TALK"  , "narrator": "エリカ", "text": "うーん……\nどうしようかな…。"},
        { "location": "107/TALK"  , "narrator": "エリカ", "text": "……そうだ！"},
        { "location": "108/TALK"  , "narrator": "エリカ", "text": "それじゃ、\nこうしない？"},
        { "location": "109/TALK"  , "narrator": "エリカ", "text": "あなたがわからないこと、\nあなたの世界のSNSに\n書いてもらうの。"},
        { "location": "110/TALK"  , "narrator": "エリカ", "text": "<color=green>#トライナリーエリカへ\n質問</color>ってタグをつけて\nくれれば確認するから。"},
        { "location": "111/TALK"  , "narrator": "エリカ", "text": "それで、次にあなたが\nここに来たときに、その\nアンサーをお話するね。"},
        { "location": "112/TALK"  , "narrator": "エリカ", "text": "でも、わたしが知らない\nことや、まだお話できない\nこともあるから――"},
        { "location": "113/TALK"  , "narrator": "エリカ", "text": "そういうときは、\nごめんね。"},
        { "location": "114/TALK"  , "narrator": "エリカ", "text": "それでも、\nなるべくちゃんと\n答えるようにするからね。"},
        { "location": "116/SEL"   , "narrator": "", "text": "オーケー"},
        { "location": "117/SEL"   , "narrator": "", "text": "よくない！"},
        { "location": "118/ACT"   , "narrator": "", "text": "オーケー"},
        { "location": "120/TALK"  , "narrator": "エリカ", "text": "うん。"},
        { "location": "121/ACT"   , "narrator": "", "text": "よくない！"},
        { "location": "123/TALK"  , "narrator": "エリカ", "text": "ええっ！？\nよくないの？"},
        { "location": "124/TALK"  , "narrator": "エリカ", "text": "うーん、でも\nどうすればいいのかな。"},
        { "location": "125/TALK"  , "narrator": "エリカ", "text": "…まあいいや。\nそれもSNSに書き込んで\nもらえるかな？"},
        { "location": "126/TALK"  , "narrator": "エリカ", "text": "その方が\n手っ取り早いでしょ？"},
        { "location": "127/TALK"  , "narrator": "エリカ", "text": "よろしくお願いします。"},
        { "location": "131/TALK"  , "narrator": "エリカ", "text": "それじゃ早速、\n本題に移るね。"},
        { "location": "133/TALK"  , "narrator": "エリカ", "text": "前回、例のパッチを\nみやびちゃんに届けて\nくれてありがとう。"},
        { "location": "134/SEL"   , "narrator": "", "text": "どういたしまして"},
        { "location": "135/SEL"   , "narrator": "", "text": "あれ？　$me$は届けてないよ？"},
        { "location": "136/ACT"   , "narrator": "", "text": "どういたしまして"},
        { "location": "137/ACT"   , "narrator": "", "text": "あれ？　$me$は届けてないよ？"},
        { "location": "139/TALK"  , "narrator": "エリカ", "text": "え？\nそうなの？"},
        { "location": "141/TALK"  , "narrator": "エリカ", "text": "そっか、それじゃきっと\n他の可能性世界の人が\n届けてくれたのかもね。"},
        { "location": "142/SEL"   , "narrator": "", "text": "なるほど"},
        { "location": "143/SEL"   , "narrator": "", "text": "何それ？"},
        { "location": "144/ACT"   , "narrator": "", "text": "なるほど"},
        { "location": "145/ACT"   , "narrator": "", "text": "何それ？"},
        { "location": "148/TALK"  , "narrator": "エリカ", "text": "えっとね、多世界解釈と、\nパラメトリック理論に\n基づいた世界進行法？"},
        { "location": "149/TALK"  , "narrator": "エリカ", "text": "って、ちょっと難しいね。\nもう少し噛み砕いて\n説明するから。"},
        { "location": "150/TALK"  , "narrator": "エリカ", "text": "この世界は、あなたや、\nあなたのお友達が選んだ\n未来を正規分布にして――"},
        { "location": "151/TALK"  , "narrator": "エリカ", "text": "その最大値付近を選択して\n渡り歩くように\n創られてるんだ。"},
        { "location": "152/TALK"  , "narrator": "エリカ", "text": "だから、あなたが\nみやびちゃんにパッチを\n渡さなくても――"},
        { "location": "153/TALK"  , "narrator": "エリカ", "text": "他に２人の人が渡してたら\nこの世界の正史は、渡して\nくれた方へと進むの。"},
        { "location": "154/SEL"   , "narrator": "", "text": "えーっと、自然ってそういうものなの？？"},
        { "location": "155/SEL"   , "narrator": "", "text": "えーっと、エリカの世界は人工的に創られた世界なの？"},
        { "location": "156/ACT"   , "narrator": "", "text": "えーっと、自然ってそういうものなの？？"},
        { "location": "158/TALK"  , "narrator": "エリカ", "text": "んー？"},
        { "location": "159/TALK"  , "narrator": "エリカ", "text": "…んっと、\n自然っていうか……"},
        { "location": "162/TALK"  , "narrator": "エリカ", "text": "もちろん、量子世界に\nおける自然はそれに近い\n法則で動いてるけど――"},
        { "location": "163/TALK"  , "narrator": "エリカ", "text": "そもそもこの世界って\n自然とはちょっと違うし。"},
        { "location": "164/SEL"   , "narrator": "", "text": "はい！？"},
        { "location": "165/ACT"   , "narrator": "", "text": "はい！？"},
        { "location": "167/ACT"   , "narrator": "", "text": "えーっと、エリカの世界は人工的に創られた世界なの？"},
        { "location": "169/TALK"  , "narrator": "エリカ", "text": "んー？"},
        { "location": "171/TALK"  , "narrator": "エリカ", "text": "…んっと、\nそうだけど……。"},
        { "location": "173/TALK"  , "narrator": "エリカ", "text": "あれ？"},
        { "location": "174/TALK"  , "narrator": "エリカ", "text": "もしかして、それも\n千羽鶴ちゃんから教えて\nもらってないのかな？"},
        { "location": "175/SEL"   , "narrator": "", "text": "全然…"},
        { "location": "176/ACT"   , "narrator": "", "text": "全然…"},
        { "location": "179/TALK"  , "narrator": "エリカ", "text": "そうなんだ。"},
        { "location": "180/TALK"  , "narrator": "エリカ", "text": "うーん……"},
        { "location": "181/TALK"  , "narrator": "エリカ", "text": "……。"},
        { "location": "182/SEL"   , "narrator": "", "text": "ど、どうしたの！？"},
        { "location": "183/ACT"   , "narrator": "", "text": "ど、どうしたの！？"},
        { "location": "185/TALK"  , "narrator": "エリカ", "text": "ううん、なんでもないの。"},
        { "location": "186/TALK"  , "narrator": "エリカ", "text": "ちょっと状況を整理して\nいただけ。どこから説明\nすればいいのかなって。"},
        { "location": "187/TALK"  , "narrator": "エリカ", "text": "でも、上手くまとまらない\nから、もうちょっと\n時間もらってもいいかな？"},
        { "location": "188/SEL"   , "narrator": "", "text": "わかった"},
        { "location": "189/ACT"   , "narrator": "", "text": "わかった"},
        { "location": "193/TALK"  , "narrator": "エリカ", "text": "それでね、\n今回なんだけど。"},
        { "location": "194/TALK"  , "narrator": "エリカ", "text": "まずは記録映像を\n見てくれないかな。"},
        { "location": "195/TALK"  , "narrator": "エリカ", "text": "その映像がどう出るかで\n対処方法が変わるから。"},
        { "location": "196/SEL"   , "narrator": "", "text": "どう変わるの？"},
        { "location": "197/SEL"   , "narrator": "", "text": "そもそも記録映像って何なの？"},
        { "location": "198/ACT"   , "narrator": "", "text": "どう変わるの？"},
        { "location": "199/TALK"  , "narrator": "エリカ", "text": "未来がどう進行したか、\n確認したいことが\n２つあるの。"},
        { "location": "201/TALK"  , "narrator": "エリカ", "text": "１つめが、わたしが送った\n書類がどれくらい\n把握出来たか。"},
        { "location": "203/TALK"  , "narrator": "エリカ", "text": "２つめが、つばめちゃんは\n今どうしてるのか。"},
        { "location": "204/TALK"  , "narrator": "エリカ", "text": "１つめについては、\n多分、みやびちゃんの\n能力を考えれば大丈夫。"},
        { "location": "205/TALK"  , "narrator": "エリカ", "text": "２つめはちょっと心配。\n千羽鶴ちゃんがどう出るか\nわからないから。"},
        { "location": "206/TALK"  , "narrator": "エリカ", "text": "さすがに自分で\n壊したりはしないと\n思うけど……"},
        { "location": "207/TALK"  , "narrator": "エリカ", "text": "状況によってはかなり\nイレギュラーな対応を\nする必要が出るかも。"},
        { "location": "209/ACT"   , "narrator": "", "text": "そもそも記録映像って何なの？"},
        { "location": "210/TALK"  , "narrator": "エリカ", "text": "うーん…\nどう説明したらいいかな。"},
        { "location": "211/TALK"  , "narrator": "エリカ", "text": "多世界解釈と、パラメト\nリック理論に基づいた\n世界進行法の計算結果？"},
        { "location": "213/SEL"   , "narrator": "", "text": "それ、さっきも聞いた"},
        { "location": "214/ACT"   , "narrator": "", "text": "それ、さっきも聞いた"},
        { "location": "217/TALK"  , "narrator": "エリカ", "text": "あはは…そうだね。"},
        { "location": "218/TALK"  , "narrator": "エリカ", "text": "どういうものなのか、\n簡単に説明すると――"},
        { "location": "220/SEL"   , "narrator": "", "text": "なにその計算"},
        { "location": "221/ACT"   , "narrator": "", "text": "なにその計算"},
        { "location": "223/TALK"  , "narrator": "エリカ", "text": "えっとね。"},
        { "location": "225/TALK"  , "narrator": "エリカ", "text": "その時々の可能性から、\n最も選択されそうなものを\n選んだ結果訪れる未来。"},
        { "location": "226/TALK"  , "narrator": "エリカ", "text": "それを計算して、\nその結果を絵にしたものが\n記録映像なんだよ。"},
        { "location": "227/TALK"  , "narrator": "エリカ", "text": "あくまで計算結果だから、\n現実をカメラで撮影した\nものじゃないけど――"},
        { "location": "228/TALK"  , "narrator": "エリカ", "text": "もの凄く大きな介入を\nしない限りは、９割方\nその通りの未来が訪れる。"},
        { "location": "229/TALK"  , "narrator": "エリカ", "text": "簡単に言えば、\nデジタル水晶球\nみたいなものかな？"},
        { "location": "230/SEL"   , "narrator": "", "text": "記録映像って、千羽鶴が作っていたワケじゃないの？"},
        { "location": "231/ACT"   , "narrator": "", "text": "記録映像って、千羽鶴が作っていたワケじゃないの？"},
        { "location": "234/TALK"  , "narrator": "エリカ", "text": "物は言いようだけど、\nゼロから作ったものじゃ\nないかな。"},
        { "location": "236/TALK"  , "narrator": "エリカ", "text": "映像を確認して、望む\n世界と違ってたら新しい\n要素を入力――"},
        { "location": "237/TALK"  , "narrator": "エリカ", "text": "そして再度映像を作って\n確認して、違ってたらまた\n新しい要素を入力。"},
        { "location": "238/TALK"  , "narrator": "エリカ", "text": "そういうのを何度も\n繰り返して、彼女の\n望む未来を作ってた。"},
        { "location": "239/TALK"  , "narrator": "エリカ", "text": "そんな途方も無いトライ＆\nエラーの末、辿り着いた\n望む未来を確定して――"},
        { "location": "240/TALK"  , "narrator": "エリカ", "text": "今度はそれを、\n現実に投影する作業を\n実践する。"},
        { "location": "241/TALK"  , "narrator": "エリカ", "text": "具体的には、あなたに\n段取りを教えて、動いて\nもらっていたはず。"},
        { "location": "242/TALK"  , "narrator": "エリカ", "text": "そしてあなたがそれを\nそつなくこなせば、それが\n現実になるというわけ。"},
        { "location": "244/TALK"  , "narrator": "エリカ", "text": "ただ、それをやるには\n莫大な時間がかかるの。"},
        { "location": "245/TALK"  , "narrator": "エリカ", "text": "１つのことを変えるだけで\n世界はガラッと変わるし、\n人の行動も変わるから。"},
        { "location": "246/TALK"  , "narrator": "エリカ", "text": "バタフライ\nエフェクトだね。"},
        { "location": "247/TALK"  , "narrator": "エリカ", "text": "だから、わたしみたいな\n普通の人では、到底自分が\n作りたい世界は作れない。"},
        { "location": "248/TALK"  , "narrator": "エリカ", "text": "千羽鶴ちゃんが\nそれを辛うじて\n為し得てたのは例外なの。"},
        { "location": "249/TALK"  , "narrator": "エリカ", "text": "ココロスフィアから\n綾ちゃんたちの行動を\nコントロールしつつ――"},
        { "location": "250/TALK"  , "narrator": "エリカ", "text": "世界全体の動向も、\n状況に応じて軌道修正\nする必要があって。"},
        { "location": "251/TALK"  , "narrator": "エリカ", "text": "ご存知の通り、彼女は\nこの世界において、その\n両方を実践する力がある。"},
        { "location": "252/TALK"  , "narrator": "エリカ", "text": "逆にわたしは\n千羽鶴ちゃんと違って、\n未来を操作できない。"},
        { "location": "253/TALK"  , "narrator": "エリカ", "text": "だから、今の状況から\n計算した記録映像を見て、\n次に向けて対処するだけ。"},
        { "location": "254/SEL"   , "narrator": "", "text": "なるほど理解した"},
        { "location": "255/SEL"   , "narrator": "", "text": "難しくてよくわからない"},
        { "location": "256/ACT"   , "narrator": "", "text": "なるほど理解した"},
        { "location": "258/TALK"  , "narrator": "エリカ", "text": "よかった。"},
        { "location": "259/TALK"  , "narrator": "エリカ", "text": "わたし、説明が\n下手くそだから、\nそこが心配で。"},
        { "location": "260/ACT"   , "narrator": "", "text": "難しくてよくわからない"},
        { "location": "262/TALK"  , "narrator": "エリカ", "text": "やっぱり…。\nごめんね、\n説明が下手くそで。"},
        { "location": "263/TALK"  , "narrator": "エリカ", "text": "すっごく簡単に言うと――"},
        { "location": "264/TALK"  , "narrator": "エリカ", "text": "千羽鶴ちゃんは、\n映像と同じ現実を作る\n能力がある。"},
        { "location": "265/TALK"  , "narrator": "エリカ", "text": "わたしにはその能力が\n無いから、映像を見て\n次の対策を講じてる。"},
        { "location": "267/TALK"  , "narrator": "エリカ", "text": "そんな感じかな。"},
        { "location": "269/TALK"  , "narrator": "エリカ", "text": "あと、記録映像自体は、\n千羽鶴ちゃんがゼロから\n作ったものじゃない。"},
        { "location": "270/TALK"  , "narrator": "エリカ", "text": "レディネスが今の世界から\n計算して作り出した\n未来予想図なの。"},
        { "location": "271/TALK"  , "narrator": "エリカ", "text": "これくらいしか、\nわかりやすく説明する\n言い方が見つからないや。"},
        { "location": "272/TALK"  , "narrator": "エリカ", "text": "もしまだ解らなかったら、\n周りのお友達と相談して\nみてね。"},
        { "location": "275/TALK"  , "narrator": "エリカ", "text": "というわけで、\n記録映像を流しても\nいいかな？"},
        { "location": "277/SEL"   , "narrator": "", "text": "いいよ"},
        { "location": "278/SEL"   , "narrator": "", "text": "いや待ちたまえエリカ君"},
        { "location": "279/ACT"   , "narrator": "", "text": "いいよ"},
        { "location": "281/TALK"  , "narrator": "エリカ", "text": "ありがとう。\nそれじゃ、どれにする？"},
        { "location": "282/ACT"   , "narrator": "", "text": "いや待ちたまえエリカ君"},
        { "location": "283/TALK"  , "narrator": "エリカ", "text": "え！？\nどうしたの？"},
        { "location": "284/SEL"   , "narrator": "", "text": "前回、パーツ屋デートするって言ってたの忘れたのかね！？"},
        { "location": "285/ACT"   , "narrator": "", "text": "前回、パーツ屋デートするって言ってたの忘れたのかね！？"},
        { "location": "288/TALK"  , "narrator": "エリカ", "text": "えー！\n覚えてるよ、もちろん。"},
        { "location": "289/TALK"  , "narrator": "エリカ", "text": "先にお話しなくちゃ\nいけないことが色々あって\n言えてなかっただけで。"},
        { "location": "290/TALK"  , "narrator": "エリカ", "text": "本題が終わったら\nゆっくり行こうと\n思ってたんだけど……。"},
        { "location": "291/SEL"   , "narrator": "", "text": "じゃあそれで！"},
        { "location": "292/ACT"   , "narrator": "", "text": "じゃあそれで！"},
        { "location": "295/TALK"  , "narrator": "エリカ", "text": "うん。\nわかったよ。"},
        { "location": "296/TALK"  , "narrator": "エリカ", "text": "それじゃ、\nまずは記録映像を見てね？"},
        { "location": "299/SEL"   , "narrator": "", "text": "いいよ"},
        { "location": "300/ACT"   , "narrator": "", "text": "いいよ"},
        { "location": "302/TALK"  , "narrator": "エリカ", "text": "ありがとう。\nそれじゃ、どれにする？"},
        { "location": "306/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/71MB 4:33】</color>"},
        { "location": "307/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/23MB 4:33】</color>"},
        { "location": "308/SEL"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "309/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/71MB 4:33】</color>"},
        { "location": "310/TALK"  , "narrator": "エリカ", "text": "はーい。"},
        { "location": "316/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/23MB 4:33】</color>"},
        { "location": "317/TALK"  , "narrator": "エリカ", "text": "はーい。"},
        { "location": "323/ACT"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "324/TALK"  , "narrator": "エリカ", "text": "あらら。"},
        { "location": "357/TALK"  , "narrator": "エリカ", "text": "やっぱりつばめちゃん\n捕まっちゃってたね。"},
        { "location": "359/TALK"  , "narrator": "エリカ", "text": "さて、どうしようかなぁ。"},
        { "location": "360/SEL"   , "narrator": "", "text": "そんなことより、聖女つばめから抽出されたクランによるフェノメノンて…！？"},
        { "location": "361/ACT"   , "narrator": "", "text": "そんなことより、聖女つばめから抽出されたクランによるフェノメノンて…！？"},
        { "location": "363/TALK"  , "narrator": "エリカ", "text": "え？"},
        { "location": "364/TALK"  , "narrator": "エリカ", "text": "えっと、\nちょっと待ってね？"},
        { "location": "365/TALK"  , "narrator": "エリカ", "text": "もしかしてそれ、\n千羽鶴ちゃんから\n聞かされてなかった？"},
        { "location": "366/SEL"   , "narrator": "", "text": "はい"},
        { "location": "367/ACT"   , "narrator": "", "text": "はい"},
        { "location": "370/TALK"  , "narrator": "エリカ", "text": "そっかー。\nそれで話があまり\n噛み合わなかったんだね。"},
        { "location": "371/TALK"  , "narrator": "エリカ", "text": "それじゃ、私から\n説明するよ。"},
        { "location": "372/TALK"  , "narrator": "エリカ", "text": "ちょっと難しい話だけど\n大事なことだから、\nちゃんと聞いてね？"},
        { "location": "375/TALK"  , "narrator": "エリカ", "text": "今、あなたが見ているこの\n世界は、つばめちゃんの\nフェノメノンなんだよ。"},
        { "location": "376/TALK"  , "narrator": "エリカ", "text": "色々なフェノメノンを\n見てきたからわかるかと\n思うけど――"},
        { "location": "377/TALK"  , "narrator": "エリカ", "text": "フェノメノンは\n世界を簡単に\n変える力を持っている。"},
        { "location": "379/TALK"  , "narrator": "エリカ", "text": "２０３１年、東京は\n第三次世界大戦によって\n荒廃した。"},
        { "location": "380/TALK"  , "narrator": "エリカ", "text": "そして、その日本を\n復興するために試みたのが\nフェノメノンの行使。"},
        { "location": "381/TALK"  , "narrator": "エリカ", "text": "国連の後継に当たる\n統一国家と国際企業により\n実施された計画――"},
        { "location": "382/TALK"  , "narrator": "エリカ", "text": "フェノム計画によって\n日本は２０１６年の世界を\n忠実に模写し復活したの。"},
        { "location": "385/SEL"   , "narrator": "", "text": "どうして２０１６年なの？"},
        { "location": "386/SEL"   , "narrator": "", "text": "どうしてつばめなの？"},
        { "location": "387/SEL"   , "narrator": "", "text": "第三次世界大戦って一体…"},
        { "location": "388/SEL"   , "narrator": "", "text": "ビデオの映像、ACT1Episode1の時と似てるけど違う！？"},
        { "location": "389/SEL"   , "narrator": "", "text": "他にも色々聞きたいことがある \n<color=blue>（※先へ進みます）</color>"},
        { "location": "390/ACT"   , "narrator": "", "text": "どうして２０１６年なの？"},
        { "location": "391/TALK"  , "narrator": "エリカ", "text": "それは、あなたたちの\n存在が関係してるの。"},
        { "location": "394/TALK"  , "narrator": "エリカ", "text": "つばめちゃんが作った\n世界、フェノメノンなのに\nとても精巧でしょ？"},
        { "location": "396/TALK"  , "narrator": "エリカ", "text": "逆に、あなたが見てきた\nフェノメノンはどれも\nかなり大味だったはず。"},
        { "location": "397/TALK"  , "narrator": "エリカ", "text": "フェノメノンは、その人が\n想い描く妄想の具現化な\nわけだけど――"},
        { "location": "398/TALK"  , "narrator": "エリカ", "text": "人の妄想なんて、得てして\n曖昧で偏見に満ちてる\nものなの。"},
        { "location": "399/TALK"  , "narrator": "エリカ", "text": "だから、一人の人が作れる\n世界なんて、普通のフェノ\nメノンが関の山。"},
        { "location": "400/TALK"  , "narrator": "エリカ", "text": "つばめちゃんであっても\nそれは全く同じ。"},
        { "location": "402/TALK"  , "narrator": "エリカ", "text": "なら、どうすれば、\n均一できめ細かくて、\nリアルな世界が作れるか。"},
        { "location": "403/TALK"  , "narrator": "エリカ", "text": "数千、数万の目と記憶が\n作り出す平均的な像が\nあれば、擬似的に作れる。"},
        { "location": "404/TALK"  , "narrator": "エリカ", "text": "わかりやすく言えば、\nあなた“たち”一人一人が\n見ているあなたの現実――"},
        { "location": "405/TALK"  , "narrator": "エリカ", "text": "それを合成して均一化して\n１つの世界に出力した\nものが、この世界なの。"},
        { "location": "406/TALK"  , "narrator": "エリカ", "text": "普通の発症者は自分の\n妄想を具現化してるけど、\nつばめちゃんは違う。"},
        { "location": "407/TALK"  , "narrator": "エリカ", "text": "あなたたちが見てきた\n２０１６年の世界を束ねた\nものを具現化してる。"},
        { "location": "408/TALK"  , "narrator": "エリカ", "text": "TRI-OSを介して送られて\nくる、あなたの想い。"},
        { "location": "409/TALK"  , "narrator": "エリカ", "text": "数万の人たちから送られて\nくるその想いと記憶を\n束ねた物がこの世界なの。"},
        { "location": "410/SEL"   , "narrator": "", "text": "どうやってんの？\nそんなこと！"},
        { "location": "411/SEL"   , "narrator": "", "text": "でも、今は２０１７年なんですが"},
        { "location": "412/ACT"   , "narrator": "", "text": "どうやってんの？\nそんなこと！"},
        { "location": "414/TALK"  , "narrator": "エリカ", "text": "えっとね、"},
        { "location": "415/TALK"  , "narrator": "エリカ", "text": "それを可能にしているのが\nさっきお話しした理論――"},
        { "location": "417/TALK"  , "narrator": "エリカ", "text": "多世界解釈と\nパラメトリック理論に\n基づいた世界進行法。"},
        { "location": "418/TALK"  , "narrator": "エリカ", "text": "長くなるから、この理論の\n説明は今回は割愛するよ。"},
        { "location": "419/ACT"   , "narrator": "", "text": "でも、今は２０１７年なんですが"},
        { "location": "420/TALK"  , "narrator": "エリカ", "text": "そうだね。\nあなたの世界が２０１７年\nなのは知ってる。"},
        { "location": "421/TALK"  , "narrator": "エリカ", "text": "その理由は、\nこう考えると\nしっくりくるかな？"},
        { "location": "422/TALK"  , "narrator": "エリカ", "text": "あなたの世界で明日、\n東京やあなたの街が、突如\n瓦礫と化すかもしれない。"},
        { "location": "423/SEL"   , "narrator": "", "text": "またそんな…"},
        { "location": "424/ACT"   , "narrator": "", "text": "またそんな…"},
        { "location": "426/TALK"  , "narrator": "エリカ", "text": "断言できるかな。"},
        { "location": "427/TALK"  , "narrator": "エリカ", "text": "明日隣国からミサイルが\n飛んでくることなんて\n１００％あり得ないって。"},
        { "location": "428/TALK"  , "narrator": "エリカ", "text": "明日突然大地震が起きて、\n首都が壊滅することなんて\n絶対あり得ないって。"},
        { "location": "430/TALK"  , "narrator": "エリカ", "text": "そんなの、誰にも\nわからないよね？"},
        { "location": "432/TALK"  , "narrator": "エリカ", "text": "２０１７年を\n投影するということは、\nそういうことなの。"},
        { "location": "433/TALK"  , "narrator": "エリカ", "text": "２０１６年を投影すれば、\n少なくともあと１年は\n平和が保証されてる。"},
        { "location": "434/TALK"  , "narrator": "エリカ", "text": "今、あなたが平和に\n暮らせていることが\n確認できているから。"},
        { "location": "435/TALK"  , "narrator": "エリカ", "text": "それは、１年後までの\n未来を見通せる、疑似的な\nアカシックレコード。"},
        { "location": "436/TALK"  , "narrator": "エリカ", "text": "わたしたちの世界の\n２０３１年には少なくとも\nその技術は確立されてる。"},
        { "location": "437/TALK"  , "narrator": "エリカ", "text": "今、説明できるのは\nこれくらいかな。"},
        { "location": "441/TALK"  , "narrator": "エリカ", "text": "他にも\n何かあれば聞いて？"},
        { "location": "443/ACT"   , "narrator": "", "text": "どうしてつばめなの？"},
        { "location": "444/TALK"  , "narrator": "エリカ", "text": "つばめちゃんには、\n生まれつき特別な能力が\nあったの。"},
        { "location": "445/TALK"  , "narrator": "エリカ", "text": "それは簡単に言えば、\n日本全土をフェノメノンで\n覆うことが出来る力。"},
        { "location": "446/SEL"   , "narrator": "", "text": "日本全土ってメチャクチャ大きなフェノメノンじゃない？"},
        { "location": "447/ACT"   , "narrator": "", "text": "日本全土ってメチャクチャ大きなフェノメノンじゃない？"},
        { "location": "449/TALK"  , "narrator": "エリカ", "text": "そうだね。"},
        { "location": "452/TALK"  , "narrator": "エリカ", "text": "詳しいことは追々\n話すことにするから、\n今回はこれでいいかな。"},
        { "location": "453/TALK"  , "narrator": "エリカ", "text": "他にも\n何かあれば聞いて？"},
        { "location": "455/ACT"   , "narrator": "", "text": "第三次世界大戦って一体…"},
        { "location": "458/TALK"  , "narrator": "エリカ", "text": "それを話すには、\nわたしたちの世界の状況を\n話さないといけない。"},
        { "location": "459/TALK"  , "narrator": "エリカ", "text": "それだけで１回分の\n物量はありそうだから、\n簡単に説明すると――"},
        { "location": "460/TALK"  , "narrator": "エリカ", "text": "日本が国連の推進する\n統一国家への帰属を拒否\nしたのが発端。"},
        { "location": "461/TALK"  , "narrator": "エリカ", "text": "ただ、そこには世界統一\n宗教や多国籍企業の思惑も\n絡んできていて――"},
        { "location": "462/TALK"  , "narrator": "エリカ", "text": "簡単には全部説明する\nことはできないの。"},
        { "location": "465/TALK"  , "narrator": "エリカ", "text": "とにかく、\n日本はまた敗戦した。"},
        { "location": "466/TALK"  , "narrator": "エリカ", "text": "そして前の時と同じく、\n統一国家政府による\n“救済活動”が始まった。"},
        { "location": "467/TALK"  , "narrator": "エリカ", "text": "それこそが、この\nフェノム計画なの。"},
        { "location": "468/SEL"   , "narrator": "", "text": "映像を見る限りだとエリカやアーヤたちも関わってるみたいだけど"},
        { "location": "469/ACT"   , "narrator": "", "text": "映像を見る限りだとエリカやアーヤたちも関わってるみたいだけど"},
        { "location": "471/TALK"  , "narrator": "エリカ", "text": "わたしは、いち研究者と\nして関わっていただけ。"},
        { "location": "472/TALK"  , "narrator": "エリカ", "text": "輝ける未来を創り出す、\nこの世界規模の計画に。"},
        { "location": "473/TALK"  , "narrator": "エリカ", "text": "それはシンギュラリティの\n発端になるとまで\n言われ、注目された。"},
        { "location": "474/TALK"  , "narrator": "エリカ", "text": "けど、今ではこの計画は、\n２０世紀の悪夢と言われた\nあの計画と同じだと思う。"},
        { "location": "475/SEL"   , "narrator": "", "text": "それって、マンハッ…"},
        { "location": "476/ACT"   , "narrator": "", "text": "それって、マンハッ…"},
        { "location": "478/TALK"  , "narrator": "エリカ", "text": "多分それで\nあってるよ。"},
        { "location": "479/TALK"  , "narrator": "エリカ", "text": "他にも\n何かあれば聞いて？"},
        { "location": "481/ACT"   , "narrator": "", "text": "ビデオの映像、ACT1Episode1の時と似てるけど違う！？"},
        { "location": "483/TALK"  , "narrator": "エリカ", "text": "どんな風に？"},
        { "location": "484/SEL"   , "narrator": "", "text": "前に見たのは、アーヤっぽい人が一人だけで、似たような事を喋ってた"},
        { "location": "485/ACT"   , "narrator": "", "text": "前に見たのは、アーヤっぽい人が一人だけで、似たような事を喋ってた"},
        { "location": "488/TALK"  , "narrator": "エリカ", "text": "ああ、あの映像ね。"},
        { "location": "491/TALK"  , "narrator": "エリカ", "text": "今のわたしには\n確実な理由は\nわからないけど――"},
        { "location": "492/TALK"  , "narrator": "エリカ", "text": "多分、あなたが介入した\nことで、世界線がかなり\n変わってるんだと思う。"},
        { "location": "493/TALK"  , "narrator": "エリカ", "text": "それが一番、\n理にかなってるかな。"},
        { "location": "494/TALK"  , "narrator": "エリカ", "text": "世界線がかわったことが\nいい事か悪い事かは\nわからないけど。"},
        { "location": "495/TALK"  , "narrator": "エリカ", "text": "でも、確実に\n変わってるのは\n間違いないから。"},
        { "location": "496/TALK"  , "narrator": "エリカ", "text": "あまりクリアな\n回答ができなくて\nごめんね？"},
        { "location": "499/TALK"  , "narrator": "エリカ", "text": "他にも\n何かあれば聞いて？"},
        { "location": "501/ACT"   , "narrator": "", "text": "他にも色々聞きたいことがある \n<color=blue>（※先へ進みます）</color>"},
        { "location": "503/TALK"  , "narrator": "エリカ", "text": "気持ちはわかるよ。"},
        { "location": "504/TALK"  , "narrator": "エリカ", "text": "でも、あなたがこの世界を\nフェノメノンだったと\n知らなかった以上――"},
        { "location": "505/TALK"  , "narrator": "エリカ", "text": "今回だけで、\nその全てを説明するのは\n無理だと思う。"},
        { "location": "506/TALK"  , "narrator": "エリカ", "text": "だから、これから少しずつ\n無理の無いペースで\n教えていくから。"},
        { "location": "507/TALK"  , "narrator": "エリカ", "text": "残りは次回また\nお話するから、\nそれで許してね？"},
        { "location": "508/TALK"  , "narrator": "エリカ", "text": "さて。"},
        { "location": "513/TALK"  , "narrator": "エリカ", "text": "今回のつばめちゃんに\nついてだけど。"},
        { "location": "514/TALK"  , "narrator": "エリカ", "text": "まずは、捕まってる場所や\n何かされる事が決まって\nいたら教えてもらって？"},
        { "location": "515/TALK"  , "narrator": "エリカ", "text": "今はまだ、どうしたら\nいいかわからないから、\n現状を把握したいの。"},
        { "location": "516/TALK"  , "narrator": "エリカ", "text": "あと、きっとかなり\n精神的に不安定だと思う\nから、元気づけてあげて？"},
        { "location": "517/TALK"  , "narrator": "エリカ", "text": "今回は、\nそれに徹してもらうしか\nないかも。"},
        { "location": "518/TALK"  , "narrator": "エリカ", "text": "もどかしいかも\nしれないけど、ごめんね。"},
        { "location": "522/TALK"  , "narrator": "エリカ", "text": "今回の綾ちゃんに\nついてだけど。"},
        { "location": "523/TALK"  , "narrator": "エリカ", "text": "もしかすると、今回あたり\nみやびちゃんがデータの\n確認終わるかもしれない。"},
        { "location": "534/TALK"  , "narrator": "エリカ", "text": "今回のガブリエラちゃん\nについてなんだけど。"},
        { "location": "535/TALK"  , "narrator": "エリカ", "text": "前回と同じで、綾ちゃんの\n心の支えになってあげて\nもらいたいの。"},
        { "location": "536/TALK"  , "narrator": "エリカ", "text": "それ自体がガブリエラ\nちゃんをも元気にする\n事になると思うし――"},
        { "location": "537/TALK"  , "narrator": "エリカ", "text": "綾ちゃん、ああ見えて\n自分の家とか長野のこと\n結構好きだから。"},
        { "location": "538/TALK"  , "narrator": "エリカ", "text": "色々聞いてもらえたら\nいい気晴らしになると\n思うんだよね。"},
        { "location": "539/TALK"  , "narrator": "エリカ", "text": "ガブリエラちゃんも\n綾ちゃんのうちの事とか\n知れて嬉しいと思うし。"},
        { "location": "540/TALK"  , "narrator": "エリカ", "text": "色々不安もある中で\n二人とも精神的に結構\n滅入ってると思うから。"},
        { "location": "541/TALK"  , "narrator": "エリカ", "text": "上手くリラックスできる\nような話題が見つかると\nいいなって思ってるよ。"},
        { "location": "545/TALK"  , "narrator": "エリカ", "text": "今回のみやびちゃんに\nついてなんだけど。"},
        { "location": "546/TALK"  , "narrator": "エリカ", "text": "実は１つ彼女に\n謝らなくちゃいけない\nことがあって……。"},
        { "location": "547/TALK"  , "narrator": "エリカ", "text": "それをメッセージ\nファイルにしてあるから、\n渡してあげて欲しいの。"},
        { "location": "550/SEL"   , "narrator": "", "text": "どんな内容？"},
        { "location": "551/ACT"   , "narrator": "", "text": "どんな内容？"},
        { "location": "553/TALK"  , "narrator": "エリカ", "text": "うーんと、\nそれは渡したときの\nお楽しみ、かな？"},
        { "location": "555/TALK"  , "narrator": "エリカ", "text": "別に全然大したことじゃ\nないんだけどね。"},
        { "location": "556/TALK"  , "narrator": "エリカ", "text": "ただ、自分で言うのは\nちょっと恥ずかしいかも。"},
        { "location": "562/TALK"  , "narrator": "エリカ", "text": "あと、今回も\n東京側の動向を少しだけ\n追加しておいたよ。"},
        { "location": "563/TALK"  , "narrator": "エリカ", "text": "前回同様、\nサポートしてあげて\nもらえたら嬉しいかな。"},
        { "location": "568/TALK"  , "narrator": "エリカ", "text": "あ、それと、あなたに\nひとつ謝らなくちゃ\nいけないことが……。"},
        { "location": "569/SEL"   , "narrator": "", "text": "どうしたの？"},
        { "location": "570/ACT"   , "narrator": "", "text": "どうしたの？"},
        { "location": "572/TALK"  , "narrator": "エリカ", "text": "あのね、前回約束した\nパーツ屋さんにデート\nしにいく件だけど……。"},
        { "location": "573/TALK"  , "narrator": "エリカ", "text": "今回ちょっと難しくて。\n次回にしてもいいかな…？"},
        { "location": "574/SEL"   , "narrator": "", "text": "えー"},
        { "location": "575/SEL"   , "narrator": "", "text": "いいよ、大変だものね"},
        { "location": "576/ACT"   , "narrator": "", "text": "えー"},
        { "location": "577/TALK"  , "narrator": "エリカ", "text": "ホントごめんね！\nわたしもとっても\n残念なんだけど――"},
        { "location": "578/TALK"  , "narrator": "エリカ", "text": "つばめちゃんを助ける\nために、２回くらいは\n記録映像回したくて……。"},
        { "location": "579/TALK"  , "narrator": "エリカ", "text": "次回は必ず、\nデートするから。ね？？"},
        { "location": "580/SEL"   , "narrator": "", "text": "わかったよ"},
        { "location": "581/SEL"   , "narrator": "", "text": "アーヤの気持ちがよくわかったよ"},
        { "location": "582/ACT"   , "narrator": "", "text": "わかったよ"},
        { "location": "584/TALK"  , "narrator": "エリカ", "text": "えへへ、ありがと。"},
        { "location": "585/TALK"  , "narrator": "エリカ", "text": "どこのお店を回るか\nプラン立てておくからね？"},
        { "location": "586/ACT"   , "narrator": "", "text": "アーヤの気持ちがよくわかったよ"},
        { "location": "588/TALK"  , "narrator": "エリカ", "text": "あはは……\nそうだよね。"},
        { "location": "589/TALK"  , "narrator": "エリカ", "text": "こんな事ばっかりじゃ\n姉として失格だよね。"},
        { "location": "590/TALK"  , "narrator": "エリカ", "text": "あなたに対しても…\n本当にごめんなさい。"},
        { "location": "591/TALK"  , "narrator": "エリカ", "text": "でも、次は本当に\n必ず行くから、ね？"},
        { "location": "593/ACT"   , "narrator": "", "text": "いいよ、大変だものね"},
        { "location": "596/TALK"  , "narrator": "エリカ", "text": "えへへ、ありがとう！\nあなたって\n優しいんだね。"},
        { "location": "597/TALK"  , "narrator": "エリカ", "text": "次回は必ず、\nデートするからね？"},
        { "location": "598/TALK"  , "narrator": "エリカ", "text": "どこのお店を回るか\nプラン立てておこっと！"},
        { "location": "602/TALK"  , "narrator": "エリカ", "text": "それじゃ、\n今回もよろしく\nお願いします！"},
