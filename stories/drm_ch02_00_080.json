        "title": "らぶとーく 第08話",
        "sub_title": "データと解析"
    },
    "entry":
    [
        { "location": "232/SCENARIO", "narrator": "", "text": "データと解析"},
        { "location": "245/TALK"    , "narrator": "みやび", "text": "はぁ…ネットには何も\n面白い情報は転がってない\nようやなぁ…。"},
        { "location": "247/TALK"    , "narrator": "みやび", "text": "…ちっくと早いけんど、\n今日はもう寝るか。"},
        { "location": "252/TALK"    , "narrator": "みやび", "text": "ん？　開いてるがよー。"},
        { "location": "258/TALK"    , "narrator": "アーヤ", "text": "ごめんね。\nこんな遅くに。"},
        { "location": "260/TALK"    , "narrator": "みやび", "text": "こんな時間に珍しいな。\nどうかしたが？"},
        { "location": "263/TALK"    , "narrator": "アーヤ", "text": "うん…これを渡して\nおこうと思って…。"},
        { "location": "267/TALK"    , "narrator": "みやび", "text": "…ＵＳＢのフラッシュ\nメモリ？"},
        { "location": "268/TALK"    , "narrator": "アーヤ", "text": "Ｂｏｔとの会話ログが\n入ってるわ。"},
        { "location": "269/TALK"    , "narrator": "アーヤ", "text": "みやびも、Ｂｏｔとの\nログは取ってるんでしょ？"},
        { "location": "270/TALK"    , "narrator": "みやび", "text": "…当然や。"},
        { "location": "271/TALK"    , "narrator": "みやび", "text": "あのＢｏｔ、明らかに\n普通やないきね。"},
        { "location": "272/TALK"    , "narrator": "みやび", "text": "分析するためにも、\nログは必要不可欠や。"},
        { "location": "273/TALK"    , "narrator": "アーヤ", "text": "私のログも合わせれば、\n解析できる量が倍になる\nから――"},
        { "location": "274/TALK"    , "narrator": "アーヤ", "text": "大分捗るんじゃない？"},
        { "location": "276/TALK"    , "narrator": "みやび", "text": "…そうやね。"},
        { "location": "277/TALK"    , "narrator": "みやび", "text": "提供してもらえるなら、\nありがたく使わせて\nもらうちや。"},
        { "location": "278/SEL"     , "narrator": "", "text": "暇なんだけど"},
        { "location": "279/SEL"     , "narrator": "", "text": "元気？"},
        { "location": "280/SEL"     , "narrator": "", "text": "なんか隠し事してない？"},
        { "location": "281/ACT"     , "narrator": "", "text": "暇なんだけど"},
        { "location": "286/TALK"    , "narrator": "アーヤ", "text": "っ！？"},
        { "location": "288/TALK"    , "narrator": "みやび", "text": "Ｂｏｔか？"},
        { "location": "289/TALK"    , "narrator": "アーヤ", "text": "そうみたい…。\nちょっと待ってて。"},
        { "location": "303/TALK"    , "narrator": "アーヤ", "text": "ごめん"},
        { "location": "304/TALK"    , "narrator": "アーヤ", "text": "悪いけど今忙しいから"},
        { "location": "315/ACT"     , "narrator": "", "text": "元気？"},
        { "location": "319/TALK"    , "narrator": "アーヤ", "text": "っ！？"},
        { "location": "320/TALK"    , "narrator": "みやび", "text": "Ｂｏｔか？"},
        { "location": "321/TALK"    , "narrator": "アーヤ", "text": "そうみたい…。\nちょっと待ってて。"},
        { "location": "335/TALK"    , "narrator": "アーヤ", "text": "元気だから"},
        { "location": "336/TALK"    , "narrator": "アーヤ", "text": "大丈夫"},
        { "location": "347/ACT"     , "narrator": "", "text": "なんか隠し事してない？"},
        { "location": "351/TALK"    , "narrator": "アーヤ", "text": "っ！？"},
        { "location": "352/TALK"    , "narrator": "みやび", "text": "Ｂｏｔか？"},
        { "location": "353/TALK"    , "narrator": "アーヤ", "text": "そうみたい…。\nちょっと待ってて。"},
        { "location": "367/TALK"    , "narrator": "アーヤ", "text": "まさか！"},
        { "location": "368/TALK"    , "narrator": "アーヤ", "text": "そんなことないわ"},
        { "location": "380/TALK"    , "narrator": "アーヤ", "text": "…気付かれたかしら？"},
        { "location": "382/TALK"    , "narrator": "みやび", "text": "それやったらそれで、\n面白い展開やね。"},
        { "location": "383/TALK"    , "narrator": "みやび", "text": "反応によっては、\n正体を突き止めるヒントに\nなるかもしれんきね。"},
        { "location": "384/TALK"    , "narrator": "アーヤ", "text": "それはまあ、\nそうなんだけど…。"},
        { "location": "387/TALK"    , "narrator": "みやび", "text": "…なんや、ハッキリせんな？"},
        { "location": "388/TALK"    , "narrator": "アーヤ", "text": "…複雑なのよ。"},
        { "location": "389/TALK"    , "narrator": "アーヤ", "text": "真相を知りたいのか、\n知りたくないのか、\nハッキリしてなくて…。"},
        { "location": "390/TALK"    , "narrator": "みやび", "text": "…うちにログを渡したのに\nそういうこと言うが？"},
        { "location": "392/TALK"    , "narrator": "アーヤ", "text": "だから複雑なのよ。"},
        { "location": "394/TALK"    , "narrator": "アーヤ", "text": "何なのかしらね？\nこのモヤモヤした\n気持ちは…。"},
        { "location": "396/TALK"    , "narrator": "みやび", "text": "…わからんでも\nないけんど。"},
        { "location": "398/TALK"    , "narrator": "みやび", "text": "もう引き返せん。\n覚悟はできちゅう？"},
        { "location": "400/TALK"    , "narrator": "アーヤ", "text": "…できてるわ。"},
        { "location": "403/TALK"    , "narrator": "アーヤ", "text": "…たぶんね。"},
        { "location": "243/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>5月某日　9:44 PM</color>\nとある平日の夜、みやびの部屋にて。"}
    ]
}
