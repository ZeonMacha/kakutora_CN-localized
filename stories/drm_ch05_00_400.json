    "entry":
    [
        { "location": "1624/SCENARIO", "narrator": "", "text": "神の采配と民草の希望"},
        { "location": "1651/TALK"    , "narrator": "神楽", "text": "私は神々のチェスに参加することになった"},
        { "location": "1652/TALK"    , "narrator": "神楽", "text": "プレイヤーとして"},
        { "location": "1653/TALK"    , "narrator": "神楽", "text": "開始にあたって受けたアドバイスはふたつ"},
        { "location": "1654/TALK"    , "narrator": "神楽", "text": "序盤は本のごとく、中盤は奇術師のごとく、終盤は機械のごとく指せ"},
        { "location": "1655/TALK"    , "narrator": "神楽", "text": "よい手を見つけたと思ったら、もっとよい手を考えろ"},
        { "location": "1657/SEL"     , "narrator": "", "text": "なんかかっこいい！"},
        { "location": "1658/SEL"     , "narrator": "", "text": "何の比喩かな？"},
        { "location": "1659/SEL"     , "narrator": "", "text": "$me$にも手ほどきしてよ"},
        { "location": "1660/ACT"     , "narrator": "", "text": "なんかかっこいい！"},
        { "location": "1661/TALK"    , "narrator": "神楽", "text": "でしょでしょでしょでしょ～～～♪"},
        { "location": "1663/TALK"    , "narrator": "神楽", "text": "いやそんな場合じゃない"},
        { "location": "1664/ACT"     , "narrator": "", "text": "何の比喩かな？"},
        { "location": "1665/TALK"    , "narrator": "神楽", "text": "暗喩であり直喩"},
        { "location": "1666/ACT"     , "narrator": "", "text": "$me$にも手ほどきしてよ"},
        { "location": "1667/TALK"    , "narrator": "神楽", "text": "どうしよっかな～？"},
        { "location": "1668/TALK"    , "narrator": "神楽", "text": "やっぱやめとく～"},
        { "location": "1670/TALK"    , "narrator": "神楽", "text": "神々のチェスの駒は人間"},
        { "location": "1671/TALK"    , "narrator": "神楽", "text": "差し替えることも追加することも可能だが"},
        { "location": "1672/TALK"    , "narrator": "神楽", "text": "その代償は駒になった人間の命"},
        { "location": "1673/TALK"    , "narrator": "神楽", "text": "一旦盤上に上った人間が盤を降りることは死を意味する"},
        { "location": "1675/SEL"     , "narrator": "", "text": "なにそれこわい"},
        { "location": "1676/SEL"     , "narrator": "", "text": "それが…神々のチェス…！"},
        { "location": "1677/SEL"     , "narrator": "", "text": "重い話だ"},
        { "location": "1678/ACT"     , "narrator": "", "text": "なにそれこわい"},
        { "location": "1679/TALK"    , "narrator": "神楽", "text": "そういう約束だから"},
        { "location": "1680/TALK"    , "narrator": "神楽", "text": "仕方ない"},
        { "location": "1681/ACT"     , "narrator": "", "text": "それが…神々のチェス…！"},
        { "location": "1682/TALK"    , "narrator": "神楽", "text": "人の命は神が握っている"},
        { "location": "1683/TALK"    , "narrator": "神楽", "text": "なぜならこれは神々の遊びなのだから"},
        { "location": "1684/ACT"     , "narrator": "", "text": "重い話だ"},
        { "location": "1685/TALK"    , "narrator": "神楽", "text": "確かにそう"},
        { "location": "1686/TALK"    , "narrator": "神楽", "text": "でもそういうもの"},
        { "location": "1688/TALK"    , "narrator": "神楽", "text": "チェスに不慣れなぴょんこには全員を生かして勝つことは不可能"},
        { "location": "1689/TALK"    , "narrator": "神楽", "text": "ならどうするか"},
        { "location": "1690/TALK"    , "narrator": "神楽", "text": "大事な駒のためにその他の駒を切り捨てる"},
        { "location": "1691/TALK"    , "narrator": "神楽", "text": "それ以外の方法はない"},
        { "location": "1693/SEL"     , "narrator": "", "text": "そうするしかないだろうね"},
        { "location": "1694/SEL"     , "narrator": "", "text": "勝てるならそれで"},
        { "location": "1695/SEL"     , "narrator": "", "text": "もっとよい手を考えろ、じゃないの？"},
        { "location": "1696/ACT"     , "narrator": "", "text": "そうするしかないだろうね"},
        { "location": "1697/TALK"    , "narrator": "神楽", "text": "そうでしょ"},
        { "location": "1698/TALK"    , "narrator": "神楽", "text": "他に手はないんだから"},
        { "location": "1699/ACT"     , "narrator": "", "text": "勝てるならそれで"},
        { "location": "1700/TALK"    , "narrator": "神楽", "text": "もちろん"},
        { "location": "1701/TALK"    , "narrator": "神楽", "text": "勝つための戦略だから"},
        { "location": "1702/ACT"     , "narrator": "", "text": "もっとよい手を考えろ、じゃないの？"},
        { "location": "1703/TALK"    , "narrator": "神楽", "text": "考えに考えた結果の結論だから"},
        { "location": "1705/TALK"    , "narrator": "神楽", "text": "そしてぴょんこは自分自身を切り捨てれば勝てるのなら"},
        { "location": "1706/TALK"    , "narrator": "神楽", "text": "あえてこの身を捨てることも視野に入れている"},
        { "location": "1709/SEL"     , "narrator": "", "text": "そんなの無理だって"},
        { "location": "1710/SEL"     , "narrator": "", "text": "自己犠牲の美学か…"},
        { "location": "1711/SEL"     , "narrator": "", "text": "それだけはやめて！"},
        { "location": "1712/ACT"     , "narrator": "", "text": "そんなの無理だって"},
        { "location": "1713/TALK"    , "narrator": "神楽", "text": "そうかな？"},
        { "location": "1714/TALK"    , "narrator": "神楽", "text": "そう思うなら"},
        { "location": "1715/TALK"    , "narrator": "神楽", "text": "ちゃんと見ててね（暗黒微笑"},
        { "location": "1725/ACT"     , "narrator": "", "text": "自己犠牲の美学か…"},
        { "location": "1726/TALK"    , "narrator": "神楽", "text": "美学、、、"},
        { "location": "1727/TALK"    , "narrator": "神楽", "text": "そうかもしれないぴょん"},
        { "location": "1728/TALK"    , "narrator": "神楽", "text": "そしてそのために命を散らすのもありかもね"},
        { "location": "1738/ACT"     , "narrator": "", "text": "それだけはやめて！"},
        { "location": "1740/TALK"    , "narrator": "神楽", "text": "でも"},
        { "location": "1741/TALK"    , "narrator": "神楽", "text": "他に"},
        { "location": "1742/TALK"    , "narrator": "神楽", "text": "手がないなら"},
        { "location": "1744/SEL"     , "narrator": "", "text": "負けてもいいから生きて！"},
        { "location": "1745/SEL"     , "narrator": "", "text": "神楽が死ぬのだけはダメ！"},
        { "location": "1746/SEL"     , "narrator": "", "text": "そんなゲーム無効だ無効！！！"},
        { "location": "1747/ACT"     , "narrator": "", "text": "負けてもいいから生きて！"},
        { "location": "1748/TALK"    , "narrator": "神楽", "text": "無茶苦茶なこと言って"},
        { "location": "1750/TALK"    , "narrator": "神楽", "text": "$handle$はもー！！！"},
        { "location": "1751/ACT"     , "narrator": "", "text": "神楽が死ぬのだけはダメ！"},
        { "location": "1752/TALK"    , "narrator": "神楽", "text": "そんなこと言っても"},
        { "location": "1753/TALK"    , "narrator": "神楽", "text": "そうしないと勝利条件に届かないから"},
        { "location": "1754/ACT"     , "narrator": "", "text": "そんなゲーム無効だ無効！！！"},
        { "location": "1755/TALK"    , "narrator": "神楽", "text": "そういうわけにはいかないから"},
        { "location": "1756/TALK"    , "narrator": "神楽", "text": "でもちょっとｶｯｺｲｲ、、、"},
        { "location": "1759/SEL"     , "narrator": "", "text": "神楽は生きることを第一に考えて！"},
        { "location": "1760/SEL"     , "narrator": "", "text": "世界より神楽の方が大事だから"},
        { "location": "1761/SEL"     , "narrator": "", "text": "$me$は神楽と一緒にいたいんだ"},
        { "location": "1762/ACT"     , "narrator": "", "text": "神楽は生きることを第一に考えて！"},
        { "location": "1763/TALK"    , "narrator": "神楽", "text": "生きることを第一に、って、、、"},
        { "location": "1764/TALK"    , "narrator": "神楽", "text": "すごいこと言うね？"},
        { "location": "1765/ACT"     , "narrator": "", "text": "世界より神楽の方が大事だから"},
        { "location": "1766/TALK"    , "narrator": "神楽", "text": "世界がなくなったらぴょんこもどうなるかわかんないのに？"},
        { "location": "1767/ACT"     , "narrator": "", "text": "$me$は神楽と一緒にいたいんだ"},
        { "location": "1768/TALK"    , "narrator": "神楽", "text": "ぴょんこは、、、、"},
        { "location": "1769/TALK"    , "narrator": "神楽", "text": "$handle$と一緒にいたいかな、、、"},
        { "location": "1775/TALK"    , "narrator": "神楽", "text": "うん"},
        { "location": "1776/TALK"    , "narrator": "神楽", "text": "決めた"},
        { "location": "1779/TALK"    , "narrator": "ボイスメール", "text": "決意表明"},
        { "location": "1791/DIALOG"  , "narrator": "Dialog_GETVoice", "text": "<color=green>【神楽】</color>のボイスメール\n<color=red>【決意表明】</color>\nをゲットしました！"}
    ]
}
