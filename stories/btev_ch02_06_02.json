{
    "dir": "chap06/battle/btev_ch02_06_02.js",
    "type": "",
    "info": {
        "story_id": "22009",
        "cid": "",
        "title": "009 ココロスフィアストーリー【Lv03】",
        "sub_title": "姉妹の隔絶Ⅰ＜帰結＞"
    },
    "entry":
    [
        { "location": "122/SCENARIO", "narrator": "", "text": "姉妹の隔絶・前編２"},
        { "location": "131/TALK"    , "narrator": "表層アーヤ", "text": "見かけによらず、\n随分と根性が\nあるのね……。"},
        { "location": "132/TALK"    , "narrator": "潜在アーヤ", "text": "当然じゃない。"},
        { "location": "133/TALK"    , "narrator": "潜在アーヤ", "text": "それくらいもう、\n私にはどうでも\nいいことなの。"},
        { "location": "135/TALK"    , "narrator": "表層アーヤ", "text": "……あり得ない。"},
        { "location": "136/TALK"    , "narrator": "表層アーヤ", "text": "まあいいわ。\nここは一時退却。"},
        { "location": "137/TALK"    , "narrator": "表層アーヤ", "text": "でも、私の想いだって\n今の攻撃程度じゃ\n消えはしない。"},
        { "location": "138/TALK"    , "narrator": "表層アーヤ", "text": "立て直してまた来る\nから、首を洗って\n待ってらっしゃい。"},
        { "location": "148/TALK"    , "narrator": "潜在アーヤ", "text": "全く、しぶといわね。"},
        { "location": "157/TALK"    , "narrator": "潜在アーヤ", "text": "ね、首を洗って\n待ってらっしゃい、\nとか――"},
        { "location": "159/TALK"    , "narrator": "潜在アーヤ", "text": "いまどき\nダサいと思わない？"},
        { "location": "160/SEL"     , "narrator": "（選択肢）", "text": "確かに、笑える"},
        { "location": "161/SEL"     , "narrator": "（選択肢）", "text": "そういうところ、好きだけどな"},
        { "location": "162/ACT"     , "narrator": "", "text": "確かに、笑える"},
        { "location": "163/TALK"    , "narrator": "潜在アーヤ", "text": "ね。"},
        { "location": "164/TALK"    , "narrator": "潜在アーヤ", "text": "私はそういう、\nイケてない自分を\n変えていきたいの。"},
        { "location": "165/TALK"    , "narrator": "潜在アーヤ", "text": "だから、これからも\n是非協力してね。"},
        { "location": "166/ACT"     , "narrator": "", "text": "そういうところ、好きだけどな"},
        { "location": "167/TALK"    , "narrator": "潜在アーヤ", "text": "ふふ、そうなのね。"},
        { "location": "169/TALK"    , "narrator": "潜在アーヤ", "text": "お気遣いさん？\nそれとも古風なのが\n好きなのかしら。"},
        { "location": "170/TALK"    , "narrator": "潜在アーヤ", "text": "そんな趣味が合わない\n私の味方をしてくれて\nありがとう。"},
        { "location": "174/TALK"    , "narrator": "潜在アーヤ", "text": "さて、と。\n戦いもまだこれから\nみたいだし。"},
        { "location": "175/TALK"    , "narrator": "潜在アーヤ", "text": "やっぱり姉のことは\nちゃんと教えておいた\n方がいいみたいね。"},
        { "location": "176/TALK"    , "narrator": "潜在アーヤ", "text": "全部見せてあげる。\n私と姉の関係を。"},
        { "location": "195/DIALOG"  , "narrator": "", "text": "私の姉はとても変な人で\n言動も行動も、とても\n普通の女の子とは思えないものだった。"},
        { "location": "196/DIALOG"  , "narrator": "", "text": "姉は科学や工学が大好きで、\nいつだって変なものを作っては\nそれを家の外で試したり、\n学校に持っていったりしていたわ。"},
        { "location": "197/DIALOG"  , "narrator": "", "text": "田舎ではそういうの\nすごい変な目で見られるから、\n私は外ではなるべく\n姉と接触しないようにしていたの。"},
        { "location": "198/TALK"    , "narrator": "女子高校生Ａ", "text": "あ、國政さん！"},
        { "location": "199/TALK"    , "narrator": "高校生アーヤ", "text": "あ、立川先輩。\nおはようございます！"},
        { "location": "200/TALK"    , "narrator": "女子高校生Ａ", "text": "國政さん、おめでと！"},
        { "location": "201/TALK"    , "narrator": "高校生アーヤ", "text": "え？"},
        { "location": "202/TALK"    , "narrator": "女子高校生Ａ", "text": "今度の剣道県大会、\n貴方が副将だって、\n顧問が！"},
        { "location": "203/TALK"    , "narrator": "高校生アーヤ", "text": "ええっ！\n本当ですか！？"},
        { "location": "204/TALK"    , "narrator": "女子高校生Ａ", "text": "ホントよぉ。\n初めてだってよ？\n一年で副将って。"},
        { "location": "205/TALK"    , "narrator": "高校生アーヤ", "text": "…嬉しいです！"},
        { "location": "206/TALK"    , "narrator": "女子高校生Ａ", "text": "マジ頑張ってよ。\n長野一高のホープ！"},
        { "location": "207/TALK"    , "narrator": "高校生アーヤ", "text": "あ、ありがとう\nございます！"},
        { "location": "208/TALK"    , "narrator": "女子高校生Ａ", "text": "じゃね。\n放課後部活で！"},
        { "location": "209/TALK"    , "narrator": "高校生アーヤ", "text": "はいっ！！"},
        { "location": "211/TALK"    , "narrator": "高校生アーヤ", "text": "すごい！　嬉しいっ！\nまさか副将だなんて。"},
        { "location": "212/TALK"    , "narrator": "高校生アーヤ", "text": "でも……\nこれは責任重大ね。\nもっと精進しなくちゃ。"},
        { "location": "213/TALK"    , "narrator": "高校生アーヤ", "text": "これからは朝練、\n１時間早くして――"},
        { "location": "215/TALK"    , "narrator": "姉", "text": "綾ちゃーん！"},
        { "location": "216/TALK"    , "narrator": "高校生アーヤ", "text": "…っ！？"},
        { "location": "219/TALK"    , "narrator": "姉", "text": "綾ちゃんおはよー。"},
        { "location": "220/TALK"    , "narrator": "高校生アーヤ", "text": "…ちょっ…\n学校で話しかけて\nこないでよっ！"},
        { "location": "221/TALK"    , "narrator": "姉", "text": "もー、つれないなぁ。\n家ではいつもお話\nしてるじゃない。"},
        { "location": "222/TALK"    , "narrator": "姉", "text": "あのね、綾ちゃんに\n見せたいものがあって\n声かけたんだ～。"},
        { "location": "223/TALK"    , "narrator": "高校生アーヤ", "text": "うわ、やばっ！"},
        { "location": "225/TALK"    , "narrator": "高校生アーヤ", "text": "お姉ちゃん、\nちょっと後で――"},
        { "location": "226/TALK"    , "narrator": "姉", "text": "ぱぱーん！\nわたしの新発明！\nクモ型にゃボット～！"},
        { "location": "227/TALK"    , "narrator": "高校生アーヤ", "text": "あぁぁぁぁ……\n今日のはいつもに\n増して強烈だわ…"},
        { "location": "228/TALK"    , "narrator": "高校生アーヤ", "text": "なんで猫に足が\n８本も付いてるのよ！\nしかも気持ち悪い…。"},
        { "location": "229/TALK"    , "narrator": "姉", "text": "よくぞ\n聞いてくれました！"},
        { "location": "230/TALK"    , "narrator": "姉", "text": "何で足が８本ついて\nいるかって？\nそれはね～！"},
        { "location": "231/TALK"    , "narrator": "高校生アーヤ", "text": "いや、\n聞いてないから！！"},
        { "location": "232/TALK"    , "narrator": "女子高校生Ｂ", "text": "なにあれ、キモイ！"},
        { "location": "234/TALK"    , "narrator": "男子高校生Ａ", "text": "お、マッドサイエン\nティスト國政博士\nじゃん。"},
        { "location": "237/TALK"    , "narrator": "男子高校生Ｂ", "text": "國政の姉さんって\nちょっと変わってる\nよな。"},
        { "location": "239/TALK"    , "narrator": "男子高校生Ａ", "text": "ちょっとどころじゃ\nないって…"},
        { "location": "240/TALK"    , "narrator": "女子高校生Ａ", "text": "妹さんは成績優秀で\n剣道も凄いし、非の\n打ち所がないけど――"},
        { "location": "243/TALK"    , "narrator": "女子高校生Ｂ", "text": "お姉さんがあれじゃあ\nね～。"},
        { "location": "244/TALK"    , "narrator": "姉", "text": "今から動かすから、\nちょっとそっちの足\n持ってくれる？"},
        { "location": "245/TALK"    , "narrator": "高校生アーヤ", "text": "っ！！"},
        { "location": "247/TALK"    , "narrator": "姉", "text": "あ、ちょっと\n綾ちゃーん！"},
        { "location": "249/TALK"    , "narrator": "姉", "text": "待って～～！"},
        { "location": "260/TALK"    , "narrator": "潜在アーヤ", "text": "とまあ、毎日こんな\n感じだったから、\n色々と大変だったわ。"},
        { "location": "261/SEL"     , "narrator": "（選択肢）", "text": "いや、寧ろ楽しそう！"},
        { "location": "262/SEL"     , "narrator": "（選択肢）", "text": "確かに恥ずかしいけど、許せないって程じゃ…"},
        { "location": "263/SEL"     , "narrator": "（選択肢）", "text": "確かにこれは許せん！アーヤがかわいそう！"},
        { "location": "264/ACT"     , "narrator": "", "text": "いや、寧ろ楽しそう！"},
        { "location": "265/TALK"    , "narrator": "潜在アーヤ", "text": "へぇ、それは意外。\n姉と気が合うかもね。"},
        { "location": "266/ACT"     , "narrator": "", "text": "確かに恥ずかしいけど、許せないって程じゃ…"},
        { "location": "267/TALK"    , "narrator": "潜在アーヤ", "text": "でしょ？"},
        { "location": "268/TALK"    , "narrator": "潜在アーヤ", "text": "だからもう、過去の\nことなんて水に流せば\nいいと思うの。"},
        { "location": "269/ACT"     , "narrator": "", "text": "確かにこれは許せん！アーヤがかわいそう！"},
        { "location": "271/TALK"    , "narrator": "潜在アーヤ", "text": "そこまで！？"},
        { "location": "272/TALK"    , "narrator": "潜在アーヤ", "text": "まあ確かに高校時代\nとか肩身が狭かった\nのは事実だけど――"},
        { "location": "273/TALK"    , "narrator": "潜在アーヤ", "text": "まあ姉も、あれは\nあれで悪気がある\nわけじゃないし。"},
        { "location": "275/TALK"    , "narrator": "潜在アーヤ", "text": "そんなわけだから、\n頑固に過去のことに\nしがみついてないで―"},
        { "location": "276/TALK"    , "narrator": "潜在アーヤ", "text": "姉と和解して\n連絡とればいいって\n思うのよ。"},
        { "location": "277/SEL"     , "narrator": "（選択肢）", "text": "同感"},
        { "location": "278/SEL"     , "narrator": "（選択肢）", "text": "難しいと思うな"},
        { "location": "279/ACT"     , "narrator": "", "text": "同感"},
        { "location": "280/TALK"    , "narrator": "潜在アーヤ", "text": "でしょ？"},
        { "location": "281/TALK"    , "narrator": "潜在アーヤ", "text": "だから、また\n力を貸してね？"},
        { "location": "282/TALK"    , "narrator": "潜在アーヤ", "text": "現実世界の\n私の為にも。"},
        { "location": "283/ACT"     , "narrator": "", "text": "難しいと思うな"},
        { "location": "284/TALK"    , "narrator": "潜在アーヤ", "text": "あら、そう？"},
        { "location": "285/TALK"    , "narrator": "潜在アーヤ", "text": "まあ、無理強いは\nできないものね。"},
        { "location": "286/TALK"    , "narrator": "潜在アーヤ", "text": "気が向いたら\nまたつき合って\nくれると嬉しいかな。"},
        { "location": "290/SEL"     , "narrator": "（選択肢）", "text": "ところで、デートは？"},
        { "location": "291/ACT"     , "narrator": "", "text": "ところで、デートは？"},
        { "location": "293/TALK"    , "narrator": "潜在アーヤ", "text": "ああ、そうね。\n約束してたわね。"},
        { "location": "294/TALK"    , "narrator": "潜在アーヤ", "text": "でもそれは、もう\nちょっと今回の件が\n落ち着いてからかな。"},
        { "location": "295/TALK"    , "narrator": "潜在アーヤ", "text": "でも、絶対に\n約束は守るわ。\nだから安心してね？"}
    ]
}
