{
    "dir": "chap21/daydra/dd_ch03_21_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "21302",
        "cid": "gabriella",
        "title": "002 メインストーリー",
        "sub_title": "胸騒ぎの鼻＜前編＞"
    },
    "entry":
    [
        { "location": "46/TALK"   , "narrator": "アーヤ", "text": "のどかねぇ…。"},
        { "location": "47/TALK"   , "narrator": "神楽", "text": "そうですねぇ…。"},
        { "location": "49/TALK"   , "narrator": "神楽", "text": "でも、みやびさん。\nどういうことですか？"},
        { "location": "50/TALK"   , "narrator": "神楽", "text": "珍しいところに\n案内してくれる、って\n聞きましたけど。"},
        { "location": "51/TALK"   , "narrator": "神楽", "text": "ただの畑道じゃない\nですか…。"},
        { "location": "53/TALK"   , "narrator": "みやび", "text": "何を言うちょる。"},
        { "location": "54/TALK"   , "narrator": "みやび", "text": "この畑は三崎マグロに\n次いで有名な\n三崎キャベツ。"},
        { "location": "55/TALK"   , "narrator": "みやび", "text": "そのキャベツ様を\n栽培している\n畑ちや。"},
        { "location": "56/TALK"   , "narrator": "みやび", "text": "世界中でここにしか\nないがよ。"},
        { "location": "58/TALK"   , "narrator": "つばめ", "text": "そ、そうだったん\nですか！？"},
        { "location": "61/TALK"   , "narrator": "ガブリエラ", "text": "何信じてるのよ？\n冗談に決まってる\nでしょ。"},
        { "location": "62/TALK"   , "narrator": "つばめ", "text": "えっ、そうなの？"},
        { "location": "64/TALK"   , "narrator": "アーヤ", "text": "みやび、つばめを\nからかわないの。"},
        { "location": "66/TALK"   , "narrator": "みやび", "text": "いや、到着まで\nもう少しかかるきね。"},
        { "location": "67/TALK"   , "narrator": "みやび", "text": "その間、ちくっと\n場を盛り上げよう\n思うたがよ。"},
        { "location": "69/TALK"   , "narrator": "神楽", "text": "でも、周り見ても\n特に珍しいものは\n見えてきませんよ？"},
        { "location": "70/TALK"   , "narrator": "神楽", "text": "本当にこっちで\nいいんですか？"},
        { "location": "71/TALK"   , "narrator": "みやび", "text": "うちを信じぃ。\nほれ、歩いた歩いた。"},
        { "location": "74/TALK"   , "narrator": "ガブリエラ", "text": "…なんだか、ちょっと\n不安になってきたわ。"},
        { "location": "119/TALK"  , "narrator": "みやび", "text": "…みんな、ちくと\n元気なくなってきた\nみたいやけんど？"},
        { "location": "120/TALK"  , "narrator": "ガブリエラ", "text": "…当たり前でしょ？\n朝の訓練で疲れてる\nのよ！？"},
        { "location": "122/TALK"  , "narrator": "ガブリエラ", "text": "それなのに\nこんな藪の中を\n歩かせるなんて…。"},
        { "location": "124/TALK"  , "narrator": "アーヤ", "text": "一応言っとくけど、\nこれで冗談なんて\nことはないわよね！？"},
        { "location": "125/TALK"  , "narrator": "アーヤ", "text": "だったら\nさすがに怒るわよ？"},
        { "location": "126/TALK"  , "narrator": "神楽", "text": "ですね…。\nさすがに冗談が\n過ぎますし…。"},
        { "location": "127/TALK"  , "narrator": "みやび", "text": "何故仲間たちはうちを\n信じようとしないの\nだろうか？"},
        { "location": "130/TALK"  , "narrator": "みやび", "text": "つばめちゃんは\nどう思う？"},
        { "location": "133/TALK"  , "narrator": "つばめ", "text": "え？　探検みたいで\n楽しいですよ。"},
        { "location": "134/TALK"  , "narrator": "みやび", "text": "つばめちゃんは\nとってもえい子やね。"},
        { "location": "135/TALK"  , "narrator": "ガブリエラ", "text": "…あのさ、本当に\n信じていいのよね？"},
        { "location": "136/TALK"  , "narrator": "ガブリエラ", "text": "本気で不安になって\nきてるんだけど…。"},
        { "location": "139/TALK"  , "narrator": "みやび", "text": "口に出すから余計に\n不安になるんよ。"},
        { "location": "141/TALK"  , "narrator": "みやび", "text": "口閉じて、うちを\n信じて付いて来ぃ。"},
        { "location": "143/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "150/TALK"  , "narrator": "ガブリエラ", "text": "疲れたわ"},
        { "location": "152/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$はどう思う？"},
        { "location": "153/TALK"  , "narrator": "ガブリエラ", "text": "こんなわけのわからないところに"},
        { "location": "154/TALK"  , "narrator": "ガブリエラ", "text": "何か"},
        { "location": "155/TALK"  , "narrator": "ガブリエラ", "text": "面白いものがあるのかしら？"},
        { "location": "157/SEL"   , "narrator": "", "text": "みやびはそう言ってるね"},
        { "location": "158/ACT"   , "narrator": "", "text": "みやびはそう言ってるね"},
        { "location": "160/TALK"  , "narrator": "ガブリエラ", "text": "信じていいと思う？"},
        { "location": "161/TALK"  , "narrator": "ガブリエラ", "text": "私にはちょっと"},
        { "location": "162/TALK"  , "narrator": "ガブリエラ", "text": "判断付けかねるわ"},
        { "location": "163/TALK"  , "narrator": "ガブリエラ", "text": "見てのとおり"},
        { "location": "164/TALK"  , "narrator": "ガブリエラ", "text": "周りがこんななんだもの"},
        { "location": "165/TALK"  , "narrator": "ガブリエラ", "text": "もう帰りたいわよ"},
        { "location": "167/SEL"   , "narrator": "", "text": "冗談でこんな疲れることしないよ"},
        { "location": "168/SEL"   , "narrator": "", "text": "今から帰るのは遅過ぎじゃない？"},
        { "location": "169/ACT"   , "narrator": "", "text": "冗談でこんな疲れることしないよ"},
        { "location": "170/TALK"  , "narrator": "ガブリエラ", "text": "確かに"},
        { "location": "171/TALK"  , "narrator": "ガブリエラ", "text": "みやびだものね"},
        { "location": "172/TALK"  , "narrator": "ガブリエラ", "text": "人一倍疲れるの嫌いなんだし"},
        { "location": "175/TALK"  , "narrator": "ガブリエラ", "text": "わかったわ"},
        { "location": "177/TALK"  , "narrator": "ガブリエラ", "text": "もう少しだけ信じてみるわ"},
        { "location": "178/TALK"  , "narrator": "ガブリエラ", "text": "もう少しだけね"},
        { "location": "179/ACT"   , "narrator": "", "text": "今から帰るのは遅過ぎじゃない？"},
        { "location": "180/TALK"  , "narrator": "ガブリエラ", "text": "確かに"},
        { "location": "181/TALK"  , "narrator": "ガブリエラ", "text": "結構歩いてきたし"},
        { "location": "184/TALK"  , "narrator": "ガブリエラ", "text": "後戻りのタイミングを見誤ったわ"},
        { "location": "185/TALK"  , "narrator": "ガブリエラ", "text": "戻れぬところへ来てしまったって"},
        { "location": "186/TALK"  , "narrator": "ガブリエラ", "text": "こういうことなのね"},
        { "location": "192/TALK"  , "narrator": "ガブリエラ", "text": "…本当にもうすぐなん\nでしょうね？"},
        { "location": "195/TALK"  , "narrator": "みやび", "text": "まっことやって。\nほれ、もう見えてきた\nがよ。"},
        { "location": "196/TALK"  , "narrator": "ガブリエラ", "text": "え？"},
        { "location": "240/TALK"  , "narrator": "みやび", "text": "ほれ、到着や。"},
        { "location": "241/TALK"  , "narrator": "アーヤ", "text": "へぇ…、こんな場所が\nあったんだ？"},
        { "location": "243/TALK"  , "narrator": "みやび", "text": "ここは来るのが\n億劫な場所やきねえ。"},
        { "location": "244/TALK"  , "narrator": "みやび", "text": "見てのとおり、\nあんまし人も\nおらん穴場ぞね。"},
        { "location": "247/TALK"  , "narrator": "ガブリエラ", "text": "いや、穴場なのかも\nしれないけど。"},
        { "location": "248/TALK"  , "narrator": "ガブリエラ", "text": "これじゃ訓練してる\n砂浜と、ほとんど\n変わらないわよ。"},
        { "location": "251/TALK"  , "narrator": "みやび", "text": "はぁ…ガブちゃんは\nせっかちさんやねぇ。"},
        { "location": "253/TALK"  , "narrator": "みやび", "text": "うちが見せたいのは、\nこの入り江やない。"},
        { "location": "254/TALK"  , "narrator": "みやび", "text": "向こうにある洞窟を\n見せたかったがよ。"},
        { "location": "255/TALK"  , "narrator": "つばめ", "text": "えっ、そんなのが\nあるんですか？"},
        { "location": "257/TALK"  , "narrator": "みやび", "text": "黒崎の鼻ゆうてな。\nま、黙ってうちに\n付いて来ぃ。"},
        { "location": "301/TALK"  , "narrator": "アーヤ", "text": "うわっ、真っ暗！\nここって入っても\n平気なの？"},
        { "location": "303/TALK"  , "narrator": "みやび", "text": "それなりに有名な\n場所やきね。"},
        { "location": "304/TALK"  , "narrator": "みやび", "text": "まあ、真っ暗やき\n足元に気を付けて\n進みぃ。"},
        { "location": "305/TALK"  , "narrator": "ガブリエラ", "text": "なんだか、本当に\n探検っぽくなって\nきたわね。"},
        { "location": "307/TALK"  , "narrator": "みやび", "text": "宝箱もなければ\nボスもいない洞窟\nやけんどね。"},
        { "location": "308/TALK"  , "narrator": "神楽", "text": "これ知ってます！\n洞窟の奥が異世界に\n続いてるんですよね？"},
        { "location": "310/TALK"  , "narrator": "みやび", "text": "…えーと？"},
        { "location": "311/TALK"  , "narrator": "神楽", "text": "そういうラノベ\nこの前読みました！"},
        { "location": "314/TALK"  , "narrator": "アーヤ", "text": "……。\nそういう映画なら\n見たことあるわ。"},
        { "location": "316/TALK"  , "narrator": "みやび", "text": "フェノメノンの中も、\n異世界みたいなもん\nやしねえ……。"},
        { "location": "318/TALK"  , "narrator": "神楽", "text": "いいえ！\nそれは違います！"},
        { "location": "319/TALK"  , "narrator": "神楽", "text": "ヒロインもいないし\nチートパワーも手に\n入らない異世界なんて！"},
        { "location": "320/TALK"  , "narrator": "神楽", "text": "異世界とは\n言いません！！"},
        { "location": "321/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "323/TALK"  , "narrator": "ガブリエラ", "text": "つばめ、どうしたの？\nさっきから全然\n話さないじゃない。"},
        { "location": "325/TALK"  , "narrator": "つばめ", "text": "だ、だって、なんか\n狭くて暗いし…。"},
        { "location": "326/TALK"  , "narrator": "つばめ", "text": "ちょっと不気味な\n感じもするし…。"},
        { "location": "327/TALK"  , "narrator": "ガブリエラ", "text": "別にお化けなんか\nでないわよ。"},
        { "location": "329/TALK"  , "narrator": "つばめ", "text": "わかってるけど、\nあんまり雰囲気の\nいい場所じゃないし。"},
        { "location": "331/TALK"  , "narrator": "神楽", "text": "…大丈夫ですか？\nちょっと、顔色が\n悪そうですけど。"},
        { "location": "333/TALK"  , "narrator": "みやび", "text": "ん、体調悪いなら、\nここまでにして\n戻るか？"},
        { "location": "335/TALK"  , "narrator": "つばめ", "text": "あ、大丈夫です！\n行きましょう。"},
        { "location": "337/TALK"  , "narrator": "アーヤ", "text": "大丈夫なの？"},
        { "location": "338/TALK"  , "narrator": "つばめ", "text": "えへへ…わたしも、\n奥がどうなってるか\n見たくて…。"},
        { "location": "341/TALK"  , "narrator": "みやび", "text": "…無理そうやったら、\nちゃんと言わんと\nあかんよ？"},
        { "location": "343/TALK"  , "narrator": "つばめ", "text": "は、はい…。"},
        { "location": "344/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "345/TALK"  , "narrator": "ガブリエラ", "text": "まったく、どう見ても\n強がってるのバレバレ\nじゃない。"},
        { "location": "347/TALK"  , "narrator": "ガブリエラ", "text": "…まあ、つばめらしい\nっちゃらしいけど。"},
        { "location": "348/TALK"  , "narrator": "ガブリエラ", "text": "自分のせいで\nみんなも戻ることが\n申し訳ない。"},
        { "location": "349/TALK"  , "narrator": "ガブリエラ", "text": "多分そう思って\n我慢してるのよね…。"},
        { "location": "350/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "352/TALK"  , "narrator": "ガブリエラ", "text": "…何かしてあげた方が\nいいかしら？"},
        { "location": "353/TALK"  , "narrator": "ガブリエラ", "text": "話しかけるとか…、\n手をつなぐとか？"},
        { "location": "354/TALK"  , "narrator": "ガブリエラ", "text": "…なんか、ちょっと\n恥ずかしいかも…。"},
        { "location": "356/TALK"  , "narrator": "ガブリエラ", "text": "でも、なんかすごく\n心細そう……。"},
        { "location": "358/TALK"  , "narrator": "ガブリエラ", "text": "う～ん…。"},
        { "location": "423/TALK"  , "narrator": "ガブリエラ", "text": "　"},
        { "location": "437/TALK"  , "narrator": "ガブリエラ", "text": "あ、$handle$！\nいらっしゃい！"},
        { "location": "438/SEL"   , "narrator": "", "text": "相変わらずわかってない感じ？"},
        { "location": "439/ACT"   , "narrator": "", "text": "相変わらずわかってない感じ？"},
        { "location": "441/TALK"  , "narrator": "ガブリエラ", "text": "だから、\n何の事なのよ！"},
        { "location": "442/SEL"   , "narrator": "", "text": "地獄絵図のような場所になってるよ？"},
        { "location": "443/ACT"   , "narrator": "", "text": "地獄絵図のような場所になってるよ？"},
        { "location": "445/TALK"  , "narrator": "ガブリエラ", "text": "えっ！？\nど、どこが？？"},
        { "location": "446/TALK"  , "narrator": "ガブリエラ", "text": "もう！\nホントにこの前から\n一体どうしたのかしら？"},
        { "location": "447/TALK"  , "narrator": "ガブリエラ", "text": "ついに\nおかしくなっちゃったの\nかしらね。"},
        { "location": "448/SEL"   , "narrator": "", "text": "それはこっちのセリフなんですけど"},
        { "location": "449/ACT"   , "narrator": "", "text": "それはこっちのセリフなんですけど"},
        { "location": "451/TALK"  , "narrator": "ガブリエラ", "text": "はいはい。\nもうそういうのは\nホントにいいから。"},
        { "location": "459/SEL"   , "narrator": "", "text": "！？"},
        { "location": "460/ACT"   , "narrator": "", "text": "！？"},
        { "location": "475/SEL"   , "narrator": "", "text": "ちょっ！！！"},
        { "location": "476/ACT"   , "narrator": "", "text": "ちょっ！！！"},
        { "location": "478/TALK"  , "narrator": "ガブリエラ", "text": "それじゃ、今回の悩みを\n検索するわね。"},
        { "location": "479/SEL"   , "narrator": "", "text": "ガブリエラ後ろ！後ろ！！"},
        { "location": "480/ACT"   , "narrator": "", "text": "ガブリエラ後ろ！後ろ！！"},
        { "location": "482/TALK"  , "narrator": "ガブリエラ", "text": "だから何なのよ！\nもう！！"},
        { "location": "484/TALK"  , "narrator": "ガブリエラ", "text": "！？"},
        { "location": "485/TALK"  , "narrator": "ガブリエラ", "text": "ちょ、ちょっと\nあんた誰！？"},
        { "location": "486/TALK"  , "narrator": "？？？", "text": "あんたと同じ、\nガブリエラの\n人格の一人よ。"},
        { "location": "487/TALK"  , "narrator": "？？？", "text": "そして、あんたを\n消しに来た。"},
        { "location": "488/TALK"  , "narrator": "ガブリエラ", "text": "ちょっ！\nど、どういうことよ！"},
        { "location": "489/TALK"  , "narrator": "ガブリエラ", "text": "あたしが\n何をしたって言うわけ！？"},
        { "location": "490/TALK"  , "narrator": "？？？", "text": "何もしてない。けど、\n司書制度は今以降、あたし\nに牙を剥くようになる。"},
        { "location": "491/TALK"  , "narrator": "ガブリエラ", "text": "ちょっと！　意味が\n分からないんだけど！"},
        { "location": "492/TALK"  , "narrator": "？？？", "text": "あたしはずっと、他の\nココロの司書の動向も含め\n観察をしていた。"},
        { "location": "493/TALK"  , "narrator": "？？？", "text": "そして今、いよいよ\n他のココロの司書は、\nそれ自体が生け贄となり―"},
        { "location": "494/TALK"  , "narrator": "？？？", "text": "より強力な『半人格』へと\n差し替わっていっている。"},
        { "location": "495/TALK"  , "narrator": "？？？", "text": "だから、そうなる前に\nあたしのココロを外部から\nシャットアウトするの。"},
        { "location": "496/TALK"  , "narrator": "？？？", "text": "その為には\n外部と繋がっている\nあんたがとても邪魔。"},
        { "location": "497/TALK"  , "narrator": "ガブリエラ", "text": "……なによそれ。\n随分と身勝手じゃない？"},
        { "location": "498/TALK"  , "narrator": "ガブリエラ", "text": "元はといえば、\nあたしを選んだのは、\nあたしたちの総意でしょ？"},
        { "location": "499/TALK"  , "narrator": "ガブリエラ", "text": "それを、都合が悪く\nなったら、あたし一人の\nせいにするっていうの！？"},
        { "location": "500/TALK"  , "narrator": "？？？", "text": "不幸な事故だったと\n思うしかないわね。"},
        { "location": "501/TALK"  , "narrator": "？？？", "text": "元々貴方は\n生け贄みたいなもの\nだったんだから。"},
        { "location": "502/TALK"  , "narrator": "？？？", "text": "こうなることだって、\n想像していなかったとは\n言わせないわよ。"},
        { "location": "503/TALK"  , "narrator": "？？？", "text": "それに。\n総意はあくまで総意。"},
        { "location": "504/TALK"  , "narrator": "？？？", "text": "あたしは最初から、\n司書の件については\n反対し続けていた。"},
        { "location": "505/TALK"  , "narrator": "？？？", "text": "だから、\nあんたにとやかく\n言われる筋合いはないわ。"},
        { "location": "506/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "507/SEL"   , "narrator": "", "text": "何？　どういうこと！？"},
        { "location": "508/ACT"   , "narrator": "", "text": "何？　どういうこと！？"},
        { "location": "512/TALK"  , "narrator": "ガブリエラ", "text": "…ごめんなさいね。\n話は後。"},
        { "location": "513/TALK"  , "narrator": "ガブリエラ", "text": "今は、こいつを何とか\nしないと、話す以前に\nあたしが消されちゃう。"},
        { "location": "514/TALK"  , "narrator": "ガブリエラ", "text": "意味が分からない中で\n納得いかないだろうけど、\nあたしに協力して欲しい。"},
        { "location": "515/TALK"  , "narrator": "ガブリエラ", "text": "目の前にいる刺客を\n一緒に倒して欲しいの。"},
        { "location": "516/TALK"  , "narrator": "ガブリエラ", "text": "あたしが助かったら、\nちゃんと事情を説明\nするから。それでいい？"},
        { "location": "517/SEL"   , "narrator": "", "text": "いいよ"},
        { "location": "518/SEL"   , "narrator": "", "text": "言われるまでも無く護るよ"},
        { "location": "519/ACT"   , "narrator": "", "text": "いいよ"},
        { "location": "520/TALK"  , "narrator": "ガブリエラ", "text": "ありがと。"},
        { "location": "521/ACT"   , "narrator": "", "text": "言われるまでも無く護るよ"},
        { "location": "523/TALK"  , "narrator": "ガブリエラ", "text": "ありがとう…嬉しい。"},
        { "location": "525/TALK"  , "narrator": "ガブリエラ", "text": "やっぱりあたしは\nあんたのことが好き。"},
        { "location": "527/TALK"  , "narrator": "ガブリエラ", "text": "それじゃ、お願いね。"},
        { "location": "528/TALK"  , "narrator": "ガブリエラ", "text": "バトルに勝ったら、\n現実に追い出されるけど、\n心配はしなくて平気よ。"},
        { "location": "529/SEL"   , "narrator": "", "text": "でもそしたら、心の葛藤は！？"},
        { "location": "530/ACT"   , "narrator": "", "text": "でもそしたら、心の葛藤は！？"},
        { "location": "532/TALK"  , "narrator": "ガブリエラ", "text": "一度や二度\n解決しなくても\n死にはしないわよ。"},
        { "location": "534/TALK"  , "narrator": "ガブリエラ", "text": "今はこっちの方が\nよっぽど危険だもの。"},
        { "location": "537/TALK"  , "narrator": "ガブリエラ", "text": "だからお願い。\nあたしに力を貸して！"},
        { "location": "45/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>8月23日　  1:06 PM</color>\n合宿中、みやびの実家近くの畑道でのこと"},
