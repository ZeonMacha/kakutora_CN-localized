        { "location": "1369/TALK", "narrator": "プレイヤー", "text": "お着替えしてみよう"},
        { "location": "1371/TALK", "narrator": "プレイヤー", "text": "違う服を着てほしいな"},
        { "location": "1373/TALK", "narrator": "プレイヤー", "text": "よし、お着替えタイムだ！"},
        { "location": "1379/TALK", "narrator": "プレイヤー", "text": "やあ"},
        { "location": "1381/TALK", "narrator": "プレイヤー", "text": "こんにちは"},
        { "location": "1383/TALK", "narrator": "プレイヤー", "text": "げんき？"},
        { "location": "1386/TALK", "narrator": "神楽", "text": "ぴょんこを呼ぶ声"},
        { "location": "1387/TALK", "narrator": "神楽", "text": "あなたはだあれ？"},
        { "location": "1389/SEL" , "narrator": "", "text": "$handle$だよ"},
        { "location": "1390/ACT" , "narrator": "", "text": "$handle$だよ"},
        { "location": "1392/TALK", "narrator": "神楽", "text": "知ってるし"},
        { "location": "1393/TALK", "narrator": "神楽", "text": "ぴょんこに用事ぴょん？"},
        { "location": "1396/SEL" , "narrator": "", "text": "ちょっと着替えてほしいんだ"},
        { "location": "1397/ACT" , "narrator": "", "text": "ちょっと着替えてほしいんだ"},
        { "location": "1407/TALK", "narrator": "神楽", "text": "意味不明すぎ"},
        { "location": "1408/TALK", "narrator": "神楽", "text": "でもまあ"},
        { "location": "1409/TALK", "narrator": "神楽", "text": "優しいぴょんこは聞いてあげるのだった"},
        { "location": "1411/TALK", "narrator": "神楽", "text": "は？"},
        { "location": "1412/TALK", "narrator": "神楽", "text": "この服変だった？"},
        { "location": "1413/TALK", "narrator": "神楽", "text": "なら着替えるけど"},
        { "location": "1416/SEL" , "narrator": "", "text": "$me$が選ぶ"},
        { "location": "1417/SEL" , "narrator": "", "text": "やっぱやめる"},
        { "location": "1419/TALK", "narrator": "神楽", "text": "…………"},
        { "location": "1422/TALK", "narrator": "神楽", "text": "リクエストないとか？"},
        { "location": "1423/TALK", "narrator": "神楽", "text": "なら着ない"},
        { "location": "1425/ACT" , "narrator": "", "text": "$me$が選ぶ"},
        { "location": "1426/TALK", "narrator": "神楽", "text": "だと思った"},
        { "location": "1427/TALK", "narrator": "神楽", "text": "どれを着てほしいと？"},
        { "location": "1434/ACT" , "narrator": "", "text": "やっぱやめる"},
        { "location": "1435/TALK", "narrator": "神楽", "text": "ありえネー"}
