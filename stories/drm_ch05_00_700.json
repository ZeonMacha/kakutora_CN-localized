    "entry":
    [
        { "location": "1760/SCENARIO", "narrator": "", "text": "マジックワード"},
        { "location": "1785/TALK"    , "narrator": "神楽", "text": "イシュリールの新しい話をしてもいい？"},
        { "location": "1786/TALK"    , "narrator": "神楽", "text": "今じゃなくて"},
        { "location": "1787/TALK"    , "narrator": "神楽", "text": "思いついたら"},
        { "location": "1789/SEL"     , "narrator": "", "text": "もちろん"},
        { "location": "1790/SEL"     , "narrator": "", "text": "思いついたら言って"},
        { "location": "1791/SEL"     , "narrator": "", "text": "今度はどんな話？"},
        { "location": "1792/ACT"     , "narrator": "", "text": "もちろん"},
        { "location": "1793/TALK"    , "narrator": "神楽", "text": "ｱﾘｶﾞﾄ、、、"},
        { "location": "1794/TALK"    , "narrator": "神楽", "text": "そう言ってくれてよかった"},
        { "location": "1804/ACT"     , "narrator": "", "text": "思いついたら言って"},
        { "location": "1807/TALK"    , "narrator": "神楽", "text": "またね"},
        { "location": "1817/ACT"     , "narrator": "", "text": "今度はどんな話？"},
        { "location": "1819/TALK"    , "narrator": "神楽", "text": "まだふんわりとしてるんだけど"},
        { "location": "1820/TALK"    , "narrator": "神楽", "text": "今度はハッピーエンド"},
        { "location": "1821/TALK"    , "narrator": "神楽", "text": "それだけは決まってる"},
        { "location": "1823/SEL"     , "narrator": "", "text": "なるほどね"},
        { "location": "1824/SEL"     , "narrator": "", "text": "今のイシュリールは？"},
        { "location": "1825/ACT"     , "narrator": "", "text": "なるほどね"},
        { "location": "1826/TALK"    , "narrator": "神楽", "text": "そうなんだ"},
        { "location": "1827/ACT"     , "narrator": "", "text": "今のイシュリールは？"},
        { "location": "1828/TALK"    , "narrator": "神楽", "text": "いるよ"},
        { "location": "1829/TALK"    , "narrator": "神楽", "text": "その続きだから"},
        { "location": "1831/TALK"    , "narrator": "神楽", "text": "ぴょんこは"},
        { "location": "1832/TALK"    , "narrator": "神楽", "text": "イシュリールを否定してすごく後悔した"},
        { "location": "1833/TALK"    , "narrator": "神楽", "text": "だけどイシュフォビアも大事な子供みたいなものだし"},
        { "location": "1834/TALK"    , "narrator": "神楽", "text": "今度こそ愛してあげる"},
        { "location": "1836/SEL"     , "narrator": "", "text": "$me$も愛が欲しい"},
        { "location": "1837/SEL"     , "narrator": "", "text": "そっか…"},
        { "location": "1838/SEL"     , "narrator": "", "text": "今までだって愛してたでしょ"},
        { "location": "1839/ACT"     , "narrator": "", "text": "$me$も愛が欲しい"},
        { "location": "1840/TALK"    , "narrator": "神楽", "text": "気付いてないの？"},
        { "location": "1841/TALK"    , "narrator": "神楽", "text": "ぴょんこの愛に、、、"},
        { "location": "1842/ACT"     , "narrator": "", "text": "そっか…"},
        { "location": "1843/TALK"    , "narrator": "神楽", "text": "うん"},
        { "location": "1845/TALK"    , "narrator": "神楽", "text": "今度こそね"},
        { "location": "1846/ACT"     , "narrator": "", "text": "今までだって愛してたでしょ"},
        { "location": "1847/TALK"    , "narrator": "神楽", "text": "そうかな"},
        { "location": "1848/TALK"    , "narrator": "神楽", "text": "だったらいいんだけど"},
        { "location": "1850/TALK"    , "narrator": "神楽", "text": "イシュリールに対する愛は"},
        { "location": "1851/TALK"    , "narrator": "神楽", "text": "$handle$への愛とは違うものだから"},
        { "location": "1852/TALK"    , "narrator": "神楽", "text": "やきもち妬かないで"},
        { "location": "1854/SEL"     , "narrator": "", "text": "そんなことしないし！"},
        { "location": "1855/SEL"     , "narrator": "", "text": "態度に出ちゃうかも…"},
        { "location": "1856/SEL"     , "narrator": "", "text": "一緒に愛を注ぐよ"},
        { "location": "1857/ACT"     , "narrator": "", "text": "そんなことしないし！"},
        { "location": "1858/TALK"    , "narrator": "神楽", "text": "ならいいんだけど？"},
        { "location": "1860/TALK"    , "narrator": "神楽", "text": "本当かな？？？"},
        { "location": "1861/ACT"     , "narrator": "", "text": "態度に出ちゃうかも…"},
        { "location": "1862/TALK"    , "narrator": "神楽", "text": "それでもいいのよ？"},
        { "location": "1864/TALK"    , "narrator": "神楽", "text": "かわいいね$handle$♪"},
        { "location": "1865/ACT"     , "narrator": "", "text": "一緒に愛を注ぐよ"},
        { "location": "1866/TALK"    , "narrator": "神楽", "text": "ﾔﾀﾞｽﾃｷ、、、"},
        { "location": "1869/TALK"    , "narrator": "神楽", "text": "そうじゃなきゃ"},
        { "location": "1870/TALK"    , "narrator": "神楽", "text": "ぴょんこ自身がダメになるから"},
        { "location": "1871/TALK"    , "narrator": "神楽", "text": "自分を許せなくなるから"},
        { "location": "1873/SEL"     , "narrator": "", "text": "真面目だよね…"},
        { "location": "1874/SEL"     , "narrator": "", "text": "そういうものかも"},
        { "location": "1875/SEL"     , "narrator": "", "text": "もっと肩の力抜いてもいいのに"},
        { "location": "1876/ACT"     , "narrator": "", "text": "真面目だよね…"},
        { "location": "1877/TALK"    , "narrator": "神楽", "text": "創作には真摯に向き合いたいから"},
        { "location": "1878/TALK"    , "narrator": "神楽", "text": "そうじゃなきゃ"},
        { "location": "1879/TALK"    , "narrator": "神楽", "text": "創作の意味がない"},
        { "location": "1880/ACT"     , "narrator": "", "text": "そういうものかも"},
        { "location": "1881/TALK"    , "narrator": "神楽", "text": "人によって違うのかもね"},
        { "location": "1882/TALK"    , "narrator": "神楽", "text": "そういう感覚"},
        { "location": "1883/ACT"     , "narrator": "", "text": "もっと肩の力抜いてもいいのに"},
        { "location": "1884/TALK"    , "narrator": "神楽", "text": "大人な意見"},
        { "location": "1885/TALK"    , "narrator": "神楽", "text": "それともいい加減なの？"},
        { "location": "1886/TALK"    , "narrator": "神楽", "text": "むつかしいね"},
        { "location": "1888/TALK"    , "narrator": "神楽", "text": "今のぴょんこには"},
        { "location": "1890/TALK"    , "narrator": "神楽", "text": "降り注ぐ全ての不幸を振り払って"},
        { "location": "1891/TALK"    , "narrator": "神楽", "text": "満身創痍になっても"},
        { "location": "1892/TALK"    , "narrator": "神楽", "text": "絶対にハッピーエンドにする"},
        { "location": "1893/TALK"    , "narrator": "神楽", "text": "だから聞いてね"},
        { "location": "1894/TALK"    , "narrator": "神楽", "text": "続きの話を"}
    ]
}
