        "title": "012 ココロスフィアストーリー【Lv04】",
        "sub_title": "姉妹の隔絶Ⅱ＜帰結＞"
    },
    "entry":
    [
        { "location": "62/SCENARIO", "narrator": "", "text": "姉妹の隔絶・後編２"},
        { "location": "71/TALK"    , "narrator": "表層アーヤ", "text": "どうして……？\nなぜそこまで…"},
        { "location": "73/TALK"    , "narrator": "潜在アーヤ", "text": "もうそれくらいに\n嫌気がさしてるって\nことよ。"},
        { "location": "74/TALK"    , "narrator": "潜在アーヤ", "text": "$handle$さんも\n同意してるから\n力を貸してくれてる。"},
        { "location": "75/TALK"    , "narrator": "表層アーヤ", "text": "同意…ね。\nちょっと卑怯なんじゃ\nないかしら？"},
        { "location": "76/TALK"    , "narrator": "潜在アーヤ", "text": "…何が？"},
        { "location": "77/TALK"    , "narrator": "表層アーヤ", "text": "姉と私たちの関係\n伝えてはいたけど、\n全部じゃないわよね。"},
        { "location": "78/TALK"    , "narrator": "表層アーヤ", "text": "貴方が今伝えてある\nは、前提程度でしか\nない。"},
        { "location": "79/TALK"    , "narrator": "表層アーヤ", "text": "私たちが本当に姉に\n裏切られたと思ってる\n所は話してない。"},
        { "location": "80/TALK"    , "narrator": "潜在アーヤ", "text": "話したところで\n変わらないわよ。"},
        { "location": "81/TALK"    , "narrator": "表層アーヤ", "text": "どうかしら。"},
        { "location": "82/TALK"    , "narrator": "表層アーヤ", "text": "まあいいわ。\n私はもうここに存在\nすることはできない。"},
        { "location": "83/TALK"    , "narrator": "表層アーヤ", "text": "これ以上貴方と\nやりあうことは\nできないけど――"},
        { "location": "85/TALK"    , "narrator": "表層アーヤ", "text": "もし$handle$に\n良心があれば代わりに\n問い詰めるでしょう。"},
        { "location": "86/TALK"    , "narrator": "潜在アーヤ", "text": "…っ。"},
        { "location": "88/TALK"    , "narrator": "表層アーヤ", "text": "それじゃグッド\nラック。私とは\n息が合わない私さん。"},
        { "location": "98/TALK"    , "narrator": "潜在アーヤ", "text": "……。"},
        { "location": "107/SEL"    , "narrator": "（選択肢）", "text": "で、どういうこと？"},
        { "location": "108/SEL"    , "narrator": "（選択肢）", "text": "何も言わなくていいよ"},
        { "location": "109/ACT"    , "narrator": "", "text": "で、どういうこと？"},
        { "location": "110/TALK"   , "narrator": "潜在アーヤ", "text": "はぁ、わかったわよ。\n教える。"},
        { "location": "111/ACT"    , "narrator": "", "text": "何も言わなくていいよ"},
        { "location": "113/TALK"   , "narrator": "潜在アーヤ", "text": "ふふ、ありがと。\n貴方は優しいのね。"},
        { "location": "114/TALK"   , "narrator": "潜在アーヤ", "text": "でも、本当に重要だと\n思う時は、ちゃんと\n言っていいのよ？"},
        { "location": "116/TALK"   , "narrator": "潜在アーヤ", "text": "私自身も、フェアじゃ\nなかったってちょっと\n反省してるし。"},
        { "location": "120/TALK"   , "narrator": "潜在アーヤ", "text": "一つ前のレベル０３で\nしたお話には、続きが\nあるのよ。"},
        { "location": "121/TALK"   , "narrator": "潜在アーヤ", "text": "今からそれを\n話すわ。"},
        { "location": "136/DIALOG" , "narrator": "", "text": "高校も３年になり、\n私も進路を考えなければ\nならない時期が来た。"},
        { "location": "137/DIALOG" , "narrator": "", "text": "当時、剣道の全国大会で優勝し、\n世界選手権ジュニア部門の\n最有力候補になっていた私は\n東京や大阪といった所にある\n幾つかの大学から\nオファーがかかっていたの。"},
        { "location": "138/DIALOG" , "narrator": "", "text": "家のことは心配だったけど\n姉も実家に隠っていたし、\n大学くらいは\n遠いところで一人暮らししても\n大丈夫だろう、なんて思っていた。"},
        { "location": "139/DIALOG" , "narrator": "", "text": "けど――"},
        { "location": "142/TALK"   , "narrator": "高校生アーヤ", "text": "あれ？"},
        { "location": "143/TALK"   , "narrator": "高校生アーヤ", "text": "お姉ちゃんは？"},
        { "location": "145/DIALOG" , "narrator": "", "text": "ある日、高校から帰ると\n姉はいなかった。\n\n姉の部屋の荷物も\n全部無くなっていた。"},
        { "location": "146/DIALOG" , "narrator": "", "text": "母が言うには、\n『すごい研究所から\nオファーがかかったから\nフランスへ行く』\nって――"},
        { "location": "148/TALK"   , "narrator": "高校生アーヤ", "text": "……なにそれ。"},
        { "location": "149/TALK"   , "narrator": "高校生アーヤ", "text": "最低…"},
        { "location": "150/TALK"   , "narrator": "高校生アーヤ", "text": "……最低よ…　…"},
        { "location": "151/DIALOG" , "narrator": "", "text": "私、そんなこと\n一言も\n教えてもらってないよ――"},
        { "location": "154/DIALOG" , "narrator": "", "text": "バカ姉。"},
        { "location": "173/DIALOG" , "narrator": "", "text": "その後私は\n何日もかけて考えて、\n結果として\n長野に残ることにした。"},
        { "location": "174/DIALOG" , "narrator": "", "text": "ずっと信州の山中に住んでいた私は、\nやはり年頃ってこともあって、\n東京の大学に行けることを\n内心凄くわくわくしてたんだけどね。"},
        { "location": "176/SEL"    , "narrator": "（選択肢）", "text": "そこまでしなくても良かったのでは？"},
        { "location": "177/SEL"    , "narrator": "（選択肢）", "text": "大変だったんだね。"},
        { "location": "178/ACT"    , "narrator": "", "text": "そこまでしなくても良かったのでは？"},
        { "location": "182/TALK"   , "narrator": "アーヤ", "text": "そうね。\nまあ普通の家なら\nそうかもしれない。"},
        { "location": "183/TALK"   , "narrator": "アーヤ", "text": "でもうちは両親ともに\n高齢で、結構仕事も\nハードだったし――"},
        { "location": "184/ACT"    , "narrator": "", "text": "大変だったんだね。"},
        { "location": "188/TALK"   , "narrator": "アーヤ", "text": "ありがと。\nあの時は本当に、精神\n的に大変だったわ。"},
        { "location": "189/TALK"   , "narrator": "アーヤ", "text": "うちは両親ともに\n高齢で、結構仕事も\nハードだったし――"},
        { "location": "191/TALK"   , "narrator": "アーヤ", "text": "家も山の上にあるから\n私も姉もいない状態で\n生きていけるか心配で。"},
        { "location": "193/TALK"   , "narrator": "アーヤ", "text": "……。"},
        { "location": "210/TALK"   , "narrator": "アーヤ", "text": "とまあ、\nこんな経緯よ。"},
        { "location": "211/TALK"   , "narrator": "アーヤ", "text": "これでだいたい、\n全部お話した。"},
        { "location": "212/SEL"    , "narrator": "（選択肢）", "text": "東京行きを断念したのが辛かったんだね。"},
        { "location": "213/SEL"    , "narrator": "（選択肢）", "text": "お姉さんが何も言わずに行ってしまったのが辛かったんだね。"},
        { "location": "214/ACT"    , "narrator": "", "text": "東京行きを断念したのが辛かったんだね。"},
        { "location": "215/TALK"   , "narrator": "アーヤ", "text": "そうね。"},
        { "location": "216/TALK"   , "narrator": "アーヤ", "text": "なんで姉ばっかり自由\nに生きて、私ばかり…\nって思ってた。"},
        { "location": "217/TALK"   , "narrator": "アーヤ", "text": "でもそれは、\n私が自分で決めて\nやってることだもの。"},
        { "location": "218/SEL"    , "narrator": "（選択肢）", "text": "責任感あるんだね"},
        { "location": "219/ACT"    , "narrator": "", "text": "責任感あるんだね"},
        { "location": "221/TALK"   , "narrator": "アーヤ", "text": "どうかしらね。"},
        { "location": "222/TALK"   , "narrator": "アーヤ", "text": "何だかんだで、\n事情はあれ、結局\n今は東京にいるし。"},
        { "location": "223/TALK"   , "narrator": "アーヤ", "text": "案外\nチャランポランよ？"},
        { "location": "224/ACT"    , "narrator": "", "text": "お姉さんが何も言わずに行ってしまったのが辛かったんだね。"},
        { "location": "225/TALK"   , "narrator": "アーヤ", "text": "それはない！"},
        { "location": "226/TALK"   , "narrator": "アーヤ", "text": "寧ろいなくなって\n胸をなで下ろしたわ。"},
        { "location": "227/SEL"    , "narrator": "（選択肢）", "text": "じゃあなんで、いなくなったとき泣いてたの？"},
        { "location": "228/ACT"    , "narrator": "", "text": "じゃあなんで、いなくなったとき泣いてたの？"},
        { "location": "231/TALK"   , "narrator": "アーヤ", "text": "え！？"},
        { "location": "232/TALK"   , "narrator": "アーヤ", "text": "あれは…"},
        { "location": "233/TALK"   , "narrator": "アーヤ", "text": "……。"},
        { "location": "234/TALK"   , "narrator": "アーヤ", "text": "…あまりに腹が立って\n泣けてきちゃっただけ。"},
        { "location": "236/TALK"   , "narrator": "アーヤ", "text": "さあ、この話は\nもうおしまい！"},
        { "location": "237/TALK"   , "narrator": "アーヤ", "text": "とにかく私は\nもうそんな過去のこと\n引きずりたくないの。"},
        { "location": "238/TALK"   , "narrator": "アーヤ", "text": "それより今は、\n姉と話して事情を\n聞きたい。"},
        { "location": "239/TALK"   , "narrator": "アーヤ", "text": "いろんなことを\n全部――"},
        { "location": "240/TALK"   , "narrator": "アーヤ", "text": "だから反対派が弱まっ\nて、現実の私が軟化す\nるまで戦い続けるわ。"},
        { "location": "241/TALK"   , "narrator": "アーヤ", "text": "だから、これからも\nよろしくね。"},
        { "location": "243/TALK"   , "narrator": "アーヤ", "text": "それじゃ、\nまた逢えるのを\n楽しみにしてるわ。"},
        { "location": "252/SEL"    , "narrator": "（選択肢）", "text": "ちょっと待った！"},
        { "location": "253/ACT"    , "narrator": "", "text": "ちょっと待った！"},
        { "location": "264/TALK"   , "narrator": "アーヤ", "text": "え？？"},
        { "location": "265/SEL"    , "narrator": "（選択肢）", "text": "デートは！？"},
        { "location": "266/ACT"    , "narrator": "", "text": "デートは！？"},
        { "location": "268/TALK"   , "narrator": "アーヤ", "text": "すごい！\nよく覚えてたわね。"},
        { "location": "269/TALK"   , "narrator": "アーヤ", "text": "そうね。\n約束だものね。"},
        { "location": "270/TALK"   , "narrator": "アーヤ", "text": "それじゃ、\nどこへ行こうか？"},
        { "location": "271/SEL"    , "narrator": "（選択肢）", "text": "海"},
        { "location": "272/SEL"    , "narrator": "（選択肢）", "text": "カフェ"},
        { "location": "273/SEL"    , "narrator": "（選択肢）", "text": "エヴェレット脳科学研究所"},
        { "location": "274/ACT"    , "narrator": "", "text": "海"},
        { "location": "276/TALK"   , "narrator": "アーヤ", "text": "はいはい、海ね。\n何を期待してるの？"},
        { "location": "278/TALK"   , "narrator": "アーヤ", "text": "服はこのままよ？"},
        { "location": "284/ACT"    , "narrator": "", "text": "カフェ"},
        { "location": "285/TALK"   , "narrator": "アーヤ", "text": "カフェ？\nいいわね。"},
        { "location": "291/ACT"    , "narrator": "", "text": "エヴェレット脳科学研究所"},
        { "location": "292/TALK"   , "narrator": "アーヤ", "text": "は？\nなにそれ。"},
        { "location": "294/TALK"   , "narrator": "アーヤ", "text": "そんな所\n知らない。"},
        { "location": "295/SEL"    , "narrator": "（選択肢）", "text": "え？　でも選択肢に…"},
        { "location": "296/SEL"    , "narrator": "（選択肢）", "text": "いや、本当は知ってるんでしょ？"},
        { "location": "297/ACT"    , "narrator": "", "text": "え？　でも選択肢に…"},
        { "location": "298/ACT"    , "narrator": "", "text": "いや、本当は知ってるんでしょ？"},
        { "location": "300/TALK"   , "narrator": "アーヤ", "text": "知らないって\n言ってるでしょ！！"},
        { "location": "301/TALK"   , "narrator": "アーヤ", "text": "もういい。\n気が変わった。\n今日はもうお終いよ。"},
        { "location": "302/TALK"   , "narrator": "アーヤ", "text": "じゃね。"},
        { "location": "309/TALK"   , "narrator": "アーヤ", "text": "ココロの中って\n便利よね。"},
        { "location": "310/TALK"   , "narrator": "アーヤ", "text": "妄想だけで、どこに\nでも行けちゃう。"},
        { "location": "311/SEL"    , "narrator": "（選択肢）", "text": "来て終わり？"},
        { "location": "312/ACT"    , "narrator": "", "text": "来て終わり？"},
        { "location": "314/TALK"   , "narrator": "アーヤ", "text": "え？"},
        { "location": "315/TALK"   , "narrator": "アーヤ", "text": "うーん、そうね…"},
        { "location": "316/TALK"   , "narrator": "アーヤ", "text": "じゃあ、\nちょっとだけなら\n触っていいわよ？"},
        { "location": "322/DIALOG" , "narrator": "", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "387/TALK"   , "narrator": "アーヤ", "text": "ふふっ。"},
        { "location": "389/TALK"   , "narrator": "アーヤ", "text": "ちょっと\n不思議な気分。"},
        { "location": "396/TALK"   , "narrator": "アーヤ", "text": "きゃっ！？"},
        { "location": "398/TALK"   , "narrator": "アーヤ", "text": "ちょ、ちょっと\n痛いってば！"},
        { "location": "405/TALK"   , "narrator": "アーヤ", "text": "もうっ。\n調子に乗らないの。"},
        { "location": "407/TALK"   , "narrator": "アーヤ", "text": "ダメだって！"},
        { "location": "415/TALK"   , "narrator": "アーヤ", "text": "もうっ！\nくすぐったいってば。"},
        { "location": "417/TALK"   , "narrator": "アーヤ", "text": "もしかして\nおなか出てる？"},
        { "location": "425/TALK"   , "narrator": "アーヤ", "text": "ふわっ！"},
        { "location": "427/TALK"   , "narrator": "アーヤ", "text": "なんか\n不思議な気持ち。"},
        { "location": "433/DIALOG" , "narrator": "", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"},
        { "location": "437/TALK"   , "narrator": "アーヤ", "text": "はい、おしまい。"},
        { "location": "438/SEL"    , "narrator": "（選択肢）", "text": "満足。"},
        { "location": "439/SEL"    , "narrator": "（選択肢）", "text": "もっと！"},
        { "location": "440/ACT"    , "narrator": "", "text": "満足。"},
        { "location": "441/TALK"   , "narrator": "アーヤ", "text": "はいはい。\n良かったわね。"},
        { "location": "442/ACT"    , "narrator": "", "text": "もっと！"},
        { "location": "443/TALK"   , "narrator": "アーヤ", "text": "もうお終い。\nね？"},
        { "location": "444/SEL"    , "narrator": "（選択肢）", "text": "…はい。"},
        { "location": "445/ACT"    , "narrator": "", "text": "…はい。"},
        { "location": "449/TALK"   , "narrator": "アーヤ", "text": "ふふっ。\n言うこと聞けて\nおりこうさんね。"},
        { "location": "465/TALK"   , "narrator": "アーヤ", "text": "と、ちょっとした\nお遊びでした。"},
        { "location": "467/TALK"   , "narrator": "アーヤ", "text": "といっても\nココロの中じゃ\n実感ないわよね。"},
        { "location": "468/SEL"    , "narrator": "（選択肢）", "text": "確かに！"},
        { "location": "469/SEL"    , "narrator": "（選択肢）", "text": "そんなことないよ！"},
        { "location": "470/ACT"    , "narrator": "", "text": "確かに！"},
        { "location": "471/TALK"   , "narrator": "アーヤ", "text": "正直でよろしい。"},
        { "location": "472/ACT"    , "narrator": "", "text": "そんなことないよ！"},
        { "location": "474/TALK"   , "narrator": "アーヤ", "text": "本当に？"},
        { "location": "477/TALK"   , "narrator": "アーヤ", "text": "でも、もう現実の\n私とスキンシップ\nできるような――"},
        { "location": "478/TALK"   , "narrator": "アーヤ", "text": "システムがある\nはずなんだけどね。"},
        { "location": "479/TALK"   , "narrator": "アーヤ", "text": "私の姉が\n作ってた気が――"},
        { "location": "481/TALK"   , "narrator": "アーヤ", "text": "…って、なんで私、\nそんなこと\n知ってるのかしら…。"}
    ]
}
