    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "010_堂々たる甘ったれ"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "いつでも"},
        { "location": "33/TALK"   , "narrator": "みやび", "text": "甘えてええきね"},
        { "location": "34/TALK"   , "narrator": "みやび", "text": "さあどんとこい！"},
        { "location": "36/SEL"    , "narrator": "", "text": "ママー！！"},
        { "location": "37/SEL"    , "narrator": "", "text": "みやびさーん"},
        { "location": "38/SEL"    , "narrator": "", "text": "むしろ$me$が甘やかしたい"},
        { "location": "39/TALK"   , "narrator": "みやび", "text": "真綿で締めるような包容力で受け止めちゃろう"},
        { "location": "43/ACT"    , "narrator": "", "text": "ママー！！"},
        { "location": "44/TALK"   , "narrator": "みやび", "text": "ママではない！"},
        { "location": "45/TALK"   , "narrator": "みやび", "text": "お母さんだ！"},
        { "location": "46/ACT"    , "narrator": "", "text": "みやびさーん"},
        { "location": "47/TALK"   , "narrator": "みやび", "text": "あ"},
        { "location": "48/TALK"   , "narrator": "みやび", "text": "やっぱ中止"},
        { "location": "49/ACT"    , "narrator": "", "text": "むしろ$me$が甘やかしたい"},
        { "location": "51/TALK"   , "narrator": "みやび", "text": "一丁前の口を"},
        { "location": "52/TALK"   , "narrator": "みやび", "text": "$handle$のくせに生意気だな"},
        { "location": "53/TALK"   , "narrator": "みやび", "text": "ふははははははははは！！"},
        { "location": "55/TALK"   , "narrator": "みやび", "text": "いかんいかん"},
        { "location": "56/TALK"   , "narrator": "みやび", "text": "いかんぞね"},
        { "location": "57/TALK"   , "narrator": "みやび", "text": "そういう話ではないがで"},
        { "location": "58/TALK"   , "narrator": "みやび", "text": "どうもトライナリーというところは甘えるのが下手な女子の巣窟になっておる気がしてならん"},
        { "location": "59/TALK"   , "narrator": "みやび", "text": "どう思う？"},
        { "location": "61/SEL"    , "narrator": "", "text": "ツンデレはいいものだ"},
        { "location": "62/SEL"    , "narrator": "", "text": "自立した女性ってことでは"},
        { "location": "63/SEL"    , "narrator": "", "text": "甘えん坊新人が入らなかった？"},
        { "location": "64/ACT"    , "narrator": "", "text": "ツンデレはいいものだ"},
        { "location": "65/TALK"   , "narrator": "みやび", "text": "確かに"},
        { "location": "66/TALK"   , "narrator": "みやび", "text": "その通り"},
        { "location": "67/TALK"   , "narrator": "みやび", "text": "しかし度を過ぎると"},
        { "location": "68/TALK"   , "narrator": "みやび", "text": "素晴らしい"},
        { "location": "71/TALK"   , "narrator": "みやび", "text": "ならいいか"},
        { "location": "72/ACT"    , "narrator": "", "text": "自立した女性ってことでは"},
        { "location": "74/TALK"   , "narrator": "みやび", "text": "なるほど"},
        { "location": "75/TALK"   , "narrator": "みやび", "text": "誉めるのがうまいのう"},
        { "location": "76/TALK"   , "narrator": "みやび", "text": "そのロジックを堂々たる甘ったれロジックと名付けよう"},
        { "location": "77/TALK"   , "narrator": "みやび", "text": "感謝せよ"},
        { "location": "78/ACT"    , "narrator": "", "text": "甘えん坊新人が入らなかった？"},
        { "location": "79/TALK"   , "narrator": "みやび", "text": "入ったぞね"},
        { "location": "80/TALK"   , "narrator": "みやび", "text": "確かに"},
        { "location": "81/TALK"   , "narrator": "みやび", "text": "これで流れが変わるかも"}
    ]
}
