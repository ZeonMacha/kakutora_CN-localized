        "title": "Extra004 ヒメゴトチャット",
        "sub_title": "ゆずジュースはとてもすなおで"
    },
    "entry":
    [
        { "location": "110/SCENARIO", "narrator": "", "text": "014_ゆずジュースはとてもすなおで"},
        { "location": "135/TALK"    , "narrator": "みやび", "text": "謎が謎を呼び"},
        { "location": "136/TALK"    , "narrator": "みやび", "text": "憶測が噂を拡大させる"},
        { "location": "137/TALK"    , "narrator": "みやび", "text": "即ちネットロアの成り立ちとは"},
        { "location": "138/TALK"    , "narrator": "みやび", "text": "疑問に対する独自見解と言えよう"},
        { "location": "141/SEL"     , "narrator": "", "text": "なんか難しい話？"},
        { "location": "142/SEL"     , "narrator": "", "text": "$me$がみやびを噂から守るよ"},
        { "location": "143/SEL"     , "narrator": "", "text": "噂になりたいってこと？"},
        { "location": "144/ACT"     , "narrator": "", "text": "なんか難しい話？"},
        { "location": "145/TALK"    , "narrator": "みやび", "text": "かもな"},
        { "location": "146/ACT"     , "narrator": "", "text": "$me$がみやびを噂から守るよ"},
        { "location": "148/TALK"    , "narrator": "みやび", "text": "ふむ"},
        { "location": "149/TALK"    , "narrator": "みやび", "text": "よい心がけ"},
        { "location": "151/TALK"    , "narrator": "みやび", "text": "誉めてつかわす"},
        { "location": "152/ACT"     , "narrator": "", "text": "噂になりたいってこと？"},
        { "location": "153/TALK"    , "narrator": "みやび", "text": "いや"},
        { "location": "156/TALK"    , "narrator": "みやび", "text": "そうかも？"},
        { "location": "158/TALK"    , "narrator": "みやび", "text": "例えば柚だ"},
        { "location": "159/TALK"    , "narrator": "みやび", "text": "柚は本来酸味が強く、飲料には向かない"},
        { "location": "160/TALK"    , "narrator": "みやび", "text": "しかし世間にはゆずジュースなるものが出回っている"},
        { "location": "161/SEL"     , "narrator": "", "text": "へー"},
        { "location": "162/SEL"     , "narrator": "", "text": "えっと…何の話？"},
        { "location": "163/SEL"     , "narrator": "", "text": "ゆずジュース最高！"},
        { "location": "165/TALK"    , "narrator": "みやび", "text": "これが何を意味するか？"},
        { "location": "169/ACT"     , "narrator": "", "text": "へー"},
        { "location": "170/TALK"    , "narrator": "みやび", "text": "適当な相槌だな"},
        { "location": "171/ACT"     , "narrator": "", "text": "えっと…何の話？"},
        { "location": "172/TALK"    , "narrator": "みやび", "text": "最後まで聞けばわかる"},
        { "location": "173/ACT"     , "narrator": "", "text": "ゆずジュース最高！"},
        { "location": "174/TALK"    , "narrator": "みやび", "text": "まあ"},
        { "location": "175/TALK"    , "narrator": "みやび", "text": "美味しいな"},
        { "location": "177/TALK"    , "narrator": "みやび", "text": "そのいち。人工的に甘味を加える。"},
        { "location": "178/TALK"    , "narrator": "みやび", "text": "そのに。柚の酸味を抑える。"},
        { "location": "179/TALK"    , "narrator": "みやび", "text": "そのさん。柚とゆずジュースは無関係。"},
        { "location": "181/SEL"     , "narrator": "", "text": "そのいちかな"},
        { "location": "182/SEL"     , "narrator": "", "text": "そのに…？"},
        { "location": "183/SEL"     , "narrator": "", "text": "そのさんでしょ！"},
        { "location": "184/ACT"     , "narrator": "", "text": "そのいちかな"},
        { "location": "185/TALK"    , "narrator": "みやび", "text": "その通り"},
        { "location": "186/TALK"    , "narrator": "みやび", "text": "砂糖やはちみつで甘味を足すと"},
        { "location": "187/TALK"    , "narrator": "みやび", "text": "おいしいゆずジュースのできあがり"},
        { "location": "188/ACT"     , "narrator": "", "text": "そのに…？"},
        { "location": "189/TALK"    , "narrator": "みやび", "text": "なかなか面白いことを言うが"},
        { "location": "190/TALK"    , "narrator": "みやび", "text": "そんな品種改良はされてないぞね"},
        { "location": "191/TALK"    , "narrator": "みやび", "text": "残念でした"},
        { "location": "192/ACT"     , "narrator": "", "text": "そのさんでしょ！"},
        { "location": "194/TALK"    , "narrator": "みやび", "text": "ほほう"},
        { "location": "195/TALK"    , "narrator": "みやび", "text": "これこそが独自見解"},
        { "location": "196/TALK"    , "narrator": "みやび", "text": "即ちネットロアの成り立ち"},
        { "location": "197/TALK"    , "narrator": "みやび", "text": "いいものを見たぞね"}
    ]
}
