        { "location": "7/SCENARIO", "narrator": "", "text": "640_そんなことは知ってるから"},
        { "location": "32/TALK"   , "narrator": "アーヤ", "text": "$handle$さんは"},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "私のこと好き？"},
        { "location": "35/SEL"    , "narrator": "", "text": "うん"},
        { "location": "36/SEL"    , "narrator": "", "text": "好きだよ"},
        { "location": "37/SEL"    , "narrator": "", "text": "アーヤは$me$のこと好き？"},
        { "location": "38/ACT"    , "narrator": "", "text": "うん"},
        { "location": "40/TALK"   , "narrator": "アーヤ", "text": "もう"},
        { "location": "41/TALK"   , "narrator": "アーヤ", "text": "ちゃんと言ってよ"},
        { "location": "42/ACT"    , "narrator": "", "text": "好きだよ"},
        { "location": "53/TALK"   , "narrator": "アーヤ", "text": "うん"},
        { "location": "54/TALK"   , "narrator": "アーヤ", "text": "知ってるわ"},
        { "location": "55/ACT"    , "narrator": "", "text": "アーヤは$me$のこと好き？"},
        { "location": "56/TALK"   , "narrator": "アーヤ", "text": "もちろんよ"},
        { "location": "58/TALK"   , "narrator": "アーヤ", "text": "そうじゃなきゃ"},
        { "location": "59/TALK"   , "narrator": "アーヤ", "text": "こんなこと聞かないわ"},
        { "location": "63/SEL"    , "narrator": "", "text": "何かあった？"},
        { "location": "64/SEL"    , "narrator": "", "text": "信用できない？"},
        { "location": "65/ACT"    , "narrator": "", "text": "何かあった？"},
        { "location": "66/TALK"   , "narrator": "アーヤ", "text": "え"},
        { "location": "67/TALK"   , "narrator": "アーヤ", "text": "どうして？"},
        { "location": "68/ACT"    , "narrator": "", "text": "信用できない？"},
        { "location": "69/TALK"   , "narrator": "アーヤ", "text": "そういうわけじゃ"},
        { "location": "70/TALK"   , "narrator": "アーヤ", "text": "ないけど"},
        { "location": "72/TALK"   , "narrator": "アーヤ", "text": "言葉にしてほしい時ってあるでしょ？"},
        { "location": "75/SEL"    , "narrator": "", "text": "それだけ？"},
        { "location": "76/SEL"    , "narrator": "", "text": "本当は他にあるんじゃない？"},
        { "location": "77/ACT"    , "narrator": "", "text": "それだけ？"},
        { "location": "78/TALK"   , "narrator": "アーヤ", "text": "それだけっていうか"},
        { "location": "79/ACT"    , "narrator": "", "text": "本当は他にあるんじゃない？"},
        { "location": "80/TALK"   , "narrator": "アーヤ", "text": "、、、"},
        { "location": "82/TALK"   , "narrator": "アーヤ", "text": "$handle$さんは"},
        { "location": "83/TALK"   , "narrator": "アーヤ", "text": "平気なの？"},
        { "location": "84/TALK"   , "narrator": "アーヤ", "text": "私とずっと"},
        { "location": "85/TALK"   , "narrator": "アーヤ", "text": "会えなくても"},
        { "location": "88/SEL"    , "narrator": "", "text": "まあね"},
        { "location": "89/SEL"    , "narrator": "", "text": "いやだけど"},
        { "location": "90/SEL"    , "narrator": "", "text": "どうにかなるよ"},
        { "location": "91/ACT"    , "narrator": "", "text": "まあね"},
        { "location": "92/TALK"   , "narrator": "アーヤ", "text": "そうなの"},
        { "location": "93/ACT"    , "narrator": "", "text": "いやだけど"},
        { "location": "94/TALK"   , "narrator": "アーヤ", "text": "けどって？"},
        { "location": "95/ACT"    , "narrator": "", "text": "どうにかなるよ"},
        { "location": "96/TALK"   , "narrator": "アーヤ", "text": "どうにかって、、、"},
        { "location": "98/TALK"   , "narrator": "アーヤ", "text": "私はちょっと"},
        { "location": "99/TALK"   , "narrator": "アーヤ", "text": "平気じゃないかも"},
        { "location": "100/TALK"  , "narrator": "アーヤ", "text": "友達にも"},
        { "location": "101/TALK"  , "narrator": "アーヤ", "text": "話せないし"},
        { "location": "102/TALK"  , "narrator": "アーヤ", "text": "こういうのって"},
        { "location": "104/SEL"   , "narrator": "", "text": "話していいよ"},
        { "location": "105/SEL"   , "narrator": "", "text": "話すもんなの？"},
        { "location": "106/ACT"   , "narrator": "", "text": "話していいよ"},
        { "location": "107/TALK"  , "narrator": "アーヤ", "text": "話せないわよ、、、"},
        { "location": "108/ACT"   , "narrator": "", "text": "話すもんなの？"},
        { "location": "109/TALK"  , "narrator": "アーヤ", "text": "話すものなの"},
        { "location": "111/TALK"  , "narrator": "アーヤ", "text": "遊びに行ったとか"},
        { "location": "112/TALK"  , "narrator": "アーヤ", "text": "写真撮ったとか"},
        { "location": "113/TALK"  , "narrator": "アーヤ", "text": "そういう話をするものなの"},
        { "location": "115/SEL"   , "narrator": "", "text": "自慢したいってこと？"},
        { "location": "116/SEL"   , "narrator": "", "text": "言いふらすもんじゃないと思うけど"},
        { "location": "117/ACT"   , "narrator": "", "text": "自慢したいってこと？"},
        { "location": "118/TALK"  , "narrator": "アーヤ", "text": "違うわ"},
        { "location": "119/ACT"   , "narrator": "", "text": "言いふらすもんじゃないと思うけど"},
        { "location": "120/TALK"  , "narrator": "アーヤ", "text": "言いふらしたいわけじゃなくて"},
        { "location": "122/TALK"  , "narrator": "アーヤ", "text": "貴方を好きなことが幸せなんだって"},
        { "location": "123/TALK"  , "narrator": "アーヤ", "text": "そう思いたいだけなの"},
        { "location": "125/SEL"   , "narrator": "", "text": "幸せじゃないみたいだね"},
        { "location": "126/SEL"   , "narrator": "", "text": "愛してるよアーヤ"},
        { "location": "127/SEL"   , "narrator": "", "text": "……ごめんね"},
        { "location": "128/ACT"   , "narrator": "", "text": "幸せじゃないみたいだね"},
        { "location": "129/TALK"  , "narrator": "アーヤ", "text": "、、、"},
        { "location": "130/ACT"   , "narrator": "", "text": "愛してるよアーヤ"},
        { "location": "133/TALK"  , "narrator": "アーヤ", "text": "ありがとう"},
        { "location": "135/TALK"  , "narrator": "アーヤ", "text": "私もよ"},
        { "location": "136/ACT"   , "narrator": "", "text": "……ごめんね"},
        { "location": "137/TALK"  , "narrator": "アーヤ", "text": "謝ってほしいわけじゃないの"},
        { "location": "140/TALK"  , "narrator": "アーヤ", "text": "私のこと好きなのよね？"},
        { "location": "141/TALK"  , "narrator": "アーヤ", "text": "それは信じてる"},
        { "location": "142/TALK"  , "narrator": "アーヤ", "text": "でも"},
        { "location": "145/TALK"  , "narrator": "アーヤ", "text": "そうね"},
        { "location": "146/TALK"  , "narrator": "アーヤ", "text": "信じていれば"},
        { "location": "147/TALK"  , "narrator": "アーヤ", "text": "それでいいじゃない"},
        { "location": "48/DIALOG" , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>1000pt.</b></color></size>\nアップしました！"}
