        { "location": "1009/TALK"   , "narrator": "エリカ", "text": "あっ、そうだ！\nこの機会に、にゃボットを\n育ててくれると嬉しいな！"},
        { "location": "1010/SEL"    , "narrator": "", "text": "お、おう"},
        { "location": "1011/SEL"    , "narrator": "", "text": "にゃボットの事なら任せろ！"},
        { "location": "1012/ACT"    , "narrator": "", "text": "お、おう"},
        { "location": "1013/ACT"    , "narrator": "", "text": "にゃボットの事なら任せろ！"},
        { "location": "1014/TALK"   , "narrator": "エリカ", "text": "えへへ。\n頼もしいなぁ。"},
        { "location": "1015/TALK"   , "narrator": "エリカ", "text": "あなたなら、素敵な\nにゃボットブリーダーに\nなれそうだね！"},
        { "location": "1018/TALK"   , "narrator": "エリカ", "text": "というわけで、\n早速だけど――"},
        { "location": "1026/TALK"   , "narrator": "エリカ", "text": "連載クラン\nにゃぼにゃすティー！を\nプレゼントします！"},
        { "location": "1027/TALK"   , "narrator": "エリカ", "text": "今回はゲームが\n出来なくなっちゃって\nごめんね？"},
        { "location": "1028/TALK"   , "narrator": "エリカ", "text": "あと、解説も。"},
        { "location": "1031/SEL"    , "narrator": "", "text": "残念！"},
        { "location": "1032/SEL"    , "narrator": "", "text": "解説してるときの夢中なエリカが好き"},
        { "location": "1033/SEL"    , "narrator": "", "text": "いや、それは結構です"},
        { "location": "1034/ACT"    , "narrator": "", "text": "残念！"},
        { "location": "1035/TALK"   , "narrator": "エリカ", "text": "うわぁ、ごめんね！\n今度はちゃんとするから！"},
        { "location": "1036/ACT"    , "narrator": "", "text": "解説してるときの夢中なエリカが好き"},
        { "location": "1038/TALK"   , "narrator": "エリカ", "text": "ええっ！"},
        { "location": "1039/TALK"   , "narrator": "エリカ", "text": "別にいつものわたしと\n何も変わらないよぅ……。"},
        { "location": "1040/TALK"   , "narrator": "エリカ", "text": "でも、そう言って\nもらえると嬉しいかな。"},
