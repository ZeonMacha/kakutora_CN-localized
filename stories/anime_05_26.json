        { "location": "791/TALK"    , "narrator": "つばめ", "text": "わたしも愛してます、だって夫婦だもんヾ(*´ｴ`*)ﾉ ｲｯﾁｬｯﾀ"},
        { "location": "793/TALK"    , "narrator": "つばめ", "text": "わたしも$handle$さんのことが大好きですヾ(*´ｴ`*)ﾉ ｲｯﾁｬｯﾀ"},
        { "location": "795/TALK"    , "narrator": "つばめ", "text": "わたしも$handle$さんが好きだょ～～"},
        { "location": "797/TALK"    , "narrator": "つばめ", "text": "ありがとぅ～～～"},
        { "location": "799/ACT"     , "narrator": "", "text": "アーヤ、愛してるよ"},
        { "location": "801/TALK"    , "narrator": "アーヤ", "text": "私もよ？愛しの$handle$さん(*^^*)"},
        { "location": "803/TALK"    , "narrator": "アーヤ", "text": "私も愛してる。ずっと愛してるから"},
        { "location": "805/TALK"    , "narrator": "アーヤ", "text": "愛してるは言い過ぎじゃない？私も好きよ？"},
        { "location": "807/TALK"    , "narrator": "アーヤ", "text": "ありがと"},
        { "location": "809/ACT"     , "narrator": "", "text": "ガブリエラ、愛してるよ"},
        { "location": "811/TALK"    , "narrator": "ガブリエラ", "text": "私だって、$marzanna$だけなのよ？愛してるvvv"},
        { "location": "813/TALK"    , "narrator": "ガブリエラ", "text": "あああいしてるから、私も"},
        { "location": "815/TALK"    , "narrator": "ガブリエラ", "text": "普通に好きじゃダメなのかしら？？"},
        { "location": "817/TALK"    , "narrator": "ガブリエラ", "text": "ちょっと、唐突に何を言い出すのかしら？"},
        { "location": "819/ACT"     , "narrator": "", "text": "みやび、愛してるよ"},
        { "location": "821/TALK"    , "narrator": "みやび", "text": "うちの連れが羞恥心ゼロな件。いや、最後やしえいか。うちも愛してる"},
        { "location": "823/TALK"    , "narrator": "みやび", "text": "うむ、うちも好いちゅうよ"},
        { "location": "825/TALK"    , "narrator": "みやび", "text": "友情と愛は両立可能か、そこが問題であるな"},
        { "location": "827/TALK"    , "narrator": "みやび", "text": "新手の冗談か？"},
        { "location": "829/ACT"     , "narrator": "", "text": "神楽、愛してるよ"},
        { "location": "831/TALK"    , "narrator": "神楽", "text": "逢いたい逢いたい逢いたい～～～～～～$handlek$ｽｷ～～～愛してる～～～"},
        { "location": "833/TALK"    , "narrator": "神楽", "text": "ぴょんこも愛してる～～～～～ちゅっちゅっ♪"},
        { "location": "835/TALK"    , "narrator": "神楽", "text": "これからも素敵なお友達でいてくださいねっ♪"},
