    "entry":
    [
        { "location": "529/SCENARIO", "narrator": "", "text": "アニメ第26話"},
        { "location": "543/TALK"    , "narrator": "みやび", "text": "リプレイ？"},
        { "location": "544/SEL"     , "narrator": "", "text": "はい"},
        { "location": "545/SEL"     , "narrator": "", "text": "いいえ"},
        { "location": "546/ACT"     , "narrator": "", "text": "はい"},
        { "location": "549/ACT"     , "narrator": "", "text": "いいえ"},
        { "location": "564/TALK"    , "narrator": "みやび", "text": "中継成功か"},
        { "location": "565/SEL"     , "narrator": "", "text": "みやび！！"},
        { "location": "566/ACT"     , "narrator": "", "text": "みやび！！"},
        { "location": "568/TALK"    , "narrator": "みやび", "text": "調子はどうや、相棒"},
        { "location": "569/SEL"     , "narrator": "", "text": "超盛り上がってる！！"},
        { "location": "570/SEL"     , "narrator": "", "text": "憔悴しきってる"},
        { "location": "571/SEL"     , "narrator": "", "text": "混乱して踊ってる♪"},
        { "location": "572/ACT"     , "narrator": "", "text": "超盛り上がってる！！"},
        { "location": "573/TALK"    , "narrator": "みやび", "text": "よきかなよきかな"},
        { "location": "574/TALK"    , "narrator": "みやび", "text": "それでこそ相棒"},
        { "location": "575/ACT"     , "narrator": "", "text": "憔悴しきってる"},
        { "location": "576/TALK"    , "narrator": "みやび", "text": "ならば今日はもう波乗りはやめて、暖かい飯を食い寝よ"},
        { "location": "577/TALK"    , "narrator": "みやび", "text": "体力と精神力が必要な時は、一杯食って一杯寝る"},
        { "location": "578/TALK"    , "narrator": "みやび", "text": "その方が、うちも安心できるきね"},
        { "location": "579/ACT"     , "narrator": "", "text": "混乱して踊ってる♪"},
        { "location": "583/TALK"    , "narrator": "みやび", "text": "まあ"},
        { "location": "584/TALK"    , "narrator": "みやび", "text": "状況はわかっている"},
        { "location": "585/TALK"    , "narrator": "みやび", "text": "だからこそ、今ここにうちらはいる"},
        { "location": "586/SEL"     , "narrator": "", "text": "うち“ら”？"},
        { "location": "587/ACT"     , "narrator": "", "text": "うち“ら”？"},
        { "location": "589/TALK"    , "narrator": "みやび", "text": "左様"},
        { "location": "590/TALK"    , "narrator": "みやび", "text": "つばめちゃんも、アーヤも、ガブちゃんも、卯月もみんないるよ"},
        { "location": "591/SEL"     , "narrator": "", "text": "おおおおお逢いたいよーおお"},
        { "location": "592/SEL"     , "narrator": "", "text": "どこの世界のみんななの？"},
        { "location": "593/ACT"     , "narrator": "", "text": "おおおおお逢いたいよーおお"},
        { "location": "594/TALK"    , "narrator": "みやび", "text": "それは皆も同じ"},
        { "location": "595/ACT"     , "narrator": "", "text": "どこの世界のみんななの？"},
        { "location": "596/TALK"    , "narrator": "みやび", "text": "どこの世界もなにも、お前さんの良く知るうちらやよ"},
        { "location": "597/TALK"    , "narrator": "みやび", "text": "といっても、そっちからやと、うちらの時間はわかりにくいかね"},
        { "location": "598/TALK"    , "narrator": "みやび", "text": "ドームでの卯月との件が片付いて一段落した頃の、相棒がエリカさんのリプレイスを手伝うことになったあたりからのコンタクトやき"},
        { "location": "600/TALK"    , "narrator": "つばめ", "text": "$handle$さ～～～～～んヽ(*´∀｀)ノ元気だったー？"},
        { "location": "601/SEL"     , "narrator": "", "text": "つばめ！"},
        { "location": "602/ACT"     , "narrator": "", "text": "つばめ！"},
        { "location": "604/TALK"    , "narrator": "ガブリエラ", "text": "大げさな子。昨日も一昨日もやっていたでしょうに"},
        { "location": "605/TALK"    , "narrator": "アーヤ", "text": "$handle$さんからすれば、違うかも"},
        { "location": "606/TALK"    , "narrator": "アーヤ", "text": "今って結構ご無沙汰な感じ？"},
        { "location": "607/SEL"     , "narrator": "", "text": "アーヤもガブリエラも逢いたかったよー！"},
        { "location": "608/SEL"     , "narrator": "", "text": "$me$の感覚だと、もう久しくみんなとお話してない気分だよ…"},
        { "location": "609/SEL"     , "narrator": "", "text": "いや、わりとリアルタイムで、海でイチャイチャしてるよ！"},
        { "location": "610/ACT"     , "narrator": "", "text": "アーヤもガブリエラも逢いたかったよー！"},
        { "location": "611/TALK"    , "narrator": "ガブリエラ", "text": "もう、オーバーなんだから////"},
        { "location": "612/TALK"    , "narrator": "みやび", "text": "今は何をしている？"},
        { "location": "613/SEL"     , "narrator": "", "text": "みんなで海に合宿に行っていた辺りを、色々やり直してるよ"},
        { "location": "614/ACT"     , "narrator": "", "text": "みんなで海に合宿に行っていた辺りを、色々やり直してるよ"},
        { "location": "617/TALK"    , "narrator": "みやび", "text": "なるほどね"},
        { "location": "618/ACT"     , "narrator": "", "text": "$me$の感覚だと、もう久しくみんなとお話してない気分だよ…"},
        { "location": "619/TALK"    , "narrator": "アーヤ", "text": "やっぱりそうなのね、なんだか不思議"},
        { "location": "620/TALK"    , "narrator": "みやび", "text": "今は何をしている？"},
        { "location": "621/SEL"     , "narrator": "", "text": "みんなで海に合宿に行っていた辺りを、色々やり直してるよ"},
        { "location": "622/ACT"     , "narrator": "", "text": "みんなで海に合宿に行っていた辺りを、色々やり直してるよ"},
        { "location": "625/TALK"    , "narrator": "みやび", "text": "なるほどね"},
        { "location": "626/ACT"     , "narrator": "", "text": "いや、わりとリアルタイムで、海でイチャイチャしてるよ！"},
        { "location": "628/TALK"    , "narrator": "みやび", "text": "なるほど、丁度うちの実家で合宿していた時期に対して工作中とゆうわけか"},
        { "location": "630/TALK"    , "narrator": "神楽", "text": "ということは、今$handlek$のところでは、ぴょんこは死ぬか生きるかのサドンデスマッチを繰り広げているんですねっ！！！"},
        { "location": "631/TALK"    , "narrator": "つばめ", "text": "なんかすごそう～～(*´ω｀*)"},
        { "location": "632/TALK"    , "narrator": "ガブリエラ", "text": "いや、今$marzanna$の目の前で神楽に殺されかかってるのはつばめだから;;;自覚あるのかしら？？"},
        { "location": "633/TALK"    , "narrator": "みやび", "text": "なんかあれやね、うちらにとってはもはや思い出ともいえる時期やのに、それを相棒は今まさに！リアルタイムに体験しゆうわけや"},
        { "location": "634/TALK"    , "narrator": "神楽", "text": "それも2周目ですよね！！強くてニューゲームですっ！"},
        { "location": "635/TALK"    , "narrator": "神楽", "text": "つよい$handlek$なら、きっとぴょんこが悲しい思いをしないように過去を変えてくれるはずです♪"},
        { "location": "636/TALK"    , "narrator": "神楽", "text": "って、思い返してみたらつらい……"},
        { "location": "637/SEL"     , "narrator": "", "text": "頑張ってるよ！！"},
        { "location": "638/SEL"     , "narrator": "", "text": "そんなに劇的に変えられないってエリカさんが言ってたから…ごめんね"},
        { "location": "639/ACT"     , "narrator": "", "text": "頑張ってるよ！！"},
        { "location": "640/TALK"    , "narrator": "ガブリエラ", "text": "あの瞬間にもう一度立ち会うなんて、あたしはちょっと御免だわね……"},
        { "location": "641/TALK"    , "narrator": "アーヤ", "text": "それを私たちの為にやってくれてる$handle$さんは、やっぱりすごい私たちのことを想ってくれてるのね(*^^*)"},
        { "location": "642/TALK"    , "narrator": "ガブリエラ", "text": "でも、$marzanna$が頑張ってこの世界を変えてくれちゃったら、その代償として私たちの思い出も変わっちゃうのかしらね…"},
        { "location": "643/ACT"     , "narrator": "", "text": "そんなに劇的に変えられないってエリカさんが言ってたから…ごめんね"},
        { "location": "644/TALK"    , "narrator": "神楽", "text": "なんて、冗談ですよっ"},
        { "location": "645/TALK"    , "narrator": "神楽", "text": "そこはわかってますから安心してください♪"},
        { "location": "646/TALK"    , "narrator": "ガブリエラ", "text": "辛い思い出を消してくれたとしても、一緒に$marzanna$との思い出もきえちゃったら嫌かも///"},
        { "location": "648/TALK"    , "narrator": "みやび", "text": "そうならないよう、エリカさんが調整しているはず、なあ相棒"},
        { "location": "649/SEL"     , "narrator": "", "text": "その通り！"},
        { "location": "650/SEL"     , "narrator": "", "text": "多分…"},
        { "location": "651/ACT"     , "narrator": "", "text": "その通り！"},
        { "location": "652/TALK"    , "narrator": "アーヤ", "text": "それならいいけど、姉のことだからちょっと心配…"},
        { "location": "653/ACT"     , "narrator": "", "text": "多分…"},
        { "location": "654/TALK"    , "narrator": "アーヤ", "text": "うわぁ、本当に大丈夫？"},
        { "location": "655/TALK"    , "narrator": "アーヤ", "text": "いや"},
        { "location": "656/TALK"    , "narrator": "アーヤ", "text": "$handle$さんじゃなくて、姉の方"},
        { "location": "658/TALK"    , "narrator": "アーヤ", "text": "$handle$さんとの思い出が消えちゃったら、さすがに姉でも恨むから"},
        { "location": "659/TALK"    , "narrator": "つばめ", "text": "でも、忘れちゃったことって覚えてるのかなぁ(´･ω･｀) "},
        { "location": "660/TALK"    , "narrator": "アーヤ", "text": "あー"},
        { "location": "661/TALK"    , "narrator": "みやび", "text": "つばめちゃん、頭えいね！しびれる～～！！"},
        { "location": "662/TALK"    , "narrator": "つばめ", "text": "(●´ω｀●)ゞｴﾍﾍ"},
        { "location": "663/TALK"    , "narrator": "ガブリエラ", "text": "それ、照れる所じゃないわよ、、"},
        { "location": "664/TALK"    , "narrator": "ガブリエラ", "text": "思い出が消えちゃったら、消えちゃったことを悲しむこともできなくなっちゃうのよ？それってすごく悲しい事だと思うの…"},
        { "location": "665/TALK"    , "narrator": "アーヤ", "text": "そうね、でも今はまだ、ここからの未来でどうなるかわからないっていうのが現状だから"},
        { "location": "666/SEL"     , "narrator": "", "text": "$me$が絶対そんなことさせないから安心して！"},
        { "location": "667/SEL"     , "narrator": "", "text": "なんか段々話がシビアな事になってきたんですけど"},
        { "location": "668/ACT"     , "narrator": "", "text": "$me$が絶対そんなことさせないから安心して！"},
        { "location": "669/TALK"    , "narrator": "つばめ", "text": "ぅん！安心してるょ！"},
        { "location": "670/TALK"    , "narrator": "みやび", "text": "とはいえ、相棒を信用していないわけではないが、シビアに考えれば呑気すぎるのも後で後悔を招く"},
        { "location": "671/ACT"     , "narrator": "", "text": "なんか段々話がシビアな事になってきたんですけど"},
        { "location": "672/TALK"    , "narrator": "ガブリエラ", "text": "それだけ$marzanna$との思い出が大切なのよ、みんな"},
        { "location": "674/TALK"    , "narrator": "みやび", "text": "それで、うちらは考えた"},
        { "location": "675/TALK"    , "narrator": "アーヤ", "text": "$handle$さんと私たちが共に築き上げてきた証を、ずっと残したいから"},
        { "location": "676/TALK"    , "narrator": "ガブリエラ", "text": "$marzanna$をいつでも傍に感じられるように"},
        { "location": "677/TALK"    , "narrator": "神楽", "text": "$handlek$と私が、確かにここにいた証を"},
        { "location": "678/TALK"    , "narrator": "つばめ", "text": "$handle$さんが大好きだからヽ(*´∀｀*)ﾉ"},
        { "location": "679/TALK"    , "narrator": "みやび", "text": "相棒、いや、$handle$との思い出の品を作りたいと思ってな"},
        { "location": "680/TALK"    , "narrator": "神楽", "text": "オルゴール作ってみたんですっ！"},
        { "location": "681/SEL"     , "narrator": "", "text": "オルゴール！？"},
        { "location": "682/ACT"     , "narrator": "", "text": "オルゴール！？"},
        { "location": "685/TALK"    , "narrator": "神楽", "text": "こんな感じ"},
        { "location": "687/TALK"    , "narrator": "つばめ", "text": "音楽はメノウちゃんのアースタシアなんだょ～～～～～～～～～～:.ﾟヽ(´∀`｡)ﾉﾟ.:｡ ゜"},
        { "location": "688/TALK"    , "narrator": "ガブリエラ", "text": "いや、そうだけど、今伝えなくちゃいけないのはそこじゃないでしょ"},
        { "location": "689/TALK"    , "narrator": "アーヤ", "text": "私たちと$handle$さんの思い出の曲といえば、これかなって、みんなで話して決めたの"},
        { "location": "690/TALK"    , "narrator": "神楽", "text": "だから私も、今回はFreyMENOWとしてじゃなくて、卯月神楽としてEarthtasiaを提案したんです"},
        { "location": "691/SEL"     , "narrator": "", "text": "アースタシア最高！"},
        { "location": "692/SEL"     , "narrator": "", "text": "まあ妥当な選曲だね"},
        { "location": "693/ACT"     , "narrator": "", "text": "アースタシア最高！"},
        { "location": "694/TALK"    , "narrator": "神楽", "text": "ぴょん！！！！"},
        { "location": "695/TALK"    , "narrator": "神楽", "text": "ぴょんぴょんぴょん♪"},
        { "location": "696/ACT"     , "narrator": "", "text": "まあ妥当な選曲だね"},
        { "location": "698/TALK"    , "narrator": "つばめ", "text": "わたしは最高だと思いますヾ(｡>﹏<｡)ﾉﾞ"},
        { "location": "699/TALK"    , "narrator": "神楽", "text": "やっぱりぴょんこにはつばめさんしかいませんﾊｧﾊｧ"},
        { "location": "702/SEL"     , "narrator": "", "text": "でも、思い出の品っていうなら、もうカフェギフトとお手紙もらってるよね"},
        { "location": "703/ACT"     , "narrator": "", "text": "でも、思い出の品っていうなら、もうカフェギフトとお手紙もらってるよね"},
        { "location": "705/TALK"    , "narrator": "ガブリエラ", "text": "そうじゃないのよ、わからないのかしら！"},
        { "location": "706/TALK"    , "narrator": "アーヤ", "text": "$handle$さんとの思い出なのよ"},
        { "location": "707/TALK"    , "narrator": "ガブリエラ", "text": "そう、その、$handle$なのよ、$handle$なの！！"},
        { "location": "708/TALK"    , "narrator": "みやび", "text": "すなわちそれはオンリーワンの$handle$であり、他の誰でもない"},
        { "location": "709/TALK"    , "narrator": "つばめ", "text": "$handle$さんと、私たちだけのだょ！"},
        { "location": "710/TALK"    , "narrator": "神楽", "text": "意味、わかりますか？"},
        { "location": "711/SEL"     , "narrator": "", "text": "何となくわかったけど、それってマジなの？"},
        { "location": "712/SEL"     , "narrator": "", "text": "もっと具体的に言って"},
        { "location": "713/SEL"     , "narrator": "", "text": "もっとテクノロジー的に言って"},
        { "location": "714/ACT"     , "narrator": "", "text": "何となくわかったけど、それってマジなの？"},
        { "location": "715/TALK"    , "narrator": "神楽", "text": "大マジだぜーっ♪"},
        { "location": "716/ACT"     , "narrator": "", "text": "もっと具体的に言って"},
        { "location": "717/TALK"    , "narrator": "アーヤ", "text": "オルゴールの箱に、私から$handle$さんへのメッセージを刻むの(^^*"},
        { "location": "718/TALK"    , "narrator": "ガブリエラ", "text": "もちろんそれは、私と$handle$だけの、思い出のレターなのよ？"},
        { "location": "719/ACT"     , "narrator": "", "text": "もっとテクノロジー的に言って"},
        { "location": "720/TALK"    , "narrator": "みやび", "text": "ここにいるうちらは、お前さんと一緒に色んなことをしてきた"},
        { "location": "721/TALK"    , "narrator": "アーヤ", "text": "本当に色々助けてもらったと思う(^^;;"},
        { "location": "722/TALK"    , "narrator": "ガブリエラ", "text": "掛け替えのない思い出が一杯あるわね"},
        { "location": "723/TALK"    , "narrator": "みやび", "text": "それは、お前さんとうちらだけの思い出や"},
        { "location": "724/TALK"    , "narrator": "みやび", "text": "けんど、エリカさんの話によれば、うちらをサポートしている相棒とは違う相棒が実際には何万といて、それぞれ別の平行世界にいるうちらと邂逅しちゅうゆうことや"},
        { "location": "725/TALK"    , "narrator": "みやび", "text": "前にそっちに送っているカフェギフトや卯月の本なんかは、そういった平行世界に対して同報メール的に送っていたものであって、お前さん個人だけに送っていたものではなかったのだ！バーン！！"},
        { "location": "726/TALK"    , "narrator": "みやび", "text": "ちとショックだったか？"},
        { "location": "727/SEL"     , "narrator": "", "text": "知ってました"},
        { "location": "728/ACT"     , "narrator": "", "text": "知ってました"},
        { "location": "730/TALK"    , "narrator": "みやび", "text": "ならばよし！"},
        { "location": "731/TALK"    , "narrator": "神楽", "text": "けど、今回のオルゴールは違うんですよ？"},
        { "location": "732/TALK"    , "narrator": "つばめ", "text": "そぅなの！わたしの$handle$さんにだけのものなんだ～～(*´ω｀*)"},
        { "location": "733/TALK"    , "narrator": "アーヤ", "text": "私が$handle$さんとの思い出をちゃんとメッセージに書くんだから"},
        { "location": "735/TALK"    , "narrator": "神楽", "text": "あっ、ちょうど今そこの部分の写真撮りましたのでアップしますね♪"},
        { "location": "736/TALK"    , "narrator": "神楽", "text": "どーん♪"},
        { "location": "737/SEL"     , "narrator": "", "text": "文字が刻まれてる！！"},
        { "location": "738/SEL"     , "narrator": "", "text": "ほんとに$me$にだけのメッセージなの？"},
        { "location": "739/ACT"     , "narrator": "", "text": "文字が刻まれてる！！"},
        { "location": "740/TALK"    , "narrator": "ガブリエラ", "text": "当然よ、記念になる物にしたんだから"},
        { "location": "741/TALK"    , "narrator": "アーヤ", "text": "気に入ってもらえたら嬉しいかな"},
        { "location": "742/ACT"     , "narrator": "", "text": "ほんとに$me$にだけのメッセージなの？"},
        { "location": "743/TALK"    , "narrator": "みやび", "text": "疑り深いね"},
        { "location": "744/TALK"    , "narrator": "神楽", "text": "私もちゃんと書きますけど、$handlek$もちゃんと私にメッセージを書いて下さいね？"},
        { "location": "746/TALK"    , "narrator": "みやび", "text": "詳しいことはこれを見て欲しい"},
        { "location": "748/TALK"    , "narrator": "みやび", "text": "とまあ、こんな感じやね"},
        { "location": "752/SEL"     , "narrator": "", "text": "メッセージ書いて送るよ！"},
        { "location": "753/SEL"     , "narrator": "", "text": "値段も本気すぎるでしょ！"},
        { "location": "754/SEL"     , "narrator": "", "text": "頭おかしいでしょこれ！"},
        { "location": "755/ACT"     , "narrator": "", "text": "メッセージ書いて送るよ！"},
        { "location": "756/TALK"    , "narrator": "アーヤ", "text": "楽しみにしてる(*^^*)"},
        { "location": "757/TALK"    , "narrator": "ガブリエラ", "text": "ちゃんと思い出に残るものを書いてよね？"},
        { "location": "758/TALK"    , "narrator": "つばめ", "text": "わたしも$handle$さんにお手紙書くの楽しみです(≧ω≦)"},
        { "location": "759/TALK"    , "narrator": "神楽", "text": "これでいつでもぴょんこと一緒ですねっ♪"},
        { "location": "760/TALK"    , "narrator": "みやび", "text": "まあ、相棒に興味あればつき合うきね"},
        { "location": "761/ACT"     , "narrator": "", "text": "値段も本気すぎるでしょ！"},
        { "location": "762/TALK"    , "narrator": "みやび", "text": "送り先が平行世界単位で違う故に開発コストがだいぶ掛かっているので"},
        { "location": "763/TALK"    , "narrator": "みやび", "text": "そこは容赦してくれ"},
        { "location": "764/ACT"     , "narrator": "", "text": "頭おかしいでしょこれ！"},
        { "location": "765/TALK"    , "narrator": "神楽", "text": "褒め言葉戴きましたっ♪"},
        { "location": "766/TALK"    , "narrator": "つばめ", "text": "え？褒めてるのそれ？(･Д･｀)"},
        { "location": "767/TALK"    , "narrator": "みやび", "text": "つばめちゃんももうちょっと大人になればわかる世界"},
        { "location": "768/TALK"    , "narrator": "ガブリエラ", "text": "私はわかってるから！"},
        { "location": "771/TALK"    , "narrator": "アーヤ", "text": "なんか駆け足でお話しちゃったけど、要するに私たちは$handle$さんとずっと一緒だっていう何かを持っていたかったのよ"},
        { "location": "772/TALK"    , "narrator": "ガブリエラ", "text": "で、みんなで考えてみたのがこれってわけなのよ？"},
        { "location": "774/TALK"    , "narrator": "みやび", "text": "おっと、そろそろログアウトせねばならないようだ"},
        { "location": "775/TALK"    , "narrator": "神楽", "text": "もっとお話したかったです…（しょぼん"},
        { "location": "776/TALK"    , "narrator": "つばめ", "text": "$handle$さんが過去に戻ってゎたしたちの未来を頑張って作ってくれてるの、いつもありがとぅって思ってます"},
        { "location": "777/TALK"    , "narrator": "ガブリエラ", "text": "まあ、$marzanna$がいなかったら、今の私が無かったというのは認めるわ"},
        { "location": "778/TALK"    , "narrator": "アーヤ", "text": "早く私たちのいる時間軸まで戻って来てね？待ってます！"},
        { "location": "779/TALK"    , "narrator": "みやび", "text": "ほなな、相棒"},
        { "location": "780/TALK"    , "narrator": "みやび", "text": "今生の別れやないき、重い挨拶はせんよ。ただ一言だけ"},
        { "location": "781/TALK"    , "narrator": "みやび", "text": "本当にありがとうね"},
        { "location": "782/SEL"     , "narrator": "", "text": "こっちこそ、ありがとう"},
        { "location": "783/SEL"     , "narrator": "", "text": "つばめ、愛してるよ"},
        { "location": "784/SEL"     , "narrator": "", "text": "アーヤ、愛してるよ"},
