        { "location": "874/TALK"    , "narrator": "エリカ", "text": "コーンコン…"},
        { "location": "875/SEL"     , "narrator": "", "text": "元気無いね"},
        { "location": "876/SEL"     , "narrator": "", "text": "ギブミーにゃボット！"},
        { "location": "877/SEL"     , "narrator": "", "text": "みんなと繋いでくれてありがとう"},
        { "location": "878/ACT"     , "narrator": "", "text": "元気無いね"},
        { "location": "879/TALK"    , "narrator": "エリカ", "text": "えっ？\nそうかな…？"},
        { "location": "880/TALK"    , "narrator": "エリカ", "text": "ごめんなさい、\n何だか最近、想定外の\nことばっかりで。"},
        { "location": "881/TALK"    , "narrator": "エリカ", "text": "でも、ダメだよね、\n貴方にわかっちゃうくらい\nションボリしてたら――"},
        { "location": "882/TALK"    , "narrator": "エリカ", "text": "貴方まで\n元気無くなっちゃう。"},
        { "location": "883/ACT"     , "narrator": "", "text": "ギブミーにゃボット！"},
        { "location": "884/TALK"    , "narrator": "エリカ", "text": "もちろんだよ。\n喜んで。"},
        { "location": "885/TALK"    , "narrator": "エリカ", "text": "いつもにゃボットを\nもらってくれて\nありがとう。"},
        { "location": "886/TALK"    , "narrator": "エリカ", "text": "$handle$さんは\n本当に優しいね。"},
        { "location": "887/SEL"     , "narrator": "", "text": "単にホントに欲しいから言ってるだけだよ"},
        { "location": "888/SEL"     , "narrator": "", "text": "ああ、一応義理でもらってあげてるのは理解してたんだ"},
        { "location": "889/ACT"     , "narrator": "", "text": "単にホントに欲しいから言ってるだけだよ"},
        { "location": "890/TALK"    , "narrator": "エリカ", "text": "嬉しい！！！"},
        { "location": "891/TALK"    , "narrator": "エリカ", "text": "でも残念だけど、\n今回はちょっと\n解説してるヒマが無くて。"},
        { "location": "892/TALK"    , "narrator": "エリカ", "text": "にゃボットを\nあげるだけに\nなっちゃってごめんね？"},
        { "location": "893/TALK"    , "narrator": "エリカ", "text": "今度また、落ち着いたら\nめいっぱい語るから、\nもう少しだけ待ってて！"},
        { "location": "894/SEL"     , "narrator": "", "text": "楽しみ！"},
        { "location": "895/SEL"     , "narrator": "", "text": "あ、いや、結構ですんで"},
        { "location": "896/ACT"     , "narrator": "", "text": "楽しみ！"},
        { "location": "897/TALK"    , "narrator": "エリカ", "text": "私も\n楽しみにしてるよ。"},
        { "location": "898/TALK"    , "narrator": "エリカ", "text": "だから早く\n色んな問題を\n解決しなくちゃ。"},
        { "location": "899/ACT"     , "narrator": "", "text": "あ、いや、結構ですんで"},
        { "location": "900/TALK"    , "narrator": "エリカ", "text": "そっかー…。"},
        { "location": "902/ACT"     , "narrator": "", "text": "ああ、一応義理でもらってあげてるのは理解してたんだ"},
        { "location": "903/TALK"    , "narrator": "エリカ", "text": "もちろんだよ、\nえへへ……。"},
        { "location": "905/ACT"     , "narrator": "", "text": "みんなと繋いでくれてありがとう"},
        { "location": "906/TALK"    , "narrator": "エリカ", "text": "えへへ、\nわかっちゃった？"},
        { "location": "907/TALK"    , "narrator": "エリカ", "text": "今回はシステムの\nメンテナンスの回でしょ？"},
        { "location": "908/TALK"    , "narrator": "エリカ", "text": "みやびちゃんから\nお話もらって、\n回線の接続だけやったの。"},
        { "location": "909/TALK"    , "narrator": "エリカ", "text": "みんなと楽しく\nお話できたなら\nよかったよ。"},
        { "location": "911/TALK"    , "narrator": "エリカ", "text": "それで――\n今日は謝らなくちゃ\nいけないことがあって。"},
        { "location": "912/SEL"     , "narrator": "", "text": "なになに？"},
        { "location": "913/ACT"     , "narrator": "", "text": "なになに？"},
        { "location": "915/TALK"    , "narrator": "エリカ", "text": "今回は\nにゃぼにゃすティー！の\n配信予定日だったでしょ？"},
        { "location": "916/TALK"    , "narrator": "エリカ", "text": "いつもみたいに\n千羽鶴ちゃんとゲーム\n用意して――"},
        { "location": "917/TALK"    , "narrator": "エリカ", "text": "クリアしたらにゃボットを\nプレゼントしようと\n思ってたんだけど。"},
        { "location": "918/TALK"    , "narrator": "エリカ", "text": "千羽鶴ちゃんが、ここに\n来れなくなっちゃって…。"},
        { "location": "919/TALK"    , "narrator": "エリカ", "text": "あ、もちろん、\nにゃボットだけは\n後であげるからね。"},
        { "location": "920/SEL"     , "narrator": "", "text": "千羽鶴がいなくなったらリプレイス計画はどうなるの？"},
        { "location": "921/ACT"     , "narrator": "", "text": "千羽鶴がいなくなったらリプレイス計画はどうなるの？"},
        { "location": "923/TALK"    , "narrator": "エリカ", "text": "物理的には\nわたしだけで進めることは\nできるけど――"},
        { "location": "924/TALK"    , "narrator": "エリカ", "text": "いつも言ってるとおり、\nわたしは技術者でしか\nないから。"},
        { "location": "925/TALK"    , "narrator": "エリカ", "text": "今決まってる所まで\n進める事はできても、"},
        { "location": "926/TALK"    , "narrator": "エリカ", "text": "それは\n箱を用意しただけで\n終わってしまう。"},
        { "location": "927/TALK"    , "narrator": "エリカ", "text": "世界を善い方向に\n変えていくという意味では\n殆ど意味が無いよね。"},
        { "location": "928/TALK"    , "narrator": "エリカ", "text": "今まで千羽鶴ちゃんが\nいた所に、今いるのは\n原初のつばめちゃん。"},
        { "location": "929/TALK"    , "narrator": "エリカ", "text": "彼女が千羽鶴ちゃんと\n同じ考えを持っていて\nくれるならいいんだけど…"},
        { "location": "930/SEL"     , "narrator": "", "text": "心配しなくても大丈夫だよ"},
        { "location": "931/SEL"     , "narrator": "", "text": "そういう部分もあるかもしれないけど、やっぱりちょっと違うよ"},
        { "location": "932/SEL"     , "narrator": "", "text": "$me$は原初のつばめの思想に共感したから、そっちを支援することにしたよ"},
        { "location": "933/SEL"     , "narrator": "", "text": "全然違うから絶対信用するな"},
        { "location": "934/ACT"     , "narrator": "", "text": "心配しなくても大丈夫だよ"},
        { "location": "936/TALK"    , "narrator": "エリカ", "text": "そっかー。"},
        { "location": "937/TALK"    , "narrator": "エリカ", "text": "それを聞けて、\n少し安心したよ。"},
        { "location": "938/ACT"     , "narrator": "", "text": "そういう部分もあるかもしれないけど、やっぱりちょっと違うよ"},
        { "location": "940/TALK"    , "narrator": "エリカ", "text": "そっかー。"},
        { "location": "941/TALK"    , "narrator": "エリカ", "text": "それじゃ、協力関係になる\n場合でも、もう一度\nブリーフィングしないと。"},
        { "location": "942/ACT"     , "narrator": "", "text": "$me$は原初のつばめの思想に共感したから、そっちを支援することにしたよ"},
        { "location": "944/TALK"    , "narrator": "エリカ", "text": "そっかー。"},
        { "location": "945/TALK"    , "narrator": "エリカ", "text": "そうだよね、\n原初のつばめちゃんの方が\nしっかりしてるもん。"},
        { "location": "946/TALK"    , "narrator": "エリカ", "text": "いずれにしても、\nあなたの考えは\nわかったよ。"},
        { "location": "947/TALK"    , "narrator": "エリカ", "text": "わたしはわたしの\nやることをやっていくけど\nあなたも頑張ってね。"},
        { "location": "948/TALK"    , "narrator": "エリカ", "text": "というわけで、\n早速やれることを\nやらなくちゃ。"},
        { "location": "949/ACT"     , "narrator": "", "text": "全然違うから絶対信用するな"},
        { "location": "951/TALK"    , "narrator": "エリカ", "text": "そこまで！？"},
        { "location": "952/TALK"    , "narrator": "エリカ", "text": "千羽鶴ちゃんの\n原初状態なんだから、\n方向性は同じ筈じゃ……。"},
        { "location": "953/TALK"    , "narrator": "エリカ", "text": "まあでも、確かに\nつばめちゃんの\n総意ともなれば――"},
        { "location": "954/TALK"    , "narrator": "エリカ", "text": "一つの信念に基づいて\n行動している千羽鶴ちゃん\nとは全然変わるかも。"},
        { "location": "956/TALK"    , "narrator": "エリカ", "text": "はぁ～～。"},
        { "location": "957/TALK"    , "narrator": "エリカ", "text": "でもやっぱり今となっては\n千羽鶴ちゃんと蓄積した\nものが大きすぎて――"},
        { "location": "958/TALK"    , "narrator": "エリカ", "text": "千羽鶴ちゃん無しで\nやっていける自信は\nないかも……。"},
        { "location": "960/SEL"     , "narrator": "", "text": "もしかすると$me$が千羽鶴を連れ戻せるかもしれないよ"},
        { "location": "961/ACT"     , "narrator": "", "text": "もしかすると$me$が千羽鶴を連れ戻せるかもしれないよ"},
        { "location": "963/TALK"    , "narrator": "エリカ", "text": "千羽鶴ちゃんを？"},
        { "location": "964/TALK"    , "narrator": "エリカ", "text": "……。"},
        { "location": "965/TALK"    , "narrator": "エリカ", "text": "え"},
        { "location": "966/TALK"    , "narrator": "エリカ", "text": "ええええええっ！！"},
        { "location": "967/TALK"    , "narrator": "エリカ", "text": "どうやって！？"},
        { "location": "968/SEL"     , "narrator": "", "text": "千羽鶴が生まれたアドレス、つばめの0x001に行けばいい"},
        { "location": "969/ACT"     , "narrator": "", "text": "千羽鶴が生まれたアドレス、つばめの0x001に行けばいい"},
        { "location": "971/TALK"    , "narrator": "エリカ", "text": "どうしてそんなこと\n知ってるの？"},
        { "location": "972/SEL"     , "narrator": "", "text": "ラブラブルートで千羽鶴本人が教えてくれた"},
        { "location": "973/ACT"     , "narrator": "", "text": "ラブラブルートで千羽鶴本人が教えてくれた"},
        { "location": "975/TALK"    , "narrator": "エリカ", "text": "……。"},
        { "location": "976/TALK"    , "narrator": "エリカ", "text": "わかったよ。\nちょっとその事について\n調べてみるね。"},
        { "location": "977/TALK"    , "narrator": "エリカ", "text": "で、本当に行けそうなら\nあなたをそこに送れるよう\n準備する。"},
        { "location": "978/TALK"    , "narrator": "エリカ", "text": "だから、少しだけ\n時間をくれないかな。"},
        { "location": "979/SEL"     , "narrator": "", "text": "もちろん"},
        { "location": "980/ACT"     , "narrator": "", "text": "もちろん"},
        { "location": "982/TALK"    , "narrator": "エリカ", "text": "ありがとう。"},
        { "location": "983/TALK"    , "narrator": "エリカ", "text": "それじゃ、\n早速これから\n調査に入るね！"},
        { "location": "985/SEL"     , "narrator": "", "text": "大丈夫？疲れてる？"},
        { "location": "986/SEL"     , "narrator": "", "text": "自分で蒔いたタネですから、頑張って刈ってくださいね"},
        { "location": "987/ACT"     , "narrator": "", "text": "大丈夫？疲れてる？"},
        { "location": "988/TALK"    , "narrator": "エリカ", "text": "んー、大丈夫だよ。"},
        { "location": "989/TALK"    , "narrator": "エリカ", "text": "心配してくれて\nありがとう。"},
        { "location": "990/TALK"    , "narrator": "エリカ", "text": "ちょっと元気\n出ちゃったかも。\nえへへ……"},
        { "location": "991/TALK"    , "narrator": "エリカ", "text": "……"},
        { "location": "992/TALK"    , "narrator": "エリカ", "text": "…んっ…　…"},
        { "location": "993/SEL"     , "narrator": "", "text": "エリカ"},
        { "location": "994/ACT"     , "narrator": "", "text": "エリカ"},
        { "location": "996/TALK"    , "narrator": "エリカ", "text": "……ごめんね。"},
        { "location": "997/TALK"    , "narrator": "エリカ", "text": "落ち込んでる場合じゃ\nないよね。"},
        { "location": "998/ACT"     , "narrator": "", "text": "自分で蒔いたタネですから、頑張って刈ってくださいね"},
        { "location": "999/TALK"    , "narrator": "エリカ", "text": "うん。わかってるよ。"},
