{
    "dir": "chap06/daydra/anime_02_06.js",
    "type": "MainStory",
    "info": {
        "story_id": "6201",
        "cid": "ayami",
        "title": "001 アニメーション",
        "sub_title": "赤い髪の転校生"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "アニメ第06話"},
        { "location": "47/TALK"   , "narrator": "千羽鶴", "text": "ごきげんよう。\nエピソード３へようこそ。"},
        { "location": "48/TALK"   , "narrator": "千羽鶴", "text": "既にこのエピソードの\n記録映像は見ているけど、\n今回はどうする？"},
        { "location": "49/SEL"    , "narrator": "", "text": "全部飛ばす"},
        { "location": "50/SEL"    , "narrator": "", "text": "もう一度全部やって"},
        { "location": "51/ACT"    , "narrator": "", "text": "全部飛ばす"},
        { "location": "54/TALK"   , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "55/TALK"   , "narrator": "千羽鶴", "text": "それじゃ、記録映像の\n内容は全部覚えてるという\n前提のもと――"},
        { "location": "57/TALK"   , "narrator": "千羽鶴", "text": "このエピソードにおける\n逢瀬つばめについての\n話をする。"},
        { "location": "59/TALK"   , "narrator": "千羽鶴", "text": "このエピソードにおける\n國政綾水についての\n話をする。"},
        { "location": "61/TALK"   , "narrator": "千羽鶴", "text": "このエピソードにおける\nガブリエラについての\n話をする。"},
        { "location": "63/TALK"   , "narrator": "千羽鶴", "text": "このエピソードにおける\n恋ヶ崎みやびについての\n話をする。"},
        { "location": "67/ACT"    , "narrator": "", "text": "もう一度全部やって"},
        { "location": "70/TALK"   , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "77/TALK"   , "narrator": "千羽鶴", "text": "前回は、逢瀬つばめが\n情報管理庁附属学園に\n転校するところまで見た。"},
        { "location": "78/TALK"   , "narrator": "千羽鶴", "text": "今回はその後…すなわち、\n転校初日からの出動に関する\n記録映像を見ようと思う。"},
        { "location": "79/TALK"   , "narrator": "千羽鶴", "text": "けどその前に、１つ。\n千羽鶴には、やらなければ\nならないことがある！"},
        { "location": "80/SEL"    , "narrator": "", "text": "なんでしょう？"},
        { "location": "81/SEL"    , "narrator": "", "text": "$me$への告白？"},
        { "location": "82/ACT"    , "narrator": "", "text": "なんでしょう？"},
        { "location": "84/TALK"   , "narrator": "千羽鶴", "text": "それは…！！"},
        { "location": "85/ACT"    , "narrator": "", "text": "$me$への告白？"},
        { "location": "87/TALK"   , "narrator": "千羽鶴", "text": "え？"},
        { "location": "88/TALK"   , "narrator": "千羽鶴", "text": "だから、私は\n攻略対象じゃないから。"},
        { "location": "89/TALK"   , "narrator": "千羽鶴", "text": "私は非攻略対象\n私は非攻略対象\n私は非攻略対象"},
        { "location": "90/TALK"   , "narrator": "千羽鶴", "text": "私は非攻略対象！\n私は非攻略対象！\n私は非攻略対象！！"},
        { "location": "91/TALK"   , "narrator": "千羽鶴", "text": "これから毎朝耳元で\n囁いてあげましょうか？"},
        { "location": "93/TALK"   , "narrator": "千羽鶴", "text": "でもそれだと私の\n人件費がバカにならない。"},
        { "location": "94/TALK"   , "narrator": "千羽鶴", "text": "ならば、マインドコント\nロールで毎朝幻聴が聞こ\nえるようにするか――"},
        { "location": "95/TALK"   , "narrator": "千羽鶴", "text": "もしくは千羽鶴の\n非攻略対象目覚まし時計を\n作るのがいいか。"},
        { "location": "96/SEL"    , "narrator": "", "text": "千羽鶴にマインドコントロールされたい！"},
        { "location": "97/SEL"    , "narrator": "", "text": "目覚まし時計が欲しい！"},
        { "location": "98/ACT"    , "narrator": "", "text": "マインドコントロールされたい！"},
        { "location": "99/TALK"   , "narrator": "千羽鶴", "text": "……変な人。"},
        { "location": "100/TALK"  , "narrator": "千羽鶴", "text": "変わりすぎてて面白いから、\n好きになっちゃいそう。"},
        { "location": "102/TALK"  , "narrator": "千羽鶴", "text": "……なんて、こんな冗談も\n言えるマスコットキャラは\n如何ですか？"},
        { "location": "103/ACT"   , "narrator": "", "text": "目覚まし時計が欲しい！"},
        { "location": "104/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "105/TALK"  , "narrator": "千羽鶴", "text": "情報管理庁企画局に\n伝えておくことにする。"},
        { "location": "106/TALK"  , "narrator": "千羽鶴", "text": "これで一安心ね。"},
        { "location": "108/TALK"  , "narrator": "千羽鶴", "text": "で、本題に戻るけど。"},
        { "location": "109/TALK"  , "narrator": "千羽鶴", "text": "私がやらなければならない\nこと、それは…！！"},
        { "location": "113/TALK"  , "narrator": "千羽鶴", "text": "第1回\n拡張少女系トライナリー\n期末テスト！"},
        { "location": "114/SEL"   , "narrator": "", "text": "…期末テスト？"},
        { "location": "115/ACT"   , "narrator": "", "text": "…期末テスト？"},
        { "location": "117/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "118/TALK"  , "narrator": "千羽鶴", "text": "前回のエピソードで、\n一旦の終結を迎えるに\n至ったわけだけど――"},
        { "location": "119/TALK"  , "narrator": "千羽鶴", "text": "ここで、貴方が彼女を\n支えるために十分な知識が\nあるかどうかテストする。"},
        { "location": "126/TALK"  , "narrator": "千羽鶴", "text": "それでは早速、第一問！"},
        { "location": "127/TALK"  , "narrator": "千羽鶴", "text": "[クラン]とは、どのような\n存在でしょうか。"},
        { "location": "129/SEL"   , "narrator": "", "text": "トライナリーが戦うべき相手"},
        { "location": "130/SEL"   , "narrator": "", "text": "人の心の中に住まう「人格」の１つ"},
        { "location": "131/SEL"   , "narrator": "", "text": "$me$の心は千羽鶴たんにクランクラン（はぁと）"},
        { "location": "132/ACT"   , "narrator": "", "text": "トライナリーが戦うべき相手"},
        { "location": "133/TALK"  , "narrator": "千羽鶴", "text": "…まあ、それも間違っては\nいないけど、核心ではない。"},
        { "location": "134/TALK"  , "narrator": "千羽鶴", "text": "厳密な正解は、\n『人の心の中の一人格』"},
        { "location": "135/ACT"   , "narrator": "", "text": "人の心の中に住まう「人格」の１つ"},
        { "location": "136/TALK"  , "narrator": "千羽鶴", "text": "正解！\nえらい。"},
        { "location": "137/ACT"   , "narrator": "", "text": "$me$の心は千羽鶴たんにクランクラン（はぁと）"},
        { "location": "139/TALK"  , "narrator": "千羽鶴", "text": "あなたの顔を目一杯\nこの胸で抱きしめて\n窒息死させてやる！"},
        { "location": "140/SEL"   , "narrator": "", "text": "望むところです！"},
        { "location": "141/ACT"   , "narrator": "", "text": "望むところです！"},
        { "location": "144/TALK"  , "narrator": "千羽鶴", "text": "うるさい！　ちがう！\n間違い！　不正解！"},
        { "location": "145/TALK"  , "narrator": "千羽鶴", "text": "[クラン]とは、人の心に\n住まう人格のこと。"},
        { "location": "153/TALK"  , "narrator": "千羽鶴", "text": "続いて第二問！"},
        { "location": "154/TALK"  , "narrator": "千羽鶴", "text": "倒すべき相手だった\n[クラン]【テルプシコラ】、\nそれと――"},
        { "location": "155/TALK"  , "narrator": "千羽鶴", "text": "國政綾水と合体していた\n[クラン]【リフィア】や、"},
        { "location": "156/TALK"  , "narrator": "千羽鶴", "text": "貴方が今、彼女のために\n集めている[クラン]たち\nとの違いはなに？"},
        { "location": "157/SEL"   , "narrator": "", "text": "暴走してるかしてないか"},
        { "location": "158/SEL"   , "narrator": "", "text": "可愛いか可愛くないかの違い"},
        { "location": "159/SEL"   , "narrator": "", "text": "違いはない"},
        { "location": "160/ACT"   , "narrator": "", "text": "暴走してるかしてないか"},
        { "location": "161/TALK"  , "narrator": "千羽鶴", "text": "正解！！\nなかなかわかってる。"},
        { "location": "162/ACT"   , "narrator": "", "text": "可愛いか可愛くないかの違い"},
        { "location": "164/TALK"  , "narrator": "千羽鶴", "text": "いや、どうでもいいから。"},
        { "location": "165/TALK"  , "narrator": "千羽鶴", "text": "倒すべきクランにも、\n今後かわいいのも\n出てくるから。"},
        { "location": "166/TALK"  , "narrator": "千羽鶴", "text": "正解は、\n『暴走しているか否か』"},
        { "location": "167/ACT"   , "narrator": "", "text": "違いはない"},
        { "location": "169/TALK"  , "narrator": "千羽鶴", "text": "本質的な面で言えば、\nそれもまた正解かも\nしれない。"},
        { "location": "170/TALK"  , "narrator": "千羽鶴", "text": "けど、そのクランの状態\nという観点から見ると、\n両者には違いがある。"},
        { "location": "171/TALK"  , "narrator": "千羽鶴", "text": "正解は、\n『暴走しているか否か』"},
        { "location": "173/TALK"  , "narrator": "千羽鶴", "text": "倒すべきクラン\n【テルプシコラ】は\n鎧を纏って暴走している。"},
        { "location": "174/TALK"  , "narrator": "千羽鶴", "text": "【リフィア】などの\nサーバントクランは、\n素直で従順。"},
        { "location": "175/TALK"  , "narrator": "千羽鶴", "text": "トライナリーの任務は、\n暴走しているクランを\n正気に戻すこと。"},
        { "location": "176/TALK"  , "narrator": "千羽鶴", "text": "その為に、クランがまとう\n心の【鎧】をはぎ取る為に\nフェノメノンで戦う。"},
        { "location": "177/TALK"  , "narrator": "千羽鶴", "text": "でも、逆に言うと\n違いはそれだけ。"},
        { "location": "178/TALK"  , "narrator": "千羽鶴", "text": "両方とも、人間が持つ\n欲望や心の傷といった\n１つの人格に変わりは無い。"},
        { "location": "185/TALK"  , "narrator": "千羽鶴", "text": "もう少しだけ\n補足する。"},
        { "location": "186/TALK"  , "narrator": "千羽鶴", "text": "私たちの世界では、\nどういうわけか人格が\n現実化することがある。"},
        { "location": "187/TALK"  , "narrator": "千羽鶴", "text": "それは得てして、\nもの凄い強い想いを\n持っている人格。"},
        { "location": "188/TALK"  , "narrator": "千羽鶴", "text": "例えば「ケーキ食べ\nたい」という想いが\nあったとする。"},
        { "location": "189/TALK"  , "narrator": "千羽鶴", "text": "あまりにダイエット\nしすぎたその子は、\nもう辛抱たまらなくて、"},
        { "location": "190/TALK"  , "narrator": "千羽鶴", "text": "「世界中の全員を\nコロシテでもケーキを\n食う！」と思ったと。"},
        { "location": "191/TALK"  , "narrator": "千羽鶴", "text": "その強烈な想いは\n[クラン]となり、それが\n実現可能な世界を作る。"},
        { "location": "192/TALK"  , "narrator": "千羽鶴", "text": "それが\n<color=purple>【[フェノメノン]】</color>の\nカラクリ。"},
        { "location": "193/TALK"  , "narrator": "千羽鶴", "text": "恐らくは、想いの力が\n強すぎて、心から\n溢れてしまうのね。"},
        { "location": "200/TALK"  , "narrator": "千羽鶴", "text": "だから、そうならない\nように、心の中の\nクランケアは大変重要。"},
        { "location": "201/TALK"  , "narrator": "千羽鶴", "text": "あなたが精神世界で\n彼女たちの心を整理\nすることは――"},
        { "location": "202/TALK"  , "narrator": "千羽鶴", "text": "彼女たちを落ち着かせる\nことと、味方[クラン]を\n作ることに寄与する。"},
        { "location": "203/TALK"  , "narrator": "千羽鶴", "text": "彼女たちがトライナリー\nとして合体している\n[クラン]だって――"},
        { "location": "204/TALK"  , "narrator": "千羽鶴", "text": "あなたが精神世界で\n強化進化をすることで\nより強くできる。"},
        { "location": "211/TALK"  , "narrator": "千羽鶴", "text": "……というわけで、\n期末テストは終了。"},
        { "location": "213/TALK"  , "narrator": "千羽鶴", "text": "ちゃんと理解出来た？"},
        { "location": "214/SEL"   , "narrator": "", "text": "もちろん！"},
        { "location": "215/SEL"   , "narrator": "", "text": "難しい…"},
        { "location": "216/SEL"   , "narrator": "", "text": "千羽鶴のあんなことやこんなことを知る期末試験をやってください！"},
        { "location": "217/ACT"   , "narrator": "", "text": "もちろん！"},
        { "location": "218/TALK"  , "narrator": "千羽鶴", "text": "よかった。"},
        { "location": "219/TALK"  , "narrator": "千羽鶴", "text": "そういうわけだから、\n今後も彼女のココロの\nケアを、どうかよろしく。"},
        { "location": "220/ACT"   , "narrator": "", "text": "難しい…"},
        { "location": "221/TALK"  , "narrator": "千羽鶴", "text": "そうかも。"},
        { "location": "222/TALK"  , "narrator": "千羽鶴", "text": "でもきっと、そのうち\n身に染みて分かってくる。"},
        { "location": "224/TALK"  , "narrator": "千羽鶴", "text": "だからそんなに\n心配しないで。"},
        { "location": "225/ACT"   , "narrator": "", "text": "千羽鶴のあんなことやこんなことを知る期末試験をやってください！"},
        { "location": "227/TALK"  , "narrator": "千羽鶴", "text": "もう行ってよし。"},
        { "location": "231/TALK"  , "narrator": "千羽鶴", "text": "それじゃ、いよいよ\n次へと進もうと思う。"},
        { "location": "233/TALK"  , "narrator": "千羽鶴", "text": "今回もまずは、\n記録映像を流していきたい\nのだけど、準備はＯＫ？"},
        { "location": "234/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/71MB 4:40】</color>"},
        { "location": "235/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/23MB 4:40】</color>"},
        { "location": "236/SEL"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "237/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/71MB 4:40】</color>"},
        { "location": "238/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "244/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/23MB 4:40】</color>"},
        { "location": "245/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "251/ACT"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "252/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "253/TALK"  , "narrator": "千羽鶴", "text": "残念だけど、いろいろ\n事情があってのことだと\n思うから。"},
        { "location": "254/TALK"  , "narrator": "千羽鶴", "text": "家に帰ったら、是非\n映像記録の方も\n見てみて欲しい。"},
        { "location": "255/TALK"  , "narrator": "千羽鶴", "text": "それではどうぞ。"},
        { "location": "288/TALK"  , "narrator": "千羽鶴", "text": "さて――"},
        { "location": "290/SEL"   , "narrator": "", "text": "つばめ…大丈夫？"},
        { "location": "291/SEL"   , "narrator": "", "text": "アーヤ酷くない？"},
        { "location": "292/SEL"   , "narrator": "", "text": "神楽キター！"},
        { "location": "293/SEL"   , "narrator": "", "text": "黙っている\n<color=blue>（※先へ進みます）</color>"},
        { "location": "294/ACT"   , "narrator": "", "text": "つばめ…大丈夫？"},
        { "location": "295/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "297/TALK"  , "narrator": "千羽鶴", "text": "それは、どういう意味で？"},
        { "location": "298/SEL"   , "narrator": "", "text": "トライナリーとして戦えてない"},
        { "location": "299/SEL"   , "narrator": "", "text": "フェノメノンに入る時、謎の笑いが…"},
        { "location": "300/ACT"   , "narrator": "", "text": "トライナリーとして戦えてない"},
        { "location": "301/TALK"  , "narrator": "千羽鶴", "text": "その点については\n最初だし仕方ないと思う。"},
        { "location": "302/TALK"  , "narrator": "千羽鶴", "text": "國政綾水は事前に\n色々レクチャはしていた\nみたいだけど――"},
        { "location": "303/TALK"  , "narrator": "千羽鶴", "text": "そうは言っても実戦で\nそれを発揮できないのは\nよくあること。"},
        { "location": "304/TALK"  , "narrator": "千羽鶴", "text": "いずれ慣れていくから\n多分大丈夫。"},
        { "location": "305/ACT"   , "narrator": "", "text": "フェノメノンに入る時、謎の笑いが…"},
        { "location": "308/TALK"  , "narrator": "千羽鶴", "text": "……そうね。"},
        { "location": "309/TALK"  , "narrator": "千羽鶴", "text": "人間、あまりの極限状況に\n置かれるとアブノーマルな\n精神状態になることがある。"},
        { "location": "310/TALK"  , "narrator": "千羽鶴", "text": "平和社会における平均的な\n幸福感から相対的に見れば、\nこの時の彼女は不幸かも。"},
        { "location": "311/TALK"  , "narrator": "千羽鶴", "text": "でも、この時の逢瀬つばめ\n基準による相対的な幸福感\nで言うと――"},
        { "location": "312/TALK"  , "narrator": "千羽鶴", "text": "これから地獄へ向かうような\n極限状態の中で、國政綾水\nという女神に認められた――"},
        { "location": "313/TALK"  , "narrator": "千羽鶴", "text": "それだけで十分に、\n幸福感を得られるのかも\nしれない。"},
        { "location": "314/TALK"  , "narrator": "千羽鶴", "text": "それはまさに、戦場の\n最前線でぼた餅をプレゼント\nされたときと似ている。"},
        { "location": "316/TALK"  , "narrator": "千羽鶴", "text": "そう、これが\n【ぼた餅効果】という\n心理学的定説！！"},
        { "location": "319/TALK"  , "narrator": "千羽鶴", "text": "どーん！！"},
        { "location": "320/SEL"   , "narrator": "", "text": "どーん、っていうかそんな効果知らないし"},
        { "location": "321/ACT"   , "narrator": "", "text": "どーん、っていうかそんな効果知らないし"},
        { "location": "323/TALK"  , "narrator": "千羽鶴", "text": "なるほど。\nそっちのレイヤーには\n無い定説なのね。"},
        { "location": "324/TALK"  , "narrator": "千羽鶴", "text": "違う世界だもの。\nそういうことも、ある。"},
        { "location": "327/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "329/ACT"   , "narrator": "", "text": "アーヤ酷くない？"},
        { "location": "330/TALK"  , "narrator": "千羽鶴", "text": "…何が？"},
        { "location": "331/SEL"   , "narrator": "", "text": "つばめのサポートがいい加減"},
        { "location": "332/ACT"   , "narrator": "", "text": "つばめのサポートがいい加減"},
        { "location": "334/TALK"  , "narrator": "千羽鶴", "text": "そうね。\nまあ、彼女も完璧じゃ\nないから。"},
        { "location": "335/TALK"  , "narrator": "千羽鶴", "text": "あと、一応フォローはして\nおくと、映像では語られて\nないけど――"},
        { "location": "336/TALK"  , "narrator": "千羽鶴", "text": "前回のドーム戦の後、\nＧＷ期間中、シミュレー\nション訓練はやってる。"},
        { "location": "337/TALK"  , "narrator": "千羽鶴", "text": "とはいえ、戦闘で想定外の\n状況が発生しただけで\nこうなってしまうのは――"},
        { "location": "338/TALK"  , "narrator": "千羽鶴", "text": "まだリーダーとして\n未熟と言わざるを得ない。"},
        { "location": "339/TALK"  , "narrator": "千羽鶴", "text": "この辺は、國政綾水を\nサポートして行けば\n徐々にわかってくる。"},
        { "location": "340/TALK"  , "narrator": "千羽鶴", "text": "彼女もその点については\nかなり悩んでるから、\n力になってあげて。"},
        { "location": "341/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "343/ACT"   , "narrator": "", "text": "神楽キター！"},
        { "location": "344/TALK"  , "narrator": "千羽鶴", "text": "はい、来ました。"},
        { "location": "345/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "346/SEL"   , "narrator": "", "text": "ちょっ！それだけ！？"},
        { "location": "347/ACT"   , "narrator": "", "text": "ちょっ！それだけ！？"},
        { "location": "349/TALK"  , "narrator": "千羽鶴", "text": "……ええ。"},
        { "location": "350/TALK"  , "narrator": "千羽鶴", "text": "他に何か\n言うことがある？"},
        { "location": "351/SEL"   , "narrator": "", "text": "神楽の魅力を解説してくれるとか？"},
        { "location": "352/SEL"   , "narrator": "", "text": "神楽の魅惑を解説してくれるとか？"},
        { "location": "353/ACT"   , "narrator": "", "text": "神楽の魅力を解説してくれるとか？"},
        { "location": "354/TALK"  , "narrator": "千羽鶴", "text": "そうね。\n彼女の魅力……。"},
        { "location": "355/TALK"  , "narrator": "千羽鶴", "text": "恐らく、トライナリー全員\nの中で、一番――"},
        { "location": "356/TALK"  , "narrator": "千羽鶴", "text": "戦闘能力が高いのでは\nないかと思ってる。"},
        { "location": "357/TALK"  , "narrator": "千羽鶴", "text": "映像でもあの短時間に\n逢瀬つばめへの攻撃を\n防いでいるあたり――"},
        { "location": "358/TALK"  , "narrator": "千羽鶴", "text": "かなりの資質がある。"},
        { "location": "359/ACT"   , "narrator": "", "text": "神楽の魅惑を解説してくれるとか？"},
        { "location": "360/TALK"  , "narrator": "千羽鶴", "text": "そうね。\n彼女の魅惑……。"},
        { "location": "361/TALK"  , "narrator": "千羽鶴", "text": "恐らく、トライナリー全員\nの中で、一番――"},
        { "location": "362/TALK"  , "narrator": "千羽鶴", "text": "胸が小さい。"},
        { "location": "364/TALK"  , "narrator": "千羽鶴", "text": "……ごめん。\nこれは全然\n魅惑じゃなかった。"},
        { "location": "365/SEL"   , "narrator": "", "text": "わざとじゃない？"},
        { "location": "366/ACT"   , "narrator": "", "text": "わざとじゃない？"},
        { "location": "368/TALK"  , "narrator": "千羽鶴", "text": "とんでもない。"},
        { "location": "370/TALK"  , "narrator": "千羽鶴", "text": "例え、私が一番小さい\nわけじゃないことを\n言いたかったとしても――"},
        { "location": "371/TALK"  , "narrator": "千羽鶴", "text": "わざとそんなことを\n発表したりなんてしない。"},
        { "location": "375/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "377/ACT"   , "narrator": "", "text": "黙っている\n<color=blue>（※先へ進みます）</color>"},
        { "location": "379/TALK"  , "narrator": "千羽鶴", "text": "今回の記録映像は\n某高校でのフェノメノン戦\nの様子ではあるけど――"},
        { "location": "380/TALK"  , "narrator": "千羽鶴", "text": "その少し手前、\nフェノメノンへと侵入する\n間に焦点を当ててみる。"},
        { "location": "381/TALK"  , "narrator": "千羽鶴", "text": "フェノメノンは繭に\n包まれている。"},
        { "location": "382/TALK"  , "narrator": "千羽鶴", "text": "その繭は結構な厚みがあり、\nそれなりに長時間、その\n繭の中を歩くことになる。"},
        { "location": "383/TALK"  , "narrator": "千羽鶴", "text": "それは彼女達にとって、\n精神的にも大きな負担に\nなっている。"},
        { "location": "384/TALK"  , "narrator": "千羽鶴", "text": "そんな状況だから、\nひょんなことからもめ事が\n発生したりもする。"},
        { "location": "385/TALK"  , "narrator": "千羽鶴", "text": "今回はまさに、\nそれが発生した。"},
        { "location": "387/TALK"  , "narrator": "千羽鶴", "text": "貴方にサポートして欲しい\nのは、前回と同じ、繭の中\nでのもめ事のサポート。"},
        { "location": "391/TALK"  , "narrator": "千羽鶴", "text": "逢瀬つばめは、\nその当事者ともいえる\n存在になっている。"},
        { "location": "392/TALK"  , "narrator": "千羽鶴", "text": "初めてのフェノメノンという\nだけでも不安な状況。"},
        { "location": "393/TALK"  , "narrator": "千羽鶴", "text": "その中で、ガブリエラとの\n関係に関する問題まで\n発生してしまう。"},
        { "location": "394/TALK"  , "narrator": "千羽鶴", "text": "ここでの不安は、その後の\nバトルに大きく影響して\nしまう。"},
        { "location": "395/TALK"  , "narrator": "千羽鶴", "text": "彼女のココロの状態が\n少しでも改善するよう\nサポートしてあげて欲しい。"},
        { "location": "399/TALK"  , "narrator": "千羽鶴", "text": "國政綾水は、この問題の\n当事者ではない。"},
        { "location": "400/TALK"  , "narrator": "千羽鶴", "text": "けど、彼女はトライナリーを\nまとめるリーダーとしての\n自覚がとても強い。"},
        { "location": "401/TALK"  , "narrator": "千羽鶴", "text": "それ故に、今回のことも\n本人たち以上に、深刻に\n捉えてしまっている。"},
        { "location": "402/TALK"  , "narrator": "千羽鶴", "text": "貴方は客観的に状況を\n判断し、國政綾水にアド\nバイスをしてあげて欲しい。"},
        { "location": "403/TALK"  , "narrator": "千羽鶴", "text": "彼女のココロの焦りは、\nトライナリー全体の状況を\n大きく左右する。"},
        { "location": "404/TALK"  , "narrator": "千羽鶴", "text": "彼女のココロの状態が\n少しでも改善するよう\nサポートしてあげて欲しい。"},
        { "location": "408/TALK"  , "narrator": "千羽鶴", "text": "ガブリエラは、\n今回の問題を起こした\n張本人とも言える。"},
        { "location": "409/TALK"  , "narrator": "千羽鶴", "text": "しかし、それ自体は\n全く悪いことではない。"},
        { "location": "410/TALK"  , "narrator": "千羽鶴", "text": "寧ろ彼女のソルジャーと\nしての勘は、平和ぼけな\n他の隊員には良い刺激。"},
        { "location": "411/TALK"  , "narrator": "千羽鶴", "text": "けど、今ここでは\n少しマイルドに収めた方が\n全体としては好転する。"},
        { "location": "412/TALK"  , "narrator": "千羽鶴", "text": "貴方は、そんな彼女の\nココロの声を聞いてあげて、\n状況改善に努めてほしい。"},
        { "location": "413/TALK"  , "narrator": "千羽鶴", "text": "彼女をサポートすれば\n自ずと他の状況も\n改善することになる。"},
        { "location": "414/TALK"  , "narrator": "千羽鶴", "text": "彼女のココロの状態が\n少しでも改善するよう\nサポートしてあげて欲しい。"},
        { "location": "418/TALK"  , "narrator": "千羽鶴", "text": "恋ヶ崎みやびは、\n今回の件について言えば、\n傍観しているだけと言える。"},
        { "location": "419/TALK"  , "narrator": "千羽鶴", "text": "けど、そのココロの中では\n色々な思惑が渦巻いている。"},
        { "location": "420/TALK"  , "narrator": "千羽鶴", "text": "貴方はそんな彼女の\nココロと対話をし、\n彼女の様子を見て欲しい。"},
        { "location": "421/TALK"  , "narrator": "千羽鶴", "text": "彼女はあまり表には\n出さないけど、割と心が\n折れてしまうことが多い。"},
        { "location": "422/TALK"  , "narrator": "千羽鶴", "text": "貴方にはそんな彼女を\n常に注視し、そうならない\nよう支えてあげて欲しい。"},
        { "location": "423/TALK"  , "narrator": "千羽鶴", "text": "彼女の能力は、トライナリー\nの中では非常に特殊。"},
        { "location": "424/TALK"  , "narrator": "千羽鶴", "text": "索敵や分析、そして\n打開策の確立などは彼女が\n大きな役割を担っている。"},
        { "location": "425/TALK"  , "narrator": "千羽鶴", "text": "そんな彼女が、安定した\n精神状態で思考できるよう\nサポートしてあげて欲しい。"},
        { "location": "265/DIALOG", "narrator": "Tutorial/Dialog_Anime1", "text": "$dialog_word$"},
        { "location": "267/DIALOG", "narrator": "Tutorial/Dialog_Anime2", "text": "$dialog_word$"},
        { "location": "269/DIALOG", "narrator": "Tutorial/Dialog_Anime3", "text": "$dialog_word$"},
        { "location": "271/DIALOG", "narrator": "Tutorial/Dialog_Anime4", "text": "$dialog_word$"},
        { "location": "273/DIALOG", "narrator": "Tutorial/Dialog_Anime5", "text": "$dialog_word$"}
    ]
}
