{
    "dir": "chap18/daydra/dd_ch04_18_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "18405",
        "cid": "miyabi",
        "title": "005 メインストーリー",
        "sub_title": "WAREZ＜後編＞"
    },
    "entry":
    [
        { "location": "478/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "479/TALK"  , "narrator": "みやび", "text": "いや…もう悩むのは\nやめやな。"},
        { "location": "480/TALK"  , "narrator": "みやび", "text": "警戒は緩められん\nけんど。"},
        { "location": "481/TALK"  , "narrator": "みやび", "text": "ウサギに会いたい\n気持ちは本当やき。"},
        { "location": "482/TALK"  , "narrator": "みやび", "text": "…オッサンやない\nことを祈ってるぞね。"},
        { "location": "507/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "508/TALK"  , "narrator": "みやび", "text": "ウサギ…おるんか？"},
        { "location": "509/TALK"  , "narrator": "みやび", "text": "言う通りに来たがよ。\nおるんやったら\n姿現しぃ。"},
        { "location": "511/TALK"  , "narrator": "みやび", "text": "……ん？"},
        { "location": "517/TALK"  , "narrator": "繭", "text": "…………。"},
        { "location": "518/TALK"  , "narrator": "みやび", "text": "…光月さん？"},
        { "location": "519/TALK"  , "narrator": "繭", "text": "こんにちは、\nみやび先輩。"},
        { "location": "520/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "521/TALK"  , "narrator": "繭", "text": "みやび先輩？"},
        { "location": "522/TALK"  , "narrator": "みやび", "text": "あ、すまん。\nこんにちは。"},
        { "location": "524/TALK"  , "narrator": "みやび", "text": "…マジか。\nこのタイミングで\n屋上におるとは。"},
        { "location": "525/TALK"  , "narrator": "みやび", "text": "ちっくとタイミング\n悪過ぎぞね。"},
        { "location": "527/TALK"  , "narrator": "みやび", "text": "光月さん、\n申し訳ないけんど\n今からここで――"},
        { "location": "528/TALK"  , "narrator": "繭", "text": "お待ちしてました、\nみやび先輩。"},
        { "location": "529/TALK"  , "narrator": "みやび", "text": "…ん？"},
        { "location": "530/TALK"  , "narrator": "繭", "text": "驚きました…。\nまさか、こんなにも\n近くにいたなんて…。"},
        { "location": "531/TALK"  , "narrator": "みやび", "text": "…なんや？\n光月さんは、\n何を言うてるが？"},
        { "location": "532/TALK"  , "narrator": "繭", "text": "…わかりませんか？\nみやび先輩。"},
        { "location": "533/TALK"  , "narrator": "繭", "text": "いえ…Ｆａｔａｌ\nＱｕｅｅｎ。"},
        { "location": "537/TALK"  , "narrator": "みやび", "text": "っ！？"},
        { "location": "538/TALK"  , "narrator": "みやび", "text": "どういうことや！？\nどうして光月さんが\n何故その名を…。"},
        { "location": "539/TALK"  , "narrator": "みやび", "text": "まさか…この子が？"},
        { "location": "541/TALK"  , "narrator": "みやび", "text": "…うちのハンドル\nネーム、まさか\n知っちょるとはね。"},
        { "location": "542/TALK"  , "narrator": "みやび", "text": "それで？\nそれがどうかしたが？"},
        { "location": "543/TALK"  , "narrator": "繭", "text": "えっ！？\nまだお気づきに\nなりませんか？"},
        { "location": "544/TALK"  , "narrator": "繭", "text": "私です！\nＲＡＢＢＩＴ\nＡＮＩＭＡですよ！"},
        { "location": "546/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "548/TALK"  , "narrator": "みやび", "text": "え？　いや、\nちっくと待ちぃ。"},
        { "location": "550/TALK"  , "narrator": "みやび", "text": "つまり…光月さんが、\nウサギ？"},
        { "location": "551/TALK"  , "narrator": "繭", "text": "はい！\nウサギですよ、\nクイーン。"},
        { "location": "553/TALK"  , "narrator": "みやび", "text": "……う……"},
        { "location": "556/TALK"  , "narrator": "みやび", "text": "嘘やろーっ！？"},
        { "location": "557/TALK"  , "narrator": "みやび", "text": "まっこと！？\nまっことＲＡＢＢＩＴ\nＡＮＩＭＡなんか！？"},
        { "location": "559/TALK"  , "narrator": "繭", "text": "そうです！\n私がＲＡＢＢＩＴ\nＡＮＩＭＡです。"},
        { "location": "560/TALK"  , "narrator": "繭", "text": "あ、オフでは…、\n初めまして…。"},
        { "location": "561/TALK"  , "narrator": "みやび", "text": "…はは、あははは！"},
        { "location": "562/TALK"  , "narrator": "みやび", "text": "そうか！\nそうかぁ！"},
        { "location": "563/TALK"  , "narrator": "みやび", "text": "光月さんがウサギ\nやったかぁ！"},
        { "location": "564/TALK"  , "narrator": "繭", "text": "はい、そうです！"},
        { "location": "565/TALK"  , "narrator": "みやび", "text": "そうか…光月さんが\nウサギやったかぁ…。"},
        { "location": "566/TALK"  , "narrator": "みやび", "text": "…ん？　けんど、\nなんでわかったが？"},
        { "location": "567/TALK"  , "narrator": "繭", "text": "前回フェノメノンが\n出現した時\nなんですけど。"},
        { "location": "568/TALK"  , "narrator": "繭", "text": "私は光月繭として、\nみやび先輩に手伝いを\n申し出ましたよね？"},
        { "location": "569/TALK"  , "narrator": "繭", "text": "その際、光月繭の方へ\n送った作業は、簡単な\nものばかりでした。"},
        { "location": "570/TALK"  , "narrator": "みやび", "text": "それは…光月さんが\nウサギとは思わん\nかったきね。"},
        { "location": "571/TALK"  , "narrator": "みやび", "text": "そこまで出来る\n人間とは知らんかった\nがよ。"},
        { "location": "572/TALK"  , "narrator": "繭", "text": "仕方ありません。\n意図的にそう見せて\nいましたので。"},
        { "location": "573/TALK"  , "narrator": "みやび", "text": "…あ、わかった！"},
        { "location": "574/TALK"  , "narrator": "みやび", "text": "光月さんに頼んだ\n作業の結果を\nウサギに送った。"},
        { "location": "575/TALK"  , "narrator": "みやび", "text": "やき、うちが\nＦａｔａｌＱｕｅｅｎと\nわかったんやろ？"},
        { "location": "576/TALK"  , "narrator": "繭", "text": "惜しいですが、\n違います。"},
        { "location": "577/TALK"  , "narrator": "繭", "text": "それはきっかけに\nなっただけなんです。"},
        { "location": "578/TALK"  , "narrator": "繭", "text": "確信に至ったのは、\n私の報告に対する\n返答です。"},
        { "location": "579/TALK"  , "narrator": "みやび", "text": "…返答？\nうち、何かしたが？"},
        { "location": "580/TALK"  , "narrator": "繭", "text": "覚えていませんか？\nトロイの木馬の\n件ですよ。"},
        { "location": "581/TALK"  , "narrator": "みやび", "text": "ああ、侵入させろって\nウサギに指示したはず\nやけんど…。"},
        { "location": "582/TALK"  , "narrator": "繭", "text": "光月繭の方で、\n侵入させた報告を\n返したんです。"},
        { "location": "583/TALK"  , "narrator": "繭", "text": "そしたらみやび先輩、\nらじゃ、って返して\nきましたよね？"},
        { "location": "587/TALK"  , "narrator": "みやび", "text": "は！？\nうち、そんなこと\nしたが！？"},
        { "location": "590/TALK"  , "narrator": "繭", "text": "ふふっ…。\nぬかりましたね、\nクイーン。"},
        { "location": "591/TALK"  , "narrator": "みやび", "text": "はぁ～…。\nうちも、まだまだ\nツメが甘いなぁ…。"},
        { "location": "593/TALK"  , "narrator": "みやび", "text": "…けんど、おかげで\nリアルで会える\nことになったぞね。"},
        { "location": "594/TALK"  , "narrator": "みやび", "text": "しょうまっこと\n嬉しいちや、\nウサギ。"},
        { "location": "597/TALK"  , "narrator": "繭", "text": "私もです…、\nクイーン。"},
        { "location": "609/TALK"  , "narrator": "雛", "text": "…あっ、いたいた！\nこっちだよー！"},
        { "location": "627/TALK"  , "narrator": "雛", "text": "まゆちん、発見！"},
        { "location": "629/TALK"  , "narrator": "キリト", "text": "屋上なんかで\n何やってんだよ？"},
        { "location": "631/TALK"  , "narrator": "繭", "text": "…何しに来たの？"},
        { "location": "632/TALK"  , "narrator": "雛", "text": "お昼なのにいないから\n探しに来たんだよー。"},
        { "location": "633/TALK"  , "narrator": "キリト", "text": "みやび先輩と\n約束してたのか？"},
        { "location": "634/TALK"  , "narrator": "繭", "text": "…違う。\nそういう約束した\nわけじゃない。"},
        { "location": "635/TALK"  , "narrator": "キリト", "text": "じゃあ、どんな？"},
        { "location": "636/TALK"  , "narrator": "繭", "text": "…………。"},
        { "location": "646/TALK"  , "narrator": "つばめ", "text": "はぁ、はぁ…。\nひなこちゃん達、\n早過ぎだよぉ…。"},
        { "location": "648/TALK"  , "narrator": "つばめ", "text": "って、あれ？\nみやびさん。"},
        { "location": "649/TALK"  , "narrator": "みやび", "text": "つばめちゃんまで\n来たが？"},
        { "location": "650/TALK"  , "narrator": "つばめ", "text": "はい…。\nみやびさん達は、\n何してたんですか？"},
        { "location": "651/TALK"  , "narrator": "みやび", "text": "大したことやない。"},
        { "location": "652/TALK"  , "narrator": "みやび", "text": "ちっくと、親友と\n友情を深め合うてた\nだけやきね。"},
        { "location": "654/TALK"  , "narrator": "雛", "text": "はい？"},
        { "location": "655/TALK"  , "narrator": "キリト", "text": "親友？　繭が？"},
        { "location": "657/TALK"  , "narrator": "みやび", "text": "そうながよ。\nな、ウサギ？"},
        { "location": "659/TALK"  , "narrator": "繭", "text": "…そうですね。\nク――"},
        { "location": "660/TALK"  , "narrator": "繭", "text": "いえ…みやび先輩。"},
        { "location": "661/TALK"  , "narrator": "キリト", "text": "ウサギって、\n繭のあだ名か？"},
        { "location": "662/TALK"  , "narrator": "雛", "text": "かわいいー！\nあたしもウサギって\n呼ぼうかなー？"},
        { "location": "664/TALK"  , "narrator": "繭", "text": "呼ぶな。\nサルって呼び返すぞ？"},
        { "location": "665/TALK"  , "narrator": "つばめ", "text": "まゆちん、いつの間に\nみやびさんとそんなに\n仲良しになったの？"},
        { "location": "667/TALK"  , "narrator": "繭", "text": "…の、ノーコメント。"},
        { "location": "668/TALK"  , "narrator": "キリト", "text": "それくらい教えろよ。\n気になるじゃねぇか。"},
        { "location": "669/TALK"  , "narrator": "雛", "text": "ていうか、どうして\nウサギなのー？"},
        { "location": "671/TALK"  , "narrator": "みやび", "text": "ははっ…しばらくは\n質問攻めが続きそう\nやねぇ…。"},
        { "location": "673/SEL"   , "narrator": "", "text": "繭がＲＡＢＢＩＴＡＮＩＭＡだったんだね"},
        { "location": "674/ACT"   , "narrator": "", "text": "繭がＲＡＢＢＩＴＡＮＩＭＡだったんだね"},
        { "location": "691/TALK"  , "narrator": "みやび", "text": "うむ"},
        { "location": "692/TALK"  , "narrator": "みやび", "text": "あまりに予想外過ぎてアンビリバブル"},
        { "location": "693/TALK"  , "narrator": "みやび", "text": "けんど"},
        { "location": "694/TALK"  , "narrator": "みやび", "text": "嬉しい結果に大満足ぞね"},
        { "location": "696/SEL"   , "narrator": "", "text": "やっぱりオッサンじゃなかったから？"},
        { "location": "697/SEL"   , "narrator": "", "text": "相手が繭だったから？"},
        { "location": "698/ACT"   , "narrator": "", "text": "やっぱりオッサンじゃなかったから？"},
        { "location": "699/TALK"  , "narrator": "みやび", "text": "いや違う"},
        { "location": "700/TALK"  , "narrator": "みやび", "text": "オッサンだったとしても"},
        { "location": "701/TALK"  , "narrator": "みやび", "text": "会えたら嬉しいと思ってた"},
        { "location": "702/TALK"  , "narrator": "みやび", "text": "はず"},
        { "location": "705/TALK"  , "narrator": "みやび", "text": "まあ"},
        { "location": "706/TALK"  , "narrator": "みやび", "text": "安心したのも事実"},
        { "location": "707/TALK"  , "narrator": "みやび", "text": "オッサンじゃなくてよかったのかもしれん"},
        { "location": "709/TALK"  , "narrator": "みやび", "text": "けんど"},
        { "location": "710/TALK"  , "narrator": "みやび", "text": "超渋いコード書きよるきね"},
        { "location": "711/TALK"  , "narrator": "みやび", "text": "うちより年下なのに"},
        { "location": "712/TALK"  , "narrator": "みやび", "text": "まったく"},
        { "location": "713/TALK"  , "narrator": "みやび", "text": "面白い子や"},
        { "location": "724/ACT"   , "narrator": "", "text": "相手が繭だったから？"},
        { "location": "725/TALK"  , "narrator": "みやび", "text": "どうだろうか？"},
        { "location": "728/TALK"  , "narrator": "みやび", "text": "いや"},
        { "location": "729/TALK"  , "narrator": "みやび", "text": "それはあるかもしれん"},
        { "location": "730/TALK"  , "narrator": "みやび", "text": "リアルでＰＣの話できるの"},
        { "location": "731/TALK"  , "narrator": "みやび", "text": "光月さんくらいやったし"},
        { "location": "732/TALK"  , "narrator": "みやび", "text": "よくわからん子やったけんど"},
        { "location": "733/TALK"  , "narrator": "みやび", "text": "趣味合うたし"},
        { "location": "734/TALK"  , "narrator": "みやび", "text": "気に入ってたのは事実"},
        { "location": "735/TALK"  , "narrator": "みやび", "text": "つまり"},
        { "location": "736/TALK"  , "narrator": "みやび", "text": "光月さんがウサギで良かった思うてるがよ"},
        { "location": "739/TALK"  , "narrator": "みやび", "text": "ウサギには内緒やけんどな"},
        { "location": "761/DIALOG", "narrator": "Dialog_chapter_ch04", "text": "【15 弾の数だけ抱きしめて】"}
    ]
}
