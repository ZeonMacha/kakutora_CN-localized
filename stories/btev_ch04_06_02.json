    "entry":
    [
        { "location": "115/SCENARIO", "narrator": "", "text": "敵Ⅱ４"},
        { "location": "127/TALK"    , "narrator": "潜在みやび", "text": "相変わらず\n馬鹿力な想いやね。"},
        { "location": "128/TALK"    , "narrator": "表層みやび", "text": "クラン共を\nちぎっては投げ\nちぎっては投げ。"},
        { "location": "129/TALK"    , "narrator": "潜在みやび", "text": "毎回よう\n頑張っちょるなぁ。"},
        { "location": "130/TALK"    , "narrator": "表層みやび", "text": "その元気、\nいつまで続くかね。"},
        { "location": "132/TALK"    , "narrator": "潜在みやび", "text": "さて、と。\nほんだら、例によって\n例の如く――"},
        { "location": "134/TALK"    , "narrator": "表層みやび", "text": "敵対していた方の\n人格さんは消えるき。"},
        { "location": "135/TALK"    , "narrator": "潜在みやび", "text": "後はよろしく頼んだ。\nOR頼まれた。"},
        { "location": "136/TALK"    , "narrator": "表層みやび", "text": "頼んだOR頼まれた。"},
        { "location": "154/TALK"    , "narrator": "みやび", "text": "ふう。"},
        { "location": "155/SEL"     , "narrator": "（選択肢）", "text": "相変わらず徹底してるね"},
        { "location": "156/ACT"     , "narrator": "", "text": "相変わらず徹底してるね"},
        { "location": "158/TALK"    , "narrator": "みやび", "text": "うむ。\nハッカーたるもの\n身バレは最悪やきね。"},
        { "location": "159/TALK"    , "narrator": "みやび", "text": "とはいえ、もう\nお前さんにはそこまで\nせんでもえいか。"},
        { "location": "161/TALK"    , "narrator": "みやび", "text": "なあ$handle$。\n本当のところ、何が\n目的で近づいちょる？"},
        { "location": "162/TALK"    , "narrator": "みやび", "text": "ここまで拳で語り\n合ってきた仲や。"},
        { "location": "163/TALK"    , "narrator": "みやび", "text": "もう正直に教えて\nくれてもえいろう。"},
        { "location": "164/SEL"     , "narrator": "（選択肢）", "text": "みやびを助けたい"},
        { "location": "165/SEL"     , "narrator": "（選択肢）", "text": "みやびのことをもっと知りたい"},
        { "location": "166/SEL"     , "narrator": "（選択肢）", "text": "みやびを娶りたい"},
        { "location": "167/SEL"     , "narrator": "（選択肢）", "text": "フラグ立てるために仕方なく"},
        { "location": "168/ACT"     , "narrator": "", "text": "みやびを助けたい"},
        { "location": "169/TALK"    , "narrator": "みやび", "text": "前も聞いたけんど\nそれは本当かえ？"},
        { "location": "170/TALK"    , "narrator": "みやび", "text": "まあ、そこまで\n言うなら信じるぞね。"},
        { "location": "171/ACT"     , "narrator": "", "text": "みやびのことをもっと知りたい"},
        { "location": "172/TALK"    , "narrator": "みやび", "text": "知ってどうする？"},
        { "location": "173/TALK"    , "narrator": "みやび", "text": "やっぱりうちから\n何かを奪おうと\nしちょるが？"},
        { "location": "174/SEL"     , "narrator": "（選択肢）", "text": "なんでそんな警戒するの？"},
        { "location": "175/ACT"     , "narrator": "", "text": "なんでそんな警戒するの？"},
        { "location": "177/TALK"    , "narrator": "みやび", "text": "そういう性やきね。"},
        { "location": "178/TALK"    , "narrator": "みやび", "text": "まあえい。\n信じると決めたら\n信じるちや。"},
        { "location": "179/ACT"     , "narrator": "", "text": "みやびを娶りたい"},
        { "location": "180/TALK"    , "narrator": "みやび", "text": "ふむ。\nえい答えやね。"},
        { "location": "181/TALK"    , "narrator": "みやび", "text": "すなわちそれは、\n中の人がいる場合は\n好意的かつ――"},
        { "location": "182/TALK"    , "narrator": "みやび", "text": "現時点では物理的\n接触は不可能である\nということ。"},
        { "location": "183/TALK"    , "narrator": "みやび", "text": "逆にAIならば、\n単なるゴタクに\n過ぎん。"},
        { "location": "184/TALK"    , "narrator": "みやび", "text": "どちらにせよ、うちに\nとっては無害な存在っ\nちゅうことやきね。"},
        { "location": "185/ACT"     , "narrator": "", "text": "フラグ立てるために仕方なく"},
        { "location": "186/TALK"    , "narrator": "みやび", "text": "なるほどな。"},
        { "location": "187/TALK"    , "narrator": "みやび", "text": "ならば、割とどうでも\nいい存在ゆうこっちゃ\nな。お互いに。"},
        { "location": "188/TALK"    , "narrator": "みやび", "text": "それくらいがえいな。\n近いうちに、ここにも\n来なくなるじゃろ。"},
        { "location": "190/TALK"    , "narrator": "みやび", "text": "何にしても、今回の\nことは、うち全体に\nとって大きな変化や。"},
        { "location": "191/TALK"    , "narrator": "みやび", "text": "$handle$に\n対するスタンスに\n結論を出したわけやし。"},
        { "location": "192/TALK"    , "narrator": "みやび", "text": "現実のうちも、\nしばらくは大人しく\nつき合うじゃろ。"},
        { "location": "193/TALK"    , "narrator": "みやび", "text": "まあそんなわけで、\nせっかく和解した\nわけやし――"},
        { "location": "194/TALK"    , "narrator": "みやび", "text": "和解記念にひとつ\nちゅーでもしよか。"},
        { "location": "195/SEL"     , "narrator": "（選択肢）", "text": "是非！！"},
        { "location": "196/SEL"     , "narrator": "（選択肢）", "text": "遠慮します"},
        { "location": "197/ACT"     , "narrator": "", "text": "是非！！"},
        { "location": "198/TALK"    , "narrator": "みやび", "text": "うむ。\n素直が一番やきね。"},
        { "location": "216/TALK"    , "narrator": "みやび", "text": "さあ、はよう。"},
        { "location": "222/DIALOG"  , "narrator": "", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "234/TALK"    , "narrator": "みやび", "text": "ふぁっ…"},
        { "location": "237/TALK"    , "narrator": "みやび", "text": "ふぁっ…"},
        { "location": "241/DIALOG"  , "narrator": "", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"},
        { "location": "259/TALK"    , "narrator": "みやび", "text": "ふむ。\nえい『ちゅー』やった。"},
        { "location": "260/TALK"    , "narrator": "みやび", "text": "まあ、これも全て\n幻想でしかないの\nやけんどな。"},
        { "location": "261/SEL"     , "narrator": "（選択肢）", "text": "幻想？"},
        { "location": "262/ACT"     , "narrator": "", "text": "幻想？"},
        { "location": "264/TALK"    , "narrator": "みやび", "text": "当然や。\nここは精神世界。\n単なる妄想に過ぎん。"},
        { "location": "265/TALK"    , "narrator": "みやび", "text": "まあ、本気で\nうちに興味あるなら―"},
        { "location": "266/TALK"    , "narrator": "みやび", "text": "現実のうちと\n『ちゅー』できるよう\nがんばりや。"},
        { "location": "267/TALK"    , "narrator": "みやび", "text": "ここからが\n大変やきね。"},
        { "location": "268/ACT"     , "narrator": "", "text": "遠慮します"},
        { "location": "270/TALK"    , "narrator": "みやび", "text": "なに！？\n本気か！？"},
        { "location": "271/SEL"     , "narrator": "（選択肢）", "text": "裏が有りそう"},
        { "location": "272/ACT"     , "narrator": "", "text": "裏が有りそう"},
        { "location": "274/TALK"    , "narrator": "みやび", "text": "はぁ……\n可哀想なヤツやね。"},
        { "location": "275/TALK"    , "narrator": "みやび", "text": "きっと今まで\n世の中の全てを疑って\n生きてきたんやろな。"},
        { "location": "276/SEL"     , "narrator": "（選択肢）", "text": "みやび先輩にだけは言われたくないんですけど"},
        { "location": "277/ACT"     , "narrator": "", "text": "みやび先輩にだけは言われたくないんですけど"},
        { "location": "279/TALK"    , "narrator": "みやび", "text": "まあえいよ。"},
        { "location": "280/TALK"    , "narrator": "みやび", "text": "これが最初で最後の\nうちからのプレゼント\nやったけんど――"},
        { "location": "281/TALK"    , "narrator": "みやび", "text": "もらうもらわないは\nもらい手の自由やきね。"},
        { "location": "282/TALK"    , "narrator": "みやび", "text": "けんど、ここから先が\n本番ちや。"},
        { "location": "283/TALK"    , "narrator": "みやび", "text": "うちの深い所を見よう\nゆうなら、それなりに\n覚悟していきや。"}
    ]
}
