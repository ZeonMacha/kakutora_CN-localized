        { "location": "486/SCENARIO", "narrator": "", "text": "上質な生活"},
        { "location": "511/TALK"    , "narrator": "神楽", "text": "ぴょんこ思ったのですけどね？"},
        { "location": "512/TALK"    , "narrator": "神楽", "text": "毎日の手作りお弁当より"},
        { "location": "513/TALK"    , "narrator": "神楽", "text": "デリランチの方が飽きなくていいんじゃないかなーって"},
        { "location": "515/SEL"     , "narrator": "", "text": "ドライだね"},
        { "location": "516/SEL"     , "narrator": "", "text": "それもありだよね"},
        { "location": "517/SEL"     , "narrator": "", "text": "両方使い分ければいいと思うよ"},
        { "location": "518/ACT"     , "narrator": "", "text": "ドライだね"},
        { "location": "519/TALK"    , "narrator": "神楽", "text": "そうでしょうか？"},
        { "location": "520/TALK"    , "narrator": "神楽", "text": "そんなことないですよー！"},
        { "location": "521/ACT"     , "narrator": "", "text": "それもありだよね"},
        { "location": "522/TALK"    , "narrator": "神楽", "text": "でしょでしょ"},
        { "location": "523/TALK"    , "narrator": "神楽", "text": "$handle$さんは理解があってｽﾃｷ"},
        { "location": "524/ACT"     , "narrator": "", "text": "両方使い分ければいいと思うよ"},
        { "location": "525/TALK"    , "narrator": "神楽", "text": "確かにそうですよねっ♪"},
        { "location": "527/TALK"    , "narrator": "神楽", "text": "別にぴょんこは料理が出来ないわけじゃないんですよ"},
        { "location": "528/TALK"    , "narrator": "神楽", "text": "ただその時間をクリエイティブな創作にあてたいだけなんですっ"},
        { "location": "530/SEL"     , "narrator": "", "text": "料理も創作活動の一種"},
        { "location": "531/SEL"     , "narrator": "", "text": "人それぞれだよね"},
        { "location": "532/SEL"     , "narrator": "", "text": "ママに作ってもらえばいいでしょ"},
        { "location": "533/ACT"     , "narrator": "", "text": "料理も創作活動の一種"},
        { "location": "534/TALK"    , "narrator": "神楽", "text": "それも正しいんですけどね？"},
        { "location": "535/TALK"    , "narrator": "神楽", "text": "ぴょんこが一番力を注ぎたい創作活動じゃないんですよね、、、"},
        { "location": "536/ACT"     , "narrator": "", "text": "人それぞれだよね"},
        { "location": "537/TALK"    , "narrator": "神楽", "text": "そうなんですよねー♪"},
        { "location": "538/TALK"    , "narrator": "神楽", "text": "ひとそれぞれなんですっ"},
        { "location": "539/ACT"     , "narrator": "", "text": "ママに作ってもらえばいいでしょ"},
        { "location": "547/TALK"    , "narrator": "神楽", "text": "そんな子供じゃないんですよ"},
        { "location": "548/TALK"    , "narrator": "神楽", "text": "ぴょんこは★"},
        { "location": "550/SEL"     , "narrator": "", "text": "今のママじゃあね…"},
        { "location": "551/SEL"     , "narrator": "", "text": "まだ高校生だし"},
        { "location": "552/SEL"     , "narrator": "", "text": "たまには甘えればいいのに"},
        { "location": "553/ACT"     , "narrator": "", "text": "今のママじゃあね…"},
        { "location": "555/TALK"    , "narrator": "神楽", "text": "母も子育てが一段落したんです"},
        { "location": "556/TALK"    , "narrator": "神楽", "text": "ぴょんこは少しは楽をして欲しいって思ってる孝行娘なんですよっ♪"},
        { "location": "557/ACT"     , "narrator": "", "text": "まだ高校生だし"},
        { "location": "558/TALK"    , "narrator": "神楽", "text": "社会的には子供扱いかもしれませんけど"},
        { "location": "559/TALK"    , "narrator": "神楽", "text": "考えはオトナなんですよ♪"},
        { "location": "560/ACT"     , "narrator": "", "text": "たまには甘えればいいのに"},
        { "location": "561/TALK"    , "narrator": "神楽", "text": "甘える時は甘えたりしてますよ"},
        { "location": "562/TALK"    , "narrator": "神楽", "text": "でもそういうのちょっと気恥ずかしいお年頃なんですっ♪"},
        { "location": "565/TALK"    , "narrator": "神楽", "text": "世の中にはお昼ご飯のことなんかより大事なことがいっぱいあるんですよ"},
        { "location": "566/TALK"    , "narrator": "神楽", "text": "次のライブのコンセプトとか"},
        { "location": "567/TALK"    , "narrator": "神楽", "text": "それに合わせた衣装とか～～"},
        { "location": "569/SEL"     , "narrator": "", "text": "いやお昼の話は神楽が…"},
        { "location": "570/SEL"     , "narrator": "", "text": "ライブ楽しみ！"},
        { "location": "571/SEL"     , "narrator": "", "text": "セクシーな衣装キボン"},
        { "location": "572/ACT"     , "narrator": "", "text": "いやお昼の話は神楽が…"},
        { "location": "573/TALK"    , "narrator": "神楽", "text": "あっそうでしたね♪"},
        { "location": "574/TALK"    , "narrator": "神楽", "text": "女の子は移り気なんです～～～"},
        { "location": "575/ACT"     , "narrator": "", "text": "ライブ楽しみ！"},
        { "location": "576/TALK"    , "narrator": "神楽", "text": "ですよねですよね！"},
        { "location": "577/TALK"    , "narrator": "神楽", "text": "期待しててくださいねっ♪"},
        { "location": "578/ACT"     , "narrator": "", "text": "セクシーな衣装キボン"},
        { "location": "579/TALK"    , "narrator": "神楽", "text": "隠しても隠しても隠しきれない色香"},
        { "location": "580/TALK"    , "narrator": "神楽", "text": "そういうのがぴょんこの理想なので、、、"}
