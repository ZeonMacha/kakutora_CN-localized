    "entry":
    [
        { "location": "272/SCENARIO", "narrator": "", "text": "370_ 誰のための涙？"},
        { "location": "297/TALK"    , "narrator": "ガブリエラ", "text": "いる？"},
        { "location": "299/SEL"     , "narrator": "", "text": "いるよ"},
        { "location": "300/ACT"     , "narrator": "", "text": "いるよ"},
        { "location": "303/TALK"    , "narrator": "ガブリエラ", "text": "うん"},
        { "location": "304/TALK"    , "narrator": "ガブリエラ", "text": "いるわね"},
        { "location": "305/TALK"    , "narrator": "ガブリエラ", "text": "ええとね"},
        { "location": "307/TALK"    , "narrator": "ガブリエラ", "text": "ヒカルくんにね"},
        { "location": "308/TALK"    , "narrator": "ガブリエラ", "text": "すきなこがいたの"},
        { "location": "311/TALK"    , "narrator": "ガブリエラ", "text": "私じゃなかったの"},
        { "location": "314/SEL"     , "narrator": "", "text": "知ってる"},
        { "location": "315/SEL"     , "narrator": "", "text": "元気出して"},
        { "location": "316/SEL"     , "narrator": "", "text": "今日はゆっくりおやすみ"},
        { "location": "317/ACT"     , "narrator": "", "text": "知ってる"},
        { "location": "318/TALK"    , "narrator": "ガブリエラ", "text": "そうよね"},
        { "location": "319/ACT"     , "narrator": "", "text": "元気出して"},
        { "location": "320/TALK"    , "narrator": "ガブリエラ", "text": "なにそれ？"},
        { "location": "321/ACT"     , "narrator": "", "text": "今日はゆっくりおやすみ"},
        { "location": "322/TALK"    , "narrator": "ガブリエラ", "text": "ゆっくり、か・・・"},
        { "location": "323/TALK"    , "narrator": "ガブリエラ", "text": "なんだか時間が止まったみたいなの"},
        { "location": "325/TALK"    , "narrator": "ガブリエラ", "text": "へんなの"},
        { "location": "326/TALK"    , "narrator": "ガブリエラ", "text": "って"},
        { "location": "327/TALK"    , "narrator": "ガブリエラ", "text": "へんなのは私よね"},
        { "location": "329/SEL"     , "narrator": "", "text": "変じゃないよ"},
        { "location": "330/SEL"     , "narrator": "", "text": "なんでそう思うの？"},
        { "location": "331/ACT"     , "narrator": "", "text": "変じゃないよ"},
        { "location": "332/ACT"     , "narrator": "", "text": "なんでそう思うの？"},
        { "location": "335/TALK"    , "narrator": "ガブリエラ", "text": "一人芝居？"},
        { "location": "336/SEL"     , "narrator": "", "text": "うーん……"},
        { "location": "337/SEL"     , "narrator": "", "text": "これからのことを考えようよ"},
        { "location": "338/TALK"    , "narrator": "ガブリエラ", "text": "一人で盛り上がって、"},
        { "location": "340/TALK"    , "narrator": "ガブリエラ", "text": "いろいろ妄想したりして"},
        { "location": "342/ACT"     , "narrator": "", "text": "うーん……"},
        { "location": "343/ACT"     , "narrator": "", "text": "これからのことを考えようよ"},
        { "location": "345/TALK"    , "narrator": "ガブリエラ", "text": "貴方も笑ってたんでしょう？"},
        { "location": "346/TALK"    , "narrator": "ガブリエラ", "text": "バカみたいって思ってたんでしょう？"},
        { "location": "347/SEL"     , "narrator": "", "text": "そんなことないよ"},
        { "location": "348/SEL"     , "narrator": "", "text": "落ち着いて"},
        { "location": "349/TALK"    , "narrator": "ガブリエラ", "text": "面白がってたんでしょう？"},
        { "location": "350/TALK"    , "narrator": "ガブリエラ", "text": "叶うわけないのにって思ってたんでしょう？"},
        { "location": "353/ACT"     , "narrator": "", "text": "そんなことないよ"},
        { "location": "364/TALK"    , "narrator": "ガブリエラ", "text": "そんなことないなんて"},
        { "location": "365/TALK"    , "narrator": "ガブリエラ", "text": "ないなんて"},
        { "location": "366/TALK"    , "narrator": "ガブリエラ", "text": "嘘ばっかり！"},
        { "location": "367/ACT"     , "narrator": "", "text": "落ち着いて"},
        { "location": "368/TALK"    , "narrator": "ガブリエラ", "text": "うるさい！"},
        { "location": "369/TALK"    , "narrator": "ガブリエラ", "text": "うるさい！うるさい！うるさい！うるさい！"},
        { "location": "372/TALK"    , "narrator": "ガブリエラ", "text": "もうやだ！！！！"},
        { "location": "373/TALK"    , "narrator": "ガブリエラ", "text": "私なんで日本なんかに来たの？"},
        { "location": "378/SEL"     , "narrator": "", "text": "全部聞くよ"},
        { "location": "379/SEL"     , "narrator": "", "text": "気のすむまでつきあうから"},
        { "location": "380/ACT"     , "narrator": "", "text": "全部聞くよ"},
        { "location": "381/ACT"     , "narrator": "", "text": "気のすむまでつきあうから"},
        { "location": "384/TALK"    , "narrator": "ガブリエラ", "text": "ばか"},
        { "location": "385/TALK"    , "narrator": "ガブリエラ", "text": "うるさいわよ"},
        { "location": "386/TALK"    , "narrator": "ガブリエラ", "text": "偉そうなことばかり言って"},
        { "location": "387/TALK"    , "narrator": "ガブリエラ", "text": "ばか"},
        { "location": "388/TALK"    , "narrator": "ガブリエラ", "text": "本当にばか"},
        { "location": "389/TALK"    , "narrator": "ガブリエラ", "text": "ばかばかばーか"},
        { "location": "393/TALK"    , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "395/TALK"    , "narrator": "ガブリエラ", "text": "ちょっとだけ"},
        { "location": "398/TALK"    , "narrator": "ガブリエラ", "text": "なんでもないわ"},
        { "location": "399/TALK"    , "narrator": "ガブリエラ", "text": "なんでもないけど・・・"},
        { "location": "402/TALK"    , "narrator": "ボイスメール", "text": "ごめんね、おやすみなさい"},
        { "location": "420/TALK"    , "narrator": "ガブリエラ", "text": "おやすみなさい"},
        { "location": "359/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>900pt.</b></color></size>\nアップしました！"},
        { "location": "414/DIALOG"  , "narrator": "Dialog_GETVoice", "text": "<color=green>【ガブリエラ】</color>のボイスメール\n<color=red>【ごめんね、おやすみなさい】</color>\nをゲットしました！"}
    ]
