        { "location": "196/SCENARIO", "narrator": "", "text": "バトル中盤"},
        { "location": "205/TALK"    , "narrator": "潜在ガブリエラ", "text": "……強い。\nそんなはずは……"},
        { "location": "206/TALK"    , "narrator": "潜在ガブリエラ", "text": "まさか、\nマルザンナ……いえ、\nえっと……"},
        { "location": "207/SEL"     , "narrator": "", "text": "だから、$handle$です"},
        { "location": "208/ACT"     , "narrator": "", "text": "だから、$handle$です"},
        { "location": "210/TALK"    , "narrator": "潜在ガブリエラ", "text": "$handle$！\nあんたの力だって\nいうの！？"},
        { "location": "211/TALK"    , "narrator": "表層ガブリエラ", "text": "悔しいけど、\nそれはあるかもね。"},
        { "location": "212/TALK"    , "narrator": "表層ガブリエラ", "text": "でも今はそんなこと\nどうでもいいの。"},
        { "location": "213/TALK"    , "narrator": "表層ガブリエラ", "text": "あたしはあんたを\n一秒でも早く倒す。"},
        { "location": "214/TALK"    , "narrator": "表層ガブリエラ", "text": "そして、落ち着いて\n銃が撃てるように\nなるんだから！"},
        { "location": "215/TALK"    , "narrator": "潜在ガブリエラ", "text": "させないんだから！"},
        { "location": "216/TALK"    , "narrator": "潜在ガブリエラ", "text": "次で絶対に\n倒してあげるわ！！"}
    ]
