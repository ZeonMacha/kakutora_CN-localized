        { "location": "449/TALK", "narrator": "ガブリエラ", "text": "ねえ"},
        { "location": "451/TALK", "narrator": "ガブリエラ", "text": "コレって本物なのかしら？？？"},
        { "location": "454/SEL" , "narrator": "", "text": "もちろん"},
        { "location": "455/SEL" , "narrator": "", "text": "まあそこはほら……"},
        { "location": "456/ACT" , "narrator": "", "text": "もちろん"},
        { "location": "458/TALK", "narrator": "ガブリエラ", "text": "すごいわ"},
        { "location": "459/TALK", "narrator": "ガブリエラ", "text": "さすがねマルザンナ"},
        { "location": "461/ACT" , "narrator": "", "text": "まあそこはほら……"},
        { "location": "463/TALK", "narrator": "ガブリエラ", "text": "あらそうなの"},
        { "location": "464/TALK", "narrator": "ガブリエラ", "text": "あんまり深く聞かないようにするわ"},
        { "location": "466/TALK", "narrator": "ガブリエラ", "text": "でもどうして急に？"},
        { "location": "469/SEL" , "narrator": "", "text": "ホワイトデーだしちょっと特別なものをと思って"},
        { "location": "470/ACT" , "narrator": "", "text": "ホワイトデーだしちょっと特別なものをと思って"},
        { "location": "472/TALK", "narrator": "ガブリエラ", "text": "そうだったのねｖｖｖ"},
        { "location": "475/TALK", "narrator": "ガブリエラ", "text": "私中学で日本に留学することになったけど"},
        { "location": "476/TALK", "narrator": "ガブリエラ", "text": "そんなことがなかったらワルシャワ大学の日本学科に入るつもりだったの"},
        { "location": "477/TALK", "narrator": "ガブリエラ", "text": "もちろん日本にも留学できるならするつもりで"},
        { "location": "480/SEL" , "narrator": "", "text": "やっぱりアーヤの影響？"},
        { "location": "481/SEL" , "narrator": "", "text": "大学生のガブリエラと$me$が出会ったかもね"},
        { "location": "482/ACT" , "narrator": "", "text": "やっぱりアーヤの影響？"},
        { "location": "484/TALK", "narrator": "ガブリエラ", "text": "それは少しあるかもだけど"},
        { "location": "485/TALK", "narrator": "ガブリエラ", "text": "元々剣道が好きだったから"},
        { "location": "488/SEL" , "narrator": "", "text": "そうなの？"},
        { "location": "489/SEL" , "narrator": "", "text": "そうだったんだ"},
        { "location": "490/ACT" , "narrator": "", "text": "そうなの？"},
        { "location": "492/TALK", "narrator": "ガブリエラ", "text": "そうよ"},
        { "location": "493/TALK", "narrator": "ガブリエラ", "text": "他に理由なんてないわ"},
        { "location": "494/TALK", "narrator": "ガブリエラ", "text": "元々日本に興味があっただけ"},
        { "location": "495/ACT" , "narrator": "", "text": "そうだったんだ"},
        { "location": "497/TALK", "narrator": "ガブリエラ", "text": "剣道って格好いいでしょう？"},
        { "location": "498/TALK", "narrator": "ガブリエラ", "text": "武士道って感じで"},
        { "location": "499/TALK", "narrator": "ガブリエラ", "text": "憧れてたのよｖｖｖ"},
        { "location": "503/SEL" , "narrator": "", "text": "じゃなきゃ剣道の試合とか観に行かないか"},
        { "location": "504/SEL" , "narrator": "", "text": "だからわざわざ観に行ったんだ"},
        { "location": "505/ACT" , "narrator": "", "text": "じゃなきゃ剣道の試合とか観に行かないか"},
        { "location": "507/TALK", "narrator": "ガブリエラ", "text": "そうでしょう？"},
        { "location": "508/ACT" , "narrator": "", "text": "だからわざわざ観に行ったんだ"},
        { "location": "510/TALK", "narrator": "ガブリエラ", "text": "そうなのよ"},
        { "location": "512/TALK", "narrator": "ガブリエラ", "text": "でもね"},
        { "location": "513/TALK", "narrator": "ガブリエラ", "text": "そこで見かけたアーヤはとても格好良かったのよ"},
        { "location": "514/TALK", "narrator": "ガブリエラ", "text": "まさに明鏡止水の心を体現していたわ"},
        { "location": "517/SEL" , "narrator": "", "text": "やっぱりアーヤが好きなんでしょ"},
        { "location": "518/SEL" , "narrator": "", "text": "ツンデレなんだから"},
        { "location": "519/SEL" , "narrator": "", "text": "$me$も見たかったな"},
        { "location": "520/ACT" , "narrator": "", "text": "やっぱりアーヤが好きなんでしょ"},
        { "location": "522/TALK", "narrator": "ガブリエラ", "text": "それはね？"},
        { "location": "523/TALK", "narrator": "ガブリエラ", "text": "でもこんなことを言うのもあなただからよ"},
        { "location": "525/ACT" , "narrator": "", "text": "ツンデレなんだから"},
        { "location": "527/TALK", "narrator": "ガブリエラ", "text": "そういうわけじゃないわ"},
        { "location": "528/ACT" , "narrator": "", "text": "$me$も見たかったな"},
        { "location": "531/TALK", "narrator": "ガブリエラ", "text": "あの時のアーヤは本当に本当に格好良かったの"},
        { "location": "535/TALK", "narrator": "ガブリエラ", "text": "私もああなりたいの"},
        { "location": "536/TALK", "narrator": "ガブリエラ", "text": "どうすればああなれるかしら？"},
        { "location": "539/SEL" , "narrator": "", "text": "座禅でも一緒にすれば"},
        { "location": "540/SEL" , "narrator": "", "text": "剣道を教わる"},
        { "location": "541/SEL" , "narrator": "", "text": "ガブリエラにはガブリエラの良さがある"},
        { "location": "542/ACT" , "narrator": "", "text": "座禅でも一緒にすれば"},
        { "location": "544/TALK", "narrator": "ガブリエラ", "text": "座禅？"},
        { "location": "545/TALK", "narrator": "ガブリエラ", "text": "大変そうだけど"},
        { "location": "546/TALK", "narrator": "ガブリエラ", "text": "少しは近づける気がするわ"},
        { "location": "548/ACT" , "narrator": "", "text": "剣道を教わる"},
        { "location": "550/TALK", "narrator": "ガブリエラ", "text": "それができればいいんだけど"},
        { "location": "551/TALK", "narrator": "ガブリエラ", "text": "もうアーヤは剣道を辞めてしまったから"},
        { "location": "552/TALK", "narrator": "ガブリエラ", "text": "ちょっと無理よね"},
        { "location": "553/TALK", "narrator": "ガブリエラ", "text": "残念だけど"},
        { "location": "554/ACT" , "narrator": "", "text": "ガブリエラにはガブリエラの良さがある"},
        { "location": "556/TALK", "narrator": "ガブリエラ", "text": "そうかもだけど"},
        { "location": "557/TALK", "narrator": "ガブリエラ", "text": "そういうことじゃないのよ"},
        { "location": "558/TALK", "narrator": "ガブリエラ", "text": "わからないひとね"},
        { "location": "560/ACT" , "narrator": "", "text": "大学生のガブリエラと$me$が出会ったかもね"},
        { "location": "562/TALK", "narrator": "ガブリエラ", "text": "私たちが？"},
        { "location": "563/TALK", "narrator": "ガブリエラ", "text": "それって素敵ね"},
        { "location": "564/TALK", "narrator": "ガブリエラ", "text": "でもトライガジェットもなしに？"},
        { "location": "567/SEL" , "narrator": "", "text": "どうすればいいかな…"},
        { "location": "568/SEL" , "narrator": "", "text": "リアルに知り合うんだよ"},
        { "location": "569/ACT" , "narrator": "", "text": "どうすればいいかな…"},
        { "location": "571/TALK", "narrator": "ガブリエラ", "text": "何か方法はないかしら？"},
        { "location": "574/SEL" , "narrator": "", "text": "狼煙？"},
        { "location": "575/SEL" , "narrator": "", "text": "ライフルの選手権とかで"},
        { "location": "576/SEL" , "narrator": "", "text": "先輩後輩だったりして"},
        { "location": "577/ACT" , "narrator": "", "text": "狼煙？"},
        { "location": "579/TALK", "narrator": "ガブリエラ", "text": "意味がわからないわ？？？"},
        { "location": "580/ACT" , "narrator": "", "text": "ライフルの選手権とかで"},
        { "location": "582/TALK", "narrator": "ガブリエラ", "text": "それはあるかもしれないわね"},
        { "location": "583/ACT" , "narrator": "", "text": "先輩後輩だったりして"},
        { "location": "585/TALK", "narrator": "ガブリエラ", "text": "それ素敵ｖｖｖ"},
        { "location": "587/TALK", "narrator": "ガブリエラ", "text": "もしもの話って秘密を共有してるみたいね"},
        { "location": "588/TALK", "narrator": "ガブリエラ", "text": "違うかしら？"},
        { "location": "591/SEL" , "narrator": "", "text": "そうだね"},
        { "location": "592/SEL" , "narrator": "", "text": "もっと秘密を知りたいな"},
        { "location": "593/SEL" , "narrator": "", "text": "そういうのうれしいね"},
        { "location": "594/ACT" , "narrator": "", "text": "そうだね"},
        { "location": "596/TALK", "narrator": "ガブリエラ", "text": "ね？"},
        { "location": "597/TALK", "narrator": "ガブリエラ", "text": "なんだか楽しいわｖｖｖ"},
        { "location": "598/ACT" , "narrator": "", "text": "もっと秘密を知りたいな"},
        { "location": "600/TALK", "narrator": "ガブリエラ", "text": "私の？"},
        { "location": "602/ACT" , "narrator": "", "text": "そういうのうれしいね"},
        { "location": "604/TALK", "narrator": "ガブリエラ", "text": "そうよねｖｖｖ"},
        { "location": "605/TALK", "narrator": "ガブリエラ", "text": "うれしいわよねｖｖｖ"},
        { "location": "607/ACT" , "narrator": "", "text": "リアルに知り合うんだよ"},
        { "location": "609/TALK", "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "610/TALK", "narrator": "ガブリエラ", "text": "きっとそう"},
        { "location": "611/TALK", "narrator": "ガブリエラ", "text": "大学生の私はきっと素敵なレディよ"},
        { "location": "616/SEL" , "narrator": "", "text": "そんなガブリエラも見てみたいな"},
        { "location": "617/SEL" , "narrator": "", "text": "想像がつかない…"},
        { "location": "618/ACT" , "narrator": "", "text": "そんなガブリエラも見てみたいな"},
        { "location": "620/TALK", "narrator": "ガブリエラ", "text": "本当に？"},
        { "location": "621/ACT" , "narrator": "", "text": "想像がつかない…"},
        { "location": "623/TALK", "narrator": "ガブリエラ", "text": "実は私もそうなんだけど・・・"},
        { "location": "625/TALK", "narrator": "ガブリエラ", "text": "きっと桜の並木通りで二人は出会うの"},
        { "location": "626/TALK", "narrator": "ガブリエラ", "text": "目と目が合った瞬間、時が止まるような出会いよｖｖｖ"},
        { "location": "629/SEL" , "narrator": "", "text": "少女漫画だね……"},
        { "location": "630/SEL" , "narrator": "", "text": "それはどうかな…"},
        { "location": "631/ACT" , "narrator": "", "text": "少女漫画だね……"},
        { "location": "633/TALK", "narrator": "ガブリエラ", "text": "あらいいじゃない"},
        { "location": "634/TALK", "narrator": "ガブリエラ", "text": "それともそういうのは嫌い？"},
        { "location": "635/TALK", "narrator": "ガブリエラ", "text": "もしかして照れちゃう？"},
        { "location": "638/SEL" , "narrator": "", "text": "ちゃんと気づけるか不安だな"},
        { "location": "639/SEL" , "narrator": "", "text": "照れるけど嬉しいかな"},
        { "location": "640/ACT" , "narrator": "", "text": "ちゃんと気づけるか不安だな"},
        { "location": "642/TALK", "narrator": "ガブリエラ", "text": "それはそうかもしれないわね・・・"},
        { "location": "643/TALK", "narrator": "ガブリエラ", "text": "でも大丈夫よきっと"},
        { "location": "644/TALK", "narrator": "ガブリエラ", "text": "少なくとも私は絶対に気づくから"},
        { "location": "646/ACT" , "narrator": "", "text": "照れるけど嬉しいかな"},
        { "location": "648/TALK", "narrator": "ガブリエラ", "text": "本当？"},
        { "location": "649/TALK", "narrator": "ガブリエラ", "text": "世界のどこかの私たちはそうやって出会ったかもしれないわね"},
        { "location": "650/TALK", "narrator": "ガブリエラ", "text": "そう思うとちょっとロマンチックでしょ？"},
        { "location": "652/ACT" , "narrator": "", "text": "それはどうかな…"},
        { "location": "654/TALK", "narrator": "ガブリエラ", "text": "そうなのね残念だわ"},
        { "location": "655/TALK", "narrator": "ガブリエラ", "text": "じゃあマルザンナはどういうのがいいの？"},
        { "location": "658/SEL" , "narrator": "", "text": "空からガブリエラが落ちてくる"},
        { "location": "659/SEL" , "narrator": "", "text": "バイト先で知り合う"},
        { "location": "660/SEL" , "narrator": "", "text": "ＳＮＳかなー"},
        { "location": "661/ACT" , "narrator": "", "text": "空からガブリエラが落ちてくる"},
        { "location": "663/TALK", "narrator": "ガブリエラ", "text": "それこそアニメの観すぎじゃない？"},
        { "location": "664/TALK", "narrator": "ガブリエラ", "text": "でもちょっと面白いかも？"},
        { "location": "665/TALK", "narrator": "ガブリエラ", "text": "現実的じゃないけどね"},
        { "location": "666/ACT" , "narrator": "", "text": "バイト先で知り合う"},
        { "location": "668/TALK", "narrator": "ガブリエラ", "text": "それもいいわね"},
        { "location": "669/TALK", "narrator": "ガブリエラ", "text": "すごく青春してる感じで"},
        { "location": "670/TALK", "narrator": "ガブリエラ", "text": "楽しそう"},
        { "location": "671/ACT" , "narrator": "", "text": "ＳＮＳかなー"},
        { "location": "673/TALK", "narrator": "ガブリエラ", "text": "それじゃ今とあまり変わらないわ"},
        { "location": "674/TALK", "narrator": "ガブリエラ", "text": "でも現実的かもしれないわ"},
        { "location": "675/TALK", "narrator": "ガブリエラ", "text": "なんとなくだけど"}
