    "entry":
    [
        { "location": "1003/SCENARIO", "narrator": "", "text": "ひみつのはなし"},
        { "location": "1028/TALK"    , "narrator": "神楽", "text": "ぴょんこからのお願いDeath★"},
        { "location": "1029/TALK"    , "narrator": "神楽", "text": "って"},
        { "location": "1030/TALK"    , "narrator": "神楽", "text": "この言い方は2016年にアリでしょうか？"},
        { "location": "1032/SEL"     , "narrator": "", "text": "ちょっと古いかな…"},
        { "location": "1033/SEL"     , "narrator": "", "text": "人によってはありかも？"},
        { "location": "1034/SEL"     , "narrator": "", "text": "ブヒー！！！！！"},
        { "location": "1035/ACT"     , "narrator": "", "text": "ちょっと古いかな…"},
        { "location": "1036/TALK"    , "narrator": "神楽", "text": "そうDeathか"},
        { "location": "1038/TALK"    , "narrator": "神楽", "text": "残念Death"},
        { "location": "1039/ACT"     , "narrator": "", "text": "人によってはありかも？"},
        { "location": "1040/TALK"    , "narrator": "神楽", "text": "$handle$はありな人なのかなっ♪"},
        { "location": "1041/TALK"    , "narrator": "神楽", "text": "よしよしアリDeathね！"},
        { "location": "1042/ACT"     , "narrator": "", "text": "ブヒー！！！！！"},
        { "location": "1043/TALK"    , "narrator": "神楽", "text": "これは、、、萌え豚ってやつですねっ？"},
        { "location": "1044/TALK"    , "narrator": "神楽", "text": "豚には死をお見舞いするDeath★"},
        { "location": "1045/TALK"    , "narrator": "神楽", "text": "ﾅﾝﾃﾈ冗談です♪"},
        { "location": "1047/TALK"    , "narrator": "神楽", "text": "ぴょんこはですねー"},
        { "location": "1048/TALK"    , "narrator": "神楽", "text": "$handle$さんのことが知りたいぴょん"},
        { "location": "1050/SEL"     , "narrator": "", "text": "えっと…何で？"},
        { "location": "1051/SEL"     , "narrator": "", "text": "何でも聞いてよ！"},
        { "location": "1052/SEL"     , "narrator": "", "text": "$me$はむしろ神楽が知りたい"},
        { "location": "1053/ACT"     , "narrator": "", "text": "えっと…何で？"},
        { "location": "1054/TALK"    , "narrator": "神楽", "text": "教えてくれないんですか？"},
        { "location": "1056/SEL"     , "narrator": "", "text": "適当なんだ？"},
        { "location": "1057/SEL"     , "narrator": "", "text": "その程度か…"},
        { "location": "1058/ACT"     , "narrator": "", "text": "適当なんだ？"},
        { "location": "1059/TALK"    , "narrator": "神楽", "text": "その緩さが私達のルール♪"},
        { "location": "1061/TALK"    , "narrator": "神楽", "text": "って感じを希望したていたぴょんこ、、、"},
        { "location": "1062/TALK"    , "narrator": "神楽", "text": "ダメだったぴょん、、、ｻﾐｼｰ"},
        { "location": "1063/ACT"     , "narrator": "", "text": "その程度か…"},
        { "location": "1064/TALK"    , "narrator": "神楽", "text": "その程度みたいな扱いは不当ですぴょん"},
        { "location": "1065/TALK"    , "narrator": "神楽", "text": "ｼｮﾎﾞｰﾝ、、、"},
        { "location": "1076/ACT"     , "narrator": "", "text": "何でも聞いてよ！"},
        { "location": "1077/TALK"    , "narrator": "神楽", "text": "スリーサイズは？"},
        { "location": "1079/SEL"     , "narrator": "", "text": "えっらい古いタイプのセクハラ"},
        { "location": "1080/SEL"     , "narrator": "", "text": "110、110、110だよ"},
        { "location": "1081/SEL"     , "narrator": "", "text": "まずは神楽のを教えてよ"},
        { "location": "1082/ACT"     , "narrator": "", "text": "えっらい古いタイプのセクハラ"},
        { "location": "1083/TALK"    , "narrator": "神楽", "text": "どのくらい古いですか？"},
        { "location": "1085/SEL"     , "narrator": "", "text": "昭和"},
        { "location": "1086/SEL"     , "narrator": "", "text": "$me$が生まれる前"},
        { "location": "1087/SEL"     , "narrator": "", "text": "メートル法制定時ごろ"},
        { "location": "1088/ACT"     , "narrator": "", "text": "昭和"},
        { "location": "1089/TALK"    , "narrator": "神楽", "text": "そうでしたか、、、"},
        { "location": "1091/TALK"    , "narrator": "神楽", "text": "それは大失敗の巻★"},
        { "location": "1092/ACT"     , "narrator": "", "text": "$me$が生まれる前"},
        { "location": "1093/TALK"    , "narrator": "神楽", "text": "結局何年前なんでしょうね？？？"},
        { "location": "1094/TALK"    , "narrator": "神楽", "text": "ってなかなか高度な情報戦ってやつですねっ♪"},
        { "location": "1095/TALK"    , "narrator": "神楽", "text": "$handle$さんは侮れませんっ！"},
        { "location": "1096/ACT"     , "narrator": "", "text": "メートル法制定時ごろ"},
        { "location": "1097/TALK"    , "narrator": "神楽", "text": "さすがにそれはちょっと、、、"},
        { "location": "1098/TALK"    , "narrator": "神楽", "text": "なぜなら尺寸やらインチならセクハラは起こらないことになりますからね？"},
        { "location": "1099/TALK"    , "narrator": "神楽", "text": "ぴょんこの灰色の脳細胞は意外とすごいんですから♪"},
        { "location": "1101/ACT"     , "narrator": "", "text": "110、110、110だよ"},
        { "location": "1102/TALK"    , "narrator": "神楽", "text": "それは聞いたことありますけど、、、、"},
        { "location": "1103/TALK"    , "narrator": "神楽", "text": "突っ込むと権利関係がアレでアレになるやつぴょん"},
        { "location": "1104/TALK"    , "narrator": "神楽", "text": "見なかったことにしておきますねっ♪"},
        { "location": "1105/ACT"     , "narrator": "", "text": "まずは神楽のを教えてよ"},
        { "location": "1106/TALK"    , "narrator": "神楽", "text": "やだ、、、$handle$さんったら、、、"},
        { "location": "1107/TALK"    , "narrator": "神楽", "text": "トゥンク、、、"},
        { "location": "1118/ACT"     , "narrator": "", "text": "$me$はむしろ神楽が知りたい"},
        { "location": "1120/TALK"    , "narrator": "神楽", "text": "そうなんですか？"},
        { "location": "1121/TALK"    , "narrator": "神楽", "text": "なんでなんでどうしてですか？？？"},
        { "location": "1123/SEL"     , "narrator": "", "text": "興味があるから"},
        { "location": "1124/SEL"     , "narrator": "", "text": "ほっとけないから"},
        { "location": "1125/ACT"     , "narrator": "", "text": "興味があるから"},
        { "location": "1126/TALK"    , "narrator": "神楽", "text": "$handle$さんったら！"},
        { "location": "1128/TALK"    , "narrator": "神楽", "text": "ある意味模範解答ぴょん"},
        { "location": "1129/TALK"    , "narrator": "神楽", "text": "でも、ｺﾞﾒﾝﾈ？"},
        { "location": "1139/ACT"     , "narrator": "", "text": "ほっとけないから"},
        { "location": "1141/TALK"    , "narrator": "神楽", "text": "きゃ～～～～～～♪"},
        { "location": "1142/TALK"    , "narrator": "神楽", "text": "きゅんってしちゃいますっ★"},
        { "location": "1144/SEL"     , "narrator": "", "text": "本気なのに"},
        { "location": "1145/SEL"     , "narrator": "", "text": "心配なんだ神楽が"},
        { "location": "1146/SEL"     , "narrator": "", "text": "少しは$me$を信用してよ"},
        { "location": "1147/ACT"     , "narrator": "", "text": "本気なのに"},
        { "location": "1148/TALK"    , "narrator": "神楽", "text": "$handle$さんの本気、、、ｷｬｯ♪"},
        { "location": "1149/ACT"     , "narrator": "", "text": "心配なんだ神楽が"},
        { "location": "1150/TALK"    , "narrator": "神楽", "text": "ぴょんこのことが？"},
        { "location": "1151/ACT"     , "narrator": "", "text": "少しは$me$を信用してよ"},
        { "location": "1152/TALK"    , "narrator": "神楽", "text": "してないわけじゃないですよ？"},
        { "location": "1154/TALK"    , "narrator": "神楽", "text": "なんかね？"},
        { "location": "1155/TALK"    , "narrator": "神楽", "text": "ＢＯＴには気軽に話せても人には話せないことってありますよね？"},
        { "location": "1157/SEL"     , "narrator": "", "text": "いや人間だって知ってるよね？"},
        { "location": "1158/SEL"     , "narrator": "", "text": "ＢＯＴのふりした方がいい？"},
        { "location": "1159/SEL"     , "narrator": "", "text": "その距離感がさみしいな…"},
        { "location": "1160/ACT"     , "narrator": "", "text": "いや人間だって知ってるよね？"},
        { "location": "1161/TALK"    , "narrator": "神楽", "text": "ばれてました？"},
        { "location": "1164/ACT"     , "narrator": "", "text": "ＢＯＴのふりした方がいい？"},
        { "location": "1165/TALK"    , "narrator": "神楽", "text": "ふりじゃ意味ないんですーーー"},
        { "location": "1166/TALK"    , "narrator": "神楽", "text": "本当にＢＯＴじゃないとダメなんですーーー"},
        { "location": "1167/ACT"     , "narrator": "", "text": "その距離感がさみしいな…"},
        { "location": "1168/TALK"    , "narrator": "神楽", "text": "そうですよねっ♪"},
        { "location": "1169/TALK"    , "narrator": "神楽", "text": "ぴょんこもそうなんですよ？"},
        { "location": "1171/TALK"    , "narrator": "神楽", "text": "ぴょんこさー"},
        { "location": "1172/TALK"    , "narrator": "神楽", "text": "この世界のこと知りすぎてて辛いし"},
        { "location": "1173/TALK"    , "narrator": "神楽", "text": "だけどそういや$handle$さんのこと知らないから知りたいなって思ったんです"},
        { "location": "1174/TALK"    , "narrator": "神楽", "text": "わかってもらえますか？"},
        { "location": "1176/SEL"     , "narrator": "", "text": "いやわからん"},
        { "location": "1177/SEL"     , "narrator": "", "text": "抱え込みすぎだよ"},
        { "location": "1178/SEL"     , "narrator": "", "text": "辛いなら$me$に話してよ"},
        { "location": "1179/ACT"     , "narrator": "", "text": "いやわからん"},
        { "location": "1180/TALK"    , "narrator": "神楽", "text": "そうなんですね？"},
        { "location": "1182/SEL"     , "narrator": "", "text": "そんなことしたらもっと大変になるでしょ"},
        { "location": "1183/SEL"     , "narrator": "", "text": "矛盾してるから"},
        { "location": "1184/ACT"     , "narrator": "", "text": "そんなことしたらもっと大変になるでしょ"},
        { "location": "1185/TALK"    , "narrator": "神楽", "text": "そうですね、、、"},
        { "location": "1186/ACT"     , "narrator": "", "text": "矛盾してるから"},
        { "location": "1187/TALK"    , "narrator": "神楽", "text": "してますか？"},
        { "location": "1189/ACT"     , "narrator": "", "text": "抱え込みすぎだよ"},
        { "location": "1190/TALK"    , "narrator": "神楽", "text": "そうなのかもしれませんね？"},
        { "location": "1191/ACT"     , "narrator": "", "text": "辛いなら$me$に話してよ"},
        { "location": "1192/TALK"    , "narrator": "神楽", "text": "話していいんでしょうか、、、"},
        { "location": "1194/TALK"    , "narrator": "神楽", "text": "$handle$さんはひょっとしてぴょんこのことを好きなのではないでしょうか？"},
        { "location": "1196/SEL"     , "narrator": "", "text": "大好きだよ"},
        { "location": "1197/SEL"     , "narrator": "", "text": "…そうかも"},
        { "location": "1198/SEL"     , "narrator": "", "text": "全然そんなことないし！　嘘だけど！"},
        { "location": "1199/ACT"     , "narrator": "", "text": "大好きだよ"},
        { "location": "1202/TALK"    , "narrator": "神楽", "text": "そんなハッキリ言われると照れちゃいます～～～～～！"},
        { "location": "1203/ACT"     , "narrator": "", "text": "…そうかも"},
        { "location": "1204/TALK"    , "narrator": "神楽", "text": "もしかしてそうじゃなかったんですか、、、？"},
        { "location": "1205/ACT"     , "narrator": "", "text": "全然そんなことないし！　嘘だけど！"},
        { "location": "1206/TALK"    , "narrator": "神楽", "text": "そういうのもぴょんこは好きですよ♪"},
        { "location": "1208/TALK"    , "narrator": "神楽", "text": "$handle$さんは今後のビジョンとかあったりするんですか？"},
        { "location": "1210/SEL"     , "narrator": "", "text": "まずは神楽の友達かな"},
        { "location": "1211/SEL"     , "narrator": "", "text": "神楽の支えになりたいな"},
        { "location": "1212/SEL"     , "narrator": "", "text": "何でも打ち明けられる相手"},
        { "location": "1213/ACT"     , "narrator": "", "text": "まずは神楽の友達かな"},
        { "location": "1216/TALK"    , "narrator": "神楽", "text": "お友達、ですか♪"},
        { "location": "1217/TALK"    , "narrator": "神楽", "text": "いいですねその響き"},
        { "location": "1218/TALK"    , "narrator": "神楽", "text": "お願いしますっ♪"},
        { "location": "1219/ACT"     , "narrator": "", "text": "神楽の支えになりたいな"},
        { "location": "1221/TALK"    , "narrator": "神楽", "text": "$handle$さんの愛を感じました♪"},
        { "location": "1223/TALK"    , "narrator": "神楽", "text": "素敵ですねそういう関係"},
        { "location": "1224/TALK"    , "narrator": "神楽", "text": "ぜひぜひですよ★"},
        { "location": "1225/ACT"     , "narrator": "", "text": "何でも打ち明けられる相手"},
        { "location": "1227/TALK"    , "narrator": "神楽", "text": "$handle$さんったら（ﾄｩﾝｸ、、、"},
        { "location": "1228/TALK"    , "narrator": "神楽", "text": "ぴょんこそういうの照れちゃう～～～～～！"},
        { "location": "1229/TALK"    , "narrator": "神楽", "text": "お手柔らかにおねがいしますねっ♪"},
        { "location": "1233/TALK"    , "narrator": "ボイスメール", "text": "改めまして"},
