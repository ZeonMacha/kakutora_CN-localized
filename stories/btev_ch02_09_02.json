        "title": "018 ココロスフィアストーリー【Lv06】",
        "sub_title": "チャプター９＜帰結＞"
    },
    "entry":
    [
        { "location": "52/SCENARIO", "narrator": "", "text": "姉妹の隔絶・後編２"},
        { "location": "61/TALK"    , "narrator": "表層アーヤ", "text": "どうして……？\nなぜそこまで…"},
        { "location": "62/TALK"    , "narrator": "潜在アーヤ", "text": "もうそれくらいに\n嫌気がさしてるって\nことよ。"},
        { "location": "63/TALK"    , "narrator": "潜在アーヤ", "text": "$handle$さんも\n同意してるから\n力を貸してくれてる。"},
        { "location": "64/TALK"    , "narrator": "表層アーヤ", "text": "同意…ね。\nちょっと卑怯なんじゃ\nないかしら？"},
        { "location": "65/TALK"    , "narrator": "潜在アーヤ", "text": "…何が？"},
        { "location": "66/TALK"    , "narrator": "表層アーヤ", "text": "姉と私たちの関係\n伝えてはいたけど、\n全部じゃないわよね。"},
        { "location": "67/TALK"    , "narrator": "表層アーヤ", "text": "貴方が今伝えてある\nは、前提程度でしか\nない。"},
        { "location": "68/TALK"    , "narrator": "表層アーヤ", "text": "私たちが本当に姉に\n裏切られたと思ってる\n所は話してない。"},
        { "location": "69/TALK"    , "narrator": "潜在アーヤ", "text": "話したところで\n変わらないわよ。"},
        { "location": "70/TALK"    , "narrator": "表層アーヤ", "text": "どうかしら。"},
        { "location": "71/TALK"    , "narrator": "表層アーヤ", "text": "まあいいわ。\n私はもうここに存在\nすることはできない。"},
        { "location": "72/TALK"    , "narrator": "表層アーヤ", "text": "これ以上貴方と\nやりあうことは\nできないけど――"},
        { "location": "74/TALK"    , "narrator": "表層アーヤ", "text": "もし$handle$に\n良心があれば代わりに\n問い詰めるでしょう。"},
        { "location": "75/TALK"    , "narrator": "潜在アーヤ", "text": "…っ。"},
        { "location": "77/TALK"    , "narrator": "表層アーヤ", "text": "それじゃグッド\nラック。私とは\n息が合わない私さん。"},
        { "location": "87/TALK"    , "narrator": "潜在アーヤ", "text": "……。"},
        { "location": "96/SEL"     , "narrator": "（選択肢）", "text": "で、どういうこと？"},
        { "location": "97/SEL"     , "narrator": "（選択肢）", "text": "何も言わなくていいよ"},
        { "location": "98/ACT"     , "narrator": "", "text": "で、どういうこと？"},
        { "location": "99/TALK"    , "narrator": "潜在アーヤ", "text": "はぁ、わかったわよ。\n教える。"},
        { "location": "100/ACT"    , "narrator": "", "text": "何も言わなくていいよ"},
        { "location": "101/TALK"   , "narrator": "潜在アーヤ", "text": "ふふ、ありがと。\n貴方は優しいのね。"},
        { "location": "102/TALK"   , "narrator": "潜在アーヤ", "text": "でも、本当に重要だと\n思う時は、ちゃんと\n言っていいのよ？"},
        { "location": "104/TALK"   , "narrator": "潜在アーヤ", "text": "私自身も、フェアじゃ\nなかったってちょっと\n反省してるし。"},
        { "location": "108/TALK"   , "narrator": "潜在アーヤ", "text": "５０１号室で\nしたお話には、\n続きがあるのよ。"},
        { "location": "109/TALK"   , "narrator": "潜在アーヤ", "text": "今からそれを\n話すわ。"},
        { "location": "123/DIALOG" , "narrator": "", "text": "高校も３年になり、\n私も進路を考えなければ\nならない時期が来た。"},
        { "location": "124/DIALOG" , "narrator": "", "text": "当時、剣道の全国大会で優勝し、\n世界選手権ジュニア部門の\n最有力候補になっていた私は\n東京や大阪といった所にある\n幾つかの大学から\nオファーがかかっていたの。"},
        { "location": "125/DIALOG" , "narrator": "", "text": "家のことは心配だったけど\n姉も実家に隠っていたし、\n大学くらいは\n遠いところで一人暮らししても\n大丈夫だろう、なんて思っていた。"},
        { "location": "126/DIALOG" , "narrator": "", "text": "けど――"},
        { "location": "129/TALK"   , "narrator": "高校生アーヤ", "text": "あれ？"},
        { "location": "130/TALK"   , "narrator": "高校生アーヤ", "text": "お姉ちゃんは？"},
        { "location": "131/DIALOG" , "narrator": "", "text": "ある日、高校から帰ると\n姉はいなかった。\n\n姉の部屋の荷物も\n全部無くなっていた。"},
        { "location": "132/DIALOG" , "narrator": "", "text": "母が言うには、\n『すごい研究所から\nオファーがかかったから\nフランスへ行く』\nって――"},
        { "location": "133/TALK"   , "narrator": "高校生アーヤ", "text": "……なにそれ。"},
        { "location": "134/TALK"   , "narrator": "高校生アーヤ", "text": "最低…"},
        { "location": "135/TALK"   , "narrator": "高校生アーヤ", "text": "……最低よ…　…"},
        { "location": "136/DIALOG" , "narrator": "", "text": "私、そんなこと\n一言も\n教えてもらってないよ――"},
        { "location": "139/DIALOG" , "narrator": "", "text": "バカ姉。"},
        { "location": "157/DIALOG" , "narrator": "", "text": "その後私は\n何日もかけて考えて、\n結果として\n長野に残ることにした。"},
        { "location": "158/DIALOG" , "narrator": "", "text": "ずっと信州の山中に住んでいた私は、\nやはり年頃ってこともあって、\n東京の大学に行けることを\n内心凄くわくわくしてたんだけどね。"},
        { "location": "159/SEL"    , "narrator": "（選択肢）", "text": "そこまでしなくても良かったのでは？"},
        { "location": "160/SEL"    , "narrator": "（選択肢）", "text": "大変だったんだね。"},
        { "location": "161/ACT"    , "narrator": "", "text": "そこまでしなくても良かったのでは？"},
        { "location": "164/TALK"   , "narrator": "アーヤ", "text": "そうね。\nまあ普通の家なら\nそうかもしれない。"},
        { "location": "165/TALK"   , "narrator": "アーヤ", "text": "でもうちは両親ともに\n高齢で、結構仕事も\nハードだったし――"},
        { "location": "166/ACT"    , "narrator": "", "text": "大変だったんだね。"},
        { "location": "169/TALK"   , "narrator": "アーヤ", "text": "ありがと。\nあの時は本当に、精神\n的に大変だったわ。"},
        { "location": "170/TALK"   , "narrator": "アーヤ", "text": "うちは両親ともに\n高齢で、結構仕事も\nハードだったし――"},
        { "location": "172/TALK"   , "narrator": "アーヤ", "text": "家も山の上にあるから\n私も姉もいない状態で\n生きていけるか心配で。"},
        { "location": "174/TALK"   , "narrator": "アーヤ", "text": "……。"},
        { "location": "191/TALK"   , "narrator": "アーヤ", "text": "とまあ、\nこんな経緯よ。"},
        { "location": "192/TALK"   , "narrator": "アーヤ", "text": "これでだいたい、\n全部お話した。"},
        { "location": "193/SEL"    , "narrator": "（選択肢）", "text": "東京行きを断念したのが辛かったんだね。"},
        { "location": "194/SEL"    , "narrator": "（選択肢）", "text": "お姉さんが何も言わずに行ってしまったのが辛かったんだね。"},
        { "location": "195/ACT"    , "narrator": "", "text": "東京行きを断念したのが辛かったんだね。"},
        { "location": "196/TALK"   , "narrator": "アーヤ", "text": "そうね。"},
        { "location": "197/TALK"   , "narrator": "アーヤ", "text": "なんで姉ばっかり自由\nに生きて、私ばかり…\nって思ってた。"},
        { "location": "198/TALK"   , "narrator": "アーヤ", "text": "でもそれは、\n私が自分で決めて\nやってることだもの。"},
        { "location": "199/SEL"    , "narrator": "（選択肢）", "text": "責任感あるんだね"},
        { "location": "200/ACT"    , "narrator": "", "text": "責任感あるんだね"},
        { "location": "202/TALK"   , "narrator": "アーヤ", "text": "どうかしらね。"},
        { "location": "203/TALK"   , "narrator": "アーヤ", "text": "何だかんだで、\n事情はあれ、結局\n今は東京にいるし。"},
        { "location": "204/TALK"   , "narrator": "アーヤ", "text": "案外\nチャランポランよ？"},
        { "location": "205/ACT"    , "narrator": "", "text": "お姉さんが何も言わずに行ってしまったのが辛かったんだね。"},
        { "location": "206/TALK"   , "narrator": "アーヤ", "text": "それはない！"},
        { "location": "207/TALK"   , "narrator": "アーヤ", "text": "寧ろいなくなって\n胸をなで下ろしたわ。"},
        { "location": "208/SEL"    , "narrator": "（選択肢）", "text": "じゃあなんで、いなくなったとき泣いてたの？"},
        { "location": "209/ACT"    , "narrator": "", "text": "じゃあなんで、いなくなったとき泣いてたの？"},
        { "location": "211/TALK"   , "narrator": "アーヤ", "text": "え！？"},
        { "location": "212/TALK"   , "narrator": "アーヤ", "text": "あれは…"},
        { "location": "213/TALK"   , "narrator": "アーヤ", "text": "……。"},
        { "location": "214/TALK"   , "narrator": "アーヤ", "text": "…あまりに腹が立って\n泣けてきちゃっただけ。"},
        { "location": "216/TALK"   , "narrator": "アーヤ", "text": "さあ、この話は\nもうおしまい！"},
        { "location": "217/TALK"   , "narrator": "アーヤ", "text": "とにかく私は\nもうそんな過去のこと\n引きずりたくないの。"},
        { "location": "218/TALK"   , "narrator": "アーヤ", "text": "それより今は、\n姉と話して事情を\n聞きたい。"},
        { "location": "219/TALK"   , "narrator": "アーヤ", "text": "いろんなことを\n全部――"},
        { "location": "220/TALK"   , "narrator": "アーヤ", "text": "だから反対派が弱まっ\nて、現実の私が軟化す\nるまで戦い続けるわ。"},
        { "location": "221/TALK"   , "narrator": "アーヤ", "text": "だから、これからも\nよろしくね。"},
        { "location": "223/TALK"   , "narrator": "アーヤ", "text": "それじゃ、\nまた逢えるのを\n楽しみにしてるわ。"},
        { "location": "232/SEL"    , "narrator": "（選択肢）", "text": "ちょっと待った！"},
        { "location": "233/ACT"    , "narrator": "", "text": "ちょっと待った！"},
        { "location": "244/TALK"   , "narrator": "アーヤ", "text": "え？？"},
        { "location": "245/SEL"    , "narrator": "（選択肢）", "text": "デートは！？"},
        { "location": "246/ACT"    , "narrator": "", "text": "デートは！？"},
        { "location": "248/TALK"   , "narrator": "アーヤ", "text": "すごい！\nよく覚えてたわね。"},
        { "location": "249/TALK"   , "narrator": "アーヤ", "text": "そうね。\n約束だものね。"},
        { "location": "250/TALK"   , "narrator": "アーヤ", "text": "それじゃ、\nどこへ行こうか？"},
        { "location": "251/SEL"    , "narrator": "（選択肢）", "text": "海"},
        { "location": "252/SEL"    , "narrator": "（選択肢）", "text": "カフェ"},
        { "location": "253/SEL"    , "narrator": "（選択肢）", "text": "エヴェレット脳科学研究所"},
        { "location": "254/ACT"    , "narrator": "", "text": "海"},
        { "location": "256/TALK"   , "narrator": "アーヤ", "text": "はいはい、海ね。\n何を期待してるの？"},
        { "location": "258/TALK"   , "narrator": "アーヤ", "text": "服はこのままよ？"},
        { "location": "264/ACT"    , "narrator": "", "text": "カフェ"},
        { "location": "265/TALK"   , "narrator": "アーヤ", "text": "カフェ？\nいいわね。"},
        { "location": "271/ACT"    , "narrator": "", "text": "エヴェレット脳科学研究所"},
        { "location": "272/TALK"   , "narrator": "アーヤ", "text": "は？\nなにそれ。"},
        { "location": "273/TALK"   , "narrator": "アーヤ", "text": "そんな所\n知らない。"},
        { "location": "274/SEL"    , "narrator": "（選択肢）", "text": "え？　でも選択肢に…"},
        { "location": "275/SEL"    , "narrator": "（選択肢）", "text": "いや、本当は知ってるんでしょ？"},
        { "location": "276/ACT"    , "narrator": "", "text": "え？　でも選択肢に…"},
        { "location": "277/ACT"    , "narrator": "", "text": "いや、本当は知ってるんでしょ？"},
        { "location": "279/TALK"   , "narrator": "アーヤ", "text": "知らないって\n言ってるでしょ！！"},
        { "location": "280/TALK"   , "narrator": "アーヤ", "text": "もういい。\n気が変わった。\n今日はもうお終いよ。"},
        { "location": "281/TALK"   , "narrator": "アーヤ", "text": "じゃね。"},
        { "location": "288/TALK"   , "narrator": "アーヤ", "text": "ココロの中って\n便利よね。"},
        { "location": "289/TALK"   , "narrator": "アーヤ", "text": "妄想だけで、どこに\nでも行けちゃう。"},
        { "location": "290/SEL"    , "narrator": "（選択肢）", "text": "来て終わり？"},
        { "location": "291/ACT"    , "narrator": "", "text": "来て終わり？"},
        { "location": "293/TALK"   , "narrator": "アーヤ", "text": "え？"},
        { "location": "294/TALK"   , "narrator": "アーヤ", "text": "うーん、そうね…"},
        { "location": "295/TALK"   , "narrator": "アーヤ", "text": "じゃあ、\nちょっとだけなら\n触っていいわよ？"},
        { "location": "301/DIALOG" , "narrator": "", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "365/TALK"   , "narrator": "アーヤ", "text": "ふふっ。"},
        { "location": "367/TALK"   , "narrator": "アーヤ", "text": "ちょっと\n不思議な気分。"},
        { "location": "373/TALK"   , "narrator": "アーヤ", "text": "きゃっ！？"},
        { "location": "375/TALK"   , "narrator": "アーヤ", "text": "ちょ、ちょっと\n痛いってば！"},
        { "location": "381/TALK"   , "narrator": "アーヤ", "text": "もうっ。\n調子に乗らないの。"},
        { "location": "383/TALK"   , "narrator": "アーヤ", "text": "ダメだって！"},
        { "location": "390/TALK"   , "narrator": "アーヤ", "text": "もうっ！\nくすぐったいってば。"},
        { "location": "392/TALK"   , "narrator": "アーヤ", "text": "もしかして\nおなか出てる？"},
        { "location": "399/TALK"   , "narrator": "アーヤ", "text": "ふわっ！"},
        { "location": "401/TALK"   , "narrator": "アーヤ", "text": "なんか\n不思議な気持ち。"},
        { "location": "407/DIALOG" , "narrator": "", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"},
        { "location": "411/TALK"   , "narrator": "アーヤ", "text": "はい、おしまい。"},
        { "location": "412/SEL"    , "narrator": "（選択肢）", "text": "満足。"},
        { "location": "413/SEL"    , "narrator": "（選択肢）", "text": "もっと！"},
        { "location": "414/ACT"    , "narrator": "", "text": "満足。"},
        { "location": "415/TALK"   , "narrator": "アーヤ", "text": "はいはい。\n良かったわね。"},
        { "location": "416/ACT"    , "narrator": "", "text": "もっと！"},
        { "location": "417/TALK"   , "narrator": "アーヤ", "text": "もうお終い。\nね？"},
        { "location": "418/SEL"    , "narrator": "（選択肢）", "text": "…はい。"},
        { "location": "419/ACT"    , "narrator": "", "text": "…はい。"},
        { "location": "422/TALK"   , "narrator": "アーヤ", "text": "ふふっ。\n言うこと聞けて\nおりこうさんね。"},
        { "location": "438/TALK"   , "narrator": "アーヤ", "text": "と、ちょっとした\nお遊びでした。"},
        { "location": "440/TALK"   , "narrator": "アーヤ", "text": "といっても\nココロの中じゃ\n実感ないわよね。"},
        { "location": "441/SEL"    , "narrator": "（選択肢）", "text": "確かに！"},
        { "location": "442/SEL"    , "narrator": "（選択肢）", "text": "そんなことないよ！"},
        { "location": "443/ACT"    , "narrator": "", "text": "確かに！"},
        { "location": "444/TALK"   , "narrator": "アーヤ", "text": "正直でよろしい。"},
        { "location": "445/ACT"    , "narrator": "", "text": "そんなことないよ！"},
        { "location": "447/TALK"   , "narrator": "アーヤ", "text": "本当に？"},
        { "location": "450/TALK"   , "narrator": "アーヤ", "text": "でも、もう現実の\n私とスキンシップ\nできるような――"},
        { "location": "451/TALK"   , "narrator": "アーヤ", "text": "システムがある\nはずなんだけどね。"},
        { "location": "452/TALK"   , "narrator": "アーヤ", "text": "私の姉が\n作ってた気が――"},
        { "location": "453/TALK"   , "narrator": "アーヤ", "text": "…って、なんで私、\nそんなこと\n知ってるのかしら…。"}
    ]
}
