    "entry":
    [
        { "location": "25/TALK" , "narrator": "透明つばめ", "text": "あ、はーい！\n今出ますよー。"},
        { "location": "32/TALK" , "narrator": "透明つばめ", "text": "もしもし？"},
        { "location": "33/TALK" , "narrator": "透明啓介", "text": "…もしもしじゃない\nだろう？"},
        { "location": "35/TALK" , "narrator": "透明つばめ", "text": "お父さん。\nこんな時間に\nどうしたの？"},
        { "location": "36/TALK" , "narrator": "透明啓介", "text": "おまえの方から電話が\n全然来ないから、\n俺の方からかけたんだ。"},
        { "location": "37/TALK" , "narrator": "透明つばめ", "text": "いけない！\nまた電話するの\nサボッちゃってた…。"},
        { "location": "40/TALK" , "narrator": "透明つばめ", "text": "えと…ごめんね。\nちょっと、ドタバタ\nしちゃってて…。"},
        { "location": "41/TALK" , "narrator": "透明啓介", "text": "…引っ越し作業が\n大変なのか？"},
        { "location": "42/TALK" , "narrator": "透明つばめ", "text": "ううん、そうじゃ\nなくて…。"},
        { "location": "43/TALK" , "narrator": "透明啓介", "text": "なら、学校で\n何かトラブルでも\nあったのか？"},
        { "location": "45/TALK" , "narrator": "透明つばめ", "text": "そうじゃないよ。\nもぉ、お父さん\n心配し過ぎ！"},
        { "location": "47/TALK" , "narrator": "透明つばめ", "text": "つばめは元気で\nやってるから\n平気だよ。"},
        { "location": "48/TALK" , "narrator": "透明啓介", "text": "…じゃあ、どうして\n電話をしなかった？"},
        { "location": "51/TALK" , "narrator": "透明つばめ", "text": "えっ！？\nそれは――"},
        { "location": "52/TALK" , "narrator": "透明つばめ", "text": "クシュンッ！！"},
        { "location": "53/TALK" , "narrator": "透明啓介", "text": "どうした、風邪か？"},
        { "location": "54/TALK" , "narrator": "透明つばめ", "text": "あ、ううん…。\n何でもないよー。"},
        { "location": "55/TALK" , "narrator": "透明啓介", "text": "そうか…。"},
        { "location": "56/TALK" , "narrator": "透明啓介", "text": "それで？\nどうして電話をして\nこなかったんだ？"},
        { "location": "57/TALK" , "narrator": "透明つばめ", "text": "え、えっと…。"},
        { "location": "61/TALK" , "narrator": "透明啓介", "text": "――とにかく、\nそういうことだ。"},
        { "location": "62/TALK" , "narrator": "透明啓介", "text": "わかったら、\n電話くらいは\n毎日……"},
        { "location": "63/TALK" , "narrator": "透明啓介", "text": "いや、数日に一度は\nつばめの方から\nかけてきなさい。"},
        { "location": "65/TALK" , "narrator": "透明つばめ", "text": "はい…。\nごめんなさい…。"},
        { "location": "66/TALK" , "narrator": "透明啓介", "text": "…わかったなら、\nもういい。"},
        { "location": "67/TALK" , "narrator": "透明啓介", "text": "明日も学校だろう？\n暖かくして\n早く寝るように。"},
        { "location": "69/TALK" , "narrator": "透明つばめ", "text": "うん…おやすみ、\nお父さん。"},
        { "location": "75/TALK" , "narrator": "透明つばめ", "text": "はぁ…。"},
        { "location": "79/TALK" , "narrator": "つばめ", "text": "ぉ父さん"},
        { "location": "80/TALK" , "narrator": "つばめ", "text": "電話長過ぎーヾ(｡>﹏<｡)ﾉﾞ"},
        { "location": "81/TALK" , "narrator": "つばめ", "text": "身体冷ぇちゃった(o´Д`)=з"},
        { "location": "82/SEL"  , "narrator": "（選択肢）", "text": "どんな話だったの？"},
        { "location": "83/SEL"  , "narrator": "（選択肢）", "text": "サービスショットですね！"},
        { "location": "84/ACT"  , "narrator": "", "text": "どんな話だったの？"},
        { "location": "87/TALK" , "narrator": "つばめ", "text": "世間話をちょっとと"},
