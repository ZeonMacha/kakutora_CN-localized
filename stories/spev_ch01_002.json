        { "location": "121/TALK", "narrator": "つばめ", "text": "ぉ父さんはぉ母さん大好きだし"},
        { "location": "122/TALK", "narrator": "つばめ", "text": "ぉ母さんもぉ父さん大好きだから(´艸`*"},
