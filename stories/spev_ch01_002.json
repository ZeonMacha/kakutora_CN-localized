        { "location": "90/TALK" , "narrator": "つばめ", "text": "まぁ"},
        { "location": "92/TALK" , "narrator": "つばめ", "text": "自業自得だけど(´つω・｀)ｼｭﾝ"},
        { "location": "93/SEL"  , "narrator": "（選択肢）", "text": "お風呂上りだって言えばよかったのに"},
        { "location": "94/ACT"  , "narrator": "", "text": "お風呂上りだって言えばよかったのに"},
