{
    "dir": "chap08/daydra/dd_ch03_08_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "8305",
        "cid": "gabriella",
        "title": "005 メインストーリー",
        "sub_title": "大胆勝負～Case2～＜後編＞"
    },
    "entry":
    [
        { "location": "173/SCENARIO", "narrator": "", "text": "大胆勝負～Case2～"},
        { "location": "195/TALK"    , "narrator": "ガブリエラ", "text": "…そっか。"},
        { "location": "196/TALK"    , "narrator": "ガブリエラ", "text": "最近、アーヤと\n二人きりで話すこと\nなかったから――"},
        { "location": "197/TALK"    , "narrator": "ガブリエラ", "text": "それでこんな気持ちに\nなったのかも。"},
        { "location": "198/TALK"    , "narrator": "ガブリエラ", "text": "…久しぶりに\n二人きりになれたん\nだから――"},
        { "location": "199/TALK"    , "narrator": "ガブリエラ", "text": "何か話しておくべき\nだったかしら？"},
        { "location": "201/TALK"    , "narrator": "ガブリエラ", "text": "いやいや、だから\n話すようなこと\nないんだってば。"},
        { "location": "202/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "203/TALK"    , "narrator": "ガブリエラ", "text": "はぁ…。"},
        { "location": "204/SEL"     , "narrator": "", "text": "今日の戦いっぷりどうだった？と聞いてみろ"},
        { "location": "205/SEL"     , "narrator": "", "text": "見つめて「好き」とだけ言え"},
        { "location": "206/ACT"     , "narrator": "", "text": "今日の戦いっぷりどうだった？と聞いてみろ"},
        { "location": "225/TALK"    , "narrator": "ガブリエラ", "text": "嫌よ"},
        { "location": "227/TALK"    , "narrator": "ガブリエラ", "text": "そんなこと、自分から聞けないわ"},
        { "location": "228/TALK"    , "narrator": "ガブリエラ", "text": "第一、そういうのってリーダーのアーヤから言ってくるべきじゃない？"},
        { "location": "230/SEL"     , "narrator": "", "text": "そういうところ、可愛くないよ"},
        { "location": "231/ACT"     , "narrator": "", "text": "そういうところ、可愛くないよ"},
        { "location": "233/TALK"    , "narrator": "ガブリエラ", "text": "可愛くない！？"},
        { "location": "234/TALK"    , "narrator": "ガブリエラ", "text": "そう"},
        { "location": "235/TALK"    , "narrator": "ガブリエラ", "text": "そうよね"},
        { "location": "236/TALK"    , "narrator": "ガブリエラ", "text": "マルザンナの言う通りよね"},
        { "location": "237/TALK"    , "narrator": "ガブリエラ", "text": "反省するわ"},
        { "location": "238/TALK"    , "narrator": "ガブリエラ", "text": "でも、やっぱり自分から聞くなんて、恥ずかしいわ"},
        { "location": "240/SEL"     , "narrator": "", "text": "ただの質問だし、考え過ぎだよ"},
        { "location": "241/ACT"     , "narrator": "", "text": "ただの質問だし、考え過ぎだよ"},
        { "location": "243/TALK"    , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "244/TALK"    , "narrator": "ガブリエラ", "text": "ただの質問よね？"},
        { "location": "245/TALK"    , "narrator": "ガブリエラ", "text": "ありがとう、マルザンナ"},
        { "location": "246/TALK"    , "narrator": "ガブリエラ", "text": "私、頑張って聞いてみるわ"},
        { "location": "258/TALK"    , "narrator": "ガブリエラ", "text": "ふぅ…。"},
        { "location": "261/TALK"    , "narrator": "アーヤ", "text": "あら、まだいたの？\n早く服着ないと\n湯冷めするわよ？"},
        { "location": "263/TALK"    , "narrator": "ガブリエラ", "text": "う、うん…。"},
        { "location": "266/TALK"    , "narrator": "アーヤ", "text": "…？\nそれじゃ、また明日。"},
        { "location": "267/TALK"    , "narrator": "ガブリエラ", "text": "あ、アーヤ！"},
        { "location": "269/TALK"    , "narrator": "ガブリエラ", "text": "あの、今日の戦闘の\nことなんだけど…、\nあたし、どうだった？"},
        { "location": "271/TALK"    , "narrator": "アーヤ", "text": "そうね…。\n大活躍してたと\n思うわ。"},
        { "location": "273/TALK"    , "narrator": "ガブリエラ", "text": "う、ウソ！\nそんな活躍なんか\nしてないわ。"},
        { "location": "276/TALK"    , "narrator": "アーヤ", "text": "してたじゃない。\n忘れたの？"},
        { "location": "277/TALK"    , "narrator": "アーヤ", "text": "おとり作戦の時に、\n一発で仕留めてくれた\nでしょ？"},
        { "location": "278/TALK"    , "narrator": "アーヤ", "text": "もし、あの時に\nもっと時間をかけて\nたとしたら――"},
        { "location": "279/TALK"    , "narrator": "アーヤ", "text": "バリアが持たなくて、\nみやび達は無事じゃ\nすまなかったわ。"},
        { "location": "280/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "281/TALK"    , "narrator": "アーヤ", "text": "あの二人が無事だった\nのは、ギャヴィの\nおかげよ。"},
        { "location": "283/TALK"    , "narrator": "アーヤ", "text": "ありがとう。"},
        { "location": "287/TALK"    , "narrator": "ガブリエラ", "text": "あ、ぅ…。"},
        { "location": "289/TALK"    , "narrator": "ガブリエラ", "text": "べ、別に！\nあんなの、活躍でも\nなんでもないし！"},
        { "location": "290/TALK"    , "narrator": "ガブリエラ", "text": "大体、あんな簡単なの\n外すわけないん\nだから――"},
        { "location": "291/TALK"    , "narrator": "ガブリエラ", "text": "褒められても、\n全然嬉しくないわ！"},
        { "location": "295/TALK"    , "narrator": "アーヤ", "text": "ふふっ、だと思った。"},
        { "location": "296/TALK"    , "narrator": "アーヤ", "text": "これからも、\n頼りにしてるからね。"},
        { "location": "297/TALK"    , "narrator": "ガブリエラ", "text": "…………っ！"},
        { "location": "300/TALK"    , "narrator": "ガブリエラ", "text": "あっ、待って！\n最後にもう一つ！"},
        { "location": "302/TALK"    , "narrator": "アーヤ", "text": "何かしら？"},
        { "location": "303/TALK"    , "narrator": "ガブリエラ", "text": "頼りにしてるって\nことは――"},
        { "location": "304/TALK"    , "narrator": "ガブリエラ", "text": "アーヤにとって、\nあたしは必要…って\nこと？"},
        { "location": "306/TALK"    , "narrator": "アーヤ", "text": "えっ！？"},
        { "location": "308/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "310/TALK"    , "narrator": "アーヤ", "text": "今更聞く！？\nそんなの当然でしょ。"},
        { "location": "312/TALK"    , "narrator": "アーヤ", "text": "二人だけの時から、\nずっと一緒にやって\nきたんだもの。"},
        { "location": "313/TALK"    , "narrator": "アーヤ", "text": "安心して背中を\n任せられるのは、\nあなただけよ。"},
        { "location": "316/TALK"    , "narrator": "ガブリエラ", "text": "…そっか。"},
        { "location": "318/TALK"    , "narrator": "アーヤ", "text": "で？　そんなことが\n聞きたかったの？"},
        { "location": "319/TALK"    , "narrator": "ガブリエラ", "text": "か、確認よ、確認！"},
        { "location": "320/TALK"    , "narrator": "ガブリエラ", "text": "最近、あたしのこと\n過小評価してるみたい\nだったから…。"},
        { "location": "321/TALK"    , "narrator": "アーヤ", "text": "そんなことないから。\nほら、ギャヴィも早く\n部屋に戻りなさい。"},
        { "location": "324/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "325/TALK"    , "narrator": "ガブリエラ", "text": "ふふっ…。"},
        { "location": "327/TALK"    , "narrator": "ガブリエラ", "text": "やった…やった！！"},
        { "location": "328/TALK"    , "narrator": "ガブリエラ", "text": "アーヤの背中、\nあたしに任せられる\nって！！"},
        { "location": "329/TALK"    , "narrator": "ガブリエラ", "text": "最高の気分だわ。\nさっきまでの嫌な\n気分がウソみたい！"},
        { "location": "330/TALK"    , "narrator": "ガブリエラ", "text": "今夜はいい夢が\n見られそう。\n早く帰ろ。"},
        { "location": "338/TALK"    , "narrator": "ガブリエラ", "text": "…服を着るのが\n先だったわ。"},
        { "location": "339/ACT"     , "narrator": "", "text": "見つめて「好き」とだけ言え"},
        { "location": "358/TALK"    , "narrator": "ガブリエラ", "text": "何を言っているの！？"},
        { "location": "360/TALK"    , "narrator": "ガブリエラ", "text": "マルザンナ、もしかしておかしくなっちゃったの？"},
        { "location": "362/SEL"     , "narrator": "", "text": "ガブリエラのためを思って言っているのです"},
        { "location": "363/ACT"     , "narrator": "", "text": "ガブリエラのためを思って言っているのです"},
        { "location": "365/TALK"    , "narrator": "ガブリエラ", "text": "どこが？"},
        { "location": "366/TALK"    , "narrator": "ガブリエラ", "text": "やっぱり、どこかおかしくなったようにしか思えないんだけれど？"},
        { "location": "368/SEL"     , "narrator": "", "text": "私が誰か、忘れてしまったのですか？"},
        { "location": "369/ACT"     , "narrator": "", "text": "私が誰か、忘れてしまったのですか？"},
        { "location": "371/TALK"    , "narrator": "ガブリエラ", "text": "忘れてないわ"},
        { "location": "372/TALK"    , "narrator": "ガブリエラ", "text": "忘れてないけれど、意味がわからないのよ"},
        { "location": "374/SEL"     , "narrator": "", "text": "言いたくないのなら、構いませんが？"},
        { "location": "375/ACT"     , "narrator": "", "text": "言いたくないのなら、構いませんが？"},
        { "location": "377/TALK"    , "narrator": "ガブリエラ", "text": "ちょっと待って"},
        { "location": "378/TALK"    , "narrator": "ガブリエラ", "text": "マルザンナは、それを言ったらどうなるかがわかっているんでしょう？"},
        { "location": "379/TALK"    , "narrator": "ガブリエラ", "text": "なら、その結果を教えてちょうだい"},
        { "location": "381/SEL"     , "narrator": "", "text": "神託は、素晴らしい未来の示唆しかできない"},
        { "location": "382/ACT"     , "narrator": "", "text": "神託は、素晴らしい未来の示唆しかできない"},
        { "location": "384/TALK"    , "narrator": "ガブリエラ", "text": "ちょっとくらい教えてくれてもいいじゃない！"},
        { "location": "385/TALK"    , "narrator": "ガブリエラ", "text": "お願いよ、マルザンナ！"},
        { "location": "387/SEL"     , "narrator": "", "text": "信じる者は救われる。では、検討を祈る"},
        { "location": "388/ACT"     , "narrator": "", "text": "信じる者は救われる。では、検討を祈る"},
        { "location": "390/TALK"    , "narrator": "ガブリエラ", "text": "待ってマルz"},
        { "location": "394/TALK"    , "narrator": "ガブリエラ", "text": "ちょ、ウソでしょ！？\n強制終了するなんて！"},
        { "location": "399/TALK"    , "narrator": "ガブリエラ", "text": "どどどどうしよう。\n好きだなんて、\nそんなこと――"},
        { "location": "400/TALK"    , "narrator": "ガブリエラ", "text": "いや、そりゃまあ\n好きだけど、でも\n直接伝えるなんて…。"},
        { "location": "401/TALK"    , "narrator": "ガブリエラ", "text": "でも、いい結果に\nなるから言われたの\nかもしれないし…。"},
        { "location": "404/TALK"    , "narrator": "アーヤ", "text": "あら、まだいたの？\n早く服着ないと\n湯冷めするわよ？"},
        { "location": "407/TALK"    , "narrator": "ガブリエラ", "text": "あ、アーヤ！"},
        { "location": "409/TALK"    , "narrator": "アーヤ", "text": "どうしたの？"},
        { "location": "411/TALK"    , "narrator": "ガブリエラ", "text": "う、うん…。\nあの…あたし…。"},
        { "location": "413/TALK"    , "narrator": "アーヤ", "text": "……？"},
        { "location": "414/SEL"     , "narrator": "", "text": "早く言いなさい"},
        { "location": "416/TALK"    , "narrator": "ガブリエラ", "text": "あたし、ね…？\nあ、あああ、アーヤの\nことが…。"},
        { "location": "417/TALK"    , "narrator": "アーヤ", "text": "私？\n私がどうしたの？"},
        { "location": "418/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "419/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "424/TALK"    , "narrator": "ガブリエラ", "text": "い、言えないわよ！！\nマルザンナのバカー！"},
        { "location": "426/TALK"    , "narrator": "アーヤ", "text": "は、はぁ！？\nマルザンナって誰！？"},
        { "location": "429/TALK"    , "narrator": "アーヤ", "text": "って、ギャヴィ！！\n服！！　バスタオルで\n外に出る気！？"},
        { "location": "431/ACT"     , "narrator": "", "text": "早く言いなさい"},
        { "location": "436/TALK"    , "narrator": "ガブリエラ", "text": "もう！\nわかってるわよ！"},
        { "location": "437/TALK"    , "narrator": "ガブリエラ", "text": "絶対これ催促だわ。\n他人事だと思って…！"},
        { "location": "438/TALK"    , "narrator": "アーヤ", "text": "…それで、話って？"},
        { "location": "440/TALK"    , "narrator": "ガブリエラ", "text": "あ、あああ、あの！\nあの、ね――"},
        { "location": "442/TALK"    , "narrator": "ガブリエラ", "text": "…………す、好き。"},
        { "location": "443/TALK"    , "narrator": "アーヤ", "text": "ん？　そう。\n私もギャヴィのこと\n好きよ。"},
        { "location": "448/TALK"    , "narrator": "ガブリエラ", "text": "……へ？"},
        { "location": "451/TALK"    , "narrator": "アーヤ", "text": "ふふっ。\nいつも頑張ってくれて\nありがとう。"},
        { "location": "452/TALK"    , "narrator": "ガブリエラ", "text": "…が、頑張る？"},
        { "location": "453/TALK"    , "narrator": "ガブリエラ", "text": "え？　何これ？\nどういうこと？"},
        { "location": "454/TALK"    , "narrator": "ガブリエラ", "text": "アーヤもあたしのこと\n好きって…。"},
        { "location": "455/TALK"    , "narrator": "ガブリエラ", "text": "っていうか、頑張って\nくれてって…っ！？"},
        { "location": "456/TALK"    , "narrator": "ガブリエラ", "text": "まさか、普段から\nラブアタック\n頑張ってたの――"},
        { "location": "457/TALK"    , "narrator": "ガブリエラ", "text": "バレバレだった！？"},
        { "location": "460/TALK"    , "narrator": "ガブリエラ", "text": "ち、違うから！！\n頑張ってアタック\nなんかしてないわ！"},
        { "location": "463/TALK"    , "narrator": "アーヤ", "text": "そうなの？"},
        { "location": "464/TALK"    , "narrator": "アーヤ", "text": "いつも、ここぞという\nところでアタックして\nくれてるから――"},
        { "location": "465/TALK"    , "narrator": "アーヤ", "text": "正直、惚れちゃう時も\nあるくらいなん\nだけど。"},
        { "location": "467/TALK"    , "narrator": "ガブリエラ", "text": "…え、えぇっ！？"},
        { "location": "469/TALK"    , "narrator": "ガブリエラ", "text": "な、何、この展開！？\n急過ぎて、何が何だか\nわからないんだけど？"},
        { "location": "470/TALK"    , "narrator": "ガブリエラ", "text": "でもこれ、超急接近\nしてるってことよね？"},
        { "location": "472/TALK"    , "narrator": "ガブリエラ", "text": "っていうか、アーヤも\n好きってことは…、\n両想い！？"},
        { "location": "474/TALK"    , "narrator": "ガブリエラ", "text": "ああああ、あの、\nアーヤ！\nあたし――"},
        { "location": "477/TALK"    , "narrator": "アーヤ", "text": "今日の戦闘の時も\n凄かったわ。"},
        { "location": "478/TALK"    , "narrator": "アーヤ", "text": "あのおとり作戦の時の\n一撃必殺アタック、\n惚れ惚れしちゃった。"},
        { "location": "480/TALK"    , "narrator": "ガブリエラ", "text": "…は？　戦闘？"},
        { "location": "481/TALK"    , "narrator": "アーヤ", "text": "あの時のギャヴィの\n一撃がなかったら――"},
        { "location": "482/TALK"    , "narrator": "アーヤ", "text": "みやび達、\n無事じゃいられ\nなかったはずよ。"},
        { "location": "483/TALK"    , "narrator": "ガブリエラ", "text": "……は！？"},
        { "location": "486/TALK"    , "narrator": "ガブリエラ", "text": "ま、まさか…、\nもしかして今までの\n話って――"},
        { "location": "488/TALK"    , "narrator": "ガブリエラ", "text": "全部、戦闘のことだと\n思われてた！？"},
        { "location": "490/TALK"    , "narrator": "ガブリエラ", "text": "バカバカバカ！！\nあたしのバカ！！\n最低な早とちりよ！！"},
        { "location": "492/TALK"    , "narrator": "アーヤ", "text": "流石ね、ギャヴィ。\nかっこよかったわ。"},
        { "location": "495/TALK"    , "narrator": "ガブリエラ", "text": "と、ととと、当然よ！\nていうかあんなの、\n全然普通だし！"},
        { "location": "499/TALK"    , "narrator": "アーヤ", "text": "ふふっ、そうよね。\nこれからも、\n期待してるわ。"},
        { "location": "502/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "503/TALK"    , "narrator": "ガブリエラ", "text": "バトル以外の\nアタックも――"},
        { "location": "505/TALK"    , "narrator": "ガブリエラ", "text": "たまには\n見て欲しいのに…。\nアーヤの、ばか…。"},
        { "location": "517/DIALOG"  , "narrator": "Dialog_chapter_ch03", "text": "【06 史上最愛の作戦】"}
    ]
}
