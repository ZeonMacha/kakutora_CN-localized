{
    "dir": "chap01/battle/btev_ch01_01_01.js",
    "type": "Other",
    "info": {
        "story_id": "60101",
        "cid": "tsubame",
        "title": "最大幸福論＜葛藤＞",
        "sub_title": "バトル中間"
    },
    "entry":
    [
        { "location": "262/SCENARIO", "narrator": "", "text": "バトル中間"},
        { "location": "272/TALK"    , "narrator": "表層つばめ", "text": "っ！？\nあなたは…"},
        { "location": "273/TALK"    , "narrator": "潜在つばめ", "text": "わたしは\nあなたとは違うわたし。\nそして東京行き反対派。"},
        { "location": "274/TALK"    , "narrator": "潜在つばめ", "text": "そう、今戦った\n[クラン]をけしかけた\nのはわたしだよ。"},
        { "location": "275/TALK"    , "narrator": "潜在つばめ", "text": "ねえ、ライブに\n行きたいわたし。\nもう諦めようよ。"},
        { "location": "276/TALK"    , "narrator": "潜在つばめ", "text": "お母さんが大変なとき\nなのに、一人で楽しむ\nなんてできないよね？"},
        { "location": "277/TALK"    , "narrator": "表層つばめ", "text": "でも！"},
        { "location": "278/TALK"    , "narrator": "表層つばめ", "text": "メノウちゃんのライブ\nだって、何年も楽しみ\nにしてたんだから！"},
        { "location": "279/TALK"    , "narrator": "潜在つばめ", "text": "メノウちゃんのライブ\nならきっと、またすぐ\nあるよ。"},
        { "location": "280/TALK"    , "narrator": "潜在つばめ", "text": "それだけの理由なら、\n次のライブまで\n待ってもいいじゃん。"},
        { "location": "281/TALK"    , "narrator": "表層つばめ", "text": "ううん、でも、\nそれだけじゃない\n気がする。"},
        { "location": "282/TALK"    , "narrator": "潜在つばめ", "text": "……じゃあ他に何が？"},
        { "location": "283/TALK"    , "narrator": "表層つばめ", "text": "それは…"},
        { "location": "284/TALK"    , "narrator": "表層つばめ", "text": "それは……今は\nちょっと分からない\nかも。"},
        { "location": "285/TALK"    , "narrator": "潜在つばめ", "text": "はぁ。\nもういいよ。"},
        { "location": "286/TALK"    , "narrator": "潜在つばめ", "text": "とにかくあなたを\n倒して、東京行きを\n諦めさせないと――"},
        { "location": "287/TALK"    , "narrator": "潜在つばめ", "text": "このままじゃずっと\nわたしの本体が\n悩みっぱなしだから。"},
        { "location": "289/TALK"    , "narrator": "表層つばめ", "text": "それはこっちの\nセリフだよ！"},
        { "location": "290/TALK"    , "narrator": "潜在つばめ", "text": "両者一歩も退かずだね。\nそれじゃ――"},
        { "location": "291/TALK"    , "narrator": "潜在つばめ", "text": "次の戦いで\n決着を着けよう。"}
    ]
}
