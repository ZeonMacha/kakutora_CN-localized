        "title": "013 ココロスフィアストーリー【Lv05】",
        "sub_title": "転落人生＜提起＞"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "転落人生"},
        { "location": "13/DIALOG" , "narrator": "", "text": "<size=40>KOKORO-Lv. 05</size>\nAYAMI - KUNIMASA\n\n<size=45>転落人生</size>\n<size=30>～私が地の底まで落ちる予定の経緯～</size>"},
        { "location": "31/SEL"    , "narrator": "（選択肢）", "text": "！？"},
        { "location": "32/ACT"    , "narrator": "", "text": "！？"},
        { "location": "37/TALK"   , "narrator": "つばめ", "text": "おはようー！"},
        { "location": "38/TALK"   , "narrator": "つばめ", "text": "ふー。\n今日は遅刻しないで\n来れたよ！"},
        { "location": "39/SEL"    , "narrator": "（選択肢）", "text": "お、おう……"},
        { "location": "40/SEL"    , "narrator": "（選択肢）", "text": "えらいえらい"},
        { "location": "41/ACT"    , "narrator": "", "text": "お、おう……"},
        { "location": "42/TALK"   , "narrator": "つばめ", "text": "…？\nどうしたの？"},
        { "location": "43/ACT"    , "narrator": "", "text": "えらいえらい"},
        { "location": "45/TALK"   , "narrator": "つばめ", "text": "えへへ。\n$handle$に\n褒められちゃった。"},
        { "location": "52/TALK"   , "narrator": "神楽", "text": "つばめさん、\n$handle$さん、\nおはようございます！"},
        { "location": "54/TALK"   , "narrator": "つばめ", "text": "おはよう、\n卯月さん！"},
        { "location": "59/TALK"   , "narrator": "高校生アーヤ", "text": "おはよう、\n３人とも。"},
        { "location": "62/TALK"   , "narrator": "つばめ", "text": "あ、アーヤちん\nおはよう！"},
        { "location": "64/TALK"   , "narrator": "神楽", "text": "アーヤちゃん\nおはようございます！"},
        { "location": "65/SEL"    , "narrator": "（選択肢）", "text": "アーヤちん！？"},
        { "location": "66/ACT"    , "narrator": "", "text": "アーヤちん！？"},
        { "location": "73/TALK"   , "narrator": "つばめ", "text": "えっ！？\nわたし、何か\n変な事言った？"},
        { "location": "74/TALK"   , "narrator": "高校生アーヤ", "text": "どうしたの？\n$handle$、まだ\n寝ぼけてるでしょ。"},
        { "location": "75/TALK"   , "narrator": "高校生アーヤ", "text": "もう１時間早く起きて\n走り込みすると、朝の\n調子が良くなるわよ？"},
        { "location": "82/TALK"   , "narrator": "高校生アーヤ", "text": "それよりみんな、\nもう貼り出されてる\nみたいよ。"},
        { "location": "83/TALK"   , "narrator": "高校生アーヤ", "text": "先週の期末テストの\n順位。"},
        { "location": "85/TALK"   , "narrator": "つばめ", "text": "ええええええっ！！\nもう結果\n出ちゃってるの？"},
        { "location": "86/TALK"   , "narrator": "高校生アーヤ", "text": "逢瀬さん、\n今回のテストの\n自信のほどは？"},
        { "location": "88/TALK"   , "narrator": "つばめ", "text": "うーん…\nあんま無いかな。"},
        { "location": "90/TALK"   , "narrator": "つばめ", "text": "転校して初めてのテスト\nだったけど、前の学校\nより難しかったし…。"},
        { "location": "91/TALK"   , "narrator": "つばめ", "text": "結構わかんないとこ\n多くて、勘でマーク\nしたりしてたよ…。"},
        { "location": "92/TALK"   , "narrator": "高校生アーヤ", "text": "卯月さんは\nどうだった？"},
        { "location": "93/TALK"   , "narrator": "神楽", "text": "私も…どうでしょう。"},
        { "location": "94/TALK"   , "narrator": "神楽", "text": "つばめさんと同じく、\n転校して初めてなので\n何とも言えませんけど。"},
        { "location": "95/TALK"   , "narrator": "神楽", "text": "正直なところ、\nつばめさんと同じで\nかなり苦戦しました。"},
        { "location": "97/TALK"   , "narrator": "つばめ", "text": "アーヤちゃんは\nいつも１０番以内\nなんでしょ？"},
        { "location": "98/TALK"   , "narrator": "神楽", "text": "そうですよ！\n噂聞きましたよ？\n羨ましいです！"},
        { "location": "100/TALK"  , "narrator": "高校生アーヤ", "text": "そ、それは\n言い過ぎよ？"},
        { "location": "102/TALK"  , "narrator": "高校生アーヤ", "text": "まあ、身を削って勉強\nしてるし、そうでないと\n困るんだけど……。"},
        { "location": "104/TALK"  , "narrator": "高校生アーヤ", "text": "さあ、空いてる今の\nうちに見に行きましょ。"},
        { "location": "107/TALK"  , "narrator": "つばめ", "text": "あっ、待って\nアーヤちゃん！"},
        { "location": "114/TALK"  , "narrator": "千羽鶴", "text": "さあ、早く行かないと\n彼女達を見失うわよ。"},
        { "location": "133/TALK"  , "narrator": "高校生アーヤ", "text": "え……うそ……"},
        { "location": "136/TALK"  , "narrator": "つばめ", "text": "すごーい！！\n卯月さん１番だよ！"},
        { "location": "139/TALK"  , "narrator": "神楽", "text": "始めてでしたし、何を\n勉強すればいいかわかり\nませんでしたけど――"},
        { "location": "140/TALK"  , "narrator": "神楽", "text": "良い結果がでて\n良かったです！"},
        { "location": "142/TALK"  , "narrator": "つばめ", "text": "卯月さんって、すごい\n頭よかったんだね！\nびっくりだよ。"},
        { "location": "144/TALK"  , "narrator": "神楽", "text": "つばめさんこそ、\n３位なんて\nすごいじゃないですか。"},
        { "location": "146/TALK"  , "narrator": "つばめ", "text": "わ、わたしは本当に\nマークシートを適当に\n埋めただけだし……"},
        { "location": "147/TALK"  , "narrator": "つばめ", "text": "卯月さんとは\n全然ちがうよ……。"},
        { "location": "149/TALK"  , "narrator": "神楽", "text": "そんなこと\nありません！"},
        { "location": "150/TALK"  , "narrator": "神楽", "text": "適当にやって３位なら\n頑張ったら1位余裕\nですよ？"},
        { "location": "151/TALK"  , "narrator": "つばめ", "text": "えへへ。\nそうかなぁ。"},
        { "location": "153/TALK"  , "narrator": "高校生アーヤ", "text": "……。"},
        { "location": "155/TALK"  , "narrator": "つばめ", "text": "アーヤちゃんも\n９番なんてすごいね！"},
        { "location": "157/TALK"  , "narrator": "高校生アーヤ", "text": "…え？\nあ、ああ、ありがと…"},
        { "location": "168/TALK"  , "narrator": "真幌", "text": "卯月、逢瀬。\n今回は頑張ったな。"},
        { "location": "169/TALK"  , "narrator": "つばめ", "text": "あ、先生！\nおはようございます！"},
        { "location": "170/TALK"  , "narrator": "神楽", "text": "おはようございます！"},
        { "location": "172/TALK"  , "narrator": "真幌", "text": "まさか転校早々、\n学年トップになるとは\n思いもしなかったよ。"},
        { "location": "173/TALK"  , "narrator": "真幌", "text": "これは今後に\n期待大だな。"},
        { "location": "175/TALK"  , "narrator": "神楽", "text": "ありがとう\nございます！"},
        { "location": "176/TALK"  , "narrator": "真幌", "text": "ゆくゆくは生徒会長に\nなって、この学校を\nリードしてくれ。"},
        { "location": "178/TALK"  , "narrator": "高校生アーヤ", "text": "えっ！？！？"},
        { "location": "179/TALK"  , "narrator": "神楽", "text": "はいっ！\nがんばりますっ！"},
        { "location": "181/TALK"  , "narrator": "真幌", "text": "さて、お前たち。\nそろそろ１時間目の\n体育が始まるぞ。"},
        { "location": "182/TALK"  , "narrator": "真幌", "text": "遅れずに校庭に\n集合しろよ。"},
        { "location": "183/TALK"  , "narrator": "つばめ", "text": "は、はいっ！"},
        { "location": "185/TALK"  , "narrator": "高校生アーヤ", "text": "卯月さんと逢瀬さんが\n生徒会長候補！？"},
        { "location": "187/TALK"  , "narrator": "高校生アーヤ", "text": "そんな……\n私は！？\n今までの努力は？？"},
        { "location": "190/TALK"  , "narrator": "神楽", "text": "今日は長距離走\nだそうですよ？\nとっても憂鬱です…。"},
        { "location": "192/TALK"  , "narrator": "つばめ", "text": "えー…\nわたしも長距離走は\n苦手だよ。"},
        { "location": "198/TALK"  , "narrator": "神楽", "text": "アーヤさんは何年も\n長距離走の代表選手\nだったんですよね？"},
        { "location": "200/TALK"  , "narrator": "高校生アーヤ", "text": "えっ！？"},
        { "location": "203/TALK"  , "narrator": "高校生アーヤ", "text": "え、ええ、そうね。\n県大会とかにも出た\nことあるくらいには。"},
        { "location": "204/TALK"  , "narrator": "つばめ", "text": "すごーい！！\nいいなぁ……。"},
        { "location": "206/TALK"  , "narrator": "高校生アーヤ", "text": "そ、そうよね。\n勉強では負けても、\nスポーツなら……"},
        { "location": "207/TALK"  , "narrator": "高校生アーヤ", "text": "剣道だって世界選手権\nに出場したりしてるん\nだから……。"},
        { "location": "210/TALK"  , "narrator": "高校生アーヤ", "text": "さあ、早く着替えて\n行きましょ。"},
        { "location": "249/TALK"  , "narrator": "透明つばめ", "text": "はぁ……はぁ…\nもうだめー…限界！"},
        { "location": "250/TALK"  , "narrator": "透明神楽", "text": "あともう少しですよっ！\n頑張りましょう！"},
        { "location": "252/TALK"  , "narrator": "透明つばめ", "text": "卯月さんすごいよ。\n速すぎー！"},
        { "location": "254/TALK"  , "narrator": "透明神楽", "text": "つばめさんこそ\n十分速いですよ？"},
        { "location": "256/TALK"  , "narrator": "透明神楽", "text": "途中迷子になったときは\nどうしようかと\n思いましたけど。"},
        { "location": "258/TALK"  , "narrator": "透明つばめ", "text": "わたしももう、\n戻って来れないかと\n思ってたよ……"},
        { "location": "260/TALK"  , "narrator": "透明アーヤ", "text": "う、うそでしょ！？"},
        { "location": "261/TALK"  , "narrator": "透明アーヤ", "text": "なんであの二人の方が\n私より速いわけ！？"},
        { "location": "263/TALK"  , "narrator": "透明アーヤ", "text": "…はぁ、はぁ……\nもうダメ…"},
        { "location": "264/TALK"  , "narrator": "透明アーヤ", "text": "これでも今まで\n長距離で負けたことは\nなかったのに…っ"},
        { "location": "266/TALK"  , "narrator": "透明アーヤ", "text": "つばめは後ろにいたと\n思ったらいつの間にか\n前にいるし……"},
        { "location": "267/TALK"  , "narrator": "透明アーヤ", "text": "卯月なんて\n息も上がって\nないし……！"},
        { "location": "270/TALK"  , "narrator": "透明アーヤ", "text": "何よあれ！\nバケモノ！？"},
        { "location": "271/SEL"   , "narrator": "（選択肢）", "text": "バケモノは酷すぎじゃない？"},
        { "location": "272/ACT"   , "narrator": "", "text": "バケモノは酷すぎじゃない？"},
        { "location": "277/TALK"  , "narrator": "透明アーヤ", "text": "何よ！"},
        { "location": "279/TALK"  , "narrator": "透明アーヤ", "text": "$handle$は\n走ってもいないんだから\n黙ってて！"},
        { "location": "280/SEL"   , "narrator": "（選択肢）", "text": "$me$ってここではどういう存在なの？"},
        { "location": "281/ACT"   , "narrator": "", "text": "$me$ってここではどういう存在なの？"},
        { "location": "284/TALK"  , "narrator": "透明アーヤ", "text": "さあね…っ…\n私にもわからないわよ。\nハァ…ハァ…"},
        { "location": "286/TALK"  , "narrator": "透明アーヤ", "text": "なんか、空飛ぶ\nマスコットみたいな…\nそんなんじゃないの？"},
        { "location": "287/SEL"   , "narrator": "（選択肢）", "text": "見えてないんだ…"},
        { "location": "288/ACT"   , "narrator": "", "text": "見えてないんだ…"},
        { "location": "293/TALK"  , "narrator": "透明アーヤ", "text": "そんなことより…っ…\nあの二人よ！"},
        { "location": "294/TALK"  , "narrator": "透明アーヤ", "text": "あの二人は絶対に\nおかしいわよ…っ！"},
        { "location": "297/TALK"  , "narrator": "透明アーヤ", "text": "きっと何か、\n裏があるわ…っ！"},
        { "location": "299/TALK"  , "narrator": "透明アーヤ", "text": "でなければ、\nいきなり成績トップに\nなったり――"},
        { "location": "300/TALK"  , "narrator": "透明アーヤ", "text": "あんな平気な顔して\n走れたりなんて\nしないもの…っ……"},
        { "location": "306/TALK"  , "narrator": "透明アーヤ", "text": "お願いっ…\nあの二人を\nここから排除して！"},
        { "location": "307/SEL"   , "narrator": "（選択肢）", "text": "はい"},
        { "location": "308/SEL"   , "narrator": "（選択肢）", "text": "それは無理だと思う"},
        { "location": "309/SEL"   , "narrator": "（選択肢）", "text": "アーヤのダイナミックな揺れで話に集中できません"},
        { "location": "310/ACT"   , "narrator": "", "text": "はい"},
        { "location": "313/TALK"  , "narrator": "透明アーヤ", "text": "心強くて助かるわ！"},
        { "location": "315/TALK"  , "narrator": "透明アーヤ", "text": "よろしく！"},
        { "location": "317/SEL"   , "narrator": "（選択肢）", "text": "ごめんね、排除させてもらうよ"},
        { "location": "318/ACT"   , "narrator": "", "text": "ごめんね、排除させてもらうよ"},
        { "location": "323/TALK"  , "narrator": "透明神楽", "text": "え？"},
        { "location": "324/TALK"  , "narrator": "透明神楽", "text": "それ、本気で\n言ってるんですか？"},
        { "location": "349/TALK"  , "narrator": "つばめ", "text": "どうしたの？\n卯月さん。"},
        { "location": "352/TALK"  , "narrator": "神楽", "text": "$handle$さんが\n私を排除するって\n言うんですよ？"},
        { "location": "354/TALK"  , "narrator": "つばめ", "text": "ええっ！？\nそれは……"},
        { "location": "357/TALK"  , "narrator": "つばめ", "text": "絶対無理だよね！"},
        { "location": "360/TALK"  , "narrator": "神楽", "text": "やっぱりつばめさんも\nそう思いますよね？"},
        { "location": "361/SEL"   , "narrator": "（選択肢）", "text": "なんでそう言い切れる？"},
        { "location": "362/ACT"   , "narrator": "", "text": "なんでそう言い切れる？"},
        { "location": "365/TALK"  , "narrator": "神楽", "text": "考えても\nみてくださいね。"},
        { "location": "366/TALK"  , "narrator": "神楽", "text": "この世界で私たちは\nアーヤちゃんを越える\n存在なんです。"},
        { "location": "368/TALK"  , "narrator": "つばめ", "text": "そうなんだよね。\n無敵なんだよー。"},
        { "location": "369/TALK"  , "narrator": "神楽", "text": "そんな私たちが\n倒されるところなんて\n想像すると思います？"},
        { "location": "370/SEL"   , "narrator": "（選択肢）", "text": "どういう意味？"},
        { "location": "371/ACT"   , "narrator": "", "text": "どういう意味？"},
        { "location": "373/TALK"  , "narrator": "つばめ", "text": "うーん、一度やって\nみればわかるよ。\nねえ、卯月さん。"},
        { "location": "374/TALK"  , "narrator": "神楽", "text": "そうですね。\n是非排除してみて\nください。"},
        { "location": "375/SEL"   , "narrator": "（選択肢）", "text": "神楽を排除する"},
        { "location": "376/ACT"   , "narrator": "", "text": "神楽を排除する"},
        { "location": "386/TALK"  , "narrator": "神楽", "text": "あら？\n今何かやりましたか？"},
        { "location": "387/SEL"   , "narrator": "（選択肢）", "text": "つばめを排除する"},
        { "location": "388/ACT"   , "narrator": "", "text": "つばめを排除する"},
        { "location": "398/TALK"  , "narrator": "つばめ", "text": "うーん、そよ風が\n吹いたかな？"},
        { "location": "399/SEL"   , "narrator": "（選択肢）", "text": "！？"},
        { "location": "400/ACT"   , "narrator": "", "text": "！？"},
        { "location": "402/TALK"  , "narrator": "つばめ", "text": "だから言ってるじゃん。"},
        { "location": "403/TALK"  , "narrator": "神楽", "text": "この世界では私たちは\n無敵なんです。"},
        { "location": "404/TALK"  , "narrator": "神楽", "text": "何とかしたいなら、\nまずは私たちを無敵に\nしてる存在を……"},
        { "location": "405/TALK"  , "narrator": "つばめ", "text": "何とかするか、\n倒すかした方が\nいいんじゃないかなぁ。"},
        { "location": "406/TALK"  , "narrator": "神楽", "text": "まあでも……"},
        { "location": "407/TALK"  , "narrator": "つばめ", "text": "わたしたちを排除する\nような危険なひとは…"},
        { "location": "408/TALK"  , "narrator": "神楽", "text": "野放しにしては\nおけないですよね♪"},
        { "location": "409/TALK"  , "narrator": "つばめ", "text": "だよね～！"},
        { "location": "410/TALK"  , "narrator": "神楽", "text": "私たちが平和に\n過ごせるためにも\nここはひとつ…"},
        { "location": "411/TALK"  , "narrator": "つばめ", "text": "消えてもらおうね！"},
        { "location": "412/SEL"   , "narrator": "（選択肢）", "text": "ちょっと待って！"},
        { "location": "413/ACT"   , "narrator": "", "text": "ちょっと待って！"},
        { "location": "416/TALK"  , "narrator": "神楽", "text": "いいえ！\nもうダメですっ！"},
        { "location": "417/TALK"  , "narrator": "つばめ", "text": "いっくよーっ！！"},
        { "location": "431/TALK"  , "narrator": "千羽鶴", "text": "残念。"},
        { "location": "432/SEL"   , "narrator": "（選択肢）", "text": "どういうこと？"},
        { "location": "433/ACT"   , "narrator": "", "text": "どういうこと？"},
        { "location": "435/TALK"  , "narrator": "千羽鶴", "text": "ここは國政綾水の\n心の中。"},
        { "location": "436/TALK"  , "narrator": "千羽鶴", "text": "だから、卯月神楽や\n逢瀬つばめを作って\nいるのは――"},
        { "location": "437/TALK"  , "narrator": "千羽鶴", "text": "あくまでこの世界の\n國政綾水のココロ。"},
        { "location": "438/TALK"  , "narrator": "千羽鶴", "text": "國政綾水が卯月神楽\nたちを倒せないと\n思っている内は――"},
        { "location": "439/TALK"  , "narrator": "千羽鶴", "text": "絶対に倒す事は\nできない。"},
        { "location": "440/SEL"   , "narrator": "（選択肢）", "text": "何故倒せないと思ってるの？"},
        { "location": "441/ACT"   , "narrator": "", "text": "何故倒せないと思ってるの？"},
        { "location": "443/TALK"  , "narrator": "千羽鶴", "text": "さあ？\nそれは國政綾水本人に\n聞いてみたら？"},
        { "location": "444/TALK"  , "narrator": "千羽鶴", "text": "もう一度、\n挑戦してみるといい。"},
        { "location": "480/ACT"   , "narrator": "", "text": "それは無理だと思う"},
        { "location": "484/TALK"  , "narrator": "アーヤ", "text": "どうして！？"},
        { "location": "485/SEL"   , "narrator": "（選択肢）", "text": "えっと、ここって心の中だよね？"},
        { "location": "486/ACT"   , "narrator": "", "text": "えっと、ここって心の中だよね？"},
        { "location": "488/TALK"  , "narrator": "アーヤ", "text": "だから何！？"},
        { "location": "489/SEL"   , "narrator": "（選択肢）", "text": "あの二人はアーヤの妄想だよね？"},
        { "location": "490/ACT"   , "narrator": "", "text": "あの二人はアーヤの妄想だよね？"},
        { "location": "492/TALK"  , "narrator": "アーヤ", "text": "それで！？"},
        { "location": "493/SEL"   , "narrator": "（選択肢）", "text": "アーヤが無理だと思ってるものは覆せないのでは？"},
        { "location": "494/ACT"   , "narrator": "", "text": "アーヤが無理だと思ってるものは覆せないのでは？"},
        { "location": "497/TALK"  , "narrator": "アーヤ", "text": "そんなこと――"},
        { "location": "498/TALK"  , "narrator": "分身アーヤ", "text": "そのとおり。\n$handle$が正解。"},
        { "location": "501/TALK"  , "narrator": "アーヤ", "text": "誰！？"},
        { "location": "518/TALK"  , "narrator": "分身アーヤ", "text": "やっと出てこれた。"},
        { "location": "520/TALK"  , "narrator": "分身アーヤ", "text": "ありがとう、\n$handle$。\n貴方のお陰。"},
        { "location": "521/TALK"  , "narrator": "分身アーヤ", "text": "貴方が彼女に僅かな\n気の迷いを起こさせて\nくれたから。"},
        { "location": "522/SEL"   , "narrator": "（選択肢）", "text": "どういたしまして"},
        { "location": "523/ACT"   , "narrator": "", "text": "どういたしまして"},
        { "location": "525/TALK"  , "narrator": "アーヤ", "text": "気の迷いなんて\n全く無いわよ。"},
        { "location": "529/TALK"  , "narrator": "アーヤ", "text": "貴方も見てたでしょ？\nこの前のチャット世界\nでのフェノメノン戦。"},
        { "location": "530/TALK"  , "narrator": "アーヤ", "text": "卯月は初参戦なのに、\nあんなにしっかりと\n立ち回れたり――"},
        { "location": "531/TALK"  , "narrator": "アーヤ", "text": "つばめなんてクランを\n一発で壊せる力を\n持っていたりする。"},
        { "location": "533/TALK"  , "narrator": "アーヤ", "text": "慣れてくれば、今より\nもっと活躍するように\nなってくる。"},
        { "location": "534/TALK"  , "narrator": "アーヤ", "text": "そうなったら私なんて\nお払い箱よ！？"},
        { "location": "535/TALK"  , "narrator": "分身アーヤ", "text": "まだそんなの\nわからないでしょ？"},
        { "location": "536/TALK"  , "narrator": "アーヤ", "text": "分かるわよ！\nいずれリーダーだって\n二人に奪われちゃう。"},
        { "location": "537/TALK"  , "narrator": "アーヤ", "text": "私なんて、いても\nいなくても変わらない\n存在になるから。"},
        { "location": "540/TALK"  , "narrator": "分身アーヤ", "text": "はぁ……。"},
        { "location": "542/TALK"  , "narrator": "分身アーヤ", "text": "$handle$、\n申し訳無いけど、\n手伝ってくれる？"},
        { "location": "543/TALK"  , "narrator": "分身アーヤ", "text": "この子を追い出すの。"},
        { "location": "544/SEL"   , "narrator": "（選択肢）", "text": "いいよ"},
        { "location": "545/ACT"   , "narrator": "", "text": "いいよ"},
        { "location": "549/TALK"  , "narrator": "アーヤ", "text": "追い出される\nもんですか！"},
        { "location": "550/TALK"  , "narrator": "アーヤ", "text": "貴方のような脳天気な\n私の方が、私にとって\n有害な存在よ！"},
        { "location": "551/TALK"  , "narrator": "分身アーヤ", "text": "悲観的過ぎる方が\nよっぽど有害。"},
        { "location": "552/TALK"  , "narrator": "アーヤ", "text": "もういいわ。\nどっちがより有害か、\n戦えばすぐにわかる。"},
        { "location": "553/TALK"  , "narrator": "分身アーヤ", "text": "そうね。\n私もそう思ってた\nところよ。"},
        { "location": "554/TALK"  , "narrator": "アーヤ", "text": "意見が一致して\n良かった。\nそれじゃ、いくわよ！"},
        { "location": "555/TALK"  , "narrator": "分身アーヤ", "text": "臨むところよ！"},
        { "location": "567/DIALOG", "narrator": "", "text": "<color=black><size=50><b>自分を卑下する\n悲観的なアーヤを倒せ！</b></size></color>\n\n\n\n\n確かに新人たちはとても能力が高い。\nでもだからといって、\n今までの蓄積が全て無くなるわけじゃない。\n\n悲観的になりすぎている\nアーヤを倒して、\n彼女の自信を取り戻させよう。"},
        { "location": "570/ACT"   , "narrator": "", "text": "アーヤのダイナミックな揺れで話に集中できません"},
        { "location": "574/TALK"  , "narrator": "アーヤ", "text": "は！？"},
        { "location": "575/TALK"  , "narrator": "アーヤ", "text": "人が真面目に\n悩んでるのに\n何言ってるの！？"},
        { "location": "576/TALK"  , "narrator": "アーヤ", "text": "もういいです！\n出ていって！"},
        { "location": "590/TALK"  , "narrator": "千羽鶴", "text": "…強者ね。"},
        { "location": "591/SEL"   , "narrator": "（選択肢）", "text": "眼福でした"},
        { "location": "592/SEL"   , "narrator": "（選択肢）", "text": "息抜きも大切"},
        { "location": "593/ACT"   , "narrator": "", "text": "眼福でした"},
        { "location": "594/ACT"   , "narrator": "", "text": "息抜きも大切"},
        { "location": "596/TALK"  , "narrator": "千羽鶴", "text": "そうね。"},
        { "location": "597/TALK"  , "narrator": "千羽鶴", "text": "まあ、何度でも\nやり直せるし。"},
        { "location": "598/TALK"  , "narrator": "千羽鶴", "text": "$handle$が\nヒマなら何度\nやっても大丈夫。"},
        { "location": "599/TALK"  , "narrator": "千羽鶴", "text": "けど、國政綾水と\nより強い絆を育みたい\nのなら――"},
        { "location": "600/TALK"  , "narrator": "千羽鶴", "text": "TPOをわきまえた\n選択もまた重要。"},
        { "location": "601/TALK"  , "narrator": "千羽鶴", "text": "まあ、小姑の説教は\nこれくらいにしておく。"},
        { "location": "602/TALK"  , "narrator": "千羽鶴", "text": "最終的な判断は\n貴方がすることだから。"}
    ]
}
