    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "90_義理立てはするもの"},
        { "location": "32/TALK"   , "narrator": "アーヤ", "text": "さっきトライナリーの子達とした話"},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "なんだけど、"},
        { "location": "35/SEL"    , "narrator": "", "text": "うん"},
        { "location": "36/SEL"    , "narrator": "", "text": "聞いてたよ"},
        { "location": "37/ACT"    , "narrator": "", "text": "うん"},
        { "location": "38/ACT"    , "narrator": "", "text": "聞いてたよ"},
        { "location": "40/TALK"   , "narrator": "アーヤ", "text": "そうよね"},
        { "location": "41/TALK"   , "narrator": "アーヤ", "text": "念のためだけど"},
        { "location": "42/TALK"   , "narrator": "アーヤ", "text": "貴方が人間かもしれないって"},
        { "location": "43/TALK"   , "narrator": "アーヤ", "text": "トライナリーのみんなに教えたって話よ"},
        { "location": "45/SEL"    , "narrator": "", "text": "知ってるって"},
        { "location": "46/SEL"    , "narrator": "", "text": "わかってるってば"},
        { "location": "47/ACT"    , "narrator": "", "text": "知ってるって"},
        { "location": "48/TALK"   , "narrator": "アーヤ", "text": "そうよね、、、"},
        { "location": "49/ACT"    , "narrator": "", "text": "わかってるってば"},
        { "location": "50/TALK"   , "narrator": "アーヤ", "text": "そう？"},
        { "location": "52/TALK"   , "narrator": "アーヤ", "text": "肩の荷が降りたような"},
        { "location": "53/TALK"   , "narrator": "アーヤ", "text": "もっとやっかいごとができたような"},
        { "location": "54/TALK"   , "narrator": "アーヤ", "text": "複雑な気持ちよ"},
        { "location": "57/SEL"    , "narrator": "", "text": "そんな深刻にならないで"},
        { "location": "58/SEL"    , "narrator": "", "text": "気楽にやろうよ"},
        { "location": "59/ACT"    , "narrator": "", "text": "そんな深刻にならないで"},
        { "location": "60/TALK"   , "narrator": "アーヤ", "text": "なるわよ"},
        { "location": "61/TALK"   , "narrator": "アーヤ", "text": "鳴るに決まってるわ"},
        { "location": "62/TALK"   , "narrator": "アーヤ", "text": "なるに"},
        { "location": "63/ACT"    , "narrator": "", "text": "気楽にやろうよ"},
        { "location": "64/TALK"   , "narrator": "アーヤ", "text": "そういうふうに"},
        { "location": "65/TALK"   , "narrator": "アーヤ", "text": "割り切れないわ"},
        { "location": "67/TALK"   , "narrator": "アーヤ", "text": "最初から言っててくれれば"},
        { "location": "69/TALK"   , "narrator": "アーヤ", "text": "こんな風に"},
        { "location": "70/TALK"   , "narrator": "アーヤ", "text": "こじれなかったのに"},
        { "location": "72/SEL"    , "narrator": "", "text": "まあまあ"},
        { "location": "73/SEL"    , "narrator": "", "text": "事情があって"},
        { "location": "74/SEL"    , "narrator": "", "text": "システム的に無理だった"},
        { "location": "75/ACT"    , "narrator": "", "text": "まあまあ"},
        { "location": "76/TALK"   , "narrator": "アーヤ", "text": "ほんと"},
        { "location": "77/TALK"   , "narrator": "アーヤ", "text": "のんきね"},
        { "location": "78/ACT"    , "narrator": "", "text": "事情があって"},
        { "location": "79/TALK"   , "narrator": "アーヤ", "text": "まあ"},
        { "location": "80/TALK"   , "narrator": "アーヤ", "text": "そうなんだろうけど"},
        { "location": "81/ACT"    , "narrator": "", "text": "システム的に無理だった"},
        { "location": "82/TALK"   , "narrator": "アーヤ", "text": "なんだか"},
        { "location": "83/TALK"   , "narrator": "アーヤ", "text": "いろんな事情がありそうね、、、"},
        { "location": "85/TALK"   , "narrator": "アーヤ", "text": "でも全員"},
        { "location": "86/TALK"   , "narrator": "アーヤ", "text": "違うこと言ってたわ"},
        { "location": "87/TALK"   , "narrator": "アーヤ", "text": "そういうものかもしれないけど"},
        { "location": "88/TALK"   , "narrator": "アーヤ", "text": "ちょっと不思議"},
        { "location": "90/SEL"    , "narrator": "", "text": "乙女心は複雑怪奇"},
        { "location": "91/SEL"    , "narrator": "", "text": "観察力が足りないね"},
        { "location": "92/SEL"    , "narrator": "", "text": "アーヤはどう思ってる？"},
        { "location": "94/ACT"    , "narrator": "", "text": "乙女心は複雑怪奇"},
        { "location": "95/TALK"   , "narrator": "アーヤ", "text": "ええと、、、"},
        { "location": "97/TALK"   , "narrator": "アーヤ", "text": "それだけじゃない気もするけど"},
        { "location": "98/TALK"   , "narrator": "アーヤ", "text": "そんなものかもしれないわね"},
        { "location": "99/ACT"    , "narrator": "", "text": "観察力が足りないね"},
        { "location": "100/TALK"  , "narrator": "アーヤ", "text": "そう言われると"},
        { "location": "101/TALK"  , "narrator": "アーヤ", "text": "そうねとしか言えないわ"},
        { "location": "102/TALK"  , "narrator": "アーヤ", "text": "でもこんな状況"},
        { "location": "103/TALK"  , "narrator": "アーヤ", "text": "想定外だったもの"},
        { "location": "104/TALK"  , "narrator": "アーヤ", "text": "仕方ないわ"},
        { "location": "105/ACT"   , "narrator": "", "text": "アーヤはどう思ってる？"},
        { "location": "115/TALK"  , "narrator": "アーヤ", "text": "私？"},
        { "location": "116/TALK"  , "narrator": "アーヤ", "text": "私は、、、"},
        { "location": "117/TALK"  , "narrator": "アーヤ", "text": "ｍだちょっと"},
        { "location": "118/TALK"  , "narrator": "アーヤ", "text": "整理がつかないわ"},
        { "location": "120/TALK"  , "narrator": "アーヤ", "text": "それに"},
        { "location": "121/TALK"  , "narrator": "アーヤ", "text": "まだ信じてるわけじゃない"},
        { "location": "122/TALK"  , "narrator": "アーヤ", "text": "でも"},
        { "location": "123/TALK"  , "narrator": "アーヤ", "text": "いい加減にするつもりはないの"},
        { "location": "124/TALK"  , "narrator": "アーヤ", "text": "だからそこは"},
        { "location": "125/TALK"  , "narrator": "アーヤ", "text": "心配しないで"},
        { "location": "128/TALK"  , "narrator": "アーヤ", "text": "っていうのも"},
        { "location": "129/TALK"  , "narrator": "アーヤ", "text": "ちょっと変かもね"},
        { "location": "111/DIALOG", "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>500pt.</b></color></size>\nアップしました！"}
    ]
}
