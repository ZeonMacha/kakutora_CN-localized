{
    "dir": "chap15/daydra/dd_ch02_15_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "15256",
        "cid": "ayami",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "大学の友達との付き合い"
    },
    "entry":
    [
        { "location": "167/SCENARIO", "narrator": "", "text": "大学の友達との付き合い"},
        { "location": "187/TALK"    , "narrator": "アーヤ", "text": "じゃあ、先に上がらせて\nもらいますね。"},
        { "location": "189/TALK"    , "narrator": "真幌", "text": "おお…珍しいな。\nアーヤが一番先に\n上がるなんて。"},
        { "location": "191/TALK"    , "narrator": "アーヤ", "text": "今日はこの後、\n大学の友人と食事をする\n約束があるんです。"},
        { "location": "192/TALK"    , "narrator": "真幌", "text": "ほう…友人だと？"},
        { "location": "193/TALK"    , "narrator": "アーヤ", "text": "はい。"},
        { "location": "194/TALK"    , "narrator": "アーヤ", "text": "久しぶりの食事会なので、\n少しおめかしもしようかと\n思ってまして…。"},
        { "location": "197/TALK"    , "narrator": "みやび", "text": "ほほう…おめかしか。"},
        { "location": "201/TALK"    , "narrator": "みやび", "text": "まほさん、これはあれで\n決まりですな。"},
        { "location": "203/TALK"    , "narrator": "真幌", "text": "うむ、間違いない。"},
        { "location": "207/TALK"    , "narrator": "真幌", "text": "合コン、頑張ってこいよ。"},
        { "location": "210/TALK"    , "narrator": "アーヤ", "text": "何でそうなるんですか…。"},
        { "location": "212/TALK"    , "narrator": "真幌", "text": "夜にめかしこんで行く\n食事会となれば――"},
        { "location": "213/TALK"    , "narrator": "真幌", "text": "合コンと概ね決まって\nいるからな。"},
        { "location": "216/TALK"    , "narrator": "みやび", "text": "とうとう、アーヤにも\n春が来るかもしれんがか。"},
        { "location": "218/TALK"    , "narrator": "みやび", "text": "上手くいったら\n報告するがよ。\n赤飯炊いて待ってるき。"},
        { "location": "220/TALK"    , "narrator": "アーヤ", "text": "あ、あのねぇ…。"},
        { "location": "221/TALK"    , "narrator": "真幌", "text": "というか、どんな男が\n来るのかわかっている\nのか？"},
        { "location": "222/TALK"    , "narrator": "みやび", "text": "それより、アーヤの\n好みのタイプって\nどんな奴なが？"},
        { "location": "225/TALK"    , "narrator": "アーヤ", "text": "…ダメだわ。\n全然私の話聞いて\nくれない…。"},
        { "location": "226/SEL"     , "narrator": "", "text": "合コンだな！？"},
        { "location": "227/SEL"     , "narrator": "", "text": "端末操作：着信音"},
        { "location": "230/TALK"    , "narrator": "アーヤ", "text": "っていうか、どうして\nこの手の話題が出ると――"},
        { "location": "231/TALK"    , "narrator": "アーヤ", "text": "こんなに大げさなほど\n騒がしくなるのかしら？"},
        { "location": "232/TALK"    , "narrator": "アーヤ", "text": "…やっぱり、女性だらけの\n職場だから？"},
        { "location": "233/TALK"    , "narrator": "アーヤ", "text": "って、待ち合わせの\n時間に遅れちゃうし、\n早くここを離れないと…。"},
        { "location": "238/TALK"    , "narrator": "アーヤ", "text": "…ご想像にお任せします。"},
        { "location": "240/TALK"    , "narrator": "真幌", "text": "…なんだと？"},
        { "location": "242/TALK"    , "narrator": "みやび", "text": "否定も怒りもせんとは…。"},
        { "location": "243/TALK"    , "narrator": "みやび", "text": "まさか、本当に合コンに\n行くが？"},
        { "location": "245/TALK"    , "narrator": "アーヤ", "text": "ご想像に任せるってば。"},
        { "location": "246/TALK"    , "narrator": "アーヤ", "text": "一々否定してたら\n時間に間に合わないし。"},
        { "location": "250/TALK"    , "narrator": "みやび", "text": "まほさん、\nこれは事件ながですよ。"},
        { "location": "251/TALK"    , "narrator": "みやび", "text": "冗談のつもりやった\nけんど、本当に合コン\nっぽい雰囲気です。"},
        { "location": "253/TALK"    , "narrator": "真幌", "text": "ああ…\nだが、めでたいことだ。"},
        { "location": "255/TALK"    , "narrator": "真幌", "text": "アーヤ、めかしこむのは\n良いが、あまり露出が\n激しいのは避けるんだぞ。"},
        { "location": "256/TALK"    , "narrator": "真幌", "text": "男は適度な露出を好む\n生き物だからな。"},
        { "location": "259/TALK"    , "narrator": "みやび", "text": "飲み過ぎにも\n注意するがよ。"},
        { "location": "261/TALK"    , "narrator": "みやび", "text": "男は狼や、グリズリーや、\n飢えたライオンや！"},
        { "location": "265/TALK"    , "narrator": "アーヤ", "text": "はいはい…とにかく、\n行ってきますね。"},
        { "location": "266/TALK"    , "narrator": "真幌", "text": "朝帰りは許さんからな！"},
        { "location": "269/TALK"    , "narrator": "アーヤ", "text": "しません！\nまったく…。"},
        { "location": "273/TALK"    , "narrator": "アーヤ", "text": "…でも、そういう\nオシャレもできるように、\n練習しておこうかしら？"},
        { "location": "291/ACT"     , "narrator": "", "text": "合コンだな！？"},
        { "location": "311/TALK"    , "narrator": "アーヤ", "text": "あなたまで何言い出すの！？"},
        { "location": "312/TALK"    , "narrator": "アーヤ", "text": "ってか、そういうタイプじゃないでしょ、私(＞＜*)"},
        { "location": "323/TALK"    , "narrator": "アーヤ", "text": "盛り上がってる空気\n壊しますけど――"},
        { "location": "325/TALK"    , "narrator": "アーヤ", "text": "本当に普通の\n食事会ですから。"},
        { "location": "326/TALK"    , "narrator": "アーヤ", "text": "男性参加者ゼロの、\n完全な女子会です。"},
        { "location": "328/TALK"    , "narrator": "真幌", "text": "…男は一人も来ないのか？"},
        { "location": "330/TALK"    , "narrator": "アーヤ", "text": "来ませんし、誘うような\n男の知り合いもいません。"},
        { "location": "332/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "334/TALK"    , "narrator": "みやび", "text": "まあ、そんなことかとは\n思うてたがよ。"},
        { "location": "336/TALK"    , "narrator": "真幌", "text": "だな…アーヤのことだ、\nまず合コンなんて\nありえんからな。"},
        { "location": "338/TALK"    , "narrator": "アーヤ", "text": "もう…やっぱり\nからかってたんですね？"},
        { "location": "339/TALK"    , "narrator": "真幌", "text": "すまんすまん。"},
        { "location": "340/TALK"    , "narrator": "真幌", "text": "だが、アーヤだって\nもう子供じゃないんだ。"},
        { "location": "341/TALK"    , "narrator": "真幌", "text": "一度くらいは経験しても\nいいと、私は思うぞ。"},
        { "location": "344/TALK"    , "narrator": "アーヤ", "text": "今はいいです。\nそれより、時間ないんで\nそろそろ行きますね。"},
        { "location": "348/TALK"    , "narrator": "みやび", "text": "…まだしばらくは、\nアーヤの春は来そうに\nないがですね。"},
        { "location": "350/TALK"    , "narrator": "真幌", "text": "…おまえが言うな。"},
        { "location": "351/ACT"     , "narrator": "", "text": "端末操作：着信音"},
        { "location": "358/TALK"    , "narrator": "アーヤ", "text": "あっ…！"},
        { "location": "359/TALK"    , "narrator": "真幌", "text": "ん？\n待ち合わせ相手からか？"},
        { "location": "362/TALK"    , "narrator": "アーヤ", "text": "そうみたいです。\n遅れそうなので、\nそろそろ行きます。"},
        { "location": "363/TALK"    , "narrator": "みやび", "text": "楽しんできいや。"},
        { "location": "370/TALK"    , "narrator": "アーヤ", "text": "ふぅ…。"},
        { "location": "382/TALK"    , "narrator": "アーヤ", "text": "ナイスタイミング(≧∇≦)b"},
        { "location": "384/TALK"    , "narrator": "アーヤ", "text": "おかげで助かったわ"},
        { "location": "386/SEL"     , "narrator": "", "text": "からかわれてたみたいだね"},
        { "location": "387/ACT"     , "narrator": "", "text": "からかわれてたみたいだね"},
        { "location": "389/TALK"    , "narrator": "アーヤ", "text": "うん"},
        { "location": "390/TALK"    , "narrator": "アーヤ", "text": "館長達も、本気で合コンに行くとは思ってないはず"},
        { "location": "394/TALK"    , "narrator": "アーヤ", "text": "けど、"},
        { "location": "396/TALK"    , "narrator": "アーヤ", "text": "もしかしたら、とは思ってるのかも…(-ω-;)"},
        { "location": "397/TALK"    , "narrator": "アーヤ", "text": "やっぱり、この年で一度も行ったことないのは、マズいかしら？"},
        { "location": "398/TALK"    , "narrator": "アーヤ", "text": "…考えても仕方ないことだけどね"},
        { "location": "176/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>7月17日　5:45 PM</color>\nとある平日の夕方、神楽坂トライナリー劇場にて。"},
        { "location": "284/DIALOG"  , "narrator": "Dialog_GEThimegoto_ch02", "text": "【コンは来んのコン】"}
    ]
}
