    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "アニメ第31話"},
        { "location": "20/TALK"   , "narrator": "千羽鶴", "text": "ごきげんよう、\n$handle$。"},
        { "location": "21/TALK"   , "narrator": "千羽鶴", "text": "もう一度\n私との会話を\n再現する？"},
        { "location": "22/SEL"    , "narrator": "", "text": "はい"},
        { "location": "23/SEL"    , "narrator": "", "text": "いいえ"},
        { "location": "24/ACT"    , "narrator": "", "text": "はい"},
        { "location": "25/TALK"   , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "27/ACT"    , "narrator": "", "text": "いいえ"},
        { "location": "28/TALK"   , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "34/TALK"   , "narrator": "千羽鶴", "text": "ごきげんよう、\n$handle$。"},
        { "location": "35/TALK"   , "narrator": "千羽鶴", "text": "というわけで\nまた次回。"},
        { "location": "36/SEL"    , "narrator": "", "text": "はーい"},
        { "location": "37/SEL"    , "narrator": "", "text": "ちょっ、ちょっと待って！"},
        { "location": "38/ACT"    , "narrator": "", "text": "はーい"},
        { "location": "39/TALK"   , "narrator": "千羽鶴", "text": "では、\n記録映像をどうぞ。"},
        { "location": "40/ACT"    , "narrator": "", "text": "ちょっ、ちょっと待って！"},
        { "location": "41/TALK"   , "narrator": "千羽鶴", "text": "どうしたの？"},
        { "location": "42/SEL"    , "narrator": "", "text": "それはこっちのセリフだってば"},
        { "location": "43/ACT"    , "narrator": "", "text": "それはこっちのセリフだってば"},
        { "location": "45/TALK"   , "narrator": "千羽鶴", "text": "ちーは、この前の\n一件でちょっと\n疲れてしまった。"},
        { "location": "46/TALK"   , "narrator": "千羽鶴", "text": "だから、\n１回くらいは\nお休みが欲しい！"},
        { "location": "47/SEL"    , "narrator": "", "text": "それじゃ$me$と一緒に休みましょう！！"},
        { "location": "48/SEL"    , "narrator": "", "text": "まあ、わからなくもないけど、それは困る"},
        { "location": "49/ACT"    , "narrator": "", "text": "それじゃ$me$と一緒に休みましょう！！"},
        { "location": "51/TALK"   , "narrator": "千羽鶴", "text": "貴方と一緒にいたら\nお休みにならないでしょ？"},
        { "location": "52/ACT"    , "narrator": "", "text": "まあ、わからなくもないけど、それは困る"},
        { "location": "54/TALK"   , "narrator": "千羽鶴", "text": "いけず。"},
        { "location": "57/TALK"   , "narrator": "千羽鶴", "text": "じゃあ、\n省電力モードで\n稼働してもいい？"},
        { "location": "58/SEL"    , "narrator": "", "text": "まあ、いいけど"},
        { "location": "59/SEL"    , "narrator": "", "text": "それって前にやってた塩対応の新バージョン？"},
        { "location": "60/ACT"    , "narrator": "", "text": "まあ、いいけど"},
        { "location": "61/TALK"   , "narrator": "千羽鶴", "text": "ありがと。"},
        { "location": "62/ACT"    , "narrator": "", "text": "それって前にやってた塩対応の新バージョン？"},
        { "location": "63/TALK"   , "narrator": "千羽鶴", "text": "さすがは\n$handle$。"},
        { "location": "64/TALK"   , "narrator": "千羽鶴", "text": "貴方には、\nちーマスターの\n称号をあげぬ。"},
        { "location": "65/SEL"    , "narrator": "", "text": "ぬ？"},
        { "location": "66/ACT"    , "narrator": "", "text": "ぬ？"},
        { "location": "68/TALK"   , "narrator": "千羽鶴", "text": "……そう。"},
        { "location": "70/TALK"   , "narrator": "千羽鶴", "text": "……。"},
        { "location": "72/TALK"   , "narrator": "千羽鶴", "text": "ごめん、小学生の頃に\n流行ってたのを\n思い出して使ってみた。"},
        { "location": "74/TALK"   , "narrator": "千羽鶴", "text": "いえ、\nそんなことは\nどうでもよくて。"},
        { "location": "77/TALK"   , "narrator": "千羽鶴", "text": "ちーは最近、自分の\nパワーが減退しているのを\n感じている！"},
        { "location": "78/SEL"    , "narrator": "", "text": "どんな風に？"},
        { "location": "79/ACT"    , "narrator": "", "text": "どんな風に？"},
        { "location": "81/TALK"   , "narrator": "千羽鶴", "text": "ボケのキレが悪い。"},
        { "location": "82/TALK"   , "narrator": "千羽鶴", "text": "これは、\n体調不良の兆し！"},
        { "location": "83/TALK"   , "narrator": "千羽鶴", "text": "だから省電力モードで\nいこうと思う。"},
        { "location": "84/TALK"   , "narrator": "千羽鶴", "text": "だいたい、今はまるで\n台風の目の中にいるような\n穏やかな日々。"},
        { "location": "85/SEL"    , "narrator": "", "text": "それ、確かに穏やかだけどすごく不穏な表現だよね"},
        { "location": "86/SEL"    , "narrator": "", "text": "ほらボケスキルは健在だよ！だから$me$と一緒に楽しい事しよう！"},
        { "location": "87/ACT"    , "narrator": "", "text": "それ、確かに穏やかだけどすごく不穏な表現だよね"},
        { "location": "88/TALK"   , "narrator": "千羽鶴", "text": "今は圧倒的穏やか。\nけれども明日は地獄――"},
        { "location": "89/TALK"   , "narrator": "千羽鶴", "text": "かもしれない、という\n意味合いを込めてみた。"},
        { "location": "90/ACT"    , "narrator": "", "text": "ほらボケスキルは健在だよ！だから$me$と一緒に楽しい事しよう！"},
        { "location": "93/TALK"   , "narrator": "千羽鶴", "text": "<size=34>どーん！</size>"},
        { "location": "94/SEL"    , "narrator": "", "text": "なんか弱くない？"},
        { "location": "95/ACT"    , "narrator": "", "text": "なんか弱くない？"},
        { "location": "97/TALK"   , "narrator": "千羽鶴", "text": "省電力モードだから。"},
        { "location": "98/TALK"   , "narrator": "千羽鶴", "text": "それ以前に、\nヘンなこと言って\nどーんさせないで。"},
        { "location": "99/TALK"   , "narrator": "千羽鶴", "text": "穏やかな状態を\n満喫したいのに。"},
        { "location": "101/TALK"  , "narrator": "千羽鶴", "text": "まあ、少し\n真面目にお話をすると――"},
        { "location": "102/TALK"  , "narrator": "千羽鶴", "text": "これからまた、\n波乱に満ちた何かが\n起きると思うし。"},
        { "location": "103/TALK"  , "narrator": "千羽鶴", "text": "今ほど平穏な日は\nそう無いと思うから。"},
        { "location": "104/TALK"  , "narrator": "千羽鶴", "text": "そういう時くらい、\n何も考えずに\nゴロゴロしたい。"},
        { "location": "105/SEL"   , "narrator": "", "text": "残念ながら、不穏なニュースはあります"},
        { "location": "106/SEL"   , "narrator": "", "text": "そうだね、一緒にゴロゴロしよう"},
        { "location": "107/ACT"   , "narrator": "", "text": "残念ながら、不穏なニュースはあります"},
        { "location": "108/TALK"  , "narrator": "千羽鶴", "text": "ふむ、どうぞ。"},
        { "location": "109/SEL"   , "narrator": "", "text": "なりすましの不審者が出入りしてるみたい"},
        { "location": "110/ACT"   , "narrator": "", "text": "なりすましの不審者が出入りしてるみたい"},
        { "location": "112/TALK"  , "narrator": "千羽鶴", "text": "そうみたいね。"},
        { "location": "113/TALK"  , "narrator": "千羽鶴", "text": "エリカから\n話は聞いてる。"},
        { "location": "114/TALK"  , "narrator": "千羽鶴", "text": "エリカが言うには、"},
        { "location": "115/TALK"  , "narrator": "千羽鶴", "text": "貴方が合い言葉を作って、\nなりすましをそれで\n排除する事になったと。"},
        { "location": "125/SEL"   , "narrator": "", "text": "ああ、あの高い塔の上に住む少女の物語を話してもらったやつ？"},
        { "location": "126/SEL"   , "narrator": "", "text": "$ques31$"},
        { "location": "127/ACT"   , "narrator": "", "text": "ああ、あの高い塔の上に住む少女の物語を話してもらったやつ？"},
        { "location": "128/TALK"  , "narrator": "千羽鶴", "text": "そう。多分それのこと。"},
        { "location": "131/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "132/TALK"  , "narrator": "千羽鶴", "text": "なかなか\n楽しそうなプレイを\nしてるみたいね。"},
        { "location": "133/SEL"   , "narrator": "", "text": "仕方ないんだよ、月神楽が選べって言うから…"},
        { "location": "134/SEL"   , "narrator": "", "text": "ちーちゃんともやりたいです"},
        { "location": "135/ACT"   , "narrator": "", "text": "仕方ないんだよ、月神楽が選べって言うから…"},
        { "location": "136/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "137/ACT"   , "narrator": "", "text": "ちーちゃんともやりたいです"},
        { "location": "138/TALK"  , "narrator": "千羽鶴", "text": "変態の相手は\nしないことにしている。"},
        { "location": "141/TALK"  , "narrator": "千羽鶴", "text": "とにかく、\nエリカから聞いたのは\nそれじゃない。"},
        { "location": "142/TALK"  , "narrator": "千羽鶴", "text": "高い塔に住む少女の物語を\n暗号鍵代わりにしたという\n話だったけど。"},
        { "location": "143/SEL"   , "narrator": "", "text": "それもあったね"},
        { "location": "144/ACT"   , "narrator": "", "text": "それもあったね"},
        { "location": "146/TALK"  , "narrator": "千羽鶴", "text": "まあ。"},
        { "location": "147/TALK"  , "narrator": "千羽鶴", "text": "貴方が変態だろうが\nそうでなかろうが、\n私には関係無いけど――"},
        { "location": "148/TALK"  , "narrator": "千羽鶴", "text": "二重三重に\n合い言葉でセキュリティを\n掛けてるのはいいこと。"},
        { "location": "150/TALK"  , "narrator": "千羽鶴", "text": "いずれにしても、その\n高い塔のお話による\n量子暗号鍵によって――"},
        { "location": "151/TALK"  , "narrator": "千羽鶴", "text": "なりすましは、トライ\nガジェットをアクティ\nベート出来ないはず。"},
        { "location": "152/TALK"  , "narrator": "千羽鶴", "text": "よって、この後の作戦に\n参加して、工作することも\nできなくなる。"},
        { "location": "153/TALK"  , "narrator": "千羽鶴", "text": "その間にエリカと私で、\nなりすましの正体が\n何なのかを調査する。"},
        { "location": "154/TALK"  , "narrator": "千羽鶴", "text": "そんな感じ。"},
        { "location": "155/SEL"   , "narrator": "", "text": "なるほど"},
        { "location": "156/ACT"   , "narrator": "", "text": "なるほど"},
        { "location": "159/ACT"   , "narrator": "", "text": "そうだね、一緒にゴロゴロしよう"},
        { "location": "160/TALK"  , "narrator": "千羽鶴", "text": "ゴロゴロゴロゴロ"},
        { "location": "163/TALK"  , "narrator": "千羽鶴", "text": "<size=35>ピシャーン！</size>"},
        { "location": "164/TALK"  , "narrator": "千羽鶴", "text": "一緒にやってくれた？"},
        { "location": "165/SEL"   , "narrator": "", "text": "はい"},
        { "location": "166/SEL"   , "narrator": "", "text": "いいえ"},
        { "location": "167/ACT"   , "narrator": "", "text": "はい"},
        { "location": "168/TALK"  , "narrator": "千羽鶴", "text": "周りの人に\nどん引きされたでしょ。"},
        { "location": "169/SEL"   , "narrator": "", "text": "ちょっと勇気が要った"},
        { "location": "170/SEL"   , "narrator": "", "text": "周りになんて誰もいないから"},
        { "location": "171/ACT"   , "narrator": "", "text": "ちょっと勇気が要った"},
        { "location": "173/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "174/TALK"  , "narrator": "千羽鶴", "text": "今、健気でちょっとだけ\nかわいいと思った！"},
        { "location": "176/ACT"   , "narrator": "", "text": "周りになんて誰もいないから"},
        { "location": "177/TALK"  , "narrator": "千羽鶴", "text": "あっ……"},
        { "location": "178/TALK"  , "narrator": "千羽鶴", "text": "……ごめん。"},
        { "location": "179/SEL"   , "narrator": "", "text": "え？たまたまいないだけだよ？"},
        { "location": "180/SEL"   , "narrator": "", "text": "大丈夫、気にしてないから"},
        { "location": "181/ACT"   , "narrator": "", "text": "え？たまたまいないだけだよ？"},
        { "location": "182/TALK"  , "narrator": "千羽鶴", "text": "なんだ、よかった。"},
        { "location": "183/ACT"   , "narrator": "", "text": "大丈夫、気にしてないから"},
        { "location": "184/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "186/TALK"  , "narrator": "千羽鶴", "text": "安心して！\n貴方には、ちーが\n一緒にいるから！"},
        { "location": "190/TALK"  , "narrator": "千羽鶴", "text": "――なんて、\nかなり話が脱線してるので\n元に戻す。一気に。"},
        { "location": "191/ACT"   , "narrator": "", "text": "いいえ"},
        { "location": "192/TALK"  , "narrator": "千羽鶴", "text": "言い出しっぺが\n契約違反。"},
        { "location": "195/SEL"   , "narrator": "", "text": "ククク…"},
        { "location": "196/SEL"   , "narrator": "", "text": "可愛かったよ！"},
        { "location": "197/ACT"   , "narrator": "", "text": "ククク…"},
        { "location": "198/TALK"  , "narrator": "千羽鶴", "text": "むむむ！"},
        { "location": "199/TALK"  , "narrator": "千羽鶴", "text": "……まあいい。"},
        { "location": "201/TALK"  , "narrator": "千羽鶴", "text": "相手にしていても\n仕方ないから、\n先へ進もうと思う。"},
        { "location": "202/ACT"   , "narrator": "", "text": "可愛かったよ！"},
        { "location": "204/TALK"  , "narrator": "千羽鶴", "text": "ばーかばーか。"},
        { "location": "206/TALK"  , "narrator": "千羽鶴", "text": "先へ進む。"},
        { "location": "210/TALK"  , "narrator": "千羽鶴", "text": "そんなわけで、\n記録映像の後に、今回の\n作戦要綱を話そうと思う。"},
        { "location": "211/TALK"  , "narrator": "千羽鶴", "text": "映像は見ても見なくても\nどっちでもいいけど――"},
        { "location": "212/TALK"  , "narrator": "千羽鶴", "text": "貴方は記録映像の中身を\nちゃんと覚えてる？"},
        { "location": "213/SEL"   , "narrator": "", "text": "もちろん"},
        { "location": "214/SEL"   , "narrator": "", "text": "さすがに覚えてない"},
        { "location": "215/ACT"   , "narrator": "", "text": "もちろん"},
        { "location": "216/TALK"  , "narrator": "千羽鶴", "text": "有能！！"},
        { "location": "217/TALK"  , "narrator": "千羽鶴", "text": "で、何だった？"},
        { "location": "218/SEL"   , "narrator": "", "text": "エリカがつばめのフェノメノンについて真実を語る回"},
        { "location": "219/SEL"   , "narrator": "", "text": "千羽鶴が$me$に告白する回"},
        { "location": "220/ACT"   , "narrator": "", "text": "エリカがつばめのフェノメノンについて真実を語る回"},
        { "location": "221/TALK"  , "narrator": "千羽鶴", "text": "正解！"},
        { "location": "222/TALK"  , "narrator": "千羽鶴", "text": "さすが、ここまで一緒に\nやってきてるだけあって、\nもはやベテランの域ね。"},
        { "location": "223/TALK"  , "narrator": "千羽鶴", "text": "記録映像は、\n飛ばしたければ飛ばしても\n大丈夫だと思う。"},
        { "location": "224/ACT"   , "narrator": "", "text": "千羽鶴が$me$に告白する回"},
        { "location": "227/TALK"  , "narrator": "千羽鶴", "text": "<size=60>どーん！！</size>"},
        { "location": "228/TALK"  , "narrator": "千羽鶴", "text": "あまりの衝撃的回答に、\n画面を突き破った。"},
        { "location": "229/SEL"   , "narrator": "", "text": "ちょっとした冗談ですって"},
        { "location": "230/SEL"   , "narrator": "", "text": "突き破ってそのままこっちの世界に来て！"},
        { "location": "231/ACT"   , "narrator": "", "text": "ちょっとした冗談ですって"},
        { "location": "232/TALK"  , "narrator": "千羽鶴", "text": "省電力モードの時に\nこの冗談は罪が重い。"},
        { "location": "233/TALK"  , "narrator": "千羽鶴", "text": "賠償を要求する！"},
        { "location": "234/ACT"   , "narrator": "", "text": "突き破ってそのままこっちの世界に来て！"},
        { "location": "236/TALK"  , "narrator": "千羽鶴", "text": "行きたい。"},
        { "location": "237/TALK"  , "narrator": "千羽鶴", "text": "切ない気持ちに\nさせないで。"},
        { "location": "239/TALK"  , "narrator": "千羽鶴", "text": "それもいいかも。"},
        { "location": "240/TALK"  , "narrator": "千羽鶴", "text": "と思ったけど、行けば\n貴方の悪のりが増すだけ\nだと思うから却下。"},
        { "location": "243/TALK"  , "narrator": "千羽鶴", "text": "とまあ、そんな\nくだらないことは\n置いておいて。"},
        { "location": "244/TALK"  , "narrator": "千羽鶴", "text": "記録映像、見るも見ないも\n貴方の選択次第。"},
        { "location": "246/ACT"   , "narrator": "", "text": "さすがに覚えてない"},
        { "location": "247/TALK"  , "narrator": "千羽鶴", "text": "それが普通だと思う。"},
        { "location": "248/TALK"  , "narrator": "千羽鶴", "text": "今回の記録映像では\nエリカから重大発表が\nあった。"},
        { "location": "249/TALK"  , "narrator": "千羽鶴", "text": "歴史的な回でもあるから、\n記念に少しばかり\n見ていくといい。"},
        { "location": "254/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/82MB 5:14】</color>"},
        { "location": "255/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/27MB 5:14】</color>"},
        { "location": "256/SEL"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "257/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/82MB 5:14】</color>"},
        { "location": "258/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "264/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/27MB 5:14】</color>"},
        { "location": "265/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "271/ACT"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "272/TALK"  , "narrator": "千羽鶴", "text": "そう……。"},
        { "location": "305/TALK"  , "narrator": "千羽鶴", "text": "というわけで、\n久し振りの\nこのコーナー。"},
        { "location": "306/TALK"  , "narrator": "千羽鶴", "text": "<color=green>【今のちーが\n昔のちーを斬る！】</color>の\n時間が再到来！"},
        { "location": "307/SEL"   , "narrator": "", "text": "ワーパチパチ"},
        { "location": "308/ACT"   , "narrator": "", "text": "ワーパチパチ"},
        { "location": "310/TALK"  , "narrator": "千羽鶴", "text": "ぶっちゃけ、\n何回振り？"},
        { "location": "311/TALK"  , "narrator": "千羽鶴", "text": "もう、こんなこと\nやってた事なんて\n忘れてたでしょう。"},
        { "location": "312/SEL"   , "narrator": "", "text": "忘れてたよ"},
        { "location": "313/SEL"   , "narrator": "", "text": "覚えてたよ"},
        { "location": "314/ACT"   , "narrator": "", "text": "忘れてたよ"},
        { "location": "315/TALK"  , "narrator": "千羽鶴", "text": "正直者は好き。"},
        { "location": "316/ACT"   , "narrator": "", "text": "覚えてたよ"},
        { "location": "317/TALK"  , "narrator": "千羽鶴", "text": "もしかして\nちーマスターですか？"},
        { "location": "320/TALK"  , "narrator": "千羽鶴", "text": "というわけで、\n早速やっていきたいと\n思う。"},
        { "location": "321/TALK"  , "narrator": "千羽鶴", "text": "今日は何の日？"},
        { "location": "322/TALK"  , "narrator": "千羽鶴", "text": "私が逢瀬つばめに\n理想社会の作り方について\n尋問と洗脳をした日。"},
        { "location": "323/TALK"  , "narrator": "千羽鶴", "text": "そして、國政綾水たちが\nエリカの助力を得て、\n如月音羽と邂逅した日。"},
        { "location": "324/TALK"  , "narrator": "千羽鶴", "text": "この頃の私は、既に\nエリカによってナビ空間を\n追い出されていた。"},
        { "location": "325/TALK"  , "narrator": "千羽鶴", "text": "だから実は、\nどうしてこうなったのか\nあまりよく知らない。"},
        { "location": "326/SEL"   , "narrator": "", "text": "千羽鶴にも把握してなかったことがあるなんて！"},
        { "location": "327/SEL"   , "narrator": "", "text": "この頃大変だったね、何やってたの？"},
        { "location": "328/ACT"   , "narrator": "", "text": "千羽鶴にも把握してなかったことがあるなんて！"},
        { "location": "329/TALK"  , "narrator": "千羽鶴", "text": "大変だった。"},
        { "location": "330/TALK"  , "narrator": "千羽鶴", "text": "正直、この時エリカ主導で\n音羽とコンタクトを取って\nいるなんて知らなかった。"},
        { "location": "331/ACT"   , "narrator": "", "text": "この頃大変だったね、何やってたの？"},
        { "location": "332/TALK"  , "narrator": "千羽鶴", "text": "……ご飯食べてた。"},
        { "location": "333/SEL"   , "narrator": "", "text": "献立は？"},
        { "location": "334/ACT"   , "narrator": "", "text": "献立は？"},
        { "location": "336/TALK"  , "narrator": "千羽鶴", "text": "あじの開きと\n味噌汁とご飯。"},
        { "location": "339/TALK"  , "narrator": "千羽鶴", "text": "この辺りになってくると、\n私にも制御出来ない\n外の力が強くなってくる。"},
        { "location": "340/TALK"  , "narrator": "千羽鶴", "text": "だから私は開き直り、\n味方が誰一人いなくても\n己の道を進む決意をした。"},
        { "location": "341/SEL"   , "narrator": "", "text": "ちーちゃん強いね"},
        { "location": "342/SEL"   , "narrator": "", "text": "$me$はずっと味方だよ"},
        { "location": "343/ACT"   , "narrator": "", "text": "ちーちゃん強いね"},
        { "location": "344/TALK"  , "narrator": "千羽鶴", "text": "やれることを\nただやってきただけ。"},
        { "location": "345/ACT"   , "narrator": "", "text": "$me$はずっと味方だよ"},
        { "location": "347/TALK"  , "narrator": "千羽鶴", "text": "ええ、わかってる。"},
        { "location": "348/TALK"  , "narrator": "千羽鶴", "text": "貴方は私の思想に\n賛同してくれて、\nその実現を願ってくれた。"},
        { "location": "349/TALK"  , "narrator": "千羽鶴", "text": "それだけで、\nどれほど心強かったか。"},
        { "location": "350/TALK"  , "narrator": "千羽鶴", "text": "だから、いまでも\n貴方のことは\n頼りにしてる。"},
        { "location": "351/TALK"  , "narrator": "千羽鶴", "text": "私にとっての\n心の恩人だもの。"},
        { "location": "353/TALK"  , "narrator": "千羽鶴", "text": "え。"},
        { "location": "354/TALK"  , "narrator": "千羽鶴", "text": "そうね。"},
        { "location": "355/TALK"  , "narrator": "千羽鶴", "text": "確かにここまで一緒に\nいてくれてることは\nとても感謝してる。"},
        { "location": "356/TALK"  , "narrator": "千羽鶴", "text": "今ここで、私と一緒に\n第二の作戦実現に向けて\n共に歩んでくれる――"},
        { "location": "357/TALK"  , "narrator": "千羽鶴", "text": "その事については、\n感謝の気持ちしか\n湧いてこないもの。"},
        { "location": "361/TALK"  , "narrator": "千羽鶴", "text": "さて、そんな時系列に\nおける、今回の\nリプレイス作戦だけど。"},
        { "location": "362/TALK"  , "narrator": "千羽鶴", "text": "前回の前準備が\nいよいよ今回、\n実を結ぶことになる。"},
        { "location": "363/TALK"  , "narrator": "千羽鶴", "text": "長官の私を卯月神楽の\nフェノメノンで包み、\nその中で交渉すること。"},
        { "location": "364/TALK"  , "narrator": "千羽鶴", "text": "貴方にはその中で、\n長官の私との\n交渉役をやって欲しい。"},
        { "location": "365/SEL"   , "narrator": "", "text": "いきなりメチャクチャ大役なんですけど！"},
        { "location": "366/ACT"   , "narrator": "", "text": "いきなりメチャクチャ大役なんですけど！"},
        { "location": "368/TALK"  , "narrator": "千羽鶴", "text": "大丈夫。\n要点を押さえれば\n攻略は非常に簡単。"},
        { "location": "369/TALK"  , "narrator": "千羽鶴", "text": "私が言うのだから\n間違いはない！"},
        { "location": "370/SEL"   , "narrator": "", "text": "すごい説得力である"},
        { "location": "371/ACT"   , "narrator": "", "text": "すごい説得力である"},
        { "location": "373/TALK"  , "narrator": "千羽鶴", "text": "うむ。"},
        { "location": "374/TALK"  , "narrator": "千羽鶴", "text": "で、その要点だけど――"},
        { "location": "375/TALK"  , "narrator": "千羽鶴", "text": "こと長官に対しては、\n未来のことを\n伝えてしまって構わない。"},
        { "location": "376/SEL"   , "narrator": "", "text": "え、なんで！？"},
        { "location": "377/ACT"   , "narrator": "", "text": "え、なんで！？"},
        { "location": "379/TALK"  , "narrator": "千羽鶴", "text": "長官の私は、既に貴方が\n未来から来ていることを\n知っている。"},
        { "location": "380/TALK"  , "narrator": "千羽鶴", "text": "だから、貴方の言うことを\n信じる可能性は高い。"},
        { "location": "381/TALK"  , "narrator": "千羽鶴", "text": "自らの未来について、\n例えば――"},
        { "location": "382/TALK"  , "narrator": "千羽鶴", "text": "私が何者かに撃たれて\nしまう、などを話せば、\nかなりの説得材料になる。"},
        { "location": "383/SEL"   , "narrator": "", "text": "そうしたら未来が変わってしまうのでは？"},
        { "location": "384/ACT"   , "narrator": "", "text": "そうしたら未来が変わってしまうのでは？"},
        { "location": "386/TALK"  , "narrator": "千羽鶴", "text": "私に関してだけに\n限って言えば、"},
        { "location": "387/TALK"  , "narrator": "千羽鶴", "text": "もう現時点の干渉状況から\nしても、ここから先に\nついては２択しかない。"},
        { "location": "388/TALK"  , "narrator": "千羽鶴", "text": "１つめは、長官の私が\n全てを理解し、三文芝居を\n打ってくれること。"},
        { "location": "389/TALK"  , "narrator": "千羽鶴", "text": "２つめは、今の信念を\n曲げること無く、このまま\n突き進むこと。"},
        { "location": "390/TALK"  , "narrator": "千羽鶴", "text": "私が今考えても、\nこの２つのうち、いずれか\nしか選択しないと思う。"},
        { "location": "391/TALK"  , "narrator": "千羽鶴", "text": "だから、確かに\nグランドルールとしては\n原則未来の話はNGだけど、"},
        { "location": "392/TALK"  , "narrator": "千羽鶴", "text": "今回に関してだけは、\n例外的に、効果的に\n機能すると考える。"},
        { "location": "393/SEL"   , "narrator": "", "text": "本人が言うなら間違い無いでしょ、そうさせてもらうよ"},
        { "location": "394/SEL"   , "narrator": "", "text": "なるほど、わかった。後は自分で考えて、どう動くか判断するよ"},
        { "location": "395/ACT"   , "narrator": "", "text": "本人が言うなら間違い無いでしょ、そうさせてもらうよ"},
        { "location": "396/TALK"  , "narrator": "千羽鶴", "text": "よろしく。"},
        { "location": "397/ACT"   , "narrator": "", "text": "なるほど、わかった。後は自分で考えて、どう動くか判断するよ"},
        { "location": "398/TALK"  , "narrator": "千羽鶴", "text": "それがいいかも。"},
        { "location": "400/TALK"  , "narrator": "千羽鶴", "text": "というわけで、\nいよいよ佳境に\n入りつつあるけど。"},
        { "location": "401/TALK"  , "narrator": "千羽鶴", "text": "今回もこの世界を、\nどうかよろしく。"},
        { "location": "412/SEL"   , "narrator": "", "text": "えっ！？"},
        { "location": "413/ACT"   , "narrator": "", "text": "えっ！？"},
        { "location": "417/TALK"  , "narrator": "ソイルトン", "text": "驚きすぎですよ、$handle$。まあここ最近、割とイレギュラーな対応が多いため、私も人の事を言えず驚き続ける毎日ではあるのですが。"},
        { "location": "418/TALK"  , "narrator": "ソイルトン", "text": "さて、早速ですが、“パラメトリック理論に基づく世界進行法”が設定されたため、お知らせをしに来た次第です。"},
        { "location": "419/SEL"   , "narrator": "", "text": "何をパラパラするの！？"},
        { "location": "420/ACT"   , "narrator": "", "text": "何をパラパラするの！？"},
        { "location": "422/TALK"  , "narrator": "ソイルトン", "text": "私はそんなダンスはしませんよ？\nまあそもそも身体がありませんよねHAHAHA。"},
        { "location": "423/TALK"  , "narrator": "ソイルトン", "text": "などという冗談はさておき。今回のテーマは【千羽鶴は、どう行動するか】です。"},
        { "location": "424/TALK"  , "narrator": "ソイルトン", "text": "収束予定日は、対向時間における2018年6月4日 0;00となります。"},
        { "location": "425/TALK"  , "narrator": "ソイルトン", "text": "それでは今回はこれにて失礼。あー忙しい忙しい。"},
