    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "05_000_トリガーハッピーエンド"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "ランナーズハイ的なアレ"},
        { "location": "33/TALK"   , "narrator": "みやび", "text": "脳内麻薬の快楽"},
        { "location": "35/SEL"    , "narrator": "", "text": "変性意識状態、か"},
        { "location": "36/SEL"    , "narrator": "", "text": "ドーパミン放出！"},
        { "location": "37/SEL"    , "narrator": "", "text": "$me$も一緒に溺れたい"},
        { "location": "38/ACT"    , "narrator": "", "text": "変性意識状態、か"},
        { "location": "39/TALK"   , "narrator": "みやび", "text": "何やら"},
        { "location": "40/TALK"   , "narrator": "みやび", "text": "格好いい"},
        { "location": "41/ACT"    , "narrator": "", "text": "ドーパミン放出！"},
        { "location": "42/TALK"   , "narrator": "みやび", "text": "βエンドルフィンで"},
        { "location": "44/TALK"   , "narrator": "みやび", "text": "受けて立つ！"},
        { "location": "45/ACT"    , "narrator": "", "text": "$me$も一緒に溺れたい"},
        { "location": "47/TALK"   , "narrator": "みやび", "text": "この快楽は個人的なものぞね"},
        { "location": "48/TALK"   , "narrator": "みやび", "text": "しかし特別に"},
        { "location": "49/TALK"   , "narrator": "みやび", "text": "手を取っちゃろう"},
        { "location": "51/TALK"   , "narrator": "みやび", "text": "うちはコード解析時やら"},
        { "location": "52/TALK"   , "narrator": "みやび", "text": "ロジックを組んでいる時に"},
        { "location": "53/TALK"   , "narrator": "みやび", "text": "そういう状態になることがあるぞね"},
        { "location": "55/SEL"    , "narrator": "", "text": "あーわかるー"},
        { "location": "56/SEL"    , "narrator": "", "text": "そういうもんなのか"},
        { "location": "57/SEL"    , "narrator": "", "text": "ちょっとエロいよね"},
        { "location": "58/ACT"    , "narrator": "", "text": "あーわかるー"},
        { "location": "59/TALK"   , "narrator": "みやび", "text": "うむ"},
        { "location": "61/TALK"   , "narrator": "みやび", "text": "そうであろう"},
        { "location": "62/ACT"    , "narrator": "", "text": "そういうもんなのか"},
        { "location": "63/TALK"   , "narrator": "みやび", "text": "左様"},
        { "location": "64/TALK"   , "narrator": "みやび", "text": "そういうものぞね"},
        { "location": "65/ACT"    , "narrator": "", "text": "ちょっとエロいよね"},
        { "location": "68/TALK"   , "narrator": "みやび", "text": "いやいやいやいや"},
        { "location": "69/TALK"   , "narrator": "みやび", "text": "そんな話はしておらぬ"},
        { "location": "71/TALK"   , "narrator": "みやび", "text": "しかしここで頑なに否定するのもどうか"},
        { "location": "73/TALK"   , "narrator": "みやび", "text": "そしてだ"},
        { "location": "74/TALK"   , "narrator": "みやび", "text": "ある意味そのためにコードを組んでいるのかという"},
        { "location": "75/TALK"   , "narrator": "みやび", "text": "錯覚に陥ることがあるぞね"},
        { "location": "77/SEL"    , "narrator": "", "text": "錯覚なの？"},
        { "location": "78/SEL"    , "narrator": "", "text": "素直になりなよ"},
        { "location": "79/SEL"    , "narrator": "", "text": "目的と手段がすり替わってる"},
        { "location": "80/ACT"    , "narrator": "", "text": "錯覚なの？"},
        { "location": "81/TALK"   , "narrator": "みやび", "text": "錯覚"},
        { "location": "82/TALK"   , "narrator": "みやび", "text": "ぞね"},
        { "location": "83/ACT"    , "narrator": "", "text": "素直になりなよ"},
        { "location": "84/TALK"   , "narrator": "みやび", "text": "いやいや"},
        { "location": "86/TALK"   , "narrator": "みやび", "text": "話を聞きたまえ"},
        { "location": "87/ACT"    , "narrator": "", "text": "目的と手段がすり替わってる"},
        { "location": "88/TALK"   , "narrator": "みやび", "text": "そう"},
        { "location": "89/TALK"   , "narrator": "みやび", "text": "それなのだ"},
        { "location": "91/TALK"   , "narrator": "みやび", "text": "しかしだ"},
        { "location": "92/TALK"   , "narrator": "みやび", "text": "本来の目的はそこではないのだ"},
        { "location": "93/TALK"   , "narrator": "みやび", "text": "と"},
        { "location": "94/TALK"   , "narrator": "みやび", "text": "あえて言っておきたいのだ"},
        { "location": "95/TALK"   , "narrator": "みやび", "text": "以上"}
    ]
}
