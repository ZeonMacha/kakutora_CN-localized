        { "location": "7/SCENARIO", "narrator": "", "text": "031_恋につけるレェス"},
        { "location": "34/TALK"   , "narrator": "ガブリエラ", "text": "恋心は"},
        { "location": "35/TALK"   , "narrator": "ガブリエラ", "text": "いつも可愛く飾らないといけないわ"},
        { "location": "36/TALK"   , "narrator": "ガブリエラ", "text": "わかるかしら？"},
        { "location": "38/SEL"    , "narrator": "", "text": "よくわからない"},
        { "location": "39/SEL"    , "narrator": "", "text": "そういうもの？"},
        { "location": "40/SEL"    , "narrator": "", "text": "そうだよね、恋だもの"},
        { "location": "41/ACT"    , "narrator": "", "text": "よくわからない"},
        { "location": "42/TALK"   , "narrator": "ガブリエラ", "text": "あら"},
        { "location": "44/TALK"   , "narrator": "ガブリエラ", "text": "$marzanna$はまだ子供なのねｖｖｖｖ"},
        { "location": "45/ACT"    , "narrator": "", "text": "そういうもの？"},
        { "location": "46/TALK"   , "narrator": "ガブリエラ", "text": "そういものなのよ"},
        { "location": "48/TALK"   , "narrator": "ガブリエラ", "text": "わからないかしら？"},
        { "location": "49/ACT"    , "narrator": "", "text": "そうだよね、恋だもの"},
        { "location": "51/TALK"   , "narrator": "ガブリエラ", "text": "そうなのよ//////////////"},
        { "location": "52/TALK"   , "narrator": "ガブリエラ", "text": "だって恋だものｖｖｖｖｖｖｖ"},
        { "location": "54/TALK"   , "narrator": "ガブリエラ", "text": "乙女心を飾るみたいに"},
        { "location": "55/TALK"   , "narrator": "ガブリエラ", "text": "レースとリボンを付けるのよ"},
        { "location": "57/SEL"    , "narrator": "", "text": "あとはチェーンとか"},
        { "location": "58/SEL"    , "narrator": "", "text": "ふりふりだね"},
        { "location": "59/SEL"    , "narrator": "", "text": "大事にしまわなきゃね"},
        { "location": "60/ACT"    , "narrator": "", "text": "あとはチェーンとか"},
        { "location": "61/TALK"   , "narrator": "ガブリエラ", "text": "チェーン？？？？"},
        { "location": "62/TALK"   , "narrator": "ガブリエラ", "text": "それは違うわよ！？"},
        { "location": "64/TALK"   , "narrator": "ガブリエラ", "text": "違うんだからね！"},
        { "location": "65/ACT"    , "narrator": "", "text": "ふりふりだね"},
        { "location": "66/TALK"   , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "67/TALK"   , "narrator": "ガブリエラ", "text": "そうじゃなきゃいけないわ"},
        { "location": "68/TALK"   , "narrator": "ガブリエラ", "text": "だって恋だもの/////////////////"},
        { "location": "69/ACT"    , "narrator": "", "text": "大事にしまわなきゃね"},
        { "location": "71/TALK"   , "narrator": "ガブリエラ", "text": "そうよねｖｖｖｖｖｖｖｖｖｖｖｖｖｖ"},
        { "location": "73/TALK"   , "narrator": "ガブリエラ", "text": "大事な気持ちだものｖｖｖ"},
        { "location": "74/TALK"   , "narrator": "ガブリエラ", "text": "そっと胸の奥に"},
        { "location": "75/TALK"   , "narrator": "ガブリエラ", "text": "しまわなきゃいけないわ//////"}
