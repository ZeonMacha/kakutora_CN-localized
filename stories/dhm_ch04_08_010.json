    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "030_伝統と革新のワルツ"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "キモノは伝統的"},
        { "location": "33/TALK"   , "narrator": "みやび", "text": "しかしミニ着物は革新的"},
        { "location": "34/TALK"   , "narrator": "みやび", "text": "時に相棒"},
        { "location": "35/TALK"   , "narrator": "みやび", "text": "貴殿は伝統と革新のどちらを選択する？"},
        { "location": "38/SEL"    , "narrator": "", "text": "電灯"},
        { "location": "39/SEL"    , "narrator": "", "text": "確信"},
        { "location": "40/SEL"    , "narrator": "", "text": "どちらでもない"},
        { "location": "41/ACT"    , "narrator": "", "text": "電灯"},
        { "location": "43/TALK"   , "narrator": "みやび", "text": "ちょっと"},
        { "location": "44/TALK"   , "narrator": "みやび", "text": "違うな"},
        { "location": "45/ACT"    , "narrator": "", "text": "確信"},
        { "location": "46/TALK"   , "narrator": "みやび", "text": "何について"},
        { "location": "47/TALK"   , "narrator": "みやび", "text": "確信を持ったのだ"},
        { "location": "48/ACT"    , "narrator": "", "text": "どちらでもない"},
        { "location": "49/TALK"   , "narrator": "みやび", "text": "いや"},
        { "location": "50/TALK"   , "narrator": "みやび", "text": "第三勢力はいらん"},
        { "location": "53/TALK"   , "narrator": "みやび", "text": "つまりだな"},
        { "location": "54/TALK"   , "narrator": "みやび", "text": "ガブリエラ嬢に"},
        { "location": "55/TALK"   , "narrator": "みやび", "text": "ミニ丈の着物はちょっとと言われたのだが"},
        { "location": "56/TALK"   , "narrator": "みやび", "text": "これはそんなに変なのであろうか？"},
        { "location": "58/SEL"    , "narrator": "", "text": "可愛いと思う"},
        { "location": "59/SEL"    , "narrator": "", "text": "う～ん…"},
        { "location": "60/SEL"    , "narrator": "", "text": "普通のがいいな"},
        { "location": "61/ACT"    , "narrator": "", "text": "可愛いと思う"},
        { "location": "63/TALK"   , "narrator": "みやび", "text": "なんと"},
        { "location": "64/TALK"   , "narrator": "みやび", "text": "予想外の回答"},
        { "location": "65/TALK"   , "narrator": "みやび", "text": "やるな相棒"},
        { "location": "66/TALK"   , "narrator": "みやび", "text": "このナンパ師め"},
        { "location": "67/ACT"    , "narrator": "", "text": "う～ん…"},
        { "location": "68/TALK"   , "narrator": "みやび", "text": "や"},
        { "location": "70/TALK"   , "narrator": "みやび", "text": "なんとも微妙な反応"},
        { "location": "72/TALK"   , "narrator": "みやび", "text": "意外と保守的"},
        { "location": "73/TALK"   , "narrator": "みやび", "text": "これはしらなんだ"},
        { "location": "74/ACT"    , "narrator": "", "text": "普通のがいいな"},
        { "location": "75/TALK"   , "narrator": "みやび", "text": "普通"},
        { "location": "76/TALK"   , "narrator": "みやび", "text": "即ち保守派ということか"},
        { "location": "77/TALK"   , "narrator": "みやび", "text": "まあ確かに気持ちはわからんでもない"}
    ]
}
