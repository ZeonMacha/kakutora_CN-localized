{
    "dir": "chap19/daydra/dd_ch02_19_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "19202",
        "cid": "ayami",
        "title": "002 メインストーリー",
        "sub_title": "気にしすぎの湯＜前編＞"
    },
    "entry":
    [
        { "location": "38/TALK"   , "narrator": "ガブリエラ", "text": "あ～、やっと汗\n流せるわぁ"},
        { "location": "40/TALK"   , "narrator": "アーヤ", "text": "でも、こっちにも\n近所に銭湯があって\nよかったわ。"},
        { "location": "42/TALK"   , "narrator": "みやび", "text": "いつもの銭湯より\nちっくと年期\n入っちょるけんどね。"},
        { "location": "45/TALK"   , "narrator": "ガブリエラ", "text": "あら、あたしは\n素敵だと思うけど？"},
        { "location": "46/TALK"   , "narrator": "ガブリエラ", "text": "っていうか、みやび。"},
        { "location": "47/TALK"   , "narrator": "ガブリエラ", "text": "訓練の後なのに\n珍しく元気あるみたい\nじゃない。"},
        { "location": "48/TALK"   , "narrator": "みやび", "text": "いや、今日は体力\n作りの運動やなくて、\n模擬戦やったろ？"},
        { "location": "49/TALK"   , "narrator": "ガブリエラ", "text": "ええ、\n楽しかったわね。"},
        { "location": "51/TALK"   , "narrator": "みやび", "text": "うむ、うちも珍しくて\n楽しい思うたがよ。"},
        { "location": "53/TALK"   , "narrator": "アーヤ", "text": "確かに\n珍しかった。"},
        { "location": "54/TALK"   , "narrator": "アーヤ", "text": "だけどね。"},
        { "location": "55/TALK"   , "narrator": "アーヤ", "text": "訓練なんだから\n楽しんだりしたら\nダメでしょ？"},
        { "location": "56/TALK"   , "narrator": "ガブリエラ", "text": "固いわねぇ。"},
        { "location": "58/TALK"   , "narrator": "アーヤ", "text": "いや、普通だから。"},
        { "location": "59/TALK"   , "narrator": "みやび", "text": "でも、ガブちゃんは\n真面目に\nやっちょった。"},
        { "location": "60/TALK"   , "narrator": "みやび", "text": "アーヤもよく\nわかっちょるん\nやないが？"},
        { "location": "61/TALK"   , "narrator": "アーヤ", "text": "どういう意味よ？"},
        { "location": "62/TALK"   , "narrator": "みやび", "text": "ガブちゃんとの\nコンビプレイ、\n最高やったぞね。"},
        { "location": "63/TALK"   , "narrator": "ガブリエラ", "text": "えっ…？"},
        { "location": "64/TALK"   , "narrator": "みやび", "text": "卯月とつばめちゃんも\n悪うはなかった。"},
        { "location": "65/TALK"   , "narrator": "みやび", "text": "けんど――"},
        { "location": "66/TALK"   , "narrator": "みやび", "text": "アーヤとガブちゃんに\n比べたらまだまだ\nひよっこやね。"},
        { "location": "67/TALK"   , "narrator": "アーヤ", "text": "あはは…それはまあ、\n経験の差よ。"},
        { "location": "68/TALK"   , "narrator": "アーヤ", "text": "つばめ達が入隊する\nずっと前から\nコンビなんだもの。"},
        { "location": "69/TALK"   , "narrator": "みやび", "text": "しかも、現在進行形で\nコンビネーション\n上がりまくりやしね。"},
        { "location": "70/TALK"   , "narrator": "みやび", "text": "うちが入隊したとき\nよりも、更に良くなっ\nちょるぞね。"},
        { "location": "71/TALK"   , "narrator": "ガブリエラ", "text": "ふふん。\nまあ、当然のことよ。"},
        { "location": "72/TALK"   , "narrator": "アーヤ", "text": "…そうね。"},
        { "location": "73/TALK"   , "narrator": "アーヤ", "text": "でも、つばめ達の方は\nバラバラだったわ。"},
        { "location": "74/TALK"   , "narrator": "アーヤ", "text": "ちゃんとお互いを\n見てなかった……。"},
        { "location": "75/TALK"   , "narrator": "アーヤ", "text": "あれじゃ\nコンビネーションが\n上手くいくはずない…。"},
        { "location": "77/TALK"   , "narrator": "ガブリエラ", "text": "あたし達に比べたら\nつばめ達なんて\nまだまだよね。"},
        { "location": "78/TALK"   , "narrator": "アーヤ", "text": "やっぱり、問題がある\nのは卯月の方かしら？"},
        { "location": "80/TALK"   , "narrator": "アーヤ", "text": "まあ、その理由も\nわからなくはないん\nだけど…。"},
        { "location": "81/TALK"   , "narrator": "ガブリエラ", "text": "あたし達はもう\n一々言葉に出したり\nなんてしてない。"},
        { "location": "82/TALK"   , "narrator": "ガブリエラ", "text": "でもお互いに\n何をしようとしてるかは\nわかっちゃうのよ。"},
        { "location": "83/TALK"   , "narrator": "みやび", "text": "シックスセンスか？"},
        { "location": "85/TALK"   , "narrator": "ガブリエラ", "text": "う～ん…慣れ、って\nくらいの言葉の方が\nしっくりくるかも。"},
        { "location": "87/TALK"   , "narrator": "ガブリエラ", "text": "アーヤの動きを\n見てれば次の動きの\n予想はつくわ。"},
        { "location": "88/TALK"   , "narrator": "みやび", "text": "なるほどなぁ…。\nアーヤもそうなが？"},
        { "location": "90/TALK"   , "narrator": "ガブリエラ", "text": "当然でしょ？\nね、アーヤ？"},
        { "location": "91/TALK"   , "narrator": "アーヤ", "text": "私が話したとして、\nそれでどうにかなる\n問題なのかしら？"},
        { "location": "92/TALK"   , "narrator": "アーヤ", "text": "下手すると逆効果に\nなっちゃいそうだし。"},
        { "location": "93/TALK"   , "narrator": "ガブリエラ", "text": "アーヤ？\n話聞いてる？"},
        { "location": "95/TALK"   , "narrator": "アーヤ", "text": "え？　あ、ごめん。\nちょっと考え事\nしてて…。"},
        { "location": "96/TALK"   , "narrator": "みやび", "text": "何か悩みでもあるが？"},
        { "location": "97/TALK"   , "narrator": "アーヤ", "text": "悩みっていうか…、\nほら、卯月のことよ。"},
        { "location": "98/TALK"   , "narrator": "アーヤ", "text": "この前の一件から\n元気がないでしょ。"},
        { "location": "99/TALK"   , "narrator": "アーヤ", "text": "今日の模擬戦でも、\nやっぱり本調子じゃ\nなかったし。"},
        { "location": "100/TALK"  , "narrator": "アーヤ", "text": "二人も気づいた\nでしょ？"},
        { "location": "101/TALK"  , "narrator": "みやび", "text": "…まあ、凡ミスな\n失敗が多かったな。"},
        { "location": "102/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "104/TALK"  , "narrator": "アーヤ", "text": "やっぱり、メノウって\nバレたこと\n気にしてるのかしら。"},
        { "location": "105/TALK"  , "narrator": "みやび", "text": "そうやないが？"},
        { "location": "106/TALK"  , "narrator": "みやび", "text": "ちゅうか、逆に\n疑問ぞね。"},
        { "location": "107/TALK"  , "narrator": "みやび", "text": "そこまで気にする\nほどショックな\n理由があるが？"},
        { "location": "108/TALK"  , "narrator": "みやび", "text": "別に自分の恥部やと\n思うてるわけでも\nなかろうし…。"},
        { "location": "109/TALK"  , "narrator": "アーヤ", "text": "バレたらダメ、って\n契約をしてるとか？"},
        { "location": "110/TALK"  , "narrator": "みやび", "text": "契約がらみか…。"},
        { "location": "111/TALK"  , "narrator": "みやび", "text": "やったらここに\n居られんやろうき\n違うと思うちや。"},
        { "location": "113/TALK"  , "narrator": "アーヤ", "text": "ん～…、ギャヴィは\nどう思う？"},
        { "location": "115/TALK"  , "narrator": "ガブリエラ", "text": "知るわけないでしょ？"},
        { "location": "116/TALK"  , "narrator": "ガブリエラ", "text": "あたしは卯月でも\nなければ、メノウでも\nないんだし。"},
        { "location": "117/TALK"  , "narrator": "アーヤ", "text": "何怒ってるのよ？"},
        { "location": "118/TALK"  , "narrator": "ガブリエラ", "text": "怒ってないわよ！"},
        { "location": "119/TALK"  , "narrator": "アーヤ", "text": "…まあ、理由はなんと\nなくわかるけど。"},
        { "location": "120/TALK"  , "narrator": "アーヤ", "text": "多分、ギャヴィ達の\n話をちゃんと聞いて\nなかったせいよね？"},
        { "location": "121/TALK"  , "narrator": "アーヤ", "text": "…ていうか、それより\n卯月のことの方が、\n今は重要だもの。"},
        { "location": "122/TALK"  , "narrator": "アーヤ", "text": "私たち全員に関わる\n問題でもあるんだし。"},
        { "location": "123/TALK"  , "narrator": "アーヤ", "text": "それに、訓練終わりで\n疲れてるのよ\nこっちだって。"},
        { "location": "124/TALK"  , "narrator": "アーヤ", "text": "ギャヴィの\nご機嫌取りばっかり\nしてられないわ。"},
        { "location": "125/TALK"  , "narrator": "アーヤ", "text": "はぁ…。"},
        { "location": "189/TALK"  , "narrator": "アーヤ", "text": "　"},
        { "location": "203/TALK"  , "narrator": "アーヤ", "text": "[ココロゲート]へ\nいらっしゃい。\n$handle$さん。"},
        { "location": "204/SEL"   , "narrator": "", "text": "今日はサービスデー？"},
        { "location": "205/SEL"   , "narrator": "", "text": "挑発？"},
        { "location": "206/ACT"   , "narrator": "", "text": "今日はサービスデー？"},
        { "location": "207/TALK"  , "narrator": "アーヤ", "text": "なんかね、そうみたい。\n海に来てるからって\nことらしいんだけど。"},
        { "location": "208/ACT"   , "narrator": "", "text": "挑発？"},
        { "location": "210/TALK"  , "narrator": "アーヤ", "text": "ええっ！？"},
        { "location": "211/TALK"  , "narrator": "アーヤ", "text": "何で私が貴方を\n挑発しなくちゃ\nならないわけ！？"},
        { "location": "212/TALK"  , "narrator": "アーヤ", "text": "真っ先にその言葉が出る\n貴方の頭の中って\nどうなってるのかしらね。"},
        { "location": "215/TALK"  , "narrator": "アーヤ", "text": "さて――"},
        { "location": "216/SEL"   , "narrator": "", "text": "もう仕事するの？"},
        { "location": "217/SEL"   , "narrator": "", "text": "やっぱり気になるんだけど"},
        { "location": "218/ACT"   , "narrator": "", "text": "もう仕事するの？"},
        { "location": "219/TALK"  , "narrator": "アーヤ", "text": "え？"},
        { "location": "220/TALK"  , "narrator": "アーヤ", "text": "そうだけど……\nだめだった？"},
        { "location": "221/SEL"   , "narrator": "", "text": "いや、大丈夫"},
        { "location": "222/SEL"   , "narrator": "", "text": "もうちょっとお話したい"},
        { "location": "223/ACT"   , "narrator": "", "text": "いや、大丈夫"},
        { "location": "224/TALK"  , "narrator": "アーヤ", "text": "そう。\nそれじゃ仕事するわね。"},
        { "location": "225/ACT"   , "narrator": "", "text": "もうちょっとお話したい"},
        { "location": "227/TALK"  , "narrator": "アーヤ", "text": "そうなの？\nでも何の話をすれば\nいいのかしら。"},
        { "location": "228/SEL"   , "narrator": "", "text": "適当に世間話しながらマッタリしよう"},
        { "location": "229/SEL"   , "narrator": "", "text": "前の司書がどうなったのかの話して"},
        { "location": "230/ACT"   , "narrator": "", "text": "適当に世間話しながらマッタリしよう"},
        { "location": "232/TALK"  , "narrator": "アーヤ", "text": "適当な世間話ねぇ……。"},
        { "location": "233/SEL"   , "narrator": "", "text": "例えば最近思ってることとか"},
        { "location": "234/SEL"   , "narrator": "", "text": "例えば最近人によく言われることとか"},
        { "location": "235/ACT"   , "narrator": "", "text": "例えば最近思ってることとか"},
        { "location": "236/TALK"  , "narrator": "アーヤ", "text": "最近思ってること、ねえ。"},
        { "location": "237/TALK"  , "narrator": "アーヤ", "text": "あー、そういえば。"},
        { "location": "238/TALK"  , "narrator": "アーヤ", "text": "最近ちょっと\n激しすぎかもって\n思ったりしてるわね。"},
        { "location": "239/SEL"   , "narrator": "", "text": "え！？"},
        { "location": "240/ACT"   , "narrator": "", "text": "え！？"},
        { "location": "242/TALK"  , "narrator": "アーヤ", "text": "体力有り余ってるの\nかしら。それとも、\n色々溜まってるのかも…。"},
        { "location": "243/ACT"   , "narrator": "", "text": "例えば最近人によく言われることとか"},
        { "location": "244/TALK"  , "narrator": "アーヤ", "text": "そうねえ…、\nそういえば……。"},
        { "location": "245/TALK"  , "narrator": "アーヤ", "text": "私最近、激しいって\n言われるのよね。"},
        { "location": "246/SEL"   , "narrator": "", "text": "え！？"},
        { "location": "247/ACT"   , "narrator": "", "text": "え！？"},
        { "location": "249/TALK"  , "narrator": "アーヤ", "text": "体力有り余ってるんじゃ\nないかと。それか、\n色々溜まってるのかって。"},
        { "location": "251/SEL"   , "narrator": "", "text": "何が激しいの？"},
        { "location": "252/SEL"   , "narrator": "", "text": "やだ、すごい///"},
        { "location": "253/ACT"   , "narrator": "", "text": "何が激しいの？"},
        { "location": "254/TALK"  , "narrator": "アーヤ", "text": "もちろん、\n毎日の基礎体力\nカリキュラムよ。"},
        { "location": "255/TALK"  , "narrator": "アーヤ", "text": "だって、やりたいこと\n沢山あって、いくら時間が\nあっても足りないから。"},
        { "location": "256/TALK"  , "narrator": "アーヤ", "text": "途中でバテちゃって\nできなくなったら\n絶対後悔するでしょ？"},
        { "location": "257/TALK"  , "narrator": "アーヤ", "text": "だから、そうならないよう\n基礎体力つけようと、\n頑張ってるんだけど……。"},
        { "location": "258/SEL"   , "narrator": "", "text": "何をやってるの？"},
        { "location": "259/ACT"   , "narrator": "", "text": "何をやってるの？"},
        { "location": "261/TALK"  , "narrator": "アーヤ", "text": "朝ジョギング\n５ｋｍでしょ？"},
        { "location": "262/TALK"  , "narrator": "アーヤ", "text": "夕方はスポーツジムで\n水泳を１ｋｍくらい？"},
        { "location": "263/TALK"  , "narrator": "アーヤ", "text": "あとは――"},
        { "location": "264/SEL"   , "narrator": "", "text": "確かに激しいですね"},
        { "location": "265/SEL"   , "narrator": "", "text": "まだ全然ぬるいね"},
        { "location": "266/ACT"   , "narrator": "", "text": "確かに激しいですね"},
        { "location": "267/TALK"  , "narrator": "アーヤ", "text": "やっぱりそうなのね…。\nちょっと減らそうかしら。"},
        { "location": "268/ACT"   , "narrator": "", "text": "まだ全然ぬるいね"},
        { "location": "269/TALK"  , "narrator": "アーヤ", "text": "ええっ！？\nそうなの？"},
        { "location": "270/TALK"  , "narrator": "アーヤ", "text": "うーん、まあでも、\n現役の運動選手とかじゃ\nないし……。"},
        { "location": "271/TALK"  , "narrator": "アーヤ", "text": "あ、でもトライナリーの\n任務って、運動選手よりも\nシビアかもしれないわね。"},
        { "location": "272/TALK"  , "narrator": "アーヤ", "text": "そう考えるとやっぱり\nまだぬるいのかしら……。"},
        { "location": "273/TALK"  , "narrator": "アーヤ", "text": "もうちょっと\n考え直す必要が\nありそうね。"},
        { "location": "275/TALK"  , "narrator": "アーヤ", "text": "…っと、こんな感じで\nいいかしらね？\n世間話って。"},
        { "location": "276/ACT"   , "narrator": "", "text": "やだ、すごい///"},
        { "location": "278/TALK"  , "narrator": "アーヤ", "text": "は？\nなにが！？"},
        { "location": "279/SEL"   , "narrator": "", "text": "ナイトタイムでしょ？"},
        { "location": "280/ACT"   , "narrator": "", "text": "ナイトタイムでしょ？"},
        { "location": "282/TALK"  , "narrator": "アーヤ", "text": "ええっ！？\nち、違うわよ！！"},
        { "location": "283/TALK"  , "narrator": "アーヤ", "text": "もぅ…冗談でもやめてよ\nそういうの。"},
        { "location": "284/TALK"  , "narrator": "アーヤ", "text": "想像して\n恥ずかしくなっちゃった\nじゃない……。"},
        { "location": "285/SEL"   , "narrator": "", "text": "何を想像したの？"},
        { "location": "286/ACT"   , "narrator": "", "text": "何を想像したの？"},
        { "location": "288/TALK"  , "narrator": "アーヤ", "text": "その手には乗りません！\nはい、仕事仕事！！"},
        { "location": "290/ACT"   , "narrator": "", "text": "前の司書がどうなったのかの話して"},
        { "location": "291/TALK"  , "narrator": "アーヤ", "text": "前の司書も何も、\n私は一人よ？"},
        { "location": "292/SEL"   , "narrator": "", "text": "本当に！？"},
        { "location": "293/ACT"   , "narrator": "", "text": "本当に！？"},
        { "location": "295/TALK"  , "narrator": "アーヤ", "text": "ちょっとしつこくない？"},
        { "location": "296/TALK"  , "narrator": "アーヤ", "text": "もうその話は\n聞きたくないんだけど。"},
        { "location": "297/TALK"  , "narrator": "アーヤ", "text": "もういいわ。\n先に進ませてもらいます。"},
        { "location": "301/ACT"   , "narrator": "", "text": "やっぱり気になるんだけど"},
        { "location": "303/TALK"  , "narrator": "アーヤ", "text": "え？\nなんのこと？"},
        { "location": "304/SEL"   , "narrator": "", "text": "前々回で話そうとしていたこと"},
        { "location": "305/ACT"   , "narrator": "", "text": "前々回で話そうとしていたこと"},
        { "location": "307/TALK"  , "narrator": "アーヤ", "text": "あれはもういいのよ。\n忘れてって言ったでしょ？"},
        { "location": "308/SEL"   , "narrator": "", "text": "まあそうだけど"},
        { "location": "309/SEL"   , "narrator": "", "text": "もう意味なくてもいいから、内容だけでも教えて？"},
        { "location": "310/ACT"   , "narrator": "", "text": "まあそうだけど"},
        { "location": "311/TALK"  , "narrator": "アーヤ", "text": "そういうわけだから、\n仕事しましょ？"},
        { "location": "312/ACT"   , "narrator": "", "text": "もう意味なくてもいいから、内容だけでも教えて？"},
        { "location": "313/TALK"  , "narrator": "アーヤ", "text": "だーめ！"},
        { "location": "314/SEL"   , "narrator": "", "text": "なんでそんなに頑ななの？"},
        { "location": "315/SEL"   , "narrator": "", "text": "やっぱり違う人格だから知らないんだ、内容のこと"},
        { "location": "316/ACT"   , "narrator": "", "text": "なんでそんなに頑ななの？"},
        { "location": "317/TALK"  , "narrator": "アーヤ", "text": "人には秘密にしておきたい\nことの１つや２つ、\nあるでしょう？"},
        { "location": "318/TALK"  , "narrator": "アーヤ", "text": "そうやって\nしつこく詮索すると\n嫌われるわよ？"},
        { "location": "319/TALK"  , "narrator": "アーヤ", "text": "さあ、仕事仕事。"},
        { "location": "320/ACT"   , "narrator": "", "text": "やっぱり違う人格だから知らないんだ、内容のこと"},
        { "location": "321/TALK"  , "narrator": "アーヤ", "text": "まさか！"},
        { "location": "322/TALK"  , "narrator": "アーヤ", "text": "もう、そんな\nわけわからないこと\n言ってないで、仕事仕事。"},
        { "location": "326/TALK"  , "narrator": "アーヤ", "text": "それじゃ改めて、\n今回の悩みを\n検索するわね。"},
        { "location": "332/TALK"  , "narrator": "アーヤ", "text": "オープンプロセス、\n0x307番地から\n0xBCF番地へ。"},
        { "location": "349/TALK"  , "narrator": "アーヤ", "text": "シーク完了。"},
        { "location": "352/TALK"  , "narrator": "アーヤ", "text": "さて、と。\n今回は……"},
        { "location": "354/TALK"  , "narrator": "アーヤ", "text": "…なるほど。"},
        { "location": "355/TALK"  , "narrator": "アーヤ", "text": "そうね、まあやっぱり\nここはギャヴィに\nちゃんと謝るべきよね。"},
        { "location": "356/TALK"  , "narrator": "アーヤ", "text": "という方向性で\nお願いします。"},
        { "location": "357/SEL"   , "narrator": "", "text": "オッケー"},
        { "location": "358/SEL"   , "narrator": "", "text": "何で謝る必要があるのか、意味が分からない"},
        { "location": "359/ACT"   , "narrator": "", "text": "オッケー"},
        { "location": "360/TALK"  , "narrator": "アーヤ", "text": "ふふ、ありがと。"},
        { "location": "361/ACT"   , "narrator": "", "text": "何で謝る必要があるのか、意味が分からない"},
        { "location": "363/TALK"  , "narrator": "アーヤ", "text": "うーん、困ったわね。"},
        { "location": "364/TALK"  , "narrator": "アーヤ", "text": "貴方にはわからないかも\nしれないけど、\n私にはわかるのよ。"},
        { "location": "365/TALK"  , "narrator": "アーヤ", "text": "ギャヴィが怒ってるのは\n私がちゃんと話を\n聞かなかったからで――"},
        { "location": "366/TALK"  , "narrator": "アーヤ", "text": "ここは謝っておいた方が\n今後の関係が面倒な事に\nならなくて済むのよ。"},
        { "location": "367/SEL"   , "narrator": "", "text": "なるほど"},
        { "location": "368/SEL"   , "narrator": "", "text": "そんな必要なくない？"},
        { "location": "369/ACT"   , "narrator": "", "text": "なるほど"},
        { "location": "370/TALK"  , "narrator": "アーヤ", "text": "わかった？"},
        { "location": "371/ACT"   , "narrator": "", "text": "そんな必要なくない？"},
        { "location": "373/TALK"  , "narrator": "アーヤ", "text": "必要あるか無いかは\n私が決めるから。"},
        { "location": "374/TALK"  , "narrator": "アーヤ", "text": "だいたい、こんな些細な\n悩みなんて、適当に\n流してくれればいいの。"},
        { "location": "375/SEL"   , "narrator": "", "text": "まあそうかもしれないけど…"},
        { "location": "376/SEL"   , "narrator": "", "text": "些細な悩みなのになんでアラートが出てるの！？"},
        { "location": "377/ACT"   , "narrator": "", "text": "まあそうかもしれないけど…"},
        { "location": "378/TALK"  , "narrator": "アーヤ", "text": "でしょ。\nだから謝る方にして。"},
        { "location": "379/ACT"   , "narrator": "", "text": "些細な悩みなのになんでアラートが出てるの！？"},
        { "location": "381/TALK"  , "narrator": "アーヤ", "text": "うーん、アラートに\n悩みの大小は\n関係ないのよ。"},
        { "location": "382/SEL"   , "narrator": "", "text": "本当にそうなら1日中ひっきりなしにアラート出ない！？"},
        { "location": "383/ACT"   , "narrator": "", "text": "本当にそうなら1日中ひっきりなしにアラート出ない！？"},
        { "location": "385/TALK"  , "narrator": "アーヤ", "text": "いや、だから！"},
        { "location": "386/SEL"   , "narrator": "", "text": "何か隠してない？"},
        { "location": "387/ACT"   , "narrator": "", "text": "何か隠してない？"},
        { "location": "389/TALK"  , "narrator": "アーヤ", "text": "………。"},
        { "location": "390/TALK"  , "narrator": "アーヤ", "text": "１つだけ\n言わせていただきます。"},
        { "location": "391/TALK"  , "narrator": "アーヤ", "text": "ココロの司書は、國政\n綾水の人生を最高効率で\n回すための存在です。"},
        { "location": "392/TALK"  , "narrator": "アーヤ", "text": "だからこそ、選択に困って\nいるときは、最善の未来に\n向かう道を示唆する。"},
        { "location": "393/TALK"  , "narrator": "アーヤ", "text": "そういう役割を\n仰せつかって\nここにいるの。"},
        { "location": "394/SEL"   , "narrator": "", "text": "誰に仰せつかってるの？"},
        { "location": "395/ACT"   , "narrator": "", "text": "誰に仰せつかってるの？"},
        { "location": "397/TALK"  , "narrator": "アーヤ", "text": "ココロの総意に\n決まってるでしょう？"},
        { "location": "398/SEL"   , "narrator": "", "text": "閑職だって誰かが言ってたよ"},
        { "location": "399/ACT"   , "narrator": "", "text": "閑職だって誰かが言ってたよ"},
        { "location": "401/TALK"  , "narrator": "アーヤ", "text": "任命された人格によっては\n面白くないから、そう言う\n人もいるかもしれません。"},
        { "location": "402/TALK"  , "narrator": "アーヤ", "text": "けど、実際は\nココロの司書は\nかなり重要な機関です。"},
        { "location": "403/TALK"  , "narrator": "アーヤ", "text": "話が脱線したけど、\n何が言いたいかというと。"},
        { "location": "404/TALK"  , "narrator": "アーヤ", "text": "私以上に國政綾水の\nベストライフを把握する\n存在はいないんです。"},
        { "location": "405/TALK"  , "narrator": "アーヤ", "text": "だから貴方が國政綾水の\n幸せを願うというなら、\n私の指示に従って欲しい。"},
        { "location": "406/TALK"  , "narrator": "アーヤ", "text": "いいですか？"},
        { "location": "407/SEL"   , "narrator": "", "text": "わかりました"},
        { "location": "408/SEL"   , "narrator": "", "text": "いやです"},
        { "location": "409/ACT"   , "narrator": "", "text": "わかりました"},
        { "location": "410/TALK"  , "narrator": "アーヤ", "text": "助かります。"},
        { "location": "411/ACT"   , "narrator": "", "text": "いやです"},
        { "location": "412/TALK"  , "narrator": "アーヤ", "text": "はぁ……。"},
        { "location": "413/TALK"  , "narrator": "アーヤ", "text": "貴方は國政綾水の\nベストを願わないの？\nココロを破壊しに来たの？"},
        { "location": "414/TALK"  , "narrator": "アーヤ", "text": "まあいいわ。とりあえず\n扉は開けておくから。"},
        { "location": "415/TALK"  , "narrator": "アーヤ", "text": "本当に私の幸せを願うなら\nクランを倒してください。"},
        { "location": "416/TALK"  , "narrator": "アーヤ", "text": "それじゃ、\n素敵なココロの旅を。"},
        { "location": "422/TALK"  , "narrator": "アーヤ", "text": "それじゃ今回も、\n宜しくお願いね。"},
        { "location": "423/TALK"  , "narrator": "アーヤ", "text": "$handle$さんと\n國政綾水にとって、\n素敵なココロの旅を！"},
        { "location": "35/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>8月18日　 3:23 PM</color>\n合宿二日目、午後の訓練終了後のこと"},
        { "location": "154/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "156/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "158/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "160/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "162/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "339/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:Message】</color>\n\n【エヴェレット】様から\nメッセージが届いています。"},
        { "location": "340/DIALOG", "narrator": "INFO", "text": "<color=green>【PN:エヴェレット】(1/1)</color>\n\n$handle$さん\n\nお元気ですか？　元司書です。\n鋭い貴方のことだから、もう気づいてると思いますが、そこにいる司書は私とは別の人格です。\n\n私が貴方に大事な話を伝えようとしたことが《とある存在》にバレて、幽閉されました。\n\nここで伝えるには文字数が足りず、また現司書に感づかれると面倒なので、次回貴方が私の元に来られるように仕掛けを作っています。作っているのは私じゃないけど(^^;;\n\nコードは【1x0FF】。\nこれだけ覚えておいてください。\nそれじゃまた。どうかご無事で。"}
    ]
}
