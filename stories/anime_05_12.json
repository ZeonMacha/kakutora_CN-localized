{
    "dir": "chap12/daydra/anime_05_12.js",
    "type": "MainStory",
    "info": {
        "story_id": "12501",
        "cid": "kagura",
        "title": "001 アニメーション",
        "sub_title": "プロテクトイエロー"
    },
    "entry":
    [
        { "location": "1206/SCENARIO", "narrator": "", "text": "アニメ第12話"},
        { "location": "1222/TALK"    , "narrator": "千羽鶴", "text": "大変、\n$handle$！"},
        { "location": "1223/SEL"     , "narrator": "", "text": "どうしたの！？"},
        { "location": "1224/ACT"     , "narrator": "", "text": "どうしたの！？"},
        { "location": "1226/TALK"    , "narrator": "千羽鶴", "text": "ちーは\nウッカリしていた！"},
        { "location": "1227/TALK"    , "narrator": "千羽鶴", "text": "前回仲直りに浮か"},
        { "location": "1229/TALK"    , "narrator": "千羽鶴", "text": "……。"},
        { "location": "1231/TALK"    , "narrator": "千羽鶴", "text": "仲直りの手続きに\n翻弄されてしまった\n結果――"},
        { "location": "1232/TALK"    , "narrator": "千羽鶴", "text": "最も大事な選択肢の\n再選択をしていなかった。"},
        { "location": "1233/SEL"     , "narrator": "", "text": "それってあの世界の方針の？"},
        { "location": "1234/SEL"     , "narrator": "", "text": "なるほど浮かれてたんだね"},
        { "location": "1235/ACT"     , "narrator": "", "text": "それってあの世界の方針の？"},
        { "location": "1236/TALK"    , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "1237/TALK"    , "narrator": "千羽鶴", "text": "だから、急だけど\n今から再選択を\nしてもらう。"},
        { "location": "1238/ACT"     , "narrator": "", "text": "なるほど浮かれてたんだね"},
        { "location": "1242/TALK"    , "narrator": "千羽鶴", "text": "思わず勢いで\n“やり終えて”しまった！"},
        { "location": "1243/TALK"    , "narrator": "千羽鶴", "text": "ちょっとだけ\n知的なギャグ…！"},
        { "location": "1244/SEL"     , "narrator": "", "text": "Doneは完了だもんね…"},
        { "location": "1245/ACT"     , "narrator": "", "text": "Doneは完了だもんね…"},
        { "location": "1248/TALK"    , "narrator": "千羽鶴", "text": "……。"},
        { "location": "1249/TALK"    , "narrator": "千羽鶴", "text": "…そうだけど、何か？"},
        { "location": "1250/SEL"     , "narrator": "", "text": "いいえ（フフッ"},
        { "location": "1251/ACT"     , "narrator": "", "text": "いいえ（フフッ"},
        { "location": "1253/TALK"    , "narrator": "千羽鶴", "text": "……。"},
        { "location": "1255/TALK"    , "narrator": "千羽鶴", "text": "と、そんなことは\nどうでもいい。"},
        { "location": "1256/TALK"    , "narrator": "千羽鶴", "text": "そういうわけだから、\n急だけど今から\n再選択をしてもらう。"},
        { "location": "1260/SEL"     , "narrator": "", "text": "千羽鶴の理想的社会創造を支持し、トライナリーの発症を容認する"},
        { "location": "1261/SEL"     , "narrator": "", "text": "千羽鶴の理想的社会創造は賛同するが、トライナリーの発症は容認できない"},
        { "location": "1262/SEL"     , "narrator": "", "text": "千羽鶴の理想的社会創造は支持できないが、千羽鶴に好感は持てる"},
        { "location": "1263/ACT"     , "narrator": "", "text": "千羽鶴の理想的社会創造を支持し、トライナリーの発症を容認する"},
        { "location": "1265/ACT"     , "narrator": "", "text": "千羽鶴の理想的社会創造は賛同するが、トライナリーの発症は容認できない"},
        { "location": "1267/ACT"     , "narrator": "", "text": "千羽鶴の理想的社会創造は支持できないが、千羽鶴に好感は持てる"},
        { "location": "1271/TALK"    , "narrator": "千羽鶴", "text": "わかった。\nありがと。"},
        { "location": "1272/TALK"    , "narrator": "千羽鶴", "text": "貴方の今の気持ちとして\nしっかり覚えておくから。"},
        { "location": "1273/TALK"    , "narrator": "千羽鶴", "text": "というわけで、\nあらためて――"},
        { "location": "1279/TALK"    , "narrator": "千羽鶴", "text": "ごきげんよう、\n$handle$。"},
        { "location": "1280/TALK"    , "narrator": "千羽鶴", "text": "もう一度\n私との会話を\n再現する？"},
        { "location": "1281/SEL"     , "narrator": "", "text": "はい"},
        { "location": "1282/SEL"     , "narrator": "", "text": "いいえ"},
        { "location": "1283/ACT"     , "narrator": "", "text": "はい"},
        { "location": "1284/TALK"    , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "1286/ACT"     , "narrator": "", "text": "いいえ"},
        { "location": "1287/TALK"    , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "1295/TALK"    , "narrator": "千羽鶴", "text": "今回は業務連絡レベルも\n何も無いから――"},
        { "location": "1296/TALK"    , "narrator": "千羽鶴", "text": "とりあえず、\n記録映像だけでも\n見ていく？"},
        { "location": "1301/TALK"    , "narrator": "千羽鶴", "text": "<size=40>すとちー！</size>"},
        { "location": "1302/SEL"     , "narrator": "", "text": "えっと、格ゲー？"},
        { "location": "1303/SEL"     , "narrator": "", "text": "トーストの仲間？"},
        { "location": "1304/ACT"     , "narrator": "", "text": "えっと、格ゲー？"},
        { "location": "1305/TALK"    , "narrator": "千羽鶴", "text": "それは確かに\n面白そうだけど、\nちょっと違う。"},
        { "location": "1306/ACT"     , "narrator": "", "text": "トーストの仲間？"},
        { "location": "1307/TALK"    , "narrator": "千羽鶴", "text": "それなら\nちーすと！"},
        { "location": "1308/TALK"    , "narrator": "千羽鶴", "text": "略さないで言うと\nチーズトースト？"},
        { "location": "1309/TALK"    , "narrator": "千羽鶴", "text": "それとも、\nちートースト？"},
        { "location": "1311/TALK"    , "narrator": "千羽鶴", "text": "いや、\nそんなことは\nどうでもいい。"},
        { "location": "1312/TALK"    , "narrator": "千羽鶴", "text": "すとちーは\nストライキ千羽鶴の\n省略形。"},
        { "location": "1313/TALK"    , "narrator": "千羽鶴", "text": "ちーはどうやら\n今までの反動が\n来ているみたい。"},
        { "location": "1314/TALK"    , "narrator": "千羽鶴", "text": "その結果、\nちょっと働き過ぎたので\n１回休み！"},
        { "location": "1315/SEL"     , "narrator": "", "text": "えー！！！　前回あれだけヒマヒマ言ってたじゃん！"},
        { "location": "1316/SEL"     , "narrator": "", "text": "それじゃ一緒に休もうか"},
        { "location": "1317/ACT"     , "narrator": "", "text": "えー！！！　前回あれだけヒマヒマ言ってたじゃん！"},
        { "location": "1318/TALK"    , "narrator": "千羽鶴", "text": "言ってた割には\nよく働いた気がする。"},
        { "location": "1319/TALK"    , "narrator": "千羽鶴", "text": "前回。"},
        { "location": "1320/ACT"     , "narrator": "", "text": "それじゃ一緒に休もうか"},
        { "location": "1321/TALK"    , "narrator": "千羽鶴", "text": "貴方と一緒にいたら\n休憩にならないから却下。"},
        { "location": "1323/TALK"    , "narrator": "千羽鶴", "text": "ちーは思ったの。"},
        { "location": "1324/TALK"    , "narrator": "千羽鶴", "text": "現実では情報管理庁長官、\n仮想空間では\nラブラブトレーナー。"},
        { "location": "1325/TALK"    , "narrator": "千羽鶴", "text": "これはまさに、\n副業をする公務員！"},
        { "location": "1326/TALK"    , "narrator": "千羽鶴", "text": "公務員の副業は\n禁止されている。"},
        { "location": "1327/TALK"    , "narrator": "千羽鶴", "text": "よって\nラブラブトレーナーは\n廃業する！"},
        { "location": "1328/SEL"     , "narrator": "", "text": "これ今までやってた分は後に誰かに暴露され大ニュースになるやつやん"},
        { "location": "1329/SEL"     , "narrator": "", "text": "じゃあバーチャルネットアイドルやろう！"},
        { "location": "1330/ACT"     , "narrator": "", "text": "これ今までやってた分は後に誰かに暴露され大ニュースになるやつやん"},
        { "location": "1331/TALK"    , "narrator": "千羽鶴", "text": "情報管理庁長官、\n副業でラブラブトレーナー\nとかニュースで出る？"},
        { "location": "1332/TALK"    , "narrator": "千羽鶴", "text": "それはそれで\nインパクト大きそう。"},
        { "location": "1333/SEL"     , "narrator": "", "text": "お相手は異世界人？とかサブタイトルつくよ！"},
        { "location": "1334/ACT"     , "narrator": "", "text": "お相手は異世界人？とかサブタイトルつくよ！"},
        { "location": "1337/TALK"    , "narrator": "千羽鶴", "text": "確かに。"},
        { "location": "1339/ACT"     , "narrator": "", "text": "じゃあバーチャルネットアイドルやろう！"},
        { "location": "1340/TALK"    , "narrator": "千羽鶴", "text": "無理。"},
        { "location": "1341/TALK"    , "narrator": "千羽鶴", "text": "歌へたくそだし、\n笑顔作れないから。"},
        { "location": "1342/SEL"     , "narrator": "", "text": "お言葉ですが今はそういうのがウケるんですよ！"},
        { "location": "1343/SEL"     , "narrator": "", "text": "$me$がＰになって千羽鶴にいろいろ教えてあげる"},
        { "location": "1344/ACT"     , "narrator": "", "text": "お言葉ですが今はそういうのがウケるんですよ！"},
        { "location": "1345/TALK"    , "narrator": "千羽鶴", "text": "ちーを誰だと思ってる？\n情報管理庁長官なの。"},
        { "location": "1346/TALK"    , "narrator": "千羽鶴", "text": "そんな情報に\n騙され……"},
        { "location": "1348/TALK"    , "narrator": "千羽鶴", "text": "……。"},
        { "location": "1349/TALK"    , "narrator": "千羽鶴", "text": "例えば、どういうところが\nウケるの？　具体的に。"},
        { "location": "1350/SEL"     , "narrator": "", "text": "平然と真顔で無茶苦茶な事を言うのが萌える"},
        { "location": "1351/SEL"     , "narrator": "", "text": "クールにしてるのに失敗したりしてクールに取り繕うのがかわいい"},
        { "location": "1352/ACT"     , "narrator": "", "text": "平然と真顔で無茶苦茶な事を言うのが萌える"},
        { "location": "1353/ACT"     , "narrator": "", "text": "クールにしてるのに失敗したりしてクールに取り繕うのがかわいい"},
        { "location": "1355/TALK"    , "narrator": "千羽鶴", "text": "……。"},
        { "location": "1357/TALK"    , "narrator": "千羽鶴", "text": "なるほど。"},
        { "location": "1358/TALK"    , "narrator": "千羽鶴", "text": "要領は得た。"},
        { "location": "1359/ACT"     , "narrator": "", "text": "$me$がＰになって千羽鶴にいろいろ教えてあげる"},
        { "location": "1360/TALK"    , "narrator": "千羽鶴", "text": "経験は。"},
        { "location": "1361/SEL"     , "narrator": "", "text": "もちろんあります！！！　大丈夫安心して！　絶対有名にしてあげるから！"},
        { "location": "1362/SEL"     , "narrator": "", "text": "いや、無いけど気合いは十分だから"},
        { "location": "1363/ACT"     , "narrator": "", "text": "もちろんあります！！！　大丈夫安心して！　絶対有名にしてあげるから！"},
        { "location": "1364/TALK"    , "narrator": "千羽鶴", "text": "……。"},
        { "location": "1365/TALK"    , "narrator": "千羽鶴", "text": "それは現実の話？"},
        { "location": "1366/SEL"     , "narrator": "", "text": "はい"},
        { "location": "1367/SEL"     , "narrator": "", "text": "いいえ"},
        { "location": "1368/ACT"     , "narrator": "", "text": "はい"},
        { "location": "1369/TALK"    , "narrator": "千羽鶴", "text": "わかった、覚えておく。"},
        { "location": "1370/TALK"    , "narrator": "千羽鶴", "text": "でも今回は\n遠慮しておく。"},
        { "location": "1371/ACT"     , "narrator": "", "text": "いいえ"},
        { "location": "1372/TALK"    , "narrator": "千羽鶴", "text": "察した。\nよって却下する。"},
        { "location": "1374/ACT"     , "narrator": "", "text": "いや、無いけど気合いは十分だから"},
        { "location": "1375/TALK"    , "narrator": "千羽鶴", "text": "芸能の世界は、未経験者が\n一朝一夕で当てられるほど\n甘い世界じゃないから。"},
        { "location": "1377/TALK"    , "narrator": "千羽鶴", "text": "でもその気持ちは\n嬉しいから、気持ちだけ\nもらっておくことにする。"},
        { "location": "1382/TALK"    , "narrator": "千羽鶴", "text": "とまあ、こんなくだらない\n話をしているだけでも\nヒマは潰せるものなのね。"},
        { "location": "1383/SEL"     , "narrator": "", "text": "そんなにヒマなの！？"},
        { "location": "1384/SEL"     , "narrator": "", "text": "エリカからヤバイ話を聞いてるでしょ、何とかしてよ"},
        { "location": "1385/ACT"     , "narrator": "", "text": "そんなにヒマなの！？"},
        { "location": "1386/TALK"    , "narrator": "千羽鶴", "text": "まあ、実際は\n言う程ヒマでもない。"},
        { "location": "1387/TALK"    , "narrator": "千羽鶴", "text": "だけど、前が前だったから\n相対的に時間を持て余して\nいるのは確か。"},
        { "location": "1388/ACT"     , "narrator": "", "text": "エリカからヤバイ話を聞いてるでしょ、何とかしてよ"},
        { "location": "1389/TALK"    , "narrator": "千羽鶴", "text": "聞いてはいるし、\nちゃんと出来ることは\nやっている。"},
        { "location": "1390/TALK"    , "narrator": "千羽鶴", "text": "まさか、私が本当に\n何もせずに遊んでいる\nとでも思ってた？"},
        { "location": "1391/TALK"    , "narrator": "千羽鶴", "text": "前が前だったから、少しの\n時間も持て余してしまう\nのは仕方のないこと。"},
        { "location": "1393/SEL"     , "narrator": "", "text": "ちーさん働き過ぎですよ…"},
        { "location": "1394/ACT"     , "narrator": "", "text": "ちーさん働き過ぎですよ…"},
        { "location": "1396/TALK"    , "narrator": "千羽鶴", "text": "なにごとも、\nやり過ぎるくらいが\n丁度いい！（字余り）"},
        { "location": "1397/SEL"     , "narrator": "", "text": "いやそれは違うと思います"},
        { "location": "1398/SEL"     , "narrator": "", "text": "奇遇だな…$me$もそう思っていた所だ"},
        { "location": "1399/ACT"     , "narrator": "", "text": "いやそれは違うと思います"},
        { "location": "1400/TALK"    , "narrator": "千羽鶴", "text": "冗談だから\nマトモに返さないで。"},
        { "location": "1401/ACT"     , "narrator": "", "text": "奇遇だな…$me$もそう思っていた所だ"},
        { "location": "1402/TALK"    , "narrator": "千羽鶴", "text": "過労死に注意して生きて。"},
        { "location": "1404/TALK"    , "narrator": "千羽鶴", "text": "とまあ、\nそんな冗談はさておき。"},
        { "location": "1405/TALK"    , "narrator": "千羽鶴", "text": "実は、\nちーはちゃんと\nわかっているから。"},
        { "location": "1408/TALK"    , "narrator": "千羽鶴", "text": "ヒマよヒマよも\nヒマのうち！"},
        { "location": "1409/SEL"     , "narrator": "", "text": "そのまんまですやん"},
        { "location": "1410/ACT"     , "narrator": "", "text": "そのまんまですやん"},
        { "location": "1413/TALK"    , "narrator": "千羽鶴", "text": "間違った！"},
        { "location": "1416/TALK"    , "narrator": "千羽鶴", "text": "ヒマよヒマよも\n華のうち！"},
        { "location": "1418/TALK"    , "narrator": "千羽鶴", "text": "真面目な話をすると、\nそろそろ本腰入れて\nやらないといけない。"},
        { "location": "1419/TALK"    , "narrator": "千羽鶴", "text": "だから――"},
        { "location": "1422/TALK"    , "narrator": "千羽鶴", "text": "<size=35>次々回から本気出す！</size>"},
        { "location": "1423/SEL"     , "narrator": "", "text": "あ、はい"},
        { "location": "1424/SEL"     , "narrator": "", "text": "ドヤ顔で次々回から言われても……"},
        { "location": "1425/ACT"     , "narrator": "", "text": "あ、はい"},
        { "location": "1426/TALK"    , "narrator": "千羽鶴", "text": "それは疑っている反応。"},
        { "location": "1427/ACT"     , "narrator": "", "text": "ドヤ顔で次々回から言われても……"},
        { "location": "1428/TALK"    , "narrator": "千羽鶴", "text": "時期は関係無い。\n大事なのはその本気度！"},
        { "location": "1430/TALK"    , "narrator": "千羽鶴", "text": "実際の所、そろそろ\nリプレイスのための\n準備が必要になってくる。"},
        { "location": "1431/TALK"    , "narrator": "千羽鶴", "text": "だから、次の次くらいから\n貴方に教えないといけない\nことが出てくるのは確か。"},
        { "location": "1432/TALK"    , "narrator": "千羽鶴", "text": "というわけで、\n遊んでいられるのも\n次回まで！"},
        { "location": "1433/TALK"    , "narrator": "千羽鶴", "text": "そしてその次回、\n最後の晩餐に相応しい、\n予想外のコラボが！"},
        { "location": "1434/SEL"     , "narrator": "", "text": "おおおおおっ！？！？"},
        { "location": "1435/ACT"     , "narrator": "", "text": "おおおおおっ！？！？"},
        { "location": "1437/TALK"    , "narrator": "千羽鶴", "text": "……お目見え\nするかもしれない。"},
        { "location": "1438/SEL"     , "narrator": "", "text": "楽しみ！！！"},
        { "location": "1439/SEL"     , "narrator": "", "text": "何のコラボなの？"},
        { "location": "1440/ACT"     , "narrator": "", "text": "楽しみ！！！"},
        { "location": "1441/TALK"    , "narrator": "千羽鶴", "text": "落ちないように\n祈ってて。"},
        { "location": "1442/ACT"     , "narrator": "", "text": "何のコラボなの？"},
        { "location": "1443/TALK"    , "narrator": "千羽鶴", "text": "國政領火\n　 ×\n皇千羽鶴"},
        { "location": "1444/SEL"     , "narrator": "", "text": "は？"},
        { "location": "1445/SEL"     , "narrator": "", "text": "キマシタワー！"},
        { "location": "1446/ACT"     , "narrator": "", "text": "は？"},
        { "location": "1447/TALK"    , "narrator": "千羽鶴", "text": "その反応は正しい。\n貴方はまっとう。"},
        { "location": "1448/ACT"     , "narrator": "", "text": "キマシタワー！"},
        { "location": "1449/TALK"    , "narrator": "千羽鶴", "text": "その反応は正しくない。\n貴方はまっとうではない。"},
        { "location": "1451/TALK"    , "narrator": "千羽鶴", "text": "というわけで、\nあまり期待しないで\n待っていて。"},
        { "location": "1453/TALK"    , "narrator": "千羽鶴", "text": "さて、そろそろ\n暇つぶしも終わりにして。"},
        { "location": "1454/TALK"    , "narrator": "千羽鶴", "text": "スタックポインタ\n繭内時間6月26日現在の\n記録映像でも見る？"},
        { "location": "1455/TALK"    , "narrator": "千羽鶴", "text": "……毎度おなじみ、\n同じものだけど。"},
        { "location": "1458/SEL"     , "narrator": "", "text": "映像を見る\n<color=green>【高画質/75MB 4:55】</color>"},
        { "location": "1459/SEL"     , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/24MB 4:55】</color>"},
        { "location": "1460/SEL"     , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "1461/ACT"     , "narrator": "", "text": "映像を見る\n<color=green>【高画質/75MB 4:55】</color>"},
        { "location": "1462/TALK"    , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "1468/ACT"     , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/24MB 4:55】</color>"},
        { "location": "1469/TALK"    , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "1475/ACT"     , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "1476/TALK"    , "narrator": "千羽鶴", "text": "そう……。"},
        { "location": "1509/TALK"    , "narrator": "千羽鶴", "text": "というわけで――"},
        { "location": "1510/TALK"    , "narrator": "千羽鶴", "text": "今回も<color=green>【今のちーが\n昔のちーを斬る！】</color>の\n時間がやってきた！"},
        { "location": "1511/SEL"     , "narrator": "", "text": "待ってました！"},
        { "location": "1512/SEL"     , "narrator": "", "text": "飛ばします"},
        { "location": "1513/ACT"     , "narrator": "", "text": "待ってました！"},
        { "location": "1514/TALK"    , "narrator": "千羽鶴", "text": "喜んでくれてよかった。"},
        { "location": "1515/TALK"    , "narrator": "千羽鶴", "text": "今回は何の日？"},
        { "location": "1516/TALK"    , "narrator": "千羽鶴", "text": "現実世界では、\nガブリエラが花火で\nラブラブ大作戦。"},
        { "location": "1517/TALK"    , "narrator": "千羽鶴", "text": "その後卯月神楽と\n逢瀬つばめが\nカフェデートをした。"},
        { "location": "1518/TALK"    , "narrator": "千羽鶴", "text": "この仮想空間では、\n記念すべきクソゲー\n第一弾がリリース。"},
        { "location": "1519/TALK"    , "narrator": "千羽鶴", "text": "貴方はガブリエラの恋路に\nハラハラしていたか、\nもしくは――"},
        { "location": "1520/TALK"    , "narrator": "千羽鶴", "text": "神楽チャンネルがまだ\n来ないと嘆いていた。"},
        { "location": "1521/SEL"     , "narrator": "", "text": "この時千羽鶴は嘘をついていたでしょ"},
        { "location": "1522/SEL"     , "narrator": "", "text": "神楽ちゃんラブラブゲーム（ぼそっ"},
        { "location": "1523/ACT"     , "narrator": "", "text": "この時千羽鶴は嘘をついていたでしょ"},
        { "location": "1524/TALK"    , "narrator": "千羽鶴", "text": "嘘はついてない。\n今ここで証明してもいい。"},
        { "location": "1525/TALK"    , "narrator": "千羽鶴", "text": "いえ、嘘つき呼ばわり\nされたのは\n納得いかないから――"},
        { "location": "1526/TALK"    , "narrator": "千羽鶴", "text": "今から過去の私の発言を\n１つずつ検証していく。"},
        { "location": "1529/TALK"    , "narrator": "千羽鶴", "text": "当時、貴方がしてきた質問\n『神楽CHはいつ来るの？』\nに対する返答と検証。"},
        { "location": "1530/TALK"    , "narrator": "千羽鶴", "text": "当時の私の返答を\n緑色で、それに対する\n現在の見解を黒色で出す。"},
        { "location": "1531/TALK"    , "narrator": "千羽鶴", "text": "貴方の質問：\n<color=green>『神楽CHはいつ来るの？』</color>"},
        { "location": "1532/TALK"    , "narrator": "千羽鶴", "text": "<color=green>さあ。\n今の私にはわからない。</color>"},
        { "location": "1533/TALK"    , "narrator": "千羽鶴", "text": "この時は本当に、\nいつ解禁できるか\nわからなかった。"},
        { "location": "1534/TALK"    , "narrator": "千羽鶴", "text": "もちろん、\n解禁するつもりはあった。"},
        { "location": "1535/TALK"    , "narrator": "千羽鶴", "text": "<color=green>チャンネルが増えない\nことも含めて、一つの\n大きなドラマである。</color>"},
        { "location": "1536/TALK"    , "narrator": "千羽鶴", "text": "この言葉も、\n今なら納得して\nもらえると思う。"},
        { "location": "1537/TALK"    , "narrator": "千羽鶴", "text": "今まさに、\nそのドラマの\n真っ最中だもの。"},
        { "location": "1538/TALK"    , "narrator": "千羽鶴", "text": "<color=green>もちろん、チャンネルが\n来ないことには、\nちゃんとした意味がある。</color>"},
        { "location": "1539/TALK"    , "narrator": "千羽鶴", "text": "意味はあった。"},
        { "location": "1540/TALK"    , "narrator": "千羽鶴", "text": "CH.05というTRI-OSの\nチューニングバンドは\n最初から存在していた。"},
        { "location": "1541/TALK"    , "narrator": "千羽鶴", "text": "けれども、無闇に解禁\n出来ない理由は、\n既に貴方に教えてる。"},
        { "location": "1542/TALK"    , "narrator": "千羽鶴", "text": "外の世界に、私たちと\n貴方とのやりとりが\n筒抜けになるから。"},
        { "location": "1545/TALK"    , "narrator": "千羽鶴", "text": "私が卯月神楽の\nチャンネルを解禁しようと\nした当初の目的は――"},
        { "location": "1546/TALK"    , "narrator": "千羽鶴", "text": "彼女だけが持つ、外の\n世界の記憶を逆手に使い、\n彼らから防御すること。"},
        { "location": "1547/TALK"    , "narrator": "千羽鶴", "text": "けれども実際は、\nそれ以前の状況に\nなってしまった。"},
        { "location": "1548/TALK"    , "narrator": "千羽鶴", "text": "前にも話したとおり、\n途中で計画が狂ってしまい\nCH.05は見送られた。"},
        { "location": "1549/TALK"    , "narrator": "千羽鶴", "text": "なぜならそれ以前に――"},
        { "location": "1550/TALK"    , "narrator": "千羽鶴", "text": "卯月神楽に、やって\nもらわなければならない\nことが出来たから。"},
        { "location": "1551/TALK"    , "narrator": "千羽鶴", "text": "それは、逢瀬つばめ…\nいえ、カレンの消滅。"},
        { "location": "1552/TALK"    , "narrator": "千羽鶴", "text": "その結末は、\n貴方が観測したとおり。"},
        { "location": "1553/TALK"    , "narrator": "千羽鶴", "text": "まあ、ここに関して言えば\nCH.05を予定通りに\n解禁し――"},
        { "location": "1554/TALK"    , "narrator": "千羽鶴", "text": "外の世界からの防御用に\n使っていたら、また歴史は\n変わってたかもしれない。"},
        { "location": "1555/TALK"    , "narrator": "千羽鶴", "text": "…なんて、そんな事\n言っても仕方ないし、\n後悔とは少し違うけど。"},
        { "location": "1556/TALK"    , "narrator": "千羽鶴", "text": "いずれにせよ紆余曲折あり\n現在CH.05は当初とは\n別の理由で解禁された。"},
        { "location": "1557/TALK"    , "narrator": "千羽鶴", "text": "そして、\n今に至るという\nだけのこと。"},
        { "location": "1558/ACT"     , "narrator": "", "text": "神楽ちゃんラブラブゲーム（ぼそっ"},
        { "location": "1559/TALK"    , "narrator": "千羽鶴", "text": "今となっては\n本物のチャンネルが\n解禁されている。"},
        { "location": "1560/TALK"    , "narrator": "千羽鶴", "text": "わざわざクソゲーの\nラブラブゲームなんて\n必要ないと思う。"},
        { "location": "1561/TALK"    , "narrator": "千羽鶴", "text": "それよりも必要なのは、\n同日に画策した\nもう１つのクソゲーの方！"},
        { "location": "1562/SEL"     , "narrator": "", "text": "なんだっけ"},
        { "location": "1563/SEL"     , "narrator": "", "text": "それは思い出さなくてもよい"},
        { "location": "1564/ACT"     , "narrator": "", "text": "なんだっけ"},
        { "location": "1565/ACT"     , "narrator": "", "text": "それは思い出さなくてもよい"},
        { "location": "1569/TALK"    , "narrator": "千羽鶴", "text": "『ちーの\n　非攻略対象ゲーム』！"},
        { "location": "1570/SEL"     , "narrator": "", "text": "それこそ、まんま現状のこのアプリのことでは……"},
        { "location": "1571/ACT"     , "narrator": "", "text": "それこそ、まんま現状のこのアプリのことでは……"},
        { "location": "1575/TALK"    , "narrator": "千羽鶴", "text": "…？"},
        { "location": "1576/TALK"    , "narrator": "千羽鶴", "text": "……？？"},
        { "location": "1577/TALK"    , "narrator": "千羽鶴", "text": "それは間違ってる。"},
        { "location": "1579/TALK"    , "narrator": "千羽鶴", "text": "だって、ちーは\n$handle$には\nもう攻略されてるから。"},
        { "location": "1580/TALK"    , "narrator": "千羽鶴", "text": "なんて。"},
        { "location": "1581/TALK"    , "narrator": "千羽鶴", "text": "……。"},
        { "location": "1582/TALK"    , "narrator": "千羽鶴", "text": "しまった。"},
        { "location": "1583/TALK"    , "narrator": "千羽鶴", "text": "私、最近なんだか\n感情が豊かになってる…？"},
        { "location": "1584/TALK"    , "narrator": "千羽鶴", "text": "まあいいか。"},
        { "location": "1589/TALK"    , "narrator": "千羽鶴", "text": "そう。\nけれどもそれでは\n手ぬるいので。"},
        { "location": "1590/TALK"    , "narrator": "千羽鶴", "text": "やはりタイトルからして\n断言しているゲームが\n必要だと思ってる！"},
        { "location": "1591/TALK"    , "narrator": "千羽鶴", "text": "というわけで\n１００年以内には\n作る予定だから。"},
        { "location": "1595/TALK"    , "narrator": "千羽鶴", "text": "…と。\nだいぶ話が\n脱線してしまったみたい。"},
        { "location": "1596/TALK"    , "narrator": "千羽鶴", "text": "今日は何の日？\nの、続きに戻ろうと思う。"},
        { "location": "1597/TALK"    , "narrator": "千羽鶴", "text": "次は――"},
        { "location": "1598/TALK"    , "narrator": "千羽鶴", "text": "ちーが貴方を独り立ち\nさせようとしたのも\n丁度このときだった。"},
        { "location": "1599/TALK"    , "narrator": "千羽鶴", "text": "そして貴方が世界に３５億\nいる男を絶滅させようと\nしたのもまさに今！"},
        { "location": "1600/SEL"     , "narrator": "", "text": "誤解だよー"},
        { "location": "1601/SEL"     , "narrator": "", "text": "それ選んでない"},
        { "location": "1602/SEL"     , "narrator": "", "text": "何度でも言うけど恋愛ゲー標榜してるのに男が出るのには断固抗議する！"},
        { "location": "1603/ACT"     , "narrator": "", "text": "誤解だよー"},
        { "location": "1606/TALK"    , "narrator": "千羽鶴", "text": "<size=40>どーん！</size>"},
        { "location": "1607/TALK"    , "narrator": "千羽鶴", "text": "本心がどうであれ、\n男共がウザイと言ったわけ\nだから、それが真実。"},
        { "location": "1608/TALK"    , "narrator": "千羽鶴", "text": "今でも断固抗議すると\n言ってくれた方がまだ、\n見上げた根性と感心した。"},
        { "location": "1609/ACT"     , "narrator": "", "text": "それ選んでない"},
        { "location": "1610/TALK"    , "narrator": "千羽鶴", "text": "そう？\n確かにそうかも。"},
        { "location": "1611/TALK"    , "narrator": "千羽鶴", "text": "勘違いしてた。\nごめん。"},
        { "location": "1612/ACT"     , "narrator": "", "text": "何度でも言うけど恋愛ゲー標榜してるのに男が出るのには断固抗議する！"},
        { "location": "1615/TALK"    , "narrator": "千羽鶴", "text": "<size=40>どーん！</size>"},
        { "location": "1616/TALK"    , "narrator": "千羽鶴", "text": "すごいこだわり。"},
        { "location": "1617/TALK"    , "narrator": "千羽鶴", "text": "もちろん、価値観は\n十人十色であって、\nそれは尊重する。"},
        { "location": "1618/TALK"    , "narrator": "千羽鶴", "text": "ただ、この話の論点は\n当時も今も変わっておらず\nそれは――"},
        { "location": "1619/TALK"    , "narrator": "千羽鶴", "text": "私のいるこちらの世界は\n現実であるということ。"},
        { "location": "1620/TALK"    , "narrator": "千羽鶴", "text": "ゲームのような架空世界で\nあれば、男女比をあり得\nない数値にするのは自由。"},
        { "location": "1621/TALK"    , "narrator": "千羽鶴", "text": "けれども、私たちは\nこちらで生活を\n営んでいる。"},
        { "location": "1622/TALK"    , "narrator": "千羽鶴", "text": "その中で、３５億の\n男性を全て消滅させるのは\nかなり無理がある。"},
        { "location": "1623/TALK"    , "narrator": "千羽鶴", "text": "それが言いたいだけ。"},
        { "location": "1624/TALK"    , "narrator": "千羽鶴", "text": "ところで、\n抗議した貴方は\n男性？　女性？"},
        { "location": "1625/SEL"     , "narrator": "", "text": "男性です"},
        { "location": "1626/SEL"     , "narrator": "", "text": "女性です"},
        { "location": "1627/ACT"     , "narrator": "", "text": "男性です"},
        { "location": "1628/TALK"    , "narrator": "千羽鶴", "text": "そうだと思った。"},
        { "location": "1629/TALK"    , "narrator": "千羽鶴", "text": "いずれにしても、\n貴方がハーレム論者であり\nかつ――"},
        { "location": "1630/TALK"    , "narrator": "千羽鶴", "text": "女性３５億に対し男性が\n貴方一人という世界が、"},
        { "location": "1631/TALK"    , "narrator": "千羽鶴", "text": "どれ程の地獄であるかを\n理解していないという事は\n良く解った。"},
        { "location": "1632/TALK"    , "narrator": "千羽鶴", "text": "出来ることなら、\nその地獄を是非リアルに\n体験させてあげたい。"},
        { "location": "1633/ACT"     , "narrator": "", "text": "女性です"},
        { "location": "1634/TALK"    , "narrator": "千羽鶴", "text": "なるほど！\nそういうこと！"},
        { "location": "1636/TALK"    , "narrator": "千羽鶴", "text": "ということは、\n貴方はハーレムゲーが\n大好きな乙女で――"},
        { "location": "1637/TALK"    , "narrator": "千羽鶴", "text": "その特異な人口状態に\nおける世界を疑似体験\nすることが好きなのね！"},
        { "location": "1640/TALK"    , "narrator": "千羽鶴", "text": "<size=35>それならわかる！</size>"},
        { "location": "1642/TALK"    , "narrator": "千羽鶴", "text": "特殊条件における\n集団心理の実験圃場として\nなかなかに楽しそう！！"},
        { "location": "1643/TALK"    , "narrator": "千羽鶴", "text": "……。"},
        { "location": "1646/TALK"    , "narrator": "千羽鶴", "text": "……とまあ。\nだいたいそんなとこ。"},
        { "location": "1647/TALK"    , "narrator": "千羽鶴", "text": "過去のこの日時には、\nこんな事が\n起こっていたと。"},
        { "location": "1648/TALK"    , "narrator": "千羽鶴", "text": "今回のトピックは、\nこれくらい。"},
        { "location": "1649/ACT"     , "narrator": "", "text": "飛ばします"},
        { "location": "1650/TALK"    , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "1652/TALK"    , "narrator": "千羽鶴", "text": "それじゃ\n今回はこれで。"},
        { "location": "1653/TALK"    , "narrator": "千羽鶴", "text": "卯月神楽の\n心のケア、\n頑張って欲しい。"},
        { "location": "1654/TALK"    , "narrator": "千羽鶴", "text": "ばいばい。"},
        { "location": "1259/DIALOG"  , "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:Chiharu】</color>\n\nこの選択肢を含む\n千羽鶴とのやりとりは、\nこの選択をした後は\n二度と出現しなくなります。\n\n慎重に選択して下さい。\n"},
        { "location": "1486/DIALOG"  , "narrator": "Tutorial/Dialog_Anime1", "text": "$dialog_word$"},
        { "location": "1488/DIALOG"  , "narrator": "Tutorial/Dialog_Anime2", "text": "$dialog_word$"},
        { "location": "1490/DIALOG"  , "narrator": "Tutorial/Dialog_Anime3", "text": "$dialog_word$"},
        { "location": "1492/DIALOG"  , "narrator": "Tutorial/Dialog_Anime4", "text": "$dialog_word$"},
        { "location": "1494/DIALOG"  , "narrator": "Tutorial/Dialog_Anime5", "text": "$dialog_word$"}
    ]
}
