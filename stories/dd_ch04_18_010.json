{
    "dir": "chap18/daydra/dd_ch04_18_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "18452",
        "cid": "miyabi",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "日焼け対策"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "日焼け対策"},
        { "location": "22/TALK"   , "narrator": "つばめ", "text": "わぁ、こっちのなんて\nどうかな？\n花柄で可愛いよ。"},
        { "location": "26/TALK"   , "narrator": "ガブリエラ", "text": "花柄って…それだと\nおばさん臭いわ。"},
        { "location": "29/TALK"   , "narrator": "ガブリエラ", "text": "こっちのはどう？\n生地がレースで、\n模様も素敵だし。"},
        { "location": "32/TALK"   , "narrator": "つばめ", "text": "でも、模様の部分が\n穴になってるから、\n日に当たっちゃうよ？"},
        { "location": "35/TALK"   , "narrator": "ガブリエラ", "text": "これくらいなら平気よ。\nそれに、空気が通るから\n涼しいし。"},
        { "location": "38/TALK"   , "narrator": "つばめ", "text": "う～ん…色々あって\n悩むよぉ…。"},
        { "location": "40/TALK"   , "narrator": "みやび", "text": "…折り畳みのがえいと\n思うんよ。\n持ち運びラクやし。"},
        { "location": "42/TALK"   , "narrator": "つばめ", "text": "みやびさんは折り畳みのが\n好きなんですか？"},
        { "location": "43/TALK"   , "narrator": "みやび", "text": "いや、うちに日傘は\n必要ないがよ。"},
        { "location": "45/TALK"   , "narrator": "ガブリエラ", "text": "みやびこそ使わなきゃ\nダメでしょ？"},
        { "location": "46/TALK"   , "narrator": "つばめ", "text": "そうですよ。\nせっかくの白い肌が、\n焼けちゃいますよ？"},
        { "location": "48/TALK"   , "narrator": "みやび", "text": "夏休みはエアコンの効いた\n部屋で、楽しい楽しい\nヒッキー生活するき――"},
        { "location": "49/TALK"   , "narrator": "みやび", "text": "日焼けなんぞ無縁や。"},
        { "location": "50/TALK"   , "narrator": "ガブリエラ", "text": "せっかくの夏休みを\n無駄にするつもり？"},
        { "location": "51/TALK"   , "narrator": "みやび", "text": "うちにとっては\n十分充実しているんや\nけんどね。"},
        { "location": "53/TALK"   , "narrator": "ガブリエラ", "text": "ま、まあ、あんたが\nアウトドアを楽しむ姿、\n想像できないけど…。"},
        { "location": "54/TALK"   , "narrator": "つばめ", "text": "でも、持ってれば\n絶対に役立ちますよ？"},
        { "location": "55/SEL"    , "narrator": "", "text": "すぐなくしそう"},
        { "location": "56/SEL"    , "narrator": "", "text": "持ち歩き面倒くさそう"},
        { "location": "60/TALK"   , "narrator": "みやび", "text": "うーん…けどなぁ…。"},
        { "location": "61/TALK"   , "narrator": "つばめ", "text": "夏休みでも、バイトは\nあるんですから――"},
        { "location": "62/TALK"   , "narrator": "つばめ", "text": "劇場までの道で\n使ったりもできますし。"},
        { "location": "64/TALK"   , "narrator": "みやび", "text": "そんな何十分も離れちょる\nわけでもないやろ？"},
        { "location": "66/TALK"   , "narrator": "ガブリエラ", "text": "短時間でもあると無いじゃ\n全然違うのよ。"},
        { "location": "68/TALK"   , "narrator": "みやび", "text": "ん～…。"},
        { "location": "72/TALK"   , "narrator": "みやび", "text": "仮に買うたとして、\nうちが晴れちゅう日に――"},
        { "location": "73/TALK"   , "narrator": "みやび", "text": "わざわざ傘をさすとは\n思えんのやけんど…。"},
        { "location": "75/TALK"   , "narrator": "ガブリエラ", "text": "…みやびの性格を\n考えると、ありえるわね。"},
        { "location": "77/TALK"   , "narrator": "つばめ", "text": "ドアの前に置いておけば、\n部屋を出る時に目に付くと\n思うから…。"},
        { "location": "78/TALK"   , "narrator": "みやび", "text": "目に付いた傘を、\n晴れの日にうちが\n持ち出すと思うんか？"},
        { "location": "81/TALK"   , "narrator": "つばめ", "text": "…………。"},
        { "location": "83/TALK"   , "narrator": "ガブリエラ", "text": "玄関で埃をかぶって\nおしまいになりそうね。"},
        { "location": "84/TALK"   , "narrator": "みやび", "text": "うちもそう思うんよ。"},
        { "location": "85/TALK"   , "narrator": "みやび", "text": "まあ、バイトの時は\n誰かしら一緒なのは\n間違いないき――"},
        { "location": "86/TALK"   , "narrator": "みやび", "text": "どうしても耐えられん\nかったら、誰かと相合傘\nするからえいよ。"},
        { "location": "87/TALK"   , "narrator": "ガブリエラ", "text": "日傘で相合傘とか、\n考えるだけでも\n暑苦しいわ。"},
        { "location": "90/TALK"   , "narrator": "つばめ", "text": "でも、そっちの方が\nみやびさんっぽい\n感じはしますね。"},
        { "location": "92/ACT"    , "narrator": "", "text": "すぐなくしそう"},
        { "location": "111/TALK"  , "narrator": "みやび", "text": "うん、うちも絶対失くす思うんよ"},
        { "location": "112/TALK"  , "narrator": "みやび", "text": "相棒もそう言うんやから、間違いないな"},
        { "location": "124/TALK"  , "narrator": "みやび", "text": "多分間違いなくやけんど、\n日傘持って電車になんぞ\n乗ったら――"},
        { "location": "125/TALK"  , "narrator": "みやび", "text": "降りる時、確実に日傘を\n忘れてくる思うちや。"},
        { "location": "127/TALK"  , "narrator": "つばめ", "text": "あ～…なんかそれ、\n凄くありそうです…。"},
        { "location": "129/TALK"  , "narrator": "ガブリエラ", "text": "普段使ってる人でも、\n時々電車の中に忘れる\n人がいるんだから――"},
        { "location": "131/TALK"  , "narrator": "ガブリエラ", "text": "みやびだったら、\n確実に電車に忘れて\n失くしそうよね。"},
        { "location": "132/ACT"   , "narrator": "", "text": "持ち歩き面倒くさそう"},
        { "location": "151/TALK"  , "narrator": "みやび", "text": "それな"},
        { "location": "152/TALK"  , "narrator": "みやび", "text": "まっこと、心の底から同意ちや"},
        { "location": "164/TALK"  , "narrator": "みやび", "text": "雨でもないのに片手\n塞がるん、うちには\n我慢できんちや。"},
        { "location": "165/TALK"  , "narrator": "みやび", "text": "買い物帰りに両腕が\n使えんのは、かなり\nストレス溜まる思うんよ。"},
        { "location": "167/TALK"  , "narrator": "つばめ", "text": "そ、それはまあ、\n確かに不便では\nありますけど…。"},
        { "location": "169/TALK"  , "narrator": "ガブリエラ", "text": "けど、直射日光を\n遮れるんだから――"},
        { "location": "170/TALK"  , "narrator": "ガブリエラ", "text": "それくらい\n我慢しなさいよ。"},
        { "location": "172/TALK"  , "narrator": "みやび", "text": "絶対片手塞がった方が\n汗かくと思うき、\n無理な話や。"},
        { "location": "176/TALK"  , "narrator": "みやび", "text": "まあ、うちに日傘は\n合わんいうことやね。"},
        { "location": "179/TALK"  , "narrator": "ガブリエラ", "text": "はぁ…まあ、気にいる\n可能性は低いと思って\nたけどね。"},
        { "location": "180/TALK"  , "narrator": "ガブリエラ", "text": "女子力めっちゃ低いし。"},
        { "location": "182/TALK"  , "narrator": "つばめ", "text": "見た目は、すっごく\n高そうに見えるのに…。"},
        { "location": "184/TALK"  , "narrator": "みやび", "text": "…さすがのうちもな、\n面と向かって言われると\n寂しい気持ちになるがよ？"},
        { "location": "187/TALK"  , "narrator": "ガブリエラ", "text": "なら日傘くらいで\n文句言わないでよ…。"},
        { "location": "188/TALK"  , "narrator": "ガブリエラ", "text": "っていうか、この機会に\n日傘に合った服とかも、\n一通り買ってみたら？"},
        { "location": "189/TALK"  , "narrator": "つばめ", "text": "いいね、それ！"},
        { "location": "190/TALK"  , "narrator": "つばめ", "text": "みやびさんなら、\nシンプルな感じの服が\n似合いそうだよね？"},
        { "location": "192/TALK"  , "narrator": "ガブリエラ", "text": "そうね。ワンピースと\nサンダルとか、似合うと\n思わない？"},
        { "location": "193/TALK"  , "narrator": "つばめ", "text": "素敵だよ！\n絶対似合うと思うなぁ。"},
        { "location": "196/TALK"  , "narrator": "みやび", "text": "わ、ワンピース！？\nそんなの無理や！"},
        { "location": "197/TALK"  , "narrator": "ガブリエラ", "text": "あら、照れてるの？\n珍しいこともあるのね。"},
        { "location": "198/TALK"  , "narrator": "つばめ", "text": "大丈夫ですよ。\n絶対似合いますから！"},
        { "location": "202/TALK"  , "narrator": "みやび", "text": "そうやなくて…。"},
        { "location": "204/TALK"  , "narrator": "みやび", "text": "ワンピースみたいな\n生地の薄いヒラヒラして\n露出の激しい服は――"},
        { "location": "205/TALK"  , "narrator": "みやび", "text": "うちには過激過ぎて、\nとてもやないけんど\n着る気になれんちや…。"},
        { "location": "206/TALK"  , "narrator": "ガブリエラ", "text": "過激とか言わないでよ！\nあたし達まで意識しちゃう\nじゃない！"},
        { "location": "209/TALK"  , "narrator": "つばめ", "text": "か、過激じゃないよね？\nワンピースは過激じゃ\nないよね？"},
        { "location": "211/TALK"  , "narrator": "ガブリエラ", "text": "物にもよるけど、\nつばめが持ってるのは\n過激のかの字もないわよ。"},
        { "location": "215/TALK"  , "narrator": "つばめ", "text": "ほ、本当に？\nほっ…良かったぁ…。"},
        { "location": "217/TALK"  , "narrator": "みやび", "text": "…それ、ショック受ける\nところやないんか？"},
        { "location": "19/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>7月7日　4:15 PM</color>\nとある平日の午後、都内某所ブティックにて。"}
    ]
}
