        { "location": "691/SCENARIO", "narrator": "", "text": "人を見るひと"},
        { "location": "716/TALK"    , "narrator": "神楽", "text": "トライナリーのみんなと顔合わせしたらどうなることかって心配していましたけど～"},
        { "location": "717/TALK"    , "narrator": "神楽", "text": "ぴょんこはなんとかなりました"},
        { "location": "718/TALK"    , "narrator": "神楽", "text": "それ以上に$handle$さんってば人間だってこと結構あっさり受け入れられてますよね？"},
        { "location": "719/TALK"    , "narrator": "神楽", "text": "ぴょんこが心配することなかったみたいでよかったですっ♪"},
        { "location": "721/SEL"     , "narrator": "", "text": "そんなことないよ"},
        { "location": "722/SEL"     , "narrator": "", "text": "神楽だけが$me$の支え"},
        { "location": "723/SEL"     , "narrator": "", "text": "$me$はトライナリー全員の信頼を得ているから"},
        { "location": "724/ACT"     , "narrator": "", "text": "そんなことないよ"},
        { "location": "731/TALK"    , "narrator": "神楽", "text": "またまたー"},
        { "location": "733/TALK"    , "narrator": "神楽", "text": "つばめさんのあの反応"},
        { "location": "734/TALK"    , "narrator": "神楽", "text": "らーぶ　らーぶ　ですよ？"},
        { "location": "735/ACT"     , "narrator": "", "text": "神楽だけが$me$の支え"},
        { "location": "742/TALK"    , "narrator": "神楽", "text": "本当に？？？"},
        { "location": "743/TALK"    , "narrator": "神楽", "text": "ふっふーん？？？"},
        { "location": "744/TALK"    , "narrator": "神楽", "text": "信じてあげてもいいですよ♪"},
        { "location": "745/ACT"     , "narrator": "", "text": "$me$はトライナリー全員の信頼を得ているから"},
        { "location": "753/TALK"    , "narrator": "神楽", "text": "そっかそっか"},
        { "location": "754/TALK"    , "narrator": "神楽", "text": "だったら全然問題なしですねっ★"},
        { "location": "760/TALK"    , "narrator": "神楽", "text": "こういうのなんて言うんでしょ～～～？"},
        { "location": "761/TALK"    , "narrator": "神楽", "text": "メシウマ？"},
        { "location": "763/SEL"     , "narrator": "", "text": "実は怒ってる？"},
        { "location": "764/SEL"     , "narrator": "", "text": "それは「他人の不幸でメシがうまい」の略であって"},
        { "location": "765/SEL"     , "narrator": "", "text": "神楽だけが$me$の安らぎなんだよ？"},
        { "location": "766/ACT"     , "narrator": "", "text": "実は怒ってる？"},
        { "location": "767/TALK"    , "narrator": "神楽", "text": "そんなことないですよ？"},
        { "location": "768/ACT"     , "narrator": "", "text": "それは「他人の不幸でメシがうまい」の略であって"},
        { "location": "769/TALK"    , "narrator": "神楽", "text": "あれそうでしたっけ"},
        { "location": "771/TALK"    , "narrator": "神楽", "text": "ぴょんこ失敗しちゃいました♪"},
        { "location": "772/ACT"     , "narrator": "", "text": "神楽だけが$me$の安らぎなんだよ？"},
        { "location": "773/TALK"    , "narrator": "神楽", "text": "そうなんですか？？？"},
        { "location": "774/TALK"    , "narrator": "神楽", "text": "本当にそうだといいなっ♪"},
        { "location": "777/SEL"     , "narrator": "", "text": "つばめ以外からは塩対応されてるし"},
        { "location": "778/SEL"     , "narrator": "", "text": "神楽しかちゃんと話せないし"},
        { "location": "779/SEL"     , "narrator": "", "text": "色々大変なんだって"},
        { "location": "780/ACT"     , "narrator": "", "text": "つばめ以外からは塩対応されてるし"},
        { "location": "781/TALK"    , "narrator": "神楽", "text": "そんなことないですよね"},
        { "location": "782/TALK"    , "narrator": "神楽", "text": "だって$handle$さんですもん♪"},
        { "location": "783/ACT"     , "narrator": "", "text": "神楽しかちゃんと話せないし"},
        { "location": "784/TALK"    , "narrator": "神楽", "text": "またまたそんなことばっかり♪"},
        { "location": "785/TALK"    , "narrator": "神楽", "text": "そんなわけないですしおすし"},
        { "location": "786/ACT"     , "narrator": "", "text": "色々大変なんだって"},
        { "location": "787/TALK"    , "narrator": "神楽", "text": "そうなんですか？"},
        { "location": "788/TALK"    , "narrator": "神楽", "text": "本当は状況を楽しんでたりしません？"},
        { "location": "790/TALK"    , "narrator": "神楽", "text": "こう見えてもぴょんこさんは$handle$さんのことを心配していたのですよ？"},
        { "location": "792/SEL"     , "narrator": "", "text": "知ってる"},
        { "location": "793/SEL"     , "narrator": "", "text": "ありがとう"},
        { "location": "794/SEL"     , "narrator": "", "text": "それって本当？"},
        { "location": "795/ACT"     , "narrator": "", "text": "知ってる"},
        { "location": "796/TALK"    , "narrator": "神楽", "text": "知っててくれてたぴょん？"},
        { "location": "797/ACT"     , "narrator": "", "text": "ありがとう"},
        { "location": "798/TALK"    , "narrator": "神楽", "text": "どういたしまして♪"},
        { "location": "799/ACT"     , "narrator": "", "text": "それって本当？"},
        { "location": "800/TALK"    , "narrator": "神楽", "text": "本当なのに、、、"},
        { "location": "802/TALK"    , "narrator": "神楽", "text": "さみしい、、、ｼｮﾎﾞｰﾝ、、、"},
        { "location": "805/SEL"     , "narrator": "", "text": "やきもち妬いてくれてる？"},
        { "location": "806/SEL"     , "narrator": "", "text": "神楽が一番話しやすいよ"},
        { "location": "807/SEL"     , "narrator": "", "text": "他の子は本当はどうでもいいんだ"},
        { "location": "808/ACT"     , "narrator": "", "text": "やきもち妬いてくれてる？"},
        { "location": "810/TALK"    , "narrator": "神楽", "text": "違いますけど"},
        { "location": "811/TALK"    , "narrator": "神楽", "text": "でもそう思っていただいてもいいですよっ♪"},
        { "location": "812/ACT"     , "narrator": "", "text": "神楽が一番話しやすいよ"},
        { "location": "813/TALK"    , "narrator": "神楽", "text": "一番ってことは二番以降もいるってことぴょん"},
        { "location": "814/TALK"    , "narrator": "神楽", "text": "なんて言うとちょっとヤンデレっぽいかもですね★"},
        { "location": "815/ACT"     , "narrator": "", "text": "他の子は本当はどうでもいいんだ"},
        { "location": "816/TALK"    , "narrator": "神楽", "text": "ナビちゃんがそんなこと言っちゃいけないと思いますっ♪"},
        { "location": "818/TALK"    , "narrator": "神楽", "text": "職務怠慢だ、ぞ？"},
        { "location": "822/TALK"    , "narrator": "ボイスメール", "text": "心配ゼロでおめでとう"},
