{
    "dir": "chap06/daydra/dd_ch03_06_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "6302",
        "cid": "gabriella",
        "title": "002 メインストーリー",
        "sub_title": "出陣【Case：ガブリエラ】＜前編＞"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "出陣【ギャヴィから見たCase】"},
        { "location": "48/TALK"   , "narrator": "アーヤ", "text": "逢瀬さん？"},
        { "location": "50/TALK"   , "narrator": "つばめ", "text": "は、はいっ！？"},
        { "location": "51/TALK"   , "narrator": "アーヤ", "text": "そんなに緊張しないでも\n平気よ。"},
        { "location": "53/TALK"   , "narrator": "つばめ", "text": "す、すみません…。\nわたし、こういうのって\n初めてで…。"},
        { "location": "59/TALK"   , "narrator": "ガブリエラ", "text": "ドームで経験してる\nじゃない。"},
        { "location": "61/TALK"   , "narrator": "つばめ", "text": "そうだけど、あの時は\nこんなに暗いところじゃ\nなかったし…。"},
        { "location": "64/TALK"   , "narrator": "ガブリエラ", "text": "…何でそんなことも\n知らないのよ、この子？"},
        { "location": "65/TALK"   , "narrator": "ガブリエラ", "text": "まさかまほ、事前に何も\n教えなかったわけ？"},
        { "location": "68/TALK"   , "narrator": "つばめ", "text": "――えぇっ！？\nそ、それじゃわたし達も\n危ないじゃないですか！"},
        { "location": "71/TALK"   , "narrator": "ガブリエラ", "text": "はぁ…ねえ、アーヤ。\nやっぱあたし達だけで\n行った方が良くない？"},
        { "location": "72/TALK"   , "narrator": "ガブリエラ", "text": "何もわかってない子を\n連れてったって、\n足手まといになるだけよ。"},
        { "location": "74/TALK"   , "narrator": "アーヤ", "text": "ちょっと、ギャヴィ。\nそういう言い方は…。"},
        { "location": "77/TALK"   , "narrator": "ガブリエラ", "text": "事実を言ったまでよ。"},
        { "location": "79/TALK"   , "narrator": "つばめ", "text": "い、いいんです。\n勉強不足なわたしが\n悪いんだし…。"},
        { "location": "81/TALK"   , "narrator": "つばめ", "text": "ごめんね、えと…\nガブリエラちゃん。"},
        { "location": "84/TALK"   , "narrator": "ガブリエラ", "text": "あんたは\n“ちゃん”付け禁止。"},
        { "location": "87/TALK"   , "narrator": "ガブリエラ", "text": "冗談じゃない。何が\nガブリエラちゃんよ！？"},
        { "location": "88/TALK"   , "narrator": "ガブリエラ", "text": "そんな風に呼ばれるほど、\n親しくもないのに。"},
        { "location": "89/TALK"   , "narrator": "ガブリエラ", "text": "それに、アーヤも\n新人のこと庇い過ぎよ。"},
        { "location": "90/TALK"   , "narrator": "ガブリエラ", "text": "あたしだって、\nイジワルで言ってる\nわけじゃないんだから。"},
        { "location": "93/TALK"   , "narrator": "つばめ", "text": "あ、あの、その…。"},
        { "location": "94/TALK"   , "narrator": "つばめ", "text": "大丈夫ですよね？\nだって、皆さんとっても\n強いし…。"},
        { "location": "95/TALK"   , "narrator": "アーヤ", "text": "…だといいけど。"},
        { "location": "98/TALK"   , "narrator": "ガブリエラ", "text": "…っていうか、あんたが\n言うな、って話よね。"},
        { "location": "100/TALK"  , "narrator": "つばめ", "text": "え？"},
        { "location": "101/TALK"  , "narrator": "ガブリエラ", "text": "フェノメノンの中で、\n生身で発症者と戦って――"},
        { "location": "102/TALK"  , "narrator": "ガブリエラ", "text": "素手でクランを引き剥がす\nなんて芸当、あたし達でも\nできないわ。"},
        { "location": "103/TALK"  , "narrator": "ガブリエラ", "text": "そんなあんたに、\n強いとか言われてもね。"},
        { "location": "104/TALK"  , "narrator": "アーヤ", "text": "ギャヴィ、そういう言い方\nしないの。"},
        { "location": "105/TALK"  , "narrator": "ガブリエラ", "text": "だって本当のことじゃん。"},
        { "location": "108/TALK"  , "narrator": "アーヤ", "text": "ごめんね、逢瀬さん。\nギャヴィの言ったことは\n気にしないで。"},
        { "location": "114/TALK"  , "narrator": "ガブリエラ", "text": "…やっぱり、新人のこと\nばかり庇ってる。"},
        { "location": "116/TALK"  , "narrator": "ガブリエラ", "text": "アーヤ…あたしのこと、\n嫌いになっちゃったの…？"},
        { "location": "117/TALK"  , "narrator": "ガブリエラ", "text": "…ううん、違うわ。"},
        { "location": "118/TALK"  , "narrator": "ガブリエラ", "text": "逆よ！\n嫌ってるのはあたしの方\nなんだから！"},
        { "location": "119/TALK"  , "narrator": "ガブリエラ", "text": "あたしの好きだった、\n剣道大会で見たアーヤは、\nもういないのよ。"},
        { "location": "120/TALK"  , "narrator": "ガブリエラ", "text": "家が大事だからとかいう\n理由で、剣道を辞めた\n今のあいつは――"},
        { "location": "121/TALK"  , "narrator": "ガブリエラ", "text": "あたしの好きだった\nアーヤの、抜け殻なん\nだから！"},
        { "location": "150/TALK"  , "narrator": "つばめ", "text": "あの、せんぱい。"},
        { "location": "152/TALK"  , "narrator": "ガブリエラ", "text": "…何よ？"},
        { "location": "153/TALK"  , "narrator": "つばめ", "text": "え、えっと…。"},
        { "location": "154/TALK"  , "narrator": "つばめ", "text": "…よかったら、\nわたしと手を繋いで\nもらえませんか？"},
        { "location": "155/TALK"  , "narrator": "ガブリエラ", "text": "っ！？"},
        { "location": "158/TALK"  , "narrator": "ガブリエラ", "text": "は？　いや、何？\n急に何言い出すの？"},
        { "location": "160/TALK"  , "narrator": "つばめ", "text": "だ、だって、こんな\n不気味なところ\n歩いてると――"},
        { "location": "161/TALK"  , "narrator": "つばめ", "text": "何か不安な気持ちに\nなってくるじゃない\nですか。"},
        { "location": "162/TALK"  , "narrator": "つばめ", "text": "だから、よかったら\n手を握ってもらえたら\n嬉しいなぁ、って…。"},
        { "location": "163/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "164/TALK"  , "narrator": "ガブリエラ", "text": "…何やってんだろ、\nあたし。"},
        { "location": "165/TALK"  , "narrator": "ガブリエラ", "text": "新人の方から、\nこんなに近寄ろうと\nしてくれてるのに――"},
        { "location": "166/TALK"  , "narrator": "ガブリエラ", "text": "変に意地張って、\n酷い態度ばかり\n取って…。"},
        { "location": "167/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "168/TALK"  , "narrator": "ガブリエラ", "text": "…この子だって、\nきっと不安なのよね。"},
        { "location": "169/TALK"  , "narrator": "ガブリエラ", "text": "…この手を握れば、\n仲直りできる…かな？"},
        { "location": "215/TALK"  , "narrator": "ガブリエラ", "text": "また来てくれたのね！\nようこそ[ココロゲート]へ！"},
        { "location": "216/TALK"  , "narrator": "ガブリエラ", "text": "それじゃ今回も\n扉を回すわね♪"},
        { "location": "223/TALK"  , "narrator": "ガブリエラ", "text": "オープンプロセス、\n0x773番地から\n0xCEF番地へ。"},
        { "location": "238/TALK"  , "narrator": "ガブリエラ", "text": "シーク完了っ♪"},
        { "location": "240/TALK"  , "narrator": "ガブリエラ", "text": "でも今回は、\n何を迷ってるかなんて\n既に知ってるのよね～♪"},
        { "location": "241/TALK"  , "narrator": "ガブリエラ", "text": "つばめと手を繋ぐか\nどうしよっか\n迷ってるのよ、あたし！"},
        { "location": "242/SEL"   , "narrator": "", "text": "どうしてそんな乗り気なの？"},
        { "location": "243/ACT"   , "narrator": "", "text": "どうしてそんな乗り気なの？"},
        { "location": "245/TALK"  , "narrator": "ガブリエラ", "text": "だってあたし、\n意地っ張り過ぎ\nなんだもん。"},
        { "location": "246/TALK"  , "narrator": "ガブリエラ", "text": "[ココロゲート]から\n日々自分を見守っていて、\nイライラするのよね。"},
        { "location": "247/TALK"  , "narrator": "ガブリエラ", "text": "でもここで手を繋ぐ事が\nできたら、きっと関係が\nステップアップするわ！"},
        { "location": "248/TALK"  , "narrator": "ガブリエラ", "text": "きっと数少ない\n素敵なお友達になれると\nおもうのよ♪"},
        { "location": "249/SEL"   , "narrator": "", "text": "じゃあ、その期待に添いましょうか"},
        { "location": "250/ACT"   , "narrator": "", "text": "じゃあ、その期待に添いましょうか"},
        { "location": "252/TALK"  , "narrator": "ガブリエラ", "text": "ホント！？\nありがとう♪"},
        { "location": "253/TALK"  , "narrator": "ガブリエラ", "text": "それじゃ、手を繋ぎたい\n気持ちを阻むクランを\nやっつけちゃってくれる？"},
        { "location": "255/TALK"  , "narrator": "ガブリエラ", "text": "あたしと\n$handle$にとって\n素敵なココロの旅を！"},
        { "location": "45/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>5月9日　1:45 PM</color>\nWAVE戦フェノメノン内部へ向かう途中、不確定量子の繭の中にて。"},
        { "location": "181/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"}
    ]
}
