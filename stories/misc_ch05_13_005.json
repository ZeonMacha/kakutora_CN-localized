        { "location": "4191/TALK"    , "narrator": "神楽", "text": "顔見知りのありがたさはもちろんあるんだけどさ"},
        { "location": "4192/TALK"    , "narrator": "神楽", "text": "ちょっと退屈に思ったりもするわけ"},
