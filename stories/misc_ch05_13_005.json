        { "location": "4143/SEL"     , "narrator": "", "text": "その中には$me$もいるよね？"},
        { "location": "4144/ACT"     , "narrator": "", "text": "廃人だからじゃない？"},
        { "location": "4145/TALK"    , "narrator": "神楽", "text": "それだ！！！"},
        { "location": "4146/ACT"     , "narrator": "", "text": "ネトゲとかやってんのｗｗｗ"},
        { "location": "4147/TALK"    , "narrator": "神楽", "text": "わからんやつとは話さないから"},
