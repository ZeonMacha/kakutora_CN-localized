        { "location": "4114/SCENARIO", "narrator": "", "text": "いつもの面子のパーティーで"},
        { "location": "4139/TALK"    , "narrator": "神楽", "text": "ネトゲをある程度続けると深夜のファミレスみたいになんとなく常連と顔見知りになってしまう件"},
        { "location": "4141/SEL"     , "narrator": "", "text": "廃人だからじゃない？"},
