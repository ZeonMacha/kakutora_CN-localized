{
    "dir": "chap39/daydra/dd_ch04_39_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "39402",
        "cid": "miyabi",
        "title": "002 メインストーリー",
        "sub_title": "遙かなる世界の空に＜前編＞"
    },
    "entry":
    [
        { "location": "40/TALK"   , "narrator": "みやび", "text": "ほいて、これを\nこう繋げて…。"},
        { "location": "41/TALK"   , "narrator": "みやび", "text": "………。"},
        { "location": "43/TALK"   , "narrator": "繭", "text": "あ。\n見えましたよ！"},
        { "location": "45/TALK"   , "narrator": "みやび", "text": "さすがはうち。\nそしてウサギ。"},
        { "location": "46/TALK"   , "narrator": "みやび", "text": "異世界間通信プログラムを\n作成できるとは。"},
        { "location": "47/TALK"   , "narrator": "繭", "text": "エリカさんの事例が\nいいヒントに\nなりましたね。"},
        { "location": "48/TALK"   , "narrator": "みやび", "text": "…そうやね。"},
        { "location": "49/TALK"   , "narrator": "みやび", "text": "本当はエリカさんと\n通信できればという\n気持ちもあったけんど。"},
        { "location": "50/TALK"   , "narrator": "みやび", "text": "そっちは時期尚早\nみたいやきね…。"},
        { "location": "51/TALK"   , "narrator": "繭", "text": "ＩＰの仕様はこちらと\nあまり変わらない\nみたいなのも幸いですね。"},
        { "location": "52/TALK"   , "narrator": "みやび", "text": "人間の考えることは\nそう変わらん\nちうことかねえ。"},
        { "location": "53/TALK"   , "narrator": "みやび", "text": "安心したような、\nつまらんような。"},
        { "location": "55/TALK"   , "narrator": "繭", "text": "またまた。\nこれから先の方が\n大変じゃないですか。"},
        { "location": "56/TALK"   , "narrator": "みやび", "text": "確かにそうやけんど…。"},
        { "location": "57/TALK"   , "narrator": "みやび", "text": "ふーん。あっちでは\nTwitterいうのが\n流行しとるらしい。"},
        { "location": "58/TALK"   , "narrator": "みやび", "text": "ああ……これは\n使えそうぞね。"},
        { "location": "59/TALK"   , "narrator": "みやび", "text": "ほいたらスマホ版を\nダウンロードして…。"},
        { "location": "60/SEL"    , "narrator": "", "text": "Twitter！？"},
        { "location": "71/TALK"   , "narrator": "みやび", "text": "どうした相棒よ"},
        { "location": "72/SEL"    , "narrator": "", "text": "$me$をフォローして！"},
        { "location": "73/SEL"    , "narrator": "", "text": "アカウント作るの？"},
        { "location": "74/SEL"    , "narrator": "", "text": "えっと、今から始めるの？"},
        { "location": "75/ACT"    , "narrator": "", "text": "$me$をフォローして！"},
        { "location": "76/TALK"   , "narrator": "みやび", "text": "フォローとはなんぞ"},
        { "location": "78/TALK"   , "narrator": "みやび", "text": "自分で調べるか"},
        { "location": "79/ACT"    , "narrator": "", "text": "アカウント作るの？"},
        { "location": "80/TALK"   , "narrator": "みやび", "text": "それ以外にどんな利用法が？"},
        { "location": "81/ACT"    , "narrator": "", "text": "えっと、今から始めるの？"},
        { "location": "82/TALK"   , "narrator": "みやび", "text": "今までは存在すら知らんかったきね"},
        { "location": "90/TALK"   , "narrator": "みやび", "text": "相棒の世界には\nTwitterがある\nいうことか…。"},
        { "location": "91/TALK"   , "narrator": "みやび", "text": "ほいたら、\nもしかしたら…。"},
        { "location": "92/TALK"   , "narrator": "みやび", "text": "……うーん。"},
        { "location": "93/TALK"   , "narrator": "みやび", "text": "インストールすれば\nすっと動くかと\n思うちょったけど。"},
        { "location": "94/TALK"   , "narrator": "みやび", "text": "ちっくと改ざんが\n必要そうぞね。"},
        { "location": "95/TALK"   , "narrator": "繭", "text": "どんな構成に\nなっていますか？"},
        { "location": "96/TALK"   , "narrator": "繭", "text": "こちらで解析する\n部分をください。"},
        { "location": "98/TALK"   , "narrator": "みやび", "text": "ありがとう。\nほいたら…。"},
        { "location": "104/TALK"  , "narrator": "みやび", "text": "よしよし。\nさすがウサギ。\n完璧ぞね。"},
        { "location": "105/TALK"  , "narrator": "繭", "text": "…いえ、\nそんなことは。"},
        { "location": "106/TALK"  , "narrator": "みやび", "text": "アカウント登録も\n無事にできたし。"},
        { "location": "107/TALK"  , "narrator": "みやび", "text": "これでうちらが外世界を\n侵略する第一歩が整った\nちうことやね。"},
        { "location": "108/TALK"  , "narrator": "繭", "text": "先輩。"},
        { "location": "109/TALK"  , "narrator": "繭", "text": "異世界間通信プログラムの\n目的は忘れないで\nくださいね。"},
        { "location": "110/TALK"  , "narrator": "繭", "text": "私たちに必要な情報を\n取得するのが\n最優先事項です。"},
        { "location": "111/TALK"  , "narrator": "繭", "text": "エンタングルと\n多国籍企業群そして\n“彼ら”について。"},
        { "location": "112/TALK"  , "narrator": "繭", "text": "その情報を得るため\n異世界間プロクシーを\n開通させたんです。"},
        { "location": "113/TALK"  , "narrator": "みやび", "text": "当然！　うちやって\nわかっちょるき。"},
        { "location": "114/TALK"  , "narrator": "みやび", "text": "それよりウサギは\nアカウント登録をまだ\nしてないようやけんど。"},
        { "location": "115/TALK"  , "narrator": "繭", "text": "私は今は\nやめておきます。"},
        { "location": "116/TALK"  , "narrator": "みやび", "text": "何でまた？"},
        { "location": "117/TALK"  , "narrator": "繭", "text": "私は切り札になります。\nみやび先輩に万が一が\nあった時のために。"},
        { "location": "118/TALK"  , "narrator": "繭", "text": "だから今は存在を\n隠しておきます。"},
        { "location": "119/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "120/TALK"  , "narrator": "繭", "text": "もちろん\n杞憂で終わるとは\n思っていますが…。"},
        { "location": "121/TALK"  , "narrator": "みやび", "text": "いや。\nさすがやねウサギ。"},
        { "location": "122/TALK"  , "narrator": "みやび", "text": "それでこそ\nRabbitAnima。"},
        { "location": "124/TALK"  , "narrator": "みやび", "text": "冷静沈着かつ\n用意周到な\nおっさん属性ハッカー。"},
        { "location": "125/SEL"   , "narrator": "", "text": "ほめてないよ！？"},
        { "location": "126/SEL"   , "narrator": "", "text": "ちょっと妬けるなあ"},
        { "location": "127/SEL"   , "narrator": "", "text": "$me$も誉めて！！！"},
        { "location": "128/ACT"   , "narrator": "", "text": "ほめてないよ！？"},
        { "location": "136/TALK"  , "narrator": "みやび", "text": "最上級の褒め言葉だ"},
        { "location": "137/TALK"  , "narrator": "みやび", "text": "ばかちんめ"},
        { "location": "138/ACT"   , "narrator": "", "text": "ちょっと妬けるなあ"},
        { "location": "146/TALK"  , "narrator": "みやび", "text": "$handle$はひょっとして"},
        { "location": "147/TALK"  , "narrator": "みやび", "text": "おっさんと言われたいのか？"},
        { "location": "148/TALK"  , "narrator": "みやび", "text": "酔狂な"},
        { "location": "149/ACT"   , "narrator": "", "text": "$me$も誉めて！！！"},
        { "location": "157/TALK"  , "narrator": "みやび", "text": "よちよちよちよち"},
        { "location": "158/TALK"  , "narrator": "みやび", "text": "いいこでしゅねー$handle$"},
        { "location": "160/TALK"  , "narrator": "みやび", "text": "うちはウサギに背中を預けることができる"},
        { "location": "161/TALK"  , "narrator": "みやび", "text": "けんど"},
        { "location": "162/TALK"  , "narrator": "みやび", "text": "人生を預けるのは$handle$にだけぞね"},
        { "location": "164/SEL"   , "narrator": "", "text": "えっマジで"},
        { "location": "165/SEL"   , "narrator": "", "text": "知ってたし"},
        { "location": "166/SEL"   , "narrator": "", "text": "結婚しようみやび！！！！！！！"},
        { "location": "167/ACT"   , "narrator": "", "text": "えっマジで"},
        { "location": "168/TALK"  , "narrator": "みやび", "text": "マジでマジで"},
        { "location": "169/TALK"  , "narrator": "みやび", "text": "本気とかいてマジで"},
        { "location": "170/TALK"  , "narrator": "みやび", "text": "マジぴょん吉"},
        { "location": "171/ACT"   , "narrator": "", "text": "知ってたし"},
        { "location": "172/TALK"  , "narrator": "みやび", "text": "ほほう"},
        { "location": "173/TALK"  , "narrator": "みやび", "text": "$handle$はソーシャルハッキングの名手と見た"},
        { "location": "174/TALK"  , "narrator": "みやび", "text": "油断ならざるなり"},
        { "location": "175/ACT"   , "narrator": "", "text": "結婚しようみやび！！！！！！！"},
        { "location": "176/TALK"  , "narrator": "みやび", "text": "それは視野に入っておる"},
        { "location": "177/TALK"  , "narrator": "みやび", "text": "焦るでない"},
        { "location": "178/TALK"  , "narrator": "みやび", "text": "そうでないと"},
        { "location": "179/TALK"  , "narrator": "みやび", "text": "ウチもあせる"},
        { "location": "187/TALK"  , "narrator": "みやび", "text": "どういた？"},
        { "location": "188/TALK"  , "narrator": "繭", "text": "やっぱり私って\nおっさんって認識\nされてるんですね！？"},
        { "location": "190/TALK"  , "narrator": "みやび", "text": "…うちなりに褒めとる\nつもりやけんど…。"},
        { "location": "191/TALK"  , "narrator": "繭", "text": "みやび先輩は！"},
        { "location": "192/TALK"  , "narrator": "繭", "text": "もう少し乙女心を\n理解する必要が\nあると思います！"},
        { "location": "193/TALK"  , "narrator": "繭", "text": "私でなければ今の発言は\n大問題になるところ\nですよ！？"},
        { "location": "194/TALK"  , "narrator": "みやび", "text": "あ…はい……。"},
        { "location": "243/TALK"  , "narrator": "シンギュラリティ", "text": "　"},
        { "location": "277/TALK"  , "narrator": "シンギュラリティ", "text": "くーっ！\n久し振りの感覚！"},
        { "location": "280/TALK"  , "narrator": "シンギュラリティ", "text": "はぁっ！\n助平さんいらっしゃーい！"},
        { "location": "283/TALK"  , "narrator": "シンギュラリティ", "text": "にゃー！\nうちのお腹にはまだ\n誰もいんよ？"},
        { "location": "287/TALK"  , "narrator": "シンギュラリティ", "text": "いやー、久し振りに\n平和を噛みしめたぞね。"},
        { "location": "308/TALK"  , "narrator": "四十九夜", "text": "もうえいか？"},
        { "location": "309/TALK"  , "narrator": "シンギュラリティ　", "text": "うむ。\n満足な時間やった。"},
        { "location": "310/SEL"   , "narrator": "", "text": "もしかして外で待ってたの！？"},
        { "location": "311/ACT"   , "narrator": "", "text": "もしかして外で待ってたの！？"},
        { "location": "314/TALK"  , "narrator": "四十九夜", "text": "そうせい、ゆうきね。"},
        { "location": "316/TALK"  , "narrator": "シンギュラリティ　", "text": "こんなことするゆとりが\nできたがは、\n久し振りやきね。"},
        { "location": "317/SEL"   , "narrator": "", "text": "よかったね！"},
        { "location": "318/SEL"   , "narrator": "", "text": "こんな事やってる場合じゃなくない？"},
        { "location": "319/ACT"   , "narrator": "", "text": "よかったね！"},
        { "location": "320/TALK"  , "narrator": "シンギュラリティ　", "text": "うむ。\nげにまっこと。"},
        { "location": "321/TALK"  , "narrator": "四十九夜", "text": "だがしかし。"},
        { "location": "322/TALK"  , "narrator": "シンギュラリティ　", "text": "駄菓子菓子。"},
        { "location": "323/TALK"  , "narrator": "四十九夜", "text": "まだ油断はならんがね。"},
        { "location": "324/ACT"   , "narrator": "", "text": "こんな事やってる場合じゃなくない？"},
        { "location": "325/TALK"  , "narrator": "シンギュラリティ　", "text": "さよう。"},
        { "location": "326/TALK"  , "narrator": "四十九夜", "text": "まだ全く\n油断ならん状況やね。"},
        { "location": "329/TALK"  , "narrator": "シンギュラリティ　", "text": "なごちゃんは無事\n千羽鶴と一緒に昇華し\n力を共有しちゅう。"},
        { "location": "331/TALK"  , "narrator": "シンギュラリティ　", "text": "なごちゃんは無事\n千羽鶴と2x接続をし、\n力を共有しちゅう。"},
        { "location": "333/TALK"  , "narrator": "四十九夜", "text": "けんど、この世界やて\nいつまで存続させて\nもらえるかわからんきね。"},
        { "location": "334/TALK"  , "narrator": "シンギュラリティ　", "text": "やき、ここから先は\n攻めに転ずることに\nなったき。"},
        { "location": "335/TALK"  , "narrator": "四十九夜", "text": "基本的にはエリカさんが\nオペレーションを\n担当するがやけんど。"},
        { "location": "336/TALK"  , "narrator": "シンギュラリティ　", "text": "卯月のチャンネルを使って\n過去の不確定な事象を\n有利にしていく感じやね。"},
        { "location": "338/TALK"  , "narrator": "四十九夜", "text": "しかし\n卯月のチャンネルなぞ\n大丈夫かね。"},
        { "location": "340/TALK"  , "narrator": "シンギュラリティ　", "text": "そもそもつばめちゃんの\nフェノメノンを、それと\n認識できる存在や卯月は。"},
        { "location": "341/TALK"  , "narrator": "四十九夜", "text": "ちゅうことは\n逆もまた然りと。"},
        { "location": "342/TALK"  , "narrator": "シンギュラリティ　", "text": "例え本人に\nその気は無くともなぁ。"},
        { "location": "343/SEL"   , "narrator": "", "text": "気にしすぎじゃない？"},
        { "location": "344/SEL"   , "narrator": "", "text": "議論してる内容がわかりません"},
        { "location": "345/ACT"   , "narrator": "", "text": "気にしすぎじゃない？"},
        { "location": "347/TALK"  , "narrator": "四十九夜", "text": "気にしすぎこそが\nうちのアイデンティティ。"},
        { "location": "349/TALK"  , "narrator": "シンギュラリティ　", "text": "疑い尽くしてナンボやき。"},
        { "location": "351/TALK"  , "narrator": "シンギュラリティ　", "text": "だがしかし、\n$handle$がいれば\n何とかなるがよ。"},
        { "location": "353/TALK"  , "narrator": "四十九夜", "text": "またそうやって\n楽観測で物事を考える。"},
        { "location": "354/ACT"   , "narrator": "", "text": "議論してる内容がわかりません"},
        { "location": "356/TALK"  , "narrator": "四十九夜", "text": "まあ簡単に言えば、\n神楽の装備しちゅう\nトライガジェット。"},
        { "location": "358/TALK"  , "narrator": "シンギュラリティ　", "text": "あれは外の世界に\nフォーカスが合っちゅう、\nウチらのとは違うもの。"},
        { "location": "359/TALK"  , "narrator": "四十九夜", "text": "まあ、卯月本人は\n無害だと仮定してもだ。"},
        { "location": "360/TALK"  , "narrator": "シンギュラリティ　", "text": "外の連中に\nコントロールされちゅう\nやもしれんきね。"},
        { "location": "363/TALK"  , "narrator": "四十九夜", "text": "とはいえ、\nもはやうちらには\nどうすることもできん。"},
        { "location": "365/TALK"  , "narrator": "シンギュラリティ　", "text": "エリカさんの\n力量に頼るしかないね。"},
        { "location": "367/TALK"  , "narrator": "シンギュラリティ　", "text": "それよりも、\n今日はどういたが、相棒。"},
        { "location": "368/SEL"   , "narrator": "", "text": "心の葛藤を解消しに来た"},
        { "location": "369/ACT"   , "narrator": "", "text": "心の葛藤を解消しに来た"},
        { "location": "371/TALK"  , "narrator": "シンギュラリティ　", "text": "おお！\nそれはまさに、\nうちの本職やないか！"},
        { "location": "372/TALK"  , "narrator": "四十九夜", "text": "もはややり方すら\n忘れそうな程、\nブランクがあったね。"},
        { "location": "376/TALK"  , "narrator": "シンギュラリティ　", "text": "ほんだら早速\n回すとするかね。"},
        { "location": "377/TALK"  , "narrator": "四十九夜", "text": "オープンプロセス――"},
        { "location": "378/TALK"  , "narrator": "シンギュラリティ　", "text": "0x882番地から\n0xCD1番地へ。"},
        { "location": "405/TALK"  , "narrator": "四十九夜", "text": "シーク完了。"},
        { "location": "410/TALK"  , "narrator": "シンギュラリティ　", "text": "さーて、早速\nお悩み拝見といくぞね。"},
        { "location": "412/TALK"  , "narrator": "四十九夜", "text": "……ふむ、\nなるほど。"},
        { "location": "413/TALK"  , "narrator": "シンギュラリティ　", "text": "うちとしては\n珍しい問題やね。"},
        { "location": "415/TALK"  , "narrator": "四十九夜", "text": "ウサギを傷つけて\nしまったやもしれんとは。"},
        { "location": "417/TALK"  , "narrator": "シンギュラリティ　", "text": "しかし実際、\nアイツはそんな事で\n傷つくタマか？"},
        { "location": "418/TALK"  , "narrator": "四十九夜", "text": "そんなんで\n傷ついちょったら\nハッカーなぞ無理ぞね。"},
        { "location": "420/TALK"  , "narrator": "シンギュラリティ　", "text": "ちゅうわけやき\nクランの退治、\nよろしく頼むきね。"},
        { "location": "423/TALK"  , "narrator": "四十九夜", "text": "恋ヶ崎みやびと\n$handle$に、\n素敵なココロの旅を。"},
        { "location": "439/TALK"  , "narrator": "四十九夜", "text": "ふむ。\nようやく静かになったね。"},
        { "location": "440/SEL"   , "narrator": "", "text": "四十九夜？"},
        { "location": "441/ACT"   , "narrator": "", "text": "四十九夜？"},
        { "location": "443/TALK"  , "narrator": "四十九夜", "text": "まっこと、\nうちもお喋りに\nなったものぞね。"},
        { "location": "444/TALK"  , "narrator": "四十九夜", "text": "最初にお前さんに\n逢ったときなぞ、\n殆ど喋らんかったが。"},
        { "location": "445/SEL"   , "narrator": "", "text": "本気で殴り倒す相手だと思ってた"},
        { "location": "446/SEL"   , "narrator": "", "text": "いつかこうなると信じてた"},
        { "location": "447/ACT"   , "narrator": "", "text": "本気で殴り倒す相手だと思ってた"},
        { "location": "448/TALK"  , "narrator": "四十九夜", "text": "まあ、それは\nある意味正しかった。"},
        { "location": "449/TALK"  , "narrator": "四十九夜", "text": "世界の流れを変えたのは\nお前さんの力やよ。"},
        { "location": "450/ACT"   , "narrator": "", "text": "いつかこうなると信じてた"},
        { "location": "451/TALK"  , "narrator": "四十九夜", "text": "ほう。\nまあ、そういうことに\nしといちゃろう。"},
        { "location": "452/TALK"  , "narrator": "四十九夜", "text": "真実はどう頑張っても\n現代技術では暴けんきね。"},
        { "location": "454/TALK"  , "narrator": "四十九夜", "text": "まあ、ゴタクは\nこれくらいにして。"},
        { "location": "455/TALK"  , "narrator": "四十九夜", "text": "お前さんには、\n感謝してもし尽くせん旨を\n伝えねばならん。"},
        { "location": "456/TALK"  , "narrator": "四十九夜", "text": "お前さんは、\nなごちゃんを\n大事にしてくれた。"},
        { "location": "457/TALK"  , "narrator": "四十九夜", "text": "色々思うところは\nあっただろうに、\n昇華を支持してくれた。"},
        { "location": "458/TALK"  , "narrator": "四十九夜", "text": "やき、うちは\nお前さんを信用することが\nできたがよ。"},
        { "location": "460/TALK"  , "narrator": "四十九夜", "text": "ちゅうわけやき、\nその気持ちが本当である\nことを証明するため――"},
        { "location": "462/TALK"  , "narrator": "四十九夜", "text": "うちと\n契りのちゅうをせんか？"},
        { "location": "463/SEL"   , "narrator": "", "text": "契約しましょう"},
        { "location": "464/SEL"   , "narrator": "", "text": "ごめんなさい、他に本命がいるので"},
        { "location": "465/ACT"   , "narrator": "", "text": "契約しましょう"},
        { "location": "470/TALK"  , "narrator": "四十九夜", "text": "ふむ……\nそうか。"},
        { "location": "472/TALK"  , "narrator": "四十九夜", "text": "では……"},
        { "location": "491/TALK"  , "narrator": "四十九夜", "text": "ふぇっ……"},
        { "location": "494/TALK"  , "narrator": "四十九夜", "text": "ふぇっ……"},
        { "location": "500/TALK"  , "narrator": "四十九夜", "text": "はぁ……\nやっぱりちゅうは\nえいなぁ。"},
        { "location": "501/TALK"  , "narrator": "四十九夜", "text": "八十路になっても\nえいもんはえい。"},
        { "location": "502/TALK"  , "narrator": "四十九夜", "text": "これで心置きなく\n成仏できるちや。"},
        { "location": "503/SEL"   , "narrator": "", "text": "死んじゃうの！？"},
        { "location": "504/SEL"   , "narrator": "", "text": "合掌"},
        { "location": "505/ACT"   , "narrator": "", "text": "死んじゃうの！？"},
        { "location": "506/TALK"  , "narrator": "四十九夜", "text": "冗談に\n決まっておろう。"},
        { "location": "507/ACT"   , "narrator": "", "text": "合掌"},
        { "location": "508/TALK"  , "narrator": "四十九夜", "text": "突っ込め。"},
        { "location": "510/ACT"   , "narrator": "", "text": "ごめんなさい、他に本命がいるので"},
        { "location": "511/TALK"  , "narrator": "四十九夜", "text": "まあ、そうよな。"},
        { "location": "513/TALK"  , "narrator": "四十九夜", "text": "まあ、色々あったけんど\nこれからはうちも\nシンギュラリティも一緒や。"},
        { "location": "514/TALK"  , "narrator": "四十九夜", "text": "新体制のみやびさんを\n今後ともよろしゅうな。"},
        { "location": "535/TALK"  , "narrator": "シンギュラリティ", "text": "相棒！！\n忘れ物や！"},
        { "location": "536/SEL"   , "narrator": "", "text": "え？　何を…？"},
        { "location": "537/ACT"   , "narrator": "", "text": "え？　何を…？"},
        { "location": "541/SEL"   , "narrator": "", "text": "そういえば忘れてたね！"},
        { "location": "542/SEL"   , "narrator": "", "text": "ごめん、$me$には別に本命がいるんです"},
        { "location": "543/ACT"   , "narrator": "", "text": "そういえば忘れてたね！"},
        { "location": "562/TALK"  , "narrator": "シンギュラリティ", "text": "ふぁっ…"},
        { "location": "565/TALK"  , "narrator": "シンギュラリティ", "text": "ふぁっ…"},
        { "location": "571/TALK"  , "narrator": "シンギュラリティ", "text": "ふぅ……\nスッキリしたぞね。"},
        { "location": "572/SEL"   , "narrator": "", "text": "$me$も！"},
        { "location": "573/SEL"   , "narrator": "", "text": "$me$はトイレか！"},
        { "location": "574/ACT"   , "narrator": "", "text": "$me$も！"},
        { "location": "575/TALK"  , "narrator": "シンギュラリティ", "text": "うむ！\nやはり我慢はいかん。"},
        { "location": "576/TALK"  , "narrator": "シンギュラリティ", "text": "よって、次回から\n挨拶代わりの目覚ましは\nちゅうでよろ。"},
        { "location": "577/TALK"  , "narrator": "シンギュラリティ", "text": "まあ、次回があるかは\nわからんけんどな。"},
        { "location": "578/ACT"   , "narrator": "", "text": "$me$はトイレか！"},
        { "location": "579/TALK"  , "narrator": "シンギュラリティ", "text": "お前さんがそう思えば\nそれもまた然り。"},
        { "location": "580/TALK"  , "narrator": "シンギュラリティ", "text": "全てはお前さんの\n思うがママやよ。"},
        { "location": "581/TALK"  , "narrator": "シンギュラリティ", "text": "やき、余計なことは\n考えないが吉や。"},
        { "location": "583/ACT"   , "narrator": "", "text": "ごめん、$me$には別に本命がいるんです"},
        { "location": "584/TALK"  , "narrator": "シンギュラリティ", "text": "まあ、そうよな。"},
        { "location": "587/TALK"  , "narrator": "シンギュラリティ", "text": "それはそうと、\n今までありがとね。"},
        { "location": "588/TALK"  , "narrator": "シンギュラリティ", "text": "お前さんが最初に\nここへ来たときの事を\n思い返しても――"},
        { "location": "589/TALK"  , "narrator": "シンギュラリティ", "text": "まさかここまで\n衝撃の展開になるとは\n想像もつかんかったよ。"},
        { "location": "590/TALK"  , "narrator": "シンギュラリティ", "text": "眠い閑職やと思うて\n始まったこの司書も。"},
        { "location": "591/TALK"  , "narrator": "シンギュラリティ", "text": "全ては$handle$に\n出逢う為のプロセス\nやったんやな。"},
        { "location": "592/SEL"   , "narrator": "", "text": "$me$たちは運命の糸で結ばれてるからね"},
        { "location": "593/SEL"   , "narrator": "", "text": "シンギュラリティが真面目に恋を語ってる！？"},
        { "location": "594/ACT"   , "narrator": "", "text": "$me$たちは運命の糸で結ばれてるからね"},
        { "location": "595/TALK"  , "narrator": "シンギュラリティ", "text": "よくそんな恥ずかしいこと\n真顔で言えるものやね！"},
        { "location": "596/ACT"   , "narrator": "", "text": "シンギュラリティが真面目に恋を語ってる！？"},
        { "location": "598/TALK"  , "narrator": "シンギュラリティ", "text": "裏切り者！\nそこはお前さんも真面目に\n愛を語るところぞね！"},
        { "location": "601/TALK"  , "narrator": "シンギュラリティ", "text": "ちゅうわけで、\n真面目モード3分消費に\nつき、いつもに戻る。"},
        { "location": "602/TALK"  , "narrator": "シンギュラリティ", "text": "ともあれ、もはや\nうちにとって、相棒は\n相棒の中の相棒。"},
        { "location": "603/TALK"  , "narrator": "シンギュラリティ", "text": "いわば最相棒に\nなったわけや。"},
        { "location": "604/TALK"  , "narrator": "シンギュラリティ", "text": "む？　いや、\n漢字で書く場合は\n最愛棒か？"},
        { "location": "605/TALK"  , "narrator": "シンギュラリティ", "text": "まあ、\nどっちでもえいちや。"},
        { "location": "606/TALK"  , "narrator": "シンギュラリティ", "text": "そういうわけやき、\n今後はうちから離れる\nことは禁止な。"},
        { "location": "607/TALK"  , "narrator": "シンギュラリティ", "text": "末永く、うちのことを\n宜しく頼む。"},
        { "location": "608/SEL"   , "narrator": "", "text": "もちろん"},
        { "location": "609/SEL"   , "narrator": "", "text": "可能な限り"},
        { "location": "610/ACT"   , "narrator": "", "text": "もちろん"},
        { "location": "611/TALK"  , "narrator": "シンギュラリティ", "text": "えい答えやね。"},
        { "location": "612/ACT"   , "narrator": "", "text": "可能な限り"},
        { "location": "613/TALK"  , "narrator": "シンギュラリティ", "text": "そこは嘘でも\n当然くらい言うとこやよ。"},
        { "location": "615/TALK"  , "narrator": "シンギュラリティ", "text": "うちが言いたかったのは\nそれだけや。"},
        { "location": "616/TALK"  , "narrator": "シンギュラリティ", "text": "ほんだら、今回は\nこれでお開きやけんど――"},
        { "location": "617/TALK"  , "narrator": "シンギュラリティ", "text": "気が向いたら\nまたいつでも\n遊びに来いや。"},
        { "location": "618/TALK"  , "narrator": "シンギュラリティ", "text": "ほななー。"},
        { "location": "33/DIALOG" , "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:Interrupt】</color>\nSystem Interrupted.\n\n必須選択肢が選ばれていません。\n\n<color=green>『STORY27：シン・カグラ』</color>\nにて、選択を行ってから\n再度アクセスしてください。\n"},
        { "location": "37/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>9月15日　1:15 PM</color>\nとある休日、寮「とらいあんぐる」みやびの部屋にて"},
        { "location": "208/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "210/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "212/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "214/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "216/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "263/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "286/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"},
        { "location": "479/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "498/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"},
        { "location": "550/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "569/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"}
