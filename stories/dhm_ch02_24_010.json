    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "ビター・スイート・スイーツ"},
        { "location": "32/TALK"   , "narrator": "アーヤ", "text": "ギャヴィったら"},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "クリームブリュレが苦いなんて"},
        { "location": "34/TALK"   , "narrator": "アーヤ", "text": "まだまだ子供ね(￣Д￣ )"},
        { "location": "36/SEL"    , "narrator": "", "text": "そこがかわいいとこでしょ"},
        { "location": "37/SEL"    , "narrator": "", "text": "カラメル苦いけど…"},
        { "location": "38/SEL"    , "narrator": "", "text": "アーヤはイケる口だから"},
        { "location": "39/ACT"    , "narrator": "", "text": "そこがかわいいとこでしょ"},
        { "location": "40/TALK"   , "narrator": "アーヤ", "text": "確かに"},
        { "location": "41/TALK"   , "narrator": "アーヤ", "text": "そうなんだけど"},
        { "location": "42/ACT"    , "narrator": "", "text": "カラメル苦いけど…"},
        { "location": "43/TALK"   , "narrator": "アーヤ", "text": "まあ"},
        { "location": "44/TALK"   , "narrator": "アーヤ", "text": "甘いだけじゃないわね"},
        { "location": "45/ACT"    , "narrator": "", "text": "アーヤはイケる口だから"},
        { "location": "46/TALK"   , "narrator": "アーヤ", "text": "もう"},
        { "location": "47/TALK"   , "narrator": "アーヤ", "text": "すごく飲む人みたいに"},
        { "location": "48/TALK"   , "narrator": "アーヤ", "text": "言わないで"},
        { "location": "50/TALK"   , "narrator": "アーヤ", "text": "ギャヴィの緊張をほぐすつもりでカフェに行ったけど"},
        { "location": "52/TALK"   , "narrator": "アーヤ", "text": "なんだか私の方が"},
        { "location": "53/TALK"   , "narrator": "アーヤ", "text": "楽しんじゃったみたい"},
        { "location": "55/SEL"    , "narrator": "", "text": "ガブリエラを信じてよかったね"},
        { "location": "56/SEL"    , "narrator": "", "text": "何故$me$を誘わなかった？"},
        { "location": "57/SEL"    , "narrator": "", "text": "ガブリエラ楽しんでたね"},
        { "location": "58/ACT"    , "narrator": "", "text": "ガブリエラを信じてよかったね"},
        { "location": "60/TALK"   , "narrator": "アーヤ", "text": "そうね"},
        { "location": "62/TALK"   , "narrator": "アーヤ", "text": "私もっとギャヴィを"},
        { "location": "63/TALK"   , "narrator": "アーヤ", "text": "信頼してあげなきゃね"},
        { "location": "64/TALK"   , "narrator": "アーヤ", "text": "でも今回は"},
        { "location": "65/TALK"   , "narrator": "アーヤ", "text": "$handle$さんがそう言ってくれたから"},
        { "location": "66/TALK"   , "narrator": "アーヤ", "text": "いい結果になったの"},
        { "location": "67/TALK"   , "narrator": "アーヤ", "text": "だから"},
        { "location": "68/TALK"   , "narrator": "アーヤ", "text": "ありがとう"},
        { "location": "69/ACT"    , "narrator": "", "text": "何故$me$を誘わなかった？"},
        { "location": "70/TALK"   , "narrator": "アーヤ", "text": "ごめんなさい"},
        { "location": "72/TALK"   , "narrator": "アーヤ", "text": "ギャヴィのことで頭がいっぱいだったの"},
        { "location": "73/TALK"   , "narrator": "アーヤ", "text": "次は一緒に行きましょう"},
        { "location": "74/ACT"    , "narrator": "", "text": "ガブリエラ楽しんでたね"},
        { "location": "75/TALK"   , "narrator": "アーヤ", "text": "そうね"},
        { "location": "76/TALK"   , "narrator": "アーヤ", "text": "でも私の方が"},
        { "location": "77/TALK"   , "narrator": "アーヤ", "text": "楽しんじゃった感じよ"}
    ]
}
