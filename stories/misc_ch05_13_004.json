    "entry":
    [
        { "location": "4038/SCENARIO", "narrator": "", "text": "前略、生徒会長殿"},
        { "location": "4063/TALK"    , "narrator": "神楽", "text": "ぴょんこはこれから大変に真面目な話をします"},
        { "location": "4064/TALK"    , "narrator": "神楽", "text": "白い学生服を着用して絶大な権力を持つ生徒会長に会ってみたい"},
        { "location": "4065/TALK"    , "narrator": "神楽", "text": "会わせて"},
        { "location": "4067/SEL"     , "narrator": "", "text": "普通に無理だろ…"},
        { "location": "4068/SEL"     , "narrator": "", "text": "それは二次元にしか存在しない系"},
        { "location": "4069/SEL"     , "narrator": "", "text": "なんで$me$の役職知ってるの"},
        { "location": "4070/ACT"     , "narrator": "", "text": "普通に無理だろ…"},
        { "location": "4071/TALK"    , "narrator": "神楽", "text": "そこをなんとか"},
        { "location": "4072/ACT"     , "narrator": "", "text": "それは二次元にしか存在しない系"},
        { "location": "4073/TALK"    , "narrator": "神楽", "text": "ぴょんこはそんなこと信じない"},
        { "location": "4074/ACT"     , "narrator": "", "text": "なんで$me$の役職知ってるの"},
        { "location": "4076/TALK"    , "narrator": "神楽", "text": "こんなところにいたとは！！！"},
        { "location": "4077/TALK"    , "narrator": "神楽", "text": "生徒会長様！！！"},
        { "location": "4079/SEL"     , "narrator": "", "text": "何だい、神楽クン"},
        { "location": "4080/SEL"     , "narrator": "", "text": "苦しゅうない、近う寄れ"},
        { "location": "4081/SEL"     , "narrator": "", "text": "やれやれ…キミも$me$を崇拝するような態度を取るのかい？"},
        { "location": "4082/ACT"     , "narrator": "", "text": "何だい、神楽クン"},
        { "location": "4083/TALK"    , "narrator": "神楽", "text": "うわやっばｗｗｗｗ"},
        { "location": "4084/TALK"    , "narrator": "神楽", "text": "そんな感じー！！！"},
        { "location": "4085/TALK"    , "narrator": "神楽", "text": "$handlek$上手すぎｗｗｗ"},
        { "location": "4086/ACT"     , "narrator": "", "text": "苦しゅうない、近う寄れ"},
        { "location": "4087/TALK"    , "narrator": "神楽", "text": "それ違う全然違う"},
        { "location": "4088/TALK"    , "narrator": "神楽", "text": "それじゃ時代劇"},
        { "location": "4089/TALK"    , "narrator": "神楽", "text": "しかもバカ殿系"},
        { "location": "4092/ACT"     , "narrator": "", "text": "やれやれ…キミも$me$を崇拝するような態度を取るのかい？"},
        { "location": "4093/TALK"    , "narrator": "神楽", "text": "カリスマ過ぎて遠巻きにされてる生徒会長様だ！！！"},
        { "location": "4095/TALK"    , "narrator": "神楽", "text": "乙女ゲー系の生徒会長様だ！！！"},
        { "location": "4096/TALK"    , "narrator": "神楽", "text": "やっべー壁ドンされちゃう！！！"},
        { "location": "4099/TALK"    , "narrator": "神楽", "text": "そいやリアル高校の生徒会長ってどういう人なんだろ"},
        { "location": "4100/TALK"    , "narrator": "神楽", "text": "全校集会でもなきゃわかんないな"},
        { "location": "4101/TALK"    , "narrator": "神楽", "text": "興味のあるなしで言ったらないし"},
        { "location": "4102/TALK"    , "narrator": "神楽", "text": "まあそんなもんだよね"}
    ]
}
