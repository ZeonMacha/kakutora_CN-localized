    [
        { "location": "112/SCENARIO", "narrator": "", "text": "360_別に、"},
        { "location": "139/SEL"     , "narrator": "", "text": "testじゃない？"},
        { "location": "140/SEL"     , "narrator": "", "text": "テスト受けるの？"},
        { "location": "141/SEL"     , "narrator": "", "text": "聞きたいことがあるんだけど"},
        { "location": "154/ACT"     , "narrator": "", "text": "testじゃない？"},
        { "location": "155/TALK"    , "narrator": "アーヤ", "text": "英語なら"},
        { "location": "156/TALK"    , "narrator": "アーヤ", "text": "そうね"},
        { "location": "157/ACT"     , "narrator": "", "text": "テスト受けるの？"},
        { "location": "158/TALK"    , "narrator": "アーヤ", "text": "受けるけど"},
        { "location": "159/TALK"    , "narrator": "アーヤ", "text": "そうじゃないから"},
        { "location": "160/ACT"     , "narrator": "", "text": "聞きたいことがあるんだけど"},
        { "location": "170/TALK"    , "narrator": "アーヤ", "text": "何？"},
        { "location": "172/SEL"     , "narrator": "", "text": "アーヤ怒ってるよね"},
        { "location": "173/SEL"     , "narrator": "", "text": "なんかずっと不機嫌じゃない？"},
        { "location": "174/SEL"     , "narrator": "", "text": "$me$が何かしたんだよね"},
        { "location": "176/ACT"     , "narrator": "", "text": "アーヤ怒ってるよね"},
        { "location": "177/TALK"    , "narrator": "アーヤ", "text": "なんで"},
        { "location": "178/TALK"    , "narrator": "アーヤ", "text": "そう思うの？"},
        { "location": "180/SEL"     , "narrator": "", "text": "そんな感じだから"},
        { "location": "181/ACT"     , "narrator": "", "text": "そんな感じだから"},
        { "location": "182/TALK"    , "narrator": "アーヤ", "text": "別に"},
        { "location": "183/TALK"    , "narrator": "アーヤ", "text": "そんなことないわ"},
        { "location": "184/TALK"    , "narrator": "アーヤ", "text": "気にしないで"},
        { "location": "186/ACT"     , "narrator": "", "text": "なんかずっと不機嫌じゃない？"},
        { "location": "187/TALK"    , "narrator": "アーヤ", "text": "別に"},
        { "location": "188/TALK"    , "narrator": "アーヤ", "text": "そんなことないわよ"},
        { "location": "190/SEL"     , "narrator": "", "text": "ならいいけど"},
        { "location": "191/ACT"     , "narrator": "", "text": "ならいいけど"},
        { "location": "192/TALK"    , "narrator": "アーヤ", "text": "そうでしょ"},
        { "location": "193/TALK"    , "narrator": "アーヤ", "text": "そう"},
        { "location": "195/TALK"    , "narrator": "アーヤ", "text": "そういうものでしょ"},
        { "location": "197/ACT"     , "narrator": "", "text": "$me$が何かしたんだよね"},
        { "location": "208/TALK"    , "narrator": "アーヤ", "text": "心当たりがあるの？"},
        { "location": "210/SEL"     , "narrator": "", "text": "ないけど……"},
        { "location": "211/SEL"     , "narrator": "", "text": "なんとなく"},
        { "location": "212/SEL"     , "narrator": "", "text": "ごめん、教えて"},
        { "location": "214/ACT"     , "narrator": "", "text": "ないけど……"},
        { "location": "216/TALK"    , "narrator": "アーヤ", "text": "じゃあ"},
        { "location": "217/TALK"    , "narrator": "アーヤ", "text": "それでいいんじゃない"},
        { "location": "218/ACT"     , "narrator": "", "text": "なんとなく"},
        { "location": "219/TALK"    , "narrator": "アーヤ", "text": "そうなの"},
        { "location": "220/TALK"    , "narrator": "アーヤ", "text": "じゃあ"},
        { "location": "221/TALK"    , "narrator": "アーヤ", "text": "気のせいだわ"},
        { "location": "222/ACT"     , "narrator": "", "text": "ごめん、教えて"},
        { "location": "234/TALK"    , "narrator": "アーヤ", "text": "本当に"},
        { "location": "236/TALK"    , "narrator": "アーヤ", "text": "聞きたいの？"},
        { "location": "238/SEL"     , "narrator": "", "text": "もちろん"},
        { "location": "239/ACT"     , "narrator": "", "text": "もちろん"},
        { "location": "241/TALK"    , "narrator": "アーヤ", "text": "ベターハーフの話"},
        { "location": "242/TALK"    , "narrator": "アーヤ", "text": "憶えてる？"},
        { "location": "245/SEL"     , "narrator": "", "text": "うん"},
        { "location": "246/SEL"     , "narrator": "", "text": "ごめん、何だっけ"},
        { "location": "247/ACT"     , "narrator": "", "text": "うん"},
        { "location": "248/TALK"    , "narrator": "アーヤ", "text": "そう"},
        { "location": "249/ACT"     , "narrator": "", "text": "ごめん、何だっけ"},
        { "location": "250/TALK"    , "narrator": "アーヤ", "text": "ベターハーフは"},
        { "location": "251/TALK"    , "narrator": "アーヤ", "text": "元々が二人でひとつの生物だったのが"},
        { "location": "252/TALK"    , "narrator": "アーヤ", "text": "別々になってしまった"},
        { "location": "254/TALK"    , "narrator": "アーヤ", "text": "人間は元々二人でひとつだったから"},
        { "location": "255/TALK"    , "narrator": "アーヤ", "text": "ベターハーフを求めあうって話"},
        { "location": "256/TALK"    , "narrator": "アーヤ", "text": "だけど"},
        { "location": "257/TALK"    , "narrator": "アーヤ", "text": "$handle$さんは私が一人でも平気だって言うから"},
        { "location": "258/TALK"    , "narrator": "アーヤ", "text": "だったらこうやって話す必要もないって思っただけよ"},
        { "location": "261/SEL"     , "narrator": "", "text": "それって……"},
        { "location": "262/SEL"     , "narrator": "", "text": "期待していいの？"},
        { "location": "263/ACT"     , "narrator": "", "text": "それって……"},
        { "location": "264/TALK"    , "narrator": "アーヤ", "text": "別にどうもしないわ"},
        { "location": "265/TALK"    , "narrator": "アーヤ", "text": "それだけの話よ"},
        { "location": "266/ACT"     , "narrator": "", "text": "期待していいの？"},
        { "location": "268/TALK"    , "narrator": "アーヤ", "text": "何を期待するの？"},
        { "location": "270/TALK"    , "narrator": "アーヤ", "text": "別にそれだけの話だから"},
        { "location": "166/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>900pt.</b></color></size>\nアップしました！"},
        { "location": "203/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>900pt.</b></color></size>\nアップしました！"},
