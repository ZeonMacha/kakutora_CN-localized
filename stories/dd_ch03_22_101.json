{
    "dir": "chap22/daydra/dd_ch03_22_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "22302",
        "cid": "gabriella",
        "title": "002 メインストーリー",
        "sub_title": "疑念＜前編＞"
    },
    "entry":
    [
        { "location": "40/TALK"   , "narrator": "アーヤ", "text": "もうこんな時間…。\nみんな、そろそろ\n寝る準備するわよ。"},
        { "location": "42/TALK"   , "narrator": "ガブリエラ", "text": "まだ平気よ。\nもう少しいいでしょ？"},
        { "location": "45/TALK"   , "narrator": "アーヤ", "text": "ダメよ。\n明日も朝から\n訓練なんだから。"},
        { "location": "47/TALK"   , "narrator": "ガブリエラ", "text": "あーあ、明日雨が\n降ればいいのに…。"},
        { "location": "49/TALK"   , "narrator": "つばめ", "text": "そうなったら\n一日お休みになるし。"},
        { "location": "50/TALK"   , "narrator": "つばめ", "text": "お休みになったら\nちょっとお買い物に\n行きたいな。"},
        { "location": "53/TALK"   , "narrator": "ガブリエラ", "text": "あのねぇ…つばめは\nそんなこと言ってる\n余裕ないでしょ？"},
        { "location": "54/TALK"   , "narrator": "ガブリエラ", "text": "今日の模擬戦、\n何回あたし達に\n負けたか覚えてる？"},
        { "location": "56/TALK"   , "narrator": "つばめ", "text": "あ、あれでも\n頑張ったんだよ。\nね？"},
        { "location": "58/TALK"   , "narrator": "神楽", "text": "そうです。\nこれでも一生懸命\nだったんですよ？"},
        { "location": "60/TALK"   , "narrator": "ガブリエラ", "text": "結果出さなきゃ\n意味ないわよ。"},
        { "location": "62/TALK"   , "narrator": "アーヤ", "text": "…まあ、ギャヴィの\n言うことも間違っては\nいないわね。"},
        { "location": "64/TALK"   , "narrator": "アーヤ", "text": "二人が頑張ってるのは\nわかるわ。"},
        { "location": "67/TALK"   , "narrator": "アーヤ", "text": "だけど、\n空回りしてるって\nいうか。"},
        { "location": "68/TALK"   , "narrator": "アーヤ", "text": "訓練に集中できてない\nように思ったわ。"},
        { "location": "71/TALK"   , "narrator": "神楽", "text": "…………。"},
        { "location": "75/TALK"   , "narrator": "つばめ", "text": "そ、そんなこと\nないです！"},
        { "location": "76/TALK"   , "narrator": "つばめ", "text": "ガブちゃん達が\n強過ぎるだけですよ。"},
        { "location": "77/TALK"   , "narrator": "ガブリエラ", "text": "まあ、あたし達が\n強すぎるっていうのは\n当然よね。"},
        { "location": "78/TALK"   , "narrator": "ガブリエラ", "text": "経験もチームワークも\nつばめ達以上なわけ\nだし。"},
        { "location": "79/TALK"   , "narrator": "つばめ", "text": "明日は今日より\nもっと勝つよ。"},
        { "location": "80/TALK"   , "narrator": "ガブリエラ", "text": "無理だと思うけど？"},
        { "location": "82/TALK"   , "narrator": "つばめ", "text": "絶対勝つよ！\nね、神楽ちゃ――"},
        { "location": "83/TALK"   , "narrator": "つばめ", "text": "…あれ？\n神楽ちゃん？"},
        { "location": "86/TALK"   , "narrator": "アーヤ", "text": "っていうか、明日も\n模擬戦やるのかしら？"},
        { "location": "88/TALK"   , "narrator": "ガブリエラ", "text": "だといいんだけど。\n砂浜マラソンは\nもう嫌だもの。"},
        { "location": "92/TALK"   , "narrator": "アーヤ", "text": "あら、私は好きよ？\n辛いけど海風が\n気持ちいいし。"},
        { "location": "93/TALK"   , "narrator": "ガブリエラ", "text": "そんなの感じてる\n余裕ないから。"},
        { "location": "94/TALK"   , "narrator": "ガブリエラ", "text": "つばめも\nそう思うでしょ？"},
        { "location": "96/TALK"   , "narrator": "ガブリエラ", "text": "…あら？\nどこ行ったのかしら？"},
        { "location": "99/TALK"   , "narrator": "アーヤ", "text": "卯月もいないわね。\nいつの間に出てったの\nかしら？"},
        { "location": "100/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "132/TALK"  , "narrator": "ガブリエラ", "text": "…つばめ達、\nどこ言ったのかしら？"},
        { "location": "133/TALK"  , "narrator": "ガブリエラ", "text": "靴があったから、\n外じゃないとは\n思うけど。"},
        { "location": "134/TALK"  , "narrator": "ガブリエラ", "text": "まったく、すぐに\n二人きりになりたがる\nんだから…。"},
        { "location": "135/TALK"  , "narrator": "ガブリエラ", "text": "…あっ。"},
        { "location": "138/TALK"  , "narrator": "ガブリエラ", "text": "いた…。\nこんなところで\n何やってんだか…。"},
        { "location": "139/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "140/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "141/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "142/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "163/TALK"  , "narrator": "ガブリエラ", "text": "…何よ。"},
        { "location": "164/TALK"  , "narrator": "ガブリエラ", "text": "何なのよ、あの二人！"},
        { "location": "165/TALK"  , "narrator": "ガブリエラ", "text": "そりゃ、仲がいいのは\nわかってたけど！"},
        { "location": "166/TALK"  , "narrator": "ガブリエラ", "text": "何も話さないで、\n黙って座ってるとか\nどういうことよ！？"},
        { "location": "167/TALK"  , "narrator": "ガブリエラ", "text": "みんなで話すより\n二人きりの方が\n楽しいってこと？"},
        { "location": "170/TALK"  , "narrator": "ガブリエラ", "text": "…あんまりよ。"},
        { "location": "171/TALK"  , "narrator": "ガブリエラ", "text": "あたしだって、\n友達なのに。"},
        { "location": "172/TALK"  , "narrator": "ガブリエラ", "text": "惨めすぎるわ。\nこんなの…。"},
        { "location": "174/TALK"  , "narrator": "ガブリエラ", "text": "……なんて。"},
        { "location": "175/TALK"  , "narrator": "ガブリエラ", "text": "…無駄よね。\nこんなこと悩んでも。"},
        { "location": "176/TALK"  , "narrator": "ガブリエラ", "text": "つばめと神楽は、\nすっごく仲がいいん\nだもの。"},
        { "location": "177/TALK"  , "narrator": "ガブリエラ", "text": "あたしなんかが、\n間に入れるわけが\nないのよ…。"},
        { "location": "178/TALK"  , "narrator": "ガブリエラ", "text": "…そんなこと、\n最初っから\nわかってるのに…。"},
        { "location": "179/SEL"   , "narrator": "", "text": "そうなのかな？"},
        { "location": "180/ACT"   , "narrator": "", "text": "そうなのかな？"},
        { "location": "184/TALK"  , "narrator": "ガブリエラ", "text": "…何なのよ、\nうるさいわね。"},
        { "location": "198/TALK"  , "narrator": "ガブリエラ", "text": "は？"},
        { "location": "199/TALK"  , "narrator": "ガブリエラ", "text": "見ててわからないの？"},
        { "location": "200/TALK"  , "narrator": "ガブリエラ", "text": "あの二人の仲の良さが"},
        { "location": "202/SEL"   , "narrator": "", "text": "思うところがある"},
        { "location": "203/ACT"   , "narrator": "", "text": "思うところがある"},
        { "location": "205/TALK"  , "narrator": "ガブリエラ", "text": "ハッキリ言いなさい"},
        { "location": "206/TALK"  , "narrator": "ガブリエラ", "text": "どういうことなの？"},
        { "location": "208/SEL"   , "narrator": "", "text": "神楽がつばめを壊すと言ってた"},
        { "location": "209/ACT"   , "narrator": "", "text": "神楽がつばめを壊すと言ってた"},
        { "location": "212/TALK"  , "narrator": "ガブリエラ", "text": "は？"},
        { "location": "216/TALK"  , "narrator": "ガブリエラ", "text": "いや待って"},
        { "location": "217/TALK"  , "narrator": "ガブリエラ", "text": "どういうことそれ？"},
        { "location": "218/TALK"  , "narrator": "ガブリエラ", "text": "たちの悪い冗談？"},
        { "location": "220/SEL"   , "narrator": "", "text": "本当のことだよ"},
        { "location": "221/ACT"   , "narrator": "", "text": "本当のことだよ"},
        { "location": "223/TALK"  , "narrator": "ガブリエラ", "text": "本当ならそれ"},
        { "location": "226/TALK"  , "narrator": "ガブリエラ", "text": "かなりヤバいんじゃない？"},
        { "location": "227/TALK"  , "narrator": "ガブリエラ", "text": "もしかして"},
        { "location": "228/TALK"  , "narrator": "ガブリエラ", "text": "最近二人がギコちなくなるのって"},
        { "location": "229/TALK"  , "narrator": "ガブリエラ", "text": "それが原因なのかしら？"},
        { "location": "232/TALK"  , "narrator": "ガブリエラ", "text": "でも冗談かもしれないし"},
        { "location": "235/TALK"  , "narrator": "ガブリエラ", "text": "でも本気だったとしたら"},
        { "location": "303/TALK"  , "narrator": "ガブリエラ", "text": "　"},
        { "location": "319/TALK"  , "narrator": "ガブリエラ", "text": "$handle$……。\n良かった、また会えて。"},
        { "location": "320/SEL"   , "narrator": "", "text": "廃墟！？"},
        { "location": "321/ACT"   , "narrator": "", "text": "廃墟！？"},
        { "location": "323/TALK"  , "narrator": "ガブリエラ", "text": "えへへ。\nだいぶ派手に\nドンパチやったから。"},
        { "location": "324/TALK"  , "narrator": "ガブリエラ", "text": "$handle$も\n戦ってくれてありがと。"},
        { "location": "325/SEL"   , "narrator": "", "text": "大丈夫！？"},
        { "location": "326/ACT"   , "narrator": "", "text": "大丈夫！？"},
        { "location": "328/TALK"  , "narrator": "ガブリエラ", "text": "ええ。あたしは平気。"},
        { "location": "329/TALK"  , "narrator": "ガブリエラ", "text": "刺客も撃退できたから、\n少しの間は大丈夫だと\n思う。"},
        { "location": "330/TALK"  , "narrator": "ガブリエラ", "text": "けど、そう遠くない\n未来に、また次の刺客が\nやってくると思う。"},
        { "location": "331/SEL"   , "narrator": "", "text": "その時はまた$me$が手伝うよ"},
        { "location": "332/SEL"   , "narrator": "", "text": "何で狙われてるの？本当は司書って良くないものなの？"},
        { "location": "333/ACT"   , "narrator": "", "text": "その時はまた$me$が手伝うよ"},
        { "location": "334/TALK"  , "narrator": "ガブリエラ", "text": "ふふ。\nそう言ってくれると\n思ってた。"},
        { "location": "335/TALK"  , "narrator": "ガブリエラ", "text": "ありがと、\n$handle$。"},
        { "location": "336/ACT"   , "narrator": "", "text": "何で狙われてるの？本当は司書って良くないものなの？"},
        { "location": "337/TALK"  , "narrator": "ガブリエラ", "text": "うーん……。\n失礼ね！　って言えない\nところが辛いわよね。"},
        { "location": "338/TALK"  , "narrator": "ガブリエラ", "text": "正直、イイモノか\n良くないものかは、\n判断が難しいわね。"},
        { "location": "339/TALK"  , "narrator": "ガブリエラ", "text": "あたしたち司書は、\n個人の力では不可能な事を\n超えるための存在。"},
        { "location": "340/TALK"  , "narrator": "ガブリエラ", "text": "例えるならば、テストの\nカンニングペーパー\nみたいな存在かしらね。"},
        { "location": "341/SEL"   , "narrator": "", "text": "正解がわかるの？"},
        { "location": "342/ACT"   , "narrator": "", "text": "正解がわかるの？"},
        { "location": "344/TALK"  , "narrator": "ガブリエラ", "text": "んーと、どっちかというと\n普段絶対わからない未来の\n正解を知ることができる。"},
        { "location": "345/TALK"  , "narrator": "ガブリエラ", "text": "それを知る存在と\nコンタクトをとれる人格、\nそれがココロの司書なの。"},
        { "location": "346/TALK"  , "narrator": "ガブリエラ", "text": "だから、フェアじゃない\nといって反対する人格も\nいるし――"},
        { "location": "347/TALK"  , "narrator": "ガブリエラ", "text": "外部から情報を引き入れる\nのがセキュリティ的に問題\nという人格もいる。"},
        { "location": "348/TALK"  , "narrator": "ガブリエラ", "text": "実際は今までに、そういう\n危険なことは、一切\n起きてはいないんだけど。"},
        { "location": "349/SEL"   , "narrator": "", "text": "どうして外部と繋がれる力があるの？"},
        { "location": "350/SEL"   , "narrator": "", "text": "どうしてそんな力が必要なの？"},
        { "location": "351/SEL"   , "narrator": "", "text": "でも刺客が「牙を剥く」って……"},
        { "location": "352/ACT"   , "narrator": "", "text": "どうして外部と繋がれる力があるの？"},
        { "location": "353/TALK"  , "narrator": "ガブリエラ", "text": "力がある、というよりは\n必須要件なのよね。"},
        { "location": "354/TALK"  , "narrator": "ガブリエラ", "text": "トライガジェットの機能を\n使うための。"},
        { "location": "355/ACT"   , "narrator": "", "text": "どうしてそんな力が必要なの？"},
        { "location": "356/TALK"  , "narrator": "ガブリエラ", "text": "必要、というよりは\n必須要件なのよね。"},
        { "location": "357/TALK"  , "narrator": "ガブリエラ", "text": "トライガジェットの機能を\n使うための。"},
        { "location": "358/ACT"   , "narrator": "", "text": "でも刺客が「牙を剥く」って……"},
        { "location": "359/TALK"  , "narrator": "ガブリエラ", "text": "そうね。\nでも具体的に何が\n起きるかはわからない。"},
        { "location": "360/TALK"  , "narrator": "ガブリエラ", "text": "もちろん、まだ何かが\n起こると決まった\nわけじゃない。"},
        { "location": "361/TALK"  , "narrator": "ガブリエラ", "text": "確かに外部との連絡係は\nセキュリティホールに\nなってしまうから――"},
        { "location": "362/TALK"  , "narrator": "ガブリエラ", "text": "外からコントロール\nされたり、洗脳されたり\nしちゃう可能性はある。"},
        { "location": "363/TALK"  , "narrator": "ガブリエラ", "text": "けど、だからといって\n連絡を停止したり、司書を\n排除していいわけがない。"},
        { "location": "364/TALK"  , "narrator": "ガブリエラ", "text": "ココロの司書は、\nあたしのココロの総意に\nよって選ばれてるから。"},
        { "location": "365/TALK"  , "narrator": "ガブリエラ", "text": "一人格が勝手に\n殺したりして\nいいものじゃないのよ。"},
        { "location": "368/TALK"  , "narrator": "ガブリエラ", "text": "いずれにしても、\nもうここには\n平和は戻らない。"},
        { "location": "369/TALK"  , "narrator": "ガブリエラ", "text": "正直言うとね。あたし、\nずっと平穏なままの状態で\nいたかったの。"},
        { "location": "370/TALK"  , "narrator": "ガブリエラ", "text": "毎日ヒマで、\nたまに$handle$が\n遊びに来て――"},
        { "location": "371/TALK"  , "narrator": "ガブリエラ", "text": "ちょっとイチャイチャして\nその後、扉回してあげて。"},
        { "location": "372/TALK"  , "narrator": "ガブリエラ", "text": "そんな日が、\nずっと続く事を\n望んでた。"},
        { "location": "373/TALK"  , "narrator": "ガブリエラ", "text": "けど、ハナから\nそんなことは\n無理だったのよね。"},
        { "location": "374/SEL"   , "narrator": "", "text": "$me$がまた平和にしてみせる"},
        { "location": "375/SEL"   , "narrator": "", "text": "諸行無常だねぇ"},
        { "location": "376/ACT"   , "narrator": "", "text": "$me$がまた平和にしてみせる"},
        { "location": "377/TALK"  , "narrator": "ガブリエラ", "text": "…そう……。"},
        { "location": "378/TALK"  , "narrator": "ガブリエラ", "text": "そうよね。"},
        { "location": "379/TALK"  , "narrator": "ガブリエラ", "text": "あたしには\n$handle$が\nついてるもの。"},
        { "location": "380/TALK"  , "narrator": "ガブリエラ", "text": "また前みたいに、\nのんびりと楽しくお話\nできる日が来るわよね。"},
        { "location": "381/TALK"  , "narrator": "ガブリエラ", "text": "ありがとう、\n$handle$。"},
        { "location": "382/TALK"  , "narrator": "ガブリエラ", "text": "あなたがいてくれて\n本当に良かった…。"},
        { "location": "383/ACT"   , "narrator": "", "text": "諸行無常だねぇ"},
        { "location": "384/TALK"  , "narrator": "ガブリエラ", "text": "…ほんとね。"},
        { "location": "385/TALK"  , "narrator": "ガブリエラ", "text": "でも、頑張って\nまたココロに平穏を\n取り戻すわ。"},
        { "location": "387/TALK"  , "narrator": "ガブリエラ", "text": "それでね。\nここからが\n本題なんだけど。"},
        { "location": "388/TALK"  , "narrator": "ガブリエラ", "text": "あたし、\n思ってるのよ。"},
        { "location": "389/TALK"  , "narrator": "ガブリエラ", "text": "司書に送られてくる\nKOKORO-ERRORっていう\n情報があるの。"},
        { "location": "390/TALK"  , "narrator": "ガブリエラ", "text": "そこには、今の葛藤が何で\nどう解決していけばいいか\n全て書かれてる。"},
        { "location": "391/TALK"  , "narrator": "ガブリエラ", "text": "この情報は確かに\nあたしの本当の気持ちを\n代弁してはいるのよ。"},
        { "location": "392/TALK"  , "narrator": "ガブリエラ", "text": "けど、思うんだけど――"},
        { "location": "393/TALK"  , "narrator": "ガブリエラ", "text": "本人が本当にしたいことを\n後押しするのが、果たして\n絶対的に正しいことなの？"},
        { "location": "394/TALK"  , "narrator": "ガブリエラ", "text": "この情報は確かに、未来を\n予見した上で、ベストな\n解を教えてくれる。"},
        { "location": "395/TALK"  , "narrator": "ガブリエラ", "text": "それは、あたし個人では\n到底わかり得ない、\n確実な幸せの選択。"},
        { "location": "396/TALK"  , "narrator": "ガブリエラ", "text": "それはわかってるし、\nあたしに届けられる情報を\n疑ってるわけじゃない。"},
        { "location": "397/TALK"  , "narrator": "ガブリエラ", "text": "けど、それは\n何を基準に見た幸せなの？"},
        { "location": "398/TALK"  , "narrator": "ガブリエラ", "text": "あたしの幸せっていうのは\n絶対的にそれ１つなの？"},
        { "location": "399/TALK"  , "narrator": "ガブリエラ", "text": "もし沢山ある幸せの中の\n１つだというなら、何を\n基準にそれを選んでるの？"},
        { "location": "400/SEL"   , "narrator": "", "text": "難しい事考えてたんだね！"},
        { "location": "401/SEL"   , "narrator": "", "text": "それは$me$も思ってたよ"},
        { "location": "402/ACT"   , "narrator": "", "text": "難しい事考えてたんだね！"},
        { "location": "403/TALK"  , "narrator": "ガブリエラ", "text": "まあ、\n自分の人生のことだし。\n真剣に考えもするわよ。"},
        { "location": "404/ACT"   , "narrator": "", "text": "それは$me$も思ってたよ"},
        { "location": "405/TALK"  , "narrator": "ガブリエラ", "text": "すごいわね！"},
        { "location": "406/TALK"  , "narrator": "ガブリエラ", "text": "やっぱりあたしの\nココロの中に入ってくる\nだけのことはあるわ。"},
        { "location": "408/TALK"  , "narrator": "ガブリエラ", "text": "というわけでね、\nその疑問を解決する為に、\nやりたいことがあって。"},
        { "location": "409/TALK"  , "narrator": "ガブリエラ", "text": "協力してくれる？"},
        { "location": "410/SEL"   , "narrator": "", "text": "もちろん"},
        { "location": "411/SEL"   , "narrator": "", "text": "な、なに？"},
        { "location": "412/ACT"   , "narrator": "", "text": "もちろん"},
        { "location": "413/TALK"  , "narrator": "ガブリエラ", "text": "ありがと！\nさすがは\n$handle$ね！"},
        { "location": "414/ACT"   , "narrator": "", "text": "な、なに？"},
        { "location": "415/TALK"  , "narrator": "ガブリエラ", "text": "あら、ビビってるの？\n仕方のない\n$handle$ね。"},
        { "location": "417/TALK"  , "narrator": "ガブリエラ", "text": "やってみたいことって\nいうのはね――"},
        { "location": "418/TALK"  , "narrator": "ガブリエラ", "text": "指定されるエラーとは\n逆さまの選択を\nし続けたらどうなるか。"},
        { "location": "419/SEL"   , "narrator": "", "text": "やめて！マジでやめて！"},
        { "location": "420/SEL"   , "narrator": "", "text": "面白そう！！"},
        { "location": "421/ACT"   , "narrator": "", "text": "やめて！マジでやめて！"},
        { "location": "423/TALK"  , "narrator": "ガブリエラ", "text": "臆病ね。"},
        { "location": "424/TALK"  , "narrator": "ガブリエラ", "text": "でもね、\n$handle$。"},
        { "location": "425/TALK"  , "narrator": "ガブリエラ", "text": "あたしは既に一度\n消されかけてるの。"},
        { "location": "426/TALK"  , "narrator": "ガブリエラ", "text": "今更敵が１つ２つ増えた\nところで何ともないわよ。\nそれに――"},
        { "location": "427/TALK"  , "narrator": "ガブリエラ", "text": "今回$handle$を\n見送った後に、ちゃんと\n準備もするつもり。"},
        { "location": "428/ACT"   , "narrator": "", "text": "面白そう！！"},
        { "location": "429/TALK"  , "narrator": "ガブリエラ", "text": "さ、さすがは\n$handle$ね。"},
        { "location": "430/TALK"  , "narrator": "ガブリエラ", "text": "度胸があるのか、\n考えナシなのかは\nわからないけど。"},
        { "location": "431/TALK"  , "narrator": "ガブリエラ", "text": "あたし、思うのよ。"},
        { "location": "432/TALK"  , "narrator": "ガブリエラ", "text": "あたしは既に一度\n消されかけてる。"},
        { "location": "433/TALK"  , "narrator": "ガブリエラ", "text": "今更何かを我慢したり\n護りに入ったって、結局\nだれかに襲われる。"},
        { "location": "434/TALK"  , "narrator": "ガブリエラ", "text": "それなら、\nやれることは全部\nやっておきたいじゃない？"},
        { "location": "436/SEL"   , "narrator": "", "text": "いや、でもやっぱりヤバイわ！千羽鶴が怒るだろうし…"},
        { "location": "437/SEL"   , "narrator": "", "text": "$me$も一緒に戦うよ"},
        { "location": "438/ACT"   , "narrator": "", "text": "いや、でもやっぱりヤバイわ！千羽鶴が怒るだろうし…"},
        { "location": "439/TALK"  , "narrator": "ガブリエラ", "text": "千羽鶴…？\nよくわからないけど。"},
        { "location": "440/TALK"  , "narrator": "ガブリエラ", "text": "$handle$には\nあまり迷惑かけないように\nするから、大丈夫よ？"},
        { "location": "441/ACT"   , "narrator": "", "text": "$me$も一緒に戦うよ"},
        { "location": "442/TALK"  , "narrator": "ガブリエラ", "text": "$handle$…。\nいつもありがと。"},
        { "location": "444/TALK"  , "narrator": "ガブリエラ", "text": "本当に、\n貴方と出会えて良かった。"},
        { "location": "447/TALK"  , "narrator": "ガブリエラ", "text": "それじゃ、\n今回の悩みを\n見てみましょ。"},
        { "location": "454/TALK"  , "narrator": "ガブリエラ", "text": "オープンプロセス、\n0x9FB番地から\n0xBAA番地へ。"},
        { "location": "477/TALK"  , "narrator": "ガブリエラ", "text": "シーク完了っ♪"},
        { "location": "482/TALK"  , "narrator": "ガブリエラ", "text": "で、今回は……と。"},
        { "location": "483/TALK"  , "narrator": "ガブリエラ", "text": "なるほど。\nあたしらしい悩みね。"},
        { "location": "484/TALK"  , "narrator": "ガブリエラ", "text": "ていうか、\nあんたもこのタイミングで\nすごい爆弾発言するわね。"},
        { "location": "485/SEL"   , "narrator": "", "text": "ここしかないと思って"},
        { "location": "486/SEL"   , "narrator": "", "text": "え？\nなにが爆弾だった？"},
        { "location": "487/ACT"   , "narrator": "", "text": "ここしかないと思って"},
        { "location": "488/TALK"  , "narrator": "ガブリエラ", "text": "まあ、確かに\n的確だとは思うわね。"},
        { "location": "489/ACT"   , "narrator": "", "text": "え？\nなにが爆弾だった？"},
        { "location": "490/TALK"  , "narrator": "ガブリエラ", "text": "神楽がつばめを壊すって\n言ってきたことよ。"},
        { "location": "491/TALK"  , "narrator": "ガブリエラ", "text": "そんなこと言われたら、\n普通動揺しちゃうでしょ？"},
        { "location": "492/TALK"  , "narrator": "ガブリエラ", "text": "でもまあ、あんたも\n考え無しじゃないって\nことはわかるわ。"},
        { "location": "494/TALK"  , "narrator": "ガブリエラ", "text": "お陰で、あたしの\nソルジャーとしての勘が\nもの凄い騒いでる。"},
        { "location": "495/TALK"  , "narrator": "ガブリエラ", "text": "総意としても、\n友達を信じたいという\n気持ちもありながら――"},
        { "location": "496/TALK"  , "narrator": "ガブリエラ", "text": "神楽に対して\n尋問しなくちゃ…って\n気持ちが勝ってる。"},
        { "location": "497/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "499/TALK"  , "narrator": "ガブリエラ", "text": "だから今回は現実の\nあたしに、総意とは逆に\n「考え過ぎ」と思わせる。"},
        { "location": "501/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "503/TALK"  , "narrator": "ガブリエラ", "text": "これでよし。"},
        { "location": "504/TALK"  , "narrator": "ガブリエラ", "text": "攻撃ターゲットを、\n指定のクランと戦ってる\n側のクランに変更した。"},
        { "location": "505/TALK"  , "narrator": "ガブリエラ", "text": "扉の先には、情報提供者が\n護らせようとしている\nクランたちがいるはず。"},
        { "location": "506/TALK"  , "narrator": "ガブリエラ", "text": "撃退、よろしく。"},
        { "location": "507/SEL"   , "narrator": "", "text": "オーケー"},
        { "location": "508/SEL"   , "narrator": "", "text": "忠告はしたからね？"},
        { "location": "509/ACT"   , "narrator": "", "text": "オーケー"},
        { "location": "510/TALK"  , "narrator": "ガブリエラ", "text": "ありがと。"},
        { "location": "511/ACT"   , "narrator": "", "text": "忠告はしたからね？"},
        { "location": "513/TALK"  , "narrator": "ガブリエラ", "text": "それはなに？\nあたしのために言ってる\n言葉のつもり？"},
        { "location": "514/TALK"  , "narrator": "ガブリエラ", "text": "じゃあ、あんたの助言に\n従ったとして、ずっと\nこの状態を続けるの？"},
        { "location": "515/TALK"  , "narrator": "ガブリエラ", "text": "ココロゲートが\nこんなボロボロに\nなっても尚、続けるの？"},
        { "location": "516/TALK"  , "narrator": "ガブリエラ", "text": "どのみちここはもう\n長くないと思う。"},
        { "location": "517/TALK"  , "narrator": "ガブリエラ", "text": "だから、最後くらいは\nやりたいことを\nやらせて欲しいわね。"},
        { "location": "519/TALK"  , "narrator": "ガブリエラ", "text": "それじゃ、いくわよ。"},
        { "location": "520/TALK"  , "narrator": "ガブリエラ", "text": "あたしと\n$handle$に\n素敵なココロの旅を。"},
        { "location": "39/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>8月28日　 11:04 PM</color>\n合宿中、みやびの実家でのこと"},
        { "location": "268/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "270/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "272/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "274/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "276/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"}
    ]
}
