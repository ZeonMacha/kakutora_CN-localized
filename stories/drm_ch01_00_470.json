{
    "dir": "dramatics/daydra/drm_ch01_00_470.js",
    "type": "Episode",
    "info": {
        "story_id": "1047",
        "cid": "tsubame",
        "title": "らぶとーく 第47話",
        "sub_title": "秘密と策略"
    },
    "entry":
    [
        { "location": "201/SCENARIO", "narrator": "", "text": "秘密と策略"},
        { "location": "215/TALK"    , "narrator": "アーヤ", "text": "は！？\nつばめ、あなた何を\n言い出すの！？"},
        { "location": "217/TALK"    , "narrator": "つばめ", "text": "だから、卯月さんは\n何も悪くないんです！"},
        { "location": "218/TALK"    , "narrator": "ガブリエラ", "text": "何バカなこと\n言ってんのよ！？"},
        { "location": "219/TALK"    , "narrator": "ガブリエラ", "text": "あんた、あいつに\n殺されかけたの\n忘れたっていうの！？"},
        { "location": "220/TALK"    , "narrator": "つばめ", "text": "忘れてないよ。"},
        { "location": "221/TALK"    , "narrator": "つばめ", "text": "でも、あれにはきっと、\n何か理由があったんだと\n思うの。"},
        { "location": "222/TALK"    , "narrator": "つばめ", "text": "じゃなきゃ、卯月さんが\nあんな酷いことするはず\nないし。"},
        { "location": "223/TALK"    , "narrator": "アーヤ", "text": "理由のあるなしの\n問題じゃないでしょ！？"},
        { "location": "224/TALK"    , "narrator": "アーヤ", "text": "どんな理由があろうと、\n誰かを殺していいわけじゃ\nないのよ？"},
        { "location": "227/TALK"    , "narrator": "つばめ", "text": "で、でも、わたしは\nこうして生きてますし…。"},
        { "location": "228/TALK"    , "narrator": "みやび", "text": "いい加減にしぃ。"},
        { "location": "229/TALK"    , "narrator": "みやび", "text": "つばめちゃんが\n優しい子いうんは、\nうちもよく知っちょるよ。"},
        { "location": "230/TALK"    , "narrator": "みやび", "text": "けんど、殺されかけてまで\n庇おうとしゆうんは――"},
        { "location": "231/TALK"    , "narrator": "みやび", "text": "さすがに異常や。\nわけがわからんちや。"},
        { "location": "233/TALK"    , "narrator": "つばめ", "text": "そんな…。"},
        { "location": "235/TALK"    , "narrator": "アーヤ", "text": "まあ、あれだけのことを\nされたんだから――"},
        { "location": "236/TALK"    , "narrator": "アーヤ", "text": "ショックで正常な判断が\n出来なくなってるんじゃ\nないかしら？"},
        { "location": "237/TALK"    , "narrator": "ガブリエラ", "text": "そうじゃなきゃ困るわ。\n仲間の誰かが本当に\n殺されたとしても――"},
        { "location": "239/TALK"    , "narrator": "ガブリエラ", "text": "理由があるに違いない、\nとか言って許しそうだし。"},
        { "location": "241/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "255/TALK"    , "narrator": "つばめ", "text": "どぅしよぅ"},
        { "location": "256/TALK"    , "narrator": "つばめ", "text": "卯月さんが悪者だと思われちゃってる"},
        { "location": "257/TALK"    , "narrator": "つばめ", "text": "絶対誤解だって思ぅのに(´・ω・｀)"},
        { "location": "258/TALK"    , "narrator": "つばめ", "text": "みんなそぅは思わなぃのかな？(´つω・｀)ｼｭﾝ"},
        { "location": "260/SEL"     , "narrator": "", "text": "今庇うのは逆効果"},
        { "location": "261/SEL"     , "narrator": "", "text": "推理の材料が少なすぎる"},
        { "location": "262/SEL"     , "narrator": "", "text": "冗談ってことにすれば"},
        { "location": "263/ACT"     , "narrator": "", "text": "今庇うのは逆効果"},
        { "location": "264/TALK"    , "narrator": "つばめ", "text": "そぅかも"},
        { "location": "265/TALK"    , "narrator": "つばめ", "text": "みんな今は何言っても聞ぃてくれそぅになぃし(o´Д`)=з"},
        { "location": "266/TALK"    , "narrator": "つばめ", "text": "嫌だけど"},
        { "location": "267/TALK"    , "narrator": "つばめ", "text": "今は大人しくしてるよ(´つω・｀)ｼｭﾝ"},
        { "location": "278/TALK"    , "narrator": "アーヤ", "text": "まあ、卯月に何かしら\n理由があるのかどうかは\nわからないけど――"},
        { "location": "279/TALK"    , "narrator": "アーヤ", "text": "ハッキリしてるのは、\n私達を裏切ったという\nことと――"},
        { "location": "280/TALK"    , "narrator": "アーヤ", "text": "つばめを殺そうとした、\nってこと。"},
        { "location": "281/TALK"    , "narrator": "アーヤ", "text": "卯月に対して警戒する\n理由としては、十分だと\n思うわ。"},
        { "location": "283/TALK"    , "narrator": "ガブリエラ", "text": "十分過ぎるわ。\n仲間だと思ってたのに、\nあいつ――"},
        { "location": "284/TALK"    , "narrator": "ガブリエラ", "text": "絶対許さないんだから！"},
        { "location": "287/TALK"    , "narrator": "みやび", "text": "うちも、今回はまっこと\n腹が立ってるちや。"},
        { "location": "288/TALK"    , "narrator": "みやび", "text": "何かしら理由があったと\nしても、簡単に許すわけ\nにはいかんな。"},
        { "location": "289/TALK"    , "narrator": "ガブリエラ", "text": "今後は卯月のことは\n敵として扱う、って\nことで――"},
        { "location": "290/TALK"    , "narrator": "ガブリエラ", "text": "それでいいわね？"},
        { "location": "292/TALK"    , "narrator": "つばめ", "text": "そ、そんな！"},
        { "location": "294/TALK"    , "narrator": "ガブリエラ", "text": "いい加減にしてよ！\nあんた殺されかけた\nのよ！？"},
        { "location": "295/TALK"    , "narrator": "ガブリエラ", "text": "裏切って、仲間のことを\n殺そうとしたような奴の\nことを――"},
        { "location": "296/TALK"    , "narrator": "ガブリエラ", "text": "あんたは許せるの？\nあたし達が殺され\nかけたとしても――"},
        { "location": "297/TALK"    , "narrator": "ガブリエラ", "text": "あんたは怒りもせずに、\n理由があったに違いない、\nとか言うわけ！？"},
        { "location": "299/TALK"    , "narrator": "つばめ", "text": "そ、そんなこと…。"},
        { "location": "301/TALK"    , "narrator": "ガブリエラ", "text": "だったらもう黙って！\nつばめが許せばそれで\nおしまいなんて――"},
        { "location": "302/TALK"    , "narrator": "ガブリエラ", "text": "そんな簡単な話じゃ\nないんだから！"},
        { "location": "304/TALK"    , "narrator": "アーヤ", "text": "…私も、ギャヴィの\n意見に賛成よ。"},
        { "location": "305/TALK"    , "narrator": "アーヤ", "text": "どんな理由であれ、\n仲間に手を掛けた\n相手のことを――"},
        { "location": "306/TALK"    , "narrator": "アーヤ", "text": "簡単に許したりする\nことはできないわ。"},
        { "location": "308/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "310/TALK"    , "narrator": "みやび", "text": "…つばめちゃんも、\nちっくとでえいき――"},
        { "location": "311/TALK"    , "narrator": "みやび", "text": "卯月が目の前に現れたら、\n警戒せんといかんよ？"},
        { "location": "312/TALK"    , "narrator": "つばめ", "text": "…わかり、ました。"},
        { "location": "313/TALK"    , "narrator": "つばめ", "text": "…絶対、何か理由が\nあるはずなのに…。"},
        { "location": "314/ACT"     , "narrator": "", "text": "推理の材料が少なすぎる"},
        { "location": "315/TALK"    , "narrator": "つばめ", "text": "そぅだよね"},
        { "location": "316/TALK"    , "narrator": "つばめ", "text": "卯月さんが本当に裏切ったのかどうか"},
        { "location": "317/TALK"    , "narrator": "つばめ", "text": "その確証はなぃよね！(´∀｀*)"},
        { "location": "329/TALK"    , "narrator": "つばめ", "text": "あ、あの！"},
        { "location": "330/TALK"    , "narrator": "つばめ", "text": "本当に裏切ったと\n決めつけるのには、\nまだ早いです！"},
        { "location": "332/TALK"    , "narrator": "みやび", "text": "どこがや？"},
        { "location": "333/TALK"    , "narrator": "つばめ", "text": "だって、まだその証拠が\nないじゃないですか！"},
        { "location": "334/TALK"    , "narrator": "つばめ", "text": "なのに、そんな敵になった\nみたいな言い方で話を\nするのは…。"},
        { "location": "335/TALK"    , "narrator": "ガブリエラ", "text": "いい加減にしてよ、\nバカ！！"},
        { "location": "336/TALK"    , "narrator": "ガブリエラ", "text": "あんた、\n殺されかけたのよ！？"},
        { "location": "337/TALK"    , "narrator": "ガブリエラ", "text": "どんな理由があっても、\n殺そうとした時点で\n敵じゃない！"},
        { "location": "338/TALK"    , "narrator": "つばめ", "text": "そ、それは…。"},
        { "location": "340/ACT"     , "narrator": "", "text": "冗談ってことにすれば"},
        { "location": "341/TALK"    , "narrator": "つばめ", "text": "さすがにそれはなぃよ(ﾟ△ﾟ;ﾉ)ﾉ"},
        { "location": "342/TALK"    , "narrator": "つばめ", "text": "っていうか"},
        { "location": "343/TALK"    , "narrator": "つばめ", "text": "シャレにならなぃよそれ(o´Д`)=з"},
        { "location": "355/TALK"    , "narrator": "つばめ", "text": "…で、でも！"},
        { "location": "356/TALK"    , "narrator": "つばめ", "text": "卯月さんは、本当に、\n凄く悩んでいたんです！"},
        { "location": "357/TALK"    , "narrator": "つばめ", "text": "だから、絶対に何か\n理由があったんだと――"},
        { "location": "359/TALK"    , "narrator": "みやび", "text": "つばめちゃんが\n卯月を庇う気持ちは\nわかるけんど――"},
        { "location": "360/TALK"    , "narrator": "みやび", "text": "事実を変えることは\nできんちや。"},
        { "location": "361/TALK"    , "narrator": "ガブリエラ", "text": "そうよ。"},
        { "location": "362/TALK"    , "narrator": "ガブリエラ", "text": "あいつはつばめのことを\n殺そうとした。"},
        { "location": "363/TALK"    , "narrator": "ガブリエラ", "text": "その事実がある時点で、\n許すことはできないわ。"},
        { "location": "212/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>8月某日　 8:43 PM</color>\n合宿中、みやびの実家でのこと"}
    ]
}
