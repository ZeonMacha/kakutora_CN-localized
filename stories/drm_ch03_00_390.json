    "entry":
    [
        { "location": "156/SCENARIO", "narrator": "", "text": "390_身代わりの恋"},
        { "location": "181/TALK"    , "narrator": "ガブリエラ", "text": "何の約束もしませんでした"},
        { "location": "182/TALK"    , "narrator": "ガブリエラ", "text": "何の贈り物もありませんでした"},
        { "location": "183/TALK"    , "narrator": "ガブリエラ", "text": "そういえば、そもそも何も知りませんでした"},
        { "location": "185/TALK"    , "narrator": "ガブリエラ", "text": "それは全て勘違いだったのでしょう"},
        { "location": "187/SEL"     , "narrator": "", "text": "元気？"},
        { "location": "188/SEL"     , "narrator": "", "text": "話を聞こうか？"},
        { "location": "189/ACT"     , "narrator": "", "text": "元気？"},
        { "location": "190/ACT"     , "narrator": "", "text": "話を聞こうか？"},
        { "location": "193/TALK"    , "narrator": "ガブリエラ", "text": "$handle$は優しいのね"},
        { "location": "195/SEL"     , "narrator": "", "text": "そうかな"},
        { "location": "196/SEL"     , "narrator": "", "text": "そうでもないよ"},
        { "location": "197/ACT"     , "narrator": "", "text": "そうかな"},
        { "location": "198/ACT"     , "narrator": "", "text": "そうでもないよ"},
        { "location": "200/TALK"    , "narrator": "ガブリエラ", "text": "私には"},
        { "location": "201/TALK"    , "narrator": "ガブリエラ", "text": "$handle$がいるからいいわ"},
        { "location": "203/SEL"     , "narrator": "", "text": "そりゃどうも"},
        { "location": "204/SEL"     , "narrator": "", "text": "何の話？"},
        { "location": "205/SEL"     , "narrator": "", "text": "展開早すぎない？"},
        { "location": "206/ACT"     , "narrator": "", "text": "そりゃどうも"},
        { "location": "207/TALK"    , "narrator": "ガブリエラ", "text": "適当すぎるお返事じゃないこと？"},
        { "location": "209/TALK"    , "narrator": "ガブリエラ", "text": "感心しないわ"},
        { "location": "210/ACT"     , "narrator": "", "text": "何の話？"},
        { "location": "211/TALK"    , "narrator": "ガブリエラ", "text": "そのままのお話よ"},
        { "location": "212/TALK"    , "narrator": "ガブリエラ", "text": "わからないかしら？"},
        { "location": "213/ACT"     , "narrator": "", "text": "展開早すぎない？"},
        { "location": "215/TALK"    , "narrator": "ガブリエラ", "text": "展開って？"},
        { "location": "216/TALK"    , "narrator": "ガブリエラ", "text": "$handle$とはこれまでもずっとお話していてよ？"},
        { "location": "218/TALK"    , "narrator": "ガブリエラ", "text": "私思ったの"},
        { "location": "219/TALK"    , "narrator": "ガブリエラ", "text": "$handle$がいれば平気だって"},
        { "location": "222/TALK"    , "narrator": "ガブリエラ", "text": "嬉しいでしょう？"},
        { "location": "225/SEL"     , "narrator": "", "text": "嬉しいよ"},
        { "location": "226/SEL"     , "narrator": "", "text": "そんなわけないだろ"},
        { "location": "227/ACT"     , "narrator": "", "text": "嬉しいよ"},
        { "location": "228/TALK"    , "narrator": "ガブリエラ", "text": "そうよね？"},
        { "location": "229/TALK"    , "narrator": "ガブリエラ", "text": "当然よね"},
        { "location": "230/ACT"     , "narrator": "", "text": "そんなわけないだろ"},
        { "location": "231/TALK"    , "narrator": "ガブリエラ", "text": "あら"},
        { "location": "232/TALK"    , "narrator": "ガブリエラ", "text": "何でそんな意地を張るのかしら？"},
        { "location": "234/TALK"    , "narrator": "ガブリエラ", "text": "貴方ずっと私のこと気にしていたわよね"},
        { "location": "235/TALK"    , "narrator": "ガブリエラ", "text": "だから付き合ってあげてもいいわよ"},
        { "location": "236/TALK"    , "narrator": "ガブリエラ", "text": "感謝しなさいよね"},
        { "location": "238/SEL"     , "narrator": "", "text": "ふざけんな"},
        { "location": "239/SEL"     , "narrator": "", "text": "ヒカルのことはいいの？"},
        { "location": "240/ACT"     , "narrator": "", "text": "ふざけんな"},
        { "location": "241/TALK"    , "narrator": "ガブリエラ", "text": "ふざけてなんかいないわ"},
        { "location": "242/TALK"    , "narrator": "ガブリエラ", "text": "大体"},
        { "location": "243/TALK"    , "narrator": "ガブリエラ", "text": "いつもいつも"},
        { "location": "244/TALK"    , "narrator": "ガブリエラ", "text": "ふざけてばっかりいるのはそっちのほうじゃないの"},
        { "location": "245/TALK"    , "narrator": "ガブリエラ", "text": "それなのに"},
        { "location": "246/TALK"    , "narrator": "ガブリエラ", "text": "急にそんな言い方して"},
        { "location": "247/TALK"    , "narrator": "ガブリエラ", "text": "だいっきらい！！！！"},
        { "location": "257/ACT"     , "narrator": "", "text": "ヒカルのことはいいの？"},
        { "location": "268/TALK"    , "narrator": "ガブリエラ", "text": "それは"},
        { "location": "270/TALK"    , "narrator": "ガブリエラ", "text": "もう終わったことだから"},
        { "location": "273/SEL"     , "narrator": "", "text": "だからって……"},
        { "location": "274/SEL"     , "narrator": "", "text": "ならいいんだけど"},
        { "location": "275/ACT"     , "narrator": "", "text": "だからって……"},
        { "location": "276/TALK"    , "narrator": "ガブリエラ", "text": "いいったらいいの！"},
        { "location": "277/TALK"    , "narrator": "ガブリエラ", "text": "この私が付き合ってあげてもいいって言っているのよ？"},
        { "location": "278/TALK"    , "narrator": "ガブリエラ", "text": "わかってるのかしら？"},
        { "location": "279/ACT"     , "narrator": "", "text": "ならいいんだけど"},
        { "location": "280/TALK"    , "narrator": "ガブリエラ", "text": "なにその適当すぎるお返事は！"},
        { "location": "281/TALK"    , "narrator": "ガブリエラ", "text": "もっとちゃんとお姫様扱いしなさいよね！"},
        { "location": "282/TALK"    , "narrator": "ガブリエラ", "text": "本当にもう！！"},
        { "location": "284/TALK"    , "narrator": "ガブリエラ", "text": "そういうことだから"},
        { "location": "285/TALK"    , "narrator": "ガブリエラ", "text": "わかったわね？"},
        { "location": "286/SEL"     , "narrator": "", "text": "遠慮します"},
        { "location": "290/ACT"     , "narrator": "", "text": "遠慮します"},
        { "location": "291/TALK"    , "narrator": "ガブリエラ", "text": "えっ"},
        { "location": "293/TALK"    , "narrator": "ガブリエラ", "text": "なんなのよそれ"},
        { "location": "295/TALK"    , "narrator": "ガブリエラ", "text": "ああ"},
        { "location": "296/TALK"    , "narrator": "ガブリエラ", "text": "そうなのね"},
        { "location": "297/TALK"    , "narrator": "ガブリエラ", "text": "嬉しくないのね"},
        { "location": "298/TALK"    , "narrator": "ガブリエラ", "text": "じゃあもういいわよ！！"},
        { "location": "299/TALK"    , "narrator": "ガブリエラ", "text": "知らないんだから！！！！！！"},
        { "location": "302/TALK"    , "narrator": "ガブリエラ", "text": "$handle$のばか！"},
        { "location": "263/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>900pt.</b></color></size>\nアップしました！"}
    ]
}
