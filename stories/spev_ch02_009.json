{
    "dir": "chap00/daydra/spev_ch02_009.js",
    "type": "",
    "info": {
        "story_id": "2009",
        "cid": "",
        "title": "スペシャルエピソード",
        "sub_title": "海辺の大決戦"
    },
    "entry":
    [
        { "location": "32/TALK" , "narrator": "透明アーヤ", "text": "ほら、みんな。\n早く行くわよ。"},
        { "location": "33/TALK" , "narrator": "透明つばめ", "text": "あ、アーヤさん、\n早過ぎますよぉ。"},
        { "location": "35/TALK" , "narrator": "透明神楽", "text": "アーヤさんが\nこんなにはしゃいでる姿、\n初めて見ました。"},
        { "location": "36/TALK" , "narrator": "透明ガブリエラ", "text": "そんなに\n海が好きだったの？"},
        { "location": "37/TALK" , "narrator": "透明アーヤ", "text": "嫌いじゃないわ。"},
        { "location": "38/TALK" , "narrator": "透明アーヤ", "text": "でも、他の人がまったく\nいない砂浜なのよ？\n楽しくならない？"},
        { "location": "39/TALK" , "narrator": "透明ガブリエラ", "text": "それにしたって、\nちょっとはしゃぎ過ぎだと\n思うけど…。"},
        { "location": "40/TALK" , "narrator": "透明ガブリエラ", "text": "$handle$は\nどう思う？"},
        { "location": "41/SEL"  , "narrator": "（選択肢）", "text": "はしゃいでると思う"},
        { "location": "42/SEL"  , "narrator": "（選択肢）", "text": "$me$も一緒に遊びたいよ"},
        { "location": "43/ACT"  , "narrator": "", "text": "はしゃいでると思う"},
        { "location": "46/TALK" , "narrator": "透明ガブリエラ", "text": "ほら、見なさいよ。\n$handle$にまで\n言われてるわよ？"},
        { "location": "47/TALK" , "narrator": "透明アーヤ", "text": "まったく…、\n$handle$まで\nそんなこと言って…。"},
        { "location": "48/ACT"  , "narrator": "", "text": "$me$も一緒に遊びたいよ"},
        { "location": "50/TALK" , "narrator": "透明アーヤ", "text": "一緒に遊べたら、\n私も楽しいんだけど…。"},
        { "location": "51/TALK" , "narrator": "透明神楽", "text": "$handle$さんと\n遊べたら、\n何がしたいですか？"},
        { "location": "53/TALK" , "narrator": "透明アーヤ", "text": "うーん…考えてみると、\nこれをして遊びたい、\nってものはないかも。"},
        { "location": "54/TALK" , "narrator": "透明アーヤ", "text": "でも、静かなところで\nのんびりしながら、\n色々話をしたいわ。"},
        { "location": "56/TALK" , "narrator": "透明ガブリエラ", "text": "な、なにそれ？\n二人きりでなんて\n認めないから！"},
        { "location": "58/TALK" , "narrator": "透明アーヤ", "text": "いや、別にギャヴィに\n認めてもらう必要は\nないんだけど…。"},
        { "location": "61/TALK" , "narrator": "透明アーヤ", "text": "大体、今日は訓練の無い、\n自由に遊べる日なのよ？"},
        { "location": "62/TALK" , "narrator": "透明アーヤ", "text": "訓練は訓練、遊びは遊び。\nメリハリを付けるのは\n大切なことよ。"},
        { "location": "63/SEL"  , "narrator": "（選択肢）", "text": "さすがアーヤ、いいこと言う"},
        { "location": "64/SEL"  , "narrator": "（選択肢）", "text": "ならデートしようよ"},
        { "location": "65/ACT"  , "narrator": "", "text": "さすがアーヤ、いいこと言う"},
        { "location": "67/TALK" , "narrator": "透明アーヤ", "text": "$handle$も\nそう思うでしょ？"},
        { "location": "68/TALK" , "narrator": "透明アーヤ", "text": "そういうわけだから…。"},
        { "location": "69/ACT"  , "narrator": "", "text": "ならデートしようよ"},
        { "location": "72/TALK" , "narrator": "透明アーヤ", "text": "えっ！？"},
        { "location": "73/TALK" , "narrator": "透明神楽", "text": "あらら…、\n$handle$さんって\n大胆なんですね。"},
        { "location": "74/TALK" , "narrator": "透明アーヤ", "text": "ちょ、ちょっと、\n$handle$！\nみんなの前よ…？"},
        { "location": "75/SEL"  , "narrator": "（選択肢）", "text": "だって、せっかくのお休みだし…"},
        { "location": "76/SEL"  , "narrator": "（選択肢）", "text": "$me$よりみんなが大切？"},
        { "location": "77/ACT"  , "narrator": "", "text": "だって、せっかくのお休みだし"},
        { "location": "78/TALK" , "narrator": "透明アーヤ", "text": "でも、それにしたって\nいきなり過ぎだし…。"},
        { "location": "79/TALK" , "narrator": "透明アーヤ", "text": "それに、誘ってくれるなら\n水着になる前だったら\nよかったのに…。"},
        { "location": "80/TALK" , "narrator": "透明つばめ", "text": "ここでデートすれば\nいいんじゃないですか？"},
        { "location": "81/TALK" , "narrator": "透明アーヤ", "text": "む、無理無理！\nみんな見てるでしょ！？"},
        { "location": "82/TALK" , "narrator": "透明神楽", "text": "じゃあ、私たちは\n退散した方がいいんじゃ\nないですか？"},
        { "location": "84/TALK" , "narrator": "透明神楽", "text": "私たちがいたら、\nデートの邪魔になって\nしまいそうですし。"},
        { "location": "85/TALK" , "narrator": "透明ガブリエラ", "text": "そうねぇ…。\n$handle$は\nどうしてほしい？"},
        { "location": "86/SEL"  , "narrator": "（選択肢）", "text": "そうしてもらえたら最高"},
        { "location": "87/SEL"  , "narrator": "（選択肢）", "text": "いや、見せびらかしたい！"},
        { "location": "88/ACT"  , "narrator": "", "text": "そうしてもらえたら最高"},
        { "location": "90/TALK" , "narrator": "透明アーヤ", "text": "ま、まあ、確かにそれは\n最高かもしれないけど…。"},
        { "location": "91/TALK" , "narrator": "透明アーヤ", "text": "でも、やっぱり今日は\nデート無し！！"},
        { "location": "92/TALK" , "narrator": "透明アーヤ", "text": "なんか、行き当たり\nばったりな感じだし。"},
        { "location": "93/TALK" , "narrator": "透明アーヤ", "text": "ちゃんと計画立てた\nデートじゃないと、\nロマンチックじゃないわ。"},
        { "location": "94/TALK" , "narrator": "透明つばめ", "text": "ろ、ロマンチック…？"},
        { "location": "95/TALK" , "narrator": "透明神楽", "text": "あ、アーヤさんって、\nそういうの期待する人\nだったんですね…？"},
        { "location": "97/TALK" , "narrator": "透明ガブリエラ", "text": "普段はそんなの\n全く気にしないような\n性格なのに。"},
        { "location": "98/TALK" , "narrator": "透明アーヤ", "text": "そ、そんなことより！"},
        { "location": "99/ACT"  , "narrator": "", "text": "いや、見せびらかしたい！"},
        { "location": "100/TALK", "narrator": "透明アーヤ", "text": "私とのデートを見世物に\nしようとしないで！"},
        { "location": "101/TALK", "narrator": "透明ガブリエラ", "text": "怒られて当然ね。"},
        { "location": "102/TALK", "narrator": "透明つばめ", "text": "でも、アーヤさん達が\nどんなデートをするのか、\n見てみたかったなぁ…。"},
        { "location": "103/TALK", "narrator": "透明アーヤ", "text": "そんなことより！"},
        { "location": "105/ACT" , "narrator": "", "text": "$me$よりみんなが大切？"},
        { "location": "106/TALK", "narrator": "透明ガブリエラ", "text": "それはあんたが言っちゃ\nダメでしょ！？"},
        { "location": "108/TALK", "narrator": "透明アーヤ", "text": "う～ん…みんなと\n$handle$は\n違うから…。"},
        { "location": "109/TALK", "narrator": "透明アーヤ", "text": "ちょっと、どっちの方が\n大切かは決められないわ。"},
        { "location": "110/TALK", "narrator": "透明アーヤ", "text": "でも…。"},
        { "location": "111/TALK", "narrator": "透明神楽", "text": "…でも？"},
        { "location": "113/TALK", "narrator": "透明アーヤ", "text": "…ふふっ、なんでもない。"},
        { "location": "114/TALK", "narrator": "透明つばめ", "text": "アーヤさん、\n$handle$さんを\n見て赤くなってるような？"},
        { "location": "115/TALK", "narrator": "透明ガブリエラ", "text": "…もしかして、あたし達に\n見せつけてない？"},
        { "location": "117/TALK", "narrator": "透明アーヤ", "text": "ち、違うから！\nそれより…。"},
        { "location": "119/TALK", "narrator": "透明アーヤ", "text": "こんなことしてても\n時間を無駄にしてる\nだけなんだし…。"},
        { "location": "122/TALK", "narrator": "透明アーヤ", "text": "せっかくの海を\n楽しむとしましょ。\nそれっ！"},
        { "location": "128/TALK", "narrator": "透明神楽", "text": "きゃっ！？"},
        { "location": "129/TALK", "narrator": "透明つばめ", "text": "冷たっ！？"},
        { "location": "131/TALK", "narrator": "透明ガブリエラ", "text": "ちょ、アーヤ！\nやったわね！？"},
        { "location": "132/TALK", "narrator": "透明神楽", "text": "つばめさん、\nこっちも応戦しましょう！"},
        { "location": "133/TALK", "narrator": "透明つばめ", "text": "うん。\nえーいっ！"},
        { "location": "138/TALK", "narrator": "透明アーヤ", "text": "冷たっ！？"},
        { "location": "139/TALK", "narrator": "透明神楽", "text": "参ったって言うまで\nやめません！"},
        { "location": "140/TALK", "narrator": "透明神楽", "text": "つばめさんも、\n手を止めないでください。"},
        { "location": "142/TALK", "narrator": "透明つばめ", "text": "早く参ったって言わないと\nびしょ濡れになっちゃい\nますよ。"},
        { "location": "146/TALK", "narrator": "透明アーヤ", "text": "ぎゃ、ギャヴィ！\nお願い、助けて！"},
        { "location": "148/TALK", "narrator": "透明ガブリエラ", "text": "はぁ…仕方ないわね。"},
        { "location": "149/TALK", "narrator": "透明神楽", "text": "ちょ、ガブちゃん！\nアーヤさん側に\nつくんですか？"},
        { "location": "150/TALK", "narrator": "透明ガブリエラ", "text": "当然。\n先輩チームの実力、\n見せてやるわ！"},
        { "location": "154/TALK", "narrator": "透明つばめ", "text": "きゃーっ！！\nが、ガブちゃん、\n激し過ぎるよーっ！！"},
        { "location": "155/TALK", "narrator": "透明ガブリエラ", "text": "アーヤ、\n一気に攻めるわよ！"},
        { "location": "157/TALK", "narrator": "透明アーヤ", "text": "了解、それーっ！！"},
        { "location": "161/TALK", "narrator": "透明神楽", "text": "わ、わかりました！\n降参、参りました！\n私達の負けですーっ！"},
        { "location": "163/TALK", "narrator": "透明つばめ", "text": "うーっ、入ったばかりで\nびしょ濡れだよぉ…。"},
        { "location": "164/TALK", "narrator": "透明ガブリエラ", "text": "あはは、先輩組に\n勝とうだなんて\n十年早いわ。"},
        { "location": "165/TALK", "narrator": "透明アーヤ", "text": "ふふっ…。"},
        { "location": "166/SEL" , "narrator": "（選択肢）", "text": "お休み楽しんでね"},
        { "location": "167/ACT" , "narrator": "", "text": "お休み楽しんでね"},
        { "location": "170/TALK", "narrator": "透明アーヤ", "text": "うん…。\nでも、ごめんなさい。"},
        { "location": "171/TALK", "narrator": "透明アーヤ", "text": "$handle$のこと\nもっと相手してあげられ\nなくて…。"},
        { "location": "172/TALK", "narrator": "透明アーヤ", "text": "…今度、二人だけで\nいられるような場所に\n行ったときにでも…。"},
        { "location": "174/TALK", "narrator": "透明アーヤ", "text": "ゆっくりデートしましょ。"}
    ]
}
