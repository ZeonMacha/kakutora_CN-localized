        { "location": "5419/SCENARIO", "narrator": "", "text": "ささやかな"},
        { "location": "5444/TALK"    , "narrator": "神楽", "text": "状況が許すなら"},
        { "location": "5445/TALK"    , "narrator": "神楽", "text": "小鳥とか飼ってみたいなーって思ったり"},
        { "location": "5447/SEL"     , "narrator": "", "text": "世話するの大変だもんね"},
        { "location": "5448/SEL"     , "narrator": "", "text": "そんなこと言わないで飼えば？"},
        { "location": "5449/SEL"     , "narrator": "", "text": "$me$は神楽に飼われたい"},
        { "location": "5450/ACT"     , "narrator": "", "text": "世話するの大変だもんね"},
        { "location": "5451/TALK"    , "narrator": "神楽", "text": "それそれ"},
        { "location": "5453/TALK"    , "narrator": "神楽", "text": "生物だからさー"},
        { "location": "5454/ACT"     , "narrator": "", "text": "そんなこと言わないで飼えば？"},
        { "location": "5455/TALK"    , "narrator": "神楽", "text": "いや無理ｗｗｗ"},
        { "location": "5456/TALK"    , "narrator": "神楽", "text": "無理なことには手を出さない勇気をほめろ！"},
        { "location": "5457/ACT"     , "narrator": "", "text": "$me$は神楽に飼われたい"},
        { "location": "5459/TALK"    , "narrator": "神楽", "text": "そうなのかー"},
        { "location": "5460/TALK"    , "narrator": "神楽", "text": "じゃあ$handlek$のスペースをぴょんこの部屋に設えるぴょん"},
        { "location": "5462/SEL"     , "narrator": "", "text": "$me$のための鳥かごか…"},
        { "location": "5463/SEL"     , "narrator": "", "text": "いや寝袋持参するんで！"},
        { "location": "5464/SEL"     , "narrator": "", "text": "どうせなら新居を構えよう"},
        { "location": "5465/ACT"     , "narrator": "", "text": "$me$のための鳥かごか…"},
        { "location": "5466/TALK"    , "narrator": "神楽", "text": "ヤバスｗｗｗ"},
        { "location": "5468/TALK"    , "narrator": "神楽", "text": "籠の鳥なんだね$handlek$"},
        { "location": "5469/TALK"    , "narrator": "神楽", "text": "折れた翼と体に巻き付いた鎖も用意しとくね☆彡"},
        { "location": "5470/ACT"     , "narrator": "", "text": "いや寝袋持参するんで！"},
        { "location": "5471/TALK"    , "narrator": "神楽", "text": "そっかそっか"},
        { "location": "5472/TALK"    , "narrator": "神楽", "text": "存分にサバイブしてね！"},
        { "location": "5473/TALK"    , "narrator": "神楽", "text": "でも室内での煮炊きは禁止でーす！"},
        { "location": "5474/TALK"    , "narrator": "神楽", "text": "よろしくー"},
        { "location": "5475/ACT"     , "narrator": "", "text": "どうせなら新居を構えよう"},
        { "location": "5476/TALK"    , "narrator": "神楽", "text": "魅惑的な響き♪"},
        { "location": "5477/TALK"    , "narrator": "神楽", "text": "じゃあお城を建ててください"},
        { "location": "5478/TALK"    , "narrator": "神楽", "text": "フランス建築の！"}
