    "entry":
    [
        { "location": "27/TALK" , "narrator": "透明アーヤ", "text": "へえ…私が着ると、\nこんな感じになるのね…。"},
        { "location": "28/TALK" , "narrator": "透明アーヤ", "text": "…………。"},
        { "location": "29/TALK" , "narrator": "透明アーヤ", "text": "う～ん…。"},
        { "location": "30/TALK" , "narrator": "透明アーヤ", "text": "これ、どうなのかしら？"},
        { "location": "32/TALK" , "narrator": "アーヤ", "text": "聞きたいんだけど"},
        { "location": "33/TALK" , "narrator": "アーヤ", "text": "どうかしら？(￣Д￣ )"},
        { "location": "34/TALK" , "narrator": "アーヤ", "text": "ウエディングドレス"},
        { "location": "35/TALK" , "narrator": "アーヤ", "text": "ちゃんと着れてる？(>_<)"},
        { "location": "36/SEL"  , "narrator": "（選択肢）", "text": "とっても綺麗だよ"},
        { "location": "37/SEL"  , "narrator": "（選択肢）", "text": "どういう状況！？"},
        { "location": "38/SEL"  , "narrator": "（選択肢）", "text": "結婚しないで！"},
        { "location": "39/ACT"  , "narrator": "", "text": "とっても綺麗だよ"},
        { "location": "40/TALK" , "narrator": "アーヤ", "text": "よかった(^^"},
        { "location": "41/TALK" , "narrator": "アーヤ", "text": "自分じゃわからなくて"},
        { "location": "42/TALK" , "narrator": "アーヤ", "text": "着たことなかったから(￣∇￣*)ゞ"},
        { "location": "43/ACT"  , "narrator": "", "text": "どういう状況！？"},
        { "location": "44/TALK" , "narrator": "アーヤ", "text": "説明してなかった？（￣ー￣？）"},
        { "location": "46/TALK" , "narrator": "アーヤ", "text": "ブライダルフェアに来てて"},
        { "location": "47/TALK" , "narrator": "アーヤ", "text": "ちょっと試着しただけ(*^.^*)"},
        { "location": "48/TALK" , "narrator": "アーヤ", "text": "ビックリさせた"},
        { "location": "49/TALK" , "narrator": "アーヤ", "text": "ごめんなさい(・・。)ゞ"},
        { "location": "50/ACT"  , "narrator": "", "text": "結婚しないで！"},
        { "location": "51/TALK" , "narrator": "アーヤ", "text": "大丈夫"},
        { "location": "52/TALK" , "narrator": "アーヤ", "text": "しないから(￣Д￣ )"},
        { "location": "53/TALK" , "narrator": "アーヤ", "text": "試着してるだけ(;^_^A"},
        { "location": "55/TALK" , "narrator": "アーヤ", "text": "でも不思議(￣∇￣)"},
        { "location": "56/TALK" , "narrator": "アーヤ", "text": "本当に結婚するわけじゃないのに"},
        { "location": "58/TALK" , "narrator": "アーヤ", "text": "なんだか"},
        { "location": "60/TALK" , "narrator": "アーヤ", "text": "これを着てると"},
        { "location": "61/TALK" , "narrator": "アーヤ", "text": "ドキドキして(｡-_-｡)"},
        { "location": "63/TALK" , "narrator": "アーヤ", "text": "本番だと"},
        { "location": "64/TALK" , "narrator": "アーヤ", "text": "もっとスゴいってこと？(-.-;)"},
        { "location": "65/SEL"  , "narrator": "（選択肢）", "text": "意外と冷静かもしれないよ"},
        { "location": "66/SEL"  , "narrator": "（選択肢）", "text": "そうじゃなきゃダメだと思う"},
        { "location": "67/SEL"  , "narrator": "（選択肢）", "text": "大丈夫、隣についてるから"},
        { "location": "68/ACT"  , "narrator": "", "text": "意外と冷静かもしれないよ"},
        { "location": "69/TALK" , "narrator": "アーヤ", "text": "どうなのかしら？"},
        { "location": "70/TALK" , "narrator": "アーヤ", "text": "自信ない(-ω-;)"},
        { "location": "72/TALK" , "narrator": "アーヤ", "text": "頭真っ白になって"},
        { "location": "73/TALK" , "narrator": "アーヤ", "text": "動けなくなっちゃうかも(T_T)"},
        { "location": "74/SEL"  , "narrator": "（選択肢）", "text": "なるかな？"},
        { "location": "75/SEL"  , "narrator": "（選択肢）", "text": "$me$が助けるよ"},
        { "location": "76/ACT"  , "narrator": "", "text": "なるかな？"},
        { "location": "77/TALK" , "narrator": "アーヤ", "text": "学生結婚した友達が"},
        { "location": "78/TALK" , "narrator": "アーヤ", "text": "まさにそれだったから"},
        { "location": "79/TALK" , "narrator": "アーヤ", "text": "可能性はあるわ(>_<)"},
        { "location": "81/TALK" , "narrator": "アーヤ", "text": "リードしてくれる"},
        { "location": "82/TALK" , "narrator": "アーヤ", "text": "旦那さんだったらいいんだけど(*^^*)"},
        { "location": "83/ACT"  , "narrator": "", "text": "$me$が助けるよ"},
        { "location": "86/TALK" , "narrator": "アーヤ", "text": "嬉しいけど"},
        { "location": "87/TALK" , "narrator": "アーヤ", "text": "そこはやっぱり"},
        { "location": "88/TALK" , "narrator": "アーヤ", "text": "旦那さんに助けてほしいわ(*^.^*)"},
        { "location": "91/TALK" , "narrator": "アーヤ", "text": "それとも"},
        { "location": "92/TALK" , "narrator": "アーヤ", "text": "$handle$が旦那さんになる？(￣∇￣)"},
        { "location": "93/TALK" , "narrator": "アーヤ", "text": "なんてね(*^.^*)"},
        { "location": "95/ACT"  , "narrator": "", "text": "そうじゃなきゃダメだと思う"},
        { "location": "96/TALK" , "narrator": "アーヤ", "text": "そうよね"},
        { "location": "97/TALK" , "narrator": "アーヤ", "text": "一世一代のイベントだし(￣Д￣ )"},
        { "location": "98/TALK" , "narrator": "アーヤ", "text": "それくらいの方がいいかも"},
        { "location": "99/ACT"  , "narrator": "", "text": "大丈夫、隣についてるから"},
        { "location": "100/TALK", "narrator": "アーヤ", "text": "介添人ってこと？( ・_・)σﾞ"},
        { "location": "101/TALK", "narrator": "アーヤ", "text": "それとも"},
        { "location": "105/TALK", "narrator": "アーヤ", "text": "どっちかしら？"},
        { "location": "109/TALK", "narrator": "アーヤ", "text": "さてと"},
        { "location": "110/TALK", "narrator": "アーヤ", "text": "そろそろみんなが待ってるから"},
        { "location": "111/TALK", "narrator": "アーヤ", "text": "見せないといけないけど(｡-_-｡)"},
        { "location": "112/TALK", "narrator": "アーヤ", "text": "大丈夫かしら？(-ω-;)"},
        { "location": "113/TALK", "narrator": "アーヤ", "text": "本当"},
        { "location": "114/TALK", "narrator": "アーヤ", "text": "変じゃない？(´o｀；"},
        { "location": "115/SEL" , "narrator": "（選択肢）", "text": "ちょっと驚かれるかも"},
        { "location": "116/SEL" , "narrator": "（選択肢）", "text": "みんな見惚れちゃうよ"},
        { "location": "117/SEL" , "narrator": "（選択肢）", "text": "プロポーズされちゃうかも"},
        { "location": "118/ACT" , "narrator": "", "text": "ちょっと驚かれるかも"},
        { "location": "121/TALK", "narrator": "アーヤ", "text": "お世辞でも褒めてほしかった"},
        { "location": "122/TALK", "narrator": "アーヤ", "text": "不安になってきたかも(T_T)"},
        { "location": "123/TALK", "narrator": "アーヤ", "text": "でも"},
        { "location": "124/TALK", "narrator": "アーヤ", "text": "行ってくるわ(-ω-;)"},
        { "location": "125/ACT" , "narrator": "", "text": "みんな見惚れちゃうよ"},
        { "location": "126/TALK", "narrator": "アーヤ", "text": "ありがとう(^^"},
        { "location": "127/TALK", "narrator": "アーヤ", "text": "それじゃあ"},
        { "location": "128/TALK", "narrator": "アーヤ", "text": "見せてくるわ(^ε^)-☆!!"},
        { "location": "129/ACT" , "narrator": "", "text": "プロポーズされちゃうかも"},
        { "location": "130/TALK", "narrator": "アーヤ", "text": "それはちょっと困るかも(-ω-;)"},
        { "location": "131/TALK", "narrator": "アーヤ", "text": "でも"},
        { "location": "132/TALK", "narrator": "アーヤ", "text": "ちょっとだけ"},
        { "location": "133/TALK", "narrator": "アーヤ", "text": "ドキドキしちゃうかも(｡-_-｡)"},
        { "location": "135/TALK", "narrator": "アーヤ", "text": "なんてね(*^^*)"},
        { "location": "139/TALK", "narrator": "透明アーヤ", "text": "ふぅ…。"},
        { "location": "140/TALK", "narrator": "透明ガブリエラ", "text": "アーヤ、まだー？\nそろそろカーテン\n開けるわよー？"},
        { "location": "141/TALK", "narrator": "透明アーヤ", "text": "あ、うん。\nお願い。"},
        { "location": "145/TALK", "narrator": "透明ガブリエラ", "text": "っ！？"},
        { "location": "147/TALK", "narrator": "透明つばめ", "text": "わぁ！！\nアーヤさん、\nとっても素敵です！"},
        { "location": "149/TALK", "narrator": "透明アーヤ", "text": "あはは…そう？"},
        { "location": "150/TALK", "narrator": "透明アーヤ", "text": "初めて着たから、\n自分じゃ似合ってるか\nわからなくて…。"},
        { "location": "152/TALK", "narrator": "透明みやび", "text": "何言うてるが？\n文句なしの\nパーフェクトぞね。"},
        { "location": "153/TALK", "narrator": "透明みやび", "text": "これなら、いつでも\nお嫁に行けるがよ。"},
        { "location": "154/TALK", "narrator": "透明神楽", "text": "アーヤさん、\nこっち向いてください。"},
        { "location": "158/TALK", "narrator": "透明アーヤ", "text": "ちょっと\n恥ずかしいかも…。"},
        { "location": "159/TALK", "narrator": "透明ガブリエラ", "text": "…………。"},
        { "location": "160/TALK", "narrator": "透明アーヤ", "text": "ギャヴィ？"},
        { "location": "162/TALK", "narrator": "透明ガブリエラ", "text": "…あ、うん。\nし、幸せになってね…。"},
        { "location": "163/TALK", "narrator": "透明アーヤ", "text": "はい？"},
        { "location": "164/TALK", "narrator": "透明ガブリエラ", "text": "あっ！！"},
        { "location": "165/TALK", "narrator": "透明みやび", "text": "アーヤがあまりにも\n本物っぽいきね。"},
        { "location": "167/TALK", "narrator": "透明みやび", "text": "まっこと結婚するん\n思うたんやろ？"},
        { "location": "168/TALK", "narrator": "透明ガブリエラ", "text": "…………。"},
        { "location": "170/TALK", "narrator": "透明アーヤ", "text": "あはは。\n本当にお嫁に行ったり\nしないわよ。"},
        { "location": "172/TALK", "narrator": "透明ガブリエラ", "text": "わ、わかってるわよ！\nていうか、本当に結婚する\nとか思ってないし…。"},
        { "location": "173/TALK", "narrator": "透明アーヤ", "text": "大丈夫よ。\nまだ、もうしばらくは\n寮にいるから、ね？"},
        { "location": "174/TALK", "narrator": "透明ガブリエラ", "text": "…そんなの、\nわからないじゃん。"},
        { "location": "175/TALK", "narrator": "透明ガブリエラ", "text": "急に彼氏ができて、\n寿除隊する可能性だって\nあるでしょ？"},
        { "location": "176/TALK", "narrator": "透明アーヤ", "text": "あ、あのね…、\nそんなことするわけ\nないでしょ？"},
        { "location": "177/TALK", "narrator": "透明ガブリエラ", "text": "でも…。"},
        { "location": "178/TALK", "narrator": "透明みやび", "text": "なぁに、ガブちゃん。\nその心配は無用や。"},
        { "location": "180/TALK", "narrator": "透明みやび", "text": "アーヤがそう簡単に\n彼氏なんぞ作れるはず\nないちや。"},
        { "location": "182/TALK", "narrator": "透明アーヤ", "text": "ちょっと、みやび。\nそれってどういう意味よ？"},
        { "location": "183/TALK", "narrator": "透明みやび", "text": "そのまんまの意味ぞね。"},
        { "location": "184/TALK", "narrator": "透明つばめ", "text": "そんなことないですよ。"},
        { "location": "186/TALK", "narrator": "透明つばめ", "text": "アーヤさんは素敵だから、\nきっとすぐに恋人を\n作っちゃうと思います。"},
        { "location": "187/TALK", "narrator": "透明つばめ", "text": "ね？"},
        { "location": "189/TALK", "narrator": "透明アーヤ", "text": "ね？　って、\n同意を求められても\n困るんだけど…。"},
        { "location": "190/TALK", "narrator": "透明神楽", "text": "う～ん…アーヤさんが\nとっても素敵なのは\n間違いありません。"},
        { "location": "191/TALK", "narrator": "透明神楽", "text": "でも、恋愛に対して\n積極性がないのが\n問題なんですよね…。"},
        { "location": "192/TALK", "narrator": "透明みやび", "text": "うむ、婚期を逃しちゅう\n一番の原因や。"},
        { "location": "193/TALK", "narrator": "透明アーヤ", "text": "いい加減にして！"},
        { "location": "194/TALK", "narrator": "透明アーヤ", "text": "まったく、本人の前で\n言いたい放題言って…。"},
        { "location": "195/TALK", "narrator": "透明みやび", "text": "あんまし怒ると、\nウエディングドレスが\n台無しやぞ？"},
        { "location": "197/TALK", "narrator": "透明アーヤ", "text": "怒らせてるのは\nあなた達でしょ？\nまったく…。"},
        { "location": "198/TALK", "narrator": "透明ガブリエラ", "text": "…………。"},
        { "location": "199/TALK", "narrator": "透明ガブリエラ", "text": "ウエディングドレスで\n怒ってるアーヤも、\nちょっと可愛いかも…。"}
    ]
}
