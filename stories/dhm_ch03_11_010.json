        "title": "Extra007 ヒメゴトチャット",
        "sub_title": "季節外れのサンタを希望"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "008_季節外れのサンタを希望"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "お星さまにお願いします"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "季節外れではありますが"},
        { "location": "34/TALK"   , "narrator": "ガブリエラ", "text": "サンタクロースをこの場所に呼んでいただけないでしょうか？"},
        { "location": "36/SEL"    , "narrator": "", "text": "$me$のことかな"},
        { "location": "37/SEL"    , "narrator": "", "text": "ゴメン無理"},
        { "location": "38/SEL"    , "narrator": "", "text": "なんで？"},
        { "location": "39/ACT"    , "narrator": "", "text": "$me$のことかな"},
        { "location": "40/TALK"   , "narrator": "ガブリエラ", "text": "サンタクロースに"},
        { "location": "41/TALK"   , "narrator": "ガブリエラ", "text": "なってくれる？"},
        { "location": "42/ACT"    , "narrator": "", "text": "ゴメン無理"},
        { "location": "43/TALK"   , "narrator": "ガブリエラ", "text": "冷たいのね！"},
        { "location": "44/ACT"    , "narrator": "", "text": "なんで？"},
        { "location": "45/TALK"   , "narrator": "ガブリエラ", "text": "ちょっと困ったことになってるの"},
        { "location": "47/TALK"   , "narrator": "ガブリエラ", "text": "もう飾らない小物をゴミ袋に入れたら"},
        { "location": "48/TALK"   , "narrator": "ガブリエラ", "text": "袋がパンパンになってしまったのよ"},
        { "location": "50/SEL"    , "narrator": "", "text": "そんなゴミだらけだったの？"},
        { "location": "51/SEL"    , "narrator": "", "text": "どこで集めてきたの？"},
        { "location": "52/SEL"    , "narrator": "", "text": "修理すればいいのに"},
        { "location": "53/ACT"    , "narrator": "", "text": "そんなゴミだらけだったの？"},
        { "location": "54/TALK"   , "narrator": "ガブリエラ", "text": "失礼ね！"},
        { "location": "55/TALK"   , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "56/TALK"   , "narrator": "ガブリエラ", "text": "結局そういうことなのかしら"},
        { "location": "57/TALK"   , "narrator": "ガブリエラ", "text": "これからは気を付けるわ"},
        { "location": "58/ACT"    , "narrator": "", "text": "どこで集めてきたの？"},
        { "location": "60/TALK"   , "narrator": "ガブリエラ", "text": "どこでって。。。"},
        { "location": "61/TALK"   , "narrator": "ガブリエラ", "text": "色々よ"},
        { "location": "64/TALK"   , "narrator": "ガブリエラ", "text": "もらったり"},
        { "location": "65/TALK"   , "narrator": "ガブリエラ", "text": "拾ったりしたの"},
        { "location": "67/TALK"   , "narrator": "ガブリエラ", "text": "でもそういうのは"},
        { "location": "68/TALK"   , "narrator": "ガブリエラ", "text": "もうやめるわ"},
        { "location": "69/ACT"    , "narrator": "", "text": "修理すればいいのに"},
        { "location": "71/TALK"   , "narrator": "ガブリエラ", "text": "あら"},
        { "location": "72/TALK"   , "narrator": "ガブリエラ", "text": "マルザンナはいいこね"},
        { "location": "73/TALK"   , "narrator": "ガブリエラ", "text": "でもね。。。"},
        { "location": "74/TALK"   , "narrator": "ガブリエラ", "text": "元はどういうものだったかわからないものも多いの"},
        { "location": "75/TALK"   , "narrator": "ガブリエラ", "text": "だから"},
        { "location": "76/TALK"   , "narrator": "ガブリエラ", "text": "今回は処分することにするわ"},
        { "location": "77/TALK"   , "narrator": "ガブリエラ", "text": "聞いてくれてありがとう"}
    ]
}
