    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "530_マリッジ以前ブルーブラック"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "今日は当番を代わってもらったぞね"},
        { "location": "33/TALK"   , "narrator": "みやび", "text": "モノクロの恋愛映画に付き合う気にならんかった"},
        { "location": "35/SEL"    , "narrator": "", "text": "観る必要はないんじゃない"},
        { "location": "36/SEL"    , "narrator": "", "text": "疲れてるのかな？"},
        { "location": "37/ACT"    , "narrator": "", "text": "観る必要はないんじゃない"},
        { "location": "38/TALK"   , "narrator": "みやび", "text": "そうか"},
        { "location": "39/TALK"   , "narrator": "みやび", "text": "その手があったな"},
        { "location": "40/ACT"    , "narrator": "", "text": "疲れてるのかな？"},
        { "location": "41/TALK"   , "narrator": "みやび", "text": "確かに"},
        { "location": "43/TALK"   , "narrator": "みやび", "text": "そうかもしれん"},
        { "location": "45/TALK"   , "narrator": "みやび", "text": "なぜみな人の恋愛を知りたがるのだ"},
        { "location": "47/SEL"    , "narrator": "", "text": "出歯亀"},
        { "location": "48/SEL"    , "narrator": "", "text": "参考にしたいんじゃない"},
        { "location": "49/SEL"    , "narrator": "", "text": "幸せになりたいからでしょ"},
        { "location": "50/ACT"    , "narrator": "", "text": "出歯亀"},
        { "location": "51/TALK"   , "narrator": "みやび", "text": "これはまた"},
        { "location": "52/TALK"   , "narrator": "みやび", "text": "古い言い方じゃの"},
        { "location": "53/TALK"   , "narrator": "みやび", "text": "あと"},
        { "location": "54/TALK"   , "narrator": "みやび", "text": "微妙に使いどころを間違っとる気がするぞ"},
        { "location": "55/ACT"    , "narrator": "", "text": "参考にしたいんじゃない"},
        { "location": "56/TALK"   , "narrator": "みやび", "text": "それは"},
        { "location": "57/TALK"   , "narrator": "みやび", "text": "自分の人生に必ずそういうことが起こると"},
        { "location": "58/TALK"   , "narrator": "みやび", "text": "信じているということだの"},
        { "location": "59/TALK"   , "narrator": "みやび", "text": "うちには"},
        { "location": "60/TALK"   , "narrator": "みやび", "text": "それが信じられぬ"},
        { "location": "61/ACT"    , "narrator": "", "text": "幸せになりたいからでしょ"},
        { "location": "72/TALK"   , "narrator": "みやび", "text": "幸せか"},
        { "location": "74/TALK"   , "narrator": "みやび", "text": "幸せな人生"},
        { "location": "75/TALK"   , "narrator": "みやび", "text": "幸せな結婚"},
        { "location": "77/SEL"    , "narrator": "", "text": "$me$の隣で"},
        { "location": "78/SEL"    , "narrator": "", "text": "$me$と歩んでほしい"},
        { "location": "79/ACT"    , "narrator": "", "text": "$me$の隣で"},
        { "location": "80/TALK"   , "narrator": "みやび", "text": "$handle$の"},
        { "location": "81/TALK"   , "narrator": "みやび", "text": "隣で"},
        { "location": "82/TALK"   , "narrator": "みやび", "text": "だと"},
        { "location": "83/ACT"    , "narrator": "", "text": "$me$と歩んでほしい"},
        { "location": "84/TALK"   , "narrator": "みやび", "text": "$handle$と"},
        { "location": "85/TALK"   , "narrator": "みやび", "text": "一緒に"},
        { "location": "86/TALK"   , "narrator": "みやび", "text": "だと"},
        { "location": "89/SEL"    , "narrator": "", "text": "前にも言ったけど"},
        { "location": "90/SEL"    , "narrator": "", "text": "$me$は本気だから"},
        { "location": "91/ACT"    , "narrator": "", "text": "前にも言ったけど"},
        { "location": "92/TALK"   , "narrator": "みやび", "text": "聞いておる"},
        { "location": "93/ACT"    , "narrator": "", "text": "$me$は本気だから"},
        { "location": "94/TALK"   , "narrator": "みやび", "text": "本気なのだな"},
        { "location": "96/TALK"   , "narrator": "みやび", "text": "嘘ついたら針千本くらい"},
        { "location": "97/TALK"   , "narrator": "みやび", "text": "本気なのかね"},
        { "location": "99/SEL"    , "narrator": "", "text": "かわいいこと言うね"},
        { "location": "100/SEL"   , "narrator": "", "text": "そのくらい本気だね"},
        { "location": "101/ACT"   , "narrator": "", "text": "かわいいこと言うね"},
        { "location": "102/TALK"  , "narrator": "みやび", "text": "子供の約束だの"},
        { "location": "104/TALK"  , "narrator": "みやび", "text": "こんな言い方だと"},
        { "location": "105/ACT"   , "narrator": "", "text": "そのくらい本気だね"},
        { "location": "106/TALK"  , "narrator": "みやび", "text": "なるほどな"},
        { "location": "107/TALK"  , "narrator": "みやび", "text": "針千本を用意しておこう"},
        { "location": "109/TALK"  , "narrator": "みやび", "text": "それにしても"},
        { "location": "110/TALK"  , "narrator": "みやび", "text": "人生とはその人一人が引き受けるものではないのか"},
        { "location": "112/SEL"   , "narrator": "", "text": "主役だけの映画はないでしょ"},
        { "location": "113/SEL"   , "narrator": "", "text": "彩りも必要でしょ"},
        { "location": "114/ACT"   , "narrator": "", "text": "主役だけの映画はないでしょ"},
        { "location": "115/TALK"  , "narrator": "みやび", "text": "確かに"},
        { "location": "116/TALK"  , "narrator": "みやび", "text": "しかし"},
        { "location": "117/TALK"  , "narrator": "みやび", "text": "一人芝居という演目はあるぞ"},
        { "location": "118/ACT"   , "narrator": "", "text": "彩りも必要でしょ"},
        { "location": "119/TALK"  , "narrator": "みやび", "text": "彩りか"},
        { "location": "120/TALK"  , "narrator": "みやび", "text": "人の人生に成り代わるわけではないということか"},
        { "location": "123/SEL"   , "narrator": "", "text": "それでも"},
        { "location": "124/ACT"   , "narrator": "", "text": "それでも"},
        { "location": "125/TALK"  , "narrator": "みやび", "text": "うむ"},
        { "location": "128/SEL"   , "narrator": "", "text": "$me$はみやびの側にいたいよ"},
        { "location": "129/SEL"   , "narrator": "", "text": "みやびと人生を刻みたいんだ"},
        { "location": "130/SEL"   , "narrator": "", "text": "好きな人を見てるのって幸せでしょ"},
        { "location": "131/ACT"   , "narrator": "", "text": "$me$はみやびの側にいたいよ"},
        { "location": "132/TALK"  , "narrator": "みやび", "text": "そうか"},
        { "location": "134/TALK"  , "narrator": "みやび", "text": "そうなのか"},
        { "location": "135/TALK"  , "narrator": "みやび", "text": "そういうものなのか"},
        { "location": "136/ACT"   , "narrator": "", "text": "みやびと人生を刻みたいんだ"},
        { "location": "137/TALK"  , "narrator": "みやび", "text": "それぞれの"},
        { "location": "138/TALK"  , "narrator": "みやび", "text": "人生があって"},
        { "location": "139/TALK"  , "narrator": "みやび", "text": "ということか"},
        { "location": "140/ACT"   , "narrator": "", "text": "好きな人を見てるのって幸せでしょ"},
        { "location": "141/TALK"  , "narrator": "みやび", "text": "見ているだけで"},
        { "location": "142/TALK"  , "narrator": "みやび", "text": "幸せなのか"},
        { "location": "143/TALK"  , "narrator": "みやび", "text": "好きな人なら"},
        { "location": "147/TALK"  , "narrator": "みやび", "text": "うちなりに"},
        { "location": "148/TALK"  , "narrator": "みやび", "text": "言葉にしてみた"},
        { "location": "151/TALK"  , "narrator": "ボイスメール", "text": "背中合わせの恋人"},
        { "location": "67/DIALOG" , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>1000pt.</b></color></size>\nアップしました！"},
        { "location": "163/DIALOG", "narrator": "Dialog_GETVoice", "text": "<color=green>【みやび】</color>のボイスメール\n<color=red>【背中合わせの恋人】</color>\nをゲットしました！"}
    ]
}
