        "title": "SideStory013 ストーリー",
        "sub_title": "FILE10.整理"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "東京編１０話"},
        { "location": "15/DIALOG" , "narrator": "", "text": "<color=green>9月6日　 4:12 PM</color>\nとある平日の放課後、付属学園図書室でのこと"},
        { "location": "24/TALK"   , "narrator": "雛", "text": "…床下のＰＣ？"},
        { "location": "26/TALK"   , "narrator": "繭", "text": "そう、劇場の床下に、\nみやび先輩が設置した\nサーバーが隠してあるの。"},
        { "location": "27/TALK"   , "narrator": "繭", "text": "今は電源が落ちてるけど、\nもしもその電源を付ける\nことに成功すれば…。"},
        { "location": "28/TALK"   , "narrator": "繭", "text": "そこから、管理庁の\nシステムを攻撃する\nことができる。"},
        { "location": "29/TALK"   , "narrator": "雛", "text": "えぇっ！\nそんなことできるの！？"},
        { "location": "30/TALK"   , "narrator": "繭", "text": "ええ…システムを狂わせる\nことができれば、管理庁も\n簡単に動けなくなるし…。"},
        { "location": "31/TALK"   , "narrator": "繭", "text": "みやび先輩達も、\n動きやすくなるはず。"},
        { "location": "32/TALK"   , "narrator": "雛", "text": "スゴいよ！\nなにその秘密兵器！？"},
        { "location": "33/TALK"   , "narrator": "雛", "text": "それさえあれば、\nもう怖いもんなしだね！"},
        { "location": "34/TALK"   , "narrator": "繭", "text": "だから、問題はそれを\nするためのサーバーの\n電源落ちてて…。"},
        { "location": "35/TALK"   , "narrator": "雛", "text": "大丈夫だよー！\nそれくらいだったら、\nあたしとヒカルくんで――"},
        { "location": "42/TALK"   , "narrator": "雛", "text": "あれ…どうしたんだろ？"},
        { "location": "43/TALK"   , "narrator": "繭", "text": "？"},
        { "location": "44/TALK"   , "narrator": "雛", "text": "ヒカルくんから…、\nカラオケボックスに集合、\nだって…。"},
        { "location": "45/TALK"   , "narrator": "繭", "text": "早速作戦会議？"},
        { "location": "49/TALK"   , "narrator": "雛", "text": "…違うと思う。\nまゆちんも連れてきて、\nって言ってるし…。"},
        { "location": "50/TALK"   , "narrator": "繭", "text": "…私が協力すること、\nヒカルはまだ知らないはず\nだけど？"},
        { "location": "51/TALK"   , "narrator": "雛", "text": "変だよね…。\nとにかく、行ってみよ。"},
        { "location": "69/TALK"   , "narrator": "雛", "text": "ごめーん。\n遅くなっちゃったー。"},
        { "location": "72/TALK"   , "narrator": "繭", "text": "…何か用事？"},
        { "location": "74/TALK"   , "narrator": "キリト", "text": "…おっす。"},
        { "location": "75/TALK"   , "narrator": "繭", "text": "…………。"},
        { "location": "76/TALK"   , "narrator": "繭", "text": "は？"},
        { "location": "77/TALK"   , "narrator": "雛", "text": "ど、どうしてキリトまで\nいるの！？"},
        { "location": "79/TALK"   , "narrator": "ヒカル", "text": "あはは…説明しますから、\nとりあえず落ち着いて…。"},
        { "location": "80/TALK"   , "narrator": "雛", "text": "っていうか、二人とも\nボロボロになってない？"},
        { "location": "81/TALK"   , "narrator": "キリト", "text": "そりゃな…通常攻撃隊の\n武器保管庫に忍び込んで\n来たんだからな…。"},
        { "location": "82/TALK"   , "narrator": "雛", "text": "えぇっ！？"},
        { "location": "83/TALK"   , "narrator": "ヒカル", "text": "危うくバレかけたけど、\nほら、この通り僕達の\n装備は持ち出せたよ。"},
        { "location": "84/TALK"   , "narrator": "キリト", "text": "なにするにせよ、\nそれ相応の装備は\n必要だと思ったからな。"},
        { "location": "88/TALK"   , "narrator": "繭", "text": "…どういうこと？\n説明して。"},
        { "location": "89/TALK"   , "narrator": "キリト", "text": "そりゃこっちのセリフだ。\nおい、繭！"},
        { "location": "90/TALK"   , "narrator": "キリト", "text": "おまえ、俺に内緒で\nひなこ達に協力しようと\nしただろ？"},
        { "location": "93/TALK"   , "narrator": "繭", "text": "…………。"},
        { "location": "94/TALK"   , "narrator": "キリト", "text": "やっぱりな。"},
        { "location": "97/TALK"   , "narrator": "繭", "text": "何も言ってない！"},
        { "location": "98/TALK"   , "narrator": "キリト", "text": "おまえの無言は\nイエスってことだろ？"},
        { "location": "99/TALK"   , "narrator": "キリト", "text": "昔っからそうだからな。"},
        { "location": "101/TALK"  , "narrator": "繭", "text": "…………。"},
        { "location": "102/TALK"  , "narrator": "キリト", "text": "てか、ひなこ。\nおまえもおまえだよ。"},
        { "location": "103/TALK"  , "narrator": "キリト", "text": "繭が協力してくれることに\nなったって、どうして俺に\n一言もねぇんだ？"},
        { "location": "105/TALK"  , "narrator": "雛", "text": "そ、それは…。"},
        { "location": "106/TALK"  , "narrator": "キリト", "text": "はぁ…まさか、俺だけ\n仲間外れにされる日が\n来るとはなぁ…。"},
        { "location": "108/TALK"  , "narrator": "雛", "text": "ち、違うよー！\n仲間外れにしようなんて\n思ってないからー！"},
        { "location": "109/TALK"  , "narrator": "繭", "text": "…感心した私が\nバカだった。"},
        { "location": "110/TALK"  , "narrator": "キリト", "text": "は？"},
        { "location": "112/TALK"  , "narrator": "繭", "text": "初めてまともな判断を\nしたと思ったのに、\n結局はこうなるのね…。"},
        { "location": "113/TALK"  , "narrator": "キリト", "text": "…まあ、怒られるとは\n思ってたけどな。"},
        { "location": "114/TALK"  , "narrator": "キリト", "text": "でもさ、自分の気持ちに\n正直な今の方が、\n気持ちが軽いんだよ。"},
        { "location": "115/TALK"  , "narrator": "キリト", "text": "やっぱ自分を抑え込むって\nストレス溜まるんだな。\nあははは！"},
        { "location": "116/TALK"  , "narrator": "繭", "text": "…バカ。"},
        { "location": "117/TALK"  , "narrator": "雛", "text": "…………。"},
        { "location": "118/TALK"  , "narrator": "ヒカル", "text": "あ、えっと…。"},
        { "location": "119/TALK"  , "narrator": "ヒカル", "text": "とにかく！\nこれでまた、僕達は\n四人に戻ったわけだね。"},
        { "location": "120/TALK"  , "narrator": "キリト", "text": "ああ、そうだな。"},
        { "location": "121/TALK"  , "narrator": "繭", "text": "不本意ながら。"},
        { "location": "122/TALK"  , "narrator": "雛", "text": "…さっきのあの話は、\nなんだったのかな？"},
        { "location": "123/TALK"  , "narrator": "ヒカル", "text": "みんな、それぞれ\n思うところがあった\nってことだよ。"},
        { "location": "124/TALK"  , "narrator": "キリト", "text": "よーし、ここまで来たら\n最後まで四人一緒だぜ？"},
        { "location": "125/TALK"  , "narrator": "繭", "text": "ええ…こうなったら、\nとことんやってやるわ。"},
        { "location": "126/TALK"  , "narrator": "ヒカル", "text": "うん…頑張ろう！"},
        { "location": "127/TALK"  , "narrator": "雛", "text": "よーし、トライナリー\n応援団の力、みんなに\n見せつけてやろー！"},
        { "location": "140/TALK"  , "narrator": "アーヤ", "text": "あ…。"},
        { "location": "144/TALK"  , "narrator": "真幌", "text": "…アーヤ、ＷＡＶＥか？"},
        { "location": "145/TALK"  , "narrator": "アーヤ", "text": "はい…日向さん達から\nですね…。"},
        { "location": "146/TALK"  , "narrator": "真幌", "text": "わかってると思うが、\n既読は付けないように\n気を付けろよ？"},
        { "location": "147/TALK"  , "narrator": "アーヤ", "text": "わかってますけど、\nとりあえず内容の\n確認しますね…。"},
        { "location": "152/TALK"  , "narrator": "雛", "text": "綾水様"},
        { "location": "153/TALK"  , "narrator": "雛", "text": "返信ないのはわかってますので期待してません"},
        { "location": "154/TALK"  , "narrator": "雛", "text": "でも見てますよね？"},
        { "location": "155/TALK"  , "narrator": "雛", "text": "だから報告しまーす"},
        { "location": "157/TALK"  , "narrator": "キリト", "text": "色々話し合った結果っすけど"},
        { "location": "158/TALK"  , "narrator": "キリト", "text": "俺たちは俺たちで勝手に動きますんで"},
        { "location": "159/TALK"  , "narrator": "ヒカル", "text": "綾水先輩達が東京にいない以上"},
        { "location": "160/TALK"  , "narrator": "ヒカル", "text": "こっちで自由に動けるのは僕達だけですし"},
        { "location": "161/TALK"  , "narrator": "ヒカル", "text": "それに、止められてもいませんからね"},
        { "location": "162/TALK"  , "narrator": "繭", "text": "止められないということから考えて"},
        { "location": "163/TALK"  , "narrator": "繭", "text": "皆さんになにかとんでもない事態が起きたと判断しました"},
        { "location": "164/TALK"  , "narrator": "繭", "text": "例えば捕まったとか"},
        { "location": "165/TALK"  , "narrator": "繭", "text": "そうなるともう綾水先輩達に期待はできません"},
        { "location": "166/TALK"  , "narrator": "雛", "text": "まゆちん言い過ぎ！"},
        { "location": "167/TALK"  , "narrator": "繭", "text": "返信も既読もないのはそういうこと"},
        { "location": "168/TALK"  , "narrator": "繭", "text": "なので我々は綾水先輩達トライナリーの皆様を救うために"},
        { "location": "169/TALK"  , "narrator": "繭", "text": "行動することを決意しました"},
        { "location": "170/TALK"  , "narrator": "キリト", "text": "止めたければ連絡よろしくっす！"},
        { "location": "174/TALK"  , "narrator": "アーヤ", "text": "は！？\nなに考えてるのよ\nあの子達！？"},
        { "location": "175/TALK"  , "narrator": "真幌", "text": "なんだ、どうかしたのか？"},
        { "location": "179/TALK"  , "narrator": "アーヤ", "text": "日向さん達、\n私達を助けるために…。"},
        { "location": "180/TALK"  , "narrator": "アーヤ", "text": "自分達で勝手に動くと\n言ってきました！"},
        { "location": "181/TALK"  , "narrator": "真幌", "text": "なっ！？"},
        { "location": "182/TALK"  , "narrator": "真幌", "text": "バカな！！\nあいつら、死ぬ気か！？"},
        { "location": "183/TALK"  , "narrator": "アーヤ", "text": "館長、どうしたら…。\nやめるように\n連絡しますか？"},
        { "location": "184/TALK"  , "narrator": "真幌", "text": "…いや、多分それは\n逆効果になる。"},
        { "location": "185/TALK"  , "narrator": "真幌", "text": "私達と連絡が取れたことで\n更にヤル気を出される\n可能性があるからな…。"},
        { "location": "186/TALK"  , "narrator": "アーヤ", "text": "そうでしょうか？"},
        { "location": "187/TALK"  , "narrator": "真幌", "text": "これでも、生徒の性格は\n把握しているつもりだ。"},
        { "location": "188/TALK"  , "narrator": "真幌", "text": "…あいつらがどう動こうと\nしているのかだけでも\nわかればいいのだが。"},
        { "location": "190/TALK"  , "narrator": "アーヤ", "text": "…そうだ！"},
        { "location": "196/TALK"  , "narrator": "アーヤ", "text": "ちょっと聞きたいことがあるの"},
        { "location": "197/TALK"  , "narrator": "アーヤ", "text": "日向さん達の様子"},
        { "location": "198/TALK"  , "narrator": "アーヤ", "text": "なにかわからない？"},
        { "location": "200/SEL"   , "narrator": "（選択肢）", "text": "わかるけど教えない"},
        { "location": "201/SEL"   , "narrator": "（選択肢）", "text": "放っておいてあげたら？"},
        { "location": "202/SEL"   , "narrator": "（選択肢）", "text": "なんで？"},
        { "location": "203/ACT"   , "narrator": "", "text": "わかるけど教えない"},
        { "location": "204/TALK"  , "narrator": "アーヤ", "text": "どうして！？"},
        { "location": "205/ACT"   , "narrator": "", "text": "放っておいてあげたら？"},
        { "location": "206/TALK"  , "narrator": "アーヤ", "text": "なんてことを言うの！？"},
        { "location": "207/ACT"   , "narrator": "", "text": "なんで？"},
        { "location": "208/TALK"  , "narrator": "アーヤ", "text": "聞かなくてもわかるでしょ？"},
        { "location": "209/TALK"  , "narrator": "アーヤ", "text": "日向さん達のしようとしてることが"},
        { "location": "210/TALK"  , "narrator": "アーヤ", "text": "危険なことだって"},
        { "location": "212/TALK"  , "narrator": "アーヤ", "text": "$handle$は"},
        { "location": "213/TALK"  , "narrator": "アーヤ", "text": "日向さん達が心配じゃないの！？"},
        { "location": "215/SEL"   , "narrator": "（選択肢）", "text": "あの子達を甘く見過ぎだ"},
        { "location": "216/SEL"   , "narrator": "（選択肢）", "text": "アーヤ達だけでなにが出来る？"},
        { "location": "217/ACT"   , "narrator": "", "text": "あの子達を甘く見過ぎだ"},
        { "location": "218/TALK"  , "narrator": "アーヤ", "text": "甘く見てるとか"},
        { "location": "219/TALK"  , "narrator": "アーヤ", "text": "そういう問題じゃない！"},
        { "location": "220/ACT"   , "narrator": "", "text": "アーヤ達だけでなにが出来る？"},
        { "location": "221/TALK"  , "narrator": "アーヤ", "text": "それは"},
        { "location": "222/TALK"  , "narrator": "アーヤ", "text": "まだわからないけど"},
        { "location": "223/TALK"  , "narrator": "アーヤ", "text": "今話してることは"},
        { "location": "224/TALK"  , "narrator": "アーヤ", "text": "そういう問題じゃないから！"},
        { "location": "226/TALK"  , "narrator": "アーヤ", "text": "もういいわ"},
        { "location": "227/TALK"  , "narrator": "アーヤ", "text": "珍しく"},
        { "location": "228/TALK"  , "narrator": "アーヤ", "text": "意見合わないみたいだし"},
        { "location": "241/TALK"  , "narrator": "アーヤ", "text": "…館長、どう思います？"},
        { "location": "243/TALK"  , "narrator": "真幌", "text": "…難しいところだ。"},
        { "location": "244/TALK"  , "narrator": "真幌", "text": "正直、東京で動いてくれる\n人員がいるというのは、\nとても助かるのは事実だ。"},
        { "location": "245/TALK"  , "narrator": "真幌", "text": "しかし…、容認することは\nできない。"},
        { "location": "246/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "247/SEL"   , "narrator": "（選択肢）", "text": "生徒を信じてやれ"},
        { "location": "248/ACT"   , "narrator": "", "text": "生徒を信じてやれ"},
        { "location": "267/TALK"  , "narrator": "アーヤ", "text": "館長へのメッセージ"},
        { "location": "268/TALK"  , "narrator": "アーヤ", "text": "伝えとくわ"},
        { "location": "273/TALK"  , "narrator": "アーヤ", "text": "…館長、これ。"},
        { "location": "275/TALK"  , "narrator": "真幌", "text": "ん？"},
        { "location": "276/TALK"  , "narrator": "真幌", "text": "…なるほど。"},
        { "location": "277/TALK"  , "narrator": "真幌", "text": "こちらの気も知らないで、\n勝手なことを言うものだ。"},
        { "location": "278/TALK"  , "narrator": "真幌", "text": "…生徒だからこそ、\n放っておけないと\nいうのに…。"},
        { "location": "281/TALK"  , "narrator": "アーヤ", "text": "…館長。"},
        { "location": "283/TALK"  , "narrator": "真幌", "text": "遊びじゃないんだ…、\nなのに、あいつら…。"},
        { "location": "284/TALK"  , "narrator": "アーヤ", "text": "…………。"}
    ]
}
