    [
        { "location": "2440/SCENARIO", "narrator": "", "text": "痛くない？"},
        { "location": "2465/TALK"    , "narrator": "神楽", "text": "推しキャラの絵が入ったＴシャツとか"},
        { "location": "2466/TALK"    , "narrator": "神楽", "text": "アキバ系オタグッズの最たるものだと思うけど"},
        { "location": "2468/SEL"     , "narrator": "", "text": "さすがにそれはｗ"},
        { "location": "2469/SEL"     , "narrator": "", "text": "あるよねそういうの"},
        { "location": "2470/SEL"     , "narrator": "", "text": "神楽のだったら着るよ！"},
        { "location": "2471/ACT"     , "narrator": "", "text": "さすがにそれはｗ"},
        { "location": "2472/TALK"    , "narrator": "神楽", "text": "コレクション目的っしょ？"},
        { "location": "2473/ACT"     , "narrator": "", "text": "あるよねそういうの"},
        { "location": "2474/TALK"    , "narrator": "神楽", "text": "んだ"},
        { "location": "2475/ACT"     , "narrator": "", "text": "神楽のだったら着るよ！"},
        { "location": "2478/TALK"    , "narrator": "神楽", "text": "着たとこ見たいみたい見たい見たい！！！"},
        { "location": "2479/TALK"    , "narrator": "神楽", "text": "絶対着ろよ！！！"},
        { "location": "2481/TALK"    , "narrator": "神楽", "text": "ぴょんことしてはそこまで突き抜けてしまえばいっそ清々しいと思うぴょん"},
        { "location": "2484/SEL"     , "narrator": "", "text": "心広いな！"},
        { "location": "2485/SEL"     , "narrator": "", "text": "あれはネタっていうか…"},
        { "location": "2486/SEL"     , "narrator": "", "text": "ぴょんこＴシャツ希望！"},
        { "location": "2487/ACT"     , "narrator": "", "text": "心広いな！"},
        { "location": "2488/TALK"    , "narrator": "神楽", "text": "ぴょんこの包容力は100ぴょんこだから！"},
        { "location": "2489/ACT"     , "narrator": "", "text": "あれはネタっていうか…"},
        { "location": "2490/TALK"    , "narrator": "神楽", "text": "いやガチでしょ"},
        { "location": "2491/ACT"     , "narrator": "", "text": "ぴょんこＴシャツ希望！"},
        { "location": "2493/TALK"    , "narrator": "神楽", "text": "リクエストいただきましたー！！！"},
        { "location": "2494/TALK"    , "narrator": "神楽", "text": "これは商品化するべきだね！！！"},
        { "location": "2495/TALK"    , "narrator": "神楽", "text": "なお百枚ごとにぴょんことの握手券がつきまーす！"},
        { "location": "2497/TALK"    , "narrator": "神楽", "text": "あれの根底にあるのは愛なのそれとも独占欲？"},
        { "location": "2499/TALK"    , "narrator": "神楽", "text": "あるいはコンテンツ継続のためのお布施？"},
        { "location": "2500/TALK"    , "narrator": "神楽", "text": "なんて生々しいことを考えてしまうぴょん♪"},
        { "location": "2501/TALK"    , "narrator": "神楽", "text": "舞台裏が気になるわ～"}
    ]
