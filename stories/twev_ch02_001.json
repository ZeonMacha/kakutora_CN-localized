        "title": "Twitter Archive 006",
        "sub_title": "卯月画廊：いい色気の日"
    },
    "entry":
    [
        { "location": "29/TALK"   , "narrator": "透明みやび", "text": "いや～、さすがは\n卯月大先生や。"},
        { "location": "30/TALK"   , "narrator": "透明みやび", "text": "今回もなかなかの力作\n引っ提げてきよったね。"},
        { "location": "31/TALK"   , "narrator": "透明神楽", "text": "ふふっ、\nありがとうございます！"},
        { "location": "33/TALK"   , "narrator": "透明アーヤ", "text": "いや、力作なのは\n認めるけど、\nどうして私とみやびなの？"},
        { "location": "34/TALK"   , "narrator": "透明神楽", "text": "１１月１６日、\nつまりいい色気の日に\n描いたものだからです。"},
        { "location": "35/TALK"   , "narrator": "透明神楽", "text": "ヒヒイロカネの日じゃ\nないですよ？"},
        { "location": "36/TALK"   , "narrator": "透明アーヤ", "text": "あー、神器とかに使う\n金属ね。ていうか、卯月\n難しい事知ってるわね。"},
        { "location": "38/TALK"   , "narrator": "透明みやび", "text": "あ～、多分卯月はそっちを\n指しては言っちょらん\n気がするが。"},
        { "location": "39/TALK"   , "narrator": "透明神楽", "text": "とにかく、私達の中で\n一番色気のあるお二人を\n選んだんです。"},
        { "location": "40/TALK"   , "narrator": "透明アーヤ", "text": "それにしたって、\nこのポーズはないでしょ？"},
        { "location": "41/TALK"   , "narrator": "透明アーヤ", "text": "こんなに胸を強調した\nポーズにすること\nないのに…。"},
        { "location": "43/TALK"   , "narrator": "透明みやび", "text": "アーヤなんかまだえいよ。\nうちなんか完全に\n脱げちょるきね。"},
        { "location": "44/TALK"   , "narrator": "透明みやび", "text": "アーヤの巨乳のおかげで\nギリ保っちょるヤバさ。"},
        { "location": "45/TALK"   , "narrator": "透明神楽", "text": "ここはお二人の仲のよさを\n表現したんです。"},
        { "location": "47/TALK"   , "narrator": "透明アーヤ", "text": "…もうちょっと違う\n表現の仕方はなかったの？"},
        { "location": "48/TALK"   , "narrator": "透明みやび", "text": "まあ、ポーズはどうあれ\n上手く描いてくれたのは\n確かや。"},
        { "location": "49/TALK"   , "narrator": "透明みやび", "text": "それで満足しておくぞね。"},
        { "location": "50/TALK"   , "narrator": "透明アーヤ", "text": "でも…。"},
        { "location": "51/TALK"   , "narrator": "透明みやび", "text": "それに、アーヤも\n卯月に言ってたやろ？"},
        { "location": "53/TALK"   , "narrator": "透明みやび", "text": "卯月はもっとジャンジャン\n絵を描いていけばえい、\nって。"},
        { "location": "54/TALK"   , "narrator": "透明アーヤ", "text": "だから、ジャンジャン\nなんて言ってないから…。"},
        { "location": "55/SEL"    , "narrator": "（選択肢）", "text": "楽しそうなことになってるね"},
        { "location": "56/ACT"    , "narrator": "", "text": "楽しそうなことになってるね"},
        { "location": "61/TALK"   , "narrator": "アーヤ", "text": "そう見える？（；￢＿￢）"},
        { "location": "63/TALK"   , "narrator": "アーヤ", "text": "ちょっと"},
        { "location": "64/TALK"   , "narrator": "アーヤ", "text": "困ってるんだけど(；´Д｀)"},
        { "location": "65/SEL"    , "narrator": "（選択肢）", "text": "間に挟まりたい"},
        { "location": "66/SEL"    , "narrator": "（選択肢）", "text": "絵になるポーズだね"},
        { "location": "67/ACT"    , "narrator": "", "text": "間に挟まりたい"},
        { "location": "68/TALK"   , "narrator": "アーヤ", "text": "あのね"},
        { "location": "70/TALK"   , "narrator": "アーヤ", "text": "そういうこと言われると"},
        { "location": "71/TALK"   , "narrator": "アーヤ", "text": "もっと恥ずかしくなるから(｡-_-｡)"},
        { "location": "72/TALK"   , "narrator": "アーヤ", "text": "ちょっと"},
        { "location": "73/TALK"   , "narrator": "アーヤ", "text": "自重して(>_<)"},
        { "location": "74/ACT"    , "narrator": "", "text": "絵になるポーズだね"},
        { "location": "75/TALK"   , "narrator": "アーヤ", "text": "そう？(￣Д￣ )"},
        { "location": "76/TALK"   , "narrator": "アーヤ", "text": "こっちとしては"},
        { "location": "77/TALK"   , "narrator": "アーヤ", "text": "恥ずかしいだけなんだけど(-.-;)"},
        { "location": "79/TALK"   , "narrator": "アーヤ", "text": "まさか"},
        { "location": "81/TALK"   , "narrator": "アーヤ", "text": "こんな絵を描かれるなんて"},
        { "location": "82/TALK"   , "narrator": "アーヤ", "text": "予想してなかった(-ω-;)"},
        { "location": "83/TALK"   , "narrator": "アーヤ", "text": "ビックリ(>_<)"},
        { "location": "84/SEL"    , "narrator": "（選択肢）", "text": "結構際どいからね"},
        { "location": "85/SEL"    , "narrator": "（選択肢）", "text": "素敵だと思うよ"},
        { "location": "86/ACT"    , "narrator": "", "text": "結構際どいからね"},
        { "location": "87/TALK"   , "narrator": "アーヤ", "text": "まあ"},
        { "location": "88/TALK"   , "narrator": "アーヤ", "text": "みやびに比べたら"},
        { "location": "89/TALK"   , "narrator": "アーヤ", "text": "まだマシだけど(￣Д￣ )"},
        { "location": "90/TALK"   , "narrator": "アーヤ", "text": "それでも"},
        { "location": "91/TALK"   , "narrator": "アーヤ", "text": "やっぱり恥ずかしい(｡-_-｡)"},
        { "location": "92/ACT"    , "narrator": "", "text": "素敵だと思うよ"},
        { "location": "93/TALK"   , "narrator": "アーヤ", "text": "そう？"},
        { "location": "95/TALK"   , "narrator": "アーヤ", "text": "ごめんなさい"},
        { "location": "97/TALK"   , "narrator": "アーヤ", "text": "あんまり見ないで(｡-_-｡)"},
        { "location": "98/TALK"   , "narrator": "アーヤ", "text": "なんか"},
        { "location": "99/TALK"   , "narrator": "アーヤ", "text": "顔熱くなってきた(*ﾉ∀`*) "},
        { "location": "101/TALK"  , "narrator": "アーヤ", "text": "でも"},
        { "location": "102/TALK"  , "narrator": "アーヤ", "text": "卯月の絵は好きなの"},
        { "location": "103/TALK"  , "narrator": "アーヤ", "text": "とっても上手だし(^^"},
        { "location": "104/TALK"  , "narrator": "アーヤ", "text": "描いてもらえるのは"},
        { "location": "106/TALK"  , "narrator": "アーヤ", "text": "嬉しいの(*^^*)"},
        { "location": "107/SEL"   , "narrator": "（選択肢）", "text": "$me$もアーヤの絵をもっと見たい"},
        { "location": "108/SEL"   , "narrator": "（選択肢）", "text": "次はもっと際どいのを希望すると伝えて"},
        { "location": "109/ACT"   , "narrator": "", "text": "$me$もアーヤの絵をもっと見たい"},
        { "location": "110/TALK"  , "narrator": "アーヤ", "text": "見たいのは絵なの？( ・_・)σﾞ"},
        { "location": "112/SEL"   , "narrator": "（選択肢）", "text": "いや、生のアーヤが一番だよ！"},
        { "location": "113/SEL"   , "narrator": "（選択肢）", "text": "普段見れないアーヤの姿が見れるし"},
        { "location": "114/ACT"   , "narrator": "", "text": "いや、生のアーヤが一番だよ！"},
        { "location": "115/TALK"  , "narrator": "アーヤ", "text": "よろしい(￣∇￣)"},
        { "location": "116/TALK"  , "narrator": "アーヤ", "text": "本物より絵って言われてたら"},
        { "location": "117/TALK"  , "narrator": "アーヤ", "text": "さすがに"},
        { "location": "118/TALK"  , "narrator": "アーヤ", "text": "ちょっと複雑だった(￣Д￣ )"},
        { "location": "119/ACT"   , "narrator": "", "text": "普段見れないアーヤの姿が見れるし"},
        { "location": "120/TALK"  , "narrator": "アーヤ", "text": "それだと"},
        { "location": "121/TALK"  , "narrator": "アーヤ", "text": "私のそっくりさん見てるのと同じよ？(￣Д￣ )"},
        { "location": "122/TALK"  , "narrator": "アーヤ", "text": "まあ"},
        { "location": "123/TALK"  , "narrator": "アーヤ", "text": "$handle$はこういうの"},
        { "location": "125/TALK"  , "narrator": "アーヤ", "text": "求めてるのかもしれないけど（；￢＿￢）"},
        { "location": "127/ACT"   , "narrator": "", "text": "次はもっと際どいのを希望すると伝えて"},
        { "location": "128/TALK"  , "narrator": "アーヤ", "text": "伝えません！(｀ヘ´)"},
        { "location": "129/TALK"  , "narrator": "アーヤ", "text": "そんなこと言ったら"},
        { "location": "130/TALK"  , "narrator": "アーヤ", "text": "本当スゴイの描かれそうだし(>_<)"},
        { "location": "132/TALK"  , "narrator": "アーヤ", "text": "とりあえず"},
        { "location": "133/TALK"  , "narrator": "アーヤ", "text": "今回だけは"},
        { "location": "134/TALK"  , "narrator": "アーヤ", "text": "卯月にしてやられたってことで"},
        { "location": "136/TALK"  , "narrator": "アーヤ", "text": "諦めるわ(-ω-;)"},
        { "location": "142/DIALOG", "narrator": "", "text": "このシナリオの元になっている\nTwitterの会話ログを見ますか？"}
    ]
}
