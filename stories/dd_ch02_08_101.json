{
    "dir": "chap08/daydra/dd_ch02_08_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "8202",
        "cid": "ayami",
        "title": "002 メインストーリー",
        "sub_title": "先輩会議＜前編＞"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "先輩会議"},
        { "location": "38/TALK"   , "narrator": "みやび", "text": "このよもぎ地あん\nチーズ、マジ絶品\nぞね！"},
        { "location": "40/TALK"   , "narrator": "ガブリエラ", "text": "だから言ったでしょ？\n一度は食べないと\n勿体ない、って。"},
        { "location": "41/TALK"   , "narrator": "アーヤ", "text": "私には紅茶まん\n勧めたじゃない？"},
        { "location": "44/TALK"   , "narrator": "ガブリエラ", "text": "それも美味しいから\nお勧めなのよ。"},
        { "location": "46/TALK"   , "narrator": "みやび", "text": "さすがガブちゃんや。\nむぎまるマスターの\n称号を与えるぞね。"},
        { "location": "48/TALK"   , "narrator": "アーヤ", "text": "今度は逢瀬さん達も\n連れてきたいわね。"},
        { "location": "50/TALK"   , "narrator": "ガブリエラ", "text": "…必要ないわよ。\n新人は新人同士で\n仲良くやると思うし。"},
        { "location": "51/TALK"   , "narrator": "みやび", "text": "あの二人、中々運命\n的な出会い方しちょっ\nたき――"},
        { "location": "53/TALK"   , "narrator": "みやび", "text": "熱い友情が生まれて、\n二人だけの世界を築き\n上げる可能性大ぞね。"},
        { "location": "56/TALK"   , "narrator": "ガブリエラ", "text": "…二人だけの世界とか\n言うと、ちょっと\n怪しく聞こえるわよ？"},
        { "location": "58/TALK"   , "narrator": "みやび", "text": "絵になると思うがよ。\n二人とも外見は文句\nなしやきね。"},
        { "location": "61/TALK"   , "narrator": "アーヤ", "text": "はぁ…少し真面目に\n考えてよ。"},
        { "location": "63/TALK"   , "narrator": "アーヤ", "text": "私達はあの二人の\n先輩なのよ？"},
        { "location": "65/TALK"   , "narrator": "ガブリエラ", "text": "任務とバイト以外、\n無理に関わる\n必要もないんでしょ。"},
        { "location": "67/TALK"   , "narrator": "みやび", "text": "先輩にあんまし\nちょっかい出される\nゆうんも――"},
        { "location": "68/TALK"   , "narrator": "みやび", "text": "息苦しく思われる\nかもしれんがよ。"},
        { "location": "69/TALK"   , "narrator": "アーヤ", "text": "とはいっても、\n放ってはおけない\nでしょ？"},
        { "location": "70/TALK"   , "narrator": "アーヤ", "text": "特に、逢瀬さんは\n本当に普通の子なん\nだから…。"},
        { "location": "71/TALK"   , "narrator": "ガブリエラ", "text": "あれのどこが！？"},
        { "location": "72/TALK"   , "narrator": "ガブリエラ", "text": "殺されても\n何故か生き返ったり\nする――"},
        { "location": "73/TALK"   , "narrator": "ガブリエラ", "text": "得体の知れない\n変な奴じゃない。"},
        { "location": "74/TALK"   , "narrator": "アーヤ", "text": "そうかしら？"},
        { "location": "75/TALK"   , "narrator": "ガブリエラ", "text": "そうよ！\nあいつ、絶対に裏が\nあるに違いないわ。"},
        { "location": "76/TALK"   , "narrator": "ガブリエラ", "text": "例えば、あたし達と\n敵対するような\n何か、とか…。"},
        { "location": "78/TALK"   , "narrator": "アーヤ", "text": "疑い過ぎじゃない？\nそこまで言うのは\nかわいそうよ。"},
        { "location": "79/TALK"   , "narrator": "ガブリエラ", "text": "得体のしれない奴を\n無条件で信じて、\n仲間に迎えるの？"},
        { "location": "81/TALK"   , "narrator": "ガブリエラ", "text": "それ、リーダーとして\n無責任なんじゃない？"},
        { "location": "82/TALK"   , "narrator": "アーヤ", "text": "なっ！？\nちょっとギャヴィ、\n今のは――"},
        { "location": "84/TALK"   , "narrator": "みやび", "text": "こうなったら、\nいよいよあの人の\n力を借りる時やね。"},
        { "location": "86/TALK"   , "narrator": "ガブリエラ", "text": "あの人？"},
        { "location": "88/TALK"   , "narrator": "みやび", "text": "うむ、アーヤの姉に\nして、うちのゴッド。\nエリカさんや。"},
        { "location": "92/TALK"   , "narrator": "アーヤ", "text": "いや、何でよ？\nうちの姉は関係ない\nでしょ？"},
        { "location": "94/TALK"   , "narrator": "みやび", "text": "大ありや。\nあの人の経歴、知らん\nわけやないやろ？"},
        { "location": "96/TALK"   , "narrator": "ガブリエラ", "text": "心と量子の専門家で、\nフェノメノン研究の\n第一人者の博士で――"},
        { "location": "98/TALK"   , "narrator": "ガブリエラ", "text": "付属大学の客員教授も\nやってたから、管理庁\nにも顔が利くのよね？"},
        { "location": "101/TALK"  , "narrator": "みやび", "text": "うむ、完璧花丸\nＡプラス！\nよくできました。"},
        { "location": "104/TALK"  , "narrator": "ガブリエラ", "text": "誰かさんに何度も\n聞かされたおかげよ。"},
        { "location": "106/TALK"  , "narrator": "みやび", "text": "とまあ、そんな\nゴッドが身内にいらっ\nしゃるんやき――"},
        { "location": "108/TALK"  , "narrator": "みやび", "text": "つばめちゃん達の\nことも、お願いして\n調べてもらうがよ。"},
        { "location": "111/TALK"  , "narrator": "アーヤ", "text": "却下！　あの人に\n連絡するなんて、\n嫌よ。"},
        { "location": "114/TALK"  , "narrator": "ガブリエラ", "text": "実の姉に対して…、\n随分冷たいのね？"},
        { "location": "116/TALK"  , "narrator": "みやび", "text": "なんと贅沢な。\nうちがエリカさんの\n妹やったとしたら――"},
        { "location": "117/TALK"  , "narrator": "みやび", "text": "もう２４時間いつでも\n隣でべったりやぞ？"},
        { "location": "121/TALK"  , "narrator": "みやび", "text": "百合展開も喜んで\n受け入れるぞね。"},
        { "location": "123/TALK"  , "narrator": "アーヤ", "text": "人の姉で変なこと\n考えるの、やめて\nもらえる？"},
        { "location": "126/TALK"  , "narrator": "アーヤ", "text": "第一、本当にあの人の\n妹になったら、そんな\n考えぶっ飛ぶから…。"},
        { "location": "129/TALK"  , "narrator": "みやび", "text": "けんど、エリカさんの\n協力はうちら全員の\n安全に関わることや。"},
        { "location": "130/TALK"  , "narrator": "みやび", "text": "それを嫌がるなら、\n理由を聞かんことには\n納得できんがよ。"},
        { "location": "132/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "133/TALK"  , "narrator": "アーヤ", "text": "…無駄よ。あの人、\n電話にもメールにも\n出たことないし――"},
        { "location": "134/TALK"  , "narrator": "アーヤ", "text": "返事もくれないん\nだから。"},
        { "location": "136/TALK"  , "narrator": "みやび", "text": "ＷＡＶＥはどうや？\nＷＡＶＥアカウントは\n知ってるが？"},
        { "location": "138/TALK"  , "narrator": "アーヤ", "text": "知ってはいるけど、\nもう何年も連絡して\nないから…。"},
        { "location": "139/TALK"  , "narrator": "ガブリエラ", "text": "送れば見てはくれる\nかもしれないでしょ？"},
        { "location": "140/TALK"  , "narrator": "みやび", "text": "ダメもとでもえいき、\n連絡くれと書きこんで\nみぃ。"},
        { "location": "142/TALK"  , "narrator": "アーヤ", "text": "…わかったわよ。\nでも、返信なくても\n知らないわよ？"},
        { "location": "152/TALK"  , "narrator": "アーヤ", "text": "どうしよう(>_<)"},
        { "location": "154/TALK"  , "narrator": "アーヤ", "text": "連絡取りたくないの"},
        { "location": "156/SEL"   , "narrator": "", "text": "そんなにお姉さんが嫌い？"},
        { "location": "157/ACT"   , "narrator": "", "text": "そんなにお姉さんが嫌い？"},
        { "location": "159/TALK"  , "narrator": "アーヤ", "text": "嫌いっていうか(-.-;)"},
        { "location": "160/TALK"  , "narrator": "アーヤ", "text": "信用できない"},
        { "location": "161/TALK"  , "narrator": "アーヤ", "text": "いい加減だし(--#)"},
        { "location": "162/TALK"  , "narrator": "アーヤ", "text": "自分勝手でいい加減で"},
        { "location": "163/TALK"  , "narrator": "アーヤ", "text": "家のことも全然顧みないで"},
        { "location": "164/TALK"  , "narrator": "アーヤ", "text": "そんな人の力を借りるなんて"},
        { "location": "165/TALK"  , "narrator": "アーヤ", "text": "絶対嫌！(｀ヘ´)"},
        { "location": "168/SEL"   , "narrator": "", "text": "大変だったんだね"},
        { "location": "169/ACT"   , "narrator": "", "text": "大変だったんだね"},
        { "location": "171/TALK"  , "narrator": "アーヤ", "text": "ごめん"},
        { "location": "173/TALK"  , "narrator": "アーヤ", "text": "愚痴聞かせて(-ω-;)"},
        { "location": "174/TALK"  , "narrator": "アーヤ", "text": "今は、連絡を取らない方法を考えないとね"},
        { "location": "176/SEL"   , "narrator": "", "text": "なら、話題を反らそう"},
        { "location": "177/ACT"   , "narrator": "", "text": "なら、話題を反らそう"},
        { "location": "179/TALK"  , "narrator": "アーヤ", "text": "どうするの？( ・_・)σﾞ"},
        { "location": "181/SEL"   , "narrator": "", "text": "神楽のことを話そうよ"},
        { "location": "182/ACT"   , "narrator": "", "text": "神楽のことを話そうよ"},
        { "location": "184/TALK"  , "narrator": "アーヤ", "text": "え？(-.-;)"},
        { "location": "187/TALK"  , "narrator": "アーヤ", "text": "でも"},
        { "location": "189/TALK"  , "narrator": "アーヤ", "text": "あの子も色々"},
        { "location": "190/TALK"  , "narrator": "アーヤ", "text": "ちょっと思うところが(-ω-;)"},
        { "location": "192/SEL"   , "narrator": "", "text": "だからこそじゃない？"},
        { "location": "193/ACT"   , "narrator": "", "text": "だからこそじゃない？"},
        { "location": "195/TALK"  , "narrator": "アーヤ", "text": "そうだけど(>_<)"},
        { "location": "198/TALK"  , "narrator": "アーヤ", "text": "ううん"},
        { "location": "199/TALK"  , "narrator": "アーヤ", "text": "そうね"},
        { "location": "201/TALK"  , "narrator": "アーヤ", "text": "このままじゃ"},
        { "location": "202/TALK"  , "narrator": "アーヤ", "text": "ずっと姉のこと詮索されそうだし(´o｀；"},
        { "location": "205/TALK"  , "narrator": "アーヤ", "text": "どうしたものかしら"},
        { "location": "250/TALK"  , "narrator": "アーヤ", "text": "あー。"},
        { "location": "251/TALK"  , "narrator": "アーヤ", "text": "まさかの３回連続\n姉問題とはね。"},
        { "location": "252/TALK"  , "narrator": "アーヤ", "text": "あなた、地雷踏むのが\n本当に上手ね。"},
        { "location": "253/SEL"   , "narrator": "", "text": "今回のは$me$からじゃないよ！"},
        { "location": "254/ACT"   , "narrator": "", "text": "今回のは$me$からじゃないよ！"},
        { "location": "256/TALK"  , "narrator": "アーヤ", "text": "ふふ、わかってる。"},
        { "location": "257/TALK"  , "narrator": "アーヤ", "text": "ちょっと意地悪して\nみたかっただけよ？"},
        { "location": "258/SEL"   , "narrator": "", "text": "姉問題、根深いね"},
        { "location": "259/ACT"   , "narrator": "", "text": "姉問題、根深いね"},
        { "location": "261/TALK"  , "narrator": "アーヤ", "text": "ホントにね。"},
        { "location": "262/TALK"  , "narrator": "アーヤ", "text": "その実、単に意地を\n張ってるだけなんだ\nけどね。"},
        { "location": "263/SEL"   , "narrator": "", "text": "え？そうなの？"},
        { "location": "264/ACT"   , "narrator": "", "text": "え？そうなの？"},
        { "location": "266/TALK"  , "narrator": "アーヤ", "text": "あぁ、もちろん理由は\n色々あるのよ？"},
        { "location": "267/TALK"  , "narrator": "アーヤ", "text": "そりゃもう、ここでは\n語りきれないくらいに。"},
        { "location": "268/TALK"  , "narrator": "アーヤ", "text": "ホントはそのお話も\nしてあげたいんだけどね、\nどうせヒマだし。"},
        { "location": "270/TALK"  , "narrator": "アーヤ", "text": "でも司書である私には\nその権利は無いのよ。"},
        { "location": "272/TALK"  , "narrator": "アーヤ", "text": "…っと、無駄話してる\n場合じゃないわね。\n扉をコールしなくちゃ。"},
        { "location": "277/TALK"  , "narrator": "アーヤ", "text": "オープンプロセス、\n0x86D番地から\n0x513番地へ。"},
        { "location": "292/TALK"  , "narrator": "アーヤ", "text": "シーク完了。"},
        { "location": "294/TALK"  , "narrator": "アーヤ", "text": "あー、でも\nちょっとラッキーかも。"},
        { "location": "296/TALK"  , "narrator": "アーヤ", "text": "今回の案件、\n姉のことが主題じゃ\nなかったわよ。"},
        { "location": "297/TALK"  , "narrator": "アーヤ", "text": "寧ろ、卯月神楽について\n思うところが\nあるみたいね。"},
        { "location": "298/SEL"   , "narrator": "", "text": "へー、そうなんだ"},
        { "location": "299/ACT"   , "narrator": "", "text": "へー、そうなんだ"},
        { "location": "301/TALK"  , "narrator": "アーヤ", "text": "意外でしょ。\n私も意外だったわ。"},
        { "location": "303/TALK"  , "narrator": "アーヤ", "text": "どうも私は、卯月に\nちょっとコンプレックス\nを抱いてるみたい。"},
        { "location": "304/SEL"   , "narrator": "", "text": "なんで？"},
        { "location": "305/ACT"   , "narrator": "", "text": "なんで？"},
        { "location": "307/TALK"  , "narrator": "アーヤ", "text": "スペックが高く見える\nみたいね。"},
        { "location": "308/TALK"  , "narrator": "アーヤ", "text": "前回の戦闘で\n随分活躍してたし。"},
        { "location": "309/TALK"  , "narrator": "アーヤ", "text": "無意識のうちか\nわからないけど、\n他の子に指示してたり。"},
        { "location": "310/TALK"  , "narrator": "アーヤ", "text": "私の直感が、天性の\nリーダー質を持ってると\n感じてるみたい。"},
        { "location": "311/TALK"  , "narrator": "アーヤ", "text": "その事が原因で、\n近い将来、自分の立場が\n危うくなるのではと。"},
        { "location": "312/TALK"  , "narrator": "アーヤ", "text": "そんな不安がクランを\n生んで、扉を閉ざした\nみたいね。"},
        { "location": "313/TALK"  , "narrator": "アーヤ", "text": "まだ出逢って数日。\n全然わからないのに、\n私ってホント心配性。"},
        { "location": "314/TALK"  , "narrator": "アーヤ", "text": "申し訳無いけど、\nクランを倒して不安を\n払拭してくれる？"},
        { "location": "315/TALK"  , "narrator": "アーヤ", "text": "このままだと、\n何を考え出すか\nわからないから。"},
        { "location": "316/SEL"   , "narrator": "", "text": "りょうかい"},
        { "location": "317/ACT"   , "narrator": "", "text": "りょうかい"},
        { "location": "320/TALK"  , "narrator": "アーヤ", "text": "ありがと。\nいつも助かるわ。"},
        { "location": "321/TALK"  , "narrator": "アーヤ", "text": "$handle$さんと\n國政綾水にとって、\n素敵なココロの旅を！"},
        { "location": "36/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>5月11日　4:20 PM</color>\n某高校でのフェノメノン戦の２日後、放課後むぎまるにて。"},
        { "location": "218/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"}
    ]
}
