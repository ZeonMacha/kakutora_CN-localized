{
    "dir": "chap36/daydra/dd_ch02_36_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "36205",
        "cid": "ayami",
        "title": "005 メインストーリー",
        "sub_title": "日常の中の約束を＜後編＞"
    },
    "entry":
    [
        { "location": "434/SCENARIO", "narrator": "", "text": "二重写しの真実を"},
        { "location": "453/TALK"    , "narrator": "アーヤ", "text": "何これ…？\nお姉ちゃんが死んだ？\nお姉ちゃんは死んでた？"},
        { "location": "454/TALK"    , "narrator": "アーヤ", "text": "そんなことない！"},
        { "location": "455/TALK"    , "narrator": "アーヤ", "text": "だってあの後も連絡\nくれたじゃない。"},
        { "location": "456/TALK"    , "narrator": "アーヤ", "text": "変なロボットとか\nメッセージとか。\nそれにビデオだって。"},
        { "location": "457/TALK"    , "narrator": "アーヤ", "text": "……頭、痛い……。"},
        { "location": "458/TALK"    , "narrator": "アーヤ", "text": "ねえ。"},
        { "location": "459/TALK"    , "narrator": "アーヤ", "text": "お姉ちゃんって本当は\n生きてるの？\n死んでるの？"},
        { "location": "460/SEL"     , "narrator": "", "text": "わからない"},
        { "location": "461/SEL"     , "narrator": "", "text": "きっと死んでない"},
        { "location": "462/SEL"     , "narrator": "", "text": "どこか別の世界にいるんだよ"},
        { "location": "463/ACT"     , "narrator": "", "text": "わからない"},
        { "location": "465/TALK"    , "narrator": "アーヤ", "text": "そう……。"},
        { "location": "466/SEL"     , "narrator": "", "text": "ごめんね"},
        { "location": "467/SEL"     , "narrator": "", "text": "アーヤはどう思う？"},
        { "location": "468/SEL"     , "narrator": "", "text": "思い出せることはない？"},
        { "location": "469/ACT"     , "narrator": "", "text": "ごめんね"},
        { "location": "471/TALK"    , "narrator": "アーヤ", "text": "こっちこそ変なこと\n聞いてごめんね。"},
        { "location": "472/ACT"     , "narrator": "", "text": "アーヤはどう思う？"},
        { "location": "473/TALK"    , "narrator": "アーヤ", "text": "……どっちも本当で\nどっちも嘘のような\n気がする。"},
        { "location": "474/ACT"     , "narrator": "", "text": "思い出せることはない？"},
        { "location": "475/TALK"    , "narrator": "アーヤ", "text": "………………。"},
        { "location": "476/TALK"    , "narrator": "アーヤ", "text": "いっぱいあるような、\n全然思い浮かばない\nような……。"},
        { "location": "478/ACT"     , "narrator": "", "text": "きっと死んでない"},
        { "location": "479/TALK"    , "narrator": "アーヤ", "text": "そうね。\nそうに決まってる。"},
        { "location": "480/TALK"    , "narrator": "アーヤ", "text": "…でも研究所から\n届いた手紙を憶えてる。"},
        { "location": "481/TALK"    , "narrator": "アーヤ", "text": "それからうちに挨拶に\n来たことも。"},
        { "location": "482/TALK"    , "narrator": "アーヤ", "text": "あれは何なの…？"},
        { "location": "483/ACT"     , "narrator": "", "text": "どこか別の世界にいるんだよ"},
        { "location": "484/TALK"    , "narrator": "アーヤ", "text": "…何それ？"},
        { "location": "485/TALK"    , "narrator": "アーヤ", "text": "別次元に\n姉がいますって？"},
        { "location": "486/TALK"    , "narrator": "アーヤ", "text": "そんなこと言ったら\n本格的におかしくなった\nって思われるわよ。"},
        { "location": "487/TALK"    , "narrator": "アーヤ", "text": "……でもお姉ちゃんなら\nいても不思議じゃ\nないような気がする。"},
        { "location": "489/TALK"    , "narrator": "アーヤ", "text": "ちょっと整理するわね。"},
        { "location": "490/TALK"    , "narrator": "アーヤ", "text": "私の記憶が二重に\nなってるのは\n私が高校生の時。"},
        { "location": "491/TALK"    , "narrator": "アーヤ", "text": "姉がらみのできごとで、\nひとつは姉は死亡した。\nもうひとつは生きている。"},
        { "location": "492/TALK"    , "narrator": "アーヤ", "text": "今の私は大学生。\nトライナリーに\n所属してる。"},
        { "location": "493/TALK"    , "narrator": "アーヤ", "text": "ただしつばめの\nフェノメノンの中で。"},
        { "location": "494/SEL"     , "narrator": "", "text": "よくできました"},
        { "location": "495/SEL"     , "narrator": "", "text": "なるほどね"},
        { "location": "496/SEL"     , "narrator": "", "text": "真実ってひとつだけなの？"},
        { "location": "497/ACT"     , "narrator": "", "text": "よくできました"},
        { "location": "498/TALK"    , "narrator": "アーヤ", "text": "…本当に？"},
        { "location": "499/ACT"     , "narrator": "", "text": "なるほどね"},
        { "location": "501/ACT"     , "narrator": "", "text": "真実ってひとつだけなの？"},
        { "location": "504/TALK"    , "narrator": "アーヤ", "text": "…それでね。\nやっぱり少しおかしい。\n姉の生死のことは。"},
        { "location": "505/TALK"    , "narrator": "アーヤ", "text": "本来なら今いるここが\nフェノメノンの中でも\n外でも変わらないはず。"},
        { "location": "506/TALK"    , "narrator": "アーヤ", "text": "だけど私は二つの記憶を\n持ってる。"},
        { "location": "507/TALK"    , "narrator": "アーヤ", "text": "姉が生きてるセカイと\n死んでるセカイ。"},
        { "location": "508/TALK"    , "narrator": "アーヤ", "text": "これはすごく重要な\nことじゃない？"},
        { "location": "509/SEL"     , "narrator": "", "text": "そうだね"},
        { "location": "510/SEL"     , "narrator": "", "text": "そうかも"},
        { "location": "511/SEL"     , "narrator": "", "text": "どうかなあ"},
        { "location": "512/ACT"     , "narrator": "", "text": "そうだね"},
        { "location": "513/TALK"    , "narrator": "アーヤ", "text": "でしょ？"},
        { "location": "514/ACT"     , "narrator": "", "text": "そうかも"},
        { "location": "515/TALK"    , "narrator": "アーヤ", "text": "違うかしら？"},
        { "location": "516/ACT"     , "narrator": "", "text": "どうかなあ"},
        { "location": "517/TALK"    , "narrator": "アーヤ", "text": "ちょっと\n不安になるわ…。"},
        { "location": "519/TALK"    , "narrator": "アーヤ", "text": "だからね。\n私、探す。姉の真実を。"},
        { "location": "520/TALK"    , "narrator": "アーヤ", "text": "生きているのか\n死んでいるのか。"},
        { "location": "521/TALK"    , "narrator": "アーヤ", "text": "生きているなら\nどこにいるのか。"},
        { "location": "522/SEL"     , "narrator": "", "text": "$me$も手伝う"},
        { "location": "523/SEL"     , "narrator": "", "text": "$me$と一緒にだよね？"},
        { "location": "524/SEL"     , "narrator": "", "text": "$me$にも協力させてよ"},
        { "location": "525/ACT"     , "narrator": "", "text": "$me$も手伝う"},
        { "location": "526/TALK"    , "narrator": "アーヤ", "text": "…ありがとう。"},
        { "location": "527/TALK"    , "narrator": "アーヤ", "text": "そう言ってくれるって\n思ってた。"},
        { "location": "528/ACT"     , "narrator": "", "text": "$me$と一緒にだよね？"},
        { "location": "529/TALK"    , "narrator": "アーヤ", "text": "もちろんよ。"},
        { "location": "530/TALK"    , "narrator": "アーヤ", "text": "あなたと一緒なら\nきっと見つけられる。"},
        { "location": "531/ACT"     , "narrator": "", "text": "$me$にも協力させてよ"},
        { "location": "532/TALK"    , "narrator": "アーヤ", "text": "私から言おうと\n思ってたのに。"},
        { "location": "534/TALK"    , "narrator": "アーヤ", "text": "改めて言うわ。\n協力ありがとう。\n頼りにしてる。"},
        { "location": "536/TALK"    , "narrator": "アーヤ", "text": "よし。"},
        { "location": "537/TALK"    , "narrator": "アーヤ", "text": "そう決まったら\nぼんやりなんて\nしてられないわ。"},
        { "location": "538/SEL"     , "narrator": "", "text": "あせりは禁物"},
        { "location": "539/SEL"     , "narrator": "", "text": "どーんと行こう！"},
        { "location": "540/SEL"     , "narrator": "", "text": "根詰めすぎないでね"},
        { "location": "541/ACT"     , "narrator": "", "text": "あせりは禁物"},
        { "location": "542/TALK"    , "narrator": "アーヤ", "text": "そうね。\n気を付けるわ。"},
        { "location": "543/TALK"    , "narrator": "アーヤ", "text": "でもそうなったら\n$handle$さんが\n言ってくれるでしょ？"},
        { "location": "544/ACT"     , "narrator": "", "text": "どーんと行こう！"},
        { "location": "545/TALK"    , "narrator": "アーヤ", "text": "それしかないわね。"},
        { "location": "546/TALK"    , "narrator": "アーヤ", "text": "$handle$さんも\nついててくれるんだし。"},
        { "location": "547/ACT"     , "narrator": "", "text": "根詰めすぎないでね"},
        { "location": "548/TALK"    , "narrator": "アーヤ", "text": "そうなっちゃうかもね。"},
        { "location": "549/TALK"    , "narrator": "アーヤ", "text": "でもそんな時は\n$handle$さんが\n助けてくれるでしょ？"},
        { "location": "551/TALK"    , "narrator": "アーヤ", "text": "…もしお姉ちゃんが\nこの世にいないって\n確定しても。"},
        { "location": "552/TALK"    , "narrator": "アーヤ", "text": "$handle$さんが\n側にいてくれる。"},
        { "location": "553/TALK"    , "narrator": "アーヤ", "text": "……ううん。今は\nそんなこと考えない。"},
        { "location": "554/TALK"    , "narrator": "アーヤ", "text": "ただ真実を。\nそれだけを探すの。"},
        { "location": "555/TALK"    , "narrator": "アーヤ", "text": "がんばろう、私…！"},
        { "location": "560/TALK"    , "narrator": "アーヤ", "text": "えっ…！？"},
        { "location": "449/DIALOG"  , "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:Interrupt】</color>\nSystem Interrupted.\n\n必須選択肢が選ばれていません。\n\n<color=green>『STORY27：シン・カグラ』</color>\nにて、選択を行ってから\n再度アクセスしてください。\n"},
        { "location": "566/DIALOG"  , "narrator": "INFO", "text": "<color=red>【TRI-OS Information:0x7F】</color>\n\nココロアドレスの\nコンフリクトを解決しました。\n\n<color=blue>コンフリクトアドレス：\n0x948～0xFFC</color>\n\n再起動します。\n(022)"},
        { "location": "577/DIALOG"  , "narrator": "Dialog_chapter_ch02", "text": "【30 綾水たちの沈黙】"}
    ]
}
