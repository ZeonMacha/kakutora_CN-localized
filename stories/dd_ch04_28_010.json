        "title": "SideStory010 ストーリー",
        "sub_title": "FILE08.責任"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "東京編８話"},
        { "location": "14/DIALOG" , "narrator": "", "text": "<color=green>9月5日　 4:57 PM</color>\nとある平日の放課後、付属学園、図書室にて"},
        { "location": "29/TALK"   , "narrator": "繭", "text": "…………。"},
        { "location": "38/TALK"   , "narrator": "キリト", "text": "ふぁ～…、\nまだ帰んないのか？"},
        { "location": "40/TALK"   , "narrator": "繭", "text": "…気が向いたら帰る。\n帰りたいなら\n勝手に帰ればいい。"},
        { "location": "41/TALK"   , "narrator": "キリト", "text": "冷たいこと言うなよ。\n一緒に帰ろうぜ？"},
        { "location": "44/TALK"   , "narrator": "繭", "text": "…冷たいのは、\nキリトの方じゃない？"},
        { "location": "45/TALK"   , "narrator": "キリト", "text": "なんだよ、いきなり…。"},
        { "location": "46/TALK"   , "narrator": "繭", "text": "さっきの話。\nどうしてひなこに\n賛成しなかったの？"},
        { "location": "47/TALK"   , "narrator": "繭", "text": "ひなこの性格からして、\n絶対にあのまま\n黙って引き下がらない。"},
        { "location": "48/TALK"   , "narrator": "繭", "text": "それがわからないほど、\n鈍くないはずだけど？"},
        { "location": "49/TALK"   , "narrator": "キリト", "text": "…まあな。"},
        { "location": "50/TALK"   , "narrator": "繭", "text": "…ひなこに、一人で\n行動させるつもり？"},
        { "location": "51/TALK"   , "narrator": "キリト", "text": "…そんなの、すぐには\n答えられねぇよ。"},
        { "location": "52/TALK"   , "narrator": "キリト", "text": "でも、本音を言えばさ、\n俺だってひなこに\n賛成したかったさ。"},
        { "location": "53/TALK"   , "narrator": "キリト", "text": "逢瀬を助けることは\nできなくても…。"},
        { "location": "54/TALK"   , "narrator": "キリト", "text": "綾水先輩達の助けになる\nようなことくらいは、\nあるかもしれないだろ？"},
        { "location": "55/TALK"   , "narrator": "キリト", "text": "その方法だけでも\n見つけたいな、ってさ…。"},
        { "location": "56/TALK"   , "narrator": "繭", "text": "じゃあ、どうして\nひなこを手伝うって\n言わなかったの？"},
        { "location": "57/TALK"   , "narrator": "キリト", "text": "…もし俺がひなこを\n手伝うって言ったら、\nおまえはどうしてた？"},
        { "location": "58/TALK"   , "narrator": "繭", "text": "なにもしない。\n自殺行為には\n手を貸さない。"},
        { "location": "59/TALK"   , "narrator": "キリト", "text": "なんて文句言いながら、\n絶対に手伝ってただろ？"},
        { "location": "60/TALK"   , "narrator": "キリト", "text": "俺たちが劇場のバイトを\nするために、東雲教官に\n意見した時みたいにさ。"},
        { "location": "61/TALK"   , "narrator": "繭", "text": "何をバカな…。"},
        { "location": "62/TALK"   , "narrator": "繭", "text": "…待って。\n今の、どういうこと？"},
        { "location": "63/TALK"   , "narrator": "キリト", "text": "は？"},
        { "location": "64/TALK"   , "narrator": "繭", "text": "キリトがひなこを\n手伝うって言わなかった\nことと…。"},
        { "location": "65/TALK"   , "narrator": "繭", "text": "私が手伝うかもしれない\nってこと…、\nなんの関係がある？"},
        { "location": "66/TALK"   , "narrator": "キリト", "text": "…つまりさ。"},
        { "location": "67/TALK"   , "narrator": "キリト", "text": "俺は、繭を危険な目に\n合わせたくねぇ、って\nことだよ。"},
        { "location": "68/TALK"   , "narrator": "繭", "text": "…………え？"},
        { "location": "69/TALK"   , "narrator": "キリト", "text": "…わかるだろ？\n俺が言いたいこと…。"},
        { "location": "70/TALK"   , "narrator": "繭", "text": "そ、それって…え！？\nまさか…。"},
        { "location": "71/TALK"   , "narrator": "キリト", "text": "…おまえはさ、\nどっちかっていうと\n頭脳派だろ？"},
        { "location": "72/TALK"   , "narrator": "キリト", "text": "小学生の頃から\n足だって超遅ぇし…。"},
        { "location": "73/TALK"   , "narrator": "キリト", "text": "だから、もしもの時\nすぐ捕まっちまいそうで\n心配なんだよ。"},
        { "location": "74/TALK"   , "narrator": "繭", "text": "ふっ！"},
        { "location": "80/TALK"   , "narrator": "キリト", "text": "イッテェー！！\nけ、蹴ることねぇだろ！？"},
        { "location": "81/TALK"   , "narrator": "繭", "text": "自業自得よ！"},
        { "location": "82/TALK"   , "narrator": "繭", "text": "黙って聞いてれば、\n人のこと好き勝手\n言いまくって…。"},
        { "location": "83/TALK"   , "narrator": "キリト", "text": "はは、悪かったって。\n足が遅ぇってのは\n事実だけど言い過ぎた。"},
        { "location": "84/TALK"   , "narrator": "繭", "text": "まだ言うか！！"},
        { "location": "85/TALK"   , "narrator": "キリト", "text": "でもさ、俺までひなこを\n手伝うって言ったら、\nマジで協力してただろ？"},
        { "location": "86/TALK"   , "narrator": "繭", "text": "そ、それは…。"},
        { "location": "87/TALK"   , "narrator": "キリト", "text": "…真面目な話さ、\n俺、おまえの幼馴染\nなんだぜ？"},
        { "location": "88/TALK"   , "narrator": "キリト", "text": "繭がなに考えて\nどう動くかくらい、\n簡単に予想できるさ。"},
        { "location": "90/TALK"   , "narrator": "繭", "text": "…………。"},
        { "location": "91/TALK"   , "narrator": "キリト", "text": "…おまえはさ、俺にとって\n一番古い友達なんだ。"},
        { "location": "92/TALK"   , "narrator": "キリト", "text": "なのに、俺のワガママで\n危険な目に合わせるのは\n嫌なんだよ。"},
        { "location": "94/TALK"   , "narrator": "繭", "text": "…私が、ひなこを手伝う\nっていう可能性は、\n考えなかったの？"},
        { "location": "95/TALK"   , "narrator": "キリト", "text": "ありえないな。"},
        { "location": "96/TALK"   , "narrator": "キリト", "text": "ひなこ一人でできること\nなんて、たかが知れてる\nからな。"},
        { "location": "97/TALK"   , "narrator": "キリト", "text": "っていうか、なにすれば\nいいかもわからないと\n思うし…。"},
        { "location": "98/TALK"   , "narrator": "キリト", "text": "放っておいた方が安全、\nって判断するんじゃね？"},
        { "location": "100/TALK"  , "narrator": "繭", "text": "…………。"},
        { "location": "101/TALK"  , "narrator": "キリト", "text": "無言ってことは、\n正解だな。"},
        { "location": "102/TALK"  , "narrator": "繭", "text": "…らしくない。"},
        { "location": "103/TALK"  , "narrator": "キリト", "text": "は？"},
        { "location": "105/TALK"  , "narrator": "繭", "text": "今のがキリトの本音\nだったとしたら…、\nキリトらしくないわ。"},
        { "location": "106/TALK"  , "narrator": "繭", "text": "ひなこや逢瀬さん、\nみやび先輩達だって…。"},
        { "location": "107/TALK"  , "narrator": "繭", "text": "キリトにとっては、\n大切な友達のはず\nなのに。"},
        { "location": "108/TALK"  , "narrator": "繭", "text": "その人達のピンチを\n見過ごすなんて…、\nらしくなさ過ぎる…。"},
        { "location": "109/TALK"  , "narrator": "キリト", "text": "…そうか？"},
        { "location": "110/TALK"  , "narrator": "繭", "text": "そうよ…。\n本当は、何かしたいと\n思ってるんじゃない？"},
        { "location": "111/TALK"  , "narrator": "キリト", "text": "そりゃもちろん。"},
        { "location": "112/TALK"  , "narrator": "繭", "text": "え？"},
        { "location": "113/TALK"  , "narrator": "キリト", "text": "ははっ、どうせ隠しても\n繭にはバレバレだろう\nからな。"},
        { "location": "114/TALK"  , "narrator": "キリト", "text": "その通り…思ってるさ。\n逢瀬も綾水先輩達も\nひなこも助けたいって…。"},
        { "location": "115/TALK"  , "narrator": "キリト", "text": "…思ってるだけ、\nなんだけどな。"},
        { "location": "116/TALK"  , "narrator": "繭", "text": "…………。"},
        { "location": "121/TALK"  , "narrator": "キリト", "text": "ん、ちょい待ち。"},
        { "location": "124/TALK"  , "narrator": "キリト", "text": "…………。"},
        { "location": "126/TALK"  , "narrator": "キリト", "text": "ワルい、ヒカルから\n呼び出しかかった。"},
        { "location": "127/TALK"  , "narrator": "キリト", "text": "まだ残ってるだろ？\nちょっと行ってくるから、\n待っててくれな。"},
        { "location": "130/TALK"  , "narrator": "繭", "text": "…………。"},
        { "location": "132/TALK"  , "narrator": "繭", "text": "これでいい…。\n誰も、危険な目には\n合わないんだから…。"},
        { "location": "134/TALK"  , "narrator": "繭", "text": "なのに…、\nどうして迷うの？"},
        { "location": "135/TALK"  , "narrator": "繭", "text": "キリトはこのまま、\nなにも行動せずに\nいるのが一番のはず…。"},
        { "location": "136/TALK"  , "narrator": "繭", "text": "でも…いずれきっと、\n今日のことを悔やんで\n苦しむ日が来るはず…。"},
        { "location": "137/TALK"  , "narrator": "繭", "text": "私の知ってるキリトなら、\n絶対に…。"},
        { "location": "138/TALK"  , "narrator": "繭", "text": "…………。"},
        { "location": "139/TALK"  , "narrator": "繭", "text": "わからない…。\nどうすることが\n正しいの？"},
        { "location": "151/TALK"  , "narrator": "みやび", "text": "はぁ…ことが済んだら、\n裏ロム携帯は取り上げに\nなるんやろうなぁ…。"},
        { "location": "152/TALK"  , "narrator": "みやび", "text": "苦労して手に入れた\nっちゅうに…、\nとほほ…。"},
        { "location": "156/TALK"  , "narrator": "みやび", "text": "ん？　裏ロムの方に\nメール…うさぎか？"},
        { "location": "159/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "160/TALK"  , "narrator": "みやび", "text": "なんや、これ？"},
        { "location": "161/TALK"  , "narrator": "みやび", "text": "慌ててる？\nあのうさぎが…？"},
        { "location": "162/TALK"  , "narrator": "みやび", "text": "…どういうことや？"},
        { "location": "167/TALK"  , "narrator": "みやび", "text": "相棒"},
        { "location": "168/TALK"  , "narrator": "みやび", "text": "東京の様子はわかるか？"},
        { "location": "170/SEL"   , "narrator": "（選択肢）", "text": "少しならね"},
        { "location": "171/SEL"   , "narrator": "（選択肢）", "text": "どうかしたの？"},
        { "location": "172/ACT"   , "narrator": "", "text": "少しならね"},
        { "location": "173/ACT"   , "narrator": "", "text": "どうかしたの？"},
        { "location": "175/TALK"  , "narrator": "みやび", "text": "うさぎからのメール"},
        { "location": "176/TALK"  , "narrator": "みやび", "text": "内容が普通ではない"},
        { "location": "177/TALK"  , "narrator": "みやび", "text": "『相談したいことがある。助けてほしい。自分では対処できない』"},
        { "location": "178/TALK"  , "narrator": "みやび", "text": "いつものうさぎからは考えられぬ"},
        { "location": "179/TALK"  , "narrator": "みやび", "text": "切羽詰まった文章"},
        { "location": "180/TALK"  , "narrator": "みやび", "text": "いつもならば"},
        { "location": "181/TALK"  , "narrator": "みやび", "text": "絶対に書かない"},
        { "location": "183/SEL"   , "narrator": "（選択肢）", "text": "ちょっと落ち着いて"},
        { "location": "184/SEL"   , "narrator": "（選択肢）", "text": "無事なのは確かだ"},
        { "location": "185/ACT"   , "narrator": "", "text": "ちょっと落ち着いて"},
        { "location": "186/TALK"  , "narrator": "みやび", "text": "うちは冷静だ"},
        { "location": "187/TALK"  , "narrator": "みやび", "text": "冷静さを欠くなど"},
        { "location": "188/TALK"  , "narrator": "みやび", "text": "愚行でしかない"},
        { "location": "189/TALK"  , "narrator": "みやび", "text": "なにが起きたのか"},
        { "location": "190/ACT"   , "narrator": "", "text": "無事なのは確かだ"},
        { "location": "192/TALK"  , "narrator": "みやび", "text": "電話ではなくメール"},
        { "location": "193/TALK"  , "narrator": "みやび", "text": "相談という内容"},
        { "location": "194/TALK"  , "narrator": "みやび", "text": "この内容からして"},
        { "location": "195/TALK"  , "narrator": "みやび", "text": "捕まったわけではないのだろう"},
        { "location": "196/TALK"  , "narrator": "みやび", "text": "けんど"},
        { "location": "197/TALK"  , "narrator": "みやび", "text": "尋常ではないのは確かである"},
        { "location": "198/TALK"  , "narrator": "みやび", "text": "うさぎ達に何が起きたか"},
        { "location": "200/TALK"  , "narrator": "みやび", "text": "それを知りたいのだ"},
        { "location": "202/SEL"   , "narrator": "（選択肢）", "text": "知って、なにができるの？"},
        { "location": "203/SEL"   , "narrator": "（選択肢）", "text": "なら、電話してあげて"},
        { "location": "204/ACT"   , "narrator": "", "text": "知って、なにができるの？"},
        { "location": "206/TALK"  , "narrator": "みやび", "text": "いや"},
        { "location": "208/TALK"  , "narrator": "みやび", "text": "今は何もできぬ"},
        { "location": "209/TALK"  , "narrator": "みやび", "text": "連絡も出来なければ"},
        { "location": "210/TALK"  , "narrator": "みやび", "text": "駆けつけることもできない"},
        { "location": "211/ACT"   , "narrator": "", "text": "なら、電話してあげて"},
        { "location": "212/TALK"  , "narrator": "みやび", "text": "それができないから聞いている！"},
        { "location": "215/TALK"  , "narrator": "みやび", "text": "いや"},
        { "location": "216/TALK"  , "narrator": "みやび", "text": "そういうことか"},
        { "location": "217/TALK"  , "narrator": "みやび", "text": "今のうちは"},
        { "location": "219/TALK"  , "narrator": "みやび", "text": "連絡も出来なければ"},
        { "location": "220/TALK"  , "narrator": "みやび", "text": "駆けつけることもできない"},
        { "location": "223/TALK"  , "narrator": "みやび", "text": "いかんな"},
        { "location": "224/TALK"  , "narrator": "みやび", "text": "慌てていたようだ"},
        { "location": "225/TALK"  , "narrator": "みやび", "text": "愚行に走る危機一髪"},
        { "location": "226/TALK"  , "narrator": "みやび", "text": "助かったぞ、相棒"},
        { "location": "228/SEL"   , "narrator": "（選択肢）", "text": "もう大丈夫なの？"},
        { "location": "229/ACT"   , "narrator": "", "text": "もう大丈夫なの？"},
        { "location": "231/TALK"  , "narrator": "みやび", "text": "落ち着いた"},
        { "location": "232/TALK"  , "narrator": "みやび", "text": "うちに今できることは"},
        { "location": "233/TALK"  , "narrator": "みやび", "text": "データ解析"},
        { "location": "234/TALK"  , "narrator": "みやび", "text": "それに集中するしかない"},
        { "location": "235/TALK"  , "narrator": "みやび", "text": "それ以外に"},
        { "location": "236/TALK"  , "narrator": "みやび", "text": "うちにできることなどない"},
        { "location": "238/TALK"  , "narrator": "みやび", "text": "考えるまでもなかった"},
        { "location": "249/TALK"  , "narrator": "みやび", "text": "…連絡取れない以上、\nうちには何もできん。"},
        { "location": "250/TALK"  , "narrator": "みやび", "text": "ならば気にするだけ\n集中力乱れて、\n作業の妨げになるだけ。"},
        { "location": "251/TALK"  , "narrator": "みやび", "text": "…考えんようにせんと。\nうちは、うさぎからの\nメールなんぞ見ていない。"},
        { "location": "252/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "254/TALK"  , "narrator": "みやび", "text": "堪忍な、うさぎ…。\nけど、今のうちには\n何もできんがよ…。"}
    ]
}
