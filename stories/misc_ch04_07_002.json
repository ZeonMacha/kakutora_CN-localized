        "title": "Extra004 ヒメゴトチャット",
        "sub_title": "それもまた個性"
    },
    "entry":
    [
        { "location": "95/SCENARIO", "narrator": "", "text": "05_000_それもまた個性"},
        { "location": "120/TALK"   , "narrator": "みやび", "text": "ガブちゃんのツンデレぶりが"},
        { "location": "121/TALK"   , "narrator": "みやび", "text": "新人が来てからさらに冴えわたっておる"},
        { "location": "124/SEL"    , "narrator": "", "text": "大変そう"},
        { "location": "125/SEL"    , "narrator": "", "text": "面白そう"},
        { "location": "126/SEL"    , "narrator": "", "text": "それを愛でてると"},
        { "location": "127/ACT"    , "narrator": "", "text": "大変そう"},
        { "location": "128/TALK"   , "narrator": "みやび", "text": "まあな"},
        { "location": "129/ACT"    , "narrator": "", "text": "面白そう"},
        { "location": "130/TALK"   , "narrator": "みやび", "text": "多少は"},
        { "location": "131/ACT"    , "narrator": "", "text": "それを愛でてると"},
        { "location": "133/TALK"   , "narrator": "みやび", "text": "よく見破ったな"},
        { "location": "135/TALK"   , "narrator": "みやび", "text": "誉めてつかわす"},
        { "location": "137/TALK"   , "narrator": "みやび", "text": "ガブちゃんは"},
        { "location": "138/TALK"   , "narrator": "みやび", "text": "実はいい子なんじゃがの"},
        { "location": "140/SEL"    , "narrator": "", "text": "ギャップ萌えだ"},
        { "location": "141/SEL"    , "narrator": "", "text": "何か含んでる？"},
        { "location": "142/ACT"    , "narrator": "", "text": "ギャップ萌えだ"},
        { "location": "143/TALK"   , "narrator": "みやび", "text": "その言い方には語弊がある"},
        { "location": "144/TALK"   , "narrator": "みやび", "text": "というのも"},
        { "location": "145/TALK"   , "narrator": "みやび", "text": "実はガブちゃんはまだつばめちゃんにはデレておらぬ"},
        { "location": "146/TALK"   , "narrator": "みやび", "text": "つまり"},
        { "location": "147/TALK"   , "narrator": "みやび", "text": "ツンしかない"},
        { "location": "148/TALK"   , "narrator": "みやび", "text": "よって"},
        { "location": "149/TALK"   , "narrator": "みやび", "text": "今後に期待ぞね"},
        { "location": "152/ACT"    , "narrator": "", "text": "何か含んでる？"},
        { "location": "153/TALK"   , "narrator": "みやび", "text": "いやいや"},
        { "location": "154/TALK"   , "narrator": "みやび", "text": "勤勉実直なみやびさんが"},
        { "location": "155/TALK"   , "narrator": "みやび", "text": "そんな腹芸などできるものかね"},
        { "location": "156/TALK"   , "narrator": "みやび", "text": "そのことは知っておろう"},
        { "location": "158/TALK"   , "narrator": "みやび", "text": "相棒"}
    ]
}
