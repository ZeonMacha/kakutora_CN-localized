{
    "dir": "chap16/daydra/dd_ch02_16_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "16205",
        "cid": "ayami",
        "title": "005 メインストーリー",
        "sub_title": "誰でもない父だから＜後編＞"
    },
    "entry":
    [
        { "location": "486/TALK"  , "narrator": "アーヤ", "text": "…とか思ってたのに、\n結局心配でついて\nきちゃったわ。"},
        { "location": "487/TALK"  , "narrator": "アーヤ", "text": "はぁ…でもまあ、\nこれでよかったの\nよね。"},
        { "location": "488/TALK"  , "narrator": "アーヤ", "text": "大喧嘩した挙句に\n連れ帰るだのなんだの\n騒ぎ始めたりしたら。"},
        { "location": "489/TALK"  , "narrator": "アーヤ", "text": "それこそ面倒なことに\nなるんだし。"},
        { "location": "490/TALK"  , "narrator": "啓介", "text": "ふむ…つばめがさっき\n読んでいたのは…、\nこの本だったか？"},
        { "location": "492/TALK"  , "narrator": "アーヤ", "text": "とはいえ、できるだけ\n早く静岡に帰って\nもらいたいわ。"},
        { "location": "493/TALK"  , "narrator": "アーヤ", "text": "どうにかして\n帰るように\n説得しないと…。"},
        { "location": "497/TALK"  , "narrator": "アーヤ", "text": "あ、あの…。"},
        { "location": "498/TALK"  , "narrator": "アーヤ", "text": "後のことは\n私たちに任せて、\nそろそろ帰っては――"},
        { "location": "500/TALK"  , "narrator": "啓介", "text": "『特別攻撃隊イッき\nまーすっ♪　～はじめ\nてのふぇのめのん～』"},
        { "location": "502/TALK"  , "narrator": "啓介", "text": "特別攻撃隊？\nつばめ達の本が\n出ていたのか！？"},
        { "location": "506/TALK"  , "narrator": "アーヤ", "text": "ちょ！？　お父さん！\nその本は！！！"},
        { "location": "507/TALK"  , "narrator": "啓介", "text": "…なっ！？"},
        { "location": "509/TALK"  , "narrator": "啓介", "text": "なんだこの本は！！"},
        { "location": "512/TALK"  , "narrator": "アーヤ", "text": "ああ、早速始まった！"},
        { "location": "513/TALK"  , "narrator": "アーヤ", "text": "ちょ、ちょっと、\n大声出さないで\nください！"},
        { "location": "514/TALK"  , "narrator": "アーヤ", "text": "みんな見てますよ？"},
        { "location": "516/TALK"  , "narrator": "啓介", "text": "そんなことは\nどうでもいい！！"},
        { "location": "517/TALK"  , "narrator": "啓介", "text": "君たちは普段、\nフェノメノンの\n中で、中で…！"},
        { "location": "519/TALK"  , "narrator": "啓介", "text": "こんなことを\nやっているのか！！\nああ！？"},
        { "location": "523/TALK"  , "narrator": "アーヤ", "text": "こんなことって…。"},
        { "location": "524/TALK"  , "narrator": "アーヤ", "text": "な、なんですかこの\nヤラしい本は！？"},
        { "location": "526/TALK"  , "narrator": "啓介", "text": "どうなんだ！？"},
        { "location": "529/TALK"  , "narrator": "アーヤ", "text": "こんなの、\nただの創作です！"},
        { "location": "530/TALK"  , "narrator": "アーヤ", "text": "こんなことやってる\nわけないじゃない\nですか！"},
        { "location": "531/TALK"  , "narrator": "アーヤ", "text": "それと、公衆の面前で\n国家機密バラさないで\nください！"},
        { "location": "533/TALK"  , "narrator": "啓介", "text": "いいや、もう結構！"},
        { "location": "534/TALK"  , "narrator": "啓介", "text": "これが事実だろうが\n嘘だろうが、そんなの\nどうでもいい。"},
        { "location": "535/TALK"  , "narrator": "啓介", "text": "二十歳にもならない\n娘がこんな店に\n入れるなどと。"},
        { "location": "536/TALK"  , "narrator": "啓介", "text": "東京はおかしい。\n狂ってる！！"},
        { "location": "537/TALK"  , "narrator": "啓介", "text": "こんなところには\n居させられん。\n家へ連れて帰る！"},
        { "location": "541/TALK"  , "narrator": "アーヤ", "text": "ああもう、なんでこの\n親子は敢えて地雷を\n踏みに行くのか…。"},
        { "location": "543/TALK"  , "narrator": "啓介", "text": "むっ？　つばめ達は\nどこへ行った？"},
        { "location": "546/TALK"  , "narrator": "アーヤ", "text": "え？　さっきまで\nそこの棚の前に…。"},
        { "location": "547/TALK"  , "narrator": "啓介", "text": "いないじゃないか！\nつばめ！\n今すぐ出てきなさい！"},
        { "location": "550/TALK"  , "narrator": "アーヤ", "text": "だから！　そんなこと\nしてたら恥ずかしくて\n出てこれませんって！"},
        { "location": "570/TALK"  , "narrator": "啓介", "text": "はぁ…。"},
        { "location": "571/TALK"  , "narrator": "アーヤ", "text": "ため息吐きたいのは\n私の方なんだけど…。"},
        { "location": "572/TALK"  , "narrator": "アーヤ", "text": "…つばめさん、\n見失っちゃい\nましたね。"},
        { "location": "574/TALK"  , "narrator": "啓介", "text": "…心当たりは\nないのか？"},
        { "location": "575/TALK"  , "narrator": "アーヤ", "text": "私も、秋葉原って\nよくわからなくて…。"},
        { "location": "576/TALK"  , "narrator": "アーヤ", "text": "でも、今から二人を\n見つけるなんて、\n不可能ですよ。"},
        { "location": "577/TALK"  , "narrator": "アーヤ", "text": "もう諦めて、静岡へ\nお戻りになった方が\nいいと思いますよ？"},
        { "location": "579/TALK"  , "narrator": "啓介", "text": "はぁ…。"},
        { "location": "580/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "582/TALK"  , "narrator": "啓介", "text": "…綾水さん、\n君の故郷はどこだ？"},
        { "location": "584/TALK"  , "narrator": "アーヤ", "text": "え？　長野ですよ、\n松代。\nわかります？"},
        { "location": "585/TALK"  , "narrator": "啓介", "text": "ああ、わかる…。\nでは、ご両親は\nそちらに？"},
        { "location": "586/TALK"  , "narrator": "アーヤ", "text": "はい。小さいですが、\n神社をやっています。"},
        { "location": "587/TALK"  , "narrator": "啓介", "text": "そうか…。\n君のご両親も\n大変だな。"},
        { "location": "588/TALK"  , "narrator": "啓介", "text": "こんなところに\n娘を一人でいさせる\nなんて。"},
        { "location": "589/TALK"  , "narrator": "啓介", "text": "気が気じゃない\nだろう。"},
        { "location": "590/TALK"  , "narrator": "アーヤ", "text": "…そうですね。\n多分、今もそうだと\n思います。"},
        { "location": "591/TALK"  , "narrator": "アーヤ", "text": "でも私の父は、\n最終的には私の意思を\n尊重してくれました。"},
        { "location": "592/TALK"  , "narrator": "啓介", "text": "それは君がちゃんと\n独り立ちして\nいるからだ。"},
        { "location": "593/TALK"  , "narrator": "啓介", "text": "しっかりしている\nならば構わない。"},
        { "location": "594/TALK"  , "narrator": "啓介", "text": "…しかしつばめは、\nまだ全然ダメだ。"},
        { "location": "595/TALK"  , "narrator": "アーヤ", "text": "そんなことないと\n思います。"},
        { "location": "597/TALK"  , "narrator": "啓介", "text": "…………。"},
        { "location": "598/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "600/TALK"  , "narrator": "啓介", "text": "…わかった。"},
        { "location": "602/TALK"  , "narrator": "啓介", "text": "正直に言うとな、\n心配なんだよ。"},
        { "location": "603/TALK"  , "narrator": "啓介", "text": "あいつは、絶対に\n自分からは\n何も言わないから…。"},
        { "location": "604/TALK"  , "narrator": "アーヤ", "text": "…？"},
        { "location": "605/TALK"  , "narrator": "啓介", "text": "つばめが小学校の頃、\nちょっとした事件が\nあってな。"},
        { "location": "606/TALK"  , "narrator": "啓介", "text": "あいつは生まれつき\n頭痛持ちなんだ。"},
        { "location": "607/TALK"  , "narrator": "啓介", "text": "授業中に座ったまま\nぶっ倒れたことも\nあった。"},
        { "location": "608/TALK"  , "narrator": "啓介", "text": "大人なら、そういった\n人には気を遣うように\nなる。"},
        { "location": "609/TALK"  , "narrator": "啓介", "text": "が。\n子供は逆だろう。"},
        { "location": "610/TALK"  , "narrator": "啓介", "text": "それを理由に、\n結構いじめられていた\nみたいなんだよ。"},
        { "location": "612/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "613/TALK"  , "narrator": "啓介", "text": "当然、そのことを\nつばめに問いただし\nたんだが……。"},
        { "location": "614/TALK"  , "narrator": "啓介", "text": "いじめがあったことを\n認めなかった。"},
        { "location": "615/TALK"  , "narrator": "啓介", "text": "誰に似たんだか\n知らんが、頑固でね。"},
        { "location": "616/TALK"  , "narrator": "啓介", "text": "その時に思ったんだ。"},
        { "location": "617/TALK"  , "narrator": "啓介", "text": "私はこの子に、\n何がしてやれるん\nだろう、ってな。"},
        { "location": "618/TALK"  , "narrator": "啓介", "text": "人に辛いのを\n見せないこと。"},
        { "location": "619/TALK"  , "narrator": "啓介", "text": "それが娘に\nとっての幸せのやり方\nだったとしても、だ。"},
        { "location": "620/TALK"  , "narrator": "啓介", "text": "そんな我慢なんか\nしてちゃ、本当の幸せ\nなんて掴めやしない。"},
        { "location": "621/TALK"  , "narrator": "啓介", "text": "だから、娘が\n辛い目にあう前に。"},
        { "location": "622/TALK"  , "narrator": "啓介", "text": "できる限りのことを\nしよう、と思った。"},
        { "location": "624/TALK"  , "narrator": "アーヤ", "text": "…つばめさんは、\nそのことを知ってるん\nですか？"},
        { "location": "626/TALK"  , "narrator": "啓介", "text": "いや…私の勝手な\n決心だ。"},
        { "location": "627/TALK"  , "narrator": "啓介", "text": "それに、つばめも\nそんなことは望んで\nないだろう。"},
        { "location": "629/TALK"  , "narrator": "啓介", "text": "だが、そうとわかって\nいても心配なんだよ。"},
        { "location": "630/TALK"  , "narrator": "啓介", "text": "フェノメノンで\n辛い目にあって\nないか。"},
        { "location": "631/TALK"  , "narrator": "啓介", "text": "また、クラスの子に\nイジメられてないか。"},
        { "location": "632/TALK"  , "narrator": "啓介", "text": "ＷＡＶＥや、\n会って話したり\nしても。"},
        { "location": "633/TALK"  , "narrator": "啓介", "text": "大丈夫とか、\nとても楽しいしか\n言わないんだ。"},
        { "location": "635/TALK"  , "narrator": "啓介", "text": "だから、自分の目で\n見て安心したくてな。"},
        { "location": "636/TALK"  , "narrator": "啓介", "text": "それが本当だ、って\nことを…。"},
        { "location": "638/TALK"  , "narrator": "アーヤ", "text": "…そういうこと\nだったんですね。"},
        { "location": "639/TALK"  , "narrator": "啓介", "text": "ああ…。"},
        { "location": "641/TALK"  , "narrator": "アーヤ", "text": "…親って、みんな\nこんな気持ちなの\nかしら？"},
        { "location": "642/TALK"  , "narrator": "アーヤ", "text": "何とか安心させて\nあげたいけど……。"},
        { "location": "643/TALK"  , "narrator": "アーヤ", "text": "今日一日だけで、\n安心してもらえる\nかしら…。"},
        { "location": "651/TALK"  , "narrator": "アーヤ", "text": "っ！　フェノメノン\nアラート！？"},
        { "location": "653/TALK"  , "narrator": "啓介", "text": "何ッ！？"},
        { "location": "657/TALK"  , "narrator": "透明真幌", "text": "フェノメノンの出現を\n確認した。"},
        { "location": "658/TALK"  , "narrator": "透明真幌", "text": "現場は江東区、豊洲。\nすぐに向かってくれ。"},
        { "location": "659/TALK"  , "narrator": "アーヤ", "text": "了解。\nすぐ現場に――"},
        { "location": "660/TALK"  , "narrator": "啓介", "text": "フェノメノンが出たと\nいうことは、つばめも\n出撃するのか！？"},
        { "location": "662/TALK"  , "narrator": "アーヤ", "text": "そ、それはまあ、\nつばめさんも\n隊員なんで…。"},
        { "location": "663/TALK"  , "narrator": "啓介", "text": "…指令室があるのは、\nあの劇場だったな。"},
        { "location": "667/TALK"  , "narrator": "アーヤ", "text": "ちょ！？\nダメですよお父さん！"},
        { "location": "668/TALK"  , "narrator": "アーヤ", "text": "一応政府機関の\n秘密基地なんです\nから。"},
        { "location": "669/TALK"  , "narrator": "アーヤ", "text": "隊員の家族とはいえ、\n一般人は入れないん\nです！"},
        { "location": "671/TALK"  , "narrator": "啓介", "text": "そんな馬鹿な話が\nあるか！"},
        { "location": "672/TALK"  , "narrator": "啓介", "text": "私の娘が命がけで\n戦おうとしているん\nだぞ！？"},
        { "location": "673/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "674/TALK"  , "narrator": "啓介", "text": "誰が止めたとしても、\n私は行くからな。"},
        { "location": "675/TALK"  , "narrator": "透明真幌", "text": "おい、アーヤ。\n今の声、まさか\n逢瀬の父上か！？"},
        { "location": "679/TALK"  , "narrator": "アーヤ", "text": "は、はい…。\nつばめに会いに\n出てきたみたいで…。"},
        { "location": "681/TALK"  , "narrator": "啓介", "text": "その声…確かトライ\nナリーの隊長さんの\n声だったな？"},
        { "location": "682/TALK"  , "narrator": "啓介", "text": "私を指令室へ入れろ。\nつばめの無事を\n確認させてくれ！"},
        { "location": "683/TALK"  , "narrator": "透明真幌", "text": "いや、気持ちはわかり\nますが規則が――"},
        { "location": "684/TALK"  , "narrator": "啓介", "text": "そんなもの知るか！"},
        { "location": "685/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "686/TALK"  , "narrator": "アーヤ", "text": "超が付く心配性で、\n頑固な性格…。"},
        { "location": "687/TALK"  , "narrator": "アーヤ", "text": "この人見てると、\nお父さんのこと\n思い出すなぁ…。"},
        { "location": "688/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "689/TALK"  , "narrator": "アーヤ", "text": "そっか…。\nだから放っておけな\nかったのかも…。"},
        { "location": "690/TALK"  , "narrator": "アーヤ", "text": "でも、それなら…。"},
        { "location": "691/TALK"  , "narrator": "透明真幌", "text": "何度言われても、\n規則を曲げることは\nできません！"},
        { "location": "692/TALK"  , "narrator": "啓介", "text": "ならば勝手に行かせて\nもらうだけだ！"},
        { "location": "693/TALK"  , "narrator": "透明真幌", "text": "何をバカな…。"},
        { "location": "698/TALK"  , "narrator": "アーヤ", "text": "お帰りください。"},
        { "location": "700/TALK"  , "narrator": "啓介", "text": "…なんだと？"},
        { "location": "701/TALK"  , "narrator": "アーヤ", "text": "今日はもう、静岡へ\nお帰りください。"},
        { "location": "702/TALK"  , "narrator": "啓介", "text": "バカなことを言うな！\nこの状況で帰るなんて\nできるはずが！"},
        { "location": "703/TALK"  , "narrator": "アーヤ", "text": "つばめさんのことを\n心配する気持ちは、\nよくわかりました。"},
        { "location": "704/TALK"  , "narrator": "アーヤ", "text": "それでも、今日は\n帰っていただきます。"},
        { "location": "705/TALK"  , "narrator": "アーヤ", "text": "大変申し訳\nありません。"},
        { "location": "706/TALK"  , "narrator": "アーヤ", "text": "これから向かうのは\n命を懸けた戦い\nですから。"},
        { "location": "708/TALK"  , "narrator": "啓介", "text": "……。"},
        { "location": "710/TALK"  , "narrator": "啓介", "text": "わかっている。"},
        { "location": "711/TALK"  , "narrator": "啓介", "text": "だからこそ――"},
        { "location": "712/TALK"  , "narrator": "アーヤ", "text": "だからこそ、\n帰ってください。"},
        { "location": "713/TALK"  , "narrator": "啓介", "text": "…！"},
        { "location": "714/TALK"  , "narrator": "アーヤ", "text": "…つばめさんは、\nとても強いんです。"},
        { "location": "715/TALK"  , "narrator": "アーヤ", "text": "彼女は確実に\n戦果を挙げています。"},
        { "location": "716/TALK"  , "narrator": "アーヤ", "text": "立派な戦士として、\n育っているんです。"},
        { "location": "717/TALK"  , "narrator": "アーヤ", "text": "でも、お父さんが\nここにいることに\n気付いてしまったら。"},
        { "location": "718/TALK"  , "narrator": "アーヤ", "text": "私たちの戦闘に対する\n集中が乱されてしまう\n可能性があるんです。"},
        { "location": "719/TALK"  , "narrator": "アーヤ", "text": "そんなことになれば、\n最悪、仲間に死傷者が\nでるかもしれません。"},
        { "location": "720/TALK"  , "narrator": "アーヤ", "text": "彼女たちをまとめる\nリーダーとして、\nそれは許せません。"},
        { "location": "721/TALK"  , "narrator": "啓介", "text": "……。"},
        { "location": "722/TALK"  , "narrator": "アーヤ", "text": "失礼を承知で\nはっきりと言わせて\nいただきます。"},
        { "location": "723/TALK"  , "narrator": "アーヤ", "text": "戦闘の場において、\nあなたの存在は\n足手まといなんです。"},
        { "location": "724/TALK"  , "narrator": "啓介", "text": "いや…だ、だが、\nしかし…。"},
        { "location": "725/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "726/TALK"  , "narrator": "アーヤ", "text": "小娘が何を、と\nお思いでしょうが。"},
        { "location": "727/TALK"  , "narrator": "アーヤ", "text": "私はトライナリーの\nリーダーです。"},
        { "location": "728/TALK"  , "narrator": "アーヤ", "text": "最も戦闘の経験を\n積んだ隊員です。"},
        { "location": "729/TALK"  , "narrator": "アーヤ", "text": "今まで、一度たりとも\n戦闘で失敗したことは\nありません。"},
        { "location": "730/TALK"  , "narrator": "アーヤ", "text": "また、仲間の中に\n犠牲を出したことも\nありません。"},
        { "location": "731/TALK"  , "narrator": "アーヤ", "text": "そしてこれからも、\n仲間のことを護り\nたい…。"},
        { "location": "732/TALK"  , "narrator": "アーヤ", "text": "例え、自分の身を\n犠牲にしたとしても。"},
        { "location": "734/TALK"  , "narrator": "アーヤ", "text": "だから、私のことを\n信じていただけま\nせんか？"},
        { "location": "736/TALK"  , "narrator": "啓介", "text": "…………。"},
        { "location": "738/TALK"  , "narrator": "啓介", "text": "ひとつだけ\n聞かせてくれ。"},
        { "location": "740/TALK"  , "narrator": "啓介", "text": "…君のお父さんは、\n君の入隊をどうして\n許したんだ？"},
        { "location": "741/TALK"  , "narrator": "アーヤ", "text": "…私を見て、\nと言っていました。"},
        { "location": "742/TALK"  , "narrator": "アーヤ", "text": "東京で、仲間たちに\n囲まれている\n私の姿を見たと。"},
        { "location": "744/TALK"  , "narrator": "アーヤ", "text": "それが楽しそうで、\n幸せそうに見えたから\nだと。"},
        { "location": "746/TALK"  , "narrator": "啓介", "text": "…私には、到底無理な\n話だな。"},
        { "location": "748/TALK"  , "narrator": "啓介", "text": "君の父親のように、\n達観することは\nできない…。"},
        { "location": "749/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "750/TALK"  , "narrator": "啓介", "text": "…だが…確かに今日の\nつばめは、楽しそうに\n笑っていた…。"},
        { "location": "751/TALK"  , "narrator": "啓介", "text": "静岡では見せたことが\nない、本物の笑顔\nだった…。"},
        { "location": "753/TALK"  , "narrator": "啓介", "text": "…私には、何をする\nこともできない。"},
        { "location": "754/TALK"  , "narrator": "啓介", "text": "……代わりに、\nつばめのことを\n護ってくれるか？"},
        { "location": "755/TALK"  , "narrator": "アーヤ", "text": "…私に、任せて\nいただけるので\nあれば。"},
        { "location": "756/TALK"  , "narrator": "啓介", "text": "…そうか。"},
        { "location": "757/TALK"  , "narrator": "啓介", "text": "綾水さんになら、\n委ねてもいいかも\nしれない。"},
        { "location": "758/TALK"  , "narrator": "啓介", "text": "だから、頼む…。\nつばめのことを、\n護ってやってくれ。"},
        { "location": "759/TALK"  , "narrator": "アーヤ", "text": "…わかりました。\n私にお任せください。"},
        { "location": "760/TALK"  , "narrator": "啓介", "text": "…ありがとう。"},
        { "location": "761/TALK"  , "narrator": "啓介", "text": "…君の言う通り、\n今日のところは\n帰るとしよう。"},
        { "location": "762/TALK"  , "narrator": "アーヤ", "text": "…よかった。"},
        { "location": "767/TALK"  , "narrator": "アーヤ", "text": "館長。私は直接\n現場まで\n向かいます。"},
        { "location": "768/TALK"  , "narrator": "アーヤ", "text": "つばめのお父さんの\n迎えをお願いします"},
        { "location": "769/TALK"  , "narrator": "透明真幌", "text": "わかった。\n至急手配する。"},
        { "location": "775/TALK"  , "narrator": "アーヤ", "text": "…迎えが来るまで、\nここで待っていて\nください。"},
        { "location": "776/TALK"  , "narrator": "アーヤ", "text": "それじゃ、\n私も行きますね。"},
        { "location": "777/TALK"  , "narrator": "啓介", "text": "ああ…つばめのこと、\nよろしく頼む。"},
        { "location": "778/TALK"  , "narrator": "啓介", "text": "それと…。"},
        { "location": "779/TALK"  , "narrator": "啓介", "text": "君も気を付けろ！"},
        { "location": "780/TALK"  , "narrator": "アーヤ", "text": "…はい！"},
        { "location": "791/DIALOG", "narrator": "Dialog_chapter_ch02", "text": "【13 電脳料理人】"}
    ]
}
