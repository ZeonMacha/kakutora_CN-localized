        { "location": "2884/SCENARIO", "narrator": "", "text": "13番目の新セカイ"},
        { "location": "2909/TALK"    , "narrator": "神楽", "text": "悪魔の１ダース"},
        { "location": "2910/TALK"    , "narrator": "神楽", "text": "あるいはパン屋の１ダース"},
        { "location": "2912/SEL"     , "narrator": "", "text": "１２じゃないの？"},
        { "location": "2913/SEL"     , "narrator": "", "text": "１３だ"},
        { "location": "2914/SEL"     , "narrator": "", "text": "１６進数だったらわかるんだけどなー"},
        { "location": "2915/ACT"     , "narrator": "", "text": "１２じゃないの？"},
        { "location": "2916/TALK"    , "narrator": "神楽", "text": "違いますぴょん"},
        { "location": "2917/ACT"     , "narrator": "", "text": "１３だ"},
        { "location": "2919/TALK"    , "narrator": "神楽", "text": "あ"},
        { "location": "2920/TALK"    , "narrator": "神楽", "text": "知ってた？"},
        { "location": "2921/TALK"    , "narrator": "神楽", "text": "$handlek$ったらお利口さん♪"},
        { "location": "2922/TALK"    , "narrator": "神楽", "text": "偉い偉い♪"},
        { "location": "2923/ACT"     , "narrator": "", "text": "１６進数だったらわかるんだけどなー"},
        { "location": "2924/TALK"    , "narrator": "神楽", "text": "そういう人はみやびさんところへﾄﾞｿﾞｰ"},
        { "location": "2926/TALK"    , "narrator": "神楽", "text": "１３って数を使わずに１３を表すために生まれた言葉"},
        { "location": "2927/TALK"    , "narrator": "神楽", "text": "そう思うと１３は忌み数なんかじゃなくてむしろ祝福のための数字なんじゃないって思うぴょん"},
        { "location": "2929/SEL"     , "narrator": "", "text": "こじつけだ"},
        { "location": "2930/SEL"     , "narrator": "", "text": "ポジティブな意見だね"},
        { "location": "2931/SEL"     , "narrator": "", "text": "$me$は神楽と一緒に祝福されたい"},
        { "location": "2932/ACT"     , "narrator": "", "text": "こじつけだ"},
        { "location": "2933/TALK"    , "narrator": "神楽", "text": "元々こじつけですしおすし"},
        { "location": "2934/ACT"     , "narrator": "", "text": "ポジティブな意見だね"},
        { "location": "2935/TALK"    , "narrator": "神楽", "text": "その方が楽しくない？"},
        { "location": "2936/ACT"     , "narrator": "", "text": "$me$は神楽と一緒に祝福されたい"},
        { "location": "2938/TALK"    , "narrator": "神楽", "text": "祝福！！！！"},
        { "location": "2939/TALK"    , "narrator": "神楽", "text": "いい言葉だなー"},
        { "location": "2941/TALK"    , "narrator": "神楽", "text": "全世界から受けまくろう！！！"},
        { "location": "2943/TALK"    , "narrator": "神楽", "text": "なんだろうね"},
        { "location": "2944/TALK"    , "narrator": "神楽", "text": "旧態依然を脱却するためのマジックナンバー的な？"},
        { "location": "2946/TALK"    , "narrator": "神楽", "text": "だから１３はある意味未来の数字かななんて思うわけ、ぴょんことしては"}
    ]
