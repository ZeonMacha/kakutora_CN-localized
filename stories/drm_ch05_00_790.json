        "title": "らぶとーく 第79話",
        "sub_title": "約束のできる場所"
    },
    "entry":
    [
        { "location": "249/SCENARIO", "narrator": "", "text": "約束のできる場所"},
        { "location": "259/TALK"    , "narrator": "神楽", "text": "……いい天気に\nなってよかった……。"},
        { "location": "260/TALK"    , "narrator": "神楽", "text": "……ちょっと暑い\nくらいかな。"},
        { "location": "261/TALK"    , "narrator": "神楽", "text": "途中で日焼け止め\n塗り直した方が\nいいかも？"},
        { "location": "262/TALK"    , "narrator": "神楽", "text": "変な焼け方したら\nみっともないし……。"},
        { "location": "264/SEL"     , "narrator": "", "text": "ここどこ？"},
        { "location": "265/SEL"     , "narrator": "", "text": "着いたのかな？"},
        { "location": "266/SEL"     , "narrator": "", "text": "神楽はいつでもかわいいよ"},
        { "location": "267/ACT"     , "narrator": "", "text": "ここどこ？"},
        { "location": "269/TALK"    , "narrator": "神楽", "text": "江ノ島駅。"},
        { "location": "270/ACT"     , "narrator": "", "text": "着いたのかな？"},
        { "location": "272/TALK"    , "narrator": "神楽", "text": "そうだよー。"},
        { "location": "273/ACT"     , "narrator": "", "text": "神楽はいつでもかわいいよ"},
        { "location": "274/TALK"    , "narrator": "神楽", "text": "どうしたの急に？"},
        { "location": "276/TALK"    , "narrator": "神楽", "text": "そんなの知ってるけど。\n……ありがと。"},
        { "location": "279/TALK"    , "narrator": "神楽", "text": "あの山の方向に\n進むから。"},
        { "location": "281/TALK"    , "narrator": "神楽", "text": "……意外と歩く\nみたいだけど。"},
        { "location": "282/SEL"     , "narrator": "", "text": "山じゃなくて\n島でしょ？"},
        { "location": "283/SEL"     , "narrator": "", "text": "アイ、マム！"},
        { "location": "284/SEL"     , "narrator": "", "text": "弁天橋を渡ったら\n江ノ島だね"},
        { "location": "285/ACT"     , "narrator": "", "text": "山じゃなくて\n島でしょ？"},
        { "location": "287/TALK"    , "narrator": "神楽", "text": "えー？"},
        { "location": "288/TALK"    , "narrator": "神楽", "text": "山みたいになってる\n島でしょ？"},
        { "location": "289/ACT"     , "narrator": "", "text": "アイ、マム！"},
        { "location": "290/TALK"    , "narrator": "神楽", "text": "軍隊か！"},
        { "location": "291/TALK"    , "narrator": "神楽", "text": "今日はもっとこう\nゆるふわな感じで\n行きたいな。"},
        { "location": "292/ACT"     , "narrator": "", "text": "弁天橋を渡ったら\n江ノ島だね"},
        { "location": "293/TALK"    , "narrator": "神楽", "text": "そうそう。"},
        { "location": "294/TALK"    , "narrator": "神楽", "text": "この辺詳しいんだ？"},
        { "location": "301/TALK"    , "narrator": "神楽", "text": "この橋の下、\n砂地だけど。"},
        { "location": "302/TALK"    , "narrator": "神楽", "text": "ここって川なの？\nいやもう海なの？"},
        { "location": "303/TALK"    , "narrator": "神楽", "text": "なんだか不思議な感じ。"},
        { "location": "304/SEL"     , "narrator": "", "text": "吃水域ってやつでしょ"},
        { "location": "305/SEL"     , "narrator": "", "text": "水飲めばわかるよ！"},
        { "location": "306/SEL"     , "narrator": "", "text": "謎は謎のままが美しい"},
        { "location": "307/ACT"     , "narrator": "", "text": "吃水域ってやつでしょ"},
        { "location": "308/TALK"    , "narrator": "神楽", "text": "なるほどー。"},
        { "location": "310/TALK"    , "narrator": "神楽", "text": "で？\n川なの？\n海なの？"},
        { "location": "311/ACT"     , "narrator": "", "text": "水飲めばわかるよ！"},
        { "location": "312/TALK"    , "narrator": "神楽", "text": "確かにそうかも。"},
        { "location": "314/TALK"    , "narrator": "神楽", "text": "じゃあ飲んでみて\n$handle$。"},
        { "location": "315/ACT"     , "narrator": "", "text": "謎は謎のままが美しい"},
        { "location": "316/TALK"    , "narrator": "神楽", "text": "そうかもしれない……。"},
        { "location": "318/TALK"    , "narrator": "神楽", "text": "いやそんなに含んだ\n話じゃないけど。"},
        { "location": "325/TALK"    , "narrator": "神楽", "text": "この先に神社があって、\nそこに鳥居があるんだけど\nその鳥居は赤くない。"},
        { "location": "326/TALK"    , "narrator": "神楽", "text": "鳥居が赤くないって\n珍しい気がする。"},
        { "location": "327/SEL"     , "narrator": "", "text": "石の鳥居だと赤くないよ"},
        { "location": "328/SEL"     , "narrator": "", "text": "それは作られたイメージ"},
        { "location": "329/SEL"     , "narrator": "", "text": "確かにそうかも"},
        { "location": "330/ACT"     , "narrator": "", "text": "石の鳥居だと赤くないよ"},
        { "location": "331/TALK"    , "narrator": "神楽", "text": "そういうのもあるの？"},
        { "location": "332/ACT"     , "narrator": "", "text": "それは作られたイメージ"},
        { "location": "333/TALK"    , "narrator": "神楽", "text": "うーん？\nそうなの？"},
        { "location": "334/ACT"     , "narrator": "", "text": "確かにそうかも"},
        { "location": "335/TALK"    , "narrator": "神楽", "text": "でしょでしょ。\n不思議な感じ。"},
        { "location": "338/TALK"    , "narrator": "神楽", "text": "……。\nねえ$handle$。"},
        { "location": "340/TALK"    , "narrator": "神楽", "text": "赤い鳥居と\n赤くない鳥居の\n比率を求める方法は？"},
        { "location": "341/SEL"     , "narrator": "", "text": "本当に知りたいの？"},
        { "location": "342/SEL"     , "narrator": "", "text": "無茶言うなー"},
        { "location": "343/SEL"     , "narrator": "", "text": "まず鳥居の定義からだ"},
        { "location": "344/ACT"     , "narrator": "", "text": "本当に知りたいの？"},
        { "location": "345/TALK"    , "narrator": "神楽", "text": "知りたいわけじゃ\nないんだけど。"},
        { "location": "346/ACT"     , "narrator": "", "text": "無茶言うなー"},
        { "location": "347/TALK"    , "narrator": "神楽", "text": "そうなのかなー？"},
        { "location": "348/ACT"     , "narrator": "", "text": "まず鳥居の定義からだ"},
        { "location": "349/TALK"    , "narrator": "神楽", "text": "うわガチ勢来た。"},
        { "location": "351/TALK"    , "narrator": "神楽", "text": "パパだったら\nそんなこと\n言い出しそうだなって。"},
        { "location": "352/SEL"     , "narrator": "", "text": "えと……何で？"},
        { "location": "353/SEL"     , "narrator": "", "text": "そういう感じの人なんだ"},
        { "location": "354/SEL"     , "narrator": "", "text": "楽しそうだね"},
        { "location": "355/ACT"     , "narrator": "", "text": "えと……何で？"},
        { "location": "357/TALK"    , "narrator": "神楽", "text": "私の方が聞きたいん\nだけど。"},
        { "location": "358/TALK"    , "narrator": "神楽", "text": "そういう人だからって\n答えるしかないの。"},
        { "location": "359/ACT"     , "narrator": "", "text": "そういう感じの人なんだ"},
        { "location": "360/TALK"    , "narrator": "神楽", "text": "そーそー！"},
        { "location": "362/TALK"    , "narrator": "神楽", "text": "そういう人なのー！"},
        { "location": "363/ACT"     , "narrator": "", "text": "楽しそうだね"},
        { "location": "365/TALK"    , "narrator": "神楽", "text": "えええ？"},
        { "location": "366/TALK"    , "narrator": "神楽", "text": "$handle$\nパパと気が合いそう。"},
        { "location": "368/TALK"    , "narrator": "神楽", "text": "パパってさ、\nそういう話ばっかり\n振って来たんだ。"},
        { "location": "369/TALK"    , "narrator": "神楽", "text": "答えに辿り着くまでの\n過程を考えるのが\n楽しいだろとか言って。"},
        { "location": "370/SEL"     , "narrator": "", "text": "神楽は楽しくないの？"},
        { "location": "371/SEL"     , "narrator": "", "text": "うーん…"},
        { "location": "372/SEL"     , "narrator": "", "text": "一人で楽しそうな人だね"},
        { "location": "373/ACT"     , "narrator": "", "text": "神楽は楽しくないの？"},
        { "location": "375/TALK"    , "narrator": "神楽", "text": "楽しいと思う？"},
        { "location": "376/ACT"     , "narrator": "", "text": "うーん…"},
        { "location": "378/TALK"    , "narrator": "神楽", "text": "ちょっとどうかなって\n感じでしょ。"},
        { "location": "379/ACT"     , "narrator": "", "text": "一人で楽しそうな人だね"},
        { "location": "380/TALK"    , "narrator": "神楽", "text": "まあ……\nそうかもね。"},
        { "location": "382/TALK"    , "narrator": "神楽", "text": "私が困ってたら\n模範解答とか\n説明しだしたりして。"},
        { "location": "383/TALK"    , "narrator": "神楽", "text": "前提知識は\nどのレベルかとか\n聞いてきたり。"},
        { "location": "384/TALK"    , "narrator": "神楽", "text": "そうじゃないって。"},
        { "location": "385/TALK"    , "narrator": "神楽", "text": "そんなの年頃の女子が\n面白く思うわけが\nないでしょって。"},
        { "location": "386/SEL"     , "narrator": "", "text": "確かにね"},
        { "location": "387/SEL"     , "narrator": "", "text": "面白そうだけど…？"},
        { "location": "388/SEL"     , "narrator": "", "text": "お父さんのこと好きだったんだね"},
        { "location": "389/ACT"     , "narrator": "", "text": "確かにね"},
        { "location": "390/TALK"    , "narrator": "神楽", "text": "そういうの\nわかんない人だった。"},
        { "location": "391/ACT"     , "narrator": "", "text": "面白そうだけど…？"},
        { "location": "392/TALK"    , "narrator": "神楽", "text": "$handle$は\nパパと同じカテゴリの\n生き物だったんだね…。"},
        { "location": "393/ACT"     , "narrator": "", "text": "お父さんのこと好きだったんだね"},
        { "location": "394/TALK"    , "narrator": "神楽", "text": "……うん。\n大好きだった。"},
        { "location": "396/TALK"    , "narrator": "神楽", "text": "父親としては\nちょっとずれた人\nだったと思う。"},
        { "location": "397/TALK"    , "narrator": "神楽", "text": "でもそれも含めて\n私のパパだし。"},
        { "location": "398/TALK"    , "narrator": "神楽", "text": "仕事に関しては\nスゴイ人なんだって\n思ってた。"},
        { "location": "399/TALK"    , "narrator": "神楽", "text": "だから尊敬してた。"},
        { "location": "401/TALK"    , "narrator": "神楽", "text": "配偶者には\n考えられないけど。"},
        { "location": "402/SEL"     , "narrator": "", "text": "そのポジションは$me$のものだから！"},
        { "location": "403/SEL"     , "narrator": "", "text": "ちょっと妬けるなー"},
        { "location": "404/SEL"     , "narrator": "", "text": "親ってそういうものかも"},
        { "location": "405/ACT"     , "narrator": "", "text": "そのポジションは$me$のものだから！"},
        { "location": "406/TALK"    , "narrator": "神楽", "text": "当たり前でしょ！"},
        { "location": "407/ACT"     , "narrator": "", "text": "ちょっと妬けるなー"},
        { "location": "408/TALK"    , "narrator": "神楽", "text": "そういうんじゃ\nないから。"},
        { "location": "409/ACT"     , "narrator": "", "text": "親ってそういうものかも"},
        { "location": "410/TALK"    , "narrator": "神楽", "text": "なのかな？"},
        { "location": "413/TALK"    , "narrator": "神楽", "text": "時々ね。\n考えちゃう。"},
        { "location": "414/TALK"    , "narrator": "神楽", "text": "パパに\n$handle$の\n話をしたらって。"},
        { "location": "415/TALK"    , "narrator": "神楽", "text": "どんな反応が\n返ってくるんだろうって。"},
        { "location": "416/SEL"     , "narrator": "", "text": "神楽さんを$me$にくださいって言う"},
        { "location": "417/SEL"     , "narrator": "", "text": "紹介したかったってこと？"},
        { "location": "418/SEL"     , "narrator": "", "text": "興味は持ってくれそう"},
        { "location": "419/ACT"     , "narrator": "", "text": "神楽さんを$me$にくださいって言う"},
        { "location": "421/TALK"    , "narrator": "神楽", "text": "それは\n$handle$の\n言いたいことでしょ！？"},
        { "location": "422/ACT"     , "narrator": "", "text": "紹介したかったってこと？"},
        { "location": "423/TALK"    , "narrator": "神楽", "text": "そう……かな。"},
        { "location": "424/ACT"     , "narrator": "", "text": "興味は持ってくれそう"},
        { "location": "426/TALK"    , "narrator": "神楽", "text": "食いつくのが\n目に見える……。"},
        { "location": "428/TALK"    , "narrator": "神楽", "text": "でも多分\n$handle$自身より\n通信手段とか。"},
        { "location": "429/TALK"    , "narrator": "神楽", "text": "プロトコルとか\nそういうところばっかり\n気にしそう。"},
        { "location": "430/TALK"    , "narrator": "神楽", "text": "私はパパに\n$handle$のことを\n話したいのに。"},
        { "location": "431/SEL"     , "narrator": "", "text": "それは嬉しいな"},
        { "location": "432/SEL"     , "narrator": "", "text": "嫌われないならそれでいいよ"},
        { "location": "433/SEL"     , "narrator": "", "text": "緊張するかも……"},
        { "location": "434/ACT"     , "narrator": "", "text": "それは嬉しいな"},
        { "location": "435/TALK"    , "narrator": "神楽", "text": "そう思ってくれる？"},
        { "location": "436/ACT"     , "narrator": "", "text": "嫌われないならそれでいいよ"},
        { "location": "437/TALK"    , "narrator": "神楽", "text": "心広くない！？"},
        { "location": "438/ACT"     , "narrator": "", "text": "緊張するかも……"},
        { "location": "439/TALK"    , "narrator": "神楽", "text": "それは頑張って\nどうにかして！"},
        { "location": "442/TALK"    , "narrator": "神楽", "text": "……そんなこと\n考えても\n仕方ないのにね。"},
        { "location": "443/SEL"     , "narrator": "", "text": "そんなことないよ"},
        { "location": "444/SEL"     , "narrator": "", "text": "そうかもしれないけど"},
        { "location": "445/SEL"     , "narrator": "", "text": "そういうこともあるよ"},
        { "location": "446/ACT"     , "narrator": "", "text": "そんなことないよ"},
        { "location": "447/TALK"    , "narrator": "神楽", "text": "……優しいね\n$handle$は。"},
        { "location": "448/ACT"     , "narrator": "", "text": "そうかもしれないけど"},
        { "location": "449/TALK"    , "narrator": "神楽", "text": "割り切れないから\nこういうのは。"},
        { "location": "450/ACT"     , "narrator": "", "text": "そういうこともあるよ"},
        { "location": "451/TALK"    , "narrator": "神楽", "text": "……多分誰にでも\nあることなんだと\n思うけど……。"},
        { "location": "453/TALK"    , "narrator": "神楽", "text": "そんなことより。\nせっかく来たんだし\n観光もしなきゃ。"},
        { "location": "454/TALK"    , "narrator": "神楽", "text": "気になるものとか\nある？"},
        { "location": "455/SEL"     , "narrator": "", "text": "たこせんべいかなー"},
        { "location": "456/SEL"     , "narrator": "", "text": "気になるのは神楽だけ"},
        { "location": "457/SEL"     , "narrator": "", "text": "今日の目的"},
        { "location": "458/SEL"     , "narrator": "", "text": "よく知らないんだ…"},
        { "location": "459/SEL"     , "narrator": "", "text": "名物って何？"},
        { "location": "460/ACT"     , "narrator": "", "text": "たこせんべいかなー"},
        { "location": "461/TALK"    , "narrator": "神楽", "text": "顔より大きい\n平べったいやつ？"},
        { "location": "462/ACT"     , "narrator": "", "text": "気になるのは神楽だけ"},
        { "location": "463/TALK"    , "narrator": "神楽", "text": "模範解答\nよくできました♪"},
        { "location": "464/ACT"     , "narrator": "", "text": "今日の目的"},
        { "location": "465/TALK"    , "narrator": "神楽", "text": "……まだ内緒。"},
        { "location": "466/ACT"     , "narrator": "", "text": "よく知らないんだ…"},
        { "location": "467/TALK"    , "narrator": "神楽", "text": "そっか。\n実は私も。"},
        { "location": "468/ACT"     , "narrator": "", "text": "名物って何？"},
        { "location": "469/TALK"    , "narrator": "神楽", "text": "色々あるけど\nやっぱり海産物？"},
        { "location": "472/TALK"    , "narrator": "神楽", "text": "あ、ねえ！　あれ！\n貝殻細工のお店って\nすごくない？"},
        { "location": "473/TALK"    , "narrator": "神楽", "text": "……古き良き昭和の\n面影があるって\nいうか……。"},
        { "location": "474/SEL"     , "narrator": "", "text": "ノスタルジーを感じる"},
        { "location": "475/SEL"     , "narrator": "", "text": "ばーちゃんちのテレビの上にあったなー"},
        { "location": "476/SEL"     , "narrator": "", "text": "今どき買う人いるのかな…"},
        { "location": "477/ACT"     , "narrator": "", "text": "ノスタルジーを感じる"},
        { "location": "478/TALK"    , "narrator": "神楽", "text": "すごすぎる。\n別世界すぎる。"},
        { "location": "479/ACT"     , "narrator": "", "text": "ばーちゃんちのテレビの上にあったなー"},
        { "location": "480/TALK"    , "narrator": "神楽", "text": "テレビの上って\n置けなくない？"},
        { "location": "481/ACT"     , "narrator": "", "text": "今どき買う人いるのかな…"},
        { "location": "482/TALK"    , "narrator": "神楽", "text": "心配になるよね～\n超わかる！"},
        { "location": "489/TALK"    , "narrator": "神楽", "text": "仲見世通りを過ぎたら\n普通の山道っぽく\nなってきた。"},
        { "location": "490/TALK"    , "narrator": "神楽", "text": "でもここ上りだけの\nエスカレーターが\nあるから。"},
        { "location": "491/TALK"    , "narrator": "神楽", "text": "乗っちゃおうかなって。"},
        { "location": "492/SEL"     , "narrator": "", "text": "楽できるところは楽しよう"},
        { "location": "493/SEL"     , "narrator": "", "text": "一歩一歩自力で上がるのがいいんだよ"},
        { "location": "494/SEL"     , "narrator": "", "text": "下りはないんだ……"},
        { "location": "495/ACT"     , "narrator": "", "text": "楽できるところは楽しよう"},
        { "location": "497/TALK"    , "narrator": "神楽", "text": "だよね♪"},
        { "location": "498/ACT"     , "narrator": "", "text": "一歩一歩自力で上がるのがいいんだよ"},
        { "location": "500/TALK"    , "narrator": "神楽", "text": "えーえーえーえー\n$handle$だけ\nそうすればいいでしょ。"},
        { "location": "501/ACT"     , "narrator": "", "text": "下りはないんだ……"},
        { "location": "503/TALK"    , "narrator": "神楽", "text": "ねえ？\n本当そう！\n下りも付けて！"},
        { "location": "507/TALK"    , "narrator": "神楽", "text": "入り口は\n山肌っぽいけど\n入ったら普通。"},
        { "location": "509/TALK"    , "narrator": "神楽", "text": "でもすごく\nエスカレーター\n距離長い……。"},
        { "location": "510/TALK"    , "narrator": "神楽", "text": "やっぱり歩いて\n上らなくて\nよかった。"},
        { "location": "512/TALK"    , "narrator": "神楽", "text": "……それでここで\n一旦降りて……。"},
        { "location": "513/TALK"    , "narrator": "神楽", "text": "突き当たりからまた\nエスカレーター。"},
        { "location": "514/TALK"    , "narrator": "神楽", "text": "$handle$に\n問題。"},
        { "location": "515/TALK"    , "narrator": "神楽", "text": "さっき使った\nエスカレーターの\n移動距離を求めよ。"},
        { "location": "516/SEL"     , "narrator": "", "text": "パパ問？"},
        { "location": "517/SEL"     , "narrator": "", "text": "それは永遠に解けないパズル"},
        { "location": "518/SEL"     , "narrator": "", "text": "答え教えて！"},
        { "location": "519/ACT"     , "narrator": "", "text": "パパ問？"},
        { "location": "521/TALK"    , "narrator": "神楽", "text": "ご名答♪"},
        { "location": "522/ACT"     , "narrator": "", "text": "それは永遠に解けないパズル"},
        { "location": "524/TALK"    , "narrator": "神楽", "text": "そんな話じゃ\nないけど？"},
        { "location": "525/ACT"     , "narrator": "", "text": "答え教えて！"},
        { "location": "527/TALK"    , "narrator": "神楽", "text": "私が聞いてるの～！"},
        { "location": "529/TALK"    , "narrator": "神楽", "text": "ロマンティックさの\nかけらもないよね\nこんな話。"},
        { "location": "530/SEL"     , "narrator": "", "text": "それでもいいじゃない"},
        { "location": "531/SEL"     , "narrator": "", "text": "神楽の言葉は全部ロマンティック"},
        { "location": "532/SEL"     , "narrator": "", "text": "むしろロマンを感じる"},
        { "location": "533/ACT"     , "narrator": "", "text": "それでもいいじゃない"},
        { "location": "534/TALK"    , "narrator": "神楽", "text": "いいの？"},
        { "location": "536/TALK"    , "narrator": "神楽", "text": "$handle$って\n本当に変わってる。"},
        { "location": "537/ACT"     , "narrator": "", "text": "神楽の言葉は全部ロマンティック"},
        { "location": "539/TALK"    , "narrator": "神楽", "text": "よしよし！\n模範解答偉い！"},
        { "location": "540/ACT"     , "narrator": "", "text": "むしろロマンを感じる"},
        { "location": "541/TALK"    , "narrator": "神楽", "text": "……そっか。"},
        { "location": "543/TALK"    , "narrator": "神楽", "text": "そういう人も\nいるよね。"},
        { "location": "545/TALK"    , "narrator": "神楽", "text": "でもやっぱり\nＪＫとしては\nロマンスは恋。"},
        { "location": "546/TALK"    , "narrator": "神楽", "text": "……なんて\n安直すぎだし\nベタすぎだけど。"},
        { "location": "547/SEL"     , "narrator": "", "text": "王道って言って！"},
        { "location": "548/SEL"     , "narrator": "", "text": "それを楽しもうよ"},
        { "location": "549/SEL"     , "narrator": "", "text": "だからこそいいんでしょ"},
        { "location": "550/ACT"     , "narrator": "", "text": "王道って言って！"},
        { "location": "551/TALK"    , "narrator": "神楽", "text": "確かにそう言えば\n全部が許される\n感じがする。"},
        { "location": "552/ACT"     , "narrator": "", "text": "それを楽しもうよ"},
        { "location": "553/TALK"    , "narrator": "神楽", "text": "正しい対処ね。"},
        { "location": "554/ACT"     , "narrator": "", "text": "だからこそいいんでしょ"},
        { "location": "555/TALK"    , "narrator": "神楽", "text": "あえて乗ってみると。"},
        { "location": "558/TALK"    , "narrator": "神楽", "text": "この先は\n縁結びの神社が\n三つあるの。"},
        { "location": "559/TALK"    , "narrator": "神楽", "text": "どれだけって\n感じがしない？"},
        { "location": "560/SEL"     , "narrator": "", "text": "ありがたみが薄れそう"},
        { "location": "561/SEL"     , "narrator": "", "text": "それだけ重要なことだから"},
        { "location": "562/SEL"     , "narrator": "", "text": "$me$たちには今さらじゃない？"},
        { "location": "563/ACT"     , "narrator": "", "text": "ありがたみが薄れそう"},
        { "location": "564/TALK"    , "narrator": "神楽", "text": "ありがたみは三乗！"},
        { "location": "565/ACT"     , "narrator": "", "text": "それだけ重要なことだから"},
        { "location": "566/TALK"    , "narrator": "神楽", "text": "……たまには\nいいこと言うね。"},
        { "location": "567/ACT"     , "narrator": "", "text": "$me$たちには今さらじゃない？"},
        { "location": "568/TALK"    , "narrator": "神楽", "text": "それは\nそうなんだけど。"},
        { "location": "570/TALK"    , "narrator": "神楽", "text": "あっでも。今日は\n神社が目的って\nわけじゃないから。"},
        { "location": "571/SEL"     , "narrator": "", "text": "神前式じゃないの？"},
        { "location": "572/SEL"     , "narrator": "", "text": "じゃあ結婚式は？"},
        { "location": "573/SEL"     , "narrator": "", "text": "いきなりハネムーンだった？"},
        { "location": "574/ACT"     , "narrator": "", "text": "神前式じゃないの？"},
        { "location": "575/TALK"    , "narrator": "神楽", "text": "そういうのは\n今回はしない。"},
        { "location": "576/ACT"     , "narrator": "", "text": "じゃあ結婚式は？"},
        { "location": "577/TALK"    , "narrator": "神楽", "text": "この先に二人きりの\n会場があるから。"},
        { "location": "578/ACT"     , "narrator": "", "text": "いきなりハネムーンだった？"},
        { "location": "579/TALK"    , "narrator": "神楽", "text": "ハネムーンの後に\nお式って感じ？"},
        { "location": "581/TALK"    , "narrator": "神楽", "text": "一応お詣りは\nしておこうとは\n思ってるけど。"},
        { "location": "582/TALK"    , "narrator": "神楽", "text": "それは二人を\n見守っててねって\n気持ちだから。"},
        { "location": "583/TALK"    , "narrator": "神楽", "text": "縁はもう\n繋がってるんだしね。"},
        { "location": "584/SEL"     , "narrator": "", "text": "今すごくいいこと言った！"},
        { "location": "585/SEL"     , "narrator": "", "text": "もう一回言って"},
        { "location": "586/SEL"     , "narrator": "", "text": "そう言ってくれて嬉しいよ"},
        { "location": "587/ACT"     , "narrator": "", "text": "今すごくいいこと言った！"},
        { "location": "588/TALK"    , "narrator": "神楽", "text": "いいこととかじゃなくて\n本当のことでしょ？"},
        { "location": "589/ACT"     , "narrator": "", "text": "もう一回言って"},
        { "location": "590/TALK"    , "narrator": "神楽", "text": "……そんな野暮なこと\n言わないの。"},
        { "location": "591/ACT"     , "narrator": "", "text": "そう言ってくれて嬉しいよ"},
        { "location": "592/TALK"    , "narrator": "神楽", "text": "その答えが\nとても嬉しい。"},
        { "location": "594/TALK"    , "narrator": "神楽", "text": "これまで色々\nあったけど。"},
        { "location": "595/TALK"    , "narrator": "神楽", "text": "見捨てないで\nいてくれて\nありがとう。"},
        { "location": "596/SEL"     , "narrator": "", "text": "こちらこそありがとう"},
        { "location": "597/SEL"     , "narrator": "", "text": "そんなの当然でしょ"},
        { "location": "598/SEL"     , "narrator": "", "text": "この先もずっと一緒だから"},
        { "location": "599/ACT"     , "narrator": "", "text": "こちらこそありがとう"},
        { "location": "601/TALK"    , "narrator": "神楽", "text": "……本当に\n感謝してる。"},
        { "location": "602/ACT"     , "narrator": "", "text": "そんなの当然でしょ"},
        { "location": "604/TALK"    , "narrator": "神楽", "text": "ドヤ顔が見えるー！"},
        { "location": "605/ACT"     , "narrator": "", "text": "この先もずっと一緒だから"},
        { "location": "606/TALK"    , "narrator": "神楽", "text": "その約束を\nしに来たの。"},
        { "location": "608/TALK"    , "narrator": "神楽", "text": "行きましょう。"},
        { "location": "609/TALK"    , "narrator": "神楽", "text": "これからの約束をしに。"},
        { "location": "618/TALK"    , "narrator": "神楽", "text": "……着いた。"},
        { "location": "619/TALK"    , "narrator": "神楽", "text": "意外と狭いかも……。"},
        { "location": "622/TALK"    , "narrator": "神楽", "text": "本会場はここ。"},
        { "location": "623/TALK"    , "narrator": "神楽", "text": "ちょっと\nロマンチックでしょ。"},
        { "location": "624/TALK"    , "narrator": "神楽", "text": "ここは恋人の丘。\n愛を誓う場所。"},
        { "location": "625/SEL"     , "narrator": "", "text": "意外なところに"},
        { "location": "626/SEL"     , "narrator": "", "text": "いいねいいね！"},
        { "location": "627/SEL"     , "narrator": "", "text": "ここに来たかったんだ？"},
        { "location": "628/ACT"     , "narrator": "", "text": "意外なところに"},
        { "location": "629/TALK"    , "narrator": "神楽", "text": "そうかな？"},
        { "location": "630/ACT"     , "narrator": "", "text": "いいねいいね！"},
        { "location": "632/TALK"    , "narrator": "神楽", "text": "いいでしょー！"},
        { "location": "633/ACT"     , "narrator": "", "text": "ここに来たかったんだ？"},
        { "location": "634/TALK"    , "narrator": "神楽", "text": "そう。"},
        { "location": "636/TALK"    , "narrator": "神楽", "text": "ここの愛の誓い方は\n他のところとは\nちょっと違う。"},
        { "location": "637/TALK"    , "narrator": "神楽", "text": "南京錠を掛けるの。"},
        { "location": "638/SEL"     , "narrator": "", "text": "ヤンデレキター！"},
        { "location": "639/SEL"     , "narrator": "", "text": "それはなかなか……"},
        { "location": "640/SEL"     , "narrator": "", "text": "レトロな愛の誓い方だね"},
        { "location": "641/ACT"     , "narrator": "", "text": "ヤンデレキター！"},
        { "location": "642/TALK"    , "narrator": "神楽", "text": "フフフ……。"},
        { "location": "643/ACT"     , "narrator": "", "text": "それはなかなか……"},
        { "location": "644/TALK"    , "narrator": "神楽", "text": "いいでしょ？"},
        { "location": "645/ACT"     , "narrator": "", "text": "レトロな愛の誓い方だね"},
        { "location": "646/TALK"    , "narrator": "神楽", "text": "そうかもね。"},
        { "location": "648/TALK"    , "narrator": "神楽", "text": "絶対に離れない\n約束って感じでしょ。"},
        { "location": "649/SEL"     , "narrator": "", "text": "そうなの？"},
        { "location": "650/SEL"     , "narrator": "", "text": "そうだね！"},
        { "location": "651/SEL"     , "narrator": "", "text": "南京錠の強度による"},
        { "location": "652/ACT"     , "narrator": "", "text": "そうなの？"},
        { "location": "653/TALK"    , "narrator": "神楽", "text": "そうなの！"},
        { "location": "654/ACT"     , "narrator": "", "text": "そうだね！"},
        { "location": "655/TALK"    , "narrator": "神楽", "text": "どうかなー？"},
        { "location": "656/ACT"     , "narrator": "", "text": "南京錠の強度による"},
        { "location": "657/TALK"    , "narrator": "神楽", "text": "変に冷静？"},
        { "location": "659/TALK"    , "narrator": "神楽", "text": "こういう陳腐で\n安っぽい愛の\n誓い方が。"},
        { "location": "660/TALK"    , "narrator": "神楽", "text": "逆にリアルで\nいいなって思って。"},
        { "location": "661/SEL"     , "narrator": "", "text": "ツンデレだなー"},
        { "location": "662/SEL"     , "narrator": "", "text": "これも愛だね"},
        { "location": "663/SEL"     , "narrator": "", "text": "ＪＫのリアル難しいな……"},
        { "location": "664/ACT"     , "narrator": "", "text": "ツンデレだなー"},
        { "location": "665/TALK"    , "narrator": "神楽", "text": "そうでもないよ？"},
        { "location": "666/ACT"     , "narrator": "", "text": "これも愛だね"},
        { "location": "667/TALK"    , "narrator": "神楽", "text": "ね？"},
        { "location": "668/ACT"     , "narrator": "", "text": "ＪＫのリアル難しいな……"},
        { "location": "669/TALK"    , "narrator": "神楽", "text": "理解して！"},
        { "location": "671/TALK"    , "narrator": "神楽", "text": "奇跡なんてものは\nどこにもなくて。"},
        { "location": "672/TALK"    , "narrator": "神楽", "text": "毎日が積み重なって\nその先に明日があって。"},
        { "location": "673/TALK"    , "narrator": "神楽", "text": "だったら約束に\n必要なものは\n決心だけじゃない？"},
        { "location": "674/SEL"     , "narrator": "", "text": "わかるようなわからないような"},
        { "location": "675/SEL"     , "narrator": "", "text": "今すぐ誓おう！"},
        { "location": "676/SEL"     , "narrator": "", "text": "神楽とならどこでも平気"},
        { "location": "677/ACT"     , "narrator": "", "text": "わかるようなわからないような"},
        { "location": "678/TALK"    , "narrator": "神楽", "text": "考えるな、感じろ。"},
        { "location": "679/ACT"     , "narrator": "", "text": "今すぐ誓おう！"},
        { "location": "680/TALK"    , "narrator": "神楽", "text": "前のめり過ぎ！"},
        { "location": "681/ACT"     , "narrator": "", "text": "神楽とならどこでも平気"},
        { "location": "683/TALK"    , "narrator": "神楽", "text": "いい台詞だね♪"},
        { "location": "685/TALK"    , "narrator": "神楽", "text": "そして。"},
        { "location": "699/TALK"    , "narrator": "透明神楽", "text": "ここに南京錠を\n用意してきましたー！"},
        { "location": "700/SEL"     , "narrator": "", "text": "何そのノリ……"},
        { "location": "701/SEL"     , "narrator": "", "text": "準備万端だね"},
        { "location": "702/SEL"     , "narrator": "", "text": "よし今すぐ誓おう！"},
        { "location": "703/ACT"     , "narrator": "", "text": "何そのノリ……"},
        { "location": "706/TALK"    , "narrator": "透明神楽", "text": "ダメだった？"},
        { "location": "707/ACT"     , "narrator": "", "text": "準備万端だね"},
        { "location": "710/TALK"    , "narrator": "透明神楽", "text": "当然でしょ～。"},
        { "location": "711/ACT"     , "narrator": "", "text": "よし今すぐ誓おう！"},
        { "location": "714/TALK"    , "narrator": "透明神楽", "text": "早い早い！"},
        { "location": "717/TALK"    , "narrator": "透明神楽", "text": "この錠前に\n名前を書いて。"},
        { "location": "718/TALK"    , "narrator": "透明神楽", "text": "この丘に掛ければ\n約束は成立。"},
        { "location": "719/TALK"    , "narrator": "透明神楽", "text": "絶対に離れないって\n誓いになるの。"},
        { "location": "721/TALK"    , "narrator": "透明神楽", "text": "……大丈夫？\n私なんかと\n永遠を誓って。"},
        { "location": "722/SEL"     , "narrator": "", "text": "そのために来たんだ"},
        { "location": "723/SEL"     , "narrator": "", "text": "望むところ"},
        { "location": "724/SEL"     , "narrator": "", "text": "むしろ$me$でいいの？"},
        { "location": "725/ACT"     , "narrator": "", "text": "そのために来たんだ"},
        { "location": "727/TALK"    , "narrator": "透明神楽", "text": "よく言った！"},
        { "location": "728/ACT"     , "narrator": "", "text": "望むところ"},
        { "location": "730/TALK"    , "narrator": "透明神楽", "text": "偉いじゃない？"},
        { "location": "731/ACT"     , "narrator": "", "text": "むしろ$me$でいいの？"},
        { "location": "733/TALK"    , "narrator": "透明神楽", "text": "むしろ\n$handle$が\nいいの！"},
        { "location": "736/TALK"    , "narrator": "透明神楽", "text": "で？"},
        { "location": "737/TALK"    , "narrator": "透明神楽", "text": "本当に大丈夫？"},
        { "location": "738/SEL"     , "narrator": "", "text": "いいって言ってる"},
        { "location": "739/SEL"     , "narrator": "", "text": "そうじゃなきゃ来ない"},
        { "location": "740/SEL"     , "narrator": "", "text": "今はそう思ってる"},
        { "location": "741/ACT"     , "narrator": "", "text": "いいって言ってる"},
        { "location": "743/TALK"    , "narrator": "透明神楽", "text": "絶対の絶対の絶対？"},
        { "location": "744/TALK"    , "narrator": "透明神楽", "text": "絶対なの？"},
        { "location": "745/ACT"     , "narrator": "", "text": "そうじゃなきゃ来ない"},
        { "location": "747/TALK"    , "narrator": "透明神楽", "text": "うんうん。"},
        { "location": "748/TALK"    , "narrator": "透明神楽", "text": "行動で示したって\nそういうことね。"},
        { "location": "749/ACT"     , "narrator": "", "text": "今はそう思ってる"},
        { "location": "751/TALK"    , "narrator": "透明神楽", "text": "今は、か。"},
        { "location": "752/TALK"    , "narrator": "透明神楽", "text": "正直だね\n$handle$は。"},
        { "location": "756/TALK"    , "narrator": "透明神楽", "text": "いつまでも\n同じことを聞いても\n仕方ないよね。"},
        { "location": "758/TALK"    , "narrator": "透明神楽", "text": "$handle$は\nずっと私に優しく\nしてくれて。"},
        { "location": "759/TALK"    , "narrator": "透明神楽", "text": "私のやなとこや\nおかしいところも\n知ってて。"},
        { "location": "761/TALK"    , "narrator": "透明神楽", "text": "それでも側に\nいてくれる。"},
        { "location": "763/TALK"    , "narrator": "透明神楽", "text": "だよね？"},
        { "location": "764/SEL"     , "narrator": "", "text": "神楽はなんでもできる子だよ"},
        { "location": "765/SEL"     , "narrator": "", "text": "こっちこそ側にいてくれる？"},
        { "location": "766/SEL"     , "narrator": "", "text": "そういうところもかわいいよ"},
        { "location": "767/ACT"     , "narrator": "", "text": "神楽はなんでもできる子だよ"},
        { "location": "770/TALK"    , "narrator": "透明神楽", "text": "そんなことは\nあるかもだけどー！"},
        { "location": "771/ACT"     , "narrator": "", "text": "こっちこそ側にいてくれる？"},
        { "location": "774/TALK"    , "narrator": "透明神楽", "text": "いるし！\n超いるし！"},
        { "location": "775/ACT"     , "narrator": "", "text": "そういうところもかわいいよ"},
        { "location": "778/TALK"    , "narrator": "透明神楽", "text": "ちょっと照れる……。"},
        { "location": "781/TALK"    , "narrator": "透明神楽", "text": "……うん。"},
        { "location": "782/TALK"    , "narrator": "透明神楽", "text": "じゃあ鍵掛けてくる。"},
        { "location": "783/SEL"     , "narrator": "", "text": "神楽！"},
        { "location": "784/ACT"     , "narrator": "", "text": "神楽！"},
        { "location": "786/TALK"    , "narrator": "透明神楽", "text": "何？"},
        { "location": "787/SEL"     , "narrator": "", "text": "愛してる"},
        { "location": "788/SEL"     , "narrator": "", "text": "永遠に一緒だから"},
        { "location": "789/SEL"     , "narrator": "", "text": "ずっと側にいるからね"},
        { "location": "790/SEL"     , "narrator": "", "text": "大好き！！！"},
        { "location": "791/SEL"     , "narrator": "", "text": "この瞬間を忘れない"},
        { "location": "792/ACT"     , "narrator": "", "text": "愛してる"},
        { "location": "794/TALK"    , "narrator": "透明神楽", "text": "……私も。"},
        { "location": "795/ACT"     , "narrator": "", "text": "永遠に一緒だから"},
        { "location": "797/TALK"    , "narrator": "透明神楽", "text": "絶対だからね。"},
        { "location": "798/ACT"     , "narrator": "", "text": "ずっと側にいるからね"},
        { "location": "800/TALK"    , "narrator": "透明神楽", "text": "守ってよね！"},
        { "location": "801/ACT"     , "narrator": "", "text": "大好き！！！"},
        { "location": "803/TALK"    , "narrator": "透明神楽", "text": "恥ずかしい……。"},
        { "location": "804/ACT"     , "narrator": "", "text": "この瞬間を忘れない"},
        { "location": "806/TALK"    , "narrator": "透明神楽", "text": "心に焼き付けておいて。"},
        { "location": "809/TALK"    , "narrator": "透明神楽", "text": "断るなら今のうちだから。"},
        { "location": "812/TALK"    , "narrator": "透明神楽", "text": "なんて。\nそれはもう無理。"},
        { "location": "813/SEL"     , "narrator": "", "text": "無理に決まってる！"},
        { "location": "814/SEL"     , "narrator": "", "text": "安心した……。"},
        { "location": "815/SEL"     , "narrator": "", "text": "すぐからかうんだから～"},
        { "location": "816/ACT"     , "narrator": "", "text": "無理に決まってる！"},
        { "location": "818/TALK"    , "narrator": "透明神楽", "text": "だよね！"},
        { "location": "819/ACT"     , "narrator": "", "text": "安心した……。"},
        { "location": "821/TALK"    , "narrator": "透明神楽", "text": "びっくりした？"},
        { "location": "822/ACT"     , "narrator": "", "text": "すぐからかうんだから～"},
        { "location": "824/TALK"    , "narrator": "透明神楽", "text": "その方が楽しいでしょ？"},
