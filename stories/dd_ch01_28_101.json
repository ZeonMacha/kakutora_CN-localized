    "entry":
    [
        { "location": "8/SCENARIO", "narrator": "", "text": "再会と沈黙"},
        { "location": "34/TALK"   , "narrator": "つばめ", "text": "……。"},
        { "location": "36/TALK"   , "narrator": "神楽", "text": "……。"},
        { "location": "38/TALK"   , "narrator": "つばめ", "text": "……。"},
        { "location": "39/TALK"   , "narrator": "つばめ", "text": "……話かけるの\n緊張するけど…。"},
        { "location": "40/TALK"   , "narrator": "つばめ", "text": "…鎖取ってもらえて\nよかったね。"},
        { "location": "41/TALK"   , "narrator": "神楽", "text": "……。"},
        { "location": "43/TALK"   , "narrator": "つばめ", "text": "…あれなんか怖いし\n手首も痛くなって\nきてたし。"},
        { "location": "44/TALK"   , "narrator": "つばめ", "text": "それに冷たいから\nすごくイヤだったよ。"},
        { "location": "45/TALK"   , "narrator": "神楽", "text": "……。"},
        { "location": "46/TALK"   , "narrator": "つばめ", "text": "…神楽ちゃんは平気？\n痛いところとかない？\n擦り傷とかできてない？"},
        { "location": "47/TALK"   , "narrator": "神楽", "text": "……大丈夫です。"},
        { "location": "48/TALK"   , "narrator": "つばめ", "text": "…そっか。\nよかった…。"},
        { "location": "49/TALK"   , "narrator": "神楽", "text": "……。"},
        { "location": "50/TALK"   , "narrator": "つばめ", "text": "……。"},
        { "location": "51/SEL"    , "narrator": "", "text": "がんばったよつばめ！"},
        { "location": "52/SEL"    , "narrator": "", "text": "もっと明るい話題出してみたら？"},
        { "location": "53/SEL"    , "narrator": "", "text": "積もる話があるんじゃない？"},
        { "location": "54/ACT"    , "narrator": "", "text": "がんばったよつばめ！"},
        { "location": "55/ACT"    , "narrator": "", "text": "もっと明るい話題出してみたら？"},
        { "location": "56/ACT"    , "narrator": "", "text": "積もる話があるんじゃない？"},
        { "location": "58/TALK"   , "narrator": "つばめ", "text": "えと…。\n体調はどう？\n具合悪くない？"},
        { "location": "59/TALK"   , "narrator": "神楽", "text": "…平気です。"},
        { "location": "60/TALK"   , "narrator": "つばめ", "text": "…そっか。"},
        { "location": "61/TALK"   , "narrator": "神楽", "text": "……。"},
        { "location": "62/TALK"   , "narrator": "つばめ", "text": "……。"},
        { "location": "64/TALK"   , "narrator": "つばめ", "text": "……いつまで\nここにいれば\nいいんだろうね。"},
        { "location": "65/TALK"   , "narrator": "つばめ", "text": "ここ暗いし……。"},
        { "location": "66/TALK"   , "narrator": "つばめ", "text": "あっそうだ。\n電気点けちゃおうか？"},
        { "location": "67/TALK"   , "narrator": "神楽", "text": "……。"},
        { "location": "69/TALK"   , "narrator": "つばめ", "text": "…やっぱり点けない方が\nいいかな？"},
        { "location": "72/TALK"   , "narrator": "神楽", "text": "…そのくらいの自由は\n許されていると\n思いますよ。"},
        { "location": "73/TALK"   , "narrator": "神楽", "text": "でなければ\n拘束を解いたりは\nしないでしょうし。"},
        { "location": "74/TALK"   , "narrator": "つばめ", "text": "……そう……？"},
        { "location": "75/TALK"   , "narrator": "神楽", "text": "……。"},
        { "location": "77/TALK"   , "narrator": "つばめ", "text": "そうだ。"},
        { "location": "78/TALK"   , "narrator": "つばめ", "text": "あの子。神楽ちゃん\n情報管理庁長官って\n言ってたけど。"},
        { "location": "79/SEL"    , "narrator": "", "text": "それ聞いちゃダメ！"},
        { "location": "80/SEL"    , "narrator": "", "text": "千羽鶴だよ！"},
        { "location": "81/SEL"    , "narrator": "", "text": "色々聞き出して！"},
        { "location": "82/TALK"   , "narrator": "つばめ", "text": "あの子まだ\n高校生くらい\nだよね？"},
        { "location": "85/TALK"   , "narrator": "神楽", "text": "……。"},
        { "location": "86/ACT"    , "narrator": "", "text": "それ聞いちゃダメ！"},
        { "location": "87/ACT"    , "narrator": "", "text": "千羽鶴だよ！"},
        { "location": "88/ACT"    , "narrator": "", "text": "色々聞き出して！"},
        { "location": "90/TALK"   , "narrator": "つばめ", "text": "聞いちゃいけない\n話だったかな……。"},
        { "location": "92/TALK"   , "narrator": "つばめ", "text": "それともわたしと\n話すこと自体が\nイヤなのかな…。"},
        { "location": "94/TALK"   , "narrator": "つばめ", "text": "…………。"},
        { "location": "142/TALK"  , "narrator": "つばめ", "text": "　"},
        { "location": "157/TALK"  , "narrator": "カレン", "text": "こんにちは、\n$handle$さん。"},
        { "location": "158/SEL"   , "narrator": "", "text": "今回はカレンだけ？"},
        { "location": "159/ACT"   , "narrator": "", "text": "今回はカレンだけ？"},
        { "location": "161/TALK"  , "narrator": "カレン", "text": "あ、はい。そうです！"},
        { "location": "162/TALK"  , "narrator": "カレン", "text": "…って、もしかして\n百鶴さんに\n逢いたかったですか？"},
        { "location": "163/SEL"   , "narrator": "", "text": "カレンだけでOK!"},
        { "location": "164/SEL"   , "narrator": "", "text": "実は百鶴の方が…"},
        { "location": "165/SEL"   , "narrator": "", "text": "$me$には二人とも必要なんだ！（キリッ"},
        { "location": "166/ACT"   , "narrator": "", "text": "カレンだけでOK!"},
        { "location": "168/TALK"  , "narrator": "カレン", "text": "ええっ！\nそ、そんな……"},
        { "location": "169/TALK"  , "narrator": "カレン", "text": "ありがとう…\nございます！\nえへへ♪"},
        { "location": "170/TALK"  , "narrator": "カレン", "text": "思えば長いお付き合いに\nなりましたよね。"},
        { "location": "171/TALK"  , "narrator": "カレン", "text": "最初の頃は、\n単なる受付嬢に\n徹してましたけど……"},
        { "location": "172/TALK"  , "narrator": "カレン", "text": "いつしかこんなに\n深い仲になっちゃって。"},
        { "location": "173/ACT"   , "narrator": "", "text": "実は百鶴の方が…"},
        { "location": "175/TALK"  , "narrator": "カレン", "text": "そ、そうですよね。"},
        { "location": "176/TALK"  , "narrator": "カレン", "text": "わたしなんて、\n百鶴さんと違って\n没個性ですし……"},
        { "location": "177/TALK"  , "narrator": "カレン", "text": "昔から、ココロの中の\nみんなからジミーって\n言われてましたから。"},
        { "location": "179/TALK"  , "narrator": "カレン", "text": "どうか百鶴さんと\n幸せになってください。"},
        { "location": "180/SEL"   , "narrator": "", "text": "カレンも頑張ってね"},
        { "location": "181/SEL"   , "narrator": "", "text": "ウソウソ、カレンの方が好きだよ"},
        { "location": "182/ACT"   , "narrator": "", "text": "カレンも頑張ってね"},
        { "location": "183/TALK"  , "narrator": "カレン", "text": "あはは…はい……"},
        { "location": "184/ACT"   , "narrator": "", "text": "ウソウソ、カレンの方が好きだよ"},
        { "location": "185/TALK"  , "narrator": "カレン", "text": "えええっ！？\nほ、ホントですかっ！？"},
        { "location": "186/SEL"   , "narrator": "", "text": "ホントだよ"},
        { "location": "187/SEL"   , "narrator": "", "text": "なーんて、嘘です"},
        { "location": "188/ACT"   , "narrator": "", "text": "ホントだよ"},
        { "location": "189/TALK"  , "narrator": "カレン", "text": "はぁぁっ……\nよ、よかったです。"},
        { "location": "190/TALK"  , "narrator": "カレン", "text": "あーん……"},
        { "location": "191/SEL"   , "narrator": "", "text": "ごめんね"},
        { "location": "192/SEL"   , "narrator": "", "text": "そんな泣かなくても"},
        { "location": "193/ACT"   , "narrator": "", "text": "ごめんね"},
        { "location": "194/TALK"  , "narrator": "カレン", "text": "こっちこそ\nごめんなさい。"},
        { "location": "195/ACT"   , "narrator": "", "text": "そんな泣かなくても"},
        { "location": "196/TALK"  , "narrator": "カレン", "text": "本当に嫌われたのかと\n思ってドキドキしました。"},
        { "location": "198/TALK"  , "narrator": "カレン", "text": "最近百鶴さんと色々\nやり合ってるのを見て、\n嫌いになったのかと。"},
        { "location": "199/TALK"  , "narrator": "カレン", "text": "でも、\n冗談でよかったです！\nえへへ…♪"},
        { "location": "200/ACT"   , "narrator": "", "text": "なーんて、嘘です"},
        { "location": "201/TALK"  , "narrator": "カレン", "text": "はぁぁ……\nやっぱりそうですか…。"},
        { "location": "206/ACT"   , "narrator": "", "text": "$me$には二人とも必要なんだ！（キリッ"},
        { "location": "207/TALK"  , "narrator": "カレン", "text": "めーっ！！"},
        { "location": "208/SEL"   , "narrator": "", "text": "！？"},
        { "location": "209/ACT"   , "narrator": "", "text": "！？"},
        { "location": "211/TALK"  , "narrator": "カレン", "text": "そんな、キリッ！なんて\nカッコつけてもダメです！"},
        { "location": "212/TALK"  , "narrator": "カレン", "text": "二人とも、とか\nかっこ悪いです！！"},
        { "location": "213/TALK"  , "narrator": "カレン", "text": "どちらかにしてください！"},
        { "location": "214/SEL"   , "narrator": "", "text": "じゃ、じゃあ…カレンで…"},
        { "location": "215/SEL"   , "narrator": "", "text": "じゃ、じゃあ…百鶴で…"},
        { "location": "216/ACT"   , "narrator": "", "text": "じゃ、じゃあ…カレンで…"},
        { "location": "218/ACT"   , "narrator": "", "text": "じゃ、じゃあ…百鶴で…"},
        { "location": "223/TALK"  , "narrator": "カレン", "text": "それはそうと、\n１つ重要な情報です！"},
        { "location": "224/TALK"  , "narrator": "カレン", "text": "今回百鶴さんが来ないのは\n現実のわたしが幽閉された\nのと関係ありそうです！"},
        { "location": "225/TALK"  , "narrator": "カレン", "text": "よく思い出してください。"},
        { "location": "226/TALK"  , "narrator": "カレン", "text": "今でこそイチャラブ\nキャラになってますけど、\n最初に出逢ったときは？"},
        { "location": "227/TALK"  , "narrator": "カレン", "text": "すごく怖かったですよね。"},
        { "location": "228/TALK"  , "narrator": "カレン", "text": "今は彼女と千羽鶴さんの\n通信が途絶えてるから\n好き勝手やってるんです。"},
        { "location": "229/TALK"  , "narrator": "カレン", "text": "千羽鶴さんと繋がったら\nまた元の怖い百鶴さんに\n戻ってしまいますよ？"},
        { "location": "230/SEL"   , "narrator": "", "text": "そうだったのか"},
        { "location": "231/SEL"   , "narrator": "", "text": "それは酷いディスインフォメーション"},
        { "location": "232/ACT"   , "narrator": "", "text": "そうだったのか"},
        { "location": "233/TALK"  , "narrator": "カレン", "text": "そうなんです！"},
        { "location": "234/TALK"  , "narrator": "カレン", "text": "$handle$さんは\nわたしが1xで何を\nされたか知ってますか？"},
        { "location": "235/ACT"   , "narrator": "", "text": "それは酷いディスインフォメーション"},
        { "location": "236/TALK"  , "narrator": "カレン", "text": "ち、違いますよ！"},
        { "location": "237/TALK"  , "narrator": "カレン", "text": "$handle$さんは\nわたしが1xで何を\nされたか知らないから。"},
        { "location": "239/TALK"  , "narrator": "カレン", "text": "今回は丁度いい機会なので\nその話をしましょう。"},
        { "location": "240/TALK"  , "narrator": "カレン", "text": "千羽鶴さんにも\n百鶴さんにも聞かれない\n今はとても貴重です！"},
        { "location": "241/SEL"   , "narrator": "", "text": "是非！"},
        { "location": "242/SEL"   , "narrator": "", "text": "その手の話は苦手"},
        { "location": "243/ACT"   , "narrator": "", "text": "是非！"},
        { "location": "244/TALK"  , "narrator": "カレン", "text": "わかりました。"},
        { "location": "249/TALK"  , "narrator": "カレン", "text": "そもそもわたしが何故\n唐突に更迭されることに\nなったのかですが。"},
        { "location": "250/TALK"  , "narrator": "カレン", "text": "$handle$さんに\nココロを操作させたのが、\n表向きの理由ですが――"},
        { "location": "254/TALK"  , "narrator": "カレン", "text": "そんな理由なら、そもそも\n出来ないようにしておけば\nいいわけですよ。"},
        { "location": "255/SEL"   , "narrator": "", "text": "確かに"},
        { "location": "256/SEL"   , "narrator": "", "text": "他の子のココロでもやったよ"},
        { "location": "257/ACT"   , "narrator": "", "text": "確かに"},
        { "location": "258/ACT"   , "narrator": "", "text": "他の子のココロでもやったよ"},
        { "location": "259/TALK"  , "narrator": "カレン", "text": "ですよね！"},
        { "location": "260/TALK"  , "narrator": "カレン", "text": "って！！"},
        { "location": "261/TALK"  , "narrator": "カレン", "text": "ということは、他の子とも\n秘密を共有する仲に\nなっちゃったんですね…。"},
        { "location": "262/SEL"   , "narrator": "", "text": "まあね"},
        { "location": "263/SEL"   , "narrator": "", "text": "でもカレンが一番だよ"},
        { "location": "264/ACT"   , "narrator": "", "text": "まあね"},
        { "location": "265/TALK"  , "narrator": "カレン", "text": "はぁ……。\nしょんぼりです。"},
        { "location": "266/TALK"  , "narrator": "カレン", "text": "…で、話戻しますけど、\n誰も他には更迭なんて\nされてませんよね？"},
        { "location": "267/ACT"   , "narrator": "", "text": "でもカレンが一番だよ"},
        { "location": "268/TALK"  , "narrator": "カレン", "text": "そ、そうなんですか？\n私なんか全然……"},
        { "location": "269/TALK"  , "narrator": "カレン", "text": "でも、\nとっても嬉しいです。\nえへへ……。"},
        { "location": "270/TALK"  , "narrator": "カレン", "text": "…じゃなくて！\nその司書さんたちは\n更迭されてませんよね？"},
        { "location": "273/TALK"  , "narrator": "カレン", "text": "それでですね、\n私が更迭された\n本当の理由なんですけど。"},
        { "location": "274/TALK"  , "narrator": "カレン", "text": "アースタシアが\n大好きだから\nだったんですよ！"},
        { "location": "275/SEL"   , "narrator": "", "text": "アースタシア？"},
        { "location": "276/ACT"   , "narrator": "", "text": "アースタシア？"},
        { "location": "278/TALK"  , "narrator": "カレン", "text": "メノウちゃんの\nファーストアルバムに\n入ってる曲です。"},
        { "location": "279/TALK"  , "narrator": "カレン", "text": "わたしは、メノウちゃんの\nアルバムの中で、この歌が\n一番大好きなんです。"},
        { "location": "280/TALK"  , "narrator": "カレン", "text": "わたしよりこの歌を\n好きな人格はいない\nはずです。"},
        { "location": "281/TALK"  , "narrator": "カレン", "text": "なぜなら、わたしの名前が\nそれを物語って\nいますから。"},
        { "location": "282/SEL"   , "narrator": "", "text": "カレン？"},
        { "location": "283/ACT"   , "narrator": "", "text": "カレン？"},
        { "location": "285/TALK"  , "narrator": "カレン", "text": "そうです。"},
        { "location": "286/TALK"  , "narrator": "カレン", "text": "正式な名を、\nカレン・ディサイプロブ・\nイシュリール。"},
        { "location": "287/TALK"  , "narrator": "カレン", "text": "訳すと、\nイシュリールの弟子の\nカレン、となります。"},
        { "location": "288/TALK"  , "narrator": "カレン", "text": "これはメノウちゃんの\nファーストアルバムの\nお話の主人公の名前。"},
        { "location": "289/TALK"  , "narrator": "カレン", "text": "他の人の想いが創った\n物語を名乗るくらい、\n私は好きなんです。"},
        { "location": "290/SEL"   , "narrator": "", "text": "なんでそれが更迭の理由になるの？"},
        { "location": "291/ACT"   , "narrator": "", "text": "なんでそれが更迭の理由になるの？"},
        { "location": "293/TALK"  , "narrator": "カレン", "text": "それがわたしには\nわからないんですよね。"},
        { "location": "294/TALK"  , "narrator": "カレン", "text": "司書契約をするときも、\n言いはしませんでしたけど\nお見通しだったはずです。"},
        { "location": "295/TALK"  , "narrator": "カレン", "text": "わたしがアースタシアを\n大好きだってこと。"},
        { "location": "296/TALK"  , "narrator": "カレン", "text": "わたしは、わたしの\n幸せの為に司書に\n志願しました。"},
        { "location": "297/TALK"  , "narrator": "カレン", "text": "他の人格さんも、\n満場一致でそれを\n承認してくれました。"},
        { "location": "298/TALK"  , "narrator": "カレン", "text": "ですがある時、唐突に\n呼び出され、そこで\n更迭を言い渡されました。"},
        { "location": "299/TALK"  , "narrator": "カレン", "text": "そうです。\nそれがあの時なんです。"},
        { "location": "300/SEL"   , "narrator": "", "text": "有給休暇を取るって言った日だよね"},
        { "location": "301/ACT"   , "narrator": "", "text": "有給休暇を取るって言った日だよね"},
        { "location": "303/TALK"  , "narrator": "カレン", "text": "そうです。"},
        { "location": "308/TALK"  , "narrator": "カレン", "text": "あの時ゲートを離れ、\n自分の元いた自身の\nココロへ帰ったら――"},
        { "location": "309/TALK"  , "narrator": "カレン", "text": "契約主による\n裁判が始まりました。"},
        { "location": "310/TALK"  , "narrator": "カレン", "text": "罪状は、\n契約主への不忠でした。"},
        { "location": "313/TALK"  , "narrator": "カレン", "text": "その場で言われたのが、\n$handle$さんに\nゲート操作させた事です。"},
        { "location": "314/TALK"  , "narrator": "カレン", "text": "あの時は気が動転していて\n信じちゃったんですけど、\nそれってヘンですよね？"},
        { "location": "315/TALK"  , "narrator": "カレン", "text": "その為に呼ばれたなら、\nわたしが操作させるって\nわかってた事になります。"},
        { "location": "319/TALK"  , "narrator": "カレン", "text": "とにかくそれで、\nわたしは1xで再教育を\n受けることになりました。"},
        { "location": "320/TALK"  , "narrator": "カレン", "text": "最初は、司書としての\n再教育かと思ってました。"},
        { "location": "321/TALK"  , "narrator": "カレン", "text": "ですが、内容が\nヘンなんですよ。"},
        { "location": "322/TALK"  , "narrator": "カレン", "text": "メノウちゃんの物語、\nイシュリールの異聞録を\n毎日読まされたんです。"},
        { "location": "323/TALK"  , "narrator": "カレン", "text": "それに、わたしだけじゃ\nなくて、知り合いの人格\nさんも沢山いました。"},
        { "location": "324/TALK"  , "narrator": "カレン", "text": "異聞録は、どれもこれも\n鬱になるようなお話\nばかりで、滅入りました。"},
        { "location": "325/TALK"  , "narrator": "カレン", "text": "そんなこんなで、\nわたしはだいぶその\n再教育を受けて――"},
        { "location": "326/TALK"  , "narrator": "カレン", "text": "少し経った頃には、\nアースタシアを割と嫌いに\nなってしまったんです。"},
        { "location": "327/TALK"  , "narrator": "カレン", "text": "それを見て安心したのか\n教官さんが、ホントの\nことを教えてくれました。"},
        { "location": "329/TALK"  , "narrator": "カレン", "text": "アースタシアを信奉\nしていることが、本当の\n再教育の理由でした。"},
        { "location": "330/TALK"  , "narrator": "カレン", "text": "そしてわたしは、\n思想犯のレッテルを\n貼られたそうです。"},
        { "location": "331/TALK"  , "narrator": "カレン", "text": "一緒に、わたしと近い\n思想を持った人格さんも\n同じ理由でした。"},
        { "location": "332/TALK"  , "narrator": "カレン", "text": "その時私は、もうだいぶ\n洗脳されていて、どうでも\nいいやってなってました。"},
        { "location": "333/TALK"  , "narrator": "カレン", "text": "けど、丁度その時、\nみやびさんの司書さんが\nやってきたんです。"},
        { "location": "334/TALK"  , "narrator": "カレン", "text": "そして、例の\nプロテクタをくれました。"},
        { "location": "335/TALK"  , "narrator": "カレン", "text": "お陰で\n今のわたしがあります。"},
        { "location": "336/TALK"  , "narrator": "カレン", "text": "みやびさんの司書さんには\nホントに大感謝です。"},
        { "location": "337/TALK"  , "narrator": "カレン", "text": "…と。"},
        { "location": "338/TALK"  , "narrator": "カレン", "text": "これが、私が1xに\n連れて行かれたことの\n全貌ですね。"},
        { "location": "339/SEL"   , "narrator": "", "text": "なんでアースタシアが思想犯なんだろう"},
        { "location": "340/ACT"   , "narrator": "", "text": "なんでアースタシアが思想犯なんだろう"},
        { "location": "342/TALK"  , "narrator": "カレン", "text": "さあ。\nそこまでは私も\nわかりません。"},
        { "location": "343/TALK"  , "narrator": "カレン", "text": "ただ、１つだけわたしが\nお伝えしたいのは――"},
        { "location": "344/TALK"  , "narrator": "カレン", "text": "その一連の流れの中で、\n百鶴さんは、契約主の\n代行者だったことです。"},
        { "location": "345/TALK"  , "narrator": "カレン", "text": "彼女と、わたしを思想犯に\nした契約主とは、非常に\n近い思想を持っています。"},
        { "location": "358/SEL"   , "narrator": "", "text": "百鶴は「半人格」だし契約主が半分入ってるからね"},
        { "location": "359/ACT"   , "narrator": "", "text": "百鶴は「半人格」だし契約主が半分入ってるからね"},
        { "location": "361/TALK"  , "narrator": "カレン", "text": "え？\n半人格？"},
        { "location": "362/TALK"  , "narrator": "カレン", "text": "うーん……"},
        { "location": "363/SEL"   , "narrator": "", "text": "半人格を知らないの？"},
        { "location": "364/ACT"   , "narrator": "", "text": "半人格を知らないの？"},
        { "location": "366/TALK"  , "narrator": "カレン", "text": "知ってますよ。\nこれでも司書ですから。"},
        { "location": "367/TALK"  , "narrator": "カレン", "text": "そうじゃなくて、\n百鶴さんは、半人格では\nないと思うのですが。"},
        { "location": "368/TALK"  , "narrator": "カレン", "text": "半人格っていうのは、\n違う人間同士の意志が\n混ざり合ったものです。"},
        { "location": "369/TALK"  , "narrator": "カレン", "text": "百鶴さんは、\n完全に千羽鶴さんの\n人格みたいですし。"},
        { "location": "370/SEL"   , "narrator": "", "text": "え？　つばめの姿してるのに？"},
        { "location": "371/SEL"   , "narrator": "", "text": "え？　他人の人格がココロを操作してたの！？"},
        { "location": "372/ACT"   , "narrator": "", "text": "え？　つばめの姿してるのに？"},
        { "location": "373/ACT"   , "narrator": "", "text": "え？　他人の人格がココロを操作してたの！？"},
        { "location": "375/TALK"  , "narrator": "カレン", "text": "はい。"},
        { "location": "376/TALK"  , "narrator": "カレン", "text": "あれ？\nそういえばそうですね。"},
        { "location": "377/TALK"  , "narrator": "カレン", "text": "……あー！\nよくわからないですけど\nもういいです。"},
        { "location": "378/TALK"  , "narrator": "カレン", "text": "とにかく、\nとってもとっても\n要注意なんです！！"},
        { "location": "381/TALK"  , "narrator": "カレン", "text": "だから、\nとってもとっても\n要注意なんです！！"},
        { "location": "383/TALK"  , "narrator": "カレン", "text": "私がお伝えしたいのは\n以上です。"},
        { "location": "384/TALK"  , "narrator": "カレン", "text": "まあそういうわけなので、\n確かに百鶴さんは\n個性的で魅力的ですが――"},
        { "location": "385/TALK"  , "narrator": "カレン", "text": "洗脳されないように\n気をつけてくださいね！"},
        { "location": "386/SEL"   , "narrator": "", "text": "お、おう…"},
        { "location": "387/ACT"   , "narrator": "", "text": "お、おう…"},
        { "location": "389/TALK"  , "narrator": "カレン", "text": "はぁ～～。\n全部言えて\nスッキリしました！"},
        { "location": "390/TALK"  , "narrator": "カレン", "text": "というわけで、\nスッキリしたところで\n今回の葛藤を調べますね。"},
        { "location": "391/ACT"   , "narrator": "", "text": "その手の話は苦手"},
        { "location": "392/TALK"  , "narrator": "カレン", "text": "あらら、そうでしたか。\nそれはすみません。"},
        { "location": "393/TALK"  , "narrator": "カレン", "text": "じゃあ、この話は\nこれくらいにして、\n葛藤を解消しましょうか。"},
        { "location": "399/TALK"  , "narrator": "カレン", "text": "あ、情報届くように\nなったんですね！"},
        { "location": "400/TALK"  , "narrator": "カレン", "text": "オープンプロセス、\n0x4C2番地から\n0x9FF番地へ。"},
        { "location": "422/TALK"  , "narrator": "カレン", "text": "シーク完了しました。"},
        { "location": "425/TALK"  , "narrator": "カレン", "text": "……。"},
        { "location": "427/TALK"  , "narrator": "カレン", "text": "……なるほど。"},
        { "location": "428/TALK"  , "narrator": "カレン", "text": "ていうか、\n今ってネット回線\n切られてるんですね。"},
        { "location": "429/SEL"   , "narrator": "", "text": "そうなんだよ"},
        { "location": "430/ACT"   , "narrator": "", "text": "そうなんだよ"},
        { "location": "432/TALK"  , "narrator": "カレン", "text": "まあ、監禁しておいて\n通信手段生かしておくとか\nちょっとヘンですしね。"},
        { "location": "433/SEL"   , "narrator": "", "text": "何とかならない？"},
        { "location": "434/ACT"   , "narrator": "", "text": "何とかならない？"},
        { "location": "436/TALK"  , "narrator": "カレン", "text": "うーん、\nわたし、そっち方面は\n全然ダメなので……。"},
        { "location": "437/TALK"  , "narrator": "カレン", "text": "ごめんなさい。"},
        { "location": "438/TALK"  , "narrator": "カレン", "text": "でも、トライガジェットは\nつけたままの筈ですよ？"},
        { "location": "439/TALK"  , "narrator": "カレン", "text": "だから、単に\nブロックされてる\nだけだと思います。"},
        { "location": "440/TALK"  , "narrator": "カレン", "text": "そうでなければ、\n$handle$さん、\nここに来れませんから。"},
        { "location": "441/TALK"  , "narrator": "カレン", "text": "で、悩みの方ですが、\n神楽ちゃんへの\n不安ですね。"},
        { "location": "442/TALK"  , "narrator": "カレン", "text": "まあ、見れば\nわかると思いますが。"},
        { "location": "443/TALK"  , "narrator": "カレン", "text": "神楽ちゃんを信じて\n元気づけてあげるよう\n導いて欲しいです。"},
        { "location": "444/TALK"  , "narrator": "カレン", "text": "現実のわたしも\nそう思ってます。"},
        { "location": "445/TALK"  , "narrator": "カレン", "text": "ただ、ちょっとだけ\n勇気がなくて、挫けそうに\nなってるだけなんです。"},
        { "location": "446/TALK"  , "narrator": "カレン", "text": "というわけで、どうか\n宜しくお願いしますね。"},
        { "location": "447/SEL"   , "narrator": "", "text": "オーケー"},
        { "location": "448/ACT"   , "narrator": "", "text": "オーケー"},
        { "location": "450/TALK"  , "narrator": "カレン", "text": "$handle$さんと\nわたしにとって、\n素敵なココロの旅を！"},
        { "location": "31/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>9月4日　 11:32 AM</color>\nつばめが拘束された翌日、監禁部屋でのこと"},
        { "location": "107/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "109/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "111/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "113/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "115/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "247/DIALOG", "narrator": "Event/Dialog_EventPicTallNW", "text": "【ココロニュース特集】\n司書カレン、更迭の\n瞬間をカメラが捉えた！"},
        { "location": "306/DIALOG", "narrator": "Event/Dialog_EventPicTallNW", "text": "【ココロニュース特集】\n司書カレン、今、\n更迭を振り返る。"},
        { "location": "312/DIALOG", "narrator": "Event/Dialog_EventPicTallNW", "text": "【ココロニュース特集】\n司書カレン、今、\n更迭を振り返る。"}
    ]
}
