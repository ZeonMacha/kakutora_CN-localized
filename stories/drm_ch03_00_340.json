{
    "dir": "dramatics/daydra/drm_ch03_00_340.js",
    "type": "Episode",
    "info": {
        "story_id": "3034",
        "cid": "gabriella",
        "title": "らぶとーく  第34話",
        "sub_title": "恋のウィルス感染"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "恋のウィルス感染"},
        { "location": "27/TALK"   , "narrator": "繭", "text": "…………。"},
        { "location": "29/TALK"   , "narrator": "雛", "text": "繭ちん、何見てるの？"},
        { "location": "31/TALK"   , "narrator": "繭", "text": "外…下校する人達。"},
        { "location": "33/TALK"   , "narrator": "繭", "text": "なんか、やたらと\nカップルが多い気が\nする。"},
        { "location": "35/TALK"   , "narrator": "ガブリエラ", "text": "えっ…あ、本当ね。\n手を繋いだり…。"},
        { "location": "36/TALK"   , "narrator": "ガブリエラ", "text": "わっ、あそこの木の影！\nキスしてる人達まで\nいるし…。"},
        { "location": "38/TALK"   , "narrator": "繭", "text": "うちの学校、こんなに\nカップルいた？"},
        { "location": "39/TALK"   , "narrator": "雛", "text": "いなかったと思うよー？"},
        { "location": "40/TALK"   , "narrator": "雛", "text": "けどほら、カップルは\n一組でもいれば――"},
        { "location": "41/TALK"   , "narrator": "雛", "text": "それを中心に爆発的に\n広がったりすることも\nあるからねー。"},
        { "location": "44/TALK"   , "narrator": "ガブリエラ", "text": "…なんか、ウイルス感染\nみたいで嫌なんだけど？"},
        { "location": "46/TALK"   , "narrator": "雛", "text": "似たようなもんでしょ。\nね、繭ちん？"},
        { "location": "47/TALK"   , "narrator": "繭", "text": "…わからなくもない。"},
        { "location": "48/TALK"   , "narrator": "繭", "text": "恋はウイルスみたいな\nもの。"},
        { "location": "50/TALK"   , "narrator": "ガブリエラ", "text": "っていうか、あんた達\n凄いわかった風な感じで\n話してるけど――"},
        { "location": "51/TALK"   , "narrator": "ガブリエラ", "text": "好きな男の子でも\nいるの？"},
        { "location": "52/TALK"   , "narrator": "繭", "text": "いない。"},
        { "location": "54/TALK"   , "narrator": "雛", "text": "恋愛感情は向けるのも\n向けられるのも苦手ー。"},
        { "location": "55/TALK"   , "narrator": "ガブリエラ", "text": "それでよくそんなこと\n言えるわね？"},
        { "location": "56/TALK"   , "narrator": "ガブリエラ", "text": "好きな男の子も彼氏も\nいないあんた達が――"},
        { "location": "58/TALK"   , "narrator": "ガブリエラ", "text": "何言ったとしても\n説得力皆無よ？"},
        { "location": "60/TALK"   , "narrator": "雛", "text": "大丈夫だよー。\nほら、知識はあるから！"},
        { "location": "61/TALK"   , "narrator": "ガブリエラ", "text": "…耳年増ね。"},
        { "location": "62/TALK"   , "narrator": "雛", "text": "愛の伝道師は\n自分の恋愛より――"},
        { "location": "63/TALK"   , "narrator": "雛", "text": "他人の恋愛に重きを置く\n宿命なのさー。"},
        { "location": "65/TALK"   , "narrator": "繭", "text": "…他人からすれば\nはた迷惑なお節介、\nとも言う。"},
        { "location": "66/TALK"   , "narrator": "ガブリエラ", "text": "それ以外の言い方\nないでしょ？"},
        { "location": "68/TALK"   , "narrator": "雛", "text": "じゃあ、少なくとも\nあたし達よりは恋に\n身近なところにいる――"},
        { "location": "69/TALK"   , "narrator": "雛", "text": "ガブリエラちゃんに\n教えてもらおっかなー？"},
        { "location": "71/TALK"   , "narrator": "ガブリエラ", "text": "えっ！？"},
        { "location": "74/TALK"   , "narrator": "繭", "text": "賛成。\n私も聞きたい。"},
        { "location": "75/TALK"   , "narrator": "ガブリエラ", "text": "ちょ、繭まで\n何言いだすのよ！？"},
        { "location": "76/TALK"   , "narrator": "雛", "text": "はいはい、それじゃ――"},
        { "location": "77/TALK"   , "narrator": "雛", "text": "ウイルスとかけまして、\n恋と解く！！"},
        { "location": "78/TALK"   , "narrator": "繭", "text": "…その心は？"},
        { "location": "80/TALK"   , "narrator": "ガブリエラ", "text": "急過ぎよ！！"},
        { "location": "82/TALK"   , "narrator": "ガブリエラ", "text": "ちょっと待って。\n今、考えるから…。"},
        { "location": "94/TALK"   , "narrator": "ガブリエラ", "text": "$handle$、大至急答えて"},
        { "location": "95/TALK"   , "narrator": "ガブリエラ", "text": "ウイルスとかけまして、恋と解く"},
        { "location": "96/TALK"   , "narrator": "ガブリエラ", "text": "その心は？"},
        { "location": "98/SEL"    , "narrator": "", "text": "どちらも熱が出ます"},
        { "location": "99/SEL"    , "narrator": "", "text": "身体が震えます"},
        { "location": "100/SEL"   , "narrator": "", "text": "気が付いたら感染しています"},
        { "location": "101/ACT"   , "narrator": "", "text": "どちらも熱が出ます"},
        { "location": "102/TALK"  , "narrator": "ガブリエラ", "text": "結構上手いわね"},
        { "location": "103/TALK"  , "narrator": "ガブリエラ", "text": "それならありじゃないかしら？"},
        { "location": "115/TALK"  , "narrator": "ガブリエラ", "text": "…その心は！\nどちらも熱が出ます。"},
        { "location": "117/TALK"  , "narrator": "繭", "text": "…驚いた。\n結構上手い。"},
        { "location": "119/TALK"  , "narrator": "雛", "text": "さっすが\nガブリエラちゃん！"},
        { "location": "120/TALK"  , "narrator": "雛", "text": "恋愛真っ最中の子は、\n言うことも一味違うね！"},
        { "location": "122/TALK"  , "narrator": "繭", "text": "枯れてない。\n一緒にすんな。"},
        { "location": "125/TALK"  , "narrator": "ガブリエラ", "text": "っていうか、二人とも\n本当に好きな男の子\nいないわけ？"},
        { "location": "126/TALK"  , "narrator": "雛", "text": "綾水様より素敵な\n男の子がいないのが\n問題なんだよねー。"},
        { "location": "128/TALK"  , "narrator": "繭", "text": "男よりＰＣ。\nプログラムはウソを\nつかない。"},
        { "location": "129/TALK"  , "narrator": "ガブリエラ", "text": "…本当、よくそれで\n恋だ恋愛だのと話が\n出来たものね。"},
        { "location": "132/TALK"  , "narrator": "ガブリエラ", "text": "…っていうか、\n片思いしてる分だけ――"},
        { "location": "133/TALK"  , "narrator": "ガブリエラ", "text": "あたしの方が恋愛のこと\nわかってるじゃない。"},
        { "location": "134/TALK"  , "narrator": "ガブリエラ", "text": "…ふふっ。"},
        { "location": "136/TALK"  , "narrator": "繭", "text": "…何？\n勝ち誇った顔してる。"},
        { "location": "138/TALK"  , "narrator": "ガブリエラ", "text": "別に、なんでもないわ。"},
        { "location": "140/TALK"  , "narrator": "雛", "text": "うっわ、絶対なんでも\nなくない！"},
        { "location": "142/TALK"  , "narrator": "ガブリエラ", "text": "ふふっ…。"},
        { "location": "143/TALK"  , "narrator": "ガブリエラ", "text": "やっぱり、あたしの方が\n大人ね。"},
        { "location": "144/ACT"   , "narrator": "", "text": "身体が震えます"},
        { "location": "145/TALK"  , "narrator": "ガブリエラ", "text": "身体が震える！？"},
        { "location": "146/TALK"  , "narrator": "ガブリエラ", "text": "それって凄い重病じゃない？"},
        { "location": "147/TALK"  , "narrator": "ガブリエラ", "text": "でも、身体が震えるほどの恋なんて"},
        { "location": "148/TALK"  , "narrator": "ガブリエラ", "text": "凄く情熱的かも///////"},
        { "location": "160/TALK"  , "narrator": "ガブリエラ", "text": "…その心は！\n身体が震えるわ。"},
        { "location": "161/TALK"  , "narrator": "繭", "text": "…は？"},
        { "location": "162/TALK"  , "narrator": "ガブリエラ", "text": "だから、\n身体が震えるのよ。"},
        { "location": "163/TALK"  , "narrator": "ガブリエラ", "text": "落雷を受けたような\n衝撃を覚えるくらいの\n恋なんて――"},
        { "location": "166/TALK"  , "narrator": "ガブリエラ", "text": "情熱的で素敵だと\n思わない？"},
        { "location": "167/TALK"  , "narrator": "雛", "text": "…ら、落雷？\n情熱？"},
        { "location": "168/TALK"  , "narrator": "繭", "text": "…ドン引き。"},
        { "location": "170/TALK"  , "narrator": "ガブリエラ", "text": "ちょっ！？\n何よそれ！？"},
        { "location": "171/TALK"  , "narrator": "ガブリエラ", "text": "恋ってそういう情熱的な\nものじゃないの？"},
        { "location": "173/TALK"  , "narrator": "雛", "text": "うーん…どうなのかな？\nまゆちんはどう思う？"},
        { "location": "174/TALK"  , "narrator": "繭", "text": "恋じゃなくて普通に\n病気と勘違いしそう。"},
        { "location": "176/TALK"  , "narrator": "雛", "text": "だよねー。\nあたしもそういうのは\n嫌かな。"},
        { "location": "180/TALK"  , "narrator": "ガブリエラ", "text": "はぁ…\nわかってないわね。"},
        { "location": "181/TALK"  , "narrator": "ガブリエラ", "text": "恋っていうのは、\nこれくらい衝撃が\n大きい方が――"},
        { "location": "182/TALK"  , "narrator": "ガブリエラ", "text": "する方も、される方も\n燃えるのよ？"},
        { "location": "183/TALK"  , "narrator": "雛", "text": "そうかなー？"},
        { "location": "184/TALK"  , "narrator": "ガブリエラ", "text": "そうに決まってる\nでしょ。"},
        { "location": "186/TALK"  , "narrator": "ガブリエラ", "text": "まあ、実際に恋を経験\nしたことのない\nひなこ達には――"},
        { "location": "188/TALK"  , "narrator": "ガブリエラ", "text": "ちょっと難しかった\nかもしれないわね。"},
        { "location": "190/TALK"  , "narrator": "雛", "text": "うっわ、凄い勝ち誇った\n顔してる！"},
        { "location": "192/TALK"  , "narrator": "繭", "text": "あれが落雷にでも\n打たれた顔？"},
        { "location": "194/TALK"  , "narrator": "ガブリエラ", "text": "違うわよ！"},
        { "location": "195/ACT"   , "narrator": "", "text": "気が付いたら感染しています"},
        { "location": "196/TALK"  , "narrator": "ガブリエラ", "text": "そうなのよね～"},
        { "location": "197/TALK"  , "narrator": "ガブリエラ", "text": "あんたわかってるじゃない"},
        { "location": "208/TALK"  , "narrator": "ガブリエラ", "text": "…その心は！\n気が付いたら感染して\nいます。"},
        { "location": "209/TALK"  , "narrator": "繭", "text": "さっき話してたこと\nまんまじゃない？"},
        { "location": "211/TALK"  , "narrator": "ガブリエラ", "text": "その通りなんだから\n仕方ないでしょ。"},
        { "location": "213/TALK"  , "narrator": "ガブリエラ", "text": "まあ、恋のきっかけ\nなんていうのは――"},
        { "location": "214/TALK"  , "narrator": "ガブリエラ", "text": "結局そんなものなんじゃ\nないかしら？"},
        { "location": "215/TALK"  , "narrator": "雛", "text": "なるほどねー。"},
        { "location": "216/TALK"  , "narrator": "雛", "text": "つまり外に見える\nカップル達は――"},
        { "location": "217/TALK"  , "narrator": "雛", "text": "恋ウイルスに感染して、\nそれが発症した患者、\nってわけだね。"},
        { "location": "218/TALK"  , "narrator": "繭", "text": "ウイルス対策を怠る、\n自己管理の出来ていない\n人間たち。"},
        { "location": "219/TALK"  , "narrator": "雛", "text": "予防接種受けなかったん\nだろうねー。\nダメダメじゃん。"},
        { "location": "220/TALK"  , "narrator": "ガブリエラ", "text": "例え話なんだから、\n本当にウイルスみたいな\n言い方しないでよ。"},
        { "location": "222/TALK"  , "narrator": "ガブリエラ", "text": "っていうか、あんた達と\n恋バナするの、すっごい\n疲れるんだけど？"},
        { "location": "223/TALK"  , "narrator": "雛", "text": "子供のガブリエラちゃん\nには、まだ恋バナは\n早かったかな？"},
        { "location": "224/TALK"  , "narrator": "ガブリエラ", "text": "どう考えても、あたしが\n一番恋について\nわかってるわよ！"},
        { "location": "16/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>某月某日　4:45 PM</color>\nとある平日の放課後、高等部の教室にて"}
    ]
}
