    "info": {
        "story_id": "91054",
        "cid": "",
        "title": "004 アフターストーリー",
        "sub_title": "國政綾水の思い出"
    },
    "entry":
    [
        { "location": "1122/DIALOG", "narrator": "", "text": "<color=green>某月某日　4:07 PM</color>\nとある平日、寮「とらいあんぐる」アーヤの部屋にて。"},
        { "location": "1123/TALK"  , "narrator": "小夜", "text": "うん、美味しい！\nこのパニーニ最高よ！"},
        { "location": "1124/TALK"  , "narrator": "アーヤ", "text": "お店のメニューに\n追加しても平気そう？"},
        { "location": "1125/TALK"  , "narrator": "小夜", "text": "問題なし。\n５００円までだったら\n私も出すと思うなぁ。"},
        { "location": "1126/TALK"  , "narrator": "アーヤ", "text": "オッケー。\nじゃあこれは\nランチメニューで。"},
        { "location": "1127/TALK"  , "narrator": "小夜", "text": "だいぶメニューも\n固まってきたみたいね。"},
        { "location": "1129/TALK"  , "narrator": "アーヤ", "text": "小夜が手伝ってくれた\nおかげよ。"},
        { "location": "1130/TALK"  , "narrator": "アーヤ", "text": "モーニング、ランチ、\nカフェタイム、それと\nサンセットメニュー――"},
        { "location": "1131/TALK"  , "narrator": "アーヤ", "text": "これ以上作ったら\nさすがに\n対応しきれないか…。"},
        { "location": "1132/TALK"  , "narrator": "小夜", "text": "増やし過ぎても\nみんなが\n死んじゃうわよ…。"},
        { "location": "1133/TALK"  , "narrator": "小夜", "text": "…そういえば、\n劇場のロゴがあるって\n聞いたんだけど…。"},
        { "location": "1134/TALK"  , "narrator": "アーヤ", "text": "あ、そうそう。\nまだ見せてなかったわね。"},
        { "location": "1140/TALK"  , "narrator": "アーヤ", "text": "これよ。"},
        { "location": "1141/TALK"  , "narrator": "小夜", "text": "へー、こんなにかっこいい\nロゴだったんだ？"},
        { "location": "1142/TALK"  , "narrator": "アーヤ", "text": "色と中心の風車は\n私が付け足したもの\nだけどね。"},
        { "location": "1144/TALK"  , "narrator": "アーヤ", "text": "それで、今はこのロゴを\nどの食器に付けようか\n悩んでるの。"},
        { "location": "1145/TALK"  , "narrator": "小夜", "text": "へー、食器にロゴなんて\n中々本格的じゃない。"},
        { "location": "1146/TALK"  , "narrator": "小夜", "text": "それで、どの食器に\nしようと思ってるわけ？"},
        { "location": "1147/TALK"  , "narrator": "アーヤ", "text": "まだ悩み中。\nみんなも、どれにするか\n迷ってるらしくて…。"},
        { "location": "1148/TALK"  , "narrator": "アーヤ", "text": "なにかオススメってある？"},
        { "location": "1149/TALK"  , "narrator": "小夜", "text": "別に、どれにしても\n変わらないと思うけど…。"},
        { "location": "1150/TALK"  , "narrator": "小夜", "text": "普通にお皿とかで\nいいんじゃない？"},
        { "location": "1151/TALK"  , "narrator": "アーヤ", "text": "それは避けたいの。\nお皿は他の子が選びそうな\n気がするし…。"},
        { "location": "1152/TALK"  , "narrator": "小夜", "text": "それじゃ、残り物に\nするってこと？"},
        { "location": "1154/TALK"  , "narrator": "アーヤ", "text": "それは…ちょっと\n寂しい気がするし…。"},
        { "location": "1155/TALK"  , "narrator": "小夜", "text": "わがままなんだから…。"},
        { "location": "1156/TALK"  , "narrator": "小夜", "text": "まあ、私のオススメは\nティーカップかな？"},
        { "location": "1157/TALK"  , "narrator": "アーヤ", "text": "どうして？"},
        { "location": "1158/TALK"  , "narrator": "小夜", "text": "紅茶が好きだからよ。\nどう、立派な理由でしょ？"},
        { "location": "1159/TALK"  , "narrator": "アーヤ", "text": "あはは、納得。"},
        { "location": "1174/TALK"  , "narrator": "アーヤ", "text": "ふう…。\n洗い物終わり、っと…。"},
        { "location": "1176/TALK"  , "narrator": "アーヤ", "text": "小夜のおかげで\nだいぶメニューも\n固まってきたし…。"},
        { "location": "1177/TALK"  , "narrator": "アーヤ", "text": "週末にでも、みんなに\n味見してもらおうかしら。"},
        { "location": "1178/TALK"  , "narrator": "アーヤ", "text": "あと決めなくちゃ\nいけないのはデザートと\nアペタイザー……。"},
        { "location": "1179/TALK"  , "narrator": "アーヤ", "text": "…そうだ。\n食器も選ばなくちゃ\nいけないんだった…。"},
        { "location": "1180/TALK"  , "narrator": "アーヤ", "text": "本当、どうしよう…。\nどれ選んでも使うんだから\nなにも変わらないし…。"},
        { "location": "1181/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "1194/TALK"  , "narrator": "アーヤ", "text": "装弾"},
        { "location": "1196/SEL"   , "narrator": "（選択肢）", "text": "物騒な！！"},
        { "location": "1197/ACT"   , "narrator": "", "text": "物騒な！！"},
        { "location": "1199/TALK"  , "narrator": "アーヤ", "text": "相談！！(>_<)"},
        { "location": "1200/TALK"  , "narrator": "アーヤ", "text": "間違った(;^_^A"},
        { "location": "1201/TALK"  , "narrator": "アーヤ", "text": "スマホの変換がおかしい"},
        { "location": "1203/TALK"  , "narrator": "アーヤ", "text": "それはそうと"},
        { "location": "1204/TALK"  , "narrator": "アーヤ", "text": "食器のこと"},
        { "location": "1205/TALK"  , "narrator": "アーヤ", "text": "聞いてくれる？(￣Д￣ )"},
        { "location": "1207/SEL"   , "narrator": "（選択肢）", "text": "決まってないの？"},
        { "location": "1208/ACT"   , "narrator": "", "text": "決まってないの？"},
        { "location": "1210/TALK"  , "narrator": "アーヤ", "text": "決まってない"},
        { "location": "1211/TALK"  , "narrator": "アーヤ", "text": "だって"},
        { "location": "1212/TALK"  , "narrator": "アーヤ", "text": "どの食器がいいか"},
        { "location": "1213/TALK"  , "narrator": "アーヤ", "text": "なんて聞かれて"},
        { "location": "1214/TALK"  , "narrator": "アーヤ", "text": "どう答えろと？"},
        { "location": "1215/TALK"  , "narrator": "アーヤ", "text": "元々"},
        { "location": "1216/TALK"  , "narrator": "アーヤ", "text": "食器に興味あるなら別だけど"},
        { "location": "1217/TALK"  , "narrator": "アーヤ", "text": "私違うし"},
        { "location": "1220/TALK"  , "narrator": "アーヤ", "text": "$handle$は"},
        { "location": "1221/TALK"  , "narrator": "アーヤ", "text": "なにがいいと思う？"},
        { "location": "1223/SEL"   , "narrator": "（選択肢）", "text": "マグカップとか"},
        { "location": "1224/SEL"   , "narrator": "（選択肢）", "text": "フォークかナイフは？"},
        { "location": "1225/ACT"   , "narrator": "", "text": "マグカップとか"},
        { "location": "1226/TALK"  , "narrator": "アーヤ", "text": "いいんだけど"},
        { "location": "1227/TALK"  , "narrator": "アーヤ", "text": "なんか普通っていうか"},
        { "location": "1228/TALK"  , "narrator": "アーヤ", "text": "他の子とかぶりそう"},
        { "location": "1229/TALK"  , "narrator": "アーヤ", "text": "まあ"},
        { "location": "1231/SEL"   , "narrator": "（選択肢）", "text": "フォークかナイフは？"},
        { "location": "1232/ACT"   , "narrator": "", "text": "フォークかナイフは？"},
        { "location": "1234/ACT"   , "narrator": "", "text": "フォークかナイフは？"},
        { "location": "1236/TALK"  , "narrator": "アーヤ", "text": "あー"},
        { "location": "1237/TALK"  , "narrator": "アーヤ", "text": "それならいいかも"},
        { "location": "1238/TALK"  , "narrator": "アーヤ", "text": "みんな"},
        { "location": "1239/TALK"  , "narrator": "アーヤ", "text": "絶対選ばなそうだし"},
        { "location": "1243/TALK"  , "narrator": "アーヤ", "text": "でも"},
        { "location": "1244/TALK"  , "narrator": "アーヤ", "text": "縁起的には"},
        { "location": "1246/TALK"  , "narrator": "アーヤ", "text": "あまりよくないわよね"},
        { "location": "1247/TALK"  , "narrator": "アーヤ", "text": "刃物は"},
        { "location": "1248/TALK"  , "narrator": "アーヤ", "text": "縁を切るモノ"},
        { "location": "1249/TALK"  , "narrator": "アーヤ", "text": "とかいうし"},
        { "location": "1251/SEL"   , "narrator": "（選択肢）", "text": "それ、ギフトの話でしょ？"},
        { "location": "1252/SEL"   , "narrator": "（選択肢）", "text": "メイン武器剣だし、いいと思うのに"},
        { "location": "1253/ACT"   , "narrator": "", "text": "それ、ギフトの話でしょ？"},
        { "location": "1254/TALK"  , "narrator": "アーヤ", "text": "それはそうだけど"},
        { "location": "1255/TALK"  , "narrator": "アーヤ", "text": "でも"},
        { "location": "1256/ACT"   , "narrator": "", "text": "メイン武器剣だし、いいと思うのに"},
        { "location": "1257/TALK"  , "narrator": "アーヤ", "text": "武器で食器選ばれても"},
        { "location": "1259/TALK"  , "narrator": "アーヤ", "text": "困るから"},
        { "location": "1260/TALK"  , "narrator": "アーヤ", "text": "それに"},
        { "location": "1261/TALK"  , "narrator": "アーヤ", "text": "刃物はちょっと"},
        { "location": "1263/TALK"  , "narrator": "アーヤ", "text": "オリジナル食器だし"},
        { "location": "1264/TALK"  , "narrator": "アーヤ", "text": "ギフトセットとか"},
        { "location": "1265/TALK"  , "narrator": "アーヤ", "text": "作るかもしれないでしょ"},
        { "location": "1266/TALK"  , "narrator": "アーヤ", "text": "それ考えるとね"},
        { "location": "1269/TALK"  , "narrator": "アーヤ", "text": "まあ"},
        { "location": "1270/TALK"  , "narrator": "アーヤ", "text": "参考にするわ"},
        { "location": "1281/TALK"  , "narrator": "アーヤ", "text": "…もう一度、小夜に、\n相談してみようかしら？"},
        { "location": "1294/TALK"  , "narrator": "小夜", "text": "…いやいや、さすがに\n生真面目すぎでしょ。"},
        { "location": "1295/TALK"  , "narrator": "小夜", "text": "今時縁起がどうとか、\nそんなこと深く考える人\nいないと思うけど？"},
        { "location": "1296/TALK"  , "narrator": "アーヤ", "text": "小夜は気にしないの？"},
        { "location": "1297/TALK"  , "narrator": "小夜", "text": "ていうか、別に\nギフトセットの中身を\n決めてるわけじゃないし。"},
        { "location": "1299/TALK"  , "narrator": "アーヤ", "text": "そうだけど、でも…。"},
        { "location": "1300/TALK"  , "narrator": "小夜", "text": "それに、ナイフ、スプーン\nフォークはカフェには絶対\n必要だと思うんだけど？"},
        { "location": "1301/TALK"  , "narrator": "小夜", "text": "後にギフトにするなら\nフォークとスプーンだけ\n入れればいいと思うし。"},
        { "location": "1302/TALK"  , "narrator": "アーヤ", "text": "あー、確かにそうかも。"},
        { "location": "1303/TALK"  , "narrator": "アーヤ", "text": "フォークとスプーンなら\nパスタ用ってことで\n丁度良さそうだし。"},
        { "location": "1304/TALK"  , "narrator": "小夜", "text": "そういうこと。"},
        { "location": "1306/TALK"  , "narrator": "アーヤ", "text": "気に入ったわ。\n早速みんなに話してみる。"},
        { "location": "1307/TALK"  , "narrator": "小夜", "text": "決まるといいわね。"}
    ]
}
