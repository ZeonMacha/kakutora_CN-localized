    "entry":
    [
        { "location": "5/SCENARIO", "narrator": "", "text": "優しみ"},
        { "location": "30/TALK"   , "narrator": "神楽", "text": "ぴょんこは少し大人になったぴょん♪"},
        { "location": "32/SEL"    , "narrator": "", "text": "じゅるり全裸待機！"},
        { "location": "33/SEL"    , "narrator": "", "text": "何があったの？"},
        { "location": "34/SEL"    , "narrator": "", "text": "その言い方が子供だなー"},
        { "location": "35/ACT"    , "narrator": "", "text": "じゅるり全裸待機！"},
        { "location": "36/TALK"   , "narrator": "神楽", "text": "何それ"},
        { "location": "38/TALK"   , "narrator": "神楽", "text": "キモ！！！"},
        { "location": "39/ACT"    , "narrator": "", "text": "何があったの？"},
        { "location": "40/TALK"   , "narrator": "神楽", "text": "なんかっていうかー"},
        { "location": "41/ACT"    , "narrator": "", "text": "その言い方が子供だなー"},
        { "location": "42/TALK"   , "narrator": "神楽", "text": "はぁぁぁぁ？"},
        { "location": "45/TALK"   , "narrator": "神楽", "text": "大体$handle$はさー"},
        { "location": "46/TALK"   , "narrator": "神楽", "text": "ぴょんこと自分のどっちが大人だと思ってるわけ？"},
        { "location": "48/SEL"    , "narrator": "", "text": "神楽だけど…"},
        { "location": "49/SEL"    , "narrator": "", "text": "$me$に決まってる"},
        { "location": "50/SEL"    , "narrator": "", "text": "どっちもどっち？"},
        { "location": "51/ACT"    , "narrator": "", "text": "神楽だけど…"},
        { "location": "52/TALK"   , "narrator": "神楽", "text": "そうでしょ！？"},
        { "location": "54/TALK"   , "narrator": "神楽", "text": "だよね？？？"},
        { "location": "55/ACT"    , "narrator": "", "text": "$me$に決まってる"},
        { "location": "56/TALK"   , "narrator": "神楽", "text": "あっあっ何それ？"},
        { "location": "57/TALK"   , "narrator": "神楽", "text": "年齢の話じゃないんだけど？？？"},
        { "location": "58/ACT"    , "narrator": "", "text": "どっちもどっち？"},
        { "location": "59/TALK"   , "narrator": "神楽", "text": "ふううん？"},
        { "location": "60/TALK"   , "narrator": "神楽", "text": "同じくらいだって思ってるんだ？？？"},
        { "location": "62/TALK"   , "narrator": "神楽", "text": "ぴょんこはお仕事もしてるし色々気を遣ってるしぴょんこのほうが大人に決まってるんですけど～～～？"},
        { "location": "64/SEL"    , "narrator": "", "text": "そうだねその通り！"},
        { "location": "65/SEL"    , "narrator": "", "text": "そうかなあ…"},
        { "location": "66/SEL"    , "narrator": "", "text": "どっちでもいい"},
        { "location": "67/ACT"    , "narrator": "", "text": "そうだねその通り！"},
        { "location": "68/TALK"   , "narrator": "神楽", "text": "なんだかなー"},
        { "location": "69/ACT"    , "narrator": "", "text": "そうかなあ…"},
        { "location": "70/TALK"   , "narrator": "神楽", "text": "違うかな？？？"},
        { "location": "71/ACT"    , "narrator": "", "text": "どっちでもいい"},
        { "location": "72/TALK"   , "narrator": "神楽", "text": "あれあれあれあれ？？？"},
        { "location": "73/TALK"   , "narrator": "神楽", "text": "やる気なしなんだ？？？？"},
        { "location": "75/TALK"   , "narrator": "神楽", "text": "そうじゃなくて！"},
        { "location": "76/TALK"   , "narrator": "神楽", "text": "ぴょんこはつばめさんにちょっと優しくできたぴょん"},
        { "location": "77/TALK"   , "narrator": "神楽", "text": "偉いでしょ！"},
        { "location": "79/TALK"   , "narrator": "神楽", "text": "どーよ！？！？！？！"},
        { "location": "81/SEL"    , "narrator": "", "text": "そんなにドヤ顔すること？"},
        { "location": "82/SEL"    , "narrator": "", "text": "うんうん偉いね"},
        { "location": "83/SEL"    , "narrator": "", "text": "神楽はいい子だからね"},
        { "location": "84/ACT"    , "narrator": "", "text": "そんなにドヤ顔すること？"},
        { "location": "85/TALK"   , "narrator": "神楽", "text": "しちゃいけないこと？？？"},
        { "location": "86/ACT"    , "narrator": "", "text": "うんうん偉いね"},
        { "location": "87/TALK"   , "narrator": "神楽", "text": "でしょでしょ"},
        { "location": "88/TALK"   , "narrator": "神楽", "text": "もっと褒めろス！"},
        { "location": "89/ACT"    , "narrator": "", "text": "神楽はいい子だからね"},
        { "location": "90/TALK"   , "narrator": "神楽", "text": "まあね？"},
        { "location": "93/SEL"    , "narrator": "", "text": "でも"},
        { "location": "94/ACT"    , "narrator": "", "text": "でも"},
        { "location": "98/SEL"    , "narrator": "", "text": "無理しすぎないでね"},
        { "location": "99/SEL"    , "narrator": "", "text": "つばめと距離を取ってもいいんだよ"},
        { "location": "100/SEL"   , "narrator": "", "text": "$me$を一番に考えて欲しいな～"},
        { "location": "101/ACT"   , "narrator": "", "text": "無理しすぎないでね"},
        { "location": "104/TALK"  , "narrator": "神楽", "text": "気を付けるぴょん♪"},
        { "location": "114/ACT"   , "narrator": "", "text": "つばめと距離を取ってもいいんだよ"},
        { "location": "116/TALK"  , "narrator": "神楽", "text": "ﾁｭｯﾁｭしたげる！！！"},
        { "location": "126/ACT"   , "narrator": "", "text": "$me$を一番に考えて欲しいな～"},
        { "location": "129/TALK"  , "narrator": "神楽", "text": "図々しいな～$handle$～"},
        { "location": "131/SEL"   , "narrator": "", "text": "だって恋人同士だし"},
        { "location": "132/SEL"   , "narrator": "", "text": "$me$は神楽が一番なんだよ？"},
        { "location": "133/SEL"   , "narrator": "", "text": "当然の権利じゃないの？"},
        { "location": "134/ACT"   , "narrator": "", "text": "だって恋人同士だし"},
        { "location": "135/TALK"  , "narrator": "神楽", "text": "そうだけどー"},
        { "location": "136/ACT"   , "narrator": "", "text": "$me$は神楽が一番なんだよ？"},
        { "location": "137/TALK"  , "narrator": "神楽", "text": "だから？？？"},
        { "location": "138/ACT"   , "narrator": "", "text": "当然の権利じゃないの？"},
        { "location": "139/TALK"  , "narrator": "神楽", "text": "権利とか！！！"},
        { "location": "141/TALK"  , "narrator": "神楽", "text": "そーゆーのってわがままなんじゃないかなーってぴょんこは"},
        { "location": "143/SEL"   , "narrator": "", "text": "それでいいでしょ！"},
        { "location": "144/SEL"   , "narrator": "", "text": "神楽も$me$に言おうよ"},
        { "location": "145/SEL"   , "narrator": "", "text": "$me$はそういうのがうれしいんだけどな…"},
        { "location": "146/ACT"   , "narrator": "", "text": "それでいいでしょ！"},
        { "location": "147/TALK"  , "narrator": "神楽", "text": "あっ何それ！"},
        { "location": "148/TALK"  , "narrator": "神楽", "text": "逆ギレ？？？"},
        { "location": "149/ACT"   , "narrator": "", "text": "神楽も$me$に言おうよ"},
        { "location": "151/TALK"  , "narrator": "神楽", "text": "ぴょんこはそんなことしませんー"},
        { "location": "153/TALK"  , "narrator": "神楽", "text": "しませんよーだ"},
        { "location": "154/ACT"   , "narrator": "", "text": "$me$はそういうのがうれしいんだけどな…"},
        { "location": "157/TALK"  , "narrator": "神楽", "text": "$handle$はぴょんこに$handle$のこと一番に考えて欲しいんだ"},
        { "location": "158/TALK"  , "narrator": "神楽", "text": "それって、、、"},
        { "location": "159/TALK"  , "narrator": "神楽", "text": "ぴょんこが$handle$にも言っていいこと"},
        { "location": "160/TALK"  , "narrator": "神楽", "text": "だよねだよね"},
        { "location": "161/TALK"  , "narrator": "神楽", "text": "って"},
        { "location": "162/TALK"  , "narrator": "神楽", "text": "今さらだけど、、、"},
        { "location": "164/SEL"   , "narrator": "", "text": "その通り"},
        { "location": "165/SEL"   , "narrator": "", "text": "何度でも聞いて！"},
        { "location": "166/SEL"   , "narrator": "", "text": "そのつもりで接してたんだけどなー"},
        { "location": "167/ACT"   , "narrator": "", "text": "その通り"},
        { "location": "168/TALK"  , "narrator": "神楽", "text": "うん"},
        { "location": "169/ACT"   , "narrator": "", "text": "何度でも聞いて！"},
        { "location": "171/TALK"  , "narrator": "神楽", "text": "ちょっとムカつく、、、"},
        { "location": "173/ACT"   , "narrator": "", "text": "そのつもりで接してたんだけどなー"},
        { "location": "175/TALK"  , "narrator": "神楽", "text": "そうだったかも、、、"},
        { "location": "177/TALK"  , "narrator": "神楽", "text": "ぴょんこは$handle$の愛を感じた"},
        { "location": "178/TALK"  , "narrator": "神楽", "text": "と"},
        { "location": "179/TALK"  , "narrator": "神楽", "text": "思うよ？？？"},
        { "location": "181/SEL"   , "narrator": "", "text": "なんで疑問系？"},
        { "location": "182/SEL"   , "narrator": "", "text": "そこは言い切って！"},
        { "location": "183/SEL"   , "narrator": "", "text": "いつでも降るほどに愛を放出してるのに？"},
        { "location": "184/ACT"   , "narrator": "", "text": "なんで疑問系？"},
        { "location": "185/TALK"  , "narrator": "神楽", "text": "なんでだろ"},
        { "location": "186/TALK"  , "narrator": "神楽", "text": "そんな気持ち？？？"},
        { "location": "187/TALK"  , "narrator": "神楽", "text": "あっ別に$handle$の愛は疑ってない、よ？？？"},
        { "location": "188/ACT"   , "narrator": "", "text": "そこは言い切って！"},
        { "location": "189/TALK"  , "narrator": "神楽", "text": "ぴょんこは$handle$の愛を感じた"},
        { "location": "190/TALK"  , "narrator": "神楽", "text": "と"},
        { "location": "191/TALK"  , "narrator": "神楽", "text": "言い切ります"},
        { "location": "192/ACT"   , "narrator": "", "text": "いつでも降るほどに愛を放出してるのに？"},
        { "location": "193/TALK"  , "narrator": "神楽", "text": "$handle$の愛は電波か何か？？？"},
        { "location": "194/TALK"  , "narrator": "神楽", "text": "ある意味それ正解だよね"},
        { "location": "195/TALK"  , "narrator": "神楽", "text": "うん知ってた！"},
        { "location": "197/TALK"  , "narrator": "神楽", "text": "わがままとかそういうのも$handle$の愛のうち"},
        { "location": "198/TALK"  , "narrator": "神楽", "text": "それって、、、"},
        { "location": "199/TALK"  , "narrator": "神楽", "text": "そういうものなのかも、、、"},
        { "location": "200/TALK"  , "narrator": "神楽", "text": "なんかちょっと納得した感じ"},
        { "location": "202/TALK"  , "narrator": "神楽", "text": "うん"}
    ]
