{
    "dir": "chap13/daydra/dd_ch03_13_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "13305",
        "cid": "gabriella",
        "title": "005 メインストーリー",
        "sub_title": "チェイス？＜後編＞"
    },
    "entry":
    [
        { "location": "254/SCENARIO", "narrator": "", "text": "アーヤを追え"},
        { "location": "269/TALK"    , "narrator": "ガブリエラ", "text": "…やっぱ気になるし、\n行ってみよう。"},
        { "location": "270/TALK"    , "narrator": "ガブリエラ", "text": "こんな気持ちで\n展示会に行ったって、\n楽しめないもの。"},
        { "location": "271/TALK"    , "narrator": "ガブリエラ", "text": "それに、アーヤが\n非行に走ってる\n可能性もあるし！"},
        { "location": "272/TALK"    , "narrator": "ガブリエラ", "text": "あたしがしっかり\n見張る必要が\nあるわね。"},
        { "location": "274/TALK"    , "narrator": "ガブリエラ", "text": "さて、\n区民センターか。"},
        { "location": "290/TALK"    , "narrator": "ガブリエラ", "text": "…アーヤってば、\nこんなところに\n何の用事かしら？"},
        { "location": "292/TALK"    , "narrator": "ガブリエラ", "text": "アーヤ達が集まって\n勉強するような\n場所っぽくないし。"},
        { "location": "295/TALK"    , "narrator": "ガブリエラ", "text": "…つまり、あたしの\n勘が正しかった、って\nことね。"},
        { "location": "296/SEL"     , "narrator": "", "text": "ちょっとドキドキするね"},
        { "location": "297/ACT"     , "narrator": "", "text": "ちょっとドキドキするね"},
        { "location": "314/TALK"    , "narrator": "ガブリエラ", "text": "あら、マルザンナもそうなの？"},
        { "location": "315/TALK"    , "narrator": "ガブリエラ", "text": "私も、ちょっとドキドキしているわ"},
        { "location": "316/TALK"    , "narrator": "ガブリエラ", "text": "この辺りって、私もあまり来ない場所だし"},
        { "location": "317/TALK"    , "narrator": "ガブリエラ", "text": "そういえば、マルザンナは知っているの？"},
        { "location": "318/TALK"    , "narrator": "ガブリエラ", "text": "アーヤが今日どこで何をしているのか？"},
        { "location": "320/SEL"     , "narrator": "", "text": "いや、知らない"},
        { "location": "321/SEL"     , "narrator": "", "text": "言ったら来た意味なくなっちゃう"},
        { "location": "322/ACT"     , "narrator": "", "text": "いや、知らない"},
        { "location": "323/TALK"    , "narrator": "ガブリエラ", "text": "そうなの？"},
        { "location": "324/TALK"    , "narrator": "ガブリエラ", "text": "じゃあ、私が一番に知るってことね"},
        { "location": "325/ACT"     , "narrator": "", "text": "言ったら来た意味なくなっちゃう"},
        { "location": "326/TALK"    , "narrator": "ガブリエラ", "text": "そうだった、うっかりしていたわ"},
        { "location": "327/TALK"    , "narrator": "ガブリエラ", "text": "でも、そう言うってことは、マルザンナはアーヤの秘密を知っているの？"},
        { "location": "329/TALK"    , "narrator": "ガブリエラ", "text": "ちょっと悔しいわね"},
        { "location": "330/TALK"    , "narrator": "ガブリエラ", "text": "もういいわ"},
        { "location": "343/TALK"    , "narrator": "ガブリエラ", "text": "…えっと、\n区民センターの\n隣だから…。"},
        { "location": "345/TALK"    , "narrator": "ガブリエラ", "text": "…ここ？\nやっぱり幼稚園\nだけど――"},
        { "location": "346/TALK"    , "narrator": "ガブリエラ", "text": "間違いないみたい。\nアーヤのバイクも\n止まってるし。"},
        { "location": "348/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "349/TALK"    , "narrator": "ガブリエラ", "text": "ま、ちょっとした\n潜入ミッションね。"},
        { "location": "374/TALK"    , "narrator": "ガブリエラ", "text": "…随分賑やかね。\nおやすみなのに、\n何かあるのかしら？"},
        { "location": "375/TALK"    , "narrator": "アーヤ", "text": "はーい、みんな。\nそろそろ始めるから\n座ってねー。"},
        { "location": "376/TALK"    , "narrator": "ガブリエラ", "text": "えっ？\n今の声って…。"},
        { "location": "377/TALK"    , "narrator": "アーヤ", "text": "むかーしむかし、\n森の奥にある\n動物の国に――"},
        { "location": "378/TALK"    , "narrator": "ガブリエラ", "text": "アーヤ！？\n何で人形劇なんて\nやってるの！？"},
        { "location": "379/TALK"    , "narrator": "アーヤ", "text": "ネコさんがクマさんと\n一緒に遊んでいると、\nウサギさんが――"},
        { "location": "380/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "392/TALK"    , "narrator": "ガブリエラ", "text": "どうしたらいいのかしら、マルザンナ"},
        { "location": "393/TALK"    , "narrator": "ガブリエラ", "text": "アーヤの秘密を覗き見しようと思って、ここまで来たけど"},
        { "location": "394/TALK"    , "narrator": "ガブリエラ", "text": "何ていうか"},
        { "location": "395/TALK"    , "narrator": "ガブリエラ", "text": "思っていた以上に、覗き見したらいけないプライベートな一面を見てしまったわ"},
        { "location": "396/TALK"    , "narrator": "ガブリエラ", "text": "なんだか"},
        { "location": "397/TALK"    , "narrator": "ガブリエラ", "text": "凄く悪いことをしてしまった気分よ"},
        { "location": "400/SEL"     , "narrator": "", "text": "バレる前に帰ろう"},
        { "location": "401/SEL"     , "narrator": "", "text": "人形劇見たいなぁ"},
        { "location": "402/ACT"     , "narrator": "", "text": "バレる前に帰ろう"},
        { "location": "403/TALK"    , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "404/TALK"    , "narrator": "ガブリエラ", "text": "バレたら怒られると思うし"},
        { "location": "405/TALK"    , "narrator": "ガブリエラ", "text": "気付かれないように、撤退するわ"},
        { "location": "416/ACT"     , "narrator": "", "text": "人形劇見たいなぁ"},
        { "location": "417/TALK"    , "narrator": "ガブリエラ", "text": "何悠長なことを言っているの！？"},
        { "location": "418/TALK"    , "narrator": "ガブリエラ", "text": "本当、頼りないんだから"},
        { "location": "429/TALK"    , "narrator": "ガブリエラ", "text": "まったく、\nマルザンナってば…。"},
        { "location": "430/TALK"    , "narrator": "ガブリエラ", "text": "…あたしだって、\nできればもっと\n見てたいわよ。"},
        { "location": "431/TALK"    , "narrator": "アーヤ", "text": "お腹がいっぱいに\nなったネコさん達は、\nぐっすりと眠り――"},
        { "location": "432/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "434/TALK"    , "narrator": "ガブリエラ", "text": "バレたらマズいし、\nやっぱり帰ろうかしら。"},
        { "location": "436/TALK"    , "narrator": "ガブリエラ", "text": "そーっと、そーっと。"},
        { "location": "437/TALK"    , "narrator": "子供たち", "text": "あ、不審者だー。"},
        { "location": "439/TALK"    , "narrator": "子供たち", "text": "不審者だ―！"},
        { "location": "441/TALK"    , "narrator": "ガブリエラ", "text": "えぇっ！？\nちょ、あたしは\n別に！"},
        { "location": "445/TALK"    , "narrator": "アーヤ", "text": "ギャヴィ！？"},
        { "location": "446/TALK"    , "narrator": "ガブリエラ", "text": "あちゃー、\nバレちゃった…。"},
        { "location": "471/TALK"    , "narrator": "アーヤ", "text": "こんなところで\n何やってるの！？"},
        { "location": "473/TALK"    , "narrator": "ガブリエラ", "text": "え、えっと、\nそれは…。"},
        { "location": "474/TALK"    , "narrator": "ガブリエラ", "text": "しまったぁ…。\nさっさと逃げてれば\nよかったわ…。"},
        { "location": "475/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "476/TALK"    , "narrator": "アーヤ", "text": "はぁ…まあ、いつか\nバレちゃうとは\n思ってたけど……。"},
        { "location": "477/TALK"    , "narrator": "ガブリエラ", "text": "あ、あの…、黙って\n付いてきちゃって、\nごめん…。"},
        { "location": "478/TALK"    , "narrator": "アーヤ", "text": "…ううん。\n別に怒ってないから。"},
        { "location": "479/TALK"    , "narrator": "アーヤ", "text": "とにかく、あなたも一緒に\n子供たちのところに来て。"},
        { "location": "481/TALK"    , "narrator": "ガブリエラ", "text": "あ、あたしも！？"},
        { "location": "482/TALK"    , "narrator": "アーヤ", "text": "ちゃんと説明しないと\nお話の続きを聞いて\nもらえないでしょ？"},
        { "location": "483/TALK"    , "narrator": "アーヤ", "text": "大丈夫だから、\n一緒に来て。"},
        { "location": "484/TALK"    , "narrator": "ガブリエラ", "text": "う、うん…。"},
        { "location": "488/TALK"    , "narrator": "ガブリエラ", "text": "…何だか、思ったより\n面倒なことに\nなっちゃったっぽい？"},
        { "location": "489/TALK"    , "narrator": "ガブリエラ", "text": "アーヤやみんなにも、\n迷惑掛けちゃってる\nみたいだし…。"},
        { "location": "490/TALK"    , "narrator": "ガブリエラ", "text": "…でも、アーヤの\n秘密が知れたのは、\nちょっと嬉しいかも。"},
        { "location": "491/TALK"    , "narrator": "アーヤ", "text": "ギャヴィ、早く。"},
        { "location": "493/TALK"    , "narrator": "ガブリエラ", "text": "わ、わかってるわよ。"},
        { "location": "504/DIALOG"  , "narrator": "Dialog_chapter_ch03", "text": "【MV EXE_AYAMi】"}
    ]
}
