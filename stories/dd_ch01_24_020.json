{
    "dir": "chap24/daydra/dd_ch01_24_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "24156",
        "cid": "tsubame",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "壊れゆく日常"
    },
    "entry":
    [
        { "location": "301/SCENARIO", "narrator": "", "text": "壊れゆく日常"},
        { "location": "320/TALK"    , "narrator": "つばめ", "text": "…忘れ物はなし、と。"},
        { "location": "323/TALK"    , "narrator": "つばめ", "text": "神楽ちゃん、\n今日は帰り――"},
        { "location": "324/TALK"    , "narrator": "つばめ", "text": "あっ…。"},
        { "location": "328/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "331/TALK"    , "narrator": "雛", "text": "つーばめちゃんっ！"},
        { "location": "333/TALK"    , "narrator": "つばめ", "text": "わわっ！？\nひ、ひなこちゃん…。"},
        { "location": "334/TALK"    , "narrator": "雛", "text": "やっと放課後なのに、\n暗い顔してるなんて\nもったいないよ？"},
        { "location": "335/TALK"    , "narrator": "つばめ", "text": "あ、あはは…そうだよね。"},
        { "location": "336/TALK"    , "narrator": "雛", "text": "はぁ…、つばめちゃんって\n本当わかりやすいなぁ…。"},
        { "location": "338/TALK"    , "narrator": "つばめ", "text": "そ、そうかな？"},
        { "location": "339/TALK"    , "narrator": "雛", "text": "うん、超わかりやすいよ。"},
        { "location": "340/TALK"    , "narrator": "雛", "text": "そうだ！　こういう時は\n甘いものでも食べながら\nお話しようよ！"},
        { "location": "341/TALK"    , "narrator": "雛", "text": "きっと、ちょっとは\n気分転換になると思うし。"},
        { "location": "343/TALK"    , "narrator": "つばめ", "text": "…うん。\nわたしも、ちょっと\nお話ししたいな。"},
        { "location": "344/TALK"    , "narrator": "雛", "text": "決まり！\nじゃ、まゆちん\n呼んでくるねー。"},
        { "location": "361/TALK"    , "narrator": "雛", "text": "――でね、夏休みの宿題が\nずーっと終わらなくて、\n最終日徹夜だったのよー。"},
        { "location": "363/TALK"    , "narrator": "つばめ", "text": "あはは、そうだったんだ。"},
        { "location": "364/TALK"    , "narrator": "雛", "text": "うん…つばめちゃんは\nちゃんと終わらせられた？"},
        { "location": "365/TALK"    , "narrator": "つばめ", "text": "みやびさんの家で\n終わらせたよ。"},
        { "location": "366/TALK"    , "narrator": "つばめ", "text": "まあ、ガブちゃんにも\nちょっと手伝っては\nもらったけど…。"},
        { "location": "367/TALK"    , "narrator": "繭", "text": "…ガブリエラって、\n下級生だけど？"},
        { "location": "370/TALK"    , "narrator": "つばめ", "text": "あ、あはは…、\nちょっとカッコ悪いけど、\n色々教わっちゃった…。"},
        { "location": "372/TALK"    , "narrator": "雛", "text": "いいなー。あたしも\nガブリエラちゃんに\n教えてほしかったなー。"},
        { "location": "373/TALK"    , "narrator": "つばめ", "text": "頼めば教えてくれると\n思うけど、\nとっても厳しいよ？"},
        { "location": "374/TALK"    , "narrator": "繭", "text": "逆にガブリエラが\n優しく教えたら怖いと\n思うけど？"},
        { "location": "376/TALK"    , "narrator": "雛", "text": "あはは、確かに。"},
        { "location": "379/TALK"    , "narrator": "つばめ", "text": "ふふっ…。"},
        { "location": "381/TALK"    , "narrator": "つばめ", "text": "…そういえば、\nキリトくん達からは\n連絡あった？"},
        { "location": "383/TALK"    , "narrator": "雛", "text": "ううん、ぜーんぜん。\nＷＡＶＥの既読すら\nつかないよ。"},
        { "location": "384/TALK"    , "narrator": "つばめ", "text": "そっか…。"},
        { "location": "385/TALK"    , "narrator": "繭", "text": "…仕方ないわ。\n通常攻撃隊は待機命令が\n出てるんだし。"},
        { "location": "386/TALK"    , "narrator": "繭", "text": "学校にも来てないのに、\n外部との連絡に制限が\nかけられてないと思う？"},
        { "location": "388/TALK"    , "narrator": "つばめ", "text": "待機命令…。\nどういうことなんだろ？"},
        { "location": "389/SEL"     , "narrator": "", "text": "嫌な予感がするよ"},
        { "location": "392/TALK"    , "narrator": "雛", "text": "さーねー？\n先生に聞いてみたけど、\n教えてもらえなかったよ。"},
        { "location": "394/TALK"    , "narrator": "繭", "text": "一般教諭には\n知らされてないはず。"},
        { "location": "396/TALK"    , "narrator": "雛", "text": "情報漏洩を防ぐため？"},
        { "location": "397/TALK"    , "narrator": "繭", "text": "当然。"},
        { "location": "401/TALK"    , "narrator": "つばめ", "text": "…みんな、こうやって\nどんどん忙しくなるの\nかな？"},
        { "location": "402/TALK"    , "narrator": "繭", "text": "…それも仕方ないわ。\n私達の学校は、他と違って\n特殊なんだから…。"},
        { "location": "405/TALK"    , "narrator": "雛", "text": "そうだよねー。"},
        { "location": "406/TALK"    , "narrator": "雛", "text": "…じゃあ、段々と\nみんな揃うことも、\n減ってくのかな？"},
        { "location": "408/TALK"    , "narrator": "繭", "text": "…今よりかは減ると思う。\n進級とかすれば、確実に。"},
        { "location": "410/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "424/TALK"    , "narrator": "つばめ", "text": "…みんなが揃うことも、\n段々減ってく、か…。"},
        { "location": "425/TALK"    , "narrator": "つばめ", "text": "…でも、そうだよね。"},
        { "location": "426/TALK"    , "narrator": "つばめ", "text": "今はみんな一緒でも、\n進級や、進学すれば\nバラバラになるんだし…。"},
        { "location": "427/TALK"    , "narrator": "つばめ", "text": "…せっかく、\nお友達になれたのに…。"},
        { "location": "429/TALK"    , "narrator": "つばめ", "text": "はぁ…。"},
        { "location": "432/TALK"    , "narrator": "ガブリエラ", "text": "…それ、あたしに対しての\nため息かしら？"},
        { "location": "434/TALK"    , "narrator": "つばめ", "text": "えっ！？　あ、違うよ！\nちょっと考え事してて…。"},
        { "location": "435/TALK"    , "narrator": "ガブリエラ", "text": "何を考えてたのよ？"},
        { "location": "437/TALK"    , "narrator": "つばめ", "text": "うん…いつかはみんな、\nバラバラになる日が\n来るのかなぁ、って…。"},
        { "location": "438/TALK"    , "narrator": "つばめ", "text": "進級とか、進学とか…、\n実家に帰るとか、\n理由は違うと思うけど。"},
        { "location": "439/TALK"    , "narrator": "つばめ", "text": "そうやって、離ればなれに\nなる日は…来るんだよね？"},
        { "location": "440/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "441/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "442/TALK"    , "narrator": "ガブリエラ", "text": "いや、当然じゃん。\nってか考えるまでもない\nことでしょ、それ？"},
        { "location": "444/TALK"    , "narrator": "つばめ", "text": "えっ…そ、そうかな？"},
        { "location": "445/TALK"    , "narrator": "ガブリエラ", "text": "じゃあ何よ？\nつばめは一生あの寮で\n暮らすつもりなわけ？"},
        { "location": "447/TALK"    , "narrator": "つばめ", "text": "そ、そんなことは\nないけど…。"},
        { "location": "448/TALK"    , "narrator": "ガブリエラ", "text": "でしょ？"},
        { "location": "451/TALK"    , "narrator": "ガブリエラ", "text": "そんな当たり前のこと\n考えてため息吐くとか、\n本当、お子ちゃまよね…。"},
        { "location": "453/TALK"    , "narrator": "つばめ", "text": "で、でも、ガブちゃんは\nそれで平気なの？"},
        { "location": "454/TALK"    , "narrator": "つばめ", "text": "バラバラになったら、\n中々会うこともできなく\nなっちゃうんだよ？"},
        { "location": "455/TALK"    , "narrator": "つばめ", "text": "それに…もしかしたら、\nもう会えなくなったりも\nするかもしれないし…。"},
        { "location": "457/TALK"    , "narrator": "ガブリエラ", "text": "そりゃ、そういうことも\nなくはないでしょ。"},
        { "location": "459/TALK"    , "narrator": "つばめ", "text": "そんな…。"},
        { "location": "460/TALK"    , "narrator": "ガブリエラ", "text": "…まさかとは思うけど、\n寂しいからイヤだ、とか\n言わないわよね？"},
        { "location": "462/TALK"    , "narrator": "つばめ", "text": "…ガブちゃんは、\n寂しくないの？"},
        { "location": "464/TALK"    , "narrator": "ガブリエラ", "text": "はぁ…あんたねぇ…。"},
        { "location": "466/TALK"    , "narrator": "ガブリエラ", "text": "そりゃさ…まあ、あたしも\nちょっとは寂しいと\n思わなくもないけど…。"},
        { "location": "468/TALK"    , "narrator": "ガブリエラ", "text": "でも、それであたし達の\n繋がりが消えるわけじゃ\nないでしょ？"},
        { "location": "470/TALK"    , "narrator": "つばめ", "text": "…え？"},
        { "location": "472/TALK"    , "narrator": "ガブリエラ", "text": "あのね…同じ戦場で、\n背中護り合って戦った\n仲間なのよ？"},
        { "location": "473/TALK"    , "narrator": "ガブリエラ", "text": "それが、離ればなれに\nなっただけで気持ちが\nバラバラになると思う？"},
        { "location": "474/TALK"    , "narrator": "つばめ", "text": "お、思わないよ。\nそんなこと…。"},
        { "location": "476/TALK"    , "narrator": "ガブリエラ", "text": "本当かしら？"},
        { "location": "477/TALK"    , "narrator": "つばめ", "text": "本当だよ！"},
        { "location": "478/TALK"    , "narrator": "ガブリエラ", "text": "じゃあ、何でそんなに\n不安になってんのよ？"},
        { "location": "479/TALK"    , "narrator": "ガブリエラ", "text": "相手を信じられるなら、\nそんな不安になるはず\nないでしょ？"},
        { "location": "480/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "482/TALK"    , "narrator": "ガブリエラ", "text": "…まあさ、あたしも…、\nもしもよ？"},
        { "location": "483/TALK"    , "narrator": "ガブリエラ", "text": "もし、本当にみんなと\nバラバラになるような\nことになったらよ？"},
        { "location": "484/TALK"    , "narrator": "ガブリエラ", "text": "そうなったら…、\n会いたい、って…、\n時々は思うだろうし…。"},
        { "location": "485/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "487/TALK"    , "narrator": "ガブリエラ", "text": "と、時々よ！？\nいつもじゃないから、\nわかってる？"},
        { "location": "488/TALK"    , "narrator": "つばめ", "text": "…大丈夫だよ。"},
        { "location": "489/TALK"    , "narrator": "つばめ", "text": "もしガブちゃんが、\n寂しいって気持ちに\nなったとしたら――"},
        { "location": "490/TALK"    , "narrator": "つばめ", "text": "わたし、世界中の\nどこでもガブちゃんに\n会いに行くから。"},
        { "location": "491/TALK"    , "narrator": "ガブリエラ", "text": "…いや、無理でしょそれ？\nあんた海外旅行したこと\nあるの？"},
        { "location": "492/TALK"    , "narrator": "つばめ", "text": "な、ないけど…、\n頑張って会いに行くよ！"},
        { "location": "493/TALK"    , "narrator": "ガブリエラ", "text": "まったく信用できないん\nだけど…。"},
        { "location": "494/TALK"    , "narrator": "ガブリエラ", "text": "ていうか、考え事の\n答えは出たの？"},
        { "location": "496/TALK"    , "narrator": "つばめ", "text": "うん…ガブちゃんの\nおかげだよ。"},
        { "location": "497/TALK"    , "narrator": "つばめ", "text": "わたしは、ガブちゃん達や\nひなこちゃん達のこと、\n本当に信じてる。"},
        { "location": "498/TALK"    , "narrator": "つばめ", "text": "だから、もしバラバラに\nなったとしても、気持ちは\n繋がってると思う。"},
        { "location": "499/TALK"    , "narrator": "つばめ", "text": "気持ちが繋がってれば…、\nきっと、また会うことは\nできるよね？"},
        { "location": "500/TALK"    , "narrator": "ガブリエラ", "text": "繋がってないよりかは\n可能性あるんじゃない？"},
        { "location": "501/TALK"    , "narrator": "つばめ", "text": "うん…そうだよね…。"},
        { "location": "502/TALK"    , "narrator": "ガブリエラ", "text": "まったく…暗かったり、\n急に元気になったり、\n落ち着かないんだから…。"},
        { "location": "503/TALK"    , "narrator": "つばめ", "text": "えへへ…。"},
        { "location": "504/TALK"    , "narrator": "つばめ", "text": "気持ちが繋がってれば、\nまた会える、か…。"},
        { "location": "506/TALK"    , "narrator": "つばめ", "text": "…ねえ、ガブちゃん。"},
        { "location": "507/TALK"    , "narrator": "つばめ", "text": "神楽ちゃんの気持ちは、\nわたし達と繋がってると\n思う？"},
        { "location": "508/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "509/TALK"    , "narrator": "つばめ", "text": "わたしは、今でも\n神楽ちゃんのことを\n信じてるよ。"},
        { "location": "510/TALK"    , "narrator": "つばめ", "text": "きっとまた仲良くなれて、\n一緒にいられるように\nなる、って…。"},
        { "location": "511/TALK"    , "narrator": "つばめ", "text": "どうかな？\n神楽ちゃんも、\n思ってくれてるかな？"},
        { "location": "513/TALK"    , "narrator": "ガブリエラ", "text": "…知らないわよ、\nあんな奴のことなんて。"},
        { "location": "517/TALK"    , "narrator": "つばめ", "text": "あっ…。"},
        { "location": "519/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "520/TALK"    , "narrator": "つばめ", "text": "今のは…わたしが\nいけなかったよね…。"},
        { "location": "521/ACT"     , "narrator": "", "text": "嫌な予感がするよ"},
        { "location": "533/TALK"    , "narrator": "つばめ", "text": "嫌な予感？(･Д･｀)"},
        { "location": "534/TALK"    , "narrator": "つばめ", "text": "それ"},
        { "location": "535/TALK"    , "narrator": "つばめ", "text": "どんなの？(´・ω・｀)"},
        { "location": "537/SEL"     , "narrator": "", "text": "管理庁が何かしてくるかも"},
        { "location": "538/ACT"     , "narrator": "", "text": "管理庁が何かしてくるかも"},
        { "location": "540/TALK"    , "narrator": "つばめ", "text": "どぅかな？"},
        { "location": "541/TALK"    , "narrator": "つばめ", "text": "さすがに"},
        { "location": "542/TALK"    , "narrator": "つばめ", "text": "なぃと思ぅけど(´ｪ｀；)三(；´ｪ｀)"},
        { "location": "543/TALK"    , "narrator": "つばめ", "text": "だって"},
        { "location": "544/TALK"    , "narrator": "つばめ", "text": "神楽ちゃんがヽ(･ω･ )ゝ☆"},
        { "location": "547/TALK"    , "narrator": "つばめ", "text": "ぅぅん"},
        { "location": "548/TALK"    , "narrator": "つばめ", "text": "なんでもなぃ(o´Д`)=з"},
        { "location": "549/TALK"    , "narrator": "つばめ", "text": "ごめんね"},
        { "location": "550/TALK"    , "narrator": "つばめ", "text": "また後でね"},
        { "location": "557/TALK"    , "narrator": "つばめ", "text": "…神楽ちゃんがいるから、\n管理庁に何かさせたりは\nしないはず…。"},
        { "location": "559/TALK"    , "narrator": "つばめ", "text": "なんて…そんなこと\n思ったなんて、\nさすがに言えないよね。"},
        { "location": "560/TALK"    , "narrator": "つばめ", "text": "そんなこと言ったら、\n絶対に怒られちゃうし…。"},
        { "location": "562/TALK"    , "narrator": "雛", "text": "つばめちゃん、大丈夫？"},
        { "location": "565/TALK"    , "narrator": "つばめ", "text": "う、うん、大丈夫…。"},
        { "location": "566/TALK"    , "narrator": "つばめ", "text": "でも、キリトくん達\n授業にも出れないくらい\n忙しいなんて、大変だね。"},
        { "location": "567/TALK"    , "narrator": "繭", "text": "キリト達だけじゃない。\n私達だって、段々と\n忙しくなるから。"},
        { "location": "568/TALK"    , "narrator": "繭", "text": "うちは特殊な学校だから、\n普通のところに比べて、\n学ぶことも多いし…。"},
        { "location": "310/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>9月2日　 4:05 PM</color>\nとある平日の放課後、付属学園つばめの教室にて"}
    ]
}
