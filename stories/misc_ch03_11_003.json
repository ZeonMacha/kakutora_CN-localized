        { "location": "185/SCENARIO", "narrator": "", "text": "015_孤独なうさぎ"},
        { "location": "210/TALK"    , "narrator": "ガブリエラ", "text": "日本にはかみさまがいっぱいいるけど"},
        { "location": "211/TALK"    , "narrator": "ガブリエラ", "text": "みんながみんな仲がいいわけじゃないのね"},
        { "location": "213/SEL"     , "narrator": "", "text": "まあね"},
        { "location": "214/SEL"     , "narrator": "", "text": "意外だった？"},
        { "location": "215/SEL"     , "narrator": "", "text": "日本に詳しいんだね"},
        { "location": "216/ACT"     , "narrator": "", "text": "まあね"},
        { "location": "217/TALK"    , "narrator": "ガブリエラ", "text": "そうよね"},
        { "location": "218/TALK"    , "narrator": "ガブリエラ", "text": "そういうものかもしれないわね・・・"},
        { "location": "219/ACT"     , "narrator": "", "text": "意外だった？"},
        { "location": "220/TALK"    , "narrator": "ガブリエラ", "text": "少しね"},
        { "location": "221/TALK"    , "narrator": "ガブリエラ", "text": "神様なのにそうなのかしらって思ったわ"},
        { "location": "222/ACT"     , "narrator": "", "text": "日本に詳しいんだね"},
        { "location": "224/TALK"    , "narrator": "ガブリエラ", "text": "もちろんよｖｖｖ"},
        { "location": "225/TALK"    , "narrator": "ガブリエラ", "text": "だっていっぱい勉強しているんだものｖｖｖ"},
        { "location": "227/TALK"    , "narrator": "ガブリエラ", "text": "神田明神っていうところには三人の神様がいるんですって"},
        { "location": "229/SEL"     , "narrator": "", "text": "三人が仲悪いの？"},
        { "location": "230/ACT"     , "narrator": "", "text": "三人が仲悪いの？"},
        { "location": "232/TALK"    , "narrator": "ガブリエラ", "text": "ううん"},
        { "location": "233/TALK"    , "narrator": "ガブリエラ", "text": "そうじゃないのよ"},
        { "location": "234/TALK"    , "narrator": "ガブリエラ", "text": "その中のマサカドさまって神様と仲の良くない神様が千葉にいるんですって"},
        { "location": "236/SEL"     , "narrator": "", "text": "ふーん"},
        { "location": "237/SEL"     , "narrator": "", "text": "昔の話でしょ"},
        { "location": "238/SEL"     , "narrator": "", "text": "微妙に違う…"},
        { "location": "239/ACT"     , "narrator": "", "text": "ふーん"},
        { "location": "240/TALK"    , "narrator": "ガブリエラ", "text": "興味なかったかしら？"},
        { "location": "241/ACT"     , "narrator": "", "text": "昔の話でしょ"},
        { "location": "242/TALK"    , "narrator": "ガブリエラ", "text": "そうかもしれないけど・・・"},
        { "location": "243/ACT"     , "narrator": "", "text": "微妙に違う…"},
        { "location": "244/TALK"    , "narrator": "ガブリエラ", "text": "大体合ってればいいと思うわ"},
        { "location": "246/TALK"    , "narrator": "ガブリエラ", "text": "神様はみんなに優しくて、平等なのだと思っていたけれど"},
        { "location": "247/TALK"    , "narrator": "ガブリエラ", "text": "そういうものじゃないのかしらね"},
        { "location": "249/SEL"     , "narrator": "", "text": "神様だって人間だし"},
        { "location": "250/SEL"     , "narrator": "", "text": "$me$はガブを贔屓しまくりだし"},
        { "location": "251/SEL"     , "narrator": "", "text": "それが日本の奥深さ"},
        { "location": "252/ACT"     , "narrator": "", "text": "神様だって人間だし"},
        { "location": "253/TALK"    , "narrator": "ガブリエラ", "text": "それは言葉としておかしくてよ？"},
        { "location": "254/ACT"     , "narrator": "", "text": "$me$はガブを贔屓しまくりだし"},
        { "location": "256/TALK"    , "narrator": "ガブリエラ", "text": "そんなのvvvvvvvvvvvvvv"},
        { "location": "257/TALK"    , "narrator": "ガブリエラ", "text": "知ってるわよvvvvvvvvvvvvvv"},
        { "location": "258/TALK"    , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "259/TALK"    , "narrator": "ガブリエラ", "text": "女の子が$me$なんて言うのは感心しなくてよ？"},
        { "location": "260/ACT"     , "narrator": "", "text": "それが日本の奥深さ"},
        { "location": "261/TALK"    , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "263/TALK"    , "narrator": "ガブリエラ", "text": "かみさまでもほかの神様と仲良くするのって難しいものなのね"},
        { "location": "264/TALK"    , "narrator": "ガブリエラ", "text": "神様なのにね"}
    ]
