{
    "dir": "chap27/daydra/dd_ch05_27_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "27505",
        "cid": "kagura",
        "title": "005 メインストーリー",
        "sub_title": "その先への妥結点＜後編＞"
    },
    "entry":
    [
        { "location": "2530/TALK"  , "narrator": "神楽", "text": "…もう、しつこい。"},
        { "location": "2556/TALK"  , "narrator": "神楽", "text": "はい――"},
        { "location": "2558/TALK"  , "narrator": "神楽", "text": "っ！？"},
        { "location": "2562/TALK"  , "narrator": "繭", "text": "…こんにちは。"},
        { "location": "2563/TALK"  , "narrator": "雛", "text": "久しぶりだね…。"},
        { "location": "2564/TALK"  , "narrator": "神楽", "text": "…どうして？\n家の場所、\n教えてないのに…。"},
        { "location": "2565/TALK"  , "narrator": "繭", "text": "東雲教官から\n教えてもらった。"},
        { "location": "2568/TALK"  , "narrator": "神楽", "text": "…あの人は、\n人の個人情報を\n勝手に…。"},
        { "location": "2569/TALK"  , "narrator": "神楽", "text": "あとで抗議するべき\nかもしれませんね。"},
        { "location": "2570/TALK"  , "narrator": "繭", "text": "勝手にどうぞ。\n自分のしたことを\n棚に上げられればね。"},
        { "location": "2572/TALK"  , "narrator": "神楽", "text": "…私がなにをしたか、\n知ってるんですね。"},
        { "location": "2573/TALK"  , "narrator": "雛", "text": "全部聞いたよ。\nほんと、ビックリ\nしたんだから…。"},
        { "location": "2574/TALK"  , "narrator": "神楽", "text": "…それで？\nＷＡＶＥじゃ\n話せないことですか？"},
        { "location": "2575/TALK"  , "narrator": "繭", "text": "監視されてるでしょ？\n会話を覗き見される\nなんてごめんだもの。"},
        { "location": "2576/TALK"  , "narrator": "繭", "text": "だから、直接来た…。\n上がっても？"},
        { "location": "2577/TALK"  , "narrator": "神楽", "text": "ダメ！！"},
        { "location": "2580/TALK"  , "narrator": "神楽", "text": "家の中は…。\n話なら、外で…。"},
        { "location": "2607/TALK"  , "narrator": "神楽", "text": "…それで？\nどうしてうちに\n来たんですか？"},
        { "location": "2608/TALK"  , "narrator": "繭", "text": "卯月さんになにが\nあったのか…。\n教官から全部聞いた。"},
        { "location": "2609/TALK"  , "narrator": "繭", "text": "正直、あなたが\n裏切ったと聞いた時は\n許せなかったけど…。"},
        { "location": "2610/TALK"  , "narrator": "繭", "text": "事情を知ったから、\n許すわ。"},
        { "location": "2611/TALK"  , "narrator": "神楽", "text": "…は？\nなんですか、それ？"},
        { "location": "2612/TALK"  , "narrator": "神楽", "text": "私がいつ許しを\n請いましたか？"},
        { "location": "2613/TALK"  , "narrator": "繭", "text": "…言い方が悪かった。\n今のは忘れて。"},
        { "location": "2614/TALK"  , "narrator": "雛", "text": "…………。"},
        { "location": "2615/TALK"  , "narrator": "神楽", "text": "…なんですか、\nひなこさん？"},
        { "location": "2616/TALK"  , "narrator": "雛", "text": "いや、ちょっとね。\n今の神楽ちゃん、\n新鮮だなー、って。"},
        { "location": "2617/TALK"  , "narrator": "繭", "text": "同感。\nそんな風に怒るの、\n初めて見たから。"},
        { "location": "2618/TALK"  , "narrator": "繭", "text": "…あなたも、\n人間ってことね。\n安心した。"},
        { "location": "2621/TALK"  , "narrator": "神楽", "text": "に、人間って…。\nなんですかそれ…。"},
        { "location": "2622/TALK"  , "narrator": "繭", "text": "思ったことを\n言っただけ。\n気にしないで。"},
        { "location": "2623/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "2624/TALK"  , "narrator": "神楽", "text": "でも…なんでだろ？"},
        { "location": "2626/TALK"  , "narrator": "神楽", "text": "ちょっとだけ、\n気持ちがラクに\nなったような…。"},
        { "location": "2629/TALK"  , "narrator": "神楽", "text": "…そ、それで？\n私になんの用なん\nですか？"},
        { "location": "2630/TALK"  , "narrator": "繭", "text": "ちょっとした\nお願いだけど――"},
        { "location": "2632/TALK"  , "narrator": "雛", "text": "神楽ちゃんの\nガジェット、\nちょっと貸してー。"},
        { "location": "2633/TALK"  , "narrator": "神楽", "text": "は？"},
        { "location": "2642/TALK"  , "narrator": "雛", "text": "それじゃ遠慮なく、\nフトモモを拝借っと！"},
        { "location": "2643/TALK"  , "narrator": "神楽", "text": "あ、ちょっと\nひなこさん！！\nなにしてるんですか！"},
        { "location": "2646/TALK"  , "narrator": "雛", "text": "取れないみたいだから\nそのまま配線するしか\nないでしょ？"},
        { "location": "2651/TALK"  , "narrator": "神楽", "text": "待ってください！\nちゃんと理由を\n説明してください！"},
        { "location": "2652/TALK"  , "narrator": "繭", "text": "情報管理庁の\n内部情報を\n調べていたら…。"},
        { "location": "2653/TALK"  , "narrator": "繭", "text": "ちょっと見過ごせない\nことがあって。"},
        { "location": "2654/TALK"  , "narrator": "神楽", "text": "…というと？"},
        { "location": "2655/TALK"  , "narrator": "繭", "text": "トライナリーの情報を\n見つけたの。"},
        { "location": "2656/TALK"  , "narrator": "神楽", "text": "管理庁なんだから、\nあって当然だと\n思いますけど？"},
        { "location": "2657/TALK"  , "narrator": "繭", "text": "逢瀬さん達の\nガジェットとの\nI/Oも見つけた。"},
        { "location": "2658/TALK"  , "narrator": "繭", "text": "どうやったのかは\nわからないけど…。"},
        { "location": "2659/TALK"  , "narrator": "繭", "text": "ただ、その中に\n卯月さんのだけは\n無かった…。"},
        { "location": "2662/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "2663/TALK"  , "narrator": "繭", "text": "ヒントは多分、\nそこにあるはず。"},
        { "location": "2664/TALK"  , "narrator": "繭", "text": "だから、サーバー側に\n何も無いのなら…。"},
        { "location": "2665/TALK"  , "narrator": "繭", "text": "クライアントを\n調べるというのが\n鉄則。"},
        { "location": "2666/TALK"  , "narrator": "繭", "text": "だから、触らせて\nもらいに来た。"},
        { "location": "2667/TALK"  , "narrator": "雛", "text": "そーゆーわけだから、\nちょっと失礼ー。"},
        { "location": "2669/TALK"  , "narrator": "神楽", "text": "そ、それなら、\n私が自分で\n配線しますから――"},
        { "location": "2670/TALK"  , "narrator": "雛", "text": "神楽ちゃん、\n動かない！！"},
        { "location": "2672/TALK"  , "narrator": "神楽", "text": "は、はい…。"},
        { "location": "2677/TALK"  , "narrator": "雛", "text": "えーっと…。"},
        { "location": "2679/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "2680/TALK"  , "narrator": "雛", "text": "あれ？\n神楽ちゃん、\nどうかした？"},
        { "location": "2682/TALK"  , "narrator": "神楽", "text": "い、いえ…。\nまだですか？"},
        { "location": "2683/TALK"  , "narrator": "雛", "text": "もーちょいだよー。"},
        { "location": "2688/TALK"  , "narrator": "神楽", "text": "…配線が、\n太ももに当たって\nくすぐったい…。"},
        { "location": "2689/TALK"  , "narrator": "雛", "text": "ん、できたよー。\n後はまゆちん、\nよろしくー。"},
        { "location": "2690/TALK"  , "narrator": "繭", "text": "…問題ない。\nちゃんと繋がってる。"},
        { "location": "2691/TALK"  , "narrator": "繭", "text": "データを取る間、\nそのまま動かないで。"},
        { "location": "2693/TALK"  , "narrator": "神楽", "text": "…わかりました。"},
        { "location": "2694/TALK"  , "narrator": "神楽", "text": "…っていうか、\nこれ絶対パンツ\n丸見えじゃない？"},
        { "location": "2695/TALK"  , "narrator": "神楽", "text": "こんなことなら、\n丈の長いスカート\n履いてくるんだった。"},
        { "location": "2696/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "2697/TALK"  , "narrator": "雛", "text": "これ…すごいね。"},
        { "location": "2698/TALK"  , "narrator": "繭", "text": "ええ…驚いた。"},
        { "location": "2701/TALK"  , "narrator": "神楽", "text": "な、なにかデータが\n取れたんですか？"},
        { "location": "2702/TALK"  , "narrator": "雛", "text": "うん…真っ黒。"},
        { "location": "2703/TALK"  , "narrator": "神楽", "text": "黒？"},
        { "location": "2705/TALK"  , "narrator": "雛", "text": "神楽ちゃん、\n黒パンツなんだね。\n大人だなー。"},
        { "location": "2707/TALK"  , "narrator": "神楽", "text": "は！？"},
        { "location": "2708/TALK"  , "narrator": "繭", "text": "さすがはお嬢様。\nこれを履いてるなんて\nお目が高い。"},
        { "location": "2709/TALK"  , "narrator": "神楽", "text": "ま、繭さんまで！"},
        { "location": "2710/TALK"  , "narrator": "雛", "text": "おおっ、まゆちんも\nそう思う！？"},
        { "location": "2711/TALK"  , "narrator": "繭", "text": "これ、フランスの\nウン・プティッテ・フィル\nミニヨンでしょ。"},
        { "location": "2714/TALK"  , "narrator": "神楽", "text": "ちょっ！\nうそ、なんで！？"},
        { "location": "2715/TALK"  , "narrator": "雛", "text": "へー、おフランス製！？"},
        { "location": "2716/TALK"  , "narrator": "繭", "text": "俗な安物じゃない、\n本気のゴシック系\nブランドね。"},
        { "location": "2717/TALK"  , "narrator": "繭", "text": "そのショーツを\n持ってるなんて…、\nマニアック過ぎる。"},
        { "location": "2718/TALK"  , "narrator": "神楽", "text": "うわあああああ、\n恥ずかしすぎるん\nですけどこれ！"},
        { "location": "2719/TALK"  , "narrator": "雛", "text": "っていうか、\nまゆちんは\nなんで知ってるの？"},
        { "location": "2720/TALK"  , "narrator": "繭", "text": "そ、それは…。"},
        { "location": "2721/TALK"  , "narrator": "繭", "text": "私も…、いくつか\n持ってるから…。"},
        { "location": "2722/TALK"  , "narrator": "神楽", "text": "え！？"},
        { "location": "2723/TALK"  , "narrator": "神楽", "text": "繭さんも\n持ってるんですか！？"},
        { "location": "2724/TALK"  , "narrator": "繭", "text": "デザイン、\n生地の肌触り、\nどちらも極上。"},
        { "location": "2725/TALK"  , "narrator": "神楽", "text": "フィット感も\nいいですよね。"},
        { "location": "2726/TALK"  , "narrator": "繭", "text": "履いてるのを忘れる\n軽いフィット感…、\nクセになるわ。"},
        { "location": "2727/TALK"  , "narrator": "雛", "text": "そんなにいいんだー？\nあたしも履いてみよう\nかなー？"},
        { "location": "2728/TALK"  , "narrator": "繭", "text": "ひなこには\n似合わない。"},
        { "location": "2729/TALK"  , "narrator": "神楽", "text": "ひなこさんには\n合わないかも…。"},
        { "location": "2730/TALK"  , "narrator": "雛", "text": "ちょ！？\n二人ともヒドい！！"},
        { "location": "2731/TALK"  , "narrator": "繭", "text": "ふふっ…。"},
        { "location": "2732/TALK"  , "narrator": "神楽", "text": "ふふっ…。"},
        { "location": "2737/TALK"  , "narrator": "繭", "text": "データが\n取れたみたい。"},
        { "location": "2738/TALK"  , "narrator": "雛", "text": "どう？\nちゃんと取れてる？"},
        { "location": "2740/TALK"  , "narrator": "繭", "text": "今確認する。"},
        { "location": "2754/TALK"  , "narrator": "繭", "text": "…ッ！？\nこれは…。"},
        { "location": "2755/TALK"  , "narrator": "雛", "text": "ど、どうしたの？\nなにかヤバいこと\n書いてあった？"},
        { "location": "2756/TALK"  , "narrator": "繭", "text": "…日付が、\n２０３２年って…。"},
        { "location": "2758/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "2759/TALK"  , "narrator": "雛", "text": "設定が狂ってる…、\nなんて、ないよね？"},
        { "location": "2760/TALK"  , "narrator": "繭", "text": "ありえない…。\nだとすると…。"},
        { "location": "2761/TALK"  , "narrator": "繭", "text": "卯月さん。\nなにか心当たりが\nあるんじゃない？"},
        { "location": "2762/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "2764/TALK"  , "narrator": "雛", "text": "神楽ちゃん！\n知ってるなら教えて！"},
        { "location": "2765/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "2766/TALK"  , "narrator": "神楽", "text": "わかり、ました…。"},
        { "location": "2768/TALK"  , "narrator": "神楽", "text": "私も…これ以上、\nひなこさん達に…。"},
        { "location": "2769/TALK"  , "narrator": "神楽", "text": "ウソはつきたく\nありません。"},
        { "location": "2772/TALK"  , "narrator": "神楽", "text": "本当のことを\nお話しします。"},
        { "location": "2773/TALK"  , "narrator": "神楽", "text": "私は――"},
        { "location": "2783/DIALOG", "narrator": "Dialog_chapter_ch05", "text": "【22 トークン・リング】"},
        { "location": "2795/DIALOG", "narrator": "Dialog_chapter_ch05", "text": "【22 トークン・リング】"}
    ]
}
