        { "location": "67/ACT"    , "narrator": "", "text": "そういう時は$me$を呼んで"},
        { "location": "69/TALK"   , "narrator": "つばめ", "text": "ぅん"},
        { "location": "70/TALK"   , "narrator": "つばめ", "text": "そぅする"},
