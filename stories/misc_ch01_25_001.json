        { "location": "57/ACT"    , "narrator": "", "text": "無理すんな"},
        { "location": "58/TALK"   , "narrator": "つばめ", "text": "無理"},
        { "location": "60/TALK"   , "narrator": "つばめ", "text": "してるのかな"},
        { "location": "61/TALK"   , "narrator": "つばめ", "text": "そっか"},
