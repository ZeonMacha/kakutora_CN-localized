    "entry":
    [
        { "location": "181/SCENARIO", "narrator": "", "text": "018_有能すぎるでくのぼう"},
        { "location": "206/TALK"    , "narrator": "みやび", "text": "お茶うけに適した食材を見繕ってくれたまえ"},
        { "location": "209/SEL"     , "narrator": "", "text": "和菓子などいかがでしょうか"},
        { "location": "210/SEL"     , "narrator": "", "text": "野沢菜？"},
        { "location": "211/SEL"     , "narrator": "", "text": "みやびが食べたいものはなに？"},
        { "location": "212/ACT"     , "narrator": "", "text": "和菓子などいかがでしょうか"},
        { "location": "213/TALK"    , "narrator": "みやび", "text": "これはまた"},
        { "location": "214/TALK"    , "narrator": "みやび", "text": "凡庸な"},
        { "location": "215/ACT"     , "narrator": "", "text": "野沢菜？"},
        { "location": "216/TALK"    , "narrator": "みやび", "text": "惜しい"},
        { "location": "217/TALK"    , "narrator": "みやび", "text": "もう一息"},
        { "location": "218/ACT"     , "narrator": "", "text": "みやびが食べたいものはなに？"},
        { "location": "220/TALK"    , "narrator": "みやび", "text": "それを当ててみよと言ったわけで"},
        { "location": "221/TALK"    , "narrator": "みやび", "text": "逆質問とは"},
        { "location": "222/TALK"    , "narrator": "みやび", "text": "いい度胸ぞね"},
        { "location": "223/TALK"    , "narrator": "みやび", "text": "誉めてつかわす"},
        { "location": "225/TALK"    , "narrator": "みやび", "text": "しかし"},
        { "location": "226/TALK"    , "narrator": "みやび", "text": "息抜きに"},
        { "location": "227/TALK"    , "narrator": "みやび", "text": "ティーブレイクでもするべきだったか"},
        { "location": "229/SEL"     , "narrator": "", "text": "忙しいの？"},
        { "location": "230/SEL"     , "narrator": "", "text": "よかったら付き合うよ"},
        { "location": "231/SEL"     , "narrator": "", "text": "今からすれば"},
        { "location": "232/ACT"     , "narrator": "", "text": "忙しいの？"},
        { "location": "233/TALK"    , "narrator": "みやび", "text": "忙しいぞね"},
        { "location": "234/TALK"    , "narrator": "みやび", "text": "$handle$と会話を続けられぬくらいに"},
        { "location": "236/ACT"     , "narrator": "", "text": "よかったら付き合うよ"},
        { "location": "238/TALK"    , "narrator": "みやび", "text": "うむ"},
        { "location": "239/TALK"    , "narrator": "みやび", "text": "かたじけない"},
        { "location": "240/TALK"    , "narrator": "みやび", "text": "そうしてもらおうか"},
        { "location": "241/TALK"    , "narrator": "みやび", "text": "次の機会に"},
        { "location": "243/ACT"     , "narrator": "", "text": "今からすれば"},
        { "location": "244/TALK"    , "narrator": "みやび", "text": "いや"},
        { "location": "245/TALK"    , "narrator": "みやび", "text": "今日はもう寝る"}
    ]
}
