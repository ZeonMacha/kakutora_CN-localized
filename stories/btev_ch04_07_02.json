    "info": {
        "story_id": "24012",
        "cid": "",
        "title": "012 ココロスフィアストーリー【Lv04】",
        "sub_title": "監視＜帰結＞"
    },
    "entry":
    [
        { "location": "210/SCENARIO", "narrator": "", "text": "監視"},
        { "location": "225/TALK"    , "narrator": "みやび", "text": "うわー、\nやーらーれーたー…。"},
        { "location": "226/TALK"    , "narrator": "みやび", "text": "…と、$handle$に\nやられるのも――"},
        { "location": "227/TALK"    , "narrator": "みやび", "text": "慣れてきた感あって\n余裕出てきたな…。"},
        { "location": "228/SEL"     , "narrator": "（選択肢）", "text": "ごめんなさい"},
        { "location": "229/ACT"     , "narrator": "", "text": "ごめんなさい"},
        { "location": "232/TALK"    , "narrator": "みやび", "text": "いや…。"},
        { "location": "234/TALK"    , "narrator": "みやび", "text": "まあ、悪い気せんき、\nえいんやけんど…。"},
        { "location": "235/TALK"    , "narrator": "みやび", "text": "…あんたのおかげで、\nまた一つ――"},
        { "location": "236/TALK"    , "narrator": "みやび", "text": "うちの正直な気持ち\n出さなきゃならなく\nなったか…。"},
        { "location": "237/TALK"    , "narrator": "みやび", "text": "正直、スパイが誰か\n探そうしちゅう\nけんど――"},
        { "location": "238/TALK"    , "narrator": "みやび", "text": "不安で堪らん。"},
        { "location": "239/TALK"    , "narrator": "みやび", "text": "当然やろ？\n仲間の中にスパイが\nおるかもしれんのや。"},
        { "location": "240/TALK"    , "narrator": "みやび", "text": "しかも、それが誰か、\n何人おるのかも\n全て不明…。"},
        { "location": "241/TALK"    , "narrator": "みやび", "text": "…難易度ヤバ過ぎや。\nこれがゲームやったら\nクソゲーやぞ？"},
        { "location": "242/SEL"     , "narrator": "（選択肢）", "text": "$me$が手伝うよ"},
        { "location": "243/ACT"     , "narrator": "", "text": "$me$が手伝うよ"},
        { "location": "245/TALK"    , "narrator": "みやび", "text": "まだ言うてるが？"},
        { "location": "246/TALK"    , "narrator": "みやび", "text": "$handle$は\nそこそこ信用しちょる\nけんど――"},
        { "location": "247/TALK"    , "narrator": "みやび", "text": "頼りがいはない\nっちゅうたやろ？"},
        { "location": "248/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "249/TALK"    , "narrator": "みやび", "text": "いや、まあここでは\n頼りになるか。"},
        { "location": "250/TALK"    , "narrator": "みやび", "text": "まあ、その気持ちは\nありがたく貰うとく\nぞね。"},
        { "location": "252/TALK"    , "narrator": "みやび", "text": "はぁ…まっこと、\nどうしたもんかなぁ？"}
    ]
}
