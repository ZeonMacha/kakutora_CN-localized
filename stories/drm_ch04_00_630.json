    [
        { "location": "179/SCENARIO", "narrator": "", "text": "うたひめごと"},
        { "location": "204/TALK"    , "narrator": "みやび", "text": "$handle$に"},
        { "location": "205/TALK"    , "narrator": "みやび", "text": "歌を歌ってやろう"},
        { "location": "206/TALK"    , "narrator": "みやび", "text": "リクエストはあるか"},
        { "location": "208/SEL"     , "narrator": "", "text": "なんでもいいよ"},
        { "location": "209/SEL"     , "narrator": "", "text": "どうやって歌うつもり？"},
        { "location": "210/SEL"     , "narrator": "", "text": "今作曲するから待って"},
        { "location": "211/ACT"     , "narrator": "", "text": "なんでもいいよ"},
        { "location": "212/TALK"    , "narrator": "みやび", "text": "それは"},
        { "location": "213/TALK"    , "narrator": "みやび", "text": "却って困るな"},
        { "location": "215/TALK"    , "narrator": "みやび", "text": "やはり"},
        { "location": "216/TALK"    , "narrator": "みやび", "text": "やめておこう"},
        { "location": "217/ACT"     , "narrator": "", "text": "どうやって歌うつもり？"},
        { "location": "218/TALK"    , "narrator": "みやび", "text": "いや"},
        { "location": "219/TALK"    , "narrator": "みやび", "text": "普通に"},
        { "location": "220/TALK"    , "narrator": "みやび", "text": "けんど"},
        { "location": "221/TALK"    , "narrator": "みやび", "text": "聞かせられんね"},
        { "location": "222/TALK"    , "narrator": "みやび", "text": "ちゅーことで"},
        { "location": "223/TALK"    , "narrator": "みやび", "text": "やめることにするぞね"},
        { "location": "224/ACT"     , "narrator": "", "text": "今作曲するから待って"},
        { "location": "234/TALK"    , "narrator": "みやび", "text": "お"},
        { "location": "236/TALK"    , "narrator": "みやび", "text": "やる気だな"},
        { "location": "238/SEL"     , "narrator": "", "text": "もちのろん"},
        { "location": "239/SEL"     , "narrator": "", "text": "みやびのキーは？"},
        { "location": "240/SEL"     , "narrator": "", "text": "ショパンの再来だからね"},
        { "location": "241/ACT"     , "narrator": "", "text": "もちのろん"},
        { "location": "242/TALK"    , "narrator": "みやび", "text": "その言い方は"},
        { "location": "243/TALK"    , "narrator": "みやび", "text": "古くないか"},
        { "location": "244/ACT"     , "narrator": "", "text": "みやびのキーは？"},
        { "location": "245/TALK"    , "narrator": "みやび", "text": "普通に"},
        { "location": "246/TALK"    , "narrator": "みやび", "text": "アルト？"},
        { "location": "247/ACT"     , "narrator": "", "text": "ショパンの再来だからね"},
        { "location": "248/TALK"    , "narrator": "みやび", "text": "それでは歌えん"},
        { "location": "249/TALK"    , "narrator": "みやび", "text": "超技巧"},
        { "location": "250/TALK"    , "narrator": "みやび", "text": "以前に"},
        { "location": "251/TALK"    , "narrator": "みやび", "text": "ボーカル曲ではない"},
        { "location": "253/TALK"    , "narrator": "みやび", "text": "童謡とか唱歌とか"},
        { "location": "255/TALK"    , "narrator": "みやび", "text": "そういうのは勘弁"},
        { "location": "256/TALK"    , "narrator": "みやび", "text": "とはいえ"},
        { "location": "257/TALK"    , "narrator": "みやび", "text": "小唄も長唄も無理だ"},
        { "location": "258/TALK"    , "narrator": "みやび", "text": "それ以外で頼む"},
        { "location": "260/SEL"     , "narrator": "", "text": "アニソンっぽいやつ"},
        { "location": "261/SEL"     , "narrator": "", "text": "J-popだから"},
        { "location": "262/SEL"     , "narrator": "", "text": "好きな曲調とかある？"},
        { "location": "263/ACT"     , "narrator": "", "text": "アニソンっぽいやつ"},
        { "location": "264/TALK"    , "narrator": "みやび", "text": "狭そうで"},
        { "location": "265/TALK"    , "narrator": "みやび", "text": "実は大変な大海だのう"},
        { "location": "266/ACT"     , "narrator": "", "text": "J-popだから"},
        { "location": "267/TALK"    , "narrator": "みやび", "text": "所属事務所はどこだ"},
        { "location": "268/TALK"    , "narrator": "みやび", "text": "まずはそこからじゃの"},
        { "location": "269/ACT"     , "narrator": "", "text": "好きな曲調とかある？"},
        { "location": "270/TALK"    , "narrator": "みやび", "text": "あるような"},
        { "location": "271/TALK"    , "narrator": "みやび", "text": "ないような"},
        { "location": "273/TALK"    , "narrator": "みやび", "text": "それにしても"},
        { "location": "275/TALK"    , "narrator": "みやび", "text": "作曲は$handle$がするとして"},
        { "location": "276/TALK"    , "narrator": "みやび", "text": "作詞はどうするつもりぞね"},
        { "location": "278/SEL"     , "narrator": "", "text": "$me$への愛をみやびが綴る"},
        { "location": "279/ACT"     , "narrator": "", "text": "$me$への愛をみやびが綴る"},
        { "location": "280/TALK"    , "narrator": "みやび", "text": "な"},
        { "location": "283/SEL"     , "narrator": "", "text": "それが$me$のリクエスト"},
        { "location": "284/ACT"     , "narrator": "", "text": "それが$me$のリクエスト"},
        { "location": "285/TALK"    , "narrator": "みやび", "text": "そうきたか"},
        { "location": "288/SEL"     , "narrator": "", "text": "ダメかな？"},
        { "location": "289/SEL"     , "narrator": "", "text": "いいでしょ？"},
        { "location": "290/SEL"     , "narrator": "", "text": "楽しみにしてる！"},
        { "location": "291/ACT"     , "narrator": "", "text": "ダメかな？"},
        { "location": "292/TALK"    , "narrator": "みやび", "text": "う"},
        { "location": "293/ACT"     , "narrator": "", "text": "いいでしょ？"},
        { "location": "294/TALK"    , "narrator": "みやび", "text": "え"},
        { "location": "295/ACT"     , "narrator": "", "text": "楽しみにしてる！"},
        { "location": "296/TALK"    , "narrator": "みやび", "text": "なんと"},
        { "location": "298/TALK"    , "narrator": "みやび", "text": "いやその前にだな"},
        { "location": "299/TALK"    , "narrator": "みやび", "text": "まずは曲がないとだな"},
        { "location": "300/TALK"    , "narrator": "みやび", "text": "それにうちは"},
        { "location": "303/TALK"    , "narrator": "みやび", "text": "いや"},
        { "location": "305/TALK"    , "narrator": "みやび", "text": "そういうつもりも"},
        { "location": "306/TALK"    , "narrator": "みやび", "text": "少しはあった"},
        { "location": "307/TALK"    , "narrator": "みやび", "text": "どっちにしても"},
        { "location": "308/TALK"    , "narrator": "みやび", "text": "まず曲が先だ"},
        { "location": "309/TALK"    , "narrator": "みやび", "text": "待ちゆうき"},
        { "location": "310/TALK"    , "narrator": "みやび", "text": "さっさと作れ"},
        { "location": "311/TALK"    , "narrator": "みやび", "text": "$handle$め"},
        { "location": "230/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>1000pt.</b></color></size>\nアップしました！"}
