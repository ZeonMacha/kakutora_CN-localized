        { "location": "178/SCENARIO", "narrator": "", "text": "024_持っていないわけじゃなく"},
        { "location": "203/TALK"    , "narrator": "アーヤ", "text": "やっぱり"},
        { "location": "204/TALK"    , "narrator": "アーヤ", "text": "アキバに行くべきかしら"},
        { "location": "205/TALK"    , "narrator": "アーヤ", "text": "パソコンとか買うのは"},
        { "location": "207/SEL"     , "narrator": "", "text": "ネット最強"},
        { "location": "208/SEL"     , "narrator": "", "text": "いや、それ幻想だから"},
        { "location": "209/SEL"     , "narrator": "", "text": "どういうのが欲しいの？"},
        { "location": "210/ACT"     , "narrator": "", "text": "ネット最強"},
        { "location": "211/TALK"    , "narrator": "アーヤ", "text": "あれ（￣ー￣？）"},
        { "location": "212/TALK"    , "narrator": "アーヤ", "text": "そういうものなの"},
        { "location": "213/ACT"     , "narrator": "", "text": "いや、それ幻想だから"},
        { "location": "215/TALK"    , "narrator": "アーヤ", "text": "え"},
        { "location": "217/TALK"    , "narrator": "アーヤ", "text": "そうだったの（￣ー￣？）"},
        { "location": "218/ACT"     , "narrator": "", "text": "どういうのが欲しいの？"},
        { "location": "222/TALK"    , "narrator": "アーヤ", "text": "普通のでいいのよ(´o｀；"},
        { "location": "223/SEL"     , "narrator": "", "text": "普通て"},
        { "location": "224/SEL"     , "narrator": "", "text": "もう少しスペック等を言って"},
        { "location": "225/SEL"     , "narrator": "", "text": "したいことは何？"},
        { "location": "226/ACT"     , "narrator": "", "text": "普通て"},
        { "location": "227/TALK"    , "narrator": "アーヤ", "text": "普通は普通よ(;^_^A"},
        { "location": "228/TALK"    , "narrator": "アーヤ", "text": "なんでみんなそれを"},
        { "location": "230/TALK"    , "narrator": "アーヤ", "text": "わかってくれないのかしら(；´Д｀)"},
        { "location": "231/ACT"     , "narrator": "", "text": "もう少しスペック等を言って"},
        { "location": "232/TALK"    , "narrator": "アーヤ", "text": "スペックって"},
        { "location": "235/TALK"    , "narrator": "アーヤ", "text": "とにかく普通に使えるやつだったら大丈夫なの"},
        { "location": "236/TALK"    , "narrator": "アーヤ", "text": "わかってよ"},
        { "location": "237/ACT"     , "narrator": "", "text": "したいことは何？"},
        { "location": "239/TALK"    , "narrator": "アーヤ", "text": "えーとね"},
        { "location": "240/TALK"    , "narrator": "アーヤ", "text": "レポートができて"},
        { "location": "241/TALK"    , "narrator": "アーヤ", "text": "メールができて"},
        { "location": "242/TALK"    , "narrator": "アーヤ", "text": "インターネットができるやつよ"},
        { "location": "244/SEL"     , "narrator": "", "text": "あ、はい"},
        { "location": "245/SEL"     , "narrator": "", "text": "みやびに選んでもらえば"},
        { "location": "246/ACT"     , "narrator": "", "text": "あ、はい"},
        { "location": "247/TALK"    , "narrator": "アーヤ", "text": "ちゃんとわかってるの？"},
        { "location": "248/TALK"    , "narrator": "アーヤ", "text": "なんか疑わしいわね"},
        { "location": "249/ACT"     , "narrator": "", "text": "みやびに選んでもらえば"},
        { "location": "250/TALK"    , "narrator": "アーヤ", "text": "確かにそれが確実ね"},
        { "location": "252/TALK"    , "narrator": "アーヤ", "text": "そうするわ"}
    ]
}
