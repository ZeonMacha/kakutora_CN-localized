        "title": "005 メインストーリー",
        "sub_title": "銃撃発言＜後編＞"
    },
    "entry":
    [
        { "location": "1011/TALK"  , "narrator": "ガブリエラ", "text": "はぁ…やめやめ。"},
        { "location": "1012/TALK"  , "narrator": "ガブリエラ", "text": "気持ち切り替えて\nいかなきゃ、\nイライラするだけよ。"},
        { "location": "1013/TALK"  , "narrator": "ガブリエラ", "text": "…うん、そうよ。\n落ち込んでても仕方ない！"},
        { "location": "1015/TALK"  , "narrator": "ガブリエラ", "text": "あ～…そう思ったら、\nなんかすっごい\nスッキリしたかも！"},
        { "location": "1016/SEL"   , "narrator": "", "text": "急にどうしたの？"},
        { "location": "1017/ACT"   , "narrator": "", "text": "急にどうしたの？"},
        { "location": "1029/TALK"  , "narrator": "ガブリエラ", "text": "別に何でもないわ"},
        { "location": "1030/TALK"  , "narrator": "ガブリエラ", "text": "怒ったからかしら？"},
        { "location": "1031/TALK"  , "narrator": "ガブリエラ", "text": "とってもスッキリした気持ちで気分がいいの"},
        { "location": "1033/SEL"   , "narrator": "", "text": "メンタル強いな！？"},
        { "location": "1034/SEL"   , "narrator": "", "text": "お、おう"},
        { "location": "1035/SEL"   , "narrator": "", "text": "機嫌が直って何よりだよ"},
        { "location": "1036/SEL"   , "narrator": "", "text": "ならいいんだけど…"},
        { "location": "1037/ACT"   , "narrator": "", "text": "メンタル強いな！？"},
        { "location": "1038/ACT"   , "narrator": "", "text": "お、おう"},
        { "location": "1039/ACT"   , "narrator": "", "text": "機嫌が直って何よりだよ"},
        { "location": "1040/ACT"   , "narrator": "", "text": "ならいいんだけど…"},
        { "location": "1048/TALK"  , "narrator": "ガブリエラ", "text": "…よし！\n花火が始まるまで、\nまだ時間あるわね。"},
        { "location": "1049/TALK"  , "narrator": "ガブリエラ", "text": "せっかくだし、屋台でも\n見て回ろうかしら！"},
        { "location": "1050/SEL"   , "narrator": "", "text": "話の続きを聞いてもいい？"},
        { "location": "1051/ACT"   , "narrator": "", "text": "話の続きを聞いてもいい？"},
        { "location": "1069/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "1086/TALK"  , "narrator": "ガブリエラ", "text": "ふぅ…ちょっと\n遊び過ぎたかしら？"},
        { "location": "1087/TALK"  , "narrator": "ガブリエラ", "text": "でもまあ、たまには\nいいわよね。"},
        { "location": "1088/TALK"  , "narrator": "ガブリエラ", "text": "それに、今は\nプライベートの\n時間なんだし。"},
        { "location": "1089/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "1091/TALK"  , "narrator": "ガブリエラ", "text": "あっ。"},
        { "location": "1096/TALK"  , "narrator": "ガブリエラ", "text": "…綺麗。"},
        { "location": "1097/TALK"  , "narrator": "ガブリエラ", "text": "さっさと帰らないで、\n夜まで残って、\n正解だったわ。"},
        { "location": "1099/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "1100/SEL"   , "narrator": "", "text": "さっきの話、嘘だよね？"},
        { "location": "1101/SEL"   , "narrator": "", "text": "ごめんね、言いたくないこと聞いて"},
        { "location": "1102/SEL"   , "narrator": "", "text": "…冗談だよね？"},
        { "location": "1103/ACT"   , "narrator": "", "text": "さっきの話、嘘だよね？"},
        { "location": "1114/ACT"   , "narrator": "", "text": "ごめんね、言いたくないこと聞いて"},
        { "location": "1124/ACT"   , "narrator": "", "text": "…冗談だよね？"},
        { "location": "1135/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "1136/TALK"  , "narrator": "ガブリエラ", "text": "ねえ、$marzanna$。"},
        { "location": "1137/TALK"  , "narrator": "ガブリエラ", "text": "あんた、どうせ\nあたしの声が\n聞こえてるんでしょ？"},
        { "location": "1138/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "1139/TALK"  , "narrator": "ガブリエラ", "text": "昼間話したこと、\n覚えてる？"},
        { "location": "1140/TALK"  , "narrator": "ガブリエラ", "text": "あれ、日本に来てからは、\nまだ誰にも話したこと\nないの。"},
        { "location": "1141/TALK"  , "narrator": "ガブリエラ", "text": "…まほは多分、\n知ってることだと\n思うけど。"},
        { "location": "1142/TALK"  , "narrator": "ガブリエラ", "text": "他のみんなには…、\nアーヤにも\n話したことがないわ。"},
        { "location": "1143/TALK"  , "narrator": "ガブリエラ", "text": "つまり、あんたは\nあたしの秘密を知る、\n数少ない一人になったの。"},
        { "location": "1145/TALK"  , "narrator": "ガブリエラ", "text": "だから、その話を\n他人に漏らすのは禁止。"},
        { "location": "1146/TALK"  , "narrator": "ガブリエラ", "text": "もちろん、あたしに対して\nこれ以上聞くのも禁止よ。"},
        { "location": "1148/TALK"  , "narrator": "ガブリエラ", "text": "特に…この話を\n誰かに言ったら"},
        { "location": "1151/TALK"  , "narrator": "ガブリエラ", "text": "許さないから。"},
        { "location": "1152/TALK"  , "narrator": "ガブリエラ", "text": "絶対に\n許さないから。"},
        { "location": "1158/TALK"  , "narrator": "ガブリエラ", "text": "…本当、\n綺麗な花火ね…。"},
        { "location": "1172/DIALOG", "narrator": "Dialog_chapter_ch03", "text": "【19 三戸浜からの手紙】"}
    ]
}
