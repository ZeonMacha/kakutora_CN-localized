{
    "dir": "chap15/daydra/dd_ch03_15_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "15352",
        "cid": "gabriella",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "プチホームシック"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "プチホームシック"},
        { "location": "20/TALK"   , "narrator": "ガブリエラ", "text": "はぁ…。"},
        { "location": "22/TALK"   , "narrator": "つばめ", "text": "…ガブちゃん、さっきから\nどうかしたんですか？"},
        { "location": "24/TALK"   , "narrator": "ガブリエラ", "text": "何が？"},
        { "location": "26/TALK"   , "narrator": "雛", "text": "ため息だよ、ため息。\nさっきからずーっとだよ？"},
        { "location": "27/TALK"   , "narrator": "繭", "text": "気付いてなかったの？"},
        { "location": "30/TALK"   , "narrator": "ガブリエラ", "text": "…気付かなかったわ。\n悪かったわね。"},
        { "location": "31/TALK"   , "narrator": "つばめ", "text": "…何かあったんですか？"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "…まあ、心配かけた\nみたいだから話すけど――"},
        { "location": "34/TALK"   , "narrator": "ガブリエラ", "text": "さっき、地理の授業で\nポーランドの話題が\n出たの。"},
        { "location": "35/TALK"   , "narrator": "雛", "text": "ポーランドって、\nガブリエラちゃんの\n国だよね？"},
        { "location": "36/TALK"   , "narrator": "雛", "text": "ホームシックに\nなっちゃったとか？"},
        { "location": "38/TALK"   , "narrator": "ガブリエラ", "text": "そんなんじゃないわ。"},
        { "location": "41/TALK"   , "narrator": "ガブリエラ", "text": "ただ、ちょっとだけ\n懐かしい気持ちになった\nだけよ…。"},
        { "location": "42/SEL"    , "narrator": "", "text": "まだまだ子供だね"},
        { "location": "43/SEL"    , "narrator": "", "text": "たまには帰りたい？"},
        { "location": "44/SEL"    , "narrator": "", "text": "端末検索：面白画像"},
        { "location": "48/TALK"   , "narrator": "つばめ", "text": "…それ、ホームシック\nなんじゃ…？"},
        { "location": "50/TALK"   , "narrator": "ガブリエラ", "text": "だから、そういうのじゃ\nないんだってば。"},
        { "location": "51/TALK"   , "narrator": "ガブリエラ", "text": "懐かしい名前を聞いて、\n地元のこと、色々と\n思い出しただけよ。"},
        { "location": "52/TALK"   , "narrator": "ガブリエラ", "text": "…今、どうなってるの\nかな、とか。"},
        { "location": "53/ACT"    , "narrator": "", "text": "まだまだ子供だね"},
        { "location": "74/TALK"   , "narrator": "ガブリエラ", "text": "…今日の$marzanna$は、ちょっとトゲがあるわね？"},
        { "location": "75/TALK"   , "narrator": "ガブリエラ", "text": "っていうか、私はまだ中学生よ！"},
        { "location": "88/TALK"   , "narrator": "ガブリエラ", "text": "もう、$marzanna$の\nバカ…。"},
        { "location": "90/TALK"   , "narrator": "つばめ", "text": "…せんぱいって、\n日本に来てからは\nまだ一度も――"},
        { "location": "91/TALK"   , "narrator": "つばめ", "text": "ポーランドに帰って\nないんですか？"},
        { "location": "94/TALK"   , "narrator": "ガブリエラ", "text": "…まあね。\nそう簡単に帰れるような\n立場でもないし。"},
        { "location": "95/TALK"   , "narrator": "つばめ", "text": "一度くらい帰らないと、\n家族が心配するんじゃ…。"},
        { "location": "96/TALK"   , "narrator": "ガブリエラ", "text": "あんたに言われたく\nないわよ。"},
        { "location": "97/TALK"   , "narrator": "ガブリエラ", "text": "新幹線一本で実家に\n帰れるのに、一度も\n帰ったことないくせに。"},
        { "location": "100/TALK"  , "narrator": "つばめ", "text": "うっ…、\nそれを言われると\n何も言えないです…。"},
        { "location": "101/TALK"  , "narrator": "ガブリエラ", "text": "あたしはもう慣れたし、\n親もあたしがいないのに\n慣れてるだろうけど――"},
        { "location": "102/TALK"  , "narrator": "ガブリエラ", "text": "あんたのとこは日が\n浅いんだから、日帰りでも\n帰ってあげなさいよ。"},
        { "location": "105/TALK"  , "narrator": "雛", "text": "あはは、つばめちゃん、\n逆に言われちゃったね。"},
        { "location": "107/TALK"  , "narrator": "つばめ", "text": "うう…でも、お父さんから\nたまには帰るように\n言われてるし――"},
        { "location": "109/TALK"  , "narrator": "つばめ", "text": "そのうち、真幌さんに\n相談してみようかなぁ？"},
        { "location": "110/ACT"   , "narrator": "", "text": "たまには帰りたい？"},
        { "location": "132/TALK"  , "narrator": "ガブリエラ", "text": "そうね…里帰りも悪くないかも"},
        { "location": "133/TALK"  , "narrator": "ガブリエラ", "text": "けど、今はまだ帰りたくないわ"},
        { "location": "144/TALK"  , "narrator": "ガブリエラ", "text": "…まあ、帰りたいとは\n思うけど、今はいいわ。"},
        { "location": "146/TALK"  , "narrator": "ガブリエラ", "text": "別に急がなくたって、\nいずれは帰るつもりだし。"},
        { "location": "148/TALK"  , "narrator": "雛", "text": "えっ…そうなの？"},
        { "location": "150/TALK"  , "narrator": "ガブリエラ", "text": "そりゃそうよ。\nだって、ポーランドは\n生まれ故郷だもの。"},
        { "location": "151/TALK"  , "narrator": "ガブリエラ", "text": "一生離れて暮らすなんて、\nさすがにできないわ"},
        { "location": "154/TALK"  , "narrator": "つばめ", "text": "…それ、嫌です。"},
        { "location": "156/TALK"  , "narrator": "ガブリエラ", "text": "ただでさえ少ない\nトライナリーが、\n更に少なくなるしね。"},
        { "location": "157/TALK"  , "narrator": "つばめ", "text": "そうじゃなくて、\nガブちゃんがいなくなる\nのが嫌なんですよ…。"},
        { "location": "161/TALK"  , "narrator": "ガブリエラ", "text": "は、はぁ！？\n何言いだすのよ！"},
        { "location": "162/TALK"  , "narrator": "雛", "text": "そう思って当然だよ。"},
        { "location": "163/TALK"  , "narrator": "雛", "text": "ガブリエラちゃんが\nいなくなっちゃうの、\nあたしだって嫌だもん。"},
        { "location": "166/TALK"  , "narrator": "ガブリエラ", "text": "ちょ、な、なんなのよ\nあんた達は！？\n気持ち悪いわね…。"},
        { "location": "168/TALK"  , "narrator": "ガブリエラ", "text": "…例えの話だってば。\n別に、今帰るつもりは\nないわよ。"},
        { "location": "169/TALK"  , "narrator": "雛", "text": "でも、いつかは帰っちゃ\nうんでしょ？"},
        { "location": "173/TALK"  , "narrator": "ガブリエラ", "text": "少なくとも、学生の間は\nこっちにいるって。"},
        { "location": "174/TALK"  , "narrator": "繭", "text": "…なら、学生を終えても\nそんな気持ちにならない\nように――"},
        { "location": "175/TALK"  , "narrator": "繭", "text": "もっと、日本の楽しい\nところを教えた方が\n良いかも。"},
        { "location": "178/TALK"  , "narrator": "つばめ", "text": "まゆちん、\nナイスアイデアです！"},
        { "location": "181/TALK"  , "narrator": "雛", "text": "ガブリエラちゃんの\n知らない楽しいことを\nいっぱい教えて――"},
        { "location": "182/TALK"  , "narrator": "雛", "text": "日本に永住したい、って\n気持ちにさせちゃおー！"},
        { "location": "183/TALK"  , "narrator": "ガブリエラ", "text": "勝手に決めるなー！！"},
        { "location": "187/TALK"  , "narrator": "ガブリエラ", "text": "…まあ、嫌な気分じゃ\nないけど…。"},
        { "location": "188/ACT"   , "narrator": "", "text": "端末検索：面白画像"},
        { "location": "195/TALK"  , "narrator": "ガブリエラ", "text": "あら、何かしら…"},
        { "location": "197/TALK"  , "narrator": "ガブリエラ", "text": "ぶっ！？"},
        { "location": "200/TALK"  , "narrator": "つばめ", "text": "ど、どうしたんですか？"},
        { "location": "203/TALK"  , "narrator": "ガブリエラ", "text": "あはっ、あはははは！\nこ、これ…何これぇ！？"},
        { "location": "205/TALK"  , "narrator": "雛", "text": "えっ、どれどれ？"},
        { "location": "208/TALK"  , "narrator": "雛", "text": "ぶふっ！！\nひ、ひどい、これひどい！\n面白いけど超ひどい！！"},
        { "location": "209/TALK"  , "narrator": "つばめ", "text": "これって、もしかして\nわたし達のコスプレ\nですか！？"},
        { "location": "213/TALK"  , "narrator": "繭", "text": "そ、そうみたい…。\nそれも、ちょ…超、\n低クオリティの…。"},
        { "location": "214/TALK"  , "narrator": "繭", "text": "く、くくっ…\nま、待って、見せないで。\nお腹が、お腹が…！！"},
        { "location": "217/TALK"  , "narrator": "雛", "text": "まゆちん、\nツボ入ったみたい。"},
        { "location": "218/TALK"  , "narrator": "ガブリエラ", "text": "で、でもこれ、\nある意味凄いわ。"},
        { "location": "219/TALK"  , "narrator": "ガブリエラ", "text": "普通のオッサンが、\n特殊攻撃隊、って\n書いてある――"},
        { "location": "220/TALK"  , "narrator": "ガブリエラ", "text": "ただの段ボール被った\nだけなんて…。"},
        { "location": "224/TALK"  , "narrator": "雛", "text": "特殊攻撃隊の情報って、\n一般の人達には\n極秘扱いだからね。"},
        { "location": "227/TALK"  , "narrator": "繭", "text": "でも、これ…これ、ぶっ！\nだ、ダメ…みせ…\n見せないで！！"},
        { "location": "228/TALK"  , "narrator": "雛", "text": "っていうか、どこでそんな\n画像拾ってきたの？"},
        { "location": "232/TALK"  , "narrator": "ガブリエラ", "text": "えっと…\nどこかの画像掲示板？\nよく覚えてないわ。"},
        { "location": "235/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "241/TALK"  , "narrator": "ガブリエラ", "text": "もう、$marzanna$！！"},
        { "location": "242/TALK"  , "narrator": "ガブリエラ", "text": "いくらなんでも、いきなりあの画像は破壊力あり過ぎよ"},
        { "location": "243/TALK"  , "narrator": "ガブリエラ", "text": "繭なんて、まだうずくまって震えてるし"},
        { "location": "244/SEL"   , "narrator": "", "text": "元気出してほしかった"},
        { "location": "245/ACT"   , "narrator": "", "text": "元気出してほしかった"},
        { "location": "247/TALK"  , "narrator": "ガブリエラ", "text": "そうだったの？"},
        { "location": "248/TALK"  , "narrator": "ガブリエラ", "text": "心配かけてごめんね"},
        { "location": "249/TALK"  , "narrator": "ガブリエラ", "text": "でも、おもいっきり笑ったから元気出たわ"},
        { "location": "18/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>7月11日　10:04 AM</color>\nとある平日の休み時間、附属学園高等部廊下にて。"}
    ]
}
