    "entry":
    [
        { "location": "1069/SEL"   , "narrator": "", "text": "千羽鶴はウソをついた、契約違反だ"},
        { "location": "1070/ACT"   , "narrator": "", "text": "千羽鶴はウソをついた、契約違反だ"},
        { "location": "1072/TALK"  , "narrator": "神楽", "text": "契約"},
        { "location": "1075/TALK"  , "narrator": "神楽", "text": "そうだ"},
        { "location": "1095/TALK"  , "narrator": "神楽", "text": "…すみません。\nどちら様ですか？"},
        { "location": "1096/TALK"  , "narrator": "千羽鶴", "text": "私は…、この世界で\nフェノメノンを対処する\n組織…。"},
        { "location": "1097/TALK"  , "narrator": "千羽鶴", "text": "情報管理庁に所属する\nエージェント。"},
        { "location": "1098/TALK"  , "narrator": "神楽", "text": "管理庁…エージェント？"},
        { "location": "1124/TALK"  , "narrator": "神楽", "text": "皇千羽鶴は契約に違反した"},
        { "location": "1125/TALK"  , "narrator": "神楽", "text": "けど"},
        { "location": "1126/TALK"  , "narrator": "神楽", "text": "だからって今の私にはどうすることもできません、、、"},
        { "location": "1128/SEL"   , "narrator": "", "text": "$me$に考えがあるから安心して"},
        { "location": "1129/ACT"   , "narrator": "", "text": "$me$に考えがあるから安心して"},
        { "location": "1131/TALK"  , "narrator": "神楽", "text": "考え？"},
        { "location": "1132/TALK"  , "narrator": "神楽", "text": "なにをするつもりですか？"},
        { "location": "1134/SEL"   , "narrator": "", "text": "神楽はつばめを壊さなくていいんだよ"},
        { "location": "1135/ACT"   , "narrator": "", "text": "神楽はつばめを壊さなくていいんだよ"},
        { "location": "1137/TALK"  , "narrator": "神楽", "text": "でも"},
        { "location": "1138/TALK"  , "narrator": "神楽", "text": "壊すって契約だから"},
        { "location": "1141/SEL"   , "narrator": "", "text": "先に契約を破ったのは千羽鶴だ"},
        { "location": "1142/ACT"   , "narrator": "", "text": "先に契約を破ったのは千羽鶴だ"},
        { "location": "1144/TALK"  , "narrator": "神楽", "text": "そうですけど"},
        { "location": "1147/TALK"  , "narrator": "神楽", "text": "でも"},
        { "location": "1151/SEL"   , "narrator": "", "text": "例えフェノメノンを発症しても大丈夫"},
        { "location": "1152/ACT"   , "narrator": "", "text": "例えフェノメノンを発症しても大丈夫"},
        { "location": "1155/TALK"  , "narrator": "神楽", "text": "あなたは"},
        { "location": "1156/TALK"  , "narrator": "神楽", "text": "もしかして"},
        { "location": "1157/TALK"  , "narrator": "神楽", "text": "こうなると見越してたんですか？"},
        { "location": "1158/TALK"  , "narrator": "神楽", "text": "だから任せて、と"},
        { "location": "1160/SEL"   , "narrator": "", "text": "まあね"},
        { "location": "1161/ACT"   , "narrator": "", "text": "まあね"},
        { "location": "1163/TALK"  , "narrator": "神楽", "text": "やっぱり"},
        { "location": "1165/TALK"  , "narrator": "神楽", "text": "どうしてですか？"},
        { "location": "1166/TALK"  , "narrator": "神楽", "text": "どうしてあなたは"},
        { "location": "1167/TALK"  , "narrator": "神楽", "text": "そんなことまでわかるんですか？"},
        { "location": "1169/SEL"   , "narrator": "", "text": "$me$は未来から来た時空管理警察フューチャーマンだからさ"},
        { "location": "1170/SEL"   , "narrator": "", "text": "今は教えられない"},
        { "location": "1171/ACT"   , "narrator": "", "text": "$me$は未来から来た時空管理警察フューチャーマンだからさ"},
        { "location": "1173/TALK"  , "narrator": "神楽", "text": "うわダサｗｗｗｗｗｗｗｗｗｗ"},
        { "location": "1175/TALK"  , "narrator": "神楽", "text": "フューチャーマンさんでしたかｗｗｗｗｗｗｗｗｗｗ"},
        { "location": "1176/TALK"  , "narrator": "神楽", "text": "でもなるほどなっとく"},
        { "location": "1177/TALK"  , "narrator": "神楽", "text": "時空管理警察の方なら"},
        { "location": "1178/TALK"  , "narrator": "神楽", "text": "知ってて当然ですね"},
        { "location": "1179/TALK"  , "narrator": "神楽", "text": "どんな組織かは知らないけど"},
        { "location": "1180/TALK"  , "narrator": "神楽", "text": "それじゃあ"},
        { "location": "1181/TALK"  , "narrator": "神楽", "text": "今回の件が解決した後には"},
        { "location": "1182/TALK"  , "narrator": "神楽", "text": "ぴょんこ先生がそのネタで超ダサい同人誌描いてあげますね！"},
        { "location": "1183/TALK"  , "narrator": "神楽", "text": "当然"},
        { "location": "1185/TALK"  , "narrator": "神楽", "text": "あなたの実名入りでｗｗｗｗｗｗｗｗ"},
        { "location": "1186/ACT"   , "narrator": "", "text": "今は教えられない"},
        { "location": "1187/TALK"  , "narrator": "神楽", "text": "ですよねー"},
        { "location": "1188/TALK"  , "narrator": "神楽", "text": "じゃあ"},
        { "location": "1189/TALK"  , "narrator": "神楽", "text": "無事終わったら"},
        { "location": "1190/TALK"  , "narrator": "神楽", "text": "その手品のタネ教えてくださいね"},
        { "location": "1192/SEL"   , "narrator": "", "text": "全部教えるよ、無事終えたらね"},
        { "location": "1193/ACT"   , "narrator": "", "text": "全部教えるよ、無事終えたらね"},
        { "location": "1196/TALK"  , "narrator": "神楽", "text": "ちょ"},
        { "location": "1198/TALK"  , "narrator": "神楽", "text": "そこまでいくと死亡フラグっぽいからｗｗｗｗｗｗ"},
        { "location": "1201/TALK"  , "narrator": "神楽", "text": "なんだか"},
        { "location": "1202/TALK"  , "narrator": "神楽", "text": "少し気がラクになりました"},
        { "location": "1203/TALK"  , "narrator": "神楽", "text": "あなたのおかげですね"},
        { "location": "1204/SEL"   , "narrator": "", "text": "神楽"},
        { "location": "1205/TALK"  , "narrator": "神楽", "text": "もう少しだけ"},
        { "location": "1206/TALK"  , "narrator": "神楽", "text": "頑張れるかもしれないです"},
        { "location": "1211/TALK"  , "narrator": "神楽", "text": "ありがとう"},
        { "location": "1225/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1226/TALK"  , "narrator": "神楽", "text": "でも、これで全てが\n解決したわけじゃ\nないのよね…。"},
        { "location": "1227/TALK"  , "narrator": "神楽", "text": "確かに、千羽鶴が\nウソをついていれば、\nそれは契約違反…。"},
        { "location": "1228/TALK"  , "narrator": "神楽", "text": "私がつばめさんを\n壊す契約は、\nなかったものとなる。"},
        { "location": "1230/TALK"  , "narrator": "神楽", "text": "けど、つばめさんを\n壊さなかったと\nしたら…。"},
        { "location": "1231/TALK"  , "narrator": "神楽", "text": "ママと音羽は…。\n誰が助けてくれる？"},
        { "location": "1232/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1233/TALK"  , "narrator": "神楽", "text": "結局…千羽鶴と\n彼ら以外に…。"},
        { "location": "1234/TALK"  , "narrator": "神楽", "text": "ママと音羽を\n助けられる人は\nいないんだし…。"},
        { "location": "1235/TALK"  , "narrator": "神楽", "text": "…あれ？"},
        { "location": "1236/TALK"  , "narrator": "神楽", "text": "でも、千羽鶴が\nつばめさんのセルフ\nクランということは。"},
        { "location": "1237/TALK"  , "narrator": "神楽", "text": "音羽を壊したのは、\nつばめさんなのに\n変わりないんじゃ…。"},
        { "location": "1238/TALK"  , "narrator": "神楽", "text": "今は別人でも、\nもし二人が元の一人に\n戻ったら…。"},
        { "location": "1239/TALK"  , "narrator": "神楽", "text": "――ッ！？\nそうか、わかった！"},
        { "location": "1240/TALK"  , "narrator": "神楽", "text": "彼らが言っていた\nつばめさんは、\n恐らく――"},
        { "location": "1241/TALK"  , "narrator": "神楽", "text": "千羽鶴が分離する前の\nつばめさんのこと！"},
        { "location": "1242/TALK"  , "narrator": "神楽", "text": "もしそうなら、\nもしこの世界が\nなくなったら…。"},
        { "location": "1243/TALK"  , "narrator": "神楽", "text": "その時は、\nつばめさんは――"},
        { "location": "1244/SEL"   , "narrator": "", "text": "神楽、落ち着いて！"},
        { "location": "1245/ACT"   , "narrator": "", "text": "神楽、落ち着いて！"},
        { "location": "1249/TALK"  , "narrator": "神楽", "text": "…$handlek$？\n言い忘れたことでも\nあったのかしら？"},
        { "location": "1252/TALK"  , "narrator": "つばめ", "text": "…神楽ちゃん"},
        { "location": "1255/TALK"  , "narrator": "神楽", "text": "……え？"},
        { "location": "1257/ACT"   , "narrator": "", "text": "神楽"},
        { "location": "1258/TALK"  , "narrator": "神楽", "text": "はい？"},
        { "location": "1260/SEL"   , "narrator": "", "text": "神楽のこと、いつも見守ってるから"},
        { "location": "1261/ACT"   , "narrator": "", "text": "神楽のこと、いつも見守ってるから"},
        { "location": "1263/TALK"  , "narrator": "神楽", "text": "通報しましたっ！"},
        { "location": "1264/TALK"  , "narrator": "神楽", "text": "ストーカーですねッｗｗｗｗｗ"},
        { "location": "1266/SEL"   , "narrator": "", "text": "絶対に幸せにするから"},
        { "location": "1267/ACT"   , "narrator": "", "text": "絶対に幸せにするから"},
        { "location": "1269/TALK"  , "narrator": "神楽", "text": "なんですかもー"},
        { "location": "1270/TALK"  , "narrator": "神楽", "text": "それじゃプロポーズみたいですよー？"},
        { "location": "1271/TALK"  , "narrator": "神楽", "text": "空気嫁ー"},
        { "location": "1273/SEL"   , "narrator": "", "text": "頑張ってね"},
        { "location": "1274/ACT"   , "narrator": "", "text": "頑張ってね"},
        { "location": "1301/TALK"  , "narrator": "神楽", "text": "どうして！？"},
        { "location": "1302/TALK"  , "narrator": "千羽鶴", "text": "なにが？"},
        { "location": "1303/TALK"  , "narrator": "神楽", "text": "とぼけないで！"},
        { "location": "1304/TALK"  , "narrator": "神楽", "text": "海で、フェノメノンを\n壊した理由を\n聞いてるの！"},
        { "location": "1305/TALK"  , "narrator": "神楽", "text": "どうしてあんなこと\nしたの！？"},
        { "location": "1306/TALK"  , "narrator": "千羽鶴", "text": "…あの場で四人と\n戦っていたら…、\n貴方は勝っていた。"},
        { "location": "1307/TALK"  , "narrator": "千羽鶴", "text": "それに、あの時の\nクランの偏在の仕方を\n考えるに…。"},
        { "location": "1308/TALK"  , "narrator": "千羽鶴", "text": "恐らく、彼女たちは\n五体満足では\nいられなかったはず。"},
        { "location": "1309/TALK"  , "narrator": "千羽鶴", "text": "…そうなると、\n私自身の\n都合にも悪い。"},
        { "location": "1310/TALK"  , "narrator": "千羽鶴", "text": "だからフェノメノンを\n破壊し、\n貴方を隔離した。"},
        { "location": "1311/TALK"  , "narrator": "神楽", "text": "…でも、私を隔離する\n必要なんて――"},
        { "location": "1312/TALK"  , "narrator": "千羽鶴", "text": "必要はあった。"},
        { "location": "1313/TALK"  , "narrator": "千羽鶴", "text": "あれだけの状況を\n引き起こして\nおきながら…。"},
        { "location": "1314/TALK"  , "narrator": "千羽鶴", "text": "あの場に貴方を\n残していったら、\nどうなっていたか…。"},
        { "location": "1315/TALK"  , "narrator": "千羽鶴", "text": "彼女たちは、\n貴方を罰したんじゃ\nないかしら？"},
        { "location": "1316/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1318/TALK"  , "narrator": "千羽鶴", "text": "よくて糾弾。\n悪くて、リンチされる\n可能性もあったはず。"},
        { "location": "1319/TALK"  , "narrator": "神楽", "text": "…わかってる。\nそんなの…。"},
        { "location": "1320/TALK"  , "narrator": "千羽鶴", "text": "でも、そうなれば\n貴方は再度発症する\n可能性もあった。"},
        { "location": "1321/TALK"  , "narrator": "千羽鶴", "text": "…私としては、\n生きてもらわなければ\nならない。"},
        { "location": "1322/TALK"  , "narrator": "千羽鶴", "text": "彼女たちにも、\n貴方にも…。"},
        { "location": "1323/TALK"  , "narrator": "千羽鶴", "text": "…いずれにせよ、\nフェノメノン中断の\n理由と…。"},
        { "location": "1324/TALK"  , "narrator": "千羽鶴", "text": "共通するということ。\n納得できたかしら？"},
        { "location": "1325/TALK"  , "narrator": "神楽", "text": "…わかりました。"},
        { "location": "1326/TALK"  , "narrator": "千羽鶴", "text": "そう…、それじゃあ、\n今度は私の番。"},
        { "location": "1327/TALK"  , "narrator": "千羽鶴", "text": "少なくとも私は、\n十分な時間を\n与えたうえで…。"},
        { "location": "1328/TALK"  , "narrator": "千羽鶴", "text": "フェノメノン\nアラートを発令した。"},
        { "location": "1329/TALK"  , "narrator": "千羽鶴", "text": "なのに、貴方は\n逢瀬つばめのことを\n破壊できなかった。"},
        { "location": "1330/TALK"  , "narrator": "千羽鶴", "text": "…どうして？\nいったい、\n何をしていたの？"},
        { "location": "1331/TALK"  , "narrator": "神楽", "text": "そ、それは…。"},
        { "location": "1332/TALK"  , "narrator": "千羽鶴", "text": "…まだ迷ってる？"},
        { "location": "1333/TALK"  , "narrator": "千羽鶴", "text": "言ったはず。\n逢瀬つばめを破壊する\nコトに関して…。"},
        { "location": "1334/TALK"  , "narrator": "千羽鶴", "text": "貴方にデメリットは、\n一切無い。"},
        { "location": "1335/TALK"  , "narrator": "千羽鶴", "text": "そして、逢瀬つばめに\n対して抱いている\n好意は。"},
        { "location": "1336/TALK"  , "narrator": "千羽鶴", "text": "現実ではない、\n作られた\nニセモノだと…。"},
        { "location": "1337/TALK"  , "narrator": "神楽", "text": "違う！"},
        { "location": "1338/TALK"  , "narrator": "神楽", "text": "あなたに言われて、\nずっと考えたわ。"},
        { "location": "1339/TALK"  , "narrator": "神楽", "text": "何度も頭を悩ませて、\n苦しみながら考えて、\n答えを出したの。"},
        { "location": "1340/TALK"  , "narrator": "神楽", "text": "例え今生きている\nつばめさんが\nニセモノだとしても。"},
        { "location": "1341/TALK"  , "narrator": "神楽", "text": "そのつばめさんと\n一緒に作ってきた\n思い出は、本物…。"},
        { "location": "1342/TALK"  , "narrator": "神楽", "text": "だからそれは、\n私の中で残る…。"},
        { "location": "1344/TALK"  , "narrator": "神楽", "text": "私が死ぬまで、一生、\n本物として残る…。"},
        { "location": "1345/TALK"  , "narrator": "神楽", "text": "私の、大切な\n思い出として…。"},
        { "location": "1346/TALK"  , "narrator": "千羽鶴", "text": "…………。"},
        { "location": "1348/TALK"  , "narrator": "神楽", "text": "わかってくれますか？"},
        { "location": "1349/TALK"  , "narrator": "千羽鶴", "text": "…理解不能。"},
        { "location": "1350/TALK"  , "narrator": "千羽鶴", "text": "貴方はもう少し、\n頭のいい子だと\n思っていたんだけど。"},
        { "location": "1351/TALK"  , "narrator": "千羽鶴", "text": "…まあ、いい。"},
        { "location": "1352/TALK"  , "narrator": "千羽鶴", "text": "少なくとも、貴方が\n契約違反をしたことに\n変わりはない。"},
        { "location": "1353/TALK"  , "narrator": "神楽", "text": "ふざけないで！！"},
        { "location": "1354/TALK"  , "narrator": "神楽", "text": "勝手にフェノメノンを\n破壊しておいて、\n契約違反ですって！？"},
        { "location": "1355/TALK"  , "narrator": "千羽鶴", "text": "認めないつもり？"},
        { "location": "1356/TALK"  , "narrator": "神楽", "text": "当然よ！！"},
        { "location": "1357/TALK"  , "narrator": "千羽鶴", "text": "…では聞くけど、\nあのまま一時間\n待っていたら…。"},
        { "location": "1358/TALK"  , "narrator": "千羽鶴", "text": "貴方は、逢瀬つばめを\n破壊した？"},
        { "location": "1359/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1360/TALK"  , "narrator": "千羽鶴", "text": "例えニセモノでも、\n貴方にとっては\n本物の逢瀬つばめを。"},
        { "location": "1361/TALK"  , "narrator": "千羽鶴", "text": "貴方は、破壊してたと\n断言できる？"},
        { "location": "1362/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1364/SEL"   , "narrator": "", "text": "契約違反じゃない"},
        { "location": "1365/ACT"   , "narrator": "", "text": "契約違反じゃない"},
        { "location": "1385/TALK"  , "narrator": "神楽", "text": "それは前にも聞きましたけど"},
        { "location": "1386/TALK"  , "narrator": "神楽", "text": "でも、どうすれば"},
        { "location": "1388/SEL"   , "narrator": "", "text": "$me$を信じて任せて！"},
        { "location": "1389/ACT"   , "narrator": "", "text": "$me$を信じて任せて！"},
        { "location": "1391/SEL"   , "narrator": "", "text": "千羽鶴は自分が管理庁長官ではなくエージェントであると嘘をついていた"},
        { "location": "1392/ACT"   , "narrator": "", "text": "千羽鶴は自分が管理庁長官ではなくエージェントであると嘘をついていた"},
        { "location": "1394/TALK"  , "narrator": "神楽", "text": "そうですね"},
        { "location": "1397/SEL"   , "narrator": "", "text": "契約した当日から既に、違反していたってことだ"},
        { "location": "1398/ACT"   , "narrator": "", "text": "契約した当日から既に、違反していたってことだ"},
        { "location": "1400/TALK"  , "narrator": "神楽", "text": "それはわかってる"},
        { "location": "1403/TALK"  , "narrator": "神楽", "text": "けど"},
        { "location": "1404/TALK"  , "narrator": "神楽", "text": "だからどうすればいいか"},
        { "location": "1406/SEL"   , "narrator": "", "text": "とりあえず、契約違反したことを伝えよう"},
        { "location": "1407/ACT"   , "narrator": "", "text": "とりあえず、契約違反したことを伝えよう"},
        { "location": "1409/TALK"  , "narrator": "神楽", "text": "その後は？"},
        { "location": "1411/SEL"   , "narrator": "", "text": "頷くようなら、都度$me$から回答を出すから、その通りに言って"},
        { "location": "1412/ACT"   , "narrator": "", "text": "頷くようなら、都度$me$から回答を出すから、その通りに言って"},
        { "location": "1414/TALK"  , "narrator": "神楽", "text": "簡単に言いますけど"},
        { "location": "1415/TALK"  , "narrator": "神楽", "text": "一々画面見てたら"},
        { "location": "1417/TALK"  , "narrator": "神楽", "text": "私の言葉じゃないってバレバレのような・・・"},
        { "location": "1419/SEL"   , "narrator": "", "text": "直接心の中にイメージを送るから平気"},
        { "location": "1420/ACT"   , "narrator": "", "text": "直接心の中にイメージを送るから平気"},
        { "location": "1422/TALK"  , "narrator": "神楽", "text": "心の中にイメージを！？"},
        { "location": "1423/TALK"  , "narrator": "神楽", "text": "それってライフぎゃざー"},
        { "location": "1426/TALK"  , "narrator": "神楽", "text": "いえ"},
        { "location": "1427/TALK"  , "narrator": "神楽", "text": "なんでもありません"},
        { "location": "1438/TALK"  , "narrator": "神楽", "text": "…本当に\n大丈夫なのかしら？"},
        { "location": "1440/TALK"  , "narrator": "神楽", "text": "…あの、私が契約を\n違反したと\n言いましたよね？"},
        { "location": "1442/TALK"  , "narrator": "千羽鶴", "text": "ええ…事実。"},
        { "location": "1443/TALK"  , "narrator": "神楽", "text": "だとしたら、\n貴方はもっと前に\n違反してますよね？"},
        { "location": "1445/TALK"  , "narrator": "神楽", "text": "あなたは管理庁の\nエージェントでは\nなくて…。"},
        { "location": "1446/TALK"  , "narrator": "神楽", "text": "本当は、情報管理庁の\n長官ですよね？"},
        { "location": "1448/TALK"  , "narrator": "神楽", "text": "ウソをつかない…。\nこれは契約時の\n条件でしたよね？"},
        { "location": "1449/TALK"  , "narrator": "神楽", "text": "なので、そもそも\n契約自体が\n既に無効なんです。"},
        { "location": "1450/TALK"  , "narrator": "神楽", "text": "まあ、百歩譲って\n私がつばめさんを\nあの短時間の間に…。"},
        { "location": "1451/TALK"  , "narrator": "神楽", "text": "破壊しなかったことが\n契約違反であると\nしても。"},
        { "location": "1452/TALK"  , "narrator": "神楽", "text": "それより前に、\n契約は反故にされて\nいたんです。"},
        { "location": "1453/TALK"  , "narrator": "神楽", "text": "貴方の手によってね。"},
        { "location": "1454/TALK"  , "narrator": "千羽鶴", "text": "…………。"},
        { "location": "1455/TALK"  , "narrator": "神楽", "text": "どうですか？"},
        { "location": "1456/TALK"  , "narrator": "千羽鶴", "text": "…東雲隊長あたりから\n聞いたのね。"},
        { "location": "1457/TALK"  , "narrator": "千羽鶴", "text": "正直、その点について\nツッコまれるとは\n思わなかった…。"},
        { "location": "1458/TALK"  , "narrator": "神楽", "text": "…契約違反ですね。"},
        { "location": "1459/TALK"  , "narrator": "千羽鶴", "text": "貴方のいうとおり\n書面通りに捉えれば、\nそういうことになる。"},
        { "location": "1460/TALK"  , "narrator": "千羽鶴", "text": "けれども実際は、\n貴方は私の力が必要。"},
        { "location": "1461/TALK"  , "narrator": "千羽鶴", "text": "母を元に戻すために、\n私の力は絶対に\n必要なはず…・。"},
        { "location": "1462/TALK"  , "narrator": "千羽鶴", "text": "だから、契約を\n破棄して困るのは…。"},
        { "location": "1463/TALK"  , "narrator": "千羽鶴", "text": "卯月神楽、\n貴方の方でしょう？"},
        { "location": "1464/TALK"  , "narrator": "神楽", "text": "そ、それは…。"},
        { "location": "1465/TALK"  , "narrator": "神楽", "text": "…どうしよう。"},
        { "location": "1466/SEL"   , "narrator": "", "text": "困るのは貴方も同じですよね"},
        { "location": "1467/ACT"   , "narrator": "", "text": "困るのは貴方も同じですよね"},
        { "location": "1476/TALK"  , "narrator": "神楽", "text": "――ッ！？"},
        { "location": "1477/TALK"  , "narrator": "神楽", "text": "なに、今の…。\n心の中にイメージって\nこれのこと？"},
        { "location": "1478/TALK"  , "narrator": "千羽鶴", "text": "…図星のようね。"},
        { "location": "1479/TALK"  , "narrator": "神楽", "text": "…困るのはあなたも\n同じですよね？"},
        { "location": "1480/TALK"  , "narrator": "千羽鶴", "text": "…………。"},
        { "location": "1481/SEL"   , "narrator": "", "text": "どちらにせよ、貴方は私が動かなければ困る"},
        { "location": "1482/ACT"   , "narrator": "", "text": "どちらにせよ、貴方は私が動かなければ困る"},
        { "location": "1486/TALK"  , "narrator": "神楽", "text": "どちらにせよ、\nあなたは私が動かな\nければ困る。"},
        { "location": "1487/SEL"   , "narrator": "", "text": "私も母を人質に取られているようなものですが"},
        { "location": "1488/ACT"   , "narrator": "", "text": "私も母を人質に取られているようなものですが"},
        { "location": "1491/TALK"  , "narrator": "神楽", "text": "私も母を人質に\n取られているような\nものですが…。"},
        { "location": "1492/SEL"   , "narrator": "", "text": "それは最悪、彼らであっても"},
        { "location": "1493/ACT"   , "narrator": "", "text": "それは最悪、彼らであっても"},
        { "location": "1496/TALK"  , "narrator": "神楽", "text": "それは最悪、\n彼らであっても。"},
        { "location": "1497/SEL"   , "narrator": "", "text": "果ては第三者であっても"},
        { "location": "1498/ACT"   , "narrator": "", "text": "果ては第三者であっても"},
        { "location": "1501/TALK"  , "narrator": "神楽", "text": "果ては第三者で\nあっても…。"},
        { "location": "1502/SEL"   , "narrator": "", "text": "技術的要件を満たせば対処は可能なんです"},
        { "location": "1503/ACT"   , "narrator": "", "text": "技術的要件を満たせば対処は可能なんです"},
        { "location": "1506/TALK"  , "narrator": "神楽", "text": "技術的要件を満たせば\n対処は可能なんです。"},
        { "location": "1508/TALK"  , "narrator": "千羽鶴", "text": "えっ！？"},
        { "location": "1509/SEL"   , "narrator": "", "text": "わかりますか？貴方が私に望むものは、オンリーワンであり"},
        { "location": "1510/ACT"   , "narrator": "", "text": "わかりますか？貴方が私に望むものは、オンリーワンであり"},
        { "location": "1513/TALK"  , "narrator": "神楽", "text": "わかりますか？"},
        { "location": "1514/TALK"  , "narrator": "神楽", "text": "あなたが私に\n望むものは\nオンリーワンであり。"},
        { "location": "1515/SEL"   , "narrator": "", "text": "私が貴方に望む物は、より技術的で普遍的なもの"},
        { "location": "1516/ACT"   , "narrator": "", "text": "私が貴方に望む物は、より技術的で普遍的なもの"},
        { "location": "1519/TALK"  , "narrator": "神楽", "text": "私があなたに\n望むモノは…。"},
        { "location": "1520/TALK"  , "narrator": "神楽", "text": "より技術的で\n普遍的な物なのです。"},
        { "location": "1521/SEL"   , "narrator": "", "text": "私には代替する解決策がある"},
        { "location": "1522/ACT"   , "narrator": "", "text": "私には代替する解決策がある"},
        { "location": "1525/TALK"  , "narrator": "神楽", "text": "私には代替する\n解決策がある。"},
        { "location": "1526/SEL"   , "narrator": "", "text": "よって、契約が無効となった今、"},
        { "location": "1527/ACT"   , "narrator": "", "text": "よって、契約が無効となった今、"},
        { "location": "1530/TALK"  , "narrator": "神楽", "text": "よって、契約が\n無効となった今…。"},
        { "location": "1531/SEL"   , "narrator": "", "text": "私の方が立場は強いことになります"},
        { "location": "1532/ACT"   , "narrator": "", "text": "私の方が立場は強いことになります"},
        { "location": "1535/TALK"  , "narrator": "神楽", "text": "私の方が立場は\n強いことになります。"},
        { "location": "1537/TALK"  , "narrator": "神楽", "text": "…えっ！？"},
        { "location": "1538/TALK"  , "narrator": "神楽", "text": "対処可能？\n技術的要件を\n満たせばって…。"},
        { "location": "1539/TALK"  , "narrator": "神楽", "text": "…本当なの？\n千羽鶴でも、\n彼らでもない人が――"},
        { "location": "1540/TALK"  , "narrator": "神楽", "text": "母を直せるなんて…。\nそんなこと、\n本当にできるの？"},
        { "location": "1541/SEL"   , "narrator": "", "text": "神楽、信じて！"},
        { "location": "1542/ACT"   , "narrator": "", "text": "神楽、信じて！"},
        { "location": "1545/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1546/TALK"  , "narrator": "神楽", "text": "わかりました。\n覚悟を決めます。"},
        { "location": "1547/TALK"  , "narrator": "神楽", "text": "乗りかかった船だし、\nもう破れかぶれです！"},
        { "location": "1548/TALK"  , "narrator": "神楽", "text": "あとは、私が\n押し通します！"},
        { "location": "1549/TALK"  , "narrator": "神楽", "text": "いえ、正確には\n最初から私の方が\n立場は上でした。"},
        { "location": "1550/TALK"  , "narrator": "神楽", "text": "けど、私もより\nベストな解決を\n目指していました。"},
        { "location": "1551/TALK"  , "narrator": "神楽", "text": "なので、貴方の契約に\n同意したまでです。"},
        { "location": "1552/TALK"  , "narrator": "神楽", "text": "…けど、クオリティを\n問わなければ…。"},
        { "location": "1554/TALK"  , "narrator": "神楽", "text": "私には、他にも\n選択肢があるんです。"},
        { "location": "1555/SEL"   , "narrator": "", "text": "だから千羽鶴、$me$と結婚してください"},
        { "location": "1556/SEL"   , "narrator": "", "text": "私は$handlek$を愛していますから"},
        { "location": "1558/TALK"  , "narrator": "千羽鶴", "text": "…………。"},
        { "location": "1559/TALK"  , "narrator": "千羽鶴", "text": "確かに…。"},
        { "location": "1562/TALK"  , "narrator": "千羽鶴", "text": "貴方の言うことは、\nだいたい正しい。"},
        { "location": "1563/TALK"  , "narrator": "神楽", "text": "…随分と素直に\n認めるんですね。"},
        { "location": "1564/TALK"  , "narrator": "千羽鶴", "text": "事実だから…。"},
        { "location": "1565/TALK"  , "narrator": "千羽鶴", "text": "で？\nそれは誰の入れ知恵？"},
        { "location": "1566/TALK"  , "narrator": "神楽", "text": "そ、そこは関係無い\nでしょう？"},
        { "location": "1567/TALK"  , "narrator": "神楽", "text": "私は自分が納得して\n言ってるんだし。"},
        { "location": "1568/TALK"  , "narrator": "神楽", "text": "あなたも、\n正しいと言った。"},
        { "location": "1569/TALK"  , "narrator": "神楽", "text": "なら、もうこれは\n私達の問題です。"},
        { "location": "1570/TALK"  , "narrator": "千羽鶴", "text": "…………。"},
        { "location": "1571/SEL"   , "narrator": "", "text": "$me$だよ"},
        { "location": "1572/ACT"   , "narrator": "", "text": "$me$だよ"},
        { "location": "1575/ACT"   , "narrator": "", "text": "だから千羽鶴、私と結婚してください"},
        { "location": "1577/TALK"  , "narrator": "神楽", "text": "だから千羽鶴、\n$me$と結婚して\nください…。"},
        { "location": "1581/TALK"  , "narrator": "神楽", "text": "って、えぇっ！？"},
        { "location": "1584/TALK"  , "narrator": "千羽鶴", "text": "…………。"},
        { "location": "1586/TALK"  , "narrator": "神楽", "text": "あ、あのバカ…。\nどういうつもりよ！？"},
        { "location": "1587/TALK"  , "narrator": "千羽鶴", "text": "…やっぱりね。\nそんなことだろうとは\n思ってた。"},
        { "location": "1589/TALK"  , "narrator": "千羽鶴", "text": "手綱を引いてるのは、\n彼の世界の人ね。"},
        { "location": "1590/SEL"   , "narrator": "", "text": "そうだよ"},
        { "location": "1591/ACT"   , "narrator": "", "text": "そうだよ"},
        { "location": "1594/ACT"   , "narrator": "", "text": "私は$handlek$を愛していますから"},
        { "location": "1596/TALK"  , "narrator": "神楽", "text": "私は\n$handlek$を\n愛していますから！"},
        { "location": "1597/TALK"  , "narrator": "千羽鶴", "text": "…………。"},
        { "location": "1599/TALK"  , "narrator": "神楽", "text": "え…は！？"},
        { "location": "1601/TALK"  , "narrator": "神楽", "text": "あ、あのクソバカ！\nなに送ってるんだよ！"},
        { "location": "1602/TALK"  , "narrator": "千羽鶴", "text": "…やっぱりね。\nそんなことだろうとは\n思ってた。"},
        { "location": "1603/TALK"  , "narrator": "千羽鶴", "text": "手綱を引いてるのは、\n彼の世界の人ね。"},
        { "location": "1604/SEL"   , "narrator": "", "text": "そうだよ"},
        { "location": "1605/ACT"   , "narrator": "", "text": "そうだよ"},
        { "location": "1613/TALK"  , "narrator": "神楽", "text": "！？"},
        { "location": "1614/TALK"  , "narrator": "千羽鶴", "text": "…貴方のスマホ、\n貸して。"},
        { "location": "1615/TALK"  , "narrator": "千羽鶴", "text": "私が話したい\nことがある。"},
        { "location": "1617/TALK"  , "narrator": "神楽", "text": "…どうして\nそんな必要が？"},
        { "location": "1618/TALK"  , "narrator": "千羽鶴", "text": "安心して。\n貴方に不利益になる\nようなことはしない。"},
        { "location": "1619/TALK"  , "narrator": "千羽鶴", "text": "それと、ログは全部\n残した状態で返す。"},
        { "location": "1620/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1621/TALK"  , "narrator": "千羽鶴", "text": "ウソじゃない。\nこれは約束する。"},
        { "location": "1624/TALK"  , "narrator": "神楽", "text": "…わかりました。\n今回は信じます。"},
        { "location": "1626/TALK"  , "narrator": "千羽鶴", "text": "ありがと…。"},
        { "location": "1635/TALK"  , "narrator": "神楽", "text": "また。本当に貴方はどこの$handle$？"},
        { "location": "1637/SEL"   , "narrator": "", "text": "千羽鶴が知ってる$handle$です"},
        { "location": "1638/ACT"   , "narrator": "", "text": "千羽鶴が知ってる$handle$です"},
        { "location": "1642/TALK"  , "narrator": "神楽", "text": "いえ、貴方は私の知らない$handle$"},
        { "location": "1643/TALK"  , "narrator": "神楽", "text": "だって"},
        { "location": "1644/TALK"  , "narrator": "神楽", "text": "私がコンタクトを取った$handle$ではない"},
        { "location": "1646/SEL"   , "narrator": "", "text": "いや、千羽鶴が繋げた$handle$だよ"},
        { "location": "1647/ACT"   , "narrator": "", "text": "いや、千羽鶴が繋げた$handle$だよ"},
        { "location": "1651/TALK"  , "narrator": "神楽", "text": "証拠は？"},
        { "location": "1653/SEL"   , "narrator": "", "text": "心の中にちーすけが住んでるの知ってるよ"},
        { "location": "1654/SEL"   , "narrator": "", "text": "逆バブ属性なの知ってるよ"},
        { "location": "1655/SEL"   , "narrator": "", "text": "非攻略対象さんでしょ？"},
        { "location": "1656/ACT"   , "narrator": "", "text": "心の中にちーすけが住んでるの知ってるよ"},
        { "location": "1657/ACT"   , "narrator": "", "text": "逆バブ属性なの知ってるよ"},
        { "location": "1658/ACT"   , "narrator": "", "text": "非攻略対象さんでしょ？"},
        { "location": "1662/TALK"  , "narrator": "神楽", "text": "なるほど"},
        { "location": "1663/TALK"  , "narrator": "神楽", "text": "私の遙か先を行く観測者の$handle$であると"},
        { "location": "1665/SEL"   , "narrator": "", "text": "ご想像にお任せします"},
        { "location": "1666/ACT"   , "narrator": "", "text": "ご想像にお任せします"},
        { "location": "1675/TALK"  , "narrator": "千羽鶴", "text": "…………。"},
        { "location": "1676/TALK"  , "narrator": "神楽", "text": "…終わったんですか？"},
        { "location": "1678/TALK"  , "narrator": "千羽鶴", "text": "ええ…。\n貴方の条件は\n把握した。"},
        { "location": "1679/TALK"  , "narrator": "千羽鶴", "text": "少し考えるから、\n時間がほしい…。"},
        { "location": "1680/TALK"  , "narrator": "神楽", "text": "…まあ、いいですよ。"},
        { "location": "1681/TALK"  , "narrator": "神楽", "text": "けど、それまでずっと\nここにいろとは、\n言いませんよね？"},
        { "location": "1682/TALK"  , "narrator": "千羽鶴", "text": "…わかった。\n家に戻っていい。"},
        { "location": "1683/TALK"  , "narrator": "千羽鶴", "text": "答えが決まったら、\nまた連絡する。"},
