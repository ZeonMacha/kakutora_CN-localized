    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "016_塁球とも言うそうな"},
        { "location": "33/TALK"   , "narrator": "みやび", "text": "ソフトボールな"},
        { "location": "34/TALK"   , "narrator": "みやび", "text": "楽しかったぞ"},
        { "location": "36/SEL"    , "narrator": "", "text": "よかったね"},
        { "location": "37/SEL"    , "narrator": "", "text": "本格的に始める？"},
        { "location": "38/ACT"    , "narrator": "", "text": "よかったね"},
        { "location": "39/TALK"   , "narrator": "みやび", "text": "おうよ"},
        { "location": "40/ACT"    , "narrator": "", "text": "本格的に始める？"},
        { "location": "41/TALK"   , "narrator": "みやび", "text": "なんでじゃ"},
        { "location": "43/TALK"   , "narrator": "みやび", "text": "しかしくたびれた"},
        { "location": "44/TALK"   , "narrator": "みやび", "text": "もう一生することはないろうね"},
        { "location": "46/SEL"    , "narrator": "", "text": "人数集まらないしね"},
        { "location": "47/SEL"    , "narrator": "", "text": "いい思い出になった？"},
        { "location": "48/SEL"    , "narrator": "", "text": "意外と好きそうなのに"},
        { "location": "49/ACT"    , "narrator": "", "text": "人数集まらないしね"},
        { "location": "51/TALK"   , "narrator": "みやび", "text": "確かに"},
        { "location": "52/TALK"   , "narrator": "みやび", "text": "それもあるな"},
        { "location": "53/TALK"   , "narrator": "みやび", "text": "リアルで人数と時間を調整する手間を考えると"},
        { "location": "54/TALK"   , "narrator": "みやび", "text": "学生時代の特権かもな"},
        { "location": "55/ACT"    , "narrator": "", "text": "いい思い出になった？"},
        { "location": "57/TALK"   , "narrator": "みやび", "text": "まあな"},
        { "location": "58/TALK"   , "narrator": "みやび", "text": "うちのソフトボールの思い出としては最上級"},
        { "location": "60/TALK"   , "narrator": "みやび", "text": "まあ"},
        { "location": "61/TALK"   , "narrator": "みやび", "text": "それは"},
        { "location": "63/TALK"   , "narrator": "みやび", "text": "一度しかないからなわけだが"},
        { "location": "64/ACT"    , "narrator": "", "text": "意外と好きそうなのに"},
        { "location": "65/TALK"   , "narrator": "みやび", "text": "ゲームだと割り切ればよし"},
        { "location": "66/TALK"   , "narrator": "みやび", "text": "ならば楽しめなくもない"},
        { "location": "67/TALK"   , "narrator": "みやび", "text": "チームプレーの規律を乱すわけにはいかんろう"},
        { "location": "68/TALK"   , "narrator": "みやび", "text": "それだけぞね"}
    ]
}
