        "title": "【EXストーリー】熱血オヤジ",
        "sub_title": "シンクロストーリー"
    },
    "entry":
    [
        { "location": "180/SCENARIO", "narrator": "", "text": "【結果】播磨屋藤治郎"},
        { "location": "196/TALK"    , "narrator": "みやび", "text": "お疲れ。\n無事に完了した\nみたいやねえ。"},
        { "location": "197/TALK"    , "narrator": "みやび", "text": "これでとうちゃんの\nココロの中の\n抵抗は消えた、と。"},
        { "location": "198/TALK"    , "narrator": "みやび", "text": "つまり$handle$と\n繋がる準備ができた、\nちうわけや。"},
        { "location": "199/SEL"     , "narrator": "（選択肢）", "text": "とうちゃんと『シンクロ』するのか…"},
        { "location": "200/ACT"     , "narrator": "", "text": "とうちゃんと『シンクロ』するのか…"},
        { "location": "202/TALK"    , "narrator": "みやび", "text": "他に誰と\nする思うとる？"},
        { "location": "203/SEL"     , "narrator": "（選択肢）", "text": "みやび"},
        { "location": "204/SEL"     , "narrator": "（選択肢）", "text": "$me$自身"},
        { "location": "205/SEL"     , "narrator": "（選択肢）", "text": "とうちゃんしかないけど…"},
        { "location": "206/ACT"     , "narrator": "", "text": "みやび"},
        { "location": "207/TALK"    , "narrator": "みやび", "text": "なるほど。\n冗談が上手いねえ\n$handle$は。"},
        { "location": "208/TALK"    , "narrator": "みやび", "text": "しかし今回は\nとうちゃん以外の\n選択肢はないぞね。"},
        { "location": "209/ACT"     , "narrator": "", "text": "$me$自身"},
        { "location": "210/TALK"    , "narrator": "みやび", "text": "…ははあ。\n$handle$自身が\nクランやったぞね。"},
        { "location": "211/TALK"    , "narrator": "みやび", "text": "しかしそれでは\n話が続かんき。\nとうちゃんにしとき。"},
        { "location": "212/ACT"     , "narrator": "", "text": "とうちゃんしかないけど…"},
        { "location": "213/TALK"    , "narrator": "みやび", "text": "そうでないと\nおかしいろう？"},
        { "location": "214/TALK"    , "narrator": "みやび", "text": "覚悟決めて\nとうちゃんと\nシンクロしい。"},
        { "location": "216/TALK"    , "narrator": "みやび", "text": "シンクロしたら、\nとうちゃんの想いが\n流れ込むき。"},
        { "location": "217/TALK"    , "narrator": "みやび", "text": "$handle$は、\nそれを受け入れる\nちう寸法や。"},
        { "location": "218/TALK"    , "narrator": "みやび", "text": "準備はえいかね？"},
        { "location": "219/SEL"     , "narrator": "（選択肢）", "text": "はい"},
        { "location": "220/SEL"     , "narrator": "（選択肢）", "text": "いいえ"},
        { "location": "221/ACT"     , "narrator": "", "text": "はい"},
        { "location": "222/TALK"    , "narrator": "みやび", "text": "ええ返事やね。\nほいたらココロを\n繋げるきね。"},
        { "location": "223/ACT"     , "narrator": "", "text": "いいえ"},
        { "location": "225/TALK"    , "narrator": "みやび", "text": "なんで\nここまできて…。"},
        { "location": "226/TALK"    , "narrator": "みやび", "text": "まあえい。\n今回はここまでや。"},
        { "location": "227/TALK"    , "narrator": "みやび", "text": "準備ができたら\nまた来たらえい。"},
        { "location": "235/TALK"    , "narrator": "みやび", "text": "EXEC_SYNC_SPHERE/."},
        { "location": "248/DIALOG"  , "narrator": "", "text": "この部品があるから\nロケットは宇宙まで飛べるんだ！"},
        { "location": "255/DIALOG"  , "narrator": "", "text": "クランイラスト先読み"},
        { "location": "265/DIALOG"  , "narrator": "", "text": "播磨藤治郎（はりまとうじろう）。５４歳男。子供４人を持つ一家の大黒柱。\n\n大田区蒲田で零細企業「播磨金属工業」を切り盛りしている。江戸時代には播磨屋という手工業の家だったが、戦前から金属工業に転身。\n職人気質の家系で品質にはこだわりがあり、衛星用のパーツを作ったこともある。"},
        { "location": "266/DIALOG"  , "narrator": "", "text": "子供の中から誰か一人後継ぎを欲しがっていたが、４人とも拒否。頑固親父の藤治郎は、そんな子供達をよく叱責していたが、子供達は離れていくばかり。時代の波と、３K零細企業では仕方のないことではあると半ば諦めていた。"},
        { "location": "267/DIALOG"  , "narrator": "", "text": "そんな後継ぎ問題もある中、さらに大きな問題に直面する。下請法の改正と消費税増税の煽りを受け、一気に倒産寸前にまで追いやられてしまったのだ。\n\n下請法は、下請けを保護するための法律の筈が、逆に大企業が下請けを警戒して下請けにとっては大打撃な法律である。その為その年からの受注は減。それにプラスして消費増税により、国内産業である零細企業は、赤字になっても支払わなければならない税が増え、一気に借金地獄になってしまったのだ。"},
        { "location": "272/DIALOG"  , "narrator": "", "text": "子供4人中3人は高校と大学。私立に通う子供もいる中、養育費だけで年間数百万～一千万は飛んでいく状況で、もはや家庭崩壊寸前。\n\n大学に行けなくなりそうな子供がキレて、「いつまでもそんな儲からない仕事続けてるからだ」と言うものだから、血の気が多い藤治郎もキレて取っ組み合いのケンカに。先祖代々からのアイデンティティであり誇りでもある金属加工業を侮辱されたことで、遂に発症してしまう。"},
        { "location": "277/DIALOG"  , "narrator": "", "text": "発症後の世界では、ただひたすら巨大なロケットを作り続けていた藤治郎。\n\nそれは、息子達にこの仕事がいかに誇れるものなのか、どれだけ夢がある仕事なのかを伝えたいという想いの具現化だった。"},
        { "location": "294/TALK"    , "narrator": "みやび", "text": "どうやったかね。\nとうちゃんの想いは。"},
        { "location": "295/SEL"     , "narrator": "（選択肢）", "text": "時代に乗り遅れたんだね"},
        { "location": "296/SEL"     , "narrator": "（選択肢）", "text": "頑固一徹って感じ"},
        { "location": "297/SEL"     , "narrator": "（選択肢）", "text": "特許とか取ればよかったのに"},
        { "location": "298/ACT"     , "narrator": "", "text": "時代に乗り遅れたんだね"},
        { "location": "299/TALK"    , "narrator": "みやび", "text": "身も蓋もない\n言い方を…。"},
        { "location": "300/ACT"     , "narrator": "", "text": "頑固一徹って感じ"},
        { "location": "301/TALK"    , "narrator": "みやび", "text": "確かに。\nその言葉を具現化したら\nとうちゃんになる。"},
        { "location": "302/ACT"     , "narrator": "", "text": "特許とか取ればよかったのに"},
        { "location": "303/TALK"    , "narrator": "みやび", "text": "……かもねえ。\n今となっては\n遅いけんど。"},
        { "location": "305/TALK"    , "narrator": "みやび", "text": "普段は情報こそ命と\n言うとるうちやけんど。"},
        { "location": "306/TALK"    , "narrator": "みやび", "text": "情報に振り回されるのが\n一番よくないとも\n思うとる。"},
        { "location": "307/TALK"    , "narrator": "みやび", "text": "その点とうちゃんは\n職人の技を極めて\nそれを仕事にしとった。"},
        { "location": "308/TALK"    , "narrator": "みやび", "text": "はんかな技術では\n衛星部品など\n作れんろう。"},
        { "location": "309/TALK"    , "narrator": "みやび", "text": "うちはそれを大変に\n好ましいと\n思うたぞね。"},
        { "location": "310/SEL"     , "narrator": "（選択肢）", "text": "それはラブの意味で？"},
        { "location": "311/SEL"     , "narrator": "（選択肢）", "text": "ハッカーに通じるものがあるね"},
        { "location": "312/SEL"     , "narrator": "（選択肢）", "text": "職人気質って格好いい"},
        { "location": "313/ACT"     , "narrator": "", "text": "それはラブの意味で？"},
        { "location": "314/TALK"    , "narrator": "みやび", "text": "うちは妻子のおる人に\n恋慕するほど\n浅はかではないき。"},
        { "location": "315/ACT"     , "narrator": "", "text": "ハッカーに通じるものがあるね"},
        { "location": "316/TALK"    , "narrator": "みやび", "text": "そう。\nハッカーもある意味\n職人芸。"},
        { "location": "317/ACT"     , "narrator": "", "text": "職人気質って格好いい"},
        { "location": "318/TALK"    , "narrator": "みやび", "text": "そうやね。\n$handle$も\n職人を目指すとえい。"},
        { "location": "320/TALK"    , "narrator": "みやび", "text": "とうちゃんはうちを\n認めてくれちゅう。"},
        { "location": "321/TALK"    , "narrator": "みやび", "text": "それは同世代の\n子供がおったせいも\nあるやろうけんど。"},
        { "location": "322/TALK"    , "narrator": "みやび", "text": "職人気質という点で\n共鳴できたと\n思うちょる。"},
        { "location": "323/TALK"    , "narrator": "みやび", "text": "…もしかしたら\n単なるべらんめえの\n共鳴なのかもしれん。"},
        { "location": "324/SEL"     , "narrator": "（選択肢）", "text": "むしろそっちじゃない？"},
        { "location": "325/SEL"     , "narrator": "（選択肢）", "text": "いや、外見はお淑やかだしみやび"},
        { "location": "326/SEL"     , "narrator": "（選択肢）", "text": "仕事の姿勢ってことにしとこうよ"},
        { "location": "327/ACT"     , "narrator": "", "text": "むしろそっちじゃない？"},
        { "location": "328/TALK"    , "narrator": "みやび", "text": "いや。\n冗談に本気で\n返すことはないろう。"},
        { "location": "329/ACT"     , "narrator": "", "text": "いや、外見はお淑やかだしみやび"},
        { "location": "330/TALK"    , "narrator": "みやび", "text": "内面は？"},
        { "location": "331/ACT"     , "narrator": "", "text": "仕事の姿勢ってことにしとこうよ"},
        { "location": "332/TALK"    , "narrator": "みやび", "text": "素直に\nそうとるべきやった。"},
        { "location": "334/TALK"    , "narrator": "みやび", "text": "それはさておき。"},
        { "location": "335/TALK"    , "narrator": "みやび", "text": "とうちゃんは今日から、\n$handle$とも\nつながったちうことで。"},
        { "location": "336/TALK"    , "narrator": "みやび", "text": "適材適所。\nえい采配を\n頼むぞね。"},
        { "location": "337/SEL"     , "narrator": "（選択肢）", "text": "みやびがやって"},
        { "location": "338/SEL"     , "narrator": "（選択肢）", "text": "これからもがんばろう！"},
        { "location": "339/ACT"     , "narrator": "", "text": "みやびがやって"},
        { "location": "341/TALK"    , "narrator": "みやび", "text": "うちやと上手すぎて\nすぐに勝負が終わるが\nそれでえいかね。"},
        { "location": "342/ACT"     , "narrator": "", "text": "これからもがんばろう！"},
        { "location": "344/TALK"    , "narrator": "みやび", "text": "熱血やねえ。\nもう少しテンション\n下げてもええろう。"},
        { "location": "346/TALK"    , "narrator": "みやび", "text": "またうちと相性のえい\nクランがおったら\n紹介するき。"},
        { "location": "347/TALK"    , "narrator": "みやび", "text": "その時を\n楽しみに待っちょき。"}
    ]
}
