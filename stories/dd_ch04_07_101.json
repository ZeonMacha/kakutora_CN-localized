{
    "dir": "chap07/daydra/dd_ch04_07_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "7402",
        "cid": "miyabi",
        "title": "002 メインストーリー",
        "sub_title": "劇場の日常＜前編＞"
    },
    "entry":
    [
        { "location": "8/SCENARIO", "narrator": "", "text": "劇場の日常"},
        { "location": "43/TALK"   , "narrator": "真幌", "text": "よし、開館時間だ。\n今日もよろしく\n頼むぞ。"},
        { "location": "45/TALK"   , "narrator": "つばめ", "text": "わかりました！"},
        { "location": "48/TALK"   , "narrator": "つばめ", "text": "よーし、お掃除\n頑張るぞー！"},
        { "location": "51/TALK"   , "narrator": "ガブリエラ", "text": "暑苦しいわね。\n何気合い入れてるん\nだか…。"},
        { "location": "53/TALK"   , "narrator": "アーヤ", "text": "真剣な証拠でしょ？\nいいことじゃない。"},
        { "location": "54/TALK"   , "narrator": "つばめ", "text": "えへへ…。\nお掃除は、昔から\n結構好きなんです。"},
        { "location": "56/TALK"   , "narrator": "真幌", "text": "ほう、掃除好きとは\n珍しいな？"},
        { "location": "58/TALK"   , "narrator": "つばめ", "text": "お掃除だけは、\n昔から褒められて\nたんです。"},
        { "location": "60/TALK"   , "narrator": "ガブリエラ", "text": "ふーん。"},
        { "location": "62/TALK"   , "narrator": "ガブリエラ", "text": "じゃあ、掃除担当は\nこれからもあんたで\n決まりね。"},
        { "location": "65/TALK"   , "narrator": "つばめ", "text": "えぇっ！？"},
        { "location": "66/TALK"   , "narrator": "ガブリエラ", "text": "掃除好きなんだから、\n文句ないでしょ？"},
        { "location": "67/TALK"   , "narrator": "ガブリエラ", "text": "それともあんたが\n映写機まわしたりとか\nするわけ？"},
        { "location": "69/TALK"   , "narrator": "つばめ", "text": "む、無理ですよぉ…。"},
        { "location": "70/TALK"   , "narrator": "つばめ", "text": "っていうか、\nせんぱいはそういうの\nするんですか？"},
        { "location": "73/TALK"   , "narrator": "ガブリエラ", "text": "あたしは売店担当よ。\n映写室関係はアーヤの\n仕事だし。"},
        { "location": "75/TALK"   , "narrator": "つばめ", "text": "みやびさんは\n何の担当なんですか？"},
        { "location": "78/TALK"   , "narrator": "みやび", "text": "まほさんが趣味で\n集めたフィルムの\n情報を――"},
        { "location": "79/TALK"   , "narrator": "みやび", "text": "どんどんＰＣに\n打ち込んでいく\n作業や。"},
        { "location": "81/TALK"   , "narrator": "つばめ", "text": "えっと…真幌さんの\n趣味手伝い担当、って\nことですか？"},
        { "location": "84/TALK"   , "narrator": "真幌", "text": "趣味とか言うな。\nちゃんと劇場で流す\nフィルムだぞ？"},
        { "location": "87/TALK"   , "narrator": "みやび", "text": "まあ、ＰＣ弄る作業\n担当、ってことやね。"},
        { "location": "89/TALK"   , "narrator": "みやび", "text": "言っとくけんど、\n掃除担当とチェンジ\nする気はないぞね？"},
        { "location": "91/TALK"   , "narrator": "つばめ", "text": "うーん…わたし、\nやっぱり掃除担当で\nいいです。"},
        { "location": "93/TALK"   , "narrator": "つばめ", "text": "機械に触るのも、\nお客さんと喋ったり\nするより――"},
        { "location": "94/TALK"   , "narrator": "つばめ", "text": "お掃除してる方が\n性に合ってる気が\nしますし…。"},
        { "location": "95/TALK"   , "narrator": "みやび", "text": "…機械関係の作業を\nいきなりするんは\nムリやろうけんど――"},
        { "location": "98/TALK"   , "narrator": "みやび", "text": "客相手より掃除を\n選ぶなんて…、\nコミュ障の気あり？"},
        { "location": "101/TALK"  , "narrator": "つばめ", "text": "う、うーん…、\nどんなんでしょう？"},
        { "location": "102/TALK"  , "narrator": "つばめ", "text": "でも、知らない人と\n話すのって、ちょっと\n苦手だから――"},
        { "location": "105/TALK"  , "narrator": "つばめ", "text": "やっぱり、わたしって\nコミュ障なのかも…。"},
        { "location": "108/TALK"  , "narrator": "アーヤ", "text": "そんなことないって。\n誰でも、大なり小なり\n緊張するものだから。"},
        { "location": "110/TALK"  , "narrator": "アーヤ", "text": "さ、それじゃみんな、\n今日も頑張りましょ。"},
        { "location": "112/TALK"  , "narrator": "ガブリエラ", "text": "はいはい…。\n面倒くさいけどね。"},
        { "location": "116/TALK"  , "narrator": "みやび", "text": "はぁ…お仕事開始や。"},
        { "location": "142/TALK"  , "narrator": "みやび", "text": "…まあ、こんな作業、\n三十分もあれば\n余裕で終わるき――"},
        { "location": "143/TALK"  , "narrator": "みやび", "text": "ウサギとチャット\nしちょる時間の方が\n多いんやが…。"},
        { "location": "147/TALK"  , "narrator": "みやび", "text": "…ふむ、そうかぁ。\nやはり上手くいっちょ\nらんか…。"},
        { "location": "148/TALK"  , "narrator": "みやび", "text": "攻め方を変えてみる\nゆうんはどうか？"},
        { "location": "152/TALK"  , "narrator": "みやび", "text": "…難しそう、か。"},
        { "location": "153/TALK"  , "narrator": "みやび", "text": "まあ、もうしばらく\n様子見しながら――"},
        { "location": "154/TALK"  , "narrator": "みやび", "text": "ちくちく攻めてくしか\nなさそうやな。"},
        { "location": "158/TALK"  , "narrator": "みやび", "text": "…そういえば、\nつばめちゃん――"},
        { "location": "159/TALK"  , "narrator": "みやび", "text": "知らん人と話すんが\n苦手言うてたな。"},
        { "location": "160/TALK"  , "narrator": "みやび", "text": "まあ、人付き合いが\n上手そうな子では\nないけんど――"},
        { "location": "161/TALK"  , "narrator": "みやび", "text": "とりあえず、これで\nまた一つ情報が増えた\nのは確かやな。"},
        { "location": "162/TALK"  , "narrator": "みやび", "text": "つばめちゃんは、\n色々と謎多き\n乙女やき――"},
        { "location": "163/TALK"  , "narrator": "みやび", "text": "小さい情報でも、\n今はありがたく思うて\nおかんと…。"},
        { "location": "167/TALK"  , "narrator": "みやび", "text": "…ちゅうか、よくよく\n考えると、新人さんの\nことだけやなくて――"},
        { "location": "168/TALK"  , "narrator": "みやび", "text": "アーヤ達のことも、\nそんなに知っちょる\nわけやないか…。"},
        { "location": "173/TALK"  , "narrator": "みやび", "text": "…管理庁のＰＣから、\n情報引っこ抜くか。"},
        { "location": "174/TALK"  , "narrator": "みやび", "text": "それなら、\nつばめちゃんの\n情報を――"},
        { "location": "175/TALK"  , "narrator": "みやび", "text": "手に入れる片手間に\nやれそうやし。"},
        { "location": "177/TALK"  , "narrator": "みやび", "text": "ふむ…どうしたもん\nかなぁ？"},
        { "location": "221/TALK"  , "narrator": "みやび", "text": "……　…"},
        { "location": "235/TALK"  , "narrator": "みやび", "text": "ふわあっ！"},
        { "location": "239/TALK"  , "narrator": "みやび", "text": "ひやぁぁっ！"},
        { "location": "243/TALK"  , "narrator": "みやび", "text": "ふごあぁぁっ！"},
        { "location": "250/TALK"  , "narrator": "みやび", "text": "キマシタワー！"},
        { "location": "251/SEL"   , "narrator": "", "text": "え…ええ？"},
        { "location": "252/ACT"   , "narrator": "", "text": "え…ええ？"},
        { "location": "256/TALK"  , "narrator": "みやび", "text": "最近うち、お前さんに\nたたき起こされる刺激に\nドキドキする17歳。"},
        { "location": "257/TALK"  , "narrator": "みやび", "text": "こんな身体にして\nくれちゃって、どう\n責任とってくれるのっ？"},
        { "location": "258/SEL"   , "narrator": "", "text": "え、ええと…"},
        { "location": "259/SEL"   , "narrator": "", "text": "一生添い遂げます！"},
        { "location": "260/ACT"   , "narrator": "", "text": "え、ええと…"},
        { "location": "261/TALK"  , "narrator": "みやび", "text": "――っと、\nお遊びは終了。"},
        { "location": "262/TALK"  , "narrator": "みやび", "text": "えい暇つぶしになった。"},
        { "location": "263/ACT"   , "narrator": "", "text": "一生添い遂げます！"},
        { "location": "264/TALK"  , "narrator": "みやび", "text": "――っと、\nお遊びは終了。"},
        { "location": "265/TALK"  , "narrator": "みやび", "text": "えい暇つぶしになった。"},
        { "location": "266/SEL"   , "narrator": "", "text": "いや、一生添い遂げたいんですけど"},
        { "location": "267/ACT"   , "narrator": "", "text": "いや、一生添い遂げたいんですけど"},
        { "location": "270/TALK"  , "narrator": "みやび", "text": "ふむ。\nやき、それは現実の\nうちに言いや。"},
        { "location": "271/TALK"  , "narrator": "みやび", "text": "まあ、即日切断\nやろうけんどな。"},
        { "location": "274/TALK"  , "narrator": "みやび", "text": "はぁ、\nほんだら仕事しますか。"},
        { "location": "279/TALK"  , "narrator": "みやび", "text": "オープンプロセス、\n0x498番地から\n0x3BC番地へ。"},
        { "location": "294/TALK"  , "narrator": "みやび", "text": "完了。"},
        { "location": "296/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "298/TALK"  , "narrator": "みやび", "text": "………。"},
        { "location": "299/TALK"  , "narrator": "みやび", "text": "うーむ。\n今回のは割と\nガチ目やね。"},
        { "location": "300/TALK"  , "narrator": "みやび", "text": "ココロファイルナンバー\n04-991-03によると――"},
        { "location": "301/TALK"  , "narrator": "みやび", "text": "うちはトライナリーの\n中で、かなり孤立\nしちゅうと思っちゅう。"},
        { "location": "302/TALK"  , "narrator": "みやび", "text": "自分だけが現実に対し\n正確に警戒し、具体的な\n行動に出ている。"},
        { "location": "303/TALK"  , "narrator": "みやび", "text": "けんどまた、それが\n半端ない孤独感の原因に\nなっちゅうのも事実。"},
        { "location": "304/TALK"  , "narrator": "みやび", "text": "まあ、誰一人信用する\nつもりはないき、\n仕方ないことやけんど。"},
        { "location": "305/SEL"   , "narrator": "", "text": "トライナリーのメンバーは全員だめなの？"},
        { "location": "306/ACT"   , "narrator": "", "text": "トライナリーのメンバーは全員だめなの？"},
        { "location": "308/TALK"  , "narrator": "みやび", "text": "そもそも管理庁を\n疑ってる時点で、\nダメっちゃダメやね。"},
        { "location": "309/TALK"  , "narrator": "みやび", "text": "割とハマリモード。"},
        { "location": "310/TALK"  , "narrator": "みやび", "text": "……まあしかし。"},
        { "location": "312/TALK"  , "narrator": "みやび", "text": "今回のうちにとって、\n１つだけ解決策があると\nするならば、それは――"},
        { "location": "313/TALK"  , "narrator": "みやび", "text": "お前さんの存在やね。"},
        { "location": "314/SEL"   , "narrator": "", "text": "$me$？"},
        { "location": "317/TALK"  , "narrator": "みやび", "text": "うむ。"},
        { "location": "318/TALK"  , "narrator": "みやび", "text": "もちろんお前さんも\n管理庁の手先かもしれん\n以上、一緒やけんど。"},
        { "location": "319/TALK"  , "narrator": "みやび", "text": "しかしトライナリーでは\nないが故に、彼女たち\nとは少し視点が違う。"},
        { "location": "320/TALK"  , "narrator": "みやび", "text": "こと、今回の様にトライ\nナリーに対する案件には\n協力者として参加できる。"},
        { "location": "321/SEL"   , "narrator": "", "text": "そういうものなの？"},
        { "location": "322/ACT"   , "narrator": "", "text": "そういうものなの？"},
        { "location": "324/TALK"  , "narrator": "みやび", "text": "そういうもんちや。"},
        { "location": "326/TALK"  , "narrator": "みやび", "text": "もっと端的に\n分かりやすく\n言っちゃろか？"},
        { "location": "327/TALK"  , "narrator": "みやび", "text": "うちは単に、トライナリー\nについて対等に邪推できる\n茶飲み友達が欲しいんよ。"},
        { "location": "328/SEL"   , "narrator": "", "text": "マジで？$me$も疑われてるのに？"},
        { "location": "329/ACT"   , "narrator": "", "text": "マジで？$me$も疑われてるのに？"},
        { "location": "331/TALK"  , "narrator": "みやび", "text": "それはそれ。\nこれはこれ。"},
        { "location": "332/TALK"  , "narrator": "みやび", "text": "もちろん、お前さんが\nターゲットになったら\n逆に排斥されるよ。"},
        { "location": "333/TALK"  , "narrator": "みやび", "text": "乙女心っちゅうんは、\nワガママで理不尽で、\n自己中心的なものなんよ。"},
        { "location": "334/TALK"  , "narrator": "みやび", "text": "まあこんな感じで、\n深くなればなるほど\n内容は無茶になってく。"},
        { "location": "335/TALK"  , "narrator": "みやび", "text": "それでもつき合う\nゆうなら、うちとしては\n助かるけんど……。"},
        { "location": "336/TALK"  , "narrator": "みやび", "text": "お前さんの身が\n持たんかもしれんよ？"},
        { "location": "337/SEL"   , "narrator": "", "text": "大丈夫！"},
        { "location": "338/SEL"   , "narrator": "", "text": "確かにそうだね"},
        { "location": "339/ACT"   , "narrator": "", "text": "大丈夫！"},
        { "location": "340/TALK"  , "narrator": "みやび", "text": "そか。\n強いね。"},
        { "location": "341/TALK"  , "narrator": "みやび", "text": "まあ、目下の課題は\n今起こっちゅう停滞や。"},
        { "location": "342/TALK"  , "narrator": "みやび", "text": "まずはクランを倒して\n気持ちの整理をさせや。"},
        { "location": "343/TALK"  , "narrator": "みやび", "text": "んで、次に現実世界に\nもどって、うちと\nえい感じに対話する。"},
        { "location": "344/TALK"  , "narrator": "みやび", "text": "えいか？"},
        { "location": "345/SEL"   , "narrator": "", "text": "オッケー"},
        { "location": "346/SEL"   , "narrator": "", "text": "ビックリするくらい仕事してるね！"},
        { "location": "347/ACT"   , "narrator": "", "text": "オッケー"},
        { "location": "348/TALK"  , "narrator": "みやび", "text": "うむ。"},
        { "location": "349/ACT"   , "narrator": "", "text": "ビックリするくらい仕事してるね！"},
        { "location": "351/TALK"  , "narrator": "みやび", "text": "ほっとけ。"},
        { "location": "352/TALK"  , "narrator": "みやび", "text": "うちやって、\nTPOっちゅうもんは\n弁えちゅうよ。"},
        { "location": "355/TALK"  , "narrator": "みやび", "text": "ほんだら\n宜しく頼むで。"},
        { "location": "356/TALK"  , "narrator": "みやび", "text": "うちと$handle$に\nえいココロの旅を！"},
        { "location": "363/ACT"   , "narrator": "", "text": "確かにそうだね"},
        { "location": "364/TALK"  , "narrator": "みやび", "text": "うむ。\nそれが普通の答えちや。"},
        { "location": "365/TALK"  , "narrator": "みやび", "text": "まあ、\n無理にとは言わんよ。"},
        { "location": "366/TALK"  , "narrator": "みやび", "text": "扉は開けておくき、\n気が向いたら頼むぞね。"},
        { "location": "41/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>5月8日　11:20 AM</color>\nゴールデンウィーク最終日、神楽坂トライナリー劇場にて。"},
        { "location": "189/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "226/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "248/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"}
    ]
}
