        "title": "002 メインストーリー",
        "sub_title": "今ここにある奇跡＜前編＞"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "夕焼け空、気持ちはブルー"},
        { "location": "34/TALK"   , "narrator": "ガブリエラ", "text": "…。"},
        { "location": "35/TALK"   , "narrator": "アーヤ", "text": "ふう。"},
        { "location": "37/TALK"   , "narrator": "ガブリエラ", "text": "ねえアーヤ。"},
        { "location": "39/TALK"   , "narrator": "アーヤ", "text": "何？"},
        { "location": "40/TALK"   , "narrator": "ガブリエラ", "text": "さっきからため息\nばかりだけど。"},
        { "location": "42/TALK"   , "narrator": "みやび", "text": "そうやねえ。"},
        { "location": "43/TALK"   , "narrator": "ガブリエラ", "text": "そんなにお姉さんに\n会いたくないの？"},
        { "location": "44/TALK"   , "narrator": "アーヤ", "text": "…え。"},
        { "location": "46/TALK"   , "narrator": "アーヤ", "text": "会いたくないって\nわけじゃないわ。"},
        { "location": "47/TALK"   , "narrator": "アーヤ", "text": "でも気持ちはブルーなの。\n姉妹がいないとなかなか\nわからないと思うけど。"},
        { "location": "48/TALK"   , "narrator": "ガブリエラ", "text": "何言ってるのよ。"},
        { "location": "50/TALK"   , "narrator": "ガブリエラ", "text": "本当はお姉さんに会うの\n恥ずかしいだけでしょ？"},
        { "location": "51/TALK"   , "narrator": "アーヤ", "text": "違うわよ。"},
        { "location": "52/TALK"   , "narrator": "アーヤ", "text": "そんな単純な話じゃ\nないの。"},
        { "location": "53/TALK"   , "narrator": "ガブリエラ", "text": "素直に\n認めればいいのに。"},
        { "location": "55/TALK"   , "narrator": "ガブリエラ", "text": "大人ぶってても\nすごく子供っぽいわ、\nそういうの。"},
        { "location": "56/TALK"   , "narrator": "アーヤ", "text": "…外の空気吸ってくる。"},
        { "location": "59/TALK"   , "narrator": "ガブリエラ", "text": "……。\nなんでお姉さんが絡むと\nああなのかしら。"},
        { "location": "62/TALK"   , "narrator": "みやび", "text": "一言では表せんような\nことがあったんやろう。"},
        { "location": "63/TALK"   , "narrator": "ガブリエラ", "text": "でも、だからって…。"},
        { "location": "64/TALK"   , "narrator": "みやび", "text": "言いとうなる気持ちも\nわかるけんど。"},
        { "location": "65/TALK"   , "narrator": "ガブリエラ", "text": "あたしが悪いみたいに\n言わないでよ！"},
        { "location": "66/TALK"   , "narrator": "みやび", "text": "まあまあ。\nお茶でも飲んで\n落ち着き。"},
        { "location": "78/TALK"   , "narrator": "ガブリエラ", "text": "ねえ$marzanna$"},
        { "location": "80/TALK"   , "narrator": "ガブリエラ", "text": "私悪いことを言ったのかしら？"},
        { "location": "82/SEL"    , "narrator": "", "text": "なんとも"},
        { "location": "83/SEL"    , "narrator": "", "text": "そうかも"},
        { "location": "84/SEL"    , "narrator": "", "text": "そんなことないんじゃない"},
        { "location": "85/ACT"    , "narrator": "", "text": "なんとも"},
        { "location": "86/TALK"   , "narrator": "ガブリエラ", "text": "そう"},
        { "location": "87/ACT"    , "narrator": "", "text": "そうかも"},
        { "location": "88/TALK"   , "narrator": "ガブリエラ", "text": "そうなのね"},
        { "location": "89/ACT"    , "narrator": "", "text": "そんなことないんじゃない"},
        { "location": "91/TALK"   , "narrator": "ガブリエラ", "text": "違うかしら？"},
        { "location": "93/TALK"   , "narrator": "ガブリエラ", "text": "本当は私"},
        { "location": "94/TALK"   , "narrator": "ガブリエラ", "text": "ちょっとアーヤを"},
        { "location": "95/TALK"   , "narrator": "ガブリエラ", "text": "元気にしたかったのに"},
        { "location": "97/SEL"    , "narrator": "", "text": "ならそう言えばいい"},
        { "location": "98/SEL"    , "narrator": "", "text": "あれだと通じないだろうね"},
        { "location": "99/SEL"    , "narrator": "", "text": "ガブリエラはツンデレだなあ"},
        { "location": "100/ACT"   , "narrator": "", "text": "ならそう言えばいい"},
        { "location": "102/TALK"  , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "104/TALK"  , "narrator": "ガブリエラ", "text": "それだけの話なのね"},
        { "location": "105/ACT"   , "narrator": "", "text": "あれだと通じないだろうね"},
        { "location": "107/TALK"  , "narrator": "ガブリエラ", "text": "通じないなら"},
        { "location": "108/TALK"  , "narrator": "ガブリエラ", "text": "意味ないわよね"},
        { "location": "109/TALK"  , "narrator": "ガブリエラ", "text": "私ったら"},
        { "location": "110/ACT"   , "narrator": "", "text": "ガブリエラはツンデレだなあ"},
        { "location": "111/TALK"  , "narrator": "ガブリエラ", "text": "もう！"},
        { "location": "112/TALK"  , "narrator": "ガブリエラ", "text": "そんな言い方"},
        { "location": "113/TALK"  , "narrator": "ガブリエラ", "text": "やめてよね！"},
        { "location": "126/TALK"  , "narrator": "ガブリエラ", "text": "みんなしてあたしが\n悪いみたいに…。"},
        { "location": "127/TALK"  , "narrator": "ガブリエラ", "text": "でも確かにちょっと\n言い方は悪かった\n気がするわ。"},
        { "location": "176/TALK"  , "narrator": "ガブリエラ", "text": "　"},
        { "location": "193/TALK"  , "narrator": "ガブリエラ", "text": "$handle$！\nよく来たわね。"},
        { "location": "194/TALK"  , "narrator": "ガブリエラ", "text": "前に来たときの約束、\nおぼえていて？"},
        { "location": "195/SEL"   , "narrator": "", "text": "マークスマンの所へ行くんだっけ？"},
        { "location": "196/SEL"   , "narrator": "", "text": "あ、今回がガブリエラとの挙式回だったか！"},
        { "location": "197/ACT"   , "narrator": "", "text": "マークスマンの所へ行くんだっけ？"},
        { "location": "198/TALK"  , "narrator": "ガブリエラ", "text": "そうよ。"},
        { "location": "199/TALK"  , "narrator": "ガブリエラ", "text": "凄く嫌な予感がするから、\n一刻も早く\n向かいたいのよ。"},
        { "location": "200/ACT"   , "narrator": "", "text": "あ、今回がガブリエラとの挙式回だったか！"},
        { "location": "203/TALK"  , "narrator": "ガブリエラ", "text": "はぁ！？"},
        { "location": "204/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "205/TALK"  , "narrator": "ガブリエラ", "text": "…そうよ！！\nだから早く\n挙式の準備しなさいよ！"},
        { "location": "206/SEL"   , "narrator": "", "text": "す、すみません、冗談です…"},
        { "location": "207/SEL"   , "narrator": "", "text": "さあ、早く着替えて！"},
        { "location": "208/ACT"   , "narrator": "", "text": "す、すみません、冗談です…"},
        { "location": "210/TALK"  , "narrator": "ガブリエラ", "text": "はぁ…。\nまったくもう。"},
        { "location": "211/TALK"  , "narrator": "ガブリエラ", "text": "この忙しいときに、\n冗談とか言わないで。"},
        { "location": "212/ACT"   , "narrator": "", "text": "さあ、早く着替えて！"},
        { "location": "215/TALK"  , "narrator": "ガブリエラ", "text": "調子にのるな！"},
        { "location": "216/SEL"   , "narrator": "", "text": "すみません…"},
        { "location": "217/SEL"   , "narrator": "", "text": "冗談ではない！（キリッ"},
        { "location": "218/ACT"   , "narrator": "", "text": "すみません…"},
        { "location": "219/TALK"  , "narrator": "ガブリエラ", "text": "はぁ…。\nまったくもう。"},
        { "location": "220/TALK"  , "narrator": "ガブリエラ", "text": "この忙しいときに、\n冗談とか言わないで。"},
        { "location": "221/ACT"   , "narrator": "", "text": "冗談ではない！（キリッ"},
        { "location": "223/TALK"  , "narrator": "ガブリエラ", "text": "ちょっと\nいい加減にしなさいよ。"},
        { "location": "224/TALK"  , "narrator": "ガブリエラ", "text": "だ、だいたいあたしと\nお式したって、単なる\n自己満にしかならないわ。"},
        { "location": "225/SEL"   , "narrator": "", "text": "まあ確かに…"},
        { "location": "226/SEL"   , "narrator": "", "text": "$me$は司書と結婚したいんだ！"},
        { "location": "227/ACT"   , "narrator": "", "text": "まあ確かに…"},
        { "location": "228/TALK"  , "narrator": "ガブリエラ", "text": "はぁ…。\nまったくもう。"},
        { "location": "229/TALK"  , "narrator": "ガブリエラ", "text": "この忙しいときに、\nくだらないこと\n言ってないで。"},
        { "location": "230/ACT"   , "narrator": "", "text": "$me$は司書と結婚したいんだ！"},
        { "location": "233/TALK"  , "narrator": "ガブリエラ", "text": "え、ええええっ！？"},
        { "location": "234/TALK"  , "narrator": "ガブリエラ", "text": "そりゃあたしだって\n同じ気持ちだけど……"},
        { "location": "235/TALK"  , "narrator": "ガブリエラ", "text": "って、そうじゃなくて！\n今は早くマークスマンの\n所にいかないと！"},
        { "location": "236/SEL"   , "narrator": "", "text": "そうですね、すみません"},
        { "location": "237/SEL"   , "narrator": "", "text": "せめてウェディングドレスだけでも！"},
        { "location": "238/ACT"   , "narrator": "", "text": "そうですね、すみません"},
        { "location": "240/TALK"  , "narrator": "ガブリエラ", "text": "はぁ…。\nまったくもう。"},
        { "location": "241/TALK"  , "narrator": "ガブリエラ", "text": "この忙しいときに、\nくだらないこと\n言ってないで。"},
        { "location": "242/ACT"   , "narrator": "", "text": "せめてウェディングドレスだけでも！"},
        { "location": "244/TALK"  , "narrator": "ガブリエラ", "text": "はああああ！？"},
        { "location": "245/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "246/TALK"  , "narrator": "ガブリエラ", "text": "も、もう！\nわかったわよ！"},
        { "location": "259/TALK"  , "narrator": "ガブリエラ", "text": "はい！\nこれでいい？"},
        { "location": "260/SEL"   , "narrator": "", "text": "最高です！"},
        { "location": "261/SEL"   , "narrator": "", "text": "愛してる！"},
        { "location": "262/ACT"   , "narrator": "", "text": "最高です！"},
        { "location": "263/TALK"  , "narrator": "ガブリエラ", "text": "ほんとにもう…。"},
        { "location": "264/ACT"   , "narrator": "", "text": "最高です！"},
        { "location": "265/TALK"  , "narrator": "ガブリエラ", "text": "だ、だから！\nそれは現実のあたしに\n言ってよね？"},
        { "location": "266/TALK"  , "narrator": "ガブリエラ", "text": "もうベースは\n十分準備OKに\nなってるから！"},
        { "location": "269/TALK"  , "narrator": "ガブリエラ", "text": "式なんてやってる暇ない\nから、このままマークス\nマンの所へ行くわよ？"},
        { "location": "270/SEL"   , "narrator": "", "text": "それは正式なご挨拶と考えてよろしいか"},
        { "location": "271/ACT"   , "narrator": "", "text": "それは正式なご挨拶と考えてよろしいか"},
        { "location": "273/TALK"  , "narrator": "ガブリエラ", "text": "はいはい、\nよろしいよろしい。"},
        { "location": "279/TALK"  , "narrator": "ガブリエラ", "text": "それじゃ、\n扉を回すわね。"},
        { "location": "283/TALK"  , "narrator": "ガブリエラ", "text": "オープンプロセス、\n0xFA1番地から\nC3:7:CB1//1x0FF番地へ。"},
        { "location": "288/TALK"  , "narrator": "ガブリエラ", "text": "スピードアップ。"},
        { "location": "292/TALK"  , "narrator": "ガブリエラ", "text": "更に加速。"},
        { "location": "325/TALK"  , "narrator": "ガブリエラ", "text": "相変わらず\n酷い有様ね。"},
        { "location": "327/TALK"  , "narrator": "ガブリエラ", "text": "こっちよ。"},
        { "location": "336/TALK"  , "narrator": "ガブリエラ", "text": "…ここ。"},
        { "location": "337/SEL"   , "narrator": "", "text": "ここって…"},
        { "location": "338/ACT"   , "narrator": "", "text": "ここって…"},
        { "location": "340/TALK"  , "narrator": "ガブリエラ", "text": "大丈夫。\n取って食われたりは\nしないから。"},
        { "location": "341/TALK"  , "narrator": "ガブリエラ", "text": "既にここからでも\n感じるの。マークスマンの\n様子がおかしいってこと。"},
        { "location": "342/TALK"  , "narrator": "ガブリエラ", "text": "やっぱり、みやびの家での\n神楽の事件と、横須賀での\n発言が問題だったのかも。"},
        { "location": "343/TALK"  , "narrator": "ガブリエラ", "text": "あの時から、\nあたしは少しずつ\n変わってる気がするの。"},
        { "location": "344/TALK"  , "narrator": "ガブリエラ", "text": "$handle$は\nあたしを見ていて\nどう思う？"},
        { "location": "345/SEL"   , "narrator": "", "text": "とりあえずマークスマンについてもうちょっと詳しく教えて欲しい"},
        { "location": "346/SEL"   , "narrator": "", "text": "とりあえずガブリエラの実家に二人きりで来てることに感極まってる"},
        { "location": "347/ACT"   , "narrator": "", "text": "とりあえずマークスマンについてもうちょっと詳しく教えて欲しい"},
        { "location": "348/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "349/TALK"  , "narrator": "ガブリエラ", "text": "そうね。"},
        { "location": "350/TALK"  , "narrator": "ガブリエラ", "text": "確かに\nここまでつき合わせて\n秘密も何も無いものね。"},
        { "location": "351/TALK"  , "narrator": "ガブリエラ", "text": "マークスマンは、\nあたしたちの中の\nあたしたち。"},
        { "location": "352/TALK"  , "narrator": "ガブリエラ", "text": "あたしを形成する中でも\nもっとあたしという人間を\n色濃く作り出してる存在。"},
        { "location": "353/TALK"  , "narrator": "ガブリエラ", "text": "だから、あたしみたいな\n一人格がどうかなっても\n大した問題は無いけど――"},
        { "location": "354/TALK"  , "narrator": "ガブリエラ", "text": "マークスマンの考え方が\n変われば、あたしの性格は\n大きく変わるし――"},
        { "location": "355/TALK"  , "narrator": "ガブリエラ", "text": "マークスマンが発症すれば\nフェノメノンになる。"},
        { "location": "356/SEL"   , "narrator": "", "text": "それって、今ガブリエラたちが戦ってるフェノメノンのこと？"},
        { "location": "357/ACT"   , "narrator": "", "text": "それって、今ガブリエラたちが戦ってるフェノメノンのこと？"},
        { "location": "359/TALK"  , "narrator": "ガブリエラ", "text": "そうよ。"},
        { "location": "360/TALK"  , "narrator": "ガブリエラ", "text": "フェノメノン発症には\nとっても強い意志の力が\n必要なのよ。"},
        { "location": "361/TALK"  , "narrator": "ガブリエラ", "text": "それは、あたしみたいな\n下っ端が発症したところで\n作り出せるものじゃない。"},
        { "location": "362/TALK"  , "narrator": "ガブリエラ", "text": "だから、あたしが発症\nしてもココロの中で暴れる\nレベルだけど――"},
        { "location": "363/TALK"  , "narrator": "ガブリエラ", "text": "マークスマンが発症すれば\n現実に影響が出る。"},
        { "location": "364/TALK"  , "narrator": "ガブリエラ", "text": "まあ、ザックリとした\n説明になっちゃったけど、\nだいたいこんな感じね。"},
        { "location": "365/TALK"  , "narrator": "ガブリエラ", "text": "それじゃ、\n先へ進みましょ。"},
        { "location": "366/ACT"   , "narrator": "", "text": "とりあえずガブリエラの実家に二人きりで来てることに感極まってる"},
        { "location": "367/TALK"  , "narrator": "ガブリエラ", "text": "そうね。\nあたしも嬉しいけど。"},
        { "location": "368/TALK"  , "narrator": "ガブリエラ", "text": "でも、こんな壊れた\n家じゃなければ、\nもっと良かったのにね。"},
        { "location": "369/TALK"  , "narrator": "ガブリエラ", "text": "現実のあたしも、\n$handle$を家に\n招待すればいいのにね。"},
        { "location": "370/SEL"   , "narrator": "", "text": "旅費が大変そう"},
        { "location": "371/SEL"   , "narrator": "", "text": "お父様にご挨拶します"},
        { "location": "372/ACT"   , "narrator": "", "text": "旅費が大変そう"},
        { "location": "373/TALK"  , "narrator": "ガブリエラ", "text": "そこはほら、\n愛の力でクリアするのよ。"},
        { "location": "374/ACT"   , "narrator": "", "text": "お父様にご挨拶します"},
        { "location": "375/TALK"  , "narrator": "ガブリエラ", "text": "殺されるかも\nしれないけど。"},
        { "location": "376/SEL"   , "narrator": "", "text": "それ本当なの？"},
        { "location": "377/ACT"   , "narrator": "", "text": "それ本当なの？"},
        { "location": "379/TALK"  , "narrator": "ガブリエラ", "text": "冗談よ。"},
        { "location": "380/TALK"  , "narrator": "ガブリエラ", "text": "でも、常に臨戦状態で\n活動してる軍人だし――"},
        { "location": "381/TALK"  , "narrator": "ガブリエラ", "text": "ヘラヘラしてたら\n多分家からたたき出される\nと思うわよ？"},
        { "location": "382/TALK"  , "narrator": "ガブリエラ", "text": "タダでさえ、\nあたしもたたき出されてる\n身なんだから。"},
        { "location": "383/TALK"  , "narrator": "ガブリエラ", "text": "でも、二人でたたき\n出されたら、二人きりの\n自由を満喫できるわね！"},
        { "location": "385/TALK"  , "narrator": "ガブリエラ", "text": "……なんて冗談は\nさておき、\n先へ進まなくちゃ。"},
        { "location": "390/TALK"  , "narrator": "ガブリエラ", "text": "え…！？"},
        { "location": "391/TALK"  , "narrator": "ガブリエラの新司書　", "text": "ここから先は\n絶対に行かせはしない。"},
        { "location": "33/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>9月3日　 8:16 PM</color>\nアーヤの実家へ向かう途中、サービスエリア食堂にて"},
        { "location": "141/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
