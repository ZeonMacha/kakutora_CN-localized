    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "830_それがはじまり"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "あのね"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "長い話をしていいかしら"},
        { "location": "35/SEL"    , "narrator": "", "text": "いいよ"},
        { "location": "36/SEL"    , "narrator": "", "text": "いつもしてるでしょ"},
        { "location": "37/ACT"    , "narrator": "", "text": "いいよ"},
        { "location": "38/TALK"   , "narrator": "ガブリエラ", "text": "ええと"},
        { "location": "39/TALK"   , "narrator": "ガブリエラ", "text": "長いだけじゃなくて"},
        { "location": "40/ACT"    , "narrator": "", "text": "いつもしてるでしょ"},
        { "location": "41/TALK"   , "narrator": "ガブリエラ", "text": "ううん"},
        { "location": "42/TALK"   , "narrator": "ガブリエラ", "text": "いつもとは違う話なの"},
        { "location": "44/TALK"   , "narrator": "ガブリエラ", "text": "もしかしたら"},
        { "location": "45/TALK"   , "narrator": "ガブリエラ", "text": "$handle$が私のことを嫌いになっちゃうかもしれない話よ"},
        { "location": "47/SEL"    , "narrator": "", "text": "そんなことないよ"},
        { "location": "48/SEL"    , "narrator": "", "text": "覚悟して聞くね"},
        { "location": "49/ACT"    , "narrator": "", "text": "そんなことないよ"},
        { "location": "50/TALK"   , "narrator": "ガブリエラ", "text": "そうだといいけど"},
        { "location": "51/ACT"    , "narrator": "", "text": "覚悟して聞くね"},
        { "location": "52/TALK"   , "narrator": "ガブリエラ", "text": "うん"},
        { "location": "53/TALK"   , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "55/TALK"   , "narrator": "ガブリエラ", "text": "あのね"},
        { "location": "56/TALK"   , "narrator": "ガブリエラ", "text": "ポーランドは情勢不安っていうやつなの"},
        { "location": "57/TALK"   , "narrator": "ガブリエラ", "text": "だから私、小さい頃からライフルを習っていたわ"},
        { "location": "58/TALK"   , "narrator": "ガブリエラ", "text": "日本じゃ考えられないくらい治安が悪くて"},
        { "location": "59/TALK"   , "narrator": "ガブリエラ", "text": "ある日、強盗が家に入ったの"},
        { "location": "60/TALK"   , "narrator": "ガブリエラ", "text": "強盗はお父さんのことを知っていたから"},
        { "location": "61/TALK"   , "narrator": "ガブリエラ", "text": "その時動けるのは私だけだった"},
        { "location": "62/TALK"   , "narrator": "ガブリエラ", "text": "だから私、家族を守ろうとしたの"},
        { "location": "63/TALK"   , "narrator": "ガブリエラ", "text": "守ろうとしたのよ"},
        { "location": "65/SEL"    , "narrator": "", "text": "うん"},
        { "location": "66/SEL"    , "narrator": "", "text": "そうなんだ"},
        { "location": "69/ACT"    , "narrator": "", "text": "うん"},
        { "location": "70/ACT"    , "narrator": "", "text": "そうなんだ"},
        { "location": "72/TALK"   , "narrator": "ガブリエラ", "text": "だけど"},
        { "location": "73/TALK"   , "narrator": "ガブリエラ", "text": "私は結局おかあさんを"},
        { "location": "74/SEL"    , "narrator": "", "text": "それ以上は言わなくていい"},
        { "location": "75/TALK"   , "narrator": "ガブリエラ", "text": "私の狙いが外れて"},
        { "location": "76/TALK"   , "narrator": "ガブリエラ", "text": "銃弾は母親に当たってしまったのよ"},
        { "location": "80/ACT"    , "narrator": "", "text": "それ以上は言わなくていい"},
        { "location": "82/TALK"   , "narrator": "ガブリエラ", "text": "その後のことはあんまり覚えていないの"},
        { "location": "83/TALK"   , "narrator": "ガブリエラ", "text": "気が付いたらお父さんが私に笑いかけなくなっていたことと"},
        { "location": "84/TALK"   , "narrator": "ガブリエラ", "text": "男の人の前だと声が出なくなっていたこと"},
        { "location": "85/TALK"   , "narrator": "ガブリエラ", "text": "どれがどれと関係しているかはわからないんだけれど"},
        { "location": "86/TALK"   , "narrator": "ガブリエラ", "text": "たぶん"},
        { "location": "87/TALK"   , "narrator": "ガブリエラ", "text": "これが"},
        { "location": "88/TALK"   , "narrator": "ガブリエラ", "text": "全部の始まり"},
        { "location": "91/TALK"   , "narrator": "ガブリエラ", "text": "びっくりしたでしょう？"},
        { "location": "93/SEL"    , "narrator": "", "text": "うん、まあ"},
        { "location": "94/SEL"    , "narrator": "", "text": "辛かったよね"},
        { "location": "96/SEL"    , "narrator": "", "text": "そんなことがあったんだ"},
        { "location": "97/ACT"    , "narrator": "", "text": "うん、まあ"},
        { "location": "98/TALK"   , "narrator": "ガブリエラ", "text": "そうよね"},
        { "location": "99/TALK"   , "narrator": "ガブリエラ", "text": "私が怖くなったんじゃない？"},
        { "location": "101/SEL"   , "narrator": "", "text": "そんなことないよ"},
        { "location": "102/ACT"   , "narrator": "", "text": "そんなことないよ"},
        { "location": "103/TALK"  , "narrator": "ガブリエラ", "text": "そう・・・？"},
        { "location": "104/TALK"  , "narrator": "ガブリエラ", "text": "$handle$はへんなひとだわね"},
        { "location": "106/ACT"   , "narrator": "", "text": "辛かったよね"},
        { "location": "116/TALK"  , "narrator": "ガブリエラ", "text": "そうかもしれないわ"},
        { "location": "117/TALK"  , "narrator": "ガブリエラ", "text": "でも実を言うと、よくわからないの"},
        { "location": "119/SEL"   , "narrator": "", "text": "無理しなくていいよ"},
        { "location": "120/ACT"   , "narrator": "", "text": "無理しなくていいよ"},
        { "location": "121/TALK"  , "narrator": "ガブリエラ", "text": "無理じゃないのよ"},
        { "location": "122/TALK"  , "narrator": "ガブリエラ", "text": "どこか心が凍ったままになってるんだと思うのよ"},
        { "location": "124/ACT"   , "narrator": "", "text": "そんなことがあったんだ"},
        { "location": "125/TALK"  , "narrator": "ガブリエラ", "text": "そうなのよ"},
        { "location": "126/TALK"  , "narrator": "ガブリエラ", "text": "本当にあった話なのよ"},
        { "location": "128/SEL"   , "narrator": "", "text": "ごめん、知らなくて"},
        { "location": "129/ACT"   , "narrator": "", "text": "ごめん、知らなくて"},
        { "location": "130/TALK"  , "narrator": "ガブリエラ", "text": "いやだわ"},
        { "location": "131/TALK"  , "narrator": "ガブリエラ", "text": "私が言っていなかったんだもの、知らなくて当たり前なのよ"},
        { "location": "136/SEL"   , "narrator": "", "text": "うん"},
        { "location": "137/ACT"   , "narrator": "", "text": "うん"},
        { "location": "139/TALK"  , "narrator": "ガブリエラ", "text": "私はずるいわね"},
        { "location": "140/TALK"  , "narrator": "ガブリエラ", "text": "$handle$はこの話を聞いても私のことを嫌いにならないって思ったからこの話をしたのよ"},
        { "location": "142/SEL"   , "narrator": "", "text": "それでいい"},
        { "location": "143/SEL"   , "narrator": "", "text": "びっくりはしたけど"},
        { "location": "144/ACT"   , "narrator": "", "text": "それでいい"},
        { "location": "145/TALK"  , "narrator": "ガブリエラ", "text": "そう"},
        { "location": "146/TALK"  , "narrator": "ガブリエラ", "text": "なの？"},
        { "location": "147/ACT"   , "narrator": "", "text": "びっくりはしたけど"},
        { "location": "148/TALK"  , "narrator": "ガブリエラ", "text": "そう"},
        { "location": "149/TALK"  , "narrator": "ガブリエラ", "text": "よね"},
        { "location": "152/TALK"  , "narrator": "ガブリエラ", "text": "$handle$は"},
        { "location": "153/TALK"  , "narrator": "ガブリエラ", "text": "本当に"},
        { "location": "155/TALK"  , "narrator": "ガブリエラ", "text": "いいやつ、ね"},
        { "location": "112/DIALOG", "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>1000pt.</b></color></size>\nアップしました！"}
    ]
}
