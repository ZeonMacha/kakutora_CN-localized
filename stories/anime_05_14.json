    "entry":
    [
        { "location": "888/SCENARIO", "narrator": "", "text": "アニメ第14話"},
        { "location": "902/TALK"    , "narrator": "千羽鶴", "text": "ごきげんよう、\n$handle$。"},
        { "location": "903/TALK"    , "narrator": "千羽鶴", "text": "もう一度\n私との会話を\n再現する？"},
        { "location": "904/SEL"     , "narrator": "", "text": "はい"},
        { "location": "905/SEL"     , "narrator": "", "text": "いいえ"},
        { "location": "906/SEL"     , "narrator": "", "text": "にゃボットの解説だけ聞く"},
        { "location": "907/ACT"     , "narrator": "", "text": "はい"},
        { "location": "908/TALK"    , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "910/ACT"     , "narrator": "", "text": "いいえ"},
        { "location": "911/TALK"    , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "913/ACT"     , "narrator": "", "text": "にゃボットの解説だけ聞く"},
        { "location": "914/TALK"    , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "921/TALK"    , "narrator": "千羽鶴", "text": "今回は別に\n来る必要も無いところ。"},
        { "location": "922/TALK"    , "narrator": "千羽鶴", "text": "これから\nちょっとしたゲームを\nする予定だけど――"},
        { "location": "923/TALK"    , "narrator": "千羽鶴", "text": "貴方を不快に\nさせるだけだし、\n帰った方がいいと思う。"},
        { "location": "924/SEL"     , "narrator": "", "text": "帰ります"},
        { "location": "925/SEL"     , "narrator": "", "text": "やっていく"},
        { "location": "926/ACT"     , "narrator": "", "text": "帰ります"},
        { "location": "928/TALK"    , "narrator": "千羽鶴", "text": "それがいいと思う。"},
        { "location": "929/TALK"    , "narrator": "千羽鶴", "text": "このエピソードは\n見なくても次の\nエピソードに進めるから。"},
        { "location": "930/TALK"    , "narrator": "千羽鶴", "text": "だから安心して\n次に進んで欲しい。"},
        { "location": "932/ACT"     , "narrator": "", "text": "やっていく"},
        { "location": "933/TALK"    , "narrator": "千羽鶴", "text": "もの凄く不快になると\n思うけど、いい？"},
        { "location": "934/TALK"    , "narrator": "千羽鶴", "text": "なぜなら、多分\n私の自制が効かなくて\nめちゃはしゃぐから。"},
        { "location": "935/TALK"    , "narrator": "千羽鶴", "text": "それでもいいなら\nやっていくといい。"},
        { "location": "936/SEL"     , "narrator": "", "text": "帰ります"},
        { "location": "937/SEL"     , "narrator": "", "text": "やっていく"},
        { "location": "938/ACT"     , "narrator": "", "text": "帰ります"},
        { "location": "940/ACT"     , "narrator": "", "text": "やっていく"},
        { "location": "941/TALK"    , "narrator": "千羽鶴", "text": "……わかった。"},
        { "location": "942/TALK"    , "narrator": "千羽鶴", "text": "どういう理由かは\nわからないけど、\nそこまで言うなら――"},
        { "location": "943/TALK"    , "narrator": "千羽鶴", "text": "嫌悪感で気持ち悪く\nならないように、\nまずは気合いを入れて。"},
        { "location": "944/TALK"    , "narrator": "千羽鶴", "text": "それじゃ――"},
        { "location": "951/TALK"    , "narrator": "千羽鶴", "text": "<size=40>どーん！</size>"},
        { "location": "952/TALK"    , "narrator": "千羽鶴", "text": "というわけで、\n今回は特別回！"},
        { "location": "953/SEL"     , "narrator": "", "text": "千羽鶴キター"},
        { "location": "954/SEL"     , "narrator": "", "text": "何やるの？"},
        { "location": "955/ACT"     , "narrator": "", "text": "千羽鶴キター"},
        { "location": "956/ACT"     , "narrator": "", "text": "何やるの？"},
        { "location": "962/TALK"    , "narrator": "千羽鶴", "text": "<size=35><color=red>トライナリー\nクイズ大会！</color></size>"},
        { "location": "963/SEL"     , "narrator": "", "text": "ドンドンパフパフ！"},
        { "location": "964/SEL"     , "narrator": "", "text": "名前が直球すぎじゃね？"},
        { "location": "965/SEL"     , "narrator": "", "text": "そんな事やってる暇あんの？"},
        { "location": "966/ACT"     , "narrator": "", "text": "ドンドンパフパフ！"},
        { "location": "968/ACT"     , "narrator": "", "text": "名前が直球すぎじゃね？"},
        { "location": "969/TALK"    , "narrator": "千羽鶴", "text": "黙れ。"},
        { "location": "970/ACT"     , "narrator": "", "text": "そんな事やってる暇あんの？"},
        { "location": "971/TALK"    , "narrator": "千羽鶴", "text": "今回はMV回。\nMV回はTRI-OSが\nガベコレする時間。"},
        { "location": "972/SEL"     , "narrator": "", "text": "そうだったの！？"},
        { "location": "973/SEL"     , "narrator": "", "text": "ガベコレってなに？"},
        { "location": "974/ACT"     , "narrator": "", "text": "そうだったの！？"},
        { "location": "975/TALK"    , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "976/ACT"     , "narrator": "", "text": "ガベコレってなに？"},
        { "location": "977/TALK"    , "narrator": "千羽鶴", "text": "ガベージコレクション。\nシステムの最適化と\nゴミ捨てをする時間。"},
        { "location": "979/TALK"    , "narrator": "千羽鶴", "text": "だから、ろくに何の機能も\n動かないし、未来に対して\nアプローチもできない。"},
        { "location": "983/TALK"    , "narrator": "千羽鶴", "text": "<color=red><size=40>遊ぶが吉！</size></color>"},
        { "location": "984/TALK"    , "narrator": "千羽鶴", "text": "人生ゆとりもまた\n必要だと思う。"},
        { "location": "985/TALK"    , "narrator": "千羽鶴", "text": "古人だって源平合戦の合間\nですら『扇の的』ゲームの\nような余興を楽しんだ程！"},
        { "location": "986/SEL"     , "narrator": "", "text": "うむ、確かに"},
        { "location": "987/SEL"     , "narrator": "", "text": "いや、あれ割とエグい話だよ？"},
        { "location": "988/ACT"     , "narrator": "", "text": "うむ、確かに"},
        { "location": "989/ACT"     , "narrator": "", "text": "いや、あれ割とエグい話だよ？"},
        { "location": "991/TALK"    , "narrator": "千羽鶴", "text": "揚げ足とりめ。"},
        { "location": "992/TALK"    , "narrator": "千羽鶴", "text": "べーだ。"},
        { "location": "993/TALK"    , "narrator": "千羽鶴", "text": "そこは空気読んで\n同意するところだから。"},
        { "location": "997/TALK"    , "narrator": "千羽鶴", "text": "というわけで、\n早速だけどルールと賞品の\n説明をする。"},
        { "location": "998/TALK"    , "narrator": "千羽鶴", "text": "ルールは簡単。"},
        { "location": "999/TALK"    , "narrator": "千羽鶴", "text": "全部で１０問の問題に\n解答し、全問正解した\n方には賞品が出る。"},
        { "location": "1000/SEL"    , "narrator": "", "text": "賞品ってなに？"},
        { "location": "1001/SEL"    , "narrator": "", "text": "賞品ってまさか……"},
        { "location": "1002/ACT"    , "narrator": "", "text": "賞品ってなに？"},
        { "location": "1003/ACT"    , "narrator": "", "text": "賞品ってまさか……"},
        { "location": "1004/TALK"   , "narrator": "千羽鶴", "text": "何か知っていそうな聡い\n貴方の反応を無視し、ドヤ\n顔で発表させてもらう。"},
        { "location": "1006/TALK"   , "narrator": "千羽鶴", "text": "全問正解者には――"},
        { "location": "1015/TALK"   , "narrator": "千羽鶴", "text": "鬼才國政領火博士制作、\n多足ロボットにゃボットが\n育てられる連載型クラン！"},
        { "location": "1016/TALK"   , "narrator": "千羽鶴", "text": "<color=green>定期刊クラン誌\n『にゃぼにゃすティー』\n第一巻</color>をプレゼント！"},
        { "location": "1020/SEL"    , "narrator": "", "text": "にゃボットキター！"},
        { "location": "1021/SEL"    , "narrator": "", "text": "にゃボットってなに？"},
        { "location": "1022/ACT"    , "narrator": "", "text": "にゃボットキター！"},
        { "location": "1023/TALK"   , "narrator": "千羽鶴", "text": "そう、来た。"},
        { "location": "1024/TALK"   , "narrator": "千羽鶴", "text": "にゃぼにゃすティーには\n１巻につき１体の\nにゃボットがついてくる。"},
        { "location": "1025/TALK"   , "narrator": "千羽鶴", "text": "全5巻にわたるその全てを\nコンプリートすれば、\n４凸にゃボットになる！"},
        { "location": "1026/TALK"   , "narrator": "千羽鶴", "text": "だから頑張って\nクイズに答えて、\n第一巻をゲットしてみて。"},
        { "location": "1027/ACT"    , "narrator": "", "text": "にゃボットってなに？"},
        { "location": "1028/TALK"   , "narrator": "千羽鶴", "text": "にゃボットは\n國政領火が制作した\nネコ型ロボット。"},
        { "location": "1029/TALK"   , "narrator": "千羽鶴", "text": "特徴は、\n足が８本あること。"},
        { "location": "1030/TALK"   , "narrator": "千羽鶴", "text": "本人曰く――"},
        { "location": "1031/TALK"   , "narrator": "千羽鶴", "text": "『最も画期的かつ実用的で\n可愛さもギュッと詰まった\n多目的クモ型にゃボット』"},
        { "location": "1032/TALK"   , "narrator": "千羽鶴", "text": "……とのこと。"},
        { "location": "1033/TALK"   , "narrator": "千羽鶴", "text": "制作に至る経緯は、\n実妹である國政綾水に\nプレゼントする為だとか。"},
        { "location": "1034/TALK"   , "narrator": "千羽鶴", "text": "國政綾水の\nココロスフィアを見ると、\nエピソードが見られる。"},
        { "location": "1036/TALK"   , "narrator": "千羽鶴", "text": "というわけだから、\nにゃボット目指し全問\n正解に挑戦して欲しい！"},
        { "location": "1039/TALK"   , "narrator": "千羽鶴", "text": "それでは早速、\nクイズを開始する。"},
        { "location": "1040/TALK"   , "narrator": "千羽鶴", "text": "問題は全部で１０問。\n何問正解したかは、\n終了時に点数で告知する。"},
        { "location": "1041/TALK"   , "narrator": "千羽鶴", "text": "要するに、途中どこで\n間違えたかはわからない\n仕組みになっている。"},
        { "location": "1044/TALK"   , "narrator": "千羽鶴", "text": "<size=40>鬼畜仕様！</size>"},
        { "location": "1045/SEL"    , "narrator": "", "text": "自分で言うな！"},
        { "location": "1046/SEL"    , "narrator": "", "text": "お、おう"},
        { "location": "1047/ACT"    , "narrator": "", "text": "自分で言うな！"},
        { "location": "1048/TALK"   , "narrator": "千羽鶴", "text": "自分で言わねば\n誰が言う！！"},
        { "location": "1049/ACT"    , "narrator": "", "text": "お、おう"},
        { "location": "1051/TALK"   , "narrator": "千羽鶴", "text": "というわけで――"},
        { "location": "1054/TALK"   , "narrator": "千羽鶴", "text": "第一問！"},
        { "location": "1055/TALK"   , "narrator": "千羽鶴", "text": "トライナリーの\n正式名称は？"},
        { "location": "1056/SEL"    , "narrator": "", "text": "総務省情報管理庁管轄特殊戦略隊群拡張現実特別攻撃隊"},
        { "location": "1057/SEL"    , "narrator": "", "text": "総務省情報管理庁管轄拡張現実特殊戦略隊群ぷりちーぬ親衛隊"},
        { "location": "1058/SEL"    , "narrator": "", "text": "総務省情報管理庁管轄拡張現実特殊戦略隊群特別攻撃隊"},
        { "location": "1059/ACT"    , "narrator": "", "text": "総務省情報管理庁管轄特殊戦略隊群拡張現実特別攻撃隊"},
        { "location": "1060/ACT"    , "narrator": "", "text": "総務省情報管理庁管轄拡張現実特殊戦略隊群ぷりちーぬ親衛隊"},
        { "location": "1061/TALK"   , "narrator": "千羽鶴", "text": "あっ！"},
        { "location": "1062/TALK"   , "narrator": "千羽鶴", "text": "……なんでもない。"},
        { "location": "1063/ACT"    , "narrator": "", "text": "総務省情報管理庁管轄拡張現実特殊戦略隊群特別攻撃隊"},
        { "location": "1067/TALK"   , "narrator": "千羽鶴", "text": "第二問！"},
        { "location": "1068/TALK"   , "narrator": "千羽鶴", "text": "逢瀬つばめの初上京、\n5/3 FreyMENOWライブ\n当日の交通手段は？"},
        { "location": "1069/SEL"    , "narrator": "", "text": "東海道線鈍行掛川→熱海→（グリーン車）→品川→目黒→後楽園"},
        { "location": "1070/SEL"    , "narrator": "", "text": "東海道新幹線掛川→東京→後楽園"},
        { "location": "1071/SEL"    , "narrator": "", "text": "東海道線鈍行掛川→名古屋→セントレア→羽田→品川→目黒→後楽園"},
        { "location": "1072/ACT"    , "narrator": "", "text": "東海道線鈍行掛川→熱海→（グリーン車）→品川→目黒→後楽園"},
        { "location": "1075/ACT"    , "narrator": "", "text": "東海道新幹線掛川→東京→後楽園"},
        { "location": "1076/ACT"    , "narrator": "", "text": "東海道線鈍行掛川→名古屋→セントレア→羽田→品川→目黒→後楽園"},
        { "location": "1078/TALK"   , "narrator": "千羽鶴", "text": "第三問！"},
        { "location": "1079/TALK"   , "narrator": "千羽鶴", "text": "國政綾水の剣道ジュニア\n世界選手権大会で優勝した\n時の開催地は？"},
        { "location": "1080/SEL"    , "narrator": "", "text": "NAGANO"},
        { "location": "1081/SEL"    , "narrator": "", "text": "TOKYO"},
        { "location": "1082/SEL"    , "narrator": "", "text": "WARSAW"},
        { "location": "1089/TALK"   , "narrator": "千羽鶴", "text": "第四問！"},
        { "location": "1090/TALK"   , "narrator": "千羽鶴", "text": "ガブリエラの大好きな\nカフェ「むぎまる」の\n大好きまんぢうは？"},
        { "location": "1091/SEL"    , "narrator": "", "text": "珈琲まん"},
        { "location": "1092/SEL"    , "narrator": "", "text": "紅茶まん"},
        { "location": "1093/SEL"    , "narrator": "", "text": "緑茶まん"},
        { "location": "1094/ACT"    , "narrator": "", "text": "珈琲まん"},
        { "location": "1095/ACT"    , "narrator": "", "text": "紅茶まん"},
        { "location": "1098/ACT"    , "narrator": "", "text": "緑茶まん"},
        { "location": "1100/TALK"   , "narrator": "千羽鶴", "text": "第五問！"},
        { "location": "1101/TALK"   , "narrator": "千羽鶴", "text": "恋ヶ崎みやびが所有する\nスーパーコンピューターの\n名前は？"},
        { "location": "1102/SEL"    , "narrator": "", "text": "最愛棒"},
        { "location": "1103/SEL"    , "narrator": "", "text": "不思議ちゃん"},
        { "location": "1104/SEL"    , "narrator": "", "text": "不可思議ちゃん"},
        { "location": "1105/ACT"    , "narrator": "", "text": "最愛棒"},
        { "location": "1106/ACT"    , "narrator": "", "text": "不思議ちゃん"},
        { "location": "1107/ACT"    , "narrator": "", "text": "不可思議ちゃん"},
        { "location": "1111/TALK"   , "narrator": "千羽鶴", "text": "第六問！"},
        { "location": "1112/TALK"   , "narrator": "千羽鶴", "text": "卯月神楽が大好きな\nラノベといえば！"},
        { "location": "1113/SEL"    , "narrator": "", "text": "お兄ちゃんがダダこねるから魔法学校落第しちゃったテヘペロ"},
        { "location": "1114/SEL"    , "narrator": "", "text": "妹がダダこねるから魔法学校落第しちゃったテヘペロ"},
        { "location": "1115/SEL"    , "narrator": "", "text": "お兄ちゃんが魔法学校落第したから妹がペロペロしたった"},
        { "location": "1116/ACT"    , "narrator": "", "text": "お兄ちゃんがダダこねるから魔法学校落第しちゃったテヘペロ"},
        { "location": "1117/ACT"    , "narrator": "", "text": "妹がダダこねるから魔法学校落第しちゃったテヘペロ"},
        { "location": "1120/ACT"    , "narrator": "", "text": "お兄ちゃんが魔法学校落第したから妹がペロペロしたった"},
        { "location": "1122/TALK"   , "narrator": "千羽鶴", "text": "第七問！"},
        { "location": "1123/TALK"   , "narrator": "千羽鶴", "text": "逢瀬つばめの友人である\n繭と雛それぞれの趣味は？"},
        { "location": "1124/SEL"    , "narrator": "", "text": "ゾンビと艦船"},
        { "location": "1125/SEL"    , "narrator": "", "text": "プログラムとダイヤグラム"},
        { "location": "1126/SEL"    , "narrator": "", "text": "メイドカフェと鉄塔登り"},
        { "location": "1127/ACT"    , "narrator": "", "text": "ゾンビと艦船"},
        { "location": "1128/ACT"    , "narrator": "", "text": "プログラムとダイヤグラム"},
        { "location": "1131/ACT"    , "narrator": "", "text": "メイドカフェと鉄塔登り"},
        { "location": "1133/TALK"   , "narrator": "千羽鶴", "text": "第八問！"},
        { "location": "1134/TALK"   , "narrator": "千羽鶴", "text": "國政綾水の友人である\n倉沢小夜の、\n本人が認めない真実は？"},
        { "location": "1135/SEL"    , "narrator": "", "text": "寝起きが凶暴"},
        { "location": "1136/SEL"    , "narrator": "", "text": "子供嫌い"},
        { "location": "1137/SEL"    , "narrator": "", "text": "大食漢"},
        { "location": "1138/ACT"    , "narrator": "", "text": "寝起きが凶暴"},
        { "location": "1139/ACT"    , "narrator": "", "text": "子供嫌い"},
        { "location": "1140/ACT"    , "narrator": "", "text": "大食漢"},
        { "location": "1144/TALK"   , "narrator": "千羽鶴", "text": "第九問！"},
        { "location": "1145/TALK"   , "narrator": "千羽鶴", "text": "隊長、東雲真幌の持つ\nプロ級の特技は？"},
        { "location": "1146/SEL"    , "narrator": "", "text": "変装"},
        { "location": "1147/SEL"    , "narrator": "", "text": "催眠術"},
        { "location": "1148/SEL"    , "narrator": "", "text": "手品"},
        { "location": "1149/ACT"    , "narrator": "", "text": "変装"},
        { "location": "1152/ACT"    , "narrator": "", "text": "催眠術"},
        { "location": "1153/ACT"    , "narrator": "", "text": "手品"},
        { "location": "1155/TALK"   , "narrator": "千羽鶴", "text": "第十問！"},
        { "location": "1156/TALK"   , "narrator": "千羽鶴", "text": "ちーの\nココロのペットといえば！"},
        { "location": "1157/SEL"    , "narrator": "", "text": "ちー太郎"},
        { "location": "1158/SEL"    , "narrator": "", "text": "ちーすけ"},
        { "location": "1159/SEL"    , "narrator": "", "text": "ちーず"},
        { "location": "1160/ACT"    , "narrator": "", "text": "ちー太郎"},
        { "location": "1161/ACT"    , "narrator": "", "text": "ちーすけ"},
        { "location": "1164/ACT"    , "narrator": "", "text": "ちーず"},
        { "location": "1170/TALK"   , "narrator": "千羽鶴", "text": "<size=40>終了！</size>"},
        { "location": "1171/TALK"   , "narrator": "千羽鶴", "text": "というわけで、\n１０問全て回答した\nわけだけど――"},
        { "location": "1172/TALK"   , "narrator": "千羽鶴", "text": "感触としてはどう？"},
        { "location": "1173/SEL"    , "narrator": "", "text": "完璧！"},
        { "location": "1174/SEL"    , "narrator": "", "text": "一部自信ない"},
        { "location": "1175/SEL"    , "narrator": "", "text": "わかるかこんなの！！"},
        { "location": "1176/ACT"    , "narrator": "", "text": "完璧！"},
        { "location": "1177/TALK"   , "narrator": "千羽鶴", "text": "素敵。"},
        { "location": "1178/TALK"   , "narrator": "千羽鶴", "text": "後に落胆に変わらない\nことを祈ってる。"},
        { "location": "1179/ACT"    , "narrator": "", "text": "一部自信ない"},
        { "location": "1180/TALK"   , "narrator": "千羽鶴", "text": "人間みんな\nそんなもの。"},
        { "location": "1181/TALK"   , "narrator": "千羽鶴", "text": "そんな時でも、\n当たるときは当たる。"},
        { "location": "1182/ACT"    , "narrator": "", "text": "わかるかこんなの！！"},
        { "location": "1183/TALK"   , "narrator": "千羽鶴", "text": "一応全部、アプリの\n記録映像かエピソードに\n出てきていた話だけど。"},
        { "location": "1185/TALK"   , "narrator": "千羽鶴", "text": "というわけで、\n早速貴方の得点を\n発表する。"},
        { "location": "1186/TALK"   , "narrator": "千羽鶴", "text": "貴方の得点は――"},
        { "location": "1193/TALK"   , "narrator": "千羽鶴", "text": "<size=40>$qiiz_seikai$点！</size>"},
        { "location": "1194/TALK"   , "narrator": "千羽鶴", "text": "おめでとう！\n$handle$。"},
        { "location": "1195/TALK"   , "narrator": "千羽鶴", "text": "貴方は見事、第１回\nトライナリークイズの\n全問正解者になった！"},
        { "location": "1196/TALK"   , "narrator": "千羽鶴", "text": "というわけで、\n約束通りにゃボットを\n進呈するけど――"},
        { "location": "1197/TALK"   , "narrator": "千羽鶴", "text": "その前にCM。"},
        { "location": "1200/TALK"   , "narrator": "千羽鶴", "text": "<size=40>$qiiz_seikai$点！</size>"},
        { "location": "1201/TALK"   , "narrator": "千羽鶴", "text": "惜しい！！！"},
        { "location": "1202/TALK"   , "narrator": "千羽鶴", "text": "あともう少しで\n全問正解だったのに！"},
        { "location": "1203/TALK"   , "narrator": "千羽鶴", "text": "冷め止まぬうちに、\nもう一度挑戦してみる？"},
        { "location": "1205/SEL"    , "narrator": "", "text": "挑戦する！"},
        { "location": "1206/SEL"    , "narrator": "", "text": "もういいです"},
        { "location": "1207/ACT"    , "narrator": "", "text": "挑戦する！"},
        { "location": "1208/TALK"   , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "1209/TALK"   , "narrator": "千羽鶴", "text": "それではリトライを\n開始する！"},
        { "location": "1212/ACT"    , "narrator": "", "text": "もういいです"},
        { "location": "1213/TALK"   , "narrator": "千羽鶴", "text": "そう。わかった。"},
        { "location": "1214/TALK"   , "narrator": "千羽鶴", "text": "気が向いたらまた\n遊びに来て。"},
        { "location": "1215/TALK"   , "narrator": "千羽鶴", "text": "このクイズをクリアしなく\nても、先のエピソードには\n進めるから。"},
        { "location": "1216/TALK"   , "narrator": "千羽鶴", "text": "安心して\nスルーして欲しい。"},
        { "location": "1217/TALK"   , "narrator": "千羽鶴", "text": "それじゃ。"},
        { "location": "1222/TALK"   , "narrator": "千羽鶴", "text": "<size=40>$qiiz_seikai$点！</size>"},
        { "location": "1223/TALK"   , "narrator": "千羽鶴", "text": "あー。"},
        { "location": "1224/TALK"   , "narrator": "千羽鶴", "text": "これは致命的。"},
        { "location": "1225/TALK"   , "narrator": "千羽鶴", "text": "わりと普通に\n関わっていれば\nわかる問題だと思うけど。"},
        { "location": "1226/TALK"   , "narrator": "千羽鶴", "text": "まあ、何かの\n勘違いをしていたという\n事もあるかもしれない。"},
        { "location": "1227/TALK"   , "narrator": "千羽鶴", "text": "とりあえず、\nもう一度やってみる？"},
        { "location": "1232/SEL"    , "narrator": "", "text": "映像を見る\n<color=green>【高画質/75MB 4:55】</color>"},
        { "location": "1233/SEL"    , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/24MB 4:55】</color>"},
        { "location": "1234/SEL"    , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "1235/ACT"    , "narrator": "", "text": "映像を見る\n<color=green>【高画質/75MB 4:55】</color>"},
        { "location": "1242/ACT"    , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/24MB 4:55】</color>"},
        { "location": "1249/ACT"    , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "1283/TALK"   , "narrator": "千羽鶴", "text": "というわけで！"},
        { "location": "1286/TALK"   , "narrator": "千羽鶴", "text": "賞品授与式を\n執り行います！"},
        { "location": "1287/TALK"   , "narrator": "千羽鶴", "text": "尚、賞品の授与は、\n世界的に著名な\n量子研究家であり――"},
        { "location": "1288/TALK"   , "narrator": "千羽鶴", "text": "にゃボットの生みの親でも\nある、國政領火博士に\nお願いしたいと思います。"},
        { "location": "1302/TALK"   , "narrator": "エリカ", "text": "コーンコン。\nみなさんこんにちは、\n國政領火です！"},
        { "location": "1308/TALK"   , "narrator": "エリカ", "text": "連載クラン\nにゃぼにゃすティー！\nゲットおめでとう！"},
        { "location": "1309/TALK"   , "narrator": "エリカ", "text": "これからも５回にわたり\nにゃボットをお届けする\n予定だよ。"},
        { "location": "1310/TALK"   , "narrator": "エリカ", "text": "頑張って集めてね！"},
        { "location": "1314/TALK"   , "narrator": "エリカ", "text": "というわけで、\nこのコーナーが\n何なのかというと――"},
        { "location": "1315/TALK"   , "narrator": "エリカ", "text": "実は、連載クラン\nにゃぼにゃすティー！の\n本誌に当たる部分なの。"},
        { "location": "1316/SEL"    , "narrator": "", "text": "というと？"},
        { "location": "1317/ACT"    , "narrator": "", "text": "というと？"},
        { "location": "1319/TALK"   , "narrator": "エリカ", "text": "要するに！"},
        { "location": "1320/TALK"   , "narrator": "エリカ", "text": "にゃぼにゃすティー！\nバンドルのクラン、\nにゃボットについて――"},
        { "location": "1321/TALK"   , "narrator": "エリカ", "text": "解説しちゃう\nコーナーなんです！"},
        { "location": "1322/SEL"    , "narrator": "", "text": "わーい！"},
        { "location": "1323/SEL"    , "narrator": "", "text": "結構です"},
        { "location": "1324/ACT"    , "narrator": "", "text": "わーい！"},
        { "location": "1325/TALK"   , "narrator": "エリカ", "text": "良かった、\n喜んでくれて。"},
        { "location": "1326/TALK"   , "narrator": "エリカ", "text": "やっぱりこれ系には\n解説冊子がなくちゃ\n片手落ちだもんね！"},
        { "location": "1331/TALK"   , "narrator": "エリカ", "text": "にゃボットは、\n実はもうかなり昔に\n作ったロボットなんだ。"},
        { "location": "1332/TALK"   , "narrator": "エリカ", "text": "綾ちゃんが高校生だった\n頃だから、既に４～５年も\n前になるかな。"},
        { "location": "1333/TALK"   , "narrator": "エリカ", "text": "あの頃からずっと\nチューニングを繰り返して\n今の形になってるけど――"},
        { "location": "1334/TALK"   , "narrator": "エリカ", "text": "当時とは比べものに\nならないくらい、\n高性能になったんだよ！"},
        { "location": "1335/TALK"   , "narrator": "エリカ", "text": "そんなにゃボットについて\n多角的に解説を\nしたいと思います！"},
        { "location": "1336/TALK"   , "narrator": "エリカ", "text": "興味有る項目を選んでね。"},
        { "location": "1341/SEL"    , "narrator": "", "text": "歩行性能について"},
        { "location": "1342/SEL"    , "narrator": "", "text": "多脚機能について"},
        { "location": "1343/SEL"    , "narrator": "", "text": "ボイスについて"},
        { "location": "1344/SEL"    , "narrator": "", "text": "AIについて"},
        { "location": "1345/SEL"    , "narrator": "", "text": "尻尾について"},
        { "location": "1346/SEL"    , "narrator": "", "text": "猫の顔について"},
        { "location": "1347/SEL"    , "narrator": "", "text": "もういいです…"},
        { "location": "1348/ACT"    , "narrator": "", "text": "歩行性能について"},
        { "location": "1353/TALK"   , "narrator": "エリカ", "text": "当初は時速1km/hにも\n満たなかったけど、\n今では最高３５km/h！"},
        { "location": "1354/TALK"   , "narrator": "エリカ", "text": "もちろんこれは、\n傾斜の無い舗装道路での\n実測値だけど――"},
        { "location": "1355/TALK"   , "narrator": "エリカ", "text": "今は、瓦礫の上でも\n時速４０km/hをキープ\n出来るよう改良中だよ。"},
        { "location": "1356/TALK"   , "narrator": "エリカ", "text": "これだけ早く走ることが\nできれば、活躍のシーンは\n飛躍的に増大するよね。"},
        { "location": "1357/TALK"   , "narrator": "エリカ", "text": "小型特殊自動車として\n普通に道路を走れるように\nなれば更に活躍できるね！"},
        { "location": "1358/TALK"   , "narrator": "エリカ", "text": "あっ、でも小型特殊って\n時速３５km/hまでだから、\nそれ超えるとどうなる？"},
        { "location": "1359/TALK"   , "narrator": "エリカ", "text": "誰か詳しい人、教えて！"},
        { "location": "1360/TALK"   , "narrator": "エリカ", "text": "他は？"},
        { "location": "1362/ACT"    , "narrator": "", "text": "多脚機能について"},
        { "location": "1367/TALK"   , "narrator": "エリカ", "text": "にゃボットには\n８足モードと\n４足モードがあるの。"},
        { "location": "1368/TALK"   , "narrator": "エリカ", "text": "４足モードの時は、\n真ん中の４足だけで\n歩行をするよ。"},
        { "location": "1369/TALK"   , "narrator": "エリカ", "text": "前後の４足は、腕のように\n物を掴んだり操作したり\n出来るんだよ。"},
        { "location": "1370/TALK"   , "narrator": "エリカ", "text": "これらはプログラムで\nいくらでも機能拡張\nできるから――"},
        { "location": "1371/TALK"   , "narrator": "エリカ", "text": "組み方では右足４本で\n歩行して左足４本は\n腕にするとか――"},
        { "location": "1372/TALK"   , "narrator": "エリカ", "text": "後ろ足２本で歩いて\n前足６本は腕にするとか。\nそういうのも出来るよ。"},
        { "location": "1373/TALK"   , "narrator": "エリカ", "text": "みやびちゃんあたりが\nバリエーション増やして\nくれると嬉しいな。"},
        { "location": "1374/TALK"   , "narrator": "エリカ", "text": "他は？"},
        { "location": "1376/ACT"    , "narrator": "", "text": "ボイスについて"},
        { "location": "1381/TALK"   , "narrator": "エリカ", "text": "にゃボットは普通に\n喋ることができるよ。"},
        { "location": "1382/TALK"   , "narrator": "エリカ", "text": "音声合成だから、\nあまり自然には\n喋れないけど――"},
        { "location": "1383/TALK"   , "narrator": "エリカ", "text": "でも実は、知られざる\n機能として、猫の鳴き声は\n沢山収録してあるんだ。"},
        { "location": "1384/TALK"   , "narrator": "エリカ", "text": "96Khzサンプリングで\n32GBフラッシュメモリに\nみっちり入ってるよ。"},
        { "location": "1385/TALK"   , "narrator": "エリカ", "text": "このフラッシュメモリは\n音声専用のメモリで、\n付替可能になってるの。"},
        { "location": "1386/TALK"   , "narrator": "エリカ", "text": "フォーマットを合わせて\n録音すれば、声色を変える\nことも出来るよ！"},
        { "location": "1387/TALK"   , "narrator": "エリカ", "text": "頑張れば、あなたの声で\n喋るにゃボットも\n作ることができるかも。"},
        { "location": "1388/TALK"   , "narrator": "エリカ", "text": "他は？"},
        { "location": "1390/ACT"    , "narrator": "", "text": "AIについて"},
        { "location": "1395/TALK"   , "narrator": "エリカ", "text": "にゃボットには\n量子AIが入ってるよ。"},
        { "location": "1396/TALK"   , "narrator": "エリカ", "text": "昔は学習型AIだったから\n無駄に重くてヘンなこと\nばかりしてたけど――"},
        { "location": "1397/TALK"   , "narrator": "エリカ", "text": "最新はそれなりに\nお利口になったんだ。"},
        { "location": "1398/TALK"   , "narrator": "エリカ", "text": "コタツの中で\nゴロゴロしないでって\n言えば従うし――"},
        { "location": "1399/TALK"   , "narrator": "エリカ", "text": "液漏れしたら砂場に\n行くように指示したのを、\n今でも守ってくれてるよ。"},
        { "location": "1400/TALK"   , "narrator": "エリカ", "text": "他は？"},
        { "location": "1402/ACT"    , "narrator": "", "text": "尻尾について"},
        { "location": "1407/TALK"   , "narrator": "エリカ", "text": "尻尾は確か24節の\nフレキシブルアーム\nだったかな。"},
        { "location": "1408/TALK"   , "narrator": "エリカ", "text": "先っぽには多機能\nレーザー出力装置が\nついているよ。"},
        { "location": "1409/TALK"   , "narrator": "エリカ", "text": "これはレーザーの出力と\n指向性を自由に変える\nことができるから――"},
        { "location": "1410/TALK"   , "narrator": "エリカ", "text": "ライトにできたり\nレーザーナイフにできたり\n色々使い道があるの。"},
        { "location": "1411/TALK"   , "narrator": "エリカ", "text": "もっと出力を上げれば\nレーザー銃にもなるけど、\nリミッタを掛けてあるよ。"},
        { "location": "1412/TALK"   , "narrator": "エリカ", "text": "他は？"},
        { "location": "1414/ACT"    , "narrator": "", "text": "猫の顔について"},
        { "location": "1419/TALK"   , "narrator": "エリカ", "text": "残念だけど、猫の顔は\n取り外しできないの。"},
        { "location": "1420/TALK"   , "narrator": "エリカ", "text": "いろんなセンサーが\nいっぱいついてるからね。"},
        { "location": "1421/TALK"   , "narrator": "エリカ", "text": "他は？"},
        { "location": "1423/ACT"    , "narrator": "", "text": "もういいです…"},
        { "location": "1424/TALK"   , "narrator": "エリカ", "text": "うん。\nわかったよ。"},
        { "location": "1426/TALK"   , "narrator": "エリカ", "text": "他にも聞きたいことが\nあれば、いつでも\n質問してね。"},
        { "location": "1427/ACT"    , "narrator": "", "text": "結構です"},
        { "location": "1428/TALK"   , "narrator": "エリカ", "text": "あらら…。"},
        { "location": "1429/TALK"   , "narrator": "エリカ", "text": "聞きたいことが\nあれば、いつでも\n質問してね。"},
        { "location": "1431/TALK"   , "narrator": "エリカ", "text": "話せることは\nお話するから。"},
        { "location": "1432/TALK"   , "narrator": "エリカ", "text": "それじゃ、改めまして。\n今回はにゃボットの\nゲットおめでとう！"},
        { "location": "1433/TALK"   , "narrator": "エリカ", "text": "色んな場面で活用して、\n可愛がってあげてね！"},
        { "location": "1434/TALK"   , "narrator": "エリカ", "text": "それじゃ、またね！"},
        { "location": "1443/TALK"   , "narrator": "千羽鶴", "text": "……おかえり。"},
        { "location": "1444/TALK"   , "narrator": "千羽鶴", "text": "というわけで、\n今回のクイズ大会は\nこれでお終い。"},
        { "location": "1445/TALK"   , "narrator": "千羽鶴", "text": "次回はまた\n次のMV回になる。"},
        { "location": "1446/TALK"   , "narrator": "千羽鶴", "text": "お楽しみに。"},
        { "location": "1260/DIALOG" , "narrator": "Tutorial/Dialog_Anime1", "text": "$dialog_word$"},
        { "location": "1262/DIALOG" , "narrator": "Tutorial/Dialog_Anime2", "text": "$dialog_word$"},
        { "location": "1264/DIALOG" , "narrator": "Tutorial/Dialog_Anime3", "text": "$dialog_word$"},
        { "location": "1266/DIALOG" , "narrator": "Tutorial/Dialog_Anime4", "text": "$dialog_word$"},
        { "location": "1268/DIALOG" , "narrator": "Tutorial/Dialog_Anime5", "text": "$dialog_word$"},
