        "title": "Extra007 ヒメゴトチャット",
        "sub_title": "覚えめでたく覚えておらず"
    },
    "entry":
    [
        { "location": "77/SCENARIO", "narrator": "", "text": "008_覚えめでたく覚えておらず"},
        { "location": "102/TALK"   , "narrator": "アーヤ", "text": "キリト君たちに勉強を教えてて"},
        { "location": "103/TALK"   , "narrator": "アーヤ", "text": "まずいことに気づいちゃったわ"},
        { "location": "104/TALK"   , "narrator": "アーヤ", "text": "高校時代に習ったこと、結構忘れてたの"},
        { "location": "106/SEL"    , "narrator": "", "text": "そういうもんだよ"},
        { "location": "107/SEL"    , "narrator": "", "text": "復習するの？"},
        { "location": "108/SEL"    , "narrator": "", "text": "教えられはしたの？"},
        { "location": "109/ACT"    , "narrator": "", "text": "そういうもんだよ"},
        { "location": "111/TALK"   , "narrator": "アーヤ", "text": "あら"},
        { "location": "112/TALK"   , "narrator": "アーヤ", "text": "やっぱりそう（￣ー￣？）"},
        { "location": "113/TALK"   , "narrator": "アーヤ", "text": "なんて"},
        { "location": "114/TALK"   , "narrator": "アーヤ", "text": "慰めでも"},
        { "location": "115/TALK"   , "narrator": "アーヤ", "text": "うれしいわ"},
        { "location": "117/SEL"    , "narrator": "", "text": "普通だよ"},
        { "location": "118/SEL"    , "narrator": "", "text": "当たり前だって"},
        { "location": "119/ACT"    , "narrator": "", "text": "普通だよ"},
        { "location": "120/TALK"   , "narrator": "アーヤ", "text": "そうよね"},
        { "location": "121/TALK"   , "narrator": "アーヤ", "text": "時間が経ったら忘れるのは当たり前よね"},
        { "location": "122/TALK"   , "narrator": "アーヤ", "text": "それはそうね"},
        { "location": "123/ACT"    , "narrator": "", "text": "当たり前だって"},
        { "location": "124/TALK"   , "narrator": "アーヤ", "text": "かもね"},
        { "location": "125/TALK"   , "narrator": "アーヤ", "text": "使わないことって"},
        { "location": "126/TALK"   , "narrator": "アーヤ", "text": "すぐ忘れちゃうわよね"},
        { "location": "128/ACT"    , "narrator": "", "text": "復習するの？"},
        { "location": "129/TALK"   , "narrator": "アーヤ", "text": "今必要かって言われると困るのよね"},
        { "location": "130/TALK"   , "narrator": "アーヤ", "text": "でもせっかく覚えたことを"},
        { "location": "131/TALK"   , "narrator": "アーヤ", "text": "忘れてるのは悔しいのよね"},
        { "location": "132/TALK"   , "narrator": "アーヤ", "text": "ちょっと考えるわ"},
        { "location": "133/ACT"    , "narrator": "", "text": "教えられはしたの？"},
        { "location": "134/TALK"   , "narrator": "アーヤ", "text": "一応ね"},
        { "location": "135/TALK"   , "narrator": "アーヤ", "text": "教科書見ながらだったし"},
        { "location": "136/TALK"   , "narrator": "アーヤ", "text": "なんとかなってよかったわ"}
    ]
}
