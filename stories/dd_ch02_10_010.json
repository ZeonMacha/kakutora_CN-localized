{
    "dir": "chap10/daydra/dd_ch02_10_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "10252",
        "cid": "ayami",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "いい香り"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "いい香り"},
        { "location": "20/TALK"   , "narrator": "つばめ", "text": "…あれ？"},
        { "location": "22/TALK"   , "narrator": "アーヤ", "text": "どうかしたの？"},
        { "location": "23/TALK"   , "narrator": "つばめ", "text": "はい、なんだか凄く良い\n香りがして…。"},
        { "location": "24/TALK"   , "narrator": "つばめ", "text": "あっ、わかりました！\nアーヤさんの髪です。"},
        { "location": "25/TALK"   , "narrator": "アーヤ", "text": "ああ…朝、シャワー\n浴びてきたからかしら？"},
        { "location": "26/TALK"   , "narrator": "つばめ", "text": "甘くて、ちょっと大人な\n香りですね。"},
        { "location": "27/TALK"   , "narrator": "アーヤ", "text": "気付いてくれた？\n実は、少し前にコンディ\nショナーを買い替えたの。"},
        { "location": "28/TALK"   , "narrator": "アーヤ", "text": "サンプルの香りが\n凄く気に入っちゃってね。"},
        { "location": "29/TALK"   , "narrator": "つばめ", "text": "そうだったんですかぁ…。\nなんだか、凄く良さそうな\nコンディショナーですね。"},
        { "location": "32/TALK"   , "narrator": "アーヤ", "text": "そう思うでしょ？"},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "でも、ドラッグストアで\n１０００円しないものよ。"},
        { "location": "35/TALK"   , "narrator": "つばめ", "text": "えっ！？\nこんないい香りなのに！？"},
        { "location": "36/TALK"   , "narrator": "アーヤ", "text": "ふふっ、その値段で\nこんなにいい香りも\nするし――"},
        { "location": "37/TALK"   , "narrator": "アーヤ", "text": "褒めてももらえたから、\n良い買い物だったわ。"},
        { "location": "38/TALK"   , "narrator": "つばめ", "text": "そう思います。"},
        { "location": "39/TALK"   , "narrator": "つばめ", "text": "…わたしも、同じの\n買ってみようかな？"},
        { "location": "40/TALK"   , "narrator": "アーヤ", "text": "…本当に気に入った\nみたいね。"},
        { "location": "42/TALK"   , "narrator": "アーヤ", "text": "けど…イメージ的に\nつばめには合わない気が\nするかも…。"},
        { "location": "43/SEL"    , "narrator": "", "text": "すぐ慣れるよ"},
        { "location": "44/SEL"    , "narrator": "", "text": "今の香りが良いと褒めよう"},
        { "location": "46/TALK"   , "narrator": "アーヤ", "text": "今みたいな石鹸の香りが、\nつばめのイメージには\nピッタリ――"},
        { "location": "47/TALK"   , "narrator": "アーヤ", "text": "なんて言ったら、\n気を悪くしちゃう\nかしら？"},
        { "location": "51/TALK"   , "narrator": "つばめ", "text": "あ…でも、大人っぽい\n香りだから――"},
        { "location": "52/TALK"   , "narrator": "つばめ", "text": "わたしにはちょっと、\n早過ぎるかも…。"},
        { "location": "53/TALK"   , "narrator": "アーヤ", "text": "…………。"},
        { "location": "54/TALK"   , "narrator": "アーヤ", "text": "ううん、そんなこと\nないんじゃない？"},
        { "location": "57/TALK"   , "narrator": "アーヤ", "text": "もう高校生なんだから、\nこういう香りだって、\nきっと似合うわよ。"},
        { "location": "58/TALK"   , "narrator": "つばめ", "text": "そ、そうですか？"},
        { "location": "59/TALK"   , "narrator": "アーヤ", "text": "そうよ。"},
        { "location": "60/TALK"   , "narrator": "アーヤ", "text": "今度銭湯行ったときに\n持っていくから――"},
        { "location": "61/TALK"   , "narrator": "アーヤ", "text": "その時に試してみて、\n気に入ったら買えば\nいいんじゃない？"},
        { "location": "63/TALK"   , "narrator": "つばめ", "text": "ありがとうございます。\n今から試すのが\n楽しみです！"},
        { "location": "65/ACT"    , "narrator": "", "text": "すぐ慣れるよ"},
        { "location": "84/TALK"   , "narrator": "アーヤ", "text": "まあ、いい香りなのは間違いないし"},
        { "location": "85/TALK"   , "narrator": "アーヤ", "text": "最初はちょっと、違和感あるだろうけど"},
        { "location": "97/TALK"   , "narrator": "アーヤ", "text": "じゃあ、今度銭湯\n行ったときに\n持っていくから――"},
        { "location": "99/TALK"   , "narrator": "アーヤ", "text": "一度使って、\n試してみるのはどう？"},
        { "location": "100/TALK"  , "narrator": "つばめ", "text": "いいんですか？"},
        { "location": "101/TALK"  , "narrator": "アーヤ", "text": "ええ、実際に使って\nからの方が、感じが\nわかっていいでしょ？"},
        { "location": "102/TALK"  , "narrator": "つばめ", "text": "ありがとうございます！\nわぁ、早く使って\nみたいなぁ…。"},
        { "location": "103/TALK"  , "narrator": "アーヤ", "text": "…今の香りも、本当に\nつばめにピッタリなんだ\nけどなぁ。"},
        { "location": "104/ACT"   , "narrator": "", "text": "今の香りが良いと褒めよう"},
        { "location": "124/TALK"  , "narrator": "アーヤ", "text": "伝えるくらいは大丈夫よね？"},
        { "location": "125/TALK"  , "narrator": "アーヤ", "text": "だって、"},
        { "location": "126/TALK"  , "narrator": "アーヤ", "text": "本当にいい香りだと思ってるし"},
        { "location": "138/TALK"  , "narrator": "アーヤ", "text": "でも、今のつばめの\n香りもいいと思うわ。"},
        { "location": "139/TALK"  , "narrator": "つばめ", "text": "えっ…そうですか？"},
        { "location": "141/TALK"  , "narrator": "アーヤ", "text": "ええ…これって、\n石鹸の香りよね？"},
        { "location": "142/TALK"  , "narrator": "つばめ", "text": "はい。\n石鹸の香りのする\nシャンプーです。"},
        { "location": "143/TALK"  , "narrator": "つばめ", "text": "わたし、石鹸の香りが\n好きだから、それでずっと\n使ってるんです。"},
        { "location": "144/TALK"  , "narrator": "アーヤ", "text": "そうなんだ？"},
        { "location": "146/TALK"  , "narrator": "アーヤ", "text": "隣にいると、いい感じに\nフワッと香ってくるから、\n凄く良いと思うわ。"},
        { "location": "147/TALK"  , "narrator": "つばめ", "text": "…そう言ってもらえると、\nちょっと嬉しいです。"},
        { "location": "148/TALK"  , "narrator": "つばめ", "text": "アーヤさんのコンディ\nショナー使ったら――"},
        { "location": "149/TALK"  , "narrator": "つばめ", "text": "やっぱり、この香り\nしなくなっちゃうと\n思いますか？"},
        { "location": "150/TALK"  , "narrator": "アーヤ", "text": "多分ね。\nこれ、付けた時はもっと\n甘い香りがするし。"},
        { "location": "152/TALK"  , "narrator": "つばめ", "text": "う～ん…それじゃあ、\nコンディショナーは\nやめておきます…。"},
        { "location": "155/TALK"  , "narrator": "アーヤ", "text": "ふふっ…まあ、どうしても\n気になるなら――"},
        { "location": "156/TALK"  , "narrator": "アーヤ", "text": "今度銭湯行くときに\n持っていくから、\nその時に試してみたら？"},
        { "location": "158/TALK"  , "narrator": "つばめ", "text": "わぁ、楽しみです。\n早く使ってみたいなぁ。"},
        { "location": "17/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>6月9日　12:11 PM</color>\nとある昼休み、学食横の自販機コーナーにて。"}
    ]
}
