{
    "dir": "chap05/daydra/dd_ch03_05_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "5305",
        "cid": "gabriella",
        "title": "005 メインストーリー",
        "sub_title": "むぎまるであたたまる＜後編＞"
    },
    "entry":
    [
        { "location": "348/SCENARIO", "narrator": "", "text": "むぎまるであたたまる"},
        { "location": "372/TALK"    , "narrator": "ガブリエラ", "text": "あたしがつばめの力に\n興味を持つ理由…。"},
        { "location": "373/TALK"    , "narrator": "ガブリエラ", "text": "…って、わかるわけ\nないわよね。"},
        { "location": "374/TALK"    , "narrator": "ガブリエラ", "text": "興味を持ってる、って\n言ったみやびを――"},
        { "location": "375/TALK"    , "narrator": "ガブリエラ", "text": "どうかしてる、とか\n思ってるくらいだし。"},
        { "location": "376/TALK"    , "narrator": "ガブリエラ", "text": "…みやびは、どうして\nあいつの力に興味が\nあるの？"},
        { "location": "378/TALK"    , "narrator": "みやび", "text": "ん？　そうやね…。"},
        { "location": "379/TALK"    , "narrator": "みやび", "text": "まあ、ぶっちゃけ\nつばめちゃんの\nあの力自体に――"},
        { "location": "380/TALK"    , "narrator": "みやび", "text": "興味があるゆうわけや\nないがよ。"},
        { "location": "381/TALK"    , "narrator": "ガブリエラ", "text": "は？"},
        { "location": "382/TALK"    , "narrator": "みやび", "text": "つまり、\n今回の件は――"},
        { "location": "383/TALK"    , "narrator": "みやび", "text": "絶対に管理庁が\n何か隠してると\n思うがよ。"},
        { "location": "384/TALK"    , "narrator": "みやび", "text": "ガブちゃんも\nそう思う？"},
        { "location": "385/TALK"    , "narrator": "ガブリエラ", "text": "まあ、ね…。"},
        { "location": "386/TALK"    , "narrator": "ガブリエラ", "text": "っていうか、興味が\nあるのって、\nそれが理由なの？"},
        { "location": "387/TALK"    , "narrator": "みやび", "text": "ん？\nそうやけんど、\nそれが――"},
        { "location": "388/TALK"    , "narrator": "みやび", "text": "…なるほど。\nそういうことかー。"},
        { "location": "389/TALK"    , "narrator": "ガブリエラ", "text": "え？"},
        { "location": "390/TALK"    , "narrator": "みやび", "text": "いんや。\nなんだかんだ言うて、\nガブちゃん――"},
        { "location": "391/TALK"    , "narrator": "みやび", "text": "つばめちゃんのこと、\n気に入っちょるんやね。"},
        { "location": "392/TALK"    , "narrator": "ガブリエラ", "text": "は、はぁ！？"},
        { "location": "393/TALK"    , "narrator": "ガブリエラ", "text": "何言ってんのよ！？\nあたし、そんなこと\n一言も――"},
        { "location": "394/TALK"    , "narrator": "みやび", "text": "いや、わかるわかる。"},
        { "location": "395/TALK"    , "narrator": "みやび", "text": "だってガブちゃん、\nさっき「面倒見なくちゃ\nいけない」――"},
        { "location": "396/TALK"    , "narrator": "みやび", "text": "そう言うちょったし。"},
        { "location": "397/TALK"    , "narrator": "みやび", "text": "本当に嫌いなら、\nそんなの放置やんか。"},
        { "location": "398/TALK"    , "narrator": "ガブリエラ", "text": "うっ…。"},
        { "location": "399/TALK"    , "narrator": "みやび", "text": "ガブちゃんは\n優しい子やきね。"},
        { "location": "400/TALK"    , "narrator": "みやび", "text": "ちゃんと面倒見てやりや。"},
        { "location": "402/TALK"    , "narrator": "ガブリエラ", "text": "ちょ、ま、待ちなさいよ！\n勝手に決めつけないで！"},
        { "location": "403/TALK"    , "narrator": "ガブリエラ", "text": "さっきのは、そう…\n言葉の綾よ！"},
        { "location": "406/TALK"    , "narrator": "ガブリエラ", "text": "誰があんな奴のこと…。"},
        { "location": "407/TALK"    , "narrator": "みやび", "text": "やっぱし、嫌いなが？"},
        { "location": "408/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "409/TALK"    , "narrator": "ガブリエラ", "text": "正直、嫌いよ。"},
        { "location": "410/TALK"    , "narrator": "ガブリエラ", "text": "何なのよ、あいつ。\nわけわからないのも\nそうだし――"},
        { "location": "411/TALK"    , "narrator": "ガブリエラ", "text": "いっつもアーヤにばっか\nくっついてるし――"},
        { "location": "412/TALK"    , "narrator": "ガブリエラ", "text": "正直言って、ダメダメよ。"},
        { "location": "413/TALK"    , "narrator": "みやび", "text": "…なるほど。"},
        { "location": "416/TALK"    , "narrator": "ガブリエラ", "text": "ま、そんなわけで\nあいつは期待できそうに\nないから――"},
        { "location": "417/TALK"    , "narrator": "ガブリエラ", "text": "今日入って来る、\nもう一人の新人の方に\n期待するわ。"},
        { "location": "419/TALK"    , "narrator": "みやび", "text": "ああ、なんて言うたか？\n確か――"},
        { "location": "421/TALK"    , "narrator": "みやび", "text": "卯月やったっけか？"},
        { "location": "422/TALK"    , "narrator": "ガブリエラ", "text": "そう、卯月よ。\nあたしも忘れてたわ。"},
        { "location": "423/TALK"    , "narrator": "みやび", "text": "まあ、もう一人の新人が\n来る言われたのも、\n昨日突然やったしな。"},
        { "location": "424/TALK"    , "narrator": "ガブリエラ", "text": "…適当だったわよね？"},
        { "location": "425/TALK"    , "narrator": "ガブリエラ", "text": "明日卯月って新人が\n来るから、\n面倒を見てやれ。"},
        { "location": "426/TALK"    , "narrator": "ガブリエラ", "text": "としか言われなかったし。"},
        { "location": "427/TALK"    , "narrator": "みやび", "text": "まほさんらしいやないか。"},
        { "location": "428/TALK"    , "narrator": "みやび", "text": "それに、百聞は一見に\n言うやろ？"},
        { "location": "429/TALK"    , "narrator": "みやび", "text": "説明するより見た方が\n早い、っちゅう判断――"},
        { "location": "430/TALK"    , "narrator": "ガブリエラ", "text": "じゃなくて、ただ単に\n面倒だっただけだと思う。"},
        { "location": "431/TALK"    , "narrator": "みやび", "text": "…そうやねぇ。\nまほさんやし。"},
        { "location": "435/TALK"    , "narrator": "ウェイトレス", "text": "お待たせいたしました。\n特製冷たい美味しい\nセットになります。"},
        { "location": "437/TALK"    , "narrator": "みやび", "text": "どうも。"},
        { "location": "438/TALK"    , "narrator": "ウェイトレス", "text": "ご注文は以上ですね？\nごゆっくりどうぞー。"},
        { "location": "444/TALK"    , "narrator": "ガブリエラ", "text": "…唐突に二人も新人が\n増えるなんて――"},
        { "location": "445/TALK"    , "narrator": "ガブリエラ", "text": "トライナリーは、\nどうなっちゃうの\nかしらね？"},
        { "location": "447/TALK"    , "narrator": "みやび", "text": "来月には１０人くらいに\nなっちょるかもしれんね。"},
        { "location": "448/TALK"    , "narrator": "みやび", "text": "来年には１００人越えで、\n部隊分けとかしちょるかも\nしれん。"},
        { "location": "449/TALK"    , "narrator": "ガブリエラ", "text": "あはは、それだと寮じゃ\n部屋が足りないわね。"},
        { "location": "450/TALK"    , "narrator": "みやび", "text": "新人はタコ部屋行きやな。"},
        { "location": "451/TALK"    , "narrator": "ガブリエラ", "text": "タコ部屋って…確かそれ、\n違法じゃなかった？"},
        { "location": "452/TALK"    , "narrator": "みやび", "text": "まあ、今のは冗談と\nしても――"},
        { "location": "453/TALK"    , "narrator": "みやび", "text": "まっこと、今後のうちらは\nどうなるんやかねぇ…。"},
        { "location": "454/TALK"    , "narrator": "みやび", "text": "っと、アイスが溶けるき。\nいただきます、っと。"},
        { "location": "456/TALK"    , "narrator": "ガブリエラ", "text": "…今後のこと、かぁ。"},
        { "location": "457/TALK"    , "narrator": "ガブリエラ", "text": "…マルザンナに、\nちょっと聞いてみよう\nかしら？"},
        { "location": "481/TALK"    , "narrator": "ガブリエラ", "text": "ねえ、マルザンナ"},
        { "location": "482/TALK"    , "narrator": "ガブリエラ", "text": "今日トライナリーにね、新しいメンバーが増えるの"},
        { "location": "484/SEL"     , "narrator": "", "text": "やったね！"},
        { "location": "485/ACT"     , "narrator": "", "text": "やったね！"},
        { "location": "487/TALK"    , "narrator": "ガブリエラ", "text": "そう思う？"},
        { "location": "488/TALK"    , "narrator": "ガブリエラ", "text": "つばめみたいに使えなさそうな新人が来たことを考えると"},
        { "location": "489/TALK"    , "narrator": "ガブリエラ", "text": "あまり喜べないの"},
        { "location": "490/TALK"    , "narrator": "ガブリエラ", "text": "だって、私達の面倒が増えるだけでしょ？"},
        { "location": "492/SEL"     , "narrator": "", "text": "仲間が増えるのは良いことだよ"},
        { "location": "493/SEL"     , "narrator": "", "text": "統率も取れなくなる恐れがある"},
        { "location": "494/ACT"     , "narrator": "", "text": "仲間が増えるのは良いことだよ"},
        { "location": "496/TALK"    , "narrator": "ガブリエラ", "text": "仲間、か"},
        { "location": "498/TALK"    , "narrator": "ガブリエラ", "text": "そうよね"},
        { "location": "499/TALK"    , "narrator": "ガブリエラ", "text": "仲間が増えることは良いこと"},
        { "location": "500/TALK"    , "narrator": "ガブリエラ", "text": "それって、当たり前のことよね？"},
        { "location": "501/TALK"    , "narrator": "ガブリエラ", "text": "もちろん、つばめみたいなイレギュラーはあるけど"},
        { "location": "502/TALK"    , "narrator": "ガブリエラ", "text": "でも、最初からネガティブに考えるのは良くなかったわ"},
        { "location": "503/TALK"    , "narrator": "ガブリエラ", "text": "気付かせてくれてありがとう、マルザンナ"},
        { "location": "504/ACT"     , "narrator": "", "text": "統率も取れなくなる恐れがある"},
        { "location": "505/TALK"    , "narrator": "ガブリエラ", "text": "そうよね"},
        { "location": "506/TALK"    , "narrator": "ガブリエラ", "text": "みやびの言った冗談が実現して"},
        { "location": "507/TALK"    , "narrator": "ガブリエラ", "text": "１００人までいかなくても"},
        { "location": "508/TALK"    , "narrator": "ガブリエラ", "text": "数十人とかになったら大変だもの"},
        { "location": "509/TALK"    , "narrator": "ガブリエラ", "text": "しかも、増える度に新人の面倒を見ることにもなるし"},
        { "location": "510/TALK"    , "narrator": "ガブリエラ", "text": "本当、これからのことを考えると"},
        { "location": "511/TALK"    , "narrator": "ガブリエラ", "text": "不安なことが多くて頭が痛いわ"},
        { "location": "548/TALK"    , "narrator": "みやび", "text": "…そういえば――"},
        { "location": "549/TALK"    , "narrator": "ガブリエラ", "text": "今度は何よ？"},
        { "location": "550/TALK"    , "narrator": "みやび", "text": "そろそろ５０分やけんど、\nガブちゃん、大丈夫やか？"},
        { "location": "551/TALK"    , "narrator": "ガブリエラ", "text": "え？"},
        { "location": "554/TALK"    , "narrator": "ガブリエラ", "text": "うわっ、いけない！\nもうこんな時間！！"},
        { "location": "555/TALK"    , "narrator": "みやび", "text": "マンヂウ、まだ半分も\n食べてないやん。"},
        { "location": "556/TALK"    , "narrator": "みやび", "text": "やっぱし、時間的に\n無理があったんやない？"},
        { "location": "559/TALK"    , "narrator": "ガブリエラ", "text": "あんたと話してたから\n食べきれなかったのよ！"},
        { "location": "560/TALK"    , "narrator": "ガブリエラ", "text": "もういいわ。\n残りは走りながら\n食べるから。"},
        { "location": "561/TALK"    , "narrator": "みやび", "text": "気ぃつけて戻るんよ。"},
        { "location": "562/TALK"    , "narrator": "ガブリエラ", "text": "うん…。"},
        { "location": "563/TALK"    , "narrator": "ガブリエラ", "text": "って、みやびは？\nまさか本当にサボる\nつもり！？"},
        { "location": "564/TALK"    , "narrator": "みやび", "text": "実はうち、お腹が痛いき\n午後は休むいう申請を、\nちゃんと出しちゅうき――"},
        { "location": "565/TALK"    , "narrator": "みやび", "text": "今から帰ったら、\nそれこそ問題や。"},
        { "location": "566/TALK"    , "narrator": "ガブリエラ", "text": "全然痛そうに見えないし！"},
        { "location": "567/TALK"    , "narrator": "ガブリエラ", "text": "じゃあ、さっき言ってた\n自主的な校外学習って\nいうのは…。"},
        { "location": "568/TALK"    , "narrator": "みやび", "text": "もちろん冗談や。"},
        { "location": "569/TALK"    , "narrator": "ガブリエラ", "text": "…あんた、そのうち絶対、\nバチが当たるわよ？"},
        { "location": "570/TALK"    , "narrator": "みやび", "text": "その辺の日本人より、\nよっぽど日本人らしい\nこと言うガブちゃん――"},
        { "location": "571/TALK"    , "narrator": "みやび", "text": "うちは結構好いちょるよ。"},
        { "location": "572/TALK"    , "narrator": "ガブリエラ", "text": "あー、はいはい。"},
        { "location": "573/TALK"    , "narrator": "みやび", "text": "それより、時間は？"},
        { "location": "574/TALK"    , "narrator": "ガブリエラ", "text": "そ、そうだったわ！\nそれじゃ、あたしは\n行くから！！"},
        { "location": "585/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "587/TALK"    , "narrator": "みやび", "text": "昼休みに、独りぼっちで\n外食、か…。"},
        { "location": "588/TALK"    , "narrator": "みやび", "text": "…はようクラスで、\nお友達できるとえいね。"},
        { "location": "599/DIALOG"  , "narrator": "Dialog_chapter_ch03", "text": "【03 赤い髪の転校生】"}
    ]
}
