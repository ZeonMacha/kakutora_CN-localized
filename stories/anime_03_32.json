        "title": "001 アニメーション",
        "sub_title": "ワールド・スピード"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "アニメ第32話"},
        { "location": "48/TALK"   , "narrator": "エリカ", "text": "こんにちは、\n$handle$さん。"},
        { "location": "50/TALK"   , "narrator": "エリカ", "text": "前に色々話したから、\n今回はつばめちゃんの\nお話をするだけでもいい？"},
        { "location": "52/TALK"   , "narrator": "エリカ", "text": "前に色々話したから、\n今回は綾ちゃんの\nお話をするだけでもいい？"},
        { "location": "54/TALK"   , "narrator": "エリカ", "text": "前に色々話したから、\n今回はガブリエラちゃんの\nお話をするだけでもいい？"},
        { "location": "56/TALK"   , "narrator": "エリカ", "text": "前に色々話したから、\n今回はみやびちゃんの\nお話をするだけでもいい？"},
        { "location": "58/SEL"    , "narrator": "", "text": "はい"},
        { "location": "59/SEL"    , "narrator": "", "text": "いいえ"},
        { "location": "60/ACT"    , "narrator": "", "text": "はい"},
        { "location": "62/TALK"   , "narrator": "エリカ", "text": "うん、わかった。"},
        { "location": "64/ACT"    , "narrator": "", "text": "いいえ"},
        { "location": "66/TALK"   , "narrator": "エリカ", "text": "はーい。\nそれじゃ、少しだけ\n巻き戻しするね？"},
        { "location": "71/TALK"   , "narrator": "エリカ", "text": "こんにちは！"},
        { "location": "72/TALK"   , "narrator": "エリカ", "text": "前回も色々と\nお世話になりました。"},
        { "location": "74/SEL"    , "narrator": "", "text": "どういたしまして"},
        { "location": "75/SEL"    , "narrator": "", "text": "千羽鶴がつばめのココロに入り込んで何かしてるよ"},
        { "location": "76/ACT"    , "narrator": "", "text": "どういたしまして"},
        { "location": "78/ACT"    , "narrator": "", "text": "千羽鶴がつばめのココロに入り込んで何かしてるよ"},
        { "location": "82/SEL"    , "narrator": "", "text": "どういたしまして"},
        { "location": "83/ACT"    , "narrator": "", "text": "どういたしまして"},
        { "location": "89/TALK"   , "narrator": "エリカ", "text": "それでね、\n色々調べていて\nやっと解ったんだよ。"},
        { "location": "90/TALK"   , "narrator": "エリカ", "text": "千羽鶴ちゃんが\n何を目指しているのか。"},
        { "location": "91/SEL"    , "narrator": "", "text": "なになに？"},
        { "location": "92/SEL"    , "narrator": "", "text": "なんか知ってる気がする"},
        { "location": "93/ACT"    , "narrator": "", "text": "なになに？"},
        { "location": "94/ACT"    , "narrator": "", "text": "なんか知ってる気がする"},
        { "location": "95/TALK"   , "narrator": "エリカ", "text": "え！？　そうなの？\nすごいね！！"},
        { "location": "96/TALK"   , "narrator": "エリカ", "text": "でも、認識に齟齬があると\nいけないから、一応私から\n伝えることにするね。"},
        { "location": "100/TALK"  , "narrator": "エリカ", "text": "千羽鶴ちゃんは、この地球\n全体を、フェノメノンで\n覆おうとしてる。"},
        { "location": "101/TALK"  , "narrator": "エリカ", "text": "でも、それを為し得るには\nさすがのつばめちゃんでも\n一人では無理。"},
        { "location": "102/TALK"  , "narrator": "エリカ", "text": "そこで、綾ちゃんたち\n他のメンバーも同時に\n発症させて――"},
        { "location": "103/TALK"  , "narrator": "エリカ", "text": "更に集めて来たクランを\n全て直列に繋いで。"},
        { "location": "104/TALK"  , "narrator": "エリカ", "text": "その莫大なエネルギーで\n全世界にフェノメノンを\n膨張させようとしてるの。"},
        { "location": "106/TALK"  , "narrator": "エリカ", "text": "彼女の計算では、豊洲で\n捕獲したモーフィアスで、\n必要量を満たしたみたい。"},
        { "location": "107/SEL"   , "narrator": "", "text": "千羽鶴が言ってた「準備は整った、つばめを壊して」ってのは…"},
        { "location": "108/ACT"   , "narrator": "", "text": "千羽鶴が言ってた「準備は整った、つばめを壊して」ってのは…"},
        { "location": "111/TALK"  , "narrator": "エリカ", "text": "そう。世界を覆うだけの\nエネルギーが\n集まったからだよ。"},
        { "location": "112/TALK"  , "narrator": "エリカ", "text": "だから、豊洲戦の後から\n色々と具体的な行動を\n起こし始めた。"},
        { "location": "115/SEL"   , "narrator": "", "text": "合点がいった"},
        { "location": "116/SEL"   , "narrator": "", "text": "何か引っかかる"},
        { "location": "117/ACT"   , "narrator": "", "text": "合点がいった"},
        { "location": "118/TALK"  , "narrator": "エリカ", "text": "うんうん。"},
        { "location": "119/ACT"   , "narrator": "", "text": "何か引っかかる"},
        { "location": "120/TALK"  , "narrator": "エリカ", "text": "どの辺かな？"},
        { "location": "121/SEL"   , "narrator": "", "text": "エリカは千羽鶴を送り込んだ人たちの一人なんだよね？"},
        { "location": "122/SEL"   , "narrator": "", "text": "千羽鶴は自分を送り込んだ人たちの計画に否定的だった"},
        { "location": "123/SEL"   , "narrator": "", "text": "いや、やっぱりなんでもない"},
        { "location": "124/ACT"   , "narrator": "", "text": "エリカは千羽鶴を送り込んだ人たちの一人なんだよね？"},
        { "location": "125/TALK"  , "narrator": "エリカ", "text": "そうだね。\n事実関係だけを答えれば\nその通り。"},
        { "location": "126/SEL"   , "narrator": "", "text": "じゃあ、その人達が何をしようとしてるか知ってるよね？教えて"},
        { "location": "127/ACT"   , "narrator": "", "text": "じゃあ、その人達が何をしようとしてるか知ってるよね？教えて"},
        { "location": "129/TALK"  , "narrator": "エリカ", "text": "基本的には変わらない。\n綾ちゃんたちを発症させて\nフェノメノンを作ること。"},
        { "location": "130/ACT"   , "narrator": "", "text": "千羽鶴は自分を送り込んだ人たちの計画に否定的だった"},
        { "location": "131/TALK"  , "narrator": "エリカ", "text": "そう。"},
        { "location": "132/TALK"  , "narrator": "エリカ", "text": "彼女は、統一国家及び\n多国籍企業群に、\n反旗を翻した。"},
        { "location": "133/SEL"   , "narrator": "", "text": "じゃあ、統一国家はトライナリーたちに何をさせようとしてたの？"},
        { "location": "134/ACT"   , "narrator": "", "text": "じゃあ、統一国家はトライナリーたちに何をさせようとしてたの？"},
        { "location": "136/TALK"  , "narrator": "エリカ", "text": "結果としては同じ。\nやっぱり発症による\nフェノメノンの生成。"},
        { "location": "137/ACT"   , "narrator": "", "text": "いや、やっぱりなんでもない"},
        { "location": "138/TALK"  , "narrator": "エリカ", "text": "あらら。"},
        { "location": "141/TALK"  , "narrator": "エリカ", "text": "けど、そのやり方も時期も\n千羽鶴ちゃんとは\n全く違う。"},
        { "location": "142/SEL"   , "narrator": "", "text": "どう違うの？"},
        { "location": "143/SEL"   , "narrator": "", "text": "エリカは自分の妹を発症させようとしているってこと！？"},
        { "location": "144/ACT"   , "narrator": "", "text": "どう違うの？"},
        { "location": "145/TALK"  , "narrator": "エリカ", "text": "千羽鶴ちゃんは、社会を\n人間が適正管理するのは\n絶対不可能だと思ってる。"},
        { "location": "146/TALK"  , "narrator": "エリカ", "text": "及び、今の社会を実質\nコントロールする統一国家\n及び多国籍企業を――"},
        { "location": "147/TALK"  , "narrator": "エリカ", "text": "全て世界から\n消し去ろうとしているの。\nフェノメノンによって。"},
        { "location": "148/TALK"  , "narrator": "エリカ", "text": "その為に、自らと\nトライナリーの面々を礎と\nして世界を創造する。"},
        { "location": "149/TALK"  , "narrator": "エリカ", "text": "それによってどんな社会を\n作ろうとしてるのか、その\n管理手法はどんな物か――"},
        { "location": "150/TALK"  , "narrator": "エリカ", "text": "それらを説明するには\nちょっと時間が足りない。"},
        { "location": "151/TALK"  , "narrator": "エリカ", "text": "片や多国籍企業群の\n目指す社会は単純。"},
        { "location": "152/TALK"  , "narrator": "エリカ", "text": "目に見えない経済と宗教と\nいう鎖によって、人々を\n誘導し、統率をする。"},
        { "location": "153/TALK"  , "narrator": "エリカ", "text": "こちらもその為に、\n常人では想像もつかない\nシナリオがあるけど――"},
        { "location": "154/TALK"  , "narrator": "エリカ", "text": "やはりそれは、\nここで説明するには\n時間が足りない。"},
        { "location": "155/TALK"  , "narrator": "エリカ", "text": "私が今、\nあなたに教えられることは\nこれくらいだと思う。"},
        { "location": "156/ACT"   , "narrator": "", "text": "エリカは自分の妹を発症させようとしているってこと！？"},
        { "location": "157/TALK"  , "narrator": "エリカ", "text": "結果だけを見れば\nそうなるよね。"},
        { "location": "158/TALK"  , "narrator": "エリカ", "text": "けど、わたしと綾ちゃんは\n全く異なる経緯で\nフェノム計画に関わった。"},
        { "location": "159/TALK"  , "narrator": "エリカ", "text": "わたしが初めて綾ちゃんの\n名前を見たのは、計画が\n実行された後。"},
        { "location": "160/TALK"  , "narrator": "エリカ", "text": "綾ちゃんがどんな経緯で\n天使候補になったのか、\nわたしは知らないの。"},
        { "location": "161/SEL"   , "narrator": "", "text": "なるほど"},
        { "location": "162/SEL"   , "narrator": "", "text": "なんすか！？\n天使候補って！"},
        { "location": "163/ACT"   , "narrator": "", "text": "なるほど"},
        { "location": "164/ACT"   , "narrator": "", "text": "なんすか！？\n天使候補って！"},
        { "location": "165/TALK"  , "narrator": "エリカ", "text": "あ、えっと。"},
        { "location": "166/TALK"  , "narrator": "エリカ", "text": "ニアイコール\nトライナリー、かな。"},
        { "location": "167/TALK"  , "narrator": "エリカ", "text": "統一国家及び\n多国籍企業群は\nそう呼んでいた。"},
        { "location": "168/TALK"  , "narrator": "エリカ", "text": "その意図は言葉通りの\n意味なんだけど――"},
        { "location": "169/TALK"  , "narrator": "エリカ", "text": "その裏には、常人には\n想像だに着かない壮絶な\nシナリオがある。"},
        { "location": "170/TALK"  , "narrator": "エリカ", "text": "でも、それをここで\n説明するには、あまりに\n時間が足りなすぎる。"},
        { "location": "172/TALK"  , "narrator": "エリカ", "text": "とにかく、\nわたしは今では、\nフェノム計画否定派。"},
        { "location": "173/TALK"  , "narrator": "エリカ", "text": "千羽鶴ちゃんの計画も、\n統一国家の計画も。"},
        { "location": "174/TALK"  , "narrator": "エリカ", "text": "過去の罪は消せないけど、\nこれ以上の悲劇を生まない\nために出来ることはある。"},
        { "location": "175/TALK"  , "narrator": "エリカ", "text": "ただ、それすらも\nわたしの独りよがりかも\nしれないけどね。"},
        { "location": "176/TALK"  , "narrator": "エリカ", "text": "そういう意味でも、\nあなたには客観的視点から\nわたしを裁定して欲しい。"},
        { "location": "177/TALK"  , "narrator": "エリカ", "text": "これからもわたしは、\nわたしの信じる道を\n突き進むけど――"},
        { "location": "178/TALK"  , "narrator": "エリカ", "text": "もし間違いだと思ったら\n諭してくれると\n嬉しいかな。"},
        { "location": "182/TALK"  , "narrator": "エリカ", "text": "そんなわけで、\n千羽鶴ちゃんの計画は\nだいたい解った。"},
        { "location": "183/TALK"  , "narrator": "エリカ", "text": "けど……\nどうしても１つだけ\n分からない事があって。"},
        { "location": "184/SEL"   , "narrator": "", "text": "それはなに？"},
        { "location": "185/ACT"   , "narrator": "", "text": "それはなに？"},
        { "location": "187/TALK"  , "narrator": "エリカ", "text": "何故あなたに、\n結婚して欲しいと\n言い続けてるのかだよ。"},
        { "location": "188/SEL"   , "narrator": "", "text": "確かに"},
        { "location": "189/ACT"   , "narrator": "", "text": "確かに"},
        { "location": "191/TALK"  , "narrator": "エリカ", "text": "これを確かめるには、\nもはや彼女のココロに\nダイブするしかないかも。"},
        { "location": "192/TALK"  , "narrator": "エリカ", "text": "もしかしたら、\n結婚にすごく重大な\n絡繰りがあるかもだし。"},
        { "location": "193/TALK"  , "narrator": "エリカ", "text": "とにかく、今の段階では\nそこまではわからないの。"},
        { "location": "194/TALK"  , "narrator": "エリカ", "text": "また何かわかったら、\nお話するね。"},
        { "location": "195/TALK"  , "narrator": "エリカ", "text": "それでね、現状の\n綾ちゃんたちだけど――"},
        { "location": "196/TALK"  , "narrator": "エリカ", "text": "前回音羽ちゃんのココロに\n潜ってもらったでしょ？"},
        { "location": "197/TALK"  , "narrator": "エリカ", "text": "あれのお陰で、音羽ちゃん\n回復しそうだよ！"},
        { "location": "198/SEL"   , "narrator": "", "text": "良かった！"},
        { "location": "199/ACT"   , "narrator": "", "text": "良かった！"},
        { "location": "201/TALK"  , "narrator": "エリカ", "text": "音羽ちゃんが歌って\nくれれば、神楽ちゃんの\n破壊の歌を止められる。"},
        { "location": "202/TALK"  , "narrator": "エリカ", "text": "そうすれば、\nつばめちゃんは壊されずに\n済むからね。"},
        { "location": "203/TALK"  , "narrator": "エリカ", "text": "あとは音羽ちゃんと一緒に\n東京に戻るだけだね。"},
        { "location": "205/TALK"  , "narrator": "エリカ", "text": "ここまで本当に\n色々協力してくれて\nありがとう。"},
        { "location": "206/TALK"  , "narrator": "エリカ", "text": "お陰で、なんとか\n綾ちゃんたちを護る事が\nできそうだよ。"},
        { "location": "208/TALK"  , "narrator": "エリカ", "text": "それじゃ、今回も\n記録映像を見てね。"},
        { "location": "237/TALK"  , "narrator": "千羽鶴", "text": "……なんて。\nちょっと\n懐かしいでしょ？"},
        { "location": "238/SEL"   , "narrator": "", "text": "なに？\nどういうこと！？"},
        { "location": "239/ACT"   , "narrator": "", "text": "なに？\nどういうこと！？"},
        { "location": "241/TALK"  , "narrator": "千羽鶴", "text": "大した事じゃない。\nちょっとした時間稼ぎ。"},
        { "location": "242/TALK"  , "narrator": "千羽鶴", "text": "でも、それだけだと\n貴方にとっては全然\n面白くないと思うから。"},
        { "location": "243/TALK"  , "narrator": "千羽鶴", "text": "貴方に一つ、\nオモシロ情報をあげる。"},
        { "location": "244/TALK"  , "narrator": "千羽鶴", "text": "今このちーちゃん\nラブラブRPGゲーム！を\nプレイすると――"},
        { "location": "245/TALK"  , "narrator": "千羽鶴", "text": "当時は解らなかった\n色んな伏線を楽しむことが\nできると思う。"},
        { "location": "246/TALK"  , "narrator": "千羽鶴", "text": "よくあるでしょう？"},
        { "location": "247/TALK"  , "narrator": "千羽鶴", "text": "昔遊んだ８ビットゲームを\n今再び遊んでみる。"},
        { "location": "248/TALK"  , "narrator": "千羽鶴", "text": "すると、当時小学生だった\n自分にはわからなかった\n物語が今ならよくわかる！"},
        { "location": "249/TALK"  , "narrator": "千羽鶴", "text": "――みたいなこと。"},
        { "location": "250/TALK"  , "narrator": "千羽鶴", "text": "それを非常に短期間で\n体験出来る、とても\n画期的なプログラム。"},
        { "location": "251/TALK"  , "narrator": "千羽鶴", "text": "是非その衝撃を\n今すぐ体験してみて。"},
        { "location": "252/SEL"   , "narrator": "", "text": "久々にやってみる"},
        { "location": "253/SEL"   , "narrator": "", "text": "そんなことしてる場合じゃない"},
        { "location": "254/ACT"   , "narrator": "", "text": "久々にやってみる"},
        { "location": "255/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "256/TALK"  , "narrator": "千羽鶴", "text": "それじゃ、\nもう一度リセット。"},
        { "location": "269/ACT"   , "narrator": "", "text": "そんなことしてる場合じゃない"},
        { "location": "270/TALK"  , "narrator": "千羽鶴", "text": "そう。\nそれじゃ、\n貴方に用はない。"},
        { "location": "271/TALK"  , "narrator": "千羽鶴", "text": "さよなら。"},
        { "location": "281/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/67MB 4:15】</color>"},
        { "location": "282/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/23MB 4:15】</color>"},
        { "location": "283/SEL"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "284/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/67MB 4:15】</color>"},
        { "location": "285/TALK"  , "narrator": "エリカ", "text": "わかった。"},
        { "location": "291/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/23MB 4:15】</color>"},
        { "location": "292/TALK"  , "narrator": "エリカ", "text": "わかった。"},
        { "location": "298/ACT"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "299/TALK"  , "narrator": "エリカ", "text": "あらら。"},
        { "location": "332/TALK"  , "narrator": "エリカ", "text": "……。"},
        { "location": "333/SEL"   , "narrator": "", "text": "ちょっと、なんか大変な事になってない？"},
        { "location": "334/ACT"   , "narrator": "", "text": "ちょっと、なんか大変な事になってない？"},
        { "location": "336/TALK"  , "narrator": "エリカ", "text": "そんな……。"},
        { "location": "337/TALK"  , "narrator": "エリカ", "text": "わたしが徹夜して\n計算したPreviewと\n結果が違うよ！！"},
        { "location": "338/TALK"  , "narrator": "エリカ", "text": "そんな……"},
        { "location": "339/SEL"   , "narrator": "", "text": "みんな爆死しちゃったの！？"},
        { "location": "340/SEL"   , "narrator": "", "text": "千羽鶴が何かやったのかな"},
        { "location": "341/ACT"   , "narrator": "", "text": "みんな爆死しちゃったの！？"},
        { "location": "342/TALK"  , "narrator": "エリカ", "text": "……。"},
        { "location": "343/TALK"  , "narrator": "エリカ", "text": "その可能性は、\n高いと思う。"},
        { "location": "344/TALK"  , "narrator": "エリカ", "text": "ああっ……ごめんなさい。\n完全に迂闊だった。"},
        { "location": "345/TALK"  , "narrator": "エリカ", "text": "わたしが非力だった。"},
        { "location": "346/TALK"  , "narrator": "エリカ", "text": "本当に、\nごめんなさい……。"},
        { "location": "347/SEL"   , "narrator": "", "text": "とにかく、今やれることをやろう"},
        { "location": "348/ACT"   , "narrator": "", "text": "とにかく、今やれることをやろう"},
        { "location": "351/TALK"  , "narrator": "エリカ", "text": "……。"},
        { "location": "352/TALK"  , "narrator": "エリカ", "text": "うん。\nそうだよね。"},
        { "location": "354/ACT"   , "narrator": "", "text": "千羽鶴が何かやったのかな"},
        { "location": "355/TALK"  , "narrator": "エリカ", "text": "それはないと思う。\n彼女は今、レディネスを\n操作できないはず。"},
        { "location": "357/SEL"   , "narrator": "", "text": "前回、千羽鶴がつばめの中に入ってた"},
        { "location": "358/ACT"   , "narrator": "", "text": "前回、千羽鶴がつばめの中に入ってた"},
        { "location": "360/TALK"  , "narrator": "エリカ", "text": "ええっ！？\nそうだったの？"},
        { "location": "361/TALK"  , "narrator": "エリカ", "text": "先に言ってくれれば\n良かったのに……。"},
        { "location": "362/SEL"   , "narrator": "", "text": "言おうとすると、ちーちゃんラブラb…いや、リセットが掛かってたんだよ"},
        { "location": "363/ACT"   , "narrator": "", "text": "言おうとすると、ちーちゃんラブラb…いや、リセットが掛かってたんだよ"},
        { "location": "365/TALK"  , "narrator": "エリカ", "text": "あー…そうなんだ。"},
        { "location": "366/TALK"  , "narrator": "エリカ", "text": "もうその時点で\n操作されてたんだね。"},
        { "location": "367/TALK"  , "narrator": "エリカ", "text": "……。"},
        { "location": "368/TALK"  , "narrator": "エリカ", "text": "ごめんなさい。\nわたしが非力だった。"},
        { "location": "369/TALK"  , "narrator": "エリカ", "text": "本当に、\nごめんなさい……。"},
        { "location": "371/TALK"  , "narrator": "エリカ", "text": "……。"},
        { "location": "372/TALK"  , "narrator": "エリカ", "text": "けど、もしかしたら……"},
        { "location": "375/TALK"  , "narrator": "エリカ", "text": "……。"},
        { "location": "376/TALK"  , "narrator": "エリカ", "text": "ああっ！！"},
        { "location": "377/SEL"   , "narrator": "", "text": "どうしたの！？"},
        { "location": "378/ACT"   , "narrator": "", "text": "どうしたの！？"},
        { "location": "380/TALK"  , "narrator": "エリカ", "text": "少し前に、つばめちゃんの\nココロスフィアにアクセス\nした形跡がある！"},
        { "location": "381/TALK"  , "narrator": "エリカ", "text": "それも、物理体から\n直接繋がってる……。"},
        { "location": "382/SEL"   , "narrator": "", "text": "じゃあ、その時に何かされた可能性がある？"},
        { "location": "383/ACT"   , "narrator": "", "text": "じゃあ、その時に何かされた可能性がある？"},
        { "location": "385/TALK"  , "narrator": "エリカ", "text": "……あると思う。"},
        { "location": "386/TALK"  , "narrator": "エリカ", "text": "ああっ……ごめんなさい。\n完全に迂闊だった。"},
        { "location": "387/TALK"  , "narrator": "エリカ", "text": "わたしが非力だった。"},
        { "location": "388/TALK"  , "narrator": "エリカ", "text": "本当に、\nごめんなさい……。"},
        { "location": "390/SEL"   , "narrator": "", "text": "とにかく、今やれることをやろう"},
        { "location": "391/SEL"   , "narrator": "", "text": "でも千羽鶴がアーヤたちを殺す理由ってなに？"},
        { "location": "392/ACT"   , "narrator": "", "text": "とにかく、今やれることをやろう"},
        { "location": "393/TALK"  , "narrator": "エリカ", "text": "そうだね。"},
        { "location": "394/ACT"   , "narrator": "", "text": "でも千羽鶴がアーヤたちを殺す理由ってなに？"},
        { "location": "395/TALK"  , "narrator": "エリカ", "text": "それは……"},
        { "location": "396/TALK"  , "narrator": "エリカ", "text": "確かに、ちょっと\nおかしいかも。"},
        { "location": "397/TALK"  , "narrator": "エリカ", "text": "綾ちゃんたちが死んだら、\n彼女はビジョンを実現\nできなくなる。"},
        { "location": "398/TALK"  , "narrator": "エリカ", "text": "ということは、\n統一国家？"},
        { "location": "400/SEL"   , "narrator": "", "text": "今はアーヤたちを助ける術を考えるのが先決だよ"},
        { "location": "401/ACT"   , "narrator": "", "text": "今はアーヤたちを助ける術を考えるのが先決だよ"},
        { "location": "403/TALK"  , "narrator": "エリカ", "text": "うん。\nそうだよね。"},
        { "location": "406/TALK"  , "narrator": "エリカ", "text": "ありがとう。\nわたし、ちょっと\n取り乱してたかも。"},
        { "location": "407/TALK"  , "narrator": "エリカ", "text": "$handle$さんの\nお陰で、すごく\n落ち着けたよ。えへへ…。"},
        { "location": "408/TALK"  , "narrator": "エリカ", "text": "そうだよね。\nこういう時こそ、\nしっかりしなくちゃ。"},
        { "location": "409/TALK"  , "narrator": "エリカ", "text": "……ふぅ。"},
        { "location": "411/TALK"  , "narrator": "エリカ", "text": "あのね、今回の件だけど、\n$handle$さんにも\n協力して欲しいの。"},
        { "location": "412/TALK"  , "narrator": "エリカ", "text": "お願いできるかな…。"},
        { "location": "413/SEL"   , "narrator": "", "text": "もちろん"},
        { "location": "414/ACT"   , "narrator": "", "text": "もちろん"},
        { "location": "416/TALK"  , "narrator": "エリカ", "text": "ありがとう。"},
        { "location": "417/TALK"  , "narrator": "エリカ", "text": "結末は、今からでも\n変えることができる。"},
        { "location": "418/TALK"  , "narrator": "エリカ", "text": "東京までの道中に\n何があったのか――"},
        { "location": "419/TALK"  , "narrator": "エリカ", "text": "そして、どうすれば\n回避出来るのか。"},
        { "location": "420/TALK"  , "narrator": "エリカ", "text": "それがわかる時系列を、\n今からデイトラシステムに\nプリセットする。"},
        { "location": "421/TALK"  , "narrator": "エリカ", "text": "だから、それらに\nアクセスして、\n確認して欲しいの。"},
        { "location": "422/TALK"  , "narrator": "エリカ", "text": "綾ちゃんたちに\n何があったのか。"},
        { "location": "423/TALK"  , "narrator": "エリカ", "text": "そして、可能なら\nその回避策を一緒に\n考えてあげて欲しいの。"},
        { "location": "424/TALK"  , "narrator": "エリカ", "text": "本当に役に立たなくて\nごめんなさい。"},
        { "location": "426/TALK"  , "narrator": "エリカ", "text": "でも、今は\nあなただけが\n頼りなんだ。"},
        { "location": "432/TALK"  , "narrator": "エリカ", "text": "それでね、\n今回つばめちゃんに対して\nお願いしたいのは――"},
        { "location": "433/TALK"  , "narrator": "エリカ", "text": "千羽鶴ちゃんが\nココロの中で何をしたのか\n見て来て欲しいの。"},
        { "location": "434/TALK"  , "narrator": "エリカ", "text": "その際に１つ、\n申し訳無いお願いが\nあるんだけど……。"},
        { "location": "435/SEL"   , "narrator": "", "text": "なんでしょう？"},
        { "location": "436/ACT"   , "narrator": "", "text": "なんでしょう？"},
        { "location": "438/TALK"  , "narrator": "エリカ", "text": "前回は強制的にダイブする\nプログラムを作って、\nやってもらったでしょ？"},
        { "location": "439/TALK"  , "narrator": "エリカ", "text": "でも今回は、\n正規の方法でダイブをして\nもらいたいの。"},
        { "location": "440/TALK"  , "narrator": "エリカ", "text": "千羽鶴ちゃんが暗躍してる\nとなると、介入されちゃう\n可能性もあるから。"},
        { "location": "441/SEL"   , "narrator": "", "text": "で、どんな葛藤がありそうなの？"},
        { "location": "442/ACT"   , "narrator": "", "text": "で、どんな葛藤がありそうなの？"},
        { "location": "444/TALK"  , "narrator": "エリカ", "text": "あー、いや。\nそれが、監禁状態だし\nあまり葛藤は無いかも…。"},
        { "location": "445/TALK"  , "narrator": "エリカ", "text": "その場合は、何か\n些細なことでもいいから\n葛藤を生み出してみて？"},
        { "location": "446/SEL"   , "narrator": "", "text": "無茶すぎじゃない！？"},
        { "location": "447/ACT"   , "narrator": "", "text": "無茶すぎじゃない！？"},
        { "location": "449/TALK"  , "narrator": "エリカ", "text": "ごめんね！\n今はそれくらいしか\n思いつかなくて！"},
        { "location": "450/TALK"  , "narrator": "エリカ", "text": "上手くいかなかったら\n全然それで構わないから。"},
        { "location": "451/TALK"  , "narrator": "エリカ", "text": "やるだけ\nやってみてくれると\n嬉しいかな。"},
        { "location": "452/TALK"  , "narrator": "エリカ", "text": "それじゃ、\n宜しくお願いします。"},
        { "location": "459/TALK"  , "narrator": "エリカ", "text": "それじゃ、\n具体的にどうすれば\nいいかお話するね。"},
        { "location": "460/TALK"  , "narrator": "エリカ", "text": "デイドラシステムは、\n東京到着の３０分前\nくらいにセットした。"},
        { "location": "461/TALK"  , "narrator": "エリカ", "text": "そこから綾ちゃんたちの\n様子を見てもらって――"},
        { "location": "462/TALK"  , "narrator": "エリカ", "text": "何か起きたら、それを\n解決するために、知恵を\n貸してあげて欲しいの。"},
        { "location": "463/TALK"  , "narrator": "エリカ", "text": "もちろん、先に\n危機的状況であることを\n伝えた方がいいよね。"},
        { "location": "464/TALK"  , "narrator": "エリカ", "text": "そういった諸々の行動が\n未来を変えていくから。"},
        { "location": "465/TALK"  , "narrator": "エリカ", "text": "でも、これが自然派生\nじゃなくて、誰かの\n計画による変更だと――"},
        { "location": "466/TALK"  , "narrator": "エリカ", "text": "ほんの少しの変更では、\n揺り戻しされる危険性も\nあるの。"},
        { "location": "467/TALK"  , "narrator": "エリカ", "text": "だから、ありとあらゆる\nことをやってみて欲しい。"},
        { "location": "468/TALK"  , "narrator": "エリカ", "text": "無茶ばかり言ってるけど、\n本当に出来ることをやって\nくれればいいから。"},
        { "location": "469/TALK"  , "narrator": "エリカ", "text": "いつも頼り切りで\nごめんなさい。"},
        { "location": "470/TALK"  , "narrator": "エリカ", "text": "どうか、\nよろしくお願いします。"},
