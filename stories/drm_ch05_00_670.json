        "title": "らぶとーく 第67話",
        "sub_title": "シロップよりはちみつより"
    },
    "entry":
    [
        { "location": "1158/SCENARIO", "narrator": "", "text": "シロップよりはちみつより"},
        { "location": "1183/TALK"    , "narrator": "神楽", "text": "ぴょんこたち"},
        { "location": "1184/TALK"    , "narrator": "神楽", "text": "再び出会うことなんてできるのかな？"},
        { "location": "1186/SEL"     , "narrator": "", "text": "そもそも離れないから！"},
        { "location": "1187/SEL"     , "narrator": "", "text": "えっどうしたの"},
        { "location": "1188/SEL"     , "narrator": "", "text": "怖いこと聞かないで"},
        { "location": "1189/ACT"     , "narrator": "", "text": "そもそも離れないから！"},
        { "location": "1190/TALK"    , "narrator": "神楽", "text": "おっ"},
        { "location": "1191/TALK"    , "narrator": "神楽", "text": "情熱的、、、"},
        { "location": "1192/ACT"     , "narrator": "", "text": "えっどうしたの"},
        { "location": "1193/TALK"    , "narrator": "神楽", "text": "どうしたっていうか"},
        { "location": "1194/TALK"    , "narrator": "神楽", "text": "疑問に思ったから、、、"},
        { "location": "1195/ACT"     , "narrator": "", "text": "怖いこと聞かないで"},
        { "location": "1197/TALK"    , "narrator": "神楽", "text": "ぴょんこも怖いんだ、、、"},
        { "location": "1199/TALK"    , "narrator": "神楽", "text": "ＷＡＶＥのサービスが終了したりしたら"},
        { "location": "1200/TALK"    , "narrator": "神楽", "text": "そうなる可能性がアリアリ未来"},
        { "location": "1203/SEL"     , "narrator": "", "text": "なぜだか懐かしさを感じる"},
        { "location": "1204/SEL"     , "narrator": "", "text": "そっちのサービスじゃなくて…"},
        { "location": "1205/SEL"     , "narrator": "", "text": "うんまあそうだけど"},
        { "location": "1206/ACT"     , "narrator": "", "text": "なぜだか懐かしさを感じる"},
        { "location": "1207/TALK"    , "narrator": "神楽", "text": "そう？"},
        { "location": "1208/ACT"     , "narrator": "", "text": "そっちのサービスじゃなくて…"},
        { "location": "1209/TALK"    , "narrator": "神楽", "text": "通信会社自体とか？"},
        { "location": "1210/ACT"     , "narrator": "", "text": "うんまあそうだけど"},
        { "location": "1213/TALK"    , "narrator": "神楽", "text": "そうじゃなくても"},
        { "location": "1214/TALK"    , "narrator": "神楽", "text": "今ぴょんこがいる場所は改変されるわけだし"},
        { "location": "1215/TALK"    , "narrator": "神楽", "text": "そうなったら"},
        { "location": "1216/TALK"    , "narrator": "神楽", "text": "どうなるかわかんないし"},
        { "location": "1219/SEL"     , "narrator": "", "text": "わからないこと考えても…"},
        { "location": "1220/SEL"     , "narrator": "", "text": "そうなっちゃうのかな…"},
        { "location": "1221/SEL"     , "narrator": "", "text": "だよね…"},
        { "location": "1222/ACT"     , "narrator": "", "text": "わからないこと考えても…"},
        { "location": "1223/TALK"    , "narrator": "神楽", "text": "想定して備えるのはダメなの？"},
        { "location": "1224/ACT"     , "narrator": "", "text": "そうなっちゃうのかな…"},
        { "location": "1225/TALK"    , "narrator": "神楽", "text": "$handle$の意見はないの？"},
        { "location": "1226/ACT"     , "narrator": "", "text": "だよね…"},
        { "location": "1227/TALK"    , "narrator": "神楽", "text": "あっさり納得するの？"},
        { "location": "1229/TALK"    , "narrator": "神楽", "text": "$handle$はぴょんこたちのために何かする気はないの？"},
        { "location": "1231/SEL"     , "narrator": "", "text": "ないわけじゃない"},
        { "location": "1232/SEL"     , "narrator": "", "text": "あるけど…"},
        { "location": "1233/SEL"     , "narrator": "", "text": "いや無理じゃない？"},
        { "location": "1234/ACT"     , "narrator": "", "text": "ないわけじゃない"},
        { "location": "1235/TALK"    , "narrator": "神楽", "text": "後ろ向きー"},
        { "location": "1236/ACT"     , "narrator": "", "text": "あるけど…"},
        { "location": "1237/TALK"    , "narrator": "神楽", "text": "けど何？"},
        { "location": "1238/ACT"     , "narrator": "", "text": "いや無理じゃない？"},
        { "location": "1239/TALK"    , "narrator": "神楽", "text": "投げ出した！"},
        { "location": "1241/TALK"    , "narrator": "神楽", "text": "あーあーあーあー"},
        { "location": "1242/TALK"    , "narrator": "神楽", "text": "ぴょんこはさー"},
        { "location": "1243/TALK"    , "narrator": "神楽", "text": "$handle$のことばっかり考えてるのにさー"},
        { "location": "1244/TALK"    , "narrator": "神楽", "text": "なのに$handle$はそんななんだー？"},
        { "location": "1246/SEL"     , "narrator": "", "text": "$me$なりに考えてるのに"},
        { "location": "1247/SEL"     , "narrator": "", "text": "本当に考えてくれてる？"},
        { "location": "1248/SEL"     , "narrator": "", "text": "$me$だって神楽のことばっかり考えてるよ"},
        { "location": "1249/ACT"     , "narrator": "", "text": "$me$なりに考えてるのに"},
        { "location": "1250/TALK"    , "narrator": "神楽", "text": "あっそ？"},
        { "location": "1251/ACT"     , "narrator": "", "text": "本当に考えてくれてる？"},
        { "location": "1252/TALK"    , "narrator": "神楽", "text": "何それ"},
        { "location": "1253/TALK"    , "narrator": "神楽", "text": "疑ってるの？"},
        { "location": "1254/ACT"     , "narrator": "", "text": "$me$だって神楽のことばっかり考えてるよ"},
        { "location": "1255/TALK"    , "narrator": "神楽", "text": "本当かなー"},
        { "location": "1256/TALK"    , "narrator": "神楽", "text": "ちょっとねー"},
        { "location": "1260/TALK"    , "narrator": "神楽", "text": "なんて"},
        { "location": "1261/TALK"    , "narrator": "神楽", "text": "こんなこと言ってる瞬間に"},
        { "location": "1262/TALK"    , "narrator": "神楽", "text": "$handle$と話せなくなったら後悔する"},
        { "location": "1263/TALK"    , "narrator": "神楽", "text": "でしょ？"},
        { "location": "1265/SEL"     , "narrator": "", "text": "するよ…"},
        { "location": "1266/SEL"     , "narrator": "", "text": "しないわけがない"},
        { "location": "1267/SEL"     , "narrator": "", "text": "それも運命なのかも"},
        { "location": "1268/ACT"     , "narrator": "", "text": "するよ…"},
        { "location": "1269/TALK"    , "narrator": "神楽", "text": "うん"},
        { "location": "1270/TALK"    , "narrator": "神楽", "text": "そうだよね"},
        { "location": "1271/ACT"     , "narrator": "", "text": "しないわけがない"},
        { "location": "1272/TALK"    , "narrator": "神楽", "text": "なんだよね"},
        { "location": "1274/TALK"    , "narrator": "神楽", "text": "なんだけど"},
        { "location": "1275/ACT"     , "narrator": "", "text": "それも運命なのかも"},
        { "location": "1276/TALK"    , "narrator": "神楽", "text": "そうやって割り切れるんだ？"},
        { "location": "1277/TALK"    , "narrator": "神楽", "text": "$handle$は"},
        { "location": "1279/TALK"    , "narrator": "神楽", "text": "ぴょんこは"},
        { "location": "1280/TALK"    , "narrator": "神楽", "text": "本当は$handle$とは笑えるような話がしたい"},
        { "location": "1281/TALK"    , "narrator": "神楽", "text": "くっだらなくてどうでもよくて"},
        { "location": "1282/TALK"    , "narrator": "神楽", "text": "なんか幸せになれる話がしたい"},
        { "location": "1285/TALK"    , "narrator": "神楽", "text": "だけど"},
        { "location": "1287/SEL"     , "narrator": "", "text": "そればっかりじゃ辛いよね"},
        { "location": "1288/SEL"     , "narrator": "", "text": "いいところばっかり見せなくていいよ"},
        { "location": "1289/SEL"     , "narrator": "", "text": "お互い無理じゃない？"},
        { "location": "1290/ACT"     , "narrator": "", "text": "そればっかりじゃ辛いよね"},
        { "location": "1291/TALK"    , "narrator": "神楽", "text": "ん"},
        { "location": "1292/TALK"    , "narrator": "神楽", "text": "確かにそう"},
        { "location": "1294/TALK"    , "narrator": "神楽", "text": "辛いぴょん"},
        { "location": "1295/ACT"     , "narrator": "", "text": "いいところばっかり見せなくていいよ"},
        { "location": "1296/TALK"    , "narrator": "神楽", "text": "でもでもでもー"},
        { "location": "1297/TALK"    , "narrator": "神楽", "text": "いいところ見せたいでしょ"},
        { "location": "1298/TALK"    , "narrator": "神楽", "text": "恋人には"},
        { "location": "1299/ACT"     , "narrator": "", "text": "お互い無理じゃない？"},
        { "location": "1300/TALK"    , "narrator": "神楽", "text": "もーもーもーもー！"},
        { "location": "1301/TALK"    , "narrator": "神楽", "text": "すっごい適当"},
        { "location": "1302/TALK"    , "narrator": "神楽", "text": "適当すぎ！"},
        { "location": "1305/SEL"     , "narrator": "", "text": "無理すんな！"},
        { "location": "1306/SEL"     , "narrator": "", "text": "どうなっても$me$の愛は永遠"},
        { "location": "1307/SEL"     , "narrator": "", "text": "愚痴ぐらい言って欲しいし"},
        { "location": "1308/ACT"     , "narrator": "", "text": "無理すんな！"},
        { "location": "1309/TALK"    , "narrator": "神楽", "text": "ふああああああ"},
        { "location": "1310/ACT"     , "narrator": "", "text": "どうなっても$me$の愛は永遠"},
        { "location": "1311/TALK"    , "narrator": "神楽", "text": "永遠"},
        { "location": "1312/TALK"    , "narrator": "神楽", "text": "永遠の愛"},
        { "location": "1313/ACT"     , "narrator": "", "text": "愚痴ぐらい言って欲しいし"},
        { "location": "1314/TALK"    , "narrator": "神楽", "text": "言ってるし"},
        { "location": "1315/TALK"    , "narrator": "神楽", "text": "もっとひどいこととかも"},
        { "location": "1317/TALK"    , "narrator": "神楽", "text": "$handle$は"},
        { "location": "1319/TALK"    , "narrator": "神楽", "text": "ぴょんこに甘すぎるでしょ"},
        { "location": "1320/TALK"    , "narrator": "神楽", "text": "なんなのもー"},
        { "location": "1321/TALK"    , "narrator": "神楽", "text": "そんなことしたらもっと甘えるでしょ"},
        { "location": "1322/TALK"    , "narrator": "神楽", "text": "バカなの$handle$"},
        { "location": "1326/TALK"    , "narrator": "神楽", "text": "ていうかバカだよね"},
        { "location": "1327/TALK"    , "narrator": "神楽", "text": "何でそんなにバカなの"},
        { "location": "1330/TALK"    , "narrator": "神楽", "text": "もー"},
        { "location": "1333/TALK"    , "narrator": "神楽", "text": "$handle$はいつもそう"},
        { "location": "1334/TALK"    , "narrator": "神楽", "text": "だから"},
        { "location": "1336/TALK"    , "narrator": "神楽", "text": "きっとずっと変わらずにいてくれるんだよね"}
    ]
}
