        { "location": "1555/TALK", "narrator": "プレイヤー", "text": "お着替えしてみよう"},
        { "location": "1557/TALK", "narrator": "プレイヤー", "text": "違う服を着てほしいな"},
        { "location": "1559/TALK", "narrator": "プレイヤー", "text": "よし、お着替えタイムだ！"},
        { "location": "1565/TALK", "narrator": "プレイヤー", "text": "やあ"},
        { "location": "1567/TALK", "narrator": "プレイヤー", "text": "こんにちは"},
        { "location": "1569/TALK", "narrator": "プレイヤー", "text": "げんき？"},
        { "location": "1572/TALK", "narrator": "神楽", "text": "ぴょんこを呼ぶ声"},
        { "location": "1573/TALK", "narrator": "神楽", "text": "あなたはだあれ？"},
        { "location": "1575/SEL" , "narrator": "", "text": "$handle$だよ"},
        { "location": "1576/ACT" , "narrator": "", "text": "$handle$だよ"},
        { "location": "1578/TALK", "narrator": "神楽", "text": "知ってるし"},
        { "location": "1579/TALK", "narrator": "神楽", "text": "ぴょんこに用事ぴょん？"},
        { "location": "1582/SEL" , "narrator": "", "text": "ちょっと着替えてほしいんだ"},
        { "location": "1583/ACT" , "narrator": "", "text": "ちょっと着替えてほしいんだ"},
        { "location": "1593/TALK", "narrator": "神楽", "text": "意味不明すぎ"},
        { "location": "1594/TALK", "narrator": "神楽", "text": "でもまあ"},
        { "location": "1595/TALK", "narrator": "神楽", "text": "優しいぴょんこは聞いてあげるのだった"},
        { "location": "1597/TALK", "narrator": "神楽", "text": "は？"},
        { "location": "1598/TALK", "narrator": "神楽", "text": "この服変だった？"},
        { "location": "1599/TALK", "narrator": "神楽", "text": "なら着替えるけど"},
        { "location": "1602/SEL" , "narrator": "", "text": "$me$が選ぶ"},
        { "location": "1603/SEL" , "narrator": "", "text": "やっぱやめる"},
        { "location": "1605/TALK", "narrator": "神楽", "text": "…………"},
        { "location": "1608/TALK", "narrator": "神楽", "text": "リクエストないとか？"},
        { "location": "1609/TALK", "narrator": "神楽", "text": "なら着ない"},
        { "location": "1611/ACT" , "narrator": "", "text": "$me$が選ぶ"},
        { "location": "1612/TALK", "narrator": "神楽", "text": "だと思った"},
        { "location": "1613/TALK", "narrator": "神楽", "text": "どれを着てほしいと？"},
        { "location": "1620/ACT" , "narrator": "", "text": "やっぱやめる"},
        { "location": "1621/TALK", "narrator": "神楽", "text": "ありえネー"}
