    "entry":
    [
        { "location": "2546/SCENARIO", "narrator": "", "text": "知られたくなかった"},
        { "location": "2556/TALK"    , "narrator": "神楽", "text": "……。"},
        { "location": "2568/TALK"    , "narrator": "神楽", "text": "$handle$さん？"},
        { "location": "2569/TALK"    , "narrator": "神楽", "text": "ぴょんこですよ～"},
        { "location": "2571/SEL"     , "narrator": "", "text": "今日も元気だね"},
        { "location": "2572/SEL"     , "narrator": "", "text": "久しぶり"},
        { "location": "2573/SEL"     , "narrator": "", "text": "無理してない？"},
        { "location": "2574/ACT"     , "narrator": "", "text": "今日も元気だね"},
        { "location": "2575/TALK"    , "narrator": "神楽", "text": "もちろんです♪"},
        { "location": "2576/ACT"     , "narrator": "", "text": "久しぶり"},
        { "location": "2577/TALK"    , "narrator": "神楽", "text": "そうですか？"},
        { "location": "2578/TALK"    , "narrator": "神楽", "text": "ぴょんこに会えない時間が長く感じちゃったんですね♪"},
        { "location": "2579/TALK"    , "narrator": "神楽", "text": "$handle$さんったらも～～～！！！！"},
        { "location": "2580/ACT"     , "narrator": "", "text": "無理してない？"},
        { "location": "2581/TALK"    , "narrator": "神楽", "text": "そんなことないですよ？"},
        { "location": "2583/TALK"    , "narrator": "神楽", "text": "あのですね"},
        { "location": "2584/TALK"    , "narrator": "神楽", "text": "クソゴミのフェノメノンのせいでみんなにフレイメノウってバレちゃったんですよぴょんこは"},
        { "location": "2586/TALK"    , "narrator": "神楽", "text": "はあああああ～～～って感じなんですぴょん"},
        { "location": "2587/TALK"    , "narrator": "神楽", "text": "はあああああ～～～"},
        { "location": "2589/SEL"     , "narrator": "", "text": "お疲れさま"},
        { "location": "2590/SEL"     , "narrator": "", "text": "そんなことがあったんだ…"},
        { "location": "2591/SEL"     , "narrator": "", "text": "いずれバレたよ"},
        { "location": "2592/ACT"     , "narrator": "", "text": "お疲れさま"},
        { "location": "2593/TALK"    , "narrator": "神楽", "text": "ほんとですぴょん"},
        { "location": "2595/TALK"    , "narrator": "神楽", "text": "ハイパーお疲れさまでした！"},
        { "location": "2596/ACT"     , "narrator": "", "text": "そんなことがあったんだ…"},
        { "location": "2597/TALK"    , "narrator": "神楽", "text": "アリアリアリアリですぴょん"},
        { "location": "2598/TALK"    , "narrator": "神楽", "text": "つらい～～"},
        { "location": "2599/ACT"     , "narrator": "", "text": "いずれバレたよ"},
        { "location": "2600/TALK"    , "narrator": "神楽", "text": "あっあっあっあっあっあっ"},
        { "location": "2601/TALK"    , "narrator": "神楽", "text": "そういうこと言う～～～！？"},
        { "location": "2603/TALK"    , "narrator": "神楽", "text": "だからぴょんこは学校とかさぼっちゃったりトライナリーに顔出さなかったり"},
        { "location": "2604/TALK"    , "narrator": "神楽", "text": "大変に不良を決め込んでるんですよ"},
        { "location": "2606/SEL"     , "narrator": "", "text": "それは仕方ないよ"},
        { "location": "2607/SEL"     , "narrator": "", "text": "そうなっちゃうよね"},
        { "location": "2608/SEL"     , "narrator": "", "text": "不良だなー"},
        { "location": "2609/ACT"     , "narrator": "", "text": "それは仕方ないよ"},
        { "location": "2610/TALK"    , "narrator": "神楽", "text": "そうですかそうですかそうですか？"},
        { "location": "2611/TALK"    , "narrator": "神楽", "text": "だったらいいんですけど～～～"},
        { "location": "2612/ACT"     , "narrator": "", "text": "そうなっちゃうよね"},
        { "location": "2613/TALK"    , "narrator": "神楽", "text": "でしょでしょでしょでしょ"},
        { "location": "2614/TALK"    , "narrator": "神楽", "text": "なっちゃいますよ～"},
        { "location": "2615/ACT"     , "narrator": "", "text": "不良だなー"},
        { "location": "2616/TALK"    , "narrator": "神楽", "text": "だからぴょんこは不良だって言ってます～"},
        { "location": "2617/TALK"    , "narrator": "神楽", "text": "も～"},
        { "location": "2630/TALK"    , "narrator": "神楽", "text": "こんなことしてても\n仕方ないのに……。"},
        { "location": "2631/TALK"    , "narrator": "神楽", "text": "しなきゃいけないこと\nいっぱいあるし…。"},
        { "location": "2635/TALK"    , "narrator": "神楽", "text": "！\nつばめ、さん…？"},
        { "location": "2639/TALK"    , "narrator": "神楽", "text": "…切れちゃった…。"},
        { "location": "2640/SEL"     , "narrator": "", "text": "伝えておきたいことがある"},
        { "location": "2641/ACT"     , "narrator": "", "text": "伝えておきたいことがある"},
        { "location": "2658/TALK"    , "narrator": "神楽", "text": "え"},
        { "location": "2659/TALK"    , "narrator": "神楽", "text": "何をですか？"},
        { "location": "2661/SEL"     , "narrator": "", "text": "$me$がずっと側にいるから"},
        { "location": "2662/SEL"     , "narrator": "", "text": "$me$は神楽の支えになりたい"},
        { "location": "2663/SEL"     , "narrator": "", "text": "$me$は何が起こっても驚かない"},
        { "location": "2664/ACT"     , "narrator": "", "text": "$me$がずっと側にいるから"},
        { "location": "2665/TALK"    , "narrator": "神楽", "text": "ずっとですか"},
        { "location": "2666/TALK"    , "narrator": "神楽", "text": "照れちゃいますね♪"},
        { "location": "2667/ACT"     , "narrator": "", "text": "$me$は神楽の支えになりたい"},
        { "location": "2670/TALK"    , "narrator": "神楽", "text": "そうなってますよ♪"},
        { "location": "2671/ACT"     , "narrator": "", "text": "$me$は何が起こっても驚かない"},
        { "location": "2672/TALK"    , "narrator": "神楽", "text": "なんだか怖いですね？"},
        { "location": "2674/TALK"    , "narrator": "神楽", "text": "ホラーはちょっと苦手なんです♪"},
        { "location": "2676/TALK"    , "narrator": "神楽", "text": "でもなんで"},
        { "location": "2677/TALK"    , "narrator": "神楽", "text": "$handle$さんはそういうこと言うんですか？"},
        { "location": "2679/SEL"     , "narrator": "", "text": "神楽が心配だから"},
        { "location": "2680/SEL"     , "narrator": "", "text": "アイシテルから"},
        { "location": "2681/SEL"     , "narrator": "", "text": "運命を感じてるから"},
        { "location": "2682/ACT"     , "narrator": "", "text": "神楽が心配だから"},
        { "location": "2683/TALK"    , "narrator": "神楽", "text": "$handle$さんったらﾔｻｼｰ"},
        { "location": "2685/ACT"     , "narrator": "", "text": "アイシテルから"},
        { "location": "2687/TALK"    , "narrator": "神楽", "text": "照れちゃいますよ～～～～～～！！！！！"},
        { "location": "2688/ACT"     , "narrator": "", "text": "運命を感じてるから"},
        { "location": "2690/TALK"    , "narrator": "神楽", "text": "ぴょんこは$handle$さんのファム・ファタル、、、"},
        { "location": "2702/TALK"    , "narrator": "神楽", "text": "ふう……。"},
        { "location": "2707/TALK"    , "narrator": "神楽", "text": "今度こそ\n出なきゃ…。"},
        { "location": "2714/TALK"    , "narrator": "神楽", "text": "…はい。"},
        { "location": "2555/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>某月某日　8:12 PM</color>\nとある平日の夜、神楽の家にて"}
    ]
}
