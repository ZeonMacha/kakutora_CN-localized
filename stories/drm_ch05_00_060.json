    "entry":
    [
        { "location": "857/SCENARIO", "narrator": "", "text": "嘘つき娘はセンターに"},
        { "location": "882/TALK"    , "narrator": "神楽", "text": "アイドルグループのセンターに立つには条件があるんですよ知ってました？"},
        { "location": "883/TALK"    , "narrator": "神楽", "text": "その秘密を知りたくないですか？"},
        { "location": "885/SEL"     , "narrator": "", "text": "神楽はアイドルじゃなくてアーティストだよね"},
        { "location": "886/SEL"     , "narrator": "", "text": "グループじゃなくてピンでしょ神楽は"},
        { "location": "887/SEL"     , "narrator": "", "text": "怖いから聞きたくないな"},
        { "location": "888/ACT"     , "narrator": "", "text": "神楽はアイドルじゃなくてアーティストだよね"},
        { "location": "889/TALK"    , "narrator": "神楽", "text": "ぴょんこはそうですね"},
        { "location": "891/TALK"    , "narrator": "神楽", "text": "でもこれはぴょんこじゃなくてアイドルの話なんですっ♪"},
        { "location": "892/ACT"     , "narrator": "", "text": "グループじゃなくてピンでしょ神楽は"},
        { "location": "893/TALK"    , "narrator": "神楽", "text": "ピンって芸人みたいで微妙な感じがします、、、"},
        { "location": "894/TALK"    , "narrator": "神楽", "text": "あとこれはぴょんこの話じゃないんですよ？"},
        { "location": "895/ACT"     , "narrator": "", "text": "怖いから聞きたくないな"},
        { "location": "896/TALK"    , "narrator": "神楽", "text": "$handle$さんはゴシップとかお嫌いなのですねっ♪"},
        { "location": "897/TALK"    , "narrator": "神楽", "text": "そういうの素敵ですっ♪"},
        { "location": "901/TALK"    , "narrator": "神楽", "text": "センターにいる子ってかわいいし歌えるし笑いも取れますよね"},
        { "location": "902/TALK"    , "narrator": "神楽", "text": "どうしてでしょうか"},
        { "location": "904/SEL"     , "narrator": "", "text": "計算できるからでしょ"},
        { "location": "905/SEL"     , "narrator": "", "text": "センスがいいんじゃない"},
        { "location": "906/SEL"     , "narrator": "", "text": "生まれ持っての才能かな"},
        { "location": "907/ACT"     , "narrator": "", "text": "計算できるからでしょ"},
        { "location": "908/TALK"    , "narrator": "神楽", "text": "もちろんもちろん"},
        { "location": "909/TALK"    , "narrator": "神楽", "text": "ただその計算をどうやってるかってお話なんですっ♪"},
        { "location": "910/ACT"     , "narrator": "", "text": "センスがいいんじゃない"},
        { "location": "911/TALK"    , "narrator": "神楽", "text": "センスですよね～～～"},
        { "location": "913/TALK"    , "narrator": "神楽", "text": "それをどうやって磨いたかってアレなのぴょん"},
        { "location": "914/ACT"     , "narrator": "", "text": "生まれ持っての才能かな"},
        { "location": "915/TALK"    , "narrator": "神楽", "text": "それが実はそうじゃないんです"},
        { "location": "917/TALK"    , "narrator": "神楽", "text": "っていうお話なんですけど"},
        { "location": "919/TALK"    , "narrator": "神楽", "text": "実はセンターに立つには"},
        { "location": "920/TALK"    , "narrator": "神楽", "text": "呪いを受けないといけないんですよ！"},
        { "location": "921/TALK"    , "narrator": "神楽", "text": "神様による呪いを"},
        { "location": "923/SEL"     , "narrator": "", "text": "むしろ悪魔でしょそれ"},
        { "location": "924/SEL"     , "narrator": "", "text": "祝福という名の呪い…？"},
        { "location": "925/SEL"     , "narrator": "", "text": "騙されてる！！！"},
        { "location": "926/ACT"     , "narrator": "", "text": "むしろ悪魔でしょそれ"},
        { "location": "927/TALK"    , "narrator": "神楽", "text": "人知を越えた存在は神であり、同時に悪魔とも呼ばれるものなんですっ！"},
        { "location": "928/ACT"     , "narrator": "", "text": "祝福という名の呪い…？"},
        { "location": "929/TALK"    , "narrator": "神楽", "text": "あっそれそれ"},
        { "location": "932/ACT"     , "narrator": "", "text": "騙されてる！！！"},
        { "location": "933/TALK"    , "narrator": "神楽", "text": "騙されてるかどうかは本人が決めることではないでしょうか、、、、？"},
        { "location": "935/TALK"    , "narrator": "神楽", "text": "その呪いは才能と引き替えに寿命が縮むというものなんです"},
        { "location": "936/TALK"    , "narrator": "神楽", "text": "言うならば才能と寿命との等価交換"},
        { "location": "938/SEL"     , "narrator": "", "text": "いや等価になってないよ！？"},
        { "location": "939/SEL"     , "narrator": "", "text": "美しく散り、潔く死ぬのか…"},
        { "location": "940/SEL"     , "narrator": "", "text": "神楽はそんな呪い受けてないよね！？"},
        { "location": "941/ACT"     , "narrator": "", "text": "いや等価になってないよ！？"},
        { "location": "942/TALK"    , "narrator": "神楽", "text": "それは素人考えというやつかもしれませんね"},
        { "location": "943/TALK"    , "narrator": "神楽", "text": "センターに立てるなら等価どころかおつりが来ると思う人間でないとセンターには立てないぴょん"},
        { "location": "944/ACT"     , "narrator": "", "text": "美しく散り、潔く死ぬのか…"},
        { "location": "945/TALK"    , "narrator": "神楽", "text": "そういうことになりますね♪"},
        { "location": "946/TALK"    , "narrator": "神楽", "text": "一瞬のきらめきに全てをかけてセンターに立つのですよ"},
        { "location": "947/ACT"     , "narrator": "", "text": "神楽はそんな呪い受けてないよね！？"},
        { "location": "948/TALK"    , "narrator": "神楽", "text": "もちろんですよー！"},
        { "location": "949/TALK"    , "narrator": "神楽", "text": "ぴょんこは自前の才能だけでアーティストになってるんですからねっ♪"},
        { "location": "953/TALK"    , "narrator": "神楽", "text": "世の中のセンターたちはそこまで身を削ってその場所に立ってるんだぴょん"},
        { "location": "954/TALK"    , "narrator": "神楽", "text": "これこそ見上げたプロ魂というべきでしょう"},
        { "location": "956/SEL"     , "narrator": "", "text": "都市伝説だよね？"},
        { "location": "957/SEL"     , "narrator": "", "text": "またまたそんな嘘ばっかり"},
        { "location": "958/SEL"     , "narrator": "", "text": "神楽はそんなことしないでね"},
        { "location": "959/ACT"     , "narrator": "", "text": "都市伝説だよね？"},
        { "location": "960/TALK"    , "narrator": "神楽", "text": "そうとも言い切れないんですよ、、、"},
        { "location": "961/TALK"    , "narrator": "神楽", "text": "あの世界は、、、"},
        { "location": "962/ACT"     , "narrator": "", "text": "またまたそんな嘘ばっかり"},
        { "location": "963/TALK"    , "narrator": "神楽", "text": "そんなこと言って本当だったらどうしましょうね？"},
        { "location": "964/ACT"     , "narrator": "", "text": "神楽はそんなことしないでね"},
        { "location": "965/TALK"    , "narrator": "神楽", "text": "心配してくれてるんですねっ♪"},
        { "location": "966/TALK"    , "narrator": "神楽", "text": "ぴょんこは嬉しくて泣いちゃいます～～～～ｳﾙｳﾙ"},
        { "location": "968/TALK"    , "narrator": "神楽", "text": "まあそんなことでセンターが取れるなら苦労はしないですけどね★"},
        { "location": "969/TALK"    , "narrator": "神楽", "text": "神頼みなんかでどうにかなるわけがないですし"},
        { "location": "970/TALK"    , "narrator": "神楽", "text": "そうは思いませんか？"},
        { "location": "972/SEL"     , "narrator": "", "text": "いや、結構壮絶だと思う"},
        { "location": "973/SEL"     , "narrator": "", "text": "確かにそうかな"},
        { "location": "974/SEL"     , "narrator": "", "text": "神楽には天寿を全うして欲しい"},
        { "location": "975/ACT"     , "narrator": "", "text": "いや、結構壮絶だと思う"},
        { "location": "976/TALK"    , "narrator": "神楽", "text": "そうかもしれませんね？"},
        { "location": "977/TALK"    , "narrator": "神楽", "text": "実際にやってみないとなんとも言えないですけど、、、"},
        { "location": "978/ACT"     , "narrator": "", "text": "確かにそうかな"},
        { "location": "979/TALK"    , "narrator": "神楽", "text": "そうなんですよねっ♪"},
        { "location": "980/TALK"    , "narrator": "神楽", "text": "そんなに甘い世界じゃないんですよ、ショウビジネスは"},
        { "location": "981/ACT"     , "narrator": "", "text": "神楽には天寿を全うして欲しい"},
        { "location": "982/TALK"    , "narrator": "神楽", "text": "共に白髪が生えるまで？"},
        { "location": "983/TALK"    , "narrator": "神楽", "text": "うーん想像つかないです、、、"},
        { "location": "984/TALK"    , "narrator": "神楽", "text": "まだ全然"}
    ]
}
