{
    "dir": "chap00/daydra/spev_notice_cd_01_02.js",
    "type": "",
    "info": {
        "story_id": "91052",
        "cid": "",
        "title": "002 アフターストーリー",
        "sub_title": "ホワイエにカップ１つ"
    },
    "entry":
    [
        { "location": "471/DIALOG", "narrator": "", "text": "<color=green>某月某日　3:12 PM</color>\nとある休日、神楽坂トライナリー楽屋にて。"},
        { "location": "472/TALK"  , "narrator": "アーヤ", "text": "――まあ、必要な分担は\nこんなところかしら？"},
        { "location": "473/TALK"  , "narrator": "つばめ", "text": "えっと、料理準備担当、\n飲み物担当、接客担当――"},
        { "location": "474/TALK"  , "narrator": "つばめ", "text": "それにインテリア担当と、\nイベント担当？"},
        { "location": "476/TALK"  , "narrator": "アーヤ", "text": "せっかく劇場でカフェを\nやるんだもの。"},
        { "location": "478/TALK"  , "narrator": "アーヤ", "text": "他ではできないような\nイベントを開催しないと\n勿体ないでしょ？"},
        { "location": "480/TALK"  , "narrator": "つばめ", "text": "なるほどー。"},
        { "location": "482/TALK"  , "narrator": "ガブリエラ", "text": "質問なんだけど、\n料理と飲み物って\n一緒じゃダメなの？"},
        { "location": "484/TALK"  , "narrator": "アーヤ", "text": "カフェである以上は\n飲み物にも凝りたいわ。"},
        { "location": "485/TALK"  , "narrator": "アーヤ", "text": "紅茶の種類はもちろん\nだけど、コーヒーも\nラテとかやりたいし。"},
        { "location": "487/TALK"  , "narrator": "神楽", "text": "ラテアートとかですか？"},
        { "location": "488/TALK"  , "narrator": "アーヤ", "text": "あ、それいいわね！"},
        { "location": "490/TALK"  , "narrator": "つばめ", "text": "えっ、アーヤさん\nできるんですか！？"},
        { "location": "492/TALK"  , "narrator": "アーヤ", "text": "の、飲んだことはあるん\nだけれど、自分で描くのは\nちょっと…。"},
        { "location": "494/TALK"  , "narrator": "みやび", "text": "ちゅうか、この中だと\nもう確実に決まりっちゅう\nのがあるな。"},
        { "location": "497/TALK"  , "narrator": "ガブリエラ", "text": "どれのこと？"},
        { "location": "499/TALK"  , "narrator": "みやび", "text": "イベント担当や。"},
        { "location": "500/TALK"  , "narrator": "みやび", "text": "これはもう卯月しか\nおらんやろうね。"},
        { "location": "502/TALK"  , "narrator": "神楽", "text": "…え？"},
        { "location": "504/TALK"  , "narrator": "つばめ", "text": "あ、なるほど！\nイベントなら神楽ちゃんが\n一番詳しいですよね！"},
        { "location": "506/TALK"  , "narrator": "みやび", "text": "そういうことや。\nちゅーわけやき、\n頼むぞね。"},
        { "location": "508/TALK"  , "narrator": "神楽", "text": "えぇーっ！？\nそんなの無理ですよ！"},
        { "location": "510/TALK"  , "narrator": "アーヤ", "text": "あら？　でも自分でも\nイベントの企画したこと\nあるんでしょ？"},
        { "location": "513/TALK"  , "narrator": "つばめ", "text": "はい！　その時の\nイベント、ＤＶＤで\n見ましたけど…。"},
        { "location": "514/TALK"  , "narrator": "つばめ", "text": "とってもスゴかったです！"},
        { "location": "516/TALK"  , "narrator": "神楽", "text": "で、でも、カフェの\nイベントとは違うから…。"},
        { "location": "518/TALK"  , "narrator": "ガブリエラ", "text": "カフェの経営なんて、\nここにいる全員が\n初めてなんだから…。"},
        { "location": "519/TALK"  , "narrator": "ガブリエラ", "text": "そんな理由却下よ。\nはい、イベント担当は\n神楽に決定！"},
        { "location": "521/TALK"  , "narrator": "神楽", "text": "えぇーっ！？"},
        { "location": "523/TALK"  , "narrator": "みやび", "text": "ついでに、この話し合いの\n進行役も任せるぞね。"},
        { "location": "525/TALK"  , "narrator": "神楽", "text": "いや、それこそ\nどうして私なんですか！？"},
        { "location": "526/TALK"  , "narrator": "みやび", "text": "担当が決まった卯月が\nやった方が、スムーズに\n進むやろ。"},
        { "location": "528/TALK"  , "narrator": "アーヤ", "text": "私もみやびに賛成。\nそういうわけだから、\n進行役はお願いね。"},
        { "location": "529/TALK"  , "narrator": "神楽", "text": "…ほ、本気ですか？"},
        { "location": "530/TALK"  , "narrator": "アーヤ", "text": "本気よ。"},
        { "location": "531/TALK"  , "narrator": "みやび", "text": "マジや。"},
        { "location": "532/TALK"  , "narrator": "ガブリエラ", "text": "頑張んなさい。"},
        { "location": "533/TALK"  , "narrator": "つばめ", "text": "神楽ちゃん、がんばれー！"},
        { "location": "536/TALK"  , "narrator": "神楽", "text": "…もう、みなさんちょっと\n強引すぎますよ…。"},
        { "location": "539/TALK"  , "narrator": "神楽", "text": "でも、任せたからには、\n進行役の話はちゃんと\n聞いてくださいね。"},
        { "location": "540/TALK"  , "narrator": "みやび", "text": "あいあい、従うぞね。"},
        { "location": "542/TALK"  , "narrator": "神楽", "text": "…じゃあ、まずは\nカフェのメインである、\n飲み物から決めましょう。"},
        { "location": "544/TALK"  , "narrator": "ガブリエラ", "text": "さっきの話の続きね。\nで、誰かやりたい人は\nいないの？"},
        { "location": "546/TALK"  , "narrator": "神楽", "text": "あの、私はこの担当は\nみやびさんが適任かと\n思うんです。"},
        { "location": "549/TALK"  , "narrator": "みやび", "text": "…うち、コーヒーは\nあんまし飲まんけんど？"},
        { "location": "550/TALK"  , "narrator": "神楽", "text": "種類によっては\nちょっとだけ手を入れる\n必要がありますけど…。"},
        { "location": "551/TALK"  , "narrator": "神楽", "text": "基本的にマシンが\n抽出してくれるので、\n大丈夫ですよ。"},
        { "location": "553/TALK"  , "narrator": "ガブリエラ", "text": "それじゃあ、みやびが\n担当する必要って\nないんじゃない？"},
        { "location": "554/TALK"  , "narrator": "神楽", "text": "いえ…もし本当に\nラテアートをするような\nことになるのであれば…。"},
        { "location": "555/TALK"  , "narrator": "神楽", "text": "複雑で、手の込んだ\n和食を作れる器用さが\n活きると思うんですよ。"},
        { "location": "559/TALK"  , "narrator": "みやび", "text": "ふむ…そう言われると、\nなんとなく挑戦しようっ\nちゅう気持ちになるぞね。"},
        { "location": "561/TALK"  , "narrator": "神楽", "text": "それじゃあ…。"},
        { "location": "564/TALK"  , "narrator": "みやび", "text": "うむ、飲み物担当\n引き受けたぞね。"},
        { "location": "566/TALK"  , "narrator": "ガブリエラ", "text": "でも、みやびは\n料理担当の方が\nいいんじゃないかしら？"},
        { "location": "568/TALK"  , "narrator": "神楽", "text": "いえ、料理担当は\nアーヤさんに\nお願いしたいと思います。"},
        { "location": "570/TALK"  , "narrator": "アーヤ", "text": "わ、私？"},
        { "location": "572/TALK"  , "narrator": "神楽", "text": "アーヤさん、カフェの\nメニューにはとっても\n詳しいですよね？"},
        { "location": "573/TALK"  , "narrator": "神楽", "text": "趣味で色んなカフェに\n行ってますし。"},
        { "location": "576/TALK"  , "narrator": "アーヤ", "text": "そうだけど、\nそれと作るのは\n別だと思うわ。"},
        { "location": "578/TALK"  , "narrator": "神楽", "text": "難しい料理を出すんじゃ\nありません。"},
        { "location": "579/TALK"  , "narrator": "神楽", "text": "アーヤさんだけでなく、\n私たちの誰でも簡単に\n作れるような…。"},
        { "location": "580/TALK"  , "narrator": "神楽", "text": "そんなお手軽メニューを\n考えてほしいんです。"},
        { "location": "582/TALK"  , "narrator": "つばめ", "text": "そっか…わたし達全員が\n作れるようなのじゃないと\nダメなんだよね？"},
        { "location": "584/TALK"  , "narrator": "神楽", "text": "はい。実際に開店したら、\n一人で厨房を任せるなんて\nまず不可能ですから。"},
        { "location": "585/TALK"  , "narrator": "神楽", "text": "もちろん、みやびさんの\n飲み物に関しても\nそれは同じですけど。"},
        { "location": "587/TALK"  , "narrator": "アーヤ", "text": "なるほどね。\n簡単で美味しいのだと\nすると、うーん…。"},
        { "location": "589/TALK"  , "narrator": "アーヤ", "text": "…わかったわ。\n一度、試作メニューを\n作ってみる。"},
        { "location": "592/TALK"  , "narrator": "神楽", "text": "それじゃあ、料理担当は\nこれで決まりですね。"},
        { "location": "594/TALK"  , "narrator": "つばめ", "text": "す、すごいね。\nもう二つ決まっちゃった。"},
        { "location": "596/TALK"  , "narrator": "神楽", "text": "三つ目はインテリア担当\nですけど、これは…。"},
        { "location": "598/TALK"  , "narrator": "ガブリエラ", "text": "あ、それあたしが\nやってみたいんだけど。"},
        { "location": "600/TALK"  , "narrator": "つばめ", "text": "え？　どうして？"},
        { "location": "602/TALK"  , "narrator": "ガブリエラ", "text": "あたし、インテリアを\nこだわってみたいな、\nって思ってるの。"},
        { "location": "604/TALK"  , "narrator": "ガブリエラ", "text": "だから、つばめが\nイヤじゃなければ…。"},
        { "location": "605/TALK"  , "narrator": "ガブリエラ", "text": "接客担当をつばめに\nやってもらいたいん\nだけど…。"},
        { "location": "607/TALK"  , "narrator": "つばめ", "text": "全然イヤじゃないよ！"},
        { "location": "608/TALK"  , "narrator": "つばめ", "text": "自分じゃ決められなかった\nから、そう言ってもらえて\n助かっちゃった。"},
        { "location": "610/TALK"  , "narrator": "アーヤ", "text": "ってことは…、\nとりあえず役割分担は\nコレで決まりね。"},
        { "location": "612/TALK"  , "narrator": "みやび", "text": "随分トントン拍子に\n進みゆうなぁ。"},
        { "location": "613/TALK"  , "narrator": "つばめ", "text": "神楽ちゃんスゴいよ。\nあっという間に色んなこと\n決めちゃうなんて。"},
        { "location": "615/TALK"  , "narrator": "神楽", "text": "皆さんの得意なモノを\n知っていたおかげですよ。"},
        { "location": "616/TALK"  , "narrator": "神楽", "text": "…そういえば、\n皆さんロゴの方は\n完成したんですか？"},
        { "location": "618/TALK"  , "narrator": "つばめ", "text": "い、一応…。\n神楽ちゃんは？"},
        { "location": "619/TALK"  , "narrator": "神楽", "text": "じゃあ、まずは私から\nお見せしますね。"},
        { "location": "626/TALK"  , "narrator": "神楽", "text": "これなんですけど、\nどうでしょうか？"},
        { "location": "629/TALK"  , "narrator": "アーヤ", "text": "えぇっ！？"},
        { "location": "631/TALK"  , "narrator": "神楽", "text": "あっ…もしかして、\n変でしたか？"},
        { "location": "634/TALK"  , "narrator": "アーヤ", "text": "あ、ううん。\nそうじゃないの。"},
        { "location": "635/TALK"  , "narrator": "アーヤ", "text": "まさか、卯月も色を\n付けてくるとは\n思わなくて…。"},
        { "location": "640/TALK"  , "narrator": "アーヤ", "text": "コレが私のよ。"},
        { "location": "642/TALK"  , "narrator": "神楽", "text": "アーヤさんも\nロゴに色を付けたん\nですか？"},
        { "location": "644/TALK"  , "narrator": "アーヤ", "text": "真ん中のロゴ描いたら、\n色を入れた方が\n栄えると思って…。"},
        { "location": "648/TALK"  , "narrator": "ガブリエラ", "text": "アーヤが風車で、\n神楽が銀杏…。"},
        { "location": "650/TALK"  , "narrator": "ガブリエラ", "text": "…やっぱり、みんな\n和風な感じにしたのね。"},
        { "location": "652/TALK"  , "narrator": "アーヤ", "text": "じゃあ、ギャヴィも？"},
        { "location": "654/TALK"  , "narrator": "ガブリエラ", "text": "まあね。\nあたしのは、ほら…。"},
        { "location": "659/TALK"  , "narrator": "つばめ", "text": "あっ、鶴だ！"},
        { "location": "661/TALK"  , "narrator": "ガブリエラ", "text": "ふふん、どう？\n風流な感じがすると\n思わない？"},
        { "location": "663/TALK"  , "narrator": "つばめ", "text": "うん、すっごい感じるよ！\n風流だね！！"},
        { "location": "665/TALK"  , "narrator": "みやび", "text": "つばめちゃん、\n風流がどんなもんか\nわかってないやろ…？"},
        { "location": "668/TALK"  , "narrator": "神楽", "text": "そういえば、みやびさんは\nこの前描いたのが\n完成形ですか？"},
        { "location": "670/TALK"  , "narrator": "みやび", "text": "…いや、さすがにあれじゃ\n寂しすぎる思うてな。"},
        { "location": "676/TALK"  , "narrator": "みやび", "text": "色を塗ってみたがよ。"},
        { "location": "678/TALK"  , "narrator": "ガブリエラ", "text": "うわっ、紫超綺麗！！"},
        { "location": "680/TALK"  , "narrator": "みやび", "text": "見ようによっては\n毒沼色やけんどな。"},
        { "location": "682/TALK"  , "narrator": "ガブリエラ", "text": "それ、お客さんの前では\n絶対言わないでよ？"},
        { "location": "686/TALK"  , "narrator": "つばめ", "text": "じゃあ、\n最後はわたしだね。"},
        { "location": "691/TALK"  , "narrator": "つばめ", "text": "紅葉なんですけど…、\nどうかな？"},
        { "location": "693/TALK"  , "narrator": "アーヤ", "text": "とっても素敵よ。\n色も紅葉とピッタリだし。"},
        { "location": "695/TALK"  , "narrator": "神楽", "text": "私もそう思います。\nいいロゴですね。"},
        { "location": "697/TALK"  , "narrator": "つばめ", "text": "えへへ…。"},
        { "location": "698/TALK"  , "narrator": "つばめ", "text": "でも、みんなロゴの色が\n違ってよかったよね。"},
        { "location": "700/TALK"  , "narrator": "ガブリエラ", "text": "それにしても、\nビックリよね。"},
        { "location": "701/TALK"  , "narrator": "ガブリエラ", "text": "打ち合わせしたわけじゃ\nないのに、みんな色が\n被らなかったなんて…。"},
        { "location": "704/TALK"  , "narrator": "アーヤ", "text": "好みがバラバラだったのが\n幸いしたわね。"},
        { "location": "707/TALK"  , "narrator": "つばめ", "text": "じゃあ、あとは\nこのロゴを食器に\n印刷すれば完成？"},
        { "location": "709/TALK"  , "narrator": "神楽", "text": "つばめさん。\n重要なことを\n忘れてますよ。"},
        { "location": "710/TALK"  , "narrator": "神楽", "text": "誰のロゴを、どの食器に\n印刷するのかを\n決めるのが先です。"},
        { "location": "712/TALK"  , "narrator": "つばめ", "text": "あ、そっか。"},
        { "location": "714/TALK"  , "narrator": "みやび", "text": "なんや、みんな希望の\n食器があるんかね？"},
        { "location": "715/TALK"  , "narrator": "アーヤ", "text": "ん～…あるにはあるけど、\nまだ一つに絞り込めて\nないのよね…。"},
        { "location": "717/TALK"  , "narrator": "ガブリエラ", "text": "食器は今日じゃなくても\nいいんじゃない？"},
        { "location": "718/TALK"  , "narrator": "ガブリエラ", "text": "それぞれの担当を決めて、\nロゴまで作ったんだし。"},
        { "location": "719/TALK"  , "narrator": "ガブリエラ", "text": "第一、開店する日だって\nまだ決まってないん\nだから…。"},
        { "location": "720/TALK"  , "narrator": "ガブリエラ", "text": "開店に向けての準備を\nしながら決めてけば\nいいと思うけど？"},
        { "location": "722/TALK"  , "narrator": "みやび", "text": "まあ、一日で全部決めても\n面白くないきね。"},
        { "location": "723/TALK"  , "narrator": "みやび", "text": "それに、いくつか候補が\nある子もおるようやし、\nそれでえいと思うよ。"},
        { "location": "725/TALK"  , "narrator": "神楽", "text": "じゃあ、食器を決めるのは\nまた後日にしましょう。"},
        { "location": "726/TALK"  , "narrator": "神楽", "text": "各自、自分の担当箇所の\n準備を進めつつ…。"},
        { "location": "727/TALK"  , "narrator": "神楽", "text": "どの食器にするかを\n決めるということで。"},
        { "location": "729/TALK"  , "narrator": "アーヤ", "text": "それでいいと思うわ。"},
        { "location": "731/TALK"  , "narrator": "みやび", "text": "ん、文句なしや。"},
        { "location": "732/TALK"  , "narrator": "神楽", "text": "では、皆さん。\n担当箇所の準備、\nよろしくお願いしますね。"},
        { "location": "734/TALK"  , "narrator": "つばめ", "text": "うん、がんばるよ！"},
        { "location": "736/TALK"  , "narrator": "アーヤ", "text": "あ、そうだ。\nついでにもう一つ、\nお願いがあるんだけど…。"},
        { "location": "738/TALK"  , "narrator": "神楽", "text": "はい、なんですか？"},
        { "location": "740/TALK"  , "narrator": "アーヤ", "text": "開店までの話なんだけど、\nそれまで全員を仕切る\n役割を――"},
        { "location": "755/TALK"  , "narrator": "神楽", "text": "ただいま…。"},
        { "location": "757/TALK"  , "narrator": "神楽", "text": "はぁ…。"},
        { "location": "769/TALK"  , "narrator": "神楽", "text": "もぅﾏﾁﾞ無理。ﾘｽｶしょ"},
        { "location": "771/SEL"   , "narrator": "（選択肢）", "text": "気にしすぎじゃね？"},
        { "location": "772/SEL"   , "narrator": "（選択肢）", "text": "みんなほんとに神楽のこと好きだと思うよ？"},
        { "location": "773/SEL"   , "narrator": "（選択肢）", "text": "じゃあ、一緒にしょ？"},
        { "location": "774/ACT"   , "narrator": "", "text": "気にしすぎじゃね？"},
        { "location": "775/TALK"  , "narrator": "神楽", "text": "神視点か"},
        { "location": "776/TALK"  , "narrator": "神楽", "text": "まあ、他人事だとそうなりますよねー"},
        { "location": "777/ACT"   , "narrator": "", "text": "みんなほんとに神楽のこと好きだと思うよ？"},
        { "location": "778/TALK"  , "narrator": "神楽", "text": "地上が常世の楽園でも、その地下１ｍまでマグマが迫ってることなんて日常茶飯事なのです"},
        { "location": "779/TALK"  , "narrator": "神楽", "text": "そう、それは水に流したわけでも許したわけでもなく、ただ背後に隠すことにしただけ"},
        { "location": "780/ACT"   , "narrator": "", "text": "じゃあ、一緒にしょ？"},
        { "location": "781/TALK"  , "narrator": "神楽", "text": "I・YA・DE・SU★"},
        { "location": "782/TALK"  , "narrator": "神楽", "text": "ほんとにするなら一人の方がまだマシ"},
        { "location": "784/TALK"  , "narrator": "神楽", "text": "つらいようー\nえーんえーん"},
