{
    "dir": "chap13/daydra/dd_ch04_13_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "13452",
        "cid": "miyabi",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "怪獣映画"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "怪獣映画"},
        { "location": "32/TALK"   , "narrator": "キリト", "text": "おっ、このＣＭは！？\nヒカル、見ろよ！"},
        { "location": "34/TALK"   , "narrator": "ヒカル", "text": "えっ、ガズェラ！？\nまさか新作がやるん\nですか！？"},
        { "location": "36/TALK"   , "narrator": "アーヤ", "text": "ガズェラって、\n昔の恐竜映画だった\nかしら？"},
        { "location": "38/TALK"   , "narrator": "キリト", "text": "違うっすよ！\n恐竜じゃなくて怪獣。"},
        { "location": "39/TALK"   , "narrator": "キリト", "text": "デカくて強くて凶暴で、\n口から火を吐くような\nヤツっす。"},
        { "location": "42/TALK"   , "narrator": "雛", "text": "ふーん…火を吐くのが\n怪獣なんだ？"},
        { "location": "44/TALK"   , "narrator": "キリト", "text": "いや、そうじゃなくて、\n恐竜と怪獣は別物なん\nだよ。"},
        { "location": "47/TALK"   , "narrator": "みやび", "text": "はぁ…腹が減ったき、\nお菓子か何かある？"},
        { "location": "48/TALK"   , "narrator": "つばめ", "text": "あ、みやびさん。\nお疲れ様です。"},
        { "location": "49/TALK"   , "narrator": "キリト", "text": "みやび先輩。\nガズェラは恐竜だと\n思いますか？"},
        { "location": "51/TALK"   , "narrator": "みやび", "text": "あれは怪獣やね。\n口からグワーッと\n火ぃ吐きよるし。"},
        { "location": "54/TALK"   , "narrator": "キリト", "text": "さっすがみやび先輩！"},
        { "location": "56/TALK"   , "narrator": "雛", "text": "っていうか、あたし達に\n怪獣映画の話されても、\nわからないって。"},
        { "location": "57/TALK"   , "narrator": "雛", "text": "女の子は基本的に、\nこういう映画には\n興味ないんだし。"},
        { "location": "59/TALK"   , "narrator": "キリト", "text": "電車オタのおまえが\n言ってもなぁ…。"},
        { "location": "62/TALK"   , "narrator": "ヒカル", "text": "みなさん、本当に\nガズェラシリーズを\n見たことないんですか？"},
        { "location": "63/TALK"   , "narrator": "ヒカル", "text": "怪獣映画ではありますが、\n世界的に有名な作品だと\nいうのに…。"},
        { "location": "66/TALK"   , "narrator": "つばめ", "text": "う～ん…お父さんが前に、\n白黒のを見てたことが\nあったような…。"},
        { "location": "68/TALK"   , "narrator": "アーヤ", "text": "私はＣＭくらいでしか\n知らないわ。"},
        { "location": "70/TALK"   , "narrator": "ヒカル", "text": "…なるほど。\nどうやら女性受けは\n良くないみたいですね。"},
        { "location": "73/TALK"   , "narrator": "キリト", "text": "あー、勿体ねぇなぁ。\n怪獣映画の楽しさを\n知らねぇなんて…。"},
        { "location": "75/TALK"   , "narrator": "雛", "text": "怪獣が暴れて街を\n壊すだけでしょ？"},
        { "location": "77/TALK"   , "narrator": "キリト", "text": "いや、まあ一体しか出ない\nやつはそうだけどさ…。"},
        { "location": "78/TALK"   , "narrator": "キリト", "text": "けど、見てるとマジで\nワクワクしちまうんだよ。"},
        { "location": "80/TALK"   , "narrator": "ヒカル", "text": "そうですね。\n僕も、見ていると手に\n力が入ってしまいますし。"},
        { "location": "81/TALK"   , "narrator": "みやび", "text": "ヒカル君がそうなるんは、\nちっくと驚きや。"},
        { "location": "85/TALK"   , "narrator": "ヒカル", "text": "あはは…恥ずかしい\n話ですが、今でも本当に\n好きなんです。"},
        { "location": "87/TALK"   , "narrator": "キリト", "text": "男なら当然だろ？"},
        { "location": "89/TALK"   , "narrator": "キリト", "text": "こんなのがマジでいたら、\nとか想像しながら見ると、\n超燃えるよな！？"},
        { "location": "91/TALK"   , "narrator": "ヒカル", "text": "ええ、わかります。"},
        { "location": "92/TALK"   , "narrator": "雛", "text": "いや、燃えないって。\n本当にいたら\n家が壊れるじゃん。"},
        { "location": "94/TALK"   , "narrator": "つばめ", "text": "寝てるときに出たら、\n足音だけでも凄く\nうるさそうだよ？"},
        { "location": "96/TALK"   , "narrator": "アーヤ", "text": "安心して暮らせないわね。"},
        { "location": "98/TALK"   , "narrator": "ヒカル", "text": "…冷静に突っ込まれて\nしまいましたね。"},
        { "location": "100/TALK"  , "narrator": "キリト", "text": "く、くそぉ…\nやっぱ女に怪獣映画の\n熱さはわからねぇのか…？"},
        { "location": "102/TALK"  , "narrator": "みやび", "text": "…実際にいたら、か。"},
        { "location": "114/TALK"  , "narrator": "みやび", "text": "なんか面白い話しちょるき、相棒にもおすそ分けや"},
        { "location": "116/TALK"  , "narrator": "みやび", "text": "映画に出てくるような怪獣がリアルにいたら、やっぱりワクワクするもんなが？"},
        { "location": "117/TALK"  , "narrator": "みやび", "text": "うちはアーヤ達と同じで、いても面倒なことにしかならんと思うんやけんど…"},
        { "location": "119/SEL"   , "narrator": "", "text": "ステーキ沢山作れそう"},
        { "location": "120/SEL"   , "narrator": "", "text": "怪獣が発症したらヤバいね"},
        { "location": "121/SEL"   , "narrator": "", "text": "怪獣映画、興味ないの？"},
        { "location": "122/ACT"   , "narrator": "", "text": "ステーキ沢山作れそう"},
        { "location": "124/TALK"  , "narrator": "みやび", "text": "…相棒の思考回路は、理解できんな"},
        { "location": "125/TALK"  , "narrator": "みやび", "text": "けんど、怪獣ステーキかぁ…"},
        { "location": "126/TALK"  , "narrator": "みやび", "text": "腹ペコなせいか、美味そうに思えてきたわ"},
        { "location": "138/TALK"  , "narrator": "キリト", "text": "…そういえば、\nみやび先輩は\nどう思うっすか？"},
        { "location": "140/TALK"  , "narrator": "みやび", "text": "ん…食糧難には\n困らなそうやね。"},
        { "location": "141/TALK"  , "narrator": "みやび", "text": "あれだけデカいんやし、\n肉取り放題やと思うし。"},
        { "location": "143/TALK"  , "narrator": "ヒカル", "text": "た、食べたいんですか！？"},
        { "location": "145/TALK"  , "narrator": "アーヤ", "text": "家畜じゃないんだから…\nまあ、確かに大量の肉が\n手に入ると思うけど…。"},
        { "location": "147/TALK"  , "narrator": "雛", "text": "でも、怪獣のお肉って\n硬くて不味そうですよ？"},
        { "location": "149/TALK"  , "narrator": "みやび", "text": "味付けと下ごしらえを\nしっかりすれば、\nきっと美味しくなるちや。"},
        { "location": "151/TALK"  , "narrator": "つばめ", "text": "でも、怪獣ってことは\n捕まえるのに軍隊とかが\n出てくるんですよね？"},
        { "location": "152/TALK"  , "narrator": "つばめ", "text": "ミサイルとかの欠片が\n入ってそうで、何となく\n食欲失せちゃいます…。"},
        { "location": "155/TALK"  , "narrator": "ヒカル", "text": "…怪獣映画の話が、\n怪獣を食べる話に\nなってしまいましたね。"},
        { "location": "156/TALK"  , "narrator": "キリト", "text": "興味ないって言ったのに、\n食うことになった瞬間\n盛り上がるとか――"},
        { "location": "158/TALK"  , "narrator": "キリト", "text": "ガールズトークってのは、\n俺達には理解できねぇな。"},
        { "location": "159/ACT"   , "narrator": "", "text": "怪獣が発症したらヤバいね"},
        { "location": "161/TALK"  , "narrator": "みやび", "text": "あ～、その可能性があったなぁ"},
        { "location": "162/TALK"  , "narrator": "みやび", "text": "確かにそれはマズいぞね"},
        { "location": "173/TALK"  , "narrator": "みやび", "text": "…リアルに怪獣がいたと\n仮定して――"},
        { "location": "174/TALK"  , "narrator": "みやび", "text": "そいつがフェノメノンを\n発症するかもしれんと\n思うと――"},
        { "location": "175/TALK"  , "narrator": "みやび", "text": "うちもワクワクは\nできんな。"},
        { "location": "177/TALK"  , "narrator": "雛", "text": "え？　フェノメノンって\n怪獣も発症するんですか？"},
        { "location": "180/TALK"  , "narrator": "アーヤ", "text": "いや、存在しないものが\n発症するかどうかなんて\nわからないって。"},
        { "location": "181/TALK"  , "narrator": "アーヤ", "text": "…まあ、猫や犬が\n発症した、って\n記録はないから――"},
        { "location": "182/TALK"  , "narrator": "アーヤ", "text": "もし実際にいたとしても、\n多分発症はしないん\nじゃないかしら？"},
        { "location": "184/TALK"  , "narrator": "みやび", "text": "けんど、もし怪獣が\n本当に存在して――"},
        { "location": "186/TALK"  , "narrator": "みやび", "text": "それがもし発症したら、\n真っ先に出撃要請が\n掛かるんはどこやと思う？"},
        { "location": "188/TALK"  , "narrator": "ヒカル", "text": "…みやび先輩達、ですか？"},
        { "location": "190/TALK"  , "narrator": "みやび", "text": "そういうことや。"},
        { "location": "193/TALK"  , "narrator": "みやび", "text": "そう考えると、\nワクワクなんてできんよ。"},
        { "location": "194/TALK"  , "narrator": "雛", "text": "…そうですね。\nていうか、それって\n勝てるんですか？"},
        { "location": "195/TALK"  , "narrator": "アーヤ", "text": "勝ち負け以前の問題よ！\nさすがに、そんなのとは\n戦いたくないわ。"},
        { "location": "197/TALK"  , "narrator": "キリト", "text": "…なあ、ヒカル。\nもう女の前で怪獣映画の\n話するの、やめような。"},
        { "location": "199/TALK"  , "narrator": "ヒカル", "text": "同感です…。\nここまで話がズレるとは、\n予想外でした。"},
        { "location": "200/ACT"   , "narrator": "", "text": "怪獣映画、興味ないの？"},
        { "location": "201/TALK"  , "narrator": "みやび", "text": "やってたら見るけんど、進んで見ようとは思わんよ"},
        { "location": "202/TALK"  , "narrator": "みやび", "text": "普通のＳＦ映画とかは、結構よく見るんやけんど…"},
        { "location": "213/TALK"  , "narrator": "みやび", "text": "…ああ、そういえば、\n好きな怪獣映画も\nあったわ。"},
        { "location": "215/TALK"  , "narrator": "ヒカル", "text": "どんなのですか？"},
        { "location": "217/TALK"  , "narrator": "みやび", "text": "怪獣が巨大メカとかと\n戦うような展開のやつや。"},
        { "location": "219/TALK"  , "narrator": "アーヤ", "text": "あ、そういうのだったら\n私も見たことあるわ。"},
        { "location": "220/TALK"  , "narrator": "アーヤ", "text": "米軍の作った人型兵器と、\n宇宙怪獣が戦うような\n映画だったかしら？"},
        { "location": "222/TALK"  , "narrator": "雛", "text": "ああ、それならあたしも\n見たことありますよー。"},
        { "location": "224/TALK"  , "narrator": "キリト", "text": "…怪獣映画、興味ねぇって\n言わなかったか？"},
        { "location": "225/TALK"  , "narrator": "雛", "text": "興味はないけど、\nなんていうのかな？"},
        { "location": "226/TALK"  , "narrator": "雛", "text": "こう、バトル物になると、\n何となく見ちゃうの。"},
        { "location": "227/TALK"  , "narrator": "アーヤ", "text": "多分、何も考えずに\n見ていられるからじゃ\nないかしら？"},
        { "location": "228/TALK"  , "narrator": "アーヤ", "text": "疲れてる時や暇な時って、\nそういう映画の方が\n楽しめるのよね。"},
        { "location": "230/TALK"  , "narrator": "キリト", "text": "でも、見てる以上は\nデカい奴らがバトル\nするのを見て――"},
        { "location": "231/TALK"  , "narrator": "キリト", "text": "熱くなったりは\nするんでしょ？"},
        { "location": "232/TALK"  , "narrator": "アーヤ", "text": "男の子ほどじゃないとは\n思うけど、それなりにね。"},
        { "location": "233/TALK"  , "narrator": "みやび", "text": "まあ、バトル物やったら、\n一度は映画館で見ても\nえいかもしれんね。"},
        { "location": "236/TALK"  , "narrator": "つばめ", "text": "そうですね。\nあ、怪獣のデザインが\n怖いのは嫌ですけど…。"},
        { "location": "238/TALK"  , "narrator": "キリト", "text": "ヒカル、今度やる\nガズェラの映画って\n確か…。"},
        { "location": "241/TALK"  , "narrator": "ヒカル", "text": "残念ながら、ガズェラしか\n怪獣は出ませんから――"},
        { "location": "242/TALK"  , "narrator": "ヒカル", "text": "皆さんが興味を持つ\n内容ではありませんね。"},
        { "location": "244/TALK"  , "narrator": "キリト", "text": "ちぇっ…せっかくみんなで\n見に行けると思ったのに\nなぁ…。"},
        { "location": "246/TALK"  , "narrator": "キリト", "text": "続編がバトル物だったら、\nその時はみんなで見に\n行こうな！"},
        { "location": "249/TALK"  , "narrator": "みやび", "text": "えいけんど、数年は先の\n話になりそうやね…。"},
        { "location": "19/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>7月10日　12:11 PM</color>\nとある平日の昼休み、学食にて。"}
    ]
}
