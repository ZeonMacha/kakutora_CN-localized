{
    "dir": "chap31/daydra/dd_ch02_31_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "31205",
        "cid": "ayami",
        "title": "005 メインストーリー",
        "sub_title": "生体認証媒体＜後編＞"
    },
    "entry":
    [
        { "location": "586/TALK"  , "narrator": "みやび", "text": "調子はどうかね？\n締め付けすぎちゃあ\nせんかね。"},
        { "location": "587/TALK"  , "narrator": "アーヤ", "text": "大丈夫よ。"},
        { "location": "589/TALK"  , "narrator": "ガブリエラ", "text": "まさか、フェノメノンの\n外でトライコネクトする\nことになるなんてね。"},
        { "location": "592/TALK"  , "narrator": "みやび", "text": "いんや、ここも\nフェノメノンの中やよ。"},
        { "location": "594/TALK"  , "narrator": "ガブリエラ", "text": "あ、そっか…。\nもーっ、ややこしいわね！"},
        { "location": "595/TALK"  , "narrator": "真幌", "text": "ほら、\n無駄話はお終いだ。"},
        { "location": "597/TALK"  , "narrator": "アーヤ", "text": "…準備完了です。"},
        { "location": "598/TALK"  , "narrator": "真幌", "text": "首の後ろにある\nコネクタは接続したか？"},
        { "location": "600/TALK"  , "narrator": "アーヤ", "text": "はい…。"},
        { "location": "601/TALK"  , "narrator": "真幌", "text": "よし。\n……頼んだぞ。"},
        { "location": "607/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "608/TALK"  , "narrator": "真幌", "text": "……。"},
        { "location": "610/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "611/TALK"  , "narrator": "アーヤ", "text": "……。"},
        { "location": "612/TALK"  , "narrator": "真幌", "text": "……ふう。"},
        { "location": "613/TALK"  , "narrator": "真幌", "text": "ダイブできた\nみたいだな。"},
        { "location": "614/TALK"  , "narrator": "みやび", "text": "……生体モニターは\n正常範囲内\nみたいですね。"},
        { "location": "615/TALK"  , "narrator": "みやび", "text": "ガブちゃん。\nこっちのモニター\n監視しといて。"},
        { "location": "617/TALK"  , "narrator": "ガブリエラ", "text": "…えと…\n何見ればいいのかしら？"},
        { "location": "619/TALK"  , "narrator": "みやび", "text": "大したことはないき。\n標準値から外れたら\n数値が赤くなる。"},
        { "location": "620/TALK"  , "narrator": "ガブリエラ", "text": "…わかったわ。"},
        { "location": "622/TALK"  , "narrator": "みやび", "text": "うちはこっちで\n中が覗けんかどうか\n試してみるきね。"},
        { "location": "655/TALK"  , "narrator": "アーヤ", "text": "ダイブ成功したみたいね。"},
        { "location": "656/TALK"  , "narrator": "アーヤ", "text": "まずはサイクロトロンの\n再起動……。"},
        { "location": "659/TALK"  , "narrator": "アーヤ", "text": "それから音羽と\nコンタクトを\n取る……。"},
        { "location": "661/TALK"  , "narrator": "アーヤ", "text": "…だけど私に音羽を\n説得することが\nできるんだろうか…。"},
        { "location": "662/SEL"   , "narrator": "", "text": "来たね"},
        { "location": "663/ACT"   , "narrator": "", "text": "来たね"},
        { "location": "666/TALK"  , "narrator": "アーヤ", "text": "$handle$さん？"},
        { "location": "667/SEL"   , "narrator": "", "text": "うん"},
        { "location": "668/SEL"   , "narrator": "", "text": "ちゃんといるでしょ"},
        { "location": "669/SEL"   , "narrator": "", "text": "それはどうかな…"},
        { "location": "670/ACT"   , "narrator": "", "text": "うん"},
        { "location": "672/TALK"  , "narrator": "アーヤ", "text": "すごい！\n本当に来てくれたのね。"},
        { "location": "673/ACT"   , "narrator": "", "text": "ちゃんといるでしょ"},
        { "location": "675/TALK"  , "narrator": "アーヤ", "text": "そうね。\n驚いたわ。"},
        { "location": "676/ACT"   , "narrator": "", "text": "それはどうかな…"},
        { "location": "677/TALK"  , "narrator": "アーヤ", "text": "やめてよ\nこわいから！"},
        { "location": "679/TALK"  , "narrator": "アーヤ", "text": "これから音羽を\n説得しないと\nいけないんだけど。"},
        { "location": "680/TALK"  , "narrator": "アーヤ", "text": "結構プレッシャーなの。"},
        { "location": "681/SEL"   , "narrator": "", "text": "アーヤならできるよ"},
        { "location": "682/SEL"   , "narrator": "", "text": "なんで？"},
        { "location": "683/SEL"   , "narrator": "", "text": "そうだろうね…"},
        { "location": "684/ACT"   , "narrator": "", "text": "アーヤならできるよ"},
        { "location": "685/TALK"  , "narrator": "アーヤ", "text": "そんな気がしないの。"},
        { "location": "686/ACT"   , "narrator": "", "text": "なんで？"},
        { "location": "687/TALK"  , "narrator": "アーヤ", "text": "なんでって……。"},
        { "location": "688/ACT"   , "narrator": "", "text": "そうだろうね…"},
        { "location": "689/TALK"  , "narrator": "アーヤ", "text": "わかってくれる？"},
        { "location": "691/TALK"  , "narrator": "アーヤ", "text": "仕方なかったとしても\n音羽を壊したのは\nトライナリーだし。"},
        { "location": "692/TALK"  , "narrator": "アーヤ", "text": "その後も\n卯月のこととか\nあったし……。"},
        { "location": "693/TALK"  , "narrator": "アーヤ", "text": "恨まれてても\n仕方ないでしょ。"},
        { "location": "694/TALK"  , "narrator": "アーヤ", "text": "それに、\nこっちの都合ばっかり\n押し付けるみたいだし。"},
        { "location": "697/TALK"  , "narrator": "アーヤ", "text": "どう言えばいいのか…。"},
        { "location": "698/SEL"   , "narrator": "", "text": "難しいよね"},
        { "location": "699/SEL"   , "narrator": "", "text": "大変な役だよね"},
        { "location": "700/ACT"   , "narrator": "", "text": "難しいよね"},
        { "location": "702/TALK"  , "narrator": "アーヤ", "text": "そうなのよ…。"},
        { "location": "703/ACT"   , "narrator": "", "text": "大変な役だよね"},
        { "location": "705/TALK"  , "narrator": "アーヤ", "text": "わかってくれる？"},
        { "location": "707/SEL"   , "narrator": "", "text": "$me$が代わろうか？"},
        { "location": "708/SEL"   , "narrator": "", "text": "$me$にやらせてよ"},
        { "location": "709/ACT"   , "narrator": "", "text": "$me$が代わろうか？"},
        { "location": "712/TALK"  , "narrator": "アーヤ", "text": "え？"},
        { "location": "713/ACT"   , "narrator": "", "text": "$me$にやらせてよ"},
        { "location": "716/TALK"  , "narrator": "アーヤ", "text": "本気で言ってる？"},
        { "location": "718/SEL"   , "narrator": "", "text": "本気だよ"},
        { "location": "719/SEL"   , "narrator": "", "text": "だってアーヤ辛いでしょ"},
        { "location": "720/ACT"   , "narrator": "", "text": "本気だよ"},
        { "location": "721/TALK"  , "narrator": "アーヤ", "text": "それは……。"},
        { "location": "723/TALK"  , "narrator": "アーヤ", "text": "……。"},
        { "location": "725/TALK"  , "narrator": "アーヤ", "text": "でもやっぱり\nやめておくわね。"},
        { "location": "726/ACT"   , "narrator": "", "text": "だってアーヤ辛いでしょ"},
        { "location": "727/TALK"  , "narrator": "アーヤ", "text": "……辛いわ。"},
        { "location": "729/TALK"  , "narrator": "アーヤ", "text": "……。"},
        { "location": "731/TALK"  , "narrator": "アーヤ", "text": "当たり前よ。\nだけど大丈夫。"},
        { "location": "733/TALK"  , "narrator": "アーヤ", "text": "私がリーダーだもの、\nどうにかするわ。"},
        { "location": "734/TALK"  , "narrator": "アーヤ", "text": "ちゃんと説明して\nわかってもらう。"},
        { "location": "736/TALK"  , "narrator": "アーヤ", "text": "でもすごく\nうれしかったわ。\n本当にありがとう。"},
        { "location": "739/TALK"  , "narrator": "アーヤ", "text": "如月音羽さん、\n聞こえる？"},
        { "location": "740/TALK"  , "narrator": "アーヤ", "text": "……。"},
        { "location": "741/TALK"  , "narrator": "音羽", "text": "はい。"},
        { "location": "743/TALK"  , "narrator": "アーヤ", "text": "…どこにいるの？"},
        { "location": "744/TALK"  , "narrator": "音羽", "text": "姿を見せるのは\n多分無理。"},
        { "location": "745/TALK"  , "narrator": "アーヤ", "text": "……。"},
        { "location": "746/TALK"  , "narrator": "音羽", "text": "ああ。\n誤解しないで\nください。"},
        { "location": "747/TALK"  , "narrator": "音羽", "text": "この空間で私は\n形になれないだけ。\nでも声は伝えられる。"},
        { "location": "750/TALK"  , "narrator": "アーヤ", "text": "無理をさせて\nごめんなさい。"},
        { "location": "751/TALK"  , "narrator": "音羽", "text": "……いえ。"},
        { "location": "752/TALK"  , "narrator": "アーヤ", "text": "もうひとつ\n謝らないと\nいけないことがあるわ。"},
        { "location": "753/TALK"  , "narrator": "アーヤ", "text": "あなたを壊して\nごめんなさい。"},
        { "location": "754/TALK"  , "narrator": "音羽", "text": "…でもそれは…。"},
        { "location": "756/TALK"  , "narrator": "アーヤ", "text": "つばめがあなたを\n壊したことをリーダー\nとして謝罪するわ。"},
        { "location": "758/TALK"  , "narrator": "アーヤ", "text": "本当にごめんなさい。"},
        { "location": "759/TALK"  , "narrator": "音羽", "text": "それについて\n謝らないといけないのは\nこちらの方です。"},
        { "location": "760/TALK"  , "narrator": "音羽", "text": "あの時は神楽のために\nつばめさんを殺さないと\nいけないと信じてた。"},
        { "location": "761/TALK"  , "narrator": "音羽", "text": "でもそれは誤解だった。"},
        { "location": "762/TALK"  , "narrator": "音羽", "text": "今は知っています。\n千羽鶴のことも\nつばめさんの事情も。"},
        { "location": "763/TALK"  , "narrator": "音羽", "text": "こちらこそ\nすみませんでした。"},
        { "location": "766/TALK"  , "narrator": "アーヤ", "text": "…卯月のこと\n本当に大事に\n思っているのね。"},
        { "location": "767/TALK"  , "narrator": "音羽", "text": "もちろん。"},
        { "location": "768/TALK"  , "narrator": "音羽", "text": "…聞いてくれますか？\n神楽の過去を。"},
        { "location": "769/TALK"  , "narrator": "アーヤ", "text": "え…。\nでも……。"},
        { "location": "770/TALK"  , "narrator": "音羽", "text": "あの子がなぜ\n裏切らざるを\n得なかったか。"},
        { "location": "771/TALK"  , "narrator": "音羽", "text": "その理由を\n知ってほしいんです。"},
        { "location": "772/TALK"  , "narrator": "音羽", "text": "親友として。"},
        { "location": "773/TALK"  , "narrator": "アーヤ", "text": "…わかったわ。"},
        { "location": "774/TALK"  , "narrator": "音羽", "text": "長い話になります。\n直接イメージを\n送ります。"},
        { "location": "784/TALK"  , "narrator": "アーヤ", "text": "…どうしてあなたが\nそんなことを\n知っているの？"},
        { "location": "785/TALK"  , "narrator": "音羽", "text": "神楽本人から\n聞いたんです。\nライブの前に会った時に。"},
        { "location": "786/TALK"  , "narrator": "音羽", "text": "その時警告されたんです。\n神楽自身に。"},
        { "location": "787/TALK"  , "narrator": "音羽", "text": "命の危険があるから\nライブには来るなって。"},
        { "location": "788/TALK"  , "narrator": "音羽", "text": "でもわたしは行って。\n神楽の辛さを感じた。"},
        { "location": "789/TALK"  , "narrator": "音羽", "text": "自分が代わって\nあげられたらと思った。\nそして発症した。"},
        { "location": "790/TALK"  , "narrator": "アーヤ", "text": "そうだったの…。"},
        { "location": "791/TALK"  , "narrator": "音羽", "text": "私が警告を素直に\n聞いていたら。"},
        { "location": "792/TALK"  , "narrator": "音羽", "text": "今のような状態には\nなっていないはず。"},
        { "location": "793/TALK"  , "narrator": "アーヤ", "text": "……。"},
        { "location": "794/TALK"  , "narrator": "アーヤ", "text": "ひとつ、お願いしたい\nことがあるの。"},
        { "location": "795/TALK"  , "narrator": "アーヤ", "text": "私たちと一緒に\n千羽鶴と\n戦ってほしい。"},
        { "location": "796/TALK"  , "narrator": "音羽", "text": "元からその\nつもりでした。"},
        { "location": "797/TALK"  , "narrator": "アーヤ", "text": "でもそのためには\n現実世界のあなたを\n修復する必要がある。"},
        { "location": "798/TALK"  , "narrator": "アーヤ", "text": "そして修復のために\nあなたの心を一度\n全て委ねてもらう。"},
        { "location": "799/TALK"  , "narrator": "アーヤ", "text": "…簡単なことでは\nないはずよ。"},
        { "location": "800/TALK"  , "narrator": "音羽", "text": "はい。\nその通りです。"},
        { "location": "801/TALK"  , "narrator": "音羽", "text": "ただ、\n覚悟はできています。"},
        { "location": "802/TALK"  , "narrator": "音羽", "text": "…そちらの準備は\nいかがですか？"},
        { "location": "803/TALK"  , "narrator": "アーヤ", "text": "……いいわ。"},
        { "location": "804/TALK"  , "narrator": "音羽", "text": "では……。"},
        { "location": "805/TALK"  , "narrator": "アーヤ", "text": "！！"},
        { "location": "827/TALK"  , "narrator": "みやび", "text": "お！？"},
        { "location": "829/TALK"  , "narrator": "ガブリエラ", "text": "どうしたの？"},
        { "location": "831/TALK"  , "narrator": "みやび", "text": "向こうからこちらに\n干渉があったぞね…！"},
        { "location": "833/TALK"  , "narrator": "真幌", "text": "何だって？"},
        { "location": "835/TALK"  , "narrator": "みやび", "text": "これは音羽の\nココロの場所か…？"},
        { "location": "836/TALK"  , "narrator": "真幌", "text": "やったな！"},
        { "location": "837/TALK"  , "narrator": "ガブリエラ", "text": "アーヤが何かしたの？"},
        { "location": "839/TALK"  , "narrator": "真幌", "text": "そうだろうな。\n音羽との交渉に\n成功したんだ。"},
        { "location": "841/TALK"  , "narrator": "みやび", "text": "すっと解析しちゃるきね！"},
        { "location": "843/TALK"  , "narrator": "真幌", "text": "頼んだぞ。"},
        { "location": "844/TALK"  , "narrator": "ガブリエラ", "text": "…でも…。"},
        { "location": "845/TALK"  , "narrator": "ガブリエラ", "text": "アーヤは目を\n覚ましてないわ…。"},
        { "location": "777/DIALOG", "narrator": "Dialog_Black", "text": "全ての始まりはメノウの歌。"},
        { "location": "778/DIALOG", "narrator": "Dialog_Black", "text": "つばめの心の中で、\nメノウの歌は希望と優しさを育み、\nそれは世界支配層の計画していた、\n\n“つばめのフェノメノンによって\n作られる予定だった\n徹底管理社会の創成”\n\nを、食い止める原因となった。"},
        { "location": "779/DIALOG", "narrator": "Dialog_Black", "text": "それは支配層にとって\n都合の悪い状態だった。\n\nメノウの歌が希望であっては\nいけない。\n優しさなどあってはいけない。"},
        { "location": "780/DIALOG", "narrator": "Dialog_Black", "text": "支配層は\n神楽の父の会社を倒産させ母を壊し、\n神楽を奪った。\n\nそして\n希望の心を破壊する歌を歌わせ、\nつばめの心を破壊しようとしている。"},
        { "location": "781/DIALOG", "narrator": "Dialog_Black", "text": "でも神楽はそんなことは\n一切知らない。\n\nただ単に、\nこの繭を作って日本を支配する\n極悪な支配者、\n逢瀬つばめを破壊するよう\n言われているだけ。"},
        { "location": "782/DIALOG", "narrator": "Dialog_Black", "text": "だからどうか、\nそのことだけは、\nわかってあげて欲しい。"},
        { "location": "856/DIALOG", "narrator": "Dialog_chapter_ch02", "text": "【25 ワールド・スピード】"}
    ]
}
