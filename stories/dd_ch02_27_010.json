        "title": "SideStory003 ストーリー",
        "sub_title": "FILE02.先輩"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "東京編２話"},
        { "location": "15/DIALOG" , "narrator": "", "text": "<color=green>9月4日　 11:16 AM</color>\nとある日曜、付属学園大学の部室棟にて"},
        { "location": "22/TALK"   , "narrator": "小夜", "text": "さて、と。\n今日はもう予定もないし、\nさっさと帰って――"},
        { "location": "23/TALK"   , "narrator": "雛", "text": "小夜さーん！"},
        { "location": "25/TALK"   , "narrator": "小夜", "text": "…あれ？"},
        { "location": "28/TALK"   , "narrator": "雛", "text": "よかったぁ…。\nまだ帰ってなくて…。"},
        { "location": "29/TALK"   , "narrator": "小夜", "text": "ひなこちゃん。\nそんな走って、私に急用？"},
        { "location": "31/TALK"   , "narrator": "雛", "text": "は、はい…。\n聞きたいことが\nあるんです！"},
        { "location": "45/TALK"   , "narrator": "小夜", "text": "…劇場の襲撃。\nつばめちゃんが\n管理庁に捕まる。"},
        { "location": "46/TALK"   , "narrator": "小夜", "text": "しかも、アーヤ達は\n逃亡して行方不明…。"},
        { "location": "47/TALK"   , "narrator": "小夜", "text": "…なんか、凄過ぎて\n映画の話を聞いてる\nみたいな気になるわ…。"},
        { "location": "49/TALK"   , "narrator": "雛", "text": "ウソじゃないんです。\n本当に大変なことに\nなってるんです！"},
        { "location": "51/TALK"   , "narrator": "キリト", "text": "逢瀬が捕まったのも\n本当っすよ。"},
        { "location": "52/TALK"   , "narrator": "キリト", "text": "俺とヒカルは、\nそれを現場で\n見たんだから…。"},
        { "location": "55/TALK"   , "narrator": "小夜", "text": "あ、ごめんごめん。\n疑ってるわけじゃないの。"},
        { "location": "56/TALK"   , "narrator": "小夜", "text": "私も、昨日からアーヤに\nずっと連絡してるん\nだけど。"},
        { "location": "57/TALK"   , "narrator": "小夜", "text": "帰ってこないから、\n何かあったのかなぁ、って\n心配してたのよ。"},
        { "location": "58/TALK"   , "narrator": "ヒカル", "text": "そうだったんですか…。"},
        { "location": "59/TALK"   , "narrator": "小夜", "text": "うん…本当に、\n誰とも連絡が\n取れないの？"},
        { "location": "60/TALK"   , "narrator": "ヒカル", "text": "ＷＡＶＥはもちろん、\nメールも電話も\n通じませんでした…。"},
        { "location": "61/TALK"   , "narrator": "繭", "text": "ＰＣの方のメールや、\n別のチャットソフトも\n試しましたが、結果は…。"},
        { "location": "64/TALK"   , "narrator": "小夜", "text": "応答なし、か…。"},
        { "location": "66/TALK"   , "narrator": "雛", "text": "…それ以外の方法で\n綾水様達と連絡を\n取る方法。"},
        { "location": "67/TALK"   , "narrator": "雛", "text": "なにか、心当たりは\nありませんか？"},
        { "location": "68/TALK"   , "narrator": "小夜", "text": "そう言われても…。\n普段はＷＡＶＥでしか\n連絡取ってないし。"},
        { "location": "70/TALK"   , "narrator": "キリト", "text": "そうっすよね…。\n俺達だって、それ以外で\n連絡取りあわないし。"},
        { "location": "72/TALK"   , "narrator": "ヒカル", "text": "ＷＡＶＥって、\n便利過ぎるよね。"},
        { "location": "73/TALK"   , "narrator": "小夜", "text": "う～ん…ＷＡＶＥ以外で\nアーヤと連絡を取れそうな\n方法…。"},
        { "location": "74/TALK"   , "narrator": "小夜", "text": "…………あっ。"},
        { "location": "75/TALK"   , "narrator": "雛", "text": "えっ？"},
        { "location": "77/TALK"   , "narrator": "繭", "text": "なにか、心当たりが\nあるんですか？"},
        { "location": "80/TALK"   , "narrator": "小夜", "text": "心当たりっていうか…、\nアーヤ達って今、\n逃亡中よね？"},
        { "location": "85/TALK"   , "narrator": "小夜", "text": "もしかしたらだけど…。\nちょっと待ってて。"},
        { "location": "86/TALK"   , "narrator": "小夜", "text": "えっと…確かアドレス帳の\nアーヤのところに…。"},
        { "location": "103/TALK"  , "narrator": "みやび", "text": "ふぅ…。"},
        { "location": "105/TALK"  , "narrator": "ガブリエラ", "text": "アーヤのお姉さんから\n送られてきたデータ、\n確認終わったの？"},
        { "location": "106/TALK"  , "narrator": "みやび", "text": "いや、もうちくっと\n掛かりそうやけんど…。"},
        { "location": "107/TALK"  , "narrator": "みやび", "text": "さすがに疲れた。\n休憩せんと、頭が働かん。"},
        { "location": "109/TALK"  , "narrator": "ガブリエラ", "text": "…手伝えるもんなら、\n手伝いたいけど。"},
        { "location": "112/TALK"  , "narrator": "みやび", "text": "気持ちだけで十分やき、\n気にせんでえいがよ。"},
        { "location": "114/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "117/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "120/TALK"  , "narrator": "みやび", "text": "どないしたん？\n暗い顔しちゅうけんど…。"},
        { "location": "121/TALK"  , "narrator": "アーヤ", "text": "…家の方に、\n小夜から電話があった\nみたいなの。"},
        { "location": "124/TALK"  , "narrator": "ガブリエラ", "text": "えっ、小夜さんから！？"},
        { "location": "125/TALK"  , "narrator": "みやび", "text": "なんや、実家の番号\n教えちょったが？"},
        { "location": "126/TALK"  , "narrator": "アーヤ", "text": "なにかあった時のために、\n一応ね…。"},
        { "location": "128/TALK"  , "narrator": "アーヤ", "text": "まさか、こんな形で\nかけてくるとは\n思わなかったけど…。"},
        { "location": "129/TALK"  , "narrator": "ガブリエラ", "text": "それで、小夜さんに\nあたし達がここにいること\nバレちゃったの？"},
        { "location": "131/TALK"  , "narrator": "アーヤ", "text": "大丈夫よ。\n母が出たんだけど、\n誤魔化してくれたから…。"},
        { "location": "133/TALK"  , "narrator": "ガブリエラ", "text": "そう…。"},
        { "location": "135/TALK"  , "narrator": "アーヤ", "text": "…ただ、問題があってね。"},
        { "location": "136/TALK"  , "narrator": "アーヤ", "text": "小夜がうちに電話を\nかけてきたのって。"},
        { "location": "137/TALK"  , "narrator": "アーヤ", "text": "日向さん達に\nお願いされたから\nみたいなの…。"},
        { "location": "140/TALK"  , "narrator": "ガブリエラ", "text": "はぁ！？"},
        { "location": "142/TALK"  , "narrator": "アーヤ", "text": "後輩の子達も心配して\n連絡取りたがってるって、\n母に言ったらしいわ…。"},
        { "location": "144/TALK"  , "narrator": "みやび", "text": "…まあ、予想はしてた\nけんどな。"},
        { "location": "145/TALK"  , "narrator": "みやび", "text": "あの子達が大人しく\nしちゅうとは思えん\nかったし。"},
        { "location": "146/TALK"  , "narrator": "ガブリエラ", "text": "…あのさ。"},
        { "location": "147/TALK"  , "narrator": "ガブリエラ", "text": "あたし達が無事ってこと\nだけでも、伝えることって\nできないの？"},
        { "location": "148/TALK"  , "narrator": "アーヤ", "text": "…気持ちはわかるけど、\n得策とは言えないわ。"},
        { "location": "149/TALK"  , "narrator": "アーヤ", "text": "下手に連絡を取れば、\n私達の居場所が管理庁に\nバレるかもしれないの…。"},
        { "location": "151/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "154/TALK"  , "narrator": "アーヤ", "text": "…心苦しいけど、\n仕方ないわ。"},
        { "location": "155/TALK"  , "narrator": "アーヤ", "text": "日向さん達まで、\n管理庁との争いに巻き込む\nわけにはいかないし…。"},
        { "location": "156/SEL"   , "narrator": "（選択肢）", "text": "本当に連絡しないの？"},
        { "location": "157/SEL"   , "narrator": "（選択肢）", "text": "キリト達はもう被害者だよ"},
        { "location": "158/ACT"   , "narrator": "", "text": "本当に連絡しないの？"},
        { "location": "174/TALK"  , "narrator": "アーヤ", "text": "しないわ(￣Д￣ )"},
        { "location": "175/TALK"  , "narrator": "アーヤ", "text": "そんなことしたら"},
        { "location": "176/TALK"  , "narrator": "アーヤ", "text": "日向さん達"},
        { "location": "177/TALK"  , "narrator": "アーヤ", "text": "巻き込むことになるし(>_<)"},
        { "location": "179/SEL"   , "narrator": "（選択肢）", "text": "でも、みんな心配してるよ？"},
        { "location": "180/SEL"   , "narrator": "（選択肢）", "text": "でも、キリト達は謹慎になったよ？"},
        { "location": "181/ACT"   , "narrator": "", "text": "でも、みんな心配してるよ？"},
        { "location": "182/TALK"  , "narrator": "アーヤ", "text": "わかってる(-.-;)"},
        { "location": "183/TALK"  , "narrator": "アーヤ", "text": "それでも"},
        { "location": "184/TALK"  , "narrator": "アーヤ", "text": "連絡はできない"},
        { "location": "185/TALK"  , "narrator": "アーヤ", "text": "私達と連絡しているの"},
        { "location": "186/TALK"  , "narrator": "アーヤ", "text": "管理庁が知ったら"},
        { "location": "187/TALK"  , "narrator": "アーヤ", "text": "どうなると思う？"},
        { "location": "188/TALK"  , "narrator": "アーヤ", "text": "小夜達にまで"},
        { "location": "189/TALK"  , "narrator": "アーヤ", "text": "被害が行くかもしれない(>_<)"},
        { "location": "190/TALK"  , "narrator": "アーヤ", "text": "それだけは"},
        { "location": "191/TALK"  , "narrator": "アーヤ", "text": "絶対に避けないといけないの(; ;)"},
        { "location": "193/TALK"  , "narrator": "アーヤ", "text": "辛くても"},
        { "location": "194/TALK"  , "narrator": "アーヤ", "text": "仕方ないのよ"},
        { "location": "205/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "207/TALK"  , "narrator": "アーヤ", "text": "ごめん、小夜…。"},
        { "location": "208/TALK"  , "narrator": "アーヤ", "text": "全部終わったら…、\nその時は、ちゃんと\n謝るから…。"},
        { "location": "209/TALK"  , "narrator": "アーヤ", "text": "もう少しだけ、\n心配かけるのを許して…。"},
        { "location": "210/ACT"   , "narrator": "", "text": "でも、キリト達は謹慎になったよ？"},
        { "location": "211/TALK"  , "narrator": "アーヤ", "text": "謹慎って"},
        { "location": "213/TALK"  , "narrator": "アーヤ", "text": "どういうこと？( ・_・)σﾞ"},
        { "location": "215/SEL"   , "narrator": "（選択肢）", "text": "逃げ遅れたつばめを庇おうとした"},
        { "location": "216/ACT"   , "narrator": "", "text": "逃げ遅れたつばめを庇おうとした"},
        { "location": "219/TALK"  , "narrator": "アーヤ", "text": "本当なの！？"},
        { "location": "223/TALK"  , "narrator": "アーヤ", "text": "教えてくれてありがとう"},
        { "location": "224/TALK"  , "narrator": "アーヤ", "text": "それは"},
        { "location": "227/TALK"  , "narrator": "アーヤ", "text": "知っておかなきゃいけないことだから"},
        { "location": "238/TALK"  , "narrator": "アーヤ", "text": "…遅かったわ。"},
        { "location": "240/TALK"  , "narrator": "みやび", "text": "どうした？"},
        { "location": "242/TALK"  , "narrator": "アーヤ", "text": "…キリトくん達、\n私達のせいで\n謹慎になったみたい。"},
        { "location": "245/TALK"  , "narrator": "ガブリエラ", "text": "どういうことなの！？"},
        { "location": "248/TALK"  , "narrator": "アーヤ", "text": "逃げ遅れたつばめを、\n庇おうとしてくれた\nみたいなの。"},
        { "location": "249/TALK"  , "narrator": "アーヤ", "text": "でも、謹慎になったって\nことは、それが管理庁に\nバレたってことよね…。"},
        { "location": "251/TALK"  , "narrator": "みやび", "text": "…最悪やな。"},
        { "location": "252/TALK"  , "narrator": "みやび", "text": "巻き込まんように\n連絡を断っちゅうに。"},
        { "location": "254/TALK"  , "narrator": "みやび", "text": "とっくに巻き込んどった\nとは…。"},
        { "location": "256/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "258/TALK"  , "narrator": "ガブリエラ", "text": "…みやびの携帯なら、\n安全に連絡取れるんじゃ\nない？"},
        { "location": "260/TALK"  , "narrator": "みやび", "text": "裏ロム携帯なら、\nまあ、トレースされる\n心配はないけんど…。"},
        { "location": "261/TALK"  , "narrator": "ガブリエラ", "text": "なら、それ使って――"},
        { "location": "263/TALK"  , "narrator": "アーヤ", "text": "…ダメ。"},
        { "location": "265/TALK"  , "narrator": "ガブリエラ", "text": "どうして！\nもうとっくに巻き込んでる\nっていうのに！"},
        { "location": "266/TALK"  , "narrator": "アーヤ", "text": "だからこそ！\nこれ以上あの子達を\n巻き込んだらいけないの！"},
        { "location": "267/TALK"  , "narrator": "アーヤ", "text": "これは、私達と管理庁の\n問題なんだから…。"},
        { "location": "268/TALK"  , "narrator": "アーヤ", "text": "これ以上、あの子達に\n動くきっかけを作ったら\nいけないのよ…。"},
        { "location": "269/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "270/TALK"  , "narrator": "アーヤ", "text": "辛いだろうけど、\n今は我慢の時よ…。"},
        { "location": "271/TALK"  , "narrator": "ガブリエラ", "text": "…連絡しなければ、\nこれ以上ひなこ達は、\n動かないかしら？"},
        { "location": "272/TALK"  , "narrator": "アーヤ", "text": "絶対に動かない。"},
        { "location": "273/TALK"  , "narrator": "アーヤ", "text": "…そう、\n祈るしかないわね。"},
        { "location": "275/ACT"   , "narrator": "", "text": "キリト達はもう被害者だよ"},
        { "location": "291/TALK"  , "narrator": "アーヤ", "text": "被害者？"},
        { "location": "292/TALK"  , "narrator": "アーヤ", "text": "どういう意味？( ・_・)σﾞ"},
        { "location": "294/SEL"   , "narrator": "（選択肢）", "text": "謹慎処分を受けたから"},
        { "location": "295/ACT"   , "narrator": "", "text": "謹慎処分を受けたから"},
        { "location": "297/TALK"  , "narrator": "アーヤ", "text": "謹慎！？"},
        { "location": "299/TALK"  , "narrator": "アーヤ", "text": "ちょっと待って"}
    ]
}
