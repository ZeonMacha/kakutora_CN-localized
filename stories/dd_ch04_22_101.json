{
    "dir": "chap22/daydra/dd_ch04_22_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "22402",
        "cid": "miyabi",
        "title": "002 メインストーリー",
        "sub_title": "勇気＜前編＞"
    },
    "entry":
    [
        { "location": "18/TALK"   , "narrator": "つばめ", "text": "…ありがとう\nございました。\n話聞いてくれて…。"},
        { "location": "19/TALK"   , "narrator": "みやび", "text": "気にせんでえいよ。\nじゃあ、おやすみ。"},
        { "location": "20/TALK"   , "narrator": "つばめ", "text": "おやすみなさい。"},
        { "location": "24/TALK"   , "narrator": "みやび", "text": "…気を付けるよう\n言うてはおいた\nけんど…。"},
        { "location": "25/TALK"   , "narrator": "みやび", "text": "つばめちゃんの\n性格を考えると、\n無駄かもしれんなぁ。"},
        { "location": "27/TALK"   , "narrator": "みやび", "text": "はぁ…。"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "おっと、うさぎか。"},
        { "location": "50/TALK"   , "narrator": "みやび", "text": "おー、うさぎ。\nお疲れさん。"},
        { "location": "51/TALK"   , "narrator": "繭", "text": "お疲れ様です…。\nお邪魔でしたか？"},
        { "location": "52/TALK"   , "narrator": "みやび", "text": "いや、平気や。"},
        { "location": "53/TALK"   , "narrator": "みやび", "text": "それより、ようやく\n管理庁の本質が\nわかってきたなぁ。"},
        { "location": "54/TALK"   , "narrator": "繭", "text": "そうですね。\nここまで来るのに、\n長い道のりでした…。"},
        { "location": "55/TALK"   , "narrator": "みやび", "text": "そうやね…。"},
        { "location": "56/TALK"   , "narrator": "みやび", "text": "とりあえず、現状を\n一度整理しよう\n思うがよ。"},
        { "location": "57/TALK"   , "narrator": "繭", "text": "賛成です。"},
        { "location": "58/TALK"   , "narrator": "みやび", "text": "うん…ではまず、\nフェノメノンに\nついてや。"},
        { "location": "60/TALK"   , "narrator": "みやび", "text": "フェノメノンが\n起こる原因は、\n当然わかるな？"},
        { "location": "61/TALK"   , "narrator": "繭", "text": "もちろんです。\nクランの発症が\n発生原因です。"},
        { "location": "62/TALK"   , "narrator": "みやび", "text": "そうや。\nクランの発症が\n発端や。"},
        { "location": "63/TALK"   , "narrator": "みやび", "text": "クランを発症する\nとは自分の心の一部が\n具現化するということ。"},
        { "location": "64/TALK"   , "narrator": "みやび", "text": "…別の言い方を\nしてみようかね。"},
        { "location": "65/TALK"   , "narrator": "みやび", "text": "肉体から魂の一部を\n抽出する、っちゅう\nことぞね。"},
        { "location": "66/TALK"   , "narrator": "みやび", "text": "…どう思う？"},
        { "location": "67/TALK"   , "narrator": "繭", "text": "…改めて考えると、\nファンタジーですね。"},
        { "location": "68/TALK"   , "narrator": "みやび", "text": "そうやね。"},
        { "location": "69/TALK"   , "narrator": "みやび", "text": "けんど、そう思うんは\nこの現象が近年\n起き始めたからやき。"},
        { "location": "70/TALK"   , "narrator": "みやび", "text": "もし有史以前から\n起きちょったら\nただの日常現象。"},
        { "location": "71/TALK"   , "narrator": "みやび", "text": "誰もファンタジーな\n現象なんて思わん\nやろねえ。"},
        { "location": "72/TALK"   , "narrator": "繭", "text": "同感です。"},
        { "location": "73/TALK"   , "narrator": "繭", "text": "しかし今回の話と\nどうつながりますか？"},
        { "location": "74/TALK"   , "narrator": "みやび", "text": "うむ。要は\nフェノメノンは\n魔法ではない。"},
        { "location": "75/TALK"   , "narrator": "みやび", "text": "人為的なものと\n考えた方がえいと\nいう話ぞね。"},
        { "location": "76/TALK"   , "narrator": "みやび", "text": "それに…前回の\n出撃の時に取った\nデータや。"},
        { "location": "77/TALK"   , "narrator": "繭", "text": "フェノメノン内部で\n展開された世界の、\n量子状態ですね。"},
        { "location": "78/TALK"   , "narrator": "みやび", "text": "トライガジェットで\n超簡単に取得できる\nとはなあ。"},
        { "location": "79/TALK"   , "narrator": "みやび", "text": "しょうまっこと、\nうちも思わん\nかったぞね。"},
        { "location": "80/TALK"   , "narrator": "繭", "text": "その機能、先輩も\n把握していなかったん\nですよね？"},
        { "location": "82/TALK"   , "narrator": "みやび", "text": "うむ…ぶっちゃけ、\nうちらにとっても\n謎アイテムやきね。"},
        { "location": "83/TALK"   , "narrator": "繭", "text": "…わかる限りですが、\nその他の機能を\n調べました。"},
        { "location": "84/TALK"   , "narrator": "繭", "text": "不明なＡＰＩが多数\n確認できました。"},
        { "location": "85/TALK"   , "narrator": "繭", "text": "…内容まではまだ\nわかりませんが。"},
        { "location": "86/TALK"   , "narrator": "みやび", "text": "後で調べるき、\n今はとりあえず\n謎機能でえいよ。"},
        { "location": "87/TALK"   , "narrator": "みやび", "text": "まあ……\nこいつのおかげで\nはっきりした。"},
        { "location": "88/TALK"   , "narrator": "みやび", "text": "フェノメノン内部は\n物理的にも\n現実と不干渉。"},
        { "location": "89/TALK"   , "narrator": "繭", "text": "…つまり、現実とは\n何の関係もない世界、\nということですね。"},
        { "location": "91/TALK"   , "narrator": "みやび", "text": "大正解。"},
        { "location": "92/TALK"   , "narrator": "みやび", "text": "そして本来なら\nギャップラインを\n作ることは不可能。"},
        { "location": "93/TALK"   , "narrator": "みやび", "text": "計算上は地球全体の\nエネルギーを\n束にしても足らんはず。"},
        { "location": "94/TALK"   , "narrator": "みやび", "text": "けんど、現に\nフェノメノンは\n存在する。"},
        { "location": "95/TALK"   , "narrator": "みやび", "text": "これは何を\n意味しちゅう？"},
        { "location": "96/TALK"   , "narrator": "繭", "text": "…何者かが、莫大な\nエネルギーを\n調達している。"},
        { "location": "97/TALK"   , "narrator": "繭", "text": "そしてその何者かが、\n作為的に境界線を\n作り、改変している。"},
        { "location": "98/TALK"   , "narrator": "繭", "text": "…同時に、管理庁も\nこの件を把握している\nということですね。"},
        { "location": "99/TALK"   , "narrator": "繭", "text": "個人でこんなこと\nできるわけが\nありませんからね。"},
        { "location": "100/TALK"  , "narrator": "みやび", "text": "……やね。"},
        { "location": "101/TALK"  , "narrator": "みやび", "text": "フェノメノンに対抗\nするための\nトライガジェット。"},
        { "location": "102/TALK"  , "narrator": "みやび", "text": "現実じゃない場所に\nリンクする時点で\nどうかしとる。"},
        { "location": "103/TALK"  , "narrator": "みやび", "text": "しかもそれを使うて\nサーバーとリンク。"},
        { "location": "104/TALK"  , "narrator": "みやび", "text": "劇場で\nクランを管理して\n操作する。"},
        { "location": "105/TALK"  , "narrator": "みやび", "text": "…そんな芸当、\n全てを把握せんで\nできるわけなかろ。"},
        { "location": "106/TALK"  , "narrator": "繭", "text": "…ですよね。"},
        { "location": "107/TALK"  , "narrator": "繭", "text": "…まあ、予想はして\nいましたが。"},
        { "location": "108/TALK"  , "narrator": "みやび", "text": "さすがは情報管理庁、\n期待を裏切らんね。"},
        { "location": "109/TALK"  , "narrator": "繭", "text": "…ですが、管理庁が\n黒だとわかった今――"},
        { "location": "110/TALK"  , "narrator": "繭", "text": "みやび先輩達は\nどう動くおつもり\nなのですか？"},
        { "location": "111/TALK"  , "narrator": "みやび", "text": "ん～…、それが\nちっくと悩みどころ\nながよ…。"},
        { "location": "112/TALK"  , "narrator": "みやび", "text": "極論やとは\n思うけんど……。"},
        { "location": "113/TALK"  , "narrator": "みやび", "text": "全員でトライナリーを\nやめた方がえいとも\n思うたぞね。"},
        { "location": "114/TALK"  , "narrator": "みやび", "text": "けんど、そうなると\nフェノメノンを放置\nすることになる。"},
        { "location": "116/TALK"  , "narrator": "みやび", "text": "そういうわけにも\nいかんしなぁ…。"},
        { "location": "117/TALK"  , "narrator": "繭", "text": "…管理庁へ真実を\n問いただしに行く\nこともできませんし。"},
        { "location": "118/TALK"  , "narrator": "みやび", "text": "敵である以上、\n何してくるか\nわからんきね。"},
        { "location": "119/TALK"  , "narrator": "繭", "text": "…………。"},
        { "location": "120/TALK"  , "narrator": "繭", "text": "まずは皆さんに\n事実を話しては\nいかがでしょうか。"},
        { "location": "121/TALK"  , "narrator": "繭", "text": "今後の方針について\n話し合うのも手かと\n思いますよ？"},
        { "location": "122/TALK"  , "narrator": "みやび", "text": "…そうやなぁ。"},
        { "location": "123/TALK"  , "narrator": "みやび", "text": "うちだけで\n抱え込むには\n重い問題やけんど…。"},
        { "location": "124/TALK"  , "narrator": "みやび", "text": "相談してどうにかなる\nもんかねえ…。"},
        { "location": "125/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "127/TALK"  , "narrator": "みやび", "text": "いっそ、見なかった\nことにするとか――"},
        { "location": "191/TALK"  , "narrator": "みやび", "text": "　"},
        { "location": "207/TALK"  , "narrator": "みやび", "text": "む。きたか。"},
        { "location": "215/TALK"  , "narrator": "みやび", "text": "うちに変わったからには\n遊びはなしや。"},
        { "location": "216/TALK"  , "narrator": "みやび", "text": "早速扉を回すぞね。"},
        { "location": "221/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "223/TALK"  , "narrator": "みやび", "text": "うざいな。"},
        { "location": "225/TALK"  , "narrator": "みやび", "text": "公務執行妨害。"},
        { "location": "229/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "231/TALK"  , "narrator": "みやび", "text": "胸など飾り。"},
        { "location": "233/TALK"  , "narrator": "みやび", "text": "痴漢として通報した。"},
        { "location": "237/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "239/TALK"  , "narrator": "みやび", "text": "ようやるわ。"},
        { "location": "241/TALK"  , "narrator": "みやび", "text": "変態として通報した。"},
        { "location": "249/TALK"  , "narrator": "みやび", "text": "オープンプロセス、\n0xCE3番地から\n0x8D1番地へ。"},
        { "location": "255/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "257/TALK"  , "narrator": "みやび", "text": "うざいな。"},
        { "location": "259/TALK"  , "narrator": "みやび", "text": "公務執行妨害。"},
        { "location": "263/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "265/TALK"  , "narrator": "みやび", "text": "胸など飾り。"},
        { "location": "267/TALK"  , "narrator": "みやび", "text": "痴漢として通報した。"},
        { "location": "271/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "273/TALK"  , "narrator": "みやび", "text": "ようやるわ。"},
        { "location": "275/TALK"  , "narrator": "みやび", "text": "変態として通報した。"},
        { "location": "299/TALK"  , "narrator": "みやび", "text": "完了。"},
        { "location": "301/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "303/TALK"  , "narrator": "みやび", "text": "………。"},
        { "location": "304/TALK"  , "narrator": "みやび", "text": "うちとしたことが、\nビビりすぎて\n血迷っちゅう。"},
        { "location": "305/TALK"  , "narrator": "みやび", "text": "解はただ１つ。\nビビらず特攻あるのみ。"},
        { "location": "306/TALK"  , "narrator": "みやび", "text": "というわけで、\nはよいてら。"},
        { "location": "307/TALK"  , "narrator": "みやび", "text": "うちと\n$handle$に\n素敵なココロの旅を。"},
        { "location": "312/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "314/TALK"  , "narrator": "みやび", "text": "うざいな。"},
        { "location": "316/TALK"  , "narrator": "みやび", "text": "公務執行妨害。"},
        { "location": "320/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "322/TALK"  , "narrator": "みやび", "text": "胸など飾り。"},
        { "location": "324/TALK"  , "narrator": "みやび", "text": "痴漢として通報した。"},
        { "location": "328/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "330/TALK"  , "narrator": "みやび", "text": "ようやるわ。"},
        { "location": "332/TALK"  , "narrator": "みやび", "text": "変態として通報した。"},
        { "location": "17/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>8月29日　 10:32 PM</color>\n合宿中、みやびの実家でのこと"},
        { "location": "156/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "158/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "160/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "162/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "164/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "213/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "342/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"}
