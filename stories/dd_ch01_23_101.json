    "entry":
    [
        { "location": "51/TALK"   , "narrator": "アーヤ", "text": "…………。"},
        { "location": "52/TALK"   , "narrator": "つばめ", "text": "…………。"},
        { "location": "53/TALK"   , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "54/TALK"   , "narrator": "みやび", "text": "…………。"},
        { "location": "58/TALK"   , "narrator": "アーヤ", "text": "はぁ…。"},
        { "location": "59/SEL"    , "narrator": "", "text": "空気が重いね"},
        { "location": "60/ACT"    , "narrator": "", "text": "空気が重いね"},
        { "location": "75/TALK"   , "narrator": "アーヤ", "text": "仕方ない"},
        { "location": "76/TALK"   , "narrator": "アーヤ", "text": "神楽がスパイで"},
        { "location": "77/TALK"   , "narrator": "アーヤ", "text": "私たちの敵だったから"},
        { "location": "78/TALK"   , "narrator": "アーヤ", "text": "みんな"},
        { "location": "79/TALK"   , "narrator": "アーヤ", "text": "ショックが大きいのよ"},
        { "location": "81/SEL"    , "narrator": "", "text": "アーヤは平気？"},
        { "location": "82/ACT"    , "narrator": "", "text": "アーヤは平気？"},
        { "location": "84/TALK"   , "narrator": "アーヤ", "text": "私のことはいいから"},
        { "location": "85/TALK"   , "narrator": "アーヤ", "text": "今は"},
        { "location": "86/TALK"   , "narrator": "アーヤ", "text": "みんなをどうにかしなきゃ"},
        { "location": "88/SEL"    , "narrator": "", "text": "手伝おうか？"},
        { "location": "89/SEL"    , "narrator": "", "text": "役に立てることはない？"},
        { "location": "90/SEL"    , "narrator": "", "text": "話なら聞けるよ"},
        { "location": "91/SEL"    , "narrator": "", "text": "一人で抱え込まないで"},
        { "location": "92/ACT"    , "narrator": "", "text": "手伝おうか？"},
        { "location": "93/ACT"    , "narrator": "", "text": "役に立てることはない？"},
        { "location": "94/ACT"    , "narrator": "", "text": "話なら聞けるよ"},
        { "location": "95/ACT"    , "narrator": "", "text": "一人で抱え込まないで"},
        { "location": "98/TALK"   , "narrator": "アーヤ", "text": "大丈夫"},
        { "location": "99/TALK"   , "narrator": "アーヤ", "text": "何とかするから"},
        { "location": "100/TALK"  , "narrator": "アーヤ", "text": "心配しないで"},
        { "location": "111/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "113/TALK"  , "narrator": "アーヤ", "text": "そうだ。\n確か今日って…。"},
        { "location": "153/TALK"  , "narrator": "ガブリエラ", "text": "…で？\nどうして横須賀で\n降りたのよ？"},
        { "location": "155/TALK"  , "narrator": "アーヤ", "text": "あら、知らないの？"},
        { "location": "156/TALK"  , "narrator": "アーヤ", "text": "今日はあの有名な、\n横須賀花火大会の\n日なのよ？"},
        { "location": "157/TALK"  , "narrator": "ガブリエラ", "text": "…で？"},
        { "location": "158/TALK"  , "narrator": "アーヤ", "text": "ノリが悪いわね…。"},
        { "location": "159/TALK"  , "narrator": "アーヤ", "text": "つまり、今日は\nおもいきって遊ぼう、\nってことよ。"},
        { "location": "161/TALK"  , "narrator": "ガブリエラ", "text": "…正気？\n昨日の夜のこと\n忘れたの！？"},
        { "location": "162/TALK"  , "narrator": "ガブリエラ", "text": "遊ぶ気になんて\nなれるわけないでしょ！"},
        { "location": "163/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "164/TALK"  , "narrator": "アーヤ", "text": "…じゃあ、何？\nまっすぐ劇場に帰る？"},
        { "location": "165/TALK"  , "narrator": "ガブリエラ", "text": "当然よ。\nまずは帰る。"},
        { "location": "166/TALK"  , "narrator": "ガブリエラ", "text": "それから――"},
        { "location": "167/TALK"  , "narrator": "アーヤ", "text": "何もできないわよ。"},
        { "location": "168/TALK"  , "narrator": "アーヤ", "text": "私たちは、管理庁の\n判断がないと動けない\n立場なんだから。"},
        { "location": "169/TALK"  , "narrator": "アーヤ", "text": "それに…劇場に戻って\n何をするつもり？"},
        { "location": "170/TALK"  , "narrator": "アーヤ", "text": "卯月を探しに行く？\nどこにいるか\nわかってるの？"},
        { "location": "171/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "172/TALK"  , "narrator": "みやび", "text": "…まあ、バカ正直に\n自宅に帰っちょる\nわけないきね。"},
        { "location": "175/TALK"  , "narrator": "ガブリエラ", "text": "わかってるわよ！\nそんなの…。"},
        { "location": "176/TALK"  , "narrator": "アーヤ", "text": "…なら、急いで\n帰ったところで\n意味ないでしょ？"},
        { "location": "177/TALK"  , "narrator": "アーヤ", "text": "今日は館長も、\n管理庁の判断を仰ぎに\n行ってるし。"},
        { "location": "178/TALK"  , "narrator": "アーヤ", "text": "多分、夜までは\n戻らないはずよ。"},
        { "location": "179/TALK"  , "narrator": "アーヤ", "text": "だから、今日は\n気分転換の日にした方が\nいいと思うの。"},
        { "location": "181/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "183/TALK"  , "narrator": "みやび", "text": "…それはあれか？\nリーダーとしての\n命令なが？"},
        { "location": "185/TALK"  , "narrator": "アーヤ", "text": "まさか。\n命令じゃなくて提案よ。"},
        { "location": "187/TALK"  , "narrator": "アーヤ", "text": "というわけだから、\n私は今日一日、\nおもいっきり遊ぶわ。"},
        { "location": "189/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "195/TALK"  , "narrator": "アーヤ", "text": "ギャヴィ達も、\nあとは好きにして\nいいから…じゃあね。"},
        { "location": "200/TALK"  , "narrator": "ガブリエラ", "text": "…ふんっ。"},
        { "location": "204/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "223/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "224/TALK"  , "narrator": "つばめ", "text": "ダメだよね…。\nもっと、違う場所\nじゃないと…。"},
        { "location": "238/TALK"  , "narrator": "つばめ", "text": "…ここも、さすがに\n人が多過ぎだよ。"},
        { "location": "240/TALK"  , "narrator": "つばめ", "text": "もっと、人のいない\n場所じゃないと…。"},
        { "location": "241/SEL"   , "narrator": "", "text": "何をしてるの？"},
        { "location": "242/ACT"   , "narrator": "", "text": "何をしてるの？"},
        { "location": "247/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "263/TALK"  , "narrator": "つばめ", "text": "…この辺かな？\n人も少ないし。"},
        { "location": "264/TALK"  , "narrator": "つばめ", "text": "でも、よさそうな\n場所がないかも…。"},
        { "location": "265/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "267/TALK"  , "narrator": "つばめ", "text": "自分で死ぬのって、\n難しいな…。"},
        { "location": "268/SEL"   , "narrator": "", "text": "端末操作：フェノメノンアラート"},
        { "location": "269/ACT"   , "narrator": "", "text": "端末操作：フェノメノンアラート"},
        { "location": "275/TALK"  , "narrator": "つばめ", "text": "えっ！？"},
        { "location": "278/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "283/TALK"  , "narrator": "つばめ", "text": "イタズラはダメだよ"},
        { "location": "285/TALK"  , "narrator": "つばめ", "text": "フェノメノンアラートは"},
        { "location": "286/TALK"  , "narrator": "つばめ", "text": "冗談じゃすまないよ"},
        { "location": "288/SEL"   , "narrator": "", "text": "$me$じゃ力不足かな"},
        { "location": "289/SEL"   , "narrator": "", "text": "隠し事は無駄だよ"},
        { "location": "290/SEL"   , "narrator": "", "text": "死のうと思ってない？"},
        { "location": "291/ACT"   , "narrator": "", "text": "$me$じゃ力不足かな"},
        { "location": "292/TALK"  , "narrator": "つばめ", "text": "えっと"},
        { "location": "293/TALK"  , "narrator": "つばめ", "text": "何の話？"},
        { "location": "295/SEL"   , "narrator": "", "text": "相談もしてくれないの？"},
        { "location": "296/SEL"   , "narrator": "", "text": "信頼してくれてるって思ってた"},
        { "location": "297/ACT"   , "narrator": "", "text": "相談もしてくれないの？"},
        { "location": "299/TALK"  , "narrator": "つばめ", "text": "だって"},
        { "location": "301/TALK"  , "narrator": "つばめ", "text": "こんなこと"},
        { "location": "302/TALK"  , "narrator": "つばめ", "text": "言えないよ"},
        { "location": "303/ACT"   , "narrator": "", "text": "信頼してくれてるって思ってた"},
        { "location": "305/TALK"  , "narrator": "つばめ", "text": "それは"},
        { "location": "306/TALK"  , "narrator": "つばめ", "text": "もちろん"},
        { "location": "307/TALK"  , "narrator": "つばめ", "text": "してるけど"},
        { "location": "310/SEL"   , "narrator": "", "text": "自殺なんてするな"},
        { "location": "311/SEL"   , "narrator": "", "text": "生きててほしいんだ"},
        { "location": "312/ACT"   , "narrator": "", "text": "自殺なんてするな"},
        { "location": "313/ACT"   , "narrator": "", "text": "生きててほしいんだ"},
        { "location": "316/TALK"  , "narrator": "つばめ", "text": "でも"},
        { "location": "317/TALK"  , "narrator": "つばめ", "text": "それは"},
        { "location": "318/TALK"  , "narrator": "つばめ", "text": "無理だよ"},
        { "location": "320/TALK"  , "narrator": "つばめ", "text": "わたしより"},
        { "location": "321/TALK"  , "narrator": "つばめ", "text": "神楽ちゃんに"},
        { "location": "322/TALK"  , "narrator": "つばめ", "text": "生きていてほしいから"},
        { "location": "324/ACT"   , "narrator": "", "text": "隠し事は無駄だよ"},
        { "location": "326/TALK"  , "narrator": "つばめ", "text": "だったらわかるでしょ？"},
        { "location": "327/TALK"  , "narrator": "つばめ", "text": "わたしがなんで死ななきゃいけないか"},
        { "location": "328/TALK"  , "narrator": "つばめ", "text": "わたしもうこれ以上"},
        { "location": "329/TALK"  , "narrator": "つばめ", "text": "神楽ちゃんを悲しませたくないの"},
        { "location": "330/TALK"  , "narrator": "つばめ", "text": "だから"},
        { "location": "332/SEL"   , "narrator": "", "text": "全然わかんない"},
        { "location": "333/SEL"   , "narrator": "", "text": "やめとけって"},
        { "location": "334/SEL"   , "narrator": "", "text": "$me$が悲しむのはいいの？"},
        { "location": "335/ACT"   , "narrator": "", "text": "全然わかんない"},
        { "location": "336/TALK"  , "narrator": "つばめ", "text": "なんで？"},
        { "location": "337/TALK"  , "narrator": "つばめ", "text": "じゃあ"},
        { "location": "338/TALK"  , "narrator": "つばめ", "text": "もういいよ"},
        { "location": "339/ACT"   , "narrator": "", "text": "やめとけって"},
        { "location": "340/TALK"  , "narrator": "つばめ", "text": "やめない"},
        { "location": "341/TALK"  , "narrator": "つばめ", "text": "絶対に"},
        { "location": "342/TALK"  , "narrator": "つばめ", "text": "やめないから"},
        { "location": "343/ACT"   , "narrator": "", "text": "$me$が悲しむのはいいの？"},
        { "location": "345/TALK"  , "narrator": "つばめ", "text": "それは"},
        { "location": "346/TALK"  , "narrator": "つばめ", "text": "ダメ"},
        { "location": "347/TALK"  , "narrator": "つばめ", "text": "でも"},
        { "location": "348/TALK"  , "narrator": "つばめ", "text": "もう決めたから"},
        { "location": "349/TALK"  , "narrator": "つばめ", "text": "悲しまないで"},
        { "location": "350/TALK"  , "narrator": "つばめ", "text": "わたしなんかいなくなっても全然悲しくないから"},
        { "location": "353/SEL"   , "narrator": "", "text": "何言ってるの？"},
        { "location": "354/SEL"   , "narrator": "", "text": "矛盾してるよ"},
        { "location": "355/ACT"   , "narrator": "", "text": "何言ってるの？"},
        { "location": "356/TALK"  , "narrator": "つばめ", "text": "悲しくなんてないよ"},
        { "location": "357/TALK"  , "narrator": "つばめ", "text": "そんなの気のせいだから"},
        { "location": "358/TALK"  , "narrator": "つばめ", "text": "大丈夫だよ"},
        { "location": "359/ACT"   , "narrator": "", "text": "矛盾してるよ"},
        { "location": "361/TALK"  , "narrator": "つばめ", "text": "そうかも"},
        { "location": "362/TALK"  , "narrator": "つばめ", "text": "わたしバカだから"},
        { "location": "363/TALK"  , "narrator": "つばめ", "text": "説明もできないみたい"},
        { "location": "366/TALK"  , "narrator": "つばめ", "text": "でも"},
        { "location": "368/TALK"  , "narrator": "つばめ", "text": "だったら余計"},
        { "location": "369/TALK"  , "narrator": "つばめ", "text": "神楽ちゃんが生きててくれた方がいいよね"},
        { "location": "371/ACT"   , "narrator": "", "text": "死のうと思ってない？"},
        { "location": "373/TALK"  , "narrator": "つばめ", "text": "どうして？"},
        { "location": "374/TALK"  , "narrator": "つばめ", "text": "知ってるの？"},
        { "location": "376/SEL"   , "narrator": "", "text": "やっぱり…何で死のうとしてるの？"},
        { "location": "377/ACT"   , "narrator": "", "text": "やっぱり…何で死のうとしてるの？"},
        { "location": "379/TALK"  , "narrator": "つばめ", "text": "だって"},
        { "location": "380/TALK"  , "narrator": "つばめ", "text": "神楽ちゃん"},
        { "location": "381/TALK"  , "narrator": "つばめ", "text": "わたしを壊すって"},
        { "location": "382/TALK"  , "narrator": "つばめ", "text": "でも"},
        { "location": "384/TALK"  , "narrator": "つばめ", "text": "神楽ちゃんにそんなこと"},
        { "location": "385/TALK"  , "narrator": "つばめ", "text": "させたくないから"},
        { "location": "386/TALK"  , "narrator": "つばめ", "text": "わたしが"},
        { "location": "387/TALK"  , "narrator": "つばめ", "text": "自分で死のうと思って"},
        { "location": "390/TALK"  , "narrator": "つばめ", "text": "そしたら神楽ちゃん"},
        { "location": "391/TALK"  , "narrator": "つばめ", "text": "もう"},
        { "location": "392/TALK"  , "narrator": "つばめ", "text": "苦しまないで済むかもしれないし"},
        { "location": "394/SEL"   , "narrator": "", "text": "死ぬの怖くないの！？"},
        { "location": "395/ACT"   , "narrator": "", "text": "死ぬの怖くないの！？"},
        { "location": "398/TALK"  , "narrator": "つばめ", "text": "平気だよ"},
        { "location": "399/TALK"  , "narrator": "つばめ", "text": "わたし"},
        { "location": "413/TALK"  , "narrator": "つばめ", "text": "…神楽ちゃんの\nためだもの。"},
        { "location": "478/TALK"  , "narrator": "つばめの元司書", "text": "　"},
        { "location": "499/TALK"  , "narrator": "つばめの元司書", "text": "こんにちは、\n$handle$さん。"},
        { "location": "501/SEL"   , "narrator": "", "text": "カレン！！"},
        { "location": "502/ACT"   , "narrator": "", "text": "カレン！！"},
        { "location": "505/SEL"   , "narrator": "", "text": "元司書さん！！"},
        { "location": "506/ACT"   , "narrator": "", "text": "元司書さん！！"},
        { "location": "509/TALK"  , "narrator": "つばめの元司書", "text": "ここでは\nお久し振りです。"},
        { "location": "510/TALK"  , "narrator": "つばめの元司書", "text": "先日は1x0FFで\nお世話になりました。"},
        { "location": "511/TALK"  , "narrator": "つばめの元司書", "text": "今日はちょうど\nわたしのシフトだった\nみたいですね。"},
        { "location": "512/SEL"   , "narrator": "", "text": "やっぱり洗脳されちゃったの…？"},
        { "location": "513/SEL"   , "narrator": "", "text": "現実のつばめが大変なんだけど！"},
        { "location": "514/ACT"   , "narrator": "", "text": "やっぱり洗脳されちゃったの…？"},
        { "location": "515/TALK"  , "narrator": "つばめの元司書", "text": "洗脳…という言葉は\nあまりよくありません。"},
        { "location": "516/TALK"  , "narrator": "つばめの元司書", "text": "わたしは1x0FFで、\nとても大切なことを\n教えて戴きました。"},
        { "location": "517/TALK"  , "narrator": "つばめの元司書", "text": "$handle$さんにも\n是非参加して\n欲しいと思います。"},
        { "location": "518/ACT"   , "narrator": "", "text": "現実のつばめが大変なんだけど！"},
        { "location": "519/TALK"  , "narrator": "つばめの元司書", "text": "ええ、そうですね。"},
        { "location": "520/SEL"   , "narrator": "", "text": "早く何とかしないと！"},
        { "location": "521/ACT"   , "narrator": "", "text": "早く何とかしないと！"},
        { "location": "523/TALK"  , "narrator": "つばめの元司書", "text": "早くする必要は\nありませんね。\nここはココロの中なので。"},
        { "location": "524/TALK"  , "narrator": "つばめの元司書", "text": "$handle$さんがここを\n出る前に、何とか\nすれば大丈夫です。"},
        { "location": "526/TALK"  , "narrator": "つばめの元司書", "text": "というわけで、\n早速扉を回しましょう。"},
        { "location": "533/TALK"  , "narrator": "つばめの元司書", "text": "オープンプロセス、\n0xFFC番地から\n0x012番地へ。"},
        { "location": "539/TALK"  , "narrator": "つばめの元司書", "text": "……。"},
        { "location": "548/SEL"   , "narrator": "", "text": "え……？"},
        { "location": "549/ACT"   , "narrator": "", "text": "え……？"},
        { "location": "552/TALK"  , "narrator": "つばめの元司書", "text": "$handle$さんっ！"},
        { "location": "554/TALK"  , "narrator": "つばめの元司書", "text": "わたし、\n戻ってこれました！"},
        { "location": "556/SEL"   , "narrator": "", "text": "カレン！！"},
        { "location": "557/ACT"   , "narrator": "", "text": "カレン！！"},
        { "location": "560/SEL"   , "narrator": "", "text": "元司書さん！！"},
        { "location": "561/ACT"   , "narrator": "", "text": "元司書さん！！"},
        { "location": "563/TALK"  , "narrator": "つばめの元司書", "text": "えへへ。\nただいまです！"},
        { "location": "564/TALK"  , "narrator": "つばめの元司書", "text": "ところで、\n$handle$さんには\n名前教えてましたっけ？"},
        { "location": "565/SEL"   , "narrator": "", "text": "教えてもらっている"},
        { "location": "566/SEL"   , "narrator": "", "text": "教えてもらっていない"},
        { "location": "567/ACT"   , "narrator": "", "text": "教えてもらっている"},
        { "location": "568/TALK"  , "narrator": "つばめの元司書", "text": "それじゃ、お願いが\nあるんですけど。"},
        { "location": "569/TALK"  , "narrator": "つばめの元司書", "text": "あの……\n名前で呼んで\nもらえませんか？"},
        { "location": "570/SEL"   , "narrator": "", "text": "カレン"},
        { "location": "571/ACT"   , "narrator": "", "text": "カレン"},
        { "location": "573/ACT"   , "narrator": "", "text": "教えてもらっていない"},
        { "location": "574/TALK"  , "narrator": "つばめの元司書", "text": "はあっ！\nご、ごめんなさい！"},
        { "location": "575/TALK"  , "narrator": "つばめの元司書", "text": "わたしてっきり、\nもう教えていたものだと！"},
        { "location": "576/TALK"  , "narrator": "つばめの元司書", "text": "わたしの名前は\nカレンといいます。"},
        { "location": "577/TALK"  , "narrator": "つばめの元司書", "text": "本当はもっと長い名前\nなんですけど、普段は\nあまり使わないんで。"},
        { "location": "578/TALK"  , "narrator": "つばめの元司書", "text": "あの、それで\n早速なんですけど、\nお願いがありまして…。"},
        { "location": "579/TALK"  , "narrator": "つばめの元司書", "text": "名前で呼んで\nもらえませんか？"},
        { "location": "580/SEL"   , "narrator": "", "text": "カレン"},
        { "location": "581/ACT"   , "narrator": "", "text": "カレン"},
        { "location": "592/TALK"  , "narrator": "カレン", "text": "はあっ……\nなんか呼び捨てで\n呼ばれると――"},
        { "location": "593/TALK"  , "narrator": "カレン", "text": "新婚さんカップル\nみたいですね。"},
        { "location": "594/TALK"  , "narrator": "カレン", "text": "わたしも、\n呼び捨てして\nいいですか？"},
        { "location": "595/SEL"   , "narrator": "", "text": "是非"},
        { "location": "596/SEL"   , "narrator": "", "text": "今はそれどころじゃない"},
        { "location": "597/ACT"   , "narrator": "", "text": "是非"},
        { "location": "598/TALK"  , "narrator": "カレン", "text": "嬉しいです！\nそ、それじゃ…"},
        { "location": "599/TALK"  , "narrator": "カレン", "text": "<size=15>$handle$…。</size>"},
        { "location": "600/TALK"  , "narrator": "カレン", "text": "きゃー！"},
        { "location": "601/SEL"   , "narrator": "", "text": "完全に恋する乙女"},
        { "location": "602/ACT"   , "narrator": "", "text": "完全に恋する乙女"},
        { "location": "605/TALK"  , "narrator": "カレン", "text": "そ、そうですか？\nなんか色々嬉しくて。"},
        { "location": "606/TALK"  , "narrator": "カレン", "text": "って、そんなことやってる\n場合じゃありませんよね！"},
        { "location": "607/TALK"  , "narrator": "カレン", "text": "いろいろ大変なことに\nなっちゃってますし！"},
        { "location": "608/ACT"   , "narrator": "", "text": "今はそれどころじゃない"},
        { "location": "610/TALK"  , "narrator": "カレン", "text": "そ、そうでした！"},
        { "location": "611/TALK"  , "narrator": "カレン", "text": "しょんぼりです…。"},
        { "location": "614/SEL"   , "narrator": "", "text": "1xとやらで何されてたの？"},
        { "location": "615/SEL"   , "narrator": "", "text": "今ここってどうなってるの！？"},
        { "location": "616/SEL"   , "narrator": "", "text": "つばめが死んじゃうよ\n<color=blue>※先へ進みます</color>"},
        { "location": "617/ACT"   , "narrator": "", "text": "1xとやらで何されてたの？"},
        { "location": "618/TALK"  , "narrator": "カレン", "text": "えっと、それは……"},
        { "location": "619/TALK"  , "narrator": "カレン", "text": "す、すごいことです！"},
        { "location": "620/SEL"   , "narrator": "", "text": "怖いこと？"},
        { "location": "621/SEL"   , "narrator": "", "text": "エッチなこと？"},
        { "location": "622/ACT"   , "narrator": "", "text": "怖いこと？"},
        { "location": "623/TALK"  , "narrator": "カレン", "text": "そうですね、\nとっても怖いことです。"},
        { "location": "624/TALK"  , "narrator": "カレン", "text": "もう本当に、わたしという\n存在が終わってしまうかと\n思いました。"},
        { "location": "625/TALK"  , "narrator": "カレン", "text": "ですが、みやびさんの\nココロの司書が、すごい\nものをくれたので。"},
        { "location": "626/SEL"   , "narrator": "", "text": "え、なに？"},
        { "location": "627/ACT"   , "narrator": "", "text": "え、なに？"},
        { "location": "629/TALK"  , "narrator": "カレン", "text": "ココロジャマーです。"},
        { "location": "630/TALK"  , "narrator": "カレン", "text": "同じ人格同士で\n感情の状態が一切\n読めなくなるそうです。"},
        { "location": "631/TALK"  , "narrator": "カレン", "text": "だから、洗脳されたか\nされていないか、察知\nされなくなりました。"},
        { "location": "632/TALK"  , "narrator": "カレン", "text": "あの日、ホントに\nドキドキしたんです。\nバレたらどうしようって。"},
        { "location": "633/TALK"  , "narrator": "カレン", "text": "けど、やっぱり\nみやびさんですよね。\nすごいです！"},
        { "location": "634/TALK"  , "narrator": "カレン", "text": "詳しいことは、\nまた今度お話ししますね。"},
        { "location": "635/TALK"  , "narrator": "カレン", "text": "とっても\n大事なことなんで！"},
        { "location": "636/ACT"   , "narrator": "", "text": "エッチなこと？"},
        { "location": "638/TALK"  , "narrator": "カレン", "text": "えー…。"},
        { "location": "639/TALK"  , "narrator": "カレン", "text": "いや、そういうのなら\n良かったんですけ――"},
        { "location": "641/TALK"  , "narrator": "カレン", "text": "全然よくありません！！"},
        { "location": "644/ACT"   , "narrator": "", "text": "今ここってどうなってるの！？"},
        { "location": "645/TALK"  , "narrator": "カレン", "text": "ココロを停止しています。"},
        { "location": "646/TALK"  , "narrator": "カレン", "text": "こうすると、\n自分以外の人格の進行が\n一時的に止まるらしくて。"},
        { "location": "647/TALK"  , "narrator": "カレン", "text": "司書の裏コマンド\nらしいんですけど――"},
        { "location": "648/TALK"  , "narrator": "カレン", "text": "みやびさんの\nココロの司書に\n教えてもらいました。"},
        { "location": "649/TALK"  , "narrator": "カレン", "text": "なので、このままなら\n$handle$さんと\nずっと二人きりですけど。"},
        { "location": "650/TALK"  , "narrator": "カレン", "text": "現実としては\nそういうわけにも\nいきませんので。"},
        { "location": "651/TALK"  , "narrator": "カレン", "text": "でも、この機能って\nちょっと素敵ですよね？"},
        { "location": "652/TALK"  , "narrator": "カレン", "text": "なんだか、\n秘密の逢瀬って\n感じがしませんか？"},
        { "location": "653/SEL"   , "narrator": "", "text": "そうだね"},
        { "location": "654/SEL"   , "narrator": "", "text": "つばめちゃんなだけに（シャキーン"},
        { "location": "655/ACT"   , "narrator": "", "text": "そうだね"},
        { "location": "656/TALK"  , "narrator": "カレン", "text": "えへへ。"},
        { "location": "657/ACT"   , "narrator": "", "text": "つばめちゃんなだけに（シャキーン"},
        { "location": "658/TALK"  , "narrator": "カレン", "text": "え？"},
        { "location": "659/TALK"  , "narrator": "カレン", "text": "ああっ！\n逢瀬つばめと逢瀬を\nかけたんですね！"},
        { "location": "660/TALK"  , "narrator": "カレン", "text": "とっても面白いです！"},
        { "location": "661/SEL"   , "narrator": "", "text": "いえ、もういいです…"},
        { "location": "662/ACT"   , "narrator": "", "text": "いえ、もういいです…"},
        { "location": "664/TALK"  , "narrator": "カレン", "text": "？？"},
        { "location": "667/ACT"   , "narrator": "", "text": "つばめが死んじゃうよ\n<color=blue>※先へ進みます</color>"},
        { "location": "668/TALK"  , "narrator": "カレン", "text": "そ、そうですね！"},
        { "location": "669/TALK"  , "narrator": "カレン", "text": "でも大丈夫です！"},
        { "location": "670/TALK"  , "narrator": "カレン", "text": "いや、大丈夫じゃ\nありませんけど、\nでも、大丈夫なんです！"},
        { "location": "671/SEL"   , "narrator": "", "text": "どっちなの…？"},
        { "location": "672/ACT"   , "narrator": "", "text": "どっちなの…？"},
        { "location": "674/TALK"  , "narrator": "カレン", "text": "ああっ、ごめんなさい。\nこの瞬間は\n大丈夫なんですよ。"},
        { "location": "675/TALK"  , "narrator": "カレン", "text": "$handle$さんが\nココロスフィアにいる\nうちは刻が経たないので。"},
        { "location": "676/TALK"  , "narrator": "カレン", "text": "そのうちに、\nやれることを\nやりましょう！"},
        { "location": "677/TALK"  , "narrator": "カレン", "text": "わたしだって、\n死なれたら困りますから。"},
        { "location": "679/TALK"  , "narrator": "カレン", "text": "でも――"},
        { "location": "680/TALK"  , "narrator": "カレン", "text": "今回が、\nわたしのシフトで\n本当に良かったです。"},
        { "location": "681/TALK"  , "narrator": "カレン", "text": "わたしと\n$handle$さんなら\n現実のわたしを救えます！"},
        { "location": "682/SEL"   , "narrator": "", "text": "すごい自信だね"},
        { "location": "683/ACT"   , "narrator": "", "text": "すごい自信だね"},
        { "location": "685/TALK"  , "narrator": "カレン", "text": "わたしはわたしですから。"},
        { "location": "686/TALK"  , "narrator": "カレン", "text": "わたしは、\nわたしのことが\n大好きなんです。"},
        { "location": "687/TALK"  , "narrator": "カレン", "text": "誰よりも。\nどの人格よりも。"},
        { "location": "688/TALK"  , "narrator": "カレン", "text": "だから絶対に\n死なせません！"},
        { "location": "689/SEL"   , "narrator": "", "text": "でも、司書って情報もらってそれに従うだけでしょ？"},
        { "location": "690/ACT"   , "narrator": "", "text": "でも、司書って情報もらってそれに従うだけでしょ？"},
        { "location": "692/TALK"  , "narrator": "カレン", "text": "まあ、普通はそうですね。"},
        { "location": "693/SEL"   , "narrator": "", "text": "まさか、今回は情報を無視するとか！？"},
        { "location": "694/ACT"   , "narrator": "", "text": "まさか、今回は情報を無視するとか！？"},
        { "location": "696/TALK"  , "narrator": "カレン", "text": "しませんよ。\nわたしが死ぬように\n仕込まれていない限りは。"},
        { "location": "697/TALK"  , "narrator": "カレン", "text": "けど、わたし直感的に\nわかるんですけど……"},
        { "location": "698/TALK"  , "narrator": "カレン", "text": "確かに今回の葛藤を\n解消させれば、死のうと\n思わなくなると思います。"},
        { "location": "699/TALK"  , "narrator": "カレン", "text": "でも多分、生きる気力は\n湧いてこないような\n気がするんです。"},
        { "location": "700/TALK"  , "narrator": "カレン", "text": "だから、１つ\n$handle$さんに\nお願いがあります。"},
        { "location": "702/TALK"  , "narrator": "カレン", "text": "現実世界に戻ったら、\n現実のわたしに――"},
        { "location": "703/TALK"  , "narrator": "カレン", "text": "$handle$さんの\n想いをめいっぱい\nぶつけてください！"},
        { "location": "704/TALK"  , "narrator": "カレン", "text": "死んだら悲しいって。\nつばめは自分のことが\n嫌いなのかって。"},
        { "location": "705/TALK"  , "narrator": "カレン", "text": "そんな感じの事を、\n自分の言葉で\n伝えて欲しいんです。"},
        { "location": "706/TALK"  , "narrator": "カレン", "text": "そうすればきっと、\nわたしの生きる支えに\nなる筈なんです。"},
        { "location": "707/TALK"  , "narrator": "カレン", "text": "だって、もう\n$handle$さんは、\nわたしの恋人ですから。"},
        { "location": "709/TALK"  , "narrator": "カレン", "text": "世界でたった一人、\nそして一番の、\n掛け替えのない存在。"},
        { "location": "711/TALK"  , "narrator": "カレン", "text": "今、現実のわたしは\nココロが灰になっていて、\nそれすら気づけない。"},
        { "location": "712/TALK"  , "narrator": "カレン", "text": "ですから、\nどうかお願いします。"},
        { "location": "713/SEL"   , "narrator": "", "text": "もちろん"},
        { "location": "714/SEL"   , "narrator": "", "text": "ありがとう"},
        { "location": "715/ACT"   , "narrator": "", "text": "もちろん"},
        { "location": "716/ACT"   , "narrator": "", "text": "ありがとう"},
        { "location": "719/TALK"  , "narrator": "カレン", "text": "えへへ。"},
        { "location": "721/TALK"  , "narrator": "カレン", "text": "現実世界に戻ったら――"},
        { "location": "722/TALK"  , "narrator": "カレン", "text": "わたしのスマホを操作して\nひなこちゃんに\n電話してもらえませんか？"},
        { "location": "723/TALK"  , "narrator": "カレン", "text": "今、現実のわたしは、\nココロが灰になっていて\n周りが見えていません。"},
        { "location": "724/TALK"  , "narrator": "カレン", "text": "クラスの友だちや、\nトライナリーのみんなや\n$handle$さん――"},
        { "location": "725/TALK"  , "narrator": "カレン", "text": "そんな大切な人たちが\n周りに沢山いるって事を\n自分から気づければ…。"},
        { "location": "726/TALK"  , "narrator": "カレン", "text": "そうすれば自ずと、\n自分がどれだけ馬鹿な事を\n考えていたか気づきます。"},
        { "location": "727/TALK"  , "narrator": "カレン", "text": "……。"},
        { "location": "728/TALK"  , "narrator": "カレン", "text": "でも……ですね。"},
        { "location": "729/TALK"  , "narrator": "カレン", "text": "本当のことを言うと、\n$handle$さんに\n言って欲しいんです。"},
        { "location": "730/TALK"  , "narrator": "カレン", "text": "自分が悲しいからって。"},
        { "location": "731/TALK"  , "narrator": "カレン", "text": "すくなくとも、\nわたし…カレンには、\nそれが一番なんです。"},
        { "location": "732/TALK"  , "narrator": "カレン", "text": "でも、現実のわたしに\nどれだけ響くかも\nわかりませんし――"},
        { "location": "733/TALK"  , "narrator": "カレン", "text": "$handle$さんに\n迷惑をかけちゃうんじゃ\nないかって思って。"},
        { "location": "734/TALK"  , "narrator": "カレン", "text": "もし上手くいかなかったら\n$handle$さんにも\n申し訳無いですから……。"},
        { "location": "736/TALK"  , "narrator": "カレン", "text": "$handle$さんがわたしの\n恋人さんなら、迷わず\nしてもらうんですけどね。"},
        { "location": "737/TALK"  , "narrator": "カレン", "text": "えへへ……。"},
        { "location": "740/TALK"  , "narrator": "カレン", "text": "さて！\n寂しいですけど、\n再起動します！"},
        { "location": "741/TALK"  , "narrator": "カレン", "text": "$handle$さん、\nわたしはあなたがいて\nくれて本当に嬉しいです。"},
        { "location": "742/TALK"  , "narrator": "カレン", "text": "洗脳されたフリに\n戻りますけど、その事は\n忘れないでください。"},
        { "location": "743/SEL"   , "narrator": "カレン", "text": "当然だよ"},
        { "location": "744/SEL"   , "narrator": "", "text": "それはどうかな"},
        { "location": "745/ACT"   , "narrator": "", "text": "当然だよ"},
        { "location": "746/TALK"  , "narrator": "カレン", "text": "…。"},
        { "location": "747/ACT"   , "narrator": "", "text": "それはどうかな"},
        { "location": "748/TALK"  , "narrator": "カレン", "text": "そ、そんなぁ。"},
        { "location": "750/TALK"  , "narrator": "カレン", "text": "……。\nそれじゃ、\n戻しますね。"},
        { "location": "765/TALK"  , "narrator": "つばめの元司書", "text": "シーク完了しました。"},
        { "location": "767/TALK"  , "narrator": "つばめの元司書", "text": "……。"},
        { "location": "769/TALK"  , "narrator": "つばめの元司書", "text": "なるほど。"},
        { "location": "770/TALK"  , "narrator": "つばめの元司書", "text": "当然ですが、自暴自棄の\n原因となってるクランを\n仕留めてください。"},
        { "location": "771/TALK"  , "narrator": "つばめの元司書", "text": "それ以上でも\nそれ以下でも\nありません。"},
        { "location": "772/TALK"  , "narrator": "つばめの元司書", "text": "わたしと\n$handle$さんに\n素敵なココロの旅を。"},
        { "location": "39/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>8月30日　 2:20 PM</color>\n合宿終了の日、帰りの電車内でのこと"},
        { "location": "41/DIALOG" , "narrator": "YES_NO", "text": "共通エピソード部分を\n飛ばしますか？"},
        { "location": "443/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "445/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "447/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "449/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "451/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"}
    ]
}
