        { "location": "198/SCENARIO", "narrator": "", "text": "021_こんな所にリアリズム"},
        { "location": "223/TALK"    , "narrator": "みやび", "text": "$handle$の自給率はどの程度か"},
        { "location": "225/SEL"     , "narrator": "", "text": "言ってる意味がわかりません"},
        { "location": "226/SEL"     , "narrator": "", "text": "50パー"},
        { "location": "227/SEL"     , "narrator": "", "text": "みやびの生産率とほぼ同等"},
        { "location": "228/ACT"     , "narrator": "", "text": "言ってる意味がわかりません"},
        { "location": "229/TALK"    , "narrator": "みやび", "text": "なんと"},
        { "location": "232/ACT"     , "narrator": "", "text": "50パー"},
        { "location": "233/TALK"    , "narrator": "みやび", "text": "これまた"},
        { "location": "234/TALK"    , "narrator": "みやび", "text": "信憑性のない数値"},
        { "location": "235/ACT"     , "narrator": "", "text": "みやびの生産率とほぼ同等"},
        { "location": "237/TALK"    , "narrator": "みやび", "text": "ほほう"},
        { "location": "239/TALK"    , "narrator": "みやび", "text": "高アベレージじゃの"},
        { "location": "241/TALK"    , "narrator": "みやび", "text": "実際な"},
        { "location": "242/TALK"    , "narrator": "みやび", "text": "数値データは嘘をつくのが常識じゃよね"},
        { "location": "244/SEL"     , "narrator": "", "text": "数値化できないものもあるしね"},
        { "location": "245/SEL"     , "narrator": "", "text": "穿った見方だね"},
        { "location": "246/SEL"     , "narrator": "", "text": "それっぽいでっちあげもあるよね"},
        { "location": "247/ACT"     , "narrator": "", "text": "数値化できないものもあるしね"},
        { "location": "248/TALK"    , "narrator": "みやび", "text": "まあな"},
        { "location": "249/ACT"     , "narrator": "", "text": "穿った見方だね"},
        { "location": "250/TALK"    , "narrator": "みやび", "text": "そうかな"},
        { "location": "251/ACT"     , "narrator": "", "text": "それっぽいでっちあげもあるよね"},
        { "location": "252/TALK"    , "narrator": "みやび", "text": "確かに"},
        { "location": "254/TALK"    , "narrator": "みやび", "text": "時に相棒"},
        { "location": "255/TALK"    , "narrator": "みやび", "text": "我と貴殿の関係性は数値化できるか？"},
        { "location": "257/SEL"     , "narrator": "", "text": "あえてやめておく"},
        { "location": "258/SEL"     , "narrator": "", "text": "数値では測れない"},
        { "location": "259/SEL"     , "narrator": "", "text": "相性100％"},
        { "location": "260/ACT"     , "narrator": "", "text": "あえてやめておく"},
        { "location": "261/TALK"    , "narrator": "みやび", "text": "あ"},
        { "location": "262/TALK"    , "narrator": "みやび", "text": "そ"},
        { "location": "263/ACT"     , "narrator": "", "text": "数値では測れない"},
        { "location": "264/TALK"    , "narrator": "みやび", "text": "ほう"},
        { "location": "266/TALK"    , "narrator": "みやび", "text": "いいね"},
        { "location": "267/ACT"     , "narrator": "", "text": "相性100％"},
        { "location": "269/TALK"    , "narrator": "みやび", "text": "これはまた"},
        { "location": "270/TALK"    , "narrator": "みやび", "text": "ベタな"},
        { "location": "272/TALK"    , "narrator": "みやび", "text": "だが"},
        { "location": "273/TALK"    , "narrator": "みやび", "text": "悪くない"},
        { "location": "276/TALK"    , "narrator": "みやび", "text": "では次回までに"},
        { "location": "277/TALK"    , "narrator": "みやび", "text": "レポートを提出するように"}
