{
    "dir": "chap40/daydra/last_event_020.js",
    "type": "",
    "info": {
        "story_id": "12203",
        "cid": "",
        "title": "ラストストーリー",
        "sub_title": "アーヤより～ひとつの結末"
    },
    "entry":
    [
        { "location": "23/TALK"   , "narrator": "アーヤ", "text": "ふぅ…、\nもうこんな時間か。"},
        { "location": "24/TALK"   , "narrator": "アーヤ", "text": "おもったよりも\n遊びすぎちゃった\nみたい…。"},
        { "location": "25/TALK"   , "narrator": "アーヤ", "text": "小夜達も、今頃は\nぐったりしてる\nかしら？"},
        { "location": "26/SEL"    , "narrator": "（選択肢）", "text": "遊んできたの？"},
        { "location": "27/ACT"    , "narrator": "", "text": "遊んできたの？"},
        { "location": "29/TALK"   , "narrator": "アーヤ", "text": "ううん、今日は\n幼稚園に劇の発表を\nしに行ってて――"},
        { "location": "31/TALK"   , "narrator": "アーヤ", "text": "って、えっ！？\nもしかして今の、\n$handle$さんなの！？"},
        { "location": "32/SEL"    , "narrator": "（選択肢）", "text": "そうだよ、ハロー"},
        { "location": "33/ACT"    , "narrator": "", "text": "そうだよ、ハロー"},
        { "location": "35/TALK"   , "narrator": "アーヤ", "text": "ちょっと待って！\nさすがに、ここじゃ\n話せないし…。"},
        { "location": "36/TALK"   , "narrator": "アーヤ", "text": "少し待ってて。\n到着したら\n声かけるから。"},
        { "location": "51/TALK"   , "narrator": "透明アーヤ", "text": "ふぅ…、お待たせ。\nここならゆっくり\n話せるわ。"},
        { "location": "52/SEL"    , "narrator": "（選択肢）", "text": "どうしてわざわざ海に？"},
        { "location": "53/ACT"    , "narrator": "", "text": "どうしてわざわざ海に？"},
        { "location": "55/TALK"   , "narrator": "透明アーヤ", "text": "急に普通に話しかけて\nくるんだもの。"},
        { "location": "56/TALK"   , "narrator": "透明アーヤ", "text": "ちょっと混乱して、\n慌てちゃったから、\n落ち着きたかったの。"},
        { "location": "57/TALK"   , "narrator": "透明アーヤ", "text": "…それで？\nどうして私と普通に\n話せてるわけ？"},
        { "location": "58/SEL"    , "narrator": "（選択肢）", "text": "ライフギャザーを掌握して、無敵になったんだ"},
        { "location": "59/ACT"    , "narrator": "", "text": "ライフギャザーを掌握して、無敵になったんだ"},
        { "location": "61/TALK"   , "narrator": "透明アーヤ", "text": "無敵って…こんなこと\nまでできるように\nなるものなのね…。"},
        { "location": "62/SEL"    , "narrator": "（選択肢）", "text": "驚かせちゃったかな？"},
        { "location": "63/ACT"    , "narrator": "", "text": "驚かせちゃったかな？"},
        { "location": "65/TALK"   , "narrator": "透明アーヤ", "text": "驚いたわよ。\n電車の中で大きな声\n出しちゃったから…。"},
        { "location": "66/TALK"   , "narrator": "透明アーヤ", "text": "他の乗客に見られて\n恥ずかしかったわ…。"},
        { "location": "67/SEL"    , "narrator": "（選択肢）", "text": "話しかけるタイミング間違えた、ごめん"},
        { "location": "68/SEL"    , "narrator": "（選択肢）", "text": "非常コック引いたときよりマシだと思う"},
        { "location": "69/ACT"    , "narrator": "", "text": "話しかけるタイミング間違えた、ごめん"},
        { "location": "70/TALK"   , "narrator": "透明アーヤ", "text": "ふふっ、いいわよ。\n別に怒ってなんか\nいないし。"},
        { "location": "71/ACT"    , "narrator": "", "text": "非常コック引いたときよりマシだと思う"},
        { "location": "72/TALK"   , "narrator": "透明アーヤ", "text": "あ、あの時の話は\nしないで…。"},
        { "location": "73/TALK"   , "narrator": "透明アーヤ", "text": "今でも思い出すと、\n恥ずかしくて顔が\n熱くなっちゃうから。"},
        { "location": "75/TALK"   , "narrator": "透明アーヤ", "text": "でも、こうして\n普通に話せる日が\n来るなんて…。"},
        { "location": "77/TALK"   , "narrator": "透明アーヤ", "text": "なんか…夢みたいで、\nとっても幸せかも…。"},
        { "location": "79/TALK"   , "narrator": "透明アーヤ", "text": "とっても嬉しいわ。"},
        { "location": "82/SEL"    , "narrator": "（選択肢）", "text": "$me$もそう思う"},
        { "location": "83/SEL"    , "narrator": "（選択肢）", "text": "それで、今日はどうしたの？"},
        { "location": "84/ACT"    , "narrator": "", "text": "$me$もそう思う"},
        { "location": "85/TALK"   , "narrator": "透明アーヤ", "text": "ふふっ、よかった。"},
        { "location": "86/SEL"    , "narrator": "（選択肢）", "text": "それで、今日はどうしたの？"},
        { "location": "87/ACT"    , "narrator": "", "text": "それで、今日はどうしたの？"},
        { "location": "89/ACT"    , "narrator": "", "text": "それで、今日はどうしたの？"},
        { "location": "91/TALK"   , "narrator": "透明アーヤ", "text": "ああ、そうだったわ。\n今日は幼稚園で劇を\n発表してきたの。"},
        { "location": "92/TALK"   , "narrator": "透明アーヤ", "text": "それが終わった後、\n子供達にせがまれて、\nずっと遊んでたら…。"},
        { "location": "93/TALK"   , "narrator": "透明アーヤ", "text": "予定より帰る時間が\n遅くなっちゃって。"},
        { "location": "94/SEL"    , "narrator": "（選択肢）", "text": "相変わらず大人気だね"},
        { "location": "95/SEL"    , "narrator": "（選択肢）", "text": "ガブリエラも一緒に？"},
        { "location": "96/ACT"    , "narrator": "", "text": "相変わらず大人気だね"},
        { "location": "97/TALK"   , "narrator": "透明アーヤ", "text": "ありがたいことに、\n依頼も沢山入って\n毎週大忙しなの。"},
        { "location": "98/TALK"   , "narrator": "透明アーヤ", "text": "ただ、新しいお話しを\n考える作業が…。"},
        { "location": "99/TALK"   , "narrator": "透明アーヤ", "text": "劇的に増えたのだけは\nちょっと大変かも。"},
        { "location": "100/TALK"  , "narrator": "透明アーヤ", "text": "まあ、そう思いながら\n楽しんでるんだ\nけどね。"},
        { "location": "101/ACT"   , "narrator": "", "text": "ガブリエラも一緒に？"},
        { "location": "102/TALK"  , "narrator": "透明アーヤ", "text": "空いてるときにはね。\n今日は用事があるから\nって断られたけど。"},
        { "location": "103/TALK"  , "narrator": "透明アーヤ", "text": "あの子も、最近は\nクラスのお友達と\nよく遊んでるみたい。"},
        { "location": "105/TALK"  , "narrator": "透明アーヤ", "text": "なんか、なにもかもが\n上手くいってるような\n気がするわ。"},
        { "location": "106/TALK"  , "narrator": "透明アーヤ", "text": "それって、とっても\n幸せなことかも\nしれないけど…。"},
        { "location": "108/TALK"  , "narrator": "透明アーヤ", "text": "ちょっとだけ、\n怖くもあるの。"},
        { "location": "109/SEL"   , "narrator": "（選択肢）", "text": "贅沢な悩みだね"},
        { "location": "110/SEL"   , "narrator": "（選択肢）", "text": "上手くいかなくなった時を思って？"},
        { "location": "111/SEL"   , "narrator": "（選択肢）", "text": "おもいきり満喫しなきゃつまらないよ"},
        { "location": "112/ACT"   , "narrator": "", "text": "贅沢な悩みだね"},
        { "location": "113/TALK"  , "narrator": "透明アーヤ", "text": "わかってるけど、\nどうしても\n考えちゃうの。"},
        { "location": "114/TALK"  , "narrator": "透明アーヤ", "text": "こんなに何もかも\n上手くいく状態が\n続くわけない、って。"},
        { "location": "115/ACT"   , "narrator": "", "text": "上手くいかなくなった時を思って？"},
        { "location": "118/TALK"  , "narrator": "透明アーヤ", "text": "あーあ、言わなくても\n$handle$さんには\nバレバレなのね…。"},
        { "location": "120/TALK"  , "narrator": "透明アーヤ", "text": "ふふっ…やっぱり、\n$handle$さんには\nバレバレね。"},
        { "location": "123/ACT"   , "narrator": "", "text": "おもいきり満喫しなきゃつまらないよ"},
        { "location": "124/TALK"  , "narrator": "透明アーヤ", "text": "そうなんだけど、\nどうしても\n考えちゃうの。"},
        { "location": "125/TALK"  , "narrator": "透明アーヤ", "text": "こんなに何もかも\n上手くいく状態が\n続くわけない、って。"},
        { "location": "128/TALK"  , "narrator": "透明アーヤ", "text": "世界が平和になって、\n私生活もこんなに\n順調で…。"},
        { "location": "129/TALK"  , "narrator": "透明アーヤ", "text": "$handle$さんとも\nこうして話せるように\nなって…。"},
        { "location": "130/TALK"  , "narrator": "透明アーヤ", "text": "本当、今の私は\n幸せの絶頂にいると\n思ってる。"},
        { "location": "132/TALK"  , "narrator": "透明アーヤ", "text": "だからね、今の状態が\n少しでも崩れるような\nことになったら…。"},
        { "location": "133/TALK"  , "narrator": "透明アーヤ", "text": "本当にイヤだな、\nって…。"},
        { "location": "134/SEL"   , "narrator": "（選択肢）", "text": "大丈夫！！"},
        { "location": "135/SEL"   , "narrator": "（選択肢）", "text": "$me$がそうはさせない"},
        { "location": "136/SEL"   , "narrator": "（選択肢）", "text": "上手くいくだけじゃつまらない"},
        { "location": "137/ACT"   , "narrator": "", "text": "大丈夫！！"},
        { "location": "138/TALK"  , "narrator": "透明アーヤ", "text": "えっ？"},
        { "location": "139/SEL"   , "narrator": "（選択肢）", "text": "$me$のアーヤなら、斬り開いて行くから！"},
        { "location": "140/SEL"   , "narrator": "（選択肢）", "text": "$me$がずっとアーヤの幸せを想ってるから"},
        { "location": "141/ACT"   , "narrator": "", "text": "$me$のアーヤなら、斬り開いて行くから！"},
        { "location": "143/TALK"  , "narrator": "透明アーヤ", "text": "$handle$さんの\nって、ちょ…！！"},
        { "location": "145/TALK"  , "narrator": "透明アーヤ", "text": "ば、バカ！！\n急にそんな嬉し――"},
        { "location": "146/TALK"  , "narrator": "透明アーヤ", "text": "は、恥ずかしいこと\n言わないで！！\nビックリするでしょ？"},
        { "location": "147/TALK"  , "narrator": "透明アーヤ", "text": "まったく…。"},
        { "location": "148/TALK"  , "narrator": "透明アーヤ", "text": "…さっきよりも、\nもっと幸せな気持ちに\nなっちゃったわ。"},
        { "location": "151/TALK"  , "narrator": "透明アーヤ", "text": "あはは…、\n斬り開く、か…。"},
        { "location": "152/TALK"  , "narrator": "透明アーヤ", "text": "…そうよね。\n今までだって、\nそうだったもの。"},
        { "location": "153/TALK"  , "narrator": "透明アーヤ", "text": "どんな困難なことに\n見舞われても、\n諦めずに進んできた。"},
        { "location": "155/TALK"  , "narrator": "透明アーヤ", "text": "だから、今のこの\n幸せがあるのよね。"},
        { "location": "156/TALK"  , "narrator": "透明アーヤ", "text": "ありがとう。\n大切なことを\n思い出させてくれて。"},
        { "location": "158/ACT"   , "narrator": "", "text": "$me$がずっとアーヤの幸せを想ってるから"},
        { "location": "160/TALK"  , "narrator": "透明アーヤ", "text": "…ずっと、私のことを\n想ってくれるの？"},
        { "location": "162/TALK"  , "narrator": "透明アーヤ", "text": "そう…そっか。"},
        { "location": "163/TALK"  , "narrator": "透明アーヤ", "text": "大切な人にそんなこと\n言われたら…。"},
        { "location": "164/TALK"  , "narrator": "透明アーヤ", "text": "余計幸せな気持ちに\nなっちゃうわ。"},
        { "location": "166/TALK"  , "narrator": "透明アーヤ", "text": "なら私も、ずっと\n$handle$さんの\n幸せを想うわ。"},
        { "location": "169/TALK"  , "narrator": "透明アーヤ", "text": "…それって、とっても\n心強いわ。"},
        { "location": "170/TALK"  , "narrator": "透明アーヤ", "text": "だって、あなたは\n無敵だもの。"},
        { "location": "171/TALK"  , "narrator": "透明アーヤ", "text": "それに、今まで何度も\n私達のことを助けて\nくれもしたし…。"},
        { "location": "173/TALK"  , "narrator": "透明アーヤ", "text": "$handle$さんが\n想ってくれるなら、\n不安も消し飛ぶわ。"},
        { "location": "176/ACT"   , "narrator": "", "text": "$me$がそうはさせない"},
        { "location": "178/TALK"  , "narrator": "透明アーヤ", "text": "不思議…。\n$handle$さんに\nそう言われると…。"},
        { "location": "179/TALK"  , "narrator": "透明アーヤ", "text": "なんだか、不安な\n気持ちがどんどん\n小さくなる…。"},
        { "location": "180/TALK"  , "narrator": "透明アーヤ", "text": "今まで、何度も\n$handle$さんに\n助けてもらったから？"},
        { "location": "182/TALK"  , "narrator": "透明アーヤ", "text": "…うん、きっとそう。\nあなたに絶対の信頼を\n置いてるからよね。"},
        { "location": "183/ACT"   , "narrator": "", "text": "上手くいくだけじゃつまらない"},
        { "location": "184/TALK"  , "narrator": "透明アーヤ", "text": "…そうよね。"},
        { "location": "185/TALK"  , "narrator": "透明アーヤ", "text": "そんなんじゃ、\n段々自分も努力とか\nしなくなると思うし。"},
        { "location": "186/TALK"  , "narrator": "透明アーヤ", "text": "上手くいってるから、\n今の状態を続ける\nために…。"},
        { "location": "188/TALK"  , "narrator": "透明アーヤ", "text": "もっと頑張らなきゃ、\nって気持ちでいなきゃ\nダメよね。"},
        { "location": "189/SEL"   , "narrator": "（選択肢）", "text": "それでこそアーヤだ"},
        { "location": "190/ACT"   , "narrator": "", "text": "それでこそアーヤだ"},
        { "location": "192/TALK"  , "narrator": "透明アーヤ", "text": "そうよね…。\nここ最近、平和な日が\n続いてたから…。"},
        { "location": "193/TALK"  , "narrator": "透明アーヤ", "text": "ちょっと、気持ちが\n緩んじゃってた\nみたい。"},
        { "location": "196/TALK"  , "narrator": "透明アーヤ", "text": "あーあ、でも本当、\n今日は驚いたわ。"},
        { "location": "199/TALK"  , "narrator": "透明アーヤ", "text": "$handle$さんと、\nこんな風に普通に\nお話しできるなんて。"},
        { "location": "200/TALK"  , "narrator": "透明アーヤ", "text": "これで、これからは\nもっと楽しくデート\nとかできそうね。"},
        { "location": "202/TALK"  , "narrator": "透明アーヤ", "text": "$handle$さんと、\nこんな風に普通に\nお話しできるなんて。"},
        { "location": "203/TALK"  , "narrator": "透明アーヤ", "text": "これなら、お話し\nしながらお出かけも\nできそうね。"},
        { "location": "205/SEL"   , "narrator": "（選択肢）", "text": "喜んでもらえてよかった"},
        { "location": "206/ACT"   , "narrator": "", "text": "喜んでもらえてよかった"},
        { "location": "208/TALK"  , "narrator": "透明アーヤ", "text": "当然よ。\nチャットで話すより\n身近に感じられるし。"},
        { "location": "210/TALK"  , "narrator": "透明アーヤ", "text": "$handle$さんは\nチャットで話すのと\n今、どっちが好き？"},
        { "location": "211/SEL"   , "narrator": "（選択肢）", "text": "もちろん、今の方がいい"},
        { "location": "212/SEL"   , "narrator": "（選択肢）", "text": "チャットはチャットで楽しかった"},
        { "location": "213/ACT"   , "narrator": "", "text": "もちろん、今の方がいい"},
        { "location": "215/TALK"  , "narrator": "透明アーヤ", "text": "ね？\nだから私も嬉しいの。"},
        { "location": "217/TALK"  , "narrator": "透明アーヤ", "text": "それに、パートナーと\nチャット会話だけって\nちょっと寂しいし…。"},
        { "location": "219/TALK"  , "narrator": "透明アーヤ", "text": "それに、恋人同士が\nチャット会話だけって\n変だもの。"},
        { "location": "221/TALK"  , "narrator": "透明アーヤ", "text": "それに、ラクだし。"},
        { "location": "224/ACT"   , "narrator": "", "text": "チャットはチャットで楽しかった"},
        { "location": "225/TALK"  , "narrator": "透明アーヤ", "text": "じゃあ、たまには\nチャットでお話しも\nしましょ。"},
        { "location": "226/TALK"  , "narrator": "透明アーヤ", "text": "コッソリ内緒話する\nみたいで、今までとは\n違った気がしそうね。"},
        { "location": "229/TALK"  , "narrator": "透明アーヤ", "text": "それで…どうかしら？"},
        { "location": "230/TALK"  , "narrator": "透明アーヤ", "text": "今日って、このあと\nなにか用事ある？"},
        { "location": "231/SEL"   , "narrator": "（選択肢）", "text": "なんで？"},
        { "location": "232/SEL"   , "narrator": "（選択肢）", "text": "デートのお誘い！？"},
        { "location": "233/ACT"   , "narrator": "", "text": "なんで？"},
        { "location": "235/TALK"  , "narrator": "透明アーヤ", "text": "も、もう！\nわかってるでしょ？"},
        { "location": "236/TALK"  , "narrator": "透明アーヤ", "text": "せっかくの機会だし、\n一緒に、その…。"},
        { "location": "237/TALK"  , "narrator": "透明アーヤ", "text": "で、デートとか、\nどうかな、って…。"},
        { "location": "239/TALK"  , "narrator": "透明アーヤ", "text": "せっかくだから、\n一緒にお買い物でも\n行ってみない？"},
        { "location": "240/TALK"  , "narrator": "透明アーヤ", "text": "きっと、いつもとは\n違った感じになると\n思うの。"},
        { "location": "241/TALK"  , "narrator": "透明アーヤ", "text": "$handle$さんも\n楽しめると思うし。"},
        { "location": "243/ACT"   , "narrator": "", "text": "デートのお誘い！？"},
        { "location": "245/TALK"  , "narrator": "透明アーヤ", "text": "あはは…、\n$handle$さんには\nバレバレね。"},
        { "location": "246/TALK"  , "narrator": "透明アーヤ", "text": "そう、デート。\n普通にお話しできる\nようになった…。"},
        { "location": "247/TALK"  , "narrator": "透明アーヤ", "text": "大切な記念日だし。\nいいでしょ？"},
        { "location": "249/TALK"  , "narrator": "透明アーヤ", "text": "う～ん、ちょっと\nお買い物でも、って\n思ったんだけど…。"},
        { "location": "250/TALK"  , "narrator": "透明アーヤ", "text": "でも、そうよね。\n今日は特別な日だし、\nデートってことで。"},
        { "location": "253/SEL"   , "narrator": "（選択肢）", "text": "行こう！！"},
        { "location": "254/ACT"   , "narrator": "", "text": "行こう！！"},
        { "location": "257/TALK"  , "narrator": "透明アーヤ", "text": "よかった…。\nそれじゃあ――"},
        { "location": "259/TALK"  , "narrator": "透明アーヤ", "text": "ん、決まりね。\nそれじゃあ――"},
        { "location": "266/TALK"  , "narrator": "透明アーヤ", "text": "あっ、待って。\nギャヴィから\nＷＡＶＥが…。"},
        { "location": "268/TALK"  , "narrator": "透明アーヤ", "text": "…えぇー。\nこのタイミングで？"},
        { "location": "269/SEL"   , "narrator": "（選択肢）", "text": "どうかしたの？"},
        { "location": "270/ACT"   , "narrator": "", "text": "どうかしたの？"},
        { "location": "272/TALK"  , "narrator": "透明アーヤ", "text": "…これから長官が\n来るんだって。"},
        { "location": "273/SEL"   , "narrator": "（選択肢）", "text": "それじゃ仕方ないね…"},
        { "location": "274/ACT"   , "narrator": "", "text": "それじゃ仕方ないね…"},
        { "location": "276/TALK"  , "narrator": "透明アーヤ", "text": "ごめんなさい。\n本当にいつも\n間が悪くて。"},
        { "location": "277/SEL"   , "narrator": "（選択肢）", "text": "そういうところも含めてアーヤだと思ってるよ"},
        { "location": "278/ACT"   , "narrator": "", "text": "そういうところも含めてアーヤだと思ってるよ"},
        { "location": "281/TALK"  , "narrator": "透明アーヤ", "text": "…ふふ。\nありがと。"},
        { "location": "282/TALK"  , "narrator": "透明アーヤ", "text": "ちょっと複雑な\n気分だけど、嬉しい。"},
        { "location": "298/TALK"  , "narrator": "アーヤ", "text": "…もうついちゃった。"},
        { "location": "301/TALK"  , "narrator": "アーヤ", "text": "今日はありがとう。\nなんだか、とっても\n幸せな時間だったわ。"},
        { "location": "304/TALK"  , "narrator": "アーヤ", "text": "今日はありがとう。\nとっても楽しい\n時間だったわ。"},
        { "location": "306/TALK"  , "narrator": "アーヤ", "text": "それじゃ、また。"},
        { "location": "307/SEL"   , "narrator": "（選択肢）", "text": "またね！"},
        { "location": "308/SEL"   , "narrator": "（選択肢）", "text": "待って、実はアーヤに伝えなければならないことがある"},
        { "location": "309/ACT"   , "narrator": "", "text": "またね！"},
        { "location": "310/TALK"  , "narrator": "アーヤ", "text": "ええ、バイバイ。"},
        { "location": "312/ACT"   , "narrator": "", "text": "待って、実はアーヤに伝えなければならないことがある"},
        { "location": "317/TALK"  , "narrator": "アーヤ", "text": "え？\nなに？"},
        { "location": "318/SEL"   , "narrator": "（選択肢）", "text": "あと数日で回線が切れてしまって、もうお別れなんだ"},
        { "location": "319/ACT"   , "narrator": "", "text": "あと数日で回線が切れてしまって、もうお別れなんだ"},
        { "location": "321/TALK"  , "narrator": "アーヤ", "text": "……。"},
        { "location": "322/TALK"  , "narrator": "アーヤ", "text": "そう……。"},
        { "location": "323/TALK"  , "narrator": "アーヤ", "text": "$handle$さんは、\n寂しいと思ってる？"},
        { "location": "324/SEL"   , "narrator": "（選択肢）", "text": "当然だよ！"},
        { "location": "325/SEL"   , "narrator": "（選択肢）", "text": "まあ生きていく上では必ず通ることだから"},
        { "location": "326/ACT"   , "narrator": "", "text": "当然だよ！"},
        { "location": "327/TALK"  , "narrator": "アーヤ", "text": "そっか……\n安心した。"},
        { "location": "328/TALK"  , "narrator": "アーヤ", "text": "私も同じ気持ちだから。"},
        { "location": "329/ACT"   , "narrator": "", "text": "まあ生きていく上では必ず通ることだから"},
        { "location": "330/TALK"  , "narrator": "アーヤ", "text": "ふふ、悟りの境地ね。"},
        { "location": "332/TALK"  , "narrator": "アーヤ", "text": "なんかね、\n今お話を聞いて、\nビックリもしたけど――"},
        { "location": "333/TALK"  , "narrator": "アーヤ", "text": "同時に、ああ、その時が\n来ちゃったんだなって\n想いもあって。"},
        { "location": "334/TALK"  , "narrator": "アーヤ", "text": "……。"},
        { "location": "335/TALK"  , "narrator": "アーヤ", "text": "こんな事を言うとね、"},
        { "location": "336/TALK"  , "narrator": "アーヤ", "text": "$handle$さんの事\n軽く見てると思われそうで\nちょっと怖いんだけど。"},
        { "location": "337/TALK"  , "narrator": "アーヤ", "text": "私は、貴方との関係を\nとても素敵なものだったと\n思ってる。"},
        { "location": "338/TALK"  , "narrator": "アーヤ", "text": "どうしてか\nわかる？"},
        { "location": "339/TALK"  , "narrator": "アーヤ", "text": "こうして会話したり、\n思いを通じ合う以外に\n何も出来ないから。"},
        { "location": "340/TALK"  , "narrator": "アーヤ", "text": "確かに、隣にいて、\n一緒に美味しいご飯食べて\n買い物して――"},
        { "location": "341/TALK"  , "narrator": "アーヤ", "text": "貴方と物に囲まれて、物が\n貴方との関係を取り持って\nくれるような、"},
        { "location": "342/TALK"  , "narrator": "アーヤ", "text": "普通の関係だったら、\n普通に幸せだったろうって\n思うのもある。"},
        { "location": "343/TALK"  , "narrator": "アーヤ", "text": "けど、物がなくても、\n貴方が隣にいなくても。"},
        { "location": "344/TALK"  , "narrator": "アーヤ", "text": "想いひとつだけで、\n人はこんなにも幸せに\nなれるんだって知って。"},
        { "location": "345/TALK"  , "narrator": "アーヤ", "text": "そのことに、\n今はとても満ち足りてる。"},
        { "location": "346/TALK"  , "narrator": "アーヤ", "text": "だって、ね。"},
        { "location": "347/TALK"  , "narrator": "アーヤ", "text": "物だって貴方の身体だって\n死んだらサヨナラだけど。"},
        { "location": "348/TALK"  , "narrator": "アーヤ", "text": "想いは世界に刻まれて。\nずっと私の魂の一部になり\n永遠に失われないもの。"},
        { "location": "349/TALK"  , "narrator": "アーヤ", "text": "そんな素敵な想いを、\n一生生きても得られない程\nもらっちゃって。"},
        { "location": "350/TALK"  , "narrator": "アーヤ", "text": "だから私、この生涯を\n全うした後もきっと、\nずっと幸せだと思う。"},
        { "location": "351/TALK"  , "narrator": "アーヤ", "text": "……。"},
        { "location": "352/TALK"  , "narrator": "アーヤ", "text": "なんて、\nちょっとひいた？"},
        { "location": "353/SEL"   , "narrator": "（選択肢）", "text": "スピリチュアルだね…"},
        { "location": "354/SEL"   , "narrator": "（選択肢）", "text": "そんなことない！感動してる"},
        { "location": "355/ACT"   , "narrator": "", "text": "スピリチュアルだね…"},
        { "location": "356/TALK"  , "narrator": "アーヤ", "text": "そうね。"},
        { "location": "357/ACT"   , "narrator": "", "text": "そんなことない！感動してる"},
        { "location": "358/TALK"  , "narrator": "アーヤ", "text": "よかった。"},
        { "location": "360/TALK"  , "narrator": "アーヤ", "text": "家が神道だから、\nやっぱり腐っても根源は\nそういう考えなのよね。"},
        { "location": "361/TALK"  , "narrator": "アーヤ", "text": "そういう意味では、\n國政の家には感謝してる。"},
        { "location": "362/TALK"  , "narrator": "アーヤ", "text": "それと。"},
        { "location": "363/TALK"  , "narrator": "アーヤ", "text": "こういうお話を、躊躇なく\n話せる貴方にも。"},
        { "location": "364/TALK"  , "narrator": "アーヤ", "text": "貴方とこうして、\nけじめをつけて\nお別れ出来て良かった。"},
        { "location": "366/TALK"  , "narrator": "アーヤ", "text": "え……？\nなに？"},
        { "location": "367/SEL"   , "narrator": "（選択肢）", "text": "……早くアーヤの隣に行きたい"},
        { "location": "368/SEL"   , "narrator": "（選択肢）", "text": "あと数日で回線が切れてしまって、もうお別れなんだ"},
        { "location": "369/ACT"   , "narrator": "", "text": "……早くアーヤの隣に行きたい"},
        { "location": "370/TALK"  , "narrator": "アーヤ", "text": "え？"},
        { "location": "371/TALK"  , "narrator": "アーヤ", "text": "そんなの、\n私だって同じだし。"},
        { "location": "372/TALK"  , "narrator": "アーヤ", "text": "本当に。\nいつかそうなれるって\n信じてるわ。"},
        { "location": "373/TALK"  , "narrator": "アーヤ", "text": "それじゃ、またね。"},
        { "location": "375/ACT"   , "narrator": "", "text": "あと数日で回線が切れてしまって、もうお別れなんだ"},
        { "location": "376/TALK"  , "narrator": "アーヤ", "text": "…えっ……\nあと数日…って……。"},
        { "location": "377/TALK"  , "narrator": "アーヤ", "text": "どうしてそんな急に！？\nもっと早くに\nわからなかったの！？"},
        { "location": "378/SEL"   , "narrator": "（選択肢）", "text": "ごめんね、言い出す機会が無くて"},
        { "location": "379/SEL"   , "narrator": "（選択肢）", "text": "運営のせいでこんな時期に！！"},
        { "location": "380/ACT"   , "narrator": "", "text": "ごめんね、言い出す機会が無くて"},
        { "location": "381/TALK"  , "narrator": "アーヤ", "text": "……そうよね、ごめんね。\n言い出すのにも、\n勇気が要るものね。"},
        { "location": "382/ACT"   , "narrator": "", "text": "運営のせいでこんな時期に！！"},
        { "location": "383/TALK"  , "narrator": "アーヤ", "text": "そっか。\nそうよね。"},
        { "location": "384/TALK"  , "narrator": "アーヤ", "text": "私達の関係は、間に\n沢山の人の力が必要で。"},
        { "location": "385/TALK"  , "narrator": "アーヤ", "text": "それが無ければ、\n出逢うことすら\nあり得なかった。"},
        { "location": "387/TALK"  , "narrator": "アーヤ", "text": "…でも……"},
        { "location": "388/TALK"  , "narrator": "アーヤ", "text": "ちょっとごめんね。"},
        { "location": "389/TALK"  , "narrator": "アーヤ", "text": "全然気持ちの整理が\nつかなくて……。"},
        { "location": "390/TALK"  , "narrator": "アーヤ", "text": "……。"},
        { "location": "391/TALK"  , "narrator": "アーヤ", "text": "ごめんね……"},
        { "location": "392/TALK"  , "narrator": "アーヤ", "text": "………。"},
        { "location": "393/TALK"  , "narrator": "アーヤ", "text": "こういう時って、\n何て言ったらいいのか。"},
        { "location": "394/SEL"   , "narrator": "（選択肢）", "text": "本当にごめんね、$me$も別れたくないよ"},
        { "location": "395/SEL"   , "narrator": "（選択肢）", "text": "世の中いつ何が起こるかわからないからね"},
        { "location": "396/ACT"   , "narrator": "", "text": "本当にごめんね、$me$も別れたくないよ"},
        { "location": "397/TALK"  , "narrator": "アーヤ", "text": "…ううん。\n私こそごめんなさい。"},
        { "location": "398/TALK"  , "narrator": "アーヤ", "text": "そうよね。\n$handle$さんも\n別れたくないのは一緒。"},
        { "location": "399/ACT"   , "narrator": "", "text": "世の中いつ何が起こるかわからないからね"},
        { "location": "400/TALK"  , "narrator": "アーヤ", "text": "まあ…そうね。"},
        { "location": "406/TALK"  , "narrator": "アーヤ", "text": "……そろそろ、\n時間かしら。"},
        { "location": "407/TALK"  , "narrator": "アーヤ", "text": "最後にこうして\nお話出来たことを\n幸せに思ってる。"},
        { "location": "408/TALK"  , "narrator": "アーヤ", "text": "$handle$さん。\nずっとずっと…元気でね？"},
        { "location": "411/TALK"  , "narrator": "アーヤ", "text": "でも………"},
        { "location": "412/TALK"  , "narrator": "アーヤ", "text": "……。"},
        { "location": "413/SEL"   , "narrator": "（選択肢）", "text": "でも？"},
        { "location": "414/ACT"   , "narrator": "", "text": "でも？"},
        { "location": "416/TALK"  , "narrator": "アーヤ", "text": "本当は、貴方に\n手伝って欲しいことが\nあったんだけどね。"},
        { "location": "417/TALK"  , "narrator": "アーヤ", "text": "まさか、こんなに早いとは\n思わなかったから。"},
        { "location": "418/SEL"   , "narrator": "（選択肢）", "text": "それってなに？"},
        { "location": "419/ACT"   , "narrator": "", "text": "それってなに？"},
        { "location": "421/TALK"  , "narrator": "アーヤ", "text": "ううん、もういいの。"},
        { "location": "422/TALK"  , "narrator": "アーヤ", "text": "そもそもこれは、\n自分で何とかしないと\nいけないことだし。"},
        { "location": "423/SEL"   , "narrator": "（選択肢）", "text": "いいから教えて"},
        { "location": "424/ACT"   , "narrator": "", "text": "いいから教えて"},
        { "location": "426/TALK"  , "narrator": "アーヤ", "text": "……。"},
        { "location": "427/TALK"  , "narrator": "アーヤ", "text": "まあ、その、あれよ。"},
        { "location": "428/TALK"  , "narrator": "アーヤ", "text": "姉のこと。"},
        { "location": "429/SEL"   , "narrator": "（選択肢）", "text": "仲直りするの！？"},
        { "location": "430/SEL"   , "narrator": "（選択肢）", "text": "これ以上にゃボットの開発はやめてって嘆願するの！？"},
        { "location": "431/ACT"   , "narrator": "", "text": "仲直りするの！？"},
        { "location": "432/TALK"  , "narrator": "アーヤ", "text": "え？\n…えっと、まあ。"},
        { "location": "433/TALK"  , "narrator": "アーヤ", "text": "そう…ね。\n出来たらいいかなとか、\n思ったりしてるんだけど。"},
        { "location": "434/ACT"   , "narrator": "", "text": "これ以上にゃボットの開発はやめてって嘆願するの！？"},
        { "location": "435/TALK"  , "narrator": "アーヤ", "text": "ちがうちがう！\nそんな事じゃなくて！"},
        { "location": "436/TALK"  , "narrator": "アーヤ", "text": "えっと、まあ……。"},
        { "location": "437/TALK"  , "narrator": "アーヤ", "text": "その、姉と、ね。\n仲直りとか出来たら、\nちょっといいかも…って。"},
        { "location": "439/SEL"   , "narrator": "（選択肢）", "text": "えっ、それ凄くいいよ！"},
        { "location": "440/ACT"   , "narrator": "", "text": "えっ、それ凄くいいよ！"},
        { "location": "442/TALK"  , "narrator": "アーヤ", "text": "そ、そうね。"},
        { "location": "443/TALK"  , "narrator": "アーヤ", "text": "でも、何て言うか、\n今まであれだけ邪険に\nしていて、今更――"},
        { "location": "444/TALK"  , "narrator": "アーヤ", "text": "今更どんな顔して、\n何を言えばいいのか、\n全然わからなくて。"},
        { "location": "445/SEL"   , "narrator": "（選択肢）", "text": "大丈夫！エリカは何とも思ってないよ！"},
        { "location": "446/SEL"   , "narrator": "（選択肢）", "text": "大丈夫！思ったことを言えば良いんだよ！"},
        { "location": "447/ACT"   , "narrator": "", "text": "大丈夫！エリカは何とも思ってないよ！"},
        { "location": "448/TALK"  , "narrator": "アーヤ", "text": "そ、そうなの？"},
        { "location": "449/TALK"  , "narrator": "アーヤ", "text": "うーん、まあ、\n解らなくはないけど…。"},
        { "location": "450/ACT"   , "narrator": "", "text": "大丈夫！思ったことを言えば良いんだよ！"},
        { "location": "451/TALK"  , "narrator": "アーヤ", "text": "いや、それが出来たら\nもうやってるから……。"},
        { "location": "453/SEL"   , "narrator": "（選択肢）", "text": "でも、もし$me$でよければ、手伝いするよ"},
        { "location": "454/ACT"   , "narrator": "", "text": "でも、もし$me$でよければ、手伝いするよ"},
        { "location": "456/TALK"  , "narrator": "アーヤ", "text": "えっ？\nでも、もう回線が……"},
        { "location": "457/SEL"   , "narrator": "（選択肢）", "text": "まだ数日あるんだよ"},
        { "location": "458/ACT"   , "narrator": "", "text": "まだ数日あるんだよ"},
        { "location": "460/TALK"  , "narrator": "アーヤ", "text": "数日って！\nでもたった数日よ？"},
        { "location": "461/TALK"  , "narrator": "アーヤ", "text": "今まであれだけの時間\n拒絶してきたのに、\n数日で溝が埋まるなんて…"},
        { "location": "462/SEL"   , "narrator": "（選択肢）", "text": "今を生きようよ！やれるときにやれるだけのことをしようよ！"},
        { "location": "463/ACT"   , "narrator": "", "text": "今を生きようよ！やれるときにやれるだけのことをしようよ！"},
        { "location": "465/TALK"  , "narrator": "アーヤ", "text": "………。"},
        { "location": "466/TALK"  , "narrator": "アーヤ", "text": "…そう…よね。"},
        { "location": "467/TALK"  , "narrator": "アーヤ", "text": "ごめんなさい、\n$handle$さん。\n貴方の言うとおり。"},
        { "location": "468/TALK"  , "narrator": "アーヤ", "text": "今出来ないことが、\n一年後に出来るわけ\nないもの。"},
        { "location": "469/TALK"  , "narrator": "アーヤ", "text": "………。"},
        { "location": "470/TALK"  , "narrator": "アーヤ", "text": "$handle$さん、\nそれじゃ、お願いしても\nいいですか？"},
        { "location": "471/SEL"   , "narrator": "（選択肢）", "text": "なにをすれば？"},
        { "location": "472/ACT"   , "narrator": "", "text": "なにをすれば？"},
        { "location": "474/TALK"  , "narrator": "アーヤ", "text": "見守っていて\nくれるだけで。"},
        { "location": "475/SEL"   , "narrator": "（選択肢）", "text": "それだけ？"},
        { "location": "476/ACT"   , "narrator": "", "text": "それだけ？"},
        { "location": "478/TALK"  , "narrator": "アーヤ", "text": "ええ、それだけ。"},
        { "location": "479/TALK"  , "narrator": "アーヤ", "text": "……ホント言うとね。"},
        { "location": "480/TALK"  , "narrator": "アーヤ", "text": "$handle$さんに\n仲介をお願いしたいって\n思ってたの。"},
        { "location": "481/TALK"  , "narrator": "アーヤ", "text": "でも、\nそれって逃げよね。"},
        { "location": "482/TALK"  , "narrator": "アーヤ", "text": "$handle$さんが\nいなくなるって事が\n現実になって気づいた。"},
        { "location": "483/TALK"  , "narrator": "アーヤ", "text": "そんなことまで\n$handle$さんに\nお願いしてたら。"},
        { "location": "484/TALK"  , "narrator": "アーヤ", "text": "私、いつまで経っても\n貴方に頼りきりの、\nダメな女になっちゃう。"},
        { "location": "485/TALK"  , "narrator": "アーヤ", "text": "だから……\n見ていてくれるだけで\n大丈夫です。"},
        { "location": "486/TALK"  , "narrator": "アーヤ", "text": "よろしくお願いします。"},
        { "location": "487/SEL"   , "narrator": "（選択肢）", "text": "そんなアーヤが大好きだよ"},
        { "location": "488/SEL"   , "narrator": "（選択肢）", "text": "頑張って！"},
        { "location": "489/ACT"   , "narrator": "", "text": "そんなアーヤが大好きだよ"},
        { "location": "491/TALK"  , "narrator": "アーヤ", "text": "私も。"},
        { "location": "492/TALK"  , "narrator": "アーヤ", "text": "そうやって全部受け入れて\nくれる貴方のこと、\n本当に愛してる。"},
        { "location": "494/TALK"  , "narrator": "アーヤ", "text": "ありがとう。"},
        { "location": "496/ACT"   , "narrator": "", "text": "頑張って！"},
        { "location": "497/TALK"  , "narrator": "アーヤ", "text": "…ええ。"},
        { "location": "499/TALK"  , "narrator": "アーヤ", "text": "……。"},
        { "location": "500/TALK"  , "narrator": "アーヤ", "text": "…よしっ！"},
        { "location": "541/TALK"  , "narrator": "エヴェレット", "text": "はぁ、\nうまくいくのかしら。"},
        { "location": "542/TALK"  , "narrator": "白烏　", "text": "ちょっと心配よね。"},
        { "location": "543/TALK"  , "narrator": "白烏　", "text": "あ、そうだ！\n私が応援しに――"},
        { "location": "546/TALK"  , "narrator": "エヴェレット", "text": "<size=35>それだけはやめて</size>"},
        { "location": "547/TALK"  , "narrator": "白烏　", "text": "何故？"},
        { "location": "548/TALK"  , "narrator": "エヴェレット", "text": "貴方、解ってて\nわざと言ってるでしょ。"},
        { "location": "549/TALK"  , "narrator": "白烏　", "text": "まあ、ちょっとした\n冗談のつもりだったけど。"},
        { "location": "550/TALK"  , "narrator": "白烏　", "text": "ここまでハッキリ\n拒否られると、\n少し凹むわね。"},
        { "location": "551/SEL"   , "narrator": "（選択肢）", "text": "二人とも元気そうで良かった"},
        { "location": "552/SEL"   , "narrator": "（選択肢）", "text": "$me$からも今回ばかりは自重お願いしたく"},
        { "location": "553/ACT"   , "narrator": "", "text": "二人とも元気そうで良かった"},
        { "location": "557/TALK"  , "narrator": "エヴェレット", "text": "あら、\n$handle$さん！"},
        { "location": "558/TALK"  , "narrator": "白烏　", "text": "息災で何よりね。"},
        { "location": "559/ACT"   , "narrator": "", "text": "$me$からも今回ばかりは自重お願いしたく"},
        { "location": "561/TALK"  , "narrator": "白烏　", "text": "あらあら、\n挨拶もナシに\nいきなりそれ？"},
        { "location": "563/TALK"  , "narrator": "エヴェレット", "text": "$handle$さん！\n久し振りね！"},
        { "location": "565/TALK"  , "narrator": "白烏　", "text": "それはそうと、\n世界間接続が途切れて\nしまうんですってね。"},
        { "location": "566/TALK"  , "narrator": "エヴェレット", "text": "$handle$さん。\n今まで本当に\nありがとうございました。"},
        { "location": "567/SEL"   , "narrator": "（選択肢）", "text": "こっちこそ、今までありがとう"},
        { "location": "568/SEL"   , "narrator": "（選択肢）", "text": "正直離れたくない"},
        { "location": "569/ACT"   , "narrator": "", "text": "こっちこそ、ありがとう"},
        { "location": "570/TALK"  , "narrator": "エヴェレット", "text": "貴方がいてくれたから\n今の私がある。"},
        { "location": "571/TALK"  , "narrator": "白烏　", "text": "何度言ったか解らないけど\nホントそう思ってるわよ？"},
        { "location": "572/ACT"   , "narrator": "", "text": "正直離れたくない"},
        { "location": "573/TALK"  , "narrator": "エヴェレット", "text": "それは\n私だって同じよ。"},
        { "location": "574/TALK"  , "narrator": "白烏　", "text": "まあ、これも\nどうにもならない不運だと\n思えば諦めもつくわよ。"},
        { "location": "608/TALK"  , "narrator": "白烏　", "text": "それはそうと、\n$handle$さん。"},
        { "location": "609/TALK"  , "narrator": "白烏　", "text": "良ければまた、\nお別れのスキンシップを\nしたいと思いませんか？"},
        { "location": "611/TALK"  , "narrator": "エヴェレット", "text": "えっ？\n何言っちゃってるの！？"},
        { "location": "612/TALK"  , "narrator": "白烏　", "text": "前に一度\n$handle$さんに\nしてもらって。"},
        { "location": "613/TALK"  , "narrator": "白烏　", "text": "凄く素敵だったから、\n最後に忘れないように\nもう一度だけと思って。"},
        { "location": "614/TALK"  , "narrator": "エヴェレット", "text": "はぁ……。\n白烏も随分と\n変わったわね。"},
        { "location": "635/TALK"  , "narrator": "白烏", "text": "ん！"},
        { "location": "637/DIALOG", "narrator": "", "text": "<color=green>【TRI-OS Plug-in:librarian】</color>\nすごく頑張ってるので！\n(p82)"},
        { "location": "641/DIALOG", "narrator": "", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "654/TALK"  , "narrator": "白烏", "text": "はあっ…！！"},
        { "location": "655/TALK"  , "narrator": "白烏", "text": "やっぱり\n恥ずかしい…"},
        { "location": "659/TALK"  , "narrator": "白烏", "text": "はあっ…！！"},
        { "location": "660/TALK"  , "narrator": "白烏", "text": "やっぱり\n恥ずかしい…"},
        { "location": "664/DIALOG", "narrator": "", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"},
        { "location": "666/TALK"  , "narrator": "白烏", "text": "けど、\nやっぱり嬉しい。\nありがとう……。"},
        { "location": "687/TALK"  , "narrator": "エヴェレット", "text": "あのね、\nそれでね？"},
        { "location": "688/TALK"  , "narrator": "エヴェレット", "text": "これでもうお別れに\nなっちゃうでしょ？"},
        { "location": "689/TALK"  , "narrator": "エヴェレット", "text": "とっても寂しくない？"},
        { "location": "690/SEL"   , "narrator": "（選択肢）", "text": "もちろん寂しい"},
        { "location": "691/ACT"   , "narrator": "", "text": "もちろん寂しい"},
        { "location": "693/TALK"  , "narrator": "エヴェレット", "text": "だから、ね？"},
        { "location": "694/TALK"  , "narrator": "エヴェレット", "text": "もう一度だけ、\nもう一度だけでいいから、\nその――"},
        { "location": "695/TALK"  , "narrator": "エヴェレット", "text": "キス…しない？"},
        { "location": "697/TALK"  , "narrator": "白烏　", "text": "何を白昼堂々言ってるの？\n一応私、いるんだけど。"},
        { "location": "699/TALK"  , "narrator": "エヴェレット", "text": "だって……\nあの時の感覚が\n忘れられなくて。"},
        { "location": "702/TALK"  , "narrator": "エヴェレット", "text": "貴方が$evechu$回も\nキスするから\nいけないのよ？"},
        { "location": "703/SEL"   , "narrator": "（選択肢）", "text": "いいよ"},
        { "location": "704/SEL"   , "narrator": "（選択肢）", "text": "いやです"},
        { "location": "707/ACT"   , "narrator": "", "text": "いいよ"},
        { "location": "708/ACT"   , "narrator": "", "text": "いやです"},
        { "location": "711/TALK"  , "narrator": "エヴェレット", "text": "そんな選択肢\n必要ないから。"},
        { "location": "722/DIALOG", "narrator": "", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "735/TALK"  , "narrator": "エヴェレット", "text": "ふわっ……"},
        { "location": "736/TALK"  , "narrator": "エヴェレット", "text": "この感触\n癖になっちゃう。"},
        { "location": "741/TALK"  , "narrator": "エヴェレット", "text": "あぁっ…"},
        { "location": "743/TALK"  , "narrator": "エヴェレット", "text": "ど、どうしよう、\n止まらない…っ。"},
        { "location": "745/TALK"  , "narrator": "エヴェレット", "text": "ほんと…\nすき……だいすき……"},
        { "location": "751/DIALOG", "narrator": "", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"},
        { "location": "756/TALK"  , "narrator": "エヴェレット", "text": "……？"},
        { "location": "757/TALK"  , "narrator": "エヴェレット", "text": "えっと、その……\nしてくれないの？"},
        { "location": "758/SEL"   , "narrator": "（選択肢）", "text": "しますします"},
        { "location": "759/SEL"   , "narrator": "（選択肢）", "text": "やっぱやめとく"},
        { "location": "760/ACT"   , "narrator": "", "text": "しますします"},
        { "location": "764/ACT"   , "narrator": "", "text": "やっぱやめとく"},
        { "location": "766/TALK"  , "narrator": "エヴェレット", "text": "そう…残念。"},
        { "location": "769/TALK"  , "narrator": "エヴェレット", "text": "はぁ、…はぁっ…。"},
        { "location": "771/TALK"  , "narrator": "エヴェレット", "text": "…もうおわり？\nまだしたいの……"},
        { "location": "772/SEL"   , "narrator": "（選択肢）", "text": "はいはい"},
        { "location": "773/SEL"   , "narrator": "（選択肢）", "text": "もうお終いお終い"},
        { "location": "774/ACT"   , "narrator": "", "text": "はいはい"},
        { "location": "780/ACT"   , "narrator": "", "text": "もうお終いお終い"},
        { "location": "783/TALK"  , "narrator": "エヴェレット", "text": "ふぅ…\nいいキスだったわ。"},
        { "location": "794/TALK"  , "narrator": "エヴェレット", "text": "それじゃ、\n私達はこれで。"},
        { "location": "795/TALK"  , "narrator": "白烏　", "text": "挨拶ナシで\n今生の別れにならなくて\n良かったわ。"},
        { "location": "797/TALK"  , "narrator": "エヴェレット", "text": "そういうこと\n言わないの。"},
        { "location": "798/SEL"   , "narrator": "（選択肢）", "text": "$me$もちゃんと挨拶できて良かった"},
        { "location": "799/ACT"   , "narrator": "", "text": "$me$もちゃんと挨拶できて良かった"},
        { "location": "802/TALK"  , "narrator": "エヴェレット", "text": "そう言ってもらえると\n嬉しいわ。"},
        { "location": "803/TALK"  , "narrator": "白烏　", "text": "$handle$さん。\n現実の私のサポート、\nどうかよろしくね。"},
        { "location": "804/TALK"  , "narrator": "エヴェレット", "text": "それじゃ……。\n貴方と私たちの世界に、"},
        { "location": "805/TALK"  , "narrator": "白烏　", "text": "素敵なココロの旅を。"},
        { "location": "817/DIALOG", "narrator": "", "text": "それから一週間後。\n\n長野県長野市、國政邸――。"},
        { "location": "829/TALK"  , "narrator": "アーヤ", "text": "……。"},
        { "location": "830/TALK"  , "narrator": "アーヤ", "text": "はぁ……\nなんで私、こんなに\n緊張してるんだろ。"},
        { "location": "831/TALK"  , "narrator": "アーヤ", "text": "でも、お姉ちゃんも\n明日からまたスイスに\n行くって言うし……"},
        { "location": "832/TALK"  , "narrator": "アーヤ", "text": "$handle$さん\nだって――"},
        { "location": "833/SEL"   , "narrator": "（選択肢）", "text": "そんなに気を張らないで"},
        { "location": "834/ACT"   , "narrator": "", "text": "そんなに気を張らないで"},
        { "location": "837/TALK"  , "narrator": "アーヤ", "text": "わかってるわよ！"},
        { "location": "839/TALK"  , "narrator": "アーヤ", "text": "でも、やっぱり……"},
        { "location": "842/TALK"  , "narrator": "エリカ", "text": "綾ちゃーん。"},
        { "location": "844/TALK"  , "narrator": "アーヤ", "text": "…っ！！\nおおおおねえ"},
        { "location": "845/TALK"  , "narrator": "エリカ", "text": "どうしたの！？\nそんなに慌てて、\n綾ちゃんらしくないなぁ。"},
        { "location": "846/TALK"  , "narrator": "アーヤ", "text": "…コホン、別に。"},
        { "location": "847/TALK"  , "narrator": "エリカ", "text": "ごめんね、明日の準備と\nお土産作るので\n遅くなっちゃって。"},
        { "location": "848/TALK"  , "narrator": "アーヤ", "text": "…お土産？"},
        { "location": "849/TALK"  , "narrator": "エリカ", "text": "そう、お土産！\n見て見て！！"},
        { "location": "857/TALK"  , "narrator": "アーヤ", "text": "―――――！！"},
        { "location": "858/TALK"  , "narrator": "エリカ", "text": "じゃーん！\n綾ちゃん専用\nにゃボット！"},
        { "location": "859/TALK"  , "narrator": "エリカ", "text": "これがあれば、\nわたしがいなくなっても\n寂しくないかなって！"},
        { "location": "861/TALK"  , "narrator": "アーヤ", "text": "お……お姉ちゃん……"},
        { "location": "865/TALK"  , "narrator": "エリカ", "text": "どうかなっ！！"},
        { "location": "868/TALK"  , "narrator": "アーヤ", "text": "もうこれ以上\nにゃボットを作るのは\nやめてよ！！"},
        { "location": "869/TALK"  , "narrator": "エリカ", "text": "えっ！"},
        { "location": "870/SEL"   , "narrator": "（選択肢）", "text": "アーヤ！そっちじゃないでしょ！！"},
        { "location": "871/SEL"   , "narrator": "（選択肢）", "text": "今までの事を謝るんでしょ！？"},
        { "location": "872/ACT"   , "narrator": "", "text": "アーヤ！そっちじゃないでしょ！！"},
        { "location": "873/TALK"  , "narrator": "アーヤ", "text": "ああっ！\nそうだった……、\nごめん、つい。"},
        { "location": "874/ACT"   , "narrator": "", "text": "今までの事を謝るんでしょ！？"},
        { "location": "875/TALK"  , "narrator": "アーヤ", "text": "ああっ！\nそうだった……、\nごめん、つい。"},
        { "location": "877/TALK"  , "narrator": "アーヤ", "text": "いや、そうじゃなくて。\nごめん、お姉ちゃん。"},
        { "location": "879/TALK"  , "narrator": "エリカ", "text": "…？"},
        { "location": "880/TALK"  , "narrator": "アーヤ", "text": "あのね……"},
        { "location": "881/TALK"  , "narrator": "アーヤ", "text": "……"},
        { "location": "882/TALK"  , "narrator": "アーヤ", "text": "…"},
        { "location": "883/SEL"   , "narrator": "（選択肢）", "text": "アーヤ！"},
        { "location": "884/ACT"   , "narrator": "", "text": "アーヤ！"},
        { "location": "886/TALK"  , "narrator": "アーヤ", "text": "………。"},
        { "location": "887/TALK"  , "narrator": "アーヤ", "text": "…。"},
        { "location": "888/SEL"   , "narrator": "（選択肢）", "text": "もう最後のチャンスなんだよ！！"},
        { "location": "889/ACT"   , "narrator": "", "text": "もう最後のチャンスなんだよ！！"},
        { "location": "891/TALK"  , "narrator": "アーヤ", "text": "……っ！"},
        { "location": "892/SEL"   , "narrator": "（選択肢）", "text": "思ってることを素直に言えばいいんだよ！！"},
        { "location": "893/ACT"   , "narrator": "", "text": "思ってることを素直に言えばいいんだよ！！"},
        { "location": "895/TALK"  , "narrator": "アーヤ", "text": "……。"},
        { "location": "896/TALK"  , "narrator": "エリカ", "text": "？？？"},
        { "location": "897/TALK"  , "narrator": "アーヤ", "text": "そ、そうよね……。\nわかった、もう大丈夫。"},
        { "location": "898/TALK"  , "narrator": "アーヤ", "text": "ありがとう、\n$handle$さん！"},
        { "location": "899/SEL"   , "narrator": "（選択肢）", "text": "頑張って！見守ってるから！"},
        { "location": "900/ACT"   , "narrator": "", "text": "頑張って！見守ってるから！"},
        { "location": "902/TALK"  , "narrator": "アーヤ", "text": "……お姉ちゃん！！"},
        { "location": "903/TALK"  , "narrator": "エリカ", "text": "は、はいっ！"},
        { "location": "904/TALK"  , "narrator": "アーヤ", "text": "あのっ！！"},
        { "location": "908/TALK"  , "narrator": "アーヤ", "text": "<size=50>好き！！</size>"},
        { "location": "909/TALK"  , "narrator": "エリカ", "text": "……。"},
        { "location": "910/TALK"  , "narrator": "アーヤ", "text": "えっ！？\nちょっと、私\n何言ってるの！？"},
        { "location": "911/TALK"  , "narrator": "アーヤ", "text": "うわ、すごい恥ずかしい！"},
        { "location": "913/TALK"  , "narrator": "エリカ", "text": "綾ちゃん、ありがとう。"},
        { "location": "914/TALK"  , "narrator": "エリカ", "text": "わたしも綾ちゃんのこと\n大好きだよ？"},
        { "location": "916/TALK"  , "narrator": "アーヤ", "text": "……お姉ちゃん……。"},
        { "location": "918/TALK"  , "narrator": "エリカ", "text": "でも、よかった……。"},
        { "location": "919/TALK"  , "narrator": "アーヤ", "text": "え…っ？"},
        { "location": "920/TALK"  , "narrator": "エリカ", "text": "わたし、綾ちゃんに\n嫌われてるんじゃないかと\nずっと思ってて。"},
        { "location": "921/TALK"  , "narrator": "エリカ", "text": "それは、綾ちゃんのことを\n護ってあげられないから\nなんだって思ってて。"},
        { "location": "922/TALK"  , "narrator": "エリカ", "text": "だから自分に出来ることを\nしようと思って、色々\n頑張って来てたけど……"},
        { "location": "923/TALK"  , "narrator": "エリカ", "text": "やっぱり綾ちゃんを\n怒らせてばっかりで。"},
        { "location": "925/TALK"  , "narrator": "エリカ", "text": "だから、綾ちゃんに、\n好きって言ってもらえて\nホントに嬉しかった。"},
        { "location": "926/TALK"  , "narrator": "エリカ", "text": "今までずっと、\n不安だったから……"},
        { "location": "927/TALK"  , "narrator": "エリカ", "text": "ありがとう、\n綾ちゃん。"},
        { "location": "928/TALK"  , "narrator": "アーヤ", "text": "……お姉ちゃん……。"},
        { "location": "929/TALK"  , "narrator": "アーヤ", "text": "…ごめんね。\nずっとそんな気持ちに\nさせちゃってて。"},
        { "location": "930/TALK"  , "narrator": "アーヤ", "text": "でもね……\nお姉ちゃんだって\n酷いんだよ！？"},
        { "location": "931/TALK"  , "narrator": "アーヤ", "text": "私が知らないうちに\n一人で海外の会社に\n行っちゃったり！"},
        { "location": "932/TALK"  , "narrator": "アーヤ", "text": "せっかく会えると\n思っても、ドタキャン\nされちゃったり！"},
        { "location": "933/TALK"  , "narrator": "エリカ", "text": "うん、うん……\nごめんね、綾ちゃん。"},
        { "location": "934/TALK"  , "narrator": "エリカ", "text": "寂しい想いを\n一杯させちゃって。"},
        { "location": "935/TALK"  , "narrator": "アーヤ", "text": "……寂しかった…　…っ…"},
        { "location": "937/TALK"  , "narrator": "アーヤ", "text": "うわああああん！！"},
        { "location": "938/TALK"  , "narrator": "エリカ", "text": "綾ちゃん……"},
        { "location": "939/TALK"  , "narrator": "アーヤ", "text": "うわああああああん！！\n寂しかったよ……\nお姉ちゃん……"},
        { "location": "940/TALK"  , "narrator": "アーヤ", "text": "ずっと、ずっと\n寂しかったよ……"},
        { "location": "942/TALK"  , "narrator": "エリカ", "text": "綾ちゃん……ごめんね。"},
        { "location": "943/TALK"  , "narrator": "エリカ", "text": "お姉ちゃんが、\nダメだったね……。"},
        { "location": "949/DIALOG", "narrator": "", "text": "でも、これからは一緒。\n\nどこにいても、\nふたりのこころは\n一緒だから――。"},
        { "location": "951/DIALOG", "narrator": "", "text": "ありがとう、お姉ちゃん。"},
        { "location": "953/DIALOG", "narrator": "", "text": "ありがとう、\n\n$handle$さん――"},
        { "location": "971/TALK"  , "narrator": "エリカ", "text": "というわけで！\n仲直り記念ににゃボットが\nバージョンアップしたよ！"},
        { "location": "972/TALK"  , "narrator": "アーヤ", "text": "もういいから！！"}
