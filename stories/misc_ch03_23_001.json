    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "クイーンズ・ギャンビット"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "$marzanna$は"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "チェスができて？"},
        { "location": "35/SEL"    , "narrator": "", "text": "できるよ"},
        { "location": "36/SEL"    , "narrator": "", "text": "知らない"},
        { "location": "37/SEL"    , "narrator": "", "text": "ガブの手ほどきが受けたいな"},
        { "location": "38/ACT"    , "narrator": "", "text": "できるよ"},
        { "location": "39/TALK"   , "narrator": "ガブリエラ", "text": "そうよね"},
        { "location": "41/TALK"   , "narrator": "ガブリエラ", "text": "当然よね"},
        { "location": "42/ACT"    , "narrator": "", "text": "知らない"},
        { "location": "43/TALK"   , "narrator": "ガブリエラ", "text": "あら"},
        { "location": "44/TALK"   , "narrator": "ガブリエラ", "text": "そうなのかしら"},
        { "location": "45/ACT"    , "narrator": "", "text": "ガブの手ほどきが受けたいな"},
        { "location": "47/TALK"   , "narrator": "ガブリエラ", "text": "そうなの？"},
        { "location": "48/TALK"   , "narrator": "ガブリエラ", "text": "じゃあ"},
        { "location": "49/TALK"   , "narrator": "ガブリエラ", "text": "教えてあげるわね"},
        { "location": "51/TALK"   , "narrator": "ガブリエラ", "text": "日本だとやっぱり"},
        { "location": "52/TALK"   , "narrator": "ガブリエラ", "text": "チェスより将棋なのかしら"},
        { "location": "54/SEL"    , "narrator": "", "text": "囲碁かな"},
        { "location": "55/SEL"    , "narrator": "", "text": "麻雀だよ！"},
        { "location": "56/SEL"    , "narrator": "", "text": "ソシャゲだねー"},
        { "location": "57/SEL"    , "narrator": "", "text": "ガブとのラブゲームが一番熱い"},
        { "location": "58/ACT"    , "narrator": "", "text": "囲碁かな"},
        { "location": "59/TALK"   , "narrator": "ガブリエラ", "text": "囲碁なの？"},
        { "location": "60/TALK"   , "narrator": "ガブリエラ", "text": "そうだったのね、、、"},
        { "location": "61/ACT"    , "narrator": "", "text": "麻雀だよ！"},
        { "location": "62/TALK"   , "narrator": "ガブリエラ", "text": "さすがにそれは"},
        { "location": "64/TALK"   , "narrator": "ガブリエラ", "text": "だませないわよ"},
        { "location": "65/ACT"    , "narrator": "", "text": "ソシャゲだねー"},
        { "location": "66/TALK"   , "narrator": "ガブリエラ", "text": "確かに"},
        { "location": "68/TALK"   , "narrator": "ガブリエラ", "text": "そうかもしれないわ"},
        { "location": "69/ACT"    , "narrator": "", "text": "ガブとのラブゲームが一番熱い"},
        { "location": "71/TALK"   , "narrator": "ガブリエラ", "text": "またそんなことばっかり"},
        { "location": "72/TALK"   , "narrator": "ガブリエラ", "text": "ラブは"},
        { "location": "73/TALK"   , "narrator": "ガブリエラ", "text": "ゲームなんかじゃなくてよ"},
        { "location": "74/TALK"   , "narrator": "ガブリエラ", "text": "真剣勝負なんだから"},
        { "location": "76/TALK"   , "narrator": "ガブリエラ", "text": "私もちょっと忘れ気味だけど"},
        { "location": "77/TALK"   , "narrator": "ガブリエラ", "text": "指してると思い出すはずだわ"},
        { "location": "78/TALK"   , "narrator": "ガブリエラ", "text": "誰かできる人いないかしらね"}
    ]
}
