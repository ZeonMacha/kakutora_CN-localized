    "entry":
    [
        { "location": "35/TALK", "narrator": "プレイヤー", "text": "今日はいつもと違う雰囲気でコーデしてみませんか？"},
        { "location": "37/TALK", "narrator": "プレイヤー", "text": "お姫様、お召し替えのお時間ですよ"},
        { "location": "39/TALK", "narrator": "プレイヤー", "text": "違う服のガブリエラが見たいよ"},
        { "location": "45/TALK", "narrator": "プレイヤー", "text": "やあ"},
        { "location": "47/TALK", "narrator": "プレイヤー", "text": "こんにちは"},
        { "location": "49/TALK", "narrator": "プレイヤー", "text": "げんき？"},
        { "location": "52/TALK", "narrator": "ガブリエラ", "text": "あら"},
        { "location": "53/TALK", "narrator": "ガブリエラ", "text": "なにかしらこれ"},
        { "location": "55/SEL" , "narrator": "", "text": "あなたの$handle$です"},
        { "location": "56/ACT" , "narrator": "", "text": "あなたの$handle$です"},
        { "location": "58/TALK", "narrator": "ガブリエラ", "text": "いや、わかるわよ"},
        { "location": "59/TALK", "narrator": "ガブリエラ", "text": "メンテのお知らせとかかしら？"},
        { "location": "61/SEL" , "narrator": "", "text": "気分転換に着替えてみませんか？"},
        { "location": "62/ACT" , "narrator": "", "text": "気分転換に着替えてみませんか？"},
        { "location": "72/TALK", "narrator": "ガブリエラ", "text": "え？　それって要するに着替えてってこと？"},
        { "location": "73/TALK", "narrator": "ガブリエラ", "text": "まあ、良いけど…どれにしようかしら？"},
        { "location": "75/TALK", "narrator": "ガブリエラ", "text": "今授業中なんだけど"},
        { "location": "76/TALK", "narrator": "ガブリエラ", "text": "まあ、ちょっとだけなら…"},
        { "location": "79/SEL" , "narrator": "", "text": "コーデするよ"},
        { "location": "80/SEL" , "narrator": "", "text": "やっぱやめる"},
        { "location": "82/TALK", "narrator": "ガブリエラ", "text": "そうねぇ…"},
        { "location": "85/TALK", "narrator": "ガブリエラ", "text": "やっぱり、今のままで良いわ"},
        { "location": "86/ACT" , "narrator": "", "text": "コーデするよ"},
        { "location": "87/TALK", "narrator": "ガブリエラ", "text": "あらそう？"},
        { "location": "88/TALK", "narrator": "ガブリエラ", "text": "それじゃあ、お任せするわ"},
        { "location": "94/ACT" , "narrator": "", "text": "やっぱやめる"},
        { "location": "95/TALK", "narrator": "ガブリエラ", "text": "だったら着替えてほしいとか言わないで"}
    ]
}
