        { "location": "156/SCENARIO", "narrator": "", "text": "千羽鶴恋愛ゲーム２"},
        { "location": "192/TALK"    , "narrator": "千羽鶴", "text": "ああっ！\nあなたは\n$handle$！"},
        { "location": "193/TALK"    , "narrator": "千羽鶴", "text": "あなたがここにくるのを\nずっと待っていたの！"},
        { "location": "194/SEL"     , "narrator": "", "text": "またすごい背景っすね"},
        { "location": "195/ACT"     , "narrator": "", "text": "またすごい背景っすね"},
        { "location": "197/TALK"    , "narrator": "千羽鶴", "text": "はいはい予算予算。"},
        { "location": "198/TALK"    , "narrator": "千羽鶴", "text": "そういう所にツッコミ\n入れて雰囲気壊さない。"},
        { "location": "199/SEL"     , "narrator": "", "text": "あ、はい…"},
        { "location": "200/ACT"     , "narrator": "", "text": "あ、はい…"},
        { "location": "202/TALK"    , "narrator": "千羽鶴", "text": "わたしの名前は千羽鶴。\n職業は『非攻略対象』。"},
        { "location": "203/TALK"    , "narrator": "千羽鶴", "text": "でもホントは密かに\n『攻略対象』になりたいと\n思ってる女の子なの。"},
        { "location": "205/TALK"    , "narrator": "千羽鶴", "text": "あなたも私が\n攻略対象になって\n欲しいでしょ？"},
        { "location": "206/SEL"     , "narrator": "", "text": "はい！"},
        { "location": "207/SEL"     , "narrator": "", "text": "もちろん！"},
        { "location": "208/SEL"     , "narrator": "", "text": "いいえ"},
        { "location": "209/ACT"     , "narrator": "", "text": "はい！"},
        { "location": "210/ACT"     , "narrator": "", "text": "もちろん！"},
        { "location": "211/ACT"     , "narrator": "", "text": "いいえ"},
        { "location": "212/TALK"    , "narrator": "千羽鶴", "text": "そんな、ひどい……。"},
        { "location": "215/TALK"    , "narrator": "千羽鶴", "text": "うれしい！\n私たち、同じ目的を\n持ってるのね。"},
        { "location": "216/TALK"    , "narrator": "千羽鶴", "text": "同じ目的を持つ者は\nパーティーを組んで\n旅をするの！"},
        { "location": "217/SEL"     , "narrator": "", "text": "いやに説明口調っすね"},
        { "location": "218/ACT"     , "narrator": "", "text": "いやに説明口調っすね"},
        { "location": "220/TALK"    , "narrator": "千羽鶴", "text": "解りやすさ第一。\n予算でワード数が\n限られてるんだから。"},
        { "location": "221/TALK"    , "narrator": "千羽鶴", "text": "そして私の目的は、\nあのお城。"},
        { "location": "222/TALK"    , "narrator": "千羽鶴", "text": "あのお城の中には\n伝説の『非消滅の宝玉』が\n眠っているといわれてる。"},
        { "location": "223/TALK"    , "narrator": "千羽鶴", "text": "だから、私とあなたで\nパーティーを組んで、\nあのお城に行きましょ。"},
        { "location": "224/TALK"    , "narrator": "千羽鶴", "text": "途中に手強い敵が出るかも\nしれないけど、２人の\nラブパワーで殲滅よ！"},
        { "location": "225/SEL"     , "narrator": "", "text": "お、おう…"},
        { "location": "226/ACT"     , "narrator": "", "text": "お、おう…"},
        { "location": "234/SEL"     , "narrator": "", "text": "↑"},
        { "location": "235/SEL"     , "narrator": "", "text": "→"},
        { "location": "236/SEL"     , "narrator": "", "text": "←"},
        { "location": "237/SEL"     , "narrator": "", "text": "↓"},
        { "location": "238/SEL"     , "narrator": "", "text": "クリアを断念する"},
        { "location": "289/ACT"     , "narrator": "", "text": "クリアを断念する"},
        { "location": "228/DIALOG"  , "narrator": "Tutorial/Dialog_chgame", "text": "【チュートリアル】\n選択肢で千羽鶴を動かして、\n奥のお城まで辿り着こう！\n\n<color=red>新方式！\nADVゲームの限界に挑戦した\n選択肢操作型フィールドRPGが\n貴方のプレイを加速する！\n（※特許出願予定）</color>"},
