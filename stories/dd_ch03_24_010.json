{
    "dir": "chap24/daydra/dd_ch03_24_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "24352",
        "cid": "gabriella",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "大掃除デー"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "大掃除デー"},
        { "location": "26/TALK"   , "narrator": "みやび", "text": "なるほどなぁ…。\nうちは気づかんかった\nけんど？"},
        { "location": "29/TALK"   , "narrator": "つばめ", "text": "えぇっ、本当ですか！？"},
        { "location": "30/TALK"   , "narrator": "つばめ", "text": "わたし、帰ってきて\nすぐに気づきましたよ。"},
        { "location": "31/TALK"   , "narrator": "つばめ", "text": "みやびさんの部屋って、\nロボット掃除機とか\nありましたっけ？"},
        { "location": "33/TALK"   , "narrator": "みやび", "text": "あの部屋で動けるような\nロボット掃除機があれば、\n大発明ぞね。"},
        { "location": "36/TALK"   , "narrator": "ガブリエラ", "text": "楽しそうね。\n何盛り上がってたの？"},
        { "location": "38/TALK"   , "narrator": "つばめ", "text": "あ、ガブちゃんは\n東京帰ってきたときに\n気づかなかった？"},
        { "location": "39/TALK"   , "narrator": "つばめ", "text": "部屋の中が、なんとなく\n埃っぽいかも、って。"},
        { "location": "40/TALK"   , "narrator": "ガブリエラ", "text": "はぁ…そうなのよ。\n帰ってきてから\nずっと気になってたのよ。"},
        { "location": "41/TALK"   , "narrator": "つばめ", "text": "やっぱり？"},
        { "location": "42/TALK"   , "narrator": "ガブリエラ", "text": "ええ。だから今日は、\n帰ったら部屋の掃除を\nするつもりよ。"},
        { "location": "45/TALK"   , "narrator": "みやび", "text": "換気するだけでえいやろ？"},
        { "location": "48/TALK"   , "narrator": "ガブリエラ", "text": "それだけじゃ\n綺麗にならないでしょ？"},
        { "location": "49/TALK"   , "narrator": "ガブリエラ", "text": "第一、中途半端にしか\n掃除してないとこなんかで\n生活したくないし。"},
        { "location": "51/TALK"   , "narrator": "みやび", "text": "ガブちゃんは偉いなぁ…。"},
        { "location": "52/TALK"   , "narrator": "みやび", "text": "見習いはせんけんど、\n尊敬するぞね。"},
        { "location": "53/TALK"   , "narrator": "つばめ", "text": "じゃあ、ガブちゃんは\n帰ったら大掃除だね。"},
        { "location": "54/TALK"   , "narrator": "つばめ", "text": "わたしもお手伝いしに\n行くよ。"},
        { "location": "57/TALK"   , "narrator": "ガブリエラ", "text": "いや、いいから。\n一人でできるし。"},
        { "location": "58/TALK"   , "narrator": "つばめ", "text": "でも、二人でやった方が\n早く終わるよ？"},
        { "location": "60/TALK"   , "narrator": "ガブリエラ", "text": "いいの！\nバイト終わった後で\n夜になっちゃうし。"},
        { "location": "61/TALK"   , "narrator": "ガブリエラ", "text": "一人でやるから、\n絶対来ちゃダメよ？"},
        { "location": "77/TALK"   , "narrator": "ガブリエラ", "text": "ただいまー。"},
        { "location": "78/TALK"   , "narrator": "ガブリエラ", "text": "…さて、と。\n面倒になる前に、\nさっさと始めないと。"},
        { "location": "83/TALK"   , "narrator": "ガブリエラ", "text": "よし…、\nま、こんなもんかしら？"},
        { "location": "84/TALK"   , "narrator": "ガブリエラ", "text": "さすがに、暗くなってから\nやるようなことじゃ\nなかったかしら？"},
        { "location": "85/TALK"   , "narrator": "ガブリエラ", "text": "雑巾掛けまでやったから、\nちょっと疲れたし…。"},
        { "location": "86/TALK"   , "narrator": "ガブリエラ", "text": "…休憩しよう。"},
        { "location": "87/TALK"   , "narrator": "ガブリエラ", "text": "ふぅ…。"},
        { "location": "101/TALK"  , "narrator": "ガブリエラ", "text": "あなたにも見えるかしら？"},
        { "location": "102/TALK"  , "narrator": "ガブリエラ", "text": "今日は"},
        { "location": "103/TALK"  , "narrator": "ガブリエラ", "text": "プチ大掃除をしたわ"},
        { "location": "104/TALK"  , "narrator": "ガブリエラ", "text": "おかげで部屋がピカピカ"},
        { "location": "105/TALK"  , "narrator": "ガブリエラ", "text": "やっぱり生活空間は"},
        { "location": "106/TALK"  , "narrator": "ガブリエラ", "text": "これくらい綺麗でないとね"},
        { "location": "108/SEL"   , "narrator": "", "text": "お疲れさま"},
        { "location": "109/ACT"   , "narrator": "", "text": "お疲れさま"},
        { "location": "111/TALK"  , "narrator": "ガブリエラ", "text": "ありがと"},
        { "location": "112/TALK"  , "narrator": "ガブリエラ", "text": "さすがに"},
        { "location": "114/TALK"  , "narrator": "ガブリエラ", "text": "一人でやるのは疲れた"},
        { "location": "115/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$が手伝ってくれたらよかったのに"},
        { "location": "116/TALK"  , "narrator": "ガブリエラ", "text": "なんてね"},
        { "location": "118/SEL"   , "narrator": "", "text": "誰かに手伝ってもらわなかったの？"},
        { "location": "119/SEL"   , "narrator": "", "text": "いいお嫁さんになるよ"},
        { "location": "120/ACT"   , "narrator": "", "text": "誰かに手伝ってもらわなかったの？"},
        { "location": "121/TALK"  , "narrator": "ガブリエラ", "text": "つばめが手伝うって言ってくれたけど"},
        { "location": "122/TALK"  , "narrator": "ガブリエラ", "text": "断ったの"},
        { "location": "123/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$には言ったかしら？"},
        { "location": "124/TALK"  , "narrator": "ガブリエラ", "text": "私ね"},
        { "location": "125/TALK"  , "narrator": "ガブリエラ", "text": "部屋に入られるのって"},
        { "location": "126/TALK"  , "narrator": "ガブリエラ", "text": "あまり好きじゃないのよ"},
        { "location": "129/TALK"  , "narrator": "ガブリエラ", "text": "絶対ダメってことじゃないの"},
        { "location": "130/TALK"  , "narrator": "ガブリエラ", "text": "でも部屋って"},
        { "location": "131/TALK"  , "narrator": "ガブリエラ", "text": "プライベートな空間だし"},
        { "location": "132/TALK"  , "narrator": "ガブリエラ", "text": "それに"},
        { "location": "133/TALK"  , "narrator": "ガブリエラ", "text": "可愛い系の小物とか人形とか"},
        { "location": "134/TALK"  , "narrator": "ガブリエラ", "text": "そういうのもあるから"},
        { "location": "136/TALK"  , "narrator": "ガブリエラ", "text": "見られるの恥ずかしいし/////"},
        { "location": "139/TALK"  , "narrator": "ガブリエラ", "text": "普段みんなの前で"},
        { "location": "140/TALK"  , "narrator": "ガブリエラ", "text": "そういうの"},
        { "location": "141/TALK"  , "narrator": "ガブリエラ", "text": "見せないから//////"},
        { "location": "143/SEL"   , "narrator": "", "text": "みんな知ってると思うよ？"},
        { "location": "144/ACT"   , "narrator": "", "text": "みんな知ってると思うよ？"},
        { "location": "147/TALK"  , "narrator": "ガブリエラ", "text": "そりゃそうよ"},
        { "location": "148/TALK"  , "narrator": "ガブリエラ", "text": "みんな"},
        { "location": "149/TALK"  , "narrator": "ガブリエラ", "text": "一度は部屋に来たことあるし"},
        { "location": "150/TALK"  , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "151/TALK"  , "narrator": "ガブリエラ", "text": "可愛いものが増えるたびに"},
        { "location": "152/TALK"  , "narrator": "ガブリエラ", "text": "何も言われなくても"},
        { "location": "153/TALK"  , "narrator": "ガブリエラ", "text": "思われるかもしれない"},
        { "location": "154/TALK"  , "narrator": "ガブリエラ", "text": "こんな趣味あるんだ"},
        { "location": "155/TALK"  , "narrator": "ガブリエラ", "text": "とか"},
        { "location": "156/TALK"  , "narrator": "ガブリエラ", "text": "ちょっと似合わないかも"},
        { "location": "157/TALK"  , "narrator": "ガブリエラ", "text": "とか"},
        { "location": "158/TALK"  , "narrator": "ガブリエラ", "text": "それが不安で"},
        { "location": "159/TALK"  , "narrator": "ガブリエラ", "text": "部屋にあげたくないの"},
        { "location": "161/SEL"   , "narrator": "", "text": "意外かも"},
        { "location": "162/SEL"   , "narrator": "", "text": "それは仕方ないと思う"},
        { "location": "163/ACT"   , "narrator": "", "text": "意外かも"},
        { "location": "164/TALK"  , "narrator": "ガブリエラ", "text": "そう？"},
        { "location": "165/TALK"  , "narrator": "ガブリエラ", "text": "まあ"},
        { "location": "166/TALK"  , "narrator": "ガブリエラ", "text": "誰にも話したことないし"},
        { "location": "167/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$にだけ"},
        { "location": "169/TALK"  , "narrator": "ガブリエラ", "text": "特別よ"},
        { "location": "172/TALK"  , "narrator": "ガブリエラ", "text": "話し過ぎたかも"},
        { "location": "173/TALK"  , "narrator": "ガブリエラ", "text": "何でかしらね？"},
        { "location": "174/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$には"},
        { "location": "175/TALK"  , "narrator": "ガブリエラ", "text": "いつも気を許し過ぎちゃう"},
        { "location": "176/TALK"  , "narrator": "ガブリエラ", "text": "今の話は"},
        { "location": "177/TALK"  , "narrator": "ガブリエラ", "text": "二人だけの秘密よ"},
        { "location": "178/TALK"  , "narrator": "ガブリエラ", "text": "約束してね"},
        { "location": "179/ACT"   , "narrator": "", "text": "それは仕方ないと思う"},
        { "location": "180/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$までそう言うの？"},
        { "location": "181/TALK"  , "narrator": "ガブリエラ", "text": "仕方ないって言うけど"},
        { "location": "182/TALK"  , "narrator": "ガブリエラ", "text": "私だって"},
        { "location": "185/TALK"  , "narrator": "ガブリエラ", "text": "ううん"},
        { "location": "187/TALK"  , "narrator": "ガブリエラ", "text": "もういいわ"},
        { "location": "188/TALK"  , "narrator": "ガブリエラ", "text": "それじゃあね"},
        { "location": "199/TALK"  , "narrator": "ガブリエラ", "text": "なによ、$marzanna$まで\nそんなこと言って。"},
        { "location": "201/TALK"  , "narrator": "ガブリエラ", "text": "あたしだって、\n女の子なんだか…、\n可愛い物くらい集めるわ。"},
        { "location": "202/TALK"  , "narrator": "ガブリエラ", "text": "…でも、やっぱり\nあたしには似合わないの\nかしら…？"},
        { "location": "206/TALK"  , "narrator": "ガブリエラ", "text": "はぁ…ちょっと\n落ち込むかも…。"},
        { "location": "208/ACT"   , "narrator": "", "text": "いいお嫁さんになるよ"},
        { "location": "209/TALK"  , "narrator": "ガブリエラ", "text": "あら？"},
        { "location": "210/TALK"  , "narrator": "ガブリエラ", "text": "ちょっと言葉が足らないわね"},
        { "location": "211/TALK"  , "narrator": "ガブリエラ", "text": "いいお嫁さんじゃなくて"},
        { "location": "212/TALK"  , "narrator": "ガブリエラ", "text": "世界一のお嫁さんよ"},
        { "location": "213/TALK"  , "narrator": "ガブリエラ", "text": "お料理もできるし"},
        { "location": "214/TALK"  , "narrator": "ガブリエラ", "text": "同い年の子よりも"},
        { "location": "215/TALK"  , "narrator": "ガブリエラ", "text": "勉強は進んでるはずだし"},
        { "location": "216/TALK"  , "narrator": "ガブリエラ", "text": "お掃除だってこの通り"},
        { "location": "217/TALK"  , "narrator": "ガブリエラ", "text": "まだあったわ"},
        { "location": "218/TALK"  , "narrator": "ガブリエラ", "text": "銃も使えるから戦えもするし"},
        { "location": "219/TALK"  , "narrator": "ガブリエラ", "text": "考えてみると私"},
        { "location": "220/TALK"  , "narrator": "ガブリエラ", "text": "お嫁さんとしての条件は"},
        { "location": "221/TALK"  , "narrator": "ガブリエラ", "text": "かなり揃ってるんじゃないかしら？"},
        { "location": "223/SEL"   , "narrator": "", "text": "問題は旦那と喋れるかだね？"},
        { "location": "224/SEL"   , "narrator": "", "text": "戦える、はどうなんだろ？"},
        { "location": "225/ACT"   , "narrator": "", "text": "問題は旦那と喋れるかだね？"},
        { "location": "226/TALK"  , "narrator": "ガブリエラ", "text": "ここでそれ言うの！？"},
        { "location": "228/TALK"  , "narrator": "ガブリエラ", "text": "もぉ"},
        { "location": "229/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$って"},
        { "location": "230/TALK"  , "narrator": "ガブリエラ", "text": "こういうところデリカシーないわ"},
        { "location": "233/TALK"  , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "234/TALK"  , "narrator": "ガブリエラ", "text": "考えてないわけじゃないの"},
        { "location": "235/TALK"  , "narrator": "ガブリエラ", "text": "喋れないことには"},
        { "location": "236/TALK"  , "narrator": "ガブリエラ", "text": "お嫁さんになるなんて"},
        { "location": "237/TALK"  , "narrator": "ガブリエラ", "text": "夢のまた夢だって"},
        { "location": "240/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$みたいに"},
        { "location": "241/TALK"  , "narrator": "ガブリエラ", "text": "安心してお話しできる人なら"},
        { "location": "242/TALK"  , "narrator": "ガブリエラ", "text": "平気だと思うんだけど"},
        { "location": "243/TALK"  , "narrator": "ガブリエラ", "text": "きっとね"},
        { "location": "245/SEL"   , "narrator": "", "text": "光栄だよ"},
        { "location": "246/ACT"   , "narrator": "", "text": "光栄だよ"},
        { "location": "248/TALK"  , "narrator": "ガブリエラ", "text": "まあ"},
        { "location": "249/TALK"  , "narrator": "ガブリエラ", "text": "ちょっとデリカシーないところが"},
        { "location": "250/TALK"  , "narrator": "ガブリエラ", "text": "たまにきずだけど"},
        { "location": "252/TALK"  , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "253/TALK"  , "narrator": "ガブリエラ", "text": "そういうところが"},
        { "location": "254/TALK"  , "narrator": "ガブリエラ", "text": "いいのかもね"},
        { "location": "255/TALK"  , "narrator": "ガブリエラ", "text": "なんてね//////"},
        { "location": "266/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "268/TALK"  , "narrator": "ガブリエラ", "text": "なんか…恥ずかしいこと\n言っちゃってたかも…。"},
        { "location": "269/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$と話すと、\nやっぱり気が緩んじゃうの\nかしら？"},
        { "location": "270/TALK"  , "narrator": "ガブリエラ", "text": "安心するから？\nそれとも…。"},
        { "location": "272/TALK"  , "narrator": "ガブリエラ", "text": "…まあ、いっか。\n悪い気がするって\nわけじゃないんだし。"},
        { "location": "273/ACT"   , "narrator": "", "text": "戦える、はどうなんだろ？"},
        { "location": "274/TALK"  , "narrator": "ガブリエラ", "text": "そうよね"},
        { "location": "275/TALK"  , "narrator": "ガブリエラ", "text": "うっかりしてたわ//////"},
        { "location": "276/TALK"  , "narrator": "ガブリエラ", "text": "家のために戦うのは"},
        { "location": "278/TALK"  , "narrator": "ガブリエラ", "text": "旦那様のお仕事"},
        { "location": "279/TALK"  , "narrator": "ガブリエラ", "text": "あたしは台所で"},
        { "location": "280/TALK"  , "narrator": "ガブリエラ", "text": "エプロン付けてお料理するのが似合う"},
        { "location": "281/SEL"   , "narrator": "", "text": "エプロンに銃入れておくの？"},
        { "location": "282/TALK"  , "narrator": "ガブリエラ", "text": "そんな"},
        { "location": "283/TALK"  , "narrator": "ガブリエラ", "text": "大人しくて可愛い"},
        { "location": "284/TALK"  , "narrator": "ガブリエラ", "text": "ふわふわしたお嫁さんを目指すわ"},
        { "location": "286/ACT"   , "narrator": "", "text": "エプロンに銃入れておくの？"},
        { "location": "288/TALK"  , "narrator": "ガブリエラ", "text": "違うから"},
        { "location": "289/TALK"  , "narrator": "ガブリエラ", "text": "そういうお嫁さんじゃなくて"},
        { "location": "290/TALK"  , "narrator": "ガブリエラ", "text": "普通のお嫁さん！"},
        { "location": "292/TALK"  , "narrator": "ガブリエラ", "text": "そもそも"},
        { "location": "293/TALK"  , "narrator": "ガブリエラ", "text": "エプロンの中に入れるとか"},
        { "location": "294/TALK"  , "narrator": "ガブリエラ", "text": "そんな危ない持ち方しないし"},
        { "location": "295/TALK"  , "narrator": "ガブリエラ", "text": "落ちたら危ないでしょ？"},
        { "location": "296/TALK"  , "narrator": "ガブリエラ", "text": "っていうか"},
        { "location": "297/TALK"  , "narrator": "ガブリエラ", "text": "普通エプロン付けて"},
        { "location": "298/TALK"  , "narrator": "ガブリエラ", "text": "銃なんか持たないし"},
        { "location": "301/TALK"  , "narrator": "ガブリエラ", "text": "漫画の読み過ぎよ"},
        { "location": "16/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>9月2日　 10:03 AM</color>\nとある平日の休み時間、付属学園食堂にて"}
    ]
}
