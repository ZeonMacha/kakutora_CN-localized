{
    "dir": "dramatics/daydra/drm_ch01_00_330.js",
    "type": "Episode",
    "info": {
        "story_id": "1033",
        "cid": "tsubame",
        "title": "らぶとーく 第33話",
        "sub_title": "そっとしておけ"
    },
    "entry":
    [
        { "location": "315/SCENARIO", "narrator": "", "text": "そっとしておけ"},
        { "location": "325/TALK"    , "narrator": "つばめ", "text": "…ここにもいない。"},
        { "location": "327/TALK"    , "narrator": "つばめ", "text": "卯月さん、\nどこに行ったんだろ？"},
        { "location": "329/TALK"    , "narrator": "つばめ", "text": "卯月さーん。\nどこ行ったのー？"},
        { "location": "332/TALK"    , "narrator": "真幌", "text": "逢瀬。"},
        { "location": "334/TALK"    , "narrator": "つばめ", "text": "あ、真幌さん。\n卯月さん、\n見ませんでしたか？"},
        { "location": "335/TALK"    , "narrator": "真幌", "text": "いや、見ていないが…。"},
        { "location": "336/TALK"    , "narrator": "真幌", "text": "それより、少しいいか？\n話があるんだが…。"},
        { "location": "337/SEL"     , "narrator": "", "text": "後にしてもらえば？"},
        { "location": "338/SEL"     , "narrator": "", "text": "聞いといた方が良いんじゃない"},
        { "location": "339/SEL"     , "narrator": "", "text": "逃げ出せ！"},
        { "location": "341/TALK"    , "narrator": "つばめ", "text": "えっ…今ですか？"},
        { "location": "342/TALK"    , "narrator": "真幌", "text": "何だ、都合が悪いのか？"},
        { "location": "343/TALK"    , "narrator": "つばめ", "text": "えっと――"},
        { "location": "346/TALK"    , "narrator": "つばめ", "text": "…いえ、大丈夫です。\nお話って何ですか？"},
        { "location": "349/TALK"    , "narrator": "真幌", "text": "いや…余計なお世話かも\nしれんのだが――"},
        { "location": "351/TALK"    , "narrator": "真幌", "text": "逢瀬は、卯月に対して\n少し肩入れし過ぎだ。"},
        { "location": "353/TALK"    , "narrator": "つばめ", "text": "…えっ？"},
        { "location": "354/TALK"    , "narrator": "真幌", "text": "卯月が何を悩んでいる\nのかは、私にもわからん。"},
        { "location": "355/TALK"    , "narrator": "真幌", "text": "逢瀬は、そのことを\n心配し、力になろうと\n思っているのだろう？"},
        { "location": "357/TALK"    , "narrator": "つばめ", "text": "…はい。"},
        { "location": "358/TALK"    , "narrator": "真幌", "text": "…逢瀬は優しいな。"},
        { "location": "359/TALK"    , "narrator": "真幌", "text": "だがな、時には力に\nなろうとするより――"},
        { "location": "360/TALK"    , "narrator": "真幌", "text": "何もせず、そっとして\nおく優しさというのも\n必要だぞ。"},
        { "location": "362/TALK"    , "narrator": "つばめ", "text": "…それって、放っておけ\nってことですか？"},
        { "location": "363/TALK"    , "narrator": "真幌", "text": "放っておくのと、\nそっとしておくのは、\n似ているようで違う。"},
        { "location": "364/TALK"    , "narrator": "真幌", "text": "心配はしろ。\nだが、向こうが助けを\n求めてくるまでは――"},
        { "location": "365/TALK"    , "narrator": "真幌", "text": "そっとしておいた方が\nいいこともある。"},
        { "location": "366/TALK"    , "narrator": "真幌", "text": "…話は以上だ。\nじゃあな。"},
        { "location": "369/TALK"    , "narrator": "つばめ", "text": "…そっとしておくのも、\n優しさ…。"},
        { "location": "370/TALK"    , "narrator": "つばめ", "text": "でも、友達が悩んでるのを\n放っておくなんて、\nそんなの…！"},
        { "location": "372/TALK"    , "narrator": "つばめ", "text": "でも…肩入れし過ぎ\nなの、かな…？"},
        { "location": "373/TALK"    , "narrator": "つばめ", "text": "…わたしのしてること、\n間違いなのかな？"},
        { "location": "375/ACT"     , "narrator": "", "text": "後にしてもらえば？"},
        { "location": "392/TALK"    , "narrator": "つばめ", "text": "うん"},
        { "location": "393/TALK"    , "narrator": "つばめ", "text": "それが良いよね(´・ω・`) "},
        { "location": "405/TALK"    , "narrator": "つばめ", "text": "すみません。\n後にしてもらえますか？"},
        { "location": "407/TALK"    , "narrator": "真幌", "text": "…卯月を見つけるのが、\n何よりも優先か？"},
        { "location": "409/TALK"    , "narrator": "つばめ", "text": "す、すみません…。"},
        { "location": "411/TALK"    , "narrator": "つばめ", "text": "でも、見つかったら\nすぐに真幌さんのお話を\n聞きに戻りますから――"},
        { "location": "412/TALK"    , "narrator": "真幌", "text": "それが問題なんだ、\nという話をしようと\n思っていたんだ。"},
        { "location": "413/TALK"    , "narrator": "つばめ", "text": "…どういうことですか？"},
        { "location": "414/TALK"    , "narrator": "真幌", "text": "人には事情がある、\nということだ。"},
        { "location": "415/TALK"    , "narrator": "真幌", "text": "逢瀬が卯月のことを\n想うのは悪いことでは\nない。"},
        { "location": "416/TALK"    , "narrator": "真幌", "text": "だが、肩入れし過ぎて、\nその事情に踏み入るような\n事態になるのは――"},
        { "location": "417/TALK"    , "narrator": "真幌", "text": "あまり良いとは言えんぞ。"},
        { "location": "420/TALK"    , "narrator": "つばめ", "text": "で、でも…だからって、\n放っておけないです。"},
        { "location": "422/TALK"    , "narrator": "つばめ", "text": "悩んでいる卯月さんを、\n放っておくなんて…。"},
        { "location": "423/TALK"    , "narrator": "真幌", "text": "一人で悩む時間も、\n必要なんじゃないか？"},
        { "location": "424/TALK"    , "narrator": "真幌", "text": "逢瀬の優しさもわかる。"},
        { "location": "425/TALK"    , "narrator": "真幌", "text": "だが、そのせいで一人で\n悩むのを、邪魔することに\nなるかもしれないんだ。"},
        { "location": "427/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "428/TALK"    , "narrator": "真幌", "text": "…まあ、話は以上だ。"},
        { "location": "429/TALK"    , "narrator": "真幌", "text": "あとはどうするかは、\n逢瀬の判断に任せよう。"},
        { "location": "432/TALK"    , "narrator": "つばめ", "text": "…一人で悩む時間も、\n必要なのかな？"},
        { "location": "433/TALK"    , "narrator": "つばめ", "text": "わたしも、一人でじっくり\n考えたくなる時もあるし。"},
        { "location": "434/TALK"    , "narrator": "つばめ", "text": "でも、友達が悩んでるのを\n放っておくなんて、\nそんなの…！"},
        { "location": "435/TALK"    , "narrator": "つばめ", "text": "…真幌さんの言う通り、\n肩入れし過ぎなのかな？"},
        { "location": "436/TALK"    , "narrator": "つばめ", "text": "わたし、どうすれば\nいいんだろう…。"},
        { "location": "437/ACT"     , "narrator": "", "text": "聞いといた方が良いんじゃない"},
        { "location": "454/TALK"    , "narrator": "つばめ", "text": "そぅだね"},
        { "location": "455/TALK"    , "narrator": "つばめ", "text": "何か大切な話かもしれなぃし"},
        { "location": "467/TALK"    , "narrator": "つばめ", "text": "お話って、何ですか？"},
        { "location": "469/ACT"     , "narrator": "", "text": "逃げ出せ！"},
        { "location": "486/TALK"    , "narrator": "つばめ", "text": "無理だよΣ(･ω･;|||"},
        { "location": "487/TALK"    , "narrator": "つばめ", "text": "流石にそぅぃぅわけにはぃかなぃから"},
        { "location": "488/TALK"    , "narrator": "つばめ", "text": "とりあぇず聞ぃてみるよ(´・ω・`) "},
        { "location": "500/TALK"    , "narrator": "つばめ", "text": "お話って、何ですか？"}
    ]
}
