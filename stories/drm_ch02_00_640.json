        { "location": "121/SEL"   , "narrator": "", "text": "十分幸せ"},
        { "location": "122/SEL"   , "narrator": "", "text": "会いたくないわけない"},
        { "location": "123/ACT"   , "narrator": "", "text": "十分幸せ"},
