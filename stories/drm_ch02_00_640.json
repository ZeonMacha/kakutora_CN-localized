        { "location": "114/ACT"   , "narrator": "", "text": "たぶんね"},
        { "location": "115/TALK"  , "narrator": "アーヤ", "text": "$handle$さんには"},
        { "location": "116/TALK"  , "narrator": "アーヤ", "text": "そんなに重要なことじゃないのかしら"},
        { "location": "118/TALK"  , "narrator": "アーヤ", "text": "こうやって電話越しにチャットするだけでいいのね"},
