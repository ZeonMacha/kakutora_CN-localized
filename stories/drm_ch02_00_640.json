        { "location": "37/ACT"    , "narrator": "", "text": "$me$のことだよね！"},
        { "location": "38/TALK"   , "narrator": "アーヤ", "text": "その自信はどこからくるのかしら（￣ー￣？）"},
        { "location": "40/TALK"   , "narrator": "アーヤ", "text": "そうなんだけど(*^^*)"},
        { "location": "41/ACT"    , "narrator": "", "text": "よし、飲もう"},
