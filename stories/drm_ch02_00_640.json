        { "location": "7/SCENARIO", "narrator": "", "text": "570_嫌いなところも全部好き"},
        { "location": "32/TALK"   , "narrator": "アーヤ", "text": "考えちゃうことがあるのよ"},
        { "location": "34/SEL"    , "narrator": "", "text": "$me$のことだよね！"},
        { "location": "35/SEL"    , "narrator": "", "text": "よし、飲もう"},
