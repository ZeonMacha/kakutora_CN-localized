        { "location": "85/TALK"   , "narrator": "アーヤ", "text": "そうなの？"},
        { "location": "86/TALK"   , "narrator": "アーヤ", "text": "答えになってるような"},
        { "location": "87/TALK"   , "narrator": "アーヤ", "text": "なってないような"},
        { "location": "89/TALK"   , "narrator": "アーヤ", "text": "だってね"},
        { "location": "90/TALK"   , "narrator": "アーヤ", "text": "私たち"},
        { "location": "92/TALK"   , "narrator": "アーヤ", "text": "直接会ったことがないでしょ？"},
