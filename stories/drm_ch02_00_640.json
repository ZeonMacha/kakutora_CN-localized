        { "location": "45/ACT"    , "narrator": "", "text": "話せば楽になるかもよ"},
        { "location": "46/TALK"   , "narrator": "アーヤ", "text": "聞いてくれる？"},
        { "location": "47/TALK"   , "narrator": "アーヤ", "text": "$handle$さんは"},
        { "location": "48/TALK"   , "narrator": "アーヤ", "text": "優しいから好きよ"},
        { "location": "50/TALK"   , "narrator": "アーヤ", "text": "$handle$さんは"},
        { "location": "53/TALK"   , "narrator": "アーヤ", "text": "なんで"},
        { "location": "56/TALK"   , "narrator": "アーヤ", "text": "私のこと好きなの？"},
        { "location": "58/SEL"    , "narrator": "", "text": "アーヤが$me$を好きなのと同じ理由"},
        { "location": "59/SEL"    , "narrator": "", "text": "そんなこと言ったっけ"},
        { "location": "60/SEL"    , "narrator": "", "text": "アーヤだから"},
        { "location": "61/ACT"    , "narrator": "", "text": "アーヤが$me$を好きなのと同じ理由"},
        { "location": "71/TALK"   , "narrator": "アーヤ", "text": "そうなの？"},
        { "location": "72/TALK"   , "narrator": "アーヤ", "text": "適当なこと言ってない？"},
        { "location": "75/TALK"   , "narrator": "アーヤ", "text": "だって"},
        { "location": "76/TALK"   , "narrator": "アーヤ", "text": "それだと"},
        { "location": "77/TALK"   , "narrator": "アーヤ", "text": "嫌いなところなんてないくらい好きってことよ？"},
        { "location": "78/TALK"   , "narrator": "アーヤ", "text": "信じていいの？"},
        { "location": "79/TALK"   , "narrator": "アーヤ", "text": "私"},
        { "location": "80/TALK"   , "narrator": "アーヤ", "text": "本気にするからね"},
        { "location": "81/ACT"    , "narrator": "", "text": "そんなこと言ったっけ"},
        { "location": "82/TALK"   , "narrator": "アーヤ", "text": "言ったでしょ"},
        { "location": "83/TALK"   , "narrator": "アーヤ", "text": "意地悪ばっかりなんだから"},
