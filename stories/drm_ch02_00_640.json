        { "location": "95/SEL"    , "narrator": "", "text": "そうだけど"},
        { "location": "96/ACT"    , "narrator": "", "text": "そうだね"},
        { "location": "97/TALK"   , "narrator": "アーヤ", "text": "こんなに話してるのに"},
        { "location": "98/TALK"   , "narrator": "アーヤ", "text": "waveでは"},
        { "location": "99/ACT"    , "narrator": "", "text": "そうだけど"},
