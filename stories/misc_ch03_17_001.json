    [
        { "location": "7/SCENARIO", "narrator": "", "text": "025_キャンディを一粒"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "悲しい時には"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "甘いものが欲しくなるわね"},
        { "location": "35/SEL"    , "narrator": "", "text": "そう？"},
        { "location": "36/SEL"    , "narrator": "", "text": "わかる"},
        { "location": "37/SEL"    , "narrator": "", "text": "$me$がいるから元気出して"},
        { "location": "38/ACT"    , "narrator": "", "text": "そう？"},
        { "location": "39/TALK"   , "narrator": "ガブリエラ", "text": "あら"},
        { "location": "40/TALK"   , "narrator": "ガブリエラ", "text": "マルザンナはそうじゃないのね"},
        { "location": "41/ACT"    , "narrator": "", "text": "わかる"},
        { "location": "42/TALK"   , "narrator": "ガブリエラ", "text": "そうでしょう"},
        { "location": "44/TALK"   , "narrator": "ガブリエラ", "text": "やっぱりね"},
        { "location": "45/ACT"    , "narrator": "", "text": "$me$がいるから元気出して"},
        { "location": "47/TALK"   , "narrator": "ガブリエラ", "text": "あら"},
        { "location": "48/TALK"   , "narrator": "ガブリエラ", "text": "心配をかけてしまったみたいね"},
        { "location": "49/TALK"   , "narrator": "ガブリエラ", "text": "大丈夫よ"},
        { "location": "51/TALK"   , "narrator": "ガブリエラ", "text": "今日のはね"},
        { "location": "52/TALK"   , "narrator": "ガブリエラ", "text": "そういうものよねって"},
        { "location": "53/TALK"   , "narrator": "ガブリエラ", "text": "話なだけなの"},
        { "location": "54/TALK"   , "narrator": "ガブリエラ", "text": "空想上の悲しい気持ちって"},
        { "location": "55/TALK"   , "narrator": "ガブリエラ", "text": "センチメンタルでロマンチックだわ"}
    ]
}
