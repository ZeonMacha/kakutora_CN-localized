    "entry":
    [
        { "location": "7805/SCENARIO", "narrator": "", "text": "魔法少女だけどストライキしても許されるよねっ！？"},
        { "location": "7832/TALK"    , "narrator": "神楽", "text": "これよりぴょんこは無期限ストライキに突入する！"},
        { "location": "7834/SEL"     , "narrator": "", "text": "話せばわかる"},
        { "location": "7835/SEL"     , "narrator": "", "text": "何があったの"},
        { "location": "7836/SEL"     , "narrator": "", "text": "とことん付き合うよ"},
        { "location": "7837/ACT"     , "narrator": "", "text": "話せばわかる"},
        { "location": "7838/TALK"    , "narrator": "神楽", "text": "本当かな？"},
        { "location": "7839/ACT"     , "narrator": "", "text": "何があったの"},
        { "location": "7840/TALK"    , "narrator": "神楽", "text": "何かっていうか"},
        { "location": "7841/ACT"     , "narrator": "", "text": "とことん付き合うよ"},
        { "location": "7843/TALK"    , "narrator": "神楽", "text": "やーん$handlek$やさしー"},
        { "location": "7844/TALK"    , "narrator": "神楽", "text": "そんなこと言ってくれるの$handlek$だけぴょん♪"},
        { "location": "7845/TALK"    , "narrator": "神楽", "text": "キュンってなっちゃうー"},
        { "location": "7847/TALK"    , "narrator": "神楽", "text": "なーんかさー"},
        { "location": "7848/TALK"    , "narrator": "神楽", "text": "トライナリーって秘密の組織じゃないですかー"},
        { "location": "7849/TALK"    , "narrator": "神楽", "text": "いっくらぴょんこががんばっても報われないっていうかー"},
        { "location": "7850/TALK"    , "narrator": "神楽", "text": "だから疲れちゃったぴょん、、、"},
        { "location": "7853/SEL"     , "narrator": "", "text": "いつもお疲れさま"},
        { "location": "7854/SEL"     , "narrator": "", "text": "でもストはよくないよ"},
        { "location": "7855/SEL"     , "narrator": "", "text": "$me$はいつも見てるよ…？"},
        { "location": "7856/ACT"     , "narrator": "", "text": "いつもお疲れさま"},
        { "location": "7857/TALK"    , "narrator": "神楽", "text": "ほんとぴょん！！！"},
        { "location": "7858/TALK"    , "narrator": "神楽", "text": "でもそう言ってもらえてちょっと元気出たぴょん"},
        { "location": "7859/TALK"    , "narrator": "神楽", "text": "がんばるー"},
        { "location": "7860/ACT"     , "narrator": "", "text": "でもストはよくないよ"},
        { "location": "7861/TALK"    , "narrator": "神楽", "text": "うっせー"},
        { "location": "7862/TALK"    , "narrator": "神楽", "text": "ばーかばーかばーか"},
        { "location": "7863/ACT"     , "narrator": "", "text": "$me$はいつも見てるよ…？"},
        { "location": "7865/TALK"    , "narrator": "神楽", "text": "そんなの知ってるぴょん"},
        { "location": "7866/TALK"    , "narrator": "神楽", "text": "そうじゃなきゃこんなこと言わないぴょん"},
        { "location": "7867/TALK"    , "narrator": "神楽", "text": "うううううう"},
        { "location": "7869/SEL"     , "narrator": "", "text": "よしよし"},
        { "location": "7870/SEL"     , "narrator": "", "text": "$me$の胸で泣けばいいよ"},
        { "location": "7871/SEL"     , "narrator": "", "text": "神楽は十分頑張ってる"},
        { "location": "7872/ACT"     , "narrator": "", "text": "よしよし"},
        { "location": "7873/TALK"    , "narrator": "神楽", "text": "ふにゅ～"},
        { "location": "7875/TALK"    , "narrator": "神楽", "text": "今日はもう寝るぴょん、、、"},
        { "location": "7876/TALK"    , "narrator": "神楽", "text": "おやすみ"},
        { "location": "7877/ACT"     , "narrator": "", "text": "$me$の胸で泣けばいいよ"},
        { "location": "7878/TALK"    , "narrator": "神楽", "text": "じゅる、、、"},
        { "location": "7879/TALK"    , "narrator": "神楽", "text": "ううんなんでもないぴょん！"},
        { "location": "7880/TALK"    , "narrator": "神楽", "text": "じゃあね！"},
        { "location": "7881/ACT"     , "narrator": "", "text": "神楽は十分頑張ってる"},
        { "location": "7882/TALK"    , "narrator": "神楽", "text": "だよねー"},
        { "location": "7883/TALK"    , "narrator": "神楽", "text": "だからちょっとサボるぴょん、、、"},
