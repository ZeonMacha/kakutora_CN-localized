        { "location": "1172/TALK"  , "narrator": "神楽", "text": "もーっ！　\nどうせ全然柔らかく\nありませんよ。"},
        { "location": "1174/TALK"  , "narrator": "神楽", "text": "それは私に対する\n冒涜ですか？"},
        { "location": "1180/TALK"  , "narrator": "神楽", "text": "はあっ！\nなんだか不思議な\n感じがします！"},
        { "location": "1182/TALK"  , "narrator": "神楽", "text": "ううっ！\nあまりお腹叩くと\n気持ち悪いですよ？"},
        { "location": "1188/TALK"  , "narrator": "神楽", "text": "ふわあっ！\nくすぐったいです！！"},
        { "location": "1190/TALK"  , "narrator": "神楽", "text": "ふふ♪\n私との子供を\n想像してますか？"},
        { "location": "1196/DIALOG", "narrator": "", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"},
        { "location": "1199/TALK"  , "narrator": "千羽鶴", "text": "はい、お終い。"},
        { "location": "1202/ACT"   , "narrator": "", "text": "戻る"},
        { "location": "1216/ACT"   , "narrator": "", "text": "やめておきます…"},
        { "location": "1217/TALK"  , "narrator": "千羽鶴", "text": "いい判断だと思う。"},
        { "location": "1219/ACT"   , "narrator": "", "text": "早く会いたい"},
        { "location": "1220/TALK"  , "narrator": "千羽鶴", "text": "ならば今すぐ、自分の\nスマホへのインストールを\nお薦めする。"},
        { "location": "1223/TALK"  , "narrator": "千羽鶴", "text": "念のため\nもう一度\n出してみる。"},
        { "location": "1229/TALK"  , "narrator": "千羽鶴", "text": "というわけで、\n彼女たちとのコミュニ\nケーションはどうだった？"},
        { "location": "1230/SEL"   , "narrator": "（選択肢）", "text": "よかった！"},
        { "location": "1231/SEL"   , "narrator": "（選択肢）", "text": "まあ、普通？"},
        { "location": "1232/ACT"   , "narrator": "", "text": "よかった！"},
        { "location": "1237/TALK"  , "narrator": "千羽鶴", "text": "それは何より。"},
        { "location": "1238/ACT"   , "narrator": "", "text": "まあ、普通？"},
        { "location": "1241/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "1245/ACT"   , "narrator": "", "text": "その壮大なるストーリーとやらを垣間見たい"},
        { "location": "1246/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "1247/TALK"  , "narrator": "千羽鶴", "text": "ところで貴方は、\n既にアプリをDLして\nプレイしてる人？"},
        { "location": "1248/SEL"   , "narrator": "（選択肢）", "text": "いえ、してません。"},
        { "location": "1249/SEL"   , "narrator": "（選択肢）", "text": "プレイしてる人です"},
        { "location": "1250/ACT"   , "narrator": "", "text": "いえ、してません。"},
        { "location": "1251/TALK"  , "narrator": "千羽鶴", "text": "興味持ってくれて\nありがと。"},
        { "location": "1252/TALK"  , "narrator": "千羽鶴", "text": "今日はこのアプリの\n奥深い物語を少しでも\n感じていって欲しい。"},
        { "location": "1253/TALK"  , "narrator": "千羽鶴", "text": "ちなみに、今実際に\nプレイしている人に\n聞いてみたところ――"},
        { "location": "1254/TALK"  , "narrator": "千羽鶴", "text": "$tgs_q2_all$人中$tgs_q2_yes$人が\nこのアプリの物語に\n夢中だと答えてる。"},
        { "location": "1255/TALK"  , "narrator": "千羽鶴", "text": "あなたにとっても\n興味を持てる物語だと\nいいけど。"},
        { "location": "1256/ACT"   , "narrator": "", "text": "プレイしてる人です"},
        { "location": "1257/TALK"  , "narrator": "千羽鶴", "text": "いつも彼女たちを\n支えてくれてありがと。"},
        { "location": "1258/TALK"  , "narrator": "千羽鶴", "text": "ところで、\nトライナリーの物語は\n楽しい？"},
        { "location": "1259/SEL"   , "narrator": "（選択肢）", "text": "もちろん！！"},
        { "location": "1260/SEL"   , "narrator": "（選択肢）", "text": "実はそんなには…"},
        { "location": "1261/ACT"   , "narrator": "", "text": "もちろん！！"},
        { "location": "1266/TALK"  , "narrator": "千羽鶴", "text": "良かった。\nこれからも存分に\n楽しんで。"},
        { "location": "1267/ACT"   , "narrator": "", "text": "実はそんなには…"},
        { "location": "1270/TALK"  , "narrator": "千羽鶴", "text": "そう。\nそれは残念。"},
        { "location": "1273/TALK"  , "narrator": "千羽鶴", "text": "それじゃ早速\nこれから物語について\n紹介していこうと思う。"},
        { "location": "1277/SEL"   , "narrator": "（選択肢）", "text": "１．どんな感じ？"},
        { "location": "1278/SEL"   , "narrator": "（選択肢）", "text": "２．どんなあらすじ？"},
        { "location": "1279/SEL"   , "narrator": "（選択肢）", "text": "３．みんなの反応は？"},
        { "location": "1280/SEL"   , "narrator": "（選択肢）", "text": "１～３を通して見る"},
        { "location": "1281/SEL"   , "narrator": "（選択肢）", "text": "終わりにする"},
        { "location": "1282/ACT"   , "narrator": "", "text": "１．どんな感じ？"},
        { "location": "1286/ACT"   , "narrator": "", "text": "２．どんなあらすじ？"},
        { "location": "1290/ACT"   , "narrator": "", "text": "３．みんなの反応は？"},
        { "location": "1294/ACT"   , "narrator": "", "text": "１～３を通して見る"},
        { "location": "1299/ACT"   , "narrator": "", "text": "終わりにする"},
        { "location": "1300/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "1324/DIALOG", "narrator": "", "text": "- その１ -\n\n<size=60>恋愛ゲーム</size>\n×\n<size=60>社会派アニメーション</size>\n"},
        { "location": "1330/TALK"  , "narrator": "アーヤ", "text": "こんにちは、\n國政綾水です。\nアーヤって呼んでね？"},
        { "location": "1331/TALK"  , "narrator": "ガブリエラ", "text": "あたしは\nガブリエラよ。\nギャヴィって呼ばれてる。"},
        { "location": "1332/SEL"   , "narrator": "（選択肢）", "text": "よろしくね"},
        { "location": "1333/SEL"   , "narrator": "（選択肢）", "text": "その格好は！？"},
        { "location": "1334/ACT"   , "narrator": "", "text": "よろしくね"},
        { "location": "1335/ACT"   , "narrator": "", "text": "その格好は！？"},
        { "location": "1336/TALK"  , "narrator": "ガブリエラ", "text": "ああ、これ？\nポーランドの\n民族衣装よ？"},
        { "location": "1337/TALK"  , "narrator": "ガブリエラ", "text": "あたし、\nポーランド生まれだから。"},
        { "location": "1338/TALK"  , "narrator": "アーヤ", "text": "私は日本人だから浴衣。"},
        { "location": "1340/TALK"  , "narrator": "ガブリエラ", "text": "アーヤの場合、わざわざ\n日本人だって主張する\n必要無いと思うんだけど。"},
        { "location": "1343/TALK"  , "narrator": "アーヤ", "text": "というわけで、\nトライナリーとは\nどんなお話なのか？"},
        { "location": "1344/TALK"  , "narrator": "ガブリエラ", "text": "それを今から、\nあたしとアーヤで\n説明していくわよ。"},
        { "location": "1346/TALK"  , "narrator": "ガブリエラ", "text": "早速で悪いんだけど、\nタイトルテロップに\n突っ込み入れていい？"},
        { "location": "1348/TALK"  , "narrator": "アーヤ", "text": "どうしたの？"},
        { "location": "1349/TALK"  , "narrator": "ガブリエラ", "text": "恋愛はいいわ、恋愛は。\nそこはいいとして。"},
        { "location": "1350/TALK"  , "narrator": "ガブリエラ", "text": "社会派アニメってなに！？"},
        { "location": "1351/TALK"  , "narrator": "アーヤ", "text": "あー、そこね。\nほら、あれよ。"},
        { "location": "1353/DIALOG", "narrator": "", "text": "愛と勇気の宇宙戦争！\n…というよりは――"},
        { "location": "1355/TALK"  , "narrator": "アーヤ", "text": "同じロボットが出てくる\nにしても、宇宙でドンパチ\nやるタイプじゃなくて――"},
        { "location": "1358/DIALOG", "narrator": "", "text": "これからの社会を\nズバッと斬る！！"},
        { "location": "1360/TALK"  , "narrator": "アーヤ", "text": "一家に一台ロボットが\n普及したらどんな問題が\n出てくるか、みたいな。"},
        { "location": "1363/TALK"  , "narrator": "アーヤ", "text": "そういうアニメって\nことなんじゃないかしら？"},
        { "location": "1364/TALK"  , "narrator": "ガブリエラ", "text": "え！？\nそんなお話だっけ？"},
        { "location": "1367/DIALOG", "narrator": "", "text": "- POINT① -\n\n昨今の世界情勢などを\nテーマのベースに盛り込んだ\n骨太なストーリーです。\n"},
        { "location": "1369/TALK"  , "narrator": "アーヤ", "text": "まあ、最初のうちは\n単なるイチャイチャ\nマッタリ日常劇だけど。"},
        { "location": "1370/TALK"  , "narrator": "ガブリエラ", "text": "そうよね。\nあたしもイチャイチャした\n記憶しかな――"},
        { "location": "1373/DIALOG", "narrator": "", "text": "- POINT② -\n\n最初はマッタリ日常ドラマ。\n彼女たちとの平穏な日常を\nお楽しみいただけます。\n"},
        { "location": "1376/TALK"  , "narrator": "ガブリエラ", "text": "……いや、別に\n毎日恋愛ボケしてるって\nワケじゃないのよ？"},
        { "location": "1377/TALK"  , "narrator": "アーヤ", "text": "たまになら\n恋愛ボケしてるって\nことかしら。"},
        { "location": "1378/TALK"  , "narrator": "アーヤ", "text": "まあでも、確かに\nかなり濃厚な恋愛を\nしてるわよね、私たち。"},
        { "location": "1379/TALK"  , "narrator": "アーヤ", "text": "ホントにいっぱい、\n泣いたり笑ったり……。\n色んな経験をしてる。"},
        { "location": "1382/DIALOG", "narrator": "", "text": "- POINT③ -\n\n彼女たちとの恋愛は\nその過程を楽しむものに\nなっています。\n\n一緒に泣いて笑って、\nそれは最高の思い出になります。"},
        { "location": "1385/TALK"  , "narrator": "ガブリエラ", "text": "まあ、そこは\n否定しないわね。"},
        { "location": "1386/TALK"  , "narrator": "ガブリエラ", "text": "それはそうと、\nどんなストーリーなのかの\n説明はしなくていいの？"},
        { "location": "1387/TALK"  , "narrator": "アーヤ", "text": "ああ…そうね。"},
        { "location": "1388/TALK"  , "narrator": "アーヤ", "text": "その辺りは、\n次の二人に\nお任せしましょ。"},
        { "location": "1389/TALK"  , "narrator": "ガブリエラ", "text": "あらら……。"},
        { "location": "1420/DIALOG", "narrator": "", "text": "- その２ -\n\n<size=60>ジェットコースター</size>\n＆\n<size=60>エクストリーム</size>\n"},
        { "location": "1425/TALK"  , "narrator": "つばめ", "text": "皆さんこんにちは、\n逢瀬つばめです！"},
        { "location": "1426/TALK"  , "narrator": "神楽", "text": "卯月神楽です♪"},
        { "location": "1430/TALK"  , "narrator": "神楽", "text": "つばめさんっ！\n私たち、ストーリーの\n解説を任されました！"},
        { "location": "1431/TALK"  , "narrator": "つばめ", "text": "責任重大だね！\nちゃんと出来るかな。"},
        { "location": "1432/TALK"  , "narrator": "神楽", "text": "大丈夫です！\n失敗しても、つばめさんが\n脱げば丸く収まります♪"},
        { "location": "1433/TALK"  , "narrator": "つばめ", "text": "ええっ！！"},
        { "location": "1436/DIALOG", "narrator": "", "text": "- POINT④ -\n\n確かにそんな展開も、\n無いとは言い切れない…。"},
        { "location": "1438/TALK"  , "narrator": "神楽", "text": "では早速、\n世界観を説明して\nいきましょう。"},
        { "location": "1444/TALK"  , "narrator": "つばめ", "text": "拡張少女系トライナリーは\nとある災厄と闘う\n少女たちの物語です。"},
        { "location": "1445/TALK"  , "narrator": "神楽", "text": "簡単に言えば、\n魔法少女モノだけど、\nストーリーは骨太。"},
        { "location": "1449/TALK"  , "narrator": "つばめ", "text": "時は２０１６年。\n東京ではフェノメノンと\n呼ばれる災厄が勃発。"},
        { "location": "1450/TALK"  , "narrator": "神楽", "text": "突如都内に繭のような\nものが発生し、街の一部を\n覆ってしまいますっ！"},
        { "location": "1454/TALK"  , "narrator": "つばめ", "text": "中に巻き込まれちゃった\n人たちは、そこで殺し合い\nしちゃったりするんだよ。"},
        { "location": "1458/TALK"  , "narrator": "神楽", "text": "事態を重く見た政府は、\n総務省情報管理庁に対し、\n災厄に対処するよう指示。"},
        { "location": "1459/TALK"  , "narrator": "つばめ", "text": "そして生まれたのが\nトライナリーと呼ばれる、\nわたしたち特殊部隊！"},
        { "location": "1460/TALK"  , "narrator": "神楽", "text": "5人の女の子によって\n構成された、フェノメノン\n対処専門部隊なんです♪"},
        { "location": "1461/TALK"  , "narrator": "つばめ", "text": "フェノメノンの中に\n潜入して、元を断って\n収束させるよ！"},
        { "location": "1464/TALK"  , "narrator": "神楽", "text": "大雑把に言えば\nそんなお話ですよね。"},
        { "location": "1466/TALK"  , "narrator": "つばめ", "text": "そうだね。\nでも……"},
        { "location": "1467/TALK"  , "narrator": "つばめ", "text": "ジェットコースター＆\nエクストリームって\nどういう意味なんだろう？"},
        { "location": "1468/TALK"  , "narrator": "神楽", "text": "それは多分、\nアレですよ。\nほら――"},
        { "location": "1474/TALK"  , "narrator": "神楽", "text": "きっと\nこのシーンのことです♪"},
        { "location": "1476/TALK"  , "narrator": "つばめ", "text": "わあああっ！\nまたこういう恥ずかしいの\n出してきてー！"},
        { "location": "1481/TALK"  , "narrator": "つばめ", "text": "そうじゃなくて！\n神楽ちゃんの、こういう\nところの事だよ！"},
        { "location": "1482/TALK"  , "narrator": "神楽", "text": "シレッと私の\n恥ずかしいシーンを\n出してきましたね。"},
        { "location": "1486/TALK"  , "narrator": "神楽", "text": "それでは、\nこれなんかどうですか？\nエクストリームですよね！"},
        { "location": "1487/TALK"  , "narrator": "つばめ", "text": "神楽ちゃん、\nわたしにセクハラしか\nしてないような気が…。"},
        { "location": "1490/DIALOG", "narrator": "", "text": "- POINT⑤ -\n\nそれは伏線です。\n"},
        { "location": "1495/TALK"  , "narrator": "つばめ", "text": "いや、エクストリームって\n言ったら、こういう\nシーンのことじゃ…！"},
        { "location": "1496/TALK"  , "narrator": "神楽", "text": "つばめさん、\nナチュラルに私の心の傷を\n抉ってきますね。"},
        { "location": "1501/TALK"  , "narrator": "神楽", "text": "私はこの赤い水着を着た\nつばめさんこそ、エクス\nトリームだと思います♪"},
        { "location": "1505/TALK"  , "narrator": "つばめ", "text": "そんなのより！\n神楽ちゃんの顔が\n変わっちゃうシーンのが！"},
        { "location": "1510/TALK"  , "narrator": "神楽", "text": "今時そんなの古いですっ！\n今はパンツだって、宙を\n舞う時代なんですから！"},
        { "location": "1513/DIALOG", "narrator": "", "text": "- POINT⑥ -\n\nそれは恋ヶ崎みやびのです。\n"},
        { "location": "1518/TALK"  , "narrator": "つばめ", "text": "神楽ちゃん\nごまかしすぎー！！"},
        { "location": "1521/SEL"   , "narrator": "（選択肢）", "text": "待って待って、落ち着いて！"},
        { "location": "1522/ACT"   , "narrator": "", "text": "待って待って、落ち着いて！"},
        { "location": "1526/DIALOG", "narrator": "", "text": "- POINT⑦ -\n\n今登場したスナップは\n全て\n拡張少女系トライナリーのシーンです。\n"},
        { "location": "1532/TALK"  , "narrator": "神楽", "text": "ああっ、すみません。\n私としたことが。"},
        { "location": "1533/TALK"  , "narrator": "つばめ", "text": "つい熱くなっちゃったよ。"},
        { "location": "1534/TALK"  , "narrator": "神楽", "text": "やっぱりストーリーの\n説明って難しいですよね。"},
        { "location": "1536/TALK"  , "narrator": "つばめ", "text": "見る人によって\n面白いって思う部分が\n違うもんねぇ。"},
        { "location": "1538/TALK"  , "narrator": "神楽", "text": "そうですね～。"},
        { "location": "1539/TALK"  , "narrator": "神楽", "text": "さて、それはそうと、\n大変なことが！"},
        { "location": "1540/TALK"  , "narrator": "つばめ", "text": "どうしたの！？"},
        { "location": "1541/TALK"  , "narrator": "神楽", "text": "解説に失敗したので、\n約束通りつばめさんが\n脱ぐ羽目になりました♪"},
        { "location": "1542/TALK"  , "narrator": "つばめ", "text": "ええええっ！！"},
        { "location": "1562/TALK"  , "narrator": "つばめ", "text": "ああっ！！"},
        { "location": "1563/TALK"  , "narrator": "つばめ", "text": "人前でこんな格好に…。\n恥ずかしいよぅ……。"},
        { "location": "1564/TALK"  , "narrator": "神楽", "text": "何故か私まで\nこんな格好に\nなっちゃいましたね。"},
        { "location": "1565/TALK"  , "narrator": "つばめ", "text": "そもそも誰が\nわたしたちを\n着替えさせてるの？？"},
        { "location": "1566/TALK"  , "narrator": "神楽", "text": "そこにツッコミを入れると\n消されますよ？"},
        { "location": "1567/TALK"  , "narrator": "つばめ", "text": "ええっ！！"},
        { "location": "1569/TALK"  , "narrator": "神楽", "text": "というわけで、\n最後は無理矢理\n色気オチになりましたが！"},
        { "location": "1570/TALK"  , "narrator": "神楽", "text": "想像の斜め上に突き進み\n続ける本作を、どうぞ\n宜しくお願いしますね♪"},
        { "location": "1571/TALK"  , "narrator": "つばめ", "text": "なんか、無理矢理に\n無理矢理を上塗りした\nだけのような気が……。"},
        { "location": "1596/DIALOG", "narrator": "", "text": "- その３ -\n\n<size=60>リアルタイム生の声</size>\n"},
        { "location": "1601/TALK"  , "narrator": "みやび", "text": "ちわ。\n恋ヶ崎みやびやよ。"},
        { "location": "1602/SEL"   , "narrator": "（選択肢）", "text": "よろしく！"},
        { "location": "1603/SEL"   , "narrator": "（選択肢）", "text": "その格好は！？"},
        { "location": "1604/ACT"   , "narrator": "", "text": "よろしく！"},
        { "location": "1605/TALK"  , "narrator": "みやび", "text": "うむ。\nよろしゅうな。"},
        { "location": "1606/ACT"   , "narrator": "", "text": "その格好は！？"},
        { "location": "1607/TALK"  , "narrator": "みやび", "text": "うちの想いを\n代弁してくれる\n素敵なTシャツや。"},
        { "location": "1608/TALK"  , "narrator": "みやび", "text": "本当は寝間着やけんどな、\nせっかくやし、しっかり\n意思表示をしとこうかと。"},
        { "location": "1609/SEL"   , "narrator": "（選択肢）", "text": "胸なんぞ単なる脂肪の塊ぞね？？"},
        { "location": "1610/ACT"   , "narrator": "", "text": "胸なんぞ単なる脂肪の塊ぞね？？"},
        { "location": "1612/TALK"  , "narrator": "みやび", "text": "言葉の通りやよ。\n重いだけで、まっこと\n何の役にも立たん。"},
        { "location": "1613/SEL"   , "narrator": "（選択肢）", "text": "いえ、それは大変素晴らしいものです"},
        { "location": "1614/SEL"   , "narrator": "（選択肢）", "text": "全くその通り！"},
        { "location": "1615/ACT"   , "narrator": "", "text": "いえ、それは大変素晴らしいものです"},
        { "location": "1616/TALK"  , "narrator": "みやび", "text": "そうかね？"},
        { "location": "1617/TALK"  , "narrator": "みやび", "text": "まあ、お前さんが\nそう言うてくれるなら、\n少しは報われるぞね。"},
        { "location": "1618/ACT"   , "narrator": "", "text": "全くその通り！"},
        { "location": "1619/TALK"  , "narrator": "みやび", "text": "うむ！\nうちと気が合うね！"},
        { "location": "1621/TALK"  , "narrator": "みやび", "text": "とまあ、\nそんなことは\nどうでもえいちや。"},
        { "location": "1623/TALK"  , "narrator": "みやび", "text": "なんぞ、他の子らが\n一生懸命ストーリーの\n説明をしちょったけんど。"},
        { "location": "1624/TALK"  , "narrator": "みやび", "text": "少しは興味\n持てたかね？"},
        { "location": "1625/SEL"   , "narrator": "（選択肢）", "text": "持てた"},
        { "location": "1626/SEL"   , "narrator": "（選択肢）", "text": "意味が分からなかった"},
        { "location": "1627/ACT"   , "narrator": "", "text": "持てた"},
        { "location": "1628/TALK"  , "narrator": "みやび", "text": "それは良かった。"},
        { "location": "1629/TALK"  , "narrator": "みやび", "text": "ちゅうか、\nあんた優しいね。"},
        { "location": "1630/TALK"  , "narrator": "みやび", "text": "うちやったら\nまあ、無理やね。"},
        { "location": "1631/ACT"   , "narrator": "", "text": "意味が分からなかった"},
        { "location": "1632/TALK"  , "narrator": "みやび", "text": "うむ。\n正直でえいね。"},
        { "location": "1634/TALK"  , "narrator": "みやび", "text": "うち、思うんよ。"},
        { "location": "1635/TALK"  , "narrator": "みやび", "text": "ストーリーなんてものは、\n当事者が面白い面白い\n言うて解説しても――"},
        { "location": "1636/TALK"  , "narrator": "みやび", "text": "全部嘘臭く\n聞こえるもんやき。"},
        { "location": "1637/TALK"  , "narrator": "みやび", "text": "で、うちは考えて、\n１つの結論に達した。"},
        { "location": "1638/TALK"  , "narrator": "みやび", "text": "今ストーリーを楽しんでる\nみんなに、率直な感想を\nもらった方がえいかなと。"},
        { "location": "1639/TALK"  , "narrator": "みやび", "text": "そんなわけで、ここでは\n現在プレイ中の皆からの\n感想をまとめちゅう。"},
        { "location": "1640/TALK"  , "narrator": "みやび", "text": "エネルギッシュな感想の\n数々を、是非見たってや。"},
        { "location": "1645/DIALOG", "narrator": "", "text": "既にプレイされている\n皆さんからのメッセージを\nご紹介します"},
        { "location": "1649/TALK"  , "narrator": "みやび", "text": "とまあ、\nこんな感じやね。"},
        { "location": "1650/TALK"  , "narrator": "みやび", "text": "何か琴線に触れるものが\nあったら、是非うちらに\n逢いに来てや。"},
        { "location": "1651/TALK"  , "narrator": "みやび", "text": "あと、Twitterで、\n感想書いて協力してくれた\nうちの相棒もありがとね。"},
        { "location": "1654/DIALOG", "narrator": "", "text": "- POINT⑧ -\n\n掲載させていただいたコメントは、\n2017/9/15～16に\nTwitterにて募集したものです。\n\nご協力いただきました皆様、\nありがとうございました！\n"},
        { "location": "1656/TALK"  , "narrator": "みやび", "text": "ほな、またなー。"},
        { "location": "1672/TALK"  , "narrator": "千羽鶴", "text": "――というわけで、\nこれでストーリー紹介は\n全て終了した。"},
        { "location": "1680/TALK"  , "narrator": "千羽鶴", "text": "もし彼女たちを\nもっと知りたいと\n思ったなら――"},
        { "location": "1681/TALK"  , "narrator": "千羽鶴", "text": "是非アプリを\n入れてみて。"},
        { "location": "1686/DIALOG", "narrator": "", "text": "SSR倍増ガチャ開催中！"},
        { "location": "1688/TALK"  , "narrator": "千羽鶴", "text": "今日アプリを入れると、\n今丁度やってる<color=red>SSR倍増\nガチャ</color>が回せる。"},
        { "location": "1691/DIALOG", "narrator": "", "text": "ご新規さん強力バックアップ\nキャンペーン中！"},
        { "location": "1693/TALK"  , "narrator": "千羽鶴", "text": "他にも、今から始める\nことで有利に進められる\nイベントが満載。"},
        { "location": "1694/TALK"  , "narrator": "千羽鶴", "text": "例えば今なら、\nリリース当時やっていた\n大サービスバトル――"},
        { "location": "1695/TALK"  , "narrator": "千羽鶴", "text": "<color=red>スタートダッシュバトル</color>を\n復刻している。"},
        { "location": "1696/TALK"  , "narrator": "千羽鶴", "text": "また、<color=red>期間限定の\n太っ腹ログインボーナス</color>も\n追加配信中。"},
        { "location": "1697/TALK"  , "narrator": "千羽鶴", "text": "その中には<color=red>SR以上確定\nガチャチケット</color>なども\n入ってる。"},
        { "location": "1698/TALK"  , "narrator": "千羽鶴", "text": "今始めないと、\n損するレベルの\n大盤振る舞いね。"},
        { "location": "1701/DIALOG", "narrator": "", "text": "ARGUMENTED REALITY GIRL'S TRINARY."},
        { "location": "1703/TALK"  , "narrator": "千羽鶴", "text": "<color=green>無料でノベル6冊分はある\n物語を楽しめる。</color>それが\n拡張少女系トライナリー。"},
        { "location": "1704/TALK"  , "narrator": "千羽鶴", "text": "貴方も是非、\nこの機会に\n始めてみて欲しい。"},
        { "location": "1709/TALK"  , "narrator": "千羽鶴", "text": "――というわけで、\n体験プレイは\nこれでおしまい。"},
        { "location": "1711/TALK"  , "narrator": "千羽鶴", "text": "それじゃ――"},
        { "location": "1712/SEL"   , "narrator": "（選択肢）", "text": "ちょっとまった！"},
        { "location": "1713/ACT"   , "narrator": "", "text": "ちょっとまった！"},
        { "location": "1715/TALK"  , "narrator": "千羽鶴", "text": "……なに？"},
        { "location": "1716/SEL"   , "narrator": "（選択肢）", "text": "ハネムーンの約束は！？"},
        { "location": "1717/ACT"   , "narrator": "", "text": "ハネムーンの約束は！？"},
        { "location": "1719/TALK"  , "narrator": "千羽鶴", "text": "……。\nよく覚えてた。"},
        { "location": "1720/SEL"   , "narrator": "（選択肢）", "text": "まさか忘れてた！？"},
        { "location": "1721/ACT"   , "narrator": "", "text": "まさか忘れてた！？"},
        { "location": "1724/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "1725/TALK"  , "narrator": "千羽鶴", "text": "まさか。"},
        { "location": "1726/TALK"  , "narrator": "千羽鶴", "text": "貴方の記憶力を\n試していただけ。"},
        { "location": "1728/TALK"  , "narrator": "千羽鶴", "text": "それじゃ早速\n行きましょ。"},
        { "location": "1729/TALK"  , "narrator": "千羽鶴", "text": "私と貴方、二人きりの\nハネムーン（お試し）へ。\n<color=red>（重要：お試し）</color>"},
        { "location": "1733/TALK"  , "narrator": "千羽鶴", "text": "はい、おしまい。"},
        { "location": "1734/SEL"   , "narrator": "（選択肢）", "text": "とても良かったよ"},
        { "location": "1735/SEL"   , "narrator": "（選択肢）", "text": "もう一回！"},
        { "location": "1736/ACT"   , "narrator": "", "text": "とても良かったよ"},
        { "location": "1738/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "1739/ACT"   , "narrator": "", "text": "もう一回！"},
        { "location": "1741/TALK"  , "narrator": "千羽鶴", "text": "周りの人への\n配慮も考えて生きて。"},
        { "location": "1744/TALK"  , "narrator": "千羽鶴", "text": "これで私の負っていた\n責任は全て果たしたはず。"},
        { "location": "1745/TALK"  , "narrator": "千羽鶴", "text": "また遊びに\n来てくれると嬉しい。"},
        { "location": "1747/TALK"  , "narrator": "千羽鶴", "text": "あと、今回貴方はフラグを\n立てられなかったけど――"},
        { "location": "1748/TALK"  , "narrator": "千羽鶴", "text": "実はこの体験版には、\n私と少しだけイチャイチャ\nできる分岐もある。"},
        { "location": "1749/TALK"  , "narrator": "千羽鶴", "text": "何度もプレイできそうなら\n是非チャレンジしてみて。\n待ってるから。"},
        { "location": "1753/TALK"  , "narrator": "千羽鶴", "text": "それじゃ\n今回はこの辺で。"},
        { "location": "1754/TALK"  , "narrator": "千羽鶴", "text": "この短時間じゃ彼女たちの\n可愛さしか伝わらなかった\nと思うけど――"},
        { "location": "1755/TALK"  , "narrator": "千羽鶴", "text": "もしこのノリが\nツボに入るようなら\n是非プレイしてみて。"},
        { "location": "1756/TALK"  , "narrator": "千羽鶴", "text": "それと、シナリオ編も\n試してみてもらえると\n嬉しいかも。"},
        { "location": "1757/TALK"  , "narrator": "千羽鶴", "text": "貴方とあなたの世界に、\n素敵なココロの旅を。"},
        { "location": "1759/TALK"  , "narrator": "千羽鶴", "text": "この短時間で、どれ程\nストーリーの魅力が\n伝わったか疑問だけど――"},
        { "location": "1760/TALK"  , "narrator": "千羽鶴", "text": "もし少しでも興味が\n出たなら、是非プレイ\nしてみて欲しい。"},
        { "location": "1761/TALK"  , "narrator": "千羽鶴", "text": "それと、イチャラブ編も\n試してみてもらえると\n嬉しいかも。"},
        { "location": "1762/TALK"  , "narrator": "千羽鶴", "text": "貴方とあなたの世界に、\n素敵なココロの旅を。"}
    ]
}
