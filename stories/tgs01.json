        "title": "イベント向け体験版",
        "sub_title": "イベント向け体験版"
    },
    "entry":
    [
        { "location": "5/SCENARIO" , "narrator": "", "text": "運営劇場"},
        { "location": "97/DIALOG"  , "narrator": "", "text": "<color=red><size=32>拡張少女系トライナリーの\n世界へようこそ！</size></color>\n\nこのDEMOシナリオでは、攻略対象の彼女たちとのコミュニケーションと、壮大なシナリオの一端を垣間見ることができます。\n\n是非最後までプレイしていって\nくださいね。"},
        { "location": "98/TALK"    , "narrator": "千羽鶴", "text": "はじめまして。\n私は千羽鶴。\n「ちはる」と読む。"},
        { "location": "102/TALK"   , "narrator": "千羽鶴", "text": "今回は、私たちの世界に\n興味を持ってくれた貴方を\n導く役割を与えられた。"},
        { "location": "103/TALK"   , "narrator": "千羽鶴", "text": "短い時間だけど、\nどうぞよろしく。"},
        { "location": "104/SEL"    , "narrator": "（選択肢）", "text": "よろしく！"},
        { "location": "105/SEL"    , "narrator": "（選択肢）", "text": "千羽鶴ちゃん結婚して！"},
        { "location": "106/ACT"    , "narrator": "", "text": "よろしく！"},
        { "location": "108/ACT"    , "narrator": "", "text": "千羽鶴ちゃん結婚して！"},
        { "location": "109/TALK"   , "narrator": "千羽鶴", "text": "残念だけど、\n私は非攻略対象。"},
        { "location": "111/SEL"    , "narrator": "（選択肢）", "text": "それは残念…"},
        { "location": "112/SEL"    , "narrator": "（選択肢）", "text": "そんなのいやです！！"},
        { "location": "113/ACT"    , "narrator": "", "text": "それは残念…"},
        { "location": "114/TALK"   , "narrator": "千羽鶴", "text": "残念だけど、仕方ない。"},
        { "location": "115/TALK"   , "narrator": "千羽鶴", "text": "というわけで、\n本題に戻るけど。"},
        { "location": "116/ACT"    , "narrator": "", "text": "そんなのいやです！！"},
        { "location": "117/TALK"   , "narrator": "千羽鶴", "text": "……。"},
        { "location": "118/TALK"   , "narrator": "千羽鶴", "text": "そんな聞き分けが悪い子は\nちーちゃん好きじゃ\nありません。"},
        { "location": "119/TALK"   , "narrator": "千羽鶴", "text": "けど、もし結婚したら、\nこの体験版だけじゃなく\nアプリをDLしてくれる？"},
        { "location": "120/SEL"    , "narrator": "（選択肢）", "text": "はい！"},
        { "location": "121/SEL"    , "narrator": "（選択肢）", "text": "それは約束できない"},
        { "location": "122/ACT"    , "narrator": "", "text": "はい！"},
        { "location": "125/TALK"   , "narrator": "千羽鶴", "text": "わかった。\nそれじゃ――"},
        { "location": "128/TALK"   , "narrator": "千羽鶴", "text": "結婚おめでとう私たち。"},
        { "location": "130/TALK"   , "narrator": "千羽鶴", "text": "というわけで、\n早速結婚したから\n約束は守って。"},
        { "location": "133/TALK"   , "narrator": "千羽鶴", "text": "はい！\n今すぐここに\nスマホをかざす！"},
        { "location": "136/TALK"   , "narrator": "千羽鶴", "text": "ちゃんとDLした？"},
        { "location": "137/SEL"    , "narrator": "（選択肢）", "text": "もちろん"},
        { "location": "138/SEL"    , "narrator": "（選択肢）", "text": "後でいいですか？"},
        { "location": "139/ACT"    , "narrator": "", "text": "もちろん"},
        { "location": "140/TALK"   , "narrator": "千羽鶴", "text": "ありがと。"},
        { "location": "141/ACT"    , "narrator": "", "text": "後でいいですか？"},
        { "location": "142/TALK"   , "narrator": "千羽鶴", "text": "まあ、いいけど。"},
        { "location": "144/TALK"   , "narrator": "千羽鶴", "text": "ちなみに、私と結婚した\n人の人数は、ちゃんと\n数えてるから。"},
        { "location": "145/TALK"   , "narrator": "千羽鶴", "text": "もしその数より、今日の\nサインアップ数が\n少なかった場合。"},
        { "location": "146/TALK"   , "narrator": "千羽鶴", "text": "ゲームショウ終了後、\n私は傷心のちーになる！"},
        { "location": "147/TALK"   , "narrator": "千羽鶴", "text": "だから、\n貴方の誠実さは責任重大。"},
        { "location": "148/TALK"   , "narrator": "千羽鶴", "text": "というわけで、\nホントにDLよろしく。"},
        { "location": "150/TALK"   , "narrator": "千羽鶴", "text": "まあでも。\n嘘でも結婚したわけだし。"},
        { "location": "151/TALK"   , "narrator": "千羽鶴", "text": "この体験プレイを最後まで\nやってくれたら、\n少しだけハネムーンする。"},
        { "location": "153/TALK"   , "narrator": "千羽鶴", "text": "だから、今日はゆっくりと\nこのアプリの魅力を\n堪能していって欲しい。"},
        { "location": "154/ACT"    , "narrator": "", "text": "それは約束できない"},
        { "location": "155/TALK"   , "narrator": "千羽鶴", "text": "なんて正直な人。"},
        { "location": "156/TALK"   , "narrator": "千羽鶴", "text": "それならそれで構わない。"},
        { "location": "157/TALK"   , "narrator": "千羽鶴", "text": "どちらにせよ、\nこのアプリに興味を持って\nくれたわけだから――"},
        { "location": "158/TALK"   , "narrator": "千羽鶴", "text": "今のこの時間だけでも、\n楽しんで行って欲しい。"},
        { "location": "162/TALK"   , "narrator": "千羽鶴", "text": "それじゃ早速、\nこのアプリの\n紹介をしようと思う。"},
        { "location": "166/DIALOG" , "narrator": "", "text": "拡張少女系トライナリーは\nスマートフォンRPGです。"},
        { "location": "168/TALK"   , "narrator": "千羽鶴", "text": "このアプリ，拡張少女系\nトライナリーは、いわゆる\nゲームに分類されるけど、"},
        { "location": "171/DIALOG" , "narrator": "", "text": "拡張少女系トライナリーは\n基本的に物語を楽しむゲームです。"},
        { "location": "173/TALK"   , "narrator": "千羽鶴", "text": "基本、物語９ゲーム１に\n分類される、ラノベゲーと\n考えてくれた方がいい。"},
        { "location": "174/TALK"   , "narrator": "千羽鶴", "text": "なので今回は、バトルや\n育成については紹介なし！"},
        { "location": "177/DIALOG" , "narrator": "", "text": "そして、可愛い女の子と\n沢山イチャイチャできます。"},
        { "location": "179/TALK"   , "narrator": "千羽鶴", "text": "ストーリーや少女たちの\n魅力だけを、嫌というほど\n紹介していく。"},
        { "location": "180/TALK"   , "narrator": "千羽鶴", "text": "パネルにある可愛い\n少女たちとの体験に\n興味あれば是非進めて。"},
        { "location": "183/DIALOG" , "narrator": "", "text": "イチャイチャしつつも、\n物語は壮大です。"},
        { "location": "185/TALK"   , "narrator": "千羽鶴", "text": "全体のノリとしては、\n過酷な運命を背負う少女\nたちを貴方が癒す物語。"},
        { "location": "186/TALK"   , "narrator": "千羽鶴", "text": "今回は、その要素を\nラブとストーリーに分けて\n用意してみた。"},
        { "location": "187/TALK"   , "narrator": "千羽鶴", "text": "どっちでも\n好きな方を選んで。"},
        { "location": "192/SEL"    , "narrator": "（選択肢）", "text": "彼女たちとイチャイチャしたい"},
        { "location": "193/SEL"    , "narrator": "（選択肢）", "text": "その壮大なるストーリーとやらを垣間見たい"},
        { "location": "195/ACT"    , "narrator": "", "text": "彼女たちとイチャイチャしたい"},
        { "location": "196/TALK"   , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "197/TALK"   , "narrator": "千羽鶴", "text": "ところで貴方は、\n既にアプリをDLして\nプレイしてる人？"},
        { "location": "198/SEL"    , "narrator": "（選択肢）", "text": "いえ、してません。"},
        { "location": "199/SEL"    , "narrator": "（選択肢）", "text": "プレイしてる人です"},
        { "location": "200/ACT"    , "narrator": "", "text": "いえ、してません。"},
        { "location": "201/TALK"   , "narrator": "千羽鶴", "text": "興味持ってくれて\nありがと。"},
        { "location": "202/TALK"   , "narrator": "千羽鶴", "text": "今日は十分に\n彼女たちとのラブラブを\n楽しんでいって欲しい。"},
        { "location": "203/TALK"   , "narrator": "千羽鶴", "text": "ちなみに、この端末で\n過去にプレイした人全員に\n聞いてみたところ――"},
        { "location": "204/TALK"   , "narrator": "千羽鶴", "text": "$tgs_q1_all$人中$tgs_q1_yes$人が\n彼女とのイチャラブに\n夢中だと答えてる。"},
        { "location": "205/TALK"   , "narrator": "千羽鶴", "text": "あなたにとっても\n彼女たちが魅力的だと\nいいけど。"},
        { "location": "206/ACT"    , "narrator": "", "text": "プレイしてる人です"},
        { "location": "207/TALK"   , "narrator": "千羽鶴", "text": "いつも彼女たちを\n癒してくれてありがと。"},
        { "location": "208/TALK"   , "narrator": "千羽鶴", "text": "ところで、聞くまでも\nないと思うけど――"},
        { "location": "209/TALK"   , "narrator": "千羽鶴", "text": "彼女たちは魅力的？\nラヴい？"},
        { "location": "210/SEL"    , "narrator": "（選択肢）", "text": "もちろん！！"},
        { "location": "211/SEL"    , "narrator": "（選択肢）", "text": "実はそんなには…"},
        { "location": "212/ACT"    , "narrator": "", "text": "もちろん！！"},
        { "location": "217/TALK"   , "narrator": "千羽鶴", "text": "良かった。\nこれからも\n一緒にいてあげて。"},
        { "location": "218/ACT"    , "narrator": "", "text": "実はそんなには…"},
        { "location": "221/TALK"   , "narrator": "千羽鶴", "text": "そう。\nそれは残念。"},
        { "location": "240/TALK"   , "narrator": "千羽鶴", "text": "それじゃ早速、\n彼女たちを紹介がてら\nイチャイチャしてもらう。"},
        { "location": "242/TALK"   , "narrator": "千羽鶴", "text": "プロファイル０１、\n逢瀬つばめ\n１５歳、高校１年。"},
        { "location": "243/TALK"   , "narrator": "千羽鶴", "text": "いつも元気で天然系の\n前向き指向、まわりを\n笑顔にするのが得意。"},
        { "location": "244/TALK"   , "narrator": "千羽鶴", "text": "なかなか骨太な世間\n知らずのところがウザ\nカワイイ…かも。"},
        { "location": "245/TALK"   , "narrator": "千羽鶴", "text": "得意なことは……\n何かあったかしら。"},
        { "location": "247/TALK"   , "narrator": "千羽鶴", "text": "プロファイル０２、\n國政綾水（あやみ）\n２１歳、大学３年。"},
        { "location": "248/TALK"   , "narrator": "千羽鶴", "text": "４人の中で最年長の\nお姉さん的存在。"},
        { "location": "249/TALK"   , "narrator": "千羽鶴", "text": "結構なカタブツだけど、\n面倒見は良く、頼りに\nなる存在だと思う。"},
        { "location": "250/TALK"   , "narrator": "千羽鶴", "text": "剣道をたしなみ、その\n腕は世界選手権で優勝\nした程。"},
        { "location": "252/TALK"   , "narrator": "千羽鶴", "text": "プロファイル０３、\nガブリエラ\n１４歳、中学３年。"},
        { "location": "253/TALK"   , "narrator": "千羽鶴", "text": "４人中最年少の\nポーランドから来た\n留学生。"},
        { "location": "254/TALK"   , "narrator": "千羽鶴", "text": "いつもツンツンしてる\nけど、本当はメルヘンな\nものが大好き。"},
        { "location": "255/TALK"   , "narrator": "千羽鶴", "text": "銃の腕前は\n世界で通用するレベル。"},
        { "location": "257/TALK"   , "narrator": "千羽鶴", "text": "プロファイル０４、\n恋ヶ崎みやび\n１７歳、高校３年。"},
        { "location": "258/TALK"   , "narrator": "千羽鶴", "text": "いつも突拍子も無い\nことを言って、周囲を\n惑わせる不思議ちゃん。"},
        { "location": "259/TALK"   , "narrator": "千羽鶴", "text": "典型的な、\n『喋らなければ\n綺麗なお姉さん』ね。"},
        { "location": "260/TALK"   , "narrator": "千羽鶴", "text": "面倒くさがりでズボラ\nだけど、PCの腕は\nハッカークラス。"},
        { "location": "262/TALK"   , "narrator": "千羽鶴", "text": "以上、簡単な紹介おわり。\n早速今からフリータイム。"},
        { "location": "264/SEL"    , "narrator": "（選択肢）", "text": "逢瀬つばめ"},
        { "location": "265/SEL"    , "narrator": "（選択肢）", "text": "國政綾水"},
        { "location": "266/SEL"    , "narrator": "（選択肢）", "text": "ガブリエラ"},
        { "location": "267/SEL"    , "narrator": "（選択肢）", "text": "恋ヶ崎みやび"},
        { "location": "268/SEL"    , "narrator": "（選択肢）", "text": "千羽鶴"},
        { "location": "269/SEL"    , "narrator": "（選択肢）", "text": "十分堪能した！"},
        { "location": "270/ACT"    , "narrator": "", "text": "逢瀬つばめ"},
        { "location": "272/TALK"   , "narrator": "つばめ", "text": "は、はじめまして！\n逢瀬ちゅ…つ、\nつばめです！"},
        { "location": "273/TALK"   , "narrator": "つばめ", "text": "何の取り柄もないけど\n宜しくお願いします！"},
        { "location": "277/DIALOG" , "narrator": "", "text": "<b><color=#ff0044><size=40>逢瀬つばめ</size></color></b>\n<color=#ff0044><size=20>おうせつばめ</size></color>\n\n１５歳(高校１年)\n誕生日:2000.6.7\n\n静岡県出身。\n近年まで重い病気でずっと入院していたため世間知らず。\n元気で前向きで天然なムードメーカー。\n\n<b><color=orange>【好きなもの】</color></b>\nフレイメノウ、可愛い服、いちご、チーズクリーム鯛焼き\n\n<b><color=blue>【苦手なもの】</color></b>\n病院、薬、痛いこと\n"},
        { "location": "281/SEL"    , "narrator": "（選択肢）", "text": "チャットでイチャイチャ体験"},
        { "location": "282/SEL"    , "narrator": "（選択肢）", "text": "浜辺で水着イチャイチャ体験"},
        { "location": "283/SEL"    , "narrator": "（選択肢）", "text": "お試しおさわり"},
        { "location": "284/SEL"    , "narrator": "（選択肢）", "text": "戻る"},
        { "location": "285/ACT"    , "narrator": "", "text": "チャットでイチャイチャ体験"},
        { "location": "290/ACT"    , "narrator": "", "text": "浜辺で水着イチャイチャ体験"},
        { "location": "295/ACT"    , "narrator": "", "text": "お試しおさわり"},
        { "location": "301/DIALOG" , "narrator": "", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "364/TALK"   , "narrator": "つばめ", "text": "えへへ。"},
        { "location": "366/TALK"   , "narrator": "つばめ", "text": "なんだか\nこそばゆいょ。"},
        { "location": "372/TALK"   , "narrator": "つばめ", "text": "うわっ！"},
        { "location": "374/TALK"   , "narrator": "つばめ", "text": "いたたっ！\n許してください！"},
        { "location": "380/TALK"   , "narrator": "つばめ", "text": "きゃあっ！"},
        { "location": "382/TALK"   , "narrator": "つばめ", "text": "もーっ！\nわたしが何も言わない\nからって！"},
        { "location": "388/TALK"   , "narrator": "つばめ", "text": "あははっ！\nなんか\nこそばゆいよう。"},
        { "location": "390/TALK"   , "narrator": "つばめ", "text": "ぷにぷにしてる？\n鍛えないとだめかなぁ。"},
        { "location": "396/TALK"   , "narrator": "つばめ", "text": "はああっ…"},
        { "location": "398/TALK"   , "narrator": "つばめ", "text": "へんなかんじ。"},
        { "location": "404/DIALOG" , "narrator": "", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"},
        { "location": "407/TALK"   , "narrator": "千羽鶴", "text": "はい、お終い。"},
        { "location": "409/ACT"    , "narrator": "", "text": "戻る"},
        { "location": "413/ACT"    , "narrator": "", "text": "國政綾水"},
        { "location": "415/TALK"   , "narrator": "アーヤ", "text": "はじめまして。\n國政綾水と申します。"},
        { "location": "416/TALK"   , "narrator": "アーヤ", "text": "貴方のサポート、\n楽しみにしてるわ。"},
        { "location": "420/DIALOG" , "narrator": "", "text": "<b><color=#2670DA><size=40>國政綾水</size>(アーヤ)</color></b>\n<color=#2670DA><size=20>くにまさあやみ</size></color>\n\n２１歳(大学３年)\n誕生日:1994.9.14\n\n長野県出身。\n実家がド田舎の山中にある神社ということもあり、都会に憧れを持つ。責任感が強く、意志が固いリーダー肌の少女。\n\n<b><color=orange>【好きなもの】</color></b>\n武士の心得、精神統一\n哲学、子供、都会\n\n<b><color=blue>【苦手なもの】</color></b>\nだらしない人\n"},
        { "location": "424/SEL"    , "narrator": "（選択肢）", "text": "チャットでイチャイチャ体験"},
        { "location": "425/SEL"    , "narrator": "（選択肢）", "text": "浜辺で水着イチャイチャ体験"},
        { "location": "426/SEL"    , "narrator": "（選択肢）", "text": "お試しおさわり"},
        { "location": "427/SEL"    , "narrator": "（選択肢）", "text": "戻る"},
        { "location": "428/ACT"    , "narrator": "", "text": "チャットでイチャイチャ体験"},
        { "location": "433/ACT"    , "narrator": "", "text": "浜辺で水着イチャイチャ体験"},
        { "location": "438/ACT"    , "narrator": "", "text": "お試しおさわり"},
        { "location": "444/DIALOG" , "narrator": "", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "507/TALK"   , "narrator": "アーヤ", "text": "ふふっ。"},
        { "location": "509/TALK"   , "narrator": "アーヤ", "text": "ちょっと\n不思議な気分。"},
        { "location": "515/TALK"   , "narrator": "アーヤ", "text": "きゃっ！？"},
        { "location": "517/TALK"   , "narrator": "アーヤ", "text": "ちょ、ちょっと\n痛いってば！"},
        { "location": "523/TALK"   , "narrator": "アーヤ", "text": "もうっ。\n調子に乗らないの。"},
