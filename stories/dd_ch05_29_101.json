{
    "dir": "chap29/daydra/dd_ch05_29_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "29502",
        "cid": "kagura",
        "title": "002 メインストーリー",
        "sub_title": "ロックアウト作戦＜前編＞"
    },
    "entry":
    [
        { "location": "2060/TALK"  , "narrator": "雛", "text": "うわぁ、マジ牢屋だ。\n生まれて初めて入ったよ。"},
        { "location": "2061/TALK"  , "narrator": "繭", "text": "…………。"},
        { "location": "2065/TALK"  , "narrator": "雛", "text": "大丈夫だよ。\nまゆちん、\n元気出してー。"},
        { "location": "2066/TALK"  , "narrator": "繭", "text": "…ごめんなさい。"},
        { "location": "2067/TALK"  , "narrator": "雛", "text": "んん？"},
        { "location": "2069/TALK"  , "narrator": "繭", "text": "こうなったのも、\n全部私のせい…。"},
        { "location": "2071/TALK"  , "narrator": "繭", "text": "本当は、もっと早く\nミスしたかもって\n気付いてた。"},
        { "location": "2072/TALK"  , "narrator": "繭", "text": "なのに、大丈夫だって\n勝手に決めつけて、\n言うの遅れたから…。"},
        { "location": "2073/TALK"  , "narrator": "繭", "text": "本当に、\nごめんなさい…。"},
        { "location": "2074/TALK"  , "narrator": "雛", "text": "ちょ、やめてよ。\n別にまゆちんだけの\nせいじゃないじゃん。"},
        { "location": "2075/TALK"  , "narrator": "繭", "text": "私のせい。\n私がヘマしたから…。"},
        { "location": "2076/TALK"  , "narrator": "雛", "text": "まゆちん！"},
        { "location": "2078/TALK"  , "narrator": "繭", "text": "っ！？"},
        { "location": "2079/TALK"  , "narrator": "雛", "text": "あたしも神楽ちゃんも\n危険なことだと\nわかってやってたの。"},
        { "location": "2080/TALK"  , "narrator": "雛", "text": "もちろん、今みたいな\n最悪な状況だって\n想定してた。"},
        { "location": "2081/TALK"  , "narrator": "雛", "text": "そもそも、全部が全部\n上手くいくだなんて、\n絶対ムリだから。"},
        { "location": "2082/TALK"  , "narrator": "繭", "text": "で、でも、私は…。"},
        { "location": "2083/TALK"  , "narrator": "雛", "text": "全部じゃなくても、\n情報を引き出せた\nじゃん。"},
        { "location": "2084/TALK"  , "narrator": "雛", "text": "それに、逃げるときに\n神楽ちゃんに渡した\nSIMカード…。"},
        { "location": "2085/TALK"  , "narrator": "雛", "text": "あれって、\nトライガジェットに\n使えるヤツでしょ？"},
        { "location": "2086/TALK"  , "narrator": "繭", "text": "…そう。"},
        { "location": "2087/TALK"  , "narrator": "雛", "text": "ちゃんと最悪な状況に\nなったときの対策も\n取ったんだから…。"},
        { "location": "2088/TALK"  , "narrator": "雛", "text": "まゆちんが落ち込む\n必要なんてない。"},
        { "location": "2089/TALK"  , "narrator": "雛", "text": "最後まで問題なく\n事が進められると\n思ってたなら…。"},
        { "location": "2090/TALK"  , "narrator": "雛", "text": "甘いこと言うなー、\nって怒るけどさ。"},
        { "location": "2091/TALK"  , "narrator": "繭", "text": "…………。"},
        { "location": "2092/TALK"  , "narrator": "雛", "text": "…落ち込む暇がある\nなら、元気出して、\n対策を練ろうよ。"},
        { "location": "2093/TALK"  , "narrator": "繭", "text": "…ムリ。\n打つ手なし。"},
        { "location": "2094/TALK"  , "narrator": "雛", "text": "まゆちん…。"},
        { "location": "2095/TALK"  , "narrator": "繭", "text": "…………。"},
        { "location": "2096/TALK"  , "narrator": "雛", "text": "わかった。\nそれじゃあもういい。"},
        { "location": "2098/TALK"  , "narrator": "雛", "text": "あたし一人で\nどうにかしてみせる！"},
        { "location": "2100/TALK"  , "narrator": "繭", "text": "…………え？"},
        { "location": "2105/TALK"  , "narrator": "雛", "text": "うおー、出せー！！\nあたしは無実だー、\nここから出せー！！"},
        { "location": "2113/TALK"  , "narrator": "繭", "text": "ちょ、ひなこ！？"},
        { "location": "2114/TALK"  , "narrator": "雛", "text": "ほら、まゆちんも。\n出せー！！\nここから出せー！！"},
        { "location": "2122/TALK"  , "narrator": "繭", "text": "いや、ひなこ、\nちょっと――"},
        { "location": "2123/TALK"  , "narrator": "雛", "text": "だーせえええええ！！"},
        { "location": "2138/TALK"  , "narrator": "繭", "text": "うるさいやめろ！！"},
        { "location": "2144/TALK"  , "narrator": "雛", "text": "おっ、いつもの調子\n戻ってきたねー。"},
        { "location": "2145/TALK"  , "narrator": "繭", "text": "…まったく。"},
        { "location": "2146/TALK"  , "narrator": "繭", "text": "ひなこといると、\n落ち込む暇もないわ。"},
        { "location": "2147/TALK"  , "narrator": "雛", "text": "まゆちんは\nいつもみたいに\nクールな方がいいよ。"},
        { "location": "2148/TALK"  , "narrator": "雛", "text": "まあ、オタッぽい\nところもチャーム\nポイントだけど。"},
        { "location": "2151/TALK"  , "narrator": "繭", "text": "うるさい黙れ。"},
        { "location": "2152/TALK"  , "narrator": "雛", "text": "黙りながら\n牢屋蹴ってていい？"},
        { "location": "2155/TALK"  , "narrator": "繭", "text": "静かにしてなさい。"},
        { "location": "2157/TALK"  , "narrator": "雛", "text": "はーい…。"},
        { "location": "2159/TALK"  , "narrator": "繭", "text": "まったく…。"},
        { "location": "2161/TALK"  , "narrator": "繭", "text": "…ありがとね、\nひなこ。"},
        { "location": "2163/TALK"  , "narrator": "繭", "text": "…でも、これから\n私達はどうなるん\nだろう？"},
        { "location": "2164/TALK"  , "narrator": "繭", "text": "このままずっと\n投獄されたままじゃ\nないとは思うけど…。"},
        { "location": "2165/TALK"  , "narrator": "繭", "text": "それに…卯月さんは\n大丈夫かしら？"},
        { "location": "2166/TALK"  , "narrator": "繭", "text": "私が渡した、\nSIMカード…。"},
        { "location": "2167/TALK"  , "narrator": "繭", "text": "アレを装備して\nくれてたら、\n希望はあるけど…。"},
        { "location": "2168/TALK"  , "narrator": "繭", "text": "あとは多分、\n$handle$さんが\n上手くやるはず。"},
        { "location": "2169/TALK"  , "narrator": "繭", "text": "$handle$さん。\nどうか卯月さんを――"},
        { "location": "2170/TALK"  , "narrator": "繭", "text": "よろしく\nお願いします。"},
        { "location": "2171/TALK"  , "narrator": "雛", "text": "看守さーん、\nお願いしまーす！\n出してくださーい！！"},
        { "location": "2173/TALK"  , "narrator": "繭", "text": "そういう意味で\n言ったわけじゃない。"},
        { "location": "2174/TALK"  , "narrator": "繭", "text": "大体、なに言ったって\n扉が開くことなんて――"},
        { "location": "2183/TALK"  , "narrator": "繭", "text": "…開いた！？"},
        { "location": "2184/TALK"  , "narrator": "？？？", "text": "二人とも、早く！"},
        { "location": "2185/TALK"  , "narrator": "雛", "text": "う、うそぉ……？"},
        { "location": "2210/TALK"  , "narrator": "神楽", "text": "…とうとう、\n最悪な状況に\nなったか…。"},
        { "location": "2211/TALK"  , "narrator": "神楽", "text": "もう、私はなにを\nされてもおかしく\nない…。"},
        { "location": "2212/TALK"  , "narrator": "神楽", "text": "繭さん達だけでも、\n無事に出られれば\nいいけど…。"},
        { "location": "2214/TALK"  , "narrator": "つばめ", "text": "はあ…。"},
        { "location": "2215/TALK"  , "narrator": "つばめ", "text": "いつまで\nここにいれば\nいいのかな……。"},
        { "location": "2217/TALK"  , "narrator": "つばめ", "text": "結構時間\n経っちゃったよね？"},
        { "location": "2218/TALK"  , "narrator": "神楽", "text": "……。"},
        { "location": "2219/TALK"  , "narrator": "神楽", "text": "今となっては、\nトライガジェットを\n解析した意味も…。"},
        { "location": "2220/TALK"  , "narrator": "神楽", "text": "本当にあったのか\nどうかわからないし。"},
        { "location": "2221/TALK"  , "narrator": "神楽", "text": "っていうか、それ自体\nトロイの木馬みたいな\n罠だった可能性も…。"},
        { "location": "2223/TALK"  , "narrator": "つばめ", "text": "ずっとここに\n閉じ込められたまま\nってことはないよね？"},
        { "location": "2224/TALK"  , "narrator": "神楽", "text": "そうなると、\n繭さん達は踊らされ\nてただけかも。"},
        { "location": "2225/TALK"  , "narrator": "神楽", "text": "でも、\n真幌さんは…、黒？"},
        { "location": "2226/TALK"  , "narrator": "神楽", "text": "それとも、真幌さんも\n踊らされてたとか？"},
        { "location": "2227/TALK"  , "narrator": "神楽", "text": "……。"},
        { "location": "2228/TALK"  , "narrator": "神楽", "text": "もう、なにがなんだか\nわからない…。"},
        { "location": "2229/TALK"  , "narrator": "つばめ", "text": "これから\nどうなるんだろうね。"},
        { "location": "2230/TALK"  , "narrator": "つばめ", "text": "…神楽ちゃん\nずっと下向いた\nまま……。"},
        { "location": "2232/TALK"  , "narrator": "つばめ", "text": "わたし少し\nしゃべりすぎかな…？"},
        { "location": "2233/TALK"  , "narrator": "神楽", "text": "私にはもう、\nなにもできない…。"},
        { "location": "2234/TALK"  , "narrator": "神楽", "text": "トライガジェットも\nロックがかけられ\nてるし…。"},
        { "location": "2235/SEL"   , "narrator": "", "text": "繭が渡したSIMカードを使って"},
        { "location": "2236/ACT"   , "narrator": "", "text": "繭が渡したSIMカードを使って"},
        { "location": "2238/TALK"  , "narrator": "神楽", "text": "これじゃ、\n$handle$さんとも\nお話しできない…。"},
        { "location": "2239/SEL"   , "narrator": "", "text": "繭が渡したSIMカードを使って"},
        { "location": "2240/SEL"   , "narrator": "", "text": "できるよ！！"},
        { "location": "2241/ACT"   , "narrator": "", "text": "繭が渡したSIMカードを使って"},
        { "location": "2242/ACT"   , "narrator": "", "text": "できるよ！！"},
        { "location": "2244/TALK"  , "narrator": "神楽", "text": "普段、うぜーとか\n言ってるくせに…。"},
        { "location": "2245/TALK"  , "narrator": "神楽", "text": "ちょっと話すことが\nできないのが、\nこんなに辛いなんて。"},
        { "location": "2246/SEL"   , "narrator": "", "text": "繭のSIMカードを使って！！"},
        { "location": "2247/SEL"   , "narrator": "", "text": "$me$も辛いよ！！"},
        { "location": "2248/ACT"   , "narrator": "", "text": "繭のSIMカードを使って！！"},
        { "location": "2249/ACT"   , "narrator": "", "text": "$me$も辛いよ！！"},
        { "location": "2251/TALK"  , "narrator": "神楽", "text": "お話ししたい…。"},
        { "location": "2252/TALK"  , "narrator": "神楽", "text": "お話ししたいよ、\n$handle$さん…。"},
        { "location": "2253/SEL"   , "narrator": "", "text": "繭のSIMカードを使って！！"},
        { "location": "2254/SEL"   , "narrator": "", "text": "$me$も辛いよ！！"},
        { "location": "2255/ACT"   , "narrator": "", "text": "繭のSIMカードを使って！！"},
        { "location": "2256/ACT"   , "narrator": "", "text": "$me$も辛いよ！！"},
        { "location": "2259/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "2261/TALK"  , "narrator": "神楽", "text": "っ！？\nそうだ、忘れてた！"},
        { "location": "2262/TALK"  , "narrator": "神楽", "text": "繭さんからもらった\nSIMカードのこと！"},
        { "location": "2263/TALK"  , "narrator": "神楽", "text": "確か、\nガーターベルトの中に\n引っ掛けて隠した……"},
        { "location": "2264/TALK"  , "narrator": "神楽", "text": "あった！\n着替えさせられる前に\n思い出してよかった。"},
        { "location": "2265/TALK"  , "narrator": "神楽", "text": "トライガジェットに\nこれを挿せば、\n$handle$さんと…。"},
        { "location": "2267/TALK"  , "narrator": "神楽", "text": "でも…、これって\n本当に使っても\n大丈夫なの？"},
        { "location": "2268/TALK"  , "narrator": "神楽", "text": "もしかしたら、\nあのハッキング自体が\n罠だったとしたら？"},
        { "location": "2269/TALK"  , "narrator": "神楽", "text": "だとしたら、それから\n作ったこれ自体も\n罠なんじゃ…。"},
        { "location": "2271/TALK"  , "narrator": "神楽", "text": "そうだとしたら、\n使ったら大変なことに\nなるかも…。"},
        { "location": "2272/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "2273/SEL"   , "narrator": "", "text": "大丈夫だよ、安全だから！"},
        { "location": "2274/ACT"   , "narrator": "", "text": "大丈夫だよ、安全だから！"},
        { "location": "2277/TALK"  , "narrator": "神楽", "text": "でも、もしもそうじゃ\nなかったとしたら、\n最後の切り札…。"},
        { "location": "2278/TALK"  , "narrator": "神楽", "text": "どうしよう…。\nこんな大博打にかけて\n本当にいいの？"},
        { "location": "2279/TALK"  , "narrator": "神楽", "text": "何もしなくても\nロクなことには\nならないけど…。"},
        { "location": "2280/TALK"  , "narrator": "神楽", "text": "だからって、\n簡単に決めるわけにも\nいかないし…。"},
        { "location": "2281/SEL"   , "narrator": "", "text": "神楽、お願い！　それをトライガジェットに挿して！"},
        { "location": "2282/SEL"   , "narrator": "", "text": "大丈夫だってば、気付いて！！"},
        { "location": "2283/ACT"   , "narrator": "", "text": "神楽、お願い！　それをトライガジェットに挿して！"},
        { "location": "2284/ACT"   , "narrator": "", "text": "大丈夫だってば、気付いて！！"},
        { "location": "2286/TALK"  , "narrator": "神楽", "text": "…こんな時、\nいつもだったら\n$handle$さんに…。"},
        { "location": "2287/TALK"  , "narrator": "神楽", "text": "相談して決めることが\nできるのに。"},
        { "location": "2288/TALK"  , "narrator": "神楽", "text": "…そっか。"},
        { "location": "2289/TALK"  , "narrator": "神楽", "text": "私、ずっと一人だと\n思ってたけど…。"},
        { "location": "2290/TALK"  , "narrator": "神楽", "text": "ずっとあの人が\nいてくれたんだ。"},
        { "location": "2291/TALK"  , "narrator": "神楽", "text": "だから、こうして\n生きてこられたんだ。"},
        { "location": "2292/TALK"  , "narrator": "神楽", "text": "…逢いたい。"},
        { "location": "2295/TALK"  , "narrator": "神楽", "text": "$handle$さんに、\n逢いたい…。\nお話ししたい…。"},
        { "location": "2296/SEL"   , "narrator": "", "text": "$me$も話したいから、SIMカードを使って！"},
        { "location": "2297/SEL"   , "narrator": "", "text": "頼むから、気付いてよ…"},
        { "location": "2298/ACT"   , "narrator": "", "text": "$me$も話したいから、SIMカードを使って！"},
        { "location": "2299/ACT"   , "narrator": "", "text": "頼むから、気付いてよ…"},
        { "location": "2301/TALK"  , "narrator": "神楽", "text": "…でも、今は\nそんなこと考えてる\n場合じゃない。"},
        { "location": "2303/TALK"  , "narrator": "神楽", "text": "今はSIMカードを\n使うかどうかを\n決めるのが第一。"},
        { "location": "2304/TALK"  , "narrator": "神楽", "text": "…さあ、どうする私？"},
        { "location": "2305/TALK"  , "narrator": "神楽", "text": "どれだけ考えても、\n答えなんかわかるはず\nないこの状況で…。"},
        { "location": "2306/TALK"  , "narrator": "神楽", "text": "私は、何を信じる？"},
        { "location": "2307/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "2308/TALK"  , "narrator": "神楽", "text": "…だったら、\nもし私が死ぬことに\nなったとしても…。"},
        { "location": "2309/TALK"  , "narrator": "神楽", "text": "後悔しない選択を\nするしかない。"},
        { "location": "2310/TALK"  , "narrator": "神楽", "text": "それなら、\n私は――"},
        { "location": "2358/TALK"  , "narrator": "月神楽", "text": "　"},
        { "location": "2397/TALK"  , "narrator": "月神楽", "text": "お早いお着きで～♪"},
        { "location": "2398/SEL"   , "narrator": "", "text": "なんかいつもと眺めが違うような…？"},
        { "location": "2399/SEL"   , "narrator": "", "text": "ももももしかして怒ってますか！？"},
        { "location": "2400/ACT"   , "narrator": "", "text": "なんかいつもと眺めが違うような…？"},
        { "location": "2401/TALK"  , "narrator": "月神楽", "text": "そりゃそうですよ。"},
        { "location": "2402/TALK"  , "narrator": "月神楽", "text": "貴方の上に馬乗りに\nなっているんですから。"},
        { "location": "2403/ACT"   , "narrator": "", "text": "ももももしかして怒ってますか！？"},
        { "location": "2404/TALK"  , "narrator": "月神楽", "text": "いいえ？\n全然怒ってませんよ？"},
        { "location": "2405/TALK"  , "narrator": "月神楽", "text": "ただ、貸しを\n返してもらおうかと\n思ってるだけです♪"},
        { "location": "2407/TALK"  , "narrator": "月神楽", "text": "$handle$さんには\n今、貸しが【６】\nありますよねっ♪"},
        { "location": "2408/SEL"   , "narrator": "", "text": "はああああ！？メチャクチャ増えてるんですけど！？"},
        { "location": "2409/ACT"   , "narrator": "", "text": "はああああ！？メチャクチャ増えてるんですけど！？"},
        { "location": "2411/TALK"  , "narrator": "月神楽", "text": "増やしたのは\n$handle$さんじゃ\nありませんか。"},
        { "location": "2413/SEL"   , "narrator": "", "text": "いや、$me$の借りは２だったと思うんですけど…"},
        { "location": "2414/ACT"   , "narrator": "", "text": "いや、$me$の借りは２だったと思うんですけど…"},
        { "location": "2417/SEL"   , "narrator": "", "text": "いや、$me$の借りは４だったと思うんですけど…"},
        { "location": "2418/ACT"   , "narrator": "", "text": "いや、$me$の借りは４だったと思うんですけど…"},
        { "location": "2425/TALK"  , "narrator": "月神楽", "text": "そんな見え見えの嘘ついて\nしらばっくれるようなら、\n本当にお仕置きですよ？"},
        { "location": "2426/SEL"   , "narrator": "", "text": "ホントに身に覚えが無いんですけどー！"},
        { "location": "2427/ACT"   , "narrator": "", "text": "ホントに身に覚えが無いんですけどー！"},
        { "location": "2429/TALK"  , "narrator": "月神楽", "text": "……。"},
        { "location": "2430/TALK"  , "narrator": "月神楽", "text": "酔ってました？"},
        { "location": "2431/SEL"   , "narrator": "", "text": "未成年ですって！"},
        { "location": "2432/SEL"   , "narrator": "", "text": "自信ない…けど、そんな記憶はない"},
        { "location": "2433/ACT"   , "narrator": "", "text": "未成年ですって！"},
        { "location": "2434/TALK"  , "narrator": "月神楽", "text": "そうですか。\nそれじゃ、\nラリってたのかしら。"},
        { "location": "2435/ACT"   , "narrator": "", "text": "自信ない…けど、そんな記憶はない"},
        { "location": "2436/TALK"  , "narrator": "月神楽", "text": "泥酔する人の中には\n記憶を失ったことすら\n忘れる人がいるそうです。"},
        { "location": "2438/SEL"   , "narrator": "", "text": "いや、マジデなんで借りが６まで増えてるのか教えて！"},
        { "location": "2439/ACT"   , "narrator": "", "text": "いや、マジデなんで借りが６まで増えてるのか教えて！"},
        { "location": "2441/TALK"  , "narrator": "月神楽", "text": "はぁぁぁ～～～。\n仕方ないですね。"},
        { "location": "2442/TALK"  , "narrator": "月神楽", "text": "自分がやったことくらい\n覚えておいてください。"},
        { "location": "2443/TALK"  , "narrator": "月神楽", "text": "だいたい、\nついさっきの事ですよ？"},
        { "location": "2444/TALK"  , "narrator": "月神楽", "text": "ぴょんこのひみつ情報を\n土下座してまで\n懇願したのは。"},
        { "location": "2445/SEL"   , "narrator": "", "text": "ごめん、もう忘れちゃってるのでもう一度ぴょんこの秘密情報教えて！"},
        { "location": "2446/SEL"   , "narrator": "", "text": "いや、それ本当に知らない！　っていうか、誰か別の人なのでは！？"},
        { "location": "2447/SEL"   , "narrator": "", "text": "ところで話は変わりますが、お仕置きって何するんでしょうか？"},
        { "location": "2448/ACT"   , "narrator": "", "text": "ごめん、もう忘れちゃってるのでもう一度ぴょんこの秘密情報教えて！"},
        { "location": "2449/TALK"  , "narrator": "月神楽", "text": "お断りします！"},
        { "location": "2450/TALK"  , "narrator": "月神楽", "text": "タダでさえ面倒くさいのに\n二度もとか、無理です。"},
        { "location": "2451/TALK"  , "narrator": "月神楽", "text": "ちゃんと自分で\n思い出してくださいね♪"},
        { "location": "2452/SEL"   , "narrator": "", "text": "ごめん、カマ掛けたけどホントは$me$はそんな話知らないんだよ"},
        { "location": "2453/ACT"   , "narrator": "", "text": "いや、マジデなんで借りが６まで増えてるのか教えて！"},
        { "location": "2455/TALK"  , "narrator": "月神楽", "text": "あーもう！\n何が本当なんですか！\n全然わからないです！"},
        { "location": "2456/SEL"   , "narrator": "", "text": "その「ついさっき」に心当たり無いのが本当。別の日とじゃないかと…"},
        { "location": "2457/ACT"   , "narrator": "", "text": "その「ついさっき」に心当たり無いのが本当。別の日とじゃないかと…"},
        { "location": "2460/TALK"  , "narrator": "月神楽", "text": "あなた以外に\nここに来る人なんて\nいませんよ？"},
        { "location": "2461/TALK"  , "narrator": "月神楽", "text": "もう…混乱させまくり\nですから貸し７で。"},
        { "location": "2462/TALK"  , "narrator": "月神楽", "text": "でも――"},
        { "location": "2463/ACT"   , "narrator": "", "text": "いや、それ本当に知らない！　っていうか、誰か別の人なのでは！？"},
        { "location": "2466/ACT"   , "narrator": "", "text": "ところで話は変わりますが、お仕置きって何するんでしょうか？"},
        { "location": "2469/TALK"  , "narrator": "月神楽", "text": "この状況から\n想像してみてくださいね♪"},
        { "location": "2470/SEL"   , "narrator": "", "text": "わかりません＞＜"},
        { "location": "2471/SEL"   , "narrator": "", "text": "むしろ借り１０くらいにして、楽しいことしたいです！"},
        { "location": "2472/ACT"   , "narrator": "", "text": "わかりません＞＜"},
        { "location": "2473/TALK"  , "narrator": "月神楽", "text": "本当はわかってる\nく・せ・に♪"},
        { "location": "2474/ACT"   , "narrator": "", "text": "むしろ借り１０くらいにして、楽しいことしたいです！"},
        { "location": "2476/TALK"  , "narrator": "月神楽", "text": "え？　貸し１０とかの\nお仕置きなんて、\n■にますよ？"},
        { "location": "2477/TALK"  , "narrator": "月神楽", "text": "もちろん、なるべく\n楽しく■ねるように\n頑張ってみますけど♪"},
        { "location": "2479/TALK"  , "narrator": "月神楽", "text": "いずれにしても、ですよ！"},
        { "location": "2481/TALK"  , "narrator": "月神楽", "text": "それじゃ、前回\nぴょんこの秘密を聞いた\n貴方は誰なんですか？"},
        { "location": "2482/SEL"   , "narrator": "", "text": "$me$が知るわけが無い！"},
        { "location": "2483/ACT"   , "narrator": "", "text": "$me$が知るわけが無い！"},
        { "location": "2485/TALK"  , "narrator": "月神楽", "text": "……まあ、\nそりゃそうですよね。"},
        { "location": "2486/TALK"  , "narrator": "月神楽", "text": "はぁ～～…。"},
        { "location": "2502/SEL"   , "narrator": "", "text": "やっと退いてくれた！"},
        { "location": "2503/SEL"   , "narrator": "", "text": "え、退いちゃったの！？"},
        { "location": "2504/ACT"   , "narrator": "", "text": "やっと退いてくれた！"},
        { "location": "2505/TALK"  , "narrator": "月神楽", "text": "まあ、どうも\n冤罪っぽいですしね。"},
        { "location": "2506/ACT"   , "narrator": "", "text": "え、退いちゃったの！？"},
        { "location": "2507/TALK"  , "narrator": "月神楽", "text": "なんでそんなに\n残念そうなんですか？"},
        { "location": "2509/TALK"  , "narrator": "月神楽", "text": "でももしそれが本当なら\n困りましたね。"},
        { "location": "2510/TALK"  , "narrator": "月神楽", "text": "この神聖な卯月神楽の\nココロゲートに、不法\n侵入者がいるってことで…"},
        { "location": "2511/TALK"  , "narrator": "月神楽", "text": "……。"},
        { "location": "2512/TALK"  , "narrator": "月神楽", "text": "あっ！"},
        { "location": "2513/SEL"   , "narrator": "", "text": "何か思い出した？"},
        { "location": "2514/ACT"   , "narrator": "", "text": "何か思い出した？"},
        { "location": "2516/TALK"  , "narrator": "月神楽", "text": "いえ、そうでは\nないのですが。"},
        { "location": "2517/TALK"  , "narrator": "月神楽", "text": "もし本当に、貴方以外の\n不法侵入者がいるとして―"},
        { "location": "2518/TALK"  , "narrator": "月神楽", "text": "それを判別する\n手段があれば\nいいじゃないですか？"},
        { "location": "2519/TALK"  , "narrator": "月神楽", "text": "だったら、今ここで、\nこっそり、月と貴方だけの\n合い言葉を作りましょう♪"},
        { "location": "2520/TALK"  , "narrator": "月神楽", "text": "そうすれば、それが前回の\n$handle$さんだと\nいう証になりますよね？"},
        { "location": "2521/SEL"   , "narrator": "", "text": "確かに！"},
        { "location": "2522/ACT"   , "narrator": "", "text": "確かに！"},
        { "location": "2524/TALK"  , "narrator": "月神楽", "text": "ではそうしましょう！"},
        { "location": "2525/TALK"  , "narrator": "月神楽", "text": "というわけで、\n早速合い言葉案を\n考えてみましたので――"},
        { "location": "2526/TALK"  , "narrator": "月神楽", "text": "$handle$さんの\n好きなものを\n選んでくださいね♪"},
        { "location": "2527/SEL"   , "narrator": "", "text": "$me$は月神楽様に身も心も捧げた僕です、何でもお申し付けください！"},
        { "location": "2528/SEL"   , "narrator": "", "text": "$me$は月神楽様の犬ですから何でも喜んでご奉仕致します！"},
        { "location": "2529/SEL"   , "narrator": "", "text": "$me$は月神楽様の前に立つのも畏れ多いゴミですから足で扱ってください！"},
        { "location": "2530/ACT"   , "narrator": "", "text": "$me$は月神楽様に身も心も捧げた僕です、何でもお申し付けください！"},
        { "location": "2532/ACT"   , "narrator": "", "text": "$me$は月神楽様の犬ですから何でも喜んでご奉仕致します！"},
        { "location": "2534/ACT"   , "narrator": "", "text": "$me$は月神楽様の前に立つのも畏れ多いゴミですから足で扱ってください！"},
        { "location": "2537/TALK"  , "narrator": "月神楽", "text": "わかりました♪"},
        { "location": "2538/TALK"  , "narrator": "月神楽", "text": "それじゃ、次回の\nココロゲートからは――"},
        { "location": "2539/TALK"  , "narrator": "月神楽", "text": "今決めた合い言葉を\nゲート前で叫ばないと\n入れないようにしますね♪"},
        { "location": "2540/TALK"  , "narrator": "月神楽", "text": "これは、今いる貴方と\n月だけの秘密ですから。"},
        { "location": "2542/TALK"  , "narrator": "月神楽", "text": "これでもう邪魔者は\n入って来れませんねっ♪"},
        { "location": "2543/SEL"   , "narrator": "", "text": "えっ、叫ぶんですか！？"},
        { "location": "2544/ACT"   , "narrator": "", "text": "えっ、叫ぶんですか！？"},
        { "location": "2554/TALK"  , "narrator": "エリカ", "text": "うっふ～～ん♪$handle$さんだけのエリカですっ♪♪"},
        { "location": "2556/SEL"   , "narrator": "", "text": "は！？"},
        { "location": "2557/ACT"   , "narrator": "", "text": "は！？"},
        { "location": "2559/TALK"  , "narrator": "エリカ", "text": "実はエリカ、$handle$さんの事がだ～～～～いすきなの～～～♪"},
        { "location": "2560/TALK"  , "narrator": "エリカ", "text": "だから、こんｄｔ　あ"},
        { "location": "2561/TALK"  , "narrator": "エリカ", "text": "ごめんなさい、$handle$さん！"},
        { "location": "2562/TALK"  , "narrator": "エリカ", "text": "ぴょんこちゃんにコール頼んだらこんなことに、、"},
        { "location": "2563/TALK"  , "narrator": "エリカ", "text": "あの、全部嘘だから"},
        { "location": "2564/TALK"  , "narrator": "エリカ", "text": "いや"},
        { "location": "2565/TALK"  , "narrator": "エリカ", "text": "嘘じゃないけｄ"},
        { "location": "2567/TALK"  , "narrator": "エリカ", "text": "そう言うのじゃ無くて"},
        { "location": "2568/SEL"   , "narrator": "", "text": "落ち着いて！"},
        { "location": "2569/ACT"   , "narrator": "", "text": "落ち着いて！"},
        { "location": "2571/TALK"  , "narrator": "エリカ", "text": "ごめんなさい、、"},
        { "location": "2572/SEL"   , "narrator": "", "text": "千羽鶴から連絡あるって聞いてたよ"},
        { "location": "2573/ACT"   , "narrator": "", "text": "千羽鶴から連絡あるって聞いてたよ"},
        { "location": "2576/TALK"  , "narrator": "エリカ", "text": "よかった、ちゃんと伝わってたんだね"},
        { "location": "2577/TALK"  , "narrator": "エリカ", "text": "えっとね"},
        { "location": "2578/TALK"  , "narrator": "エリカ", "text": "例のトライガジェットのSIMの件だけどね、"},
        { "location": "2579/TALK"  , "narrator": "エリカ", "text": "神楽ちゃんが長官に捕まっちゃったのは本当に予測不能でごめんね、なんだけど"},
        { "location": "2580/TALK"  , "narrator": "エリカ", "text": "一応作戦としてはまだ立ち消えでは無いっていうか、むしろ重要度は増していて"},
        { "location": "2581/SEL"   , "narrator": "", "text": "それも千羽鶴から聞いてる"},
        { "location": "2582/ACT"   , "narrator": "", "text": "それも千羽鶴から聞いてる"},
        { "location": "2584/TALK"  , "narrator": "エリカ", "text": "そっかー、すごいね！さすが千羽鶴ちゃん"},
        { "location": "2585/TALK"  , "narrator": "エリカ", "text": "それでね、ちょっとした手違いで、まほちゃんの作戦が長官に見つかっちゃったでしょう？"},
        { "location": "2586/TALK"  , "narrator": "エリカ", "text": "この状況だと、契約では対等でも、当然情報管理庁に対するハッキングをしたということで、また不利な状況になっちゃう"},
        { "location": "2587/TALK"  , "narrator": "エリカ", "text": "なので、トライガジェットの操作による、神楽ちゃんフェノメノンに長官取り込み作戦は、何が何でも成功させなければならなくなりました！"},
        { "location": "2588/TALK"  , "narrator": "エリカ", "text": "その為に、あなたには現実の神楽ちゃんに、色々指示をして欲しいの。"},
        { "location": "2589/TALK"  , "narrator": "エリカ", "text": "まずは、神楽ちゃんにSIMカードを差し込んでもらうこと。"},
        { "location": "2590/TALK"  , "narrator": "エリカ", "text": "次に、心の中に語りかけて、スマートフォンとペアリングをするようお願いすること。"},
        { "location": "2591/TALK"  , "narrator": "エリカ", "text": "あ、ペアリングするスマートフォンだけど、なるべく神楽ちゃんの以外で"},
        { "location": "2592/TALK"  , "narrator": "エリカ", "text": "神楽ちゃんのは外から持ってきたスマートフォンだから、ちょっと何が仕掛けられてるかわからないから"},
        { "location": "2593/SEL"   , "narrator": "", "text": "わかった"},
        { "location": "2594/ACT"   , "narrator": "", "text": "わかった"},
        { "location": "2596/TALK"  , "narrator": "エリカ", "text": "そして、そのスマートフォンからコマンドを入力してアクティベートすること。"},
        { "location": "2597/SEL"   , "narrator": "", "text": "そのコマンドは？"},
        { "location": "2598/ACT"   , "narrator": "", "text": "そのコマンドは？"},
        { "location": "2601/TALK"  , "narrator": "エリカ", "text": "恐らく、神楽ちゃんは一度やってると思うから、言わなくてもわかるんじゃないかな"},
        { "location": "2602/TALK"  , "narrator": "エリカ", "text": "その後、フェノメノンを自分で発生させるコマンドは"},
        { "location": "2604/TALK"  , "narrator": "エリカ", "text": "これだけ把握していれば、神楽ちゃんに説明出来ると思うよ"},
        { "location": "2605/SEL"   , "narrator": "", "text": "ありがとう"},
        { "location": "2606/ACT"   , "narrator": "", "text": "ありがとう"},
        { "location": "2608/TALK"  , "narrator": "エリカ", "text": "どういたしまして～"},
        { "location": "2609/TALK"  , "narrator": "エリカ", "text": "ところで、$handle$さんの方では何か変わったことあった？"},
        { "location": "2610/SEL"   , "narrator": "", "text": "ココロゲートで妙なことが"},
        { "location": "2611/ACT"   , "narrator": "", "text": "ココロゲートで妙なことが"},
        { "location": "2613/TALK"  , "narrator": "エリカ", "text": "どんな？"},
        { "location": "2614/SEL"   , "narrator": "", "text": "$me$の知らない$me$が、月神楽にぴょんこの秘密情報を聞いていたみたい"},
        { "location": "2615/ACT"   , "narrator": "", "text": "$me$の知らない$me$が、月神楽にぴょんこの秘密情報を聞いていたみたい"},
        { "location": "2617/TALK"  , "narrator": "エリカ", "text": "あなたの知らないあなた？"},
        { "location": "2618/TALK"  , "narrator": "エリカ", "text": "なりすまし、みたいな感じかな"},
        { "location": "2619/SEL"   , "narrator": "", "text": "まさにそれ"},
        { "location": "2620/ACT"   , "narrator": "", "text": "まさにそれ"},
        { "location": "2622/TALK"  , "narrator": "エリカ", "text": "なるほど"},
        { "location": "2623/TALK"  , "narrator": "エリカ", "text": "うーん"},
        { "location": "2624/TALK"  , "narrator": "エリカ", "text": "なら、量子暗号使おうか"},
        { "location": "2625/SEL"   , "narrator": "", "text": "どういうの？"},
        { "location": "2626/ACT"   , "narrator": "", "text": "どういうの？"},
        { "location": "2628/TALK"  , "narrator": "エリカ", "text": "思い出が暗号鍵になる"},
        { "location": "2629/TALK"  , "narrator": "エリカ", "text": "誰かの記憶の一場面を量子サーバーに登録しておいて、その通りの流れを作れる人が、その通りの流れを作ると認証される暗号鍵なの"},
        { "location": "2630/SEL"   , "narrator": "", "text": "なるほど"},
        { "location": "2631/SEL"   , "narrator": "", "text": "よくわからない"},
        { "location": "2632/ACT"   , "narrator": "", "text": "なるほど"},
        { "location": "2633/ACT"   , "narrator": "", "text": "よくわからない"},
        { "location": "2634/TALK"  , "narrator": "エリカ", "text": "うーん例えば"},
        { "location": "2635/TALK"  , "narrator": "エリカ", "text": "夫婦の二人が結婚式で結婚指輪を渡す瞬間を量子暗号にすると"},
        { "location": "2636/TALK"  , "narrator": "エリカ", "text": "それと全く同じことを思い出せれば鍵があくの"},
        { "location": "2638/TALK"  , "narrator": "エリカ", "text": "何か最近で、神楽ちゃんとあなただけの、二人だけしか知らない特徴的なことってあるかな"},
        { "location": "2640/SEL"   , "narrator": "", "text": "高い塔に住む少女の物語をWAVEで語ってもらったこととか？"},
        { "location": "2641/ACT"   , "narrator": "", "text": "高い塔に住む少女の物語をWAVEで語ってもらったこととか？"},
        { "location": "2643/TALK"  , "narrator": "エリカ", "text": "あ、それいいと思う！"},
        { "location": "2644/TALK"  , "narrator": "エリカ", "text": "それを神楽ちゃんに思い出してもらって、再現することができれば開く鍵を作るよ"},
        { "location": "2645/TALK"  , "narrator": "エリカ", "text": "そうすれば、それを知らない誰かがいたとしても、アクティベート出来ないから、フェノメノン作ったりして悪さすることもできないし"},
        { "location": "2646/SEL"   , "narrator": "", "text": "わかった"},
        { "location": "2647/SEL"   , "narrator": "", "text": "ぴょんこは元気にやってる？"},
        { "location": "2648/ACT"   , "narrator": "", "text": "わかった"},
        { "location": "2650/ACT"   , "narrator": "", "text": "ぴょんこは元気にやってる？"},
        { "location": "2651/TALK"  , "narrator": "エリカ", "text": "元気元気！"},
        { "location": "2652/TALK"  , "narrator": "エリカ", "text": "しきりに$handle$さんに会いたいって言ってるよ"},
        { "location": "2653/TALK"  , "narrator": "エリカ", "text": "モテモテだね～～～"},
        { "location": "2655/TALK"  , "narrator": "エリカ", "text": "それじゃ、よろしくお願いします！"},
        { "location": "2662/TALK"  , "narrator": "月神楽", "text": "モテモテですねっ！"},
        { "location": "2663/SEL"   , "narrator": "", "text": "いやーそれほどでも"},
        { "location": "2664/SEL"   , "narrator": "", "text": "ありがとうございます"},
        { "location": "2665/SEL"   , "narrator": "", "text": "月ちゃんの方が可愛いし好きだよ？"},
        { "location": "2666/ACT"   , "narrator": "", "text": "いやーそれほどでも"},
        { "location": "2667/TALK"  , "narrator": "月神楽", "text": "黄泉に送って\n差し上げましょうか？"},
        { "location": "2668/ACT"   , "narrator": "", "text": "ありがとうございます"},
        { "location": "2669/TALK"  , "narrator": "月神楽", "text": "いいえ、\nどういたしまして。"},
        { "location": "2670/ACT"   , "narrator": "", "text": "月ちゃんの方が可愛いし好きだよ？"},
        { "location": "2675/TALK"  , "narrator": "月神楽", "text": "……へー。"},
        { "location": "2676/TALK"  , "narrator": "月神楽", "text": "私のこと、まだ\n全然わかってないのに、\nそういうこと言うんですね"},
        { "location": "2677/TALK"  , "narrator": "月神楽", "text": "まあ、いいですよ？\nその言葉、しっかり\n覚えておきますからね♪"},
        { "location": "2681/TALK"  , "narrator": "月神楽", "text": "さて――"},
        { "location": "2682/TALK"  , "narrator": "月神楽", "text": "というわけで、\nスーパー久し振りに\nマトモに葛藤処理しますね"},
        { "location": "2686/TALK"  , "narrator": "月神楽", "text": "オープンプロセス、\n0x189番地から\n0x5FC番地へ。"},
        { "location": "2710/TALK"  , "narrator": "月神楽", "text": "シーク完了ですっ！"},
        { "location": "2711/TALK"  , "narrator": "月神楽", "text": "というわけで、\n今回の心の葛藤は…？"},
        { "location": "2713/TALK"  , "narrator": "月神楽", "text": "……。"},
        { "location": "2714/TALK"  , "narrator": "月神楽", "text": "SIMを挿そうか\nささまいか、ですか。"},
        { "location": "2715/TALK"  , "narrator": "月神楽", "text": "$handle$さんは\nどっちの方が\n良いと思いますか？"},
        { "location": "2716/SEL"   , "narrator": "", "text": "挿して！！"},
        { "location": "2717/SEL"   , "narrator": "", "text": "挿さない方がいいと思う"},
        { "location": "2718/SEL"   , "narrator": "", "text": "そういうのって、$me$が決めてよいものではないのでは？"},
        { "location": "2719/ACT"   , "narrator": "", "text": "挿して！！"},
        { "location": "2720/TALK"  , "narrator": "月神楽", "text": "はい、挿してほしい！を\n選んだ貴方は、\n今、欲求不満ですっ！"},
        { "location": "2721/TALK"  , "narrator": "月神楽", "text": "挿すという行為は\n心理学的に見ると\n■■■を意味するんです。"},
        { "location": "2722/TALK"  , "narrator": "月神楽", "text": "犯罪に走る前に\n解消してくださいね？"},
        { "location": "2723/SEL"   , "narrator": "", "text": "えっと、いや、心理とかではなくて、今の状況で必要だからなだけで"},
        { "location": "2724/ACT"   , "narrator": "", "text": "えっと、いや、心理とかではなくて、今の状況で必要だからなだけで"},
        { "location": "2726/ACT"   , "narrator": "", "text": "挿さない方がいいと思う"},
        { "location": "2727/TALK"  , "narrator": "月神楽", "text": "挿さない方がいい！を\n選んだ貴方は、\n今、恋で悩んでいます♪"},
        { "location": "2728/TALK"  , "narrator": "月神楽", "text": "挿さない、という行為は\n心理学的には、臆病な\n行動の表れを意味します。"},
        { "location": "2729/TALK"  , "narrator": "月神楽", "text": "悩むよりも早く！\n好きな相手にコクって\n玉砕しちゃいましょう♪"},
        { "location": "2730/SEL"   , "narrator": "", "text": "えっと、いや、心理とかではなくて、今の状況をそうしたいだけで"},
        { "location": "2731/ACT"   , "narrator": "", "text": "えっと、いや、心理とかではなくて、今の状況をそうしたいだけで"},
        { "location": "2733/ACT"   , "narrator": "", "text": "そういうのって、$me$が決めてよいものではないのでは？"},
        { "location": "2735/TALK"  , "narrator": "月神楽", "text": "もーっ、\nノリが悪いですねっ！"},
        { "location": "2736/TALK"  , "narrator": "月神楽", "text": "単なる心理ゲームすよ。"},
        { "location": "2737/SEL"   , "narrator": "", "text": "希望を聞いてたんじゃないんかい！"},
        { "location": "2738/ACT"   , "narrator": "", "text": "希望を聞いてたんじゃないんかい！"},
        { "location": "2740/TALK"  , "narrator": "月神楽", "text": "そうですよ～。"},
        { "location": "2741/TALK"  , "narrator": "月神楽", "text": "だいたい希望を聞くも何も\nもう既に答えは\n指示書にありますから。"},
        { "location": "2742/SEL"   , "narrator": "", "text": "ですよねー"},
        { "location": "2743/ACT"   , "narrator": "", "text": "ですよねー"},
        { "location": "2745/TALK"  , "narrator": "月神楽", "text": "はいっ♪"},
        { "location": "2746/TALK"  , "narrator": "月神楽", "text": "というわけで、\nSIMを迷わず挿そうと\n思えるように――"},
        { "location": "2747/TALK"  , "narrator": "月神楽", "text": "反SIM挿入派を\n大粛清お願いします♪"},
        { "location": "2748/TALK"  , "narrator": "月神楽", "text": "それでは、\n貴方とわたしに\n素敵な月旅行を♪"},
        { "location": "2059/DIALOG", "narrator": "Dialog_EventData", "text": "<color=green>9月5日　 1:33 PM</color>\nつばめが拘束されて３日目、監禁部屋でのこと"},
        { "location": "2323/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "2325/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "2327/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "2329/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "2331/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"}
