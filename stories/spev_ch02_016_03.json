    "entry":
    [
        { "location": "235/SCENARIO", "narrator": "", "text": "いつか空になる"},
        { "location": "237/TALK"    , "narrator": "アーヤ", "text": "うふふーー"},
        { "location": "238/TALK"    , "narrator": "アーヤ", "text": "そういうことなら任せて！"},
        { "location": "239/TALK"    , "narrator": "アーヤ", "text": "やっぱり空が違うのよ"},
        { "location": "240/TALK"    , "narrator": "アーヤ", "text": "長野は"},
        { "location": "242/SEL"     , "narrator": "", "text": "田舎なんだね"},
        { "location": "243/SEL"     , "narrator": "", "text": "そうなんだ"},
        { "location": "244/SEL"     , "narrator": "", "text": "いいところなんだろうね"},
        { "location": "245/ACT"     , "narrator": "", "text": "田舎なんだね"},
        { "location": "246/TALK"    , "narrator": "アーヤ", "text": "何よ（｀皿´ )"},
        { "location": "247/TALK"    , "narrator": "アーヤ", "text": "その言い方"},
        { "location": "248/ACT"     , "narrator": "", "text": "そうなんだ"},
        { "location": "249/TALK"    , "narrator": "アーヤ", "text": "そうなのよ"},
        { "location": "250/TALK"    , "narrator": "アーヤ", "text": "不思議よね"},
        { "location": "251/ACT"     , "narrator": "", "text": "いいところなんだろうね"},
        { "location": "252/TALK"    , "narrator": "アーヤ", "text": "もちろん"},
        { "location": "253/TALK"    , "narrator": "アーヤ", "text": "いいところよ"},
        { "location": "254/TALK"    , "narrator": "アーヤ", "text": "だから"},
        { "location": "255/TALK"    , "narrator": "アーヤ", "text": "$handle$さんにも"},
        { "location": "256/TALK"    , "narrator": "アーヤ", "text": "来て欲しいわ"},
        { "location": "257/TALK"    , "narrator": "アーヤ", "text": "機会があれば"},
        { "location": "259/TALK"    , "narrator": "アーヤ", "text": "剣道をしてたころ"},
        { "location": "260/TALK"    , "narrator": "アーヤ", "text": "海外試合なんかもあって"},
        { "location": "261/TALK"    , "narrator": "アーヤ", "text": "結構行ったわ"},
        { "location": "263/SEL"     , "narrator": "", "text": "そんなことがあったんだ"},
        { "location": "264/SEL"     , "narrator": "", "text": "もう行かないの？"},
        { "location": "265/SEL"     , "narrator": "", "text": "次は$me$とのハネムーンの時だね"},
        { "location": "266/ACT"     , "narrator": "", "text": "そんなことがあったんだ"},
        { "location": "268/TALK"    , "narrator": "アーヤ", "text": "高校のころの話よ"},
        { "location": "269/ACT"     , "narrator": "", "text": "もう行かないの？"},
        { "location": "271/TALK"    , "narrator": "アーヤ", "text": "そうね"},
        { "location": "272/ACT"     , "narrator": "", "text": "次は$me$とのハネムーンの時だね"},
        { "location": "273/TALK"    , "narrator": "アーヤ", "text": "そうね"},
        { "location": "274/TALK"    , "narrator": "アーヤ", "text": "どこに連れて行ってくれるのかしら"},
        { "location": "275/TALK"    , "narrator": "アーヤ", "text": "$handle$さんは"},
        { "location": "277/TALK"    , "narrator": "アーヤ", "text": "なんとなく"},
        { "location": "278/TALK"    , "narrator": "アーヤ", "text": "空の色が違う気がするの"},
        { "location": "279/TALK"    , "narrator": "アーヤ", "text": "世界中どこもみんな"},
        { "location": "281/TALK"    , "narrator": "アーヤ", "text": "実際は"},
        { "location": "282/TALK"    , "narrator": "アーヤ", "text": "空なんかより"},
        { "location": "283/TALK"    , "narrator": "アーヤ", "text": "食べ物とかの違いが"},
        { "location": "284/TALK"    , "narrator": "アーヤ", "text": "結構辛かったりしたけど"},
        { "location": "286/TALK"    , "narrator": "アーヤ", "text": "なんとなく"},
        { "location": "287/TALK"    , "narrator": "アーヤ", "text": "思い出しちゃった"}
    ]
}
