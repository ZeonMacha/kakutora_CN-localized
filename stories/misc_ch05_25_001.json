        { "location": "8464/ACT"     , "narrator": "", "text": "意外と生々しいことを"},
        { "location": "8465/TALK"    , "narrator": "神楽", "text": "そうかな？"},
        { "location": "8466/TALK"    , "narrator": "神楽", "text": "わかると楽しいことも結構あるぴょん"},
        { "location": "8468/TALK"    , "narrator": "神楽", "text": "本当にすごい手品はタネを知ってても驚いちゃうみたいにね★"},
        { "location": "8469/ACT"     , "narrator": "", "text": "マーケティング関連の人だっけ？"},
        { "location": "8470/TALK"    , "narrator": "神楽", "text": "一介のＪＫぴょん"},
        { "location": "8471/TALK"    , "narrator": "神楽", "text": "でもそっち方面に進むのも楽しいかもね♪"},
        { "location": "8472/ACT"     , "narrator": "", "text": "高い＝おいしいじゃないの？"},
        { "location": "8473/TALK"    , "narrator": "神楽", "text": "近似値を取るけどイコールにはならないぴょん"},
