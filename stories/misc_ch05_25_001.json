        { "location": "8451/ACT"     , "narrator": "", "text": "最高級品を神楽にあげるよ"},
        { "location": "8453/TALK"    , "narrator": "神楽", "text": "やだ$handle$ったら（トゥンク"},
        { "location": "8454/TALK"    , "narrator": "神楽", "text": "じゃあフランスに行って買い付けて来てね☆彡"},
        { "location": "8455/TALK"    , "narrator": "神楽", "text": "ぴょんこ期待して待ってる！"},
        { "location": "8457/TALK"    , "narrator": "神楽", "text": "材料はもちろんだけどやっぱり職人の腕？"},
        { "location": "8458/TALK"    , "narrator": "神楽", "text": "あとブランディングとかだよね"},
        { "location": "8459/TALK"    , "narrator": "神楽", "text": "お値段に比例する内容は"},
        { "location": "8461/SEL"     , "narrator": "", "text": "意外と生々しいことを"},
        { "location": "8462/SEL"     , "narrator": "", "text": "マーケティング関連の人だっけ？"},
