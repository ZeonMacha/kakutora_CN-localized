{
    "dir": "chap28/daydra/dd_ch03_28_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "28305",
        "cid": "gabriella",
        "title": "005 メインストーリー",
        "sub_title": "蝶々のささやき＜後編＞"
    },
    "entry":
    [
        { "location": "473/SCENARIO", "narrator": "", "text": "波紋の終結"},
        { "location": "496/TALK"    , "narrator": "ガブリエラ", "text": "いけない、あたしったら\nデリカシーのない事ばかり\n聞いちゃって！"},
        { "location": "497/TALK"    , "narrator": "ガブリエラ", "text": "アーヤを励ましてって\n頼まれてたのに。\nこれじゃ逆効果だわ。"},
        { "location": "498/TALK"    , "narrator": "ガブリエラ", "text": "ちょっと\n落ち着かなくちゃ。"},
        { "location": "499/TALK"    , "narrator": "ガブリエラ", "text": "ア、アーヤもすごい\n大変な中、頑張って\nきたのね。ビックリだわ！"},
        { "location": "500/TALK"    , "narrator": "アーヤ", "text": "まあ、そんな\n大げさに言われる程\n大変でもないけどね…。"},
        { "location": "501/TALK"    , "narrator": "アーヤ", "text": "でも確かに、\nあの時の事件が無ければ\n全然違ったとは思うわね。"},
        { "location": "502/TALK"    , "narrator": "ガブリエラ", "text": "あの時の事件…って…？"},
        { "location": "503/TALK"    , "narrator": "アーヤ", "text": "父は次男でね。\nこの家を継ぐか\nどうかで揉めたのよ。"},
        { "location": "504/TALK"    , "narrator": "ガブリエラ", "text": "そうなの？"},
        { "location": "506/TALK"    , "narrator": "アーヤ", "text": "國政家はどうも\n第一子が自由奔放に\n育つみたいで。"},
        { "location": "507/TALK"    , "narrator": "アーヤ", "text": "業を煮やした祖父が\n長男には継がせないって\n宣言して。"},
        { "location": "508/TALK"    , "narrator": "アーヤ", "text": "次男にお鉢が回って来たん\nだけど、父は既に婿養子に\n入るって話が出てて。"},
        { "location": "509/TALK"    , "narrator": "アーヤ", "text": "結局私の父が神社を\n継ぐことで決着したけど。"},
        { "location": "510/TALK"    , "narrator": "アーヤ", "text": "その話し合いの結果次第\nでは、私は國政綾水では\nなかったかもしれないの。"},
        { "location": "511/TALK"    , "narrator": "アーヤ", "text": "まあ、そもそも\n家の事情も変わるし、\n生まれてないかもだけど。"},
        { "location": "512/TALK"    , "narrator": "ガブリエラ", "text": "ふーん。もしお父様が\n婿養子？になってたら、\nどんな名前になってたの？"},
        { "location": "513/TALK"    , "narrator": "アーヤ", "text": "結城綾水？\n母方の名字が\n結城だから。"},
        { "location": "514/TALK"    , "narrator": "アーヤ", "text": "まあ、名前も\n変わってたかも\nしれないけど。"},
        { "location": "515/TALK"    , "narrator": "ガブリエラ", "text": "そうだったのね。"},
        { "location": "517/TALK"    , "narrator": "ガブリエラ", "text": "でも、ゆーきあやみって\nなんかちょっと\n響きがオシャレかも。"},
        { "location": "518/TALK"    , "narrator": "アーヤ", "text": "そう？\n私にはよく\nわからないけど。"},
        { "location": "519/TALK"    , "narrator": "アーヤ", "text": "しかもね。長男に\n継がせないって話も\n理由がひどくて。"},
        { "location": "520/TALK"    , "narrator": "アーヤ", "text": "５分遅刻したんだって。\nすごく重要な祭事に。\n祭主を任されてたのに。"},
        { "location": "521/TALK"    , "narrator": "アーヤ", "text": "きっとそれ以前の\n色々が積み重なっての\nことだろうけど。"},
        { "location": "523/TALK"    , "narrator": "ガブリエラ", "text": "じゃあその日、アーヤの\nお父さんのお兄さんが、\n５分早く着いてたら…。"},
        { "location": "524/TALK"    , "narrator": "アーヤ", "text": "私は結城の人間だったかも\nしれないし、生まれて\nなかったかもしれない。"},
        { "location": "525/SEL"     , "narrator": "", "text": "バタフライエフェクトだ"},
        { "location": "526/SEL"     , "narrator": "", "text": "何故かわからないけど今$me$は感極まっている"},
        { "location": "527/ACT"     , "narrator": "", "text": "バタフライエフェクトだ"},
        { "location": "545/TALK"    , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "546/TALK"    , "narrator": "ガブリエラ", "text": "本当にそう"},
        { "location": "547/ACT"     , "narrator": "", "text": "何故かわからないけど今$me$は感極まっている"},
        { "location": "565/TALK"    , "narrator": "ガブリエラ", "text": "ええ！？！？"},
        { "location": "567/TALK"    , "narrator": "ガブリエラ", "text": "どうしちゃったの！？"},
        { "location": "568/TALK"    , "narrator": "ガブリエラ", "text": "今アーヤ、何か感動的な話をしたかしら"},
        { "location": "569/TALK"    , "narrator": "ガブリエラ", "text": "いや、私にとってはちょっとだけ感動的だったけど//"},
        { "location": "570/TALK"    , "narrator": "ガブリエラ", "text": "$marzanna$も共感してくれたのかしらね？"},
        { "location": "583/TALK"    , "narrator": "アーヤ", "text": "神社の娘に生まれる\nこともなくて\n霊の怖さも知らなくて。"},
        { "location": "584/TALK"    , "narrator": "アーヤ", "text": "跡継ぎ問題で\n悩んだりもしない\n普通の家で育って。"},
        { "location": "585/TALK"    , "narrator": "アーヤ", "text": "トライナリーになって\nなくて、剣道もして\nなかったかもしれない。"},
        { "location": "587/TALK"    , "narrator": "ガブリエラ", "text": "そしたら、あたしとも\n逢えなかったわね。"},
        { "location": "588/TALK"    , "narrator": "アーヤ", "text": "そうねー。"},
        { "location": "590/TALK"    , "narrator": "アーヤ", "text": "…それはそれで、\n寂しいわね。"},
        { "location": "591/TALK"    , "narrator": "ガブリエラ", "text": "何か言った？"},
        { "location": "596/TALK"    , "narrator": "アーヤ", "text": "いいえ？　何も。"},
        { "location": "598/TALK"    , "narrator": "ガブリエラ", "text": "アーヤには悪いけど…\nお父様のお兄さんに\n感謝だわね。"},
        { "location": "601/TALK"    , "narrator": "アーヤ", "text": "何か言った？"},
        { "location": "605/TALK"    , "narrator": "ガブリエラ", "text": "いいえ？　何も。"},
        { "location": "606/TALK"    , "narrator": "アーヤ", "text": "……ありがと、ギャヴィ。"},
        { "location": "609/TALK"    , "narrator": "アーヤ", "text": "色々話をしてたら、\nちょっと元気が\n出てきたわ。"},
        { "location": "610/TALK"    , "narrator": "アーヤ", "text": "本当のことを言うとね。"},
        { "location": "611/TALK"    , "narrator": "アーヤ", "text": "姉と会えないって\nわかってすごく\nがっかりしたの。"},
        { "location": "612/TALK"    , "narrator": "アーヤ", "text": "自分でもびっくりしたけど\n少しだけ泣いたの。"},
        { "location": "613/TALK"    , "narrator": "アーヤ", "text": "だけどギャヴィと\n話してて気持ちの整理が\nついたみたい。"},
        { "location": "614/TALK"    , "narrator": "アーヤ", "text": "ギャヴィがいてくれて\nよかったわ。"},
        { "location": "617/TALK"    , "narrator": "ガブリエラ", "text": "…べ、別に……\nあたし何も……。"},
        { "location": "618/SEL"     , "narrator": "", "text": "結果オーライだ"},
        { "location": "619/SEL"     , "narrator": "", "text": "一件落着かな"},
        { "location": "620/SEL"     , "narrator": "", "text": "盛大なるツンデレ合戦！"},
        { "location": "621/ACT"     , "narrator": "", "text": "結果オーライだ"},
        { "location": "639/TALK"    , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "640/TALK"    , "narrator": "ガブリエラ", "text": "アーヤが泣いたなんて"},
        { "location": "641/TALK"    , "narrator": "ガブリエラ", "text": "少し意外だけど"},
        { "location": "642/TALK"    , "narrator": "ガブリエラ", "text": "そんな一面もあるのね"},
        { "location": "643/TALK"    , "narrator": "ガブリエラ", "text": "そんな面が見れるなんて"},
        { "location": "644/TALK"    , "narrator": "ガブリエラ", "text": "役得かもしれないわｖｖｖ"},
        { "location": "645/ACT"     , "narrator": "", "text": "一件落着かな"},
        { "location": "663/TALK"    , "narrator": "ガブリエラ", "text": "そういうことね"},
        { "location": "664/TALK"    , "narrator": "ガブリエラ", "text": "よかったわ"},
        { "location": "665/TALK"    , "narrator": "ガブリエラ", "text": "本当に"},
        { "location": "666/ACT"     , "narrator": "", "text": "盛大なるツンデレ合戦！"},
        { "location": "684/TALK"    , "narrator": "ガブリエラ", "text": "あんまり"},
        { "location": "685/TALK"    , "narrator": "ガブリエラ", "text": "からかわないで////////"},
        { "location": "686/TALK"    , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "687/TALK"    , "narrator": "ガブリエラ", "text": "ありがとうｖｖｖ"},
        { "location": "713/DIALOG"  , "narrator": "Dialog_chapter_ch03", "text": "【23 エクセプション】"}
    ]
}
