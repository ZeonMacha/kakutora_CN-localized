    "entry":
    [
        { "location": "86/SCENARIO", "narrator": "", "text": "023_歌っちゃおう！"},
        { "location": "111/TALK"   , "narrator": "アーヤ", "text": "泣きたくないから"},
        { "location": "112/TALK"   , "narrator": "アーヤ", "text": "歌っちゃおう"},
        { "location": "114/SEL"    , "narrator": "", "text": "何かの歌詞？"},
        { "location": "115/SEL"    , "narrator": "", "text": "どうしたの一体"},
        { "location": "116/SEL"    , "narrator": "", "text": "$me$がここにいるよ"},
        { "location": "117/ACT"    , "narrator": "", "text": "何かの歌詞？"},
        { "location": "118/TALK"   , "narrator": "アーヤ", "text": "やっぱり"},
        { "location": "119/TALK"   , "narrator": "アーヤ", "text": "わかっちゃう？"},
        { "location": "120/ACT"    , "narrator": "", "text": "どうしたの一体"},
        { "location": "121/TALK"   , "narrator": "アーヤ", "text": "たいしたことじゃないの"},
        { "location": "122/ACT"    , "narrator": "", "text": "$me$がここにいるよ"},
        { "location": "124/TALK"   , "narrator": "アーヤ", "text": "そうね"},
        { "location": "125/TALK"   , "narrator": "アーヤ", "text": "なんて"},
        { "location": "126/TALK"   , "narrator": "アーヤ", "text": "申告な話じゃないわよ"},
        { "location": "127/TALK"   , "narrator": "アーヤ", "text": "深刻"},
        { "location": "129/TALK"   , "narrator": "アーヤ", "text": "悲しいことがあっても"},
        { "location": "130/TALK"   , "narrator": "アーヤ", "text": "鳴くより笑った方がいいって説があるのよ"},
        { "location": "132/SEL"    , "narrator": "", "text": "ピヨピヨ"},
        { "location": "133/SEL"    , "narrator": "", "text": "泣く、でしょ？"},
        { "location": "134/SEL"    , "narrator": "", "text": "泣いてリセットするのも手だよ"},
        { "location": "135/ACT"    , "narrator": "", "text": "ピヨピヨ"},
        { "location": "136/TALK"   , "narrator": "アーヤ", "text": "え？"},
        { "location": "138/TALK"   , "narrator": "アーヤ", "text": "って"},
        { "location": "140/TALK"   , "narrator": "アーヤ", "text": "空気読んでよ\n（ノ ﾟДﾟ）ノ\n　　＝＝＝＝　┻━━┻ "},
        { "location": "141/ACT"    , "narrator": "", "text": "泣く、でしょ？"},
        { "location": "144/TALK"   , "narrator": "アーヤ", "text": "そうよ"},
        { "location": "145/TALK"   , "narrator": "アーヤ", "text": "あ"},
        { "location": "146/TALK"   , "narrator": "アーヤ", "text": "なるほど"},
        { "location": "147/ACT"    , "narrator": "", "text": "泣いてリセットするのも手だよ"},
        { "location": "149/TALK"   , "narrator": "アーヤ", "text": "そうね"},
        { "location": "151/TALK"   , "narrator": "アーヤ", "text": "すごく悲しくて笑えないことが起こった時は"},
        { "location": "152/TALK"   , "narrator": "アーヤ", "text": "そっちの方が絶対いいわ"},
        { "location": "153/TALK"   , "narrator": "アーヤ", "text": "本当に"},
        { "location": "161/TALK"   , "narrator": "アーヤ", "text": "もうさすがに"},
        { "location": "162/TALK"   , "narrator": "アーヤ", "text": "子供の頃みたいな泣き方はしないけど"},
        { "location": "163/TALK"   , "narrator": "アーヤ", "text": "笑えない時は"},
        { "location": "164/TALK"   , "narrator": "アーヤ", "text": "楽しい歌を歌うのもいいかもね"}
    ]
}
