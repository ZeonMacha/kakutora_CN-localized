    "info": {
        "story_id": "91034",
        "cid": "",
        "title": "ぴょんこのサマー大作戦♪",
        "sub_title": "ぴょんこのサマー大作戦♪④【つばめ編】"
    },
    "entry":
    [
        { "location": "19/DIALOG", "narrator": "", "text": "<color=green>7月23日　2:16 PM</color>\nとある休日の午後、都内某カフェにて。"},
        { "location": "20/TALK"  , "narrator": "神楽", "text": "…最後の一本は、\n…から初めて、最後は…。"},
        { "location": "22/TALK"  , "narrator": "神楽", "text": "…………ふぅ。"},
        { "location": "24/TALK"  , "narrator": "神楽", "text": "よし…ネームだけど、\nとりあえず全部完成！"},
        { "location": "26/TALK"  , "narrator": "神楽", "text": "…途中、何度もネタに\n詰まって諦めかけて\nしまいましたけど。"},
        { "location": "27/TALK"  , "narrator": "神楽", "text": "でも、皆さんを観察して\nネタ集めしたおかげで、\nどうにか完成しました！"},
        { "location": "28/TALK"  , "narrator": "神楽", "text": "あとは家に帰ってから、\nＰＣで清書すれば…。"},
        { "location": "29/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "30/TALK"  , "narrator": "神楽", "text": "ふふっ…でも、\nまさか本当に\n描き切れるなんて…。"},
        { "location": "31/TALK"  , "narrator": "神楽", "text": "これなら、この次の\nイベントでは\nストーリー漫画も――"},
        { "location": "32/TALK"  , "narrator": "つばめ", "text": "あれ？"},
        { "location": "35/TALK"  , "narrator": "つばめ", "text": "卯月さーん。"},
        { "location": "37/TALK"  , "narrator": "神楽", "text": "えっ、つばめさん！？"},
        { "location": "38/TALK"  , "narrator": "神楽", "text": "な、なんでこんな時に！？"},
        { "location": "43/TALK"  , "narrator": "つばめ", "text": "奇遇だね。\n卯月さんも\nお茶しに来てたの？"},
        { "location": "45/TALK"  , "narrator": "神楽", "text": "あ、えと…はい…。"},
        { "location": "46/TALK"  , "narrator": "つばめ", "text": "そうなんだ？\nここ、一緒に\n座ってもいい？"},
        { "location": "48/TALK"  , "narrator": "神楽", "text": "あ、はい。\nもちろん――"},
        { "location": "49/TALK"  , "narrator": "神楽", "text": "って、いけない！\nノート隠さなきゃ！"},
        { "location": "56/TALK"  , "narrator": "つばめ", "text": "あれ？\n今のノートって…。"},
        { "location": "57/TALK"  , "narrator": "神楽", "text": "さあ、どうぞ！\n早く座ってください！"},
        { "location": "59/TALK"  , "narrator": "つばめ", "text": "あ、うん…。"},
        { "location": "72/TALK"  , "narrator": "つばめ", "text": "ごめんね。\nのんびりしてるところ\n邪魔しちゃったみたいで。"},
        { "location": "73/TALK"  , "narrator": "神楽", "text": "いえ、そんなこと\nないですよ。"},
        { "location": "74/TALK"  , "narrator": "神楽", "text": "つばめさんと一緒の\nティータイムなんて、\nむしろご褒美です！"},
        { "location": "75/TALK"  , "narrator": "つばめ", "text": "ふふっ、卯月さんって\nいっつも面白いこと\n言うよね。"},
        { "location": "76/TALK"  , "narrator": "神楽", "text": "あはは…。"},
        { "location": "77/TALK"  , "narrator": "つばめ", "text": "ところで、さっき見てた\nノートだけど、\nあれって…。"},
        { "location": "78/TALK"  , "narrator": "神楽", "text": "ふ、復習です！"},
        { "location": "79/TALK"  , "narrator": "つばめ", "text": "復習？"},
        { "location": "80/TALK"  , "narrator": "神楽", "text": "そうなんです。\nこの前の授業の内容が\n難しかったので…。"},
        { "location": "81/TALK"  , "narrator": "神楽", "text": "だから、お茶しながら\n見直そうかな、って\n思ってたんです。"},
        { "location": "82/TALK"  , "narrator": "つばめ", "text": "じゃあ、あのノートは\n学校のノートだったの？"},
        { "location": "84/TALK"  , "narrator": "神楽", "text": "そうです！\n普通の大学ノート\nだったでしょう？"},
        { "location": "85/TALK"  , "narrator": "つばめ", "text": "そうだったけど…。"},
        { "location": "86/TALK"  , "narrator": "つばめ", "text": "チラッとだけど、\n漫画が描いてあるように\n見えたんだけど…。"},
        { "location": "87/TALK"  , "narrator": "神楽", "text": "本当、授業が難しいと\n大変ですよね。"},
        { "location": "88/TALK"  , "narrator": "つばめ", "text": "う、うん…。"},
        { "location": "89/TALK"  , "narrator": "神楽", "text": "ネーム…もしかして\n見られたかも？"},
        { "location": "90/TALK"  , "narrator": "神楽", "text": "でも、全然聞いてこない\nってことは、見られて\nない可能性もありますね。"},
        { "location": "91/TALK"  , "narrator": "神楽", "text": "…うん、そうです…。\n絶対見られてないはず！"},
        { "location": "92/TALK"  , "narrator": "神楽", "text": "だって、見られないように\nすぐしまったんだし…。"},
        { "location": "93/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "95/TALK"  , "narrator": "つばめ", "text": "もしかして、\n本当に勘違いなのかな？"},
        { "location": "96/SEL"   , "narrator": "（選択肢）", "text": "ぴょんこ先生って言ってみよう"},
        { "location": "97/SEL"   , "narrator": "（選択肢）", "text": "神楽の薄い本"},
        { "location": "98/SEL"   , "narrator": "（選択肢）", "text": "お絵かきの趣味はまだ秘密？"},
        { "location": "99/ACT"   , "narrator": "", "text": "ぴょんこ先生って言ってみよう"},
        { "location": "110/TALK" , "narrator": "つばめ", "text": "ぴょんこ先生？(´･ω･｀) "},
        { "location": "111/TALK" , "narrator": "つばめ", "text": "なんで？(･Д･｀)"},
        { "location": "113/SEL"  , "narrator": "（選択肢）", "text": "神楽の反応見ればわかるはず"},
        { "location": "114/ACT"  , "narrator": "", "text": "神楽の反応見ればわかるはず"},
        { "location": "116/TALK" , "narrator": "つばめ", "text": "よくわからなぃけど"},
        { "location": "117/TALK" , "narrator": "つばめ", "text": "言ぅ通りにするね"},
        { "location": "123/TALK" , "narrator": "つばめ", "text": "えっと…。"},
        { "location": "124/TALK" , "narrator": "つばめ", "text": "ぴょんこ先生！"},
        { "location": "126/TALK" , "narrator": "神楽", "text": "…………？"},
        { "location": "127/TALK" , "narrator": "神楽", "text": "どうしたんですか？\n急に変なこと言って…。"},
        { "location": "129/TALK" , "narrator": "つばめ", "text": "え？"},
        { "location": "131/TALK" , "narrator": "つばめ", "text": "あ、ううん。\nなんでもないよ…。"},
        { "location": "132/TALK" , "narrator": "つばめ", "text": "一応言ったけど…、\nどういうことなのかな？"},
        { "location": "134/TALK" , "narrator": "つばめ", "text": "$handle$さん、\n卯月さんのどんな反応を\n見たかったんだろ？"},
        { "location": "135/TALK" , "narrator": "神楽", "text": "…………。"},
        { "location": "137/TALK" , "narrator": "神楽", "text": "よかった…。\nバレてないみたい。"},
        { "location": "138/TALK" , "narrator": "神楽", "text": "スマホを弄ってたから、\nもしやと思って\n警戒しといてよかった…。"},
        { "location": "139/ACT"  , "narrator": "", "text": "神楽の薄い本"},
        { "location": "150/TALK" , "narrator": "つばめ", "text": "薄ぃ本？"},
        { "location": "152/TALK" , "narrator": "つばめ", "text": "なにそれ？(･Д･｀)"},
        { "location": "154/SEL"  , "narrator": "（選択肢）", "text": "神楽に聞いてみて"},
        { "location": "155/ACT"  , "narrator": "", "text": "神楽に聞いてみて"},
        { "location": "157/TALK" , "narrator": "つばめ", "text": "わかった"},
        { "location": "158/TALK" , "narrator": "つばめ", "text": "聞ぃてみるね"},
        { "location": "163/TALK" , "narrator": "つばめ", "text": "あの、卯月さん。"},
        { "location": "164/TALK" , "narrator": "つばめ", "text": "薄ぃ本、って\nどんな本かな？"},
        { "location": "166/TALK" , "narrator": "神楽", "text": "同人誌のことですね。\nつばめさんも、\n聞いたことありませんか？"},
        { "location": "167/TALK" , "narrator": "神楽", "text": "自分で描いた作品を、\n自費で印刷して\n本にしたものです。"},
        { "location": "168/TALK" , "narrator": "つばめ", "text": "あ、テレビで\n見たことある！"},
        { "location": "169/TALK" , "narrator": "つばめ", "text": "確か、有明で大きい\nイベントやるんだよね？"},
        { "location": "170/TALK" , "narrator": "神楽", "text": "その通りです。"},
        { "location": "171/TALK" , "narrator": "神楽", "text": "…で、それがどうか\nしたんですか？"},
        { "location": "172/TALK" , "narrator": "つばめ", "text": "え！？　あ、えっと…。"},
        { "location": "173/TALK" , "narrator": "つばめ", "text": "…聞いてみただけ、かな？"},
        { "location": "175/TALK" , "narrator": "神楽", "text": "ふふっ、変なつばめさん。\n急にそんなこと\n聞いてくるなんて。"},
        { "location": "176/TALK" , "narrator": "つばめ", "text": "あ、あはは…そうだよね。"},
        { "location": "177/TALK" , "narrator": "つばめ", "text": "…$handle$さん、\nなんでこんなこと\n聞けって言ったのかな？"},
        { "location": "178/TALK" , "narrator": "神楽", "text": "…………。"},
        { "location": "179/TALK" , "narrator": "神楽", "text": "ちょっと驚いたけど、\n多分バレてないとは…\n思いたいです…。"},
        { "location": "181/TALK" , "narrator": "神楽", "text": "まさか、あのノートから\n同人誌を作ろうとしてる\nなんて思わないでしょう。"},
        { "location": "182/ACT"  , "narrator": "", "text": "お絵かきの趣味はまだ秘密？"},
        { "location": "194/TALK" , "narrator": "つばめ", "text": "ぉ絵かきの趣味？(･Д･｀)"},
        { "location": "195/TALK" , "narrator": "つばめ", "text": "卯月さん"},
        { "location": "196/TALK" , "narrator": "つばめ", "text": "絵を描くのが趣味なの？(・ω・`)"},
        { "location": "198/SEL"  , "narrator": "（選択肢）", "text": "聞いてみればわかるよ"},
        { "location": "199/ACT"  , "narrator": "", "text": "聞いてみればわかるよ"},
        { "location": "201/TALK" , "narrator": "つばめ", "text": "わかった"},
        { "location": "202/TALK" , "narrator": "つばめ", "text": "ちょっと聞ぃてみる(*´︶`*)"},
        { "location": "208/TALK" , "narrator": "つばめ", "text": "…あの、卯月さん。\nちょっと聞きたいことが\nあるんだけど。"},
        { "location": "210/TALK" , "narrator": "神楽", "text": "なんでしょう？"},
        { "location": "211/TALK" , "narrator": "つばめ", "text": "うん…卯月さんの\n趣味って、\nもしかして――"},
        { "location": "212/TALK" , "narrator": "神楽", "text": "ラノベを読むことです。"},
        { "location": "214/TALK" , "narrator": "つばめ", "text": "えっ？"},
        { "location": "215/TALK" , "narrator": "神楽", "text": "忘れちゃったんですか？"},
        { "location": "216/TALK" , "narrator": "神楽", "text": "私がラノベ好きなの、\n前に電車の中で\n話したじゃないですか。"},
        { "location": "217/TALK" , "narrator": "つばめ", "text": "あ…そっか。\nそういえば言ってたよね？"},
        { "location": "218/TALK" , "narrator": "神楽", "text": "ふふっ、思い出してくれて\nよかったです。"},
        { "location": "219/TALK" , "narrator": "つばめ", "text": "あはは…。"},
        { "location": "220/TALK" , "narrator": "つばめ", "text": "…じゃあ、どうして\n$handle$さんは\nあんなこと言ったのかな？"},
        { "location": "221/TALK" , "narrator": "神楽", "text": "…………。"},
        { "location": "222/TALK" , "narrator": "神楽", "text": "まさか、趣味の話題から\n探ろうしてくるとは\n思わなかったわ。"},
        { "location": "223/TALK" , "narrator": "神楽", "text": "スマホを弄ってたから\n一応警戒してたけど…、\n正解だったみたい。"},
        { "location": "226/TALK" , "narrator": "つばめ", "text": "あ、そういえば、\n明日だよね？"},
        { "location": "227/TALK" , "narrator": "神楽", "text": "え？"},
        { "location": "229/TALK" , "narrator": "つばめ", "text": "卯月さん、\n忘れちゃったの？"},
        { "location": "231/TALK" , "narrator": "つばめ", "text": "わたしに秋葉原を\n案内してくれる、って\n約束のことだよ。"},
        { "location": "233/TALK" , "narrator": "神楽", "text": "あ、ああ、はい！\n大丈夫です、\n覚えてますよ。"},
        { "location": "234/TALK" , "narrator": "神楽", "text": "私もとっても楽しみに\nしてましたからね。"},
        { "location": "235/TALK" , "narrator": "つばめ", "text": "えへへ、どんなお店に\n連れてってもらえるのか、\nとっても楽しみだよ。"},
        { "location": "236/TALK" , "narrator": "神楽", "text": "ふふっ…私もです。"},
        { "location": "237/TALK" , "narrator": "神楽", "text": "案内したお店で、\nつばめさんがどんな\n反応をするのか…。"},
        { "location": "238/TALK" , "narrator": "神楽", "text": "想像するだけで、\nワクワクしてきます！"},
        { "location": "239/TALK" , "narrator": "つばめ", "text": "…普通のお店だよね？"},
        { "location": "240/TALK" , "narrator": "神楽", "text": "はい。合法的に営業を\nしている、普通のお店に\n案内しますからね。"},
        { "location": "242/TALK" , "narrator": "つばめ", "text": "そういう意味の普通か\nどうか聞いたわけじゃ\nないのにぃ…。"}
    ]
}
