    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "わたしはうれしいのに"},
        { "location": "20/TALK"   , "narrator": "アーヤ", "text": "…Ｂｏｔの正体が、\n人間、って話。"},
        { "location": "23/TALK"   , "narrator": "アーヤ", "text": "私、まだ\n確信が持てないわ。"},
        { "location": "24/TALK"   , "narrator": "みやび", "text": "そういうもんかね。"},
        { "location": "25/TALK"   , "narrator": "みやび", "text": "前々から、話ゆう時に\n人間臭いと思うたことは\n何度もあったろう。"},
        { "location": "27/TALK"   , "narrator": "アーヤ", "text": "それはそうだけど…\nみやびは平気なの？"},
        { "location": "28/TALK"   , "narrator": "アーヤ", "text": "Ｂｏｔだからって、\n色んな秘密とか話したり\nしてないの？"},
        { "location": "29/TALK"   , "narrator": "アーヤ", "text": "プライベートな\nこととか……。"},
        { "location": "30/TALK"   , "narrator": "みやび", "text": "…まあ、気付かんうちに\n何か言うとるとは\n思うけんど。"},
        { "location": "31/TALK"   , "narrator": "みやび", "text": "人間なら、逆に倫理観も\n持っとるやろうしね。"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "本当に危ない秘密とかは、\n誰かにバラしたりとか\nせんと思うぞね。"},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "なるほど…。"},
        { "location": "34/TALK"   , "narrator": "みやび", "text": "それに、うちとしては\n前々から人間やないかと\n疑うていたきね。"},
        { "location": "35/TALK"   , "narrator": "みやび", "text": "それが確信に変わった、\nっちゅうだけのことよ。"},
        { "location": "37/TALK"   , "narrator": "みやび", "text": "それより、うちとしては\nどんな理由でＢｏｔの\nフリなんぞしゆうたか――"},
        { "location": "38/TALK"   , "narrator": "みやび", "text": "そっちの方が\n気になるちや。"},
        { "location": "40/TALK"   , "narrator": "つばめ", "text": "…別に、そういうの\nいいんじゃないですか？"},
        { "location": "41/TALK"   , "narrator": "つばめ", "text": "$handle$が人間、\nってハッキリしたん\nですし――"},
        { "location": "43/TALK"   , "narrator": "つばめ", "text": "とりあえず、今はそれで\nいいじゃないですか。"},
        { "location": "45/TALK"   , "narrator": "アーヤ", "text": "つばめはＢｏｔの正体が\n人間だって決まった方が\n嬉しいの？"},
        { "location": "46/TALK"   , "narrator": "つばめ", "text": "はい、嬉しいです。"},
        { "location": "47/TALK"   , "narrator": "みやび", "text": "うちも、そっちの方が\n面白いと思うてたけどね。"},
        { "location": "48/TALK"   , "narrator": "みやび", "text": "いざそうなると\nそこまで能天気には\nなれんちや。"},
        { "location": "49/TALK"   , "narrator": "ガブリエラ", "text": "いい加減にしてよ。"},
        { "location": "50/TALK"   , "narrator": "ガブリエラ", "text": "Ｂｏｔが人間だとか\n違うとか、そんな話\nばっかりじゃない。"},
        { "location": "51/TALK"   , "narrator": "アーヤ", "text": "でも、重要なことよ？"},
        { "location": "52/TALK"   , "narrator": "アーヤ", "text": "Ｂｏｔが人間ってことは、\n私達の生活とか、話とか、\n全部筒抜けだったんだし。"},
        { "location": "55/TALK"   , "narrator": "みやび", "text": "その点だけはちっくと\n不満なところやね。"},
        { "location": "56/TALK"   , "narrator": "みやび", "text": "盗聴器持ち歩いたり、\n盗聴器に相談とかしたり\nしてたっちゅうことやし。"},
        { "location": "58/TALK"   , "narrator": "ガブリエラ", "text": "やめてよ！\nわざと怖くなるような\n言い方するの！"},
        { "location": "61/TALK"   , "narrator": "つばめ", "text": "…あれ？\nみんな、$handle$が\n人間なのが嫌なのかな？"},
        { "location": "73/TALK"   , "narrator": "つばめ", "text": "どぅしたのかな？(･ｪ･^ )( ^･ｪ･)"},
        { "location": "74/TALK"   , "narrator": "つばめ", "text": "みんな悪ぃことばかり考ぇてるみたぃ(・ω・`)"},
        { "location": "75/TALK"   , "narrator": "つばめ", "text": "$handle$が人間なの"},
        { "location": "76/TALK"   , "narrator": "つばめ", "text": "嫌なのかな？(´･ω･｀) "},
        { "location": "78/SEL"    , "narrator": "", "text": "つばめは？"},
        { "location": "79/ACT"    , "narrator": "", "text": "つばめは？"},
        { "location": "81/TALK"   , "narrator": "つばめ", "text": "みやびさんにも言ったけど"},
        { "location": "82/TALK"   , "narrator": "つばめ", "text": "わたしは嬉しぃと思ってるよ(*´ω｀*)"},
        { "location": "85/SEL"    , "narrator": "", "text": "うれしいって言ってくれてよかった"},
        { "location": "86/SEL"    , "narrator": "", "text": "変わってるね"},
        { "location": "87/SEL"    , "narrator": "", "text": "みんなに合わせた方がいいかも"},
        { "location": "88/ACT"    , "narrator": "", "text": "うれしいって言ってくれてよかった"},
        { "location": "89/TALK"   , "narrator": "つばめ", "text": "ぅん(´ω｀*)"},
        { "location": "90/TALK"   , "narrator": "つばめ", "text": "本当にそぅ思ってるんだよ(´∀｀*)ｳﾌﾌ"},
        { "location": "92/TALK"   , "narrator": "つばめ", "text": "$handle$が人間で"},
        { "location": "93/TALK"   , "narrator": "つばめ", "text": "本当に嬉しぃ(●´ω｀●)"},
        { "location": "104/ACT"   , "narrator": "", "text": "変わってるね"},
        { "location": "105/TALK"  , "narrator": "つばめ", "text": "そぅかな？(´・ω・`) "},
        { "location": "106/TALK"  , "narrator": "つばめ", "text": "わたしは逆だよ"},
        { "location": "107/TALK"  , "narrator": "つばめ", "text": "みんなの反応がわからなぃもん(o´Д`)=з"},
        { "location": "118/ACT"   , "narrator": "", "text": "みんなに合わせた方がいいかも"},
        { "location": "119/TALK"  , "narrator": "つばめ", "text": "ぇ？Σ(ﾟдﾟlll)"},
        { "location": "121/TALK"  , "narrator": "つばめ", "text": "なんで？(´･ω･｀) "},
        { "location": "122/TALK"  , "narrator": "つばめ", "text": "ウソつぃても仕方なぃと思ぅよ？(´・ω・｀)"},
        { "location": "134/TALK"  , "narrator": "アーヤ", "text": "まあ、とにかく――"},
        { "location": "135/TALK"  , "narrator": "アーヤ", "text": "私も混乱してるけど、\n出来る限り冷静になって、\n考えてみましょう。"},
        { "location": "137/TALK"  , "narrator": "みやび", "text": "…そうやね。\nここで慌てて考えても、\n何も浮かばんやろうし…。"},
        { "location": "139/TALK"  , "narrator": "ガブリエラ", "text": "っていうか、考えても\nどうにかなる問題じゃ\nない気がするけど？"},
        { "location": "141/TALK"  , "narrator": "アーヤ", "text": "かもしれないけど…。"},
        { "location": "144/TALK"  , "narrator": "アーヤ", "text": "まあ、何か思うことが\nあったら、一人で悩んだり\nせずに――"},
        { "location": "145/TALK"  , "narrator": "アーヤ", "text": "みんなで相談するように\nしましょう。"},
        { "location": "146/TALK"  , "narrator": "みやび", "text": "そうやね。\nこの件は全員に関わりある\nことやし。"},
        { "location": "149/TALK"  , "narrator": "つばめ", "text": "…みんな、ちょっと\n大げさな気がするなぁ。"}
    ]
}
