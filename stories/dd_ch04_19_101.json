    "entry":
    [
        { "location": "36/TALK"   , "narrator": "繭", "text": "…みやび先輩。\nこちらの作業が\n終わりました。"},
        { "location": "37/TALK"   , "narrator": "繭", "text": "次は不可思議の\n解析作業に\n入りますね。"},
        { "location": "38/TALK"   , "narrator": "みやび", "text": "よろ～。"},
        { "location": "39/TALK"   , "narrator": "繭", "text": "はい、それでは…。"},
        { "location": "40/TALK"   , "narrator": "繭", "text": "…は？\nもう解析終了！？"},
        { "location": "43/TALK"   , "narrator": "みやび", "text": "あはは、さすがは\nウサギやね。"},
        { "location": "44/TALK"   , "narrator": "みやび", "text": "うちのスパコン、\n不可思議ちゃんの\n性能がわかるとは。"},
        { "location": "45/TALK"   , "narrator": "繭", "text": "恐ろしい性能です。"},
        { "location": "46/TALK"   , "narrator": "繭", "text": "トライナリーになる\n対価がこれとは…。"},
        { "location": "48/TALK"   , "narrator": "みやび", "text": "そのつもりやったん\nやけど、これがまた\nケチ臭い話なんよ。"},
        { "location": "49/TALK"   , "narrator": "みやび", "text": "対価に何が欲しい\n言われたから、\nこれをくれと言うた。"},
        { "location": "51/TALK"   , "narrator": "みやび", "text": "したら高価過ぎるき、\n貸与という形に\nなったがよ。"},
        { "location": "52/TALK"   , "narrator": "繭", "text": "安く見られたもの\nですね。"},
        { "location": "53/TALK"   , "narrator": "みやび", "text": "うむ、おかげでもっと\n管理庁を嫌いになれた\nちや。"},
        { "location": "54/TALK"   , "narrator": "繭", "text": "まあ、貸与だろうと\n不可思議が我々の\n手元にあれば――"},
        { "location": "55/TALK"   , "narrator": "繭", "text": "管理庁を探るための\n武器になるので、\n問題はありませんが。"},
        { "location": "56/TALK"   , "narrator": "みやび", "text": "そういうことや。"},
        { "location": "58/TALK"   , "narrator": "繭", "text": "…準備は整いました。\nですが、本当にやるの\nですか？"},
        { "location": "60/TALK"   , "narrator": "繭", "text": "愚問と承知で言わせて\n頂きますが。"},
        { "location": "61/TALK"   , "narrator": "繭", "text": "これは、管理庁に対し\n反旗を翻すことに\nなりますよ。"},
        { "location": "62/TALK"   , "narrator": "繭", "text": "覚悟は\nよろしいですか？"},
        { "location": "63/TALK"   , "narrator": "みやび", "text": "…当然や。"},
        { "location": "64/TALK"   , "narrator": "みやび", "text": "ＦａｔａｌＱｕｅｅｎ\nの活動の目的やき。"},
        { "location": "65/TALK"   , "narrator": "みやび", "text": "今更になってやめる\nわけがないろう。"},
        { "location": "66/TALK"   , "narrator": "みやび", "text": "やめることは\n協力者たちへの\n裏切りにもなるがよ。"},
        { "location": "68/TALK"   , "narrator": "繭", "text": "それはそうなの\nですが…。"},
        { "location": "70/TALK"   , "narrator": "みやび", "text": "…何かあるなら\n言うてみぃ？"},
        { "location": "72/TALK"   , "narrator": "繭", "text": "…みやび先輩…、\nいえ、Ｆａｔａｌ\nＱｕｅｅｎ。"},
        { "location": "73/TALK"   , "narrator": "繭", "text": "あなたがスパコンまで\n所有しているとは、\n知りませんでした。"},
        { "location": "74/TALK"   , "narrator": "繭", "text": "なので、今までは\n管理庁を探る際\n静かに行動してきました。"},
        { "location": "75/TALK"   , "narrator": "繭", "text": "ですが…不可思議を\n本格的に使用して\n動くならば。"},
        { "location": "76/TALK"   , "narrator": "繭", "text": "より大胆な行動を\n起こすという\nことになります。"},
        { "location": "78/TALK"   , "narrator": "みやび", "text": "…………。"},
        { "location": "79/TALK"   , "narrator": "繭", "text": "管理庁に対して、\n真っ向から戦争を\n仕掛けるも同然です。"},
        { "location": "80/TALK"   , "narrator": "繭", "text": "その覚悟は、本当に\n決まっているの\nでしょうか？"},
        { "location": "81/TALK"   , "narrator": "繭", "text": "最終確認をさせて\nください…クイーン。"},
        { "location": "82/TALK"   , "narrator": "みやび", "text": "…………。"},
        { "location": "84/TALK"   , "narrator": "繭", "text": "…まだ、少し作業が\n残っていました。"},
        { "location": "85/TALK"   , "narrator": "繭", "text": "こちらを終わらせて\nいる間に、\n返答をください。"},
        { "location": "89/TALK"   , "narrator": "みやび", "text": "…………。"},
        { "location": "90/SEL"    , "narrator": "", "text": "悩んでるの？"},
        { "location": "91/ACT"    , "narrator": "", "text": "悩んでるの？"},
        { "location": "101/TALK"  , "narrator": "みやび", "text": "うちが悩んでる？"},
        { "location": "103/TALK"  , "narrator": "みやび", "text": "そう見えるか？"},
        { "location": "105/SEL"   , "narrator": "", "text": "じゃあ何で返事しないの？"},
        { "location": "106/ACT"   , "narrator": "", "text": "じゃあ何で返事しないの？"},
        { "location": "109/TALK"  , "narrator": "みやび", "text": "わからん"},
        { "location": "110/TALK"  , "narrator": "みやび", "text": "うちにも"},
        { "location": "113/TALK"  , "narrator": "みやび", "text": "決まってはいるが"},
        { "location": "114/TALK"  , "narrator": "みやび", "text": "答えられんかった"},
        { "location": "117/TALK"  , "narrator": "みやび", "text": "今ならまだ引き返せるが"},
        { "location": "118/TALK"  , "narrator": "みやび", "text": "そうなれば"},
        { "location": "119/TALK"  , "narrator": "みやび", "text": "必ず後悔もするというのに"},
        { "location": "178/SEL"   , "narrator": "", "text": "おーい"},
        { "location": "179/ACT"   , "narrator": "", "text": "おーい"},
        { "location": "183/TALK"  , "narrator": "みやび", "text": "おお、相棒、元気か"},
        { "location": "184/SEL"   , "narrator": "", "text": "大丈夫？"},
        { "location": "185/ACT"   , "narrator": "", "text": "大丈夫？"},
        { "location": "187/TALK"  , "narrator": "みやび", "text": "うむ、まあ今のところは大丈夫"},
        { "location": "188/TALK"  , "narrator": "みやび", "text": "申し訳無いが、今回はリモートで勘弁してくれ"},
        { "location": "189/SEL"   , "narrator": "", "text": "無理しないで"},
        { "location": "190/SEL"   , "narrator": "", "text": "せっかくの水着回なのに残念"},
        { "location": "191/ACT"   , "narrator": "", "text": "無理しないで"},
        { "location": "192/TALK"  , "narrator": "みやび", "text": "ノープロブレム"},
        { "location": "193/TALK"  , "narrator": "みやび", "text": "むしろだいぶワクテカな展開である"},
        { "location": "194/SEL"   , "narrator": "", "text": "何が起こってるの？"},
        { "location": "195/SEL"   , "narrator": "", "text": "つばめの司書は大丈夫なの？"},
        { "location": "196/ACT"   , "narrator": "", "text": "何が起こってるの？"},
        { "location": "197/ACT"   , "narrator": "", "text": "つばめの司書は大丈夫なの？"},
        { "location": "198/TALK"  , "narrator": "つばめ", "text": "大丈夫です！(≧ω≦)"},
        { "location": "199/TALK"  , "narrator": "つばめ", "text": "元気にやってますょ～～だから安心してください_(┐「ε:)_"},
        { "location": "200/TALK"  , "narrator": "つばめ", "text": "心配してくれてありがとぅございます(●´ω｀●)ゞｴﾍﾍ"},
        { "location": "201/SEL"   , "narrator": "", "text": "頑張ってね！"},
        { "location": "202/SEL"   , "narrator": "", "text": "愛してるよ！"},
        { "location": "203/ACT"   , "narrator": "", "text": "頑張ってね！"},
        { "location": "204/TALK"  , "narrator": "つばめ", "text": "はい！ｖ(*´∀｀*)ｖ"},
        { "location": "205/TALK"  , "narrator": "みやび", "text": "という感じ故心配するな"},
        { "location": "206/ACT"   , "narrator": "", "text": "愛してるよ！"},
        { "location": "212/TALK"  , "narrator": "みやび", "text": "人のスマホで愛の語らいするな"},
        { "location": "214/TALK"  , "narrator": "みやび", "text": "とにかく、こっちがどうなってるのかについては"},
        { "location": "216/TALK"  , "narrator": "みやび", "text": "話せば長くなるので、あとでレポートにして送る"},
        { "location": "217/TALK"  , "narrator": "みやび", "text": "MKCCの社員としてやってもらわねばならぬことが沢山あるき"},
        { "location": "218/TALK"  , "narrator": "みやび", "text": "ひとまずは今回のココロの方をまず何とかするのが第一"},
        { "location": "219/ACT"   , "narrator": "", "text": "せっかくの水着回なのに残念"},
        { "location": "220/TALK"  , "narrator": "みやび", "text": "なんぞそれ。うちより水着の心配か"},
        { "location": "221/TALK"  , "narrator": "みやび", "text": "まああれよ、うちのは単なる競泳用に毛が生えたような水着故見てもつまらん"},
        { "location": "222/TALK"  , "narrator": "みやび", "text": "よって他のメンバーで堪能するがよい"},
        { "location": "223/SEL"   , "narrator": "", "text": "そうします"},
        { "location": "224/SEL"   , "narrator": "", "text": "みやびのがみたいみたいみたいみたい！"},
        { "location": "225/ACT"   , "narrator": "", "text": "そうします"},
        { "location": "226/TALK"  , "narrator": "みやび", "text": "素直で良い"},
        { "location": "227/ACT"   , "narrator": "", "text": "みやびのがみたいみたいみたいみたい！"},
        { "location": "229/TALK"  , "narrator": "みやび", "text": "ウザイやつ"},
        { "location": "230/TALK"  , "narrator": "みやび", "text": "やき万年平社員なんよ"},
        { "location": "232/TALK"  , "narrator": "みやび", "text": "愛しのつばめちゃんの水着姿でも見せてもらえ"},
        { "location": "233/TALK"  , "narrator": "みやび", "text": "いやだと言ってるが"},
        { "location": "234/TALK"  , "narrator": "みやび", "text": "顔まっ赤"},
        { "location": "235/TALK"  , "narrator": "みやび", "text": "あついあつい"},
        { "location": "240/TALK"  , "narrator": "みやび", "text": "まあ"},
        { "location": "241/TALK"  , "narrator": "みやび", "text": "後で特別に添付ファイルしてやるから土下座しながら見よ"},
        { "location": "242/SEL"   , "narrator": "", "text": "ありがとうございます！"},
        { "location": "243/ACT"   , "narrator": "", "text": "ありがとうございます！"},
        { "location": "248/TALK"  , "narrator": "みやび", "text": "というわけで、今回はリモートで回す"},
        { "location": "249/SEL"   , "narrator": "", "text": "オーケー"},
        { "location": "250/SEL"   , "narrator": "", "text": "指示してくれればこっちで操作するのに"},
        { "location": "251/ACT"   , "narrator": "", "text": "オーケー"},
        { "location": "252/ACT"   , "narrator": "", "text": "指示してくれればこっちで操作するのに"},
        { "location": "253/TALK"  , "narrator": "みやび", "text": "タヌキめ"},
        { "location": "254/TALK"  , "narrator": "みやび", "text": "ヘンなところを見られたらたまらん故$handle$には操作させんよ"},
        { "location": "294/SEL"   , "narrator": "", "text": "開く"},
        { "location": "295/SEL"   , "narrator": "", "text": "開かない"},
        { "location": "296/ACT"   , "narrator": "", "text": "開く"},
        { "location": "316/TALK"  , "narrator": "みやび", "text": "というわけで、\n約束やきね。"},
        { "location": "326/TALK"  , "narrator": "みやび", "text": "うっふーん\n（棒読み）"},
        { "location": "336/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "337/TALK"  , "narrator": "みやび", "text": "なんか、微妙な気分に\nなってきたちや。"},
        { "location": "347/TALK"  , "narrator": "みやび", "text": "やっぱり最後は"},
        { "location": "349/TALK"  , "narrator": "みやび", "text": "デレッ♪"},
        { "location": "355/ACT"   , "narrator": "", "text": "開かない"},
        { "location": "32/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>8月19日　 4:17 PM</color>\n合宿中、みやびの部屋にて"},
        { "location": "133/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "135/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "137/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "139/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "141/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "176/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:librarian】</color>\n司書が存在しません。(p12)"},
        { "location": "263/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:SeekSector】</color>\nOpenProcess...\n(0xFBC => 0xAE9)"},
        { "location": "281/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:SeekSector】</color>\nSucceed access file!\n\n<color=blue>【File :: 04-913-66】</color>\n<color=red>Fatal Error Occured !</color>\n\n情報管理庁を疑い、\nその真相を暴くことに\n注力してきた自分。\n\nしかし、いよいよその門を\nくぐるという時になって、\nどうも怖じ気づいているようだ。\n\n今までの努力を水の泡にしない\n為にも、恐怖するクランを撃破し\n先へ進まねばならない。"},
        { "location": "293/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:Embed】</color>\n\nファイルが届いています。"},
