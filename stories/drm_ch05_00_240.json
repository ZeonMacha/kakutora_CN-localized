    "entry":
    [
        { "location": "2075/SCENARIO", "narrator": "", "text": "手は伸ばせないまま"},
        { "location": "2100/TALK"    , "narrator": "神楽", "text": "$handle$さんは"},
        { "location": "2101/TALK"    , "narrator": "神楽", "text": "セクシーなぴょんことキュートなぴょんこだとどっちが好きですか？"},
        { "location": "2102/TALK"    , "narrator": "神楽", "text": "知りたいな～♪"},
        { "location": "2104/SEL"     , "narrator": "", "text": "両方萌える"},
        { "location": "2105/SEL"     , "narrator": "", "text": "ちょっと古すぎない？"},
        { "location": "2106/SEL"     , "narrator": "", "text": "ナチュラルでお願いします"},
        { "location": "2107/ACT"     , "narrator": "", "text": "両方萌える"},
        { "location": "2108/TALK"    , "narrator": "神楽", "text": "いいとこどりしたいってことですね♪"},
        { "location": "2110/TALK"    , "narrator": "神楽", "text": "そういうのｽｷ"},
        { "location": "2111/ACT"     , "narrator": "", "text": "ちょっと古すぎない？"},
        { "location": "2112/TALK"    , "narrator": "神楽", "text": "そうでしたかｼｮﾎﾞｰﾝ、、、"},
        { "location": "2113/TALK"    , "narrator": "神楽", "text": "でもニュアンスは伝わりますよね？"},
        { "location": "2114/ACT"     , "narrator": "", "text": "ナチュラルでお願いします"},
        { "location": "2115/TALK"    , "narrator": "神楽", "text": "シンプルナチュラル！"},
        { "location": "2117/TALK"    , "narrator": "神楽", "text": "なかなかいいところ突いて来ますね～"},
        { "location": "2118/TALK"    , "narrator": "神楽", "text": "さすが$handle$さん"},
        { "location": "2121/TALK"    , "narrator": "神楽", "text": "フレイメノウとして活動する時はどちらも大っぴらには打ち出せないコンセプトなんですよね"},
        { "location": "2122/TALK"    , "narrator": "神楽", "text": "もちろんスパイスとしてなら大ありなんですけど"},
        { "location": "2123/TALK"    , "narrator": "神楽", "text": "だからちょっとね、プライベートでは冒険してみようかなって思ってですね"},
        { "location": "2125/SEL"     , "narrator": "", "text": "協力するよ！"},
        { "location": "2126/SEL"     , "narrator": "", "text": "$me$しか知らない神楽ってことだね"},
        { "location": "2127/SEL"     , "narrator": "", "text": "もっと自然体でいいのに"},
        { "location": "2128/ACT"     , "narrator": "", "text": "協力するよ！"},
        { "location": "2130/TALK"    , "narrator": "神楽", "text": "ぴょんこも気合入れますねっ★"},
        { "location": "2131/ACT"     , "narrator": "", "text": "$me$しか知らない神楽ってことだね"},
        { "location": "2132/TALK"    , "narrator": "神楽", "text": "そういうことになりますね？"},
        { "location": "2133/TALK"    , "narrator": "神楽", "text": "特別なぴょんこです♪"},
        { "location": "2134/ACT"     , "narrator": "", "text": "もっと自然体でいいのに"},
        { "location": "2137/TALK"    , "narrator": "神楽", "text": "それはそれでいいとは思うんですけど～～～～"},
        { "location": "2138/TALK"    , "narrator": "神楽", "text": "ちょっとそういうの今のぴょんこは求めてないんですよね♪"},
        { "location": "2140/TALK"    , "narrator": "神楽", "text": "ぴょんこは$handle$さんの前だといろんなぴょんこになれるんです"},
        { "location": "2142/SEL"     , "narrator": "", "text": "真実の神楽だけが欲しいな"},
        { "location": "2143/SEL"     , "narrator": "", "text": "神楽といると飽きないな"},
        { "location": "2144/SEL"     , "narrator": "", "text": "楽しんで演じてるならいいんだけど…"},
        { "location": "2145/ACT"     , "narrator": "", "text": "真実の神楽だけが欲しいな"},
        { "location": "2146/TALK"    , "narrator": "神楽", "text": "どのぴょんこも本物のぴょんこですよ"},
        { "location": "2147/TALK"    , "narrator": "神楽", "text": "ＳＦみたいですね！"},
        { "location": "2148/ACT"     , "narrator": "", "text": "神楽といると飽きないな"},
        { "location": "2149/TALK"    , "narrator": "神楽", "text": "でしょー"},
        { "location": "2151/TALK"    , "narrator": "神楽", "text": "ぴょんこも実はそう思ってます♪"},
        { "location": "2152/ACT"     , "narrator": "", "text": "楽しんで演じてるならいいんだけど…"},
        { "location": "2155/TALK"    , "narrator": "神楽", "text": "心配してくれてるんですね♪"},
        { "location": "2156/TALK"    , "narrator": "神楽", "text": "$handle$さんﾔｻｼｰ"},
        { "location": "2159/TALK"    , "narrator": "神楽", "text": "ところでですね、、、"},
        { "location": "2160/TALK"    , "narrator": "神楽", "text": "つばめさんっていつでも能天気な感じですよね？"},
        { "location": "2162/SEL"     , "narrator": "", "text": "またその話？"},
        { "location": "2163/SEL"     , "narrator": "", "text": "素がそれだからでしょ"},
        { "location": "2164/SEL"     , "narrator": "", "text": "本当は好きなくせに～"},
        { "location": "2165/ACT"     , "narrator": "", "text": "またその話？"},
        { "location": "2166/TALK"    , "narrator": "神楽", "text": "だって気になっちゃうんですよ"},
        { "location": "2168/SEL"     , "narrator": "", "text": "$me$は神楽の方が気になるよ"},
        { "location": "2169/SEL"     , "narrator": "", "text": "神楽と$me$の話をしようよ"},
        { "location": "2170/SEL"     , "narrator": "", "text": "今は忘れてよ"},
        { "location": "2171/ACT"     , "narrator": "", "text": "$me$は神楽の方が気になるよ"},
        { "location": "2172/TALK"    , "narrator": "神楽", "text": "$handle$さんったら口説き上手ですね♪"},
        { "location": "2173/TALK"    , "narrator": "神楽", "text": "ぴょんこはそう簡単に騙されませんよ～～？"},
        { "location": "2174/ACT"     , "narrator": "", "text": "神楽と$me$の話をしようよ"},
        { "location": "2175/TALK"    , "narrator": "神楽", "text": "二人の秘密の話ですね？"},
        { "location": "2176/TALK"    , "narrator": "神楽", "text": "そういうのもアリですね♪"},
        { "location": "2177/ACT"     , "narrator": "", "text": "今は忘れてよ"},
        { "location": "2178/TALK"    , "narrator": "神楽", "text": "そんな簡単に忘れられないし"},
        { "location": "2180/ACT"     , "narrator": "", "text": "素がそれだからでしょ"},
        { "location": "2181/TALK"    , "narrator": "神楽", "text": "素、、、、、"},
        { "location": "2182/ACT"     , "narrator": "", "text": "本当は好きなくせに～"},
        { "location": "2183/TALK"    , "narrator": "神楽", "text": "好きか嫌いかで言うと好き"},
        { "location": "2184/TALK"    , "narrator": "神楽", "text": "確実に好き"},
        { "location": "2185/TALK"    , "narrator": "神楽", "text": "かわいいの大好きだし"},
        { "location": "2186/TALK"    , "narrator": "神楽", "text": "でもだからこ～～～～～～～～！"},
        { "location": "2187/TALK"    , "narrator": "神楽", "text": "っていうのがあるんですよぴょんこの中では！"},
        { "location": "2189/TALK"    , "narrator": "神楽", "text": "あーやっぱりやめやめ！"},
        { "location": "2190/TALK"    , "narrator": "神楽", "text": "この話題中止！"}
    ]
}
