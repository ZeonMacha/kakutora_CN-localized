    [
        { "location": "148/SCENARIO", "narrator": "", "text": "時告げの呪文"},
        { "location": "173/TALK"    , "narrator": "みやび", "text": "時を告げるには"},
        { "location": "174/TALK"    , "narrator": "みやび", "text": "正確な時がわからねばならぬ"},
        { "location": "176/SEL"     , "narrator": "", "text": "テケトーでいいじゃん"},
        { "location": "177/SEL"     , "narrator": "", "text": "そうかもね"},
        { "location": "178/SEL"     , "narrator": "", "text": "時告げシステムを構築しよう"},
        { "location": "179/ACT"     , "narrator": "", "text": "テケトーでいいじゃん"},
        { "location": "180/TALK"    , "narrator": "みやび", "text": "それは"},
        { "location": "182/TALK"    , "narrator": "みやび", "text": "名案だ"},
        { "location": "183/ACT"     , "narrator": "", "text": "そうかもね"},
        { "location": "184/TALK"    , "narrator": "みやび", "text": "然り"},
        { "location": "185/TALK"    , "narrator": "みやび", "text": "当然のことだ"},
        { "location": "186/ACT"     , "narrator": "", "text": "時告げシステムを構築しよう"},
        { "location": "188/TALK"    , "narrator": "みやび", "text": "すばらしい"},
        { "location": "189/TALK"    , "narrator": "みやび", "text": "まずは"},
        { "location": "190/TALK"    , "narrator": "みやび", "text": "要件定義ぞね"},
        { "location": "192/TALK"    , "narrator": "みやび", "text": "真面目な話"},
        { "location": "193/TALK"    , "narrator": "みやび", "text": "電波時計の時間のずれっぷりには"},
        { "location": "194/TALK"    , "narrator": "みやび", "text": "閉口しておる"},
        { "location": "196/SEL"     , "narrator": "", "text": "そういう話か"},
        { "location": "197/SEL"     , "narrator": "", "text": "あれ狂うよね"},
        { "location": "198/SEL"     , "narrator": "", "text": "みやびがかわいいからおかしくなったんだよ"},
        { "location": "199/ACT"     , "narrator": "", "text": "そういう話か"},
        { "location": "200/TALK"    , "narrator": "みやび", "text": "そういう話"},
        { "location": "201/ACT"     , "narrator": "", "text": "あれ狂うよね"},
        { "location": "202/TALK"    , "narrator": "みやび", "text": "うむ"},
        { "location": "203/TALK"    , "narrator": "みやび", "text": "大胆不敵に"},
        { "location": "204/ACT"     , "narrator": "", "text": "みやびがかわいいからおかしくなったんだよ"},
        { "location": "206/TALK"    , "narrator": "みやび", "text": "せやな"},
        { "location": "207/TALK"    , "narrator": "みやび", "text": "とか"},
        { "location": "208/TALK"    , "narrator": "みやび", "text": "言うとでも思ったか"},
        { "location": "210/TALK"    , "narrator": "みやび", "text": "まあ実際"},
        { "location": "211/TALK"    , "narrator": "みやび", "text": "スマホで時間を確認し"},
        { "location": "212/TALK"    , "narrator": "みやび", "text": "タイマーをセットすれば"},
        { "location": "213/TALK"    , "narrator": "みやび", "text": "電波時計は不要ぞね"},
        { "location": "215/TALK"    , "narrator": "みやび", "text": "単純に"},
        { "location": "216/TALK"    , "narrator": "みやび", "text": "そうするか"},
        { "location": "217/TALK"    , "narrator": "みやび", "text": "よし"},
        { "location": "219/TALK"    , "narrator": "みやび", "text": "自己解決だ"}
    ]
}
