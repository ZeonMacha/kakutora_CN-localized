{
    "dir": "chap16/daydra/anime_05_16.js",
    "type": "MainStory",
    "info": {
        "story_id": "16501",
        "cid": "kagura",
        "title": "001 アニメーション",
        "sub_title": "ピクルス"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "アニメ第16話"},
        { "location": "20/TALK"   , "narrator": "エリカ", "text": "コーンコン。"},
        { "location": "21/TALK"   , "narrator": "エリカ", "text": "いらっしゃい\n$handle$さん。"},
        { "location": "22/TALK"   , "narrator": "エリカ", "text": "もう一度お話聞く？\nそれとも、省略する？"},
        { "location": "23/SEL"    , "narrator": "", "text": "もう一度聞く"},
        { "location": "24/SEL"    , "narrator": "", "text": "飛ばす"},
        { "location": "25/ACT"    , "narrator": "", "text": "もう一度聞く"},
        { "location": "26/TALK"   , "narrator": "エリカ", "text": "うん、わかったよ。"},
        { "location": "28/ACT"    , "narrator": "", "text": "飛ばす"},
        { "location": "29/TALK"   , "narrator": "エリカ", "text": "そっかー。\nそれじゃ、またね。"},
        { "location": "36/TALK"   , "narrator": "エリカ", "text": "コーンコン。"},
        { "location": "37/TALK"   , "narrator": "エリカ", "text": "こんにちは、\n$handle$さん。"},
        { "location": "38/TALK"   , "narrator": "エリカ", "text": "前回はリプレイス1回目\n試験運用に参加してくれて\nありがとう。"},
        { "location": "39/TALK"   , "narrator": "エリカ", "text": "お陰様で、今のところ\n特に問題は無さそうだよ。"},
        { "location": "40/TALK"   , "narrator": "エリカ", "text": "あと数エピソード分の\n様子を見て問題なければ、\n本番に入ろうと思うの。"},
        { "location": "41/TALK"   , "narrator": "エリカ", "text": "時期的にもそろそろ\nターゲットに入ってくる\nみたいだからね。"},
        { "location": "42/SEL"    , "narrator": "", "text": "それは千羽鶴の言葉？"},
        { "location": "43/SEL"    , "narrator": "", "text": "本番はお試しと何か違うの？"},
        { "location": "44/ACT"    , "narrator": "", "text": "それは千羽鶴の言葉？"},
        { "location": "45/TALK"   , "narrator": "エリカ", "text": "うん、そうだよ。"},
        { "location": "46/ACT"    , "narrator": "", "text": "本番はお試しと何か違うの？"},
        { "location": "47/TALK"   , "narrator": "エリカ", "text": "やることは\n殆ど同じだよ。"},
        { "location": "48/TALK"   , "narrator": "エリカ", "text": "あなたが誰かに対して\n一押しすることで、\n僅かに軸をずらす。"},
        { "location": "49/TALK"   , "narrator": "エリカ", "text": "そのずらし方次第で、\n上手くいったり\nいかなかったり――"},
        { "location": "50/TALK"   , "narrator": "エリカ", "text": "そんな感じかな。"},
        { "location": "52/TALK"   , "narrator": "エリカ", "text": "今のところ、\n外の世界からの侵入も\n検知されてないし――"},
        { "location": "53/TALK"   , "narrator": "エリカ", "text": "ちょっと怖いくらい\n順風満帆だね。"},
        { "location": "54/SEL"    , "narrator": "", "text": "上手くいってるうちにできる限り事を進めよう"},
        { "location": "55/SEL"    , "narrator": "", "text": "外の世界からの侵入が無い件だけど"},
        { "location": "56/ACT"    , "narrator": "", "text": "上手くいってるうちにできる限り事を進めよう"},
        { "location": "57/TALK"   , "narrator": "エリカ", "text": "そうだね！"},
        { "location": "58/ACT"    , "narrator": "", "text": "外の世界からの侵入が無い件だけど"},
        { "location": "59/TALK"   , "narrator": "エリカ", "text": "どうしたの？"},
        { "location": "60/SEL"    , "narrator": "", "text": "元々はどこかで侵入してきていたってことは、今回も必ず侵入してくるんだよね？"},
        { "location": "61/SEL"    , "narrator": "", "text": "今回は侵入してこないんじゃないの？"},
        { "location": "62/ACT"    , "narrator": "", "text": "元々はどこかで侵入してきていたってことは、今回も必ず侵入してくるんだよね？"},
        { "location": "63/TALK"   , "narrator": "エリカ", "text": "理論上はそうだね。"},
        { "location": "64/TALK"   , "narrator": "エリカ", "text": "外の現実世界自体の\nリプレイスをすることは\n実質不可能。"},
        { "location": "65/TALK"   , "narrator": "エリカ", "text": "ということは、もし\n違和感を感じるとしても、\nそれは一度試行してから。"},
        { "location": "66/TALK"   , "narrator": "エリカ", "text": "必ず一度は\n侵入を試みると断言しても\nいいと思う。"},
        { "location": "67/ACT"    , "narrator": "", "text": "今回は侵入してこないんじゃないの？"},
        { "location": "68/TALK"   , "narrator": "エリカ", "text": "え？\nどうして？"},
        { "location": "69/SEL"    , "narrator": "", "text": "えっと、何となく"},
        { "location": "70/SEL"    , "narrator": "", "text": "神楽が同化してるわけでしょ？"},
        { "location": "71/ACT"    , "narrator": "", "text": "えっと、何となく"},
        { "location": "72/TALK"   , "narrator": "エリカ", "text": "もー。\n適当なことを\n言わないでね？"},
        { "location": "73/ACT"    , "narrator": "", "text": "神楽が同化してるわけでしょ？"},
        { "location": "74/TALK"   , "narrator": "エリカ", "text": "うん、そうだね。"},
        { "location": "75/SEL"    , "narrator": "", "text": "原因は何だと言ってたっけ？"},
        { "location": "76/ACT"    , "narrator": "", "text": "原因は何だと言ってたっけ？"},
        { "location": "78/TALK"   , "narrator": "エリカ", "text": "つばめちゃんの世界を\n経由して、外に繋いでる\nわけだけど――"},
        { "location": "79/TALK"   , "narrator": "エリカ", "text": "それが外されちゃって、\n外の世界とは\n繋がってないかも……"},
        { "location": "80/TALK"   , "narrator": "エリカ", "text": "あ――"},
        { "location": "81/SEL"    , "narrator": "", "text": "それって、どんな形で切断されてるのかな。外からはどう見える？"},
        { "location": "82/ACT"    , "narrator": "", "text": "それって、どんな形で切断されてるのかな。外からはどう見える？"},
        { "location": "84/TALK"   , "narrator": "エリカ", "text": "うーん……\n仮説は色々\n立てられるけど――"},
        { "location": "85/TALK"   , "narrator": "エリカ", "text": "最も小規模なものだと、\n神楽ちゃんのRedinessを\n個別に切断してる仮説。"},
        { "location": "86/TALK"   , "narrator": "エリカ", "text": "この場合、中と外との\n関係性は変わらないから、\n外からの侵入は可能。"},
        { "location": "87/TALK"   , "narrator": "エリカ", "text": "そして、\n最も大規模なものだと――"},
        { "location": "88/TALK"   , "narrator": "エリカ", "text": "つばめちゃんの世界が\n元の世界から、完全に\n切り離された仮説。"},
        { "location": "89/SEL"    , "narrator": "", "text": "それって要するに日本の外には世界が無いってこと？"},
        { "location": "90/SEL"    , "narrator": "", "text": "なにそれまた新しい設定クルー？"},
        { "location": "91/ACT"    , "narrator": "", "text": "それって要するに日本の外には世界が無いってこと？"},
        { "location": "92/TALK"   , "narrator": "エリカ", "text": "厳密にはあるけど、\nそれはわたしたちが\n住んでいた世界じゃない。"},
        { "location": "93/TALK"   , "narrator": "エリカ", "text": "――のかもしれない、\nという仮説だよ。"},
        { "location": "94/ACT"    , "narrator": "", "text": "なにそれまた新しい設定クルー？"},
        { "location": "95/TALK"   , "narrator": "エリカ", "text": "設定？"},
        { "location": "96/TALK"   , "narrator": "エリカ", "text": "まあ確かに、にわかに\n信じられないかも\nしれないけど――"},
        { "location": "98/TALK"   , "narrator": "エリカ", "text": "一応、ちゃんとした理屈は\nあるから、わたしの\n妄想とかじゃないよ？"},
        { "location": "99/TALK"   , "narrator": "エリカ", "text": "そもそも、フェノメノンの\n中と外って、本来何の\n繋がりも無い２つなの。"},
        { "location": "100/TALK"  , "narrator": "エリカ", "text": "それを辛うじて\n繋いでるのは――"},
        { "location": "101/TALK"  , "narrator": "エリカ", "text": "ついさっきまで一つの\n世界に共存していた、\nという、量子の持つ記憶。"},
        { "location": "102/TALK"  , "narrator": "エリカ", "text": "すなわち、\nエンタングルの\nお陰なんだよ。"},
        { "location": "103/SEL"   , "narrator": "", "text": "なるほど"},
        { "location": "104/SEL"   , "narrator": "", "text": "企業？？？"},
        { "location": "105/ACT"   , "narrator": "", "text": "なるほど"},
        { "location": "106/ACT"   , "narrator": "", "text": "企業？？？"},
        { "location": "107/TALK"  , "narrator": "エリカ", "text": "あ、ここで言う\nエンタングルは、\n物理用語の方ね。"},
        { "location": "108/TALK"  , "narrator": "エリカ", "text": "量子もつれのこと。"},
        { "location": "110/TALK"  , "narrator": "エリカ", "text": "エンタングルは、その\nもつれ方の規則性によって\n世界の相対位置を定義する"},
        { "location": "111/TALK"  , "narrator": "エリカ", "text": "時間、空間、重力、\nその他様々な次元の形状は\nエンタングルで決まる。"},
        { "location": "112/TALK"  , "narrator": "エリカ", "text": "だからその規則性が、\n意図的に破壊されれば――"},
        { "location": "113/TALK"  , "narrator": "エリカ", "text": "別々になってしまった\n世界は、その戻り先を\n見失ってしまう。"},
        { "location": "114/SEL"   , "narrator": "", "text": "ラッキーじゃん"},
        { "location": "115/SEL"   , "narrator": "", "text": "ヤバイじゃん"},
        { "location": "116/ACT"   , "narrator": "", "text": "ラッキーじゃん"},
        { "location": "117/TALK"  , "narrator": "エリカ", "text": "見方によっては\nそういう面も\nあるのかもしれない。"},
        { "location": "118/TALK"  , "narrator": "エリカ", "text": "けど、多分\n失うものの方が\n多いとは思う。"},
        { "location": "119/ACT"   , "narrator": "", "text": "ヤバイじゃん"},
        { "location": "120/TALK"  , "narrator": "エリカ", "text": "そうだね。"},
        { "location": "122/TALK"  , "narrator": "エリカ", "text": "あ、でもこれはもちろん、\nあくまで科学者としての\n仮説だから。"},
        { "location": "123/TALK"  , "narrator": "エリカ", "text": "実際に今、\nそうなってるっていう\nわけじゃないよ。"},
        { "location": "124/TALK"  , "narrator": "エリカ", "text": "むしろそんなことに\nなってる可能性は、\nかなり少ないと思う。"},
        { "location": "129/SEL"   , "narrator": "", "text": "それで、同化に関しては何か原因わかったの？"},
        { "location": "130/ACT"   , "narrator": "", "text": "それで、同化に関しては何か原因わかったの？"},
        { "location": "132/TALK"  , "narrator": "エリカ", "text": "残念ながら\nまだかな。"},
        { "location": "133/TALK"  , "narrator": "エリカ", "text": "$handle$さんの\n方は、何か変わったこと\nとかあった？"},
        { "location": "134/SEL"   , "narrator": "", "text": "特にない"},
        { "location": "135/SEL"   , "narrator": "", "text": "共通意識野に行ったら、同化した方が良いのだという声が聞こえた"},
        { "location": "136/ACT"   , "narrator": "", "text": "特にない"},
        { "location": "137/TALK"  , "narrator": "エリカ", "text": "そっか。"},
        { "location": "138/ACT"   , "narrator": "", "text": "共通意識野に行ったら、同化した方が良いのだという声が聞こえた"},
        { "location": "139/TALK"  , "narrator": "エリカ", "text": "えっ！？\n何それ…。"},
        { "location": "140/TALK"  , "narrator": "エリカ", "text": "誰なの？"},
        { "location": "141/SEL"   , "narrator": "", "text": "わからない"},
        { "location": "142/SEL"   , "narrator": "", "text": "神楽じゃない？"},
        { "location": "143/SEL"   , "narrator": "", "text": "つばめじゃない？"},
        { "location": "144/SEL"   , "narrator": "", "text": "エリカじゃない？"},
        { "location": "145/SEL"   , "narrator": "", "text": "千羽鶴じゃない？"},
        { "location": "146/ACT"   , "narrator": "", "text": "わからない"},
        { "location": "148/TALK"  , "narrator": "エリカ", "text": "だよねー…。"},
        { "location": "149/ACT"   , "narrator": "", "text": "神楽じゃない？"},
        { "location": "151/TALK"  , "narrator": "エリカ", "text": "そうかなぁ。"},
        { "location": "152/ACT"   , "narrator": "", "text": "つばめじゃない？"},
        { "location": "154/TALK"  , "narrator": "エリカ", "text": "つばめちゃん？\nうーん……"},
        { "location": "155/ACT"   , "narrator": "", "text": "エリカじゃない？"},
        { "location": "157/TALK"  , "narrator": "エリカ", "text": "ええっ！？\nわたしじゃないよ？"},
        { "location": "158/ACT"   , "narrator": "", "text": "千羽鶴じゃない？"},
        { "location": "160/TALK"  , "narrator": "エリカ", "text": "いや、それは……\n無いと思うけど……。"},
        { "location": "162/TALK"  , "narrator": "エリカ", "text": "ちょっと今のわたしには\nわからないかも……。"},
        { "location": "163/TALK"  , "narrator": "エリカ", "text": "わたしも調べてみて、\n何かわかったらすぐに\n教えるから。"},
        { "location": "164/TALK"  , "narrator": "エリカ", "text": "いつも全然\n役に立たなくて\nごめんね？"},
        { "location": "166/TALK"  , "narrator": "エリカ", "text": "今回わたしからの話は\nこれくらいかな。"},
        { "location": "167/TALK"  , "narrator": "エリカ", "text": "最後に、\n記録映像を見ていく？"},
        { "location": "169/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/116MB 7:17】</color>"},
        { "location": "170/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/37MB 7:17】</color>"},
        { "location": "171/SEL"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "172/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/116MB 7:17】</color>"},
        { "location": "173/TALK"  , "narrator": "エリカ", "text": "わかったよ。"},
        { "location": "179/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/37MB 7:17】</color>"},
        { "location": "180/TALK"  , "narrator": "エリカ", "text": "わかったよ。"},
        { "location": "186/ACT"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "187/TALK"  , "narrator": "エリカ", "text": "あらら。"},
        { "location": "220/TALK"  , "narrator": "エリカ", "text": "時期的には、\n神楽ちゃんにとっての\n重大事件があった日だね。"},
        { "location": "221/TALK"  , "narrator": "エリカ", "text": "この時期の神楽ちゃんは\nものすごい精神的に\n辛い時期だと思うから――"},
        { "location": "222/TALK"  , "narrator": "エリカ", "text": "どうか、あなたの想いで\n神楽ちゃんを支えてあげて\nくださいね。"},
        { "location": "223/SEL"   , "narrator": "", "text": "もちろん"},
        { "location": "224/SEL"   , "narrator": "", "text": "あんたにお願いされる筋合いはない"},
        { "location": "225/ACT"   , "narrator": "", "text": "もちろん"},
        { "location": "226/TALK"  , "narrator": "エリカ", "text": "よかった！"},
        { "location": "227/ACT"   , "narrator": "", "text": "あんたにお願いされる筋合いはない"},
        { "location": "228/TALK"  , "narrator": "エリカ", "text": "ごめんね…。"},
        { "location": "230/TALK"  , "narrator": "エリカ", "text": "そうそう！"},
        { "location": "231/TALK"  , "narrator": "エリカ", "text": "そういえば１つ、\nあなたに伝えておく\nことがあったんだ。"},
        { "location": "232/SEL"   , "narrator": "", "text": "なに？？"},
        { "location": "233/ACT"   , "narrator": "", "text": "なに？？"},
        { "location": "235/TALK"  , "narrator": "エリカ", "text": "前に、綾ちゃんたち\nみんなが使ってる\nスタンプを送ったでしょ？"},
        { "location": "236/TALK"  , "narrator": "エリカ", "text": "でも、その時神楽ちゃんの\nスタンプは送ることが\n出来なくて……。"},
        { "location": "241/TALK"  , "narrator": "エリカ", "text": "それを今回は、\nやっと送ることが\nできたの！"},
        { "location": "242/TALK"  , "narrator": "エリカ", "text": "遅くなっちゃって\nごめんね？"},
        { "location": "243/TALK"  , "narrator": "エリカ", "text": "でも、本当に神楽ちゃん\nらしい、面白いスタンプが\n沢山入ってるから。"},
        { "location": "244/TALK"  , "narrator": "エリカ", "text": "もしかしたらまだ\n見たことがないものも\nあるかもしれないけど――"},
        { "location": "245/TALK"  , "narrator": "エリカ", "text": "そっちに届いたら、\n是非使ってみて欲しいな！"},
        { "location": "250/TALK"  , "narrator": "エリカ", "text": "神楽ちゃんのスタンプで、\n二人の心の距離が\nより近づきますように。"},
        { "location": "251/TALK"  , "narrator": "エリカ", "text": "それじゃ、\n今回もよろしく\nお願いします！"},
        { "location": "197/DIALOG", "narrator": "Tutorial/Dialog_Anime1", "text": "$dialog_word$"},
        { "location": "199/DIALOG", "narrator": "Tutorial/Dialog_Anime2", "text": "$dialog_word$"},
        { "location": "201/DIALOG", "narrator": "Tutorial/Dialog_Anime3", "text": "$dialog_word$"},
        { "location": "203/DIALOG", "narrator": "Tutorial/Dialog_Anime4", "text": "$dialog_word$"},
        { "location": "205/DIALOG", "narrator": "Tutorial/Dialog_Anime5", "text": "$dialog_word$"},
        { "location": "239/DIALOG", "narrator": "Event/Dialog_EventPicWideNW", "text": "神楽のお気に入りスタンプが\nあなたのお手元に！"},
        { "location": "249/DIALOG", "narrator": "URLJUMP", "text": "神楽のスタンプに関する\n情報を見ますか？"}
    ]
}
