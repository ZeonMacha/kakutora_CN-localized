{
    "dir": "chap11/daydra/dd_ch03_11_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "11305",
        "cid": "gabriella",
        "title": "005 メインストーリー",
        "sub_title": "ガブちゃん先輩＜後編＞"
    },
    "entry":
    [
        { "location": "346/SCENARIO", "narrator": "", "text": "ガブちゃん先輩"},
        { "location": "367/TALK"    , "narrator": "ガブリエラ", "text": "…そっか。\nそうよね。"},
        { "location": "368/TALK"    , "narrator": "ガブリエラ", "text": "あたしの気持ちの\n問題だったわ。"},
        { "location": "369/TALK"    , "narrator": "ガブリエラ", "text": "今日こそは、ちゃんと\nつばめに言わなくちゃ…。"},
        { "location": "370/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "371/TALK"    , "narrator": "つばめ", "text": "…え、えっと――"},
        { "location": "373/TALK"    , "narrator": "つばめ", "text": "あ、そういえば、\n今って忙しかったん\nですよね？"},
        { "location": "375/TALK"    , "narrator": "ガブリエラ", "text": "えっ、ええ…。\n夜食にプラツキを\n作ろうと思ったのよ。"},
        { "location": "376/TALK"    , "narrator": "つばめ", "text": "ぷらつき？"},
        { "location": "378/TALK"    , "narrator": "ガブリエラ", "text": "…まあ、知らなくて\n当然よね。"},
        { "location": "379/TALK"    , "narrator": "ガブリエラ", "text": "簡単に言うと、\nお芋を潰して作る\nパンケーキで――"},
        { "location": "380/TALK"    , "narrator": "ガブリエラ", "text": "ポーランドでは\n一般的な料理なのよ。"},
        { "location": "382/TALK"    , "narrator": "つばめ", "text": "ふーん…ポーランド\n料理って、食べたこと\nないかも…。"},
        { "location": "385/TALK"    , "narrator": "ガブリエラ", "text": "…食べたいの？"},
        { "location": "389/TALK"    , "narrator": "つばめ", "text": "えへへ…美味しそう\nだから、食べてみたい\nなぁ…。"},
        { "location": "391/TALK"    , "narrator": "ガブリエラ", "text": "ふぅ…どうにか\n元気出たみたいね…。"},
        { "location": "393/TALK"    , "narrator": "ガブリエラ", "text": "…なら、あんたも\n作るの手伝いなさい。"},
        { "location": "394/TALK"    , "narrator": "ガブリエラ", "text": "あんたのせいで、\nお芋すり潰すのが\n中断したんだから。"},
        { "location": "397/TALK"    , "narrator": "つばめ", "text": "いいの！？"},
        { "location": "399/TALK"    , "narrator": "ガブリエラ", "text": "ええ…あたしも、\nちょっと話したい\nことが――"},
        { "location": "401/TALK"    , "narrator": "つばめ", "text": "？"},
        { "location": "403/TALK"    , "narrator": "ガブリエラ", "text": "な、何でもない！\nほら、さっさと\n作り始めるわよ！"},
        { "location": "426/TALK"    , "narrator": "つばめ", "text": "ううう…て、手が、\nジンジンしてきた\nよぉ…。"},
        { "location": "428/TALK"    , "narrator": "ガブリエラ", "text": "プラツキは作るのが\n大変な料理なのよ。"},
        { "location": "429/TALK"    , "narrator": "ガブリエラ", "text": "美味しいプラツキが\n食べたいなら、\n我慢しなさい。"},
        { "location": "431/TALK"    , "narrator": "つばめ", "text": "は、はい…。"},
        { "location": "436/TALK"    , "narrator": "ガブリエラ", "text": "…どうしようかしら。"},
        { "location": "437/TALK"    , "narrator": "ガブリエラ", "text": "あのこと、言うなら\n今がベストだと\n思うけど――"},
        { "location": "439/TALK"    , "narrator": "ガブリエラ", "text": "らしくない、とか\n思われるかしら？"},
        { "location": "441/TALK"    , "narrator": "ガブリエラ", "text": "でも…いつまでも\nこのままなのは\n嫌だし…。"},
        { "location": "442/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "457/TALK"    , "narrator": "ガブリエラ", "text": "マルザンナ、聞いてほしいことがあるの"},
        { "location": "458/TALK"    , "narrator": "ガブリエラ", "text": "私ね"},
        { "location": "460/TALK"    , "narrator": "ガブリエラ", "text": "つばめに、もうせんぱいって呼ばなくていい、って伝えたいの"},
        { "location": "462/SEL"     , "narrator": "", "text": "いいことだと思う"},
        { "location": "463/ACT"     , "narrator": "", "text": "いいことだと思う"},
        { "location": "465/TALK"    , "narrator": "ガブリエラ", "text": "そう思ってくれるのね//////"},
        { "location": "467/TALK"    , "narrator": "ガブリエラ", "text": "けど、今までつばめにはキツく当たってたでしょう？"},
        { "location": "468/TALK"    , "narrator": "ガブリエラ", "text": "なのに、今更せんぱいって呼ばなくていいとか"},
        { "location": "469/TALK"    , "narrator": "ガブリエラ", "text": "友達になりたいとか言って、大丈夫なのかしら…"},
        { "location": "471/SEL"     , "narrator": "", "text": "つばめが嫌がると思う？"},
        { "location": "472/ACT"     , "narrator": "", "text": "つばめが嫌がると思う？"},
        { "location": "474/TALK"    , "narrator": "ガブリエラ", "text": "あ、そうよね"},
        { "location": "475/TALK"    , "narrator": "ガブリエラ", "text": "それ絶対ありえないわ"},
        { "location": "476/TALK"    , "narrator": "ガブリエラ", "text": "だって、つばめだものね"},
        { "location": "478/TALK"    , "narrator": "ガブリエラ", "text": "今の一言で、すごく心が軽くなった気がするわ"},
        { "location": "479/TALK"    , "narrator": "ガブリエラ", "text": "やっぱり、マルザンナは頼りになる執事ね"},
        { "location": "492/TALK"    , "narrator": "ガブリエラ", "text": "…手を動かしながら\n聞いてちょうだい。"},
        { "location": "494/TALK"    , "narrator": "つばめ", "text": "はい、なんですか？"},
        { "location": "495/TALK"    , "narrator": "ガブリエラ", "text": "…もう、あたしのこと\n先輩って呼ばなくて\nいいから。"},
        { "location": "498/TALK"    , "narrator": "つばめ", "text": "え？　それじゃ、\n何て呼べばいいん\nですか？"},
        { "location": "499/TALK"    , "narrator": "ガブリエラ", "text": "…あんたが呼びたい\nように呼べば？"},
        { "location": "500/TALK"    , "narrator": "ガブリエラ", "text": "あと、敬語で\n話すのもやめていいわ。"},
        { "location": "501/TALK"    , "narrator": "ガブリエラ", "text": "それと――"},
        { "location": "504/TALK"    , "narrator": "ガブリエラ", "text": "ごめんね。\n今まで意地張って、\n辛く当たっちゃって。"},
        { "location": "507/TALK"    , "narrator": "ガブリエラ", "text": "なんか…悔しかった\nのよね…色々と…。"},
        { "location": "509/TALK"    , "narrator": "ガブリエラ", "text": "あたしの幸せを全部、\n根こそぎ奪われちゃう\n気がして――"},
        { "location": "510/TALK"    , "narrator": "ガブリエラ", "text": "すごく怖かったの…。"},
        { "location": "512/TALK"    , "narrator": "ガブリエラ", "text": "アーヤも、神楽も、\nみやびも、あんたの\n味方ばっかして――"},
        { "location": "513/TALK"    , "narrator": "ガブリエラ", "text": "誰も、あんたの謎の\n力を警戒しないし。"},
        { "location": "515/TALK"    , "narrator": "ガブリエラ", "text": "でもあたしは、\nあんたのその謎の\n力と――"},
        { "location": "516/TALK"    , "narrator": "ガブリエラ", "text": "その時に出てくる\n別人みたいな顔が、\nずっと怖かった。"},
        { "location": "517/TALK"    , "narrator": "ガブリエラ", "text": "いつかあたし達を\n壊しちゃうんじゃ\nないか、って…。"},
        { "location": "520/TALK"    , "narrator": "ガブリエラ", "text": "だから、あんたが\n入隊するのに\nずっと反対だったの。"},
        { "location": "521/TALK"    , "narrator": "つばめ", "text": "せんぱい…。"},
        { "location": "524/TALK"    , "narrator": "ガブリエラ", "text": "でもあんたさ、\nそんな性格でしょ？"},
        { "location": "526/TALK"    , "narrator": "ガブリエラ", "text": "あたしがどんだけ\n拒否っても――"},
        { "location": "527/TALK"    , "narrator": "ガブリエラ", "text": "お構いなしでズケズケ\n入り込んでくるし。"},
        { "location": "529/TALK"    , "narrator": "ガブリエラ", "text": "そんなんじゃ、\nどんなに嫌いになろう\nとしたって――"},
        { "location": "531/TALK"    , "narrator": "ガブリエラ", "text": "本気で嫌いになれる\nわけ…ないじゃん。"},
        { "location": "532/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "534/TALK"    , "narrator": "ガブリエラ", "text": "ほら、手が止まってる\nわよ。"},
        { "location": "537/TALK"    , "narrator": "つばめ", "text": "はわわ！"},
        { "location": "539/TALK"    , "narrator": "ガブリエラ", "text": "…だからあたし、\n決めたのよ。"},
        { "location": "541/TALK"    , "narrator": "ガブリエラ", "text": "もっと楽になろう\nって。"},
        { "location": "542/TALK"    , "narrator": "ガブリエラ", "text": "このままじゃ、いつか\n本当に頭がおかしく\nなっちゃいそうだし。"},
        { "location": "544/TALK"    , "narrator": "ガブリエラ", "text": "正直言うとさ、\nまだあんたのことは\n怖い。"},
        { "location": "545/TALK"    , "narrator": "ガブリエラ", "text": "あたしもいつか、\nあんたにクランを\n引き抜かれて――"},
        { "location": "546/TALK"    , "narrator": "ガブリエラ", "text": "潰されちゃう日が\n来るんじゃないか、\nって不安だし…。"},
        { "location": "547/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "549/TALK"    , "narrator": "ガブリエラ", "text": "けど、もしそんな\nことになったら――"},
        { "location": "551/TALK"    , "narrator": "ガブリエラ", "text": "あたしが容赦なく\n張り倒して止めれば\nいい、って思ったの。"},
        { "location": "552/TALK"    , "narrator": "ガブリエラ", "text": "その方がきっと、\n今よりずっとラクに\nなれるもの。"},
        { "location": "554/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "557/TALK"    , "narrator": "つばめ", "text": "…嬉しいです、\nせんぱい。"},
        { "location": "560/TALK"    , "narrator": "つばめ", "text": "じゃなくて…、\nガブちゃん、って\n呼んでいい？"},
        { "location": "564/TALK"    , "narrator": "ガブリエラ", "text": "べ、別に…呼びたい\nように呼んでいいわ。"},
        { "location": "565/TALK"    , "narrator": "つばめ", "text": "えへへ…ありがと。\nそれじゃ…、\nガブちゃん。"},
        { "location": "567/TALK"    , "narrator": "つばめ", "text": "わたしも自分の力の\nこと、もっとちゃんと\n調べるね。"},
        { "location": "568/TALK"    , "narrator": "つばめ", "text": "ガブちゃんや\nみんなに、心配を\nかけないように。"},
        { "location": "569/TALK"    , "narrator": "つばめ", "text": "あと、ガブちゃんに\nお願いしたいことが\nあるの。"},
        { "location": "570/TALK"    , "narrator": "つばめ", "text": "もしまた、ドーム戦の\n時みたいなことを\nやろうとしたら――"},
        { "location": "571/TALK"    , "narrator": "つばめ", "text": "本当に、本気で\nわたしを止めて\nほしいんだ。"},
        { "location": "573/TALK"    , "narrator": "つばめ", "text": "ドーム戦でわたしが\n壊しちゃった子の\nこと――"},
        { "location": "575/TALK"    , "narrator": "つばめ", "text": "全然思い出せないん\nだけど、だからこそ、\n今でもすごく辛いの。"},
        { "location": "577/TALK"    , "narrator": "つばめ", "text": "もう二度と、\nあんな思いしたく\nないから…。"},
        { "location": "581/TALK"    , "narrator": "ガブリエラ", "text": "…わかったわ。\nそういうことなら\n任せて。"},
        { "location": "583/TALK"    , "narrator": "ガブリエラ", "text": "おもいっきり\nぶん殴って、\n止めてやるから！"},
        { "location": "585/TALK"    , "narrator": "つばめ", "text": "えへへ、お手柔らかに\nお願いします。"},
        { "location": "588/TALK"    , "narrator": "ガブリエラ", "text": "考えておくわ。"},
        { "location": "590/TALK"    , "narrator": "ガブリエラ", "text": "っていうか、\nあんた芋潰し過ぎ！"},
        { "location": "594/TALK"    , "narrator": "つばめ", "text": "えっ…あっ！"},
        { "location": "597/TALK"    , "narrator": "つばめ", "text": "えへへ、\nごめんなさい。"},
        { "location": "600/TALK"    , "narrator": "ガブリエラ", "text": "本当、何やっても\nドジなんだから…。"},
        { "location": "611/DIALOG"  , "narrator": "Dialog_chapter_ch03", "text": "【09 パーフェクトイエロー】"}
    ]
}
