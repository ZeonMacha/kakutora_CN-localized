{
    "dir": "chap16/daydra/dd_ch01_16_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "16152",
        "cid": "tsubame",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "二人きり"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "二人きり"},
        { "location": "23/TALK"   , "narrator": "つばめ", "text": "キリトくん。\nひなこちゃん達から\n連絡来た？"},
        { "location": "27/TALK"   , "narrator": "キリト", "text": "ああ、今丁度、\n学園を出たってさ。"},
        { "location": "28/TALK"   , "narrator": "つばめ", "text": "そっか…もう少し\nかかりそうだね。"},
        { "location": "29/TALK"   , "narrator": "キリト", "text": "だな…しっかし、\n逢瀬と二人きりって\n結構珍しい気が――"},
        { "location": "31/TALK"   , "narrator": "キリト", "text": "…っていうか、初めてか？"},
        { "location": "33/TALK"   , "narrator": "つばめ", "text": "えっ…？"},
        { "location": "35/TALK"   , "narrator": "つばめ", "text": "そういえば、キリトくんと\n二人きりって、今まで\nなかったかも。"},
        { "location": "37/TALK"   , "narrator": "つばめ", "text": "そ、そうだね。\n言われるまで\n気づかなかったよ。"},
        { "location": "39/TALK"   , "narrator": "キリト", "text": "結構付き合い長いのに、\n意外だな。"},
        { "location": "40/TALK"   , "narrator": "キリト", "text": "でも考えてみりゃ、\nいつもはひなこか繭辺りが\n一緒だからなぁ…。"},
        { "location": "42/TALK"   , "narrator": "つばめ", "text": "うん…そうだね。"},
        { "location": "43/TALK"   , "narrator": "キリト", "text": "…………。"},
        { "location": "45/TALK"   , "narrator": "キリト", "text": "やべぇ、余計なこと\n言っちまったか…？"},
        { "location": "47/TALK"   , "narrator": "キリト", "text": "飲み物、追加でもするか？"},
        { "location": "49/TALK"   , "narrator": "つばめ", "text": "う、うん…そうだね。"},
        { "location": "52/TALK"   , "narrator": "キリト", "text": "やっぱり…逢瀬のやつ、\nメチャクチャ緊張しち\nまってる…。"},
        { "location": "53/TALK"   , "narrator": "キリト", "text": "普段普通に喋ってるから、\n気を抜き過ぎちまったか。"},
        { "location": "56/TALK"   , "narrator": "つばめ", "text": "…………。"},
        { "location": "59/TALK"   , "narrator": "キリト", "text": "でも…なんか、こうして\n改めて見ると――"},
        { "location": "61/TALK"   , "narrator": "キリト", "text": "逢瀬って結構美人で\n可愛いかも――"},
        { "location": "65/TALK"   , "narrator": "キリト", "text": "いやいや、そうじゃない！"},
        { "location": "67/TALK"   , "narrator": "つばめ", "text": "えっ！？　な、なにが！？"},
        { "location": "70/TALK"   , "narrator": "キリト", "text": "あ、いや…。"},
        { "location": "72/TALK"   , "narrator": "キリト", "text": "ダメだ、ここは男の俺が\nしっかりしないと！"},
        { "location": "74/TALK"   , "narrator": "キリト", "text": "お、逢瀬は…えっと…。"},
        { "location": "75/TALK"   , "narrator": "つばめ", "text": "…………。"},
        { "location": "78/TALK"   , "narrator": "キリト", "text": "何かないか？\nこの重い空気を払える、\n盛り上がれる話題は…。"},
        { "location": "81/TALK"   , "narrator": "キリト", "text": "…そ、そうだ！\n逢瀬は戦艦のこと\nどう思う？"},
        { "location": "83/TALK"   , "narrator": "つばめ", "text": "え？　戦艦って、\nキリトくんの好きな\nあの戦艦？"},
        { "location": "84/TALK"   , "narrator": "キリト", "text": "そうそう。"},
        { "location": "85/TALK"   , "narrator": "キリト", "text": "あ、言っとくけど\n擬人化した奴じゃねぇ\nからな？"},
        { "location": "87/TALK"   , "narrator": "つばめ", "text": "ギジンカ？"},
        { "location": "89/TALK"   , "narrator": "キリト", "text": "あ、いや…知らないなら\n良いんだ。\n気にしないでくれ。"},
        { "location": "90/TALK"   , "narrator": "キリト", "text": "それより、逢瀬は戦艦の\nことをどう思う！？"},
        { "location": "92/TALK"   , "narrator": "つばめ", "text": "どうって…どうかなぁ？\nよくわからないかも…。"},
        { "location": "95/TALK"   , "narrator": "キリト", "text": "って、当然だよ！\n何やってんだよ俺！？"},
        { "location": "96/TALK"   , "narrator": "キリト", "text": "逢瀬が戦艦のことなんか\n知ってるわけねぇじゃん！"},
        { "location": "98/TALK"   , "narrator": "つばめ", "text": "…………。"},
        { "location": "99/TALK"   , "narrator": "キリト", "text": "ああ、余計に逢瀬が\n気まずそうな感じに\nなっちまった…。"},
        { "location": "101/TALK"  , "narrator": "キリト", "text": "てか、これドン引きって\nやつなのか？\n俺、引かれちまったか！？"},
        { "location": "104/TALK"  , "narrator": "キリト", "text": "あ～…えっと…。"},
        { "location": "106/TALK"  , "narrator": "つばめ", "text": "キリトくん、わたしのこと\n気にして話しかけてきて\nくれてるのに――"},
        { "location": "107/TALK"  , "narrator": "つばめ", "text": "戦艦のことなんて、\nどう聞けばいいか\nわからないよぉ…。"},
        { "location": "119/TALK"  , "narrator": "つばめ", "text": "お願い、一緒に考えて"},
        { "location": "122/SEL"   , "narrator": "", "text": "つばめ、慌て過ぎ"},
        { "location": "123/ACT"   , "narrator": "", "text": "つばめ、慌て過ぎ"},
        { "location": "125/TALK"  , "narrator": "つばめ", "text": "だって、緊張しちゃって…"},
        { "location": "126/TALK"  , "narrator": "つばめ", "text": "それに、戦艦のこと知らないから、なんて聞けばいいかわからないよ"},
        { "location": "128/SEL"   , "narrator": "", "text": "戦艦のどこが好きなのかな？"},
        { "location": "129/SEL"   , "narrator": "", "text": "戦艦で戦ってみたいのかな？"},
        { "location": "130/ACT"   , "narrator": "", "text": "戦艦のどこが好きなのかな？"},
        { "location": "132/TALK"  , "narrator": "つばめ", "text": "ありがと、それ聞いてみる"},
        { "location": "145/TALK"  , "narrator": "つばめ", "text": "キリトくんは、\n戦艦のどこが好きなの？"},
        { "location": "146/TALK"  , "narrator": "キリト", "text": "えっ？　そうだなぁ…。"},
        { "location": "147/TALK"  , "narrator": "キリト", "text": "見た目は譲れねぇな。\nそこにあるだけで\n超かっこいいからな。"},
        { "location": "148/TALK"  , "narrator": "つばめ", "text": "うんうん。"},
        { "location": "150/TALK"  , "narrator": "キリト", "text": "こう、普通の船と違って、\n船全体が装甲に覆われた\nところとか――"},
        { "location": "151/TALK"  , "narrator": "キリト", "text": "大きな砲門がいくつも\n載った重量感とか、\nマジ半端ねぇよな！"},
        { "location": "152/TALK"  , "narrator": "キリト", "text": "それに、全体を包む\n汗と油の染みついた\n男臭いオーラ…。"},
        { "location": "153/TALK"  , "narrator": "キリト", "text": "そんなのが大海原で\n主砲やら対空砲ぶっ放して\n戦うんだぜ？"},
        { "location": "155/TALK"  , "narrator": "キリト", "text": "マジかっこよ過ぎるだろ、\nって話さ！"},
        { "location": "157/TALK"  , "narrator": "つばめ", "text": "男臭さ…確かに、戦艦って\n男の子っぽい感じがする\nかも。"},
        { "location": "158/TALK"  , "narrator": "キリト", "text": "でもよ、実は女の名前が\n多いんだぜ？"},
        { "location": "159/TALK"  , "narrator": "つばめ", "text": "えぇっ、そうなの！？"},
        { "location": "160/TALK"  , "narrator": "キリト", "text": "そもそも船ってのは、\n女として見られてる\nからな。"},
        { "location": "161/TALK"  , "narrator": "つばめ", "text": "えっ…あっ、そっか！\nだから姉妹艦って\nいうんだ！"},
        { "location": "162/TALK"  , "narrator": "つばめ", "text": "兄弟艦、って呼び方、\n聞いたことないもん。"},
        { "location": "164/TALK"  , "narrator": "キリト", "text": "なっ、先に言われた！？\n俺がかっこよく教えようと\n思ってたのに！"},
        { "location": "165/TALK"  , "narrator": "つばめ", "text": "えへへ…でも、凄いなぁ。\nキリトくんって、\n本当に好きなんだね？"},
        { "location": "166/TALK"  , "narrator": "キリト", "text": "おう！　戦艦に対する\n熱き想いは誰にも\n負ける気しねぇぜ！！"},
        { "location": "167/TALK"  , "narrator": "キリト", "text": "そうだ、今度俺お勧めの\n戦艦映画を…。"},
        { "location": "168/TALK"  , "narrator": "雛", "text": "熱過ぎるから！"},
        { "location": "172/TALK"  , "narrator": "キリト", "text": "っ！？\nひなこ！"},
        { "location": "175/TALK"  , "narrator": "繭", "text": "この席の周りだけ、\nバカみたいに\n蒸し暑いんだけど？"},
        { "location": "177/TALK"  , "narrator": "つばめ", "text": "ひなこちゃん、まゆちん。\nやっと到着だね。"},
        { "location": "179/TALK"  , "narrator": "雛", "text": "いやー、お待たせ\nしちゃってごめんねー。"},
        { "location": "181/TALK"  , "narrator": "雛", "text": "っていうか、キリト。\n何で戦艦の話なんて\nしてんの？"},
        { "location": "183/TALK"  , "narrator": "キリト", "text": "いや、何でって…。"},
        { "location": "186/TALK"  , "narrator": "キリト", "text": "やべぇ…つい楽しくて\n熱くなり過ぎた！"},
        { "location": "187/TALK"  , "narrator": "つばめ", "text": "で、でも、面白かったよ。\n全部は理解できなかった\nけど…。"},
        { "location": "188/TALK"  , "narrator": "雛", "text": "あー、ストップストップ！\n汗と油の染みつきそうな\n戦艦トークはおしまい！"},
        { "location": "189/TALK"  , "narrator": "雛", "text": "女子トークのシャワーで\n綺麗に洗い流すよ。"},
        { "location": "191/TALK"  , "narrator": "キリト", "text": "…やっぱ、女の子にする\n話じゃなかったよな？"},
        { "location": "192/TALK"  , "narrator": "繭", "text": "聞くまでもない。"},
        { "location": "193/TALK"  , "narrator": "繭", "text": "カフェで女子とお茶しな\nがら、延々と戦艦について\n話すとか――"},
        { "location": "194/TALK"  , "narrator": "繭", "text": "マジないわ、ってレベル。\nドン引きされて帰られて\nないのが奇跡だから。"},
        { "location": "196/TALK"  , "narrator": "キリト", "text": "…こんなんだから俺、\nモテないんだろうなぁ。"},
        { "location": "197/ACT"   , "narrator": "", "text": "戦艦で戦ってみたいのかな？"},
        { "location": "198/TALK"  , "narrator": "つばめ", "text": "男の子だからそうなのかも"},
        { "location": "211/TALK"  , "narrator": "つばめ", "text": "戦艦に乗って戦いたい、\nってことかな？"},
        { "location": "212/TALK"  , "narrator": "キリト", "text": "ん～…時々言われるけど、\nそうじゃねぇんだよなぁ。"},
        { "location": "214/TALK"  , "narrator": "つばめ", "text": "違うの？"},
        { "location": "215/TALK"  , "narrator": "キリト", "text": "いや、確かに戦艦で\n海に出てさ――"},
        { "location": "216/TALK"  , "narrator": "キリト", "text": "そこで主砲の一発でも\n撃てたら、そりゃ最高の\n思い出になるだろうさ。"},
        { "location": "217/TALK"  , "narrator": "キリト", "text": "けど…戦いたい、って\nわけじゃないんだよ…。"},
        { "location": "218/TALK"  , "narrator": "キリト", "text": "それに、戦闘で戦艦が\n壊れるところも、\n見たくないしな…。"},
        { "location": "219/TALK"  , "narrator": "つばめ", "text": "…そっか。"},
        { "location": "221/TALK"  , "narrator": "つばめ", "text": "戦艦のこと、本当に\n大好きで大切に思ってるん\nだね。"},
        { "location": "226/TALK"  , "narrator": "キリト", "text": "…………。"},
        { "location": "227/TALK"  , "narrator": "つばめ", "text": "…キリトくん？"},
        { "location": "230/TALK"  , "narrator": "キリト", "text": "いや、やっぱり違う！"},
        { "location": "231/TALK"  , "narrator": "キリト", "text": "壊れてる戦艦だって、\nメチャクチャ\nかっこいいんだ！"},
        { "location": "233/TALK"  , "narrator": "つばめ", "text": "えぇっ！？"},
        { "location": "235/TALK"  , "narrator": "キリト", "text": "激しい戦闘で半壊しても、\n沈まずに航行してるやつ\nとか――"},
        { "location": "236/TALK"  , "narrator": "キリト", "text": "海底で眠るように沈んだ\n戦艦なんかもな、味が\nあってかっこいいんだよ！"},
        { "location": "237/TALK"  , "narrator": "つばめ", "text": "でも、さっきは壊れた\n戦艦を見るのが嫌だ、って\n言ってたのに…。"},
        { "location": "238/TALK"  , "narrator": "キリト", "text": "わかってる。\n超矛盾してるよな？"},
        { "location": "239/TALK"  , "narrator": "キリト", "text": "けど、マジでいいんだよ！\nなんか見てるとさ、グッと\n来るのもあるんだぜ？"},
        { "location": "240/TALK"  , "narrator": "つばめ", "text": "…そうなんだ。"},
        { "location": "242/TALK"  , "narrator": "キリト", "text": "…あ、やべぇ。\nつい熱が入っちまった…。"},
        { "location": "243/TALK"  , "narrator": "つばめ", "text": "キリトくんって…。"},
        { "location": "245/TALK"  , "narrator": "つばめ", "text": "本当に、戦艦が\n大好きなんだね。"},
        { "location": "246/TALK"  , "narrator": "キリト", "text": "…え？"},
        { "location": "247/TALK"  , "narrator": "つばめ", "text": "壊れるところを見たいとは\n思わないのに――"},
        { "location": "248/TALK"  , "narrator": "つばめ", "text": "壊れた戦艦も、かっこいい\nって言えるんだもん。"},
        { "location": "249/TALK"  , "narrator": "つばめ", "text": "どんな状態でも好きって\n言えるなんて、すごく\n素敵だと思う。"},
        { "location": "251/TALK"  , "narrator": "キリト", "text": "…そ、そうか。"},
        { "location": "252/TALK"  , "narrator": "つばめ", "text": "うん。戦艦に対する\nキリトくんの気持ち、\n沢山伝わったよ。"},
        { "location": "256/TALK"  , "narrator": "キリト", "text": "…ヤベェ。"},
        { "location": "257/TALK"  , "narrator": "キリト", "text": "こんなふうに言って\nもらうの初めてで、\nなんか感激してきた。"},
        { "location": "261/TALK"  , "narrator": "キリト", "text": "…ありがとな。\n少し恥ずかしいけど、\n嬉しいぜ。"},
        { "location": "262/TALK"  , "narrator": "雛", "text": "恥ずかしがるところが\n違うでしょ！？"},
        { "location": "268/TALK"  , "narrator": "キリト", "text": "っ！？\nひなこ！"},
        { "location": "271/TALK"  , "narrator": "繭", "text": "女の子相手に熱い戦艦\nトークとか、マジないわ。"},
        { "location": "273/TALK"  , "narrator": "つばめ", "text": "ひなこちゃん、まゆちん。\nやっと到着だね。"},
        { "location": "275/TALK"  , "narrator": "雛", "text": "いやー、お待たせ\nしちゃってごめんねー。"},
        { "location": "276/TALK"  , "narrator": "雛", "text": "…まあ、退屈はして\nなかったみたいだけど。"},
        { "location": "277/TALK"  , "narrator": "つばめ", "text": "うん、キリトくんが\n戦艦のこと、いっぱい\nお話ししてくれたからね。"},
        { "location": "281/TALK"  , "narrator": "キリト", "text": "あ、ああ…まあな。"},
        { "location": "282/TALK"  , "narrator": "繭", "text": "女子とカフェで二人きり。\nそんなシチュエーションで\n戦艦トークとか――"},
        { "location": "283/TALK"  , "narrator": "繭", "text": "逢瀬さんじゃなかったら、\n確実にドン引きされて\n帰られてたと思う。"},
        { "location": "284/TALK"  , "narrator": "キリト", "text": "いや、わかってる！\nわかってはいたんだ！"},
        { "location": "286/TALK"  , "narrator": "キリト", "text": "けど、いい感じの質問を\nされちまって、\nつい抑えられなくて…。"},
        { "location": "287/TALK"  , "narrator": "つばめ", "text": "それだけ戦艦のことが\n好きって証拠だよ。"},
        { "location": "289/TALK"  , "narrator": "キリト", "text": "…………。"},
        { "location": "291/TALK"  , "narrator": "キリト", "text": "こんなんだから、\n俺ってモテないんだろう\nなぁ…とほほ。"},
        { "location": "22/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>7月21日　3:20 PM</color>\nとある平日の放課後、某カフェにて。"}
    ]
}
