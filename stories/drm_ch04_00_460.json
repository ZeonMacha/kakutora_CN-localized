    [
        { "location": "7/SCENARIO", "narrator": "", "text": "380_妹のいる景色"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "知っちゅうかよ"},
        { "location": "33/TALK"   , "narrator": "みやび", "text": "うちは長女ちや"},
        { "location": "35/SEL"    , "narrator": "", "text": "そうなんだ"},
        { "location": "36/SEL"    , "narrator": "", "text": "知ってたよ"},
        { "location": "37/ACT"    , "narrator": "", "text": "そうなんだ"},
        { "location": "38/TALK"   , "narrator": "みやび", "text": "そうなのだ"},
        { "location": "39/ACT"    , "narrator": "", "text": "知ってたよ"},
        { "location": "40/TALK"   , "narrator": "みやび", "text": "知っちゅうがかよ"},
        { "location": "42/TALK"   , "narrator": "みやび", "text": "そんで"},
        { "location": "43/TALK"   , "narrator": "みやび", "text": "妹がおったぞね"},
        { "location": "45/SEL"    , "narrator": "", "text": "それは初耳"},
        { "location": "46/SEL"    , "narrator": "", "text": "知らなかった"},
        { "location": "47/SEL"    , "narrator": "", "text": "もしかして秘密にしてた？"},
        { "location": "48/ACT"    , "narrator": "", "text": "それは初耳"},
        { "location": "49/TALK"   , "narrator": "みやび", "text": "言ってなかったしな"},
        { "location": "50/ACT"    , "narrator": "", "text": "知らなかった"},
        { "location": "51/TALK"   , "narrator": "みやび", "text": "そうやろうね"},
        { "location": "52/ACT"    , "narrator": "", "text": "もしかして秘密にしてた？"},
        { "location": "62/TALK"   , "narrator": "みやび", "text": "まあ"},
        { "location": "63/TALK"   , "narrator": "みやび", "text": "そんなところぞね"},
        { "location": "65/TALK"   , "narrator": "みやび", "text": "当直の日は"},
        { "location": "66/TALK"   , "narrator": "みやび", "text": "ちょうど妹関連の行事が予定されていたぞね"},
        { "location": "67/TALK"   , "narrator": "みやび", "text": "けんど"},
        { "location": "69/TALK"   , "narrator": "みやび", "text": "それを言うのは"},
        { "location": "71/TALK"   , "narrator": "みやび", "text": "いや"},
        { "location": "72/TALK"   , "narrator": "みやび", "text": "言いたくなかったぞね"},
        { "location": "74/SEL"    , "narrator": "", "text": "そうだったんだ"},
        { "location": "75/SEL"    , "narrator": "", "text": "ごめん"},
        { "location": "76/ACT"    , "narrator": "", "text": "そうだったんだ"},
        { "location": "77/TALK"   , "narrator": "みやび", "text": "あ"},
        { "location": "78/TALK"   , "narrator": "みやび", "text": "言いたくなかったのは"},
        { "location": "79/TALK"   , "narrator": "みやび", "text": "トライナリーのメンバーにだ"},
        { "location": "80/TALK"   , "narrator": "みやび", "text": "$handle$には"},
        { "location": "81/TALK"   , "narrator": "みやび", "text": "感謝しているぞね"},
        { "location": "82/ACT"    , "narrator": "", "text": "ごめん"},
        { "location": "83/TALK"   , "narrator": "みやび", "text": "いんや"},
        { "location": "84/TALK"   , "narrator": "みやび", "text": "そうでなく"},
        { "location": "85/TALK"   , "narrator": "みやび", "text": "言いたくなかったのは"},
        { "location": "86/TALK"   , "narrator": "みやび", "text": "トライナリーのメンバーにだ"},
        { "location": "87/TALK"   , "narrator": "みやび", "text": "誤解を招く言い方をしたちや"},
        { "location": "88/TALK"   , "narrator": "みやび", "text": "ごめんや"},
        { "location": "89/TALK"   , "narrator": "みやび", "text": "それと"},
        { "location": "91/TALK"   , "narrator": "みやび", "text": "ありがとう"},
        { "location": "95/TALK"   , "narrator": "みやび", "text": "礼の印だ"},
        { "location": "96/TALK"   , "narrator": "みやび", "text": "受けとれい"},
        { "location": "99/TALK"   , "narrator": "ボイスメール", "text": "虹の向こうの空遠く"},
        { "location": "58/DIALOG" , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>900pt.</b></color></size>\nアップしました！"},
        { "location": "111/DIALOG", "narrator": "Dialog_GETVoice", "text": "<color=green>【みやび】</color>のボイスメール\n<color=red>【虹の向こうの空遠く】</color>\nをゲットしました！"}
