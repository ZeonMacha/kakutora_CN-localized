    "entry":
    [
        { "location": "2671/SCENARIO", "narrator": "", "text": "おはようコールドスリーパー"},
        { "location": "2696/TALK"    , "narrator": "神楽", "text": "ある朝目が覚めたら"},
        { "location": "2697/TALK"    , "narrator": "神楽", "text": "セカイは水没していたのです"},
        { "location": "2698/TALK"    , "narrator": "神楽", "text": "私の住む高層マンションの最上階を除いて"},
        { "location": "2700/SEL"     , "narrator": "", "text": "$me$と神楽の二人きりの世界で生きてゆこう"},
        { "location": "2701/SEL"     , "narrator": "", "text": "物理法則を無視してる"},
        { "location": "2702/SEL"     , "narrator": "", "text": "最後は夢オチ？"},
        { "location": "2703/ACT"     , "narrator": "", "text": "$me$と神楽の二人きりの世界で生きてゆこう"},
        { "location": "2705/TALK"    , "narrator": "神楽", "text": "うんうん♪"},
        { "location": "2707/TALK"    , "narrator": "神楽", "text": "二人で地球の終わりを見守ろうね♪"},
        { "location": "2708/ACT"     , "narrator": "", "text": "物理法則を無視してる"},
        { "location": "2709/TALK"    , "narrator": "神楽", "text": "科学的根拠なんてちぎって捨てろ！"},
        { "location": "2710/ACT"     , "narrator": "", "text": "最後は夢オチ？"},
        { "location": "2711/TALK"    , "narrator": "神楽", "text": "あーいるいる落語とかで先にオチ言っちゃう人"},
        { "location": "2713/TALK"    , "narrator": "神楽", "text": "野暮にもほどがあるザンスー"},
        { "location": "2715/TALK"    , "narrator": "神楽", "text": "水没した都市が舞台のディストピアはＳＦに溢れてるけど"},
        { "location": "2716/TALK"    , "narrator": "神楽", "text": "フェノメノンが発生しまくってる今の状況もある意味ＳＦ的かつディストピアだと思うぴょん"},
        { "location": "2717/TALK"    , "narrator": "神楽", "text": "それをどうにかするためにぴょんこは存在してるんだけどね☆彡"}
    ]
