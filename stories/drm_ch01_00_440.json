        "title": "らぶとーく 第44話",
        "sub_title": "どうにもならないことだってある"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "どうにもならないことだってある"},
        { "location": "19/TALK"   , "narrator": "つばめ", "text": "はぁ…。"},
        { "location": "22/TALK"   , "narrator": "アーヤ", "text": "つばめ、大丈夫？\n元気なさそうだけど…。"},
        { "location": "24/TALK"   , "narrator": "つばめ", "text": "アーヤさん…。\nいえ、大丈夫です。"},
        { "location": "25/TALK"   , "narrator": "アーヤ", "text": "そう…私の考え過ぎ\nだったかしら？"},
        { "location": "26/TALK"   , "narrator": "アーヤ", "text": "みやびに言われたことを\n考えて――"},
        { "location": "27/TALK"   , "narrator": "アーヤ", "text": "落ち込んでるん\nじゃないか、って\n思ったんだけど…。"},
        { "location": "28/TALK"   , "narrator": "つばめ", "text": "えっ…知ってたんですか？"},
        { "location": "30/TALK"   , "narrator": "アーヤ", "text": "やっぱりね…。\nみやびも気にしてたわ。"},
        { "location": "31/TALK"   , "narrator": "アーヤ", "text": "つばめを困らせて\nしまったかもしれない、\nってね。"},
        { "location": "32/TALK"   , "narrator": "つばめ", "text": "そうだったんですか…。"},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "まあ、つばめが卯月の\nことを心配しているのは\nわかるんだけど――"},
        { "location": "34/TALK"   , "narrator": "アーヤ", "text": "みやびも言った通り、\nあまり思いつめたり、\n肩入れし過ぎるのは――"},
        { "location": "35/TALK"   , "narrator": "アーヤ", "text": "つばめのために\nならないわ。"},
        { "location": "36/TALK"   , "narrator": "アーヤ", "text": "わかってても、\nわからなくなる…。"},
        { "location": "38/TALK"   , "narrator": "アーヤ", "text": "それが人の気持ちって\nやつなんだから。"},
        { "location": "39/TALK"   , "narrator": "つばめ", "text": "わかってても、\nわからなくなる…ですか？"},
        { "location": "40/TALK"   , "narrator": "アーヤ", "text": "そうよ。"},
        { "location": "41/TALK"   , "narrator": "アーヤ", "text": "だから、あまり考え過ぎ\nない方が、私もいいと\n思うわ。"},
        { "location": "42/SEL"    , "narrator": "", "text": "だから知りたくなるんだよね"},
        { "location": "43/SEL"    , "narrator": "", "text": "わからないままにするのも手かな"},
        { "location": "44/SEL"    , "narrator": "", "text": "答える義理はないと思う"},
        { "location": "46/TALK"   , "narrator": "つばめ", "text": "…アーヤさんも、\nみやびさんと同じ\n考えなんだ…。"},
        { "location": "47/TALK"   , "narrator": "つばめ", "text": "やっぱり、そういうもの\nなのかな？"},
        { "location": "48/TALK"   , "narrator": "つばめ", "text": "わたし、肩入れし過ぎ\nなのかな？"},
        { "location": "52/TALK"   , "narrator": "アーヤ", "text": "…って、ごめんね。\n余計落ち込ませるような\nこと言ったかしら？"},
        { "location": "53/TALK"   , "narrator": "つばめ", "text": "いえ、そんなこと\nないです。"},
        { "location": "54/TALK"   , "narrator": "つばめ", "text": "アーヤさんも\nみやびさんも――"},
        { "location": "55/TALK"   , "narrator": "つばめ", "text": "わたしのことを想って\n言ってくれてるの、\nちゃんとわかりますし。"},
        { "location": "56/TALK"   , "narrator": "アーヤ", "text": "そう…よかった。"},
        { "location": "57/TALK"   , "narrator": "アーヤ", "text": "とりあえず、そのことを\n忘れないでね。"},
        { "location": "61/TALK"   , "narrator": "つばめ", "text": "…………。"},
        { "location": "63/TALK"   , "narrator": "つばめ", "text": "本当、どうするのが\n正しいのかな？"},
        { "location": "65/ACT"    , "narrator": "", "text": "だから知りたくなるんだよね"},
        { "location": "83/TALK"   , "narrator": "つばめ", "text": "ぅん"},
        { "location": "84/TALK"   , "narrator": "つばめ", "text": "その通りだと思ぅよ"},
        { "location": "96/TALK"   , "narrator": "つばめ", "text": "でも、そうなるからこそ、\n知りたいんだと思います。"},
        { "location": "97/TALK"   , "narrator": "つばめ", "text": "わかっててもわからなく\nなるようなことに\nならないためにも――"},
        { "location": "98/TALK"   , "narrator": "つばめ", "text": "しっかりと知っておき\nたいんです。"},
        { "location": "99/TALK"   , "narrator": "アーヤ", "text": "…なるほどね。"},
        { "location": "100/TALK"  , "narrator": "つばめ", "text": "…間違ってますか？"},
        { "location": "101/TALK"  , "narrator": "アーヤ", "text": "さあ、どうかしら？"},
        { "location": "102/TALK"  , "narrator": "アーヤ", "text": "ただ、知りたくなる、\nっていうのは、\nつばめの気持ちよね？"},
        { "location": "103/TALK"  , "narrator": "アーヤ", "text": "でも、相手が気持ちを\n知られたくなくて、\n隠してる場合――"},
        { "location": "104/TALK"  , "narrator": "アーヤ", "text": "それは、間違ったことに\nなると思うわ。"},
        { "location": "107/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "108/TALK"  , "narrator": "アーヤ", "text": "まあ、だからって\n納得するとは思えない\nけど――"},
        { "location": "109/TALK"  , "narrator": "アーヤ", "text": "どうにもならないことも\nある、っていうのは\n覚えておいてね…じゃあ。"},
        { "location": "113/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "115/TALK"  , "narrator": "つばめ", "text": "卯月さんは、知られたく\nないと思ってるのかな？"},
        { "location": "116/ACT"   , "narrator": "", "text": "わからないままにするのも手かな"},
        { "location": "134/TALK"  , "narrator": "つばめ", "text": "ダメだよ(´・ω・｀)"},
        { "location": "135/TALK"  , "narrator": "つばめ", "text": "わからなぃままになんてしたくなぃ！"},
        { "location": "147/TALK"  , "narrator": "つばめ", "text": "…アーヤさんには、\n分からない気持ちって\nあるんですか？"},
        { "location": "148/TALK"  , "narrator": "アーヤ", "text": "…もちろんよ。"},
        { "location": "149/TALK"  , "narrator": "アーヤ", "text": "人間、わからない気持ちが\nあるのが普通なんじゃない\nかしら？"},
        { "location": "150/TALK"  , "narrator": "アーヤ", "text": "相手の気持ちなんて、\n目に見えて触れられる\nものじゃないんだし――"},
        { "location": "151/TALK"  , "narrator": "アーヤ", "text": "逆に、全部わかる、なんて\nいう人は信じられないわ。"},
        { "location": "153/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "154/TALK"  , "narrator": "アーヤ", "text": "納得しろとは言わない\nけど、どうにもならない\nこともある――"},
        { "location": "155/TALK"  , "narrator": "アーヤ", "text": "それを覚えておいて\nもらえればいいわ。"},
        { "location": "158/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "161/TALK"  , "narrator": "つばめ", "text": "卯月さんは、知られたく\nないと思ってるのかな？"},
        { "location": "162/ACT"   , "narrator": "", "text": "答える義理はないと思う"},
        { "location": "180/TALK"  , "narrator": "つばめ", "text": "そぅぃぅわけにはぃかなぃよ"},
        { "location": "181/TALK"  , "narrator": "つばめ", "text": "聞かれたことには答えなきゃ"},
        { "location": "193/TALK"  , "narrator": "つばめ", "text": "…もし、アーヤさんの\n言うような状況に\nなったとしたら――"},
        { "location": "194/TALK"  , "narrator": "つばめ", "text": "聞けばいいと思います。"},
        { "location": "195/TALK"  , "narrator": "アーヤ", "text": "聞くって、本人に\nあなたの気持ちを教えて、\nって聞くつもり？"},
        { "location": "196/TALK"  , "narrator": "つばめ", "text": "はい。\nそれが一番早いし、\n確実だと思いますし…。"},
        { "location": "198/TALK"  , "narrator": "アーヤ", "text": "はぁ…。"},
        { "location": "199/TALK"  , "narrator": "アーヤ", "text": "つばめ…あなたって、\nちょっと前向き過ぎるわ。"},
        { "location": "200/TALK"  , "narrator": "つばめ", "text": "そ、そうですか？"},
        { "location": "201/TALK"  , "narrator": "アーヤ", "text": "ええ…どうにもならない\nことだってある、って\nいうことも――"},
        { "location": "202/TALK"  , "narrator": "アーヤ", "text": "知っておいた方がいいわ。\nあなたのためにもね。"},
        { "location": "206/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "208/TALK"  , "narrator": "つばめ", "text": "…前向きなのって、\nいけないことなのかな？"},
        { "location": "17/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>8月某日　 9:12 PM</color>\n合宿中、みやびの実家でのこと"}
    ]
}
