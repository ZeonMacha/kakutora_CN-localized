{
    "dir": "chap17/daydra/dd_ch03_17_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "17352",
        "cid": "gabriella",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "休みを増やせ"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "休みを増やせ"},
        { "location": "28/TALK"   , "narrator": "真幌", "text": "休みを増やせ、だと？"},
        { "location": "30/TALK"   , "narrator": "ガブリエラ", "text": "そうよ。"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "っていうか、ちょっと\nバイトのシフトの数が\n多い気がするわ。"},
        { "location": "34/TALK"   , "narrator": "真幌", "text": "シフトはちゃんと均等に\n割り振っているつもり\nなんだが？"},
        { "location": "35/TALK"   , "narrator": "真幌", "text": "それに、用事がある時は\nいつでも休めるように\nしているだろう？"},
        { "location": "38/TALK"   , "narrator": "ガブリエラ", "text": "でも、用事はないけど\n休みたい、って言ったと\nしたら――"},
        { "location": "39/TALK"   , "narrator": "ガブリエラ", "text": "休ませてはくれない\nでしょ？"},
        { "location": "40/TALK"   , "narrator": "真幌", "text": "当たり前だ。"},
        { "location": "42/TALK"   , "narrator": "ガブリエラ", "text": "だから、最初からもっと\n休みを多くしておけば\nいいじゃない。"},
        { "location": "47/TALK"   , "narrator": "みやび", "text": "話は聞いたぞね！"},
        { "location": "49/TALK"   , "narrator": "ガブリエラ", "text": "みやび！？"},
        { "location": "51/TALK"   , "narrator": "真幌", "text": "…面倒なのが増えた。"},
        { "location": "53/TALK"   , "narrator": "みやび", "text": "うちもガブちゃんの\n意見に賛成ちや。"},
        { "location": "54/TALK"   , "narrator": "みやび", "text": "まほさん、うちも前々から\nバイトの出勤が多いと\n思うてたがですよ。"},
        { "location": "55/TALK"   , "narrator": "みやび", "text": "ちゅうか、見てのとおり\nお客も来ないんやき――"},
        { "location": "56/TALK"   , "narrator": "みやび", "text": "休み増やしても支障は\n無いと思うですけんど？"},
        { "location": "59/TALK"   , "narrator": "真幌", "text": "却下だ。"},
        { "location": "63/TALK"   , "narrator": "ガブリエラ", "text": "どうしてよ？"},
        { "location": "65/TALK"   , "narrator": "真幌", "text": "…私も、別におまえ達を\n無理やり拘束しようと\nいう気持ちはない。"},
        { "location": "67/TALK"   , "narrator": "真幌", "text": "だが、急な出動が\n掛かった時――"},
        { "location": "68/TALK"   , "narrator": "真幌", "text": "最低限のメンバーが\nすぐに出動できる状態に\nしておく必要がある。"},
        { "location": "70/TALK"   , "narrator": "真幌", "text": "それも考えて、シフトを\n作ってあるんだ。"},
        { "location": "71/TALK"   , "narrator": "ガブリエラ", "text": "…初耳だわ。"},
        { "location": "72/TALK"   , "narrator": "みやび", "text": "うちもや。\nちゃんと考えて\n作っちょったんですね。"},
        { "location": "74/TALK"   , "narrator": "真幌", "text": "…気付かれていなかった\nことが驚きだ。"},
        { "location": "75/TALK"   , "narrator": "ガブリエラ", "text": "劇場にいなくたって、\n連絡もらえばみんな\nすぐに集まるでしょ？"},
        { "location": "76/TALK"   , "narrator": "ガブリエラ", "text": "放課後にそんな遠出する\nこともないと思うし。"},
        { "location": "78/TALK"   , "narrator": "真幌", "text": "…理由は他にもある。"},
        { "location": "80/TALK"   , "narrator": "ガブリエラ", "text": "何よ？"},
        { "location": "81/TALK"   , "narrator": "真幌", "text": "…知ってのとおり、\nここは映画館だ。"},
        { "location": "82/TALK"   , "narrator": "真幌", "text": "映画館である以上は、\n最低限の体裁を保つ\n必要がある。"},
        { "location": "84/TALK"   , "narrator": "みやび", "text": "…と、言うと？"},
        { "location": "85/TALK"   , "narrator": "真幌", "text": "休みを増やせば、一人や\n二人しかシフトに入らない\nことも考えられる。"},
        { "location": "86/TALK"   , "narrator": "真幌", "text": "客も従業員も少ない\n映画館とか、不安で\n入り辛いだろう？"},
        { "location": "88/TALK"   , "narrator": "みやび", "text": "けんど、客が入り過ぎると\n出動の時に困るんじゃ…。"},
        { "location": "89/TALK"   , "narrator": "真幌", "text": "だからといって、\n露骨にやる気のない\n営業もできん。"},
        { "location": "90/TALK"   , "narrator": "真幌", "text": "最低限の体裁を保ち、\n尚且つ客も入らない\nベストな状態――"},
        { "location": "91/TALK"   , "narrator": "真幌", "text": "それが今なんだ。"},
        { "location": "92/TALK"   , "narrator": "みやび", "text": "誰からも興味を持たれない\n古い映画をやっちゅう\nだけで――"},
        { "location": "93/TALK"   , "narrator": "みやび", "text": "十分やと思いますけんど？"},
        { "location": "94/TALK"   , "narrator": "真幌", "text": "そうかもしれないが、\nそれだけではダメなんだ。\n例えばだが――"},
        { "location": "97/TALK"   , "narrator": "ガブリエラ", "text": "…ダメだわ。\nこれじゃ埒が明かない。"},
        { "location": "112/TALK"  , "narrator": "ガブリエラ", "text": "今、休日を増やすように真幌と交渉中なんだけど"},
        { "location": "113/TALK"  , "narrator": "ガブリエラ", "text": "中々話が進まなくて困ってるの"},
        { "location": "115/SEL"   , "narrator": "", "text": "ずっと見てた、お疲れ様"},
        { "location": "116/ACT"   , "narrator": "", "text": "ずっと見てた、お疲れ様"},
        { "location": "118/TALK"  , "narrator": "ガブリエラ", "text": "ありがと、マルザンナ"},
        { "location": "119/TALK"  , "narrator": "ガブリエラ", "text": "でも、できればあなたの知恵も貸してほしいの"},
        { "location": "121/SEL"   , "narrator": "", "text": "てか、映画館やる意味ある？"},
        { "location": "122/SEL"   , "narrator": "", "text": "休業日を作ればいい"},
        { "location": "123/ACT"   , "narrator": "", "text": "てか、映画館やる意味ある？"},
        { "location": "124/TALK"  , "narrator": "ガブリエラ", "text": "…言われてみれば、確かに"},
        { "location": "125/TALK"  , "narrator": "ガブリエラ", "text": "待機するのが目的なら、寮にいるだけでもいいのに"},
        { "location": "126/TALK"  , "narrator": "ガブリエラ", "text": "さすがはマルザンナ、冴えてるわ"},
        { "location": "138/TALK"  , "narrator": "ガブリエラ", "text": "ねえ、映画館辞めて、\nあたし達専用の待機所に\nするっていうのはどう？"},
        { "location": "139/TALK"  , "narrator": "真幌", "text": "ありえん！\n映画館を畳むなんて、\n絶対にダメだ！"},
        { "location": "141/TALK"  , "narrator": "ガブリエラ", "text": "もぉ、なんでそんなに\n映画館にこだわるのよ？"},
        { "location": "142/TALK"  , "narrator": "ガブリエラ", "text": "あたし達が集まってれば\nいいんだから、バイトする\n必要はないでしょ？"},
        { "location": "143/TALK"  , "narrator": "みやび", "text": "同感です。\nどうして映画館やないと\nいかんがですか？"},
        { "location": "145/TALK"  , "narrator": "真幌", "text": "それは――"},
        { "location": "146/TALK"  , "narrator": "真幌", "text": "この劇場はな、私の先祖が\n代々続けてきた、由緒ある\n劇場だからだ。"},
        { "location": "147/TALK"  , "narrator": "ガブリエラ", "text": "…先祖代々？"},
        { "location": "149/TALK"  , "narrator": "真幌", "text": "そうだ。\nとはいえ、明治以前は\n映画館ではなく――"},
        { "location": "150/TALK"  , "narrator": "真幌", "text": "演芸場や芝居小屋だった\nらしいがな。"},
        { "location": "152/TALK"  , "narrator": "ガブリエラ", "text": "そ、そんなに昔から\nあるの！？"},
        { "location": "154/TALK"  , "narrator": "真幌", "text": "ああ…当然、改装工事も\n何度も入っているため、\n形は変わっているが――"},
        { "location": "155/TALK"  , "narrator": "真幌", "text": "先祖から受け継いだ大切な\n劇場を、私の代で潰すわけ\nにはいかないんだ。"},
        { "location": "156/TALK"  , "narrator": "みやび", "text": "…こう言うてはなんです\nけんど、負の遺産に\nなっちゅうのに…。"},
        { "location": "158/TALK"  , "narrator": "ガブリエラ", "text": "何言ってるのよ！？\n全然負の遺産なんかじゃ\nないわ。"},
        { "location": "159/TALK"  , "narrator": "みやび", "text": "…なんやと？"},
        { "location": "162/TALK"  , "narrator": "ガブリエラ", "text": "まさか、ここがそんな\n歴史のある場所だった\nなんて、思わなかったわ。"},
        { "location": "163/TALK"  , "narrator": "真幌", "text": "ん？　興味あるのか？"},
        { "location": "164/TALK"  , "narrator": "ガブリエラ", "text": "当然よ！"},
        { "location": "165/TALK"  , "narrator": "ガブリエラ", "text": "そんな歴史のある場所で\n働けるなんて、凄いこと\nじゃない！"},
        { "location": "167/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "168/TALK"  , "narrator": "真幌", "text": "ふっ、やっとこの劇場の\n素晴らしさがわかったか。"},
        { "location": "169/TALK"  , "narrator": "真幌", "text": "改装工事は何度も\n行われてはいるが――"},
        { "location": "170/TALK"  , "narrator": "真幌", "text": "この劇場には、楽屋を始め\n当時の名残があちこちに\n残されているんだ。"},
        { "location": "171/TALK"  , "narrator": "真幌", "text": "興味があるなら、\n暇なときにでも\n探してみるんだな。"},
        { "location": "172/TALK"  , "narrator": "ガブリエラ", "text": "ええ、そうしてみるわ。"},
        { "location": "175/TALK"  , "narrator": "みやび", "text": "…ガブちゃん、日本文化\n大好きなんやわかっちゅう\nけんど――"},
        { "location": "176/TALK"  , "narrator": "みやび", "text": "チョロ過ぎて、ちっくと\n心配になるんよ…。"},
        { "location": "177/ACT"   , "narrator": "", "text": "休業日を作ればいいい"},
        { "location": "179/TALK"  , "narrator": "ガブリエラ", "text": "そっか、それなら自然よね？"},
        { "location": "191/TALK"  , "narrator": "ガブリエラ", "text": "まほ、いいアイデアが\nあるわ。"},
        { "location": "193/TALK"  , "narrator": "ガブリエラ", "text": "最低でも、週に二日は\n休業日を作ろうよ。"},
        { "location": "195/TALK"  , "narrator": "真幌", "text": "アホか！？\n週に二日も休む映画館が\nあってたまるか！"},
        { "location": "197/TALK"  , "narrator": "みやび", "text": "誰も気づきませんよ。\n開店休業状態なんやき。"},
        { "location": "198/TALK"  , "narrator": "真幌", "text": "そうかもしれんが――"},
        { "location": "199/TALK"  , "narrator": "真幌", "text": "しかし、ギャヴィ。\nそんなにこの劇場で\n働くのが嫌なのか？"},
        { "location": "200/TALK"  , "narrator": "ガブリエラ", "text": "あ…べ、別に、嫌って\nわけじゃないけど…。"},
        { "location": "201/TALK"  , "narrator": "真幌", "text": "そうとは思えんな。\nそんなに休みをよこせと\n言うのだから――"},
        { "location": "202/TALK"  , "narrator": "真幌", "text": "何かそれなりの理由が\nあるんだろう？"},
        { "location": "204/TALK"  , "narrator": "みやび", "text": "…ガブちゃん。\n何かあるんやったら\n言うた方がえいよ。"},
        { "location": "205/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "207/TALK"  , "narrator": "ガブリエラ", "text": "だって…クラスのみんなは\n誰もバイトなんかして\nないんだもの…。"},
        { "location": "208/TALK"  , "narrator": "ガブリエラ", "text": "みんな放課後は部活とか、\n遊ぶ約束とかしてるし…。"},
        { "location": "209/TALK"  , "narrator": "真幌", "text": "…あっ！！"},
        { "location": "211/TALK"  , "narrator": "みやび", "text": "まほさん！\nすっかり忘れてたけんど、\nガブちゃんまだ中学生や！"},
        { "location": "213/TALK"  , "narrator": "ガブリエラ", "text": "そりゃ、トライナリーに\n所属してるんだから、\n出撃には文句ないわ。"},
        { "location": "215/TALK"  , "narrator": "ガブリエラ", "text": "でも、クラスメイトの\n子達みたいに、もう少し\n遊ぶ時間も欲しいわ…。"},
        { "location": "218/TALK"  , "narrator": "真幌", "text": "…すまん！！"},
        { "location": "219/TALK"  , "narrator": "真幌", "text": "すっかり忘れていた！\nギャヴィがまだ中学生だと\nいうことを！"},
        { "location": "222/TALK"  , "narrator": "みやび", "text": "まほさんだけやない。\nうちや、アーヤ達も多分\n忘れてたと思うんよ。"},
        { "location": "224/TALK"  , "narrator": "みやび", "text": "すまんな、ガブちゃん。\n気付いてやれんで…。"},
        { "location": "226/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "227/TALK"  , "narrator": "真幌", "text": "基本的に、バイトは\n高校生からだからな。"},
        { "location": "228/TALK"  , "narrator": "真幌", "text": "中学生のギャヴィには、\n酷なことだったかも\nしれん…本当にすまん。"},
        { "location": "231/TALK"  , "narrator": "ガブリエラ", "text": "…いいわよ、もう。"},
        { "location": "233/TALK"  , "narrator": "ガブリエラ", "text": "あたしも、今の今まで\nそのこと言わなかったん\nだし…。"},
        { "location": "235/TALK"  , "narrator": "みやび", "text": "…まほさん、来月から\nガブちゃんのシフト、\n休み多めでお願いします。"},
        { "location": "236/TALK"  , "narrator": "みやび", "text": "その分は、うちらで\n補いますき。"},
        { "location": "237/TALK"  , "narrator": "真幌", "text": "ああ、そうしてもらえると\n助かる。"},
        { "location": "241/TALK"  , "narrator": "ガブリエラ", "text": "えっ、でもそれじゃ…。"},
        { "location": "243/TALK"  , "narrator": "真幌", "text": "もちろん、ギャヴィの\nシフトをゼロにすることは\nできないが…。"},
        { "location": "244/TALK"  , "narrator": "ガブリエラ", "text": "そ、そこまでしろとは\n言ってないから！"},
        { "location": "245/TALK"  , "narrator": "みやび", "text": "わかっちゅうよ。\nけんど、今より間違いなく\n休みは増やすき――"},
        { "location": "246/TALK"  , "narrator": "みやび", "text": "ガブちゃんはその分、\nおもいっきり好きなことを\nしてえいんよ。"},
        { "location": "247/TALK"  , "narrator": "真幌", "text": "アーヤ達には私から話す。\nギャヴィは何も気にしな\nくていい。"},
        { "location": "252/TALK"  , "narrator": "ガブリエラ", "text": "…本当にいいの？"},
        { "location": "253/TALK"  , "narrator": "みやび", "text": "うちらも、中学時代は\nバイトなんかせんで、\n好き放題やってたきね。"},
        { "location": "254/TALK"  , "narrator": "みやび", "text": "休みが多くなるんは、\nガブちゃんにとって\n当然の権利やき――"},
        { "location": "255/TALK"  , "narrator": "みやび", "text": "気にせんで、今のうちに\n沢山好きなことせんと\nいかんよ。"},
        { "location": "257/TALK"  , "narrator": "真幌", "text": "…しかし、シフトを\nどうするべきか…\nう～む…。"},
        { "location": "259/TALK"  , "narrator": "ガブリエラ", "text": "…無理に減らさ\nなくてもいいわ。"},
        { "location": "260/TALK"  , "narrator": "ガブリエラ", "text": "ただ、休みたい時に\n少しだけ無理を聞いて\nもらえたら――"},
        { "location": "261/TALK"  , "narrator": "ガブリエラ", "text": "それでいいから！\nシフトで休み多くしたり\nとかはしないで。"},
        { "location": "263/TALK"  , "narrator": "みやび", "text": "えいが？\n休みが欲しい言うたんは\nガブちゃんやのに…。"},
        { "location": "265/TALK"  , "narrator": "ガブリエラ", "text": "そうだけど…やっぱり、\nあたしだけ減らすって\nいうのは――"},
        { "location": "266/TALK"  , "narrator": "ガブリエラ", "text": "なんか、対等じゃなくて\n嫌な感じだし…。"},
        { "location": "268/TALK"  , "narrator": "ガブリエラ", "text": "それに、劇場の仕事は\n嫌いじゃないし…。"},
        { "location": "270/TALK"  , "narrator": "真幌", "text": "…わかった。\nおまえがそう言うなら、\nその通りにしよう。"},
        { "location": "271/TALK"  , "narrator": "みやび", "text": "休みが欲しい時は、\n遠慮なく言うがよ？"},
        { "location": "275/TALK"  , "narrator": "ガブリエラ", "text": "…思ったより気を使わせ\nちゃったみたい。"},
        { "location": "276/TALK"  , "narrator": "ガブリエラ", "text": "ちょっと、ワガママ\n言い過ぎたかしら？"},
        { "location": "17/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>7月26日　3:34 PM</color>\nとある平日、神楽坂トライナリー劇場にて。"},
        { "location": "287/DIALOG", "narrator": "Dialog_GEThimegoto_ch03", "text": "【それが子供の仕事】"}
    ]
}
