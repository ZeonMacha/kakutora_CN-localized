    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "平行線"},
        { "location": "19/TALK"   , "narrator": "アーヤ", "text": "ごめん、二人とも。\nちょっと本屋寄って\n帰るわ。"},
        { "location": "21/TALK"   , "narrator": "つばめ", "text": "何か読みたい本でも\nあるんですか？"},
        { "location": "23/TALK"   , "narrator": "アーヤ", "text": "うーん…っていうか、\n暇つぶしかな？"},
        { "location": "25/TALK"   , "narrator": "ガブリエラ", "text": "いいわよね。\nあたし達なんか、これから\nバイトだってのに…。"},
        { "location": "26/TALK"   , "narrator": "アーヤ", "text": "昨日休みだったでしょ？\nほら、急がないと時間に\n遅れるわよ？"},
        { "location": "29/TALK"   , "narrator": "ガブリエラ", "text": "もう…行くわよ、つばめ。"},
        { "location": "32/TALK"   , "narrator": "つばめ", "text": "あ、ガブちゃん待って！"},
        { "location": "37/TALK"   , "narrator": "アーヤ", "text": "…ふぅ。"},
        { "location": "39/TALK"   , "narrator": "アーヤ", "text": "…………。"},
        { "location": "41/TALK"   , "narrator": "アーヤ", "text": "あ、そっか。\n本屋行くんだったわ…。"},
        { "location": "42/SEL"    , "narrator": "", "text": "アーヤ"},
        { "location": "43/ACT"    , "narrator": "", "text": "アーヤ"},
        { "location": "47/TALK"   , "narrator": "アーヤ", "text": "？"},
        { "location": "61/TALK"   , "narrator": "アーヤ", "text": "ああ"},
        { "location": "62/TALK"   , "narrator": "アーヤ", "text": "どうかした？"},
        { "location": "64/SEL"    , "narrator": "", "text": "退屈してない？"},
        { "location": "65/SEL"    , "narrator": "", "text": "元気かなって"},
        { "location": "66/SEL"    , "narrator": "", "text": "アーヤと話したい"},
        { "location": "67/ACT"    , "narrator": "", "text": "退屈してない？"},
        { "location": "68/TALK"   , "narrator": "アーヤ", "text": "退屈はしてない"},
        { "location": "69/TALK"   , "narrator": "アーヤ", "text": "けど"},
        { "location": "70/TALK"   , "narrator": "アーヤ", "text": "時間はあるわ"},
        { "location": "73/SEL"    , "narrator": "", "text": "最近、避けられてる気がした"},
        { "location": "74/ACT"    , "narrator": "", "text": "最近、避けられてる気がした"},
        { "location": "76/TALK"   , "narrator": "アーヤ", "text": "ごめんなさい"},
        { "location": "78/TALK"   , "narrator": "アーヤ", "text": "でも"},
        { "location": "79/TALK"   , "narrator": "アーヤ", "text": "避けてるわけじゃない"},
        { "location": "80/TALK"   , "narrator": "アーヤ", "text": "そういうことじゃないの"},
        { "location": "87/SEL"    , "narrator": "", "text": "自分は最初から同じだから気にしないでもらえると嬉しい"},
        { "location": "88/ACT"    , "narrator": "", "text": "自分は最初から同じだから気にしないでもらえると嬉しい"},
        { "location": "90/TALK"   , "narrator": "アーヤ", "text": "それはわかってる"},
        { "location": "91/TALK"   , "narrator": "アーヤ", "text": "けど"},
        { "location": "92/TALK"   , "narrator": "アーヤ", "text": "無理"},
        { "location": "93/TALK"   , "narrator": "アーヤ", "text": "普通に考えて無理"},
        { "location": "97/SEL"    , "narrator": "", "text": "抵抗ある？"},
        { "location": "98/ACT"    , "narrator": "", "text": "抵抗ある？"},
        { "location": "101/TALK"  , "narrator": "アーヤ", "text": "時間がほしい"},
        { "location": "102/TALK"  , "narrator": "アーヤ", "text": "それじゃあ"},
        { "location": "103/ACT"   , "narrator": "", "text": "元気かなって"},
        { "location": "104/TALK"  , "narrator": "アーヤ", "text": "まあまあってところ？"},
        { "location": "105/TALK"  , "narrator": "アーヤ", "text": "そんな感じよ"},
        { "location": "107/TALK"  , "narrator": "アーヤ", "text": "そっちは？"},
        { "location": "109/SEL"   , "narrator": "", "text": "元気ない"},
        { "location": "110/ACT"   , "narrator": "", "text": "元気ない"},
        { "location": "112/TALK"  , "narrator": "アーヤ", "text": "そんなこと言われても"},
        { "location": "114/TALK"  , "narrator": "アーヤ", "text": "困るのよ"},
        { "location": "116/ACT"   , "narrator": "", "text": "アーヤと話したい"},
        { "location": "117/TALK"  , "narrator": "アーヤ", "text": "私と？"},
        { "location": "118/TALK"  , "narrator": "アーヤ", "text": "えとね"},
        { "location": "119/TALK"  , "narrator": "アーヤ", "text": "何を話すの？"},
        { "location": "120/TALK"  , "narrator": "アーヤ", "text": "私にはないわ"},
        { "location": "121/TALK"  , "narrator": "アーヤ", "text": "ないのよ。"}
    ]
