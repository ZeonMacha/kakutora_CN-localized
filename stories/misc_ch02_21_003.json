    [
        { "location": "178/SCENARIO", "narrator": "", "text": "033_入道雲"},
        { "location": "205/TALK"    , "narrator": "アーヤ", "text": "海の上に入道雲とか"},
        { "location": "206/TALK"    , "narrator": "アーヤ", "text": "ホントに出るのね"},
        { "location": "208/SEL"     , "narrator": "", "text": "もう出てるの？"},
        { "location": "209/SEL"     , "narrator": "", "text": "珍しくはないと思う"},
        { "location": "210/SEL"     , "narrator": "", "text": "日本の夏って感じだね"},
        { "location": "211/ACT"     , "narrator": "", "text": "もう出てるの？"},
        { "location": "212/TALK"    , "narrator": "アーヤ", "text": "っぽいのがね"},
        { "location": "214/TALK"    , "narrator": "アーヤ", "text": "入道雲って思うことにしあの"},
        { "location": "215/TALK"    , "narrator": "アーヤ", "text": "したの"},
        { "location": "216/ACT"     , "narrator": "", "text": "珍しくはないと思う"},
        { "location": "217/TALK"    , "narrator": "アーヤ", "text": "まあそうだけど"},
        { "location": "218/TALK"    , "narrator": "アーヤ", "text": "私には"},
        { "location": "219/TALK"    , "narrator": "アーヤ", "text": "珍しいのよ"},
        { "location": "220/ACT"     , "narrator": "", "text": "日本の夏って感じだね"},
        { "location": "222/TALK"    , "narrator": "アーヤ", "text": "そうそう(￣Д￣ )"},
        { "location": "223/TALK"    , "narrator": "アーヤ", "text": "でも長野って海が無いから"},
        { "location": "224/TALK"    , "narrator": "アーヤ", "text": "そういうのちょっとピンとこないのよね"},
        { "location": "226/TALK"    , "narrator": "アーヤ", "text": "同じ二本なのに"},
        { "location": "227/TALK"    , "narrator": "アーヤ", "text": "日本なのに"},
        { "location": "228/TALK"    , "narrator": "アーヤ", "text": "見える景色って"},
        { "location": "230/TALK"    , "narrator": "アーヤ", "text": "全然違うのよね"}
    ]
