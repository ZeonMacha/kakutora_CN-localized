        { "location": "5871/SCENARIO", "narrator": "", "text": "卯月さんちは普通"},
        { "location": "5896/TALK"    , "narrator": "神楽", "text": "卯月さんちは普通"},
        { "location": "5897/TALK"    , "narrator": "神楽", "text": "普通普通"},
        { "location": "5898/TALK"    , "narrator": "神楽", "text": "本当に普通"},
        { "location": "5900/SEL"     , "narrator": "", "text": "却って怪しい"},
        { "location": "5901/SEL"     , "narrator": "", "text": "神楽がいるんだからスペシャルでしょ"},
        { "location": "5902/SEL"     , "narrator": "", "text": "わかった、理解した"},
        { "location": "5903/ACT"     , "narrator": "", "text": "却って怪しい"},
        { "location": "5904/TALK"    , "narrator": "神楽", "text": "いやいやそんなことないですよ？？？"},
        { "location": "5905/TALK"    , "narrator": "神楽", "text": "ふ、ふつうですからね？？？"},
        { "location": "5906/ACT"     , "narrator": "", "text": "神楽がいるんだからスペシャルでしょ"},
        { "location": "5908/TALK"    , "narrator": "神楽", "text": "なるほど？"},
        { "location": "5909/TALK"    , "narrator": "神楽", "text": "そういう説もあるよね"},
        { "location": "5910/TALK"    , "narrator": "神楽", "text": "よしそれ採用！！！"},
        { "location": "5911/TALK"    , "narrator": "神楽", "text": "いいこと言った$handlek$！"},
        { "location": "5912/ACT"     , "narrator": "", "text": "わかった、理解した"},
        { "location": "5913/TALK"    , "narrator": "神楽", "text": "ほんとだなー？"},
        { "location": "5914/TALK"    , "narrator": "神楽", "text": "絶対だなー？"},
        { "location": "5916/TALK"    , "narrator": "神楽", "text": "普通の基準って何だろうね？"},
        { "location": "5918/SEL"     , "narrator": "", "text": "あれ？矛盾してない？"},
        { "location": "5919/SEL"     , "narrator": "", "text": "一般常識とか？"},
        { "location": "5920/SEL"     , "narrator": "", "text": "$me$の神楽への気持ちは特別だから！"},
        { "location": "5921/ACT"     , "narrator": "", "text": "あれ？矛盾してない？"},
        { "location": "5922/TALK"    , "narrator": "神楽", "text": "ぴょんこ心は複雑ぴょん"},
        { "location": "5923/ACT"     , "narrator": "", "text": "一般常識とか？"},
        { "location": "5924/TALK"    , "narrator": "神楽", "text": "あーそれかー"},
        { "location": "5925/ACT"     , "narrator": "", "text": "$me$の神楽への気持ちは特別だから！"},
        { "location": "5927/TALK"    , "narrator": "神楽", "text": "スペシャル！"},
        { "location": "5928/TALK"    , "narrator": "神楽", "text": "いい響きだな～"},
        { "location": "5929/TALK"    , "narrator": "神楽", "text": "そういうのを待ってた！"},
        { "location": "5931/TALK"    , "narrator": "神楽", "text": "普通って安心感があっていいでしょ"},
        { "location": "5932/TALK"    , "narrator": "神楽", "text": "その分退屈だけど"}
    ]
}
