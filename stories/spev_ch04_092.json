    "dir": "chap00/daydra/spev_ch04_092.js",
    "type": "",
    "info": {
        "story_id": "91031",
        "cid": "",
        "title": "ぴょんこのサマー大作戦♪",
        "sub_title": "ぴょんこのサマー大作戦♪①【みやび編】"
    },
    "entry":
    [
        { "location": "19/DIALOG", "narrator": "", "text": "<color=green>7月5日　5:11 PM</color>\nとある平日の放課後、みやびの部屋にて"},
        { "location": "26/TALK"  , "narrator": "みやび", "text": "ん？　開いてるぞねー。"},
        { "location": "27/TALK"  , "narrator": "神楽", "text": "はい、失礼します。"},
        { "location": "40/TALK"  , "narrator": "神楽", "text": "こんにち――"},
        { "location": "43/TALK"  , "narrator": "神楽", "text": "わっ！？"},
        { "location": "48/TALK"  , "narrator": "みやび", "text": "なんや？\n部屋に入ってそうそう\n大声出して…。"},
        { "location": "50/TALK"  , "narrator": "神楽", "text": "す、すみません…。\nなんか、凄い部屋だな、\nと思って…。"},
        { "location": "51/TALK"  , "narrator": "みやび", "text": "ほぅ…この部屋のよさが\nわかるとは、\n卯月もなかなかやな。"},
        { "location": "52/TALK"  , "narrator": "神楽", "text": "いや、いいと思っては\nいないんですけど…。"},
        { "location": "53/TALK"  , "narrator": "みやび", "text": "それより、\nうちになんか用か？"},
        { "location": "54/TALK"  , "narrator": "神楽", "text": "あ、はい…。\nパソコンのことで、\nご相談したくて…。"},
        { "location": "55/TALK"  , "narrator": "神楽", "text": "私の使ってるＰＣ、\nちょっと古いタイプで\nスペックが乏しいんです。"},
        { "location": "57/TALK"  , "narrator": "神楽", "text": "なので、みやびさんに\n新しいＰＣを見繕って\nもらえたらな、って。"},
        { "location": "58/TALK"  , "narrator": "みやび", "text": "おおっ、予想してたより\n面白そうな相談や。"},
        { "location": "59/TALK"  , "narrator": "みやび", "text": "ＰＣのことやったら\n力になれるき、安心しぃ。"},
        { "location": "60/TALK"  , "narrator": "神楽", "text": "ありがとうございます！"},
        { "location": "61/TALK"  , "narrator": "みやび", "text": "で？　そのＰＣを\n使う目的は？"},
        { "location": "62/TALK"  , "narrator": "神楽", "text": "先日発売した\n画像編集ソフトを\n入れたいんです。"},
        { "location": "63/TALK"  , "narrator": "みやび", "text": "あ～、あれかぁ…。\n確か推奨スペック\n結構高かったなぁ…。"},
        { "location": "64/TALK"  , "narrator": "神楽", "text": "はい…自分でも、\n探してみたんです。"},
        { "location": "65/TALK"  , "narrator": "神楽", "text": "でも、どれも私の使ってる\nＰＣより高性能で、\n見分けが付かなくて…。"},
        { "location": "66/TALK"  , "narrator": "みやび", "text": "わからん時には\nむやみに手を出さんで\n正解や。"},
        { "location": "67/TALK"  , "narrator": "みやび", "text": "ちゅうか、画像編集ソフト\nなんて必要か？"},
        { "location": "69/TALK"  , "narrator": "みやび", "text": "簡単な写真の加工くらい、\n最初から入っちょる\nソフトで十分やろ？"},
        { "location": "71/TALK"  , "narrator": "神楽", "text": "そ、そうなんですけど、\nえっと…。"},
        { "location": "72/TALK"  , "narrator": "神楽", "text": "…同人誌を作ろうと\n思ってる、なんて\n言ったら。"},
        { "location": "73/TALK"  , "narrator": "神楽", "text": "きっと、一時間後には\nみんなに知られちゃうと\n思うし…。"},
        { "location": "75/TALK"  , "narrator": "神楽", "text": "…形から入るのって、\nモチベーション維持に\n大切だと思いませんか？"},
        { "location": "76/TALK"  , "narrator": "みやび", "text": "…なるほど。\n卯月にもそういうの\nあるんやね。"},
        { "location": "78/TALK"  , "narrator": "みやび", "text": "じゃあ、スペック調べて、\n卯月に合いそうなのを\n何台か見つけとくがよ。"},
        { "location": "79/TALK"  , "narrator": "神楽", "text": "はい、連絡待ってますね。\nでは、私はこれで…。"},
        { "location": "80/TALK"  , "narrator": "みやび", "text": "うん…。"},
        { "location": "82/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "83/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "85/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "87/TALK"  , "narrator": "みやび", "text": "…なんや？\nまだ用事あるが？"},
        { "location": "90/TALK"  , "narrator": "神楽", "text": "いや…改めて見ても、\nやっぱり部屋の中が\n凄いな、って…。"},
        { "location": "91/TALK"  , "narrator": "神楽", "text": "最後に片付けたのって、\nいつなんですか？"},
        { "location": "92/TALK"  , "narrator": "みやび", "text": "？　この整頓しきった\n部屋を片付けろと？"},
        { "location": "93/TALK"  , "narrator": "神楽", "text": "整頓しきった部屋！？\nこの部屋が！？"},
        { "location": "94/TALK"  , "narrator": "みやび", "text": "…見えんか？"},
        { "location": "95/TALK"  , "narrator": "神楽", "text": "ごめんなさい…。\n散らかった部屋にしか\n見えません…。"},
        { "location": "97/TALK"  , "narrator": "みやび", "text": "ふむ…まあ、この部屋を\n使うんはうちやきね。"},
        { "location": "98/TALK"  , "narrator": "みやび", "text": "他人からしたら、\n散らかっちょるようにしか\n見えんかもしれん。"},
        { "location": "100/TALK" , "narrator": "みやび", "text": "けんど、うちにとっては\nこの状態こそが\n最も理に適っちょるんよ。"},
        { "location": "101/TALK" , "narrator": "みやび", "text": "なにかする際に、\nその必要な物が\n手の届く範囲にある配置。"},
        { "location": "102/TALK" , "narrator": "みやび", "text": "それがこの部屋や。"},
        { "location": "103/TALK" , "narrator": "神楽", "text": "…片づけませんか？"},
        { "location": "105/TALK" , "narrator": "みやび", "text": "断固拒否ぞね！"},
        { "location": "106/TALK" , "narrator": "みやび", "text": "ちゅうか、卯月の部屋も\nこんなもんやろ？"},
        { "location": "108/TALK" , "narrator": "神楽", "text": "ちょ！？\nやめてください！"},
        { "location": "109/TALK" , "narrator": "神楽", "text": "誰かに聞かれてたら\n勘違いされちゃうかも\nしれないじゃないですか。"},
        { "location": "110/TALK" , "narrator": "みやび", "text": "ちゅうことは、\n違うんか？"},
        { "location": "111/TALK" , "narrator": "神楽", "text": "ちゃんと片付いてますよ。"},
        { "location": "112/TALK" , "narrator": "みやび", "text": "マジか。"},
        { "location": "113/TALK" , "narrator": "神楽", "text": "マジですよ。\nまあ、自分でお掃除した\nことはないですけど。"},
        { "location": "114/TALK" , "narrator": "みやび", "text": "マジか。"},
        { "location": "115/TALK" , "narrator": "神楽", "text": "マジですよ。"},
        { "location": "117/TALK" , "narrator": "みやび", "text": "お嬢様め…。"},
        { "location": "118/TALK" , "narrator": "神楽", "text": "とにかく、まともに\n歩く場所くらいは\n確保しましょうよ。"},
        { "location": "119/TALK" , "narrator": "みやび", "text": "だから、この部屋は\nうちにとっては\n整頓されちょるんやって。"},
        { "location": "121/TALK" , "narrator": "みやび", "text": "うちが暮らすうえで、\nこの配置はまさに\n神配置！"},
        { "location": "123/TALK" , "narrator": "みやび", "text": "これ以上うちにあった\n配置なんぞ、\n存在せんのや。"},
        { "location": "124/SEL"  , "narrator": "（選択肢）", "text": "どう見ても汚部屋だ！"},
        { "location": "125/SEL"  , "narrator": "（選択肢）", "text": "$me$の部屋も似た感じだ"},
        { "location": "126/SEL"  , "narrator": "（選択肢）", "text": "掃除したくなる部屋だ"},
        { "location": "127/ACT"  , "narrator": "", "text": "どう見ても汚部屋だ！"},
        { "location": "144/TALK" , "narrator": "みやび", "text": "相棒おまえもか"},
        { "location": "145/TALK" , "narrator": "みやび", "text": "というより"},
        { "location": "146/TALK" , "narrator": "みやび", "text": "何故この美しさがわからないのか！？"},
        { "location": "147/TALK" , "narrator": "みやび", "text": "うちは悲しい"},
        { "location": "148/TALK" , "narrator": "みやび", "text": "悲しいなぁ"},
        { "location": "149/TALK" , "narrator": "みやび", "text": "相棒が"},
        { "location": "150/TALK" , "narrator": "みやび", "text": "美的センスゼロで"},
        { "location": "162/TALK" , "narrator": "みやび", "text": "…何故誰もこのよさが\nわからんのか？"},
        { "location": "163/TALK" , "narrator": "神楽", "text": "わかる方が少ないと\n思いますよ？"},
        { "location": "164/ACT"  , "narrator": "", "text": "$me$の部屋も似た感じだ"},
        { "location": "181/TALK" , "narrator": "みやび", "text": "なんという奇遇"},
        { "location": "183/TALK" , "narrator": "みやび", "text": "相棒の部屋も"},
        { "location": "184/TALK" , "narrator": "みやび", "text": "整頓されてるとは"},
        { "location": "186/SEL"  , "narrator": "（選択肢）", "text": "使い慣れるとやめられない"},
        { "location": "187/SEL"  , "narrator": "（選択肢）", "text": "いや、散らかってるってこと"},
        { "location": "188/ACT"  , "narrator": "", "text": "使い慣れるとやめられない"},
        { "location": "189/TALK" , "narrator": "みやび", "text": "この場にいたら"},
        { "location": "190/TALK" , "narrator": "みやび", "text": "抱きしめて"},
        { "location": "191/TALK" , "narrator": "みやび", "text": "チューの嵐だった"},
        { "location": "192/TALK" , "narrator": "みやび", "text": "いないのでしない"},
        { "location": "193/TALK" , "narrator": "みやび", "text": "残念だが仕方ない"},
        { "location": "204/TALK" , "narrator": "神楽", "text": "…片付けろ、って\n言われたんですか？"},
        { "location": "206/TALK" , "narrator": "みやび", "text": "いや、相棒は\nうちの理解者やった。"},
        { "location": "208/TALK" , "narrator": "神楽", "text": "…似た者同士が\n出会っちゃった、\nってことですね…。"},
        { "location": "209/ACT"  , "narrator": "", "text": "いや、散らかってるってこと"},
        { "location": "210/TALK" , "narrator": "みやび", "text": "それは違う"},
        { "location": "211/TALK" , "narrator": "みやび", "text": "うちの部屋は"},
        { "location": "212/TALK" , "narrator": "みやび", "text": "整頓された乱雑さ"},
        { "location": "213/TALK" , "narrator": "みやび", "text": "相棒の部屋は"},
        { "location": "214/TALK" , "narrator": "みやび", "text": "混沌とした乱雑さ"},
        { "location": "215/TALK" , "narrator": "みやび", "text": "似て非なるもの"},
        { "location": "216/TALK" , "narrator": "みやび", "text": "一緒にされるのは"},
        { "location": "217/TALK" , "narrator": "みやび", "text": "不愉快極まりない"},
        { "location": "218/TALK" , "narrator": "みやび", "text": "激おこである"},
        { "location": "230/TALK" , "narrator": "みやび", "text": "…情けない。"},
        { "location": "231/TALK" , "narrator": "神楽", "text": "どうかしたんですか？"},
        { "location": "233/TALK" , "narrator": "みやび", "text": "相棒は自分の部屋を\n整頓もできない、\nだらしないヤツのようや。"},
        { "location": "234/TALK" , "narrator": "神楽", "text": "…それ、自分自身に\n言うべき言葉ですよ。"},
        { "location": "236/ACT"  , "narrator": "", "text": "掃除したくなる部屋だ"},
        { "location": "253/TALK" , "narrator": "みやび", "text": "掃除するところなど"},
        { "location": "255/TALK" , "narrator": "みやび", "text": "皆無"},
        { "location": "256/TALK" , "narrator": "みやび", "text": "他人が触れると"},
        { "location": "257/TALK" , "narrator": "みやび", "text": "逆に汚れる"},
        { "location": "258/TALK" , "narrator": "みやび", "text": "ドントタッチ"},
        { "location": "259/TALK" , "narrator": "みやび", "text": "わかったな？"},
        { "location": "270/TALK" , "narrator": "みやび", "text": "…あっ、なるほど。\nそういうことやったか。"},
        { "location": "271/TALK" , "narrator": "神楽", "text": "はい？"},
        { "location": "273/TALK" , "narrator": "みやび", "text": "今、この部屋は掃除したく\nなる部屋だと言われたん\nやけんど、なるほど。"},
        { "location": "275/TALK" , "narrator": "みやび", "text": "相棒は潔癖症やき、\nこの整頓された部屋を\nさらに掃除したいと――"},
        { "location": "276/TALK" , "narrator": "神楽", "text": "絶対違います！"},
        { "location": "278/TALK" , "narrator": "神楽", "text": "まったく…そもそも\nアーヤさん達は\nなにも言わないんですか？"},
        { "location": "279/TALK" , "narrator": "神楽", "text": "絶対に、だらしないから\n掃除しなさい、とか\n言うはずですし…。"},
        { "location": "280/TALK" , "narrator": "神楽", "text": "真幌さんだって、\nこの部屋を見たら\n大爆発しちゃいますよ。"},
        { "location": "281/TALK" , "narrator": "みやび", "text": "まほさんなら\n何度もここに来ちょるよ。"},
        { "location": "283/TALK" , "narrator": "神楽", "text": "えっ！？\n怒られなかったん\nですか！？"},
        { "location": "284/TALK" , "narrator": "みやび", "text": "最初は片付けろ\n言うてたけんどな。"},
        { "location": "285/TALK" , "narrator": "みやび", "text": "最後には、床だけは\n抜かない程度にしろ、\n言うて終わりぞね。"},
        { "location": "286/TALK" , "narrator": "神楽", "text": "…それ、諦められた\nだけのような？"},
        { "location": "287/TALK" , "narrator": "神楽", "text": "でも、劇場の真幌さんの\n部屋も、すごく散らかって\nますよね？"},
        { "location": "290/TALK" , "narrator": "みやび", "text": "あ～、そういえば\nまほさん、整頓とか\n苦手そうやきね。"},
        { "location": "291/TALK" , "narrator": "みやび", "text": "あ、だから時々、\nまほさん部屋に来ること\nあるんか。"},
        { "location": "292/TALK" , "narrator": "神楽", "text": "えぇっ！？\n時々来るんですか？"},
        { "location": "294/TALK" , "narrator": "みやび", "text": "解析作業とか頼まれて、\n結果が出たっちゅうと\nわざわざ来るんよ。"},
        { "location": "295/TALK" , "narrator": "みやび", "text": "ベッドソファ代わりにして\nわかったこと教えると、\nすぐ帰るけんどな。"},
        { "location": "297/TALK" , "narrator": "みやび", "text": "そうかぁ…この部屋が\n落ち着くき、わざわざ\nここまでくる…。"},
        { "location": "298/TALK" , "narrator": "みやび", "text": "やはりまほさんは、\n理解あるボスやねぇ。"},
        { "location": "300/TALK" , "narrator": "神楽", "text": "…………。"},
        { "location": "301/TALK" , "narrator": "神楽", "text": "ずぼらな上司と、\nダメな部下。"},
        { "location": "303/TALK" , "narrator": "神楽", "text": "二人はみんなに隠れて\n密会し、いつの間にか\nいけない関係へ…。"},
        { "location": "305/TALK" , "narrator": "神楽", "text": "こ、これは…、\n筆が進む展開ですね！"},
        { "location": "308/TALK" , "narrator": "みやび", "text": "は？　なにが進むって？"},
        { "location": "310/TALK" , "narrator": "神楽", "text": "いえ！\nごちそうさまでした、\nみやびさん！"}
    ]
}
