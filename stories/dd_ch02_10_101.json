{
    "dir": "chap10/daydra/dd_ch02_10_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "10202",
        "cid": "ayami",
        "title": "002 メインストーリー",
        "sub_title": "切れない物が怖い＜前編＞"
    },
    "entry":
    [
        { "location": "8/SCENARIO", "narrator": "", "text": "切れない物が怖い"},
        { "location": "24/TALK"   , "narrator": "つばめ", "text": "…買い物に夢中に\nなって、遅くなっ\nちゃった。"},
        { "location": "25/TALK"   , "narrator": "つばめ", "text": "部屋に戻ったら、\nすぐにお夕飯の\n準備をして…。"},
        { "location": "28/TALK"   , "narrator": "つばめ", "text": "…えっ！？"},
        { "location": "29/TALK"   , "narrator": "つばめ", "text": "何、あれ？\n寮の周りを、何かが\n飛んでるような…？"},
        { "location": "31/TALK"   , "narrator": "つばめ", "text": "あの影は…え！？\n人間？"},
        { "location": "33/TALK"   , "narrator": "つばめ", "text": "あっ、あの部屋は！"},
        { "location": "53/TALK"   , "narrator": "つばめ", "text": "怖くて町中まで戻って\n来ちゃったよ……。"},
        { "location": "54/TALK"   , "narrator": "つばめ", "text": "あれ、何だったんだろう\nやっぱりドロ…"},
        { "location": "56/TALK"   , "narrator": "アーヤ", "text": "あら、逢瀬さん。\nどうかしたの？"},
        { "location": "57/TALK"   , "narrator": "つばめ", "text": "ああっ、アーヤさん！\n良かったぁ！！"},
        { "location": "59/TALK"   , "narrator": "アーヤ", "text": "えっ？\nどうしたの？\n何かあったの？"},
        { "location": "60/TALK"   , "narrator": "つばめ", "text": "今、買い物から帰って\nきたんですけど――"},
        { "location": "61/TALK"   , "narrator": "つばめ", "text": "寮の周りを、ゆらゆら\nした人影が飛んでいた\nんです。"},
        { "location": "63/TALK"   , "narrator": "アーヤ", "text": "えっ！？"},
        { "location": "64/TALK"   , "narrator": "つばめ", "text": "それで、その影が\nアーヤさんの部屋に\n降りていったから――"},
        { "location": "66/TALK"   , "narrator": "つばめ", "text": "泥棒なんじゃ、って\n心配になって…。"},
        { "location": "68/TALK"   , "narrator": "アーヤ", "text": "…………。"},
        { "location": "70/TALK"   , "narrator": "つばめ", "text": "アーヤさん？"},
        { "location": "72/TALK"   , "narrator": "アーヤ", "text": "あっ、ううん！\n私は平気だから！"},
        { "location": "74/TALK"   , "narrator": "つばめ", "text": "？　そうですか…。\nじゃあ、見間違い\nだったのかなぁ？"},
        { "location": "75/TALK"   , "narrator": "アーヤ", "text": "…ゆらゆらしながら\n空を飛ぶ人影って――"},
        { "location": "77/TALK"   , "narrator": "アーヤ", "text": "…霊！？\nうちの寮に…！？"},
        { "location": "78/TALK"   , "narrator": "つばめ", "text": "でもやっぱり戻ります。\nお騒がせしました。"},
        { "location": "81/TALK"   , "narrator": "アーヤ", "text": "っ！？　ま、待って！\n行っちゃダメ！"},
        { "location": "83/TALK"   , "narrator": "つばめ", "text": "はい？"},
        { "location": "86/TALK"   , "narrator": "アーヤ", "text": "あっ…ほ、ほら、\n安全のためよ。"},
        { "location": "87/TALK"   , "narrator": "アーヤ", "text": "もし本当に泥棒だった\nとしたら、逢瀬さんも\n危ないわ。"},
        { "location": "90/TALK"   , "narrator": "アーヤ", "text": "寮まで送るから、\n一緒に行きましょ。"},
        { "location": "91/TALK"   , "narrator": "つばめ", "text": "で、でも、ご迷惑に\nなっちゃうんじゃ…。"},
        { "location": "92/TALK"   , "narrator": "アーヤ", "text": "そんなことないわ。\n後輩の安全を護るのも\n私の役目よ。"},
        { "location": "94/TALK"   , "narrator": "アーヤ", "text": "それじゃ、早く部屋に\n行きましょ。"},
        { "location": "95/TALK"   , "narrator": "つばめ", "text": "は、はい…。"},
        { "location": "96/TALK"   , "narrator": "つばめ", "text": "…余計な心配\nさせちゃったかな？"},
        { "location": "121/TALK"  , "narrator": "アーヤ", "text": "ふぅ……。\nこれでしばらく\n時間が稼げるわ…。"},
        { "location": "124/TALK"  , "narrator": "つばめ", "text": "ふぅ…。\nアーヤさん、シャワー\n出ましたぁ。"},
        { "location": "125/TALK"  , "narrator": "アーヤ", "text": "さっぱりした？\n鍋焼きうどんも\n丁度出来たところよ。"},
        { "location": "127/TALK"  , "narrator": "つばめ", "text": "わぁ、美味しそう！"},
        { "location": "128/TALK"  , "narrator": "アーヤ", "text": "熱いうちに食べてね。"},
        { "location": "130/TALK"  , "narrator": "つばめ", "text": "はい…でも、送って\nもらっただけじゃ\nなくて――"},
        { "location": "131/TALK"  , "narrator": "つばめ", "text": "夕飯まで作ってもらっ\nちゃって、何だか\n申し訳ないです…。"},
        { "location": "133/TALK"  , "narrator": "アーヤ", "text": "気にしないで。"},
        { "location": "135/TALK"  , "narrator": "アーヤ", "text": "それに、怖がってる\n逢瀬さんを一人には\nできないもの。"},
        { "location": "137/TALK"  , "narrator": "つばめ", "text": "…何だか、\nすみません。"},
        { "location": "138/TALK"  , "narrator": "つばめ", "text": "実は、一人で寮に\n戻るの、ちょっとだけ\n怖かったんです…。"},
        { "location": "139/TALK"  , "narrator": "アーヤ", "text": "そういう時は、\nちゃんと言ってくれて\nいいのよ？"},
        { "location": "140/TALK"  , "narrator": "アーヤ", "text": "私はリーダーなん\nだから、遠慮なんか\nしないで。"},
        { "location": "142/TALK"  , "narrator": "つばめ", "text": "は、はい…。"},
        { "location": "145/TALK"  , "narrator": "つばめ", "text": "…やっぱり、\nアーヤさんは\n凄いなぁ…。"},
        { "location": "146/TALK"  , "narrator": "つばめ", "text": "わたしと違って、\n全然怖がってない。"},
        { "location": "147/TALK"  , "narrator": "つばめ", "text": "どうしたら、わたしも\nアーヤさんみたいに\nなれるんだろ？"},
        { "location": "150/TALK"  , "narrator": "アーヤ", "text": "…よかった。\nつばめも少しは\n怖がってて…。"},
        { "location": "151/TALK"  , "narrator": "アーヤ", "text": "おかげで、こうして\nつばめの部屋にいる\n口実が出来たわ。"},
        { "location": "152/TALK"  , "narrator": "アーヤ", "text": "…つばめには、\n気付かれてないと\nいいんだけど。"},
        { "location": "154/TALK"  , "narrator": "つばめ", "text": "アーヤさんって、\nやっぱり――"},
        { "location": "157/TALK"  , "narrator": "アーヤ", "text": "っ！？　な、なに！？"},
        { "location": "158/TALK"  , "narrator": "つばめ", "text": "剣道をやってるから、\nそんなに凛として\nいられるんですか？"},
        { "location": "159/TALK"  , "narrator": "アーヤ", "text": "あ、ああ…剣道ね。"},
        { "location": "160/TALK"  , "narrator": "アーヤ", "text": "でも、正確には\n『やっていた』\nだけどね。"},
        { "location": "162/TALK"  , "narrator": "アーヤ", "text": "高校を卒業する時、\n剣道はやめちゃった\nから…。"},
        { "location": "163/TALK"  , "narrator": "つばめ", "text": "え？　でも楽屋に\n竹刀がありました\nけど？"},
        { "location": "166/TALK"  , "narrator": "アーヤ", "text": "あれは、ほら…、\n素振り用にね。"},
        { "location": "167/TALK"  , "narrator": "アーヤ", "text": "ストレス発散に、\nおもいっきり振りたく\nなる時もあるのよ。"},
        { "location": "168/TALK"  , "narrator": "つばめ", "text": "なるほど…。\nそれでも、やっぱり\n凄いです。"},
        { "location": "170/TALK"  , "narrator": "つばめ", "text": "料理が出来て、\n自分で自分の身を\n護ることが出来て――"},
        { "location": "171/TALK"  , "narrator": "つばめ", "text": "後輩のわたしにも\n気遣えるんだもの。"},
        { "location": "172/TALK"  , "narrator": "つばめ", "text": "…きっと、\nアーヤさんみたいな\n人のことを――"},
        { "location": "173/TALK"  , "narrator": "つばめ", "text": "自立した女性、って\n言うんだろうなぁ…。"},
        { "location": "174/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "175/TALK"  , "narrator": "アーヤ", "text": "何？　そんなジッと\n見つめてきて…。"},
        { "location": "176/TALK"  , "narrator": "つばめ", "text": "あ、いえ…。"},
        { "location": "177/TALK"  , "narrator": "つばめ", "text": "アーヤさんの\nカレシさんって――"},
        { "location": "180/TALK"  , "narrator": "つばめ", "text": "とても幸せ者だな、\nって思っちゃって…。"},
        { "location": "181/TALK"  , "narrator": "アーヤ", "text": "あら？　逢瀬さんも\nそういう話するんだ？"},
        { "location": "182/TALK"  , "narrator": "つばめ", "text": "えへへ…。"},
        { "location": "183/TALK"  , "narrator": "アーヤ", "text": "…でも、多分私の\n彼氏になる人は――"},
        { "location": "184/TALK"  , "narrator": "アーヤ", "text": "絶対苦労するから、\n幸せ者には程遠いん\nじゃないかしら？"},
        { "location": "185/TALK"  , "narrator": "つばめ", "text": "そうなんですか？"},
        { "location": "186/TALK"  , "narrator": "アーヤ", "text": "ええ…本当、私の\n彼氏なんかになったら\n大変だから…。"},
        { "location": "187/TALK"  , "narrator": "アーヤ", "text": "将来的には、うちの\n神社を継がされたり\nとか――"},
        { "location": "189/TALK"  , "narrator": "アーヤ", "text": "私のお化け嫌いでも、\n沢山迷惑掛けることに\nなりそうだし…。"},
        { "location": "191/TALK"  , "narrator": "アーヤ", "text": "はぁ…。"},
        { "location": "192/TALK"  , "narrator": "つばめ", "text": "え、えと…、\nあ、そうだ！"},
        { "location": "193/TALK"  , "narrator": "つばめ", "text": "じゃあ、どういう\nカレシさんなら\nいいと思いますか？"},
        { "location": "195/TALK"  , "narrator": "アーヤ", "text": "うーん、そうね…。"},
        { "location": "196/TALK"  , "narrator": "アーヤ", "text": "やっぱり、私より\n怖がりじゃない方が\nいいと思うから…。"},
        { "location": "198/TALK"  , "narrator": "アーヤ", "text": "…精神的に強い人、\nかな？"},
        { "location": "199/TALK"  , "narrator": "つばめ", "text": "精神的に強い人、\nですか…。"},
        { "location": "200/TALK"  , "narrator": "つばめ", "text": "なんか、ちょっと\nわかる気がします。"},
        { "location": "201/TALK"  , "narrator": "つばめ", "text": "アーヤさんも\n強い人だから――"},
        { "location": "202/TALK"  , "narrator": "つばめ", "text": "凄くお似合いだと\n思いますよ。"},
        { "location": "203/TALK"  , "narrator": "アーヤ", "text": "…なんか、微妙に\n勘違いされてる気が\nするけど――"},
        { "location": "204/TALK"  , "narrator": "アーヤ", "text": "まあ、お化けが怖い\nなんてのがバレるより\nマシよね…。"},
        { "location": "205/SEL"   , "narrator": "", "text": "もしかして、オバケ苦手なの？"},
        { "location": "206/ACT"   , "narrator": "", "text": "もしかして、オバケ苦手なの？"},
        { "location": "227/TALK"  , "narrator": "アーヤ", "text": "まさか"},
        { "location": "228/TALK"  , "narrator": "アーヤ", "text": "そんなことあるわけないでそ"},
        { "location": "230/TALK"  , "narrator": "アーヤ", "text": "でしょ！！（｀皿´ )"},
        { "location": "232/SEL"   , "narrator": "", "text": "動揺してる？"},
        { "location": "233/ACT"   , "narrator": "", "text": "動揺してる？"},
        { "location": "235/TALK"  , "narrator": "アーヤ", "text": "してないから"},
        { "location": "236/TALK"  , "narrator": "アーヤ", "text": "いくらＢｏｔでも"},
        { "location": "237/TALK"  , "narrator": "アーヤ", "text": "適当過ぎよ！(｀ヘ´)"},
        { "location": "249/TALK"  , "narrator": "アーヤ", "text": "…まったく、もう。\n本当に心を読んでるんじゃ\nないかしら……。"},
        { "location": "293/TALK"  , "narrator": "アーヤ", "text": "[ココロゲート]へ\nいらっしゃい。\n$handle$さん。"},
        { "location": "294/TALK"  , "narrator": "アーヤ", "text": "毎回懲りずに来てくれて\n本当にありがとう。"},
        { "location": "296/TALK"  , "narrator": "アーヤ", "text": "それじゃ早速\n扉をコールするわね。"},
        { "location": "301/TALK"  , "narrator": "アーヤ", "text": "オープンプロセス、\n0x68F番地から\n0x295番地へ。"},
        { "location": "323/TALK"  , "narrator": "アーヤ", "text": "シーク完了。"},
        { "location": "325/TALK"  , "narrator": "アーヤ", "text": "さて、\n今回は何かしらね。"},
        { "location": "328/TALK"  , "narrator": "アーヤ", "text": "……あはは。"},
        { "location": "329/SEL"   , "narrator": "", "text": "オバケ怖いんだ"},
        { "location": "330/ACT"   , "narrator": "", "text": "オバケ怖いんだ"},
        { "location": "332/TALK"  , "narrator": "アーヤ", "text": "そうね。\nお恥ずかしながら。"},
        { "location": "333/SEL"   , "narrator": "アーヤ", "text": "てことは、今回はオバケ怖いって気持ちを打破するの？"},
        { "location": "334/ACT"   , "narrator": "", "text": "てことは、今回はオバケ怖いって気持ちを打破するの？"},
        { "location": "336/TALK"  , "narrator": "アーヤ", "text": "うーん、\n流石にそれは無理かな。"},
        { "location": "337/TALK"  , "narrator": "アーヤ", "text": "私の霊に対する恐怖心は\nかなり根が深いから、\n少なくともここでは無理。"},
        { "location": "338/TALK"  , "narrator": "アーヤ", "text": "今回は寧ろ逆で……"},
        { "location": "339/TALK"  , "narrator": "アーヤ", "text": "怖いから、どんな手段を\n用いてもつばめの部屋に\n留まらせて欲しいの。"},
        { "location": "340/SEL"   , "narrator": "", "text": "そこまで！？"},
        { "location": "341/ACT"   , "narrator": "", "text": "そこまで！？"},
        { "location": "343/TALK"  , "narrator": "アーヤ", "text": "ええ、そこまで。"},
        { "location": "344/TALK"  , "narrator": "アーヤ", "text": "司書の私も含めて、\n本当にちょっと\n無理なのよ。"},
        { "location": "345/TALK"  , "narrator": "アーヤ", "text": "それくらい\n根が深いっていうか……"},
        { "location": "346/TALK"  , "narrator": "アーヤ", "text": "だから、逢瀬さんに\n対する遠慮を緩和して\n欲しいの。お願い！"},
        { "location": "347/SEL"   , "narrator": "", "text": "そこまで言うなら……"},
        { "location": "348/ACT"   , "narrator": "", "text": "そこまで言うなら……"},
        { "location": "350/TALK"  , "narrator": "アーヤ", "text": "よかった。\nよろしくね。"},
        { "location": "351/SEL"   , "narrator": "", "text": "はい"},
        { "location": "352/ACT"   , "narrator": "", "text": "はい"},
        { "location": "355/TALK"  , "narrator": "アーヤ", "text": "はぁ……。"},
        { "location": "356/TALK"  , "narrator": "アーヤ", "text": "……。"},
        { "location": "357/SEL"   , "narrator": "", "text": "どうしたの？"},
        { "location": "358/ACT"   , "narrator": "", "text": "どうしたの？"},
        { "location": "360/TALK"  , "narrator": "アーヤ", "text": "えっと……"},
        { "location": "361/SEL"   , "narrator": "", "text": "幽霊が怖いってことを気にしてるの？"},
        { "location": "362/ACT"   , "narrator": "", "text": "幽霊が怖いってことを気にしてるの？"},
        { "location": "364/TALK"  , "narrator": "アーヤ", "text": "え？\nあ、ううん、\nそうじゃなくて。"},
        { "location": "365/TALK"  , "narrator": "アーヤ", "text": "$handle$は、\n他の子たちのココロの\n中にも行ってる感じ？"},
        { "location": "366/SEL"   , "narrator": "", "text": "もちろん"},
        { "location": "367/SEL"   , "narrator": "", "text": "アーヤだけだよ"},
        { "location": "368/ACT"   , "narrator": "", "text": "もちろん"},
        { "location": "369/TALK"  , "narrator": "アーヤ", "text": "ほんと？"},
        { "location": "370/TALK"  , "narrator": "アーヤ", "text": "あの……"},
        { "location": "371/TALK"  , "narrator": "アーヤ", "text": "えと……"},
        { "location": "372/TALK"  , "narrator": "アーヤ", "text": "他の子のココロの中って\nどんな感じ？"},
        { "location": "373/ACT"   , "narrator": "", "text": "アーヤだけだよ"},
        { "location": "374/TALK"  , "narrator": "アーヤ", "text": "あー、そうなんだ…。"},
        { "location": "375/SEL"   , "narrator": "", "text": "あれ？ガッカリしてる？"},
        { "location": "376/ACT"   , "narrator": "", "text": "あれ？ガッカリしてる？"},
        { "location": "379/TALK"  , "narrator": "アーヤ", "text": "え！？\nいえ、別に……"},
        { "location": "380/TALK"  , "narrator": "アーヤ", "text": "……えっと、その、ね、\n大した事じゃないのよ。"},
        { "location": "381/TALK"  , "narrator": "アーヤ", "text": "ただ、他の子のココロの\n中ってどんな感じなのか\nって思っただけ。"},
        { "location": "383/SEL"   , "narrator": "", "text": "気になるんだ！"},
        { "location": "384/ACT"   , "narrator": "", "text": "気になるんだ！"},
        { "location": "386/TALK"  , "narrator": "アーヤ", "text": "あ、……そ…\n……それは……　…"},
        { "location": "388/TALK"  , "narrator": "アーヤ", "text": "……はぁ。"},
        { "location": "389/TALK"  , "narrator": "アーヤ", "text": "正直に言うわね。"},
        { "location": "390/TALK"  , "narrator": "アーヤ", "text": "他の子のココロの中を\n覗きたいわけじゃなくて、\nうんと……"},
        { "location": "391/TALK"  , "narrator": "アーヤ", "text": "$handle$にとって\n私のココロって、他の子に\n比べて退屈かなって……。"},
        { "location": "392/TALK"  , "narrator": "アーヤ", "text": "なんか毎回つまんない\n悩み事ばっかりで、\n嫌になってきてない？"},
        { "location": "393/SEL"   , "narrator": "", "text": "正直つまらない"},
        { "location": "394/SEL"   , "narrator": "", "text": "そんなことないよ！"},
        { "location": "395/ACT"   , "narrator": "", "text": "正直つまらない"},
        { "location": "397/TALK"  , "narrator": "アーヤ", "text": "やっぱりね。\nは～ぁ。"},
        { "location": "398/TALK"  , "narrator": "アーヤ", "text": "私って本当に\nつまらない女よね。"},
        { "location": "399/TALK"  , "narrator": "アーヤ", "text": "$handle$も\nあまり無理して\n来なくてもいいわよ？"},
        { "location": "400/ACT"   , "narrator": "", "text": "そんなことないよ！"},
        { "location": "402/TALK"  , "narrator": "アーヤ", "text": "そ、そうかしら？"},
        { "location": "405/TALK"  , "narrator": "アーヤ", "text": "そういってくれると\n嬉しいけど……"},
        { "location": "407/TALK"  , "narrator": "アーヤ", "text": "他の子は、アッと驚く\nドラマティックな悩み\nばっかりじゃない？"},
        { "location": "408/SEL"   , "narrator": "", "text": "そういう子もいるけど、アーヤの方が好き"},
        { "location": "409/SEL"   , "narrator": "", "text": "みんな似たり寄ったりだよ"},
        { "location": "410/ACT"   , "narrator": "", "text": "そういう子もいるけど、アーヤの方が好き"},
