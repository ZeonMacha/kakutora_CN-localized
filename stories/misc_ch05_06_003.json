    "entry":
    [
        { "location": "684/SCENARIO", "narrator": "", "text": "あまゆり"},
        { "location": "709/TALK"    , "narrator": "神楽", "text": "何の手入れもしない天然美少女なんて存在しない"},
        { "location": "711/SEL"     , "narrator": "", "text": "神楽は天然美少女でしょ！？"},
        { "location": "712/SEL"     , "narrator": "", "text": "夢がー夢がー"},
        { "location": "713/SEL"     , "narrator": "", "text": "努力で勝ち取る美か…"},
        { "location": "714/ACT"     , "narrator": "", "text": "神楽は天然美少女でしょ！？"},
        { "location": "716/TALK"    , "narrator": "神楽", "text": "ガチでピュアちゃんか！！！"},
        { "location": "717/TALK"    , "narrator": "神楽", "text": "残念ながらぴょんこの美は計算で手に入れたものなのですよ？"},
        { "location": "718/TALK"    , "narrator": "神楽", "text": "でも天然と思わせた自分を褒めることにする♪"},
        { "location": "719/ACT"     , "narrator": "", "text": "夢がー夢がー"},
        { "location": "720/TALK"    , "narrator": "神楽", "text": "あははは！"},
        { "location": "722/TALK"    , "narrator": "神楽", "text": "その反応ｲｲﾈ！"},
        { "location": "723/ACT"     , "narrator": "", "text": "努力で勝ち取る美か…"},
        { "location": "724/TALK"    , "narrator": "神楽", "text": "当然でしょー？"},
        { "location": "726/TALK"    , "narrator": "神楽", "text": "だがしかしだがしかし"},
        { "location": "727/TALK"    , "narrator": "神楽", "text": "この世に奇跡は存在する！"},
        { "location": "729/SEL"     , "narrator": "", "text": "またつばめの話？"},
        { "location": "730/SEL"     , "narrator": "", "text": "ガブリエラのことかー"},
        { "location": "731/SEL"     , "narrator": "", "text": "アーヤ、実は盛ってるよね"},
        { "location": "732/SEL"     , "narrator": "", "text": "みやびは不思議ちゃん枠だから"},
        { "location": "733/ACT"     , "narrator": "", "text": "またつばめの話？"},
        { "location": "736/TALK"    , "narrator": "神楽", "text": "他に何があるって話題ですからね"},
        { "location": "737/TALK"    , "narrator": "神楽", "text": "さすが$handlek$はぴょんこの一番の理解者だね！"},
        { "location": "738/ACT"     , "narrator": "", "text": "ガブリエラのことかー"},
        { "location": "739/TALK"    , "narrator": "神楽", "text": "あれはまあ、、、"},
        { "location": "740/TALK"    , "narrator": "神楽", "text": "うん、、、"},
        { "location": "741/ACT"     , "narrator": "", "text": "アーヤ、実は盛ってるよね"},
        { "location": "742/TALK"    , "narrator": "神楽", "text": "言っちゃった、、、"},
        { "location": "743/ACT"     , "narrator": "", "text": "みやびは不思議ちゃん枠だから"},
        { "location": "744/TALK"    , "narrator": "神楽", "text": "何気にしていないわけではないのですよ"},
        { "location": "746/TALK"    , "narrator": "神楽", "text": "それが女子というものなのです"},
        { "location": "748/TALK"    , "narrator": "神楽", "text": "そして女子はお互いの努力を褒めるのです"},
        { "location": "749/TALK"    , "narrator": "神楽", "text": "何のために？"},
        { "location": "750/TALK"    , "narrator": "神楽", "text": "内紛回避のために"},
        { "location": "751/TALK"    , "narrator": "神楽", "text": "あるいは愛に発展することを期待しているために"}
    ]
}
