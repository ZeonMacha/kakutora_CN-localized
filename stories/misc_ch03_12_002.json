    "entry":
    [
        { "location": "91/SCENARIO", "narrator": "", "text": "017_世界の果ての王国で"},
        { "location": "116/TALK"   , "narrator": "ガブリエラ", "text": "その王国には"},
        { "location": "117/TALK"   , "narrator": "ガブリエラ", "text": "全てのものがありました"},
        { "location": "118/TALK"   , "narrator": "ガブリエラ", "text": "けれどもその王国のことは"},
        { "location": "119/TALK"   , "narrator": "ガブリエラ", "text": "誰も知りませんでした"},
        { "location": "121/SEL"    , "narrator": "", "text": "はあ"},
        { "location": "122/SEL"    , "narrator": "", "text": "具体的な国名は？"},
        { "location": "123/SEL"    , "narrator": "", "text": "続きを聞かせて"},
        { "location": "124/ACT"    , "narrator": "", "text": "はあ"},
        { "location": "125/TALK"   , "narrator": "ガブリエラ", "text": "あら"},
        { "location": "126/TALK"   , "narrator": "ガブリエラ", "text": "興味ないかしら"},
        { "location": "127/ACT"    , "narrator": "", "text": "具体的な国名は？"},
        { "location": "128/TALK"   , "narrator": "ガブリエラ", "text": "まだ教えられないわ"},
        { "location": "129/TALK"   , "narrator": "ガブリエラ", "text": "今考えてるところだから"},
        { "location": "130/ACT"    , "narrator": "", "text": "続きを聞かせて"},
        { "location": "132/TALK"   , "narrator": "ガブリエラ", "text": "あら♪"},
        { "location": "133/TALK"   , "narrator": "ガブリエラ", "text": "興味持ってくれたのねｖ"},
        { "location": "134/TALK"   , "narrator": "ガブリエラ", "text": "マルザンナったら♪"},
        { "location": "136/TALK"   , "narrator": "ガブリエラ", "text": "最初は日本にしようと思ったのよ"},
        { "location": "137/TALK"   , "narrator": "ガブリエラ", "text": "でもね"},
        { "location": "138/TALK"   , "narrator": "ガブリエラ", "text": "ポーランドの方が"},
        { "location": "139/TALK"   , "narrator": "ガブリエラ", "text": "近いかもしれないって思い直したりしているのよ"},
        { "location": "141/SEL"    , "narrator": "", "text": "どうして？"},
        { "location": "142/ACT"    , "narrator": "", "text": "どうして？"},
        { "location": "144/TALK"   , "narrator": "ガブリエラ", "text": "ええとね・・・"},
        { "location": "145/TALK"   , "narrator": "ガブリエラ", "text": "日本人にはポーランドがなじみがないのよね"},
        { "location": "146/TALK"   , "narrator": "ガブリエラ", "text": "びっくりするくらい"},
        { "location": "147/TALK"   , "narrator": "ガブリエラ", "text": "ポーランドにいる時は"},
        { "location": "148/TALK"   , "narrator": "ガブリエラ", "text": "日本の情報は入ってきてたのにね"},
        { "location": "150/SEL"    , "narrator": "", "text": "そうなの？"},
        { "location": "151/ACT"    , "narrator": "", "text": "そうなの？"},
        { "location": "153/TALK"   , "narrator": "ガブリエラ", "text": "そうなのよ・・・"},
        { "location": "154/TALK"   , "narrator": "ガブリエラ", "text": "ポーランドではね"},
        { "location": "155/TALK"   , "narrator": "ガブリエラ", "text": "お隣の国が日本だったらいいのにって"},
        { "location": "156/TALK"   , "narrator": "ガブリエラ", "text": "みんな言ってたのにね"},
        { "location": "158/SEL"    , "narrator": "", "text": "そうだったんだ"},
        { "location": "159/SEL"    , "narrator": "", "text": "またまた大げさな"},
        { "location": "160/ACT"    , "narrator": "", "text": "そうだったんだ"},
        { "location": "161/TALK"   , "narrator": "ガブリエラ", "text": "そうなのよ！"},
        { "location": "162/ACT"    , "narrator": "", "text": "またまた大げさな"},
        { "location": "163/TALK"   , "narrator": "ガブリエラ", "text": "本当のことよ！"},
        { "location": "165/TALK"   , "narrator": "ガブリエラ", "text": "だから"},
        { "location": "166/TALK"   , "narrator": "ガブリエラ", "text": "誰も知らない王国は"},
        { "location": "167/TALK"   , "narrator": "ガブリエラ", "text": "ポーランドのことなのかしら・・・？"},
        { "location": "168/TALK"   , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "169/TALK"   , "narrator": "ガブリエラ", "text": "知ればみんなもきっと好きになると思うわ・・・？"},
        { "location": "171/TALK"   , "narrator": "ガブリエラ", "text": "きっと"}
    ]
}
