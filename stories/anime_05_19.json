{
    "dir": "chap19/daydra/anime_05_19.js",
    "type": "MainStory",
    "info": {
        "story_id": "19501",
        "cid": "kagura",
        "title": "001 アニメーション",
        "sub_title": "記憶の数だけ抱きしめて"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "アニメ第19話"},
        { "location": "20/TALK"   , "narrator": "エリカ", "text": "コーンコン。"},
        { "location": "21/TALK"   , "narrator": "エリカ", "text": "いらっしゃい\n$handle$さん。"},
        { "location": "22/TALK"   , "narrator": "エリカ", "text": "もう一度お話聞く？\nそれとも、省略する？"},
        { "location": "23/SEL"    , "narrator": "", "text": "もう一度聞く"},
        { "location": "24/SEL"    , "narrator": "", "text": "飛ばす"},
        { "location": "25/ACT"    , "narrator": "", "text": "もう一度聞く"},
        { "location": "26/TALK"   , "narrator": "エリカ", "text": "うん、わかったよ。"},
        { "location": "28/ACT"    , "narrator": "", "text": "飛ばす"},
        { "location": "29/TALK"   , "narrator": "エリカ", "text": "そっかー。\nそれじゃ、またね。"},
        { "location": "35/TALK"   , "narrator": "エリカ", "text": "コーンコン。"},
        { "location": "36/TALK"   , "narrator": "エリカ", "text": "いよいよ今回から\nリプレイス本番だね！"},
        { "location": "37/TALK"   , "narrator": "エリカ", "text": "なんだかちょっと\nドキドキしてきたよ！"},
        { "location": "38/SEL"    , "narrator": "", "text": "$me$も！"},
        { "location": "39/SEL"    , "narrator": "", "text": "それよりぴょんこが大変な事に！"},
        { "location": "40/ACT"    , "narrator": "", "text": "$me$も！"},
        { "location": "41/TALK"   , "narrator": "エリカ", "text": "わたしと同じだね！"},
        { "location": "42/ACT"    , "narrator": "", "text": "それよりぴょんこが大変な事に！"},
        { "location": "43/TALK"   , "narrator": "エリカ", "text": "え？"},
        { "location": "44/SEL"    , "narrator": "", "text": "消えちゃった"},
        { "location": "45/ACT"    , "narrator": "", "text": "消えちゃった"},
        { "location": "47/TALK"   , "narrator": "エリカ", "text": "ええっ！"},
        { "location": "48/TALK"   , "narrator": "エリカ", "text": "もしかして、\nもうそこまで同化が…！？"},
        { "location": "49/SEL"    , "narrator": "", "text": "ココロの中ではそう聞いたけど"},
        { "location": "50/ACT"    , "narrator": "", "text": "ココロの中ではそう聞いたけど"},
        { "location": "52/TALK"   , "narrator": "エリカ", "text": "……なるほど。\nそっかー……。"},
        { "location": "53/SEL"    , "narrator": "", "text": "ぴょんこが消えること、わかってなかったの？"},
        { "location": "54/SEL"    , "narrator": "", "text": "なんで消えると解っててぴょんこを司書に据えたの？"},
        { "location": "55/ACT"    , "narrator": "", "text": "ぴょんこが消えること、わかってなかったの？"},
        { "location": "56/TALK"   , "narrator": "エリカ", "text": "そもそも、同化が起こる\nこと自体が想定外だから。"},
        { "location": "57/ACT"    , "narrator": "", "text": "なんで消えると解っててぴょんこを司書に据えたの？"},
        { "location": "58/TALK"   , "narrator": "エリカ", "text": "わかってない、\nわかってない！"},
        { "location": "59/TALK"   , "narrator": "エリカ", "text": "もちろん、同化が起これば\nその可能性もあることは\nわかっていたけど――"},
        { "location": "60/TALK"   , "narrator": "エリカ", "text": "そもそも、同化が起こる\nこと自体が想定外だから。"},
        { "location": "62/TALK"   , "narrator": "エリカ", "text": "外からの侵入による\n“彼ら”以外に、そこまで\nできる人はいないし。"},
        { "location": "63/TALK"   , "narrator": "エリカ", "text": "だから、同化が進行する\nこと自体が、殆ど無いって\n前提で考えてたわけで。"},
        { "location": "64/SEL"    , "narrator": "", "text": "それじゃ仕方ないね"},
        { "location": "65/SEL"    , "narrator": "", "text": "えらい自信マンマンだったんだな"},
        { "location": "66/ACT"    , "narrator": "", "text": "それじゃ仕方ないね"},
        { "location": "67/TALK"   , "narrator": "エリカ", "text": "いや、でも。"},
        { "location": "68/TALK"   , "narrator": "エリカ", "text": "起きちゃってるからには、\nわたしの認識が甘かった\nってことだから。"},
        { "location": "69/TALK"   , "narrator": "エリカ", "text": "だから、\nわたしの責任だよ。"},
        { "location": "70/ACT"    , "narrator": "", "text": "えらい自信マンマンだったんだな"},
        { "location": "71/TALK"   , "narrator": "エリカ", "text": "ほんとだよね。\nごめんなさい……。"},
        { "location": "72/TALK"   , "narrator": "エリカ", "text": "全部わたしの\n責任だよ。"},
        { "location": "74/SEL"    , "narrator": "", "text": "エリカは自分を責めすぎだよ？"},
        { "location": "75/SEL"    , "narrator": "", "text": "その通りだ、早く何とかしてくれ"},
        { "location": "76/ACT"    , "narrator": "", "text": "エリカは自分を責めすぎだよ？"},
        { "location": "77/TALK"   , "narrator": "エリカ", "text": "えー、そうかな。"},
        { "location": "78/TALK"   , "narrator": "エリカ", "text": "元はといえば、\n今のこの状況自体が\nわたしの責任だもの。"},
        { "location": "79/TALK"   , "narrator": "エリカ", "text": "わたしが量子の研究を\nしていなければ、\nこんなことには……。"},
        { "location": "80/SEL"    , "narrator": "", "text": "それは飛躍しすぎだって"},
        { "location": "81/SEL"    , "narrator": "", "text": "まあ、それはそうだけど…"},
        { "location": "82/ACT"    , "narrator": "", "text": "それは飛躍しすぎだって"},
        { "location": "83/TALK"   , "narrator": "エリカ", "text": "でもね。"},
        { "location": "84/ACT"    , "narrator": "", "text": "まあ、それはそうだけど…"},
        { "location": "85/TALK"   , "narrator": "エリカ", "text": "だからね！"},
        { "location": "87/TALK"   , "narrator": "エリカ", "text": "今の状況を打破しなくちゃ\nいけないってのは、\n揺るぎない事実なの。"},
        { "location": "88/TALK"   , "narrator": "エリカ", "text": "だから、わたしには\n全力で解決しなければ\nならない義務がある。"},
        { "location": "89/ACT"    , "narrator": "", "text": "その通りだ、早く何とかしてくれ"},
        { "location": "90/TALK"   , "narrator": "エリカ", "text": "もちろん、わたしも\nそのつもりだよ。"},
        { "location": "91/TALK"   , "narrator": "エリカ", "text": "ちょっと能力が足りなくて\n失敗ばかりだけど……\n次はもっと頑張るから！"},
        { "location": "93/TALK"   , "narrator": "エリカ", "text": "というわけで――"},
        { "location": "94/TALK"   , "narrator": "エリカ", "text": "今回は、神楽ちゃんの\nココロゲートに\n出向するよ。"},
        { "location": "95/TALK"   , "narrator": "エリカ", "text": "本気でやるなら、\n現場に行って自分の目で\n色々確認しなくちゃ。"},
        { "location": "96/SEL"    , "narrator": "", "text": "わーい！また後で会えるんだね！"},
        { "location": "97/SEL"    , "narrator": "", "text": "まあ、程々にね"},
        { "location": "98/ACT"    , "narrator": "", "text": "わーい！また後で会えるんだね！"},
        { "location": "99/TALK"   , "narrator": "エリカ", "text": "えへへ、\nそうだねー。"},
        { "location": "100/ACT"   , "narrator": "", "text": "まあ、程々にね"},
        { "location": "101/TALK"  , "narrator": "エリカ", "text": "うん。ありがと。"},
        { "location": "106/TALK"  , "narrator": "エリカ", "text": "それじゃ、\nリプレイスについて\nお話していくよ。"},
        { "location": "107/TALK"  , "narrator": "エリカ", "text": "まず最初に――"},
        { "location": "108/TALK"  , "narrator": "エリカ", "text": "これから行っていく\nリプレイスは、あなたの\n同意の元で行います。"},
        { "location": "109/TALK"  , "narrator": "エリカ", "text": "だから、最初から\n否定的だったり、途中で\n気が変わった場合――"},
        { "location": "110/TALK"  , "narrator": "エリカ", "text": "後からでも、そちらを\n選択できるようになって\nいるから、安心してね。"},
        { "location": "111/TALK"  , "narrator": "エリカ", "text": "あ、でも、それは\nあなたが選択できる\n幅の問題で。"},
        { "location": "112/TALK"  , "narrator": "エリカ", "text": "一度あなたの意見を\n聞いちゃった子は、当然\nそれを元に考えて行く。"},
        { "location": "113/TALK"  , "narrator": "エリカ", "text": "その後に否定しても、\n同じ未来には辿り着かない\nかもしれないから――"},
        { "location": "114/TALK"  , "narrator": "エリカ", "text": "そこだけは、\n誤解しないようにね。"},
        { "location": "115/TALK"  , "narrator": "エリカ", "text": "というわけで。\n早速だけど、まずは\n前提となる知識から。"},
        { "location": "116/TALK"  , "narrator": "エリカ", "text": "あなたがこのリプレイスに\nついて、価値ある事か\n否かを判断できるように―"},
        { "location": "117/TALK"  , "narrator": "エリカ", "text": "今から、わたしたちが\n作りたい未来について、\n簡単に説明していくね。"},
        { "location": "118/TALK"  , "narrator": "エリカ", "text": "よければ、\n聞いていってください。"},
        { "location": "119/SEL"   , "narrator": "", "text": "聞く"},
        { "location": "120/SEL"   , "narrator": "", "text": "聞かない"},
        { "location": "121/ACT"   , "narrator": "", "text": "聞く"},
        { "location": "122/TALK"  , "narrator": "エリカ", "text": "それじゃ、\nお話していくね。"},
        { "location": "123/TALK"  , "narrator": "エリカ", "text": "まず、目標だけど――"},
        { "location": "124/TALK"  , "narrator": "エリカ", "text": "前にも話したとおり、\n最低目標と理想目標の\n２つを設定します。"},
        { "location": "125/TALK"  , "narrator": "エリカ", "text": "最低目標は――"},
        { "location": "126/TALK"  , "narrator": "エリカ", "text": "“彼ら”がこの\nフェノメノンに全く干渉\nできない現在を作ること。"},
        { "location": "127/TALK"  , "narrator": "エリカ", "text": "そして、\n理想目標は――"},
        { "location": "128/TALK"  , "narrator": "エリカ", "text": "その状態で、\nフェノメノンを飛散させ\n内外を１つの世界にし――"},
        { "location": "129/TALK"  , "narrator": "エリカ", "text": "その結果発生する\n“ギャップの衝突”に\n打ち勝つこと。"},
        { "location": "130/SEL"   , "narrator": "", "text": "蒸着だっけ？"},
        { "location": "131/ACT"   , "narrator": "", "text": "蒸着だっけ？"},
        { "location": "133/TALK"  , "narrator": "エリカ", "text": "そのとおり！"},
        { "location": "134/TALK"  , "narrator": "エリカ", "text": "簡単に言ってしまえば――"},
        { "location": "135/TALK"  , "narrator": "エリカ", "text": "今の日本の状態を\n維持しつつ、隔てる\n繭だけを取り去る方法。"},
        { "location": "136/TALK"  , "narrator": "エリカ", "text": "今回の作戦では、当然\n理想目標を目指して\n進行していくよ。"},
        { "location": "137/SEL"   , "narrator": "", "text": "ふむ"},
        { "location": "138/SEL"   , "narrator": "", "text": "それには問題があると思う"},
        { "location": "139/ACT"   , "narrator": "", "text": "ふむ"},
        { "location": "140/ACT"   , "narrator": "", "text": "それには問題があると思う"},
        { "location": "141/TALK"  , "narrator": "エリカ", "text": "例えば？"},
        { "location": "143/SEL"   , "narrator": "", "text": "今フェノメノンを作ってるつばめはどうなるの？"},
        { "location": "144/SEL"   , "narrator": "", "text": "今日本にいる全ての人の、繭に飲み込まれる前の本来の記憶はどうなるの？"},
        { "location": "145/SEL"   , "narrator": "", "text": "その後“彼ら”によってまた爆撃されたりすることはないの？"},
        { "location": "146/SEL"   , "narrator": "", "text": "もう大丈夫\n<color=blue>（※先に進みます）</color>"},
        { "location": "147/ACT"   , "narrator": "", "text": "今フェノメノンを作ってるつばめはどうなるの？"},
        { "location": "148/TALK"  , "narrator": "エリカ", "text": "もちろん、無事だよ。"},
        { "location": "149/SEL"   , "narrator": "", "text": "魂は残ってるから大丈夫、とか言ったりしないよね？"},
        { "location": "150/ACT"   , "narrator": "", "text": "魂は残ってるから大丈夫、とか言ったりしないよね？"},
        { "location": "152/TALK"  , "narrator": "エリカ", "text": "ち、ちがうよ。\nちゃんと人間として\n無事でいられるよ？"},
        { "location": "153/SEL"   , "narrator": "", "text": "でも蒸着って、フェノメノン内の世界がそのまま残るわけでしょう？"},
        { "location": "154/ACT"   , "narrator": "", "text": "でも蒸着って、フェノメノン内の世界がそのまま残るわけでしょう？"},
        { "location": "156/TALK"  , "narrator": "エリカ", "text": "そうだよ。"},
        { "location": "157/SEL"   , "narrator": "", "text": "じゃあ、その世界の源であるつばめも、世界になったままなのでは？"},
        { "location": "158/ACT"   , "narrator": "", "text": "じゃあ、その世界の源であるつばめも、世界になったままなのでは？"},
        { "location": "160/TALK"  , "narrator": "エリカ", "text": "確かに、普通の蒸着だと\nそうなっちゃうよね。"},
        { "location": "161/TALK"  , "narrator": "エリカ", "text": "わたしもその点については\nかなり気にしていて。"},
        { "location": "162/TALK"  , "narrator": "エリカ", "text": "色々考えて、今の作戦に\n至ってるの。"},
        { "location": "163/TALK"  , "narrator": "エリカ", "text": "具体的にどうすることに\nしたのかは、この後\n説明するね。"},
        { "location": "166/ACT"   , "narrator": "", "text": "今日本にいる全ての人の、繭に飲み込まれる前の本来の記憶はどうなるの？"},
        { "location": "167/TALK"  , "narrator": "エリカ", "text": "それに関しては、\n現状のところ、今の繭内の\n日本を生きる記憶が勝る。"},
        { "location": "168/TALK"  , "narrator": "エリカ", "text": "ただ、わたしも\nそこに関しては\n色々考えたけど――"},
        { "location": "169/TALK"  , "narrator": "エリカ", "text": "どうしても“敗戦によって\n瓦礫と化した日本”という\n過去と切り離せなくて。"},
        { "location": "170/SEL"   , "narrator": "", "text": "切り離す必要は無く、敗戦後の瓦礫からちゃんと歴史を繋いでいくべき"},
        { "location": "171/SEL"   , "narrator": "", "text": "どうして？"},
        { "location": "172/ACT"   , "narrator": "", "text": "切り離す必要は無く、敗戦後の瓦礫からちゃんと歴史を繋いでいくべき"},
        { "location": "173/TALK"  , "narrator": "エリカ", "text": "そうだね。\nそれも１つの結論だよ。"},
        { "location": "174/ACT"   , "narrator": "", "text": "どうして？"},
        { "location": "175/TALK"  , "narrator": "エリカ", "text": "ある程度双方をマージ\nできても、やはりどちらか\nの一部は欠落するの。"},
        { "location": "176/TALK"  , "narrator": "エリカ", "text": "理由は簡単で。"},
        { "location": "177/TALK"  , "narrator": "エリカ", "text": "どちらかの記憶は、\n今見える景色とは明らかに\n矛盾するから。"},
        { "location": "178/TALK"  , "narrator": "エリカ", "text": "例えば――"},
        { "location": "179/TALK"  , "narrator": "エリカ", "text": "あなたが、今の瞬間に\n唐突に自分の周りが\n焼け野原になったら。"},
        { "location": "180/TALK"  , "narrator": "エリカ", "text": "そのまっただ中に\nいるという現実を\n受けとめられるかどうか。"},
        { "location": "181/TALK"  , "narrator": "エリカ", "text": "もちろんその直前までの\n記憶は、平和で、寝食にも\n不安が無い状態だよ？"},
        { "location": "182/SEL"   , "narrator": "", "text": "混乱するね…"},
        { "location": "183/ACT"   , "narrator": "", "text": "混乱するね…"},
        { "location": "185/TALK"  , "narrator": "エリカ", "text": "そうだね。"},
        { "location": "186/TALK"  , "narrator": "エリカ", "text": "だから少なくとも、\nフェノメノンが発症する\n前後の記憶に関しては――"},
        { "location": "187/TALK"  , "narrator": "エリカ", "text": "洗脳か防衛機制、\nどちらかによって矛盾を\n無くさなければならない。"},
        { "location": "188/TALK"  , "narrator": "エリカ", "text": "要するにこの問題は、\nトロッコ問題と同じで、\nどちらかしか選べない。"},
        { "location": "189/SEL"   , "narrator": "", "text": "確かに"},
        { "location": "190/SEL"   , "narrator": "", "text": "またトロッコ問題！？"},
        { "location": "191/ACT"   , "narrator": "", "text": "確かに"},
        { "location": "192/ACT"   , "narrator": "", "text": "またトロッコ問題！？"},
        { "location": "193/TALK"  , "narrator": "エリカ", "text": "あ、あれ？"},
        { "location": "194/TALK"  , "narrator": "エリカ", "text": "わたし、\n前にトロッコ問題の話\nしてたかな？"},
        { "location": "196/TALK"  , "narrator": "エリカ", "text": "この件に関しては、\n何を選択するかで\n解決するしかないと思う。"},
        { "location": "198/TALK"  , "narrator": "エリカ", "text": "だから、それについては\nリプレイス作業が\n滞りなく終わって――"},
        { "location": "199/TALK"  , "narrator": "エリカ", "text": "世界をどうするかを、\n落ち着いて決められる\n段階になったら。"},
        { "location": "200/TALK"  , "narrator": "エリカ", "text": "改めて、あなたの\n意見を聞きたいと思う。"},
        { "location": "201/TALK"  , "narrator": "エリカ", "text": "もちろん、\nその段になって――"},
        { "location": "202/TALK"  , "narrator": "エリカ", "text": "もう、つばめちゃんの\nフェノメノン発症前には\n戻せません！"},
        { "location": "203/TALK"  , "narrator": "エリカ", "text": "――なんて事は無いから。\nその点は、安心してね。"},
        { "location": "206/ACT"   , "narrator": "", "text": "その後“彼ら”によってまた爆撃されたりすることはないの？"},
        { "location": "207/TALK"  , "narrator": "エリカ", "text": "それは無いかな。"},
        { "location": "208/SEL"   , "narrator": "", "text": "でも、フェノメノンという防壁が無くなったら、間違いなく干渉してくるよね？"},
        { "location": "209/ACT"   , "narrator": "", "text": "でも、フェノメノンという防壁が無くなったら、間違いなく干渉してくるよね？"},
        { "location": "211/TALK"  , "narrator": "エリカ", "text": "そうだね。"},
        { "location": "212/TALK"  , "narrator": "エリカ", "text": "普通に蒸着したら、\n多分そうなると思う。"},
        { "location": "214/TALK"  , "narrator": "エリカ", "text": "当然、最低目標である\n“彼らの干渉を無くす”、\nという前提の上の話だよ。"},
        { "location": "215/TALK"  , "narrator": "エリカ", "text": "具体的にどうすることに\nしたのかは、この後\n説明するね。"},
        { "location": "218/ACT"   , "narrator": "", "text": "もう大丈夫\n<color=blue>（※先に進みます）</color>"},
        { "location": "220/TALK"  , "narrator": "エリカ", "text": "わかったよ。"},
        { "location": "222/ACT"   , "narrator": "", "text": "聞かない"},
        { "location": "223/TALK"  , "narrator": "エリカ", "text": "はい。\nわかりました。"},
        { "location": "225/TALK"  , "narrator": "エリカ", "text": "それでね、具体的に\nどうやって蒸着するのか\nなんだけど――"},
        { "location": "228/TALK"  , "narrator": "エリカ", "text": "<color=red>2E113世界を\n媒介として\n使う事にします！</color>"},
        { "location": "229/SEL"   , "narrator": "", "text": "今エリカがいるところだっけ？"},
        { "location": "230/SEL"   , "narrator": "", "text": "どこよそれ"},
        { "location": "231/ACT"   , "narrator": "", "text": "今エリカがいるところだっけ？"},
        { "location": "232/TALK"  , "narrator": "エリカ", "text": "うん、そうだよ。"},
        { "location": "233/ACT"   , "narrator": "", "text": "どこよそれ"},
        { "location": "234/TALK"  , "narrator": "エリカ", "text": "前にもお話したけど、\n今わたしがいる\n世界のことだよ。"},
        { "location": "235/TALK"  , "narrator": "エリカ", "text": "外の現実世界でもなく、\nつばめちゃんの\nフェノメノンでもない。"},
        { "location": "237/TALK"  , "narrator": "エリカ", "text": "場所はというと――"},
        { "location": "243/TALK"  , "narrator": "エリカ", "text": "こんな感じで、\nつばめちゃんの世界の\n外側にあります！"},
        { "location": "244/SEL"   , "narrator": "", "text": "えっ、なにこれ！？"},
        { "location": "245/ACT"   , "narrator": "", "text": "えっ、なにこれ！？"},
        { "location": "247/TALK"  , "narrator": "エリカ", "text": "わたしが\n作りました！"},
        { "location": "248/TALK"  , "narrator": "エリカ", "text": "千羽鶴ちゃんの追跡から\n身を潜めるときにね。"},
        { "location": "249/SEL"   , "narrator": "", "text": "どうなってるの？"},
        { "location": "250/ACT"   , "narrator": "", "text": "どうなってるの？"},
        { "location": "252/TALK"  , "narrator": "エリカ", "text": "つばめちゃんの繭、\nすなわち不確定量子の雲の\n厚みの中にある世界なの。"},
        { "location": "253/TALK"  , "narrator": "エリカ", "text": "要するに、不確定な中の\n一部を確定させて、世界を\n作っちゃってるってこと。"},
        { "location": "254/TALK"  , "narrator": "エリカ", "text": "この世界は今、\nまっさらな状態だから――"},
        { "location": "255/TALK"  , "narrator": "エリカ", "text": "そこに、つばめちゃんの\nフェノメノンの全情報を\nコピーするの。"},
        { "location": "256/TALK"  , "narrator": "エリカ", "text": "そして、つばめちゃんには\n普通にフェノメノンを\n収束してもらう。"},
        { "location": "257/TALK"  , "narrator": "エリカ", "text": "そうすると、収束した後に\n現れる世界は、荒廃した\n現実の世界ではなく――"},
        { "location": "258/TALK"  , "narrator": "エリカ", "text": "コピーした2E113…\nすなわち、全く同じ\n世界になるよ。"},
        { "location": "259/SEL"   , "narrator": "", "text": "確かにこれならつばめは人間に戻れるね"},
        { "location": "260/SEL"   , "narrator": "", "text": "これって結局日本と世界は切り離されたママなのでは？"},
        { "location": "261/ACT"   , "narrator": "", "text": "確かにこれならつばめは人間に戻れるね"},
        { "location": "262/TALK"  , "narrator": "エリカ", "text": "そうなの！"},
        { "location": "263/TALK"  , "narrator": "エリカ", "text": "つばめちゃんの問題を\n解決できるでしょ？"},
        { "location": "264/TALK"  , "narrator": "エリカ", "text": "それでね、\nその後なんだけど――"},
        { "location": "265/ACT"   , "narrator": "", "text": "これって結局日本と世界は切り離されたママなのでは？"},
        { "location": "266/TALK"  , "narrator": "エリカ", "text": "ここまでだとね。"},
        { "location": "268/TALK"  , "narrator": "エリカ", "text": "この次の段階で\n蒸着をさせて、\n世界をくっつける。"},
        { "location": "269/TALK"  , "narrator": "エリカ", "text": "けどその前に、“彼ら”\nから干渉がなくなるように\nしないとだよね。"},
        { "location": "270/TALK"  , "narrator": "エリカ", "text": "そっちはそっちで\n今、着々と準備を\nしつつはあるんだけど…"},
        { "location": "271/TALK"  , "narrator": "エリカ", "text": "これにはどうしても\nぴょんこちゃんの力が\n必要で。"},
        { "location": "272/TALK"  , "narrator": "エリカ", "text": "だから、一刻も早く\nぴょんこちゃんを助け\n出さなくちゃいけない。"},
        { "location": "277/TALK"  , "narrator": "エリカ", "text": "概要としては、\nだいたいこんな感じかな。"},
        { "location": "278/SEL"   , "narrator": "", "text": "2E113世界のこと、なんで今まで黙ってたの？"},
        { "location": "279/ACT"   , "narrator": "", "text": "2E113世界のこと、なんで今まで黙ってたの？"},
        { "location": "281/TALK"  , "narrator": "エリカ", "text": "うーん、だって……"},
        { "location": "282/TALK"  , "narrator": "エリカ", "text": "……。"},
        { "location": "283/TALK"  , "narrator": "エリカ", "text": "…バレたら大変でしょ？"},
        { "location": "284/TALK"  , "narrator": "エリカ", "text": "特にリプレイス前は、\n千羽鶴ちゃんにバレたら\n色々終わっちゃうし。"},
        { "location": "285/TALK"  , "narrator": "エリカ", "text": "でも、今はもう一緒に\n考える仲だし――"},
        { "location": "286/TALK"  , "narrator": "エリカ", "text": "外からの接触も\n今現在は無いから、\n言っても大丈夫かなって。"},
        { "location": "287/TALK"  , "narrator": "エリカ", "text": "それに、そろそろこの話を\nあなたにも共有して\nおかないと――"},
        { "location": "288/TALK"  , "narrator": "エリカ", "text": "直前に言われたり、\n種明かし無しでボタンだけ\n押すのは無理でしょ？"},
        { "location": "289/SEL"   , "narrator": "", "text": "まあね"},
        { "location": "290/ACT"   , "narrator": "", "text": "まあね"},
        { "location": "292/TALK"  , "narrator": "エリカ", "text": "というわけで！"},
        { "location": "293/TALK"  , "narrator": "エリカ", "text": "あなたが今のお話に\n賛同してくれても、\nしてくれなくても――"},
        { "location": "294/TALK"  , "narrator": "エリカ", "text": "いつも通り、神楽ちゃんの\nデイドラエピソードに\nアクセスしてください。"},
        { "location": "295/TALK"  , "narrator": "エリカ", "text": "そして、賛同する場合は\nお願いする通りに会話を\nしてもらいたくて――"},
        { "location": "296/TALK"  , "narrator": "エリカ", "text": "賛同しない場合は、\n自身の考えを貫いて\nくれればいい。"},
        { "location": "297/SEL"   , "narrator": "", "text": "わかった"},
        { "location": "298/ACT"   , "narrator": "", "text": "わかった"},
        { "location": "300/TALK"  , "narrator": "エリカ", "text": "うん。\nありがとう。"},
        { "location": "301/TALK"  , "narrator": "エリカ", "text": "それじゃあ、\nデイドラエピソードの\n前に――"},
        { "location": "302/TALK"  , "narrator": "エリカ", "text": "今の状況を\n記録映像で\nおさらいするよ。"},
        { "location": "304/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/69MB 4:24】</color>"},
        { "location": "305/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/23MB 4:24】</color>"},
        { "location": "306/SEL"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "307/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/69MB 4:24】</color>"},
        { "location": "308/TALK"  , "narrator": "エリカ", "text": "わかったよ。"},
        { "location": "314/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/23MB 4:24】</color>"},
        { "location": "315/TALK"  , "narrator": "エリカ", "text": "わかったよ。"},
        { "location": "321/ACT"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "322/TALK"  , "narrator": "エリカ", "text": "あらら。"},
        { "location": "355/TALK"  , "narrator": "エリカ", "text": "というわけで、\n今回の記録映像は――"},
        { "location": "356/TALK"  , "narrator": "エリカ", "text": "みんなで三戸浜の\n海へ行った\nところだったね。"},
        { "location": "357/SEL"   , "narrator": "", "text": "そうだね"},
        { "location": "358/SEL"   , "narrator": "", "text": "海編最高！水着最高！"},
        { "location": "359/SEL"   , "narrator": "", "text": "海…うっ、頭が……"},
        { "location": "360/ACT"   , "narrator": "", "text": "そうだね"},
        { "location": "361/ACT"   , "narrator": "", "text": "海編最高！水着最高！"},
        { "location": "362/TALK"  , "narrator": "エリカ", "text": "うんうん！\nみんな可愛いよね！"},
        { "location": "363/TALK"  , "narrator": "エリカ", "text": "わたしはもう、\nお腹出てきちゃってるから\n水着は無理だけど。"},
        { "location": "364/SEL"   , "narrator": "", "text": "そうなんだ"},
        { "location": "365/SEL"   , "narrator": "", "text": "エリカの水着見たいよ！"},
        { "location": "366/ACT"   , "narrator": "", "text": "そうなんだ"},
        { "location": "367/TALK"  , "narrator": "エリカ", "text": "もうそんな若くないし、\n運動も全然してないから。"},
        { "location": "368/ACT"   , "narrator": "", "text": "エリカの水着見たいよ！"},
        { "location": "370/TALK"  , "narrator": "エリカ", "text": "うーん。"},
        { "location": "372/TALK"  , "narrator": "エリカ", "text": "すごく恥ずかしいから\nダメです！"},
        { "location": "376/ACT"   , "narrator": "", "text": "海…うっ、頭が……"},
        { "location": "377/TALK"  , "narrator": "エリカ", "text": "ああっ！\n大変！！"},
        { "location": "378/TALK"  , "narrator": "エリカ", "text": "もしかして、\nリプレイス前のこと\n思い出してたりする？"},
        { "location": "379/TALK"  , "narrator": "エリカ", "text": "でも大丈夫だよ！\n今回は……"},
        { "location": "380/TALK"  , "narrator": "エリカ", "text": "……。"},
        { "location": "381/TALK"  , "narrator": "エリカ", "text": "あまり変わらないけど！\nでも素敵な未来に\n続いてる筈だから！"},
        { "location": "383/TALK"  , "narrator": "エリカ", "text": "というわけで、\n早速だけど、今回お願い\nしたいことを伝えるよ。"},
        { "location": "386/TALK"  , "narrator": "エリカ", "text": "恐らく想像は\nついていると思うけど――"},
        { "location": "387/TALK"  , "narrator": "エリカ", "text": "この辺りから、皇長官の\n神楽ちゃんへの接触が\nかなり増えてくる。"},
        { "location": "388/TALK"  , "narrator": "エリカ", "text": "それでね、\nここから数回の間。"},
        { "location": "389/TALK"  , "narrator": "エリカ", "text": "具体的には、神楽ちゃんが\nヘリで連れて行かれる\nまでの間に――"},
        { "location": "390/TALK"  , "narrator": "エリカ", "text": "皇長官が、神楽ちゃんに\n決定的な嘘をつく状況を\n作ってほしいの。"},
        { "location": "391/SEL"   , "narrator": "", "text": "え？"},
        { "location": "392/ACT"   , "narrator": "", "text": "え？"},
        { "location": "394/TALK"  , "narrator": "エリカ", "text": "えっとね。"},
        { "location": "400/TALK"  , "narrator": "エリカ", "text": "神楽ちゃんが日本に来て\nすぐに、皇長官と\n契約をしたでしょう？"},
        { "location": "401/TALK"  , "narrator": "エリカ", "text": "その時の条件が、\n嘘をつかずに、聞いたこと\nは教えて欲しい、だった。"},
        { "location": "402/TALK"  , "narrator": "エリカ", "text": "それを呑む前提で、\n神楽ちゃんは、長官と\n契約をしたんだよ。"},
        { "location": "403/TALK"  , "narrator": "エリカ", "text": "だから、嘘をつけば\n契約違反になる。"},
        { "location": "404/TALK"  , "narrator": "エリカ", "text": "そしてその契約違反が\n神楽ちゃんのつばめちゃん\n破壊未遂より前ならば――"},
        { "location": "409/TALK"  , "narrator": "エリカ", "text": "既に不成立になった\n契約のため、\n履行義務はなく。"},
        { "location": "410/TALK"  , "narrator": "エリカ", "text": "神楽ちゃんはその点に\nついて、後に長官に弱みを\n握られることはない。"},
        { "location": "411/TALK"  , "narrator": "エリカ", "text": "もっといえば、\n先に違反をしたのが\n長官になり――"},
        { "location": "412/TALK"  , "narrator": "エリカ", "text": "神楽ちゃんは、\nむしろ優位な立場に\nなれるの。"},
        { "location": "413/SEL"   , "narrator": "", "text": "確かに"},
        { "location": "414/SEL"   , "narrator": "", "text": "でも結局、神楽は母を戻すのに千羽鶴の力が必要なのでは？"},
        { "location": "415/ACT"   , "narrator": "", "text": "確かに"},
        { "location": "418/ACT"   , "narrator": "", "text": "でも結局、神楽は母を戻すのに千羽鶴の力が必要なのでは？"},
        { "location": "419/TALK"  , "narrator": "エリカ", "text": "そうだね。"},
        { "location": "420/TALK"  , "narrator": "エリカ", "text": "でも、それと同じくらい、\n皇長官にとっても、神楽\nちゃんは重要だった。"},
        { "location": "422/TALK"  , "narrator": "エリカ", "text": "だから、彼女に\n歌ってもらえないのは、\n大打撃であって。"},
        { "location": "423/TALK"  , "narrator": "エリカ", "text": "これは\n今の千羽鶴ちゃんの\n弁なんだけど――"},
        { "location": "424/TALK"  , "narrator": "エリカ", "text": "仮に先に、自分が\n嘘をついたことを\n追求されたら。"},
        { "location": "425/TALK"  , "narrator": "エリカ", "text": "かなり不利な状況に\nなることは\nわかっていたんだって。"},
        { "location": "426/TALK"  , "narrator": "エリカ", "text": "千羽鶴ちゃんは、\nそのあたりはとっても\nシビアに考えていて。"},
        { "location": "427/TALK"  , "narrator": "エリカ", "text": "神楽ちゃんのお母さんの\n回復は、正直技術があれば\n誰でもできるけど――"},
        { "location": "428/TALK"  , "narrator": "エリカ", "text": "つばめちゃんを破壊する\nことが出来るのは、彼女の\n歌だけだって解ってた。"},
        { "location": "431/TALK"  , "narrator": "エリカ", "text": "だから、それを絶対\n誰かに悟られないように、\n行動していたんだって。"},
        { "location": "432/TALK"  , "narrator": "エリカ", "text": "そしてそれは、\nあなたに対しても\n同じだったの。"},
        { "location": "433/SEL"   , "narrator": "", "text": "そうだったのか"},
        { "location": "434/SEL"   , "narrator": "", "text": "最後の一言要らないでしょ"},
        { "location": "435/ACT"   , "narrator": "", "text": "そうだったのか"},
        { "location": "436/TALK"  , "narrator": "エリカ", "text": "うん。"},
        { "location": "437/ACT"   , "narrator": "", "text": "最後の一言要らないでしょ"},
        { "location": "438/TALK"  , "narrator": "エリカ", "text": "えっ、でも\n千羽鶴ちゃんから\nちゃんと伝えてって。"},
        { "location": "439/TALK"  , "narrator": "エリカ", "text": "だから、それを\n伝えたまでなんだけど…。"},
        { "location": "440/TALK"  , "narrator": "エリカ", "text": "気分を害してたら\nごめんね？"},
        { "location": "443/TALK"  , "narrator": "エリカ", "text": "で、この計画で\n神楽ちゃんが有利になった\n後のことだけど――"},
        { "location": "444/TALK"  , "narrator": "エリカ", "text": "あなたを通じて、\n神楽ちゃんにわたしたちの\n作戦を伝えて欲しいの。"},
        { "location": "445/TALK"  , "narrator": "エリカ", "text": "で、神楽ちゃんから\n皇長官に、それを呑んで\n欲しいと言ってもらう。"},
        { "location": "446/TALK"  , "narrator": "エリカ", "text": "その内容は――"},
        { "location": "447/TALK"  , "narrator": "エリカ", "text": "簡単に言えば、\nフェノメノンを収束して\n2E113に委ねることだよ。"},
        { "location": "448/SEL"   , "narrator": "", "text": "わかった"},
        { "location": "449/SEL"   , "narrator": "", "text": "そんな簡単に行くかなぁ"},
        { "location": "450/ACT"   , "narrator": "", "text": "わかった"},
        { "location": "451/TALK"  , "narrator": "エリカ", "text": "ありがとう。"},
        { "location": "452/ACT"   , "narrator": "", "text": "そんな簡単に行くかなぁ"},
        { "location": "453/TALK"  , "narrator": "エリカ", "text": "正直、行かないと思う。"},
        { "location": "454/TALK"  , "narrator": "エリカ", "text": "千羽鶴ちゃんも\nそう言ってた。\n多分、何か考えるって。"},
        { "location": "455/TALK"  , "narrator": "エリカ", "text": "そもそも、\nあの頃の彼女は――"},
        { "location": "456/TALK"  , "narrator": "エリカ", "text": "自分の手で\n秩序社会を作ることを\n信念としていたからね。"},
        { "location": "457/TALK"  , "narrator": "エリカ", "text": "けど、決め事については\n絶対に不正はしないという\n信念を持ってるから――"},
        { "location": "458/TALK"  , "narrator": "エリカ", "text": "不履行なら\nそれは受けとめるって。"},
        { "location": "459/TALK"  , "narrator": "エリカ", "text": "そこは多分、自分の\nことだから、９９％は\nそうするって言ってたよ。"},
        { "location": "461/TALK"  , "narrator": "エリカ", "text": "そんなわけなので。"},
        { "location": "462/TALK"  , "narrator": "エリカ", "text": "まずはここ数回のうちに、\n千羽鶴ちゃんに嘘を\nつかせる工作をする。"},
        { "location": "463/SEL"   , "narrator": "", "text": "そうは言っても、嘘をつかせるネタが思いつかないんだけど"},
        { "location": "464/SEL"   , "narrator": "", "text": "いや、その作戦はちょっと嫌だわ、やりたくない"},
        { "location": "465/ACT"   , "narrator": "", "text": "そうは言っても、嘘をつかせるネタが思いつかないんだけど"},
        { "location": "466/TALK"  , "narrator": "エリカ", "text": "それは多分大丈夫。"},
        { "location": "467/TALK"  , "narrator": "エリカ", "text": "エピソードの中に、\nそのチャンスは\n必ずあると思うから。"},
        { "location": "468/ACT"   , "narrator": "", "text": "いや、その作戦はちょっと嫌だわ、やりたくない"},
        { "location": "469/TALK"  , "narrator": "エリカ", "text": "うん。\nもちろんその場合は、\nやらなくてもいいよ。"},
        { "location": "470/TALK"  , "narrator": "エリカ", "text": "あなたの意志を曲げてまで\nやろうとは思わないから。"},
        { "location": "471/TALK"  , "narrator": "エリカ", "text": "その場合は、例え\n嘘をつかせるチャンスが\nわかったとしても――"},
        { "location": "472/TALK"  , "narrator": "エリカ", "text": "そこでは、何もせずに\nスルーして欲しいの。"},
        { "location": "473/TALK"  , "narrator": "エリカ", "text": "どうか、\nよろしくお願いします。"},
        { "location": "475/SEL"   , "narrator": "", "text": "りょうかい"},
        { "location": "476/ACT"   , "narrator": "", "text": "りょうかい"},
        { "location": "478/TALK"  , "narrator": "エリカ", "text": "あ、あと、最後に１つ。\nとっても重要なことを\n伝えておくね。"},
        { "location": "479/TALK"  , "narrator": "エリカ", "text": "今回もパラメトリック\n理論に基づく世界選択法で\n未来を創っていく。"},
        { "location": "480/TALK"  , "narrator": "エリカ", "text": "だから、千羽鶴ちゃんに\n嘘をつかせたか否か。"},
        { "location": "481/TALK"  , "narrator": "エリカ", "text": "その選択はいずれ、\nどちらかに\n収束させねばならない。"},
        { "location": "482/SEL"   , "narrator": "", "text": "だろうね"},
        { "location": "483/SEL"   , "narrator": "", "text": "じゃあ、嘘をつかせるかどうかなんて、選ばせる意味ないじゃん！"},
        { "location": "484/ACT"   , "narrator": "", "text": "だろうね"},
        { "location": "485/ACT"   , "narrator": "", "text": "じゃあ、嘘をつかせるかどうかなんて、選ばせる意味ないじゃん！"},
        { "location": "486/TALK"  , "narrator": "エリカ", "text": "あるよ。"},
        { "location": "487/TALK"  , "narrator": "エリカ", "text": "今の段階では、この作戦が\n良い作戦かどうか、\n正直わからない。"},
        { "location": "488/TALK"  , "narrator": "エリカ", "text": "あくまでわたしと\n千羽鶴ちゃんの2人が\n考えたものだし――"},
        { "location": "489/TALK"  , "narrator": "エリカ", "text": "この世界を操作できるのは\nあくまであなたなの。"},
        { "location": "490/TALK"  , "narrator": "エリカ", "text": "わたしはこんな所にいても\n結局自分では世界の未来に\n関与はできない。"},
        { "location": "491/TALK"  , "narrator": "エリカ", "text": "だから、あなたに\n介入してもらってる。"},
        { "location": "492/TALK"  , "narrator": "エリカ", "text": "けど、あなたに\nあなたの意志に反した事を\nしてもらいたくない。"},
        { "location": "493/TALK"  , "narrator": "エリカ", "text": "あなたは、\n綾ちゃんたちを大事に\nしてくれているし――"},
        { "location": "494/TALK"  , "narrator": "エリカ", "text": "その綾ちゃんたちが\n不幸になるようなことは\nしないだろうから。"},
        { "location": "495/TALK"  , "narrator": "エリカ", "text": "けど、現実はといえば、\n不幸になるか否かは結果が\n出るまでわからない。"},
        { "location": "496/TALK"  , "narrator": "エリカ", "text": "そんな中で、\nあなたがとれる行動は\nただ２つ。"},
        { "location": "497/TALK"  , "narrator": "エリカ", "text": "自分で世界にかかわれる\n力を持っているのだから、\nそれを最大限行使するか。"},
        { "location": "498/TALK"  , "narrator": "エリカ", "text": "もしくは――"},
        { "location": "499/TALK"  , "narrator": "エリカ", "text": "何らかの形で\n他人に信託するか。"},
        { "location": "500/TALK"  , "narrator": "エリカ", "text": "ここでいう他人とは、\nわたしや千羽鶴ちゃん、"},
        { "location": "501/TALK"  , "narrator": "エリカ", "text": "もしくは、総意を形成する\n他の世界線の接続者を\n指すよ。"},
        { "location": "502/TALK"  , "narrator": "エリカ", "text": "もっとも、後者の場合だと\nこのOSを起動しない以外\n方法がないんだけど……。"},
        { "location": "503/TALK"  , "narrator": "エリカ", "text": "棄権もできるように\nしておけばよかったかな。\nごめんね？"},
        { "location": "505/TALK"  , "narrator": "エリカ", "text": "いずれにせよ、\nあなたの総意が\nリプレイスを望めば。"},
        { "location": "506/TALK"  , "narrator": "エリカ", "text": "わたしはその未来に\n従って次を考える。"},
        { "location": "507/TALK"  , "narrator": "エリカ", "text": "逆に、\n総意がリプレイスを\n拒否するならば、"},
        { "location": "508/TALK"  , "narrator": "エリカ", "text": "やはりその結果に従って\nその先を考えるだけなの。"},
        { "location": "509/TALK"  , "narrator": "エリカ", "text": "だからこそ、実際に\n神楽ちゃんたちの状況を\n見て判断して欲しいの。"},
        { "location": "510/TALK"  , "narrator": "エリカ", "text": "その理由は簡単で――"},
        { "location": "511/TALK"  , "narrator": "エリカ", "text": "わたしの説明だけで\n判断するより、自分で見て\n判断した方がいいから。"},
        { "location": "512/TALK"  , "narrator": "エリカ", "text": "自分で事実を見て、\nその瞬間に立ち会って\n自分で決める。"},
        { "location": "513/TALK"  , "narrator": "エリカ", "text": "これができるのって、\nすごく価値のあることだと\nわたしは思うの。"},
        { "location": "514/TALK"  , "narrator": "エリカ", "text": "普段、人づてに聞いている\nうわさ話や報道が、\n如何に偏ったものか。"},
        { "location": "515/TALK"  , "narrator": "エリカ", "text": "それを体感できるかも\nしれないしね。"},
        { "location": "516/TALK"  , "narrator": "エリカ", "text": "…と。\nわたしからは\nそんな感じかな。"},
        { "location": "518/TALK"  , "narrator": "エリカ", "text": "今回もまた\nお話が長くなっちゃって\nごめんね？"},
        { "location": "519/TALK"  , "narrator": "エリカ", "text": "ここからが本当に、\nあなたの力が必要な\n時になります。"},
        { "location": "520/TALK"  , "narrator": "エリカ", "text": "どうか、わたしたちに\n力を貸して下さいね。"},
        { "location": "521/TALK"  , "narrator": "エリカ", "text": "それじゃまた後で、\nココロスフィアで\n逢おうね！"},
        { "location": "241/DIALOG", "narrator": "Event/Dialog_EventPicTallNW", "text": "2E113について。"},
