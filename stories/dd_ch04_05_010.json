{
    "dir": "chap05/daydra/dd_ch04_05_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "5452",
        "cid": "miyabi",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "新しい帯"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "新しい帯"},
        { "location": "19/TALK"   , "narrator": "みやび", "text": "アーヤ。すまんが\n今日は、帰りが\nちっくと遅くなるき。"},
        { "location": "22/TALK"   , "narrator": "アーヤ", "text": "あら、何か用事？"},
        { "location": "23/TALK"   , "narrator": "みやび", "text": "うむ、実は先日\n注文した新しい帯が、\n店のほうに届いたんよ。"},
        { "location": "24/TALK"   , "narrator": "みやび", "text": "本当は週末に\n受け取りに行く予定\nやったけんど――"},
        { "location": "25/TALK"   , "narrator": "みやび", "text": "早く見たくて堪らんき、\n帰りに行って来るちや。"},
        { "location": "26/TALK"   , "narrator": "アーヤ", "text": "ふふっ、なるほどね。\nわかったわ。"},
        { "location": "28/TALK"   , "narrator": "みやび", "text": "すまんな。"},
        { "location": "30/TALK"   , "narrator": "アーヤ", "text": "でも、帯ってことは\n和服専門の店よね？"},
        { "location": "31/TALK"   , "narrator": "アーヤ", "text": "そういうお店に行ったの\n成人式の振袖を選びに\n行ったのが最後かも。"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "まあ、普通のヤツは\n滅多に行かない\n店やしな。"},
        { "location": "34/TALK"   , "narrator": "アーヤ", "text": "そうね。でも、\n綺麗な着物が沢山\nあって素敵だったわ。"},
        { "location": "36/TALK"   , "narrator": "みやび", "text": "…なんや、興味がある\nような言い方やな。"},
        { "location": "37/SEL"    , "narrator": "", "text": "誘ってあげよう"},
        { "location": "38/SEL"    , "narrator": "", "text": "誘うのはやめよう"},
        { "location": "39/SEL"    , "narrator": "", "text": "着物を見繕ってあげよう"},
        { "location": "42/TALK"   , "narrator": "みやび", "text": "ついでやし、一緒に\n行くんも楽しいかも\nしれんな。"},
        { "location": "43/TALK"   , "narrator": "みやび", "text": "アーヤがどんな着物を\n着たがるかも、ちっくと\n気にはなるし…。"},
        { "location": "47/TALK"   , "narrator": "みやび", "text": "興味あるんやったら、\n一緒に来てもえいよ。"},
        { "location": "48/TALK"   , "narrator": "アーヤ", "text": "えっ、いいの？"},
        { "location": "49/TALK"   , "narrator": "みやび", "text": "構わんよ。\nうちもせっかくやき、\n店で試着もしたいき――"},
        { "location": "50/TALK"   , "narrator": "みやび", "text": "アーヤがいれば、\n似合うかどうか\n聞けるやろうしな。"},
        { "location": "51/TALK"   , "narrator": "アーヤ", "text": "喜んでお供するわ。"},
        { "location": "53/TALK"   , "narrator": "アーヤ", "text": "ふふっ、綺麗な着物が\n沢山見れそうで、\n今から凄く楽しみ。"},
        { "location": "54/TALK"   , "narrator": "みやび", "text": "…こういう素直に喜ぶ\nところが、アーヤの\n可愛らしいところやね。"},
        { "location": "56/ACT"    , "narrator": "", "text": "誘ってあげよう"},
        { "location": "76/TALK"   , "narrator": "みやび", "text": "うちもそう思うてた"},
        { "location": "77/TALK"   , "narrator": "みやび", "text": "気が合うな、相棒！"},
        { "location": "78/TALK"   , "narrator": "みやび", "text": "シンクロ率上昇記念日や"},
        { "location": "91/TALK"   , "narrator": "みやび", "text": "興味あるんやったら、\n一緒に来てもえいよ。"},
        { "location": "92/TALK"   , "narrator": "アーヤ", "text": "えっ、いいの？"},
        { "location": "94/TALK"   , "narrator": "みやび", "text": "構わんよ。\nうちもせっかくやき、\n店で試着もしたいき――"},
        { "location": "95/TALK"   , "narrator": "みやび", "text": "アーヤがいれば、\n似合うかどうか聞ける\nやろうしな。"},
        { "location": "97/TALK"   , "narrator": "アーヤ", "text": "喜んでお供するわ。"},
        { "location": "98/TALK"   , "narrator": "アーヤ", "text": "ふふっ、綺麗な着物が\n沢山見れそうで、\n今から凄く楽しみ。"},
        { "location": "99/TALK"   , "narrator": "みやび", "text": "…こういう素直に喜ぶ\nところが、アーヤの\n可愛らしいところやね。"},
        { "location": "116/ACT"   , "narrator": "", "text": "誘うのはやめよう"},
        { "location": "135/TALK"  , "narrator": "みやび", "text": "意外やね"},
        { "location": "136/TALK"  , "narrator": "みやび", "text": "あんたなら、誘ってあげろ言うんかと思ったんやが"},
        { "location": "137/TALK"  , "narrator": "みやび", "text": "まあ、帯を受け取りにいくだけやき"},
        { "location": "138/TALK"  , "narrator": "みやび", "text": "長いせんよう、一人で行くべきやな"},
        { "location": "151/TALK"  , "narrator": "みやび", "text": "まあ、そういうこと\nやき。とりあえず\n伝えよう思うたんよ。"},
        { "location": "152/TALK"  , "narrator": "アーヤ", "text": "そっか…。"},
        { "location": "153/TALK"  , "narrator": "アーヤ", "text": "わかったわ。\nみんなには私から\n伝えておくから――"},
        { "location": "154/TALK"  , "narrator": "アーヤ", "text": "みやびは新しい帯を\n取りにいってきて。"},
        { "location": "155/TALK"  , "narrator": "みやび", "text": "すまんな。"},
        { "location": "157/TALK"  , "narrator": "アーヤ", "text": "これくらい構わないわ。\n帰ったら、どんな\n帯なのか見せてね。"},
        { "location": "162/TALK"  , "narrator": "みやび", "text": "…やっぱりついて\nくるか、聞くべき\nやったかもしれんなぁ。"},
        { "location": "164/TALK"  , "narrator": "みやび", "text": "今更後悔しても\n遅いけんど…。"},
        { "location": "165/ACT"   , "narrator": "", "text": "着物を見繕ってあげよう"},
        { "location": "193/TALK"  , "narrator": "みやび", "text": "さすがは相棒や"},
        { "location": "194/TALK"  , "narrator": "みやび", "text": "うちじゃそんな面白いこと、絶対思いつかん"},
        { "location": "195/TALK"  , "narrator": "みやび", "text": "さっそく言ってみるき"},
        { "location": "208/TALK"  , "narrator": "みやび", "text": "アーヤ、うちと一緒に\n着物を見に行かんか？"},
        { "location": "209/TALK"  , "narrator": "アーヤ", "text": "えっ、いいの？"},
        { "location": "210/TALK"  , "narrator": "みやび", "text": "構わんよ。"},
        { "location": "212/TALK"  , "narrator": "みやび", "text": "というか、アーヤに\n似合いそうな着物を――"},
        { "location": "213/TALK"  , "narrator": "みやび", "text": "一着見繕ってやりたいと\n思うてなぁ。"},
        { "location": "215/TALK"  , "narrator": "アーヤ", "text": "それ、凄く嬉しいわ！\nちゃんとした着物を\n一着欲しかったの！"},
        { "location": "216/TALK"  , "narrator": "みやび", "text": "なら、アーヤにお薦め\nしたいのがあるんよ。"},
        { "location": "217/TALK"  , "narrator": "みやび", "text": "藍色にピンクと白の\n模様が入った柄の\n生地があってな。"},
        { "location": "218/TALK"  , "narrator": "アーヤ", "text": "へぇ、涼しげな感じね。"},
        { "location": "219/TALK"  , "narrator": "みやび", "text": "帯含めて三百万ほど\nやけんど、値段相応の\nえいものやったよ。"},
        { "location": "221/TALK"  , "narrator": "アーヤ", "text": "…え？"},
        { "location": "222/TALK"  , "narrator": "アーヤ", "text": "ちょ、ちょっと待って！\n今、三百って…。"},
        { "location": "223/TALK"  , "narrator": "みやび", "text": "三百万や。"},
        { "location": "225/TALK"  , "narrator": "アーヤ", "text": "新車のバイクが\n買えちゃうじゃない！"},
        { "location": "226/TALK"  , "narrator": "みやび", "text": "アーヤ、着物は大事に\n着れば一生もんやき。\n高いのは当然ながよ。"},
        { "location": "229/TALK"  , "narrator": "アーヤ", "text": "や、やっぱり遠慮する！\nそれじゃ、講義が\nあるから私はこれで！"},
        { "location": "232/TALK"  , "narrator": "みやび", "text": "あっ…逃げよった。"},
        { "location": "235/TALK"  , "narrator": "みやび", "text": "…最初はもっと\nリーズナブルなものを\n薦めるべきやったか…。"},
        { "location": "16/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>5月10日　3:50 PM</color>\nとある平日の放課後、\n学園前の通学路にて。"},
        { "location": "110/DIALOG", "narrator": "Dialog_GEThimegoto_ch04", "text": "【そこな越後屋】"},
        { "location": "171/DIALOG", "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"}
    ]
}
