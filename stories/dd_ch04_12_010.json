{
    "dir": "chap12/daydra/dd_ch04_12_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "12452",
        "cid": "miyabi",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "迷惑メール"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "迷惑メール"},
        { "location": "21/TALK"   , "narrator": "雛", "text": "う～ん……。"},
        { "location": "23/TALK"   , "narrator": "つばめ", "text": "ひなこちゃん、\nどうかしたの？"},
        { "location": "26/TALK"   , "narrator": "雛", "text": "…これ、見て。\nさっきあたしに届いた\nメールなんだけど。"},
        { "location": "27/TALK"   , "narrator": "つばめ", "text": "えっと…あなたの口座に\n３００万円を振り込み\nたいので――"},
        { "location": "28/TALK"   , "narrator": "つばめ", "text": "どうかこのメールに\n銀行口座を書いて\n返信してください…。"},
        { "location": "31/TALK"   , "narrator": "みやび", "text": "よくある迷惑メールやな。\nテンプレ過ぎて、誰も\n引っかからんやろうね。"},
        { "location": "35/TALK"   , "narrator": "キリト", "text": "さっさとそんなメール\n削除しちまえよ。"},
        { "location": "38/TALK"   , "narrator": "雛", "text": "…………。"},
        { "location": "41/TALK"   , "narrator": "雛", "text": "これ、返信したら\nどうなるのかな？"},
        { "location": "43/TALK"   , "narrator": "キリト", "text": "何言ってんだよ！\nロクなことにならねぇの\n目に見えてんじゃねぇか。"},
        { "location": "45/TALK"   , "narrator": "つばめ", "text": "ダメだよひなこちゃん！\nこういうメールは無視\nしないと危ないよ！"},
        { "location": "47/TALK"   , "narrator": "雛", "text": "わかってるよー。\n本当にやったりは\nしないって。"},
        { "location": "48/TALK"   , "narrator": "雛", "text": "でも、実際に返信したら\nどうなっちゃうのか――"},
        { "location": "49/TALK"   , "narrator": "雛", "text": "それが気になった\nだけだよ。"},
        { "location": "51/TALK"   , "narrator": "キリト", "text": "…そういや、碌なことに\nならねぇ、っていうのは\n知ってるけど――"},
        { "location": "52/TALK"   , "narrator": "キリト", "text": "具体的にどうなるのかは\n知らねぇな。"},
        { "location": "54/TALK"   , "narrator": "つばめ", "text": "個人情報が抜かれるとか\n聞いたことあるけど…。"},
        { "location": "56/TALK"   , "narrator": "雛", "text": "メールに返信する\nくらいで、そんなに\nわかっちゃうのかな？"},
        { "location": "58/TALK"   , "narrator": "キリト", "text": "確かに…じゃあ、返信する\nくらいだったら問題ない、\nってことか？"},
        { "location": "61/TALK"   , "narrator": "みやび", "text": "…この子達、まさか\n本気で返信しようとか\n考えんよな？"},
        { "location": "62/SEL"    , "narrator": "", "text": "止めてあげて！"},
        { "location": "63/SEL"    , "narrator": "", "text": "アーヤを呼ぼう"},
        { "location": "64/SEL"    , "narrator": "", "text": "送信者を割り出そう"},
        { "location": "66/TALK"   , "narrator": "みやび", "text": "まあ、興味だけで\n実際にするとは思わん\nけんど――"},
        { "location": "67/TALK"   , "narrator": "みやび", "text": "もしかしたら、\nちゅうこともあるき――"},
        { "location": "69/TALK"   , "narrator": "みやび", "text": "一応、注意した方が\nえいかもしれんね。"},
        { "location": "73/TALK"   , "narrator": "みやび", "text": "…一応言っておくけんど。"},
        { "location": "74/TALK"   , "narrator": "みやび", "text": "仮にそのメールを\n返信しても、それだけじゃ\n多分何も起こらんよ。"},
        { "location": "75/TALK"   , "narrator": "雛", "text": "えっ、そうなんですか？"},
        { "location": "76/TALK"   , "narrator": "みやび", "text": "モノにもよるけんど、\n多分、返信するだけなら\n平気やと思う。"},
        { "location": "77/TALK"   , "narrator": "みやび", "text": "けんど、一度返信したら\n脈ありと思われて――"},
        { "location": "78/TALK"   , "narrator": "みやび", "text": "今以上に大量のメールが\n送られてくることに\nなるちや。"},
        { "location": "79/TALK"   , "narrator": "キリト", "text": "うわっ、\nそれウゼェかも…。"},
        { "location": "81/TALK"   , "narrator": "みやび", "text": "やき、そういうんは\nすっと削除した方が\nえいんよ。"},
        { "location": "83/TALK"   , "narrator": "雛", "text": "なるほど…そんなことに\nなっちゃうんですね。"},
        { "location": "85/TALK"   , "narrator": "雛", "text": "勉強になりました！\nじゃあ、これはさっさと\n削除しちゃいますね。"},
        { "location": "87/TALK"   , "narrator": "みやび", "text": "うん、えい子やね。"},
        { "location": "89/TALK"   , "narrator": "みやび", "text": "見知らぬメールは即削除。\n忘れたらいかんよ。"},
        { "location": "91/ACT"    , "narrator": "", "text": "止めてあげて！"},
        { "location": "111/TALK"  , "narrator": "みやび", "text": "…まあ、ここで忠告せんと、後でうちの良心が痛むことになりかねんきな"},
        { "location": "112/TALK"  , "narrator": "みやび", "text": "知っちゅう？　うちにもちゃんと良心はあるんよ"},
        { "location": "113/TALK"  , "narrator": "みやび", "text": "海のようにとまでは言わんが、琵琶湖くらいの大きさのがな"},
        { "location": "127/TALK"  , "narrator": "みやび", "text": "…まさかとは思うけんど、\n一応言っておくき。"},
        { "location": "128/TALK"  , "narrator": "みやび", "text": "仮にそのメールを\n返信しても、それだけじゃ\n多分何も起こらんよ。"},
        { "location": "129/TALK"  , "narrator": "雛", "text": "えっ、そうなんですか？"},
        { "location": "130/TALK"  , "narrator": "みやび", "text": "モノにもよるけんど、\n多分、返信するだけなら\n平気やと思う。"},
        { "location": "131/TALK"  , "narrator": "みやび", "text": "けんど、一度返信したら\n脈ありと思われて――"},
        { "location": "133/TALK"  , "narrator": "みやび", "text": "今以上に大量のスパムが\n送られてくることに\nなるちや。"},
        { "location": "134/TALK"  , "narrator": "キリト", "text": "うわっ、\nそれウゼェかも…。"},
        { "location": "135/TALK"  , "narrator": "みやび", "text": "やき、そういうんは\nすっと削除した方が\nえいんよ。"},
        { "location": "137/TALK"  , "narrator": "雛", "text": "なるほど…そんなことに\nなっちゃうんですね。"},
        { "location": "139/TALK"  , "narrator": "雛", "text": "勉強になりました！\nじゃあ、これはさっさと\n削除しちゃいますね。"},
        { "location": "140/TALK"  , "narrator": "みやび", "text": "うん、えい子やね。"},
        { "location": "142/TALK"  , "narrator": "みやび", "text": "見知らぬメールは即削除。\n忘れたらいかんよ。"},
        { "location": "143/ACT"   , "narrator": "", "text": "アーヤを呼ぼう"},
        { "location": "164/TALK"  , "narrator": "みやび", "text": "そこまでする必要ないと思うけんど"},
        { "location": "165/TALK"  , "narrator": "みやび", "text": "まあ、不安の種は潰しておくんがえいな"},
        { "location": "166/TALK"  , "narrator": "みやび", "text": "ちっくとメールして呼び出すき"},
        { "location": "194/TALK"  , "narrator": "みやび", "text": "…と、いうわけで\nアーヤを呼んだんよ。"},
        { "location": "196/TALK"  , "narrator": "アーヤ", "text": "はぁ…なるほどね。\n大体理解したわ。"},
        { "location": "197/TALK"  , "narrator": "雛", "text": "あ、あのぉ…\n本当に返信しようなんて\n思ってないですよ？"},
        { "location": "198/TALK"  , "narrator": "みやび", "text": "わかっちゅうけんど、\nその手の話で盛り上がられ\nると――"},
        { "location": "199/TALK"  , "narrator": "みやび", "text": "どうにも不安になるちや。"},
        { "location": "200/TALK"  , "narrator": "みやび", "text": "やき、迷惑メールには\n返信したらダメだぜ！！"},
        { "location": "203/TALK"  , "narrator": "みやび", "text": "って、ちっくと注意を\n促してくれんがか？"},
        { "location": "207/TALK"  , "narrator": "アーヤ", "text": "だぜって何よ？\nまったく…。"},
        { "location": "208/TALK"  , "narrator": "雛", "text": "綾水様、すみません。\nあたし達が変な冗談を\n言ってたせいで…。"},
        { "location": "211/TALK"  , "narrator": "アーヤ", "text": "気にしてないわ。\nっていうか、みやびが\n大げさなだけよ。"},
        { "location": "212/TALK"  , "narrator": "アーヤ", "text": "けど、本当に冗談だけで\nすませないとダメよ？"},
        { "location": "214/TALK"  , "narrator": "雛", "text": "はい、わかってます。"},
        { "location": "216/TALK"  , "narrator": "アーヤ", "text": "うん…これでいい？"},
        { "location": "218/TALK"  , "narrator": "みやび", "text": "…歯磨きを促す特撮\nヒーローっぽくは\n言うてくれんがか？"},
        { "location": "221/TALK"  , "narrator": "アーヤ", "text": "…あなたから来た呼び出し\nメール、迷惑フォルダに\n入れておくわ。"},
        { "location": "222/ACT"   , "narrator": "", "text": "送信者を割り出そう"},
        { "location": "242/TALK"  , "narrator": "みやび", "text": "…なるほど"},
        { "location": "243/TALK"  , "narrator": "みやび", "text": "ちっくとＰＣに詳しい人間なら出来ることを"},
        { "location": "244/TALK"  , "narrator": "みやび", "text": "実際に見せてやれゆうことやね？"},
        { "location": "245/TALK"  , "narrator": "みやび", "text": "言葉にするより効果ありそうや、採用ぞね！"},
        { "location": "256/TALK"  , "narrator": "みやび", "text": "さてと、ひなこちゃんに\n届いたアドレスは…。"},
        { "location": "258/TALK"  , "narrator": "雛", "text": "でも、こんなメールを\n送ってきてるけど――"},
        { "location": "259/TALK"  , "narrator": "雛", "text": "本当にそんなお金を\n持ってる人なのかな？"},
        { "location": "261/TALK"  , "narrator": "つばめ", "text": "持ってたとしても、\n本当にくれたりしない人\nじゃないかな？"},
        { "location": "262/TALK"  , "narrator": "キリト", "text": "はは、そりゃそうだ。"},
        { "location": "264/TALK"  , "narrator": "みやび", "text": "多分持ってないとは\n思うけんど、一応…。"},
        { "location": "266/TALK"  , "narrator": "みやび", "text": "…あ～、こいつやね。"},
        { "location": "267/TALK"  , "narrator": "キリト", "text": "どうかしたんすか？"},
        { "location": "268/TALK"  , "narrator": "みやび", "text": "雛ちゃんにメールを\n送ってきたヤツや。"},
        { "location": "269/TALK"  , "narrator": "みやび", "text": "メルアドから個人情報\nすっぱ抜いたんよ。"},
        { "location": "270/TALK"  , "narrator": "雛", "text": "…はい？\nえっと、ちょっと待って\nくださいね。"},
        { "location": "271/TALK"  , "narrator": "雛", "text": "メルアドだけで、本当に\n個人情報とかわかっちゃ\nうんですか？"},
        { "location": "272/TALK"  , "narrator": "みやび", "text": "程度にもよるけんど、\nこれくらいなら比較的\n簡単ちや。"},
        { "location": "273/TALK"  , "narrator": "みやび", "text": "ちっくと時間かければ、\nこいつのメールアカウント\n乗っ取るんも――"},
        { "location": "275/TALK"  , "narrator": "みやび", "text": "出来なくはないぞね。"},
        { "location": "276/TALK"  , "narrator": "雛", "text": "…………。"},
        { "location": "277/TALK"  , "narrator": "つばめ", "text": "メルアド、変えようかな？\nもっとわかり難いのに\nしたくなってきたよ…。"},
        { "location": "278/TALK"  , "narrator": "キリト", "text": "俺も…長くて難しいのに\n変えようかな？"},
        { "location": "279/TALK"  , "narrator": "みやび", "text": "変えたところで来る時は\n来るき、あんまし意味は\nないけんどね。"},
        { "location": "280/TALK"  , "narrator": "みやび", "text": "まあ、メルアドだけでも\nやろうと思えばこれくらい\n出来なくはないちや。"},
        { "location": "281/TALK"  , "narrator": "みやび", "text": "やき、冗談でも返信しよう\nなんて思わんようになって\nくれたら――"},
        { "location": "282/TALK"  , "narrator": "みやび", "text": "うちはそれで安心ちや。"},
        { "location": "283/TALK"  , "narrator": "雛", "text": "みやび先輩みたいな人が\n本当にいるんだな、って\nわかったら――"},
        { "location": "284/TALK"  , "narrator": "雛", "text": "冗談でも、もう二度と\n思えませんよ…。"},
        { "location": "20/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>7月4日　12:08 PM</color>\nとある平日の昼休み、学園教室にて。"}
    ]
}
