{
    "dir": "chap33/daydra/dd_ch03_33_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "33305",
        "cid": "gabriella",
        "title": "005 メインストーリー",
        "sub_title": "背中越しの真実＜後編＞"
    },
    "entry":
    [
        { "location": "832/SCENARIO", "narrator": "", "text": "背中越しの真実"},
        { "location": "855/TALK"    , "narrator": "ガブリエラ", "text": "アーヤからまだ\n連絡はない。"},
        { "location": "856/TALK"    , "narrator": "ガブリエラ", "text": "もう少し時間は\nある感じね…。"},
        { "location": "862/TALK"    , "narrator": "ガブリエラ", "text": "ねえ$marzanna$"},
        { "location": "863/TALK"    , "narrator": "ガブリエラ", "text": "言い忘れてたことがあるわ"},
        { "location": "864/TALK"    , "narrator": "ガブリエラ", "text": "私、あなたになら背中を預けられる"},
        { "location": "865/TALK"    , "narrator": "ガブリエラ", "text": "戦場で目を閉じろと言われても"},
        { "location": "866/TALK"    , "narrator": "ガブリエラ", "text": "疑わず目を閉じるわ"},
        { "location": "870/TALK"    , "narrator": "ガブリエラ", "text": "私ずっと"},
        { "location": "871/TALK"    , "narrator": "ガブリエラ", "text": "お姫様に憧れていたわ"},
        { "location": "872/TALK"    , "narrator": "ガブリエラ", "text": "いつも幸せで"},
        { "location": "873/TALK"    , "narrator": "ガブリエラ", "text": "かわいいものだけに囲まれて"},
        { "location": "874/TALK"    , "narrator": "ガブリエラ", "text": "辛いことも痛いことも全然知らない無垢なお姫様に"},
        { "location": "875/TALK"    , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "876/TALK"    , "narrator": "ガブリエラ", "text": "現実の私は戦士よ"},
        { "location": "877/TALK"    , "narrator": "ガブリエラ", "text": "お姫様なんかじゃない"},
        { "location": "878/TALK"    , "narrator": "ガブリエラ", "text": "そしてそれが"},
        { "location": "879/TALK"    , "narrator": "ガブリエラ", "text": "今はとてもうれしいの"},
        { "location": "880/TALK"    , "narrator": "ガブリエラ", "text": "自分自身で戦えるってことが"},
        { "location": "881/TALK"    , "narrator": "ガブリエラ", "text": "これから戦うわ"},
        { "location": "882/TALK"    , "narrator": "ガブリエラ", "text": "世界と、何より自分自身のために"},
        { "location": "884/SEL"     , "narrator": "", "text": "ご武運を"},
        { "location": "885/SEL"     , "narrator": "", "text": "ガブリエラはいつだって$me$の姫だよ"},
        { "location": "886/SEL"     , "narrator": "", "text": "$me$はガブリエラの王子だよ"},
        { "location": "887/ACT"     , "narrator": "", "text": "ご武運を"},
        { "location": "889/TALK"    , "narrator": "ガブリエラ", "text": "祈ってくれるのね"},
        { "location": "891/TALK"    , "narrator": "ガブリエラ", "text": "ありがとう"},
        { "location": "892/TALK"    , "narrator": "ガブリエラ", "text": "生きて戻れたら"},
        { "location": "893/TALK"    , "narrator": "ガブリエラ", "text": "戦果について報告するわ"},
        { "location": "894/TALK"    , "narrator": "ガブリエラ", "text": "待ってて"},
        { "location": "895/ACT"     , "narrator": "", "text": "ガブリエラはいつだって$me$の姫だよ"},
        { "location": "897/TALK"    , "narrator": "ガブリエラ", "text": "使用人のふりをしてくれるのね"},
        { "location": "899/TALK"    , "narrator": "ガブリエラ", "text": "ありがとう"},
        { "location": "900/TALK"    , "narrator": "ガブリエラ", "text": "とても頼りになる"},
        { "location": "901/TALK"    , "narrator": "ガブリエラ", "text": "素敵なあなた"},
        { "location": "902/ACT"     , "narrator": "", "text": "$me$はガブリエラの王子だよ"},
        { "location": "904/TALK"    , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "906/TALK"    , "narrator": "ガブリエラ", "text": "あなたはいつも優しくて"},
        { "location": "907/TALK"    , "narrator": "ガブリエラ", "text": "気持ちがキラキラ輝いてた"},
        { "location": "908/TALK"    , "narrator": "ガブリエラ", "text": "だから私"},
        { "location": "909/TALK"    , "narrator": "ガブリエラ", "text": "あなたと話す時は"},
        { "location": "910/TALK"    , "narrator": "ガブリエラ", "text": "お姫様になれたわ"},
        { "location": "916/TALK"    , "narrator": "透明アーヤ", "text": "ギャヴィ、みやび。\n館長から準備完了の\n連絡があったわ。"},
        { "location": "917/TALK"    , "narrator": "透明アーヤ", "text": "サイネージに館長が\n映し出されたら\n救出開始よ。"},
        { "location": "918/TALK"    , "narrator": "ガブリエラ", "text": "ふうん。\nまほもやる時はやるわね。"},
        { "location": "919/TALK"    , "narrator": "透明みやび", "text": "いっつもそうやったら\n肩が凝って\n仕方ないろう。"},
        { "location": "920/TALK"    , "narrator": "透明アーヤ", "text": "……スタンバイ。\n各人、構えよ。"},
        { "location": "921/TALK"    , "narrator": "透明みやび", "text": "発煙手榴弾の\n安全ロック解除。"},
        { "location": "922/TALK"    , "narrator": "透明みやび", "text": "いつでも行けるき。"},
        { "location": "923/TALK"    , "narrator": "ガブリエラ", "text": "望むところよ。"},
        { "location": "924/TALK"    , "narrator": "透明アーヤ", "text": "…お願い。"},
        { "location": "925/TALK"    , "narrator": "透明みやび", "text": "オッケー。\n…発破！"},
        { "location": "932/TALK"    , "narrator": "ガブリエラ", "text": "……勝ってみせる。\n絶対に！"},
        { "location": "943/DIALOG"  , "narrator": "Dialog_chapter_ch03", "text": "【27 シン・カグラ】"}
    ]
}
