{
    "dir": "chap17/daydra/dd_ch02_17_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "17205",
        "cid": "ayami",
        "title": "005 メインストーリー",
        "sub_title": "局所的先輩会議＜後編＞"
    },
    "entry":
    [
        { "location": "541/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "542/TALK"  , "narrator": "みやび", "text": "でな、\n話を続けるけんど――"},
        { "location": "543/TALK"  , "narrator": "アーヤ", "text": "待って…その前に、\n言っておくことがあるの。"},
        { "location": "544/TALK"  , "narrator": "アーヤ", "text": "この話だけど…、\n私を信頼して話してくれた\nことは、とっても嬉しい。"},
        { "location": "547/TALK"  , "narrator": "アーヤ", "text": "でも…ごめんなさい。\n正直、スケールが\n大き過ぎる話だわ。"},
        { "location": "548/TALK"  , "narrator": "アーヤ", "text": "だから…このまま聞いても\n解決できる自信ないの。"},
        { "location": "550/TALK"  , "narrator": "アーヤ", "text": "それでも…話の続き、\n聞かせてもらえる？"},
        { "location": "551/TALK"  , "narrator": "みやび", "text": "もちろんや。"},
        { "location": "552/TALK"  , "narrator": "みやび", "text": "うちも、解決してもらえる\n思うて話したわけやない。"},
        { "location": "553/TALK"  , "narrator": "みやび", "text": "ただ、情報を共有して\nおきたかっただけやき。"},
        { "location": "554/TALK"  , "narrator": "アーヤ", "text": "そう…。"},
        { "location": "555/TALK"  , "narrator": "みやび", "text": "…話、続けるがよ。"},
        { "location": "556/TALK"  , "narrator": "みやび", "text": "仮に…、まっこと\nフェノメノンが人為的に\n起こされていたとする。"},
        { "location": "557/TALK"  , "narrator": "みやび", "text": "そうなると、\nうちらにとっては\n大問題ぞね。"},
        { "location": "558/TALK"  , "narrator": "みやび", "text": "敵は明らかに、うちらに\n狙いを定めてるっちゅう\nことになるきね。"},
        { "location": "559/TALK"  , "narrator": "アーヤ", "text": "えっ、どうして？"},
        { "location": "560/TALK"  , "narrator": "みやび", "text": "この前のフェノメノンが\n出現した場所や。"},
        { "location": "561/TALK"  , "narrator": "アーヤ", "text": "…？"},
        { "location": "562/TALK"  , "narrator": "みやび", "text": "…そうやったな。\nつばめちゃん以外には\n教えてなかったんやった。"},
        { "location": "563/TALK"  , "narrator": "みやび", "text": "実は、あの時…、\n卯月の家がフェノメノンに\n巻き込まれちょったがよ。"},
        { "location": "565/TALK"  , "narrator": "アーヤ", "text": "え…、えぇっ！？"},
        { "location": "567/TALK"  , "narrator": "みやび", "text": "すまん…プライベートに\n関わる情報やったき、\n言えんかったがよ…。"},
        { "location": "569/TALK"  , "narrator": "アーヤ", "text": "じゃ、じゃあ…あの時に\n卯月の様子が\nおかしかったのって…。"},
        { "location": "572/TALK"  , "narrator": "みやび", "text": "家族が巻き込まれちゅう\n状況で、冷静でいられる\nはずないちや。"},
        { "location": "574/TALK"  , "narrator": "アーヤ", "text": "そ、そんな…。"},
        { "location": "576/TALK"  , "narrator": "アーヤ", "text": "私…とんでもないこと\nしちゃった…。"},
        { "location": "578/TALK"  , "narrator": "アーヤ", "text": "知らなかったからって、\n卯月に、あんなに強く\n酷いことを…。"},
        { "location": "580/TALK"  , "narrator": "みやび", "text": "しっかし、どうにも\nわからん…。"},
        { "location": "581/TALK"  , "narrator": "みやび", "text": "フェノメノンは、人の心の\n一部がこの世界に顕在し、\n世界を作るものや。"},
        { "location": "582/TALK"  , "narrator": "みやび", "text": "けんど、その際にもの凄い\nエネルギーがかかるんよ。"},
        { "location": "583/TALK"  , "narrator": "アーヤ", "text": "…家族が巻き込まれて、\nそれで必死になって、\nあんな行動に出たんだわ。"},
        { "location": "584/TALK"  , "narrator": "みやび", "text": "人の魂の重さは無限。\nそんな言葉聞いたこと\nあるやろ？"},
        { "location": "585/TALK"  , "narrator": "みやび", "text": "実際それが本当なのかは、\nうちにもわからん。"},
        { "location": "586/TALK"  , "narrator": "みやび", "text": "まあ、無限っちゅうのは\n言い過ぎやろうけんど、\nかなり大きいやろうね。"},
        { "location": "587/TALK"  , "narrator": "みやび", "text": "…とはいえ、フェノメノン\n生み出せるほどではないと\n思うけんど。"},
        { "location": "588/TALK"  , "narrator": "みやび", "text": "半径数百メートル内の\n世界を全て改ざんとか、\n常軌を逸し過ぎや。"},
        { "location": "590/TALK"  , "narrator": "アーヤ", "text": "しかも、メノウのことまで\nバレてもっとショックを\n受けてた卯月に…。"},
        { "location": "591/TALK"  , "narrator": "みやび", "text": "けんど、フェノメノンを\n生み出すための、\nその巨大なエネルギー。"},
        { "location": "592/TALK"  , "narrator": "みやび", "text": "これが外から来てるゆう\n意味に捉えられる内容が、\n資料の中にあったちや。"},
        { "location": "594/TALK"  , "narrator": "みやび", "text": "やき、その外から来てる\n大元がどこなのかが\nわかれば――"},
        { "location": "596/TALK"  , "narrator": "みやび", "text": "ん？"},
        { "location": "597/TALK"  , "narrator": "アーヤ", "text": "苦しんでる仲間に、\n私は…追い打ちを\nかけたなんて…。"},
        { "location": "598/TALK"  , "narrator": "みやび", "text": "…アーヤ？\nうちの話聞いちょる？"},
        { "location": "599/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "600/TALK"  , "narrator": "みやび", "text": "…アーヤは悪くないぞね。\nそんな気に病まんでも\nえいんよ。"},
        { "location": "601/TALK"  , "narrator": "みやび", "text": "アーヤは、卯月の実家の\n場所を知らんかった。"},
        { "location": "602/TALK"  , "narrator": "みやび", "text": "卯月も、自分の家が\n巻き込まれちょるのを\n言わんかった。"},
        { "location": "603/TALK"  , "narrator": "みやび", "text": "それじゃ、卯月の家が\n巻き込まれちょるなんて、\nわかるはずないやろ？"},
        { "location": "605/TALK"  , "narrator": "アーヤ", "text": "それは、そうだけど…。"},
        { "location": "606/TALK"  , "narrator": "みやび", "text": "じゃあ、何か？"},
        { "location": "607/TALK"  , "narrator": "みやび", "text": "実家が巻き込まれてれば、\n自分勝手な行動が正当化\nできるゆうんか？"},
        { "location": "608/TALK"  , "narrator": "アーヤ", "text": "まさか！\nそんなわけないでしょ…。"},
        { "location": "609/TALK"  , "narrator": "みやび", "text": "そうやろ？"},
        { "location": "610/TALK"  , "narrator": "みやび", "text": "アーヤは、リーダーとして\n当然のことをしただけや。"},
        { "location": "611/TALK"  , "narrator": "みやび", "text": "自分勝手な行動をして、\n勝手な行動を起こした\n卯月を叱った。"},
        { "location": "612/TALK"  , "narrator": "みやび", "text": "それは、どんな状況でも\nやらんといかんことや。"},
        { "location": "614/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "615/TALK"  , "narrator": "みやび", "text": "なんや？　まだ自分が\n間違うたことをしたと\n思うてるが？"},
        { "location": "618/TALK"  , "narrator": "アーヤ", "text": "…ううん。"},
        { "location": "619/TALK"  , "narrator": "アーヤ", "text": "ありがとう、みやび…。\nちょっと、元気出たわ。"},
        { "location": "620/TALK"  , "narrator": "みやび", "text": "…まあ、気にするなゆうて\n割り切れる性格やないのは\nわかっちょるぞね。"},
        { "location": "621/TALK"  , "narrator": "みやび", "text": "けんど、うちはアーヤが\n間違うたことをしたとは\n思うちょらん。"},
        { "location": "622/TALK"  , "narrator": "アーヤ", "text": "…ん、ありがとう。"},
        { "location": "623/TALK"  , "narrator": "アーヤ", "text": "…それで？\nなんの話だったかしら？"},
        { "location": "624/TALK"  , "narrator": "みやび", "text": "ああ…フェノメノンが\n人為的に起こされちょる\n可能性がある。"},
        { "location": "625/TALK"  , "narrator": "みやび", "text": "今は、それだけ覚えといて\nもらえればえいよ。"},
        { "location": "627/TALK"  , "narrator": "アーヤ", "text": "ん…わかった…。"},
        { "location": "629/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "630/TALK"  , "narrator": "みやび", "text": "すまんけんど、\nうちは先に帰るちや。"},
        { "location": "631/TALK"  , "narrator": "みやび", "text": "しばらく、一人で\n気持ちまとめてから\n帰ってきぃ。"},
        { "location": "633/TALK"  , "narrator": "アーヤ", "text": "…そうするわ。"},
        { "location": "638/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "644/TALK"  , "narrator": "アーヤ", "text": "$handle$はどう思う？"},
        { "location": "645/TALK"  , "narrator": "アーヤ", "text": "私が"},
        { "location": "646/TALK"  , "narrator": "アーヤ", "text": "卯月を叱ったこと(-.-;)"},
        { "location": "647/TALK"  , "narrator": "アーヤ", "text": "みやびは"},
        { "location": "648/TALK"  , "narrator": "アーヤ", "text": "正しいって言ってくれた"},
        { "location": "649/TALK"  , "narrator": "アーヤ", "text": "でも"},
        { "location": "651/TALK"  , "narrator": "アーヤ", "text": "自信が持てない(>_<)"},
        { "location": "652/TALK"  , "narrator": "アーヤ", "text": "本当に"},
        { "location": "653/TALK"  , "narrator": "アーヤ", "text": "あれでよかったのか(ノД`)"},
        { "location": "656/SEL"   , "narrator": "", "text": "間違ってないよ、自信持って！"},
        { "location": "657/SEL"   , "narrator": "", "text": "$me$にもわからない"},
        { "location": "658/SEL"   , "narrator": "", "text": "理由を聞かなかったのが間違い"},
        { "location": "659/ACT"   , "narrator": "", "text": "間違ってないよ、自信持って！"},
        { "location": "661/TALK"  , "narrator": "アーヤ", "text": "ありがとう(｡-_-｡)"},
        { "location": "662/TALK"  , "narrator": "アーヤ", "text": "ごめんなさい"},
        { "location": "663/TALK"  , "narrator": "アーヤ", "text": "いつまでもウジウジ(-ω-;)"},
        { "location": "664/TALK"  , "narrator": "アーヤ", "text": "でも"},
        { "location": "665/TALK"  , "narrator": "アーヤ", "text": "もう平気だから"},
        { "location": "668/TALK"  , "narrator": "アーヤ", "text": "気持ち切り替えるわ(^^"},
        { "location": "671/ACT"   , "narrator": "", "text": "$me$にもわからない"},
        { "location": "672/TALK"  , "narrator": "アーヤ", "text": "そう(-.-;)"},
        { "location": "675/TALK"  , "narrator": "アーヤ", "text": "もしかしたら"},
        { "location": "676/TALK"  , "narrator": "アーヤ", "text": "間違ってもいるし"},
        { "location": "677/TALK"  , "narrator": "アーヤ", "text": "間違ってもいない"},
        { "location": "678/TALK"  , "narrator": "アーヤ", "text": "だからかしら？"},
        { "location": "681/TALK"  , "narrator": "アーヤ", "text": "私にもわからない(´o｀；"},
        { "location": "682/TALK"  , "narrator": "アーヤ", "text": "ありがとう"},
        { "location": "684/TALK"  , "narrator": "アーヤ", "text": "相談乗ってくれてm(_ _)m"},
        { "location": "691/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "692/TALK"  , "narrator": "アーヤ", "text": "ダメよね…。\nいつまでも、こんなに\nウジウジしてたら…。"},
        { "location": "694/TALK"  , "narrator": "アーヤ", "text": "私にはわからないけど、\nみやびは、ハッキリと\n言ってくれた。"},
        { "location": "695/TALK"  , "narrator": "アーヤ", "text": "だから、今はみやびの\n言葉を信じよう…。"},
        { "location": "696/ACT"   , "narrator": "", "text": "理由を聞かなかったのが間違い"},
        { "location": "697/TALK"  , "narrator": "アーヤ", "text": "そうよね"},
        { "location": "698/TALK"  , "narrator": "アーヤ", "text": "$handle$の言う通り(; ;)"},
        { "location": "699/TALK"  , "narrator": "アーヤ", "text": "卯月は今まで"},
        { "location": "700/TALK"  , "narrator": "アーヤ", "text": "勝手な行動はしなかった"},
        { "location": "701/TALK"  , "narrator": "アーヤ", "text": "なのに"},
        { "location": "702/TALK"  , "narrator": "アーヤ", "text": "理由があると考えずに"},
        { "location": "703/TALK"  , "narrator": "アーヤ", "text": "感情的に叱りつけた(ノД`)"},
        { "location": "705/TALK"  , "narrator": "アーヤ", "text": "大人として"},
        { "location": "707/TALK"  , "narrator": "アーヤ", "text": "恥ずかしいことした(>_<)"},
        { "location": "708/TALK"  , "narrator": "アーヤ", "text": "反省しないと(T_T)"},
        { "location": "714/TALK"  , "narrator": "アーヤ", "text": "やっぱり、神楽には\nちゃんと謝った方が…。"},
        { "location": "715/TALK"  , "narrator": "アーヤ", "text": "…いや、やっぱりダメ。"},
        { "location": "717/TALK"  , "narrator": "アーヤ", "text": "どんな理由があっても、\n戦闘中の勝手な行動は\n許されない。"},
        { "location": "718/TALK"  , "narrator": "アーヤ", "text": "隊員全員の命に関わる\n問題に発展する可能性も\nあるんだから…。"},
        { "location": "719/TALK"  , "narrator": "アーヤ", "text": "みやびも言ってたけど、\n叱ったこと事態に\n間違はないはず。"},
        { "location": "720/TALK"  , "narrator": "アーヤ", "text": "…でも、感情的になって\n怒ったことは、\n本当に反省しないと…。"},
        { "location": "722/TALK"  , "narrator": "アーヤ", "text": "私も、まだまだ精神的に\n大人になり切れてない、\nってことね…。"},
        { "location": "734/DIALOG", "narrator": "Dialog_chapter_ch02", "text": "【14 神楽学校やめるってよ】"}
    ]
}
