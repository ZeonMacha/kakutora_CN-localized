{
    "dir": "chap23/daydra/dd_ch03_23_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "23356",
        "cid": "gabriella",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "料理で恩返し"
    },
    "entry":
    [
        { "location": "250/SCENARIO", "narrator": "", "text": "料理で恩返し"},
        { "location": "263/TALK"    , "narrator": "ガブリエラ", "text": "…焼き目も付いたし、\nこんなもんかしら。"},
        { "location": "265/TALK"    , "narrator": "ガブリエラ", "text": "つばめ、\n切ったお野菜持ってきて。"},
        { "location": "266/TALK"    , "narrator": "つばめ", "text": "ちょ、ちょっと待って。\nもうすぐ終わるから…。"},
        { "location": "267/TALK"    , "narrator": "ガブリエラ", "text": "まだ終わってないの！？"},
        { "location": "269/TALK"    , "narrator": "ガブリエラ", "text": "うわっ、ていうかこれ、\n切るの下手過ぎ！"},
        { "location": "271/TALK"    , "narrator": "つばめ", "text": "そ、そうかな？"},
        { "location": "272/TALK"    , "narrator": "ガブリエラ", "text": "どう見たって下手よ！\n形はいびつだし、\n厚さもバラバラだし…。"},
        { "location": "275/TALK"    , "narrator": "つばめ", "text": "ご、ごめん…。\nもっと丁寧に、\n早く切るから――"},
        { "location": "276/TALK"    , "narrator": "ガブリエラ", "text": "ちょ、ストップストップ！\nそんな切り方したら\n危ないから！"},
        { "location": "278/TALK"    , "narrator": "つばめ", "text": "でも、この方が\n早く切れるし…。"},
        { "location": "279/TALK"    , "narrator": "ガブリエラ", "text": "だからってケガしたら\nダメでしょ！？"},
        { "location": "280/TALK"    , "narrator": "ガブリエラ", "text": "それに、これは\nみやびのお母さん達に\n食べてもらう料理よ？"},
        { "location": "281/TALK"    , "narrator": "ガブリエラ", "text": "お世話になったお礼の\n食事に、血が付いてたら\nマズいじゃん。"},
        { "location": "282/TALK"    , "narrator": "つばめ", "text": "そ、そうだよね…。"},
        { "location": "285/TALK"    , "narrator": "ガブリエラ", "text": "はぁ…もういいわ。"},
        { "location": "287/TALK"    , "narrator": "ガブリエラ", "text": "残りはあたしがやるから、\nつばめはお鍋だけ見てて。"},
        { "location": "289/TALK"    , "narrator": "つばめ", "text": "だ、大丈夫だよ。\n気を付けてやるから。"},
        { "location": "290/TALK"    , "narrator": "ガブリエラ", "text": "あのね…それだと\nどんどん遅くなっちゃう\nでしょ？"},
        { "location": "291/TALK"    , "narrator": "ガブリエラ", "text": "みやびのお母さん達、\nお腹空かせちゃっても\nいいの？"},
        { "location": "293/TALK"    , "narrator": "つばめ", "text": "そ、それは、\nダメだけど…。"},
        { "location": "294/TALK"    , "narrator": "ガブリエラ", "text": "なら、大人しく鍋だけ\n見てなさい。\nわかった？"},
        { "location": "296/TALK"    , "narrator": "つばめ", "text": "…うん。\nごめんね、邪魔して…。"},
        { "location": "297/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "299/TALK"    , "narrator": "ガブリエラ", "text": "ちょっと、かわいそう\nだったかしら？"},
        { "location": "300/TALK"    , "narrator": "ガブリエラ", "text": "でも…。"},
        { "location": "313/TALK"    , "narrator": "ガブリエラ", "text": "私は間違ってないわよね？"},
        { "location": "314/TALK"    , "narrator": "ガブリエラ", "text": "そうと言って"},
        { "location": "315/TALK"    , "narrator": "ガブリエラ", "text": "マルザンナ"},
        { "location": "317/SEL"     , "narrator": "", "text": "何が間違ってないと思うの？"},
        { "location": "318/ACT"     , "narrator": "", "text": "何が間違ってないと思うの？"},
        { "location": "320/TALK"    , "narrator": "ガブリエラ", "text": "つばめに"},
        { "location": "321/TALK"    , "narrator": "ガブリエラ", "text": "手伝うなって言ったこと"},
        { "location": "322/TALK"    , "narrator": "ガブリエラ", "text": "わかってはいるの"},
        { "location": "323/TALK"    , "narrator": "ガブリエラ", "text": "みやびのご両親にお礼をしたい"},
        { "location": "324/TALK"    , "narrator": "ガブリエラ", "text": "その気持ちは"},
        { "location": "325/TALK"    , "narrator": "ガブリエラ", "text": "私もつばめも一緒だって"},
        { "location": "326/TALK"    , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "327/TALK"    , "narrator": "ガブリエラ", "text": "つばめは遅いから"},
        { "location": "328/TALK"    , "narrator": "ガブリエラ", "text": "どんどん時間が遅くなっちゃう"},
        { "location": "329/TALK"    , "narrator": "ガブリエラ", "text": "それも問題でしょう？"},
        { "location": "331/SEL"     , "narrator": "", "text": "間違ってないよ"},
        { "location": "332/SEL"     , "narrator": "", "text": "大切なのは気持ちだよ"},
        { "location": "333/SEL"     , "narrator": "", "text": "簡単な作業を任せようよ"},
        { "location": "334/ACT"     , "narrator": "", "text": "間違ってないよ"},
        { "location": "335/TALK"    , "narrator": "ガブリエラ", "text": "そうよね"},
        { "location": "337/TALK"    , "narrator": "ガブリエラ", "text": "私は間違ってないわよね"},
        { "location": "338/TALK"    , "narrator": "ガブリエラ", "text": "ありがとう"},
        { "location": "339/TALK"    , "narrator": "ガブリエラ", "text": "言ってもらえて安心したわ"},
        { "location": "352/TALK"    , "narrator": "ガブリエラ", "text": "…さてと、残りのも\nちゃっちゃと作らないと。"},
        { "location": "353/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "355/TALK"    , "narrator": "ガブリエラ", "text": "ほ、ほらつばめ！\n吹きこぼれないように\nちゃんと見てて！"},
        { "location": "357/TALK"    , "narrator": "つばめ", "text": "あ、うん…。"},
        { "location": "370/TALK"    , "narrator": "ガブリエラ", "text": "…もうこんな時間。\nそろそろ寝る準備しよう\nかしら？"},
        { "location": "372/TALK"    , "narrator": "つばめ", "text": "じゃあ、\nお布団の用意するね。"},
        { "location": "375/TALK"    , "narrator": "ガブリエラ", "text": "ん、お願い。"},
        { "location": "378/TALK"    , "narrator": "みやび", "text": "おーい、ガブちゃん、\nつばめちゃん。\n起きてる？"},
        { "location": "380/TALK"    , "narrator": "ガブリエラ", "text": "ええ、そろそろ寝ようと\n思ってたところだけど…。"},
        { "location": "381/TALK"    , "narrator": "みやび", "text": "すまんすまん。\nうっかりして言いそびれる\nところやった。"},
        { "location": "382/TALK"    , "narrator": "みやび", "text": "おかん達が、美味しい食事\n作ってくれてありがとう\n言うてたちや。"},
        { "location": "383/TALK"    , "narrator": "ガブリエラ", "text": "えっ、本当？"},
        { "location": "385/TALK"    , "narrator": "つばめ", "text": "わぁ、やったね！"},
        { "location": "386/TALK"    , "narrator": "みやび", "text": "本当や。\n特にほれ、\nポーランドの料理？"},
        { "location": "387/TALK"    , "narrator": "みやび", "text": "あれが最高に美味かった\n言うてたぞね。"},
        { "location": "388/TALK"    , "narrator": "ガブリエラ", "text": "そ、そう…。\n口に合ったみたいで\n安心したわ。"},
        { "location": "389/TALK"    , "narrator": "つばめ", "text": "すごいよガブちゃん！\nみやびさんのお母さん達、\n美味しかったって！"},
        { "location": "391/TALK"    , "narrator": "ガブリエラ", "text": "い、今聞いたから。\nわかってるわよ。"},
        { "location": "394/TALK"    , "narrator": "つばめ", "text": "えへへ…でも、なんだか\n嬉しくて…。"},
        { "location": "395/TALK"    , "narrator": "つばめ", "text": "やっぱりガブちゃんは\n料理上手なんだなぁ…。"},
        { "location": "396/TALK"    , "narrator": "みやび", "text": "うちも気になるき、\n東京帰ったら\n食べさせてほしいがよ。"},
        { "location": "398/TALK"    , "narrator": "ガブリエラ", "text": "仕方ないわね…。\nその代わり、キッチンは\n貸しなさいよ？"},
        { "location": "400/TALK"    , "narrator": "みやび", "text": "しゃあないなぁ…。\nま、そういうことやき、\nおやすみ～。"},
        { "location": "405/TALK"    , "narrator": "ガブリエラ", "text": "…よかった。\nちゃんと喜んでもらえて。"},
        { "location": "407/TALK"    , "narrator": "つばめ", "text": "そうだね。\nやっぱり、ガブちゃんが\n作って正解だったよ。"},
        { "location": "409/TALK"    , "narrator": "ガブリエラ", "text": "えっ…。"},
        { "location": "410/TALK"    , "narrator": "つばめ", "text": "わたしも、東京帰ったら\nもっとお料理の練習\nしないと…。"},
        { "location": "411/TALK"    , "narrator": "つばめ", "text": "上手になったら、\nまた一緒にお料理してね。"},
        { "location": "412/TALK"    , "narrator": "ガブリエラ", "text": "う、うん…。"},
        { "location": "414/TALK"    , "narrator": "ガブリエラ", "text": "…何でなのかしら？\n料理、ちゃんと喜んで\nもらえたはずなのに――"},
        { "location": "415/TALK"    , "narrator": "ガブリエラ", "text": "どうして、こんなに\nモヤモヤした気持ちに\nなるのかしら…。"},
        { "location": "416/ACT"     , "narrator": "", "text": "大切なのは気持ちだよ"},
        { "location": "417/TALK"    , "narrator": "ガブリエラ", "text": "気持ちね"},
        { "location": "418/TALK"    , "narrator": "ガブリエラ", "text": "いい言葉だけど"},
        { "location": "419/TALK"    , "narrator": "ガブリエラ", "text": "気持ちで食事は美味しくならないわ"},
        { "location": "420/TALK"    , "narrator": "ガブリエラ", "text": "それが事実なのよ"},
        { "location": "431/TALK"    , "narrator": "ガブリエラ", "text": "…料理なんて、\n結局は技術なんだから。"},
        { "location": "432/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "434/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "437/TALK"    , "narrator": "ガブリエラ", "text": "ああ、もう！\nわかった、わかったわよ！"},
        { "location": "438/TALK"    , "narrator": "ガブリエラ", "text": "つばめ、鍋はもういいから\nそこにある野菜炒めて！"},
        { "location": "440/TALK"    , "narrator": "つばめ", "text": "えっ…いいの？"},
        { "location": "442/TALK"    , "narrator": "ガブリエラ", "text": "一々聞き返さない！\nあたしの気が変わる前に\nさっさと動く！"},
        { "location": "444/TALK"    , "narrator": "つばめ", "text": "う、うん！\nありがと、ガブちゃん。"},
        { "location": "459/TALK"    , "narrator": "つばめ", "text": "どうだったかな？\nわたし達の作った料理、\n喜んでもらえたかな？"},
        { "location": "461/TALK"    , "narrator": "ガブリエラ", "text": "落ち着きなさいよ。\nそんなの期待するなんて\nはしたないわよ。"},
        { "location": "462/TALK"    , "narrator": "つばめ", "text": "でも、ガブちゃんも\n感想気になるでしょ？"},
        { "location": "463/TALK"    , "narrator": "ガブリエラ", "text": "あ、あたしは別に！\nそんなの気にするような\n子供じゃないし…。"},
        { "location": "466/TALK"    , "narrator": "みやび", "text": "おっ、二人とも\nまだ起きちょったか。"},
        { "location": "467/TALK"    , "narrator": "つばめ", "text": "あっ、みやびさん。"},
        { "location": "468/TALK"    , "narrator": "みやび", "text": "うち、今夜も自室で\n遅くまで起きてるき。"},
        { "location": "470/TALK"    , "narrator": "みやび", "text": "何かあったら、\n呼びに来るなりＷＡＶＥ\n送るなりしてな。"},
        { "location": "471/TALK"    , "narrator": "ガブリエラ", "text": "わ、わかったわ…。"},
        { "location": "472/TALK"    , "narrator": "みやび", "text": "ん、それじゃ…。"},
        { "location": "474/TALK"    , "narrator": "ガブリエラ", "text": "えっ？"},
        { "location": "475/TALK"    , "narrator": "みやび", "text": "何？　何か用あるが？"},
        { "location": "477/TALK"    , "narrator": "ガブリエラ", "text": "あ、ううん。\n別に…。"},
        { "location": "479/TALK"    , "narrator": "つばめ", "text": "あ、あの！"},
        { "location": "480/TALK"    , "narrator": "つばめ", "text": "お母さん達、お料理のこと\n何か言ってません\nでしたか？"},
        { "location": "482/TALK"    , "narrator": "みやび", "text": "は？"},
        { "location": "485/TALK"    , "narrator": "ガブリエラ", "text": "ちょ、つばめ！"},
        { "location": "488/TALK"    , "narrator": "つばめ", "text": "ごめん…でも、やっぱり\n気になるし…。"},
        { "location": "489/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "490/TALK"    , "narrator": "みやび", "text": "ああ、食事か。\n二人が料理したん\nやったね。"},
        { "location": "491/TALK"    , "narrator": "つばめ", "text": "は、はい…。"},
        { "location": "493/TALK"    , "narrator": "みやび", "text": "えーっと…ほれ、あれや。"},
        { "location": "496/TALK"    , "narrator": "みやび", "text": "ごちそうさま、って\n言うてたぞね。"},
        { "location": "498/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "500/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "503/TALK"    , "narrator": "みやび", "text": "あー…そういうわけやき、\nおやすみー…。"},
        { "location": "508/TALK"    , "narrator": "ガブリエラ", "text": "気を使われたのに\n違いはないわね。"},
        { "location": "509/TALK"    , "narrator": "つばめ", "text": "うう、ごめんね…。\nやっぱり、ガブちゃんに\n任せておけばよかった…。"},
        { "location": "510/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "511/TALK"    , "narrator": "ガブリエラ", "text": "バカね。\n目的はお礼を言われる\nことじゃないでしょ？"},
        { "location": "512/TALK"    , "narrator": "ガブリエラ", "text": "お世話になった\n感謝の気持ちで\n作った物なんだから。"},
        { "location": "514/TALK"    , "narrator": "ガブリエラ", "text": "その気持ちを、\nお母さん達は受け取って\n食べてくれたのよ？"},
        { "location": "515/TALK"    , "narrator": "ガブリエラ", "text": "だから、贅沢言わずに\n満足しなさい。"},
        { "location": "516/TALK"    , "narrator": "つばめ", "text": "…ガブちゃん…、\n何か、大人だね…。"},
        { "location": "517/TALK"    , "narrator": "ガブリエラ", "text": "な、何よそれ？"},
        { "location": "518/TALK"    , "narrator": "つばめ", "text": "何か、見習わないとなぁ、\nって思って…。"},
        { "location": "520/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "521/TALK"    , "narrator": "ガブリエラ", "text": "はぁ…やっぱり、\nあたしが作った方が\nよかったかも…。"},
        { "location": "522/ACT"     , "narrator": "", "text": "簡単な作業を任せようよ"},
        { "location": "523/TALK"    , "narrator": "ガブリエラ", "text": "簡単に言うわね"},
        { "location": "524/TALK"    , "narrator": "ガブリエラ", "text": "そう言うけど"},
        { "location": "525/TALK"    , "narrator": "ガブリエラ", "text": "つばめでもできるような"},
        { "location": "526/TALK"    , "narrator": "ガブリエラ", "text": "簡単な作業"},
        { "location": "527/TALK"    , "narrator": "ガブリエラ", "text": "考えるのは難しいのよ？"},
        { "location": "528/TALK"    , "narrator": "ガブリエラ", "text": "まあ"},
        { "location": "529/TALK"    , "narrator": "ガブリエラ", "text": "考えてみるけど"},
        { "location": "540/TALK"    , "narrator": "ガブリエラ", "text": "…つばめでも問題なく\nできる簡単な作業…。"},
        { "location": "541/TALK"    , "narrator": "ガブリエラ", "text": "うーん…。"},
        { "location": "543/TALK"    , "narrator": "ガブリエラ", "text": "…そうだ！\nつばめ、お鍋の味付け\n手伝って！"},
        { "location": "545/TALK"    , "narrator": "つばめ", "text": "えっ！？\nあ、味付けって\nすごい重要じゃ…。"},
        { "location": "546/TALK"    , "narrator": "ガブリエラ", "text": "あたしはこっちの作業が\nあるんだから、つばめが\nやるしかないでしょ？"},
        { "location": "547/TALK"    , "narrator": "ガブリエラ", "text": "ちゃんと指示するから、\n言われた通りに入れて。\nＯＫ？"},
        { "location": "548/TALK"    , "narrator": "つばめ", "text": "う、うん！\n任せて！"},
        { "location": "549/TALK"    , "narrator": "ガブリエラ", "text": "…ちなみに、間違えたら\n台無しになるわよ？"},
        { "location": "550/TALK"    , "narrator": "つばめ", "text": "ぷ、プレッシャー\nかけないでよぉ！"},
        { "location": "552/TALK"    , "narrator": "ガブリエラ", "text": "文句言わないの。\nそれじゃ、まずは――"},
        { "location": "565/TALK"    , "narrator": "ガブリエラ", "text": "…もうこんな時間。\nそろそろ寝る準備しよう\nかしら？"},
        { "location": "567/TALK"    , "narrator": "つばめ", "text": "じゃあ、\nお布団の用意するね。"},
        { "location": "568/TALK"    , "narrator": "ガブリエラ", "text": "ん、お願い。"},
        { "location": "571/TALK"    , "narrator": "みやび", "text": "おーい、ガブちゃん、\nつばめちゃん。\n起きてる？"},
        { "location": "573/TALK"    , "narrator": "ガブリエラ", "text": "ええ、そろそろ寝ようと\n思ってたところだけど…。"},
        { "location": "574/TALK"    , "narrator": "みやび", "text": "すまんすまん。\nうっかりして言いそびれる\nところやった。"},
        { "location": "576/TALK"    , "narrator": "みやび", "text": "おかん達が、美味しい食事\n作ってくれてありがとう\n言うてたちや。"},
        { "location": "577/TALK"    , "narrator": "ガブリエラ", "text": "えっ、本当？"},
        { "location": "579/TALK"    , "narrator": "つばめ", "text": "わぁ、やったね！"},
        { "location": "580/TALK"    , "narrator": "みやび", "text": "本当や。\n特にほれ、\nポーランドの料理？"},
        { "location": "581/TALK"    , "narrator": "みやび", "text": "あれが最高に美味かった\n言うてたぞね。"},
        { "location": "582/TALK"    , "narrator": "ガブリエラ", "text": "そ、そう…。\n口に合ったみたいで\n安心したわ。"},
        { "location": "583/TALK"    , "narrator": "つばめ", "text": "すごいよガブちゃん！\nみやびさんのお母さん達、\n美味しかったって！"},
        { "location": "585/TALK"    , "narrator": "ガブリエラ", "text": "い、今聞いたから。\nわかってるわよ。"},
        { "location": "587/TALK"    , "narrator": "つばめ", "text": "えへへ…でも、なんだか\n嬉しくて…。"},
        { "location": "588/TALK"    , "narrator": "つばめ", "text": "やっぱりガブちゃんは\n料理上手なんだなぁ…。"},
        { "location": "589/TALK"    , "narrator": "みやび", "text": "うちも気になるき、\n東京帰ったら\n食べさせてほしいがよ。"},
        { "location": "591/TALK"    , "narrator": "ガブリエラ", "text": "仕方ないわね…。\nその代わり、キッチンは\n貸しなさいよ？"},
        { "location": "593/TALK"    , "narrator": "みやび", "text": "しゃあないなぁ…。\nま、そういうことやき、\nおやすみ～。"},
        { "location": "598/TALK"    , "narrator": "ガブリエラ", "text": "…そっか。\n喜んでもらえたんだ…。"},
        { "location": "599/TALK"    , "narrator": "ガブリエラ", "text": "よかった…。\nやっぱり作って\n正解だったわ。"},
        { "location": "600/TALK"    , "narrator": "つばめ", "text": "…ガブちゃん。\n今日はありがと。"},
        { "location": "602/TALK"    , "narrator": "ガブリエラ", "text": "えっ？"},
        { "location": "604/TALK"    , "narrator": "つばめ", "text": "お料理…ガブちゃんの\n指示があったから、\n美味しくなったんだもん。"},
        { "location": "605/TALK"    , "narrator": "つばめ", "text": "そうじゃなかったら、\nきっと、大変なことに\nなってたと思うし…。"},
        { "location": "606/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "608/TALK"    , "narrator": "つばめ", "text": "でも、ガブちゃんの\nおかげで、わたしも\n協力出来たから。"},
        { "location": "610/TALK"    , "narrator": "つばめ", "text": "だから、ありがと。"},
        { "location": "612/TALK"    , "narrator": "ガブリエラ", "text": "…べ、別に…、みやびの\nお母さん達に喜んで\nほしかっただけよ…。"},
        { "location": "613/TALK"    , "narrator": "ガブリエラ", "text": "つばめを喜ばそうと\n思ってやったわけじゃ\nないし…。"},
        { "location": "615/TALK"    , "narrator": "つばめ", "text": "そ、そうだよね。"},
        { "location": "617/TALK"    , "narrator": "つばめ", "text": "でも、わたしもとっても\n嬉しいから。\nだから――"},
        { "location": "619/TALK"    , "narrator": "ガブリエラ", "text": "はいはい、わかったから。\nそう何度もお礼言わなくて\nいいから！"},
        { "location": "620/TALK"    , "narrator": "つばめ", "text": "あ、うん…えへへ…。"},
        { "location": "622/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "624/TALK"    , "narrator": "ガブリエラ", "text": "本当…二人で作って\nよかった…。"},
        { "location": "261/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>8月23日　 5:34 PM</color>\n合宿中、みやびの実家でのこと"}
    ]
}
