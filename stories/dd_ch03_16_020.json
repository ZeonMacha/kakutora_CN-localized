{
    "dir": "chap16/daydra/dd_ch03_16_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "16356",
        "cid": "gabriella",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "肝試しと女生徒"
    },
    "entry":
    [
        { "location": "269/SCENARIO", "narrator": "", "text": "肝試しと女生徒"},
        { "location": "284/TALK"    , "narrator": "ガブリエラ", "text": "みんな、揃ったわね。\nそれじゃあ肝試しを\n始めるわ！"},
        { "location": "286/TALK"    , "narrator": "キリト", "text": "…ここまで来るだけでも、\n十分肝試しにはなった\nけどな。"},
        { "location": "287/TALK"    , "narrator": "つばめ", "text": "ここも結構怖いよ。\n静かで真っ暗だし…。"},
        { "location": "288/TALK"    , "narrator": "雛", "text": "あたしもそれ思った。\n校舎の中とは違った\n怖さあるよね？"},
        { "location": "290/TALK"    , "narrator": "ガブリエラ", "text": "お喋りしないの！\n今からルールを\n説明するわ。"},
        { "location": "291/TALK"    , "narrator": "ガブリエラ", "text": "スタートはこの屋上で、\nゴールは一階の玄関ね。"},
        { "location": "292/TALK"    , "narrator": "ガブリエラ", "text": "玄関に到着した、って\n連絡が来たら、\n次の人がスタート。"},
        { "location": "295/TALK"    , "narrator": "キリト", "text": "…俺もヒカルと一緒に、\n玄関で待ちたかったなぁ。"},
        { "location": "296/TALK"    , "narrator": "雛", "text": "キリトってこういうの\n苦手だっけ？"},
        { "location": "299/TALK"    , "narrator": "キリト", "text": "苦手じゃねぇ奴って\nいるのか？"},
        { "location": "301/TALK"    , "narrator": "ガブリエラ", "text": "というわけだから。\nさ、誰から始める？"},
        { "location": "303/TALK"    , "narrator": "雛", "text": "…あたし、最初で良い？"},
        { "location": "305/TALK"    , "narrator": "ガブリエラ", "text": "あら、やる気満々ね？"},
        { "location": "307/TALK"    , "narrator": "雛", "text": "いやー、正直怖いけど、\n一番最後よりはマシかな、\nって思って…。"},
        { "location": "310/TALK"    , "narrator": "キリト", "text": "だ、だな…一番最後は、\nなんか嫌な予感しか\nしねぇし…。"},
        { "location": "311/TALK"    , "narrator": "雛", "text": "男のクセに怖がらない\nでよ！"},
        { "location": "313/TALK"    , "narrator": "キリト", "text": "男だって怖いもんは\n怖いんだよ！"},
        { "location": "316/TALK"    , "narrator": "つばめ", "text": "わたしも、一番最後は\nちょっと嫌かも…。"},
        { "location": "319/TALK"    , "narrator": "ガブリエラ", "text": "は？"},
        { "location": "321/TALK"    , "narrator": "ガブリエラ", "text": "何番だろうとすることは\n変わらないんだから、\n関係ないでしょ？"},
        { "location": "323/TALK"    , "narrator": "雛", "text": "いやいや、全然違うって！"},
        { "location": "324/TALK"    , "narrator": "雛", "text": "一番最後だと、後ろには\nもう誰もいない、って\n不安になるし…。"},
        { "location": "326/TALK"    , "narrator": "ガブリエラ", "text": "一緒に歩かない時点で、\nそんなこと気にする必要\nないでしょ？"},
        { "location": "328/TALK"    , "narrator": "キリト", "text": "…おい、ガブリエラって\n根性座り過ぎてねぇか？"},
        { "location": "330/TALK"    , "narrator": "つばめ", "text": "さすがガブちゃん、って\n感じだね。"},
        { "location": "331/TALK"    , "narrator": "雛", "text": "じゃあ、一番最後は\nガブリエラちゃんに\nお任せしていいかな？"},
        { "location": "334/TALK"    , "narrator": "ガブリエラ", "text": "構わないわ。\nそれじゃ、さっさと\n始めましょ。"},
        { "location": "336/TALK"    , "narrator": "つばめ", "text": "ううっ、ドキドキして\nきたよぉ…。"},
        { "location": "353/TALK"    , "narrator": "ガブリエラ", "text": "ふぁ…退屈だわ…。"},
        { "location": "354/TALK"    , "narrator": "ガブリエラ", "text": "つばめったら、どこで\nノロノロしてるのかしら？"},
        { "location": "355/TALK"    , "narrator": "ガブリエラ", "text": "これじゃいつまで経っても\nあたしが出発できない\nじゃない…。"},
        { "location": "359/TALK"    , "narrator": "ガブリエラ", "text": "…あっ、来た！"},
        { "location": "362/TALK"    , "narrator": "ガブリエラ", "text": "やっとメール来たわ。\nまったく、後でちょっと\nだけ文句言わないと。"},
        { "location": "365/TALK"    , "narrator": "ガブリエラ", "text": "さてと、あたしも\n出発…。"},
        { "location": "370/TALK"    , "narrator": "女子高校生Ａ", "text": "…………。"},
        { "location": "371/TALK"    , "narrator": "ガブリエラ", "text": "っ！？"},
        { "location": "372/TALK"    , "narrator": "女子高校生Ａ", "text": "うそっ…こんな時間に\nまだ生徒が残ってた\nなんて…。"},
        { "location": "373/TALK"    , "narrator": "ガブリエラ", "text": "だ、誰なの？\nどうしてここに…？"},
        { "location": "374/TALK"    , "narrator": "女子高校生Ａ", "text": "私は高等部生徒会の\n副会長よ。"},
        { "location": "375/TALK"    , "narrator": "女子高校生Ａ", "text": "先生に頼まれて、\n屋上の施錠に来たの。"},
        { "location": "377/TALK"    , "narrator": "ガブリエラ", "text": "あ、そっか…。\nそういえばここの扉、\n開けっ放しだったっけ…。"},
        { "location": "380/TALK"    , "narrator": "女子高校生Ａ", "text": "っていうか、あなたって\n中等部の子よね？"},
        { "location": "381/TALK"    , "narrator": "女子高校生Ａ", "text": "どうしてこんな時間に、\n高等部の屋上にいるの？"},
        { "location": "383/TALK"    , "narrator": "ガブリエラ", "text": "そ、それは、その…\nちょっと肝試しをしよう\nかな、って…。"},
        { "location": "384/TALK"    , "narrator": "女子高校生Ａ", "text": "はぁ…私だからよかった\nけど、先生に見つかったら\n怒られてたわよ？"},
        { "location": "386/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "387/TALK"    , "narrator": "女子高校生Ａ", "text": "さ、玄関まで送るから、\n一緒に行きましょ。"},
        { "location": "388/TALK"    , "narrator": "ガブリエラ", "text": "何言ってるのよ？\nそれじゃ肝試しに\nならないじゃん。"},
        { "location": "389/SEL"     , "narrator": "", "text": "逃げちゃえ"},
        { "location": "390/SEL"     , "narrator": "", "text": "悪いのはこっちだよ"},
        { "location": "392/TALK"    , "narrator": "女子高校生Ａ", "text": "まだ続けるつもり\nだったの？"},
        { "location": "393/TALK"    , "narrator": "女子高校生Ａ", "text": "私に見つかった時点で、\n肝試しはおしまいよ。"},
        { "location": "394/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "395/TALK"    , "narrator": "女子高校生Ａ", "text": "ほら、早く行こ。"},
        { "location": "398/TALK"    , "narrator": "ガブリエラ", "text": "…どうせ玄関まで\n行くなら…。"},
        { "location": "399/TALK"    , "narrator": "女子高校生Ａ", "text": "ん？"},
        { "location": "400/TALK"    , "narrator": "ガブリエラ", "text": "あたし一人で行くわ！\nさよなら！"},
        { "location": "405/TALK"    , "narrator": "女子高校生Ａ", "text": "え！？　あ、ちょ！！"},
        { "location": "406/TALK"    , "narrator": "女子高校生Ａ", "text": "…………。"},
        { "location": "407/TALK"    , "narrator": "女子高校生Ａ", "text": "ちっ、逃がしたか。"},
        { "location": "409/ACT"     , "narrator": "", "text": "逃げちゃえ"},
        { "location": "430/TALK"    , "narrator": "ガブリエラ", "text": "賛成よ、$marzanna$"},
        { "location": "431/TALK"    , "narrator": "ガブリエラ", "text": "私だけ付き添い付きで言ったら、みんなに笑われちゃうもの"},
        { "location": "442/TALK"    , "narrator": "女子高校生Ａ", "text": "さ、行きましょ。"},
        { "location": "444/TALK"    , "narrator": "ガブリエラ", "text": "…あの。"},
        { "location": "445/TALK"    , "narrator": "女子高校生Ａ", "text": "ん、なに？"},
        { "location": "447/TALK"    , "narrator": "ガブリエラ", "text": "やっぱりあたし、\n一人で行きたいから――"},
        { "location": "448/TALK"    , "narrator": "ガブリエラ", "text": "ごめんなさい！！"},
        { "location": "449/TALK"    , "narrator": "女子高校生Ａ", "text": "え？"},
        { "location": "454/TALK"    , "narrator": "女子高校生Ａ", "text": "あ、ちょっと！！"},
        { "location": "455/TALK"    , "narrator": "女子高校生Ａ", "text": "…………。"},
        { "location": "456/TALK"    , "narrator": "女子高校生Ａ", "text": "ちっ…時間を掛けて\n準備したのに…。"},
        { "location": "457/ACT"     , "narrator": "", "text": "悪いのはこっちだよ"},
        { "location": "480/TALK"    , "narrator": "ガブリエラ", "text": "それはそうだけど…"},
        { "location": "481/TALK"    , "narrator": "ガブリエラ", "text": "わかったわ、この人の言う通りにするわ"},
        { "location": "492/TALK"    , "narrator": "ガブリエラ", "text": "…ごめんなさい。"},
        { "location": "493/TALK"    , "narrator": "女子高校生Ａ", "text": "反省してるならいいのよ。\nさ、一緒に行きましょ。"},
        { "location": "505/TALK"    , "narrator": "女子高校生Ａ", "text": "それにしても、\n肝試しをするなんて\n勇気があるのね。"},
        { "location": "506/TALK"    , "narrator": "女子高校生Ａ", "text": "夜の校舎が怖くないの？"},
        { "location": "507/TALK"    , "narrator": "ガブリエラ", "text": "昼も夜も校舎は同じよ。\n別に怖くないわ。"},
        { "location": "509/TALK"    , "narrator": "女子高校生Ａ", "text": "…凄いのね。\n普通はお化けとか幽霊が\n出そうに思えて――"},
        { "location": "510/TALK"    , "narrator": "女子高校生Ａ", "text": "怖くなるのに…。"},
        { "location": "512/TALK"    , "narrator": "ガブリエラ", "text": "場所によってはそうかも\nしれないけど、この学校は\n平気でしょ？"},
        { "location": "514/TALK"    , "narrator": "ガブリエラ", "text": "墓地を潰して作った\nわけでもないし――"},
        { "location": "515/TALK"    , "narrator": "ガブリエラ", "text": "人が死ぬような事件や\n事故も過去になかったん\nだから――"},
        { "location": "517/TALK"    , "narrator": "ガブリエラ", "text": "幽霊が出るはずないのよ。"},
        { "location": "518/TALK"    , "narrator": "女子高校生Ａ", "text": "す、凄いわね。\nそこまで調べたんだ？"},
        { "location": "520/TALK"    , "narrator": "ガブリエラ", "text": "当然じゃない。\nあ、そろそろ玄関ね。"},
        { "location": "521/TALK"    , "narrator": "女子高校生Ａ", "text": "あなたのお友達にも\n注意しないと、\nまったく…。"},
        { "location": "537/TALK"    , "narrator": "ガブリエラ", "text": "お待たせ。"},
        { "location": "539/TALK"    , "narrator": "ヒカル", "text": "おかえりなさい、\nガブリエラさん。"},
        { "location": "540/TALK"    , "narrator": "雛", "text": "ガブリエラちゃん、\n無事だったんだね！"},
        { "location": "542/TALK"    , "narrator": "ガブリエラ", "text": "物騒なこと言わないでよ。\n無事に決まってるでしょ？"},
        { "location": "544/TALK"    , "narrator": "キリト", "text": "遅いから心配したんだぞ？"},
        { "location": "546/TALK"    , "narrator": "つばめ", "text": "暗いから、階段から\n落ちたりしてないか、\nって。"},
        { "location": "549/TALK"    , "narrator": "ガブリエラ", "text": "落ちたりなんか\nしないって。"},
        { "location": "552/TALK"    , "narrator": "ガブリエラ", "text": "この人に見つかって、\nちょっと話し込んでた\nだけよ。"},
        { "location": "554/TALK"    , "narrator": "ヒカル", "text": "この人？\nそれって誰ですか？"},
        { "location": "556/TALK"    , "narrator": "ガブリエラ", "text": "？"},
        { "location": "557/TALK"    , "narrator": "雛", "text": "ガブリエラちゃん以外、\n誰もいないよ？"},
        { "location": "560/TALK"    , "narrator": "ガブリエラ", "text": "あれ？\nさっきまでいたのに…。"},
        { "location": "562/TALK"    , "narrator": "つばめ", "text": "こんな時間なのに、\n他に生徒がいたの？"},
        { "location": "565/TALK"    , "narrator": "ガブリエラ", "text": "え、ええ…確か、\n高等部生徒会の副会長\nって言ってたわ。"},
        { "location": "566/TALK"    , "narrator": "キリト", "text": "それって、あのマッチョの\n野田先輩のことか？"},
        { "location": "569/TALK"    , "narrator": "ガブリエラ", "text": "…マッチョ？"},
        { "location": "570/TALK"    , "narrator": "雛", "text": "野田先輩って、\nレスリング部の遠征で\n来週までお休みだよ？"},
        { "location": "572/TALK"    , "narrator": "ガブリエラ", "text": "ちょっと待って。\n副会長って女の人でしょ？"},
        { "location": "573/TALK"    , "narrator": "ヒカル", "text": "？　野田先輩は\n男性ですよ？"},
        { "location": "574/TALK"    , "narrator": "キリト", "text": "ははっ、あれを女に\n見間違えることは\nまずねぇわな。"},
        { "location": "575/TALK"    , "narrator": "キリト", "text": "身長二メートル近い\n筋肉の塊だぜ？"},
        { "location": "576/TALK"    , "narrator": "つばめ", "text": "…ガブちゃんが会ったの、\nその人じゃないの？"},
        { "location": "577/TALK"    , "narrator": "ガブリエラ", "text": "ふ、普通の女の人よ！"},
        { "location": "578/TALK"    , "narrator": "ガブリエラ", "text": "生徒会の副会長で、\n先生に頼まれて屋上を\n施錠しに来た、って――"},
        { "location": "581/TALK"    , "narrator": "ガブリエラ", "text": "玄関の近くまで\n一緒にいたんだから！"},
        { "location": "583/TALK"    , "narrator": "キリト", "text": "お、おいおい、待てよ！\nそれおかしいだろ？"},
        { "location": "584/TALK"    , "narrator": "キリト", "text": "こんな時間まで生徒が\n残ってるはずねぇし――"},
        { "location": "586/TALK"    , "narrator": "キリト", "text": "施錠を生徒に任せるとか、\nありえねぇから。"},
        { "location": "588/TALK"    , "narrator": "雛", "text": "じゃ、じゃあ何？\nガブリエラちゃんが\n会ったのって――"},
        { "location": "589/TALK"    , "narrator": "雛", "text": "まさか…。"},
        { "location": "592/TALK"    , "narrator": "ガブリエラ", "text": "っ！？"},
        { "location": "594/TALK"    , "narrator": "ガブリエラ", "text": "い、いやあぁぁぁぁぁ！！"},
        { "location": "600/TALK"    , "narrator": "つばめ", "text": "ま、待って置いてか\nないでー！！"},
        { "location": "603/TALK"    , "narrator": "雛", "text": "出たあぁぁぁぁぁぁ！！"},
        { "location": "605/TALK"    , "narrator": "キリト", "text": "あ、待て、待って！\n腰、腰が、あわわわわ！"},
        { "location": "607/TALK"    , "narrator": "ヒカル", "text": "キリト、しっかりして\nください！！"},
        { "location": "620/TALK"    , "narrator": "女子高校生Ａ", "text": "…………。"},
        { "location": "621/TALK"    , "narrator": "女子高校生Ａ", "text": "ようやく帰ったか。\nやれやれ、まったく…。"},
        { "location": "622/TALK"    , "narrator": "女子高校生Ａ", "text": "よっ…。"},
        { "location": "633/TALK"    , "narrator": "真幌", "text": "ふぅ…どうやら、\nバレてはいないようだな。"},
        { "location": "634/TALK"    , "narrator": "真幌", "text": "普通に注意するより、\n驚かした方が効果的かと\n思ったのだが――"},
        { "location": "635/TALK"    , "narrator": "真幌", "text": "予想以上だったな。"},
        { "location": "636/TALK"    , "narrator": "真幌", "text": "ふふっ、私の変装の腕は\nまだまだ衰え知らずの\nようだ。"},
        { "location": "638/TALK"    , "narrator": "真幌", "text": "…しかし、女子高生の\n制服は、もう二度と\n着る気になれんな…。"},
        { "location": "282/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>7月19日　8:44 PM</color>\nとある平日の夜、附属学園前庭にて。"},
        { "location": "649/DIALOG"  , "narrator": "Dialog_GEThimegoto_ch03", "text": "【別名は花子さん】"}
    ]
}
