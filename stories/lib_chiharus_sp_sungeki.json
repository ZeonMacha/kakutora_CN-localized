        { "location": "69/SCENARIO", "narrator": "", "text": "精神世界概念チュートリアル（寸劇）"},
        { "location": "72/SEL"     , "narrator": "", "text": "これは一体…？"},
        { "location": "73/ACT"     , "narrator": "", "text": "これは一体…？"},
        { "location": "77/TALK"    , "narrator": "千羽鶴", "text": "夢の中の世界ね。"},
        { "location": "78/TALK"    , "narrator": "千羽鶴", "text": "ココロスフィアでは\n希によくあるケース。"},
        { "location": "79/SEL"     , "narrator": "", "text": "日本語オカシイデス"},
        { "location": "80/ACT"     , "narrator": "", "text": "日本語オカシイデス"},
        { "location": "82/TALK"    , "narrator": "千羽鶴", "text": "……細かいことは\n気にしないように。"},
        { "location": "83/TALK"    , "narrator": "千羽鶴", "text": "心の中では、直接\n貴方に悩みを訴えて\nくるケースと――"},
        { "location": "84/TALK"    , "narrator": "千羽鶴", "text": "今回のように、悩みが\n劇のような形で表現\nされるケースがある。"},
        { "location": "85/TALK"    , "narrator": "千羽鶴", "text": "まあ、心の中だから、\n夢を見ている状態だと\n思えば間違いない。"},
        { "location": "86/TALK"    , "narrator": "千羽鶴", "text": "貴方はいつものように\n彼女達を注意深く\n見ていればいい。"}
    ]
}
