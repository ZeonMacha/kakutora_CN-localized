        { "location": "452/TALK"  , "narrator": "アーヤ", "text": "気持ち、\n読まれてたみたい？"},
        { "location": "453/TALK"  , "narrator": "アーヤ", "text": "うーん…。\n私そんなに\nわかりやすいかな？"},
        { "location": "454/TALK"  , "narrator": "アーヤ", "text": "でも\nわかってくれてるのは\nうれしいわ。"},
        { "location": "455/TALK"  , "narrator": "アーヤ", "text": "！　って！"},
        { "location": "456/TALK"  , "narrator": "アーヤ", "text": "急がなきゃ\n船が出ちゃう！"},
        { "location": "457/TALK"  , "narrator": "アーヤ", "text": "すみません\n大人一人！"},
        { "location": "473/TALK"  , "narrator": "アーヤ", "text": "あー………。\n降ってきた……。"},
        { "location": "474/TALK"  , "narrator": "アーヤ", "text": "ギリギリ保つって\n思ってたのに……。"},
        { "location": "487/TALK"  , "narrator": "アーヤ", "text": "雨"},
        { "location": "488/TALK"  , "narrator": "アーヤ", "text": "降ってきた(；´Д｀)"},
        { "location": "490/SEL"   , "narrator": "", "text": "濡れてない？"},
        { "location": "491/SEL"   , "narrator": "", "text": "大丈夫？"},
        { "location": "492/SEL"   , "narrator": "", "text": "迎えに行ければいいのに"},
        { "location": "493/ACT"   , "narrator": "", "text": "濡れてない？"},
        { "location": "494/TALK"  , "narrator": "アーヤ", "text": "雨宿り中"},
        { "location": "495/TALK"  , "narrator": "アーヤ", "text": "安心して"},
        { "location": "496/ACT"   , "narrator": "", "text": "大丈夫？"},
        { "location": "497/TALK"  , "narrator": "アーヤ", "text": "大丈夫よ"},
        { "location": "498/TALK"  , "narrator": "アーヤ", "text": "雨宿りしてる"},
        { "location": "499/ACT"   , "narrator": "", "text": "迎えに行ければいいのに"},
        { "location": "500/TALK"  , "narrator": "アーヤ", "text": "ほんとにね"},
        { "location": "502/TALK"  , "narrator": "アーヤ", "text": "そうよね、、、"},
        { "location": "505/TALK"  , "narrator": "アーヤ", "text": "今いるところ"},
        { "location": "506/TALK"  , "narrator": "アーヤ", "text": "無人島なの"},
        { "location": "507/TALK"  , "narrator": "アーヤ", "text": "こんなところで"},
        { "location": "508/TALK"  , "narrator": "アーヤ", "text": "一人で雨宿りしてるの"},
        { "location": "509/TALK"  , "narrator": "アーヤ", "text": "不思議な感じ"},
        { "location": "511/SEL"   , "narrator": "", "text": "$me$がいるでしょ"},
        { "location": "512/SEL"   , "narrator": "", "text": "早く止むといいね"},
        { "location": "513/SEL"   , "narrator": "", "text": "意外と風情があるかも"},
        { "location": "514/ACT"   , "narrator": "", "text": "$me$がいるでしょ"},
        { "location": "516/TALK"  , "narrator": "アーヤ", "text": "いる"},
        { "location": "517/TALK"  , "narrator": "アーヤ", "text": "の？"},
        { "location": "518/ACT"   , "narrator": "", "text": "早く止むといいね"},
        { "location": "519/TALK"  , "narrator": "アーヤ", "text": "流れに任せるのも"},
        { "location": "520/TALK"  , "narrator": "アーヤ", "text": "悪くないわ"},
        { "location": "521/ACT"   , "narrator": "", "text": "意外と風情があるかも"},
        { "location": "522/TALK"  , "narrator": "アーヤ", "text": "そうね"},
        { "location": "524/TALK"  , "narrator": "アーヤ", "text": "こんな景色めったに見れないわ"},
        { "location": "538/TALK"  , "narrator": "アーヤ", "text": "……雨の音しか\n聞こえないわ…。"},
        { "location": "539/TALK"  , "narrator": "アーヤ", "text": "同じ船に乗っていた\n人たちは\nどこにいるのかしら？"},
        { "location": "540/TALK"  , "narrator": "アーヤ", "text": "なんだか\n私だけ取り残された\nみたいな気分…。"},
        { "location": "541/SEL"   , "narrator": "", "text": "ねえアーヤ"},
        { "location": "542/ACT"   , "narrator": "", "text": "ねえアーヤ"},
        { "location": "559/TALK"  , "narrator": "アーヤ", "text": "どうしたの？"},
        { "location": "561/SEL"   , "narrator": "", "text": "もしもこのまま世界が消えたら"},
        { "location": "562/ACT"   , "narrator": "", "text": "もしもこのまま世界が消えたら"},
        { "location": "564/TALK"  , "narrator": "アーヤ", "text": "は？"},
        { "location": "567/SEL"   , "narrator": "", "text": "$me$とアーヤは会えないままだね"},
        { "location": "568/ACT"   , "narrator": "", "text": "$me$とアーヤは会えないままだね"},
        { "location": "570/TALK"  , "narrator": "アーヤ", "text": "何言い出してるの？"},
        { "location": "571/TALK"  , "narrator": "アーヤ", "text": "ちょっと"},
        { "location": "573/SEL"   , "narrator": "", "text": "雨ってそんな気持ちになるよね"},
        { "location": "574/SEL"   , "narrator": "", "text": "脅かしてみたかっただけ"},
        { "location": "575/SEL"   , "narrator": "", "text": "アーヤはそうは思わない？"},
        { "location": "576/ACT"   , "narrator": "", "text": "雨ってそんな気持ちになるよね"},
        { "location": "577/TALK"  , "narrator": "アーヤ", "text": "え"},
        { "location": "578/TALK"  , "narrator": "アーヤ", "text": "ならないし"},
        { "location": "579/ACT"   , "narrator": "", "text": "脅かしてみたかっただけ"},
        { "location": "580/TALK"  , "narrator": "アーヤ", "text": "ちょっと"},
        { "location": "581/TALK"  , "narrator": "アーヤ", "text": "やめて"},
        { "location": "582/ACT"   , "narrator": "", "text": "アーヤはそうは思わない？"},
        { "location": "584/TALK"  , "narrator": "アーヤ", "text": "そんなこと"},
        { "location": "585/TALK"  , "narrator": "アーヤ", "text": "思わないわ"},
        { "location": "588/TALK"  , "narrator": "アーヤ", "text": "それに"},
        { "location": "589/TALK"  , "narrator": "アーヤ", "text": "会える会えない以前に"},
        { "location": "590/TALK"  , "narrator": "アーヤ", "text": "このチャットだって"},
        { "location": "593/SEL"   , "narrator": "", "text": "いつ終わるかわからないし？"},
        { "location": "594/SEL"   , "narrator": "", "text": "アーヤが飽きるかもしれないし？"},
        { "location": "595/SEL"   , "narrator": "", "text": "$me$が実在するかどうか怪しいし？"},
        { "location": "596/ACT"   , "narrator": "", "text": "いつ終わるかわからないし？"},
        { "location": "598/TALK"  , "narrator": "アーヤ", "text": "その通りよ"},
        { "location": "599/TALK"  , "narrator": "アーヤ", "text": "そうでしょ？"},
        { "location": "600/ACT"   , "narrator": "", "text": "アーヤが飽きるかもしれないし？"},
        { "location": "601/TALK"  , "narrator": "アーヤ", "text": "それはないから"},
        { "location": "602/ACT"   , "narrator": "", "text": "$me$が実在するかどうか怪しいし？"},
        { "location": "604/TALK"  , "narrator": "アーヤ", "text": "だって"},
        { "location": "605/TALK"  , "narrator": "アーヤ", "text": "会ったことないもの"},
        { "location": "607/TALK"  , "narrator": "アーヤ", "text": "なんて"},
        { "location": "609/TALK"  , "narrator": "アーヤ", "text": "変な話になっちゃったわ"},
        { "location": "610/TALK"  , "narrator": "アーヤ", "text": "やめやめ！"},
        { "location": "611/TALK"  , "narrator": "アーヤ", "text": "変な話題はやめ！"},
        { "location": "622/TALK"  , "narrator": "アーヤ", "text": "……………………。"},
        { "location": "623/TALK"  , "narrator": "アーヤ", "text": "なんですぐに\n変な感じに\nなっちゃうのかしら…。"},
        { "location": "624/TALK"  , "narrator": "アーヤ", "text": "本当は\n楽しい話が\nしたいのに…。"},
        { "location": "632/TALK"  , "narrator": "アーヤ", "text": "あ！"},
        { "location": "633/TALK"  , "narrator": "アーヤ", "text": "虹！"},
        { "location": "645/TALK"  , "narrator": "アーヤ", "text": "虹よ！"},
        { "location": "648/SEL"   , "narrator": "", "text": "雨の後には虹が出る"},
        { "location": "649/SEL"   , "narrator": "", "text": "海に虹って絵になるね"},
        { "location": "650/SEL"   , "narrator": "", "text": "機嫌直ったみたいでよかった"},
        { "location": "651/ACT"   , "narrator": "", "text": "雨の後には虹が出る"},
        { "location": "652/TALK"  , "narrator": "アーヤ", "text": "そんな歌があったような"},
        { "location": "653/ACT"   , "narrator": "", "text": "海に虹って絵になるね"},
        { "location": "654/TALK"  , "narrator": "アーヤ", "text": "初めて見たわ"},
        { "location": "655/ACT"   , "narrator": "", "text": "機嫌直ったみたいでよかった"},
        { "location": "656/TALK"  , "narrator": "アーヤ", "text": "（ノ ﾟДﾟ）ノ\n　　＝＝＝＝　┻━━┻ "},
        { "location": "658/TALK"  , "narrator": "アーヤ", "text": "すぐ消えちゃうの切ないわ"},
        { "location": "660/SEL"   , "narrator": "", "text": "$me$とアーヤは永遠"},
        { "location": "661/SEL"   , "narrator": "", "text": "また見れるよ"},
        { "location": "662/SEL"   , "narrator": "", "text": "元気でね"},
        { "location": "663/ACT"   , "narrator": "", "text": "$me$とアーヤは永遠"},
        { "location": "664/TALK"  , "narrator": "アーヤ", "text": "また"},
        { "location": "666/TALK"  , "narrator": "アーヤ", "text": "口ばっかり"},
        { "location": "667/TALK"  , "narrator": "アーヤ", "text": "うまいんだから"},
        { "location": "668/ACT"   , "narrator": "", "text": "また見れるよ"},
        { "location": "669/TALK"  , "narrator": "アーヤ", "text": "そうね"},
        { "location": "671/TALK"  , "narrator": "アーヤ", "text": "きっと"},
        { "location": "672/TALK"  , "narrator": "アーヤ", "text": "見られるわ"},
        { "location": "673/ACT"   , "narrator": "", "text": "元気でね"},
        { "location": "674/TALK"  , "narrator": "アーヤ", "text": "ちょっと"},
        { "location": "675/TALK"  , "narrator": "アーヤ", "text": "変な言い方しないで"},
        { "location": "676/TALK"  , "narrator": "アーヤ", "text": "ドキッとしたわ"},
        { "location": "681/TALK"  , "narrator": "アーヤ", "text": "……………………。"},
        { "location": "682/TALK"  , "narrator": "アーヤ", "text": "……うん。"},
        { "location": "683/TALK"  , "narrator": "アーヤ", "text": "やっぱり私から\n言うべきよね。"},
        { "location": "687/TALK"  , "narrator": "アーヤ", "text": "こういうのも"},
        { "location": "689/TALK"  , "narrator": "アーヤ", "text": "隣で見られれば"},
        { "location": "690/TALK"  , "narrator": "アーヤ", "text": "いいのにね"},
        { "location": "695/TALK"  , "narrator": "アーヤ", "text": "……もう。"},
        { "location": "696/TALK"  , "narrator": "アーヤ", "text": "返事もしてこない\nなんて。"},
        { "location": "697/TALK"  , "narrator": "アーヤ", "text": "やっぱり私だけ\n空回りしてるのかな…。"},
        { "location": "712/TALK"  , "narrator": "アーヤ", "text": "雨には降られたけど\nほぼ予定通りね。"},
        { "location": "724/TALK"  , "narrator": "アーヤ", "text": "同じ沿線の駅前って"},
        { "location": "726/TALK"  , "narrator": "アーヤ", "text": "どこでも同じ感じになるの"},
        { "location": "727/TALK"  , "narrator": "アーヤ", "text": "何でなのかしら"},
        { "location": "729/SEL"   , "narrator": "", "text": "気質？"},
        { "location": "730/SEL"   , "narrator": "", "text": "開発計画とかあるから"},
        { "location": "731/SEL"   , "narrator": "", "text": "実は全部同じ駅"},
        { "location": "732/ACT"   , "narrator": "", "text": "気質？"},
        { "location": "733/TALK"  , "narrator": "アーヤ", "text": "わかるような"},
        { "location": "734/TALK"  , "narrator": "アーヤ", "text": "わからないような答えね"},
        { "location": "735/ACT"   , "narrator": "", "text": "開発計画とかあるから"},
        { "location": "736/TALK"  , "narrator": "アーヤ", "text": "確かにね"},
        { "location": "737/TALK"  , "narrator": "アーヤ", "text": "そういうことなら"},
        { "location": "738/TALK"  , "narrator": "アーヤ", "text": "納得だわ"},
        { "location": "739/ACT"   , "narrator": "", "text": "実は全部同じ駅"},
        { "location": "740/TALK"  , "narrator": "アーヤ", "text": "何言ってるの"},
        { "location": "741/TALK"  , "narrator": "アーヤ", "text": "言ってる意味が"},
        { "location": "742/TALK"  , "narrator": "アーヤ", "text": "わからないわ"},
        { "location": "747/TALK"  , "narrator": "アーヤ", "text": "なんて言っても\n昔からある商店街は\nまた雰囲気が違うのね。"},
        { "location": "748/TALK"  , "narrator": "アーヤ", "text": "ちょっと下町？\nぽいっていうか。"},
        { "location": "752/TALK"  , "narrator": "アーヤ", "text": "$handle$さんは"},
        { "location": "753/TALK"  , "narrator": "アーヤ", "text": "下町とか好き？"},
        { "location": "755/SEL"   , "narrator": "", "text": "アーヤが一番好きだよ"},
        { "location": "756/SEL"   , "narrator": "", "text": "住んでるし"},
        { "location": "757/SEL"   , "narrator": "", "text": "行ったことないからわからない"},
        { "location": "758/SEL"   , "narrator": "", "text": "おしゃれなとこの方がいいな"},
        { "location": "759/ACT"   , "narrator": "", "text": "アーヤが一番好きだよ"},
        { "location": "760/TALK"  , "narrator": "アーヤ", "text": "そんな話"},
        { "location": "761/TALK"  , "narrator": "アーヤ", "text": "今してないわ"},
        { "location": "762/ACT"   , "narrator": "", "text": "住んでるし"},
        { "location": "763/TALK"  , "narrator": "アーヤ", "text": "あら"},
        { "location": "764/TALK"  , "narrator": "アーヤ", "text": "そうだったのね"},
        { "location": "765/ACT"   , "narrator": "", "text": "行ったことないからわからない"},
        { "location": "766/TALK"  , "narrator": "アーヤ", "text": "だったら"},
        { "location": "767/TALK"  , "narrator": "アーヤ", "text": "好きも嫌いもないわね"},
        { "location": "768/ACT"   , "narrator": "", "text": "おしゃれなとこの方がいいな"},
        { "location": "769/TALK"  , "narrator": "アーヤ", "text": "そういうところも"},
        { "location": "770/TALK"  , "narrator": "アーヤ", "text": "素敵よね"},
        { "location": "789/TALK"  , "narrator": "アーヤ", "text": "こういうのも\n結構いいかも。"},
        { "location": "790/TALK"  , "narrator": "アーヤ", "text": "あ\nでも……。"},
        { "location": "791/TALK"  , "narrator": "アーヤ", "text": "日が暮れてきたら\nちょっと雰囲気が\n変わったわ……。"},
        { "location": "803/TALK"  , "narrator": "アーヤ", "text": "居酒屋とか"},
        { "location": "804/TALK"  , "narrator": "アーヤ", "text": "夕方からの店が"},
        { "location": "805/TALK"  , "narrator": "アーヤ", "text": "営業始めたら"},
        { "location": "806/TALK"  , "narrator": "アーヤ", "text": "雰囲気が変わったわ"},
        { "location": "807/TALK"  , "narrator": "アーヤ", "text": "このあたり実は夜の街だったりする？"},
        { "location": "809/SEL"   , "narrator": "", "text": "フフフ……。"},
        { "location": "810/SEL"   , "narrator": "", "text": "今すぐここを出るんだ！"},
        { "location": "811/SEL"   , "narrator": "", "text": "飲むの？"},
        { "location": "812/ACT"   , "narrator": "", "text": "フフフ……。"},
        { "location": "813/TALK"  , "narrator": "アーヤ", "text": "意味わからないし"},
        { "location": "814/ACT"   , "narrator": "", "text": "今すぐここを出るんだ！"},
        { "location": "815/TALK"  , "narrator": "アーヤ", "text": "どれだけ物騒なのよ"},
        { "location": "816/ACT"   , "narrator": "", "text": "飲むの？"},
        { "location": "817/TALK"  , "narrator": "アーヤ", "text": "せっかくだからそれもいいかなって思ったけど"},
        { "location": "819/TALK"  , "narrator": "アーヤ", "text": "今日はバイクだから"},
        { "location": "820/TALK"  , "narrator": "アーヤ", "text": "飲めないし(-.-;)"},
        { "location": "822/SEL"   , "narrator": "", "text": "よかった"},
        { "location": "823/SEL"   , "narrator": "", "text": "法律の遵守を期待する"},
        { "location": "824/ACT"   , "narrator": "", "text": "よかった"},
        { "location": "825/TALK"  , "narrator": "アーヤ", "text": "私は残念"},
        { "location": "826/ACT"   , "narrator": "", "text": "法律の遵守を期待する"},
        { "location": "827/TALK"  , "narrator": "アーヤ", "text": "当たり前でしょ"},
        { "location": "828/TALK"  , "narrator": "アーヤ", "text": "そんなの"},
        { "location": "830/TALK"  , "narrator": "アーヤ", "text": "$handle$さんは"},
        { "location": "831/TALK"  , "narrator": "アーヤ", "text": "ちょっと私を"},
        { "location": "832/TALK"  , "narrator": "アーヤ", "text": "束縛しすぎじゃない？"},
        { "location": "833/SEL"   , "narrator": "", "text": "心配だから"},
        { "location": "834/SEL"   , "narrator": "", "text": "彼氏になりたいから"},
        { "location": "835/SEL"   , "narrator": "", "text": "普通だよ"},
        { "location": "836/ACT"   , "narrator": "", "text": "心配だから"},
        { "location": "837/TALK"  , "narrator": "アーヤ", "text": "そんなこと"},
        { "location": "839/TALK"  , "narrator": "アーヤ", "text": "考えすぎよ"},
        { "location": "840/ACT"   , "narrator": "", "text": "彼氏になりたいから"},
        { "location": "841/TALK"  , "narrator": "アーヤ", "text": "いつもそうやって"},
        { "location": "842/TALK"  , "narrator": "アーヤ", "text": "そればっかりね"},
        { "location": "843/ACT"   , "narrator": "", "text": "普通だよ"},
        { "location": "844/TALK"  , "narrator": "アーヤ", "text": "そんなわけないわ"},
        { "location": "857/TALK"  , "narrator": "アーヤ", "text": "なんですぐ\nこうなっちゃうの？"},
        { "location": "858/TALK"  , "narrator": "アーヤ", "text": "なんでこういう時だけ\nそんなこと言うの？"},
        { "location": "859/TALK"  , "narrator": "アーヤ", "text": "あーもう…！"},
        { "location": "861/SEL"   , "narrator": "", "text": "ねえ"},
        { "location": "862/ACT"   , "narrator": "", "text": "ねえ"},
        { "location": "866/SEL"   , "narrator": "", "text": "アーヤ"},
        { "location": "867/ACT"   , "narrator": "", "text": "アーヤ"},
        { "location": "871/SEL"   , "narrator": "", "text": "アーヤったら"},
        { "location": "872/ACT"   , "narrator": "", "text": "アーヤったら"},
        { "location": "877/SEL"   , "narrator": "", "text": "おーい"},
        { "location": "878/ACT"   , "narrator": "", "text": "おーい"},
        { "location": "882/TALK"  , "narrator": "アーヤ", "text": "……。"},
        { "location": "896/TALK"  , "narrator": "アーヤ", "text": "呼んだ？"},
        { "location": "898/SEL"   , "narrator": "", "text": "呼んだ！"},
        { "location": "899/ACT"   , "narrator": "", "text": "呼んだ！"},
        { "location": "901/TALK"  , "narrator": "アーヤ", "text": "何？"},
        { "location": "903/SEL"   , "narrator": "", "text": "仲良くしようよ"},
        { "location": "904/SEL"   , "narrator": "", "text": "喧嘩したくないんだ"},
        { "location": "905/SEL"   , "narrator": "", "text": "$me$はいつも怒らせてばっかりだね"},
        { "location": "906/ACT"   , "narrator": "", "text": "仲良くしようよ"},
        { "location": "908/TALK"  , "narrator": "アーヤ", "text": "したいわよ"},
