        "title": "らぶとーく 第24話",
        "sub_title": "いいこ、いいこ"
    },
    "entry":
    [
        { "location": "317/SCENARIO", "narrator": "", "text": "いいこ、いいこ"},
        { "location": "328/TALK"    , "narrator": "つばめ", "text": "これで明日の準備は\n終わったかな？"},
        { "location": "333/TALK"    , "narrator": "つばめ", "text": "はい。\nどうぞ！"},
        { "location": "340/TALK"    , "narrator": "アーヤ", "text": "遅くにごめんね。\nもう寝るところ？"},
        { "location": "341/TALK"    , "narrator": "つばめ", "text": "あ、いえ。\n大丈夫です。"},
        { "location": "342/TALK"    , "narrator": "アーヤ", "text": "そう。\nよかったわ。"},
        { "location": "343/TALK"    , "narrator": "つばめ", "text": "何もないですが\nゆっくりしていって\nくださいね！"},
        { "location": "345/TALK"    , "narrator": "アーヤ", "text": "……。\nありがとう。"},
        { "location": "346/TALK"    , "narrator": "アーヤ", "text": "ええとね。ちょっと\n聞きたいことが\nあって。"},
        { "location": "347/TALK"    , "narrator": "アーヤ", "text": "つばめはＢｏｔが\n人間だってわかって\n喜んでたでしょ。"},
        { "location": "348/TALK"    , "narrator": "つばめ", "text": "……？"},
        { "location": "349/TALK"    , "narrator": "アーヤ", "text": "今もうれしい？\n普通にチャットとか\nできてる？"},
        { "location": "350/TALK"    , "narrator": "つばめ", "text": "んー……。"},
        { "location": "351/TALK"    , "narrator": "つばめ", "text": "普通というより\nもっと仲良くなった\n感じですよ。"},
        { "location": "353/TALK"    , "narrator": "つばめ", "text": "やっぱり人間の方が\nお話ししてても\n楽しいですし。"},
        { "location": "354/TALK"    , "narrator": "アーヤ", "text": "……そうなのね……。"},
        { "location": "355/TALK"    , "narrator": "つばめ", "text": "アーヤさんは\nそうじゃないん\nですか？"},
        { "location": "357/TALK"    , "narrator": "アーヤ", "text": "……そうね。"},
        { "location": "359/TALK"    , "narrator": "アーヤ", "text": "私はそこまで\nポジティブには\nなれないわ。"},
        { "location": "360/TALK"    , "narrator": "つばめ", "text": "ポジティブって\nことはないと\n思うんですけど…。"},
        { "location": "361/TALK"    , "narrator": "アーヤ", "text": "自覚がないのが\nつばめらしいわね。"},
        { "location": "362/TALK"    , "narrator": "つばめ", "text": "わたしはみんなの\n反応の方が不思議\nなんですけど…。"},
        { "location": "363/TALK"    , "narrator": "つばめ", "text": "決まった話より\nいろんな話が\nしたいですし。"},
        { "location": "364/TALK"    , "narrator": "つばめ", "text": "それに悪い人だった\nわけでもないですし。"},
        { "location": "365/TALK"    , "narrator": "アーヤ", "text": "悪い人じゃ\nない、か…。"},
        { "location": "366/TALK"    , "narrator": "つばめ", "text": "わたし、また\n変なこと\n言いました…？"},
        { "location": "368/TALK"    , "narrator": "アーヤ", "text": "ううん。\nそうじゃないの。"},
        { "location": "369/TALK"    , "narrator": "アーヤ", "text": "つばめは本当に\n素直ねって\n思っただけよ。"},
        { "location": "370/TALK"    , "narrator": "つばめ", "text": "そうなん\nですか？"},
        { "location": "371/SEL"     , "narrator": "", "text": "おーい"},
        { "location": "372/ACT"     , "narrator": "", "text": "おーい"},
        { "location": "376/TALK"    , "narrator": "アーヤ", "text": "ん？"},
        { "location": "390/TALK"    , "narrator": "アーヤ", "text": "ちょっと今は"},
        { "location": "391/TALK"    , "narrator": "アーヤ", "text": "取り込み中"},
        { "location": "392/TALK"    , "narrator": "アーヤ", "text": "また後でね"},
        { "location": "404/TALK"    , "narrator": "アーヤ", "text": "ありがとう。\n参考になったわ。"},
        { "location": "405/TALK"    , "narrator": "つばめ", "text": "はい！"}
    ]
}
