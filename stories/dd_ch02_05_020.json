{
    "dir": "chap05/daydra/dd_ch02_05_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "5252",
        "cid": "ayami",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "校庭"
    },
    "entry":
    [
        { "location": "307/SCENARIO", "narrator": "", "text": "校庭"},
        { "location": "319/TALK"    , "narrator": "ガブリエラ", "text": "アーヤ？\nまさかもう帰るつもり？"},
        { "location": "321/TALK"    , "narrator": "アーヤ", "text": "うん。今日の講義は\n午前だけだったから――"},
        { "location": "322/TALK"    , "narrator": "アーヤ", "text": "どこかでランチでも\n食べて、先に帰ってるわ。"},
        { "location": "323/TALK"    , "narrator": "ガブリエラ", "text": "まったく、何がランチよ。\n大学生は気楽でいいわね。"},
        { "location": "325/TALK"    , "narrator": "ガブリエラ", "text": "こっちはまだまだ\n授業があるのに…。"},
        { "location": "326/TALK"    , "narrator": "アーヤ", "text": "あのね、そんなわけ…。"},
        { "location": "327/SEL"     , "narrator": "", "text": "アーヤも昔は中学生だった"},
        { "location": "328/SEL"     , "narrator": "", "text": "言わせとけ"},
        { "location": "329/SEL"     , "narrator": "", "text": "うんと羨ましがらせろ"},
        { "location": "333/TALK"    , "narrator": "アーヤ", "text": "って、何言ったところで\n無駄よね。"},
        { "location": "334/TALK"    , "narrator": "アーヤ", "text": "実際に大学生の辛さを\n経験したことがないと、\nわからないことだし。"},
        { "location": "337/TALK"    , "narrator": "アーヤ", "text": "ていうかランチの時間が\n始まっちゃうから、\nそろそろ行かないと。"},
        { "location": "339/TALK"    , "narrator": "アーヤ", "text": "ギャヴィ、悪いけど\nそろそろ――"},
        { "location": "340/TALK"    , "narrator": "アーヤ", "text": "ランチタイムは\n混むから、早めに\n行きたいのよ。"},
        { "location": "341/TALK"    , "narrator": "ガブリエラ", "text": "何よ、\n言い返すくらいの\n時間もないの？"},
        { "location": "342/TALK"    , "narrator": "アーヤ", "text": "ないわ。\nそれじゃ、劇場でね。"},
        { "location": "346/TALK"    , "narrator": "ガブリエラ", "text": "…本当、気楽そうで\nうらやましいわ。"},
        { "location": "348/ACT"     , "narrator": "", "text": "アーヤも昔は中学生だった"},
        { "location": "352/TALK"    , "narrator": "アーヤ", "text": "メール？\nちょっと待って。"},
        { "location": "367/TALK"    , "narrator": "アーヤ", "text": "そっか"},
        { "location": "368/TALK"    , "narrator": "アーヤ", "text": "それ言えばわかってもらえるかも"},
        { "location": "369/TALK"    , "narrator": "アーヤ", "text": "早速言ってみるわ(*^-ﾟ)v"},
        { "location": "381/TALK"    , "narrator": "アーヤ", "text": "…大丈夫よ、ギャヴィ。"},
        { "location": "382/TALK"    , "narrator": "アーヤ", "text": "私だって中学、高校と\n経験して大学生になったん\nだから。"},
        { "location": "384/TALK"    , "narrator": "ガブリエラ", "text": "そ、そんなの\nわかってるわよ…。"},
        { "location": "385/TALK"    , "narrator": "アーヤ", "text": "なら、羨ましがらなくても\nあんただって中学、高校を\n卒業すれば――"},
        { "location": "386/TALK"    , "narrator": "アーヤ", "text": "大学生になれる、って\nいうのもわかるでしょ？"},
        { "location": "388/TALK"    , "narrator": "ガブリエラ", "text": "…飛び級さえあれば、\nこんな思いしなくても\nすむのに。"},
        { "location": "389/TALK"    , "narrator": "アーヤ", "text": "日本にはないんだから、\n諦めなさい。"},
        { "location": "391/TALK"    , "narrator": "アーヤ", "text": "とはいえ…外国生まれの\nギャヴィにとっては、\n窮屈なのも仕方ないわね。"},
        { "location": "393/TALK"    , "narrator": "アーヤ", "text": "そう考えると、ちょっと\nかわいそうかも…。"},
        { "location": "394/ACT"     , "narrator": "", "text": "言わせとけ"},
        { "location": "398/TALK"    , "narrator": "アーヤ", "text": "あ、ちょっと待って。\nメールみたいだから。"},
        { "location": "413/TALK"    , "narrator": "アーヤ", "text": "確かに"},
        { "location": "414/TALK"    , "narrator": "アーヤ", "text": "それが一番手っ取り早そう"},
        { "location": "415/TALK"    , "narrator": "アーヤ", "text": "疲れそうだけど(；-_-) =3"},
        { "location": "428/TALK"    , "narrator": "アーヤ", "text": "…話の途中で悪かったわ。\nで、なんの話だっけ？"},
        { "location": "429/TALK"    , "narrator": "ガブリエラ", "text": "アーヤは気楽で良いわね、\nって話よ。"},
        { "location": "430/TALK"    , "narrator": "ガブリエラ", "text": "ていうか、社会に出る\n直前の学生が――"},
        { "location": "431/TALK"    , "narrator": "ガブリエラ", "text": "毎日遊び半分で学生生活\n送ってるって問題だと\n思わない？"},
        { "location": "432/TALK"    , "narrator": "ガブリエラ", "text": "中学、高校のあたし達が\n必死で夕方まで勉強して\nるっていうのに――"},
        { "location": "433/TALK"    , "narrator": "ガブリエラ", "text": "大学生は午前だけだの\n休講だのと、普通は\n逆じゃないの？"},
        { "location": "435/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "437/TALK"    , "narrator": "ガブリエラ", "text": "あっ…ちょっと言い過ぎた\nかしら？"},
        { "location": "439/TALK"    , "narrator": "アーヤ", "text": "はぁ…気は済んだ？"},
        { "location": "441/TALK"    , "narrator": "ガブリエラ", "text": "な、なによそれ！？"},
        { "location": "442/TALK"    , "narrator": "アーヤ", "text": "まあ、貴方みたいな\n考え方をする人って、\n時々いるから――"},
        { "location": "443/TALK"    , "narrator": "アーヤ", "text": "ギャヴィも大学生に\nなれば、一度は言われる\nことになるはずよ。"},
        { "location": "445/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "446/TALK"    , "narrator": "アーヤ", "text": "その時は今のように、\n落ち着いて対応できると\nいいわね。"},
        { "location": "448/TALK"    , "narrator": "ガブリエラ", "text": "う、うるさい！\n大きなお世話よ…。"},
        { "location": "450/TALK"    , "narrator": "ガブリエラ", "text": "ていうか、なんか\n大学生ってストレス\n溜まりそうだから――"},
        { "location": "452/TALK"    , "narrator": "ガブリエラ", "text": "もうしばらくは\n中学生でいいわ…。"},
        { "location": "453/ACT"     , "narrator": "", "text": "うんと羨ましがらせろ"},
        { "location": "466/TALK"    , "narrator": "アーヤ", "text": "あ、メールみたい。\nちょっと待って。"},
        { "location": "481/TALK"    , "narrator": "アーヤ", "text": "それ、面白そう！"},
        { "location": "482/TALK"    , "narrator": "アーヤ", "text": "羨ましがられそうなことなら沢山あるから"},
        { "location": "483/TALK"    , "narrator": "アーヤ", "text": "この際、うんと言っちゃう！"},
        { "location": "495/TALK"    , "narrator": "アーヤ", "text": "…ええ、そうよ。\nその通り！"},
        { "location": "497/TALK"    , "narrator": "ガブリエラ", "text": "は！？"},
        { "location": "498/TALK"    , "narrator": "アーヤ", "text": "中学高校に比べたら、\n大学生活って本当に\n楽しくて堪らないわ。"},
        { "location": "499/TALK"    , "narrator": "アーヤ", "text": "午前だけの時もあるし、\n午後に１講だけの\nこともあるし――"},
        { "location": "500/TALK"    , "narrator": "アーヤ", "text": "休講もあれば、出席だけ\nしてれば良いだけの\nものもあったりするし。"},
        { "location": "502/TALK"    , "narrator": "アーヤ", "text": "レポートさえ提出すれ\nば出席しなくてＯＫ\nなんて講義もあるもの。"},
        { "location": "503/TALK"    , "narrator": "アーヤ", "text": "本当、大学生活って\n最高よ！"},
        { "location": "506/TALK"    , "narrator": "ガブリエラ", "text": "ぐっ、ぐぬぬぬぬ…！"},
        { "location": "507/TALK"    , "narrator": "アーヤ", "text": "あっ…。"},
        { "location": "510/TALK"    , "narrator": "アーヤ", "text": "しまった！\nちょっと\n言い過ぎたかも！"},
        { "location": "515/TALK"    , "narrator": "ガブリエラ", "text": "ああ、もう！\nどうして日本には飛び級\n制度がないのよ！？"},
        { "location": "516/TALK"    , "narrator": "ガブリエラ", "text": "ポーランドにいたら、\n今頃とっくに大学に\n入学できてたのに！"},
        { "location": "517/TALK"    , "narrator": "アーヤ", "text": "…やっぱり、\nちょっとだけ\n言い過ぎたみたい。"},
        { "location": "518/TALK"    , "narrator": "アーヤ", "text": "本気で気楽にやってると\n思われたら嫌だなぁ…。"},
        { "location": "316/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>5月11日　11:42 AM</color>\nとある日の昼頃、\n附属学園校門にて。"},
        { "location": "459/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"}
    ]
}
