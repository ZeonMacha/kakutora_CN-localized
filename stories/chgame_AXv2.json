    "entry":
    [
        { "location": "1518/SCENARIO", "narrator": "", "text": "AX強い敵（死ぬ） アーヤ"},
        { "location": "1530/TALK"    , "narrator": "千羽鶴", "text": "ここに何が出てきたか\n覚えてる人。"},
        { "location": "1531/SEL"     , "narrator": "", "text": "イカズゴケアーヤ"},
        { "location": "1532/SEL"     , "narrator": "", "text": "わかりません＞＜"},
        { "location": "1533/ACT"     , "narrator": "", "text": "イカズゴケアーヤ"},
        { "location": "1534/TALK"    , "narrator": "千羽鶴", "text": "正解！"},
        { "location": "1535/ACT"     , "narrator": "", "text": "わかりません＞＜"},
        { "location": "1536/TALK"    , "narrator": "千羽鶴", "text": "國政綾水に対して\nプラトニックなのね。"},
        { "location": "1538/TALK"    , "narrator": "千羽鶴", "text": "もちろん、國政綾水の\nイカズゴケ設定は、\n本来の意味では無い。"},
        { "location": "1539/TALK"    , "narrator": "千羽鶴", "text": "彼女の慎重すぎる性格と、\nそれに関連する\n姉との関係を描いたもの。"},
        { "location": "1540/TALK"    , "narrator": "千羽鶴", "text": "慎重さは長所ではあるけど\n得られるチャンスを\n逃すリスクもある。"},
        { "location": "1541/TALK"    , "narrator": "千羽鶴", "text": "彼女はその傾向が\n顕著に見られるから、\nそれをキャラにしてみた。"}
    ]
}
