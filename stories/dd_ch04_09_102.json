{
    "dir": "chap09/daydra/dd_ch04_09_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "9405",
        "cid": "miyabi",
        "title": "005 メインストーリー",
        "sub_title": "コイガサキの日常＜後編＞"
    },
    "entry":
    [
        { "location": "371/SCENARIO", "narrator": "", "text": "コイガサキの日常"},
        { "location": "386/TALK"    , "narrator": "みやび", "text": "結局授業に出ることに\nしてもうたけんど…。"},
        { "location": "389/TALK"    , "narrator": "女子高校生Ａ", "text": "…あ、あの！\n恋ヶ崎さん…。"},
        { "location": "392/TALK"    , "narrator": "みやび", "text": "ん？　どうしたが？"},
        { "location": "393/TALK"    , "narrator": "女子高校生Ａ", "text": "あ、ううん。\n大したことじゃないん\nだけど――"},
        { "location": "394/TALK"    , "narrator": "女子高校生Ａ", "text": "今日は恋ヶ崎さんが\nいてくれて、\nよかったな、って…。"},
        { "location": "395/TALK"    , "narrator": "みやび", "text": "…うち、そんなに\nサボっちょるわけや\nないけんど？"},
        { "location": "396/TALK"    , "narrator": "女子高校生Ａ", "text": "そ、そうじゃないの。\n出動がなくてよかった\nってことよ。"},
        { "location": "398/TALK"    , "narrator": "女子高校生Ａ", "text": "ほら、今日の課題は\n二人ペアになって顔を\n描くってのだから――"},
        { "location": "399/TALK"    , "narrator": "女子高校生Ａ", "text": "もしいなかったら、\nまた私だけ、相手が\nいなくて困ってたかも。"},
        { "location": "401/TALK"    , "narrator": "みやび", "text": "うむ、うちもそれを\n気にしちょったぞね。"},
        { "location": "404/TALK"    , "narrator": "みやび", "text": "そんなことで美術の点数\n悪くされたら、うちも\n後味わるいしね。"},
        { "location": "405/TALK"    , "narrator": "女子高校生Ａ", "text": "あはは、\nさすがにそんな事には\nならないと思うけど――"},
        { "location": "406/TALK"    , "narrator": "女子高校生Ａ", "text": "とにかく、いてくれて\n嬉しいってこと。\nほら、描いちゃお。"},
        { "location": "407/TALK"    , "narrator": "みやび", "text": "ん…"},
        { "location": "408/TALK"    , "narrator": "みやび", "text": "…………まあ。"},
        { "location": "409/TALK"    , "narrator": "みやび", "text": "予想通り、\n結果オーライっちゅう\nことやね。"},
        { "location": "425/TALK"    , "narrator": "女子高校生Ａ", "text": "…………。"},
        { "location": "426/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "427/TALK"    , "narrator": "女子高校生Ａ", "text": "そういえばさ、\n気になってたことが\nあるんだけど。"},
        { "location": "428/TALK"    , "narrator": "みやび", "text": "好きな食べ物は\n洋菓子や。"},
        { "location": "429/TALK"    , "narrator": "女子高校生Ａ", "text": "そうじゃなくて…、\nほら、さっきの話に\n少し戻るけど――"},
        { "location": "430/TALK"    , "narrator": "女子高校生Ａ", "text": "恋ヶ崎さんって、\n時々出動以外でも\nいない時あるでしょ？"},
        { "location": "431/TALK"    , "narrator": "女子高校生Ａ", "text": "あれって、やっぱり\nサボり？"},
        { "location": "432/TALK"    , "narrator": "みやび", "text": "んー…まあ、そういう\nことやね。"},
        { "location": "433/TALK"    , "narrator": "女子高校生Ａ", "text": "そうなんだ…。\nでも、サボって\nどこか行くの？"},
        { "location": "434/TALK"    , "narrator": "女子高校生Ａ", "text": "まさか、溜まり場に\n行くようなタイプには\n見えないし。"},
        { "location": "435/TALK"    , "narrator": "みやび", "text": "そういうタイプや\nないきね…。"},
        { "location": "437/TALK"    , "narrator": "女子高校生Ａ", "text": "それじゃあ、\nサボッてどこに\n行くの？"},
        { "location": "438/TALK"    , "narrator": "みやび", "text": "溜まり場じゃない、\n静かなとこやね。"},
        { "location": "439/TALK"    , "narrator": "女子高校生Ａ", "text": "そ、そっか…。"},
        { "location": "440/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "441/TALK"    , "narrator": "女子高校生Ａ", "text": "…………。"},
        { "location": "442/TALK"    , "narrator": "女子高校生Ａ", "text": "…ふふっ、わかった。\n恋ヶ崎さんが\n行くとこって――"},
        { "location": "444/TALK"    , "narrator": "女子高校生Ａ", "text": "ズバリ、\n彼氏の家でしょ？"},
        { "location": "445/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "446/TALK"    , "narrator": "女子高校生Ａ", "text": "…………。"},
        { "location": "447/TALK"    , "narrator": "みやび", "text": "んー…彼氏なぁ…。"},
        { "location": "449/TALK"    , "narrator": "みやび", "text": "…うちが彼氏の\n家に行くと思っちゅう\nんは――"},
        { "location": "450/TALK"    , "narrator": "みやび", "text": "つまり、うちが男に\n興味がある思うてる\nからか？"},
        { "location": "452/TALK"    , "narrator": "女子高校生Ａ", "text": "え？"},
        { "location": "454/TALK"    , "narrator": "みやび", "text": "いや…男よりも女に\n興味があるっちゅう\n可能性もあるやろ？"},
        { "location": "455/TALK"    , "narrator": "女子高校生Ａ", "text": "えっ！？"},
        { "location": "457/TALK"    , "narrator": "みやび", "text": "ほれ、早く描かんと\nいつまでも終わらん\nがよ。"},
        { "location": "459/TALK"    , "narrator": "女子高校生Ａ", "text": "え、あ、ああ…、\nそう、だね…。"},
        { "location": "461/TALK"    , "narrator": "女子高校生Ａ", "text": "…………。"},
        { "location": "463/TALK"    , "narrator": "みやび", "text": "…うちを慌てさせよう\n思うて言うたようや\nけんど――"},
        { "location": "464/TALK"    , "narrator": "みやび", "text": "まだまだ甘いなぁ。"},
        { "location": "480/TALK"    , "narrator": "みやび", "text": "ふぅ…ただいま。"},
        { "location": "481/TALK"    , "narrator": "みやび", "text": "…とりあえず、\n汗流すか。"},
        { "location": "499/TALK"    , "narrator": "みやび", "text": "ふぅ…。"},
        { "location": "500/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "502/TALK"    , "narrator": "みやび", "text": "一息ついたら、\n夕飯作るん面倒に\nなってきたな…。"},
        { "location": "503/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "505/TALK"    , "narrator": "みやび", "text": "夕飯は外でラーメン。\n自炊は実家に帰りまし\nた、と…。"},
        { "location": "506/TALK"    , "narrator": "みやび", "text": "…ちゃっちゃと\n着替えて食いに\n行くか。"},
        { "location": "507/SEL"     , "narrator": "", "text": "今度は本当なんだ？"},
        { "location": "508/ACT"     , "narrator": "", "text": "今度は本当なんだ？"},
        { "location": "528/TALK"    , "narrator": "みやび", "text": "そこツッコミいるか？"},
        { "location": "529/TALK"    , "narrator": "みやび", "text": "ネット上の呟きで"},
        { "location": "530/TALK"    , "narrator": "みやび", "text": "本当のことだけ書いてるやつなんぞ"},
        { "location": "531/TALK"    , "narrator": "みやび", "text": "果たしてどれだけいるのか？"},
        { "location": "532/TALK"    , "narrator": "みやび", "text": "適当言って"},
        { "location": "533/TALK"    , "narrator": "みやび", "text": "キャラ作るんは当然のこと"},
        { "location": "535/TALK"    , "narrator": "みやび", "text": "純粋な相棒に"},
        { "location": "537/TALK"    , "narrator": "みやび", "text": "ネットの世界は危険かもしれんぞ"},
        { "location": "558/DIALOG"  , "narrator": "Dialog_chapter_ch04", "text": "【07 愛，ロボット】"}
    ]
}
