{
    "dir": "chap13/daydra/dd_ch01_13_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "13105",
        "cid": "tsubame",
        "title": "005 メインストーリー",
        "sub_title": "魔法少女道＜後編＞"
    },
    "entry":
    [
        { "location": "653/SCENARIO", "narrator": "", "text": "魔法少女道"},
        { "location": "674/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "675/TALK"    , "narrator": "つばめ", "text": "輝き流れる、\n永遠のミード…\nだっけ？"},
        { "location": "677/TALK"    , "narrator": "神楽", "text": "はい。\nミルクティーの\n決め台詞ですね。"},
        { "location": "679/TALK"    , "narrator": "つばめ", "text": "うーん…。"},
        { "location": "680/TALK"    , "narrator": "つばめ", "text": "わたし、メルティ\nやってもいいかな？"},
        { "location": "681/TALK"    , "narrator": "神楽", "text": "え――"},
        { "location": "684/TALK"    , "narrator": "神楽", "text": "えぇっ！？\nほ、本当ですか！？"},
        { "location": "687/TALK"    , "narrator": "つばめ", "text": "うん。"},
        { "location": "688/TALK"    , "narrator": "つばめ", "text": "アーヤさん達も、\nあんまりやりたくない\nみたいだし。"},
        { "location": "689/TALK"    , "narrator": "つばめ", "text": "それなら、わたしと\n卯月さんでやれば\nいいんじゃないかな？"},
        { "location": "690/TALK"    , "narrator": "神楽", "text": "で、でも、\n本当にいいんですか？"},
        { "location": "691/TALK"    , "narrator": "神楽", "text": "皆さんは恥ずかしくて\n嫌がってるのに…。"},
        { "location": "694/TALK"    , "narrator": "つばめ", "text": "そ、それはまあ、\n恥ずかしいことは\n恥ずかしいけど……。"},
        { "location": "695/TALK"    , "narrator": "つばめ", "text": "誰かがやらないと\nいけないことでしょ？"},
        { "location": "697/TALK"    , "narrator": "つばめ", "text": "それに、卯月さんと\n一緒なら平気だと思うし。"},
        { "location": "698/TALK"    , "narrator": "神楽", "text": "つばめさん…。"},
        { "location": "700/TALK"    , "narrator": "神楽", "text": "…なら、到着するまで\n特訓しましょう。"},
        { "location": "702/TALK"    , "narrator": "つばめ", "text": "え、特訓？"},
        { "location": "703/TALK"    , "narrator": "神楽", "text": "メルティのポーズは\n意外と難しいんですよ？"},
        { "location": "704/TALK"    , "narrator": "神楽", "text": "車の中なので動きには\n限界がありますけど、\nできる限り指導します！"},
        { "location": "705/TALK"    , "narrator": "つばめ", "text": "せ、セリフだけで\nいいんじゃ…。"},
        { "location": "706/TALK"    , "narrator": "神楽", "text": "そんなのダメです！"},
        { "location": "707/TALK"    , "narrator": "神楽", "text": "せっかくつばめさんと\nメルティをやれる\n機会なんですから――"},
        { "location": "708/TALK"    , "narrator": "神楽", "text": "完璧で可愛い\nつばめさんを\n見たいんです！"},
        { "location": "710/TALK"    , "narrator": "神楽", "text": "さあ、まずは\n上半身の動きから\n説明しますね！"},
        { "location": "712/TALK"    , "narrator": "つばめ", "text": "えぇーっ！？"},
        { "location": "719/TALK"    , "narrator": "つばめ", "text": "はぁ、はぁ…。\nど、どうかな？"},
        { "location": "721/TALK"    , "narrator": "神楽", "text": "そう、そうです！\nそのポーズです！"},
        { "location": "722/TALK"    , "narrator": "神楽", "text": "かっこよさと可愛さが\n見事に合わさったその\nポーズこそがミルクです！"},
        { "location": "724/TALK"    , "narrator": "つばめ", "text": "…メルティになるの\nって、大変なんだね。"},
        { "location": "726/TALK"    , "narrator": "神楽", "text": "本当によかったです。\n到着までに完璧に\n仕上げられて。"},
        { "location": "731/TALK"    , "narrator": "神楽", "text": "さあ、つばめさん。\n急ぎましょう。"},
        { "location": "732/TALK"    , "narrator": "神楽", "text": "アーヤさん達に\n先を越されちゃい\nますよ！"},
        { "location": "735/TALK"    , "narrator": "つばめ", "text": "あ、待ってよ\n卯月さーん！"},
        { "location": "746/DIALOG"  , "narrator": "Dialog_chapter_ch01", "text": "【MV EXE_AYAMi】"}
    ]
}
