    "entry":
    [
        { "location": "8/SCENARIO", "narrator": "", "text": "魔法少女道"},
        { "location": "43/TALK"   , "narrator": "つばめ", "text": "す、すみません！\n遅くなりました！"},
        { "location": "45/TALK"   , "narrator": "神楽", "text": "真幌さん、\n他の皆さんは？"},
        { "location": "47/TALK"   , "narrator": "真幌", "text": "既に出発して、\nそろそろ現場に\n到着する頃だ。"},
        { "location": "48/TALK"   , "narrator": "真幌", "text": "表に迎えの車が\n来ているはずだ。"},
        { "location": "49/TALK"   , "narrator": "真幌", "text": "二人とも、至急現場に\n向かってくれ。"},
        { "location": "51/TALK"   , "narrator": "つばめ", "text": "は、はい！"},
        { "location": "53/TALK"   , "narrator": "神楽", "text": "了解です！"},
        { "location": "85/TALK"   , "narrator": "つばめ", "text": "…アーヤさん達、\n大丈夫かな？"},
        { "location": "87/TALK"   , "narrator": "神楽", "text": "大丈夫ですよ。\n皆さん、とっても\n強いですから。"},
        { "location": "89/TALK"   , "narrator": "神楽", "text": "心配なら、通信だけ\n繋げておきましょう。"},
        { "location": "93/TALK"   , "narrator": "透明真幌", "text": "解析の結果が出た。\nクリア条件を教える。"},
        { "location": "94/TALK"   , "narrator": "透明みやび", "text": "まほさん、\nナイスタイミングや！"},
        { "location": "95/TALK"   , "narrator": "透明アーヤ", "text": "それで、\nクリア条件は？"},
        { "location": "96/TALK"   , "narrator": "透明真幌", "text": "アップルティメルティと\nミルクティメルティーだ。"},
        { "location": "98/TALK"   , "narrator": "つばめ", "text": "…メルティ？\n何のことかな？"},
        { "location": "100/TALK"  , "narrator": "神楽", "text": "ちょ、まさか！！"},
        { "location": "101/TALK"  , "narrator": "透明真幌", "text": "その世界は、アニメの\n世界が元になっている\nようだ。"},
        { "location": "102/TALK"  , "narrator": "透明真幌", "text": "えーっと…魔法少女、\nトリプルメルティーズ？"},
        { "location": "103/TALK"  , "narrator": "透明真幌", "text": "…そういうことだ。"},
        { "location": "104/TALK"  , "narrator": "神楽", "text": "あああっ！！\nやっぱり！！"},
        { "location": "107/TALK"  , "narrator": "つばめ", "text": "ど、どうしたの\n卯月さん？"},
        { "location": "110/TALK"  , "narrator": "神楽", "text": "アニメです！\nトリプルメルティーズ\nですよ！"},
        { "location": "111/TALK"  , "narrator": "神楽", "text": "つばめさんは\n知らないんですか？"},
        { "location": "113/TALK"  , "narrator": "つばめ", "text": "う、うん…。\nそんなアニメが\nあるんだね？"},
        { "location": "115/TALK"  , "narrator": "つばめ", "text": "でも、それが今回の\nフェノメノンと、\nどんな関係が？"},
        { "location": "116/TALK"  , "narrator": "透明真幌", "text": "つまりだな、その\nスウィーティ―って奴には\n２人の仲間がいるらしい。"},
        { "location": "117/TALK"  , "narrator": "透明真幌", "text": "アップルティーと\nミルクティーという\nヤツがな。"},
        { "location": "118/TALK"  , "narrator": "透明真幌", "text": "なので、おまえ達が\nその二人になって、共に\n敵を倒すことになるな。"},
        { "location": "119/TALK"  , "narrator": "透明真幌", "text": "スウィーティ―って\nヤツと一緒に、\nその怪物を討て。"},
        { "location": "120/TALK"  , "narrator": "透明アーヤ", "text": "…まさか、それが\nクリア条件ですか？"},
        { "location": "121/TALK"  , "narrator": "透明真幌", "text": "そういうことだ。"},
        { "location": "123/TALK"  , "narrator": "神楽", "text": "やっぱり！"},
        { "location": "124/TALK"  , "narrator": "透明みやび", "text": "…で？\n誰がやるがよ？"},
        { "location": "125/TALK"  , "narrator": "透明ガブリエラ", "text": "私パス。\nアーヤとみやびで\nやりなさいよ。"},
        { "location": "126/TALK"  , "narrator": "透明みやび", "text": "グリーンティー\nメルティがいるなら\nえいんやけんど。"},
        { "location": "127/TALK"  , "narrator": "透明みやび", "text": "アップルティ―と\nミルクティ―はパスや。"},
        { "location": "128/TALK"  , "narrator": "透明アーヤ", "text": "グリーンティー\nなんているの？"},
        { "location": "129/TALK"  , "narrator": "透明みやび", "text": "知らんけんど、\nうちは緑茶好きやきね。"},
        { "location": "130/TALK"  , "narrator": "透明ガブリエラ", "text": "お茶の好みの話を\nしてるんじゃない\nでしょ！？"},
        { "location": "131/TALK"  , "narrator": "つばめ", "text": "…な、なんか、\nすごい揉めてる\nみたいだね。"},
        { "location": "133/TALK"  , "narrator": "神楽", "text": "悔しいです。\n私とつばめさんが\nいれば――"},
        { "location": "134/TALK"  , "narrator": "神楽", "text": "今回はあっという間に\n収束できたのに…。"},
        { "location": "136/TALK"  , "narrator": "つばめ", "text": "そうなのかなぁ？\nわたし、そのアニメ\n全然知らないんだけど…。"},
        { "location": "138/TALK"  , "narrator": "神楽", "text": "大人気の王道\n魔法少女アニメ\nですよ！？"},
        { "location": "140/TALK"  , "narrator": "神楽", "text": "輝き流れる永遠の\nミード、ミルクティー\nメルティ！！"},
        { "location": "141/TALK"  , "narrator": "神楽", "text": "甘くて苦い禁断の\n果実、アップルティ―\nメルティ！！"},
        { "location": "143/TALK"  , "narrator": "神楽", "text": "と、これが二人の\n決め台詞です。"},
        { "location": "146/TALK"  , "narrator": "つばめ", "text": "えぇっ！？"},
        { "location": "147/TALK"  , "narrator": "つばめ", "text": "じゃ、じゃあ、\nその二人になるって\nことは、その決め台詞も…"},
        { "location": "148/TALK"  , "narrator": "神楽", "text": "当然です！\n決め台詞ですから。"},
        { "location": "151/TALK"  , "narrator": "つばめ", "text": "で、でも、わたしも\nそれを言うのは\nちょっと…。"},
        { "location": "152/TALK"  , "narrator": "神楽", "text": "大丈夫ですよ。\nつばめさんなら、\nきっとできます！"},
        { "location": "153/TALK"  , "narrator": "神楽", "text": "だから、\n一緒にメルティ\nやりましょう！"},
        { "location": "154/TALK"  , "narrator": "神楽", "text": "運転手さん、\n現場まで急いで\nください！"},
        { "location": "156/TALK"  , "narrator": "つばめ", "text": "め、メルティかぁ…。\n輝き流れる永遠の\nミード…。"},
        { "location": "158/TALK"  , "narrator": "つばめ", "text": "う～ん…。"},
        { "location": "159/SEL"   , "narrator": "", "text": "やりたくないの？"},
        { "location": "160/ACT"   , "narrator": "", "text": "やりたくないの？"},
        { "location": "177/TALK"  , "narrator": "つばめ", "text": "ぅぅん"},
        { "location": "178/TALK"  , "narrator": "つばめ", "text": "そぅぃぅことじゃなぃの(･Д･｀)"},
        { "location": "179/TALK"  , "narrator": "つばめ", "text": "でも"},
        { "location": "180/TALK"  , "narrator": "つばめ", "text": "恥ずかしぃ(/ω＼)"},
        { "location": "182/TALK"  , "narrator": "つばめ", "text": "卯月さんの言ってたセリフ"},
        { "location": "183/TALK"  , "narrator": "つばめ", "text": "実際に言ぅなんて(●ﾉωﾉ)"},
        { "location": "185/SEL"   , "narrator": "", "text": "やりたくないように聞こえる"},
        { "location": "186/ACT"   , "narrator": "", "text": "やりたくないように聞こえる"},
        { "location": "188/TALK"  , "narrator": "つばめ", "text": "本当にそぅじゃなぃの"},
        { "location": "189/TALK"  , "narrator": "つばめ", "text": "卯月さんとなら"},
        { "location": "190/TALK"  , "narrator": "つばめ", "text": "やってみたぃ気もするし(*´ω｀*)"},
        { "location": "191/TALK"  , "narrator": "つばめ", "text": "でも"},
        { "location": "192/TALK"  , "narrator": "つばめ", "text": "どうしても恥ずかしくてヾ(｡>﹏<｡)ﾉﾞ"},
        { "location": "193/TALK"  , "narrator": "つばめ", "text": "上手くやれる自信なぃし(o´Д`)=з"},
        { "location": "194/TALK"  , "narrator": "つばめ", "text": "ぅ～ん"},
        { "location": "240/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "241/SEL"   , "narrator": "", "text": "どうしたの？"},
        { "location": "242/ACT"   , "narrator": "", "text": "どうしたの？"},
        { "location": "246/TALK"  , "narrator": "つばめ", "text": "あ、いえ、\nなんでもないんです！"},
        { "location": "247/SEL"   , "narrator": "", "text": "なんか、元気ない？"},
        { "location": "248/SEL"   , "narrator": "", "text": "有給休暇はどうだった？"},
        { "location": "249/ACT"   , "narrator": "", "text": "なんか、元気ない？"},
        { "location": "251/TALK"  , "narrator": "つばめ", "text": "え？\nそんなことありませんよ？"},
        { "location": "252/ACT"   , "narrator": "", "text": "有給休暇はどうだった？"},
        { "location": "254/TALK"  , "narrator": "つばめ", "text": "え？\nあ、お陰様で\nやることはやれました。"},
        { "location": "256/TALK"  , "narrator": "つばめ", "text": "そ、それより\n今回もまた悩みが\n出ちゃった感じですよね。"},
        { "location": "257/TALK"  , "narrator": "つばめ", "text": "早速扉を\n回しますね。"},
        { "location": "261/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "262/SEL"   , "narrator": "", "text": "え、どうしたの？怖い顔して"},
        { "location": "263/ACT"   , "narrator": "", "text": "え、どうしたの？怖い顔して"},
        { "location": "265/TALK"  , "narrator": "つばめ", "text": "どうして\n見ちゃったんですか？"},
        { "location": "269/SEL"   , "narrator": "", "text": "おなか出ちゃってること？"},
        { "location": "270/SEL"   , "narrator": "", "text": "実はエッチな子だったこと？"},
        { "location": "271/SEL"   , "narrator": "", "text": "千羽鶴のこと？"},
        { "location": "272/ACT"   , "narrator": "", "text": "おなか出ちゃってること？"},
        { "location": "274/ACT"   , "narrator": "", "text": "実はエッチな子だったこと？"},
        { "location": "276/ACT"   , "narrator": "", "text": "千羽鶴のこと？"},
        { "location": "286/SEL"   , "narrator": "", "text": "実はエッチな子だったこと？"},
        { "location": "287/SEL"   , "narrator": "", "text": "千羽鶴のこと？"},
        { "location": "288/ACT"   , "narrator": "", "text": "実はエッチな子だったこと？"},
        { "location": "290/ACT"   , "narrator": "", "text": "千羽鶴のこと？"},
        { "location": "300/SEL"   , "narrator": "", "text": "おなか出ちゃってること？"},
        { "location": "301/SEL"   , "narrator": "", "text": "千羽鶴のこと？"},
        { "location": "302/ACT"   , "narrator": "", "text": "おなか出ちゃってること？"},
        { "location": "304/ACT"   , "narrator": "", "text": "千羽鶴のこと？"},
        { "location": "314/SEL"   , "narrator": "", "text": "おなか出ちゃってること？"},
        { "location": "315/SEL"   , "narrator": "", "text": "実はエッチな子だったこと？"},
        { "location": "316/ACT"   , "narrator": "", "text": "おなか出ちゃってること？"},
        { "location": "318/ACT"   , "narrator": "", "text": "実はエッチな子だったこと？"},
        { "location": "328/SEL"   , "narrator": "", "text": "おなか出ちゃってること？"},
        { "location": "329/ACT"   , "narrator": "", "text": "おなか出ちゃってること？"},
        { "location": "339/SEL"   , "narrator": "", "text": "実はエッチな子だったこと？"},
        { "location": "340/ACT"   , "narrator": "", "text": "実はエッチな子だったこと？"},
        { "location": "350/TALK"  , "narrator": "つばめ", "text": "で、出ちゃってなんか\nいませんから！"},
        { "location": "352/TALK"  , "narrator": "つばめ", "text": "出ちゃってきてる\n「かも」って、気にしてる\nだけですよ！"},
        { "location": "353/SEL"   , "narrator": "", "text": "気のせいだといいね"},
        { "location": "354/SEL"   , "narrator": "", "text": "おなか出てても構わないよ！"},
        { "location": "355/ACT"   , "narrator": "", "text": "気のせいだといいね"},
        { "location": "356/TALK"  , "narrator": "つばめ", "text": "もちろん！\n気のせいです！"},
        { "location": "357/TALK"  , "narrator": "つばめ", "text": "そうやって日々危機感を\n持つことで、女子力を\n高めていくんです！"},
        { "location": "358/SEL"   , "narrator": "", "text": "本当に？"},
        { "location": "359/ACT"   , "narrator": "", "text": "本当に？"},
        { "location": "362/TALK"  , "narrator": "つばめ", "text": "本当ですよぅ…。\n司書は嘘は言いません。"},
        { "location": "363/TALK"  , "narrator": "つばめ", "text": "もちろん、実際に計ってる\nわけじゃないので、本当は\n出てるかもしれませんが！"},
        { "location": "364/TALK"  , "narrator": "つばめ", "text": "でも、わたしがそう思って\nいつも気にしてるっていう\nのは本当ですよ？"},
        { "location": "365/ACT"   , "narrator": "", "text": "おなか出てても構わないよ！"},
        { "location": "367/TALK"  , "narrator": "つばめ", "text": "よ、良くないですよぅ…。"},
        { "location": "368/TALK"  , "narrator": "つばめ", "text": "そんなこと言ってても、\n実際わたしがでぶーんって\nしちゃったら……"},
        { "location": "370/TALK"  , "narrator": "つばめ", "text": "ごめんね、って\n言いますよね？"},
        { "location": "371/SEL"   , "narrator": "", "text": "言わないよ！"},
        { "location": "372/SEL"   , "narrator": "", "text": "い、言わないよ！"},
        { "location": "373/SEL"   , "narrator": "", "text": "……ごめん"},
        { "location": "374/ACT"   , "narrator": "", "text": "言わないよ！"},
        { "location": "375/TALK"  , "narrator": "つばめ", "text": "…そ、そうなんですか？"},
        { "location": "376/TALK"  , "narrator": "つばめ", "text": "ありがとうございます。\n$handle$さんは\nホント優しいですね。"},
        { "location": "379/TALK"  , "narrator": "つばめ", "text": "だから好きに\nなっちゃうんですね……。\nきっと。"},
        { "location": "381/ACT"   , "narrator": "", "text": "い、言わないよ！"},
        { "location": "383/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "384/TALK"  , "narrator": "つばめ", "text": "なんか、\n目が泳いでませんか？"},
        { "location": "385/TALK"  , "narrator": "つばめ", "text": "嘘つきは\n泥棒の始まりですよ！"},
        { "location": "386/ACT"   , "narrator": "", "text": "……ごめん"},
        { "location": "387/TALK"  , "narrator": "つばめ", "text": "ですよねー。"},
        { "location": "388/TALK"  , "narrator": "つばめ", "text": "正直に言ってくれて\nありがとうございます！"},
        { "location": "389/TALK"  , "narrator": "つばめ", "text": "今後はもっと\nストイックに、バリバリ\n気にしていきますから！"},
        { "location": "397/TALK"  , "narrator": "つばめ", "text": "な、何ですかあぁぁぁ！\nその、え、えっちな子って\nいうのはぁっ！！"},
        { "location": "398/SEL"   , "narrator": "", "text": "神楽にエッチなこと教えて欲しいんでしょ？"},
        { "location": "399/ACT"   , "narrator": "", "text": "神楽にエッチなこと教えて欲しいんでしょ？"},
        { "location": "402/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "403/SEL"   , "narrator": "", "text": "？？"},
        { "location": "404/ACT"   , "narrator": "", "text": "？？"},
        { "location": "406/TALK"  , "narrator": "つばめ", "text": "意味がわかりません。"},
        { "location": "407/TALK"  , "narrator": "つばめ", "text": "だいたい、指示した\nアドレス以外入らないで\nって言いましたよね？"},
        { "location": "408/SEL"   , "narrator": "", "text": "ごめんね？"},
        { "location": "409/SEL"   , "narrator": "", "text": "つばめの年齢では当たり前のこと。恥ずかしいことではない！"},
        { "location": "410/ACT"   , "narrator": "", "text": "ごめんね？"},
        { "location": "412/TALK"  , "narrator": "つばめ", "text": "…っ。"},
        { "location": "414/TALK"  , "narrator": "つばめ", "text": "ずるいですよぅ……。"},
        { "location": "416/TALK"  , "narrator": "つばめ", "text": "そんな素直に謝られたら\n許しちゃうじゃ\nないですか。"},
        { "location": "417/SEL"   , "narrator": "", "text": "悪い男に引っかからないように注意してね？"},
        { "location": "418/SEL"   , "narrator": "", "text": "…悪い虫がつかないように$me$が一生守らなければ！"},
        { "location": "419/ACT"   , "narrator": "", "text": "悪い男に引っかからないように注意してね？"},
        { "location": "420/TALK"  , "narrator": "つばめ", "text": "え？？\n引っかかりませんよぅ。"},
        { "location": "421/TALK"  , "narrator": "つばめ", "text": "キャッチセールスとか\n詐欺の手口は、学校で\n勉強してますから！"},
        { "location": "423/TALK"  , "narrator": "つばめ", "text": "わたし、こう見えても、\nガードは堅いんです！"},
        { "location": "424/SEL"   , "narrator": "", "text": "お、おう……"},
        { "location": "425/ACT"   , "narrator": "", "text": "お、おう……"},
        { "location": "427/TALK"  , "narrator": "つばめ", "text": "？？"},
        { "location": "428/ACT"   , "narrator": "", "text": "…悪い虫がつかないように$me$が一生守らなければ！"},
        { "location": "430/TALK"  , "narrator": "つばめ", "text": "え？　悪い虫って、\n蚊とかですかね？\nそれとも毒蛇とかです？"},
        { "location": "431/TALK"  , "narrator": "つばめ", "text": "大丈夫ですよ、東京には\n悪い虫はいませんし、寮も\nエアコン完備なので！"},
        { "location": "432/SEL"   , "narrator": "", "text": "東京ほど悪い虫が多い街は日本にはないよ"},
        { "location": "433/ACT"   , "narrator": "", "text": "東京ほど悪い虫が多い街は日本にはないよ"},
        { "location": "436/TALK"  , "narrator": "つばめ", "text": "そうでしょうか？"},
        { "location": "437/TALK"  , "narrator": "つばめ", "text": "静岡にいたときの方が\n沢山蚊に刺されていた\nような……。"},
        { "location": "438/TALK"  , "narrator": "つばめ", "text": "あ、でも…どんなことでも\n一生守ってくれるって\n言葉はすごく嬉しいです！"},
        { "location": "439/TALK"  , "narrator": "つばめ", "text": "蚊に悩まされないで\n夏を過ごせるなんて\n夢みたいですよね！"},
        { "location": "440/SEL"   , "narrator": "", "text": "お、おう……"},
        { "location": "441/ACT"   , "narrator": "", "text": "お、おう……"},
        { "location": "443/TALK"  , "narrator": "つばめ", "text": "？？"},
        { "location": "445/ACT"   , "narrator": "", "text": "つばめの年齢では当たり前のこと。恥ずかしいことではない！"},
        { "location": "447/TALK"  , "narrator": "つばめ", "text": "ええっ！？\nそ、そうなのかな…？"},
        { "location": "448/SEL"   , "narrator": "", "text": "そうだよ。だから安心して？"},
        { "location": "449/ACT"   , "narrator": "", "text": "そうだよ。だから安心して？"},
        { "location": "451/TALK"  , "narrator": "つばめ", "text": "よかったです……"},
        { "location": "452/TALK"  , "narrator": "つばめ", "text": "……って、何か\nいつの間にかお話が\nすり替わってませんか？"},
        { "location": "453/SEL"   , "narrator": "", "text": "気のせい気のせい"},
        { "location": "454/ACT"   , "narrator": "", "text": "気のせい気のせい"},
        { "location": "456/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "463/TALK"  , "narrator": "つばめ", "text": "え？\nなんですか、それ。"},
        { "location": "464/TALK"  , "narrator": "つばめ", "text": "そんなことより、\nもっと言わなくちゃ\nいけないことが――"},
        { "location": "465/SEL"   , "narrator": "", "text": "つばめの心の中にいたよね？　千羽鶴っていう白い子。"},
        { "location": "466/ACT"   , "narrator": "", "text": "つばめの心の中にいたよね？　千羽鶴っていう白い子。"},
        { "location": "468/TALK"  , "narrator": "つばめ", "text": "え？\n意味がわかりませんけど。"},
        { "location": "469/SEL"   , "narrator": "", "text": "0x000番地ってところに飛んだらいたよ？"},
        { "location": "470/ACT"   , "narrator": "", "text": "0x000番地ってところに飛んだらいたよ？"},
        { "location": "472/TALK"  , "narrator": "つばめ", "text": "えっと、よく\nわからないんですけど、\nそんな番地ありません。"},
        { "location": "473/SEL"   , "narrator": "", "text": "あったよ。「Type::」ってところ"},
        { "location": "474/ACT"   , "narrator": "", "text": "あったよ。「Type::」ってところ"},
        { "location": "476/TALK"  , "narrator": "つばめ", "text": "それ、もしかすると\nおかしくなってたんじゃ\nないでしょうか…？"},
        { "location": "477/TALK"  , "narrator": "つばめ", "text": "タイプの名前が無いなんて\n今まで見たことないです。"},
        { "location": "479/TALK"  , "narrator": "つばめ", "text": "…そんなこと言って\nわたしの気を逸らそうと\nしてるんじゃないですか？"},
        { "location": "480/TALK"  , "narrator": "つばめ", "text": "入らないでくださいって\nメールしたのに、他の部屋\n入りましたよね？"},
        { "location": "481/TALK"  , "narrator": "つばめ", "text": "……まあ、もういいです。\n今となっては\n後の祭りですから…。"},
        { "location": "485/TALK"  , "narrator": "つばめ", "text": "…と。\nそんなことより、\nお仕事しなくちゃですね。"},
        { "location": "487/TALK"  , "narrator": "つばめ", "text": "最後くらいは\nミスなくちゃんと\nやり終えないと。"},
        { "location": "495/TALK"  , "narrator": "つばめ", "text": "オープンプロセス、\n0x823番地から\n0xF61番地へ。"},
        { "location": "510/TALK"  , "narrator": "つばめ", "text": "シーク完了しました。"},
        { "location": "512/TALK"  , "narrator": "つばめ", "text": "さて、それで\n今回は……と…"},
        { "location": "514/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "515/TALK"  , "narrator": "つばめ", "text": "あはは…。\nとってもほのぼのした\n微笑ましい悩みですね。"},
        { "location": "516/TALK"  , "narrator": "つばめ", "text": "是非クランを倒して、\n魔法少女さんを\nさせてあげてください。"},
        { "location": "518/TALK"  , "narrator": "つばめ", "text": "恥ずかしいっていうだけで\nやりたくて仕方ないと\n思っていますから。"},
        { "location": "519/SEL"   , "narrator": "", "text": "任せといて！"},
        { "location": "520/SEL"   , "narrator": "", "text": "それよりさっき「最後」とか言ってなかった？"},
        { "location": "521/ACT"   , "narrator": "", "text": "任せといて！"},
        { "location": "522/TALK"  , "narrator": "つばめ", "text": "とっても心強いです！"},
        { "location": "523/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "524/TALK"  , "narrator": "つばめ", "text": "これからもずっと、\nわたしのこと、\nよろしくお願いしますね。"},
        { "location": "525/SEL"   , "narrator": "", "text": "え？"},
        { "location": "526/ACT"   , "narrator": "", "text": "え？"},
        { "location": "528/TALK"  , "narrator": "つばめ", "text": "それじゃ、いきますよ！"},
        { "location": "529/ACT"   , "narrator": "", "text": "それよりさっき「最後」とか言ってなかった？"},
        { "location": "531/TALK"  , "narrator": "つばめ", "text": "え？\nき、気のせいですよ？"},
        { "location": "532/SEL"   , "narrator": "", "text": "いなくなっちゃうの？"},
        { "location": "533/ACT"   , "narrator": "", "text": "いなくなっちゃうの？"},
        { "location": "535/TALK"  , "narrator": "つばめ", "text": "えっと、それは……"},
        { "location": "536/TALK"  , "narrator": "つばめ", "text": "だ、大丈夫ですよ！\nすぐに変わりの人格さんが\n来ますから。"},
        { "location": "537/SEL"   , "narrator": "", "text": "今までありがとう！"},
        { "location": "538/SEL"   , "narrator": "", "text": "どうしたの？何かあったの？"},
        { "location": "539/ACT"   , "narrator": "", "text": "今までありがとう！"},
        { "location": "540/TALK"  , "narrator": "つばめ", "text": "こちらこそ、いつも\nわたしを支えてくれて\nありがとうございます！"},
        { "location": "541/TALK"  , "narrator": "つばめ", "text": "多分次に来るときは、\n新しい人格さんになって\nいると思いますけど……"},
        { "location": "542/TALK"  , "narrator": "つばめ", "text": "変わらずわたしのこと、\nよろしくお願いしますね！"},
        { "location": "543/ACT"   , "narrator": "", "text": "どうしたの？何かあったの？"},
        { "location": "544/TALK"  , "narrator": "つばめ", "text": "え？\nいえ、何も無いですよ。"},
        { "location": "546/SEL"   , "narrator": "", "text": "おなか気にしてるの見ちゃったから？"},
        { "location": "547/ACT"   , "narrator": "", "text": "おなか気にしてるの見ちゃったから？"},
        { "location": "549/TALK"  , "narrator": "つばめ", "text": "え、ええと、そうですね。\n関係無くはないですけど…"},
        { "location": "552/SEL"   , "narrator": "", "text": "エッチな部屋覗いちゃったから？"},
        { "location": "553/ACT"   , "narrator": "", "text": "エッチな部屋覗いちゃったから？"},
        { "location": "555/TALK"  , "narrator": "つばめ", "text": "え、エッチな部屋じゃ\nありませんから！"},
        { "location": "557/TALK"  , "narrator": "つばめ", "text": "ていうか、\nどれだけ覗き見\nしてるんですか…もう…。"},
        { "location": "561/SEL"   , "narrator": "", "text": "千羽鶴がいる部屋を覗いちゃったから？"},
        { "location": "562/ACT"   , "narrator": "", "text": "千羽鶴がいる部屋を覗いちゃったから？"},
        { "location": "565/TALK"  , "narrator": "つばめ", "text": "だから、その部屋のことは\n全然知らないんです。"},
        { "location": "567/TALK"  , "narrator": "つばめ", "text": "え？\nなんですか、それ。"},
        { "location": "568/SEL"   , "narrator": "", "text": "つばめの心の中にいたよね？　千羽鶴っていう白い子。"},
        { "location": "569/ACT"   , "narrator": "", "text": "つばめの心の中にいたよね？　千羽鶴っていう白い子。"},
        { "location": "571/TALK"  , "narrator": "つばめ", "text": "え？\n意味がわかりませんけど。"},
        { "location": "572/SEL"   , "narrator": "", "text": "0x000番地ってところに飛んだらいたよ？"},
        { "location": "573/ACT"   , "narrator": "", "text": "0x000番地ってところに飛んだらいたよ？"},
        { "location": "575/TALK"  , "narrator": "つばめ", "text": "えっと、よく\nわからないんですけど、\nそんな番地ありません。"},
        { "location": "576/SEL"   , "narrator": "", "text": "あったよ。「Type::」ってところ"},
        { "location": "577/ACT"   , "narrator": "", "text": "あったよ。「Type::」ってところ"},
        { "location": "579/TALK"  , "narrator": "つばめ", "text": "それ、何かの処理が\nおかしくなってたんじゃ\nないでしょうか…？"},
        { "location": "580/TALK"  , "narrator": "つばめ", "text": "タイプの名前が無いなんて\n今まで見たことないです。"},
        { "location": "582/TALK"  , "narrator": "つばめ", "text": "でも、もしかしたら\nそれも関係あるのかも\nしれませんね……。"},
        { "location": "585/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "586/TALK"  , "narrator": "つばめ", "text": "えっと…\nえっとですね。"},
        { "location": "587/TALK"  , "narrator": "つばめ", "text": "有給休暇のときに、\n$handle$さんに\n司書お願いしましたよね。"},
        { "location": "588/TALK"  , "narrator": "つばめ", "text": "あれがちょっと\nココロ会議で\n問題になっちゃって……"},
        { "location": "589/TALK"  , "narrator": "つばめ", "text": "ココロの司書を\n辞めることになりました。"},
        { "location": "590/SEL"   , "narrator": "", "text": "更迭！？"},
        { "location": "591/ACT"   , "narrator": "", "text": "更迭！？"},
        { "location": "594/TALK"  , "narrator": "つばめ", "text": "ま、まあ\nそういうことに\nなりますかね。"},
        { "location": "595/SEL"   , "narrator": "", "text": "嫌な予感はしてた"},
        { "location": "596/SEL"   , "narrator": "", "text": "…ごめんなさい。"},
        { "location": "597/ACT"   , "narrator": "", "text": "嫌な予感はしてた"},
        { "location": "599/TALK"  , "narrator": "つばめ", "text": "まあ仕方ないですよ。\n自業自得です。"},
        { "location": "600/ACT"   , "narrator": "", "text": "…ごめんなさい。"},
        { "location": "601/TALK"  , "narrator": "つばめ", "text": "ええっ！\n$handle$さんは\n悪くないですよ？"},
        { "location": "602/TALK"  , "narrator": "つばめ", "text": "全部わたしが\nお願いしたことですから。"},
        { "location": "604/SEL"   , "narrator": "", "text": "元気でね！"},
        { "location": "605/SEL"   , "narrator": "", "text": "もう会えないの？"},
        { "location": "606/ACT"   , "narrator": "", "text": "元気でね！"},
        { "location": "607/TALK"  , "narrator": "つばめ", "text": "はい！\n$handle$さんも\nお元気で！"},
        { "location": "608/TALK"  , "narrator": "つばめ", "text": "これからも末永く\nわたしのことを\nお願いします！"},
        { "location": "609/ACT"   , "narrator": "", "text": "もう会えないの？"},
        { "location": "610/TALK"  , "narrator": "つばめ", "text": "どうでしょうか。"},
        { "location": "611/TALK"  , "narrator": "つばめ", "text": "$handle$さんが\n今度もわたしのココロに\n関わるかどうかですよね。"},
        { "location": "612/TALK"  , "narrator": "つばめ", "text": "まあ、再会しても\nわたしだってわかるか\nどうかはわかりませんが。"},
        { "location": "613/SEL"   , "narrator": "", "text": "確かに見た目が同じだもんね"},
        { "location": "614/SEL"   , "narrator": "", "text": "人格には名前って無いの？"},
        { "location": "615/ACT"   , "narrator": "", "text": "確かに見た目が同じだもんね"},
        { "location": "616/TALK"  , "narrator": "つばめ", "text": "そうですね。\n正気を保っていられる\nうちは、ですけど。"},
        { "location": "617/ACT"   , "narrator": "", "text": "人格には名前って無いの？"},
        { "location": "618/TALK"  , "narrator": "つばめ", "text": "んー、無いことは\n無いんですけど……"},
        { "location": "619/SEL"   , "narrator": "", "text": "名前教えて！"},
        { "location": "620/ACT"   , "narrator": "", "text": "名前教えて！"},
        { "location": "622/TALK"  , "narrator": "つばめ", "text": "ええっ！？\nな、なんだか\n恥ずかしいですね。"},
        { "location": "623/TALK"  , "narrator": "つばめ", "text": "でも確かに、名刺も\nありませんし、せめて\n名前くらいは……。"},
        { "location": "625/TALK"  , "narrator": "つばめ", "text": "わたしの名前は\n『カレン』と申します。"},
        { "location": "626/TALK"  , "narrator": "つばめ", "text": "本当はもっと長い名前\nなんですけど、普段使い\nするものではないので。"},
        { "location": "627/TALK"  , "narrator": "つばめ", "text": "でも、お別れの時に\n名前を伝えるなんて、\nちょっと滑稽でしたね。"},
        { "location": "629/TALK"  , "narrator": "つばめ", "text": "もっと早くに\n伝えておけば\nよかったです。"},
        { "location": "633/TALK"  , "narrator": "つばめ", "text": "それじゃ、最後の\n司書の仕事をさせて\nいただきますね！"},
        { "location": "635/TALK"  , "narrator": "つばめ", "text": "$handle$さんと\nわたしに、\n素敵なココロの旅を！"},
        { "location": "646/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "647/TALK"  , "narrator": "つばめ", "text": "どうか、\nお元気で……。"},
        { "location": "18/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>6月21日　1:22 PM</color>\n平日の午後、神楽坂トライナリー劇場にて。"},
        { "location": "209/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"}
    ]
}
