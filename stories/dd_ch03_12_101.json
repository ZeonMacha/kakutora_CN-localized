{
    "dir": "chap12/daydra/dd_ch03_12_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "12302",
        "cid": "gabriella",
        "title": "002 メインストーリー",
        "sub_title": "口添えを頼まれて＜前編＞"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "口添えを頼まれて"},
        { "location": "26/TALK"   , "narrator": "ガブリエラ", "text": "…いや、頼まれても\n無理だから。"},
        { "location": "27/TALK"   , "narrator": "キリト", "text": "はぁ…やっぱりな。\nひなこ、これで\n諦めついたろ？"},
        { "location": "29/TALK"   , "narrator": "雛", "text": "つかないよ！"},
        { "location": "31/TALK"   , "narrator": "ガブリエラ", "text": "あのね…。\n劇場でバイトしたい\nっていうけど――"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "あそこがただの\n劇場じゃないことは\n知ってるでしょ？"},
        { "location": "34/TALK"   , "narrator": "雛", "text": "だから、東雲教官に\n口添えしてもらおうと\n思って――"},
        { "location": "35/TALK"   , "narrator": "雛", "text": "ガブリエラちゃんに\nお願いしてるんだよ。"},
        { "location": "37/TALK"   , "narrator": "ガブリエラ", "text": "口添えなら\nあたしじゃなくて――"},
        { "location": "38/TALK"   , "narrator": "ガブリエラ", "text": "アーヤとかつばめに\n頼めばいいじゃない。"},
        { "location": "41/TALK"   , "narrator": "雛", "text": "え、えーっと、\nそれは、そのー…。"},
        { "location": "42/TALK"   , "narrator": "キリト", "text": "…アーヤ先輩と\nみやび先輩には\n断られたから――"},
        { "location": "43/TALK"   , "narrator": "キリト", "text": "ガブリエラに頼みに\nきてるとは、さすがに\n言えねぇみたいだな。"},
        { "location": "45/TALK"   , "narrator": "雛", "text": "つ、つばめちゃんには\n絶対頼めないの。"},
        { "location": "46/TALK"   , "narrator": "雛", "text": "つばめちゃんに内緒で\n劇場でバイトする\n許可もらって――"},
        { "location": "47/TALK"   , "narrator": "雛", "text": "ビックリさせよう、\nって作戦だからねー。"},
        { "location": "49/TALK"   , "narrator": "雛", "text": "というわけだから、\nお願い！\n教官に口添えして！"},
        { "location": "51/TALK"   , "narrator": "ガブリエラ", "text": "だから、無理だって！\n絶対できないから。"},
        { "location": "52/TALK"   , "narrator": "雛", "text": "そこを何とか！\nお願いします、\nガブリエラちゃん！！"},
        { "location": "55/TALK"   , "narrator": "ガブリエラ", "text": "ちょ！？　やめてよ！\nこんなところで\n大声で…。"},
        { "location": "56/TALK"   , "narrator": "雛", "text": "ガブリエラちゃんしか\n頼れないんだよー。\nお願いします！"},
        { "location": "58/TALK"   , "narrator": "キリト", "text": "俺からも頼む！\n神様仏様\nガブリエラ様！！"},
        { "location": "60/TALK"   , "narrator": "ヒカル", "text": "すみません…、\nお願いできませんか？"},
        { "location": "64/TALK"   , "narrator": "ガブリエラ", "text": "ちょ、うぅ…。"},
        { "location": "65/TALK"   , "narrator": "ガブリエラ", "text": "ああもう、わかった！\nわかったわよ！\n口添えするから！"},
        { "location": "66/TALK"   , "narrator": "雛", "text": "本当！？"},
        { "location": "68/TALK"   , "narrator": "ガブリエラ", "text": "口添えだけよ？\n断られたとしても、\n責任取らないから。"},
        { "location": "70/TALK"   , "narrator": "雛", "text": "十分だよー！\nありがとう、\nガブリエラちゃん！"},
        { "location": "72/TALK"   , "narrator": "キリト", "text": "ふぅ…一歩前進だな。"},
        { "location": "73/TALK"   , "narrator": "繭", "text": "二歩目が東雲教官で\nある以上、ここで\n行き止まりだと思う。"},
        { "location": "75/TALK"   , "narrator": "雛", "text": "不吉なこと言わない！"},
        { "location": "78/TALK"   , "narrator": "ガブリエラ", "text": "はぁ…面倒なことに\nなったわ…。"},
        { "location": "80/TALK"   , "narrator": "ヒカル", "text": "お手数おかけしますが\nよろしく\nお願いします。"},
        { "location": "82/TALK"   , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "102/TALK"  , "narrator": "真幌", "text": "いや、そんな頼み\nダメに決まってる\nだろ。"},
        { "location": "103/TALK"  , "narrator": "キリト", "text": "はぁ…やっぱなぁ。"},
        { "location": "104/TALK"  , "narrator": "ヒカル", "text": "残念でしたね。"},
        { "location": "106/TALK"  , "narrator": "雛", "text": "えーっ！？\nどうしてですか！！"},
        { "location": "108/TALK"  , "narrator": "真幌", "text": "トライナリーの仕事を\n手伝いたいなんて\n頼み、聞けるわけない。"},
        { "location": "112/TALK"  , "narrator": "ガブリエラ", "text": "…あたしも、そこまで\n手伝おうとしてるのは\n聞いてなかったけど？"},
        { "location": "113/TALK"  , "narrator": "雛", "text": "だって、言ったら\n断られちゃいそう\nだったし…。"},
        { "location": "114/TALK"  , "narrator": "雛", "text": "あ、でも別に、\nフェノメノンの中に\n入って手伝うとか――"},
        { "location": "115/TALK"  , "narrator": "雛", "text": "そういうことを\n言ってるんじゃ\nないんです。"},
        { "location": "117/TALK"  , "narrator": "雛", "text": "あたし達がしようと\n思ってるのは――"},
        { "location": "118/TALK"  , "narrator": "雛", "text": "トライナリーの\nマネージャーみたいな\nことなんです。"},
        { "location": "119/TALK"  , "narrator": "真幌", "text": "…というと？"},
        { "location": "120/TALK"  , "narrator": "雛", "text": "秘密基地のお掃除に\n食事のお世話。\nその他雑務なんでも。"},
        { "location": "122/TALK"  , "narrator": "雛", "text": "もちろん、必要なら\n現場に出るのも\nＯＫですよー。"},
        { "location": "123/TALK"  , "narrator": "真幌", "text": "ＯＫなわけあるか。"},
        { "location": "124/TALK"  , "narrator": "雛", "text": "とにかく、何でも\nするつもりですから、\nお願いします！"},
        { "location": "125/TALK"  , "narrator": "真幌", "text": "はぁ…そういう\n問題じゃないんだよ。"},
        { "location": "126/TALK"  , "narrator": "真幌", "text": "トライナリーが\n秘密の塊な組織だと\nいうのは――"},
        { "location": "127/TALK"  , "narrator": "真幌", "text": "あの学校に通っている\nおまえらなら\nわかるだろ？"},
        { "location": "128/TALK"  , "narrator": "真幌", "text": "そんなところに、\nおまえ達のような\n一般人を――"},
        { "location": "129/TALK"  , "narrator": "真幌", "text": "簡単に雇い入れる\nわけにはいかないん\nだよ。"},
        { "location": "131/TALK"  , "narrator": "雛", "text": "そんなぁ…。"},
        { "location": "133/TALK"  , "narrator": "キリト", "text": "…なあ、ひなこ。\nさすがにもう\n諦め時だと思うぞ？"},
        { "location": "134/TALK"  , "narrator": "キリト", "text": "東雲教官にダメって\n言われちゃ、\n無理は言えないだろ。"},
        { "location": "135/TALK"  , "narrator": "雛", "text": "うーん…。"},
        { "location": "138/TALK"  , "narrator": "ガブリエラ", "text": "…まあ、最初から\nわかってた結果よね。"},
        { "location": "139/TALK"  , "narrator": "ガブリエラ", "text": "これだけまほに\n断られれば、さすがに\n諦めるわよね…。"},
        { "location": "140/TALK"  , "narrator": "繭", "text": "…………。"},
        { "location": "142/TALK"  , "narrator": "繭", "text": "残念です。"},
        { "location": "143/TALK"  , "narrator": "雛", "text": "え？"},
        { "location": "144/TALK"  , "narrator": "真幌", "text": "どうした光月。\nそんなに仕事を\n手伝いたかったのか？"},
        { "location": "146/TALK"  , "narrator": "繭", "text": "いえ…東雲教官は、\n筋を通せばわかると\n思っていました。"},
        { "location": "149/TALK"  , "narrator": "繭", "text": "ですが、通常攻撃隊の\n『四角ダルマ』と\n同じで――"},
        { "location": "150/TALK"  , "narrator": "繭", "text": "杓子定規な方だったと\nわかって、残念と\n思っただけです。"},
        { "location": "152/TALK"  , "narrator": "ガブリエラ", "text": "…え？　何今の。\nもしかして悪口？"},
        { "location": "154/TALK"  , "narrator": "キリト", "text": "ちょ、繭！\nおまえ何言って――"},
        { "location": "157/TALK"  , "narrator": "真幌", "text": "…おい、光月。\nその『四角ダルマ』\nってのは何だ？"},
        { "location": "160/TALK"  , "narrator": "繭", "text": "確か、庁内幹部内での\n隠語だったと\n思いますが…。"},
        { "location": "162/TALK"  , "narrator": "真幌", "text": "どこでそれを知った？"},
        { "location": "165/TALK"  , "narrator": "繭", "text": "ふわっとした\n風の噂で、流れ流れて\n頭の中に。"},
        { "location": "167/TALK"  , "narrator": "真幌", "text": "…………。"},
        { "location": "170/TALK"  , "narrator": "繭", "text": "…それはそうと、\n本題に戻っても\nよろしいでしょうか？"},
        { "location": "172/TALK"  , "narrator": "真幌", "text": "いや…、\n光月、おまえだけ\n廊下に来い。"},
        { "location": "176/TALK"  , "narrator": "雛", "text": "ちょ、まゆちん！\n大丈夫なの？"},
        { "location": "178/TALK"  , "narrator": "繭", "text": "…行ってくる。"},
        { "location": "182/TALK"  , "narrator": "キリト", "text": "おいおい、繭のやつ\n大丈夫なのかよ！？"},
        { "location": "184/TALK"  , "narrator": "雛", "text": "し、知らないよ。\nていうか、東雲教官\nどうして怒ってんの？"},
        { "location": "186/TALK"  , "narrator": "ヒカル", "text": "わかりませんけど…、\nガブリエラさん。"},
        { "location": "189/TALK"  , "narrator": "ガブリエラ", "text": "っ！？"},
        { "location": "190/TALK"  , "narrator": "ヒカル", "text": "先ほど繭さんが\n言っていた四角ダルマ\nのことですが――"},
        { "location": "191/TALK"  , "narrator": "ヒカル", "text": "庁内幹部内での隠語と\nいうのは本当ですか？"},
        { "location": "193/TALK"  , "narrator": "雛", "text": "そういえば…、\nどうなの？"},
        { "location": "195/TALK"  , "narrator": "ガブリエラ", "text": "し、知るわけない\nでしょ！？"},
        { "location": "196/TALK"  , "narrator": "ガブリエラ", "text": "あたしは隊員で\n幹部じゃないん\nだから…。"},
        { "location": "198/TALK"  , "narrator": "真幌", "text": "光月！！\nその情報をどこで\n手に入れた！？"},
        { "location": "201/TALK"  , "narrator": "雛", "text": "ちょ、怒鳴ってるよ？\nまゆちん大丈夫なの？"},
        { "location": "203/TALK"  , "narrator": "ヒカル", "text": "…やっぱり、僕達も\n行ってみましょう。"},
        { "location": "229/TALK"  , "narrator": "ガブリエラ", "text": "ちょっと、まほ！\n何があったのよ！？"},
        { "location": "231/TALK"  , "narrator": "雛", "text": "酷いですよ！\n怒鳴らなくたって\nいいじゃないですか。"},
        { "location": "232/TALK"  , "narrator": "真幌", "text": "…………。"},
        { "location": "233/TALK"  , "narrator": "ヒカル", "text": "何があったんですか？"},
        { "location": "234/TALK"  , "narrator": "真幌", "text": "…詳細は話せん。\nだが、光月は――"},
        { "location": "235/TALK"  , "narrator": "真幌", "text": "国家機密レベルの\n情報を握っている。"},
        { "location": "237/TALK"  , "narrator": "キリト", "text": "…はぁ？\nど、どういうこと\nなんだよ、繭？"},
        { "location": "238/TALK"  , "narrator": "繭", "text": "うるさい。\nうろたえるな。"},
        { "location": "239/TALK"  , "narrator": "真幌", "text": "小金井の反応が\n正しいんだ。"},
        { "location": "241/TALK"  , "narrator": "真幌", "text": "おまえの持っている\nその情報は、知ってる\nだけでも大問題なんだ。"},
        { "location": "242/TALK"  , "narrator": "真幌", "text": "もしも盗んだのだと\nすれば、国家レベルの\n重罪なんだぞ？"},
        { "location": "244/TALK"  , "narrator": "ガブリエラ", "text": "ちょ、ウソでしょ！？\nどうしてそんな話に\nなってんのよ！"},
        { "location": "245/TALK"  , "narrator": "真幌", "text": "どうなんだ、光月？\nハッキリ答えろ！"},
        { "location": "247/TALK"  , "narrator": "繭", "text": "…そう思うのならば、\n警察に突き出して\nもらって結構です。"},
        { "location": "248/TALK"  , "narrator": "繭", "text": "ただ…今お話したのは\n全て事実ですよね？"},
        { "location": "249/TALK"  , "narrator": "真幌", "text": "…………。"},
        { "location": "251/TALK"  , "narrator": "繭", "text": "ならば、私達を\n小間使いとして\n囲っておいた方が――"},
        { "location": "252/TALK"  , "narrator": "繭", "text": "何かと便利だとは\n思いませんか？"},
        { "location": "253/TALK"  , "narrator": "繭", "text": "トライナリーの\n命に関わるような\n事態になった際に――"},
        { "location": "254/TALK"  , "narrator": "繭", "text": "完全なる直属の部隊\nとして、我々を使える\nようにもなりますよ？"},
        { "location": "257/TALK"  , "narrator": "真幌", "text": "…………。"},
        { "location": "258/TALK"  , "narrator": "繭", "text": "…どうしますか？"},
        { "location": "259/TALK"  , "narrator": "真幌", "text": "…………。"},
        { "location": "261/TALK"  , "narrator": "キリト", "text": "…おい、話の内容は\nよくわからねぇけど、\nヤバくねぇか？"},
        { "location": "263/TALK"  , "narrator": "雛", "text": "お手伝いするつもりが\n牢屋行きになるとか、\n意味わかんないよ！"},
        { "location": "266/TALK"  , "narrator": "ヒカル", "text": "お、落ち着いて！\nまだ決まったわけじゃ\nありませんから…。"},
        { "location": "267/TALK"  , "narrator": "雛", "text": "で、でも…。"},
        { "location": "269/TALK"  , "narrator": "真幌", "text": "…………。"},
        { "location": "271/TALK"  , "narrator": "繭", "text": "…………。"},
        { "location": "272/SEL"   , "narrator": "", "text": "繭達が捕まっちゃう！"},
        { "location": "273/ACT"   , "narrator": "", "text": "繭達が捕まっちゃう！"},
        { "location": "292/TALK"  , "narrator": "ガブリエラ", "text": "そんなわけないでしょ？"},
        { "location": "293/TALK"  , "narrator": "ガブリエラ", "text": "もしまほが本気で警察に突き出すつもりだとしたら"},
        { "location": "294/TALK"  , "narrator": "ガブリエラ", "text": "今頃、とっくに警察と管理庁に連絡してるわ"},
        { "location": "296/TALK"  , "narrator": "ガブリエラ", "text": "だからそんなに心配する必要ないのよ"},
        { "location": "298/SEL"   , "narrator": "", "text": "本当に？　絶対大丈夫？"},
        { "location": "299/ACT"   , "narrator": "", "text": "本当に？　絶対大丈夫？"},
        { "location": "301/TALK"  , "narrator": "ガブリエラ", "text": "多分ね"},
        { "location": "303/SEL"   , "narrator": "", "text": "不安に思うところはあるんだね？"},
        { "location": "304/ACT"   , "narrator": "", "text": "不安に思うところはあるんだね？"},
        { "location": "306/TALK"  , "narrator": "ガブリエラ", "text": "落ち着きなさいマルザンナ！！"},
        { "location": "308/TALK"  , "narrator": "ガブリエラ", "text": "大丈夫だって言ってるんだから信じなさい！"},
        { "location": "319/TALK"  , "narrator": "ガブリエラ", "text": "まったく、\n心配性なんだから…。"},
        { "location": "320/TALK"  , "narrator": "ガブリエラ", "text": "まほもどうせ\n答えは決まってるん\nだから――"},
        { "location": "321/TALK"  , "narrator": "ガブリエラ", "text": "さっさとダメって\n言って帰らせれば\nいいのに…。"},
        { "location": "322/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "323/TALK"  , "narrator": "ガブリエラ", "text": "でも、ちょっとは\nフォローしてあげても\nいいかしら？"},
        { "location": "324/TALK"  , "narrator": "ガブリエラ", "text": "あたしのこと、\n頼ってきてくれ\nたんだから――"},
        { "location": "325/TALK"  , "narrator": "ガブリエラ", "text": "ガッカリして帰る姿\n見たら、こっちだって\n心が痛むわ…。"},
        { "location": "326/TALK"  , "narrator": "ガブリエラ", "text": "…でも、そんなこと\nしたらまほに怒られる\nかもしれないし。"},
        { "location": "328/TALK"  , "narrator": "ガブリエラ", "text": "どうしよう…。"},
        { "location": "372/TALK"  , "narrator": "ガブリエラ", "text": "あ、$handle$！"},
        { "location": "373/TALK"  , "narrator": "ガブリエラ", "text": "今回はちょっと\nただならない状況に\nなってるわね！"},
        { "location": "374/SEL"   , "narrator": "", "text": "ガブリエラはどうしたいと思ってるの？"},
        { "location": "375/ACT"   , "narrator": "", "text": "ガブリエラはどうしたいと思ってるの？"},
        { "location": "377/TALK"  , "narrator": "ガブリエラ", "text": "司書のあたしとして\nこうしたいって答えは\nあるけど……"},
        { "location": "378/TALK"  , "narrator": "ガブリエラ", "text": "$handle$が\n知りたいのは、\n総意の腹づもりよね？"},
        { "location": "379/TALK"  , "narrator": "ガブリエラ", "text": "そこはほら！\n検索検索！"},
        { "location": "386/SEL"   , "narrator": "", "text": "司書って何でも知ってるわけじゃないんだね"},
        { "location": "387/ACT"   , "narrator": "", "text": "司書って何でも知ってるわけじゃないんだね"},
        { "location": "389/TALK"  , "narrator": "ガブリエラ", "text": "当たり前でしょ？\n図書館の司書が、本の\n中身を全部知ってる？"},
        { "location": "391/TALK"  , "narrator": "ガブリエラ", "text": "むしろ知らない事の方が\n多いくらいよ。"},
        { "location": "392/TALK"  , "narrator": "ガブリエラ", "text": "オープンプロセス、\n0x58F番地から\n0x224番地へ。"},
        { "location": "407/TALK"  , "narrator": "ガブリエラ", "text": "シーク完了っ♪"},
        { "location": "411/TALK"  , "narrator": "ガブリエラ", "text": "それで、\n今回のあたしの\n総意は……っと。"},
        { "location": "412/TALK"  , "narrator": "ガブリエラ", "text": "……はあ、なるほど。"},
        { "location": "413/TALK"  , "narrator": "ガブリエラ", "text": "どっちだと思う？"},
        { "location": "414/SEL"   , "narrator": "", "text": "繭達に助け船を出したいと思ってる"},
        { "location": "415/SEL"   , "narrator": "", "text": "繭達に素直に帰ってもらえるように誘導するつもり"},
        { "location": "416/ACT"   , "narrator": "", "text": "繭達に助け船を出したいと思ってる"},
        { "location": "417/TALK"  , "narrator": "ガブリエラ", "text": "正解。\n何の捻りもなくて\nごめんなさいね。"},
        { "location": "418/ACT"   , "narrator": "", "text": "繭達に素直に帰ってもらえるように誘導するつもり"},
        { "location": "420/TALK"  , "narrator": "ガブリエラ", "text": "残念。\n正解は、助け船を\n出したいって思ってる。"},
        { "location": "421/TALK"  , "narrator": "ガブリエラ", "text": "何の捻りもなくて\nごめんなさいね。"},
        { "location": "423/TALK"  , "narrator": "ガブリエラ", "text": "でも、本当に大事なのは\nここからなのよ。"},
        { "location": "424/TALK"  , "narrator": "ガブリエラ", "text": "助け船出したいんだけど\nどうやって口添えすれば\nいいのかわからないの。"},
        { "location": "425/TALK"  , "narrator": "ガブリエラ", "text": "だから、\n$handle$に\n協力して欲しいのよね！"},
        { "location": "427/TALK"  , "narrator": "ガブリエラ", "text": "何て言えば\nまほが首を縦に\n振ると思う？"},
        { "location": "428/SEL"   , "narrator": "", "text": "劇場のバイトやらせれば自分たちが楽になるっていうのは？"},
        { "location": "429/SEL"   , "narrator": "", "text": "男共を力仕事でこき使えるっていうのは？"},
        { "location": "430/SEL"   , "narrator": "", "text": "ここまで粘着するくらいだから、雇わなかったら大変なことに…"},
        { "location": "431/ACT"   , "narrator": "", "text": "劇場のバイトやらせれば自分たちが楽になるっていうのは？"},
        { "location": "432/TALK"  , "narrator": "ガブリエラ", "text": "え……。それって\n自分が怠けたいだけ\nみたいに聞こえるわよ？"},
        { "location": "433/TALK"  , "narrator": "ガブリエラ", "text": "うーん……\nでも、実際\nそうなのよね。"},
        { "location": "434/SEL"   , "narrator": "", "text": "自分で提案しておいてアレだけど、劇場いつもヒマだよね？"},
        { "location": "435/ACT"   , "narrator": "", "text": "自分で提案しておいてアレだけど、劇場いつもヒマだよね？"},
        { "location": "438/TALK"  , "narrator": "ガブリエラ", "text": "まあ、失礼ね！\n……その通りだけど。"},
        { "location": "439/TALK"  , "narrator": "ガブリエラ", "text": "やっぱりこの案は\nダメかしらね。"},
        { "location": "440/TALK"  , "narrator": "ガブリエラ", "text": "でも、この発想から\n何かいい考えが浮かぶかも\nしれないし。"},
        { "location": "441/ACT"   , "narrator": "", "text": "男共を力仕事でこき使えるっていうのは？"},
        { "location": "442/TALK"  , "narrator": "ガブリエラ", "text": "あ、それ……そうね。"},
        { "location": "443/TALK"  , "narrator": "ガブリエラ", "text": "そういえば、男の子たちも\nいるんだったわね。"},
        { "location": "444/SEL"   , "narrator": "", "text": "苦手なんだったよね"},
        { "location": "445/ACT"   , "narrator": "", "text": "苦手なんだったよね"},
        { "location": "447/TALK"  , "narrator": "ガブリエラ", "text": "…そうね。\n平たく言えば。"},
        { "location": "449/TALK"  , "narrator": "ガブリエラ", "text": "とはいえ、口添えしたい\n気持ちは変わらないし…"},
        { "location": "450/TALK"  , "narrator": "ガブリエラ", "text": "割と説得力ある案だから\n背に腹は替えられない\nって感じね。"},
        { "location": "451/ACT"   , "narrator": "", "text": "ここまで粘着するくらいだから、雇わなかったら大変なことに…"},
        { "location": "452/TALK"  , "narrator": "ガブリエラ", "text": "何それ怖っ！！"},
        { "location": "453/TALK"  , "narrator": "ガブリエラ", "text": "……と思ったけど、\n実際あり得そうなところが\n本気で怖いわね。"},
        { "location": "454/TALK"  , "narrator": "ガブリエラ", "text": "まあ、逆恨みされて\n火を付けられるような\nことは無いと思うけど……"},
        { "location": "456/TALK"  , "narrator": "ガブリエラ", "text": "でも、また何度もアタック\nしてくるだろうし、見てて\n辛くなりそう。"},
        { "location": "457/SEL"   , "narrator": "", "text": "真幌も同じ気持ちになるかもよ"},
        { "location": "458/ACT"   , "narrator": "", "text": "真幌も同じ気持ちになるかもよ"},
        { "location": "460/TALK"  , "narrator": "ガブリエラ", "text": "うーん、そうかもね。\nああ見えて人情味溢れる\n人だし……。"},
        { "location": "462/TALK"  , "narrator": "ガブリエラ", "text": "とにかく、ありがと！\nすっごく参考になったわ。"},
        { "location": "463/SEL"   , "narrator": "", "text": "どういたしまして"},
        { "location": "464/ACT"   , "narrator": "", "text": "どういたしまして"},
        { "location": "467/TALK"  , "narrator": "ガブリエラ", "text": "それにしても……"},
        { "location": "468/TALK"  , "narrator": "ガブリエラ", "text": "$handle$は\nどうしていつもそんなに\n協力してくれるの？"},
        { "location": "469/SEL"   , "narrator": "", "text": "ガブリエラが好きだから"},
        { "location": "470/SEL"   , "narrator": "", "text": "コンプリートする為だよ"},
        { "location": "471/ACT"   , "narrator": "", "text": "ガブリエラが好きだから"},
        { "location": "472/TALK"  , "narrator": "ガブリエラ", "text": "ちょっと、もう…\n直球すぎるわよ？"},
        { "location": "473/TALK"  , "narrator": "ガブリエラ", "text": "でも$handle$は、\nそういう所も素敵よね。"},
        { "location": "476/TALK"  , "narrator": "ガブリエラ", "text": "あたしにもそういう所、\n見習ってもらいたいわ。"},
        { "location": "477/ACT"   , "narrator": "", "text": "コンプリートする為だよ"},
        { "location": "478/TALK"  , "narrator": "ガブリエラ", "text": "ちょっと？\nそれは酷いんじゃなくて？"},
        { "location": "479/SEL"   , "narrator": "", "text": "なんでそんな嬉しそうなの？"},
        { "location": "480/ACT"   , "narrator": "", "text": "なんでそんな嬉しそうなの？"},
        { "location": "483/TALK"  , "narrator": "ガブリエラ", "text": "え？　だって、どういう\n理由でも、協力してくれる\n事には変わりないもの。"},
        { "location": "484/TALK"  , "narrator": "ガブリエラ", "text": "そんなゲームみたいな\n理由でも、嫌だったら\nやらないでしょ？"},
        { "location": "485/SEL"   , "narrator": "", "text": "なんでそんなポジティブなの？"},
        { "location": "486/ACT"   , "narrator": "", "text": "なんでそんなポジティブなの？"},
        { "location": "488/TALK"  , "narrator": "ガブリエラ", "text": "なんで？って言われても。\nだってそういう人格\nなんだもの、あたし。"},
        { "location": "490/TALK"  , "narrator": "ガブリエラ", "text": "だからこんな閑職に\n回されてるのかも\nしれないけどね。"},
        { "location": "492/TALK"  , "narrator": "ガブリエラ", "text": "さて。それじゃ\nそろそろ行きましょ。"},
        { "location": "493/TALK"  , "narrator": "ガブリエラ", "text": "あたしと\n$handle$にとって\n素敵なココロの旅を！"},
        { "location": "25/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>7月3日　3:38 PM</color>\nとある週末の昼下がり、近所にある公園にて。"},
        { "location": "340/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"}
    ]
}
