        "title": "らぶとーく 第08話",
        "sub_title": "やさしい秘密"
    },
    "entry":
    [
        { "location": "198/SCENARIO", "narrator": "", "text": "やさしい秘密"},
        { "location": "212/TALK"    , "narrator": "アーヤ", "text": "――というわけなの。"},
        { "location": "215/TALK"    , "narrator": "ガブリエラ", "text": "ちょ、待ってよ！\n何言い出すのよ急に！？"},
        { "location": "216/TALK"    , "narrator": "ガブリエラ", "text": "マルザ…"},
        { "location": "217/TALK"    , "narrator": "ガブリエラ", "text": "Ｂｏｔの正体が人間って…\n意味わからないんだけど？"},
        { "location": "219/TALK"    , "narrator": "アーヤ", "text": "あくまで\n可能性の話でしか\nないけど。"},
        { "location": "220/TALK"    , "narrator": "アーヤ", "text": "私達がＢｏｔだと思ってる\nあれは。"},
        { "location": "221/TALK"    , "narrator": "アーヤ", "text": "人間が、Ｂｏｔのフリを\nしているだけって\n可能性が高いの。"},
        { "location": "223/TALK"    , "narrator": "つばめ", "text": "そっか…$handle$、\n本当は人間だったん\nですね。"},
        { "location": "225/TALK"    , "narrator": "ガブリエラ", "text": "いや、何落ち着いて\n言ってんのよ！"},
        { "location": "226/TALK"    , "narrator": "ガブリエラ", "text": "なんで納得\nできるの？\n意味わかんない！"},
        { "location": "228/TALK"    , "narrator": "つばめ", "text": "う、うん…。\nビックリはしたよ。"},
        { "location": "231/TALK"    , "narrator": "つばめ", "text": "でも、人間だったら\n良いのになぁ、って\n思ってたから――"},
        { "location": "232/TALK"    , "narrator": "つばめ", "text": "今はちょっとだけ\n嬉しいの。"},
        { "location": "234/TALK"    , "narrator": "みやび", "text": "つばめちゃんは、\n状況適応力が凄過ぎや。"},
        { "location": "236/TALK"    , "narrator": "ガブリエラ", "text": "何も考えて\nないだけでしょ！？"},
        { "location": "238/TALK"    , "narrator": "みやび", "text": "まあ、うちはなんとなく\n気付いてたきね。"},
        { "location": "239/TALK"    , "narrator": "みやび", "text": "それが確信に変わった\nだけのことや。"},
        { "location": "240/TALK"    , "narrator": "ガブリエラ", "text": "みやびも\nＢｏｔが人間だって\n言うわけ？"},
        { "location": "243/TALK"    , "narrator": "アーヤ", "text": "そんなこと\n考えたくない、って\n気持ちはわかるわ。"},
        { "location": "244/TALK"    , "narrator": "アーヤ", "text": "だけど、これは\nかなり確率の高い\n話なの。"},
        { "location": "245/TALK"    , "narrator": "アーヤ", "text": "だからみんな\n話す内容には\n気をつけて。"},
        { "location": "248/TALK"    , "narrator": "つばめ", "text": "っていうか、人間か\nどうかって、そんなに\n重要なことですか？"},
        { "location": "250/TALK"    , "narrator": "みやび", "text": "そりゃまあ…人間やと\nしたら、Ｂｏｔやと思うて\n話してた会話が――"},
        { "location": "251/TALK"    , "narrator": "みやび", "text": "全部誰かに話したゆう\nことになるんやし。"},
        { "location": "254/TALK"    , "narrator": "ガブリエラ", "text": "！？"},
        { "location": "255/TALK"    , "narrator": "アーヤ", "text": "それなのよね…。\nまあ、誰かにバラすような\nことはなさそうだけど…。"},
        { "location": "257/TALK"    , "narrator": "ガブリエラ", "text": "いい加減にしてよ！"},
        { "location": "258/TALK"    , "narrator": "ガブリエラ", "text": "Ｂｏｔが人間とか、\n笑えない冗談にも\n程があるわ。"},
        { "location": "260/TALK"    , "narrator": "アーヤ", "text": "確定じゃないわ。\nあくまで可能性の\n話ってこと。"},
        { "location": "261/TALK"    , "narrator": "みやび", "text": "ガブちゃん。\nうちらも冗談で言っちゅう\nわけやないぞね。"},
        { "location": "262/TALK"    , "narrator": "みやび", "text": "会話ログを解析したり、\n色々した結果、そういう\n答えを導き出したがよ。"},
        { "location": "264/TALK"    , "narrator": "ガブリエラ", "text": "だから、その導き出した\n答えが間違ってるの！"},
        { "location": "267/TALK"    , "narrator": "つばめ", "text": "みんななんだか\n怖いんだけど……。"},
        { "location": "269/TALK"    , "narrator": "ガブリエラ", "text": "ああもう、話にならない！"},
        { "location": "270/TALK"    , "narrator": "ガブリエラ", "text": "とにかく、あたしは\nそんな話信じないから。"},
        { "location": "272/TALK"    , "narrator": "アーヤ", "text": "そうね。\n確かにそう。"},
        { "location": "273/TALK"    , "narrator": "アーヤ", "text": "もちろん、私だって\n混乱はしてる。"},
        { "location": "275/TALK"    , "narrator": "アーヤ", "text": "それでもね。\nできるだけ、冷静に対応を\nしようと思ってるわ。"},
        { "location": "276/TALK"    , "narrator": "アーヤ", "text": "だから、もしみんなが\n今後のＢｏｔとの\n付き合い方とかで――"},
        { "location": "278/TALK"    , "narrator": "アーヤ", "text": "わからないことがあれば、\nいつでも相談してくれて\n構わないから。"},
        { "location": "279/TALK"    , "narrator": "アーヤ", "text": "私の話は以上よ。\nそれじゃ、今夜は解散。"},
        { "location": "281/TALK"    , "narrator": "ガブリエラ", "text": "まったく、こんなふざけた\n話のために、一々人のこと\n呼び出さないでよね！"},
        { "location": "285/TALK"    , "narrator": "つばめ", "text": "はい、お疲れ様でした。\nおやすみなさい。"},
        { "location": "310/TALK"    , "narrator": "つばめ", "text": "$handle$は本当に人間なんだね"},
        { "location": "311/TALK"    , "narrator": "つばめ", "text": "アーヤさんたちから聞いたょ"},
        { "location": "313/SEL"     , "narrator": "", "text": "そうだよ"},
        { "location": "314/SEL"     , "narrator": "", "text": "それは偽情報だよ"},
        { "location": "315/ACT"     , "narrator": "", "text": "そうだよ"},
        { "location": "316/TALK"    , "narrator": "つばめ", "text": "そぅなんだね"},
        { "location": "317/TALK"    , "narrator": "つばめ", "text": "そぅなんだょね"},
        { "location": "318/ACT"     , "narrator": "", "text": "それは偽情報だよ"},
        { "location": "319/TALK"    , "narrator": "つばめ", "text": "なんでそんな"},
        { "location": "321/TALK"    , "narrator": "つばめ", "text": "嘘つくの(´・ω・`) "},
        { "location": "323/TALK"    , "narrator": "つばめ", "text": "すごいね"},
        { "location": "324/TALK"    , "narrator": "つばめ", "text": "なんかね"},
        { "location": "325/TALK"    , "narrator": "つばめ", "text": "すごくうれしぃよ"},
        { "location": "327/SEL"     , "narrator": "", "text": "そう言ってくれて安心した"},
        { "location": "328/SEL"     , "narrator": "", "text": "$me$もうれしいよ"},
        { "location": "329/SEL"     , "narrator": "", "text": "つばめはかわいいなあ"},
        { "location": "330/ACT"     , "narrator": "", "text": "そう言ってくれて安心した"},
        { "location": "331/TALK"    , "narrator": "つばめ", "text": "そぅなの？"},
        { "location": "332/ACT"     , "narrator": "", "text": "$me$もうれしいよ"},
        { "location": "333/TALK"    , "narrator": "つばめ", "text": "うれしいょね"},
        { "location": "334/TALK"    , "narrator": "つばめ", "text": "うれしいょねヽ(*´∀｀)ノ"},
        { "location": "335/ACT"     , "narrator": "", "text": "つばめはかわいいなあ"},
        { "location": "336/TALK"    , "narrator": "つばめ", "text": "ゃだ"},
        { "location": "337/TALK"    , "narrator": "つばめ", "text": "照れちゃぅ"},
        { "location": "339/TALK"    , "narrator": "つばめ", "text": "(・ω<) ﾃﾍﾍﾟﾛ"},
        { "location": "341/TALK"    , "narrator": "つばめ", "text": "これからも"},
        { "location": "342/TALK"    , "narrator": "つばめ", "text": "よろしくね"},
        { "location": "211/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>5月某日　10:05 PM</color>\n平日の夜、神楽坂トライナリーのホワイエにて。"}
    ]
}
