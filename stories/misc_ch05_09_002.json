    "entry":
    [
        { "location": "2033/SCENARIO", "narrator": "", "text": "どうにかしてよ"},
        { "location": "2058/TALK"    , "narrator": "神楽", "text": "女子ってなんでみんな一緒が好きなんだろ"},
        { "location": "2059/TALK"    , "narrator": "神楽", "text": "そういうの小学校で卒業して欲しい"},
        { "location": "2061/SEL"     , "narrator": "", "text": "手厳しいね"},
        { "location": "2062/SEL"     , "narrator": "", "text": "でもつばめは好きなんでしょ"},
        { "location": "2063/SEL"     , "narrator": "", "text": "神楽は自立してるから…"},
        { "location": "2064/ACT"     , "narrator": "", "text": "手厳しいね"},
        { "location": "2065/TALK"    , "narrator": "神楽", "text": "いや普通全然普通"},
        { "location": "2066/ACT"     , "narrator": "", "text": "でもつばめは好きなんでしょ"},
        { "location": "2067/TALK"    , "narrator": "神楽", "text": "それはどうでしょうね？"},
        { "location": "2068/TALK"    , "narrator": "神楽", "text": "ていうかぴょんこはちょっと反省したのです"},
        { "location": "2069/TALK"    , "narrator": "神楽", "text": "現実逃避とはいえ破壊対象の子をナチュラルにかわいいとか言ってﾊｽﾊｽしちゃったりして"},
        { "location": "2071/SEL"     , "narrator": "", "text": "本心じゃなかったの！？"},
        { "location": "2072/ACT"     , "narrator": "", "text": "本心じゃなかったの！？"},
        { "location": "2074/TALK"    , "narrator": "神楽", "text": "んーと"},
        { "location": "2075/TALK"    , "narrator": "神楽", "text": "そういうわけでもないけど"},
        { "location": "2076/TALK"    , "narrator": "神楽", "text": "そりゃね、ぴょんこの大好物ですよ、ああいう小動物系"},
        { "location": "2077/TALK"    , "narrator": "神楽", "text": "ていうかわかってて聞いてない？"},
        { "location": "2078/TALK"    , "narrator": "神楽", "text": "揺れる乙女心がわからない$handlek$はｲｯﾃﾖｼ"},
        { "location": "2079/TALK"    , "narrator": "神楽", "text": "まあそれはもういいんだけど"},
        { "location": "2080/ACT"     , "narrator": "", "text": "神楽は自立してるから…"},
        { "location": "2082/TALK"    , "narrator": "神楽", "text": "そういうわけじゃないですー！"},
        { "location": "2083/TALK"    , "narrator": "神楽", "text": "ちょっと人より大人なだけなんですー！"},
        { "location": "2085/TALK"    , "narrator": "神楽", "text": "なんだかんだでね？"},
        { "location": "2086/TALK"    , "narrator": "神楽", "text": "トライナリーはね？"},
        { "location": "2087/TALK"    , "narrator": "神楽", "text": "べったり仲良しって感じじゃないけどね？"},
        { "location": "2088/TALK"    , "narrator": "神楽", "text": "それでもうーんちょっとさーって時はあるんですよこれが"},
        { "location": "2091/SEL"     , "narrator": "", "text": "あるだろうねえ…"},
        { "location": "2092/SEL"     , "narrator": "", "text": "$me$はいつでも神楽の味方"},
        { "location": "2093/SEL"     , "narrator": "", "text": "群れない俺ｶｺｲｲ宣言？"},
        { "location": "2094/ACT"     , "narrator": "", "text": "あるだろうねえ…"},
        { "location": "2095/TALK"    , "narrator": "神楽", "text": "ありますよそりゃー"},
        { "location": "2096/ACT"     , "narrator": "", "text": "$me$はいつでも神楽の味方"},
        { "location": "2098/TALK"    , "narrator": "神楽", "text": "ははん？"},
        { "location": "2099/TALK"    , "narrator": "神楽", "text": "よく言ったよく言った"},
        { "location": "2100/TALK"    , "narrator": "神楽", "text": "$handlek$の言質取ったどー！！！！"},
        { "location": "2102/TALK"    , "narrator": "神楽", "text": "これでぴょんこと$handlek$は死が二人を分かつまで一緒だからね！"},
        { "location": "2103/ACT"     , "narrator": "", "text": "群れない俺ｶｺｲｲ宣言？"},
        { "location": "2104/TALK"    , "narrator": "神楽", "text": "そう思っとけ"},
        { "location": "2106/TALK"    , "narrator": "神楽", "text": "ぴょんこは団体戦しかできないアイドルグループなんてお断りなんですー"},
        { "location": "2107/TALK"    , "narrator": "神楽", "text": "なんて気分だったわけ☆彡"},
        { "location": "2108/TALK"    , "narrator": "神楽", "text": "でも話したらちょっと気が晴れたかもー"},
        { "location": "2109/TALK"    , "narrator": "神楽", "text": "ばいばーい"}
    ]
}
