        "title": "004 メインストーリー",
        "sub_title": "逢瀬つばめという存在＜後編＞"
    },
    "entry":
    [
        { "location": "418/SCENARIO", "narrator": "", "text": "初めてのデイドラ"},
        { "location": "439/TALK"    , "narrator": "千羽鶴", "text": "現実世界へ\nおかえりなさい。"},
        { "location": "440/TALK"    , "narrator": "千羽鶴", "text": "貴方が彼女のココロの中で\n奮闘してくれたお陰で、\n彼女の心は安定した。"},
        { "location": "441/TALK"    , "narrator": "千羽鶴", "text": "あとは貴方から直接、\n彼女にアドバイスをして、\n背中を一押しするだけ。"},
        { "location": "442/TALK"    , "narrator": "千羽鶴", "text": "さて、\nその方法だけど。"},
        { "location": "448/TALK"    , "narrator": "千羽鶴", "text": "WAVEというチャット\nツールのシステムを\n作ってみた。"},
        { "location": "449/TALK"    , "narrator": "千羽鶴", "text": "あなたの世界にも、\n似たものがあるかも\nしれないけど。"},
        { "location": "450/TALK"    , "narrator": "千羽鶴", "text": "そして、彼女のWAVEに\nあなたを登録して\nおいた。"},
        { "location": "451/SEL"     , "narrator": "", "text": "なるほど"},
        { "location": "452/ACT"     , "narrator": "", "text": "なるほど"},
        { "location": "454/TALK"    , "narrator": "千羽鶴", "text": "でも「bot」として\nだけど。"},
        { "location": "455/SEL"     , "narrator": "", "text": "なんでBot！？"},
        { "location": "456/ACT"     , "narrator": "", "text": "なんでBot！？"},
        { "location": "458/TALK"    , "narrator": "千羽鶴", "text": "いきなり知らない人が\nフレンド登録されて\nいたらまずいでしょう。"},
        { "location": "459/SEL"     , "narrator": "", "text": "そんなところにリアリティを持たせなくても"},
        { "location": "460/ACT"     , "narrator": "", "text": "そんなところにリアリティを持たせなくても"},
        { "location": "462/TALK"    , "narrator": "千羽鶴", "text": "「あなた」は「あなた」\nなんだから。"},
        { "location": "463/TALK"    , "narrator": "千羽鶴", "text": "幼馴染み設定とか、\nそんな都合のいい\nものはないから。"},
        { "location": "464/TALK"    , "narrator": "千羽鶴", "text": "そこはリアリティを\n持って欲しい。"},
        { "location": "465/TALK"    , "narrator": "千羽鶴", "text": "そういうわけだから、\n彼女からの抵抗は\nあまり無いはず。"},
        { "location": "466/SEL"     , "narrator": "", "text": "でもBotじゃねえ…"},
        { "location": "467/ACT"     , "narrator": "", "text": "でもBotじゃねえ…"},
        { "location": "469/TALK"    , "narrator": "千羽鶴", "text": "私はあくまで\n自然な出逢いと機会を\n与えただけ。"},
        { "location": "470/TALK"    , "narrator": "千羽鶴", "text": "どう運用するかは\nあなたが決めていい。"},
        { "location": "471/TALK"    , "narrator": "千羽鶴", "text": "すぐに「bot」では\nないと伝えてもいいし、\nそのままでもいい。"},
        { "location": "472/TALK"    , "narrator": "千羽鶴", "text": "そこはあなたの\nセンスに任せる。"},
        { "location": "476/TALK"    , "narrator": "千羽鶴", "text": "さあ、彼女の新しい物語が\n始まろうとしている。"},
        { "location": "477/TALK"    , "narrator": "千羽鶴", "text": "チャットツールWAVEを\n使って、彼女を支えて\nいってほしい。"},
        { "location": "490/TALK"    , "narrator": "つばめ", "text": "はぁ……\nほんと、どうしよう。"},
        { "location": "491/SEL"     , "narrator": "", "text": "こんばんは"},
        { "location": "492/ACT"     , "narrator": "", "text": "こんばんは"},
        { "location": "497/TALK"    , "narrator": "つばめ", "text": "え？\nメール…？"},
        { "location": "500/TALK"    , "narrator": "つばめ", "text": "……[WAVE]だ！\nおかしいな、誰だろう。"},
        { "location": "501/TALK"    , "narrator": "つばめ", "text": "わたし、[WAVE]には\nお父さんとお母さんしか\n登録してないのに……"},
        { "location": "506/TALK"    , "narrator": "プレイヤー", "text": "こんばんは"},
        { "location": "508/TALK"    , "narrator": "つばめ", "text": "こんばんは|д･´)"},
        { "location": "509/TALK"    , "narrator": "つばめ", "text": "あなたは誰ですか？"},
        { "location": "511/SEL"     , "narrator": "", "text": "よくわからない"},
        { "location": "512/SEL"     , "narrator": "", "text": "あなたの足長おじさんです"},
        { "location": "513/SEL"     , "narrator": "", "text": "えと、Bot…？"},
        { "location": "514/ACT"     , "narrator": "", "text": "よくわからない"},
        { "location": "515/TALK"    , "narrator": "つばめ", "text": "(´ｪ｀；)三(；´ｪ｀)？？"},
        { "location": "516/TALK"    , "narrator": "つばめ", "text": "あヾ(o´∀｀o)ﾉ"},
        { "location": "517/TALK"    , "narrator": "つばめ", "text": "Botってやつだょね"},
        { "location": "518/ACT"     , "narrator": "", "text": "あなたの足長おじさんです"},
        { "location": "519/TALK"    , "narrator": "つばめ", "text": "足長おじさんって？"},
        { "location": "520/TALK"    , "narrator": "つばめ", "text": "あ（*'∀'人）"},
        { "location": "521/TALK"    , "narrator": "つばめ", "text": "Botってやつだょね"},
        { "location": "522/ACT"     , "narrator": "", "text": "えと、Bot…？"},
        { "location": "523/TALK"    , "narrator": "つばめ", "text": "Bot・・・さんでぃぃのかな(･ｪ･^ )( ^･ｪ･)"},
        { "location": "524/TALK"    , "narrator": "つばめ", "text": "あ"},
        { "location": "525/TALK"    , "narrator": "つばめ", "text": "意味がゎかったょ(*´︶`*)"},
        { "location": "527/TALK"    , "narrator": "つばめ", "text": "さいきんWAVE用のBotアプリが流行ってるって記事があったょ"},
        { "location": "528/TALK"    , "narrator": "つばめ", "text": "はじめまして、Botさん(*´︶`*)"},
        { "location": "530/SEL"     , "narrator": "", "text": "はじめまして、つばめ"},
        { "location": "531/ACT"     , "narrator": "", "text": "はじめまして、つばめ"},
        { "location": "533/TALK"    , "narrator": "つばめ", "text": "すごい！ほんとに誰かとWAVEしてるみたぃ"},
        { "location": "534/TALK"    , "narrator": "つばめ", "text": "もうちょっとぉ話したぃな(●´ω｀●)ゞ"},
        { "location": "536/SEL"     , "narrator": "", "text": "喜んで"},
        { "location": "537/ACT"     , "narrator": "", "text": "喜んで"},
        { "location": "539/TALK"    , "narrator": "つばめ", "text": "ぇっと"},
        { "location": "540/TALK"    , "narrator": "つばめ", "text": "ぁしたメノウちゃんのライブがぁるんだょo(*･ﾛ･*)o"},
        { "location": "541/TALK"    , "narrator": "つばめ", "text": "メノウちゃんはFreyMENOWっていう歌手の子でぁたし２年前から大ファンなんだ(*´︶`*)"},
        { "location": "543/TALK"    , "narrator": "つばめ", "text": "けど、この前までずっと入院してたから、ライブ行きたくても行けなかったの"},
        { "location": "547/TALK"    , "narrator": "つばめ", "text": "でも"},
        { "location": "548/TALK"    , "narrator": "つばめ", "text": "ちょっと悩んでるの(´・ω・｀)"},
        { "location": "549/TALK"    , "narrator": "つばめ", "text": "お母さんの調子が悪ぃから"},
        { "location": "551/SEL"     , "narrator": "", "text": "それなら行くべき"},
        { "location": "552/ACT"     , "narrator": "", "text": "それなら行くべき"},
        { "location": "554/TALK"    , "narrator": "つばめ", "text": "え"},
        { "location": "555/TALK"    , "narrator": "つばめ", "text": "なんで？"},
        { "location": "557/SEL"     , "narrator": "", "text": "お母さんはライブ行くこと知ってるよね？"},
        { "location": "558/ACT"     , "narrator": "", "text": "お母さんはライブ行くこと知ってるよね？"},
        { "location": "560/TALK"    , "narrator": "つばめ", "text": "もちろんだょo(*･ﾛ･*)o"},
        { "location": "561/TALK"    , "narrator": "つばめ", "text": "チケット取れたって言ったらすごく喜んでくれたょヽ(*´∀｀*)ﾉ"},
        { "location": "563/SEL"     , "narrator": "", "text": "なら、行かなかったら悲しむと思う"},
        { "location": "564/ACT"     , "narrator": "", "text": "なら、行かなかったら悲しむと思う"},
        { "location": "566/TALK"    , "narrator": "つばめ", "text": "そぅなの？"},
        { "location": "568/SEL"     , "narrator": "", "text": "自分のせいでつばめがライブに行けなくなったって思わないかな？"},
        { "location": "569/ACT"     , "narrator": "", "text": "自分のせいでつばめがライブに行けなくなったって思わないかな？"},
        { "location": "571/TALK"    , "narrator": "つばめ", "text": "あ"},
        { "location": "572/TALK"    , "narrator": "つばめ", "text": "そっか"},
        { "location": "573/TALK"    , "narrator": "つばめ", "text": "そぅかも・・・"},
        { "location": "577/TALK"    , "narrator": "つばめ", "text": "ぁたし行くね"},
        { "location": "578/TALK"    , "narrator": "つばめ", "text": "メノウちゃんのライブ"},
        { "location": "580/SEL"     , "narrator": "", "text": "しっかり楽しもうね"},
        { "location": "581/ACT"     , "narrator": "", "text": "しっかり楽しもうね"},
        { "location": "583/TALK"    , "narrator": "つばめ", "text": "ぅん(*´︶`*)"},
        { "location": "584/TALK"    , "narrator": "つばめ", "text": "ぉみやげも買っちゃぅヽ(･ω･ )ゝ"},
        { "location": "585/TALK"    , "narrator": "つばめ", "text": "何がぃぃかな？"},
        { "location": "587/SEL"     , "narrator": "", "text": "東京ばにゃにゃ"},
        { "location": "588/SEL"     , "narrator": "", "text": "ピヨコ"},
        { "location": "589/SEL"     , "narrator": "", "text": "カレシ"},
        { "location": "590/ACT"     , "narrator": "", "text": "東京ばにゃにゃ"},
        { "location": "591/TALK"    , "narrator": "つばめ", "text": "そんなぉみやげあるんだ！"},
        { "location": "592/ACT"     , "narrator": "", "text": "ピヨコ"},
        { "location": "593/TALK"    , "narrator": "つばめ", "text": "なにそれぉみやげ？"},
        { "location": "594/ACT"     , "narrator": "", "text": "カレシ"},
        { "location": "595/TALK"    , "narrator": "つばめ", "text": "カレシ？そんなぉかしあるの？"},
        { "location": "596/SEL"     , "narrator": "", "text": "恋人のことだよ"},
        { "location": "597/TALK"    , "narrator": "つばめ", "text": "辛ぃのかな"},
        { "location": "598/TALK"    , "narrator": "つばめ", "text": "それカラシ"},
        { "location": "599/TALK"    , "narrator": "つばめ", "text": "なんてね_(┐「ε:)_"},
        { "location": "600/ACT"     , "narrator": "", "text": "恋人のことだよ"},
        { "location": "602/TALK"    , "narrator": "つばめ", "text": "やっぱりそうなの(ﾟ△ﾟ;ﾉ)ﾉ"},
        { "location": "603/TALK"    , "narrator": "つばめ", "text": "カレシなんて連れて帰ったらお父さんが大変だょ(´ｪ｀；)三(；´ｪ｀)"},
        { "location": "605/TALK"    , "narrator": "つばめ", "text": "またぉ話してくれる？"},
        { "location": "607/SEL"     , "narrator": "", "text": "もちろん"},
        { "location": "608/ACT"     , "narrator": "", "text": "もちろん"},
        { "location": "610/TALK"    , "narrator": "つばめ", "text": "ょかった"},
        { "location": "611/TALK"    , "narrator": "つばめ", "text": "じゃぁまたね(*´︶`*)"},
        { "location": "624/TALK"    , "narrator": "つばめ", "text": "最近のスマホって\nすごいなぁ。"},
        { "location": "625/TALK"    , "narrator": "つばめ", "text": "あんな人間みたいな\n[Bot]が使えるなんて。"},
        { "location": "626/TALK"    , "narrator": "つばめ", "text": "でも、お陰で迷いも\n晴れたし。"},
        { "location": "628/TALK"    , "narrator": "つばめ", "text": "よーし！\n明日から３日間！\n思いっきり楽しむよっ！"},
        { "location": "488/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>5月2日　9:33 PM</color>\n静岡・逢瀬邸\nリビングにて。"}
    ]
}
