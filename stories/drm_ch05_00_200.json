    "entry":
    [
        { "location": "1346/SCENARIO", "narrator": "", "text": "いらないでしょ？"},
        { "location": "1371/TALK"    , "narrator": "神楽", "text": "ぴょんこ任務早く終了させるにはどうすればいいか考えてみたぴょん"},
        { "location": "1373/SEL"     , "narrator": "", "text": "どうする気なの"},
        { "location": "1374/SEL"     , "narrator": "", "text": "そんなことできるの？"},
        { "location": "1375/SEL"     , "narrator": "", "text": "終わっちゃうのは寂しいな"},
        { "location": "1376/ACT"     , "narrator": "", "text": "どうする気なの"},
        { "location": "1377/TALK"    , "narrator": "神楽", "text": "それを今からお伝えしますね♪"},
        { "location": "1380/ACT"     , "narrator": "", "text": "そんなことできるの？"},
        { "location": "1381/TALK"    , "narrator": "神楽", "text": "できるかどうか"},
        { "location": "1382/TALK"    , "narrator": "神楽", "text": "いややるしかない？"},
        { "location": "1383/ACT"     , "narrator": "", "text": "終わっちゃうのは寂しいな"},
        { "location": "1384/TALK"    , "narrator": "神楽", "text": "そうですね～～～"},
        { "location": "1385/TALK"    , "narrator": "神楽", "text": "それはちょっと残念ですっ♪"},
        { "location": "1387/TALK"    , "narrator": "神楽", "text": "トライナリー全員の秘密を握って"},
        { "location": "1388/TALK"    , "narrator": "神楽", "text": "それを盾につばめさんを、、、っていうのはどうでしょうか？"},
        { "location": "1390/SEL"     , "narrator": "", "text": "どう、と言われても"},
        { "location": "1391/SEL"     , "narrator": "", "text": "無理があるんじゃない"},
        { "location": "1392/SEL"     , "narrator": "", "text": "よし、それで行こう"},
        { "location": "1393/ACT"     , "narrator": "", "text": "どう、と言われても"},
        { "location": "1394/TALK"    , "narrator": "神楽", "text": "聞いてるんですよ"},
        { "location": "1395/TALK"    , "narrator": "神楽", "text": "意見を"},
        { "location": "1396/ACT"     , "narrator": "", "text": "無理があるんじゃない"},
        { "location": "1397/TALK"    , "narrator": "神楽", "text": "そうでしょうか"},
        { "location": "1398/TALK"    , "narrator": "神楽", "text": "うーん、、、"},
        { "location": "1399/ACT"     , "narrator": "", "text": "よし、それで行こう"},
        { "location": "1400/TALK"    , "narrator": "神楽", "text": "やった～"},
        { "location": "1401/TALK"    , "narrator": "神楽", "text": "許可が出ましたよ♪"},
        { "location": "1404/SEL"     , "narrator": "", "text": "でも"},
        { "location": "1405/ACT"     , "narrator": "", "text": "でも"},
        { "location": "1407/TALK"    , "narrator": "神楽", "text": "はい、何でしょう？？？"},
        { "location": "1409/SEL"     , "narrator": "", "text": "そんなことする意味あるの？"},
        { "location": "1410/SEL"     , "narrator": "", "text": "実際できることなのかな？"},
        { "location": "1411/SEL"     , "narrator": "", "text": "$me$とのことはどうなるの？"},
        { "location": "1412/ACT"     , "narrator": "", "text": "そんなことする意味あるの？"},
        { "location": "1413/TALK"    , "narrator": "神楽", "text": "あると思うから言ってるんですよ"},
        { "location": "1414/ACT"     , "narrator": "", "text": "実際できることなのかな？"},
        { "location": "1415/TALK"    , "narrator": "神楽", "text": "やってみないとわからないです"},
        { "location": "1416/TALK"    , "narrator": "神楽", "text": "そんなの"},
        { "location": "1417/ACT"     , "narrator": "", "text": "$me$とのことはどうなるの？"},
        { "location": "1418/TALK"    , "narrator": "神楽", "text": "今はその話じゃないんです"},
        { "location": "1419/TALK"    , "narrator": "神楽", "text": "今は"},
        { "location": "1421/TALK"    , "narrator": "神楽", "text": "$handle$さんはぴょんこに任務を遂行して欲しくないんですか？"},
        { "location": "1422/TALK"    , "narrator": "神楽", "text": "ナビのくせに"},
        { "location": "1424/SEL"     , "narrator": "", "text": "ナビじゃないからなあ…"},
        { "location": "1425/SEL"     , "narrator": "", "text": "神楽の幸せを考えるとね…"},
        { "location": "1426/SEL"     , "narrator": "", "text": "できればしてほしくない"},
        { "location": "1427/ACT"     , "narrator": "", "text": "ナビじゃないからなあ…"},
        { "location": "1428/TALK"    , "narrator": "神楽", "text": "またまた～"},
        { "location": "1430/TALK"    , "narrator": "神楽", "text": "ぴょんこにその手は効きませんから"},
        { "location": "1431/ACT"     , "narrator": "", "text": "神楽の幸せを考えるとね…"},
        { "location": "1432/TALK"    , "narrator": "神楽", "text": "私の幸せとか"},
        { "location": "1433/ACT"     , "narrator": "", "text": "できればしてほしくない"},
        { "location": "1434/TALK"    , "narrator": "神楽", "text": "楽観的希望！"},
        { "location": "1436/TALK"    , "narrator": "神楽", "text": "実のところを言うともううんざりなんですよ"},
        { "location": "1437/TALK"    , "narrator": "神楽", "text": "この世界の偽善には"},
        { "location": "1439/SEL"     , "narrator": "", "text": "$me$がどうにかしてあげる"},
        { "location": "1440/SEL"     , "narrator": "", "text": "ごめんね、見守ることしかできなくて"},
        { "location": "1441/SEL"     , "narrator": "", "text": "わかるよ、その気持ち"},
        { "location": "1442/ACT"     , "narrator": "", "text": "$me$がどうにかしてあげる"},
        { "location": "1444/TALK"    , "narrator": "神楽", "text": "どうにかって"},
        { "location": "1445/TALK"    , "narrator": "神楽", "text": "どうやって？"},
        { "location": "1446/ACT"     , "narrator": "", "text": "ごめんね、見守ることしかできなくて"},
        { "location": "1448/TALK"    , "narrator": "神楽", "text": "謝れば大丈夫って思ってる？"},
        { "location": "1449/ACT"     , "narrator": "", "text": "わかるよ、その気持ち"},
        { "location": "1450/TALK"    , "narrator": "神楽", "text": "そういうのが偽善"},
        { "location": "1451/TALK"    , "narrator": "神楽", "text": "なんだけどな"},
        { "location": "1455/TALK"    , "narrator": "神楽", "text": "今日はちょっとぴょんこはぴょんこモードになり切れないみたい♪"},
        { "location": "1456/TALK"    , "narrator": "神楽", "text": "バイバイ★"},
        { "location": "1459/TALK"    , "narrator": "神楽", "text": "だけど、、、ちょっとだけ、、、"},
        { "location": "1462/TALK"    , "narrator": "ボイスメール", "text": "重すぎませんっ！？"},
        { "location": "1474/DIALOG"  , "narrator": "Dialog_GETVoice", "text": "<color=green>【神楽】</color>のボイスメール\n<color=red>【重すぎませんっ！？】</color>\nをゲットしました！"}
    ]
