{
    "dir": "chap16/daydra/dd_ch01_16_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "16156",
        "cid": "tsubame",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "アイスをかけた戦い"
    },
    "entry":
    [
        { "location": "297/SCENARIO", "narrator": "", "text": "アイスをかけた戦い"},
        { "location": "318/TALK"    , "narrator": "真幌", "text": "逢瀬、ちょっといいか？"},
        { "location": "319/TALK"    , "narrator": "つばめ", "text": "はい、どうかしました？"},
        { "location": "320/TALK"    , "narrator": "真幌", "text": "さっき冷蔵庫を開けたら、\nアイスが一つ余っててな。"},
        { "location": "321/TALK"    , "narrator": "真幌", "text": "私はいらんから、\n食べたい奴が\n食べてくれ。"},
        { "location": "322/TALK"    , "narrator": "つばめ", "text": "わかりました！"},
        { "location": "326/TALK"    , "narrator": "つばめ", "text": "卯月さんはバイトお休みだし\nあとの四人で――"},
        { "location": "328/TALK"    , "narrator": "つばめ", "text": "ジャンケンでもして\n決めちゃおうかな？"},
        { "location": "346/TALK"    , "narrator": "ガブリエラ", "text": "それじゃあ、一対一で\n勝負して三勝した人が\n勝ちってことでいいわね？"},
        { "location": "349/TALK"    , "narrator": "つばめ", "text": "わかりました！"},
        { "location": "350/TALK"    , "narrator": "みやび", "text": "それでえいよ。"},
        { "location": "353/TALK"    , "narrator": "アーヤ", "text": "全員で一気にじゃ\nダメなの？"},
        { "location": "354/TALK"    , "narrator": "ガブリエラ", "text": "こっちの方がゲーム\nっぽくて面白いでしょ？"},
        { "location": "355/TALK"    , "narrator": "みやび", "text": "ガブちゃん、一戦目の\n相手頼むがよ。"},
        { "location": "359/TALK"    , "narrator": "アーヤ", "text": "それじゃあ、\n私はつばめとね。"},
        { "location": "360/TALK"    , "narrator": "アーヤ", "text": "とりあえず、グーで\n行こうかしら？"},
        { "location": "362/TALK"    , "narrator": "つばめ", "text": "う～ん…\n何を出そうかなぁ？"},
        { "location": "363/SEL"     , "narrator": "", "text": "パーを出そう"},
        { "location": "366/TALK"    , "narrator": "つばめ", "text": "うーん、グーがいいかな？\nでも、逆にチョキで\nいった方がいいのかも。"},
        { "location": "368/TALK"    , "narrator": "つばめ", "text": "う～ん…悩んでも\n仕方ないし、\nそうしようかな？"},
        { "location": "372/TALK"    , "narrator": "アーヤ", "text": "じゃあ、準備はいい？"},
        { "location": "373/TALK"    , "narrator": "つばめ", "text": "はい！"},
        { "location": "377/TALK"    , "narrator": "アーヤ", "text": "じゃん、けん…。"},
        { "location": "380/TALK"    , "narrator": "つばめ", "text": "チョキ！"},
        { "location": "383/TALK"    , "narrator": "アーヤ", "text": "ふふっ、私の勝ちね。"},
        { "location": "385/TALK"    , "narrator": "つばめ", "text": "うう…\n負けちゃいましたぁ…。"},
        { "location": "386/TALK"    , "narrator": "つばめ", "text": "考え過ぎちゃったかな？\nやっぱり、グーでいった方が\nよかったかも。"},
        { "location": "388/ACT"     , "narrator": "", "text": "パーを出そう"},
        { "location": "420/TALK"    , "narrator": "つばめ", "text": "パーかぁ…アーヤさんも、\nグーって考えてるかも\nしれないし…。"},
        { "location": "421/TALK"    , "narrator": "つばめ", "text": "それで行ってみよ。"},
        { "location": "423/TALK"    , "narrator": "アーヤ", "text": "じゃあ、準備はいい？"},
        { "location": "424/TALK"    , "narrator": "つばめ", "text": "はい！"},
        { "location": "427/TALK"    , "narrator": "アーヤ", "text": "じゃん、けん…。"},
        { "location": "432/TALK"    , "narrator": "つばめ", "text": "パー！"},
        { "location": "436/TALK"    , "narrator": "つばめ", "text": "あっ、わたしの勝ちです！"},
        { "location": "439/TALK"    , "narrator": "アーヤ", "text": "あらら、負けちゃったわ。"},
        { "location": "442/TALK"    , "narrator": "ガブリエラ", "text": "うーっ、悔しいー！"},
        { "location": "443/TALK"    , "narrator": "つばめ", "text": "せんぱい、みやびさんに\n負けちゃったんですか？"},
        { "location": "446/TALK"    , "narrator": "ガブリエラ", "text": "聞かないでよ！"},
        { "location": "447/TALK"    , "narrator": "ガブリエラ", "text": "五回もあいこが続いたのに\n負けて、本気で悔しいん\nだから…。"},
        { "location": "449/TALK"    , "narrator": "ガブリエラ", "text": "こうなったら、つばめには\n一発で勝ってみせるわ。"},
        { "location": "450/TALK"    , "narrator": "ガブリエラ", "text": "確か、さっきはパーで\n勝ってたから、連続で\nパーはないわね。"},
        { "location": "451/TALK"    , "narrator": "ガブリエラ", "text": "だとすると、とりあえず\nグーを出しておけば\n負けはしないわね。"},
        { "location": "452/TALK"    , "narrator": "つばめ", "text": "う～ん…さっきはパーで\n勝ったから、次こそは\nグーかチョキかなぁ？"},
        { "location": "453/SEL"     , "narrator": "", "text": "もう一度パーだ！"},
        { "location": "455/TALK"    , "narrator": "つばめ", "text": "グーかチョキか…\nう～ん…。"},
        { "location": "456/TALK"    , "narrator": "つばめ", "text": "…チョキにしようかな？"},
        { "location": "461/TALK"    , "narrator": "ガブリエラ", "text": "それじゃ、行くわよ！\nじゃんけん…。"},
        { "location": "466/TALK"    , "narrator": "ガブリエラ", "text": "グー！"},
        { "location": "467/TALK"    , "narrator": "つばめ", "text": "チョキです！！"},
        { "location": "468/TALK"    , "narrator": "つばめ", "text": "あっ…あれ？"},
        { "location": "471/TALK"    , "narrator": "ガブリエラ", "text": "やった！\nあたしの勝ちよ！"},
        { "location": "473/TALK"    , "narrator": "つばめ", "text": "うう、\n負けちゃいました…。"},
        { "location": "475/TALK"    , "narrator": "ガブリエラ", "text": "さっきパー出してたから、\n同じのは出さない、って\n思ったのよ。"},
        { "location": "477/TALK"    , "narrator": "ガブリエラ", "text": "この調子で次も勝つわ。\nアーヤ、次はあたしよ！"},
        { "location": "480/TALK"    , "narrator": "つばめ", "text": "…せんぱい、\n凄く楽しんでて\n可愛いな…。"},
        { "location": "482/ACT"     , "narrator": "", "text": "もう一度パーだ！"},
        { "location": "513/TALK"    , "narrator": "つばめ", "text": "また指示が来てる。"},
        { "location": "515/TALK"    , "narrator": "つばめ", "text": "でも、同じのを連続で\n出すのって、ちょっとだけ\n不安かも…。"},
        { "location": "518/TALK"    , "narrator": "ガブリエラ", "text": "じゃあ、いくわよ。\nじゃーんけーん…。"},
        { "location": "520/TALK"    , "narrator": "つばめ", "text": "でも、信じてみよう！"},
        { "location": "523/TALK"    , "narrator": "つばめ", "text": "パー！"},
        { "location": "525/TALK"    , "narrator": "つばめ", "text": "…あれ？\nわたしの勝ちです！"},
        { "location": "526/TALK"    , "narrator": "ガブリエラ", "text": "もーっ、また負けたー！"},
        { "location": "527/TALK"    , "narrator": "ガブリエラ", "text": "二回連続で同じのは\n出してこないと\n思ったのに…。"},
        { "location": "529/TALK"    , "narrator": "つばめ", "text": "…また勝っちゃった。"},
        { "location": "530/TALK"    , "narrator": "つばめ", "text": "もしかして、次に何が\n出るかわかるのかな？"},
        { "location": "535/TALK"    , "narrator": "みやび", "text": "つばめちゃん、\n絶好調みたいやね。"},
        { "location": "536/TALK"    , "narrator": "つばめ", "text": "あ、はい…\nどうにか勝ててます。"},
        { "location": "538/TALK"    , "narrator": "みやび", "text": "うちも二勝してるき、\n優勝決定戦やね。"},
        { "location": "540/TALK"    , "narrator": "みやび", "text": "本気で行くぞね！"},
        { "location": "542/TALK"    , "narrator": "つばめ", "text": "はい！\nわたしも負けません！"},
        { "location": "543/TALK"    , "narrator": "みやび", "text": "…とは言うたけんど、\nここまで来ると何を出すか\n決められんなぁ。"},
        { "location": "544/TALK"    , "narrator": "みやび", "text": "…何も考えんで、\n適当に出してみるか。"},
        { "location": "545/TALK"    , "narrator": "つばめ", "text": "う～ん…次は何を出せば\nいいんだろう？"},
        { "location": "546/SEL"     , "narrator": "", "text": "多分、グーだ！！"},
        { "location": "548/TALK"    , "narrator": "つばめ", "text": "さっきまでは指示に\n従って勝ててたけど…。"},
        { "location": "549/TALK"    , "narrator": "つばめ", "text": "…どうしたのかな？"},
        { "location": "550/TALK"    , "narrator": "つばめ", "text": "今回は来ないのかな？"},
        { "location": "556/TALK"    , "narrator": "みやび", "text": "すっと始めるちや。\nつばめちゃん、いくがよ！"},
        { "location": "559/TALK"    , "narrator": "つばめ", "text": "は、はい！！\nじゃーんけーん…。"},
        { "location": "561/TALK"    , "narrator": "みやび", "text": "パーや！"},
        { "location": "562/TALK"    , "narrator": "つばめ", "text": "チョキです！！"},
        { "location": "566/TALK"    , "narrator": "つばめ", "text": "…わぁ、勝ったぁ！\n三連勝です！"},
        { "location": "569/TALK"    , "narrator": "みやび", "text": "はぁ…負けたがよ。\nあと一勝やったがに…。"},
        { "location": "571/TALK"    , "narrator": "みやび", "text": "賞品のアイスは\nつばめちゃんの物やね。"},
        { "location": "574/TALK"    , "narrator": "ガブリエラ", "text": "はぁ…結局一勝も\nできなかったわ…。"},
        { "location": "576/TALK"    , "narrator": "アーヤ", "text": "そういうこともあるわよ。\nおめでとう、つばめ。"},
        { "location": "579/TALK"    , "narrator": "つばめ", "text": "ありがとうございます！"},
        { "location": "581/TALK"    , "narrator": "つばめ", "text": "…そういえば、\n最後は何も指示が\n来なかったなぁ。"},
        { "location": "583/TALK"    , "narrator": "つばめ", "text": "もしかして、わたしが\n自力で勝つってわかって\nたから…なのかな？"},
        { "location": "600/ACT"     , "narrator": "", "text": "多分、グーだ！！"},
        { "location": "631/TALK"    , "narrator": "つばめ", "text": "…やっぱり来た。"},
        { "location": "632/TALK"    , "narrator": "つばめ", "text": "今度はグーかぁ…\nさすがに、三連続で\nパーはないみたい。"},
        { "location": "635/TALK"    , "narrator": "みやび", "text": "それじゃあ行くがよ！\nじゃん、けん…。"},
        { "location": "637/TALK"    , "narrator": "つばめ", "text": "よーし、これで\n三連勝だよ！"},
        { "location": "639/TALK"    , "narrator": "つばめ", "text": "グーです！！"},
        { "location": "640/TALK"    , "narrator": "みやび", "text": "パーや…。\n残念やったね、\nつばめちゃん。"},
        { "location": "644/TALK"    , "narrator": "つばめ", "text": "あ、あれ？\n負けちゃった…？"},
        { "location": "645/TALK"    , "narrator": "つばめ", "text": "ちゃんと指示通りに\n出したはずなのに…。"},
        { "location": "647/TALK"    , "narrator": "ガブリエラ", "text": "はぁ…優勝はみやびかぁ。"},
        { "location": "648/TALK"    , "narrator": "ガブリエラ", "text": "結局、あたしは一勝も\nできなかったわ。"},
        { "location": "650/TALK"    , "narrator": "アーヤ", "text": "そういうこともあるわよ。\nじゃんけんなんて\n運なんだから。"},
        { "location": "652/TALK"    , "narrator": "つばめ", "text": "…そっか。\nそうですよね。"},
        { "location": "653/TALK"    , "narrator": "つばめ", "text": "指示通りにすれば\n絶対に勝てると\n思っちゃってた…。"},
        { "location": "655/TALK"    , "narrator": "つばめ", "text": "ズルした罰が当たったの\nかもしれないなぁ…。"},
        { "location": "305/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>7月17日　4:04 PM</color>\nとある休日、神楽坂トライナリー劇場でのバイト中のこと。"},
        { "location": "594/DIALOG"  , "narrator": "Dialog_GEThimegoto_ch01", "text": "【未来予知者と明日の過去】"}
    ]
}
