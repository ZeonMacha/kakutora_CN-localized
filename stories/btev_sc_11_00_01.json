        "title": "【EXストーリー】渇求の魔女",
        "sub_title": "コネクトストーリー"
    },
    "entry":
    [
        { "location": "353/SCENARIO", "narrator": "", "text": "【導入】クランネフェル"},
        { "location": "359/DIALOG"  , "narrator": "", "text": "<size=40>CURAN STORY. 01</size>\nMIYABI KOIGAASKI\n\n<size=45>クランネフェル</size>\n<size=35>～屋上の国のアリス～</size>"},
        { "location": "375/TALK"    , "narrator": "みやび", "text": "ああ。\n来たかよ、\n$handle$。"},
        { "location": "376/TALK"    , "narrator": "みやび", "text": "ここは、うちら\nトライナリーと、\nクランたちとの交差点。"},
        { "location": "377/TALK"    , "narrator": "みやび", "text": "ココロとココロが\n出逢うて、共鳴して、\n繋がりあう場所ぞね。"},
        { "location": "378/TALK"    , "narrator": "みやび", "text": "ここでは、普段私たちを\n助けてくれるサーバント\nクランを紹介するきね。"},
        { "location": "379/TALK"    , "narrator": "みやび", "text": "ほんで、貴方が直接\n彼女らぁと繋がれる\nよう、手続きしちゅうき。"},
        { "location": "380/SEL"     , "narrator": "（選択肢）", "text": "アニメのクランが使えるようになるの？"},
        { "location": "381/ACT"     , "narrator": "", "text": "アニメのクランが使えるようになるの？"},
        { "location": "383/TALK"    , "narrator": "みやび", "text": "やねえ。\n簡単に言えば、\nやけんど。"},
        { "location": "384/TALK"    , "narrator": "みやび", "text": "このセクターでは、\nクラン一人にスポットを\n当てて紹介するきね。"},
        { "location": "385/TALK"    , "narrator": "みやび", "text": "ほんで彼女との【儀式】\nによって、貴方とココロを\n繋げちゃろう。"},
        { "location": "386/TALK"    , "narrator": "みやび", "text": "【儀式】には『コネクト』\nと『シンクロ』の２つが\nあるぞね。"},
        { "location": "387/TALK"    , "narrator": "みやび", "text": "『コネクト』は、貴方と\nクランが物理的に繋がる\nための儀式。"},
        { "location": "388/TALK"    , "narrator": "みやび", "text": "バトルして彼女と貴方の中に\nある、抵抗勢力を無力化\nするのに必要ぞね。"},
        { "location": "389/TALK"    , "narrator": "みやび", "text": "次の『シンクロ』では、\nクランの過去を知り、\n共感せんといかんねえ。"},
        { "location": "390/TALK"    , "narrator": "みやび", "text": "クランの過去の\n物語をシェアすることで、\n心が通じるようになるき。"},
        { "location": "391/TALK"    , "narrator": "みやび", "text": "ここまで、\nわかりゆう？"},
        { "location": "392/TALK"    , "narrator": "みやび", "text": "もし、入るセクターを\n間違えたんやったら\n退場できるけんど。"},
        { "location": "393/SEL"     , "narrator": "（選択肢）", "text": "いや、先に進む"},
        { "location": "394/SEL"     , "narrator": "（選択肢）", "text": "今回はやめとく"},
        { "location": "395/SEL"     , "narrator": "（選択肢）", "text": "みやびは別人格ないの？"},
        { "location": "396/ACT"     , "narrator": "", "text": "いや、先に進む"},
        { "location": "397/TALK"    , "narrator": "みやび", "text": "ええかね？\nほいたら早速、今回の\nクランを紹介するきね。"},
        { "location": "398/ACT"     , "narrator": "", "text": "今回はやめとく"},
        { "location": "399/TALK"    , "narrator": "みやび", "text": "ほう\nそうかよ。"},
        { "location": "400/TALK"    , "narrator": "みやび", "text": "そういたら、ここで\nさようならやねえ。"},
        { "location": "402/TALK"    , "narrator": "みやび", "text": "また気が向いたら\n来たらええき。"},
        { "location": "403/TALK"    , "narrator": "みやび", "text": "$handle$と\nうちに、\n素敵なココロの旅を。"},
        { "location": "405/ACT"     , "narrator": "", "text": "みやびは別人格ないの？"},
        { "location": "406/TALK"    , "narrator": "みやび", "text": "何を言い出すか\n思うたら。"},
        { "location": "408/TALK"    , "narrator": "みやび", "text": "そういうのは\nゲームの世界観を\n崩すきねえ。"},
        { "location": "409/TALK"    , "narrator": "みやび", "text": "そもそもうちは\n裏も表もない\n真っ正直な人間やき。"},
        { "location": "410/TALK"    , "narrator": "みやび", "text": "あえてのキャラ作りは\n必要ない思うちや。"},
        { "location": "411/TALK"    , "narrator": "みやび", "text": "そういうことで\nええかね？"},
        { "location": "412/TALK"    , "narrator": "みやび", "text": "そういうことで今回の\nクランを紹介するきね。"},
        { "location": "420/TALK"    , "narrator": "みやび", "text": "オープンプロセス、\n0x191番地から\n0xFFF番地へ。"},
        { "location": "421/TALK"    , "narrator": "みやび", "text": "共通意識野を経由、\n外部スフィアへ接続。"},
        { "location": "422/TALK"    , "narrator": "みやび", "text": "EXEC_SEEK_SECTOR\n=>Link() EXT_SPHERE/."},
        { "location": "447/TALK"    , "narrator": "みやび", "text": "シーク完了ぞね。"},
        { "location": "448/TALK"    , "narrator": "みやび", "text": "さて――。"},
        { "location": "449/TALK"    , "narrator": "みやび", "text": "今回、おんしに\n紹介するクランは\n<color=red>【クランネフェル】</color>。"},
        { "location": "451/TALK"    , "narrator": "みやび", "text": "発症者は香陵陽子。\n出身は長野県北佐久郡\n軽井沢町。"},
        { "location": "452/TALK"    , "narrator": "みやび", "text": "発症時の年齢は九歳。\nまだ小学校低学年の\nかわいい盛りやった。"},
        { "location": "454/TALK"    , "narrator": "みやび", "text": "――小学校には\n通うとらん\nかったけど。"},
        { "location": "456/TALK"    , "narrator": "みやび", "text": "陽子は先天性の\n心臓疾患があったき。"},
        { "location": "457/TALK"    , "narrator": "みやび", "text": "出生時、二十歳まで\n生きられんと\n宣告された。"},
        { "location": "458/TALK"    , "narrator": "みやび", "text": "それを聞いた母親は\n軽井沢の家を売り払い\n都内に引っ越した。"},
        { "location": "459/TALK"    , "narrator": "みやび", "text": "それは陽子を\n先進医療病院に\n入院させるため。"},
        { "location": "460/TALK"    , "narrator": "みやび", "text": "心臓移植さえできれば\n陽子は成人式を\n迎えられる。"},
        { "location": "461/TALK"    , "narrator": "みやび", "text": "それは母親の希望であり\n生きがいになった。"},
        { "location": "462/TALK"    , "narrator": "みやび", "text": "――けんどそう簡単に\n移植できる心臓は\n見つからん。"},
        { "location": "463/TALK"    , "narrator": "みやび", "text": "一度訪れたチャンスは\n権力の元に潰された。"},
        { "location": "464/TALK"    , "narrator": "みやび", "text": "嘆き悲しんだのは\n陽子より母親や。"},
        { "location": "465/TALK"    , "narrator": "みやび", "text": "そんな母親を\n元気にしたいという\n子供の切なる願いが。"},
        { "location": "466/TALK"    , "narrator": "みやび", "text": "クラン発症の原因とは\nなんたる皮肉。"},
        { "location": "468/TALK"    , "narrator": "みやび", "text": "…うちにとって\nクランネフェルは妹\nみたいなもんぞね。"},
        { "location": "469/SEL"     , "narrator": "（選択肢）", "text": "一番相性がいいってこと？"},
        { "location": "470/SEL"     , "narrator": "（選択肢）", "text": "ネフェルを気に入ってるの？"},
        { "location": "471/ACT"     , "narrator": "", "text": "一番相性がいいってこと？"},
        { "location": "472/TALK"    , "narrator": "みやび", "text": "相性だけで言うたら\nつばめちゃんの方が\n近かったかもしれんね。"},
        { "location": "473/ACT"     , "narrator": "", "text": "ネフェルを気に入ってるの？"},
        { "location": "475/TALK"    , "narrator": "みやび", "text": "難しい質問ぞね。"},
        { "location": "476/TALK"    , "narrator": "みやび", "text": "もちろん嫌いでは\nないけんど。"},
        { "location": "477/TALK"    , "narrator": "みやび", "text": "成り行き的な\n部分もあるきね。"},
        { "location": "478/SEL"     , "narrator": "（選択肢）", "text": "$me$もネフェルと精神を共有しなきゃだね"},
        { "location": "479/ACT"     , "narrator": "", "text": "$me$もネフェルと精神を共有しなきゃだね"},
        { "location": "481/TALK"    , "narrator": "みやび", "text": "そうやね。\nまずは『コネクト』の\nプロセスをせんとね。"},
        { "location": "482/TALK"    , "narrator": "みやび", "text": "具体的には、\nネフェルの抵抗する\n意志と戦わんといかんき。"},
        { "location": "483/TALK"    , "narrator": "みやび", "text": "それが終わったら、\nネフェルの話を\nこじゃんと聞きゆう。"},
        { "location": "484/TALK"    , "narrator": "みやび", "text": "$handle$が\nそれを共有したら\n『シンクロ』完了やき。"},
        { "location": "485/TALK"    , "narrator": "みやび", "text": "『コネクト』『シンクロ』\n両方完了したら\n終了や。"},
        { "location": "486/SEL"     , "narrator": "（選択肢）", "text": "そしたら【ネフェル】が使えるの？"},
        { "location": "487/ACT"     , "narrator": "", "text": "そしたら【ネフェル】が使えるの？"},
        { "location": "489/TALK"    , "narrator": "みやび", "text": "そういうことに\nなるねえ。"},
        { "location": "490/TALK"    , "narrator": "みやび", "text": "しかも特別に\nうちのことも\n教えちゃろう。"},
        { "location": "491/TALK"    , "narrator": "みやび", "text": "やき、『シンクロ』\nまで完了した方が\nお得ぞね。"},
        { "location": "492/TALK"    , "narrator": "みやび", "text": "ほいたら早速、\nネフェルの世界に\nアクセスするき。"},
        { "location": "494/TALK"    , "narrator": "みやび", "text": "$handle$と\nうちとネフェルに、\n素敵なココロの旅を！"}
    ]
}
