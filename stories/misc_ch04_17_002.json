    "entry":
    [
        { "location": "68/SCENARIO", "narrator": "", "text": "026_振りをするには"},
        { "location": "93/TALK"    , "narrator": "みやび", "text": "完全に他人になりすますなどという芸当ができると思うかね"},
        { "location": "94/TALK"    , "narrator": "みやび", "text": "現実社会で"},
        { "location": "96/SEL"     , "narrator": "", "text": "無理"},
        { "location": "97/SEL"     , "narrator": "", "text": "頑張ってみようかな"},
        { "location": "98/SEL"     , "narrator": "", "text": "なんでそんなことを？"},
        { "location": "99/ACT"     , "narrator": "", "text": "無理"},
        { "location": "100/TALK"   , "narrator": "みやび", "text": "ややや"},
        { "location": "101/ACT"    , "narrator": "", "text": "頑張ってみようかな"},
        { "location": "103/TALK"   , "narrator": "みやび", "text": "お"},
        { "location": "104/TALK"   , "narrator": "みやび", "text": "まっこと心強い"},
        { "location": "106/TALK"   , "narrator": "みやび", "text": "期待しちょるきね"},
        { "location": "107/ACT"    , "narrator": "", "text": "なんでそんなことを？"},
        { "location": "109/TALK"   , "narrator": "みやび", "text": "いや"},
        { "location": "110/TALK"   , "narrator": "みやび", "text": "なんとなく"},
        { "location": "113/TALK"   , "narrator": "みやび", "text": "要は"},
        { "location": "114/TALK"   , "narrator": "みやび", "text": "人はどうやって自分自身と他者の区別をつけているのか"},
        { "location": "115/TALK"   , "narrator": "みやび", "text": "また他者をどうやって認識しているのかという問い"},
        { "location": "117/SEL"    , "narrator": "", "text": "雰囲気とか"},
        { "location": "118/SEL"    , "narrator": "", "text": "見た目が100パーセント"},
        { "location": "119/SEL"    , "narrator": "", "text": "$me$は何があってもみやびを認識するよ"},
        { "location": "120/ACT"    , "narrator": "", "text": "雰囲気とか"},
        { "location": "121/TALK"   , "narrator": "みやび", "text": "その雰囲気自体を偽装されたらどうする？"},
        { "location": "122/ACT"    , "narrator": "", "text": "見た目が100パーセント"},
        { "location": "123/TALK"   , "narrator": "みやび", "text": "世の中には"},
        { "location": "124/TALK"   , "narrator": "みやび", "text": "眼鏡をかけるだけでもう他人と認識してしまうような輩もおるのだぞ"},
        { "location": "125/ACT"    , "narrator": "", "text": "$me$は何があってもみやびを認識するよ"},
        { "location": "127/TALK"   , "narrator": "みやび", "text": "それは魂のレベルでということか"},
        { "location": "128/TALK"   , "narrator": "みやび", "text": "できる自信があるのか"},
        { "location": "129/TALK"   , "narrator": "みやび", "text": "よく言った"},
        { "location": "131/TALK"   , "narrator": "みやび", "text": "実際な"},
        { "location": "132/TALK"   , "narrator": "みやび", "text": "役者ならある程度のことまではできると思うのだ"},
        { "location": "133/TALK"   , "narrator": "みやび", "text": "しかしその状態のまま"},
        { "location": "135/TALK"   , "narrator": "みやび", "text": "日常生活は送れるものだろうか"}
    ]
}
