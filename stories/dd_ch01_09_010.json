{
    "dir": "chap09/daydra/dd_ch01_09_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "9152",
        "cid": "tsubame",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "罰ゲーム"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "罰ゲーム"},
        { "location": "29/TALK"   , "narrator": "つばめ", "text": "う～ん…\nどれにしようかなぁ？"},
        { "location": "31/TALK"   , "narrator": "キリト", "text": "どれ選んでも地雷っぽい\nのが酷ぇな。"},
        { "location": "32/TALK"   , "narrator": "ヒカル", "text": "そうですね…。\nこれなんか、飲み物として\nどうなんでしょう？"},
        { "location": "33/TALK"   , "narrator": "雛", "text": "えっと…繊維質たっぷり\nゴボウジュース？"},
        { "location": "34/TALK"   , "narrator": "雛", "text": "どんな味なんだろ？"},
        { "location": "35/TALK"   , "narrator": "つばめ", "text": "ちょっと、土っぽい味が\nしそうだから、それは\n避けたいな。"},
        { "location": "36/TALK"   , "narrator": "雛", "text": "はぁ…さすがは我が校一、\nヘンテコなラインナップの\n自販機だね。"},
        { "location": "37/TALK"   , "narrator": "ヒカル", "text": "逢瀬さん、やっぱり\nやめた方がいいですよ。"},
        { "location": "40/TALK"   , "narrator": "つばめ", "text": "ダメだよ。\nゲームで負けた人が、\nここのジュースを飲む――"},
        { "location": "41/TALK"   , "narrator": "つばめ", "text": "そういうルール\nなんだから。"},
        { "location": "43/TALK"   , "narrator": "キリト", "text": "逢瀬の言う通りだぜ。\nじゃなきゃゲームやった\n意味なくなっちまうだろ。"},
        { "location": "44/TALK"   , "narrator": "キリト", "text": "…けど、あんまりヤバそう\nなのは避けような？"},
        { "location": "45/TALK"   , "narrator": "雛", "text": "そうだね。\n飲めなかったら\n無駄になっちゃうし。"},
        { "location": "46/TALK"   , "narrator": "雛", "text": "…あっ、これなんかどう？\n「蜂蜜桃林檎ジュース」\nだって。"},
        { "location": "48/TALK"   , "narrator": "キリト", "text": "…怪しいな。"},
        { "location": "50/TALK"   , "narrator": "雛", "text": "どこも怪しくないって。\n一番まともそうなのを\n選んだのに。"},
        { "location": "54/TALK"   , "narrator": "キリト", "text": "ヘンテコ自販機の中で、\n一番まともそうなのが\n怪しいんだよ。"},
        { "location": "57/TALK"   , "narrator": "キリト", "text": "俺としては…\nああ、これなんか\nいいと思うぞ。"},
        { "location": "60/TALK"   , "narrator": "つばめ", "text": "えっと…「ディス・イズ・\nプロテイン」？"},
        { "location": "61/TALK"   , "narrator": "つばめ", "text": "わたし、プロテインって\n飲んだことないから、\nちょっと気になるかも。"},
        { "location": "62/TALK"   , "narrator": "雛", "text": "やめた方がいいと思うよ？"},
        { "location": "63/TALK"   , "narrator": "ヒカル", "text": "そうですね。\nそれにするならまだ――"},
        { "location": "64/TALK"   , "narrator": "ヒカル", "text": "この「濃厚イモゼリー\nドリンク」の方が良いと\n思いますよ？"},
        { "location": "67/TALK"   , "narrator": "キリト", "text": "これはこれで、\n結構キツそうな気が\nするぞ？"},
        { "location": "68/TALK"   , "narrator": "ヒカル", "text": "液体よりゼリーの方が、\n何となくマシな気が\nしたんですが…。"},
        { "location": "71/TALK"   , "narrator": "つばめ", "text": "う～ん…どうしよう…。\nみんなが選んでくれた\n中から決めようかな？"},
        { "location": "75/SEL"    , "narrator": "", "text": "蜂蜜桃林檎ジュース"},
        { "location": "76/SEL"    , "narrator": "", "text": "ディス・イズ・プロテイン"},
        { "location": "77/SEL"    , "narrator": "", "text": "濃厚イモゼリードリンク"},
        { "location": "80/TALK"   , "narrator": "雛", "text": "べ、別に良いんだよ？\nあたし達が選んだ中から\nじゃなくたって。"},
        { "location": "84/TALK"   , "narrator": "つばめ", "text": "ううん、そうじゃないの。"},
        { "location": "85/TALK"   , "narrator": "つばめ", "text": "その三つ以外だと、\nどれもハズレばっかりな\n気がして…。"},
        { "location": "86/TALK"   , "narrator": "キリト", "text": "…罰ゲーム、\n少しキツかったか？"},
        { "location": "88/TALK"   , "narrator": "つばめ", "text": "そんなことないよ。"},
        { "location": "89/TALK"   , "narrator": "つばめ", "text": "こういう罰ゲームって、\nちょっと怖いけど――"},
        { "location": "90/TALK"   , "narrator": "つばめ", "text": "何が出るかわからなくて\nワクワクするから、\n結構好きなの。"},
        { "location": "93/TALK"   , "narrator": "つばめ", "text": "じゃあ…ひなこちゃんが\n選んだのを買ってみるね。"},
        { "location": "97/TALK"   , "narrator": "雛", "text": "大丈夫かなー？\n少しでも美味しいと\n良いんだけど…。"},
        { "location": "99/TALK"   , "narrator": "つばめ", "text": "よーし…それじゃあ\n開けるよ…えいっ！"},
        { "location": "101/TALK"  , "narrator": "雛", "text": "…炭酸は入ってない\nみたいだね。"},
        { "location": "103/TALK"  , "narrator": "つばめ", "text": "うん…桃の匂いが\nちょっと強いかも。"},
        { "location": "104/TALK"  , "narrator": "つばめ", "text": "味はどうかな…んくっ。"},
        { "location": "105/TALK"  , "narrator": "ヒカル", "text": "……ど、どうですか？"},
        { "location": "109/TALK"  , "narrator": "つばめ", "text": "んっ、んんっ！！"},
        { "location": "114/TALK"  , "narrator": "つばめ", "text": "これ…もしかしたら\n当たりかも。"},
        { "location": "117/TALK"  , "narrator": "キリト", "text": "マジか！？"},
        { "location": "120/TALK"  , "narrator": "雛", "text": "美味しかったの！？"},
        { "location": "122/TALK"  , "narrator": "つばめ", "text": "うん、凄く美味しいよ。\nこれなら時々は買って\n飲みたいかも。"},
        { "location": "123/TALK"  , "narrator": "ヒカル", "text": "えっ？\n凄く美味しいのに、\n時々なんですか？"},
        { "location": "126/TALK"  , "narrator": "つばめ", "text": "美味しいけど…\nビックリするほど\n甘いの。"},
        { "location": "127/TALK"  , "narrator": "つばめ", "text": "何の甘さだろ？\nんくっ、んくっ…。"},
        { "location": "128/TALK"  , "narrator": "雛", "text": "…ずっと飲み続けてるし、\n美味しいのは間違いない\nみたい。"},
        { "location": "129/TALK"  , "narrator": "キリト", "text": "でも、凄く甘いんだろ？\n俺には向いてなさそうだ。"},
        { "location": "130/TALK"  , "narrator": "つばめ", "text": "疲れてる時なら\n美味しく飲めるかも\nしれないよ？"},
        { "location": "131/TALK"  , "narrator": "雛", "text": "糖分の補給は十分に\nできそうだよね。"},
        { "location": "132/TALK"  , "narrator": "ヒカル", "text": "疲れてるときに、それを\n飲もう、って気になれば\nいいんですが…。"},
        { "location": "134/ACT"   , "narrator": "", "text": "蜂蜜桃林檎ジュース"},
        { "location": "154/TALK"  , "narrator": "つばめ", "text": "うん、それが一番安全っぽいよね"},
        { "location": "155/TALK"  , "narrator": "つばめ", "text": "キリトくんは怪しがってたけど"},
        { "location": "156/TALK"  , "narrator": "つばめ", "text": "やっぱり、これにするよ"},
        { "location": "168/TALK"  , "narrator": "つばめ", "text": "じゃあ…ひなこちゃんが\n選んだのを買ってみるね。"},
        { "location": "169/TALK"  , "narrator": "雛", "text": "大丈夫かなー？\n少しでも美味しいと\n良いんだけど…。"},
        { "location": "171/TALK"  , "narrator": "つばめ", "text": "よーし…それじゃあ\n開けるよ…えいっ！"},
        { "location": "173/TALK"  , "narrator": "雛", "text": "…炭酸は入ってない\nみたいだね。"},
        { "location": "175/TALK"  , "narrator": "つばめ", "text": "うん…桃の匂いが\nちょっと強いかも。"},
        { "location": "176/TALK"  , "narrator": "つばめ", "text": "味はどうかな…んくっ。"},
        { "location": "177/TALK"  , "narrator": "ヒカル", "text": "……ど、どうですか？"},
        { "location": "181/TALK"  , "narrator": "つばめ", "text": "んっ、んんっ！！"},
        { "location": "186/TALK"  , "narrator": "つばめ", "text": "美味しい！\nこれ、当たりだよ！"},
        { "location": "189/TALK"  , "narrator": "キリト", "text": "マジか！？"},
        { "location": "192/TALK"  , "narrator": "雛", "text": "美味しかったの！？"},
        { "location": "194/TALK"  , "narrator": "つばめ", "text": "うん、凄く美味しいよ。\nこれなら時々は買って\n飲みたいかも。"},
        { "location": "195/TALK"  , "narrator": "ヒカル", "text": "えっ？\n凄く美味しいのに、\n時々なんですか？"},
        { "location": "197/TALK"  , "narrator": "つばめ", "text": "美味しいけど…\nビックリするほど\n甘いの。"},
        { "location": "200/TALK"  , "narrator": "つばめ", "text": "何の甘さだろ？\nんくっ、んくっ…。"},
        { "location": "201/TALK"  , "narrator": "雛", "text": "…ずっと飲み続けてるし、\n美味しいのは間違いない\nみたい。"},
        { "location": "202/TALK"  , "narrator": "キリト", "text": "でも、凄く甘いんだろ？\n俺には向いてなさそうだ。"},
        { "location": "204/TALK"  , "narrator": "つばめ", "text": "疲れてる時なら\n美味しく飲めるかも\nしれないよ？"},
        { "location": "205/TALK"  , "narrator": "雛", "text": "糖分の補給は十分に\nできそうだよね。"},
        { "location": "206/TALK"  , "narrator": "ヒカル", "text": "疲れてるときに、それを\n飲もう、って気になれば\nいいんですが…。"},
        { "location": "207/ACT"   , "narrator": "", "text": "ディス・イズ・プロテイン"},
        { "location": "228/TALK"  , "narrator": "つばめ", "text": "ひなこちゃんには止められたけど"},
        { "location": "229/TALK"  , "narrator": "つばめ", "text": "やっぱりそれにしようかな？"},
        { "location": "230/TALK"  , "narrator": "つばめ", "text": "飲みたい、って思うのを買った方がいいよね"},
        { "location": "242/TALK"  , "narrator": "つばめ", "text": "プロテインのジュースを\n買ってみるよ。"},
        { "location": "243/TALK"  , "narrator": "雛", "text": "よりにもよってそれ！？"},
        { "location": "245/TALK"  , "narrator": "キリト", "text": "逢瀬、おまえプロテイン\n飲んだことないんだろ？"},
        { "location": "247/TALK"  , "narrator": "つばめ", "text": "うん、だから一度飲んで\nみたいと思ってたの。"},
        { "location": "248/TALK"  , "narrator": "ヒカル", "text": "それなら、まずは\n普通に売ってる粉のを\n試してからの方が――"},
        { "location": "252/TALK"  , "narrator": "ヒカル", "text": "ああ…\n買っちゃいましたね。"},
        { "location": "256/TALK"  , "narrator": "つばめ", "text": "プレーンタイプ、だって。\nちょっと楽しみかも。"},
        { "location": "257/TALK"  , "narrator": "つばめ", "text": "いただきまーす。\nんくっ…。"},
        { "location": "261/TALK"  , "narrator": "つばめ", "text": "…んっ！？"},
        { "location": "263/TALK"  , "narrator": "雛", "text": "つ、つばめちゃん！？"},
        { "location": "265/TALK"  , "narrator": "つばめ", "text": "けほっ、けほけほっ！\n…だ、大丈夫…平気だよ。"},
        { "location": "266/TALK"  , "narrator": "キリト", "text": "やっぱ、不味かったか？"},
        { "location": "268/TALK"  , "narrator": "つばめ", "text": "けほっ、けほっ…\nううん、そうじゃないの。"},
        { "location": "269/TALK"  , "narrator": "つばめ", "text": "味は…好きじゃないけど、\n飲めない、って味でも\nなかったよ。"},
        { "location": "271/TALK"  , "narrator": "つばめ", "text": "けど、ちょっと粉っぽい\n感じがして、喉が…。"},
        { "location": "272/TALK"  , "narrator": "ヒカル", "text": "ありますよね。\n粉っぽいプロテインって。"},
        { "location": "273/TALK"  , "narrator": "キリト", "text": "そんなの再現しないで、\n飲みやすくした方が\nいいだろうにな。"},
        { "location": "274/TALK"  , "narrator": "つばめ", "text": "でも、ずっと気になってた\nプロテインの味が\nわかったから――"},
        { "location": "275/TALK"  , "narrator": "つばめ", "text": "それだけでも\nよかったと思うよ。"},
        { "location": "276/TALK"  , "narrator": "雛", "text": "つばめちゃんのそういう\nポジティブなところ、\n素直に尊敬するよ。"},
        { "location": "277/ACT"   , "narrator": "", "text": "濃厚イモゼリードリンク"},
        { "location": "297/TALK"  , "narrator": "つばめ", "text": "わたしも、これは結構美味しいと思うの"},
        { "location": "298/TALK"  , "narrator": "つばめ", "text": "それに、ゼリーだから飲みやすそうだし"},
        { "location": "299/TALK"  , "narrator": "つばめ", "text": "食べやすそう、って言った方がいいのかな？"},
        { "location": "311/TALK"  , "narrator": "つばめ", "text": "決めた。\nイモゼリーのジュースに\nしてみるよ。"},
        { "location": "312/TALK"  , "narrator": "キリト", "text": "マジかよ…イモだぞ？"},
        { "location": "314/TALK"  , "narrator": "つばめ", "text": "ゴボウよりかは、\n美味しいと思うよ？"},
        { "location": "315/TALK"  , "narrator": "キリト", "text": "そりゃそうかも\nしんねぇけど…。"},
        { "location": "320/TALK"  , "narrator": "雛", "text": "あっ、買っちゃった…。"},
        { "location": "322/TALK"  , "narrator": "キリト", "text": "あ～あ…おい、ヒカル。\nもし飲みきれなかったら\n責任取ってやれよ？"},
        { "location": "325/TALK"  , "narrator": "ヒカル", "text": "えぇっ！？"},
        { "location": "326/TALK"  , "narrator": "つばめ", "text": "大丈夫だよ。\nそんなに不味そうには\n思えないし。"},
        { "location": "332/TALK"  , "narrator": "つばめ", "text": "それに、罰ゲームだから\nちょっと変わったのに\nしないと面白くないよ。"},
        { "location": "333/TALK"  , "narrator": "雛", "text": "真面目か！？"},
        { "location": "336/TALK"  , "narrator": "つばめ", "text": "じゃあ、飲んでみるね。\nちゅぅーっ…。"},
        { "location": "337/TALK"  , "narrator": "ヒカル", "text": "ああっ、そんな勢いよく\n飲まなくても…。"},
        { "location": "339/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "343/TALK"  , "narrator": "つばめ", "text": "あっ…これ、美味しい。"},
        { "location": "344/TALK"  , "narrator": "キリト", "text": "マジかよ！？\nだってイモだろ？"},
        { "location": "346/TALK"  , "narrator": "つばめ", "text": "うん、甘いお芋の味がして\n凄く美味しいの。"},
        { "location": "348/TALK"  , "narrator": "つばめ", "text": "えへへ、大当たりだね。\nありがと、ヒカルくん。"},
        { "location": "349/TALK"  , "narrator": "ヒカル", "text": "…どういたしまして、と\n言うべきでしょうか？"},
        { "location": "352/TALK"  , "narrator": "つばめ", "text": "…でもこれ、ちょっと\n喉が渇く味かも。\nお芋だからかな？"},
        { "location": "353/TALK"  , "narrator": "雛", "text": "単体で飲むのは、\nちょっとキツいかも\nしれないね。"},
        { "location": "355/TALK"  , "narrator": "つばめ", "text": "じゃあ、\n蜂蜜桃林檎ジュースも\n買ってみよっと。"},
        { "location": "357/TALK"  , "narrator": "キリト", "text": "お、おい逢瀬！\n二本目は普通ので――。"},
        { "location": "364/TALK"  , "narrator": "キリト", "text": "…間に合わなかったか。"},
        { "location": "365/TALK"  , "narrator": "つばめ", "text": "そんな変なジュース、\nってわけじゃなさそう\nだし、平気だよ。"},
        { "location": "366/TALK"  , "narrator": "雛", "text": "無理はしないでね？\n不味かったら残して\nいいんだから。"},
        { "location": "368/TALK"  , "narrator": "つばめ", "text": "うん…んくっ…。"},
        { "location": "372/TALK"  , "narrator": "つばめ", "text": "んっ！？\nあ、甘ーい！！"},
        { "location": "376/TALK"  , "narrator": "ヒカル", "text": "あ、甘い？"},
        { "location": "378/TALK"  , "narrator": "つばめ", "text": "こ、これ、ビックリする\nくらい甘いの！"},
        { "location": "379/TALK"  , "narrator": "キリト", "text": "甘いの二連発か。\nキツいな…。"},
        { "location": "381/TALK"  , "narrator": "つばめ", "text": "普通の炭酸にすれば\nよかった…。"},
        { "location": "382/TALK"  , "narrator": "雛", "text": "やっぱり、ここの自販機は\n危険だね。"},
        { "location": "17/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>5月23日　12:15 PM</color>\nとある昼休み、学食横の自販機コーナーにて。"}
    ]
}
