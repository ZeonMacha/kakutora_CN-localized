    "entry":
    [
        { "location": "506/SCENARIO", "narrator": "", "text": "千羽鶴恋愛ゲーム"},
        { "location": "526/TALK"    , "narrator": "千羽鶴", "text": "ここは、必ず恋が\n成就するといわれている、\n伝説の草原。"},
        { "location": "527/SEL"     , "narrator": "", "text": "キャベツ畑じゃ…"},
        { "location": "528/ACT"     , "narrator": "", "text": "キャベツ畑じゃ…"},
        { "location": "530/TALK"    , "narrator": "千羽鶴", "text": "予算の都合。\n脳内で補完して。"},
        { "location": "531/TALK"    , "narrator": "千羽鶴", "text": "そこには今日も、\n素敵な恋を求めて\nカップルが集う――"},
        { "location": "532/SEL"     , "narrator": "", "text": "なんで千羽鶴がナレーションを…"},
        { "location": "533/ACT"     , "narrator": "", "text": "なんで千羽鶴がナレーションを…"},
        { "location": "535/TALK"    , "narrator": "千羽鶴", "text": "私は千羽鶴じゃない。\nナレーション・チー。"},
        { "location": "536/SEL"     , "narrator": "", "text": "あ、はい…"},
        { "location": "537/ACT"     , "narrator": "", "text": "あ、はい…"},
        { "location": "539/TALK"    , "narrator": "千羽鶴", "text": "――これは、そんな\n素敵な地での、１つの\n恋の物語。"},
        { "location": "541/TALK"    , "narrator": "千羽鶴", "text": "あっ、あなたは！"},
        { "location": "542/TALK"    , "narrator": "千羽鶴", "text": "好きです！\nつき合ってください！"},
        { "location": "543/SEL"     , "narrator": "", "text": "喜んで！"},
        { "location": "544/SEL"     , "narrator": "", "text": "早っ！"},
        { "location": "545/SEL"     , "narrator": "", "text": "恋愛ゲーは段取りが重要ですよ"},
        { "location": "546/ACT"     , "narrator": "", "text": "喜んで！"},
        { "location": "548/TALK"    , "narrator": "千羽鶴", "text": "早すぎ！\n嫌いよ！"},
        { "location": "549/TALK"    , "narrator": "千羽鶴", "text": "ゲームオーバー。"},
        { "location": "550/SEL"     , "narrator": "", "text": "えええええ……"},
        { "location": "551/ACT"     , "narrator": "", "text": "えええええ……"},
        { "location": "554/ACT"     , "narrator": "", "text": "早っ！"},
        { "location": "556/TALK"    , "narrator": "千羽鶴", "text": "だって！\nもう貴方無しでは\n生きていけないもの！"},
        { "location": "557/SEL"     , "narrator": "", "text": "$me$もだよ、千羽鶴！"},
        { "location": "558/SEL"     , "narrator": "", "text": "ダメだ！$me$がいなくても一人で生きていくんだ千羽鶴。"},
        { "location": "559/ACT"     , "narrator": "", "text": "$me$もだよ、千羽鶴！"},
        { "location": "561/TALK"    , "narrator": "千羽鶴", "text": "嬉しい！\n$handle$…。"},
        { "location": "562/TALK"    , "narrator": "千羽鶴", "text": "じゃあ、これからも毎日\nこのアプリを起動して\nくれるわね？"},
        { "location": "563/SEL"     , "narrator": "", "text": "はい"},
        { "location": "564/SEL"     , "narrator": "", "text": "もちろん"},
        { "location": "565/SEL"     , "narrator": "", "text": "イエス！"},
        { "location": "566/ACT"     , "narrator": "", "text": "はい"},
        { "location": "567/ACT"     , "narrator": "", "text": "もちろん"},
        { "location": "568/ACT"     , "narrator": "", "text": "イエス！"},
        { "location": "570/TALK"    , "narrator": "千羽鶴", "text": "よかった。\nめでたしめでたし。"},
        { "location": "571/TALK"    , "narrator": "千羽鶴", "text": "おしまい。"},
        { "location": "572/SEL"     , "narrator": "", "text": "千羽鶴と恋人になれたの？"},
        { "location": "573/ACT"     , "narrator": "", "text": "千羽鶴と恋人になれたの？"},
        { "location": "575/TALK"    , "narrator": "千羽鶴", "text": "いいえ。"},
        { "location": "576/TALK"    , "narrator": "千羽鶴", "text": "貴方がアプリを毎日起動\nするって約束してくれた\nからハッピーエンド。"},
        { "location": "577/TALK"    , "narrator": "千羽鶴", "text": "これぞWIN-WIN。"},
        { "location": "578/SEL"     , "narrator": "", "text": "いやいやいや、選択の余地なかったし"},
        { "location": "579/ACT"     , "narrator": "", "text": "いやいやいや、選択の余地なかったし"},
        { "location": "581/TALK"    , "narrator": "千羽鶴", "text": "ちゃんと三択\n用意してるし。"},
        { "location": "582/SEL"     , "narrator": "", "text": "全部同じじゃん"},
        { "location": "583/ACT"     , "narrator": "", "text": "全部同じじゃん"},
        { "location": "585/TALK"    , "narrator": "千羽鶴", "text": "微妙なニュアンスが\n違うから、気分によって\n選択できる。"},
        { "location": "586/TALK"    , "narrator": "千羽鶴", "text": "とにかくハッピーエンドは\nハッピーエンドだから。\nおしまい。"},
        { "location": "588/ACT"     , "narrator": "", "text": "ダメだ！$me$がいなくても一人で生きていくんだ千羽鶴。"},
        { "location": "589/TALK"    , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "590/SEL"     , "narrator": "", "text": "は？"},
        { "location": "591/ACT"     , "narrator": "", "text": "は？"},
        { "location": "593/TALK"    , "narrator": "千羽鶴", "text": "ゲームオーバー。"},
        { "location": "596/ACT"     , "narrator": "", "text": "恋愛ゲーは段取りが重要ですよ"},
        { "location": "597/TALK"    , "narrator": "千羽鶴", "text": "……。"},
        { "location": "599/TALK"    , "narrator": "千羽鶴", "text": "ちょっとお花を\n摘みに行ってくるわ♪"},
        { "location": "602/TALK"    , "narrator": "千羽鶴", "text": "$handle$よ。\n私はこの世界を司る神。"},
        { "location": "603/SEL"     , "narrator": "", "text": "何やってるんすか、千羽鶴さん…"},
        { "location": "604/ACT"     , "narrator": "", "text": "何やってるんすか、千羽鶴さん…"},
        { "location": "606/TALK"    , "narrator": "千羽鶴", "text": "千羽鶴ではありません。\n私は神。"},
        { "location": "607/TALK"    , "narrator": "千羽鶴", "text": "貴方はこの世界の摂理に\n文句をつけました。"},
        { "location": "608/TALK"    , "narrator": "千羽鶴", "text": "文句をつけるからには\n貴方の主張を述べなさい。\n20文字以内で。"},
        { "location": "609/SEL"     , "narrator": "", "text": "いきなり告白されても感情移入できません"},
        { "location": "610/SEL"     , "narrator": "", "text": "もっと千羽鶴さんの可愛い所見たりデートしたりしたいです"},
        { "location": "611/ACT"     , "narrator": "", "text": "いきなり告白されても感情移入できません"},
        { "location": "612/TALK"    , "narrator": "千羽鶴", "text": "なるほど。\n$handle$の\n言い分はわかりました。"},
        { "location": "613/TALK"    , "narrator": "千羽鶴", "text": "それでは、\n５秒待ちなさい。"},
        { "location": "614/SEL"     , "narrator": "", "text": "あ、はい…"},
        { "location": "615/ACT"     , "narrator": "", "text": "あ、はい…"},
        { "location": "618/TALK"    , "narrator": "千羽鶴", "text": "……できた。"},
        { "location": "621/TALK"    , "narrator": "千羽鶴", "text": "まあ！\n貴方は$handle$！"},
        { "location": "623/TALK"    , "narrator": "千羽鶴", "text": "私は中学校卒業後父の稼業\nが破綻して倒産したことで\n高校を退学することになり"},
        { "location": "624/TALK"    , "narrator": "千羽鶴", "text": "泣く泣く働いていたのだけ\nどクリーニング屋のおば\nちゃんに勧められたことで"},
        { "location": "625/TALK"    , "narrator": "千羽鶴", "text": "クリーニングフランチャイ\nズを始め経営も軌道に乗り\nかけていた矢先に株価が大"},
        { "location": "626/TALK"    , "narrator": "千羽鶴", "text": "暴落して夜逃げしている所\nだったの！そんな矢先に小\n学校の幼馴染み設定（１年"},
        { "location": "627/TALK"    , "narrator": "千羽鶴", "text": "でクラスが一緒だった）の\n$handle$と駅前で\n運命的な出会いをして"},
        { "location": "629/TALK"    , "narrator": "千羽鶴", "text": "そして今私たちは\n運命のキャベツ畑にいる♪"},
        { "location": "630/SEL"     , "narrator": "", "text": "設定が破綻してるんですけど……"},
        { "location": "631/SEL"     , "narrator": "", "text": "説明口調すぎる！"},
        { "location": "632/SEL"     , "narrator": "", "text": "さっきキャベツ畑だって言ったら否定したじゃん！"},
        { "location": "633/SEL"     , "narrator": "", "text": "なんて感動的な再会なんだ…これは奇跡だ！"},
        { "location": "634/ACT"     , "narrator": "", "text": "設定が破綻してるんですけど……"},
        { "location": "635/TALK"    , "narrator": "千羽鶴", "text": "……。"},
        { "location": "636/TALK"    , "narrator": "千羽鶴", "text": "貴方には１つ覚えておいて\n欲しい言葉がある。"},
        { "location": "637/TALK"    , "narrator": "千羽鶴", "text": "<size=30>現実は\n小説より奇なり！</size>"},
        { "location": "638/TALK"    , "narrator": "千羽鶴", "text": "激動の過去を語られて\nその切なさにホロリと来て\n好きになる――"},
        { "location": "641/TALK"    , "narrator": "千羽鶴", "text": "恋愛モノの\n常套手段だから！"},
        { "location": "642/SEL"     , "narrator": "", "text": "全然ホロリとしないんですけど"},
        { "location": "643/ACT"     , "narrator": "", "text": "全然ホロリとしないんですけど"},
        { "location": "646/TALK"    , "narrator": "千羽鶴", "text": "…そう。"},
        { "location": "647/TALK"    , "narrator": "千羽鶴", "text": "じゃあ\nゲームオーバー。"},
        { "location": "648/SEL"     , "narrator": "", "text": "ええええええ！！"},
        { "location": "649/ACT"     , "narrator": "", "text": "ええええええ！！"},
        { "location": "652/ACT"     , "narrator": "", "text": "説明口調すぎる！"},
        { "location": "653/TALK"    , "narrator": "千羽鶴", "text": "……。"},
        { "location": "656/TALK"    , "narrator": "千羽鶴", "text": "仕方ないのです。\n予算の都合だから。"},
        { "location": "657/TALK"    , "narrator": "千羽鶴", "text": "貴方の脳内で\n素晴らしい演出と\n泣ける会話に変換して。"},
        { "location": "658/SEL"     , "narrator": "", "text": "神様…"},
        { "location": "659/ACT"     , "narrator": "", "text": "神様…"},
        { "location": "661/TALK"    , "narrator": "千羽鶴", "text": "壮大なドラマに\nなりましたか？"},
        { "location": "662/TALK"    , "narrator": "千羽鶴", "text": "それでは、その結末を\n胸に、ハッピーエンド。"},
        { "location": "664/ACT"     , "narrator": "", "text": "さっきキャベツ畑だって言ったら否定したじゃん！"},
        { "location": "665/TALK"    , "narrator": "千羽鶴", "text": "さっきの世界と\n今の世界は別の次元に\n存在している。"},
        { "location": "667/TALK"    , "narrator": "千羽鶴", "text": "その微妙な時空のねじれを\n感じ取って欲しかった。"},
        { "location": "668/SEL"     , "narrator": "", "text": "えと、これ、恋愛ゲーですよね？"},
        { "location": "669/ACT"     , "narrator": "", "text": "えと、これ、恋愛ゲーですよね？"},
        { "location": "671/TALK"    , "narrator": "千羽鶴", "text": "そう。正確には\nＳＦ恋愛アドベンチャー。"},
        { "location": "672/TALK"    , "narrator": "千羽鶴", "text": "だから時には、恋愛より\n時空間考察が重要になる\n局面もある！"},
        { "location": "673/TALK"    , "narrator": "千羽鶴", "text": "というわけで、\nゲームオーバー。"},
        { "location": "675/ACT"     , "narrator": "", "text": "なんて感動的な再会なんだ…これは奇跡だ！"},
        { "location": "678/TALK"    , "narrator": "千羽鶴", "text": "えっ……！？"},
        { "location": "679/TALK"    , "narrator": "千羽鶴", "text": "まさか、この流れで\n真面目に演じるなんて。"},
        { "location": "680/TALK"    , "narrator": "千羽鶴", "text": "……。"},
        { "location": "681/TALK"    , "narrator": "千羽鶴", "text": "ちょっと\nキュンとなったかも。"},
        { "location": "683/TALK"    , "narrator": "千羽鶴", "text": "……これあげる。"},
        { "location": "689/TALK"    , "narrator": "千羽鶴", "text": "でも残念ながら\n千羽鶴とは結ばれない。"},
        { "location": "690/SEL"     , "narrator": "", "text": "え？なんで？？"},
        { "location": "691/ACT"     , "narrator": "", "text": "え？なんで？？"},
        { "location": "693/TALK"    , "narrator": "千羽鶴", "text": "彼女は悲劇のヒロイン\n設定だから！"},
        { "location": "694/TALK"    , "narrator": "千羽鶴", "text": "というわけで、\nゲームオーバー。"},
        { "location": "697/ACT"     , "narrator": "", "text": "もっと千羽鶴さんの可愛い所見たりデートしたりしたいです"},
        { "location": "701/TALK"    , "narrator": "千羽鶴", "text": "あ、止まった。"},
        { "location": "702/SEL"     , "narrator": "", "text": "なんで！？"},
        { "location": "703/ACT"     , "narrator": "", "text": "なんで！？"},
        { "location": "706/TALK"    , "narrator": "千羽鶴", "text": "返事は２０文字以内って\n言ったはず。"},
        { "location": "707/TALK"    , "narrator": "千羽鶴", "text": "２７文字も送信したら\n止まるに決まってる。"},
        { "location": "708/SEL"     , "narrator": "", "text": "脆弱すぎやしませんか？"},
        { "location": "709/ACT"     , "narrator": "", "text": "脆弱すぎやしませんか？"},
        { "location": "711/TALK"    , "narrator": "千羽鶴", "text": "……。"},
        { "location": "712/TALK"    , "narrator": "千羽鶴", "text": "……まあ。"},
        { "location": "713/TALK"    , "narrator": "千羽鶴", "text": "確かにそうかも。"},
        { "location": "715/TALK"    , "narrator": "千羽鶴", "text": "………ごめん。"},
        { "location": "717/TALK"    , "narrator": "千羽鶴", "text": "とにかく残念だけど、\n今回はここでお終い。"},
        { "location": "686/DIALOG"  , "narrator": "Dialog_GETcandy_SY", "text": "<color=white>+10</color>"},
        { "location": "700/DIALOG"  , "narrator": "Dialog_Notice", "text": "<color=red>不正な処理エラー</color>\n文字数がオーバーフローしました"}
    ]
}
