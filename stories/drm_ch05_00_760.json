    "entry":
    [
        { "location": "883/SCENARIO", "narrator": "", "text": "日常"},
        { "location": "908/TALK"    , "narrator": "神楽", "text": "その少女は感情につながる記憶を封印していました"},
        { "location": "909/TALK"    , "narrator": "神楽", "text": "そのため普段は笑うことも楽しむこともありませんでした"},
        { "location": "910/TALK"    , "narrator": "神楽", "text": "それでも少女は平気でした"},
        { "location": "911/TALK"    , "narrator": "神楽", "text": "退屈も悲しみも悔しさもむなしさも封印の中にあったからです"},
        { "location": "912/TALK"    , "narrator": "神楽", "text": "ある時少女は一人の声を聞き、記憶を解放します"},
        { "location": "913/TALK"    , "narrator": "神楽", "text": "しかし扉が開いた瞬間、少女は後悔しました"},
        { "location": "914/TALK"    , "narrator": "神楽", "text": "少女の記憶は世界を変える鍵になっていたからです"},
        { "location": "915/TALK"    , "narrator": "神楽", "text": "扉を開けたことにより、今までいた場所が全て壊れてしまったからです"},
        { "location": "917/SEL"     , "narrator": "", "text": "新作かな？"},
        { "location": "918/SEL"     , "narrator": "", "text": "崩壊した世界で歌を歌う系…"},
        { "location": "919/SEL"     , "narrator": "", "text": "そして新しい世界が始まる"},
        { "location": "920/ACT"     , "narrator": "", "text": "新作かな？"},
        { "location": "921/TALK"    , "narrator": "神楽", "text": "最新作にしてライフワークぴょん"},
        { "location": "922/TALK"    , "narrator": "神楽", "text": "実生活の方でね"},
        { "location": "923/ACT"     , "narrator": "", "text": "崩壊した世界で歌を歌う系…"},
        { "location": "924/TALK"    , "narrator": "神楽", "text": "そういう感じかも"},
        { "location": "925/TALK"    , "narrator": "神楽", "text": "物語だったら美しいエンドぴょん"},
        { "location": "926/ACT"     , "narrator": "", "text": "そして新しい世界が始まる"},
        { "location": "927/TALK"    , "narrator": "神楽", "text": "再生には大変なエネルギーと時間がかかるぴょん"},
        { "location": "928/TALK"    , "narrator": "神楽", "text": "一筋縄ではいかないんですー"},
        { "location": "930/TALK"    , "narrator": "神楽", "text": "その鍵になった少女がぴょんこ"},
        { "location": "931/TALK"    , "narrator": "神楽", "text": "って言ったら信じる？"},
        { "location": "933/SEL"     , "narrator": "", "text": "信じる"},
        { "location": "934/SEL"     , "narrator": "", "text": "信じない"},
        { "location": "935/SEL"     , "narrator": "", "text": "もっと詳しく聞かせて"},
        { "location": "936/ACT"     , "narrator": "", "text": "信じる"},
        { "location": "937/TALK"    , "narrator": "神楽", "text": "素直なんだね$handle$♪"},
        { "location": "938/TALK"    , "narrator": "神楽", "text": "かわいいぴょん★"},
        { "location": "948/ACT"     , "narrator": "", "text": "信じない"},
        { "location": "949/TALK"    , "narrator": "神楽", "text": "冷たいな～～も～～～"},
        { "location": "951/TALK"    , "narrator": "神楽", "text": "ぴょんこの言うこと信じて欲しいﾅ★"},
        { "location": "961/ACT"     , "narrator": "", "text": "もっと詳しく聞かせて"},
        { "location": "963/TALK"    , "narrator": "神楽", "text": "結構重い話になるぴょん"},
        { "location": "964/TALK"    , "narrator": "神楽", "text": "だからちょっと心配"},
        { "location": "966/SEL"     , "narrator": "", "text": "どんな神楽でも受け止める"},
        { "location": "967/SEL"     , "narrator": "", "text": "むしろそういう話が聞きたい"},
        { "location": "968/SEL"     , "narrator": "", "text": "今さら心配することなんてある？"},
        { "location": "969/ACT"     , "narrator": "", "text": "どんな神楽でも受け止める"},
        { "location": "971/TALK"    , "narrator": "神楽", "text": "ちゅき、、、"},
        { "location": "972/ACT"     , "narrator": "", "text": "むしろそういう話が聞きたい"},
        { "location": "974/TALK"    , "narrator": "神楽", "text": "$handle$ってＭだよね♪"},
        { "location": "975/TALK"    , "narrator": "神楽", "text": "嫌いじゃないぴょん、、、ﾎﾟｯ"},
        { "location": "976/ACT"     , "narrator": "", "text": "今さら心配することなんてある？"},
        { "location": "977/TALK"    , "narrator": "神楽", "text": "ないの！？"},
        { "location": "978/TALK"    , "narrator": "神楽", "text": "ないかも！？"},
        { "location": "981/TALK"    , "narrator": "神楽", "text": "ライフギャザーのコアの鍵はぴょんこの記憶"},
        { "location": "982/TALK"    , "narrator": "神楽", "text": "普通のエンジニアにはできないことをパパはやったぴょん"},
        { "location": "983/TALK"    , "narrator": "神楽", "text": "世界が変わるほどの大発明ぴょん"},
        { "location": "984/TALK"    , "narrator": "神楽", "text": "でもこれって何なんだろ"},
        { "location": "985/TALK"    , "narrator": "神楽", "text": "どういうことなんだろ"},
        { "location": "987/SEL"     , "narrator": "", "text": "愛…かな…"},
        { "location": "988/SEL"     , "narrator": "", "text": "身内への甘え"},
        { "location": "989/SEL"     , "narrator": "", "text": "$me$の口からは何とも"},
        { "location": "990/ACT"     , "narrator": "", "text": "愛…かな…"},
        { "location": "991/TALK"    , "narrator": "神楽", "text": "そうかな、、、"},
        { "location": "992/TALK"    , "narrator": "神楽", "text": "だったらいいぴょん、、、"},
        { "location": "993/ACT"     , "narrator": "", "text": "身内への甘え"},
        { "location": "994/TALK"    , "narrator": "神楽", "text": "かもね！？"},
        { "location": "996/TALK"    , "narrator": "神楽", "text": "でもそれだけ気にかけてくれてたんだよね"},
        { "location": "997/TALK"    , "narrator": "神楽", "text": "違うかな？？？？"},
        { "location": "998/ACT"     , "narrator": "", "text": "$me$の口からは何とも"},
        { "location": "999/TALK"    , "narrator": "神楽", "text": "そんな言い方されても"},
        { "location": "1000/TALK"   , "narrator": "神楽", "text": "意味がわかんないぴょん、、、"},
        { "location": "1002/TALK"   , "narrator": "神楽", "text": "時々ね"},
        { "location": "1003/TALK"   , "narrator": "神楽", "text": "そのことを思い出してはｷｭｰﾝってなるの"},
        { "location": "1004/TALK"   , "narrator": "神楽", "text": "でもｷｭｰﾝの理由は自分でもわかんないぴょん、、、"},
        { "location": "1006/SEL"    , "narrator": "", "text": "結論は簡単には出ないよ"},
        { "location": "1007/SEL"    , "narrator": "", "text": "複雑だよね"},
        { "location": "1008/SEL"    , "narrator": "", "text": "それは$me$への愛だね"},
        { "location": "1009/ACT"    , "narrator": "", "text": "結論は簡単には出ないよ"},
        { "location": "1010/TALK"   , "narrator": "神楽", "text": "うん、、、"},
        { "location": "1012/TALK"   , "narrator": "神楽", "text": "それはわかってるつもり"},
        { "location": "1013/ACT"    , "narrator": "", "text": "複雑だよね"},
        { "location": "1015/TALK"   , "narrator": "神楽", "text": "そう簡単じゃないの、、、"},
        { "location": "1016/ACT"    , "narrator": "", "text": "それは$me$への愛だね"},
        { "location": "1017/TALK"   , "narrator": "神楽", "text": "あーあーあーあーあー"},
        { "location": "1018/TALK"   , "narrator": "神楽", "text": "そういうことにしとこっか（暗黒微笑"},
        { "location": "1020/TALK"   , "narrator": "神楽", "text": "パパにはもう聞けないから"},
        { "location": "1021/TALK"   , "narrator": "神楽", "text": "ぴょんこは一人で考えこんだりしちゃうけど、、、"},
        { "location": "1022/TALK"   , "narrator": "神楽", "text": "こんなこと言えるの$handle$にだけだし"},
        { "location": "1023/TALK"   , "narrator": "神楽", "text": "何より知っててほしかったから"},
        { "location": "1025/SEL"    , "narrator": "", "text": "教えてくれてありがとう"},
        { "location": "1026/SEL"    , "narrator": "", "text": "ちゃんと受け止めたよ"},
        { "location": "1027/SEL"    , "narrator": "", "text": "またいつでも話して"},
        { "location": "1028/ACT"    , "narrator": "", "text": "教えてくれてありがとう"},
        { "location": "1029/TALK"   , "narrator": "神楽", "text": "ううん"},
        { "location": "1030/TALK"   , "narrator": "神楽", "text": "聞いてくれてｱﾘｶﾞﾄ"},
        { "location": "1031/ACT"    , "narrator": "", "text": "ちゃんと受け止めたよ"},
        { "location": "1033/TALK"   , "narrator": "神楽", "text": "信じてるけど！"},
        { "location": "1034/ACT"    , "narrator": "", "text": "またいつでも話して"},
        { "location": "1035/TALK"   , "narrator": "神楽", "text": "うん"},
        { "location": "1041/TALK"   , "narrator": "ボイスメール", "text": "また明日！"},
