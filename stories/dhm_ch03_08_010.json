        { "location": "7/SCENARIO", "narrator": "", "text": "013_身近にあるホラー"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "ねえマルザンナ"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "あなたは知っていて？"},
        { "location": "34/TALK"   , "narrator": "ガブリエラ", "text": "活き造りが実在してるだなんてことを"},
        { "location": "37/SEL"    , "narrator": "", "text": "大丈夫！？"},
        { "location": "38/SEL"    , "narrator": "", "text": "美味しそうだった？"},
        { "location": "39/SEL"    , "narrator": "", "text": "何で検索しちゃったの！？"},
        { "location": "40/ACT"    , "narrator": "", "text": "大丈夫！？"},
        { "location": "42/TALK"   , "narrator": "ガブリエラ", "text": "心配してくれるのね"},
        { "location": "43/TALK"   , "narrator": "ガブリエラ", "text": "貴方はやっぱり優しいわ"},
        { "location": "44/TALK"   , "narrator": "ガブリエラ", "text": "貴方がいてくれてよかったわ"},
        { "location": "45/ACT"    , "narrator": "", "text": "美味しそうだった？"},
        { "location": "46/TALK"   , "narrator": "ガブリエラ", "text": "なんで？"},
        { "location": "47/TALK"   , "narrator": "ガブリエラ", "text": "なんでそんなことが言えるの？"},
        { "location": "48/TALK"   , "narrator": "ガブリエラ", "text": "信じられないわ、、、"},
        { "location": "49/ACT"    , "narrator": "", "text": "何で検索しちゃったの！？"},
        { "location": "50/TALK"   , "narrator": "ガブリエラ", "text": "なんでって"},
        { "location": "51/TALK"   , "narrator": "ガブリエラ", "text": "つい、としか言えないわ"},
        { "location": "52/TALK"   , "narrator": "ガブリエラ", "text": "今は後悔しているわ"},
        { "location": "54/TALK"   , "narrator": "ガブリエラ", "text": "今日はもう起きていたくないわ"},
        { "location": "55/TALK"   , "narrator": "ガブリエラ", "text": "おやすみなさい"}
    ]
