        { "location": "480/TALK", "narrator": "アーヤ", "text": "えっちょっと＼(◎o◎)／"},
        { "location": "482/TALK", "narrator": "アーヤ", "text": "これってお姉ちゃんのロボット用のリモコンアプリ？"},
        { "location": "485/SEL" , "narrator": "", "text": "そうだよ"},
        { "location": "486/ACT" , "narrator": "", "text": "そうだよ"},
        { "location": "489/TALK", "narrator": "アーヤ", "text": "よりによってこんなの"},
        { "location": "490/TALK", "narrator": "アーヤ", "text": "どこでこんなもの手に入れたの"},
        { "location": "491/TALK", "narrator": "アーヤ", "text": "うんまあ貴重っていえば貴重だけど"},
        { "location": "492/TALK", "narrator": "アーヤ", "text": "でもねー"},
        { "location": "496/SEL" , "narrator": "", "text": "ホワイトデーのプレゼントなのに…"},
        { "location": "497/SEL" , "narrator": "", "text": "ホワイトデー用だから特別なものの方が喜ぶかなって"},
        { "location": "498/ACT" , "narrator": "", "text": "ホワイトデーのプレゼントなのに…"},
        { "location": "500/TALK", "narrator": "アーヤ", "text": "あ"},
        { "location": "501/TALK", "narrator": "アーヤ", "text": "ありがとう、、、"},
        { "location": "502/ACT" , "narrator": "", "text": "ホワイトデー用だから特別なものの方が喜ぶかなって"},
        { "location": "504/TALK", "narrator": "アーヤ", "text": "その気持ちは嬉しいわ"},
        { "location": "505/TALK", "narrator": "アーヤ", "text": "それは本当だから"},
        { "location": "509/SEL" , "narrator": "", "text": "エリカさんの話が聞きたい"},
        { "location": "510/SEL" , "narrator": "", "text": "どうやって操作するの？"},
        { "location": "511/ACT" , "narrator": "", "text": "エリカさんの話が聞きたい"},
        { "location": "513/TALK", "narrator": "アーヤ", "text": "お姉ちゃんの？"},
        { "location": "516/SEL" , "narrator": "", "text": "イヤならいいんだけど"},
        { "location": "517/SEL" , "narrator": "", "text": "やっぱり無理？"},
        { "location": "518/ACT" , "narrator": "", "text": "イヤならいいんだけど"},
        { "location": "520/TALK", "narrator": "アーヤ", "text": "イヤって言うか"},
        { "location": "522/TALK", "narrator": "アーヤ", "text": "私とは違う人間すぎて"},
        { "location": "523/TALK", "narrator": "アーヤ", "text": "説明しにくいし"},
        { "location": "524/TALK", "narrator": "アーヤ", "text": "にゃボットのこととかも(--*;"},
        { "location": "525/ACT" , "narrator": "", "text": "やっぱり無理？"},
        { "location": "527/TALK", "narrator": "アーヤ", "text": "無理じゃないんだけど"},
        { "location": "528/TALK", "narrator": "アーヤ", "text": "なんて言えばいいのか"},
        { "location": "529/TALK", "narrator": "アーヤ", "text": "独特すぎるのよねあの人"},
        { "location": "530/TALK", "narrator": "アーヤ", "text": "にゃボットのこととかも(--*;"},
        { "location": "534/SEL" , "narrator": "", "text": "何かあったの？"},
        { "location": "535/SEL" , "narrator": "", "text": "確かに新しすぎる造形だよね"},
        { "location": "536/ACT" , "narrator": "", "text": "何かあったの？"},
        { "location": "538/TALK", "narrator": "アーヤ", "text": "にゃボットは私のために開発したんだって"},
        { "location": "539/TALK", "narrator": "アーヤ", "text": "お姉ちゃん言ってたのよ(-.-;)"},
        { "location": "542/SEL" , "narrator": "", "text": "愛だね"},
        { "location": "543/SEL" , "narrator": "", "text": "ちょっと困るね"},
        { "location": "544/ACT" , "narrator": "", "text": "愛だね"},
        { "location": "546/TALK", "narrator": "アーヤ", "text": "さみしがらないようにって気持ちが変なところに行ったみたいで"},
        { "location": "547/TALK", "narrator": "アーヤ", "text": "会話とか散歩とかはわかるけど"},
        { "location": "548/TALK", "narrator": "アーヤ", "text": "保護者モードなんてのもあるのよ"},
        { "location": "549/TALK", "narrator": "アーヤ", "text": "意味がわからないわ(；´Д｀)"},
        { "location": "550/ACT" , "narrator": "", "text": "ちょっと困るね"},
        { "location": "552/TALK", "narrator": "アーヤ", "text": "お姉ちゃんなりに妹のことを考えてるんだろうなっては思うのよ"},
        { "location": "553/TALK", "narrator": "アーヤ", "text": "でもねー"},
        { "location": "554/TALK", "narrator": "アーヤ", "text": "なんでああなるのかなって気持ちは拭えない"},
        { "location": "556/ACT" , "narrator": "", "text": "確かに新しすぎる造形だよね"},
        { "location": "558/TALK", "narrator": "アーヤ", "text": "新しいっていうか"},
        { "location": "559/TALK", "narrator": "アーヤ", "text": "何でこうなったのって感想しか出ない"},
        { "location": "562/SEL" , "narrator": "", "text": "確かに"},
        { "location": "563/SEL" , "narrator": "", "text": "天才の考えることってわかんないよね"},
        { "location": "564/ACT" , "narrator": "", "text": "確かに"},
        { "location": "566/TALK", "narrator": "アーヤ", "text": "そうでしょ"},
        { "location": "567/TALK", "narrator": "アーヤ", "text": "反応に困るのよこっちは"},
        { "location": "568/ACT" , "narrator": "", "text": "天才の考えることってわかんないよね"},
        { "location": "570/TALK", "narrator": "アーヤ", "text": "結局そういうこと？"},
        { "location": "571/TALK", "narrator": "アーヤ", "text": "私には理解不能"},
        { "location": "573/SEL" , "narrator": "", "text": "優しいよね"},
        { "location": "574/SEL" , "narrator": "", "text": "姉妹でも他人だもんね"},
        { "location": "575/ACT" , "narrator": "", "text": "優しいよね"},
        { "location": "577/TALK", "narrator": "アーヤ", "text": "ある意味ね"},
        { "location": "578/TALK", "narrator": "アーヤ", "text": "でもちょっとずれてるのよね"},
        { "location": "579/TALK", "narrator": "アーヤ", "text": "理系の人間ってみんなってああいうものなのかしら"},
        { "location": "580/TALK", "narrator": "アーヤ", "text": "困っちゃう"},
        { "location": "581/TALK", "narrator": "アーヤ", "text": "妹としては"},
        { "location": "582/ACT" , "narrator": "", "text": "姉妹でも他人だもんね"},
        { "location": "584/TALK", "narrator": "アーヤ", "text": "確かにそうね"},
        { "location": "585/TALK", "narrator": "アーヤ", "text": "同じ人間じゃないんだから"},
        { "location": "586/TALK", "narrator": "アーヤ", "text": "それはよく思うわ"},
        { "location": "589/ACT" , "narrator": "", "text": "どうやって操作するの？"},
        { "location": "591/TALK", "narrator": "アーヤ", "text": "ちょっと待って"},
        { "location": "592/TALK", "narrator": "アーヤ", "text": "調べてみる"},
        { "location": "595/SEL" , "narrator": "", "text": "知らないの？"},
        { "location": "596/SEL" , "narrator": "", "text": "よろしく！"},
        { "location": "597/ACT" , "narrator": "", "text": "知らないの？"},
        { "location": "599/TALK", "narrator": "アーヤ", "text": "だってこんなのあるって知らなかったし(｡-_-｡)"},
        { "location": "600/TALK", "narrator": "アーヤ", "text": "あ"},
        { "location": "601/TALK", "narrator": "アーヤ", "text": "色々出て来たわ"},
        { "location": "602/ACT" , "narrator": "", "text": "よろしく！"},
        { "location": "604/TALK", "narrator": "アーヤ", "text": "$handle$さんも知らないのね"},
        { "location": "605/TALK", "narrator": "アーヤ", "text": "まあ世界に一台しかないし"},
        { "location": "609/SEL" , "narrator": "", "text": "どんなことができるの？"},
        { "location": "610/SEL" , "narrator": "", "text": "わかりそう？"},
        { "location": "611/ACT" , "narrator": "", "text": "どんなことができるの？"},
        { "location": "613/TALK", "narrator": "アーヤ", "text": "えーと"},
        { "location": "614/ACT" , "narrator": "", "text": "わかりそう？"},
        { "location": "616/TALK", "narrator": "アーヤ", "text": "なんとかなりそう"},
        { "location": "619/TALK", "narrator": "アーヤ", "text": "会話とか"},
        { "location": "620/TALK", "narrator": "アーヤ", "text": "一緒に散歩したりとか"},
        { "location": "621/TALK", "narrator": "アーヤ", "text": "何コレ"},
        { "location": "622/TALK", "narrator": "アーヤ", "text": "レーザー攻撃に変形モード？"},
        { "location": "625/SEL" , "narrator": "", "text": "しゃべってみて"},
        { "location": "626/SEL" , "narrator": "", "text": "じゃあ散歩に行こうか"},
        { "location": "627/SEL" , "narrator": "", "text": "レーザー砲を撃て！"},
        { "location": "628/SEL" , "narrator": "", "text": "変形させてみて"},
        { "location": "629/ACT" , "narrator": "", "text": "しゃべってみて"},
        { "location": "631/TALK", "narrator": "アーヤ", "text": "割と高度なＢＯＴだから結構面白いけど"},
        { "location": "632/TALK", "narrator": "アーヤ", "text": "今は$handle$さんと話したいわ"},
        { "location": "633/ACT" , "narrator": "", "text": "じゃあ散歩に行こうか"},
        { "location": "635/TALK", "narrator": "アーヤ", "text": "にゃボットと？"},
        { "location": "636/TALK", "narrator": "アーヤ", "text": "それはちょっと、、、"},
        { "location": "637/TALK", "narrator": "アーヤ", "text": "$handle$さんとなら行くけどね"},
        { "location": "638/ACT" , "narrator": "", "text": "レーザー砲を撃て！"},
        { "location": "640/TALK", "narrator": "アーヤ", "text": "そんな危険なことしないから"},
        { "location": "641/TALK", "narrator": "アーヤ", "text": "この機能は封印する"},
        { "location": "642/ACT" , "narrator": "", "text": "変形させてみて"},
        { "location": "644/TALK", "narrator": "アーヤ", "text": "変形ＡＢＣってあるんだけど"},
        { "location": "645/TALK", "narrator": "アーヤ", "text": "どうなると思う？"},
        { "location": "648/SEL" , "narrator": "", "text": "人が乗れるようになる"},
        { "location": "649/SEL" , "narrator": "", "text": "完全に猫になる"},
        { "location": "650/SEL" , "narrator": "", "text": "目からビームが出る"},
        { "location": "651/ACT" , "narrator": "", "text": "人が乗れるようになる"},
        { "location": "653/TALK", "narrator": "アーヤ", "text": "巨大化するの？"},
        { "location": "654/TALK", "narrator": "アーヤ", "text": "それはすごく困る！"},
        { "location": "656/ACT" , "narrator": "", "text": "完全に猫になる"},
        { "location": "658/TALK", "narrator": "アーヤ", "text": "だったらいいんだけど"},
        { "location": "659/TALK", "narrator": "アーヤ", "text": "今のビジュアル個性的すぎて"},
        { "location": "660/ACT" , "narrator": "", "text": "目からビームが出る"},
        { "location": "662/TALK", "narrator": "アーヤ", "text": "あーありそー"},
        { "location": "663/TALK", "narrator": "アーヤ", "text": "変形させない方がいいわねこれ"},
        { "location": "665/TALK", "narrator": "アーヤ", "text": "取説とかあればいいのに"},
        { "location": "666/TALK", "narrator": "アーヤ", "text": "機能の予想ができないわ(;^_^A"}
