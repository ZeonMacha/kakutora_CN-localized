        { "location": "7332/SCENARIO", "narrator": "", "text": "劣化する楽園"},
        { "location": "7359/TALK"    , "narrator": "神楽", "text": "夢の国の魔法を信じ続けるには"},
        { "location": "7360/TALK"    , "narrator": "神楽", "text": "時にまやかしと偽善が必要"},
        { "location": "7362/SEL"     , "narrator": "", "text": "特定の施設の話なのかな（ドキドキ）"},
        { "location": "7363/SEL"     , "narrator": "", "text": "それを夢と言うんだと思う"},
        { "location": "7364/SEL"     , "narrator": "", "text": "夢が壊れるー"},
        { "location": "7365/ACT"     , "narrator": "", "text": "特定の施設の話なのかな（ドキドキ）"},
        { "location": "7366/TALK"    , "narrator": "神楽", "text": "権利関係でもめそうな話は最初からしないぴょん"},
        { "location": "7367/ACT"     , "narrator": "", "text": "それを夢と言うんだと思う"},
        { "location": "7369/TALK"    , "narrator": "神楽", "text": "ビターな真実ぴょん"},
        { "location": "7370/TALK"    , "narrator": "神楽", "text": "大人味の夢物語が語れそう"},
        { "location": "7371/TALK"    , "narrator": "神楽", "text": "でもそういうものかもね"},
        { "location": "7372/TALK"    , "narrator": "神楽", "text": "$handlek$意外といいこと言うね"},
        { "location": "7373/ACT"     , "narrator": "", "text": "夢が壊れるー"},
        { "location": "7374/TALK"    , "narrator": "神楽", "text": "オトナになれよ★"},
        { "location": "7376/TALK"    , "narrator": "神楽", "text": "舞台とかライブなんかはその場の一体感とか勢いとかがあるけど"},
        { "location": "7377/TALK"    , "narrator": "神楽", "text": "記録映像になるとそれが薄まるからちょっとがっかりすることもあるぴょん"},
        { "location": "7379/SEL"     , "narrator": "", "text": "あーね"},
        { "location": "7380/SEL"     , "narrator": "", "text": "そこは妄想力でカバー"},
        { "location": "7381/SEL"     , "narrator": "", "text": "神楽にガッカリなんてしないのに"},
        { "location": "7382/ACT"     , "narrator": "", "text": "あーね"},
        { "location": "7383/TALK"    , "narrator": "神楽", "text": "やっぱりライブには特別な魔法があるんだぴょん"},
        { "location": "7384/ACT"     , "narrator": "", "text": "そこは妄想力でカバー"},
        { "location": "7385/TALK"    , "narrator": "神楽", "text": "それしかないぴょん"},
        { "location": "7386/TALK"    , "narrator": "神楽", "text": "人間の可能性は無限大！"},
        { "location": "7387/ACT"     , "narrator": "", "text": "神楽にガッカリなんてしないのに"},
        { "location": "7389/TALK"    , "narrator": "神楽", "text": "よく言った！"},
        { "location": "7391/TALK"    , "narrator": "神楽", "text": "でもねでもねでもね？"},
        { "location": "7392/TALK"    , "narrator": "神楽", "text": "ぴょんこだってガッカリされないように努力してるぴょん？？？？"},
        { "location": "7393/TALK"    , "narrator": "神楽", "text": "がんばってるからね$handlek$のために！"}
