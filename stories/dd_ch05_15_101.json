{
    "dir": "chap15/daydra/dd_ch05_15_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "15502",
        "cid": "kagura",
        "title": "002 メインストーリー",
        "sub_title": "オンラインなのに＜前編＞"
    },
    "entry":
    [
        { "location": "1338/TALK"  , "narrator": "神楽", "text": "さあ、つばめさん。\n今度はこのお店ですよ！"},
        { "location": "1339/TALK"  , "narrator": "つばめ", "text": "う、うん…。"},
        { "location": "1344/TALK"  , "narrator": "神楽", "text": "どうしたんですか？\n怯えてるみたいですけど？"},
        { "location": "1346/TALK"  , "narrator": "つばめ", "text": "だ、だって、ここも\n薄い本のお店でしょ？"},
        { "location": "1348/TALK"  , "narrator": "神楽", "text": "もぉ、違いますよ。\n置いてある本を\nよく見てください。"},
        { "location": "1349/TALK"  , "narrator": "神楽", "text": "どれも近所の本屋さんで\n売ってる、普通の本です。"},
        { "location": "1351/TALK"  , "narrator": "つばめ", "text": "…あ、本当だ。\n普通の本を売ってる\nお店もあったんだね。"},
        { "location": "1353/TALK"  , "narrator": "神楽", "text": "もちろんです。\n特にこのお店は\n種類が豊富で…。"},
        { "location": "1357/TALK"  , "narrator": "神楽", "text": "ここはラノベと漫画だけ\n置いてあるお店なんです！"},
        { "location": "1361/TALK"  , "narrator": "つばめ", "text": "す、すごい！！\nそんなお店あるんだね。"},
        { "location": "1362/TALK"  , "narrator": "つばめ", "text": "でも…、こんなにあったら\nどれを読めばいいか\n迷っちゃうよ…。"},
        { "location": "1363/TALK"  , "narrator": "神楽", "text": "んっふっふ…、\n安心してください。"},
        { "location": "1365/TALK"  , "narrator": "神楽", "text": "つばめさんが\n迷ったりしないために、\nこの私がいるんです！"},
        { "location": "1366/TALK"  , "narrator": "つばめ", "text": "そ、そっか…。\nちなみに、卯月さんの\nオススメはどれ？"},
        { "location": "1367/TALK"  , "narrator": "神楽", "text": "ダダマホです！！"},
        { "location": "1369/TALK"  , "narrator": "つばめ", "text": "だ、ダダダホ？"},
        { "location": "1370/TALK"  , "narrator": "神楽", "text": "ダダマホ！"},
        { "location": "1371/TALK"  , "narrator": "神楽", "text": "妹がダダこねるから\n魔法学校落第しちゃった\nテヘペロの略です。"},
        { "location": "1372/TALK"  , "narrator": "つばめ", "text": "…た、タイトル長すぎない？"},
        { "location": "1373/TALK"  , "narrator": "神楽", "text": "最近はこれがデフォですよ。"},
        { "location": "1374/TALK"  , "narrator": "神楽", "text": "僕の魔王はオンラインなのに\nオフライン、みたいに。"},
        { "location": "1375/TALK"  , "narrator": "つばめ", "text": "…略すと、ボクマオ？"},
        { "location": "1376/TALK"  , "narrator": "神楽", "text": "オンオフです。"},
        { "location": "1378/TALK"  , "narrator": "神楽", "text": "でも、私はダダマホの方を\nオススメしますね。"},
        { "location": "1379/TALK"  , "narrator": "神楽", "text": "なんと言っても、\n妹のサクラちゃんが\n本当に健気で尊くて――"},
        { "location": "1388/TALK"  , "narrator": "神楽", "text": "――と、あらすじだけ\n簡単に説明するなら、\nこんな内容なんです。"},
        { "location": "1390/TALK"  , "narrator": "つばめ", "text": "す、すごいよ！\n卯月さんの説明、\nとってもわかりやすかった！"},
        { "location": "1391/TALK"  , "narrator": "神楽", "text": "大好きな作品ですからね。"},
        { "location": "1392/TALK"  , "narrator": "神楽", "text": "ボロボロになって、\n買い直すくらいは\n読み直してますから。"},
        { "location": "1393/TALK"  , "narrator": "つばめ", "text": "楽しそうだなぁ…。\nわたし、それ買おうかな？"},
        { "location": "1394/TALK"  , "narrator": "神楽", "text": "いいんですか？\n他にも面白い作品は\nまだまだあるのに…。"},
        { "location": "1396/TALK"  , "narrator": "つばめ", "text": "えぇーっ！？"},
        { "location": "1397/TALK"  , "narrator": "神楽", "text": "ふふっ…例えば、\nアップリアリアリスティック\nとかだと…。"},
        { "location": "1398/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1399/TALK"  , "narrator": "つばめ", "text": "あれ？　卯月さん、\nどうかしたの？"},
        { "location": "1400/TALK"  , "narrator": "神楽", "text": "あ、いえ…、別に…。"},
        { "location": "1402/TALK"  , "narrator": "神楽", "text": "いけない…つい目的を\n忘れて夢中になってたわ…。"},
        { "location": "1403/TALK"  , "narrator": "神楽", "text": "今日こうして秋葉原に\n来てるのは、つばめさんの\n素顔を探るためなのよ？"},
        { "location": "1405/TALK"  , "narrator": "神楽", "text": "その目的を忘れて、\n夢中でラノベの説明とか…、\nなにやってんだか…。"},
        { "location": "1407/TALK"  , "narrator": "神楽", "text": "はぁ…。"},
        { "location": "1408/TALK"  , "narrator": "つばめ", "text": "…卯月さん、大丈夫？"},
        { "location": "1410/TALK"  , "narrator": "神楽", "text": "あ、はい…。\nちょっと、喋りすぎちゃった\nみたいです。"},
        { "location": "1411/TALK"  , "narrator": "つばめ", "text": "そっか…。\n沢山ラノベのお話\nしてくれたもんね。"},
        { "location": "1412/TALK"  , "narrator": "つばめ", "text": "でも、そのおかげで\n興味沸いてきたよ。"},
        { "location": "1413/TALK"  , "narrator": "神楽", "text": "そうですか？\nほぼダダマホのことしか\n話してなかったのに…。"},
        { "location": "1414/TALK"  , "narrator": "つばめ", "text": "けど、その話をしてる\n卯月さん、とっても楽しそう\nだったから…。"},
        { "location": "1416/TALK"  , "narrator": "神楽", "text": "ご、ごめんなさい…。\n結局私が楽しんじゃって\nましたね…。"},
        { "location": "1417/TALK"  , "narrator": "つばめ", "text": "ううん、謝らないで。"},
        { "location": "1418/TALK"  , "narrator": "つばめ", "text": "楽しそうに話してる\n卯月さん、\nわたしは好きだな。"},
        { "location": "1419/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1420/TALK"  , "narrator": "神楽", "text": "…私だって、\nつばめさんのことは――"},
        { "location": "1435/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1436/TALK"  , "narrator": "神楽", "text": "またか…。"},
        { "location": "1437/TALK"  , "narrator": "神楽", "text": "つばめさんに対して、\n少しでも好意的な気持ちを\n感じる度に…。"},
        { "location": "1438/TALK"  , "narrator": "神楽", "text": "あの時のことを思い出して、\n無理矢理それを否定して\nばかり。"},
        { "location": "1439/TALK"  , "narrator": "神楽", "text": "…私が、目の前にいる\nつばめさんに対して\n抱いてる感情への…。"},
        { "location": "1440/TALK"  , "narrator": "神楽", "text": "言い訳みたいに。"},
        { "location": "1442/TALK"  , "narrator": "神楽", "text": "…私、かっこ悪いな。"},
        { "location": "1491/TALK"  , "narrator": "ぴょんこ", "text": "　"},
        { "location": "1520/TALK"  , "narrator": "ぴょんこ", "text": "久し振りに！"},
        { "location": "1523/TALK"  , "narrator": "ぴょんこ", "text": "ふたりっっっっっっっ"},
        { "location": "1526/TALK"  , "narrator": "ぴょんこ", "text": "きりっ！！"},
        { "location": "1528/SEL"   , "narrator": "", "text": "おちつけ！"},
        { "location": "1529/SEL"   , "narrator": "", "text": "ぴょんこｽｷ"},
        { "location": "1530/ACT"   , "narrator": "", "text": "おちつけ！"},
        { "location": "1531/TALK"  , "narrator": "ぴょんこ", "text": "十分落ち着いていますっ！"},
        { "location": "1532/SEL"   , "narrator": "", "text": "ペッタンしないの？"},
        { "location": "1533/ACT"   , "narrator": "", "text": "ペッタンしないの？"},
        { "location": "1535/TALK"  , "narrator": "ぴょんこ", "text": "飽きましたっ！"},
        { "location": "1536/ACT"   , "narrator": "", "text": "ぴょんこｽｷ"},
        { "location": "1539/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこも\n$handle$さんが\n大好きですっっっ！！"},
        { "location": "1540/TALK"  , "narrator": "ぴょんこ", "text": "両思いって\n素敵ですね♪"},
        { "location": "1542/TALK"  , "narrator": "ぴょんこ", "text": "ふぅ……"},
        { "location": "1545/TALK"  , "narrator": "ぴょんこ", "text": "というわけで！\nさてさて、\nここは一体どこでしょう！"},
        { "location": "1546/TALK"  , "narrator": "ぴょんこ", "text": "みやびさんの言うことが\n確かなら、ここは\n共通意識野だそうです。"},
        { "location": "1547/TALK"  , "narrator": "ぴょんこ", "text": "そんないつもと違う\nドキドキスポットに\n来ちゃったからには――"},
        { "location": "1548/SEL"   , "narrator": "", "text": "からには…？"},
        { "location": "1549/ACT"   , "narrator": "", "text": "からには…？"},
        { "location": "1551/TALK"  , "narrator": "ぴょんこ", "text": "まずは、キスチケの枚数を\n数えてみるってモンじゃ\nないでしょうかっ！"},
        { "location": "1552/SEL"   , "narrator": "", "text": "ええっ…いつもと変わらないやん"},
        { "location": "1553/ACT"   , "narrator": "", "text": "ええっ…いつもと変わらないやん"},
        { "location": "1556/TALK"  , "narrator": "ぴょんこ", "text": "今、$handle$さんは\n$pyonko_kissticket$枚のキスチケを\n持っていますね♪"},
        { "location": "1557/TALK"  , "narrator": "ぴょんこ", "text": "というわけで！\nおめでとうございます！"},
        { "location": "1558/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんは、\nキスチケを3枚以上\n獲得してますので！"},
        { "location": "1559/TALK"  , "narrator": "ぴょんこ", "text": "今から特別なキッスを\n進呈しちゃいまーす♪"},
        { "location": "1560/SEL"   , "narrator": "", "text": "やったー！"},
        { "location": "1561/SEL"   , "narrator": "", "text": "今！？"},
        { "location": "1562/SEL"   , "narrator": "", "text": "今はそういう気分じゃないから、また今度で"},
        { "location": "1563/ACT"   , "narrator": "", "text": "やったー！"},
        { "location": "1564/ACT"   , "narrator": "", "text": "今！？"},
        { "location": "1565/TALK"  , "narrator": "ぴょんこ", "text": "今じゃなきゃ\nいつやるんですかっ！？"},
        { "location": "1566/TALK"  , "narrator": "ぴょんこ", "text": "今でしょ！"},
        { "location": "1567/SEL"   , "narrator": "", "text": "古くない？"},
        { "location": "1568/ACT"   , "narrator": "", "text": "古くない？"},
        { "location": "1570/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん？"},
        { "location": "1571/ACT"   , "narrator": "", "text": "今はそういう気分じゃないから、また今度で"},
        { "location": "1572/TALK"  , "narrator": "ぴょんこ", "text": "わかったぴょん。"},
        { "location": "1573/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこはいつでも\nオッケーですから、\n気が向いた時にどうぞ♪"},
        { "location": "1577/TALK"  , "narrator": "ぴょんこ", "text": "というわけで今回は、\n$handle$さんの\n好きな服で好きな所に！"},
        { "location": "1578/TALK"  , "narrator": "ぴょんこ", "text": "これからぴょんこは、\n今、現実の私が着てる服に\n着替えてきます♪"},
        { "location": "1579/TALK"  , "narrator": "ぴょんこ", "text": "いっぱい\n楽しんじゃって\nくださいねっ！"},
        { "location": "1588/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん♪"},
        { "location": "1589/TALK"  , "narrator": "ぴょんこ", "text": "どうですかっ？\nそれでは――"},
        { "location": "1591/SEL"   , "narrator": "", "text": "頬、唇"},
        { "location": "1592/SEL"   , "narrator": "", "text": "胸"},
        { "location": "1593/SEL"   , "narrator": "", "text": "おなか"},
        { "location": "1594/ACT"   , "narrator": "", "text": "頬、唇"},
        { "location": "1598/ACT"   , "narrator": "", "text": "胸"},
        { "location": "1603/ACT"   , "narrator": "", "text": "おなか"},
        { "location": "1625/TALK"  , "narrator": "ぴょんこ", "text": "ふわあっ！"},
        { "location": "1628/TALK"  , "narrator": "ぴょんこ", "text": "ふわあっ！"},
        { "location": "1631/TALK"  , "narrator": "ぴょんこ", "text": "ふわあっ！"},
        { "location": "1634/TALK"  , "narrator": "ぴょんこ", "text": "ふわあっ！"},
        { "location": "1637/TALK"  , "narrator": "ぴょんこ", "text": "ふわあっ！"},
        { "location": "1640/TALK"  , "narrator": "ぴょんこ", "text": "ふわあっ！"},
        { "location": "1649/TALK"  , "narrator": "ぴょんこ", "text": "まさに\nメルティキッス♪"},
        { "location": "1651/TALK"  , "narrator": "ぴょんこ", "text": "温かくて\n柔らかい…。"},
        { "location": "1653/TALK"  , "narrator": "ぴょんこ", "text": "もっともっとー♪"},
        { "location": "1657/TALK"  , "narrator": "ぴょんこ", "text": "な、なんだか\n思ったよりも全然\nドキドキしますねっ！"},
        { "location": "1659/TALK"  , "narrator": "ぴょんこ", "text": "不思議と\n嫌じゃないぴょん♪"},
        { "location": "1661/TALK"  , "narrator": "ぴょんこ", "text": "かまかま～～♪"},
        { "location": "1665/TALK"  , "narrator": "ぴょんこ", "text": "おなかって……\nキスされると\nくすぐったいんですねっ…"},
        { "location": "1667/TALK"  , "narrator": "ぴょんこ", "text": "デリケートなので\n優しくしてくださいねっ！"},
        { "location": "1669/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんぴょん♪"},
        { "location": "1672/SEL"   , "narrator": "", "text": "もう一度"},
        { "location": "1673/SEL"   , "narrator": "", "text": "もうやめる"},
        { "location": "1674/ACT"   , "narrator": "", "text": "もう一度"},
        { "location": "1677/ACT"   , "narrator": "", "text": "もうやめる"},
        { "location": "1691/TALK"  , "narrator": "ぴょんこ", "text": "はぁっ。\n想像以上に\n恥ずかしいですね……。"},
        { "location": "1692/TALK"  , "narrator": "ぴょんこ", "text": "でも、とっても\n素敵な時間でした♪"},
        { "location": "1693/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこはいつでも\nオッケーですから、\nまたしましょうね♪"},
        { "location": "1697/TALK"  , "narrator": "ぴょんこ", "text": "さてさて。"},
        { "location": "1698/TALK"  , "narrator": "ぴょんこ", "text": "なんだかすごい所に\n連れてこられましたけど…"},
        { "location": "1699/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんは\nここが何処か\n知ってますか？"},
        { "location": "1700/SEL"   , "narrator": "", "text": "共通意識野でしょ？"},
        { "location": "1701/SEL"   , "narrator": "", "text": "わからない"},
        { "location": "1702/SEL"   , "narrator": "", "text": "前にここと同じ場所に来たことはある"},
        { "location": "1703/ACT"   , "narrator": "", "text": "共通意識野でしょ？"},
        { "location": "1704/TALK"  , "narrator": "ぴょんこ", "text": "それはそうなんですけど、\nその中でも、ここは\n何なのかという事です。"},
        { "location": "1705/ACT"   , "narrator": "", "text": "わからない"},
        { "location": "1706/TALK"  , "narrator": "ぴょんこ", "text": "では、\nぴょんこと同じですね♪"},
        { "location": "1707/ACT"   , "narrator": "", "text": "前にここと同じ場所に来たことはある"},
        { "location": "1708/TALK"  , "narrator": "ぴょんこ", "text": "そうなんですかっ！"},
        { "location": "1710/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこは、\nここが何なのかは\nわかりませんが――"},
        { "location": "1711/TALK"  , "narrator": "ぴょんこ", "text": "なんだか懐かしくて\n落ち着きます♪\n何故でしょうか。"},
        { "location": "1712/SEL"   , "narrator": "", "text": "とりあえず、先に進んでみようよ"},
        { "location": "1713/SEL"   , "narrator": "", "text": "油断しないように気をつけて！"},
        { "location": "1714/ACT"   , "narrator": "", "text": "とりあえず、先に進んでみようよ"},
        { "location": "1716/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん♪"},
        { "location": "1717/ACT"   , "narrator": "", "text": "油断しないように気をつけて！"},
        { "location": "1718/TALK"  , "narrator": "ぴょんこ", "text": "わかってるぴょん。"},
        { "location": "1719/TALK"  , "narrator": "ぴょんこ", "text": "まあでも、\nとりあえずここにいても\n何も無さそうですから――"},
        { "location": "1720/TALK"  , "narrator": "ぴょんこ", "text": "階段の上にある\n明るい場所に\n行ってみませんか？"},
        { "location": "1721/SEL"   , "narrator": "", "text": "そうだね"},
        { "location": "1722/SEL"   , "narrator": "", "text": "いや、まだダメだ"},
        { "location": "1723/ACT"   , "narrator": "", "text": "そうだね"},
        { "location": "1725/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん♪"},
        { "location": "1726/ACT"   , "narrator": "", "text": "いや、まだダメだ"},
        { "location": "1727/TALK"  , "narrator": "ぴょんこ", "text": "むー。\nちょっと慎重になりすぎ\nだと思いますよ？"},
        { "location": "1728/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこは行きます。\n$handle$さんは\n自由にしてください。"},
        { "location": "1735/SEL"   , "narrator": "", "text": "追いかける"},
        { "location": "1736/SEL"   , "narrator": "", "text": "現実へ戻る"},
        { "location": "1737/ACT"   , "narrator": "", "text": "追いかける"},
        { "location": "1739/ACT"   , "narrator": "", "text": "現実へ戻る"},
        { "location": "1753/TALK"  , "narrator": "ぴょんこ", "text": "ここは……"},
        { "location": "1754/TALK"  , "narrator": "つばめ", "text": "ぴょんこちゃん！"},
        { "location": "1758/TALK"  , "narrator": "ぴょんこ", "text": "つばめさん！"},
        { "location": "1759/TALK"  , "narrator": "つばめ", "text": "良かった～、逢えて！"},
        { "location": "1760/TALK"  , "narrator": "ぴょんこ", "text": "先日はココロの葛藤を\n処理していただき\nありがとうございました♪"},
        { "location": "1761/TALK"  , "narrator": "つばめ", "text": "ううん、こっちこそ\n連絡遅くなってごめんね。"},
        { "location": "1762/TALK"  , "narrator": "ぴょんこ", "text": "いいですよ～そんなこと。"},
        { "location": "1763/TALK"  , "narrator": "ぴょんこ", "text": "それより、葛藤を誰かに\n見られるのって、ちょっと\n恥ずかしいですねっ。"},
        { "location": "1764/TALK"  , "narrator": "つばめ", "text": "ああっ！\n安心して。葛藤の中身は\n全然見てないから！"},
        { "location": "1765/TALK"  , "narrator": "ぴょんこ", "text": "いいんですよ…？\nつばめさんなら、\n全部見ていただいても♪"},
        { "location": "1766/TALK"  , "narrator": "つばめ", "text": "ええっ……！？\nそ、そうなの……？"},
        { "location": "1768/SEL"   , "narrator": "", "text": "$me$もいるよ"},
        { "location": "1769/SEL"   , "narrator": "", "text": "よきかなよきかな"},
        { "location": "1770/ACT"   , "narrator": "", "text": "$me$もいるよ"},
        { "location": "1771/ACT"   , "narrator": "", "text": "よきかなよきかな"},
        { "location": "1774/TALK"  , "narrator": "つばめ", "text": "あっ、\n$handle$さん、\nこんにちは！"},
        { "location": "1776/TALK"  , "narrator": "ぴょんこ", "text": "そういえば、\nすっかり存在を\n忘れてました♪"},
        { "location": "1777/SEL"   , "narrator": "", "text": "酷くない？"},
        { "location": "1778/SEL"   , "narrator": "", "text": "ぐすん"},
        { "location": "1779/ACT"   , "narrator": "", "text": "酷くない？"},
        { "location": "1780/TALK"  , "narrator": "ぴょんこ", "text": "いやですね～。\n空気のように自然な仲って\nことですよ♪"},
        { "location": "1781/ACT"   , "narrator": "", "text": "ぐすん"},
        { "location": "1783/TALK"  , "narrator": "ぴょんこ", "text": "はあっ！"},
        { "location": "1785/TALK"  , "narrator": "ぴょんこ", "text": "なんかムラムラする！"},
        { "location": "1788/TALK"  , "narrator": "つばめ", "text": "ぴょんこちゃん、\n大丈夫！？\nなんか息が荒いけど……"},
        { "location": "1791/TALK"  , "narrator": "ぴょんこ", "text": "あっ、はい！\n大丈夫ですよっ！"},
        { "location": "1793/SEL"   , "narrator": "", "text": "で、これからどうすれば？"},
        { "location": "1794/ACT"   , "narrator": "", "text": "で、これからどうすれば？"},
        { "location": "1797/TALK"  , "narrator": "つばめ", "text": "あっ、えっとね。"},
        { "location": "1798/TALK"  , "narrator": "つばめ", "text": "外の世界と繋がるための\n細い橋が何処かにある\nはずなんだけど――"},
        { "location": "1799/TALK"  , "narrator": "つばめ", "text": "それが無くなってるか、\n壊されてるかっていう\n状況だと思うんだ。"},
        { "location": "1800/TALK"  , "narrator": "つばめ", "text": "だからそれを見つけて、\n元通りにしなくちゃ。"},
        { "location": "1806/TALK"  , "narrator": "ぴょんこ", "text": "あっ！"},
        { "location": "1818/TALK"  , "narrator": "アーヤ", "text": "卯月、いる？"},
        { "location": "1820/TALK"  , "narrator": "ぴょんこ", "text": "いますよ～～"},
        { "location": "1821/TALK"  , "narrator": "アーヤ", "text": "今どこ？"},
        { "location": "1822/TALK"  , "narrator": "ぴょんこ", "text": "共通意識野です♪"},
        { "location": "1823/TALK"  , "narrator": "アーヤ", "text": "やっぱり"},
        { "location": "1824/TALK"  , "narrator": "アーヤ", "text": "ココロの葛藤でてるみたいだけど、処理しちゃって平気？"},
        { "location": "1825/TALK"  , "narrator": "ぴょんこ", "text": "助かります～～～っ！"},
        { "location": "1826/TALK"  , "narrator": "ぴょんこ", "text": "アドレス教えますね♪"},
        { "location": "1828/TALK"  , "narrator": "ぴょんこ", "text": "2x44D番地だそうです！"},
        { "location": "1829/TALK"  , "narrator": "アーヤ", "text": "わかったわ"},
        { "location": "1830/TALK"  , "narrator": "アーヤ", "text": "他のみんなと逢えた？"},
        { "location": "1831/TALK"  , "narrator": "ぴょんこ", "text": "つばめさんとは逢えました！"},
        { "location": "1832/TALK"  , "narrator": "アーヤ", "text": "他は？"},
        { "location": "1833/TALK"  , "narrator": "ぴょんこ", "text": "まだですね"},
        { "location": "1834/TALK"  , "narrator": "アーヤ", "text": "そう"},
        { "location": "1835/TALK"  , "narrator": "アーヤ", "text": "わかった、それじゃこっちのことは心配しないで、同化の原因究明に集中してね"},
        { "location": "1836/TALK"  , "narrator": "ぴょんこ", "text": "は～い♪"},
        { "location": "1850/TALK"  , "narrator": "ぴょんこ", "text": "アーヤさんからでした。\nつばめさんによろしくと。"},
        { "location": "1852/TALK"  , "narrator": "つばめ", "text": "あ、そっか。\n今回はアーヤさんが\n当番なんだ。"},
        { "location": "1853/SEL"   , "narrator": "", "text": "ガブリエラとみやびは？"},
        { "location": "1854/ACT"   , "narrator": "", "text": "ガブリエラとみやびは？"},
        { "location": "1857/TALK"  , "narrator": "つばめ", "text": "そういえば、\nまだ来てないね。"},
        { "location": "1858/TALK"  , "narrator": "つばめ", "text": "どうしたんだろ。"},
        { "location": "1860/TALK"  , "narrator": "？？？", "text": "残念だけど、\n二人が来ることは無い。"},
        { "location": "1862/TALK"  , "narrator": "つばめ", "text": "えっ！？"},
        { "location": "1864/TALK"  , "narrator": "ぴょんこ", "text": "誰ですかっ！"},
        { "location": "1879/TALK"  , "narrator": "ぴょんこ", "text": "な、なに！？"},
        { "location": "1880/TALK"  , "narrator": "？？？", "text": "卯月神楽は、\n逢瀬つばめの世界に\n同化した方がいい。"},
        { "location": "1881/TALK"  , "narrator": "？？？", "text": "外の世界の記憶を\n持っていても、\nただ苦しむだけ。"},
        { "location": "1883/TALK"  , "narrator": "つばめ", "text": "あなたが神楽ちゃんの、\n外の世界との接続を\n外したんですか！"},
        { "location": "1884/TALK"  , "narrator": "つばめ", "text": "元に戻してください！"},
        { "location": "1885/TALK"  , "narrator": "？？？", "text": "……同化すれば\n全て丸く収まる。"},
        { "location": "1886/SEL"   , "narrator": "", "text": "そんなわけないだろ！"},
        { "location": "1887/SEL"   , "narrator": "", "text": "$me$もそう思う"},
        { "location": "1888/ACT"   , "narrator": "", "text": "そんなわけないだろ！"},
        { "location": "1891/ACT"   , "narrator": "", "text": "$me$もそう思う"},
        { "location": "1332/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:Interrupt】</color>\nSystem Interrupted.\n\n必須選択肢が選ばれていません。\n\n<color=green>『STORY27：シン・カグラ』</color>\nにて、選択を行ってから\n再度アクセスしてください。\n"},
        { "location": "1336/DIALOG", "narrator": "Dialog_EventData", "text": "<color=green>7月24日　3:15 PM</color>\nとある休日、秋葉原某所にある書店にて。"},
        { "location": "1456/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "1458/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "1460/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "1462/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "1464/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "1613/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "1644/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"},
        { "location": "1900/DIALOG", "narrator": "NOTICE", "text": "<color=red>【TRI-OS Error:0x99】</color>\nココロスフィアとの回線が\n切断されました。(981)"}
