        "title": "【EXストーリー】渇求の魔女",
        "sub_title": "シンクロストーリー"
    },
    "entry":
    [
        { "location": "504/SCENARIO", "narrator": "", "text": "【結果】クランネフェル"},
        { "location": "520/TALK"    , "narrator": "みやび", "text": "お疲れ。\n無事に完了した\nみたいやねえ。"},
        { "location": "521/TALK"    , "narrator": "みやび", "text": "これでネフェルの\nココロの中の\n抵抗は消えた、と。"},
        { "location": "522/TALK"    , "narrator": "みやび", "text": "つまり$handle$と\n繋がる準備ができた、\nちうわけや。"},
        { "location": "523/TALK"    , "narrator": "みやび", "text": "シンクロしたら、\nネフェルの想いが\n流れ込むき。"},
        { "location": "524/TALK"    , "narrator": "みやび", "text": "$handle$は、\nそれを受け入れる\nちう寸法や。"},
        { "location": "525/TALK"    , "narrator": "みやび", "text": "準備はえいかね？"},
        { "location": "526/SEL"     , "narrator": "（選択肢）", "text": "はい"},
        { "location": "527/SEL"     , "narrator": "（選択肢）", "text": "いいえ"},
        { "location": "528/ACT"     , "narrator": "", "text": "はい"},
        { "location": "529/TALK"    , "narrator": "みやび", "text": "ええ返事やね。\nほいたらココロを\n繋げるきね。"},
        { "location": "530/ACT"     , "narrator": "", "text": "いいえ"},
        { "location": "532/TALK"    , "narrator": "みやび", "text": "なんで\nここまできて…。"},
        { "location": "533/TALK"    , "narrator": "みやび", "text": "まあえい。\n今回はここまでや。"},
        { "location": "534/TALK"    , "narrator": "みやび", "text": "準備ができたら\nまた来たらえい。"},
        { "location": "542/TALK"    , "narrator": "みやび", "text": "EXEC_SYNC_SPHERE/."},
        { "location": "555/DIALOG"  , "narrator": "", "text": "神様どうかお母さんの願いを\n叶えてください――"},
        { "location": "562/DIALOG"  , "narrator": "", "text": "クランイラスト先読み"},
        { "location": "572/DIALOG"  , "narrator": "", "text": "香陵陽子（かりょうようこ）。9歳女児。長野県北佐久郡軽井沢町出身。先天性の心疾患を持ち、何もしなければ成人前に死んでしまうと言われていた。"},
        { "location": "573/DIALOG"  , "narrator": "", "text": "母親の虹子（こうこ）は、娘のために何でもする覚悟を決め、軽井沢の家を売り払い都内に引っ越す。そして先進医療病院に娘を入院させ、唯一の打開策である心臓移植の順番待ちをした。\nそういった事情により陽子にとっては、病院の中だけが自分の世界だったのである。"},
        { "location": "574/DIALOG"  , "narrator": "", "text": "陽子の容態は不安定で、それ故に両親はいつだってハラハラしていた。そしてそれは陽子に伝わっており、自分のせいで両親が楽しく暮らせないことを内心責めていた。\nそのため洋子は辛いときにも頑張って笑ったりいつも以上におどけたりしたが、かえってそれが親の心配を招いていた。"},
        { "location": "575/DIALOG"  , "narrator": "", "text": "そんなある日、ついに心臓移植が決まった。数時間の後には手術が開始されると告げられた母親は病院に駆けつけた。\nだが、結局手術は行われなかった。"},
        { "location": "576/DIALOG"  , "narrator": "", "text": "病院には同じ免疫特性を持つ子がもう一人入院しており、その子に優先権が移ってしまったのだ。\n母親は納得いかず、あの手この手で事情を突き止めると、何と横入りしたのは内閣官房長官の甥だったのである。"},
        { "location": "581/DIALOG"  , "narrator": "", "text": "失意の母は、その後生気を失い、毎日フラフラと心臓が届けられたヘリポートへ行くようになった。\nそこで毎日毎日、心臓が届けられるのを待ったのだ。\nもちろんただ待っていても届くわけはない。\nそれでも、そうでもしなければ精神を抑圧することはできなかった。"},
        { "location": "582/DIALOG"  , "narrator": "", "text": "陽子はそんな様子を見て、更に自分を責めた。\n自分がちゃんと病気を直せないから、お母さんが自分を嫌いになってしまったのだと思い込んだ。\n母親は一度決まったはずの移植ができなかったことが辛くて、陽子を見るだけで泣いてしまうから、極力見ないようにしていたのだが陽子はそれを嫌われたと感じてしまったのだ。"},
        { "location": "583/DIALOG"  , "narrator": "", "text": "陽子は自分なりに、色んな人に聞いて回って、どうすれば元気になれるのかを考えた。\nそしてとある政治家嫌いの患者から、自分に移植されるはずだった心臓がある政治家の甥っ子に横取りされたことを聞かされる。"},
        { "location": "584/DIALOG"  , "narrator": "", "text": "そして陽子は神様に祈った。"},
        { "location": "585/DIALOG"  , "narrator": "", "text": "どうか心臓をください。またお母さんと仲直りしたいです。\n陽子のせいで、お母さんは毎日泣いてます。\n何でもします。\nだから、どうか心臓をください。"},
        { "location": "590/DIALOG"  , "narrator": "", "text": "その強い想いは発症に十分な力を持っていた。\n陽子は意図せずして病院を廃病院にし、そこで心臓を得るための「おまじない」を遂行したのである。"},
        { "location": "607/TALK"    , "narrator": "みやび", "text": "どうやったかね。\nネフェルの想いは。"},
        { "location": "608/SEL"     , "narrator": "（選択肢）", "text": "すれ違いが生んだ悲劇だね"},
        { "location": "609/SEL"     , "narrator": "（選択肢）", "text": "お母さんのこと大好きだったんだ"},
        { "location": "610/SEL"     , "narrator": "（選択肢）", "text": "むしろ政治家に制裁を与えるべき"},
        { "location": "611/ACT"     , "narrator": "", "text": "すれ違いが生んだ悲劇だね"},
        { "location": "612/TALK"    , "narrator": "みやび", "text": "…そうやね。\nどっちも相手を思うて\n行動したはずやのに。"},
        { "location": "613/ACT"     , "narrator": "", "text": "お母さんのこと大好きだったんだ"},
        { "location": "614/TALK"    , "narrator": "みやび", "text": "いっそ嫌いやったら\nよかったのかも\nしれんね。"},
        { "location": "615/ACT"     , "narrator": "", "text": "むしろ政治家に制裁を与えるべき"},
        { "location": "616/TALK"    , "narrator": "みやび", "text": "確かにそう、とは\n言い切れんよ。\nうちには。"},
        { "location": "618/TALK"    , "narrator": "みやび", "text": "陽子はうちが\n担当したクラン\nちうこともあるし。"},
        { "location": "619/TALK"    , "narrator": "みやび", "text": "あどけない部分が\n放っておけん\n感じなんよ。"},
        { "location": "620/SEL"     , "narrator": "（選択肢）", "text": "さすが長女"},
        { "location": "621/SEL"     , "narrator": "（選択肢）", "text": "意外と面倒見いいよね"},
        { "location": "622/SEL"     , "narrator": "（選択肢）", "text": "ロリ百合だ！"},
        { "location": "623/ACT"     , "narrator": "", "text": "さすが長女"},
        { "location": "624/TALK"    , "narrator": "みやび", "text": "もっと褒めて\nくれてもえいよ。"},
        { "location": "625/ACT"     , "narrator": "", "text": "意外と面倒見いいよね"},
        { "location": "626/TALK"    , "narrator": "みやび", "text": "意外とは余計だ\n意外とは。"},
        { "location": "627/ACT"     , "narrator": "", "text": "ロリ百合だ！"},
        { "location": "628/TALK"    , "narrator": "みやび", "text": "そういう用語で\n安易に括るな。"},
        { "location": "630/TALK"    , "narrator": "みやび", "text": "…うちは妹キャラに\n弱いんよ。"},
        { "location": "631/TALK"    , "narrator": "みやび", "text": "面倒を見て\nやりとうなって\n仕方ない。"},
        { "location": "632/TALK"    , "narrator": "みやび", "text": "なごちゃんのことが\nあったせいかも\nしれんけんど。"},
        { "location": "633/SEL"     , "narrator": "（選択肢）", "text": "$me$もみやびの妹になる！"},
        { "location": "634/SEL"     , "narrator": "（選択肢）", "text": "$me$がみやびを護るよ"},
        { "location": "635/SEL"     , "narrator": "（選択肢）", "text": "みやびは$me$にとって妹みたいなもの"},
        { "location": "636/ACT"     , "narrator": "", "text": "$me$もみやびの妹になる！"},
        { "location": "637/TALK"    , "narrator": "みやび", "text": "…それは\nせんでえいき。"},
        { "location": "639/TALK"    , "narrator": "みやび", "text": "$handle$は\nうちの相棒やしね。"},
        { "location": "640/ACT"     , "narrator": "", "text": "$me$がみやびを護るよ"},
        { "location": "641/TALK"    , "narrator": "みやび", "text": "頼もしいね\n$handle$。"},
        { "location": "642/TALK"    , "narrator": "みやび", "text": "期待しとるき。"},
        { "location": "643/ACT"     , "narrator": "", "text": "みやびは$me$にとって妹みたいなもの"},
        { "location": "644/TALK"    , "narrator": "みやび", "text": "ああん？"},
        { "location": "645/TALK"    , "narrator": "みやび", "text": "お姉様やきうちは！\nお姉様と呼ぶように。"},
        { "location": "647/TALK"    , "narrator": "みやび", "text": "ネフェルの話は\nこれでおしまいぞね。"},
        { "location": "648/TALK"    , "narrator": "みやび", "text": "またうちと相性のえい\nクランがおったら\n紹介するき。"},
        { "location": "649/TALK"    , "narrator": "みやび", "text": "その時を\n楽しみに待っちょき。"}
    ]
}
