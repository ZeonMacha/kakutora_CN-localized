        { "location": "7/SCENARIO", "narrator": "", "text": "180_ライフハックは得意かね"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "短時間の昼寝は生産性を上げる"},
        { "location": "33/TALK"   , "narrator": "みやび", "text": "これ即ちライフハック"},
        { "location": "35/SEL"    , "narrator": "", "text": "$me$もライフハックしてるよ"},
        { "location": "36/SEL"    , "narrator": "", "text": "昼寝の言い訳かな"},
        { "location": "37/SEL"    , "narrator": "", "text": "一緒に昼寝がしたいな"},
        { "location": "38/ACT"    , "narrator": "", "text": "$me$もライフハックしてるよ"},
        { "location": "39/TALK"   , "narrator": "みやび", "text": "ほう"},
        { "location": "41/TALK"   , "narrator": "みやび", "text": "初耳だ"},
        { "location": "42/ACT"    , "narrator": "", "text": "昼寝の言い訳かな"},
        { "location": "43/TALK"   , "narrator": "みやび", "text": "左様"},
        { "location": "44/TALK"   , "narrator": "みやび", "text": "そうとも言う"},
        { "location": "45/ACT"    , "narrator": "", "text": "一緒に昼寝がしたいな"},
        { "location": "55/TALK"   , "narrator": "みやび", "text": "なるほど"},
        { "location": "56/TALK"   , "narrator": "みやび", "text": "次回はそうしよう"},
        { "location": "58/TALK"   , "narrator": "みやび", "text": "$handle$の知る"},
        { "location": "59/TALK"   , "narrator": "みやび", "text": "ライフハックは何かね？"},
        { "location": "61/SEL"    , "narrator": "", "text": "猫を飼う"},
        { "location": "62/SEL"    , "narrator": "", "text": "BGMを流す"},
        { "location": "63/SEL"    , "narrator": "", "text": "TODOリストを作る"},
        { "location": "64/ACT"    , "narrator": "", "text": "猫を飼う"},
        { "location": "65/TALK"   , "narrator": "みやび", "text": "なんと"},
        { "location": "67/TALK"   , "narrator": "みやび", "text": "それは初めて聞いた"},
        { "location": "69/SEL"    , "narrator": "", "text": "癒やしパワーで人生充実"},
        { "location": "70/SEL"    , "narrator": "", "text": "猫と遊ぶと時間を忘れる"},
        { "location": "71/ACT"    , "narrator": "", "text": "癒やしパワーで人生充実"},
        { "location": "72/TALK"   , "narrator": "みやび", "text": "それは"},
        { "location": "74/TALK"   , "narrator": "みやび", "text": "単に充実した人生ぞね"},
        { "location": "75/ACT"    , "narrator": "", "text": "猫と遊ぶと時間を忘れる"},
        { "location": "76/TALK"   , "narrator": "みやび", "text": "逆に時間の浪費ではないか"},
        { "location": "78/TALK"   , "narrator": "みやび", "text": "それでは"},
        { "location": "80/ACT"    , "narrator": "", "text": "BGMを流す"},
        { "location": "81/TALK"   , "narrator": "みやび", "text": "それは聞くな"},
        { "location": "83/TALK"   , "narrator": "みやび", "text": "おすすめはあるかね"},
        { "location": "85/SEL"    , "narrator": "", "text": "デスメタル"},
        { "location": "86/SEL"    , "narrator": "", "text": "ボサノバとか"},
        { "location": "87/SEL"    , "narrator": "", "text": "ノイズミュージック"},
        { "location": "88/ACT"    , "narrator": "", "text": "デスメタル"},
        { "location": "89/TALK"   , "narrator": "みやび", "text": "それはない"},
        { "location": "91/TALK"   , "narrator": "みやび", "text": "なぜなら"},
        { "location": "92/TALK"   , "narrator": "みやび", "text": "デスボイスで歌いたくなるからだ"},
        { "location": "93/ACT"    , "narrator": "", "text": "ボサノバとか"},
        { "location": "94/TALK"   , "narrator": "みやび", "text": "確かに"},
        { "location": "95/TALK"   , "narrator": "みやび", "text": "カフェでよくかかっておる"},
        { "location": "96/ACT"    , "narrator": "", "text": "ノイズミュージック"},
        { "location": "97/TALK"   , "narrator": "みやび", "text": "いや"},
        { "location": "98/TALK"   , "narrator": "みやび", "text": "それは"},
        { "location": "99/TALK"   , "narrator": "みやび", "text": "意外とありかも"},
        { "location": "101/ACT"   , "narrator": "", "text": "TODOリストを作る"},
        { "location": "102/TALK"  , "narrator": "みやび", "text": "それは"},
        { "location": "104/TALK"  , "narrator": "みやび", "text": "ライフハック以前の問題では"},
        { "location": "106/SEL"   , "narrator": "", "text": "リストの汎用性の高さをなめてはいけない"},
        { "location": "107/SEL"   , "narrator": "", "text": "基本ができてからの応用"},
        { "location": "108/ACT"   , "narrator": "", "text": "リストの汎用性の高さをなめてはいけない"},
        { "location": "109/TALK"  , "narrator": "みやび", "text": "確かにそうぞね"},
        { "location": "110/TALK"  , "narrator": "みやび", "text": "汎用性の高さは武器であり鎧である"},
        { "location": "111/ACT"   , "narrator": "", "text": "基本ができてからの応用"},
        { "location": "112/TALK"  , "narrator": "みやび", "text": "うむむ"},
        { "location": "113/TALK"  , "narrator": "みやび", "text": "正論も正論"},
        { "location": "116/TALK"  , "narrator": "みやび", "text": "時に相棒"},
        { "location": "117/TALK"  , "narrator": "みやび", "text": "こうやって相棒と話すことは"},
        { "location": "118/TALK"  , "narrator": "みやび", "text": "生産的な行為だと思うかね"},
        { "location": "120/SEL"   , "narrator": "", "text": "当然"},
        { "location": "121/SEL"   , "narrator": "", "text": "どっちでもない"},
        { "location": "122/SEL"   , "narrator": "", "text": "あんまり自信ない"},
        { "location": "123/ACT"   , "narrator": "", "text": "当然"},
        { "location": "124/TALK"  , "narrator": "みやび", "text": "なるほど"},
        { "location": "126/TALK"  , "narrator": "みやび", "text": "ならば"},
        { "location": "127/TALK"  , "narrator": "みやび", "text": "また語り合おう"},
        { "location": "128/ACT"   , "narrator": "", "text": "どっちでもない"},
        { "location": "129/TALK"  , "narrator": "みやび", "text": "ややや"},
        { "location": "130/TALK"  , "narrator": "みやび", "text": "どっちつかずとは"},
        { "location": "132/TALK"  , "narrator": "みやび", "text": "らしい回答だの"},
        { "location": "133/ACT"   , "narrator": "", "text": "あんまり自信ない"},
        { "location": "143/TALK"  , "narrator": "みやび", "text": "お"},
        { "location": "144/TALK"  , "narrator": "みやび", "text": "そう来たか"},
        { "location": "145/TALK"  , "narrator": "みやび", "text": "そういう時は嘘でも肯定するものだ"},
        { "location": "146/TALK"  , "narrator": "みやび", "text": "しかし"},
        { "location": "147/TALK"  , "narrator": "みやび", "text": "そういう正直さは美徳だ"},
        { "location": "149/TALK"  , "narrator": "みやび", "text": "愛いやつめ"},
        { "location": "151/TALK"  , "narrator": "みやび", "text": "ちなみに"},
        { "location": "152/TALK"  , "narrator": "みやび", "text": "うちの見解はこう"},
