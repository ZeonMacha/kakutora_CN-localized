        { "location": "1741/TALK", "narrator": "プレイヤー", "text": "お着替えしてみよう"},
        { "location": "1743/TALK", "narrator": "プレイヤー", "text": "違う服を着てほしいな"},
        { "location": "1745/TALK", "narrator": "プレイヤー", "text": "よし、お着替えタイムだ！"},
        { "location": "1751/TALK", "narrator": "プレイヤー", "text": "やあ"},
        { "location": "1753/TALK", "narrator": "プレイヤー", "text": "こんにちは"},
        { "location": "1755/TALK", "narrator": "プレイヤー", "text": "げんき？"},
        { "location": "1758/TALK", "narrator": "神楽", "text": "ぴょんこを呼ぶ声"},
        { "location": "1759/TALK", "narrator": "神楽", "text": "あなたはだあれ？"},
        { "location": "1761/SEL" , "narrator": "", "text": "$handle$だよ"},
        { "location": "1762/ACT" , "narrator": "", "text": "$handle$だよ"},
        { "location": "1764/TALK", "narrator": "神楽", "text": "知ってるし"},
        { "location": "1765/TALK", "narrator": "神楽", "text": "ぴょんこに用事ぴょん？"},
        { "location": "1768/SEL" , "narrator": "", "text": "ちょっと着替えてほしいんだ"},
        { "location": "1769/ACT" , "narrator": "", "text": "ちょっと着替えてほしいんだ"},
        { "location": "1779/TALK", "narrator": "神楽", "text": "意味不明すぎ"},
        { "location": "1780/TALK", "narrator": "神楽", "text": "でもまあ"},
        { "location": "1781/TALK", "narrator": "神楽", "text": "優しいぴょんこは聞いてあげるのだった"},
        { "location": "1783/TALK", "narrator": "神楽", "text": "は？"},
        { "location": "1784/TALK", "narrator": "神楽", "text": "この服変だった？"},
        { "location": "1785/TALK", "narrator": "神楽", "text": "なら着替えるけど"},
        { "location": "1788/SEL" , "narrator": "", "text": "$me$が選ぶ"},
        { "location": "1789/SEL" , "narrator": "", "text": "やっぱやめる"},
        { "location": "1791/TALK", "narrator": "神楽", "text": "…………"},
        { "location": "1794/TALK", "narrator": "神楽", "text": "リクエストないとか？"},
        { "location": "1795/TALK", "narrator": "神楽", "text": "なら着ない"},
        { "location": "1797/ACT" , "narrator": "", "text": "$me$が選ぶ"},
        { "location": "1798/TALK", "narrator": "神楽", "text": "だと思った"},
        { "location": "1799/TALK", "narrator": "神楽", "text": "どれを着てほしいと？"},
        { "location": "1806/ACT" , "narrator": "", "text": "やっぱやめる"},
        { "location": "1807/TALK", "narrator": "神楽", "text": "ありえネー"}
