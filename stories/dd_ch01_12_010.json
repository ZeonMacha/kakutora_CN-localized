{
    "dir": "chap12/daydra/dd_ch01_12_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "12152",
        "cid": "tsubame",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "電車が止まった"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "電車が止まった"},
        { "location": "21/TALK"   , "narrator": "つばめ", "text": "…みんな、\nまだ電車の中かな？"},
        { "location": "23/TALK"   , "narrator": "ヒカル", "text": "そうみたいだね。"},
        { "location": "24/TALK"   , "narrator": "ヒカル", "text": "運行状況を見たら、\nまだ運転見合わせに\nなってるし…。"},
        { "location": "25/TALK"   , "narrator": "神楽", "text": "それにしても、\nこんなことって\nあるんですね。"},
        { "location": "27/TALK"   , "narrator": "神楽", "text": "私達以外、みんな電車に\n閉じ込められるなんて…。"},
        { "location": "28/TALK"   , "narrator": "つばめ", "text": "授業の後、すぐに劇場に\n来て正解だったよね。"},
        { "location": "29/TALK"   , "narrator": "神楽", "text": "でも、映写機の動かし方を\n誰も知らないんじゃ、\n意味ないですけど…。"},
        { "location": "30/TALK"   , "narrator": "ヒカル", "text": "劇場、開けられない\nからね…。"},
        { "location": "31/TALK"   , "narrator": "つばめ", "text": "…待ってるの、退屈だね。"},
        { "location": "32/TALK"   , "narrator": "ヒカル", "text": "そうだね…。"},
        { "location": "35/TALK"   , "narrator": "神楽", "text": "…………。"},
        { "location": "39/TALK"   , "narrator": "神楽", "text": "私達、このままでいいん\nでしょうか？"},
        { "location": "41/TALK"   , "narrator": "つばめ", "text": "どういうこと？"},
        { "location": "43/TALK"   , "narrator": "神楽", "text": "今のこの状況ですよ。"},
        { "location": "44/TALK"   , "narrator": "神楽", "text": "私達、高校生ですよ？\n青春時代真っ盛りですよ？"},
        { "location": "46/TALK"   , "narrator": "神楽", "text": "なのに、開けられもしない\n劇場の中で、ダラダラ\n時間を潰してるなんて――"},
        { "location": "48/TALK"   , "narrator": "神楽", "text": "青春の無駄遣いをして\nいるとは思いませんか？"},
        { "location": "50/TALK"   , "narrator": "つばめ", "text": "そ、そうかなぁ？\nヒカルくんはどう思う？"},
        { "location": "51/TALK"   , "narrator": "ヒカル", "text": "えっと…どうだろう？\n無駄にしてるように\n見えるのかな？"},
        { "location": "52/TALK"   , "narrator": "神楽", "text": "してますよ。\n青春を謳歌している風に\n全然見えません。"},
        { "location": "54/TALK"   , "narrator": "つばめ", "text": "そ、そう言われても、\n謳歌する方法なんて\nわからないし…。"},
        { "location": "55/TALK"   , "narrator": "神楽", "text": "青春を謳歌するための\n簡単な方法といえば――"},
        { "location": "56/TALK"   , "narrator": "神楽", "text": "恋愛以外にないじゃない\nですか。"},
        { "location": "59/TALK"   , "narrator": "ヒカル", "text": "なるほど…確かにそうかも\nしれないね。"},
        { "location": "61/TALK"   , "narrator": "ヒカル", "text": "ただ、残念ながら\n僕にはまだそういった\n相手がいないけど…。"},
        { "location": "62/TALK"   , "narrator": "つばめ", "text": "そうなんだ？\nちょっと意外かも。"},
        { "location": "63/TALK"   , "narrator": "神楽", "text": "えっ？　ヒカルくんには\nもうお相手がいるじゃない\nですか。"},
        { "location": "64/TALK"   , "narrator": "ヒカル", "text": "え？"},
        { "location": "65/TALK"   , "narrator": "神楽", "text": "ガブちゃんのことですよ。"},
        { "location": "66/TALK"   , "narrator": "ヒカル", "text": "ガブリエラさん？"},
        { "location": "67/TALK"   , "narrator": "神楽", "text": "そうですよ。\nお二人の関係は、\nその後どうなんですか？"},
        { "location": "68/TALK"   , "narrator": "神楽", "text": "少しは発展したんじゃ\nないですか？"},
        { "location": "71/TALK"   , "narrator": "つばめ", "text": "わわっ！\nこれって、恋バナ？"},
        { "location": "75/TALK"   , "narrator": "ヒカル", "text": "えっと…卯月さん？\nいったい何のことか、\nわからないんだけど…。"},
        { "location": "78/TALK"   , "narrator": "神楽", "text": "…もしかして、はぐらか\nそうとしていませんか？"},
        { "location": "80/TALK"   , "narrator": "神楽", "text": "お祭りの時、\n凄く良い雰囲気だったじゃ\nないですか。"},
        { "location": "81/TALK"   , "narrator": "ヒカル", "text": "ああ、あの時……。"},
        { "location": "82/TALK"   , "narrator": "ヒカル", "text": "あの時は、特に\nこれといって話らしい\n話はしてないけど……"},
        { "location": "83/TALK"   , "narrator": "神楽", "text": "その後はどうなんですか？"},
        { "location": "84/TALK"   , "narrator": "神楽", "text": "ＷＡＶＥやメールで\n連絡を取り合ったり\nしてるんじゃないですか？"},
        { "location": "85/TALK"   , "narrator": "ヒカル", "text": "えっと…卯月さん？\nもしかして何か勘違い\nしてるんじゃ…。"},
        { "location": "89/TALK"   , "narrator": "つばめ", "text": "ガブちゃんとヒカルくんの\n関係かぁ…。"},
        { "location": "101/TALK"  , "narrator": "つばめ", "text": "あなたはどう思う？"},
        { "location": "103/SEL"   , "narrator": "", "text": "ヒカルとガブリエラのこと？"},
        { "location": "104/ACT"   , "narrator": "", "text": "ヒカルとガブリエラのこと？"},
        { "location": "106/TALK"  , "narrator": "つばめ", "text": "そう"},
        { "location": "107/TALK"  , "narrator": "つばめ", "text": "何のことか聞く前だったのに、よくわかったね？"},
        { "location": "109/SEL"   , "narrator": "", "text": "聞いてたからね"},
        { "location": "110/ACT"   , "narrator": "", "text": "聞いてたからね"},
        { "location": "112/TALK"  , "narrator": "つばめ", "text": "声が出るなら、一緒にお話しできそうだね"},
        { "location": "114/TALK"  , "narrator": "つばめ", "text": "話逸れちゃった、ごめん"},
        { "location": "115/TALK"  , "narrator": "つばめ", "text": "卯月さんはああ言ってるけど"},
        { "location": "116/TALK"  , "narrator": "つばめ", "text": "二人とも、本当にそういう関係なのかな？"},
        { "location": "118/SEL"   , "narrator": "", "text": "ヒカルはモテそうだしね"},
        { "location": "119/SEL"   , "narrator": "", "text": "ガブリエラに聞いてみよう"},
        { "location": "120/ACT"   , "narrator": "", "text": "ヒカルはモテそうだしね"},
        { "location": "122/TALK"  , "narrator": "つばめ", "text": "確かに、ヒカルくんってかっこいいもんね"},
        { "location": "123/TALK"  , "narrator": "つばめ", "text": "だとしたら、ガブちゃんが好きになっても、おかしくないよね"},
        { "location": "134/TALK"  , "narrator": "ヒカル", "text": "あの、言っておきますが\n僕とガブリエラさんは、\nただのお友達だよ。"},
        { "location": "135/TALK"  , "narrator": "ヒカル", "text": "本当に、卯月さんが\n思っているような\n関係じゃないよ。"},
        { "location": "139/TALK"  , "narrator": "つばめ", "text": "…でも、ガブちゃんは\nそう思ってないかも\nしれないよ？"},
        { "location": "140/TALK"  , "narrator": "ヒカル", "text": "ちょ、逢瀬さん！？"},
        { "location": "143/TALK"  , "narrator": "つばめ", "text": "だって、ヒカルくんって\n凄くかっこいいから、\n女の子にモテそうだし――"},
        { "location": "144/TALK"  , "narrator": "つばめ", "text": "ガブちゃんが好きに\nなったとしても、\nおかしくないもん。"},
        { "location": "146/TALK"  , "narrator": "神楽", "text": "っ！？"},
        { "location": "150/TALK"  , "narrator": "ヒカル", "text": "え…いや、あはは…。"},
        { "location": "151/TALK"  , "narrator": "ヒカル", "text": "…なんというか、その…\nありがとうございます、で\nいいのかな？"},
        { "location": "153/TALK"  , "narrator": "つばめ", "text": "？　何が？"},
        { "location": "157/TALK"  , "narrator": "神楽", "text": "…つばめさん、\n凄いですね。"},
        { "location": "158/TALK"  , "narrator": "神楽", "text": "男の子に対して、サラッと\nかっこいい、って言える\nなんて…。"},
        { "location": "161/TALK"  , "narrator": "つばめ", "text": "えっ！？\nで、でも、事実だし…。"},
        { "location": "163/TALK"  , "narrator": "神楽", "text": "…まさかとは思いますが、\nつばめさんも\nヒカルくんのことを…。"},
        { "location": "165/TALK"  , "narrator": "つばめ", "text": "ち、違う、違うよ。\nそういうんじゃないよ！"},
        { "location": "166/TALK"  , "narrator": "つばめ", "text": "わたしはただ、ほら…\nガブちゃんだって\n女の子だから――"},
        { "location": "167/TALK"  , "narrator": "つばめ", "text": "ヒカルくんみたいな\nかっこいい男の子は\n好きかも、って…。"},
        { "location": "169/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "170/TALK"  , "narrator": "つばめ", "text": "だから、わたしが好きとか\nそういうんじゃなくて、\nその…。"},
        { "location": "173/TALK"  , "narrator": "神楽", "text": "冗談のつもりでした。"},
        { "location": "174/TALK"  , "narrator": "神楽", "text": "でも、そんなに慌てる\nところを見ると、\n本当は…。"},
        { "location": "176/TALK"  , "narrator": "つばめ", "text": "こういう話に慣れてない\nだけなんだってばー！"},
        { "location": "178/TALK"  , "narrator": "ヒカル", "text": "…僕からも、逢瀬さんを\nフォローするべきかも\nしれないけど――"},
        { "location": "179/TALK"  , "narrator": "ヒカル", "text": "余計に話がこんがらがり\nそうだし、黙ってた方が\n良さそうだね…。"},
        { "location": "180/ACT"   , "narrator": "", "text": "ガブリエラに聞いてみよう"},
        { "location": "181/TALK"  , "narrator": "つばめ", "text": "教えてくれるかな？"},
        { "location": "182/TALK"  , "narrator": "つばめ", "text": "でも、今は前と違って仲良くなれたんだし"},
        { "location": "183/TALK"  , "narrator": "つばめ", "text": "きっと、教えてくれるよね？"},
        { "location": "184/TALK"  , "narrator": "つばめ", "text": "ＷＡＶＥを送って聞いてみるよ"},
        { "location": "191/TALK"  , "narrator": "つばめ", "text": "えっと、なんて書こう\nかなぁ？"},
        { "location": "195/TALK"  , "narrator": "ヒカル", "text": "あの、言っておきますが\n僕とガブリエラさんは、\nただのお友達だよ。"},
        { "location": "196/TALK"  , "narrator": "ヒカル", "text": "本当に、卯月さんが\n思っているような\n関係じゃないよ。"},
        { "location": "197/TALK"  , "narrator": "つばめ", "text": "…よし、送信！\n返事来るかなぁ？"},
        { "location": "200/TALK"  , "narrator": "神楽", "text": "…それは、将来的には\nそうなる可能性もある、\nということですか？"},
        { "location": "203/TALK"  , "narrator": "ヒカル", "text": "なんか、芸能レポーター\nみたいになってるよ…？"},
        { "location": "205/TALK"  , "narrator": "神楽", "text": "今わかりました。\nハッキリ答えてくれない\n人にはこの聞き方が――"},
        { "location": "209/TALK"  , "narrator": "神楽", "text": "あっ、ごめんなさい。\nちょっと電話が…。"},
        { "location": "215/TALK"  , "narrator": "神楽", "text": "はい、もしも…"},
        { "location": "218/TALK"  , "narrator": "神楽", "text": "きゃっ！？"},
        { "location": "219/TALK"  , "narrator": "神楽", "text": "が、ガブちゃんですか？\nえ？　いえ、変なことは\n聞いてないですから！"},
        { "location": "220/TALK"  , "narrator": "神楽", "text": "っていうか、どうして\nそのことを知ってるん\nですか？"},
        { "location": "222/TALK"  , "narrator": "ヒカル", "text": "…電話の相手、\nガブリエラさん？"},
        { "location": "223/TALK"  , "narrator": "つばめ", "text": "そうみたいだね。"},
        { "location": "226/TALK"  , "narrator": "ヒカル", "text": "逢瀬さん、いったい何が\nどうなってるの？"},
        { "location": "228/TALK"  , "narrator": "つばめ", "text": "う～ん…実は今ね、\nガブちゃんにＷＡＶＥで\n直接聞いてみたの。"},
        { "location": "229/TALK"  , "narrator": "つばめ", "text": "ヒカルくんとの関係は、\nどこまで進んだのか、\nって。"},
        { "location": "238/TALK"  , "narrator": "ヒカル", "text": "聞いたの！？"},
        { "location": "239/TALK"  , "narrator": "つばめ", "text": "うん…あの様子だと、\n教えてもらえない\nみたいだけど…。"},
        { "location": "241/TALK"  , "narrator": "つばめ", "text": "やっぱり、まだ心を\n開いてくれてないの\nかなぁ？"},
        { "location": "252/TALK"  , "narrator": "ヒカル", "text": "…ああ、そうか。"},
        { "location": "253/TALK"  , "narrator": "ヒカル", "text": "こういうところが、\n天然、と言われるところ\nなんだね…。"},
        { "location": "18/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>7月6日　3:45 PM</color>\n平日の放課後、神楽坂トライナリー劇場内にて。"}
    ]
}
