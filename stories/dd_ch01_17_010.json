{
    "dir": "chap17/daydra/dd_ch01_17_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "17152",
        "cid": "tsubame",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "先生の不安"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "先生の不安"},
        { "location": "30/TALK"   , "narrator": "珠緒先生", "text": "逢瀬さん…\nお仕事の方はどう？"},
        { "location": "32/TALK"   , "narrator": "つばめ", "text": "仕事っていうと…\n特別攻撃隊のことですか？"},
        { "location": "33/TALK"   , "narrator": "珠緒先生", "text": "ええ…上手くいってる？\n困ったこととかはない？"},
        { "location": "35/TALK"   , "narrator": "つばめ", "text": "はい、大丈夫です。\n先輩の皆さんはもちろん、\n真幌さんも優しいですし。"},
        { "location": "37/TALK"   , "narrator": "珠緒先生", "text": "そう…。"},
        { "location": "38/TALK"   , "narrator": "つばめ", "text": "…先生？"},
        { "location": "40/TALK"   , "narrator": "珠緒先生", "text": "ごめんなさい。\nどうしても、\n心配になっちゃうの。"},
        { "location": "41/TALK"   , "narrator": "珠緒先生", "text": "逢瀬さんって、あんまり\n特別攻撃隊に向いてる\n性格に思えないから――"},
        { "location": "42/TALK"   , "narrator": "珠緒先生", "text": "ちゃんとやれてるの\nかな、って…。"},
        { "location": "45/TALK"   , "narrator": "つばめ", "text": "…………。"},
        { "location": "47/TALK"   , "narrator": "珠緒先生", "text": "相談したいこととか\nあるんじゃないかな、\nって思ったんだけど――"},
        { "location": "48/TALK"   , "narrator": "珠緒先生", "text": "私の考え過ぎだった\nみたいね。"},
        { "location": "49/SEL"    , "narrator": "", "text": "相談してみれば？"},
        { "location": "50/SEL"    , "narrator": "", "text": "弱音を見せるな！"},
        { "location": "53/TALK"   , "narrator": "つばめ", "text": "…話、聞いてもらおう\nかな？"},
        { "location": "54/TALK"   , "narrator": "つばめ", "text": "でも、お仕事をやるのに\n自信がないなんて\n言ったら――"},
        { "location": "56/TALK"   , "narrator": "つばめ", "text": "今以上に心配かけちゃい\nそうだし…。"},
        { "location": "59/TALK"   , "narrator": "つばめ", "text": "大丈夫ですよ、先生。"},
        { "location": "60/TALK"   , "narrator": "つばめ", "text": "わたし一人だったら、\n多分平気じゃないと\n思うけど――"},
        { "location": "61/TALK"   , "narrator": "つばめ", "text": "わたしよりも、うんと\n頼りになる先輩方がいて\nくれるから――"},
        { "location": "62/TALK"   , "narrator": "つばめ", "text": "本当に平気なんです。"},
        { "location": "64/TALK"   , "narrator": "珠緒先生", "text": "…………。"},
        { "location": "65/TALK"   , "narrator": "珠緒先生", "text": "やっぱり、私が心配性\n過ぎただけみたい。"},
        { "location": "66/TALK"   , "narrator": "珠緒先生", "text": "ごめんなさいね。\n変なこと言っちゃって…。"},
        { "location": "68/TALK"   , "narrator": "つばめ", "text": "いえ、そんなこと\nないです。"},
        { "location": "69/TALK"   , "narrator": "つばめ", "text": "先生に、そんなふうに\n心配してもらえてるのが\nわかって――"},
        { "location": "71/TALK"   , "narrator": "つばめ", "text": "すごく嬉しかったです。"},
        { "location": "72/TALK"   , "narrator": "珠緒先生", "text": "当然でしょ？"},
        { "location": "73/TALK"   , "narrator": "珠緒先生", "text": "特別攻撃隊だろうが\n何だろうが、大切な生徒に\n代わりはないもの。"},
        { "location": "74/TALK"   , "narrator": "珠緒先生", "text": "だから、今更だけど、\n本当に気を付けてね。"},
        { "location": "78/TALK"   , "narrator": "つばめ", "text": "…先生、わたしのこと、\nそんなに心配してくれて\nたんだ…。"},
        { "location": "79/TALK"   , "narrator": "つばめ", "text": "今まで以上に、気を引き\n締めて戦わないと。"},
        { "location": "80/TALK"   , "narrator": "つばめ", "text": "あんな優しい先生を\n悲しませるなんて、\n絶対しちゃダメだよね。"},
        { "location": "82/ACT"    , "narrator": "", "text": "相談してみれば？"},
        { "location": "89/TALK"   , "narrator": "珠緒先生", "text": "携帯、確認した方が\nいいんじゃない？"},
        { "location": "90/TALK"   , "narrator": "珠緒先生", "text": "お仕事のことかも\nしれないんだから、\n優先しないとダメよ。"},
        { "location": "94/TALK"   , "narrator": "つばめ", "text": "は、はい…。"},
        { "location": "111/TALK"  , "narrator": "つばめ", "text": "やっぱり、相談してみようかな？"},
        { "location": "112/TALK"  , "narrator": "つばめ", "text": "ちょっと、真幌さん達には相談し辛いことだし"},
        { "location": "126/TALK"  , "narrator": "つばめ", "text": "すみません。\n何でもありませんでした。"},
        { "location": "127/TALK"  , "narrator": "つばめ", "text": "それで…その、ちょっと\n相談っていうか――"},
        { "location": "128/TALK"  , "narrator": "つばめ", "text": "アドバイスがもらえたら\n嬉しいな、ってことが\nあって…。"},
        { "location": "129/TALK"  , "narrator": "珠緒先生", "text": "私で力になれるならね。\n話してもらえる？"},
        { "location": "134/TALK"  , "narrator": "つばめ", "text": "…実は、ちょっとだけ\n不安なんです。"},
        { "location": "135/TALK"  , "narrator": "つばめ", "text": "このままみんなと一緒に、\nトライナリーとして\nやっていけるのかが…。"},
        { "location": "136/TALK"  , "narrator": "つばめ", "text": "わたしはみんなみたいに、\n特技とか持ってないし――"},
        { "location": "137/TALK"  , "narrator": "つばめ", "text": "あんまり、役に立ててる\nような気がしなくて…。"},
        { "location": "139/TALK"  , "narrator": "珠緒先生", "text": "…………。"},
        { "location": "142/TALK"  , "narrator": "つばめ", "text": "こんなこと言われても、\n困っちゃいますよね？"},
        { "location": "144/TALK"  , "narrator": "珠緒先生", "text": "ううん、聞いたのは\n私なんだから。"},
        { "location": "145/TALK"  , "narrator": "珠緒先生", "text": "でも、私の力じゃ\nどうすることもできない\n問題みたい。"},
        { "location": "147/TALK"  , "narrator": "珠緒先生", "text": "力になれそうになくて、\nごめんなさいね。"},
        { "location": "151/TALK"  , "narrator": "つばめ", "text": "いえ、そんな…。"},
        { "location": "153/TALK"  , "narrator": "珠緒先生", "text": "…でも、ちょっとだけ\n安心したわ。"},
        { "location": "154/TALK"  , "narrator": "珠緒先生", "text": "逢瀬さんって、普段から\n明るくて元気な姿しか\n見せないから――"},
        { "location": "155/TALK"  , "narrator": "珠緒先生", "text": "お仕事に対する不安とか、\n抱えてないのかと思って\n少し怖かったの。"},
        { "location": "156/TALK"  , "narrator": "つばめ", "text": "怖い…ですか？"},
        { "location": "157/TALK"  , "narrator": "珠緒先生", "text": "あなたはまだ高校生なの。\n大人に近くはあるけど、\nまだまだ子供よ？"},
        { "location": "158/TALK"  , "narrator": "珠緒先生", "text": "子供が急に命がけの\n戦いに参加することに\nなったのに――"},
        { "location": "159/TALK"  , "narrator": "珠緒先生", "text": "それに対して何の不安も\n感じてなかったとしたら、\nちょっと異常でしょ？"},
        { "location": "160/TALK"  , "narrator": "つばめ", "text": "…そうですね。\n自分でも、そんな風には\nなりたくないです。"},
        { "location": "161/TALK"  , "narrator": "珠緒先生", "text": "そう思えるなら、\n逢瀬さんは平気よ。"},
        { "location": "162/TALK"  , "narrator": "珠緒先生", "text": "私には、あなたの不安や\n不満を解決できる力は\nないかもしれないけど――"},
        { "location": "163/TALK"  , "narrator": "珠緒先生", "text": "話を聞いたりするくらいは\nできるから…先生のことも\n頼ってほしいな。"},
        { "location": "166/TALK"  , "narrator": "つばめ", "text": "…ありがとうございます。\n凄く嬉しいです。"},
        { "location": "167/TALK"  , "narrator": "つばめ", "text": "弱音とかって、どうしても\n真幌さん達には言えない\nから――"},
        { "location": "168/TALK"  , "narrator": "つばめ", "text": "そういう話とかでも、\n聞いてもらえますか？"},
        { "location": "170/TALK"  , "narrator": "珠緒先生", "text": "ええ、もちろん。"},
        { "location": "171/TALK"  , "narrator": "珠緒先生", "text": "逢瀬さんの気持ちが、\n少しでもラクになる\n手伝いができるなら――"},
        { "location": "172/TALK"  , "narrator": "珠緒先生", "text": "いつでも相談に来てね。\n遠慮なんかしたらダメよ？"},
        { "location": "189/ACT"   , "narrator": "", "text": "弱音を見せるな！"},
        { "location": "195/TALK"  , "narrator": "珠緒先生", "text": "携帯、確認した方が\nいいんじゃない？"},
        { "location": "196/TALK"  , "narrator": "珠緒先生", "text": "お仕事のことかも\nしれないんだから、\n優先しないとダメよ。"},
        { "location": "200/TALK"  , "narrator": "つばめ", "text": "は、はい…。"},
        { "location": "217/TALK"  , "narrator": "つばめ", "text": "そうだね"},
        { "location": "218/TALK"  , "narrator": "つばめ", "text": "わたしが弱音を見せたら、不安にさせちゃうと思うし"},
        { "location": "233/TALK"  , "narrator": "つばめ", "text": "すみません。\n何でもありませんでした。"},
        { "location": "235/TALK"  , "narrator": "つばめ", "text": "お仕事、ちょっとだけ\n不安なことはあるけど――"},
        { "location": "237/TALK"  , "narrator": "つばめ", "text": "でも、大丈夫です。\nどうにか皆さんについて\nいけてますし――"},
        { "location": "238/TALK"  , "narrator": "つばめ", "text": "もう少し経験を積めば、\n慣れて普通に感じられると\n思いますから。"},
        { "location": "241/TALK"  , "narrator": "珠緒先生", "text": "…………。"},
        { "location": "243/TALK"  , "narrator": "珠緒先生", "text": "逢瀬さん…それはあまり\n大丈夫とは言えないわ。"},
        { "location": "245/TALK"  , "narrator": "つばめ", "text": "…どうしてですか？"},
        { "location": "248/TALK"  , "narrator": "珠緒先生", "text": "…この学園は、逢瀬さん\nみたいな特別攻撃隊の\n人達だけじゃなくて――"},
        { "location": "249/TALK"  , "narrator": "珠緒先生", "text": "将来的に通常攻撃隊に\n所属する子達の養成科も\nあるから――"},
        { "location": "250/TALK"  , "narrator": "珠緒先生", "text": "時々現場にも行くし、\nそれに慣れてしまうのは\n当然だとは思うの。"},
        { "location": "252/TALK"  , "narrator": "珠緒先生", "text": "けど…あなた達はまだ、\n高校生なのよ？"},
        { "location": "253/TALK"  , "narrator": "珠緒先生", "text": "それなのに、こんな状況に\n慣れるなんていうのは、\n普通とは言えないわ。"},
        { "location": "255/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "257/TALK"  , "narrator": "珠緒先生", "text": "フェノメノンが普通の\n人達より、身近な物に\nなるのは仕方ないけど――"},
        { "location": "258/TALK"  , "narrator": "珠緒先生", "text": "慣れてはほしくないの。\nあれは普通じゃない、\n異常なことなんだから。"},
        { "location": "259/TALK"  , "narrator": "つばめ", "text": "…そうですよね。\n先生の言うとおりだと\n思います。"},
        { "location": "260/TALK"  , "narrator": "つばめ", "text": "わたしも、ちょっと前まで\n戦いとは無縁の生活を\nしてたんだから――"},
        { "location": "261/TALK"  , "narrator": "つばめ", "text": "こんなすぐ慣れちゃう方が\n異常なんですよね？"},
        { "location": "263/TALK"  , "narrator": "珠緒先生", "text": "…………。"},
        { "location": "264/TALK"  , "narrator": "珠緒先生", "text": "…ごめんなさい。\n私のワガママだったわ。"},
        { "location": "266/TALK"  , "narrator": "珠緒先生", "text": "何を言ったところで、\n私が逢瀬さんの代わりに\n戦うことはできないし――"},
        { "location": "267/TALK"  , "narrator": "珠緒先生", "text": "結局、あなた達を\n頼らなきゃ\nいけないんだもの。"},
        { "location": "269/TALK"  , "narrator": "つばめ", "text": "…ワガママなんかじゃ\nないです。"},
        { "location": "270/TALK"  , "narrator": "つばめ", "text": "先生の言ってること、\n正しいと思います。"},
        { "location": "272/TALK"  , "narrator": "珠緒先生", "text": "…ありがと。"},
        { "location": "274/TALK"  , "narrator": "珠緒先生", "text": "ごめんなさいね。\n話を聞くつもりが、逆に\n困らせちゃったみたいで。"},
        { "location": "281/TALK"  , "narrator": "つばめ", "text": "…なんだか、大切なことを\n思い出した気がするな。"},
        { "location": "282/TALK"  , "narrator": "つばめ", "text": "先生の言った通り、\n慣れ過ぎないように\n気を付けなきゃ…。"},
        { "location": "15/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>7月19日　10:02 PM</color>\nとある平日、２時間目終了後の\n休み時間のこと。"},
        { "location": "183/DIALOG", "narrator": "Dialog_GEThimegoto_ch01", "text": "【見ていてくれる？】"}
    ]
}
