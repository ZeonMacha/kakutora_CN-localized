        { "location": "101/SCENARIO", "narrator": "", "text": "520_贅沢すぎる痛みがあるの"},
        { "location": "126/TALK"    , "narrator": "アーヤ", "text": "あーもう"},
        { "location": "127/TALK"    , "narrator": "アーヤ", "text": "やんなっちゃった"},
        { "location": "129/SEL"     , "narrator": "", "text": "今日はゆっくりお休み"},
        { "location": "130/SEL"     , "narrator": "", "text": "まあそう言わず"},
        { "location": "131/SEL"     , "narrator": "", "text": "$me$でよかったら聞くよ"},
        { "location": "132/ACT"     , "narrator": "", "text": "今日はゆっくりお休み"},
        { "location": "133/TALK"    , "narrator": "アーヤ", "text": "そうね"},
        { "location": "134/TALK"    , "narrator": "アーヤ", "text": "そうしようかな"},
        { "location": "136/TALK"    , "narrator": "アーヤ", "text": "おやすみなさい"},
        { "location": "137/ACT"     , "narrator": "", "text": "まあそう言わず"},
        { "location": "138/TALK"    , "narrator": "アーヤ", "text": "そうね"},
        { "location": "139/TALK"    , "narrator": "アーヤ", "text": "愚痴を言うのは"},
        { "location": "140/TALK"    , "narrator": "アーヤ", "text": "よくないわ(;^_^A"},
        { "location": "141/TALK"    , "narrator": "アーヤ", "text": "じゃあ"},
        { "location": "142/TALK"    , "narrator": "アーヤ", "text": "また明日ね(^ε^)-☆!!"},
        { "location": "143/ACT"     , "narrator": "", "text": "$me$でよかったら聞くよ"},
        { "location": "153/TALK"    , "narrator": "アーヤ", "text": "ほんと？"},
        { "location": "154/TALK"    , "narrator": "アーヤ", "text": "でも"},
        { "location": "155/TALK"    , "narrator": "アーヤ", "text": "$handle$さん"},
        { "location": "156/TALK"    , "narrator": "アーヤ", "text": "疲れてるんじゃない？"},
        { "location": "158/SEL"     , "narrator": "", "text": "気にしないで"},
        { "location": "159/SEL"     , "narrator": "", "text": "アーヤと話すと元気になるし"},
        { "location": "160/SEL"     , "narrator": "", "text": "義務だから"},
        { "location": "161/ACT"     , "narrator": "", "text": "気にしないで"},
        { "location": "162/TALK"    , "narrator": "アーヤ", "text": "そう"},
        { "location": "163/TALK"    , "narrator": "アーヤ", "text": "いうわけには"},
        { "location": "164/TALK"    , "narrator": "アーヤ", "text": "いかないわよ"},
        { "location": "165/ACT"     , "narrator": "", "text": "アーヤと話すと元気になるし"},
        { "location": "166/TALK"    , "narrator": "アーヤ", "text": "そう？"},
        { "location": "167/TALK"    , "narrator": "アーヤ", "text": "そう言ってもらえると"},
        { "location": "168/TALK"    , "narrator": "アーヤ", "text": "うれしいわ"},
        { "location": "169/ACT"     , "narrator": "", "text": "義務だから"},
        { "location": "170/TALK"    , "narrator": "アーヤ", "text": "何それ"},
        { "location": "172/TALK"    , "narrator": "アーヤ", "text": "ちょっと"},
        { "location": "173/TALK"    , "narrator": "アーヤ", "text": "哀しいかも"},
        { "location": "175/TALK"    , "narrator": "アーヤ", "text": "$handle$さんと話してて"},
        { "location": "176/TALK"    , "narrator": "アーヤ", "text": "悩むことでもないって気がしてきたわ"},
        { "location": "177/TALK"    , "narrator": "アーヤ", "text": "ありがと"},
        { "location": "178/TALK"    , "narrator": "アーヤ", "text": "また明日ね(^ε^)-☆!!"},
        { "location": "182/TALK"    , "narrator": "アーヤ", "text": "なんて言ったけど"},
        { "location": "184/TALK"    , "narrator": "アーヤ", "text": "少しだけね"},
        { "location": "187/TALK"    , "narrator": "ボイスメール", "text": "キミと歩いてく"},
