    "type": "",
    "info": {
        "story_id": "21009",
        "cid": "",
        "title": "009 ココロスフィアストーリー【Lv03】",
        "sub_title": "綺麗すぎる湖Ⅱ＜帰結＞"
    },
    "entry":
    [
        { "location": "50/SCENARIO", "narrator": "", "text": "綺麗すぎる湖４"},
        { "location": "59/TALK"    , "narrator": "潜在つばめ", "text": "なるほど、\n大したものだよ。"},
        { "location": "60/TALK"    , "narrator": "潜在つばめ", "text": "まさか深層世界でも\nあなたに負けるなんて。"},
        { "location": "61/TALK"    , "narrator": "表層つばめ", "text": "続き、\n見せてくれるよね？"},
        { "location": "62/TALK"    , "narrator": "潜在つばめ", "text": "もちろんだよ。\nそれはココロの中の\n約束事だもん。"},
        { "location": "63/TALK"    , "narrator": "潜在つばめ", "text": "でも何度も言うけど、\n知った後の気持ちの\n処理は自己責任で。"},
        { "location": "64/TALK"    , "narrator": "潜在つばめ", "text": "それだけは、\nよろしくね。"},
        { "location": "65/TALK"    , "narrator": "表層つばめ", "text": "……うん。"},
        { "location": "87/DIALOG"  , "narrator": "", "text": "静岡での高校入学後、\n初めてできた友達と帰宅中、\nそのうちの一人がスマホを\n池に落としてしまった。\n\nそしてその翌日のこと――"},
        { "location": "89/TALK"    , "narrator": "つばめ", "text": "おはよう！"},
        { "location": "90/TALK"    , "narrator": "女子高校生Ａ", "text": "あ、おはよー、\nつばめちゃん。"},
        { "location": "91/TALK"    , "narrator": "つばめ", "text": "あ、っと……"},
        { "location": "97/TALK"    , "narrator": "つばめ", "text": "これ！\n見つけたよ！"},
        { "location": "98/TALK"    , "narrator": "女子高校生Ａ", "text": "え…"},
        { "location": "99/TALK"    , "narrator": "女子高校生Ａ", "text": "ええええっ！！\nそれって昨日落とした\n私のスマホ！？"},
        { "location": "101/TALK"   , "narrator": "つばめ", "text": "うんっ！\n見つかって良かったよ。"},
        { "location": "102/TALK"   , "narrator": "女子高校生Ａ", "text": "いや……その…\nでも、あのため池、\n超汚くなかった？"},
        { "location": "104/TALK"   , "narrator": "つばめ", "text": "ちょっと、だけ、\nえへへ…"},
        { "location": "105/TALK"   , "narrator": "つばめ", "text": "ああでも大丈夫だよ！\nお風呂で念入りに\n身体洗ったし！"},
        { "location": "106/TALK"   , "narrator": "つばめ", "text": "臭くないよね？"},
        { "location": "107/TALK"   , "narrator": "女子高校生Ａ", "text": "……。"},
        { "location": "108/TALK"   , "narrator": "女子高校生Ａ", "text": "あり……がとう……"},
        { "location": "109/TALK"   , "narrator": "つばめ", "text": "…どうしたの？"},
        { "location": "110/TALK"   , "narrator": "女子高校生Ａ", "text": "はぁ…。\nちょっと待って。"},
        { "location": "113/TALK"   , "narrator": "女子高校生Ａ", "text": "はいこれ。\n約束の１万円。\nこれでいい？"},
        { "location": "115/TALK"   , "narrator": "つばめ", "text": "ええええっ！！\nいいいいらないよ！"},
        { "location": "116/TALK"   , "narrator": "女子高校生Ａ", "text": "え？\nなんで？"},
        { "location": "117/TALK"   , "narrator": "つばめ", "text": "わたしは、みさき\nちゃんが喜んでくれ\nたらってそれだけで…"},
        { "location": "118/TALK"   , "narrator": "つばめ", "text": "とにかく、見つかって\n良かったよ。\nそれじゃまた後でね！"},
        { "location": "122/TALK"   , "narrator": "女子高校生Ａ", "text": "……。"},
        { "location": "124/TALK"   , "narrator": "女子高校生Ｂ", "text": "おはよー！"},
        { "location": "125/TALK"   , "narrator": "女子高校生Ｂ", "text": "って、あれ？\nどうしたの？"},
        { "location": "126/TALK"   , "narrator": "女子高校生Ａ", "text": "いや、\nつばめちゃんがさ……"},
        { "location": "135/TALK"   , "narrator": "女子高校生Ｂ", "text": "ええっ！\nマジで？\n信じらんない。"},
        { "location": "136/TALK"   , "narrator": "女子高校生Ｂ", "text": "で、そのスマホ\nどうすんの？"},
        { "location": "137/TALK"   , "narrator": "女子高校生Ａ", "text": "使わないよ、\n新しいの買って\nもらっちゃったし。"},
        { "location": "138/TALK"   , "narrator": "女子高校生Ａ", "text": "それに汚いじゃん…？"},
        { "location": "139/TALK"   , "narrator": "女子高校生Ｂ", "text": "だよねー！"},
        { "location": "140/TALK"   , "narrator": "女子高校生Ａ", "text": "つばめちゃんってさぁ、\nなんかちょっと別の\n世界に生きてるよね。"},
        { "location": "141/TALK"   , "narrator": "女子高校生Ｂ", "text": "あそうそうそう！\n私もそう思ってたん\nだよね！！"},
        { "location": "142/TALK"   , "narrator": "女子高校生Ａ", "text": "やっていける自信\nないわー。\n眩しすぎて！"},
        { "location": "143/TALK"   , "narrator": "女子高校生Ｂ", "text": "同感～～。\n気が合うねえ。"},
        { "location": "144/TALK"   , "narrator": "女子高校生Ｂ", "text": "みさきちゃんとは\nズッ友でいられそう。"},
        { "location": "145/TALK"   , "narrator": "女子高校生Ａ", "text": "ズッ友だよー。\n当然じゃん。"},
        { "location": "146/TALK"   , "narrator": "女子高校生Ｂ", "text": "あはは～よかった！"},
        { "location": "148/TALK"   , "narrator": "女子高校生Ｂ", "text": "あ、そうだ！\n今日学校終わったらさ、\n二人で――"},
        { "location": "162/TALK"   , "narrator": "潜在つばめ", "text": "…どうかな？\n何かのヒントに\nなった？"},
        { "location": "163/TALK"   , "narrator": "表層つばめ", "text": "わからない。\nでも……"},
        { "location": "164/TALK"   , "narrator": "表層つばめ", "text": "わたしのこと、\n後であんな風に\n話されてたんだ。"},
        { "location": "165/TALK"   , "narrator": "表層つばめ", "text": "全然忘れてたよ。"},
        { "location": "166/TALK"   , "narrator": "潜在つばめ", "text": "忘れてたわけじゃ\nないよ。"},
        { "location": "167/TALK"   , "narrator": "潜在つばめ", "text": "心の奥で繋がってる\n集合的無意識から拾っ\nてきちゃってるだけ。"},
        { "location": "168/TALK"   , "narrator": "潜在つばめ", "text": "そういうことも\nあるんだよ。"},
        { "location": "169/TALK"   , "narrator": "潜在つばめ", "text": "だから「ヒントだけで\n済めばいいけど」って\n言ったの。"},
        { "location": "170/TALK"   , "narrator": "表層つばめ", "text": "……。"},
        { "location": "172/TALK"   , "narrator": "潜在つばめ", "text": "…と、わたしそろそろ\nエネルギー切れみたい。"},
        { "location": "174/TALK"   , "narrator": "潜在つばめ", "text": "約束はちゃんと\n果たしたよね。"},
        { "location": "175/TALK"   , "narrator": "潜在つばめ", "text": "あとはじっくり\n考えてみるといいと\n思うよ。"},
        { "location": "186/TALK"   , "narrator": "表層つばめ", "text": "わたし……"},
        { "location": "187/SEL"    , "narrator": "（選択肢）", "text": "つばめ、かわいい！"},
        { "location": "188/SEL"    , "narrator": "（選択肢）", "text": "純粋すぎるんだね"},
        { "location": "189/SEL"    , "narrator": "（選択肢）", "text": "確かに引くわ、これは"},
        { "location": "190/ACT"    , "narrator": "", "text": "つばめ、かわいい！"},
        { "location": "193/TALK"   , "narrator": "表層つばめ", "text": "ええええっ！\nなんでそうなるの？"},
        { "location": "194/SEL"    , "narrator": "（選択肢）", "text": "今のでもっとつばめが好きになった"},
        { "location": "195/ACT"    , "narrator": "", "text": "今のでもっとつばめが好きになった"},
        { "location": "197/TALK"   , "narrator": "表層つばめ", "text": "そ、そうなの？\nよくわかんないけど―"},
        { "location": "199/TALK"   , "narrator": "表層つばめ", "text": "でも、あんだけ困って\nたら、助けたいって\n思わないのかな。"},
        { "location": "200/SEL"    , "narrator": "（選択肢）", "text": "なるよ！"},
        { "location": "201/SEL"    , "narrator": "（選択肢）", "text": "人によるかな"},
        { "location": "202/ACT"    , "narrator": "", "text": "なるよ！"},
        { "location": "204/TALK"   , "narrator": "表層つばめ", "text": "そっか、\n少し安心したよ。"},
        { "location": "205/TALK"   , "narrator": "表層つばめ", "text": "わたしだけ\n何かおかしいのかと\n思っちゃってた。"},
        { "location": "206/ACT"    , "narrator": "", "text": "人によるかな"},
        { "location": "207/TALK"   , "narrator": "表層つばめ", "text": "そっか。確かに、\n人それぞれだもんね。"},
        { "location": "209/ACT"    , "narrator": "", "text": "純粋すぎるんだね"},
        { "location": "210/TALK"   , "narrator": "表層つばめ", "text": "そんなことないよ。\nわたし、そんなに\n綺麗じゃないよ？"},
        { "location": "211/TALK"   , "narrator": "表層つばめ", "text": "すぐに怒っちゃうし、\nいやなことも\n考えちゃうし……"},
        { "location": "212/SEL"    , "narrator": "（選択肢）", "text": "普通だよ"},
        { "location": "213/ACT"    , "narrator": "", "text": "普通だよ"},
        { "location": "215/TALK"   , "narrator": "表層つばめ", "text": "そうかな……。"},
        { "location": "216/SEL"    , "narrator": "（選択肢）", "text": "それに、そこがつばめのいいところだと思う"},
        { "location": "217/ACT"    , "narrator": "", "text": "それに、そこがつばめのいいところだと思う"},
        { "location": "219/TALK"   , "narrator": "表層つばめ", "text": "いいところ…\nなのかなぁ……"},
        { "location": "220/ACT"    , "narrator": "", "text": "確かに引くわ、これは"},
        { "location": "222/TALK"   , "narrator": "表層つばめ", "text": "そうなんだ……\nこれから気をつけよう。"},
        { "location": "223/TALK"   , "narrator": "表層つばめ", "text": "……とはいっても\nどうやって気をつけた\nらいいかわからない。"},
        { "location": "224/SEL"    , "narrator": "（選択肢）", "text": "そのままでいいんじゃない？"},
        { "location": "225/ACT"    , "narrator": "", "text": "そのままでいいんじゃない？"},
        { "location": "227/TALK"   , "narrator": "表層つばめ", "text": "そうなの？"},
        { "location": "228/SEL"    , "narrator": "（選択肢）", "text": "つばめの性格に合う人もいるよ"},
        { "location": "229/ACT"    , "narrator": "", "text": "つばめの性格に合う人もいるよ"},
        { "location": "231/TALK"   , "narrator": "表層つばめ", "text": "そういうもの\nなのかなぁ。"},
        { "location": "233/SEL"    , "narrator": "（選択肢）", "text": "とにかく！！"},
        { "location": "234/ACT"    , "narrator": "", "text": "とにかく！！"},
        { "location": "236/TALK"   , "narrator": "表層つばめ", "text": "は、はいっ！！"},
        { "location": "237/SEL"    , "narrator": "（選択肢）", "text": "友達欲しかったら当たっていくしかないよ！"},
        { "location": "238/ACT"    , "narrator": "", "text": "友達欲しかったら当たっていくしかないよ！"},
        { "location": "240/TALK"   , "narrator": "表層つばめ", "text": "そ、そうなんだけど…\nまた同じことに\nなっちゃったら……"},
        { "location": "241/SEL"    , "narrator": "（選択肢）", "text": "$me$はつばめが好きだよ"},
        { "location": "242/SEL"    , "narrator": "（選択肢）", "text": "つばめと気が合う子だっているよ"},
        { "location": "243/ACT"    , "narrator": "", "text": "$me$はつばめが好きだよ"},
        { "location": "245/TALK"   , "narrator": "表層つばめ", "text": "そ、そうなの？"},
        { "location": "247/TALK"   , "narrator": "表層つばめ", "text": "なんか、ちょっと\n嬉しいかも。"},
        { "location": "248/ACT"    , "narrator": "", "text": "つばめと気が合う子だっているよ"},
        { "location": "249/TALK"   , "narrator": "表層つばめ", "text": "そう…だね。"},
        { "location": "251/SEL"    , "narrator": "（選択肢）", "text": "元気出して。いつものつばめで当たっていけばいい。"},
        { "location": "252/ACT"    , "narrator": "", "text": "元気出して。いつものつばめで当たっていけばいい。"},
        { "location": "254/TALK"   , "narrator": "表層つばめ", "text": "……うん。"},
        { "location": "255/TALK"   , "narrator": "表層つばめ", "text": "最初から諦めてたら\nだめだよね。"},
        { "location": "257/TALK"   , "narrator": "表層つばめ", "text": "$handle$\nみたいに――"},
        { "location": "258/TALK"   , "narrator": "表層つばめ", "text": "わたしのこと、\n好きって言ってくれる\n人もいるんだし。"},
        { "location": "260/TALK"   , "narrator": "表層つばめ", "text": "勇気出して\n当たってみるよ！"},
        { "location": "261/SEL"    , "narrator": "（選択肢）", "text": "がんばって！"},
        { "location": "262/ACT"    , "narrator": "", "text": "がんばって！"},
        { "location": "265/TALK"   , "narrator": "表層つばめ", "text": "いろいろありがとう。"},
        { "location": "266/TALK"   , "narrator": "表層つばめ", "text": "今回は、ちょっと\n自分を知ることが\n出来た気がするよ。"},
        { "location": "267/TALK"   , "narrator": "表層つばめ", "text": "また何かあったら、\nよろしくね。"}
    ]
}
