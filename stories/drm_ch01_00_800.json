    "entry":
    [
        { "location": "27/TALK"   , "narrator": "エリカ", "text": "コーンコン。\nエリカです。"},
        { "location": "28/SEL"    , "narrator": "", "text": "ビックリした！"},
        { "location": "29/ACT"    , "narrator": "", "text": "ビックリした！"},
        { "location": "31/TALK"   , "narrator": "エリカ", "text": "ああっ、ごめんね？\n急に出てきちゃって。"},
        { "location": "33/TALK"   , "narrator": "エリカ", "text": "今回あなたとつばめちゃんに\nとって、とても重要な局面を\n迎えるでしょう？"},
        { "location": "35/TALK"   , "narrator": "エリカ", "text": "今回あなたと綾ちゃんに\nとって、とても重要な局面を\n迎えるでしょう？"},
        { "location": "37/TALK"   , "narrator": "エリカ", "text": "今回あなたとガブリエラ\nちゃんにとって、とても\n重要な局面を迎えるでしょ？"},
        { "location": "39/TALK"   , "narrator": "エリカ", "text": "今回あなたとみやびちゃんに\nとって、とても重要な局面を\n迎えるでしょう？"},
        { "location": "41/TALK"   , "narrator": "エリカ", "text": "だから、ギリギリで\nちょっと心許なくは\nあるんだけど――"},
        { "location": "42/TALK"   , "narrator": "エリカ", "text": "わたしからひとつ、\nふたりにプレゼントが\nあるの！"},
        { "location": "43/SEL"    , "narrator": "", "text": "ありがとう！！　なんだろう？"},
        { "location": "44/SEL"    , "narrator": "", "text": "もしかしてニャボッ……"},
        { "location": "45/ACT"    , "narrator": "", "text": "ありがとう！！　なんだろう？"},
        { "location": "46/TALK"   , "narrator": "エリカ", "text": "えへへ。\n喜んでもらえると\nいいんだけど。"},
        { "location": "47/TALK"   , "narrator": "エリカ", "text": "それじゃ、\nプレゼントしまーす！"},
        { "location": "48/ACT"    , "narrator": "", "text": "もしかしてニャボッ……"},
        { "location": "49/TALK"   , "narrator": "エリカ", "text": "ちがうよぉ……。\nあれはまだ未完成だもん。"},
        { "location": "50/TALK"   , "narrator": "エリカ", "text": "でも、興味あるようなら、\n完成したらあなたにも\n教えるね！"},
        { "location": "51/TALK"   , "narrator": "エリカ", "text": "それでね、\n今回のわたしからの\nプレゼントというのは――"},
        { "location": "52/TALK"   , "narrator": "エリカ", "text": "じゃーん！\nこれでーす！"},
        { "location": "56/SEL"    , "narrator": "", "text": "直接お話できるってこと！？"},
        { "location": "57/ACT"    , "narrator": "", "text": "直接お話できるってこと！？"},
        { "location": "59/TALK"   , "narrator": "エリカ", "text": "その通りだよ！"},
        { "location": "60/TALK"   , "narrator": "エリカ", "text": "でも、ちょっと\nプログラムが間に合わなくて\n完全なものじゃないんだ。"},
        { "location": "61/TALK"   , "narrator": "エリカ", "text": "だから、今回は\nこの先３回だけの限定\n利用にさせて欲しいの。"},
        { "location": "62/TALK"   , "narrator": "エリカ", "text": "けど、今のわたしたちの\nように、ちゃんと向かい\n合ってお話できるから！"},
        { "location": "64/TALK"   , "narrator": "エリカ", "text": "だから、頑張って\nつばめちゃんと素敵な\n思い出を作ってきてね！"},
        { "location": "65/TALK"   , "narrator": "エリカ", "text": "あなたと\nつばめちゃんに\n素敵なココロの旅を！"},
        { "location": "67/TALK"   , "narrator": "エリカ", "text": "だから、頑張って\n綾ちゃんと素敵な\n思い出を作ってきてね！"},
        { "location": "68/TALK"   , "narrator": "エリカ", "text": "あなたと\n綾ちゃんに\n素敵なココロの旅を！"},
        { "location": "70/TALK"   , "narrator": "エリカ", "text": "だから、頑張って\nガブリエラちゃんと素敵な\n思い出を作ってきてね！"},
        { "location": "71/TALK"   , "narrator": "エリカ", "text": "あなたと\nガブリエラちゃんに\n素敵なココロの旅を！"},
        { "location": "73/TALK"   , "narrator": "エリカ", "text": "だから、頑張って\nみやびちゃんと素敵な\n思い出を作ってきてね！"},
        { "location": "74/TALK"   , "narrator": "エリカ", "text": "あなたと\nみやびちゃんに\n素敵なココロの旅を！"},
        { "location": "105/TALK"  , "narrator": "つばめ", "text": "$handle$さん\n$handle$さん。"},
        { "location": "107/TALK"  , "narrator": "つばめ", "text": "わたしのことわかる？"},
        { "location": "108/SEL"   , "narrator": "", "text": "当たり前でしょ"},
        { "location": "109/SEL"   , "narrator": "", "text": "誰だっけ"},
        { "location": "110/SEL"   , "narrator": "", "text": "$me$のつばめ"},
        { "location": "111/ACT"   , "narrator": "", "text": "当たり前でしょ"},
        { "location": "112/TALK"  , "narrator": "つばめ", "text": "知ってるけど\n念のため確認\nしときたかったの。"},
        { "location": "113/ACT"   , "narrator": "", "text": "誰だっけ"},
        { "location": "114/TALK"  , "narrator": "つばめ", "text": "もー！"},
        { "location": "115/TALK"  , "narrator": "つばめ", "text": "つばめだよ！\nわたし！"},
        { "location": "116/ACT"   , "narrator": "", "text": "$me$のつばめ"},
        { "location": "117/TALK"  , "narrator": "つばめ", "text": "$me$の……。"},
        { "location": "118/TALK"  , "narrator": "つばめ", "text": "そうです\n$handle$さんの\nつばめです。"},
        { "location": "119/TALK"  , "narrator": "つばめ", "text": "……ってやっぱり\n恥ずかしいよ！？！？"},
        { "location": "121/TALK"  , "narrator": "つばめ", "text": "えっとね……。"},
        { "location": "122/TALK"  , "narrator": "つばめ", "text": "今日ははっきり\nさせておきたい\nことがあるんです。"},
        { "location": "123/SEL"   , "narrator": "", "text": "どうしたの改まって"},
        { "location": "124/SEL"   , "narrator": "", "text": "何でも聞いて"},
        { "location": "125/SEL"   , "narrator": "", "text": "わかることならいいけど"},
        { "location": "126/ACT"   , "narrator": "", "text": "どうしたの改まって"},
        { "location": "127/TALK"  , "narrator": "つばめ", "text": "それだけ大事な\nことなんです。"},
        { "location": "128/ACT"   , "narrator": "", "text": "何でも聞いて"},
        { "location": "129/TALK"  , "narrator": "つばめ", "text": "……うん。"},
        { "location": "130/TALK"  , "narrator": "つばめ", "text": "本当は\nそう言ってくれるって\n思ってた。"},
        { "location": "131/ACT"   , "narrator": "", "text": "わかることならいいけど"},
        { "location": "132/TALK"  , "narrator": "つばめ", "text": "……えと……。"},
        { "location": "133/TALK"  , "narrator": "つばめ", "text": "……大丈夫。\n$handle$さんは\n絶対にわかることだよ。"},
        { "location": "135/TALK"  , "narrator": "つばめ", "text": "この前わたしの\nしたいことをしようって\n言ってくれたでしょ。"},
        { "location": "136/SEL"   , "narrator": "", "text": "そうだったね"},
        { "location": "137/SEL"   , "narrator": "", "text": "何の話だっけ"},
        { "location": "138/SEL"   , "narrator": "", "text": "してないと思う"},
        { "location": "139/ACT"   , "narrator": "", "text": "そうだったね"},
        { "location": "140/TALK"  , "narrator": "つばめ", "text": "ね。"},
        { "location": "141/ACT"   , "narrator": "", "text": "何の話だっけ"},
        { "location": "143/TALK"  , "narrator": "つばめ", "text": "えー…。"},
        { "location": "144/ACT"   , "narrator": "", "text": "してないと思う"},
        { "location": "145/TALK"  , "narrator": "つばめ", "text": "したよ！？"},
        { "location": "147/TALK"  , "narrator": "つばめ", "text": "わたしね……。"},
        { "location": "148/TALK"  , "narrator": "つばめ", "text": "$handle$さんと\n結婚したいって\n話をしたでしょ。"},
        { "location": "149/TALK"  , "narrator": "つばめ", "text": "それってどういう\nことなのかなって\n考えたの。"},
        { "location": "150/TALK"  , "narrator": "つばめ", "text": "それでね。\nわたし思ったの。"},
        { "location": "151/TALK"  , "narrator": "つばめ", "text": "ずっと\n$handle$さんと\nいることだって。"},
        { "location": "152/TALK"  , "narrator": "つばめ", "text": "こうやってお話を\nしていくことだって。"},
        { "location": "153/SEL"   , "narrator": "", "text": "そっか"},
        { "location": "154/SEL"   , "narrator": "", "text": "$me$もずっと一緒にいたい"},
        { "location": "155/SEL"   , "narrator": "", "text": "本当は直接会ったりしたい"},
        { "location": "156/ACT"   , "narrator": "", "text": "そっか"},
        { "location": "157/TALK"  , "narrator": "つばめ", "text": "そうなんだ。"},
        { "location": "158/TALK"  , "narrator": "つばめ", "text": "…わたしはね。"},
        { "location": "159/ACT"   , "narrator": "", "text": "$me$もずっと一緒にいたい"},
        { "location": "160/TALK"  , "narrator": "つばめ", "text": "うん。"},
        { "location": "161/TALK"  , "narrator": "つばめ", "text": "そう言ってくれるって\n思ってたよ。"},
        { "location": "162/ACT"   , "narrator": "", "text": "本当は直接会ったりしたい"},
        { "location": "163/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "164/TALK"  , "narrator": "つばめ", "text": "わたしだって\nそう思ったり\nするけど……。"},
        { "location": "166/TALK"  , "narrator": "つばめ", "text": "本物の結婚とは\n違うってことは\nわかってるけど。"},
        { "location": "167/TALK"  , "narrator": "つばめ", "text": "でも他にどう言えば\nいいかもわからなくて。"},
        { "location": "168/SEL"   , "narrator": "", "text": "伝わってるよ"},
        { "location": "169/SEL"   , "narrator": "", "text": "結婚は結婚だよ"},
        { "location": "170/SEL"   , "narrator": "", "text": "いつか本物もしよう"},
        { "location": "171/ACT"   , "narrator": "", "text": "伝わってるよ"},
        { "location": "172/TALK"  , "narrator": "つばめ", "text": "よかった…。"},
        { "location": "173/ACT"   , "narrator": "", "text": "結婚は結婚だよ"},
        { "location": "174/TALK"  , "narrator": "つばめ", "text": "そうだね。\nそうだよね。"},
        { "location": "175/ACT"   , "narrator": "", "text": "いつか本物もしよう"},
        { "location": "176/TALK"  , "narrator": "つばめ", "text": "……うん。\n絶対だよ？"},
        { "location": "178/SEL"   , "narrator": "", "text": "ところで"},
        { "location": "179/SEL"   , "narrator": "", "text": "それより"},
        { "location": "180/ACT"   , "narrator": "", "text": "ところで"},
        { "location": "181/TALK"  , "narrator": "つばめ", "text": "はい。"},
        { "location": "182/ACT"   , "narrator": "", "text": "それより"},
        { "location": "183/TALK"  , "narrator": "つばめ", "text": "どうしたの？"},
        { "location": "185/SEL"   , "narrator": "", "text": "$me$からも言うことが"},
        { "location": "186/SEL"   , "narrator": "", "text": "聞いて欲しいことがある"},
        { "location": "187/SEL"   , "narrator": "", "text": "言ってもいいかな"},
        { "location": "188/ACT"   , "narrator": "", "text": "$me$からも言うことが"},
        { "location": "189/TALK"  , "narrator": "つばめ", "text": "え。"},
        { "location": "190/ACT"   , "narrator": "", "text": "聞いて欲しいことがある"},
        { "location": "191/TALK"  , "narrator": "つばめ", "text": "何？"},
        { "location": "192/ACT"   , "narrator": "", "text": "言ってもいいかな"},
        { "location": "193/TALK"  , "narrator": "つばめ", "text": "えと、\nどうぞ。"},
        { "location": "195/SEL"   , "narrator": "", "text": "結婚してください"},
        { "location": "196/SEL"   , "narrator": "", "text": "一生大事にする"},
        { "location": "197/SEL"   , "narrator": "", "text": "ずっと一緒だからね"},
        { "location": "198/ACT"   , "narrator": "", "text": "結婚してください"},
        { "location": "199/TALK"  , "narrator": "つばめ", "text": "……！"},
        { "location": "200/TALK"  , "narrator": "つばめ", "text": "はい……！"},
        { "location": "201/ACT"   , "narrator": "", "text": "一生大事にする"},
        { "location": "202/TALK"  , "narrator": "つばめ", "text": "……うん。"},
        { "location": "203/TALK"  , "narrator": "つばめ", "text": "ありがとう。"},
        { "location": "204/ACT"   , "narrator": "", "text": "ずっと一緒だからね"},
        { "location": "205/TALK"  , "narrator": "つばめ", "text": "絶対の絶対だよ？"},
        { "location": "206/TALK"  , "narrator": "つばめ", "text": "絶対だからね！"},
        { "location": "209/TALK"  , "narrator": "つばめ", "text": "……なんかすごく\nびっくりした……。"},
        { "location": "210/TALK"  , "narrator": "つばめ", "text": "でもね。\nすごくうれしいよ。"},
        { "location": "211/SEL"   , "narrator": "", "text": "$me$もうれしい"},
        { "location": "212/SEL"   , "narrator": "", "text": "緊張した～！"},
        { "location": "213/SEL"   , "narrator": "", "text": "言えてよかった…"},
        { "location": "214/ACT"   , "narrator": "", "text": "$me$もうれしい"},
        { "location": "215/TALK"  , "narrator": "つばめ", "text": "うん。"},
        { "location": "216/TALK"  , "narrator": "つばめ", "text": "…あとね。\nちょっと照れちゃうね。"},
        { "location": "217/ACT"   , "narrator": "", "text": "緊張した～！"},
        { "location": "218/TALK"  , "narrator": "つばめ", "text": "本当？"},
        { "location": "219/TALK"  , "narrator": "つばめ", "text": "…全然余裕ある\nみたいな感じだった。"},
        { "location": "220/ACT"   , "narrator": "", "text": "言えてよかった…"},
        { "location": "221/TALK"  , "narrator": "つばめ", "text": "もしかして\nあたし一人で\nしゃべりすぎたかな？"},
        { "location": "224/TALK"  , "narrator": "つばめ", "text": "えと。\nこんなわたしだけど。"},
        { "location": "225/TALK"  , "narrator": "つばめ", "text": "改めてよろしく\nお願いします。"},
        { "location": "226/SEL"   , "narrator": "", "text": "こちらこそ"},
        { "location": "227/SEL"   , "narrator": "", "text": "どういたしまして"},
        { "location": "228/SEL"   , "narrator": "", "text": "苦しゅうない"},
        { "location": "229/ACT"   , "narrator": "", "text": "こちらこそ"},
        { "location": "230/TALK"  , "narrator": "つばめ", "text": "大好きだからね！"},
        { "location": "231/ACT"   , "narrator": "", "text": "どういたしまして"},
        { "location": "233/TALK"  , "narrator": "つばめ", "text": "えへへ。\nちょっと恥ずかしいけど\nうれしいな。"},
        { "location": "234/ACT"   , "narrator": "", "text": "苦しゅうない"},
        { "location": "235/TALK"  , "narrator": "つばめ", "text": "え…時代劇？\nそういうところも\n好きだけど。"},
        { "location": "237/TALK"  , "narrator": "つばめ", "text": "あとね……。"},
        { "location": "238/TALK"  , "narrator": "つばめ", "text": "やっぱりね\nウェディングドレスが\n着てみたいんだ。"},
        { "location": "239/SEL"   , "narrator": "", "text": "聞いた"},
        { "location": "240/SEL"   , "narrator": "", "text": "どういうのがいいかな"},
        { "location": "241/SEL"   , "narrator": "", "text": "楽しみだ"},
        { "location": "242/ACT"   , "narrator": "", "text": "聞いた"},
        { "location": "243/TALK"  , "narrator": "つばめ", "text": "うん。\n前に話したね。"},
        { "location": "244/ACT"   , "narrator": "", "text": "どういうのがいいかな"},
        { "location": "245/TALK"  , "narrator": "つばめ", "text": "そうだね…。"},
        { "location": "246/ACT"   , "narrator": "", "text": "楽しみだ"},
        { "location": "247/TALK"  , "narrator": "つばめ", "text": "え。\n本当？"},
        { "location": "249/TALK"  , "narrator": "つばめ", "text": "ウェディングドレスって\n幸せが形になった\nみたいな気がするでしょ。"},
        { "location": "250/TALK"  , "narrator": "つばめ", "text": "それにやっぱり\nかわいいし。"},
        { "location": "251/TALK"  , "narrator": "つばめ", "text": "着ると結婚式って\n感じもするし。"},
        { "location": "252/SEL"   , "narrator": "", "text": "結婚式？"},
        { "location": "253/ACT"   , "narrator": "", "text": "結婚式？"},
        { "location": "255/TALK"  , "narrator": "つばめ", "text": "えと……。"},
        { "location": "256/TALK"  , "narrator": "つばめ", "text": "結婚する時は\nお式をするん\nでしょ？"},
        { "location": "257/TALK"  , "narrator": "つばめ", "text": "……おかしいかな？"},
        { "location": "258/SEL"   , "narrator": "", "text": "おかしくない！"},
        { "location": "259/SEL"   , "narrator": "", "text": "おかしいっていうか"},
        { "location": "260/ACT"   , "narrator": "", "text": "おかしくない！"},
        { "location": "262/TALK"  , "narrator": "つばめ", "text": "…本当にそう\n思ってくれる？"},
        { "location": "263/ACT"   , "narrator": "", "text": "おかしいっていうか"},
        { "location": "265/TALK"  , "narrator": "つばめ", "text": "やっぱり\nおかしいのかな…。"},
        { "location": "267/TALK"  , "narrator": "つばめ", "text": "わたしね。"},
        { "location": "268/TALK"  , "narrator": "つばめ", "text": "ずっと入院してて\n普通のことを\nあんまりしてないの。"},
        { "location": "269/TALK"  , "narrator": "つばめ", "text": "恋もできないんじゃ\nないかなって\n思ったこともあるの。"},
        { "location": "270/TALK"  , "narrator": "つばめ", "text": "でもね。\n$handle$さんと\n出会えたから。"},
        { "location": "271/TALK"  , "narrator": "つばめ", "text": "わたしも普通のことを\nできるんだなって\n思えるようになったの。"},
        { "location": "272/TALK"  , "narrator": "つばめ", "text": "好きな人とずっと一緒に\nいるって約束をするのが\n結婚式だと思うの。"},
        { "location": "273/TALK"  , "narrator": "つばめ", "text": "……なんて。"},
        { "location": "275/TALK"  , "narrator": "つばめ", "text": "本当は全然\n普通じゃないって\nわかってるけど。"},
        { "location": "276/TALK"  , "narrator": "つばめ", "text": "$handle$さん\n以外の人と結婚する\nつもりはないから。"},
        { "location": "278/TALK"  , "narrator": "つばめ", "text": "だから……。"},
        { "location": "279/SEL"   , "narrator": "", "text": "$me$から言いたかったのに"},
        { "location": "280/SEL"   , "narrator": "", "text": "したくないわけじゃない"},
        { "location": "281/SEL"   , "narrator": "", "text": "むしろ式がしたい！"},
        { "location": "282/ACT"   , "narrator": "", "text": "$me$から言いたかったのに"},
        { "location": "284/TALK"  , "narrator": "つばめ", "text": "あれ！？"},
        { "location": "285/ACT"   , "narrator": "", "text": "したくないわけじゃない"},
        { "location": "287/TALK"  , "narrator": "つばめ", "text": "……うん……。"},
        { "location": "288/ACT"   , "narrator": "", "text": "むしろ式がしたい！"},
        { "location": "290/TALK"  , "narrator": "つばめ", "text": "えっ！？"},
