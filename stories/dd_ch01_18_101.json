{
    "dir": "chap18/daydra/dd_ch01_18_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "18102",
        "cid": "tsubame",
        "title": "002 メインストーリー",
        "sub_title": "大事な友達だから＜前編＞"
    },
    "entry":
    [
        { "location": "33/TALK"   , "narrator": "雛", "text": "神楽ちゃん、\n今日もお休みだね。"},
        { "location": "34/TALK"   , "narrator": "キリト", "text": "そうだな…。\n逢瀬、卯月の様子は\nどうなんだ？"},
        { "location": "36/TALK"   , "narrator": "つばめ", "text": "それが、わたしにも\nわからないの。"},
        { "location": "38/TALK"   , "narrator": "つばめ", "text": "ＷＡＶＥに何度も\nメッセージ送っては\nいるんだけど…。"},
        { "location": "39/TALK"   , "narrator": "つばめ", "text": "既読が付くだけで、\n返事がなくて…。"},
        { "location": "41/TALK"   , "narrator": "ヒカル", "text": "…やっぱり、\nこの前のフェノメノンの\nせいじゃないかな。"},
        { "location": "42/TALK"   , "narrator": "ヒカル", "text": "家が巻き込まれるって\n相当ショックだった\nだろうし…。"},
        { "location": "44/TALK"   , "narrator": "つばめ", "text": "う、うん…。"},
        { "location": "45/TALK"   , "narrator": "つばめ", "text": "…神楽ちゃん、自分が\nメノウちゃんだって\nずっと隠してた。"},
        { "location": "47/TALK"   , "narrator": "つばめ", "text": "ばれちゃったから\n連絡してきて\nくれないのかも…。"},
        { "location": "48/TALK"   , "narrator": "つばめ", "text": "でも、みんなには\n言えないし…。"},
        { "location": "49/TALK"   , "narrator": "キリト", "text": "いや、でも家族は\n無事だったんだろ？"},
        { "location": "51/TALK"   , "narrator": "キリト", "text": "なら、何日も学校\n休むほどじゃねぇと\n思うんだけどな…。"},
        { "location": "53/TALK"   , "narrator": "雛", "text": "…そういうことじゃ\nないんだよ。"},
        { "location": "55/TALK"   , "narrator": "雛", "text": "無事だったとしても、\n巻き込まれた時の\n怖さは残るよ。"},
        { "location": "56/TALK"   , "narrator": "雛", "text": "落ち着くまでは\n家から離れられないん\nじゃないかな？"},
        { "location": "58/TALK"   , "narrator": "つばめ", "text": "…………。"},
        { "location": "59/SEL"    , "narrator": "", "text": "つばめ、静かだね？"},
        { "location": "60/ACT"    , "narrator": "", "text": "つばめ、静かだね？"},
        { "location": "78/TALK"   , "narrator": "つばめ", "text": "ごめんね(´・ω・｀)"},
        { "location": "79/TALK"   , "narrator": "つばめ", "text": "卯月さんのこと"},
        { "location": "80/TALK"   , "narrator": "つばめ", "text": "色々考ぇてて(o´Д`)=з"},
        { "location": "82/SEL"    , "narrator": "", "text": "つばめもそっとしておきたい？"},
        { "location": "83/ACT"    , "narrator": "", "text": "つばめもそっとしておきたい？"},
        { "location": "85/TALK"   , "narrator": "つばめ", "text": "わからなぃ"},
        { "location": "86/TALK"   , "narrator": "つばめ", "text": "このままはダメだけど"},
        { "location": "87/TALK"   , "narrator": "つばめ", "text": "でも"},
        { "location": "88/TALK"   , "narrator": "つばめ", "text": "無理に会ぃに行っても"},
        { "location": "90/TALK"   , "narrator": "つばめ", "text": "困らせちゃぅし"},
        { "location": "91/TALK"   , "narrator": "つばめ", "text": "それに"},
        { "location": "94/TALK"   , "narrator": "つばめ", "text": "会ってくれなぃかも(´つω・｀)ｼｭﾝ"},
        { "location": "95/TALK"   , "narrator": "つばめ", "text": "ＷＡＶＥにも"},
        { "location": "96/TALK"   , "narrator": "つばめ", "text": "返事くれなぃし(´･ω･｀) "},
        { "location": "97/TALK"   , "narrator": "つばめ", "text": "だから"},
        { "location": "100/TALK"  , "narrator": "つばめ", "text": "どうしたらぃぃんだろ？(o´Д`)=з"},
        { "location": "112/TALK"  , "narrator": "つばめ", "text": "はぁ…。"},
        { "location": "114/TALK"  , "narrator": "雛", "text": "…心配だよね？\n神楽ちゃんのこと。"},
        { "location": "116/TALK"  , "narrator": "つばめ", "text": "うん…せめて、\n返信くらいして\nほしいんだけど…。"},
        { "location": "117/TALK"  , "narrator": "雛", "text": "つばめちゃんの\n連絡にも\n返さないんだよね。"},
        { "location": "118/TALK"  , "narrator": "雛", "text": "でも\nまだ方法が\nないわけじゃない。"},
        { "location": "120/TALK"  , "narrator": "ヒカル", "text": "というと？"},
        { "location": "121/TALK"  , "narrator": "雛", "text": "お見舞いだよ、\nお見舞い。"},
        { "location": "122/TALK"  , "narrator": "雛", "text": "連絡ないなら、\nこっちから会いに\n行けばいいんだよ。"},
        { "location": "124/TALK"  , "narrator": "つばめ", "text": "えっ…。"},
        { "location": "125/TALK"  , "narrator": "キリト", "text": "なるほど。\n家の場所も\nわかるんだしね。"},
        { "location": "126/TALK"  , "narrator": "キリト", "text": "こっちから行けば\nいいのか。"},
        { "location": "127/TALK"  , "narrator": "雛", "text": "そういうことー。"},
        { "location": "128/TALK"  , "narrator": "ヒカル", "text": "でも、いきなり\n大勢で押しかけて\n平気かな？"},
        { "location": "129/TALK"  , "narrator": "ヒカル", "text": "ショックを受けてる\n可能性があるん\nでしょう。"},
        { "location": "130/TALK"  , "narrator": "ヒカル", "text": "あまり大勢で行くのは\n避けるべきでは？"},
        { "location": "131/TALK"  , "narrator": "キリト", "text": "…それもそうか。\n逆効果になっちゃ\n意味ねぇしな。"},
        { "location": "133/TALK"  , "narrator": "雛", "text": "…じゃあ、ここは\nつばめちゃんだけに\n行ってもらおうよ。"},
        { "location": "136/TALK"  , "narrator": "つばめ", "text": "え、えぇっ！\nわたし！？"},
        { "location": "137/TALK"  , "narrator": "雛", "text": "あたしたちの中で\n一番神楽ちゃんのこと\nわかってるのはさ。"},
        { "location": "138/TALK"  , "narrator": "雛", "text": "多分つばめちゃんだと\n思うし。"},
        { "location": "140/TALK"  , "narrator": "つばめ", "text": "そ、それは、まあ…。"},
        { "location": "141/TALK"  , "narrator": "雛", "text": "それに。"},
        { "location": "142/TALK"  , "narrator": "雛", "text": "神楽ちゃんと、\n何か話したいこと\nあるんじゃないのー？"},
        { "location": "144/TALK"  , "narrator": "つばめ", "text": "…うん………。"},
        { "location": "145/TALK"  , "narrator": "つばめ", "text": "話したいことも、\n言いたいことも\nあるけど…………。"},
        { "location": "146/TALK"  , "narrator": "つばめ", "text": "でも…。"},
        { "location": "210/TALK"  , "narrator": "つばめ", "text": "　"},
        { "location": "218/TALK"  , "narrator": "つばめ", "text": "こんにちは、\n$handle$さん。"},
        { "location": "219/SEL"   , "narrator": "", "text": "いつも思ってるんだけど――"},
        { "location": "220/SEL"   , "narrator": "", "text": "さあ、仕事をしましょう"},
        { "location": "221/ACT"   , "narrator": "", "text": "いつも思ってるんだけど"},
        { "location": "222/TALK"  , "narrator": "つばめ", "text": "…はい？\nなんでしょうか。"},
        { "location": "223/SEL"   , "narrator": "", "text": "ホントにつばめの人格？"},
        { "location": "224/SEL"   , "narrator": "", "text": "もしかして無理してキャラ作ってない？"},
        { "location": "225/SEL"   , "narrator": "", "text": "ホントは根はいい子だよね"},
        { "location": "226/ACT"   , "narrator": "", "text": "ホントにつばめの人格？"},
        { "location": "227/TALK"  , "narrator": "つばめ", "text": "疑り深い人ですね。"},
        { "location": "228/TALK"  , "narrator": "つばめ", "text": "わたしは正真正銘、逢瀬\nつばめの人格でし…す。"},
        { "location": "229/ACT"   , "narrator": "", "text": "もしかして無理してキャラ作ってない？"},
        { "location": "230/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "231/TALK"  , "narrator": "つばめ", "text": "どうしてそんなこと\n聞くんですか？"},
        { "location": "232/TALK"  , "narrator": "つばめ", "text": "そんなにわたしのことが\n嫌いなんですか？"},
        { "location": "233/TALK"  , "narrator": "つばめ", "text": "同じつばめでも、わたしは\n愛せないんですか？"},
        { "location": "234/SEL"   , "narrator": "", "text": "そんなことないよ！"},
        { "location": "235/SEL"   , "narrator": "", "text": "正直ちょっと無理"},
        { "location": "236/SEL"   , "narrator": "", "text": "そもそもつばめを愛することが無理"},
        { "location": "237/ACT"   , "narrator": "", "text": "そんなことないよ！"},
        { "location": "238/TALK"  , "narrator": "つばめ", "text": "…よかっ――"},
        { "location": "240/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "242/TALK"  , "narrator": "つばめ", "text": "仕事をしましょう。"},
        { "location": "243/ACT"   , "narrator": "", "text": "正直ちょっと無理"},
        { "location": "244/TALK"  , "narrator": "つばめ", "text": "…そうですか。"},
        { "location": "245/TALK"  , "narrator": "つばめ", "text": "まあいいです。\n私は事務的な女ですから。"},
        { "location": "246/TALK"  , "narrator": "つばめ", "text": "$handle$さんが\nわたしを好きでも\n嫌いでも関係ないです。"},
        { "location": "247/ACT"   , "narrator": "", "text": "そもそもつばめを愛することが無理"},
        { "location": "248/TALK"  , "narrator": "つばめ", "text": "じゃあここに\n入ってくんなよ\n■■野郎が！"},
        { "location": "250/SEL"   , "narrator": "", "text": "冗談ですすみません"},
        { "location": "251/SEL"   , "narrator": "", "text": "嘘はつけない人間なので"},
        { "location": "252/SEL"   , "narrator": "", "text": "そのワイルド怒リングなつばめが見たかった！"},
        { "location": "253/ACT"   , "narrator": "", "text": "冗談ですすみません"},
        { "location": "254/TALK"  , "narrator": "つばめ", "text": "なんだ。\nよかったです。"},
        { "location": "255/ACT"   , "narrator": "", "text": "嘘はつけない人間なので"},
        { "location": "256/TALK"  , "narrator": "つばめ", "text": "偽善者ですか？"},
        { "location": "257/TALK"  , "narrator": "つばめ", "text": "なんて。\nまあ、わかりますけど。"},
        { "location": "258/TALK"  , "narrator": "つばめ", "text": "罪悪感があるんですよね。\n優しい人。"},
        { "location": "259/ACT"   , "narrator": "", "text": "そのワイルド怒リングなつばめが見たかった！"},
        { "location": "261/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "266/ACT"   , "narrator": "", "text": "ホントは根はいい子だよね"},
        { "location": "268/TALK"  , "narrator": "つばめ", "text": "ボロ泣き狙ってますか？"},
        { "location": "269/TALK"  , "narrator": "つばめ", "text": "残念ながら、\nわたしは心の底から\nこういう子です。"},
        { "location": "270/TALK"  , "narrator": "つばめ", "text": "……と、ココロの中の\n一人格にも、心の底が\nあるのかという疑問が。"},
        { "location": "271/TALK"  , "narrator": "つばめ", "text": "あるならマトリョーシカ\n状態ですね。"},
        { "location": "272/TALK"  , "narrator": "つばめ", "text": "フラクタルとも言える\nかもしれません。"},
        { "location": "274/TALK"  , "narrator": "つばめ", "text": "……って、\nそんなことは\nどうでもいいんです！"},
        { "location": "276/ACT"   , "narrator": "", "text": "さあ、仕事をしましょう"},
        { "location": "277/TALK"  , "narrator": "つばめ", "text": "その通りです。\n最高効率でする仕事こそが\n唯一たる神状態です。"},
        { "location": "279/TALK"  , "narrator": "つばめ", "text": "さあ、それじゃ\n早速仕事をしましょう。"},
        { "location": "287/TALK"  , "narrator": "つばめ", "text": "オープンプロセス、\n0x8E4番地から\n0x22F番地へ。"},
        { "location": "302/TALK"  , "narrator": "つばめ", "text": "シーク完了しました。"},
        { "location": "305/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "307/TALK"  , "narrator": "つばめ", "text": "……なるほど。"},
        { "location": "308/TALK"  , "narrator": "つばめ", "text": "まあ。"},
        { "location": "309/TALK"  , "narrator": "つばめ", "text": "話したいことがあるなら、\n絶対言った方がいいよね。"},
        { "location": "310/TALK"  , "narrator": "つばめ", "text": "と、わたしは思いますが、\n$handle$さんは？"},
        { "location": "311/SEL"   , "narrator": "", "text": "ほんとそれ"},
        { "location": "312/SEL"   , "narrator": "", "text": "あまり賛同できない"},
        { "location": "313/ACT"   , "narrator": "", "text": "ほんとそれ"},
        { "location": "314/TALK"  , "narrator": "つばめ", "text": "意見が合いましたね。"},
        { "location": "315/TALK"  , "narrator": "つばめ", "text": "正直な気持ちを\n相手に伝えるのは\n大事な事です！"},
        { "location": "316/ACT"   , "narrator": "", "text": "あまり賛同できない"},
        { "location": "317/TALK"  , "narrator": "つばめ", "text": "そうですか。"},
        { "location": "318/TALK"  , "narrator": "つばめ", "text": "でも今回は、\n$handle$さんの\n好みにかかわらず。"},
        { "location": "319/TALK"  , "narrator": "つばめ", "text": "キチキチと\n働いていただきます。"},
        { "location": "321/TALK"  , "narrator": "つばめ", "text": "それでは、\n準備はいいですか？"},
        { "location": "322/SEL"   , "narrator": "", "text": "オーケー"},
        { "location": "323/SEL"   , "narrator": "", "text": "いやです"},
        { "location": "324/ACT"   , "narrator": "", "text": "オーケー"},
        { "location": "325/TALK"  , "narrator": "つばめ", "text": "$handle$さんと\nわたしに、\n素敵なココロの旅を！"},
        { "location": "326/ACT"   , "narrator": "", "text": "いやです"},
        { "location": "327/TALK"  , "narrator": "つばめ", "text": "はぁ…相変わらず\nあまのじゃくさんですね。"},
        { "location": "328/TALK"  , "narrator": "つばめ", "text": "$handle$さんが\nクラン撃退を拒否すると\n世界は進歩できません。"},
        { "location": "329/TALK"  , "narrator": "つばめ", "text": "停滞こそが\n世界の敵だからです。"},
        { "location": "330/TALK"  , "narrator": "つばめ", "text": "そしてもはや、\n十分な時間は\n残されてはいません。"},
        { "location": "331/SEL"   , "narrator": "", "text": "十分な時間って！？"},
        { "location": "332/ACT"   , "narrator": "", "text": "十分な時間って！？"},
        { "location": "334/TALK"  , "narrator": "つばめ", "text": "というわけで、\n必殺――"},
        { "location": "335/TALK"  , "narrator": "つばめ", "text": "無理矢理\n素敵なココロの旅へゴー。"},
        { "location": "348/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "349/TALK"  , "narrator": "つばめ", "text": "それにしても……\n事前に聞いては\nいましたけど――"},
        { "location": "350/TALK"  , "narrator": "つばめ", "text": "“0x”は\nヌルすぎですね…。"},
        { "location": "18/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>7月28日　11:03 AM</color>\nとある夏休み直前の平日、つばめの教室にて。"},
        { "location": "175/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "177/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "179/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "181/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "183/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"}
    ]
}
