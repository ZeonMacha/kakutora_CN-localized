        "title": "005 メインストーリー",
        "sub_title": "二人の秘密基地＜後編＞"
    },
    "entry":
    [
        { "location": "373/SCENARIO", "narrator": "", "text": "二人の秘密基地"},
        { "location": "397/TALK"    , "narrator": "アーヤ", "text": "そうね。\nギャヴィの言うとおり。"},
        { "location": "398/TALK"    , "narrator": "アーヤ", "text": "わたしずっと姉を\n守ってるつもり\nだったけど。"},
        { "location": "399/TALK"    , "narrator": "アーヤ", "text": "本当は認められたかった\nだけなのかもしれないわ。"},
        { "location": "400/TALK"    , "narrator": "アーヤ", "text": "お姉ちゃんは\nダメなんだからその分\n私がしっかりしないと。"},
        { "location": "401/TALK"    , "narrator": "アーヤ", "text": "そう思ってたのにね。"},
        { "location": "402/SEL"     , "narrator": "", "text": "そんなエリカの業績を聞きたい"},
        { "location": "403/SEL"     , "narrator": "", "text": "エリカ何作ってたの？"},
        { "location": "404/SEL"     , "narrator": "", "text": "姉妹百合萌える"},
        { "location": "405/ACT"     , "narrator": "", "text": "姉妹百合萌える"},
        { "location": "406/ACT"     , "narrator": "", "text": "姉妹百合萌える"},
        { "location": "407/ACT"     , "narrator": "", "text": "姉妹百合萌える"},
        { "location": "422/TALK"    , "narrator": "プレイヤー", "text": "姉妹百合萌える"},
        { "location": "424/TALK"    , "narrator": "アーヤ", "text": "え？"},
        { "location": "425/TALK"    , "narrator": "アーヤ", "text": "は？"},
        { "location": "426/SEL"     , "narrator": "", "text": "いや、誤解だ"},
        { "location": "427/SEL"     , "narrator": "", "text": "そんなこと言ってないし！"},
        { "location": "428/SEL"     , "narrator": "", "text": "いい話ぶちこわし！"},
        { "location": "429/SEL"     , "narrator": "", "text": "百合は尊い…"},
        { "location": "430/ACT"     , "narrator": "", "text": "百合は尊い…"},
        { "location": "431/ACT"     , "narrator": "", "text": "百合は尊い…"},
        { "location": "432/ACT"     , "narrator": "", "text": "百合は尊い…"},
        { "location": "433/ACT"     , "narrator": "", "text": "百合は尊い…"},
        { "location": "435/TALK"    , "narrator": "アーヤ", "text": "もういいわ"},
        { "location": "437/TALK"    , "narrator": "アーヤ", "text": "切るから！"},
        { "location": "448/TALK"    , "narrator": "ガブリエラ", "text": "…きっかけが\n何だったとしても。"},
        { "location": "449/TALK"    , "narrator": "ガブリエラ", "text": "アーヤが世界で一番\nなのは本当だし。"},
        { "location": "450/TALK"    , "narrator": "ガブリエラ", "text": "それに実際に\nお姉さんを\n守っていたんでしょ。"},
        { "location": "451/TALK"    , "narrator": "ガブリエラ", "text": "アーヤは別に\n間違ってないわ。"},
        { "location": "454/TALK"    , "narrator": "アーヤ", "text": "そうね。\nありがとう。"},
        { "location": "457/TALK"    , "narrator": "アーヤ", "text": "だからなのかしら。"},
        { "location": "458/TALK"    , "narrator": "ガブリエラ", "text": "何が？"},
        { "location": "459/TALK"    , "narrator": "アーヤ", "text": "姉がここに\n戻ってないって\n聞いた時。"},
        { "location": "460/TALK"    , "narrator": "アーヤ", "text": "もう本当に悔しくて！\n戻ってくるんじゃ\nなかったって思ったの。"},
        { "location": "461/TALK"    , "narrator": "アーヤ", "text": "本当に勝手なんだからって\n怒ってたけど。"},
        { "location": "463/TALK"    , "narrator": "アーヤ", "text": "本当は会いたかった\nだけなのかも。"},
        { "location": "464/TALK"    , "narrator": "ガブリエラ", "text": "ぷっ。"},
        { "location": "466/TALK"    , "narrator": "ガブリエラ", "text": "アーヤったら。\nただ拗ねてる\nだけじゃない。"},
        { "location": "467/TALK"    , "narrator": "アーヤ", "text": "そんな言い方\nしないでよ…！"},
        { "location": "468/TALK"    , "narrator": "ガブリエラ", "text": "だって。\n他に言い方\nないじゃない。"},
        { "location": "469/TALK"    , "narrator": "アーヤ", "text": "もー！"},
        { "location": "471/TALK"    , "narrator": "ガブリエラ", "text": "…でも。\nアーヤの気持ち、\n少しわかるわ。"},
        { "location": "472/TALK"    , "narrator": "ガブリエラ", "text": "あたしもお父様には\n素直になれない。"},
        { "location": "473/TALK"    , "narrator": "ガブリエラ", "text": "……少なくとも今は。"},
        { "location": "474/TALK"    , "narrator": "アーヤ", "text": "……。"},
        { "location": "476/TALK"    , "narrator": "ガブリエラ", "text": "ねえアーヤ。\n小さい頃の\n写真ってないの？"},
        { "location": "477/TALK"    , "narrator": "ガブリエラ", "text": "お姉さんとアーヤ\n見てみたいわ。"},
        { "location": "478/TALK"    , "narrator": "アーヤ", "text": "えっ…。"},
        { "location": "479/TALK"    , "narrator": "ガブリエラ", "text": "アーヤは意外と\nおてんばだった\nみたいだし。"},
        { "location": "480/TALK"    , "narrator": "ガブリエラ", "text": "なんだがすごく\n興味が出てきたの。"},
        { "location": "481/TALK"    , "narrator": "ガブリエラ", "text": "実家だもの\nあるわよね？"},
        { "location": "482/TALK"    , "narrator": "アーヤ", "text": "あ、あるけど……。"},
        { "location": "483/TALK"    , "narrator": "ガブリエラ", "text": "みやびと三人で\n鑑賞会よ！"},
        { "location": "485/TALK"    , "narrator": "アーヤ", "text": "ちょっと！　勝手に\n決めないでよ！"},
        { "location": "487/TALK"    , "narrator": "アーヤ", "text": "もー……！"},
        { "location": "499/DIALOG"  , "narrator": "Dialog_chapter_ch02", "text": "【22 トークン・リング】"}
    ]
}
