        "title": "スペシャルエピソード",
        "sub_title": "太陽とPCと"
    },
    "entry":
    [
        { "location": "29/TALK" , "narrator": "透明みやび", "text": "ふぅ…。"},
        { "location": "30/TALK" , "narrator": "透明みやび", "text": "砂浜でＰＣ弄くる\nっちゅうのも、\n悪くないもんやね。"},
        { "location": "32/TALK" , "narrator": "透明みやび", "text": "相棒もそう思わんか？"},
        { "location": "33/SEL"  , "narrator": "（選択肢）", "text": "潮風でＰＣ壊れるよ？"},
        { "location": "34/SEL"  , "narrator": "（選択肢）", "text": "海に来てまでなぜＰＣ？"},
        { "location": "35/ACT"  , "narrator": "", "text": "潮風でＰＣ壊れるよ？"},
        { "location": "37/TALK" , "narrator": "透明みやび", "text": "安心安全の精神世界やき、\n心配無用や。"},
        { "location": "39/TALK" , "narrator": "透明みやび", "text": "っちゅうか、うちだって\n海に来たかったわけや\nないぞね。"},
        { "location": "40/ACT"  , "narrator": "", "text": "海に来てまでなぜＰＣ？"},
        { "location": "42/TALK" , "narrator": "透明みやび", "text": "別にうちが来たくて\n来たわけやないちや。"},
        { "location": "44/TALK" , "narrator": "透明みやび", "text": "みんなが海行く言うて、\n無理矢理付き合わされて\n来ただけや。"},
        { "location": "45/TALK" , "narrator": "透明みやび", "text": "まったく…海なんぞ、\n塩辛いだけの超巨大な\n水溜まりやっちゅうに。"},
        { "location": "47/TALK" , "narrator": "透明みやび", "text": "なにが楽しくて\n夢中になれるんか、\n理解に苦しむちや。"},
        { "location": "48/SEL"  , "narrator": "（選択肢）", "text": "みやびも少しは海を楽しもう"},
        { "location": "49/SEL"  , "narrator": "（選択肢）", "text": "じゃあ、$me$と楽しもう"},
        { "location": "50/ACT"  , "narrator": "", "text": "みやびも少しは海を楽しもう"},
        { "location": "53/TALK" , "narrator": "透明みやび", "text": "海に来ている。"},
        { "location": "54/TALK" , "narrator": "透明みやび", "text": "そして水着を着ている。"},
        { "location": "56/TALK" , "narrator": "透明みやび", "text": "これで十分やろ？"},
        { "location": "57/TALK" , "narrator": "透明みやび", "text": "まあ、水着はピッチリして\n息苦しいのが欠点なんや\nけんど…。"},
        { "location": "58/TALK" , "narrator": "透明みやび", "text": "なのでうちは水着の上を\n外して自由になるという\n結論に辿り着いたわけや。"},
        { "location": "59/ACT"  , "narrator": "", "text": "じゃあ、$me$と楽しもう"},
        { "location": "61/TALK" , "narrator": "透明みやび", "text": "そう言うてくれるのを\n待っちょったがよ。"},
        { "location": "62/TALK" , "narrator": "透明みやび", "text": "さすがにうちもな、\n海に来てまでＰＣは\nどうかと思うてたき。"},
        { "location": "63/TALK" , "narrator": "透明みやび", "text": "…で、なにをして楽しむ？"},
        { "location": "64/SEL"  , "narrator": "（選択肢）", "text": "海らしいことをして、かな？"},
        { "location": "65/ACT"  , "narrator": "", "text": "海らしいことをして、かな？"},
        { "location": "69/TALK" , "narrator": "透明みやび", "text": "今のうち、ぶっちゃけ\n半裸状態や。"},
        { "location": "71/TALK" , "narrator": "透明みやび", "text": "サービスショットやろ？\nスクショ撮るんは自由や\nけんどな…。"},
        { "location": "72/TALK" , "narrator": "透明みやび", "text": "お題は高いホテルの\nデザートブッフェくらいは\nいただくぞね？"},
        { "location": "73/SEL"  , "narrator": "（選択肢）", "text": "なかなか高いよね"},
        { "location": "74/SEL"  , "narrator": "（選択肢）", "text": "一緒に行く？"},
        { "location": "75/ACT"  , "narrator": "", "text": "なかなか高いよね"},
        { "location": "78/TALK" , "narrator": "透明みやび", "text": "とほほ、うちの半裸は\nデザートブッフェ以下か。"},
        { "location": "79/TALK" , "narrator": "透明みやび", "text": "けんど、高いと言われては\n諦めるしかないなぁ…。"},
        { "location": "80/ACT"  , "narrator": "", "text": "一緒に行く？"},
        { "location": "82/TALK" , "narrator": "透明みやび", "text": "まあ、一人で行っても\n楽しくはないやろうし。"},
        { "location": "83/TALK" , "narrator": "透明みやび", "text": "とはいえ、デザート\nブッフェとはいえ\n言い換えれば食い放題。"},
        { "location": "84/TALK" , "narrator": "透明みやび", "text": "そんなところへデートで\n行くっちゅうのは、\nどうなんや？"},
        { "location": "86/TALK" , "narrator": "透明みやび", "text": "…うむ、よろしくない\nような気がしてきた。"},
        { "location": "87/TALK" , "narrator": "透明みやび", "text": "今の話は無しや。\nブッフェ無し。\n半裸撮影もなし。"},
        { "location": "89/TALK" , "narrator": "透明みやび", "text": "…ちゅうか、海に来て\nデザートブッフェの話とか\nどうなんや？"},
        { "location": "90/TALK" , "narrator": "透明みやび", "text": "これこそ海を楽しんでる\nとは言えん行為やな…。"},
        { "location": "91/TALK" , "narrator": "透明みやび", "text": "…仕方ない、奥の手や。"},
        { "location": "92/TALK" , "narrator": "透明みやび", "text": "相棒、実はすぐそこに\nサンオイルなんぞも\n用意してあるのだが…。"},
        { "location": "94/TALK" , "narrator": "透明みやび", "text": "どうする？\nうちにヌリヌリして\nみたい思うちょる？"},
        { "location": "95/SEL"  , "narrator": "（選択肢）", "text": "もちろん！"},
        { "location": "96/SEL"  , "narrator": "（選択肢）", "text": "したいが、できない！"},
        { "location": "97/ACT"  , "narrator": "", "text": "もちろん！"},
        { "location": "98/TALK" , "narrator": "透明みやび", "text": "まっこと、\n欲望に忠実なヤツやねぇ。"},
        { "location": "100/TALK", "narrator": "透明みやび", "text": "そういう直球なとこ、\n嫌いやないがよ。"},
        { "location": "102/TALK", "narrator": "透明みやび", "text": "…いや、むしろ\n気に入っちょるところ\nかもしれん…。"},
        { "location": "103/TALK", "narrator": "透明みやび", "text": "…とにかく、決まりや。\nこのサンオイルを\nうちに塗りたくり…。"},
        { "location": "104/ACT" , "narrator": "", "text": "したいが、できない！"},
        { "location": "106/TALK", "narrator": "透明みやび", "text": "なんや？　別にそれくらい\nしても…。"},
        { "location": "108/TALK", "narrator": "透明みやび", "text": "…いや、ちくっと\n冷静にならんとな。"},
        { "location": "109/TALK", "narrator": "透明みやび", "text": "さすがに、それは\nサービスし過ぎな気が\nしてきたちや。"},
        { "location": "110/TALK", "narrator": "透明みやび", "text": "うちは相棒からは\nなにも貰っちょらん\nっちゅうのに…。"},
        { "location": "111/TALK", "narrator": "透明みやび", "text": "相棒にばかり美味しい想い\nさせるっちゅうのは、\n不公平や。"},
        { "location": "113/TALK", "narrator": "透明みやび", "text": "なので…おっ、\nえいところに…。"},
        { "location": "115/TALK", "narrator": "透明みやび", "text": "つばめちゃーん。\nちくっとこっち\nおいでやー。"},
        { "location": "119/TALK", "narrator": "透明つばめ", "text": "はい。\nどうしたんですか？"},
        { "location": "120/TALK", "narrator": "透明みやび", "text": "うむ…実はサンオイルを\n塗ろうと思うちょるん\nやけんど…。"},
        { "location": "121/TALK", "narrator": "透明みやび", "text": "相棒に濡らせるんは、\nちくっとサービスの\nし過ぎや思うてな。"},
        { "location": "122/TALK", "narrator": "透明みやび", "text": "代わりに、つばめちゃんに\n塗ってもらおうと\n思うたわけちや。"},
        { "location": "123/TALK", "narrator": "透明つばめ", "text": "えっと…、\nよくはわからないん\nですけど…。"},
        { "location": "124/TALK", "narrator": "透明つばめ", "text": "とにかく、わたしが\nみやびさんにサンオイルを\n塗ればいいんですね？"},
        { "location": "125/TALK", "narrator": "透明みやび", "text": "そういうことや…。\nお願いしてえい？"},
        { "location": "127/TALK", "narrator": "透明つばめ", "text": "はい、それくらいなら\n任せてください！"},
        { "location": "128/TALK", "narrator": "透明つばめ", "text": "みやびさんの背中、\nサンオイルをたっぷり\n塗っちゃいますね！"},
        { "location": "130/TALK", "narrator": "透明みやび", "text": "…ほ、ほどほどにな？\nさすがにびしょ濡れは\n勘弁やき…。"},
        { "location": "131/TALK", "narrator": "透明つばめ", "text": "えーっと、それじゃあ\nどこから始めようかなぁ？"},
        { "location": "132/SEL" , "narrator": "（選択肢）", "text": "お尻の方にたっぷり丁寧に"},
        { "location": "133/SEL" , "narrator": "（選択肢）", "text": "うなじから背筋に沿って"},
        { "location": "134/ACT" , "narrator": "", "text": "お尻の方にたっぷり丁寧に"},
        { "location": "135/TALK", "narrator": "透明つばめ", "text": "お尻を丁寧に…？\nあ、そういうことか！"},
        { "location": "136/TALK", "narrator": "透明つばめ", "text": "それじゃ、みやびさん。\n始めますねー。"},
        { "location": "138/TALK", "narrator": "透明みやび", "text": "うむ、頼むがよ。"},
        { "location": "143/TALK", "narrator": "透明みやび", "text": "…………。"},
        { "location": "144/TALK", "narrator": "透明つばめ", "text": "…………。"},
        { "location": "150/TALK", "narrator": "透明みやび", "text": "え、えっと…、\nつばめちゃん？"},
        { "location": "152/TALK", "narrator": "透明みやび", "text": "なんか、やたらと丁寧に\n尻を揉んどるみたい\nやけんど…。"},
        { "location": "153/TALK", "narrator": "透明つばめ", "text": "はい！\nお尻は普段、陽の光が\n当たらない場所でしょ？"},
        { "location": "154/TALK", "narrator": "透明つばめ", "text": "だから、その分たっぷり、\n丁寧に塗り込めって、\n$handle$さんが。"},
        { "location": "155/TALK", "narrator": "透明みやび", "text": "あ、あいつ…、\nそんなアホなこと\n頼みよって…。"},
        { "location": "159/TALK", "narrator": "透明つばめ", "text": "きゃっ！？"},
        { "location": "162/TALK", "narrator": "透明みやび", "text": "ちょぉぉぉぉ！？\nつばめちゃん、ヤバい！\n水着の中はヤバいぞね！"},
        { "location": "163/TALK", "narrator": "透明つばめ", "text": "ご、ごめんなさい！\nオイルで指が滑って、\n水着の中に…。"},
        { "location": "165/TALK", "narrator": "透明つばめ", "text": "あ、あれ？\n水着に指が\n絡まっちゃってる！？"},
        { "location": "166/TALK", "narrator": "透明みやび", "text": "え、えいから、\n落ち着いてゆっくり\n指外しぃ。"},
        { "location": "167/TALK", "narrator": "透明つばめ", "text": "だ、大丈夫です。\nこうやって、おもいっきり\n引っ張ればー！"},
        { "location": "169/TALK", "narrator": "透明みやび", "text": "ちょちょちょ、いかん、\nマジでそれはいかん！"},
        { "location": "170/TALK", "narrator": "透明みやび", "text": "食い込みまくりやき、\n乱暴はいかんって！"},
        { "location": "171/TALK", "narrator": "透明つばめ", "text": "あわわ、ごめんなさい！"},
        { "location": "174/TALK", "narrator": "透明みやび", "text": "…やはり、海なんぞ\n来るべきやなかった…。"},
        { "location": "175/ACT" , "narrator": "", "text": "うなじから背筋に沿って"},
        { "location": "176/TALK", "narrator": "透明つばめ", "text": "…背筋に沿ってだったら、\n指先じゃないと\nダメだよね。"},
        { "location": "177/TALK", "narrator": "透明つばめ", "text": "よーし、それじゃあ、\n失礼します。"},
        { "location": "179/TALK", "narrator": "透明みやび", "text": "よろしく頼むぞね。"},
        { "location": "188/TALK", "narrator": "透明みやび", "text": "んぃっ！？"},
        { "location": "189/TALK", "narrator": "透明つばめ", "text": "うなじから、腰に向かって\nゆっくりと…。"},
        { "location": "190/TALK", "narrator": "透明みやび", "text": "ちょっ、つ、つば、\nつばめちゃん、\nストップ、ストップや！"},
        { "location": "191/TALK", "narrator": "透明つばめ", "text": "あ、はい…。\nどうしたんですか？"},
        { "location": "192/TALK", "narrator": "透明みやび", "text": "いや…なんちゅうかな、\n背筋なぞられると\nゾゾッとくるんやけんど？"},
        { "location": "193/TALK", "narrator": "透明つばめ", "text": "でも、\n$handle$さんが\nそうしろって…。"},
        { "location": "194/TALK", "narrator": "透明みやび", "text": "なっ！？\n$handle$のヤツ、\nなんちゅうことを…！"},
        { "location": "195/TALK", "narrator": "透明つばめ", "text": "えっと、たっぷりと\n塗るんでしたよね？"},
        { "location": "196/TALK", "narrator": "透明つばめ", "text": "それじゃ、あと五回は\n往復させますよー。"},
        { "location": "198/TALK", "narrator": "透明みやび", "text": "五回！？　ちょっと、\nつば、め、ひぁっ！？"},
        { "location": "200/TALK", "narrator": "透明みやび", "text": "んっ、あっ、うぅっ…。"},
        { "location": "201/TALK", "narrator": "透明つばめ", "text": "あと３往復ですよー。"},
        { "location": "204/TALK", "narrator": "透明みやび", "text": "…サンオイルなんぞ、\n用意するんやなかった…。"}
    ]
}
