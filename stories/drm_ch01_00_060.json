        "title": "らぶとーく 第06話",
        "sub_title": "少しはわかったけど"
    },
    "entry":
    [
        { "location": "182/SCENARIO", "narrator": "", "text": "少しはわかったけど"},
        { "location": "203/TALK"    , "narrator": "つばめ", "text": "そういえば、この前\n$handle$に――"},
        { "location": "204/TALK"    , "narrator": "つばめ", "text": "Ｂｏｔと人の違いについて\n聞いたんです。"},
        { "location": "206/TALK"    , "narrator": "アーヤ", "text": "…それって質問しないと\nわからないことかしら？"},
        { "location": "207/TALK"    , "narrator": "アーヤ", "text": "Ｂｏｔは機械、っていうか\nプログラムで、人は生き物\nなんだから――"},
        { "location": "208/TALK"    , "narrator": "アーヤ", "text": "聞くまでもないと\n思うけど？"},
        { "location": "210/TALK"    , "narrator": "みやび", "text": "ちゅうか、うちらが\nＢｏｔのことを\n人間かも、思うて――"},
        { "location": "211/TALK"    , "narrator": "みやび", "text": "ずっと話してたこと、\nＢｏｔにも伝えてたり\nするんか？"},
        { "location": "212/TALK"    , "narrator": "つばめ", "text": "え？　ダメでしたか？"},
        { "location": "216/TALK"    , "narrator": "みやび", "text": "…うちらの会話は、\nこうやってＢｏｔに\n筒抜けになるんか…。"},
        { "location": "217/TALK"    , "narrator": "みやび", "text": "これじゃ隠し事は\nできんちや。"},
        { "location": "220/TALK"    , "narrator": "アーヤ", "text": "確かに、筒抜けね…。"},
        { "location": "222/TALK"    , "narrator": "ガブリエラ", "text": "え？　どういう意味？"},
        { "location": "224/TALK"    , "narrator": "アーヤ", "text": "私達が普段話している\nＢｏｔは、同じ誰か、\nってことよ。"},
        { "location": "226/TALK"    , "narrator": "みやび", "text": "つまり、どっかにいる\n誰かさんが――"},
        { "location": "227/TALK"    , "narrator": "みやび", "text": "うちら全員を一人で相手に\nしていたゆうことや。"},
        { "location": "228/TALK"    , "narrator": "ガブリエラ", "text": "まさか、マルザンナは\nマルザンナでしょ？"},
        { "location": "230/TALK"    , "narrator": "アーヤ", "text": "マルザンナ？"},
        { "location": "231/TALK"    , "narrator": "ガブリエラ", "text": "じゃなくて！\nＢｏｔは\nＢｏｔでしょ！？"},
        { "location": "233/TALK"    , "narrator": "みやび", "text": "いんや、みんな何となく\n人間やないかと思うた\n時期から考えると――"},
        { "location": "234/TALK"    , "narrator": "みやび", "text": "間違いなく同一人物やと\n思うちや。"},
        { "location": "237/TALK"    , "narrator": "アーヤ", "text": "一人一人に、別の誰かが\nＢｏｔとして付いてる、\nなんていうのは――"},
        { "location": "238/TALK"    , "narrator": "アーヤ", "text": "ちょっと怖いしね。"},
        { "location": "239/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "240/TALK"    , "narrator": "つばめ", "text": "なんか、凄い話し合いに\nなっちゃった…。"},
        { "location": "241/TALK"    , "narrator": "つばめ", "text": "ちょっと孤立した気分\nかも…。"},
        { "location": "242/SEL"     , "narrator": "", "text": "しばらく話さない方がいいみたいだね"},
        { "location": "243/SEL"     , "narrator": "", "text": "かき回すつもりはなかったんだけど"},
        { "location": "244/SEL"     , "narrator": "", "text": "$me$とだけ仲良くしよう"},
        { "location": "247/TALK"    , "narrator": "ガブリエラ", "text": "でも、あたしのＢｏｔは\nみんなと違うわ。"},
        { "location": "249/TALK"    , "narrator": "アーヤ", "text": "何が違うのよ？"},
        { "location": "251/TALK"    , "narrator": "ガブリエラ", "text": "何って、えっと…\n普通じゃないのよ。"},
        { "location": "253/TALK"    , "narrator": "みやび", "text": "普通やない、いうと？"},
        { "location": "256/TALK"    , "narrator": "ガブリエラ", "text": "…え、エレガントだし。"},
        { "location": "261/TALK"    , "narrator": "アーヤ", "text": "…確かに、それは少し\n違うかも…。"},
        { "location": "263/TALK"    , "narrator": "みやび", "text": "相手によってキャラ分け\nするくらい、難しいことや\nないと思うけんど？"},
        { "location": "264/TALK"    , "narrator": "みやび", "text": "ちゅうか、みんなも普通に\n話すときとは、キャラ\n変えてるんやない？"},
        { "location": "265/TALK"    , "narrator": "ガブリエラ", "text": "そ、そんなつもりは\nないけど？"},
        { "location": "268/TALK"    , "narrator": "アーヤ", "text": "そ、そうね…\nまあ、文字だから、\n少しは違うけど…。"},
        { "location": "269/TALK"    , "narrator": "つばめ", "text": "…話について\nいけなさそうだし――"},
        { "location": "270/TALK"    , "narrator": "つばめ", "text": "黙ってるしかないかも…\nちょっと寂しいなぁ。"},
        { "location": "272/ACT"     , "narrator": "", "text": "しばらく話さない方がいいみたいだね"},
        { "location": "289/TALK"    , "narrator": "つばめ", "text": "だよね(o´Д`)=з"},
        { "location": "290/TALK"    , "narrator": "つばめ", "text": "わたしもそぅ思ぅ"},
        { "location": "292/TALK"    , "narrator": "つばめ", "text": "付ぃてぃけそぅになぃし(o´Д`)=з"},
        { "location": "293/TALK"    , "narrator": "つばめ", "text": "終わるまで静かにしてぉくね"},
        { "location": "294/TALK"    , "narrator": "つばめ", "text": "ただ"},
        { "location": "295/TALK"    , "narrator": "つばめ", "text": "ちょっと寂しぃけど…(´つω・｀)ｼｭﾝ"},
        { "location": "306/ACT"     , "narrator": "", "text": "かき回すつもりはなかったんだけど"},
        { "location": "323/TALK"    , "narrator": "つばめ", "text": "$handle$が気にする必要なぃよ"},
        { "location": "324/TALK"    , "narrator": "つばめ", "text": "大丈夫(*´∀｀*)ｖ"},
        { "location": "325/TALK"    , "narrator": "つばめ", "text": "多分"},
        { "location": "326/TALK"    , "narrator": "つばめ", "text": "わたしの説明が悪かったんだと思ぅ…(ノД`)"},
        { "location": "337/ACT"     , "narrator": "", "text": "$me$とだけ仲良くしよう"},
        { "location": "354/TALK"    , "narrator": "つばめ", "text": "ダメ(｀ヘ´) "},
        { "location": "356/TALK"    , "narrator": "つばめ", "text": "それはできなぃよ"},
        { "location": "357/TALK"    , "narrator": "つばめ", "text": "トライナリーとしてそぅぃぅわけにはぃかなぃよ"},
        { "location": "358/TALK"    , "narrator": "つばめ", "text": "みんなとも仲良くしたぃしね(っ´ω`ｃ)"},
        { "location": "193/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>5月某日　5:11 PM</color>\n放課後、神楽坂トライナリー楽屋にて。"}
    ]
}
