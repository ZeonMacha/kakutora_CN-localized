        { "location": "7/SCENARIO", "narrator": "", "text": "440_児童心理学は催眠術である"},
        { "location": "32/TALK"   , "narrator": "アーヤ", "text": "専門用語って"},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "眠くなるわ(￣Д￣ )"},
        { "location": "34/TALK"   , "narrator": "アーヤ", "text": "あれ"},
        { "location": "35/TALK"   , "narrator": "アーヤ", "text": "なんなのかしら（￣ー￣？）"},
        { "location": "37/SEL"    , "narrator": "", "text": "知らない言葉だから"},
        { "location": "38/SEL"    , "narrator": "", "text": "めんどくさいから"},
        { "location": "39/SEL"    , "narrator": "", "text": "専門用語ってカッコいいよね？"},
        { "location": "40/ACT"    , "narrator": "", "text": "知らない言葉だから"},
        { "location": "41/TALK"   , "narrator": "アーヤ", "text": "確かに"},
        { "location": "43/TALK"   , "narrator": "アーヤ", "text": "そうよね！！"},
        { "location": "44/ACT"    , "narrator": "", "text": "めんどくさいから"},
        { "location": "45/TALK"   , "narrator": "アーヤ", "text": "そうなの(-.-;)"},
        { "location": "46/TALK"   , "narrator": "アーヤ", "text": "めんどくさいのよ"},
        { "location": "47/ACT"    , "narrator": "", "text": "専門用語ってカッコいいよね？"},
        { "location": "48/TALK"   , "narrator": "アーヤ", "text": "それはなかなか"},
        { "location": "49/TALK"   , "narrator": "アーヤ", "text": "男子っぽい発言だわ"},
        { "location": "51/TALK"   , "narrator": "アーヤ", "text": "発達心理学の授業が眠くて仕方ないの"},
        { "location": "52/TALK"   , "narrator": "アーヤ", "text": "子守歌よ"},
        { "location": "53/TALK"   , "narrator": "アーヤ", "text": "講義が"},
        { "location": "55/SEL"    , "narrator": "", "text": "なんかカッコいい"},
        { "location": "56/SEL"    , "narrator": "", "text": "確かに眠くなりそう"},
        { "location": "57/SEL"    , "narrator": "", "text": "どんな内容なの？"},
        { "location": "58/ACT"    , "narrator": "", "text": "なんかカッコいい"},
        { "location": "59/TALK"   , "narrator": "アーヤ", "text": "え＼(◎o◎)／"},
        { "location": "61/TALK"   , "narrator": "アーヤ", "text": "そうかしら"},
        { "location": "62/ACT"    , "narrator": "", "text": "確かに眠くなりそう"},
        { "location": "63/TALK"   , "narrator": "アーヤ", "text": "そうヽ(´o｀；"},
        { "location": "64/TALK"   , "narrator": "アーヤ", "text": "そうなのよ"},
        { "location": "65/ACT"    , "narrator": "", "text": "どんな内容なの？"},
        { "location": "75/TALK"   , "narrator": "アーヤ", "text": "あら"},
        { "location": "76/TALK"   , "narrator": "アーヤ", "text": "聞いてくれるの？"},
        { "location": "78/TALK"   , "narrator": "アーヤ", "text": "$handle$さん"},
        { "location": "79/TALK"   , "narrator": "アーヤ", "text": "やさしい"},
        { "location": "80/TALK"   , "narrator": "アーヤ", "text": "あいしてる(^ε^)-☆!!"},
        { "location": "84/TALK"   , "narrator": "アーヤ", "text": "子供の気持ちとか"},
        { "location": "85/TALK"   , "narrator": "アーヤ", "text": "知りたかったから"},
        { "location": "86/TALK"   , "narrator": "アーヤ", "text": "児童心理学だけ取りたかったんだけど"},
        { "location": "87/TALK"   , "narrator": "アーヤ", "text": "発達心理学の中に含まれてるのよね(-.-;)"},
        { "location": "88/TALK"   , "narrator": "アーヤ", "text": "そこに辿り着くまでが"},
        { "location": "89/TALK"   , "narrator": "アーヤ", "text": "もー！！！！"},
        { "location": "91/SEL"    , "narrator": "", "text": "がんばって"},
        { "location": "92/SEL"    , "narrator": "", "text": "応援してる"},
        { "location": "93/SEL"    , "narrator": "", "text": "アーヤなら大丈夫"},
        { "location": "94/ACT"    , "narrator": "", "text": "がんばって"},
        { "location": "95/TALK"   , "narrator": "アーヤ", "text": "そうね"},
        { "location": "96/TALK"   , "narrator": "アーヤ", "text": "がんばるわ"},
        { "location": "97/TALK"   , "narrator": "アーヤ", "text": "ありがと"},
        { "location": "100/ACT"   , "narrator": "", "text": "応援してる"},
        { "location": "101/TALK"  , "narrator": "アーヤ", "text": "うん"},
        { "location": "102/TALK"  , "narrator": "アーヤ", "text": "ありがとう"},
        { "location": "103/ACT"   , "narrator": "", "text": "アーヤなら大丈夫"},
        { "location": "104/TALK"  , "narrator": "アーヤ", "text": "そう？"},
        { "location": "105/TALK"  , "narrator": "アーヤ", "text": "$handle$さんがそう言ってくれるなら"},
        { "location": "106/TALK"  , "narrator": "アーヤ", "text": "そんな気がする"},
        { "location": "108/TALK"  , "narrator": "アーヤ", "text": "ありがと"},
