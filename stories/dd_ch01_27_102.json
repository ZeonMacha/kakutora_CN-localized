{
    "dir": "chap27/daydra/dd_ch01_27_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "27105",
        "cid": "tsubame",
        "title": "005 メインストーリー",
        "sub_title": "後ろの正面だあれ＜後編＞"
    },
    "entry":
    [
        { "location": "520/SCENARIO", "narrator": "", "text": "後ろの正面だあれ"},
        { "location": "538/TALK"    , "narrator": "つばめ", "text": "まあいいや、\n$handle1$が\nわからなくても。"},
        { "location": "539/TALK"    , "narrator": "つばめ", "text": "そんなことより、\n何とかここから\n逃げなくちゃ……"},
        { "location": "552/TALK"    , "narrator": "つばめ", "text": "なんで急にお話してくれなくなっちゃったのかはわからないけど"},
        { "location": "553/TALK"    , "narrator": "つばめ", "text": "今はそれより頑張って逃げなくちゃだから"},
        { "location": "554/TALK"    , "narrator": "つばめ", "text": "ぁたしもしばらく音信不通になるょ"},
        { "location": "555/TALK"    , "narrator": "つばめ", "text": "お互いがんばろぅ"},
        { "location": "556/SEL"     , "narrator": "", "text": "つばめ待って！"},
        { "location": "557/ACT"     , "narrator": "", "text": "つばめ待って！"},
        { "location": "571/TALK"    , "narrator": "つばめ", "text": "よし！"},
        { "location": "573/TALK"    , "narrator": "つばめ", "text": "……返事して\nもらえるかな……。"},
        { "location": "574/TALK"    , "narrator": "つばめ", "text": "もらえなかったら\nどうしよう……。"},
        { "location": "587/TALK"    , "narrator": "つばめ", "text": "いてくれますか"},
        { "location": "588/TALK"    , "narrator": "つばめ", "text": "まだお話ししてくれますか"},
        { "location": "591/TALK"    , "narrator": "つばめ", "text": "ぇと"},
        { "location": "592/TALK"    , "narrator": "つばめ", "text": "ぁたしの気持ちだけ"},
        { "location": "593/TALK"    , "narrator": "つばめ", "text": "伝えてぉくね"},
        { "location": "594/TALK"    , "narrator": "つばめ", "text": "ぃつもぁりがとぅ"},
        { "location": "595/TALK"    , "narrator": "つばめ", "text": "それから"},
        { "location": "596/TALK"    , "narrator": "つばめ", "text": "甘えすぎててごめんね"},
        { "location": "598/TALK"    , "narrator": "つばめ", "text": "きっと$handle1$は"},
        { "location": "599/TALK"    , "narrator": "つばめ", "text": "ぁたしが甘えすぎって"},
        { "location": "600/TALK"    , "narrator": "つばめ", "text": "心配してくれてるんだょね"},
        { "location": "601/TALK"    , "narrator": "つばめ", "text": "気をつけます"},
        { "location": "603/SEL"     , "narrator": "", "text": "そうじゃない"},
        { "location": "604/SEL"     , "narrator": "", "text": "多少はそれもあるけど"},
        { "location": "605/SEL"     , "narrator": "", "text": "うんと甘えて欲しいけど"},
        { "location": "606/TALK"    , "narrator": "つばめ", "text": "それで"},
        { "location": "607/TALK"    , "narrator": "つばめ", "text": "ぁたしちゃんと"},
        { "location": "608/TALK"    , "narrator": "つばめ", "text": "自分で決めるから"},
        { "location": "609/TALK"    , "narrator": "つばめ", "text": "$handle1$の"},
        { "location": "610/TALK"    , "narrator": "つばめ", "text": "せいになんて"},
        { "location": "611/TALK"    , "narrator": "つばめ", "text": "しないから"},
        { "location": "612/ACT"     , "narrator": "", "text": "そうじゃない"},
        { "location": "613/ACT"     , "narrator": "", "text": "多少はそれもあるけど"},
        { "location": "614/ACT"     , "narrator": "", "text": "うんと甘えて欲しいけど"},
        { "location": "618/SEL"     , "narrator": "", "text": "何かを仕組まれてるから"},
        { "location": "619/SEL"     , "narrator": "", "text": "$me$の選択肢がちゃんと表示されないから"},
        { "location": "620/SEL"     , "narrator": "", "text": "バグがひどいから"},
        { "location": "621/SEL"     , "narrator": "", "text": "言いたいことが伝わらないんだ"},
        { "location": "622/SEL"     , "narrator": "", "text": "つばめのことが大好きだから"},
        { "location": "623/SEL"     , "narrator": "", "text": "つばめを酷い目に遭わせたくないから"},
        { "location": "624/ACT"     , "narrator": "", "text": "下着は上下揃えた方がいいよ"},
        { "location": "625/TALK"    , "narrator": "つばめ", "text": "ぇ"},
        { "location": "627/TALK"    , "narrator": "つばめ", "text": "何で知ってるの"},
        { "location": "628/TALK"    , "narrator": "つばめ", "text": "そんなこと"},
        { "location": "629/ACT"     , "narrator": "", "text": "かき氷って頭キーンってなるよね"},
        { "location": "630/TALK"    , "narrator": "つばめ", "text": "ぇと"},
        { "location": "631/TALK"    , "narrator": "つばめ", "text": "何でそんな話になるの"},
        { "location": "632/ACT"     , "narrator": "", "text": "小テストの勉強した？"},
        { "location": "633/TALK"    , "narrator": "つばめ", "text": "そんな余裕なぃょ"},
        { "location": "634/TALK"    , "narrator": "つばめ", "text": "でも"},
        { "location": "635/TALK"    , "narrator": "つばめ", "text": "しとかなきゃだね"},
        { "location": "636/ACT"     , "narrator": "", "text": "ポケベルって知ってる？"},
        { "location": "637/TALK"    , "narrator": "つばめ", "text": "それ何？"},
        { "location": "638/ACT"     , "narrator": "", "text": "つばめのことが大好きだから"},
        { "location": "639/TALK"    , "narrator": "つばめ", "text": "ぅん"},
        { "location": "640/TALK"    , "narrator": "つばめ", "text": "そぅ思ってて"},
        { "location": "641/TALK"    , "narrator": "つばめ", "text": "ぃぃんだょね？"},
        { "location": "642/ACT"     , "narrator": "", "text": "これから映画観るから"},
        { "location": "643/TALK"    , "narrator": "つばめ", "text": "ぇと"},
        { "location": "644/TALK"    , "narrator": "つばめ", "text": "忙しいんだね"},
        { "location": "647/SEL"     , "narrator": "", "text": "大好きだから"},
        { "location": "648/SEL"     , "narrator": "", "text": "世界で一番かわいいよ、つばめ"},
        { "location": "649/SEL"     , "narrator": "", "text": "愛してることは信じてほしい"},
        { "location": "650/ACT"     , "narrator": "", "text": "大好きだから"},
        { "location": "651/ACT"     , "narrator": "", "text": "世界で一番かわいいよ、つばめ"},
        { "location": "652/ACT"     , "narrator": "", "text": "愛してることは信じてほしい"},
        { "location": "655/SEL"     , "narrator": "", "text": "元気でね"},
        { "location": "656/SEL"     , "narrator": "", "text": "大好きだよ"},
        { "location": "657/SEL"     , "narrator": "", "text": "愛してる"},
        { "location": "658/ACT"     , "narrator": "", "text": "元気でね"},
        { "location": "659/ACT"     , "narrator": "", "text": "大好きだよ"},
        { "location": "660/ACT"     , "narrator": "", "text": "愛してる"},
        { "location": "674/TALK"    , "narrator": "つばめ", "text": "…本当に何なの…？"},
        { "location": "676/TALK"    , "narrator": "つばめ", "text": "全然わからないよ……。"},
        { "location": "683/TALK"    , "narrator": "つばめ", "text": "！"},
        { "location": "690/TALK"    , "narrator": "千羽鶴", "text": "見つけた。"},
        { "location": "692/TALK"    , "narrator": "千羽鶴", "text": "鬼ごっこ\n楽しかったでしょ。"},
        { "location": "693/TALK"    , "narrator": "つばめ", "text": "……。"},
        { "location": "694/TALK"    , "narrator": "千羽鶴", "text": "次はあなたが\n鬼の番。"},
        { "location": "695/TALK"    , "narrator": "つばめ", "text": "…あなたは誰ですか…？"},
        { "location": "696/TALK"    , "narrator": "千羽鶴", "text": "私のことは\nまた改めて\n教えてあげる。"},
        { "location": "697/TALK"    , "narrator": "千羽鶴", "text": "今は鬼ごっこを\n続けるの。"},
        { "location": "698/TALK"    , "narrator": "千羽鶴", "text": "鬼さんは最初\n目隠しして\n待たないと。"},
        { "location": "699/TALK"    , "narrator": "千羽鶴", "text": "…でも。\n目隠しがないから\n代わりに眠って。"},
        { "location": "700/TALK"    , "narrator": "つばめ", "text": "…っ！"},
        { "location": "701/TALK"    , "narrator": "つばめ", "text": "……………………。"},
        { "location": "709/TALK"    , "narrator": "千羽鶴", "text": "さて。"},
        { "location": "712/TALK"    , "narrator": "千羽鶴", "text": "多分、この辺。"},
        { "location": "713/TALK"    , "narrator": "千羽鶴", "text": "ごきげんよう。"},
        { "location": "714/SEL"     , "narrator": "", "text": "千羽鶴！？"},
        { "location": "715/ACT"     , "narrator": "", "text": "千羽鶴！？"},
        { "location": "717/TALK"    , "narrator": "千羽鶴", "text": "$handle$と\n現実で会うのは\n初めてね。"},
        { "location": "718/TALK"    , "narrator": "千羽鶴", "text": "とても新鮮。"},
        { "location": "719/SEL"     , "narrator": "", "text": "これは一体どうなってるの！？"},
        { "location": "720/ACT"     , "narrator": "", "text": "これは一体どうなってるの！？"},
        { "location": "722/TALK"    , "narrator": "千羽鶴", "text": "私はあの場から\n閉め出されてしまった。"},
        { "location": "723/TALK"    , "narrator": "千羽鶴", "text": "貴方には迷惑かけたと\n思ってるけど、１点だけ\n聞きたいことがある。"},
        { "location": "724/TALK"    , "narrator": "千羽鶴", "text": "今、國政領火がOSの\nアドミニストレーターに\nなっているわけだけど。"},
        { "location": "725/TALK"    , "narrator": "千羽鶴", "text": "貴方が彼女に\n協力しているのは、本意？\nそれとも不本意？"},
        { "location": "726/SEL"     , "narrator": "", "text": "エリカに同意して協力してる"},
        { "location": "727/SEL"     , "narrator": "", "text": "千羽鶴に協力したいけどエリカに邪魔されてる"},
        { "location": "728/ACT"     , "narrator": "", "text": "エリカに同意して協力してる"},
        { "location": "730/TALK"    , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "731/TALK"    , "narrator": "千羽鶴", "text": "貴方は私の目指す\n輝ける未来には\n賛同していなかったのね。"},
        { "location": "733/ACT"     , "narrator": "", "text": "千羽鶴に協力したいけどエリカに邪魔されてる"},
        { "location": "734/TALK"    , "narrator": "千羽鶴", "text": "なるほど。"},
        { "location": "735/TALK"    , "narrator": "千羽鶴", "text": "それならまずは\nひと安心。"},
        { "location": "738/TALK"    , "narrator": "千羽鶴", "text": "ただ、\nどちらにしても。"},
        { "location": "739/TALK"    , "narrator": "千羽鶴", "text": "結果として世界は\n大きく動いてしまった。"},
        { "location": "740/TALK"    , "narrator": "千羽鶴", "text": "もはや\n収拾がつかないほどに。"},
        { "location": "741/TALK"    , "narrator": "千羽鶴", "text": "そのため、\n更に計画を変更\nせざるを得なくなった。"},
        { "location": "742/TALK"    , "narrator": "千羽鶴", "text": "貴方に迷惑をかける\nつもりはない。"},
        { "location": "743/TALK"    , "narrator": "千羽鶴", "text": "ただ、万一貴方にとって\n納得できないような状況に\nなったとしても――"},
        { "location": "744/TALK"    , "narrator": "千羽鶴", "text": "今回ばかりは、もはや\n話し合ったりしている\n時間はない。"},
        { "location": "745/TALK"    , "narrator": "千羽鶴", "text": "だから、その時の為に\n最初に謝っておく。"},
        { "location": "746/TALK"    , "narrator": "千羽鶴", "text": "けど、それでも尚、\n逢瀬つばめを始めとする\n彼女たちを支えて欲しい。"},
        { "location": "747/TALK"    , "narrator": "千羽鶴", "text": "彼女たちが、彼女たちで\nあり続ける最期の時まで。"},
        { "location": "750/TALK"    , "narrator": "千羽鶴", "text": "逢瀬つばめを\n捕獲して。"},
        { "location": "751/TALK"    , "narrator": "千羽鶴", "text": "幇助未遂の実行犯たちは\n事が済むまで謹慎処分。"},
        { "location": "752/TALK"    , "narrator": "通常攻撃隊Ａ", "text": "はっ。"},
        { "location": "754/SEL"     , "narrator": "", "text": "千羽鶴！"},
        { "location": "755/ACT"     , "narrator": "", "text": "千羽鶴！"},
        { "location": "759/TALK"    , "narrator": "千羽鶴", "text": "何？"},
        { "location": "760/SEL"     , "narrator": "", "text": "千羽鶴はナビの千羽鶴と同じなの？"},
        { "location": "761/SEL"     , "narrator": "", "text": "計画通りにはさせない"},
        { "location": "762/SEL"     , "narrator": "", "text": "本当に千羽鶴は何なの？"},
        { "location": "763/ACT"     , "narrator": "", "text": "千羽鶴はナビの千羽鶴と同じなの？"},
        { "location": "765/TALK"    , "narrator": "千羽鶴", "text": "同じ。"},
        { "location": "767/TALK"    , "narrator": "千羽鶴", "text": "それじゃ。"},
        { "location": "768/ACT"     , "narrator": "", "text": "計画通りにはさせない"},
        { "location": "770/TALK"    , "narrator": "千羽鶴", "text": "そう。\nそれは残念。"},
        { "location": "771/TALK"    , "narrator": "千羽鶴", "text": "ならば貴方はもう\n障害でしかない。"},
        { "location": "772/TALK"    , "narrator": "千羽鶴", "text": "いずれ私は\nアドミニストレーターに\n復帰する。"},
        { "location": "773/TALK"    , "narrator": "千羽鶴", "text": "その時は、\n貴方との回線を\n切断することにする。"},
        { "location": "774/TALK"    , "narrator": "千羽鶴", "text": "その日まで、\nごきげんよう。"},
        { "location": "775/ACT"     , "narrator": "", "text": "本当に千羽鶴は何なの？"},
        { "location": "777/TALK"    , "narrator": "千羽鶴", "text": "その質問は、\n漠然とし過ぎていて\n回答できない。"},
        { "location": "778/TALK"    , "narrator": "千羽鶴", "text": "いずれ私は\nアドミニストレーターに\n復帰する。"},
        { "location": "779/TALK"    , "narrator": "千羽鶴", "text": "その時には、貴方と\n本気の話をしようと\n思っている。"},
        { "location": "780/TALK"    , "narrator": "千羽鶴", "text": "その日まで、\nごきげんよう。"},
        { "location": "793/DIALOG"  , "narrator": "Dialog_chapter_ch01", "text": "【22 トークン・リング】"}
    ]
}
