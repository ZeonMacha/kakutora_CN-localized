    "type": "MainStory",
    "info": {
        "story_id": "13152",
        "cid": "tsubame",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "テスト返却"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "テスト返却"},
        { "location": "27/TALK"   , "narrator": "つばめ", "text": "うわぁ…\nこれ、酷過ぎかも。"},
        { "location": "28/TALK"   , "narrator": "つばめ", "text": "テストでこんな酷い点数\n取ったの初めてだよぉ。"},
        { "location": "29/TALK"   , "narrator": "つばめ", "text": "こっち来てから忙しくて、\nちゃんと勉強できなかった\nからなぁ…。"},
        { "location": "30/TALK"   , "narrator": "つばめ", "text": "…お父さんに見せたら、\n絶対怒られちゃう。"},
        { "location": "31/TALK"   , "narrator": "つばめ", "text": "はぁ…どうしよう？"},
        { "location": "32/TALK"   , "narrator": "つばめ", "text": "…………。"},
        { "location": "44/TALK"   , "narrator": "つばめ", "text": "相談に乗ってください"},
        { "location": "46/SEL"    , "narrator": "", "text": "改まってどうしたの？"},
        { "location": "47/ACT"    , "narrator": "", "text": "改まってどうしたの？"},
        { "location": "49/TALK"   , "narrator": "つばめ", "text": "テストで酷い点数取っちゃったの"},
        { "location": "50/TALK"   , "narrator": "つばめ", "text": "こんなのお父さんに見せたら怒られちゃう"},
        { "location": "51/TALK"   , "narrator": "つばめ", "text": "どうしよう…"},
        { "location": "54/SEL"    , "narrator": "", "text": "お父さんには秘密だ"},
        { "location": "55/SEL"    , "narrator": "", "text": "勉強して次は頑張ろう"},
        { "location": "56/SEL"    , "narrator": "", "text": "友達に教えてもらおう"},
        { "location": "57/ACT"    , "narrator": "", "text": "お父さんには秘密だ"},
        { "location": "58/TALK"   , "narrator": "つばめ", "text": "バレたら余計怒られちゃうよ！"},
        { "location": "60/TALK"   , "narrator": "つばめ", "text": "お父さん、本気で怒ったら凄く怖いんだから！"},
        { "location": "61/TALK"   , "narrator": "つばめ", "text": "憂鬱だよぉ…"},
        { "location": "72/TALK"   , "narrator": "つばめ", "text": "…怒られるの、覚悟して\n見せる以外ないか。"},
        { "location": "73/TALK"   , "narrator": "つばめ", "text": "潔くお父さんに怒られて、\n今度は頑張ろう。"},
        { "location": "74/ACT"    , "narrator": "", "text": "勉強して次は頑張ろう"},
        { "location": "75/TALK"   , "narrator": "つばめ", "text": "そうだね"},
        { "location": "76/TALK"   , "narrator": "つばめ", "text": "お父さんにもそう言ってみるよ"},
        { "location": "87/TALK"   , "narrator": "つばめ", "text": "今度のテストは頑張るって\n約束すれば――"},
        { "location": "88/TALK"   , "narrator": "つばめ", "text": "きっと、そんなには\n怒られない…かな？"},
        { "location": "89/TALK"   , "narrator": "つばめ", "text": "よーし、今夜から\n勉強頑張ろう！"},
        { "location": "90/ACT"    , "narrator": "", "text": "友達に教えてもらおう"},
        { "location": "91/TALK"   , "narrator": "つばめ", "text": "うーん"},
        { "location": "92/TALK"   , "narrator": "つばめ", "text": "迷惑になっちゃわないかな？"},
        { "location": "93/TALK"   , "narrator": "つばめ", "text": "でも、ちょっとお願いしてみるよ"},
        { "location": "112/TALK"  , "narrator": "つばめ", "text": "あの、ひなこちゃん。\nお願いがあるんだけど…。"},
        { "location": "114/TALK"  , "narrator": "雛", "text": "なになに、どうかしたの？"},
        { "location": "116/TALK"  , "narrator": "つばめ", "text": "実は…こういうわけで…。"},
        { "location": "118/TALK"  , "narrator": "雛", "text": "うわぁ…この点数は\nちょっと酷いかも…。"},
        { "location": "120/TALK"  , "narrator": "繭", "text": "七割取れてないのは\nちょっと問題ね。"},
        { "location": "123/TALK"  , "narrator": "つばめ", "text": "わかってるから\n困ってるんだよぉ。"},
        { "location": "124/TALK"  , "narrator": "つばめ", "text": "それで、お願いって\nいうのは…。"},
        { "location": "126/TALK"  , "narrator": "雛", "text": "つばめちゃん！\nみなまで言わなくても\nわかるよ。"},
        { "location": "129/TALK"  , "narrator": "雛", "text": "勉強ならあたしが\n教えてあげるから、\n安心して。"},
        { "location": "130/TALK"  , "narrator": "つばめ", "text": "ほ、本当！？"},
        { "location": "131/TALK"  , "narrator": "雛", "text": "うん！　任せて！"},
        { "location": "133/TALK"  , "narrator": "つばめ", "text": "よかったぁ…。\n相談して正解だったよ！"},
        { "location": "135/TALK"  , "narrator": "雛", "text": "まあ、あたしが苦手な\n教科はまゆちんにお願い\nすることになるけど。"},
        { "location": "137/TALK"  , "narrator": "繭", "text": "ナチュラルに私を\n巻き込むな。"},
        { "location": "139/TALK"  , "narrator": "つばめ", "text": "ひなこちゃん、まゆちん、\nよろしくお願いしまーす！"},
        { "location": "141/TALK"  , "narrator": "繭", "text": "まだ私は教えるなんて\n言ってないんだけど…。"},
        { "location": "143/TALK"  , "narrator": "繭", "text": "…まあ、いいか。"},
        { "location": "16/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>7月14日　11:03 AM</color>\nとある初夏の平日、教室での休み時間のこと。"}
    ]
}
