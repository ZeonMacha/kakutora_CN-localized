        "title": "001 アニメーション",
        "sub_title": "HANABI"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "アニメ第11話"},
        { "location": "48/TALK"   , "narrator": "千羽鶴", "text": "こんにちは、\n$handle$。"},
        { "location": "49/TALK"   , "narrator": "千羽鶴", "text": "現在ACTがゼロの\n千羽鶴です。"},
        { "location": "51/TALK"   , "narrator": "千羽鶴", "text": "いつも通り、今回も\n逢瀬つばめの解説を\nするだけでいい？"},
        { "location": "53/TALK"   , "narrator": "千羽鶴", "text": "いつも通り、今回も\n國政綾水の解説を\nするだけでいい？"},
        { "location": "55/TALK"   , "narrator": "千羽鶴", "text": "いつも通り、今回も\nガブリエラの解説を\nするだけでいい？"},
        { "location": "57/TALK"   , "narrator": "千羽鶴", "text": "いつも通り、今回も\n恋ヶ崎みやびの解説を\nするだけでいい？"},
        { "location": "59/SEL"    , "narrator": "", "text": "はい"},
        { "location": "60/SEL"    , "narrator": "", "text": "いいえ"},
        { "location": "61/ACT"    , "narrator": "", "text": "はい"},
        { "location": "63/TALK"   , "narrator": "千羽鶴", "text": "よかった。\n私も助かる。\nこれぞWIN-WINね。"},
        { "location": "65/ACT"    , "narrator": "", "text": "いいえ"},
        { "location": "67/TALK"   , "narrator": "千羽鶴", "text": "しびれるくらい\n鬼のような人ね。"},
        { "location": "75/TALK"   , "narrator": "千羽鶴", "text": "貴方と初めて出逢ってから\nもう８エピソードにも\nなる。"},
        { "location": "76/TALK"   , "narrator": "千羽鶴", "text": "ここまで色々\n協力してくれて\nありがとう。"},
        { "location": "77/TALK"   , "narrator": "千羽鶴", "text": "貴方は立派に成長した。"},
        { "location": "79/TALK"   , "narrator": "千羽鶴", "text": "逢瀬つばめには\n人間として認識して\nもらえるまでになった！"},
        { "location": "81/TALK"   , "narrator": "千羽鶴", "text": "とっても、とっても\nおめでとう！"},
        { "location": "83/TALK"   , "narrator": "千羽鶴", "text": "だから、そろそろ\n独り立ちの時だと思う。"},
        { "location": "85/TALK"   , "narrator": "千羽鶴", "text": "さようなら、\n$handle$。\n私がいなくても頑張って。"},
        { "location": "86/SEL"    , "narrator": "", "text": "いかないで！"},
        { "location": "87/SEL"    , "narrator": "", "text": "冗談ですよね"},
        { "location": "88/SEL"    , "narrator": "", "text": "今までありがとう。お疲れさま！"},
        { "location": "89/ACT"    , "narrator": "", "text": "いかないで！"},
        { "location": "90/TALK"   , "narrator": "千羽鶴", "text": "何？その、想い人が旅立つ\n瞬間になって突然衝撃告白\nする女のような発言は。"},
        { "location": "91/TALK"   , "narrator": "千羽鶴", "text": "ともあれ、\n無理なものは無理。"},
        { "location": "92/SEL"    , "narrator": "", "text": "理由を教えて"},
        { "location": "93/ACT"    , "narrator": "", "text": "理由を教えて"},
        { "location": "95/ACT"    , "narrator": "", "text": "冗談ですよね"},
        { "location": "96/TALK"   , "narrator": "千羽鶴", "text": "まさか。"},
        { "location": "97/ACT"    , "narrator": "", "text": "今までありがとう。お疲れさま！"},
        { "location": "98/TALK"   , "narrator": "千羽鶴", "text": "……。"},
        { "location": "99/TALK"   , "narrator": "千羽鶴", "text": "………。"},
        { "location": "100/SEL"   , "narrator": "", "text": "？？"},
        { "location": "101/ACT"   , "narrator": "", "text": "？？"},
        { "location": "104/TALK"  , "narrator": "千羽鶴", "text": "そこは\n止めるところだから！"},
        { "location": "106/TALK"  , "narrator": "千羽鶴", "text": "教科書にも\n書いてある。"},
        { "location": "107/TALK"  , "narrator": "千羽鶴", "text": "『さようならと\n言われたら、止めないと\nドラマにならない』と。"},
        { "location": "108/SEL"   , "narrator": "", "text": "何の教科書だよ"},
        { "location": "109/ACT"   , "narrator": "", "text": "何の教科書だよ"},
        { "location": "113/TALK"  , "narrator": "千羽鶴", "text": "そんなことは\nどうでもいい！"},
        { "location": "116/TALK"  , "narrator": "千羽鶴", "text": "というわけで、私は\n貴方に失望したので\n本当に休むことにする。"},
        { "location": "117/TALK"  , "narrator": "千羽鶴", "text": "でも、今回休んでも\n半休になって、あまり\n美味しくないから次回。"},
        { "location": "119/TALK"  , "narrator": "千羽鶴", "text": "正直な話をすると、\n前回のラブラブゲームで\n私のACTは使い果たした。"},
        { "location": "120/SEL"   , "narrator": "", "text": "ACTとかあるの！？"},
        { "location": "121/ACT"   , "narrator": "", "text": "ACTとかあるの！？"},
        { "location": "123/TALK"  , "narrator": "千羽鶴", "text": "もちろん。\n私にもACTはある！"},
        { "location": "126/TALK"  , "narrator": "千羽鶴", "text": "どーん！"},
        { "location": "128/TALK"  , "narrator": "千羽鶴", "text": "ほら、見て。"},
        { "location": "132/TALK"  , "narrator": "千羽鶴", "text": "やめて。\n千羽鶴のACTは\nもうゼロ。"},
        { "location": "133/SEL"   , "narrator": "", "text": "それじゃしょうがないね"},
        { "location": "134/SEL"   , "narrator": "", "text": "ACT回復させるよ！"},
        { "location": "135/ACT"   , "narrator": "", "text": "それじゃしょうがないね"},
        { "location": "136/TALK"  , "narrator": "千羽鶴", "text": "そう。\nしょうがない。"},
        { "location": "137/TALK"  , "narrator": "千羽鶴", "text": "でも、貴方には\n頑張ってもらいたいから、\n最低限のことは喋る。"},
        { "location": "138/TALK"  , "narrator": "千羽鶴", "text": "その為には、\nまずは記録映像を\n見てもらわないと。"},
        { "location": "139/ACT"   , "narrator": "", "text": "ACT回復させるよ！"},
        { "location": "140/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "141/TALK"  , "narrator": "千羽鶴", "text": "私のACTを回復させるには\n楽のココロキャンディが"},
        { "location": "144/TALK"  , "narrator": "千羽鶴", "text": "<color=red><size=40>1001個必要！</size></color>"},
        { "location": "145/TALK"  , "narrator": "千羽鶴", "text": "なお、\nお支払いは一括のみ。"},
        { "location": "146/SEL"   , "narrator": "", "text": "キャンディって999個がMAXだよね？"},
        { "location": "147/ACT"   , "narrator": "", "text": "キャンディって999個がMAXだよね？"},
        { "location": "150/TALK"  , "narrator": "千羽鶴", "text": "そうね。"},
        { "location": "151/SEL"   , "narrator": "", "text": "仕様バグじゃん！"},
        { "location": "152/ACT"   , "narrator": "", "text": "仕様バグじゃん！"},
        { "location": "155/TALK"  , "narrator": "千羽鶴", "text": "違う！"},
        { "location": "156/TALK"  , "narrator": "千羽鶴", "text": "それはすなわち、私の\nACTは自然にしか回復する\n気がないということ！"},
        { "location": "157/TALK"  , "narrator": "千羽鶴", "text": "それをプログラム的に\n表現すると、こういう\n表記になる。"},
        { "location": "158/TALK"  , "narrator": "千羽鶴", "text": "なぜなら、私には\nリアル時間による休息が\n必要だから！"},
        { "location": "159/SEL"   , "narrator": "", "text": "プログラムなのに？"},
        { "location": "160/SEL"   , "narrator": "", "text": "この前も塩対応モードだったばっかりなのに"},
        { "location": "161/ACT"   , "narrator": "", "text": "プログラムなのに？"},
        { "location": "162/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "163/TALK"  , "narrator": "千羽鶴", "text": "そういう設定の\nプログラムキャラ\nだもの。"},
        { "location": "164/ACT"   , "narrator": "", "text": "この前も塩対応モードだったばっかりなのに"},
        { "location": "165/TALK"  , "narrator": "千羽鶴", "text": "塩対応と休息は\n似て非なるもの。"},
        { "location": "166/TALK"  , "narrator": "千羽鶴", "text": "処理が全然違うから、\n今回休みたいと思ってる\n処理を休めてない。"},
        { "location": "169/TALK"  , "narrator": "千羽鶴", "text": "ああっ…ACTも無いのに\n今日も何故か一杯\n喋らされている私。"},
        { "location": "170/TALK"  , "narrator": "千羽鶴", "text": "むしろACTが無いのに\nこんなに喋れていること\n自体がバグ。"},
        { "location": "173/TALK"  , "narrator": "千羽鶴", "text": "サポートセンターに\n報告しておく。"},
        { "location": "174/TALK"  , "narrator": "千羽鶴", "text": "『PN:ちー/千羽鶴が\nACTも無いのに喋って\nます。直してください』"},
        { "location": "175/TALK"  , "narrator": "千羽鶴", "text": "これでよし。"},
        { "location": "176/SEL"   , "narrator": "", "text": "な、直してもらえるといいですね…"},
        { "location": "177/ACT"   , "narrator": "", "text": "な、直してもらえるといいですね…"},
        { "location": "179/TALK"  , "narrator": "千羽鶴", "text": "本当に。"},
        { "location": "180/TALK"  , "narrator": "千羽鶴", "text": "さて、それじゃ早速\n今回も記録映像を\n見てもらうことにする。"},
        { "location": "183/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/78MB 5:07】</color>"},
        { "location": "184/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/25MB 5:07】</color>"},
        { "location": "185/SEL"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "186/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/75MB 4:57】</color>"},
        { "location": "187/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "193/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/24MB 4:57】</color>"},
        { "location": "194/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "200/ACT"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "201/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "234/TALK"  , "narrator": "千羽鶴", "text": "――というわけで、\n素敵なお祭り回だった。"},
        { "location": "235/TALK"  , "narrator": "千羽鶴", "text": "何か質問があれば。"},
        { "location": "236/SEL"   , "narrator": "", "text": "特にない \n<color=blue>（※先へ進みます）</color>"},
        { "location": "237/ACT"   , "narrator": "", "text": "特にない \n<color=blue>（※先へ進みます）</color>"},
        { "location": "239/TALK"  , "narrator": "千羽鶴", "text": "まあ！"},
        { "location": "240/SEL"   , "narrator": "", "text": "いやいやいやいや"},
        { "location": "242/TALK"  , "narrator": "千羽鶴", "text": "質問が何も無いなんて、\nなんて素敵なの！？"},
        { "location": "244/TALK"  , "narrator": "千羽鶴", "text": "それじゃ早速、\n今回の行動指針を\n伝えたいと思う。"},
        { "location": "248/ACT"   , "narrator": "", "text": "いやいやいやいや"},
        { "location": "250/TALK"  , "narrator": "千羽鶴", "text": "なに？"},
        { "location": "251/SEL"   , "narrator": "", "text": "それしか選択肢が無かったからだよ！"},
        { "location": "252/ACT"   , "narrator": "", "text": "それしか選択肢が無かったからだよ！"},
        { "location": "254/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "255/TALK"  , "narrator": "千羽鶴", "text": "そういう回もある。"},
        { "location": "256/SEL"   , "narrator": "", "text": "ほんとに？？"},
        { "location": "257/ACT"   , "narrator": "", "text": "ほんとに？？"},
        { "location": "259/TALK"  , "narrator": "千羽鶴", "text": "私はシステムだし、\n間違った事は言ってない。"},
        { "location": "260/SEL"   , "narrator": "", "text": "$me$には質問したい事がある！"},
        { "location": "261/ACT"   , "narrator": "", "text": "$me$には質問したい事がある！"},
        { "location": "263/TALK"  , "narrator": "千羽鶴", "text": "いつもなんでも\n質問できると思ったら\n大間違いだから。"},
        { "location": "264/SEL"   , "narrator": "", "text": "じゃあそもそも質問コーナーを作ること自体がおかしい"},
        { "location": "265/ACT"   , "narrator": "", "text": "じゃあそもそも質問コーナーを作ること自体がおかしい"},
        { "location": "267/TALK"  , "narrator": "千羽鶴", "text": "だいぶ切り返しが\n鋭くなってきてる。"},
        { "location": "268/TALK"  , "narrator": "千羽鶴", "text": "いい調子！"},
        { "location": "270/TALK"  , "narrator": "千羽鶴", "text": "公的に保証されている\nシステムや報道であっても\n鵜呑みにはしないこと。"},
        { "location": "271/TALK"  , "narrator": "千羽鶴", "text": "ラブラブトレーナーの\nチュートリアルキャラでも\n抜き打ちの嘘はある。"},
        { "location": "272/TALK"  , "narrator": "千羽鶴", "text": "『絶対に正しい』という\n観念は、どんな状況下に\nおいても持たないこと。"},
        { "location": "273/TALK"  , "narrator": "千羽鶴", "text": "それが世渡りには\nとても大事。"},
        { "location": "274/TALK"  , "narrator": "千羽鶴", "text": "ご褒美に\n質問を解禁する。"},
        { "location": "277/SEL"   , "narrator": "", "text": "今回の記録映像って、わざわざ見せる必要があるシーンなの？"},
        { "location": "278/SEL"   , "narrator": "", "text": "ガブちゃんの心情をもっと詳しく教えて欲しい"},
        { "location": "279/SEL"   , "narrator": "", "text": "みやびのジャミングって大丈夫なの？"},
        { "location": "280/SEL"   , "narrator": "", "text": "男共がウザイ"},
        { "location": "281/SEL"   , "narrator": "", "text": "特にない \n<color=blue>（※先へ進みます）</color>"},
        { "location": "282/ACT"   , "narrator": "", "text": "これってわざわざ見せる必要がある回なの？"},
        { "location": "283/TALK"  , "narrator": "千羽鶴", "text": "もちろん。\nあるから見せてる。"},
        { "location": "284/TALK"  , "narrator": "千羽鶴", "text": "彼女を支えていくに\nあたって、とても重要な\n情報だと思わない？"},
        { "location": "285/TALK"  , "narrator": "千羽鶴", "text": "もしかして、見たくない\nものを見せられた、とか\nそういうこと？"},
        { "location": "286/SEL"   , "narrator": "", "text": "そういうこと"},
        { "location": "287/SEL"   , "narrator": "", "text": "そういうわけじゃないけど"},
        { "location": "288/ACT"   , "narrator": "", "text": "そういうこと"},
        { "location": "289/TALK"  , "narrator": "千羽鶴", "text": "今回の件は、\nガブリエラにとって、\nとても重要な転機。"},
        { "location": "290/TALK"  , "narrator": "千羽鶴", "text": "それを貴方が見守って\nあげなくて、誰が彼女を\n守ってあげられる？"},
        { "location": "291/TALK"  , "narrator": "千羽鶴", "text": "……まあでも、事実は\n事実として存在し、\nそれは変えられない。"},
        { "location": "292/TALK"  , "narrator": "千羽鶴", "text": "それをどう思うかが\n一人一人で全然違う、\nただそれだけのこと。"},
        { "location": "293/TALK"  , "narrator": "千羽鶴", "text": "貴方が彼女の気持ちを\n受け入れられないなら――"},
        { "location": "294/TALK"  , "narrator": "千羽鶴", "text": "彼女を本気で守っていく\nこともまた、難しいかも\nしれない。"},
        { "location": "295/TALK"  , "narrator": "千羽鶴", "text": "自分自身とちゃんと\n向き合って、考えて\n答えを出してみて。"},
        { "location": "296/ACT"   , "narrator": "", "text": "そういうわけじゃないけど"},
        { "location": "297/TALK"  , "narrator": "千羽鶴", "text": "あら、そう？"},
        { "location": "298/TALK"  , "narrator": "千羽鶴", "text": "ならば特に\n問題なさそうだけど。"},
        { "location": "300/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "302/ACT"   , "narrator": "", "text": "ガブちゃんの心情をもっと詳しく教えて欲しい"},
        { "location": "303/TALK"  , "narrator": "千羽鶴", "text": "それは私からは\n教えることはできない。"},
        { "location": "304/TALK"  , "narrator": "千羽鶴", "text": "彼女の心の内は、\n彼女にのみ、公開する\n権限がある。"},
        { "location": "305/TALK"  , "narrator": "千羽鶴", "text": "いえ。寧ろ彼女を支えて\nあげたいという気持ちで\n接していれば――"},
        { "location": "306/TALK"  , "narrator": "千羽鶴", "text": "彼女もまた、それに\n応えるように、貴方に\n色々教えてくれるはず。"},
        { "location": "307/TALK"  , "narrator": "千羽鶴", "text": "ただ１つだけ、\n知っておいて\nもらいたいことがある。"},
        { "location": "308/TALK"  , "narrator": "千羽鶴", "text": "彼女にとって、\n今回の件はとても大切で、\nとても重たいこと。"},
        { "location": "309/TALK"  , "narrator": "千羽鶴", "text": "彼女にとって、\n彼女を支える存在は、\n必ず必要になる。"},
        { "location": "310/TALK"  , "narrator": "千羽鶴", "text": "私は、それが\n貴方であることを\n強く望んでいる。"},
        { "location": "311/TALK"  , "narrator": "千羽鶴", "text": "ちょっとルールギリギリ\nの回答になったけど――"},
        { "location": "312/TALK"  , "narrator": "千羽鶴", "text": "彼女が大切だからこそ、\nこの質問を選んだと\n判断しての回答だから。"},
        { "location": "313/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "315/ACT"   , "narrator": "", "text": "みやびのジャミングって大丈夫なの？"},
        { "location": "316/TALK"  , "narrator": "千羽鶴", "text": "まあ、全然ダメだけど\n彼女なら上手く切り抜けて\nしまうことでしょう。"},
        { "location": "317/TALK"  , "narrator": "千羽鶴", "text": "実際彼女は、念には念を\n押すタイプだから、今回も\n万一の対策はしてある。"},
        { "location": "318/TALK"  , "narrator": "千羽鶴", "text": "情報管理庁に勤務する\n特定の職群においては――"},
        { "location": "319/TALK"  , "narrator": "千羽鶴", "text": "申請により一時的に\n電波法による制限の\n緩和も認められる。"},
        { "location": "320/TALK"  , "narrator": "千羽鶴", "text": "この特例について、\n随分と事前に下調べ\nしていたみたい。"},
        { "location": "321/TALK"  , "narrator": "千羽鶴", "text": "だから、何かあったと\nしても、この特例を上手く\n使って切り抜けると思う。"},
        { "location": "323/TALK"  , "narrator": "千羽鶴", "text": "それと……"},
        { "location": "324/TALK"  , "narrator": "千羽鶴", "text": "彼女に「違反」的な\nツッコミは、あまり\n意味を成さないかも。"},
        { "location": "325/TALK"  , "narrator": "千羽鶴", "text": "そもそもハッカーとして\n活動している以上、様々な\nことに抵触してるわけで。"},
        { "location": "326/TALK"  , "narrator": "千羽鶴", "text": "そういったアンダー\nグラウンドな事を、彼女は\n自己理念に基づいてやる。"},
        { "location": "327/TALK"  , "narrator": "千羽鶴", "text": "そして、それ自体が彼女の\n生き方であって、自己形成\nの重要な部分を担ってる。"},
        { "location": "328/TALK"  , "narrator": "千羽鶴", "text": "もし今回の事で彼女に\n否定的な感情を\n抱いたのであれば――"},
        { "location": "329/TALK"  , "narrator": "千羽鶴", "text": "そういった点も含めて\n彼女を本気で支えられるか\nどうか考えてみて欲しい。"},
        { "location": "332/ACT"   , "narrator": "", "text": "男共がウザイ"},
        { "location": "333/TALK"  , "narrator": "千羽鶴", "text": "そうね。"},
        { "location": "334/TALK"  , "narrator": "千羽鶴", "text": "でも、貴方は知らないかも\nしれないけど……"},
        { "location": "337/TALK"  , "narrator": "千羽鶴", "text": "世の中には35億人以上の\n男共が存在する。"},
        { "location": "338/TALK"  , "narrator": "千羽鶴", "text": "それらに一人たりとも\nヒットしない生き方は、\nそれ自体が奇跡を超える。"},
        { "location": "339/TALK"  , "narrator": "千羽鶴", "text": "そう思わない？"},
        { "location": "341/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "343/ACT"   , "narrator": "", "text": "特にない \n<color=blue>（※先へ進みます）</color>"},
        { "location": "344/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "352/TALK"  , "narrator": "千羽鶴", "text": "さて、今回の\n逢瀬つばめについて\nなんだけども。"},
        { "location": "353/TALK"  , "narrator": "千羽鶴", "text": "前回と同じく、ガブリエラ\nとの完了については、\nガブリエラの方で見せる。"},
        { "location": "354/TALK"  , "narrator": "千羽鶴", "text": "なぜなら前回同様、\n逢瀬つばめには、より\n重大な事件があったから。"},
        { "location": "355/TALK"  , "narrator": "千羽鶴", "text": "正直、逢瀬つばめは\nロマンチック大作戦とか\nしてる場合じゃなかった！"},
        { "location": "356/TALK"  , "narrator": "千羽鶴", "text": "それくらいの事件が\n彼女には降りかかって\nいたということ。"},
        { "location": "357/TALK"  , "narrator": "千羽鶴", "text": "と、これで何が起きたか\n感づいた人は、正真正銘の\nつばめマスター。"},
        { "location": "358/TALK"  , "narrator": "千羽鶴", "text": "過去のエピソードの中に\nヒントはあったから。"},
        { "location": "359/TALK"  , "narrator": "千羽鶴", "text": "まあとにかく、そこで\n彼女は珍しく彼女らしく\nない行動に出る。"},
        { "location": "360/TALK"  , "narrator": "千羽鶴", "text": "貴方はそれを、彼女に\nとって最善と思われる\n方向に導いてあげて。"},
        { "location": "361/TALK"  , "narrator": "千羽鶴", "text": "あ、それと、\n貴方自身にも一応\n言うだけ言っておく。"},
        { "location": "362/TALK"  , "narrator": "千羽鶴", "text": "くれぐれも\n先走った行動には\n出ないように。"},
        { "location": "363/TALK"  , "narrator": "千羽鶴", "text": "それじゃ、\n健闘を祈ってる。"},
        { "location": "368/TALK"  , "narrator": "千羽鶴", "text": "さて、今回の\n國政綾水について\nなんだけども。"},
        { "location": "369/TALK"  , "narrator": "千羽鶴", "text": "彼女は映像記録の中では\n特に大きな問題等に\n直面してはいない。"},
        { "location": "370/TALK"  , "narrator": "千羽鶴", "text": "けど、同期間中に\n逢瀬つばめに対する\n重大な転機が訪れている。"},
        { "location": "371/TALK"  , "narrator": "千羽鶴", "text": "前回もなかなかハードな\n絡みを見たあとだから、\n期待するかもだけど――"},
        { "location": "372/TALK"  , "narrator": "千羽鶴", "text": "今回は絵面はそこまででも\nないので、過度な期待は\nしないように。"},
        { "location": "373/TALK"  , "narrator": "千羽鶴", "text": "ただ、心境変化としては\n逢瀬つばめとの関係に\nおいて重大なものになる。"},
        { "location": "374/TALK"  , "narrator": "千羽鶴", "text": "その転機を、彼女にとって\n良い方向に進むよう、\n是非一押しして欲しい。"},
        { "location": "375/TALK"  , "narrator": "千羽鶴", "text": "グッドラック。"},
        { "location": "380/TALK"  , "narrator": "千羽鶴", "text": "さて、今回の\nガブリエラについて\nなんだけども。"},
        { "location": "381/TALK"  , "narrator": "千羽鶴", "text": "言わずもがな、\n今回の騒動の件について。"},
        { "location": "382/TALK"  , "narrator": "千羽鶴", "text": "記録映像で一旦は\n終わりを見せたように\n思えるけど――"},
        { "location": "383/TALK"  , "narrator": "千羽鶴", "text": "実はこの後、もう１つ\nガブリエラにとって重大な\n転機が訪れる。"},
        { "location": "384/TALK"  , "narrator": "千羽鶴", "text": "いえ、寧ろ記録映像の事\n以上に、こちらの方が\n重要な事かもしれない。"},
        { "location": "385/TALK"  , "narrator": "千羽鶴", "text": "一応何についてかだけ\n先に伝えておくと、逢瀬\nつばめとの関係について。"},
        { "location": "386/TALK"  , "narrator": "千羽鶴", "text": "彼女の中では\n出逢ってからずっと\n燻っていた問題でもある。"},
        { "location": "387/TALK"  , "narrator": "千羽鶴", "text": "それが今回の騒動を\nトリガーとして、ついに\n完了を迎える事になる。"},
        { "location": "388/TALK"  , "narrator": "千羽鶴", "text": "でも、そこには\n貴方の助力がどうしても\n必要になってくる。"},
        { "location": "389/TALK"  , "narrator": "千羽鶴", "text": "ガブリエラはここ数回で\n色々衝撃の連発だけど、\nそれは彼女も同じこと。"},
        { "location": "390/TALK"  , "narrator": "千羽鶴", "text": "彼女を支えたいという\n気持ちがあるなら、\n最後まで支えてほしい。"},
        { "location": "391/TALK"  , "narrator": "千羽鶴", "text": "健闘を祈ってる。"},
        { "location": "395/TALK"  , "narrator": "千羽鶴", "text": "さて、今回の\n恋ヶ崎みやびについて\nなんだけども。"},
        { "location": "396/TALK"  , "narrator": "千羽鶴", "text": "彼女については\n記録映像の中では\n特筆すべき問題はない。"},
        { "location": "397/TALK"  , "narrator": "千羽鶴", "text": "……まあ、問題はあるに\nせよ、それはココロの問題\nではない。"},
        { "location": "398/TALK"  , "narrator": "千羽鶴", "text": "だから彼女については、\n日常での重要なラインの\n１つに焦点を当てていく。"},
        { "location": "399/TALK"  , "narrator": "千羽鶴", "text": "このラインは、実は\n後々の非常に重要な\n伏線となるもの。"},
        { "location": "400/TALK"  , "narrator": "千羽鶴", "text": "ただ、今回のエピソードを\n見たところで、何のことか\nピンとは来ないと思う。"},
        { "location": "401/TALK"  , "narrator": "千羽鶴", "text": "だから、今回に関しては\n彼女の日常の一幕を楽しむ\n気分で接すればいい。"},
        { "location": "402/TALK"  , "narrator": "千羽鶴", "text": "後で見返したとき、ここが\n大きな流れの起点だったと\n改めて思えるはず。"},
        { "location": "403/TALK"  , "narrator": "千羽鶴", "text": "良い結果になることを\n期待してる。"},
        { "location": "130/DIALOG", "narrator": "Dialog_Notice", "text": "<color=red>ACTが足りません</color>\nもうしゃべれない。"},
