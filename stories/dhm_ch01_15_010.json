        { "location": "7/SCENARIO", "narrator": "", "text": "028_言葉足らず、気持ち知らず"},
        { "location": "32/TALK"   , "narrator": "つばめ", "text": "ぁたし人にものを伝えるのが下手みたぃ(´,,･ω･,,｀)"},
        { "location": "33/TALK"   , "narrator": "つばめ", "text": "こぅぃうのってどうやって練習すればぃぃのかな"},
        { "location": "35/SEL"    , "narrator": "", "text": "何があったか話してみて"},
        { "location": "36/SEL"    , "narrator": "", "text": "$me$で練習しよう"},
        { "location": "37/ACT"    , "narrator": "", "text": "何があったか話してみて"},
        { "location": "38/TALK"   , "narrator": "つばめ", "text": "ぇっとね(･Д･｀)"},
        { "location": "39/ACT"    , "narrator": "", "text": "$me$で練習しよう"},
        { "location": "41/TALK"   , "narrator": "つばめ", "text": "そっか(*´︶`*)"},
        { "location": "43/TALK"   , "narrator": "つばめ", "text": "そぅするねヽ(*´∀｀*)ﾉ"},
        { "location": "45/TALK"   , "narrator": "つばめ", "text": "お弁当を作ってくれてたの"},
        { "location": "46/TALK"   , "narrator": "つばめ", "text": "もう作らなくてぃぃょって言ったの"},
        { "location": "47/TALK"   , "narrator": "つばめ", "text": "そぅしたらしょんぼりされちゃったの"},
        { "location": "49/SEL"    , "narrator": "", "text": "貰い続けるよりいいと思う"},
        { "location": "50/SEL"    , "narrator": "", "text": "よく頑張ったね"},
        { "location": "51/SEL"    , "narrator": "", "text": "気にすることじゃない"},
        { "location": "52/ACT"    , "narrator": "", "text": "貰い続けるよりいいと思う"},
        { "location": "53/TALK"   , "narrator": "つばめ", "text": "ぅん"},
        { "location": "55/TALK"   , "narrator": "つばめ", "text": "そぅだょね"},
        { "location": "56/TALK"   , "narrator": "つばめ", "text": "でも"},
        { "location": "57/TALK"   , "narrator": "つばめ", "text": "しょんぼりされなぃ言い方があったんじゃないかって思うんだ"},
        { "location": "58/TALK"   , "narrator": "つばめ", "text": "こうぃぅの難しいね"},
        { "location": "59/ACT"    , "narrator": "", "text": "よく頑張ったね"},
        { "location": "61/TALK"   , "narrator": "つばめ", "text": "ぅん(*´︶`*)"},
        { "location": "62/TALK"   , "narrator": "つばめ", "text": "一生懸命作ってくれてるのわかるし"},
        { "location": "63/TALK"   , "narrator": "つばめ", "text": "ぁたしも言いにくぃことだし"},
        { "location": "64/TALK"   , "narrator": "つばめ", "text": "すっごく緊張したんだょo(*･ﾛ･*)o"},
        { "location": "65/TALK"   , "narrator": "つばめ", "text": "ちゃんと言えてよかったょ"},
        { "location": "67/TALK"   , "narrator": "つばめ", "text": "それで"},
        { "location": "68/TALK"   , "narrator": "つばめ", "text": "もし次があったら"},
        { "location": "69/TALK"   , "narrator": "つばめ", "text": "しょんぼりされなぃ言い方で言うょ"},
        { "location": "70/TALK"   , "narrator": "つばめ", "text": "がんばらなきゃねヽ(･ω･ )ゝ✧"},
        { "location": "71/ACT"    , "narrator": "", "text": "気にすることじゃない"},
        { "location": "72/TALK"   , "narrator": "つばめ", "text": "そぅかな？"},
        { "location": "73/TALK"   , "narrator": "つばめ", "text": "ぁたしは人をしょんぼりさせるのはぃゃだょ"},
        { "location": "74/TALK"   , "narrator": "つばめ", "text": "しかも"},
        { "location": "75/TALK"   , "narrator": "つばめ", "text": "応援してくれてたんだから"},
        { "location": "76/TALK"   , "narrator": "つばめ", "text": "言い方って"},
        { "location": "78/TALK"   , "narrator": "つばめ", "text": "難しいね"}
