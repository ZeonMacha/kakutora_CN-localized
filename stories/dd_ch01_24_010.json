{
    "dir": "chap24/daydra/dd_ch01_24_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "24152",
        "cid": "tsubame",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "心を許せる親友"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "心を許せる親友"},
        { "location": "26/TALK"   , "narrator": "つばめ", "text": "…そっか。\n二人とも、ガブちゃんから\n話は聞いてるんだ？"},
        { "location": "28/TALK"   , "narrator": "雛", "text": "うん…神楽ちゃんが、\nつばめちゃん達のことを\n裏切った、って…。"},
        { "location": "29/TALK"   , "narrator": "つばめ", "text": "…………。"},
        { "location": "30/TALK"   , "narrator": "雛", "text": "つばめちゃん…大丈夫？"},
        { "location": "32/TALK"   , "narrator": "つばめ", "text": "う、うん…。\nわたしは平気だよ。"},
        { "location": "34/TALK"   , "narrator": "繭", "text": "うそ。"},
        { "location": "35/TALK"   , "narrator": "繭", "text": "仲間が裏切られて、\n平気なわけがない。"},
        { "location": "37/TALK"   , "narrator": "つばめ", "text": "…………。"},
        { "location": "39/TALK"   , "narrator": "雛", "text": "言いたいこととか、\n話したいことがあったら、\n何でも聞くよ。"},
        { "location": "40/TALK"   , "narrator": "雛", "text": "それくらいしか、\nあたし達にはできない\nから…。"},
        { "location": "41/TALK"   , "narrator": "繭", "text": "…強制はしないから。\n言いたくないなら\n言わないでいい。"},
        { "location": "42/TALK"   , "narrator": "繭", "text": "でも、言えば少しはラクに\nなるかもしれないわ。"},
        { "location": "45/TALK"   , "narrator": "つばめ", "text": "…ありがと。\nひなこちゃん、まゆちん。"},
        { "location": "47/TALK"   , "narrator": "つばめ", "text": "でも…本当に平気なの。"},
        { "location": "48/TALK"   , "narrator": "つばめ", "text": "本当は、落ち込んでないと\n変だと思うけど…。"},
        { "location": "49/TALK"   , "narrator": "つばめ", "text": "何か、平気なの。\nだから心配しないで。"},
        { "location": "50/TALK"   , "narrator": "雛", "text": "…………。"},
        { "location": "51/TALK"   , "narrator": "繭", "text": "…………。"},
        { "location": "52/TALK"   , "narrator": "つばめ", "text": "…………。"},
        { "location": "53/SEL"    , "narrator": "", "text": "二人とも気まずそう"},
        { "location": "54/ACT"    , "narrator": "", "text": "二人とも気まずそう"},
        { "location": "72/TALK"   , "narrator": "つばめ", "text": "そぅかも(´・ω・｀)"},
        { "location": "73/TALK"   , "narrator": "つばめ", "text": "やっぱり"},
        { "location": "75/TALK"   , "narrator": "つばめ", "text": "わたしのせぃだよね(´つω・｀)ｼｭﾝ"},
        { "location": "76/TALK"   , "narrator": "つばめ", "text": "どぅしたらぃぃのかな？(o´Д`)=з"},
        { "location": "78/SEL"    , "narrator": "", "text": "二人には甘えていいんだよ"},
        { "location": "79/SEL"    , "narrator": "", "text": "どこか遊びに行こう"},
        { "location": "80/ACT"    , "narrator": "", "text": "二人には甘えていいんだよ"},
        { "location": "84/TALK"   , "narrator": "つばめ", "text": "でも"},
        { "location": "85/TALK"   , "narrator": "つばめ", "text": "わたしのもんだぃだし(･Д･｀)"},
        { "location": "86/TALK"   , "narrator": "つばめ", "text": "二人に"},
        { "location": "87/TALK"   , "narrator": "つばめ", "text": "迷惑かけられなぃよ・゜・(ノД`)・゜・"},
        { "location": "89/SEL"    , "narrator": "", "text": "それは迷惑じゃない"},
        { "location": "90/ACT"    , "narrator": "", "text": "それは迷惑じゃない"},
        { "location": "103/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "104/TALK"  , "narrator": "つばめ", "text": "いいの、かな？"},
        { "location": "105/TALK"  , "narrator": "つばめ", "text": "本当に…わたし、\nひなこちゃん達に\n甘えちゃって…。"},
        { "location": "107/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "109/ACT"   , "narrator": "", "text": "どこか遊びに行こう"},
        { "location": "110/TALK"  , "narrator": "つばめ", "text": "そぅだね"},
        { "location": "111/TALK"  , "narrator": "つばめ", "text": "それがぃぃかも(≧ω≦)"},
        { "location": "113/TALK"  , "narrator": "つばめ", "text": "その方が"},
        { "location": "114/TALK"  , "narrator": "つばめ", "text": "気を使わせなぃですむしヽ(･ω･ )ゝ☆"},
        { "location": "126/TALK"  , "narrator": "つばめ", "text": "…そうだ！\n二人とも、今日の放課後\n遊びに行かない？"},
        { "location": "129/TALK"  , "narrator": "雛", "text": "えっ？"},
        { "location": "130/TALK"  , "narrator": "繭", "text": "…………。"},
        { "location": "131/TALK"  , "narrator": "つばめ", "text": "この前始まったばかりの\n映画で見たいのが――"},
        { "location": "132/TALK"  , "narrator": "雛", "text": "行かない。"},
        { "location": "133/TALK"  , "narrator": "雛", "text": "あたし…今はそういう\n気分じゃないし…。"},
        { "location": "134/TALK"  , "narrator": "繭", "text": "同じく。"},
        { "location": "135/TALK"  , "narrator": "つばめ", "text": "そ、そっか…。"},
        { "location": "136/TALK"  , "narrator": "つばめ", "text": "じゃあ、何か甘い物でも\n食べに行くとかは？"},
        { "location": "137/TALK"  , "narrator": "雛", "text": "…………。"},
        { "location": "138/TALK"  , "narrator": "つばめ", "text": "だめ？"},
        { "location": "139/TALK"  , "narrator": "雛", "text": "…別に、映画でも、\nお茶しに行くんでも、\nあたし達は構わないの。"},
        { "location": "140/TALK"  , "narrator": "雛", "text": "けど、それをして\nつばめちゃんは、\n本当に楽しいと思える？"},
        { "location": "141/TALK"  , "narrator": "繭", "text": "逢瀬さんが私達を\n楽しませようとしてるのは\nわかってる。"},
        { "location": "142/TALK"  , "narrator": "繭", "text": "けど、あなたが楽しいと\n思えないなら、一緒にいる\n私達も楽しめない。"},
        { "location": "143/TALK"  , "narrator": "繭", "text": "気を使わせないために\n言ってるとしたら、\n完全逆効果だから。"},
        { "location": "144/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "146/TALK"  , "narrator": "雛", "text": "…ちょっと悲しいな。"},
        { "location": "147/TALK"  , "narrator": "雛", "text": "落ち込んでる友達を\n元気づけたいのに、\n逆に気を使わるんだもん。"},
        { "location": "148/TALK"  , "narrator": "雛", "text": "なんか…情けないな…。"},
        { "location": "150/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "154/TALK"  , "narrator": "つばめ", "text": "辛いよ…。"},
        { "location": "156/TALK"  , "narrator": "つばめ", "text": "わたしも…神楽ちゃんが\nいなくなっちゃって、\nとっても辛い…。"},
        { "location": "158/TALK"  , "narrator": "つばめ", "text": "だって神楽ちゃんは…、\n神楽ちゃんは、わたしの\n大切なお友達だもん。"},
        { "location": "160/TALK"  , "narrator": "つばめ", "text": "なのに…こんな形で\n離ればなれになっちゃう\nなんて…。"},
        { "location": "162/TALK"  , "narrator": "雛", "text": "つばめちゃん…。"},
        { "location": "163/TALK"  , "narrator": "雛", "text": "ありがと…ちゃんと、\n辛いって正直に話して\nくれて。"},
        { "location": "164/TALK"  , "narrator": "つばめ", "text": "うっ、ううっ…。"},
        { "location": "165/TALK"  , "narrator": "雛", "text": "ありがと。\nあたし達のために、\n明るく振る舞ってくれて。"},
        { "location": "166/TALK"  , "narrator": "雛", "text": "でもね、いいんだよ？\nあたし達の前では、\n変に気を使わなくて。"},
        { "location": "167/TALK"  , "narrator": "つばめ", "text": "ご、ごめんね…。\nわたし、こんな弱いとこ\n見せたくなくて…。"},
        { "location": "168/TALK"  , "narrator": "雛", "text": "弱くなんかないよ。\nつばめちゃんは、\nとっても強い子だよ。"},
        { "location": "169/TALK"  , "narrator": "雛", "text": "辛いの我慢して、\nあたし達に気を使って\n明るく振る舞ったし。"},
        { "location": "170/TALK"  , "narrator": "繭", "text": "…無理してるの\nバレバレだったけど。"},
        { "location": "172/TALK"  , "narrator": "つばめ", "text": "えっ…？"},
        { "location": "173/TALK"  , "narrator": "雛", "text": "うん、つばめちゃん、\n演技力なさ過ぎだよ。"},
        { "location": "174/TALK"  , "narrator": "雛", "text": "頑張ってくれてるのは\nわかったけど、\n見てて辛かったよ…。"},
        { "location": "175/TALK"  , "narrator": "繭", "text": "逆効果。\nただただ痛々し過ぎた。"},
        { "location": "178/TALK"  , "narrator": "つばめ", "text": "ご、ごめんなさい…。"},
        { "location": "179/TALK"  , "narrator": "雛", "text": "謝ることないって。\nつばめちゃんは\n何も悪くないよー。"},
        { "location": "180/TALK"  , "narrator": "雛", "text": "それに…、悪いのは\n神楽ちゃんでしょ？"},
        { "location": "182/TALK"  , "narrator": "つばめ", "text": "え？"},
        { "location": "183/TALK"  , "narrator": "雛", "text": "ずっと友達のフリして、\nあたし達のことを\n騙してたんだよ？"},
        { "location": "184/TALK"  , "narrator": "雛", "text": "しかも、つばめちゃんに\n酷いことして…、\n絶対に許せない。"},
        { "location": "185/TALK"  , "narrator": "繭", "text": "…何としてでも、\n卯月神楽には\n代償を支払わせないと。"},
        { "location": "186/TALK"  , "narrator": "つばめ", "text": "や、やめて！"},
        { "location": "187/TALK"  , "narrator": "つばめ", "text": "二人とも、神楽ちゃんを\n悪く言わないであげて！"},
        { "location": "188/TALK"  , "narrator": "雛", "text": "なんで！？\nつばめちゃん達を\n裏切ったんだよ！？"},
        { "location": "189/TALK"  , "narrator": "つばめ", "text": "違うよ！　神楽ちゃんは\n誰も裏切ってない。\n誤解だよ！"},
        { "location": "190/TALK"  , "narrator": "繭", "text": "…何でそう言えるの？\n彼女に何をされたか、\n忘れた？"},
        { "location": "192/TALK"  , "narrator": "つばめ", "text": "忘れてない。\nちゃんと覚えてるよ。"},
        { "location": "193/TALK"  , "narrator": "つばめ", "text": "神楽ちゃんに\n攻撃されたことも――"},
        { "location": "194/TALK"  , "narrator": "つばめ", "text": "神楽ちゃんが…、\nずっと何かに苦しんで\nいたことも…。"},
        { "location": "195/TALK"  , "narrator": "つばめ", "text": "わたし、全部見てきた。\n神楽ちゃんのこと、\nちゃんと見てきたから。"},
        { "location": "196/TALK"  , "narrator": "つばめ", "text": "だからわかるの。\n神楽ちゃんは、裏切ったり\nなんかしてない、って。"},
        { "location": "197/TALK"  , "narrator": "雛", "text": "でも、実際管理庁の人達と\n行っちゃったんでしょ？"},
        { "location": "198/TALK"  , "narrator": "雛", "text": "つばめちゃんや、\nみんなにも攻撃したのに？"},
        { "location": "199/TALK"  , "narrator": "つばめ", "text": "事情があるんだよ！"},
        { "location": "200/TALK"  , "narrator": "つばめ", "text": "きっと、どうしても\nわたし達を裏切らないと\nいけない事情が…。"},
        { "location": "201/TALK"  , "narrator": "雛", "text": "いや、事情って…。"},
        { "location": "202/TALK"  , "narrator": "つばめ", "text": "誰かを人質に取られてる\nとか、何か秘密を握られ\nてるとか…。"},
        { "location": "203/TALK"  , "narrator": "雛", "text": "ちょ、何それ！？\nいくらなんでも\nぶっ飛び過ぎだよ！"},
        { "location": "204/TALK"  , "narrator": "繭", "text": "その可能性は皆無に近い。"},
        { "location": "205/TALK"  , "narrator": "つばめ", "text": "けど、\nゼロじゃないでしょ！？"},
        { "location": "206/TALK"  , "narrator": "つばめ", "text": "なら、わたしは\n神楽ちゃんを信じるよ。"},
        { "location": "207/TALK"  , "narrator": "つばめ", "text": "やりたくないけど、\n仕方ないからやってるん\nだと思う。"},
        { "location": "208/TALK"  , "narrator": "つばめ", "text": "だからあんなに苦しんで、\n自暴自棄になって…。"},
        { "location": "209/TALK"  , "narrator": "繭", "text": "…………。"},
        { "location": "211/TALK"  , "narrator": "つばめ", "text": "絶対そうだよ…。\n神楽ちゃんは、\n裏切ったりしてないよ…。"},
        { "location": "212/TALK"  , "narrator": "つばめ", "text": "…みんなは、神楽ちゃんを\n裏切り者とか…敵とか、\n酷いこと沢山言ってる。"},
        { "location": "213/TALK"  , "narrator": "つばめ", "text": "けど、お願い。\n二人には、そんな風には\n思ってほしくないの。"},
        { "location": "214/TALK"  , "narrator": "雛", "text": "で、でも…。"},
        { "location": "216/TALK"  , "narrator": "つばめ", "text": "お願い、お願いします。"},
        { "location": "217/TALK"  , "narrator": "つばめ", "text": "わたしのこと、少しでも\n信じてくれてるなら――"},
        { "location": "218/TALK"  , "narrator": "つばめ", "text": "神楽ちゃんのことも、\nちょっとでいいから\n信じてあげて！"},
        { "location": "220/TALK"  , "narrator": "雛", "text": "…………。"},
        { "location": "221/TALK"  , "narrator": "繭", "text": "…………。"},
        { "location": "222/TALK"  , "narrator": "つばめ", "text": "お願い！"},
        { "location": "224/TALK"  , "narrator": "雛", "text": "はぁ…。"},
        { "location": "225/TALK"  , "narrator": "雛", "text": "つばめちゃんって…、\nどんなことがあっても\nつばめちゃんだね…。"},
        { "location": "226/TALK"  , "narrator": "つばめ", "text": "…え？"},
        { "location": "228/TALK"  , "narrator": "雛", "text": "いや、普通はこういう時、\nあいつ絶対許せない、って\n怒るとこでしょ？"},
        { "location": "229/TALK"  , "narrator": "雛", "text": "なのに、まさか全力で\n庇うなんて…。"},
        { "location": "230/TALK"  , "narrator": "つばめ", "text": "…変、かな？"},
        { "location": "231/TALK"  , "narrator": "繭", "text": "変。"},
        { "location": "234/TALK"  , "narrator": "つばめ", "text": "うう…。"},
        { "location": "235/TALK"  , "narrator": "繭", "text": "でも、逢瀬さんらしい。\n甘いと思うけど、\n嫌いじゃないわ。"},
        { "location": "236/TALK"  , "narrator": "雛", "text": "第一、つばめちゃんが\n誰かを悪く言うところ、\n想像できなかったし。"},
        { "location": "237/TALK"  , "narrator": "雛", "text": "どんな悪い人でも\n庇っちゃうのが\nつばめちゃんだもんね。"},
        { "location": "239/TALK"  , "narrator": "つばめ", "text": "そ、そうかな？"},
        { "location": "240/TALK"  , "narrator": "雛", "text": "そうだよ。"},
        { "location": "241/TALK"  , "narrator": "雛", "text": "つばめちゃんの\nそういうところ、\nスゴいと思うよ。"},
        { "location": "242/TALK"  , "narrator": "雛", "text": "かっこいいなー、とも\nちょっと思う。"},
        { "location": "243/TALK"  , "narrator": "雛", "text": "だから…つばめちゃんが\nそう言うなら、あたしも\n信じるよ。"},
        { "location": "244/TALK"  , "narrator": "雛", "text": "神楽ちゃんには\n何か事情があったんだ、\nって。"},
        { "location": "245/TALK"  , "narrator": "繭", "text": "…不本意ではあるけど、\n私も信じるわ。"},
        { "location": "248/TALK"  , "narrator": "つばめ", "text": "…ほんとう？"},
        { "location": "249/TALK"  , "narrator": "雛", "text": "もちろん。"},
        { "location": "251/TALK"  , "narrator": "雛", "text": "…でも、つばめちゃんを\n傷つけたことに関しては、\n許さないけどねー。"},
        { "location": "252/TALK"  , "narrator": "繭", "text": "当然。\nただ許すのは無理。\n代償は支払ってもらう。"},
        { "location": "253/TALK"  , "narrator": "つばめ", "text": "で、でも、神楽ちゃんは！"},
        { "location": "254/TALK"  , "narrator": "雛", "text": "どんな事情があっても、\nつばめちゃんを傷つけた\n事実は変わらないよ。"},
        { "location": "255/TALK"  , "narrator": "雛", "text": "だから、今度会ったら\nそのことは超怒るよ。"},
        { "location": "256/TALK"  , "narrator": "雛", "text": "あたしの友達に\nなんてことするんだ！\nふざけるな、って…。"},
        { "location": "257/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "258/TALK"  , "narrator": "雛", "text": "でも、怒るだけ怒ったら、\nもうおしまい。"},
        { "location": "259/TALK"  , "narrator": "雛", "text": "あとは、つばめちゃんの\n望む通り、友達に戻る\n努力をするよー。"},
        { "location": "260/TALK"  , "narrator": "繭", "text": "…逢瀬さんが許す以上、\n私達が怒り続けるのも\nおかしいし。"},
        { "location": "261/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "262/TALK"  , "narrator": "雛", "text": "今すぐに許すって\n約束はできない。"},
        { "location": "263/TALK"  , "narrator": "雛", "text": "でも…また四人で、\n遊んだりお買い物行ったり\nしたいと思うから。"},
        { "location": "264/TALK"  , "narrator": "雛", "text": "あたしも、精一杯努力して\n友達に戻れるよう頑張る。"},
        { "location": "265/TALK"  , "narrator": "雛", "text": "だから、とりあえず\n今はそれで\n納得してもらいたいなー？"},
        { "location": "266/TALK"  , "narrator": "つばめ", "text": "…うん。"},
        { "location": "268/TALK"  , "narrator": "つばめ", "text": "ありがとう…。\nごめんね…、\nワガママ言って…。"},
        { "location": "270/TALK"  , "narrator": "雛", "text": "ま、つばめちゃんの\n友達やってるんだもん。\n覚悟はしてるってー。"},
        { "location": "271/TALK"  , "narrator": "繭", "text": "子供はワガママを\n言うものだから。"},
        { "location": "272/TALK"  , "narrator": "つばめ", "text": "こ、子供って…、\n同い年なのにぃ…。"},
        { "location": "273/TALK"  , "narrator": "雛", "text": "あはは、まあいいじゃん。\nチャームポイントだと\n思うしー。"},
        { "location": "274/TALK"  , "narrator": "雛", "text": "とにかくさ、あたし達は\nつばめちゃんのこと\n応援してるよ。"},
        { "location": "275/TALK"  , "narrator": "雛", "text": "だから、神楽ちゃんのこと\nちゃんと説得して、\n帰ってこさせてね。"},
        { "location": "276/TALK"  , "narrator": "雛", "text": "じゃなきゃ、あたし達も\n怒れないんだから。"},
