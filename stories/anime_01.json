{
    "dir": "chap01/daydra/anime_01.js",
    "type": "MainStory",
    "info": {
        "story_id": "1101",
        "cid": "tsubame",
        "title": "001 アニメーション",
        "sub_title": "つばめの紹介"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "アニメ第01～04話"},
        { "location": "48/TALK"   , "narrator": "千羽鶴", "text": "ようこそ。\n逢瀬つばめの\nステージへ。"},
        { "location": "50/TALK"   , "narrator": "千羽鶴", "text": "それじゃまずは、\n逢瀬つばめの\nおさらいから。"},
        { "location": "52/TALK"   , "narrator": "千羽鶴", "text": "ここから先は、\nそれぞれの少女ごとに\nチャンネルが分かれる。"},
        { "location": "53/TALK"   , "narrator": "千羽鶴", "text": "同じ空間で同じ事象を\n体験していても、感じ\n方や想いは様々。"},
        { "location": "54/TALK"   , "narrator": "千羽鶴", "text": "だから、貴方の彼女たち\nへのサポートもまた、\n様々なものになるはず。"},
        { "location": "55/TALK"   , "narrator": "千羽鶴", "text": "貴方には１００％の力で\n彼女を深くサポートして\n欲しいから――"},
        { "location": "56/TALK"   , "narrator": "千羽鶴", "text": "この恋愛ゲームでは、\n各彼女ごとに別チャン\nネルになってる。"},
        { "location": "57/TALK"   , "narrator": "千羽鶴", "text": "ところで――"},
        { "location": "58/TALK"   , "narrator": "千羽鶴", "text": "$handle$は、\n逢瀬つばめを一番に\n選んだ。それはなぜ？"},
        { "location": "59/SEL"    , "narrator": "", "text": "彼女を支えたいから"},
        { "location": "60/SEL"    , "narrator": "", "text": "何となく"},
        { "location": "61/ACT"    , "narrator": "", "text": "彼女を支えたいから"},
        { "location": "62/TALK"   , "narrator": "千羽鶴", "text": "そう。\nとてもいい返答。"},
        { "location": "63/ACT"    , "narrator": "", "text": "何となく"},
        { "location": "64/TALK"   , "narrator": "千羽鶴", "text": "そう。まあ、\nそういう事もある。"},
        { "location": "65/TALK"   , "narrator": "千羽鶴", "text": "でも、彼女と接してみて\n自分向きじゃないと\n感じたら――"},
        { "location": "66/TALK"   , "narrator": "千羽鶴", "text": "無理につき合う\n必要は無いから。"},
        { "location": "67/TALK"   , "narrator": "千羽鶴", "text": "あまり気負わずに\nプレイしてみて。"},
        { "location": "68/TALK"   , "narrator": "千羽鶴", "text": "それじゃまずは、\n逢瀬つばめについて\n今一度おさらいをする。"},
        { "location": "79/TALK"   , "narrator": "千羽鶴", "text": "[逢瀬つばめ]。\nとても素直で楽観思考の\n着やせするタイプ。"},
        { "location": "80/TALK"   , "narrator": "千羽鶴", "text": "彼女は、先に紹介してる\nとおり、あなたの攻略\n対象の一人。"},
        { "location": "83/TALK"   , "narrator": "千羽鶴", "text": "さて、バックに映し出され\nている彼女の写真は、\n入隊後の彼女のもの。"},
        { "location": "84/TALK"   , "narrator": "千羽鶴", "text": "現時点ではまだ入隊して\nいないから、望むべく\n未来の写真という事になる。"},
        { "location": "85/SEL"    , "narrator": "", "text": "でも、映像を見た限りでは死んでませんでしたか…？"},
        { "location": "86/ACT"    , "narrator": "", "text": "でも、映像を見た限りでは死んでませんでしたか…？"},
        { "location": "89/TALK"   , "narrator": "千羽鶴", "text": "そうね。"},
        { "location": "90/SEL"    , "narrator": "", "text": "それとも死んでない？"},
        { "location": "91/SEL"    , "narrator": "", "text": "やっぱりご都合主義なんでしょ？"},
        { "location": "92/ACT"    , "narrator": "", "text": "それとも死んでない？"},
        { "location": "93/TALK"   , "narrator": "千羽鶴", "text": "どうかしら。"},
        { "location": "97/TALK"   , "narrator": "千羽鶴", "text": "……まあ、今回は仕方ない。\n背に腹は替えられない。"},
        { "location": "98/TALK"   , "narrator": "千羽鶴", "text": "貴方に全幅の信頼をおいて\n言うならば――"},
        { "location": "99/TALK"   , "narrator": "千羽鶴", "text": "逢瀬つばめは\nまだ助かる見込みがある。"},
        { "location": "100/ACT"   , "narrator": "", "text": "やっぱりご都合主義なんでしょ？"},
        { "location": "101/TALK"  , "narrator": "千羽鶴", "text": "史実は小説より奇なり。"},
        { "location": "102/TALK"  , "narrator": "千羽鶴", "text": "現実には物語よりもよほど\n多くのご都合主義的展開が\nある。"},
        { "location": "103/TALK"  , "narrator": "千羽鶴", "text": "でもそれをご都合主義と\n言う人はいない。\nでは何というのか。"},
        { "location": "106/TALK"  , "narrator": "千羽鶴", "text": "人はそれを\n「奇跡」という。"},
        { "location": "107/SEL"   , "narrator": "", "text": "それって「生きてる」って暗に言ってない？"},
        { "location": "108/SEL"   , "narrator": "", "text": "ネタバレですよね…"},
        { "location": "109/ACT"   , "narrator": "", "text": "それって「生きてる」って暗に言ってない？"},
        { "location": "110/ACT"   , "narrator": "", "text": "ネタバレですよね…"},
        { "location": "112/TALK"  , "narrator": "千羽鶴", "text": "……そうね。\nまあでも。"},
        { "location": "113/TALK"  , "narrator": "千羽鶴", "text": "きょうび、「死んだと\n思ったら生きていた」\nなんてこと沢山ある。"},
        { "location": "114/TALK"  , "narrator": "千羽鶴", "text": "貴方もそんなこと言って、\n裏では「絶対生きてるな」\nと思っていたでしょう？"},
        { "location": "115/TALK"  , "narrator": "千羽鶴", "text": "ネタバレにもならない\n要素だと思わない？"},
        { "location": "116/SEL"   , "narrator": "", "text": "すごい開き直りだ"},
        { "location": "117/ACT"   , "narrator": "", "text": "すごい開き直りだ"},
        { "location": "119/TALK"  , "narrator": "千羽鶴", "text": "はい、無駄話せず\n先へ進む！"},
        { "location": "122/TALK"  , "narrator": "千羽鶴", "text": "映像で彼女は東京に行き、\n大好きなアーティストの\nライブを見ている。"},
        { "location": "123/TALK"  , "narrator": "千羽鶴", "text": "けど、その前日の夜、\n彼女の家にちょっとした\n出来事があった。"},
        { "location": "124/TALK"  , "narrator": "千羽鶴", "text": "それがきっかけで、彼女は\nずっと楽しみにしていた\nライブを諦めかけていた。"},
        { "location": "128/TALK"  , "narrator": "千羽鶴", "text": "そして、\nもう分かってると思うけど\nここで貴方の出番。"},
        { "location": "129/TALK"  , "narrator": "千羽鶴", "text": "彼女に対してもまた、\nココロをサポートして\n解決に導いてあげて欲しい。"},
        { "location": "132/TALK"  , "narrator": "千羽鶴", "text": "そして、\nもう分かってると思うけど\nここで貴方の出番。"},
        { "location": "133/TALK"  , "narrator": "千羽鶴", "text": "彼女に対してもまた、\nココロをサポートして\n解決に導いてあげて欲しい。"},
        { "location": "134/SEL"   , "narrator": "", "text": "これで３人目なんだけど、みんな何か問題を抱えて戦っていたってこと？"},
        { "location": "135/ACT"   , "narrator": "", "text": "これで３人目なんだけど、みんな何か問題を抱えて戦っていたってこと？"},
        { "location": "137/TALK"  , "narrator": "千羽鶴", "text": "逆に聞きたい。"},
        { "location": "138/TALK"  , "narrator": "千羽鶴", "text": "生死を賭けた戦闘において\n一度も問題が発生しない\nことなんてどれ程あるか。"},
        { "location": "139/TALK"  , "narrator": "千羽鶴", "text": "記録映像にはその全てを\n記録することはできない。"},
        { "location": "140/TALK"  , "narrator": "千羽鶴", "text": "映像に記録されているだけ\nでも色々な問題は起きて\nいるけど――"},
        { "location": "141/TALK"  , "narrator": "千羽鶴", "text": "実際にはそれ以上に色々な\n問題や危機を、彼女達は\n沢山抱えている。"},
        { "location": "142/TALK"  , "narrator": "千羽鶴", "text": "それでも彼女達は、\n今までそれを自分で\n解決して乗り切ってきた。"},
        { "location": "143/TALK"  , "narrator": "千羽鶴", "text": "けど年端もいかない少女が\n毎回の死闘で、問題を解決\nし続けるには無理がある。"},
        { "location": "144/TALK"  , "narrator": "千羽鶴", "text": "だから私は、貴方に\n助けを求めているの。"},
        { "location": "145/TALK"  , "narrator": "千羽鶴", "text": "わかった？"},
        { "location": "146/SEL"   , "narrator": "", "text": "わかった"},
        { "location": "147/SEL"   , "narrator": "", "text": "まだよくわからない"},
        { "location": "148/ACT"   , "narrator": "", "text": "わかった"},
        { "location": "149/TALK"  , "narrator": "千羽鶴", "text": "オッケー。"},
        { "location": "150/TALK"  , "narrator": "千羽鶴", "text": "今回もまた、\n素晴らしいココロの\nサポートを期待してる。"},
        { "location": "151/ACT"   , "narrator": "", "text": "まだよくわからない"},
        { "location": "152/TALK"  , "narrator": "千羽鶴", "text": "焦らなくてもいい。\nそのうち何かのきっかけで\nわかるかもしれない。"},
        { "location": "153/TALK"  , "narrator": "千羽鶴", "text": "それでもわからなければ、\n途中でやめてもらっても\n構わない。"},
        { "location": "154/TALK"  , "narrator": "千羽鶴", "text": "私には貴方を強制する力も\n権限も無いから。"},
        { "location": "155/TALK"  , "narrator": "千羽鶴", "text": "とにかく、今回だけは\n是非とも頑張って欲しい。"},
        { "location": "156/TALK"  , "narrator": "千羽鶴", "text": "素晴らしいココロの\nサポートを期待してる。"},
        { "location": "160/SEL"   , "narrator": "", "text": "で、それを解決したのが$me$ってこと？"},
        { "location": "161/ACT"   , "narrator": "", "text": "で、それを解決したのが$me$ってこと？"},
        { "location": "164/TALK"  , "narrator": "千羽鶴", "text": "その通り。\nそして貴方にとっては\nこれから成すべきこと。"},
        { "location": "165/TALK"  , "narrator": "千羽鶴", "text": "彼女に対してもまた、\nココロをサポートして\n解決に導いてあげて欲しい。"},
        { "location": "168/SEL"   , "narrator": "", "text": "そうだったんだ！"},
        { "location": "169/ACT"   , "narrator": "", "text": "そうだったんだ！"},
        { "location": "171/TALK"  , "narrator": "千羽鶴", "text": "そうだったの。"},
        { "location": "172/TALK"  , "narrator": "千羽鶴", "text": "そして、\nそれを解決したのが貴方。"},
        { "location": "173/SEL"   , "narrator": "", "text": "いえ、何もやってませんが。"},
        { "location": "174/ACT"   , "narrator": "", "text": "いえ、何もやってませんが。"},
        { "location": "177/TALK"  , "narrator": "千羽鶴", "text": "そうね。\nだって、これから\nやってもらうのだから。"},
        { "location": "178/SEL"   , "narrator": "", "text": "意味がわかりません"},
        { "location": "179/ACT"   , "narrator": "", "text": "意味がわかりません"},
        { "location": "181/TALK"  , "narrator": "千羽鶴", "text": "貴方には、私たちの世界の\n時間を、未来へ過去へと\n自在に移動する力がある。"},
        { "location": "182/TALK"  , "narrator": "千羽鶴", "text": "貴方には、\nこのエピソードで\n逢瀬つばめをサポートし――"},
        { "location": "183/TALK"  , "narrator": "千羽鶴", "text": "記録動画の通りに\n歴史が進むように、\n頑張ってもらう。"},
        { "location": "184/TALK"  , "narrator": "千羽鶴", "text": "いい？"},
        { "location": "185/SEL"   , "narrator": "", "text": "オッケー！"},
        { "location": "186/SEL"   , "narrator": "", "text": "それって歴史改変では！？"},
        { "location": "187/SEL"   , "narrator": "", "text": "いやです！"},
        { "location": "188/ACT"   , "narrator": "", "text": "オッケー！"},
        { "location": "191/ACT"   , "narrator": "", "text": "それって歴史改変では！？"},
        { "location": "192/TALK"  , "narrator": "千羽鶴", "text": "んー。\nそれはちょっと違う。"},
        { "location": "193/TALK"  , "narrator": "千羽鶴", "text": "まあ今は難しい事は\n考えず、彼女とイチャラブ\nする事に専念して。"},
        { "location": "194/ACT"   , "narrator": "", "text": "いやです！"},
        { "location": "195/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "196/TALK"  , "narrator": "千羽鶴", "text": "じゃあ今すぐに\n別の彼女のチャンネルに\n切り替えた方がいい。"},
        { "location": "201/TALK"  , "narrator": "千羽鶴", "text": "それじゃ、\n健闘を祈ってる。"},
        { "location": "203/TALK"  , "narrator": "千羽鶴", "text": "…っと。\nそう、一応念のため――"},
        { "location": "204/TALK"  , "narrator": "千羽鶴", "text": "彼女が現場に急行する\n前後の映像を編集して\n用意してあるけど、見る？"},
        { "location": "205/SEL"   , "narrator": "", "text": "見る"},
        { "location": "206/SEL"   , "narrator": "", "text": "見なくて平気"},
        { "location": "207/ACT"   , "narrator": "", "text": "見る"},
        { "location": "208/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "209/TALK"  , "narrator": "千羽鶴", "text": "映像は逢瀬つばめが上京する\nところから、國政綾水が\nドームに到着するまで。"},
        { "location": "210/TALK"  , "narrator": "千羽鶴", "text": "ストリーミングで\n配信するから、\n回線が細い人は要注意。"},
        { "location": "211/TALK"  , "narrator": "千羽鶴", "text": "そんな人の為に、\n<color=green>あらすじレポート</color>も\n用意してある。"},
        { "location": "212/TALK"  , "narrator": "千羽鶴", "text": "回線種別と相談しつつ、\n映像にするか、レポート\nにするか決めて欲しい。"},
        { "location": "213/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/68MB 4:30】</color>"},
        { "location": "214/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/26MB 4:30】</color>"},
        { "location": "215/SEL"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "216/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/68MB 4:30】</color>"},
        { "location": "217/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "223/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/26MB 4:30】</color>"},
        { "location": "224/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "230/ACT"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "231/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "232/TALK"  , "narrator": "千羽鶴", "text": "残念だけど、いろいろ\n事情があってのことだと\n思うから。"},
        { "location": "233/TALK"  , "narrator": "千羽鶴", "text": "家に帰ったら、是非\n映像記録の方も\n見てみて欲しい。"},
        { "location": "234/TALK"  , "narrator": "千羽鶴", "text": "それではどうぞ。"},
        { "location": "249/TALK"  , "narrator": "千羽鶴", "text": "どう？\nどういう状況だったか\n思い出せた？"},
        { "location": "250/TALK"  , "narrator": "千羽鶴", "text": "是非、逢瀬つばめの\nココロを落ち着かせて――"},
        { "location": "251/TALK"  , "narrator": "千羽鶴", "text": "この映像のように、\n東京に行きたいと\n思わせて欲しい。"},
        { "location": "253/ACT"   , "narrator": "", "text": "見なくて平気"},
        { "location": "254/TALK"  , "narrator": "千羽鶴", "text": "そう、わかった。"},
        { "location": "255/TALK"  , "narrator": "千羽鶴", "text": "是非逢瀬つばめのココロを\n落ち着かせて、東京に\n行こうと思わせて欲しい。"},
        { "location": "268/TALK"  , "narrator": "千羽鶴", "text": "どう？\nどういう状況だったか\n思い出せた？"},
        { "location": "269/TALK"  , "narrator": "千羽鶴", "text": "是非、逢瀬つばめの\nココロを落ち着かせて――"},
        { "location": "270/TALK"  , "narrator": "千羽鶴", "text": "この映像のように、\n東京に行きたいと\n思わせて欲しい。"},
        { "location": "241/DIALOG", "narrator": "Tutorial/Dialog_Anime1", "text": "逢瀬つばめは、大好きなアーティスト\nFreyMENOWのライブを見に\n東京へ向かった。\n\nだが、そこで歌うFreyMENOWの歌を\n聞いた途端、つばめは頭が割れそうな\n程の頭痛に襲われてしまう。\n\nその頭痛が過ぎた後、会場を見渡せば\n既にそこはライブ会場では無かった。\nそこは古代ローマ帝国を彷彿とさせる\nコロッセオの中。\n\nその中心でFreyMENOWは檻に\n入れられ、その檻の前には女騎士が\n佇んでいた。\n\nつばめがその女騎士を見ると、\n女騎士もまた、つばめを睨みつける。\n\n<b><color=red>「え？わたし、睨まれてる！？」</color></b>\n\n\n外ではライブ会場を\n謎の繭【フェノメノン】が包み込み、\n辺りは騒然としていた。\n"}
    ]
}
