        "title": "らぶとーく  第24話",
        "sub_title": "使用人として"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "使用人として"},
        { "location": "26/TALK"   , "narrator": "つばめ", "text": "美味しい！\nやっぱり思った通り\nです。"},
        { "location": "27/TALK"   , "narrator": "つばめ", "text": "テレビで見て\n美味しそうだなぁ、って\n思ってたんですよ。"},
        { "location": "29/TALK"   , "narrator": "みやび", "text": "良かったね。\nようやっと食べられて。"},
        { "location": "32/TALK"   , "narrator": "つばめ", "text": "はい！"},
        { "location": "34/TALK"   , "narrator": "アーヤ", "text": "それにしても、\nいいお店ね。"},
        { "location": "35/TALK"   , "narrator": "アーヤ", "text": "覚えておいて、\nまた近くに来たとき\n入ろうかしら？"},
        { "location": "39/TALK"   , "narrator": "つばめ", "text": "ガブちゃん、ありがと。\n一緒に来てくれて。"},
        { "location": "41/TALK"   , "narrator": "ガブリエラ", "text": "…っていうか、どうして\nあたしまで来なきゃ\nいけないのよ？"},
        { "location": "42/TALK"   , "narrator": "ガブリエラ", "text": "店の場所は知ってるん\nだから、つばめ達だけ\nでも来れたでしょ？"},
        { "location": "44/TALK"   , "narrator": "つばめ", "text": "それはそうだけど。"},
        { "location": "45/TALK"   , "narrator": "つばめ", "text": "みんなで来た方が\n楽しいんじゃないかな、\nって思って。"},
        { "location": "46/TALK"   , "narrator": "つばめ", "text": "だから、ガブちゃんにも\n来て欲しかったの。"},
        { "location": "48/TALK"   , "narrator": "ガブリエラ", "text": "いや、つばめはそう思う\nかもしれないけど。"},
        { "location": "51/TALK"   , "narrator": "ガブリエラ", "text": "あたしは別に\nそんなに興味\nなかったし。"},
        { "location": "53/TALK"   , "narrator": "アーヤ", "text": "その割には\n気に入ってる\nみたいだけど？"},
        { "location": "54/TALK"   , "narrator": "みやび", "text": "あれよ。"},
        { "location": "55/TALK"   , "narrator": "みやび", "text": "本当はガブちゃんは\n一緒に来たい人が\nおるがで。"},
        { "location": "58/TALK"   , "narrator": "つばめ", "text": "えっ？\nそうなんですか！？"},
        { "location": "60/TALK"   , "narrator": "みやび", "text": "そうよ。\nけんど言い出せん。"},
        { "location": "61/TALK"   , "narrator": "みやび", "text": "まっこと\nガブちゃんは\nかわいいねえ。"},
        { "location": "64/TALK"   , "narrator": "ガブリエラ", "text": "ちょ、ちょっとみやび！\nつばめも！　そんな人\nいないから！"},
        { "location": "65/TALK"   , "narrator": "アーヤ", "text": "あら、そうなの？"},
        { "location": "66/TALK"   , "narrator": "ガブリエラ", "text": "い、いないったら！"},
        { "location": "74/TALK"   , "narrator": "ガブリエラ", "text": "ねえ、$handle$"},
        { "location": "75/TALK"   , "narrator": "ガブリエラ", "text": "この話を止めたいんだけど、どうすればいいと思う？"},
        { "location": "77/SEL"    , "narrator": "", "text": "怒るべきだろう"},
        { "location": "78/SEL"    , "narrator": "", "text": "お礼を言えば"},
        { "location": "79/SEL"    , "narrator": "", "text": "のろけてみれば"},
        { "location": "80/ACT"    , "narrator": "", "text": "怒るべきだろう"},
        { "location": "81/TALK"   , "narrator": "ガブリエラ", "text": "…やっぱり、それしかないわよね"},
        { "location": "87/TALK"   , "narrator": "ガブリエラ", "text": "…でも、ここではあまり\n怒りたくないような…。"},
        { "location": "88/TALK"   , "narrator": "ガブリエラ", "text": "っていうか、いつもなら\nもっと早い段階で怒って\nるはずなのに…。"},
        { "location": "90/TALK"   , "narrator": "アーヤ", "text": "ふふ。\nうまくいくと\nいいわね。"},
        { "location": "93/TALK"   , "narrator": "つばめ", "text": "あっ！\nもしかして\n恋の話ですか？"},
        { "location": "95/TALK"   , "narrator": "ガブリエラ", "text": "なっ！？"},
        { "location": "98/TALK"   , "narrator": "ガブリエラ", "text": "何言ってんのよ！\nそんな話全然\nないわよ！？"},
        { "location": "100/TALK"  , "narrator": "つばめ", "text": "そうなんですか……。"},
        { "location": "101/TALK"  , "narrator": "ガブリエラ", "text": "そうよ！"},
        { "location": "104/TALK"  , "narrator": "ガブリエラ", "text": "それにか、仮に、\nそうだった\nとしても！"},
        { "location": "106/TALK"  , "narrator": "ガブリエラ", "text": "そんなこと、他人に\n決めつけられたく\nないわ。"},
        { "location": "107/TALK"  , "narrator": "ガブリエラ", "text": "あたしのことで、\n勝手なこと言わないで！"},
        { "location": "109/TALK"  , "narrator": "アーヤ", "text": "もぉ、ギャヴィ。\nそれくらいにしたら？"},
        { "location": "111/TALK"  , "narrator": "ガブリエラ", "text": "何であたしなのよ？"},
        { "location": "112/TALK"  , "narrator": "ガブリエラ", "text": "怒らせるようなこと\n言ったのは、つばめ達\nじゃない。"},
        { "location": "114/TALK"  , "narrator": "アーヤ", "text": "そうかもしれないけど、\nあなたも落ち着きなさい\nって。"},
        { "location": "115/TALK"  , "narrator": "アーヤ", "text": "そんなに怒ってたら、\n美味しいデザートが\n台無しよ？"},
        { "location": "117/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "120/TALK"  , "narrator": "つばめ", "text": "そ、そうですね。\nほら、ガブちゃん。\n早く食べよ。"},
        { "location": "122/TALK"  , "narrator": "みやび", "text": "もうこの話はせんき、\n機嫌直しぃ。"},
        { "location": "124/TALK"  , "narrator": "ガブリエラ", "text": "…ふんっ。"},
        { "location": "125/ACT"   , "narrator": "", "text": "お礼を言えば"},
        { "location": "126/TALK"  , "narrator": "ガブリエラ", "text": "何でそうなるのよ？"},
        { "location": "127/TALK"  , "narrator": "ガブリエラ", "text": "私が言ったこと、ちゃんと聞いてたの？"},
        { "location": "128/TALK"  , "narrator": "ガブリエラ", "text": "まったく、使用人のクセに使えないわね"},
        { "location": "130/SEL"   , "narrator": "", "text": "ヒカルと仲良くなれるかもよ"},
        { "location": "131/ACT"   , "narrator": "", "text": "ヒカルと仲良くなれるかもよ"},
        { "location": "133/TALK"  , "narrator": "ガブリエラ", "text": "えっ///////////////"},
        { "location": "134/TALK"  , "narrator": "ガブリエラ", "text": "そんな都合のいいことあるのかしら//////"},
        { "location": "135/TALK"  , "narrator": "ガブリエラ", "text": "それに別にまだ何にもしてもらってないし"},
        { "location": "136/TALK"  , "narrator": "ガブリエラ", "text": "それなのにお礼なんて…"},
        { "location": "138/SEL"   , "narrator": "", "text": "言った方がいいと思うな"},
        { "location": "139/ACT"   , "narrator": "", "text": "言った方がいいと思うな"},
        { "location": "141/TALK"  , "narrator": "ガブリエラ", "text": "…じゃあ、百歩譲って"},
        { "location": "142/TALK"  , "narrator": "ガブリエラ", "text": "ここに来るのに付き合ってあげたことに対して、みんなが私にお礼を言ったら"},
        { "location": "143/TALK"  , "narrator": "ガブリエラ", "text": "私もお礼を返すことにするわ"},
        { "location": "151/TALK"  , "narrator": "アーヤ", "text": "一緒に来たい人って\n誰なのか\n聞いてもいい？"},
        { "location": "153/TALK"  , "narrator": "ガブリエラ", "text": "い、いないったら！"},
        { "location": "154/TALK"  , "narrator": "ガブリエラ", "text": "いないから\nこうやってみんなと\n来たんでしょ？"},
        { "location": "156/TALK"  , "narrator": "みやび", "text": "うんうん。\nみんなでな。"},
        { "location": "159/TALK"  , "narrator": "ガブリエラ", "text": "…何よ、お礼でも\n言ってもらいたいわけ？"},
        { "location": "160/TALK"  , "narrator": "みやび", "text": "そんなつもりは\nないけんど。"},
        { "location": "161/TALK"  , "narrator": "みやび", "text": "ガブちゃんが言いたい\nいうなら、喜んで\n聞かせてもらうちや。"},
        { "location": "164/TALK"  , "narrator": "ガブリエラ", "text": "言ってほしいなら、\nとりあえずあんた達から\n先にお礼を言いなさい。"},
        { "location": "165/TALK"  , "narrator": "ガブリエラ", "text": "ここに来るの\nわざわざ付き合って\nあげたんだから。"},
        { "location": "166/TALK"  , "narrator": "ガブリエラ", "text": "そのことのお礼を\n言ってくれたら、\nあたしも言うわ。"},
        { "location": "167/TALK"  , "narrator": "みやび", "text": "…マジか？"},
        { "location": "168/TALK"  , "narrator": "ガブリエラ", "text": "何よ？\nあたしがウソついてる\nっていうの！？"},
        { "location": "169/TALK"  , "narrator": "みやび", "text": "それは疑っちょらん\nけんど。"},
        { "location": "170/TALK"  , "narrator": "みやび", "text": "本命に\nとっといた方が\nえいと思うぞね。"},
        { "location": "173/TALK"  , "narrator": "アーヤ", "text": "そうね。"},
        { "location": "174/TALK"  , "narrator": "アーヤ", "text": "好きな相手には\n素直にならなきゃ。"},
        { "location": "176/TALK"  , "narrator": "ガブリエラ", "text": "なっ！？\n何でそうなるのよ！！"},
        { "location": "177/TALK"  , "narrator": "アーヤ", "text": "だって、ちゃんと\n言わないと\n伝わらないもの。"},
        { "location": "180/TALK"  , "narrator": "つばめ", "text": "そうですよね…。"},
        { "location": "181/TALK"  , "narrator": "みやび", "text": "そうそう。\n素直が一番ぞね。"},
        { "location": "182/TALK"  , "narrator": "ガブリエラ", "text": "好きな人なんて\nいないって\n言ってるでしょ！？"},
        { "location": "186/TALK"  , "narrator": "つばめ", "text": "それはちょっと\n残念…。"},
        { "location": "188/TALK"  , "narrator": "ガブリエラ", "text": "うるさい！\nもうこの話おしまい！"},
        { "location": "189/ACT"   , "narrator": "", "text": "のろけてみれば"},
        { "location": "191/TALK"  , "narrator": "ガブリエラ", "text": "なっ！？"},
        { "location": "192/TALK"  , "narrator": "ガブリエラ", "text": "どうしてそうなるのよ！"},
        { "location": "193/TALK"  , "narrator": "ガブリエラ", "text": "大体、のろけるようなことなんてないわ"},
        { "location": "194/TALK"  , "narrator": "ガブリエラ", "text": "あたしとヒカルくんは、そういう関係じゃないんだし"},
        { "location": "195/TALK"  , "narrator": "ガブリエラ", "text": "$handle$だって知ってるでしょ？"},
        { "location": "203/TALK"  , "narrator": "アーヤ", "text": "…ふふっ。\nまんざらでもない\nみたいね。"},
        { "location": "205/TALK"  , "narrator": "ガブリエラ", "text": "…えっ？\nな、何よ、人の顔\nジロジロ見て…。"},
        { "location": "209/TALK"  , "narrator": "つばめ", "text": "ガブちゃん、\n顔真っ赤だよ。"},
        { "location": "210/TALK"  , "narrator": "つばめ", "text": "やっぱり\n好きな人が\nいるんだね。"},
        { "location": "211/TALK"  , "narrator": "ガブリエラ", "text": "は、はぁ！？\nないない！！\nいないから！！"},
        { "location": "212/TALK"  , "narrator": "みやび", "text": "けんど、少しは\n意識しとる\n感じやね？"},
        { "location": "214/TALK"  , "narrator": "ガブリエラ", "text": "いないったら！\nいないの！"},
        { "location": "215/TALK"  , "narrator": "アーヤ", "text": "ふふっ…これから\nどうなるかが楽しみね。"},
        { "location": "216/TALK"  , "narrator": "みやび", "text": "そうやね。\n上手くいってくれれば\nえいんやけんど…。"},
        { "location": "218/TALK"  , "narrator": "つばめ", "text": "応援してるよ、\nガブちゃん！"},
        { "location": "221/TALK"  , "narrator": "ガブリエラ", "text": "だから、そういうんじゃ\nないんだってば！"}
    ]
}
