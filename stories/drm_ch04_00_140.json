{
    "dir": "dramatics/daydra/drm_ch04_00_140.js",
    "type": "Episode",
    "info": {
        "story_id": "4014",
        "cid": "miyabi",
        "title": "らぶとーく 第14話",
        "sub_title": "仕切り直し"
    },
    "entry":
    [
        { "location": "118/SCENARIO", "narrator": "", "text": "仕切り直し"},
        { "location": "129/TALK"    , "narrator": "つばめ", "text": "…え？\n$handle$さんのこと\nですか？"},
        { "location": "131/TALK"    , "narrator": "みやび", "text": "そうや。"},
        { "location": "132/TALK"    , "narrator": "みやび", "text": "つばめちゃんはヤツの\nことをどう思うてるのか、\n知っておきたいんよ。"},
        { "location": "135/TALK"    , "narrator": "つばめ", "text": "どうって、うーん…。"},
        { "location": "136/TALK"    , "narrator": "つばめ", "text": "楽しい人、かな？"},
        { "location": "138/TALK"    , "narrator": "つばめ", "text": "あと、いつもお話をして\nくれたり、相談にのって\nくれたり――"},
        { "location": "139/TALK"    , "narrator": "つばめ", "text": "困ってる時に助言をくれる\n優しい人ですよね。"},
        { "location": "140/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "152/TALK"    , "narrator": "アーヤ", "text": "あのＢｏｔのことを\nどう思うか？"},
        { "location": "154/TALK"    , "narrator": "アーヤ", "text": "あ、もうＢｏｔじゃない\nのよね…。"},
        { "location": "156/TALK"    , "narrator": "みやび", "text": "いや、呼び方なんて\nどうでもえいがよ。"},
        { "location": "157/TALK"    , "narrator": "みやび", "text": "それより、アーヤは\nあいつのことを\nどう思うてるのか――"},
        { "location": "158/TALK"    , "narrator": "みやび", "text": "それを知りたいちや。"},
        { "location": "160/TALK"    , "narrator": "アーヤ", "text": "そうねぇ…。"},
        { "location": "161/TALK"    , "narrator": "アーヤ", "text": "まあ、悪人ってわけでは\nないと思うわ。"},
        { "location": "162/TALK"    , "narrator": "みやび", "text": "は！？"},
        { "location": "165/TALK"    , "narrator": "アーヤ", "text": "え？"},
        { "location": "166/TALK"    , "narrator": "みやび", "text": "…いや、続けてえいよ。"},
        { "location": "167/TALK"    , "narrator": "アーヤ", "text": "…まあ、私も楽観してる\nわけじゃないんだけど――"},
        { "location": "168/TALK"    , "narrator": "アーヤ", "text": "あのＢｏｔが私達に対して\n何かしてきてるわけじゃ\nないでしょ？"},
        { "location": "169/TALK"    , "narrator": "アーヤ", "text": "なのに、疑わしいから\n悪人って決めつけるのも、\n短絡的過ぎると思うの。"},
        { "location": "170/TALK"    , "narrator": "みやび", "text": "…つまり、アーヤは\nあいつのことを、\n嫌ってはいないが？"},
        { "location": "171/TALK"    , "narrator": "アーヤ", "text": "様子見、って感じね。\nそれがどうかしたの？"},
        { "location": "172/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "184/TALK"    , "narrator": "みやび", "text": "なあ、ガブちゃん。\nあのＢｏｔのことなんや\nけんど――"},
        { "location": "185/TALK"    , "narrator": "ガブリエラ", "text": "やめてよ！"},
        { "location": "186/TALK"    , "narrator": "ガブリエラ", "text": "その話はしたくないって、\n何度も言ってるでしょ！"},
        { "location": "188/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "200/TALK"    , "narrator": "みやび", "text": "ふぅ…。"},
        { "location": "202/TALK"    , "narrator": "みやび", "text": "結局、あいつをスパイと\n疑うてるんは、うちだけ\nやったな…。"},
        { "location": "203/TALK"    , "narrator": "みやび", "text": "まあ、それだけ怪しまれる\n発言をしとらんっちゅう\nことかもしれんけんど。"},
        { "location": "215/TALK"    , "narrator": "みやび", "text": "疑問"},
        { "location": "216/TALK"    , "narrator": "みやび", "text": "他の子達とはどんな会話してるが？"},
        { "location": "218/SEL"     , "narrator": "", "text": "普通の話"},
        { "location": "219/SEL"     , "narrator": "", "text": "秘密の話"},
        { "location": "220/SEL"     , "narrator": "", "text": "エッチな話"},
        { "location": "221/ACT"     , "narrator": "", "text": "普通の話"},
        { "location": "222/TALK"    , "narrator": "みやび", "text": "わからん"},
        { "location": "223/TALK"    , "narrator": "みやび", "text": "具体的に頼む"},
        { "location": "225/SEL"     , "narrator": "", "text": "みんなに直接聞いて"},
        { "location": "226/ACT"     , "narrator": "", "text": "みんなに直接聞いて"},
        { "location": "228/TALK"    , "narrator": "みやび", "text": "そう逃げるか"},
        { "location": "229/TALK"    , "narrator": "みやび", "text": "なるほどな"},
        { "location": "230/ACT"     , "narrator": "", "text": "秘密の話"},
        { "location": "231/TALK"    , "narrator": "みやび", "text": "困った"},
        { "location": "232/TALK"    , "narrator": "みやび", "text": "それは公表できん話やね"},
        { "location": "234/SEL"     , "narrator": "", "text": "公表したら秘密じゃなくなる"},
        { "location": "235/ACT"     , "narrator": "", "text": "公表したら秘密じゃなくなる"},
        { "location": "237/TALK"    , "narrator": "みやび", "text": "ちゅうか"},
        { "location": "238/TALK"    , "narrator": "みやび", "text": "プライバシーの侵害になりかねん"},
        { "location": "239/TALK"    , "narrator": "みやび", "text": "言わんでえいきね"},
        { "location": "240/ACT"     , "narrator": "", "text": "エッチな話"},
        { "location": "241/TALK"    , "narrator": "みやび", "text": "いや"},
        { "location": "243/TALK"    , "narrator": "みやび", "text": "うちは初心な子ばっかや"},
        { "location": "244/TALK"    , "narrator": "みやび", "text": "興味はあるかもしれんけんど"},
        { "location": "245/TALK"    , "narrator": "みやび", "text": "耐性はないき"},
        { "location": "246/TALK"    , "narrator": "みやび", "text": "みんなまともに話せんはずや"},
        { "location": "248/SEL"     , "narrator": "", "text": "やっぱりそうか"},
        { "location": "249/ACT"     , "narrator": "", "text": "やっぱりそうか"},
        { "location": "251/TALK"    , "narrator": "みやび", "text": "なに！？"},
        { "location": "252/TALK"    , "narrator": "みやび", "text": "うちから情報を引き出したやと！？"},
        { "location": "253/TALK"    , "narrator": "みやび", "text": "やはりスパイやな！！"},
        { "location": "254/TALK"    , "narrator": "みやび", "text": "まあ"},
        { "location": "255/TALK"    , "narrator": "みやび", "text": "なんの役にも立たん情報やけんど"},
        { "location": "268/TALK"    , "narrator": "みやび", "text": "…結局、何も聞きだせん\nかったか。"},
        { "location": "269/TALK"    , "narrator": "みやび", "text": "しっかし、スパイにしては\n話の逸らし方が下手っちゅ\nうか…ド素人レベル？"},
        { "location": "270/TALK"    , "narrator": "みやび", "text": "…いや、そう思わせてる\nだけいう可能性も、\nまだ捨てきれんな。"},
        { "location": "271/TALK"    , "narrator": "みやび", "text": "もうしばらく、\n警戒は怠らん方が\nえいかもしれんな…。"}
    ]
}
