{
    "dir": "chap05/daydra/anime_01_05.js",
    "type": "MainStory",
    "info": {
        "story_id": "5101",
        "cid": "tsubame",
        "title": "001 アニメーション",
        "sub_title": "PrisMATRIX."
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "アニメ第05話"},
        { "location": "47/TALK"   , "narrator": "千羽鶴", "text": "こんにちは、\n$handle$。\n如何お過ごしですか？"},
        { "location": "48/SEL"    , "narrator": "", "text": "暇してる"},
        { "location": "49/SEL"    , "narrator": "", "text": "仕事中です"},
        { "location": "50/SEL"    , "narrator": "", "text": "学校にいるよ"},
        { "location": "51/SEL"    , "narrator": "", "text": "人生に疲れてる"},
        { "location": "52/SEL"    , "narrator": "", "text": "千羽鶴のこと考えてる"},
        { "location": "53/ACT"    , "narrator": "", "text": "暇してる"},
        { "location": "55/TALK"   , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "56/TALK"   , "narrator": "千羽鶴", "text": "平和でいいですね。"},
        { "location": "57/ACT"    , "narrator": "", "text": "仕事中です"},
        { "location": "58/TALK"   , "narrator": "千羽鶴", "text": "仕事中なのに、\n私なんかとつき合って\nくれてありがとう。"},
        { "location": "59/TALK"   , "narrator": "千羽鶴", "text": "早速だけど、貴方が\n仕事さぼってるって、\n上司に密告しておく。"},
        { "location": "60/ACT"    , "narrator": "", "text": "学校にいるよ"},
        { "location": "61/TALK"   , "narrator": "千羽鶴", "text": "素敵ね。\n目一杯青春を謳歌して。"},
        { "location": "62/TALK"   , "narrator": "千羽鶴", "text": "そう、スマートフォンの\nガラスなんて\n覗き込んでないで。"},
        { "location": "63/TALK"   , "narrator": "千羽鶴", "text": "貴方の青春は、\n目の前の小さなガラスの\n向こうには無い。"},
        { "location": "64/TALK"   , "narrator": "千羽鶴", "text": "……。"},
        { "location": "66/TALK"   , "narrator": "千羽鶴", "text": "嘘です。\nやめないで。"},
        { "location": "67/ACT"    , "narrator": "", "text": "人生に疲れてる"},
        { "location": "68/TALK"   , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "69/TALK"   , "narrator": "千羽鶴", "text": "それじゃ早速、\n次の少女を紹介――"},
        { "location": "70/SEL"    , "narrator": "", "text": "ちょ、、それだけ！？"},
        { "location": "71/ACT"    , "narrator": "", "text": "ちょ、、それだけ！？"},
        { "location": "73/TALK"   , "narrator": "千羽鶴", "text": "……？"},
        { "location": "74/TALK"   , "narrator": "千羽鶴", "text": "もしかして、\n慰めて欲しかった？"},
        { "location": "75/SEL"    , "narrator": "", "text": "はい"},
        { "location": "76/SEL"    , "narrator": "", "text": "当たり前だろ！"},
        { "location": "77/SEL"    , "narrator": "", "text": "…うん（ｷｭﾛｰﾝ"},
        { "location": "78/ACT"    , "narrator": "", "text": "はい"},
        { "location": "79/TALK"   , "narrator": "千羽鶴", "text": "世の中そんなに\n甘くない。"},
        { "location": "80/TALK"   , "narrator": "千羽鶴", "text": "貴方に甘いのは\n貴方自身だけ。"},
        { "location": "81/TALK"   , "narrator": "千羽鶴", "text": "貴方自身に思いっきり\n甘えるのがいい。"},
        { "location": "82/ACT"    , "narrator": "", "text": "当たり前だろ！"},
        { "location": "83/TALK"   , "narrator": "千羽鶴", "text": "それだけ元気があれば\n大丈夫ね。"},
        { "location": "84/TALK"   , "narrator": "千羽鶴", "text": "そのフラストレー\nションで是非、この\n世界を救って欲しい。"},
        { "location": "85/ACT"    , "narrator": "", "text": "…うん（ｷｭﾛｰﾝ"},
        { "location": "87/TALK"   , "narrator": "千羽鶴", "text": "…！？"},
        { "location": "88/TALK"   , "narrator": "千羽鶴", "text": "ちょっと\n……かわいいかも。"},
        { "location": "90/TALK"   , "narrator": "千羽鶴", "text": "…よ……"},
        { "location": "91/TALK"   , "narrator": "千羽鶴", "text": "よしよし。\n大丈夫よ。"},
        { "location": "92/TALK"   , "narrator": "千羽鶴", "text": "何かあっても\nこっちの世界に\nいらっしゃい。"},
        { "location": "93/TALK"   , "narrator": "千羽鶴", "text": "生きたままでは\n無理かもしれないけど。"},
        { "location": "97/ACT"    , "narrator": "", "text": "千羽鶴のこと考えてる"},
        { "location": "98/TALK"   , "narrator": "千羽鶴", "text": "具体的に。\n何を考えているの？"},
        { "location": "99/SEL"    , "narrator": "", "text": "かわいい"},
        { "location": "100/SEL"   , "narrator": "", "text": "胸が小さい"},
        { "location": "101/SEL"   , "narrator": "", "text": "言えないようなこと"},
        { "location": "102/ACT"   , "narrator": "", "text": "かわいい"},
        { "location": "103/TALK"  , "narrator": "千羽鶴", "text": "いいえ。"},
        { "location": "104/TALK"  , "narrator": "千羽鶴", "text": "貴方の目は節穴。"},
        { "location": "105/ACT"   , "narrator": "", "text": "胸が小さい"},
        { "location": "107/TALK"  , "narrator": "千羽鶴", "text": "ありがと。"},
        { "location": "108/SEL"   , "narrator": "", "text": "あれ？怒らないの？"},
        { "location": "109/ACT"   , "narrator": "", "text": "あれ？怒らないの？"},
        { "location": "112/TALK"  , "narrator": "千羽鶴", "text": "胸が小さい\nイコール\nかわいい。"},
        { "location": "113/TALK"  , "narrator": "千羽鶴", "text": "そうでしょ？"},
        { "location": "114/SEL"   , "narrator": "", "text": "イエス！！"},
        { "location": "115/SEL"   , "narrator": "", "text": "ノーーーーーー！！"},
        { "location": "116/ACT"   , "narrator": "", "text": "イエス！！"},
        { "location": "118/TALK"  , "narrator": "千羽鶴", "text": "貴方とは\n気が合いそう。"},
        { "location": "119/ACT"   , "narrator": "", "text": "ノーーーーーー！！"},
        { "location": "121/TALK"  , "narrator": "千羽鶴", "text": "早くチュートリアルを\n終わらせましょ。"},
        { "location": "123/TALK"  , "narrator": "千羽鶴", "text": "尚、[トライナリー]\nメンバー5人の中で――"},
        { "location": "124/TALK"  , "narrator": "千羽鶴", "text": "大きいは正義という\n子は4人。"},
        { "location": "125/TALK"  , "narrator": "千羽鶴", "text": "小さいは正義という\n子は1人。"},
        { "location": "126/TALK"  , "narrator": "千羽鶴", "text": "…という、どうでもいい\n知識で貴方の脳を\n満たしてあげた。"},
        { "location": "127/ACT"   , "narrator": "", "text": "言えないようなこと"},
        { "location": "128/TALK"  , "narrator": "千羽鶴", "text": "具体的には？"},
        { "location": "129/SEL"   , "narrator": "", "text": "だから、言えないようなこと"},
        { "location": "130/ACT"   , "narrator": "", "text": "だから、言えないようなこと"},
        { "location": "132/TALK"  , "narrator": "千羽鶴", "text": "だからその中身を\n具体的に言って。"},
        { "location": "133/SEL"   , "narrator": "", "text": "言ったらアプリがストアから消えるよ"},
        { "location": "134/ACT"   , "narrator": "", "text": "言ったらアプリがストアから消えるよ"},
        { "location": "136/TALK"  , "narrator": "千羽鶴", "text": "そうなったら貴方に\n責任とってもらう。"},
        { "location": "137/SEL"   , "narrator": "", "text": "責任とって一生添い遂げます！"},
        { "location": "140/TALK"  , "narrator": "千羽鶴", "text": "責任とって一生\n添い遂げるとか\n言ったらアウト。"},
        { "location": "141/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "144/TALK"  , "narrator": "千羽鶴", "text": "…残念。\nセーフだった。"},
        { "location": "145/ACT"   , "narrator": "", "text": "責任とって一生添い遂げます！"},
        { "location": "147/TALK"  , "narrator": "千羽鶴", "text": "アウトォォォっ！！"},
        { "location": "151/TALK"  , "narrator": "千羽鶴", "text": "それで本題だけど――"},
        { "location": "152/TALK"  , "narrator": "千羽鶴", "text": "今までの貴方の多大なる\n協力に対するお礼は既に\n言ってあるし――"},
        { "location": "153/TALK"  , "narrator": "千羽鶴", "text": "記録映像に対する\n貴方からのツッコミも、\n前回色々もらった。"},
        { "location": "156/TALK"  , "narrator": "千羽鶴", "text": "だから今回は\n逢瀬つばめの解説を\nするだけでもいい？"},
        { "location": "159/TALK"  , "narrator": "千羽鶴", "text": "だから今回は\n國政綾水の解説を\nするだけでもいい？"},
        { "location": "162/TALK"  , "narrator": "千羽鶴", "text": "だから今回は\nガブリエラの解説を\nするだけでもいい？"},
        { "location": "165/TALK"  , "narrator": "千羽鶴", "text": "だから今回は\n恋ヶ崎みやびの解説を\nするだけでもいい？"},
        { "location": "167/SEL"   , "narrator": "", "text": "はい"},
        { "location": "168/SEL"   , "narrator": "", "text": "いいえ"},
        { "location": "169/ACT"   , "narrator": "", "text": "はい"},
        { "location": "170/TALK"  , "narrator": "千羽鶴", "text": "よかった。\n私も助かる。\nこれぞWIN-WINね。"},
        { "location": "172/ACT"   , "narrator": "", "text": "いいえ"},
        { "location": "173/TALK"  , "narrator": "千羽鶴", "text": "わかった。\nそれじゃもう１回\n同じ話をする。"},
        { "location": "178/TALK"  , "narrator": "千羽鶴", "text": "まずはお礼を言わせて。"},
        { "location": "179/TALK"  , "narrator": "千羽鶴", "text": "貴方がサポートしてくれた\nお陰で、この世界は理想と\nする方向へと向かい始めた。"},
        { "location": "180/TALK"  , "narrator": "千羽鶴", "text": "逢瀬つばめも、他の\nメンバーもあの\n終末的状況を克服し――"},
        { "location": "181/TALK"  , "narrator": "千羽鶴", "text": "色々なことが\n解決されていくはず。"},
        { "location": "182/SEL"   , "narrator": "", "text": "よかった！"},
        { "location": "183/SEL"   , "narrator": "", "text": "そんなこと言って、どうせ出来レースでしょ？"},
        { "location": "184/ACT"   , "narrator": "", "text": "よかった！"},
        { "location": "185/TALK"  , "narrator": "千羽鶴", "text": "ええ、ほんとに。\n貴方がいてくれたから\nこの危機を乗り切れた。"},
        { "location": "186/ACT"   , "narrator": "", "text": "そんなこと言って、どうせ出来レースでしょ？"},
        { "location": "187/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "189/TALK"  , "narrator": "千羽鶴", "text": "そういう偏屈なこと言う\n子は、ちーちゃん好きでは\nありません。"},
        { "location": "190/TALK"  , "narrator": "千羽鶴", "text": "真面目な話をすると、\n全然出来レースなんかじゃ\nないから。"},
        { "location": "191/TALK"  , "narrator": "千羽鶴", "text": "貴方が協力してくれなかった\n場合、少なくともこの私の\n世界は全然違っていた。"},
        { "location": "192/TALK"  , "narrator": "千羽鶴", "text": "貴方が手伝ってくれな\nかった、とても悲惨な\n結末の世界になっていた。"},
        { "location": "193/SEL"   , "narrator": "", "text": "なるほど"},
        { "location": "194/SEL"   , "narrator": "", "text": "他のプレイヤーだっているじゃん"},
        { "location": "195/ACT"   , "narrator": "", "text": "なるほど"},
        { "location": "196/TALK"  , "narrator": "千羽鶴", "text": "理解が早くて\nとても助かる。"},
        { "location": "197/ACT"   , "narrator": "", "text": "他のプレイヤーだっているじゃん"},
        { "location": "198/TALK"  , "narrator": "千羽鶴", "text": "他のプレイヤーが関わってる\n世界は、この世界とは全然\n違う世界。"},
        { "location": "199/TALK"  , "narrator": "千羽鶴", "text": "同じように見えるけど、\nとても近い世界だけど、\nでも違う世界。"},
        { "location": "200/TALK"  , "narrator": "千羽鶴", "text": "そこの千羽鶴は助かるけど、\n貴方のちーちゃんは\n助からない。わかる？"},
        { "location": "201/SEL"   , "narrator": "", "text": "ちーちゃんを助けたい！"},
        { "location": "202/SEL"   , "narrator": "", "text": "お、おう"},
        { "location": "203/SEL"   , "narrator": "", "text": "わかりません！"},
        { "location": "204/ACT"   , "narrator": "", "text": "ちーちゃんを助けたい！"},
        { "location": "206/TALK"  , "narrator": "千羽鶴", "text": "じゃあ、これからも\n彼女たちのサポートを\n全力でお願いする。"},
        { "location": "207/ACT"   , "narrator": "", "text": "お、おう"},
        { "location": "208/ACT"   , "narrator": "", "text": "わかりません！"},
        { "location": "210/TALK"  , "narrator": "千羽鶴", "text": "そうね。\n感覚的にはわかりにくい\nかもしれない。"},
        { "location": "211/TALK"  , "narrator": "千羽鶴", "text": "でも続けてくれれば、\nいずれわかるようになる。"},
        { "location": "215/TALK"  , "narrator": "千羽鶴", "text": "というわけで、\n状況が好転したことにより、\n新たな記録映像を入手した。"},
        { "location": "216/TALK"  , "narrator": "千羽鶴", "text": "どうする？\n今すぐに続きを見る？"},
        { "location": "218/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/65MB 4:18】</color>"},
        { "location": "219/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/21MB 4:18】</color>"},
        { "location": "220/SEL"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "221/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/65MB 4:18】</color>"},
        { "location": "222/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "228/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/21MB 4:18】</color>"},
        { "location": "229/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "235/ACT"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "236/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "237/TALK"  , "narrator": "千羽鶴", "text": "残念だけど、いろいろ\n事情があってのことだと\n思うから。"},
        { "location": "238/TALK"  , "narrator": "千羽鶴", "text": "家に帰ったら、是非\n映像記録の方も\n見てみて欲しい。"},
        { "location": "239/TALK"  , "narrator": "千羽鶴", "text": "それではどうぞ。"},
        { "location": "273/TALK"  , "narrator": "千羽鶴", "text": "フゥ。\nトテモオモシロカッタ！"},
        { "location": "274/SEL"   , "narrator": "", "text": "ちょっとまった！！"},
        { "location": "275/ACT"   , "narrator": "", "text": "ちょっとまった！！"},
        { "location": "278/TALK"  , "narrator": "千羽鶴", "text": "ソレデハ\nオハナシヲサキニ\nススメマショウ。"},
        { "location": "279/SEL"   , "narrator": "", "text": "ちょっと待てってば！"},
        { "location": "280/ACT"   , "narrator": "", "text": "ちょっと待てってば！"},
        { "location": "282/TALK"  , "narrator": "千羽鶴", "text": "…なに？\nそんなに私に\n未練タラタラなの？"},
        { "location": "284/SEL"   , "narrator": "", "text": "なんか、千羽鶴出演してなかった！？"},
        { "location": "285/SEL"   , "narrator": "", "text": "つばめはトライナリーになったの？"},
        { "location": "286/SEL"   , "narrator": "", "text": "そう！千羽鶴と離れるのが辛いの！"},
        { "location": "287/SEL"   , "narrator": "", "text": "いや、なんでもない"},
        { "location": "288/ACT"   , "narrator": "", "text": "なんか、千羽鶴出演してなかった！？"},
        { "location": "289/TALK"  , "narrator": "千羽鶴", "text": "いいえ。"},
        { "location": "290/SEL"   , "narrator": "", "text": "見たってば"},
        { "location": "291/ACT"   , "narrator": "", "text": "見たってば"},
        { "location": "294/TALK"  , "narrator": "千羽鶴", "text": "あれは違う。"},
        { "location": "295/TALK"  , "narrator": "千羽鶴", "text": "あれは私のはとこの\n母の兄の長女の友達。"},
        { "location": "296/SEL"   , "narrator": "", "text": "そうなんだ！"},
        { "location": "297/SEL"   , "narrator": "", "text": "親戚ですらないし……"},
        { "location": "298/ACT"   , "narrator": "", "text": "そうなんだ！"},
        { "location": "299/TALK"  , "narrator": "千羽鶴", "text": "嘘よ。"},
        { "location": "300/ACT"   , "narrator": "", "text": "親戚ですらないし……"},
        { "location": "301/TALK"  , "narrator": "千羽鶴", "text": "ばれた？\n当然嘘だけど。"},
        { "location": "304/TALK"  , "narrator": "千羽鶴", "text": "それにしても、\nどうしてあの部分が\n残ってた？"},
        { "location": "305/TALK"  , "narrator": "千羽鶴", "text": "確かに\n消した筈なのに……"},
        { "location": "307/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "309/ACT"   , "narrator": "", "text": "つばめはトライナリーになったの？"},
        { "location": "310/TALK"  , "narrator": "千羽鶴", "text": "ええ、\n[トライナリー]になった。"},
        { "location": "311/TALK"  , "narrator": "千羽鶴", "text": "どういう経緯で入隊\nしたのかについても、\n映像記録を作っている。"},
        { "location": "312/TALK"  , "narrator": "千羽鶴", "text": "また改めて\n配信するから\n楽しみにしていて。"},
        { "location": "313/TALK"  , "narrator": "千羽鶴", "text": "あと、一応つばめの\n入った学校についても、\n紹介しておこうと思う。"},
        { "location": "321/TALK"  , "narrator": "千羽鶴", "text": "彼女が転校した\n学校は――"},
        { "location": "322/TALK"  , "narrator": "千羽鶴", "text": "総務省管轄情報管理庁\n附属学園高等部\n特別攻撃隊特科。"},
        { "location": "323/TALK"  , "narrator": "千羽鶴", "text": "[トライナリー]たちや\nその周辺で活動する\n通常攻撃隊――"},
        { "location": "324/TALK"  , "narrator": "千羽鶴", "text": "また、[情報管理庁]が\n必要とする人材を\n育成する教育機関。"},
        { "location": "325/TALK"  , "narrator": "千羽鶴", "text": "場所は市ヶ谷にあって、\n中高大一貫校に\nなってる。"},
        { "location": "326/TALK"  , "narrator": "千羽鶴", "text": "<color=blue>國政綾水</color>も\nこの大学の学生だし、"},
        { "location": "327/TALK"  , "narrator": "千羽鶴", "text": "<color=green>ガブリエラ</color>も、\n<color=purple>恋ヶ崎みやび</color>も、\n中等部、高等部に所属。"},
        { "location": "328/TALK"  , "narrator": "千羽鶴", "text": "だから、\nみんな一緒。"},
        { "location": "333/TALK"  , "narrator": "千羽鶴", "text": "[トライナリー]に\n所属する子たちには、\n素敵な寮も完備。"},
        { "location": "334/TALK"  , "narrator": "千羽鶴", "text": "寮の名前は\n『とらいあんぐる』"},
        { "location": "335/TALK"  , "narrator": "千羽鶴", "text": "なかなか\n悪くない感じでしょ。"},
        { "location": "336/SEL"   , "narrator": "", "text": "まあね"},
        { "location": "337/SEL"   , "narrator": "", "text": "大変そう"},
        { "location": "338/ACT"   , "narrator": "", "text": "まあね"},
        { "location": "339/TALK"  , "narrator": "千羽鶴", "text": "そんな彼女たちの\n学園生活を、これから\nあなたは見守っていく。"},
        { "location": "340/ACT"   , "narrator": "", "text": "大変そう"},
        { "location": "342/TALK"  , "narrator": "千羽鶴", "text": "そうね。\n普通の学校とは\nちょっと違うから。"},
        { "location": "343/TALK"  , "narrator": "千羽鶴", "text": "でも、彼女たちなら\nきっと楽しんで通う\nと思う。"},
        { "location": "351/TALK"  , "narrator": "千羽鶴", "text": "いろんなことがあると\n思うけど、彼女たちを\n支えてあげて欲しい。"},
        { "location": "352/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "354/ACT"   , "narrator": "", "text": "そう！千羽鶴と離れるのが辛いの！"},
        { "location": "355/TALK"  , "narrator": "千羽鶴", "text": "ほんとに！？"},
        { "location": "356/TALK"  , "narrator": "千羽鶴", "text": "本当にそう思って\nくれているの！？"},
        { "location": "357/SEL"   , "narrator": "", "text": "もちろん！"},
        { "location": "358/ACT"   , "narrator": "", "text": "もちろん！"},
        { "location": "361/TALK"  , "narrator": "千羽鶴", "text": "ああっ…\n$handle$さんっ……"},
        { "location": "362/TALK"  , "narrator": "千羽鶴", "text": "でも心配しないで。\n私はずっと、\n貴方の傍にいるから。"},
        { "location": "363/TALK"  , "narrator": "千羽鶴", "text": "だって私は、\nこのゲームの\nラブラブトレーナー！"},
        { "location": "364/TALK"  , "narrator": "千羽鶴", "text": "このゲームを\n起動すれば、嫌でも\n出ざるを得ないの！"},
        { "location": "365/TALK"  , "narrator": "千羽鶴", "text": "だから。"},
        { "location": "366/TALK"  , "narrator": "千羽鶴", "text": "あなたが攻略対象の\n中から生涯添い遂げる\n人を決めても――"},
        { "location": "367/TALK"  , "narrator": "千羽鶴", "text": "その彼女と\n結婚しちゃったり\nしても――"},
        { "location": "368/TALK"  , "narrator": "千羽鶴", "text": "私はいつも、\nあなたと一緒！"},
        { "location": "369/TALK"  , "narrator": "千羽鶴", "text": "そう！\n私は小姑！"},
        { "location": "370/TALK"  , "narrator": "千羽鶴", "text": "小姑千羽鶴！"},
        { "location": "373/TALK"  , "narrator": "千羽鶴", "text": "どーん！！"},
        { "location": "374/TALK"  , "narrator": "千羽鶴", "text": "あなたが死ぬまで\nラブラブトレーナー\nとして頑張るから！"},
        { "location": "376/TALK"  , "narrator": "千羽鶴", "text": "だから\n心配しなくて大丈夫。"},
        { "location": "377/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "379/ACT"   , "narrator": "", "text": "いや、なんでもない"},
        { "location": "380/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "387/TALK"  , "narrator": "千羽鶴", "text": "さて、\n逢瀬つばめだけど。"},
        { "location": "388/TALK"  , "narrator": "千羽鶴", "text": "彼女は晴れて\n無理矢理トライナリーに\n入隊することになった。"},
        { "location": "389/TALK"  , "narrator": "千羽鶴", "text": "その経緯はまた後日\nお話するとして――"},
        { "location": "390/TALK"  , "narrator": "千羽鶴", "text": "今はそれよりも\nよっぽど深刻な悩みを\n彼女は抱えている。"},
        { "location": "391/TALK"  , "narrator": "千羽鶴", "text": "今回、貴方には\nそれを解決して欲しい。"},
        { "location": "392/SEL"   , "narrator": "", "text": "して、その悩みとは？"},
        { "location": "393/ACT"   , "narrator": "", "text": "して、その悩みとは？"},
        { "location": "395/TALK"  , "narrator": "千羽鶴", "text": "当ててみて。"},
        { "location": "396/SEL"   , "narrator": "", "text": "家族の悩み"},
        { "location": "397/SEL"   , "narrator": "", "text": "友だちの悩み"},
        { "location": "398/SEL"   , "narrator": "", "text": "胸が大きくならない悩み"},
        { "location": "399/ACT"   , "narrator": "", "text": "家族の悩み"},
        { "location": "400/TALK"  , "narrator": "千羽鶴", "text": "確かにそれも、\n彼女の中に或る\n悩みの１つ。"},
        { "location": "401/TALK"  , "narrator": "千羽鶴", "text": "けど今は、それより大きな\n問題が頭の中を占めていて、\n後回しになってる。"},
        { "location": "402/ACT"   , "narrator": "", "text": "友だちの悩み"},
        { "location": "404/TALK"  , "narrator": "千羽鶴", "text": "そうね。\n概ね正解と言っても\nいいかも。"},
        { "location": "405/ACT"   , "narrator": "", "text": "胸が大きくならない悩み"},
        { "location": "406/TALK"  , "narrator": "千羽鶴", "text": "ああ、それもある。"},
        { "location": "407/TALK"  , "narrator": "千羽鶴", "text": "けど、\nまだ機は熟していない。"},
        { "location": "408/TALK"  , "narrator": "千羽鶴", "text": "いずれその問題と\n直面することも\nあるでしょう。"},
        { "location": "410/TALK"  , "narrator": "千羽鶴", "text": "では目下の悩みとは何か？"},
        { "location": "411/TALK"  , "narrator": "千羽鶴", "text": "それは、転校すれば、\n誰もが感じる不安と悩み。"},
        { "location": "412/TALK"  , "narrator": "千羽鶴", "text": "逢瀬つばめはとても\n内気でシャイな子なの。"},
        { "location": "413/TALK"  , "narrator": "千羽鶴", "text": "だから彼女は、この学校で\n上手くやっていけるかを\n真剣に悩んでる。"},
        { "location": "414/TALK"  , "narrator": "千羽鶴", "text": "是非とも彼女の\nココロに直接ぶつかって\n解決してあげて欲しい。"},
        { "location": "415/TALK"  , "narrator": "千羽鶴", "text": "彼女の悩みを解消し、\nココロを安定させることは、\n結果世界の安寧に繋がる。"},
        { "location": "416/TALK"  , "narrator": "千羽鶴", "text": "健闘を祈ってる。"},
        { "location": "420/TALK"  , "narrator": "千羽鶴", "text": "さて、\n國政綾水だけど。"},
        { "location": "421/TALK"  , "narrator": "千羽鶴", "text": "彼女はトライナリーの\nリーダーであり、いつも\nそれを重荷に感じてる。"},
        { "location": "422/TALK"  , "narrator": "千羽鶴", "text": "特に今回の戦いは熾烈を\n極めたから尚更。"},
        { "location": "423/TALK"  , "narrator": "千羽鶴", "text": "今回は、ドーム戦が\n収束した直後からの\n彼女にフォーカスする。"},
        { "location": "424/TALK"  , "narrator": "千羽鶴", "text": "普段彼女達トライナリーが\nどんな生活をしているかを\n見ながら――"},
        { "location": "425/TALK"  , "narrator": "千羽鶴", "text": "その中で悩む國政綾水を\nサポートしてあげて欲しい。"},
        { "location": "427/TALK"  , "narrator": "千羽鶴", "text": "健闘を祈ってる。"},
        { "location": "431/TALK"  , "narrator": "千羽鶴", "text": "さて、\nガブリエラだけど。"},
        { "location": "432/TALK"  , "narrator": "千羽鶴", "text": "彼女はソルジャー気質で、\n人一倍用心深い性格なの。"},
        { "location": "433/TALK"  , "narrator": "千羽鶴", "text": "そして今回、その性格が\n逢瀬つばめに対して\n良くない方向に出ている。"},
        { "location": "434/TALK"  , "narrator": "千羽鶴", "text": "記録映像を見て分かったと\n思うけど、逢瀬つばめは\n素手でクランを倒した。"},
        { "location": "435/TALK"  , "narrator": "千羽鶴", "text": "でもそれは、常識では\n考えられないこと。"},
        { "location": "436/TALK"  , "narrator": "千羽鶴", "text": "それを見たガブリエラは、\n逢瀬つばめをとっても\n警戒している。"},
        { "location": "437/TALK"  , "narrator": "千羽鶴", "text": "貴方には、彼女に関わり\nそのわだかまりを解消して\nもらいたい。"},
        { "location": "438/TALK"  , "narrator": "千羽鶴", "text": "もちろん、一朝一夕では\n難しいかもしれない。"},
        { "location": "439/TALK"  , "narrator": "千羽鶴", "text": "だから、今回で全て\n解決しろなんてことは\n言わない。"},
        { "location": "440/TALK"  , "narrator": "千羽鶴", "text": "彼女の日常にさりげなく\n入り込んで、そのココロを\nサポートしてあげればいい。"},
        { "location": "442/TALK"  , "narrator": "千羽鶴", "text": "健闘を祈ってる。"},
        { "location": "446/TALK"  , "narrator": "千羽鶴", "text": "さて、\n恋ヶ崎みやびだけど。"},
        { "location": "447/TALK"  , "narrator": "千羽鶴", "text": "紹介したとおり、\n彼女にはハッカーという\n裏の面がある。"},
        { "location": "448/TALK"  , "narrator": "千羽鶴", "text": "彼女と深く関わっていく\n上で、その事について\n避けて通ることは叶わない。"},
        { "location": "449/TALK"  , "narrator": "千羽鶴", "text": "だからまずは、彼女の\nハッカー生活にスポットを\n当ててみようと思う。"},
        { "location": "450/TALK"  , "narrator": "千羽鶴", "text": "今回は、ドーム戦が\n収束した翌日に\nフォーカスを当てる。"},
        { "location": "451/TALK"  , "narrator": "千羽鶴", "text": "そこで、彼女が毎日\nどんな生活をしているか\n垣間見て欲しい。"},
        { "location": "452/TALK"  , "narrator": "千羽鶴", "text": "あ、それと、\n彼女はハッカーという\n特性上――"},
        { "location": "453/TALK"  , "narrator": "千羽鶴", "text": "バーチャルな関係に\n対しては、かなり警戒して\n接する。"},
        { "location": "454/TALK"  , "narrator": "千羽鶴", "text": "貴方のような顔の見えない\n存在には、なかなかココロを\n開かないかもしれない。"},
        { "location": "455/TALK"  , "narrator": "千羽鶴", "text": "難易度高めだけど、\n頑張って欲しい。"},
        { "location": "457/TALK"  , "narrator": "千羽鶴", "text": "健闘を祈ってる。"},
        { "location": "249/DIALOG", "narrator": "Tutorial/Dialog_Anime1", "text": "$dialog_word$"},
        { "location": "251/DIALOG", "narrator": "Tutorial/Dialog_Anime2", "text": "$dialog_word$"},
        { "location": "253/DIALOG", "narrator": "Tutorial/Dialog_Anime3", "text": "$dialog_word$"},
        { "location": "255/DIALOG", "narrator": "Tutorial/Dialog_Anime4", "text": "$dialog_word$"},
        { "location": "257/DIALOG", "narrator": "Tutorial/Dialog_Anime5", "text": "$dialog_word$"}
    ]
}
