{
    "dir": "chap11/daydra/dd_ch01_11_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "11152",
        "cid": "tsubame",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "美味しい寄り道"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "美味しい寄り道"},
        { "location": "19/TALK"   , "narrator": "みやび", "text": "…つばめちゃん、\nこの後暇か？"},
        { "location": "23/TALK"   , "narrator": "つばめ", "text": "わたしもみやびさんも、\n帰ったらバイトじゃない\nですか。"},
        { "location": "24/TALK"   , "narrator": "みやび", "text": "よし、問題なしやな。\nあそこのお店に行くぞね。"},
        { "location": "26/TALK"   , "narrator": "つばめ", "text": "問題なしじゃないですよ！\nっていうか、どうしたん\nですか突然？"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "うちな、あの店で出る\nあんみつが、まっこと\n大好きやき。"},
        { "location": "34/TALK"   , "narrator": "みやび", "text": "…そういうことやき、\nほれ、決まりやな。"},
        { "location": "37/TALK"   , "narrator": "つばめ", "text": "決まってない、\n決まってないですって！"},
        { "location": "40/TALK"   , "narrator": "つばめ", "text": "バイトに遅れたら\nアーヤさんやガブちゃんに\n怒られちゃいますよ？"},
        { "location": "41/TALK"   , "narrator": "みやび", "text": "あいつらが怒ってるんは\nいつものことやき、\n気にせんでもえいよ。"},
        { "location": "44/TALK"   , "narrator": "みやび", "text": "そんなことより、あの店の\nあんみつはまっこと絶品\nなんやがなぁ…。"},
        { "location": "46/TALK"   , "narrator": "みやび", "text": "つばめちゃんも一口でも\n食べたら、夢中になる\nこと間違いなしやが。"},
        { "location": "50/TALK"   , "narrator": "つばめ", "text": "…そ、そんなにですか？"},
        { "location": "51/TALK"   , "narrator": "みやび", "text": "そんだけ絶品なんよ。"},
        { "location": "52/SEL"    , "narrator": "", "text": "食べていこうよ"},
        { "location": "53/SEL"    , "narrator": "", "text": "我慢しないとダメだよ"},
        { "location": "54/SEL"    , "narrator": "", "text": "あんみつよりラーメンだ"},
        { "location": "56/TALK"   , "narrator": "みやび", "text": "つばめちゃんは\nあんみつ嫌いなが？"},
        { "location": "58/TALK"   , "narrator": "つばめ", "text": "いえ、大好きです。"},
        { "location": "60/TALK"   , "narrator": "みやび", "text": "なら決まりやね。\nさ、遅くならんよう、\nすっと行くがよ。"},
        { "location": "63/TALK"   , "narrator": "つばめ", "text": "…急いで食べれば、\nきっと大丈夫だよね？"},
        { "location": "84/TALK"   , "narrator": "つばめ", "text": "…って思ったんですけど、\n遅刻しちゃいました。\nごめんなさい！"},
        { "location": "86/TALK"   , "narrator": "ガブリエラ", "text": "しちゃいました、\nじゃないでしょ！"},
        { "location": "88/TALK"   , "narrator": "ガブリエラ", "text": "二人がいなかったから、\nあたしの仕事が倍に\nなったんだからね？"},
        { "location": "89/TALK"   , "narrator": "つばめ", "text": "うう、\nごめんなさい…。"},
        { "location": "92/TALK"   , "narrator": "ガブリエラ", "text": "みやびもよ。\n寄り道するならバイトの\n無い日にしなさい。"},
        { "location": "95/TALK"   , "narrator": "みやび", "text": "まあまあ、ガブちゃん。"},
        { "location": "96/TALK"   , "narrator": "みやび", "text": "お詫びにガブちゃんの分を\nお持ち帰りにして\nもらったき――"},
        { "location": "97/TALK"   , "narrator": "みやび", "text": "休憩時間にでも\n食べてほしいがよ。"},
        { "location": "98/TALK"   , "narrator": "ガブリエラ", "text": "えっ？\nあ、うん…。"},
        { "location": "101/TALK"  , "narrator": "ガブリエラ", "text": "…ま、まあ、くれるって\n言うなら、ありがたく\nもらっておくけど――"},
        { "location": "102/TALK"  , "narrator": "ガブリエラ", "text": "今度からは\n気をつけなさいよ。"},
        { "location": "109/TALK"  , "narrator": "みやび", "text": "ガブちゃんも女の子やき、\n甘い物には弱いんよ。"},
        { "location": "112/TALK"  , "narrator": "つばめ", "text": "みたいですね。\nあまり怒られなくて\nほっとしました…。"},
        { "location": "115/TALK"  , "narrator": "つばめ", "text": "…でも、これからは\n遅刻しないように\n気をつけよう。"},
        { "location": "116/ACT"   , "narrator": "", "text": "食べていこうよ"},
        { "location": "121/TALK"  , "narrator": "つばめ", "text": "ちょ、ちょっと待って\nください。"},
        { "location": "138/TALK"  , "narrator": "つばめ", "text": "えぇっ！？"},
        { "location": "140/TALK"  , "narrator": "つばめ", "text": "い、いいのかなぁ？"},
        { "location": "154/TALK"  , "narrator": "つばめ", "text": "あ、あの…\n本当にいいんですか？"},
        { "location": "155/TALK"  , "narrator": "つばめ", "text": "寄り道なんかしたら、\n絶対にバイト、遅れちゃい\nますよ？"},
        { "location": "157/TALK"  , "narrator": "みやび", "text": "えいからえいから。\n先輩のうちがえいと\n言ってるんやき。"},
        { "location": "158/TALK"  , "narrator": "みやび", "text": "な～んも心配はいらんき、\nほれ、さっと行くぞね！"},
        { "location": "162/TALK"  , "narrator": "つばめ", "text": "…絶対怒られると\n思うんだけどなぁ。"},
        { "location": "179/TALK"  , "narrator": "ガブリエラ", "text": "…って、怒られるのが\nわかってるなら、\n真っ直ぐ帰ってきなさい！"},
        { "location": "180/TALK"  , "narrator": "ガブリエラ", "text": "二人がいなかったから、\nあたしの仕事が倍に\nなったんだからね？"},
        { "location": "182/TALK"  , "narrator": "つばめ", "text": "うう、\nごめんなさい…。"},
        { "location": "185/TALK"  , "narrator": "ガブリエラ", "text": "みやびもよ。\n寄り道するならバイトの\n無い日にしてよね。"},
        { "location": "188/TALK"  , "narrator": "みやび", "text": "まあまあ、ガブちゃん。"},
        { "location": "189/TALK"  , "narrator": "みやび", "text": "お詫びにガブちゃんの\n分をお持ち帰りにして\nもらったき――"},
        { "location": "190/TALK"  , "narrator": "みやび", "text": "休憩時間にでも\n食べてほしいがよ。"},
        { "location": "191/TALK"  , "narrator": "ガブリエラ", "text": "えっ？\nあ、うん…。"},
        { "location": "194/TALK"  , "narrator": "ガブリエラ", "text": "…ま、まあ、くれるって\n言うなら、ありがたく\nもらっておくけど――"},
        { "location": "195/TALK"  , "narrator": "ガブリエラ", "text": "今度からは\n気をつけなさいよ。"},
        { "location": "203/TALK"  , "narrator": "みやび", "text": "ガブちゃんも女の子やき、\n甘い物には弱いんよ。"},
        { "location": "206/TALK"  , "narrator": "つばめ", "text": "みたいですね。\nあまり怒られなくて\nほっとしました…。"},
        { "location": "210/TALK"  , "narrator": "つばめ", "text": "…でも、これからは\n遅刻しないように\n気をつけよう。"},
        { "location": "211/ACT"   , "narrator": "", "text": "我慢しないとダメだよ"},
        { "location": "216/TALK"  , "narrator": "つばめ", "text": "あ、ちょっと待って\nください。"},
        { "location": "233/TALK"  , "narrator": "つばめ", "text": "やっぱり、そうだよね"},
        { "location": "234/TALK"  , "narrator": "つばめ", "text": "ありがと、答えは決まったよ"},
        { "location": "246/TALK"  , "narrator": "つばめ", "text": "ごめんなさい！\nやっぱりわたし、\n帰ります！"},
        { "location": "247/TALK"  , "narrator": "みやび", "text": "はぁ…つばめちゃんは\nまっことえい子やね。"},
        { "location": "248/TALK"  , "narrator": "みやび", "text": "じゃあ、うちはのんびり\nあんみつを楽しんでから\n帰るき。"},
        { "location": "249/TALK"  , "narrator": "みやび", "text": "つばめちゃん、あとでな。"},
        { "location": "253/TALK"  , "narrator": "つばめ", "text": "今度バイトが休みの日に、\n絶対に食べにこよう。"},
        { "location": "254/ACT"   , "narrator": "", "text": "あんみつよりラーメンだ"},
        { "location": "261/TALK"  , "narrator": "つばめ", "text": "あ、ちょっと待って\nください。\nメールが来たみたいで…。"},
        { "location": "278/TALK"  , "narrator": "つばめ", "text": "ラーメンかぁ…"},
        { "location": "279/TALK"  , "narrator": "つばめ", "text": "そう言われたらお腹減ってきちゃったなぁ…"},
        { "location": "294/TALK"  , "narrator": "つばめ", "text": "あの、あんみつよりも\nラーメンを食べたい\n気分なんですけど…。"},
        { "location": "296/TALK"  , "narrator": "みやび", "text": "ラーメン？\nそれも捨てがたい…"},
        { "location": "298/TALK"  , "narrator": "みやび", "text": "よし、今日はラーメンに\nするぞね！"},
        { "location": "299/TALK"  , "narrator": "みやび", "text": "すぐそこにえい店が\nあるき、早速行くがよ。"},
        { "location": "301/TALK"  , "narrator": "つばめ", "text": "わぁ、楽しみです！"},
        { "location": "304/TALK"  , "narrator": "つばめ", "text": "…あれ？　何か大切なこと\n忘れてるような…。"},
        { "location": "322/TALK"  , "narrator": "ガブリエラ", "text": "…で、すっかりバイトの\nことが頭から抜けていた、\nってわけね。"},
        { "location": "323/TALK"  , "narrator": "つばめ", "text": "ごめんなさいぃ…。"},
        { "location": "326/TALK"  , "narrator": "ガブリエラ", "text": "はぁ…呆れて怒る気にも\nなれないわ。"},
        { "location": "328/TALK"  , "narrator": "ガブリエラ", "text": "つばめがいない間、\nあたしがあんたの分の\n仕事したんだから――"},
        { "location": "329/TALK"  , "narrator": "ガブリエラ", "text": "今からその分、きっちり\n働きなさいよ？"},
        { "location": "331/TALK"  , "narrator": "つばめ", "text": "う、うん。\nもちろん！"},
        { "location": "334/TALK"  , "narrator": "ガブリエラ", "text": "みやびも、ちょっとは\n反省してよね？"},
        { "location": "336/TALK"  , "narrator": "みやび", "text": "…そうやね。\nラーメン食べて\nお腹もパンパンやき――"},
        { "location": "337/TALK"  , "narrator": "みやび", "text": "すっと仕事始めて、\nすっと終わらせるがよ。"},
        { "location": "338/TALK"  , "narrator": "ガブリエラ", "text": "さっさと終わらせよう\nとか、遅れてきた人の\n言葉じゃないわよ？"},
        { "location": "17/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>6月20日　3:55 PM</color>\n平日の放課後、学園からの帰り道。"},
        { "location": "349/DIALOG", "narrator": "Dialog_GEThimegoto_ch01", "text": "【遅刻は厳禁】"}
    ]
}
