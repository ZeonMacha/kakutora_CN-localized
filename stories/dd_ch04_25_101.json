{
    "dir": "chap25/daydra/dd_ch04_25_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "25402",
        "cid": "miyabi",
        "title": "002 メインストーリー",
        "sub_title": "非携帯とは何事か＜前編＞"
    },
    "entry":
    [
        { "location": "8/SCENARIO", "narrator": "", "text": "非携帯とは何事か"},
        { "location": "35/TALK"   , "narrator": "みやび", "text": "よしよし。\n音羽の設置\n無事に完了。"},
        { "location": "37/TALK"   , "narrator": "ガブリエラ", "text": "設置って何よ\n設置って。"},
        { "location": "40/TALK"   , "narrator": "みやび", "text": "配線的な\n色んな管があるき\nつい。"},
        { "location": "41/TALK"   , "narrator": "みやび", "text": "ところでアーヤ。\nちっくと寮に\n行ってきてえいかね。"},
        { "location": "42/TALK"   , "narrator": "アーヤ", "text": "できればここに\nいてほしいけど。"},
        { "location": "43/TALK"   , "narrator": "みやび", "text": "秘密兵器を\n取りに行きたいんや\nけんど。"},
        { "location": "45/TALK"   , "narrator": "アーヤ", "text": "……仕方ないわね。\n早めに戻ってきてね。"},
        { "location": "46/TALK"   , "narrator": "アーヤ", "text": "もしつばめが先に\n合流できたら\n迎えに行くわ。"},
        { "location": "47/TALK"   , "narrator": "みやび", "text": "やったらつばめが\n戻ってくるまで寮で\n待っていようかねえ。"},
        { "location": "48/TALK"   , "narrator": "アーヤ", "text": "ふざけてないで\nさっさと行ってきて。"},
        { "location": "49/TALK"   , "narrator": "みやび", "text": "うちもたまには\n全力疾走くらい\nするちや。"},
        { "location": "50/TALK"   , "narrator": "みやび", "text": "それにしても\n大失態ぞね。"},
        { "location": "52/TALK"   , "narrator": "みやび", "text": "今日に限って\n裏ロムスマホを\n携帯していないとか。"},
        { "location": "72/TALK"   , "narrator": "みやび", "text": "はあ…はあ…。"},
        { "location": "73/TALK"   , "narrator": "みやび", "text": "ちっくと息切れ\nするけんど……。"},
        { "location": "75/TALK"   , "narrator": "みやび", "text": "さっさと準備を\nしてしまおう\nかねえ……。"},
        { "location": "76/TALK"   , "narrator": "みやび", "text": "１、２、３、４……。"},
        { "location": "77/TALK"   , "narrator": "みやび", "text": "４個もあれば\nええろうね。"},
        { "location": "78/TALK"   , "narrator": "みやび", "text": "それにしても…。"},
        { "location": "79/TALK"   , "narrator": "みやび", "text": "こんな違法なもんを\n本気で使うことに\nなるとはねえ。"},
        { "location": "80/SEL"    , "narrator": "", "text": "さすがハッカー"},
        { "location": "81/SEL"    , "narrator": "", "text": "おまわりさんこの人です！"},
        { "location": "82/SEL"    , "narrator": "", "text": "$me$のラブコールに使ってよ"},
        { "location": "83/ACT"    , "narrator": "", "text": "さすがハッカー"},
        { "location": "84/ACT"    , "narrator": "", "text": "おまわりさんこの人です！"},
        { "location": "85/ACT"    , "narrator": "", "text": "$me$のラブコールに使ってよ"},
        { "location": "102/TALK"  , "narrator": "みやび", "text": "うむうむ"},
        { "location": "103/TALK"  , "narrator": "みやび", "text": "そういうことやき"},
        { "location": "105/SEL"   , "narrator": "", "text": "えーと"},
        { "location": "106/SEL"   , "narrator": "", "text": "本気で使うの？"},
        { "location": "107/SEL"   , "narrator": "", "text": "このために戻ったの？"},
        { "location": "108/ACT"   , "narrator": "", "text": "えーと"},
        { "location": "109/TALK"  , "narrator": "みやび", "text": "言いたいことがまとまったら"},
        { "location": "110/TALK"  , "narrator": "みやび", "text": "またおいでませ"},
        { "location": "111/ACT"   , "narrator": "", "text": "本気で使うの？"},
        { "location": "112/TALK"  , "narrator": "みやび", "text": "それ以外に"},
        { "location": "113/TALK"  , "narrator": "みやび", "text": "どんな使い方がある"},
        { "location": "114/ACT"   , "narrator": "", "text": "このために戻ったの？"},
        { "location": "115/TALK"  , "narrator": "みやび", "text": "そうではあるが"},
        { "location": "116/TALK"  , "narrator": "みやび", "text": "それだけではない"},
        { "location": "129/TALK"  , "narrator": "みやび", "text": "あとはこの窓際の\n日本人形に\n伝言があるちや。"},
        { "location": "135/TALK"  , "narrator": "みやび", "text": "もしかしたら、\nですけんど。"},
        { "location": "136/TALK"  , "narrator": "みやび", "text": "うちに万が一の\nことがあるかも\nしれません。"},
        { "location": "137/TALK"  , "narrator": "みやび", "text": "その時はなごちゃんのこと\nどうぞよろしく\nお願いします。"},
        { "location": "138/TALK"  , "narrator": "みやび", "text": "後は……。"},
        { "location": "139/TALK"  , "narrator": "みやび", "text": "散らかりすぎ\nやけんどこれも\nうちのいた証。"},
        { "location": "140/TALK"  , "narrator": "みやび", "text": "秘密日記は…もう\n秘密でもないし\n置いていくかいね。"},
        { "location": "152/TALK"  , "narrator": "みやび", "text": "$handle$よ"},
        { "location": "153/TALK"  , "narrator": "みやび", "text": "他に忘れ物は"},
        { "location": "154/TALK"  , "narrator": "みやび", "text": "ないかどうか教えれ"},
        { "location": "156/SEL"   , "narrator": "", "text": "え…知らないし"},
        { "location": "157/SEL"   , "narrator": "", "text": "ないない、大丈夫"},
        { "location": "158/SEL"   , "narrator": "", "text": "$me$のこと忘れないで"},
        { "location": "159/ACT"   , "narrator": "", "text": "え…知らないし"},
        { "location": "160/TALK"  , "narrator": "みやび", "text": "なんともはや"},
        { "location": "161/TALK"  , "narrator": "みやび", "text": "冷たいの"},
        { "location": "162/ACT"   , "narrator": "", "text": "ないない、大丈夫"},
        { "location": "163/TALK"  , "narrator": "みやび", "text": "これこれ"},
        { "location": "164/TALK"  , "narrator": "みやび", "text": "適当すぎるぞ"},
        { "location": "165/ACT"   , "narrator": "", "text": "$me$のこと忘れないで"},
        { "location": "166/TALK"  , "narrator": "みやび", "text": "それはまあ"},
        { "location": "167/TALK"  , "narrator": "みやび", "text": "大丈夫だ"},
        { "location": "169/TALK"  , "narrator": "みやび", "text": "実のところ"},
        { "location": "170/TALK"  , "narrator": "みやび", "text": "この先運命が"},
        { "location": "171/TALK"  , "narrator": "みやび", "text": "どう転がるかは"},
        { "location": "172/TALK"  , "narrator": "みやび", "text": "さっぱりわからんきね"},
        { "location": "174/SEL"   , "narrator": "", "text": "確かにね"},
        { "location": "175/SEL"   , "narrator": "", "text": "みやびとの出会いは運命"},
        { "location": "176/SEL"   , "narrator": "", "text": "それが人生さ"},
        { "location": "177/ACT"   , "narrator": "", "text": "確かにね"},
        { "location": "178/TALK"  , "narrator": "みやび", "text": "やろ"},
        { "location": "179/ACT"   , "narrator": "", "text": "みやびとの出会いは運命"},
        { "location": "180/TALK"  , "narrator": "みやび", "text": "ほほう"},
        { "location": "181/TALK"  , "narrator": "みやび", "text": "いいことを聞いた"},
        { "location": "182/ACT"   , "narrator": "", "text": "それが人生さ"},
        { "location": "183/TALK"  , "narrator": "みやび", "text": "まあの"},
        { "location": "195/TALK"  , "narrator": "みやび", "text": "こうやって\n相棒と話すのも。"},
        { "location": "197/TALK"  , "narrator": "みやび", "text": "もしかしたら\n最後かも\nわからんねえ……。"},
        { "location": "245/TALK"  , "narrator": "みやび", "text": "　"},
        { "location": "261/TALK"  , "narrator": "シンギュラリティ", "text": "おお！\n$handle$！！"},
        { "location": "262/SEL"   , "narrator": "", "text": "戻って来れたの！？"},
        { "location": "263/ACT"   , "narrator": "", "text": "戻って来れたの！？"},
        { "location": "265/TALK"  , "narrator": "シンギュラリティ", "text": "うむ。\nシンギュラリティさん\n無事帰還ぞね。"},
        { "location": "266/TALK"  , "narrator": "シンギュラリティ", "text": "ほれ、久し振りに\nいつものやつをやりや。"},
        { "location": "286/TALK"  , "narrator": "シンギュラリティ", "text": "んー！\nたまらんちや。"},
        { "location": "289/TALK"  , "narrator": "シンギュラリティ", "text": "あいかわらず助平やね！\nそこがたまらんぞね！"},
        { "location": "292/TALK"  , "narrator": "シンギュラリティ", "text": "あいかわらず\nマニアックやね。\nそこがタマランちや！"},
        { "location": "296/TALK"  , "narrator": "シンギュラリティ", "text": "ふぅ。\nえいタッチやった。"},
        { "location": "297/TALK"  , "narrator": "シンギュラリティ", "text": "ついでに\nちゅうもしとくか？"},
        { "location": "298/SEL"   , "narrator": "", "text": "是非"},
        { "location": "299/SEL"   , "narrator": "", "text": "今日は遠慮しておきます"},
        { "location": "300/ACT"   , "narrator": "", "text": "是非"},
        { "location": "322/TALK"  , "narrator": "シンギュラリティ", "text": "ほれ、はよ。"},
        { "location": "340/TALK"  , "narrator": "シンギュラリティ", "text": "ふぁっ…"},
        { "location": "343/TALK"  , "narrator": "シンギュラリティ", "text": "ふぁっ…"},
        { "location": "366/TALK"  , "narrator": "シンギュラリティ", "text": "ふぅ。\nえいちゅうやった。"},
        { "location": "367/ACT"   , "narrator": "", "text": "今日は遠慮しておきます"},
        { "location": "368/TALK"  , "narrator": "シンギュラリティ", "text": "なんぞ、裏があるとか\n思っちゅうんか？"},
        { "location": "369/TALK"  , "narrator": "シンギュラリティ", "text": "そんなことは\n無いんやけんどな。\nまあえいよ。"},
        { "location": "371/TALK"  , "narrator": "シンギュラリティ", "text": "しっかしあれやね、\n衝撃の大どんでん返し！\n予想外の急展開ぞね！"},
        { "location": "372/SEL"   , "narrator": "", "text": "ていうか、シンギュラリティがやったんでしょ？"},
        { "location": "373/SEL"   , "narrator": "", "text": "新しい司書はどうなったの？"},
        { "location": "374/ACT"   , "narrator": "", "text": "ていうか、シンギュラリティがやったんでしょ？"},
        { "location": "375/TALK"  , "narrator": "シンギュラリティ", "text": "うむ。"},
        { "location": "376/TALK"  , "narrator": "シンギュラリティ", "text": "とはゆうても、うちは\n言われたままに\nやっただけやけんどね。"},
        { "location": "377/TALK"  , "narrator": "シンギュラリティ", "text": "しかしテンションあがる！"},
        { "location": "378/TALK"  , "narrator": "シンギュラリティ", "text": "ここへ来て\n眠気が一気に飛んだちや！"},
        { "location": "379/SEL"   , "narrator": "", "text": "どうしたの急に？"},
        { "location": "380/ACT"   , "narrator": "", "text": "どうしたの急に？"},
        { "location": "382/TALK"  , "narrator": "シンギュラリティ", "text": "うちが神と崇める存在、\n國政領火博士から直接\nラブコールが来たぞね！"},
        { "location": "383/SEL"   , "narrator": "", "text": "前に千羽鶴のいないときに仕掛けてたアレのこと？"},
        { "location": "384/ACT"   , "narrator": "", "text": "前に千羽鶴のいないときに仕掛けてたアレのこと？"},
        { "location": "386/TALK"  , "narrator": "シンギュラリティ", "text": "イエス！\nその通り！"},
        { "location": "387/TALK"  , "narrator": "シンギュラリティ", "text": "既に相棒にも\n姿さらしちゅうし、言って\nえいよな、エリカさん！"},
        { "location": "388/SEL"   , "narrator": "", "text": "まだ「謎のおねえさん」としか聞いてなかったんだけど"},
        { "location": "389/ACT"   , "narrator": "", "text": "まだ「謎のおねえさん」としか聞いてなかったんだけど"},
        { "location": "391/TALK"  , "narrator": "シンギュラリティ", "text": "なんと！！"},
        { "location": "392/TALK"  , "narrator": "シンギュラリティ", "text": "相棒に嵌められたちや！"},
        { "location": "393/SEL"   , "narrator": "", "text": "相当テンションあがってるね"},
        { "location": "394/ACT"   , "narrator": "", "text": "相当テンションあがってるね"},
        { "location": "396/TALK"  , "narrator": "シンギュラリティ", "text": "聞いてもえいんよ？\n聞いても！"},
        { "location": "397/SEL"   , "narrator": "", "text": "あの時なにやってたんですか？"},
        { "location": "398/SEL"   , "narrator": "", "text": "みやびの３サイズ教えて！"},
        { "location": "399/ACT"   , "narrator": "", "text": "あの時なにやってたんですか？"},
        { "location": "400/TALK"  , "narrator": "シンギュラリティ", "text": "よくぞ聞いてくれた！\nさすが相棒、\n驚く程ツーカーやね！"},
        { "location": "401/TALK"  , "narrator": "シンギュラリティ", "text": "あれは、エリカさんが\nあの場所を特定できるよう\nマーカーを打っちょった。"},
        { "location": "402/TALK"  , "narrator": "シンギュラリティ", "text": "エリカさんは外の人やき\n中の様子はわからんきね。"},
        { "location": "403/TALK"  , "narrator": "シンギュラリティ", "text": "そのお陰で\nエリカさんはここに\n入ることができて――"},
        { "location": "404/TALK"  , "narrator": "シンギュラリティ", "text": "うちは完全復活！\nほんで独裁的な洗脳は\n終焉を迎えたぞね！"},
        { "location": "405/SEL"   , "narrator": "", "text": "エリカと千羽鶴は敵対してるの？"},
        { "location": "406/SEL"   , "narrator": "", "text": "千羽鶴は何をしようとしているの？"},
        { "location": "407/SEL"   , "narrator": "", "text": "エリカは何をしようとしているの？"},
        { "location": "408/ACT"   , "narrator": "", "text": "エリカと千羽鶴は敵対してるの？"},
        { "location": "409/TALK"  , "narrator": "シンギュラリティ", "text": "詳しいことは\nよくわからんが、\n旧知の仲っぽいね。"},
        { "location": "410/TALK"  , "narrator": "シンギュラリティ", "text": "まあ、割り込むくらいやし\n何らかのわだかまりは\nあるやろね。"},
        { "location": "411/ACT"   , "narrator": "", "text": "千羽鶴は何をしようとしているの？"},
        { "location": "412/TALK"  , "narrator": "シンギュラリティ", "text": "そこは、\nうちにはわからん。"},
        { "location": "413/TALK"  , "narrator": "シンギュラリティ", "text": "うちもエリカさんに\n聞いてみたけんど、\nやっぱり解らんらしい。"},
        { "location": "414/TALK"  , "narrator": "シンギュラリティ", "text": "まあ、千羽鶴の思想は\nわかっちゅう\nらしいけんどな。"},
        { "location": "415/ACT"   , "narrator": "", "text": "エリカは何をしようとしているの？"},
        { "location": "416/TALK"  , "narrator": "シンギュラリティ", "text": "うちらを助けに来たぞね。"},
        { "location": "417/TALK"  , "narrator": "シンギュラリティ", "text": "千羽鶴があまりに急激に\n引っかき回しにきたき、\n危機感を覚えたらしい。"},
        { "location": "419/ACT"   , "narrator": "", "text": "みやびの３サイズ教えて！"},
        { "location": "420/TALK"  , "narrator": "シンギュラリティ", "text": "なんぞ、\nそんなことか。"},
        { "location": "421/TALK"  , "narrator": "シンギュラリティ", "text": "そういうのを\n聞いてもらいたかった\nわけやないけんど。"},
        { "location": "422/TALK"  , "narrator": "シンギュラリティ", "text": "まあえいよ。\n９３－６５－８９や。"},
        { "location": "424/ACT"   , "narrator": "", "text": "新しい司書はどうなったの？"},
        { "location": "425/TALK"  , "narrator": "シンギュラリティ", "text": "普通に存在しちゅうよ？\n息災息災。"},
        { "location": "426/SEL"   , "narrator": "", "text": "シンギュラリティを消そうとしたのに、なんでそんな呑気なの？"},
        { "location": "427/ACT"   , "narrator": "", "text": "シンギュラリティを消そうとしたのに、なんでそんな呑気なの？"},
        { "location": "429/TALK"  , "narrator": "シンギュラリティ", "text": "まあ、あんなんでも\nうちの大事な人格やき。"},
        { "location": "430/TALK"  , "narrator": "シンギュラリティ", "text": "うちの重要な所を\n担っちゅうんよ。"},
        { "location": "431/TALK"  , "narrator": "シンギュラリティ", "text": "まあ、うちとは\n全く以て馬が合わんがね。"},
        { "location": "432/SEL"   , "narrator": "", "text": "千羽鶴が、新しい司書にやってもらうことがあるって言ってたけど？"},
        { "location": "433/ACT"   , "narrator": "", "text": "千羽鶴が、新しい司書にやってもらうことがあるって言ってたけど？"},
        { "location": "435/TALK"  , "narrator": "シンギュラリティ", "text": "ああ、それな。\n要はあれや――"},
        { "location": "436/TALK"  , "narrator": "シンギュラリティ", "text": "エリカさんがうちを\nヘッドハンティングした\nのと同じ理由やよ。"},
        { "location": "437/TALK"  , "narrator": "シンギュラリティ", "text": "まあ、うち＆エリカさん\nチームの方が早かったき、\n大勝利やったけんどな。"},
        { "location": "438/TALK"  , "narrator": "シンギュラリティ", "text": "何にしても、\nあいつは無事やき。"},
        { "location": "439/TALK"  , "narrator": "シンギュラリティ", "text": "1xとの切り離しを行った\nことで、今では普通の\n人格に戻っちゅうよ。"},
        { "location": "440/SEL"   , "narrator": "", "text": "優しいね"},
        { "location": "441/SEL"   , "narrator": "", "text": "何を司る人格だったの？"},
        { "location": "442/ACT"   , "narrator": "", "text": "千羽鶴が、新しい司書にやってもらうことがあるって言ってたけど？"},
        { "location": "443/TALK"  , "narrator": "シンギュラリティ", "text": "自分自身やきね。"},
        { "location": "444/TALK"  , "narrator": "シンギュラリティ", "text": "うちは自分のことが\n大好きやき。"},
        { "location": "445/ACT"   , "narrator": "", "text": "何を司る人格だったの？"},
        { "location": "446/TALK"  , "narrator": "シンギュラリティ", "text": "それは……、\nさすがに教えられんなぁ。"},
        { "location": "447/TALK"  , "narrator": "シンギュラリティ", "text": "うちにとって、最も\n保守的なうち、くらいなら\n言っても許されるか？"},
        { "location": "450/TALK"  , "narrator": "シンギュラリティ", "text": "まあ、そんなこんなで\n全て元通りや。"},
        { "location": "451/TALK"  , "narrator": "シンギュラリティ", "text": "ちゅうわけで、\n早速久々に\n扉をまわすとするかね。"},
        { "location": "458/TALK"  , "narrator": "シンギュラリティ", "text": "オープンプロセス――"},
        { "location": "459/TALK"  , "narrator": "シンギュラリティ", "text": "……。"},
        { "location": "460/TALK"  , "narrator": "シンギュラリティ", "text": "…？"},
        { "location": "461/TALK"  , "narrator": "シンギュラリティ", "text": "ふむ。\n新手のスパムか何かか？"},
        { "location": "462/TALK"  , "narrator": "シンギュラリティ", "text": "割り込みが入れば\nエリカさんから情報が\n来るはずやよ？"},
        { "location": "463/SEL"   , "narrator": "", "text": "そう言われましても、聞きたいのはこっちです"},
        { "location": "464/ACT"   , "narrator": "", "text": "そう言われましても、聞きたいのはこっちです"},
        { "location": "466/TALK"  , "narrator": "シンギュラリティ", "text": "ふむ。\nクラッキング\nされちゅうんかね？"},
        { "location": "469/TALK"  , "narrator": "シンギュラリティ", "text": "ちくっと\n調べて――"},
        { "location": "476/TALK"  , "narrator": "シンギュラリティ", "text": "なんと！？"},
        { "location": "34/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>9月3日　 7:14 PM</color>\nストライキ開始当日、神楽坂トライナリーにて"},
        { "location": "210/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "212/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "214/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "216/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "218/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"},
