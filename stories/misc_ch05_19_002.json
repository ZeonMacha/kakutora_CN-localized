        { "location": "6174/SCENARIO", "narrator": "", "text": "タワーディフェンスの敵が幼女なんですけど"},
        { "location": "6201/TALK"    , "narrator": "神楽", "text": "映画なんかだと魅力的な敵役って重要だけど"},
        { "location": "6202/TALK"    , "narrator": "神楽", "text": "タワーディフェンスの敵が幼女だったりしたら"},
        { "location": "6203/TALK"    , "narrator": "神楽", "text": "攻略できなくない？"},
        { "location": "6205/SEL"     , "narrator": "", "text": "動きが鈍いから大丈夫（にっこり）"},
        { "location": "6206/SEL"     , "narrator": "", "text": "確かに倒したくないよね…"},
        { "location": "6207/SEL"     , "narrator": "", "text": "いや単なるデータだし"},
        { "location": "6208/ACT"     , "narrator": "", "text": "動きが鈍いから大丈夫（にっこり）"},
        { "location": "6210/TALK"    , "narrator": "神楽", "text": "ヤバい人ｷﾀｰ！！！！"},
        { "location": "6211/TALK"    , "narrator": "神楽", "text": "弱者から狩れということですねそうですね"},
        { "location": "6212/TALK"    , "narrator": "神楽", "text": "$handlek$、、、、"},
        { "location": "6213/TALK"    , "narrator": "神楽", "text": "マッドネス、、、"},
        { "location": "6214/ACT"     , "narrator": "", "text": "確かに倒したくないよね…"},
        { "location": "6215/TALK"    , "narrator": "神楽", "text": "でそ？"},
        { "location": "6216/ACT"     , "narrator": "", "text": "いや単なるデータだし"},
        { "location": "6217/TALK"    , "narrator": "神楽", "text": "あ"},
        { "location": "6218/TALK"    , "narrator": "神楽", "text": "話合わなさそうですね"},
        { "location": "6229/TALK"    , "narrator": "神楽", "text": "まあ人外美女とかは見たことあるけど"},
        { "location": "6231/TALK"    , "narrator": "神楽", "text": "西洋系モンスターとか"},
        { "location": "6232/TALK"    , "narrator": "神楽", "text": "でもたいていはロボかおっさん"},
        { "location": "6234/SEL"     , "narrator": "", "text": "ゲームユーザーに合わせてるんじゃない？"},
        { "location": "6235/SEL"     , "narrator": "", "text": "$me$は神楽には勝てないから"},
        { "location": "6236/SEL"     , "narrator": "", "text": "新機軸のゲーム開発すれば？"},
        { "location": "6237/ACT"     , "narrator": "", "text": "ゲームユーザーに合わせてるんじゃない？"},
        { "location": "6238/TALK"    , "narrator": "神楽", "text": "だろうね"},
        { "location": "6239/TALK"    , "narrator": "神楽", "text": "もっとこう女子向けのも出てほしいぴょん！"},
        { "location": "6240/ACT"     , "narrator": "", "text": "$me$は神楽には勝てないから"},
        { "location": "6241/TALK"    , "narrator": "神楽", "text": "それはゲームじゃなくて人生かな？"},
        { "location": "6242/TALK"    , "narrator": "神楽", "text": "ﾅﾝﾃﾈ冗談☆彡"},
        { "location": "6243/ACT"     , "narrator": "", "text": "新機軸のゲーム開発すれば？"},
        { "location": "6245/TALK"    , "narrator": "神楽", "text": "すればじゃなくてー"},
        { "location": "6246/TALK"    , "narrator": "神楽", "text": "$handlek$が開発して？"},
        { "location": "6247/TALK"    , "narrator": "神楽", "text": "そうしたらぴょんこ廃課金するぴょん！"},
        { "location": "6249/TALK"    , "narrator": "神楽", "text": "だから、ね？"},
        { "location": "6250/TALK"    , "narrator": "神楽", "text": "お願い☆彡"},
        { "location": "6251/TALK"    , "narrator": "神楽", "text": "なんてな！！！！！"}
