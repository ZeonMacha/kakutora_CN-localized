{
    "dir": "chap00/daydra/spev_ch01_007.js",
    "type": "",
    "info": {
        "story_id": "1007",
        "cid": "",
        "title": "スペシャルエピソード",
        "sub_title": "神楽ちゃんとお勉強"
    },
    "entry":
    [
        { "location": "28/TALK" , "narrator": "透明つばめ", "text": "うーん…この問題、\nどうやって解けば\nいいんだっけ…？"},
        { "location": "29/TALK" , "narrator": "透明神楽", "text": "二次方程式を使えば\n簡単に解けますよ。\n中学で習いましたよね？"},
        { "location": "30/TALK" , "narrator": "透明つばめ", "text": "え、えっと…。"},
        { "location": "33/TALK" , "narrator": "透明神楽", "text": "あ、あはは…、\nまさかつばめさん…、\n忘れちゃったんですか？"},
        { "location": "34/TALK" , "narrator": "透明つばめ", "text": "…………。"},
        { "location": "35/TALK" , "narrator": "透明神楽", "text": "…あ、あれ？"},
        { "location": "39/TALK" , "narrator": "透明つばめ", "text": "うわーん！！\n全然覚えてないよー！"},
        { "location": "41/TALK" , "narrator": "透明神楽", "text": "えぇっ！？"},
        { "location": "42/TALK" , "narrator": "透明つばめ", "text": "ど、どうしよう…。\nこの問題飛ばしても、\nどうにかなるかな？"},
        { "location": "43/TALK" , "narrator": "透明神楽", "text": "いえ、これが解けないと\n来週の小テストは\n絶望的ですよ？"},
        { "location": "45/TALK" , "narrator": "透明つばめ", "text": "ど、どうしよう…。\n中学の勉強から\nやり直さないとダメかな？"},
        { "location": "46/TALK" , "narrator": "透明神楽", "text": "と、とにかく落ち着いて。\n泣き止んでください。"},
        { "location": "47/TALK" , "narrator": "透明つばめ", "text": "う、うん…。"},
        { "location": "49/TALK" , "narrator": "透明神楽", "text": "…ちょっと、復習して\n思い出した方がいいかも\nしれませんね。"},
        { "location": "50/TALK" , "narrator": "透明神楽", "text": "ここでつまずくと、\nこれから先でも\n絶対困りますし。"},
        { "location": "52/TALK" , "narrator": "透明つばめ", "text": "…そうだよね。\nはぁ…。"},
        { "location": "53/TALK" , "narrator": "透明神楽", "text": "…でも、失礼ですけど\nつばめさん。"},
        { "location": "54/TALK" , "narrator": "透明神楽", "text": "よくそれで、高校受験\n乗り切れましたね？"},
        { "location": "55/TALK" , "narrator": "透明つばめ", "text": "うん…勉強もしたけど、\n運も強いのかも…。"},
        { "location": "58/TALK" , "narrator": "透明つばめ", "text": "やっぱり、\nほとんど独学で\n受験は無謀だったかな？"},
        { "location": "59/TALK" , "narrator": "透明神楽", "text": "え？"},
        { "location": "61/TALK" , "narrator": "透明つばめ", "text": "私…中学時代は\nずっと入院してたから…。"},
        { "location": "62/TALK" , "narrator": "透明つばめ", "text": "学校に行けない間、\nずっと病院のベッドで\n勉強してたの。"},
        { "location": "63/TALK" , "narrator": "透明つばめ", "text": "みんなに勉強、\n置いていかれるの\n嫌だったから…。"},
        { "location": "65/TALK" , "narrator": "透明神楽", "text": "…………。"},
        { "location": "66/TALK" , "narrator": "透明つばめ", "text": "でも、やっぱり学校で\n先生に教わらないと、\n身に付かないよね。"},
        { "location": "67/TALK" , "narrator": "透明つばめ", "text": "参考書とか読んでも、\nわからない問題は\nわからないままだったし。"},
        { "location": "68/TALK" , "narrator": "透明神楽", "text": "…そうだったんですか。"},
        { "location": "69/TALK" , "narrator": "透明つばめ", "text": "あ、あはは、言い訳だね。\nわたしがバカなのは\n事実なんだし…。"},
        { "location": "70/TALK" , "narrator": "透明神楽", "text": "…本当にバカな人は、\nみんなに置いていかれるの\n嫌がったり…。"},
        { "location": "71/TALK" , "narrator": "透明神楽", "text": "独学で勉強しようなんて\n思いませんよ。"},
        { "location": "72/TALK" , "narrator": "透明つばめ", "text": "そ、そうかなぁ？"},
        { "location": "73/TALK" , "narrator": "透明神楽", "text": "そうですよ。"},
        { "location": "74/TALK" , "narrator": "透明神楽", "text": "つばめさんは、\n教えてくれる人が\nいなかったから…。"},
        { "location": "75/TALK" , "narrator": "透明神楽", "text": "解き方をちゃんと\n理解できなかった\nだけです。"},
        { "location": "77/TALK" , "narrator": "透明神楽", "text": "だから、わらないところは\n私が全部教えます！"},
        { "location": "78/TALK" , "narrator": "透明つばめ", "text": "で、でも、神楽ちゃんに\n迷惑だし…。"},
        { "location": "79/TALK" , "narrator": "透明神楽", "text": "つばめさんと私の立場が\n逆だったら、迷惑って\n思うんですか？"},
        { "location": "80/TALK" , "narrator": "透明つばめ", "text": "そ、そんなこと\nないけど…。"},
        { "location": "81/TALK" , "narrator": "透明神楽", "text": "じゃあ、迷惑だなんて\n言わないでください。"},
        { "location": "82/TALK" , "narrator": "透明神楽", "text": "…もちろん、つばめさんが\n嫌だっていうなら、\n無理は言いませんけど。"},
        { "location": "83/TALK" , "narrator": "透明つばめ", "text": "…ううん。"},
        { "location": "85/TALK" , "narrator": "透明つばめ", "text": "それじゃあ、\nわたしに勉強\n教えてくれる？"},
        { "location": "86/TALK" , "narrator": "透明神楽", "text": "もちろんです。"},
        { "location": "88/TALK" , "narrator": "透明つばめ", "text": "ありがとう、\n神楽ちゃん先生！"},
        { "location": "90/TALK" , "narrator": "透明神楽", "text": "それじゃあ、ちょっと\n復習で中学の問題から\n始めますね。"},
        { "location": "91/TALK" , "narrator": "透明つばめ", "text": "うん…でも、\n小テストまでに\n間に合うかなぁ？"},
        { "location": "93/TALK" , "narrator": "透明神楽", "text": "ふふっ…つばめさん。"},
        { "location": "94/TALK" , "narrator": "透明神楽", "text": "教えるからには、\n小テストで満点取れる\nくらい…。"},
        { "location": "95/TALK" , "narrator": "透明神楽", "text": "きっちり、教えますよ。"},
        { "location": "96/TALK" , "narrator": "透明つばめ", "text": "ま、満点！？"},
        { "location": "97/TALK" , "narrator": "透明神楽", "text": "勉強を教える以上、\n悪い点を取らせるわけには\nいきません。"},
        { "location": "98/TALK" , "narrator": "透明神楽", "text": "今日から放課後は、\n毎日勉強ですよ！"},
        { "location": "102/TALK", "narrator": "透明つばめ", "text": "うわーん！！\nそれはそれで辛いよー！"}
    ]
}
