{
    "dir": "dramatics/daydra/drm_ch03_00_720.js",
    "type": "Episode",
    "info": {
        "story_id": "3072",
        "cid": "gabriella",
        "title": "らぶとーく  第73話",
        "sub_title": "お父さん、という存在"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "お父さん、という存在"},
        { "location": "20/TALK"   , "narrator": "つばめ", "text": "はぁ…こんなこと、\n一々送って来なくて\nいいのに…。"},
        { "location": "23/TALK"   , "narrator": "ガブリエラ", "text": "何廊下でブツブツ\n言ってんのよ？"},
        { "location": "25/TALK"   , "narrator": "つばめ", "text": "あ、ガブちゃん…。"},
        { "location": "26/TALK"   , "narrator": "ガブリエラ", "text": "何？\nＷＡＶＥ？"},
        { "location": "29/TALK"   , "narrator": "つばめ", "text": "うん、お父さんから\nなんだけど――"},
        { "location": "30/TALK"   , "narrator": "つばめ", "text": "いつまで経っても\n過保護過ぎて、ちょっと\n困ってるの…。"},
        { "location": "31/TALK"   , "narrator": "ガブリエラ", "text": "…お父さんの気持ちも\nわからなくはないわね。"},
        { "location": "35/TALK"   , "narrator": "つばめ", "text": "もぉ、どういう意味？"},
        { "location": "36/TALK"   , "narrator": "ガブリエラ", "text": "落ち込ませそうだから\n詳しくは言わないで\nおくわ。"},
        { "location": "39/TALK"   , "narrator": "つばめ", "text": "そっちの方が余計に\n落ち込みそうなん\nだけど…。"},
        { "location": "40/TALK"   , "narrator": "ガブリエラ", "text": "てか、つばめの場合は\n急にこっちで暮らすのが\n決まったんだし――"},
        { "location": "41/TALK"   , "narrator": "ガブリエラ", "text": "人一倍心配されても、\n仕方ないと思うけど？"},
        { "location": "42/TALK"   , "narrator": "つばめ", "text": "そうかなぁ…？"},
        { "location": "43/TALK"   , "narrator": "ガブリエラ", "text": "兄弟もいないんでしょ？"},
        { "location": "44/TALK"   , "narrator": "ガブリエラ", "text": "一人娘なんだから、\nそりゃ過保護になっても\n当然よ。"},
        { "location": "45/TALK"   , "narrator": "つばめ", "text": "うーん、そっかぁ…。"},
        { "location": "47/TALK"   , "narrator": "つばめ", "text": "でも、それなら\nガブちゃんも\n大変じゃない？"},
        { "location": "48/TALK"   , "narrator": "ガブリエラ", "text": "あたしが？"},
        { "location": "49/TALK"   , "narrator": "つばめ", "text": "だって、ガブちゃんも\n一人娘だし、しかも\n家はポーランドでしょ？"},
        { "location": "50/TALK"   , "narrator": "つばめ", "text": "外国での一人暮らしを、\nよくお父さんは許して\nくれたね？"},
        { "location": "53/TALK"   , "narrator": "ガブリエラ", "text": "あー…まあ、うちは\nちょっと色々あって…。"},
        { "location": "54/TALK"   , "narrator": "つばめ", "text": "色々？"},
        { "location": "55/TALK"   , "narrator": "ガブリエラ", "text": "…つばめにはうちの\n事情、まだ話して\nなかったんだったわ…。"},
        { "location": "56/TALK"   , "narrator": "ガブリエラ", "text": "どうしよう…。"},
        { "location": "58/TALK"   , "narrator": "ガブリエラ", "text": "…ちょっと待って。\nＷＡＶＥを一件\n送るから…。"},
        { "location": "70/TALK"   , "narrator": "ガブリエラ", "text": "面倒なことになったわ"},
        { "location": "71/TALK"   , "narrator": "ガブリエラ", "text": "つばめには"},
        { "location": "72/TALK"   , "narrator": "ガブリエラ", "text": "お父さんと絶縁状態にあることを教えてなかったの"},
        { "location": "73/SEL"    , "narrator": "", "text": "今、教えれば？"},
        { "location": "74/ACT"    , "narrator": "", "text": "今、教えれば？"},
        { "location": "76/TALK"   , "narrator": "ガブリエラ", "text": "却下"},
        { "location": "77/TALK"   , "narrator": "ガブリエラ", "text": "つばめにそんなこと言ったらどうなると思う？"},
        { "location": "78/TALK"   , "narrator": "ガブリエラ", "text": "絶対お節介焼いてきそうだし"},
        { "location": "79/TALK"   , "narrator": "ガブリエラ", "text": "とにかく"},
        { "location": "80/TALK"   , "narrator": "ガブリエラ", "text": "上手く言い逃れるためにはなんて言えばいいと思う？"},
        { "location": "81/SEL"    , "narrator": "", "text": "自立してるから、と言ってやれ"},
        { "location": "82/SEL"    , "narrator": "", "text": "家出して来たんだ、と言ってやれ"},
        { "location": "83/SEL"    , "narrator": "", "text": "そっちが過保護過ぎるんだと言ってやれ"},
        { "location": "84/ACT"    , "narrator": "", "text": "自立してるから、と言ってやれ"},
        { "location": "85/TALK"   , "narrator": "ガブリエラ", "text": "なるほど"},
        { "location": "86/TALK"   , "narrator": "ガブリエラ", "text": "確かにそれはあるかもね"},
        { "location": "98/TALK"   , "narrator": "ガブリエラ", "text": "…まあ、あたしは\nつばめとは違って\n自立してるから――"},
        { "location": "99/TALK"   , "narrator": "ガブリエラ", "text": "日本に行くって言っても\n反対はされなかったわ。"},
        { "location": "101/TALK"  , "narrator": "つばめ", "text": "そうなの！？"},
        { "location": "102/TALK"  , "narrator": "つばめ", "text": "やっぱり、ガブちゃんは\n凄いなぁ…。"},
        { "location": "103/TALK"  , "narrator": "つばめ", "text": "年上のわたしの方が\n親に心配されてるのが、\nちょっと恥ずかしいよ。"},
        { "location": "105/TALK"  , "narrator": "ガブリエラ", "text": "いや、それが普通\nだから。"},
        { "location": "106/TALK"  , "narrator": "ガブリエラ", "text": "うちはその辺…\nちょっと特別だから…。"},
        { "location": "107/TALK"  , "narrator": "つばめ", "text": "…？"},
        { "location": "110/TALK"  , "narrator": "ガブリエラ", "text": "な、なんでもない！"},
        { "location": "111/TALK"  , "narrator": "ガブリエラ", "text": "とにかく、心配して\n色々ＷＡＶＥを送って\n来てるんだから――"},
        { "location": "112/TALK"  , "narrator": "ガブリエラ", "text": "ちゃんと返信して\nあげなさいよ？"},
        { "location": "113/TALK"  , "narrator": "つばめ", "text": "…しないとダメかな？"},
        { "location": "116/TALK"  , "narrator": "ガブリエラ", "text": "当たり前じゃない。"},
        { "location": "117/TALK"  , "narrator": "ガブリエラ", "text": "自立できてなくて\n心配かけさせてる\nつばめが悪いんだし。"},
        { "location": "119/TALK"  , "narrator": "つばめ", "text": "そ、それ言われたら\n何も言い返せない\nよぉ…。"},
        { "location": "120/TALK"  , "narrator": "ガブリエラ", "text": "言い返さなくていいから\n返信しなさいよ。"},
        { "location": "122/TALK"  , "narrator": "ガブリエラ", "text": "…贅沢な悩みよね。"},
        { "location": "123/TALK"  , "narrator": "ガブリエラ", "text": "まったく気にかけて\nもらえないあたしから\nしたら――"},
        { "location": "125/TALK"  , "narrator": "ガブリエラ", "text": "凄い羨ましいこと\nなのに…。"},
        { "location": "126/ACT"   , "narrator": "", "text": "家出して来たんだ、と言ってやれ"},
        { "location": "127/TALK"  , "narrator": "ガブリエラ", "text": "ウソってバレバレじゃない？"},
        { "location": "128/TALK"  , "narrator": "ガブリエラ", "text": "いや"},
        { "location": "129/TALK"  , "narrator": "ガブリエラ", "text": "つばめなら信じそうね"},
        { "location": "141/TALK"  , "narrator": "ガブリエラ", "text": "…実はね、これは\nアーヤとまほにしか\n言ってないんだけど――"},
        { "location": "142/TALK"  , "narrator": "ガブリエラ", "text": "あたし、家出して\n日本に来てるの。"},
        { "location": "144/TALK"  , "narrator": "つばめ", "text": "ふーん、家出…。"},
        { "location": "147/TALK"  , "narrator": "つばめ", "text": "家出！？"},
        { "location": "150/TALK"  , "narrator": "ガブリエラ", "text": "どうしてもお父さんと\n気が合わなくて――"},
        { "location": "151/TALK"  , "narrator": "ガブリエラ", "text": "こんな家にいられない、\nって着の身着のままで\n日本に来た、ってわけ。"},
        { "location": "152/TALK"  , "narrator": "つばめ", "text": "…有資格者だから\n日本に呼ばれた、って\nわけじゃないの？"},
        { "location": "153/TALK"  , "narrator": "ガブリエラ", "text": "それがわかったの、\n日本に来てからだし。"},
        { "location": "154/TALK"  , "narrator": "ガブリエラ", "text": "だからまあ、有資格者\nじゃなかったとしたら、\n今頃どうなってたか…。"},
        { "location": "156/TALK"  , "narrator": "つばめ", "text": "そんな…。"},
        { "location": "159/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "160/TALK"  , "narrator": "ガブリエラ", "text": "ぷっ…バカね。\n冗談に決まってる\nじゃない。"},
        { "location": "163/TALK"  , "narrator": "つばめ", "text": "…え？"},
        { "location": "164/TALK"  , "narrator": "ガブリエラ", "text": "冗談よ、冗談。\nっていうか、常識的に\n考えればわかるでしょ？"},
        { "location": "165/TALK"  , "narrator": "ガブリエラ", "text": "中学生のあたしが、\n家出で外国まで\n来れると思う？"},
        { "location": "167/TALK"  , "narrator": "つばめ", "text": "ひ、ヒドイよ！\nわたし、本気で心配\nしたんだよ！？"},
        { "location": "169/TALK"  , "narrator": "ガブリエラ", "text": "あはは、ごめんって。"},
        { "location": "171/TALK"  , "narrator": "ガブリエラ", "text": "っていうか、つばめは\n何でもかんでも信じ過ぎ\nだっての。"},
        { "location": "172/TALK"  , "narrator": "ガブリエラ", "text": "ちょっと考えれば\nウソってわかるように\n言ったつもりだけど？"},
        { "location": "173/TALK"  , "narrator": "つばめ", "text": "でも、ガブちゃんなら\n本当にやりそうだし…。"},
        { "location": "174/TALK"  , "narrator": "ガブリエラ", "text": "どういう意味よ！？"},
        { "location": "176/TALK"  , "narrator": "つばめ", "text": "えっ！？　えっと…。"},
        { "location": "178/TALK"  , "narrator": "つばめ", "text": "あ、ああ、そうだ！\nお父さんに返信しないと\nいけなかった！"},
        { "location": "179/TALK"  , "narrator": "ガブリエラ", "text": "…あんた、逃げ方が\n随分上手くなったわね？"},
        { "location": "180/TALK"  , "narrator": "つばめ", "text": "そ、そうかな…？\nごめん…。"},
        { "location": "181/TALK"  , "narrator": "ガブリエラ", "text": "はぁ…まあ、いつもの\nことだから、疲れるし\n一々怒ってらんないわ。"},
        { "location": "182/TALK"  , "narrator": "ガブリエラ", "text": "ほら、さっさと\n返信しちゃいなさい。"},
        { "location": "185/TALK"  , "narrator": "つばめ", "text": "う、うん。\nえっと…。"},
        { "location": "186/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "187/TALK"  , "narrator": "ガブリエラ", "text": "お父さん、\n今頃何してるのかな？"},
        { "location": "188/TALK"  , "narrator": "ガブリエラ", "text": "…あたしも、ちょっとは\n気にかけてほしいのに。"},
        { "location": "190/TALK"  , "narrator": "ガブリエラ", "text": "はぁ…。"},
        { "location": "192/TALK"  , "narrator": "つばめ", "text": "ん？　どうしたの？"},
        { "location": "194/TALK"  , "narrator": "ガブリエラ", "text": "…何でもないわよ。"},
        { "location": "195/ACT"   , "narrator": "", "text": "そっちが過保護過ぎるんだと言ってやれ"},
        { "location": "196/TALK"  , "narrator": "ガブリエラ", "text": "確かにそうね"},
        { "location": "197/TALK"  , "narrator": "ガブリエラ", "text": "前に聞いた話だと"},
        { "location": "198/TALK"  , "narrator": "ガブリエラ", "text": "毎日何かしら送って来るみたいだし"},
        { "location": "210/TALK"  , "narrator": "ガブリエラ", "text": "まあ、うちは色々と\n特別だから、って\nいうのはあるけど――"},
        { "location": "211/TALK"  , "narrator": "ガブリエラ", "text": "つばめのお父さんは、\nちょっと過保護過ぎ\nなのは確かかもね。"},
        { "location": "213/TALK"  , "narrator": "つばめ", "text": "やっぱりそう思う？"},
        { "location": "214/TALK"  , "narrator": "つばめ", "text": "今日なんて、お昼ご飯は\nちゃんと野菜も\n食べるんだぞ、って――"},
        { "location": "216/TALK"  , "narrator": "つばめ", "text": "そんなこと書いて\n送って来るくらいだし。"},
        { "location": "217/TALK"  , "narrator": "ガブリエラ", "text": "…過保護なお父さんも\nどうかと思うけど――"},
        { "location": "218/TALK"  , "narrator": "ガブリエラ", "text": "それだけ心配されてる\nつばめにも問題あるん\nじゃない？"},
        { "location": "219/TALK"  , "narrator": "つばめ", "text": "お、お父さんが\n心配性過ぎるだけだよ！"},
        { "location": "221/TALK"  , "narrator": "つばめ", "text": "もぅ、お父さんのせいで\nあたしがダメ人間と\n勘違いされちゃうよ…。"},
        { "location": "222/TALK"  , "narrator": "ガブリエラ", "text": "いや、そこまでは\n言ってないし…。"},
        { "location": "223/TALK"  , "narrator": "ガブリエラ", "text": "ってか、そんなに\nお父さんのこと\n苦手とはね…。"},
        { "location": "225/TALK"  , "narrator": "つばめ", "text": "あ、ううん。\n違うよ。"},
        { "location": "226/TALK"  , "narrator": "つばめ", "text": "お父さんのことは\n苦手でも嫌いでも\nないよ。"},
        { "location": "227/TALK"  , "narrator": "つばめ", "text": "っていうか、むしろ\n大好きだし…。"},
        { "location": "229/TALK"  , "narrator": "ガブリエラ", "text": "はぁ？　あんた、\n今まで言ってたことと\n違くない？"},
        { "location": "231/TALK"  , "narrator": "つばめ", "text": "そ、そうかな？\nそんなことないと\n思うけど…。"},
        { "location": "232/TALK"  , "narrator": "つばめ", "text": "過保護過ぎるのが\nちょっと困る、って\nいうのは本当だけど――"},
        { "location": "233/TALK"  , "narrator": "つばめ", "text": "やっぱり、心配して\nもらえるのって、\n嬉しいよ…。"},
        { "location": "234/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "236/TALK"  , "narrator": "つばめ", "text": "えっと…\nわかり難いかな？"},
        { "location": "237/TALK"  , "narrator": "ガブリエラ", "text": "ううん、平気。\nつばめの言ってること、\nよくわかるし…。"},
        { "location": "238/TALK"  , "narrator": "ガブリエラ", "text": "それに、ちょっとだけ\n羨ましく思うわ。"},
        { "location": "239/TALK"  , "narrator": "つばめ", "text": "え？"},
        { "location": "242/TALK"  , "narrator": "ガブリエラ", "text": "…何でもない。"},
        { "location": "245/TALK"  , "narrator": "ガブリエラ", "text": "ほら、早く返信して\nあげなさいよ。"},
        { "location": "249/TALK"  , "narrator": "つばめ", "text": "う、うん。\nえっと…。"},
        { "location": "252/TALK"  , "narrator": "ガブリエラ", "text": "…お父さんも、あたしの\nこと、少しは心配して\nくれてるかしら？"}
    ]
}
