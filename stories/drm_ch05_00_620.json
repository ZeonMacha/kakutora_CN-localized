    "entry":
    [
        { "location": "5/SCENARIO", "narrator": "", "text": "しあわせのかたち"},
        { "location": "30/TALK"   , "narrator": "神楽", "text": "しあわせの色と"},
        { "location": "31/TALK"   , "narrator": "神楽", "text": "しあわせの味が詰まったお弁当箱は"},
        { "location": "32/TALK"   , "narrator": "神楽", "text": "しあわせのかたち"},
        { "location": "34/SEL"    , "narrator": "", "text": "$me$も食べたいな"},
        { "location": "35/SEL"    , "narrator": "", "text": "神楽が作ったの？"},
        { "location": "36/SEL"    , "narrator": "", "text": "$me$が作ってあげる！"},
        { "location": "37/ACT"    , "narrator": "", "text": "$me$も食べたいな"},
        { "location": "38/TALK"   , "narrator": "神楽", "text": "$handle$もしあわせになりたいぴょん♪"},
        { "location": "40/TALK"   , "narrator": "神楽", "text": "それともお腹が空いてるの？"},
        { "location": "41/ACT"    , "narrator": "", "text": "神楽が作ったの？"},
        { "location": "42/TALK"   , "narrator": "神楽", "text": "ぴょんこが作った～！"},
        { "location": "43/TALK"   , "narrator": "神楽", "text": "脳内でね★"},
        { "location": "44/ACT"    , "narrator": "", "text": "$me$が作ってあげる！"},
        { "location": "46/TALK"   , "narrator": "神楽", "text": "ＳＮＳ映えするやつでお願い♪"},
        { "location": "48/TALK"   , "narrator": "神楽", "text": "$handle$はお弁当に絶対入れたいものって何？"},
        { "location": "50/SEL"    , "narrator": "", "text": "卵焼き"},
        { "location": "51/SEL"    , "narrator": "", "text": "タコさんウインナー"},
        { "location": "52/SEL"    , "narrator": "", "text": "唐揚げ"},
        { "location": "53/SEL"    , "narrator": "", "text": "おにぎり"},
        { "location": "54/SEL"    , "narrator": "", "text": "シウマイ"},
        { "location": "55/SEL"    , "narrator": "", "text": "バラン"},
        { "location": "56/SEL"    , "narrator": "", "text": "ミートボール"},
        { "location": "57/SEL"    , "narrator": "", "text": "箸でしょー"},
        { "location": "58/ACT"    , "narrator": "", "text": "卵焼き"},
        { "location": "59/TALK"   , "narrator": "神楽", "text": "それ絶対外せない！"},
        { "location": "60/ACT"    , "narrator": "", "text": "タコさんウインナー"},
        { "location": "61/TALK"   , "narrator": "神楽", "text": "イイネイイネ！"},
        { "location": "62/ACT"    , "narrator": "", "text": "唐揚げ"},
        { "location": "63/TALK"   , "narrator": "神楽", "text": "ガッツリ系だね"},
        { "location": "64/ACT"    , "narrator": "", "text": "おにぎり"},
        { "location": "65/TALK"   , "narrator": "神楽", "text": "お弁当っぽい♪"},
        { "location": "66/ACT"    , "narrator": "", "text": "シウマイ"},
        { "location": "67/TALK"   , "narrator": "神楽", "text": "、、、"},
        { "location": "69/TALK"   , "narrator": "神楽", "text": "浜ッ子だったの？"},
        { "location": "70/ACT"    , "narrator": "", "text": "バラン"},
        { "location": "71/TALK"   , "narrator": "神楽", "text": "それ飾りでしょ！？"},
        { "location": "72/ACT"    , "narrator": "", "text": "ミートボール"},
        { "location": "73/TALK"   , "narrator": "神楽", "text": "アリだよね"},
        { "location": "74/ACT"    , "narrator": "", "text": "箸でしょー"},
        { "location": "75/TALK"   , "narrator": "神楽", "text": "まあそうですけどー"},
        { "location": "77/TALK"   , "narrator": "神楽", "text": "デパ地下や駅ビルのオシャレデリだと"},
        { "location": "78/TALK"   , "narrator": "神楽", "text": "お弁当っていうよりランチボックスって感じでしょ"},
        { "location": "79/TALK"   , "narrator": "神楽", "text": "華やかで美味しくて栄養バランスもよくて"},
        { "location": "81/TALK"   , "narrator": "神楽", "text": "ぴょんこはあれｽｷなんだぴょん"},
        { "location": "83/SEL"    , "narrator": "", "text": "もっと肉々しいやつがいい！"},
        { "location": "84/SEL"    , "narrator": "", "text": "わかるー"},
        { "location": "85/SEL"    , "narrator": "", "text": "でもちょっと高いよね…"},
        { "location": "86/ACT"    , "narrator": "", "text": "もっと肉々しいやつがいい！"},
        { "location": "87/TALK"   , "narrator": "神楽", "text": "肉ラーめ！"},
        { "location": "88/ACT"    , "narrator": "", "text": "わかるー"},
        { "location": "89/TALK"   , "narrator": "神楽", "text": "でしょでしょ～"},
        { "location": "90/ACT"    , "narrator": "", "text": "でもちょっと高いよね…"},
        { "location": "91/TALK"   , "narrator": "神楽", "text": "それは言うな！！！！"},
        { "location": "93/TALK"   , "narrator": "神楽", "text": "でさー"},
        { "location": "94/TALK"   , "narrator": "神楽", "text": "正統派お弁当ってどんなやつだと思う？"},
        { "location": "96/SEL"    , "narrator": "", "text": "駅弁でしょ！"},
        { "location": "97/SEL"    , "narrator": "", "text": "お弁当屋さんの弁当かな～"},
        { "location": "98/SEL"    , "narrator": "", "text": "家族の手作り弁当"},
        { "location": "99/ACT"    , "narrator": "", "text": "駅弁でしょ！"},
        { "location": "100/TALK"  , "narrator": "神楽", "text": "確かにそうかも"},
        { "location": "101/TALK"  , "narrator": "神楽", "text": "旅行気分も盛り上がるし"},
        { "location": "102/TALK"  , "narrator": "神楽", "text": "いい感じ♪"},
        { "location": "112/ACT"   , "narrator": "", "text": "お弁当屋さんの弁当かな～"},
        { "location": "113/TALK"  , "narrator": "神楽", "text": "お弁当らしいお弁当♪"},
        { "location": "114/TALK"  , "narrator": "神楽", "text": "あれもいいよね"},
        { "location": "115/TALK"  , "narrator": "神楽", "text": "ぴょんこにはご飯多すぎるけど"},
        { "location": "125/ACT"   , "narrator": "", "text": "家族の手作り弁当"},
        { "location": "128/TALK"  , "narrator": "神楽", "text": "あ"},
        { "location": "130/TALK"  , "narrator": "神楽", "text": "やっぱりそう？"},
        { "location": "131/TALK"  , "narrator": "神楽", "text": "小さい頃食べたママのお弁当とかそういうやつ"},
        { "location": "133/SEL"   , "narrator": "", "text": "また食べたいよね…"},
        { "location": "134/SEL"   , "narrator": "", "text": "いい思い出があるんだね"},
        { "location": "135/SEL"   , "narrator": "", "text": "すぐに作ってもらえるようになるよ"},
        { "location": "136/ACT"   , "narrator": "", "text": "また食べたいよね…"},
        { "location": "137/TALK"  , "narrator": "神楽", "text": "うん"},
        { "location": "138/ACT"   , "narrator": "", "text": "いい思い出があるんだね"},
        { "location": "139/TALK"  , "narrator": "神楽", "text": "あるに決まってるでしょ"},
        { "location": "140/TALK"  , "narrator": "神楽", "text": "世界一のママなんだから"},
        { "location": "141/ACT"   , "narrator": "", "text": "すぐに作ってもらえるようになるよ"},
        { "location": "143/TALK"  , "narrator": "神楽", "text": "そうだと"},
        { "location": "144/TALK"  , "narrator": "神楽", "text": "いいんだけど"},
        { "location": "146/TALK"  , "narrator": "神楽", "text": "なんかさ"},
        { "location": "147/TALK"  , "narrator": "神楽", "text": "今ママ大変すぎてそんなことしてくれないけど"},
        { "location": "148/TALK"  , "narrator": "神楽", "text": "ぴょんこは元のママに戻って欲しくて"},
        { "location": "151/TALK"  , "narrator": "神楽", "text": "それで頑張ってて"},
        { "location": "153/SEL"   , "narrator": "", "text": "知ってる"},
        { "location": "154/SEL"   , "narrator": "", "text": "頑張りすぎないで"},
        { "location": "155/SEL"   , "narrator": "", "text": "大丈夫だよきっと"},
        { "location": "156/ACT"   , "narrator": "", "text": "知ってる"},
        { "location": "157/TALK"  , "narrator": "神楽", "text": "だよね"},
        { "location": "158/ACT"   , "narrator": "", "text": "頑張りすぎないで"},
        { "location": "159/TALK"  , "narrator": "神楽", "text": "ありがと"},
        { "location": "161/TALK"  , "narrator": "神楽", "text": "そう言ってくれるのは$handle$だけぴょん、、、"},
        { "location": "162/TALK"  , "narrator": "神楽", "text": "ｷｭｰﾝ、、、"},
        { "location": "163/ACT"   , "narrator": "", "text": "大丈夫だよきっと"},
        { "location": "164/TALK"  , "narrator": "神楽", "text": "だよね"},
        { "location": "165/TALK"  , "narrator": "神楽", "text": "きっと"},
        { "location": "167/TALK"  , "narrator": "神楽", "text": "ぴょんこはそのことをずっと誰にも言えなくて"},
        { "location": "168/TALK"  , "narrator": "神楽", "text": "$handle$にバレた時はもうおしまいだって思って"},
        { "location": "170/SEL"   , "narrator": "", "text": "おしまいじゃなかったでしょ"},
        { "location": "171/SEL"   , "narrator": "", "text": "そんな気はしてたんだ"},
        { "location": "172/SEL"   , "narrator": "", "text": "そのくらいで終わったりしない"},
        { "location": "173/ACT"   , "narrator": "", "text": "おしまいじゃなかったでしょ"},
        { "location": "174/TALK"  , "narrator": "神楽", "text": "そうだね"},
        { "location": "175/TALK"  , "narrator": "神楽", "text": "違ってた"},
        { "location": "176/ACT"   , "narrator": "", "text": "そんな気はしてたんだ"},
        { "location": "177/TALK"  , "narrator": "神楽", "text": "あれ、、、"},
        { "location": "178/TALK"  , "narrator": "神楽", "text": "そうだったんだ、、、"},
        { "location": "179/ACT"   , "narrator": "", "text": "そのくらいで終わったりしない"},
        { "location": "180/TALK"  , "narrator": "神楽", "text": "うん"},
        { "location": "181/TALK"  , "narrator": "神楽", "text": "今はそう思う"},
        { "location": "183/TALK"  , "narrator": "神楽", "text": "バレてからはもういっかって気持ちもあったり"},
        { "location": "184/TALK"  , "narrator": "神楽", "text": "$handle$が結構優しいってわかったり"},
        { "location": "186/SEL"   , "narrator": "", "text": "めちゃくちゃ優しいつもりなんだけど"},
        { "location": "187/SEL"   , "narrator": "", "text": "そんなことないけど"},
        { "location": "188/SEL"   , "narrator": "", "text": "神楽にだけだよ"},
        { "location": "189/ACT"   , "narrator": "", "text": "めちゃくちゃ優しいつもりなんだけど"},
        { "location": "190/TALK"  , "narrator": "神楽", "text": "それは言い過ぎな気がｽﾙｹﾄﾞﾅｰ"},
        { "location": "191/ACT"   , "narrator": "", "text": "そんなことないけど"},
        { "location": "192/TALK"  , "narrator": "神楽", "text": "またまた"},
        { "location": "193/TALK"  , "narrator": "神楽", "text": "照れてるの？"},
        { "location": "195/ACT"   , "narrator": "", "text": "神楽にだけだよ"},
        { "location": "196/TALK"  , "narrator": "神楽", "text": "絶対絶対絶対？？？？"},
        { "location": "197/TALK"  , "narrator": "神楽", "text": "ぴょんこにだけ？？？"},
        { "location": "199/TALK"  , "narrator": "神楽", "text": "お弁当だけが思い出じゃなくて"},
        { "location": "200/TALK"  , "narrator": "神楽", "text": "ママと過ごした時間や場所とかそういうのも全部ひっくるめて"},
        { "location": "201/TALK"  , "narrator": "神楽", "text": "ぴょんこのことを見て欲しい"},
        { "location": "203/TALK"  , "narrator": "神楽", "text": "今のママもぴょんこにとっては"},
        { "location": "204/TALK"  , "narrator": "神楽", "text": "本物のママだけど"},
        { "location": "207/SEL"   , "narrator": "", "text": "わかる"},
        { "location": "208/SEL"   , "narrator": "", "text": "手伝えることがあればいいんだけど"},
        { "location": "209/SEL"   , "narrator": "", "text": "$me$も$me$だよ！"},
        { "location": "210/ACT"   , "narrator": "", "text": "わかる"},
        { "location": "211/TALK"  , "narrator": "神楽", "text": "うん"},
        { "location": "212/TALK"  , "narrator": "神楽", "text": "ありがとう"},
        { "location": "213/ACT"   , "narrator": "", "text": "手伝えることがあればいいんだけど"},
        { "location": "214/TALK"  , "narrator": "神楽", "text": "何かあるかな、、、"},
        { "location": "215/TALK"  , "narrator": "神楽", "text": "でも話し相手になってくれればそれだけで"},
        { "location": "216/ACT"   , "narrator": "", "text": "$me$も$me$だよ！"},
        { "location": "218/TALK"  , "narrator": "神楽", "text": "知ってるし！！！"},
        { "location": "219/TALK"  , "narrator": "神楽", "text": "そういう話してないし！"},
        { "location": "221/TALK"  , "narrator": "神楽", "text": "ﾀﾞｲｽｷ、、、"},
        { "location": "223/TALK"  , "narrator": "神楽", "text": "しあわせのかたちのお弁当"},
        { "location": "225/TALK"  , "narrator": "神楽", "text": "今度はぴょんこが作ってあげるの"},
        { "location": "226/TALK"  , "narrator": "神楽", "text": "$handle$とママに"}
    ]
}
