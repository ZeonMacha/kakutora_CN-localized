    [
        { "location": "7/SCENARIO", "narrator": "", "text": "000_お手伝い"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "日本の学生って"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "学校も掃除するのよね"},
        { "location": "35/SEL"    , "narrator": "", "text": "さぼってもいいんじゃない"},
        { "location": "36/SEL"    , "narrator": "", "text": "普通するもんでしょ"},
        { "location": "37/SEL"    , "narrator": "", "text": "ポーランドはしないんだ？"},
        { "location": "38/ACT"    , "narrator": "", "text": "さぼってもいいんじゃない"},
        { "location": "39/TALK"   , "narrator": "ガブリエラ", "text": "そういう意味じゃないのよ"},
        { "location": "40/ACT"    , "narrator": "", "text": "普通するもんでしょ"},
        { "location": "41/TALK"   , "narrator": "ガブリエラ", "text": "普通"},
        { "location": "42/TALK"   , "narrator": "ガブリエラ", "text": "普通なの？"},
        { "location": "43/ACT"    , "narrator": "", "text": "ポーランドはしないんだ？"},
        { "location": "45/TALK"   , "narrator": "ガブリエラ", "text": "そうなのよ"},
        { "location": "46/TALK"   , "narrator": "ガブリエラ", "text": "だから最初びっくりしたわ"},
        { "location": "47/TALK"   , "narrator": "ガブリエラ", "text": "今は慣れたけど"},
        { "location": "49/TALK"   , "narrator": "ガブリエラ", "text": "アルバイトとかね？"},
        { "location": "50/TALK"   , "narrator": "ガブリエラ", "text": "お仕事でお掃除をするのはわかるのよ"},
        { "location": "51/TALK"   , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "52/TALK"   , "narrator": "ガブリエラ", "text": "学校は勉強をしに行くところなのにね"},
        { "location": "54/SEL"    , "narrator": "", "text": "掃除も勉強のうち"},
        { "location": "55/SEL"    , "narrator": "", "text": "そういう考え方もありか"},
        { "location": "56/ACT"    , "narrator": "", "text": "掃除も勉強のうち"},
        { "location": "57/TALK"   , "narrator": "ガブリエラ", "text": "そういうことなのね？"},
        { "location": "58/TALK"   , "narrator": "ガブリエラ", "text": "それが日本人の考え方ってやつなのね"},
        { "location": "59/TALK"   , "narrator": "ガブリエラ", "text": "不思議だわ"},
        { "location": "60/ACT"    , "narrator": "", "text": "そういう考え方もありか"},
        { "location": "61/TALK"   , "narrator": "ガブリエラ", "text": "だって"},
        { "location": "62/TALK"   , "narrator": "ガブリエラ", "text": "そうでしょう？"},
        { "location": "63/TALK"   , "narrator": "ガブリエラ", "text": "違うかしら"}
    ]
}
