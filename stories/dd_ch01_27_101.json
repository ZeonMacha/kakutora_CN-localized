    "entry":
    [
        { "location": "8/SCENARIO", "narrator": "", "text": "カゴの中の鳥の名は"},
        { "location": "27/TALK"   , "narrator": "つばめ", "text": "……。"},
        { "location": "29/TALK"   , "narrator": "つばめ", "text": "キリトくんヒカルくん\nありがとう、\n見逃してくれて……。"},
        { "location": "31/TALK"   , "narrator": "つばめ", "text": "……。"},
        { "location": "44/TALK"   , "narrator": "つばめ", "text": "$handle1$はすごいね"},
        { "location": "45/TALK"   , "narrator": "つばめ", "text": "言うとおりにしてょかったょ"},
        { "location": "48/SEL"    , "narrator": "", "text": "よくない"},
        { "location": "49/SEL"    , "narrator": "", "text": "今はいいけど"},
        { "location": "50/SEL"    , "narrator": "", "text": "もう聞かないで"},
        { "location": "51/ACT"    , "narrator": "", "text": "よくない"},
        { "location": "52/TALK"   , "narrator": "つばめ", "text": "ぇ"},
        { "location": "54/TALK"   , "narrator": "つばめ", "text": "なんで"},
        { "location": "55/ACT"    , "narrator": "", "text": "今はいいけど"},
        { "location": "56/TALK"   , "narrator": "つばめ", "text": "ぅん"},
        { "location": "57/TALK"   , "narrator": "つばめ", "text": "早く合流しないとだけど"},
        { "location": "58/ACT"    , "narrator": "", "text": "もう聞かないで"},
        { "location": "59/TALK"   , "narrator": "つばめ", "text": "ぇ"},
        { "location": "61/TALK"   , "narrator": "つばめ", "text": "そんな"},
        { "location": "63/TALK"   , "narrator": "つばめ", "text": "$handle1$のおかげで"},
        { "location": "64/TALK"   , "narrator": "つばめ", "text": "見つからなかったんだょ"},
        { "location": "67/TALK"   , "narrator": "つばめ", "text": "違うね"},
        { "location": "68/TALK"   , "narrator": "つばめ", "text": "見つかったけど"},
        { "location": "70/TALK"   , "narrator": "つばめ", "text": "大丈夫だったんだょ"},
        { "location": "72/SEL"    , "narrator": "", "text": "それは…"},
        { "location": "73/SEL"    , "narrator": "", "text": "そうじゃない"},
        { "location": "74/SEL"    , "narrator": "", "text": "とにかくもう話しかけないで"},
        { "location": "75/ACT"    , "narrator": "", "text": "それは…"},
        { "location": "76/TALK"   , "narrator": "つばめ", "text": "そうでしょ？"},
        { "location": "77/ACT"    , "narrator": "", "text": "そうじゃない"},
        { "location": "78/TALK"   , "narrator": "つばめ", "text": "ぇ"},
        { "location": "79/TALK"   , "narrator": "つばめ", "text": "違うの？"},
        { "location": "80/ACT"    , "narrator": "", "text": "とにかくもう話しかけないで"},
        { "location": "81/TALK"   , "narrator": "つばめ", "text": "そんなこと"},
        { "location": "82/TALK"   , "narrator": "つばめ", "text": "何で言うの"},
        { "location": "84/TALK"   , "narrator": "つばめ", "text": "ねえ"},
        { "location": "86/SEL"    , "narrator": "", "text": "$me$の言うことは聞かないで"},
        { "location": "87/SEL"    , "narrator": "", "text": "もう無理"},
        { "location": "88/SEL"    , "narrator": "", "text": "それがつばめのためなんだ"},
        { "location": "90/TALK"   , "narrator": "つばめ", "text": "どぅしちゃったの"},
        { "location": "91/TALK"   , "narrator": "つばめ", "text": "そんなこと"},
        { "location": "92/TALK"   , "narrator": "つばめ", "text": "なんで言うの"},
        { "location": "94/TALK"   , "narrator": "つばめ", "text": "ぁたし"},
        { "location": "95/TALK"   , "narrator": "つばめ", "text": "わかんなぃょ"},
        { "location": "96/ACT"    , "narrator": "", "text": "$me$の言うことは聞かないで"},
        { "location": "97/ACT"    , "narrator": "", "text": "もう無理"},
        { "location": "98/ACT"    , "narrator": "", "text": "それがつばめのためなんだ"},
        { "location": "111/TALK"  , "narrator": "つばめ", "text": "何？"},
        { "location": "113/TALK"  , "narrator": "つばめ", "text": "わたし全然\nわからないよ……。"},
        { "location": "161/TALK"  , "narrator": "百鶴", "text": "　"},
        { "location": "190/TALK"  , "narrator": "百鶴", "text": "む。\n誰かと思えば。"},
        { "location": "191/SEL"   , "narrator": "", "text": "なんだ新しい方か"},
        { "location": "192/SEL"   , "narrator": "", "text": "百鶴ちゃん愛してる"},
        { "location": "193/SEL"   , "narrator": "", "text": "百鶴結婚しよう"},
        { "location": "194/ACT"   , "narrator": "", "text": "なんだ新しい方か"},
        { "location": "195/TALK"  , "narrator": "百鶴", "text": "…名前、知ってますよね？"},
        { "location": "196/TALK"  , "narrator": "百鶴", "text": "そこで敢えて\n名前を呼ばないのは\n犯罪行為です。"},
        { "location": "197/SEL"   , "narrator": "", "text": "前回はあまり名前呼ぶなと言ってた気が"},
        { "location": "198/SEL"   , "narrator": "", "text": "愛するあまり照れて言えないだけだよ"},
        { "location": "199/ACT"   , "narrator": "", "text": "前回はあまり名前呼ぶなと言ってた気が"},
        { "location": "200/TALK"  , "narrator": "百鶴", "text": "前回は前回。\n今回は今回ですよ。"},
        { "location": "201/TALK"  , "narrator": "百鶴", "text": "ホントに仕方のない\n人ですね。"},
        { "location": "202/ACT"   , "narrator": "", "text": "愛するあまり照れて言えないだけだよ"},
        { "location": "203/TALK"  , "narrator": "百鶴", "text": "……。"},
        { "location": "204/TALK"  , "narrator": "百鶴", "text": "まあ、それなら\n仕方ありませんね。"},
        { "location": "206/ACT"   , "narrator": "", "text": "百鶴ちゃん愛してる"},
        { "location": "207/TALK"  , "narrator": "百鶴", "text": "出てきて早々\n愛の挨拶だなんて\n恥ずかしい人ですね。"},
        { "location": "208/ACT"   , "narrator": "", "text": "百鶴結婚しよう"},
        { "location": "209/TALK"  , "narrator": "百鶴", "text": "…っ！？\n失敗しました。"},
        { "location": "210/SEL"   , "narrator": "", "text": "？？"},
        { "location": "211/ACT"   , "narrator": "", "text": "？？"},
        { "location": "213/TALK"  , "narrator": "百鶴", "text": "婚姻届をまだ\n役所に取りに\nいってません！"},
        { "location": "214/TALK"  , "narrator": "百鶴", "text": "ご飯食べているヒマが\nあったら、役所に行けば\nよかったです……。"},
        { "location": "215/TALK"  , "narrator": "百鶴", "text": "今日は\nカレンもいない\n良き日だったのに。"},
        { "location": "217/TALK"  , "narrator": "百鶴", "text": "…と。\nそれはそうと。"},
        { "location": "218/TALK"  , "narrator": "百鶴", "text": "相変わらず意志は\nねじ曲げられますか？"},
        { "location": "220/SEL"   , "narrator": "", "text": "$me$が直しました！"},
        { "location": "221/SEL"   , "narrator": "", "text": "貴方たちの契約主がやってるそうじゃないですか"},
        { "location": "222/SEL"   , "narrator": "", "text": "本当は百鶴も荷担してるんじゃないの？"},
        { "location": "223/ACT"   , "narrator": "", "text": "$me$が直しました！"},
        { "location": "225/ACT"   , "narrator": "", "text": "貴方たちの契約主がやってるそうじゃないですか"},
        { "location": "227/ACT"   , "narrator": "", "text": "本当は百鶴も荷担してるんじゃないの？"},
        { "location": "231/SEL"   , "narrator": "", "text": "$me$が直す予定"},
        { "location": "232/SEL"   , "narrator": "", "text": "貴方たちの契約主がやってるそうじゃないですか"},
        { "location": "233/SEL"   , "narrator": "", "text": "本当は百鶴も荷担してるんじゃないの？"},
        { "location": "234/ACT"   , "narrator": "", "text": "$me$が直しました！"},
        { "location": "236/ACT"   , "narrator": "", "text": "貴方たちの契約主がやってるそうじゃないですか"},
        { "location": "238/ACT"   , "narrator": "", "text": "本当は百鶴も荷担してるんじゃないの？"},
        { "location": "243/TALK"  , "narrator": "百鶴", "text": "なるほど、\nそうだったんですか。"},
        { "location": "244/TALK"  , "narrator": "百鶴", "text": "ですが、それは本当に\n今のこのチャンネルの\n時間軸より手前ですか？"},
        { "location": "245/TALK"  , "narrator": "百鶴", "text": "後だった場合、まだ\n油断は出来ませんよ？"},
        { "location": "248/TALK"  , "narrator": "百鶴", "text": "なるほど、\n$handle$さんが\n直す係だったんですね。"},
        { "location": "249/TALK"  , "narrator": "百鶴", "text": "ではちゃっちゃと\n直しちゃってください。"},
        { "location": "252/TALK"  , "narrator": "百鶴", "text": "そうみたいですね。\n先ほど通達がありました。"},
        { "location": "253/TALK"  , "narrator": "百鶴", "text": "ですが、わたしには\nちょっと\nよくわかりません。"},
        { "location": "254/SEL"   , "narrator": "", "text": "半分契約主の人格なんでしょ？"},
        { "location": "255/ACT"   , "narrator": "", "text": "半分契約主の人格なんでしょ？"},
        { "location": "257/TALK"  , "narrator": "百鶴", "text": "だからなんでしょう？\n確かに契約主とは\n双子レベルの存在です。"},
        { "location": "258/TALK"  , "narrator": "百鶴", "text": "ですが所詮は他人格です。"},
        { "location": "259/TALK"  , "narrator": "百鶴", "text": "思想などはほぼ一致し、\n使命も志も同一ですが、\n考えは共有できません。"},
        { "location": "262/TALK"  , "narrator": "百鶴", "text": "まさか。\nわたしはどっちかというと\n被害者ですね。"},
        { "location": "263/SEL"   , "narrator": "", "text": "なんか被害受けたの？"},
        { "location": "264/ACT"   , "narrator": "", "text": "なんか被害受けたの？"},
        { "location": "266/TALK"  , "narrator": "百鶴", "text": "今$handle$さんに\n疑われました！"},
        { "location": "267/TALK"  , "narrator": "百鶴", "text": "ションボリです…。"},
        { "location": "270/TALK"  , "narrator": "百鶴", "text": "まあ、何にしても。"},
        { "location": "271/TALK"  , "narrator": "百鶴", "text": "追加だけではなく改ざんも\nできるとは、さすが\nわたしの上位互換です！"},
        { "location": "272/SEL"   , "narrator": "", "text": "感心してる場合じゃないよ"},
        { "location": "273/ACT"   , "narrator": "", "text": "感心してる場合じゃないよ"},
        { "location": "275/TALK"  , "narrator": "百鶴", "text": "いえ、ここは\n感心するところです！"},
        { "location": "276/TALK"  , "narrator": "百鶴", "text": "と、そんなことはさておき\n今回の要件は何でしょう？"},
        { "location": "277/SEL"   , "narrator": "", "text": "それはこっちが聞きたい"},
        { "location": "278/ACT"   , "narrator": "", "text": "それはこっちが聞きたい"},
        { "location": "280/TALK"  , "narrator": "百鶴", "text": "まあ多分、いつも通り、\nクランを倒して\n葛藤を鎮めるんですよね。"},
        { "location": "281/TALK"  , "narrator": "百鶴", "text": "けど……"},
        { "location": "283/TALK"  , "narrator": "百鶴", "text": "……。"},
        { "location": "284/TALK"  , "narrator": "百鶴", "text": "やっぱり。\n今回も連絡は\n入ってきていません。"},
        { "location": "285/SEL"   , "narrator": "", "text": "大丈夫。今回は番地を聞いてきているから"},
        { "location": "286/ACT"   , "narrator": "", "text": "大丈夫。今回は番地を聞いてきているから"},
        { "location": "288/TALK"  , "narrator": "百鶴", "text": "誰からです？"},
        { "location": "289/SEL"   , "narrator": "", "text": "エリカさんから"},
        { "location": "290/SEL"   , "narrator": "", "text": "千羽鶴から"},
        { "location": "291/ACT"   , "narrator": "", "text": "エリカさんから"},
        { "location": "293/ACT"   , "narrator": "", "text": "千羽鶴から"},
        { "location": "296/TALK"  , "narrator": "百鶴", "text": "誰ですって？"},
        { "location": "297/SEL"   , "narrator": "", "text": "エ…エリカさんから…です…"},
        { "location": "298/SEL"   , "narrator": "", "text": "千羽鶴から！"},
        { "location": "299/ACT"   , "narrator": "", "text": "エ…エリカさんから…です…"},
        { "location": "301/ACT"   , "narrator": "", "text": "千羽鶴から！"},
        { "location": "304/TALK"  , "narrator": "百鶴", "text": "え？？\n誰ですって！？"},
        { "location": "305/SEL"   , "narrator": "", "text": "すみません、\nエリカさんから…です…"},
        { "location": "306/SEL"   , "narrator": "", "text": "千羽鶴からだってば！"},
        { "location": "307/ACT"   , "narrator": "", "text": "すみません、\nエリカさんから…です…"},
        { "location": "309/ACT"   , "narrator": "", "text": "千羽鶴からだってば！"},
        { "location": "313/TALK"  , "narrator": "百鶴", "text": "もう一度！\n聞きますよ？\nだ・れ・で・す！？"},
        { "location": "314/SEL"   , "narrator": "", "text": "近い近い近い！！"},
        { "location": "315/ACT"   , "narrator": "", "text": "近い近い近い！！"},
        { "location": "317/TALK"  , "narrator": "百鶴", "text": "このままウッカリ\nチューしても\nいいんですよ？"},
        { "location": "331/TALK"  , "narrator": "百鶴", "text": "ひぁっ…"},
        { "location": "335/TALK"  , "narrator": "百鶴", "text": "ひぁっ…"},
        { "location": "344/TALK"  , "narrator": "百鶴", "text": "とまあ、\nそれはさておき。"},
        { "location": "345/TALK"  , "narrator": "百鶴", "text": "嘘つきは\n$handle$の\n始まりです！"},
        { "location": "346/TALK"  , "narrator": "百鶴", "text": "本当は、私たちの\n契約主では\nありませんよね？"},
        { "location": "347/SEL"   , "narrator": "", "text": "はい"},
        { "location": "348/SEL"   , "narrator": "", "text": "いいえ"},
        { "location": "349/SEL"   , "narrator": "", "text": "嘘ついてました"},
        { "location": "350/SEL"   , "narrator": "", "text": "すみません"},
        { "location": "351/SEL"   , "narrator": "", "text": "ごめんなさい"},
        { "location": "352/SEL"   , "narrator": "", "text": "もう一度チューしたい"},
        { "location": "353/SEL"   , "narrator": "", "text": "懺悔します"},
        { "location": "354/ACT"   , "narrator": "", "text": "はい"},
        { "location": "355/TALK"  , "narrator": "百鶴", "text": "そうです。\n素直が一番。"},
        { "location": "356/ACT"   , "narrator": "", "text": "いいえ"},
        { "location": "357/TALK"  , "narrator": "百鶴", "text": "いえ、否定されても、\nもう最初から\n知ってますんで。"},
        { "location": "358/TALK"  , "narrator": "百鶴", "text": "それにしても、そこまで\n嘘を貫き通されると、\nむしろ清々しいですね。"},
        { "location": "359/ACT"   , "narrator": "", "text": "嘘ついてました"},
        { "location": "360/TALK"  , "narrator": "百鶴", "text": "そうです。\n素直が一番。"},
        { "location": "361/ACT"   , "narrator": "", "text": "すみません"},
        { "location": "362/TALK"  , "narrator": "百鶴", "text": "そうです。\n素直が一番。"},
        { "location": "363/ACT"   , "narrator": "", "text": "ごめんなさい"},
        { "location": "364/TALK"  , "narrator": "百鶴", "text": "そうです。\n素直が一番。"},
        { "location": "365/ACT"   , "narrator": "", "text": "もう一度チューしたい"},
        { "location": "366/TALK"  , "narrator": "百鶴", "text": "どうぞどうぞ。"},
        { "location": "370/ACT"   , "narrator": "", "text": "懺悔します"},
        { "location": "371/TALK"  , "narrator": "百鶴", "text": "そうです。\n素直が一番。"},
        { "location": "373/TALK"  , "narrator": "百鶴", "text": "ですが！"},
        { "location": "375/TALK"  , "narrator": "百鶴", "text": "そういう事情でしたら、\n回すことはできませんね。"},
        { "location": "376/TALK"  , "narrator": "百鶴", "text": "わたしは契約主に\n忠実な司書ですから。"},
        { "location": "378/TALK"  , "narrator": "百鶴", "text": "だいたい、唐突に現れた\n馬ボーンの言う事など\n不許可に決まってます。"},
        { "location": "379/TALK"  , "narrator": "カレン　", "text": "何番地ですか？"},
        { "location": "380/SEL"   , "narrator": "", "text": "0x341"},
        { "location": "386/TALK"  , "narrator": "百鶴", "text": "そもそも我々の契約主とは\nココロに大きな負担を\n掛けずに輝ける未来へ――"},
        { "location": "391/TALK"  , "narrator": "百鶴", "text": "って。\nちょっと。"},
        { "location": "392/TALK"  , "narrator": "百鶴", "text": "何か扉が回るような音が\nしてませんか？"},
        { "location": "393/SEL"   , "narrator": "", "text": "百鶴うしろうしろ！"},
        { "location": "394/ACT"   , "narrator": "", "text": "百鶴うしろうしろ！"},
        { "location": "399/TALK"  , "narrator": "百鶴", "text": "ちょっと！\nまたあなたでしたか！"},
        { "location": "400/TALK"  , "narrator": "百鶴", "text": "勝手に扉を回すのは\nやめてもらえませんか？"},
        { "location": "401/TALK"  , "narrator": "カレン　", "text": "百鶴さんこそ、\n勝手に回すの拒否るのは\nやめてください！"},
        { "location": "408/TALK"  , "narrator": "百鶴", "text": "…ああ。\n着いてしまいました。"},
        { "location": "427/TALK"  , "narrator": "百鶴", "text": "さて。\n$handle$さん。"},
        { "location": "428/TALK"  , "narrator": "百鶴", "text": "本当に扉に\n入るんですか？"},
        { "location": "429/TALK"  , "narrator": "カレン　", "text": "もちろん\n入りますよね？"},
        { "location": "431/TALK"  , "narrator": "百鶴", "text": "わたしたちの契約主の\n指示ではありません。\nこれは契約違反です。"},
        { "location": "433/TALK"  , "narrator": "カレン　", "text": "本人がいなくなったら\n契約は無効です。"},
        { "location": "434/TALK"  , "narrator": "カレン　", "text": "だいたい、わたしに\nあんな酷いことしておいて\n未だに契約とか無理です。"},
        { "location": "435/TALK"  , "narrator": "カレン　", "text": "それに、エリカさんの方が\nよっぽど優しいですし、\n信用もできますから！"},
        { "location": "436/TALK"  , "narrator": "百鶴", "text": "……どこが？"},
        { "location": "437/TALK"  , "narrator": "カレン　", "text": "えーっと。"},
        { "location": "438/TALK"  , "narrator": "カレン　", "text": "優しそうな顔を\nしてるところ…？"},
        { "location": "439/TALK"  , "narrator": "百鶴", "text": "……。"},
        { "location": "443/TALK"  , "narrator": "百鶴", "text": "さて、どうしますか？\n$handle$さん。"},
        { "location": "444/SEL"   , "narrator": "", "text": "入る"},
        { "location": "445/SEL"   , "narrator": "", "text": "入らない"},
        { "location": "446/ACT"   , "narrator": "", "text": "入る"},
        { "location": "448/TALK"  , "narrator": "カレン　", "text": "ですよね！！\n時代は変わったんです！"},
        { "location": "449/TALK"  , "narrator": "百鶴", "text": "なんということでしょう。\nこの■■野郎……。"},
        { "location": "450/TALK"  , "narrator": "カレン　", "text": "それじゃ、\nいつも通り\n宜しくお願いします！"},
        { "location": "451/TALK"  , "narrator": "カレン　", "text": "$handle$さんと\nカレンと現実のわたしに\n素敵なココロの旅を！"},
        { "location": "458/ACT"   , "narrator": "", "text": "入らない"},
        { "location": "460/TALK"  , "narrator": "百鶴", "text": "さすが\n$handle$さん。\n大変聡明な判断です。"},
        { "location": "461/TALK"  , "narrator": "カレン　", "text": "そんなぁ……。\n信じてたのに…。"},
        { "location": "463/TALK"  , "narrator": "百鶴", "text": "それでは契約主の\n代理として、わたしが\n扉を再設定します。"},
        { "location": "468/TALK"  , "narrator": "カレン　", "text": "えええっ！！\nそれこそルール違反じゃ\nないんですか！？"},
        { "location": "469/TALK"  , "narrator": "百鶴", "text": "いえ。\n私には特権がありますから\n大丈夫です。"},
        { "location": "471/TALK"  , "narrator": "百鶴", "text": "オープンプロセス、\n0x107番地から\n0xFC4番地へ。"},
        { "location": "494/TALK"  , "narrator": "百鶴", "text": "シーク完了。"},
        { "location": "497/TALK"  , "narrator": "百鶴", "text": "というわけで、\nこの扉に入ってください。"},
        { "location": "498/SEL"   , "narrator": "", "text": "どんな方向性なの？"},
        { "location": "499/ACT"   , "narrator": "", "text": "どんな方向性なの？"},
        { "location": "501/TALK"  , "narrator": "百鶴", "text": "わたしが本来の\n幸せな形に戻る為の\n方向性です。"},
        { "location": "502/SEL"   , "narrator": "", "text": "意味が分からないんですけど"},
        { "location": "503/ACT"   , "narrator": "", "text": "意味が分からないんですけど"},
        { "location": "505/TALK"  , "narrator": "百鶴", "text": "入ればわかりますよ。"},
        { "location": "507/TALK"  , "narrator": "百鶴", "text": "というか、\nとっとと入れ\nわたしの愛する人！"},
        { "location": "23/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>9月3日　 7:40 PM</color>\nストライキ開始当日、神楽坂トライナリーにて"},
        { "location": "126/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "128/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "130/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "132/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "134/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"},
