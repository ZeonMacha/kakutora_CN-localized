{
    "dir": "chap13/daydra/dd_ch03_13_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "13356",
        "cid": "gabriella",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "ガブリエラの想い"
    },
    "entry":
    [
        { "location": "579/SCENARIO", "narrator": "", "text": "ガブリエラの想い"},
        { "location": "600/TALK"    , "narrator": "ガブリエラ", "text": "…もうこんな時間かぁ。\nもう少ししたら教室に\n戻らないと。"},
        { "location": "602/TALK"    , "narrator": "つばめ", "text": "えっ？　戻るって…。"},
        { "location": "605/TALK"    , "narrator": "ガブリエラ", "text": "あたしの教室よ。\nそこ以外にないでしょ？"},
        { "location": "607/TALK"    , "narrator": "つばめ", "text": "あ、ああっ！\nそうだよね！"},
        { "location": "608/TALK"    , "narrator": "つばめ", "text": "なんか、こうして\nわたし達の教室で\n話すのに慣れちゃって――"},
        { "location": "609/TALK"    , "narrator": "つばめ", "text": "わたし達と同じクラス\nって、一瞬思っちゃい\nました。"},
        { "location": "611/TALK"    , "narrator": "雛", "text": "それ、時々あたしも\n思うよ。"},
        { "location": "612/TALK"    , "narrator": "雛", "text": "ガブリエラちゃんが\n自分の教室戻るのって、\nなんか違和感あるよね？"},
        { "location": "613/TALK"    , "narrator": "つばめ", "text": "そうそう。\nガブちゃんはどう？"},
        { "location": "618/TALK"    , "narrator": "ガブリエラ", "text": "…ま、まあ、感じない\nこともないわ。"},
        { "location": "619/TALK"    , "narrator": "ガブリエラ", "text": "ここ、思ったよりかは\n居心地悪くないし――。"},
        { "location": "620/TALK"    , "narrator": "ガブリエラ", "text": "正直、自分の教室より\n楽しいし。"},
        { "location": "623/TALK"    , "narrator": "雛", "text": "もー、ずっとここに\nいればいいのにー。"},
        { "location": "628/TALK"    , "narrator": "ガブリエラ", "text": "無理言わないでよ。"},
        { "location": "629/TALK"    , "narrator": "繭", "text": "…私、ガブリエラを\n年下と思ったことも\nないかも。"},
        { "location": "630/TALK"    , "narrator": "繭", "text": "生意気で後輩らしく\nないからだと思う。"},
        { "location": "631/TALK"    , "narrator": "雛", "text": "ああ、それあるかも。"},
        { "location": "635/TALK"    , "narrator": "ガブリエラ", "text": "あたしのどこが\n生意気だっていうのよ！"},
        { "location": "636/TALK"    , "narrator": "雛", "text": "つばめちゃん、\n教えてあげて。"},
        { "location": "637/TALK"    , "narrator": "つばめ", "text": "が、ガブちゃんは…、\nとっても可愛い良い子\nだと思いますよ？"},
        { "location": "639/TALK"    , "narrator": "ガブリエラ", "text": "…嘘くさいわ。"},
        { "location": "640/TALK"    , "narrator": "繭", "text": "…そういうところよ。"},
        { "location": "641/TALK"    , "narrator": "雛", "text": "でも、\n本当に何でだろうね？"},
        { "location": "642/TALK"    , "narrator": "雛", "text": "教室だけじゃなくて、\n学年が違うのまで\n気にならないなんて――"},
        { "location": "643/TALK"    , "narrator": "雛", "text": "ちょっと不思議かも"},
        { "location": "646/TALK"    , "narrator": "ガブリエラ", "text": "そりゃ多分…。"},
        { "location": "647/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "649/TALK"    , "narrator": "繭", "text": "何？"},
        { "location": "651/TALK"    , "narrator": "ガブリエラ", "text": "…な、何だろ？\n何言おうとしてたか\n忘れちゃったわ。"},
        { "location": "654/TALK"    , "narrator": "ガブリエラ", "text": "…多分、友達だから\nよね？"},
        { "location": "655/SEL"     , "narrator": "", "text": "端末操作：つばめのスマホ"},
        { "location": "656/SEL"     , "narrator": "", "text": "僕が答えよう"},
        { "location": "657/SEL"     , "narrator": "", "text": "一度だけ言えばいいんだよ"},
        { "location": "659/TALK"    , "narrator": "ガブリエラ", "text": "けど、こういうのって\n言葉にするの、\n凄く恥ずかしいかも…。"},
        { "location": "660/TALK"    , "narrator": "ガブリエラ", "text": "それに、あたしが\n年下なのに\n違いないし――"},
        { "location": "661/TALK"    , "narrator": "ガブリエラ", "text": "ちょっと、失礼？\n親しき仲にもなんとか、\nって言うし…。"},
        { "location": "666/TALK"    , "narrator": "ガブリエラ", "text": "…それじゃあ、戻るわ。"},
        { "location": "667/TALK"    , "narrator": "つばめ", "text": "うん。"},
        { "location": "668/TALK"    , "narrator": "雛", "text": "ガブリエラちゃん、\nまたねー！"},
        { "location": "672/TALK"    , "narrator": "ガブリエラ", "text": "…戻りたくないなぁ。"},
        { "location": "674/ACT"     , "narrator": "", "text": "端末操作：つばめのスマホ"},
        { "location": "678/SEL"     , "narrator": "", "text": "友達だからだと思うよ"},
        { "location": "679/SEL"     , "narrator": "", "text": "妹みたいなもんだしね"},
        { "location": "680/ACT"     , "narrator": "", "text": "友達だからだと思うよ"},
        { "location": "697/TALK"    , "narrator": "つばめ", "text": "そうだね"},
        { "location": "698/TALK"    , "narrator": "つばめ", "text": "だから気にならないんだね"},
        { "location": "710/TALK"    , "narrator": "つばめ", "text": "…年の差とかが気に\nならないのは――"},
        { "location": "711/TALK"    , "narrator": "つばめ", "text": "やっぱり、友達だから\nじゃないかな？"},
        { "location": "713/TALK"    , "narrator": "繭", "text": "そうね"},
        { "location": "714/TALK"    , "narrator": "繭", "text": "ガブリエラは後輩属性\nゼロだから、そうなるのは\n必然だし。"},
        { "location": "717/TALK"    , "narrator": "雛", "text": "やっぱり、友達ってのが\n一番しっくりくるよねー。\nつばめちゃん、ナイス！"},
        { "location": "719/TALK"    , "narrator": "つばめ", "text": "えへへ…。\nガブちゃんは\nどう思う？"},
        { "location": "721/TALK"    , "narrator": "ガブリエラ", "text": "ど、どうって…\nまあ、悪い気持ちは\nしないけど…。"},
        { "location": "722/TALK"    , "narrator": "つばめ", "text": "よかったぁ…。"},
        { "location": "725/TALK"    , "narrator": "ガブリエラ", "text": "でも、つばめが新人で\nあたしがせんぱいなのは\n変わらないわよ！"},
        { "location": "727/TALK"    , "narrator": "つばめ", "text": "ふふっ…その方が\nガブちゃんっぽくて\n好きかも。"},
        { "location": "729/TALK"    , "narrator": "ガブリエラ", "text": "どういう意味よ、\nまったく…。"},
        { "location": "731/TALK"    , "narrator": "ガブリエラ", "text": "…あたしが言えなかった\nこと、こんな簡単に言える\nなんて…。"},
        { "location": "734/TALK"    , "narrator": "ガブリエラ", "text": "…やっぱり、あたしって\nまだ子供かも。"},
        { "location": "735/ACT"     , "narrator": "", "text": "妹みたいなもんだしね"},
        { "location": "754/TALK"    , "narrator": "つばめ", "text": "妹かぁ…確かに、そんな感じかも"},
        { "location": "766/TALK"    , "narrator": "つばめ", "text": "あ、わかった！"},
        { "location": "768/TALK"    , "narrator": "つばめ", "text": "妹みたいな感じが\nするからじゃない\nかな？"},
        { "location": "771/TALK"    , "narrator": "ガブリエラ", "text": "い、妹！？"},
        { "location": "774/TALK"    , "narrator": "繭", "text": "逢瀬さん、それ、\n凄く納得したわ。"},
        { "location": "775/TALK"    , "narrator": "繭", "text": "ちょっと生意気でも、\n嫌な気がしないのは\n多分それが理由。"},
        { "location": "776/TALK"    , "narrator": "雛", "text": "ガブリエラちゃん、\nお姉ちゃんって\n呼んでいいんだよー。"},
        { "location": "779/TALK"    , "narrator": "ガブリエラ", "text": "言うかー！"},
        { "location": "781/TALK"    , "narrator": "ガブリエラ", "text": "っていうか、せんぱいの\nあたしを妹みたいとか、\n生意気よ！"},
        { "location": "784/TALK"    , "narrator": "繭", "text": "…そういう生意気な\nところが、まさに\n妹って感じ。"},
        { "location": "787/TALK"    , "narrator": "ガブリエラ", "text": "納得するなー！！"},
        { "location": "790/TALK"    , "narrator": "ガブリエラ", "text": "…でも、みんなみたいな\nお姉ちゃんがいたら、\n毎日楽しそうかも…。"},
        { "location": "792/TALK"    , "narrator": "ガブリエラ", "text": "…つばめお姉ちゃん、\n雛お姉ちゃん、\n繭お姉ちゃん、か…。"},
        { "location": "794/TALK"    , "narrator": "つばめ", "text": "…な、なんですか？\nもしかして、怒ってます？"},
        { "location": "796/TALK"    , "narrator": "ガブリエラ", "text": "…別に。"},
        { "location": "799/TALK"    , "narrator": "ガブリエラ", "text": "意外と、いいかも…。"},
        { "location": "801/ACT"     , "narrator": "", "text": "僕が答えよう"},
        { "location": "821/TALK"    , "narrator": "ガブリエラ", "text": "マルザンナは頼りになるわね"},
        { "location": "822/TALK"    , "narrator": "ガブリエラ", "text": "でも、やっぱりいいわ"},
        { "location": "823/TALK"    , "narrator": "ガブリエラ", "text": "代わりに言ってもらったとしても、やっぱり恥ずかしいもの"},
        { "location": "825/SEL"     , "narrator": "", "text": "友達だからだよ"},
        { "location": "826/ACT"     , "narrator": "", "text": "友達だからだよ"},
        { "location": "828/TALK"    , "narrator": "ガブリエラ", "text": "表示しないで！"},
        { "location": "829/TALK"    , "narrator": "ガブリエラ", "text": "本当に無理だから、恥ずかしいんだってば…"},
        { "location": "841/TALK"    , "narrator": "つばめ", "text": "せんぱい、大丈夫ですか？"},
        { "location": "843/TALK"    , "narrator": "ガブリエラ", "text": "何が？"},
        { "location": "844/TALK"    , "narrator": "雛", "text": "凄い必死に、\nスマホ弄ってた\nけど――"},
        { "location": "845/TALK"    , "narrator": "雛", "text": "誰からのメールだったの？"},
        { "location": "847/TALK"    , "narrator": "ガブリエラ", "text": "だ、誰って、その…。"},
        { "location": "848/TALK"    , "narrator": "ガブリエラ", "text": "…Ｂｏｔのマルザンナ、\nなんて言えないわ！"},
        { "location": "851/TALK"    , "narrator": "ガブリエラ", "text": "…あ、あぁっ、いけない！\nもう時間だから教室\n戻らないと。"},
        { "location": "852/TALK"    , "narrator": "ガブリエラ", "text": "それじゃ！"},
        { "location": "861/TALK"    , "narrator": "つばめ", "text": "あっ、ガブちゃん！"},
        { "location": "862/TALK"    , "narrator": "つばめ", "text": "…まだ、そんなに慌てる\n時間じゃないのに。"},
        { "location": "863/TALK"    , "narrator": "雛", "text": "聞かれたくない相手から\nだったのかなー？"},
        { "location": "865/TALK"    , "narrator": "繭", "text": "彼氏とか？"},
        { "location": "867/TALK"    , "narrator": "つばめ", "text": "彼氏がいるようには\n見えないけど…。"},
        { "location": "868/TALK"    , "narrator": "雛", "text": "…ま、まさか――"},
        { "location": "869/TALK"    , "narrator": "雛", "text": "銃の腕を見込んだ\n相手からの、\n暗殺依頼とか！？"},
        { "location": "870/TALK"    , "narrator": "繭", "text": "美少女暗殺者！？\n何それかっこいい！"},
        { "location": "872/TALK"    , "narrator": "つばめ", "text": "もぉ、漫画じゃないん\nだから…。"},
        { "location": "873/ACT"     , "narrator": "", "text": "一度だけ言えばいいんだよ"},
        { "location": "893/TALK"    , "narrator": "ガブリエラ", "text": "わかってるけど、その一度が言えないのよ"},
        { "location": "894/TALK"    , "narrator": "ガブリエラ", "text": "凄く勇気いるし、"},
        { "location": "895/TALK"    , "narrator": "ガブリエラ", "text": "なんか、こう…ちょっとむず痒いんだもの"},
        { "location": "906/TALK"    , "narrator": "ガブリエラ", "text": "…言い訳ばっかり\n書いてた気がするわ。"},
        { "location": "909/TALK"    , "narrator": "ガブリエラ", "text": "…そろそろ、教室戻るわ。"},
        { "location": "910/TALK"    , "narrator": "雛", "text": "また後でねー。"},
        { "location": "911/TALK"    , "narrator": "繭", "text": "それじゃあ。"},
        { "location": "914/TALK"    , "narrator": "ガブリエラ", "text": "…いつかは、言えるように\nなりたいな。"},
        { "location": "589/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>7月12日　12:55 PM</color>\nとある平日の昼休み、高等部教室でのこと。"}
    ]
}
