        "title": "らぶとーく 第37話",
        "sub_title": "オシャンティー？"
    },
    "entry":
    [
        { "location": "446/SCENARIO", "narrator": "", "text": "オシャンティー？"},
        { "location": "473/TALK"    , "narrator": "神楽", "text": "合宿してるとねー"},
        { "location": "474/TALK"    , "narrator": "神楽", "text": "どうしてもFreyMENOWの活動ができないぴょん"},
        { "location": "475/TALK"    , "narrator": "神楽", "text": "仕方ないけどﾅｰ"},
        { "location": "477/SEL"     , "narrator": "", "text": "メノウの活動が第一なんだね"},
        { "location": "478/SEL"     , "narrator": "", "text": "これを機会に休んで"},
        { "location": "479/SEL"     , "narrator": "", "text": "みんなが寝静まってからやれば"},
        { "location": "480/ACT"     , "narrator": "", "text": "メノウの活動が第一なんだね"},
        { "location": "481/TALK"    , "narrator": "神楽", "text": "そう見える？"},
        { "location": "482/TALK"    , "narrator": "神楽", "text": "実際そうだけど"},
        { "location": "483/ACT"     , "narrator": "", "text": "これを機会に休んで"},
        { "location": "484/TALK"    , "narrator": "神楽", "text": "それができればﾅｰ"},
        { "location": "485/ACT"     , "narrator": "", "text": "みんなが寝静まってからやれば"},
        { "location": "487/TALK"    , "narrator": "神楽", "text": "って怖いし無理だし"},
        { "location": "489/TALK"    , "narrator": "神楽", "text": "脳内で色々考えたりするくらいはできるぴょん"},
        { "location": "490/TALK"    , "narrator": "神楽", "text": "曲の構想とかステージ衣装とか"},
        { "location": "491/TALK"    , "narrator": "神楽", "text": "あとはそれをスマホにメモするくらいで精一杯～～"},
        { "location": "495/TALK"    , "narrator": "神楽", "text": "でも今はそのくらいがちょうどいいのかも"},
        { "location": "496/TALK"    , "narrator": "神楽", "text": "ぴょんこの考えてたFreyMENOWと今のFreyMENOWの方向性って違うし"},
        { "location": "498/SEL"     , "narrator": "", "text": "理想と現実の違いってやつ？"},
        { "location": "499/SEL"     , "narrator": "", "text": "そうみたいだね"},
        { "location": "500/SEL"     , "narrator": "", "text": "事務所の方針ってやつか"},
        { "location": "501/ACT"     , "narrator": "", "text": "理想と現実の違いってやつ？"},
        { "location": "502/TALK"    , "narrator": "神楽", "text": "そういうことかなー"},
        { "location": "503/TALK"    , "narrator": "神楽", "text": "ちょっと違う気もするけど"},
        { "location": "504/ACT"     , "narrator": "", "text": "そうみたいだね"},
        { "location": "505/TALK"    , "narrator": "神楽", "text": "わかって～わかって$handle$！"},
        { "location": "506/ACT"     , "narrator": "", "text": "事務所の方針ってやつか"},
        { "location": "507/TALK"    , "narrator": "神楽", "text": "一言で言っちまうとそう"},
        { "location": "508/TALK"    , "narrator": "神楽", "text": "事態はもっと複雑ではあるのだけれども！！！"},
        { "location": "510/TALK"    , "narrator": "神楽", "text": "初期メノウの頃は創作活動が楽しくてしょうがなかったぴょん"},
        { "location": "511/TALK"    , "narrator": "神楽", "text": "それこそ寝食を忘れて色々やってた"},
        { "location": "512/TALK"    , "narrator": "神楽", "text": "だけど今は仕事だからやんなきゃねって感じなんだぴょん"},
        { "location": "516/TALK"    , "narrator": "神楽", "text": "イシュフォビアの曲とかはもう完全にそんな感じ"},
        { "location": "517/TALK"    , "narrator": "神楽", "text": "それだけじゃなくてイヤ"},
        { "location": "518/TALK"    , "narrator": "神楽", "text": "もちろんオシゴトなんだからちゃんと歌うけど！！！"},
        { "location": "519/TALK"    , "narrator": "神楽", "text": "歌ってると辛すぎてなんか気分も悪くなってくるし！！！"},
        { "location": "520/TALK"    , "narrator": "神楽", "text": "衣装も単独で見ればｶﾜｲｲんだけどストーリーがちょっと、、、"},
        { "location": "521/TALK"    , "narrator": "神楽", "text": "とにかく違う！って気持ちしかないし！"},
        { "location": "523/SEL"     , "narrator": "", "text": "わかる、辛いよね"},
        { "location": "524/SEL"     , "narrator": "", "text": "イシュフォビアが好きな人が可哀想だよそれ"},
        { "location": "525/ACT"     , "narrator": "", "text": "わかる、辛いよね"},
        { "location": "526/TALK"    , "narrator": "神楽", "text": "おおお、ナカーマ！！"},
        { "location": "527/TALK"    , "narrator": "神楽", "text": "やっぱり$handle$と話してると気がラクになるわ"},
        { "location": "528/ACT"     , "narrator": "", "text": "イシュフォビアが好きな人が可哀想だよそれ"},
        { "location": "529/TALK"    , "narrator": "神楽", "text": "それってファンのこと？"},
        { "location": "531/SEL"     , "narrator": "", "text": "そう"},
        { "location": "532/SEL"     , "narrator": "", "text": "つばめのこと"},
        { "location": "533/ACT"     , "narrator": "", "text": "そう"},
        { "location": "534/TALK"    , "narrator": "神楽", "text": "その理屈はわかる"},
        { "location": "535/ACT"     , "narrator": "", "text": "つばめのこと"},
        { "location": "536/TALK"    , "narrator": "神楽", "text": "いや、あの子はフォビア嫌いだって言ってたし"},
        { "location": "537/TALK"    , "narrator": "神楽", "text": "しらなかった？"},
        { "location": "538/TALK"    , "narrator": "神楽", "text": "めっちゃディスられたんだけど"},
        { "location": "540/SEL"     , "narrator": "", "text": "あれってディスってたんだろうか"},
        { "location": "541/SEL"     , "narrator": "", "text": "なんでキレてんの？神楽と同じ意見じゃん"},
        { "location": "542/ACT"     , "narrator": "", "text": "あれってディスってたんだろうか"},
        { "location": "543/TALK"    , "narrator": "神楽", "text": "いやー"},
        { "location": "544/TALK"    , "narrator": "神楽", "text": "つばめさん擁護派？まあ別にいいんだけど"},
        { "location": "545/TALK"    , "narrator": "神楽", "text": "フォビア嫌いって言ってたじゃん、楽しそうじゃないし、リールの方が好きだって"},
        { "location": "546/TALK"    , "narrator": "神楽", "text": "まあいいわ、つばめさんの話は今したくないし"},
        { "location": "547/ACT"     , "narrator": "", "text": "なんでキレてんの？神楽と同じ意見じゃん"},
        { "location": "548/TALK"    , "narrator": "神楽", "text": "ﾑｶﾂｸの!!!"},
        { "location": "549/TALK"    , "narrator": "神楽", "text": "だってあの子は今でもFreyMENOW大ファンとか言ってるんだよ？"},
        { "location": "550/TALK"    , "narrator": "神楽", "text": "大ファンなのになんで今のメノウがダメなの？"},
        { "location": "551/TALK"    , "narrator": "神楽", "text": "ならもうファンやめればいいじゃん"},
        { "location": "552/TALK"    , "narrator": "神楽", "text": "ほんとﾑｶﾂｸ"},
        { "location": "554/SEL"     , "narrator": "", "text": "つばめに今の自分を好きになって欲しいんだね"},
        { "location": "555/SEL"     , "narrator": "", "text": "ファンだからこそ、こだわりが強いんだよ"},
        { "location": "556/ACT"     , "narrator": "", "text": "つばめに今の自分を好きになって欲しいんだね"},
        { "location": "557/TALK"    , "narrator": "神楽", "text": "あのね"},
        { "location": "559/TALK"    , "narrator": "神楽", "text": "そういう話をしてるんじゃないの"},
        { "location": "560/ACT"     , "narrator": "", "text": "ファンだからこそ、こだわりが強いんだよ"},
        { "location": "562/TALK"    , "narrator": "神楽", "text": "まあ"},
        { "location": "563/TALK"    , "narrator": "神楽", "text": "そうなんでしょうけど"},
        { "location": "565/TALK"    , "narrator": "神楽", "text": "いや、もういいです"},
        { "location": "566/TALK"    , "narrator": "神楽", "text": "今はつばめさんのことは考えたくない"},
        { "location": "568/TALK"    , "narrator": "神楽", "text": "でも自分で言っててアレだけど、フォビア好きな人云々はわからんでもないよ？"},
        { "location": "569/TALK"    , "narrator": "神楽", "text": "フォビアから入ったファンの人、実際リールの時よりメチャ多いし、多数派なんだよね"},
        { "location": "572/TALK"    , "narrator": "神楽", "text": "もちろん私だって申し訳無いと思う"},
        { "location": "573/TALK"    , "narrator": "神楽", "text": "けど、"},
        { "location": "575/TALK"    , "narrator": "神楽", "text": "$handle$だから、本当に$handle$だから言うけど"},
        { "location": "576/TALK"    , "narrator": "神楽", "text": "あ、これ、ファンの人聞いたら怒るだろうし、絶対に墓場まで言わずに持っていくつもりのことだから言ったら$handle$を先に墓場に埋めるから"},
        { "location": "577/TALK"    , "narrator": "神楽", "text": "絶対誰にも言わないで"},
        { "location": "578/TALK"    , "narrator": "神楽", "text": "ファンの人達が好きだろうが嫌いだろうが関係無いし、作ったのは私だから"},
        { "location": "579/TALK"    , "narrator": "神楽", "text": "唄ってるのも私だから"},
        { "location": "580/TALK"    , "narrator": "神楽", "text": "私が嫌とか唄いたくないとか言うことと、ファンがフォビアを好きかどうかは全然別だし"},
        { "location": "581/TALK"    , "narrator": "神楽", "text": "じゃあ可哀想だから、私が吐いても倒れても唄ってやれよっていうこと？"},
        { "location": "582/TALK"    , "narrator": "神楽", "text": "本当は唄いたくも無いし思い出したくもないけど、仕事だからって思って歌ってあげてるだけでも有り難いと思って欲しい"},
        { "location": "583/TALK"    , "narrator": "神楽", "text": "まあ、もっともフォビア唄ってるのはファンがどうこう以前の問題だけどさあ"},
        { "location": "584/TALK"    , "narrator": "神楽", "text": "ファンにだって、私がフォビア大嫌いだってことわからせないように頑張ってるし。ぴょんこえらくない？すごい頑張ってファンサービスしてない？"},
        { "location": "586/SEL"     , "narrator": "", "text": "いや、つばめは気づいてたし、筒抜けでは？"},
        { "location": "587/SEL"     , "narrator": "", "text": "なんかそういう話が聞けて嬉しい"},
        { "location": "588/SEL"     , "narrator": "", "text": "失望した"},
        { "location": "589/ACT"     , "narrator": "", "text": "いや、つばめは気づいてたし、筒抜けでは？"},
        { "location": "590/TALK"    , "narrator": "神楽", "text": "うっせーよ"},
        { "location": "591/TALK"    , "narrator": "神楽", "text": "お前と話してるとむかつくわ"},
        { "location": "592/TALK"    , "narrator": "神楽", "text": "もういい"},
        { "location": "593/TALK"    , "narrator": "神楽", "text": "しばらく話したくない"},
        { "location": "601/TALK"    , "narrator": "神楽", "text": "バカバカバカバカバカ！！\n$handle$のバカ！"},
        { "location": "602/TALK"    , "narrator": "神楽", "text": "そんなこと\n言って欲しかったんじゃ\nないのに……。"},
        { "location": "603/TALK"    , "narrator": "神楽", "text": "…つらい。"},
        { "location": "606/ACT"     , "narrator": "", "text": "なんかそういう話が聞けて嬉しい"},
        { "location": "607/TALK"    , "narrator": "神楽", "text": "む？"},
        { "location": "608/TALK"    , "narrator": "神楽", "text": "どういうこと？"},
        { "location": "610/SEL"     , "narrator": "", "text": "神楽が本当に辛いと思ってることを分かち合ってくれたから嬉しかった"},
        { "location": "611/SEL"     , "narrator": "", "text": "$me$を信頼して相談してくれたからね"},
        { "location": "612/ACT"     , "narrator": "", "text": "神楽が本当に辛いと思ってることを分かち合ってくれたから嬉しかった"},
        { "location": "614/TALK"    , "narrator": "神楽", "text": "そりゃだって"},
        { "location": "615/TALK"    , "narrator": "神楽", "text": "恋人ですからね"},
        { "location": "616/TALK"    , "narrator": "神楽", "text": "ぴょんこの愚痴を聞くのは義務です、義務！！（ﾋﾟｮｰﾝ!!"},
        { "location": "617/ACT"     , "narrator": "", "text": "$me$を信頼して相談してくれたからね"},
        { "location": "619/TALK"    , "narrator": "神楽", "text": "うん"},
        { "location": "620/TALK"    , "narrator": "神楽", "text": "$handle$だけだもん、こんな話できるの"},
        { "location": "623/ACT"     , "narrator": "", "text": "失望した"},
        { "location": "624/TALK"    , "narrator": "神楽", "text": "そっか"},
        { "location": "625/TALK"    , "narrator": "神楽", "text": "ごめんね、嫌な話しちゃって"},
        { "location": "626/TALK"    , "narrator": "神楽", "text": "そうだよね、こんなファンを大事にしないクズ人間と一緒になんていたくないもんね"},
        { "location": "627/TALK"    , "narrator": "神楽", "text": "私は"},
        { "location": "628/TALK"    , "narrator": "神楽", "text": "旅立ちます"},
        { "location": "629/TALK"    , "narrator": "神楽", "text": "さよなら"},
        { "location": "637/TALK"    , "narrator": "神楽", "text": "バカバカバカバカバカ！！\n$handle$のバカ！"},
        { "location": "638/TALK"    , "narrator": "神楽", "text": "そんなこと\n言って欲しかったんじゃ\nないのに……。"},
        { "location": "639/TALK"    , "narrator": "神楽", "text": "またひとりに\nなっちゃった……。"},
        { "location": "640/TALK"    , "narrator": "神楽", "text": "…つらい。"},
        { "location": "644/TALK"    , "narrator": "神楽", "text": "まあとにかく、そういうわけなのだよ"},
        { "location": "645/TALK"    , "narrator": "神楽", "text": "だからね、フォビアのモチベは現在全部衣装に注ぎ込まれています！！"},
        { "location": "646/TALK"    , "narrator": "神楽", "text": "あの衣装メチャかわいくない？？？"},
        { "location": "647/TALK"    , "narrator": "神楽", "text": "フォビアは個人的には全部ダメだけど、あの衣装デザインしてくれた人だけは神！！！！"},
        { "location": "649/SEL"     , "narrator": "", "text": "確かにかわいいよね"},
        { "location": "650/SEL"     , "narrator": "", "text": "神楽の巨乳願望が詰まってるもんね"},
        { "location": "651/SEL"     , "narrator": "", "text": "個人的にはリールの衣装の方が好きかな"},
        { "location": "652/ACT"     , "narrator": "", "text": "確かにかわいいよね"},
        { "location": "653/TALK"    , "narrator": "神楽", "text": "でしょー！！！"},
        { "location": "654/TALK"    , "narrator": "神楽", "text": "よかった、$handle$もｶﾜｲｲって言ってくれて♪"},
        { "location": "656/TALK"    , "narrator": "神楽", "text": "ねーねー、どういうとこが好き？"},
        { "location": "658/SEL"     , "narrator": "", "text": "魔界のプリンセスみたいなとこ"},
        { "location": "659/SEL"     , "narrator": "", "text": "太腿の絶対領域と露出した肩と肩甲骨"},
        { "location": "660/SEL"     , "narrator": "", "text": "ファンタジックでフリフリしてるとこ"},
        { "location": "661/ACT"     , "narrator": "", "text": "魔界のプリンセスみたいなとこ"},
        { "location": "663/TALK"    , "narrator": "神楽", "text": "うんうん、いいよねー"},
        { "location": "664/TALK"    , "narrator": "神楽", "text": "ぴょんこ、そういうダークファンタジーなの大好きなの"},
        { "location": "665/TALK"    , "narrator": "神楽", "text": "でも醜悪なのはダメなの、やっぱりゾッとするような美しさっていうか"},
        { "location": "666/TALK"    , "narrator": "神楽", "text": "人の感情がわからないエルフとか、すごく好き"},
        { "location": "667/TALK"    , "narrator": "神楽", "text": "冷酷なまでに美しいっていうのがすごく好き"},
        { "location": "669/SEL"     , "narrator": "", "text": "$me$もそれ好きだよ"},
        { "location": "670/SEL"     , "narrator": "", "text": "そういうのはあまり好きじゃないかな"},
        { "location": "671/ACT"     , "narrator": "", "text": "$me$もそれ好きだよ"},
        { "location": "672/TALK"    , "narrator": "神楽", "text": "わーいわーい！"},
        { "location": "673/TALK"    , "narrator": "神楽", "text": "今度一晩中語り明かそうよおおおおお！！"},
        { "location": "674/ACT"     , "narrator": "", "text": "そういうのはあまり好きじゃないかな"},
        { "location": "675/TALK"    , "narrator": "神楽", "text": "はー、残念"},
        { "location": "676/TALK"    , "narrator": "神楽", "text": "やっぱり趣味クラスタ探そうかしらー"},
        { "location": "677/TALK"    , "narrator": "神楽", "text": "この萌を分かち合える人と出会いたいわーん"},
        { "location": "679/ACT"     , "narrator": "", "text": "太腿の絶対領域と露出した肩と肩甲骨"},
        { "location": "680/TALK"    , "narrator": "神楽", "text": "うわｴｯﾛ"},
        { "location": "681/TALK"    , "narrator": "神楽", "text": "いつもぴょんこのこと、そういう目で見てるんだ"},
        { "location": "683/SEL"     , "narrator": "", "text": "そういうわけじゃないけど"},
        { "location": "684/SEL"     , "narrator": "", "text": "実はそうなんです"},
        { "location": "685/ACT"     , "narrator": "", "text": "そういうわけじゃないけど"},
        { "location": "686/TALK"    , "narrator": "神楽", "text": "うわー、$handle$ってムッツリ～～～～？"},
        { "location": "687/TALK"    , "narrator": "神楽", "text": "いいのよ？本当のこと言っても"},
        { "location": "688/ACT"     , "narrator": "", "text": "実はそうなんです"},
        { "location": "689/TALK"    , "narrator": "神楽", "text": "うっわ、開き直ったし！！！！"},
        { "location": "690/TALK"    , "narrator": "神楽", "text": "そういうところ、嫌いじゃないゼ！"},
        { "location": "693/SEL"     , "narrator": "", "text": "芸術的なまでに美しい肢体ってことだよ！"},
        { "location": "694/SEL"     , "narrator": "", "text": "仕方ないでしょ、神楽だからだよ！"},
        { "location": "695/ACT"     , "narrator": "", "text": "芸術的なまでに美しい肢体ってことだよ！"},
        { "location": "696/TALK"    , "narrator": "神楽", "text": "えーーーーーーーー"},
        { "location": "697/TALK"    , "narrator": "神楽", "text": "おじょーず"},
        { "location": "698/TALK"    , "narrator": "神楽", "text": "夫ジョーズ"},
        { "location": "699/TALK"    , "narrator": "神楽", "text": "ガブガブガブッ"},
        { "location": "700/ACT"     , "narrator": "", "text": "仕方ないでしょ、神楽だからだよ！"},
        { "location": "701/TALK"    , "narrator": "神楽", "text": "わーーーーーーー"},
        { "location": "702/TALK"    , "narrator": "神楽", "text": "そういうのﾀﾞﾒ"},
        { "location": "703/TALK"    , "narrator": "神楽", "text": "|・//) <ﾄﾞｷﾄﾞｷｽﾙﾖ?"},
        { "location": "705/ACT"     , "narrator": "", "text": "ファンタジックでフリフリしてるとこ"},
        { "location": "706/TALK"    , "narrator": "神楽", "text": "なんかビミョーに違うよーな"},
        { "location": "707/TALK"    , "narrator": "神楽", "text": "いや、違ってはないんだけど"},
        { "location": "708/TALK"    , "narrator": "神楽", "text": "なんだ、そのー"},
        { "location": "709/TALK"    , "narrator": "神楽", "text": "何もわからない父親が頑張って子供に合わせようとして出ちゃった寒い言葉みたいなｗｗｗｗ"},
        { "location": "710/TALK"    , "narrator": "神楽", "text": "次世代ゲーム機やってるのに「マイコンばっかやってないで」みたいに怒ってくる親みたいなｗｗｗ"},
        { "location": "712/SEL"     , "narrator": "", "text": "しょぼーん…"},
        { "location": "713/SEL"     , "narrator": "", "text": "マイコンって？？"},
        { "location": "714/ACT"     , "narrator": "", "text": "しょぼーん…"},
        { "location": "715/TALK"    , "narrator": "神楽", "text": "でもそういうとこもｽｷ"},
        { "location": "716/TALK"    , "narrator": "神楽", "text": "だから、気にしないで？ね？"},
        { "location": "717/ACT"     , "narrator": "", "text": "マイコンって？？"},
        { "location": "718/TALK"    , "narrator": "神楽", "text": "あれ？しらないの？しらないかー"},
        { "location": "719/TALK"    , "narrator": "神楽", "text": "大昔のパソコン？よりも前のコンピューター？？"},
        { "location": "720/TALK"    , "narrator": "神楽", "text": "ぴょんこも良く知らないんだけど、パパがいっぱい持ってたの"},
        { "location": "721/TALK"    , "narrator": "神楽", "text": "線とかいっぱい出てる緑色のヤツ"},
        { "location": "725/ACT"     , "narrator": "", "text": "神楽の巨乳願望が詰まってるもんね"},
        { "location": "726/TALK"    , "narrator": "神楽", "text": "なにが？"},
        { "location": "729/SEL"     , "narrator": "", "text": "あれ、どれくらい盛ってるんすか？www"},
        { "location": "730/SEL"     , "narrator": "", "text": "$me$はぺったん神楽の方が好きだよ！！"},
        { "location": "731/ACT"     , "narrator": "", "text": "あれ、どれくらい盛ってるんすか？www"},
        { "location": "732/TALK"    , "narrator": "神楽", "text": "バストは９５ｃｍ"},
        { "location": "734/SEL"     , "narrator": "", "text": "うわ、それ森杉でしょｗ"},
        { "location": "735/ACT"     , "narrator": "", "text": "うわ、それ森杉でしょｗ"},
        { "location": "737/TALK"    , "narrator": "神楽", "text": "という設定です"},
        { "location": "738/TALK"    , "narrator": "神楽", "text": "フランタンという国の王の娘です"},
        { "location": "739/ACT"     , "narrator": "", "text": "$me$はぺったん神楽の方が好きだよ！！"},
        { "location": "740/TALK"    , "narrator": "神楽", "text": "フランタンという国の王の娘です"},
        { "location": "741/TALK"    , "narrator": "神楽", "text": "私じゃありません"},
        { "location": "744/SEL"     , "narrator": "", "text": "巨乳への憧れをキャラに託してるとはｗ"},
        { "location": "745/SEL"     , "narrator": "", "text": "なんで敬語？？"},
        { "location": "746/ACT"     , "narrator": "", "text": "巨乳への憧れをキャラに託してるとはｗ"},
        { "location": "747/TALK"    , "narrator": "神楽", "text": "ああ"},
        { "location": "749/SEL"     , "narrator": "", "text": "なに？"},
        { "location": "750/ACT"     , "narrator": "", "text": "なに？"},
        { "location": "752/TALK"    , "narrator": "神楽", "text": "ちょっと自省してただけです"},
        { "location": "753/TALK"    , "narrator": "神楽", "text": "なんでこんなクズのことを好きになったんだろうって"},
        { "location": "755/SEL"     , "narrator": "", "text": "ひどい"},
        { "location": "756/SEL"     , "narrator": "", "text": "ごめん、ちょっと冗談のつもりだったんだけど"},
        { "location": "757/ACT"     , "narrator": "", "text": "ひどい"},
        { "location": "758/ACT"     , "narrator": "", "text": "ごめん、ちょっと冗談のつもりだったんだけど"},
        { "location": "760/ACT"     , "narrator": "", "text": "なんで敬語？？"},
        { "location": "761/TALK"    , "narrator": "神楽", "text": "自省のためです"},
        { "location": "763/SEL"     , "narrator": "", "text": "なんで反省してるの？"},
        { "location": "764/ACT"     , "narrator": "", "text": "なんで反省してるの？"},
        { "location": "766/TALK"    , "narrator": "神楽", "text": "なんでだと思いますか？"},
        { "location": "768/SEL"     , "narrator": "", "text": "わかんない"},
        { "location": "769/SEL"     , "narrator": "", "text": "巨乳願望をキャラに押しつけたから？"},
        { "location": "770/ACT"     , "narrator": "", "text": "わかんない"},
        { "location": "771/ACT"     , "narrator": "", "text": "巨乳願望をキャラに押しつけたから？"},
        { "location": "773/TALK"    , "narrator": "神楽", "text": "てかほんとどうしようも無いクズだなお前"},
        { "location": "776/TALK"    , "narrator": "神楽", "text": "貴方の主張としては私は貧乳だから貧乳のキャラ以外を演じるのは滑稽だとそういうことですよね"},
        { "location": "777/TALK"    , "narrator": "神楽", "text": "ということは私が作る世界には貧乳しかいないってことですよね"},
        { "location": "779/SEL"     , "narrator": "", "text": "いや、そういう意味では"},
        { "location": "780/SEL"     , "narrator": "", "text": "そういうことです"},
        { "location": "781/ACT"     , "narrator": "", "text": "いや、そういう意味では"},
        { "location": "782/ACT"     , "narrator": "", "text": "そういうことです"},
        { "location": "785/TALK"    , "narrator": "神楽", "text": "いってるじゃねーかこのクソ野郎が"},
        { "location": "787/SEL"     , "narrator": "", "text": "すみません"},
        { "location": "788/SEL"     , "narrator": "", "text": "そんなことで怒るなよ"},
        { "location": "789/ACT"     , "narrator": "", "text": "すみません"},
        { "location": "791/TALK"    , "narrator": "神楽", "text": "ていうかさ"},
        { "location": "793/TALK"    , "narrator": "神楽", "text": "ママのこととかだって知られたくなかったのに"},
        { "location": "794/TALK"    , "narrator": "神楽", "text": "お弁当の話の時になんか知ってる風に言ってきたりとか"},
        { "location": "795/TALK"    , "narrator": "神楽", "text": "図々しいっていうか配慮がないって言うか"},
        { "location": "796/TALK"    , "narrator": "神楽", "text": "人には言いたくないことだってあるんだよ"},
        { "location": "798/SEL"     , "narrator": "", "text": "ごめんなさい"},
        { "location": "799/SEL"     , "narrator": "", "text": "そんな事言われても$me$にはわからないし"},
        { "location": "800/SEL"     , "narrator": "", "text": "TRI-OSが勝手に言ってるだけです、$me$じゃありません"},
        { "location": "801/ACT"     , "narrator": "", "text": "ごめんなさい"},
        { "location": "802/ACT"     , "narrator": "", "text": "そんな事言われても$me$にはわからないし"},
        { "location": "803/ACT"     , "narrator": "", "text": "TRI-OSが勝手に言ってるだけです、$me$じゃありません"},
        { "location": "806/TALK"    , "narrator": "神楽", "text": "いやもういいです"},
        { "location": "807/TALK"    , "narrator": "神楽", "text": "金輪際もう私の創作物とか見ないでください"},
        { "location": "808/TALK"    , "narrator": "神楽", "text": "あと"},
        { "location": "809/TALK"    , "narrator": "神楽", "text": "この関係も考えさせていただきます"},
        { "location": "818/TALK"    , "narrator": "ボイスメール", "text": "新しい距離感"},
        { "location": "846/ACT"     , "narrator": "", "text": "そんなことで怒るなよ"},
        { "location": "847/TALK"    , "narrator": "神楽", "text": "そうですね、申し訳ありませんでした"},
        { "location": "849/TALK"    , "narrator": "神楽", "text": "貴方とは根本的に価値観を分かち合えない気がするので"},
        { "location": "850/TALK"    , "narrator": "神楽", "text": "この関係も考えさせていただきますね"},
        { "location": "851/TALK"    , "narrator": "神楽", "text": "貴方も無理しないで"},
        { "location": "852/TALK"    , "narrator": "神楽", "text": "何の義理かはわかりませんが、遠慮なく垢BANしていいですよ"},
        { "location": "853/TALK"    , "narrator": "神楽", "text": "私の方から話しかけることはもう無いと思いますので"},
        { "location": "865/ACT"     , "narrator": "", "text": "個人的にはリールの衣装の方が好きかな"},
        { "location": "866/TALK"    , "narrator": "神楽", "text": "あー"},
        { "location": "867/TALK"    , "narrator": "神楽", "text": "やっぱりそうかー"},
        { "location": "868/TALK"    , "narrator": "神楽", "text": "私もリールの衣装は大好き"},
        { "location": "869/TALK"    , "narrator": "神楽", "text": "ちょっと花嫁衣装にも似てると思わない？"},
        { "location": "871/SEL"     , "narrator": "", "text": "でもエルフの普段着って設定なんでしょ？"},
        { "location": "872/SEL"     , "narrator": "", "text": "二人の式はイシュリール結婚式にしよう"},
        { "location": "873/ACT"     , "narrator": "", "text": "でもエルフの普段着って設定なんでしょ？"},
        { "location": "874/TALK"    , "narrator": "神楽", "text": "そうそうそう"},
        { "location": "875/TALK"    , "narrator": "神楽", "text": "そうなのだぴょん！！"},
        { "location": "876/TALK"    , "narrator": "神楽", "text": "エルフってさー、ああいうスラッとしたヴェールみたいなのが似合うよねー"},
        { "location": "877/TALK"    , "narrator": "神楽", "text": "清楚で慎ましやかな感じでデザインしてみたぴょん"},
        { "location": "878/ACT"     , "narrator": "", "text": "二人の式はイシュリール結婚式にしよう"},
        { "location": "879/TALK"    , "narrator": "神楽", "text": "マテマテ"},
        { "location": "880/TALK"    , "narrator": "神楽", "text": "そういうのは落ち着いて検討しないと"},
        { "location": "881/TALK"    , "narrator": "神楽", "text": "１０年後くらいには結婚式を撮った動画を爆破しないといけない使命感に苛まれるかもしれないぞｗｗ"},
        { "location": "883/TALK"    , "narrator": "神楽", "text": "でもさー"},
        { "location": "884/TALK"    , "narrator": "神楽", "text": "$handle$はなんでリールの方が好きなの？"},
        { "location": "886/SEL"     , "narrator": "", "text": "神楽に似合ってる"},
        { "location": "887/SEL"     , "narrator": "", "text": "どことは言わないが慎ましやかなところがいい"},
        { "location": "888/ACT"     , "narrator": "", "text": "神楽に似合ってる"},
        { "location": "889/TALK"    , "narrator": "神楽", "text": "ぴょん♪"},
        { "location": "890/TALK"    , "narrator": "神楽", "text": "とっても嬉しいけど複雑むー"},
        { "location": "892/SEL"     , "narrator": "", "text": "なんで？"},
        { "location": "893/ACT"     , "narrator": "", "text": "なんで？"},
        { "location": "895/TALK"    , "narrator": "神楽", "text": "リールが似合ってるから好きってことは、フォビアは似合わないからダメってことじゃん"},
        { "location": "896/TALK"    , "narrator": "神楽", "text": "役者の神楽としては、どっちも本気でやってるし、本当にその子のつもりでやってるから、やっぱり複雑"},
        { "location": "897/TALK"    , "narrator": "神楽", "text": "でもいいの、それは私の役者不足的なことだから、$handle$がヘンなこと言ってるわけじゃないし"},
        { "location": "899/SEL"     , "narrator": "", "text": "いや、比較すればってだけで、フォビアも可愛くて大好きだよ"},
        { "location": "900/SEL"     , "narrator": "", "text": "役者不足っていうよりは身体の一部が不足してるっていうかｗ"},
        { "location": "901/ACT"     , "narrator": "", "text": "いや、比較すればってだけで、フォビアも可愛くて大好きだよ"},
        { "location": "902/TALK"    , "narrator": "神楽", "text": "わーいわーい"},
        { "location": "904/ACT"     , "narrator": "", "text": "役者不足っていうよりは身体の一部が不足してるっていうかｗ"},
        { "location": "906/ACT"     , "narrator": "", "text": "どことは言わないが慎ましやかなところがいい"},
        { "location": "908/TALK"    , "narrator": "神楽", "text": "はあ"},
        { "location": "909/TALK"    , "narrator": "神楽", "text": "まあ何が言いたいかわかるけどさ"},
        { "location": "911/SEL"     , "narrator": "", "text": "でも神楽がフォビアの衣装好きなのもわかる"},
        { "location": "912/SEL"     , "narrator": "", "text": "まあこればっかりは個人的な性癖だから仕方ない"},
        { "location": "913/ACT"     , "narrator": "", "text": "でも神楽がフォビアの衣装好きなのもわかる"},
        { "location": "914/TALK"    , "narrator": "神楽", "text": "どんな？"},
        { "location": "916/SEL"     , "narrator": "", "text": "巨乳願望の具現化でしょ"},
        { "location": "917/SEL"     , "narrator": "", "text": "ダークファンタジー的なゾッとしない感じでしょ"},
        { "location": "918/ACT"     , "narrator": "", "text": "巨乳願望の具現化でしょ"},
        { "location": "919/TALK"    , "narrator": "神楽", "text": "はあ"},
        { "location": "921/ACT"     , "narrator": "", "text": "ダークファンタジー的なゾッとしない感じでしょ"},
        { "location": "922/TALK"    , "narrator": "神楽", "text": "あ、わかっちゃった？？"},
        { "location": "925/ACT"     , "narrator": "", "text": "まあこればっかりは個人的な性癖だから仕方ない"},
        { "location": "926/TALK"    , "narrator": "神楽", "text": "いきなりカミングアウト大会かよ"},
        { "location": "927/TALK"    , "narrator": "神楽", "text": "まあいーけどー"},
        { "location": "928/TALK"    , "narrator": "神楽", "text": "でも今はそういう話したかったんじゃないんだけどね"},
        { "location": "929/TALK"    , "narrator": "神楽", "text": "まあいいや、またねー"},
        { "location": "942/TALK"    , "narrator": "神楽", "text": "なんかさー"},
        { "location": "943/TALK"    , "narrator": "神楽", "text": "こうやって創作の話ができるのっていいよね"},
        { "location": "944/TALK"    , "narrator": "神楽", "text": "すごいモチベ上がるし"},
        { "location": "945/TALK"    , "narrator": "神楽", "text": "私の理想だった"},
        { "location": "946/TALK"    , "narrator": "神楽", "text": "恋人作るなら、自分の創作にプラスになる人がいいなって思ってたから"},
        { "location": "948/SEL"     , "narrator": "", "text": "$me$もこういう話ができて嬉しい"},
        { "location": "949/SEL"     , "narrator": "", "text": "よかった"},
        { "location": "950/ACT"     , "narrator": "", "text": "$me$もこういう話ができて嬉しい"},
        { "location": "951/TALK"    , "narrator": "神楽", "text": "もしかして$handle$もなにか創作したりするの？"},
        { "location": "953/SEL"     , "narrator": "", "text": "イラストとか"},
        { "location": "954/SEL"     , "narrator": "", "text": "音楽とか"},
        { "location": "955/SEL"     , "narrator": "", "text": "文章書くよ"},
        { "location": "956/SEL"     , "narrator": "", "text": "得体の知れない何か"},
        { "location": "957/ACT"     , "narrator": "", "text": "イラストとか"},
        { "location": "958/TALK"    , "narrator": "神楽", "text": "ほんとー！！"},
        { "location": "959/TALK"    , "narrator": "神楽", "text": "今度見せて見せてー！！"},
        { "location": "960/TALK"    , "narrator": "神楽", "text": "合同本とかできたらいいなぁぁぁ～～～～っ"},
        { "location": "961/ACT"     , "narrator": "", "text": "音楽とか"},
        { "location": "962/TALK"    , "narrator": "神楽", "text": "すごーい！"},
        { "location": "963/TALK"    , "narrator": "神楽", "text": "ぴょんこに曲かいて～～～～っ"},
        { "location": "964/TALK"    , "narrator": "神楽", "text": "多分メチャ厳しくリテイクするけどなーｗｗｗ"},
        { "location": "965/ACT"     , "narrator": "", "text": "文章書くよ"},
        { "location": "966/TALK"    , "narrator": "神楽", "text": "みたいみたい！！"},
        { "location": "967/TALK"    , "narrator": "神楽", "text": "今度ぴょんこの代わりに物語本書かない？"},
        { "location": "968/ACT"     , "narrator": "", "text": "得体の知れない何か"},
        { "location": "969/TALK"    , "narrator": "神楽", "text": "ちょｗｗｗｗｗなにそれｗｗｗ"},
        { "location": "970/TALK"    , "narrator": "神楽", "text": "怖いんですけどｗｗｗでも見てみたいｗｗ"},
        { "location": "972/TALK"    , "narrator": "神楽", "text": "なんていいつつ、$handle$はぴょんこと合作とか考えない方がいいと思います"},
        { "location": "973/TALK"    , "narrator": "神楽", "text": "お互いの精神上とても良くない事になると思うので"},
        { "location": "975/SEL"     , "narrator": "", "text": "神楽は創作に命賭けてるもんなー"},
        { "location": "976/SEL"     , "narrator": "", "text": "$me$なら大丈夫だよ"},
        { "location": "977/ACT"     , "narrator": "", "text": "神楽は創作に命賭けてるもんなー"},
        { "location": "978/TALK"    , "narrator": "神楽", "text": "ふふふ～～～～"},
        { "location": "979/TALK"    , "narrator": "神楽", "text": "ちょっと嬉しいぴょんこ"},
        { "location": "980/TALK"    , "narrator": "神楽", "text": "ぴょんこぴょんこ♪"},
        { "location": "981/TALK"    , "narrator": "神楽", "text": "しゅき"},
        { "location": "982/ACT"     , "narrator": "", "text": "$me$なら大丈夫だよ"},
        { "location": "983/TALK"    , "narrator": "神楽", "text": "マジで？"},
        { "location": "984/TALK"    , "narrator": "神楽", "text": "じゃあ一度$handle$の見せてー"},
        { "location": "985/TALK"    , "narrator": "神楽", "text": "ぴょんこがほんとにすごいと思ったら一緒にやりましょう"},
        { "location": "986/TALK"    , "narrator": "神楽", "text": "けどダメだったら多分、立ち直れないくらい色々言っちゃうと思うけど"},
        { "location": "988/ACT"     , "narrator": "", "text": "よかった"},
        { "location": "989/TALK"    , "narrator": "神楽", "text": "ふふふ～～～～"},
        { "location": "991/TALK"    , "narrator": "神楽", "text": "それじゃぴょんこはそろそろエルカドールに戻ります"},
        { "location": "992/TALK"    , "narrator": "神楽", "text": "$handle$も夜はゆっくり寝てね"},
        { "location": "994/SEL"     , "narrator": "", "text": "おやすみ"},
        { "location": "995/SEL"     , "narrator": "", "text": "愛してるよ"},
        { "location": "996/ACT"     , "narrator": "", "text": "おやすみ"},
        { "location": "997/TALK"    , "narrator": "神楽", "text": "おやすみ～チュッ"},
        { "location": "998/ACT"     , "narrator": "", "text": "愛してるよ"},
        { "location": "999/TALK"    , "narrator": "神楽", "text": "あいしてる～～～～♪"},
        { "location": "830/DIALOG"  , "narrator": "Dialog_GETVoice", "text": "<color=green>【神楽】</color>のボイスメール\n<color=red>【新しい距離感】</color>\nをゲットしました！"}
