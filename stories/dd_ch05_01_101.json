{
    "dir": "chap01/daydra/dd_ch05_01_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "1502",
        "cid": "kagura",
        "title": "002 メインストーリー",
        "sub_title": "世界線歳差＜前編＞"
    },
    "entry":
    [
        { "location": "35/TALK"   , "narrator": "神楽", "text": "…日本。"},
        { "location": "36/TALK"   , "narrator": "神楽", "text": "まさか、こんな形で\n帰ることになるなんて…。"},
        { "location": "37/TALK"   , "narrator": "神楽", "text": "懐かしい人も、\n懐かしいものも…。"},
        { "location": "38/TALK"   , "narrator": "神楽", "text": "もう、なにも無い――"},
        { "location": "39/TALK"   , "narrator": "神楽", "text": "別世界の、日本…。"},
        { "location": "44/TALK"   , "narrator": "アナウンス", "text": "まもなく当機は、\n日本領海上空に\n到達致します。"},
        { "location": "45/TALK"   , "narrator": "アナウンス", "text": "厚木基地の現在の\n天候は、不明。\n気温は、不明。"},
        { "location": "46/TALK"   , "narrator": "アナウンス", "text": "到着推定時刻は、\n対向時間における、\n午前9時30分。"},
        { "location": "47/TALK"   , "narrator": "アナウンス", "text": "現時刻との時差は\n00分00秒と\nなっております。"},
        { "location": "49/TALK"   , "narrator": "神楽", "text": "…それにしても、\n自動運転のジェット機で\n行くことになるなんて…。"},
        { "location": "50/TALK"   , "narrator": "神楽", "text": "こんな見た目普通の\nチャーター機じゃ、\nエモさの欠けらもないし。"},
        { "location": "51/TALK"   , "narrator": "神楽", "text": "せめて内装が\n花や綺麗な布で\n覆われてたら…。"},
        { "location": "52/TALK"   , "narrator": "神楽", "text": "そういう気分にも\n浸れたのに…。"},
        { "location": "54/TALK"   , "narrator": "神楽", "text": "例えるなら、そう…、\n空を征く棺。"},
        { "location": "55/TALK"   , "narrator": "神楽", "text": "それは神への嫁入りか、\nそれとも、供物か…。"},
        { "location": "57/TALK"   , "narrator": "神楽", "text": "…なんて、ちょっと\nファンタジー過ぎか。"},
        { "location": "58/TALK"   , "narrator": "神楽", "text": "でも、それくらいの\n気持ちにでもならなきゃ、\nやってられない…。"},
        { "location": "60/TALK"   , "narrator": "神楽", "text": "…………。"},
        { "location": "62/TALK"   , "narrator": "神楽", "text": "…あれが、フェノメノン。"},
        { "location": "63/TALK"   , "narrator": "神楽", "text": "すごい…まるで、\n巨大な雲の壁…。"},
        { "location": "64/TALK"   , "narrator": "神楽", "text": "…黄泉へのゲート、の方が\n私にはピッタリかな？"},
        { "location": "65/TALK"   , "narrator": "神楽", "text": "…………。"},
        { "location": "66/TALK"   , "narrator": "神楽", "text": "ううん、違う。\nアレはそんなのじゃない。"},
        { "location": "67/TALK"   , "narrator": "神楽", "text": "アレは――"},
        { "location": "68/TALK"   , "narrator": "神楽", "text": "あの世界は――"},
        { "location": "70/TALK"   , "narrator": "神楽", "text": "逢瀬…つばめ…。"},
        { "location": "92/TALK"   , "narrator": "アナウンス", "text": "これより当機は、\n“不確定状態”を\n通過いたします。"},
        { "location": "93/TALK"   , "narrator": "アナウンス", "text": "“不確定状態”への\n到達までは、あと５分程を\n予定しております。"},
        { "location": "94/TALK"   , "narrator": "アナウンス", "text": "搭乗者は、\nトライガジェットを当機と\nリンクしてください。"},
        { "location": "95/TALK"   , "narrator": "アナウンス", "text": "あと4分30秒以内に\nリンクが完了出来ない\n場合、当機は旋回し――"},
        { "location": "96/TALK"   , "narrator": "アナウンス", "text": "01時間05分の後に、\n再度規定航路より不確定\n状態へと進入予定です。"},
        { "location": "97/TALK"   , "narrator": "アナウンス", "text": "繰り返します。\nこれより当機は――"},
        { "location": "99/TALK"   , "narrator": "神楽", "text": "っ…。"},
        { "location": "100/TALK"  , "narrator": "神楽", "text": "いよいよね。"},
        { "location": "101/TALK"  , "narrator": "神楽", "text": "ママ…。\n絶対、助けるから…。"},
        { "location": "103/TALK"  , "narrator": "アナウンス", "text": "搭乗者は、\nトライガジェットを当機と\nリンクしてください。"},
        { "location": "104/TALK"  , "narrator": "神楽", "text": "あっ…リンクアプリは…。"},
        { "location": "107/TALK"  , "narrator": "神楽", "text": "っていうか、これって\nちゃんと動くの？"},
        { "location": "108/TALK"  , "narrator": "神楽", "text": "…もし動かなかったら、\nクソゲー過ぎるけど。"},
        { "location": "111/TALK"  , "narrator": "プレイヤー", "text": "コマンド入力？"},
        { "location": "115/SEL"   , "narrator": "", "text": "操作：機体とトライガジェットをコネクトする"},
        { "location": "116/SEL"   , "narrator": "", "text": "つれないなー、少しお話しよう"},
        { "location": "117/ACT"   , "narrator": "", "text": "操作：機体とトライガジェットをコネクトする"},
        { "location": "120/ACT"   , "narrator": "", "text": "つれないなー、少しお話しよう"},
        { "location": "130/TALK"  , "narrator": "神楽", "text": "そんなことより"},
        { "location": "131/TALK"  , "narrator": "神楽", "text": "早く接続してください"},
        { "location": "133/SEL"   , "narrator": "", "text": "操作：機体とトライガジェットをコネクトする"},
        { "location": "134/ACT"   , "narrator": "", "text": "操作：機体とトライガジェットをコネクトする"},
        { "location": "140/TALK"  , "narrator": "神楽", "text": "今のがナビ？\n平行世界の…。"},
        { "location": "141/TALK"  , "narrator": "神楽", "text": "でも、どうしてこんな\nただ実行するだけの\nコマンドにまで――"},
        { "location": "142/TALK"  , "narrator": "神楽", "text": "異世界の存在が間に\n入ってる必要があるの\nかしら？"},
        { "location": "148/TALK"  , "narrator": "アナウンス", "text": "トライガジェット\nTRI-01Y\nリンク接続確認しました。"},
        { "location": "149/TALK"  , "narrator": "アナウンス", "text": "セルフチェック完了。\n正常動作確認しました。"},
        { "location": "150/TALK"  , "narrator": "アナウンス", "text": "定刻通りフェノメノンへ\n突入します。"},
        { "location": "151/TALK"  , "narrator": "アナウンス", "text": "着陸目標を北緯35度27分、\n東経139度26分へセット。"},
        { "location": "152/TALK"  , "narrator": "アナウンス", "text": "予想到着時刻は予定時刻\nプラスマイナス5分。"},
        { "location": "153/TALK"  , "narrator": "神楽", "text": "ふぅ…、\n上手くいったみたい。"},
        { "location": "154/SEL"   , "narrator": "", "text": "改めて初めまして、$handle$です"},
        { "location": "155/SEL"   , "narrator": "", "text": "美しい女性が一人旅とは。話し相手は如何ですか？"},
        { "location": "157/TALK"  , "narrator": "神楽", "text": "………。"},
        { "location": "158/TALK"  , "narrator": "神楽", "text": "……………。"},
        { "location": "161/TALK"  , "narrator": "神楽", "text": "…。"},
        { "location": "170/ACT"   , "narrator": "", "text": "改めて初めまして、$handle$です"},
        { "location": "179/ACT"   , "narrator": "", "text": "美しい女性が一人旅とは。話し相手は如何ですか？"},
        { "location": "188/TALK"  , "narrator": "神楽", "text": "これが、ナビ？\n平行世界の…。"},
        { "location": "194/TALK"  , "narrator": "神楽", "text": "はじめまして$handle$さん"},
        { "location": "197/TALK"  , "narrator": "神楽", "text": "$handle$さんは日本語で対話するんですね"},
        { "location": "198/TALK"  , "narrator": "神楽", "text": "日本人なんですか？"},
        { "location": "201/TALK"  , "narrator": "神楽", "text": "こことは違うどこか"},
        { "location": "202/TALK"  , "narrator": "神楽", "text": "遠い世界の"},
        { "location": "204/SEL"   , "narrator": "", "text": "意外と近いかもしれないよ"},
        { "location": "205/SEL"   , "narrator": "", "text": "アイアム日本人？"},
        { "location": "206/SEL"   , "narrator": "", "text": "よく知ってるね"},
        { "location": "207/ACT"   , "narrator": "", "text": "意外と近いかもしれないよ"},
        { "location": "208/TALK"  , "narrator": "神楽", "text": "近いんですか？"},
        { "location": "209/TALK"  , "narrator": "神楽", "text": "でも世界が違う時点で遠いような気がしますけど"},
        { "location": "210/TALK"  , "narrator": "神楽", "text": "そういうものじゃないんですか？"},
        { "location": "212/SEL"   , "narrator": "", "text": "実はよく知らないんだよね"},
        { "location": "213/ACT"   , "narrator": "", "text": "実はよく知らないんだよね"},
        { "location": "216/TALK"  , "narrator": "神楽", "text": "そうなんですか？"},
        { "location": "217/ACT"   , "narrator": "", "text": "アイアム日本人？"},
        { "location": "218/TALK"  , "narrator": "神楽", "text": "質問してるのはこっちですけど"},
        { "location": "219/TALK"  , "narrator": "神楽", "text": "色々とツッコミどころ満載ですよそれ？"},
        { "location": "220/ACT"   , "narrator": "", "text": "よく知ってるね"},
        { "location": "221/TALK"  , "narrator": "神楽", "text": "やっぱり"},
        { "location": "222/TALK"  , "narrator": "神楽", "text": "こちらも事前に教わっていますので"},
        { "location": "224/SEL"   , "narrator": "", "text": "$me$のプライバシーはどこへ？"},
        { "location": "225/SEL"   , "narrator": "", "text": "知ってくれてて嬉しい"},
        { "location": "226/ACT"   , "narrator": "", "text": "$me$のプライバシーはどこへ？"},
        { "location": "227/TALK"  , "narrator": "神楽", "text": "私に聞かれてもそれは困りますけど"},
        { "location": "228/TALK"  , "narrator": "神楽", "text": "気にするほどじゃないと思いますよ？"},
        { "location": "229/TALK"  , "narrator": "神楽", "text": "あなた個人の話は聞いてませんし"},
        { "location": "230/ACT"   , "narrator": "", "text": "知ってくれてて嬉しい"},
        { "location": "231/TALK"  , "narrator": "神楽", "text": "そうなんですか？"},
        { "location": "232/TALK"  , "narrator": "神楽", "text": "よくわからないけど"},
        { "location": "233/TALK"  , "narrator": "神楽", "text": "喜んでもらえているならよかったです"},
        { "location": "236/TALK"  , "narrator": "神楽", "text": "とりあえずこれから色々とお世話になると思うので"},
        { "location": "237/TALK"  , "narrator": "神楽", "text": "よろしくお願いします"},
        { "location": "239/SEL"   , "narrator": "", "text": "ＯＫ、任せろ！"},
        { "location": "240/SEL"   , "narrator": "", "text": "大船に乗った気でいてくれ！"},
        { "location": "241/ACT"   , "narrator": "", "text": "ＯＫ、任せろ！"},
        { "location": "242/ACT"   , "narrator": "", "text": "大船に乗った気でいてくれ！"},
        { "location": "245/TALK"  , "narrator": "神楽", "text": "あの、本当に、"},
        { "location": "246/TALK"  , "narrator": "神楽", "text": "こことは違う世界の方ですか？"},
        { "location": "248/SEL"   , "narrator": "", "text": "そうだけど、どうして？"},
        { "location": "249/ACT"   , "narrator": "", "text": "そうだけど、どうして？"},
        { "location": "251/TALK"  , "narrator": "神楽", "text": "なんか"},
        { "location": "252/TALK"  , "narrator": "神楽", "text": "想像していたのと違うというか"},
        { "location": "255/TALK"  , "narrator": "神楽", "text": "$handle$さんのことを教えてくれたのって"},
        { "location": "256/TALK"  , "narrator": "神楽", "text": "私の上司に当たる人間や"},
        { "location": "257/TALK"  , "narrator": "神楽", "text": "科学者と呼ばれる方々だったので"},
        { "location": "258/TALK"  , "narrator": "神楽", "text": "失礼ですが"},
        { "location": "259/TALK"  , "narrator": "神楽", "text": "もっととても真面目でユーモアとか持ってない人を想像していました"},
        { "location": "261/SEL"   , "narrator": "", "text": "ごめんねー"},
        { "location": "262/ACT"   , "narrator": "", "text": "ごめんねー"},
        { "location": "265/TALK"  , "narrator": "神楽", "text": "なんか"},
        { "location": "266/TALK"  , "narrator": "神楽", "text": "緩すぎて気が抜けてきました"},
        { "location": "268/SEL"   , "narrator": "", "text": "弛んでるぞ、卯月神楽！！"},
        { "location": "269/SEL"   , "narrator": "", "text": "そんなことより恋バナでもしようよ"},
        { "location": "270/SEL"   , "narrator": "", "text": "緊張してるよりいいでしょ？"},
        { "location": "271/ACT"   , "narrator": "", "text": "弛んでるぞ、卯月神楽！！"},
        { "location": "272/TALK"  , "narrator": "神楽", "text": "弛ませてるのは誰ですか？"},
        { "location": "273/TALK"  , "narrator": "神楽", "text": "まあ話しやすい人みたいなので"},
        { "location": "274/TALK"  , "narrator": "神楽", "text": "ちょっと安心しましたけど"},
        { "location": "275/ACT"   , "narrator": "", "text": "そんなことより恋バナでもしようよ"},
        { "location": "276/TALK"  , "narrator": "神楽", "text": "いやどうして突然そうなるんですか？"},
        { "location": "277/TALK"  , "narrator": "神楽", "text": "この話の流れでどうして恋バナ？"},
        { "location": "279/SEL"   , "narrator": "", "text": "女子高生なら好きかと思って"},
        { "location": "280/SEL"   , "narrator": "", "text": "恋バナ好きだから"},
        { "location": "281/ACT"   , "narrator": "", "text": "女子高生なら好きかと思って"},
        { "location": "282/TALK"  , "narrator": "神楽", "text": "女子高生ってｗいつの言葉です？昭和？大正？女学生みたいなｗｗ"},
        { "location": "283/TALK"  , "narrator": "神楽", "text": "ていうか、ハイティ＝恋バナ好きとかちょっと単純過ぎますよ？"},
        { "location": "284/TALK"  , "narrator": "神楽", "text": "あーハイティ＝女子高生です。これからは女子高生っていいますｗ"},
        { "location": "285/TALK"  , "narrator": "神楽", "text": "まあ恋バナは大好物ですけど"},
        { "location": "286/TALK"  , "narrator": "神楽", "text": "やっぱり恋バナはワクワクしますから！"},
        { "location": "287/ACT"   , "narrator": "", "text": "恋バナ好きだから"},
        { "location": "288/TALK"  , "narrator": "神楽", "text": "納得しました"},
        { "location": "289/TALK"  , "narrator": "神楽", "text": "脈絡無く話を振るくらい好きなんですね"},
        { "location": "291/TALK"  , "narrator": "神楽", "text": "でも初対面の人と恋バナとか"},
        { "location": "292/TALK"  , "narrator": "神楽", "text": "私にはレベルが高過ぎるので遠慮します"},
        { "location": "293/ACT"   , "narrator": "", "text": "緊張してるよりいいでしょ？"},
        { "location": "294/TALK"  , "narrator": "神楽", "text": "どうなんですかね？"},
        { "location": "295/TALK"  , "narrator": "神楽", "text": "今の状況的には"},
        { "location": "296/TALK"  , "narrator": "神楽", "text": "緊張してるくらいがベストな気もしますけど"},
        { "location": "297/TALK"  , "narrator": "神楽", "text": "ちょっとリラックスできた感はありますね"},
        { "location": "299/TALK"  , "narrator": "神楽", "text": "そういえば"},
        { "location": "300/TALK"  , "narrator": "神楽", "text": "どうしても聞きたかったことがあるんです"},
        { "location": "301/TALK"  , "narrator": "神楽", "text": "$handle$さんのいる日本って"},
        { "location": "302/TALK"  , "narrator": "神楽", "text": "こっちの世界の日本と比べると"},
        { "location": "308/TALK"  , "narrator": "アナウンス", "text": "不確定量子雲へ\n進入します。"},
        { "location": "309/TALK"  , "narrator": "アナウンス", "text": "搭乗者は衝撃に\n備えてください"},
        { "location": "312/TALK"  , "narrator": "神楽", "text": "いつの間に…？\n随分長く話してたみたい。"},
        { "location": "315/TALK"  , "narrator": "神楽", "text": "…いよいよなんだ。"},
        { "location": "316/TALK"  , "narrator": "神楽", "text": "私、戻ってきたんだ…。"},
        { "location": "317/TALK"  , "narrator": "神楽", "text": "私の知らない、\n私の生まれ故郷へ…。"},
        { "location": "319/TALK"  , "narrator": "神楽", "text": "…っ！？"},
        { "location": "371/TALK"  , "narrator": "ぴょんこ", "text": "　"},
        { "location": "401/TALK"  , "narrator": "エリカ", "text": "もーっ、\nあーなーたーっ！"},
        { "location": "402/SEL"   , "narrator": "", "text": "は、はい！？"},
        { "location": "403/ACT"   , "narrator": "", "text": "は、はい！？"},
        { "location": "405/TALK"  , "narrator": "エリカ", "text": "ココロスフィアで\n外との回線切るまでは\nお話したらダメだよー！"},
        { "location": "406/SEL"   , "narrator": "", "text": "そうですね、つい…"},
        { "location": "407/ACT"   , "narrator": "", "text": "そうですね、つい…"},
        { "location": "409/TALK"  , "narrator": "エリカ", "text": "神楽ちゃんの感覚を\n経由して、“彼ら”に\n伝わっちゃったよ？"},
        { "location": "410/TALK"  , "narrator": "エリカ", "text": "あなたが過去の\n神楽ちゃんに介入しようと\nしているってことが。"},
        { "location": "411/SEL"   , "narrator": "", "text": "どうなっちゃうんですかね…"},
        { "location": "412/ACT"   , "narrator": "", "text": "どうなっちゃうんですかね…"},
        { "location": "414/TALK"  , "narrator": "エリカ", "text": "うーん、まあでも……\nそうだなぁ。"},
        { "location": "415/TALK"  , "narrator": "エリカ", "text": "楽観的に見れば、\n何も起こらないかな？"},
        { "location": "416/TALK"  , "narrator": "エリカ", "text": "この可能性世界を\nこれ以上進めなければ\nいいだけだから。"},
        { "location": "417/TALK"  , "narrator": "エリカ", "text": "あなたがもう一度、\n神楽ちゃんとのファースト\nコンタクトをやり直し――"},
        { "location": "418/TALK"  , "narrator": "エリカ", "text": "次は会話せずに\nここまで来れば、\nそれが正史になるから。"},
        { "location": "419/TALK"  , "narrator": "エリカ", "text": "その先に繋がる未来では\n“彼ら”があなたに介入\nしてることは知らない。"},
        { "location": "420/TALK"  , "narrator": "エリカ", "text": "少なくとも、別の理由で\nバレちゃうまではね。"},
        { "location": "421/SEL"   , "narrator": "", "text": "今からやり直して歴史の流れを変えるってこと？"},
        { "location": "422/ACT"   , "narrator": "", "text": "今からやり直して歴史の流れを変えるってこと？"},
        { "location": "424/TALK"  , "narrator": "エリカ", "text": "そうだよ。\nまさにリプレイス作戦の\n最小単位だよね。"},
        { "location": "425/TALK"  , "narrator": "エリカ", "text": "ある意味リプレイス作戦の\n説明として、最も解り\nやすい実践になったかも。"},
        { "location": "426/SEL"   , "narrator": "", "text": "OK、逝ってくる…"},
        { "location": "427/SEL"   , "narrator": "", "text": "じゃあ、「悲観的に見れば」？"},
        { "location": "428/ACT"   , "narrator": "", "text": "OK、逝ってくる…"},
        { "location": "429/TALK"  , "narrator": "エリカ", "text": "それじゃ、よろしくね。"},
        { "location": "430/ACT"   , "narrator": "", "text": "じゃあ、「悲観的に見れば」？"},
        { "location": "431/TALK"  , "narrator": "エリカ", "text": "うーん……"},
        { "location": "432/TALK"  , "narrator": "エリカ", "text": "まあ、たぶん\n大丈夫だよ。"},
        { "location": "433/SEL"   , "narrator": "", "text": "えー…"},
        { "location": "434/ACT"   , "narrator": "", "text": "えー…"},
        { "location": "436/TALK"  , "narrator": "エリカ", "text": "悲観的に考えようとすれば\nそれこそ何でも\n考えられちゃうから。"},
        { "location": "437/SEL"   , "narrator": "", "text": "それじゃ考え得る中で最も妥当な悲観的なヤツ教えて"},
        { "location": "438/SEL"   , "narrator": "", "text": "それじゃ考え得る中で最悪の事態を教えて"},
        { "location": "439/ACT"   , "narrator": "", "text": "それじゃ考え得る中で最も妥当な悲観的なヤツ教えて"},
        { "location": "440/TALK"  , "narrator": "エリカ", "text": "うーん…そうだなぁ。"},
        { "location": "441/TALK"  , "narrator": "エリカ", "text": "全可能性を掌握するものが\nどこかに存在していた場合\n“彼ら”がそこから知る。"},
        { "location": "442/TALK"  , "narrator": "エリカ", "text": "もちろん、それは\n天文学的数量の可能性から\n検索することになるから、"},
        { "location": "443/TALK"  , "narrator": "エリカ", "text": "ほぼ不可能では\nあると思うけど……"},
        { "location": "444/TALK"  , "narrator": "エリカ", "text": "逆に言えば、\n“彼ら”は全ての可能性を\n追うことはできない。"},
        { "location": "445/TALK"  , "narrator": "エリカ", "text": "だから、\n多分大丈夫だと思う。"},
        { "location": "446/ACT"   , "narrator": "", "text": "それじゃ考え得る中で最悪の事態を教えて"},
        { "location": "447/TALK"  , "narrator": "エリカ", "text": "今、この瞬間を\nリアルタイムで\n検知していて――"},
        { "location": "448/TALK"  , "narrator": "エリカ", "text": "今この瞬間、\n全てのシステムを\n凍結する。"},
        { "location": "449/TALK"  , "narrator": "エリカ", "text": "二度とリプレイスが\n効かなくなり、未来は\n現状の延長で固定される。"},
        { "location": "450/TALK"  , "narrator": "エリカ", "text": "あなたはもう、こちらの\n世界にアクセスできない\nようにブロックされ――"},
        { "location": "451/TALK"  , "narrator": "エリカ", "text": "二度とわたしたちと\n会うことはできなくなる。"},
        { "location": "452/TALK"  , "narrator": "エリカ", "text": "……なんて話してる間にも\n見つかる可能性は微小に\n高まってるんだけどね。"},
        { "location": "454/TALK"  , "narrator": "エリカ", "text": "とにかく、この可能性\n世界を放っておけば\n危険なのは確かだから。"},
        { "location": "455/TALK"  , "narrator": "エリカ", "text": "だから、すぐにでも\n消去するよ。"},
        { "location": "456/SEL"   , "narrator": "", "text": "それって、今のエリカさんは消えちゃうってこと！？"},
        { "location": "457/ACT"   , "narrator": "", "text": "それって、今のエリカさんは消えちゃうってこと！？"},
        { "location": "459/TALK"  , "narrator": "エリカ", "text": "消えないし、\nそんなに深く考えなくても\n大丈夫だよ。"},
        { "location": "460/TALK"  , "narrator": "エリカ", "text": "単にこの先は観測されず\n不確定な世界として重ね\n合わせの１つに戻るだけ。"},
        { "location": "461/TALK"  , "narrator": "エリカ", "text": "今までだって、あなたが\nOSを強制終了するたびに\n起こってたことだから。"},
        { "location": "462/TALK"  , "narrator": "エリカ", "text": "それより、観測し続ける\nことの方が、よっぽど\n危ないからね。"},
        { "location": "463/TALK"  , "narrator": "エリカ", "text": "それじゃ、またね。"},
        { "location": "465/TALK"  , "narrator": "エリカ", "text": "後始末はわたしが\nやっておくから、\n心配しなくていいからね？"},
        { "location": "479/TALK"  , "narrator": "エリカ", "text": "こんにちは、\n$handle$さん！"},
        { "location": "480/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん♪"},
        { "location": "481/SEL"   , "narrator": "", "text": "で、どうやって切断すればいいの？"},
        { "location": "482/SEL"   , "narrator": "", "text": "ぴょんこ！！"},
        { "location": "483/ACT"   , "narrator": "", "text": "で、どうやって切断すればいいの？"},
        { "location": "484/TALK"  , "narrator": "エリカ", "text": "えっとね、\nその前に紹介するね。"},
        { "location": "485/ACT"   , "narrator": "", "text": "ぴょんこ！！"},
        { "location": "486/TALK"  , "narrator": "ぴょんこ", "text": "あれあれっ？\nぴょんこのこと\n知ってるんですか？"},
        { "location": "487/SEL"   , "narrator": "", "text": "前に会ったことがあるよ"},
        { "location": "488/ACT"   , "narrator": "", "text": "前に会ったことがあるよ"},
        { "location": "490/TALK"  , "narrator": "エリカ", "text": "そういえば、一度だけ\n千羽鶴ちゃんが\nチャンネル開いてたね。"},
        { "location": "491/TALK"  , "narrator": "ぴょんこ", "text": "ということは、\nあなたとぴょんこは\n以前これから出逢ったと！"},
        { "location": "492/SEL"   , "narrator": "", "text": "ややこしい"},
        { "location": "493/ACT"   , "narrator": "", "text": "ややこしい"},
        { "location": "495/TALK"  , "narrator": "エリカ", "text": "とにかく、\n改めて紹介するね。"},
        { "location": "497/TALK"  , "narrator": "エリカ", "text": "神楽ちゃんの\nココロの司書さんの\nぴょんこちゃんです！"},
        { "location": "498/TALK"  , "narrator": "ぴょんこ", "text": "よろしくぴょん♪"},
        { "location": "499/TALK"  , "narrator": "ぴょんこ", "text": "これから二人で\n楽しいこと\nいっぱいするぴょん！"},
        { "location": "500/SEL"   , "narrator": "", "text": "よろしくね"},
        { "location": "501/SEL"   , "narrator": "", "text": "二人で楽しいこと（意味深）"},
        { "location": "502/SEL"   , "narrator": "", "text": "ぴょんこも千羽鶴が抜擢したの？"},
        { "location": "503/ACT"   , "narrator": "", "text": "よろしくね"},
        { "location": "504/TALK"  , "narrator": "ぴょんこ", "text": "はいっ！"},
        { "location": "505/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんと\nお逢いできるのを\n楽しみにしてました！"},
        { "location": "506/TALK"  , "narrator": "ぴょんこ", "text": "きっとこれから\nこのつまんねー場所は、\n御伽の国になるでしょう♪"},
        { "location": "507/ACT"   , "narrator": "", "text": "二人で楽しいこと（意味深）"},
        { "location": "509/TALK"  , "narrator": "ぴょんこ", "text": "今ちょっと\nヘンなこと\n妄想しましたねっ♪"},
        { "location": "510/TALK"  , "narrator": "ぴょんこ", "text": "本当に、これからが\n楽しみです♪（意味深）\nふふふっ……"},
        { "location": "511/ACT"   , "narrator": "", "text": "ぴょんこも千羽鶴が抜擢したの？"},
        { "location": "512/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん？\n折り紙の話ですか？"},
        { "location": "513/TALK"  , "narrator": "エリカ", "text": "ぴょんこちゃんの抜擢は\nわたしがしたの。"},
        { "location": "514/SEL"   , "narrator": "", "text": "ナイスチョイス！"},
        { "location": "515/SEL"   , "narrator": "", "text": "なんでよりによって…"},
        { "location": "516/ACT"   , "narrator": "", "text": "ナイスチョイス！"},
        { "location": "517/TALK"  , "narrator": "エリカ", "text": "よかった！"},
        { "location": "518/TALK"  , "narrator": "エリカ", "text": "ココロの中なんだし\n楽しい方がいいよね！"},
        { "location": "519/ACT"   , "narrator": "", "text": "なんでよりによって…"},
        { "location": "520/TALK"  , "narrator": "エリカ", "text": "えっと、\nちゃんと理由は\nあるんだけど――"},
        { "location": "521/TALK"  , "narrator": "エリカ", "text": "だめだったかな？"},
        { "location": "522/TALK"  , "narrator": "エリカ", "text": "これからのことを\n考えるとぴょんこちゃんが\n適任なんだよね。"},
        { "location": "523/TALK"  , "narrator": "エリカ", "text": "でも、あまりにやりにくい\nようなら、また相談して\nくれれば考えるよ。"},
        { "location": "524/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこも\n精一杯頑張りますよっ！"},
        { "location": "527/TALK"  , "narrator": "エリカ", "text": "というわけで、\n早速だけど、今回の\n目的の話をするよ。"},
        { "location": "528/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん！"},
        { "location": "529/TALK"  , "narrator": "エリカ", "text": "今、神楽ちゃんのココロは\nRedinessによって直接\n外の世界と繋がってる。"},
        { "location": "530/TALK"  , "narrator": "エリカ", "text": "それを、つばめちゃんの\nフェノメノンを経由する\n形に切り替えるの。"},
        { "location": "531/SEL"   , "narrator": "", "text": "切断するのでは？"},
        { "location": "532/ACT"   , "narrator": "", "text": "切断するのでは？"},
        { "location": "534/TALK"  , "narrator": "エリカ", "text": "この前は解りやすく\n話すために、切断するって\n言ったけど――"},
        { "location": "535/TALK"  , "narrator": "エリカ", "text": "本当にRediness回線を\n切断しちゃうと、あなたと\n交流できなくなっちゃう。"},
        { "location": "536/TALK"  , "narrator": "エリカ", "text": "目的は“彼ら”から\n神楽ちゃんのココロを\n監視できなくすること。"},
        { "location": "537/TALK"  , "narrator": "エリカ", "text": "だから、フェノメノンに\n巻き込まれたのと同じ\n状況にしてしまうの。"},
        { "location": "538/SEL"   , "narrator": "", "text": "でも結局のところ、監視できなくなれば気づかれるのでは？"},
        { "location": "539/ACT"   , "narrator": "", "text": "でも結局のところ、監視できなくなれば気づかれるのでは？"},
        { "location": "541/TALK"  , "narrator": "エリカ", "text": "そうだね。"},
        { "location": "542/TALK"  , "narrator": "エリカ", "text": "でも、それが\n事故なのか故意なのかは、\nわからない筈なの。"},
        { "location": "543/TALK"  , "narrator": "エリカ", "text": "なぜなら、“彼ら”は\nフェノメノンの中を\n覗くことができないから。"},
        { "location": "544/TALK"  , "narrator": "エリカ", "text": "それに、フェノメノンに\n侵入しすぐに監視できなく\nなれば、まず事故を疑う。"},
        { "location": "545/TALK"  , "narrator": "エリカ", "text": "そして、恐らく\nその線を想定して\n調査を開始すると思う。"},
        { "location": "546/TALK"  , "narrator": "エリカ", "text": "結果としてフェノメノンに\n取り込まれたということは\nすぐ判明すると思うけど、"},
        { "location": "547/TALK"  , "narrator": "エリカ", "text": "それ以上の調査は、\n恐らくすぐにはできない。"},
        { "location": "549/TALK"  , "narrator": "エリカ", "text": "時間をかけ調査されたら、\nそのうちバレちゃうかな\nとは思うけどね。"},
        { "location": "550/TALK"  , "narrator": "エリカ", "text": "その時までに、\nどれくらいリプレイスを\n成し遂げられるか――"},
        { "location": "551/TALK"  , "narrator": "エリカ", "text": "それが、今回の\n肝になるって感じかな。"},
        { "location": "552/SEL"   , "narrator": "", "text": "なるほど"},
        { "location": "553/ACT"   , "narrator": "", "text": "なるほど"},
        { "location": "555/TALK"  , "narrator": "エリカ", "text": "というわけで！\n早速だけど、\n回線の切替えをします！"},
        { "location": "556/TALK"  , "narrator": "エリカ", "text": "切替自体はわたしが\nやるんだけど、その前に\nひとつ障害があるの。"},
        { "location": "557/TALK"  , "narrator": "エリカ", "text": "回線制御をする\nRedinessは、その個人の\n精神を認証に使ってる。"},
        { "location": "558/TALK"  , "narrator": "エリカ", "text": "すなわち、神楽ちゃんの\nRedinessに\nアタックするには――"},
        { "location": "559/TALK"  , "narrator": "エリカ", "text": "その認証、すなわち\nセキュリティを突破\nしなくちゃいけない。"},
        { "location": "560/TALK"  , "narrator": "エリカ", "text": "今からぴょんこちゃんに\nそのアドレスまでゲートを\n回してもらうよ。"},
        { "location": "561/TALK"  , "narrator": "エリカ", "text": "到着したら、あなたには\nそこにいるクランを\n排除してほしいの。"},
        { "location": "562/TALK"  , "narrator": "エリカ", "text": "そのクランは、\nRedinessとココロの\n関所の様な役目だから――"},
        { "location": "563/SEL"   , "narrator": "", "text": "それって平気なの！？"},
        { "location": "564/ACT"   , "narrator": "", "text": "それって平気なの！？"},
        { "location": "566/TALK"  , "narrator": "エリカ", "text": "…うーん、\n理論上は平気だよ。"},
        { "location": "567/TALK"  , "narrator": "エリカ", "text": "そのクランを破壊する\nわけじゃなくて、そこを\n退いてもらうだけだし。"},
        { "location": "568/TALK"  , "narrator": "エリカ", "text": "それも、\nRedinessをハックする\nごく一時的にだけ。"},
        { "location": "569/TALK"  , "narrator": "エリカ", "text": "ただ、100％絶対安全かと\n言われちゃうと、さすがに\nそれはYESと言えない。"},
        { "location": "570/TALK"  , "narrator": "エリカ", "text": "それでもわたしは、\nこの作戦以上に安全な\n作戦は思いつかなかった。"},
        { "location": "571/TALK"  , "narrator": "エリカ", "text": "だから、もしあなたが\nそんな危険なことは\n出来ないって思うなら――"},
        { "location": "572/TALK"  , "narrator": "エリカ", "text": "ここでお終いにするって\nいう選択肢もある。"},
        { "location": "573/TALK"  , "narrator": "エリカ", "text": "どうする？"},
        { "location": "574/SEL"   , "narrator": "", "text": "作戦を遂行する"},
        { "location": "575/SEL"   , "narrator": "", "text": "ここで中断する"},
        { "location": "578/TALK"  , "narrator": "エリカ", "text": "もし考えにくいようなら、\nこう考えるといいかも。"},
        { "location": "579/TALK"  , "narrator": "エリカ", "text": "インフルエンザの\n予防接種をするか否か。"},
        { "location": "580/TALK"  , "narrator": "エリカ", "text": "する場合、副反応による\nリスクが存在する。"},
        { "location": "581/TALK"  , "narrator": "エリカ", "text": "しない場合は、\nインフルエンザに罹る\n可能性が出てくる。"},
        { "location": "582/TALK"  , "narrator": "エリカ", "text": "もちろん、どちらも\n100％そうなるわけでは\nなくて――"},
        { "location": "583/TALK"  , "narrator": "エリカ", "text": "それぞれにおいて、\nそれぞれの統計的な\n確率が存在する。"},
        { "location": "584/TALK"  , "narrator": "エリカ", "text": "今回の件は、少なからず\n無理矢理ココロを操作する\nことになるよね。"},
        { "location": "585/TALK"  , "narrator": "エリカ", "text": "だから、100％の安全を\n保証することはできない。"},
        { "location": "586/TALK"  , "narrator": "エリカ", "text": "けど、何か出る可能性は\n限りなく小さい。"},
        { "location": "587/TALK"  , "narrator": "エリカ", "text": "少なくとも\nわたしはそう思ってるよ。"},
        { "location": "588/ACT"   , "narrator": "", "text": "作戦を遂行する"},
        { "location": "590/TALK"  , "narrator": "エリカ", "text": "うん、わかったよ！\n決めてくれてありがとう。"},
        { "location": "591/TALK"  , "narrator": "エリカ", "text": "それじゃ、\nこれから一緒に\n頑張っていこうね！"},
        { "location": "592/SEL"   , "narrator": "", "text": "よろしく"},
        { "location": "593/ACT"   , "narrator": "", "text": "よろしく"},
        { "location": "595/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこからも、\nどうぞよろしく\nお願いします、ですっ！"},
        { "location": "597/TALK"  , "narrator": "エリカ", "text": "それじゃ、\nぴょんこちゃん\n回してください！"},
        { "location": "599/TALK"  , "narrator": "ぴょんこ", "text": "わかりました！\n頑張りますっ！"},
        { "location": "603/TALK"  , "narrator": "ぴょんこ", "text": "オープンプロセス、\n2x000番地から\n2xFFF番地へ。"},
        { "location": "631/TALK"  , "narrator": "ぴょんこ", "text": "シーク完了ぴょん♪"},
        { "location": "632/TALK"  , "narrator": "エリカ", "text": "この扉の向こうに、\nセキュリティ担当の\nクランがいるから。"},
        { "location": "633/TALK"  , "narrator": "エリカ", "text": "ちょっとだけ、\nごめんね？って感じで\n退いてもらってね？"},
        { "location": "634/TALK"  , "narrator": "ぴょんこ", "text": "文句言われたら、\nぴょんこの名前を\n挙げるといいですよっ！"},
        { "location": "635/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこは\nぴょんこのココロの中では\n顔パスですから♪"},
        { "location": "636/SEL"   , "narrator": "", "text": "お、おう…"},
        { "location": "637/ACT"   , "narrator": "", "text": "お、おう…"},
        { "location": "639/TALK"  , "narrator": "エリカ", "text": "それじゃ、改めて\n今回はよろしく\nお願いします！"},
        { "location": "640/TALK"  , "narrator": "エリカ", "text": "あ、それと。"},
        { "location": "641/TALK"  , "narrator": "エリカ", "text": "成功すると、次に現実で\n神楽ちゃんを見てる時に\n一度エラーが出るから。"},
        { "location": "642/TALK"  , "narrator": "エリカ", "text": "そのエラーが出た後は、\nアドレスがフェノメノンの\n中に切り替わってるよ。"},
        { "location": "643/TALK"  , "narrator": "エリカ", "text": "だから、それ以降は\n沢山話していいからね！"},
        { "location": "644/TALK"  , "narrator": "エリカ", "text": "あっ！　でも、１つだけ\n絶対に話しちゃ\nダメなこともあるから。"},
        { "location": "645/SEL"   , "narrator": "", "text": "なに？"},
        { "location": "646/ACT"   , "narrator": "", "text": "なに？"},
        { "location": "648/TALK"  , "narrator": "エリカ", "text": "これから先、何が起こって\nどういう結果になるか、\nっていう話。"},
        { "location": "649/TALK"  , "narrator": "エリカ", "text": "未来のことだけは\n絶対に話しちゃダメ！"},
        { "location": "650/SEL"   , "narrator": "", "text": "どうして？"},
        { "location": "651/ACT"   , "narrator": "", "text": "どうして？"},
        { "location": "653/TALK"  , "narrator": "エリカ", "text": "未来のことを話すと、\n未来が崩れちゃうから。"},
        { "location": "654/TALK"  , "narrator": "エリカ", "text": "話さなければ絶対に\n揺るがない正解も、話せば\n不正解に変わってしまう。"},
        { "location": "655/TALK"  , "narrator": "エリカ", "text": "未来について語れば、\nそんなことだって普通に\n起きてしまうの。"},
        { "location": "656/TALK"  , "narrator": "エリカ", "text": "だからこれだけは、\nホントにお願いだよ？"},
        { "location": "657/SEL"   , "narrator": "", "text": "わかった"},
        { "location": "658/ACT"   , "narrator": "", "text": "わかった"},
        { "location": "660/TALK"  , "narrator": "エリカ", "text": "それじゃ、頑張ってね！"},
        { "location": "661/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんと\nぴょんこにとって\n素敵なココロの旅を♪"},
        { "location": "668/ACT"   , "narrator": "", "text": "ここで中断する"},
        { "location": "670/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん……"},
        { "location": "671/TALK"  , "narrator": "エリカ", "text": "わかったよ。\nちゃんと答えてくれて\nありがとう。"},
        { "location": "672/TALK"  , "narrator": "エリカ", "text": "それじゃ、この作戦は\nここで中断するよ。"},
        { "location": "673/TALK"  , "narrator": "エリカ", "text": "でも、もし色々考えて\n気が変わったりしたら、\nいつでも声を掛けてね。"},
        { "location": "674/TALK"  , "narrator": "エリカ", "text": "その時はすぐに、\n作戦を遂行できるように\nしておくから。"},
        { "location": "675/TALK"  , "narrator": "エリカ", "text": "それじゃ、またね。"},
        { "location": "676/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん……"},
        { "location": "14/DIALOG" , "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:Interrupt】</color>\nSystem Interrupted.\n\n必須選択肢が選ばれていません。\n\n<color=green>『STORY27：シン・カグラ』</color>\nにて、選択を行ってから\n再度アクセスしてください。\n"},
        { "location": "19/DIALOG" , "narrator": "dialog_black", "text": "北緯27度　東経122度\n\n東シナ海上空　高度12,000m"},
        { "location": "32/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>3月21日　 8:22 AM</color>\n東シナ海上空にて。"},
        { "location": "81/DIALOG" , "narrator": "dialog_black", "text": "2032年の魔女に、\n支配されている――"},
        { "location": "336/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "338/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "340/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "342/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "344/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "470/DIALOG", "narrator": "NOTICE", "text": "<color=red>【TRI-OS Error:0x99】</color>\nココロスフィアとの回線が\n切断されました。(981)"},
        { "location": "681/DIALOG", "narrator": "NOTICE", "text": "<color=red>【TRI-OS Error:0x99】</color>\nココロスフィアとの回線が\n切断されました。(981)"}
