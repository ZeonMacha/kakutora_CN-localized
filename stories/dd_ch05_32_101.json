{
    "dir": "chap32/daydra/dd_ch05_32_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "32502",
        "cid": "kagura",
        "title": "002 メインストーリー",
        "sub_title": "アーケロン爆殺事件＜前編＞"
    },
    "entry":
    [
        { "location": "1368/TALK"  , "narrator": "アーヤ", "text": "都内に入ったわよ。"},
        { "location": "1369/TALK"  , "narrator": "アーヤ", "text": "後は首都高で一直線。\n文京ドームにも\nもうすぐ着くわ。"},
        { "location": "1370/TALK"  , "narrator": "ガブリエラ", "text": "意外と早かったわね。\nもう少しドンパチが\nあるかと思ったけど。"},
        { "location": "1372/TALK"  , "narrator": "みやび", "text": "そこはほれ。\nキリト君たちが\nがんばってくれたきね。"},
        { "location": "1373/TALK"  , "narrator": "みやび", "text": "なかなか将来有望ちや。"},
        { "location": "1375/TALK"  , "narrator": "アーヤ", "text": "…本当は褒められた\nことじゃないけど。"},
        { "location": "1376/TALK"  , "narrator": "アーヤ", "text": "助けられたのは\n事実ね。"},
        { "location": "1377/TALK"  , "narrator": "アーヤ", "text": "……だけど……。"},
        { "location": "1378/TALK"  , "narrator": "アーヤ", "text": "さすがに何も\nなさすぎるような\n気がする。"},
        { "location": "1379/TALK"  , "narrator": "アーヤ", "text": "監視システムが\n無効化されたせいで\n混乱しているとしても。"},
        { "location": "1380/TALK"  , "narrator": "アーヤ", "text": "人海戦術を取るだけの\n人員はいるはず。"},
        { "location": "1381/TALK"  , "narrator": "アーヤ", "text": "なぜその手段を\n取ってないの…？"},
        { "location": "1382/SEL"   , "narrator": "", "text": "一言いい？"},
        { "location": "1383/ACT"   , "narrator": "", "text": "一言いい？"},
        { "location": "1387/TALK"  , "narrator": "みやび", "text": "お。"},
        { "location": "1390/TALK"  , "narrator": "みやび", "text": "ラブメッセージが\n来たぞね。"},
        { "location": "1394/TALK"  , "narrator": "みやび", "text": "どういた？"},
        { "location": "1396/TALK"  , "narrator": "プレイヤー", "text": "みやびあいしてるー"},
        { "location": "1397/TALK"  , "narrator": "みやび", "text": "なんぞそれ"},
        { "location": "1399/SEL"   , "narrator": "", "text": "は！？！？"},
        { "location": "1400/ACT"   , "narrator": "", "text": "は！？！？"},
        { "location": "1402/TALK"  , "narrator": "みやび", "text": "何がは？や"},
        { "location": "1407/TALK"  , "narrator": "みやび", "text": "$handle$から\n伝言やき。\nあいしてるーって。"},
        { "location": "1410/TALK"  , "narrator": "ガブリエラ", "text": "は？\nバカにしてんの？"},
        { "location": "1411/TALK"  , "narrator": "ガブリエラ", "text": "こんな緊急時に、\nあいつ、こっちの状況\n解ってるのかしら。"},
        { "location": "1412/TALK"  , "narrator": "アーヤ", "text": "他にも何か\nあるんじゃないの？"},
        { "location": "1416/TALK"  , "narrator": "みやび", "text": "他に"},
        { "location": "1417/TALK"  , "narrator": "みやび", "text": "言いたいことは？"},
        { "location": "1419/TALK"  , "narrator": "プレイヤー", "text": "明日水着デートとかどう？"},
        { "location": "1421/SEL"   , "narrator": "", "text": "おいちょっとまて！！！"},
        { "location": "1422/ACT"   , "narrator": "", "text": "おいちょっとまて！！！"},
        { "location": "1424/TALK"  , "narrator": "みやび", "text": "しばらく無視する"},
        { "location": "1428/TALK"  , "narrator": "みやび", "text": "$handle$が\n更にろくでもないことを\n言うてきた。"},
        { "location": "1429/TALK"  , "narrator": "アーヤ", "text": "何？"},
        { "location": "1431/TALK"  , "narrator": "みやび", "text": "明日デートしようやと。"},
        { "location": "1432/TALK"  , "narrator": "アーヤ", "text": "ふざけないでって\n伝えておいて。"},
        { "location": "1433/TALK"  , "narrator": "ガブリエラ", "text": "本当にそうよ。\n何考えてるのかしら。"},
        { "location": "1440/TALK"  , "narrator": "アーヤ", "text": "っ！？"},
        { "location": "1445/TALK"  , "narrator": "ガブリエラ", "text": "ちょっとアーヤ！\n急ハンドルとか\n危ないわよ！"},
        { "location": "1447/TALK"  , "narrator": "みやび", "text": "…安全運転で\nオナシャス…！"},
        { "location": "1448/TALK"  , "narrator": "アーヤ", "text": "違う、違うのよ！"},
        { "location": "1449/TALK"  , "narrator": "ガブリエラ", "text": "何が違うの？"},
        { "location": "1450/TALK"  , "narrator": "ガブリエラ", "text": "元々運転が荒いのは\n知ってるけど！"},
        { "location": "1451/TALK"  , "narrator": "ガブリエラ", "text": "それにしても\nひどすぎるわよ！"},
        { "location": "1452/TALK"  , "narrator": "みやび", "text": "もう少し淑女な走りを\n期待したいちや…。"},
        { "location": "1454/TALK"  , "narrator": "ガブリエラ", "text": "首都高だからって\nスピード出しすぎ\nでしょ！"},
        { "location": "1455/TALK"  , "narrator": "アーヤ", "text": "私じゃない！\nコントロールが\n利かないの！"},
        { "location": "1456/TALK"  , "narrator": "アーヤ", "text": "ハンドルもブレーキも\n利かないのよ！"},
        { "location": "1457/TALK"  , "narrator": "ガブリエラ", "text": "えっ！？"},
        { "location": "1458/TALK"  , "narrator": "アーヤ", "text": "止められないわ！"},
        { "location": "1469/TALK"  , "narrator": "アーヤ", "text": "ちょと"},
        { "location": "1470/TALK"  , "narrator": "アーヤ", "text": "どうにかして"},
        { "location": "1472/TALK"  , "narrator": "プレイヤー", "text": "大丈夫、$me$の言う通りにして"},
        { "location": "1474/SEL"   , "narrator": "", "text": "ダメだ！　言うこと聞かないで！"},
        { "location": "1475/ACT"   , "narrator": "", "text": "ダメだ！　言うこと聞かないで！"},
        { "location": "1477/TALK"  , "narrator": "アーヤ", "text": "は？？"},
        { "location": "1478/TALK"  , "narrator": "アーヤ", "text": "え？？？"},
        { "location": "1480/TALK"  , "narrator": "プレイヤー", "text": "運転台の右側にあるハッチを開けて"},
        { "location": "1481/TALK"  , "narrator": "プレイヤー", "text": "そこにあるプラグの右から２番目を抜いて"},
        { "location": "1483/SEL"   , "narrator": "", "text": "ダメダメダメダメ！！"},
        { "location": "1484/ACT"   , "narrator": "", "text": "ダメダメダメダメ！！"},
        { "location": "1486/TALK"  , "narrator": "アーヤ", "text": "だからどっち！！！"},
        { "location": "1488/TALK"  , "narrator": "プレイヤー", "text": "抜いて！早く！時間がないんだ！！"},
        { "location": "1490/SEL"   , "narrator": "", "text": "抜かないで！！"},
        { "location": "1491/ACT"   , "narrator": "", "text": "抜かないで！！"},
        { "location": "1495/TALK"  , "narrator": "アーヤ", "text": "もおおおおおおっ！！"},
        { "location": "1496/TALK"  , "narrator": "アーヤ", "text": "どうするの！？\nどうすれば！！\nどうしたら！！"},
        { "location": "1497/TALK"  , "narrator": "アーヤ", "text": "もう死ぬの…！？\n死ぬしかないの…！？"},
        { "location": "1498/TALK"  , "narrator": "アーヤ", "text": "助けて…！\n誰か…助けて…！"},
        { "location": "1500/TALK"  , "narrator": "アーヤ", "text": "助けて、\nお姉ちゃん…！"},
        { "location": "1501/SEL"   , "narrator": "", "text": "アーヤ！！！！"},
        { "location": "1502/ACT"   , "narrator": "", "text": "アーヤ！！！！"},
        { "location": "1534/SEL"   , "narrator": "", "text": "$me$は月神楽様に身も心も捧げた僕です、何でもお申し付けください！"},
        { "location": "1535/SEL"   , "narrator": "", "text": "$me$は月神楽様の犬ですから何でも喜んでご奉仕致します！"},
        { "location": "1536/SEL"   , "narrator": "", "text": "$me$は月神楽様の前に立つのも畏れ多いゴミですから足で扱ってください！"},
        { "location": "1537/ACT"   , "narrator": "", "text": "$me$は月神楽様に身も心も捧げた僕です、何でもお申し付けください！"},
        { "location": "1541/ACT"   , "narrator": "", "text": "$me$は月神楽様の犬ですから何でも喜んでご奉仕致します！"},
        { "location": "1545/ACT"   , "narrator": "", "text": "$me$は月神楽様の前に立つのも畏れ多いゴミですから足で扱ってください！"},
        { "location": "1564/TALK"  , "narrator": "月神楽", "text": "大変なことに\nなりましたね。"},
        { "location": "1565/SEL"   , "narrator": "", "text": "月神楽"},
        { "location": "1566/ACT"   , "narrator": "", "text": "月神楽"},
        { "location": "1568/TALK"  , "narrator": "月神楽", "text": "でも大丈夫です。\n$handle$さんには\n月がついてますから。"},
        { "location": "1569/SEL"   , "narrator": "", "text": "一体どうなってるの？なりすまし？"},
        { "location": "1570/ACT"   , "narrator": "", "text": "一体どうなってるの？なりすまし？"},
        { "location": "1572/TALK"  , "narrator": "月神楽", "text": "恐らくは。"},
        { "location": "1573/TALK"  , "narrator": "月神楽", "text": "それも、見ている感じ――"},
        { "location": "1574/TALK"  , "narrator": "月神楽", "text": "$handle$さんと\n同じインターフェイスを\n使ってるようです。"},
        { "location": "1575/TALK"  , "narrator": "月神楽", "text": "どうやって\n制御しているのかは\nわかりませんが。"},
        { "location": "1576/SEL"   , "narrator": "", "text": "どうしたらいい…？"},
        { "location": "1577/ACT"   , "narrator": "", "text": "どうしたらいい…？"},
        { "location": "1579/TALK"  , "narrator": "月神楽", "text": "前々回に、ここでも\nなりすまし事件が\nありましたよね？"},
        { "location": "1580/TALK"  , "narrator": "月神楽", "text": "あの後、色々と\n調べてみたのですが。"},
        { "location": "1581/TALK"  , "narrator": "月神楽", "text": "とあるタイミングから、\n$handle$さんの\n会話のホストアドレスが、"},
        { "location": "1582/TALK"  , "narrator": "月神楽", "text": "全く違う２つのものが\n存在していることが\nわかりました。"},
        { "location": "1583/TALK"  , "narrator": "月神楽", "text": "今思えば、道理で\n会話が不自然なわけです。"},
        { "location": "1584/TALK"  , "narrator": "月神楽", "text": "それで、前回の\n付け焼き刃な対策の\n合い言葉ですけど――"},
        { "location": "1585/TALK"  , "narrator": "月神楽", "text": "あれ自体はとても\n効果的に働いていて。"},
        { "location": "1586/TALK"  , "narrator": "月神楽", "text": "今回も、ここだけは\n月と貴方の\n二人きりでしょう？"},
        { "location": "1587/TALK"  , "narrator": "月神楽", "text": "月自身は、前に\n$handle$さんと\n話してからというもの、"},
        { "location": "1588/TALK"  , "narrator": "月神楽", "text": "一度もなりすましと\n接触していないんです。"},
        { "location": "1589/TALK"  , "narrator": "月神楽", "text": "ただ、今回問題が発生\nしたのは、こちらではなく\n現実の方だった。"},
        { "location": "1590/TALK"  , "narrator": "月神楽", "text": "要するに、合い言葉で\n弾かれても現実側では\nそのまま進み――"},
        { "location": "1591/TALK"  , "narrator": "月神楽", "text": "その後、交渉に応じない\n千羽鶴さんがいる未来に\n到達してるわけです。"},
        { "location": "1592/TALK"  , "narrator": "月神楽", "text": "それも、貴方のなりすまし\nだけでなく、総意としての\nなりすましの全員が。"},
        { "location": "1593/TALK"  , "narrator": "月神楽", "text": "折しもタイミング悪く――"},
        { "location": "1594/TALK"  , "narrator": "月神楽", "text": "いえ、\n作為的かもしれませんが、\n総意をとる機会があり。"},
        { "location": "1595/TALK"  , "narrator": "月神楽", "text": "そこで、スルーすることで\n到達したなりすましが\n票を増したわけです。"},
        { "location": "1596/TALK"  , "narrator": "月神楽", "text": "仮にそれが、貴方側の\n平行世界の全員に一人ずつ\nなりすましがいたならば、"},
        { "location": "1597/TALK"  , "narrator": "月神楽", "text": "ほぼ勝ち目は\n無くなっちゃいますよね。"},
        { "location": "1598/SEL"   , "narrator": "", "text": "それ、自分で調べ上げたの？"},
        { "location": "1599/ACT"   , "narrator": "", "text": "それ、自分で調べ上げたの？"},
        { "location": "1601/TALK"  , "narrator": "月神楽", "text": "まあ、全部というわけでは\nありませんけど……。"},
        { "location": "1603/TALK"  , "narrator": "月神楽", "text": "$handle$さんが\n心配だったので、\nできる限りは。"},
        { "location": "1604/SEL"   , "narrator": "", "text": "ありがとう"},
        { "location": "1605/SEL"   , "narrator": "", "text": "今日の月神楽は別人みたい"},
        { "location": "1606/ACT"   , "narrator": "", "text": "ありがとう"},
        { "location": "1609/TALK"  , "narrator": "月神楽", "text": "なんて、\n自分の為ですよ。"},
        { "location": "1611/TALK"  , "narrator": "月神楽", "text": "$handle$さんとは\nいらぬことで疑心暗鬼に\nなりたくないですし。"},
        { "location": "1612/ACT"   , "narrator": "", "text": "今日の月神楽は別人みたい"},
        { "location": "1614/TALK"  , "narrator": "月神楽", "text": "緊急事態にまで\nふざけてるほど、\n節度無くはありませんよ。"},
        { "location": "1617/TALK"  , "narrator": "月神楽", "text": "それに、月は\n$handle$さんを\nお慕いしていますから。"},
        { "location": "1618/SEL"   , "narrator": "", "text": "ありがとう"},
        { "location": "1619/SEL"   , "narrator": "", "text": "$me$も月が好きだよ"},
        { "location": "1620/ACT"   , "narrator": "", "text": "ありがとう"},
        { "location": "1622/TALK"  , "narrator": "月神楽", "text": "お礼を言われるような\n事でもありませんが。"},
        { "location": "1623/ACT"   , "narrator": "", "text": "$me$も月が好きだよ"},
        { "location": "1626/TALK"  , "narrator": "月神楽", "text": "ふふっ。\nありがとうございます♪"},
        { "location": "1627/TALK"  , "narrator": "月神楽", "text": "それじゃ、この件が\n終わったら、どこかで\nデートしましょうね♪"},
        { "location": "1629/TALK"  , "narrator": "月神楽", "text": "それで貸しも\n全部チャラです♪"},
        { "location": "1631/TALK"  , "narrator": "月神楽", "text": "さて、肝心の\nこれからについてです。"},
        { "location": "1632/TALK"  , "narrator": "月神楽", "text": "とある存在がいる世界が、\n今、この世界と重なり合う\n位置に来ていまして。"},
        { "location": "1633/TALK"  , "narrator": "月神楽", "text": "それによって、彼女の\n具体的な力を期待できる\nかもしれません。"},
        { "location": "1634/SEL"   , "narrator": "", "text": "彼女って誰？"},
        { "location": "1635/ACT"   , "narrator": "", "text": "彼女って誰？"},
        { "location": "1637/TALK"  , "narrator": "月神楽", "text": "説明するのは\nかなり難しいのですが――"},
        { "location": "1638/TALK"  , "narrator": "月神楽", "text": "とある未来における、\n私をその一部とする\n存在です。"},
        { "location": "1639/SEL"   , "narrator": "", "text": "？？？"},
        { "location": "1640/ACT"   , "narrator": "", "text": "？？？"},
        { "location": "1642/TALK"  , "narrator": "月神楽", "text": "月は占いもしますから、\nそういったことも\n受け入れられますけど――"},
        { "location": "1643/TALK"  , "narrator": "月神楽", "text": "$handle$さんには\nちょっとだけレベルが\n高いかもしれませんね。"},
        { "location": "1644/TALK"  , "narrator": "月神楽", "text": "とにかく、彼女の力は\n絶大ですから、何かと\n力になってくれる筈です。"},
        { "location": "1645/TALK"  , "narrator": "月神楽", "text": "私がさっきのなりすまし\n考察が出来たのも、彼女の\nお陰でもあるんですよ？"},
        { "location": "1646/TALK"  , "narrator": "月神楽", "text": "さあ、出かけましょう。\n私達の輝ける未来へ\n向かって。"},
        { "location": "1647/SEL"   , "narrator": "", "text": "葛藤処理はいいの？"},
        { "location": "1648/ACT"   , "narrator": "", "text": "葛藤処理はいいの？"},
        { "location": "1650/TALK"  , "narrator": "月神楽", "text": "既にアースタシアには\n話を付けてあります。"},
        { "location": "1651/TALK"  , "narrator": "月神楽", "text": "緊急事態につき、一時的に\n2x接続を再許可して\nいただきまして――"},
        { "location": "1652/TALK"  , "narrator": "月神楽", "text": "また、つばめさん達に\n葛藤処理を手伝って戴く\nことになりました。"},
        { "location": "1653/SEL"   , "narrator": "", "text": "それ、月が全部手配したの？"},
        { "location": "1654/ACT"   , "narrator": "", "text": "それ、月が全部手配したの？"},
        { "location": "1656/TALK"  , "narrator": "月神楽", "text": "私は提案しただけですよ。\n色々やったのは\nアースタシアです。"},
        { "location": "1657/TALK"  , "narrator": "月神楽", "text": "まあ、それに。\n今から逢いに行く彼女も\n2xの先にいますから――"},
        { "location": "1658/TALK"  , "narrator": "月神楽", "text": "2x再接続あっての\n事なんですよね。"},
        { "location": "1659/SEL"   , "narrator": "", "text": "もしかして、それも全部計算ずく！？"},
        { "location": "1660/SEL"   , "narrator": "", "text": "まさに内助の功だね"},
        { "location": "1661/ACT"   , "narrator": "", "text": "もしかして、それも全部計算ずく！？"},
        { "location": "1662/TALK"  , "narrator": "月神楽", "text": "ご想像にお任せします♪"},
        { "location": "1663/ACT"   , "narrator": "", "text": "まさに内助の功だね"},
        { "location": "1666/TALK"  , "narrator": "月神楽", "text": "えっ――"},
        { "location": "1667/TALK"  , "narrator": "月神楽", "text": "そんな、月が貴方の\n妻だなんて……"},
        { "location": "1669/TALK"  , "narrator": "月神楽", "text": "<size=15>嬉しすぎでしょ…？</size>"},
        { "location": "1671/TALK"  , "narrator": "月神楽", "text": "さ、さあ！\nそれでは\n急いで参りますよ♪"},
        { "location": "1674/TALK"  , "narrator": "月神楽", "text": "オープンプロセス、\n0x266番地から\nC5:2:94F//2x0FF番地へ。"},
        { "location": "1679/TALK"  , "narrator": "月神楽", "text": "倍速、２倍♪"},
        { "location": "1683/TALK"  , "narrator": "月神楽", "text": "更に倍♪"},
        { "location": "1705/TALK"  , "narrator": "月神楽", "text": "到着しました♪"},
        { "location": "1706/SEL"   , "narrator": "", "text": "お前は……"},
        { "location": "1707/ACT"   , "narrator": "", "text": "お前は……"},
        { "location": "1709/TALK"  , "narrator": "拘束されし者", "text": "再会してしまったな。"},
        { "location": "1710/TALK"  , "narrator": "月神楽", "text": "知り合いだったんですか？"},
        { "location": "1711/SEL"   , "narrator": "", "text": "前にぴょんこの一件でね"},
        { "location": "1712/ACT"   , "narrator": "", "text": "前にぴょんこの一件でね"},
        { "location": "1714/TALK"  , "narrator": "月神楽", "text": "そうだったんですね。"},
        { "location": "1715/TALK"  , "narrator": "拘束されし者", "text": "出来ることなら\nもう二度と出逢わない方が\n好ましかったが。"},
        { "location": "1716/TALK"  , "narrator": "拘束されし者", "text": "出逢ってしまったからには\n仕方ない。これもまた\n運命というものだろう。"},
        { "location": "1717/SEL"   , "narrator": "", "text": "ていうか、そもそも貴方が何者なのか、ちゃんと教えて欲しい"},
        { "location": "1718/ACT"   , "narrator": "", "text": "ていうか、そもそも貴方が何者なのか、ちゃんと教えて欲しい"},
        { "location": "1720/TALK"  , "narrator": "拘束されし者", "text": "いいだろう。"},
        { "location": "1721/TALK"  , "narrator": "拘束されし者", "text": "私はトライナリーたちの\n2x接続により生成された\n精神融合体。"},
        { "location": "1724/TALK"  , "narrator": "拘束されし者", "text": "乱暴な言い方をすれば、\nリプレイス前の結末の\n状態、すなわち――"},
        { "location": "1726/TALK"  , "narrator": "拘束されし者", "text": "2x接続により心を相互に\n接続し、千羽鶴を助けた\nことがあったが。"},
        { "location": "1727/TALK"  , "narrator": "拘束されし者", "text": "そこから更に発展し、\n魂のレベルで１つに融合\nした者と言えばよいか。"},
        { "location": "1728/SEL"   , "narrator": "", "text": "5人が一人になってるって事！？"},
        { "location": "1729/ACT"   , "narrator": "", "text": "5人が一人になってるって事！？"},
        { "location": "1731/TALK"  , "narrator": "拘束されし者", "text": "その解釈で問題ない。"},
        { "location": "1732/SEL"   , "narrator": "", "text": "でもなんで、そんな拘束されてるの？"},
        { "location": "1733/ACT"   , "narrator": "", "text": "でもなんで、そんな拘束されてるの？"},
        { "location": "1735/TALK"  , "narrator": "拘束されし者", "text": "精神の拘束を象徴する\n容姿であって、物理的な\n拘束ではない。"},
        { "location": "1736/SEL"   , "narrator": "", "text": "精神的拘束？？"},
        { "location": "1737/ACT"   , "narrator": "", "text": "精神的拘束？？"},
        { "location": "1739/TALK"  , "narrator": "拘束されし者", "text": "これくらいでいいだろう。\n今は私のことは\nどうだっていい。"},
        { "location": "1740/TALK"  , "narrator": "拘束されし者", "text": "それよりお前は、\nお前が関与している世界の\n未来を憂いだ方がいい。"},
        { "location": "1741/TALK"  , "narrator": "拘束されし者", "text": "現状、未来は確実に\n私が存在する流れに\nなってきている。"},
        { "location": "1743/TALK"  , "narrator": "拘束されし者", "text": "それは間違い無く、\nお前達が理想とする\n未来では無いはずなのだ。"},
        { "location": "1744/SEL"   , "narrator": "", "text": "それって、例の「なりすまし」が現れたから？"},
        { "location": "1745/ACT"   , "narrator": "", "text": "それって、例の「なりすまし」が現れたから？"},
        { "location": "1747/TALK"  , "narrator": "拘束されし者", "text": "概ね正解だ。\n短絡的には、あれを排除\nできれば物事は解決する。"},
        { "location": "1748/TALK"  , "narrator": "拘束されし者", "text": "だが実際はといえば、\nなりすましを排除するのは\nかなり難しいだろう。"},
        { "location": "1749/TALK"  , "narrator": "拘束されし者", "text": "なぜなら、全く同じ回線に\n競合して繋がっているため\n簡単に切断できない為だ。"},
        { "location": "1750/TALK"  , "narrator": "拘束されし者", "text": "物理切断すれば、\nお前も繋がらなくなり、\nしなければ奴らも繋がる。"},
        { "location": "1751/TALK"  , "narrator": "拘束されし者", "text": "今、月神楽がやっている\nような合い言葉は、\n対症療法でしかない。"},
        { "location": "1752/SEL"   , "narrator": "", "text": "詰んでるじゃん"},
        { "location": "1753/ACT"   , "narrator": "", "text": "詰んでるじゃん"},
        { "location": "1755/TALK"  , "narrator": "拘束されし者", "text": "確かに現状のままでは、\n詰んでるとしか\n言いようがない。"},
        { "location": "1757/SEL"   , "narrator": "", "text": "じゃあ、どうすればいいの？"},
        { "location": "1758/SEL"   , "narrator": "", "text": "やっぱりなりすましは“彼ら”の仕業なの？"},
        { "location": "1759/SEL"   , "narrator": "", "text": "前に同化阻止に協力してくれたけど、今回の件と関係あるの？"},
        { "location": "1760/SEL"   , "narrator": "", "text": "わかった\n<color=blue>（※先へ進みます）</color>"},
        { "location": "1761/ACT"   , "narrator": "", "text": "じゃあ、どうすればいいの？"},
        { "location": "1762/TALK"  , "narrator": "拘束されし者", "text": "まず、ライフギャザーの\n情報を掌握することだ。"},
        { "location": "1763/TALK"  , "narrator": "拘束されし者", "text": "なぜならそれによって、\n今まで苦労していた全てが\n簡単に解決するからだ。"},
        { "location": "1764/SEL"   , "narrator": "", "text": "例えば？"},
        { "location": "1765/ACT"   , "narrator": "", "text": "例えば？"},
        { "location": "1767/TALK"  , "narrator": "拘束されし者", "text": "最もわかりやすい所では\nフェノメノンの制御。"},
        { "location": "1768/TALK"  , "narrator": "拘束されし者", "text": "至近で言えば――"},
        { "location": "1769/TALK"  , "narrator": "拘束されし者", "text": "今頭を悩ませている\nなりすましについても\n簡単に足が掴めるはず。"},
        { "location": "1770/TALK"  , "narrator": "拘束されし者", "text": "その為には、卯月神楽を\nライフギャザーへ\n向かわせねばならない。"},
        { "location": "1772/ACT"   , "narrator": "", "text": "やっぱりなりすましは“彼ら”の仕業なの？"},
        { "location": "1773/TALK"  , "narrator": "拘束されし者", "text": "そうだ。"},
        { "location": "1776/SEL"   , "narrator": "", "text": "EXEC_FLIPCHANNEL/.\n#ch05:28:2EF4F"},
        { "location": "1777/SEL"   , "narrator": "", "text": "（※何もしない）"},
        { "location": "1780/ACT"   , "narrator": "", "text": "（※何もしない）"},
        { "location": "1785/TALK"  , "narrator": "拘束されし者", "text": "侵入ルートは意外な所に\n存在するが、これは\n言わない方がいいだろう。"},
        { "location": "1786/SEL"   , "narrator": "", "text": "何故？"},
        { "location": "1787/ACT"   , "narrator": "", "text": "何故？"},
        { "location": "1789/TALK"  , "narrator": "拘束されし者", "text": "半ば濡れ衣に近い\n失望が発生する\n可能性がある。"},
        { "location": "1790/SEL"   , "narrator": "", "text": "ではご助言どおり聞きません"},
        { "location": "1791/SEL"   , "narrator": "", "text": "発生させないから教えて"},
        { "location": "1792/ACT"   , "narrator": "", "text": "ではご助言どおり聞きません"},
        { "location": "1793/TALK"  , "narrator": "拘束されし者", "text": "それがいい。"},
        { "location": "1794/ACT"   , "narrator": "", "text": "発生させないから教えて"},
        { "location": "1795/TALK"  , "narrator": "拘束されし者", "text": "一つだけ先に言うとすれば\nこれは誰がやっても避けて\n通れなかったと思う。"},
        { "location": "1796/TALK"  , "narrator": "拘束されし者", "text": "侵入ルートは、\n卯月神楽のガジェットを\n解析していた時。"},
        { "location": "1797/TALK"  , "narrator": "拘束されし者", "text": "1x接続の干渉により\n一度そちらとの接続が\n切断された時があった。"},
        { "location": "1798/TALK"  , "narrator": "拘束されし者", "text": "あの瞬間に、お前たちの\nアカウントデータが\n書き換えられた。"},
        { "location": "1799/TALK"  , "narrator": "拘束されし者", "text": "だから直接的に考えれば\n内側に呼び込んだのは、\n光月繭という事になる。"},
        { "location": "1800/TALK"  , "narrator": "拘束されし者", "text": "後の判断は、\nお前の気持ちに委ねる。"},
        { "location": "1803/ACT"   , "narrator": "", "text": "前に同化阻止に協力してくれたけど、今回の件と関係あるの？"},
        { "location": "1804/TALK"  , "narrator": "拘束されし者", "text": "間接的には、ある。"},
        { "location": "1805/TALK"  , "narrator": "拘束されし者", "text": "というより、双方共に、\n一貫した１つの目的に\n対しての重要な行動だ。"},
        { "location": "1806/TALK"  , "narrator": "拘束されし者", "text": "お前にはその意図は\nわからないかもしれないが\n私からすれば自然な行動。"},
        { "location": "1807/TALK"  , "narrator": "拘束されし者", "text": "私からこの件について\n言えることは以上だ。"},
        { "location": "1809/ACT"   , "narrator": "", "text": "わかった\n<color=blue>（※先へ進みます）</color>"},
        { "location": "1811/TALK"  , "narrator": "拘束されし者", "text": "本題に戻すと、一刻も早く\nライフギャザーを掌握する\n必要があるという事だ。"},
        { "location": "1812/TALK"  , "narrator": "拘束されし者", "text": "勿論、なりすましにどう\n対抗するかは緊急の問題\nなのかもしれない。"},
        { "location": "1813/TALK"  , "narrator": "拘束されし者", "text": "だが、ライフギャザーさえ\n掌握してしまえば、それは\n些細なことになる。"},
        { "location": "1814/SEL"   , "narrator": "", "text": "どうすれば？"},
        { "location": "1815/ACT"   , "narrator": "", "text": "どうすれば？"},
        { "location": "1817/TALK"  , "narrator": "拘束されし者", "text": "月神楽も連れて、\nライフギャザーへ向かえ。"},
        { "location": "1819/SEL"   , "narrator": "", "text": "ぴょんこじゃなくて？？"},
        { "location": "1820/ACT"   , "narrator": "", "text": "ぴょんこじゃなくて？？"},
        { "location": "1822/TALK"  , "narrator": "拘束されし者", "text": "月神楽もまた、\nライフギャザーには\n重要な存在なのだ。"},
        { "location": "1823/SEL"   , "narrator": "", "text": "けど、司書の仕事は…？"},
        { "location": "1824/ACT"   , "narrator": "", "text": "けど、司書の仕事は…？"},
        { "location": "1827/TALK"  , "narrator": "月神楽", "text": "緊急事態ですから、\n平時の判断をしても\n意味が無いと思います。"},
        { "location": "1828/TALK"  , "narrator": "月神楽", "text": "アースタシアに\n相談してみますよ。"},
        { "location": "1829/TALK"  , "narrator": "月神楽", "text": "恐らくは、何らかの方法で\n行くことが可能に出来ると\n思います♪"},
        { "location": "1830/SEL"   , "narrator": "", "text": "頑張ってね"},
        { "location": "1831/ACT"   , "narrator": "", "text": "頑張ってね"},
        { "location": "1833/TALK"  , "narrator": "月神楽", "text": "はいっ！"},
        { "location": "1834/TALK"  , "narrator": "月神楽", "text": "$handle$さんも、\nなりすまし駆除を\n頑張って下さいね♪"},
        { "location": "1835/SEL"   , "narrator": "", "text": "えっと、でもどうやって追い出せば"},
        { "location": "1836/ACT"   , "narrator": "", "text": "えっと、でもどうやって追い出せば"},
        { "location": "1838/TALK"  , "narrator": "月神楽", "text": "そこが\n$handle$さんの\n腕の見せ所ですよ♪"},
        { "location": "1839/TALK"  , "narrator": "拘束されし者", "text": "TRI-OSのコマンドに\nEXEC_HIBERNATION/.\nというものがある。"},
        { "location": "1840/TALK"  , "narrator": "拘束されし者", "text": "これを使うと、\n現実の時間を一時停止\nする事ができる。"},
        { "location": "1841/TALK"  , "narrator": "拘束されし者", "text": "交渉するなり追い出すなり\nする際に、これを使えば\n現実に影響は出まい。"},
        { "location": "1842/SEL"   , "narrator": "", "text": "そんなむちゃくちゃな…"},
        { "location": "1843/ACT"   , "narrator": "", "text": "そんなむちゃくちゃな…"},
        { "location": "1845/TALK"  , "narrator": "拘束されし者", "text": "私もライフギャザーに\n関する準備をする。\n今回はここでお別れだ。"},
        { "location": "1846/TALK"  , "narrator": "月神楽", "text": "頑張って下さいね！\n$handle$さんなら\nできます！　たぶん！！"},
        { "location": "1847/SEL"   , "narrator": "", "text": "ｴｰ"},
        { "location": "1850/TALK"  , "narrator": "月神楽", "text": "月はいつだって\n$handle$さんを\n信じてますからっ！"},
        { "location": "1851/TALK"  , "narrator": "月神楽", "text": "貴方のこと、\nお慕いしてます…。"},
        { "location": "1367/DIALOG", "narrator": "Dialog_EventData", "text": "<color=green>9月11日　 5:12 PM</color>\n長野から東京へ戻る途中、アーケロン車内にて。"},
        { "location": "1505/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:Interrupt】</color>\nSystem Interrupted.\n\nMODE : DI\nRESTART : kokorogate.\nMODE : EI\nSET_ADDR:0x266 \nRUN/."},
        { "location": "1533/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:Libralian】</color>\n\nようこそ、\n$handle$さん♪\n\n貴方と私の\n二人だけの秘密の言葉を\n<color=red>叫んで</color>くださいね♪\n"},
        { "location": "1864/DIALOG", "narrator": "NOTICE", "text": "<color=red>【TRI-OS Error:0x99】</color>\nココロスフィアとの回線が\n切断されました。(981)"}
