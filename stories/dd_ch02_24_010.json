    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "憩いの時"},
        { "location": "25/TALK"   , "narrator": "小夜", "text": "…………。"},
        { "location": "27/TALK"   , "narrator": "小夜", "text": "ま、そうよね…。\n今は大学に来る余裕なんて\nないだろうし…。"},
        { "location": "31/TALK"   , "narrator": "アーヤ", "text": "おはよう、小夜。"},
        { "location": "32/TALK"   , "narrator": "小夜", "text": "あ、おはようアーヤ…。"},
        { "location": "34/TALK"   , "narrator": "小夜", "text": "…アーヤ！？"},
        { "location": "36/TALK"   , "narrator": "アーヤ", "text": "わっ！？　な、なに！？\nどうして驚くの？"},
        { "location": "37/TALK"   , "narrator": "小夜", "text": "そりゃ驚くでしょ！\n何で大学来てんの！？"},
        { "location": "38/TALK"   , "narrator": "アーヤ", "text": "何でって、私も一応\n大学生なんだけど…。"},
        { "location": "39/TALK"   , "narrator": "小夜", "text": "そうじゃなくて…。"},
        { "location": "41/TALK"   , "narrator": "アーヤ", "text": "ごめん、何を言いたいかは\nわかってるから。"},
        { "location": "42/TALK"   , "narrator": "アーヤ", "text": "今の状況で、どうして\n大学に来てるのか、って\n聞きたいんでしょ？"},
        { "location": "43/TALK"   , "narrator": "小夜", "text": "う、うん…大丈夫なの？\n今って、大学来てる\n場合じゃないでしょ？"},
        { "location": "44/TALK"   , "narrator": "アーヤ", "text": "そうなんだけど…、\nこれくらいしかすること\nないのよ。"},
        { "location": "45/TALK"   , "narrator": "アーヤ", "text": "何かしようにも、\n自由に動けるような\n状況でもないし。"},
        { "location": "46/TALK"   , "narrator": "小夜", "text": "…そっか。"},
        { "location": "47/TALK"   , "narrator": "アーヤ", "text": "うん、そういうこと。"},
        { "location": "51/TALK"   , "narrator": "アーヤ", "text": "まあ、話の続きは\n講義の後でね。"},
        { "location": "52/TALK"   , "narrator": "小夜", "text": "うん…。"},
        { "location": "56/TALK"   , "narrator": "小夜", "text": "…………。"},
        { "location": "57/TALK"   , "narrator": "小夜", "text": "なんか…大変そうだなぁ…。"},
        { "location": "68/TALK"   , "narrator": "アーヤ", "text": "なるほど…ちょっと悲しい\n終わり方をするお話か…。"},
        { "location": "70/TALK"   , "narrator": "小夜", "text": "うん、私達が劇にする\nお話って、いっつも\nハッピーエンドでしょ？"},
        { "location": "71/TALK"   , "narrator": "小夜", "text": "まあ、幼稚園児相手だから\n仕方なくはあるんだけどさ。"},
        { "location": "74/TALK"   , "narrator": "アーヤ", "text": "そうね…あんまり悲しい\n終わり方するのだと、\n子供たちが泣いちゃうし。"},
        { "location": "75/TALK"   , "narrator": "小夜", "text": "いや、そこまで悲しいのは\nさすがにやらないわよ。"},
        { "location": "76/TALK"   , "narrator": "小夜", "text": "演じるこっちだって\n暗くなるし、アーヤなんか\n途中で泣いちゃいそうだし。"},
        { "location": "78/TALK"   , "narrator": "アーヤ", "text": "な、泣かないわよ！\n子供向けの劇で泣くわけ\nないでしょ？"},
        { "location": "79/TALK"   , "narrator": "小夜", "text": "あれ？　確か図書室で\n絵本読んで泣いたのは\n誰だったかしら？"},
        { "location": "81/TALK"   , "narrator": "アーヤ", "text": "あ、あれは特別よ。\n実話を基にした話だから、\nつい…。"},
        { "location": "82/TALK"   , "narrator": "小夜", "text": "あはは、まあとにかくさ、\n子供たちが泣かない程度に\n悲しい話を探してるわけ。"},
        { "location": "83/TALK"   , "narrator": "小夜", "text": "どう？　何かいい話ある？"},
        { "location": "86/TALK"   , "narrator": "アーヤ", "text": "うーん…私はそんな話は\n見たことないかも…。"},
        { "location": "88/TALK"   , "narrator": "小夜", "text": "じゃあ、近いうちに\n図書館巡りね。"},
        { "location": "89/TALK"   , "narrator": "小夜", "text": "あ、もちろんアーヤの\n都合がよければだけど…。"},
        { "location": "91/TALK"   , "narrator": "アーヤ", "text": "絶対とは言えないけど、\n何も起こらなければ\n一緒に行くわ。"},
        { "location": "93/TALK"   , "narrator": "小夜", "text": "約束よ？"},
        { "location": "95/TALK"   , "narrator": "小夜", "text": "っと、お茶切れちゃった…。\nおかわり入れてくるわ。"},
        { "location": "96/TALK"   , "narrator": "アーヤ", "text": "あ、私も欲しいな。"},
        { "location": "98/TALK"   , "narrator": "小夜", "text": "ついでに持ってくるから、\nアーヤは待ってて。"},
        { "location": "102/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "103/TALK"  , "narrator": "アーヤ", "text": "何やってるのかしら…。"},
        { "location": "104/TALK"  , "narrator": "アーヤ", "text": "ちょっとサークルの話を\n振られただけなのに、\n夢中になっちゃうなんて。"},
        { "location": "106/TALK"  , "narrator": "アーヤ", "text": "今はサークルの話に\n夢中になってるような\n場合じゃないのに…。"},
        { "location": "107/TALK"  , "narrator": "アーヤ", "text": "…まさか、この状況で\n気が抜けてる？"},
        { "location": "111/TALK"  , "narrator": "アーヤ", "text": "…$handle2$に\n聞いてみようかしら。"},
        { "location": "112/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "116/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "117/TALK"  , "narrator": "アーヤ", "text": "…本当、気が抜けてるわ。"},
        { "location": "120/TALK"  , "narrator": "小夜", "text": "お待たせー。\nはい、アーヤのお茶。"},
        { "location": "123/TALK"  , "narrator": "アーヤ", "text": "ありがとう。"},
        { "location": "124/TALK"  , "narrator": "小夜", "text": "それでさ、えっと…。"},
        { "location": "125/TALK"  , "narrator": "アーヤ", "text": "劇の話よ。\nちょっと悲しいお話を\nやりたいんでしょ？"},
        { "location": "126/TALK"  , "narrator": "小夜", "text": "そうそう！"},
        { "location": "127/TALK"  , "narrator": "小夜", "text": "今ね、ちょっと考えて\nみたんだけど、\n例えば――"},
        { "location": "140/TALK"  , "narrator": "小夜", "text": "今日ってこれからバイト？"},
        { "location": "142/TALK"  , "narrator": "アーヤ", "text": "ええ、早番だから\n寄り道できないのよ。"},
        { "location": "143/TALK"  , "narrator": "小夜", "text": "そっか…もうちょっと、\n劇のこと話したかったん\nだけど…。"},
        { "location": "144/TALK"  , "narrator": "小夜", "text": "ま、明日でいっか。"},
        { "location": "145/TALK"  , "narrator": "アーヤ", "text": "私も、何かいいお話が無いか\n探してみるわ。"},
        { "location": "147/TALK"  , "narrator": "小夜", "text": "ありがと。\nじゃ、また明日ね。"},
        { "location": "149/TALK"  , "narrator": "アーヤ", "text": "ん、また明日…。"},
        { "location": "154/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "156/TALK"  , "narrator": "アーヤ", "text": "まあ…こんな日があっても\n悪くないわよね？"},
        { "location": "157/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "169/TALK"  , "narrator": "アーヤ", "text": "いけなかった？"},
        { "location": "170/TALK"  , "narrator": "アーヤ", "text": "今日の私(-ω-;)"},
        { "location": "172/SEL"   , "narrator": "", "text": "どういうこと？"},
        { "location": "173/ACT"   , "narrator": "", "text": "どういうこと？"},
        { "location": "175/TALK"  , "narrator": "アーヤ", "text": "小夜とした"},
        { "location": "176/TALK"  , "narrator": "アーヤ", "text": "サークルの話のこと(｡-_-｡)"},
        { "location": "177/TALK"  , "narrator": "アーヤ", "text": "夢中になってた(´o｀；"},
        { "location": "178/TALK"  , "narrator": "アーヤ", "text": "正直"},
        { "location": "179/TALK"  , "narrator": "アーヤ", "text": "卯月のこと抜けてたと思う(>_<)"},
        { "location": "180/TALK"  , "narrator": "アーヤ", "text": "緊張感かけ過ぎ？(￣Д￣ )"},
        { "location": "181/TALK"  , "narrator": "アーヤ", "text": "ちょっと"},
        { "location": "182/TALK"  , "narrator": "アーヤ", "text": "罪悪感ある(´o｀；"},
        { "location": "185/SEL"   , "narrator": "", "text": "らしくはないけど、いいと思う"},
        { "location": "186/SEL"   , "narrator": "", "text": "確かに気が抜け過ぎだ"},
        { "location": "187/SEL"   , "narrator": "", "text": "それより話せなくて寂しかった"},
        { "location": "188/ACT"   , "narrator": "", "text": "らしくはないけど、いいと思う"},
        { "location": "189/TALK"  , "narrator": "アーヤ", "text": "そう？"},
        { "location": "190/TALK"  , "narrator": "アーヤ", "text": "緊張感無さ過ぎで"},
        { "location": "191/TALK"  , "narrator": "アーヤ", "text": "よくないと思うけど(￣Д￣ )"},
        { "location": "193/SEL"   , "narrator": "", "text": "少しは気持ち軽くなったでしょ？"},
        { "location": "194/ACT"   , "narrator": "", "text": "少しは気持ち軽くなったでしょ？"},
        { "location": "197/TALK"  , "narrator": "アーヤ", "text": "ううん"},
        { "location": "198/TALK"  , "narrator": "アーヤ", "text": "少しじゃなくて"},
        { "location": "199/TALK"  , "narrator": "アーヤ", "text": "とっても(^^"},
        { "location": "200/TALK"  , "narrator": "アーヤ", "text": "あの三戸浜での日から"},
        { "location": "201/TALK"  , "narrator": "アーヤ", "text": "初めてかも"},
        { "location": "202/TALK"  , "narrator": "アーヤ", "text": "こんなに楽しかったの(*^^*)"},
        { "location": "204/SEL"   , "narrator": "", "text": "やっぱり、話してよかったんだよ"},
        { "location": "205/ACT"   , "narrator": "", "text": "やっぱり、話してよかったんだよ"},
        { "location": "207/TALK"  , "narrator": "アーヤ", "text": "そうね"},
        { "location": "208/TALK"  , "narrator": "アーヤ", "text": "ありがとう(*^o^*)"},
        { "location": "209/TALK"  , "narrator": "アーヤ", "text": "でも心が軽くなった分"},
        { "location": "210/TALK"  , "narrator": "アーヤ", "text": "これからは"},
        { "location": "211/TALK"  , "narrator": "アーヤ", "text": "気を引き締めていくわ(￣∇￣)"},
        { "location": "212/ACT"   , "narrator": "", "text": "確かに気が抜け過ぎだ"},
        { "location": "213/TALK"  , "narrator": "アーヤ", "text": "そうよね(>_<)"},
        { "location": "214/TALK"  , "narrator": "アーヤ", "text": "リーダーとして"},
        { "location": "215/TALK"  , "narrator": "アーヤ", "text": "ううん"},
        { "location": "216/TALK"  , "narrator": "アーヤ", "text": "トライナリーの一人として"},
        { "location": "217/TALK"  , "narrator": "アーヤ", "text": "問題ある行動だった(；´Д｀)"},
        { "location": "218/TALK"  , "narrator": "アーヤ", "text": "反省しないとm(_ _)m"},
        { "location": "221/TALK"  , "narrator": "アーヤ", "text": "でも"},
        { "location": "222/TALK"  , "narrator": "アーヤ", "text": "サークルの話も"},
        { "location": "223/TALK"  , "narrator": "アーヤ", "text": "多分"},
        { "location": "224/TALK"  , "narrator": "アーヤ", "text": "しばらくできないと思う"},
        { "location": "225/TALK"  , "narrator": "アーヤ", "text": "これから先"},
        { "location": "226/TALK"  , "narrator": "アーヤ", "text": "何もなく過ごせるとは思えないし"},
        { "location": "227/TALK"  , "narrator": "アーヤ", "text": "だから"},
        { "location": "228/TALK"  , "narrator": "アーヤ", "text": "今回だけは多めに見て(・・。)ゞ"},
        { "location": "231/TALK"  , "narrator": "アーヤ", "text": "ごめんなさい"},
        { "location": "233/TALK"  , "narrator": "アーヤ", "text": "こんなこと言うなんて"},
        { "location": "234/TALK"  , "narrator": "アーヤ", "text": "やっぱり気が抜けてるわね(-ω-;)"},
        { "location": "235/TALK"  , "narrator": "アーヤ", "text": "ごめんなさい"},
        { "location": "236/ACT"   , "narrator": "", "text": "それより話せなくて寂しかった"},
        { "location": "237/TALK"  , "narrator": "アーヤ", "text": "そうだったの？( ・_・)σﾞ"},
        { "location": "239/SEL"   , "narrator": "", "text": "学食で話しかけてほしかったな"},
        { "location": "240/ACT"   , "narrator": "", "text": "学食で話しかけてほしかったな"},
        { "location": "242/TALK"  , "narrator": "アーヤ", "text": "気づいてた？(￣Д￣ )"},
        { "location": "243/TALK"  , "narrator": "アーヤ", "text": "話しかけようとしてたの"},
        { "location": "244/TALK"  , "narrator": "アーヤ", "text": "期待させてごめんなさいm(_ _)m"},
        { "location": "245/TALK"  , "narrator": "アーヤ", "text": "あの時は"},
        { "location": "246/TALK"  , "narrator": "アーヤ", "text": "気が抜けてるぞって"},
        { "location": "247/TALK"  , "narrator": "アーヤ", "text": "怒られるかと思ったから"},
        { "location": "248/TALK"  , "narrator": "アーヤ", "text": "それでやめちゃって(>_<)"},
        { "location": "250/SEL"   , "narrator": "", "text": "怒ったりなんかしないよ"},
        { "location": "251/ACT"   , "narrator": "", "text": "怒ったりなんかしないよ"},
        { "location": "253/TALK"  , "narrator": "アーヤ", "text": "ありがとう(^^"},
        { "location": "255/TALK"  , "narrator": "アーヤ", "text": "もしかして"},
        { "location": "256/TALK"  , "narrator": "アーヤ", "text": "私、ビビリ過ぎ？"},
        { "location": "258/SEL"   , "narrator": "", "text": "だと思う"},
        { "location": "259/ACT"   , "narrator": "", "text": "だと思う"},
        { "location": "261/TALK"  , "narrator": "アーヤ", "text": "そっか(・・。)ゞ"},
        { "location": "262/TALK"  , "narrator": "アーヤ", "text": "ちょっと"},
        { "location": "263/TALK"  , "narrator": "アーヤ", "text": "恥ずかしいかも(｡-_-｡)"},
        { "location": "265/SEL"   , "narrator": "", "text": "アーヤがいい子の証拠だよ"},
        { "location": "266/ACT"   , "narrator": "", "text": "アーヤがいい子の証拠だよ"},
        { "location": "268/TALK"  , "narrator": "アーヤ", "text": "小心者なだけよ(-.-;)"},
        { "location": "270/TALK"  , "narrator": "アーヤ", "text": "でも"},
        { "location": "271/TALK"  , "narrator": "アーヤ", "text": "そんな風に言ってもらえると"},
        { "location": "272/TALK"  , "narrator": "アーヤ", "text": "やっぱり嬉しいわ(^^"},
        { "location": "273/TALK"  , "narrator": "アーヤ", "text": "ありがとう(*^.^*)"},
        { "location": "275/SEL"   , "narrator": "", "text": "これからもたくさん褒めるよ"},
        { "location": "276/ACT"   , "narrator": "", "text": "これからもたくさん褒めるよ"},
        { "location": "278/TALK"  , "narrator": "アーヤ", "text": "じゃあ"},
        { "location": "279/TALK"  , "narrator": "アーヤ", "text": "褒められるようなこと"},
        { "location": "280/TALK"  , "narrator": "アーヤ", "text": "私もたくさんしないとね(￣∇￣)"},
        { "location": "281/TALK"  , "narrator": "アーヤ", "text": "それじゃあ"},
        { "location": "282/TALK"  , "narrator": "アーヤ", "text": "また夜に☆彡"},
        { "location": "15/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>9月1日　 8:19 AM</color>\nとある平日の朝、付属学園講堂にて"}
    ]
}
