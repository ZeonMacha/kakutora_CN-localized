        { "location": "7/SCENARIO", "narrator": "", "text": "028_そいつは危険極まりなく"},
        { "location": "34/TALK"   , "narrator": "みやび", "text": "海には危険がつきものぞね"},
        { "location": "36/SEL"    , "narrator": "", "text": "クラゲとか怖いよね"},
        { "location": "37/SEL"    , "narrator": "", "text": "海難事故に注意"},
        { "location": "38/SEL"    , "narrator": "", "text": "不逞の輩は追い払う"},
        { "location": "39/ACT"    , "narrator": "", "text": "クラゲとか怖いよね"},
        { "location": "40/TALK"   , "narrator": "みやび", "text": "うむ"},
        { "location": "41/TALK"   , "narrator": "みやび", "text": "しかしまだ時期ではないぞね"},
        { "location": "42/TALK"   , "narrator": "みやび", "text": "心配には及ばん"},
        { "location": "43/ACT"    , "narrator": "", "text": "海難事故に注意"},
        { "location": "44/TALK"   , "narrator": "みやび", "text": "確かに"},
        { "location": "45/TALK"   , "narrator": "みやび", "text": "そして"},
        { "location": "46/TALK"   , "narrator": "みやび", "text": "荒くれ男どもの匂いがするな"},
        { "location": "47/TALK"   , "narrator": "みやび", "text": "それはそれで"},
        { "location": "48/TALK"   , "narrator": "みやび", "text": "ドラマになるぞね"},
        { "location": "49/ACT"    , "narrator": "", "text": "不逞の輩は追い払う"},
        { "location": "51/TALK"   , "narrator": "みやび", "text": "さすがだの相棒"},
        { "location": "52/TALK"   , "narrator": "みやび", "text": "その時は頼む"},
        { "location": "54/SEL"    , "narrator": "", "text": "即、警察に連絡するから"},
        { "location": "55/SEL"    , "narrator": "", "text": "チカン防止ブザー機能がある"},
        { "location": "56/SEL"    , "narrator": "", "text": "電波で攻撃する"},
        { "location": "57/ACT"    , "narrator": "", "text": "即、警察に連絡するから"},
        { "location": "58/TALK"   , "narrator": "みやび", "text": "なるほど"},
        { "location": "59/TALK"   , "narrator": "みやび", "text": "具体案感謝する"},
        { "location": "60/ACT"    , "narrator": "", "text": "チカン防止ブザー機能がある"},
        { "location": "61/TALK"   , "narrator": "みやび", "text": "ほう"},
        { "location": "63/TALK"   , "narrator": "みやび", "text": "今度試してみようぞ"},
        { "location": "64/ACT"    , "narrator": "", "text": "電波で攻撃する"},
        { "location": "66/TALK"   , "narrator": "みやび", "text": "ほほう"},
        { "location": "68/TALK"   , "narrator": "みやび", "text": "素晴らしい"},
