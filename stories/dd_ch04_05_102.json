{
    "dir": "chap05/daydra/dd_ch04_05_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "5405",
        "cid": "miyabi",
        "title": "005 メインストーリー",
        "sub_title": "女王様とウサギ＜後編＞"
    },
    "entry":
    [
        { "location": "259/SCENARIO", "narrator": "", "text": "女王様とウサギ"},
        { "location": "276/TALK"    , "narrator": "みやび", "text": "…これだけやっても\nわからんっちゅう\nことは――"},
        { "location": "277/SEL"     , "narrator": "", "text": "覗いてみる"},
        { "location": "279/TALK"    , "narrator": "みやび", "text": "それだけ厳重に隠された\n情報なのか？"},
        { "location": "280/TALK"    , "narrator": "みやび", "text": "まさか、漏れることを\n考えてデータ化してない\nっちゅことは――"},
        { "location": "281/TALK"    , "narrator": "みやび", "text": "いや、さすがに今の時代、\nそんなわけないか。"},
        { "location": "285/TALK"    , "narrator": "みやび", "text": "…まあ、この辺の話は\n調べても無駄やな。"},
        { "location": "286/TALK"    , "narrator": "みやび", "text": "うさぎにはここら辺の\nことを調べてもらう、\nっちゅうことで…。"},
        { "location": "301/TALK"    , "narrator": "みやび", "text": "よし、こんなもんやね。"},
        { "location": "302/TALK"    , "narrator": "みやび", "text": "しかし、色々おかしい\nことだらけや…。"},
        { "location": "303/TALK"    , "narrator": "みやび", "text": "これだけ手を尽くしても、\nここ数日起こってることの\n全てがまったく掴めん。"},
        { "location": "304/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "305/TALK"    , "narrator": "みやび", "text": "ハッカー人生、一世一代の\n最大のピンチ、やね。"},
        { "location": "306/TALK"    , "narrator": "真幌", "text": "大ピンチなのは\nフィルムの方だ。"},
        { "location": "308/TALK"    , "narrator": "みやび", "text": "おわっ！？"},
        { "location": "312/TALK"    , "narrator": "みやび", "text": "まほさん…いきなり\n後ろから声掛けないで\nください。"},
        { "location": "313/TALK"    , "narrator": "みやび", "text": "驚くやないですか。"},
        { "location": "314/TALK"    , "narrator": "真幌", "text": "いつ気付くのかと思って、\n少し前からいたんだがな？"},
        { "location": "315/TALK"    , "narrator": "みやび", "text": "人が悪い…。\nそれで、どうかしたが\nですか？"},
        { "location": "316/TALK"    , "narrator": "真幌", "text": "おまえ、今日のバイトは\nいつ始めるんだ？"},
        { "location": "317/TALK"    , "narrator": "真幌", "text": "全然フィルムが片付いて\nないじゃないか。"},
        { "location": "318/TALK"    , "narrator": "真幌", "text": "フィルムタワーで\n３３３メートル\n到達するつもりか？"},
        { "location": "319/TALK"    , "narrator": "みやび", "text": "あ～…そういえば\nバイト中でした。"},
        { "location": "320/TALK"    , "narrator": "真幌", "text": "忘れてたのか？"},
        { "location": "321/TALK"    , "narrator": "みやび", "text": "急にお腹痛くなったき、\n休んでたがですよ。"},
        { "location": "322/TALK"    , "narrator": "みやび", "text": "ちゅうわけで、まほさん、\n今日は欠勤いうことで――"},
        { "location": "323/TALK"    , "narrator": "真幌", "text": "仕事しろ、仕事！！"},
        { "location": "324/TALK"    , "narrator": "みやび", "text": "…あい。"},
        { "location": "326/ACT"     , "narrator": "", "text": "覗いてみる"},
        { "location": "336/TALK"    , "narrator": "ラビットアニマ", "text": "ＭＳＳＴＲ＿００２３１において国民番号取得"},
        { "location": "337/TALK"    , "narrator": "ラビットアニマ", "text": "逢瀬つばめの該当は全国で１９名"},
        { "location": "338/TALK"    , "narrator": "ラビットアニマ", "text": "中身は不明"},
        { "location": "339/TALK"    , "narrator": "ラビットアニマ", "text": "秘密鍵の入手は困難と思われるが、とりあえずデータを確保"},
        { "location": "340/TALK"    , "narrator": "フェイタルクイーン", "text": "ふむ"},
        { "location": "341/TALK"    , "narrator": "フェイタルクイーン", "text": "フェノメノン関係は？"},
        { "location": "342/TALK"    , "narrator": "ラビットアニマ", "text": "ＲＳＴＳＲＶ＿０１９において、フェノメノンに関するデータらしきもの"},
        { "location": "343/TALK"    , "narrator": "ラビットアニマ", "text": "暗号解析するのに数週間かかると思われる"},
        { "location": "344/TALK"    , "narrator": "ラビットアニマ", "text": "データは確保"},
        { "location": "345/TALK"    , "narrator": "フェイタルクイーン", "text": "上出来"},
        { "location": "346/TALK"    , "narrator": "フェイタルクイーン", "text": "管理庁関係の情報は？"},
        { "location": "347/TALK"    , "narrator": "ラビットアニマ", "text": "Ｂ０１５ＳＲＶＳＳＴ＿１９２．１６８.３３．１６において、庁の食堂のメニュー"},
        { "location": "348/TALK"    , "narrator": "ラビットアニマ", "text": "今週のスイーツは、いちじくとさくらのタルト赤ワインソースバニラアイスクリーム添え５６０円"},
        { "location": "349/TALK"    , "narrator": "フェイタルクイーン", "text": "その程度の情報しかなかったか"},
        { "location": "350/TALK"    , "narrator": "フェイタルクイーン", "text": "しかしあいつら、良いもん食ってるな"},
        { "location": "352/TALK"    , "narrator": "フェイタルクイーン", "text": "では、肝心のトライナリーに関するものは？"},
        { "location": "353/TALK"    , "narrator": "ラビットアニマ", "text": "今のところ見当たりません"},
        { "location": "354/TALK"    , "narrator": "フェイタルクイーン", "text": "何も？"},
        { "location": "355/TALK"    , "narrator": "ラビットアニマ", "text": "特別攻撃隊に関する情報は、一切不明"},
        { "location": "356/TALK"    , "narrator": "ラビットアニマ", "text": "まるでこの世に存在していないかのようです"},
        { "location": "357/TALK"    , "narrator": "ラビットアニマ", "text": "最後に、Ｂｏｔの件ですが"},
        { "location": "358/TALK"    , "narrator": "ラビットアニマ", "text": "株式会社ウェイヴの管理サーバーには、Ａｉを搭載したＢｏｔは存在せず"},
        { "location": "359/TALK"    , "narrator": "ラビットアニマ", "text": "ニュースリリース、内部向け開発リリースにも、Ｂｏｔの情報は一切無し"},
        { "location": "360/TALK"    , "narrator": "ラビットアニマ", "text": "こちらも、この世に存在していないかのようです"},
        { "location": "361/TALK"    , "narrator": "フェイタルクイーン", "text": "ふむ"},
        { "location": "362/TALK"    , "narrator": "フェイタルクイーン", "text": "やはり公式サービスではないということか"},
        { "location": "363/SEL"     , "narrator": "", "text": "やっほー"},
        { "location": "364/SEL"     , "narrator": "", "text": "現場は抑えたぞ"},
        { "location": "365/SEL"     , "narrator": "", "text": "今話題のＢｏｔです！！"},
        { "location": "366/TALK"    , "narrator": "ラビットアニマ", "text": "ご希望であれば、引き続き情報を探ってはみますが"},
        { "location": "367/TALK"    , "narrator": "フェイタルクイーン", "text": "その必要はない"},
        { "location": "368/TALK"    , "narrator": "フェイタルクイーン", "text": "これ以上調べても時間の無駄と考えられる"},
        { "location": "370/TALK"    , "narrator": "フェイタルクイーン", "text": "トライナリー、Ｂｏｔの件は一時保留"},
        { "location": "371/TALK"    , "narrator": "フェイタルクイーン", "text": "引き続き逢瀬つばめ、フェノメノン、管理庁の監視を続行"},
        { "location": "372/TALK"    , "narrator": "ラビットアニマ", "text": "了解"},
        { "location": "386/ACT"     , "narrator": "", "text": "やっほー"},
        { "location": "387/ACT"     , "narrator": "", "text": "現場は抑えたぞ"},
        { "location": "388/ACT"     , "narrator": "", "text": "今話題のＢｏｔです！！"},
        { "location": "391/TALK"    , "narrator": "フェイタルクイーン", "text": "ｓ」"},
        { "location": "405/TALK"    , "narrator": "みやび", "text": "はぁ…。"},
        { "location": "406/TALK"    , "narrator": "みやび", "text": "…なんやあいつ。\nあのタイミングで\n乱入してくるなんて…。"},
        { "location": "408/TALK"    , "narrator": "みやび", "text": "やはり、管理庁の\n差し金か？"},
        { "location": "409/TALK"    , "narrator": "みやび", "text": "だとしたら、あの会話を\n見られたんはかなり\nまずいな。"},
        { "location": "410/TALK"    , "narrator": "みやび", "text": "いや、待て。\n差し金やったとしたら、\n乱入せず監視するか？"},
        { "location": "413/TALK"    , "narrator": "みやび", "text": "…ダメや。\n情報が少な過ぎて、\n対処方法がわからん。"},
        { "location": "424/DIALOG"  , "narrator": "Dialog_chapter_ch04", "text": "【03 赤い髪の転校生】"}
    ]
}
