    "entry":
    [
        { "location": "161/SCENARIO", "narrator": "", "text": "036_それでも暑いから"},
        { "location": "186/TALK"    , "narrator": "アーヤ", "text": "エアコン空調って便利だけど"},
        { "location": "187/TALK"    , "narrator": "アーヤ", "text": "味気ないわよね"},
        { "location": "189/SEL"     , "narrator": "", "text": "快適ならそれでよし"},
        { "location": "190/SEL"     , "narrator": "", "text": "暑いのも好きだけど"},
        { "location": "191/SEL"     , "narrator": "", "text": "心の豊かさの話？"},
        { "location": "192/ACT"     , "narrator": "", "text": "快適ならそれでよし"},
        { "location": "193/TALK"    , "narrator": "アーヤ", "text": "確かに"},
        { "location": "195/TALK"    , "narrator": "アーヤ", "text": "そうなんだけどね"},
        { "location": "196/ACT"     , "narrator": "", "text": "暑いのも好きだけど"},
        { "location": "197/TALK"    , "narrator": "アーヤ", "text": "まあ"},
        { "location": "198/TALK"    , "narrator": "アーヤ", "text": "私も嫌いじゃないわ"},
        { "location": "199/ACT"     , "narrator": "", "text": "心の豊かさの話？"},
        { "location": "201/TALK"    , "narrator": "アーヤ", "text": "そうね"},
        { "location": "202/TALK"    , "narrator": "アーヤ", "text": "そういう話よ"},
        { "location": "203/TALK"    , "narrator": "アーヤ", "text": "わかってくれるのね"},
        { "location": "205/TALK"    , "narrator": "アーヤ", "text": "でも"},
        { "location": "206/TALK"    , "narrator": "アーヤ", "text": "エアコンないと"},
        { "location": "207/TALK"    , "narrator": "アーヤ", "text": "特に東京じゃへばっちゃうわ"},
        { "location": "209/SEL"     , "narrator": "", "text": "気を付けてね"},
        { "location": "210/SEL"     , "narrator": "", "text": "まあ暑いしね"},
        { "location": "211/SEL"     , "narrator": "", "text": "そんなアーヤを$me$が介抱"},
        { "location": "212/ACT"     , "narrator": "", "text": "気を付けてね"},
        { "location": "213/TALK"    , "narrator": "アーヤ", "text": "そうよね"},
        { "location": "214/TALK"    , "narrator": "アーヤ", "text": "倒れないように気を付けるわ"},
        { "location": "215/ACT"     , "narrator": "", "text": "まあ暑いしね"},
        { "location": "216/TALK"    , "narrator": "アーヤ", "text": "そうなのよね"},
        { "location": "217/TALK"    , "narrator": "アーヤ", "text": "でも暑くないと夏って気がしないから"},
        { "location": "218/TALK"    , "narrator": "アーヤ", "text": "これでいいのかしら"},
        { "location": "219/ACT"     , "narrator": "", "text": "そんなアーヤを$me$が介抱"},
        { "location": "221/TALK"    , "narrator": "アーヤ", "text": "あら"},
        { "location": "223/TALK"    , "narrator": "アーヤ", "text": "ちゃんと解放してくれる？"},
        { "location": "224/TALK"    , "narrator": "アーヤ", "text": "介抱"},
        { "location": "225/TALK"    , "narrator": "アーヤ", "text": "変なことしようとしたら"},
        { "location": "226/TALK"    , "narrator": "アーヤ", "text": "承知しないわよ"}
    ]
}
