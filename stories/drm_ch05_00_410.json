    "entry":
    [
        { "location": "1815/SCENARIO", "narrator": "", "text": "浜辺から"},
        { "location": "1828/TALK"    , "narrator": "神楽", "text": "…これで終わりに\nしたかったのに…。"},
        { "location": "1829/TALK"    , "narrator": "神楽", "text": "結局中途半端なままで\n作戦は失敗。"},
        { "location": "1830/TALK"    , "narrator": "神楽", "text": "私これから\nどうなるんだろう…？"},
        { "location": "1831/TALK"    , "narrator": "神楽", "text": "私これから\nどうすれば\nいいんだろう…？"},
        { "location": "1843/TALK"    , "narrator": "神楽", "text": "作戦は失敗した"},
        { "location": "1844/TALK"    , "narrator": "神楽", "text": "もう全部おしまい"},
        { "location": "1846/SEL"     , "narrator": "", "text": "ついに……"},
        { "location": "1847/SEL"     , "narrator": "", "text": "$me$は神楽に着いていくから"},
        { "location": "1848/SEL"     , "narrator": "", "text": "辛かったよね…"},
        { "location": "1849/ACT"     , "narrator": "", "text": "ついに……"},
        { "location": "1850/TALK"    , "narrator": "神楽", "text": "もう"},
        { "location": "1852/TALK"    , "narrator": "神楽", "text": "どうしようもなくて"},
        { "location": "1853/ACT"     , "narrator": "", "text": "$me$は神楽に着いていくから"},
        { "location": "1854/TALK"    , "narrator": "神楽", "text": "うん"},
        { "location": "1855/TALK"    , "narrator": "神楽", "text": "でもなんで？"},
        { "location": "1856/ACT"     , "narrator": "", "text": "辛かったよね…"},
        { "location": "1857/TALK"    , "narrator": "神楽", "text": "それは"},
        { "location": "1859/TALK"    , "narrator": "神楽", "text": "そうじゃないとおかしいよね"},
        { "location": "1861/TALK"    , "narrator": "神楽", "text": "じゃあね"},
        { "location": "1872/TALK"    , "narrator": "神楽", "text": "ママ……。\n音羽……。\nごめんね……。"},
        { "location": "1873/SEL"     , "narrator": "", "text": "おーい"},
        { "location": "1874/ACT"     , "narrator": "", "text": "おーい"},
        { "location": "1893/SEL"     , "narrator": "", "text": "大丈夫…じゃないと思うけど"},
        { "location": "1894/SEL"     , "narrator": "", "text": "どう言えばいいかわかんないけど"},
        { "location": "1895/SEL"     , "narrator": "", "text": "神楽は悪くないよ"},
        { "location": "1896/ACT"     , "narrator": "", "text": "大丈夫…じゃないと思うけど"},
        { "location": "1897/TALK"    , "narrator": "神楽", "text": "まあね"},
        { "location": "1898/TALK"    , "narrator": "神楽", "text": "当たり前"},
        { "location": "1899/ACT"     , "narrator": "", "text": "どう言えばいいかわかんないけど"},
        { "location": "1900/TALK"    , "narrator": "神楽", "text": "そうだろうね"},
        { "location": "1901/TALK"    , "narrator": "神楽", "text": "そんなもん"},
        { "location": "1902/ACT"     , "narrator": "", "text": "神楽は悪くないよ"},
        { "location": "1904/TALK"    , "narrator": "神楽", "text": "そんな嘘はやめて"},
        { "location": "1905/TALK"    , "narrator": "神楽", "text": "今は一番そういうのが辛い"},
        { "location": "1906/TALK"    , "narrator": "神楽", "text": "本気にしちゃうから"},
        { "location": "1908/SEL"     , "narrator": "", "text": "本当にそうなんだよ"},
        { "location": "1909/SEL"     , "narrator": "", "text": "だって悪くないでしょ"},
        { "location": "1910/SEL"     , "narrator": "", "text": "神楽も被害者なんだから"},
        { "location": "1911/ACT"     , "narrator": "", "text": "本当にそうなんだよ"},
        { "location": "1912/TALK"    , "narrator": "神楽", "text": "だからやめて"},
        { "location": "1914/TALK"    , "narrator": "神楽", "text": "そういうのは"},
        { "location": "1915/ACT"     , "narrator": "", "text": "だって悪くないでしょ"},
        { "location": "1916/TALK"    , "narrator": "神楽", "text": "そんなわけないし"},
        { "location": "1917/TALK"    , "narrator": "神楽", "text": "適当言わないで"},
        { "location": "1918/ACT"     , "narrator": "", "text": "神楽も被害者なんだから"},
        { "location": "1919/TALK"    , "narrator": "神楽", "text": "それとこれとは別問題"},
        { "location": "1933/TALK"    , "narrator": "神楽", "text": "つばめさん……\n大丈夫だったかな…？"},
        { "location": "1934/TALK"    , "narrator": "神楽", "text": "…なんて私が\nそんなこと思うの\n変だけど……。"},
        { "location": "1935/SEL"     , "narrator": "", "text": "神楽"},
        { "location": "1936/ACT"     , "narrator": "", "text": "神楽"},
        { "location": "1955/SEL"     , "narrator": "", "text": "あんまり自分を責めないで"},
        { "location": "1956/SEL"     , "narrator": "", "text": "この先いいこともあるから"},
        { "location": "1957/SEL"     , "narrator": "", "text": "仕方ないことだったから"},
        { "location": "1958/ACT"     , "narrator": "", "text": "あんまり自分を責めないで"},
        { "location": "1959/ACT"     , "narrator": "", "text": "この先いいこともあるから"},
        { "location": "1960/ACT"     , "narrator": "", "text": "仕方ないことだったから"},
        { "location": "1973/TALK"    , "narrator": "神楽", "text": "……………。"}
    ]
}
