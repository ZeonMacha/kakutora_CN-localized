    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "540_ウィンドウショッピング"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "ねえ聞いて"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "アーヤったら"},
        { "location": "34/TALK"   , "narrator": "ガブリエラ", "text": "プレゼントは手作りが一番よろこんでもらえるって言うの"},
        { "location": "35/TALK"   , "narrator": "ガブリエラ", "text": "どう思う？"},
        { "location": "37/SEL"    , "narrator": "", "text": "いいんじゃない"},
        { "location": "38/SEL"    , "narrator": "", "text": "ちょっと重いかな"},
        { "location": "39/TALK"   , "narrator": "ガブリエラ", "text": "まあ"},
        { "location": "40/TALK"   , "narrator": "ガブリエラ", "text": "どのくらいの手作りかにもよるとは思うのよ？"},
        { "location": "41/TALK"   , "narrator": "ガブリエラ", "text": "さすがにアーヤだってセーターとかまでは作らないと思うのよね"},
        { "location": "42/TALK"   , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "43/TALK"   , "narrator": "ガブリエラ", "text": "意外と簡単とか言い出すのかしらね・・・"},
        { "location": "44/ACT"    , "narrator": "", "text": "いいんじゃない"},
        { "location": "45/TALK"   , "narrator": "ガブリエラ", "text": "えっ"},
        { "location": "46/TALK"   , "narrator": "ガブリエラ", "text": "$handle$は手作りのほうが嬉しい人なの"},
        { "location": "47/TALK"   , "narrator": "ガブリエラ", "text": "そうなのね・・・"},
        { "location": "48/ACT"    , "narrator": "", "text": "ちょっと重いかな"},
        { "location": "49/TALK"   , "narrator": "ガブリエラ", "text": "やっぱりそうよね"},
        { "location": "50/TALK"   , "narrator": "ガブリエラ", "text": "よかったわ、、、、"},
        { "location": "52/TALK"   , "narrator": "ガブリエラ", "text": "私だったら"},
        { "location": "54/TALK"   , "narrator": "ガブリエラ", "text": "いつでも使えるものとかをプレゼントするわ"},
        { "location": "55/TALK"   , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "56/TALK"   , "narrator": "ガブリエラ", "text": "問題は"},
        { "location": "57/TALK"   , "narrator": "ガブリエラ", "text": "いつもは何を使っているかってところなのよね"},
        { "location": "59/SEL"    , "narrator": "", "text": "教えたほうがいい？"},
        { "location": "60/SEL"    , "narrator": "", "text": "その気持ちが嬉しい"},
        { "location": "61/SEL"    , "narrator": "", "text": "何もいらないよ"},
        { "location": "62/ACT"    , "narrator": "", "text": "教えたほうがいい？"},
        { "location": "63/TALK"   , "narrator": "ガブリエラ", "text": "えっ"},
        { "location": "65/TALK"   , "narrator": "ガブリエラ", "text": "別に"},
        { "location": "66/TALK"   , "narrator": "ガブリエラ", "text": "$handle$のことじゃないし・・・"},
        { "location": "67/ACT"    , "narrator": "", "text": "その気持ちが嬉しい"},
        { "location": "77/TALK"   , "narrator": "ガブリエラ", "text": "えっ"},
        { "location": "79/TALK"   , "narrator": "ガブリエラ", "text": "なんで"},
        { "location": "81/TALK"   , "narrator": "ガブリエラ", "text": "$handle$のことだってわかったのよ・・・"},
        { "location": "82/TALK"   , "narrator": "ガブリエラ", "text": "もう・・・！"},
        { "location": "83/ACT"    , "narrator": "", "text": "何もいらないよ"},
        { "location": "84/TALK"   , "narrator": "ガブリエラ", "text": "えっ"},
        { "location": "85/TALK"   , "narrator": "ガブリエラ", "text": "何よ"},
        { "location": "86/TALK"   , "narrator": "ガブリエラ", "text": "$handle$のことだなんて言ってないし・・・"},
        { "location": "89/TALK"   , "narrator": "ガブリエラ", "text": "なんだか"},
        { "location": "90/TALK"   , "narrator": "ガブリエラ", "text": "まるで私が$handle$のプレゼントを探しているみたいなことになってるけど"},
        { "location": "91/SEL"    , "narrator": "", "text": "違うの？"},
        { "location": "92/SEL"    , "narrator": "", "text": "残念だな……"},
        { "location": "93/TALK"   , "narrator": "ガブリエラ", "text": "違うんだからね！"},
        { "location": "94/TALK"   , "narrator": "ガブリエラ", "text": "ただちょっと"},
        { "location": "95/TALK"   , "narrator": "ガブリエラ", "text": "何軒かお店回ったりとかしたけど"},
        { "location": "96/TALK"   , "narrator": "ガブリエラ", "text": "何が気に入るかわからなくなっちゃっただけなんだから"},
        { "location": "98/ACT"    , "narrator": "", "text": "違うの？"},
        { "location": "99/TALK"   , "narrator": "ガブリエラ", "text": "えっと"},
        { "location": "100/TALK"  , "narrator": "ガブリエラ", "text": "探したけど"},
        { "location": "101/TALK"  , "narrator": "ガブリエラ", "text": "何がいいかわからなくなって買えなかったから"},
        { "location": "102/TALK"  , "narrator": "ガブリエラ", "text": "違うと思うのよ"},
        { "location": "103/ACT"   , "narrator": "", "text": "残念だな……"},
        { "location": "104/TALK"  , "narrator": "ガブリエラ", "text": "えっと"},
        { "location": "106/TALK"  , "narrator": "ガブリエラ", "text": "探したけど"},
        { "location": "107/TALK"  , "narrator": "ガブリエラ", "text": "何がいいかわからなくなって"},
        { "location": "108/TALK"  , "narrator": "ガブリエラ", "text": "買わなかったのよ"},
        { "location": "110/TALK"  , "narrator": "ガブリエラ", "text": "$handle$のばか"},
        { "location": "111/TALK"  , "narrator": "ガブリエラ", "text": "こんなこと言わせるなんて"},
        { "location": "113/SEL"   , "narrator": "", "text": "$handle$のせいかな？"},
        { "location": "114/SEL"   , "narrator": "", "text": "照れなくてもいいよ"},
        { "location": "115/ACT"   , "narrator": "", "text": "$handle$のせいかな？"},
        { "location": "117/TALK"  , "narrator": "ガブリエラ", "text": "違うけど・・・"},
        { "location": "118/TALK"  , "narrator": "ガブリエラ", "text": "そうなんだもん・・・"},
        { "location": "119/ACT"   , "narrator": "", "text": "照れる必要ないよ"},
        { "location": "121/TALK"  , "narrator": "ガブリエラ", "text": "照れるとか・・・"},
        { "location": "122/TALK"  , "narrator": "ガブリエラ", "text": "そんなこと"},
        { "location": "123/TALK"  , "narrator": "ガブリエラ", "text": "ないもん・・・"},
        { "location": "73/DIALOG" , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>1000pt.</b></color></size>\nアップしました！"}
    ]
}
