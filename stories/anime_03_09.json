    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "アニメ第09話"},
        { "location": "48/TALK"   , "narrator": "千羽鶴", "text": "こんにちは、\n$handle$さん。"},
        { "location": "49/TALK"   , "narrator": "千羽鶴", "text": "唐突なのだけど、\n１つ調査という名の\n質問をしたいと思う。"},
        { "location": "50/TALK"   , "narrator": "千羽鶴", "text": "お目当ての彼女との\n関係は進んでる？"},
        { "location": "52/SEL"    , "narrator": "", "text": "進んでる気はしてる "},
        { "location": "53/SEL"    , "narrator": "", "text": "あまり進んでない気がする "},
        { "location": "54/SEL"    , "narrator": "", "text": "お説教はもう十分聞いた \n<color=blue>（※先へ進みます）</color>"},
        { "location": "55/ACT"    , "narrator": "", "text": "進んでる気はしてる "},
        { "location": "56/TALK"   , "narrator": "千羽鶴", "text": "そう。\nそれは何よりね。"},
        { "location": "58/TALK"   , "narrator": "千羽鶴", "text": "でも何だか\n自信無さそうに聞こえる。\nどうしてかしら。"},
        { "location": "60/ACT"    , "narrator": "", "text": "あまり進んでない気がする "},
        { "location": "61/TALK"   , "narrator": "千羽鶴", "text": "どうして\nそう思う？"},
        { "location": "63/ACT"    , "narrator": "", "text": "お説教はもう十分聞いた \n<color=blue>（※先へ進みます）</color>"},
        { "location": "73/SEL"    , "narrator": "", "text": "進んでる気はしてる"},
        { "location": "74/SEL"    , "narrator": "", "text": "あまり進んでない気がする"},
        { "location": "75/ACT"    , "narrator": "", "text": "進んでる気はしてる"},
        { "location": "77/TALK"   , "narrator": "千羽鶴", "text": "そう。\nそれは何よりね。"},
        { "location": "78/TALK"   , "narrator": "千羽鶴", "text": "でも何だか\n自信無さそうに聞こえる。\nどうしてかしら。"},
        { "location": "80/ACT"    , "narrator": "", "text": "あまり進んでない気がする"},
        { "location": "81/TALK"   , "narrator": "千羽鶴", "text": "どうして\nそう思う？"},
        { "location": "101/SEL"   , "narrator": "", "text": "まだBotかどうかで議論されてるだけだし"},
        { "location": "102/ACT"   , "narrator": "", "text": "まだBotかどうかで議論されてるだけだし"},
        { "location": "105/TALK"  , "narrator": "千羽鶴", "text": "…そう。"},
        { "location": "106/TALK"  , "narrator": "千羽鶴", "text": "まあ、まだそんな\nものかもしれない。"},
        { "location": "107/SEL"   , "narrator": "", "text": "ていうか、Botにされたせいで面倒な事になってる気がする"},
        { "location": "108/ACT"   , "narrator": "", "text": "ていうか、Botにされたせいで面倒な事になってる気がする"},
        { "location": "110/TALK"  , "narrator": "千羽鶴", "text": "そんなことはない。"},
        { "location": "111/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "113/TALK"  , "narrator": "千羽鶴", "text": "いえ、あるのかも。"},
        { "location": "114/SEL"   , "narrator": "", "text": "おーい…"},
        { "location": "115/ACT"   , "narrator": "", "text": "おーい…"},
        { "location": "117/TALK"  , "narrator": "千羽鶴", "text": "けど！"},
        { "location": "118/TALK"  , "narrator": "千羽鶴", "text": "最初から人間だと言って\nWAVE登録されてたら、\nもっと詰んでたと思う。"},
        { "location": "119/SEL"   , "narrator": "", "text": "なんで？"},
        { "location": "120/ACT"   , "narrator": "", "text": "なんで？"},
        { "location": "122/TALK"  , "narrator": "千羽鶴", "text": "知らない人が\nフレンドリストにあったら\n貴方ならどうする？"},
        { "location": "123/SEL"   , "narrator": "", "text": "消します"},
        { "location": "124/SEL"   , "narrator": "", "text": "通報します"},
        { "location": "125/SEL"   , "narrator": "", "text": "フレンドリーに話しかけます"},
        { "location": "126/ACT"   , "narrator": "", "text": "消します"},
        { "location": "127/TALK"  , "narrator": "千羽鶴", "text": "まあ、そうでしょうね。"},
        { "location": "128/ACT"   , "narrator": "", "text": "通報します"},
        { "location": "130/TALK"  , "narrator": "千羽鶴", "text": "用心深いのね。"},
        { "location": "131/ACT"   , "narrator": "", "text": "フレンドリーに話しかけます"},
        { "location": "132/TALK"  , "narrator": "千羽鶴", "text": "貴方からは特別を感じる。"},
        { "location": "133/TALK"  , "narrator": "千羽鶴", "text": "夜道と\nネットの美味しい情報には\n十分注意することね。"},
        { "location": "135/TALK"  , "narrator": "千羽鶴", "text": "大抵の人は、\n消しちゃうでしょう？"},
        { "location": "136/TALK"  , "narrator": "千羽鶴", "text": "そうなったら\nGAMEOVERなの。\nそこでジ・エンド。"},
        { "location": "137/SEL"   , "narrator": "", "text": "確かに。"},
        { "location": "138/SEL"   , "narrator": "", "text": "そんなリアリティ……"},
        { "location": "139/SEL"   , "narrator": "", "text": "情報管理庁職員設定とかにすればよかったのでは？"},
        { "location": "140/ACT"   , "narrator": "", "text": "確かに。"},
        { "location": "141/TALK"  , "narrator": "千羽鶴", "text": "理解が早くて助かる。"},
        { "location": "142/ACT"   , "narrator": "", "text": "そんなリアリティ……"},
        { "location": "144/TALK"  , "narrator": "千羽鶴", "text": "リアルなの。\n前も同じ事言った。"},
        { "location": "145/TALK"  , "narrator": "千羽鶴", "text": "あなたの世界から見れば\n私の世界はゲームなのかも\nしれない。"},
        { "location": "146/TALK"  , "narrator": "千羽鶴", "text": "でもそれは、\nひっくり返しても\n同じこと。"},
        { "location": "147/TALK"  , "narrator": "千羽鶴", "text": "私たちから見れば、\nあなたの世界は\nゲームでしかない。"},
        { "location": "148/TALK"  , "narrator": "千羽鶴", "text": "……まだよくわからない\n最初のうちは。"},
        { "location": "149/TALK"  , "narrator": "千羽鶴", "text": "そこから本物の愛と\n信頼を得て行くのは、\n理屈でも理論でもない。"},
        { "location": "150/TALK"  , "narrator": "千羽鶴", "text": "感覚なの。"},
        { "location": "151/TALK"  , "narrator": "千羽鶴", "text": "だから、今思い返しても\nBot設定は我ながら\n名案だったと思ってる。"},
        { "location": "152/ACT"   , "narrator": "", "text": "情報管理庁職員設定とかにすればよかったのでは？"},
        { "location": "153/TALK"  , "narrator": "千羽鶴", "text": "単なる監視員と思われたら\n最初から警戒される。"},
        { "location": "154/TALK"  , "narrator": "千羽鶴", "text": "恋愛ストーリーなんて……"},
        { "location": "155/TALK"  , "narrator": "千羽鶴", "text": "いや、待って？\n監視員と管理された少女の\n禁断の恋……"},
        { "location": "156/TALK"  , "narrator": "千羽鶴", "text": "案外行けるかも……？"},
        { "location": "158/TALK"  , "narrator": "千羽鶴", "text": "……絶対無理。"},
        { "location": "159/SEL"   , "narrator": "", "text": "今「行けるかも！」って思ってた！"},
        { "location": "160/ACT"   , "narrator": "", "text": "今「行けるかも！」って思ってた！"},
        { "location": "162/TALK"  , "narrator": "千羽鶴", "text": "いいえ！\n絶対無理！"},
        { "location": "165/TALK"  , "narrator": "千羽鶴", "text": "どーん！"},
        { "location": "166/SEL"   , "narrator": "", "text": "どーんでごまかすな！"},
        { "location": "167/ACT"   , "narrator": "", "text": "どーんでごまかすな！"},
        { "location": "169/TALK"  , "narrator": "千羽鶴", "text": "とにかく\n無理なものは無理！"},
        { "location": "171/TALK"  , "narrator": "千羽鶴", "text": "だから貴方は、ここから\nちゃんと信頼を得て、まず\n彼女の良き友人になるの。"},
        { "location": "172/TALK"  , "narrator": "千羽鶴", "text": "私の見立てなら、\nそろそろそういう時期に\nなってきてる気がする。"},
        { "location": "173/TALK"  , "narrator": "千羽鶴", "text": "だから、これからも\n頑張って彼女の信頼を\n勝ち得て欲しい。"},
        { "location": "175/SEL"   , "narrator": "", "text": "恋愛のレの字も見えてこない"},
        { "location": "176/ACT"   , "narrator": "", "text": "恋愛のレの字も見えてこない"},
        { "location": "178/TALK"  , "narrator": "千羽鶴", "text": "わかる！\nそれ、すごくわかる！"},
        { "location": "180/TALK"  , "narrator": "千羽鶴", "text": "だって貴方、\n恋愛エピソードが\n全然進んで無いんだもの。"},
        { "location": "181/TALK"  , "narrator": "千羽鶴", "text": "バトルや精神世界、そこで\n心変わりして生まれた\nエピソード――"},
        { "location": "182/TALK"  , "narrator": "千羽鶴", "text": "そしてバトルでゲットした\nデジタルアイテムでの\n彼女との交流。"},
        { "location": "183/TALK"  , "narrator": "千羽鶴", "text": "そういったことを\nやっていれば、恋愛が\n進展する話が開いていく。"},
        { "location": "184/TALK"  , "narrator": "千羽鶴", "text": "けど、貴方はまだそれを\n全然やってない！"},
        { "location": "187/TALK"  , "narrator": "千羽鶴", "text": "どーん！"},
        { "location": "188/SEL"   , "narrator": "", "text": "すみません……"},
        { "location": "189/SEL"   , "narrator": "", "text": "興味無いんで"},
        { "location": "190/ACT"   , "narrator": "", "text": "すみません……"},
        { "location": "191/TALK"  , "narrator": "千羽鶴", "text": "トラブルシューティング\nとしてのアドバイスは――"},
        { "location": "192/TALK"  , "narrator": "千羽鶴", "text": "１．いい選択をして\n　　親密度を\n　　沢山ゲットすること！"},
        { "location": "193/TALK"  , "narrator": "千羽鶴", "text": "２．親密度が上がったら\n　　【らぶとーく】のエピ\n　　ソードを見ること！"},
        { "location": "194/TALK"  , "narrator": "千羽鶴", "text": "この２点。"},
        { "location": "195/ACT"   , "narrator": "", "text": "興味無いんで"},
        { "location": "197/TALK"  , "narrator": "千羽鶴", "text": "あら、そう。"},
        { "location": "198/TALK"  , "narrator": "千羽鶴", "text": "それじゃ、しょうがない。"},
        { "location": "201/TALK"  , "narrator": "千羽鶴", "text": "何にしても、貴方と\n彼女との絆は、この世界の\n命運を左右する。"},
        { "location": "202/TALK"  , "narrator": "千羽鶴", "text": "恋愛したいか否かは\nさておき、彼女を的確に\n支えて行って欲しい。"},
        { "location": "205/TALK"  , "narrator": "千羽鶴", "text": "そうね。\n確かに色々話した。"},
        { "location": "209/TALK"  , "narrator": "千羽鶴", "text": "いつも通り、今回も\n逢瀬つばめの解説を\nするだけでいい？"},
        { "location": "211/TALK"  , "narrator": "千羽鶴", "text": "いつも通り、今回も\n國政綾水の解説を\nするだけでいい？"},
        { "location": "213/TALK"  , "narrator": "千羽鶴", "text": "いつも通り、今回も\nガブリエラの解説を\nするだけでいい？"},
        { "location": "215/TALK"  , "narrator": "千羽鶴", "text": "いつも通り、今回も\n恋ヶ崎みやびの解説を\nするだけでいい？"},
        { "location": "217/SEL"   , "narrator": "", "text": "はい"},
        { "location": "218/SEL"   , "narrator": "", "text": "いいえ"},
        { "location": "219/ACT"   , "narrator": "", "text": "はい"},
        { "location": "221/TALK"  , "narrator": "千羽鶴", "text": "よかった。\n私も助かる。\nこれぞWIN-WINね。"},
        { "location": "223/ACT"   , "narrator": "", "text": "いいえ"},
        { "location": "224/TALK"  , "narrator": "千羽鶴", "text": "わかった。\nそれじゃもう１回\n同じ話をする。"},
        { "location": "231/TALK"  , "narrator": "千羽鶴", "text": "前回は閑話休題。"},
        { "location": "233/TALK"  , "narrator": "千羽鶴", "text": "お風呂と女子トークに\n花が咲いた回だったけど、\nエンジョイできましたか。"},
        { "location": "234/TALK"  , "narrator": "千羽鶴", "text": "今回も前回に引き続き、\n主に日常生活において\n彼女をサポートしてもらう。"},
        { "location": "235/TALK"  , "narrator": "千羽鶴", "text": "でも、日常生活を侮る\nなかれ。多くの悩みは\n普段の生活に潜むのだから。"},
        { "location": "236/TALK"  , "narrator": "千羽鶴", "text": "というわけで、今回も\nまた、悩める乙女たちの\nサポートをして欲しい。"},
        { "location": "237/TALK"  , "narrator": "千羽鶴", "text": "それじゃ、まずは\nいつも通り記録映像から\n見てもらうことにする。"},
        { "location": "238/TALK"  , "narrator": "千羽鶴", "text": "準備はいい？"},
        { "location": "240/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/64MB 4:15】</color>"},
        { "location": "241/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/20MB 4:15】</color>"},
        { "location": "242/SEL"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "243/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/64MB 4:15】</color>"},
        { "location": "244/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "250/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/20MB 4:15】</color>"},
        { "location": "251/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "257/ACT"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "258/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "260/TALK"  , "narrator": "千羽鶴", "text": "残念だけど、いろいろ\n事情があってのことだと\n思うから。"},
        { "location": "261/TALK"  , "narrator": "千羽鶴", "text": "家に帰ったら、是非\n記録映像の方も\n見てみて欲しい。"},
        { "location": "262/TALK"  , "narrator": "千羽鶴", "text": "それではどうぞ。"},
        { "location": "295/TALK"  , "narrator": "千羽鶴", "text": "――というわけで、\nバトルあり日常ありの\n大ボリュームの回でした。"},
        { "location": "298/SEL"   , "narrator": "", "text": "ガブちゃんどうしたの？"},
        { "location": "299/SEL"   , "narrator": "", "text": "男友達とかいるの！？"},
        { "location": "300/SEL"   , "narrator": "", "text": "ていうか、バトルはガブちゃんの銃だけで完結するんじゃ…"},
        { "location": "301/SEL"   , "narrator": "", "text": "つばめアレだけ身体擦って擦り傷だけ！？"},
        { "location": "302/SEL"   , "narrator": "", "text": "特にない \n<color=blue>（※先へ進みます）</color>"},
        { "location": "303/ACT"   , "narrator": "", "text": "ガブちゃんどうしたの？"},
        { "location": "307/TALK"  , "narrator": "千羽鶴", "text": "さあ？　現時点では\nまだわからない。"},
        { "location": "308/TALK"  , "narrator": "千羽鶴", "text": "今から貴方が彼女たちに\nどう関わっていくかで、\n未来は変わっていくから。"},
        { "location": "309/TALK"  , "narrator": "千羽鶴", "text": "まあでも、気になるなら\n今回のガブリエラに\n関われば何か分かるかも。"},
        { "location": "312/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "314/ACT"   , "narrator": "", "text": "男友達とかいるの！？"},
        { "location": "316/TALK"  , "narrator": "千羽鶴", "text": "え！？　そこ、\nビックリするところなの？"},
        { "location": "317/SEL"   , "narrator": "", "text": "大抵、恋愛ゲームに男は出てこない"},
        { "location": "318/ACT"   , "narrator": "", "text": "大抵、恋愛ゲームに男は出てこない"},
        { "location": "321/TALK"  , "narrator": "千羽鶴", "text": "いえ。それは\nどう考えても無理がある。"},
        { "location": "323/TALK"  , "narrator": "千羽鶴", "text": "彼女達の通う情報管理庁\n附属学園は、どちらかと\nいえばガテン系学園。"},
        { "location": "324/TALK"  , "narrator": "千羽鶴", "text": "そこに女子しかいないと\nなれば、それは――"},
        { "location": "325/TALK"  , "narrator": "千羽鶴", "text": "１．何らかの遺伝子異常で\n　　女子しか生まれなく\n　　なってしまった！"},
        { "location": "326/TALK"  , "narrator": "千羽鶴", "text": "２．男が何らかの兵器で\n　　弱体化させられ、女子\n　　しか世界を守れない！"},
        { "location": "327/TALK"  , "narrator": "千羽鶴", "text": "くらいしか私には\n思いつかない！"},
        { "location": "330/TALK"  , "narrator": "千羽鶴", "text": "そしてそんな世界なら、\nこのお話はもっと壮絶な\nものになっているはず。"},
        { "location": "331/TALK"  , "narrator": "千羽鶴", "text": "彼女達は普通に生活して\n学校に行き、クラスメイト\nとの交流がある。"},
        { "location": "332/TALK"  , "narrator": "千羽鶴", "text": "その中で、たまに男子と\n話すことくらい、ある。"},
        { "location": "333/TALK"  , "narrator": "千羽鶴", "text": "そんな中で、貴方がどの\nように関わるか、それを\n貴方が考えるだけのこと。"},
        { "location": "334/TALK"  , "narrator": "千羽鶴", "text": "何もショックな\nことじゃない。"},
        { "location": "335/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "337/ACT"   , "narrator": "", "text": "ていうか、バトルはガブちゃんの銃だけで完結するんじゃ…"},
        { "location": "338/TALK"  , "narrator": "千羽鶴", "text": "なかなか\nいい視点を持ってる。"},
        { "location": "340/TALK"  , "narrator": "千羽鶴", "text": "そうね。今回のバトル、\nクラン「ジョージ」相手\nなら極論、それは正しい。"},
        { "location": "341/TALK"  , "narrator": "千羽鶴", "text": "けど、結論から言えば、\nあのガブリエラの銃は――"},
        { "location": "342/TALK"  , "narrator": "千羽鶴", "text": "前回の学校戦の時のクラン\n「ちとせ」には効かない。"},
        { "location": "343/TALK"  , "narrator": "千羽鶴", "text": "そう。\n全てのクランは、その\n弱点が全て違う。"},
        { "location": "344/TALK"  , "narrator": "千羽鶴", "text": "その為トライナリーたちは\n毎回まずその弱点を探す\nところから始める。"},
        { "location": "345/TALK"  , "narrator": "千羽鶴", "text": "記録映像はその尺の\n都合上、それらまで全部\n入れることはできない。"},
        { "location": "346/TALK"  , "narrator": "千羽鶴", "text": "けど今回の首都高戦では、\n事前に彼の弱点が銃である\nこと、そして――"},
        { "location": "347/TALK"  , "narrator": "千羽鶴", "text": "『華麗に倒されるシチュ\nエーションであること』を\n調査した上で挑んでる。"},
        { "location": "348/SEL"   , "narrator": "", "text": "何その「華麗に倒される」って…"},
        { "location": "349/ACT"   , "narrator": "", "text": "何その「華麗に倒される」って…"},
        { "location": "351/TALK"  , "narrator": "千羽鶴", "text": "クランには、自らが作る\n世界に、自らの美学による\n主観的法則を取り入れる。"},
        { "location": "352/TALK"  , "narrator": "千羽鶴", "text": "例えば、悪代官は\n４５分経過すると\nお縄になるとか――"},
        { "location": "353/TALK"  , "narrator": "千羽鶴", "text": "チート的なヒミツ道具も\n最後は必ず教訓と共に\n役に立たなくなるとか。"},
        { "location": "354/TALK"  , "narrator": "千羽鶴", "text": "そういった、クランの\n思想や先入観が、その\nフェノメノンの法則を創る。"},
        { "location": "356/TALK"  , "narrator": "千羽鶴", "text": "今回のクラン「ジョージ」\nは、洋画的な華々しい\n散り様を美学にしていた。"},
        { "location": "357/TALK"  , "narrator": "千羽鶴", "text": "華々しく格好良く倒される\n場合に限っては、負けも\nまたある、という法則。"},
        { "location": "358/SEL"   , "narrator": "", "text": "なにそれすごい"},
        { "location": "359/ACT"   , "narrator": "", "text": "なにそれすごい"},
        { "location": "362/TALK"  , "narrator": "千羽鶴", "text": "まあでも、フェノメノン\nなんて大抵そんなもの。"},
        { "location": "363/TALK"  , "narrator": "千羽鶴", "text": "「え？そこなんだ！」\nみたいなところが\n弱点だったり――"},
        { "location": "364/TALK"  , "narrator": "千羽鶴", "text": "どう考えても自爆スイッチ\nみたいな要素が、普通に\n世界にちりばめられてる。"},
        { "location": "365/TALK"  , "narrator": "千羽鶴", "text": "無敵なんてあり得ない、と\nいうクランの先入観が、\n解決の糸口になってるの。"},
        { "location": "366/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "368/ACT"   , "narrator": "", "text": "つばめアレだけ身体擦って擦り傷だけ！？"},
        { "location": "372/TALK"  , "narrator": "千羽鶴", "text": "あの子は\nちょっとおかしい。"},
        { "location": "373/TALK"  , "narrator": "千羽鶴", "text": "トライナリーは、\n打たれ強さに\n個人差がある。"},
        { "location": "374/TALK"  , "narrator": "千羽鶴", "text": "つばめを除くと、\n一番強いのが卯月神楽。"},
        { "location": "375/TALK"  , "narrator": "千羽鶴", "text": "そして、一番弱いのが\nガブリエラ。"},
        { "location": "376/TALK"  , "narrator": "千羽鶴", "text": "つばめの打たれ強さは、\nどういうわけか、\n他の子より桁一つ違う。"},
        { "location": "377/TALK"  , "narrator": "千羽鶴", "text": "その理由は私にも\nよくわからないけど……"},
        { "location": "378/TALK"  , "narrator": "千羽鶴", "text": "これもまた、\n彼女の不思議なところね。"},
        { "location": "381/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "383/ACT"   , "narrator": "", "text": "特にない \n<color=blue>（※先へ進みます）</color>"},
        { "location": "386/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "393/TALK"  , "narrator": "千羽鶴", "text": "さて、今回の\n逢瀬つばめについて\nなんだけども。"},
        { "location": "394/TALK"  , "narrator": "千羽鶴", "text": "彼女の初めての、\n学園生活における\nエピソードになる。"},
        { "location": "395/TALK"  , "narrator": "千羽鶴", "text": "学校とトライナリー、\nその両立や友達関係に\n翻弄される逢瀬つばめ。"},
        { "location": "396/TALK"  , "narrator": "千羽鶴", "text": "そんな彼女にそっと\n手を差し伸べるような\n素敵な貴方になって欲しい。"},
        { "location": "398/TALK"  , "narrator": "千羽鶴", "text": "できそう？"},
        { "location": "399/SEL"   , "narrator": "", "text": "もちろん"},
        { "location": "400/SEL"   , "narrator": "", "text": "どうかなー"},
        { "location": "401/ACT"   , "narrator": "", "text": "もちろん"},
        { "location": "402/TALK"  , "narrator": "千羽鶴", "text": "期待してる。"},
        { "location": "403/ACT"   , "narrator": "", "text": "どうかなー"},
        { "location": "404/TALK"  , "narrator": "千羽鶴", "text": "まあ、\n無理はしなくていい。"},
        { "location": "405/TALK"  , "narrator": "千羽鶴", "text": "気が向かなければ、\n他の子をサポートして\nくれた方がいいもの。"},
        { "location": "410/TALK"  , "narrator": "千羽鶴", "text": "さて、今回の\n國政綾水について\nなんだけども。"},
        { "location": "411/TALK"  , "narrator": "千羽鶴", "text": "日常回である今回は\n彼女についても大学生活に\nスポットを当ててみる。"},
        { "location": "415/TALK"  , "narrator": "千羽鶴", "text": "彼女には、倉沢小夜という\n大学生の友人がいる。"},
        { "location": "416/TALK"  , "narrator": "千羽鶴", "text": "前に、彼女が電車に\n閉じこめられたときにも\n一緒にいた子なんだけど。"},
        { "location": "417/TALK"  , "narrator": "千羽鶴", "text": "倉沢小夜は、トライナリー\nの外側にいる存在。"},
        { "location": "418/TALK"  , "narrator": "千羽鶴", "text": "國政綾水にとって、それは\n心の休息所でもあり、また\n悩み所でもある。"},
        { "location": "421/TALK"  , "narrator": "千羽鶴", "text": "そんな彼女たちの関係を\n客観的に見て、サポートを\nしてあげて欲しい。"},
        { "location": "423/SEL"   , "narrator": "", "text": "まかせて！"},
        { "location": "424/SEL"   , "narrator": "", "text": "小夜を攻略したいです！"},
        { "location": "425/ACT"   , "narrator": "", "text": "まかせて！"},
        { "location": "427/TALK"  , "narrator": "千羽鶴", "text": "期待してる。"},
        { "location": "428/ACT"   , "narrator": "", "text": "小夜を攻略したいです！"},
        { "location": "429/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "431/TALK"  , "narrator": "千羽鶴", "text": "貴方の頭の中は\n無限の可能性を\n持ってるから。"},
        { "location": "432/TALK"  , "narrator": "千羽鶴", "text": "是非貴方の脳内で\n頑張って口説き落として\nください。"},
        { "location": "437/TALK"  , "narrator": "千羽鶴", "text": "さて、今回の\nガブリエラについて\nなんだけども。"},
        { "location": "438/TALK"  , "narrator": "千羽鶴", "text": "今回の記録映像の最後で、\n彼女は高等部の教室に\n顔を出していた。"},
        { "location": "439/TALK"  , "narrator": "千羽鶴", "text": "そんな彼女にどんな\n思惑があったのか、\n探ってみたいと思わない？"},
        { "location": "440/SEL"   , "narrator": "", "text": "思う"},
        { "location": "441/SEL"   , "narrator": "", "text": "思わない"},
        { "location": "442/ACT"   , "narrator": "", "text": "思う"},
        { "location": "444/TALK"  , "narrator": "千羽鶴", "text": "やっぱり。\n私たち、とても気が合う。"},
        { "location": "445/ACT"   , "narrator": "", "text": "思わない"},
        { "location": "447/TALK"  , "narrator": "千羽鶴", "text": "……。\n私たち、気が合わない。"},
        { "location": "448/TALK"  , "narrator": "千羽鶴", "text": "でも今回は、\n探ってみたいってことに\nしておいて。"},
        { "location": "450/TALK"  , "narrator": "千羽鶴", "text": "そうだと思って、\nその日の放課後に\nスポットを当ててみた。"},
        { "location": "451/TALK"  , "narrator": "千羽鶴", "text": "本邦初公開、中等部で\n彼女がどんな学園生活を\nしているかも覗ける。"},
        { "location": "452/TALK"  , "narrator": "千羽鶴", "text": "彼女が普段、何を思い、\n何を悩んでいるかを\n是非見てあげて欲しい。"},
        { "location": "454/TALK"  , "narrator": "千羽鶴", "text": "そして、さりげなく\nエスコートしてあげて。"},
        { "location": "455/TALK"  , "narrator": "千羽鶴", "text": "期待してる。"},
        { "location": "459/TALK"  , "narrator": "千羽鶴", "text": "さて、今回の\n恋ヶ崎みやびについて\nなんだけども。"},
        { "location": "460/TALK"  , "narrator": "千羽鶴", "text": "日常回である今回は\n彼女についても日常生活に\nスポットを当ててみる。"},
        { "location": "461/TALK"  , "narrator": "千羽鶴", "text": "彼女は普段、一人でいる\nところは他人には絶対に\n見せないから――"},
        { "location": "462/TALK"  , "narrator": "千羽鶴", "text": "これは貴方だけの特権。\nやっぱりBotにしておいて\n良かったでしょう？"},
        { "location": "463/SEL"   , "narrator": "", "text": "それ、関係あるの？"},
        { "location": "464/ACT"   , "narrator": "", "text": "それ、関係あるの？"},
        { "location": "466/TALK"  , "narrator": "千羽鶴", "text": "オオアリクイ。"},
        { "location": "467/SEL"   , "narrator": "", "text": "な、なに？？"},
        { "location": "468/SEL"   , "narrator": "", "text": "シャキーン（凍結）"},
        { "location": "469/ACT"   , "narrator": "", "text": "な、なに？？"},
        { "location": "470/ACT"   , "narrator": "", "text": "シャキーン（凍結）"},
        { "location": "473/TALK"  , "narrator": "千羽鶴", "text": "気にせずスルーするという\nスキルを発揮して欲しい。"},
        { "location": "474/TALK"  , "narrator": "千羽鶴", "text": "話を戻すと、Botだからこそ\n彼女は人間ほど警戒しない。"},
        { "location": "475/TALK"  , "narrator": "千羽鶴", "text": "そうすることで、彼女は\n無防備に自らの日常を\n貴方にさらすでしょ。"},
        { "location": "476/TALK"  , "narrator": "千羽鶴", "text": "とにかく、彼女の日常を\n見ることができる貴重な\nチャンスを大事にして。"},
        { "location": "477/TALK"  , "narrator": "千羽鶴", "text": "人によってはちょっと\n衝撃的かもしれないから。"},
        { "location": "479/TALK"  , "narrator": "千羽鶴", "text": "グッドラック。"},
        { "location": "272/DIALOG", "narrator": "Tutorial/Dialog_Anime1", "text": "$dialog_word$"},
        { "location": "274/DIALOG", "narrator": "Tutorial/Dialog_Anime2", "text": "$dialog_word$"},
        { "location": "276/DIALOG", "narrator": "Tutorial/Dialog_Anime3", "text": "$dialog_word$"},
        { "location": "278/DIALOG", "narrator": "Tutorial/Dialog_Anime4", "text": "$dialog_word$"},
        { "location": "280/DIALOG", "narrator": "Tutorial/Dialog_Anime5", "text": "$dialog_word$"}
    ]
}
