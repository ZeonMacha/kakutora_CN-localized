    "entry":
    [
        { "location": "88/SCENARIO", "narrator": "", "text": "008_擬人化などしておらぬ"},
        { "location": "113/TALK"   , "narrator": "みやび", "text": "小鳥さん"},
        { "location": "114/TALK"   , "narrator": "みやび", "text": "空に飛んでいったちや"},
        { "location": "117/SEL"    , "narrator": "", "text": "詩？"},
        { "location": "118/SEL"    , "narrator": "", "text": "ポエム？"},
        { "location": "119/ACT"    , "narrator": "", "text": "詩？"},
        { "location": "120/TALK"   , "narrator": "みやび", "text": "違う"},
        { "location": "121/ACT"    , "narrator": "", "text": "ポエム？"},
        { "location": "122/TALK"   , "narrator": "みやび", "text": "なんでや"},
        { "location": "124/TALK"   , "narrator": "みやび", "text": "つばめちゃんと見つけちまった"},
        { "location": "125/TALK"   , "narrator": "みやび", "text": "怪我した小鳥さんじゃ"},
        { "location": "127/SEL"    , "narrator": "", "text": "ずっと気になってた"},
        { "location": "128/SEL"    , "narrator": "", "text": "みやびは優しいね"},
        { "location": "129/SEL"    , "narrator": "", "text": "飼わなかったんだ？"},
        { "location": "130/ACT"    , "narrator": "", "text": "ずっと気になってた"},
        { "location": "132/TALK"   , "narrator": "みやび", "text": "さよけ"},
        { "location": "133/TALK"   , "narrator": "みやび", "text": "なら"},
        { "location": "134/TALK"   , "narrator": "みやび", "text": "もっと早く言うべきだったな"},
        { "location": "135/TALK"   , "narrator": "みやび", "text": "許せ相棒"},
        { "location": "136/ACT"    , "narrator": "", "text": "みやびは優しいね"},
        { "location": "137/TALK"   , "narrator": "みやび", "text": "そうでもない"},
        { "location": "138/TALK"   , "narrator": "みやび", "text": "あれは"},
        { "location": "139/TALK"   , "narrator": "みやび", "text": "このみやびさんでなくとも"},
        { "location": "140/TALK"   , "narrator": "みやび", "text": "誰でもそうした"},
        { "location": "141/TALK"   , "narrator": "みやび", "text": "怪我した小鳥を放っておけるような薄情なやつは"},
        { "location": "142/TALK"   , "narrator": "みやび", "text": "そうそうはおらんろ"},
        { "location": "143/ACT"    , "narrator": "", "text": "飼わなかったんだ？"},
        { "location": "146/TALK"   , "narrator": "みやび", "text": "生物を飼うとか"},
        { "location": "147/TALK"   , "narrator": "みやび", "text": "そんな責任は"},
        { "location": "148/TALK"   , "narrator": "みやび", "text": "うちには背負えん"}
    ]
}
