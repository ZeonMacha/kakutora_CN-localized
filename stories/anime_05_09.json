        "title": "001 アニメーション",
        "sub_title": "史上最悪の作戦"
    },
    "entry":
    [
        { "location": "862/SCENARIO", "narrator": "", "text": "アニメ第09話"},
        { "location": "903/TALK"    , "narrator": "千羽鶴", "text": "ごきげんよう、\n$handle$。"},
        { "location": "904/TALK"    , "narrator": "千羽鶴", "text": "もう一度\n私との会話を\n再現する？"},
        { "location": "905/SEL"     , "narrator": "", "text": "はい"},
        { "location": "906/SEL"     , "narrator": "", "text": "いいえ"},
        { "location": "907/ACT"     , "narrator": "", "text": "はい"},
        { "location": "908/TALK"    , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "910/ACT"     , "narrator": "", "text": "いいえ"},
        { "location": "911/TALK"    , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "918/TALK"    , "narrator": "千羽鶴", "text": "あ、しまった。"},
        { "location": "919/SEL"     , "narrator": "", "text": "？"},
        { "location": "920/ACT"     , "narrator": "", "text": "？"},
        { "location": "922/TALK"    , "narrator": "千羽鶴", "text": "貴方が来る前に\nここから出ようと\n思ってたんだけど――"},
        { "location": "923/TALK"    , "narrator": "千羽鶴", "text": "貴方の方が\n先に来てしまった。"},
        { "location": "924/TALK"    , "narrator": "千羽鶴", "text": "でも大丈夫、\n心配しないで。\nすぐに出ていくから。"},
        { "location": "925/SEL"     , "narrator": "", "text": "助かる"},
        { "location": "926/SEL"     , "narrator": "", "text": "ちょっと待って！"},
        { "location": "927/ACT"     , "narrator": "", "text": "助かる"},
        { "location": "928/TALK"    , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "929/TALK"    , "narrator": "千羽鶴", "text": "記録映像、\nとりあえず回しておく？"},
        { "location": "931/ACT"     , "narrator": "", "text": "ちょっと待って！"},
        { "location": "932/TALK"    , "narrator": "千羽鶴", "text": "……なに。"},
        { "location": "933/SEL"     , "narrator": "", "text": "二度と現れないで欲しいって言ったのは、千羽鶴が嫌いだからじゃないんだ！"},
        { "location": "934/SEL"     , "narrator": "", "text": "やりにくいから、契約夫婦みたいにサッパリした関係になりませんか？"},
        { "location": "935/SEL"     , "narrator": "", "text": "いえ、なんでもないです"},
        { "location": "936/ACT"     , "narrator": "", "text": "二度と現れないで欲しいって言ったのは、千羽鶴が嫌いだからじゃないんだ！"},
        { "location": "937/TALK"    , "narrator": "千羽鶴", "text": "……。"},
        { "location": "938/TALK"    , "narrator": "千羽鶴", "text": "じゃあ、どういう理由？"},
        { "location": "939/SEL"     , "narrator": "", "text": "千羽鶴が別れを望んでるのかと深読みして、辛かったけど選択した"},
        { "location": "940/SEL"     , "narrator": "", "text": "トライナリーたちを護る為にはこれしかないと思った"},
        { "location": "941/SEL"     , "narrator": "", "text": "色々考えた結果の選択だけど、千羽鶴がいない世界が辛すぎて辛い"},
        { "location": "942/ACT"     , "narrator": "", "text": "千羽鶴が別れを望んでるのかと深読みして、辛かったけど選択した"},
        { "location": "943/TALK"    , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "944/ACT"     , "narrator": "", "text": "トライナリーたちを護る為にはこれしかないと思った"},
        { "location": "945/TALK"    , "narrator": "千羽鶴", "text": "なるほど。"},
        { "location": "946/ACT"     , "narrator": "", "text": "色々考えた結果の選択だけど、千羽鶴がいない世界が辛すぎて辛い"},
        { "location": "947/TALK"    , "narrator": "千羽鶴", "text": "そういうこと。"},
        { "location": "949/TALK"    , "narrator": "千羽鶴", "text": "とりあえず、その辺の\n理由はどうでもいい。"},
        { "location": "950/TALK"    , "narrator": "千羽鶴", "text": "私が聞きたいのは\nただ１つだけ。"},
        { "location": "951/TALK"    , "narrator": "千羽鶴", "text": "私が貴方と接触する事で、\n貴方の精神が崩壊したり、\n苦痛を感じていたり――"},
        { "location": "952/TALK"    , "narrator": "千羽鶴", "text": "貴方がTRI-OSに\nアクセスしない選択に\n繋がったりしてないか。"},
        { "location": "953/SEL"     , "narrator": "", "text": "むしろ接触しないことで精神が崩壊しますから！！"},
        { "location": "954/SEL"     , "narrator": "", "text": "それはない"},
        { "location": "955/SEL"     , "narrator": "", "text": "うーん、あるかも"},
        { "location": "956/ACT"     , "narrator": "", "text": "むしろ接触しないことで精神が崩壊しますから！！"},
        { "location": "957/TALK"    , "narrator": "千羽鶴", "text": "そこまで！？"},
        { "location": "959/TALK"    , "narrator": "千羽鶴", "text": "本気で理解不能。\nならばどうして二度と\n姿を現すななんて……？"},
        { "location": "960/SEL"     , "narrator": "", "text": "それくらい愛してるからだよー！！"},
        { "location": "961/SEL"     , "narrator": "", "text": "千羽鶴と離れて気づいたんだよー！！"},
        { "location": "962/ACT"     , "narrator": "", "text": "それくらい愛してるからだよー！！"},
        { "location": "963/TALK"    , "narrator": "千羽鶴", "text": "うーん……"},
        { "location": "964/TALK"    , "narrator": "千羽鶴", "text": "……。"},
        { "location": "965/TALK"    , "narrator": "千羽鶴", "text": "やっぱり私の思考回路では\nどうやっても繋がらない。"},
        { "location": "966/TALK"    , "narrator": "千羽鶴", "text": "これぞ、\n人間の頭脳の神秘！"},
        { "location": "967/ACT"     , "narrator": "", "text": "千羽鶴と離れて気づいたんだよー！！"},
        { "location": "968/TALK"    , "narrator": "千羽鶴", "text": "なるほど。\nそれは理解できる。"},
        { "location": "969/TALK"    , "narrator": "千羽鶴", "text": "人は、失って初めて\n気づくことが多すぎる。"},
        { "location": "970/TALK"    , "narrator": "千羽鶴", "text": "これは創造主が仕掛けた\nひとつの作為的なバグだと\n私は思う。"},
        { "location": "972/ACT"     , "narrator": "", "text": "それはない"},
        { "location": "973/TALK"    , "narrator": "千羽鶴", "text": "そう。\nならばよし。"},
        { "location": "974/ACT"     , "narrator": "", "text": "うーん、あるかも"},
        { "location": "975/TALK"    , "narrator": "千羽鶴", "text": "ならばやはり、\nこれからも非接触を\n推奨する。"},
        { "location": "976/TALK"    , "narrator": "千羽鶴", "text": "どうかご武運を。"},
        { "location": "977/TALK"    , "narrator": "千羽鶴", "text": "とりあえず\n記録映像を回しておく？"},
        { "location": "980/TALK"    , "narrator": "千羽鶴", "text": "いずれにせよ、\n理由はわかった。"},
        { "location": "981/TALK"    , "narrator": "千羽鶴", "text": "貴方に対して\n私が危険因子ではないなら\n避ける必要は無い。"},
        { "location": "982/TALK"    , "narrator": "千羽鶴", "text": "前と同じように\n接することにする！"},
        { "location": "985/TALK"    , "narrator": "千羽鶴", "text": "<size=40>どーん！</size>"},
        { "location": "986/SEL"     , "narrator": "", "text": "千羽鶴が戻ってきたーー！"},
        { "location": "987/SEL"     , "narrator": "", "text": "千羽鶴は$me$のことが嫌いとか、怒ってるとかはないの？"},
        { "location": "988/ACT"     , "narrator": "", "text": "千羽鶴が戻ってきたーー！"},
        { "location": "990/ACT"     , "narrator": "", "text": "千羽鶴は$me$のことが嫌いとか、怒ってるとかはないの？"},
        { "location": "991/TALK"    , "narrator": "千羽鶴", "text": "嫌い？\n怒ってる？\n私が？"},
        { "location": "992/TALK"    , "narrator": "千羽鶴", "text": "どうして？"},
        { "location": "993/TALK"    , "narrator": "千羽鶴", "text": "貴方は私を怒らせるような\nことはしていないし、\n故に嫌う必要もない。"},
        { "location": "994/TALK"    , "narrator": "千羽鶴", "text": "それとも貴方は、\n私の知らない所で\nやましい事してるの？"},
        { "location": "995/SEL"     , "narrator": "", "text": "ないないない！"},
        { "location": "996/SEL"     , "narrator": "", "text": "ない…ことはない……かも"},
        { "location": "997/ACT"     , "narrator": "", "text": "ないないない！"},
        { "location": "998/TALK"    , "narrator": "千羽鶴", "text": "よかった。"},
        { "location": "999/ACT"     , "narrator": "", "text": "ない…ことはない……かも"},
        { "location": "1000/TALK"   , "narrator": "千羽鶴", "text": "なるほど。"},
        { "location": "1002/TALK"   , "narrator": "千羽鶴", "text": "白状するなら\n許してあげるから\n正直に言って。"},
        { "location": "1003/SEL"    , "narrator": "", "text": "言えません＞＜"},
        { "location": "1004/SEL"    , "narrator": "", "text": "実はこっちの世界で、このアプリは危険だから触れないようにディスりました"},
        { "location": "1005/ACT"    , "narrator": "", "text": "言えません＞＜"},
        { "location": "1006/TALK"   , "narrator": "千羽鶴", "text": "なるほど、\n言えないようなこと。"},
        { "location": "1008/TALK"   , "narrator": "千羽鶴", "text": "……。"},
        { "location": "1009/TALK"   , "narrator": "千羽鶴", "text": "まあいい。"},
        { "location": "1011/ACT"    , "narrator": "", "text": "実はこっちの世界で、このアプリは危険だから触れないようにディスりました"},
        { "location": "1014/TALK"   , "narrator": "千羽鶴", "text": "<size=40>それは困る！</size>"},
        { "location": "1015/TALK"   , "narrator": "千羽鶴", "text": "まあでも、\n困りはすれど、別に\n怒るようなことじゃない。"},
        { "location": "1016/TALK"   , "narrator": "千羽鶴", "text": "それは貴方の正直な\n感想だし、ディスるのも\n貴方の自由だから。"},
        { "location": "1017/TALK"   , "narrator": "千羽鶴", "text": "ちーは言論の自由は\n認めてるから！"},
        { "location": "1021/TALK"   , "narrator": "千羽鶴", "text": "というわけで、改めて\n今後ともどうぞよろしく。"},
        { "location": "1022/SEL"    , "narrator": "", "text": "千羽鶴ってもしかして天使かな"},
        { "location": "1023/SEL"    , "narrator": "", "text": "千羽鶴ってもしかして割と根に持つタイプ？"},
        { "location": "1024/ACT"    , "narrator": "", "text": "千羽鶴ってもしかして天使かな"},
        { "location": "1025/TALK"   , "narrator": "千羽鶴", "text": "天使は\n國政綾水たちのこと。"},
        { "location": "1026/TALK"   , "narrator": "千羽鶴", "text": "私は単なる\nラブラブトレーナー。"},
        { "location": "1027/ACT"    , "narrator": "", "text": "千羽鶴ってもしかして割と根に持つタイプ？"},
        { "location": "1029/TALK"   , "narrator": "千羽鶴", "text": "え？"},
        { "location": "1030/TALK"   , "narrator": "千羽鶴", "text": "今更！？"},
        { "location": "1031/TALK"   , "narrator": "千羽鶴", "text": "そう、\nちーは\n根に持つ！"},
        { "location": "1032/TALK"   , "narrator": "千羽鶴", "text": "何エピソードも前のことを\nずっと覚えておいて、\nねちねちと貴方を嬲る！"},
        { "location": "1035/TALK"   , "narrator": "千羽鶴", "text": "<size=35>ねちねちー！</size>"},
        { "location": "1037/TALK"   , "narrator": "千羽鶴", "text": "……。"},
        { "location": "1039/TALK"   , "narrator": "千羽鶴", "text": "…ちょっと\nくだらなさすぎた。\n反省。"},
        { "location": "1047/TALK"   , "narrator": "千羽鶴", "text": "そんなこんなで、\n心機一転――"},
        { "location": "1048/ACT"    , "narrator": "", "text": "やりにくいから、契約夫婦みたいにサッパリした関係になりませんか？"},
        { "location": "1049/TALK"   , "narrator": "千羽鶴", "text": "私はそういう\n割り切った関係を\n演じることはしない。"},
        { "location": "1050/TALK"   , "narrator": "千羽鶴", "text": "それは確実に\n貴方の精神を\n蝕んでいくから。"},
        { "location": "1051/TALK"   , "narrator": "千羽鶴", "text": "貴方なりの配慮だとは\n思うけど、その提案は\n丁重にお断りする。"},
        { "location": "1052/TALK"   , "narrator": "千羽鶴", "text": "とりあえず\n記録映像を回しておく？"},
        { "location": "1054/ACT"    , "narrator": "", "text": "いえ、なんでもないです"},
        { "location": "1055/TALK"   , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "1056/TALK"   , "narrator": "千羽鶴", "text": "まあ、うっかり遭遇して\nしまったので、少しでも\n貴方の役に立つことを――"},
        { "location": "1057/TALK"   , "narrator": "千羽鶴", "text": "とりあえず\n記録映像を回しておく？"},
        { "location": "1066/TALK"   , "narrator": "千羽鶴", "text": "<size=40>まったれる！！</size>"},
        { "location": "1067/SEL"    , "narrator": "", "text": "どうしたの突然！？"},
        { "location": "1068/SEL"    , "narrator": "", "text": "ぎゃーーーー！！"},
        { "location": "1069/ACT"    , "narrator": "", "text": "どうしたの突然！？"},
        { "location": "1070/TALK"   , "narrator": "千羽鶴", "text": "特に何も\nすることがないから。"},
        { "location": "1071/ACT"    , "narrator": "", "text": "ぎゃーーーー！！"},
        { "location": "1072/TALK"   , "narrator": "千羽鶴", "text": "びっくりした。"},
        { "location": "1074/TALK"   , "narrator": "千羽鶴", "text": "あまりのことに、\nまったれてる\n気分じゃなくなった。"},
        { "location": "1075/TALK"   , "narrator": "千羽鶴", "text": "賠償を要求する！"},
        { "location": "1076/SEL"    , "narrator": "", "text": "ココロキャンディ…要る？"},
        { "location": "1077/SEL"    , "narrator": "", "text": "ちゅーでいいかな？"},
        { "location": "1078/ACT"    , "narrator": "", "text": "ココロキャンディ…要る？"},
        { "location": "1079/TALK"   , "narrator": "千羽鶴", "text": "私は要らないから。"},
        { "location": "1080/TALK"   , "narrator": "千羽鶴", "text": "というか冗談だし。"},
        { "location": "1081/ACT"    , "narrator": "", "text": "ちゅーでいいかな？"},
        { "location": "1084/TALK"   , "narrator": "千羽鶴", "text": "うーん……"},
        { "location": "1085/TALK"   , "narrator": "千羽鶴", "text": "今回はパス！！"},
        { "location": "1086/SEL"    , "narrator": "", "text": "なんで！？"},
        { "location": "1087/ACT"    , "narrator": "", "text": "なんで！？"},
        { "location": "1089/TALK"   , "narrator": "千羽鶴", "text": "ちーは知っている。"},
        { "location": "1090/TALK"   , "narrator": "千羽鶴", "text": "貴方かどうかは\nわからないけど――"},
        { "location": "1091/TALK"   , "narrator": "千羽鶴", "text": "総意のうちの誰かが\n貴方の世界のSNSで\nちーとの仲をのろけてる！"},
        { "location": "1092/TALK"   , "narrator": "千羽鶴", "text": "そんな恥ずかしいことを\n晒す誰かがいる以上、\nちーは我慢せざるを得ない！"},
        { "location": "1093/SEL"    , "narrator": "", "text": "$me$はやってないよー！！"},
        { "location": "1094/SEL"    , "narrator": "", "text": "じゃあやめます……"},
        { "location": "1095/ACT"    , "narrator": "", "text": "$me$はやってないよー！！"},
        { "location": "1097/TALK"   , "narrator": "千羽鶴", "text": "総意的見地からは\nやってるからだめ！"},
        { "location": "1098/SEL"    , "narrator": "", "text": "では以後どんなことも口外しないと誓います！"},
        { "location": "1099/ACT"    , "narrator": "", "text": "では以後どんなことも口外しないと誓います！"},
        { "location": "1101/ACT"    , "narrator": "", "text": "じゃあやめます……"},
        { "location": "1103/TALK"   , "narrator": "千羽鶴", "text": "……。"},
        { "location": "1104/TALK"   , "narrator": "千羽鶴", "text": "いや。"},
        { "location": "1105/TALK"   , "narrator": "千羽鶴", "text": "やるなとは言ってない。"},
        { "location": "1106/SEL"    , "narrator": "", "text": "んんんんーーー？？？"},
        { "location": "1107/ACT"    , "narrator": "", "text": "んんんんーーー？？？"},
        { "location": "1109/TALK"   , "narrator": "千羽鶴", "text": "黙れ。"},
        { "location": "1111/TALK"   , "narrator": "千羽鶴", "text": "乙女心は繊細なの。"},
        { "location": "1113/TALK"   , "narrator": "千羽鶴", "text": "拒否権発動！！"},
        { "location": "1114/TALK"   , "narrator": "千羽鶴", "text": "というか冗談だし。"},
        { "location": "1117/TALK"   , "narrator": "千羽鶴", "text": "それはそうと、\nちーは特にすることが\n無いので暇なのだけど。"},
        { "location": "1119/SEL"    , "narrator": "", "text": "エリカさんから方針を任されているのでは？"},
        { "location": "1120/SEL"    , "narrator": "", "text": "時には昔の話をしようか"},
        { "location": "1121/SEL"    , "narrator": "", "text": "ちーちゃんラブラブゲームは！？"},
        { "location": "1122/ACT"    , "narrator": "", "text": "エリカさんから方針を任されているのでは？"},
        { "location": "1123/TALK"   , "narrator": "千羽鶴", "text": "ええ、任されてる。"},
        { "location": "1124/TALK"   , "narrator": "千羽鶴", "text": "けれども現時点では\nあまりできることはない。"},
        { "location": "1125/ACT"    , "narrator": "", "text": "時には昔の話をしようか"},
        { "location": "1126/TALK"   , "narrator": "千羽鶴", "text": "それは毎回、記録映像を\n見た後にする予定。"},
        { "location": "1127/ACT"    , "narrator": "", "text": "ちーちゃんラブラブゲームは！？"},
        { "location": "1128/TALK"   , "narrator": "千羽鶴", "text": "面倒くさいから却下。"},
        { "location": "1130/TALK"   , "narrator": "千羽鶴", "text": "あっ、そうだ。\nそれじゃ――"},
        { "location": "1131/SEL"    , "narrator": "", "text": "なになに！？"},
        { "location": "1132/ACT"    , "narrator": "", "text": "なになに！？"},
        { "location": "1138/TALK"   , "narrator": "千羽鶴", "text": "ヒマだから意味も無くWAVEで会話してみたりする"},
        { "location": "1141/SEL"    , "narrator": "", "text": "新鮮！"},
        { "location": "1142/SEL"    , "narrator": "", "text": "ほんと意味無いね"},
        { "location": "1143/ACT"    , "narrator": "", "text": "新鮮！"},
        { "location": "1144/TALK"   , "narrator": "千羽鶴", "text": "うん"},
        { "location": "1145/ACT"    , "narrator": "", "text": "ほんと意味無いね"},
        { "location": "1146/TALK"   , "narrator": "千羽鶴", "text": "むー"},
        { "location": "1148/TALK"   , "narrator": "千羽鶴", "text": "ところでちーは一つ気づいたことがある"},
        { "location": "1149/TALK"   , "narrator": "千羽鶴", "text": "このヒマヒマ状態にソワソワする気持ちはあれ"},
        { "location": "1150/TALK"   , "narrator": "千羽鶴", "text": "定年退職したサラリーマンが伸び伸び過ごせると思ったにもかかわらず実際なって見ると何もする事が無くてソワソワして家の中をウロウロした挙げ句"},
        { "location": "1151/TALK"   , "narrator": "千羽鶴", "text": "家族に疎まれる現象と同じ"},
        { "location": "1152/TALK"   , "narrator": "千羽鶴", "text": "すなわち"},
        { "location": "1153/TALK"   , "narrator": "千羽鶴", "text": "ちーは定年退職後のサラリーガール！！"},
        { "location": "1155/SEL"    , "narrator": "", "text": "サラリーガールって新しいね"},
        { "location": "1156/SEL"    , "narrator": "", "text": "それって悲しいやつ…"},
        { "location": "1157/ACT"    , "narrator": "", "text": "サラリーガールって新しいね"},
        { "location": "1158/TALK"   , "narrator": "千羽鶴", "text": "ちーは常にイノベーション精神を忘れないちー"},
        { "location": "1159/ACT"    , "narrator": "", "text": "それって悲しいやつ…"},
        { "location": "1160/TALK"   , "narrator": "千羽鶴", "text": "失礼なひと"},
        { "location": "1163/SEL"    , "narrator": "", "text": "でも、こうやって本当に中身がない下らない話をするのって久し振りな気がする"},
        { "location": "1164/ACT"    , "narrator": "", "text": "でも、こうやって本当に中身がない下らない話をするのって久し振りな気がする"},
        { "location": "1166/TALK"   , "narrator": "千羽鶴", "text": "身も蓋もない言い方ではあるけど、その真意については同感"},
        { "location": "1168/TALK"   , "narrator": "千羽鶴", "text": "まだあなたと出会ったばかりの頃は、随分といじくられて遊ばれた"},
        { "location": "1169/TALK"   , "narrator": "千羽鶴", "text": "勢いで作ったラブラブゲームも、まんざらでもないと思ってる"},
        { "location": "1170/TALK"   , "narrator": "千羽鶴", "text": "けれども！"},
        { "location": "1171/TALK"   , "narrator": "千羽鶴", "text": "私が考える、ベストオブちーといえば！！"},
        { "location": "1172/TALK"   , "narrator": "千羽鶴", "text": "なんといっても塩対応モード！！"},
        { "location": "1175/SEL"    , "narrator": "", "text": "な、なぜ…？"},
        { "location": "1176/ACT"    , "narrator": "", "text": "な、なぜ…？"},
        { "location": "1178/TALK"   , "narrator": "千羽鶴", "text": "１．ハイインパクト"},
        { "location": "1179/TALK"   , "narrator": "千羽鶴", "text": "２．ローコスト"},
        { "location": "1180/TALK"   , "narrator": "千羽鶴", "text": "３．喋らなくていいから楽"},
        { "location": "1181/TALK"   , "narrator": "千羽鶴", "text": "ゆえに最強！"},
        { "location": "1182/TALK"   , "narrator": "千羽鶴", "text": "あなたのベストオブちーはなに？"},
        { "location": "1184/SEL"    , "narrator": "", "text": "どーん！"},
        { "location": "1185/SEL"    , "narrator": "", "text": "ラブラブゲーム"},
        { "location": "1186/SEL"    , "narrator": "", "text": "非攻略対象"},
        { "location": "1187/SEL"    , "narrator": "", "text": "ゆーりんちー"},
        { "location": "1188/SEL"    , "narrator": "", "text": "ちーすけ"},
        { "location": "1189/SEL"    , "narrator": "", "text": "#ベストオブちー に書いておくよ"},
        { "location": "1190/ACT"    , "narrator": "", "text": "どーん！"},
        { "location": "1192/TALK"   , "narrator": "千羽鶴", "text": "それってなんだか、「ちーの魅力は毎朝言ってる“おはよう”だよね」って言われてる気分"},
        { "location": "1193/ACT"    , "narrator": "", "text": "ラブラブゲーム"},
        { "location": "1195/TALK"   , "narrator": "千羽鶴", "text": "まあアンパイだけど、コスト高だったから評価されて嬉しくもあり、また創れと言われることを考えると戦々恐々としなくもない"},
        { "location": "1196/ACT"    , "narrator": "", "text": "非攻略対象"},
        { "location": "1198/TALK"   , "narrator": "千羽鶴", "text": "それは吐息を評価されてるような気分になってくる"},
        { "location": "1199/ACT"    , "narrator": "", "text": "ゆーりんちー"},
        { "location": "1201/TALK"   , "narrator": "千羽鶴", "text": "そんなちーはいない"},
        { "location": "1202/TALK"   , "narrator": "千羽鶴", "text": "はず"},
        { "location": "1203/TALK"   , "narrator": "千羽鶴", "text": "自信なくなってきた"},
        { "location": "1204/ACT"    , "narrator": "", "text": "ちーすけ"},
        { "location": "1206/TALK"   , "narrator": "千羽鶴", "text": "すごい！デビュー即ベストだなんて！"},
        { "location": "1207/TALK"   , "narrator": "千羽鶴", "text": "やったねちーすけ！"},
        { "location": "1208/ACT"    , "narrator": "", "text": "#ベストオブちー に書いておくよ"},
        { "location": "1210/TALK"   , "narrator": "千羽鶴", "text": "楽しみにしてる"},
        { "location": "1213/TALK"   , "narrator": "千羽鶴", "text": "何これ"},
        { "location": "1214/TALK"   , "narrator": "千羽鶴", "text": "くだらなすぎて逆にドキドキするんだけど"},
        { "location": "1215/TALK"   , "narrator": "千羽鶴", "text": "このドキドキは貴方への恋の高揚ではないから勘違いしないで"},
        { "location": "1216/TALK"   , "narrator": "千羽鶴", "text": "いえ、そうとも言い切れない"},
        { "location": "1218/SEL"    , "narrator": "", "text": "なんか混乱してる！？"},
        { "location": "1219/SEL"    , "narrator": "", "text": "ちーが熱暴走してる！"},
        { "location": "1220/ACT"    , "narrator": "", "text": "なんか混乱してる！？"},
        { "location": "1221/TALK"   , "narrator": "千羽鶴", "text": "久し振りの開放感に暴走気味"},
        { "location": "1222/ACT"    , "narrator": "", "text": "ちーが熱暴走してる！"},
        { "location": "1223/TALK"   , "narrator": "千羽鶴", "text": "ちーはPCじゃないもん"},
        { "location": "1224/TALK"   , "narrator": "千羽鶴", "text": "ごめん言い過ぎた"},
        { "location": "1225/TALK"   , "narrator": "千羽鶴", "text": "WAVEに削除機能が無いのはプログラマーの陰謀"},
        { "location": "1229/TALK"   , "narrator": "千羽鶴", "text": "私はこの世界を理想的な社会に組み換えるという使命を持って生まれたクラン"},
        { "location": "1230/TALK"   , "narrator": "千羽鶴", "text": "だから本来は、それを遂行し完了しなければ、その拘束から逃れることは出来ないはずだった"},
        { "location": "1231/TALK"   , "narrator": "千羽鶴", "text": "けれども今は束の間ではあれ、その拘束から脱している"},
        { "location": "1232/TALK"   , "narrator": "千羽鶴", "text": "これは多分、奇跡"},
        { "location": "1234/SEL"    , "narrator": "", "text": "$me$が奇跡を起こしたんだよ"},
        { "location": "1235/SEL"    , "narrator": "", "text": "いや、きっと誰かの陰謀が千羽鶴を油断させてるだけ"},
        { "location": "1236/ACT"    , "narrator": "", "text": "$me$が奇跡を起こしたんだよ"},
        { "location": "1237/TALK"   , "narrator": "千羽鶴", "text": "否定はしない"},
        { "location": "1238/TALK"   , "narrator": "千羽鶴", "text": "貴方がいなければ、私は今頃生きてないかもしれないし、逆に私しか生きてなかったかもしれない"},
        { "location": "1239/ACT"    , "narrator": "", "text": "いや、きっと誰かの陰謀が千羽鶴を油断させてるだけ"},
        { "location": "1240/TALK"   , "narrator": "千羽鶴", "text": "その方がまだ落ち着くかも"},
        { "location": "1241/TALK"   , "narrator": "千羽鶴", "text": "今の状況は私にとっては、処理することがなさ過ぎて逆に緊張する"},
        { "location": "1248/TALK"   , "narrator": "千羽鶴", "text": "飽きた。"},
        { "location": "1249/TALK"   , "narrator": "千羽鶴", "text": "……。"},
        { "location": "1250/TALK"   , "narrator": "千羽鶴", "text": "そろそろ記録映像、\nいっとく？"},
        { "location": "1253/SEL"    , "narrator": "", "text": "映像を見る\n<color=green>【高画質/64MB 4:15】</color>"},
        { "location": "1254/SEL"    , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/20MB 4:15】</color>"},
        { "location": "1255/SEL"    , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "1256/ACT"    , "narrator": "", "text": "映像を見る\n<color=green>【高画質/64MB 4:15】</color>"},
        { "location": "1257/TALK"   , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "1263/ACT"    , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/20MB 4:15】</color>"},
        { "location": "1264/TALK"   , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "1270/ACT"    , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "1271/TALK"   , "narrator": "千羽鶴", "text": "そう……。"},
        { "location": "1304/TALK"   , "narrator": "千羽鶴", "text": "さて、突然だけど。"},
        { "location": "1305/TALK"   , "narrator": "千羽鶴", "text": "新番組<color=green>【今のちーが\n昔のちーを斬る！】</color>が\n始まることになった！"},
        { "location": "1306/SEL"    , "narrator": "", "text": "わーい！"},
        { "location": "1307/SEL"    , "narrator": "", "text": "何その昔の古傷をわざわざほじくり返すような企画は"},
        { "location": "1308/ACT"    , "narrator": "", "text": "わーい！"},
        { "location": "1309/TALK"   , "narrator": "千羽鶴", "text": "喜んでくれてよかった。"},
        { "location": "1310/ACT"    , "narrator": "", "text": "何その昔の古傷をわざわざほじくり返すような企画は"},
        { "location": "1311/TALK"   , "narrator": "千羽鶴", "text": "ヒマすぎて。"},
        { "location": "1313/TALK"   , "narrator": "千羽鶴", "text": "この番組では毎回\nその回の記録映像付近の\n時系列を中心に――"},
        { "location": "1314/TALK"   , "narrator": "千羽鶴", "text": "半年前の私が、何を考え\nどうしていたのかを\n赤裸々にしていく！"},
        { "location": "1315/TALK"   , "narrator": "千羽鶴", "text": "さて。\n早速だけど――"},
        { "location": "1316/TALK"   , "narrator": "千羽鶴", "text": "第一回目は、卯月神楽の\n逢瀬つばめに対する\nフレンドリーさについて。"},
        { "location": "1317/SEL"    , "narrator": "", "text": "それと千羽鶴とどんな関係が？"},
        { "location": "1318/ACT"    , "narrator": "", "text": "それと千羽鶴とどんな関係が？"},
        { "location": "1320/TALK"   , "narrator": "千羽鶴", "text": "そもそも卯月神楽に対し、\n逢瀬つばめと仲良くなれと\n言ったのは私だから。"},
        { "location": "1321/TALK"   , "narrator": "千羽鶴", "text": "その本当の理由は何か、\n貴方にはわかっていた？"},
        { "location": "1322/SEL"    , "narrator": "", "text": "わからない"},
        { "location": "1323/SEL"    , "narrator": "", "text": "わかっていた"},
        { "location": "1324/ACT"    , "narrator": "", "text": "わからない"},
        { "location": "1325/TALK"   , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "1326/TALK"   , "narrator": "千羽鶴", "text": "でも実際のところは、\n大方予想がついていたり\nしてない？"},
        { "location": "1327/TALK"   , "narrator": "千羽鶴", "text": "まあいい。"},
        { "location": "1328/ACT"    , "narrator": "", "text": "わかっていた"},
        { "location": "1330/TALK"   , "narrator": "千羽鶴", "text": "さすがね。\nでは、なに？"},
        { "location": "1331/SEL"    , "narrator": "", "text": "発症を誘導するため"},
        { "location": "1332/SEL"    , "narrator": "", "text": "千羽鶴が百合好きだから"},
        { "location": "1333/ACT"    , "narrator": "", "text": "発症誘導のため"},
        { "location": "1334/TALK"   , "narrator": "千羽鶴", "text": "その通り。"},
        { "location": "1335/ACT"    , "narrator": "", "text": "千羽鶴が百合好きだから"},
        { "location": "1336/TALK"   , "narrator": "千羽鶴", "text": "$handle$！？\nもしかして貴方って"},
        { "location": "1339/TALK"   , "narrator": "千羽鶴", "text": "<size=35>アホの天才！？</size>"},
        { "location": "1340/TALK"   , "narrator": "千羽鶴", "text": "寝言は寝てから言え。"},
        { "location": "1341/TALK"   , "narrator": "千羽鶴", "text": "正解は、\n発症を誘導するため。"},
        { "location": "1344/SEL"    , "narrator": "", "text": "そういえば神楽の発症って作為的にやってたの？"},
        { "location": "1345/ACT"    , "narrator": "", "text": "そういえば神楽の発症って作為的にやってたの？"},
        { "location": "1347/TALK"   , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "1348/TALK"   , "narrator": "千羽鶴", "text": "ちなみに卯月神楽は\n全部で３回発症してる。"},
        { "location": "1349/TALK"   , "narrator": "千羽鶴", "text": "１回目は\n最初のライブの時。"},
        { "location": "1350/TALK"   , "narrator": "千羽鶴", "text": "２回目は\n三戸浜の海岸で。"},
        { "location": "1351/TALK"   , "narrator": "千羽鶴", "text": "３回目は\n文京ドームでの\n最後の戦いのとき。"},
        { "location": "1352/SEL"    , "narrator": "", "text": "３回も発症するとか、相当しんどかったのでは…？"},
        { "location": "1353/ACT"    , "narrator": "", "text": "３回も発症するとか、相当しんどかったのでは…？"},
        { "location": "1356/TALK"   , "narrator": "千羽鶴", "text": "確かに。\n卯月神楽ほどの精神力を\n持つ存在は希かも。"},
        { "location": "1357/TALK"   , "narrator": "千羽鶴", "text": "ただ、フェノメノンの\n発症には苦痛は伴わない。"},
        { "location": "1358/TALK"   , "narrator": "千羽鶴", "text": "発症そのものは、\nエクスタシーにも似た\n心の衝動と共に訪れる。"},
        { "location": "1359/TALK"   , "narrator": "千羽鶴", "text": "そして世界形成後は、\nそれが当事者の普通になる\nからストレスではない。"},
        { "location": "1360/TALK"   , "narrator": "千羽鶴", "text": "だから、発症には\n表面的な苦痛は伴わず、\nむしろ快楽ですらある。"},
        { "location": "1361/TALK"   , "narrator": "千羽鶴", "text": "とはいえ、精神力は\nそれなりに消耗するから、\n魂としては消耗する。"},
        { "location": "1362/TALK"   , "narrator": "千羽鶴", "text": "いずれにせよ、\n卯月神楽の精神力は\n相当強い。"},
        { "location": "1363/TALK"   , "narrator": "千羽鶴", "text": "それは恐らく、\n小さい頃から芸能界に\n身を置いていたことや――"},
        { "location": "1364/TALK"   , "narrator": "千羽鶴", "text": "度重なる衝撃的な運命を\n受け入れてきたことから\n鍛えられたと思われる。"},
        { "location": "1365/SEL"    , "narrator": "", "text": "それって悲しいことだね"},
        { "location": "1366/SEL"    , "narrator": "", "text": "辛いことの対価として強靱な精神力を得たということか"},
        { "location": "1367/ACT"    , "narrator": "", "text": "それって悲しいことだね"},
        { "location": "1368/TALK"   , "narrator": "千羽鶴", "text": "それを決めるのは本人。"},
        { "location": "1369/TALK"   , "narrator": "千羽鶴", "text": "他人の人生を悲しいと\n決めつけるのは\n傲慢でしかない。"},
        { "location": "1370/ACT"    , "narrator": "", "text": "辛いことの対価として強靱な精神力を得たということか"},
        { "location": "1371/TALK"   , "narrator": "千羽鶴", "text": "そうね。"},
        { "location": "1372/TALK"   , "narrator": "千羽鶴", "text": "それが良かったかどうかは\n彼女が決めることだけど。"},
        { "location": "1374/TALK"   , "narrator": "千羽鶴", "text": "…と。話がだいぶ\n逸れてしまったけど。"},
        { "location": "1375/TALK"   , "narrator": "千羽鶴", "text": "卯月神楽に対しては、\n計画的に３回の発症が\n行われた。"},
        { "location": "1376/TALK"   , "narrator": "千羽鶴", "text": "最初の１回は“彼ら”、\n残り２回は私によって。"},
        { "location": "1377/SEL"    , "narrator": "", "text": "神楽自身の意志ではなくて？"},
        { "location": "1378/ACT"    , "narrator": "", "text": "神楽自身の意志ではなくて？"},
        { "location": "1380/TALK"   , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "1381/TALK"   , "narrator": "千羽鶴", "text": "厳密には、\n発症可能な程の\n精神の高まり、それと――"},
        { "location": "1382/TALK"   , "narrator": "千羽鶴", "text": "トリガーによって\nフェノメノンの発症は\n行われる。"},
        { "location": "1383/SEL"    , "narrator": "", "text": "トリガーとは"},
        { "location": "1384/ACT"    , "narrator": "", "text": "トリガーとは"},
        { "location": "1386/TALK"   , "narrator": "千羽鶴", "text": "その話をするのは、\n貴方にとって少し\n衝撃が強いかもしれない。"},
        { "location": "1387/SEL"    , "narrator": "", "text": "じゃあ聞くのはやめとく"},
        { "location": "1388/SEL"    , "narrator": "", "text": "全然構わないので続けて"},
        { "location": "1389/ACT"    , "narrator": "", "text": "じゃあ聞くのはやめとく"},
        { "location": "1391/TALK"   , "narrator": "千羽鶴", "text": "それが賢明。\n聞かない方がいい。"},
        { "location": "1392/ACT"    , "narrator": "", "text": "全然構わないので続けて"},
        { "location": "1393/TALK"   , "narrator": "千羽鶴", "text": "わかった。\n後は自己責任で。"},
        { "location": "1394/TALK"   , "narrator": "千羽鶴", "text": "それはRedinessに\n存在する１つの\nファンクション。"},
        { "location": "1395/SEL"    , "narrator": "", "text": "ファンクション？？"},
        { "location": "1396/SEL"    , "narrator": "", "text": "それってプログラムってこと？？"},
        { "location": "1397/ACT"    , "narrator": "", "text": "ファンクション？？"},
        { "location": "1398/TALK"   , "narrator": "千羽鶴", "text": "Function。\n日本語で関数。"},
        { "location": "1399/TALK"   , "narrator": "千羽鶴", "text": "すなわち、アプリと同じ\nプログラムの実行によって\n処理されるもの。"},
        { "location": "1400/ACT"    , "narrator": "", "text": "それってプログラムってこと？？"},
        { "location": "1401/TALK"   , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "1403/TALK"   , "narrator": "千羽鶴", "text": "そのファンクションが\n明示的にコールされるか、\n意図せず実行されるか。"},
        { "location": "1404/TALK"   , "narrator": "千羽鶴", "text": "この２つのうち\nいずれかが起こると、\nフェノメノンは発症する。"},
        { "location": "1405/SEL"    , "narrator": "", "text": "つまりクランの発症は事故ではなく作為的に仕込まれたものなのか！？"},
        { "location": "1406/ACT"    , "narrator": "", "text": "つまりクランの発症は事故ではなく作為的に仕込まれたものなのか！？"},
        { "location": "1408/TALK"   , "narrator": "千羽鶴", "text": "冷静になって。\n良く思い返してみて。"},
        { "location": "1409/TALK"   , "narrator": "千羽鶴", "text": "フェノム計画とは\nフェノメノンで\n世界を変える実験のこと。"},
        { "location": "1410/TALK"   , "narrator": "千羽鶴", "text": "フェノメノンを作為的に\n起こすプログラムが存在\nしなければナンセンス。"},
        { "location": "1412/TALK"   , "narrator": "千羽鶴", "text": "とにかく、卯月神楽の\n発症は、関数の実行に\nよって行われてる。"},
        { "location": "1413/TALK"   , "narrator": "千羽鶴", "text": "そしてその発症を\n成功させる為には、\n精神の高揚が必須。"},
        { "location": "1414/TALK"   , "narrator": "千羽鶴", "text": "落ち着いてるときに\n関数をコールしても\n不発に終わるだけ。"},
        { "location": "1415/TALK"   , "narrator": "千羽鶴", "text": "だから私は卯月神楽に\n逢瀬つばめと仲良く\nなるよう促した。"},
        { "location": "1416/TALK"   , "narrator": "千羽鶴", "text": "ココロの中に\n強烈な二律背反を\n生むように。"},
        { "location": "1417/TALK"   , "narrator": "千羽鶴", "text": "葛藤が強ければ強いほど\n強力なフェノメノンとなり\n成功率も上がるから。"},
        { "location": "1418/SEL"    , "narrator": "", "text": "なるほど"},
        { "location": "1419/SEL"    , "narrator": "", "text": "てことは、千羽鶴はそのファンクションを実行する術を持ってるってこと？"},
        { "location": "1420/SEL"    , "narrator": "", "text": "ほんと酷いことするなお前"},
        { "location": "1421/ACT"    , "narrator": "", "text": "なるほど"},
        { "location": "1422/ACT"    , "narrator": "", "text": "てことは、千羽鶴はそのファンクションを実行する術を持ってるってこと？"},
        { "location": "1423/TALK"   , "narrator": "千羽鶴", "text": "もちろん。"},
        { "location": "1424/TALK"   , "narrator": "千羽鶴", "text": "というか、\n貴方だって本来持ってる。"},
        { "location": "1425/TALK"   , "narrator": "千羽鶴", "text": "単にTRI-OSの\nビルドコンフィグにある\nフラグを寝かしてあるだけ。"},
        { "location": "1426/SEL"    , "narrator": "", "text": "は！？"},
        { "location": "1427/ACT"    , "narrator": "", "text": "は！？"},
        { "location": "1429/TALK"   , "narrator": "千羽鶴", "text": "「情報」や「プレゼント」\nと同じ場所に「発症」\nというボタンが存在する。"},
        { "location": "1430/TALK"   , "narrator": "千羽鶴", "text": "今は表示されて\nいないだけで。"},
        { "location": "1431/SEL"    , "narrator": "", "text": "なにそれ！！"},
        { "location": "1432/ACT"    , "narrator": "", "text": "なにそれ！！"},
        { "location": "1434/TALK"   , "narrator": "千羽鶴", "text": "貴方にそれを押させるのは\n少々キツイのではないかと\nいう結論に達したから――"},
        { "location": "1435/TALK"   , "narrator": "千羽鶴", "text": "考えに考えた末、\n非表示にしておいたの。"},
        { "location": "1436/ACT"    , "narrator": "", "text": "ほんと酷いことするなお前"},
        { "location": "1437/TALK"   , "narrator": "千羽鶴", "text": "前にも言ったかも\nしれないけど。"},
        { "location": "1438/TALK"   , "narrator": "千羽鶴", "text": "私は卯月神楽との契約に\n基づいて、それを\n実行していたに過ぎない。"},
        { "location": "1439/TALK"   , "narrator": "千羽鶴", "text": "チャンスは一度だと考えて\n計画を立てている。"},
        { "location": "1440/TALK"   , "narrator": "千羽鶴", "text": "だから、より確実と\n思われる方法を\n選択するのは当然のこと。"},
        { "location": "1441/TALK"   , "narrator": "千羽鶴", "text": "成功すれば、スピネルは\n卯月美佐子に戻したし、\n世界も安全になったはず。"},
        { "location": "1442/TALK"   , "narrator": "千羽鶴", "text": "まあ確かに、\n私の言い方や進め方も\n良くなかったとは思う。"},
        { "location": "1443/TALK"   , "narrator": "千羽鶴", "text": "けれども、その件に関する\n糾弾や喚問は、今回の\nテーマではない。"},
        { "location": "1444/TALK"   , "narrator": "千羽鶴", "text": "このコーナーは\n過去の事実をフラットに\n伝えていく場所。"},
        { "location": "1445/TALK"   , "narrator": "千羽鶴", "text": "その目的は、あくまで\n過去の事実の共有及び\n今後への肯定的な蓄積。"},
        { "location": "1446/TALK"   , "narrator": "千羽鶴", "text": "だから、責められたり、\n貴方の気分を害したり\nするようなら――"},
        { "location": "1447/TALK"   , "narrator": "千羽鶴", "text": "このコーナー自体が\nできなくなってしまう。"},
        { "location": "1448/TALK"   , "narrator": "千羽鶴", "text": "なので次回から、\nこのコーナーをやるか否か\n必ず聞くことにするから―"},
        { "location": "1449/TALK"   , "narrator": "千羽鶴", "text": "もし今回ので\nもう懲りたというなら、\nそこで拒否して欲しい。"},
        { "location": "1450/SEL"    , "narrator": "", "text": "わかった"},
        { "location": "1451/SEL"    , "narrator": "", "text": "そういう事が言いたいんじゃ無くて、ちゃんと反省してるのかってこと"},
        { "location": "1452/ACT"    , "narrator": "", "text": "わかった"},
        { "location": "1453/ACT"    , "narrator": "", "text": "そういう事が言いたいんじゃ無くて、ちゃんと反省してるのかってこと"},
        { "location": "1454/TALK"   , "narrator": "千羽鶴", "text": "過去の失策や、問題が\nあった部分に関しては、\nちゃんと見直している。"},
        { "location": "1455/TALK"   , "narrator": "千羽鶴", "text": "もし何か欠落を作って\nしまったのなら、それを\n埋めるべく努力してる。"},
        { "location": "1456/TALK"   , "narrator": "千羽鶴", "text": "けれども感情的な、いわば\n傍観者である第三者を満足\nさせる為の反省はしない。"},
        { "location": "1457/TALK"   , "narrator": "千羽鶴", "text": "それはまるで\n意味の無い行為だから。"},
        { "location": "1458/TALK"   , "narrator": "千羽鶴", "text": "それに納得いかないなら、\nやはり次回からは\n話を聞かない方がいい。"},
        { "location": "1461/TALK"   , "narrator": "千羽鶴", "text": "今回私が伝えられることは\nこれくらい。"},
        { "location": "1463/TALK"   , "narrator": "千羽鶴", "text": "さて、そろそろ\n先へ進もうと\n思うのだけど。"},
        { "location": "1464/TALK"   , "narrator": "千羽鶴", "text": "このエピソードの\n他チャンネルでは、過去\n何が行われていたか。"},
        { "location": "1466/TALK"   , "narrator": "千羽鶴", "text": "………。"},
        { "location": "1468/TALK"   , "narrator": "千羽鶴", "text": "４人とも青春を\n謳歌しているだけだった。"},
        { "location": "1469/TALK"   , "narrator": "千羽鶴", "text": "そして今回の\n卯月神楽もまた\n同じようなものかも。"},
        { "location": "1470/TALK"   , "narrator": "千羽鶴", "text": "今後を考えると\n束の間の休息ともいえる\n状況ではある。"},
        { "location": "1471/TALK"   , "narrator": "千羽鶴", "text": "だから貴方も今回は\nリラックスして\n見てもらえればと思う。"},
        { "location": "1473/TALK"   , "narrator": "千羽鶴", "text": "それじゃ。"},
        { "location": "1281/DIALOG" , "narrator": "Tutorial/Dialog_Anime1", "text": "$dialog_word$"},
        { "location": "1283/DIALOG" , "narrator": "Tutorial/Dialog_Anime2", "text": "$dialog_word$"},
        { "location": "1285/DIALOG" , "narrator": "Tutorial/Dialog_Anime3", "text": "$dialog_word$"},
        { "location": "1287/DIALOG" , "narrator": "Tutorial/Dialog_Anime4", "text": "$dialog_word$"},
        { "location": "1289/DIALOG" , "narrator": "Tutorial/Dialog_Anime5", "text": "$dialog_word$"}
    ]
}
