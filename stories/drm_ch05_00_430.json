    [
        { "location": "2289/SCENARIO", "narrator": "", "text": "ふりだしに戻るには"},
        { "location": "2314/TALK"    , "narrator": "神楽", "text": "全てはうたかた"},
        { "location": "2315/TALK"    , "narrator": "神楽", "text": "胡蝶の夢"},
        { "location": "2317/SEL"     , "narrator": "", "text": "そうかも"},
        { "location": "2318/SEL"     , "narrator": "", "text": "そうなのかな？"},
        { "location": "2319/SEL"     , "narrator": "", "text": "そんなことはない"},
        { "location": "2320/ACT"     , "narrator": "", "text": "そうかも"},
        { "location": "2321/TALK"    , "narrator": "神楽", "text": "そうでしょ"},
        { "location": "2322/ACT"     , "narrator": "", "text": "そうなのかな？"},
        { "location": "2323/TALK"    , "narrator": "神楽", "text": "どうかな？"},
        { "location": "2324/ACT"     , "narrator": "", "text": "そんなことはない"},
        { "location": "2325/TALK"    , "narrator": "神楽", "text": "違う？？？"},
        { "location": "2327/TALK"    , "narrator": "神楽", "text": "こうやってぴょんこと$handle$が話してることも"},
        { "location": "2328/TALK"    , "narrator": "神楽", "text": "全部全部何かがあったらおしまい"},
        { "location": "2329/TALK"    , "narrator": "神楽", "text": "あやふやであいまいなできごとなんだぴょん"},
        { "location": "2332/SEL"     , "narrator": "", "text": "そうかもしれないけど…"},
        { "location": "2333/SEL"     , "narrator": "", "text": "いや違うよ"},
        { "location": "2334/SEL"     , "narrator": "", "text": "その一瞬が大事なんだよ"},
        { "location": "2335/ACT"     , "narrator": "", "text": "そうかもしれないけど…"},
        { "location": "2336/TALK"    , "narrator": "神楽", "text": "その先は？"},
        { "location": "2337/ACT"     , "narrator": "", "text": "いや違うよ"},
        { "location": "2338/TALK"    , "narrator": "神楽", "text": "言い切れる？"},
        { "location": "2339/ACT"     , "narrator": "", "text": "その一瞬が大事なんだよ"},
        { "location": "2340/TALK"    , "narrator": "神楽", "text": "それはそう"},
        { "location": "2341/TALK"    , "narrator": "神楽", "text": "だったら"},
        { "location": "2342/TALK"    , "narrator": "神楽", "text": "どうすればいい？"},
        { "location": "2344/TALK"    , "narrator": "神楽", "text": "もういっそ全部適当に終わらせた方がいいかも"},
        { "location": "2345/TALK"    , "narrator": "神楽", "text": "その方が楽な気がする"},
        { "location": "2348/SEL"     , "narrator": "", "text": "後悔するよ"},
        { "location": "2349/SEL"     , "narrator": "", "text": "それで神楽の気が済むんなら"},
        { "location": "2350/SEL"     , "narrator": "", "text": "$me$とのことも適当にするの？"},
        { "location": "2351/ACT"     , "narrator": "", "text": "後悔するよ"},
        { "location": "2352/TALK"    , "narrator": "神楽", "text": "どうだろうね？"},
        { "location": "2353/TALK"    , "narrator": "神楽", "text": "後悔できるならまだましかも"},
        { "location": "2354/ACT"     , "narrator": "", "text": "それで神楽の気が済むんなら"},
        { "location": "2355/TALK"    , "narrator": "神楽", "text": "ぴょんこの気持ちかー"},
        { "location": "2356/TALK"    , "narrator": "神楽", "text": "自分でもよくわからないぴょん、、、"},
        { "location": "2357/ACT"     , "narrator": "", "text": "$me$とのことも適当にするの？"},
        { "location": "2358/TALK"    , "narrator": "神楽", "text": "それは"},
        { "location": "2359/TALK"    , "narrator": "神楽", "text": "そんなつもりない"},
        { "location": "2360/TALK"    , "narrator": "神楽", "text": "でも"},
        { "location": "2361/TALK"    , "narrator": "神楽", "text": "結果的にそうなるかもしれない、、、、"},
        { "location": "2362/TALK"    , "narrator": "神楽", "text": "かも"},
        { "location": "2365/SEL"     , "narrator": "", "text": "じゃあ"},
        { "location": "2366/ACT"     , "narrator": "", "text": "じゃあ"},
        { "location": "2369/SEL"     , "narrator": "", "text": "$me$の気持ちは嘘だって思ってる？"},
        { "location": "2370/SEL"     , "narrator": "", "text": "これまでの二人は偽物なの？"},
        { "location": "2371/SEL"     , "narrator": "", "text": "神楽が大事だって気持ちは否定されるの？"},
        { "location": "2372/ACT"     , "narrator": "", "text": "$me$の気持ちは嘘だって思ってる？"},
        { "location": "2373/TALK"    , "narrator": "神楽", "text": "そんなことない"},
        { "location": "2374/TALK"    , "narrator": "神楽", "text": "そんなことないけど"},
        { "location": "2375/ACT"     , "narrator": "", "text": "これまでの二人は偽物なの？"},
        { "location": "2376/TALK"    , "narrator": "神楽", "text": "それは"},
        { "location": "2377/TALK"    , "narrator": "神楽", "text": "違う"},
        { "location": "2378/ACT"     , "narrator": "", "text": "神楽が大事だって気持ちは否定されるの？"},
        { "location": "2379/TALK"    , "narrator": "神楽", "text": "否定なんかしない"},
        { "location": "2380/TALK"    , "narrator": "神楽", "text": "しないけど"},
        { "location": "2382/TALK"    , "narrator": "神楽", "text": "ぴょんこは作戦を失敗させたから"},
        { "location": "2383/TALK"    , "narrator": "神楽", "text": "計画もまた立て直すことになったし"},
        { "location": "2384/TALK"    , "narrator": "神楽", "text": "ママも音羽もどうなるかわかんないし"},
        { "location": "2385/TALK"    , "narrator": "神楽", "text": "だから"},
        { "location": "2386/TALK"    , "narrator": "神楽", "text": "もう"},
        { "location": "2387/TALK"    , "narrator": "神楽", "text": "だって"},
        { "location": "2389/SEL"     , "narrator": "", "text": "まだゲームセットじゃない"},
        { "location": "2390/SEL"     , "narrator": "", "text": "立て直すなら終わってないでしょ"},
        { "location": "2391/SEL"     , "narrator": "", "text": "休んだら気持ちも変わるよ"},
        { "location": "2392/ACT"     , "narrator": "", "text": "まだゲームセットじゃない"},
        { "location": "2393/TALK"    , "narrator": "神楽", "text": "そうかな？"},
        { "location": "2394/TALK"    , "narrator": "神楽", "text": "でも"},
        { "location": "2395/TALK"    , "narrator": "神楽", "text": "それはそれで辛いｶﾓ、、、"},
        { "location": "2396/ACT"     , "narrator": "", "text": "立て直すなら終わってないでしょ"},
        { "location": "2397/TALK"    , "narrator": "神楽", "text": "終わってないの？"},
        { "location": "2398/TALK"    , "narrator": "神楽", "text": "終わらせたいな早く"},
        { "location": "2400/ACT"     , "narrator": "", "text": "休んだら気持ちも変わるよ"},
        { "location": "2401/TALK"    , "narrator": "神楽", "text": "立ち止まったらもう二度と動けない"},
        { "location": "2402/TALK"    , "narrator": "神楽", "text": "そんな気分だから"},
        { "location": "2403/TALK"    , "narrator": "神楽", "text": "ちょっと無理かな"},
        { "location": "2406/SEL"     , "narrator": "", "text": "$me$が何かできればいいけど"},
        { "location": "2407/SEL"     , "narrator": "", "text": "一人で抱え込まないで"},
        { "location": "2408/SEL"     , "narrator": "", "text": "八つ当たりとかしてくれていいよ"},
        { "location": "2409/ACT"     , "narrator": "", "text": "$me$が何かできればいいけど"},
        { "location": "2413/ACT"     , "narrator": "", "text": "一人で抱え込まないで"},
        { "location": "2414/TALK"    , "narrator": "神楽", "text": "ﾇｳｳｳｳｳ、、、"},
        { "location": "2416/ACT"     , "narrator": "", "text": "八つ当たりとかしてくれていいよ"},
        { "location": "2417/TALK"    , "narrator": "神楽", "text": "ぴょんこそんなことしませんしおすし！！！！！！！！！"},
        { "location": "2420/SEL"     , "narrator": "", "text": "神楽"},
        { "location": "2421/ACT"     , "narrator": "", "text": "神楽"},
        { "location": "2424/SEL"     , "narrator": "", "text": "無理しすぎないで"},
        { "location": "2425/SEL"     , "narrator": "", "text": "最後はきっとうまくいくよ"},
        { "location": "2426/SEL"     , "narrator": "", "text": "$me$がいるからね"},
        { "location": "2427/ACT"     , "narrator": "", "text": "無理しすぎないで"},
        { "location": "2428/TALK"    , "narrator": "神楽", "text": "うん"},
        { "location": "2430/TALK"    , "narrator": "神楽", "text": "そうしないように"},
        { "location": "2431/TALK"    , "narrator": "神楽", "text": "がんばるぴょん♪"},
        { "location": "2432/ACT"     , "narrator": "", "text": "最後はきっとうまくいくよ"},
        { "location": "2433/TALK"    , "narrator": "神楽", "text": "どんだけﾎﾟｼﾞﾃｨﾌﾞ、、、"},
        { "location": "2434/TALK"    , "narrator": "神楽", "text": "くらくらするお、、、"},
        { "location": "2435/TALK"    , "narrator": "神楽", "text": "ｽｹﾞｰな$handle$！！！！"},
        { "location": "2436/ACT"     , "narrator": "", "text": "$me$がいるからね"},
        { "location": "2437/TALK"    , "narrator": "神楽", "text": "あああああああああ"},
        { "location": "2438/TALK"    , "narrator": "神楽", "text": "なんだかなんだかなんだかなー"},
        { "location": "2439/TALK"    , "narrator": "神楽", "text": "すごいね$handle$！！！！"},
        { "location": "2440/TALK"    , "narrator": "神楽", "text": "いやいやいやいや！！！"},
        { "location": "2441/TALK"    , "narrator": "神楽", "text": "うん"},
        { "location": "2442/TALK"    , "narrator": "神楽", "text": "わかんないけどちょっと元気出た"}
