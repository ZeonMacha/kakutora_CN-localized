{
    "dir": "dramatics/daydra/drm_ch02_00_820.js",
    "type": "Episode",
    "info": {
        "story_id": "2082",
        "cid": "ayami",
        "title": "らぶとーく 第81話",
        "sub_title": "きっとずっと、ふたりで"
    },
    "entry":
    [
        { "location": "725/TALK" , "narrator": "アーヤ", "text": "……じゃあそろそろ\n行きましょう。"},
        { "location": "726/SEL"  , "narrator": "", "text": "どこへ？"},
        { "location": "727/SEL"  , "narrator": "", "text": "アーヤの行くところなら\nどこでも"},
        { "location": "728/SEL"  , "narrator": "", "text": "これで終わり？"},
        { "location": "729/ACT"  , "narrator": "", "text": "どこへ？"},
        { "location": "730/TALK" , "narrator": "アーヤ", "text": "言ってなかったっけ。"},
        { "location": "731/ACT"  , "narrator": "", "text": "アーヤの行くところなら\nどこでも"},
        { "location": "733/TALK" , "narrator": "アーヤ", "text": "あなたがいないと\n意味がないもの。"},
        { "location": "734/ACT"  , "narrator": "", "text": "これで終わり？"},
        { "location": "735/TALK" , "narrator": "アーヤ", "text": "そんなわけないわ。"},
        { "location": "737/TALK" , "narrator": "アーヤ", "text": "二人きりで\nバイクに乗って\nハネムーン。"},
        { "location": "738/SEL"  , "narrator": "", "text": "ドレスで！？"},
        { "location": "739/SEL"  , "narrator": "", "text": "そう来たか"},
        { "location": "740/SEL"  , "narrator": "", "text": "タンデムで"},
        { "location": "741/ACT"  , "narrator": "", "text": "ドレスで！？"},
        { "location": "742/TALK" , "narrator": "アーヤ", "text": "そうよ。"},
        { "location": "743/TALK" , "narrator": "アーヤ", "text": "って\n言いたいところだけど\nさすがに無理ね。"},
        { "location": "744/TALK" , "narrator": "アーヤ", "text": "一旦着替えるわ。"},
        { "location": "745/ACT"  , "narrator": "", "text": "そう来たか"},
        { "location": "746/TALK" , "narrator": "アーヤ", "text": "必要でしょ。"},
        { "location": "747/ACT"  , "narrator": "", "text": "タンデムで"},
        { "location": "748/TALK" , "narrator": "アーヤ", "text": "…そうね。\nタンデムで。"},
        { "location": "750/TALK" , "narrator": "アーヤ", "text": "こういう時って\nやっぱり海って\n思うのよ。"},
        { "location": "751/SEL"  , "narrator": "", "text": "海なし県民乙"},
        { "location": "752/SEL"  , "narrator": "", "text": "わかる"},
        { "location": "753/SEL"  , "narrator": "", "text": "ベタすぎない？"},
        { "location": "754/ACT"  , "narrator": "", "text": "海なし県民乙"},
        { "location": "755/TALK" , "narrator": "アーヤ", "text": "それは関係ないわよ。"},
        { "location": "756/ACT"  , "narrator": "", "text": "わかる"},
        { "location": "757/TALK" , "narrator": "アーヤ", "text": "そうでしょ！"},
        { "location": "758/ACT"  , "narrator": "", "text": "ベタすぎない？"},
        { "location": "759/TALK" , "narrator": "アーヤ", "text": "そこがいいんじゃない。"},
        { "location": "762/TALK" , "narrator": "アーヤ", "text": "素敵な景色を\n$handle$さんと\n見たりしながら。"},
        { "location": "763/TALK" , "narrator": "アーヤ", "text": "海まで行って\nそこで写真を\n撮りたいの。"},
        { "location": "764/TALK" , "narrator": "アーヤ", "text": "今日は好きなものだけに\n囲まれたいから。"},
        { "location": "765/TALK" , "narrator": "アーヤ", "text": "それを記念に\n残したいから。"},
        { "location": "766/SEL"  , "narrator": "", "text": "$me$より海が好きなの？"},
        { "location": "767/SEL"  , "narrator": "", "text": "アーヤらしいね"},
        { "location": "768/SEL"  , "narrator": "", "text": "この先も記念を\nいっぱい作ろうよ"},
        { "location": "769/ACT"  , "narrator": "", "text": "$me$より海が好きなの？"},
        { "location": "770/TALK" , "narrator": "アーヤ", "text": "そんなわけないでしょ。"},
        { "location": "771/ACT"  , "narrator": "", "text": "アーヤらしいね"},
        { "location": "772/TALK" , "narrator": "アーヤ", "text": "…そう？"},
        { "location": "773/ACT"  , "narrator": "", "text": "この先も記念を\nいっぱい作ろうよ"},
        { "location": "774/TALK" , "narrator": "アーヤ", "text": "そうね。\n作りましょう。"},
        { "location": "787/TALK" , "narrator": "アーヤ", "text": "荷物は大丈夫。"},
        { "location": "788/TALK" , "narrator": "アーヤ", "text": "天気だっていいし。"},
        { "location": "789/TALK" , "narrator": "アーヤ", "text": "地図も確認した。"},
        { "location": "790/TALK" , "narrator": "アーヤ", "text": "じゃあ出発\nしましょうか。"},
        { "location": "791/SEL"  , "narrator": "", "text": "バイクに缶から\n付けないの？"},
        { "location": "792/SEL"  , "narrator": "", "text": "いつもと同じじゃない？"},
        { "location": "793/SEL"  , "narrator": "", "text": "愛の逃避行だね"},
        { "location": "794/ACT"  , "narrator": "", "text": "バイクに缶から\n付けないの？"},
        { "location": "795/TALK" , "narrator": "アーヤ", "text": "公道は走れないもの。"},
        { "location": "796/SEL"  , "narrator": "", "text": "ですよねー"},
        { "location": "797/SEL"  , "narrator": "", "text": "する気だったんだ？"},
        { "location": "798/ACT"  , "narrator": "", "text": "ですよねー"},
        { "location": "799/TALK" , "narrator": "アーヤ", "text": "残念よね。"},
        { "location": "800/ACT"  , "narrator": "", "text": "する気だったんだ？"},
        { "location": "801/TALK" , "narrator": "アーヤ", "text": "…せっかくだから\nちょっとね…。"},
        { "location": "803/ACT"  , "narrator": "", "text": "いつもと同じじゃない？"},
        { "location": "804/TALK" , "narrator": "アーヤ", "text": "違うわよ。\nハネムーンよ。"},
        { "location": "805/SEL"  , "narrator": "", "text": "気持ちの問題だよね"},
        { "location": "806/SEL"  , "narrator": "", "text": "アーヤはいつもより\nきれいかな"},
        { "location": "807/ACT"  , "narrator": "", "text": "気持ちの問題だよね"},
        { "location": "808/TALK" , "narrator": "アーヤ", "text": "そうよ。\nハネムーンだから。"},
        { "location": "809/ACT"  , "narrator": "", "text": "アーヤはいつもより\nきれいかな"},
        { "location": "810/TALK" , "narrator": "アーヤ", "text": "もう！"},
        { "location": "812/ACT"  , "narrator": "", "text": "愛の逃避行だね"},
        { "location": "813/TALK" , "narrator": "アーヤ", "text": "退廃的ね…\nちょっと格好いいけど。"},
        { "location": "814/SEL"  , "narrator": "", "text": "来世で幸せになろう"},
        { "location": "815/SEL"  , "narrator": "", "text": "この世界に二人きり"},
        { "location": "816/SEL"  , "narrator": "", "text": "何人にもこの愛は\n止められない"},
        { "location": "817/ACT"  , "narrator": "", "text": "来世で幸せになろう"},
        { "location": "818/TALK" , "narrator": "アーヤ", "text": "それは約束できないわ。"},
        { "location": "819/TALK" , "narrator": "アーヤ", "text": "だって今幸せなんだもの。"},
        { "location": "820/ACT"  , "narrator": "", "text": "この世界に二人きり"},
        { "location": "821/TALK" , "narrator": "アーヤ", "text": "ずっとそれだと\n少しさみしいわ。"},
        { "location": "822/TALK" , "narrator": "アーヤ", "text": "そんな瞬間は\n必要だと思うけど。"},
        { "location": "823/ACT"  , "narrator": "", "text": "何人にもこの愛は\n止められない"},
        { "location": "824/TALK" , "narrator": "アーヤ", "text": "…人に言うことでも\nないわ。"},
        { "location": "825/TALK" , "narrator": "アーヤ", "text": "お互いがそう思っていれば\nそれでいいと思うの。"},
        { "location": "832/TALK" , "narrator": "アーヤ", "text": "ちょっと休憩。"},
        { "location": "833/TALK" , "narrator": "アーヤ", "text": "今日はお弁当を\n作ってきたのよ。"},
        { "location": "834/TALK" , "narrator": "アーヤ", "text": "一口サイズの\nサンドイッチと\n野菜スティック。"},
        { "location": "835/TALK" , "narrator": "アーヤ", "text": "フルーツも\n一口サイズに\nしてみたわ。"},
        { "location": "836/TALK" , "narrator": "アーヤ", "text": "それからスープ。\nスープジャーって\n便利ね。"},
        { "location": "837/SEL"  , "narrator": "", "text": "大変じゃなかった？"},
        { "location": "838/SEL"  , "narrator": "", "text": "いいなー！"},
        { "location": "839/SEL"  , "narrator": "", "text": "$me$も食べたい！"},
        { "location": "840/ACT"  , "narrator": "", "text": "大変じゃなかった？"},
        { "location": "842/TALK" , "narrator": "アーヤ", "text": "せっかくだから\n張り切ったの。"},
        { "location": "843/ACT"  , "narrator": "", "text": "いいなー！"},
        { "location": "845/TALK" , "narrator": "アーヤ", "text": "ふふふ。\n頑張ったわ。"},
        { "location": "846/ACT"  , "narrator": "", "text": "$me$も食べたい！"},
        { "location": "847/TALK" , "narrator": "アーヤ", "text": "…会えた時は\n絶対食べてね。"},
        { "location": "849/TALK" , "narrator": "アーヤ", "text": "…そんなに凝ったもの\n作ったわけじゃ\nないけど。"},
        { "location": "850/TALK" , "narrator": "アーヤ", "text": "我ながらなかなか\nいい出来よ。"},
        { "location": "851/TALK" , "narrator": "アーヤ", "text": "見た目もいいし、\nおいしいし。"},
        { "location": "852/TALK" , "narrator": "アーヤ", "text": "何より特別なお弁当って\n感じがするし。"},
        { "location": "853/TALK" , "narrator": "アーヤ", "text": "外で食べると\nいつもよりちょっと\n美味しいって思うの。"},
        { "location": "854/TALK" , "narrator": "アーヤ", "text": "これって何なのかしら？"},
        { "location": "855/SEL"  , "narrator": "", "text": "空気の違い"},
        { "location": "856/SEL"  , "narrator": "", "text": "割れ窓理論"},
        { "location": "857/SEL"  , "narrator": "", "text": "景色も味のうち"},
        { "location": "858/ACT"  , "narrator": "", "text": "空気の違い"},
        { "location": "859/TALK" , "narrator": "アーヤ", "text": "それはあるかもね。"},
        { "location": "860/ACT"  , "narrator": "", "text": "割れ窓理論"},
        { "location": "861/TALK" , "narrator": "アーヤ", "text": "それ絶対違うから。"},
        { "location": "862/ACT"  , "narrator": "", "text": "景色も味のうち"},
        { "location": "863/TALK" , "narrator": "アーヤ", "text": "そうね。\nそういうことよね。"},
        { "location": "865/TALK" , "narrator": "アーヤ", "text": "$handle$さんには\n毎日私の手料理を\n食べてもらいたいな。"},
        { "location": "866/SEL"  , "narrator": "", "text": "$me$にも作らせてよ"},
        { "location": "867/SEL"  , "narrator": "", "text": "太っちゃうかも…"},
        { "location": "868/SEL"  , "narrator": "", "text": "外食も楽しいよ"},
        { "location": "869/ACT"  , "narrator": "", "text": "$me$にも作らせてよ"},
        { "location": "870/TALK" , "narrator": "アーヤ", "text": "それも楽しみ。"},
        { "location": "871/SEL"  , "narrator": "", "text": "アーヤは何が好き？"},
        { "location": "872/SEL"  , "narrator": "", "text": "料理の腕を上げておく"},
        { "location": "873/SEL"  , "narrator": "", "text": "あんまり自信ないけど"},
        { "location": "874/ACT"  , "narrator": "", "text": "アーヤは何が好き？"},
        { "location": "875/TALK" , "narrator": "アーヤ", "text": "何でも好き。"},
        { "location": "876/TALK" , "narrator": "アーヤ", "text": "$handle$さんの\n作るものなら。"},
        { "location": "877/ACT"  , "narrator": "", "text": "料理の腕を上げておく"},
        { "location": "878/TALK" , "narrator": "アーヤ", "text": "期待しておくわ。"},
        { "location": "879/ACT"  , "narrator": "", "text": "あんまり自信ないけど"},
        { "location": "880/TALK" , "narrator": "アーヤ", "text": "そんなこと言って。\n絶対おいしいに\n決まってるから。"},
        { "location": "882/ACT"  , "narrator": "", "text": "太っちゃうかも…"},
        { "location": "884/TALK" , "narrator": "アーヤ", "text": "そうなったら\nダイエット食を\n作るわ。"},
        { "location": "885/SEL"  , "narrator": "", "text": "最初から低カロリーで\nお願いします"},
        { "location": "886/SEL"  , "narrator": "", "text": "それでもいっぱい\n食べる気がする"},
        { "location": "887/ACT"  , "narrator": "", "text": "最初から低カロリーで\nお願いします"},
        { "location": "888/TALK" , "narrator": "アーヤ", "text": "そうすれば\nいいだけ？"},
        { "location": "889/ACT"  , "narrator": "", "text": "それでもいっぱい\n食べる気がする"},
        { "location": "890/TALK" , "narrator": "アーヤ", "text": "$handle$さんは\nくいしんぼなのね。"},
        { "location": "892/ACT"  , "narrator": "", "text": "外食も楽しいよ"},
        { "location": "893/TALK" , "narrator": "アーヤ", "text": "そうね。\n外食もしたいかも。"},
        { "location": "894/SEL"  , "narrator": "", "text": "B級グルメ巡りとか"},
        { "location": "895/SEL"  , "narrator": "", "text": "おしゃれに夜景を見ながら"},
        { "location": "896/SEL"  , "narrator": "", "text": "肉！　肉！　肉！"},
        { "location": "897/SEL"  , "narrator": "", "text": "知らない国の料理とか"},
        { "location": "898/SEL"  , "narrator": "", "text": "お酒も飲みたい"},
        { "location": "899/ACT"  , "narrator": "", "text": "B級グルメ巡りとか"},
        { "location": "900/TALK" , "narrator": "アーヤ", "text": "たまにはいいかもね。"},
        { "location": "901/ACT"  , "narrator": "", "text": "おしゃれに夜景を見ながら"},
        { "location": "902/TALK" , "narrator": "アーヤ", "text": "誕生日なんかは\nそういうのがいいわね。"},
        { "location": "903/ACT"  , "narrator": "", "text": "肉！　肉！　肉！"},
        { "location": "904/TALK" , "narrator": "アーヤ", "text": "$handle$さんって\n肉食なのね……。"},
        { "location": "905/ACT"  , "narrator": "", "text": "知らない国の料理とか"},
        { "location": "906/TALK" , "narrator": "アーヤ", "text": "味がわからないと\n作ったものが正解か\nどうかわからないしね。"},
        { "location": "907/ACT"  , "narrator": "", "text": "お酒も飲みたい"},
        { "location": "908/TALK" , "narrator": "アーヤ", "text": "どうせならね。"},
        { "location": "915/TALK" , "narrator": "アーヤ", "text": "…ごちそうさま。"},
        { "location": "916/TALK" , "narrator": "アーヤ", "text": "じゃあそろそろ\n出発しましょう。"},
        { "location": "931/TALK" , "narrator": "アーヤ", "text": "写真で見るより\nずっといい感じ。"},
        { "location": "932/TALK" , "narrator": "アーヤ", "text": "やっぱりここにして\nよかったわ。"},
        { "location": "934/TALK" , "narrator": "アーヤ", "text": "$handle$さん\n海よ！"},
        { "location": "935/SEL"  , "narrator": "", "text": "だねー"},
        { "location": "936/SEL"  , "narrator": "", "text": "いい天気でよかった"},
        { "location": "937/SEL"  , "narrator": "", "text": "長旅おつかれさま"},
        { "location": "938/ACT"  , "narrator": "", "text": "だねー"},
        { "location": "939/TALK" , "narrator": "アーヤ", "text": "ちょっと適当？"},
        { "location": "940/ACT"  , "narrator": "", "text": "いい天気でよかった"},
        { "location": "941/TALK" , "narrator": "アーヤ", "text": "こればっかりは\n変えられないしね。"},
        { "location": "942/ACT"  , "narrator": "", "text": "長旅おつかれさま"},
        { "location": "943/TALK" , "narrator": "アーヤ", "text": "そこまで大変って\nことはないわ。"},
        { "location": "945/TALK" , "narrator": "アーヤ", "text": "見て、あれ。"},
        { "location": "946/TALK" , "narrator": "アーヤ", "text": "キョウチクトウが\nアーチみたいになって\n砂浜が続いてる。"},
        { "location": "947/TALK" , "narrator": "アーヤ", "text": "その先の海。\n陽の光が反射して\nすごくきれい。"},
        { "location": "948/TALK" , "narrator": "アーヤ", "text": "決めた。"},
        { "location": "949/TALK" , "narrator": "アーヤ", "text": "あそこで写真を撮るわ。\nドレスを着て。"},
        { "location": "950/SEL"  , "narrator": "", "text": "持ってきてたの！？"},
        { "location": "951/SEL"  , "narrator": "", "text": "いい記念になるね"},
        { "location": "952/SEL"  , "narrator": "", "text": "$me$の心に一生残るよ"},
        { "location": "953/ACT"  , "narrator": "", "text": "持ってきてたの！？"},
        { "location": "954/TALK" , "narrator": "アーヤ", "text": "バイクの後ろに\n積んでたのよ。"},
        { "location": "955/ACT"  , "narrator": "", "text": "いい記念になるね"},
        { "location": "956/TALK" , "narrator": "アーヤ", "text": "そうでしょ？"},
        { "location": "957/ACT"  , "narrator": "", "text": "$me$の心に一生残るよ"},
        { "location": "959/TALK" , "narrator": "アーヤ", "text": "そうね。\n一生憶えてて。"},
        { "location": "970/TALK" , "narrator": "透明アーヤ", "text": "今、違う場所にしか\nいないとしても。"},
        { "location": "971/TALK" , "narrator": "透明アーヤ", "text": "$handle$さんが\nいてくれてよかった。"},
        { "location": "972/TALK" , "narrator": "透明アーヤ", "text": "ありがとう。"},
        { "location": "975/TALK" , "narrator": "透明アーヤ", "text": "愛してる。"},
        { "location": "976/SEL"  , "narrator": "", "text": "$me$も"},
        { "location": "977/SEL"  , "narrator": "", "text": "全世界で一番好きだ"},
        { "location": "978/SEL"  , "narrator": "", "text": "幸せすぎて\n言葉にできない"},
        { "location": "979/ACT"  , "narrator": "", "text": "$me$も"},
        { "location": "980/TALK" , "narrator": "透明アーヤ", "text": "私の方がずっと\n愛してるから。"},
        { "location": "981/ACT"  , "narrator": "", "text": "全世界で一番好きだ"},
        { "location": "982/TALK" , "narrator": "透明アーヤ", "text": "私もそう思ってる。"},
        { "location": "983/ACT"  , "narrator": "", "text": "幸せすぎて\n言葉にできない"},
        { "location": "984/TALK" , "narrator": "透明アーヤ", "text": "本当にそんな気持ち。"},
        { "location": "986/TALK" , "narrator": "透明アーヤ", "text": "初めて話した時は\nこんなことになるなんて\n思ってもなかったわ。"},
        { "location": "987/SEL"  , "narrator": "", "text": "$me$は初めから決めてた"},
        { "location": "988/SEL"  , "narrator": "", "text": "でも運命だったんだ"},
        { "location": "989/SEL"  , "narrator": "", "text": "わからないもんだよね"},
        { "location": "990/ACT"  , "narrator": "", "text": "$me$は初めから決めてた"},
        { "location": "992/TALK" , "narrator": "透明アーヤ", "text": "え……。\n初めて聞いたわ。"},
        { "location": "993/ACT"  , "narrator": "", "text": "でも運命だったんだ"},
        { "location": "994/TALK" , "narrator": "透明アーヤ", "text": "そうね。\n運命。"},
        { "location": "995/ACT"  , "narrator": "", "text": "わからないもんだよね"},
        { "location": "996/TALK" , "narrator": "透明アーヤ", "text": "そういうものかも\nしれないけど。"},
        { "location": "999/TALK" , "narrator": "透明アーヤ", "text": "その後も色々あったし。"},
        { "location": "1000/TALK", "narrator": "透明アーヤ", "text": "別れようなんて\n思ったことも\nあったけど。"},
        { "location": "1001/TALK", "narrator": "透明アーヤ", "text": "でもね。"},
        { "location": "1002/TALK", "narrator": "透明アーヤ", "text": "そっちの方が辛いって\n思い知ったから。"},
        { "location": "1003/TALK", "narrator": "透明アーヤ", "text": "もうそんなことは\n考えない\nことにしたの。"},
        { "location": "1005/TALK", "narrator": "透明アーヤ", "text": "ごめんね。\nわがままばっかりで。"},
        { "location": "1006/SEL" , "narrator": "", "text": "もっと言って"},
        { "location": "1007/SEL" , "narrator": "", "text": "ええんやで…"},
        { "location": "1008/SEL" , "narrator": "", "text": "$me$の方がわがままだし"},
        { "location": "1009/ACT" , "narrator": "", "text": "もっと言って"},
        { "location": "1010/TALK", "narrator": "透明アーヤ", "text": "そういうのちょっと\n恥ずかしいから…。"},
        { "location": "1011/ACT" , "narrator": "", "text": "ええんやで…"},
        { "location": "1012/TALK", "narrator": "透明アーヤ", "text": "なんで関西弁？"},
        { "location": "1013/ACT" , "narrator": "", "text": "$me$の方がわがままだし"},
        { "location": "1015/TALK", "narrator": "透明アーヤ", "text": "そういうところも\n好きよ。"},
        { "location": "1018/TALK", "narrator": "透明アーヤ", "text": "もう少し海を\n見ててもいい？"},
        { "location": "1019/TALK", "narrator": "透明アーヤ", "text": "ゆっくりすることも\n海に来ることも\n滅多にないだろうから。"},
        { "location": "1020/SEL" , "narrator": "", "text": "そうだね"},
        { "location": "1021/SEL" , "narrator": "", "text": "また来ようよ"},
        { "location": "1022/SEL" , "narrator": "", "text": "海はいいね"},
        { "location": "1023/ACT" , "narrator": "", "text": "そうだね"},
        { "location": "1025/TALK", "narrator": "透明アーヤ", "text": "来てよかったわ。"},
        { "location": "1026/ACT" , "narrator": "", "text": "また来ようよ"},
        { "location": "1028/TALK", "narrator": "透明アーヤ", "text": "そうね。\n絶対ね。"},
        { "location": "1029/ACT" , "narrator": "", "text": "海はいいね"},
        { "location": "1031/TALK", "narrator": "透明アーヤ", "text": "そうでしょ。\n素敵よね。"},
        { "location": "1033/TALK", "narrator": "透明アーヤ", "text": "それからいっぱい\n写真も撮りたいわ。"},
        { "location": "1034/TALK", "narrator": "透明アーヤ", "text": "ドレスを着ることは\nしばらくないと\n思うから…。"},
        { "location": "1049/TALK", "narrator": "アーヤ", "text": "今日はいっぱい\n写真を撮ったわ。"},
        { "location": "1050/TALK", "narrator": "アーヤ", "text": "あんなに自撮りで\n写真撮ったの\n始めてかも。"},
        { "location": "1051/TALK", "narrator": "アーヤ", "text": "変に思われたり\nしなかったかしら？"},
        { "location": "1052/SEL" , "narrator": "", "text": "SNS用だって思われた\nだけじゃ？"},
        { "location": "1053/SEL" , "narrator": "", "text": "そんなことないよ"},
        { "location": "1054/SEL" , "narrator": "", "text": "自分大好きって\n思われたかもね"},
        { "location": "1055/SEL" , "narrator": "", "text": "周りに人っていた？"},
        { "location": "1056/ACT" , "narrator": "", "text": "SNS用だって思われた\nだけじゃ？"},
        { "location": "1057/TALK", "narrator": "アーヤ", "text": "わざわざ写真撮るって\nいうものね。"},
        { "location": "1058/TALK", "narrator": "アーヤ", "text": "それはあるかも。"},
        { "location": "1059/ACT" , "narrator": "", "text": "そんなことないよ"},
        { "location": "1061/TALK", "narrator": "アーヤ", "text": "冷静になったら\n結構シュールな\n光景じゃない？"},
        { "location": "1062/TALK", "narrator": "アーヤ", "text": "そんなこと\nないかしら…。"},
        { "location": "1064/TALK", "narrator": "アーヤ", "text": "…それは…\nあるかも……。"},
        { "location": "1065/TALK", "narrator": "アーヤ", "text": "そういうつもりじゃ\nなかったんだけど…。"},
        { "location": "1066/ACT" , "narrator": "", "text": "周りに人っていた？"},
        { "location": "1067/TALK", "narrator": "アーヤ", "text": "…ほとんど\nいなかった…。"},
        { "location": "1068/TALK", "narrator": "アーヤ", "text": "そもそも\n見られてないか。"},
        { "location": "1070/TALK", "narrator": "アーヤ", "text": "気に入った写真は\nプリントして\nアルバムにしておくわね。"},
        { "location": "1071/TALK", "narrator": "アーヤ", "text": "ギャヴィに聞いて\nキラキラしたペンとか\nマステも買ったし。"},
        { "location": "1072/SEL" , "narrator": "", "text": "意外と少女趣味？"},
        { "location": "1073/SEL" , "narrator": "", "text": "マステって何"},
        { "location": "1074/SEL" , "narrator": "", "text": "スクラップブッキングだ"},
        { "location": "1075/ACT" , "narrator": "", "text": "意外と少女趣味？"},
        { "location": "1076/TALK", "narrator": "アーヤ", "text": "意外とは余計じゃない？"},
        { "location": "1077/TALK", "narrator": "アーヤ", "text": "まあ少女って年でも\nないけど……。"},
        { "location": "1078/ACT" , "narrator": "", "text": "マステって何"},
        { "location": "1079/TALK", "narrator": "アーヤ", "text": "マスキングテープよ。\n和紙にプリントしてある\n粘着テープ。"},
        { "location": "1080/TALK", "narrator": "アーヤ", "text": "色んな模様があって\n集めたくなるわ。"},
        { "location": "1081/ACT" , "narrator": "", "text": "スクラップブッキングだ"},
        { "location": "1082/TALK", "narrator": "アーヤ", "text": "それそれ。"},
        { "location": "1083/TALK", "narrator": "アーヤ", "text": "せっかくだもの。\n華やかな方が\nいいでしょ。"},
        { "location": "1085/TALK", "narrator": "アーヤ", "text": "こうやって思い出を\n形にしておけば。"},
        { "location": "1086/TALK", "narrator": "アーヤ", "text": "見返すことができるし。\n思い出話も\nできるでしょ。"},
        { "location": "1088/TALK", "narrator": "アーヤ", "text": "作ってる時も\n楽しいしね。"},
        { "location": "1089/SEL" , "narrator": "", "text": "めんどくさくない？"},
        { "location": "1090/SEL" , "narrator": "", "text": "確かに楽しそうだね"},
        { "location": "1091/SEL" , "narrator": "", "text": "$me$も何か作ろうかな"},
        { "location": "1092/ACT" , "narrator": "", "text": "めんどくさくない？"},
        { "location": "1093/TALK", "narrator": "アーヤ", "text": "めんどくさいところが\n楽しいのよ。"},
        { "location": "1094/ACT" , "narrator": "", "text": "確かに楽しそうだね"},
        { "location": "1095/TALK", "narrator": "アーヤ", "text": "そうでしょ？"},
        { "location": "1096/ACT" , "narrator": "", "text": "$me$も何か作ろうかな"},
        { "location": "1097/TALK", "narrator": "アーヤ", "text": "作ったら見せてね。"},
        { "location": "1099/TALK", "narrator": "アーヤ", "text": "こうやって\n$handle$さんとの\n思い出を残すの、"},
        { "location": "1100/TALK", "narrator": "アーヤ", "text": "もしかして\n重いかしら？"},
        { "location": "1101/SEL" , "narrator": "", "text": "だがそこがいい"},
        { "location": "1102/SEL" , "narrator": "", "text": "どんなに重くても受け止める"},
        { "location": "1103/SEL" , "narrator": "", "text": "$me$の方が重いよ…？"},
        { "location": "1104/ACT" , "narrator": "", "text": "だがそこがいい"},
        { "location": "1105/TALK", "narrator": "アーヤ", "text": "$handle$さんって\n意外と悪趣味なの？"},
        { "location": "1106/TALK", "narrator": "アーヤ", "text": "そんな言い方……。"},
        { "location": "1107/ACT" , "narrator": "", "text": "どんなに重くても受け止める"},
        { "location": "1108/TALK", "narrator": "アーヤ", "text": "やっぱり重いわね…。"},
        { "location": "1109/TALK", "narrator": "アーヤ", "text": "でもちゃんと受け止めて\nくれるのね。\nよかった…。"},
        { "location": "1110/ACT" , "narrator": "", "text": "$me$の方が重いよ…？"},
        { "location": "1111/TALK", "narrator": "アーヤ", "text": "そうかしら！？！？"},
        { "location": "1112/TALK", "narrator": "アーヤ", "text": "それはそれで\nうれしいけど…。"},
        { "location": "1114/TALK", "narrator": "アーヤ", "text": "一杯思い出を\n作って残して\nおきたいの。"},
        { "location": "1116/TALK", "narrator": "アーヤ", "text": "いつか全部\n笑って話せる\nその日のために。"},
        { "location": "1117/TALK", "narrator": "アーヤ", "text": "ね？"}
    ]
}
