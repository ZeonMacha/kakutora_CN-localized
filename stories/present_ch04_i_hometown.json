        { "location": "181/TALK", "narrator": "みやび", "text": "こう言うたら住んでる人間に申し訳ないが"},
        { "location": "183/TALK", "narrator": "みやび", "text": "超絶ド田舎やね"},
        { "location": "184/TALK", "narrator": "みやび", "text": "嫌いやないけんど"},
        { "location": "187/SEL" , "narrator": "", "text": "ネット回線来てなさそうだよ？"},
        { "location": "188/ACT" , "narrator": "", "text": "ネット回線来てなさそうだよ？"},
        { "location": "191/TALK", "narrator": "みやび", "text": "うちを何だと思うてるが？"},
        { "location": "192/TALK", "narrator": "みやび", "text": "住みたいわけやない"},
        { "location": "193/TALK", "narrator": "みやび", "text": "見てて落ち着くから好き"},
        { "location": "194/TALK", "narrator": "みやび", "text": "それだけのことや"},
        { "location": "197/SEL" , "narrator": "", "text": "みやびにとっての落ち着く場所は？"},
        { "location": "198/ACT" , "narrator": "", "text": "みやびにとっての落ち着く場所は？"},
        { "location": "201/TALK", "narrator": "みやび", "text": "ＰＣの前"},
        { "location": "204/SEL" , "narrator": "", "text": "そこ以外だと？"},
        { "location": "205/ACT" , "narrator": "", "text": "そこ以外だと？"},
        { "location": "208/TALK", "narrator": "みやび", "text": "わからん"},
        { "location": "209/TALK", "narrator": "みやび", "text": "あるのかもしれん"},
        { "location": "210/TALK", "narrator": "みやび", "text": "無意識のうちに落ち着いた気持ちになってて"},
        { "location": "211/TALK", "narrator": "みやび", "text": "気付いてないだけかもしれんけんど"},
        { "location": "212/TALK", "narrator": "みやび", "text": "今は思いつかん"}
