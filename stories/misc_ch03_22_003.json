    "entry":
    [
        { "location": "159/SCENARIO", "narrator": "", "text": "砂浜と雨宿り"},
        { "location": "186/TALK"    , "narrator": "ガブリエラ", "text": "海水浴をする時には"},
        { "location": "187/TALK"    , "narrator": "ガブリエラ", "text": "水着を着ているでしょう？"},
        { "location": "188/TALK"    , "narrator": "ガブリエラ", "text": "それなのに"},
        { "location": "189/TALK"    , "narrator": "ガブリエラ", "text": "雨が降ってきたら"},
        { "location": "190/TALK"    , "narrator": "ガブリエラ", "text": "みんな雨宿りをするのよね"},
        { "location": "192/SEL"     , "narrator": "", "text": "するよね"},
        { "location": "193/SEL"     , "narrator": "", "text": "むしろ大喜び"},
        { "location": "194/SEL"     , "narrator": "", "text": "雨に濡れるのは嫌じゃないの？"},
        { "location": "195/ACT"     , "narrator": "", "text": "するよね"},
        { "location": "196/TALK"    , "narrator": "ガブリエラ", "text": "ね"},
        { "location": "198/TALK"    , "narrator": "ガブリエラ", "text": "そうでしょう？"},
        { "location": "199/ACT"     , "narrator": "", "text": "むしろ大喜び"},
        { "location": "200/TALK"    , "narrator": "ガブリエラ", "text": "え"},
        { "location": "201/TALK"    , "narrator": "ガブリエラ", "text": "そうなの"},
        { "location": "202/ACT"     , "narrator": "", "text": "雨に濡れるのは嫌じゃないの？"},
        { "location": "204/TALK"    , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "205/TALK"    , "narrator": "ガブリエラ", "text": "確かに"},
        { "location": "206/TALK"    , "narrator": "ガブリエラ", "text": "あんまり好きじゃないわ"},
        { "location": "208/TALK"    , "narrator": "ガブリエラ", "text": "私も"},
        { "location": "210/TALK"    , "narrator": "ガブリエラ", "text": "ええとね"},
        { "location": "211/TALK"    , "narrator": "ガブリエラ", "text": "あまり意味がないはずなのに"},
        { "location": "212/TALK"    , "narrator": "ガブリエラ", "text": "どうしてそんなことをしてしまうのかしらって"},
        { "location": "213/TALK"    , "narrator": "ガブリエラ", "text": "不思議じゃないこと？"},
        { "location": "215/SEL"     , "narrator": "", "text": "別に"},
        { "location": "216/SEL"     , "narrator": "", "text": "一応意味はあると思うけど"},
        { "location": "217/SEL"     , "narrator": "", "text": "水着は雨用じゃないからじゃない"},
        { "location": "218/ACT"     , "narrator": "", "text": "別に"},
        { "location": "219/TALK"    , "narrator": "ガブリエラ", "text": "$marzanna$にとっては"},
        { "location": "220/TALK"    , "narrator": "ガブリエラ", "text": "不思議じゃないのね"},
        { "location": "221/TALK"    , "narrator": "ガブリエラ", "text": "わかってくれないのは"},
        { "location": "223/TALK"    , "narrator": "ガブリエラ", "text": "ちょっと残念だわ"},
        { "location": "224/ACT"     , "narrator": "", "text": "一応意味はあると思うけど"},
        { "location": "225/TALK"    , "narrator": "ガブリエラ", "text": "あるかしら？"},
        { "location": "226/TALK"    , "narrator": "ガブリエラ", "text": "そこがちょっと"},
        { "location": "227/TALK"    , "narrator": "ガブリエラ", "text": "不思議なところだって思うんだけど"},
        { "location": "228/TALK"    , "narrator": "ガブリエラ", "text": "なんだかうまく"},
        { "location": "229/TALK"    , "narrator": "ガブリエラ", "text": "伝わらないわ"},
        { "location": "230/ACT"     , "narrator": "", "text": "水着は雨用じゃないからじゃない"},
        { "location": "232/TALK"    , "narrator": "ガブリエラ", "text": "あ"},
        { "location": "233/TALK"    , "narrator": "ガブリエラ", "text": "その説は面白いわね"},
        { "location": "235/TALK"    , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "236/TALK"    , "narrator": "ガブリエラ", "text": "雨用じゃないから"},
        { "location": "237/TALK"    , "narrator": "ガブリエラ", "text": "雨に濡れるのはダメなのね"}
    ]
}
