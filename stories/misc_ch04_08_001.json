    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "007_あくびの空"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "クランには意思がある。\nそれは即ち生きているということだ。"},
        { "location": "34/SEL"    , "narrator": "", "text": "そうかな…？"},
        { "location": "35/SEL"    , "narrator": "", "text": "そうかもね"},
        { "location": "36/SEL"    , "narrator": "", "text": "そう思いたいだけじゃない？"},
        { "location": "37/TALK"   , "narrator": "みやび", "text": "生物学的には？\nなどという問いは意味がない。"},
        { "location": "38/TALK"   , "narrator": "みやび", "text": "とは言わないが――"},
        { "location": "42/ACT"    , "narrator": "", "text": "そうかな…？"},
        { "location": "43/TALK"   , "narrator": "みやび", "text": "そうだと思うが違うかね"},
        { "location": "44/TALK"   , "narrator": "みやび", "text": "相棒"},
        { "location": "45/ACT"    , "narrator": "", "text": "そうかもね"},
        { "location": "46/TALK"   , "narrator": "みやび", "text": "そうであろうよ"},
        { "location": "47/TALK"   , "narrator": "みやび", "text": "違うかね、相棒"},
        { "location": "48/ACT"    , "narrator": "", "text": "そう思いたいだけじゃない？"},
        { "location": "49/TALK"   , "narrator": "みやび", "text": "そうかもしれない。"},
        { "location": "50/TALK"   , "narrator": "みやび", "text": "否定するのだな"},
        { "location": "51/TALK"   , "narrator": "みやび", "text": "チミは"},
        { "location": "53/TALK"   , "narrator": "みやび", "text": "生きるということは意思を持つことと同義だと思うのだよ"},
        { "location": "54/TALK"   , "narrator": "みやび", "text": "即ち意思を持っているということは生きているということだ"},
        { "location": "56/SEL"    , "narrator": "", "text": "$handle$も生きてるよ"},
        { "location": "57/SEL"    , "narrator": "", "text": "ふーん"},
        { "location": "58/SEL"    , "narrator": "", "text": "哲学ってやつかな"},
        { "location": "59/ACT"    , "narrator": "", "text": "$handle$も生きてるよ"},
        { "location": "61/TALK"   , "narrator": "みやび", "text": "左様"},
        { "location": "62/TALK"   , "narrator": "みやび", "text": "貴殿も生きているということになってしまうのだ"},
        { "location": "63/TALK"   , "narrator": "みやび", "text": "これは些か"},
        { "location": "64/TALK"   , "narrator": "みやび", "text": "面白い"},
        { "location": "67/SEL"    , "narrator": "", "text": "喜んでいただけて光栄"},
        { "location": "68/SEL"    , "narrator": "", "text": "いや事実だし"},
        { "location": "69/ACT"    , "narrator": "", "text": "喜んでいただけて光栄"},
        { "location": "70/TALK"   , "narrator": "みやび", "text": "まあね"},
        { "location": "71/TALK"   , "narrator": "みやび", "text": "ちょっと楽しいとは思ったの介"},
        { "location": "72/ACT"    , "narrator": "", "text": "いや事実だし"},
        { "location": "73/TALK"   , "narrator": "みやび", "text": "へえ"},
        { "location": "74/TALK"   , "narrator": "みやび", "text": "カミングアウトしたってことか"},
        { "location": "75/TALK"   , "narrator": "みやび", "text": "いやまさかな"},
        { "location": "77/ACT"    , "narrator": "", "text": "ふーん"},
        { "location": "78/TALK"   , "narrator": "みやび", "text": "興味なしか"},
        { "location": "80/TALK"   , "narrator": "みやび", "text": "はぐらかしか"},
        { "location": "82/SEL"    , "narrator": "", "text": "興味ないし"},
        { "location": "83/SEL"    , "narrator": "", "text": "何をはぐらかしてるって？"},
        { "location": "84/ACT"    , "narrator": "", "text": "興味ないし"},
        { "location": "85/TALK"   , "narrator": "みやび", "text": "さよけ"},
        { "location": "86/ACT"    , "narrator": "", "text": "何をはぐらかしてるって？"},
        { "location": "87/TALK"   , "narrator": "みやび", "text": "ほうほう"},
        { "location": "89/TALK"   , "narrator": "みやび", "text": "一定のワードに反応するようにしてあるのか"},
        { "location": "90/TALK"   , "narrator": "みやび", "text": "パターン多いな"},
        { "location": "92/ACT"    , "narrator": "", "text": "哲学ってやつかな"},
        { "location": "94/TALK"   , "narrator": "みやび", "text": "して学派は？"},
        { "location": "95/SEL"    , "narrator": "", "text": "プラグマティズム"},
        { "location": "96/SEL"    , "narrator": "", "text": "独我論"},
        { "location": "97/ACT"    , "narrator": "", "text": "プラグマティズム"},
        { "location": "98/TALK"   , "narrator": "みやび", "text": "ふーん"},
        { "location": "99/TALK"   , "narrator": "みやび", "text": "なんじゃそりゃ"},
        { "location": "100/ACT"   , "narrator": "", "text": "独我論"},
        { "location": "101/TALK"  , "narrator": "みやび", "text": "我思う、故に我あり"},
        { "location": "102/TALK"  , "narrator": "みやび", "text": "ってやつ？"},
        { "location": "103/TALK"  , "narrator": "みやび", "text": "なんか語感から適当に言ってみた"},
        { "location": "106/TALK"  , "narrator": "みやび", "text": "まあ"},
        { "location": "107/TALK"  , "narrator": "みやび", "text": "こういった会話も意思があって疎通を試みることができるからこその産物"},
        { "location": "108/TALK"  , "narrator": "みやび", "text": "そして我は"},
        { "location": "109/TALK"  , "narrator": "みやび", "text": "眠い……。"},
        { "location": "111/TALK"  , "narrator": "みやび", "text": "・・・・・・・・・・・・・・・"}
    ]
}
