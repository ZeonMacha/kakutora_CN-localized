{
    "dir": "chap29/daydra/dd_ch01_29_010.js",
    "type": "",
    "info": {
        "story_id": "50012",
        "cid": "",
        "title": "SideStory012 ストーリー",
        "sub_title": "FILE09.繭雛"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "東京編９話"},
        { "location": "19/DIALOG" , "narrator": "", "text": "<color=green>9月6日　 4:03 PM</color>\nとある平日の放課後、付属学園付近でのこと"},
        { "location": "21/TALK"   , "narrator": "キリト", "text": "…は？　冗談か？"},
        { "location": "23/TALK"   , "narrator": "ヒカル", "text": "ううん、本当だよ。"},
        { "location": "24/TALK"   , "narrator": "ヒカル", "text": "僕はひなこさんに\n協力するって決めたんだ。"},
        { "location": "25/TALK"   , "narrator": "キリト", "text": "マジかよ…ヒカルは\n絶対に止める方だと\n思ってたのに…。"},
        { "location": "26/TALK"   , "narrator": "ヒカル", "text": "そりゃ、できることなら\n止めたいよ。"},
        { "location": "27/TALK"   , "narrator": "ヒカル", "text": "でも、無理だからね。\nひなこさんの性格を\n考えればわかるでしょ？"},
        { "location": "29/TALK"   , "narrator": "キリト", "text": "…危険だぞ？"},
        { "location": "30/TALK"   , "narrator": "ヒカル", "text": "それもわかってる。"},
        { "location": "31/TALK"   , "narrator": "ヒカル", "text": "だからこそ、\nひなこさん一人だけに\nやらせられないよ…。"},
        { "location": "33/TALK"   , "narrator": "キリト", "text": "…………。"},
        { "location": "34/TALK"   , "narrator": "ヒカル", "text": "とにかく、直接キリトに\n伝えておきたかったんだ。"},
        { "location": "36/TALK"   , "narrator": "キリト", "text": "…やめてくれ。"},
        { "location": "37/TALK"   , "narrator": "ヒカル", "text": "え？"},
        { "location": "40/TALK"   , "narrator": "キリト", "text": "ひなこを手伝うの…。\n今からでも、\n考え直せねぇか？"},
        { "location": "41/TALK"   , "narrator": "キリト", "text": "ひなこだけだったら、\nなにかしようとしてるのを\n管理庁が知ったところで。"},
        { "location": "42/TALK"   , "narrator": "キリト", "text": "きっと、厳重注意か\n自宅謹慎くらいで\n勘弁してもらえるはずさ。"},
        { "location": "43/TALK"   , "narrator": "キリト", "text": "けど…通常攻撃隊の\nおまえまで手伝ったら、\nかなり変わってくるぞ？"},
        { "location": "44/TALK"   , "narrator": "ヒカル", "text": "…だろうね。"},
        { "location": "45/TALK"   , "narrator": "ヒカル", "text": "運がよくて身柄拘束、\nってところかな？"},
        { "location": "46/TALK"   , "narrator": "キリト", "text": "忘れてるだろ？\n俺たち、逢瀬を庇って\n謹慎食らってんだぞ？"},
        { "location": "47/TALK"   , "narrator": "ヒカル", "text": "そっか…じゃあ、\n身柄拘束じゃ済まないね。"},
        { "location": "48/TALK"   , "narrator": "キリト", "text": "あのなぁ…。"},
        { "location": "49/TALK"   , "narrator": "ヒカル", "text": "二人とも、覚悟の上だよ。"},
        { "location": "50/TALK"   , "narrator": "キリト", "text": "いや、そうじゃなくて…。"},
        { "location": "51/TALK"   , "narrator": "ヒカル", "text": "？"},
        { "location": "52/TALK"   , "narrator": "キリト", "text": "…二人じゃ\nすまないんだよ。"},
        { "location": "53/TALK"   , "narrator": "ヒカル", "text": "どういうこと？"},
        { "location": "54/TALK"   , "narrator": "キリト", "text": "繭だよ。"},
        { "location": "55/TALK"   , "narrator": "キリト", "text": "ひなこだけならまだしも、\nおまえまで動くってのを\n知ったら…。"},
        { "location": "56/TALK"   , "narrator": "キリト", "text": "繭のヤツ、\n絶対に放っておいたりは\nしないはずなんだ。"},
        { "location": "57/TALK"   , "narrator": "ヒカル", "text": "そうかな？\n確かに、いつもだったら\nそうかもしれないけど…。"},
        { "location": "58/TALK"   , "narrator": "ヒカル", "text": "今回ばかりは、\nさすがにそれはないと\n思うけど？"},
        { "location": "59/TALK"   , "narrator": "キリト", "text": "いや、絶対手伝う。"},
        { "location": "60/TALK"   , "narrator": "キリト", "text": "口では何と言おうと、\n絶対に放っておけない\nはずだ。"},
        { "location": "61/TALK"   , "narrator": "キリト", "text": "昔から、あいつは\nそうだったからな…。"},
        { "location": "62/TALK"   , "narrator": "ヒカル", "text": "…そうなんだ？"},
        { "location": "63/TALK"   , "narrator": "キリト", "text": "ああ…でも、俺は繭に\nそんな危ないこと\nしてほしくないんだよ…。"},
        { "location": "64/TALK"   , "narrator": "ヒカル", "text": "…どうして、そんなに\n繭さんのことを？"},
        { "location": "65/TALK"   , "narrator": "キリト", "text": "あ、繭だけじゃねぇぞ！？\nおまえやひなこにだって\nしてほしくないからな？"},
        { "location": "66/TALK"   , "narrator": "ヒカル", "text": "…………。"},
        { "location": "67/TALK"   , "narrator": "キリト", "text": "だからさ…頼む！\nひなこを手伝うの、\nやめてくれ。"},
        { "location": "68/TALK"   , "narrator": "ヒカル", "text": "キリト…。"},
        { "location": "69/TALK"   , "narrator": "ヒカル", "text": "…ごめん。\nそれはできないよ。"},
        { "location": "70/TALK"   , "narrator": "キリト", "text": "なんで！？"},
        { "location": "71/TALK"   , "narrator": "ヒカル", "text": "キリトが繭さんを\n想ってるのと同じで…。"},
        { "location": "72/TALK"   , "narrator": "ヒカル", "text": "僕も…ひなこさんを\n放ってはおけないから…。"},
        { "location": "73/TALK"   , "narrator": "ヒカル", "text": "…キリトなら、\nわかってくれるよね？"},
        { "location": "74/TALK"   , "narrator": "キリト", "text": "…おい、まさかおまえ。"},
        { "location": "76/TALK"   , "narrator": "ヒカル", "text": "…………。"},
        { "location": "77/TALK"   , "narrator": "キリト", "text": "はぁ…そうだな。\nそれじゃあもう\n頼めないな…。"},
        { "location": "78/TALK"   , "narrator": "ヒカル", "text": "ごめんね…。"},
        { "location": "79/TALK"   , "narrator": "キリト", "text": "バカ、別に謝るようなこと\nしてないだろ？"},
        { "location": "81/TALK"   , "narrator": "ヒカル", "text": "そうだけど…。"},
        { "location": "82/TALK"   , "narrator": "ヒカル", "text": "でも…僕達これから、\nどうしたらいいのかな？"},
        { "location": "83/TALK"   , "narrator": "ヒカル", "text": "僕がひなこさんに\n協力したら、\n繭さんも動くし…。"},
        { "location": "84/TALK"   , "narrator": "キリト", "text": "おまえが協力しなきゃ、\nひなこは一人で勝手に\n動くもんな…。"},
        { "location": "85/TALK"   , "narrator": "ヒカル", "text": "…本当、どうすれば\nいいんだろ？"},
        { "location": "86/TALK"   , "narrator": "キリト", "text": "どうすればったって…、\nなにをするかは\n決めてるんだろ？"},
        { "location": "87/TALK"   , "narrator": "ヒカル", "text": "そうだけど…、\nキリトは\nなにも思わないの？"},
        { "location": "88/TALK"   , "narrator": "ヒカル", "text": "本当は、逢瀬さん達を\n助けるために…。"},
        { "location": "89/TALK"   , "narrator": "ヒカル", "text": "なにか行動したいと\n思ってるんじゃない？"},
        { "location": "90/TALK"   , "narrator": "キリト", "text": "…当然だろ。\nだから俺だって\n困ってるんだ…。"},
        { "location": "91/TALK"   , "narrator": "ヒカル", "text": "…どうしたらいいのかな？"},
        { "location": "92/TALK"   , "narrator": "キリト", "text": "さあな…ひなこや繭、\n綾水先輩達に相談したりも\nできないし…。"},
        { "location": "93/TALK"   , "narrator": "ヒカル", "text": "相談できる相手、か…。\n考えてみると、\nほとんどいないね。"},
        { "location": "94/TALK"   , "narrator": "キリト", "text": "だな…。\nしかも、相談内容的に\nできる相手といえば…。"},
        { "location": "95/TALK"   , "narrator": "キリト", "text": "…いや、待てよ？"},
        { "location": "96/TALK"   , "narrator": "ヒカル", "text": "え？"},
        { "location": "97/TALK"   , "narrator": "キリト", "text": "そうだよ、\n一人いるじゃねぇか！"},
        { "location": "98/TALK"   , "narrator": "キリト", "text": "ほら、忘れたのか！？\nひなこが言ってただろ。"},
        { "location": "99/TALK"   , "narrator": "キリト", "text": "逢瀬の大切な人ってのと、\n連絡が取れたって…。"},
        { "location": "100/TALK"  , "narrator": "ヒカル", "text": "…そういえば！\n言ってたよね？"},
        { "location": "101/TALK"  , "narrator": "キリト", "text": "ああ…逢瀬って、\nなにかある度に\nスマホ弄ってただろ？"},
        { "location": "102/TALK"  , "narrator": "キリト", "text": "あれってさ、もしかして\nその人に相談してたんじゃ\nねぇのか？"},
        { "location": "103/TALK"  , "narrator": "ヒカル", "text": "…確かに、その可能性は\n高いだろうね。"},
        { "location": "104/TALK"  , "narrator": "キリト", "text": "なら、俺たちもその人に\nアドバイスもらえないか\n聞いてみようぜ。"},
        { "location": "105/TALK"  , "narrator": "キリト", "text": "ひなこが言うには、\nその人も協力してくれる、\nってことらしいし…。"},
        { "location": "106/TALK"  , "narrator": "ヒカル", "text": "じゃあ、もしかしたら\n僕らの悩みにも\n答えてくれるかも。"},
        { "location": "110/TALK"  , "narrator": "キリト", "text": "…よし、逢瀬のＷＡＶＥに\n話しかけてみようぜ。"},
        { "location": "123/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "128/TALK"  , "narrator": "キリト", "text": "おーい"},
        { "location": "129/TALK"  , "narrator": "キリト", "text": "逢瀬の大切な人ってヤツ"},
        { "location": "130/TALK"  , "narrator": "キリト", "text": "これ見てるかー？"},
        { "location": "131/TALK"  , "narrator": "ヒカル", "text": "すみません、いませんか？"},
        { "location": "132/SEL"   , "narrator": "（選択肢）", "text": "誰もいませんよ"},
        { "location": "133/SEL"   , "narrator": "（選択肢）", "text": "$me$に用事かな？"},
        { "location": "134/ACT"   , "narrator": "", "text": "誰もいませんよ"},
        { "location": "135/TALK"  , "narrator": "キリト", "text": "いるじゃねぇか！！"},
        { "location": "136/TALK"  , "narrator": "ヒカル", "text": "ひなこさんの言う通り"},
        { "location": "137/TALK"  , "narrator": "ヒカル", "text": "本当にいたんですね！"},
        { "location": "138/ACT"   , "narrator": "", "text": "$me$に用事かな？"},
        { "location": "139/TALK"  , "narrator": "キリト", "text": "マジでいた！"},
        { "location": "140/TALK"  , "narrator": "ヒカル", "text": "ひなこさんの言っていたことは"},
        { "location": "141/TALK"  , "narrator": "ヒカル", "text": "本当だったんだね！"},
        { "location": "143/TALK"  , "narrator": "ヒカル", "text": "突然ですみません"},
        { "location": "144/TALK"  , "narrator": "ヒカル", "text": "実は僕達"},
        { "location": "145/TALK"  , "narrator": "ヒカル", "text": "あなたに相談したいことがあるんです"},
        { "location": "146/TALK"  , "narrator": "ヒカル", "text": "聞いていただけますか？"},
        { "location": "147/SEL"   , "narrator": "（選択肢）", "text": "内容にもよるけど"},
        { "location": "148/SEL"   , "narrator": "（選択肢）", "text": "つばめ達を助ける手助けになるなら"},
        { "location": "149/ACT"   , "narrator": "", "text": "内容にもよるけど"},
        { "location": "150/ACT"   , "narrator": "", "text": "つばめ達を助ける手助けになるなら"},
        { "location": "151/TALK"  , "narrator": "キリト", "text": "手助けになるのか？"},
        { "location": "152/TALK"  , "narrator": "ヒカル", "text": "場合によってはかな？"},
        { "location": "154/TALK"  , "narrator": "キリト", "text": "とにかくまずは聞いてくれ"},
        { "location": "155/TALK"  , "narrator": "キリト", "text": "俺たちはこれからどう動くべきか"},
        { "location": "156/TALK"  , "narrator": "キリト", "text": "そのことで悩んでるんだ"},
        { "location": "157/TALK"  , "narrator": "ヒカル", "text": "今のところ僕とひなこさんは"},
        { "location": "158/TALK"  , "narrator": "ヒカル", "text": "逢瀬さん達を助けるための行動を起こすつもりです"},
        { "location": "159/TALK"  , "narrator": "ヒカル", "text": "ちょっと不安はあるけど"},
        { "location": "160/TALK"  , "narrator": "キリト", "text": "俺はヒカルの逆だ"},
        { "location": "161/TALK"  , "narrator": "キリト", "text": "悪いけどさ"},
        { "location": "162/TALK"  , "narrator": "キリト", "text": "今回はなにもしないつもりなんだ"},
        { "location": "164/TALK"  , "narrator": "キリト", "text": "まあ"},
        { "location": "165/TALK"  , "narrator": "キリト", "text": "本当は何かしたいんだけど"},
        { "location": "166/TALK"  , "narrator": "キリト", "text": "事情があってな"},
        { "location": "167/TALK"  , "narrator": "ヒカル", "text": "僕達は逢瀬さん達を助けたいという想い"},
        { "location": "168/TALK"  , "narrator": "ヒカル", "text": "これが共通しています"},
        { "location": "169/TALK"  , "narrator": "ヒカル", "text": "でも、行動は真逆です"},
        { "location": "170/TALK"  , "narrator": "キリト", "text": "あんたはどう思う？"},
        { "location": "171/TALK"  , "narrator": "キリト", "text": "俺とヒカル"},
        { "location": "172/TALK"  , "narrator": "キリト", "text": "どっちの行動が正しいかな？"},
        { "location": "186/TALK"  , "narrator": "繭", "text": "…まったく、キリトと\n入れ替わりに入ってきて、\nなにを言うかと思えば…。"},
        { "location": "187/TALK"  , "narrator": "繭", "text": "ヒカルと一緒に、\n劇場に侵入するって？"},
        { "location": "188/TALK"  , "narrator": "雛", "text": "う、うん…。"},
        { "location": "189/TALK"  , "narrator": "繭", "text": "…………。"},
        { "location": "191/TALK"  , "narrator": "雛", "text": "えと、まゆちん。\nもしかして怒ってるー？"},
        { "location": "192/TALK"  , "narrator": "繭", "text": "…驚いてる、が正しいわ。"},
        { "location": "193/TALK"  , "narrator": "繭", "text": "まさか、キリトじゃなくて\nヒカルが賛成するなんて、\n意外過ぎるし…。"},
        { "location": "194/TALK"  , "narrator": "雛", "text": "…そうだね。\nあたしもさ、ちょっと\nビックリしちゃったよー。"},
        { "location": "195/TALK"  , "narrator": "雛", "text": "こういう時、なんだかんだ\n言っても手伝うって\n言うのは…。"},
        { "location": "196/TALK"  , "narrator": "雛", "text": "やっぱりキリトだろうな、\nって思ってたから…。"},
        { "location": "198/TALK"  , "narrator": "繭", "text": "…それ、期待してた？"},
        { "location": "199/TALK"  , "narrator": "雛", "text": "してなかった、って\n言うとウソになるかも…。"},
        { "location": "200/TALK"  , "narrator": "雛", "text": "でも、キリトが断るなんて\n余程のことでしょ？"},
        { "location": "201/TALK"  , "narrator": "雛", "text": "だから、キリトじゃなくて\nちょっと安心した、って\nいうのも本当だよ。"},
        { "location": "202/TALK"  , "narrator": "雛", "text": "もし来られたら、\n無理やり協力させてる\nみたいになるし…。"},
        { "location": "204/TALK"  , "narrator": "繭", "text": "…………。"},
        { "location": "205/TALK"  , "narrator": "雛", "text": "でも、結局ヒカルくんは\n無理やり協力させちゃった\nみたいなもんだよね…。"},
        { "location": "207/TALK"  , "narrator": "繭", "text": "一人で行動するから\nこういうことになるの…。\n反省しろ。"},
        { "location": "208/TALK"  , "narrator": "雛", "text": "…ごめんなさい。"},
        { "location": "209/TALK"  , "narrator": "繭", "text": "…まあ、いいけど。"},
        { "location": "210/TALK"  , "narrator": "繭", "text": "もう止めても無駄なら、\n私の手伝いをして\nもらうわ。"},
        { "location": "211/TALK"  , "narrator": "雛", "text": "え…？\nまさか、まゆちんも\n協力してくれるの！？"},
        { "location": "212/TALK"  , "narrator": "繭", "text": "勘違いするな。"},
        { "location": "213/TALK"  , "narrator": "繭", "text": "私は、最初から一人で\n動くつもりだった。"},
        { "location": "214/TALK"  , "narrator": "雛", "text": "えぇっ！？\nど、どうして！？"},
        { "location": "216/TALK"  , "narrator": "繭", "text": "それは…。"},
        { "location": "217/TALK"  , "narrator": "繭", "text": "…ＲＡＢＢＩＴＡＮＩＭＡ\nとしての活動は、ひなこに\n話せないし…。"},
        { "location": "219/TALK"  , "narrator": "繭", "text": "…私なりのやり方が\nあるからよ。"},
        { "location": "220/TALK"  , "narrator": "繭", "text": "その方法には、\nひなこ達の協力は\nいらないと思ったから…。"},
        { "location": "221/TALK"  , "narrator": "雛", "text": "まゆちんなりのやり方？\nそれって、どんななの？"},
        { "location": "222/TALK"  , "narrator": "繭", "text": "管理庁のシステムを\nハッキングして…。"},
        { "location": "223/TALK"  , "narrator": "繭", "text": "管理庁の機能を\n混乱させるの。"},
        { "location": "224/TALK"  , "narrator": "雛", "text": "えぇっ！？\nそんなの、一人でどうにか\nできるの！？"},
        { "location": "225/TALK"  , "narrator": "繭", "text": "…可能と思ったけど、\n無理だった。"},
        { "location": "226/TALK"  , "narrator": "繭", "text": "だから、ひなことヒカルに\n働いてもらいたい。"},
        { "location": "227/TALK"  , "narrator": "繭", "text": "成功すれば、逢瀬さんを\nすぐ救出はできなくても。"},
        { "location": "228/TALK"  , "narrator": "繭", "text": "みやび先輩達にとって、\n大きな助けになるはずよ。"},
        { "location": "229/TALK"  , "narrator": "雛", "text": "…本当？"},
        { "location": "230/TALK"  , "narrator": "繭", "text": "ひなこ達が\nちゃんと動ければね。"},
        { "location": "231/TALK"  , "narrator": "雛", "text": "…わかった。\nそれで、あたし達は\nなにをすれば――"},
        { "location": "232/TALK"  , "narrator": "繭", "text": "その前に、一つ条件を\n言っておく。"},
        { "location": "233/TALK"  , "narrator": "繭", "text": "今言った通り、\n私は今からひなこ達に\n協力する。"},
        { "location": "234/TALK"  , "narrator": "繭", "text": "けど、このことは絶対に\nキリトに言わないこと。"},
        { "location": "235/TALK"  , "narrator": "雛", "text": "え…キリトにだけ\n秘密にするの？"},
        { "location": "236/TALK"  , "narrator": "繭", "text": "そうよ…。\nあいつにだけは、\n絶対に秘密。"},
        { "location": "237/TALK"  , "narrator": "雛", "text": "でも、キリトだって\n本心はつばめちゃん達を\n助けたいはずだよ？"},
        { "location": "238/TALK"  , "narrator": "雛", "text": "だから、あたし達が\n動くことを知れば、\nきっとキリトも――"},
        { "location": "239/TALK"  , "narrator": "繭", "text": "常識的に考えて。\nあの時のキリトの判断は、\nまともなものだった…。"},
        { "location": "240/TALK"  , "narrator": "繭", "text": "…らしくない判断とは\n思ったけど、間違いなく\nまともな判断だった。"},
        { "location": "241/TALK"  , "narrator": "繭", "text": "…あの熱血バカが、\n自分を殺してまで。"},
        { "location": "242/TALK"  , "narrator": "繭", "text": "初めて、まともな行動を\n取っているの。"},
        { "location": "243/TALK"  , "narrator": "繭", "text": "だから…私はそれを、\n邪魔したくない…。"},
        { "location": "244/TALK"  , "narrator": "雛", "text": "…まゆちん。"},
        { "location": "245/TALK"  , "narrator": "雛", "text": "…わかった。\nキリトにはこのこと、\n秘密にするよ。"},
        { "location": "246/TALK"  , "narrator": "繭", "text": "…約束よ。"},
        { "location": "247/TALK"  , "narrator": "雛", "text": "うん…。"},
        { "location": "248/TALK"  , "narrator": "繭", "text": "…けど、その分ヒカルには\n結構働いてもらわないと\nいけないけど…。"},
        { "location": "249/TALK"  , "narrator": "雛", "text": "あはは、大丈夫だよ。\nあたしもヒカルくんのこと\n手伝うし…。"},
        { "location": "250/TALK"  , "narrator": "雛", "text": "キリトみたいには\nいかないと思うけど、\n全力でサポートするよ。"},
        { "location": "251/TALK"  , "narrator": "繭", "text": "…期待してるわ。"},
        { "location": "270/TALK"  , "narrator": "キリト", "text": "随分長く考えてるな"},
        { "location": "271/TALK"  , "narrator": "キリト", "text": "やっぱ"},
        { "location": "272/TALK"  , "narrator": "キリト", "text": "難しい問題か？"},
        { "location": "273/SEL"   , "narrator": "（選択肢）", "text": "個人の意思で動くしかない"},
        { "location": "274/ACT"   , "narrator": "", "text": "個人の意思で動くしかない"},
        { "location": "276/TALK"  , "narrator": "キリト", "text": "すっげー待ったのに無難な答えかよ"},
        { "location": "277/TALK"  , "narrator": "キリト", "text": "ガッカリだぜ"},
        { "location": "278/TALK"  , "narrator": "ヒカル", "text": "でも"},
        { "location": "279/TALK"  , "narrator": "ヒカル", "text": "結局それしかないんだよ"},
        { "location": "280/TALK"  , "narrator": "ヒカル", "text": "僕もキリトも"},
        { "location": "281/TALK"  , "narrator": "ヒカル", "text": "簡単に答えは変わらないんだし"},
        { "location": "282/TALK"  , "narrator": "キリト", "text": "そうだけど"},
        { "location": "283/TALK"  , "narrator": "キリト", "text": "ヒカルとひなこだけってのは"},
        { "location": "284/TALK"  , "narrator": "キリト", "text": "やっぱ無謀すぎだろ"},
        { "location": "285/TALK"  , "narrator": "ヒカル", "text": "今更それを言うの？"},
        { "location": "286/TALK"  , "narrator": "キリト", "text": "でも事実だろ？"},
        { "location": "287/SEL"   , "narrator": "（選択肢）", "text": "少ない方が動きやすいと思う"},
        { "location": "288/SEL"   , "narrator": "（選択肢）", "text": "雛とヒカルだけじゃないよ"},
        { "location": "289/SEL"   , "narrator": "（選択肢）", "text": "不安がってちゃ上手くいかない"},
        { "location": "290/ACT"   , "narrator": "", "text": "少ない方が動きやすいと思う"},
        { "location": "291/TALK"  , "narrator": "キリト", "text": "そうかもしれないけど"},
        { "location": "292/TALK"  , "narrator": "ヒカル", "text": "もうやめようよキリト"},
        { "location": "294/TALK"  , "narrator": "ヒカル", "text": "何を言われようと"},
        { "location": "295/TALK"  , "narrator": "ヒカル", "text": "僕とひなこさんはやめないし"},
        { "location": "296/TALK"  , "narrator": "ヒカル", "text": "キリトだって繭さんのために"},
        { "location": "297/TALK"  , "narrator": "ヒカル", "text": "静観することを決めたんでしょ？"},
        { "location": "298/TALK"  , "narrator": "ヒカル", "text": "なら"},
        { "location": "299/TALK"  , "narrator": "ヒカル", "text": "これ以上話しても無駄だよ"},
        { "location": "301/TALK"  , "narrator": "キリト", "text": "上手くいくと思うか？"},
        { "location": "302/TALK"  , "narrator": "ヒカル", "text": "上手くやらないとね"},
        { "location": "303/TALK"  , "narrator": "ヒカル", "text": "逢瀬さん達や"},
        { "location": "304/TALK"  , "narrator": "ヒカル", "text": "勇気を出したひなこさんのためにも"},
        { "location": "306/TALK"  , "narrator": "ヒカル", "text": "相談に乗ってくれて"},
        { "location": "307/TALK"  , "narrator": "ヒカル", "text": "ありがとうございました"},
        { "location": "308/TALK"  , "narrator": "ヒカル", "text": "それでは"},
        { "location": "309/TALK"  , "narrator": "システム", "text": "【安茂里ヒカル】さんが\nログアウトしました"},
        { "location": "311/ACT"   , "narrator": "", "text": "雛とヒカルだけじゃないよ"},
        { "location": "312/TALK"  , "narrator": "キリト", "text": "俺は協力しないって言っただろ？"},
        { "location": "313/TALK"  , "narrator": "ヒカル", "text": "そうですよ"},
        { "location": "314/TALK"  , "narrator": "ヒカル", "text": "僕とひなこさんだけですよ"},
        { "location": "315/SEL"   , "narrator": "（選択肢）", "text": "繭も動くことになった"},
        { "location": "316/ACT"   , "narrator": "", "text": "繭も動くことになった"},
        { "location": "318/TALK"  , "narrator": "キリト", "text": "は！？"},
        { "location": "319/TALK"  , "narrator": "キリト", "text": "そんな話聞いてないぞ！"},
        { "location": "320/TALK"  , "narrator": "ヒカル", "text": "僕も初耳です"},
        { "location": "321/TALK"  , "narrator": "ヒカル", "text": "どういうことですか？"},
        { "location": "322/SEL"   , "narrator": "（選択肢）", "text": "キリト、本当にわからない？"},
        { "location": "323/SEL"   , "narrator": "（選択肢）", "text": "ヒカル、ちょっと考えてみて"},
        { "location": "324/ACT"   , "narrator": "", "text": "キリト、本当にわからない？"},
        { "location": "326/TALK"  , "narrator": "キリト", "text": "なるほど"},
        { "location": "327/TALK"  , "narrator": "キリト", "text": "そういうことか"},
        { "location": "328/TALK"  , "narrator": "キリト", "text": "うっかりしてた"},
        { "location": "329/ACT"   , "narrator": "", "text": "ヒカル、ちょっと考えてみて"},
        { "location": "331/TALK"  , "narrator": "ヒカル", "text": "もしかして"},
        { "location": "332/TALK"  , "narrator": "ヒカル", "text": "ひなこさんが説得したんですか？"},
        { "location": "333/TALK"  , "narrator": "キリト", "text": "いや違う！"},
        { "location": "334/TALK"  , "narrator": "キリト", "text": "うっかりしてた"},
        { "location": "336/TALK"  , "narrator": "キリト", "text": "繭だもんな？"},
        { "location": "337/TALK"  , "narrator": "キリト", "text": "あいつのことだから"},
        { "location": "338/TALK"  , "narrator": "キリト", "text": "最初から一人で動く気でいたに決まってるよな"},
        { "location": "369/SEL"   , "narrator": "（選択肢）", "text": "どうかした？"},
        { "location": "370/ACT"   , "narrator": "", "text": "どうかした？"},
        { "location": "372/TALK"  , "narrator": "キリト", "text": "ヒカルと話してた"},
        { "location": "373/TALK"  , "narrator": "キリト", "text": "これからなにするのか"},
        { "location": "374/TALK"  , "narrator": "キリト", "text": "俺も逢瀬達を助けるために動くぞ"},
        { "location": "375/TALK"  , "narrator": "ヒカル", "text": "本当にいいの？"},
        { "location": "376/TALK"  , "narrator": "キリト", "text": "最初からそうしたいと思ってたからな"},
        { "location": "377/TALK"  , "narrator": "キリト", "text": "それに"},
        { "location": "378/TALK"  , "narrator": "キリト", "text": "繭が動く以上は我慢する必要もないし"},
        { "location": "379/TALK"  , "narrator": "キリト", "text": "それにしてもマヌケだった"},
        { "location": "380/TALK"  , "narrator": "キリト", "text": "繭なら一人で動くことをまず考えるはず"},
        { "location": "381/TALK"  , "narrator": "キリト", "text": "それに気づけなかったなんて"},
        { "location": "382/TALK"  , "narrator": "ヒカル", "text": "気づけたんだからよかったよ"},
        { "location": "383/TALK"  , "narrator": "ヒカル", "text": "そうだな"},
        { "location": "384/TALK"  , "narrator": "キリト", "text": "きっかけをくれたあんたのおかげだ"},
        { "location": "385/TALK"  , "narrator": "キリト", "text": "ありがとな！"},
        { "location": "386/SEL"   , "narrator": "（選択肢）", "text": "礼はいいからみんなを助けて！"},
        { "location": "387/SEL"   , "narrator": "（選択肢）", "text": "気にするな、友達だろ？"},
        { "location": "388/SEL"   , "narrator": "（選択肢）", "text": "我を敬いたまえ"},
        { "location": "389/ACT"   , "narrator": "", "text": "礼はいいからみんなを助けて！"},
        { "location": "390/TALK"  , "narrator": "キリト", "text": "任せろ！"},
        { "location": "391/TALK"  , "narrator": "ヒカル", "text": "任せてください！"},
        { "location": "392/ACT"   , "narrator": "", "text": "気にするな、友達だろ？"},
        { "location": "394/TALK"  , "narrator": "キリト", "text": "そうだな"},
        { "location": "395/TALK"  , "narrator": "キリト", "text": "俺たちもう友達だよな！"},
        { "location": "396/TALK"  , "narrator": "ヒカル", "text": "また一緒に話しましょうね"},
        { "location": "397/ACT"   , "narrator": "", "text": "我を敬いたまえ"},
        { "location": "398/TALK"  , "narrator": "キリト", "text": "あんたって"},
        { "location": "399/TALK"  , "narrator": "キリト", "text": "面白い人なんだな？"},
        { "location": "400/TALK"  , "narrator": "キリト", "text": "気に入ったぜ"},
        { "location": "401/TALK"  , "narrator": "ヒカル", "text": "またお話ししましょうね"},
        { "location": "404/ACT"   , "narrator": "", "text": "不安がってちゃ上手くいかない"},
        { "location": "405/TALK"  , "narrator": "ヒカル", "text": "そうだよ"},
        { "location": "406/TALK"  , "narrator": "ヒカル", "text": "無謀とか思ってたら"},
        { "location": "407/TALK"  , "narrator": "ヒカル", "text": "上手くいくものもいかなくなるよ"},
        { "location": "408/TALK"  , "narrator": "ヒカル", "text": "それに"}
    ]
}
