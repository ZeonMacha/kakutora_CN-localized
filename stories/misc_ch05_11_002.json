    "entry":
    [
        { "location": "2958/SCENARIO", "narrator": "", "text": "激甘ペペロンチーノ"},
        { "location": "2983/TALK"    , "narrator": "神楽", "text": "季節限定ペペロンチーノに"},
        { "location": "2984/TALK"    , "narrator": "神楽", "text": "いちごフレーバーが登場♪"},
        { "location": "2985/TALK"    , "narrator": "神楽", "text": "今だけだから急いで急いで！"},
        { "location": "2987/SEL"     , "narrator": "", "text": "遠慮します"},
        { "location": "2988/SEL"     , "narrator": "", "text": "機会があったらね"},
        { "location": "2989/SEL"     , "narrator": "", "text": "神楽と一緒なら食べてもいいよ"},
        { "location": "2990/ACT"     , "narrator": "", "text": "遠慮します"},
        { "location": "2991/TALK"    , "narrator": "神楽", "text": "つまらんなー"},
        { "location": "2992/ACT"     , "narrator": "", "text": "機会があったらね"},
        { "location": "2993/TALK"    , "narrator": "神楽", "text": "大人な対応ですのう"},
        { "location": "2994/ACT"     , "narrator": "", "text": "神楽と一緒なら食べてもいいよ"},
        { "location": "2996/TALK"    , "narrator": "神楽", "text": "お？"},
        { "location": "2997/TALK"    , "narrator": "神楽", "text": "イイネイイネ！"},
        { "location": "2998/TALK"    , "narrator": "神楽", "text": "二人分頼もう！"},
        { "location": "3000/TALK"    , "narrator": "神楽", "text": "$handlek$が二人分食べてね♪"},
        { "location": "3002/TALK"    , "narrator": "神楽", "text": "甘じょっぱスイーツ一時はやったけど"},
        { "location": "3003/TALK"    , "narrator": "神楽", "text": "さすがにペペロンチーノにいちごはないかなーなんて思ってる"},
        { "location": "3005/SEL"     , "narrator": "", "text": "神楽の手料理ならアリ"},
        { "location": "3006/SEL"     , "narrator": "", "text": "あんまり甘くないやつなら…"},
        { "location": "3007/SEL"     , "narrator": "", "text": "ないな！"},
        { "location": "3008/ACT"     , "narrator": "", "text": "神楽の手料理ならアリ"},
        { "location": "3010/TALK"    , "narrator": "神楽", "text": "$handlek$はそう言えばぴょんこがご機嫌になると思ってるんでしょ"},
        { "location": "3011/TALK"    , "narrator": "神楽", "text": "あんまりぴょんこをなめないでよね！？"},
        { "location": "3012/TALK"    , "narrator": "神楽", "text": "まあ実際ご機嫌なんだけど？"},
        { "location": "3014/ACT"     , "narrator": "", "text": "あんまり甘くないやつなら…"},
        { "location": "3015/TALK"    , "narrator": "神楽", "text": "うわ"},
        { "location": "3016/TALK"    , "narrator": "神楽", "text": "チャレンジャー発見"},
        { "location": "3017/ACT"     , "narrator": "", "text": "ないな！"},
        { "location": "3018/TALK"    , "narrator": "神楽", "text": "ないか！"},
        { "location": "3019/TALK"    , "narrator": "神楽", "text": "やっぱりね！"},
        { "location": "3021/TALK"    , "narrator": "神楽", "text": "新しいことをしようとして奇をてらいすぎても失敗する"},
        { "location": "3022/TALK"    , "narrator": "神楽", "text": "それの象徴がいちごペペロンチーノ"},
        { "location": "3023/TALK"    , "narrator": "神楽", "text": "その逆に普通のペペロンチーノはいつでもおいしい"},
        { "location": "3024/TALK"    , "narrator": "神楽", "text": "この場合の問題は料理の腕だけぴょん"}
    ]
}
