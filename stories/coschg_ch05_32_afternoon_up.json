        { "location": "1015/TALK", "narrator": "神楽", "text": "知ってるし"},
        { "location": "1016/TALK", "narrator": "神楽", "text": "ぴょんこに用事ぴょん？"},
        { "location": "1019/SEL" , "narrator": "", "text": "ちょっと着替えてほしいんだ"},
        { "location": "1020/ACT" , "narrator": "", "text": "ちょっと着替えてほしいんだ"},
        { "location": "1030/TALK", "narrator": "神楽", "text": "意味不明すぎ"},
        { "location": "1031/TALK", "narrator": "神楽", "text": "でもまあ"},
        { "location": "1032/TALK", "narrator": "神楽", "text": "優しいぴょんこは聞いてあげるのだった"},
        { "location": "1034/TALK", "narrator": "神楽", "text": "は？"},
        { "location": "1035/TALK", "narrator": "神楽", "text": "この服変だった？"},
        { "location": "1036/TALK", "narrator": "神楽", "text": "なら着替えるけど"},
        { "location": "1039/SEL" , "narrator": "", "text": "$me$が選ぶ"},
