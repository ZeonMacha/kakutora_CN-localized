        { "location": "996/TALK" , "narrator": "プレイヤー", "text": "よし、お着替えタイムだ！"},
        { "location": "1002/TALK", "narrator": "プレイヤー", "text": "やあ"},
        { "location": "1004/TALK", "narrator": "プレイヤー", "text": "こんにちは"},
        { "location": "1006/TALK", "narrator": "プレイヤー", "text": "げんき？"},
        { "location": "1009/TALK", "narrator": "神楽", "text": "ぴょんこを呼ぶ声"},
        { "location": "1010/TALK", "narrator": "神楽", "text": "あなたはだあれ？"},
