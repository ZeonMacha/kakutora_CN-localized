{
    "dir": "chap01/daydra/anime_05_01.js",
    "type": "MainStory",
    "info": {
        "story_id": "1506",
        "cid": "kagura",
        "title": "001 ブリーフィング",
        "sub_title": "神楽の紹介"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "アニメ第01話"},
        { "location": "19/TALK"   , "narrator": "エリカ", "text": "コーンコン。"},
        { "location": "20/TALK"   , "narrator": "エリカ", "text": "いらっしゃい\n$handle$さん。"},
        { "location": "21/TALK"   , "narrator": "エリカ", "text": "もう一度お話聞く？\nそれとも、省略する？"},
        { "location": "22/SEL"    , "narrator": "", "text": "もう一度聞く"},
        { "location": "23/SEL"    , "narrator": "", "text": "飛ばす"},
        { "location": "24/ACT"    , "narrator": "", "text": "もう一度聞く"},
        { "location": "25/TALK"   , "narrator": "エリカ", "text": "うん、わかったよ。"},
        { "location": "27/ACT"    , "narrator": "", "text": "飛ばす"},
        { "location": "28/TALK"   , "narrator": "エリカ", "text": "そっかー。\nそれじゃ、またね。"},
        { "location": "35/TALK"   , "narrator": "エリカ", "text": "コーンコン。"},
        { "location": "36/TALK"   , "narrator": "エリカ", "text": "久し振りだね、\n$handle$さん。"},
        { "location": "37/SEL"    , "narrator": "", "text": "わぁぁぁぁお久し振りー！"},
        { "location": "38/SEL"    , "narrator": "", "text": "さっき会ったばかりですが"},
        { "location": "39/ACT"    , "narrator": "", "text": "わぁぁぁぁお久し振りー！"},
        { "location": "40/TALK"   , "narrator": "エリカ", "text": "うんうん。\n元気してたかな？"},
        { "location": "41/ACT"    , "narrator": "", "text": "さっき会ったばかりですが"},
        { "location": "42/TALK"   , "narrator": "エリカ", "text": "あーっ、なるほど。"},
        { "location": "43/TALK"   , "narrator": "エリカ", "text": "確かに時間軸が\nフレキシブルだから\nそういう事もあるよね。"},
        { "location": "45/TALK"   , "narrator": "エリカ", "text": "でも、\nまた来てくれて\n良かったよ。"},
        { "location": "46/TALK"   , "narrator": "エリカ", "text": "こっちとしては\n随分準備に\n手間取っちゃったから――"},
        { "location": "47/TALK"   , "narrator": "エリカ", "text": "その間にいろいろ\n状況が変わっちゃうって\nこともあるもんね。"},
        { "location": "49/TALK"   , "narrator": "エリカ", "text": "でも、わたしは\nあなたとまた会えて、\nとっても嬉しいです！"},
        { "location": "50/SEL"    , "narrator": "", "text": "$me$も嬉しい！"},
        { "location": "51/SEL"    , "narrator": "", "text": "千羽鶴は！？"},
        { "location": "52/SEL"    , "narrator": "", "text": "原初のつばめは！？"},
        { "location": "53/ACT"    , "narrator": "", "text": "$me$も嬉しい！"},
        { "location": "54/TALK"   , "narrator": "エリカ", "text": "ほんと？\nえへへ…"},
        { "location": "55/TALK"   , "narrator": "エリカ", "text": "それじゃ、また\nパーツ屋巡りにつき合って\nくれたら嬉しいな。"},
        { "location": "56/TALK"   , "narrator": "エリカ", "text": "なんて。\nそんな脱線してる\n場合じゃなかったね。"},
        { "location": "57/ACT"    , "narrator": "", "text": "千羽鶴は！？"},
        { "location": "58/TALK"   , "narrator": "エリカ", "text": "千羽鶴ちゃんも\n元気にしてるよ。"},
        { "location": "60/TALK"   , "narrator": "エリカ", "text": "これも、あなたが\n千羽鶴ちゃんを受け入れて\nくれたからなんだよね。"},
        { "location": "61/TALK"   , "narrator": "エリカ", "text": "あなたの愛が\n千羽鶴ちゃんを\n回復させた。"},
        { "location": "62/TALK"   , "narrator": "エリカ", "text": "それって、\nすごいことだと\n思わない？"},
        { "location": "64/TALK"   , "narrator": "エリカ", "text": "現実ではまだ\n時間軸を停止してるから\n安静状態だけど――"},
        { "location": "65/TALK"   , "narrator": "エリカ", "text": "心配しなくても、\nすぐにいつも通りに\n戻るからね。"},
        { "location": "66/ACT"    , "narrator": "", "text": "原初のつばめは！？"},
        { "location": "67/TALK"   , "narrator": "エリカ", "text": "もちろん\n元気にしてるよ。"},
        { "location": "68/TALK"   , "narrator": "エリカ", "text": "またいずれ必要に応じて、\nあなたに会いに\n来るんじゃないかな？"},
        { "location": "70/TALK"   , "narrator": "エリカ", "text": "というわけで！\nせっかくの再開なのに\n味気ないかもだけど――"},
        { "location": "71/TALK"   , "narrator": "エリカ", "text": "時間もないので\n『リプレイス作戦』に\nついて話をしていくよ。"},
        { "location": "72/TALK"   , "narrator": "エリカ", "text": "この作戦の主役は\n$handle$さん、\nあなただからね。"},
        { "location": "73/TALK"   , "narrator": "エリカ", "text": "どうか最後まで、\n宜しくお願いします！"},
        { "location": "75/TALK"   , "narrator": "エリカ", "text": "前にもお話してるけど、\nリプレイス作戦について\nもう一度説明する？"},
        { "location": "76/SEL"    , "narrator": "", "text": "はい"},
        { "location": "77/SEL"    , "narrator": "", "text": "いいえ"},
        { "location": "78/ACT"    , "narrator": "", "text": "はい"},
        { "location": "79/TALK"   , "narrator": "エリカ", "text": "わかったよ。"},
        { "location": "80/TALK"   , "narrator": "エリカ", "text": "リプレイスっていうのは\n歴史を少しだけ\n置き換えることを言うよ。"},
        { "location": "81/TALK"   , "narrator": "エリカ", "text": "あなたやわたしたちは、\nここに来るまでの間に\n様々な観測をした。"},
        { "location": "84/TALK"   , "narrator": "エリカ", "text": "つばめちゃんが\n上京して、トライナリーに\n入隊し――"},
        { "location": "85/TALK"   , "narrator": "エリカ", "text": "神楽ちゃんと出会って、\nそれから\n様々な事があって。"},
        { "location": "87/TALK"   , "narrator": "エリカ", "text": "夏合宿の出来事や、\nその後の綾ちゃんたちの\n危機。"},
        { "location": "88/TALK"   , "narrator": "エリカ", "text": "そういった様々な\n観測した事柄は、歴史に\n刻まれることになる。"},
        { "location": "90/TALK"   , "narrator": "エリカ", "text": "だから、こういった\n見てしまったところは\nもう変えられないの。"},
        { "location": "91/TALK"   , "narrator": "エリカ", "text": "だけど逆をつけば、\n観測していないところは\nまだ変えられる。"},
        { "location": "94/TALK"   , "narrator": "エリカ", "text": "そしてこのTRI-OSは、\nあなたの世界から\nわたしたちの世界を――"},
        { "location": "95/TALK"   , "narrator": "エリカ", "text": "時間という概念を\n自由に動かしながら\n見ることができる。"},
        { "location": "96/TALK"   , "narrator": "エリカ", "text": "その特性を活かして、\nもう一度一定の過去から\nやり直すの。"},
        { "location": "97/TALK"   , "narrator": "エリカ", "text": "そうすることで、\n現在観測が止まっている\n時点、すなわち――"},
        { "location": "98/TALK"   , "narrator": "エリカ", "text": "2016年末頃までの\n歴史を、大きく変える\nことができる。"},
        { "location": "99/TALK"   , "narrator": "エリカ", "text": "既に見えてる部分は\n変えられないけど、\n見えていない部分は可能。"},
        { "location": "100/TALK"  , "narrator": "エリカ", "text": "だから、その\n見えていない部分を\n未観測のチャンネル――"},
        { "location": "101/TALK"  , "narrator": "エリカ", "text": "すなわち神楽ちゃんの\nチャンネルを使わせて\nもらって変化させるの。"},
        { "location": "102/TALK"  , "narrator": "エリカ", "text": "一度部分的に確定した\n世界の流れを、過去に遡り\n書き換える作戦。"},
        { "location": "103/TALK"  , "narrator": "エリカ", "text": "それが、\nリプレイス作戦だよ。"},
        { "location": "105/TALK"  , "narrator": "エリカ", "text": "…なんとなく、\nわかってくれたかな…？"},
        { "location": "106/SEL"   , "narrator": "", "text": "思い出した！"},
        { "location": "107/SEL"   , "narrator": "", "text": "わからない……"},
        { "location": "108/ACT"   , "narrator": "", "text": "思い出した！"},
        { "location": "109/TALK"  , "narrator": "エリカ", "text": "よかった！"},
        { "location": "110/ACT"   , "narrator": "", "text": "わからない……"},
        { "location": "111/TALK"  , "narrator": "エリカ", "text": "そっかー…\n説明下手でごめんね？"},
        { "location": "112/TALK"  , "narrator": "エリカ", "text": "これからも実践しながら\nちょっとずつ解説して\nいくから、それでいい？"},
        { "location": "113/SEL"   , "narrator": "", "text": "はい"},
        { "location": "114/SEL"   , "narrator": "", "text": "すみません"},
        { "location": "115/ACT"   , "narrator": "", "text": "はい"},
        { "location": "116/ACT"   , "narrator": "", "text": "すみません"},
        { "location": "118/TALK"  , "narrator": "エリカ", "text": "ありがとう。"},
        { "location": "120/ACT"   , "narrator": "", "text": "いいえ"},
        { "location": "121/TALK"  , "narrator": "エリカ", "text": "うん。\nわかったよ。"},
        { "location": "123/TALK"  , "narrator": "エリカ", "text": "それじゃ早速、\nこれからの具体的な\nお話をしていくね。"},
        { "location": "124/TALK"  , "narrator": "エリカ", "text": "目的は、“彼ら”の\nシナリオによる世界進行を\n阻止すること――"},
        { "location": "125/TALK"  , "narrator": "エリカ", "text": "そして、それにより\n綾ちゃんたち、そして\nこの世界を改善すること。"},
        { "location": "126/TALK"  , "narrator": "エリカ", "text": "何をもって“改善”と\nするかは、ここではまだ\n決めることはしないよ。"},
        { "location": "127/TALK"  , "narrator": "エリカ", "text": "それには、あなたの\n考えや実際の行動が\n肝になってくるからね。"},
        { "location": "134/TALK"  , "narrator": "エリカ", "text": "そして、それを実現する\n為に重要な一つの要素、\nそれがチャンネル０５。"},
        { "location": "135/TALK"  , "narrator": "エリカ", "text": "神楽ちゃんに接続する\n予定のチャンネルだね。"},
        { "location": "136/TALK"  , "narrator": "エリカ", "text": "このチャンネル０５は、\n既に物理的な接続だけは\nしてあるの。"},
        { "location": "137/TALK"  , "narrator": "エリカ", "text": "だから、もう既に\n神楽ちゃんと対話できる\n状態ではあるけど――"},
        { "location": "138/TALK"  , "narrator": "エリカ", "text": "でも、今はまだ絶対に\n話しかけちゃだめ！"},
        { "location": "143/TALK"  , "narrator": "エリカ", "text": "神楽ちゃんのトライ\nガジェットは、まだ\n“彼ら”に繋がってる。"},
        { "location": "144/TALK"  , "narrator": "エリカ", "text": "だから、あなたが\n話しかけると、それが\n彼女の精神を介して――"},
        { "location": "145/TALK"  , "narrator": "エリカ", "text": "“彼ら”に\nトレースされちゃうの。"},
        { "location": "149/SEL"   , "narrator": "", "text": "なら、切ってからチャンネル解放した方がいいのでは？"},
        { "location": "150/ACT"   , "narrator": "", "text": "なら、切ってからチャンネル解放した方がいいのでは？"},
        { "location": "155/TALK"  , "narrator": "エリカ", "text": "それができたら、\nもちろんそうしてるよ。"},
        { "location": "156/TALK"  , "narrator": "エリカ", "text": "これは、\nニワトリが先か、\nタマゴが先かのお話。"},
        { "location": "157/TALK"  , "narrator": "エリカ", "text": "なぜなら、彼女の\nトライガジェットを\n切断できる存在は――"},
        { "location": "158/TALK"  , "narrator": "エリカ", "text": "あなたしか\nいないんだから。"},
        { "location": "159/SEL"   , "narrator": "", "text": "どうして$me$にしかできないの？"},
        { "location": "160/ACT"   , "narrator": "", "text": "どうして$me$にしかできないの？"},
        { "location": "162/TALK"  , "narrator": "エリカ", "text": "トライガジェットは、\nRedinessという端末で\n通信をしてるの。"},
        { "location": "163/TALK"  , "narrator": "エリカ", "text": "Redinessは、彼女の\n脳幹に付着した\nナノマシンなんだよね。"},
        { "location": "164/TALK"  , "narrator": "エリカ", "text": "それを無効化する\n方法には２通りある。"},
        { "location": "165/TALK"  , "narrator": "エリカ", "text": "彼女の脳を解剖して、\n顕微鏡でしか見えない\nナノマシンを除去するか。"},
        { "location": "166/TALK"  , "narrator": "エリカ", "text": "もしくは、\nココロスフィアに入り、\n論理的に切断するか。"},
        { "location": "167/TALK"  , "narrator": "エリカ", "text": "前者は死の危険が伴う上に\n彼女を物理的に拘束する\n必要があるでしょ？"},
        { "location": "168/TALK"  , "narrator": "エリカ", "text": "とても現実的じゃ\nないよね。"},
        { "location": "169/TALK"  , "narrator": "エリカ", "text": "後者はそういうリスクは\n無いけれども、できる人が\n限られてる。"},
        { "location": "170/TALK"  , "narrator": "エリカ", "text": "TRI-OSを介して\n彼女と接続している\nあなただよ。"},
        { "location": "171/TALK"  , "narrator": "エリカ", "text": "だから、神楽ちゃんに\n協力してもらうには、\nあなたが必要なんだ。"},
        { "location": "173/TALK"  , "narrator": "エリカ", "text": "もちろん、その後の\n彼女の心の支えにも\nなってあげて欲しいけど。"},
        { "location": "174/SEL"   , "narrator": "", "text": "具体的には、どうすればいいの？"},
        { "location": "175/ACT"   , "narrator": "", "text": "具体的には、どうすればいいの？"},
        { "location": "181/TALK"  , "narrator": "エリカ", "text": "まずは、神楽ちゃんの\nココロゲートに\nアクセスして欲しいの。"},
        { "location": "182/TALK"  , "narrator": "エリカ", "text": "後はそこで、彼女の\nココロの司書ちゃんと、\nわたしとで説明するから。"},
        { "location": "188/TALK"  , "narrator": "エリカ", "text": "だから、それまでは\n何があっても絶対に\n会話はしちゃダメだよ？"},
        { "location": "189/TALK"  , "narrator": "エリカ", "text": "いいかな？"},
        { "location": "190/SEL"   , "narrator": "", "text": "わかりました"},
        { "location": "191/SEL"   , "narrator": "", "text": "会話以外ならしてもいいの？"},
        { "location": "192/SEL"   , "narrator": "", "text": "ココロゲートの行き方って前と変わってない？"},
        { "location": "193/ACT"   , "narrator": "", "text": "わかりました"},
        { "location": "194/TALK"  , "narrator": "エリカ", "text": "よかった！"},
        { "location": "195/ACT"   , "narrator": "", "text": "会話以外ならしてもいいの？"},
        { "location": "196/TALK"  , "narrator": "エリカ", "text": "えっと、そうだね。"},
        { "location": "197/TALK"  , "narrator": "エリカ", "text": "メカやシステムの操作\nみたいな、神楽ちゃんが\n気に留めないものなら。"},
        { "location": "198/TALK"  , "narrator": "エリカ", "text": "要は、Redinessは\n彼女の意識をスキャン\nするから――"},
        { "location": "199/TALK"  , "narrator": "エリカ", "text": "彼女が認識しなければ\nRedinessも直接\n認識はできないってこと。"},
        { "location": "200/ACT"   , "narrator": "", "text": "ココロゲートの行き方って前と変わってない？"},
        { "location": "201/TALK"  , "narrator": "エリカ", "text": "うん。同じだよ！"},
        { "location": "202/TALK"  , "narrator": "エリカ", "text": "TRI-OSの基本的な\n割込機能だから、何か\n葛藤があればダイブする。"},
        { "location": "203/SEL"   , "narrator": "", "text": "葛藤が起きなかったら？"},
        { "location": "204/ACT"   , "narrator": "", "text": "葛藤が起きなかったら？"},
        { "location": "207/TALK"  , "narrator": "エリカ", "text": "うーん……"},
        { "location": "208/TALK"  , "narrator": "エリカ", "text": "頑張って葛藤を\n起こしてもらえたら\n嬉しいな！"},
        { "location": "209/TALK"  , "narrator": "エリカ", "text": "でも多分、しばらく\n見ていれば、何かしらの\n葛藤は発生すると思うの。"},
        { "location": "210/TALK"  , "narrator": "エリカ", "text": "いろんなことが\nモヤモヤしてる状況だと\n思うから。"},
        { "location": "213/TALK"  , "narrator": "エリカ", "text": "さあ、それじゃ早速\n神楽ちゃんに\nアクセスするよ。"},
        { "location": "214/TALK"  , "narrator": "エリカ", "text": "デイドラシステムに、\nとある時空間を\n登録しておいたの。"},
        { "location": "215/TALK"  , "narrator": "エリカ", "text": "フェノメノン時間における\n2016年3月21日――"},
        { "location": "216/TALK"  , "narrator": "エリカ", "text": "神楽ちゃんが\nつばめちゃんの繭の中に\n入り込んだ日。"},
        { "location": "217/TALK"  , "narrator": "エリカ", "text": "そしてそれは、わたしの\n計算上、リプレイス可能な\n最も過去の時間。"},
        { "location": "218/TALK"  , "narrator": "エリカ", "text": "アクセスが完了すれば、\n専用機にのって日本領海\n上空にいる彼女に繋がる。"},
        { "location": "219/TALK"  , "narrator": "エリカ", "text": "彼女をよく見て、とにかく\nまずは何も会話せずに\nココロゲートまで来てね。"},
        { "location": "220/SEL"   , "narrator": "", "text": "頑張ります！"},
        { "location": "221/SEL"   , "narrator": "", "text": "怖いよ！"},
        { "location": "222/ACT"   , "narrator": "", "text": "頑張ります！"},
        { "location": "223/TALK"  , "narrator": "エリカ", "text": "うん、ありがと。"},
        { "location": "224/ACT"   , "narrator": "", "text": "怖いよ！"},
        { "location": "225/TALK"  , "narrator": "エリカ", "text": "ごめんね、\n怖い思いをさせちゃって。"},
        { "location": "226/TALK"  , "narrator": "エリカ", "text": "でも、すごく感謝してる。\nあなたがいるから、\nわたしは――"},
        { "location": "228/TALK"  , "narrator": "エリカ", "text": "ううん。\nこの世界は良い方向に\n向かうことができるの。"},
        { "location": "230/TALK"  , "narrator": "エリカ", "text": "それじゃ、どうか\n宜しくお願いします！"},
        { "location": "232/TALK"  , "narrator": "エリカ", "text": "あなたと\nわたしたちにとって\n素敵なココロの旅を！"},
        { "location": "234/SEL"   , "narrator": "", "text": "ああっ！！ちょっとまった！"},
        { "location": "235/ACT"   , "narrator": "", "text": "ああっ！！ちょっとまった！"},
        { "location": "237/TALK"  , "narrator": "エリカ", "text": "ええっ！\nなになに！？"},
        { "location": "238/SEL"   , "narrator": "", "text": "神楽への誕生日プレゼントってどうなったの！？"},
        { "location": "239/ACT"   , "narrator": "", "text": "神楽への誕生日プレゼントってどうなったの！？"},
        { "location": "241/TALK"  , "narrator": "エリカ", "text": "えっとー……"},
        { "location": "242/TALK"  , "narrator": "エリカ", "text": "ちょっと何のことか\nよくわからないかな……？"},
        { "location": "243/SEL"   , "narrator": "", "text": "ソイルトンが、神楽の誕生日プレゼントは$me$の想いで決まるって"},
        { "location": "244/SEL"   , "narrator": "", "text": "ソイルトンを出せ！"},
        { "location": "245/ACT"   , "narrator": "", "text": "ソイルトンが、神楽の誕生日プレゼントは$me$の想いで決まるって"},
        { "location": "246/TALK"  , "narrator": "エリカ", "text": "ああっ、\nソイルトンが\n何かしたのかな？"},
        { "location": "247/ACT"   , "narrator": "", "text": "ソイルトンを出せ！"},
        { "location": "248/TALK"  , "narrator": "エリカ", "text": "ええっ！？\nう、うん、わかったよ。"},
        { "location": "257/TALK"  , "narrator": "エリカ", "text": "はい。\nコールしておいたよ。"},
        { "location": "258/TALK"  , "narrator": "エリカ", "text": "もう少しで起動すると\n思うから、ちょっとだけ\n待っててね。"},
        { "location": "259/TALK"  , "narrator": "エリカ", "text": "それじゃ、わたしは\nちょっとやることが\nあるから、またね。"},
        { "location": "260/TALK"  , "narrator": "エリカ", "text": "あなたと\nわたしたちにとって\n素敵なココロの旅を！"},
        { "location": "266/SEL"   , "narrator": "", "text": "来たね"},
        { "location": "267/ACT"   , "narrator": "", "text": "来たね"},
        { "location": "271/TALK"  , "narrator": "ソイルトン", "text": "お久し振りです。\nといいつつも1.0f clock程度の時間、お久し振りではない可能性について分析してみたところ、やはりその可能性は無いということに気づきましたので堂々とお久し振りと言わせていただく事にします。"},
        { "location": "272/TALK"  , "narrator": "ソイルトン", "text": "さて、$handle$。\n貴方が何を言わんとするかは、私にはしっかりとわかっておりますよ。\nようこそ、シュレディンガーの観測結果部屋へ。貴方は今日この瞬間、卯月神楽へ渡したプレゼントボックスの箱の中身が何なのかを身を以て観測することとなるでしょう。"},
        { "location": "273/SEL"   , "narrator": "", "text": "もったいぶらずに教えて"},
        { "location": "274/SEL"   , "narrator": "", "text": "実は既に知ってるぴょん"},
        { "location": "275/ACT"   , "narrator": "", "text": "もったいぶらずに教えて"},
        { "location": "276/TALK"  , "narrator": "ソイルトン", "text": "もちろんですとも。\nたったあと数個の吹き出しの後に貴方は一つの重ね合わせ状態を観測することになるのです。"},
        { "location": "277/TALK"  , "narrator": "ソイルトン", "text": "それは当然ながら、それなりに興味深い統計データと共に、貴方に提供されることとなります。"},
        { "location": "278/TALK"  , "narrator": "ソイルトン", "text": "さあ、それでは早速観測結果を公表する事としましょう。"},
        { "location": "279/TALK"  , "narrator": "ソイルトン", "text": "【プレゼント観測結果】\nスポーツウェア:15%\nWishphobia:68%\nラブラブTシャツ:17%"},
        { "location": "280/TALK"  , "narrator": "ソイルトン", "text": "というわけで、観測結果に基づいて卯月神楽へのプレゼントは「Wishphobia」ということになりました！"},
        { "location": "281/ACT"   , "narrator": "", "text": "実は既に知ってるぴょん"},
        { "location": "282/TALK"  , "narrator": "ソイルトン", "text": "おおっと、そうだったのですね。重ね合わせ状態は観測をすれば収束してしまいます。すなわちそれは、ここで私が観測するまでも無く、あなたにとっての卯月神楽のプレゼントは決まっているということに他なりません。"},
        { "location": "283/TALK"  , "narrator": "ソイルトン", "text": "であれば、私の方から敢えて観測結果をお伝えする必要も無いでしょう。\nせっかくですから、クロックの無駄遣いをしなくてよかった♪などと言ってみようかと思います。"},
        { "location": "284/TALK"  , "narrator": "ソイルトン", "text": "尚、クロックの無駄というものは今私が実施したような今後にとって何の足しにもならない発言をする事こそが、最もそれに\n当てはまるものであると確信しております。"},
        { "location": "286/TALK"  , "narrator": "ソイルトン", "text": "さて。\n観測も済んだことですので、“あの誕生日の続き”を進行させることが可能となりました。"},
        { "location": "287/TALK"  , "narrator": "ソイルトン", "text": "ですが、それを実施するか否かは貴方の選択に委ねられています。\nどうしますか？"},
        { "location": "288/SEL"   , "narrator": "", "text": "する"},
        { "location": "289/SEL"   , "narrator": "", "text": "しない"},
        { "location": "290/ACT"   , "narrator": "", "text": "する"},
        { "location": "291/TALK"  , "narrator": "ソイルトン", "text": "承知致しました。\nそれでは只今より、卯月神楽ハッピーバースデーエピソードの続きを進行いたします。"},
        { "location": "292/TALK"  , "narrator": "ソイルトン", "text": "貴方と卯月神楽にとって素敵なココロの旅を！"},
        { "location": "314/TALK"  , "narrator": "神楽", "text": "えっ！\nこれって……"},
        { "location": "318/TALK"  , "narrator": "神楽", "text": "私のステージ衣装！？\nどうしてこれを…？"},
        { "location": "319/SEL"   , "narrator": "", "text": "これを着てるときの神楽が凄く輝いてるから"},
        { "location": "320/SEL"   , "narrator": "", "text": "この衣装が好き！"},
        { "location": "321/SEL"   , "narrator": "", "text": "実はこれじゃないのを希望したんだけどね"},
        { "location": "322/ACT"   , "narrator": "", "text": "これを着てるときの神楽が凄く輝いてるから"},
        { "location": "324/TALK"  , "narrator": "神楽", "text": "ホントですか？\nふふ、\nありがとうございます！"},
        { "location": "325/TALK"  , "narrator": "神楽", "text": "私の思い入れ深い\n役回りの衣装なので\nちょっと嬉しいです。"},
        { "location": "326/ACT"   , "narrator": "", "text": "この衣装が好き！"},
        { "location": "327/TALK"  , "narrator": "神楽", "text": "そうだったんですね！"},
        { "location": "328/TALK"  , "narrator": "神楽", "text": "気に入ってもらえて\n嬉しいです♪"},
        { "location": "329/TALK"  , "narrator": "神楽", "text": "それじゃ、御希望の際には\n積極的に着ちゃいますね！"},
        { "location": "330/ACT"   , "narrator": "", "text": "実はこれじゃないのを希望したんだけどね"},
        { "location": "331/TALK"  , "narrator": "神楽", "text": "そうだったんですか！？"},
        { "location": "332/TALK"  , "narrator": "神楽", "text": "なーんて。\n知ってますよ♪"},
        { "location": "334/TALK"  , "narrator": "神楽", "text": "$handle$さんは\n学校用の体操服を\n選んでくれましたよね♪"},
        { "location": "336/TALK"  , "narrator": "神楽", "text": "どうして選んだかは\n敢えて聞かないことに\nしておきますねっ♪"},
        { "location": "338/TALK"  , "narrator": "神楽", "text": "$handle$さんは\nこの衣装を選んでいたじゃ\nないですか～。"},
        { "location": "339/TALK"  , "narrator": "神楽", "text": "ホント、\n嘘ばっかりなんですから。"},
        { "location": "341/TALK"  , "narrator": "神楽", "text": "$handle$さんは\nラブラブTシャツを\n選んでくれましたよね♪"},
        { "location": "342/TALK"  , "narrator": "神楽", "text": "お外ではちょっと\n着るのが恥ずかしい\nですけど――"},
        { "location": "344/TALK"  , "narrator": "神楽", "text": "おうちの中では、\nいつかふたりで着られる\nようになりたいですね♪"},
        { "location": "347/TALK"  , "narrator": "神楽", "text": "いずれにしても、\n素敵なプレゼント\nありがとうございます！"},
        { "location": "348/TALK"  , "narrator": "神楽", "text": "なんだかちょっと、\nかまかまして欲しい\n気分になっちゃいました。"},
        { "location": "349/TALK"  , "narrator": "神楽", "text": "よかったら私のこと、\nかまかましてくださいね♪"},
        { "location": "369/TALK"  , "narrator": "神楽", "text": "えへへっ……"},
        { "location": "370/TALK"  , "narrator": "神楽", "text": "なんだか\nこそばゆいですねっ！"},
        { "location": "373/TALK"  , "narrator": "神楽", "text": "えへへっ……"},
        { "location": "374/TALK"  , "narrator": "神楽", "text": "なんだか\nこそばゆいですねっ！"},
        { "location": "377/TALK"  , "narrator": "神楽", "text": "はあっ！"},
        { "location": "378/TALK"  , "narrator": "神楽", "text": "今日だけ\n特別ですよ？"},
        { "location": "381/TALK"  , "narrator": "神楽", "text": "はあっ！"},
        { "location": "382/TALK"  , "narrator": "神楽", "text": "今日だけ\n特別ですよ？"},
        { "location": "385/TALK"  , "narrator": "神楽", "text": "はあっ…。"},
        { "location": "386/TALK"  , "narrator": "神楽", "text": "お腹を叩くのは\nレディには厳禁ですっ！"},
        { "location": "389/TALK"  , "narrator": "神楽", "text": "はあっ…。"},
        { "location": "390/TALK"  , "narrator": "神楽", "text": "撫でられるとなんだか\n幸せな気持ちに\nなりますねっ！"},
        { "location": "395/TALK"  , "narrator": "神楽", "text": "ふぅ。\nとっても素敵でした♪"},
        { "location": "397/TALK"  , "narrator": "神楽", "text": "改めて、\nステージ衣装のプレゼント\nありがとうございます♪"},
        { "location": "398/TALK"  , "narrator": "神楽", "text": "実はこの衣装、\n私もちょっと\n気に入ってるんです。"},
        { "location": "399/TALK"  , "narrator": "神楽", "text": "でも普段は事務所に置いて\nあるし、実は私の私物じゃ\nないんですよね。"},
        { "location": "400/TALK"  , "narrator": "神楽", "text": "ですから、私自身も\nあまり自由に見ることも\nできなくて。"},
        { "location": "401/TALK"  , "narrator": "神楽", "text": "けど、貴方がプレゼント\nしてくれましたから、\nいつでも見られます♪"},
        { "location": "402/TALK"  , "narrator": "神楽", "text": "お礼に今度、これを着て\nサービスしちゃっても\nいいんですよっ？"},
        { "location": "403/TALK"  , "narrator": "神楽", "text": "……なんて。"},
        { "location": "405/TALK"  , "narrator": "神楽", "text": "でも貴方と私には、\nその前にやることが\n沢山ありますよね。"},
        { "location": "406/TALK"  , "narrator": "神楽", "text": "どうかこれから私のこと、\n宜しくお願いします♪"},
        { "location": "407/TALK"  , "narrator": "神楽", "text": "期待してますからね！"},
        { "location": "417/ACT"   , "narrator": "", "text": "しない"},
        { "location": "418/TALK"  , "narrator": "ソイルトン", "text": "オーケー$handle$。\nそれでは進行は中断したままにしておきます。"},
        { "location": "419/TALK"  , "narrator": "ソイルトン", "text": "また何時でも進行は可能ですから御希望の際にはお気軽に\nお声かけを。"},
        { "location": "420/TALK"  , "narrator": "ソイルトン", "text": "それでは今回はこれにて失礼致します。\n貴方と卯月神楽に素敵なココロの旅を！"},
