{
    "dir": "chap21/daydra/dd_ch03_21_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "21356",
        "cid": "gabriella",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "夜の怖さ"
    },
    "entry":
    [
        { "location": "226/SCENARIO", "narrator": "", "text": "夜の怖さ"},
        { "location": "237/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "239/TALK"    , "narrator": "ガブリエラ", "text": "ど、どうしよう…\nトイレ行きたく\nなっちゃった…。"},
        { "location": "240/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "241/TALK"    , "narrator": "ガブリエラ", "text": "ああ、もうっ！\nいつもは夜中でも\n平気で行けるのに！"},
        { "location": "242/TALK"    , "narrator": "ガブリエラ", "text": "寝る前に怪談なんて\nやるんじゃなかったわ…。"},
        { "location": "243/TALK"    , "narrator": "ガブリエラ", "text": "…んっ、んんっ！\nゲホゲホッ！"},
        { "location": "244/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "246/TALK"    , "narrator": "ガブリエラ", "text": "誰も起きないし…！！"},
        { "location": "247/SEL"     , "narrator": "", "text": "$me$が見てるよ"},
        { "location": "250/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "252/TALK"    , "narrator": "ガブリエラ", "text": "ううっ…お、お願いだから\n誰か起きてよぉ…。"},
        { "location": "254/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "258/TALK"    , "narrator": "ガブリエラ", "text": "ああ、もう限界！！"},
        { "location": "259/TALK"    , "narrator": "ガブリエラ", "text": "お化けなんていない。\nうん、大丈夫！"},
        { "location": "273/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "274/TALK"    , "narrator": "ガブリエラ", "text": "こ、怖いぃ…！\nリアルお化け屋敷じゃん！"},
        { "location": "275/TALK"    , "narrator": "ガブリエラ", "text": "日本の古民家って、\nどうしてこんな暗いのよ？"},
        { "location": "277/TALK"    , "narrator": "ガブリエラ", "text": "…っ！？"},
        { "location": "279/TALK"    , "narrator": "ガブリエラ", "text": "な、なんだ、床の音か…。"},
        { "location": "281/TALK"    , "narrator": "ガブリエラ", "text": "…トイレ、こんなに\n遠かったっかしら？"},
        { "location": "282/TALK"    , "narrator": "ガブリエラ", "text": "…………っ！？"},
        { "location": "284/TALK"    , "narrator": "ガブリエラ", "text": "えっ？　な、なに？"},
        { "location": "285/TALK"    , "narrator": "ガブリエラ", "text": "今、二階から足音が…\nこんな時間に！？"},
        { "location": "287/TALK"    , "narrator": "ガブリエラ", "text": "みやびのお母さん達は\n離れにいるはずだから――"},
        { "location": "288/TALK"    , "narrator": "ガブリエラ", "text": "二階には誰もいない\nはずなのに！"},
        { "location": "291/TALK"    , "narrator": "ガブリエラ", "text": "…う、うそ…うそうそ、\nちょっと待って…。"},
        { "location": "293/TALK"    , "narrator": "ガブリエラ", "text": "足音、二階から降りて…\n近づいてきてる…！？"},
        { "location": "294/SEL"     , "narrator": "", "text": "$me$が付いてるよ"},
        { "location": "296/TALK"    , "narrator": "ガブリエラ", "text": "ウソでしょ？\nお化けなんて、いるはず\nないのに…。"},
        { "location": "297/TALK"    , "narrator": "ガブリエラ", "text": "はぁ…はぁ…。"},
        { "location": "301/TALK"    , "narrator": "ガブリエラ", "text": "に、逃げなくちゃ！"},
        { "location": "315/TALK"    , "narrator": "ガブリエラ", "text": "はぁ、はぁ…。\nな、何だったの、あれ？"},
        { "location": "316/TALK"    , "narrator": "ガブリエラ", "text": "…ううん、もういい！"},
        { "location": "317/TALK"    , "narrator": "ガブリエラ", "text": "あれが心霊現象でも\nなんでも、もう考えたく\nないし！"},
        { "location": "318/TALK"    , "narrator": "ガブリエラ", "text": "とにかく、明るくなるまで\n我慢してれば――"},
        { "location": "321/TALK"    , "narrator": "みやび", "text": "ふぁ～…。"},
        { "location": "324/TALK"    , "narrator": "ガブリエラ", "text": "っ！\nみ、みやび！？"},
        { "location": "326/TALK"    , "narrator": "みやび", "text": "ん？　ああ、すまん。\n起こしてしもうた？"},
        { "location": "327/TALK"    , "narrator": "ガブリエラ", "text": "…みやび、こんな時間まで\n起きてたの？"},
        { "location": "328/TALK"    , "narrator": "みやび", "text": "うん、部屋のＰＣ\n弄っちょったがよ。"},
        { "location": "329/TALK"    , "narrator": "ガブリエラ", "text": "…ってことは、さっきの\n足音って…。"},
        { "location": "333/TALK"    , "narrator": "みやび", "text": "ガブちゃんも早く寝ないと\nいかんよ、おやすみ…。"},
        { "location": "334/TALK"    , "narrator": "ガブリエラ", "text": "あっ…。"},
        { "location": "337/TALK"    , "narrator": "ガブリエラ", "text": "…おやすみ。"},
        { "location": "339/TALK"    , "narrator": "ガブリエラ", "text": "…あたしのバカ！\nあそこまで行ったのに、\n勝手に勘違いして！"},
        { "location": "341/TALK"    , "narrator": "ガブリエラ", "text": "ど、どうしよう…。\nもう一度トイレに――"},
        { "location": "342/TALK"    , "narrator": "ガブリエラ", "text": "いやいや、絶対無理！\nまた廊下に出るとか\nありえないし！"},
        { "location": "344/TALK"    , "narrator": "ガブリエラ", "text": "…ううっ、\n早く明るくなってよぉ…。"},
        { "location": "346/ACT"     , "narrator": "", "text": "$me$が付いてるよ"},
        { "location": "350/TALK"    , "narrator": "ガブリエラ", "text": "ひっ！？"},
        { "location": "353/TALK"    , "narrator": "ガブリエラ", "text": "きゃぁぁぁぁ、もがっ！？"},
        { "location": "356/TALK"    , "narrator": "みやび", "text": "しーっ、静かに。"},
        { "location": "361/TALK"    , "narrator": "ガブリエラ", "text": "んむっ！？\nみ、みやび！？"},
        { "location": "362/TALK"    , "narrator": "みやび", "text": "みんなが起きるき、\n夜中に叫ぶんは\n関心せんよ？"},
        { "location": "365/TALK"    , "narrator": "ガブリエラ", "text": "ご、ごめん…\n急にスマホが震えて、\n驚いちゃって…。"},
        { "location": "368/TALK"    , "narrator": "ガブリエラ", "text": "っていうか、みやび。\nまさか今まで起きてたの？"},
        { "location": "369/TALK"    , "narrator": "みやび", "text": "そりゃ、せっかく自室の\nＰＣ弄れる機会やっちゅう\nのに――"},
        { "location": "370/TALK"    , "narrator": "みやび", "text": "さっさと寝てしまうとか、\nありえんき。"},
        { "location": "371/TALK"    , "narrator": "ガブリエラ", "text": "…な、なんだ…\n音の正体はみやび\nだったんだ…。"},
        { "location": "373/TALK"    , "narrator": "ガブリエラ", "text": "ふぅ…安心したわ。"},
        { "location": "375/TALK"    , "narrator": "みやび", "text": "？"},
        { "location": "377/TALK"    , "narrator": "ガブリエラ", "text": "あ、ううん。\n何でもない。"},
        { "location": "378/TALK"    , "narrator": "みやび", "text": "そうか？\nとにかく、うちも\nもう寝るき――"},
        { "location": "379/TALK"    , "narrator": "みやび", "text": "ガブちゃんも、あんまし\n夜更かししたらいかんよ。"},
        { "location": "381/TALK"    , "narrator": "ガブリエラ", "text": "ちょ、ちょっと待った！"},
        { "location": "382/TALK"    , "narrator": "ガブリエラ", "text": "みやび…あんた、寝る前に\nトイレには行ったの？"},
        { "location": "383/TALK"    , "narrator": "みやび", "text": "いや、一時間くらい前に\n行ったけんど…。"},
        { "location": "384/TALK"    , "narrator": "ガブリエラ", "text": "もう一度行った方が\nいいわ。"},
        { "location": "385/TALK"    , "narrator": "ガブリエラ", "text": "トイレに行きたくて\n夜中に起きるの、\n嫌でしょ？"},
        { "location": "386/TALK"    , "narrator": "みやび", "text": "…………？"},
        { "location": "387/TALK"    , "narrator": "みやび", "text": "…ああ、なるほど。"},
        { "location": "388/TALK"    , "narrator": "みやび", "text": "うん、そうやね。\nうちもスッキリしてから\n寝ることにするよ。"},
        { "location": "389/TALK"    , "narrator": "ガブリエラ", "text": "そ、そう…。\nうん、それがいいわ。"},
        { "location": "390/TALK"    , "narrator": "みやび", "text": "…ついでに、ガブちゃんに\n一つ教えとくけんど――"},
        { "location": "391/TALK"    , "narrator": "みやび", "text": "廊下の電気のスイッチ、\n部屋の向かい側の壁に\nあるき――"},
        { "location": "392/TALK"    , "narrator": "みやび", "text": "次からは点けてきた方が、\nえいと思うよ。"},
        { "location": "393/TALK"    , "narrator": "ガブリエラ", "text": "そんなところに…\n気付かなかったわ、\nありがと。"},
        { "location": "395/TALK"    , "narrator": "みやび", "text": "…随分と素直やね。\nそれだけ、怖がっちょった\nいうことか…。"},
        { "location": "414/ACT"     , "narrator": "", "text": "$me$が見てるよ"},
        { "location": "433/TALK"    , "narrator": "ガブリエラ", "text": "そうだったわ"},
        { "location": "435/TALK"    , "narrator": "ガブリエラ", "text": "$marzanna$がいてくれてるの、すっかり忘れてたわ"},
        { "location": "436/TALK"    , "narrator": "ガブリエラ", "text": "それじゃあ、トイレに行くまでの間、しっかり監視しててね"},
        { "location": "447/TALK"    , "narrator": "ガブリエラ", "text": "…よし、行こう！"},
        { "location": "458/TALK"    , "narrator": "ガブリエラ", "text": "ふぅ…。"},
        { "location": "470/TALK"    , "narrator": "ガブリエラ", "text": "ありがとう、助かったわ"},
        { "location": "473/SEL"     , "narrator": "", "text": "また夜に起きたら言ってね"},
        { "location": "474/ACT"     , "narrator": "", "text": "また夜に起きたら言ってね"},
        { "location": "476/TALK"    , "narrator": "ガブリエラ", "text": "うん、おねがいね"},
        { "location": "236/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>8月25日　 2:36 AM</color>\n合宿中の深夜、みやびの実家でのこと"},
        { "location": "406/DIALOG"  , "narrator": "Dialog_GEThimegoto_ch03", "text": "【おどかさないで！】"}
    ]
}
