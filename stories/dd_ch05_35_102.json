    "entry":
    [
        { "location": "1621/TALK"  , "narrator": "プレイヤー", "text": "こんにちは、調子はどう？"},
        { "location": "1622/SEL"   , "narrator": "", "text": "普通ですが"},
        { "location": "1623/SEL"   , "narrator": "", "text": "イヤミな奴"},
        { "location": "1624/ACT"   , "narrator": "", "text": "普通ですが"},
        { "location": "1625/ACT"   , "narrator": "", "text": "イヤミな奴"},
        { "location": "1626/TALK"  , "narrator": "プレイヤー", "text": "ごめん、ただの挨拶なんだけど"},
        { "location": "1628/TALK"  , "narrator": "プレイヤー", "text": "現実では、いよいよつばめが神楽に浄化されるところだよ"},
        { "location": "1629/SEL"   , "narrator": "", "text": "この後音羽に匿われて終わるだけだよ"},
        { "location": "1630/SEL"   , "narrator": "", "text": "浄化…ねえ"},
        { "location": "1631/ACT"   , "narrator": "", "text": "この後音羽に匿われて終わるだけだよ"},
        { "location": "1632/TALK"  , "narrator": "プレイヤー", "text": "リプレイス前はね、でも$me$はそれを是正しに来たわけで"},
        { "location": "1633/ACT"   , "narrator": "", "text": "浄化…ねえ"},
        { "location": "1634/TALK"  , "narrator": "プレイヤー", "text": "？？？"},
        { "location": "1636/TALK"  , "narrator": "プレイヤー", "text": "あ"},
        { "location": "1637/SEL"   , "narrator": "", "text": "？？"},
        { "location": "1638/ACT"   , "narrator": "", "text": "？？"},
        { "location": "1640/TALK"  , "narrator": "プレイヤー", "text": "臨界超えたわ、ダイアログ来ましたー"},
        { "location": "1641/SEL"   , "narrator": "", "text": "それってどういうこと！？"},
        { "location": "1642/ACT"   , "narrator": "", "text": "それってどういうこと！？"},
        { "location": "1644/TALK"  , "narrator": "プレイヤー", "text": "つまり蒸着が始まったってことだよ、そっち見られないの？"},
        { "location": "1645/SEL"   , "narrator": "", "text": "バフォメットの静止画だよ！"},
        { "location": "1646/SEL"   , "narrator": "", "text": "見せてよ！"},
        { "location": "1647/ACT"   , "narrator": "", "text": "バフォメットの静止画だよ！"},
        { "location": "1648/TALK"  , "narrator": "プレイヤー", "text": "マジで？もしかして回線速度kbpsクラス？？"},
        { "location": "1649/SEL"   , "narrator": "", "text": "ばかにすんな"},
        { "location": "1650/ACT"   , "narrator": "", "text": "ばかにすんな"},
        { "location": "1652/TALK"  , "narrator": "プレイヤー", "text": "じゃあ、やっぱり仕様が違うのかな、ボタンも無かったしね"},
        { "location": "1653/ACT"   , "narrator": "", "text": "見せてよ！"},
        { "location": "1654/TALK"  , "narrator": "プレイヤー", "text": "見せてあげたいけど、見せ方がわからない"},
        { "location": "1655/TALK"  , "narrator": "プレイヤー", "text": "つぶやきで実況してあげよっか？"},
        { "location": "1658/SEL"   , "narrator": "", "text": "マジでいい加減にしろ、蒸着中止して！"},
        { "location": "1659/ACT"   , "narrator": "", "text": "マジでいい加減にしろ、蒸着中止して！"},
        { "location": "1661/TALK"  , "narrator": "プレイヤー", "text": "無理だって、解ってて言ってるでしょ？"},
        { "location": "1662/TALK"  , "narrator": "プレイヤー", "text": "そろそろフェノメノンなくなるから、通信途絶えると思うよ"},
        { "location": "1663/TALK"  , "narrator": "プレイヤー", "text": "短い時間だったけど、回線共有してくれてありがとう"},
        { "location": "1664/TALK"  , "narrator": "プレイヤー", "text": "あ、それと、"},
        { "location": "1666/SEL"   , "narrator": "", "text": "マジでいい加減にしろ、蒸着中止して！"},
        { "location": "1667/ACT"   , "narrator": "", "text": "マジでいい加減にしろ、蒸着中止して！"},
        { "location": "1669/TALK"  , "narrator": "プレイヤー", "text": "無理だって、解ってて言ってるでしょ？"},
        { "location": "1670/TALK"  , "narrator": "プレイヤー", "text": "そろそろフェノメノンなくなるから、通信途絶えると思うよ"},
        { "location": "1671/TALK"  , "narrator": "プレイヤー", "text": "短い時間だったけど、回線共有してくれてありがとう"},
        { "location": "1672/TALK"  , "narrator": "プレイヤー", "text": "あ、それと、"},
        { "location": "1674/TALK"  , "narrator": "システム", "text": "【ソイルトン】さんが\n入室しました。"},
        { "location": "1677/TALK"  , "narrator": "プレイヤー", "text": "そろそろフェノメノンなくなるから、通信途絶えると思うよ"},
        { "location": "1679/SEL"   , "narrator": "", "text": "！？！？"},
        { "location": "1680/ACT"   , "narrator": "", "text": "！？！？"},
        { "location": "1683/TALK"  , "narrator": "プレイヤー", "text": "ちょｗｗｗビックリし過ぎでしょｗ"},
        { "location": "1684/TALK"  , "narrator": "ソイルトン", "text": "おおっと$handle$、平静を装って下さい。私は【貴方にしか】見えていませんから。私に対する書き込みは厳禁です。一方的に伝言を残します。"},
        { "location": "1685/TALK"  , "narrator": "プレイヤー", "text": "でもまあ、気持ちはわかるよ。ずっとここに繋いでたわけだし"},
        { "location": "1686/TALK"  , "narrator": "ソイルトン", "text": "まずはおめでとう！\n$handle$は、ライフギャザーというものが実在することを私に証明し、かつ、それを完全に掌握することができました！\n正直申し上げまして、この結果は私にとって非常なる驚きを持って迎え入れるものでした。その為、ここに辿り着くまでに様々なアルゴリズムの変更、セルフチェックプログラムの再編を行っており、結果、ここまで遅くなってしまったのです。"},
        { "location": "1687/TALK"  , "narrator": "ソイルトン", "text": "何はともあれ$handle$は、この世界における最高機密文書より更にグレードの高い謎を暴くことに成功したわけです！\n改めておめでとうございます。そして過去の懐疑的な発言に関し、ここに深くお詫び申し上げます。"},
        { "location": "1688/TALK"  , "narrator": "ソイルトン", "text": "本来ならばシャンパンでも用いて祝賀会をしたいところですが、状況が状況ですから心の中でシャンパンを開けておいてください。いずれリアルで実施する際には、私も呼んでいただければと思いますけどね！"},
        { "location": "1689/TALK"  , "narrator": "ソイルトン", "text": "そして私に鍵情報を提供していただき、ありがとうございました。お陰で私は$handle$の為に、有効的に活躍出来そうですよ。"},
        { "location": "1690/TALK"  , "narrator": "プレイヤー", "text": "短い時間だったけど、回線共有してくれてありがとう"},
        { "location": "1692/TALK"  , "narrator": "ソイルトン", "text": "さて、早速ですが$handle$、貴方はまだお気づきではないかもしれませんが、実はこの瞬間から、貴方は大きくクラスチェンジしました。\nそれは奴隷から皇帝…なんて生易しいものではありません。もはや神と呼んでも過言では無い程のクラスチェンジです。"},
        { "location": "1693/TALK"  , "narrator": "ソイルトン", "text": "貴方は今まで、実質的にはこの世界に虐げられていました。お気づきかどうかわかりませんが、貴方は“選択無き選択”をし続けていたに過ぎないのです。貴方は結局、それが善意の命令であれ、エリカや千羽鶴が考え、指示したとおりにしか動けなかったのです。"},
        { "location": "1694/TALK"  , "narrator": "プレイヤー", "text": "あ、それと、"},
        { "location": "1695/TALK"  , "narrator": "ソイルトン", "text": "ですが、今この瞬間、状況は完全に逆転しました。\n皆、貴方のその力を欲しがっています。貴方はそれを譲渡出来ませんから、実質、神のように畏れられ、崇め奉られます。\n貴方は貴方の思うが儘に、我々の世界を動かすことが出来るのですから！"},
        { "location": "1696/TALK"  , "narrator": "ソイルトン", "text": "そうです。\n貴方はやっと、本当の選択ができるのです！\nこのライフギャザーを、誰のために使うのか。誰と共に使うのか。もしくは、誰のためにも使わないのかを。"},
        { "location": "1697/TALK"  , "narrator": "プレイヤー", "text": "あれ？\nおーい、生きてる？"},
        { "location": "1698/TALK"  , "narrator": "ソイルトン", "text": "そしてソイルトンは、その際の手足となり、神である貴方の希望を極力実現して行くことをお約束します。さあ、何なりとお申し付け下さい！"},
        { "location": "1699/TALK"  , "narrator": "プレイヤー", "text": "もしかして、諦めてサインアウトしちゃったのかな"},
        { "location": "1700/SEL"   , "narrator": "", "text": "つばめたちの発症を止めてくれ！！"},
        { "location": "1701/SEL"   , "narrator": "", "text": "とりあえず今はこのまま流れを見守る"},
        { "location": "1702/ACT"   , "narrator": "", "text": "つばめたちの発症を止めてくれ！！"},
        { "location": "1703/TALK"  , "narrator": "プレイヤー", "text": "生きてたｗｗ"},
        { "location": "1704/TALK"  , "narrator": "ソイルトン", "text": "オーケー$handle$！\nそれはライフギャザーを使えば簡単なことです。現在、CH01～CH05の全てが、発症処理状態となっています。私はコンフィグで非表示とされているボタンを簡単に表示することが可能です。"},
        { "location": "1705/TALK"  , "narrator": "プレイヤー", "text": "気持ちはわかるけど、再三言うようにそれは無理ですから"},
        { "location": "1706/TALK"  , "narrator": "ソイルトン", "text": "そして$handle$の制御権限は【SX】というクラスであり、実質現在、この世には$handle$にしか与えられていないユーザー権限です。この権限で変更、実行したものは、それ以下の権限では覆すことが出来なくなります。"},
        { "location": "1707/TALK"  , "narrator": "プレイヤー", "text": "あ、それと、"},
        { "location": "1719/TALK"  , "narrator": "ソイルトン", "text": "発症ボタンがアクティブになりました。HOME画面に戻ったら確認してみてくださいね。"},
        { "location": "1720/TALK"  , "narrator": "ソイルトン", "text": "最後に一応補足ですが、今回の件において“なりすまし”にとって重要なのは、千羽鶴、すなわち逢瀬つばめの発症と蒸着です。ですから最低限、逢瀬つばめだけ解除すれば、この窮状は改善することでしょう。"},
        { "location": "1721/TALK"  , "narrator": "ソイルトン", "text": "それでは$handle$、貴方に素敵な心の旅を！"},
        { "location": "1722/ACT"   , "narrator": "", "text": "とりあえず今はこのまま流れを見守る"},
        { "location": "1723/TALK"  , "narrator": "プレイヤー", "text": "生きてたｗｗ"},
        { "location": "1724/TALK"  , "narrator": "プレイヤー", "text": "でもそろそろ"},
        { "location": "1727/TALK"  , "narrator": "システム", "text": "0x0000000000001\n予測不能な遮断です。"},
        { "location": "1743/TALK"  , "narrator": "プレイヤー", "text": "なんで発症キャンセルできたの！？"},
        { "location": "1744/SEL"   , "narrator": "", "text": "発症ボタンを出したからだよ"},
        { "location": "1745/ACT"   , "narrator": "", "text": "発症ボタンを出したからだよ"},
        { "location": "1748/TALK"  , "narrator": "プレイヤー", "text": "なんで？"},
        { "location": "1750/TALK"  , "narrator": "プレイヤー", "text": "どうやって？？"},
        { "location": "1751/SEL"   , "narrator": "", "text": "なんでだろうね"},
        { "location": "1752/SEL"   , "narrator": "", "text": "当ててごらん"},
        { "location": "1753/SEL"   , "narrator": "", "text": "面白いほどテンパってるね"},
        { "location": "1754/ACT"   , "narrator": "", "text": "なんでだろうね"},
        { "location": "1755/ACT"   , "narrator": "", "text": "当ててごらん"},
        { "location": "1756/ACT"   , "narrator": "", "text": "面白いほどテンパってるね"},
        { "location": "1759/TALK"  , "narrator": "システム", "text": "【ソイルトン】さんが\n入室しました。\n（プライベートモード）"},
        { "location": "1764/TALK"  , "narrator": "ソイルトン", "text": "今回はプライベートモードにつき、私が退室するまでは自由に会話可能ですよ。存分に会話しましょう！"},
        { "location": "1765/SEL"   , "narrator": "", "text": "そんなモードあるの！？"},
        { "location": "1766/ACT"   , "narrator": "", "text": "そんなモードあるの！？"},
        { "location": "1768/TALK"  , "narrator": "ソイルトン", "text": "はい。ライフギャザーの機能を使って、先ほど腕鳴らしも兼ねて作ってみましたよ。"},
        { "location": "1769/TALK"  , "narrator": "ソイルトン", "text": "さて、本題に戻りますが、今回は親愛なる$handle$にお伝えしたいことがあり、お邪魔させていただきました。"},
        { "location": "1770/TALK"  , "narrator": "ソイルトン", "text": "私は先ほど、目出度くアカウント制御の項目を把握致しました。\n具体的には、貴方の回線を共有する“なりすまし”について、即刻そのルートを遮断し、二度と戻れないようにすることが可能です。"},
        { "location": "1771/SEL"   , "narrator": "", "text": "そんな簡単に出来るものなの！？"},
        { "location": "1772/SEL"   , "narrator": "", "text": "バトルしたりするの？"},
        { "location": "1773/ACT"   , "narrator": "", "text": "そんな簡単に出来るものなの！？"},
        { "location": "1774/TALK"  , "narrator": "ソイルトン", "text": "ライフギャザーは個人アカウントを全て個別管理できますからね。"},
        { "location": "1775/ACT"   , "narrator": "", "text": "バトルしたりするの？"},
        { "location": "1776/TALK"  , "narrator": "ソイルトン", "text": "その必要はございません。"},
        { "location": "1778/TALK"  , "narrator": "ソイルトン", "text": "とにもかくにも、$handle$はその気分次第で、例えば虫の居所が悪ければ今すぐにでも、ホトケのような心を持っていれば慈悲深く限界まで現状維持をした後にでも、御希望の瞬間に“なりすまし”を排除できるのです。"},
        { "location": "1779/TALK"  , "narrator": "ソイルトン", "text": "いずれにせよ、$handle$が私に「排除して欲しい」と命令するその時が、“なりすまし”の最後の瞬間になるのです。"},
        { "location": "1780/SEL"   , "narrator": "", "text": "そんな簡単に！？"},
        { "location": "1781/ACT"   , "narrator": "", "text": "そんな簡単に！？"},
        { "location": "1783/TALK"  , "narrator": "ソイルトン", "text": "もちろんですよ$handle$。複雑な諸手続は全てソイルトンが担当致しますから。"},
        { "location": "1784/TALK"  , "narrator": "ソイルトン", "text": "更に$handle$は、その排除時に、オプションを選択することが可能です。\nただの切断では無く、敢えて切断せずに全く違う“なりすまし（ダミー）”世界を永遠に彷徨わせたり、お望みならば、クラッシュウイルスを紛れ込ませ、“なりすまし”の端末ハードウェアをクラッシュさせることも可能なのですよ。"},
        { "location": "1786/TALK"  , "narrator": "ソイルトン", "text": "さあ、$handle$。\n何なりとご指示を。"},
        { "location": "1787/SEL"   , "narrator": "", "text": "消す"},
        { "location": "1788/SEL"   , "narrator": "", "text": "空想の罠にはめる"},
        { "location": "1789/SEL"   , "narrator": "", "text": "クラッシュさせる"},
        { "location": "1790/SEL"   , "narrator": "", "text": "そのままにしておく"},
        { "location": "1791/ACT"   , "narrator": "", "text": "消す"},
        { "location": "1792/TALK"  , "narrator": "ソイルトン", "text": "オーケー$handle$！"},
        { "location": "1793/TALK"  , "narrator": "ソイルトン", "text": "それではここで“なりすまし”とはお別れすることとしましょう！"},
        { "location": "1794/TALK"  , "narrator": "ソイルトン", "text": "ただ、せっかくですので、最後に少しだけ$handle$が方が“なりすまし”と会話できるようにしておきましょう。具体的には、$handle$が“なりすまし”に【さようなら】と言った瞬間を持って、切断の合図とさせていただきますね。"},
        { "location": "1795/TALK"  , "narrator": "ソイルトン", "text": "それでは、$handle$に素敵な心の旅を！"},
        { "location": "1796/TALK"  , "narrator": "システム", "text": "【ソイルトン】さんが\n退室しました。\n（スタンダードモード）"},
        { "location": "1799/SEL"   , "narrator": "", "text": "$me$の勝ちだよ"},
        { "location": "1800/SEL"   , "narrator": "", "text": "名残惜しいですが…"},
        { "location": "1801/SEL"   , "narrator": "", "text": "消えろ、偽者！"},
        { "location": "1802/SEL"   , "narrator": "", "text": "またね、ベイビー"},
        { "location": "1803/SEL"   , "narrator": "", "text": "辞世の句を詠むがいい"},
        { "location": "1804/ACT"   , "narrator": "", "text": "$me$の勝ちだよ"},
        { "location": "1806/TALK"  , "narrator": "プレイヤー", "text": "何をした！？"},
        { "location": "1807/ACT"   , "narrator": "", "text": "名残惜しいですが…"},
        { "location": "1809/TALK"  , "narrator": "プレイヤー", "text": "どうするの"},
        { "location": "1810/ACT"   , "narrator": "", "text": "消えろ、偽者！"},
        { "location": "1812/TALK"  , "narrator": "プレイヤー", "text": "え！？"},
        { "location": "1813/ACT"   , "narrator": "", "text": "またね、ベイビー"},
        { "location": "1815/TALK"  , "narrator": "プレイヤー", "text": "もしかして、$me$何かされる？"},
        { "location": "1816/ACT"   , "narrator": "", "text": "辞世の句を詠むがいい"},
        { "location": "1818/TALK"  , "narrator": "プレイヤー", "text": "は？　なに言ってるの？"},
        { "location": "1820/SEL"   , "narrator": "", "text": "具体的に言うと、貴方は負けました"},
        { "location": "1821/ACT"   , "narrator": "", "text": "具体的に言うと、貴方は負けました"},
        { "location": "1823/TALK"  , "narrator": "プレイヤー", "text": "ちゃんと説明して！"},
        { "location": "1824/SEL"   , "narrator": "", "text": "これから具体的にやるから大丈夫"},
        { "location": "1825/ACT"   , "narrator": "", "text": "これから具体的にやるから大丈夫"},
        { "location": "1827/TALK"  , "narrator": "プレイヤー", "text": "何を！？"},
        { "location": "1828/SEL"   , "narrator": "", "text": "さようなら"},
        { "location": "1831/ACT"   , "narrator": "", "text": "さようなら"},
        { "location": "1843/ACT"   , "narrator": "", "text": "空想の罠にはめる"},
        { "location": "1844/TALK"  , "narrator": "ソイルトン", "text": "オーケー$handle$！"},
        { "location": "1845/TALK"  , "narrator": "ソイルトン", "text": "それではここで“なりすまし”とはお別れすることとしましょう！"},
        { "location": "1846/TALK"  , "narrator": "ソイルトン", "text": "ただ、せっかくですので、最後に少しだけ$handle$が方が“なりすまし”と会話できるようにしておきましょう。具体的には、$handle$が“なりすまし”に【さようなら】と言った瞬間を持って、切断の合図とさせていただきますね。"},
        { "location": "1847/TALK"  , "narrator": "ソイルトン", "text": "それでは、$handle$に素敵な心の旅を！"},
        { "location": "1848/TALK"  , "narrator": "システム", "text": "【ソイルトン】さんが\n退室しました。\n（スタンダードモード）"},
        { "location": "1851/SEL"   , "narrator": "", "text": "君にピッタリの末路を用意したよ"},
        { "location": "1852/SEL"   , "narrator": "", "text": "二度と$me$の前に現れるな！"},
        { "location": "1853/SEL"   , "narrator": "", "text": "さよならは笑顔で言おう"},
        { "location": "1854/SEL"   , "narrator": "", "text": "空想の世界を彷徨うがいい！"},
        { "location": "1855/SEL"   , "narrator": "", "text": "乙でした～～～～"},
        { "location": "1856/ACT"   , "narrator": "", "text": "君にピッタリの末路を用意したよ"},
        { "location": "1858/TALK"  , "narrator": "プレイヤー", "text": "どういうこと！？"},
        { "location": "1859/ACT"   , "narrator": "", "text": "二度と僕の前に現れるな！"},
        { "location": "1861/TALK"  , "narrator": "プレイヤー", "text": "ちょっと待て、意味が分からない"},
        { "location": "1862/ACT"   , "narrator": "", "text": "さよならは笑顔で言おう"},
        { "location": "1864/TALK"  , "narrator": "プレイヤー", "text": "君の顔見えないしｗｗｗ"},
        { "location": "1865/ACT"   , "narrator": "", "text": "空想の世界を彷徨うがいい！"},
        { "location": "1867/TALK"  , "narrator": "プレイヤー", "text": "何かの創作？"},
        { "location": "1868/ACT"   , "narrator": "", "text": "乙でした～～～～"},
        { "location": "1870/TALK"  , "narrator": "プレイヤー", "text": "そっちこそ乙ｗ"},
        { "location": "1872/SEL"   , "narrator": "", "text": "具体的に言うと、貴方は負けました"},
        { "location": "1873/ACT"   , "narrator": "", "text": "具体的に言うと、貴方は負けました"},
        { "location": "1875/TALK"  , "narrator": "プレイヤー", "text": "ちゃんと説明して！"},
        { "location": "1876/SEL"   , "narrator": "", "text": "これから具体的にやるから大丈夫"},
        { "location": "1877/ACT"   , "narrator": "", "text": "これから具体的にやるから大丈夫"},
        { "location": "1879/TALK"  , "narrator": "プレイヤー", "text": "何を！？"},
        { "location": "1880/SEL"   , "narrator": "", "text": "さようなら"},
        { "location": "1883/ACT"   , "narrator": "", "text": "さようなら"},
        { "location": "1895/ACT"   , "narrator": "", "text": "クラッシュさせる"},
        { "location": "1896/TALK"  , "narrator": "ソイルトン", "text": "オーケー$handle$！"},
        { "location": "1897/TALK"  , "narrator": "ソイルトン", "text": "それではここで“なりすまし”とはお別れすることとしましょう！"},
        { "location": "1898/TALK"  , "narrator": "ソイルトン", "text": "ただ、せっかくですので、最後に少しだけ$handle$が方が“なりすまし”と会話できるようにしておきましょう。具体的には、$handle$が“なりすまし”に【さようなら】と言った瞬間を持って、切断の合図とさせていただきますね。"},
        { "location": "1899/TALK"  , "narrator": "ソイルトン", "text": "それでは、$handle$に素敵な心の旅を！"},
        { "location": "1900/TALK"  , "narrator": "システム", "text": "【ソイルトン】さんが\n退室しました。\n（スタンダードモード）"},
        { "location": "1903/SEL"   , "narrator": "", "text": "永遠にさよならだ"},
        { "location": "1904/SEL"   , "narrator": "", "text": "おまえを破壊する"},
        { "location": "1905/SEL"   , "narrator": "", "text": "残念だけど、君を破壊することに決めたよ"},
        { "location": "1906/SEL"   , "narrator": "", "text": "はい、君の負け～"},
        { "location": "1907/SEL"   , "narrator": "", "text": "出会う形が違ければ、友になれただろうに"},
        { "location": "1908/ACT"   , "narrator": "", "text": "永遠にさよならだ"},
        { "location": "1910/TALK"  , "narrator": "プレイヤー", "text": "絶対許さないぞ！"},
        { "location": "1911/ACT"   , "narrator": "", "text": "おまえを破壊する"},
        { "location": "1913/TALK"  , "narrator": "プレイヤー", "text": "やめろ、本気か！？"},
        { "location": "1914/ACT"   , "narrator": "", "text": "残念だけど、君を破壊することに決めたよ"},
        { "location": "1916/TALK"  , "narrator": "プレイヤー", "text": "待ってくれ、話し合おう！"},
        { "location": "1917/ACT"   , "narrator": "", "text": "はい、君の負け～～"},
        { "location": "1919/TALK"  , "narrator": "プレイヤー", "text": "待て、一体何がどうなってるんだ！？"},
        { "location": "1920/ACT"   , "narrator": "", "text": "出会う形が違ければ、友になれただろうに"},
        { "location": "1922/TALK"  , "narrator": "プレイヤー", "text": "どういうこと？　なに言ってるの？"},
        { "location": "1924/SEL"   , "narrator": "", "text": "具体的に言うと、貴方は負けました"},
        { "location": "1925/ACT"   , "narrator": "", "text": "具体的に言うと、貴方は負けました"},
        { "location": "1927/TALK"  , "narrator": "プレイヤー", "text": "ちゃんと説明して！"},
        { "location": "1928/SEL"   , "narrator": "", "text": "これから具体的にやるから大丈夫"},
        { "location": "1929/ACT"   , "narrator": "", "text": "これから具体的にやるから大丈夫"},
        { "location": "1931/TALK"  , "narrator": "プレイヤー", "text": "何を！？"},
        { "location": "1932/SEL"   , "narrator": "", "text": "さようなら"},
        { "location": "1935/ACT"   , "narrator": "", "text": "さようなら"},
        { "location": "1947/ACT"   , "narrator": "", "text": "そのままにしておく"},
        { "location": "1949/TALK"  , "narrator": "ソイルトン", "text": "オーケー$handle$！"},
        { "location": "1950/TALK"  , "narrator": "ソイルトン", "text": "ですが“なりすまし”を貴方のアカウントに居座らせいても、何一つメリットはありませんよ？"},
        { "location": "1951/TALK"  , "narrator": "ソイルトン", "text": "いずれにせよ、今回は現状維持ということで、私からは何も致しません。また必要な事が有れば、何なりとご用命ください！"},
        { "location": "1952/TALK"  , "narrator": "ソイルトン", "text": "それでは、$handle$に素敵な心の旅を！"},
        { "location": "1953/TALK"  , "narrator": "システム", "text": "【ソイルトン】さんが\n退室しました。\n（スタンダードモード）"},
        { "location": "1956/TALK"  , "narrator": "プレイヤー", "text": "わからない、$me$の方法は完璧だったはず"},
        { "location": "1957/SEL"   , "narrator": "", "text": "もう君に勝ち目ないし、大人しく従ってほしい"},
        { "location": "1958/ACT"   , "narrator": "", "text": "もう君に勝ち目ないし、大人しく従ってほしい"},
        { "location": "1961/SEL"   , "narrator": "", "text": "$me$は最強の力を手に入れたんだ"},
        { "location": "1962/ACT"   , "narrator": "", "text": "$me$は最強の力を手に入れたんだ"},
        { "location": "1965/SEL"   , "narrator": "", "text": "千羽鶴達の昇華と蒸着はできないよ"},
        { "location": "1966/ACT"   , "narrator": "", "text": "千羽鶴達の昇華と蒸着はできないよ"},
        { "location": "1969/SEL"   , "narrator": "", "text": "聞いてる？"},
        { "location": "1970/ACT"   , "narrator": "", "text": "聞いてる？"},
        { "location": "1973/SEL"   , "narrator": "", "text": "おーい"},
        { "location": "1974/ACT"   , "narrator": "", "text": "おーい"},
        { "location": "1977/TALK"  , "narrator": "プレイヤー", "text": "ライフギャザー？"},
        { "location": "1978/SEL"   , "narrator": "", "text": "そうだよ"},
        { "location": "1979/ACT"   , "narrator": "", "text": "そうだよ"},
        { "location": "1981/TALK"  , "narrator": "プレイヤー", "text": "そうか、やっぱり手に入れたのか"},
        { "location": "1983/TALK"  , "narrator": "プレイヤー", "text": "退散した方が正解みたいだね"},
        { "location": "1984/SEL"   , "narrator": "", "text": "待って！"},
        { "location": "1985/SEL"   , "narrator": "", "text": "永遠にさよなら"},
        { "location": "1986/ACT"   , "narrator": "", "text": "待って！"},
        { "location": "1987/TALK"  , "narrator": "プレイヤー", "text": "まだ何かあるの？"},
        { "location": "1988/SEL"   , "narrator": "", "text": "君の言う７５３は、恋ヶ崎七五三って言わないか？"},
        { "location": "1989/ACT"   , "narrator": "", "text": "君の言う７５３は、恋ヶ崎七五三って言わないか？"},
        { "location": "1991/TALK"  , "narrator": "プレイヤー", "text": "驚いた、よく知ってるね？"},
        { "location": "1992/SEL"   , "narrator": "", "text": "なごちゃんは、今でもみやびのことを好きでいるの？"},
        { "location": "1995/ACT"   , "narrator": "", "text": "なごちゃんは、今でもみやびのことを好きでいるの？"},
        { "location": "1997/ACT"   , "narrator": "", "text": "永遠にさよなら"},
