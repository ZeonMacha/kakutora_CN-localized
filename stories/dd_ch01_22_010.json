{
    "dir": "chap22/daydra/dd_ch01_22_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "22152",
        "cid": "tsubame",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "不機嫌の理由"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "不機嫌の理由"},
        { "location": "18/TALK"   , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "20/TALK"   , "narrator": "つばめ", "text": "ガブちゃん、なんだか\n凄く機嫌が悪そう。"},
        { "location": "21/TALK"   , "narrator": "つばめ", "text": "やっぱり、あの事が\n原因なのかな？"},
        { "location": "33/TALK"   , "narrator": "つばめ", "text": "ちょっと、ガブちゃんのことで相談があるの"},
        { "location": "35/SEL"    , "narrator": "", "text": "何かあったの？"},
        { "location": "36/ACT"    , "narrator": "", "text": "何かあったの？"},
        { "location": "38/TALK"   , "narrator": "つばめ", "text": "ガブちゃん、少し前から急に機嫌が悪くなっちゃったの"},
        { "location": "39/TALK"   , "narrator": "つばめ", "text": "多分、原因はスイカじゃないかな？"},
        { "location": "41/SEL"    , "narrator": "", "text": "順番に説明して"},
        { "location": "42/ACT"    , "narrator": "", "text": "順番に説明して"},
        { "location": "44/TALK"   , "narrator": "つばめ", "text": "えっと、みやびさんのお母さんにね、丸いスイカをもらったの"},
        { "location": "45/TALK"   , "narrator": "つばめ", "text": "それでね――"},
        { "location": "59/TALK"   , "narrator": "ガブリエラ", "text": "せっかくこんなに立派な\nスイカがあるなら、\nやることは一つよね？"},
        { "location": "61/TALK"   , "narrator": "つばめ", "text": "食べる以外に、\n何かあるかな？"},
        { "location": "63/TALK"   , "narrator": "ガブリエラ", "text": "鈍いわね。\n砂浜にスイカとくれば、\nやることは一つ！"},
        { "location": "64/TALK"   , "narrator": "ガブリエラ", "text": "スイカ割り以外に\nないじゃない。"},
        { "location": "65/TALK"   , "narrator": "アーヤ", "text": "えっ、スイカ割り？"},
        { "location": "67/TALK"   , "narrator": "ガブリエラ", "text": "そう、スイカ割り。\nやってみたいと\n思ってたのよ。"},
        { "location": "69/TALK"   , "narrator": "神楽", "text": "あの…スイカ割りは\nやめた方がいいと\n思いますよ？"},
        { "location": "70/TALK"   , "narrator": "神楽", "text": "あれって、割れた時に\nスイカが飛び散るから――"},
        { "location": "71/TALK"   , "narrator": "神楽", "text": "ちょっとだけ見た目が\n酷いことになっちゃい\nますし…。"},
        { "location": "72/TALK"   , "narrator": "ガブリエラ", "text": "そうなの？"},
        { "location": "74/TALK"   , "narrator": "アーヤ", "text": "包丁で切るのと違って、\n棒が当たった箇所が――"},
        { "location": "75/TALK"   , "narrator": "アーヤ", "text": "潰れた感じになるから、\n仕方なくはあるん\nだけどね。"},
        { "location": "76/TALK"   , "narrator": "ガブリエラ", "text": "…そう。"},
        { "location": "77/TALK"   , "narrator": "ガブリエラ", "text": "まあ、そういうことなら\n仕方ないわね。"},
        { "location": "78/TALK"   , "narrator": "つばめ", "text": "あれ？　ガブちゃん、\nちょっと声に元気ない…。"},
        { "location": "79/TALK"   , "narrator": "つばめ", "text": "…もしかして、\nスイカ割りしたかったの\nかな？"},
        { "location": "81/TALK"   , "narrator": "つばめ", "text": "…あの、すみません。\nわたしも、スイカ割り\nしてみたいです！"},
        { "location": "82/TALK"   , "narrator": "ガブリエラ", "text": "えっ？"},
        { "location": "84/TALK"   , "narrator": "つばめ", "text": "砂浜にスイカとくれば\nスイカ割りしかない――"},
        { "location": "86/TALK"   , "narrator": "つばめ", "text": "って、ガブちゃん\nさっき言ってたでしょ？"},
        { "location": "87/TALK"   , "narrator": "つばめ", "text": "それ聞いてたら、\nわたしもやってみたく\nなっちゃったんだ。"},
        { "location": "88/TALK"   , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "89/TALK"   , "narrator": "アーヤ", "text": "…そんなにスイカ割り\nやりたいの？"},
        { "location": "91/TALK"   , "narrator": "つばめ", "text": "はい…ダメですか？"},
        { "location": "93/TALK"   , "narrator": "アーヤ", "text": "…………。"},
        { "location": "95/TALK"   , "narrator": "アーヤ", "text": "…仕方ないわね。\n卯月、スイカ割りって\nことで良いかしら？"},
        { "location": "96/TALK"   , "narrator": "神楽", "text": "…そうですね。"},
        { "location": "97/TALK"   , "narrator": "神楽", "text": "そこまでやりたいなら、\n私もそれで構いません。"},
        { "location": "98/TALK"   , "narrator": "ガブリエラ", "text": "えっ…？"},
        { "location": "101/TALK"  , "narrator": "つばめ", "text": "やった！\nありがと、神楽ちゃん、\nアーヤさん！"},
        { "location": "102/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "103/TALK"  , "narrator": "つばめ", "text": "やったね、ガブちゃん。\nこれでスイカ割りが――"},
        { "location": "104/TALK"  , "narrator": "ガブリエラ", "text": "…いい。"},
        { "location": "105/TALK"  , "narrator": "つばめ", "text": "え？"},
        { "location": "106/TALK"  , "narrator": "ガブリエラ", "text": "やりたくない。"},
        { "location": "107/TALK"  , "narrator": "ガブリエラ", "text": "っていうか、やらないって\nことに決まってたじゃん。"},
        { "location": "108/TALK"  , "narrator": "つばめ", "text": "そ、そうだけど…。"},
        { "location": "109/TALK"  , "narrator": "アーヤ", "text": "何怒ってるのよ？\nスイカ割りやるんだから、\n怒ることないでしょ？"},
        { "location": "111/TALK"  , "narrator": "ガブリエラ", "text": "怒ってない！\nとにかく、あたしは\nやらないから――"},
        { "location": "112/TALK"  , "narrator": "ガブリエラ", "text": "やるんだったら、\nあんた達だけで勝手に\nやればいいわ。"},
        { "location": "115/TALK"  , "narrator": "つばめ", "text": "あ、ガブちゃん…。"},
        { "location": "116/TALK"  , "narrator": "神楽", "text": "もぅ…何が気に入らないん\nですかね？"},
        { "location": "117/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "139/TALK"  , "narrator": "つばめ", "text": "――ってことがあったの"},
        { "location": "140/TALK"  , "narrator": "つばめ", "text": "ガブちゃん、どうして怒っちゃったのかな？"},
        { "location": "141/TALK"  , "narrator": "つばめ", "text": "もしかして、わたし、何かしちゃったのかな？"},
        { "location": "144/SEL"   , "narrator": "", "text": "ガブリエラの気持ちを考えて"},
        { "location": "145/SEL"   , "narrator": "", "text": "ワガママな奴だな！"},
        { "location": "146/ACT"   , "narrator": "", "text": "ガブリエラの気持ちを考えて"},
        { "location": "148/TALK"  , "narrator": "つばめ", "text": "ガブちゃんの気持ち？"},
        { "location": "149/TALK"  , "narrator": "つばめ", "text": "…………"},
        { "location": "150/TALK"  , "narrator": "つばめ", "text": "ありがと、わかった気がするよ"},
        { "location": "151/TALK"  , "narrator": "つばめ", "text": "でも、なんて言えばいいのかな？"},
        { "location": "153/SEL"   , "narrator": "", "text": "それはつばめが考えること"},
        { "location": "154/ACT"   , "narrator": "", "text": "それはつばめが考えること"},
        { "location": "156/TALK"  , "narrator": "つばめ", "text": "そうだよね"},
        { "location": "157/TALK"  , "narrator": "つばめ", "text": "頑張ってみる(>_<)"},
        { "location": "168/TALK"  , "narrator": "つばめ", "text": "…なんでも聞くのは、\nダメだよね？"},
        { "location": "169/TALK"  , "narrator": "つばめ", "text": "わたしが自分で\n考えなくちゃ！"},
        { "location": "171/TALK"  , "narrator": "つばめ", "text": "…あ、あの、ガブちゃん。"},
        { "location": "172/TALK"  , "narrator": "ガブリエラ", "text": "…何よ？"},
        { "location": "173/TALK"  , "narrator": "つばめ", "text": "えっと…。"},
        { "location": "175/TALK"  , "narrator": "つばめ", "text": "…ごめんね。"},
        { "location": "177/TALK"  , "narrator": "ガブリエラ", "text": "…は？\n意味わかんないんだけど？"},
        { "location": "178/TALK"  , "narrator": "つばめ", "text": "ご、ごめん…。\nでも、何て言えばいいのか\nわからなくて…。"},
        { "location": "179/TALK"  , "narrator": "つばめ", "text": "その…ガブちゃんが今、\n凄く嫌な気持ちになってる\n理由、わかったの。"},
        { "location": "180/TALK"  , "narrator": "つばめ", "text": "…面白くないよね？"},
        { "location": "181/TALK"  , "narrator": "つばめ", "text": "自分がやりたいって\n言ったときは拒否された\nのに――"},
        { "location": "182/TALK"  , "narrator": "つばめ", "text": "他の人が賛同した途端に、\nやろう、って話になったり\nしたら…。"},
        { "location": "183/TALK"  , "narrator": "つばめ", "text": "ガブちゃんの立場に\nなって考えて、\nようやく気付けたの。"},
        { "location": "185/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "186/TALK"  , "narrator": "つばめ", "text": "だから、ごめんね。"},
        { "location": "188/TALK"  , "narrator": "ガブリエラ", "text": "…つばめが謝るような\nことじゃないでしょ？"},
        { "location": "189/TALK"  , "narrator": "ガブリエラ", "text": "っていうか、別にもう\n怒ってないし。"},
        { "location": "191/TALK"  , "narrator": "つばめ", "text": "本当？"},
        { "location": "192/TALK"  , "narrator": "ガブリエラ", "text": "…あたしも、ちょっと\n大人げなかったわ。"},
        { "location": "193/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "195/TALK"  , "narrator": "ガブリエラ", "text": "あーっ、もうやめた！"},
        { "location": "196/TALK"  , "narrator": "ガブリエラ", "text": "いつまでうじうじしてても\nつまらないし――"},
        { "location": "197/TALK"  , "narrator": "ガブリエラ", "text": "おもいっきり遊んで、\n忘れるわ！"},
        { "location": "198/TALK"  , "narrator": "つばめ", "text": "よかった。\nガブちゃん、機嫌直して\nくれて。"},
        { "location": "199/TALK"  , "narrator": "ガブリエラ", "text": "…あっ。\nそういえばあったわ。"},
        { "location": "201/TALK"  , "narrator": "つばめ", "text": "なにが？"},
        { "location": "202/TALK"  , "narrator": "ガブリエラ", "text": "あんたが謝らなくちゃ\nいけない理由よ。"},
        { "location": "203/TALK"  , "narrator": "ガブリエラ", "text": "ウソついたでしょ？"},
        { "location": "205/TALK"  , "narrator": "つばめ", "text": "えっ！？"},
        { "location": "207/TALK"  , "narrator": "ガブリエラ", "text": "スイカ割りやりたい、って\n言ってたけど――"},
        { "location": "208/TALK"  , "narrator": "ガブリエラ", "text": "あれ、本当はあたしが\nやりたがってたから、\n賛同したんでしょ？"},
        { "location": "210/TALK"  , "narrator": "つばめ", "text": "あ、あはは…\nバレちゃってた？"},
        { "location": "212/TALK"  , "narrator": "ガブリエラ", "text": "あったりまえじゃない。\nつばめの考えてることは、\n大体わかるわよ。"},
        { "location": "213/TALK"  , "narrator": "つばめ", "text": "えっ？"},
        { "location": "215/TALK"  , "narrator": "ガブリエラ", "text": "だって、超単純だし。"},
        { "location": "216/TALK"  , "narrator": "つばめ", "text": "た、単純！？\nもぉー、ひどいよ\nガブちゃん！"},
        { "location": "217/TALK"  , "narrator": "ガブリエラ", "text": "半分冗談だってば。\nほら、怒ってないで\n早く行くわよ！"},
        { "location": "218/ACT"   , "narrator": "", "text": "ワガママな奴だな！"},
        { "location": "219/TALK"  , "narrator": "つばめ", "text": "そ、そうなのかな？"},
        { "location": "220/TALK"  , "narrator": "つばめ", "text": "なんだか、ただのワガママ、って感じには思えないんだけど…"},
        { "location": "232/TALK"  , "narrator": "つばめ", "text": "…う～ん、何が理由なん\nだろ？"},
        { "location": "233/TALK"  , "narrator": "つばめ", "text": "でも、本当に\n突然だったし…。"},
        { "location": "234/TALK"  , "narrator": "つばめ", "text": "やりたい、って自分で\n言いだしたスイカ割りを\nすることになった途端――"},
        { "location": "235/TALK"  , "narrator": "つばめ", "text": "急に機嫌が悪くなったん\nだから――"},
        { "location": "236/TALK"  , "narrator": "つばめ", "text": "やっぱり、\nワガママなのかな？"},
        { "location": "237/TALK"  , "narrator": "つばめ", "text": "う～ん……。"},
        { "location": "240/TALK"  , "narrator": "アーヤ", "text": "みんなー！\nそろそろスイカ割り\n始めるわよー！"},
        { "location": "243/TALK"  , "narrator": "つばめ", "text": "あ、はーい！\nすぐに行きますー！"},
        { "location": "245/TALK"  , "narrator": "つばめ", "text": "ガブちゃん！\nほら、スイカ割り\nやるって…。"},
        { "location": "246/TALK"  , "narrator": "つばめ", "text": "…あれ？\nガブちゃん、どこ？"},
        { "location": "247/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "249/TALK"  , "narrator": "つばめ", "text": "はぁ…帰っちゃったの\nかな？"},
        { "location": "17/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>8月26日　 2:16 PM</color>\n合宿中、みやびの実家付近の砂浜でのこと"}
    ]
}
