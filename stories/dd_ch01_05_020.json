{
    "dir": "chap05/daydra/dd_ch01_05_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "5153",
        "cid": "tsubame",
        "title": "Extra003 プレミアムストーリー",
        "sub_title": "みやび襲来"
    },
    "entry":
    [
        { "location": "327/SCENARIO", "narrator": "", "text": "みやび襲来"},
        { "location": "346/TALK"    , "narrator": "みやび", "text": "つばめちゃん。"},
        { "location": "349/TALK"    , "narrator": "つばめ", "text": "あれ？　みやびさん。\nどうかしたんですか？"},
        { "location": "350/TALK"    , "narrator": "みやび", "text": "一緒にお昼ご飯を\n食べようかと思うて\n来たがよ。"},
        { "location": "351/TALK"    , "narrator": "みやび", "text": "けんど、先約がある\nいうなら、別の日に\n出直すちや。"},
        { "location": "353/TALK"    , "narrator": "つばめ", "text": "う～ん、\nどうしよう…。"},
        { "location": "354/TALK"    , "narrator": "つばめ", "text": "今日は、真幌さんと\n一緒に食べる約束\nしてるんだけど…。"},
        { "location": "355/SEL"     , "narrator": "", "text": "連絡すれば平気だよ"},
        { "location": "356/SEL"     , "narrator": "", "text": "約束守らないとダメだよ"},
        { "location": "357/SEL"     , "narrator": "", "text": "夕飯を一緒に食べるのは？"},
        { "location": "359/TALK"    , "narrator": "つばめ", "text": "学校のこととか、\n色々話してくれる、\nって言ってたし。"},
        { "location": "360/TALK"    , "narrator": "つばめ", "text": "…あ、でも、他の人と\n約束が入った時は――"},
        { "location": "361/TALK"    , "narrator": "つばめ", "text": "そっちを優先しろ、\nって言われたんだ。"},
        { "location": "362/TALK"    , "narrator": "つばめ", "text": "でも、ギリギリで\n断るのは悪いかな？"},
        { "location": "366/TALK"    , "narrator": "つばめ", "text": "う～ん…。"},
        { "location": "368/TALK"    , "narrator": "みやび", "text": "…えいがよ。\n別の日に出直すき。"},
        { "location": "370/TALK"    , "narrator": "つばめ", "text": "え？"},
        { "location": "371/TALK"    , "narrator": "みやび", "text": "先約が入ってるみたい\nやき、そっちを優先\nせんといかんちや。"},
        { "location": "373/TALK"    , "narrator": "つばめ", "text": "す、すみません…。\nわざわざ来てもらった\nのに…。"},
        { "location": "375/TALK"    , "narrator": "みやび", "text": "気にせんでえいよ。\n近いうちに、\nまた誘いにくるぞね。"},
        { "location": "377/TALK"    , "narrator": "つばめ", "text": "はい！\n楽しみにしてますね。"},
        { "location": "379/ACT"     , "narrator": "", "text": "連絡すれば平気だよ"},
        { "location": "400/TALK"    , "narrator": "つばめ", "text": "そうかな？"},
        { "location": "402/SEL"     , "narrator": "", "text": "友達と食べてる方が、真幌も安心する"},
        { "location": "403/ACT"     , "narrator": "", "text": "友達と食べてる方が、真幌も安心する"},
        { "location": "405/TALK"    , "narrator": "つばめ", "text": "友達っていうか"},
        { "location": "406/TALK"    , "narrator": "つばめ", "text": "先輩なんだけど"},
        { "location": "408/TALK"    , "narrator": "つばめ", "text": "でも"},
        { "location": "409/TALK"    , "narrator": "つばめ", "text": "今日はみやびさんと食べようかな？"},
        { "location": "410/TALK"    , "narrator": "つばめ", "text": "せっかく"},
        { "location": "411/TALK"    , "narrator": "つばめ", "text": "誘いに来てくれたんだし"},
        { "location": "422/TALK"    , "narrator": "つばめ", "text": "真幌さんには、\nメールで謝って\nおこう。"},
        { "location": "424/TALK"    , "narrator": "つばめ", "text": "わかりました。\n一緒に食べましょう。"},
        { "location": "425/TALK"    , "narrator": "みやび", "text": "いや、先約があるなら\n無理せんでえいがよ。"},
        { "location": "426/TALK"    , "narrator": "つばめ", "text": "平気です。"},
        { "location": "429/TALK"    , "narrator": "つばめ", "text": "それに、みやびさんと\n二人で食べるの初めて\nだから――"},
        { "location": "431/TALK"    , "narrator": "つばめ", "text": "わたしも楽しみです。"},
        { "location": "432/TALK"    , "narrator": "みやび", "text": "うちを喜ばしても、\n温泉旅行くらいしか\n出せんちや？"},
        { "location": "433/TALK"    , "narrator": "みやび", "text": "当然、費用は全額\nつばめちゃん負担\nやけんど。"},
        { "location": "435/TALK"    , "narrator": "つばめ", "text": "そうだと思いました。"},
        { "location": "436/TALK"    , "narrator": "つばめ", "text": "ご飯、天気が良いし\n外で食べませんか？"},
        { "location": "438/TALK"    , "narrator": "みやび", "text": "えいよ。\nそれじゃあ、すっと\n移動するぞね。"},
        { "location": "439/ACT"     , "narrator": "", "text": "約束守らないとダメだよ"},
        { "location": "460/TALK"    , "narrator": "つばめ", "text": "そうだよね"},
        { "location": "461/TALK"    , "narrator": "つばめ", "text": "最初に約束したのは"},
        { "location": "462/TALK"    , "narrator": "つばめ", "text": "真幌さんだし"},
        { "location": "475/TALK"    , "narrator": "つばめ", "text": "あの…お昼は\n真幌さんと食べる\n約束しちゃってて…。"},
        { "location": "476/TALK"    , "narrator": "みやび", "text": "そうやったか…。"},
        { "location": "478/TALK"    , "narrator": "つばめ", "text": "ごめんなさい。\nせっかく誘いに来て\nもらったのに…。"},
        { "location": "479/TALK"    , "narrator": "みやび", "text": "えいよ。\nうちも急に思い立って\n来たんやし。"},
        { "location": "480/TALK"    , "narrator": "みやび", "text": "日を改めるき、\n今度は一緒に\n食べるちや。"},
        { "location": "483/TALK"    , "narrator": "つばめ", "text": "はい。\n楽しみにしてます！"},
        { "location": "484/ACT"     , "narrator": "", "text": "夕飯を一緒に食べるのは？"},
        { "location": "514/TALK"    , "narrator": "つばめ", "text": "みやびさんって、凄い料理上手だもんね"},
        { "location": "515/TALK"    , "narrator": "つばめ", "text": "ちょっと言ってみるよ"},
        { "location": "528/TALK"    , "narrator": "つばめ", "text": "あの、ごめんなさい。\n真幌さんと\n約束してるんです。"},
        { "location": "529/TALK"    , "narrator": "みやび", "text": "そうやったか。\nじゃあ、日を改めて\n誘いに――"},
        { "location": "530/TALK"    , "narrator": "つばめ", "text": "それで、もしよければ\n夕飯を一緒に食べま\nせんか？"},
        { "location": "532/TALK"    , "narrator": "みやび", "text": "構わんけんど、\nつばめちゃんが\n作ってくれるが？"},
        { "location": "533/TALK"    , "narrator": "つばめ", "text": "あ、え、えっと――"},
        { "location": "535/TALK"    , "narrator": "つばめ", "text": "め、目玉焼きとかなら、\nどうにか！"},
        { "location": "536/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "537/TALK"    , "narrator": "つばめ", "text": "だ、ダメですよね…。"},
        { "location": "538/TALK"    , "narrator": "みやび", "text": "まあ、誰にでも\n得意不得意はあるき、\n気にせんでえいよ。"},
        { "location": "539/TALK"    , "narrator": "みやび", "text": "代わりに、うちが\n腕を振るえばえい\nだけやき。"},
        { "location": "540/TALK"    , "narrator": "つばめ", "text": "いいんですか？"},
        { "location": "541/TALK"    , "narrator": "みやび", "text": "和食限定やけんど、\nそれでえいならな。"},
        { "location": "543/TALK"    , "narrator": "つばめ", "text": "やったぁ！\n楽しみにしてます！"},
        { "location": "544/TALK"    , "narrator": "みやび", "text": "…そんな素直に\n期待されたら――"},
        { "location": "546/TALK"    , "narrator": "みやび", "text": "簡単な物オンリーに\nできんやないか…。"},
        { "location": "335/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>5月5日　11:45 AM</color>\nドーム戦の２日後、神楽坂トライナリー劇場にて。"},
        { "location": "490/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"}
    ]
}
