{
    "dir": "chap18/daydra/dd_ch01_18_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "18156",
        "cid": "tsubame",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "ガブリエラとの買い物"
    },
    "entry":
    [
        { "location": "281/SCENARIO", "narrator": "", "text": "ガブリエラとの買い物"},
        { "location": "294/TALK"    , "narrator": "ガブリエラ", "text": "う～ん…これも良いけど、\nこっちのシャツも素敵ね。"},
        { "location": "297/TALK"    , "narrator": "ガブリエラ", "text": "つばめ、どっちが良いと\n思う？"},
        { "location": "301/TALK"    , "narrator": "つばめ", "text": "難しいなぁ…。\nどっちもガブちゃんに\n似合いそうだし…。"},
        { "location": "302/TALK"    , "narrator": "ガブリエラ", "text": "いや、それ全然答えに\nなってないし…。"},
        { "location": "305/TALK"    , "narrator": "ガブリエラ", "text": "もういいわ。\n試着して自分で\n確かめるから。"},
        { "location": "306/TALK"    , "narrator": "つばめ", "text": "ガブちゃん、その服で\n十回目なのに…そんなに\n試着して疲れないのかな？"},
        { "location": "309/TALK"    , "narrator": "ガブリエラ", "text": "っていうか、つばめは\n良い服見つかった？"},
        { "location": "310/TALK"    , "narrator": "ガブリエラ", "text": "今日はあんたの夏服を\n探しに来たんだから、\n真面目に探しなさいよ。"},
        { "location": "311/TALK"    , "narrator": "つばめ", "text": "あっ、そうだったよね。"},
        { "location": "312/TALK"    , "narrator": "ガブリエラ", "text": "なんで忘れてるのよ…。"},
        { "location": "313/TALK"    , "narrator": "つばめ", "text": "ガブちゃんが試着した\n姿が、どれも可愛かった\nから――"},
        { "location": "314/TALK"    , "narrator": "つばめ", "text": "そっちに夢中になってた\nみたい。"},
        { "location": "317/TALK"    , "narrator": "ガブリエラ", "text": "…つばめのこういう\n天然なところ、本当に\n厄介だわ。"},
        { "location": "318/TALK"    , "narrator": "ガブリエラ", "text": "怒るに怒れないじゃない。"},
        { "location": "319/TALK"    , "narrator": "つばめ", "text": "…ガブちゃん？"},
        { "location": "322/TALK"    , "narrator": "ガブリエラ", "text": "ああ、もういいから。\n気にしない！"},
        { "location": "323/TALK"    , "narrator": "ガブリエラ", "text": "っていうか、このままじゃ\nいつになっても決めそうに\nないし――"},
        { "location": "324/TALK"    , "narrator": "ガブリエラ", "text": "あたしがつばめの服を\n選んであげる。"},
        { "location": "327/TALK"    , "narrator": "つばめ", "text": "が、ガブちゃんが選ぶの？"},
        { "location": "329/TALK"    , "narrator": "ガブリエラ", "text": "何よ、不満？"},
        { "location": "332/TALK"    , "narrator": "つばめ", "text": "う、う～ん…。"},
        { "location": "333/TALK"    , "narrator": "つばめ", "text": "でも、ガブちゃんって\n凄くオシャレさん\nだから――"},
        { "location": "334/TALK"    , "narrator": "つばめ", "text": "わたしが選ぶよりも\n素敵な服を見つけて\nくれるかも。"},
        { "location": "335/TALK"    , "narrator": "つばめ", "text": "…じゃあ、\nお願いしようかな？"},
        { "location": "336/TALK"    , "narrator": "ガブリエラ", "text": "うん、よろしい。\n実はもう見つけてたのよ。"},
        { "location": "337/TALK"    , "narrator": "ガブリエラ", "text": "つばめってさ、\nワンピース系の服が\n好きだったでしょ？"},
        { "location": "338/TALK"    , "narrator": "つばめ", "text": "うん。可愛いワンピース\n見つけてくれたの？"},
        { "location": "340/TALK"    , "narrator": "ガブリエラ", "text": "可愛いだけは卒業よ。\nこれからは、こういうのを\n着ていかなくちゃ！"},
        { "location": "345/TALK"    , "narrator": "つばめ", "text": "えっ…あ、あれ？\nこれって、ワンピース？"},
        { "location": "346/TALK"    , "narrator": "つばめ", "text": "けど、胸から上が\n何にもないし…。"},
        { "location": "348/TALK"    , "narrator": "ガブリエラ", "text": "ベアトップのワンピースを\n選んでみたのよ。"},
        { "location": "349/TALK"    , "narrator": "つばめ", "text": "えぇっ！？\nで、でもこれ、捲れたら\n胸が見えちゃうんじゃ…。"},
        { "location": "351/TALK"    , "narrator": "ガブリエラ", "text": "そんな簡単に\n捲れたりしないって。"},
        { "location": "355/TALK"    , "narrator": "つばめ", "text": "で、でも…\nこれじゃブラ紐が\n見えちゃうよ？"},
        { "location": "357/TALK"    , "narrator": "つばめ", "text": "それに、タイトだから\n体のラインもくっきり\n出ちゃいそうだし…。"},
        { "location": "359/TALK"    , "narrator": "ガブリエラ", "text": "当然でしょ？\n大人っぽいデザイン\nなんだから。"},
        { "location": "360/TALK"    , "narrator": "ガブリエラ", "text": "っていうか、紐のない\nタイプのブラなんて、\n沢山あるでしょ？"},
        { "location": "364/TALK"    , "narrator": "つばめ", "text": "そうだけど、付けたこと\nないから…。"},
        { "location": "366/TALK"    , "narrator": "ガブリエラ", "text": "いいから、とりあえず\n着てから考えなさいよ。"},
        { "location": "370/TALK"    , "narrator": "ガブリエラ", "text": "あ、向こうのも\n良さそうかも…。"},
        { "location": "374/TALK"    , "narrator": "つばめ", "text": "…ど、どうしよう。\nあんな服、恥ずかしくて\n着られないよ…。"},
        { "location": "386/TALK"    , "narrator": "つばめ", "text": "困ったよー"},
        { "location": "387/TALK"    , "narrator": "つばめ", "text": "ガブちゃんが選んだ服、\nちょっとわたしには\n派手な感じなの"},
        { "location": "388/TALK"    , "narrator": "つばめ", "text": "でも、せっかく\n選んでくれたのに、"},
        { "location": "389/TALK"    , "narrator": "つばめ", "text": "着たくないなんて\n言えないし…"},
        { "location": "390/TALK"    , "narrator": "つばめ", "text": "どうしたらいいかな？"},
        { "location": "392/SEL"     , "narrator": "", "text": "見てみたいな"},
        { "location": "393/SEL"     , "narrator": "", "text": "ガブリエラにも着せよう"},
        { "location": "394/ACT"     , "narrator": "", "text": "見てみたいな"},
        { "location": "397/TALK"    , "narrator": "つばめ", "text": "ダメ！"},
        { "location": "398/TALK"    , "narrator": "つばめ", "text": "絶対に似合わないから…"},
        { "location": "415/TALK"    , "narrator": "ガブリエラ", "text": "やっぱりこれが一番ね。\n早速試着して。"},
        { "location": "418/TALK"    , "narrator": "つばめ", "text": "あ、あの、ガブちゃん。\n本当に着るの？"},
        { "location": "419/TALK"    , "narrator": "ガブリエラ", "text": "もぉ、試着くらいで\n文句言わないの！"},
        { "location": "420/TALK"    , "narrator": "ガブリエラ", "text": "ほら、早く着てきて。\nそれともここで着る？"},
        { "location": "421/TALK"    , "narrator": "つばめ", "text": "わ、わかったよぉ…。"},
        { "location": "424/TALK"    , "narrator": "つばめ", "text": "…心配だなぁ。"},
        { "location": "439/TALK"    , "narrator": "つばめ", "text": "はぁ…。"},
        { "location": "442/TALK"    , "narrator": "ガブリエラ", "text": "…ごめん。\nちょっと、調子に乗り\n過ぎた。"},
        { "location": "443/TALK"    , "narrator": "ガブリエラ", "text": "まさか、あそこまで\n服に着られちゃってる感が\n凄くなるなんて…。"},
        { "location": "446/TALK"    , "narrator": "つばめ", "text": "…ううん、いいの。"},
        { "location": "447/TALK"    , "narrator": "つばめ", "text": "早いうちに、ああいう服が\nわたしに似合わないのが\nわかって――"},
        { "location": "448/TALK"    , "narrator": "つばめ", "text": "逆に良かったよ。"},
        { "location": "449/TALK"    , "narrator": "ガブリエラ", "text": "ま、まあ、そんなに\n落ち込む必要ないんじゃ\nない？"},
        { "location": "450/TALK"    , "narrator": "ガブリエラ", "text": "あんた、元はそんなに\n悪くないんだし――"},
        { "location": "451/TALK"    , "narrator": "ガブリエラ", "text": "大学生になる頃には、\nきっと着こなせるように\nなるって！"},
        { "location": "452/TALK"    , "narrator": "つばめ", "text": "大学生…あと三年かぁ…。"},
        { "location": "454/TALK"    , "narrator": "つばめ", "text": "それまでには、少しでも\n大人っぽくなれたら\nいいなぁ…。"},
        { "location": "455/ACT"     , "narrator": "", "text": "ガブリエラにも着せよう"},
        { "location": "456/TALK"    , "narrator": "つばめ", "text": "ガブちゃんにも着てもらうの？"},
        { "location": "457/TALK"    , "narrator": "つばめ", "text": "あ、そういうことだね！"},
        { "location": "471/TALK"    , "narrator": "つばめ", "text": "ねえ、ガブちゃんが\n選んでくれた服だけど…。"},
        { "location": "475/TALK"    , "narrator": "ガブリエラ", "text": "何よ、まだ何か言いたい\nことがあるの？"},
        { "location": "477/TALK"    , "narrator": "つばめ", "text": "そうじゃなくて、\nガブちゃんとお揃いなら、\n着てみようかな？"},
        { "location": "478/TALK"    , "narrator": "ガブリエラ", "text": "……は？"},
        { "location": "481/TALK"    , "narrator": "ガブリエラ", "text": "ちょ、本気！？\nあたしにこの服着ろって\n言うの！？"},
        { "location": "483/TALK"    , "narrator": "つばめ", "text": "うん。わたし、こういう\nタイプの服って着たこと\nないから――"},
        { "location": "484/TALK"    , "narrator": "つばめ", "text": "一人で着るの、\nちょっと恥ずかしくて…。"},
        { "location": "486/TALK"    , "narrator": "つばめ", "text": "だから、ガブちゃんにも\n一緒に着てもらえば、\n多分大丈夫だと思うの。"},
        { "location": "487/TALK"    , "narrator": "ガブリエラ", "text": "ちょっと待って！\nダメだって、あたしには\n似合わないから…。"},
        { "location": "488/TALK"    , "narrator": "つばめ", "text": "そんなことないよ。\n可愛いデザインだから、\nきっと似合うって。"},
        { "location": "491/TALK"    , "narrator": "ガブリエラ", "text": "で、でもこれ、胸のとこ\nちょっと開いてるから――"},
        { "location": "492/TALK"    , "narrator": "ガブリエラ", "text": "あたしの体型的に、\n似合わないと思うし…。"},
        { "location": "493/TALK"    , "narrator": "つばめ", "text": "ワンサイズ小さいの\n着れば平気だよ。"},
        { "location": "495/TALK"    , "narrator": "つばめ", "text": "それに、ガブちゃんは\n可愛いから、それくらい\n誰も気にしないって。"},
        { "location": "498/TALK"    , "narrator": "ガブリエラ", "text": "他人じゃなくて、\nあたし自身が気にするん\nだってば！"},
        { "location": "501/TALK"    , "narrator": "ガブリエラ", "text": "っていうか、マズいわ。\nこのままじゃつばめに\n押し切られちゃう！"},
        { "location": "507/TALK"    , "narrator": "ガブリエラ", "text": "…あ、ああっ！\nつばめ、あれ見て、あれ！\nあそこのワンピース！"},
        { "location": "510/TALK"    , "narrator": "ガブリエラ", "text": "あれも素敵だと思わない？\nちょっと大人しめだけど、\n大人っぽい感じするし。"},
        { "location": "512/TALK"    , "narrator": "つばめ", "text": "わぁ、これ良いかも！\nわたし、こういうの\n大好きなんだ！"},
        { "location": "514/TALK"    , "narrator": "ガブリエラ", "text": "そうだと思った。"},
        { "location": "516/TALK"    , "narrator": "ガブリエラ", "text": "やっぱり、あんたには\n普通のワンピースが\n一番よ。"},
        { "location": "518/TALK"    , "narrator": "つばめ", "text": "…よかった。\nやっぱりさっきの服は\n諦めてくれたみたい。"},
        { "location": "522/TALK"    , "narrator": "ガブリエラ", "text": "はぁ…絶対さっきの方が、\nつばめに似合うと思うのに\nなぁ…。"},
        { "location": "292/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>7月15日　3:29 PM</color>\nとある平日の午後、某所ブティックにて。"},
        { "location": "533/DIALOG"  , "narrator": "Dialog_GEThimegoto_ch01", "text": "【スタイリスト候補生】"}
    ]
}
