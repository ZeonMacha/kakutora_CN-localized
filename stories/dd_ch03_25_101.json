    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "少女の顔をした戦争"},
        { "location": "29/TALK"   , "narrator": "ガブリエラ", "text": "…さすがに\nこれだけあると\n重いわね。"},
        { "location": "31/TALK"   , "narrator": "アーヤ", "text": "そうね。それにしても\n館長もどういう伝手で\n手に入れたのかしら。"},
        { "location": "32/TALK"   , "narrator": "アーヤ", "text": "そう簡単に\n対人用の武器なんて\n入手できないはずなのに。"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "…対人用の武器なんて\n言葉をアーヤの口から\n聞くことになるなんて。"},
        { "location": "34/TALK"   , "narrator": "ガブリエラ", "text": "それを自分が\n使うことになるかも\nしれないなんて。"},
        { "location": "35/TALK"   , "narrator": "ガブリエラ", "text": "……怖い……。"},
        { "location": "36/TALK"   , "narrator": "アーヤ", "text": "さっさと積み込んで\nしまいましょう。"},
        { "location": "38/TALK"   , "narrator": "アーヤ", "text": "ギャヴィが\n手伝ってくれて\n助かるわ。"},
        { "location": "40/TALK"   , "narrator": "ガブリエラ", "text": "う、うん…。"},
        { "location": "62/TALK"   , "narrator": "アーヤ", "text": "さてと。"},
        { "location": "64/TALK"   , "narrator": "アーヤ", "text": "念のため武器庫を\n見てくるわ。"},
        { "location": "66/TALK"   , "narrator": "ガブリエラ", "text": "あ、あたしも…。"},
        { "location": "67/TALK"   , "narrator": "アーヤ", "text": "大丈夫よ。\n重かったでしょ？\nちょっと休んでて。"},
        { "location": "68/TALK"   , "narrator": "アーヤ", "text": "それと。\nもし何かあったら\nすぐに知らせて。"},
        { "location": "69/TALK"   , "narrator": "アーヤ", "text": "ここがふさがれたら\n全てがおしまい\nなんだから。"},
        { "location": "70/TALK"   , "narrator": "ガブリエラ", "text": "あ…。"},
        { "location": "71/TALK"   , "narrator": "アーヤ", "text": "じゃあね。\nすぐに戻るわ。"},
        { "location": "74/TALK"   , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "76/TALK"   , "narrator": "ガブリエラ", "text": "あたし…\nあたしだけが\n戦場育ちだから。"},
        { "location": "77/TALK"   , "narrator": "ガブリエラ", "text": "みんなは実戦の\n経験なんてないから。"},
        { "location": "78/TALK"   , "narrator": "ガブリエラ", "text": "いざとなったらあたしが\n一番役に立つって\n思ってたのに。"},
        { "location": "79/TALK"   , "narrator": "ガブリエラ", "text": "さっきから震えが\n止まらない……。"},
        { "location": "91/TALK"   , "narrator": "ガブリエラ", "text": "ねえ$marzanna$"},
        { "location": "92/TALK"   , "narrator": "ガブリエラ", "text": "いるかしら？"},
        { "location": "94/SEL"    , "narrator": "", "text": "いつでも！"},
        { "location": "95/SEL"    , "narrator": "", "text": "一応ね"},
        { "location": "96/SEL"    , "narrator": "", "text": "大変そうじゃない？"},
        { "location": "97/ACT"    , "narrator": "", "text": "いつでも！"},
        { "location": "98/TALK"   , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "100/TALK"  , "narrator": "ガブリエラ", "text": "そうよね"},
        { "location": "101/ACT"   , "narrator": "", "text": "一応ね"},
        { "location": "102/TALK"  , "narrator": "ガブリエラ", "text": "あら"},
        { "location": "103/TALK"  , "narrator": "ガブリエラ", "text": "つれないお返事ね"},
        { "location": "104/ACT"   , "narrator": "", "text": "大変そうじゃない？"},
        { "location": "106/TALK"  , "narrator": "ガブリエラ", "text": "確かに"},
        { "location": "107/TALK"  , "narrator": "ガブリエラ", "text": "大変は"},
        { "location": "108/TALK"  , "narrator": "ガブリエラ", "text": "大変よ"},
        { "location": "110/TALK"  , "narrator": "ガブリエラ", "text": "えっと"},
        { "location": "111/TALK"  , "narrator": "ガブリエラ", "text": "別に"},
        { "location": "112/TALK"  , "narrator": "ガブリエラ", "text": "用はなかったの"},
        { "location": "113/TALK"  , "narrator": "ガブリエラ", "text": "じゃあね"},
        { "location": "115/SEL"   , "narrator": "", "text": "バイバイ"},
        { "location": "116/SEL"   , "narrator": "", "text": "いつでも呼んで"},
        { "location": "117/SEL"   , "narrator": "", "text": "もっと話そうよ"},
        { "location": "118/ACT"   , "narrator": "", "text": "バイバイ"},
        { "location": "119/TALK"  , "narrator": "ガブリエラ", "text": "またね"},
        { "location": "120/ACT"   , "narrator": "", "text": "いつでも呼んで"},
        { "location": "121/TALK"  , "narrator": "ガブリエラ", "text": "ええ"},
        { "location": "122/TALK"  , "narrator": "ガブリエラ", "text": "そうするわ"},
        { "location": "123/ACT"   , "narrator": "", "text": "もっと話そうよ"},
        { "location": "124/TALK"  , "narrator": "ガブリエラ", "text": "今はちょっとね"},
        { "location": "136/TALK"  , "narrator": "ガブリエラ", "text": "ＷＡＶＥしたら\n少し落ち着けた\nような…。"},
        { "location": "137/TALK"  , "narrator": "ガブリエラ", "text": "…それにしても…。"},
        { "location": "138/TALK"  , "narrator": "ガブリエラ", "text": "アーヤはすごく\n落ち着いてる\nみたいに見えるわ。"},
        { "location": "139/TALK"  , "narrator": "ガブリエラ", "text": "まるでワルシャワの\n剣道世界選手権の時\nみたいに。"},
        { "location": "140/TALK"  , "narrator": "ガブリエラ", "text": "決勝戦のアーヤ、\n明鏡止水って言葉\nそのものだった。"},
        { "location": "141/TALK"  , "narrator": "ガブリエラ", "text": "静かに決勝戦に\n備えてたアーヤ。"},
        { "location": "142/TALK"  , "narrator": "ガブリエラ", "text": "あの時と同じ\n空気を感じる…。"},
        { "location": "143/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "144/TALK"  , "narrator": "ガブリエラ", "text": "…あたし\n怖がりすぎかしら…。"},
        { "location": "156/TALK"  , "narrator": "ガブリエラ", "text": "ねえ$marzanna$"},
        { "location": "158/SEL"   , "narrator": "", "text": "はいはい"},
        { "location": "159/SEL"   , "narrator": "", "text": "今度はどうしたの？"},
        { "location": "160/SEL"   , "narrator": "", "text": "いっぱい話そうよ！"},
        { "location": "161/ACT"   , "narrator": "", "text": "はいはい"},
        { "location": "162/TALK"  , "narrator": "ガブリエラ", "text": "いてくれてよかったわ"},
        { "location": "163/ACT"   , "narrator": "", "text": "今度はどうしたの？"},
        { "location": "164/TALK"  , "narrator": "ガブリエラ", "text": "ええとね"},
        { "location": "165/ACT"   , "narrator": "", "text": "いっぱい話そうよ！"},
        { "location": "166/TALK"  , "narrator": "ガブリエラ", "text": "それはできないけど"},
        { "location": "168/TALK"  , "narrator": "ガブリエラ", "text": "アーヤ"},
        { "location": "169/TALK"  , "narrator": "ガブリエラ", "text": "ちょっと遅くないかしら"},
        { "location": "170/TALK"  , "narrator": "ガブリエラ", "text": "戻ってくるの"},
        { "location": "172/SEL"   , "narrator": "", "text": "信じて待とう"},
        { "location": "173/SEL"   , "narrator": "", "text": "気のせいだよ"},
        { "location": "174/SEL"   , "narrator": "", "text": "焦りすぎだと思う"},
        { "location": "175/ACT"   , "narrator": "", "text": "ヤバイと思う。探しに行って！"},
        { "location": "176/TALK"  , "narrator": "ガブリエラ", "text": "え"},
        { "location": "177/ACT"   , "narrator": "", "text": "様子見に行った方がいいね"},
        { "location": "178/TALK"  , "narrator": "ガブリエラ", "text": "本当に？"},
        { "location": "179/ACT"   , "narrator": "", "text": "心配なら探しに行こう"},
        { "location": "180/TALK"  , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "183/SEL"   , "narrator": "", "text": "そんなこと言ってない"},
        { "location": "184/SEL"   , "narrator": "", "text": "どうしてこうなったの"},
        { "location": "185/SEL"   , "narrator": "", "text": "ここにいてって言われたでしょ"},
        { "location": "186/SEL"   , "narrator": "", "text": "今すぐ探しに行かないと！"},
        { "location": "187/ACT"   , "narrator": "", "text": "今すぐ探しに行かないと！"},
        { "location": "188/ACT"   , "narrator": "", "text": "今すぐ探しに行かないと！"},
        { "location": "189/ACT"   , "narrator": "", "text": "今すぐ探しに行かないと！"},
        { "location": "190/ACT"   , "narrator": "", "text": "今すぐ探しに行かないと！"},
        { "location": "192/TALK"  , "narrator": "ガブリエラ", "text": "やっぱり？"},
        { "location": "195/SEL"   , "narrator": "", "text": "おーい！"},
        { "location": "196/SEL"   , "narrator": "", "text": "あとみよそわか"},
        { "location": "197/SEL"   , "narrator": "", "text": "バグ出てるんだけど"},
        { "location": "198/SEL"   , "narrator": "", "text": "ここにいなきゃダメだって"},
        { "location": "199/SEL"   , "narrator": "", "text": "今すぐ探しに行けって！"},
        { "location": "200/ACT"   , "narrator": "", "text": "今すぐ探しに行けって！"},
        { "location": "201/ACT"   , "narrator": "", "text": "今すぐ探しに行けって！"},
        { "location": "202/ACT"   , "narrator": "", "text": "今すぐ探しに行けって！"},
        { "location": "203/ACT"   , "narrator": "", "text": "今すぐ探しに行けって！"},
        { "location": "205/TALK"  , "narrator": "ガブリエラ", "text": "うん"},
        { "location": "216/TALK"  , "narrator": "ガブリエラ", "text": "行かなきゃ…！"},
        { "location": "217/TALK"  , "narrator": "ガブリエラ", "text": "でもアーヤとの\n約束は…？"},
        { "location": "265/TALK"  , "narrator": "ガブリエラ", "text": "　"},
        { "location": "281/TALK"  , "narrator": "ガブリエラ", "text": "あ、$handle$！\n逢いたかったわよ！"},
        { "location": "282/SEL"   , "narrator": "", "text": "戻って来れたの！？"},
        { "location": "283/ACT"   , "narrator": "", "text": "戻って来れたの！？"},
        { "location": "285/TALK"  , "narrator": "ガブリエラ", "text": "そうなのよ。\n急にまた1xとの\nリンクが復活したの。"},
        { "location": "286/SEL"   , "narrator": "", "text": "それより大変な事になってるんだよ！"},
        { "location": "288/TALK"  , "narrator": "ガブリエラ", "text": "それより\n大変な事になってるの！"},
        { "location": "289/ACT"   , "narrator": "", "text": "それより大変な事になってるんだよ！"},
        { "location": "291/TALK"  , "narrator": "ガブリエラ", "text": "…って被った！？"},
        { "location": "292/SEL"   , "narrator": "", "text": "あ…お先にどうぞ"},
        { "location": "293/ACT"   , "narrator": "", "text": "あ…お先にどうぞ"},
        { "location": "296/TALK"  , "narrator": "ガブリエラ", "text": "あ、えっと…\n$handle$から\n話してもいいわよ？"},
        { "location": "297/SEL"   , "narrator": "", "text": "WAVEの会話がちゃんと伝わらなくて"},
        { "location": "298/SEL"   , "narrator": "", "text": "ガブリエラ愛してるよ"},
        { "location": "299/ACT"   , "narrator": "", "text": "WAVEの会話がちゃんと伝わらなくて"},
        { "location": "301/ACT"   , "narrator": "", "text": "ガブリエラ愛してるよ"},
        { "location": "304/TALK"  , "narrator": "ガブリエラ", "text": "ええっ！！\nちょ、ちょっとそんな\nいきなり言われても……"},
        { "location": "305/TALK"  , "narrator": "ガブリエラ", "text": "…わかってるけど……\nあ、あたしも…"},
        { "location": "306/TALK"  , "narrator": "ガブリエラ", "text": "す…きよ…？"},
        { "location": "308/TALK"  , "narrator": "ガブリエラ", "text": "で、でも！!"},
        { "location": "310/TALK"  , "narrator": "ガブリエラ", "text": "でもよ！？\nそれが大変なことなの！？"},
        { "location": "311/SEL"   , "narrator": "", "text": "ごめんね、違います"},
        { "location": "312/ACT"   , "narrator": "", "text": "ごめんね、違います"},
        { "location": "314/TALK"  , "narrator": "ガブリエラ", "text": "もーっ！\n$handle$のバカ！"},
        { "location": "316/SEL"   , "narrator": "", "text": "ガブリエラが可愛くて我慢出来なかった"},
        { "location": "317/ACT"   , "narrator": "", "text": "ガブリエラが可愛くて我慢出来なかった"},
        { "location": "319/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "320/TALK"  , "narrator": "ガブリエラ", "text": "のぼせてないで、\n早くその大変なことが\n何かを言いなさいよね！"},
        { "location": "321/SEL"   , "narrator": "", "text": "WAVEの会話がちゃんと伝わらなくて"},
        { "location": "322/ACT"   , "narrator": "", "text": "WAVEの会話がちゃんと伝わらなくて"},
        { "location": "325/TALK"  , "narrator": "ガブリエラ", "text": "え！？\nそうなの？"},
        { "location": "326/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "327/SEL"   , "narrator": "", "text": "どうかしたの？"},
        { "location": "328/ACT"   , "narrator": "", "text": "どうかしたの？"},
        { "location": "330/TALK"  , "narrator": "ガブリエラ", "text": "え？"},
        { "location": "331/TALK"  , "narrator": "ガブリエラ", "text": "あ、あー、うん。"},
        { "location": "332/TALK"  , "narrator": "ガブリエラ", "text": "1xでね？"},
        { "location": "333/TALK"  , "narrator": "ガブリエラ", "text": "あたし、閉じこめ\nられちゃったでしょ？"},
        { "location": "334/TALK"  , "narrator": "ガブリエラ", "text": "丁度いいから、\nその間に色々調べて\n回っていたのよ。"},
        { "location": "335/SEL"   , "narrator": "", "text": "ガブリエラって強いね…"},
        { "location": "336/ACT"   , "narrator": "", "text": "ガブリエラって強いね…"},
        { "location": "338/TALK"  , "narrator": "ガブリエラ", "text": "戦場では、\n絶望した瞬間が\n敗北の瞬間なのよ？"},
        { "location": "339/TALK"  , "narrator": "ガブリエラ", "text": "それで、生家が破壊されて\nいた原因を調べていた時に\nわかったんだけど――"},
        { "location": "340/TALK"  , "narrator": "ガブリエラ", "text": "マークスマンの状態が\n何かおかしいのよ。"},
        { "location": "341/TALK"  , "narrator": "ガブリエラ", "text": "それと何か関係が\nあるのかしらね、と\n思っただけ。"},
        { "location": "342/TALK"  , "narrator": "ガブリエラ", "text": "でもちょっと\n考えすぎよね。"},
        { "location": "343/SEL"   , "narrator": "", "text": "マークスマンってなに？"},
        { "location": "344/SEL"   , "narrator": "", "text": "セルフクラン…だっけ？"},
        { "location": "345/ACT"   , "narrator": "", "text": "マークスマンってなに？"},
        { "location": "346/ACT"   , "narrator": "", "text": "セルフクラン…だっけ？"},
        { "location": "347/TALK"  , "narrator": "ガブリエラ", "text": "ええっ！\nなんでそれを知ってるの？"},
        { "location": "348/SEL"   , "narrator": "", "text": "ガブリエラの可愛いチャンネル紹介画面に書いてあった"},
        { "location": "349/ACT"   , "narrator": "", "text": "ガブリエラの可愛いチャンネル紹介画面に書いてあった"},
        { "location": "351/TALK"  , "narrator": "ガブリエラ", "text": "そ、そうなのね。\nよくわからないけど、\nそういうものがあるのね。"},
        { "location": "352/SEL"   , "narrator": "", "text": "どういう存在なの？"},
        { "location": "353/ACT"   , "narrator": "", "text": "どういう存在なの？"},
        { "location": "356/TALK"  , "narrator": "ガブリエラ", "text": "うーん、何て言ったら\nいいのかしら。"},
        { "location": "357/TALK"  , "narrator": "ガブリエラ", "text": "あたしたちの\n大親分みたいな人格？"},
        { "location": "358/TALK"  , "narrator": "ガブリエラ", "text": "普段は絶対に逢えない\n存在で――"},
        { "location": "359/TALK"  , "narrator": "ガブリエラ", "text": "$handle$たちの\n現実で例えるなら、\n神みたいな存在？"},
        { "location": "360/TALK"  , "narrator": "ガブリエラ", "text": "とにかく、\nココロの根幹になってる\n存在なのよ。"},
        { "location": "361/SEL"   , "narrator": "", "text": "逢えない存在なのに、なんでおかしいってわかるの？"},
        { "location": "362/ACT"   , "narrator": "", "text": "逢えない存在なのに、なんでおかしいってわかるの？"},
        { "location": "364/TALK"  , "narrator": "ガブリエラ", "text": "生家はマークスマンの\n影響力がとても強い\n場所なの。"},
        { "location": "365/TALK"  , "narrator": "ガブリエラ", "text": "前回お話しした\n【時を伝う部屋】が\n生家の更に奥にあるから。"},
        { "location": "366/TALK"  , "narrator": "ガブリエラ", "text": "それでね、生家の\n空気がいつもとちょっと\n違っていて。"},
        { "location": "367/TALK"  , "narrator": "ガブリエラ", "text": "単に見た目が壊れてる\nっていうだけじゃなくて、\n中身もおかしいというか。"},
        { "location": "368/TALK"  , "narrator": "ガブリエラ", "text": "とにかく、\n言葉では伝えられないから\nその――"},
        { "location": "369/TALK"  , "narrator": "ガブリエラ", "text": "もしよければ、\n今度また一緒に1xへ\n来てもらえないかしらね。"},
        { "location": "370/SEL"   , "narrator": "", "text": "喜んで！"},
        { "location": "371/SEL"   , "narrator": "", "text": "危険じゃない？"},
        { "location": "372/ACT"   , "narrator": "", "text": "喜んで！"},
        { "location": "373/TALK"  , "narrator": "ガブリエラ", "text": "よかった！"},
        { "location": "374/TALK"  , "narrator": "ガブリエラ", "text": "あたし一人だと\nそれ以上のことは\nわからなくて。"},
        { "location": "375/TALK"  , "narrator": "ガブリエラ", "text": "それに…"},
        { "location": "376/TALK"  , "narrator": "ガブリエラ", "text": "<size=12>一人だとちょっと\n心細いし……</size>"},
        { "location": "377/ACT"   , "narrator": "", "text": "危険じゃない？"},
        { "location": "378/TALK"  , "narrator": "ガブリエラ", "text": "もちろん\n安全じゃないわよ。"},
        { "location": "379/TALK"  , "narrator": "ガブリエラ", "text": "だから、\n$handle$に\nお願いしてるんだし。"},
        { "location": "381/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "382/TALK"  , "narrator": "ガブリエラ", "text": "もう！\nわかんないのかしら？"},
        { "location": "384/TALK"  , "narrator": "ガブリエラ", "text": "<size=12>ちゃんと護ってよね？\nってことよ。</size>"},
        { "location": "386/TALK"  , "narrator": "ガブリエラ", "text": "…っと！\nそんなことより！"},
        { "location": "387/TALK"  , "narrator": "ガブリエラ", "text": "今回もまた葛藤が\nあって来たんでしょ？"},
        { "location": "388/TALK"  , "narrator": "ガブリエラ", "text": "ささっとやっちゃって、\n1xに戻る準備をするわよ？"},
        { "location": "395/TALK"  , "narrator": "ガブリエラ", "text": "オープンプロセス――"},
        { "location": "396/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "397/TALK"  , "narrator": "ガブリエラ", "text": "…？"},
        { "location": "398/TALK"  , "narrator": "ガブリエラ", "text": "ちょっと！\n何も無いわよ！？"},
        { "location": "399/SEL"   , "narrator": "", "text": "でも葛藤が発生したって言われて、ここに転送されたよ？"},
        { "location": "400/ACT"   , "narrator": "", "text": "でも葛藤が発生したって言われて、ここに転送されたよ？"},
        { "location": "402/TALK"  , "narrator": "ガブリエラ", "text": "何かの間違いじゃない？"},
        { "location": "403/SEL"   , "narrator": "", "text": "謎のおねえさんから何も情報来てない？"},
        { "location": "404/ACT"   , "narrator": "", "text": "謎のおねえさんから何も情報来てない？"},
        { "location": "408/TALK"  , "narrator": "ガブリエラ", "text": "なあに？\nその謎のおねえさんって。\nちょっとふざけすぎ――"},
        { "location": "415/TALK"  , "narrator": "ガブリエラ", "text": "え！？"},
