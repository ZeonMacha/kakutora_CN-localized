{
    "dir": "chap08/daydra/dd_ch04_08_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "8456",
        "cid": "miyabi",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "ネットサーフィン"
    },
    "entry":
    [
        { "location": "210/SCENARIO", "narrator": "", "text": "ネットサーフィン"},
        { "location": "227/TALK"    , "narrator": "みやび", "text": "今日もネット掲示板は\n大荒れやね。"},
        { "location": "228/TALK"    , "narrator": "みやび", "text": "どうしてここの掲示板は\nいつも荒れてるがか…？"},
        { "location": "229/TALK"    , "narrator": "みやび", "text": "…罵倒のぶつけ合いが\n始まったき、他んとこ\n見るか。"},
        { "location": "232/TALK"    , "narrator": "真幌", "text": "おい、みやび。"},
        { "location": "234/TALK"    , "narrator": "みやび", "text": "おっ、まほさん。\nどうかしたがですか？"},
        { "location": "235/TALK"    , "narrator": "真幌", "text": "どうかしたも何も、\n今はバイト中だろう？"},
        { "location": "236/TALK"    , "narrator": "真幌", "text": "なのに、おまえときたら\nさっきからずっとネット\nサーフィンばかり――"},
        { "location": "237/TALK"    , "narrator": "真幌", "text": "少しは働いたら\nどうなんだ？"},
        { "location": "238/TALK"    , "narrator": "みやび", "text": "うちの仕事はとっくに\n終わっちょりますき。"},
        { "location": "240/TALK"    , "narrator": "真幌", "text": "そういう問題ではない！"},
        { "location": "241/TALK"    , "narrator": "真幌", "text": "いいか？　確かにおまえは\n自分の仕事をしっかりと\n終わらせたかもしれん。"},
        { "location": "242/TALK"    , "narrator": "真幌", "text": "しかしな、まだ他の\nみんなが働いていると\nいうのにおまえだけ…。"},
        { "location": "243/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "244/SEL"     , "narrator": "", "text": "たまには大人しく聞こう"},
        { "location": "245/SEL"     , "narrator": "", "text": "真幌を黙らせる情報を探せ"},
        { "location": "249/TALK"    , "narrator": "みやび", "text": "まほさん、珍しく説教\nモードになっちゅうな。"},
        { "location": "250/TALK"    , "narrator": "みやび", "text": "まあ、いつもの気まぐれ\nとは思うけんど…\n面倒やなぁ。"},
        { "location": "251/TALK"    , "narrator": "みやび", "text": "いつもは何も言わんのに、\n急にガミガミ言われても、\n困るぞね。"},
        { "location": "252/TALK"    , "narrator": "みやび", "text": "どうにか黙らせる方法が\nあればえいんやけんど、\nう～ん…。"},
        { "location": "255/TALK"    , "narrator": "真幌", "text": "…おい、聞いてないだろ？"},
        { "location": "256/TALK"    , "narrator": "みやび", "text": "まほさん黙らす方法…\n相棒に聞いた方が\nえいやろか？"},
        { "location": "258/TALK"    , "narrator": "真幌", "text": "みやび！"},
        { "location": "259/TALK"    , "narrator": "みやび", "text": "うわっ！？\nどうしたがです？\n急に大声出して…。"},
        { "location": "260/TALK"    , "narrator": "真幌", "text": "どうしたじゃない！\n人が説教してる時に\nぼーっとするな！"},
        { "location": "261/TALK"    , "narrator": "真幌", "text": "そもそも、おまえは\nいつもいつも――"},
        { "location": "263/TALK"    , "narrator": "みやび", "text": "…あかん、こりゃ当分\n終わりそうにないな。"},
        { "location": "264/TALK"    , "narrator": "みやび", "text": "余計なこと考えんで、\n黙って耳傾けておくべき\nやったか…。"},
        { "location": "265/TALK"    , "narrator": "真幌", "text": "…また聞いてないな？"},
        { "location": "266/TALK"    , "narrator": "みやび", "text": "聞いてますよ。"},
        { "location": "268/TALK"    , "narrator": "みやび", "text": "自業自得やし、\nちっくと真面目に聞くと\nするちや。"},
        { "location": "270/ACT"     , "narrator": "", "text": "たまには大人しく聞こう"},
        { "location": "289/TALK"    , "narrator": "みやび", "text": "…相棒は大人やね"},
        { "location": "300/TALK"    , "narrator": "みやび", "text": "まあ、まほさんがこんなに\nガミガミ言うんは珍しい\nことやき。"},
        { "location": "301/TALK"    , "narrator": "みやび", "text": "きっと、何か嫌なことでも\nあったんやろうなぁ。"},
        { "location": "302/TALK"    , "narrator": "みやび", "text": "うちも相棒を見習って、\nちっくと大人になると\nするちや。"},
        { "location": "303/TALK"    , "narrator": "真幌", "text": "自分の仕事が終わったなら\n他の者を手伝うとかしたら\nどうなんだ？"},
        { "location": "304/TALK"    , "narrator": "真幌", "text": "何も力仕事をしろとは\n言わん。おまえに力仕事は\n期待していないからな。"},
        { "location": "305/TALK"    , "narrator": "真幌", "text": "しかし、劇場の掃除を\n手伝うくらいはできる\nだろう？"},
        { "location": "307/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "308/TALK"    , "narrator": "真幌", "text": "劇場の中以外でも\nやれることはある。"},
        { "location": "309/TALK"    , "narrator": "真幌", "text": "うちのチラシを道に立って\n配ることもできるはずだ。"},
        { "location": "310/TALK"    , "narrator": "真幌", "text": "まあ、大勢に押しかけられ\nても困りはするが――"},
        { "location": "311/TALK"    , "narrator": "みやび", "text": "…まほさん、相当溜まって\nたんやねぇ。"},
        { "location": "312/TALK"    , "narrator": "真幌", "text": "劇場がずっと閑古鳥なのも\nそれはそれで困る。"},
        { "location": "313/TALK"    , "narrator": "真幌", "text": "どうしてこの劇場はやって\nいけてるのかと疑問に…。"},
        { "location": "314/TALK"    , "narrator": "真幌", "text": "…………。"},
        { "location": "315/TALK"    , "narrator": "みやび", "text": "？　どうかしたがです？"},
        { "location": "316/TALK"    , "narrator": "真幌", "text": "…やけに大人しいな？"},
        { "location": "317/TALK"    , "narrator": "みやび", "text": "説教やき、ちゃんと\n聞きますがよ。"},
        { "location": "318/TALK"    , "narrator": "真幌", "text": "…そうか。"},
        { "location": "319/TALK"    , "narrator": "真幌", "text": "いや、もういい。\n少し言い過ぎたようだ。"},
        { "location": "320/TALK"    , "narrator": "真幌", "text": "まあ、仕事中のサボりは\nほどほどにしろ。\n以上だ。"},
        { "location": "325/TALK"    , "narrator": "みやび", "text": "…思ったよりあっさり\n終わりよったな。"},
        { "location": "326/TALK"    , "narrator": "みやび", "text": "時には大人しく聞くんも、\n有効手段ゆうことやね。"},
        { "location": "327/ACT"     , "narrator": "", "text": "真幌を黙らせる情報を探せ"},
        { "location": "348/TALK"    , "narrator": "みやび", "text": "まほさんを黙らせる情報…微妙に難しいことを言いよる"},
        { "location": "349/TALK"    , "narrator": "みやび", "text": "…まあ、当てがないわけやないけんどね"},
        { "location": "360/TALK"    , "narrator": "みやび", "text": "多分、海外サイトの\nこの辺りなら…。"},
        { "location": "361/TALK"    , "narrator": "真幌", "text": "自分の仕事が終わったなら\n他の者を手伝うとかしたら\nどうなんだ？"},
        { "location": "363/TALK"    , "narrator": "みやび", "text": "まほさんの好みを\n考えると、多分…。"},
        { "location": "364/TALK"    , "narrator": "真幌", "text": "何も力仕事をしろとは\n言わん。おまえに力仕事は\n期待して――"},
        { "location": "365/TALK"    , "narrator": "真幌", "text": "って、話くらい聞け！"},
        { "location": "367/TALK"    , "narrator": "みやび", "text": "まほさん、ちっくと\n聞きたいがですけど――"},
        { "location": "368/TALK"    , "narrator": "みやび", "text": "「死霊のカウボーイ」\nっちゅう大昔の映画、\n知っちょりますか？"},
        { "location": "369/TALK"    , "narrator": "真幌", "text": "…９０年以上前に米国で\n公開した幻の映画だ。"},
        { "location": "370/TALK"    , "narrator": "真幌", "text": "現存するフィルムはないと\n言われ、今では伝説と\nなった映画の一本で――"},
        { "location": "371/TALK"    , "narrator": "真幌", "text": "って、話を逸らすな！"},
        { "location": "373/TALK"    , "narrator": "みやび", "text": "いや、説教するんは\nいいがですけんど――"},
        { "location": "374/TALK"    , "narrator": "みやび", "text": "そのフィルムの一つが、\n海外のオークション\nサイトに出てますがよ？"},
        { "location": "376/TALK"    , "narrator": "真幌", "text": "…………。"},
        { "location": "378/TALK"    , "narrator": "真幌", "text": "ほ、本当か？"},
        { "location": "379/TALK"    , "narrator": "みやび", "text": "ほんまですよ。"},
        { "location": "380/TALK"    , "narrator": "みやび", "text": "まほさんがえいなら、\n落札のために張り付き\nますけんど…。"},
        { "location": "382/TALK"    , "narrator": "真幌", "text": "なんてことだ…まさか\n現存するフィルムが\n残っていたとは…。"},
        { "location": "384/TALK"    , "narrator": "真幌", "text": "金に糸目はつけん！\n何としても落札しろ！！"},
        { "location": "385/TALK"    , "narrator": "みやび", "text": "ラジャーです。\n絶対に落札して\nみせますき。"},
        { "location": "389/TALK"    , "narrator": "みやび", "text": "まほさん対策に、この手の\n映画の情報、集めた方が\nえいかもしれんね。"},
        { "location": "218/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>5月20日　5:20 PM</color>\n5月も半ばを過ぎた頃、神楽坂トライナリーのバイト中。"},
        { "location": "400/DIALOG"  , "narrator": "Dialog_GEThimegoto_ch04", "text": "【第七藝術】"}
    ]
}
