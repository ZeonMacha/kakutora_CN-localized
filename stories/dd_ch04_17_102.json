{
    "dir": "chap17/daydra/dd_ch04_17_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "17405",
        "cid": "miyabi",
        "title": "005 メインストーリー",
        "sub_title": "相対的情報漏洩＜後編＞"
    },
    "entry":
    [
        { "location": "582/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "584/TALK"  , "narrator": "みやび", "text": "すみません。\nその命令には、\n従えないです。"},
        { "location": "585/TALK"  , "narrator": "真幌", "text": "…なんだと？"},
        { "location": "587/TALK"  , "narrator": "みやび", "text": "すみません…。\nけんど、嫌ながです。"},
        { "location": "588/TALK"  , "narrator": "みやび", "text": "仲間の素性を\n探るような行為は…。"},
        { "location": "589/TALK"  , "narrator": "真幌", "text": "おまえ、さっき私に\n言ったよな？"},
        { "location": "590/TALK"  , "narrator": "真幌", "text": "卯月をスパイと\n思っていた時期が\nあった、と。"},
        { "location": "591/TALK"  , "narrator": "真幌", "text": "おまえも、卯月を\n怪しいと思って\nいたんじゃないのか？"},
        { "location": "592/TALK"  , "narrator": "みやび", "text": "そうです。\n今でも疑うてます。"},
        { "location": "593/TALK"  , "narrator": "真幌", "text": "ならば、どうして\n私の命令を拒否する？"},
        { "location": "596/TALK"  , "narrator": "みやび", "text": "それは……。"},
        { "location": "598/TALK"  , "narrator": "みやび", "text": "卯月はうちらの\n仲間やからです。"},
        { "location": "599/TALK"  , "narrator": "みやび", "text": "卯月については、\nまっこと疑わしい、\n謎な部分が多いです。"},
        { "location": "601/TALK"  , "narrator": "みやび", "text": "けんど――\nそれでも。"},
        { "location": "602/TALK"  , "narrator": "みやび", "text": "フェノメノンと\n何度も戦った\n仲間です。"},
        { "location": "604/TALK"  , "narrator": "みやび", "text": "ですき。"},
        { "location": "605/TALK"  , "narrator": "みやび", "text": "素性を調べよう\nなんて気に、\nならんがです。"},
        { "location": "606/TALK"  , "narrator": "真幌", "text": "…………。"},
        { "location": "607/TALK"  , "narrator": "みやび", "text": "お叱りは受けますが、\n答えは変わらんが\nですよ？"},
        { "location": "608/TALK"  , "narrator": "真幌", "text": "…いや、叱りは\nしないさ。"},
        { "location": "609/TALK"  , "narrator": "真幌", "text": "だが、みやびにしては\n随分と甘いな。"},
        { "location": "610/TALK"  , "narrator": "真幌", "text": "おまえなら、躊躇なく\nやってくれると\n思ったんだが…。"},
        { "location": "611/TALK"  , "narrator": "みやび", "text": "…うちらしくないと\n思いますか？"},
        { "location": "612/TALK"  , "narrator": "真幌", "text": "ああ、思う。"},
        { "location": "613/TALK"  , "narrator": "真幌", "text": "…だが、正直言って\n嬉しいよ。"},
        { "location": "614/TALK"  , "narrator": "真幌", "text": "おまえが、そこまで\n仲間のことを思って\nいると知れてな。"},
        { "location": "615/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "616/TALK"  , "narrator": "真幌", "text": "すまなかったな。\n嫌な役目を負わせよう\nとして…。"},
        { "location": "617/TALK"  , "narrator": "みやび", "text": "いえ…。"},
        { "location": "619/TALK"  , "narrator": "みやび", "text": "けんど、卯月の件は\n放置するわけには\nいきませんよね？"},
        { "location": "621/TALK"  , "narrator": "真幌", "text": "当然だ。"},
        { "location": "623/TALK"  , "narrator": "真幌", "text": "私は今から、\n管理庁へ抗議をしに\n行ってくる。"},
        { "location": "624/TALK"  , "narrator": "真幌", "text": "私にまで情報を\n隠してたというのは、\n絶対に許せんからな。"},
        { "location": "625/TALK"  , "narrator": "みやび", "text": "…大丈夫ながですか？\n管理庁に、一人で行く\nなんて…。"},
        { "location": "626/TALK"  , "narrator": "真幌", "text": "フェノメノンの中で\n戦うおまえ達に\n比べたら、な。"},
        { "location": "627/TALK"  , "narrator": "真幌", "text": "管理庁に行くくらい、\nなんてことはない。"},
        { "location": "628/TALK"  , "narrator": "真幌", "text": "…気は緩められん\nがな。"},
        { "location": "629/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "630/TALK"  , "narrator": "真幌", "text": "留守を任せたぞ、\nみやび。"},
        { "location": "635/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "636/TALK"  , "narrator": "みやび", "text": "仲間の素性は\n調べられん、か…。"},
        { "location": "638/TALK"  , "narrator": "みやび", "text": "まっこと、うちも\n甘くなったぞね…。"},
        { "location": "649/DIALOG", "narrator": "Dialog_chapter_ch04", "text": "【14 神楽学校やめるってよ】"}
    ]
}
