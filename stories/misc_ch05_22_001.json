    [
        { "location": "7048/SCENARIO", "narrator": "", "text": "スーさんスーサイド"},
        { "location": "7075/TALK"    , "narrator": "神楽", "text": "集中してる時は食事するの忘れたりしちゃうけど"},
        { "location": "7076/TALK"    , "narrator": "神楽", "text": "健康にはよくないぴょん"},
        { "location": "7078/SEL"     , "narrator": "", "text": "何事もほどほどに"},
        { "location": "7079/SEL"     , "narrator": "", "text": "でもそういうの楽しいよね"},
        { "location": "7080/SEL"     , "narrator": "", "text": "神楽に食事を作ってあげたい"},
        { "location": "7081/ACT"     , "narrator": "", "text": "何事もほどほどに"},
        { "location": "7082/TALK"    , "narrator": "神楽", "text": "それができたら悩まないぴょん、、、"},
        { "location": "7083/ACT"     , "narrator": "", "text": "でもそういうの楽しいよね"},
        { "location": "7084/TALK"    , "narrator": "神楽", "text": "そうそう本当そう！"},
        { "location": "7085/TALK"    , "narrator": "神楽", "text": "だから困るぴょん、、、"},
        { "location": "7086/ACT"     , "narrator": "", "text": "神楽に食事を作ってあげたい"},
        { "location": "7090/TALK"    , "narrator": "神楽", "text": "$handlek$の手料理ゲットだぜー！！！"},
        { "location": "7091/TALK"    , "narrator": "神楽", "text": "楽しみー！！！"},
        { "location": "7093/TALK"    , "narrator": "神楽", "text": "自分に優しくないのは緩やかな自殺みたいなものらしいぴょん"},
        { "location": "7094/TALK"    , "narrator": "神楽", "text": "そう聞くと厨二ゴコロがうずいちゃう"},
        { "location": "7096/SEL"     , "narrator": "", "text": "その手首の傷ひょっとして…"},
        { "location": "7097/SEL"     , "narrator": "", "text": "うんまあそれでいいけど"},
        { "location": "7098/SEL"     , "narrator": "", "text": "神楽の体調がちょっと心配"},
        { "location": "7099/ACT"     , "narrator": "", "text": "その手首の傷ひょっとして…"},
        { "location": "7100/TALK"    , "narrator": "神楽", "text": "なんでもないから気にしないで、、、？"},
        { "location": "7101/ACT"     , "narrator": "", "text": "うんまあそれでいいけど"},
        { "location": "7102/TALK"    , "narrator": "神楽", "text": "あんまり乗り気じゃないみたい？"},
        { "location": "7103/ACT"     , "narrator": "", "text": "神楽の体調がちょっと心配"},
        { "location": "7105/TALK"    , "narrator": "神楽", "text": "$handlek$やさしー"},
        { "location": "7107/TALK"    , "narrator": "神楽", "text": "ぴょんこは大丈夫！！"},
        { "location": "7108/TALK"    , "narrator": "神楽", "text": "今元気になったから！！！"},
        { "location": "7110/TALK"    , "narrator": "神楽", "text": "ぴょんこは完璧主義者だからどうしてもダメなんだぴょん"},
        { "location": "7111/TALK"    , "narrator": "神楽", "text": "適度な息抜きも大事！！！"}
    ]
}
