        "title": "らぶとーく 第60話",
        "sub_title": "無自覚ならよいわけではない"
    },
    "entry":
    [
        { "location": "454/SCENARIO", "narrator": "", "text": "470_無自覚ならよいわけではない"},
        { "location": "479/TALK"    , "narrator": "みやび", "text": "悪気はないんだという言葉"},
        { "location": "480/TALK"    , "narrator": "みやび", "text": "どう思うぞね"},
        { "location": "482/SEL"     , "narrator": "", "text": "そのまんま"},
        { "location": "483/SEL"     , "narrator": "", "text": "偽善だね"},
        { "location": "484/SEL"     , "narrator": "", "text": "それだけだとなあ"},
        { "location": "485/ACT"     , "narrator": "", "text": "そのまんま"},
        { "location": "486/TALK"    , "narrator": "みやび", "text": "まあ"},
        { "location": "488/TALK"    , "narrator": "みやび", "text": "そうかもな"},
        { "location": "489/ACT"     , "narrator": "", "text": "偽善だね"},
        { "location": "490/TALK"    , "narrator": "みやび", "text": "これはなかなか"},
        { "location": "491/TALK"    , "narrator": "みやび", "text": "手厳しい"},
        { "location": "492/ACT"     , "narrator": "", "text": "それだけだとなあ"},
        { "location": "502/TALK"    , "narrator": "みやび", "text": "ふむ"},
        { "location": "503/TALK"    , "narrator": "みやび", "text": "情報が少なすぎると"},
        { "location": "504/TALK"    , "narrator": "みやび", "text": "そういうことだな"},
        { "location": "507/TALK"    , "narrator": "みやび", "text": "なんというか"},
        { "location": "508/TALK"    , "narrator": "みやび", "text": "人を苛立たせておいて"},
        { "location": "509/TALK"    , "narrator": "みやび", "text": "そこを指摘すると"},
        { "location": "510/TALK"    , "narrator": "みやび", "text": "悪気はなかったと言い出す輩についてどう思う？"},
        { "location": "512/SEL"     , "narrator": "", "text": "そういう人もいるよね"},
        { "location": "513/SEL"     , "narrator": "", "text": "そんなことがあったの？"},
        { "location": "514/SEL"     , "narrator": "", "text": "$me$も気を付けなきゃ"},
        { "location": "515/ACT"     , "narrator": "", "text": "そういう人もいるよね"},
        { "location": "516/TALK"    , "narrator": "みやび", "text": "客観視か"},
        { "location": "517/TALK"    , "narrator": "みやび", "text": "そういう視点も必要かもな"},
        { "location": "518/ACT"     , "narrator": "", "text": "そんなことがあったの？"},
        { "location": "519/TALK"    , "narrator": "みやび", "text": "昔な"},
        { "location": "520/TALK"    , "narrator": "みやび", "text": "しかし今ではない"},
        { "location": "521/TALK"    , "narrator": "みやび", "text": "つまり"},
        { "location": "522/TALK"    , "narrator": "みやび", "text": "$handle$が気に病むことではないぞ"},
        { "location": "524/TALK"    , "narrator": "みやび", "text": "安心せい"},
        { "location": "525/ACT"     , "narrator": "", "text": "$me$も気を付けなきゃ"},
        { "location": "526/TALK"    , "narrator": "みやび", "text": "いや"},
        { "location": "527/TALK"    , "narrator": "みやび", "text": "あてこすりのつもりはない"},
        { "location": "528/TALK"    , "narrator": "みやび", "text": "$handle$には感謝しているし"},
        { "location": "529/TALK"    , "narrator": "みやび", "text": "こう見えても"},
        { "location": "531/TALK"    , "narrator": "みやび", "text": "まあ"},
        { "location": "532/TALK"    , "narrator": "みやび", "text": "昔のことを思い出して"},
        { "location": "533/TALK"    , "narrator": "みやび", "text": "少しこう"},
        { "location": "535/TALK"    , "narrator": "みやび", "text": "言いようのない気持ちに襲われてしまってな"},
        { "location": "537/SEL"     , "narrator": "", "text": "そうだったんだ"},
        { "location": "538/SEL"     , "narrator": "", "text": "そういうことあるよね"},
        { "location": "539/SEL"     , "narrator": "", "text": "もう大丈夫だよ"},
        { "location": "540/ACT"     , "narrator": "", "text": "そうだったんだ"},
        { "location": "541/TALK"    , "narrator": "みやび", "text": "うむ"},
        { "location": "542/ACT"     , "narrator": "", "text": "そういうことあるよね"},
        { "location": "543/TALK"    , "narrator": "みやび", "text": "やはりあるのか"},
        { "location": "544/ACT"     , "narrator": "", "text": "もう大丈夫だよ"},
        { "location": "545/TALK"    , "narrator": "みやび", "text": "なんだその包容力"},
        { "location": "547/TALK"    , "narrator": "みやび", "text": "こういう時は"},
        { "location": "548/TALK"    , "narrator": "みやび", "text": "タイムリープしたくなるな"},
        { "location": "550/SEL"     , "narrator": "", "text": "ええと？"},
        { "location": "551/SEL"     , "narrator": "", "text": "そんなこと考えたことないよ"},
        { "location": "552/ACT"     , "narrator": "", "text": "ええと？"},
        { "location": "553/TALK"    , "narrator": "みやび", "text": "おや"},
        { "location": "554/TALK"    , "narrator": "みやび", "text": "思わんのかね"},
        { "location": "555/ACT"     , "narrator": "", "text": "そんなこと考えたことないよ"},
        { "location": "556/TALK"    , "narrator": "みやび", "text": "まさか"},
        { "location": "558/TALK"    , "narrator": "みやび", "text": "そんなことが"},
        { "location": "560/TALK"    , "narrator": "みやび", "text": "人生を御破算で願いましては"},
        { "location": "561/TALK"    , "narrator": "みやび", "text": "しかも前回の記憶あり"},
        { "location": "562/TALK"    , "narrator": "みやび", "text": "チートぞね"},
        { "location": "563/TALK"    , "narrator": "みやび", "text": "楽勝人生ぞね"},
        { "location": "565/SEL"     , "narrator": "", "text": "そうかなあ"},
        { "location": "566/SEL"     , "narrator": "", "text": "今までがなくなったみやびはみやびなの？"},
        { "location": "567/ACT"     , "narrator": "", "text": "そうかなあ"},
        { "location": "568/TALK"    , "narrator": "みやび", "text": "違うか？"},
        { "location": "569/ACT"     , "narrator": "", "text": "今までがなくなったみやびはみやびなの？"},
        { "location": "570/TALK"    , "narrator": "みやび", "text": "それは"},
        { "location": "571/TALK"    , "narrator": "みやび", "text": "どうであろう"},
        { "location": "573/TALK"    , "narrator": "みやび", "text": "まあ"},
        { "location": "574/TALK"    , "narrator": "みやび", "text": "タイムリープうんぬんは"},
        { "location": "575/TALK"    , "narrator": "みやび", "text": "しょせんは言葉遊び"},
        { "location": "576/TALK"    , "narrator": "みやび", "text": "これまでの人生がご破算になるわけではない"},
        { "location": "578/TALK"    , "narrator": "みやび", "text": "そして悪気はないんだという言葉は"},
        { "location": "579/TALK"    , "narrator": "みやび", "text": "言葉遊びにしては悪意がある"},
        { "location": "581/SEL"     , "narrator": "", "text": "かもね"},
        { "location": "582/SEL"     , "narrator": "", "text": "気にすんな"},
        { "location": "583/ACT"     , "narrator": "", "text": "かもね"},
        { "location": "584/TALK"    , "narrator": "みやび", "text": "せやろ"},
        { "location": "585/ACT"     , "narrator": "", "text": "気にすんな"},
        { "location": "586/TALK"    , "narrator": "みやび", "text": "それが正しいとはわかっておるが"},
        { "location": "588/TALK"    , "narrator": "みやび", "text": "うちもたまには"},
        { "location": "589/TALK"    , "narrator": "みやび", "text": "メロウな気持ちになることもあるのだ"},
        { "location": "590/TALK"    , "narrator": "みやび", "text": "おつきあい痛み入る"},
        { "location": "595/TALK"    , "narrator": "ボイスメール", "text": "まあ、そうだろう"},
        { "location": "498/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>1000pt.</b></color></size>\nアップしました！"},
        { "location": "607/DIALOG"  , "narrator": "Dialog_GETVoice", "text": "<color=green>【みやび】</color>のボイスメール\n<color=red>【まあ、そうだろう】</color>\nをゲットしました！"}
    ]
}
