        { "location": "7/SCENARIO", "narrator": "", "text": "05-00_紅茶はいかが？"},
        { "location": "32/TALK"   , "narrator": "つばめ", "text": "紅茶にもいろいろ種類があるんだね(っ´ω`ｃ)"},
        { "location": "33/TALK"   , "narrator": "つばめ", "text": "飲みすぎたら"},
        { "location": "34/TALK"   , "narrator": "つばめ", "text": "眠れなくなっちゃった"},
        { "location": "36/SEL"    , "narrator": "", "text": "カフェインの過剰摂取だ"},
        { "location": "37/SEL"    , "narrator": "", "text": "夜更かしすれば"},
        { "location": "38/SEL"    , "narrator": "", "text": "$me$が添い寝してあげる"},
        { "location": "39/ACT"    , "narrator": "", "text": "カフェインの過剰摂取だ"},
        { "location": "40/TALK"   , "narrator": "つばめ", "text": "そっか"},
        { "location": "42/TALK"   , "narrator": "つばめ", "text": "そのせいで眠れないんだね"},
        { "location": "43/ACT"    , "narrator": "", "text": "夜更かしすれば"},
        { "location": "44/TALK"   , "narrator": "つばめ", "text": "そぅだね"},
        { "location": "45/TALK"   , "narrator": "つばめ", "text": "夜更かししちゃぉぅかな(ﾉ≧ڡ≦)"},
        { "location": "46/ACT"    , "narrator": "", "text": "$me$が添い寝してあげる"},
        { "location": "48/TALK"   , "narrator": "つばめ", "text": "添い寝とか"},
        { "location": "49/TALK"   , "narrator": "つばめ", "text": "もぅ"},
        { "location": "50/TALK"   , "narrator": "つばめ", "text": "そんな年じゃないし"},
        { "location": "52/TALK"   , "narrator": "つばめ", "text": "フレーバーティーっていうの"},
        { "location": "53/TALK"   , "narrator": "つばめ", "text": "結構好きかも"},
        { "location": "54/TALK"   , "narrator": "つばめ", "text": "いい匂いだし"},
        { "location": "56/SEL"    , "narrator": "", "text": "苦手かも"},
        { "location": "57/SEL"    , "narrator": "", "text": "今度試そうかな"},
        { "location": "58/SEL"    , "narrator": "", "text": "つばめが好きなやつ教えて"},
        { "location": "59/ACT"    , "narrator": "", "text": "苦手かも"},
        { "location": "60/TALK"   , "narrator": "つばめ", "text": "そっかー(･Д･｀)"},
        { "location": "61/ACT"    , "narrator": "", "text": "今度試そうかな"},
        { "location": "62/TALK"   , "narrator": "つばめ", "text": "ぅんヽ(*´∀｀)ノ"},
        { "location": "63/ACT"    , "narrator": "", "text": "つばめが好きなやつ教えて"},
        { "location": "66/TALK"   , "narrator": "つばめ", "text": "色々あるけど"},
