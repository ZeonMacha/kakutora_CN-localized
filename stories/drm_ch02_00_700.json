    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "思いの重い思い"},
        { "location": "20/TALK"   , "narrator": "アーヤ", "text": "……へえ。\nこういうのも\nあるのね。"},
        { "location": "21/TALK"   , "narrator": "アーヤ", "text": "今度試しに\n作ってみよう\nかしら。"},
        { "location": "23/TALK"   , "narrator": "みやび", "text": "アーヤは何を\n熱心に\n読んじゅう？"},
        { "location": "26/TALK"   , "narrator": "アーヤ", "text": "え。\nええと……。"},
        { "location": "27/TALK"   , "narrator": "ガブリエラ", "text": "なあに？\n「本当に願いが叶う\nミサンガの作り方」？"},
        { "location": "28/TALK"   , "narrator": "つばめ", "text": "ミサンガって\n何ですか？"},
        { "location": "31/TALK"   , "narrator": "ガブリエラ", "text": "ミサンガは\nミサンガよ。"},
        { "location": "33/TALK"   , "narrator": "みやび", "text": "組紐の一種ぞね。"},
        { "location": "34/TALK"   , "narrator": "みやび", "text": "そこに書いちゅう\n通り、切れると\n願いが叶うらしい。"},
        { "location": "36/TALK"   , "narrator": "つばめ", "text": "ふうん……。\n千羽鶴みたいな\nものですか？"},
        { "location": "38/TALK"   , "narrator": "ガブリエラ", "text": "ちょっと！\nそこまで重い\n願い事じゃないわよ！？"},
        { "location": "39/TALK"   , "narrator": "みやび", "text": "それは願いを込めた\n本人にしか\nわからんろう。"},
        { "location": "41/TALK"   , "narrator": "みやび", "text": "なあ？\nアーヤ。"},
        { "location": "43/TALK"   , "narrator": "アーヤ", "text": "えっ？\n私？"},
        { "location": "44/TALK"   , "narrator": "みやび", "text": "作るつもりで\n見てたんと\n違うんかね？"},
        { "location": "46/TALK"   , "narrator": "アーヤ", "text": "それはそう\nなんだけど…。"},
        { "location": "59/TALK"   , "narrator": "アーヤ", "text": "ねえ"},
        { "location": "60/TALK"   , "narrator": "アーヤ", "text": "願い事ってある？"},
        { "location": "62/SEL"    , "narrator": "", "text": "あるといえばある"},
        { "location": "63/SEL"    , "narrator": "", "text": "ないかなー"},
        { "location": "64/SEL"    , "narrator": "", "text": "言えばアーヤは叶えてくれる？"},
        { "location": "65/ACT"    , "narrator": "", "text": "あるといえばある"},
        { "location": "66/TALK"   , "narrator": "アーヤ", "text": "あるのね"},
        { "location": "67/TALK"   , "narrator": "アーヤ", "text": "教えて"},
        { "location": "69/SEL"    , "narrator": "", "text": "秘密"},
        { "location": "70/SEL"    , "narrator": "", "text": "わかってるくせに！"},
        { "location": "71/ACT"    , "narrator": "", "text": "秘密"},
        { "location": "72/TALK"   , "narrator": "アーヤ", "text": "そう"},
        { "location": "73/TALK"   , "narrator": "アーヤ", "text": "ならいいわよ(--*;"},
        { "location": "74/ACT"    , "narrator": "", "text": "わかってるくせに！"},
        { "location": "75/TALK"   , "narrator": "アーヤ", "text": "わからないわよ"},
        { "location": "76/TALK"   , "narrator": "アーヤ", "text": "もう＼(◎o◎)／"},
        { "location": "78/ACT"    , "narrator": "", "text": "ないかなー"},
        { "location": "79/TALK"   , "narrator": "アーヤ", "text": "ないのね"},
        { "location": "80/TALK"   , "narrator": "アーヤ", "text": "そっか"},
        { "location": "81/ACT"    , "narrator": "", "text": "言えばアーヤは叶えてくれる？"},
        { "location": "82/TALK"   , "narrator": "アーヤ", "text": "ものによるわ"},
        { "location": "83/TALK"   , "narrator": "アーヤ", "text": "叶えられるものならね(｡-_-｡)"},
        { "location": "98/TALK"   , "narrator": "アーヤ", "text": "ちょっと\nお世話になってる\n人がいて。"},
        { "location": "99/TALK"   , "narrator": "アーヤ", "text": "お礼もあんまり\nできてないから。"},
        { "location": "100/TALK"  , "narrator": "アーヤ", "text": "簡単だし作って\nあげようかなって\n思ったんだけど。"},
        { "location": "101/TALK"  , "narrator": "アーヤ", "text": "あんまり\n興味ないみたい。"},
        { "location": "103/TALK"  , "narrator": "つばめ", "text": "あ…。\nそうなんですね。"},
        { "location": "104/TALK"  , "narrator": "みやび", "text": "やっぱりアレよ。\n手作りは念が\nこもっちゅうき。"},
        { "location": "105/TALK"  , "narrator": "みやび", "text": "ちっくと\n重いんかも\nしれんねえ。"},
        { "location": "108/TALK"  , "narrator": "ガブリエラ", "text": "確かにね。"},
        { "location": "109/TALK"  , "narrator": "ガブリエラ", "text": "あれってヒモが\n切れるまで\n２、３ヶ月かかるわよね。"},
        { "location": "110/TALK"  , "narrator": "ガブリエラ", "text": "相当仲がよくないと\n付けてもらえない\nんじゃない。"},
        { "location": "112/TALK"  , "narrator": "ガブリエラ", "text": "でもあたしは\nもらってあげるわ。\n安心して。"},
        { "location": "113/TALK"  , "narrator": "つばめ", "text": "わたしは…\n手間かけてもらうの\n悪いですし。"},
        { "location": "114/TALK"  , "narrator": "つばめ", "text": "事前に聞かれたら\n遠慮すると\n思います。"},
        { "location": "115/TALK"  , "narrator": "アーヤ", "text": "サプライズ\nプレゼントなら\nありってこと？"},
        { "location": "116/TALK"  , "narrator": "みやび", "text": "えろうミサンガに\n執着するねえ。"},
        { "location": "118/TALK"  , "narrator": "アーヤ", "text": "そういうわけじゃ\nないんだけど…。"},
        { "location": "119/TALK"  , "narrator": "みやび", "text": "まあ、あれよね。"},
        { "location": "120/TALK"  , "narrator": "みやび", "text": "そういうアーヤを\n相手がかわいいって\n思っちゅうなら。"},
        { "location": "121/TALK"  , "narrator": "みやび", "text": "むしろアリなんと\n違うかねえ。"},
        { "location": "122/TALK"  , "narrator": "ガブリエラ", "text": "だからあたしなら\nもらって\nあげるってば。"},
        { "location": "124/TALK"  , "narrator": "アーヤ", "text": "簡単なものだったら\n大丈夫って\n思ってたけど。"},
        { "location": "126/TALK"  , "narrator": "アーヤ", "text": "どうも\nそういうわけじゃ\nないみたい…。"},
        { "location": "127/TALK"  , "narrator": "アーヤ", "text": "……うーん……。"},
        { "location": "19/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>某月某日　 0:16 PM</color>\nとある平日の昼休み、付属学園食堂でのこと"}
    ]
}
