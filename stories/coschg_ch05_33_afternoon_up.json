        { "location": "1128/TALK", "narrator": "プレイヤー", "text": "お着替えしてみよう"},
        { "location": "1130/TALK", "narrator": "プレイヤー", "text": "違う服を着てほしいな"},
        { "location": "1132/TALK", "narrator": "プレイヤー", "text": "よし、お着替えタイムだ！"},
        { "location": "1138/TALK", "narrator": "プレイヤー", "text": "やあ"},
        { "location": "1140/TALK", "narrator": "プレイヤー", "text": "こんにちは"},
        { "location": "1142/TALK", "narrator": "プレイヤー", "text": "げんき？"},
        { "location": "1145/TALK", "narrator": "神楽", "text": "ぴょんこを呼ぶ声"},
        { "location": "1146/TALK", "narrator": "神楽", "text": "あなたはだあれ？"},
        { "location": "1148/SEL" , "narrator": "", "text": "$handle$だよ"},
        { "location": "1149/ACT" , "narrator": "", "text": "$handle$だよ"},
        { "location": "1151/TALK", "narrator": "神楽", "text": "知ってるし"},
        { "location": "1152/TALK", "narrator": "神楽", "text": "ぴょんこに用事ぴょん？"},
        { "location": "1155/SEL" , "narrator": "", "text": "ちょっと着替えてほしいんだ"},
        { "location": "1156/ACT" , "narrator": "", "text": "ちょっと着替えてほしいんだ"},
        { "location": "1166/TALK", "narrator": "神楽", "text": "意味不明すぎ"},
        { "location": "1167/TALK", "narrator": "神楽", "text": "でもまあ"},
        { "location": "1168/TALK", "narrator": "神楽", "text": "優しいぴょんこは聞いてあげるのだった"},
        { "location": "1170/TALK", "narrator": "神楽", "text": "は？"},
        { "location": "1171/TALK", "narrator": "神楽", "text": "この服変だった？"},
        { "location": "1172/TALK", "narrator": "神楽", "text": "なら着替えるけど"},
        { "location": "1175/SEL" , "narrator": "", "text": "$me$が選ぶ"},
        { "location": "1176/SEL" , "narrator": "", "text": "やっぱやめる"},
        { "location": "1178/TALK", "narrator": "神楽", "text": "…………"},
        { "location": "1181/TALK", "narrator": "神楽", "text": "リクエストないとか？"},
        { "location": "1182/TALK", "narrator": "神楽", "text": "なら着ない"},
        { "location": "1184/ACT" , "narrator": "", "text": "$me$が選ぶ"},
        { "location": "1185/TALK", "narrator": "神楽", "text": "だと思った"},
        { "location": "1186/TALK", "narrator": "神楽", "text": "どれを着てほしいと？"},
        { "location": "1193/ACT" , "narrator": "", "text": "やっぱやめる"},
        { "location": "1194/TALK", "narrator": "神楽", "text": "ありえネー"}
    ]
}
