    [
        { "location": "7/SCENARIO", "narrator": "", "text": "父、さらに父"},
        { "location": "17/TALK"   , "narrator": "啓介", "text": "つばめの父だ"},
        { "location": "18/TALK"   , "narrator": "啓介", "text": "娘から聞いたことがあるかもしれない"},
        { "location": "19/TALK"   , "narrator": "啓介", "text": "言っておきたいことがある"},
        { "location": "21/SEL"    , "narrator": "", "text": "こんばんは"},
        { "location": "22/SEL"    , "narrator": "", "text": "ご無沙汰してます"},
        { "location": "23/SEL"    , "narrator": "", "text": "ぜひ聞かせてください"},
        { "location": "24/ACT"    , "narrator": "", "text": "こんばんは"},
        { "location": "26/TALK"   , "narrator": "啓介", "text": "おっと"},
        { "location": "27/TALK"   , "narrator": "啓介", "text": "こんばんは"},
        { "location": "28/ACT"    , "narrator": "", "text": "ご無沙汰してます"},
        { "location": "30/TALK"   , "narrator": "啓介", "text": "いや"},
        { "location": "31/TALK"   , "narrator": "啓介", "text": "そこまででもない"},
        { "location": "32/ACT"    , "narrator": "", "text": "ぜひ聞かせてください"},
        { "location": "43/TALK"   , "narrator": "啓介", "text": "うむ"},
        { "location": "44/TALK"   , "narrator": "啓介", "text": "いい返事だ"},
        { "location": "47/TALK"   , "narrator": "啓介", "text": "つばめは体が弱くてずっと入院していた"},
        { "location": "48/TALK"   , "narrator": "啓介", "text": "私もなかなか手が回らなくて"},
        { "location": "49/TALK"   , "narrator": "啓介", "text": "さみしい思いもさせてしまった"},
        { "location": "50/SEL"    , "narrator": "", "text": "はい"},
        { "location": "51/SEL"    , "narrator": "", "text": "ご苦労されたんですね"},
        { "location": "52/SEL"    , "narrator": "", "text": "娘さんはお父さんのことが好きですよ"},
        { "location": "53/ACT"    , "narrator": "", "text": "はい"},
        { "location": "54/TALK"   , "narrator": "啓介", "text": "知ってるな"},
        { "location": "55/ACT"    , "narrator": "", "text": "ご苦労されたんですね"},
        { "location": "56/TALK"   , "narrator": "啓介", "text": "苦労をしたのは"},
        { "location": "57/TALK"   , "narrator": "啓介", "text": "つばめの方だ"},
        { "location": "58/ACT"    , "narrator": "", "text": "娘さんはお父さんのことが好きですよ"},
        { "location": "69/TALK"   , "narrator": "啓介", "text": "そんなことは"},
        { "location": "70/TALK"   , "narrator": "啓介", "text": "知っている"},
        { "location": "72/TALK"   , "narrator": "啓介", "text": "君に改めて言われることではない"},
        { "location": "74/TALK"   , "narrator": "啓介", "text": "だからこれ以上の苦労をつばめにさせたくはない"},
        { "location": "75/TALK"   , "narrator": "啓介", "text": "そう思っていた"},
        { "location": "76/TALK"   , "narrator": "啓介", "text": "しかし君と話せなくなったつばめは落ち込んでしまった"},
        { "location": "77/TALK"   , "narrator": "啓介", "text": "だからだ"},
        { "location": "78/TALK"   , "narrator": "啓介", "text": "仕方ないが君と話すことを許す"},
        { "location": "79/TALK"   , "narrator": "啓介", "text": "仕方なくだ"},
        { "location": "80/SEL"    , "narrator": "", "text": "ありがとうございます"},
        { "location": "81/SEL"    , "narrator": "", "text": "$me$もつばめのことが大事です"},
        { "location": "82/SEL"    , "narrator": "", "text": "意外とツンデレなんですね"},
        { "location": "83/ACT"    , "narrator": "", "text": "ありがとうございます"},
        { "location": "84/TALK"   , "narrator": "啓介", "text": "うむ"},
        { "location": "85/ACT"    , "narrator": "", "text": "$me$もつばめのことが大事です"},
        { "location": "86/TALK"   , "narrator": "啓介", "text": "そうだろう"},
        { "location": "87/ACT"    , "narrator": "", "text": "意外とツンデレなんですね"},
        { "location": "90/TALK"   , "narrator": "啓介", "text": "大人をからかうな"},
