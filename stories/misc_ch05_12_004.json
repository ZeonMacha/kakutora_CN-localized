    "entry":
    [
        { "location": "3574/SCENARIO", "narrator": "", "text": "魔都はどこに消えた？"},
        { "location": "3599/TALK"    , "narrator": "神楽", "text": "たまの悪天候で"},
        { "location": "3600/TALK"    , "narrator": "神楽", "text": "魔都トーキョーシティみたいな状態になることがあるじゃないですか"},
        { "location": "3601/TALK"    , "narrator": "神楽", "text": "ぴょんこはあの状態がたまらなく好きなんだぴょん"},
        { "location": "3603/SEL"     , "narrator": "", "text": "フェノメノン発生時の方がそんな感じじゃないの？"},
        { "location": "3604/SEL"     , "narrator": "", "text": "厨二ゴコロがくすぐられるよね"},
        { "location": "3605/SEL"     , "narrator": "", "text": "交通機関とか麻痺したりするし…"},
        { "location": "3606/ACT"     , "narrator": "", "text": "フェノメノン発生時の方がそんな感じじゃないの？"},
        { "location": "3607/TALK"    , "narrator": "神楽", "text": "それはぴょんこが沈静化しないといけないからただのオシゴト"},
        { "location": "3608/TALK"    , "narrator": "神楽", "text": "そういうのはむしろ苦痛"},
        { "location": "3609/ACT"     , "narrator": "", "text": "厨二ゴコロがくすぐられるよね"},
        { "location": "3611/TALK"    , "narrator": "神楽", "text": "ね！！！！"},
        { "location": "3613/TALK"    , "narrator": "神楽", "text": "たまらんよあれは！！！"},
        { "location": "3614/TALK"    , "narrator": "神楽", "text": "…ついに来たか……"},
        { "location": "3615/TALK"    , "narrator": "神楽", "text": "異次元の悪にこの帝都は渡さん！！！"},
        { "location": "3616/TALK"    , "narrator": "神楽", "text": "マントバサー！！！"},
        { "location": "3617/TALK"    , "narrator": "神楽", "text": "サムライソードきらーん！！！"},
        { "location": "3618/ACT"     , "narrator": "", "text": "交通機関とか麻痺したりするし…"},
        { "location": "3619/TALK"    , "narrator": "神楽", "text": "お"},
        { "location": "3620/TALK"    , "narrator": "神楽", "text": "いつもご苦労様です！"},
        { "location": "3622/TALK"    , "narrator": "神楽", "text": "魔都トーキョーシティはマサカドに護られているんだぴょん"},
        { "location": "3624/SEL"     , "narrator": "", "text": "将門塚か…"},
        { "location": "3625/SEL"     , "narrator": "", "text": "加護してるのは東照大権現だよ"},
        { "location": "3626/SEL"     , "narrator": "", "text": "神楽が護ってるんじゃ！？"},
        { "location": "3627/ACT"     , "narrator": "", "text": "将門塚か…"},
        { "location": "3628/TALK"    , "narrator": "神楽", "text": "それそれ"},
        { "location": "3629/ACT"     , "narrator": "", "text": "加護してるのは東照大権現だよ"},
        { "location": "3630/TALK"    , "narrator": "神楽", "text": "なんと、、、"},
        { "location": "3631/TALK"    , "narrator": "神楽", "text": "あのタヌキが！？"},
        { "location": "3632/ACT"     , "narrator": "", "text": "神楽が護ってるんじゃ！？"},
        { "location": "3634/TALK"    , "narrator": "神楽", "text": "あっバレてた？"},
        { "location": "3636/TALK"    , "narrator": "神楽", "text": "でもこれは$handlek$とぴょんこだけの秘密だからね！"},
        { "location": "3637/TALK"    , "narrator": "神楽", "text": "もしばらしたら、、、（暗黒微笑）"},
        { "location": "3639/TALK"    , "narrator": "神楽", "text": "だけどそのおかげで"},
        { "location": "3640/TALK"    , "narrator": "神楽", "text": "平凡な日常を続けることができるんだぴょん♪"},
        { "location": "3641/TALK"    , "narrator": "神楽", "text": "帝都を守るのも楽じゃないよね！"}
    ]
}
