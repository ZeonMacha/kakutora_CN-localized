{
    "dir": "chap08/daydra/dd_ch01_08_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "8155",
        "cid": "tsubame",
        "title": "Extra005 プレミアムストーリー",
        "sub_title": "お疲れ真幌"
    },
    "entry":
    [
        { "location": "276/SCENARIO", "narrator": "", "text": "お疲れ真幌"},
        { "location": "291/TALK"    , "narrator": "真幌", "text": "ふぅ…。"},
        { "location": "294/TALK"    , "narrator": "つばめ", "text": "真幌さん？"},
        { "location": "296/TALK"    , "narrator": "真幌", "text": "ん？　ああ、逢瀬か…。"},
        { "location": "297/TALK"    , "narrator": "つばめ", "text": "大丈夫ですか？\nなんだか、凄く疲れた\n顔してますけど…。"},
        { "location": "298/TALK"    , "narrator": "真幌", "text": "ああ…少々やらなければ\nならないことが溜まって\nいてな。"},
        { "location": "299/TALK"    , "narrator": "真幌", "text": "特別攻撃隊の仕事以外に、\n学校と劇場の運営――"},
        { "location": "301/TALK"    , "narrator": "真幌", "text": "やってできないことは\nないが…たまには疲れる\nこともあるさ。"},
        { "location": "302/TALK"    , "narrator": "つばめ", "text": "…あ、ああっ！"},
        { "location": "303/TALK"    , "narrator": "つばめ", "text": "そうですよね。\n真幌さんって、\n色んなお仕事してました！"},
        { "location": "305/TALK"    , "narrator": "真幌", "text": "人員不足でな。\n私がやるしかないん\nだよ。"},
        { "location": "306/TALK"    , "narrator": "つばめ", "text": "でも、それを聞いて\n納得しました。"},
        { "location": "308/TALK"    , "narrator": "つばめ", "text": "真幌さんがいつも寝てる\nのって、疲れてるから\nだったんですね。"},
        { "location": "309/TALK"    , "narrator": "真幌", "text": "おい、まさか自堕落な\n女だと思っていたのか？"},
        { "location": "310/TALK"    , "narrator": "つばめ", "text": "ち、違います！\n寝るのが好きなのかな、\nって思ってたんです。"},
        { "location": "311/TALK"    , "narrator": "真幌", "text": "似たようなもんだ。\nまったく、おまえという\n奴は…。"},
        { "location": "312/TALK"    , "narrator": "真幌", "text": "まあ、確かに昼寝は\n趣味と言っても過言では\nないのだが…。"},
        { "location": "313/TALK"    , "narrator": "つばめ", "text": "…変わった趣味だなぁ。"},
        { "location": "314/TALK"    , "narrator": "つばめ", "text": "毎日お疲れ様です。"},
        { "location": "315/TALK"    , "narrator": "真幌", "text": "ああ…それはそうと――"},
        { "location": "316/TALK"    , "narrator": "真幌", "text": "このことは、みんなには\n秘密にしておいてもらえ\nないか？"},
        { "location": "317/TALK"    , "narrator": "つばめ", "text": "えっと…真幌さんが\n疲れている、って\nことですか？"},
        { "location": "318/TALK"    , "narrator": "真幌", "text": "ああ…おまえ達には、\n弱った姿を見せないよう\n心掛けているんでな。"},
        { "location": "319/TALK"    , "narrator": "真幌", "text": "だから、逢瀬も今見た\n私のことは忘れてほしい。"},
        { "location": "320/TALK"    , "narrator": "つばめ", "text": "そんな、気にするような\nことじゃないのに…。"},
        { "location": "321/TALK"    , "narrator": "真幌", "text": "教師、雇い主、そして\n隊長としておまえ達の上に\n立つ大人としての――"},
        { "location": "322/TALK"    , "narrator": "真幌", "text": "最低限のプライドだ。\nつまらなく思えるかも\nしれんがな。"},
        { "location": "323/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "324/TALK"    , "narrator": "真幌", "text": "さてと、もう一仕事すると\nするか…。"},
        { "location": "326/TALK"    , "narrator": "つばめ", "text": "…真幌さん、凄いなぁ。"},
        { "location": "327/TALK"    , "narrator": "つばめ", "text": "凄く疲れてるのに、\n凄く無理して頑張って…。"},
        { "location": "329/TALK"    , "narrator": "つばめ", "text": "…ちょっとだけでも、\n何かしてあげたいな。"},
        { "location": "331/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "345/TALK"    , "narrator": "つばめ", "text": "真幌さんの肩を揉んであげようかな、って思うの"},
        { "location": "347/TALK"    , "narrator": "つばめ", "text": "でも、真幌さんはわたし達に、あまり弱ったところ見せたくないんだって"},
        { "location": "348/TALK"    , "narrator": "つばめ", "text": "それなのに肩揉みとかしても、喜ばれないかな？"},
        { "location": "350/SEL"     , "narrator": "", "text": "そんなことない、喜ぶよ"},
        { "location": "351/SEL"     , "narrator": "", "text": "真幌も年だし、絶対喜ぶよ"},
        { "location": "352/SEL"     , "narrator": "", "text": "多分、喜ばないと思う"},
        { "location": "353/ACT"     , "narrator": "", "text": "そんなことない、喜ぶよ"},
        { "location": "355/TALK"    , "narrator": "つばめ", "text": "わかった"},
        { "location": "356/TALK"    , "narrator": "つばめ", "text": "ありがと、背中押してくれて"},
        { "location": "386/TALK"    , "narrator": "つばめ", "text": "あの、真幌さん。"},
        { "location": "388/TALK"    , "narrator": "真幌", "text": "ん？　なんだ？"},
        { "location": "389/TALK"    , "narrator": "つばめ", "text": "真幌さん、弱ってる姿は\n見せられない、って\n言いましたよね？"},
        { "location": "390/TALK"    , "narrator": "つばめ", "text": "だから、少しでも\n疲れが取れるように、\n肩揉みさせてください。"},
        { "location": "391/TALK"    , "narrator": "真幌", "text": "…気持ちは嬉しいが、\nおまえも忘れろと\n言ったはずだが？"},
        { "location": "392/TALK"    , "narrator": "つばめ", "text": "じゃあ、終わったら\n忘れます。"},
        { "location": "394/TALK"    , "narrator": "真幌", "text": "ははっ、言うように\nなったじゃないか。"},
        { "location": "395/TALK"    , "narrator": "真幌", "text": "…嬉しいよ、逢瀬。\nそれじゃあお願い\nするとしよう。"},
        { "location": "396/TALK"    , "narrator": "つばめ", "text": "任せてください。"},
        { "location": "397/TALK"    , "narrator": "つばめ", "text": "肩揉みはお父さんで\n慣れてるんです！"},
        { "location": "398/TALK"    , "narrator": "真幌", "text": "…………。"},
        { "location": "399/TALK"    , "narrator": "真幌", "text": "もし…。"},
        { "location": "400/TALK"    , "narrator": "つばめ", "text": "はい？"},
        { "location": "401/TALK"    , "narrator": "真幌", "text": "もし、私に将来、\n娘が出来るようなことが\nあれば――"},
        { "location": "402/TALK"    , "narrator": "真幌", "text": "逢瀬のような優しい娘\nだと嬉しいんだがな…。"},
        { "location": "403/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "404/TALK"    , "narrator": "真幌", "text": "いや、なんでもない。\nただの妄想だ。\n忘れてくれ。"},
        { "location": "406/TALK"    , "narrator": "つばめ", "text": "えへへ…嬉しいから、\nそれは無理ですよー。"},
        { "location": "407/ACT"     , "narrator": "", "text": "真幌も年だし、絶対喜ぶ"},
        { "location": "408/TALK"    , "narrator": "つばめ", "text": "…そうだよね"},
        { "location": "409/TALK"    , "narrator": "つばめ", "text": "うん、決めたよ！"},
        { "location": "441/TALK"    , "narrator": "つばめ", "text": "あの、真幌さん。"},
        { "location": "443/TALK"    , "narrator": "真幌", "text": "ん？　なんだ？"},
        { "location": "444/TALK"    , "narrator": "つばめ", "text": "真幌さん、弱ってる姿は\n見せられない、って\n言いましたよね？"},
        { "location": "445/TALK"    , "narrator": "つばめ", "text": "だから、少しでも\n疲れが取れるように、\n肩揉みさせてください。"},
        { "location": "446/TALK"    , "narrator": "真幌", "text": "…気持ちは嬉しいが、\nおまえも忘れろと\n言ったはずだが？"},
        { "location": "448/TALK"    , "narrator": "つばめ", "text": "じゃあ、終わったら\n忘れます。"},
        { "location": "450/TALK"    , "narrator": "真幌", "text": "ははっ、言うように\nなったじゃないか。"},
        { "location": "451/TALK"    , "narrator": "つばめ", "text": "それに、真幌さんも\n年なんだから――"},
        { "location": "452/TALK"    , "narrator": "つばめ", "text": "あまり無理し過ぎちゃ\nダメですよ。"},
        { "location": "455/TALK"    , "narrator": "真幌", "text": "…………。"},
        { "location": "457/TALK"    , "narrator": "つばめ", "text": "…真幌さん？"},
        { "location": "459/TALK"    , "narrator": "真幌", "text": "なあ、逢瀬。\n一つ聞きたいんだが――"},
        { "location": "461/TALK"    , "narrator": "真幌", "text": "おまえ、私の年齢を\nいくつだと思っている？"},
        { "location": "462/TALK"    , "narrator": "つばめ", "text": "えっ！？"},
        { "location": "463/TALK"    , "narrator": "つばめ", "text": "そ、そういえば、\n真幌さんって\n何歳なんだろ？"},
        { "location": "464/TALK"    , "narrator": "つばめ", "text": "年だし、って言われて、\n勝手にもういい年だと\n思っちゃってたけど――"},
        { "location": "465/TALK"    , "narrator": "つばめ", "text": "二十代後半…いってたと\nしても三十代前半？"},
        { "location": "467/TALK"    , "narrator": "真幌", "text": "どうした、逢瀬？\n私はそんなに難しい\n質問をしたか？"},
        { "location": "468/TALK"    , "narrator": "つばめ", "text": "え、えーっとぉ…。"},
        { "location": "470/TALK"    , "narrator": "つばめ", "text": "そ、そうだ！"},
        { "location": "472/TALK"    , "narrator": "つばめ", "text": "一緒に、背中の\nマッサージも\nどうですか？"},
        { "location": "473/TALK"    , "narrator": "真幌", "text": "それはありがたい。\n頼むとしよう。"},
        { "location": "474/TALK"    , "narrator": "つばめ", "text": "はい、\n任せてください！"},
        { "location": "476/TALK"    , "narrator": "真幌", "text": "ああ。"},
        { "location": "480/TALK"    , "narrator": "真幌", "text": "…それで？\n私をいくつだと\n思っているんだ？"},
        { "location": "482/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "483/TALK"    , "narrator": "真幌", "text": "言っておくが、\n質問に答えるまで\n逃がさんぞ？"},
        { "location": "485/TALK"    , "narrator": "つばめ", "text": "…弱って見えたの、\n勘違いだったのかな？"},
        { "location": "486/ACT"     , "narrator": "", "text": "多分、喜ばないと思う"},
        { "location": "487/TALK"    , "narrator": "つばめ", "text": "やっぱり、やめた方が良いかな？"},
        { "location": "488/TALK"    , "narrator": "つばめ", "text": "弱った姿を見せたくない、って言ってるんだし…"},
        { "location": "500/TALK"    , "narrator": "つばめ", "text": "…じゃあ、そろそろ仕事に\n戻りますね。"},
        { "location": "502/TALK"    , "narrator": "真幌", "text": "ああ、引き続き頼んだぞ。"},
        { "location": "503/TALK"    , "narrator": "つばめ", "text": "はい！"},
        { "location": "506/TALK"    , "narrator": "つばめ", "text": "真幌さんを見習って、\nわたしはわたしの仕事を\n頑張ろう！"},
        { "location": "284/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>5月15日　5:11 PM</color>\n転校して1週間後、神楽坂トライナリーのバイト中にて。"}
    ]
}
