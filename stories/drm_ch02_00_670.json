        { "location": "239/TALK"    , "narrator": "アーヤ", "text": "そうよね"},
        { "location": "240/ACT"     , "narrator": "", "text": "いつもごめんね"},
        { "location": "241/TALK"    , "narrator": "アーヤ", "text": "ううん"},
        { "location": "242/TALK"    , "narrator": "アーヤ", "text": "謝ることじゃないわ"},
