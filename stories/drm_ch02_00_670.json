        { "location": "202/TALK"    , "narrator": "アーヤ", "text": "ちょっと話したかったのにな"},
        { "location": "203/TALK"    , "narrator": "アーヤ", "text": "残念だわ"},
        { "location": "204/TALK"    , "narrator": "アーヤ", "text": "仕方ないけど"},
        { "location": "206/SEL"     , "narrator": "", "text": "なんか怖い"},
        { "location": "207/SEL"     , "narrator": "", "text": "独り言多いよ"},
        { "location": "208/SEL"     , "narrator": "", "text": "遅くなってごめん"},
        { "location": "209/ACT"     , "narrator": "", "text": "なんか怖い"},
        { "location": "210/TALK"    , "narrator": "アーヤ", "text": "え"},
        { "location": "211/TALK"    , "narrator": "アーヤ", "text": "ひどい"},
        { "location": "212/TALK"    , "narrator": "アーヤ", "text": "もういいわよ"},
        { "location": "213/ACT"     , "narrator": "", "text": "独り言多いよ"},
        { "location": "214/TALK"    , "narrator": "アーヤ", "text": "あれ"},
        { "location": "215/TALK"    , "narrator": "アーヤ", "text": "そうかしら"},
        { "location": "216/TALK"    , "narrator": "アーヤ", "text": "そのつもりはなかったんだけど"},
        { "location": "217/ACT"     , "narrator": "", "text": "遅くなってごめん"},
        { "location": "227/TALK"    , "narrator": "アーヤ", "text": "ううん"},
        { "location": "229/TALK"    , "narrator": "アーヤ", "text": "いいんだけど"},
        { "location": "230/TALK"    , "narrator": "アーヤ", "text": "来てくれたの"},
        { "location": "231/TALK"    , "narrator": "アーヤ", "text": "うれしいし"},
        { "location": "233/SEL"     , "narrator": "", "text": "いつも待たなくていいよ"},
        { "location": "234/SEL"     , "narrator": "", "text": "いつもごめんね"},
        { "location": "235/ACT"     , "narrator": "", "text": "いつも待たなくていいよ"},
        { "location": "236/TALK"    , "narrator": "アーヤ", "text": "あ"},
