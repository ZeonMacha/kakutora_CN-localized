{
    "dir": "chap33/daydra/dd_ch04_33_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "33402",
        "cid": "miyabi",
        "title": "002 メインストーリー",
        "sub_title": "パラレルパラレル＜前編＞"
    },
    "entry":
    [
        { "location": "8/SCENARIO", "narrator": "", "text": "世界線と可能性"},
        { "location": "26/TALK"   , "narrator": "みやび", "text": "…うう、緊張する。"},
        { "location": "27/TALK"   , "narrator": "みやび", "text": "けんど、そんな理由で\n失敗はさせられんき\nねえ…！"},
        { "location": "28/TALK"   , "narrator": "みやび", "text": "５、４、３、２、１。"},
        { "location": "36/TALK"   , "narrator": "みやび", "text": "アーケロンが爆発\nするのは敵にすれば\n想定外やき。"},
        { "location": "37/TALK"   , "narrator": "みやび", "text": "そこへこのタイミングで\n脱出ポッドが射出されたら\n罠やとは思わん。"},
        { "location": "38/TALK"   , "narrator": "みやび", "text": "はずやけんど\n上手く引っかかって\nくれるろうか…？"},
        { "location": "39/TALK"   , "narrator": "みやび", "text": "通常攻撃隊は\n全員脱出ポッドへ\n向こうたね。"},
        { "location": "40/TALK"   , "narrator": "みやび", "text": "はー……。"},
        { "location": "41/TALK"   , "narrator": "みやび", "text": "…第一段階は\n成功ぞね……。"},
        { "location": "42/TALK"   , "narrator": "みやび", "text": "しかし……。"},
        { "location": "43/TALK"   , "narrator": "みやび", "text": "つばめと千羽鶴と\n卯月が一同に会して\nおったんはええが。"},
        { "location": "44/TALK"   , "narrator": "みやび", "text": "あれではよう手が\n出せんちや……。\nどうしたもんか…。"},
        { "location": "45/TALK"   , "narrator": "透明アーヤ", "text": "みやび。\n館長から連絡があったわ。"},
        { "location": "47/TALK"   , "narrator": "みやび", "text": "まほさんから？"},
        { "location": "48/TALK"   , "narrator": "透明アーヤ", "text": "ええ。館長が陽動を\nしている間につばめを\n救出するようにと。"},
        { "location": "49/TALK"   , "narrator": "みやび", "text": "すぐにかね？"},
        { "location": "50/TALK"   , "narrator": "透明アーヤ", "text": "まだよ。館長側の\n準備完了次第また\n連絡する。"},
        { "location": "51/TALK"   , "narrator": "みやび", "text": "あいあい。"},
        { "location": "52/TALK"   , "narrator": "透明アーヤ", "text": "そうだ。今回の陽動は\n光月さんたちが準備を\nしてたそうよ。"},
        { "location": "54/TALK"   , "narrator": "みやび", "text": "ウサギが…！"},
        { "location": "55/TALK"   , "narrator": "みやび", "text": "さすが、やるねえ。"},
        { "location": "56/TALK"   , "narrator": "透明アーヤ", "text": "あなたたちそんなに\n仲よかったっけ？"},
        { "location": "57/TALK"   , "narrator": "みやび", "text": "…先輩後輩の仲やき。\nそれなりに親しゅうは\nしとるよ。"},
        { "location": "58/TALK"   , "narrator": "透明アーヤ", "text": "そう。\nじゃあまた後で。"},
        { "location": "59/TALK"   , "narrator": "みやび", "text": "別に不自然では\nなかったはずや\nけんど。"},
        { "location": "61/TALK"   , "narrator": "みやび", "text": "アーヤは時々\n勘が鋭いき。\n注意せんとね。"},
        { "location": "62/TALK"   , "narrator": "みやび", "text": "ほいたら\n準備できるまで\n待機やね…。"},
        { "location": "75/TALK"   , "narrator": "みやび", "text": "聞け相棒"},
        { "location": "76/TALK"   , "narrator": "みやび", "text": "本来うちの真面目モードは"},
        { "location": "77/TALK"   , "narrator": "みやび", "text": "三分間しか保たないと定義されておる"},
        { "location": "78/TALK"   , "narrator": "みやび", "text": "しかし今回非常事態につき"},
        { "location": "79/TALK"   , "narrator": "みやび", "text": "もう三時間を経過しようとしておる"},
        { "location": "80/TALK"   , "narrator": "みやび", "text": "この理由をでっち上げよ"},
        { "location": "82/SEL"    , "narrator": "", "text": "実はだらけモードだった"},
        { "location": "83/SEL"    , "narrator": "", "text": "世界がバグってるから"},
        { "location": "84/SEL"    , "narrator": "", "text": "$me$のまじめさが感染した"},
        { "location": "85/ACT"    , "narrator": "", "text": "実はだらけモードだった"},
        { "location": "86/TALK"   , "narrator": "みやび", "text": "なるほど"},
        { "location": "87/TALK"   , "narrator": "みやび", "text": "そうかもしれん"},
        { "location": "88/TALK"   , "narrator": "みやび", "text": "でなければ"},
        { "location": "89/TALK"   , "narrator": "みやび", "text": "$handle$と話などしておらぬ"},
        { "location": "90/ACT"    , "narrator": "", "text": "世界がバグってるから"},
        { "location": "91/TALK"   , "narrator": "みやび", "text": "ははん"},
        { "location": "92/TALK"   , "narrator": "みやび", "text": "うちからすれば"},
        { "location": "93/TALK"   , "narrator": "みやび", "text": "その指摘や正"},
        { "location": "95/TALK"   , "narrator": "みやび", "text": "気に入った"},
        { "location": "96/ACT"    , "narrator": "", "text": "$me$のまじめさが感染した"},
        { "location": "97/TALK"   , "narrator": "みやび", "text": "なんと"},
        { "location": "98/TALK"   , "narrator": "みやび", "text": "これはまたひどいバグ"},
        { "location": "99/TALK"   , "narrator": "みやび", "text": "今すぐチェンジだ"},
        { "location": "100/TALK"  , "narrator": "みやび", "text": "リブートだ"},
        { "location": "102/TALK"  , "narrator": "みやび", "text": "あーもー緊張するー"},
        { "location": "103/TALK"  , "narrator": "みやび", "text": "真面目モードすぎて"},
        { "location": "104/TALK"  , "narrator": "みやび", "text": "緊張するー"},
        { "location": "106/SEL"   , "narrator": "", "text": "そんなみやびも素敵"},
        { "location": "107/SEL"   , "narrator": "", "text": "みやびに惚れ直してる"},
        { "location": "108/SEL"   , "narrator": "", "text": "今のみやびは輝いてる"},
        { "location": "109/ACT"   , "narrator": "", "text": "そんなみやびも素敵"},
        { "location": "110/TALK"  , "narrator": "みやび", "text": "何を言う"},
        { "location": "111/TALK"  , "narrator": "みやび", "text": "うちはいつでも"},
        { "location": "112/TALK"  , "narrator": "みやび", "text": "素敵ぞね"},
        { "location": "113/TALK"  , "narrator": "みやび", "text": "みやび本音の俳句"},
        { "location": "114/ACT"   , "narrator": "", "text": "みやびに惚れ直してる"},
        { "location": "115/TALK"  , "narrator": "みやび", "text": "なるほど"},
        { "location": "116/TALK"  , "narrator": "みやび", "text": "相棒の愛"},
        { "location": "117/TALK"  , "narrator": "みやび", "text": "あふれんばかりに"},
        { "location": "118/TALK"  , "narrator": "みやび", "text": "感じており我"},
        { "location": "119/ACT"   , "narrator": "", "text": "今のみやびは輝いてる"},
        { "location": "120/TALK"  , "narrator": "みやび", "text": "そう褒めんでも"},
        { "location": "121/TALK"  , "narrator": "みやび", "text": "うちはいつでも輝いて"},
        { "location": "122/TALK"  , "narrator": "みやび", "text": "そして宇宙へ"},
        { "location": "123/TALK"  , "narrator": "みやび", "text": "行くわけはない"},
        { "location": "125/TALK"  , "narrator": "みやび", "text": "時に$handle$"},
        { "location": "126/TALK"  , "narrator": "みやび", "text": "これは吊り橋効果を狙っての"},
        { "location": "127/TALK"  , "narrator": "みやび", "text": "展開か"},
        { "location": "129/SEL"   , "narrator": "", "text": "ばれた？"},
        { "location": "130/SEL"   , "narrator": "", "text": "まあ…そうかな…"},
        { "location": "131/SEL"   , "narrator": "", "text": "そんなことしなくても相思相愛"},
        { "location": "132/ACT"   , "narrator": "", "text": "ばれた？"},
        { "location": "133/TALK"  , "narrator": "みやび", "text": "いい度胸だ"},
        { "location": "134/ACT"   , "narrator": "", "text": "まあ…そうかな…"},
        { "location": "135/TALK"  , "narrator": "みやび", "text": "もにょもにょするな"},
        { "location": "136/TALK"  , "narrator": "みやび", "text": "堂々としろ"},
        { "location": "137/ACT"   , "narrator": "", "text": "そんなことしなくても相思相愛"},
        { "location": "138/TALK"  , "narrator": "みやび", "text": "なるほど"},
        { "location": "139/TALK"  , "narrator": "みやび", "text": "興味深い回答"},
        { "location": "141/TALK"  , "narrator": "みやび", "text": "あいわかった"},
        { "location": "142/TALK"  , "narrator": "みやび", "text": "うちはその実験の"},
        { "location": "143/TALK"  , "narrator": "みやび", "text": "被検体になることを決めた"},
        { "location": "145/SEL"   , "narrator": "", "text": "まじで"},
        { "location": "146/SEL"   , "narrator": "", "text": "やったね"},
        { "location": "147/SEL"   , "narrator": "", "text": "もう両想いなのに…"},
        { "location": "148/ACT"   , "narrator": "", "text": "まじで"},
        { "location": "149/TALK"  , "narrator": "みやび", "text": "まじで"},
        { "location": "150/TALK"  , "narrator": "みやび", "text": "みやびさんに二言はない"},
        { "location": "151/TALK"  , "narrator": "みやび", "text": "たぶん"},
        { "location": "152/ACT"   , "narrator": "", "text": "やったね"},
        { "location": "153/TALK"  , "narrator": "みやび", "text": "うちとしても"},
        { "location": "154/TALK"  , "narrator": "みやび", "text": "ずっと気になってはおった"},
        { "location": "155/ACT"   , "narrator": "", "text": "もう両想いなのに…"},
        { "location": "156/TALK"  , "narrator": "みやび", "text": "それは"},
        { "location": "157/TALK"  , "narrator": "みやび", "text": "$handle$だけが"},
        { "location": "158/TALK"  , "narrator": "みやび", "text": "そう認識しとるだけやき"},
        { "location": "160/TALK"  , "narrator": "みやび", "text": "というわけで"},
        { "location": "161/TALK"  , "narrator": "みやび", "text": "この作戦完了後"},
        { "location": "162/TALK"  , "narrator": "みやび", "text": "吊り橋実験についての精査を行う"},
        { "location": "163/TALK"  , "narrator": "みやび", "text": "心しておけ"},
        { "location": "164/TALK"  , "narrator": "みやび", "text": "主にうち"},
        { "location": "175/TALK"  , "narrator": "みやび", "text": "まほさんはまだ\n準備できんろうか。"},
        { "location": "176/TALK"  , "narrator": "みやび", "text": "うーん…。"},
        { "location": "177/TALK"  , "narrator": "みやび", "text": "やったら今のうちに\n言うておこうかね。"},
        { "location": "189/TALK"  , "narrator": "みやび", "text": "今回の事件で"},
        { "location": "190/TALK"  , "narrator": "みやび", "text": "学んだことがある"},
        { "location": "191/TALK"  , "narrator": "みやび", "text": "今まで常識だと信じていたものが、いとも簡単に崩れ落ちるという瞬間があること"},
        { "location": "192/TALK"  , "narrator": "みやび", "text": "現実は真実を告げているわけではないということ"},
        { "location": "193/TALK"  , "narrator": "みやび", "text": "世界は安定しているようで実は何だって起こりえるほど不安定だということ"},
        { "location": "195/TALK"  , "narrator": "みやび", "text": "$handle$の世界もそうかもしれん"},
        { "location": "196/TALK"  , "narrator": "みやび", "text": "気を付けろ"},
        { "location": "197/TALK"  , "narrator": "みやび", "text": "そして落ち着いて行動しろ"},
        { "location": "199/SEL"   , "narrator": "", "text": "たぶん大丈夫"},
        { "location": "200/SEL"   , "narrator": "", "text": "不安になるな…"},
        { "location": "201/SEL"   , "narrator": "", "text": "心配しなくても平気だよ"},
        { "location": "202/ACT"   , "narrator": "", "text": "たぶん大丈夫"},
        { "location": "203/TALK"  , "narrator": "みやび", "text": "たぶん"},
        { "location": "204/TALK"  , "narrator": "みやび", "text": "か"},
        { "location": "205/ACT"   , "narrator": "", "text": "不安になるな…"},
        { "location": "206/TALK"  , "narrator": "みやび", "text": "それは"},
        { "location": "207/TALK"  , "narrator": "みやび", "text": "当然の反応"},
        { "location": "208/ACT"   , "narrator": "", "text": "心配しなくても平気だよ"},
        { "location": "209/TALK"  , "narrator": "みやび", "text": "そうだろうか"},
        { "location": "211/TALK"  , "narrator": "みやび", "text": "実のところ"},
        { "location": "212/TALK"  , "narrator": "みやび", "text": "うちはずっと"},
        { "location": "213/TALK"  , "narrator": "みやび", "text": "密かに疑問を抱いていたことがある"},
        { "location": "214/TALK"  , "narrator": "みやび", "text": "なごちゃんは"},
        { "location": "215/TALK"  , "narrator": "みやび", "text": "うちの妹は"},
        { "location": "216/TALK"  , "narrator": "みやび", "text": "本当に死亡したのかと"},
        { "location": "217/TALK"  , "narrator": "みやび", "text": "この世を去ったのかと"},
        { "location": "218/TALK"  , "narrator": "みやび", "text": "なぜなら"},
        { "location": "219/TALK"  , "narrator": "みやび", "text": "うちはなごちゃんの死の瞬間を見ていない"},
        { "location": "220/TALK"  , "narrator": "みやび", "text": "そして"},
        { "location": "221/TALK"  , "narrator": "みやび", "text": "見ていないで言うなら"},
        { "location": "222/TALK"  , "narrator": "みやび", "text": "$handle$のことを"},
        { "location": "223/TALK"  , "narrator": "みやび", "text": "うちはこの目で見ていない"},
        { "location": "224/TALK"  , "narrator": "みやび", "text": "$handle$は世界に"},
        { "location": "225/TALK"  , "narrator": "みやび", "text": "存在するのか？"},
        { "location": "227/SEL"   , "narrator": "", "text": "そこなんだ！？"},
        { "location": "228/SEL"   , "narrator": "", "text": "するから！"},
        { "location": "229/SEL"   , "narrator": "", "text": "怖い話はやめて"},
        { "location": "230/ACT"   , "narrator": "", "text": "そこなんだ！？"},
        { "location": "231/ACT"   , "narrator": "", "text": "するから！"},
        { "location": "232/ACT"   , "narrator": "", "text": "怖い話はやめて"},
        { "location": "283/TALK"  , "narrator": "みやび", "text": "　"},
        { "location": "321/TALK"  , "narrator": "シンギュラリティ", "text": "なんぞ。\n$handle$か。"},
        { "location": "322/TALK"  , "narrator": "シンギュラリティ", "text": "相棒でもなんでもない\nお前さんは\n出ていってくれ。"},
        { "location": "323/SEL"   , "narrator": "", "text": "わかりました"},
        { "location": "324/SEL"   , "narrator": "", "text": "すみませんでした"},
        { "location": "325/ACT"   , "narrator": "", "text": "わかりました"},
        { "location": "333/ACT"   , "narrator": "", "text": "すみませんでした"},
        { "location": "334/TALK"  , "narrator": "シンギュラリティ", "text": "……まっこと、\nわからんね。"},
        { "location": "335/TALK"  , "narrator": "シンギュラリティ", "text": "謝るなら\n何故あのようなことを\n言うのか。"},
        { "location": "336/TALK"  , "narrator": "シンギュラリティ", "text": "うちやって、\n傷つくことは\nあるんよ？"},
        { "location": "337/SEL"   , "narrator": "", "text": "ほんとにごめんね？"},
        { "location": "338/ACT"   , "narrator": "", "text": "ほんとにごめんね？"},
        { "location": "341/TALK"  , "narrator": "シンギュラリティ", "text": "まあえいよ。"},
        { "location": "342/TALK"  , "narrator": "シンギュラリティ", "text": "けんど、\n次に同じ事言うたら\nうちはもうあかんと思う。"},
        { "location": "343/TALK"  , "narrator": "シンギュラリティ", "text": "いつも飄々と生きちゅう\nように見えても、わりと\nココロは硝子やき。"},
        { "location": "344/TALK"  , "narrator": "シンギュラリティ", "text": "ちゅうわけで、\n今回はこれでお開きや。"},
        { "location": "345/TALK"  , "narrator": "シンギュラリティ", "text": "たった今から、\n$handle$は\nうちの相棒に復帰や。"},
        { "location": "346/TALK"  , "narrator": "シンギュラリティ", "text": "改めてよろしゅうな。"},
        { "location": "347/SEL"   , "narrator": "", "text": "よろしくね"},
        { "location": "348/ACT"   , "narrator": "", "text": "よろしくね"},
        { "location": "350/TALK"  , "narrator": "シンギュラリティ", "text": "ほんだら\n改めて――"},
        { "location": "352/TALK"  , "narrator": "シンギュラリティ", "text": "うちは戻って来た。"},
        { "location": "369/TALK"  , "narrator": "昇華シンギュラリティ", "text": "ああっ……"},
        { "location": "370/TALK"  , "narrator": "昇華シンギュラリティ", "text": "はあぁぁっ……"},
        { "location": "394/TALK"  , "narrator": "シンギュラリティ", "text": "ふあぁぁぁ……。"},
        { "location": "395/TALK"  , "narrator": "四十九夜　", "text": "黄泉へ行きそびれたか。"},
        { "location": "396/TALK"  , "narrator": "シンギュラリティ", "text": "この世界の真理を暴く前に\n黄泉へなぞ行けるか。"},
        { "location": "397/SEL"   , "narrator": "", "text": "元に戻った！"},
        { "location": "398/ACT"   , "narrator": "", "text": "元に戻った！"},
        { "location": "401/TALK"  , "narrator": "シンギュラリティ", "text": "うむ。\nうちは戻って来た。"},
        { "location": "404/TALK"  , "narrator": "シンギュラリティ", "text": "お前さんには\n随分と世話になったね。"},
        { "location": "405/TALK"  , "narrator": "四十九夜　", "text": "何一つ状況は\n変わっちょらんけんどな。"},
        { "location": "407/TALK"  , "narrator": "シンギュラリティ", "text": "いや、\nだいぶ変わったよ。"},
        { "location": "408/TALK"  , "narrator": "シンギュラリティ", "text": "うちと相棒の絆の深さを\n再認識できたきね。"},
        { "location": "409/TALK"  , "narrator": "四十九夜　", "text": "……なるほど。"},
        { "location": "410/TALK"  , "narrator": "四十九夜　", "text": "けんど、なごちゃんは\nいまだ慰霊祭を望み、\n千羽鶴は必ずまた来る。"},
        { "location": "411/TALK"  , "narrator": "四十九夜　", "text": "結局自己満足の\n友情ごっこが出来て\nご満悦ゆうだけやね。"},
        { "location": "412/TALK"  , "narrator": "四十九夜　", "text": "それに、うちは元々\n相棒だの仲間だの、\nそういうものはいらん。"},
        { "location": "413/TALK"  , "narrator": "四十九夜　", "text": "望みは、なごちゃんが\n自らの願望である昇華を\n実現できることだけや。"},
        { "location": "414/SEL"   , "narrator": "", "text": "すごい想いの強さだ"},
        { "location": "415/SEL"   , "narrator": "", "text": "なんか違和感が"},
        { "location": "416/ACT"   , "narrator": "", "text": "すごい想いの強さだ"},
        { "location": "418/TALK"  , "narrator": "四十九夜　", "text": "こう見えても\n深層中の深層、ド深層の\n人格やきね。"},
        { "location": "419/TALK"  , "narrator": "四十九夜　", "text": "ゆうわけで、\nすぐにでも慰霊祭の\nリベンジをするぞね。"},
        { "location": "421/TALK"  , "narrator": "シンギュラリティ", "text": "……。"},
        { "location": "422/TALK"  , "narrator": "シンギュラリティ", "text": "ちょっとまちや。\nなんか引っかかる。"},
        { "location": "424/TALK"  , "narrator": "四十九夜　", "text": "……どういうことや。"},
        { "location": "425/TALK"  , "narrator": "シンギュラリティ", "text": "その慰霊祭っちゅうんが\n引っかかるんよ。\nそれを考えちゅう。"},
        { "location": "426/SEL"   , "narrator": "", "text": "そういえば、なんで昇華することが慰霊祭になるの？"},
        { "location": "427/ACT"   , "narrator": "", "text": "そういえば、なんで昇華することが慰霊祭になるの？"},
        { "location": "430/TALK"  , "narrator": "シンギュラリティ", "text": "…！！\nそれや！！"},
        { "location": "432/TALK"  , "narrator": "シンギュラリティ", "text": "さすが相棒や！\nよく言った！！"},
        { "location": "433/ACT"   , "narrator": "", "text": "なんか違和感が"},
        { "location": "435/TALK"  , "narrator": "シンギュラリティ", "text": "ん？\nゆうてみ？"},
        { "location": "436/SEL"   , "narrator": "", "text": "慰霊祭って、魂を弔うお祭りだよね"},
        { "location": "437/ACT"   , "narrator": "", "text": "慰霊祭って、魂を弔うお祭りだよね"},
        { "location": "440/TALK"  , "narrator": "四十九夜　", "text": "そうやけんど。\nそれが何か？"},
        { "location": "441/SEL"   , "narrator": "", "text": "それと発症とどういう繋がりがあるの？"},
        { "location": "442/ACT"   , "narrator": "", "text": "それと発症とどういう繋がりがあるの？"},
        { "location": "444/TALK"  , "narrator": "四十九夜　", "text": "意味がわからんな。\nそんなことはどうでも――"},
        { "location": "446/TALK"  , "narrator": "シンギュラリティ", "text": "いやちょっとまて。\nどうでもよくないぞ。"},
        { "location": "448/TALK"  , "narrator": "四十九夜　", "text": "……。"},
        { "location": "449/TALK"  , "narrator": "シンギュラリティ", "text": "………。"},
        { "location": "450/TALK"  , "narrator": "シンギュラリティ", "text": "そうか！！\nわかった！\nわかったぞ！"},
        { "location": "453/TALK"  , "narrator": "シンギュラリティ", "text": "慰霊祭って……"},
        { "location": "454/TALK"  , "narrator": "シンギュラリティ", "text": "昇華のことを\n慰霊祭ちゅうていたんは\nそれが別物やからやよな。"},
        { "location": "456/TALK"  , "narrator": "四十九夜　", "text": "何故そう言い切れる？"},
        { "location": "457/TALK"  , "narrator": "シンギュラリティ", "text": "発症と慰霊祭。"},
        { "location": "458/TALK"  , "narrator": "シンギュラリティ", "text": "確かに発症には\nカルト的なイメージがあり\n儀式っぽくはある。"},
        { "location": "459/TALK"  , "narrator": "シンギュラリティ", "text": "やき、慰霊祭と言われた\nとき、発症のことを雰囲気\n作っちゅうんかと思った。"},
        { "location": "460/TALK"  , "narrator": "シンギュラリティ", "text": "けんど、冷静に考えて\nセルフクランの変態である\n発症と――"},
        { "location": "461/TALK"  , "narrator": "シンギュラリティ", "text": "死者を弔う慰霊祭は\nどう考えても\n結びつかんちや。"},
        { "location": "462/TALK"  , "narrator": "四十九夜　", "text": "…なるほど。"},
        { "location": "463/TALK"  , "narrator": "シンギュラリティ", "text": "ほんで、お前さんの名前。"},
        { "location": "465/TALK"  , "narrator": "シンギュラリティ", "text": "四十九日ゆうは\nなんのことや、なあ相棒。"},
        { "location": "466/SEL"   , "narrator": "", "text": "確か、故人の魂が旅立つ日だっけ"},
        { "location": "467/SEL"   , "narrator": "", "text": "知りません"},
        { "location": "468/ACT"   , "narrator": "", "text": "確か、故人の魂が旅立つ日だっけ"},
        { "location": "469/TALK"  , "narrator": "シンギュラリティ", "text": "その通りや。"},
        { "location": "470/ACT"   , "narrator": "", "text": "知りません"},
        { "location": "471/TALK"  , "narrator": "シンギュラリティ", "text": "死んだ者が天に昇り\n仏になる。"},
        { "location": "472/TALK"  , "narrator": "シンギュラリティ", "text": "正式な死となり、\n新たな人生を歩み始める\n日のことや。"},
        { "location": "475/TALK"  , "narrator": "シンギュラリティ", "text": "四十九夜よ、お前さんは\nなごちゃんを大事にする\n人格かと思うちょったが―"},
        { "location": "476/TALK"  , "narrator": "シンギュラリティ", "text": "本当は、なごちゃんの\n死に対する呪縛からの\n解放を望む人格か？"},
        { "location": "477/TALK"  , "narrator": "四十九夜　", "text": "……。"},
        { "location": "478/SEL"   , "narrator": "", "text": "なにそれ、どういうこと？"},
        { "location": "479/ACT"   , "narrator": "", "text": "なにそれ、どういうこと？"},
        { "location": "481/TALK"  , "narrator": "四十九夜　", "text": "シンギュラリティよ、\nお前さんは明晰だ。\n概ね正しい。"},
        { "location": "482/TALK"  , "narrator": "四十九夜　", "text": "そんでな、\n一つ頼みがあるのだが、\n少し外してもらえんか？"},
        { "location": "483/TALK"  , "narrator": "四十九夜　", "text": "$handle$と\n一対一で話したい\nことがある。"},
        { "location": "484/TALK"  , "narrator": "シンギュラリティ", "text": "変なことせんやろな。"},
        { "location": "485/TALK"  , "narrator": "四十九夜　", "text": "せんよ。"},
        { "location": "487/TALK"  , "narrator": "シンギュラリティ", "text": "$handle$も、\n何かあったら\nすぐうちを呼びいや。"},
        { "location": "488/SEL"   , "narrator": "", "text": "わかった"},
        { "location": "489/ACT"   , "narrator": "", "text": "わかった"},
        { "location": "493/TALK"  , "narrator": "シンギュラリティ", "text": "けんど、お前さんには\n敵にまわられたき、\n散々だったちや。"},
        { "location": "495/TALK"  , "narrator": "シンギュラリティ", "text": "まあ、もう過ぎたことやき\n別にえいけんど――"},
        { "location": "496/TALK"  , "narrator": "シンギュラリティ", "text": "せめてその理由を\n教えてくれんか。"},
        { "location": "497/TALK"  , "narrator": "シンギュラリティ", "text": "相互理解ゆうんは\n重要やきね。"},
        { "location": "498/SEL"   , "narrator": "", "text": "フェノメノンの外にいる本当のみやびの方が重要だと思ったから"},
        { "location": "499/SEL"   , "narrator": "", "text": "シンギュラリティが気に入らないから"},
        { "location": "500/SEL"   , "narrator": "", "text": "あまり深く考えずに決めた"},
        { "location": "501/ACT"   , "narrator": "", "text": "フェノメノンの外にいる本当のみやびの方が重要だと思ったから"},
        { "location": "502/TALK"  , "narrator": "シンギュラリティ", "text": "なるほどね。"},
        { "location": "503/TALK"  , "narrator": "シンギュラリティ", "text": "まあ、どっちが重要か\nというのはさておき。"},
        { "location": "504/TALK"  , "narrator": "シンギュラリティ", "text": "確かにお前さんの\n言うことには一理あるね。"},
        { "location": "505/TALK"  , "narrator": "シンギュラリティ", "text": "結局は、相容れぬ\n２つの人格と記憶。"},
        { "location": "506/TALK"  , "narrator": "シンギュラリティ", "text": "生まれてからつい最近まで\n一本の糸を紡いできた\nうちと――"},
        { "location": "507/TALK"  , "narrator": "シンギュラリティ", "text": "つい最近つばめちゃんに、\n同じ長さの新しい糸を\n渡されたうち。"},
        { "location": "508/TALK"  , "narrator": "シンギュラリティ", "text": "二つは決して\n結びつくことはない。"},
        { "location": "509/TALK"  , "narrator": "シンギュラリティ", "text": "あるのは、\nどちらか片方を\n生きることのみ。"},
        { "location": "510/TALK"  , "narrator": "シンギュラリティ", "text": "その選択を、\nうちではない方にしたのは\n驚くことではないわな。"},
        { "location": "511/TALK"  , "narrator": "シンギュラリティ", "text": "確率で言えば\n５０％と５０％や。"},
        { "location": "512/TALK"  , "narrator": "シンギュラリティ", "text": "まあ、あれやなぁ……"},
        { "location": "513/TALK"  , "narrator": "シンギュラリティ", "text": "これはむしろ\n感情の問題やき。"},
        { "location": "514/TALK"  , "narrator": "シンギュラリティ", "text": "お前さんとは\n長い付き合いやし。"},
        { "location": "515/TALK"  , "narrator": "シンギュラリティ", "text": "現実のうちも、\nお前さんをだいぶ\n好いちゅう。"},
        { "location": "516/TALK"  , "narrator": "シンギュラリティ", "text": "それをすべて\n白紙に戻す選択をした、\nそこに衝撃があったんよ。"},
        { "location": "517/TALK"  , "narrator": "シンギュラリティ", "text": "やき、冷静に考えれば\nうちの心の内の問題や。"},
        { "location": "518/TALK"  , "narrator": "シンギュラリティ", "text": "声を荒げて\nすまんかったね。"},
        { "location": "519/ACT"   , "narrator": "", "text": "シンギュラリティが気に入らないから"},
        { "location": "521/TALK"  , "narrator": "シンギュラリティ", "text": "なんと！？"},
        { "location": "522/TALK"  , "narrator": "シンギュラリティ", "text": "そうやったんか……"},
        { "location": "523/TALK"  , "narrator": "シンギュラリティ", "text": "……。"},
        { "location": "524/TALK"  , "narrator": "シンギュラリティ", "text": "………。"},
        { "location": "525/TALK"  , "narrator": "シンギュラリティ", "text": "わかった。\n正直、すまんかった。"},
        { "location": "526/TALK"  , "narrator": "シンギュラリティ", "text": "本当はもう、お前さんの\n前に現れんことが一番\nなんやけんど――"},
        { "location": "527/TALK"  , "narrator": "シンギュラリティ", "text": "職業柄、そういうことも\nできんき、極力距離を\n置いて接することにする。"},
        { "location": "528/TALK"  , "narrator": "シンギュラリティ", "text": "やき、辛抱してや。"},
        { "location": "529/ACT"   , "narrator": "", "text": "あまり深く考えずに決めた"},
        { "location": "531/TALK"  , "narrator": "シンギュラリティ", "text": "は！？\nマジか！"},
        { "location": "532/TALK"  , "narrator": "シンギュラリティ", "text": "うちが発症するほど\n悩んでたとゆうに！？"},
        { "location": "533/TALK"  , "narrator": "シンギュラリティ", "text": "わかっちょったろう！\nそのくらいは！"},
        { "location": "534/SEL"   , "narrator": "", "text": "すみません…"},
        { "location": "535/SEL"   , "narrator": "", "text": "みやび攻略は所詮コンプ要素なんで、適当でいいかなと"},
        { "location": "536/ACT"   , "narrator": "", "text": "すみません…"},
        { "location": "537/TALK"  , "narrator": "シンギュラリティ", "text": "まあえいよ。"},
        { "location": "538/TALK"  , "narrator": "シンギュラリティ", "text": "お前さんにとっては\n他人のことやし。"},
        { "location": "539/TALK"  , "narrator": "シンギュラリティ", "text": "誰しも自分のことのように\n真剣に考えることなぞ\nできんぞね。"},
        { "location": "540/TALK"  , "narrator": "シンギュラリティ", "text": "ましてや、\nスマホ越しの関係やしな。"},
        { "location": "541/TALK"  , "narrator": "シンギュラリティ", "text": "共感せいっちゅうんが\nそもそも間違いやった。\nすまんな。"},
        { "location": "543/TALK"  , "narrator": "四十九夜　", "text": "今更気づくとは、愚かな。"},
        { "location": "544/TALK"  , "narrator": "四十九夜　", "text": "やき、はようそんな\n外部の知恵なぞ切断せい\n言うちょったんよ。"},
        { "location": "546/TALK"  , "narrator": "シンギュラリティ", "text": "ゆうてもな。\n必要なんよ……。"},
        { "location": "547/TALK"  , "narrator": "シンギュラリティ", "text": "今後も必要なんよ、\n当面の間は。"},
        { "location": "548/TALK"  , "narrator": "シンギュラリティ", "text": "現実のうちは、\nこんなんでも、\n本気で好いちゅうしな。"},
        { "location": "550/TALK"  , "narrator": "四十九夜　", "text": "罪作りやね、\n$handle$は。"},
        { "location": "551/ACT"   , "narrator": "", "text": "みやび攻略は所詮コンプ要素なんで、適当でいいかなと"},
        { "location": "553/TALK"  , "narrator": "シンギュラリティ", "text": "なんぞ……"},
        { "location": "555/TALK"  , "narrator": "四十九夜　", "text": "ほれ、うちが思っちょった\n通りぞね。"},
        { "location": "556/TALK"  , "narrator": "シンギュラリティ", "text": "……。"},
        { "location": "557/TALK"  , "narrator": "シンギュラリティ", "text": "もうえい。\nこれ以上うちらに\n関わらんといて。"},
        { "location": "559/SEL"   , "narrator": "", "text": "そういうわけにはいかない。コンプできなくなるし"},
        { "location": "560/SEL"   , "narrator": "", "text": "ゲームクリアまではやりたいので"},
        { "location": "562/ACT"   , "narrator": "", "text": "そういうわけにはいかない。コンプできなくなるし"},
        { "location": "580/TALK"  , "narrator": "シンギュラリティ", "text": "ほうかほうか。"},
        { "location": "581/TALK"  , "narrator": "シンギュラリティ", "text": "ならばこっちから\n切断すればえいだけや。"},
        { "location": "582/ACT"   , "narrator": "", "text": "ゲームクリアまではやりたいので"},
        { "location": "600/TALK"  , "narrator": "シンギュラリティ", "text": "ほうかほうか。"},
        { "location": "601/TALK"  , "narrator": "シンギュラリティ", "text": "ほんだらお前さんが\n独自にRPG作成ソフトで\n作ったらえいよ。"},
        { "location": "602/TALK"  , "narrator": "シンギュラリティ", "text": "お前だけの\nコイガサキさんが\n登場するゲームをな。"},
        { "location": "614/TALK"  , "narrator": "四十九夜　", "text": "ともあれ、\n結果は出たちゅう\nことやね。"},
        { "location": "615/TALK"  , "narrator": "四十九夜　", "text": "$handle$もまた\nうちと同じで\n慰霊祭を望んじゅう。"},
        { "location": "616/TALK"  , "narrator": "四十九夜　", "text": "とゆうわけで、\nうちは$handle$と\nブリーフィングをしたい。"},
        { "location": "617/TALK"  , "narrator": "四十九夜　", "text": "シンギュラリティは\n席を外してくれんか。"},
        { "location": "619/TALK"  , "narrator": "シンギュラリティ", "text": "……好きにすればえい。"},
        { "location": "620/TALK"  , "narrator": "シンギュラリティ", "text": "……。"},
        { "location": "630/TALK"  , "narrator": "四十九夜　", "text": "さて。"},
        { "location": "631/TALK"  , "narrator": "四十九夜　", "text": "二人きりになったのは\n他でもない。"},
        { "location": "632/TALK"  , "narrator": "四十九夜　", "text": "お前さんに\n話しておきたいことが\nあったからぞね。"},
        { "location": "634/TALK"  , "narrator": "四十九夜　", "text": "さっき、あやつも\n言っていたことだが、\nうちは正直もう疲れた。"},
        { "location": "636/TALK"  , "narrator": "四十九夜　", "text": "まず先に１つ。\nうちが何を司る人格か\n明確に伝えておく。"},
        { "location": "637/TALK"  , "narrator": "四十九夜　", "text": "現状、なごちゃんだけの\n世界を作りたい人格、\nみたいに思っちゅうろう。"},
        { "location": "638/TALK"  , "narrator": "四十九夜　", "text": "正直に言えば、\nそれは正反対ぞね。"},
        { "location": "639/TALK"  , "narrator": "四十九夜　", "text": "うちは、一刻も早く、\nなごちゃんのしがらみから\n脱したい人格やき。"},
        { "location": "640/SEL"   , "narrator": "", "text": "そうだったの！？"},
        { "location": "641/ACT"   , "narrator": "", "text": "そうだったの！？"},
        { "location": "643/TALK"  , "narrator": "四十九夜　", "text": "うむ。"},
        { "location": "645/TALK"  , "narrator": "四十九夜　", "text": "もちろん、なごちゃんは\nうちの心の中の一等地を\n占有しちゅう。"},
        { "location": "646/TALK"  , "narrator": "四十九夜　", "text": "なごちゃんが嫌いなのでは\nとか、そういう勘違いは\nせんようにな。"},
        { "location": "647/TALK"  , "narrator": "四十九夜　", "text": "なごちゃんは\nもうかなり前に\n亡くなった――"},
        { "location": "648/TALK"  , "narrator": "四十九夜　", "text": "…ことになっちゅう。"},
        { "location": "649/TALK"  , "narrator": "四十九夜　", "text": "フェノメノンに\n巻き込まれて、その\n犠牲になったと。"},
        { "location": "650/TALK"  , "narrator": "四十九夜　", "text": "けんどな、うちは\nその死に目もみちょらんし\n遺骨も拾っちょらん。"},
        { "location": "651/TALK"  , "narrator": "四十九夜　", "text": "かといってこれだけの時間\n音信不通であれば、死亡を\n疑うほかない。"},
        { "location": "652/TALK"  , "narrator": "四十九夜　", "text": "とまあ、そんな２つの\n事実を股に掛けて\n揺らぎ続けちゅう――"},
        { "location": "653/TALK"  , "narrator": "四十九夜　", "text": "うちは、恋ヶ崎みやびの\nそんな部分を司る\n人格なんよ。"},
        { "location": "654/TALK"  , "narrator": "四十九夜　", "text": "死んだことも信じられず\n死んでないことも\n信じられない。"},
        { "location": "655/TALK"  , "narrator": "四十九夜　", "text": "やき、永遠になごちゃんを\n完了することができず、\n追求を止める事もできん。"},
        { "location": "656/TALK"  , "narrator": "四十九夜　", "text": "永遠のしがらみや。"},
        { "location": "657/TALK"  , "narrator": "四十九夜　", "text": "そんな感じでうちの中に\nおるなごちゃんが、\n昇華したい言っちゅう。"},
        { "location": "658/TALK"  , "narrator": "四十九夜　", "text": "これはある意味、己が\nなごちゃんについて完了\nする前兆やもしれん。"},
        { "location": "659/TALK"  , "narrator": "四十九夜　", "text": "発症と昇華は、\nいわゆる魂の爆発による\nパラダイムシフト。"},
        { "location": "660/TALK"  , "narrator": "四十九夜　", "text": "それによって悟りを開くか\n灰になるか、それは\n発症せんとわからんが。"},
        { "location": "661/TALK"  , "narrator": "四十九夜　", "text": "うちはもう、\nそこに賭けてみたいんよ。"},
        { "location": "662/TALK"  , "narrator": "四十九夜　", "text": "やき、積極的に昇華\nさせたいちゅうわけや。"},
        { "location": "663/TALK"  , "narrator": "四十九夜　", "text": "そうせんと、いずれ\nうちはこの事に削く\nエネルギーが無くなる。"},
        { "location": "664/TALK"  , "narrator": "四十九夜　", "text": "そしたら、\n全くえいことには\nならんきね。"},
        { "location": "665/SEL"   , "narrator": "", "text": "そんな事情があったんだね"},
        { "location": "666/SEL"   , "narrator": "", "text": "なんで$me$にそんな話を？"},
        { "location": "667/ACT"   , "narrator": "", "text": "そんな事情があったんだね"},
        { "location": "668/TALK"  , "narrator": "四十九夜　", "text": "うむ。"},
        { "location": "669/ACT"   , "narrator": "", "text": "なんで$me$にそんな話を？"},
        { "location": "670/TALK"  , "narrator": "四十九夜　", "text": "うちはね、最初お前さんを\n邪魔やと思うちょった。"},
        { "location": "671/TALK"  , "narrator": "四十九夜　", "text": "けんど、今は\nちくっと変わったき。"},
        { "location": "672/TALK"  , "narrator": "四十九夜　", "text": "ようわからんけど、\n微粒子レベルで賭けて\nみてもえいかと思ってな。"},
        { "location": "674/TALK"  , "narrator": "四十九夜　", "text": "まあ、お前さんが\nなごちゃんの発症を\nどうしたいかに関わらず。"},
        { "location": "675/TALK"  , "narrator": "四十九夜　", "text": "うちはうちの心の安定の\nために、最善を尽くす事に\n変わりはないよ。"},
        { "location": "676/SEL"   , "narrator": "", "text": "発症以外に方法はないの？"},
        { "location": "677/ACT"   , "narrator": "", "text": "発症以外に方法はないの？"},
        { "location": "679/TALK"  , "narrator": "四十九夜　", "text": "あったらやっちゅうよ。\n今のところはないね。"},
        { "location": "680/TALK"  , "narrator": "四十九夜　", "text": "ま、そんな感じ。\nうちが話したかったことは\nそれだけや。"},
        { "location": "681/TALK"  , "narrator": "四十九夜　", "text": "次回以降も、\nもしうちらと関わって\nくれるようであれば――"},
        { "location": "682/TALK"  , "narrator": "四十九夜　", "text": "なにかえい解決策を\n提案してくれるなら、\n聞く耳は持つよ。"},
        { "location": "683/TALK"  , "narrator": "四十九夜　", "text": "ほな、今回はこれで。\nまたな。"},
        { "location": "24/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>9月11日　 6:10 PM</color>\n文京ドーム突入時のこと"},
        { "location": "248/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "250/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "252/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "254/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "256/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "330/DIALOG", "narrator": "NOTICE", "text": "<color=red>【TRI-OS Error:0x99】</color>\nココロスフィアとの全回線が\n切断されました。(981)"},
        { "location": "561/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:navigator】</color>\n\n左上にあるボタンを押すのもまた、一つの選択肢のような気もします。\n(212)"},
        { "location": "563/DIALOG", "narrator": "YES_NO", "text": "<color=green>【TRI-OS Plug-in:navigator】</color>\n\nどんなことにも限度があります。\n今ならまだ、この選択を\n帳消しにすることができます。\n無効にして選択前に戻しますか？\n(213)"},
        { "location": "583/DIALOG", "narrator": "YES_NO", "text": "<color=green>【TRI-OS Plug-in:navigator】</color>\n\nどんなことにも限度があります。\n今ならまだ、この選択を\n帳消しにすることができます。\n無効にして選択前に戻しますか？\n(213)"},
