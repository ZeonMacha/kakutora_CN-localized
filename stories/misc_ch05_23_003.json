    "entry":
    [
        { "location": "7639/SCENARIO", "narrator": "", "text": "小指の意味は"},
        { "location": "7666/TALK"    , "narrator": "神楽", "text": "指切りげんまん"},
        { "location": "7667/TALK"    , "narrator": "神楽", "text": "嘘ついたら"},
        { "location": "7668/TALK"    , "narrator": "神楽", "text": "ハリセンボン飲ますー！！！"},
        { "location": "7670/SEL"     , "narrator": "", "text": "二人の愛の約束かな？"},
        { "location": "7671/SEL"     , "narrator": "", "text": "えっと、何のこと！？"},
        { "location": "7672/SEL"     , "narrator": "", "text": "それじゃ魚だよ！？"},
        { "location": "7673/ACT"     , "narrator": "", "text": "二人の愛の約束かな？"},
        { "location": "7675/TALK"    , "narrator": "神楽", "text": "それだ！！！"},
        { "location": "7676/TALK"    , "narrator": "神楽", "text": "そういうことにする！！！"},
        { "location": "7678/TALK"    , "narrator": "神楽", "text": "約束しましょ"},
        { "location": "7679/TALK"    , "narrator": "神楽", "text": "そうしましょ♪"},
        { "location": "7680/ACT"     , "narrator": "", "text": "えっと、何のこと！？"},
        { "location": "7681/TALK"    , "narrator": "神楽", "text": "いや別に何のことでもないぴょん？"},
        { "location": "7682/ACT"     , "narrator": "", "text": "それじゃ魚だよ！？"},
        { "location": "7683/TALK"    , "narrator": "神楽", "text": "ほんとだー！"},
        { "location": "7684/TALK"    , "narrator": "神楽", "text": "魚魚魚ー"},
        { "location": "7686/TALK"    , "narrator": "神楽", "text": "実際はなんか自分の指切って渡すとかそういう物騒な話だったらしいぴょん"},
        { "location": "7687/TALK"    , "narrator": "神楽", "text": "やだ過激☆彡"},
        { "location": "7689/SEL"     , "narrator": "", "text": "話って盛るものだから"},
        { "location": "7690/SEL"     , "narrator": "", "text": "情熱的だね"},
        { "location": "7691/SEL"     , "narrator": "", "text": "$me$は神楽を傷つけない"},
        { "location": "7692/ACT"     , "narrator": "", "text": "話って盛るものだから"},
        { "location": "7693/TALK"    , "narrator": "神楽", "text": "やるやる！"},
        { "location": "7694/TALK"    , "narrator": "神楽", "text": "悪気はないんだぴょん"},
        { "location": "7695/ACT"     , "narrator": "", "text": "情熱的だね"},
        { "location": "7696/TALK"    , "narrator": "神楽", "text": "既に狂気の域だぴょん"},
        { "location": "7697/TALK"    , "narrator": "神楽", "text": "ヤンデレ―！"},
        { "location": "7698/ACT"     , "narrator": "", "text": "$me$は神楽を傷つけない"},
        { "location": "7700/TALK"    , "narrator": "神楽", "text": "$handlek$カコイイ！！！"},
        { "location": "7702/TALK"    , "narrator": "神楽", "text": "主役しか言っちゃいけないセリフいただきました！"},
        { "location": "7703/TALK"    , "narrator": "神楽", "text": "んじゃぴょんこはヒロインになるぴょん♪"},
        { "location": "7704/TALK"    , "narrator": "神楽", "text": "大ヒット間違いなし！！！！"},
        { "location": "7706/TALK"    , "narrator": "神楽", "text": "そういや沖縄だとハリセンボン食べるらしいぴょん"},
        { "location": "7707/TALK"    , "narrator": "神楽", "text": "フグの仲間だっていうから結構おいしいんじゃないかな～？じゅるり♪"}
    ]
}
