    "entry":
    [
        { "location": "4595/SCENARIO", "narrator": "", "text": "種を知ってる手品みたいな"},
        { "location": "4620/TALK"    , "narrator": "神楽", "text": "よくできた映画はラストを知ってても見返すし同じところで心が動く"},
        { "location": "4621/TALK"    , "narrator": "神楽", "text": "あれってどういうことなんだろ"},
        { "location": "4623/SEL"     , "narrator": "", "text": "芸術の域だから"},
        { "location": "4624/SEL"     , "narrator": "", "text": "ツボなんだろうね"},
        { "location": "4625/SEL"     , "narrator": "", "text": "そこに気づいた神楽に感動した"},
        { "location": "4626/ACT"     , "narrator": "", "text": "芸術の域だから"},
        { "location": "4627/TALK"    , "narrator": "神楽", "text": "そういうことなのかな"},
        { "location": "4628/ACT"     , "narrator": "", "text": "ツボなんだろうね"},
        { "location": "4629/TALK"    , "narrator": "神楽", "text": "かもしれないぴょん"},
        { "location": "4630/ACT"     , "narrator": "", "text": "そこに気づいた神楽に感動した"},
        { "location": "4632/TALK"    , "narrator": "神楽", "text": "おおお？"},
        { "location": "4633/TALK"    , "narrator": "神楽", "text": "ほめても何にも出ないけど"},
        { "location": "4635/TALK"    , "narrator": "神楽", "text": "ぴょんこはご機嫌になりました♪"},
        { "location": "4637/TALK"    , "narrator": "神楽", "text": "そういえば"},
        { "location": "4638/TALK"    , "narrator": "神楽", "text": "$handlek$の好きな映画って何？"},
        { "location": "4640/SEL"     , "narrator": "", "text": "ホラー"},
        { "location": "4641/SEL"     , "narrator": "", "text": "香港アクション"},
        { "location": "4642/SEL"     , "narrator": "", "text": "ヒッチコックとか"},
        { "location": "4643/SEL"     , "narrator": "", "text": "アニメしか観ない"},
        { "location": "4644/SEL"     , "narrator": "", "text": "海外ドキュメンタリー"},
        { "location": "4645/ACT"     , "narrator": "", "text": "ホラー"},
        { "location": "4646/TALK"    , "narrator": "神楽", "text": "グロ系？？？"},
        { "location": "4647/ACT"     , "narrator": "", "text": "香港アクション"},
        { "location": "4648/TALK"    , "narrator": "神楽", "text": "スカッとしていいね"},
        { "location": "4649/ACT"     , "narrator": "", "text": "ヒッチコックとか"},
        { "location": "4650/TALK"    , "narrator": "神楽", "text": "渋い"},
        { "location": "4651/ACT"     , "narrator": "", "text": "アニメしか観ない"},
        { "location": "4652/TALK"    , "narrator": "神楽", "text": "オタクキター！！！"},
        { "location": "4653/ACT"     , "narrator": "", "text": "海外ドキュメンタリー"},
        { "location": "4654/TALK"    , "narrator": "神楽", "text": "社会派なんだ"},
        { "location": "4656/TALK"    , "narrator": "神楽", "text": "ぴょんこ実は画面構成の美しさも重視するぴょん"},
        { "location": "4658/SEL"     , "narrator": "", "text": "ふーん"},
        { "location": "4659/SEL"     , "narrator": "", "text": "そういう観方もありか"},
        { "location": "4660/SEL"     , "narrator": "", "text": "神楽っぽい鑑賞の仕方だね"},
        { "location": "4661/ACT"     , "narrator": "", "text": "ふーん"},
        { "location": "4662/TALK"    , "narrator": "神楽", "text": "これってキャラ重視派とは相容れないっぽいからなー"},
        { "location": "4665/ACT"     , "narrator": "", "text": "そういう観方もありか"},
        { "location": "4666/TALK"    , "narrator": "神楽", "text": "絵を描く人とかはそうみたいぴょん"},
        { "location": "4667/ACT"     , "narrator": "", "text": "神楽っぽい鑑賞の仕方だね"},
        { "location": "4669/TALK"    , "narrator": "神楽", "text": "そうなのかなー？"},
        { "location": "4670/TALK"    , "narrator": "神楽", "text": "$handlek$の中のぴょんこはそうなんだなー？"},
        { "location": "4671/TALK"    , "narrator": "神楽", "text": "それはそれでありだなー"},
        { "location": "4673/TALK"    , "narrator": "神楽", "text": "好きすぎる光景がある映画は話なんてもうどうでもよくなったりするんだぴょん"},
        { "location": "4675/TALK"    , "narrator": "神楽", "text": "その景色を見るためだけに何度も見返したりするんだぴょん"},
        { "location": "4676/TALK"    , "narrator": "神楽", "text": "なんでだろーなー"}
    ]
}
