    [
        { "location": "413/SCENARIO", "narrator": "", "text": "50_聞いてもいい？"},
        { "location": "439/TALK"    , "narrator": "アーヤ", "text": "えーと"},
        { "location": "441/TALK"    , "narrator": "アーヤ", "text": "さん？"},
        { "location": "442/TALK"    , "narrator": "アーヤ", "text": "君？"},
        { "location": "443/TALK"    , "narrator": "アーヤ", "text": "ちゃん？"},
        { "location": "444/TALK"    , "narrator": "アーヤ", "text": "あ＼(◎o◎)／"},
        { "location": "445/TALK"    , "narrator": "アーヤ", "text": "様とか？"},
        { "location": "448/SEL"     , "narrator": "", "text": "$me$は$me$だよ"},
        { "location": "449/SEL"     , "narrator": "", "text": "何の話？"},
        { "location": "450/SEL"     , "narrator": "", "text": "善きに計らえ"},
        { "location": "451/ACT"     , "narrator": "", "text": "$me$は$me$だよ"},
        { "location": "452/TALK"    , "narrator": "アーヤ", "text": "あ"},
        { "location": "453/TALK"    , "narrator": "アーヤ", "text": "そうなんだろうけど"},
        { "location": "456/ACT"     , "narrator": "", "text": "何の話？"},
        { "location": "457/TALK"    , "narrator": "アーヤ", "text": "名前の後に付ける継承の話"},
        { "location": "458/TALK"    , "narrator": "アーヤ", "text": "敬称の"},
        { "location": "459/ACT"     , "narrator": "", "text": "善きに計らえ"},
        { "location": "471/TALK"    , "narrator": "アーヤ", "text": "殿なの？"},
        { "location": "472/TALK"    , "narrator": "アーヤ", "text": "殿ただの？"},
        { "location": "474/TALK"    , "narrator": "アーヤ", "text": "殿かー"},
        { "location": "477/TALK"    , "narrator": "アーヤ", "text": "殿なのねー"},
        { "location": "480/TALK"    , "narrator": "アーヤ", "text": "えーとね"},
        { "location": "481/TALK"    , "narrator": "アーヤ", "text": "なんて呼ばれたいのかって思って"},
        { "location": "482/TALK"    , "narrator": "アーヤ", "text": "希望はある（￣ー￣？）"},
        { "location": "484/SEL"     , "narrator": "", "text": "特にない"},
        { "location": "485/SEL"     , "narrator": "", "text": "アーヤが呼びたいように"},
        { "location": "486/SEL"     , "narrator": "", "text": "なんでそんなこと聞くの？"},
        { "location": "488/ACT"     , "narrator": "", "text": "特にない"},
        { "location": "489/TALK"    , "narrator": "アーヤ", "text": "そうなの"},
        { "location": "490/TALK"    , "narrator": "アーヤ", "text": "じゃあ"},
        { "location": "491/TALK"    , "narrator": "アーヤ", "text": "普通に呼ぶわね"},
        { "location": "492/ACT"     , "narrator": "", "text": "アーヤが呼びたいように"},
        { "location": "502/TALK"    , "narrator": "アーヤ", "text": "あら"},
        { "location": "503/TALK"    , "narrator": "アーヤ", "text": "それでいいのかしら♪"},
        { "location": "504/TALK"    , "narrator": "アーヤ", "text": "じゃあ"},
        { "location": "506/TALK"    , "narrator": "アーヤ", "text": "なんて呼ぶか"},
        { "location": "507/TALK"    , "narrator": "アーヤ", "text": "考えておくわね"},
        { "location": "508/ACT"     , "narrator": "", "text": "なんでそんなこと聞くの？"},
        { "location": "518/TALK"    , "narrator": "アーヤ", "text": "え＼(◎o◎)／"},
        { "location": "519/TALK"    , "narrator": "アーヤ", "text": "と"},
        { "location": "520/TALK"    , "narrator": "アーヤ", "text": "ちょっと"},
        { "location": "521/TALK"    , "narrator": "アーヤ", "text": "気になることがあって"},
        { "location": "522/TALK"    , "narrator": "アーヤ", "text": "気になったから"},
        { "location": "524/TALK"    , "narrator": "アーヤ", "text": "それだけヽ(´o｀；"},
        { "location": "525/TALK"    , "narrator": "アーヤ", "text": "それだけよ"},
        { "location": "526/TALK"    , "narrator": "アーヤ", "text": "意味はないの"},
        { "location": "465/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>500pt.</b></color></size>\nアップしました！"},
        { "location": "498/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>400pt.</b></color></size>\nアップしました！"},
        { "location": "514/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>500pt.</b></color></size>\nアップしました！"}
    ]
