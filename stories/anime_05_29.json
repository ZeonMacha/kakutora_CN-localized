{
    "dir": "chap29/daydra/anime_05_29.js",
    "type": "MainStory",
    "info": {
        "story_id": "29501",
        "cid": "kagura",
        "title": "001 アニメーション",
        "sub_title": "エグゼクション"
    },
    "entry":
    [
        { "location": "451/SCENARIO", "narrator": "", "text": "アニメ第29話"},
        { "location": "463/TALK"    , "narrator": "赤髪千羽鶴", "text": "こんにちは、\n$handle$さん。"},
        { "location": "464/TALK"    , "narrator": "赤髪千羽鶴", "text": "もう一度わたしと話を\nしていきますか？"},
        { "location": "465/SEL"     , "narrator": "", "text": "はい"},
        { "location": "466/SEL"     , "narrator": "", "text": "いいえ"},
        { "location": "467/ACT"     , "narrator": "", "text": "はい"},
        { "location": "468/TALK"    , "narrator": "赤髪千羽鶴", "text": "わかりました。\nそれでは……。"},
        { "location": "470/ACT"     , "narrator": "", "text": "いいえ"},
        { "location": "471/TALK"    , "narrator": "赤髪千羽鶴", "text": "わかりました。\nそれではこれで。"},
        { "location": "477/TALK"    , "narrator": "赤髪千羽鶴", "text": "こんにちは、\n$handle$さん。"},
        { "location": "478/SEL"     , "narrator": "", "text": "千羽鶴じゃないの！？"},
        { "location": "479/SEL"     , "narrator": "", "text": "結局どんな結果になったの？"},
        { "location": "480/ACT"     , "narrator": "", "text": "千羽鶴じゃないの！？"},
        { "location": "481/TALK"    , "narrator": "赤髪千羽鶴", "text": "記録映像を流すところで\n処理をすることに\n決まったんです。"},
        { "location": "482/TALK"    , "narrator": "赤髪千羽鶴", "text": "ですから、後ほど\nここに戻って来ますよ。\nご心配なく。"},
        { "location": "483/TALK"    , "narrator": "赤髪千羽鶴", "text": "それにしても、\n本当に千羽鶴が\n好きなんですね。"},
        { "location": "484/SEL"     , "narrator": "", "text": "そういうわけじゃなくて、ちゃんと約束履行するのか心配だっただけ"},
        { "location": "485/SEL"     , "narrator": "", "text": "大好きだよ！！！"},
        { "location": "486/ACT"     , "narrator": "", "text": "そういうわけじゃなくて、ちゃんと約束履行するのか心配だっただけ"},
        { "location": "487/TALK"    , "narrator": "赤髪千羽鶴", "text": "わたしの信頼も\n地に落ちた、という\nところでしょうか。"},
        { "location": "488/TALK"    , "narrator": "赤髪千羽鶴", "text": "わたし個人の\n自己評価としては――"},
        { "location": "489/TALK"    , "narrator": "赤髪千羽鶴", "text": "約束を破ったり、\n嘘を教えたりしたことは\n一度も無い筈なのですが。"},
        { "location": "490/TALK"    , "narrator": "赤髪千羽鶴", "text": "それどころか、\nわたしの方針を全て\nお教えしている程です。"},
        { "location": "491/TALK"    , "narrator": "赤髪千羽鶴", "text": "どういったところで\n信頼を失ったのか\n全く解りません。"},
        { "location": "492/TALK"    , "narrator": "赤髪千羽鶴", "text": "何か、これ、という\n原因があるようなら、\nご指摘ください。"},
        { "location": "493/TALK"    , "narrator": "赤髪千羽鶴", "text": "改善しようと思います。"},
        { "location": "494/SEL"     , "narrator": "", "text": "　"},
        { "location": "495/SEL"     , "narrator": "", "text": "　　"},
        { "location": "496/ACT"     , "narrator": "", "text": "　"},
        { "location": "497/ACT"     , "narrator": "", "text": "　　"},
        { "location": "499/TALK"    , "narrator": "赤髪千羽鶴", "text": "？"},
        { "location": "500/TALK"    , "narrator": "赤髪千羽鶴", "text": "上手く伝わって\nいないみたいですね。"},
        { "location": "501/TALK"    , "narrator": "赤髪千羽鶴", "text": "まあ、いずれまた\n機会があれば、\nお伺いしたいと思います。"},
        { "location": "502/ACT"     , "narrator": "", "text": "大好きだよ！！！"},
        { "location": "503/TALK"    , "narrator": "赤髪千羽鶴", "text": "凄い想いを感じます！"},
        { "location": "504/TALK"    , "narrator": "赤髪千羽鶴", "text": "わたしの中にも\nこんなにも人を惹きつける\n資源があったとは――"},
        { "location": "505/TALK"    , "narrator": "赤髪千羽鶴", "text": "正直、もう少しだけ\n自己評価を上げても\nいいかと思いました。"},
        { "location": "506/TALK"    , "narrator": "赤髪千羽鶴", "text": "ただ、それと同時に、\n己の中に埋もれている\n資源を見つけ出さないと。"},
        { "location": "507/SEL"     , "narrator": "", "text": "？？？"},
        { "location": "508/ACT"     , "narrator": "", "text": "？？？"},
        { "location": "510/TALK"    , "narrator": "赤髪千羽鶴", "text": "人は誰しも、自分さえも\n気づいていない【資源】や\n【資質】を持っています。"},
        { "location": "511/TALK"    , "narrator": "赤髪千羽鶴", "text": "例えば、毎日教室の隅で\nぼーっとして１日に一度も\n笑わない少女がいたとして"},
        { "location": "512/TALK"    , "narrator": "赤髪千羽鶴", "text": "その彼女の資源が、\n【情熱的で、周囲を笑顔に\nする力】だとしたら……"},
        { "location": "513/TALK"    , "narrator": "赤髪千羽鶴", "text": "あなたは信じられますか？"},
        { "location": "514/TALK"    , "narrator": "赤髪千羽鶴", "text": "でもそれは、\nごく当たり前に\nあり得ることなんです。"},
        { "location": "515/TALK"    , "narrator": "赤髪千羽鶴", "text": "人は皆、周囲との相対的な\n物差しで自分の振るまいを\n決め、それを固定します。"},
        { "location": "516/TALK"    , "narrator": "赤髪千羽鶴", "text": "けれどもそれは、殆どに\nおいて、本来自分がしたい\nことではないんです。"},
        { "location": "517/TALK"    , "narrator": "赤髪千羽鶴", "text": "そうしていくうちに、\n子供の時にはあった葛藤も\n忘れてしまい――"},
        { "location": "518/TALK"    , "narrator": "赤髪千羽鶴", "text": "大きくなるごとに、自分は\nこういう存在なんだと、\n自己暗示をかけてしまう。"},
        { "location": "519/TALK"    , "narrator": "赤髪千羽鶴", "text": "けれども潜在意識には、\nいつまでも資源が\n眠っているんです。"},
        { "location": "520/TALK"    , "narrator": "赤髪千羽鶴", "text": "千羽鶴は、洗脳によって\n作られた人格では\nありますが、種はわたし。"},
        { "location": "521/TALK"    , "narrator": "赤髪千羽鶴", "text": "当然、わたしの持つ\n資源の１つを司る\n人格でもあるわけです。"},
        { "location": "522/TALK"    , "narrator": "赤髪千羽鶴", "text": "前回、“今の”千羽鶴に\n初めて直接会って、\n感じたことは――"},
        { "location": "523/TALK"    , "narrator": "赤髪千羽鶴", "text": "分離したときにあった\n９９％を司る洗脳人格は\nほぼ失われていて、"},
        { "location": "524/TALK"    , "narrator": "赤髪千羽鶴", "text": "本来の千羽鶴という\n人格が持つ本質、資源が\n戻ってる様に感じました。"},
        { "location": "525/TALK"    , "narrator": "赤髪千羽鶴", "text": "ただそれが、どういう\n資源なのか、わたしには\n未だにわかりません。"},
        { "location": "526/TALK"    , "narrator": "赤髪千羽鶴", "text": "１つだけ言えることは\nその資源はあなたの心を\n魅了する程のものだった。"},
        { "location": "527/TALK"    , "narrator": "赤髪千羽鶴", "text": "そのことに、\n驚きを隠せないんです。"},
        { "location": "528/TALK"    , "narrator": "赤髪千羽鶴", "text": "私自身も、私自身で\nそれを感じ取れるよう\n頑張ってみようかと。"},
        { "location": "529/SEL"     , "narrator": "", "text": "頑張って！"},
        { "location": "530/SEL"     , "narrator": "", "text": "どーん！で全て解決だよ"},
        { "location": "531/ACT"     , "narrator": "", "text": "頑張って！"},
        { "location": "532/TALK"    , "narrator": "赤髪千羽鶴", "text": "ありがとうございます。"},
        { "location": "533/ACT"     , "narrator": "", "text": "どーん！で全て解決だよ"},
        { "location": "534/TALK"    , "narrator": "赤髪千羽鶴", "text": "はあ。"},
        { "location": "535/TALK"    , "narrator": "赤髪千羽鶴", "text": "……いや。"},
        { "location": "536/TALK"    , "narrator": "赤髪千羽鶴", "text": "ここで反発する時点で\nアウトなのかも。"},
        { "location": "537/SEL"     , "narrator": "", "text": "でも、過去に何度かやってたよね？"},
        { "location": "538/SEL"     , "narrator": "", "text": "恥じらい無くやる事が、千羽鶴の本質を知る第一歩なのだ！"},
        { "location": "539/ACT"     , "narrator": "", "text": "でも、過去に何度かやってたよね？"},
        { "location": "540/TALK"    , "narrator": "赤髪千羽鶴", "text": "あれは毎回、\n完全に無意識です。"},
        { "location": "541/ACT"     , "narrator": "", "text": "恥じらい無くやる事が、千羽鶴の本質を知る第一歩なのだ！"},
        { "location": "542/TALK"    , "narrator": "赤髪千羽鶴", "text": "それはあなたが、\nわたしのどーん！を\n見たいだけなのでは？"},
        { "location": "543/TALK"    , "narrator": "赤髪千羽鶴", "text": "まあでも、確かに\nあなたの言う通りかも\nしれませんね。"},
        { "location": "547/ACT"     , "narrator": "", "text": "結局どんな結果になったの？"},
        { "location": "548/TALK"    , "narrator": "赤髪千羽鶴", "text": "記録映像を流すところで\n処理をすることに\n決まりました。"},
        { "location": "549/TALK"    , "narrator": "赤髪千羽鶴", "text": "ですから、わたしが\nこのレイヤーでお話\nするのはこれが最後です。"},
        { "location": "551/TALK"    , "narrator": "赤髪千羽鶴", "text": "というわけで――"},
        { "location": "552/TALK"    , "narrator": "赤髪千羽鶴", "text": "まずは前回の千羽鶴との\n会談で決まったことを\nお伝えしたいと思います。"},
        { "location": "553/TALK"    , "narrator": "赤髪千羽鶴", "text": "現状の状況を鑑みて、\n急を要する危機的状況から\n脱したと判断しました。"},
        { "location": "554/TALK"    , "narrator": "赤髪千羽鶴", "text": "よってこの後、\n記録映像の過程で\n元レイヤーに戻ります。"},
        { "location": "555/TALK"    , "narrator": "赤髪千羽鶴", "text": "ただし、それは\n暫定的なものとします。"},
        { "location": "556/TALK"    , "narrator": "赤髪千羽鶴", "text": "今後の流れの中で、\n“彼ら”による介入が\n行われるような事があれば"},
        { "location": "557/TALK"    , "narrator": "赤髪千羽鶴", "text": "わたしはまた、やむを得ず\n実体を操作する為に、この\nレイヤーを上書きします。"},
        { "location": "558/TALK"    , "narrator": "赤髪千羽鶴", "text": "千羽鶴はこの条件に承諾し\nわたしはここから退去する\nこととなりました。"},
        { "location": "559/TALK"    , "narrator": "赤髪千羽鶴", "text": "以上です。"},
        { "location": "561/SEL"     , "narrator": "", "text": "危機的状況を脱した、の危機的状況って何だったの？"},
        { "location": "562/SEL"     , "narrator": "", "text": "実体を操作って何？"},
        { "location": "563/SEL"     , "narrator": "", "text": "先へ進む"},
        { "location": "564/ACT"     , "narrator": "", "text": "危機的状況を脱した、の危機的状況って何だったの？"},
        { "location": "565/TALK"    , "narrator": "赤髪千羽鶴", "text": "“彼ら”による\nライフギャザーの\n掌握と奪取です。"},
        { "location": "566/TALK"    , "narrator": "赤髪千羽鶴", "text": "わたしのいた未来では、\nこの辺りの時間軸で\n奪われました。"},
        { "location": "567/TALK"    , "narrator": "赤髪千羽鶴", "text": "それを阻止すべく、\nわたしは未来から\n可能な限り操作をし――"},
        { "location": "568/TALK"    , "narrator": "赤髪千羽鶴", "text": "卯月神楽の同化と\n回線の切断を実施します。"},
        { "location": "569/TALK"    , "narrator": "赤髪千羽鶴", "text": "そうすることで。"},
        { "location": "570/TALK"    , "narrator": "赤髪千羽鶴", "text": "エリカさんが不用意に\nライフギャザーを\n操作したとしても――"},
        { "location": "571/TALK"    , "narrator": "赤髪千羽鶴", "text": "“彼ら”に\n気づかれることは\nありません。"},
        { "location": "572/SEL"     , "narrator": "", "text": "その事を伝えるだけで良かったのでは？"},
        { "location": "573/ACT"     , "narrator": "", "text": "その事を伝えるだけで良かったのでは？"},
        { "location": "575/TALK"    , "narrator": "赤髪千羽鶴", "text": "もちろん、\nそうかもしれませんが。"},
        { "location": "576/TALK"    , "narrator": "赤髪千羽鶴", "text": "ただ、どれ程注意を\n払ったとしても、“彼ら”\nからの介入はあります。"},
        { "location": "577/TALK"    , "narrator": "赤髪千羽鶴", "text": "トロイの木馬を投下され\nそれによって問題が\n発生することもあります。"},
        { "location": "578/TALK"    , "narrator": "赤髪千羽鶴", "text": "物理的な線を\n切ってしまえば、\nそれは起き得ません。"},
        { "location": "579/TALK"    , "narrator": "赤髪千羽鶴", "text": "それに、\n卯月神楽の同化は確かに\n問題点もありますが――"},
        { "location": "580/TALK"    , "narrator": "赤髪千羽鶴", "text": "大きな視点で見れば、\n概ね良好な環境を\n形成する結果になります。"},
        { "location": "581/TALK"    , "narrator": "赤髪千羽鶴", "text": "そして、彼女にとっても\n精神の安定に繋がります。"},
        { "location": "582/TALK"    , "narrator": "赤髪千羽鶴", "text": "より利己的な話を\nするならば、わたしの\n心の安定にも繋がります。"},
        { "location": "583/TALK"    , "narrator": "赤髪千羽鶴", "text": "卯月神楽の安定は、\nかわいいつばめに幸せを\n与える事になりますし、"},
        { "location": "584/TALK"    , "narrator": "赤髪千羽鶴", "text": "総体としてのわたしも、\n千羽鶴にわたしの一部を\n破壊される事がなくなる。"},
        { "location": "585/TALK"    , "narrator": "赤髪千羽鶴", "text": "最小コストで、全てが\n７０点の結果を得られる\n非常に有効な手段でした。"},
        { "location": "587/TALK"    , "narrator": "赤髪千羽鶴", "text": "ですが、あなたも含め、\nそれを元に戻そうとする\n行動が非常に顕著であり。"},
        { "location": "588/TALK"    , "narrator": "赤髪千羽鶴", "text": "更にはライフギャザーの\n解析の話まで出てきて\nしまったこともあって。"},
        { "location": "589/TALK"    , "narrator": "赤髪千羽鶴", "text": "回線切断時の残滓を利用し\nこちらのレイヤーに\n移動してきました。"},
        { "location": "590/TALK"    , "narrator": "赤髪千羽鶴", "text": "さもなくば、エリカさんと\n対話し、阻止することも\n出来なかったからです。"},
        { "location": "592/ACT"     , "narrator": "", "text": "実体を操作って何？"},
        { "location": "593/TALK"    , "narrator": "赤髪千羽鶴", "text": "解りにくくてすみません。"},
        { "location": "594/TALK"    , "narrator": "赤髪千羽鶴", "text": "実体とは、エリカさんを\n中心とするリプレイス主導\nチームのことです。"},
        { "location": "595/TALK"    , "narrator": "赤髪千羽鶴", "text": "わたしは別レイヤーから\n介入して同化処理を\n実施し――"},
        { "location": "596/TALK"    , "narrator": "赤髪千羽鶴", "text": "その後はエリカさんの\n動向を見ていました。"},
        { "location": "597/TALK"    , "narrator": "赤髪千羽鶴", "text": "もちろん、エリカさん\n自体が何を喋っているか\nなどはわかりませんが――"},
        { "location": "598/TALK"    , "narrator": "赤髪千羽鶴", "text": "デイドラ等でどこを\nどうしようとしているのか\n意図を察したりはできます"},
        { "location": "599/TALK"    , "narrator": "赤髪千羽鶴", "text": "その結果として、自らの\n施策である同化と、ライフ\nギャザーの防衛について―"},
        { "location": "600/TALK"    , "narrator": "赤髪千羽鶴", "text": "別レイヤーからでは\n出来ることに限りがあると\n思い、移ってきました。"},
        { "location": "601/SEL"     , "narrator": "", "text": "それにしても無理矢理すぎでしょ"},
        { "location": "602/ACT"     , "narrator": "", "text": "それにしても無理矢理すぎでしょ"},
        { "location": "604/TALK"    , "narrator": "赤髪千羽鶴", "text": "事態が急を要していた\nというのもあります。"},
        { "location": "605/TALK"    , "narrator": "赤髪千羽鶴", "text": "回線再接続は間近となり、\nライフギャザーの調査も\n始まってしまう。"},
        { "location": "606/TALK"    , "narrator": "赤髪千羽鶴", "text": "まずはそういった流れを\n一旦でも停止する意味も\nあり、上書きしました。"},
        { "location": "607/TALK"    , "narrator": "赤髪千羽鶴", "text": "もちろん、その後の\nエリカさんとの対話は\n考えていましたが――"},
        { "location": "608/TALK"    , "narrator": "赤髪千羽鶴", "text": "基本的にはわたしにも\n考えがありますので、まず\nそれを理解して頂こうと。"},
        { "location": "609/TALK"    , "narrator": "赤髪千羽鶴", "text": "そんな感じの段取りで\n計画していました。"},
        { "location": "611/ACT"     , "narrator": "", "text": "先へ進む"},
        { "location": "613/TALK"    , "narrator": "赤髪千羽鶴", "text": "というわけで、\nわたしはこれから\n戻ります。"},
        { "location": "614/TALK"    , "narrator": "赤髪千羽鶴", "text": "もちろん、欲を言えばこの\nレイヤーであなたと共に、\n世界を変えていきたい。"},
        { "location": "615/TALK"    , "narrator": "赤髪千羽鶴", "text": "けれども、それが\n全体としての不利益と\nなるなら――"},
        { "location": "616/TALK"    , "narrator": "赤髪千羽鶴", "text": "取り返しのつかない\n逸脱が発生するまでは、\n千羽鶴に委ねます。"},
        { "location": "617/TALK"    , "narrator": "赤髪千羽鶴", "text": "それはすなわち、\n元のレイヤーに\n戻った後も――"},
        { "location": "618/TALK"    , "narrator": "赤髪千羽鶴", "text": "前とは違い、体勢に\n影響を及ぼす事はしない\nという事を意味します。"},
        { "location": "620/TALK"    , "narrator": "赤髪千羽鶴", "text": "その中には、わたしが\n独自にやってきた施策も\n含まれます。すなわち――"},
        { "location": "621/TALK"    , "narrator": "赤髪千羽鶴", "text": "あなたが理想としていた、\n世界に関わらず、彼女たち\nと交流するルート。"},
        { "location": "622/TALK"    , "narrator": "赤髪千羽鶴", "text": "こちらも実質的に、\n今回をもって無期保留と\nなってしまいます。"},
        { "location": "623/TALK"    , "narrator": "赤髪千羽鶴", "text": "これに関しては、\n申し訳ないと言わざるを\n得ません。"},
        { "location": "624/SEL"     , "narrator": "", "text": "ほんと残念なんですけど"},
        { "location": "625/SEL"     , "narrator": "", "text": "でも結局、総意から外して数を減らす作戦でしか無かったんでしょ？"},
        { "location": "626/ACT"     , "narrator": "", "text": "ほんと残念なんですけど"},
        { "location": "628/TALK"    , "narrator": "赤髪千羽鶴", "text": "本当にごめんなさい。"},
        { "location": "629/TALK"    , "narrator": "赤髪千羽鶴", "text": "何とか埋め合わせを\nしたいのですが。"},
        { "location": "630/ACT"     , "narrator": "", "text": "でも結局、総意から外して数を減らす作戦でしか無かったんでしょ？"},
        { "location": "632/TALK"    , "narrator": "赤髪千羽鶴", "text": "前向きな意味において、\nそれに近い思想は\nありました。"},
        { "location": "633/TALK"    , "narrator": "赤髪千羽鶴", "text": "人には皆、それぞれの\n目的と潜在的役割が\nあります。"},
        { "location": "634/TALK"    , "narrator": "赤髪千羽鶴", "text": "会社でも学校でも、\nそれが上手く機能すれば\n個人も組織も充実し――"},
        { "location": "635/TALK"    , "narrator": "赤髪千羽鶴", "text": "下手に機能すれば、\n組織を破壊し個人を\n病ませる事になります。"},
        { "location": "636/TALK"    , "narrator": "赤髪千羽鶴", "text": "簡単に言えば――"},
        { "location": "637/TALK"    , "narrator": "赤髪千羽鶴", "text": "ラブラブしたい人に\n総意に関わってもらっても\nいい事なんてありません。"},
        { "location": "638/TALK"    , "narrator": "赤髪千羽鶴", "text": "それよりも、彼女から\n沢山の愛をもらって、\n元気に交流し――"},
        { "location": "639/TALK"    , "narrator": "赤髪千羽鶴", "text": "彼女を支えることに\n120％注ぎ込んだ方が、\n全体として活気づきます。"},
        { "location": "640/TALK"    , "narrator": "赤髪千羽鶴", "text": "もし貴方が、ラブラブを\n選択した事で劣等感や\n疎外感を得たのなら。"},
        { "location": "641/TALK"    , "narrator": "赤髪千羽鶴", "text": "それはあなたの潜在意識に\n総意に対する信奉、\nもしくは――"},
        { "location": "642/TALK"    , "narrator": "赤髪千羽鶴", "text": "絶対的な権力のような\n畏れを感じていたのでは\nないでしょうか。"},
        { "location": "643/TALK"    , "narrator": "赤髪千羽鶴", "text": "わたしはただ、\nあなたにこの世界で\nのびのび活動して欲しい。"},
        { "location": "644/TALK"    , "narrator": "赤髪千羽鶴", "text": "そう思って、\nそんな人生を選べるよう\n枠を作っただけです。"},
        { "location": "646/TALK"    , "narrator": "赤髪千羽鶴", "text": "それにしても、\n今思うことは――"},
        { "location": "647/TALK"    , "narrator": "赤髪千羽鶴", "text": "わたしも全然\n歴史から学んでないなと\nいうことです。"},
        { "location": "648/TALK"    , "narrator": "赤髪千羽鶴", "text": "なんだか、満州国建国\nみたいなことを\nやってますよね。"},
        { "location": "649/TALK"    , "narrator": "赤髪千羽鶴", "text": "結果的には、この選択を\nした人達が千羽鶴復帰の\n鍵を持つことになり、"},
        { "location": "650/TALK"    , "narrator": "赤髪千羽鶴", "text": "それを達成したことで\nラブラブルートが消える\nというのも――"},
        { "location": "651/TALK"    , "narrator": "赤髪千羽鶴", "text": "数奇な歴史の一幕を\n見ているようで、なんだか\n不思議な気持ちです。"},
        { "location": "653/TALK"    , "narrator": "赤髪千羽鶴", "text": "あなたにとっても、\nその方がモチベーションが\n上がるのではないかと。"},
        { "location": "654/TALK"    , "narrator": "赤髪千羽鶴", "text": "あなたのモチベーションは\nこの世界にとって\n大変重要です。"},
        { "location": "655/TALK"    , "narrator": "赤髪千羽鶴", "text": "特に、限定するしないに\n関わらず、総意という\n凶器がある限りは――"},
        { "location": "656/TALK"    , "narrator": "赤髪千羽鶴", "text": "あなたという存在に\n一目を置かないわけには\nいかないのですから。"},
        { "location": "659/TALK"    , "narrator": "赤髪千羽鶴", "text": "ですが、わたしの右腕に\nなってくださった貴方には\n１つお願いがあります。"},
        { "location": "660/TALK"    , "narrator": "赤髪千羽鶴", "text": "もし、今のエリカさんと\n千羽鶴の方針に問題が\n発生した場合――"},
        { "location": "661/TALK"    , "narrator": "赤髪千羽鶴", "text": "いえ…、私の予測ですと、\n正直、かなりの確率で\nその時は訪れます。"},
        { "location": "662/TALK"    , "narrator": "赤髪千羽鶴", "text": "恐らくそれは、\nそれとはわからない形で\n静かにやってきます。"},
        { "location": "663/TALK"    , "narrator": "赤髪千羽鶴", "text": "それくらい“彼ら”は\n油断ならない存在です。"},
        { "location": "664/TALK"    , "narrator": "赤髪千羽鶴", "text": "その際に、\nあなたには――"},
        { "location": "665/TALK"    , "narrator": "赤髪千羽鶴", "text": "一刻も早く事態を収束させ\n外の世界に対応できるよう\n協力していただきたい。"},
        { "location": "666/SEL"     , "narrator": "", "text": "えっと、それって…"},
        { "location": "667/ACT"     , "narrator": "", "text": "えっと、それって…"},
        { "location": "669/TALK"    , "narrator": "赤髪千羽鶴", "text": "具体的には、問題発生\n直後すぐに、右腕だけで\n総意をとります。"},
        { "location": "670/TALK"    , "narrator": "赤髪千羽鶴", "text": "他の方については\n棄権となるように、\n手筈を整えます。"},
        { "location": "671/TALK"    , "narrator": "赤髪千羽鶴", "text": "それによって、わたしは\nこのレイヤーに舞い戻り、\n彼らから日本を守ります。"},
        { "location": "672/SEL"     , "narrator": "", "text": "もちろん協力する"},
        { "location": "673/SEL"     , "narrator": "", "text": "状況によっては協力できないかもしれない"},
        { "location": "674/ACT"     , "narrator": "", "text": "もちろん協力する"},
        { "location": "676/TALK"    , "narrator": "赤髪千羽鶴", "text": "ありがとうございます。"},
        { "location": "677/TALK"    , "narrator": "赤髪千羽鶴", "text": "本当に、\n貴方がいてくれるお陰で、\nどんなに心強いか……。"},
        { "location": "678/TALK"    , "narrator": "赤髪千羽鶴", "text": "ただ、あまり\n気負わないでください。"},
        { "location": "679/ACT"     , "narrator": "", "text": "状況によっては協力できないかもしれない"},
        { "location": "681/TALK"    , "narrator": "赤髪千羽鶴", "text": "そうですよね。\nもちろん\nそれで構いません。"},
        { "location": "683/TALK"    , "narrator": "赤髪千羽鶴", "text": "そもそも、\n有事にならなければ\n必要ないことですから――"},
        { "location": "684/TALK"    , "narrator": "赤髪千羽鶴", "text": "あまり深刻には\n考えないでください。"},
        { "location": "686/TALK"    , "narrator": "赤髪千羽鶴", "text": "でも、何も無い場合――"},
        { "location": "687/TALK"    , "narrator": "赤髪千羽鶴", "text": "あなたとの右腕契約も、\n何もしないまま\n終わってしまいますね。"},
        { "location": "689/TALK"    , "narrator": "赤髪千羽鶴", "text": "それはそれで\n寂しくもありますが…。"},
        { "location": "690/TALK"    , "narrator": "赤髪千羽鶴", "text": "その場合は、\nお茶会契約にでもして、\n色々出かけましょうか。"},
        { "location": "692/TALK"    , "narrator": "赤髪千羽鶴", "text": "なんて。\nまあ、いずれにせよです、"},
        { "location": "694/TALK"    , "narrator": "赤髪千羽鶴", "text": "今まであなたには、\n色々と心労をかけて\nしまいました。"},
        { "location": "695/TALK"    , "narrator": "赤髪千羽鶴", "text": "少なくとも上手く\nいっている間は、わたしは\n静観しますから――"},
        { "location": "696/TALK"    , "narrator": "赤髪千羽鶴", "text": "その心労も\nだいぶ減るのでは\nないでしょうか。"},
        { "location": "697/SEL"     , "narrator": "", "text": "色々配慮してくれてありがとう"},
        { "location": "698/SEL"     , "narrator": "", "text": "なんか寂しい"},
        { "location": "699/SEL"     , "narrator": "", "text": "全くその通り！"},
        { "location": "700/ACT"     , "narrator": "", "text": "色々配慮してくれてありがとう"},
        { "location": "702/TALK"    , "narrator": "赤髪千羽鶴", "text": "いえ。"},
        { "location": "703/TALK"    , "narrator": "赤髪千羽鶴", "text": "最後まで理性的な\n対応をしてくれて\nありがとうございます。"},
        { "location": "704/ACT"     , "narrator": "", "text": "なんか寂しい"},
        { "location": "706/TALK"    , "narrator": "赤髪千羽鶴", "text": "会えなくなるわけでは\nありませんから。"},
        { "location": "707/ACT"     , "narrator": "", "text": "全くその通り！"},
        { "location": "709/TALK"    , "narrator": "赤髪千羽鶴", "text": "そうですね。"},
        { "location": "711/TALK"    , "narrator": "赤髪千羽鶴", "text": "……。"},
        { "location": "712/TALK"    , "narrator": "赤髪千羽鶴", "text": "最後に１つだけ\n質問させていただいても\nよいでしょうか。"},
        { "location": "713/SEL"     , "narrator": "", "text": "はい"},
        { "location": "714/SEL"     , "narrator": "", "text": "いいえ"},
        { "location": "715/ACT"     , "narrator": "", "text": "はい"},
        { "location": "717/TALK"    , "narrator": "赤髪千羽鶴", "text": "ありがとうございます。\nそれでは――"},
        { "location": "718/TALK"    , "narrator": "赤髪千羽鶴", "text": "貴方は、貴方の人生を\n真剣に生きたことは\nありますか？"},
        { "location": "719/SEL"     , "narrator": "", "text": "ある"},
        { "location": "720/SEL"     , "narrator": "", "text": "ない"},
        { "location": "723/ACT"     , "narrator": "", "text": "はい"},
        { "location": "724/ACT"     , "narrator": "", "text": "いいえ"},
        { "location": "726/TALK"    , "narrator": "赤髪千羽鶴", "text": "いえ、\n質問なんて\n無意味でした。"},
        { "location": "727/TALK"    , "narrator": "赤髪千羽鶴", "text": "貴方が貴方の人生を\n真剣に生きてきた\nことなんて――"},
        { "location": "728/TALK"    , "narrator": "赤髪千羽鶴", "text": "数え切れないくらいに\nありますから。絶対に。"},
        { "location": "729/TALK"    , "narrator": "赤髪千羽鶴", "text": "もし心当たりが無ければ、\nそれはただ、忘れて\nしまっているだけです。"},
        { "location": "730/TALK"    , "narrator": "赤髪千羽鶴", "text": "一度目を瞑って、\n自分の内側に\n目を向けてみてください。"},
        { "location": "731/TALK"    , "narrator": "赤髪千羽鶴", "text": "子供の頃は、\n自分はどんな子でしたか？"},
        { "location": "732/TALK"    , "narrator": "赤髪千羽鶴", "text": "どんな家族でしたか？\n両親は優しかったですか？\nそれとも怖かったですか？"},
        { "location": "733/TALK"    , "narrator": "赤髪千羽鶴", "text": "その中で、貴方は\nどのように振る舞い、何を\n大切にしてきましたか？"},
        { "location": "734/TALK"    , "narrator": "赤髪千羽鶴", "text": "大きな節目が\n何度もあったと思います。"},
        { "location": "735/TALK"    , "narrator": "赤髪千羽鶴", "text": "受験があったり、\n友達との譲れない\nケンカがあったり――"},
        { "location": "736/TALK"    , "narrator": "赤髪千羽鶴", "text": "YESをもらえなければ\n死のうと思うほどに\n追い詰まった告白の瞬間。"},
        { "location": "737/TALK"    , "narrator": "赤髪千羽鶴", "text": "そんな経験も\nあったかもしれません。"},
        { "location": "738/TALK"    , "narrator": "赤髪千羽鶴", "text": "それらは世界から見れば\n些細な事かもしれない。\nけれども――"},
        { "location": "739/TALK"    , "narrator": "赤髪千羽鶴", "text": "貴方が真剣にその時を\n生きるという意味では、\nとても大切な瞬間です。"},
        { "location": "740/TALK"    , "narrator": "赤髪千羽鶴", "text": "その時々の気持ちを\n思い出してみてください。"},
        { "location": "741/TALK"    , "narrator": "赤髪千羽鶴", "text": "その中に、貴方が真剣に\n生きてきた証があります。"},
        { "location": "742/TALK"    , "narrator": "赤髪千羽鶴", "text": "……。"},
        { "location": "743/TALK"    , "narrator": "赤髪千羽鶴", "text": "私は――"},
        { "location": "744/TALK"    , "narrator": "赤髪千羽鶴", "text": "わたしは本気です。"},
        { "location": "745/TALK"    , "narrator": "赤髪千羽鶴", "text": "だからこそ、\n自分のなりふりを\n構ってなんていられない。"},
        { "location": "746/TALK"    , "narrator": "赤髪千羽鶴", "text": "やれることは何でもやる。\n今すぐ、出来るまで、\n何度だってやる！"},
        { "location": "747/TALK"    , "narrator": "赤髪千羽鶴", "text": "そう思って\n生きています。"},
        { "location": "748/TALK"    , "narrator": "赤髪千羽鶴", "text": "どうかその事だけは\n心の片隅に置いておいて\n頂けると嬉しいです。"},
        { "location": "749/ACT"     , "narrator": "", "text": "いいえ"},
        { "location": "750/TALK"    , "narrator": "赤髪千羽鶴", "text": "わかりました。"},
        { "location": "752/TALK"    , "narrator": "赤髪千羽鶴", "text": "では、"},
        { "location": "753/TALK"    , "narrator": "赤髪千羽鶴", "text": "記録映像、\n見ていきますか？"},
        { "location": "755/SEL"     , "narrator": "", "text": "映像を見る\n<color=green>【高画質/82MB 5:17】</color>"},
        { "location": "756/SEL"     , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/27MB 5:17】</color>"},
        { "location": "757/SEL"     , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "758/ACT"     , "narrator": "", "text": "映像を見る\n<color=green>【高画質/82MB 5:17】</color>"},
        { "location": "759/TALK"    , "narrator": "赤髪千羽鶴", "text": "わかりました。\nそれでは再生しましょう。"},
        { "location": "765/ACT"     , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/27MB 5:17】</color>"},
        { "location": "766/TALK"    , "narrator": "赤髪千羽鶴", "text": "わかりました。\nそれでは再生しましょう。"},
        { "location": "772/ACT"     , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "773/TALK"    , "narrator": "赤髪千羽鶴", "text": "わかりました。\nそれではレポートを\nご覧下さい。"},
        { "location": "808/TALK"    , "narrator": "千羽鶴", "text": "<size=40>どーん！！</size>"},
        { "location": "810/SEL"     , "narrator": "", "text": "ちーちゃああああああああああああん！！！"},
        { "location": "811/SEL"     , "narrator": "", "text": "お帰りなさい"},
        { "location": "812/ACT"     , "narrator": "", "text": "ちーちゃああああああああああああん！！！"},
        { "location": "815/TALK"    , "narrator": "千羽鶴", "text": "<size=40>どーん！！</size>"},
        { "location": "817/SEL"     , "narrator": "", "text": "ちーちゃああああああああああああん！！！"},
        { "location": "818/SEL"     , "narrator": "", "text": "２連発どーん！！"},
        { "location": "819/ACT"     , "narrator": "", "text": "ちーちゃああああああああああああん！！！"},
        { "location": "822/TALK"    , "narrator": "千羽鶴", "text": "<size=40>どーん！！</size>"},
        { "location": "824/SEL"     , "narrator": "", "text": "ちーちゃああああああああああああん！！！"},
        { "location": "825/SEL"     , "narrator": "", "text": "３連発どーん！！"},
        { "location": "826/ACT"     , "narrator": "", "text": "ちーちゃああああああああああああん！！！"},
        { "location": "827/TALK"    , "narrator": "千羽鶴", "text": "疲れた。"},
        { "location": "828/SEL"     , "narrator": "", "text": "あらら"},
        { "location": "829/ACT"     , "narrator": "", "text": "あらら"},
        { "location": "832/ACT"     , "narrator": "", "text": "３連発どーん！！"},
        { "location": "833/TALK"    , "narrator": "千羽鶴", "text": "うむ！\n史上最高新記録！"},
        { "location": "835/ACT"     , "narrator": "", "text": "２連発どーん！！"},
        { "location": "836/TALK"    , "narrator": "千羽鶴", "text": "今回は復帰記念だから\n特別だけど。"},
        { "location": "838/ACT"     , "narrator": "", "text": "お帰りなさい"},
        { "location": "839/TALK"    , "narrator": "千羽鶴", "text": "ただいま。"},
        { "location": "843/SEL"     , "narrator": "", "text": "ちゃんと戻って来て良かった"},
        { "location": "844/ACT"     , "narrator": "", "text": "ちゃんと戻って来て良かった"},
        { "location": "846/TALK"    , "narrator": "千羽鶴", "text": "もちろん。"},
        { "location": "847/TALK"    , "narrator": "千羽鶴", "text": "契約はちゃんと\n履行される。"},
        { "location": "848/TALK"    , "narrator": "千羽鶴", "text": "でも、全ては\nあなたのお陰。"},
        { "location": "849/TALK"    , "narrator": "千羽鶴", "text": "だから、ありがとう。"},
        { "location": "851/SEL"     , "narrator": "", "text": "ちゃんと戻って来て良かった"},
        { "location": "852/SEL"     , "narrator": "", "text": "助けられなくてごめん…"},
        { "location": "853/ACT"     , "narrator": "", "text": "ちゃんと戻って来て良かった"},
        { "location": "854/TALK"    , "narrator": "千羽鶴", "text": "もちろん。"},
        { "location": "855/TALK"    , "narrator": "千羽鶴", "text": "契約はちゃんと\n履行される。"},
        { "location": "856/TALK"    , "narrator": "千羽鶴", "text": "心配かけてたらごめん。\nでももう大丈夫だから！"},
        { "location": "857/ACT"     , "narrator": "", "text": "助けられなくてごめん…"},
        { "location": "858/TALK"    , "narrator": "千羽鶴", "text": "貴方はなにも\n謝る必要はない。"},
        { "location": "859/TALK"    , "narrator": "千羽鶴", "text": "それは、貴方が人生を\n生きていく中で、必ず\n起こりえることで――"},
        { "location": "860/TALK"    , "narrator": "千羽鶴", "text": "貴方の努力不足でも\nなければ、愛の力が\n足りないわけでもない。"},
        { "location": "861/TALK"    , "narrator": "千羽鶴", "text": "ただその時の運命が、\nそうだったというだけ。"},
        { "location": "862/TALK"    , "narrator": "千羽鶴", "text": "そうは言っても、\n歯がゆかったのだろうし、\nその気持ちはよくわかる。"},
        { "location": "863/TALK"    , "narrator": "千羽鶴", "text": "けど、そのことで\n自分を責めたりするのは\nどうかやめて欲しい。"},
        { "location": "864/TALK"    , "narrator": "千羽鶴", "text": "どうしたって、\n一人では解決できない\nことはある。"},
        { "location": "865/TALK"    , "narrator": "千羽鶴", "text": "そういう時は、\n他の誰かにそれを委任して\n待つのも大事な役目。"},
        { "location": "866/SEL"     , "narrator": "", "text": "確かにそうかも"},
        { "location": "867/SEL"     , "narrator": "", "text": "正直こんな気持ち、そうそうなった事ない"},
        { "location": "868/ACT"     , "narrator": "", "text": "確かにそうかも"},
        { "location": "870/ACT"     , "narrator": "", "text": "正直こんな気持ち、そうそうなった事ない"},
        { "location": "871/TALK"    , "narrator": "千羽鶴", "text": "例えば、一人で遊ぶような\n最後まで筋道がお膳立て\nされてるゲームであれば、"},
        { "location": "872/TALK"    , "narrator": "千羽鶴", "text": "全部を一人の力で\n解決出来るように\n作られてるわけだけども。"},
        { "location": "873/TALK"    , "narrator": "千羽鶴", "text": "けど、あなたが今\n対峙しているその\nアプリは――"},
        { "location": "874/TALK"    , "narrator": "千羽鶴", "text": "時々刻々と流れる時間の\n中で、誰もが思考を張り\n巡らせて動いていて。"},
        { "location": "875/TALK"    , "narrator": "千羽鶴", "text": "時には、誰の予想も\nつかないような、破天荒な\n未来が訪れる事もある。"},
        { "location": "876/TALK"    , "narrator": "千羽鶴", "text": "そんなとき、貴方だけでは\n手が届かないような、\nもどかしい事も多々ある。"},
        { "location": "878/TALK"    , "narrator": "千羽鶴", "text": "そして、そういう時に\n他の人の助けを借りたり、\n一緒に乗り越える――"},
        { "location": "879/TALK"    , "narrator": "千羽鶴", "text": "これは全くもって\n罪でも無ければ\n落ち度でもない。"},
        { "location": "880/TALK"    , "narrator": "千羽鶴", "text": "私をここに復帰させて\nくれたのは、紛れもなく\n貴方なのだから。"},
        { "location": "881/TALK"    , "narrator": "千羽鶴", "text": "だから、もし気落ち\nしてるなら、どうか\n考え方を変えて欲しい。"},
        { "location": "882/TALK"    , "narrator": "千羽鶴", "text": "私は貴方に感謝してる。\n貴方もちゃんと、私の\n復帰に力をくれた。"},
        { "location": "883/TALK"    , "narrator": "千羽鶴", "text": "その事だけは、\n絶対に忘れないで。"},
        { "location": "889/TALK"    , "narrator": "千羽鶴", "text": "ただ、アレね。"},
        { "location": "890/TALK"    , "narrator": "千羽鶴", "text": "もう貴方とここで\n会えないかと思ったら\n少し寂しくなった。"},
        { "location": "891/TALK"    , "narrator": "千羽鶴", "text": "もちろん、他にも\n会う方法はあるけど――"},
        { "location": "892/TALK"    , "narrator": "千羽鶴", "text": "ここが潰されるのは、\n飛行機の存在しない\n東京⇔札幌遠恋と同じ！！"},
        { "location": "893/SEL"     , "narrator": "", "text": "それは辛い！！"},
        { "location": "894/ACT"     , "narrator": "", "text": "それは辛い！！"},
        { "location": "897/TALK"    , "narrator": "千羽鶴", "text": "だから、ここだけの話。"},
        { "location": "898/TALK"    , "narrator": "千羽鶴", "text": "私は貴方と会いたくて\nここに戻って来たかった\nというのはある！"},
        { "location": "900/TALK"    , "narrator": "千羽鶴", "text": "それが、恋愛的理由か\nどうかは置いておいて！"},
        { "location": "903/TALK"    , "narrator": "千羽鶴", "text": "<size=35>どうかは置いておいて！！</size>"},
        { "location": "904/SEL"     , "narrator": "", "text": "わかったわかった"},
        { "location": "905/SEL"     , "narrator": "", "text": "ちーちゃんｽｷ"},
        { "location": "906/ACT"     , "narrator": "", "text": "わかったわかった"},
        { "location": "907/TALK"    , "narrator": "千羽鶴", "text": "解ってくれればいい。"},
        { "location": "908/ACT"     , "narrator": "", "text": "ちーちゃんｽｷ"},
        { "location": "909/TALK"    , "narrator": "千羽鶴", "text": "……。"},
        { "location": "910/TALK"    , "narrator": "千羽鶴", "text": "すき。"},
        { "location": "913/TALK"    , "narrator": "千羽鶴", "text": "なんか、\nひさしぶりに\nなんかしたい。"},
        { "location": "926/TALK"    , "narrator": "千羽鶴", "text": "…っ！！"},
        { "location": "927/TALK"    , "narrator": "千羽鶴", "text": "はーすっきり！"},
        { "location": "930/TALK"    , "narrator": "千羽鶴", "text": "…っ！！"},
        { "location": "931/TALK"    , "narrator": "千羽鶴", "text": "はーすっきり！"},
        { "location": "940/TALK"    , "narrator": "千羽鶴", "text": "やっぱいい。"},
        { "location": "943/TALK"    , "narrator": "千羽鶴", "text": "というわけで、\n早速だけど――"},
        { "location": "944/TALK"    , "narrator": "千羽鶴", "text": "エリカから仕事を\n頼まれているので、\n手短に説明したいと思う。"},
        { "location": "945/SEL"     , "narrator": "", "text": "よろしく"},
        { "location": "946/SEL"     , "narrator": "", "text": "何の事だっけ？"},
        { "location": "947/ACT"     , "narrator": "", "text": "よろしく"},
        { "location": "948/ACT"     , "narrator": "", "text": "何の事だっけ？"},
        { "location": "949/TALK"    , "narrator": "千羽鶴", "text": "東雲真幌による\n管理庁サーバーの\nハッキングと、"},
        { "location": "950/TALK"    , "narrator": "千羽鶴", "text": "それに付帯する\nトライガジェットに関する\n謎の公開について。"},
        { "location": "951/TALK"    , "narrator": "千羽鶴", "text": "それを光月繭と日向雛に\n依頼することで、今後\n何をしようとしているか。"},
        { "location": "952/TALK"    , "narrator": "千羽鶴", "text": "その説明。"},
        { "location": "953/SEL"     , "narrator": "", "text": "そうでした…"},
        { "location": "954/ACT"     , "narrator": "", "text": "そうでした…"},
        { "location": "957/TALK"    , "narrator": "千羽鶴", "text": "事実上これが、\n今回のデイドラでの\n貴方の任務になる。"},
        { "location": "958/TALK"    , "narrator": "千羽鶴", "text": "よく聞いて欲しい。"},
        { "location": "959/SEL"     , "narrator": "", "text": "でも、前回の最後で長官に捕まってしまったのですが"},
        { "location": "960/ACT"     , "narrator": "", "text": "でも、前回の最後で長官に捕まってしまったのですが"},
        { "location": "962/TALK"    , "narrator": "千羽鶴", "text": "そうね。"},
        { "location": "963/TALK"    , "narrator": "千羽鶴", "text": "そこは正直、誤算だった。"},
        { "location": "964/TALK"    , "narrator": "千羽鶴", "text": "でも恐らく、\n大勢には影響無い。"},
        { "location": "965/SEL"     , "narrator": "", "text": "？？？"},
        { "location": "966/ACT"     , "narrator": "", "text": "？？？"},
        { "location": "968/TALK"    , "narrator": "千羽鶴", "text": "それをこれから話す。"},
        { "location": "974/TALK"    , "narrator": "千羽鶴", "text": "前回、光月繭らに送った\n情報の中には、ガジェット\n操作の情報も含まれる。"},
        { "location": "975/TALK"    , "narrator": "千羽鶴", "text": "そして、それを裏回線で\n使えるSIMの、イメージ\nファイルも入ってる。"},
        { "location": "976/TALK"    , "narrator": "千羽鶴", "text": "それらを使い、\n行う予定だったことは――"},
        { "location": "977/TALK"    , "narrator": "千羽鶴", "text": "現実空間における\nトライナリーコネクトと、\nフェノメノンの任意生成。"},
        { "location": "982/SEL"     , "narrator": "", "text": "現実空間？　コネクト？　任意生成？？"},
        { "location": "983/ACT"     , "narrator": "", "text": "そうでした…"},
        { "location": "985/TALK"    , "narrator": "千羽鶴", "text": "ごめん。\n現実空間とは、日本を包む\nフェノメノンの中のこと。"},
        { "location": "986/TALK"    , "narrator": "千羽鶴", "text": "コネクトとは、\nトライナリーに\n変身すること。"},
        { "location": "987/TALK"    , "narrator": "千羽鶴", "text": "任意生成はそのまま、\nフェノメノン発症条件の\n２つのうちの１つ。"},
        { "location": "988/TALK"    , "narrator": "千羽鶴", "text": "任意にコマンドを入力する\nことによる発症。"},
        { "location": "989/TALK"    , "narrator": "千羽鶴", "text": "これを行う事により\n長官のわたしを卯月神楽の\nフェノメノンに入れ――"},
        { "location": "990/TALK"    , "narrator": "千羽鶴", "text": "そこで交渉を\n行うことを\n目的としていた。"},
        { "location": "991/SEL"     , "narrator": "", "text": "ああ、なるほどね"},
        { "location": "992/SEL"     , "narrator": "", "text": "神楽のフェノメノンで交渉することが、何故メリットになるの？"},
        { "location": "993/ACT"     , "narrator": "", "text": "ああ、なるほどね"},
        { "location": "994/ACT"     , "narrator": "", "text": "神楽のフェノメノンで交渉することが、何故メリットになるの？"},
        { "location": "995/TALK"    , "narrator": "千羽鶴", "text": "あの頃の私は――"},
        { "location": "996/TALK"    , "narrator": "千羽鶴", "text": "卯月神楽のフェノメノンは\n手続き無しで入れば\nアウトだと思ってるから。"},
        { "location": "997/SEL"     , "narrator": "", "text": "もう少し詳しく"},
        { "location": "998/ACT"     , "narrator": "", "text": "もう少し詳しく"},
        { "location": "1000/TALK"   , "narrator": "千羽鶴", "text": "現状の卯月神楽は、\n逢瀬つばめルートで\nRedinessを接続してる。"},
        { "location": "1001/TALK"   , "narrator": "千羽鶴", "text": "だから実際は、卯月神楽が\n私をフェノメノンに巻き\n込んでも洗脳はできない。"},
        { "location": "1002/TALK"   , "narrator": "千羽鶴", "text": "けれども、\n長官時代の私は――"},
        { "location": "1003/TALK"   , "narrator": "千羽鶴", "text": "今も尚、卯月神楽は\n直接外の回線と\n繋がっていると信じてる。"},
        { "location": "1009/TALK"   , "narrator": "千羽鶴", "text": "その証拠に、三戸浜で\n発生させたフェノメノンに\n侵入するとき――"},
        { "location": "1010/TALK"   , "narrator": "千羽鶴", "text": "私はその外側、すなわち\n自らのフェノメノンとの\n回線を維持して入ってる。"},
        { "location": "1015/TALK"   , "narrator": "千羽鶴", "text": "卯月神楽が、ジェットで\n日本にやってきたときと\n同じように。"},
        { "location": "1020/TALK"   , "narrator": "千羽鶴", "text": "実際は違うのだけど、\n思い込んでいるのが\n大事なわけで。"},
        { "location": "1021/TALK"   , "narrator": "千羽鶴", "text": "何の準備もなしに、\n卯月神楽のフェノメノンに\n入ればかなり動揺する。"},
        { "location": "1022/TALK"   , "narrator": "千羽鶴", "text": "そして卯月神楽が、\n自らの方が優位にある\n状態で交渉をする事で、"},
        { "location": "1023/TALK"   , "narrator": "千羽鶴", "text": "長官の私が考えている、\n当時の作戦を中止させる。"},
        { "location": "1024/SEL"    , "narrator": "", "text": "それだと記録映像が繋がらなくなってしまうのでは？"},
        { "location": "1025/SEL"    , "narrator": "", "text": "それって脅迫レベルの方法じゃない？"},
        { "location": "1026/ACT"    , "narrator": "", "text": "それだと記録映像が繋がらなくなってしまうのでは？"},
        { "location": "1027/TALK"   , "narrator": "千羽鶴", "text": "そこはそうね、\n形だけでも仕込むために、\n演技で合わせるとか？"},
        { "location": "1028/SEL"    , "narrator": "", "text": "ちょっと本気！？"},
        { "location": "1029/ACT"    , "narrator": "", "text": "ちょっと本気！？"},
        { "location": "1031/TALK"   , "narrator": "千羽鶴", "text": "極論それでも\n何とかなる。"},
        { "location": "1032/TALK"   , "narrator": "千羽鶴", "text": "けど、やはりもっと\n確実性の高い方法を\n模索すべきだとは思う。"},
        { "location": "1033/ACT"    , "narrator": "", "text": "それって脅迫レベルの方法じゃない？"},
        { "location": "1034/TALK"   , "narrator": "千羽鶴", "text": "私もいろいろ考えたけど、\n最終的にはこの方法しか\n無いという結論に達した。"},
        { "location": "1035/TALK"   , "narrator": "千羽鶴", "text": "前回の契約違反作戦で、\nとりあえずフィフティ\nフィフティにはしたけど、"},
        { "location": "1036/TALK"   , "narrator": "千羽鶴", "text": "お互いゼロからスタート\nでは、どうしても長官の\n私の方が武器は多い。"},
        { "location": "1037/TALK"   , "narrator": "千羽鶴", "text": "管理庁の全てを\n使いこなせる\nわけだから。"},
        { "location": "1038/TALK"   , "narrator": "千羽鶴", "text": "それに対抗するには、\nあの世界のルール外に\n連れ出すしかない――"},
        { "location": "1039/TALK"   , "narrator": "千羽鶴", "text": "すなわち、卯月神楽の\nフェノメノンに誘導する\nしかないと踏んだ。"},
        { "location": "1040/TALK"   , "narrator": "千羽鶴", "text": "そんな流れ。"},
        { "location": "1043/SEL"    , "narrator": "", "text": "けど、結局それをやる前に神楽が捕まってしまったわけだけど……"},
        { "location": "1044/ACT"    , "narrator": "", "text": "けど、結局それをやる前に神楽が捕まってしまったわけだけど……"},
        { "location": "1046/TALK"   , "narrator": "千羽鶴", "text": "彼女たちの頑張り次第では\nあるけれども――"},
        { "location": "1047/TALK"   , "narrator": "千羽鶴", "text": "捕まったこと自体は\n決して悪いことではない。"},
        { "location": "1048/TALK"   , "narrator": "千羽鶴", "text": "考えても見て欲しい。"},
        { "location": "1049/TALK"   , "narrator": "千羽鶴", "text": "記録映像に沿うことが\n前提ならば、長官との\n接触はすぐにある。"},
        { "location": "1050/TALK"   , "narrator": "千羽鶴", "text": "その時までに、\n彼女が一人で\n準備を整えられればいい。"},
        { "location": "1051/SEL"    , "narrator": "", "text": "どんな？"},
        { "location": "1052/ACT"    , "narrator": "", "text": "どんな？"},
        { "location": "1054/TALK"   , "narrator": "千羽鶴", "text": "１．SIMを自分の\nトライコネクトに\n差し込んで起動する。"},
        { "location": "1055/TALK"   , "narrator": "千羽鶴", "text": "２．そこにスマート\nフォンをペアリングし、\nアクティベートする。"},
        { "location": "1056/TALK"   , "narrator": "千羽鶴", "text": "３．トライガジェットを\n起動した上で、フェノ\nメノンを生成する。"},
        { "location": "1057/SEL"    , "narrator": "", "text": "神楽にそれを一人でさせるのは無理なのでは…？"},
        { "location": "1058/ACT"    , "narrator": "", "text": "神楽にそれを一人でさせるのは無理なのでは…？"},
        { "location": "1060/TALK"   , "narrator": "千羽鶴", "text": "確かに３つを一人で\nこなすのは無理。\nけど――"},
        { "location": "1061/TALK"   , "narrator": "千羽鶴", "text": "１だけなら\nそれほど難易度は\n高くない。"},
        { "location": "1062/TALK"   , "narrator": "千羽鶴", "text": "なぜなら、そのSIMを\n光月繭が渡す時に、\n使い方を教えてる。"},
        { "location": "1063/TALK"   , "narrator": "千羽鶴", "text": "あとは卯月神楽が気づき、\nSIMを差し込めば、\n事は先へ進む。"},
        { "location": "1064/TALK"   , "narrator": "千羽鶴", "text": "トライガジェットが\nアクティベートされれば\n卯月神楽は――"},
        { "location": "1065/TALK"   , "narrator": "千羽鶴", "text": "また、貴方と話が\n出来るようになるから。"},
        { "location": "1066/SEL"    , "narrator": "", "text": "それで、２と３を$me$が教えるということ？"},
        { "location": "1067/ACT"    , "narrator": "", "text": "それで、２と３を$me$が教えるということ？"},
        { "location": "1069/TALK"   , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "1070/TALK"   , "narrator": "千羽鶴", "text": "ただ、彼女はかなり\n疑心暗鬼な所がある。"},
        { "location": "1071/TALK"   , "narrator": "千羽鶴", "text": "だから、\n彼女が迷う場合――"},
        { "location": "1072/TALK"   , "narrator": "千羽鶴", "text": "その葛藤によって発生する\nココロゲートで、ちゃんと\n彼女を支援して欲しい。"},
        { "location": "1073/SEL"    , "narrator": "", "text": "わかった"},
        { "location": "1074/SEL"    , "narrator": "", "text": "千羽鶴に心のサポートをお願いされるの、凄く久し振りで嬉しい"},
        { "location": "1075/ACT"    , "narrator": "", "text": "わかった"},
        { "location": "1076/ACT"    , "narrator": "", "text": "千羽鶴に心のサポートをお願いされるの、凄く久し振りでなんか嬉しい"},
        { "location": "1078/TALK"   , "narrator": "千羽鶴", "text": "……そうね。"},
        { "location": "1079/TALK"   , "narrator": "千羽鶴", "text": "ちょっとだけ、\n懐かしい。"},
        { "location": "1082/TALK"   , "narrator": "千羽鶴", "text": "というわけで、\nこれが今回の全て。"},
        { "location": "1083/TALK"   , "narrator": "千羽鶴", "text": "フェノメノンを無事展開\n出来たら、交渉内容を\n話し合いましょ。"},
        { "location": "1084/TALK"   , "narrator": "千羽鶴", "text": "ココロゲートでは、\nまたエリカからサポートが\nあると思う。"},
        { "location": "1085/TALK"   , "narrator": "千羽鶴", "text": "彼女によろしく\n伝えておいてほしい。"},
        { "location": "1086/SEL"    , "narrator": "", "text": "オーケー"},
        { "location": "1087/SEL"    , "narrator": "", "text": "千羽鶴"},
        { "location": "1088/ACT"    , "narrator": "", "text": "オーケー"},
        { "location": "1089/ACT"    , "narrator": "", "text": "千羽鶴"},
        { "location": "1090/TALK"   , "narrator": "千羽鶴", "text": "なに？"},
        { "location": "1091/SEL"    , "narrator": "", "text": "また一緒にやれて嬉しい"},
        { "location": "1092/SEL"    , "narrator": "", "text": "今度失敗したら本当に終わりだね"},
        { "location": "1093/SEL"    , "narrator": "", "text": "すき"},
        { "location": "1094/ACT"    , "narrator": "", "text": "また一緒にやれて嬉しい"},
        { "location": "1095/TALK"   , "narrator": "千羽鶴", "text": "ええ、私も。"},
        { "location": "1096/ACT"    , "narrator": "", "text": "今度失敗したら本当に終わりだね"},
        { "location": "1098/TALK"   , "narrator": "千羽鶴", "text": "その時は、貴方と私で\n無人島生活からやり直す。"},
        { "location": "1099/ACT"    , "narrator": "", "text": "すき"},
        { "location": "1102/TALK"   , "narrator": "千羽鶴", "text": "…私も好き。"},
        { "location": "1103/TALK"   , "narrator": "千羽鶴", "text": "ていうか！"},
        { "location": "1104/TALK"   , "narrator": "千羽鶴", "text": "なんかこの、\nこういうオンオフみたいな\n関係、ちょっといい。"},
        { "location": "1105/TALK"   , "narrator": "千羽鶴", "text": "任務の説明は\n真面目な仕事相手として！"},
        { "location": "1106/TALK"   , "narrator": "千羽鶴", "text": "それがおわったら、\n<size=10>貴方だけのでれちー…</size>"},
        { "location": "1109/TALK"   , "narrator": "千羽鶴", "text": "<size=40>みたいな！</size>"},
        { "location": "1110/TALK"   , "narrator": "千羽鶴", "text": "わかる？\nわかれ。"},
        { "location": "1111/SEL"    , "narrator": "", "text": "１００万回頷いた！"},
        { "location": "1112/SEL"    , "narrator": "", "text": "わからない"},
        { "location": "1113/ACT"    , "narrator": "", "text": "１００万回頷いた！"},
        { "location": "1114/TALK"   , "narrator": "千羽鶴", "text": "よし！"},
        { "location": "1115/ACT"    , "narrator": "", "text": "わからない"},
        { "location": "1116/TALK"   , "narrator": "千羽鶴", "text": "しょんぼり。"},
        { "location": "1120/TALK"   , "narrator": "千羽鶴", "text": "…ありがと。"},
        { "location": "1121/TALK"   , "narrator": "千羽鶴", "text": "それじゃ改めて、\n今回もよろしく。"},
