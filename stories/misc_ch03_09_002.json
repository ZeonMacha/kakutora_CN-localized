        { "location": "179/TALK"    , "narrator": "ガブリエラ", "text": "あげたっていうか"},
        { "location": "180/TALK"    , "narrator": "ガブリエラ", "text": "与えたのよ"},
        { "location": "183/SEL"     , "narrator": "", "text": "優しいんだね"},
        { "location": "184/SEL"     , "narrator": "", "text": "ガブの気持ち、伝わってるよ"},
