{
    "dir": "chap00/daydra/spev_ch04_012.js",
    "type": "",
    "info": {
        "story_id": "4012",
        "cid": "",
        "title": "スペシャルエピソード",
        "sub_title": "悪魔の誘惑"
    },
    "entry":
    [
        { "location": "22/TALK" , "narrator": "透明みやび", "text": "ほれほれ、相棒。\n怖くないき、\nこっち来ぃ。"},
        { "location": "23/TALK" , "narrator": "透明みやび", "text": "今ならうちのこと、\n好き放題してもえいぞ～。"},
        { "location": "25/SEL"  , "narrator": "（選択肢）", "text": "本当に？"},
        { "location": "26/SEL"  , "narrator": "（選択肢）", "text": "逆に何かするでしょ？"},
        { "location": "27/ACT"  , "narrator": "", "text": "本当に？"},
        { "location": "28/TALK" , "narrator": "透明みやび", "text": "もちろんや。\n触り放題撫で放題、\nついでに吸い放題やぞ。"},
        { "location": "29/TALK" , "narrator": "透明みやび", "text": "…それはうちにも\n言えることやけんど。"},
        { "location": "30/ACT"  , "narrator": "", "text": "逆に何かするでしょ？"},
        { "location": "33/TALK" , "narrator": "透明みやび", "text": "バカを言うな！"},
        { "location": "34/TALK" , "narrator": "透明みやび", "text": "世の中、一方だけが\n得するゆう上手い話、\nあるわけないやろ？"},
        { "location": "35/TALK" , "narrator": "透明みやび", "text": "当然、ちくっと\n吸わせてもらうぞね。"},
        { "location": "38/TALK" , "narrator": "透明みやび", "text": "まあ、死にはせん。"},
        { "location": "39/TALK" , "narrator": "透明みやび", "text": "それに、首元に牙の痕が\n残りはするけんど…。"},
        { "location": "40/TALK" , "narrator": "透明みやび", "text": "女に噛まれて吸われた\n勲章や思えば、\n誇らしいと思わんか？"},
        { "location": "41/SEL"  , "narrator": "（選択肢）", "text": "言われてみれば確かに"},
        { "location": "42/SEL"  , "narrator": "（選択肢）", "text": "そういうもんなの？"},
        { "location": "43/ACT"  , "narrator": "", "text": "言われてみれば確かに"},
        { "location": "46/TALK" , "narrator": "透明みやび", "text": "理解が早くて素晴らしい。\nさすが、うちの自慢の\n相棒や。"},
        { "location": "47/TALK" , "narrator": "透明みやび", "text": "イケメンな性格に\n思わず顔が赤くなって\nしまい…。"},
        { "location": "48/TALK" , "narrator": "透明みやび", "text": "ついでに赤い血が\n更に欲しくなってきた\nがよ。"},
        { "location": "49/ACT"  , "narrator": "", "text": "そういうもんなの？"},
        { "location": "51/TALK" , "narrator": "透明みやび", "text": "そりゃそうやろ。"},
        { "location": "52/TALK" , "narrator": "透明みやび", "text": "そんな傷つけた状態で\n街中歩いてみぃ。"},
        { "location": "53/TALK" , "narrator": "透明みやび", "text": "おっ、あいつなかなか\nやりよるなぁ…。"},
        { "location": "54/TALK" , "narrator": "透明みやび", "text": "っちゅう感じで、\n視線釘付け\n間違いなしぞね。"},
        { "location": "57/TALK" , "narrator": "透明みやび", "text": "それに、さっきから\n言うちょるけんど…。"},
        { "location": "58/TALK" , "narrator": "透明みやび", "text": "ロハでくれ言うちょる\nわけやない。"},
        { "location": "59/TALK" , "narrator": "透明みやび", "text": "うちが吸うてる間、\nうちを好きにしてえい\nっちゅう…。"},
        { "location": "60/TALK" , "narrator": "透明みやび", "text": "持ってけ泥棒大安売り\n条件やぞ？"},
        { "location": "61/TALK" , "narrator": "透明みやび", "text": "うちには邪魔くさいだけの\nものやけんど…。"},
        { "location": "63/TALK" , "narrator": "透明みやび", "text": "ほれ、この無駄にでかい\nだけの胸とか、\n興味を引かれんか？"},
        { "location": "64/SEL"  , "narrator": "（選択肢）", "text": "そりゃ、引かれるけど…"},
        { "location": "65/SEL"  , "narrator": "（選択肢）", "text": "う～ん…"},
        { "location": "66/ACT"  , "narrator": "", "text": "そりゃ、引かれるけど…"},
        { "location": "68/TALK" , "narrator": "透明みやび", "text": "ならここは一つ\n勇気を出して…。"},
        { "location": "69/ACT"  , "narrator": "", "text": "う～ん…"},
        { "location": "70/TALK" , "narrator": "透明みやび", "text": "なんと…相棒はもっと\nツルッとすべすべ\nぺったんこが好みか？"},
        { "location": "71/TALK" , "narrator": "透明みやび", "text": "ふむ…そうなると\nうちとは正反対っちゅう\nことになるな…。"},
        { "location": "73/TALK" , "narrator": "透明みやび", "text": "いや、好き嫌いはいかん！\n自分の好みだけで考えては\nろくなことにならんぞね。"},
        { "location": "75/TALK" , "narrator": "透明みやび", "text": "ほれ、お互い損する\nことはないんやき、\nささっと済ますがよ。"},
        { "location": "76/SEL"  , "narrator": "（選択肢）", "text": "そ、それじゃあ…"},
        { "location": "77/ACT"  , "narrator": "", "text": "そ、それじゃあ…"},
        { "location": "81/TALK" , "narrator": "透明みやび", "text": "…交渉成立やね。"},
        { "location": "82/TALK" , "narrator": "透明みやび", "text": "じゃあ、お互い\n甘い一時を楽しむと\nするぞね。"},
        { "location": "83/TALK" , "narrator": "透明みやび", "text": "ふふっ…。"},
        { "location": "85/TALK" , "narrator": "透明みやび", "text": "…ん？"},
        { "location": "86/TALK" , "narrator": "透明みやび", "text": "いや、ちくっと待ちぃ。\nストップや。"},
        { "location": "87/SEL"  , "narrator": "（選択肢）", "text": "ここでお預けか！？"},
        { "location": "88/ACT"  , "narrator": "", "text": "ここでお預けか！？"},
        { "location": "90/TALK" , "narrator": "透明みやび", "text": "いや…考えてみたらうち、\nまだ皮膚から直接血を\n飲んだことなかったちや。"},
        { "location": "91/TALK" , "narrator": "透明みやび", "text": "やき、こうしてじっくり\n人間の皮膚っちゅうのを\n見ると…。"},
        { "location": "92/TALK" , "narrator": "透明みやび", "text": "…なんや、堅そうで\n直接吸うのめっちゃ\n億劫そうやな…。"},
        { "location": "94/TALK" , "narrator": "透明みやび", "text": "はぁ…注射器で\nちゅちゅっと吸って\n飲むか…。"},
        { "location": "95/SEL"  , "narrator": "（選択肢）", "text": "注射！？　イヤだよ！！"},
        { "location": "96/ACT"  , "narrator": "", "text": "注射！？　イヤだよ！！"},
        { "location": "98/TALK" , "narrator": "透明みやび", "text": "注射針の方が\n歯より細いき、\n痛くなかろうに…。"},
        { "location": "100/TALK", "narrator": "透明みやび", "text": "じゃあ、注射じゃなくて\nえいき、相棒が自分で\n血を出すぞね。"},
        { "location": "101/TALK", "narrator": "透明みやび", "text": "それならうちも\n労力使わずグビグビ\n飲めてラクやし。"},
        { "location": "102/SEL" , "narrator": "（選択肢）", "text": "じゃあ、包丁で手首を…"},
        { "location": "103/SEL" , "narrator": "（選択肢）", "text": "却下だよ！！"},
        { "location": "104/ACT" , "narrator": "", "text": "じゃあ、包丁で手首を…"},
        { "location": "106/TALK", "narrator": "透明みやび", "text": "誰が死ねとまで言うた！？"},
        { "location": "107/TALK", "narrator": "透明みやび", "text": "相棒はその名の通り\nうちの相棒なんやぞ？"},
        { "location": "108/TALK", "narrator": "透明みやび", "text": "命を大切にしてもらえんと\n困るぞね。"},
        { "location": "109/ACT" , "narrator": "", "text": "却下だよ！！"},
        { "location": "111/TALK", "narrator": "透明みやび", "text": "しょんぼりすることを\n平然と言いよったな？"},
        { "location": "112/TALK", "narrator": "透明みやび", "text": "まったく…ちくっと\n血を流すくらいで\n大袈裟な…。"},
        { "location": "115/TALK", "narrator": "透明みやび", "text": "…まあ、この格好で\nしばらく色仕掛けを\n続けちょれば…。"},
        { "location": "116/TALK", "narrator": "透明みやび", "text": "そのうち、相棒の鼻から\n血がブッシューするかも\nしれん。"},
        { "location": "118/TALK", "narrator": "透明みやび", "text": "それを楽しみに\n待つとするぞね。"},
        { "location": "119/SEL" , "narrator": "（選択肢）", "text": "多分出ないけどね"},
        { "location": "120/ACT" , "narrator": "", "text": "多分出ないけどね"},
        { "location": "122/TALK", "narrator": "透明みやび", "text": "やってみんことには\nわからんがよ。"},
        { "location": "123/TALK", "narrator": "透明みやび", "text": "ちゅーわけやき、\nふふふ…。"},
        { "location": "126/TALK", "narrator": "透明みやび", "text": "…ほれ、これでどうや？"},
        { "location": "131/TALK", "narrator": "透明みやび", "text": "うわわわっ！？\nしまった、\n刺激が強過ぎたーっ！！"}
    ]
}
