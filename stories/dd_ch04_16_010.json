{
    "dir": "chap16/daydra/dd_ch04_16_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "16452",
        "cid": "miyabi",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "新しい美容院"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "新しい美容院"},
        { "location": "28/TALK"   , "narrator": "雛", "text": "あっ、しまった！\n美容院の予約入れるの\n忘れてた！"},
        { "location": "31/TALK"   , "narrator": "キリト", "text": "ふ～ん、美容院って\n予約するもんなのか。"},
        { "location": "34/TALK"   , "narrator": "雛", "text": "基本的にはそうだよ。"},
        { "location": "35/TALK"   , "narrator": "雛", "text": "特に今回は、新しくできる\nところに行こうと思ってる\nから――"},
        { "location": "36/TALK"   , "narrator": "雛", "text": "飛び込みで行っても、\n受け付けてもらえないと\n思うし。"},
        { "location": "39/TALK"   , "narrator": "つばめ", "text": "新しい美容院ができるの？"},
        { "location": "42/TALK"   , "narrator": "雛", "text": "うん、来週からだけど、\n予約はもう始まってるよ。"},
        { "location": "45/TALK"   , "narrator": "つばめ", "text": "それなら、わたしも\n予約しようかな？"},
        { "location": "46/TALK"   , "narrator": "つばめ", "text": "東京に来てから、\nまだ一度も美容院\n行ってないの。"},
        { "location": "50/TALK"   , "narrator": "みやび", "text": "言われてみれば、\nつばめちゃんの髪、\nちっくと傷んじょるね。"},
        { "location": "51/TALK"   , "narrator": "みやび", "text": "…っちゅうか、うちも\n人のこと言えんけんど。"},
        { "location": "55/TALK"   , "narrator": "雛", "text": "あ～…じっくり見ると\nちょっと傷んでますねー。"},
        { "location": "57/TALK"   , "narrator": "みやび", "text": "うちも、最近はまったく\n行けんかったきね。"},
        { "location": "58/TALK"   , "narrator": "雛", "text": "一緒に予約しますか？"},
        { "location": "59/TALK"   , "narrator": "みやび", "text": "うちは行きつけの\n美容院でえいよ。"},
        { "location": "62/TALK"   , "narrator": "キリト", "text": "てか、みやび先輩も\n美容院行くんですか！？"},
        { "location": "65/TALK"   , "narrator": "みやび", "text": "…キリト君、\nうちも一応生物学的には\n女ぞね？"},
        { "location": "67/TALK"   , "narrator": "キリト", "text": "いや、オカッパ頭だから、\n床屋でスパッとやって\nもらうのかな、と…。"},
        { "location": "69/TALK"   , "narrator": "雛", "text": "お、オカッパって…\nボブって言いなよ。"},
        { "location": "72/TALK"   , "narrator": "キリト", "text": "誰だそれ？"},
        { "location": "76/TALK"   , "narrator": "つばめ", "text": "ボブヘアーのことだよ。"},
        { "location": "80/TALK"   , "narrator": "みやび", "text": "まあ、男の子にとっては\nわからんかもしれん\nけんど――"},
        { "location": "81/TALK"   , "narrator": "みやび", "text": "この髪、結構手が\n掛かっちょるがよ？"},
        { "location": "83/TALK"   , "narrator": "キリト", "text": "…女の髪って、難しいな。"},
        { "location": "85/TALK"   , "narrator": "みやび", "text": "勉強しといた方がえいよ。"},
        { "location": "87/TALK"   , "narrator": "みやび", "text": "…けんど、よくよく\n見るとまっこと\n傷んじゅうね。"},
        { "location": "88/SEL"    , "narrator": "", "text": "綺麗に見えるのに"},
        { "location": "89/SEL"    , "narrator": "", "text": "自分ではケアしないの？"},
        { "location": "93/TALK"   , "narrator": "キリト", "text": "別に傷んでなんか\nいねぇけどなぁ…。"},
        { "location": "95/TALK"   , "narrator": "雛", "text": "キリト、女の子の髪って\nじっくり見たことある？"},
        { "location": "98/TALK"   , "narrator": "キリト", "text": "いや、ねぇけど…。"},
        { "location": "99/TALK"   , "narrator": "雛", "text": "だよねー。\nまあ、あるって言ったら\nちょっと気持ち悪いけど。"},
        { "location": "104/TALK"  , "narrator": "つばめ", "text": "毎日ケアしても、\nどうしても傷んじゃうん\nだよね…。"},
        { "location": "108/TALK"  , "narrator": "みやび", "text": "そうやね。"},
        { "location": "109/TALK"  , "narrator": "みやび", "text": "シャンプー、リンス、\nコンディショナー、\nトリートメント――"},
        { "location": "110/TALK"  , "narrator": "みやび", "text": "色々使ってケアしても、\n結局傷んで美容院に\n行くことになるちや。"},
        { "location": "112/TALK"  , "narrator": "雛", "text": "わかりますわかります。\nどんなに気を付けても、\n枝毛とか見つかるし…。"},
        { "location": "115/TALK"  , "narrator": "つばめ", "text": "うっ…昨日一本見つけて\n切るの忘れてた…。"},
        { "location": "117/TALK"  , "narrator": "みやび", "text": "うちはもう、切るのすら\n諦めちゅうよ。"},
        { "location": "119/TALK"  , "narrator": "キリト", "text": "…三人とも、マジで\nそんなに傷んでるのか？"},
        { "location": "120/TALK"  , "narrator": "雛", "text": "うん。"},
        { "location": "121/TALK"  , "narrator": "つばめ", "text": "悲しいくらいにね…。"},
        { "location": "123/TALK"  , "narrator": "みやび", "text": "早く美容院行きたいちや。"},
        { "location": "124/TALK"  , "narrator": "キリト", "text": "…俺には普通にしか\n見えねぇんだけどなぁ。"},
        { "location": "126/ACT"   , "narrator": "", "text": "綺麗に見えるのに"},
        { "location": "150/TALK"  , "narrator": "みやび", "text": "そう見えるんやったら嬉しいけんど"},
        { "location": "151/TALK"  , "narrator": "みやび", "text": "なら、あんまし髪の毛凝視せんでな"},
        { "location": "152/TALK"  , "narrator": "みやび", "text": "一応、うちも女の端くれやき"},
        { "location": "153/TALK"  , "narrator": "みやび", "text": "傷んだ髪見られるんは恥ずかしいちや"},
        { "location": "168/TALK"  , "narrator": "つばめ", "text": "みやびさん、\n顔が赤いですけど\n大丈夫ですか？"},
        { "location": "170/TALK"  , "narrator": "みやび", "text": "ん？　何でもないき、\n心配せんでえい。"},
        { "location": "174/TALK"  , "narrator": "みやび", "text": "…相棒のアホ！"},
        { "location": "175/TALK"  , "narrator": "みやび", "text": "余計なこと言うき、\n顔に出たやんか。"},
        { "location": "179/TALK"  , "narrator": "みやび", "text": "…うち、帰りにそのまま\n美容院行ってくるぞね。"},
        { "location": "181/TALK"  , "narrator": "つばめ", "text": "わかりました…。"},
        { "location": "184/TALK"  , "narrator": "つばめ", "text": "…どうしたんだろう？\nなんか、恥ずかしがってる\n感じに見えるけど…？"},
        { "location": "186/TALK"  , "narrator": "雛", "text": "わからないよー。\nだってそんな話、\nちっともしてなかったし。"},
        { "location": "190/TALK"  , "narrator": "キリト", "text": "…でも、\nちょっと可愛いよな？"},
        { "location": "192/TALK"  , "narrator": "つばめ", "text": "うん…こんなみやびさん、\n初めて見たよ。"},
        { "location": "194/TALK"  , "narrator": "雛", "text": "…まゆちんが見たら、\nどんな反応したかなぁ？"},
        { "location": "195/ACT"   , "narrator": "", "text": "自分でケアしないの？"},
        { "location": "215/TALK"  , "narrator": "みやび", "text": "しちょるわ"},
        { "location": "216/TALK"  , "narrator": "みやび", "text": "っちゅうか、毎日結構頑張ってるちや"},
        { "location": "217/TALK"  , "narrator": "みやび", "text": "けんど、毛先とかはどうしても傷むがよ"},
        { "location": "229/TALK"  , "narrator": "みやび", "text": "…まっこと不思議やね。"},
        { "location": "230/TALK"  , "narrator": "みやび", "text": "必死にケアしちゅうに、\nすぐ傷むんやき…。"},
        { "location": "233/TALK"  , "narrator": "キリト", "text": "…てか、マジでそんな\n髪って傷むのか？"},
        { "location": "234/TALK"  , "narrator": "雛", "text": "傷むよー。\nだからケア用品とか\n沢山使うんじゃん。"},
        { "location": "235/TALK"  , "narrator": "キリト", "text": "なのに、傷むのか？"},
        { "location": "237/TALK"  , "narrator": "つばめ", "text": "うん。\n少しは傷むまでの\n時間は稼げるけどね。"},
        { "location": "239/TALK"  , "narrator": "みやび", "text": "うち、毛先の色が\nちっくと茶色っぽくも\nなってきちゅうよ。"},
        { "location": "241/TALK"  , "narrator": "雛", "text": "あっ、本当だ！\n急いで予約した方が\nいいですよー。"},
        { "location": "244/TALK"  , "narrator": "キリト", "text": "…全然傷んでるように\n見えねぇんだけどなぁ？"},
        { "location": "17/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>7月18日　10:04 AM</color>\nとある平日の休み時間、つばめの教室にて。"}
    ]
}
