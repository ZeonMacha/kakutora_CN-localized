{
    "dir": "chap18/daydra/dd_ch05_18_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "18505",
        "cid": "kagura",
        "title": "005 メインストーリー",
        "sub_title": "トップヲタか友達か＜後編＞"
    },
    "entry":
    [
        { "location": "3459/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "3460/TALK"  , "narrator": "神楽", "text": "…$handle$さんの、\n言う通りなのかも。"},
        { "location": "3461/TALK"  , "narrator": "神楽", "text": "私もママもつばめさんも、\nみんなが幸せになるための\n方法なんて…。"},
        { "location": "3462/TALK"  , "narrator": "神楽", "text": "考えたって、\n見つかるはずない。"},
        { "location": "3463/TALK"  , "narrator": "神楽", "text": "なのに、それ以外は\n絶対に受け入れないと\n思って、止まってる。"},
        { "location": "3465/TALK"  , "narrator": "神楽", "text": "これじゃ、なにもする気が\nないって言われるのも、\n当然よね…。"},
        { "location": "3478/TALK"  , "narrator": "神楽", "text": "さっきは、ごめんなさい"},
        { "location": "3481/TALK"  , "narrator": "神楽", "text": "$handle$さんの言うとおりでした"},
        { "location": "3482/TALK"  , "narrator": "神楽", "text": "私"},
        { "location": "3483/TALK"  , "narrator": "神楽", "text": "頑固です"},
        { "location": "3486/TALK"  , "narrator": "神楽", "text": "そのせいでなにもできず"},
        { "location": "3487/TALK"  , "narrator": "神楽", "text": "立ち止まってるというのに"},
        { "location": "3488/TALK"  , "narrator": "神楽", "text": "結局動こうとしない"},
        { "location": "3491/TALK"  , "narrator": "神楽", "text": "なにか、ないんですか？"},
        { "location": "3492/TALK"  , "narrator": "神楽", "text": "私もママもつばめさんも"},
        { "location": "3493/TALK"  , "narrator": "神楽", "text": "幸せな結末を迎える方法は"},
        { "location": "3496/TALK"  , "narrator": "神楽", "text": "本当はなにか"},
        { "location": "3497/TALK"  , "narrator": "神楽", "text": "方法が残されているんじゃないですか？"},
        { "location": "3499/SEL"   , "narrator": "", "text": "そんな都合のいい答えはない"},
        { "location": "3500/ACT"   , "narrator": "", "text": "そんな都合のいい答えはない"},
        { "location": "3503/TALK"  , "narrator": "神楽", "text": "やっぱり"},
        { "location": "3504/TALK"  , "narrator": "神楽", "text": "そうですよね"},
        { "location": "3505/TALK"  , "narrator": "神楽", "text": "ありがとうございます"},
        { "location": "3507/TALK"  , "narrator": "神楽", "text": "ハッキリ言ってくれて"},
        { "location": "3510/TALK"  , "narrator": "神楽", "text": "自分でもわかってたのに"},
        { "location": "3511/TALK"  , "narrator": "神楽", "text": "認められなくて"},
        { "location": "3512/TALK"  , "narrator": "神楽", "text": "ずっとモヤモヤしてて"},
        { "location": "3515/TALK"  , "narrator": "神楽", "text": "でも、今ので吹っ切れました"},
        { "location": "3516/TALK"  , "narrator": "神楽", "text": "私に残された選択肢は限られていて"},
        { "location": "3517/TALK"  , "narrator": "神楽", "text": "どんなに辛くて、イヤだったとしても"},
        { "location": "3518/TALK"  , "narrator": "神楽", "text": "その中から選ばなければならない"},
        { "location": "3521/TALK"  , "narrator": "神楽", "text": "覚悟を決めました"},
        { "location": "3522/TALK"  , "narrator": "神楽", "text": "もう、無駄な希望にはすがりません"},
        { "location": "3523/TALK"  , "narrator": "神楽", "text": "どんな辛い選択でも"},
        { "location": "3524/TALK"  , "narrator": "神楽", "text": "選びます"},
        { "location": "3525/TALK"  , "narrator": "神楽", "text": "そのせいで"},
        { "location": "3526/TALK"  , "narrator": "神楽", "text": "誰かが不幸になるとしても"},
        { "location": "3528/SEL"   , "narrator": "", "text": "つばめ優先で頼むよ"},
        { "location": "3529/SEL"   , "narrator": "", "text": "神楽の選択を尊重するよ"},
        { "location": "3530/SEL"   , "narrator": "", "text": "現状維持じゃダメなの？"},
        { "location": "3531/ACT"   , "narrator": "", "text": "つばめ優先で頼むよ"},
        { "location": "3533/TALK"  , "narrator": "神楽", "text": "ああ"},
        { "location": "3534/TALK"  , "narrator": "神楽", "text": "そういうこと"},
        { "location": "3535/TALK"  , "narrator": "神楽", "text": "結局$handle$さんは"},
        { "location": "3536/TALK"  , "narrator": "神楽", "text": "つばめさんの味方ってわけですか"},
        { "location": "3539/TALK"  , "narrator": "神楽", "text": "私のことを想って、厳しい言葉をかけてくれたんじゃないんですね"},
        { "location": "3540/TALK"  , "narrator": "神楽", "text": "まあ"},
        { "location": "3541/TALK"  , "narrator": "神楽", "text": "所詮裏切り者の小娘を、大切に想うはずありませんよね"},
        { "location": "3542/TALK"  , "narrator": "神楽", "text": "私がバカでした"},
        { "location": "3554/ACT"   , "narrator": "", "text": "神楽の選択を尊重するよ"},
        { "location": "3555/TALK"  , "narrator": "神楽", "text": "とっても嬉しいです"},
        { "location": "3559/TALK"  , "narrator": "神楽", "text": "今だから話しますけど"},
        { "location": "3560/TALK"  , "narrator": "神楽", "text": "最初は私、$handle$さんのこと"},
        { "location": "3561/TALK"  , "narrator": "神楽", "text": "とっても胡散臭い人だと思ってました"},
        { "location": "3562/TALK"  , "narrator": "神楽", "text": "けど今は"},
        { "location": "3563/TALK"  , "narrator": "神楽", "text": "とっても心強い存在です"},
        { "location": "3564/TALK"  , "narrator": "神楽", "text": "だって$handle$さんは"},
        { "location": "3565/TALK"  , "narrator": "神楽", "text": "私が本音を出して話せる、唯一の人だから"},
        { "location": "3568/TALK"  , "narrator": "神楽", "text": "これからの私は"},
        { "location": "3569/TALK"  , "narrator": "神楽", "text": "今よりももっと、辛い想いをすることになると思う"},
        { "location": "3570/TALK"  , "narrator": "神楽", "text": "心が押しつぶされそうになったり"},
        { "location": "3571/TALK"  , "narrator": "神楽", "text": "逃げだそうとしたくなることもあるかも"},
        { "location": "3572/TALK"  , "narrator": "神楽", "text": "そうなったときは"},
        { "location": "3573/TALK"  , "narrator": "神楽", "text": "$handle$さんのこと、頼りにしていい？"},
        { "location": "3576/SEL"   , "narrator": "", "text": "もちろんだよ"},
        { "location": "3577/SEL"   , "narrator": "", "text": "どんとこい！！"},
        { "location": "3578/ACT"   , "narrator": "", "text": "もちろんだよ"},
        { "location": "3580/TALK"  , "narrator": "神楽", "text": "優しい人"},
        { "location": "3581/TALK"  , "narrator": "神楽", "text": "本当に、ありがとう"},
        { "location": "3582/TALK"  , "narrator": "神楽", "text": "私、頑張りますね"},
        { "location": "3583/ACT"   , "narrator": "", "text": "どんとこい！！"},
        { "location": "3584/TALK"  , "narrator": "神楽", "text": "力強い返事ですね"},
        { "location": "3585/TALK"  , "narrator": "神楽", "text": "頼りにしてます"},
        { "location": "3597/TALK"  , "narrator": "神楽", "text": "…嬉しい。"},
        { "location": "3598/TALK"  , "narrator": "神楽", "text": "胸の内をさらけ出せる\n相手がいるって…。"},
        { "location": "3600/TALK"  , "narrator": "神楽", "text": "こんなにも心強いこと\nなのね…。"},
        { "location": "3601/TALK"  , "narrator": "神楽", "text": "…でも。"},
        { "location": "3602/TALK"  , "narrator": "神楽", "text": "私は、どんな選択を――"},
        { "location": "3603/TALK"  , "narrator": "神楽", "text": "ママと、つばめさん…、\nどっちを選ぶんだろう？"},
        { "location": "3605/ACT"   , "narrator": "", "text": "現状維持じゃダメなの？"},
        { "location": "3606/TALK"  , "narrator": "神楽", "text": "はぁ！？"},
        { "location": "3607/TALK"  , "narrator": "神楽", "text": "現状維持じゃ"},
        { "location": "3608/TALK"  , "narrator": "神楽", "text": "今までとなにも変わらないじゃないですか！"},
        { "location": "3609/TALK"  , "narrator": "神楽", "text": "それがイヤだから"},
        { "location": "3610/TALK"  , "narrator": "神楽", "text": "行動すると決めたのに"},
        { "location": "3613/TALK"  , "narrator": "神楽", "text": "$handle$さんがなにを考えているのか、わかりません"},
        { "location": "3614/TALK"  , "narrator": "神楽", "text": "ガッカリしました"},
        { "location": "3635/DIALOG", "narrator": "Dialog_chapter_ch05", "text": "【15 弾の数だけ抱きしめて】"},
        { "location": "3647/DIALOG", "narrator": "Dialog_chapter_ch05", "text": "【15 弾の数だけ抱きしめて】"}
    ]
}
