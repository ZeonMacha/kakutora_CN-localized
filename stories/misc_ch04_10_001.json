    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "05_000_本気にしやがれ"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "本物の素人と"},
        { "location": "33/TALK"   , "narrator": "みやび", "text": "素人を装った玄人"},
        { "location": "34/TALK"   , "narrator": "みやび", "text": "両者の違いは何かわかるかね"},
        { "location": "36/SEL"    , "narrator": "", "text": "熟練度"},
        { "location": "37/SEL"    , "narrator": "", "text": "スキルかな"},
        { "location": "38/SEL"    , "narrator": "", "text": "細部へのこだわり"},
        { "location": "39/ACT"    , "narrator": "", "text": "熟練度"},
        { "location": "40/TALK"   , "narrator": "みやび", "text": "確かにな"},
        { "location": "41/ACT"    , "narrator": "", "text": "スキルかな"},
        { "location": "42/TALK"   , "narrator": "みやび", "text": "それもある"},
        { "location": "43/ACT"    , "narrator": "", "text": "細部へのこだわり"},
        { "location": "45/TALK"   , "narrator": "みやび", "text": "どうしてもな"},
        { "location": "46/TALK"   , "narrator": "みやび", "text": "出てしまうぞね"},
        { "location": "48/TALK"   , "narrator": "みやび", "text": "玄人は型があるぞね"},
        { "location": "49/TALK"   , "narrator": "みやび", "text": "玄人同士だとそこに気づいてしまうぞね"},
        { "location": "51/SEL"    , "narrator": "", "text": "武術の話？"},
        { "location": "52/SEL"    , "narrator": "", "text": "極めるとわかるんだね"},
        { "location": "53/SEL"    , "narrator": "", "text": "さすがはみやびさん"},
        { "location": "54/ACT"    , "narrator": "", "text": "武術の話？"},
        { "location": "55/TALK"   , "narrator": "みやび", "text": "それにも通じるが"},
        { "location": "56/TALK"   , "narrator": "みやび", "text": "今回は武術の話ではない"},
        { "location": "57/ACT"    , "narrator": "", "text": "極めるとわかるんだね"},
        { "location": "58/TALK"   , "narrator": "みやび", "text": "かじったくらいでも"},
        { "location": "59/TALK"   , "narrator": "みやび", "text": "わかることかもしれん"},
        { "location": "60/ACT"    , "narrator": "", "text": "さすがはみやびさん"},
        { "location": "62/TALK"   , "narrator": "みやび", "text": "わかりやすいおべんちゃらを"},
        { "location": "63/TALK"   , "narrator": "みやび", "text": "まあ"},
        { "location": "64/TALK"   , "narrator": "みやび", "text": "本気にしてやろう"},
        { "location": "65/TALK"   , "narrator": "みやび", "text": "今回だけは"},
        { "location": "67/TALK"   , "narrator": "みやび", "text": "玄人の偽装を"},
        { "location": "68/TALK"   , "narrator": "みやび", "text": "わかってて見逃すのが"},
        { "location": "69/TALK"   , "narrator": "みやび", "text": "大人の流儀かもしれん"},
        { "location": "71/SEL"    , "narrator": "", "text": "そうだね"},
        { "location": "72/SEL"    , "narrator": "", "text": "どうかな"},
        { "location": "73/ACT"    , "narrator": "", "text": "そうだね"},
        { "location": "74/TALK"   , "narrator": "みやび", "text": "そうであろう"},
        { "location": "75/TALK"   , "narrator": "みやび", "text": "しかしみやびさんは"},
        { "location": "76/TALK"   , "narrator": "みやび", "text": "まだ高校生ゆえ"},
        { "location": "77/TALK"   , "narrator": "みやび", "text": "そんなことをしなくてもよいのだ"},
        { "location": "78/TALK"   , "narrator": "みやび", "text": "参ったか"},
        { "location": "79/ACT"    , "narrator": "", "text": "どうかな"},
        { "location": "80/TALK"   , "narrator": "みやび", "text": "ふむ"},
        { "location": "81/TALK"   , "narrator": "みやび", "text": "その物事を斜めに見る視線"},
        { "location": "82/TALK"   , "narrator": "みやび", "text": "悪くない"},
        { "location": "83/TALK"   , "narrator": "みやび", "text": "気に入ったぞ"}
    ]
}
