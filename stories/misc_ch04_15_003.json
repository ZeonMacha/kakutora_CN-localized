        { "location": "165/SCENARIO", "narrator": "", "text": "024_砂漠みたいな楽園の"},
        { "location": "190/TALK"    , "narrator": "みやび", "text": "友情を信じるかね"},
        { "location": "192/SEL"     , "narrator": "", "text": "信じる"},
        { "location": "193/SEL"     , "narrator": "", "text": "信じない"},
        { "location": "194/SEL"     , "narrator": "", "text": "みやびとの情は愛情"},
        { "location": "195/ACT"     , "narrator": "", "text": "信じる"},
        { "location": "196/TALK"    , "narrator": "みやび", "text": "単純じゃの"},
        { "location": "197/ACT"     , "narrator": "", "text": "信じない"},
        { "location": "198/TALK"    , "narrator": "みやび", "text": "切ないの"},
        { "location": "199/ACT"     , "narrator": "", "text": "みやびとの情は愛情"},
        { "location": "201/TALK"    , "narrator": "みやび", "text": "ほうほう"},
        { "location": "202/TALK"    , "narrator": "みやび", "text": "これは世紀の大発見"},
        { "location": "204/TALK"    , "narrator": "みやび", "text": "とでも"},
        { "location": "205/TALK"    , "narrator": "みやび", "text": "言うと思ったか"},
        { "location": "207/TALK"    , "narrator": "みやび", "text": "何"},
        { "location": "208/TALK"    , "narrator": "みやび", "text": "つばめが友情について大変に興味深い症例を発症したので"},
        { "location": "209/TALK"    , "narrator": "みやび", "text": "相棒にも意見を求めようと思ってな"},
        { "location": "211/SEL"     , "narrator": "", "text": "いいことじゃない"},
        { "location": "212/SEL"     , "narrator": "", "text": "羨ましいんだ？"},
        { "location": "213/SEL"     , "narrator": "", "text": "なるようになる"},
        { "location": "214/ACT"     , "narrator": "", "text": "いいことじゃない"},
        { "location": "215/TALK"    , "narrator": "みやび", "text": "凡庸"},
        { "location": "216/TALK"    , "narrator": "みやび", "text": "しかし"},
        { "location": "217/TALK"    , "narrator": "みやび", "text": "真っ当な意見"},
        { "location": "218/TALK"    , "narrator": "みやび", "text": "相棒は意外といいやつぞね"},
        { "location": "221/ACT"     , "narrator": "", "text": "羨ましいんだ？"},
        { "location": "223/TALK"    , "narrator": "みやび", "text": "何を言う"},
        { "location": "224/TALK"    , "narrator": "みやび", "text": "言っていいことと悪いことがあろう"},
        { "location": "225/TALK"    , "narrator": "みやび", "text": "まあ"},
        { "location": "227/TALK"    , "narrator": "みやび", "text": "図星かもな"},
        { "location": "228/ACT"     , "narrator": "", "text": "なるようになる"},
        { "location": "229/TALK"    , "narrator": "みやび", "text": "意外とクール"},
        { "location": "230/TALK"    , "narrator": "みやび", "text": "あるいはドライ"},
        { "location": "231/TALK"    , "narrator": "みやび", "text": "だがしかし"},
        { "location": "232/TALK"    , "narrator": "みやび", "text": "人生とはそういうものか"}
    ]
}
