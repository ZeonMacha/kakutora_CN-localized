{
    "dir": "chap19/daydra/dd_ch05_19_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "19502",
        "cid": "kagura",
        "title": "002 メインストーリー",
        "sub_title": "非日常＜前編＞"
    },
    "entry":
    [
        { "location": "40/TALK"   , "narrator": "ガブリエラ", "text": "…ほんっと\n暑いわね～。"},
        { "location": "41/TALK"   , "narrator": "アーヤ", "text": "口に出すと\nもっと暑くなるわよ。"},
        { "location": "42/TALK"   , "narrator": "ガブリエラ", "text": "そうかもしれないけど。"},
        { "location": "43/TALK"   , "narrator": "ガブリエラ", "text": "こんなに暑いと\n文句の一つも\n言いたくなるわ。"},
        { "location": "44/TALK"   , "narrator": "ガブリエラ", "text": "ポーランドだと\n海はここまで暑くは\nないもの。"},
        { "location": "45/TALK"   , "narrator": "つばめ", "text": "えっ？"},
        { "location": "46/TALK"   , "narrator": "ガブリエラ", "text": "何よその反応。"},
        { "location": "47/TALK"   , "narrator": "ガブリエラ", "text": "ポーランドには有名な\n海水浴場も\nあるんだから。"},
        { "location": "48/TALK"   , "narrator": "ガブリエラ", "text": "あんまりバカに\nしないでよね。"},
        { "location": "49/TALK"   , "narrator": "つばめ", "text": "そういうわけじゃ…。"},
        { "location": "50/TALK"   , "narrator": "神楽", "text": "フランスにも\n泳げる場所は\nありましたけど。"},
        { "location": "51/TALK"   , "narrator": "神楽", "text": "むしろスペインに\n行く方が\n人気でした。"},
        { "location": "52/TALK"   , "narrator": "つばめ", "text": "それって海外旅行って\nこと？"},
        { "location": "53/TALK"   , "narrator": "神楽", "text": "…日本風に言うと\nそうなりますね。"},
        { "location": "54/TALK"   , "narrator": "神楽", "text": "でも向こうの感覚だと\n今回のバカンスは\nスペインなのくらい。"},
        { "location": "55/TALK"   , "narrator": "神楽", "text": "地続きですしね。"},
        { "location": "56/TALK"   , "narrator": "つばめ", "text": "へー。\nそうなんだ…。"},
        { "location": "57/TALK"   , "narrator": "アーヤ", "text": "なんかやっぱり\nかっこいい感じが\nするけど。"},
        { "location": "58/TALK"   , "narrator": "神楽", "text": "そういうアーヤさんは\nどこに行ってました？"},
        { "location": "59/TALK"   , "narrator": "アーヤ", "text": "私？"},
        { "location": "60/TALK"   , "narrator": "アーヤ", "text": "中高は部活で\n常に剣道漬け\nだったから。"},
        { "location": "61/TALK"   , "narrator": "アーヤ", "text": "海に行った思い出って\nないかも……。"},
        { "location": "62/TALK"   , "narrator": "アーヤ", "text": "あっ、でもね。"},
        { "location": "63/TALK"   , "narrator": "アーヤ", "text": "小学生の時は\n学校のプールが\n解放されたの。"},
        { "location": "64/TALK"   , "narrator": "アーヤ", "text": "だから夏休みの間は\n小学校のプールに\n通ってた。"},
        { "location": "65/TALK"   , "narrator": "アーヤ", "text": "つばめはどう？"},
        { "location": "66/TALK"   , "narrator": "つばめ", "text": "わたしは…。"},
        { "location": "67/TALK"   , "narrator": "つばめ", "text": "実を言うと海水浴とか\n今回の合宿が\n初めてなんです。"},
        { "location": "68/TALK"   , "narrator": "アーヤ", "text": "……そうだったのね……。"},
        { "location": "69/TALK"   , "narrator": "神楽", "text": "……。"},
        { "location": "70/TALK"   , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "103/TALK"  , "narrator": "ガブリエラ", "text": "あ～、疲れたわぁ…。"},
        { "location": "105/TALK"  , "narrator": "ガブリエラ", "text": "あっ…。"},
        { "location": "109/TALK"  , "narrator": "アーヤ", "text": "どうしたの、\nギャヴィ…。"},
        { "location": "110/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "112/TALK"  , "narrator": "アーヤ", "text": "ああ、卯月…。\n出かけなかったの？"},
        { "location": "118/TALK"  , "narrator": "神楽", "text": "はい…ちょっと、\n疲れが溜まってて…。"},
        { "location": "119/TALK"  , "narrator": "アーヤ", "text": "そう…。"},
        { "location": "121/TALK"  , "narrator": "アーヤ", "text": "えっと…。"},
        { "location": "122/TALK"  , "narrator": "ガブリエラ", "text": "珍しく一人なのね。\nつばめは？"},
        { "location": "123/TALK"  , "narrator": "神楽", "text": "つばめさんなら、\nコンビニに行くって\n言ってましたよ。"},
        { "location": "124/TALK"  , "narrator": "アーヤ", "text": "卯月は\n行かなかったんだ？"},
        { "location": "125/TALK"  , "narrator": "神楽", "text": "はい…。\n誘われたんですけど、\nちょっと…。"},
        { "location": "126/TALK"  , "narrator": "ガブリエラ", "text": "具合でも悪いの？"},
        { "location": "127/TALK"  , "narrator": "神楽", "text": "いえ、そういう\nことじゃなくて、\nその…。"},
        { "location": "129/TALK"  , "narrator": "ガブリエラ", "text": "…ケンカでもしたの？"},
        { "location": "130/TALK"  , "narrator": "神楽", "text": "…してないですよ。\nケンカなんて、\nそんなこと…。"},
        { "location": "131/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "132/TALK"  , "narrator": "神楽", "text": "えっと…、\nごめんなさい。"},
        { "location": "133/TALK"  , "narrator": "神楽", "text": "私も、\nちょっと気分転換に\nお散歩行ってきます。"},
        { "location": "151/TALK"  , "narrator": "神楽", "text": "はぁ…。"},
        { "location": "152/SEL"   , "narrator": "", "text": "気まずそうだね"},
        { "location": "154/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "156/TALK"  , "narrator": "神楽", "text": "外に出れば、\n少しは気が紛れると\n思ったけど…。"},
        { "location": "157/TALK"  , "narrator": "神楽", "text": "そんなことないか…。\nまあ、そうよね…。"},
        { "location": "158/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "161/TALK"  , "narrator": "神楽", "text": "今帰っても\n気まずいだけだし。"},
        { "location": "162/TALK"  , "narrator": "神楽", "text": "やっぱり、ちょっと\n散歩しよう…。"},
        { "location": "165/ACT"   , "narrator": "", "text": "気まずそうだね"},
        { "location": "178/TALK"  , "narrator": "神楽", "text": "ちょっとだけ"},
        { "location": "179/TALK"  , "narrator": "神楽", "text": "でも大丈夫です"},
        { "location": "180/TALK"  , "narrator": "神楽", "text": "この辛い日々も"},
        { "location": "181/TALK"  , "narrator": "神楽", "text": "あと少しですから、、、"},
        { "location": "183/SEL"   , "narrator": "", "text": "つまり、選択したってこと？"},
        { "location": "184/ACT"   , "narrator": "", "text": "つまり、選択したってこと？"},
        { "location": "186/TALK"  , "narrator": "神楽", "text": "はい"},
        { "location": "187/TALK"  , "narrator": "神楽", "text": "私はやっぱり"},
        { "location": "188/TALK"  , "narrator": "神楽", "text": "母を助けたい"},
        { "location": "189/TALK"  , "narrator": "神楽", "text": "つばめさんも大切だけど"},
        { "location": "190/TALK"  , "narrator": "神楽", "text": "一番は母です"},
        { "location": "192/TALK"  , "narrator": "神楽", "text": "これは曲げられません"},
        { "location": "194/SEL"   , "narrator": "", "text": "本当にそれでいいの？"},
        { "location": "195/SEL"   , "narrator": "", "text": "尊重するって言ったよね？"},
        { "location": "196/SEL"   , "narrator": "", "text": "最後まで見届けるよ"},
        { "location": "197/ACT"   , "narrator": "", "text": "本当にそれでいいの？"},
        { "location": "198/TALK"  , "narrator": "神楽", "text": "良いも悪いもないから"},
        { "location": "199/TALK"  , "narrator": "神楽", "text": "その中で選んだだけです"},
        { "location": "200/TALK"  , "narrator": "神楽", "text": "後は"},
        { "location": "201/TALK"  , "narrator": "神楽", "text": "最後まで"},
        { "location": "202/TALK"  , "narrator": "神楽", "text": "貫き通すだけです"},
        { "location": "203/ACT"   , "narrator": "", "text": "尊重するって言ったよね？"},
        { "location": "204/TALK"  , "narrator": "神楽", "text": "ありがとうございます"},
        { "location": "205/TALK"  , "narrator": "神楽", "text": "でも、、、"},
        { "location": "206/TALK"  , "narrator": "神楽", "text": "本音ですか？"},
        { "location": "207/TALK"  , "narrator": "神楽", "text": "本当はつばめさんのこと"},
        { "location": "208/TALK"  , "narrator": "神楽", "text": "壊されたくないと思ってませんか？"},
        { "location": "210/SEL"   , "narrator": "", "text": "そりゃそうだよ"},
        { "location": "211/SEL"   , "narrator": "", "text": "すぐに壊すべきだと思ってる"},
        { "location": "212/SEL"   , "narrator": "", "text": "神楽の母親を放っておけない"},
        { "location": "213/ACT"   , "narrator": "", "text": "そりゃそうだよ"},
        { "location": "214/TALK"  , "narrator": "神楽", "text": "そうですよね"},
        { "location": "215/TALK"  , "narrator": "神楽", "text": "やっぱり"},
        { "location": "216/TALK"  , "narrator": "神楽", "text": "悩みますよね？"},
        { "location": "217/ACT"   , "narrator": "", "text": "すぐに壊すべきだと思ってる"},
        { "location": "219/TALK"  , "narrator": "神楽", "text": "ごめんなさい"},
        { "location": "220/TALK"  , "narrator": "神楽", "text": "ちょっと気分が優れなくて"},
        { "location": "223/TALK"  , "narrator": "神楽", "text": "一度落ちます"},
        { "location": "234/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "235/TALK"  , "narrator": "神楽", "text": "すぐに壊すべき…。\n確かに、そうね。"},
        { "location": "237/TALK"  , "narrator": "神楽", "text": "私の出した選択的にも\nそれが一番いいのは\n間違いない。"},
        { "location": "238/TALK"  , "narrator": "神楽", "text": "なのに…どうして\nイライラした\n気持ちになるの…？"},
        { "location": "241/ACT"   , "narrator": "", "text": "神楽の母親を放っておけない"},
        { "location": "242/TALK"  , "narrator": "神楽", "text": "そう思ってもらえるなら"},
        { "location": "243/TALK"  , "narrator": "神楽", "text": "とっても嬉しいです"},
        { "location": "245/ACT"   , "narrator": "", "text": "最後まで見届けるよ"},
        { "location": "246/TALK"  , "narrator": "神楽", "text": "けど"},
        { "location": "247/TALK"  , "narrator": "神楽", "text": "最後というのは"},
        { "location": "248/TALK"  , "narrator": "神楽", "text": "いつのことなんですか？"},
        { "location": "249/TALK"  , "narrator": "神楽", "text": "もうすぐなのか"},
        { "location": "250/TALK"  , "narrator": "神楽", "text": "それともまだまだ先なんですか？"},
        { "location": "252/SEL"   , "narrator": "", "text": "答えられない"},
        { "location": "253/ACT"   , "narrator": "", "text": "答えられない"},
        { "location": "255/TALK"  , "narrator": "神楽", "text": "やっぱり"},
        { "location": "259/TALK"  , "narrator": "神楽", "text": "でも"},
        { "location": "260/TALK"  , "narrator": "神楽", "text": "最後まで"},
        { "location": "261/TALK"  , "narrator": "神楽", "text": "一緒にいてくれるなら"},
        { "location": "262/TALK"  , "narrator": "神楽", "text": "ちょっと安心です"},
        { "location": "263/TALK"  , "narrator": "神楽", "text": "ほっとしました"},
        { "location": "265/TALK"  , "narrator": "神楽", "text": "なんであれ"},
        { "location": "266/TALK"  , "narrator": "神楽", "text": "私は選択して"},
        { "location": "267/TALK"  , "narrator": "神楽", "text": "覚悟もできてますから"},
        { "location": "268/TALK"  , "narrator": "神楽", "text": "みんなと気まずくなるのも"},
        { "location": "269/TALK"  , "narrator": "神楽", "text": "覚悟済みです"},
        { "location": "270/TALK"  , "narrator": "神楽", "text": "第一"},
        { "location": "271/TALK"  , "narrator": "神楽", "text": "この今いる日本は"},
        { "location": "272/TALK"  , "narrator": "神楽", "text": "全部虚像です"},
        { "location": "273/TALK"  , "narrator": "神楽", "text": "人も街も"},
        { "location": "274/TALK"  , "narrator": "神楽", "text": "もちろん友情も"},
        { "location": "275/TALK"  , "narrator": "神楽", "text": "だから"},
        { "location": "276/TALK"  , "narrator": "神楽", "text": "気になんてしません"},
        { "location": "278/SEL"   , "narrator": "", "text": "そこまで割り切れるの？"},
        { "location": "279/ACT"   , "narrator": "", "text": "そこまで割り切れるの？"},
        { "location": "281/TALK"  , "narrator": "神楽", "text": "割り切るしかないんです"},
        { "location": "282/TALK"  , "narrator": "神楽", "text": "それに"},
        { "location": "283/TALK"  , "narrator": "神楽", "text": "つばめさんを壊せば"},
        { "location": "284/TALK"  , "narrator": "神楽", "text": "この世界も全て壊れます"},
        { "location": "285/TALK"  , "narrator": "神楽", "text": "中途半端に残らないで"},
        { "location": "286/TALK"  , "narrator": "神楽", "text": "全部消えてしまえば"},
        { "location": "287/TALK"  , "narrator": "神楽", "text": "吹っ切るのも簡単です"},
        { "location": "288/TALK"  , "narrator": "神楽", "text": "だから"},
        { "location": "289/TALK"  , "narrator": "神楽", "text": "やっぱりこれが"},
        { "location": "290/TALK"  , "narrator": "神楽", "text": "一番最適な選択だと思ってます"},
        { "location": "301/TALK"  , "narrator": "神楽", "text": "…そう。\nこれでいいの。"},
        { "location": "302/TALK"  , "narrator": "神楽", "text": "だって――"},
        { "location": "303/TALK"  , "narrator": "神楽", "text": "ここにあるものは、\n全部嘘なんだから…。"},
        { "location": "352/TALK"  , "narrator": "ぴょんこ", "text": "　"},
        { "location": "385/TALK"  , "narrator": "エリカ", "text": "良かった。\nちゃんと逢えたよ。"},
        { "location": "386/SEL"   , "narrator": "", "text": "エリカ！"},
        { "location": "387/SEL"   , "narrator": "", "text": "エリカｽｷ"},
        { "location": "388/ACT"   , "narrator": "", "text": "エリカ！"},
        { "location": "389/ACT"   , "narrator": "", "text": "エリカｽｷ"},
        { "location": "391/TALK"  , "narrator": "エリカ", "text": "ええっ！"},
        { "location": "392/TALK"  , "narrator": "エリカ", "text": "ちょ、ちょっと、\nそんないきなり\n言われても……。"},
        { "location": "394/TALK"  , "narrator": "エリカ", "text": "そういう話はまた今度、\nこの件が一段落したらね？"},
        { "location": "397/TALK"  , "narrator": "エリカ", "text": "それより――"},
        { "location": "399/TALK"  , "narrator": "エリカ", "text": "ごめんね、ちょっと\n強引な形で\n呼び寄せちゃって。"},
        { "location": "400/TALK"  , "narrator": "エリカ", "text": "やることやったら、\nまたすぐに元の場所に\n送り届けるから。"},
        { "location": "401/SEL"   , "narrator": "", "text": "で、どうすればいい？"},
        { "location": "402/ACT"   , "narrator": "", "text": "で、どうすればいい？"},
        { "location": "404/TALK"  , "narrator": "エリカ", "text": "えっとね、あなたに\nやって欲しいのは――"},
        { "location": "405/TALK"  , "narrator": "エリカ", "text": "とにかく、一刻も早く、\n書き換えられたアドレスを\n見つけ出すこと。"},
        { "location": "406/SEL"   , "narrator": "", "text": "アドレスが見つけられると、ぴょんこも見つかるの？"},
        { "location": "407/ACT"   , "narrator": "", "text": "アドレスが見つけられると、ぴょんこも見つかるの？"},
        { "location": "409/TALK"  , "narrator": "エリカ", "text": "うーん、\n１００％見つかるかと\n言われると、自信ない。"},
        { "location": "410/TALK"  , "narrator": "エリカ", "text": "けど、一番堅実な\n方法かなと思ってるよ。"},
        { "location": "411/SEL"   , "narrator": "", "text": "わかった、じゃあそれでいこう！"},
        { "location": "412/SEL"   , "narrator": "", "text": "一応その理由を教えて欲しい"},
        { "location": "413/ACT"   , "narrator": "", "text": "わかった、じゃあそれでいこう！"},
        { "location": "414/TALK"  , "narrator": "エリカ", "text": "うん。ありがとう。"},
        { "location": "415/ACT"   , "narrator": "", "text": "一応その理由を教えて欲しい"},
        { "location": "416/TALK"  , "narrator": "エリカ", "text": "ココロの世界には、\n無限に近い数の扉があって\nアドレスがついてる。"},
        { "location": "417/TALK"  , "narrator": "エリカ", "text": "同化が起こっている＝\nそのうちの幾つかに修正が\n入ってるってことだけど―"},
        { "location": "418/TALK"  , "narrator": "エリカ", "text": "その更新の有無を\n１アドレスずつ見ていくと\nおばあちゃんになっちゃう"},
        { "location": "419/TALK"  , "narrator": "エリカ", "text": "けど、その発端となる\n改ざんアドレスが\nわかれば――"},
        { "location": "420/TALK"  , "narrator": "エリカ", "text": "そこから樹状に広がる\n記憶の修正経路を\nトレスする事ができるの。"},
        { "location": "421/TALK"  , "narrator": "エリカ", "text": "ぴょんこちゃんが\n消えたのは、まだ最近の\nことだから――"},
        { "location": "422/TALK"  , "narrator": "エリカ", "text": "運が良ければ、すぐにでも\n移動した形跡と、今いる\n場所がわかるかも。"},
        { "location": "423/SEL"   , "narrator": "", "text": "なるほど"},
        { "location": "424/ACT"   , "narrator": "", "text": "なるほど"},
        { "location": "427/TALK"  , "narrator": "エリカ", "text": "というわけで！"},
        { "location": "428/TALK"  , "narrator": "エリカ", "text": "あなたには引き続き、\n共通意識野で記憶の\n違和感を見つけ出して――"},
        { "location": "429/TALK"  , "narrator": "エリカ", "text": "その場所を特定出来たら\nアドレスをわたしに\n教えて欲しいの。"},
        { "location": "430/TALK"  , "narrator": "エリカ", "text": "そのアドレスから、\n変更経路をトレスして、\nぴょんこちゃんを探す。"},
        { "location": "431/TALK"  , "narrator": "エリカ", "text": "お願い、できるかな？"},
        { "location": "432/SEL"   , "narrator": "", "text": "はい"},
        { "location": "433/SEL"   , "narrator": "", "text": "いいえ"},
        { "location": "434/ACT"   , "narrator": "", "text": "はい"},
        { "location": "435/TALK"  , "narrator": "エリカ", "text": "よかった！\nありがとう！"},
        { "location": "436/TALK"  , "narrator": "エリカ", "text": "でも、本当にごめんね？"},
        { "location": "437/SEL"   , "narrator": "", "text": "何が？"},
        { "location": "438/ACT"   , "narrator": "", "text": "何が？"},
        { "location": "440/TALK"  , "narrator": "エリカ", "text": "共通意識野へは、わたしが\nみやびちゃんにお願いして\nあなたを誘導したけど――"},
        { "location": "441/TALK"  , "narrator": "エリカ", "text": "まさかこんなオオゴトに\nなるとは思わなくて。"},
        { "location": "442/TALK"  , "narrator": "エリカ", "text": "ちょっと考えが\n足りなくて、あなたに\n迷惑かけちゃってるね。"},
        { "location": "443/SEL"   , "narrator": "", "text": "ホントだよ、今度何かおごって"},
        { "location": "444/SEL"   , "narrator": "", "text": "そんなことないって、エリカは自分を責めすぎ"},
        { "location": "445/ACT"   , "narrator": "", "text": "ホントだよ、今度何かおごって"},
        { "location": "447/TALK"  , "narrator": "エリカ", "text": "うん、わかったよ。"},
        { "location": "448/TALK"  , "narrator": "エリカ", "text": "何か考えておくね。"},
        { "location": "449/ACT"   , "narrator": "", "text": "そんなことないって、エリカは自分を責めすぎ"},
        { "location": "451/TALK"  , "narrator": "エリカ", "text": "そうかなぁ。\nでも元を正せば全部\n自分のせいだし。"},
        { "location": "452/TALK"  , "narrator": "エリカ", "text": "でも、あなたと出逢えて\n本当に良かったと\n思ってるよ。"},
        { "location": "453/TALK"  , "narrator": "エリカ", "text": "タダでさえこんな状況\nなのに、繋いだ先の人が\n冷たい人だったら――"},
        { "location": "454/TALK"  , "narrator": "エリカ", "text": "わたしはもう、\n生きてなかったかも\nしれないし。"},
        { "location": "457/TALK"  , "narrator": "エリカ", "text": "それじゃ改めて。"},
        { "location": "458/TALK"  , "narrator": "エリカ", "text": "今回もどうか、\nよろしくお願いします！"},
        { "location": "459/ACT"   , "narrator": "", "text": "いいえ"},
        { "location": "460/TALK"  , "narrator": "エリカ", "text": "はあっ……そっかぁ。"},
        { "location": "461/TALK"  , "narrator": "エリカ", "text": "それじゃ、仕方ないよね。\n無理強いは出来ないし。"},
        { "location": "462/SEL"   , "narrator": "", "text": "その通り"},
        { "location": "463/SEL"   , "narrator": "", "text": "何か奢ってくれたらやってあげるよ"},
        { "location": "464/ACT"   , "narrator": "", "text": "その通り"},
        { "location": "465/TALK"  , "narrator": "エリカ", "text": "うん。"},
        { "location": "466/TALK"  , "narrator": "エリカ", "text": "でも、もし気が向いたら\nいつでもお手伝いして\n欲しいな。"},
        { "location": "467/TALK"  , "narrator": "エリカ", "text": "その時は、いつでも\nここに戻って来てね？"},
        { "location": "470/ACT"   , "narrator": "", "text": "何か奢ってくれたらやってあげるよ"},
        { "location": "472/TALK"  , "narrator": "エリカ", "text": "ほんと？\nありがとう！"},
        { "location": "488/TALK"  , "narrator": "拘束されし者", "text": "ようこそ、\n記憶の空間へ。"},
        { "location": "489/TALK"  , "narrator": "拘束されし者", "text": "今回も前回に引き続き、\n卯月神楽の記憶を辿り、\n整合性を確認していく。"},
        { "location": "490/TALK"  , "narrator": "拘束されし者", "text": "共有する記憶に\n違和感を感じたら、\nそれを申告するように。"},
        { "location": "491/TALK"  , "narrator": "拘束されし者", "text": "今回共有する記憶は、\n前回の続き。"},
        { "location": "492/TALK"  , "narrator": "拘束されし者", "text": "FreyMENOWの\n活動最盛期の頃に\n焦点を当てる。"},
        { "location": "493/TALK"  , "narrator": "拘束されし者", "text": "彼女の記憶の中でも、\n最も現在に近い部分\nでもある。"},
        { "location": "494/TALK"  , "narrator": "拘束されし者", "text": "今回も\n$handle$に\n素敵な記憶の旅を――"},
        { "location": "507/TALK"  , "narrator": "拘束されし者", "text": "FreyMENOWは、日本の\nアーティスト、作詞家、\nストーリーテラー。"},
        { "location": "508/TALK"  , "narrator": "拘束されし者", "text": "デビュー当時の事務所は\nサンセットミュージック\nという小さな会社。"},
        { "location": "509/TALK"  , "narrator": "拘束されし者", "text": "しかし後に、エンタングル\n傘下のアップサイド\nサウンズに移籍する。"},
        { "location": "513/TALK"  , "narrator": "拘束されし者", "text": "これがきっかけで、\nFreyMENOWは大きく\n躍進することになる。"},
        { "location": "514/TALK"  , "narrator": "拘束されし者", "text": "それまでは、知る人ぞ知る\nアーティストで、ライブ\n規模も二千人程度。"},
        { "location": "515/TALK"  , "narrator": "拘束されし者", "text": "それが一気に、ファンで\nドームを満たすほどの力を\n持つようになった。"},
        { "location": "516/TALK"  , "narrator": "拘束されし者", "text": "これは彼女の力による\nところもあるが、新事務所\nの力も無視できない。"},
        { "location": "517/TALK"  , "narrator": "拘束されし者", "text": "卯月神楽にとって、\n事務所の移籍は\n一大決心だった。"},
        { "location": "518/TALK"  , "narrator": "拘束されし者", "text": "そしてその後押しを\nしたのは、彼女の親友の\n如月音羽だった。"},
        { "location": "522/TALK"  , "narrator": "拘束されし者", "text": "如月音羽は、卯月神楽に\n貴方は今以上の力を持って\nいると、可能性を説いた。"},
        { "location": "523/TALK"  , "narrator": "拘束されし者", "text": "そして、若干の窮屈さは\nあっても、大成の足がかり\nとして移籍すべきだと。"},
        { "location": "524/TALK"  , "narrator": "拘束されし者", "text": "元々この移籍話自体が、\nアップサイドサウンズの\nスカウトによるもの。"},
        { "location": "525/TALK"  , "narrator": "拘束されし者", "text": "これを逃したら、次の\nチャンスはいつ来るか\nわからないと説いたのだ。"},
        { "location": "526/TALK"  , "narrator": "拘束されし者", "text": "作品性やアーティストと\nしてのこだわりについて、\n何度も二人で議論した。"},
        { "location": "527/TALK"  , "narrator": "拘束されし者", "text": "その結果、卯月神楽は\nアップサイドサウンズへの\n移籍を決めたのだ。"},
        { "location": "531/TALK"  , "narrator": "拘束されし者", "text": "結果、FreyMENOWは\n大ヒットを飛ばし、\n大きく名をあげた。"},
        { "location": "532/TALK"  , "narrator": "拘束されし者", "text": "もちろん、前の事務所ほど\n自由にやらせてもらえる\nわけではなかった。"},
        { "location": "533/TALK"  , "narrator": "拘束されし者", "text": "音楽性もマーケティングが\n介入し、今のトレンドに\nシフトする形となった。"},
        { "location": "534/TALK"  , "narrator": "拘束されし者", "text": "けれども、これは彼女の\n活動にとって、大きな\nステップとなった。"},
        { "location": "535/TALK"  , "narrator": "拘束されし者", "text": "FreyMENOWとは、\nもちろん卯月神楽の力で\n作られたものであるが――"},
        { "location": "536/TALK"  , "narrator": "拘束されし者", "text": "それが沢山の人に愛される\nことになったのには、\n如月音羽の功績も大きい。"},
        { "location": "537/TALK"  , "narrator": "拘束されし者", "text": "二人は親友であり、\n創作における、真の\nパートナーでもあるのだ。"},
        { "location": "538/TALK"  , "narrator": "拘束されし者", "text": "その後、卯月神楽は\n日本国内でアーティスト\n活動を続ける。"},
        { "location": "539/TALK"  , "narrator": "拘束されし者", "text": "そして、とあるGWの\nドームでのライブの日――"},
        { "location": "540/TALK"  , "narrator": "拘束されし者", "text": "ライブ中の会場が\nフェノメノンに包まれる\n事件が発生したのだ。"},
        { "location": "548/TALK"  , "narrator": "拘束されし者", "text": "ライブラリ\nEOF/."},
        { "location": "549/TALK"  , "narrator": "拘束されし者", "text": "今回の検索範囲における\n全文リードを終了した。"},
        { "location": "550/TALK"  , "narrator": "拘束されし者", "text": "今回何か、\n違和感を感じたところは？"},
        { "location": "551/SEL"   , "narrator": "", "text": "無いと思う"},
        { "location": "552/SEL"   , "narrator": "", "text": "あると思う"},
        { "location": "553/ACT"   , "narrator": "", "text": "無いと思う"},
        { "location": "555/TALK"  , "narrator": "拘束されし者", "text": "わかった。"},
        { "location": "556/TALK"  , "narrator": "拘束されし者", "text": "それでは今回は、\nこれにて。"},
        { "location": "557/ACT"   , "narrator": "", "text": "あると思う"},
        { "location": "560/TALK"  , "narrator": "拘束されし者", "text": "では、貴方の知る知識との\n乖離点はどこかを\n教えて欲しい。"},
        { "location": "561/SEL"   , "narrator": "", "text": "神楽は無理矢理アップサイドサウンズに移籍させられたはず"},
        { "location": "562/SEL"   , "narrator": "", "text": "神楽がずっと日本にいたというのはおかしい"},
        { "location": "563/ACT"   , "narrator": "", "text": "神楽は無理矢理アップサイドサウンズに移籍させられたはず"},
        { "location": "567/TALK"  , "narrator": "拘束されし者", "text": "なるほど。\n理解した。"},
        { "location": "568/TALK"  , "narrator": "拘束されし者", "text": "では今より\nその記憶のアドレスを\n取得する。"},
        { "location": "569/TALK"  , "narrator": "拘束されし者", "text": "そのアドレスに向かえば、\n歪みと、改ざん者の思念を\n確認できるだろう。"},
        { "location": "570/TALK"  , "narrator": "拘束されし者", "text": "アドレスは――"},
        { "location": "571/TALK"  , "narrator": "拘束されし者", "text": "2x701。"},
        { "location": "572/ACT"   , "narrator": "", "text": "神楽がずっと日本にいたというのはおかしい"},
        { "location": "576/TALK"  , "narrator": "拘束されし者", "text": "なるほど。\n理解した。"},
        { "location": "577/TALK"  , "narrator": "拘束されし者", "text": "では今より\nその記憶のアドレスを\n取得する。"},
        { "location": "578/TALK"  , "narrator": "拘束されし者", "text": "そのアドレスに向かえば、\n歪みと、改ざん者の思念を\n確認できるだろう。"},
        { "location": "579/TALK"  , "narrator": "拘束されし者", "text": "アドレスは――"},
        { "location": "580/TALK"  , "narrator": "拘束されし者", "text": "2x70E。"},
        { "location": "582/TALK"  , "narrator": "拘束されし者", "text": "これで私がお前に\n成すべき事は全て\n終了した。"},
        { "location": "583/TALK"  , "narrator": "拘束されし者", "text": "後は、お前の判断と行動が\n全てを決定づけるだろう。"},
        { "location": "584/TALK"  , "narrator": "拘束されし者", "text": "それでは、\nまた会う日まで。"},
        { "location": "585/SEL"   , "narrator": "", "text": "待って、貴方は何者なの？"},
        { "location": "586/ACT"   , "narrator": "", "text": "待って、貴方は何者なの？"},
        { "location": "588/TALK"  , "narrator": "拘束されし者", "text": "今それを、お前に\n伝えることはできない。"},
        { "location": "589/TALK"  , "narrator": "拘束されし者", "text": "その理由は、お前が\n卯月神楽に未来のことを\n言えない理由と一致する。"},
        { "location": "590/TALK"  , "narrator": "拘束されし者", "text": "願わくば、\n私とお前との関係がこれで\n最後とならんことを。"},
        { "location": "610/SEL"   , "narrator": "", "text": "ぴょんこ"},
        { "location": "611/ACT"   , "narrator": "", "text": "ぴょんこ"},
        { "location": "614/SEL"   , "narrator": "", "text": "いないか"},
        { "location": "615/ACT"   , "narrator": "", "text": "いないか"},
        { "location": "621/TALK"  , "narrator": "エリカ", "text": "お帰りなさい。"},
        { "location": "622/TALK"  , "narrator": "エリカ", "text": "違っている所は、見つかりましたでしょうか"},
        { "location": "624/SEL"   , "narrator": "", "text": "特に無かった"},
        { "location": "625/ACT"   , "narrator": "", "text": "特に無かった"},
        { "location": "627/TALK"  , "narrator": "エリカ", "text": "そうですか"},
        { "location": "628/TALK"  , "narrator": "エリカ", "text": "ではもう少しだけ、お力をお借りする事になりそうですね"},
        { "location": "629/TALK"  , "narrator": "エリカ", "text": "また何か見つかりましたら、是非お教えいただけますと幸いです"},
        { "location": "630/TALK"  , "narrator": "エリカ", "text": "いつもご協力いただきありがとうございます"},
        { "location": "635/SEL"   , "narrator": "", "text": "アドレスは【$19_addr$】"},
        { "location": "636/ACT"   , "narrator": "", "text": "アドレスは【$19_addr$】"},
        { "location": "638/TALK"  , "narrator": "エリカ", "text": "ありがとうございます"},
        { "location": "639/TALK"  , "narrator": "エリカ", "text": "それでは、調査しますので少々お待ちください"},
        { "location": "640/SEL"   , "narrator": "", "text": "えっと、本当にエリカさん？"},
        { "location": "641/ACT"   , "narrator": "", "text": "えっと、本当にエリカさん？"},
        { "location": "643/TALK"  , "narrator": "エリカ", "text": "はい、そうです"},
        { "location": "644/SEL"   , "narrator": "", "text": "なんで事務的なの？"},
        { "location": "645/ACT"   , "narrator": "", "text": "なんで事務的なの？"},
        { "location": "647/TALK"  , "narrator": "エリカ", "text": "すみません。書き言葉だとどうしてもこうなってしまって"},
        { "location": "648/TALK"  , "narrator": "エリカ", "text": "お仕事関連でしか、チャットは使わないものですから、なんだか普段使いの言葉で書くことができないんです"},
        { "location": "649/SEL"   , "narrator": "", "text": "そうなんだ"},
        { "location": "650/SEL"   , "narrator": "", "text": "さすが、キャリアウーマンって感じだね！"},
        { "location": "651/ACT"   , "narrator": "", "text": "そうなんだ"},
        { "location": "652/TALK"  , "narrator": "エリカ", "text": "はい"},
        { "location": "653/ACT"   , "narrator": "", "text": "さすが、キャリアウーマンって感じだね！"},
        { "location": "654/TALK"  , "narrator": "エリカ", "text": "いえ、そんな格好いいものではありませんから…"},
        { "location": "657/SEL"   , "narrator": "", "text": "まだかかりそう？"},
        { "location": "658/ACT"   , "narrator": "", "text": "まだかかりそう？"},
        { "location": "660/TALK"  , "narrator": "エリカ", "text": "そうですね"},
        { "location": "661/TALK"  , "narrator": "エリカ", "text": "それなりに時間がかかると思います"},
        { "location": "662/SEL"   , "narrator": "", "text": "じゃあエリカの昔話とかして"},
        { "location": "663/SEL"   , "narrator": "", "text": "じゃあその$19_addr$に行きたいんだけど"},
        { "location": "664/ACT"   , "narrator": "", "text": "じゃあエリカの昔話とかして"},
        { "location": "665/TALK"  , "narrator": "エリカ", "text": "ええっ、そういうのは難しいですね"},
        { "location": "666/TALK"  , "narrator": "エリカ", "text": "話すとしても、妹に許可を得ないといけなそうなお話が多いので…"},
        { "location": "667/TALK"  , "narrator": "エリカ", "text": "あっ、それより"},
        { "location": "668/TALK"  , "narrator": "エリカ", "text": "すっかり忘れてたのですが、$19_addr$に行って頂けないでしょうか？"},
        { "location": "669/SEL"   , "narrator": "", "text": "なんで？"},
        { "location": "670/ACT"   , "narrator": "", "text": "なんで？"},
        { "location": "672/TALK"  , "narrator": "エリカ", "text": "改ざんアドレスに残った思念を確認しなければなりません"},
        { "location": "673/TALK"  , "narrator": "エリカ", "text": "元々、原因を突き止めるという話から始まったものですし"},
        { "location": "674/SEL"   , "narrator": "", "text": "ああ、そうか"},
        { "location": "675/ACT"   , "narrator": "", "text": "ああ、そうか"},
        { "location": "677/ACT"   , "narrator": "", "text": "じゃあその$19_addr$に行きたいんだけど"},
        { "location": "678/TALK"  , "narrator": "エリカ", "text": "どうしてですか？"},
        { "location": "679/SEL"   , "narrator": "", "text": "誰が改ざんしたのか、痕跡が残ってるから突き止めるって話だった気が"},
        { "location": "680/ACT"   , "narrator": "", "text": "誰が改ざんしたのか、痕跡が残ってるから突き止めるって話だった気が"},
        { "location": "682/TALK"  , "narrator": "エリカ", "text": "あっそうですね、ごめんなさい、アドレス探すのに夢中になって忘れてました"},
        { "location": "684/TALK"  , "narrator": "エリカ", "text": "それでは、$19_addr$に転送します"},
        { "location": "685/TALK"  , "narrator": "エリカ", "text": "どうか気をつけて"},
        { "location": "733/TALK"  , "narrator": "つばめ", "text": "痛ああああいっ！！"},
        { "location": "734/SEL"   , "narrator": "", "text": "つばめ！？"},
        { "location": "735/ACT"   , "narrator": "", "text": "つばめ！？"},
        { "location": "737/TALK"  , "narrator": "つばめ", "text": "ふえええ、\nドアを開けるときは\n静かに開けてよぅ。"},
        { "location": "738/SEL"   , "narrator": "", "text": "なんでつばめがここに！？"},
        { "location": "739/ACT"   , "narrator": "", "text": "なんでつばめがここに！？"},
        { "location": "756/SEL"   , "narrator": "", "text": "？"},
        { "location": "757/ACT"   , "narrator": "", "text": "？"},
        { "location": "760/SEL"   , "narrator": "", "text": "誰かー？"},
        { "location": "761/ACT"   , "narrator": "", "text": "誰かー？"},
        { "location": "764/SEL"   , "narrator": "", "text": "誰もいない"},
        { "location": "765/ACT"   , "narrator": "", "text": "誰もいない"},
        { "location": "768/TALK"  , "narrator": "つばめ", "text": "誰かいるんですかぁ～！？"},
        { "location": "769/SEL"   , "narrator": "", "text": "！？"},
        { "location": "770/ACT"   , "narrator": "", "text": "！？"},
        { "location": "772/TALK"  , "narrator": "つばめ", "text": "ふえぇぇぇ……"},
        { "location": "773/SEL"   , "narrator": "", "text": "つばめ！！"},
        { "location": "774/ACT"   , "narrator": "", "text": "つばめ！！"},
        { "location": "777/TALK"  , "narrator": "つばめ", "text": "え？"},
        { "location": "780/TALK"  , "narrator": "つばめ", "text": "$handle$さん！？"},
