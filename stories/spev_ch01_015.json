        "title": "スペシャルエピソード",
        "sub_title": "努力の魔法"
    },
    "entry":
    [
        { "location": "30/TALK" , "narrator": "つばめ", "text": "む、むむむ…。\n難しいなぁ…。"},
        { "location": "31/TALK" , "narrator": "つばめ", "text": "形をうまく整えるのが…\nなかなかできないよ…"},
        { "location": "32/TALK" , "narrator": "つばめ", "text": "わぁ…すごい形に\nなっちゃった…。"},
        { "location": "36/TALK" , "narrator": "透明マリン・ザ・リード", "text": "いったん休憩に\nしましょう。"},
        { "location": "37/TALK" , "narrator": "透明マリン・ザ・リード", "text": "少しずつやっていけば\n大丈夫よ。"},
        { "location": "42/TALK" , "narrator": "つばめ", "text": "う、うん。\nそうするよ…。"},
        { "location": "43/SEL"  , "narrator": "（選択肢）", "text": "頑張って！"},
        { "location": "44/SEL"  , "narrator": "（選択肢）", "text": "形は味に関係ないよ"},
        { "location": "45/ACT"  , "narrator": "", "text": "頑張って！"},
        { "location": "59/TALK" , "narrator": "つばめ", "text": "ありがとう(´∀｀*)"},
        { "location": "61/TALK" , "narrator": "つばめ", "text": "$handle$さんに喜んでもらえるように頑張るょ"},
        { "location": "62/ACT"  , "narrator": "", "text": "形は味に関係ないよ"},
        { "location": "76/TALK" , "narrator": "つばめ", "text": "えっ"},
        { "location": "77/TALK" , "narrator": "つばめ", "text": "そんなことないょ"},
        { "location": "78/TALK" , "narrator": "つばめ", "text": "形も可愛いほうがきっと美味しく感じるょ\n(｡･ω･｡)"},
        { "location": "80/TALK" , "narrator": "つばめ", "text": "それじゃぁ、休憩してから続きをやるね"},
        { "location": "82/TALK" , "narrator": "つばめ", "text": "またあとでね\nヾ(｡>﹏<｡)ﾉﾞ"},
        { "location": "93/TALK" , "narrator": "つばめ", "text": "マリンちゃん、続きも\nよろしくお願いします！"},
        { "location": "97/TALK" , "narrator": "透明マリン・ザ・リード", "text": "ええ、それじゃあ\n頑張りましょうか。"},
        { "location": "110/TALK", "narrator": "透明つばめ", "text": "よし…と。"},
        { "location": "113/TALK", "narrator": "透明つばめ", "text": "できたー！"},
        { "location": "114/TALK", "narrator": "透明マリン・ザ・リード", "text": "おめでとう！\nつばめちゃん！\nよく頑張ったね。"},
        { "location": "115/TALK", "narrator": "透明つばめ", "text": "ありがとう！\nマリンちゃんの\nおかげだよ！"},
        { "location": "116/TALK", "narrator": "透明つばめ", "text": "マリンちゃんが丁寧に\n教えてくれるから――"},
        { "location": "117/TALK", "narrator": "透明つばめ", "text": "最初は不安だったけど\n頑張れたんだ！"},
        { "location": "119/TALK", "narrator": "つばめ", "text": "みんなが作ってるのに比べたら"},
        { "location": "120/TALK", "narrator": "つばめ", "text": "簡単なチョコだけど…"},
        { "location": "122/TALK", "narrator": "つばめ", "text": "マリンちゃんたちに手伝ってもらって作ったんだ（*'∀'人）"},
        { "location": "123/TALK", "narrator": "つばめ", "text": "途中でお鍋がぶわーっってなってびっくりしたょ"},
        { "location": "124/TALK", "narrator": "つばめ", "text": "卯月さんの冗談にもびっくりしちゃったヾ(｡>﹏<｡)ﾉﾞ"},
        { "location": "125/SEL" , "narrator": "（選択肢）", "text": "$me$も焦ったよ"},
        { "location": "126/SEL" , "narrator": "（選択肢）", "text": "神楽の話を信じてはいけない"},
        { "location": "127/ACT" , "narrator": "", "text": "$me$も焦ったよ"},
        { "location": "128/TALK", "narrator": "つばめ", "text": "ゎたしが信じちゃったせいで心配かけちゃったかな"},
        { "location": "129/TALK", "narrator": "つばめ", "text": "ごめんね(´つω・｀)ｼｭﾝ"},
        { "location": "130/ACT" , "narrator": "", "text": "神楽の話を信じてはいけない"},
        { "location": "131/TALK", "narrator": "つばめ", "text": "ええっ！"},
        { "location": "132/TALK", "narrator": "つばめ", "text": "そんなことないょ！(･ｪ･^ )( ^･ｪ･)"},
        { "location": "134/TALK", "narrator": "つばめ", "text": "神楽ちゃんもアーヤさんもとっても上手に作ってて"},
        { "location": "135/TALK", "narrator": "つばめ", "text": "ゎたしももっと頑張らなきゃって思ったょ"},
        { "location": "136/TALK", "narrator": "つばめ", "text": "次のバレンタインまでにはたくさん練習しようヽ(･ω･ )ゝ☆"},
        { "location": "137/SEL" , "narrator": "（選択肢）", "text": "もう１年後の話！？"},
        { "location": "138/SEL" , "narrator": "（選択肢）", "text": "つばめのチョコにはつばめの良さがあるよ"},
        { "location": "139/ACT" , "narrator": "", "text": "もう１年後の話！？"},
        { "location": "140/TALK", "narrator": "つばめ", "text": "あはは…気が早すぎるかな？"},
        { "location": "141/TALK", "narrator": "つばめ", "text": "でもちょっとずつ練習しておかないとね"},
        { "location": "142/ACT" , "narrator": "", "text": "つばめのチョコにはつばめの良さがあるよ"},
        { "location": "143/TALK", "narrator": "つばめ", "text": "そぅかな…？"},
        { "location": "144/TALK", "narrator": "つばめ", "text": "ちょっと照れるかも(●ﾉωﾉ)"},
        { "location": "146/TALK", "narrator": "つばめ", "text": "アーヤさんに"},
        { "location": "147/TALK", "narrator": "つばめ", "text": "ネットでチョコのレシピが投稿されてるサイトがあるって教えてもらって"},
        { "location": "148/TALK", "narrator": "つばめ", "text": "見てみたら"},
        { "location": "149/TALK", "narrator": "つばめ", "text": "すっごいたくさんのレシピがあって"},
        { "location": "150/TALK", "narrator": "つばめ", "text": "あれもこれも、作ってみたくなっちゃった"},
        { "location": "151/TALK", "narrator": "つばめ", "text": "かわぃぃチョコがいっぱぃだったょヽ(〃´∀`〃)ﾉ"},
        { "location": "153/TALK", "narrator": "つばめ", "text": "だから、色々できるようになりたいの"},
        { "location": "154/SEL" , "narrator": "（選択肢）", "text": "きっとできるよ"},
        { "location": "155/SEL" , "narrator": "（選択肢）", "text": "つばめの作った色々なチョコを食べたいな"},
        { "location": "156/ACT" , "narrator": "", "text": "きっとできるよ"},
        { "location": "157/TALK", "narrator": "つばめ", "text": "ありがとぅ"},
        { "location": "158/TALK", "narrator": "つばめ", "text": "$handle$さんにそう言ってもらえると"},
        { "location": "159/TALK", "narrator": "つばめ", "text": "なんとかなる気がするょ(●´ω｀●)ゞ"},
        { "location": "160/ACT" , "narrator": "", "text": "つばめの作った色々なチョコを食べたいな"},
        { "location": "161/TALK", "narrator": "つばめ", "text": "楽しみにしててね"},
        { "location": "164/TALK", "narrator": "透明つばめ", "text": "ところでマリンちゃんは\nどんなチョコレートを\n作ったの？"},
        { "location": "165/TALK", "narrator": "透明マリン・ザ・リード", "text": "私はチョコクリームの\n入ったロールケーキを\n作ったわ。"},
        { "location": "166/TALK", "narrator": "透明つばめ", "text": "わぁ、美味しそう！"},
        { "location": "167/TALK", "narrator": "透明マリン・ザ・リード", "text": "つばめちゃんも、\nお菓子作りに\n慣れれば――"},
        { "location": "168/TALK", "narrator": "透明マリン・ザ・リード", "text": "難しいチョコレートも\n作れるようになるから。"},
        { "location": "170/TALK", "narrator": "透明つばめ", "text": "あはは…。\nそうなれるといいな。"},
        { "location": "172/TALK", "narrator": "透明つばめ", "text": "今回は簡単な\nチョコレート\nだったけど――"},
        { "location": "173/TALK", "narrator": "透明つばめ", "text": "これで$handle$さんに\nプレゼントできるよ！"},
        { "location": "174/TALK", "narrator": "透明マリン・ザ・リード", "text": "ふふ、$handle$っていう\n人のことをとても大切に\n想っているのね。"},
        { "location": "175/TALK", "narrator": "透明つばめ", "text": "えへへ…。"},
        { "location": "177/SEL" , "narrator": "（選択肢）", "text": "ありがとう、つばめ"},
        { "location": "178/SEL" , "narrator": "（選択肢）", "text": "お疲れさま"},
        { "location": "179/ACT" , "narrator": "", "text": "ありがとう、つばめ"},
        { "location": "183/TALK", "narrator": "つばめ", "text": "こちらこそ、いつもありがとぅ"},
        { "location": "185/TALK", "narrator": "つばめ", "text": "ヾ(*´ｴ`*)ﾉ"},
        { "location": "186/ACT" , "narrator": "", "text": "お疲れさま"},
        { "location": "190/TALK", "narrator": "つばめ", "text": "大変だったけど"},
        { "location": "191/TALK", "narrator": "つばめ", "text": "なんとかできたょ"},
        { "location": "193/TALK", "narrator": "つばめ", "text": "$handle$さんにプレゼントしたいって思ったら(*≧∀≦*) "},
        { "location": "194/TALK", "narrator": "つばめ", "text": "難しい作業も頑張れたょ"},
        { "location": "195/TALK", "narrator": "つばめ", "text": "$handle$さんに喜んでもらえたら嬉しいな(●’3｀*)"}
    ]
}
