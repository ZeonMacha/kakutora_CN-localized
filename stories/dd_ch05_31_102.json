{
    "dir": "chap31/daydra/dd_ch05_31_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "31505",
        "cid": "kagura",
        "title": "005 メインストーリー",
        "sub_title": "完璧な交渉術＜後編＞"
    },
    "entry":
    [
        { "location": "748/TALK"   , "narrator": "神楽", "text": "……逆らうことなんて、\nできるわけがない。"},
        { "location": "749/TALK"   , "narrator": "神楽", "text": "わかりました。"},
        { "location": "750/TALK"   , "narrator": "千羽鶴", "text": "ありがと。"},
        { "location": "751/SEL"    , "narrator": "", "text": "千羽鶴やめて！"},
        { "location": "752/ACT"    , "narrator": "", "text": "千羽鶴やめて！"},
        { "location": "756/TALK"   , "narrator": "千羽鶴", "text": "……。"},
        { "location": "757/TALK"   , "narrator": "千羽鶴", "text": "残念だけど、\n貴方の入れ知恵による\n作戦も、ここでお終い。"},
        { "location": "758/TALK"   , "narrator": "千羽鶴", "text": "私はやっぱり、\n自分が信じる道を\n突き進むことにしたから。"},
        { "location": "780/TALK"   , "narrator": "千羽鶴", "text": "はぁ、はぁ…。\nここまで逃げれば、\nもう…。"},
        { "location": "781/TALK"   , "narrator": "珠緒先生", "text": "おーっほっほっほ！！\nそれで我々から\n逃げたつもり？"},
        { "location": "784/TALK"   , "narrator": "千羽鶴", "text": "ッ！？"},
        { "location": "786/TALK"   , "narrator": "珠緒先生", "text": "甘い、甘いわ！\n我々ＫＴＫ帝国から\n逃れようだなんて…。"},
        { "location": "787/TALK"   , "narrator": "珠緒先生", "text": "本気で想ってたの\nかしら、ちーちゃん？"},
        { "location": "788/TALK"   , "narrator": "千羽鶴", "text": "ＫＴＫ…、\n可愛い子、たくさん\n囲みたい帝国…。"},
        { "location": "789/TALK"   , "narrator": "千羽鶴", "text": "あなた達の\nやろうとしている\nことは、間違ってる！"},
        { "location": "790/TALK"   , "narrator": "珠緒先生", "text": "なんと愚かな！"},
        { "location": "791/TALK"   , "narrator": "珠緒先生", "text": "人としてこの世に\n生を受けた以上…。"},
        { "location": "792/TALK"   , "narrator": "珠緒先生", "text": "ハーレムを作ろうと\n願うのは当然のこと\nだとは思わない？"},
        { "location": "793/TALK"   , "narrator": "千羽鶴", "text": "女の子を洗脳してまで\n作るハーレムは、\n邪道よ！！"},
        { "location": "794/TALK"   , "narrator": "珠緒先生", "text": "洗脳ハーレムの\n良さがわからないとは\n哀れな…。"},
        { "location": "795/TALK"   , "narrator": "千羽鶴", "text": "あ、哀れなのは\nそっちでしょう！？"},
        { "location": "796/TALK"   , "narrator": "千羽鶴", "text": "いい大人が、\nそんな長いもみあげ\n垂らして！"},
        { "location": "797/TALK"   , "narrator": "珠緒先生", "text": "もみあげの長さが\n女子力の高さだと\nいうのを知らないの？"},
        { "location": "798/TALK"   , "narrator": "千羽鶴", "text": "…女子って年齢？"},
        { "location": "799/TALK"   , "narrator": "珠緒先生", "text": "心は常に乙女なの。"},
        { "location": "800/TALK"   , "narrator": "千羽鶴", "text": "ああ…背の低さも\n子供っぽさの\n現れなのね。"},
        { "location": "801/TALK"   , "narrator": "珠緒先生", "text": "なっ！？\nし、身長のことを\n言うなんて…。"},
        { "location": "802/TALK"   , "narrator": "珠緒先生", "text": "もう許さない！\n戦闘員！！"},
        { "location": "808/TALK"   , "narrator": "啓介", "text": "ホイサーッ！！"},
        { "location": "810/TALK"   , "narrator": "珠緒先生", "text": "ちーちゃんを\nチャチャッと\n捕まえちゃいなさい！"},
        { "location": "811/TALK"   , "narrator": "啓介", "text": "ホイサッサー！！"},
        { "location": "812/TALK"   , "narrator": "千羽鶴", "text": "くっ、こんなところで\n捕まるわけには…。"},
        { "location": "813/TALK"   , "narrator": "珠緒先生", "text": "逃げようとするなら\n容赦しないわ。"},
        { "location": "814/TALK"   , "narrator": "珠緒先生", "text": "戦闘員！\nヒゲアゴジョリジョリ\n攻撃よ！！"},
        { "location": "816/TALK"   , "narrator": "啓介", "text": "ホイホイサー！！"},
        { "location": "818/TALK"   , "narrator": "千羽鶴", "text": "ちょ、キモっ！？\nイヤァァァァァッ！！"},
        { "location": "819/TALK"   , "narrator": "神楽", "text": "そこまでよ！！"},
        { "location": "822/TALK"   , "narrator": "千羽鶴", "text": "えっ！？"},
        { "location": "823/TALK"   , "narrator": "珠緒先生", "text": "こ、この声は！！"},
        { "location": "825/TALK"   , "narrator": "神楽", "text": "大好きなみんなの\n夢と希望と平和。"},
        { "location": "826/TALK"   , "narrator": "神楽", "text": "愛の力で、\nぜーんぶ護っちゃう！"},
        { "location": "831/TALK"   , "narrator": "神楽", "text": "魔法の戦乙女、\nマジカルメノウ！"},
        { "location": "833/TALK"   , "narrator": "珠緒先生", "text": "ま、マジカルメノウ！\n性懲りもなく、\nまた邪魔をしに…。"},
        { "location": "834/TALK"   , "narrator": "千羽鶴", "text": "め、メノウさん！！\n助けに来てくれたん\nですね！！"},
        { "location": "836/TALK"   , "narrator": "神楽", "text": "ううん、違うわ。"},
        { "location": "837/TALK"   , "narrator": "神楽", "text": "あなたのことを\n迎えに来たのよ。"},
        { "location": "838/TALK"   , "narrator": "千羽鶴", "text": "ど、どうして？"},
        { "location": "839/TALK"   , "narrator": "神楽", "text": "あなたには…、\n魔法少女の素質が\nあるのよ。"},
        { "location": "841/TALK"   , "narrator": "千羽鶴", "text": "え、えぇーっ！？"},
        { "location": "842/TALK"   , "narrator": "珠緒先生", "text": "ま、まさか…。\n魔法少女が二人に\n増えるというの！？"},
        { "location": "843/TALK"   , "narrator": "神楽", "text": "さあ、私に続いて。\n変身するための\n魔法を教えるわ。"},
        { "location": "845/TALK"   , "narrator": "千羽鶴", "text": "わ、私が、\n魔法少女に…。"},
        { "location": "846/TALK"   , "narrator": "珠緒先生", "text": "させないわ！\n戦闘員！！"},
        { "location": "848/TALK"   , "narrator": "啓介", "text": "ホホホイサッサー！！"},
        { "location": "849/TALK"   , "narrator": "神楽", "text": "レジストリー・\nクリーンナップ！！"},
        { "location": "850/TALK"   , "narrator": "千羽鶴", "text": "れ、レジストリー・\nクリーンナップ！！"},
        { "location": "856/TALK"   , "narrator": "珠緒先生", "text": "くっ、しまった！！"},
        { "location": "857/TALK"   , "narrator": "千羽鶴", "text": "わ、私…、\n本当に魔法少女に\nなれるのね！！"},
        { "location": "877/TALK"   , "narrator": "神楽", "text": "ちはるさん。"},
        { "location": "881/TALK"   , "narrator": "神楽", "text": "ごきげんよう、\nちはるさん。"},
        { "location": "883/TALK"   , "narrator": "千羽鶴", "text": "あら、卯月さん。\nごきげんよう。"},
        { "location": "884/TALK"   , "narrator": "千羽鶴", "text": "今日はとてもいい\nお天気ですね。"},
        { "location": "885/TALK"   , "narrator": "神楽", "text": "ええ。今朝は早くから\n小鳥たちも元気に\n鳴いていて…。"},
        { "location": "886/TALK"   , "narrator": "神楽", "text": "その声で、気持ちよく\n目を覚ましましたわ。"},
        { "location": "887/TALK"   , "narrator": "千羽鶴", "text": "ふふっ、とても素敵な\nお目覚めでしたのね。"},
        { "location": "888/TALK"   , "narrator": "女子高校生Ａ", "text": "あら、二人とも\nごきげんよう。"},
        { "location": "909/TALK"   , "narrator": "神楽", "text": "あら、松崎さん。\nごきげんよう。"},
        { "location": "911/TALK"   , "narrator": "千羽鶴", "text": "…ごきげんよう。"},
        { "location": "913/TALK"   , "narrator": "女子高校生Ａ", "text": "卯月さん。\nまだこの学校に\nいらしたんですね？"},
        { "location": "914/TALK"   , "narrator": "神楽", "text": "え？"},
        { "location": "915/TALK"   , "narrator": "女子高校生Ａ", "text": "いえ、てっきりもう\n転校したものと\n思ってましたから。"},
        { "location": "917/TALK"   , "narrator": "女子高校生Ｂ", "text": "クラスの子達も、\nきっと驚かれると\n思いますわ。"},
        { "location": "918/TALK"   , "narrator": "千羽鶴", "text": "…………。"},
        { "location": "919/TALK"   , "narrator": "神楽", "text": "はあ…。"},
        { "location": "920/TALK"   , "narrator": "神楽", "text": "…飽きないなぁ。\n毎日のように\n嫌がらせしてきて…。"},
        { "location": "921/TALK"   , "narrator": "神楽", "text": "まあ、流しておけば\nいいだけだから、\nラクではあるけど。"},
        { "location": "922/TALK"   , "narrator": "神楽", "text": "とにかく、\n私に転校の予定は\nありませんので。"},
        { "location": "923/TALK"   , "narrator": "神楽", "text": "誤解が解けたのなら、\n失礼しますね。"},
        { "location": "924/TALK"   , "narrator": "女子高校生Ｂ", "text": "転校するときには、\n是非一声かけて\nくださいね。"},
        { "location": "926/TALK"   , "narrator": "神楽", "text": "…………。"},
        { "location": "927/TALK"   , "narrator": "千羽鶴", "text": "…いい加減に\nしなさいよ、\nあなた達。"},
        { "location": "928/TALK"   , "narrator": "女子高校生Ａ", "text": "えっ？"},
        { "location": "929/TALK"   , "narrator": "千羽鶴", "text": "さっきから聞いてれば\n言いたい放題\n言ってくれて…。"},
        { "location": "930/TALK"   , "narrator": "千羽鶴", "text": "ケンカ売ってるわけ？"},
        { "location": "931/TALK"   , "narrator": "女子高校生Ｂ", "text": "まあ！？\nなんて汚い言葉！！"},
        { "location": "932/TALK"   , "narrator": "千羽鶴", "text": "お上品な言葉で\n悪口を言うよりは\nマシよ。"},
        { "location": "933/TALK"   , "narrator": "女子高校生Ａ", "text": "なっ！？"},
        { "location": "935/TALK"   , "narrator": "神楽", "text": "ち、ちはるさん。\nいいですから…。"},
        { "location": "937/TALK"   , "narrator": "千羽鶴", "text": "よくない！"},
        { "location": "938/TALK"   , "narrator": "千羽鶴", "text": "友達が酷いことを\n言われてるのに、\n黙ってられないわ！"},
        { "location": "939/TALK"   , "narrator": "神楽", "text": "ちはるさん…。"},
        { "location": "940/TALK"   , "narrator": "神楽", "text": "私のために…、\nこんなに怒ってくれる\nなんて…。"},
        { "location": "941/TALK"   , "narrator": "神楽", "text": "そういえば、\n前にもこんなことが\nあったっけ。"},
        { "location": "942/TALK"   , "narrator": "神楽", "text": "あの時は…音羽が、\n私のことを\n庇ってくれて…。"},
        { "location": "943/TALK"   , "narrator": "女子高校生Ａ", "text": "…あなた達のような\n野蛮な方と、これ以上\n話していられないわ。"},
        { "location": "945/TALK"   , "narrator": "女子高校生Ａ", "text": "行きましょう。"},
        { "location": "950/TALK"   , "narrator": "千羽鶴", "text": "野蛮はどっちよ、\nまったく…。"},
        { "location": "969/TALK"   , "narrator": "千羽鶴", "text": "…卯月さん、\n大丈夫？"},
        { "location": "971/TALK"   , "narrator": "神楽", "text": "…はい。\n慣れてますから…。"},
        { "location": "972/TALK"   , "narrator": "千羽鶴", "text": "…ダメよ。"},
        { "location": "973/TALK"   , "narrator": "千羽鶴", "text": "こんなこと、\n慣れていいことじゃ\nないわ…。"},
        { "location": "974/TALK"   , "narrator": "神楽", "text": "私…。"},
        { "location": "975/TALK"   , "narrator": "神楽", "text": "私は…。"},
        { "location": "976/TALK"   , "narrator": "神楽", "text": "…慣れてなんか\nいなかったんだ。"},
        { "location": "977/TALK"   , "narrator": "神楽", "text": "私は…ずっと、\n辛かったんだ…。"},
        { "location": "978/TALK"   , "narrator": "千羽鶴", "text": "卯月さん。\n心配しないで。"},
        { "location": "979/TALK"   , "narrator": "千羽鶴", "text": "貴方には私が\nついているから。"},
        { "location": "980/TALK"   , "narrator": "千羽鶴", "text": "ずっとずっと、私が\n貴方を護ってあげる。"},
        { "location": "981/TALK"   , "narrator": "神楽", "text": "え…？\nちはるさん……？"},
        { "location": "983/TALK"   , "narrator": "千羽鶴", "text": "だって私、\n貴方のことが……"},
        { "location": "984/TALK"   , "narrator": "千羽鶴", "text": "貴方のことが、\n好きだから――"},
        { "location": "985/TALK"   , "narrator": "神楽", "text": "ちはる……さん…"},
        { "location": "986/TALK"   , "narrator": "千羽鶴", "text": "だめ。\nこれからは、\nちはるって呼んで。"},
        { "location": "987/TALK"   , "narrator": "神楽", "text": "……ちはる。"},
        { "location": "989/TALK"   , "narrator": "千羽鶴", "text": "ん――。"},
        { "location": "1011/TALK"  , "narrator": "神楽", "text": "……。"},
        { "location": "1013/TALK"  , "narrator": "神楽", "text": "あ、あれ？\nえっ！？"},
        { "location": "1014/TALK"  , "narrator": "千羽鶴", "text": "……何をやってるの？"},
        { "location": "1015/TALK"  , "narrator": "千羽鶴", "text": "ここは現実。\nトライコネクトは不可能。"},
        { "location": "1016/TALK"  , "narrator": "神楽", "text": "いえ、もちろん\nそうなんですけど！"},
        { "location": "1017/TALK"  , "narrator": "神楽", "text": "それは\nわかってるんですけど！"},
        { "location": "1019/TALK"  , "narrator": "神楽", "text": "ちょ、ちょっと！\nもう！\nどういうことなの！！"},
        { "location": "1020/SEL"   , "narrator": "", "text": "ごめん、ミスした"},
        { "location": "1021/ACT"   , "narrator": "", "text": "ごめん、ミスした"},
        { "location": "1025/TALK"  , "narrator": "神楽", "text": "えええええ……"},
        { "location": "1027/TALK"  , "narrator": "千羽鶴", "text": "卯月神楽。\n貴方はかなり精神が\n錯乱してる。"},
        { "location": "1028/TALK"  , "narrator": "千羽鶴", "text": "もはや私の指示通りに\n動いてもらう他ない。"},
        { "location": "1029/TALK"  , "narrator": "千羽鶴", "text": "残酷なようだけど、\nそれが貴方にとっても\n唯一の光への道。"},
        { "location": "1031/TALK"  , "narrator": "千羽鶴", "text": "早速、処置を開始する。\n卯月神楽を連れてきて。"},
        { "location": "1033/TALK"  , "narrator": "神楽", "text": "……。"},
        { "location": "1055/TALK"  , "narrator": "神楽", "text": "っ！？"},
        { "location": "1056/TALK"  , "narrator": "神楽", "text": "…ここは、\nフェノメノンの、\n中…？"},
        { "location": "1057/TALK"  , "narrator": "神楽", "text": "それじゃあ、\n今まで私が\n見てたのって…。"},
        { "location": "1058/TALK"  , "narrator": "神楽", "text": "$handle$さん、\nなんて世界を…。"},
        { "location": "1061/TALK"  , "narrator": "千羽鶴", "text": "…………。"},
        { "location": "1062/TALK"  , "narrator": "千羽鶴", "text": "で？\nなにがしたかったの？"},
        { "location": "1063/TALK"  , "narrator": "神楽", "text": "…いえ。"},
        { "location": "1065/TALK"  , "narrator": "神楽", "text": "したいのは、\nこれからですよ。"},
        { "location": "1066/TALK"  , "narrator": "神楽", "text": "今までのは、\n私にも想定外の\nことです。"},
        { "location": "1067/TALK"  , "narrator": "千羽鶴", "text": "どういうこと？"},
        { "location": "1068/SEL"   , "narrator": "", "text": "やあ"},
        { "location": "1069/ACT"   , "narrator": "", "text": "やあ"},
        { "location": "1072/TALK"  , "narrator": "千羽鶴", "text": "っ！？"},
        { "location": "1073/TALK"  , "narrator": "神楽", "text": "…こういうことです。"},
        { "location": "1074/TALK"  , "narrator": "千羽鶴", "text": "…そう。"},
        { "location": "1076/TALK"  , "narrator": "千羽鶴", "text": "やはり、貴方の\n仕業だったのね…。"},
        { "location": "1077/TALK"  , "narrator": "千羽鶴", "text": "どうやら私は、\nとんでもない人を\n異世界から…。"},
        { "location": "1078/TALK"  , "narrator": "千羽鶴", "text": "連れてきてしまった\nようね。"},
        { "location": "1079/SEL"   , "narrator": "", "text": "$me$は単なる凡人さ"},
        { "location": "1080/SEL"   , "narrator": "", "text": "今更気付いた？"},
        { "location": "1081/ACT"   , "narrator": "", "text": "$me$は単なる凡人さ"},
        { "location": "1083/TALK"  , "narrator": "千羽鶴", "text": "凡人がこんなこと\nできるはずない。"},
        { "location": "1084/ACT"   , "narrator": "", "text": "今更気付いた？"},
        { "location": "1086/TALK"  , "narrator": "千羽鶴", "text": "認めるわ。\n貴方を過小評価\nしてたみたい。"},
        { "location": "1088/TALK"  , "narrator": "千羽鶴", "text": "挨拶はこれくらい\nにして、そろそろ\n本題に入りたい。"},
        { "location": "1089/TALK"  , "narrator": "千羽鶴", "text": "貴方は、私になにを\n言いたいの？"},
        { "location": "1090/SEL"   , "narrator": "", "text": "単刀直入に言うと、これから千羽鶴がやろうとしていることでは、千羽鶴の理想は達成出来ない"},
        { "location": "1091/ACT"   , "narrator": "", "text": "単刀直入に言うと、これから千羽鶴がやろうとしていることでは、千羽鶴の理想は達成出来ない"},
        { "location": "1093/TALK"  , "narrator": "千羽鶴", "text": "…貴方の言葉が、\nデタラメである\n可能性もある。"},
        { "location": "1095/TALK"  , "narrator": "神楽", "text": "すぐにデタラメと\n思えないのは…。"},
        { "location": "1096/TALK"  , "narrator": "神楽", "text": "$handle$さんが\nウソを言っているとも\n思えないからでは？"},
        { "location": "1098/TALK"  , "narrator": "千羽鶴", "text": "…否定はしない。"},
        { "location": "1100/TALK"  , "narrator": "千羽鶴", "text": "それで？\n達成できないから、\n私にどうしろと？"},
        { "location": "1101/SEL"   , "narrator": "", "text": "$me$の作戦を検討して欲しい"},
        { "location": "1102/ACT"   , "narrator": "", "text": "$me$の作戦を検討して欲しい"},
        { "location": "1104/TALK"  , "narrator": "千羽鶴", "text": "…それを聞く前に、\n一つ質問。"},
        { "location": "1105/TALK"  , "narrator": "千羽鶴", "text": "貴方、誰の差し金？"},
        { "location": "1106/SEL"   , "narrator": "", "text": "2016年9月15日以降の千羽鶴"},
        { "location": "1107/ACT"   , "narrator": "", "text": "2016年9月15日以降の千羽鶴"},
        { "location": "1109/TALK"  , "narrator": "千羽鶴", "text": "…なるほど。"},
        { "location": "1110/TALK"  , "narrator": "千羽鶴", "text": "じゃあ、私がもし\nやめなかったと\nしたら…。"},
        { "location": "1111/TALK"  , "narrator": "千羽鶴", "text": "その時は、\nどうなってしまうの？"},
        { "location": "1112/SEL"   , "narrator": "", "text": "未来のことは言えない"},
        { "location": "1113/SEL"   , "narrator": "", "text": "フュージョンクランは音羽に破壊され、その後千羽鶴は誰かに撃たれる"},
        { "location": "1114/ACT"   , "narrator": "", "text": "未来のことは言えない"},
        { "location": "1115/TALK"  , "narrator": "千羽鶴", "text": "…ふざけてる？"},
        { "location": "1116/TALK"  , "narrator": "神楽", "text": "本当みたいですよ。\n私も、前に同じこと\n言われましたし…。"},
        { "location": "1117/TALK"  , "narrator": "千羽鶴", "text": "そう…。"},
        { "location": "1118/TALK"  , "narrator": "千羽鶴", "text": "だとしても、それで\n私が納得できると\n思ってる？"},
        { "location": "1119/SEL"   , "narrator": "", "text": "未来の自分からのメッセージだといえば解ってくれると信じてる"},
        { "location": "1120/ACT"   , "narrator": "", "text": "未来の自分からのメッセージだといえば解ってくれると信じてる"},
        { "location": "1122/TALK"  , "narrator": "千羽鶴", "text": "それが事実かどうか、\n判断するのは不可能。"},
        { "location": "1123/TALK"  , "narrator": "千羽鶴", "text": "貴方の言葉だけで\n信じるのは無理。"},
        { "location": "1124/TALK"  , "narrator": "千羽鶴", "text": "交渉は不可よ。\nけど――"},
        { "location": "1125/TALK"  , "narrator": "千羽鶴", "text": "ちゃんと未来の出来事を\n話せるなら話は別。"},
        { "location": "1126/SEL"   , "narrator": "", "text": "わかったよ、言える限界ギリギリで言うなら、千羽鶴は撃たれる"},
        { "location": "1127/ACT"   , "narrator": "", "text": "わかったよ、言える限界ギリギリで言うなら、千羽鶴は撃たれる"},
        { "location": "1129/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "1130/TALK"  , "narrator": "千羽鶴", "text": "なるほど。"},
        { "location": "1131/TALK"  , "narrator": "千羽鶴", "text": "ならば回避する為に\n対策を練ればいい。"},
        { "location": "1132/ACT"   , "narrator": "", "text": "フュージョンクランは音羽に破壊され、その後千羽鶴は誰かに撃たれる"},
        { "location": "1135/TALK"  , "narrator": "神楽", "text": "音羽が！？"},
        { "location": "1136/TALK"  , "narrator": "千羽鶴", "text": "…なるほど。\nそれは大問題。"},
        { "location": "1137/TALK"  , "narrator": "千羽鶴", "text": "けど、それがわかれば\n回避するだけ。"},
        { "location": "1138/TALK"  , "narrator": "千羽鶴", "text": "特に何かを変える\n必要はない。"},
        { "location": "1140/TALK"  , "narrator": "千羽鶴", "text": "よって、交渉不成立。"},
        { "location": "1142/SEL"   , "narrator": "", "text": "説明しにくいんだけど、回避されると困る"},
        { "location": "1143/SEL"   , "narrator": "", "text": "あまり脅したくないけど、このフェノメノンは$me$が管理してるから"},
        { "location": "1144/ACT"   , "narrator": "", "text": "説明しにくいんだけど、回避されると困る"},
        { "location": "1145/TALK"  , "narrator": "千羽鶴", "text": "貴方が困るなら、\n回避することは\nできないわね…。"},
        { "location": "1146/TALK"  , "narrator": "千羽鶴", "text": "なんて言うと思った？"},
        { "location": "1147/TALK"  , "narrator": "千羽鶴", "text": "貴方はつまり、\nどっちみち私は\n死んで…。"},
        { "location": "1148/TALK"  , "narrator": "千羽鶴", "text": "計画は未達成に\n終わるけれど、\nそれでも自分に従え。"},
        { "location": "1149/TALK"  , "narrator": "千羽鶴", "text": "そう言ってるって、\nわかってる？"},
        { "location": "1150/SEL"   , "narrator": "", "text": "もどかしいのはわかるけど、お願い、協力して！"},
        { "location": "1151/ACT"   , "narrator": "", "text": "もどかしいのはわかるけど、お願い、協力して！"},
        { "location": "1153/TALK"  , "narrator": "千羽鶴", "text": "本気でそう思うなら、\n頭がおかしいとしか\n思えない。"},
        { "location": "1154/ACT"   , "narrator": "", "text": "あまり脅したくないけど、このフェノメノンは$me$が管理してるから"},
        { "location": "1155/TALK"  , "narrator": "千羽鶴", "text": "…矛盾している。"},
        { "location": "1156/TALK"  , "narrator": "千羽鶴", "text": "その言葉は、\n脅しにしか\n聞こえない。"},
        { "location": "1158/SEL"   , "narrator": "", "text": "$me$は千羽鶴の指示に従ってるだけだよ"},
        { "location": "1159/ACT"   , "narrator": "", "text": "$me$は千羽鶴の指示に従ってるだけだよ"},
        { "location": "1161/TALK"  , "narrator": "千羽鶴", "text": "…………。"},
        { "location": "1162/SEL"   , "narrator": "", "text": "これで屈しないときは次の作戦も教えてもらってる"},
        { "location": "1163/ACT"   , "narrator": "", "text": "これで屈しないときは次の作戦も教えてもらってる"},
        { "location": "1166/TALK"  , "narrator": "千羽鶴", "text": "…なるほど。\n用意周到ね。"},
        { "location": "1167/SEL"   , "narrator": "", "text": "$me$がこんなに無理矢理なのは、$me$も千羽鶴の理想社会を応援しているからだよ？"},
        { "location": "1168/SEL"   , "narrator": "", "text": "$me$がこんなに無理矢理なのは、$me$が千羽鶴を好きだからだよ？"},
        { "location": "1169/ACT"   , "narrator": "", "text": "$me$がこんなに無理矢理なのは、$me$も千羽鶴の理想社会を応援しているからだよ？"},
        { "location": "1172/TALK"  , "narrator": "神楽", "text": "えっ、そうだったん\nですか！？"},
        { "location": "1174/TALK"  , "narrator": "千羽鶴", "text": "…普通に考えて、\n信用出来ない。"},
        { "location": "1175/TALK"  , "narrator": "千羽鶴", "text": "けど、話を聞く\nくらいはしても\nいいかも…。"},
        { "location": "1176/ACT"   , "narrator": "", "text": "$me$がこんなに無理矢理なのは、$me$が千羽鶴を好きだからだよ？"},
        { "location": "1177/TALK"  , "narrator": "千羽鶴", "text": "…まあ、好意を\n抱くのは自由よ。"},
        { "location": "1178/TALK"  , "narrator": "神楽", "text": "よかったですね、\n$handle$さん。"},
        { "location": "1179/TALK"  , "narrator": "千羽鶴", "text": "ただ、私から好意が\n向けられる可能性は\nゼロだけれど。"},
        { "location": "1181/TALK"  , "narrator": "千羽鶴", "text": "それで？\nどうするかの作戦を\n聞きたいのだけれど。"},
        { "location": "1182/SEL"   , "narrator": "", "text": "ファイルを展開するよ"},
        { "location": "1183/ACT"   , "narrator": "", "text": "ファイルを展開するよ"},
        { "location": "1185/TALK"  , "narrator": "千羽鶴", "text": "え、いきなり？"},
        { "location": "1201/TALK"  , "narrator": "神楽", "text": "…これは。"},
        { "location": "1203/TALK"  , "narrator": "千羽鶴", "text": "…なるほど。\n便利な世界ね。"},
        { "location": "1204/TALK"  , "narrator": "千羽鶴", "text": "ここにいるだけで、\n貴方の言いたいことを\n読み取れるなんて…。"},
        { "location": "1206/TALK"  , "narrator": "千羽鶴", "text": "つまり、私の\nフェノメノンの\n外側には…。"},
        { "location": "1207/TALK"  , "narrator": "千羽鶴", "text": "エリカの\nフェノメノンが\n存在している。"},
        { "location": "1208/TALK"  , "narrator": "千羽鶴", "text": "だから、この世界を\nエリカの世界に\nコピーして…。"},
        { "location": "1209/TALK"  , "narrator": "千羽鶴", "text": "その上で、私は\nフェノメノンを\n収束させればいい。"},
        { "location": "1210/TALK"  , "narrator": "千羽鶴", "text": "その後の流れは、\n私の世界に\n酷似した…。"},
        { "location": "1211/TALK"  , "narrator": "千羽鶴", "text": "エリカの\nフェノメノンが\n演じる。"},
        { "location": "1212/TALK"  , "narrator": "千羽鶴", "text": "殺される私も、\nエリカが用意した\n空想の生き物になる。"},
        { "location": "1214/TALK"  , "narrator": "神楽", "text": "…そして、彼らから\n世界を取り上げる\nために…。"},
        { "location": "1215/TALK"  , "narrator": "神楽", "text": "ライフギャザーの\n解析をしている\n最中だから…。"},
        { "location": "1216/TALK"  , "narrator": "神楽", "text": "後はただ大人しく\nしていろ、と。"},
        { "location": "1217/TALK"  , "narrator": "千羽鶴", "text": "ええ…そういうこと\nみたいね…。\nそうでしょう？"},
        { "location": "1218/SEL"   , "narrator": "", "text": "概ねあってる"},
        { "location": "1219/ACT"   , "narrator": "", "text": "概ねあってる"},
        { "location": "1222/TALK"  , "narrator": "千羽鶴", "text": "…わかった。\n大体は理解したわ。"},
        { "location": "1223/TALK"  , "narrator": "千羽鶴", "text": "最終的にこの世界\n全体を彼らの影の\n統治から引き剥がし。"},
        { "location": "1224/TALK"  , "narrator": "千羽鶴", "text": "私の考える理想的\n秩序を創世する\nチャンスが消えない。"},
        { "location": "1225/TALK"  , "narrator": "千羽鶴", "text": "むしろ、確実性が\n増すというのなら、\n協力しない手はない。"},
        { "location": "1228/TALK"  , "narrator": "神楽", "text": "よかったですね、\n$handle$さん！"},
        { "location": "1229/TALK"  , "narrator": "千羽鶴", "text": "ただ、最後に聞きたい\nことがある。"},
        { "location": "1230/TALK"  , "narrator": "千羽鶴", "text": "貴方は、この作戦を\n遂行したいと、\n本気で思ってる？"},
        { "location": "1232/TALK"  , "narrator": "神楽", "text": "本気で思わないなら、\nこんなこと言って\nこないんじゃ…？"},
        { "location": "1234/TALK"  , "narrator": "千羽鶴", "text": "かもしれない。\nけど、私はたった今\n聞いたばかり。"},
        { "location": "1235/TALK"  , "narrator": "千羽鶴", "text": "その中で判断しろと\nいうのなら、する。"},
        { "location": "1237/TALK"  , "narrator": "千羽鶴", "text": "けど、貴方はずっと\n前からこのことを\n聞かされて…。"},
        { "location": "1238/TALK"  , "narrator": "千羽鶴", "text": "色々と見てきた\nわけでしょう？"},
        { "location": "1239/TALK"  , "narrator": "千羽鶴", "text": "話が本当だとすると、\n私に召喚されてから、\n今の私よりも先…。"},
        { "location": "1240/TALK"  , "narrator": "千羽鶴", "text": "私が撃たれるまでを\n見た上で、その未来の\n私が提唱する…。"},
        { "location": "1241/TALK"  , "narrator": "千羽鶴", "text": "作戦を見て来ている\nわけよね？"},
        { "location": "1242/TALK"  , "narrator": "千羽鶴", "text": "なら、実際のところ、\n貴方的に見て\nどう思う？"},
        { "location": "1243/TALK"  , "narrator": "神楽", "text": "…$handle$さん\n個人の意見を聞いて、\n決めるつもりですか？"},
        { "location": "1246/TALK"  , "narrator": "千羽鶴", "text": "そう…。"},
        { "location": "1247/TALK"  , "narrator": "千羽鶴", "text": "少しでも、私よりも\n情報を持っている人の\n意見を参考にしたい。"},
        { "location": "1249/TALK"  , "narrator": "千羽鶴", "text": "貴方が諸手を上げて\n未来の私の計画を\n指示するのなら…。"},
        { "location": "1250/TALK"  , "narrator": "千羽鶴", "text": "言うまでもなく\n乗るつもり。"},
        { "location": "1251/TALK"  , "narrator": "千羽鶴", "text": "逆に、貴方が\n何らかのリスクを\n感じていたり…。"},
        { "location": "1252/TALK"  , "narrator": "千羽鶴", "text": "本当は嫌々言わされて\nいるのであれば、\n私は考えた上で…。"},
        { "location": "1253/TALK"  , "narrator": "千羽鶴", "text": "自分の作戦を\n遂行する決断をする\nかもしれない。"},
        { "location": "1254/TALK"  , "narrator": "千羽鶴", "text": "…だから、聞かせて。\n貴方が本当は、\nどう思っているのか。"},
        { "location": "1255/SEL"   , "narrator": "", "text": "自信を持ってお薦め出来る"},
        { "location": "1256/SEL"   , "narrator": "", "text": "色々問題はあるけど、千羽鶴が協力してくれれば上手くいくと思う"},
        { "location": "1257/SEL"   , "narrator": "", "text": "実はあまり良いとは思ってない"},
        { "location": "1258/SEL"   , "narrator": "", "text": "言わされてるだけ、本心では千羽鶴の計画を邁進して欲しい"},
        { "location": "1259/ACT"   , "narrator": "", "text": "自信を持ってお薦め出来る"},
        { "location": "1262/ACT"   , "narrator": "", "text": "色々問題はあるけど、千羽鶴が協力してくれれば上手くいくと思う"},
        { "location": "1265/ACT"   , "narrator": "", "text": "実はあまり良いとは思ってない"},
        { "location": "1268/ACT"   , "narrator": "", "text": "言わされてるだけ、本心では千羽鶴の計画を邁進して欲しい"},
        { "location": "1272/TALK"  , "narrator": "千羽鶴", "text": "そう…それが貴方の\n本心というわけね。"},
        { "location": "1273/TALK"  , "narrator": "神楽", "text": "…それで、どうする\nつもりなんですか？"},
        { "location": "1274/TALK"  , "narrator": "千羽鶴", "text": "そうね…。\n私は――"},
        { "location": "1276/TALK"  , "narrator": "千羽鶴", "text": "貴方の言うとおり、\n現在の計画は中止し、\n未来の作戦を遂行する。"},
        { "location": "1283/TALK"  , "narrator": "千羽鶴", "text": "やっぱり、\n自分が信じる道を\n突き進むことにする。"},
        { "location": "1284/TALK"  , "narrator": "千羽鶴", "text": "卯月神楽の歌で、\n逢瀬つばめを破壊する。"},
        { "location": "763/DIALOG" , "narrator": "Dialog_InfoOS", "text": "\n\n現在TRI-OSは“パラメトリック理論による世界進行法”による収束待機状態です。テーマは<color=green>【千羽鶴はどう行動するか】</color>です。\n\n現在の貴方の選択ルートは\n<color=green>【千羽鶴は、リプレイス前と同じ行動をとる】</color>\nです。\n\n\n<color=red>未来確定日は、\n対向時間における\n2018年6月4日0:00\nになります。\n\nその時点で最終的に貴方が選択しているルートが、貴方の回答になります。\n</color>\n"},
        { "location": "1038/DIALOG", "narrator": "Dialog_InfoOS", "text": "\n\n現在TRI-OSは“パラメトリック理論による世界進行法”による収束待機状態です。テーマは<color=green>【千羽鶴はどう行動するか】</color>です。\n\n現在の貴方の選択ルートは\n<color=green>【千羽鶴は、リプレイス前と同じ行動をとる】</color>\nです。\n\n\n<color=red>未来確定日は、\n対向時間における\n2018年6月4日0:00\nになります。\n\nその時点で最終的に貴方が選択しているルートが、貴方の回答になります。\n</color>\n"},
        { "location": "1281/DIALOG", "narrator": "Dialog_InfoOS", "text": "\n\n現在TRI-OSは“パラメトリック理論による世界進行法”による収束待機状態です。テーマは<color=green>【千羽鶴はどう行動するか】</color>です。\n\n現在の貴方の選択ルートは\n<color=green>【千羽鶴は、リプレイス後の作戦に転換する】</color>\nです。\n\n\n<color=red>未来確定日は、\n対向時間における\n2018年6月4日0:00\nになります。\n\nその時点で最終的に貴方が選択しているルートが、貴方の回答になります。\n</color>\n"},
        { "location": "1289/DIALOG", "narrator": "Dialog_InfoOS", "text": "\n\n現在TRI-OSは“パラメトリック理論による世界進行法”による収束待機状態です。テーマは<color=green>【千羽鶴はどう行動するか】</color>です。\n\n現在の貴方の選択ルートは\n<color=green>【千羽鶴は、リプレイス前と同じ行動をとる】</color>\nです。\n\n\n<color=red>未来確定日は、\n対向時間における\n2018年6月4日0:00\nになります。\n\nその時点で最終的に貴方が選択しているルートが、貴方の回答になります。\n</color>\n"},
        { "location": "1301/DIALOG", "narrator": "Dialog_chapter_ch05", "text": "【25 ワールド・スピード】"},
        { "location": "1313/DIALOG", "narrator": "Dialog_chapter_ch05", "text": "【25 ワールド・スピード】"}
