{
    "dir": "chap21/daydra/dd_ch04_21_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "21452",
        "cid": "miyabi",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "ゲームはないの？"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "ゲームはないの？"},
        { "location": "23/TALK"   , "narrator": "ガブリエラ", "text": "ねえ、みやび。\n何かパーティーゲーム\nみたいなのってないの？"},
        { "location": "25/TALK"   , "narrator": "みやび", "text": "そういえば、アプリで\n多人数プレイできるのが\nあったけんど…。"},
        { "location": "26/TALK"   , "narrator": "ガブリエラ", "text": "そういうのじゃなくて、\nボードゲームみたいな\nものよ。"},
        { "location": "30/TALK"   , "narrator": "みやび", "text": "ガブちゃん…\nうちの家やぞ？"},
        { "location": "31/TALK"   , "narrator": "みやび", "text": "そんな気の利いたものが\nあると思うんか？"},
        { "location": "34/TALK"   , "narrator": "神楽", "text": "まあ、みやびさんが\nご家族と一緒にゲームを\nする姿って――"},
        { "location": "35/TALK"   , "narrator": "神楽", "text": "ちょっと、\n想像できませんよね？"},
        { "location": "38/TALK"   , "narrator": "みやび", "text": "花札くらいなら\nどこかにあるけんど…。"},
        { "location": "40/TALK"   , "narrator": "つばめ", "text": "すみません。\nルール知らないです…。"},
        { "location": "42/TALK"   , "narrator": "ガブリエラ", "text": "あたし、実物触ったこと\nないわ。"},
        { "location": "44/TALK"   , "narrator": "アーヤ", "text": "っていうか、長時間\n遊ぶのには向いてない\n気がするわ。"},
        { "location": "45/TALK"   , "narrator": "みやび", "text": "それ以外にみんなで\n遊べるものいうたら――"},
        { "location": "47/TALK"   , "narrator": "みやび", "text": "…あっ、そういえば。"},
        { "location": "48/TALK"   , "narrator": "つばめ", "text": "何かあるんですか？"},
        { "location": "50/TALK"   , "narrator": "みやび", "text": "確か、物置に虫網と\n虫かごがあった気が\nするけんど…。"},
        { "location": "52/TALK"   , "narrator": "神楽", "text": "…最もみやびさんの家に\n合わなそうなんですけど？"},
        { "location": "54/TALK"   , "narrator": "ガブリエラ", "text": "お父さんが子供の頃に\n使ってた物なの？"},
        { "location": "56/TALK"   , "narrator": "みやび", "text": "いや、うちが子供の頃\n使うてたやつや。"},
        { "location": "58/TALK"   , "narrator": "みやび", "text": "これでも、昔は毎日\n虫網と虫かご持って――"},
        { "location": "59/TALK"   , "narrator": "みやび", "text": "セミやカブトムシ取りに\n行ってたちや。"},
        { "location": "60/TALK"   , "narrator": "つばめ", "text": "えっ！\nみやびさんが！？"},
        { "location": "62/TALK"   , "narrator": "みやび", "text": "つばめちゃん、\nその反応ナイスや。"},
        { "location": "63/TALK"   , "narrator": "アーヤ", "text": "みやびが虫取りって…\n想像つかないんだけど？"},
        { "location": "65/TALK"   , "narrator": "みやび", "text": "まあ、本当に大昔の\n話やきね。"},
        { "location": "67/TALK"   , "narrator": "みやび", "text": "よく捕まえた虫の\n観察日記をつけたり\nしちょったが。"},
        { "location": "68/TALK"   , "narrator": "神楽", "text": "…今、その面影まったく\n残ってませんよね？"},
        { "location": "69/SEL"    , "narrator": "", "text": "久しぶりに行こうよ"},
        { "location": "70/SEL"    , "narrator": "", "text": "何か暗い過去が！？"},
        { "location": "73/TALK"   , "narrator": "ガブリエラ", "text": "別人に入れ替わられた\nとしか思えないわ。"},
        { "location": "74/TALK"   , "narrator": "ガブリエラ", "text": "あんた、本当にみやび\nなんでしょうね？"},
        { "location": "77/TALK"   , "narrator": "みやび", "text": "別人やったとしても、\n今のうちしかガブちゃんは\n知らんやろ？"},
        { "location": "79/TALK"   , "narrator": "つばめ", "text": "…でも、本当にどうして\n外出嫌いになっちゃっ\nたんですか？"},
        { "location": "84/TALK"   , "narrator": "みやび", "text": "どうって…。"},
        { "location": "85/TALK"   , "narrator": "みやび", "text": "…………。"},
        { "location": "86/TALK"   , "narrator": "みやび", "text": "まあ、色々理由はある\nけんど――"},
        { "location": "88/TALK"   , "narrator": "みやび", "text": "うちも女やき、いつまでも\n虫取りに夢中になるような\nことはないし――"},
        { "location": "91/TALK"   , "narrator": "みやび", "text": "それに…よぉ一緒に\n遊んだ子が、いなくなって\nしもうて…。"},
        { "location": "92/TALK"   , "narrator": "アーヤ", "text": "…引っ越しでもしたの？"},
        { "location": "94/TALK"   , "narrator": "みやび", "text": "…まあ、そんなもんやと\n思うてもらえばえいよ。"},
        { "location": "96/TALK"   , "narrator": "みやび", "text": "そういうことがあって、\n今のうちが完成した、\nちゅうことや。"},
        { "location": "97/TALK"   , "narrator": "つばめ", "text": "そうだったんですか…。"},
        { "location": "99/TALK"   , "narrator": "ガブリエラ", "text": "…でもまあ、確かに\n年齢も上がれば――"},
        { "location": "100/TALK"  , "narrator": "ガブリエラ", "text": "虫取りに興味がなくなる\nのは当然よね？"},
        { "location": "102/TALK"  , "narrator": "みやび", "text": "まあ、ＰＣにハマり\n始めた頃は――"},
        { "location": "103/TALK"  , "narrator": "みやび", "text": "クワガタやカブトムシ\n繁殖させて売ろう思うた\nことはあったけんどね。"},
        { "location": "105/TALK"  , "narrator": "神楽", "text": "…観察日記を付けてた\n頃の純粋さは、どこに\n行っちゃったんですか？"},
        { "location": "107/ACT"   , "narrator": "", "text": "久しぶりに行こうよ"},
        { "location": "127/TALK"  , "narrator": "みやび", "text": "久しぶりレベルの話やないけんど"},
        { "location": "128/TALK"  , "narrator": "みやび", "text": "…まあ、みんな暇しちょるようだし、たまには変わったことするんもえいか"},
        { "location": "140/TALK"  , "narrator": "みやび", "text": "よし、みんな出掛ける\n準備しぃ。"},
        { "location": "142/TALK"  , "narrator": "アーヤ", "text": "どこに行くつもりなの？"},
        { "location": "143/TALK"  , "narrator": "みやび", "text": "この話の流れで行く\nところ言うたら、\n一つしかないやろ？"},
        { "location": "163/TALK"  , "narrator": "みやび", "text": "…よしっ、捕まえた！\nヒラタクワガタゲットや。"},
        { "location": "165/TALK"  , "narrator": "アーヤ", "text": "上手いわね。\n今の、飛び立つ瞬間\nだったわ。"},
        { "location": "168/TALK"  , "narrator": "みやび", "text": "久しぶりやけんど、\n身体が虫取りの動きを\n覚えちょるようやね。"},
        { "location": "170/TALK"  , "narrator": "みやび", "text": "ほれ、そっちの三人。\n可愛いヒラタゲット\nしたぞね。"},
        { "location": "173/TALK"  , "narrator": "神楽", "text": "い、いいです！\n見せないでください\nそんなの！"},
        { "location": "177/TALK"  , "narrator": "ガブリエラ", "text": "お腹の方見せないで！\n足ワキワキしてて\n気持ち悪いから！"},
        { "location": "178/TALK"  , "narrator": "みやび", "text": "なんやそれ？\nつばめちゃん、ほれ、\nこっち見てみぃ。"},
        { "location": "181/TALK"  , "narrator": "つばめ", "text": "ちょ、ちょっと、\n見るのも怖いんで…。"},
        { "location": "183/TALK"  , "narrator": "みやび", "text": "…最近の子は、\nみんな怖がりやね。"},
        { "location": "184/TALK"  , "narrator": "アーヤ", "text": "大して年齢変わらない\nでしょ？"},
        { "location": "187/TALK"  , "narrator": "神楽", "text": "っていうか、みやびさん。\nどうして私達まで――"},
        { "location": "188/TALK"  , "narrator": "神楽", "text": "虫取りに付き合わなくちゃ\nいけないんですか！？"},
        { "location": "189/TALK"  , "narrator": "みやび", "text": "あんたら、普段海行こう\n出掛けよう言うて、\nうちを誘うやろ？"},
        { "location": "190/TALK"  , "narrator": "みやび", "text": "それやったら、たまには\nうちの誘いに乗ってくれ\nてもえいやろ。"},
        { "location": "193/TALK"  , "narrator": "つばめ", "text": "む、虫取り以外じゃ\nダメなんですか…？"},
        { "location": "195/TALK"  , "narrator": "みやび", "text": "ダメやないけんど、\n急に思いついたんが\n虫取りだったんよ。"},
        { "location": "198/TALK"  , "narrator": "アーヤ", "text": "…よし！\nクマゼミ捕まえたわ。"},
        { "location": "201/TALK"  , "narrator": "みやび", "text": "素手でいったか。"},
        { "location": "203/TALK"  , "narrator": "アーヤ", "text": "ふふっ…昔はよく、\nこうやって捕まえて\nたっけ…。"},
        { "location": "205/TALK"  , "narrator": "アーヤ", "text": "さ、もういいわ。\n逃げなさい。"},
        { "location": "206/TALK"  , "narrator": "みやび", "text": "…こうして童心に\n返って遊ぶんも――"},
        { "location": "208/TALK"  , "narrator": "みやび", "text": "たまにはえいのかも\nしれんね。"},
        { "location": "211/TALK"  , "narrator": "アーヤ", "text": "ええ、意外と楽しいわ。"},
        { "location": "214/TALK"  , "narrator": "アーヤ", "text": "…ただ、良い年した\n女子が集まってする\n遊びではないわね…。"},
        { "location": "217/TALK"  , "narrator": "神楽", "text": "もうダメです！\nもう限界です！！"},
        { "location": "218/TALK"  , "narrator": "神楽", "text": "みやびさん！\n私、先に戻りますね！"},
        { "location": "228/TALK"  , "narrator": "ガブリエラ", "text": "あっ、卑怯よ！！\n逃げるならあたしも\n連れて行きなさい！"},
        { "location": "231/TALK"  , "narrator": "つばめ", "text": "わ、わたしも！\n置いてかないでぇー！"},
        { "location": "232/ACT"   , "narrator": "", "text": "何か暗い過去が！？"},
        { "location": "252/TALK"  , "narrator": "みやび", "text": "ん…まあ、そうやね"},
        { "location": "253/TALK"  , "narrator": "みやび", "text": "一緒に遊んでた子が、いなくなっちゅうて…"},
        { "location": "254/TALK"  , "narrator": "みやび", "text": "まあ、それだけが理由じゃないんやけんどね"},
        { "location": "265/TALK"  , "narrator": "みやび", "text": "…もしかして、うちに\n何かしら暗い過去が\nあって――"},
        { "location": "266/TALK"  , "narrator": "みやび", "text": "そのせいで外出嫌いに\nなった思うてたりする？"},
        { "location": "268/TALK"  , "narrator": "ガブリエラ", "text": "そうじゃないの？"},
        { "location": "270/TALK"  , "narrator": "神楽", "text": "元気に外で遊んでた子が、\nこんなに外出嫌いに\nなっちゃったんです。"},
        { "location": "271/TALK"  , "narrator": "神楽", "text": "事件の香りがしても\nおかしくありません！"},
        { "location": "274/TALK"  , "narrator": "つばめ", "text": "う、卯月さん、\nワクワクしてない？"},
        { "location": "276/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "278/TALK"  , "narrator": "みやび", "text": "まあ、そうやね。\nあれは確かに、\n事件やったし…。"},
        { "location": "281/TALK"  , "narrator": "アーヤ", "text": "えっ…どういうこと？"},
        { "location": "284/TALK"  , "narrator": "みやび", "text": "…あれは、うちがまだ\n小学生の頃やった。"},
        { "location": "286/TALK"  , "narrator": "みやび", "text": "あの日、うちは友達と\n一緒に、近所の林に\n遊びに行っとった。"},
        { "location": "287/TALK"  , "narrator": "みやび", "text": "クワガタやカブトムシ、\nバッタやら色々捕まえて\n楽しんでいたんよ。"},
        { "location": "289/TALK"  , "narrator": "神楽", "text": "…そんな虫だらけの\nカゴを想像するだけでも\nホラーなんですけど…。"},
        { "location": "290/TALK"  , "narrator": "みやび", "text": "まあ、思いの外大量に\n捕れたき、上機嫌に\nなったうちは――"},
        { "location": "291/TALK"  , "narrator": "みやび", "text": "一人で林の奥に\n入っていったんよ。"},
        { "location": "293/TALK"  , "narrator": "みやび", "text": "そこは暗くて肌寒ぅて、\nまっこと静かで――"},
        { "location": "294/TALK"  , "narrator": "みやび", "text": "…何か、臭ぅて。"},
        { "location": "297/TALK"  , "narrator": "つばめ", "text": "…に、臭い、ですか？"},
        { "location": "300/TALK"  , "narrator": "みやび", "text": "…思い出すのも嫌な、\n何かが腐った臭いや。"},
        { "location": "303/TALK"  , "narrator": "みやび", "text": "うちは最初、生ごみでも\n不法投棄されとるんか\n思うてたんやけんど――"},
        { "location": "304/TALK"  , "narrator": "みやび", "text": "大きな木の下を通り\n掛かった時、その正体が\nわかったんや。"},
        { "location": "306/TALK"  , "narrator": "ガブリエラ", "text": "ま、まさか！"},
        { "location": "308/TALK"  , "narrator": "みやび", "text": "そう…。"},
        { "location": "310/TALK"  , "narrator": "みやび", "text": "木の枝の先からな、\nこう、ブラーンと…。"},
        { "location": "313/TALK"  , "narrator": "アーヤ", "text": "も、もういい！！\nもういいから、ストップ！"},
        { "location": "322/TALK"  , "narrator": "アーヤ", "text": "もう十分よ！\n外出嫌いになった理由、\nよくわかったから！"},
        { "location": "324/TALK"  , "narrator": "ガブリエラ", "text": "…聞いててゾッとしたわ。"},
        { "location": "325/TALK"  , "narrator": "ガブリエラ", "text": "そんなことがあったら、\nそりゃ外出嫌いにも\nなるわね。"},
        { "location": "327/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "328/TALK"  , "narrator": "神楽", "text": "私なら、そんなの見たら\n悪夢にうなされそうです。"},
        { "location": "330/TALK"  , "narrator": "神楽", "text": "みやびさんはそういうの\nなかったんですか？"},
        { "location": "332/TALK"  , "narrator": "みやび", "text": "なかったな。"},
        { "location": "334/TALK"  , "narrator": "みやび", "text": "なんちゅうても、\n今の話、全部ウソやし。"},
        { "location": "336/TALK"  , "narrator": "つばめ", "text": "え…………。"},
        { "location": "339/TALK"  , "narrator": "つばめ", "text": "えぇーっ！？\nぜ、全部ウソだったん\nですか！？"},
        { "location": "341/TALK"  , "narrator": "みやび", "text": "うん、全部ウソや。"},
        { "location": "344/TALK"  , "narrator": "アーヤ", "text": "何でそんなウソつくの！？\n本当かと思って信じちゃっ\nたじゃない！"},
        { "location": "347/TALK"  , "narrator": "みやび", "text": "いや、信じる方が\nどうかと思うけんど？"},
        { "location": "348/TALK"  , "narrator": "神楽", "text": "じゃ、じゃあ、虫取りを\nしなくなった本当の\n理由って…？"},
        { "location": "351/TALK"  , "narrator": "みやび", "text": "年齢が上がれば、\n興味失くすんが普通やろ？"},
        { "location": "352/TALK"  , "narrator": "みやび", "text": "それだけの話や。"},
        { "location": "354/TALK"  , "narrator": "ガブリエラ", "text": "もぉ、ウソつき！\n絶対何か凄い理由が\nあると思ったのに！"},
        { "location": "356/TALK"  , "narrator": "みやび", "text": "…そもそも、勝手に\n暗い過去設定とか\n付けんでほしいちや。"},
        { "location": "21/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>8月23日　 3:27 PM</color>\n合宿中、みやびの実家でのこと"}
    ]
}
