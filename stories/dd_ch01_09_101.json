{
    "dir": "chap09/daydra/dd_ch01_09_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "9102",
        "cid": "tsubame",
        "title": "002 メインストーリー",
        "sub_title": "激務日和＜前編＞"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "激務日和"},
        { "location": "39/TALK"   , "narrator": "つばめ", "text": "んーっ、ようやく\n放課後だよ…。"},
        { "location": "40/TALK"   , "narrator": "神楽", "text": "バイトまでは、\nまだ時間あります\nよね？"},
        { "location": "44/TALK"   , "narrator": "つばめ", "text": "そうだね。\nどこか寄ってこうか？"},
        { "location": "46/TALK"   , "narrator": "雛", "text": "二人とも、\nおつかれー。"},
        { "location": "48/TALK"   , "narrator": "つばめ", "text": "あ、ひなこちゃん。"},
        { "location": "49/TALK"   , "narrator": "雛", "text": "ねえねえ、この後\nだけど、時間ある？"},
        { "location": "52/TALK"   , "narrator": "神楽", "text": "ええ、まあ…。\n行きたいところでも\nあるんですか？"},
        { "location": "53/TALK"   , "narrator": "雛", "text": "えっとね、まずは\n市ヶ谷から有楽町線\nでしょ。"},
        { "location": "54/TALK"   , "narrator": "雛", "text": "新木場まで行って\nりんかい線に\n乗り換えて――"},
        { "location": "55/TALK"   , "narrator": "雛", "text": "天王洲アイルから\nモノレール！"},
        { "location": "56/TALK"   , "narrator": "雛", "text": "帰りは京急山の手\n中央緩行線、って\nところでどう？"},
        { "location": "58/TALK"   , "narrator": "神楽", "text": "えっと…それで、\n目的地はどこなん\nですか？"},
        { "location": "62/TALK"   , "narrator": "キリト", "text": "どこへも行かねぇん\nだよ、コイツは。\nただ電車に乗るだけ。"},
        { "location": "63/TALK"   , "narrator": "ヒカル", "text": "ひなこさんにとっての\n電車は、手段ではなく\n目的ですからね。"},
        { "location": "66/TALK"   , "narrator": "つばめ", "text": "？　どういうこと？"},
        { "location": "68/TALK"   , "narrator": "キリト", "text": "ひなこは筋金入りの\n鉄道マニアでな――"},
        { "location": "69/TALK"   , "narrator": "キリト", "text": "本当に、ただ電車に\n乗るだけで楽しめる\n変わり者なんだよ。"},
        { "location": "72/TALK"   , "narrator": "雛", "text": "戦艦マニアの\nキリトよりは\n普通だと思うけど？"},
        { "location": "74/TALK"   , "narrator": "キリト", "text": "戦艦は普通だろ？"},
        { "location": "76/TALK"   , "narrator": "ヒカル", "text": "戦艦という時点で、\nもう普通ではないと\n思いますよ？"},
        { "location": "80/TALK"   , "narrator": "神楽", "text": "っていうか、キリト\nくん達とひなこさん\nって――"},
        { "location": "81/TALK"   , "narrator": "神楽", "text": "お友達同士だったん\nですね？"},
        { "location": "83/TALK"   , "narrator": "ヒカル", "text": "そういえば、\n話していません\nでしたね。"},
        { "location": "85/TALK"   , "narrator": "神楽", "text": "はい…高等部に\n入る前からの\n仲なんですか？"},
        { "location": "86/TALK"   , "narrator": "ヒカル", "text": "僕とひなこさんは\nそうですね。"},
        { "location": "88/TALK"   , "narrator": "雛", "text": "キリトとまゆちんは、\n子供の頃からの\n幼馴染なんだよー。"},
        { "location": "92/TALK"   , "narrator": "繭", "text": "小学校からの腐れ縁。"},
        { "location": "95/TALK"   , "narrator": "キリト", "text": "幼馴染でいいだろ？"},
        { "location": "98/TALK"   , "narrator": "つばめ", "text": "ふーん。\nそうだったんだ…。"},
        { "location": "99/TALK"   , "narrator": "雛", "text": "そういうこと。\nそれはそうと――"},
        { "location": "102/TALK"  , "narrator": "雛", "text": "まゆちんはどうする？\nたまには電車乗りに\n行こうよー。"},
        { "location": "104/TALK"  , "narrator": "繭", "text": "無理。\n私、これからバイト\nだから。"},
        { "location": "106/TALK"  , "narrator": "つばめ", "text": "まゆちんって、\n何のアルバイト\nしてるの？"},
        { "location": "108/TALK"  , "narrator": "繭", "text": "黙秘権施行！"},
        { "location": "111/TALK"  , "narrator": "キリト", "text": "ちっ！　いい加減\n教えてくれても\nいいじゃねぇか。"},
        { "location": "114/TALK"  , "narrator": "雛", "text": "ほらほら、寂しくて\nキリトがすねちゃっ\nてるよ？"},
        { "location": "116/TALK"  , "narrator": "キリト", "text": "いや、違ぇから！"},
        { "location": "119/TALK"  , "narrator": "雛", "text": "って、こんなこと\n話してる暇はないよ。"},
        { "location": "120/TALK"  , "narrator": "雛", "text": "今なら１５時２３分\n発に乗れるよー。"},
        { "location": "124/TALK"  , "narrator": "神楽", "text": "…どうしましょうか、\nつばめさん？"},
        { "location": "126/TALK"  , "narrator": "つばめ", "text": "うーん…時間まで、\n一緒に行こうかな？"},
        { "location": "133/TALK"  , "narrator": "ガブリエラ", "text": "おいこら、新人共！"},
        { "location": "140/TALK"  , "narrator": "つばめ", "text": "うわっ！？"},
        { "location": "142/TALK"  , "narrator": "みやび", "text": "つばめちゃん、\n驚き過ぎや。"},
        { "location": "143/TALK"  , "narrator": "つばめ", "text": "が、ガブちゃん、\nそれにみやびさん。"},
        { "location": "145/TALK"  , "narrator": "ガブリエラ", "text": "だからー！\nあんたはガブちゃん\n禁止って――"},
        { "location": "146/TALK"  , "narrator": "ガブリエラ", "text": "何回も言ってる\nじゃん！"},
        { "location": "148/TALK"  , "narrator": "つばめ", "text": "ご、ごめんなさい…。"},
        { "location": "150/TALK"  , "narrator": "雛", "text": "ちょ、ちょっと、\nうちのクラスに\nトライナリー――"},
        { "location": "151/TALK"  , "narrator": "雛", "text": "概ね全員集合\nなんですけど！？"},
        { "location": "154/TALK"  , "narrator": "繭", "text": "…………。"},
        { "location": "157/TALK"  , "narrator": "みやび", "text": "むっ？\nうちに熱い視線向け\nちょる子がおるな。"},
        { "location": "158/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "159/TALK"  , "narrator": "繭", "text": "っ！？"},
        { "location": "161/TALK"  , "narrator": "ヒカル", "text": "あ、繭さん。\nペンを落とし\nましたよ。"},
        { "location": "163/TALK"  , "narrator": "繭", "text": "あ、ありがとう…。"},
        { "location": "165/TALK"  , "narrator": "繭", "text": "…何たる失態。\n絶対見つめてたの\n気付かれた…。"},
        { "location": "167/TALK"  , "narrator": "ガブリエラ", "text": "ほら、ぐずぐずして\nないで、行くわよ。"},
        { "location": "169/TALK"  , "narrator": "つばめ", "text": "い、行くって、\nどこへ？"},
        { "location": "172/TALK"  , "narrator": "ガブリエラ", "text": "バイトに決まってる\nでしょ？\nバ・イ・ト！"},
        { "location": "173/TALK"  , "narrator": "つばめ", "text": "で、でも、バイトの\n時間まではまだ\n余裕あるし…。"},
        { "location": "175/TALK"  , "narrator": "ガブリエラ", "text": "まさか、遊びに行く\nとか言うんじゃない\nでしょうね？"},
        { "location": "177/TALK"  , "narrator": "つばめ", "text": "うっ！？"},
        { "location": "180/TALK"  , "narrator": "神楽", "text": "あの、サボろうと\nしてたわけじゃ\nないんですよ？"},
        { "location": "181/TALK"  , "narrator": "神楽", "text": "ただ、バイトの時間\nまで遊ぼうかな、と\n思っただけで…。"},
        { "location": "182/TALK"  , "narrator": "ガブリエラ", "text": "ド新人にそんな時間\nあるわけないでしょ！"},
        { "location": "183/TALK"  , "narrator": "ガブリエラ", "text": "一に掃除、二に掃除！\n三四も掃除で\n五も掃除！"},
        { "location": "184/TALK"  , "narrator": "つばめ", "text": "で、でも、まだ\nバイトまで２時間は\nありますよ？"},
        { "location": "185/TALK"  , "narrator": "神楽", "text": "そうですよ。\nさすがに早過ぎじゃ\nないですか？"},
        { "location": "188/TALK"  , "narrator": "ガブリエラ", "text": "はぁ…そういうのは\n新人を卒業してから\n言うことよ。"},
        { "location": "189/TALK"  , "narrator": "ガブリエラ", "text": "それに、掃除以外にも\n仕事は山のように\nあるんだから――"},
        { "location": "190/TALK"  , "narrator": "ガブリエラ", "text": "文句は、それを\n全部覚えてから\n言いなさい。"},
        { "location": "191/TALK"  , "narrator": "つばめ", "text": "そ、そんなに覚える\nことあるんですか！？"},
        { "location": "192/TALK"  , "narrator": "神楽", "text": "ないと思いますよ？\nお客さんもほとんど\n来ないんですし…。"},
        { "location": "193/TALK"  , "narrator": "ガブリエラ", "text": "お、お客が来なくても\nやらなきゃいけない\nことは沢山あるの！！"},
        { "location": "194/TALK"  , "narrator": "ガブリエラ", "text": "だから、文句言わずに\n劇場行くわよ。"},
        { "location": "195/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "196/SEL"   , "narrator": "", "text": "断固抗議せよ"},
        { "location": "197/SEL"   , "narrator": "", "text": "新人だし、仕方ないよね"},
        { "location": "198/ACT"   , "narrator": "", "text": "断固抗議せよ"},
        { "location": "218/TALK"  , "narrator": "つばめ", "text": "ぇっ！？"},
        { "location": "220/TALK"  , "narrator": "つばめ", "text": "うーん"},
        { "location": "221/TALK"  , "narrator": "つばめ", "text": "それはできないよ"},
        { "location": "223/SEL"   , "narrator": "", "text": "怒らないの？"},
        { "location": "224/ACT"   , "narrator": "", "text": "怒らないの？"},
        { "location": "226/TALK"  , "narrator": "つばめ", "text": "ぅん"},
        { "location": "227/TALK"  , "narrator": "つばめ", "text": "どぅして怒ると思ったの？"},
        { "location": "229/SEL"   , "narrator": "", "text": "だって、つばめの方が年上だよ？"},
        { "location": "230/ACT"   , "narrator": "", "text": "だって、つばめの方が年上だよ？"},
        { "location": "232/TALK"  , "narrator": "つばめ", "text": "劇場の仕事と"},
        { "location": "233/TALK"  , "narrator": "つばめ", "text": "トラィナリーのぉ仕事では"},
        { "location": "234/TALK"  , "narrator": "つばめ", "text": "せんぱいの方が先輩だもん"},
        { "location": "235/ACT"   , "narrator": "", "text": "新人だし、仕方なぃよね"},
        { "location": "254/TALK"  , "narrator": "つばめ", "text": "ぅん"},
        { "location": "255/TALK"  , "narrator": "つばめ", "text": "劇場のぉ仕事も"},
        { "location": "256/TALK"  , "narrator": "つばめ", "text": "トラィナリーのぉ仕事でも"},
        { "location": "258/TALK"  , "narrator": "つばめ", "text": "せんぱいの方が先輩だもんね"},
        { "location": "305/TALK"  , "narrator": "つばめ", "text": "$handle$さん\nいらっしゃい！"},
        { "location": "306/TALK"  , "narrator": "つばめ", "text": "前回はなんだかよく\nわからない事になって\nごめんなさい。"},
        { "location": "307/TALK"  , "narrator": "つばめ", "text": "私もまだ全然勉強不足\nなんだなぁって\n痛感しました。"},
        { "location": "308/TALK"  , "narrator": "つばめ", "text": "今回はちゃんと\nお役に立てるように\n頑張りますからね！"},
        { "location": "316/TALK"  , "narrator": "つばめ", "text": "オープンプロセス、\n0x550番地から\n0xDDF番地へ。"},
        { "location": "331/TALK"  , "narrator": "つばめ", "text": "シーク完了しました。"},
        { "location": "334/TALK"  , "narrator": "つばめ", "text": "えっとですねー…"},
        { "location": "336/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "337/TALK"  , "narrator": "つばめ", "text": "えっとですねーー……"},
        { "location": "338/TALK"  , "narrator": "つばめ", "text": "………。"},
        { "location": "339/SEL"   , "narrator": "", "text": "？？？"},
        { "location": "340/ACT"   , "narrator": "", "text": "？？？"},
        { "location": "342/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "343/SEL"   , "narrator": "", "text": "どうしたの！？"},
        { "location": "344/ACT"   , "narrator": "", "text": "どうしたの！？"},
        { "location": "346/TALK"  , "narrator": "つばめ", "text": "なんか変なんです！"},
        { "location": "347/TALK"  , "narrator": "つばめ", "text": "ココロファイルナンバー\n01-224-99の中身が\n真っ白なんです！"},
        { "location": "348/SEL"   , "narrator": "", "text": "どういうこと？"},
        { "location": "349/ACT"   , "narrator": "", "text": "どういうこと？"},
        { "location": "351/TALK"  , "narrator": "つばめ", "text": "そ、そうですねー。\n多分……"},
        { "location": "352/TALK"  , "narrator": "つばめ", "text": "原因は無いけど、\nクランが扉を塞いでる、\nという事でしょうか。"},
        { "location": "353/TALK"  , "narrator": "つばめ", "text": "それか――"},
        { "location": "354/TALK"  , "narrator": "つばめ", "text": "原因はあるけど、\nわたしたちにはその\n閲覧権限が無いとか。"},
        { "location": "355/SEL"   , "narrator": "", "text": "そんなこと、あるの？"},
        { "location": "356/ACT"   , "narrator": "", "text": "そんなこと、あるの？"},
        { "location": "358/TALK"  , "narrator": "つばめ", "text": "うーん、どうなんでしょう。"},
        { "location": "360/TALK"  , "narrator": "つばめ", "text": "わたし、司書として\nやっていく自信が\n無くなってきました。"},
        { "location": "361/SEL"   , "narrator": "", "text": "とにかく今は、クランを倒そう"},
        { "location": "362/ACT"   , "narrator": "", "text": "とにかく今は、クランを倒そう"},
        { "location": "364/TALK"  , "narrator": "つばめ", "text": "え？"},
        { "location": "365/SEL"   , "narrator": "", "text": "原因はまた、後で調べればいいよ"},
        { "location": "366/ACT"   , "narrator": "", "text": "原因はまた、後で調べればいいよ"},
        { "location": "369/TALK"  , "narrator": "つばめ", "text": "あ、ありがとう\nございます！"},
        { "location": "370/TALK"  , "narrator": "つばめ", "text": "$handle$さんって\nホントに優しいですね。"},
        { "location": "371/TALK"  , "narrator": "つばめ", "text": "わたしが\n好きになっちゃうのも\nわかりますね。"},
        { "location": "372/SEL"   , "narrator": "", "text": "え？　そうなの？"},
        { "location": "373/SEL"   , "narrator": "", "text": "フィアンセだからね！"},
        { "location": "374/ACT"   , "narrator": "", "text": "え？　そうなの？"},
        { "location": "376/TALK"  , "narrator": "つばめ", "text": "あっ！"},
        { "location": "377/TALK"  , "narrator": "つばめ", "text": "いや、別に恋してるとか\nそういうのじゃ\nないですよ？"},
        { "location": "378/TALK"  , "narrator": "つばめ", "text": "頼りになるなぁって\n慕ってるっていうか！"},
        { "location": "379/ACT"   , "narrator": "", "text": "フィアンセだからね！"},
        { "location": "380/TALK"  , "narrator": "つばめ", "text": "えええっ！！\nそうだったんですか！"},
        { "location": "381/TALK"  , "narrator": "つばめ", "text": "全然知らなかったです。"},
        { "location": "382/TALK"  , "narrator": "つばめ", "text": "でも、\n$handle$さんなら\n納得ですね！"},
        { "location": "383/TALK"  , "narrator": "つばめ", "text": "これからも、わたしのこと\n宜しくお願いしますね！"},
        { "location": "386/TALK"  , "narrator": "つばめ", "text": "今回は本当に\n全然わからなくて\nホントにごめんなさい。"},
        { "location": "387/TALK"  , "narrator": "つばめ", "text": "腑に落ちないかもですけど\nクランの退治、\nどうかお願いします！"},
        { "location": "388/TALK"  , "narrator": "つばめ", "text": "$handle$さんと\nわたしに、\n素敵なココロの旅を！"},
        { "location": "38/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>5月13日　3:24 PM</color>\nとある放課後、つばめのクラスの教室にて。"},
        { "location": "273/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"}
    ]
}
