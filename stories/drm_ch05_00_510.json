{
    "dir": "dramatics/himegoto/drm_ch05_00_510.js",
    "type": "Episode",
    "info": {
        "story_id": "5051",
        "cid": "kagura",
        "title": "らぶとーく 第51話",
        "sub_title": "今はもういらないけど"
    },
    "entry":
    [
        { "location": "657/SCENARIO", "narrator": "", "text": "今はもういらないけど"},
        { "location": "682/TALK"    , "narrator": "神楽", "text": "FreyMENOWって名前で世に出すってことは最終的にはぴょんこが責任持つってことぴょん"},
        { "location": "683/TALK"    , "narrator": "神楽", "text": "それなのにさー"},
        { "location": "684/TALK"    , "narrator": "神楽", "text": "コンセプトとかそういうの理解してない輩に限ってジャストアイディアなんだけどとか"},
        { "location": "685/TALK"    , "narrator": "神楽", "text": "ドヤ顔で言ってくるの何なの？"},
        { "location": "686/TALK"    , "narrator": "神楽", "text": "バカなの死ぬの？？？"},
        { "location": "687/TALK"    , "narrator": "神楽", "text": "っていうか頃していい！？！？！？！"},
        { "location": "689/SEL"     , "narrator": "", "text": "まあ落ち着いて"},
        { "location": "690/SEL"     , "narrator": "", "text": "よしよし大変だったんだね"},
        { "location": "691/SEL"     , "narrator": "", "text": "特別に許可する"},
        { "location": "692/ACT"     , "narrator": "", "text": "まあ落ち着いて"},
        { "location": "693/TALK"    , "narrator": "神楽", "text": "落ち着けないし！！！"},
        { "location": "694/TALK"    , "narrator": "神楽", "text": "無理だし！！！"},
        { "location": "695/ACT"     , "narrator": "", "text": "よしよし大変だったんだね"},
        { "location": "696/TALK"    , "narrator": "神楽", "text": "ﾏｼﾞでそう！"},
        { "location": "697/TALK"    , "narrator": "神楽", "text": "何なんだろうねｱﾚ！"},
        { "location": "698/ACT"     , "narrator": "", "text": "特別に許可する"},
        { "location": "699/TALK"    , "narrator": "神楽", "text": "許可が出た！！！"},
        { "location": "701/TALK"    , "narrator": "神楽", "text": "では遠慮なく！！！"},
        { "location": "703/TALK"    , "narrator": "神楽", "text": "あーね"},
        { "location": "705/TALK"    , "narrator": "神楽", "text": "方向性とかはね"},
        { "location": "706/TALK"    , "narrator": "神楽", "text": "もう仕方ないし"},
        { "location": "707/TALK"    , "narrator": "神楽", "text": "そういう方向性でクオリティ上げていきましょうってのは大丈夫なの"},
        { "location": "708/TALK"    , "narrator": "神楽", "text": "それがぴょんこのやりたい方向じゃなくても"},
        { "location": "709/TALK"    , "narrator": "神楽", "text": "ゴールはコレなんだなっていうのはありなの"},
        { "location": "710/TALK"    , "narrator": "神楽", "text": "でもさ！"},
        { "location": "711/TALK"    , "narrator": "神楽", "text": "迷走させるタイプに限って俺ＴＵＥＥＥＥなバカで困る"},
        { "location": "712/TALK"    , "narrator": "神楽", "text": "ファンタジーって言えば何が何でもドラゴン出してくるとかそういう輩"},
        { "location": "713/TALK"    , "narrator": "神楽", "text": "世の中にはそうじゃないファンタジーの方が本来多いんだっつー！！！！！"},
        { "location": "714/TALK"    , "narrator": "神楽", "text": "視野狭すぎ！"},
        { "location": "715/TALK"    , "narrator": "神楽", "text": "引き出し少なすぎ！"},
        { "location": "716/TALK"    , "narrator": "神楽", "text": "そういうのこそ超絶クオリティと新しい視点が必要なのにわかってないし"},
        { "location": "717/TALK"    , "narrator": "神楽", "text": "別にお前全然強くねーし！"},
        { "location": "720/SEL"     , "narrator": "", "text": "相当アレだったんだね…"},
        { "location": "721/SEL"     , "narrator": "", "text": "ドラゴンかっこいいけどなー"},
        { "location": "722/SEL"     , "narrator": "", "text": "お疲れさま"},
        { "location": "723/ACT"     , "narrator": "", "text": "相当アレだったんだね…"},
        { "location": "724/TALK"    , "narrator": "神楽", "text": "そうなのー"},
        { "location": "725/ACT"     , "narrator": "", "text": "ドラゴンかっこいいけどなー"},
        { "location": "726/TALK"    , "narrator": "神楽", "text": "それは異論の余地がない"},
        { "location": "727/TALK"    , "narrator": "神楽", "text": "でも胸キュン学園ラブコメとか医療ドラマとか刑事物とかにはドラゴンいらんだろ！"},
        { "location": "728/TALK"    , "narrator": "神楽", "text": "ってそういう話"},
        { "location": "729/ACT"     , "narrator": "", "text": "お疲れさま"},
        { "location": "734/TALK"    , "narrator": "神楽", "text": "正直ね？"},
        { "location": "735/TALK"    , "narrator": "神楽", "text": "ぴょんこは歌唱力なんかもあるから"},
        { "location": "736/TALK"    , "narrator": "神楽", "text": "無茶苦茶な電波ソングでもそれなりに聞かせることはできちゃうぴょん"},
        { "location": "738/SEL"     , "narrator": "", "text": "すごい自信だね"},
        { "location": "739/SEL"     , "narrator": "", "text": "むしろ聞いてみたい"},
        { "location": "740/SEL"     , "narrator": "", "text": "なるほど？"},
        { "location": "741/ACT"     , "narrator": "", "text": "すごい自信だね"},
        { "location": "742/TALK"    , "narrator": "神楽", "text": "客観的事実だから"},
        { "location": "743/ACT"     , "narrator": "", "text": "むしろ聞いてみたい"},
        { "location": "744/TALK"    , "narrator": "神楽", "text": "計算して電波ソングならね？"},
        { "location": "745/TALK"    , "narrator": "神楽", "text": "むしろ大好きだけど"},
        { "location": "746/TALK"    , "narrator": "神楽", "text": "ただのまとめられないカオスは無理"},
        { "location": "747/TALK"    , "narrator": "神楽", "text": "クリエイターとして無理"},
        { "location": "748/ACT"     , "narrator": "", "text": "なるほど？"},
        { "location": "749/TALK"    , "narrator": "神楽", "text": "そこは仕事ですから？"},
        { "location": "751/TALK"    , "narrator": "神楽", "text": "計算づくの電波ならそれもありだけど"},
        { "location": "752/TALK"    , "narrator": "神楽", "text": "ただの異物にしかならないのは"},
        { "location": "753/TALK"    , "narrator": "神楽", "text": "どうなのかなって"},
        { "location": "755/SEL"     , "narrator": "", "text": "うまく料理するのがプロじゃないの？"},
        { "location": "756/SEL"     , "narrator": "", "text": "新しい世界が開けるかもよ"},
        { "location": "757/SEL"     , "narrator": "", "text": "真の電波は計算なんてできない"},
        { "location": "758/ACT"     , "narrator": "", "text": "うまく料理するのがプロじゃないの？"},
        { "location": "759/TALK"    , "narrator": "神楽", "text": "その前に素材を見極めるのが真のプロ"},
        { "location": "760/TALK"    , "narrator": "神楽", "text": "安請け合いするのは素人かレベルの低いプロ"},
        { "location": "761/ACT"     , "narrator": "", "text": "新しい世界が開けるかもよ"},
        { "location": "762/TALK"    , "narrator": "神楽", "text": "開きたいセカイと開きたくない世界があるし"},
        { "location": "763/TALK"    , "narrator": "神楽", "text": "それを決めるのはぴょんこなのだ！"},
        { "location": "764/ACT"     , "narrator": "", "text": "真の電波は計算なんてできない"},
        { "location": "765/TALK"    , "narrator": "神楽", "text": "それはそう"},
        { "location": "766/TALK"    , "narrator": "神楽", "text": "そしてそれは別次元の話"},
        { "location": "767/TALK"    , "narrator": "神楽", "text": "クリエイティブとは真逆の話"},
        { "location": "769/TALK"    , "narrator": "神楽", "text": "作り上げるまではぴょんこだって迷走するよ？"},
        { "location": "770/TALK"    , "narrator": "神楽", "text": "頭の中ぐるぐるして色んな可能性を考えて考えて考えて"},
        { "location": "771/TALK"    , "narrator": "神楽", "text": "それで最後に一番いいものを選択するの"},
        { "location": "772/TALK"    , "narrator": "神楽", "text": "その経過でどうしても捨てちゃうものがでるのは仕方ないって思う"},
        { "location": "773/TALK"    , "narrator": "神楽", "text": "でもさ！"},
        { "location": "774/TALK"    , "narrator": "神楽", "text": "最初からどう考えても相容れないものを入れようとするのはさ～"},
        { "location": "775/TALK"    , "narrator": "神楽", "text": "なんていうの？"},
        { "location": "777/TALK"    , "narrator": "神楽", "text": "愚の骨頂？？？"},
        { "location": "779/SEL"     , "narrator": "", "text": "相当怒ってるね…"},
        { "location": "780/SEL"     , "narrator": "", "text": "そうなんだ"},
        { "location": "781/SEL"     , "narrator": "", "text": "色んな考えがあるもんね"},
        { "location": "782/ACT"     , "narrator": "", "text": "相当怒ってるね…"},
        { "location": "783/TALK"    , "narrator": "神楽", "text": "怒ってるね"},
        { "location": "784/TALK"    , "narrator": "神楽", "text": "実際"},
        { "location": "785/ACT"     , "narrator": "", "text": "そうなんだ"},
        { "location": "786/TALK"    , "narrator": "神楽", "text": "そうなんだよー"},
        { "location": "787/ACT"     , "narrator": "", "text": "色んな考えがあるもんね"},
        { "location": "788/TALK"    , "narrator": "神楽", "text": "いやいやいやいや！"},
        { "location": "789/TALK"    , "narrator": "神楽", "text": "そういうレベルの話じゃなくて"},
        { "location": "790/TALK"    , "narrator": "神楽", "text": "ちゃんと聞いてくれてる！？！？！？！？！"},
        { "location": "794/TALK"    , "narrator": "神楽", "text": "それでも"},
        { "location": "796/TALK"    , "narrator": "神楽", "text": "この世界でもFreyMENOWとして活動できるのは"},
        { "location": "797/TALK"    , "narrator": "神楽", "text": "うれしかったりするけど"},
        { "location": "799/SEL"     , "narrator": "", "text": "なかなか複雑だよね…"},
        { "location": "800/SEL"     , "narrator": "", "text": "そういうことならいいけど"},
        { "location": "801/SEL"     , "narrator": "", "text": "無理してない？"},
        { "location": "802/ACT"     , "narrator": "", "text": "なかなか複雑だよね…"},
        { "location": "803/TALK"    , "narrator": "神楽", "text": "そりゃね？"},
        { "location": "804/TALK"    , "narrator": "神楽", "text": "最初からそういう条件は聞いてたけど"},
        { "location": "805/TALK"    , "narrator": "神楽", "text": "相当のハードモード"},
        { "location": "806/ACT"     , "narrator": "", "text": "そういうことならいいけど"},
        { "location": "807/TALK"    , "narrator": "神楽", "text": "はーあーあーあーあー"},
        { "location": "808/TALK"    , "narrator": "神楽", "text": "そうやって割り切れれば"},
        { "location": "809/TALK"    , "narrator": "神楽", "text": "楽になれるけどさぁぁぁぁぁ！？"},
        { "location": "811/TALK"    , "narrator": "神楽", "text": "そう簡単にはいかないんだって"},
        { "location": "812/TALK"    , "narrator": "神楽", "text": "もーもーもーｍ－！！！"},
        { "location": "813/ACT"     , "narrator": "", "text": "無理してない？"},
        { "location": "814/TALK"    , "narrator": "神楽", "text": "してる"},
        { "location": "815/TALK"    , "narrator": "神楽", "text": "当たり前でしょ"},
        { "location": "818/TALK"    , "narrator": "神楽", "text": "ぴょんこがぴょんこであることの中に"},
        { "location": "819/TALK"    , "narrator": "神楽", "text": "FreyMENOWの活動をしていることが入ってる"},
        { "location": "820/TALK"    , "narrator": "神楽", "text": "っていうか"},
        { "location": "821/TALK"    , "narrator": "神楽", "text": "もうそれは"},
        { "location": "822/TALK"    , "narrator": "神楽", "text": "業みたいなものだから"},
        { "location": "824/SEL"     , "narrator": "", "text": "わかる"},
        { "location": "825/SEL"     , "narrator": "", "text": "そうだろうね"},
        { "location": "826/SEL"     , "narrator": "", "text": "若気の至りじゃないの？"},
        { "location": "827/ACT"     , "narrator": "", "text": "わかる"},
        { "location": "828/TALK"    , "narrator": "神楽", "text": "うん"},
        { "location": "829/TALK"    , "narrator": "神楽", "text": "ありがと"},
        { "location": "830/ACT"     , "narrator": "", "text": "そうだろうね"},
        { "location": "831/TALK"    , "narrator": "神楽", "text": "でしょ"},
        { "location": "832/TALK"    , "narrator": "神楽", "text": "やっぱりそうだよね"},
        { "location": "833/ACT"     , "narrator": "", "text": "若気の至りじゃないの？"},
        { "location": "834/TALK"    , "narrator": "神楽", "text": "そうかもしれないけど"},
        { "location": "835/TALK"    , "narrator": "神楽", "text": "今は業としか思えないから"},
        { "location": "837/TALK"    , "narrator": "神楽", "text": "そう考えてくと"},
        { "location": "838/TALK"    , "narrator": "神楽", "text": "ぴょんこは恵まれてるのかな？"},
        { "location": "839/TALK"    , "narrator": "神楽", "text": "なんて思うこともある"},
        { "location": "840/TALK"    , "narrator": "神楽", "text": "すぐにいやそんなことないだろって"},
        { "location": "841/TALK"    , "narrator": "神楽", "text": "自分に突っ込むんだけど"},
        { "location": "845/TALK"    , "narrator": "神楽", "text": "$handle$はぴょんこが恵まれてると思う？？？？"},
        { "location": "847/SEL"     , "narrator": "", "text": "どうだろうね…"},
        { "location": "848/SEL"     , "narrator": "", "text": "相当大変だと思う"},
        { "location": "849/SEL"     , "narrator": "", "text": "わからん！"},
        { "location": "850/ACT"     , "narrator": "", "text": "どうだろうね…"},
        { "location": "851/TALK"    , "narrator": "神楽", "text": "人のことだもんね"},
        { "location": "852/TALK"    , "narrator": "神楽", "text": "そうなっちゃうよね"},
        { "location": "853/ACT"     , "narrator": "", "text": "相当大変だと思う"},
        { "location": "854/TALK"    , "narrator": "神楽", "text": "やっぱりそうなのかー"},
        { "location": "855/TALK"    , "narrator": "神楽", "text": "だと思ってた！！！"},
        { "location": "856/ACT"     , "narrator": "", "text": "わからん！"},
        { "location": "857/TALK"    , "narrator": "神楽", "text": "はー？？？"},
        { "location": "858/TALK"    , "narrator": "神楽", "text": "言い切るとかバカなの！？"},
        { "location": "861/SEL"     , "narrator": "", "text": "でも"},
        { "location": "862/ACT"     , "narrator": "", "text": "でも"},
        { "location": "865/SEL"     , "narrator": "", "text": "$me$は神楽が好きだよ"},
        { "location": "866/SEL"     , "narrator": "", "text": "フレイメノウは格好いいよ"},
        { "location": "867/SEL"     , "narrator": "", "text": "神楽の側にいたいと思うよ"},
        { "location": "868/SEL"     , "narrator": "", "text": "神楽は神楽でいいんじゃないかな"},
        { "location": "869/ACT"     , "narrator": "", "text": "$me$は神楽が好きだよ"},
        { "location": "871/TALK"    , "narrator": "神楽", "text": "知ってるし！！！！"},
        { "location": "872/TALK"    , "narrator": "神楽", "text": "ぴょんこも好きだし！！！"},
        { "location": "873/ACT"     , "narrator": "", "text": "フレイメノウは格好いいよ"},
        { "location": "875/TALK"    , "narrator": "神楽", "text": "本当かな～～～？？？"},
        { "location": "876/TALK"    , "narrator": "神楽", "text": "だったらいいんだけど"},
        { "location": "877/ACT"     , "narrator": "", "text": "神楽の側にいたいと思うよ"},
        { "location": "879/TALK"    , "narrator": "神楽", "text": "うん"},
        { "location": "880/TALK"    , "narrator": "神楽", "text": "ぴょんこもいて欲しいな、、、"},
        { "location": "881/ACT"     , "narrator": "", "text": "神楽は神楽でいいんじゃないかな"},
        { "location": "882/TALK"    , "narrator": "神楽", "text": "わかるようでわかんないけど"},
        { "location": "883/TALK"    , "narrator": "神楽", "text": "そうするぴょん"},
        { "location": "887/TALK"    , "narrator": "ボイスメール", "text": "長い長い神楽さんの話"},
        { "location": "899/DIALOG"  , "narrator": "Dialog_GETVoice", "text": "<color=green>【神楽】</color>のボイスメール\n<color=red>【長い長い神楽さんの話】</color>\nをゲットしました！"}
    ]
}
