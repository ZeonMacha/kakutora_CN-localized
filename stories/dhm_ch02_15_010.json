    [
        { "location": "7/SCENARIO", "narrator": "", "text": "022_コンは来んのコン"},
        { "location": "32/TALK"   , "narrator": "アーヤ", "text": "大学の友達と食事に行ってきた"},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "友達とよ(´o｀；"},
        { "location": "34/TALK"   , "narrator": "アーヤ", "text": "合コンじゃないからね"},
        { "location": "36/SEL"    , "narrator": "", "text": "合コンと思ってた"},
        { "location": "37/SEL"    , "narrator": "", "text": "食事、楽しかった？"},
        { "location": "38/SEL"    , "narrator": "", "text": "アーヤに合コンは早い！"},
        { "location": "39/ACT"    , "narrator": "", "text": "合コンと思ってた"},
        { "location": "40/TALK"   , "narrator": "アーヤ", "text": "なんでこう"},
        { "location": "41/TALK"   , "narrator": "アーヤ", "text": "そうなるの"},
        { "location": "43/TALK"   , "narrator": "アーヤ", "text": "それとも東京の大学生って常に合コンしてるの？"},
        { "location": "44/TALK"   , "narrator": "アーヤ", "text": "ついてけないわ＼(◎o◎)／"},
        { "location": "45/ACT"    , "narrator": "", "text": "食事、楽しかった？"},
        { "location": "46/TALK"   , "narrator": "アーヤ", "text": "もちろんよ"},
        { "location": "47/TALK"   , "narrator": "アーヤ", "text": "やっぱりああいうところじゃないと話ってできなかったりするわ"},
        { "location": "48/TALK"   , "narrator": "アーヤ", "text": "意外とね"},
        { "location": "49/TALK"   , "narrator": "アーヤ", "text": "久しぶりにゆっくり話した感じ"},
        { "location": "51/TALK"   , "narrator": "アーヤ", "text": "よかったわ"},
        { "location": "52/ACT"    , "narrator": "", "text": "アーヤに合コンは早い！"},
        { "location": "54/TALK"   , "narrator": "アーヤ", "text": "何それ"},
        { "location": "55/TALK"   , "narrator": "アーヤ", "text": "遅いくらいよ"},
        { "location": "57/SEL"    , "narrator": "", "text": "心配だし"},
        { "location": "58/SEL"    , "narrator": "", "text": "$me$がいるでしょ"},
        { "location": "59/ACT"    , "narrator": "", "text": "心配だし"},
        { "location": "60/TALK"   , "narrator": "アーヤ", "text": "あら"},
        { "location": "61/TALK"   , "narrator": "アーヤ", "text": "大丈夫よ"},
        { "location": "63/TALK"   , "narrator": "アーヤ", "text": "こう見えてもしっかりしてるんだから"},
        { "location": "64/ACT"    , "narrator": "", "text": "$me$がいるでしょ"},
        { "location": "65/TALK"   , "narrator": "アーヤ", "text": "そうね"},
        { "location": "66/TALK"   , "narrator": "アーヤ", "text": "だったら必要な医師ら"},
        { "location": "67/TALK"   , "narrator": "アーヤ", "text": "いかしら"},
        { "location": "68/TALK"   , "narrator": "アーヤ", "text": "なんてね"}
    ]
