    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "024_別名は花子さん"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "やっぱり"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "因縁らしいものはないの"},
        { "location": "34/TALK"   , "narrator": "ガブリエラ", "text": "学校が建つ前のこととか"},
        { "location": "35/TALK"   , "narrator": "ガブリエラ", "text": "いろいろ調べたのに"},
        { "location": "36/TALK"   , "narrator": "ガブリエラ", "text": "なんで幽霊が出たのかしら"},
        { "location": "38/SEL"    , "narrator": "", "text": "記録されてないこともある"},
        { "location": "39/SEL"    , "narrator": "", "text": "からかわれただけだよ"},
        { "location": "40/SEL"    , "narrator": "", "text": "あれ、真幌だよ"},
        { "location": "41/ACT"    , "narrator": "", "text": "記録されてないこともある"},
        { "location": "43/TALK"   , "narrator": "ガブリエラ", "text": "やっぱり"},
        { "location": "44/TALK"   , "narrator": "ガブリエラ", "text": "そういうことなのかしら"},
        { "location": "45/TALK"   , "narrator": "ガブリエラ", "text": "これからは"},
        { "location": "47/TALK"   , "narrator": "ガブリエラ", "text": "肝試しなんてしないようにするわ"},
        { "location": "48/TALK"   , "narrator": "ガブリエラ", "text": "何が起こるかわからないものね"},
        { "location": "50/TALK"   , "narrator": "ガブリエラ", "text": "それと"},
        { "location": "51/TALK"   , "narrator": "ガブリエラ", "text": "この話はアーヤには内緒よ"},
        { "location": "53/SEL"    , "narrator": "", "text": "どうして？"},
        { "location": "54/ACT"    , "narrator": "", "text": "どうして？"},
        { "location": "55/TALK"   , "narrator": "ガブリエラ", "text": "アーヤは怖がりだもの"},
        { "location": "56/TALK"   , "narrator": "ガブリエラ", "text": "怖がらせちゃだめ"},
        { "location": "58/TALK"   , "narrator": "ガブリエラ", "text": "だからよ"},
        { "location": "60/ACT"    , "narrator": "", "text": "からかわれただけだよ"},
        { "location": "61/TALK"   , "narrator": "ガブリエラ", "text": "そう思いたいわ"},
        { "location": "62/TALK"   , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "64/TALK"   , "narrator": "ガブリエラ", "text": "あんな時間よ？"},
        { "location": "65/TALK"   , "narrator": "ガブリエラ", "text": "今だって顔も声も思い出せるわ、、、"},
        { "location": "66/ACT"    , "narrator": "", "text": "あれ、真幌だよ"},
        { "location": "67/TALK"   , "narrator": "ガブリエラ", "text": "何を言い出すの"},
        { "location": "68/TALK"   , "narrator": "ガブリエラ", "text": "まほがあんなに若いはずないでしょう？"},
        { "location": "69/TALK"   , "narrator": "ガブリエラ", "text": "安心させようとして言ってくれてるんだろうけど"},
        { "location": "71/TALK"   , "narrator": "ガブリエラ", "text": "それじゃ騙せないわよ"}
    ]
}
