        "title": "005 メインストーリー",
        "sub_title": "気にしすぎの戦＜後編＞"
    },
    "entry":
    [
        { "location": "480/TALK"  , "narrator": "ガブリエラ", "text": "まあ"},
        { "location": "481/TALK"  , "narrator": "ガブリエラ", "text": "アーヤだものね"},
        { "location": "482/TALK"  , "narrator": "ガブリエラ", "text": "前からそうなんだし"},
        { "location": "483/TALK"  , "narrator": "ガブリエラ", "text": "今更か"},
        { "location": "484/TALK"  , "narrator": "ガブリエラ", "text": "ごめんなさいね$marzanna$"},
        { "location": "485/TALK"  , "narrator": "ガブリエラ", "text": "変な愚痴を言っちゃったわ"},
        { "location": "496/TALK"  , "narrator": "ガブリエラ", "text": "…そうよね。"},
        { "location": "497/TALK"  , "narrator": "ガブリエラ", "text": "アーヤなんだし、\n仕方ないわよ…。"},
        { "location": "500/TALK"  , "narrator": "ガブリエラ", "text": "はぁ…。"},
        { "location": "501/TALK"  , "narrator": "アーヤ", "text": "？"},
        { "location": "502/TALK"  , "narrator": "アーヤ", "text": "ギャヴィったら、\nため息吐いてる…。"},
        { "location": "503/TALK"  , "narrator": "アーヤ", "text": "…もしかして、\n本当は凄く疲れてるの\nかしら？"},
        { "location": "504/SEL"   , "narrator": "", "text": "アーヤ"},
        { "location": "505/ACT"   , "narrator": "", "text": "アーヤ"},
        { "location": "522/TALK"  , "narrator": "アーヤ", "text": "何か？"},
        { "location": "523/TALK"  , "narrator": "アーヤ", "text": "どうかした？(￣Д￣ )"},
        { "location": "525/SEL"   , "narrator": "", "text": "昔はガブリエラと二人だったんだっけ？"},
        { "location": "526/ACT"   , "narrator": "", "text": "昔はガブリエラと二人だったんだっけ？"},
        { "location": "528/TALK"  , "narrator": "アーヤ", "text": "そう(^^"},
        { "location": "529/TALK"  , "narrator": "アーヤ", "text": "私の次に入隊したのが"},
        { "location": "530/TALK"  , "narrator": "アーヤ", "text": "ギャヴィで"},
        { "location": "531/TALK"  , "narrator": "アーヤ", "text": "みやびが来るまでは"},
        { "location": "532/TALK"  , "narrator": "アーヤ", "text": "ずっと"},
        { "location": "533/TALK"  , "narrator": "アーヤ", "text": "二人だったわ(￣∇￣)"},
        { "location": "536/TALK"  , "narrator": "アーヤ", "text": "考えてみると"},
        { "location": "537/TALK"  , "narrator": "アーヤ", "text": "凄いかも(｡-_-｡)"},
        { "location": "538/TALK"  , "narrator": "アーヤ", "text": "フェノメノン"},
        { "location": "539/TALK"  , "narrator": "アーヤ", "text": "二人で収束させたとか"},
        { "location": "540/TALK"  , "narrator": "アーヤ", "text": "今じゃ信じられない(>_<)"},
        { "location": "541/TALK"  , "narrator": "アーヤ", "text": "でも"},
        { "location": "542/TALK"  , "narrator": "アーヤ", "text": "凄く大変だったわ(-ω-;)"},
        { "location": "545/TALK"  , "narrator": "アーヤ", "text": "ごめん"},
        { "location": "546/TALK"  , "narrator": "アーヤ", "text": "ギャヴィと話しあるから"},
        { "location": "547/TALK"  , "narrator": "アーヤ", "text": "ここまでね"},
        { "location": "559/TALK"  , "narrator": "アーヤ", "text": "…ねえ、ギャヴィ。\n覚えてる？"},
        { "location": "562/TALK"  , "narrator": "ガブリエラ", "text": "え？　何が？"},
        { "location": "563/TALK"  , "narrator": "アーヤ", "text": "二人だけだった頃\n凄いのと戦ったこと。"},
        { "location": "565/TALK"  , "narrator": "ガブリエラ", "text": "凄いの？"},
        { "location": "566/TALK"  , "narrator": "アーヤ", "text": "恐竜のことよ。\n一緒に戦ったでしょ？"},
        { "location": "568/TALK"  , "narrator": "ガブリエラ", "text": "…ああ！\nあったわね！"},
        { "location": "569/TALK"  , "narrator": "ガブリエラ", "text": "あれは恐竜って\n言えないでしょ？"},
        { "location": "570/TALK"  , "narrator": "ガブリエラ", "text": "どう考えても怪獣な\nティラノサウルス！"},
        { "location": "572/TALK"  , "narrator": "アーヤ", "text": "そうそう。"},
        { "location": "573/TALK"  , "narrator": "アーヤ", "text": "三十メートルはある\n大きさで、口からは\n火まで吐いてたし。"},
        { "location": "576/TALK"  , "narrator": "ガブリエラ", "text": "声が衝撃波とか、\nマジでヤバかったわ、\nあの時は。"},
        { "location": "578/TALK"  , "narrator": "ガブリエラ", "text": "あれはクリア条件が\n超単純だったから\nどうにかなったけど。"},
        { "location": "579/TALK"  , "narrator": "アーヤ", "text": "本当、そうね。"},
        { "location": "580/TALK"  , "narrator": "アーヤ", "text": "思えば、あの時が\n最初だったかしら？"},
        { "location": "581/TALK"  , "narrator": "アーヤ", "text": "二人でコンビネー\nション攻撃したの\nって。"},
        { "location": "582/TALK"  , "narrator": "ガブリエラ", "text": "う、うん。\nそう、そうよ！"},
        { "location": "583/TALK"  , "narrator": "アーヤ", "text": "懐かしいわねぇ…。"},
        { "location": "584/TALK"  , "narrator": "アーヤ", "text": "まあ、今思えば\nかなりメチャクチャな\n戦い方だったけど。"},
        { "location": "586/TALK"  , "narrator": "ガブリエラ", "text": "あはは、そうそう。\nタイミングとか全然\n合わなかったわねぇ。"},
        { "location": "589/TALK"  , "narrator": "ガブリエラ", "text": "そっか…アーヤも\n覚えててくれたんだ。"},
        { "location": "590/TALK"  , "narrator": "ガブリエラ", "text": "あたししか覚えて\nないと思ってた。"},
        { "location": "591/TALK"  , "narrator": "ガブリエラ", "text": "…普段鈍感なのに、\n時々こういうこと\n言ってくるのよね。"},
        { "location": "592/TALK"  , "narrator": "ガブリエラ", "text": "だからドキッと\nさせられちゃう…。"},
        { "location": "594/TALK"  , "narrator": "ガブリエラ", "text": "はぁ…悔しいなぁ。"},
        { "location": "596/TALK"  , "narrator": "アーヤ", "text": "ん？　何が？"},
        { "location": "598/TALK"  , "narrator": "ガブリエラ", "text": "あ、ううん。"},
        { "location": "599/TALK"  , "narrator": "ガブリエラ", "text": "そういえば\n恋愛小説のも\n大変だったなって。"},
        { "location": "601/TALK"  , "narrator": "アーヤ", "text": "あー…あれはもう、\n私のトラウマよ。"},
        { "location": "602/TALK"  , "narrator": "ガブリエラ", "text": "でしょ！\nだって、主人公と\nヒロインのことを――"},
        { "location": "613/DIALOG", "narrator": "Dialog_chapter_ch03", "text": "【MV EXE_GARBiELa】"}
    ]
}
