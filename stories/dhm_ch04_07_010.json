    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "006_リアルタイプゆるキャラは存在し得るや否や"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "ぬう"},
        { "location": "33/TALK"   , "narrator": "みやび", "text": "客足が伸びぬ"},
        { "location": "36/SEL"    , "narrator": "", "text": "伸ばしたいの？"},
        { "location": "37/SEL"    , "narrator": "", "text": "なんかしてたっけ？"},
        { "location": "38/ACT"    , "narrator": "", "text": "伸ばしたいの？"},
        { "location": "39/TALK"   , "narrator": "みやび", "text": "なんと"},
        { "location": "41/TALK"   , "narrator": "みやび", "text": "一応な"},
        { "location": "42/ACT"    , "narrator": "", "text": "なんかしてたっけ？"},
        { "location": "43/TALK"   , "narrator": "みやび", "text": "しとるではないか"},
        { "location": "45/TALK"   , "narrator": "みやび", "text": "具体的にはガブちゃんがサイトで大人気"},
        { "location": "46/TALK"   , "narrator": "みやび", "text": "しかし映画館は閑古鳥"},
        { "location": "47/TALK"   , "narrator": "みやび", "text": "なにゆえか"},
        { "location": "49/SEL"    , "narrator": "", "text": "映画が古過ぎるんだよ"},
        { "location": "50/SEL"    , "narrator": "", "text": "ガブリエラを宣伝に使おう"},
        { "location": "51/SEL"    , "narrator": "", "text": "増えたら面倒になるよ？"},
        { "location": "52/ACT"    , "narrator": "", "text": "映画が古過ぎるんだよ"},
        { "location": "53/TALK"   , "narrator": "みやび", "text": "確かに"},
        { "location": "54/TALK"   , "narrator": "みやび", "text": "ガブちゃんに萌える層とは被らん"},
        { "location": "55/TALK"   , "narrator": "みやび", "text": "仕方ないか"},
        { "location": "58/ACT"    , "narrator": "", "text": "ガブリエラを宣伝に使おう"},
        { "location": "59/TALK"   , "narrator": "みやび", "text": "全面推しか"},
        { "location": "60/TALK"   , "narrator": "みやび", "text": "それしかないか"},
        { "location": "61/TALK"   , "narrator": "みやび", "text": "しかし本人だけでなく"},
        { "location": "62/TALK"   , "narrator": "みやび", "text": "まほさんも面倒くさがるに決まっちょる"},
        { "location": "63/TALK"   , "narrator": "みやび", "text": "ゆえに"},
        { "location": "64/TALK"   , "narrator": "みやび", "text": "やめておこう"},
        { "location": "65/ACT"    , "narrator": "", "text": "増えたら面倒になるよ？"},
        { "location": "67/TALK"   , "narrator": "みやび", "text": "確かに"},
        { "location": "68/TALK"   , "narrator": "みやび", "text": "その通り"},
        { "location": "69/TALK"   , "narrator": "みやび", "text": "よし"},
        { "location": "70/TALK"   , "narrator": "みやび", "text": "宣伝は中止だ！"},
        { "location": "71/TALK"   , "narrator": "みやび", "text": "$handle$め"},
        { "location": "72/TALK"   , "narrator": "みやび", "text": "策士じゃの"}
    ]
}
