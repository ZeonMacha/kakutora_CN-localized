{
    "dir": "chap10/daydra/dd_ch04_10_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "10452",
        "cid": "miyabi",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "チラッ"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "チラッ"},
        { "location": "39/TALK"   , "narrator": "みやび", "text": "はぁ…暑っ苦しくて\n堪らんちや…。"},
        { "location": "40/TALK"   , "narrator": "みやび", "text": "火のついた蝋燭みたいに、\n身体がドロドロ溶けちゅう\n感じがするぞね。"},
        { "location": "41/TALK"   , "narrator": "神楽", "text": "そろそろ\n夏本番ですからね…。"},
        { "location": "43/TALK"   , "narrator": "神楽", "text": "って、みやびさん！？\n胸元開いてますよ！"},
        { "location": "44/TALK"   , "narrator": "みやび", "text": "開いてるんやない、\n開けてるんよ。"},
        { "location": "45/TALK"   , "narrator": "みやび", "text": "こうしとけば新鮮な空気が\n谷間を通って、全身に\n伝わり…。"},
        { "location": "47/TALK"   , "narrator": "神楽", "text": "そうじゃなくて！\nほら、男子達が見てます\nから！"},
        { "location": "50/TALK"   , "narrator": "みやび", "text": "…ん？"},
        { "location": "51/TALK"   , "narrator": "男子高校生Ａ", "text": "やべっ、バレたか！？"},
        { "location": "53/TALK"   , "narrator": "男子高校生Ｂ", "text": "俺はバレてない。\nチラッとしか見てないから\nバレてない！"},
        { "location": "54/TALK"   , "narrator": "みやび", "text": "…………。"},
        { "location": "57/TALK"   , "narrator": "みやび", "text": "チラッ。"},
        { "location": "59/TALK"   , "narrator": "男子高校生Ａ", "text": "っ！？"},
        { "location": "61/TALK"   , "narrator": "男子高校生Ｂ", "text": "ぐっ…耐えろ…\nあれは罠だ！"},
        { "location": "64/TALK"   , "narrator": "神楽", "text": "ほら、あの辺の人達なんか\n明らかに見てるじゃ\nないですか。"},
        { "location": "67/TALK"   , "narrator": "みやび", "text": "まあ、見たい奴には\n見せとけばえいよ。"},
        { "location": "68/TALK"   , "narrator": "みやび", "text": "見られて減るもんや\nないんやし…。"},
        { "location": "71/TALK"   , "narrator": "みやび", "text": "いや、減るならむしろ\n丸出しにしたいくらいや\nけんどね。"},
        { "location": "72/SEL"    , "narrator": "", "text": "見られたくない"},
        { "location": "73/SEL"    , "narrator": "", "text": "見せて！"},
        { "location": "77/TALK"   , "narrator": "神楽", "text": "みやびさんが言うと\n冗談に聞こえません！"},
        { "location": "78/TALK"   , "narrator": "神楽", "text": "…いえ、みやびさんなら\n本気でそう思ってるかも\nしれませんけど。"},
        { "location": "80/TALK"   , "narrator": "みやび", "text": "うちはいつも本気や。"},
        { "location": "85/TALK"   , "narrator": "神楽", "text": "はぁ…まあ、みやびさん\nらしくはあると思います\nけど――"},
        { "location": "87/TALK"   , "narrator": "神楽", "text": "このまま放っては\nおけません。\nほら、閉めてください。"},
        { "location": "88/TALK"   , "narrator": "みやび", "text": "うっ…ご、強引やね。"},
        { "location": "89/TALK"   , "narrator": "神楽", "text": "ネクタイは少しだけ\n緩めておきますから、\nそれで我慢してください。"},
        { "location": "91/TALK"   , "narrator": "神楽", "text": "ていうか、自分が\n女の子である自覚を、\n少しは持ってください。"},
        { "location": "93/TALK"   , "narrator": "みやび", "text": "…女いうんは、\n息苦しいもんやね…。"},
        { "location": "95/ACT"    , "narrator": "", "text": "見られたくない"},
        { "location": "115/TALK"  , "narrator": "みやび", "text": "安心しい、相棒"},
        { "location": "116/TALK"  , "narrator": "みやび", "text": "この暑い中、たかだかおっぱいごとき長々見る奴なんぞ、まずおらんよ"},
        { "location": "169/TALK"  , "narrator": "みやび", "text": "…卯月も、気にせんで\nうちみたいにした方が\n涼しくてえいよ。"},
        { "location": "172/TALK"  , "narrator": "神楽", "text": "できるわけないじゃ\nないですか！"},
        { "location": "174/TALK"  , "narrator": "神楽", "text": "みんなに見られてる、\nって言ってるのに…。"},
        { "location": "175/TALK"  , "narrator": "みやび", "text": "この暑さやき、スケベ心で\nおっぱい見て余計暑くなる\nような輩は――"},
        { "location": "177/TALK"  , "narrator": "みやび", "text": "さすがにおらんよ。"},
        { "location": "180/TALK"  , "narrator": "神楽", "text": "現に見られてるのに…。"},
        { "location": "181/TALK"  , "narrator": "みやび", "text": "チラッと見られるくらい、\n安いもんや。"},
        { "location": "184/TALK"  , "narrator": "男子高校生Ａ", "text": "…チラッと見るのを、\n延々と繰り返してるん\nだけどな。"},
        { "location": "187/TALK"  , "narrator": "男子高校生Ｂ", "text": "男のスケベ心は\n暑さには負けねぇんだ！"},
        { "location": "189/TALK"  , "narrator": "みやび", "text": "…しっかし、今日の男子は\nやけに汗かいちゅう気が\nするな。"},
        { "location": "191/TALK"  , "narrator": "神楽", "text": "…みやびさんのせいです\nからね？"},
        { "location": "192/ACT"   , "narrator": "", "text": "見せて！"},
        { "location": "211/TALK"  , "narrator": "みやび", "text": "相棒は何もわかっちょらんね"},
        { "location": "212/TALK"  , "narrator": "みやび", "text": "こういうんは見せてと頼むんやなくて"},
        { "location": "213/TALK"  , "narrator": "みやび", "text": "気付かれんようにチラチラ見るからこそ価値があるんよ？"},
        { "location": "214/TALK"  , "narrator": "みやび", "text": "やき、自力で頑張りぃ"},
        { "location": "215/TALK"  , "narrator": "みやび", "text": "まあ、固定カメラやき、見よう思うても無理やと思うけんど"},
        { "location": "19/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>6月17日　12:33 PM</color>\nとある昼休み、学園校庭にて。"}
    ]
}
