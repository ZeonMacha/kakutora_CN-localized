    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "480_祭りだ祭りだ"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "お内裏様とお雛様"},
        { "location": "33/TALK"   , "narrator": "みやび", "text": "今日は楽しいひな祭り"},
        { "location": "35/SEL"    , "narrator": "", "text": "今夜はご馳走だ！"},
        { "location": "36/SEL"    , "narrator": "", "text": "日付をお間違えでは"},
        { "location": "37/SEL"    , "narrator": "", "text": "$me$とみやびのことだよね"},
        { "location": "38/ACT"    , "narrator": "", "text": "今夜はご馳走だ！"},
        { "location": "39/TALK"   , "narrator": "みやび", "text": "ちらし寿司だ！"},
        { "location": "41/TALK"   , "narrator": "みやび", "text": "雛あられだ！"},
        { "location": "42/ACT"    , "narrator": "", "text": "日付をお間違えでは"},
        { "location": "43/TALK"   , "narrator": "みやび", "text": "物の例えだ"},
        { "location": "44/TALK"   , "narrator": "みやび", "text": "ばかちんが"},
        { "location": "45/ACT"    , "narrator": "", "text": "$me$とみやびのことだよね"},
        { "location": "55/TALK"   , "narrator": "みやび", "text": "何を言うか"},
        { "location": "56/TALK"   , "narrator": "みやび", "text": "$handle$め"},
        { "location": "57/TALK"   , "narrator": "みやび", "text": "もっとこう"},
        { "location": "58/TALK"   , "narrator": "みやび", "text": "洒落た言い方はできぬのか"},
        { "location": "59/TALK"   , "narrator": "みやび", "text": "朴念仁め"},
        { "location": "61/TALK"   , "narrator": "みやび", "text": "ガブちゃんあたりなら"},
        { "location": "62/TALK"   , "narrator": "みやび", "text": "アメリカのアニメのお姫様あたりを"},
        { "location": "63/TALK"   , "narrator": "みやび", "text": "想像するのだろうが"},
        { "location": "64/TALK"   , "narrator": "みやび", "text": "うちにとってはお姫様とは"},
        { "location": "65/TALK"   , "narrator": "みやび", "text": "こんな感じぞね"},
        { "location": "67/SEL"    , "narrator": "", "text": "みやびらしいね"},
        { "location": "68/SEL"    , "narrator": "", "text": "じゃあ$me$はお内裏様だね"},
        { "location": "69/SEL"    , "narrator": "", "text": "四民平等！"},
        { "location": "70/ACT"    , "narrator": "", "text": "みやびらしいね"},
        { "location": "71/TALK"   , "narrator": "みやび", "text": "うむ"},
        { "location": "72/TALK"   , "narrator": "みやび", "text": "そうかもしれん"},
        { "location": "73/ACT"    , "narrator": "", "text": "じゃあ$me$はお内裏様だね"},
        { "location": "74/TALK"   , "narrator": "みやび", "text": "なるほど"},
        { "location": "75/TALK"   , "narrator": "みやび", "text": "それもいいかもしれん"},
        { "location": "76/ACT"    , "narrator": "", "text": "四民平等！"},
        { "location": "77/TALK"   , "narrator": "みやび", "text": "日本史か"},
        { "location": "79/TALK"   , "narrator": "みやび", "text": "時代錯誤め"},
        { "location": "81/TALK"   , "narrator": "みやび", "text": "女子はお姫様に憧れると言うので"},
        { "location": "82/TALK"   , "narrator": "みやび", "text": "ちょっと想像してみたが"},
        { "location": "83/TALK"   , "narrator": "みやび", "text": "こういうのではない気がしてきた"},
        { "location": "85/SEL"    , "narrator": "", "text": "ちやほやされたいってことじゃない"},
        { "location": "86/SEL"    , "narrator": "", "text": "実生活は窮屈だと思うよ"},
        { "location": "87/ACT"    , "narrator": "", "text": "ちやほやされたいってことじゃない"},
        { "location": "88/TALK"   , "narrator": "みやび", "text": "そういうことなのか"},
        { "location": "89/ACT"    , "narrator": "", "text": "実生活は窮屈だと思うよ"},
        { "location": "90/TALK"   , "narrator": "みやび", "text": "ロイヤルファミリーか"},
        { "location": "92/TALK"   , "narrator": "みやび", "text": "せっかくだ"},
        { "location": "93/TALK"   , "narrator": "みやび", "text": "$handle$はうちをお姫さま扱いせい"},
        { "location": "95/SEL"    , "narrator": "", "text": "良きに計らえ"},
        { "location": "96/SEL"    , "narrator": "", "text": "みやび姫ー！"},
        { "location": "97/SEL"    , "narrator": "", "text": "まず設定を固めないと"},
        { "location": "98/ACT"    , "narrator": "", "text": "良きに計らえ"},
        { "location": "99/TALK"   , "narrator": "みやび", "text": "それでは$handle$が姫役ではないか"},
        { "location": "100/TALK"  , "narrator": "みやび", "text": "$handle$姫め"},
        { "location": "103/ACT"   , "narrator": "", "text": "みやび姫ー！"},
        { "location": "104/TALK"  , "narrator": "みやび", "text": "やはり"},
        { "location": "105/TALK"  , "narrator": "みやび", "text": "和風から脱却できんの"},
        { "location": "106/ACT"   , "narrator": "", "text": "まず設定を固めないと"},
        { "location": "107/TALK"  , "narrator": "みやび", "text": "いやいや"},
        { "location": "108/TALK"  , "narrator": "みやび", "text": "役作りをしたいわけではない"},
        { "location": "110/TALK"  , "narrator": "みやび", "text": "そういえば"},
        { "location": "111/TALK"  , "narrator": "みやび", "text": "$handle$に憧れているものはないのか"},
        { "location": "113/SEL"   , "narrator": "", "text": "大統領？"},
        { "location": "114/SEL"   , "narrator": "", "text": "大魔王"},
        { "location": "115/SEL"   , "narrator": "", "text": "仙人かな"},
        { "location": "116/ACT"   , "narrator": "", "text": "大統領？"},
        { "location": "117/TALK"  , "narrator": "みやび", "text": "ここは日本だし"},
        { "location": "119/TALK"  , "narrator": "みやび", "text": "聞かれてもな"},
        { "location": "120/ACT"   , "narrator": "", "text": "大魔王"},
        { "location": "121/TALK"  , "narrator": "みやび", "text": "大のつく魔王か"},
        { "location": "122/TALK"  , "narrator": "みやび", "text": "ひと味違うな"},
        { "location": "123/ACT"   , "narrator": "", "text": "仙人かな"},
        { "location": "124/TALK"  , "narrator": "みやび", "text": "何もかもを超越したいのか"},
        { "location": "125/TALK"  , "narrator": "みやび", "text": "無我の境地か"},
        { "location": "127/TALK"  , "narrator": "みやび", "text": "それにしても"},
        { "location": "128/TALK"  , "narrator": "みやび", "text": "ネタ回答で返すとは"},
        { "location": "129/TALK"  , "narrator": "みやび", "text": "乙女心のわからんやつめ"},
        { "location": "51/DIALOG" , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>1000pt.</b></color></size>\nアップしました！"}
    ]
