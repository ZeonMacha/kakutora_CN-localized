    "entry":
    [
        { "location": "87/SCENARIO", "narrator": "", "text": "023_シュールなシュールストレミング"},
        { "location": "112/TALK"   , "narrator": "みやび", "text": "シュールストレミングを売っているところを知っているかね"},
        { "location": "114/SEL"    , "narrator": "", "text": "えっと……何？"},
        { "location": "115/SEL"    , "narrator": "", "text": "知ってる、超ある"},
        { "location": "116/ACT"    , "narrator": "", "text": "えっと……何？"},
        { "location": "117/TALK"   , "narrator": "みやび", "text": "シュールストレミングぞね"},
        { "location": "118/TALK"   , "narrator": "みやび", "text": "主にスウェーデンで生産および消費される、塩漬けのニシンの缶詰だ"},
        { "location": "119/ACT"    , "narrator": "", "text": "知ってる、超ある"},
        { "location": "120/TALK"   , "narrator": "みやび", "text": "適当なことを言うな"},
        { "location": "121/TALK"   , "narrator": "みやび", "text": "そう簡単には売っておらぬ"},
        { "location": "124/SEL"    , "narrator": "", "text": "それがどうしたの"},
        { "location": "125/SEL"    , "narrator": "", "text": "欲しいなら届けようか"},
        { "location": "126/ACT"    , "narrator": "", "text": "それがどうしたの"},
        { "location": "127/TALK"   , "narrator": "みやび", "text": "所望する"},
        { "location": "128/ACT"    , "narrator": "", "text": "欲しいなら届けようか"},
        { "location": "130/TALK"   , "narrator": "みやび", "text": "よろしく頼む"},
        { "location": "132/TALK"   , "narrator": "みやび", "text": "とはいえ"},
        { "location": "133/TALK"   , "narrator": "みやび", "text": "実のところ"},
        { "location": "134/TALK"   , "narrator": "みやび", "text": "時期が時期のためこの時期は存在せぬ"},
        { "location": "137/SEL"    , "narrator": "", "text": "缶詰めだよね？"},
        { "location": "138/SEL"    , "narrator": "", "text": "そういうものなの"},
        { "location": "139/SEL"    , "narrator": "", "text": "不可能を可能にしてみせよう"},
        { "location": "140/ACT"    , "narrator": "", "text": "缶詰めだよね？"},
        { "location": "141/TALK"   , "narrator": "みやび", "text": "左様"},
        { "location": "142/TALK"   , "narrator": "みやび", "text": "季節限定なのだ"},
        { "location": "143/TALK"   , "narrator": "みやび", "text": "恐ろしかろう"},
        { "location": "144/ACT"    , "narrator": "", "text": "そういうものなの"},
        { "location": "145/TALK"   , "narrator": "みやび", "text": "うむ"},
        { "location": "146/TALK"   , "narrator": "みやび", "text": "そういうものなのだ"},
        { "location": "147/ACT"    , "narrator": "", "text": "不可能を可能にしてみせよう"},
        { "location": "149/TALK"   , "narrator": "みやび", "text": "その意気だ"},
        { "location": "151/TALK"   , "narrator": "みやび", "text": "期待しておるぞ"}
    ]
}
