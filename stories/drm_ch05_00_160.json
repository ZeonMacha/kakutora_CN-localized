        { "location": "735/TALK"    , "narrator": "神楽", "text": "何でしょうか？"},
        { "location": "737/SEL"     , "narrator": "", "text": "この前口調変わってなかった？"},
        { "location": "738/SEL"     , "narrator": "", "text": "怒らせると本性出るの？"},
        { "location": "739/SEL"     , "narrator": "", "text": "やっぱりなんでもない"},
        { "location": "740/ACT"     , "narrator": "", "text": "この前口調変わってなかった？"},
