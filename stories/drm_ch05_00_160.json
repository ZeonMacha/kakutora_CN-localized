        { "location": "748/ACT"     , "narrator": "", "text": "やっぱりなんでもない"},
        { "location": "749/TALK"    , "narrator": "神楽", "text": "そうですか？"},
        { "location": "750/TALK"    , "narrator": "神楽", "text": "ならいいんですけど、、、"},
        { "location": "752/TALK"    , "narrator": "神楽", "text": "ぴょんこはアーティストとして嘘を本当に見せるのがお仕事だったりしますけど"},
        { "location": "753/TALK"    , "narrator": "神楽", "text": "そういうことをしていない人はやっぱりその境目が曖昧なんでしょうか？"},
        { "location": "755/SEL"     , "narrator": "", "text": "それはあるかも"},
        { "location": "756/SEL"     , "narrator": "", "text": "嘘を嘘と見抜けないと"},
        { "location": "757/SEL"     , "narrator": "", "text": "$me$は神楽の真実を知りたい"},
        { "location": "758/ACT"     , "narrator": "", "text": "それはあるかも"},
        { "location": "759/TALK"    , "narrator": "神楽", "text": "ですよね～"},
        { "location": "761/TALK"    , "narrator": "神楽", "text": "ありますよね～"},
        { "location": "762/ACT"     , "narrator": "", "text": "嘘を嘘と見抜けないと"},
        { "location": "763/TALK"    , "narrator": "神楽", "text": "インターネットを使うのは難しい、ですよね！"},
        { "location": "764/TALK"    , "narrator": "神楽", "text": "ぴょんこちゃんと知ってるんですから！"},
        { "location": "765/ACT"     , "narrator": "", "text": "$me$は神楽の真実を知りたい"},
        { "location": "766/TALK"    , "narrator": "神楽", "text": "えっそれって、、、、"},
        { "location": "767/TALK"    , "narrator": "神楽", "text": "ドキドキしちゃいますねっ♪"},
        { "location": "769/TALK"    , "narrator": "神楽", "text": "小さい頃は嘘つきは泥棒の始まりなんて教えられましたけど"},
        { "location": "770/TALK"    , "narrator": "神楽", "text": "ぴょんこはそんなことないと思うんです"},
        { "location": "771/TALK"    , "narrator": "神楽", "text": "どうしようもない現実よりきれいな嘘の方が欲しい時だってありますよね？"},
        { "location": "773/SEL"     , "narrator": "", "text": "そうかも"},
