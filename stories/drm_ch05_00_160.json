        { "location": "778/TALK"    , "narrator": "神楽", "text": "痛々しい現実を忘れるためのキレイな嘘、、、"},
        { "location": "779/ACT"     , "narrator": "", "text": "その考えが戦争に繋がるんだぞ！"},
        { "location": "780/TALK"    , "narrator": "神楽", "text": "極論ですね～～～"},
        { "location": "781/TALK"    , "narrator": "神楽", "text": "ぴょんこちょっとびっくりしちゃいました♪"},
        { "location": "782/ACT"     , "narrator": "", "text": "$me$は真実だけを知りたい"},
        { "location": "783/TALK"    , "narrator": "神楽", "text": "なるほどなるほど？"},
