        { "location": "704/SCENARIO", "narrator": "", "text": "優しい嘘なんて、（嫌いじゃない）"},
        { "location": "729/TALK"    , "narrator": "神楽", "text": "またつばめさんの純情なところを知ってしまいましたっ♪"},
