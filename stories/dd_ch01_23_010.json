    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "思い出の写真"},
        { "location": "23/TALK"   , "narrator": "つばめ", "text": "えっ、花火？"},
        { "location": "26/TALK"   , "narrator": "ガブリエラ", "text": "うん、だって夏なのよ？"},
        { "location": "27/TALK"   , "narrator": "ガブリエラ", "text": "日本の夏といえば、\n花火をやらなきゃ\n終われないでしょ。"},
        { "location": "29/TALK"   , "narrator": "みやび", "text": "そんなもんせんでも、\nいずれ夏は秋へ変わり\n冬が来るぞね。"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "気持ち的な問題よ。"},
        { "location": "34/TALK"   , "narrator": "アーヤ", "text": "ふふっ…花火をしないと\n夏が終わらないかどうかは\nわからないわ。"},
        { "location": "35/TALK"   , "narrator": "アーヤ", "text": "けど、花火をするのには\n賛成よ。"},
        { "location": "37/TALK"   , "narrator": "アーヤ", "text": "みんなで思い出になる\nようなこと、\nしたかったし。"},
        { "location": "40/TALK"   , "narrator": "つばめ", "text": "わたしも賛成です！\n神楽ちゃんは？"},
        { "location": "43/TALK"   , "narrator": "神楽", "text": "あ、はい…。\n私も、いいと思いますよ。"},
        { "location": "46/TALK"   , "narrator": "ガブリエラ", "text": "みやびは？"},
        { "location": "48/TALK"   , "narrator": "みやび", "text": "うちも構わんよ。\n花火の臭いは\n嫌いやないしね。"},
        { "location": "52/TALK"   , "narrator": "アーヤ", "text": "じゃ、決まりね。\n早速買いに行きましょ。"},
        { "location": "54/TALK"   , "narrator": "つばめ", "text": "あ、アーヤさん。\nわたし、お留守番してて\nいいですか？"},
        { "location": "55/TALK"   , "narrator": "つばめ", "text": "お世話になったお礼に、\n家のお掃除をしようかな、\nって思ってて。"},
        { "location": "57/TALK"   , "narrator": "神楽", "text": "じゃあ、私も残って\nつばめさんを手伝います。"},
        { "location": "60/TALK"   , "narrator": "ガブリエラ", "text": "あたしは行くわ。\nちょっと散歩したい\n気分だったし。"},
        { "location": "63/TALK"   , "narrator": "アーヤ", "text": "みやびはどうする？"},
        { "location": "66/TALK"   , "narrator": "みやび", "text": "…そうやなぁ…。\nほったらかしやった\n自室の掃除でもするがよ。"},
        { "location": "68/TALK"   , "narrator": "アーヤ", "text": "決まりね。\nそれじゃあ、\nささっと行ってくるわ。"},
        { "location": "85/TALK"   , "narrator": "つばめ", "text": "ふぅ…。\n床拭きおしまい！"},
        { "location": "87/TALK"   , "narrator": "つばめ", "text": "えへへ、ピカピカ…。\nやっぱりお掃除すると\n気持ちいいなぁ…。"},
        { "location": "88/TALK"   , "narrator": "つばめ", "text": "…神楽ちゃんの方も、\nそろそろ終わったかな？"},
        { "location": "100/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "101/TALK"  , "narrator": "神楽", "text": "…ふふっ。"},
        { "location": "104/TALK"  , "narrator": "つばめ", "text": "あ、神楽ちゃん。\nお掃除終わったんだ？"},
        { "location": "107/TALK"  , "narrator": "神楽", "text": "きゃっ！？"},
        { "location": "108/TALK"  , "narrator": "つばめ", "text": "あ、ごめん…。\n驚かせちゃった？"},
        { "location": "109/TALK"  , "narrator": "神楽", "text": "いえ、私こそ…。\n写真に夢中になり過ぎて\nました…。"},
        { "location": "110/TALK"  , "narrator": "つばめ", "text": "写真？"},
        { "location": "112/TALK"  , "narrator": "神楽", "text": "はい…トライナリーに\n入隊してから、今までに\n撮ってきた写真です。"},
        { "location": "114/TALK"  , "narrator": "神楽", "text": "あ、ほらこの写真。\n覚えてますか？"},
        { "location": "118/TALK"  , "narrator": "つばめ", "text": "あ、懐かしい！"},
        { "location": "119/TALK"  , "narrator": "つばめ", "text": "これ、神楽ちゃんが\n転校してきた日の\n写真だよね？"},
        { "location": "121/TALK"  , "narrator": "神楽", "text": "正解です。\nそれじゃ…これは？"},
        { "location": "123/TALK"  , "narrator": "つばめ", "text": "覚えてるよ。\n初めて寄り道して\n帰った日の写真だよ。"},
        { "location": "124/TALK"  , "narrator": "つばめ", "text": "あの時食べたたい焼き、\n美味しかったなぁ…。"},
        { "location": "126/TALK"  , "narrator": "神楽", "text": "もう…、つばめさんは\nたい焼きがあったから\n覚えてたんですか？"},
        { "location": "128/TALK"  , "narrator": "つばめ", "text": "ち、違うよ！\nたい焼きのこと以外も\nちゃんと覚えてるから。"},
        { "location": "130/TALK"  , "narrator": "神楽", "text": "じゃあ、\nこれは覚えてますか？"},
        { "location": "132/TALK"  , "narrator": "つばめ", "text": "えっと…あ、これって\n秋葉原に行った時の\n写真だよ。"},
        { "location": "133/TALK"  , "narrator": "つばめ", "text": "あの…えっと…、\n凄い本がいっぱいの\n本屋の前だよね？"},
        { "location": "136/TALK"  , "narrator": "神楽", "text": "さすがつばめさん！\nもしかして、あのお店\nまた行きたいですか？"},
        { "location": "138/TALK"  , "narrator": "つばめ", "text": "えっと…か、神楽ちゃんが\n一緒なら…。"},
        { "location": "140/TALK"  , "narrator": "神楽", "text": "一人で行くのも、\nドキドキして\n楽しいですよ？"},
        { "location": "141/TALK"  , "narrator": "つばめ", "text": "わ、わたしにはちょっと、\n早過ぎるかも…。"},
        { "location": "143/TALK"  , "narrator": "神楽", "text": "ふふっ…。"},
        { "location": "145/TALK"  , "narrator": "神楽", "text": "でも、こうして写真を\n見てて思ったんです。"},
        { "location": "146/TALK"  , "narrator": "神楽", "text": "私達、まだ出会ってから\n数カ月しか経ってないん\nだな、って…。"},
        { "location": "147/TALK"  , "narrator": "つばめ", "text": "…そうだね。\nなんだか、凄く長い時間\n一緒にいる気がするよ。"},
        { "location": "148/TALK"  , "narrator": "神楽", "text": "そうですね…。"},
        { "location": "150/TALK"  , "narrator": "つばめ", "text": "神楽ちゃん。\n東京に戻ったら、\nまた二人でお出かけしよ。"},
        { "location": "154/TALK"  , "narrator": "神楽", "text": "お出かけ、ですか？"},
        { "location": "155/TALK"  , "narrator": "つばめ", "text": "うん。また新しい思いでの\n写真増やしたいんだ。"},
        { "location": "156/TALK"  , "narrator": "つばめ", "text": "それと、\n秋葉原も行きたいな。"},
        { "location": "157/TALK"  , "narrator": "つばめ", "text": "神楽ちゃんおすすめの\nお店、まだまだ教えて\nほしいし。"},
        { "location": "159/TALK"  , "narrator": "神楽", "text": "任せてください。\nつばめさんが喜びそうな\nお店を、まだまだ――"},
        { "location": "160/TALK"  , "narrator": "神楽", "text": "あっ………。"},
        { "location": "161/TALK"  , "narrator": "つばめ", "text": "…神楽ちゃん？"},
        { "location": "164/TALK"  , "narrator": "神楽", "text": "…いえ…また、一緒に\nお出かけできれば\n嬉しいんですけど…。"},
        { "location": "165/TALK"  , "narrator": "つばめ", "text": "うん、だからまた一緒に\nお出かけしよ？"},
        { "location": "166/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "169/TALK"  , "narrator": "神楽", "text": "ごめんなさい。\nちょっと、やることが\nあるので…。"},
        { "location": "174/TALK"  , "narrator": "つばめ", "text": "あっ、神楽ちゃん…。"},
        { "location": "176/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "177/TALK"  , "narrator": "つばめ", "text": "やっぱり、まだダメかな？"},
        { "location": "190/TALK"  , "narrator": "つばめ", "text": "辛ぃな"},
        { "location": "192/TALK"  , "narrator": "つばめ", "text": "神楽ちゃんと"},
        { "location": "193/TALK"  , "narrator": "つばめ", "text": "まだ"},
        { "location": "194/TALK"  , "narrator": "つばめ", "text": "前みたぃに話せなぃ(o´Д`)=з"},
        { "location": "195/TALK"  , "narrator": "つばめ", "text": "結構よくなったけど"},
        { "location": "196/TALK"  , "narrator": "つばめ", "text": "でも"},
        { "location": "197/TALK"  , "narrator": "つばめ", "text": "まだ全然なの(´･ω･｀) "},
        { "location": "198/TALK"  , "narrator": "つばめ", "text": "東京戻っても"},
        { "location": "199/TALK"  , "narrator": "つばめ", "text": "しばらくは"},
        { "location": "200/TALK"  , "narrator": "つばめ", "text": "この状態なのかな？"},
        { "location": "203/TALK"  , "narrator": "つばめ", "text": "だとしたら"},
        { "location": "205/TALK"  , "narrator": "つばめ", "text": "ちょっとヤだな(´つω・｀)ｼｭﾝ"},
        { "location": "207/SEL"   , "narrator": "", "text": "そうかもしれない"},
        { "location": "208/SEL"   , "narrator": "", "text": "神楽もそう思ってるかも"},
        { "location": "209/SEL"   , "narrator": "", "text": "嫌な予感がするよ"},
        { "location": "210/ACT"   , "narrator": "", "text": "そうかもしれない"},
        { "location": "211/TALK"  , "narrator": "つばめ", "text": "そっか"},
        { "location": "212/TALK"  , "narrator": "つばめ", "text": "$handle$さんも思ぅなら"},
        { "location": "213/TALK"  , "narrator": "つばめ", "text": "そぅなのかも(´つω・｀)ｼｭﾝ"},
        { "location": "216/TALK"  , "narrator": "つばめ", "text": "どうにかできればぃぃけど"},
        { "location": "217/TALK"  , "narrator": "つばめ", "text": "どうしたらぃぃか"},
        { "location": "218/TALK"  , "narrator": "つばめ", "text": "わからなぃし(o´Д`)=з"},
        { "location": "220/SEL"   , "narrator": "", "text": "とにかく神楽と話そうよ"},
        { "location": "221/ACT"   , "narrator": "", "text": "とにかく神楽と話そうよ"},
        { "location": "223/TALK"  , "narrator": "つばめ", "text": "話したぃけど"},
        { "location": "224/TALK"  , "narrator": "つばめ", "text": "神楽ちゃん"},
        { "location": "225/TALK"  , "narrator": "つばめ", "text": "すぐ離れてっちゃぅから(´･ω･｀) "},
        { "location": "226/TALK"  , "narrator": "つばめ", "text": "話したくても"},
        { "location": "227/TALK"  , "narrator": "つばめ", "text": "できなぃよヾ(｡>﹏<｡)ﾉﾞ"},
        { "location": "229/SEL"   , "narrator": "", "text": "弱気はつばめらしくないよ"},
        { "location": "230/ACT"   , "narrator": "", "text": "弱気はつばめらしくないよ"},
        { "location": "232/TALK"  , "narrator": "つばめ", "text": "弱気かな？(´・ω・`) "},
        { "location": "235/TALK"  , "narrator": "つばめ", "text": "ぅぅん"},
        { "location": "236/TALK"  , "narrator": "つばめ", "text": "弱気だった_(┐「ε:)_"},
        { "location": "238/TALK"  , "narrator": "つばめ", "text": "わたしが弱気じゃ"},
        { "location": "239/TALK"  , "narrator": "つばめ", "text": "神楽ちゃんと話すことなんて"},
        { "location": "240/TALK"  , "narrator": "つばめ", "text": "絶対無理だよね(/ω＼)"},
        { "location": "243/TALK"  , "narrator": "つばめ", "text": "落ち込んでられないね(๑･ㅂ･)و☆"},
        { "location": "244/TALK"  , "narrator": "つばめ", "text": "また神楽ちゃんと"},
        { "location": "245/TALK"  , "narrator": "つばめ", "text": "前みたいにお話したいから"},
        { "location": "247/TALK"  , "narrator": "つばめ", "text": "そうだ(≧ω≦)"},
        { "location": "248/TALK"  , "narrator": "つばめ", "text": "東京帰ったら"},
        { "location": "249/TALK"  , "narrator": "つばめ", "text": "今度はわたしが"},
        { "location": "250/TALK"  , "narrator": "つばめ", "text": "神楽ちゃんのこと"},
        { "location": "251/TALK"  , "narrator": "つばめ", "text": "色んなとこへ引っ張ってこうかな？(≧艸≦*)"},
        { "location": "252/ACT"   , "narrator": "", "text": "神楽もそう思ってるかも"},
        { "location": "253/TALK"  , "narrator": "つばめ", "text": "そうかな？(･Д･｀)"},
        { "location": "254/TALK"  , "narrator": "つばめ", "text": "本当に"},
        { "location": "255/TALK"  , "narrator": "つばめ", "text": "そうなのかな？(´･ω･｀) "},
        { "location": "257/SEL"   , "narrator": "", "text": "写真見てたのが証拠だよ"},
        { "location": "258/ACT"   , "narrator": "", "text": "写真見てたのが証拠だよ"},
        { "location": "260/TALK"  , "narrator": "つばめ", "text": "そっか"},
        { "location": "261/TALK"  , "narrator": "つばめ", "text": "そぅだよね(*´︶`*)"},
        { "location": "262/TALK"  , "narrator": "つばめ", "text": "神楽ちゃんが"},
        { "location": "263/TALK"  , "narrator": "つばめ", "text": "本当にわたし達を避けてるなら"},
        { "location": "264/TALK"  , "narrator": "つばめ", "text": "写真なんか見なぃはずだよ(๑･ㅂ･)و☆"},
        { "location": "265/TALK"  , "narrator": "つばめ", "text": "ってことは"},
        { "location": "266/TALK"  , "narrator": "つばめ", "text": "色々あったから"},
        { "location": "268/TALK"  , "narrator": "つばめ", "text": "居づらい気持ちになってるのかな？(´・ω・｀)"},
        { "location": "270/SEL"   , "narrator": "", "text": "少し待っててあげよう"},
        { "location": "271/ACT"   , "narrator": "", "text": "少し待っててあげよう"},
        { "location": "273/TALK"  , "narrator": "つばめ", "text": "ぅん"},
        { "location": "274/TALK"  , "narrator": "つばめ", "text": "焦らせても"},
        { "location": "275/TALK"  , "narrator": "つばめ", "text": "困らせちゃぅし(・ω・`)"},
        { "location": "276/TALK"  , "narrator": "つばめ", "text": "そうするね(*´︶`*)"},
        { "location": "277/TALK"  , "narrator": "つばめ", "text": "ぁりがとぅ、$handle$さん"},
        { "location": "279/TALK"  , "narrator": "つばめ", "text": "ちょっと"},
        { "location": "280/TALK"  , "narrator": "つばめ", "text": "元気出たかも(●´ω｀●)"},
        { "location": "281/ACT"   , "narrator": "", "text": "嫌な予感がするよ"},
        { "location": "284/TALK"  , "narrator": "つばめ", "text": "えっ(･Д･｀)"},
        { "location": "285/TALK"  , "narrator": "つばめ", "text": "どぅぃぅこと？"},
        { "location": "287/SEL"   , "narrator": "", "text": "わからないけど、感じた"},
        { "location": "288/ACT"   , "narrator": "", "text": "わからないけど、感じた"},
        { "location": "290/TALK"  , "narrator": "つばめ", "text": "そっか(´・ω・｀)"},
        { "location": "292/TALK"  , "narrator": "つばめ", "text": "でも"},
        { "location": "293/TALK"  , "narrator": "つばめ", "text": "本当に何もなかったら"},
        { "location": "294/TALK"  , "narrator": "つばめ", "text": "そんな予感しなぃよね？ヾ(｡>﹏<｡)ﾉﾞ"},
        { "location": "295/TALK"  , "narrator": "つばめ", "text": "もしかしたら"},
        { "location": "296/TALK"  , "narrator": "つばめ", "text": "何かよくなぃこと"},
        { "location": "297/TALK"  , "narrator": "つばめ", "text": "起こるのかも(´ｪ｀；)三(；´ｪ｀)"},
        { "location": "299/SEL"   , "narrator": "", "text": "変なこと言ってごめん"},
        { "location": "300/ACT"   , "narrator": "", "text": "変なこと言ってごめん"},
        { "location": "302/TALK"  , "narrator": "つばめ", "text": "ぅぅん"},
        { "location": "303/TALK"  , "narrator": "つばめ", "text": "言ってくれてぁりがと"},
        { "location": "304/TALK"  , "narrator": "つばめ", "text": "こんなこと"},
        { "location": "305/TALK"  , "narrator": "つばめ", "text": "言ぃにくかったよね？(o´Д`)=з"},
        { "location": "308/SEL"   , "narrator": "", "text": "でも、言っておきたかった"},
        { "location": "309/ACT"   , "narrator": "", "text": "でも、言っておきたかった"},
        { "location": "311/TALK"  , "narrator": "つばめ", "text": "ぅん"},
        { "location": "312/TALK"  , "narrator": "つばめ", "text": "$handle$さんの予感"},
        { "location": "313/TALK"  , "narrator": "つばめ", "text": "信じるよ(*´︶`*)"},
        { "location": "21/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>8月25日　 3:46 PM</color>\n合宿中、みやびの実家でのこと"},
