    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "010_恋だなんて言いたくないの"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "きゅんとしたり切なくなったりしないなら"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "恋だなんて言いたくないの"},
        { "location": "36/SEL"    , "narrator": "", "text": "新しい詩かな？"},
        { "location": "37/SEL"    , "narrator": "", "text": "お腹が空いたの？"},
        { "location": "38/SEL"    , "narrator": "", "text": "新しい恋の話？"},
        { "location": "39/ACT"    , "narrator": "", "text": "新しい詩かな？"},
        { "location": "40/TALK"   , "narrator": "ガブリエラ", "text": "違うわよ"},
        { "location": "41/ACT"    , "narrator": "", "text": "お腹が空いたの？"},
        { "location": "42/TALK"   , "narrator": "ガブリエラ", "text": "そうじゃないのよ"},
        { "location": "43/ACT"    , "narrator": "", "text": "新しい恋の話？"},
        { "location": "45/TALK"   , "narrator": "ガブリエラ", "text": "そういうわけじゃないんだけど////////////////"},
        { "location": "46/TALK"   , "narrator": "ガブリエラ", "text": "そういうわけなのかしらvvvvvvvvvvvvvvvv"},
        { "location": "48/TALK"   , "narrator": "ガブリエラ", "text": "やっぱり"},
        { "location": "49/TALK"   , "narrator": "ガブリエラ", "text": "女の子なんだから"},
        { "location": "50/TALK"   , "narrator": "ガブリエラ", "text": "いつも恋をしていたいのよvvvvvvvvvvvvvvvvvv"},
        { "location": "52/SEL"    , "narrator": "", "text": "さよけ"},
        { "location": "53/SEL"    , "narrator": "", "text": "$handle$と恋をしようよ"},
        { "location": "54/SEL"    , "narrator": "", "text": "そうだね"},
        { "location": "55/ACT"    , "narrator": "", "text": "さよけ"},
        { "location": "56/TALK"   , "narrator": "ガブリエラ", "text": "そうよ"},
        { "location": "57/TALK"   , "narrator": "ガブリエラ", "text": "そうなのよ"},
        { "location": "58/ACT"    , "narrator": "", "text": "$handle$と恋をしようよ"},
        { "location": "60/TALK"   , "narrator": "ガブリエラ", "text": "またそんなことばかり言って"},
        { "location": "61/TALK"   , "narrator": "ガブリエラ", "text": "変な子ね"},
        { "location": "62/ACT"    , "narrator": "", "text": "そうだね"},
        { "location": "63/TALK"   , "narrator": "ガブリエラ", "text": "でしょう！？"},
        { "location": "65/TALK"   , "narrator": "ガブリエラ", "text": "じゃあ"},
        { "location": "66/TALK"   , "narrator": "ガブリエラ", "text": "きゅんとしたり切なくなったら"},
        { "location": "67/TALK"   , "narrator": "ガブリエラ", "text": "全部恋なのかしら？"},
        { "location": "68/TALK"   , "narrator": "ガブリエラ", "text": "例えば昔のアーヤはとてもかっこよくて眩しかったわ"},
        { "location": "69/TALK"   , "narrator": "ガブリエラ", "text": "日本にきた理由の一つだったくらいよ"},
        { "location": "71/SEL"    , "narrator": "", "text": "それは違うかも"},
        { "location": "72/SEL"    , "narrator": "", "text": "それこそ真実の恋"},
        { "location": "73/ACT"    , "narrator": "", "text": "それは違うかも"},
        { "location": "74/TALK"   , "narrator": "ガブリエラ", "text": "違うわよね・・・"},
        { "location": "75/TALK"   , "narrator": "ガブリエラ", "text": "でも昔のアーヤを見たらきっとマルザンナも恋したみたいな気持ちになってよ？"},
        { "location": "77/SEL"    , "narrator": "", "text": "そうかな？"},
        { "location": "78/SEL"    , "narrator": "", "text": "そうかも"},
        { "location": "79/ACT"    , "narrator": "", "text": "そうかな？"},
        { "location": "80/TALK"   , "narrator": "ガブリエラ", "text": "そうよ！"},
        { "location": "81/ACT"    , "narrator": "", "text": "そうかも"},
        { "location": "82/TALK"   , "narrator": "ガブリエラ", "text": "そうよねｖｖｖｖ"},
        { "location": "84/TALK"   , "narrator": "ガブリエラ", "text": "でもそれは"},
        { "location": "85/TALK"   , "narrator": "ガブリエラ", "text": "私の大事な思い出だからあげられないわ・・・"},
        { "location": "86/TALK"   , "narrator": "ガブリエラ", "text": "マルザンナにもね"},
        { "location": "87/ACT"    , "narrator": "", "text": "それこそ真実の恋"},
        { "location": "88/TALK"   , "narrator": "ガブリエラ", "text": "そうなのかしらね？"},
        { "location": "90/SEL"    , "narrator": "", "text": "絶対そう"},
        { "location": "91/SEL"    , "narrator": "", "text": "すみません嘘です"},
        { "location": "92/ACT"    , "narrator": "", "text": "絶対そう"},
        { "location": "93/TALK"   , "narrator": "ガブリエラ", "text": "そうかしら・・・・"},
        { "location": "94/ACT"    , "narrator": "", "text": "すみません嘘です"},
        { "location": "95/TALK"   , "narrator": "ガブリエラ", "text": "ひどいわマルザンナったら"},
        { "location": "97/TALK"   , "narrator": "ガブリエラ", "text": "真実の恋かどうかは置いておいて"},
        { "location": "98/TALK"   , "narrator": "ガブリエラ", "text": "これは私の大事な思い出なの"},
        { "location": "99/TALK"   , "narrator": "ガブリエラ", "text": "アーヤは忘れたいみたいだけど・・・"},
        { "location": "100/TALK"  , "narrator": "ガブリエラ", "text": "それが少し寂しいの"}
    ]
}
