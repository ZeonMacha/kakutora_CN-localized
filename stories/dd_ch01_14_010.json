{
    "dir": "chap14/daydra/dd_ch01_14_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "14152",
        "cid": "tsubame",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "國政綾水とスクーター"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "アーヤＭＶ回１"},
        { "location": "27/TALK"   , "narrator": "アーヤ", "text": "えーっと、\n確かこの辺の\nページに…。"},
        { "location": "29/TALK"   , "narrator": "アーヤ", "text": "あったわ。\nほら、外国製\nスクーターの特集よ。"},
        { "location": "31/TALK"   , "narrator": "つばめ", "text": "わぁ、カワイイ！"},
        { "location": "34/TALK"   , "narrator": "神楽", "text": "ふふ、つばめさんなら\n気に入ると思って\nました。"},
        { "location": "37/TALK"   , "narrator": "アーヤ", "text": "それにしても、\n外国のスクーターに\n興味あるなんて意外ね。"},
        { "location": "40/TALK"   , "narrator": "神楽", "text": "前にテレビで見た\nことがあるんです\nけど――"},
        { "location": "41/TALK"   , "narrator": "神楽", "text": "つばめさんが\n好きそうだったから、\n覚えていたんです。"},
        { "location": "42/TALK"   , "narrator": "つばめ", "text": "こんなに可愛いなら、\nわたしも乗って\nみたいなぁ…。"},
        { "location": "44/TALK"   , "narrator": "神楽", "text": "私も可愛いスクーターに\n乗ったつばめさん、\n見てみたいです。"},
        { "location": "45/TALK"   , "narrator": "アーヤ", "text": "その時は、\n卯月も一緒に免許\n取ったら？"},
        { "location": "48/TALK"   , "narrator": "神楽", "text": "私はつばめさんの\n後ろに乗りたいん\nです！"},
        { "location": "49/TALK"   , "narrator": "アーヤ", "text": "二人乗りは免許を\n取って一年以上\n経たないと無理よ。"},
        { "location": "50/TALK"   , "narrator": "アーヤ", "text": "それに、免許取れば\nつばめと一緒に――"},
        { "location": "51/TALK"   , "narrator": "アーヤ", "text": "バイク旅行とかも\n出来るんじゃない？"},
        { "location": "53/TALK"   , "narrator": "神楽", "text": "えっ、バイク旅行？"},
        { "location": "54/TALK"   , "narrator": "アーヤ", "text": "そうよ。"},
        { "location": "55/TALK"   , "narrator": "アーヤ", "text": "観光地に行ったり、\n温泉に行ったり――"},
        { "location": "56/TALK"   , "narrator": "アーヤ", "text": "行動範囲広がるん\nだから、行かないのは\n勿体ないわ。"},
        { "location": "59/TALK"   , "narrator": "つばめ", "text": "わぁ、楽しそう！\nバイクで行く\n温泉旅行かぁ…。"},
        { "location": "79/TALK"   , "narrator": "つばめ", "text": "卯月さん、見て！\n朝日だよ！"},
        { "location": "81/TALK"   , "narrator": "神楽", "text": "綺麗ですね…。\n夜中に出発した甲斐が\nありました。"},
        { "location": "82/TALK"   , "narrator": "つばめ", "text": "うん。\n綺麗だなぁ…。"},
        { "location": "83/TALK"   , "narrator": "神楽", "text": "でも、山の上だから\nちょっと冷えますね。"},
        { "location": "86/TALK"   , "narrator": "神楽", "text": "早く温泉に\n行きましょ。"},
        { "location": "88/TALK"   , "narrator": "つばめ", "text": "うん、あっ！\nでもその前に――"},
        { "location": "89/TALK"   , "narrator": "つばめ", "text": "ここで記念写真撮ろ。\nほら、くっついて\nくっついて！"},
        { "location": "113/TALK"  , "narrator": "つばめ", "text": "気持ちいいねー。\nわたし、もうここから\n出たくないよ…。"},
        { "location": "114/TALK"  , "narrator": "神楽", "text": "何だか、凄く幸せな\n気持ちです…。\n来て正解でしたね。"},
        { "location": "115/TALK"  , "narrator": "つばめ", "text": "うん。他にお客さんも\nいないから、貸し切り\n状態だし…。"},
        { "location": "116/TALK"  , "narrator": "つばめ", "text": "…コッソリ、\n泳いじゃおうかな？"},
        { "location": "119/TALK"  , "narrator": "神楽", "text": "もう、つばめさん\nってば…ちょっと\nだけですよ？"},
        { "location": "133/TALK"  , "narrator": "つばめ", "text": "ふぁ～…。"},
        { "location": "134/TALK"  , "narrator": "つばめ", "text": "朝早かったから、\nもう眠いよぉ…。"},
        { "location": "136/TALK"  , "narrator": "神楽", "text": "ちょっと早いけど、\n今日はもうお布団に\n入りましょう。"},
        { "location": "139/TALK"  , "narrator": "つばめ", "text": "うん。それじゃあ、\n電気消すね。"},
        { "location": "144/TALK"  , "narrator": "神楽", "text": "はい…。\nあっ、そういえば\nこの前――"},
        { "location": "147/TALK"  , "narrator": "神楽", "text": "凄く面白いラノベを\n見つけたんです。"},
        { "location": "148/TALK"  , "narrator": "つばめ", "text": "わぁ、どんなお話か\n聞きたいな。"},
        { "location": "150/TALK"  , "narrator": "神楽", "text": "じゃあ、ネタバレに\nならない程度に…。\n物語は――"},
        { "location": "171/TALK"  , "narrator": "つばめ", "text": "…なんて、そんな\n旅行にしたいなぁ。"},
        { "location": "172/TALK"  , "narrator": "アーヤ", "text": "ふふっ、早速プランを\n立て始めてるわね。"},
        { "location": "173/TALK"  , "narrator": "神楽", "text": "うーん…。"},
        { "location": "176/TALK"  , "narrator": "つばめ", "text": "あ、あれ？\n卯月さんは温泉旅行\n行きたくなかった？"},
        { "location": "178/TALK"  , "narrator": "神楽", "text": "まさか！"},
        { "location": "179/TALK"  , "narrator": "神楽", "text": "つばめさんとなら、\nどこへでも喜んで\nお供しますよ！"},
        { "location": "181/TALK"  , "narrator": "神楽", "text": "ただ…今の話だと、\nちょっと仲良し度が\n足りない気がします。"},
        { "location": "182/TALK"  , "narrator": "つばめ", "text": "はい？"},
        { "location": "184/TALK"  , "narrator": "アーヤ", "text": "仲良し度？"},
        { "location": "187/TALK"  , "narrator": "神楽", "text": "つまりですね、\nもっとこう――"},
        { "location": "207/TALK"  , "narrator": "つばめ", "text": "卯月さん、見て！\n朝日だよ！"},
        { "location": "210/TALK"  , "narrator": "神楽", "text": "朝日に照らされた\nつばめさん、とっても\n綺麗ですよ。"},
        { "location": "213/TALK"  , "narrator": "つばめ", "text": "あはは、卯月さんは\n冗談が上手いん\nだから…。"},
        { "location": "214/TALK"  , "narrator": "神楽", "text": "本気なのに…。"},
        { "location": "215/TALK"  , "narrator": "つばめ", "text": "ふふっ…それより、\n記念写真撮ろうよ。"},
        { "location": "217/TALK"  , "narrator": "神楽", "text": "あ、はい。\nそれじゃ失礼して…。"},
        { "location": "226/TALK"  , "narrator": "つばめ", "text": "ちょ、卯月さん！？\nちょっと近過ぎる\nような…。"},
        { "location": "227/TALK"  , "narrator": "神楽", "text": "ツーショットなんです\nから、離れて撮ったら\n寂しいですよ。"},
        { "location": "229/TALK"  , "narrator": "神楽", "text": "そうだ、ほっぺたも\nくっつけちゃい\nましょう。"},
        { "location": "232/TALK"  , "narrator": "つばめ", "text": "あ、うぅ…、\n恥ずかしいよぉ…。"},
        { "location": "265/TALK"  , "narrator": "つばめ", "text": "気持ちいいねー。\nわたし、もうここから\n出たくないよ…。"},
        { "location": "266/TALK"  , "narrator": "神楽", "text": "何だか、凄く幸せな\n気持ちです…。\n来て正解でしたね。"},
        { "location": "269/TALK"  , "narrator": "つばめ", "text": "うん。他にお客さんも\nいないから、貸し切り\n状態だし…。"},
        { "location": "270/TALK"  , "narrator": "つばめ", "text": "…コッソリ、\n泳いじゃおうかな？"},
        { "location": "272/TALK"  , "narrator": "神楽", "text": "それより、もっと\nしなくちゃいけない\nことがあります。"},
        { "location": "273/TALK"  , "narrator": "神楽", "text": "つばめさん。\n前に銭湯に行った時\nから――"},
        { "location": "274/TALK"  , "narrator": "神楽", "text": "ちょっと成長したん\nじゃないですか？"},
        { "location": "275/TALK"  , "narrator": "つばめ", "text": "えっ？\nせ、成長って…。"},
        { "location": "281/TALK"  , "narrator": "神楽", "text": "確認しまーす。\nえっと、まずは…。"},
        { "location": "282/TALK"  , "narrator": "つばめ", "text": "ちょ、あっ！\nく、くすぐったいよ、\n卯月さん…。"},
        { "location": "295/TALK"  , "narrator": "つばめ", "text": "ふぁ～…。"},
        { "location": "296/TALK"  , "narrator": "つばめ", "text": "朝早かったから、\nもう眠いよぉ…。"},
        { "location": "298/TALK"  , "narrator": "神楽", "text": "ちょっと早いけど、\n今日はもうお布団に\n入りましょう。"},
        { "location": "301/TALK"  , "narrator": "つばめ", "text": "うん。それじゃあ、\n電気消して――"},
        { "location": "304/TALK"  , "narrator": "つばめ", "text": "あ、あれ？\n布団、一つしか\n敷いてないよ？"},
        { "location": "306/TALK"  , "narrator": "神楽", "text": "あー、もしかしたら\n私が予約した時に――"},
        { "location": "308/TALK"  , "narrator": "神楽", "text": "カップルプランで\n部屋を取ったからかも\nしれませんねー。"},
        { "location": "311/TALK"  , "narrator": "つばめ", "text": "えぇっ！？\nき、聞いてないよ！"},
        { "location": "312/TALK"  , "narrator": "神楽", "text": "部屋が取れたなら、\nプランは関係ないかな\nって思ったので。"},
        { "location": "314/TALK"  , "narrator": "神楽", "text": "それより、\n早くお布団に\n入りましょう。"},
        { "location": "315/TALK"  , "narrator": "神楽", "text": "温泉で火照った身体が\n冷めないうちに…、\nふふっ…。"},
        { "location": "333/TALK"  , "narrator": "神楽", "text": "…ふふっ。"},
        { "location": "335/TALK"  , "narrator": "アーヤ", "text": "いや、それ友達と\n旅行してる感じに\n聞こえないんだけど？"},
        { "location": "337/TALK"  , "narrator": "神楽", "text": "大親友との旅行なら、\nこれくらい当然の\nことですよ。"},
        { "location": "339/TALK"  , "narrator": "神楽", "text": "つばめさんも\nそう思いますよね？"},
        { "location": "340/SEL"   , "narrator": "", "text": "神楽以外も誘おうよ"},
        { "location": "341/SEL"   , "narrator": "", "text": "$me$も忘れないでね"},
        { "location": "344/TALK"  , "narrator": "つばめ", "text": "うーん、楽しそう\nだけど、お風呂のは\n恥ずかしいかも…。"},
        { "location": "346/TALK"  , "narrator": "神楽", "text": "女の子同士なら\n普通にすることです。"},
        { "location": "348/TALK"  , "narrator": "アーヤ", "text": "当たり前のように\nウソつかないの。"},
        { "location": "350/TALK"  , "narrator": "アーヤ", "text": "まあ、とりあえずは\n免許を取れる年齢に\nなるのが先よね。"},
        { "location": "351/TALK"  , "narrator": "アーヤ", "text": "それに…つばめは\nお父さんからの\n許可も必要じゃない？"},
        { "location": "353/TALK"  , "narrator": "つばめ", "text": "は、はい…免許取る\nよりも、そっちの方が\n何倍も難関かも…。"},
        { "location": "354/TALK"  , "narrator": "神楽", "text": "そ、その時が来たら、\n絶対に説得して\nくださいね。"},
        { "location": "357/TALK"  , "narrator": "つばめ", "text": "…成人するまでダメ、\nって言われそうな\n気がするよぉ…。"},
        { "location": "359/ACT"   , "narrator": "", "text": "神楽以外も誘おうよ"},
        { "location": "378/TALK"  , "narrator": "つばめ", "text": "そぅだね(*´︶`*)"},
        { "location": "379/TALK"  , "narrator": "つばめ", "text": "旅行は"},
        { "location": "380/TALK"  , "narrator": "つばめ", "text": "大勢で行った方が"},
        { "location": "381/TALK"  , "narrator": "つばめ", "text": "楽しそぅだしヽ(*´∀｀*)ﾉ"},
        { "location": "382/TALK"  , "narrator": "つばめ", "text": "それに"},
        { "location": "383/TALK"  , "narrator": "つばめ", "text": "ァーヤさんには"},
        { "location": "384/TALK"  , "narrator": "つばめ", "text": "一緒に来てほしぃかも(≧艸≦*)"},
        { "location": "399/TALK"  , "narrator": "つばめ", "text": "ねえ、卯月さん。\nバイク旅行に\n行く時は――"},
        { "location": "400/TALK"  , "narrator": "つばめ", "text": "みんなも一緒の方が\n楽しいんじゃない\nかな？"},
        { "location": "402/TALK"  , "narrator": "神楽", "text": "それはまあ、\n楽しいとは思います\nけど…。"},
        { "location": "403/TALK"  , "narrator": "つばめ", "text": "それに、バイク旅行に\n慣れてるアーヤさんが\n一緒だと――"},
        { "location": "404/TALK"  , "narrator": "つばめ", "text": "ちょっと心強い気も\nするし。"},
        { "location": "406/TALK"  , "narrator": "アーヤ", "text": "…そういえば、\n誰かとバイク旅行\nしたことって――"},
        { "location": "407/TALK"  , "narrator": "アーヤ", "text": "まだ一度も\nなかったわ。"},
        { "location": "409/TALK"  , "narrator": "つばめ", "text": "そうだったんですか？"},
        { "location": "411/TALK"  , "narrator": "アーヤ", "text": "ええ。"},
        { "location": "413/TALK"  , "narrator": "アーヤ", "text": "まあ、二人きりで\n行かせるのは\n少し心配だし――"},
        { "location": "414/TALK"  , "narrator": "アーヤ", "text": "それに、一人じゃない\nバイク旅行ってのも\n楽しそうかも。"},
        { "location": "417/TALK"  , "narrator": "つばめ", "text": "よかった…。\nこれで安心だね。"},
        { "location": "419/TALK"  , "narrator": "神楽", "text": "まあ、ラブラブ二人旅\nじゃなくなっちゃう\nのが――"},
        { "location": "421/TALK"  , "narrator": "神楽", "text": "ちょこっとだけ\n残念ですけど…。"},
        { "location": "423/TALK"  , "narrator": "アーヤ", "text": "…それも、二人きりに\nするのが心配な理由の\n一つなんだけどね。"},
        { "location": "424/ACT"   , "narrator": "", "text": "$me$も忘れないでね"},
        { "location": "443/TALK"  , "narrator": "つばめ", "text": "もちろんo(*･ﾛ･*)o、"},
        { "location": "444/TALK"  , "narrator": "つばめ", "text": "ぁ"},
        { "location": "445/TALK"  , "narrator": "つばめ", "text": "でもそぅなると"},
        { "location": "446/TALK"  , "narrator": "つばめ", "text": "二人旅行じゃなぃんだよね(´･ω･｀) "},
        { "location": "447/TALK"  , "narrator": "つばめ", "text": "ごめんなさぃ"},
        { "location": "460/TALK"  , "narrator": "つばめ", "text": "うっかりしてたけど、\n二人旅行じゃ\nなくて――"},
        { "location": "462/TALK"  , "narrator": "つばめ", "text": "$handle$さんも\n入るから、\n三人旅行だよね。"},
        { "location": "464/TALK"  , "narrator": "神楽", "text": "…ああ、そういえば。\nすっかり忘れていま\nした…。"},
        { "location": "466/TALK"  , "narrator": "アーヤ", "text": "まあ、$handle$が\nいれば二人に何か\nあっても――"},
        { "location": "467/TALK"  , "narrator": "アーヤ", "text": "こっちに連絡して\nくれるから、\n安心よね。"},
        { "location": "469/TALK"  , "narrator": "つばめ", "text": "はい。"},
        { "location": "471/TALK"  , "narrator": "神楽", "text": "…バイク旅行に\n行く時は――"},
        { "location": "472/TALK"  , "narrator": "神楽", "text": "できるだけ、スマホは\n鞄から出さないように\nしましょうね。"},
        { "location": "16/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>6月26日　1:34 PM</color>\nとある休日、神楽坂トライナリーでのバイトの最中のこと。"}
    ]
}
