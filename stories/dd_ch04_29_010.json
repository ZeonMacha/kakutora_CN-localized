{
    "dir": "chap29/daydra/dd_ch04_29_010.js",
    "type": "",
    "info": {
        "story_id": "50015",
        "cid": "",
        "title": "SideStory015 ストーリー",
        "sub_title": "FILE12.躍進"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "東京編１２話"},
        { "location": "22/DIALOG" , "narrator": "", "text": "<color=green>9月6日　 8:17 PM</color>\n神楽坂トライナリー偵察後、カラオケボックスにて"},
        { "location": "23/TALK"   , "narrator": "キリト", "text": "マジか！？\n劇場に入れそうな場所、\n見つかったのか！"},
        { "location": "25/TALK"   , "narrator": "ヒカル", "text": "うん…かなり強引な\n方法をとる必要が\nあるけど…。"},
        { "location": "26/TALK"   , "narrator": "ヒカル", "text": "間違いなく、\n気づかれずに\n劇場に入れるはずだよ。"},
        { "location": "28/TALK"   , "narrator": "繭", "text": "…でも、どうやって？\n劇場の周囲は厳重に\n警備されてるのに…。"},
        { "location": "30/TALK"   , "narrator": "雛", "text": "はーい、囮役のあたしが\n注意を引きまーす。"},
        { "location": "31/TALK"   , "narrator": "雛", "text": "時間になったら、\n警備の人達に聞こえる\nところで――"},
        { "location": "33/TALK"   , "narrator": "雛", "text": "きゃーっ、痴漢ー！！\n誰か助けてー！！！！"},
        { "location": "35/TALK"   , "narrator": "雛", "text": "…って、叫ぶ予定！"},
        { "location": "38/TALK"   , "narrator": "繭", "text": "…本気？"},
        { "location": "40/TALK"   , "narrator": "雛", "text": "ヒカルくんが\n考えた作戦だよー。"},
        { "location": "41/TALK"   , "narrator": "キリト", "text": "マジかよ！？\nヒカルがこんな作戦\n考えるなんて…。"},
        { "location": "42/TALK"   , "narrator": "ヒカル", "text": "可愛い女の子が悪漢に\n襲われてると聞けば、\nみんな放っておかないさ。"},
        { "location": "44/TALK"   , "narrator": "雛", "text": "えへへ、可愛いだなんて、\nそんな事実を言われると\n照れちゃうよー。"},
        { "location": "46/TALK"   , "narrator": "キリト", "text": "…もう少し可愛い子に\n頼んだ方がいいんじゃね？"},
        { "location": "47/TALK"   , "narrator": "雛", "text": "失礼な！！\nあたしのどこが\n可愛くないっていうの！？"},
        { "location": "50/TALK"   , "narrator": "ヒカル", "text": "大丈夫だよ、ひなこさん。\nひなこさんだったら、\n絶対上手くいくよ。"},
        { "location": "52/TALK"   , "narrator": "雛", "text": "はぁ…ヒカルくんって、\n本当いい人だねー…。"},
        { "location": "53/TALK"   , "narrator": "雛", "text": "キリトも、ヒカルくんの\n爪垢程度でいいから\n見習った方がいいよ？"},
        { "location": "56/TALK"   , "narrator": "キリト", "text": "へいへい、そのうちな。"},
        { "location": "57/TALK"   , "narrator": "ヒカル", "text": "…それで？\n保管庫から盗ってきた\n装備の方はどう？"},
        { "location": "59/TALK"   , "narrator": "キリト", "text": "ああ、問題なしだ。\n銃の方もすぐに使えるぜ。"},
        { "location": "60/TALK"   , "narrator": "雛", "text": "…使うの？"},
        { "location": "62/TALK"   , "narrator": "キリト", "text": "使いたくはねぇけど、\n場合によっちゃな…。"},
        { "location": "64/TALK"   , "narrator": "繭", "text": "…こっちも、管理庁の\nサーバーからデータを\n抜いてきた。"},
        { "location": "65/TALK"   , "narrator": "キリト", "text": "おっ、なにかあったか？"},
        { "location": "67/TALK"   , "narrator": "繭", "text": "逢瀬さんの監禁場所と、\n移送計画書を見つけた。"},
        { "location": "68/TALK"   , "narrator": "ヒカル", "text": "移送、ですか？"},
        { "location": "70/TALK"   , "narrator": "繭", "text": "ええ…詳しくはスマホに\n送るから、\n各自で確認して。"},
        { "location": "72/TALK"   , "narrator": "雛", "text": "綾水様たちにも\n送るの忘れたら\nダメだよー。"},
        { "location": "74/TALK"   , "narrator": "繭", "text": "みやび先輩宛に、\nとっくに送ったわ。"},
        { "location": "76/TALK"   , "narrator": "キリト", "text": "よーし、みんな\n準備万端だな？"},
        { "location": "77/TALK"   , "narrator": "キリト", "text": "あとは夜になったら、\n俺とヒカルが劇場に\n侵入して…。"},
        { "location": "78/TALK"   , "narrator": "キリト", "text": "床下のＰＣの電源を\n入れれば、ミッション\nコンプリートだ！"},
        { "location": "81/TALK"   , "narrator": "ヒカル", "text": "言うは易く行うは難し、\nだけどね。"},
        { "location": "83/TALK"   , "narrator": "雛", "text": "だいじょーぶ！！\nだってあたし達は、\nトライナリー応援団だよ？"},
        { "location": "84/TALK"   , "narrator": "雛", "text": "この程度のことは\n簡単にやってのけないと、\nかっこ悪いよー。"},
        { "location": "86/TALK"   , "narrator": "キリト", "text": "そういうことだ。\nほら、ヒカルも\n気合入れて――"},
        { "location": "87/TALK"   , "narrator": "キリト", "text": "…いや、待てよ？\nもう一つやらなきゃ\nいけないことあったな。"},
        { "location": "89/TALK"   , "narrator": "繭", "text": "…なにか、やり忘れ？"},
        { "location": "90/TALK"   , "narrator": "キリト", "text": "まあな。"},
        { "location": "93/TALK"   , "narrator": "キリト", "text": "あの人がいなきゃ、\n俺は今、この場所に\nいなかったと思うし…。"},
        { "location": "112/TALK"  , "narrator": "キリト", "text": "おーい"},
        { "location": "113/TALK"  , "narrator": "キリト", "text": "名前知らないけど"},
        { "location": "114/TALK"  , "narrator": "キリト", "text": "逢瀬と話してる人"},
        { "location": "115/TALK"  , "narrator": "キリト", "text": "いるか？"},
        { "location": "116/SEL"   , "narrator": "（選択肢）", "text": "いますよ"},
        { "location": "117/SEL"   , "narrator": "（選択肢）", "text": "いませんよ"},
        { "location": "118/ACT"   , "narrator": "", "text": "いますよ"},
        { "location": "119/TALK"  , "narrator": "キリト", "text": "よかった！"},
        { "location": "120/TALK"  , "narrator": "ヒカル", "text": "こんにちは"},
        { "location": "121/TALK"  , "narrator": "雛", "text": "どもー"},
        { "location": "122/TALK"  , "narrator": "繭", "text": "おつ"},
        { "location": "123/ACT"   , "narrator": "", "text": "いませんよ"},
        { "location": "124/TALK"  , "narrator": "キリト", "text": "そうか"},
        { "location": "125/TALK"  , "narrator": "キリト", "text": "っているだろ！？"},
        { "location": "126/TALK"  , "narrator": "雛", "text": "面白い人だねー"},
        { "location": "127/TALK"  , "narrator": "ヒカル", "text": "こんにちは"},
        { "location": "128/TALK"  , "narrator": "繭", "text": "おつ"},
        { "location": "130/SEL"   , "narrator": "（選択肢）", "text": "皆さんお揃いで"},
        { "location": "131/ACT"   , "narrator": "", "text": "皆さんお揃いで"},
        { "location": "133/TALK"  , "narrator": "ヒカル", "text": "突然すみません"},
        { "location": "134/TALK"  , "narrator": "キリト", "text": "悪いな、大勢で押しかけて"},
        { "location": "135/TALK"  , "narrator": "キリト", "text": "俺があんたにお礼を言いたくてさ"},
        { "location": "136/TALK"  , "narrator": "キリト", "text": "それ言ったらこうなったわけだ"},
        { "location": "137/SEL"   , "narrator": "（選択肢）", "text": "お礼って？"},
        { "location": "138/ACT"   , "narrator": "", "text": "お礼って？"},
        { "location": "140/TALK"  , "narrator": "キリト", "text": "あんたがあのこと教えてくれなかったら"},
        { "location": "141/TALK"  , "narrator": "キリト", "text": "俺は今も"},
        { "location": "142/TALK"  , "narrator": "キリト", "text": "ひなこ達に協力しなかったはずだからな"},
        { "location": "143/TALK"  , "narrator": "繭", "text": "キリトにバラした犯人はおまえか"},
        { "location": "144/TALK"  , "narrator": "キリト", "text": "仲間外れはよくないぞ"},
        { "location": "145/TALK"  , "narrator": "繭", "text": "協力しないと言ったキリトの意志を尊重しただけ"},
        { "location": "146/TALK"  , "narrator": "雛", "text": "はいはいそこまで"},
        { "location": "147/TALK"  , "narrator": "雛", "text": "目的忘れてない？"},
        { "location": "148/TALK"  , "narrator": "キリト", "text": "そうだった"},
        { "location": "149/TALK"  , "narrator": "キリト", "text": "とにかくさ"},
        { "location": "150/TALK"  , "narrator": "キリト", "text": "俺はあんたのおかげで、自分の気持ちに正直になれたし"},
        { "location": "151/TALK"  , "narrator": "キリト", "text": "みんなと行動できることになった"},
        { "location": "152/TALK"  , "narrator": "キリト", "text": "そのこと、本当感謝してるよ"},
        { "location": "153/TALK"  , "narrator": "キリト", "text": "ありがとな"},
        { "location": "154/TALK"  , "narrator": "雛", "text": "やっぱりあたし達は"},
        { "location": "155/TALK"  , "narrator": "雛", "text": "四人一緒が一番だよね"},
        { "location": "156/TALK"  , "narrator": "ヒカル", "text": "そうだね"},
        { "location": "157/TALK"  , "narrator": "ヒカル", "text": "すごく危険なことをしようとしてるのに"},
        { "location": "158/TALK"  , "narrator": "ヒカル", "text": "みんなが一緒だと"},
        { "location": "159/TALK"  , "narrator": "ヒカル", "text": "上手くいくような気持ちになってくるし"},
        { "location": "160/TALK"  , "narrator": "雛", "text": "絶対上手くいくよ！"},
        { "location": "161/TALK"  , "narrator": "雛", "text": "私は信じてるよ"},
        { "location": "162/TALK"  , "narrator": "繭", "text": "不安だけど"},
        { "location": "163/TALK"  , "narrator": "繭", "text": "まあ"},
        { "location": "164/TALK"  , "narrator": "繭", "text": "一人よりはいいかもしれない"},
        { "location": "165/SEL"   , "narrator": "（選択肢）", "text": "応援してる"},
        { "location": "166/SEL"   , "narrator": "（選択肢）", "text": "危なくなったら逃げるんだよ？"},
        { "location": "167/SEL"   , "narrator": "（選択肢）", "text": "みんなを助けてあげて"},
        { "location": "168/ACT"   , "narrator": "", "text": "応援してる"},
        { "location": "169/TALK"  , "narrator": "キリト", "text": "ありがとな"},
        { "location": "170/TALK"  , "narrator": "ヒカル", "text": "期待に応えてみせます"},
        { "location": "171/TALK"  , "narrator": "雛", "text": "心配ないよー"},
        { "location": "172/TALK"  , "narrator": "繭", "text": "やるだけやってみるわ"},
        { "location": "173/ACT"   , "narrator": "", "text": "危なくなったら逃げるんだよ？"},
        { "location": "174/TALK"  , "narrator": "雛", "text": "逃げ足なら任せて！"},
        { "location": "175/TALK"  , "narrator": "雛", "text": "そういう時は結構早いんだよー"},
        { "location": "176/TALK"  , "narrator": "ヒカル", "text": "できれば"},
        { "location": "177/TALK"  , "narrator": "ヒカル", "text": "必要にならないことを祈ってます"},
        { "location": "178/TALK"  , "narrator": "繭", "text": "同感"},
        { "location": "179/TALK"  , "narrator": "キリト", "text": "ま、なんとかなるさ"},
        { "location": "180/ACT"   , "narrator": "", "text": "みんなを助けてあげて"},
        { "location": "181/TALK"  , "narrator": "雛", "text": "もちろんだよ！"},
        { "location": "182/TALK"  , "narrator": "雛", "text": "絶対みんな助けるからね！"},
        { "location": "183/TALK"  , "narrator": "繭", "text": "やるからには徹底的にやる"},
        { "location": "184/TALK"  , "narrator": "ヒカル", "text": "微力を尽くします"},
        { "location": "185/TALK"  , "narrator": "キリト", "text": "大船に乗った気でいろって！"},
        { "location": "187/TALK"  , "narrator": "キリト", "text": "成功したらまた連絡するぜ！"},
        { "location": "201/TALK"  , "narrator": "みやび", "text": "ふむ…あの床下のＰＣを\n起動しようとしちゅうが\nですか…。"},
        { "location": "203/TALK"  , "narrator": "真幌", "text": "うむ…まさかとは思うが、\nあいつらあれを使って――"},
        { "location": "207/TALK"  , "narrator": "みやび", "text": "あ、すみません。\nメールが来て…。"},
        { "location": "210/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "211/TALK"  , "narrator": "真幌", "text": "どうした？\n東京からか？"},
        { "location": "212/TALK"  , "narrator": "みやび", "text": "…ちくっとだけ\n待ってください。"},
        { "location": "217/TALK"  , "narrator": "みやび", "text": "相棒の仕業であろう？"},
        { "location": "218/TALK"  , "narrator": "みやび", "text": "うさぎ達が"},
        { "location": "219/TALK"  , "narrator": "みやび", "text": "こうも活発なのは"},
        { "location": "221/SEL"   , "narrator": "（選択肢）", "text": "どういうこと？"},
        { "location": "222/ACT"   , "narrator": "", "text": "どういうこと？"},
        { "location": "224/TALK"  , "narrator": "みやび", "text": "うさぎからのメール"},
        { "location": "225/TALK"  , "narrator": "みやび", "text": "つばめちゃんの監禁場所と"},
        { "location": "226/TALK"  , "narrator": "みやび", "text": "移送計画についての資料が添付されている"},
        { "location": "227/TALK"  , "narrator": "みやび", "text": "これは"},
        { "location": "228/TALK"  , "narrator": "みやび", "text": "相棒がけしかけたのか？"},
        { "location": "229/TALK"  , "narrator": "みやび", "text": "うさぎ達に"},
        { "location": "230/TALK"  , "narrator": "みやび", "text": "うちらを助けろ言うたが？"},
        { "location": "232/SEL"   , "narrator": "（選択肢）", "text": "知りませんね"},
        { "location": "233/SEL"   , "narrator": "（選択肢）", "text": "みんなが決めたこと"},
        { "location": "234/SEL"   , "narrator": "（選択肢）", "text": "今はそんなこと言ってる場合じゃない"},
        { "location": "235/ACT"   , "narrator": "", "text": "知りませんね"},
        { "location": "237/TALK"  , "narrator": "みやび", "text": "信じられん"},
        { "location": "238/TALK"  , "narrator": "みやび", "text": "とはいえ"},
        { "location": "239/TALK"  , "narrator": "みやび", "text": "全部が全部相棒のせいとは言わん"},
        { "location": "240/TALK"  , "narrator": "みやび", "text": "あの子らの意志も"},
        { "location": "241/TALK"  , "narrator": "みやび", "text": "間違いなくあったと思うのでな"},
        { "location": "242/ACT"   , "narrator": "", "text": "みんなが決めたこと"},
        { "location": "244/TALK"  , "narrator": "みやび", "text": "本当か？"},
        { "location": "247/TALK"  , "narrator": "みやび", "text": "そうか"},
        { "location": "248/TALK"  , "narrator": "みやび", "text": "あの子達が"},
        { "location": "249/TALK"  , "narrator": "みやび", "text": "自分で決めたことか"},
        { "location": "252/TALK"  , "narrator": "みやび", "text": "ならば"},
        { "location": "253/TALK"  , "narrator": "みやび", "text": "何も文句は言えんな"},
        { "location": "254/ACT"   , "narrator": "", "text": "今はそんなこと言ってる場合じゃない"},
        { "location": "256/TALK"  , "narrator": "みやび", "text": "確かにそうなのだが"},
        { "location": "259/TALK"  , "narrator": "みやび", "text": "まあいいだろう"},
        { "location": "264/TALK"  , "narrator": "みやび", "text": "うちが覚えていればだが"},
        { "location": "266/TALK"  , "narrator": "みやび", "text": "さて"},
        { "location": "267/TALK"  , "narrator": "みやび", "text": "うちはまほさんに報告せねばならん"},
        { "location": "268/TALK"  , "narrator": "みやび", "text": "多分"},
        { "location": "269/TALK"  , "narrator": "みやび", "text": "怒ると予想する"},
        { "location": "280/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "281/TALK"  , "narrator": "真幌", "text": "おい、みやび。\n誰からのメールかと\n聞いているのだが？"},
        { "location": "283/TALK"  , "narrator": "みやび", "text": "…察しのとおり、\nうさぎからです…。"},
        { "location": "284/TALK"  , "narrator": "真幌", "text": "なんと言ってきた？"},
        { "location": "286/TALK"  , "narrator": "みやび", "text": "…今夜行動開始。\nメッセージはそれだけ\nでしたけんど…。"},
        { "location": "287/TALK"  , "narrator": "みやび", "text": "一緒に、つばめちゃんの\n監禁場所と、移送計画書が\n添付されてましたよ。"},
        { "location": "288/TALK"  , "narrator": "真幌", "text": "…それは、本物か？"},
        { "location": "289/TALK"  , "narrator": "みやび", "text": "うさぎから送られてきた\nものである以上、\nうちは信じますがよ。"},
        { "location": "290/TALK"  , "narrator": "みやび", "text": "…こっちが、ミスして\n居場所バレるんを\n恐れて…。"},
        { "location": "291/TALK"  , "narrator": "みやび", "text": "ハッキングすらできない\n状況なのをわかって、\n送ってきたんでしょうね。"},
        { "location": "292/TALK"  , "narrator": "真幌", "text": "…それは、管理庁に\nハッキングして手に入れた\nデータなんだな？"},
        { "location": "293/TALK"  , "narrator": "みやび", "text": "間違いないでしょうね。\nうさぎやったらそれくらい\n朝飯前やし…。"},
        { "location": "294/TALK"  , "narrator": "真幌", "text": "なんてバカなことを！\nバレればただでは\nすまんのだぞ！？"},
        { "location": "295/TALK"  , "narrator": "みやび", "text": "まほさん…気持ちは\nわかりますけんど、\n怒らんでやってください。"},
        { "location": "296/TALK"  , "narrator": "みやび", "text": "うさぎが送ってくれた\n資料は、うちらにとって\nかなり助かる代物です。"},
        { "location": "298/TALK"  , "narrator": "みやび", "text": "それに、床下のＰＣを\n起動するゆうことは…。"},
        { "location": "299/TALK"  , "narrator": "みやび", "text": "管理庁のシステムを\n妨害するためかと。"},
        { "location": "300/TALK"  , "narrator": "みやび", "text": "危険な行為かもしれません\nけんど、確実にうちらの\n助けになっちゅうがですよ。"},
        { "location": "301/TALK"  , "narrator": "真幌", "text": "…………。"},
        { "location": "302/TALK"  , "narrator": "みやび", "text": "うちの言うてること、\n間違うてますか？"},
        { "location": "303/TALK"  , "narrator": "真幌", "text": "…間違いではない。"},
        { "location": "304/TALK"  , "narrator": "真幌", "text": "あいつらの送ってきた\n逢瀬についての資料も…。"},
        { "location": "305/TALK"  , "narrator": "真幌", "text": "床下ＰＣのことも、\n私達にとって有利になる\n行動なのは確かだ。"},
        { "location": "306/TALK"  , "narrator": "みやび", "text": "でしょう？"},
        { "location": "307/TALK"  , "narrator": "真幌", "text": "…だが、私は教師という\n立場にある身だ。"},
        { "location": "308/TALK"  , "narrator": "真幌", "text": "私達のためとはいえ、\n命に関わる危険な行為を\nすることを…。"},
        { "location": "309/TALK"  , "narrator": "真幌", "text": "認めることはできない。"},
        { "location": "310/TALK"  , "narrator": "みやび", "text": "…本心でも、\nそう思うてるがですか？"},
        { "location": "312/TALK"  , "narrator": "真幌", "text": "…私の本心は関係ない。\n立場上、叱らなければ\nならないんだ…。"},
        { "location": "313/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "314/SEL"   , "narrator": "（選択肢）", "text": "みんな優秀な生徒だと思うよ"},
        { "location": "315/SEL"   , "narrator": "（選択肢）", "text": "少しは喜んであげてほしい"},
        { "location": "316/ACT"   , "narrator": "", "text": "みんな優秀な生徒だと思うよ"},
        { "location": "333/TALK"  , "narrator": "みやび", "text": "まほさんへか？"},
        { "location": "334/TALK"  , "narrator": "みやび", "text": "伝えておこう"},
        { "location": "340/TALK"  , "narrator": "みやび", "text": "…まほさん、\nこれ見てください。"},
        { "location": "342/TALK"  , "narrator": "真幌", "text": "ん…？"},
        { "location": "343/TALK"  , "narrator": "真幌", "text": "…当たり前だ。\n私の生徒だからな、\nみんな優秀だぞ。"},
        { "location": "346/ACT"   , "narrator": "", "text": "少しは喜んであげてほしい"},
        { "location": "363/TALK"  , "narrator": "みやび", "text": "それができんから"},
        { "location": "364/TALK"  , "narrator": "みやび", "text": "辛そうなのであろう"},
        { "location": "365/TALK"  , "narrator": "みやび", "text": "これ以上辛そうな顔させられん"},
        { "location": "366/TALK"  , "narrator": "みやび", "text": "このことは"},
        { "location": "367/TALK"  , "narrator": "みやび", "text": "まほさんには伝えんぞ"},
        { "location": "380/TALK"  , "narrator": "真幌", "text": "…おい、みやび。"},
        { "location": "381/TALK"  , "narrator": "真幌", "text": "おまえ達の乗ってきた\n車に、私の分の装備一式は\n乗っていたか？"},
        { "location": "383/TALK"  , "narrator": "みやび", "text": "ああ、あれって\nまほさん用でしたか。"},
        { "location": "384/TALK"  , "narrator": "みやび", "text": "確かに、一人分の\n装備一式載ってました\nけんど…。"},
        { "location": "385/TALK"  , "narrator": "みやび", "text": "…まさか、まほさんも\n一緒に行くつもりですか？"},
        { "location": "386/TALK"  , "narrator": "真幌", "text": "当然だ。"},
        { "location": "387/TALK"  , "narrator": "真幌", "text": "いつもとは違い、\n今回は教師の言うことを\n聞きやしない…。"},
        { "location": "388/TALK"  , "narrator": "真幌", "text": "問題のある生徒も\n来るかもしれんからな。"},
        { "location": "389/TALK"  , "narrator": "みやび", "text": "なら、そっちもうちらで\nやっておきますき、\nまほさんは――"},
        { "location": "390/TALK"  , "narrator": "真幌", "text": "それはおまえ達の\n仕事じゃない。"},
        { "location": "391/TALK"  , "narrator": "真幌", "text": "危険なことをする\n生徒を守り…。"},
        { "location": "392/TALK"  , "narrator": "真幌", "text": "言うことを聞かない\n生徒を叱る。"},
        { "location": "393/TALK"  , "narrator": "真幌", "text": "それが私の仕事だ…。\n私の仕事を奪わないで\nもらいたいな。"},
        { "location": "394/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "396/TALK"  , "narrator": "みやび", "text": "問題児達の指導、\nよろしく頼みますがよ。\n東雲先生。"},
        { "location": "397/TALK"  , "narrator": "真幌", "text": "…言われるまでもないさ。"}
    ]
}
