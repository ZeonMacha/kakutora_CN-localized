    "entry":
    [
        { "location": "163/TALK"  , "narrator": "透明アーヤ", "text": "…この絵、本当に昨日の\n私そっくりよ。"},
        { "location": "165/TALK"  , "narrator": "透明神楽", "text": "ふふっ、一昨日からずっと\nお休みなしで頑張って\nましたから。"},
        { "location": "166/TALK"  , "narrator": "透明神楽", "text": "多分、ベッドに転がったら\nすぐ寝ちゃうと思いながら\n描いたんです。"},
        { "location": "167/TALK"  , "narrator": "透明アーヤ", "text": "卯月は、探偵とか\n向いてそうよね？"},
        { "location": "169/TALK"  , "narrator": "透明神楽", "text": "外見美少女、\n脳みそドローリ、\n名探偵ぴょんこ！！"},
        { "location": "171/TALK"  , "narrator": "透明アーヤ", "text": "？"},
        { "location": "172/TALK"  , "narrator": "透明神楽", "text": "いえ、\n気にしないでください。"},
        { "location": "173/TALK"  , "narrator": "透明神楽", "text": "それより、ぐっすりと\n眠れましたか？"},
        { "location": "174/TALK"  , "narrator": "透明アーヤ", "text": "ええ、おかげさまでね。"},
        { "location": "176/TALK"  , "narrator": "透明アーヤ", "text": "卯月がこの絵と一緒に、\n安らぎの魔法をくれた\nからかもしれないわね。"},
        { "location": "177/TALK"  , "narrator": "透明神楽", "text": "そう言っていただけると、\n描いてよかった、って\n気持ちになれます。"},
        { "location": "178/TALK"  , "narrator": "透明神楽", "text": "またアーヤさんの絵、\n描いていいですか？"},
        { "location": "179/TALK"  , "narrator": "透明アーヤ", "text": "ええ、もちろん。\n私も楽しみにしてるわ。"},
        { "location": "181/TALK"  , "narrator": "透明神楽", "text": "やったぁ！"},
        { "location": "182/TALK"  , "narrator": "透明アーヤ", "text": "ふふっ…。"},
        { "location": "183/SEL"   , "narrator": "（選択肢）", "text": "そんなお疲れだったの？"},
        { "location": "184/ACT"   , "narrator": "", "text": "そんなお疲れだったの？"},
        { "location": "189/TALK"  , "narrator": "透明アーヤ", "text": "誰からかしら…。"},
        { "location": "193/TALK"  , "narrator": "アーヤ", "text": "ちょっとだけね(;^_^A"},
        { "location": "195/TALK"  , "narrator": "アーヤ", "text": "昨日まで"},
        { "location": "196/TALK"  , "narrator": "アーヤ", "text": "すごく忙しかったの(-ω-;)"},
        { "location": "197/SEL"   , "narrator": "（選択肢）", "text": "出撃あったの？"},
        { "location": "198/ACT"   , "narrator": "", "text": "出撃あったの？"},
        { "location": "200/TALK"  , "narrator": "アーヤ", "text": "省庁向けレジュメ書いたり"},
        { "location": "201/TALK"  , "narrator": "アーヤ", "text": "バイトやサークルのことやったり"},
        { "location": "202/TALK"  , "narrator": "アーヤ", "text": "まあ"},
        { "location": "203/TALK"  , "narrator": "アーヤ", "text": "色々あったの(>_<)"},
        { "location": "204/SEL"   , "narrator": "（選択肢）", "text": "全部やるべきことだよ"},
        { "location": "205/SEL"   , "narrator": "（選択肢）", "text": "そんなに！？　お疲れさま"},
        { "location": "206/ACT"   , "narrator": "", "text": "全部やるべきことだよ"},
        { "location": "207/TALK"  , "narrator": "アーヤ", "text": "そうだけど"},
        { "location": "208/TALK"  , "narrator": "アーヤ", "text": "省庁向けレジュメは"},
        { "location": "209/TALK"  , "narrator": "アーヤ", "text": "館長の仕事(￣Д￣ )"},
        { "location": "211/TALK"  , "narrator": "アーヤ", "text": "人使い荒過ぎるわ(ノД`)"},
        { "location": "212/ACT"   , "narrator": "", "text": "そんなに！？　お疲れさま"},
        { "location": "213/TALK"  , "narrator": "アーヤ", "text": "ありがとう(^^"},
        { "location": "214/TALK"  , "narrator": "アーヤ", "text": "でももう大丈夫"},
        { "location": "216/TALK"  , "narrator": "アーヤ", "text": "ぐっすり寝たから(￣∇￣)"},
        { "location": "217/TALK"  , "narrator": "アーヤ", "text": "完全回復＼(^O^)／"},
        { "location": "219/TALK"  , "narrator": "アーヤ", "text": "でも"},
        { "location": "220/TALK"  , "narrator": "アーヤ", "text": "卯月のこの絵"},
        { "location": "221/TALK"  , "narrator": "アーヤ", "text": "本当すごい(>_<)"},
        { "location": "222/TALK"  , "narrator": "アーヤ", "text": "起きた時の格好と"},
        { "location": "223/TALK"  , "narrator": "アーヤ", "text": "完全一致＼(◎o◎)／"},
        { "location": "224/SEL"   , "narrator": "（選択肢）", "text": "無防備すぎる"},
        { "location": "225/SEL"   , "narrator": "（選択肢）", "text": "枕抱きしめて寝るんだね？"},
        { "location": "226/ACT"   , "narrator": "", "text": "無防備すぎる"},
        { "location": "227/TALK"  , "narrator": "アーヤ", "text": "自室なんだから"},
        { "location": "228/TALK"  , "narrator": "アーヤ", "text": "無防備なのが当然(￣Д￣ )"},
        { "location": "229/TALK"  , "narrator": "アーヤ", "text": "でもそう言われると"},
        { "location": "230/TALK"  , "narrator": "アーヤ", "text": "なんか"},
        { "location": "232/TALK"  , "narrator": "アーヤ", "text": "恥ずかしい(・・。)ゞ"},
        { "location": "233/ACT"   , "narrator": "", "text": "枕抱きしめて寝るんだね"},
        { "location": "234/TALK"  , "narrator": "アーヤ", "text": "なにかをギュッてしてると"},
        { "location": "235/TALK"  , "narrator": "アーヤ", "text": "安心するの(*^^*)"},
        { "location": "236/TALK"  , "narrator": "アーヤ", "text": "子供っぽいかしら？"},
        { "location": "237/SEL"   , "narrator": "（選択肢）", "text": "可愛くていいと思うよ"},
        { "location": "238/SEL"   , "narrator": "（選択肢）", "text": "$me$だと思って抱きしめてた？"},
        { "location": "239/ACT"   , "narrator": "", "text": "可愛くていいと思うよ"},
        { "location": "241/TALK"  , "narrator": "アーヤ", "text": "恥ずかしいから"},
        { "location": "243/TALK"  , "narrator": "アーヤ", "text": "そういうこと言わないで(-ω-;)"},
        { "location": "244/ACT"   , "narrator": "", "text": "$me$だと思って抱きしめてた？"},
        { "location": "245/TALK"  , "narrator": "アーヤ", "text": "思う暇もなかった(￣Д￣ )"},
        { "location": "246/TALK"  , "narrator": "アーヤ", "text": "本当"},
        { "location": "247/TALK"  , "narrator": "アーヤ", "text": "すぐ寝ちゃったし(｡-_-｡)"},
        { "location": "249/TALK"  , "narrator": "アーヤ", "text": "でも"},
        { "location": "250/TALK"  , "narrator": "アーヤ", "text": "今夜試してみようかしら"},
        { "location": "251/TALK"  , "narrator": "アーヤ", "text": "なんてね(*^.^*)"},
        { "location": "256/TALK"  , "narrator": "アーヤ", "text": "まあ"},
        { "location": "257/TALK"  , "narrator": "アーヤ", "text": "すごく忙しいのから"},
        { "location": "258/TALK"  , "narrator": "アーヤ", "text": "解放されたばかりだし(￣∇￣)"},
        { "location": "259/TALK"  , "narrator": "アーヤ", "text": "今日は"},
        { "location": "260/TALK"  , "narrator": "アーヤ", "text": "のんびりやるわ(=^0^=)"},
        { "location": "266/DIALOG", "narrator": "", "text": "このシナリオの元になっている\nTwitterの会話ログを見ますか？"}
    ]
