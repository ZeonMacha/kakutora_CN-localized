{
    "dir": "chap01/daydra/dd_ch01_01_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "1102",
        "cid": "tsubame",
        "title": "002 メインストーリー",
        "sub_title": "逢瀬つばめという存在＜前編＞"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "導入"},
        { "location": "26/TALK"   , "narrator": "つばめ", "text": "タオルと歯ブラシと、\nあと……"},
        { "location": "29/TALK"   , "narrator": "つばめ", "text": "東京の地図と、\nガイドと、アプリと、\n電車の乗り換え案内…"},
        { "location": "30/TALK"   , "narrator": "つばめ", "text": "服は４着、\n下着は…\n５つもあればいいか。"},
        { "location": "33/TALK"   , "narrator": "つばめ", "text": "これで準備オッケー！\n…だよね。"},
        { "location": "34/TALK"   , "narrator": "つばめ", "text": "はぁ……\nいよいよ明日かぁ。"},
        { "location": "35/TALK"   , "narrator": "つばめ", "text": "メノウちゃんの\nライブ！"},
        { "location": "37/TALK"   , "narrator": "つばめ", "text": "もうドキドキが\n止まらないよ。今日\nちゃんと寝れるかな。"},
        { "location": "44/TALK"   , "narrator": "つばめ", "text": "あ、お父さんだ！"},
        { "location": "71/TALK"   , "narrator": "つばめ", "text": "おかえりなさい！"},
        { "location": "78/TALK"   , "narrator": "啓介", "text": "ああ、ただいま。\n遅くなった。"},
        { "location": "79/TALK"   , "narrator": "啓介", "text": "ちゃんと飯は食ったか。\n何か変わったことは\n無いか？"},
        { "location": "81/TALK"   , "narrator": "つばめ", "text": "大丈夫。\nわたしは何ともないよ。"},
        { "location": "82/TALK"   , "narrator": "つばめ", "text": "それより、\nお母さんどうだった？"},
        { "location": "84/TALK"   , "narrator": "啓介", "text": "ん？\nああ……、まあ、\nいつも通りだ。"},
        { "location": "87/TALK"   , "narrator": "つばめ", "text": "もしかして、\nまた調子悪く\nなっちゃったの？"},
        { "location": "89/TALK"   , "narrator": "啓介", "text": "いや、\nそんな事はない。\n大丈夫だ。"},
        { "location": "90/TALK"   , "narrator": "つばめ", "text": "ウソだよ！　お父さん\nすぐ顔に出るもん。\n本当のこと言って。"},
        { "location": "92/TALK"   , "narrator": "啓介", "text": "……。"},
        { "location": "93/TALK"   , "narrator": "啓介", "text": "…だいぶ\n痛むようでな。"},
        { "location": "94/TALK"   , "narrator": "つばめ", "text": "え……"},
        { "location": "96/TALK"   , "narrator": "啓介", "text": "いつもの発作だ。\n俺が付き添うから、\n何の心配もない。"},
        { "location": "97/TALK"   , "narrator": "つばめ", "text": "でも！"},
        { "location": "98/TALK"   , "narrator": "啓介", "text": "お前、明日から\n東京だろう。\n今日は早く寝なさい。"},
        { "location": "102/TALK"  , "narrator": "つばめ", "text": "ああっ！\nちょっと、お父さん！"},
        { "location": "122/TALK"  , "narrator": "つばめ", "text": "お父さん。わたし、\n明日の東京行き\nやめるよ。"},
        { "location": "124/TALK"  , "narrator": "啓介", "text": "何を言ってる。\nずっと楽しみに\nしてたんだろ。"},
        { "location": "125/TALK"  , "narrator": "つばめ", "text": "お母さんが調子悪い\nのに、東京になんて\n行けないよ。"},
        { "location": "127/TALK"  , "narrator": "啓介", "text": "だから心配するなと…"},
        { "location": "129/TALK"  , "narrator": "つばめ", "text": "そんなの無理だよ。"},
        { "location": "132/TALK"  , "narrator": "啓介", "text": "お前だって\nずっと頑張ってきた。"},
        { "location": "134/TALK"  , "narrator": "つばめ", "text": "え？"},
        { "location": "135/TALK"  , "narrator": "啓介", "text": "２年間ずっと、\n行きたくても頑張って\n我慢してきただろ。"},
        { "location": "136/TALK"  , "narrator": "つばめ", "text": "……お父さん。"},
        { "location": "139/TALK"  , "narrator": "啓介", "text": "だから、行ってこい。\n明日は駅まで送ってやる。"},
        { "location": "141/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "159/TALK"  , "narrator": "つばめ", "text": "はぁ……\nそんなこと言われてもなぁ。"},
        { "location": "160/TALK"  , "narrator": "つばめ", "text": "お母さん調子悪いのに\nわたし一人だけ\n楽しめないよ……"},
        { "location": "162/TALK"  , "narrator": "つばめ", "text": "はぁ……"},
        { "location": "163/TALK"  , "narrator": "つばめ", "text": "やっぱり行くの\nやめようかなぁ……"},
        { "location": "208/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "217/TALK"  , "narrator": "千羽鶴", "text": "[ココロスフィア]の説明は\n前に私がしてると思うけど\nもう一度聞く？"},
        { "location": "218/SEL"   , "narrator": "", "text": "はい"},
        { "location": "219/SEL"   , "narrator": "", "text": "いいえ"},
        { "location": "220/ACT"   , "narrator": "", "text": "はい"},
        { "location": "221/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "223/ACT"   , "narrator": "", "text": "いいえ"},
        { "location": "231/TALK"  , "narrator": "千羽鶴", "text": "ようこそ。"},
        { "location": "232/SEL"   , "narrator": "", "text": "ここは…精神世界？"},
        { "location": "233/ACT"   , "narrator": "", "text": "ここは…精神世界？"},
        { "location": "235/TALK"  , "narrator": "千羽鶴", "text": "そう。\nバトル説明で入ったのと\n同じ、精神世界。"},
        { "location": "236/TALK"  , "narrator": "千羽鶴", "text": "ここは、後ろにいる\n彼女、逢瀬つばめの\n精神世界の入口――"},
        { "location": "237/TALK"  , "narrator": "千羽鶴", "text": "通称<color=red>【[ココロゲート]】</color>\nと呼ばれている場所。"},
        { "location": "238/TALK"  , "narrator": "千羽鶴", "text": "ここでは彼女は\nあなたと普通に\n対話できる。"},
        { "location": "239/TALK"  , "narrator": "千羽鶴", "text": "彼女の心に直接\n語りかけることで、\n心を動かすの。"},
        { "location": "240/TALK"  , "narrator": "千羽鶴", "text": "早速、\n彼女に話しかけてみて。"},
        { "location": "249/SEL"   , "narrator": "", "text": "やあ"},
        { "location": "250/ACT"   , "narrator": "", "text": "やあ"},
        { "location": "253/TALK"  , "narrator": "つばめ", "text": "え？"},
        { "location": "254/TALK"  , "narrator": "つばめ", "text": "あなた、誰ですか？"},
        { "location": "255/SEL"   , "narrator": "", "text": "君の将来のフィアンセだよ"},
        { "location": "256/SEL"   , "narrator": "", "text": "はじめまして、$handle$です"},
        { "location": "257/SEL"   , "narrator": "", "text": "逢瀬つばめちゃん？"},
        { "location": "258/ACT"   , "narrator": "", "text": "君の将来のフィアンセだよ"},
        { "location": "260/TALK"  , "narrator": "つばめ", "text": "えっ！？　わたしの\nフィアンセ！？"},
        { "location": "261/TALK"  , "narrator": "つばめ", "text": "あの……"},
        { "location": "262/TALK"  , "narrator": "つばめ", "text": "それって、お菓子か\n何かでしたっけ？"},
        { "location": "263/SEL"   , "narrator": "", "text": "それはフィナンシェや！"},
        { "location": "264/ACT"   , "narrator": "", "text": "それはフィナンシェや！"},
        { "location": "266/TALK"  , "narrator": "つばめ", "text": "あ、そうでした！\nそれです！\nスッキリしました。"},
        { "location": "276/TALK"  , "narrator": "つばめ", "text": "それでは\nフィナンシェさん。"},
        { "location": "277/SEL"   , "narrator": "", "text": "あ、はい…"},
        { "location": "278/ACT"   , "narrator": "", "text": "あ、はい…"},
        { "location": "280/ACT"   , "narrator": "", "text": "はじめまして、$handle$です"},
        { "location": "281/TALK"  , "narrator": "つばめ", "text": "$handle$…さん？"},
        { "location": "282/ACT"   , "narrator": "", "text": "逢瀬つばめちゃん？"},
        { "location": "283/TALK"  , "narrator": "つばめ", "text": "そうですね。\n厳密には……わたしは\nその一人格です。"},
        { "location": "285/TALK"  , "narrator": "つばめ", "text": "わたしは逢瀬つばめの\nココロを管理する人格。"},
        { "location": "286/TALK"  , "narrator": "つばめ", "text": "ここ<color=red>【[ココロゲート]】</color>\nで、私の持つ想いや\n感情を管理してます。"},
        { "location": "287/TALK"  , "narrator": "つばめ", "text": "いわば、[ココロの司書]\nとでも言いましょうか。"},
        { "location": "289/SEL"   , "narrator": "", "text": "なるほど！"},
        { "location": "290/SEL"   , "narrator": "", "text": "もう知ってる"},
        { "location": "291/ACT"   , "narrator": "", "text": "なるほど！"},
        { "location": "293/ACT"   , "narrator": "", "text": "もう知ってる"},
        { "location": "297/SEL"   , "narrator": "", "text": "なるほど！"},
        { "location": "298/ACT"   , "narrator": "", "text": "なるほど！"},
        { "location": "303/TALK"  , "narrator": "つばめ", "text": "あらら、\n既に経験済みでした。"},
        { "location": "304/TALK"  , "narrator": "つばめ", "text": "説明は\n飛ばしていきますね！"},
        { "location": "307/TALK"  , "narrator": "つばめ", "text": "つばめの喜怒哀楽、\n悩み、記憶等は全て\nここに繋がってます。"},
        { "location": "308/TALK"  , "narrator": "つばめ", "text": "それらは１つずつ\n番号付きの部屋に\n収められています。"},
        { "location": "309/TALK"  , "narrator": "つばめ", "text": "通常、わたしが平常心で\nいる時は、それらの扉は\n必要に応じて開くんです。"},
        { "location": "310/TALK"  , "narrator": "つばめ", "text": "ですが、今のように\n迷っている状態では、\n適切な扉が開きません。"},
        { "location": "311/TALK"  , "narrator": "つばめ", "text": "場合によっては、\n間違った扉が\n開いてしまう。"},
        { "location": "312/SEL"   , "narrator": "", "text": "それは、選択をミスってしまうってこと？"},
        { "location": "313/ACT"   , "narrator": "", "text": "それは、選択をミスってしまうってこと？"},
        { "location": "315/TALK"  , "narrator": "つばめ", "text": "まさにその通りです！"},
        { "location": "316/TALK"  , "narrator": "つばめ", "text": "わたしは司書ですから、\nどの扉がわたしにとって\n正しいか分かっています。"},
        { "location": "317/TALK"  , "narrator": "つばめ", "text": "ですが、扉を開く力は\nわたしにはありません。"},
        { "location": "318/TALK"  , "narrator": "つばめ", "text": "だから、\n$handle$さんに\n手伝って欲しいのです。"},
        { "location": "319/SEL"   , "narrator": "", "text": "どうやって？"},
        { "location": "320/ACT"   , "narrator": "", "text": "どうやって？"},
        { "location": "322/TALK"  , "narrator": "つばめ", "text": "正しい扉の選択を阻止する\n<color=red>【[クラン]】</color>という存在を\n倒すのを手伝ってください。"},
        { "location": "323/TALK"  , "narrator": "つばめ", "text": "<color=red>【[クラン]】</color>とは、わたしの\n不安や恐れが、あまりに\n大きくなってしまった物。"},
        { "location": "324/TALK"  , "narrator": "つばめ", "text": "その<color=red>【[クラン]】</color>が\n正しい扉に入るのを\n妨害してしまうのです。"},
        { "location": "325/TALK"  , "narrator": "つばめ", "text": "扉の前には、<color=red>【[クラン]】</color>を\n倒せず困ってるわたしが\nいます。"},
        { "location": "326/TALK"  , "narrator": "つばめ", "text": "どうか、彼女に力を\n貸してあげてください！"},
        { "location": "328/TALK"  , "narrator": "つばめ", "text": "やっていただけますか？"},
        { "location": "329/SEL"   , "narrator": "", "text": "オッケー"},
        { "location": "330/SEL"   , "narrator": "", "text": "やだ"},
        { "location": "331/ACT"   , "narrator": "", "text": "オッケー"},
        { "location": "332/TALK"  , "narrator": "つばめ", "text": "ありがとうございます！"},
        { "location": "333/ACT"   , "narrator": "", "text": "やだ"},
        { "location": "334/TALK"  , "narrator": "つばめ", "text": "ふえぇぇ…\nそれは困ります…っ。"},
        { "location": "339/TALK"  , "narrator": "つばめ", "text": "それじゃ早速、\n今回の<color=red>【適切な扉】</color>を\nコールします。"},
        { "location": "347/TALK"  , "narrator": "つばめ", "text": "オープンプロセス、\n0x023番地から\n0x571番地へ。"},
        { "location": "362/TALK"  , "narrator": "つばめ", "text": "シーク完了しました。"},
        { "location": "363/TALK"  , "narrator": "つばめ", "text": "この扉に、今回の悩みの\n根源になっている\n<color=red>【[クラン]】</color>がいます。"},
        { "location": "365/TALK"  , "narrator": "つばめ", "text": "今回の悩みは、母を置いて\n東京へ行くことの罪悪感。"},
        { "location": "366/TALK"  , "narrator": "つばめ", "text": "ですが、その件はココロ\nファイルNo.01-332-55\nにて既に解決済みです。"},
        { "location": "370/TALK"  , "narrator": "つばめ", "text": "ココロファイル\nNo.01-332-55には\nこう記されています。"},
        { "location": "371/TALK"  , "narrator": "つばめ", "text": "『わたしが東京へ\nライブを見に行くことは、\n母と共に決めたこと』"},
        { "location": "372/TALK"  , "narrator": "つばめ", "text": "『長い間入院していた\nわたしに、母が快気祝いと\nしてくれた旅行です』"},
        { "location": "373/TALK"  , "narrator": "つばめ", "text": "『それをわたしの判断で\nとりやめたら、むしろ母は\nとても悲しみます』"},
        { "location": "374/TALK"  , "narrator": "つばめ", "text": "『自分のせいで、と\n自責の念も生まれる\nでしょう』"},
        { "location": "375/TALK"  , "narrator": "つばめ", "text": "『よって、最大幸福論から\n見れば、東京行きは決行\nするべきなのです』"},
        { "location": "376/TALK"  , "narrator": "つばめ", "text": "以上。"},
        { "location": "377/TALK"  , "narrator": "つばめ", "text": "わたしのココロに賛同し、\nその支援を\nしてくれますか？"},
        { "location": "378/SEL"   , "narrator": "", "text": "もちろん"},
        { "location": "379/SEL"   , "narrator": "", "text": "本当にそれが正しいの？"},
        { "location": "380/ACT"   , "narrator": "", "text": "もちろん"},
        { "location": "382/TALK"  , "narrator": "つばめ", "text": "ありがとうございます！"},
        { "location": "383/TALK"  , "narrator": "つばめ", "text": "それじゃ、\n扉にアクセスしますよ？\n準備はいいですか？"},
        { "location": "384/TALK"  , "narrator": "つばめ", "text": "$handle$さんと\nわたしに、\n素敵なココロの旅を！"},
        { "location": "391/ACT"   , "narrator": "", "text": "本当にそれが正しいの？"},
        { "location": "392/TALK"  , "narrator": "つばめ", "text": "$handle$さんや\n他の人にとっては\nどうかわかりません。"},
        { "location": "393/TALK"  , "narrator": "つばめ", "text": "ですが、少なくとも\nわたしの本音としては\nこれが一番なんです。"},
        { "location": "394/TALK"  , "narrator": "つばめ", "text": "ですから、もしわたしの\n結論に賛成できない場合、\n協力しないのもアリです。"},
        { "location": "395/TALK"  , "narrator": "つばめ", "text": "どうしますか？"},
        { "location": "396/SEL"   , "narrator": "", "text": "協力する"},
        { "location": "397/SEL"   , "narrator": "", "text": "協力しない"},
        { "location": "398/ACT"   , "narrator": "", "text": "協力する"},
        { "location": "400/ACT"   , "narrator": "", "text": "協力しない"},
        { "location": "401/TALK"  , "narrator": "つばめ", "text": "わかりました。\n残念ですけど、\n仕方ないですよね。"},
        { "location": "402/TALK"  , "narrator": "つばめ", "text": "一応、扉には\nアクセスできるように\nしておきます。"},
        { "location": "404/TALK"  , "narrator": "つばめ", "text": "気が向いたらいつでも\n手伝いに来てくださいね。"},
        { "location": "24/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>5月2日　8:49 PM</color>\n静岡・逢瀬邸\nリビングにて。"},
        { "location": "175/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "272/DIALOG", "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>500pt.</b></color></size>\nアップしました！"}
    ]
}
