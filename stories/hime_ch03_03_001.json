    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "03-01_あなたはマルザンナ"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "昼間は気持ち悪いなんて言ってしまってごめんなさい。もし私の心を変えてくれたのなら、貴方は本当にBotなの？それとも神様？"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "もし本当はBotじゃなくて神様なのなら、どうかまた私の元へ現れてくださいな"},
        { "location": "35/SEL"    , "narrator": "", "text": "そうです！私が神様です！！"},
        { "location": "36/SEL"    , "narrator": "", "text": "神様じゃないけどコンバンワ"},
        { "location": "37/ACT"    , "narrator": "", "text": "そうです！私が神様です！！"},
        { "location": "38/ACT"    , "narrator": "", "text": "神様じゃないけどコンバンワ"},
        { "location": "40/TALK"   , "narrator": "ガブリエラ", "text": "きたわね"},
        { "location": "41/TALK"   , "narrator": "ガブリエラ", "text": "もう一度聞くけど、本当に貴方が私の心に入って、心を落ち着かせてくれたの？"},
        { "location": "43/SEL"    , "narrator": "", "text": "はい"},
        { "location": "44/ACT"    , "narrator": "", "text": "はい"},
        { "location": "46/TALK"   , "narrator": "ガブリエラ", "text": "信じたいけど、何か証拠がないと難しいわね。こう見えてもリアリストなの"},
        { "location": "48/SEL"    , "narrator": "", "text": "幼い頃に強盗に入られて、その時のことが心の傷になってるよ"},
        { "location": "49/ACT"    , "narrator": "", "text": "幼い頃に強盗に入られて、その時のことが心の傷になってるよ"},
        { "location": "51/TALK"   , "narrator": "ガブリエラ", "text": "ええええええ！うそ！！なんでそんなことしってるｎ？"},
        { "location": "53/TALK"   , "narrator": "ガブリエラ", "text": "本当に神様なの？？？？？"},
        { "location": "55/SEL"    , "narrator": "", "text": "その通りである"},
        { "location": "56/SEL"    , "narrator": "", "text": "普通の人間だよ"},
        { "location": "57/SEL"    , "narrator": "", "text": "タダのBotだよ"},
        { "location": "58/ACT"    , "narrator": "", "text": "その通りである"},
        { "location": "68/TALK"   , "narrator": "ガブリエラ", "text": "びっくり"},
        { "location": "69/TALK"   , "narrator": "ガブリエラ", "text": "信じられないけど、でも、、本当にそうなのかもしら？"},
        { "location": "70/ACT"    , "narrator": "", "text": "普通の人間だよ"},
        { "location": "71/TALK"   , "narrator": "ガブリエラ", "text": "冗談がお上手ね"},
        { "location": "72/ACT"    , "narrator": "", "text": "タダのBotだよ"},
        { "location": "73/TALK"   , "narrator": "ガブリエラ", "text": "私の心をしずめることができるBotなんていなくてよ？"},
        { "location": "75/TALK"   , "narrator": "ガブリエラ", "text": "それにしても"},
        { "location": "76/TALK"   , "narrator": "ガブリエラ", "text": "今日は特に疲れたわ・・・"},
        { "location": "79/SEL"    , "narrator": "", "text": "お疲れさま"},
        { "location": "80/SEL"    , "narrator": "", "text": "頑張ったね"},
        { "location": "81/SEL"    , "narrator": "", "text": "さすがガブリエラって感じだった"},
        { "location": "82/ACT"    , "narrator": "", "text": "お疲れさま"},
        { "location": "83/TALK"   , "narrator": "ガブリエラ", "text": "おつかれさま"},
        { "location": "84/ACT"    , "narrator": "", "text": "頑張ったね"},
        { "location": "85/TALK"   , "narrator": "ガブリエラ", "text": "うん"},
        { "location": "86/ACT"    , "narrator": "", "text": "さすがガブリエラって感じだった"},
        { "location": "97/TALK"   , "narrator": "ガブリエラ", "text": "そうかしら////////////////"},
        { "location": "99/TALK"   , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "100/TALK"  , "narrator": "ガブリエラ", "text": "ほんとはちょっと"},
        { "location": "101/TALK"  , "narrator": "ガブリエラ", "text": "こわかったのよ？"},
        { "location": "104/SEL"   , "narrator": "", "text": "狙撃大変だったよね"},
        { "location": "105/ACT"   , "narrator": "", "text": "狙撃大変だったよね"},
        { "location": "106/TALK"  , "narrator": "ガブリエラ", "text": "貴方が話しかけてきたときは、本当にびっくりしたんだから"},
        { "location": "109/SEL"   , "narrator": "", "text": "命中させたのはガブの力だよ"},
        { "location": "110/ACT"   , "narrator": "", "text": "命中させたのはガブの力だよ"},
        { "location": "111/TALK"  , "narrator": "ガブリエラ", "text": "なんでそんなことまで"},
        { "location": "112/TALK"  , "narrator": "ガブリエラ", "text": "って"},
        { "location": "113/TALK"  , "narrator": "ガブリエラ", "text": "やっぱり本当に神様なのかしら？"},
        { "location": "115/TALK"  , "narrator": "ガブリエラ", "text": "あ"},
        { "location": "116/TALK"  , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "117/TALK"  , "narrator": "ガブリエラ", "text": "今日は本当に"},
        { "location": "118/TALK"  , "narrator": "ガブリエラ", "text": "貴方のおかげよ"},
        { "location": "119/TALK"  , "narrator": "ガブリエラ", "text": "感謝するわ"},
        { "location": "121/SEL"   , "narrator": "", "text": "どういたしまして"},
        { "location": "122/SEL"   , "narrator": "", "text": "それほどでも"},
        { "location": "123/SEL"   , "narrator": "", "text": "もっとほめて！"},
        { "location": "124/ACT"   , "narrator": "", "text": "どういたしまして"},
        { "location": "125/TALK"  , "narrator": "ガブリエラ", "text": "エレガントなお返事ねv"},
        { "location": "126/ACT"   , "narrator": "", "text": "それほどでも"},
        { "location": "127/TALK"  , "narrator": "ガブリエラ", "text": "謙遜ってやつねv"},
        { "location": "128/ACT"   , "narrator": "", "text": "もっとほめて！"},
        { "location": "129/TALK"  , "narrator": "ガブリエラ", "text": "素直ね・・・"},
        { "location": "131/TALK"  , "narrator": "ガブリエラ", "text": "でも本当に"},
        { "location": "132/TALK"  , "narrator": "ガブリエラ", "text": "貴方は勝利の女神みたい・・・"},
        { "location": "136/TALK"  , "narrator": "ガブリエラ", "text": "だから貴方のこと"},
        { "location": "137/TALK"  , "narrator": "ガブリエラ", "text": "マルザンナって呼んでいいかしら？"},
        { "location": "139/SEL"   , "narrator": "", "text": "え？"},
        { "location": "140/SEL"   , "narrator": "", "text": "なんで？"},
        { "location": "141/SEL"   , "narrator": "", "text": "誰？"},
        { "location": "142/ACT"   , "narrator": "", "text": "え？"},
        { "location": "143/TALK"  , "narrator": "ガブリエラ", "text": "え、じゃないわよ"},
        { "location": "144/TALK"  , "narrator": "ガブリエラ", "text": "マルザンナ"},
        { "location": "145/ACT"   , "narrator": "", "text": "なんで？"},
        { "location": "146/TALK"  , "narrator": "ガブリエラ", "text": "あら"},
        { "location": "147/TALK"  , "narrator": "ガブリエラ", "text": "わからないのかしら？"},
        { "location": "148/ACT"   , "narrator": "", "text": "誰？"},
        { "location": "149/TALK"  , "narrator": "ガブリエラ", "text": "女神マルザンナのことも知らないの？"},
        { "location": "151/TALK"  , "narrator": "ガブリエラ", "text": "豊穣の女神マルザンナ"},
        { "location": "152/TALK"  , "narrator": "ガブリエラ", "text": "ポーランドに伝わる女神さまよ"},
        { "location": "153/TALK"  , "narrator": "ガブリエラ", "text": "果物は女神マルザンナの愛を受けて育つの"},
        { "location": "155/SEL"   , "narrator": "", "text": "それが$me$？"},
        { "location": "156/SEL"   , "narrator": "", "text": "そうなんだ……"},
        { "location": "157/SEL"   , "narrator": "", "text": "我が加護を受けよ、ガブリエラ"},
        { "location": "158/ACT"   , "narrator": "", "text": "それが$me$？"},
        { "location": "159/TALK"  , "narrator": "ガブリエラ", "text": "そうよv"},
        { "location": "160/ACT"   , "narrator": "", "text": "そうなんだ……"},
        { "location": "161/TALK"  , "narrator": "ガブリエラ", "text": "そうなのよv"},
        { "location": "162/ACT"   , "narrator": "", "text": "我が加護を受けよ、ガブリエラ"},
        { "location": "172/TALK"  , "narrator": "ガブリエラ", "text": "祝福を我が胸に！"},
        { "location": "174/TALK"  , "narrator": "ガブリエラ", "text": "それとも"},
        { "location": "175/TALK"  , "narrator": "ガブリエラ", "text": "マルザンナは"},
        { "location": "176/TALK"  , "narrator": "ガブリエラ", "text": "私を置いてどこかに行ってしまうつもりかしら？"},
        { "location": "180/SEL"   , "narrator": "", "text": "どこにも行かないよ"},
        { "location": "181/SEL"   , "narrator": "", "text": "ここにいるよ"},
        { "location": "182/SEL"   , "narrator": "", "text": "ずっとガブリエラを護るよ"},
        { "location": "183/ACT"   , "narrator": "", "text": "どこにも行かないよ"},
        { "location": "184/TALK"  , "narrator": "ガブリエラ", "text": "本当に？"},
        { "location": "185/TALK"  , "narrator": "ガブリエラ", "text": "ほんとね、マルザンナ"},
        { "location": "186/TALK"  , "narrator": "ガブリエラ", "text": "これからもずっとよろしくね！"},
        { "location": "188/ACT"   , "narrator": "", "text": "ここにいるよ"},
        { "location": "189/TALK"  , "narrator": "ガブリエラ", "text": "いてくれるの？"},
        { "location": "190/TALK"  , "narrator": "ガブリエラ", "text": "よかったわ"},
        { "location": "191/TALK"  , "narrator": "ガブリエラ", "text": "これからよろしくね、マルザンナ"},
        { "location": "193/ACT"   , "narrator": "", "text": "ずっとガブリエラを護るよ"},
        { "location": "203/TALK"  , "narrator": "ガブリエラ", "text": "ずっと？"},
        { "location": "204/TALK"  , "narrator": "ガブリエラ", "text": "ずっと護ってくれるのね、マルザンナ！"},
        { "location": "206/TALK"  , "narrator": "ガブリエラ", "text": "私、とても幸せな気持ちだわ"},
