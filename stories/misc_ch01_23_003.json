        { "location": "197/SCENARIO", "narrator": "", "text": "無機質な温もり"},
        { "location": "222/TALK"    , "narrator": "つばめ", "text": "木の床だと"},
        { "location": "223/TALK"    , "narrator": "つばめ", "text": "床暖房できるでしょ？"},
        { "location": "225/SEL"     , "narrator": "", "text": "この暑いのに床暖房？"},
        { "location": "226/SEL"     , "narrator": "", "text": "畳でもできるよ"},
        { "location": "227/SEL"     , "narrator": "", "text": "リフォームするの？"},
        { "location": "228/ACT"     , "narrator": "", "text": "この暑いのに床暖房？"},
        { "location": "229/TALK"    , "narrator": "つばめ", "text": "ぁ"},
        { "location": "230/TALK"    , "narrator": "つばめ", "text": "自分の部屋の話じゃなぃょ"},
        { "location": "231/ACT"     , "narrator": "", "text": "畳でもできるよ"},
        { "location": "232/TALK"    , "narrator": "つばめ", "text": "ぇ"},
        { "location": "233/TALK"    , "narrator": "つばめ", "text": "そぅなの"},
        { "location": "234/TALK"    , "narrator": "つばめ", "text": "知らなかった"},
        { "location": "235/ACT"     , "narrator": "", "text": "リフォームするの？"},
        { "location": "237/TALK"    , "narrator": "つばめ", "text": "リフォームってぃぅか"},
        { "location": "238/TALK"    , "narrator": "つばめ", "text": "ぁ"},
        { "location": "239/TALK"    , "narrator": "つばめ", "text": "自分の部屋の話じゃなぃょ"},
        { "location": "241/TALK"    , "narrator": "つばめ", "text": "アーヤさんがね"},
        { "location": "243/TALK"    , "narrator": "つばめ", "text": "子供には床暖房がある方がいいんだよって"},
        { "location": "244/TALK"    , "narrator": "つばめ", "text": "言ってたから"},
        { "location": "246/SEL"     , "narrator": "", "text": "つばめって子供いるの？"},
        { "location": "247/SEL"     , "narrator": "", "text": "ふうん"},
        { "location": "248/SEL"     , "narrator": "", "text": "$me$がいつでも温めてあげるのに"},
        { "location": "249/ACT"     , "narrator": "", "text": "つばめって子供いるの？"},
        { "location": "250/TALK"    , "narrator": "つばめ", "text": "ぇ"},
        { "location": "251/TALK"    , "narrator": "つばめ", "text": "ぃなぃょ！？"},
        { "location": "252/ACT"     , "narrator": "", "text": "ふうん"},
        { "location": "253/TALK"    , "narrator": "つばめ", "text": "ぁんまり"},
        { "location": "254/TALK"    , "narrator": "つばめ", "text": "興味なぃょね"},
        { "location": "255/ACT"     , "narrator": "", "text": "$me$がいつでも温めてあげるのに"},
        { "location": "257/TALK"    , "narrator": "つばめ", "text": "ぇ"},
        { "location": "258/TALK"    , "narrator": "つばめ", "text": "それってちょっと"},
        { "location": "259/TALK"    , "narrator": "つばめ", "text": "えっちな話？"},
        { "location": "261/TALK"    , "narrator": "つばめ", "text": "なんかね"},
        { "location": "262/TALK"    , "narrator": "つばめ", "text": "ぁたしは今までそんなこと"},
        { "location": "263/TALK"    , "narrator": "つばめ", "text": "考えたこともなかったけど"},
        { "location": "264/TALK"    , "narrator": "つばめ", "text": "アーヤさんは色々考えてるんだなって思ったの"},
        { "location": "266/TALK"    , "narrator": "つばめ", "text": "そぅぃぅ話だょ"}
