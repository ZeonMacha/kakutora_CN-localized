        "title": "スペシャルエピソード",
        "sub_title": "包んだのは愛情？"
    },
    "entry":
    [
        { "location": "18/TALK" , "narrator": "透明つばめ", "text": "お待たせー。\n出来立てアツアツだよー。"},
        { "location": "19/SEL"  , "narrator": "（選択肢）", "text": "待ってました！"},
        { "location": "20/ACT"  , "narrator": "", "text": "待ってました！"},
        { "location": "22/TALK" , "narrator": "透明つばめ", "text": "ごめんね。\nお料理得意じゃないから、\n時間かかっちゃって…。"},
        { "location": "23/TALK" , "narrator": "透明つばめ", "text": "でも、レシピ通りに\n作れたはずだから、\nきっと美味しいよ。"},
        { "location": "24/SEL"  , "narrator": "（選択肢）", "text": "なら安心だ"},
        { "location": "25/SEL"  , "narrator": "（選択肢）", "text": "作ってもらえて嬉しいよ"},
        { "location": "26/ACT"  , "narrator": "", "text": "なら安心だ"},
        { "location": "27/TALK" , "narrator": "透明つばめ", "text": "誰でも簡単に作れて、\n失敗しないって\n書いてあったの。"},
        { "location": "28/TALK" , "narrator": "透明つばめ", "text": "料理下手なわたしには\nありがたいレシピだよ。"},
        { "location": "29/ACT"  , "narrator": "", "text": "作ってもらえて嬉しいよ"},
        { "location": "30/TALK" , "narrator": "透明つばめ", "text": "ありがとう。"},
        { "location": "31/TALK" , "narrator": "透明つばめ", "text": "そう言ってもらえるなら、\n作ってよかったぁ。"},
        { "location": "33/TALK" , "narrator": "透明つばめ", "text": "じゃあ、温かいうちに\n食べて――"},
        { "location": "35/TALK" , "narrator": "透明つばめ", "text": "…………。"},
        { "location": "36/SEL"  , "narrator": "（選択肢）", "text": "どうしたの？"},
        { "location": "37/ACT"  , "narrator": "", "text": "どうしたの？"},
        { "location": "40/TALK" , "narrator": "透明つばめ", "text": "あ、うん…。\nちょっと、思ったの。"},
        { "location": "42/TALK" , "narrator": "透明つばめ", "text": "デート…なんだから、\nただ食べてもらうだけは、\nつまらないかな、って…。"},
        { "location": "43/SEL"  , "narrator": "（選択肢）", "text": "そ、それはまさか…"},
        { "location": "44/ACT"  , "narrator": "", "text": "そ、それはまさか…"},
        { "location": "47/TALK" , "narrator": "透明つばめ", "text": "えへへ…わたしが\n食べさせてあげるね。"},
        { "location": "48/TALK" , "narrator": "透明つばめ", "text": "それじゃ…あーんして。"},
        { "location": "49/SEL"  , "narrator": "（選択肢）", "text": "あ、あーん！"},
        { "location": "50/SEL"  , "narrator": "（選択肢）", "text": "い、いや～ん！"},
        { "location": "51/ACT"  , "narrator": "", "text": "あ、あーん！"},
        { "location": "53/TALK" , "narrator": "透明つばめ", "text": "あっ、$handle$さん、\nもしかして照れてる？"},
        { "location": "54/TALK" , "narrator": "透明つばめ", "text": "ちょっと可愛いとこ\n見ちゃった…えへへ…。"},
        { "location": "55/SEL"  , "narrator": "（選択肢）", "text": "は、早く食べさせて！"},
        { "location": "56/ACT"  , "narrator": "", "text": "は、早く食べさせて！"},
        { "location": "58/TALK" , "narrator": "透明つばめ", "text": "ふふっ、ごめんね。\nそれじゃもう一度、\nあーん…。"},
        { "location": "60/ACT"  , "narrator": "", "text": "い、いや～ん！"},
        { "location": "62/TALK" , "narrator": "透明つばめ", "text": "わっ、ビックリしたぁ…。"},
        { "location": "64/TALK" , "narrator": "透明つばめ", "text": "もう、急にそういうこと\nしたらダメだよ。"},
        { "location": "65/SEL"  , "narrator": "（選択肢）", "text": "ごめん、照れちゃって"},
        { "location": "66/ACT"  , "narrator": "", "text": "ごめん、照れちゃって"},
        { "location": "68/TALK" , "narrator": "透明つばめ", "text": "えっ？　$handle$さんも\n照れたりするの？"},
        { "location": "70/TALK" , "narrator": "透明つばめ", "text": "ふふっ、そっかぁ…。\nちょっと珍しい姿\n見れたかも。"},
        { "location": "71/TALK" , "narrator": "透明つばめ", "text": "でも、わたしも\n恥ずかしいんだから、\nもうやっちゃダメだよ？"},
        { "location": "72/TALK" , "narrator": "透明つばめ", "text": "それじゃ、もう一度…、\nあーん…。"},
        { "location": "80/TALK" , "narrator": "透明つばめ", "text": "っと、あれ？"},
        { "location": "81/TALK" , "narrator": "透明つばめ", "text": "ごめんごめん。\nちょっと、口の場所\nズレちゃったね…。"},
        { "location": "82/TALK" , "narrator": "透明つばめ", "text": "次は間違えないように、\nよーく狙ってー…。"},
        { "location": "83/SEL"  , "narrator": "（選択肢）", "text": "も、もう少し優しく！"},
        { "location": "84/ACT"  , "narrator": "", "text": "も、もう少し優しく！"},
        { "location": "86/TALK" , "narrator": "透明つばめ", "text": "あああ、そ、そうだよね！"},
        { "location": "87/TALK" , "narrator": "透明つばめ", "text": "ごめんなさい…。\nわたしも、ちょっと\n緊張してるかも…。"},
        { "location": "90/TALK" , "narrator": "透明つばめ", "text": "…あれ？"},
        { "location": "92/TALK" , "narrator": "透明つばめ", "text": "あぁっ！！\nごめんなさい、\n落としちゃった！"},
        { "location": "93/TALK" , "narrator": "透明つばめ", "text": "大丈夫？\n火傷とかしてない？"},
        { "location": "94/SEL"  , "narrator": "（選択肢）", "text": "平気だよ"},
        { "location": "95/SEL"  , "narrator": "（選択肢）", "text": "つばめは平気！？"},
        { "location": "96/ACT"  , "narrator": "", "text": "平気だよ"},
        { "location": "98/TALK" , "narrator": "透明つばめ", "text": "よかったぁ…。"},
        { "location": "99/TALK" , "narrator": "透明つばめ", "text": "ごめんね。\nわたし、ちょっと\n落ち着かないと…。"},
        { "location": "100/ACT" , "narrator": "", "text": "つばめは平気！？"},
        { "location": "101/TALK", "narrator": "透明つばめ", "text": "う、うん。\nわたしは平気だよ。"},
        { "location": "102/TALK", "narrator": "透明つばめ", "text": "でも…ごめんなさい。\nあーん、もちゃんと\nできなくて…。"},
        { "location": "103/SEL" , "narrator": "（選択肢）", "text": "何度でも喜んで付き合うよ"},
        { "location": "104/ACT" , "narrator": "", "text": "何度でも喜んで付き合うよ"},
        { "location": "106/TALK", "narrator": "透明つばめ", "text": "…………。"},
        { "location": "107/TALK", "narrator": "透明つばめ", "text": "うん…。わたしも、\n$handle$さんのためなら、\n何度だってするよ。"},
        { "location": "110/TALK", "narrator": "透明つばめ", "text": "それじゃ、気を取り直して\nもう一回…。"},
        { "location": "112/TALK", "narrator": "透明つばめ", "text": "あーん…。"},
        { "location": "125/SEL" , "narrator": "（選択肢）", "text": "こんなデートをしたいんだ！"},
        { "location": "126/ACT" , "narrator": "", "text": "こんなデートをしたいんだ！"},
        { "location": "128/TALK", "narrator": "つばめ", "text": "楽しそぅだね(≧ω≦)"},
        { "location": "129/TALK", "narrator": "つばめ", "text": "でも"},
        { "location": "130/TALK", "narrator": "つばめ", "text": "ぉ料理が心配かも(･Д･｀)"},
        { "location": "132/TALK", "narrator": "つばめ", "text": "$handle$さんは"},
        { "location": "133/TALK", "narrator": "つばめ", "text": "今の話のつづき"},
        { "location": "134/TALK", "narrator": "つばめ", "text": "ぉ料理"},
        { "location": "135/TALK", "narrator": "つばめ", "text": "美味しくできたと思ぅ？(´･ω･｀) "},
        { "location": "137/SEL" , "narrator": "（選択肢）", "text": "もちろんだよ、期待してる"},
        { "location": "138/SEL" , "narrator": "（選択肢）", "text": "作ってくれることが嬉しい"},
        { "location": "139/ACT" , "narrator": "", "text": "もちろんだよ、期待してる"},
        { "location": "140/TALK", "narrator": "つばめ", "text": "期待されちゃってるヾ(｡>﹏<｡)ﾉﾞ"},
        { "location": "141/TALK", "narrator": "つばめ", "text": "じゃぁ"},
        { "location": "142/TALK", "narrator": "つばめ", "text": "本当のデートする日のために"},
        { "location": "143/TALK", "narrator": "つばめ", "text": "練習してぉくね(๑･ㅂ･)و☆"},
        { "location": "144/ACT" , "narrator": "", "text": "作ってくれることが嬉しい"},
        { "location": "145/TALK", "narrator": "つばめ", "text": "嬉しぃけど"},
        { "location": "147/TALK", "narrator": "つばめ", "text": "できれば"},
        { "location": "148/TALK", "narrator": "つばめ", "text": "美味しくできたと思ぅって"},
        { "location": "149/TALK", "narrator": "つばめ", "text": "言ってほしかったなぁ(o´Д`)=з"}
    ]
}
