        { "location": "351/SCENARIO", "narrator": "", "text": "妄想ロマンティック"},
        { "location": "353/TALK"    , "narrator": "アーヤ", "text": "んー"},
        { "location": "354/TALK"    , "narrator": "アーヤ", "text": "恋"},
        { "location": "355/TALK"    , "narrator": "アーヤ", "text": "は"},
        { "location": "356/TALK"    , "narrator": "アーヤ", "text": "ある意味"},
        { "location": "357/TALK"    , "narrator": "アーヤ", "text": "妄想？"},
        { "location": "359/SEL"     , "narrator": "", "text": "夢がないなあ"},
        { "location": "360/SEL"     , "narrator": "", "text": "そうかもだけど"},
        { "location": "361/SEL"     , "narrator": "", "text": "ロマンティックな妄想なんだよ"},
        { "location": "362/ACT"     , "narrator": "", "text": "夢がないなあ"},
        { "location": "363/TALK"    , "narrator": "アーヤ", "text": "やっぱり必要？"},
        { "location": "364/TALK"    , "narrator": "アーヤ", "text": "夢"},
        { "location": "365/ACT"     , "narrator": "", "text": "そうかもだけど"},
        { "location": "366/TALK"    , "narrator": "アーヤ", "text": "違わないと思うけど"},
        { "location": "367/ACT"     , "narrator": "", "text": "ロマンティックな妄想なんだよ"},
        { "location": "368/TALK"    , "narrator": "アーヤ", "text": "そうね"},
        { "location": "369/TALK"    , "narrator": "アーヤ", "text": "妄想だけど"},
        { "location": "370/TALK"    , "narrator": "アーヤ", "text": "ロマンティックなのよね(*^.^*)"},
        { "location": "371/TALK"    , "narrator": "アーヤ", "text": "いいこと言うわ"},
        { "location": "372/TALK"    , "narrator": "アーヤ", "text": "$handle$さん"},
        { "location": "374/TALK"    , "narrator": "アーヤ", "text": "妄想だけど"},
        { "location": "375/TALK"    , "narrator": "アーヤ", "text": "その妄想って"},
        { "location": "376/TALK"    , "narrator": "アーヤ", "text": "楽しかったり切なかったりするわけでしょ"},
        { "location": "378/SEL"     , "narrator": "", "text": "それが恋の醍醐味"},
        { "location": "379/SEL"     , "narrator": "", "text": "そうじゃない恋は恋じゃない"},
        { "location": "380/SEL"     , "narrator": "", "text": "でもいつか消えるんだ"},
        { "location": "381/ACT"     , "narrator": "", "text": "それが恋の醍醐味"},
        { "location": "382/TALK"    , "narrator": "アーヤ", "text": "確かに"},
        { "location": "383/TALK"    , "narrator": "アーヤ", "text": "それがないなら"},
        { "location": "384/TALK"    , "narrator": "アーヤ", "text": "恋じゃないのかもね"},
        { "location": "385/ACT"     , "narrator": "", "text": "そうじゃない恋は恋じゃない"},
        { "location": "386/TALK"    , "narrator": "アーヤ", "text": "本当ね"},
        { "location": "387/TALK"    , "narrator": "アーヤ", "text": "恋ってそういうものだもの"},
        { "location": "388/ACT"     , "narrator": "", "text": "でもいつか消えるんだ"},
        { "location": "389/TALK"    , "narrator": "アーヤ", "text": "切ないわね"},
        { "location": "390/TALK"    , "narrator": "アーヤ", "text": "でもそう言われると"},
        { "location": "391/TALK"    , "narrator": "アーヤ", "text": "恋って気がするわ"}
    ]
