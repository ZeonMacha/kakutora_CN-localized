        { "location": "242/TALK", "narrator": "ガブリエラ", "text": "これは私も持ってるわ"},
        { "location": "244/TALK", "narrator": "ガブリエラ", "text": "北海道土産の定番、木彫りの熊よね？"},
        { "location": "247/SEL" , "narrator": "", "text": "北海道行ったことあるの？"},
        { "location": "248/ACT" , "narrator": "", "text": "北海道行ったことあるの？"},
        { "location": "251/TALK", "narrator": "ガブリエラ", "text": "フリマで３００円で売ってたのを買ったのよ"},
        { "location": "252/TALK", "narrator": "ガブリエラ", "text": "北海道まで行かずに、そんなに安く買えるとは思わなかったわ"},
        { "location": "253/TALK", "narrator": "ガブリエラ", "text": "私って、買い物上手だと思わない？"},
        { "location": "256/SEL" , "narrator": "", "text": "お土産物屋で買った方が楽しいのに"},
        { "location": "257/ACT" , "narrator": "", "text": "お土産物屋で買った方が楽しいのに"},
        { "location": "260/TALK", "narrator": "ガブリエラ", "text": "そんなの、言われるまでもなくわかってるわよ"},
        { "location": "261/TALK", "narrator": "ガブリエラ", "text": "私だって行ってみたいと思ってるけど"},
        { "location": "262/TALK", "narrator": "ガブリエラ", "text": "東京に住んでると、お土産物屋なんて見ないし"},
        { "location": "265/SEL" , "narrator": "", "text": "デパートで全国のが買えるしね"},
        { "location": "266/ACT" , "narrator": "", "text": "デパートで全国のが買えるしね"},
        { "location": "269/TALK", "narrator": "ガブリエラ", "text": "それね"},
        { "location": "270/TALK", "narrator": "ガブリエラ", "text": "私も、どこか地方を旅行して"},
        { "location": "271/TALK", "narrator": "ガブリエラ", "text": "目に付いたお土産物屋さんに入って、買い物したいわ"},
        { "location": "272/TALK", "narrator": "ガブリエラ", "text": "まあ、東京にいる限りは難しい話だけれど"}
    ]
