        { "location": "215/SCENARIO", "narrator": "", "text": "012_あのこのまつ毛"},
        { "location": "240/TALK"    , "narrator": "ガブリエラ", "text": "色素が薄いって不利な気がするわ"},
        { "location": "243/SEL"     , "narrator": "", "text": "むしろ有利"},
        { "location": "244/SEL"     , "narrator": "", "text": "やっと気が付いたの…"},
        { "location": "247/ACT"     , "narrator": "", "text": "むしろ有利"},
        { "location": "248/TALK"    , "narrator": "ガブリエラ", "text": "そうかしら・・・？"},
        { "location": "249/ACT"     , "narrator": "", "text": "やっと気が付いたの…"},
        { "location": "250/TALK"    , "narrator": "ガブリエラ", "text": "やっぱりそうなのね・・・"},
        { "location": "252/TALK"    , "narrator": "ガブリエラ", "text": "アーヤもみやびも"},
        { "location": "253/TALK"    , "narrator": "ガブリエラ", "text": "つばめですら"},
        { "location": "254/TALK"    , "narrator": "ガブリエラ", "text": "私よりまつ毛がはっきりしてるんだもの！"},
        { "location": "256/SEL"     , "narrator": "", "text": "そんなこと……"},
        { "location": "257/SEL"     , "narrator": "", "text": "気にすんな"},
        { "location": "258/SEL"     , "narrator": "", "text": "ガブの方が有利なこともあるでしょ"},
        { "location": "259/ACT"     , "narrator": "", "text": "そんなこと……"},
        { "location": "260/TALK"    , "narrator": "ガブリエラ", "text": "そんなことじゃないわ"},
        { "location": "261/TALK"    , "narrator": "ガブリエラ", "text": "とてもとてもとても重要なことよ"},
        { "location": "262/ACT"     , "narrator": "", "text": "気にすんな"},
        { "location": "264/TALK"    , "narrator": "ガブリエラ", "text": "そんな言い方しないで"},
        { "location": "265/TALK"    , "narrator": "ガブリエラ", "text": "とてもとてもとても重要なことよ"},
        { "location": "266/TALK"    , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "267/TALK"    , "narrator": "ガブリエラ", "text": "そう言ってもらえてちょっと気が楽になったわｖｖｖ"},
        { "location": "268/ACT"     , "narrator": "", "text": "ガブの方が有利なこともあるでしょ"},
        { "location": "269/TALK"    , "narrator": "ガブリエラ", "text": "あるかもしれないけど"},
        { "location": "270/TALK"    , "narrator": "ガブリエラ", "text": "今重要なのはまつ毛のことなんだもの"},
        { "location": "273/SEL"     , "narrator": "", "text": "まつ毛がそんなに大事？"},
        { "location": "274/ACT"     , "narrator": "", "text": "まつ毛がそんなに大事？"},
        { "location": "275/TALK"    , "narrator": "ガブリエラ", "text": "大事よ"},
        { "location": "278/SEL"     , "narrator": "", "text": "もっと大事なことがあるんじゃない？"},
        { "location": "279/ACT"     , "narrator": "", "text": "もっと大事なことがあるんじゃない？"},
        { "location": "280/TALK"    , "narrator": "ガブリエラ", "text": "あると思うわ"},
        { "location": "281/TALK"    , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "282/TALK"    , "narrator": "ガブリエラ", "text": "今一番大事なのはまつ毛なの"},
        { "location": "285/SEL"     , "narrator": "", "text": "仕方ない子ね"},
        { "location": "286/SEL"     , "narrator": "", "text": "機嫌直して、おひめさま"},
        { "location": "287/SEL"     , "narrator": "", "text": "つけますれば"},
        { "location": "288/ACT"     , "narrator": "", "text": "仕方ない子ね"},
        { "location": "289/TALK"    , "narrator": "ガブリエラ", "text": "仕方なくなんてないわよ"},
        { "location": "290/ACT"     , "narrator": "", "text": "機嫌直して、おひめさま"},
        { "location": "291/TALK"    , "narrator": "ガブリエラ", "text": "おひめさまは"},
        { "location": "292/TALK"    , "narrator": "ガブリエラ", "text": "おかんむりなのよ"},
        { "location": "293/ACT"     , "narrator": "", "text": "つけますれば"},
        { "location": "294/TALK"    , "narrator": "ガブリエラ", "text": "売ってるつけまは黒いのばっかりだもの"},
        { "location": "295/TALK"    , "narrator": "ガブリエラ", "text": "私が付けたらおかしいのよ！！！"},
        { "location": "297/TALK"    , "narrator": "ガブリエラ", "text": "もー！"},
        { "location": "298/TALK"    , "narrator": "ガブリエラ", "text": "なんでわかってくれないのー！！！"},
        { "location": "299/TALK"    , "narrator": "ガブリエラ", "text": "マルザンナのばか！！"},
        { "location": "300/TALK"    , "narrator": "ガブリエラ", "text": "わからずや！"}
