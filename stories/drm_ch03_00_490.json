{
    "dir": "dramatics/daydra/drm_ch03_00_490.js",
    "type": "Episode",
    "info": {
        "story_id": "3049",
        "cid": "gabriella",
        "title": "らぶとーく  第50話",
        "sub_title": "たまたまなんだから"
    },
    "entry":
    [
        { "location": "167/SCENARIO", "narrator": "", "text": "たまたまなんだから"},
        { "location": "180/TALK"    , "narrator": "ガブリエラ", "text": "ふぅ…結構色んなお店\n周ったわね…。"},
        { "location": "182/TALK"    , "narrator": "つばめ", "text": "ちゃんと案内できてる\nかな？"},
        { "location": "183/TALK"    , "narrator": "ガブリエラ", "text": "上出来よ。\n欲しかったゲームや\nＤＶＤも結構買えたし。"},
        { "location": "184/TALK"    , "narrator": "ガブリエラ", "text": "っていうか、いつの間に\nそんなに秋葉原のこと\n詳しくなったのよ？"},
        { "location": "185/TALK"    , "narrator": "つばめ", "text": "時々、一人で遊びに\n来たりしてるからかな？"},
        { "location": "186/TALK"    , "narrator": "ガブリエラ", "text": "うそっ！？\nつばめ、そんな頻繁に\n来てるわけ！？"},
        { "location": "188/TALK"    , "narrator": "つばめ", "text": "そ、そんな頻繁って\nわけじゃないよ。"},
        { "location": "191/TALK"    , "narrator": "つばめ", "text": "ただ、欲しいラノベは\n秋葉原で買うように\nしてるから――"},
        { "location": "192/TALK"    , "narrator": "つばめ", "text": "その時に色々探検して、\n面白いお店を見つける\nのが楽しみなんだ。"},
        { "location": "193/TALK"    , "narrator": "ガブリエラ", "text": "ふーん…。"},
        { "location": "194/TALK"    , "narrator": "ガブリエラ", "text": "結構気になるお店も\nあったから――"},
        { "location": "195/TALK"    , "narrator": "ガブリエラ", "text": "あたしも一人で\n来てみようかしら？"},
        { "location": "198/TALK"    , "narrator": "つばめ", "text": "楽しいと思うよ。"},
        { "location": "199/TALK"    , "narrator": "つばめ", "text": "あっ、そうだ！\n裏通りの方にも面白い\nお店があるの。"},
        { "location": "201/TALK"    , "narrator": "ガブリエラ", "text": "ちょ、ちょっと待って！\nあんたまだ周る気？"},
        { "location": "202/TALK"    , "narrator": "つばめ", "text": "え？　だってまだ、\n予定の半分くらいしか\n周ってないよ？"},
        { "location": "203/TALK"    , "narrator": "ガブリエラ", "text": "半分って…あんた、\nちょっと詳し過ぎ！"},
        { "location": "205/TALK"    , "narrator": "つばめ", "text": "えへへ…\n実は、ガブちゃんと\n来るのが楽しみで――"},
        { "location": "206/TALK"    , "narrator": "つばめ", "text": "ちょっと下見したり、\n調べたりしてたんだ。"},
        { "location": "208/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "210/TALK"    , "narrator": "つばめ", "text": "ね？　すぐそこだから\n行こう！"},
        { "location": "211/TALK"    , "narrator": "ガブリエラ", "text": "はぁ…楽しくなかったら\n承知しないわよ？"},
        { "location": "213/TALK"    , "narrator": "つばめ", "text": "うん！\nさ、行こう！"},
        { "location": "216/TALK"    , "narrator": "ガブリエラ", "text": "…まったく。"},
        { "location": "228/TALK"    , "narrator": "ガブリエラ", "text": "つばめと秋葉原に来てるんだけど"},
        { "location": "229/TALK"    , "narrator": "ガブリエラ", "text": "つばめのテンションが高くて疲れるわ"},
        { "location": "231/TALK"    , "narrator": "ガブリエラ", "text": "まあ"},
        { "location": "232/TALK"    , "narrator": "ガブリエラ", "text": "案内頼んだのは私だから文句は言えないけど"},
        { "location": "234/SEL"     , "narrator": "", "text": "なんでそんなところに？"},
        { "location": "235/SEL"     , "narrator": "", "text": "代わりに案内しようか？"},
        { "location": "236/SEL"     , "narrator": "", "text": "君には似合わない"},
        { "location": "237/ACT"     , "narrator": "", "text": "なんでそんなところに？"},
        { "location": "238/TALK"    , "narrator": "ガブリエラ", "text": "なんでって"},
        { "location": "240/TALK"    , "narrator": "ガブリエラ", "text": "私の趣味は知ってるでしょ？"},
        { "location": "241/TALK"    , "narrator": "ガブリエラ", "text": "ゲームとかアニメとか"},
        { "location": "242/TALK"    , "narrator": "ガブリエラ", "text": "ここだと何でも手に入るわ！"},
        { "location": "243/TALK"    , "narrator": "ガブリエラ", "text": "それに"},
        { "location": "244/TALK"    , "narrator": "ガブリエラ", "text": "$handle$もゲームが好きみたいだから"},
        { "location": "245/TALK"    , "narrator": "ガブリエラ", "text": "っていうか"},
        { "location": "246/TALK"    , "narrator": "ガブリエラ", "text": "$handle$の好きなゲーム、教えなさいよ"},
        { "location": "248/SEL"     , "narrator": "", "text": "コンシューマ系かな？"},
        { "location": "249/SEL"     , "narrator": "", "text": "洋ゲーかな？"},
        { "location": "250/SEL"     , "narrator": "", "text": "スマホゲーかな？"},
        { "location": "251/ACT"     , "narrator": "", "text": "コンシューマ系かな？"},
        { "location": "252/TALK"    , "narrator": "ガブリエラ", "text": "ふーん"},
        { "location": "253/TALK"    , "narrator": "ガブリエラ", "text": "意外と普通なのね"},
        { "location": "254/ACT"     , "narrator": "", "text": "洋ゲーかな？"},
        { "location": "255/TALK"    , "narrator": "ガブリエラ", "text": "あら、意外かも"},
        { "location": "256/TALK"    , "narrator": "ガブリエラ", "text": "そうなるとＰＣでやるようなのかしら？"},
        { "location": "257/TALK"    , "narrator": "ガブリエラ", "text": "もしかして"},
        { "location": "258/TALK"    , "narrator": "ガブリエラ", "text": "意外とゲーマー？"},
        { "location": "259/ACT"     , "narrator": "", "text": "スマホゲーかな？"},
        { "location": "260/TALK"    , "narrator": "ガブリエラ", "text": "手軽だし気持ちはわかるわ"},
        { "location": "262/TALK"    , "narrator": "ガブリエラ", "text": "私もカプドラ好きだし"},
        { "location": "264/TALK"    , "narrator": "ガブリエラ", "text": "言っとくけど！"},
        { "location": "265/TALK"    , "narrator": "ガブリエラ", "text": "あんたのこと知りたくて聞いたわけじゃないから"},
        { "location": "266/TALK"    , "narrator": "ガブリエラ", "text": "勘違いしないでね！"},
        { "location": "267/TALK"    , "narrator": "ガブリエラ", "text": "でも参考になったわ"},
        { "location": "268/TALK"    , "narrator": "ガブリエラ", "text": "まあ"},
        { "location": "269/TALK"    , "narrator": "ガブリエラ", "text": "ありがと"},
        { "location": "280/TALK"    , "narrator": "ガブリエラ", "text": "…あ、ありがとは、\n余計だったかしら"},
        { "location": "284/TALK"    , "narrator": "つばめ", "text": "ガブちゃん。\nどうかしたの？"},
        { "location": "286/TALK"    , "narrator": "ガブリエラ", "text": "な、何でもないわ。\nほら、早く行くわよ。"},
        { "location": "289/TALK"    , "narrator": "つばめ", "text": "あ、待って！\nお店。そっちじゃ\nないよぉ！"},
        { "location": "290/ACT"     , "narrator": "", "text": "代わりに案内しようか？"},
        { "location": "291/TALK"    , "narrator": "ガブリエラ", "text": "やっぱり詳しいの？"},
        { "location": "292/TALK"    , "narrator": "ガブリエラ", "text": "私なんて来てみたは良いけど"},
        { "location": "293/TALK"    , "narrator": "ガブリエラ", "text": "この街はさっぱりよ"},
        { "location": "295/TALK"    , "narrator": "ガブリエラ", "text": "もしかして"},
        { "location": "296/TALK"    , "narrator": "ガブリエラ", "text": "よく来たりしてるのかしら？"},
        { "location": "298/SEL"     , "narrator": "", "text": "結構頻繁に"},
        { "location": "299/SEL"     , "narrator": "", "text": "まあね"},
        { "location": "300/SEL"     , "narrator": "", "text": "ごめん、実は行ったことない"},
        { "location": "301/ACT"     , "narrator": "", "text": "結構頻繁に"},
        { "location": "302/TALK"    , "narrator": "ガブリエラ", "text": "そうなの！？"},
        { "location": "303/TALK"    , "narrator": "ガブリエラ", "text": "それじゃあ"},
        { "location": "304/TALK"    , "narrator": "ガブリエラ", "text": "私も頻繁に通うようにしようかしら？"},
        { "location": "305/ACT"     , "narrator": "", "text": "まあね"},
        { "location": "306/TALK"    , "narrator": "ガブリエラ", "text": "そう"},
        { "location": "307/TALK"    , "narrator": "ガブリエラ", "text": "じゃあ、今度私が一人で来た時は"},
        { "location": "308/TALK"    , "narrator": "ガブリエラ", "text": "$handle$に案内してもらおうかしら？"},
        { "location": "309/ACT"     , "narrator": "", "text": "ごめん、実は行ったことない"},
        { "location": "310/TALK"    , "narrator": "ガブリエラ", "text": "ウソつき"},
        { "location": "311/TALK"    , "narrator": "ガブリエラ", "text": "別に見得張るようなことでもないでしょ？"},
        { "location": "313/TALK"    , "narrator": "ガブリエラ", "text": "まあ"},
        { "location": "314/TALK"    , "narrator": "ガブリエラ", "text": "とりあえず$handle$のことまた一つ知れたから良しとするわ"},
        { "location": "316/TALK"    , "narrator": "ガブリエラ", "text": "あ"},
        { "location": "317/TALK"    , "narrator": "ガブリエラ", "text": "別に知りたかったわけじゃないから！"},
        { "location": "318/TALK"    , "narrator": "ガブリエラ", "text": "私のことだけ知られてるのが癪だから$handle$のことを知ろうと思っただけだから！"},
        { "location": "319/TALK"    , "narrator": "ガブリエラ", "text": "勘違いしないでよ！？"},
        { "location": "330/TALK"    , "narrator": "ガブリエラ", "text": "…口が滑ったわ。"},
        { "location": "331/TALK"    , "narrator": "ガブリエラ", "text": "いや、口じゃなくて\n指が滑った、が\n正しいのかしら？"},
        { "location": "335/TALK"    , "narrator": "つばめ", "text": "ガブちゃん。\nどうかしたの？"},
        { "location": "337/TALK"    , "narrator": "ガブリエラ", "text": "な、何でもないわ。\nほら、早く行くわよ。"},
        { "location": "340/TALK"    , "narrator": "つばめ", "text": "あ、待って！\nお店。そっちじゃ\nないよぉ！"},
        { "location": "341/ACT"     , "narrator": "", "text": "君には似合わない"},
        { "location": "342/TALK"    , "narrator": "ガブリエラ", "text": "そう？"},
        { "location": "343/TALK"    , "narrator": "ガブリエラ", "text": "まあ、私も秋葉原にはそんな興味ないし"},
        { "location": "344/TALK"    , "narrator": "ガブリエラ", "text": "けど"},
        { "location": "345/TALK"    , "narrator": "ガブリエラ", "text": "ひょっとして$handle$は興味あるんじゃないかと思ったのよ"},
        { "location": "347/SEL"     , "narrator": "", "text": "興味あるよ"},
        { "location": "348/SEL"     , "narrator": "", "text": "全然ないよ"},
        { "location": "349/ACT"     , "narrator": "", "text": "興味あるよ"},
        { "location": "350/TALK"    , "narrator": "ガブリエラ", "text": "でしょ？"},
        { "location": "352/TALK"    , "narrator": "ガブリエラ", "text": "だから共通の話題を作ろうと思ったのよ"},
        { "location": "353/ACT"     , "narrator": "", "text": "全然ないよ"},
        { "location": "354/TALK"    , "narrator": "ガブリエラ", "text": "そう"},
        { "location": "355/TALK"    , "narrator": "ガブリエラ", "text": "興味があるなら共通の話題が出来ると思ったのに…"},
        { "location": "356/TALK"    , "narrator": "ガブリエラ", "text": "まあ"},
        { "location": "357/TALK"    , "narrator": "ガブリエラ", "text": "それがわかっただけでも良しとするわ"},
        { "location": "359/TALK"    , "narrator": "ガブリエラ", "text": "あ！"},
        { "location": "360/TALK"    , "narrator": "ガブリエラ", "text": "でも勘違いしないで！"},
        { "location": "361/TALK"    , "narrator": "ガブリエラ", "text": "$handle$との話が好きだから来たわけじゃないから！"},
        { "location": "362/TALK"    , "narrator": "ガブリエラ", "text": "たまには変わった話がしたかっただけだから！"},
        { "location": "363/TALK"    , "narrator": "ガブリエラ", "text": "わかった！？"},
        { "location": "374/TALK"    , "narrator": "ガブリエラ", "text": "…って、今のはちょっと\n失礼だったかしら？"},
        { "location": "375/TALK"    , "narrator": "ガブリエラ", "text": "普段の$handle$との\n話が退屈、って言ってる\nようなもんだし…。"},
        { "location": "377/TALK"    , "narrator": "ガブリエラ", "text": "あたし、どうしていつも\nこうなんだろ…。"},
        { "location": "381/TALK"    , "narrator": "つばめ", "text": "ガブちゃん。\nどうかしたの？"},
        { "location": "383/TALK"    , "narrator": "ガブリエラ", "text": "な、何でもないわ。\nほら、早く行くわよ。"},
        { "location": "386/TALK"    , "narrator": "つばめ", "text": "あ、待って！\nお店。そっちじゃ\nないよぉ！"},
        { "location": "177/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>某月某日　 2:12 PM</color>\nとある休日、秋葉原にて"}
    ]
}
