        { "location": "385/SEL"     , "narrator": "", "text": "いつだって聞いてるよ"},
        { "location": "386/SEL"     , "narrator": "", "text": "嘘ばっかりだ"},
        { "location": "387/ACT"     , "narrator": "", "text": "いつだって聞いてるよ"},
        { "location": "389/TALK"    , "narrator": "神楽", "text": "うん"},
        { "location": "391/SEL"     , "narrator": "", "text": "でしょ？"},
        { "location": "392/SEL"     , "narrator": "", "text": "ひょっとしたら違うかも…？"},
        { "location": "393/SEL"     , "narrator": "", "text": "神楽には真剣にならざるを得ない"},
        { "location": "394/ACT"     , "narrator": "", "text": "でしょ？"},
        { "location": "396/ACT"     , "narrator": "", "text": "ひょっとしたら違うかも…？"},
        { "location": "397/TALK"    , "narrator": "神楽", "text": "やだこわい♪"},
        { "location": "407/ACT"     , "narrator": "", "text": "神楽には真剣にならざるを得ない"},
        { "location": "408/TALK"    , "narrator": "神楽", "text": "おっおっ？"},
        { "location": "410/TALK"    , "narrator": "神楽", "text": "真剣な回答素敵ぴょん♪"},
        { "location": "412/TALK"    , "narrator": "神楽", "text": "ぴょんこはさ"},
        { "location": "413/TALK"    , "narrator": "神楽", "text": "$handle$と話すの"},
        { "location": "414/TALK"    , "narrator": "神楽", "text": "これが最後だと思うぴょん、、、"},
        { "location": "416/SEL"     , "narrator": "", "text": "そんなのやだ"},
        { "location": "417/SEL"     , "narrator": "", "text": "またまたー"},
        { "location": "418/SEL"     , "narrator": "", "text": "嘘だよね？"},
        { "location": "419/ACT"     , "narrator": "", "text": "そんなのやだ"},
        { "location": "420/TALK"    , "narrator": "神楽", "text": "でしょ"},
        { "location": "421/TALK"    , "narrator": "神楽", "text": "ぴょんこだって"},
        { "location": "422/TALK"    , "narrator": "神楽", "text": "やだ"},
        { "location": "423/ACT"     , "narrator": "", "text": "またまたー"},
        { "location": "424/TALK"    , "narrator": "神楽", "text": "ほんとだってばよ"},
        { "location": "426/TALK"    , "narrator": "神楽", "text": "うんもー！！！！"},
        { "location": "427/ACT"     , "narrator": "", "text": "嘘だよね？"},
        { "location": "429/TALK"    , "narrator": "神楽", "text": "って"},
        { "location": "430/TALK"    , "narrator": "神楽", "text": "言いたいけど"},
        { "location": "432/TALK"    , "narrator": "神楽", "text": "今のこっちの状況的にもう本気で難しそうで"},
        { "location": "433/TALK"    , "narrator": "神楽", "text": "だからね？"},
        { "location": "434/TALK"    , "narrator": "神楽", "text": "言っておきたいことがあるぴょん"},
        { "location": "436/SEL"     , "narrator": "", "text": "何かな？"},
        { "location": "437/SEL"     , "narrator": "", "text": "撤回されることを願ってる"},
        { "location": "438/SEL"     , "narrator": "", "text": "あんまり聞きたくないかも……"},
        { "location": "439/ACT"     , "narrator": "", "text": "何かな？"},
        { "location": "440/TALK"    , "narrator": "神楽", "text": "真剣に聞いてよね"},
        { "location": "441/TALK"    , "narrator": "神楽", "text": "絶対だからね"},
        { "location": "442/ACT"     , "narrator": "", "text": "撤回されることを願ってる"},
        { "location": "443/TALK"    , "narrator": "神楽", "text": "そうなったら"},
        { "location": "445/TALK"    , "narrator": "神楽", "text": "すごくいいんだけど"},
        { "location": "446/ACT"     , "narrator": "", "text": "あんまり聞きたくないかも……"},
        { "location": "448/TALK"    , "narrator": "神楽", "text": "そんなのぴょんこだってそうだから！！！！"},
        { "location": "450/TALK"    , "narrator": "神楽", "text": "重すぎるかもだけど"},
