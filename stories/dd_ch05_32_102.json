        { "location": "1922/TALK"  , "narrator": "アーヤ", "text": "…いまのスピードだと\n却って危ないわ。\nそれは無理よ！"},
        { "location": "1926/TALK"  , "narrator": "アーヤ", "text": "じゃあ\nどうすれば…！？"},
        { "location": "1927/SEL"   , "narrator": "", "text": "まず落ち着こう"},
        { "location": "1928/ACT"   , "narrator": "", "text": "まず落ち着こう"},
