        { "location": "1904/TALK"  , "narrator": "みやび", "text": "順調に文京ドームへ\n進んじゅう。"},
        { "location": "1905/TALK"  , "narrator": "みやび", "text": "スピード以外は\n意外と安全運転かも\nしれんねえ…。"},
        { "location": "1908/TALK"  , "narrator": "ガブリエラ", "text": "そんなのいやよ！\nせめてスピードを\n落とせないの？"},
        { "location": "1909/TALK"  , "narrator": "アーヤ", "text": "止められれば\n何とかなる…！？"},
        { "location": "1910/TALK"  , "narrator": "アーヤ", "text": "…あっ…！\nサイドブレーキ…！？"},
        { "location": "1911/SEL"   , "narrator": "", "text": "ここ高速だよ！"},
        { "location": "1912/SEL"   , "narrator": "", "text": "スピード出過ぎてるし！"},
        { "location": "1913/ACT"   , "narrator": "", "text": "ここ高速だよ！"},
        { "location": "1914/ACT"   , "narrator": "", "text": "スピード出過ぎてるし！"},
