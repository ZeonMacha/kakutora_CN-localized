{
    "dir": "chap11/daydra/dd_ch04_11_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "11452",
        "cid": "miyabi",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "ケーキだ！！"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "ケーキだ！！"},
        { "location": "29/TALK"   , "narrator": "みやび", "text": "凄いケーキやね。\nこんなに沢山どうしたが？"},
        { "location": "31/TALK"   , "narrator": "つばめ", "text": "まゆちんが、みんなで\n食べてください、って\n置いていったんです。"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "こんなに沢山！？\nお金、大丈夫かしら？"},
        { "location": "35/TALK"   , "narrator": "つばめ", "text": "バイト先で貰ったとか\n言ってたよ。"},
        { "location": "37/TALK"   , "narrator": "アーヤ", "text": "光月さんって、\nケーキ屋でアルバイト\nしてるの？"},
        { "location": "39/TALK"   , "narrator": "つばめ", "text": "さあ？\n聞いても教えて\nくれないんです。"},
        { "location": "41/TALK"   , "narrator": "ガブリエラ", "text": "そんなのどうだって\nいいじゃない。"},
        { "location": "43/TALK"   , "narrator": "ガブリエラ", "text": "早くケーキ食べようよ！"},
        { "location": "45/TALK"   , "narrator": "つばめ", "text": "うん、そうしよ。\nみなさん、どのケーキが\n良いですか？"},
        { "location": "48/TALK"   , "narrator": "アーヤ", "text": "色々あるから迷うわね。\nう～ん…。"},
        { "location": "49/TALK"   , "narrator": "ガブリエラ", "text": "あたし、マスカットの\n載ったやつがいいわ。"},
        { "location": "51/TALK"   , "narrator": "アーヤ", "text": "あ、それ美味しそう。"},
        { "location": "54/TALK"   , "narrator": "ガブリエラ", "text": "早い者勝ちよ。"},
        { "location": "56/TALK"   , "narrator": "みやび", "text": "ふむ…\nうちはどれにしよう…。"},
        { "location": "58/TALK"   , "narrator": "みやび", "text": "ソースの掛かった\nチーズケーキも\n美味しそうやけんど――"},
        { "location": "60/TALK"   , "narrator": "みやび", "text": "こっちは、タルト生地か？\nフルーツも山盛りで\n良さそうやなぁ…。"},
        { "location": "62/TALK"   , "narrator": "みやび", "text": "じゃあ、うちはそこの――"},
        { "location": "65/TALK"   , "narrator": "つばめ", "text": "わたし、このケーキ\n貰いますね。"},
        { "location": "66/TALK"   , "narrator": "みやび", "text": "…………。"},
        { "location": "68/TALK"   , "narrator": "みやび", "text": "出遅れたか…。\nすっと決めとくん\nやったわ…。"},
        { "location": "69/SEL"    , "narrator": "", "text": "端末操作：つばめと会話"},
        { "location": "71/TALK"   , "narrator": "アーヤ", "text": "う～ん…なかなか\n決まらないわ…。"},
        { "location": "72/TALK"   , "narrator": "アーヤ", "text": "普通のショートケーキも\n美味しそうだけど、\nティラミスも…。"},
        { "location": "73/TALK"   , "narrator": "ガブリエラ", "text": "もう、本当に優柔不断\nなんだから。"},
        { "location": "75/TALK"   , "narrator": "アーヤ", "text": "みやびはどれにするの？"},
        { "location": "79/TALK"   , "narrator": "みやび", "text": "…じゃあ、うちは\nザッハトルテもらうきね。"},
        { "location": "82/TALK"   , "narrator": "みやび", "text": "ほれ、アーヤ。\nいつまでも悩んでたら\nみんなが食べられんぞ？"},
        { "location": "85/TALK"   , "narrator": "アーヤ", "text": "そ、そうね…。\nじゃあ、やっぱりショート\nケーキにするわ。"},
        { "location": "89/TALK"   , "narrator": "ガブリエラ", "text": "シンプルだけどいいの？"},
        { "location": "91/TALK"   , "narrator": "アーヤ", "text": "ショートケーキは\nケーキの王様よ。"},
        { "location": "93/TALK"   , "narrator": "みやび", "text": "決まったな。\nじゃあ、お茶でも\n入れるがよ。"},
        { "location": "96/TALK"   , "narrator": "つばめ", "text": "わたしも手伝います。"},
        { "location": "98/ACT"    , "narrator": "", "text": "端末操作：つばめと会話"},
        { "location": "104/TALK"  , "narrator": "つばめ", "text": "あれ？"},
        { "location": "116/TALK"  , "narrator": "つばめ", "text": "どうかしたの？"},
        { "location": "118/SEL"   , "narrator": "", "text": "みやびもそれ食べたいって"},
        { "location": "119/SEL"   , "narrator": "", "text": "モンブランは？"},
        { "location": "120/SEL"   , "narrator": "", "text": "他に食べたいのないの？"},
        { "location": "121/ACT"   , "narrator": "", "text": "みやびもそれ食べたいって"},
        { "location": "122/TALK"  , "narrator": "つばめ", "text": "あっ、そうだったんだ？"},
        { "location": "123/TALK"  , "narrator": "つばめ", "text": "教えてくれてありがと"},
        { "location": "134/TALK"  , "narrator": "みやび", "text": "さてと、うちはどれに\nしようか…。"},
        { "location": "136/TALK"  , "narrator": "つばめ", "text": "あ、あの…よかったら\nこのケーキ、どうぞ。"},
        { "location": "138/TALK"  , "narrator": "みやび", "text": "え？"},
        { "location": "139/TALK"  , "narrator": "つばめ", "text": "果物いっぱい載ってるし、\nサクサクのタルト生地で\n美味しいと思うんです。"},
        { "location": "140/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "142/TALK"  , "narrator": "つばめ", "text": "えっと…こういうケーキ\n嫌いですか？"},
        { "location": "143/TALK"  , "narrator": "みやび", "text": "えいが？\n食べたい思っちゅうがやろ？"},
        { "location": "146/TALK"  , "narrator": "つばめ", "text": "えへへ…実は、もう一つ\n気になってたケーキも\nあったんで…。"},
        { "location": "148/TALK"  , "narrator": "みやび", "text": "そういうことなら、\nありがたく貰うぞね。"},
        { "location": "149/TALK"  , "narrator": "みやび", "text": "実は、これが食べたい\n思うてたんよ。"},
        { "location": "150/TALK"  , "narrator": "つばめ", "text": "良かった…。\nじゃあ、わたしは\nこっちのケーキを――"},
        { "location": "153/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "165/TALK"  , "narrator": "みやび", "text": "相棒、聞きたいことがあるんやけんど"},
        { "location": "166/TALK"  , "narrator": "みやび", "text": "つばめちゃんに、ケーキのことで何か言ったがか？"},
        { "location": "168/SEL"   , "narrator": "", "text": "みやびも食べたい、って"},
        { "location": "169/ACT"   , "narrator": "", "text": "みやびも食べたい、って"},
        { "location": "171/TALK"  , "narrator": "みやび", "text": "うちのことを思うてしてくれたんはわかっちゅうけんど"},
        { "location": "172/TALK"  , "narrator": "みやび", "text": "うちが食べたいいうの知ったら、つばめちゃんが譲ろうとするんわかるちや？"},
        { "location": "173/TALK"  , "narrator": "みやび", "text": "こういうズル、うちは大嫌いや"},
        { "location": "174/TALK"  , "narrator": "みやび", "text": "二度と勝手な真似は許さんきな"},
        { "location": "185/ACT"   , "narrator": "", "text": "モンブランは？"},
        { "location": "187/TALK"  , "narrator": "つばめ", "text": "モンブランはよく食べるから、今日はこれがいいの"},
        { "location": "188/TALK"  , "narrator": "つばめ", "text": "それに、貰った中にモンブランはなさそうだし"},
        { "location": "200/TALK"  , "narrator": "つばめ", "text": "…あれ？\nそこのケーキって\n何ですか？"},
        { "location": "202/TALK"  , "narrator": "アーヤ", "text": "これ？　えっと…\nモンブランじゃない？"},
        { "location": "204/TALK"  , "narrator": "つばめ", "text": "えっ、これが！？"},
        { "location": "206/TALK"  , "narrator": "ガブリエラ", "text": "クリームの量が凄いわね。\nタワーみたいに\nなってるし。"},
        { "location": "207/TALK"  , "narrator": "つばめ", "text": "こんなに凄いモンブラン、\n見たことなくて\nわかりませんでした…。"},
        { "location": "208/TALK"  , "narrator": "つばめ", "text": "…いいなぁ。\nモンブランにすれば\nよかったなぁ。"},
        { "location": "210/TALK"  , "narrator": "みやび", "text": "交換すればえいよ。\n手を付けたわけや\nないがやし。"},
        { "location": "212/TALK"  , "narrator": "つばめ", "text": "いいんですか？"},
        { "location": "214/TALK"  , "narrator": "みやび", "text": "えいよ、うちとしても\nありがたいき。"},
        { "location": "215/TALK"  , "narrator": "みやび", "text": "つばめちゃんの持ってる\nケーキ、食べたい思うて\nたんよ。"},
        { "location": "216/TALK"  , "narrator": "つばめ", "text": "そうだったんですか？\nじゃあ、どうぞ。"},
        { "location": "217/TALK"  , "narrator": "みやび", "text": "ん、ありがとな。"},
        { "location": "218/TALK"  , "narrator": "アーヤ", "text": "みやびって、そういう\nケーキが好きだったんだ？"},
        { "location": "221/TALK"  , "narrator": "みやび", "text": "意外かえ？\n果物が載ったケーキは、\n特別な感じがするきね。"},
        { "location": "223/TALK"  , "narrator": "みやび", "text": "まっこと美味そうやねぇ。\n先に食べててえいが？"},
        { "location": "225/TALK"  , "narrator": "ガブリエラ", "text": "お茶入れてくるから、\nそれまで我慢しなさい。"},
        { "location": "226/ACT"   , "narrator": "", "text": "他に食べたいものないの？"},
        { "location": "227/TALK"  , "narrator": "つばめ", "text": "気になるのはいくつかあるよ"},
        { "location": "228/TALK"  , "narrator": "つばめ", "text": "けど、こんなに果物が載ったケーキ、食べたことないから"},
        { "location": "229/TALK"  , "narrator": "つばめ", "text": "今はこれを食べたい気分なんだ"},
        { "location": "241/TALK"  , "narrator": "つばめ", "text": "みやびさん達は\nどれにするんですか？"},
        { "location": "242/TALK"  , "narrator": "みやび", "text": "そうやねぇ…\nザッハトルテにするちや。"},
        { "location": "244/TALK"  , "narrator": "アーヤ", "text": "私は…チョコレート\nケーキにするわ。"},
        { "location": "245/TALK"  , "narrator": "ガブリエラ", "text": "よし、全員決まったわね。\nあたし、お茶入れてくる。"},
        { "location": "246/TALK"  , "narrator": "つばめ", "text": "凄く美味しそう…\n早く食べたいなぁ。"},
        { "location": "248/TALK"  , "narrator": "みやび", "text": "…まあ、狙ってたんは\n取れなかったけんど――"},
        { "location": "249/TALK"  , "narrator": "みやび", "text": "これも美味しそうやし、\n良しとするぞね。"},
        { "location": "17/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>6月26日　3:48 PM</color>\n初夏の休日の午後、神楽坂トライナリー劇場にて。"}
    ]
}
