        { "location": "5202/SCENARIO", "narrator": "", "text": "太陽なんてだいきらい"},
        { "location": "5227/TALK"    , "narrator": "神楽", "text": "何か今日は日差しが強くて！"},
        { "location": "5228/TALK"    , "narrator": "神楽", "text": "汗かくしじりじり暑いしもう何あれ"},
        { "location": "5229/TALK"    , "narrator": "神楽", "text": "一年中春とかでいてくれればいいのに！！！"},
        { "location": "5231/SEL"     , "narrator": "", "text": "そんな漫画あったな…"},
        { "location": "5232/SEL"     , "narrator": "", "text": "四季があるから日本はいいんだよ"},
        { "location": "5233/SEL"     , "narrator": "", "text": "そーれ春になれ～"},
        { "location": "5234/ACT"     , "narrator": "", "text": "そんな漫画あったな…"},
        { "location": "5235/TALK"    , "narrator": "神楽", "text": "そうなんだ？"},
        { "location": "5236/ACT"     , "narrator": "", "text": "四季があるから日本はいいんだよ"},
        { "location": "5237/TALK"    , "narrator": "神楽", "text": "あー知った風なこと言ってるー"},
        { "location": "5238/ACT"     , "narrator": "", "text": "そーれ春になれ～"},
        { "location": "5240/TALK"    , "narrator": "神楽", "text": "$handlek$って魔法使いなんだ？"},
        { "location": "5242/TALK"    , "narrator": "神楽", "text": "しゅごいしゅごい！！！"},
        { "location": "5243/TALK"    , "narrator": "神楽", "text": "そーれ春になれ～♪"},
        { "location": "5245/TALK"    , "narrator": "神楽", "text": "風があるかないかでもだいぶ違うよね体感温度"},
        { "location": "5246/TALK"    , "narrator": "神楽", "text": "でもあんまり風が強いのもいやなんだぴょん"},
        { "location": "5249/SEL"     , "narrator": "", "text": "$me$が神楽の楯になるよ"},
        { "location": "5250/SEL"     , "narrator": "", "text": "目にゴミが入ったりするしね"},
        { "location": "5251/SEL"     , "narrator": "", "text": "チラリズムを期待したい！"},
        { "location": "5252/ACT"     , "narrator": "", "text": "$me$が神楽の楯になるよ"},
        { "location": "5254/TALK"    , "narrator": "神楽", "text": "やばい騎士様だ！！！"},
        { "location": "5255/TALK"    , "narrator": "神楽", "text": "ぴょんこの騎士様だ！！！"},
        { "location": "5257/TALK"    , "narrator": "神楽", "text": "いやもしかしてボディーガードかな？"},
        { "location": "5258/TALK"    , "narrator": "神楽", "text": "ぴょんこと$handlek$でハリウッドに進出するぴょん！"},
        { "location": "5259/TALK"    , "narrator": "神楽", "text": "そんで全米をどうにかする、、、"},
        { "location": "5260/TALK"    , "narrator": "神楽", "text": "よしこれだ！"},
        { "location": "5261/ACT"     , "narrator": "", "text": "目にゴミが入ったりするしね"},
        { "location": "5262/TALK"    , "narrator": "神楽", "text": "なー？"},
        { "location": "5263/TALK"    , "narrator": "神楽", "text": "困るぴょん、、、"},
        { "location": "5264/ACT"     , "narrator": "", "text": "チラリズムを期待したい！"},
        { "location": "5265/TALK"    , "narrator": "神楽", "text": "あｗｗｗｗ"},
        { "location": "5266/TALK"    , "narrator": "神楽", "text": "おまわりさんこの人です！"},
