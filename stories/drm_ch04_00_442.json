{
    "dir": "dramatics/daydra/drm_ch04_00_442.js",
    "type": "Episode",
    "info": {
        "story_id": "4048",
        "cid": "miyabi",
        "title": "らぶとーく 第49話",
        "sub_title": "口止めとは生意気な（ガブリエラ）"
    },
    "entry":
    [
        { "location": "282/SCENARIO", "narrator": "", "text": "口止めとは生意気な（ガブリエラ）"},
        { "location": "296/TALK"    , "narrator": "ガブリエラ", "text": "開いてるわよー。"},
        { "location": "299/TALK"    , "narrator": "みやび", "text": "お邪魔するぞね。"},
        { "location": "300/TALK"    , "narrator": "ガブリエラ", "text": "あら、どうかしたの？"},
        { "location": "301/TALK"    , "narrator": "みやび", "text": "ん…当直のことや。"},
        { "location": "302/TALK"    , "narrator": "みやび", "text": "今度の当直、まさか\nガブちゃんが代わる\n言うとは思わなくて。"},
        { "location": "304/TALK"    , "narrator": "ガブリエラ", "text": "…まあ、そういう\n気分だったのよ。"},
        { "location": "307/TALK"    , "narrator": "みやび", "text": "実は、その日はどうしても\n外せん用事があってな。"},
        { "location": "308/TALK"    , "narrator": "みやび", "text": "正直、どうしようか\n悩んでたちや。"},
        { "location": "311/TALK"    , "narrator": "みやび", "text": "やき、ガブちゃんが\n代わる言うてくれて、\nまっこと助かった。"},
        { "location": "312/TALK"    , "narrator": "みやび", "text": "ありがとな。"},
        { "location": "315/TALK"    , "narrator": "ガブリエラ", "text": "べ、別に、そんな\nお礼言われるほどの\nことじゃないし…。"},
        { "location": "316/TALK"    , "narrator": "みやび", "text": "いや、礼くらい言わせて\nもらえんと、うちの気が\nすまん。"},
        { "location": "318/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "320/TALK"    , "narrator": "ガブリエラ", "text": "それなら、もう一人\nお礼を言うべき人が\nいるわね。"},
        { "location": "321/TALK"    , "narrator": "みやび", "text": "…もう一人？"},
        { "location": "324/TALK"    , "narrator": "ガブリエラ", "text": "本当は口止めされて\nたんだけど、\n言っちゃうわ。"},
        { "location": "325/TALK"    , "narrator": "ガブリエラ", "text": "みやびが当直の日に、\n凄く大事な予定が\n重なってるから――"},
        { "location": "326/TALK"    , "narrator": "ガブリエラ", "text": "変わってやってくれ\nないか、って、\n頼まれたのよ。"},
        { "location": "328/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "331/TALK"    , "narrator": "みやび", "text": "初耳や。\nそんなこと言われたが？"},
        { "location": "332/TALK"    , "narrator": "ガブリエラ", "text": "ええ、言われたわ。"},
        { "location": "334/TALK"    , "narrator": "みやび", "text": "そうか…。"},
        { "location": "335/TALK"    , "narrator": "みやび", "text": "なるほどな…。\n道理でタイミングが\n良過ぎるわけや。"},
        { "location": "338/TALK"    , "narrator": "ガブリエラ", "text": "…余計なことだった？"},
        { "location": "340/TALK"    , "narrator": "みやび", "text": "いや、そんなことは\nないぞね。"},
        { "location": "341/TALK"    , "narrator": "みやび", "text": "それより、当直の方は\nまっこと変わってもらって\nえいが？"},
        { "location": "344/TALK"    , "narrator": "ガブリエラ", "text": "変わると言った以上は、\n今更撤回しないわ。"},
        { "location": "345/TALK"    , "narrator": "みやび", "text": "そうか…。\n改めて、ありがとうな。"},
        { "location": "354/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "361/TALK"    , "narrator": "みやび", "text": "おい"},
        { "location": "363/TALK"    , "narrator": "みやび", "text": "うちに内緒で勝手なことを"},
        { "location": "364/TALK"    , "narrator": "みやび", "text": "余計なことするな！"},
        { "location": "366/SEL"     , "narrator": "", "text": "もう決まったし"},
        { "location": "367/SEL"     , "narrator": "", "text": "サプライズ成功！"},
        { "location": "368/SEL"     , "narrator": "", "text": "遠慮しないで"},
        { "location": "369/ACT"     , "narrator": "", "text": "もう決まったし"},
        { "location": "370/TALK"    , "narrator": "みやび", "text": "勝手に決めよって"},
        { "location": "371/TALK"    , "narrator": "みやび", "text": "ハッキリ言っておく"},
        { "location": "372/TALK"    , "narrator": "みやび", "text": "こういうズルは好きやない"},
        { "location": "373/TALK"    , "narrator": "みやび", "text": "礼は言わんぞ！"},
        { "location": "374/ACT"     , "narrator": "", "text": "サプライズ成功！"},
        { "location": "375/TALK"    , "narrator": "みやび", "text": "そうやね"},
        { "location": "376/TALK"    , "narrator": "みやび", "text": "ハッピーの付かない方"},
        { "location": "377/TALK"    , "narrator": "みやび", "text": "ただのサプライズ"},
        { "location": "378/TALK"    , "narrator": "みやび", "text": "いや"},
        { "location": "379/TALK"    , "narrator": "みやび", "text": "限りなくバッドに近い"},
        { "location": "380/ACT"     , "narrator": "", "text": "遠慮しないで"},
        { "location": "381/TALK"    , "narrator": "みやび", "text": "おまえが言うな！"},
        { "location": "382/TALK"    , "narrator": "みやび", "text": "それはガブちゃんのセリフや"},
        { "location": "383/TALK"    , "narrator": "みやび", "text": "呆れるほどの図々しさやね"},
        { "location": "386/SEL"     , "narrator": "", "text": "余計なことしてごめん…"},
        { "location": "387/ACT"     , "narrator": "", "text": "余計なことしてごめん…"},
        { "location": "390/TALK"    , "narrator": "みやび", "text": "まあ"},
        { "location": "391/TALK"    , "narrator": "みやび", "text": "当直がなくなって助かったのは事実や"},
        { "location": "392/TALK"    , "narrator": "みやび", "text": "実際困ってたのも事実"},
        { "location": "393/TALK"    , "narrator": "みやび", "text": "そういうことだ"},
        { "location": "394/TALK"    , "narrator": "みやび", "text": "まあ"},
        { "location": "397/TALK"    , "narrator": "みやび", "text": "休みに罪はない"},
        { "location": "398/TALK"    , "narrator": "みやび", "text": "遠慮なく使わせてもらうちや！"},
        { "location": "291/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>某月某日　 4:39 PM</color>\nとある平日、寮「とらいあんぐる」ガブリエラの部屋にて"}
    ]
}
