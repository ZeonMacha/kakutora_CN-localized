{
    "dir": "chap26/daydra/anime_04_26.js",
    "type": "MainStory",
    "info": {
        "story_id": "26401",
        "cid": "miyabi",
        "title": "001 アニメーション",
        "sub_title": "EXE_KAGURa"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "アニメ第26話"},
        { "location": "49/TALK"   , "narrator": "神楽", "text": "ごきげんよう、\n$handle$さん。"},
        { "location": "50/TALK"   , "narrator": "神楽", "text": "今回は、私のMVを\n再生するだけにしますか？"},
        { "location": "51/SEL"    , "narrator": "", "text": "はい"},
        { "location": "52/SEL"    , "narrator": "", "text": "いいえ"},
        { "location": "53/ACT"    , "narrator": "", "text": "はい"},
        { "location": "55/TALK"   , "narrator": "神楽", "text": "わかりました。"},
        { "location": "57/ACT"    , "narrator": "", "text": "いいえ"},
        { "location": "59/TALK"   , "narrator": "神楽", "text": "わかりました。\nそれじゃ、エリカさんに\n代わりますね。"},
        { "location": "84/TALK"   , "narrator": "謎のおねえさん", "text": "コーンコン。"},
        { "location": "85/TALK"   , "narrator": "謎のおねえさん", "text": "また会えたね、\n$handle$さん。"},
        { "location": "86/SEL"    , "narrator": "", "text": "こんにちは謎のおねえさん"},
        { "location": "87/ACT"    , "narrator": "", "text": "こんにちは謎のおねえさん"},
        { "location": "90/TALK"   , "narrator": "謎のおねえさん", "text": "ああっ！\nそういえばまだ、自己\n紹介もしてなかったよね。"},
        { "location": "91/TALK"   , "narrator": "謎のおねえさん", "text": "ごめんなさい。\nいつもウッカリして\n忘れちゃうんだよね。"},
        { "location": "92/TALK"   , "narrator": "謎のおねえさん", "text": "改めまして、\nわたしは國政領火です。\nエリカって呼んでね。"},
        { "location": "93/TALK"   , "narrator": "エリカ", "text": "そして、綾ちゃん、\n國政綾水の姉です。"},
        { "location": "94/TALK"   , "narrator": "エリカ", "text": "いつも妹が\nお世話になってます！"},
        { "location": "95/SEL"    , "narrator": "", "text": "こちらこそ"},
        { "location": "96/SEL"    , "narrator": "", "text": "お姉ちゃんは攻略できませんか？"},
        { "location": "97/ACT"    , "narrator": "", "text": "こちらこそ"},
        { "location": "98/TALK"   , "narrator": "エリカ", "text": "これからもずっと\n支えてくれたら、\n姉として嬉しいな。"},
        { "location": "99/TALK"   , "narrator": "エリカ", "text": "末永く\nよろしくね。"},
        { "location": "100/ACT"   , "narrator": "", "text": "お姉ちゃんは攻略できませんか？"},
        { "location": "103/TALK"  , "narrator": "エリカ", "text": "それはちょっと無理かも。"},
        { "location": "104/TALK"  , "narrator": "エリカ", "text": "っていうか、それ以前に\nあなた、千羽鶴ちゃんにも\n同じ様な事言ってない？"},
        { "location": "105/TALK"  , "narrator": "エリカ", "text": "確か、『綾ちゃんたちを\n殺してでも結婚したい』\nだったっけ…。"},
        { "location": "106/SEL"   , "narrator": "", "text": "ああ、言ったさ！"},
        { "location": "107/SEL"   , "narrator": "", "text": "ご、ごめんなさい…ブルブル"},
        { "location": "108/SEL"   , "narrator": "", "text": "言ってません！"},
        { "location": "109/ACT"   , "narrator": "", "text": "ああ、言ったさ！"},
        { "location": "111/TALK"  , "narrator": "エリカ", "text": "素直でよろしい。"},
        { "location": "112/TALK"  , "narrator": "エリカ", "text": "でも、同じ世界での重婚は\n画策しない方がいいよ？"},
        { "location": "113/TALK"  , "narrator": "エリカ", "text": "こうして記録に\n残っちゃってるし。"},
        { "location": "114/ACT"   , "narrator": "", "text": "ご、ごめんなさい…ブルブル"},
        { "location": "117/TALK"  , "narrator": "エリカ", "text": "あっ、えっと！\nそんな、怖がらせる\nつもりは無いんだけど！"},
        { "location": "118/TALK"  , "narrator": "エリカ", "text": "でも、綾ちゃん殺されたら\nわたしはちょっと黙って\nいられないから。"},
        { "location": "119/TALK"  , "narrator": "エリカ", "text": "実際はそんなことしないと\n思うけど、そこだけは\n最初に言っておくね？"},
        { "location": "120/ACT"   , "narrator": "", "text": "言ってません！"},
        { "location": "122/TALK"  , "narrator": "エリカ", "text": "往生際が悪いですよ？"},
        { "location": "123/TALK"  , "narrator": "エリカ", "text": "ちゃんとアカシック\nレコードに記録されて\nいるんですからね？"},
        { "location": "125/TALK"  , "narrator": "エリカ", "text": "それに、\nちゃんと注意喚起まで\nされてたみたいだけど。"},
        { "location": "131/TALK"  , "narrator": "エリカ", "text": "それはちょっと\n難しいかも。ごめんね？"},
        { "location": "132/TALK"  , "narrator": "エリカ", "text": "でも、綾ちゃんと\n結婚すれば、わたしとも\n同じ家族になれるよ！"},
        { "location": "133/TALK"  , "narrator": "エリカ", "text": "ああっ！\nでも……"},
        { "location": "134/TALK"  , "narrator": "エリカ", "text": "綾ちゃん、お式に\n呼んでくれるかなぁ。"},
        { "location": "135/TALK"  , "narrator": "エリカ", "text": "綾ちゃんが嫌って言ったら\nあなたが「ご友人」として\n招待してくれないかな？"},
        { "location": "139/TALK"  , "narrator": "エリカ", "text": "…って、いけない！\nそんなことやってる\n場合じゃなかったよ。"},
        { "location": "140/TALK"  , "narrator": "エリカ", "text": "ごめんね。\n今日はちょっと調べ事で\n色々忙しくて。"},
        { "location": "141/SEL"   , "narrator": "", "text": "前回の選択肢のこととか？"},
        { "location": "142/SEL"   , "narrator": "", "text": "千羽鶴のこととか？"},
        { "location": "143/ACT"   , "narrator": "", "text": "前回の選択肢のこととか？"},
        { "location": "144/TALK"  , "narrator": "エリカ", "text": "そう。正解～。"},
        { "location": "145/ACT"   , "narrator": "", "text": "千羽鶴のこととか？"},
        { "location": "147/TALK"  , "narrator": "エリカ", "text": "んー、まだちょっと\nわからないけど、\nもしかしたら正解かも。"},
        { "location": "149/TALK"  , "narrator": "エリカ", "text": "正解は、OSのコミュ\nシステム調査で忙しい、\nでした～！"},
        { "location": "151/TALK"  , "narrator": "エリカ", "text": "ホントは今から、\n色んな真実をあなたに\n教えたかったんだけど――"},
        { "location": "152/TALK"  , "narrator": "エリカ", "text": "今回はちょっと\n無理になっちゃって。"},
        { "location": "153/TALK"  , "narrator": "エリカ", "text": "それと、今の状態じゃ\nデイドラシステムも\n危なくて使えないの。"},
        { "location": "154/TALK"  , "narrator": "エリカ", "text": "だから、\n今回は１回休みで\nいいかな？"},
        { "location": "155/TALK"  , "narrator": "エリカ", "text": "ホント、ごめんね。\n出逢って早々ドタキャン\nしちゃって。"},
        { "location": "156/TALK"  , "narrator": "エリカ", "text": "こんなだから綾ちゃんに\n怒られちゃうんだよね。"},
        { "location": "157/TALK"  , "narrator": "エリカ", "text": "って、また\n長話しちゃったよ。\nもう行かなくちゃ。"},
        { "location": "158/TALK"  , "narrator": "エリカ", "text": "それじゃまた次回、\nここで待ってるね！"},
        { "location": "169/TALK"  , "narrator": "神楽", "text": "こんにちは、\n$handle$さん。"},
        { "location": "170/SEL"   , "narrator": "", "text": "なんで神楽がここに！？"},
        { "location": "171/ACT"   , "narrator": "", "text": "なんで神楽がここに！？"},
        { "location": "173/TALK"  , "narrator": "神楽", "text": "今回は記録映像の再生が\n中止だって聞いて、\nお邪魔しちゃいました。"},
        { "location": "174/SEL"   , "narrator": "", "text": "どうやって？"},
        { "location": "175/ACT"   , "narrator": "", "text": "どうやって？"},
        { "location": "177/TALK"  , "narrator": "神楽", "text": "みやびさんの\nココロの司書さんに\n教えてもらったんです。"},
        { "location": "178/TALK"  , "narrator": "神楽", "text": "どうしても\nやりたいことがあって。"},
        { "location": "179/SEL"   , "narrator": "", "text": "$me$への告白？"},
        { "location": "180/SEL"   , "narrator": "", "text": "MVを流すの？"},
        { "location": "181/ACT"   , "narrator": "", "text": "$me$への告白？"},
        { "location": "183/TALK"  , "narrator": "神楽", "text": "それも\n悪くはないんですけど……"},
        { "location": "184/TALK"  , "narrator": "神楽", "text": "でも、それはまた\n別の所でやりましょう！"},
        { "location": "185/TALK"  , "narrator": "神楽", "text": "というわけで、違います。\n今回は、貴方と一緒に\n私のMVを見たくて。"},
        { "location": "186/ACT"   , "narrator": "", "text": "MVを流すの？"},
        { "location": "188/TALK"  , "narrator": "神楽", "text": "えっ！？\nどうして\nわかったんですか？"},
        { "location": "189/SEL"   , "narrator": "", "text": "前回の終わりにMV回だって書いてあった"},
        { "location": "190/ACT"   , "narrator": "", "text": "前回の終わりにMV回だって書いてあった"},
        { "location": "192/TALK"  , "narrator": "神楽", "text": "あー、\nそうだったんですね。"},
        { "location": "193/TALK"  , "narrator": "神楽", "text": "私がここへ来ることは、\nTRI-OSにとっては\n予定通りだったと…。"},
        { "location": "195/TALK"  , "narrator": "神楽", "text": "とにかく。\n見たいんです！\nあなたと一緒に！"},
        { "location": "196/SEL"   , "narrator": "", "text": "どうしてそんなに？"},
        { "location": "197/ACT"   , "narrator": "", "text": "どうしてそんなに？"},
        { "location": "199/TALK"  , "narrator": "神楽", "text": "それは……"},
        { "location": "200/TALK"  , "narrator": "神楽", "text": "私……もう、\nそんなに先が長くないかも\nしれないからです。"},
        { "location": "201/TALK"  , "narrator": "神楽", "text": "MVは千羽鶴によって\n入隊順にセットされて\nいました。"},
        { "location": "202/TALK"  , "narrator": "神楽", "text": "それは、その子が最も\n輝ける時期に狙って\n置かれているんですが。"},
        { "location": "203/TALK"  , "narrator": "神楽", "text": "私とつばめさんのは、\n当然一番後ろにあって。"},
        { "location": "204/TALK"  , "narrator": "神楽", "text": "特につばめさんのは、\n本当に再生する気が\nあるのかっていう……"},
        { "location": "205/SEL"   , "narrator": "", "text": "何それどういうこと！？"},
        { "location": "206/ACT"   , "narrator": "", "text": "何それどういうこと！？"},
        { "location": "208/TALK"  , "narrator": "神楽", "text": "あ、いえ、今は\nそんなことは\nどうでもいいんです。"},
        { "location": "209/TALK"  , "narrator": "神楽", "text": "今お話したいのは\n私のMVの方ですから。"},
        { "location": "210/TALK"  , "narrator": "神楽", "text": "とにかく、私のMVは\n映像記録のほぼ末端に\nあって。"},
        { "location": "211/TALK"  , "narrator": "神楽", "text": "それが流されるとき、\n私はどうなってるか、\n正直わかりません。"},
        { "location": "212/TALK"  , "narrator": "神楽", "text": "生きてるかどうかすら\n怪しいと思ってます。"},
        { "location": "213/TALK"  , "narrator": "神楽", "text": "仮に\n生きていたとしても……。"},
        { "location": "214/TALK"  , "narrator": "神楽", "text": "……。"},
        { "location": "215/TALK"  , "narrator": "神楽", "text": "恐らくは今後、私と\nつばめさん達との間には、\n様々な事があるでしょう。"},
        { "location": "219/TALK"  , "narrator": "神楽", "text": "それらのコトが起こる前に\n生きて、貴方と一緒に\nMVを見たかったんです。"},
        { "location": "220/TALK"  , "narrator": "神楽", "text": "私のMVには、想いが\n沢山詰まっています。"},
        { "location": "221/TALK"  , "narrator": "神楽", "text": "それを、\n私の隣で感じ取って\n欲しかったから。"},
        { "location": "224/TALK"  , "narrator": "神楽", "text": "…って。\nちょっと重いお話に\nなっちゃいましたね。"},
        { "location": "225/TALK"  , "narrator": "神楽", "text": "でも、簡単に言えば、\n私も$handle$さんと\nイチャラブしたいんです。"},
        { "location": "227/TALK"  , "narrator": "神楽", "text": "ですから、よろしければ\nつき合ってもらえますか？"},
        { "location": "228/SEL"   , "narrator": "", "text": "もちろん"},
        { "location": "229/SEL"   , "narrator": "", "text": "遠慮します"},
        { "location": "230/ACT"   , "narrator": "", "text": "もちろん"},
        { "location": "233/TALK"  , "narrator": "神楽", "text": "ありがとうございます！\nとっても嬉しいです。"},
        { "location": "234/TALK"  , "narrator": "神楽", "text": "無理してMVを取ってきた\n甲斐がありました♪"},
        { "location": "235/TALK"  , "narrator": "神楽", "text": "それでは早速、\n宜しくお願いします！"},
        { "location": "236/SEL"   , "narrator": "", "text": "こちらこそ"},
        { "location": "237/ACT"   , "narrator": "", "text": "こちらこそ"},
        { "location": "239/TALK"  , "narrator": "神楽", "text": "……。"},
        { "location": "240/SEL"   , "narrator": "", "text": "どうしたの？"},
        { "location": "241/ACT"   , "narrator": "", "text": "どうしたの？"},
        { "location": "243/TALK"  , "narrator": "神楽", "text": "何と言いましょうか…。\n中等部の頃に、\n放送室に潜入して――"},
        { "location": "244/TALK"  , "narrator": "神楽", "text": "自分のお気に入りの\n音楽を流しちゃった時の\n事を思い出しました！"},
        { "location": "245/TALK"  , "narrator": "神楽", "text": "あの時私、\n後で怒られるの覚悟で\n流したんです。"},
        { "location": "246/TALK"  , "narrator": "神楽", "text": "どうしてもみんなに\n聞いて欲しい曲があって。"},
        { "location": "247/TALK"  , "narrator": "神楽", "text": "今の私も、\nその時と同じ気持ちです。"},
        { "location": "248/TALK"  , "narrator": "神楽", "text": "改めて……。"},
        { "location": "249/TALK"  , "narrator": "神楽", "text": "こんなに急なお願いなのに\n一緒に見てくれて\nありがとうございます。"},
        { "location": "250/TALK"  , "narrator": "神楽", "text": "それじゃ早速、\nよろしくお願いします！"},
        { "location": "251/ACT"   , "narrator": "", "text": "遠慮します"},
        { "location": "253/TALK"  , "narrator": "神楽", "text": "そうですか…。\nちょっぴり残念です。"},
        { "location": "254/TALK"  , "narrator": "神楽", "text": "でも、無理矢理お願いして\nいるのは私ですから、\n気にしないでくださいね。"},
        { "location": "255/TALK"  , "narrator": "神楽", "text": "もし気が変わって\n見たくなったら、いつでも\n来てください。"},
        { "location": "256/TALK"  , "narrator": "神楽", "text": "その時は是非、\nご一緒しましょう。"},
        { "location": "257/TALK"  , "narrator": "神楽", "text": "それでは、また。\nお逢いできる時を\n楽しみにしています♪"},
        { "location": "262/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/43MB 2:51】</color>"},
        { "location": "263/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/15MB 2:51】</color>"},
        { "location": "264/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/43MB 2:51】</color>"},
        { "location": "270/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/15MB 2:51】</color>"},
        { "location": "286/TALK"  , "narrator": "神楽", "text": "……。"},
        { "location": "287/TALK"  , "narrator": "神楽", "text": "どうでしたか？"},
        { "location": "288/SEL"   , "narrator": "", "text": "凄かった"},
        { "location": "289/SEL"   , "narrator": "", "text": "まあ、こんなものか"},
        { "location": "290/SEL"   , "narrator": "", "text": "色々教えて欲しいことがある"},
        { "location": "291/ACT"   , "narrator": "", "text": "凄かった"},
        { "location": "293/TALK"  , "narrator": "神楽", "text": "ふふ。\nありがとうございます。"},
        { "location": "294/TALK"  , "narrator": "神楽", "text": "このMVから、何かを\n感じ取ってもらえたら\nとっても嬉しいです。"},
        { "location": "295/TALK"  , "narrator": "神楽", "text": "もし、もっと色んなことを\n知りたかったり、それと、\n……したかったりしたら。"},
        { "location": "296/TALK"  , "narrator": "神楽", "text": "是非今度は、\n私と一緒に\nMVを見ませんか？"},
        { "location": "297/TALK"  , "narrator": "神楽", "text": "その時は、１つ１つ、\n手取り足取り、貴方に\n教えちゃいます♪"},
        { "location": "298/ACT"   , "narrator": "", "text": "まあ、こんなものか"},
        { "location": "299/TALK"  , "narrator": "神楽", "text": "あまりお気に召さなかった\nみたいですね。"},
        { "location": "300/TALK"  , "narrator": "神楽", "text": "でも、見てくれて\nありがとうございました！"},
        { "location": "301/TALK"  , "narrator": "神楽", "text": "少しでも何かを\n感じ取ってくれたら\nとっても嬉しいです。"},
        { "location": "302/ACT"   , "narrator": "", "text": "色々教えて欲しいことがある"},
        { "location": "303/TALK"  , "narrator": "神楽", "text": "その気持ち、\nすごくよくわかります！"},
        { "location": "304/TALK"  , "narrator": "神楽", "text": "でも、どうせなら、\nここで回りくどく\n説明するより――"},
        { "location": "305/TALK"  , "narrator": "神楽", "text": "今度二人きりで\n一緒に見ながら\n教えちゃいますよ？"},
        { "location": "306/TALK"  , "narrator": "神楽", "text": "ですから、\n今日はここまでに\nしましょう。"},
        { "location": "308/TALK"  , "narrator": "神楽", "text": "っと。"},
        { "location": "309/TALK"  , "narrator": "神楽", "text": "あまり長居すると、\nナビゲーターさんが\n戻って来ちゃいますね。"},
        { "location": "310/TALK"  , "narrator": "神楽", "text": "それでは、\nこれからもどうか\nよろしくお願いします。"},
        { "location": "311/TALK"  , "narrator": "神楽", "text": "まだチャンネルも無い\nうちからこんな事言うのも\n変かもですが――"},
        { "location": "312/TALK"  , "narrator": "神楽", "text": "貴方だけが頼りです。"},
        { "location": "313/TALK"  , "narrator": "神楽", "text": "……。"},
        { "location": "314/TALK"  , "narrator": "神楽", "text": "それじゃ、\nまたお逢いしましょう。"},
        { "location": "315/TALK"  , "narrator": "神楽", "text": "$handle$さん。\n頼りにしてますよ？"},
