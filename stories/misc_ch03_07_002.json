    "entry":
    [
        { "location": "132/SCENARIO", "narrator": "", "text": "000_そんな言葉をかけないで"},
        { "location": "157/TALK"    , "narrator": "ガブリエラ", "text": "アーヤは誰にでも親切なのよ"},
        { "location": "158/TALK"    , "narrator": "ガブリエラ", "text": "新人にも"},
        { "location": "159/TALK"    , "narrator": "ガブリエラ", "text": "遅れてきた子にも"},
        { "location": "162/SEL"     , "narrator": "", "text": "いいことじゃないの"},
        { "location": "163/SEL"     , "narrator": "", "text": "そういう人いるよね"},
        { "location": "164/SEL"     , "narrator": "", "text": "やきもちだ"},
        { "location": "165/ACT"     , "narrator": "", "text": "いいことじゃないの"},
        { "location": "166/TALK"    , "narrator": "ガブリエラ", "text": "いいこと"},
        { "location": "167/TALK"    , "narrator": "ガブリエラ", "text": "なのよね"},
        { "location": "168/ACT"     , "narrator": "", "text": "そういう人いるよね"},
        { "location": "169/TALK"    , "narrator": "ガブリエラ", "text": "アーヤはそういう人なんかじゃないわ"},
        { "location": "170/TALK"    , "narrator": "ガブリエラ", "text": "ひとくくりにしないで"},
        { "location": "171/ACT"     , "narrator": "", "text": "やきもちだ"},
        { "location": "182/TALK"    , "narrator": "ガブリエラ", "text": "意地悪ね"},
        { "location": "184/TALK"    , "narrator": "ガブリエラ", "text": "マルザンナったら"},
        { "location": "188/TALK"    , "narrator": "ガブリエラ", "text": "だから時々"},
        { "location": "189/TALK"    , "narrator": "ガブリエラ", "text": "私アーヤに"},
        { "location": "190/TALK"    , "narrator": "ガブリエラ", "text": "ひどいことを言ってしまうの"},
        { "location": "192/SEL"     , "narrator": "", "text": "あー……"},
        { "location": "193/SEL"     , "narrator": "", "text": "素直になりなよ"},
        { "location": "194/SEL"     , "narrator": "", "text": "アーヤはわかってくれてるよ"},
        { "location": "195/ACT"     , "narrator": "", "text": "あー……"},
        { "location": "196/TALK"    , "narrator": "ガブリエラ", "text": "そうよね"},
        { "location": "198/TALK"    , "narrator": "ガブリエラ", "text": "私どうしてこうなのかしらね"},
        { "location": "199/ACT"     , "narrator": "", "text": "素直になりなよ"},
        { "location": "200/TALK"    , "narrator": "ガブリエラ", "text": "そんなの"},
        { "location": "201/TALK"    , "narrator": "ガブリエラ", "text": "出来たら苦労しないわ"},
        { "location": "202/ACT"     , "narrator": "", "text": "アーヤはわかってくれてるよ"},
        { "location": "204/TALK"    , "narrator": "ガブリエラ", "text": "そう"},
        { "location": "205/TALK"    , "narrator": "ガブリエラ", "text": "かしら？"},
        { "location": "206/TALK"    , "narrator": "ガブリエラ", "text": "マルザンナの言うことなら"},
        { "location": "208/TALK"    , "narrator": "ガブリエラ", "text": "信じるわ"},
        { "location": "210/TALK"    , "narrator": "ガブリエラ", "text": "知っていて？"},
        { "location": "211/TALK"    , "narrator": "ガブリエラ", "text": "剣道をしていた頃のアーヤはすごく素敵だったの"},
        { "location": "212/TALK"    , "narrator": "ガブリエラ", "text": "それを知っているから"},
        { "location": "213/TALK"    , "narrator": "ガブリエラ", "text": "余計意地悪をしてしまうのかもしれないわ"},
        { "location": "177/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>500pt.</b></color></size>\nアップしました！"}
    ]
}
