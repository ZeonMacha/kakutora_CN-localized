    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "026_それが子供の仕事"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "お休みが増えたのはいいけれど"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "みやびたちがその分忙しくなってしまったわ"},
        { "location": "35/SEL"    , "narrator": "", "text": "気にするなって言ってたよ？"},
        { "location": "36/SEL"    , "narrator": "", "text": "普通になっただけだよ"},
        { "location": "37/SEL"    , "narrator": "", "text": "取り消してもらう？"},
        { "location": "38/TALK"   , "narrator": "ガブリエラ", "text": "大丈夫だって言ってくれたけど"},
        { "location": "40/TALK"   , "narrator": "ガブリエラ", "text": "本当にそうかしら？"},
        { "location": "42/ACT"    , "narrator": "", "text": "気にするなって言ってたよ？"},
        { "location": "44/TALK"   , "narrator": "ガブリエラ", "text": "そうは言ってもらったけれど、、、"},
        { "location": "46/SEL"    , "narrator": "", "text": "言葉はそのまま受け取りなよ"},
        { "location": "47/SEL"    , "narrator": "", "text": "大丈夫だって"},
        { "location": "48/ACT"    , "narrator": "", "text": "言葉はそのまま受け取りなよ"},
        { "location": "49/TALK"   , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "50/TALK"   , "narrator": "ガブリエラ", "text": "気にしすぎるのもよくないわね"},
        { "location": "51/TALK"   , "narrator": "ガブリエラ", "text": "そうすることにするわ"},
        { "location": "52/ACT"    , "narrator": "", "text": "大丈夫だって"},
        { "location": "53/TALK"   , "narrator": "ガブリエラ", "text": "そうかしら？"},
        { "location": "54/TALK"   , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "55/TALK"   , "narrator": "ガブリエラ", "text": "気にしすぎるのもよくないわよね"},
        { "location": "57/ACT"    , "narrator": "", "text": "普通になっただけだよ"},
        { "location": "58/TALK"   , "narrator": "ガブリエラ", "text": "普通"},
        { "location": "59/TALK"   , "narrator": "ガブリエラ", "text": "これが普通なのかしら"},
        { "location": "60/TALK"   , "narrator": "ガブリエラ", "text": "だったらこれで大丈夫よね"},
        { "location": "61/TALK"   , "narrator": "ガブリエラ", "text": "ありがとう"},
        { "location": "62/ACT"    , "narrator": "", "text": "取り消してもらう？"},
        { "location": "63/TALK"   , "narrator": "ガブリエラ", "text": "それはそれでいやなのよ"},
        { "location": "65/TALK"   , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "66/TALK"   , "narrator": "ガブリエラ", "text": "もう少し入ってもいいわって言っておこうかしらね"}
    ]
}
