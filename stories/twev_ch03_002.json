        "title": "Twitter Archive 007",
        "sub_title": "卯月画廊：初詣"
    },
    "entry":
    [
        { "location": "164/TALK"  , "narrator": "透明神楽", "text": "これはお正月の時に\n描いたものですね。"},
        { "location": "166/TALK"  , "narrator": "透明神楽", "text": "皆さんの夢が叶うよう\n願掛けしながら\n描きました♪"},
        { "location": "169/TALK"  , "narrator": "透明つばめ", "text": "よかった！\nお菓子の方の絵で…。"},
        { "location": "170/TALK"  , "narrator": "透明神楽", "text": "なにが\n良かったんですか？"},
        { "location": "171/TALK"  , "narrator": "透明つばめ", "text": "えーだって、この絵だと\n普通にお菓子とか\n思い浮かべてるけど――"},
        { "location": "172/TALK"  , "narrator": "透明つばめ", "text": "最初に見せてもらった方は\n思ってもいない恥ずかしい\n絵が描かれてたから…。"},
        { "location": "174/TALK"  , "narrator": "透明神楽", "text": "変ですね…。"},
        { "location": "175/TALK"  , "narrator": "透明神楽", "text": "私の千里眼水晶球は、\n間違いなく皆さんの煩悩を\n見せてくれた筈ですが。"},
        { "location": "177/TALK"  , "narrator": "透明ガブリエラ", "text": "っていうか、どうして\nあたしの思っているものが\nタコなのよ？"},
        { "location": "178/TALK"  , "narrator": "透明神楽", "text": "だって、ガブちゃんは\nたこ焼き作るのが\n大好きじゃないですか。"},
        { "location": "179/TALK"  , "narrator": "透明神楽", "text": "きっと、千里眼水晶球は\nその想いを映し出したん\nだと思いますよ。"},
        { "location": "180/TALK"  , "narrator": "透明ガブリエラ", "text": "だとしても、たこ焼きを\nタコが笑顔で持ってる姿は\n想像してないわ。"},
        { "location": "182/TALK"  , "narrator": "透明ガブリエラ", "text": "これ、共食いでしょ？\n可愛い絵柄だけど\nかなりエグいわ…。"},
        { "location": "183/TALK"  , "narrator": "透明つばめ", "text": "あ、そっか。\nたこ焼きの中って、\nタコ入ってるもんね。"},
        { "location": "184/TALK"  , "narrator": "透明ガブリエラ", "text": "そういうこと…。\nそのなんとか水晶、\n壊れてるんじゃないの？"},
        { "location": "186/TALK"  , "narrator": "透明神楽", "text": "でも、みやびさんのは\n大正解でしたよ？"},
        { "location": "188/TALK"  , "narrator": "透明神楽", "text": "エクセレントエレガンツ、\nって褒められましたし。"},
        { "location": "189/TALK"  , "narrator": "透明つばめ", "text": "…それって、\n褒め言葉なのかな？"},
        { "location": "190/TALK"  , "narrator": "透明ガブリエラ", "text": "みやびの考えてること\nなんて、水晶使わなくても\nわかるでしょ？"},
        { "location": "191/TALK"  , "narrator": "透明ガブリエラ", "text": "普段から煩悩駄々漏れ\nしてるんだし。"},
        { "location": "192/TALK"  , "narrator": "透明ガブリエラ", "text": "っていうか、一枚目の\n絵を見た限りだと…。"},
        { "location": "193/TALK"  , "narrator": "透明ガブリエラ", "text": "神楽の煩悩を\n映し出してるだけな\n気もするんだけど？"},
        { "location": "194/TALK"  , "narrator": "透明神楽", "text": "そんなことないですよー。"},
        { "location": "195/TALK"  , "narrator": "透明神楽", "text": "その証拠に、この絵の私は\nなにも思い浮かべて\nいないですし。"},
        { "location": "197/TALK"  , "narrator": "透明つばめ", "text": "…真っ黒って、\nこれはこれでちょっと\n怖いような…。"},
        { "location": "198/TALK"  , "narrator": "透明ガブリエラ", "text": "煩悩が強過ぎて\nなんとか水晶にも\n映らなかったとか？"},
        { "location": "199/TALK"  , "narrator": "透明神楽", "text": "もぅ、さっきから私が\n煩悩塗れみたいに\n言って、酷いですよ！"},
        { "location": "200/TALK"  , "narrator": "透明ガブリエラ", "text": "一枚目の絵を見たら、\n誰でもそう思うわよ…。"},
        { "location": "202/TALK"  , "narrator": "透明ガブリエラ", "text": "でもまあ、全年齢版の\nこれなら文句はないわ。"},
        { "location": "203/TALK"  , "narrator": "透明ガブリエラ", "text": "…共食いはちょっと\n気になるけど。"},
        { "location": "204/TALK"  , "narrator": "透明神楽", "text": "はぁ…千里眼水晶球、\nもう少し精度を上げる\n必要がありますね…。"},
        { "location": "206/TALK"  , "narrator": "透明ガブリエラ", "text": "はぁ…。"},
        { "location": "208/TALK"  , "narrator": "ガブリエラ", "text": "神楽の厨二妄想だけど"},
        { "location": "209/TALK"  , "narrator": "ガブリエラ", "text": "最近更に凄くなってる気がするわ"},
        { "location": "211/TALK"  , "narrator": "ガブリエラ", "text": "千里眼水晶球とか"},
        { "location": "212/TALK"  , "narrator": "ガブリエラ", "text": "そんな単語普通すぐ出てこないわよ"},
        { "location": "213/SEL"   , "narrator": "（選択肢）", "text": "ガブリエラは言わないの？"},
        { "location": "214/SEL"   , "narrator": "（選択肢）", "text": "名前、覚えてるんだ？"},
        { "location": "215/SEL"   , "narrator": "（選択肢）", "text": "ちょっと尊敬するよね"},
        { "location": "216/ACT"   , "narrator": "", "text": "ガブリエラは言わないの？"},
        { "location": "217/TALK"  , "narrator": "ガブリエラ", "text": "言わないわ"},
        { "location": "218/TALK"  , "narrator": "ガブリエラ", "text": "だって"},
        { "location": "219/TALK"  , "narrator": "ガブリエラ", "text": "普通に恥ずかしいし"},
        { "location": "220/TALK"  , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "221/ACT"   , "narrator": "", "text": "名前、覚えてるんだ？"},
        { "location": "222/TALK"  , "narrator": "ガブリエラ", "text": "最後ので覚えたわ"},
        { "location": "223/TALK"  , "narrator": "ガブリエラ", "text": "あれだけ何度も言われればね"},
        { "location": "224/TALK"  , "narrator": "ガブリエラ", "text": "それに"},
        { "location": "225/TALK"  , "narrator": "ガブリエラ", "text": "難しい単語の羅列でもないし"},
        { "location": "226/TALK"  , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "227/ACT"   , "narrator": "", "text": "ちょっと尊敬するよね"},
        { "location": "228/TALK"  , "narrator": "ガブリエラ", "text": "認めたくないけど"},
        { "location": "229/TALK"  , "narrator": "ガブリエラ", "text": "私も同感よ"},
        { "location": "231/TALK"  , "narrator": "ガブリエラ", "text": "厨二妄想だとしても"},
        { "location": "232/TALK"  , "narrator": "ガブリエラ", "text": "それを堂々と言えるし"},
        { "location": "233/TALK"  , "narrator": "ガブリエラ", "text": "絵っていう形にするんだもの"},
        { "location": "234/TALK"  , "narrator": "ガブリエラ", "text": "その点に関しては"},
        { "location": "236/TALK"  , "narrator": "ガブリエラ", "text": "素直にスゴイと思うわ"},
        { "location": "237/SEL"   , "narrator": "（選択肢）", "text": "ガブリエラも練習しよう"},
        { "location": "238/SEL"   , "narrator": "（選択肢）", "text": "ガブリエラはそうならないでね？"},
        { "location": "239/ACT"   , "narrator": "", "text": "ガブリエラも練習しよう"},
        { "location": "240/TALK"  , "narrator": "ガブリエラ", "text": "マルザンナが私に何を求めているのか"},
        { "location": "241/TALK"  , "narrator": "ガブリエラ", "text": "わからなくなってきたわ"},
        { "location": "243/TALK"  , "narrator": "ガブリエラ", "text": "私がそんなこと"},
        { "location": "244/TALK"  , "narrator": "ガブリエラ", "text": "言うはずないでしょ？"},
        { "location": "245/SEL"   , "narrator": "（選択肢）", "text": "厨二ガブリエラ、見たかった"},
        { "location": "246/SEL"   , "narrator": "（選択肢）", "text": "マルザンナって呼ぶのもどうかと…"},
        { "location": "247/ACT"   , "narrator": "", "text": "厨二ガブリエラ、見たかった"},
        { "location": "248/TALK"  , "narrator": "ガブリエラ", "text": "見たいと思わないでちょうだい"},
        { "location": "249/TALK"  , "narrator": "ガブリエラ", "text": "そういうのが望みなら"},
        { "location": "250/TALK"  , "narrator": "ガブリエラ", "text": "神楽と話しなさいよ"},
        { "location": "251/ACT"   , "narrator": "", "text": "マルザンナって呼ぶのもどうかと…"},
        { "location": "252/TALK"  , "narrator": "ガブリエラ", "text": "まさか"},
        { "location": "254/TALK"  , "narrator": "ガブリエラ", "text": "そんなことないわ"},
        { "location": "255/TALK"  , "narrator": "ガブリエラ", "text": "これは普通よ"},
        { "location": "256/TALK"  , "narrator": "ガブリエラ", "text": "素敵なニックネームだと思うし"},
        { "location": "258/ACT"   , "narrator": "", "text": "ガブリエラはそうならないでね？"},
        { "location": "259/TALK"  , "narrator": "ガブリエラ", "text": "なる可能性があるみたいに言わないで！"},
        { "location": "260/TALK"  , "narrator": "ガブリエラ", "text": "ならないから！"},
        { "location": "262/TALK"  , "narrator": "ガブリエラ", "text": "勘違いされないうちに言っとくけど"},
        { "location": "263/TALK"  , "narrator": "ガブリエラ", "text": "私はこんなこと考えてないから"},
        { "location": "264/TALK"  , "narrator": "ガブリエラ", "text": "初詣では"},
        { "location": "265/TALK"  , "narrator": "ガブリエラ", "text": "違うこと願ったのよ？"},
        { "location": "266/SEL"   , "narrator": "（選択肢）", "text": "なにを思ってたの？"},
        { "location": "267/SEL"   , "narrator": "（選択肢）", "text": "聞かないけど、叶うといいね"},
        { "location": "268/ACT"   , "narrator": "", "text": "なにを願ったの？"},
        { "location": "269/TALK"  , "narrator": "ガブリエラ", "text": "なにって"},
        { "location": "271/TALK"  , "narrator": "ガブリエラ", "text": "この絵とは違うこと！"},
        { "location": "272/TALK"  , "narrator": "ガブリエラ", "text": "それだけ！"},
        { "location": "273/SEL"   , "narrator": "（選択肢）", "text": "教えてくれないの？"},
        { "location": "274/ACT"   , "narrator": "", "text": "教えてくれないの？"},
        { "location": "276/TALK"  , "narrator": "ガブリエラ", "text": "プライバシーだもの"},
        { "location": "277/TALK"  , "narrator": "ガブリエラ", "text": "それにね"},
        { "location": "278/TALK"  , "narrator": "ガブリエラ", "text": "願い事は他人に言ったら叶わなくなる"},
        { "location": "279/TALK"  , "narrator": "ガブリエラ", "text": "そういうでしょ？"},
        { "location": "281/TALK"  , "narrator": "ガブリエラ", "text": "マルザンナも"},
        { "location": "282/TALK"  , "narrator": "ガブリエラ", "text": "叶えたい願いは誰にも行ったらダメよ？"},
        { "location": "283/ACT"   , "narrator": "", "text": "聞かないけど、叶うといいね"},
        { "location": "285/TALK"  , "narrator": "ガブリエラ", "text": "ありがとう"},
        { "location": "287/TALK"  , "narrator": "ガブリエラ", "text": "マルザンナのそういう紳士的なとこ"},
        { "location": "288/TALK"  , "narrator": "ガブリエラ", "text": "とっても素敵だと思うわ"},
        { "location": "290/TALK"  , "narrator": "ガブリエラ", "text": "なんてね////////"},
        { "location": "294/TALK"  , "narrator": "ガブリエラ", "text": "それじゃあまたね"},
        { "location": "300/DIALOG", "narrator": "", "text": "このシナリオの元になっている\nTwitterの会話ログを見ますか？"}
    ]
}
