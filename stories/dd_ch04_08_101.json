{
    "dir": "chap08/daydra/dd_ch04_08_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "8402",
        "cid": "miyabi",
        "title": "002 メインストーリー",
        "sub_title": "大胆勝負～Case3～＜前編＞"
    },
    "entry":
    [
        { "location": "8/SCENARIO", "narrator": "", "text": "大胆勝負～Case3～"},
        { "location": "28/TALK"   , "narrator": "真幌", "text": "しかし、逢瀬と卯月が\n入隊してくれて、\n本当に助かった。"},
        { "location": "29/TALK"   , "narrator": "真幌", "text": "戦力も増え、ようやく\nひと安心といった\nところだ。"},
        { "location": "30/TALK"   , "narrator": "真幌", "text": "それに、劇場の方の\n人員も増えたし――"},
        { "location": "33/TALK"   , "narrator": "真幌", "text": "これでどうにか\nそれなりの形には\nなったな。"},
        { "location": "35/TALK"   , "narrator": "みやび", "text": "ちゅうか、まほさん。\n前から疑問だったが\nですけんど――"},
        { "location": "37/TALK"   , "narrator": "みやび", "text": "うちらがここの\nバイトする必要、\nあるがですか？"},
        { "location": "39/TALK"   , "narrator": "真幌", "text": "営業してない劇場に、\n年頃の女子が\n集まるのか？"},
        { "location": "40/TALK"   , "narrator": "真幌", "text": "どう考えても\n目立つし、噂にも\nなるだろ。"},
        { "location": "42/TALK"   , "narrator": "みやび", "text": "なら、バイトなんぞ\nさせないで――"},
        { "location": "43/TALK"   , "narrator": "みやび", "text": "自由にさせて\nくれればいいじゃ\nないですか。"},
        { "location": "46/TALK"   , "narrator": "真幌", "text": "ある程度の人数を、\nいつも決まった場所に\n集めておいた方が――"},
        { "location": "47/TALK"   , "narrator": "真幌", "text": "急な出動の時に\n困らないだろ。"},
        { "location": "51/TALK"   , "narrator": "みやび", "text": "…まあ、そんな理由\nだとは思うてました\nけんどね。"},
        { "location": "52/TALK"   , "narrator": "みやび", "text": "とりあえず、劇場の\n人員が増えたことには\n違いないき――"},
        { "location": "53/TALK"   , "narrator": "みやび", "text": "そこは素直に\n喜んでおくか。"},
        { "location": "54/TALK"   , "narrator": "みやび", "text": "…………。"},
        { "location": "55/TALK"   , "narrator": "みやび", "text": "ところで、まほさん。\nつばめちゃんのこと\nですけんど――"},
        { "location": "56/TALK"   , "narrator": "みやび", "text": "あの子、このまま\nうちにいても平気なが\nですか？"},
        { "location": "57/TALK"   , "narrator": "真幌", "text": "どういう意味だ？"},
        { "location": "58/TALK"   , "narrator": "みやび", "text": "あの子、意外と\n危なっかしい\nドジッ子さんやき――"},
        { "location": "59/TALK"   , "narrator": "みやび", "text": "トライナリーとして\n戦いに出すんは、\n危険と思うがですよ。"},
        { "location": "60/TALK"   , "narrator": "真幌", "text": "ふむ…まあ、おまえの\n心配はわからなくも\nないな。"},
        { "location": "61/TALK"   , "narrator": "真幌", "text": "私も、今日の戦闘での\n活躍を見るまでは、\n少々不安だった。"},
        { "location": "62/TALK"   , "narrator": "みやび", "text": "…………。"},
        { "location": "65/TALK"   , "narrator": "真幌", "text": "まあ、それを抜きに\nしても――"},
        { "location": "66/TALK"   , "narrator": "真幌", "text": "あいつはトライ\nガジェットの所持者\nだからな。"},
        { "location": "67/TALK"   , "narrator": "真幌", "text": "戦う力がある以上、\n戦闘には出てもら\nわんと困るんだよ。"},
        { "location": "69/TALK"   , "narrator": "みやび", "text": "…それ言うたら、\nあれですか？"},
        { "location": "70/TALK"   , "narrator": "みやび", "text": "トライガジェットを\n持っちょるんが――"},
        { "location": "71/TALK"   , "narrator": "みやび", "text": "赤ん坊や婆ちゃん\nでも、スカウトする\nゆうことですか？"},
        { "location": "73/TALK"   , "narrator": "真幌", "text": "…当然だ。"},
        { "location": "75/TALK"   , "narrator": "みやび", "text": "なっ！？"},
        { "location": "77/TALK"   , "narrator": "真幌", "text": "コネクトが出来れば、\nそれが赤子だろうが\n老人だろうが――"},
        { "location": "78/TALK"   , "narrator": "真幌", "text": "戦う力を得られる\nということなの\nだからな。"},
        { "location": "80/TALK"   , "narrator": "みやび", "text": "…………。"},
        { "location": "81/TALK"   , "narrator": "真幌", "text": "…ふっ。"},
        { "location": "82/TALK"   , "narrator": "真幌", "text": "まあ、だからといって\n赤子を戦場に出す気は\nないがな。"},
        { "location": "83/TALK"   , "narrator": "真幌", "text": "力を得ても、\n言葉も喋れない\nような状態では――"},
        { "location": "84/TALK"   , "narrator": "真幌", "text": "戦うことなどできん\nだろうからな。"},
        { "location": "86/TALK"   , "narrator": "みやび", "text": "…ですね。\nそれ聞いてちくっと\n安心しました。"},
        { "location": "88/TALK"   , "narrator": "真幌", "text": "まあ、逢瀬と卯月に\n関していえば、\n何も問題はないさ。"},
        { "location": "90/TALK"   , "narrator": "みやび", "text": "…つばめちゃんの、\nあの謎の力のことに\nついては？"},
        { "location": "93/TALK"   , "narrator": "真幌", "text": "現時点では管理庁も、\nあの力がどういった\nものかについて――"},
        { "location": "94/TALK"   , "narrator": "真幌", "text": "明確な答えを\n出せていない。"},
        { "location": "95/TALK"   , "narrator": "真幌", "text": "なので、その件は\n私に一任されている\n状況だ。"},
        { "location": "97/TALK"   , "narrator": "みやび", "text": "…で、まほさんと\nしてはどう思うてるが\nですか？"},
        { "location": "99/TALK"   , "narrator": "真幌", "text": "…ここだけの話では\nあるが――"},
        { "location": "100/TALK"  , "narrator": "真幌", "text": "正直、若干ではあるが\n危険視はしている。"},
        { "location": "101/TALK"  , "narrator": "真幌", "text": "だが、それを理由に\n入隊させないのも、\n不安ではある。"},
        { "location": "102/TALK"  , "narrator": "真幌", "text": "今まで確認された\nことのない、恐るべき\n力だからな。"},
        { "location": "103/TALK"  , "narrator": "真幌", "text": "なので、手元に置いて\nおくのが一番安心だと\n判断した。"},
        { "location": "105/TALK"  , "narrator": "みやび", "text": "…なるほど。\nそうですか。"},
        { "location": "107/TALK"  , "narrator": "みやび", "text": "まほさんの言うてる\nことも、わからなくは\nないな。"},
        { "location": "108/TALK"  , "narrator": "みやび", "text": "放置は危険やき、\n手元に置くっちゅう\nのも納得や。"},
        { "location": "109/TALK"  , "narrator": "みやび", "text": "けんど…逆に言うたら\n何かあればうちらは\n大ピンチや。"},
        { "location": "110/TALK"  , "narrator": "みやび", "text": "あの強力な力が\n暴走なんぞしてみぃ。"},
        { "location": "111/TALK"  , "narrator": "みやび", "text": "トライナリーが\n一発で壊滅っちゅう\nこともありえる。"},
        { "location": "112/TALK"  , "narrator": "みやび", "text": "それがわかっちょらん\nはずもないし。\nだとすると――"},
        { "location": "113/TALK"  , "narrator": "みやび", "text": "大丈夫だっちゅう、\n確証がある…？"},
        { "location": "114/TALK"  , "narrator": "みやび", "text": "やはり、逢瀬つばめは\nうちらを内部から\n監視する――"},
        { "location": "115/TALK"  , "narrator": "みやび", "text": "スパイっちゅう\n可能性は高いな…。"},
        { "location": "116/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "117/TALK"  , "narrator": "真幌", "text": "なんだ？\nまだ何かあるのか？"},
        { "location": "118/TALK"  , "narrator": "みやび", "text": "…カマかけてみるか。"},
        { "location": "120/TALK"  , "narrator": "みやび", "text": "実はまほさん。\nうち、あの力のこと\nなんですけんど――"},
        { "location": "121/TALK"  , "narrator": "みやび", "text": "もしかしたら、\n解明できるかも\nしれないがですよ。"},
        { "location": "122/TALK"  , "narrator": "真幌", "text": "…どういうことだ？"},
        { "location": "124/TALK"  , "narrator": "みやび", "text": "前に、うちが管理庁の\nサーバーにハッキング\nした時に――"},
        { "location": "125/TALK"  , "narrator": "みやび", "text": "怪しいデータを\n引っ張って来たが\nです。"},
        { "location": "127/TALK"  , "narrator": "みやび", "text": "そのデータが、\nどうもつばめちゃんの\nあの力に関する――"},
        { "location": "128/TALK"  , "narrator": "みやび", "text": "秘密ファイルっぽい\n内容みたいながです。"},
        { "location": "129/TALK"  , "narrator": "真幌", "text": "マジか！？"},
        { "location": "130/TALK"  , "narrator": "真幌", "text": "そんな物が管理庁の\nサーバーにあったと\nいうのか！？"},
        { "location": "131/TALK"  , "narrator": "みやび", "text": "驚きましたけんどね。"},
        { "location": "133/TALK"  , "narrator": "真幌", "text": "なんてこった…。\nもしそのファイルが\n本物なら――"},
        { "location": "134/TALK"  , "narrator": "真幌", "text": "管理庁は、我々現場に\n隠し事をしていた\nということになるぞ。"},
        { "location": "136/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "137/TALK"  , "narrator": "みやび", "text": "まあ、\nそうなりますね。"},
        { "location": "138/TALK"  , "narrator": "真幌", "text": "うーん…そのデータが\nもし本物だったら――"},
        { "location": "139/TALK"  , "narrator": "真幌", "text": "上と揉めんといけない\nことになりそうだ…。"},
        { "location": "140/TALK"  , "narrator": "真幌", "text": "はぁ…面倒なことに\nならんといいが…。"},
        { "location": "141/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "143/TALK"  , "narrator": "真幌", "text": "しかし、もしそれが\n本物だとしておまえが\n解析を進め――"},
        { "location": "144/TALK"  , "narrator": "真幌", "text": "あの力の正体を\n解明すれば、\n大手柄間違いなしだ。"},
        { "location": "145/TALK"  , "narrator": "真幌", "text": "その調子で、解析を\n進めてくれ。"},
        { "location": "147/TALK"  , "narrator": "みやび", "text": "…わかりました。"},
        { "location": "148/TALK"  , "narrator": "みやび", "text": "…まほさんは\n白のようやな。"},
        { "location": "149/TALK"  , "narrator": "みやび", "text": "真面目モードにも\nならんで、\n素で驚いちょるし。"},
        { "location": "151/TALK"  , "narrator": "みやび", "text": "だとすると、他に\nつばめちゃんが――"},
        { "location": "152/TALK"  , "narrator": "みやび", "text": "スパイだと\n証明する方法は…。"},
        { "location": "196/TALK"  , "narrator": "みやび", "text": "……　…"},
        { "location": "210/TALK"  , "narrator": "みやび", "text": "ぶひ"},
        { "location": "214/TALK"  , "narrator": "みやび", "text": "ぶひ"},
        { "location": "218/TALK"  , "narrator": "みやび", "text": "ぶひ"},
        { "location": "226/TALK"  , "narrator": "みやび", "text": "引っかかったーっ！"},
        { "location": "227/SEL"   , "narrator": "", "text": "……は？"},
        { "location": "228/ACT"   , "narrator": "", "text": "……は？"},
        { "location": "232/TALK"  , "narrator": "みやび", "text": "うちがいつも寝ちゅうと\n思うちょったら\n大間違いや！"},
        { "location": "234/TALK"  , "narrator": "みやび", "text": "引っ掛けてやろうと思うて\nずっと起きちょったんよ？"},
        { "location": "235/SEL"   , "narrator": "", "text": "……ヒマなの？"},
        { "location": "236/SEL"   , "narrator": "", "text": "これは一本取られましたな"},
        { "location": "237/ACT"   , "narrator": "", "text": "……ヒマなの？"},
        { "location": "238/TALK"  , "narrator": "みやび", "text": "うむ。\n大変ヒマ。"},
        { "location": "239/ACT"   , "narrator": "", "text": "これは一本取られましたな"},
        { "location": "240/TALK"  , "narrator": "みやび", "text": "ふむ。\n気が済んだ。"},
        { "location": "242/SEL"   , "narrator": "", "text": "そしたら仕事してください"},
        { "location": "243/ACT"   , "narrator": "", "text": "そしたら仕事してください"},
        { "location": "245/TALK"  , "narrator": "みやび", "text": "まあ、しゃーないな。\n職場放棄をするつもりは\nないし。"},
        { "location": "248/TALK"  , "narrator": "みやび", "text": "さて、と。\n今回はどんなクランが\n蔓延っちょるんかね、と。"},
        { "location": "253/TALK"  , "narrator": "みやび", "text": "オープンプロセス、\n0x112番地から\n0x95D番地へ。"},
        { "location": "268/TALK"  , "narrator": "みやび", "text": "完了。"},
        { "location": "270/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "272/TALK"  , "narrator": "みやび", "text": "………。"},
        { "location": "273/TALK"  , "narrator": "みやび", "text": "あー、なるほど。"},
        { "location": "274/TALK"  , "narrator": "みやび", "text": "うち、なんか\n焦っちゅうんかね。"},
        { "location": "275/SEL"   , "narrator": "", "text": "どういうこと？"},
        { "location": "276/ACT"   , "narrator": "", "text": "どういうこと？"},
        { "location": "278/TALK"  , "narrator": "みやび", "text": "ココロファイルナンバー\n04-154-77を見るとなぁ。"},
        { "location": "279/TALK"  , "narrator": "みやび", "text": "まだつばめちゃんが\nスパイやとか確定する前に\n黒と決めつけちゅう。"},
        { "location": "280/TALK"  , "narrator": "みやび", "text": "このまま暴走しゆうと\nちょっと面倒なことに\nなりそうやね。"},
        { "location": "281/TALK"  , "narrator": "みやび", "text": "まあ、きっかけが何かは\nうちには判らんけんど、\nマジに対処が必要かと。"},
        { "location": "282/SEL"   , "narrator": "", "text": "クランを倒せばいい？"},
        { "location": "283/ACT"   , "narrator": "", "text": "クランを倒せばいい？"},
        { "location": "285/TALK"  , "narrator": "みやび", "text": "うむ。\nその通りや。"},
        { "location": "286/TALK"  , "narrator": "みやび", "text": "何か焦る要因になっちゅう\nクランを倒して、うちを\n冷静にしてや。"},
        { "location": "287/TALK"  , "narrator": "みやび", "text": "しっかし、あれやね。"},
        { "location": "288/TALK"  , "narrator": "みやび", "text": "うちも一旦火がつくと\nかなり視野が狭くなるき。"},
        { "location": "289/TALK"  , "narrator": "みやび", "text": "クランを生みやすい\n性格なんかねぇ。"},
        { "location": "290/TALK"  , "narrator": "みやび", "text": "何にしても、\nよろしゅうね。"},
        { "location": "292/TALK"  , "narrator": "みやび", "text": "うちと$handle$に\nえいココロの旅を！"},
        { "location": "26/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>5月9日　7:01 PM</color>\n高校でのフェノメノン戦の後、神楽坂トライナリー劇場ホワイエにて。"},
        { "location": "164/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "201/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "223/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"}
    ]
}
