    "entry":
    [
        { "location": "67/SCENARIO", "narrator": "", "text": "004_慣れたりするかしら"},
        { "location": "92/TALK"    , "narrator": "ガブリエラ", "text": "やっぱり"},
        { "location": "93/TALK"    , "narrator": "ガブリエラ", "text": "慣れないわ"},
        { "location": "94/TALK"    , "narrator": "ガブリエラ", "text": "つばめにギャヴィとか呼ばれるの"},
        { "location": "97/SEL"     , "narrator": "", "text": "どうして？"},
        { "location": "98/SEL"     , "narrator": "", "text": "そんなに嫌いなの？"},
        { "location": "99/SEL"     , "narrator": "", "text": "ずっと先輩でいいの？"},
        { "location": "100/ACT"    , "narrator": "", "text": "どうして？"},
        { "location": "102/TALK"   , "narrator": "ガブリエラ", "text": "マルザンナに言われるのは嫌じゃないわ"},
        { "location": "103/TALK"   , "narrator": "ガブリエラ", "text": "変にも思わないし"},
        { "location": "104/TALK"   , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "105/TALK"   , "narrator": "ガブリエラ", "text": "つばめに言われるのは何だか違うのよ"},
        { "location": "106/TALK"   , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "107/TALK"   , "narrator": "ガブリエラ", "text": "距離感？"},
        { "location": "108/TALK"   , "narrator": "ガブリエラ", "text": "上手く言えないわ"},
        { "location": "109/TALK"   , "narrator": "ガブリエラ", "text": "でもそう思うのよ"},
        { "location": "110/ACT"    , "narrator": "", "text": "そんなに嫌いなの？"},
        { "location": "113/TALK"   , "narrator": "ガブリエラ", "text": "嫌いっていうか"},
        { "location": "114/TALK"   , "narrator": "ガブリエラ", "text": "気に入らないっていうか"},
        { "location": "115/TALK"   , "narrator": "ガブリエラ", "text": "なんなのかしら？"},
        { "location": "116/TALK"   , "narrator": "ガブリエラ", "text": "あの違和感"},
        { "location": "117/TALK"   , "narrator": "ガブリエラ", "text": "とにかくなんだか無理なのよ"},
        { "location": "118/TALK"   , "narrator": "ガブリエラ", "text": "せんぱいが一番ましだわ"},
        { "location": "119/ACT"    , "narrator": "", "text": "ずっと先輩でいいの？"},
        { "location": "121/TALK"   , "narrator": "ガブリエラ", "text": "やっぱり"},
        { "location": "122/TALK"   , "narrator": "ガブリエラ", "text": "よくはないのかしら"},
        { "location": "126/TALK"   , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "127/TALK"   , "narrator": "ガブリエラ", "text": "それ以上にいいのが思いつかないの"},
        { "location": "128/TALK"   , "narrator": "ガブリエラ", "text": "だから"},
        { "location": "129/TALK"   , "narrator": "ガブリエラ", "text": "仕方ないと思うのよ"},
        { "location": "130/TALK"   , "narrator": "ガブリエラ", "text": "そう"},
        { "location": "131/TALK"   , "narrator": "ガブリエラ", "text": "仕方ないわ"}
    ]
}
