    [
        { "location": "90/SCENARIO", "narrator": "", "text": "035_指先にバニラ"},
        { "location": "115/TALK"   , "narrator": "ガブリエラ", "text": "アーヤがこっそり"},
        { "location": "116/TALK"   , "narrator": "ガブリエラ", "text": "プリンを二種類作っていたのよ"},
        { "location": "117/TALK"   , "narrator": "ガブリエラ", "text": "少しショックだわ"},
        { "location": "119/SEL"    , "narrator": "", "text": "もらえなかったの？"},
        { "location": "120/SEL"    , "narrator": "", "text": "味比べすればいいんじゃない？"},
        { "location": "121/SEL"    , "narrator": "", "text": "$me$が今度作ってあげるから"},
        { "location": "122/ACT"    , "narrator": "", "text": "もらえなかったの？"},
        { "location": "123/TALK"   , "narrator": "ガブリエラ", "text": "もらえたわ"},
        { "location": "124/TALK"   , "narrator": "ガブリエラ", "text": "もらえたんだけど"},
        { "location": "125/ACT"    , "narrator": "", "text": "味比べすればいいんじゃない？"},
        { "location": "126/TALK"   , "narrator": "ガブリエラ", "text": "それがね"},
        { "location": "127/TALK"   , "narrator": "ガブリエラ", "text": "そういうわけにはいかなかったのよ"},
        { "location": "128/ACT"    , "narrator": "", "text": "$me$が今度作ってあげるから"},
        { "location": "130/TALK"   , "narrator": "ガブリエラ", "text": "ありがとうｖｖｖｖｖ"},
        { "location": "131/TALK"   , "narrator": "ガブリエラ", "text": "$marzanna$の作ったプリン"},
        { "location": "133/TALK"   , "narrator": "ガブリエラ", "text": "きっとおいしいわよねｖｖｖｖ"},
        { "location": "135/TALK"   , "narrator": "ガブリエラ", "text": "アーヤが作ったプリンは"},
        { "location": "136/TALK"   , "narrator": "ガブリエラ", "text": "香りづけにバニラエッセンスを使ったプリンと"},
        { "location": "137/TALK"   , "narrator": "ガブリエラ", "text": "ラム酒を使ったプリンだったの"},
        { "location": "139/SEL"    , "narrator": "", "text": "へえ"},
        { "location": "140/SEL"    , "narrator": "", "text": "どっちもおいしそう"},
        { "location": "141/SEL"    , "narrator": "", "text": "大人味プリンだ"},
        { "location": "142/ACT"    , "narrator": "", "text": "へえ"},
        { "location": "143/TALK"   , "narrator": "ガブリエラ", "text": "それでね"},
        { "location": "144/ACT"    , "narrator": "", "text": "どっちもおいしそう"},
        { "location": "145/TALK"   , "narrator": "ガブリエラ", "text": "そうなのよ"},
        { "location": "146/ACT"    , "narrator": "", "text": "大人味プリンだ"},
        { "location": "147/TALK"   , "narrator": "ガブリエラ", "text": "ラム酒の方はね"},
        { "location": "149/TALK"   , "narrator": "ガブリエラ", "text": "それでね"},
        { "location": "150/TALK"   , "narrator": "ガブリエラ", "text": "ラム酒の方は子供にはまだ早いって"},
        { "location": "151/TALK"   , "narrator": "ガブリエラ", "text": "私はもらえなかったの"},
        { "location": "152/TALK"   , "narrator": "ガブリエラ", "text": "だったら作らなきゃいいのにって"},
        { "location": "153/TALK"   , "narrator": "ガブリエラ", "text": "思ってしまったのよ"},
        { "location": "156/TALK"   , "narrator": "ガブリエラ", "text": "そのくらいで酔うわけないのにね"},
        { "location": "158/TALK"   , "narrator": "ガブリエラ", "text": "心配性なんだから"}
    ]
}
