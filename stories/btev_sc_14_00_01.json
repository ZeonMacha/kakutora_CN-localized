        "title": "【EXストーリー】すうぃーとアイドル",
        "sub_title": "コネクトストーリー"
    },
    "entry":
    [
        { "location": "342/SCENARIO", "narrator": "", "text": "【導入】楓雅"},
        { "location": "348/DIALOG"  , "narrator": "", "text": "<size=40>CURAN STORY. 01</size>\nTSUBAME OHSE\n\n<size=45>立花清実</size>\n<size=35>～かわいいだけでいいじゃない？～</size>"},
        { "location": "364/TALK"    , "narrator": "ガブリエラ", "text": "やっと来たわね。\n待ちくたびれたわ、\n$handle$。"},
        { "location": "365/TALK"    , "narrator": "ガブリエラ", "text": "ここはね。私たち\nトライナリーと、\nクランたちとの交差点。"},
        { "location": "366/TALK"    , "narrator": "ガブリエラ", "text": "ココロとココロが\n出逢って、共鳴して、\n最後に繋がりあう場所。"},
        { "location": "374/SEL"     , "narrator": "（選択肢）", "text": "概要説明を飛ばす"},
        { "location": "375/SEL"     , "narrator": "（選択肢）", "text": "もう一度聞く"},
        { "location": "376/ACT"     , "narrator": "", "text": "概要説明を飛ばす"},
        { "location": "377/TALK"    , "narrator": "ガブリエラ", "text": "というわけで、\n早速今回のクランを\n紹介するわ。"},
        { "location": "379/ACT"     , "narrator": "", "text": "もう一度聞く"},
        { "location": "384/TALK"    , "narrator": "ガブリエラ", "text": "ここでは、普段私たちを\n助けてくれるサーバント\nクランを紹介するの。"},
        { "location": "385/TALK"    , "narrator": "ガブリエラ", "text": "そして、貴方が直接\n彼女たちと繋がれる\nように手続きをする場所。"},
        { "location": "386/SEL"     , "narrator": "（選択肢）", "text": "アニメに出てくるクランを\n使えるようになるってことかな？"},
        { "location": "387/ACT"     , "narrator": "", "text": "アニメに出てくるクランを\n使えるようになるってことかな？"},
        { "location": "389/TALK"    , "narrator": "ガブリエラ", "text": "そうね。\n理解が早いわね、\n$handle$は。"},
        { "location": "390/TALK"    , "narrator": "ガブリエラ", "text": "このセクターでは、\nクラン一人にスポットを\n当てて紹介するわ。"},
        { "location": "391/TALK"    , "narrator": "ガブリエラ", "text": "そして彼女との【儀式】\nによって、貴方とココロを\n繋げるの。"},
        { "location": "392/TALK"    , "narrator": "ガブリエラ", "text": "【儀式】には『コネクト』\nと『シンクロ』の２つが\nあるわ。"},
        { "location": "393/TALK"    , "narrator": "ガブリエラ", "text": "『コネクト』は、貴方と\nクランが物理的に繋がる\nための儀式なのよ。"},
        { "location": "394/TALK"    , "narrator": "ガブリエラ", "text": "これは、バトルをする事で\n彼女と貴方の中にある、\n抵抗勢力を無力化する。"},
        { "location": "395/TALK"    , "narrator": "ガブリエラ", "text": "次の『シンクロ』では、\nクランの過去を知り、\n共感しなさい。"},
        { "location": "396/TALK"    , "narrator": "ガブリエラ", "text": "クランの過去の\n物語をシェアすることで、\n心が通うようになるわ。"},
        { "location": "397/TALK"    , "narrator": "ガブリエラ", "text": "ここまで、\n大丈夫かしら。"},
        { "location": "398/TALK"    , "narrator": "ガブリエラ", "text": "もし、入るセクターを\n間違えたならば\n今からでも退場できてよ。"},
        { "location": "399/SEL"     , "narrator": "（選択肢）", "text": "大丈夫、先に進んで"},
        { "location": "400/SEL"     , "narrator": "（選択肢）", "text": "間違えたから退場する"},
        { "location": "401/SEL"     , "narrator": "（選択肢）", "text": "なんでそんな女王様っぽいの？"},
        { "location": "402/ACT"     , "narrator": "", "text": "大丈夫、先に進んで"},
        { "location": "403/TALK"    , "narrator": "ガブリエラ", "text": "いいのね？\nじゃあ、今回の\nクランを紹介するわ。"},
        { "location": "404/ACT"     , "narrator": "", "text": "間違えたから退場する"},
        { "location": "405/TALK"    , "narrator": "ガブリエラ", "text": "え、\n何なのよそれ！？"},
        { "location": "406/TALK"    , "narrator": "ガブリエラ", "text": "じゃあさっさと\n出て行きなさい。"},
        { "location": "408/TALK"    , "narrator": "ガブリエラ", "text": "でも、\n気が変わったら。"},
        { "location": "409/TALK"    , "narrator": "ガブリエラ", "text": "いつでも来て\nいいのよ。"},
        { "location": "410/TALK"    , "narrator": "ガブリエラ", "text": "$handle$さんと\nあたしに、\n素敵なココロの旅を。"},
        { "location": "412/ACT"     , "narrator": "", "text": "なんでそんな女王様っぽいの？"},
        { "location": "413/TALK"    , "narrator": "ガブリエラ", "text": "別に。\n理由なんて\nなくてよ。"},
        { "location": "415/TALK"    , "narrator": "ガブリエラ", "text": "でもクランとの\n【儀式】は友達に\nなるのとは違うもの。"},
        { "location": "416/TALK"    , "narrator": "ガブリエラ", "text": "真面目にすれば\n自然とこうなる\nものでしょう？"},
        { "location": "417/TALK"    , "narrator": "ガブリエラ", "text": "むしろ\n$handle$も\n改まるべきだわ。"},
        { "location": "418/TALK"    , "narrator": "ガブリエラ", "text": "そんなことより。\n今回のクランを\n紹介してよ。"},
        { "location": "427/TALK"    , "narrator": "ガブリエラ", "text": "オープンプロセス、\n0x191番地から\n0xFFF番地へ。"},
        { "location": "428/TALK"    , "narrator": "ガブリエラ", "text": "共通意識野を経由、\n外部スフィアへ接続。"},
        { "location": "429/TALK"    , "narrator": "ガブリエラ", "text": "EXEC_SEEK_SECTOR\n=>Link() EXT_SPHERE/."},
        { "location": "454/TALK"    , "narrator": "ガブリエラ", "text": "シーク完了ね。"},
        { "location": "455/TALK"    , "narrator": "ガブリエラ", "text": "さて――。"},
        { "location": "456/TALK"    , "narrator": "ガブリエラ", "text": "今回、貴方に\n紹介するクランは\n<color=red>【楓雅】</color>。"},
        { "location": "460/TALK"    , "narrator": "ガブリエラ", "text": "発症する前の名前は\n立花清実、１７歳。"},
        { "location": "461/TALK"    , "narrator": "ガブリエラ", "text": "ココロファイルナンバー\nE01-004-19によると、\n発症の原因は……"},
        { "location": "462/TALK"    , "narrator": "ガブリエラ", "text": "社会的通念と\n自己アイデンティティの\n相違。"},
        { "location": "463/TALK"    , "narrator": "ガブリエラ", "text": "なんて言うと\nすごく難しい\n話みたいだわね。"},
        { "location": "464/TALK"    , "narrator": "ガブリエラ", "text": "ざっくり言うと\n男の娘の自分を\n認めてほしかった。"},
        { "location": "467/TALK"    , "narrator": "ガブリエラ", "text": "ふうがの見た目は\n並の女の子より\nよっぽどかわいいわ。"},
        { "location": "468/TALK"    , "narrator": "ガブリエラ", "text": "それなのに両親は\n大反対。タレントの\n夢も潰えた。"},
        { "location": "469/TALK"    , "narrator": "ガブリエラ", "text": "絶望と怒りが\nふうがという\nクランを生んだの。"},
        { "location": "470/SEL"     , "narrator": "（選択肢）", "text": "むしろ萌えるのに"},
        { "location": "471/SEL"     , "narrator": "（選択肢）", "text": "隠れて続ければよかったのに"},
        { "location": "472/ACT"     , "narrator": "", "text": "むしろ萌えるのに"},
        { "location": "473/TALK"    , "narrator": "ガブリエラ", "text": "そうよね…。"},
        { "location": "474/TALK"    , "narrator": "ガブリエラ", "text": "ふうがの身近にいる人が\n一人でもそう言って\nあげられていれば。"},
        { "location": "475/TALK"    , "narrator": "ガブリエラ", "text": "また違った道が\nあったかも\nしれなくてよ。"},
        { "location": "476/ACT"     , "narrator": "", "text": "隠れて続ければよかったのに"},
        { "location": "477/TALK"    , "narrator": "ガブリエラ", "text": "隠れるにも\n限界があるわ。"},
        { "location": "478/TALK"    , "narrator": "ガブリエラ", "text": "それに本当の自分を\n知って欲しいと思うのは\n当然じゃないこと？"},
        { "location": "480/TALK"    , "narrator": "ガブリエラ", "text": "理解は難しくても\n全部が間違ってるとは\n言えないと思うわ。"},
        { "location": "481/SEL"     , "narrator": "（選択肢）", "text": "ガブリエラは\nそこに共感したんだ"},
        { "location": "482/SEL"     , "narrator": "（選択肢）", "text": "だからガブリエラが仕切ってるんだ"},
        { "location": "483/ACT"     , "narrator": "", "text": "ガブリエラは\nそこに共感したんだ"},
        { "location": "484/TALK"    , "narrator": "ガブリエラ", "text": "それだけじゃないわ。\nあたしと相性が\nいい理由は。"},
        { "location": "485/ACT"     , "narrator": "", "text": "だからガブリエラが仕切ってるんだ"},
        { "location": "487/TALK"    , "narrator": "ガブリエラ", "text": "結果的に一番\n相性のいい\nクランの一人だわね。"},
        { "location": "489/TALK"    , "narrator": "ガブリエラ", "text": "そして\n$handle$。"},
        { "location": "490/TALK"    , "narrator": "ガブリエラ", "text": "貴方は【ふうが】と\n『コネクト』の\nプロセスを行いなさい。"},
        { "location": "491/TALK"    , "narrator": "ガブリエラ", "text": "ふうがの抵抗する\n意思と戦って\n勝ちなさい。"},
        { "location": "492/TALK"    , "narrator": "ガブリエラ", "text": "そうすれば【ふうが】と\n『シンクロ』することが\nできるようになるわ。"},
        { "location": "493/TALK"    , "narrator": "ガブリエラ", "text": "『コネクト』と\n『シンクロ』が\n完了すれば。"},
        { "location": "494/TALK"    , "narrator": "ガブリエラ", "text": "晴れて【ふうが】が\n使えるように\nなってよ。"},
        { "location": "495/SEL"     , "narrator": "（選択肢）", "text": "とりあえずやってみる"},
        { "location": "496/SEL"     , "narrator": "（選択肢）", "text": "ガブリエラとはコネクトできないの？"},
        { "location": "497/ACT"     , "narrator": "", "text": "とりあえずやってみる"},
        { "location": "498/TALK"    , "narrator": "ガブリエラ", "text": "そうね。\n勝ちなさい、\n$handle$。"},
        { "location": "500/TALK"    , "narrator": "ガブリエラ", "text": "アクセス開始。\n$handle$に\n素敵なココロの旅を！"},
        { "location": "501/ACT"     , "narrator": "", "text": "ガブリエラとはコネクトできないの？"},
        { "location": "502/TALK"    , "narrator": "ガブリエラ", "text": "そういう場所じゃ\nないわ。"},
        { "location": "503/TALK"    , "narrator": "ガブリエラ", "text": "でも勝つことが\nできたなら。"},
        { "location": "504/TALK"    , "narrator": "ガブリエラ", "text": "あたしの秘密を\n少しだけ\n教えてあげてよ。"},
        { "location": "505/TALK"    , "narrator": "ガブリエラ", "text": "だから\n勝ちなさい、\n$handle$。"},
        { "location": "507/TALK"    , "narrator": "ガブリエラ", "text": "アクセス開始。\n$handle$に\n素敵なココロの旅を！"}
    ]
}
