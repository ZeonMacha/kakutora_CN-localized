    "entry":
    [
        { "location": "77/SCENARIO", "narrator": "", "text": "035_クラムボン殺人事件"},
        { "location": "102/TALK"   , "narrator": "アーヤ", "text": "クラムボンはわらったよ。"},
        { "location": "103/TALK"   , "narrator": "アーヤ", "text": "クラムボンはかぷかぷわらったよ。"},
        { "location": "105/SEL"    , "narrator": "", "text": "かぷかぷ？"},
        { "location": "106/SEL"    , "narrator": "", "text": "暑さで壊れた？"},
        { "location": "107/SEL"    , "narrator": "", "text": "宮沢賢治「やまなし」"},
        { "location": "108/ACT"    , "narrator": "", "text": "かぷかぷ？"},
        { "location": "109/TALK"   , "narrator": "アーヤ", "text": "そうよ"},
        { "location": "111/TALK"   , "narrator": "アーヤ", "text": "かぷかぷ笑うの"},
        { "location": "112/ACT"    , "narrator": "", "text": "暑さで壊れた？"},
        { "location": "113/TALK"   , "narrator": "アーヤ", "text": "違うわよ"},
        { "location": "114/TALK"   , "narrator": "アーヤ", "text": "文学作品よ"},
        { "location": "115/ACT"    , "narrator": "", "text": "宮沢賢治「やまなし」"},
        { "location": "117/TALK"   , "narrator": "アーヤ", "text": "そう"},
        { "location": "118/TALK"   , "narrator": "アーヤ", "text": "懐かしいでしょ"},
        { "location": "119/TALK"   , "narrator": "アーヤ", "text": "小学校で習ったわよね"},
        { "location": "121/TALK"   , "narrator": "アーヤ", "text": "この先でクラムボンは死んでしまうけど"},
        { "location": "122/TALK"   , "narrator": "アーヤ", "text": "これって殺人なのよね"},
        { "location": "123/TALK"   , "narrator": "アーヤ", "text": "事件の匂いがするわ"},
        { "location": "125/SEL"    , "narrator": "", "text": "事件……だっけ？"},
        { "location": "126/SEL"    , "narrator": "", "text": "やっぱり暑さにやられてるよね"},
        { "location": "127/SEL"    , "narrator": "", "text": "$me$は命をかけてアーヤを守るよ"},
        { "location": "128/ACT"    , "narrator": "", "text": "事件……だっけ？"},
        { "location": "129/TALK"   , "narrator": "アーヤ", "text": "そうよ"},
        { "location": "130/TALK"   , "narrator": "アーヤ", "text": "殺されたのに理由がわからないのよ"},
        { "location": "131/TALK"   , "narrator": "アーヤ", "text": "このままじゃ迷宮入りよ"},
        { "location": "132/TALK"   , "narrator": "アーヤ", "text": "解決に向けて動かなきゃだわ"},
        { "location": "133/TALK"   , "narrator": "アーヤ", "text": "頼んだわよ"},
        { "location": "134/ACT"    , "narrator": "", "text": "やっぱり暑さにやられてるよね"},
        { "location": "135/TALK"   , "narrator": "アーヤ", "text": "確かに厚いけど"},
        { "location": "137/TALK"   , "narrator": "アーヤ", "text": "暑いけど"},
        { "location": "138/TALK"   , "narrator": "アーヤ", "text": "そうじゃないわよ"},
        { "location": "139/TALK"   , "narrator": "アーヤ", "text": "ちょっとやまなし読み返してみてよね"},
        { "location": "140/ACT"    , "narrator": "", "text": "$me$は命をかけてアーヤを守るよ"},
        { "location": "142/TALK"   , "narrator": "アーヤ", "text": "相変わらずね"},
        { "location": "143/TALK"   , "narrator": "アーヤ", "text": "本当なのかしら？"},
        { "location": "144/TALK"   , "narrator": "アーヤ", "text": "でも"},
        { "location": "145/TALK"   , "narrator": "アーヤ", "text": "信じてあげるわ"},
        { "location": "146/TALK"   , "narrator": "アーヤ", "text": "半分だけね"}
    ]
}
