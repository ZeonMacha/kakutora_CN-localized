{
    "dir": "chap12/daydra/dd_ch01_12_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "12156",
        "cid": "tsubame",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "一人の放課後"
    },
    "entry":
    [
        { "location": "259/SCENARIO", "narrator": "", "text": "一人の放課後"},
        { "location": "275/TALK"    , "narrator": "つばめ", "text": "みんな、今日の放課後は\nどうするの？"},
        { "location": "276/TALK"    , "narrator": "キリト", "text": "悪ぃ、今日は友達に\n頼まれててさ――"},
        { "location": "277/TALK"    , "narrator": "キリト", "text": "部活の手伝いしに\n行かなきゃなんねぇん\nだよ。"},
        { "location": "278/TALK"    , "narrator": "繭", "text": "バイトだから。"},
        { "location": "279/TALK"    , "narrator": "つばめ", "text": "そっか…ひなこちゃんは？"},
        { "location": "281/TALK"    , "narrator": "雛", "text": "ごめん！\n実はあたしも、やらなきゃ\nいけない課題が出てるの！"},
        { "location": "282/TALK"    , "narrator": "つばめ", "text": "そんなのあったっけ？"},
        { "location": "283/TALK"    , "narrator": "雛", "text": "あたしの科だけね…。\n放課後くらい、勉強から\n解放してほしいよ…。"},
        { "location": "285/TALK"    , "narrator": "つばめ", "text": "ふふっ、大変だね。"},
        { "location": "286/TALK"    , "narrator": "キリト", "text": "っつーわけだから、\nまた今度な。"},
        { "location": "288/TALK"    , "narrator": "繭", "text": "また明日。"},
        { "location": "290/TALK"    , "narrator": "雛", "text": "課題やりたくないー！"},
        { "location": "291/TALK"    , "narrator": "つばめ", "text": "でも、やらなかったら\n怒られちゃうよ？"},
        { "location": "293/TALK"    , "narrator": "雛", "text": "うう…日向雛、課題をする\nために直帰します…。"},
        { "location": "295/TALK"    , "narrator": "雛", "text": "というわけだから、\nまた明日ね！"},
        { "location": "296/TALK"    , "narrator": "つばめ", "text": "うん、また明日ー。"},
        { "location": "299/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "302/TALK"    , "narrator": "つばめ", "text": "はぁ…どうしよう？\n放課後暇になっちゃった。"},
        { "location": "303/TALK"    , "narrator": "つばめ", "text": "バイトもお休みだから、\nみんなとカフェに行こうと\n思ったのに…。"},
        { "location": "304/SEL"     , "narrator": "", "text": "一人で行くのもいいと思う"},
        { "location": "305/SEL"     , "narrator": "", "text": "寮でのんびりしよう"},
        { "location": "308/TALK"    , "narrator": "つばめ", "text": "う～ん…。"},
        { "location": "309/TALK"    , "narrator": "つばめ", "text": "部屋に帰ってお掃除でも\nしようかな？"},
        { "location": "312/TALK"    , "narrator": "つばめ", "text": "…暇だし、ちょっとだけ\n劇場に顔出そうかな。"},
        { "location": "325/TALK"    , "narrator": "ガブリエラ", "text": "はい、三名様ですね。\n合計で３０００円に\nなります。"},
        { "location": "327/TALK"    , "narrator": "ガブリエラ", "text": "ごゆっくりどうぞ…。\n次のお客様ー。"},
        { "location": "330/TALK"    , "narrator": "アーヤ", "text": "はい、ぼた餅ですね。\n５００円になります。"},
        { "location": "331/TALK"    , "narrator": "アーヤ", "text": "ありがとうございました。\nお次のお客様――"},
        { "location": "341/TALK"    , "narrator": "つばめ", "text": "えぇーっ！？\nな、なんでこんなに\n混んでるんですか！？"},
        { "location": "344/TALK"    , "narrator": "真幌", "text": "すまん、私のミスだ！！"},
        { "location": "348/TALK"    , "narrator": "つばめ", "text": "真幌さん！？"},
        { "location": "350/TALK"    , "narrator": "真幌", "text": "今日放映する映画が、\n一部でカルト的人気の\nある映画だったらしく――"},
        { "location": "351/TALK"    , "narrator": "真幌", "text": "全国からその映画の\nファン達が集まって\n来てしまったんだ。"},
        { "location": "352/TALK"    , "narrator": "つばめ", "text": "全国！？"},
        { "location": "353/TALK"    , "narrator": "つばめ", "text": "ど、どうするんですか？\nもし今出動掛かったら…。"},
        { "location": "355/TALK"    , "narrator": "真幌", "text": "上映中止などしようもの\nなら、大暴動は免れん…。"},
        { "location": "366/TALK"    , "narrator": "ガブリエラ", "text": "あっ、つばめ！"},
        { "location": "368/TALK"    , "narrator": "ガブリエラ", "text": "あんた、暇ならちょっと\n手伝ってよ！"},
        { "location": "370/TALK"    , "narrator": "アーヤ", "text": "手が足りないのよ。\nお願い！"},
        { "location": "380/TALK"    , "narrator": "つばめ", "text": "わ、わかりました！\nとにかく、今はお客さんの\n対応をしなくちゃ！"},
        { "location": "382/TALK"    , "narrator": "真幌", "text": "すまない。\n休みだというのに\n手伝わせてしまって…。"},
        { "location": "383/TALK"    , "narrator": "つばめ", "text": "いえ、いいんです。\n丁度やることなくて\n暇でしたし。"},
        { "location": "384/TALK"    , "narrator": "ガブリエラ", "text": "つばめー！"},
        { "location": "385/TALK"    , "narrator": "つばめ", "text": "い、今行くよー！"},
        { "location": "388/TALK"    , "narrator": "つばめ", "text": "…やっぱり、一人より\nこっちの方が楽しいな。"},
        { "location": "390/ACT"     , "narrator": "", "text": "一人で行くのもいいと思う"},
        { "location": "408/TALK"    , "narrator": "つばめ", "text": "そうかな？"},
        { "location": "409/TALK"    , "narrator": "つばめ", "text": "あ、でもアーヤさんは行きつけのカフェに、よく一人で行くらしいの"},
        { "location": "410/TALK"    , "narrator": "つばめ", "text": "わたしも、ちょっと真似してみようかな？"},
        { "location": "422/TALK"    , "narrator": "つばめ", "text": "えへへ、ちょっと楽しく\nなってきたかも。"},
        { "location": "423/TALK"    , "narrator": "つばめ", "text": "大人っぽく、カフェで\n読書してみよっと。"},
        { "location": "439/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "440/TALK"    , "narrator": "女子高校生", "text": "でさー、その時弘美ったら\n私にこう言ったの。"},
        { "location": "441/TALK"    , "narrator": "女子高校生", "text": "チョコチップの入った\nメロンパンなんて邪道だ、\nって…。"},
        { "location": "442/TALK"    , "narrator": "男子高校生", "text": "んなのどうでもいいだろ？\nそう変わらねぇんだし。"},
        { "location": "443/TALK"    , "narrator": "女子高校生", "text": "あー、聞き捨てならない！\nそれメロンパン好きの前で\n言ったら大問題だよ？"},
        { "location": "444/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "446/TALK"    , "narrator": "ウェイトレス", "text": "お待たせしましたー。\nシフォンケーキと紅茶の\nセットになります。"},
        { "location": "449/TALK"    , "narrator": "つばめ", "text": "あ、どうも。"},
        { "location": "450/TALK"    , "narrator": "ウェイトレス", "text": "ごゆっくりどうぞー。"},
        { "location": "457/TALK"    , "narrator": "つばめ", "text": "…あむっ。"},
        { "location": "459/TALK"    , "narrator": "つばめ", "text": "…ん、美味しい。"},
        { "location": "461/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "463/TALK"    , "narrator": "つばめ", "text": "ううっ、やっぱりなんか\n物足りないよぉ…。"},
        { "location": "464/TALK"    , "narrator": "つばめ", "text": "ここ、騒がしいから\n読書には向いてないし――"},
        { "location": "465/TALK"    , "narrator": "つばめ", "text": "話し相手がいないから、\n隣の人達の会話がずっと\n気になっちゃうし…。"},
        { "location": "466/TALK"    , "narrator": "男子高校生", "text": "この後カラオケ行かね？\n新曲入ったみたいだし、\n俺の美声を披露するぜ。"},
        { "location": "467/TALK"    , "narrator": "女子高校生", "text": "あんた音痴じゃん。\n歌えもしない洋楽歌うし。"},
        { "location": "468/TALK"    , "narrator": "男子高校生", "text": "そういうなよ。\nカラオケ代奢るからさ？"},
        { "location": "469/TALK"    , "narrator": "女子高校生", "text": "そういうことなら、\nお付き合いしてあげても\nいいかな？"},
        { "location": "473/TALK"    , "narrator": "つばめ", "text": "…楽しそうでいいなぁ。"},
        { "location": "482/TALK"    , "narrator": "つばめ", "text": "なんか、一人で来たのは失敗だったみたい"},
        { "location": "483/TALK"    , "narrator": "つばめ", "text": "読書にも集中できないし、寂しいからケーキも味気ないし"},
        { "location": "484/TALK"    , "narrator": "つばめ", "text": "アーヤさんとは違って、まだまだ子供なのかも"},
        { "location": "486/SEL"     , "narrator": "", "text": "また雛達と来ようね"},
        { "location": "487/ACT"     , "narrator": "", "text": "また雛達と来ようね"},
        { "location": "489/TALK"    , "narrator": "つばめ", "text": "うん、その方が絶対楽しいもん"},
        { "location": "495/ACT"     , "narrator": "", "text": "寮でのんびりしよう"},
        { "location": "512/TALK"    , "narrator": "つばめ", "text": "それもいいかも"},
        { "location": "513/TALK"    , "narrator": "つばめ", "text": "掃除とかじゃなくて、のんびりして過ごすのも悪くないよね"},
        { "location": "514/TALK"    , "narrator": "つばめ", "text": "よし、決まり！"},
        { "location": "541/TALK"    , "narrator": "つばめ", "text": "ふぁ～…。"},
        { "location": "542/TALK"    , "narrator": "つばめ", "text": "って、いけない！\nもうこんな時間…。"},
        { "location": "543/TALK"    , "narrator": "つばめ", "text": "のんびりしてたら、\n結構遅くなっちゃった。"},
        { "location": "544/TALK"    , "narrator": "つばめ", "text": "そろそろお夕飯の\n準備しないと…。"},
        { "location": "553/TALK"    , "narrator": "ガブリエラ", "text": "つばめー…。"},
        { "location": "555/TALK"    , "narrator": "つばめ", "text": "きゃぁっ！！\nが、ガブちゃん！？"},
        { "location": "560/TALK"    , "narrator": "みやび", "text": "すまんな、つばめちゃん。\nこんな時間に押しかけて。"},
        { "location": "563/TALK"    , "narrator": "アーヤ", "text": "お邪魔するわ…。"},
        { "location": "565/TALK"    , "narrator": "つばめ", "text": "えっ？　えっ？\nどうしたんですか？"},
        { "location": "566/TALK"    , "narrator": "つばめ", "text": "何だか、皆さんお疲れの\nようですけど…。"},
        { "location": "567/TALK"    , "narrator": "ガブリエラ", "text": "劇場が…。"},
        { "location": "568/TALK"    , "narrator": "つばめ", "text": "劇場が？"},
        { "location": "571/TALK"    , "narrator": "みやび", "text": "劇場が、信じれないほど\n混んだんよ…。"},
        { "location": "574/TALK"    , "narrator": "つばめ", "text": "えぇっ！？"},
        { "location": "576/TALK"    , "narrator": "アーヤ", "text": "館長、いつもみたいに\n適当に映画を決めてた\nらしいんだけど――"},
        { "location": "577/TALK"    , "narrator": "アーヤ", "text": "その映画が、偶然にも\nカルト的人気のある\n映画だったみたいなの。"},
        { "location": "578/TALK"    , "narrator": "みやび", "text": "そんなのが劇場でやる\nいうたら――"},
        { "location": "580/TALK"    , "narrator": "みやび", "text": "全国のファン達が\n押し寄せてくるのは\n当然ちや。"},
        { "location": "581/TALK"    , "narrator": "アーヤ", "text": "大行列に満員御礼…\n多分、もう二度と見れない\n光景ね…。"},
        { "location": "582/TALK"    , "narrator": "つばめ", "text": "そ、そうだったんですか。\nお疲れ様でした…。"},
        { "location": "584/TALK"    , "narrator": "ガブリエラ", "text": "だからもう疲れて何にも\nする気起きないのよ。"},
        { "location": "585/TALK"    , "narrator": "ガブリエラ", "text": "夕飯これからなら、\nあたし達の分も\n作ってもらえない？"},
        { "location": "588/TALK"    , "narrator": "つばめ", "text": "う、うん、もちろん。\n簡単な物でいいですか？"},
        { "location": "591/TALK"    , "narrator": "みやび", "text": "構わんよ。\nちゅうか、疲れ過ぎてて\nあんまし食べられんし…。"},
        { "location": "594/TALK"    , "narrator": "アーヤ", "text": "お味噌汁とかだと\n嬉しいわ。"},
        { "location": "595/TALK"    , "narrator": "つばめ", "text": "わかりました。\nできるまで、ゆっくり\n休んでてください。"},
        { "location": "597/TALK"    , "narrator": "アーヤ", "text": "ごめんね、つばめ。\nお休みなのに…。"},
        { "location": "598/TALK"    , "narrator": "つばめ", "text": "いえ、気にしないで\nください。"},
        { "location": "600/TALK"    , "narrator": "つばめ", "text": "みんなと一緒にご飯を\n食べられるの、\n凄く嬉しいですから。"},
        { "location": "273/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>7月11日　3:16 PM</color>\nとある平日の放課後、教室にて。"},
        { "location": "611/DIALOG"  , "narrator": "Dialog_GEThimegoto_ch01", "text": "【まかないちゃん】"}
    ]
}
