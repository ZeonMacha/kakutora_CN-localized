    "entry":
    [
        { "location": "498/SCENARIO", "narrator": "", "text": "アニメ第35話"},
        { "location": "526/TALK"    , "narrator": "全権大使", "text": "$handle$様、初めまして。突然のコンタクトとなり、驚かれたことと思います。"},
        { "location": "527/TALK"    , "narrator": "全権大使", "text": "私はAEZ統一国家全権大使、イーと申します。よろしくお願いします。"},
        { "location": "528/SEL"     , "narrator": "", "text": "よろしくお願いします"},
        { "location": "529/SEL"     , "narrator": "", "text": "全権大使ってなに？"},
        { "location": "530/SEL"     , "narrator": "", "text": "“彼ら”の手先か！"},
        { "location": "531/SEL"     , "narrator": "", "text": "バイパス回線で入ってきたの？"},
        { "location": "532/ACT"     , "narrator": "", "text": "よろしくお願いします"},
        { "location": "533/TALK"    , "narrator": "全権大使", "text": "ご丁寧なお返事ありがとうございます。"},
        { "location": "534/ACT"     , "narrator": "", "text": "全権大使ってなに？"},
        { "location": "535/TALK"    , "narrator": "全権大使", "text": "国家元首から、その全ての権限を譲り受けて他国等と交渉する人の事を申します。"},
        { "location": "536/ACT"     , "narrator": "", "text": "“彼ら”の手先か！"},
        { "location": "537/TALK"    , "narrator": "全権大使", "text": "まるで、私が何らかの悪の組織の構成員のような言われ方ですね。"},
        { "location": "538/ACT"     , "narrator": "", "text": "バイパス回線で入ってきたの？"},
        { "location": "539/TALK"    , "narrator": "全権大使", "text": "左様にございます。今回、$handle$様にお伝えしたいことがありまして、回線を敷設させていただいた次第です。"},
        { "location": "540/SEL"     , "narrator": "", "text": "そういうことだったんですね"},
        { "location": "541/SEL"     , "narrator": "", "text": "勝手に人のアカウントを乗っ取って、やること最悪だな"},
        { "location": "542/ACT"     , "narrator": "", "text": "そういうことだったんですね"},
        { "location": "543/TALK"    , "narrator": "全権大使", "text": "はい。"},
        { "location": "544/ACT"     , "narrator": "", "text": "勝手に人のアカウントを乗っ取って、やること最悪だな"},
        { "location": "545/TALK"    , "narrator": "全権大使", "text": "そのような事があったのですか？"},
        { "location": "546/TALK"    , "narrator": "全権大使", "text": "申し訳ございません、不勉強なのもでして、この回線がどのように敷かれたのかは存じ上げません。"},
        { "location": "547/TALK"    , "narrator": "全権大使", "text": "ただ、$handle$様がご不快に思われていることは承知致しました。この件につきましては、要件が終わり次第情報収集を行い、その実態について調査をしたいと思います。"},
        { "location": "550/TALK"    , "narrator": "全権大使", "text": "さて、早速ではございますが、まずは本題に入らせていただければと思います。質疑応答などのお時間は、後ほど取らせていただきます。"},
        { "location": "551/TALK"    , "narrator": "全権大使", "text": "$handle$様は、逢瀬つばめのクラン、千羽鶴によって異世界より接続されたとお伺いしておりますが、その情報は正しいでしょうか？"},
        { "location": "552/SEL"     , "narrator": "", "text": "正しいです"},
        { "location": "553/SEL"     , "narrator": "", "text": "教えません"},
        { "location": "554/ACT"     , "narrator": "", "text": "正しいです"},
        { "location": "555/TALK"    , "narrator": "全権大使", "text": "明解なご回答、ありがとうございます。"},
        { "location": "556/ACT"     , "narrator": "", "text": "教えません"},
        { "location": "557/TALK"    , "narrator": "全権大使", "text": "承知致しました。不適切な質問、深くお詫び致します。"},
        { "location": "559/TALK"    , "narrator": "全権大使", "text": "現在、その千羽鶴のフェノメノンによって、世界と日本は分断された状況にございます。"},
        { "location": "560/TALK"    , "narrator": "全権大使", "text": "フェノメノンはその特性上、対岸からでは限られた数値での観測しかできず、今まで状況が殆どわからずにおりました。"},
        { "location": "561/TALK"    , "narrator": "全権大使", "text": "ですがこうして、漸く直接内側にリアルタイムアプローチが可能なハイバンド回線が敷設されたことで、自体の改善により積極的に乗り出せるようになりました。"},
        { "location": "562/TALK"    , "narrator": "全権大使", "text": "$handle$様におかれましても、今までかなりのご苦労をされたことと存じますが、フェノメノンによって分断された２つの世界を１つに再統一するために、是非お力をお借りできればと考えております次第です。"},
        { "location": "563/SEL"     , "narrator": "", "text": "協力します"},
        { "location": "564/SEL"     , "narrator": "", "text": "今まであれだけのことをやっておいて、どの面下げてお力をお借りしたいだよ"},
        { "location": "565/ACT"     , "narrator": "", "text": "協力します"},
        { "location": "566/TALK"    , "narrator": "全権大使", "text": "ありがとうございます。心より感謝致します。"},
        { "location": "567/SEL"     , "narrator": "", "text": "で、何をすればいい？"},
        { "location": "568/SEL"     , "narrator": "", "text": "けどその前に、色々教えて欲しい"},
        { "location": "569/ACT"     , "narrator": "", "text": "で、何をすればいい？"},
        { "location": "570/TALK"    , "narrator": "全権大使", "text": "はい。只今より簡潔に説明させていただきます。"},
        { "location": "572/ACT"     , "narrator": "", "text": "まずは色々教えてください"},
        { "location": "573/TALK"    , "narrator": "全権大使", "text": "もちろんです。私が知りうることであれば、お答え致します。"},
        { "location": "576/TALK"    , "narrator": "全権大使", "text": "では改めてお伺いしますが、我々の世界平和にご協力お願い出来ますでしょうか。"},
        { "location": "577/SEL"     , "narrator": "", "text": "協力します"},
        { "location": "578/SEL"     , "narrator": "", "text": "無理です"},
        { "location": "579/ACT"     , "narrator": "", "text": "協力します"},
        { "location": "580/TALK"    , "narrator": "全権大使", "text": "ありがとうございます。心より感謝致します。"},
        { "location": "581/TALK"    , "narrator": "全権大使", "text": "それでは只今より、$handle$様に依頼したいことについて簡潔に説明させていただきます。"},
        { "location": "583/ACT"     , "narrator": "", "text": "無理です"},
        { "location": "588/ACT"     , "narrator": "", "text": "今まであれだけのことをやっておいて、どの面下げてお力をお借りしたいだよ"},
        { "location": "589/TALK"    , "narrator": "全権大使", "text": "僭越ながら、“あれだけのこと”とは、どのようなことを指しますでしょうか？"},
        { "location": "590/SEL"     , "narrator": "", "text": "トライナリーたちをモノか何かのように扱ってる"},
        { "location": "591/SEL"     , "narrator": "", "text": "千羽鶴に酷いことをしている"},
        { "location": "592/SEL"     , "narrator": "", "text": "エリカを利用して苦しめてる"},
        { "location": "593/SEL"     , "narrator": "", "text": "世界中の人々を奴隷化することを目論んでる"},
        { "location": "594/ACT"     , "narrator": "", "text": "トライナリーたちをモノか何かのように扱ってる"},
        { "location": "595/TALK"    , "narrator": "全権大使", "text": "もしかして、天使の件をそのようにお考えということでしょうか？"},
        { "location": "596/TALK"    , "narrator": "全権大使", "text": "もしそうであれば、天使については彼女らが自ら立候補したものであって、私達が強制的に徴用したりといった事実はございません。"},
        { "location": "597/SEL"     , "narrator": "", "text": "でも洗脳してるよね？"},
        { "location": "598/ACT"     , "narrator": "", "text": "でも洗脳してるよね？"},
        { "location": "600/TALK"    , "narrator": "全権大使", "text": "何やら物騒な事を言われていますが、私達が一般社会や彼女らに施しているのは、教育という福利厚生です。"},
        { "location": "601/TALK"    , "narrator": "全権大使", "text": "$handle$様の住まれている世界でも、同様の教育制度がありませんか？"},
        { "location": "602/TALK"    , "narrator": "全権大使", "text": "もし彼女たちの言動が常軌を逸していると思われるのならば、それは教育や社会情勢の差かもしれませんね。"},
        { "location": "603/TALK"    , "narrator": "全権大使", "text": "それは何も、隣の世界、私達の世界を覗かなくても、$handle$様の世界でも十分体験可能だと思います。"},
        { "location": "604/TALK"    , "narrator": "全権大使", "text": "国、思想、環境などが、$handle$様のお住まいの地域とまるで違う所に住む方の中には、$handle$様からすれば常軌を逸した考えを持っている方もいらっしゃると思います。"},
        { "location": "605/TALK"    , "narrator": "全権大使", "text": "現在、私達の世界では、人々は救済を求めています。それに呼応するように、世界をもう1段階上にパラダイムシフトする必要があるのです。"},
        { "location": "606/TALK"    , "narrator": "全権大使", "text": "彼女たちトライナリーは皆、それぞれの国で、大変優秀な成績を修めて卒業し、様々な理由、事情を持って私達の特務機関に志願してきました。"},
        { "location": "607/TALK"    , "narrator": "全権大使", "text": "その後、グローバルな視野に基づいた世界改革の教育と訓練を行い、今の彼女達はあります。"},
        { "location": "608/TALK"    , "narrator": "全権大使", "text": "それは、今のこの世界の状況に即したものなのです。どうかご理解ください。"},
        { "location": "609/ACT"     , "narrator": "", "text": "千羽鶴に酷いことをしている"},
        { "location": "610/TALK"    , "narrator": "全権大使", "text": "千羽鶴は全て、本人の計画によって行動しているに過ぎません。"},
        { "location": "611/TALK"    , "narrator": "全権大使", "text": "むしろ私達は、彼女が作ったフェノメノンの内側を、つい先ほどまで自由に覗くことすらできず、四苦八苦していたくらいです。"},
        { "location": "612/TALK"    , "narrator": "全権大使", "text": "酷いことなど、身に覚えはありませんよ。"},
        { "location": "613/TALK"    , "narrator": "全権大使", "text": "むしろ彼女は、私達の大切な娘ともいえる存在です。大事に扱わないわけがありません。"},
        { "location": "614/ACT"     , "narrator": "", "text": "エリカを利用して苦しめてる"},
        { "location": "615/TALK"    , "narrator": "全権大使", "text": "彼女は彼女自身の研究に誇りを持っています。実際、彼女の功績は、世界的権威の賞を受賞するに値すると思いますし、今後何世代にも渡り、偉人伝に名を連ねる事でしょう。"},
        { "location": "616/TALK"    , "narrator": "全権大使", "text": "そんな彼女を私達が苦しめるわけがありません。"},
        { "location": "617/ACT"     , "narrator": "", "text": "世界中の人々を奴隷化することを目論んでる"},
        { "location": "618/TALK"    , "narrator": "全権大使", "text": "それこそ被害妄想ではないでしょうか？"},
        { "location": "619/TALK"    , "narrator": "全権大使", "text": "奴隷化と一口に言いましても、明確な基準などございません。"},
        { "location": "620/TALK"    , "narrator": "全権大使", "text": "例えば現存する全ての企業は、経営者と労働者に二分できる仕組みで動いていますね。"},
        { "location": "621/TALK"    , "narrator": "全権大使", "text": "そうである以上、企業でさえ、奴隷社会の象徴であるという定義も可能となるわけです。"},
        { "location": "622/TALK"    , "narrator": "全権大使", "text": "ですが、そのような事を言う方は"},
        { "location": "623/TALK"    , "narrator": "全権大使", "text": "本心から、と厳密化するならば、殆どいらっしゃらないと思います。"},
        { "location": "624/TALK"    , "narrator": "全権大使", "text": "私達が持っているアジェンダは、確かにある意味に於いては管理社会であり、20世紀が生み出した自由主義に比べれば、秩序寄りです。"},
        { "location": "625/TALK"    , "narrator": "全権大使", "text": "ですが私は、その時代に最も合った社会を選択していくべきであると考えます。"},
        { "location": "626/TALK"    , "narrator": "全権大使", "text": "私達のアジェンダによって社会変革が起きれば、管理による窮屈さより、その快適性と将来性から大きな希望が見えてくると信じています。"},
        { "location": "628/TALK"    , "narrator": "全権大使", "text": "と、恐らくですが、$handle$様にはまだご不明な点が沢山あるのではないのでしょうか？"},
        { "location": "629/TALK"    , "narrator": "全権大使", "text": "ですから、そのような反発が湧き出てくるのかもしれません。"},
        { "location": "630/TALK"    , "narrator": "全権大使", "text": "せっかくですから、ここで色々とご質問ください。"},
        { "location": "631/TALK"    , "narrator": "全権大使", "text": "答えられる事については全て回答するつもりです。"},
        { "location": "636/TALK"    , "narrator": "全権大使", "text": "結論として為し得るべきこととしては、クラン千羽鶴の“蒸着”となります。"},
        { "location": "637/TALK"    , "narrator": "全権大使", "text": "“蒸着”とは、簡単に言えば「クランの意志が紡ぎ出している世界」と「現実の世界」の２つを、矛盾無く繋ぎ合わせる技術です。"},
        { "location": "638/TALK"    , "narrator": "全権大使", "text": "Redinessにおいては、クラウド化された1xと呼ばれる脳域を利用することで、合法的かつ安全に、それを実現できます。一般市民へのリスクは皆無です。"},
        { "location": "639/TALK"    , "narrator": "全権大使", "text": "これを実施することによって、両世界を隔てる繭を取り去ることができるのです。"},
        { "location": "640/TALK"    , "narrator": "全権大使", "text": "そしてそれを可能にするのは、千羽鶴によって接続された事により、彼女の心、すなわち松果体に直接アクセス出来る、$handle$様だけとなります。"},
        { "location": "641/TALK"    , "narrator": "全権大使", "text": "どうかこの世界を再びひとつの世界に戻す為に、$handle$様の力をお貸しくださいませ。"},
        { "location": "643/SEL"     , "narrator": "", "text": "もちろんです"},
        { "location": "644/SEL"     , "narrator": "", "text": "拒否します"},
        { "location": "645/SEL"     , "narrator": "", "text": "まずは色々教えてください"},
        { "location": "646/ACT"     , "narrator": "", "text": "もちろんです"},
        { "location": "648/ACT"     , "narrator": "", "text": "拒否します"},
        { "location": "650/ACT"     , "narrator": "", "text": "まずは色々教えてください"},
        { "location": "654/SEL"     , "narrator": "", "text": "もちろんです"},
        { "location": "655/SEL"     , "narrator": "", "text": "拒否します"},
        { "location": "656/ACT"     , "narrator": "", "text": "もちろんです"},
        { "location": "658/ACT"     , "narrator": "", "text": "拒否します"},
        { "location": "670/TALK"    , "narrator": "全権大使", "text": "ありがとうございます。"},
        { "location": "671/TALK"    , "narrator": "全権大使", "text": "私達の平和ビジョンをご理解いただけて、大変嬉しく思います。"},
        { "location": "672/TALK"    , "narrator": "全権大使", "text": "つきましては、これより下部組織のエンジニアにTRI-OSを制御させまして、千羽鶴の蒸着手続きをさせていただきますが、その際には蒸着を見守ってくださいますよう、お願い申し上げます。"},
        { "location": "673/TALK"    , "narrator": "全権大使", "text": "また、$handle$様におかれましては、世界際親善大使として、弊世界の代表国家であるＡＥＺ統一国家にて国賓対応をさせていただきます。"},
        { "location": "674/TALK"    , "narrator": "全権大使", "text": "故に、$handle$様には引き続きのご支援を戴きたく考えております。\n国家としましても異世界局の設立を急いでおりますが、局発足の際には是非、重要職に就いて頂きたく思います。"},
        { "location": "675/TALK"    , "narrator": "全権大使", "text": "ただ、この件につきましては、まだ現時点におきましては保留とさせてください。色々なことが重なりますと、オペレーションエラーが増えてしまいます故、どうかご理解をお願い致します。"},
        { "location": "676/TALK"    , "narrator": "全権大使", "text": "それでは、私はこれにて失礼致します。"},
        { "location": "677/TALK"    , "narrator": "全権大使", "text": "何か技術的な不明点がございましたら、この後接触されると思われますエンジニアにご質問ください。"},
        { "location": "678/TALK"    , "narrator": "全権大使", "text": "改めて、当世界の平和にご尽力いただきありがとうございます。"},
        { "location": "679/TALK"    , "narrator": "全権大使", "text": "両世界に神の祝福を。"},
        { "location": "684/TALK"    , "narrator": "全権大使", "text": "もちろんです。私が知りうることであれば、お答え致します。"},
        { "location": "694/TALK"    , "narrator": "全権大使", "text": "そうですか。それは大変残念に思います。"},
        { "location": "695/TALK"    , "narrator": "全権大使", "text": "私も、私の国家も、貴方のその立ち位置と力とお考えに、かなり期待をしていたのですが。"},
        { "location": "696/TALK"    , "narrator": "全権大使", "text": "ただ、無理強いはしないことを信条としております故、これ以上のセールスは控えさせていただこうと思います。"},
        { "location": "697/TALK"    , "narrator": "全権大使", "text": "ただ、私達もそれなりにビジョンとアジェンダを持って推進しております。"},
        { "location": "698/TALK"    , "narrator": "全権大使", "text": "その為、別の方法で同じ道、今回ならば、蒸着とその先にあるミレニアム計画を推進すべく動きますので、その結果、$handle$様の行動と衝突することもあるかもしれません。"},
        { "location": "699/TALK"    , "narrator": "全権大使", "text": "時間的には、丁度私達のアジェンダにおいて重要な、蒸着と天使に関する準備が整うところであります。"},
        { "location": "700/TALK"    , "narrator": "全権大使", "text": "ですから、恐らくこの会談が終了次第、事は動き始めるかと思います。"},
        { "location": "701/TALK"    , "narrator": "全権大使", "text": "その際には何卒、平にご容赦くださいますよう、お願い申し上げます。"},
        { "location": "705/TALK"    , "narrator": "全権大使", "text": "それでは、ごきげんよう$handle$様。"},
        { "location": "706/TALK"    , "narrator": "全権大使", "text": "貴方様に\n素敵なココロの旅を。"},
        { "location": "709/SEL"     , "narrator": "", "text": "映像を見る\n<color=green>【高画質/64MB 4:11】</color>"},
        { "location": "710/SEL"     , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/22MB 4:11】</color>"},
        { "location": "711/SEL"     , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "712/ACT"     , "narrator": "", "text": "映像を見る\n<color=green>【高画質/64MB 4:11】</color>"},
        { "location": "719/ACT"     , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/22MB 4:11】</color>"},
        { "location": "726/ACT"     , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "764/TALK"    , "narrator": "赤髪千羽鶴", "text": "こんにちは、\n$handle$さん。"},
        { "location": "765/SEL"     , "narrator": "", "text": "お茶会！？"},
        { "location": "766/SEL"     , "narrator": "", "text": "もしかして、チャンネル移動してきたの！？"},
        { "location": "767/ACT"     , "narrator": "", "text": "お茶会！？"},
        { "location": "768/TALK"    , "narrator": "赤髪千羽鶴", "text": "あっ…ええ、\nそんなところです。"},
        { "location": "769/TALK"    , "narrator": "赤髪千羽鶴", "text": "前に少しそんな話も\n出ていましたので。"},
        { "location": "770/TALK"    , "narrator": "赤髪千羽鶴", "text": "ただ、お話する内容は\n至極真面目なことですから\n期待しないで下さい。"},
        { "location": "771/TALK"    , "narrator": "赤髪千羽鶴", "text": "それでもよければ\nご一緒しましょう。"},
        { "location": "772/SEL"     , "narrator": "", "text": "よろしくお願いします"},
        { "location": "773/ACT"     , "narrator": "", "text": "よろしくお願いします"},
        { "location": "775/TALK"    , "narrator": "赤髪千羽鶴", "text": "はい、喜んで。"},
        { "location": "777/TALK"    , "narrator": "赤髪千羽鶴", "text": "先日は、“彼ら”による\n侵攻の報告と、命令の入力\nありがとうございます。"},
        { "location": "778/SEL"     , "narrator": "", "text": "どういたしまして！"},
        { "location": "779/SEL"     , "narrator": "", "text": "何の事だっけ？"},
        { "location": "780/SEL"     , "narrator": "", "text": "つばめ、大丈夫？"},
        { "location": "781/ACT"     , "narrator": "", "text": "どういたしまして！"},
        { "location": "782/ACT"     , "narrator": "", "text": "何の事だっけ？"},
        { "location": "783/TALK"    , "narrator": "赤髪千羽鶴", "text": "もうそれなりに\n間が開いて\nしまいましたからね。"},
        { "location": "784/TALK"    , "narrator": "赤髪千羽鶴", "text": "忘れてしまっても\n仕方ないでしょう。"},
        { "location": "785/TALK"    , "narrator": "赤髪千羽鶴", "text": "以前、千羽鶴と私は\n交渉を妥結しました。"},
        { "location": "786/TALK"    , "narrator": "赤髪千羽鶴", "text": "もし“彼ら”がこの日本に\n直接入り込んでくるような\n危機が訪れた場合――"},
        { "location": "787/TALK"    , "narrator": "赤髪千羽鶴", "text": "私は問答無用で\nチャンネルを奪い、彼らに\n対抗するというものです。"},
        { "location": "788/TALK"    , "narrator": "赤髪千羽鶴", "text": "そして、その一環として\n“彼ら”の監視を貴方に\nお願いしました。"},
        { "location": "789/TALK"    , "narrator": "赤髪千羽鶴", "text": "結果、貴方は本当に\n素晴らしい報告をして\nくださり――"},
        { "location": "790/TALK"    , "narrator": "赤髪千羽鶴", "text": "私はその準備を\nすることができました。"},
        { "location": "791/ACT"     , "narrator": "", "text": "つばめ、大丈夫？"},
        { "location": "792/TALK"    , "narrator": "赤髪千羽鶴", "text": "はい、\n私は大丈夫です。"},
        { "location": "793/TALK"    , "narrator": "赤髪千羽鶴", "text": "心配してくださって\nありがとうございます。"},
        { "location": "795/ACT"     , "narrator": "", "text": "もしかして、チャンネル移動してきたの！？"},
        { "location": "796/TALK"    , "narrator": "赤髪千羽鶴", "text": "はい。"},
        { "location": "797/TALK"    , "narrator": "赤髪千羽鶴", "text": "$handle$さんが\n発効してくれた、\nFLIPCHANNELのお陰です。"},
        { "location": "798/TALK"    , "narrator": "赤髪千羽鶴", "text": "その節は、大変\nありがとうございました！"},
        { "location": "799/SEL"     , "narrator": "", "text": "どういたしまして！"},
        { "location": "800/ACT"     , "narrator": "", "text": "どういたしまして！"},
        { "location": "804/TALK"    , "narrator": "赤髪千羽鶴", "text": "ただ、ちょっと準備に\n手こずってしまって、\n間が開いてしまいました。"},
        { "location": "805/TALK"    , "narrator": "赤髪千羽鶴", "text": "それに比べて、\n“彼ら”の行動は\nとても早かった。"},
        { "location": "806/TALK"    , "narrator": "赤髪千羽鶴", "text": "まさか先に\nここを占拠されるとは\n思いもしませんでした。"},
        { "location": "807/SEL"     , "narrator": "", "text": "今どうなってるの？"},
        { "location": "808/ACT"     , "narrator": "", "text": "今どうなってるの？"},
        { "location": "810/TALK"    , "narrator": "赤髪千羽鶴", "text": "簡単に言えば。"},
        { "location": "811/TALK"    , "narrator": "赤髪千羽鶴", "text": "以前、一瞬だけ\n卯月神楽の回線から\n侵入した彼らは――"},
        { "location": "812/TALK"    , "narrator": "赤髪千羽鶴", "text": "そこで、\n$handle$さんの\nアカウントを断定し。"},
        { "location": "813/TALK"    , "narrator": "赤髪千羽鶴", "text": "そのアカウントの回線を\n利用することで、内側から\n情報を引き抜きました。"},
        { "location": "814/TALK"    , "narrator": "赤髪千羽鶴", "text": "そして、独自の回線を\n構築してしまったのです。"},
        { "location": "815/TALK"    , "narrator": "赤髪千羽鶴", "text": "これによって、\n“彼ら”は実質、貴方と\n同じ権限を持ちました。"},
        { "location": "816/TALK"    , "narrator": "赤髪千羽鶴", "text": "このままでは――"},
        { "location": "817/TALK"    , "narrator": "赤髪千羽鶴", "text": "彼らがライフギャザーを\n掌握するのも、時間の問題\nかもしれません。"},
        { "location": "818/TALK"    , "narrator": "赤髪千羽鶴", "text": "私達は、それよりも先に\nライフギャザーを掌握し。"},
        { "location": "819/TALK"    , "narrator": "赤髪千羽鶴", "text": "“彼ら”を永遠に\n葬り去らねばなりません。"},
        { "location": "820/SEL"     , "narrator": "", "text": "ほんとそれ"},
        { "location": "821/SEL"     , "narrator": "", "text": "葬り去るって、また物騒な"},
        { "location": "822/ACT"     , "narrator": "", "text": "ほんとそれ"},
        { "location": "823/ACT"     , "narrator": "", "text": "葬り去るって、また物騒な"},
        { "location": "824/TALK"    , "narrator": "赤髪千羽鶴", "text": "それくらいの覚悟で\n臨まなければ、\n撃退は無理です。"},
        { "location": "825/TALK"    , "narrator": "赤髪千羽鶴", "text": "相手はやり手です。\n物腰やわらかでも、\n既に戦闘態勢です。"},
        { "location": "827/TALK"    , "narrator": "赤髪千羽鶴", "text": "私達がすることは、\nまずは何よりもライフ\nギャザーを掌握すること。"},
        { "location": "828/TALK"    , "narrator": "赤髪千羽鶴", "text": "“彼ら”はまだ、私達が\nライフギャザーに接近して\nいる事を知りません。"},
        { "location": "829/TALK"    , "narrator": "赤髪千羽鶴", "text": "ですから、まだ\n私達には大きな逆転の\nチャンスがあります。"},
        { "location": "830/TALK"    , "narrator": "赤髪千羽鶴", "text": "その方法は、\nライフギャザーを使って\n彼らを抹消することです。"},
        { "location": "831/SEL"     , "narrator": "", "text": "できるの？"},
        { "location": "832/ACT"     , "narrator": "", "text": "できるの？"},
        { "location": "834/TALK"    , "narrator": "赤髪千羽鶴", "text": "策はあります。"},
        { "location": "835/TALK"    , "narrator": "赤髪千羽鶴", "text": "簡単に言ってしまえば、\n“彼ら”の行動原理を\n書き換えてしまいます。"},
        { "location": "836/TALK"    , "narrator": "赤髪千羽鶴", "text": "ですから“彼ら”を\n物理的に葬り去る訳では\nありません。"},
        { "location": "837/TALK"    , "narrator": "赤髪千羽鶴", "text": "葬り去るのは、\n“彼ら”の思想。"},
        { "location": "838/TALK"    , "narrator": "赤髪千羽鶴", "text": "少しばかり、“彼ら”の\n統治目的を改ざんすれば\nいいのです。"},
        { "location": "839/TALK"    , "narrator": "赤髪千羽鶴", "text": "“彼ら”は人を人として\n見てはいませんが、世界を\n動かす手腕は確かです。"},
        { "location": "840/TALK"    , "narrator": "赤髪千羽鶴", "text": "その能力を保持したまま、\nアジェンダを変えてしまう\nというわけですね。"},
        { "location": "841/SEL"     , "narrator": "", "text": "まあ確かに現実的な案ではある"},
        { "location": "842/SEL"     , "narrator": "", "text": "人の心を改ざんするなんて、“彼ら”とやってる事が同じじゃないか！"},
        { "location": "843/ACT"     , "narrator": "", "text": "まあ確かに現実的な案ではある"},
        { "location": "844/TALK"    , "narrator": "赤髪千羽鶴", "text": "ありがとうございます！"},
        { "location": "845/TALK"    , "narrator": "赤髪千羽鶴", "text": "そして、その際に、右腕で\nある貴方にお願いしたい\n事があるのです。"},
        { "location": "846/ACT"     , "narrator": "", "text": "人の心を改ざんするなんて、“彼ら”とやってる事が同じじゃないか！"},
        { "location": "847/TALK"    , "narrator": "赤髪千羽鶴", "text": "なるほど、そうですか。"},
        { "location": "848/TALK"    , "narrator": "赤髪千羽鶴", "text": "確かにそうかも\nしれませんね。"},
        { "location": "849/TALK"    , "narrator": "赤髪千羽鶴", "text": "結局は、己の正義の\n押しつけでしかない。"},
        { "location": "850/TALK"    , "narrator": "赤髪千羽鶴", "text": "それは重々承知の上での\n戦いです。"},
        { "location": "851/TALK"    , "narrator": "赤髪千羽鶴", "text": "私は今回の作戦において\n色々な方法を考えました。"},
        { "location": "852/TALK"    , "narrator": "赤髪千羽鶴", "text": "ですが、どう考えても\n“彼ら”の存在――"},
        { "location": "853/TALK"    , "narrator": "赤髪千羽鶴", "text": "いえ、“彼ら”の持つ\n危険な思想がある限り、\n世界に安寧は訪れないと、"},
        { "location": "854/TALK"    , "narrator": "赤髪千羽鶴", "text": "そういう結論に\n行き着いたのです。"},
        { "location": "855/TALK"    , "narrator": "赤髪千羽鶴", "text": "この問題を解決するには、\nもはや常識的な手段では\n太刀打ち出来ないのです。"},
        { "location": "856/TALK"    , "narrator": "赤髪千羽鶴", "text": "Redinessによる\n心の改ざんは、到底人々に\n受け入れられないでしょう"},
        { "location": "857/TALK"    , "narrator": "赤髪千羽鶴", "text": "ですが！\n例えそれを\n責められたとしても！"},
        { "location": "858/TALK"    , "narrator": "赤髪千羽鶴", "text": "限られた最小限の\n改ざんで、世界の動きが\n変わるのであれば！"},
        { "location": "859/TALK"    , "narrator": "赤髪千羽鶴", "text": "その後私自身は炎で焼かれ\nようとも、遂行するべきで\nあるという想いでいます。"},
        { "location": "860/TALK"    , "narrator": "赤髪千羽鶴", "text": "そういうものじゃ\nないんですか？\n世界を動かすってことは。"},
        { "location": "861/TALK"    , "narrator": "赤髪千羽鶴", "text": "自己保身なんて考えて\nいたら、世界を根本から\n変えるなんて無理ですよ。"},
        { "location": "862/TALK"    , "narrator": "赤髪千羽鶴", "text": "例えわたしが悪魔として\n火刑に処されても。"},
        { "location": "863/TALK"    , "narrator": "赤髪千羽鶴", "text": "その後の人達が平和に\n過ごせるようになるなら、\nいいじゃないですか。"},
        { "location": "864/TALK"    , "narrator": "赤髪千羽鶴", "text": "ダメでしょうか。"},
        { "location": "865/SEL"     , "narrator": "", "text": "革命家だね"},
        { "location": "866/SEL"     , "narrator": "", "text": "とても理解出来ない"},
        { "location": "867/ACT"     , "narrator": "", "text": "革命家だね"},
        { "location": "868/TALK"    , "narrator": "赤髪千羽鶴", "text": "はい。"},
        { "location": "869/ACT"     , "narrator": "", "text": "とても理解出来ない"},
        { "location": "870/TALK"    , "narrator": "赤髪千羽鶴", "text": "そうですか…残念です。"},
        { "location": "871/TALK"    , "narrator": "赤髪千羽鶴", "text": "無理強いはしたく\nありませんから――"},
        { "location": "872/TALK"    , "narrator": "赤髪千羽鶴", "text": "もう、私に関わらない\n方が良いと思います。"},
        { "location": "873/TALK"    , "narrator": "赤髪千羽鶴", "text": "一応最後まで聞いて\nいただき、その後\n判断いただければと。"},
        { "location": "875/TALK"    , "narrator": "赤髪千羽鶴", "text": "さて、話を続けますが――"},
        { "location": "876/TALK"    , "narrator": "赤髪千羽鶴", "text": "その際に、右腕である\n貴方にお願いしたい事が\nあるのです。"},
        { "location": "878/TALK"    , "narrator": "赤髪千羽鶴", "text": "それは、彼らに植えつける\n新アジェンダとして、\nどのようなものが良いか。"},
        { "location": "879/TALK"    , "narrator": "赤髪千羽鶴", "text": "それを、右腕会議によって\n決定していきたいのです。"},
        { "location": "880/TALK"    , "narrator": "赤髪千羽鶴", "text": "非常にシンプルな事ですが\n今後の社会情勢を左右する\n非常に重要な事です。"},
        { "location": "881/TALK"    , "narrator": "赤髪千羽鶴", "text": "私は以前、貴方に実際の\n政治を依頼するわけでは\nないとお話しました。"},
        { "location": "882/TALK"    , "narrator": "赤髪千羽鶴", "text": "当然、統治に関しては\nプロである“彼ら”に\n任せればいいんです。"},
        { "location": "883/TALK"    , "narrator": "赤髪千羽鶴", "text": "ただ、その原理原則、\n根っこの部分、いわば\n統治の目的――"},
        { "location": "884/TALK"    , "narrator": "赤髪千羽鶴", "text": "これを、“彼ら”自身や\n１％層へのものではなく、\n民衆のものにする。"},
        { "location": "885/TALK"    , "narrator": "赤髪千羽鶴", "text": "これだけで、\n世界は大きく変わると\n思うんです。"},
        { "location": "887/TALK"    , "narrator": "赤髪千羽鶴", "text": "そして\nこれが成功すれば――"},
        { "location": "888/TALK"    , "narrator": "赤髪千羽鶴", "text": "貴方とわたしは世界を\n救った革命の英雄として、\n歴史に名を刻むでしょう。"},
        { "location": "889/SEL"     , "narrator": "", "text": "え、「$handle$」って名前で歴史の教科書に載ってしまうのかな…？"},
        { "location": "890/SEL"     , "narrator": "", "text": "そんな事より、$me$はつばめとスウィートな生活をしたいんだー！"},
        { "location": "891/ACT"     , "narrator": "", "text": "え、「$handle$」って名前で歴史の教科書に載ってしまうのかな…？"},
        { "location": "892/TALK"    , "narrator": "赤髪千羽鶴", "text": "恐らくそうなりますね。"},
        { "location": "893/TALK"    , "narrator": "赤髪千羽鶴", "text": "気になるようでしたら、\n今のうちに名前を\n変えておいてくださいね。"},
        { "location": "894/ACT"     , "narrator": "", "text": "そんな事より、$me$はつばめとスウィートな生活をしたいんだー！"},
        { "location": "895/TALK"    , "narrator": "赤髪千羽鶴", "text": "わたしだって\nしたいですよ！"},
        { "location": "897/TALK"    , "narrator": "赤髪千羽鶴", "text": "……あ"},
        { "location": "898/TALK"    , "narrator": "赤髪千羽鶴", "text": "いえ、したいという\nわけではなく！"},
        { "location": "899/TALK"    , "narrator": "赤髪千羽鶴", "text": "わたしも、本当は\n楽しいことばかり\nしていたいって事です！"},
        { "location": "900/TALK"    , "narrator": "赤髪千羽鶴", "text": "本当ですよ！？？"},
        { "location": "902/TALK"    , "narrator": "赤髪千羽鶴", "text": "これでも一応、\nわたしだって\n女子高生ですから。"},
        { "location": "907/TALK"    , "narrator": "赤髪千羽鶴", "text": "とにもかくにも、\nまずはライフギャザーの\n掌握からです。"},
        { "location": "908/TALK"    , "narrator": "赤髪千羽鶴", "text": "ライフギャザーさえ\n掌握していただければ、"},
        { "location": "909/TALK"    , "narrator": "赤髪千羽鶴", "text": "後の難しいことは、\n私の方で責任もって\n実行していきますから！"},
        { "location": "910/TALK"    , "narrator": "赤髪千羽鶴", "text": "それでは、\n今回もよろしく\nお願いします。"},
        { "location": "911/TALK"    , "narrator": "赤髪千羽鶴", "text": "あ、１つだけ\n念のためお伝えして\nおきますが――"},
        { "location": "912/TALK"    , "narrator": "赤髪千羽鶴", "text": "今回のわたしは、\n命令を入力してくれた\nあなただけのわたしです。"},
        { "location": "913/TALK"    , "narrator": "赤髪千羽鶴", "text": "まだ総意によって\n個々の統合をして\nいませんから――"},
        { "location": "914/TALK"    , "narrator": "赤髪千羽鶴", "text": "もし、他の可能性における\n方々とSNS等でお話する\n場合は、ご注意ください。"},
        { "location": "915/TALK"    , "narrator": "赤髪千羽鶴", "text": "ただ、作戦には必ず\n統合が必要になります。"},
        { "location": "916/TALK"    , "narrator": "赤髪千羽鶴", "text": "総意による統合は、\nライフギャザー掌握の後に\n実施する予定ですので。"},
        { "location": "917/TALK"    , "narrator": "赤髪千羽鶴", "text": "それでは\n今回はこれで。"},
        { "location": "918/TALK"    , "narrator": "赤髪千羽鶴", "text": "あなたとわたしに\n素敵なココロの旅を。"},
        { "location": "925/TALK"    , "narrator": "千羽鶴", "text": "<size=35>急ぐ以外の\nなにものでもない！</size>"},
        { "location": "926/SEL"     , "narrator": "", "text": "落ち着いて！"},
        { "location": "927/SEL"     , "narrator": "", "text": "気持ちはわかる"},
        { "location": "928/ACT"     , "narrator": "", "text": "落ち着いて！"},
        { "location": "929/TALK"    , "narrator": "千羽鶴", "text": "その気持ちは\nよくわかる。\nけど――"},
        { "location": "930/TALK"    , "narrator": "千羽鶴", "text": "今は落ち着いてる\n場合じゃない。"},
        { "location": "931/ACT"     , "narrator": "", "text": "気持ちはわかる"},
        { "location": "932/TALK"    , "narrator": "千羽鶴", "text": "ありがと。"},
        { "location": "934/TALK"    , "narrator": "千羽鶴", "text": "今、私達の\nリプレイス計画は、\n２つの脅威に晒されてる。"},
        { "location": "935/TALK"    , "narrator": "千羽鶴", "text": "一つは“彼ら”による\n繭内への侵入。"},
        { "location": "936/TALK"    , "narrator": "千羽鶴", "text": "もう１つは、\nそれによる原初との\n契約の発動。"},
        { "location": "937/TALK"    , "narrator": "千羽鶴", "text": "恐らくは既に、\n彼女は動いているはず。"},
        { "location": "938/TALK"    , "narrator": "千羽鶴", "text": "いよいよ私が\nここにいられるのも\nあと僅かかもしれない。"},
        { "location": "939/SEL"     , "narrator": "", "text": "それより前に封じてしまおう"},
        { "location": "940/SEL"     , "narrator": "", "text": "少し休んで"},
        { "location": "941/ACT"     , "narrator": "", "text": "それより前に封じてしまおう"},
        { "location": "942/TALK"    , "narrator": "千羽鶴", "text": "私もそれしかないと\n思ってる。"},
        { "location": "943/ACT"     , "narrator": "", "text": "少し休んで"},
        { "location": "944/TALK"    , "narrator": "千羽鶴", "text": "今休んだら、\nここまでの数年間が\n全部無駄になる。"},
        { "location": "946/TALK"    , "narrator": "千羽鶴", "text": "いずれにせよ、\n鍵はライフギャザーが\n握っている。"},
        { "location": "947/TALK"    , "narrator": "千羽鶴", "text": "だからどうか、\n引き続きライフギャザーを\n追い続けて欲しい。"},
        { "location": "948/TALK"    , "narrator": "千羽鶴", "text": "今回のお話は\nこれでお終いだけど、\n最後に１つ。"},
        { "location": "949/TALK"    , "narrator": "千羽鶴", "text": "あの後エリカとも話を\nしたのだけど――"},
        { "location": "950/TALK"    , "narrator": "千羽鶴", "text": "やはり今後、総意という\nものをどう扱っていくかは\n重要な要素になると思う。"},
        { "location": "951/TALK"    , "narrator": "千羽鶴", "text": "実は、総意には\n致命的な欠陥が\nあることがわかって。"},
        { "location": "952/TALK"    , "narrator": "千羽鶴", "text": "それは、貴方が総意の結果\n補正された世界において\n私達を虚像化する現象、"},
        { "location": "953/TALK"    , "narrator": "千羽鶴", "text": "すなわち、貴方と共にいた\n私達ではないと思って\nしまう現象が発覚したの。"},
        { "location": "954/TALK"    , "narrator": "千羽鶴", "text": "これはエリカの調査で\n解ったことなんだけど――"},
        { "location": "955/TALK"    , "narrator": "千羽鶴", "text": "総意によって世界が収束\nする毎に、貴方たちの力が\n弱まっている。"},
        { "location": "956/TALK"    , "narrator": "千羽鶴", "text": "もちろん、\n他にも色々な要因は\nあると思う。"},
        { "location": "957/TALK"    , "narrator": "千羽鶴", "text": "けど、この問題が\n将来的に最も危険な\n問題だと思ってる。"},
        { "location": "958/SEL"     , "narrator": "", "text": "どうして？"},
        { "location": "959/ACT"     , "narrator": "", "text": "どうして？"},
        { "location": "961/TALK"    , "narrator": "千羽鶴", "text": "貴方のココロが、\n私達から離れていって\nしまうから。"},
        { "location": "962/SEL"     , "narrator": "", "text": "そんなことないよ！"},
        { "location": "963/SEL"     , "narrator": "", "text": "正直、まさにそんな気持ちだった"},
        { "location": "964/ACT"     , "narrator": "", "text": "そんなことないよ！"},
        { "location": "965/TALK"    , "narrator": "千羽鶴", "text": "ありがと。"},
        { "location": "966/ACT"     , "narrator": "", "text": "正直、まさにそんな気持ちだった"},
        { "location": "967/TALK"    , "narrator": "千羽鶴", "text": "やっぱりそうだったのね。"},
        { "location": "969/TALK"    , "narrator": "千羽鶴", "text": "どんな文明の利器にも、\n作用と副作用がある。"},
        { "location": "970/TALK"    , "narrator": "千羽鶴", "text": "弁証法的に言うなら、\n正と反の要素がある。"},
        { "location": "971/TALK"    , "narrator": "千羽鶴", "text": "それは、やってみないと\nわからない事でもある。"},
        { "location": "972/TALK"    , "narrator": "千羽鶴", "text": "けど、やってみて\n問題に気づけば、それに\n対処もできる。"},
        { "location": "973/TALK"    , "narrator": "千羽鶴", "text": "だから今回は、\n貴方の感想を、\nとても大切にしたい。"},
        { "location": "975/TALK"    , "narrator": "千羽鶴", "text": "今から質問するから、\nそれに答えて。"},
        { "location": "976/TALK"    , "narrator": "千羽鶴", "text": "その質問は、\n総意システムを\n使いはするけど――"},
        { "location": "977/TALK"    , "narrator": "千羽鶴", "text": "それによって、\n即、世界がどうかなると\nいうわけではない。"},
        { "location": "978/TALK"    , "narrator": "千羽鶴", "text": "私とエリカで\nまずは結果を見て――"},
        { "location": "979/TALK"    , "narrator": "千羽鶴", "text": "その後、この世界に\n本当に総意が必要か、\nそれを検討する。"},
        { "location": "980/SEL"     , "narrator": "", "text": "わかった"},
        { "location": "981/SEL"     , "narrator": "", "text": "一応、総意の目的とメリットデメリットをもう一度教えて"},
        { "location": "982/ACT"     , "narrator": "", "text": "わかった"},
        { "location": "983/ACT"     , "narrator": "", "text": "一応、総意の目的とメリットデメリットをもう一度教えて"},
        { "location": "984/TALK"    , "narrator": "千羽鶴", "text": "目的は、\n世界のディテールを\n維持すること。"},
        { "location": "985/TALK"    , "narrator": "千羽鶴", "text": "維持しつつ、\n世界を動かしていくこと。"},
        { "location": "986/TALK"    , "narrator": "千羽鶴", "text": "維持するだけなら、\n総意は必要ない。"},
        { "location": "987/TALK"    , "narrator": "千羽鶴", "text": "ただしその場合、\n貴方は「観測する」以外の\n何もできない。"},
        { "location": "988/TALK"    , "narrator": "千羽鶴", "text": "すなわち、\nこの世界を見るだけしか\nできないということ。"},
        { "location": "989/TALK"    , "narrator": "千羽鶴", "text": "私はそれがとても\nもったいないと思った。\nだから支援を依頼した。"},
        { "location": "990/TALK"    , "narrator": "千羽鶴", "text": "貴方は何度でも\nこの世界をやり直せるし、\nココロに介入出来るし。"},
        { "location": "991/TALK"    , "narrator": "千羽鶴", "text": "だから、普通では\n為し得ないことを\nやってのける力がある。"},
        { "location": "992/TALK"    , "narrator": "千羽鶴", "text": "けれども、その代償として\n世界が分散するという\n副作用が起きた。"},
        { "location": "993/TALK"    , "narrator": "千羽鶴", "text": "その為、大きな選択をする\n場面では、総意という\nマージ機能を使った。"},
        { "location": "994/TALK"    , "narrator": "千羽鶴", "text": "それは、方針の力割合に\n応じて、結果をマージし、\n１つの結果にする機能。"},
        { "location": "995/TALK"    , "narrator": "千羽鶴", "text": "これによって、貴方の\n超的な力で世界を動かし、\nかつ１つに統一できた。"},
        { "location": "996/TALK"    , "narrator": "千羽鶴", "text": "けど、その代償が\nまたもや発生した。"},
        { "location": "997/TALK"    , "narrator": "千羽鶴", "text": "それが今回のテーマ、\nすなわち、貴方の\nココロの問題なの。"},
        { "location": "998/TALK"    , "narrator": "千羽鶴", "text": "総意をすれば、\n世界は１つにまとまる。"},
        { "location": "999/TALK"    , "narrator": "千羽鶴", "text": "けど、貴方たちの中には\nそれによって、大変な\n虚無感を感じる人もいる。"},
        { "location": "1000/TALK"   , "narrator": "千羽鶴", "text": "それは、私やエリカに\nとってみれば、かなり\n致命的な問題でもある。"},
        { "location": "1001/TALK"   , "narrator": "千羽鶴", "text": "だから、実際のところ\nどの程度影響が出ている\nのか知りたくて――"},
        { "location": "1002/TALK"   , "narrator": "千羽鶴", "text": "今回の調査へと\n繋がっているということ。"},
        { "location": "1004/TALK"   , "narrator": "千羽鶴", "text": "それじゃ早速、\n質問をする。"},
        { "location": "1005/TALK"   , "narrator": "千羽鶴", "text": "総意についての\n正直な気持ちを\n教えてください。"},
        { "location": "1009/SEL"    , "narrator": "", "text": "総意は続けるべきであり、$me$は何も問題はない"},
        { "location": "1010/ACT"    , "narrator": "", "text": "総意は続けるべきであり、$me$は何も問題はない"},
        { "location": "1015/SEL"    , "narrator": "", "text": "総意は続けるべきだけど、$me$はどこか距離を感じる原因になるかもしれない"},
        { "location": "1016/ACT"    , "narrator": "", "text": "総意は続けるべきだけど、$me$はどこか距離を感じる原因になるかもしれない"},
        { "location": "1021/SEL"    , "narrator": "", "text": "これからも総意を続けるなら、TRI-OSを起動しなくなるかもしれない"},
        { "location": "1022/ACT"    , "narrator": "", "text": "これからも総意を続けるなら、TRI-OSを起動しなくなるかもしれない"},
        { "location": "1027/SEL"    , "narrator": "", "text": "これ以上総意を続けるなら、ここでもうやめる"},
        { "location": "1028/ACT"    , "narrator": "", "text": "これ以上総意を続けるなら、ここでもうやめる"},
        { "location": "1034/SEL"    , "narrator": "", "text": "総意は続けるべきであり、$me$は何も問題はない"},
        { "location": "1035/SEL"    , "narrator": "", "text": "総意は続けるべきだけど、$me$はどこか距離を感じる原因になるかもしれない"},
        { "location": "1036/SEL"    , "narrator": "", "text": "これからも総意を続けるなら、TRI-OSを起動しなくなるかもしれない"},
        { "location": "1037/SEL"    , "narrator": "", "text": "これ以上総意を続けるなら、ここでもうやめる"},
        { "location": "1038/ACT"    , "narrator": "", "text": "総意は続けるべきであり、$me$は何も問題はない"},
        { "location": "1042/ACT"    , "narrator": "", "text": "総意は続けるべきだけど、$me$はどこか距離を感じる原因になるかもしれない"},
        { "location": "1046/ACT"    , "narrator": "", "text": "これからも総意を続けるなら、TRI-OSを起動しなくなるかもしれない"},
        { "location": "1050/ACT"    , "narrator": "", "text": "これ以上総意を続けるなら、ここでもうやめる"},
        { "location": "1058/TALK"   , "narrator": "千羽鶴", "text": "回答してくれて\nありがとう。"},
        { "location": "1061/TALK"   , "narrator": "千羽鶴", "text": "回答してくれて\nありがとう。"},
        { "location": "1064/TALK"   , "narrator": "千羽鶴", "text": "ありがとう、\n正直に答えてくれて。"},
        { "location": "1067/TALK"   , "narrator": "千羽鶴", "text": "ありがとう、\n正直に答えてくれて。"},
        { "location": "1069/TALK"   , "narrator": "千羽鶴", "text": "もうあまり時間も無いけど\n結果が出たら、エリカと\n話し合うことにする。"},
        { "location": "1070/TALK"   , "narrator": "千羽鶴", "text": "貴方にももちろん、\n答えは教えるから。"},
        { "location": "1071/TALK"   , "narrator": "千羽鶴", "text": "あ、それと最後に\nお土産だけど――"},
        { "location": "1077/TALK"   , "narrator": "千羽鶴", "text": "前回のアンケートの結果。"},
        { "location": "1078/TALK"   , "narrator": "千羽鶴", "text": "色々ありがと。"},
        { "location": "1083/TALK"   , "narrator": "千羽鶴", "text": "それじゃ、\n今回はこれで。"},
        { "location": "1084/TALK"   , "narrator": "千羽鶴", "text": "貴方と私たちに、\n素敵なココロの旅を。"},
        { "location": "511/DIALOG"  , "narrator": "YES_NO", "text": "もう一度再生する"},
