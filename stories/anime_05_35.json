        { "location": "1020/DIALOG" , "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:Chiharu】</color>\n\n既に回答は\n決定されています。"},
        { "location": "1026/DIALOG" , "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:Chiharu】</color>\n\n既に回答は\n決定されています。"},
        { "location": "1033/DIALOG" , "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:Chiharu】</color>\n\n貴方の本当の想いを、\nただ一度だけ\n私に教えてください。\n\nやり直しはできません。"},
