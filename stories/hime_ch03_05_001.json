    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "05-01_新人が怖い"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "また懺悔したいの"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "聞いてくれるかしら？"},
        { "location": "36/SEL"    , "narrator": "", "text": "ハイ喜んで"},
        { "location": "37/SEL"    , "narrator": "", "text": "何かあったの？"},
        { "location": "38/ACT"    , "narrator": "", "text": "ハイ喜んで"},
        { "location": "39/TALK"   , "narrator": "ガブリエラ", "text": "・・・なんだか軽いわね・・・"},
        { "location": "40/ACT"    , "narrator": "", "text": "何かあったの？"},
        { "location": "41/TALK"   , "narrator": "ガブリエラ", "text": "ええ・・・"},
        { "location": "43/TALK"   , "narrator": "ガブリエラ", "text": "つばめ・・・新人のことなんだけど"},
        { "location": "44/TALK"   , "narrator": "ガブリエラ", "text": "私、冷たくしてしまったのよ"},
        { "location": "45/TALK"   , "narrator": "ガブリエラ", "text": "あのこの言葉が嬉しくて"},
        { "location": "46/TALK"   , "narrator": "ガブリエラ", "text": "とても嬉しかったから"},
        { "location": "47/TALK"   , "narrator": "ガブリエラ", "text": "とても冷たい言葉で返事をしてしまったの"},
        { "location": "50/SEL"    , "narrator": "", "text": "ええと？"},
        { "location": "51/SEL"    , "narrator": "", "text": "すみませんわかりません"},
        { "location": "52/SEL"    , "narrator": "", "text": "日本語だよね……？"},
        { "location": "53/ACT"    , "narrator": "", "text": "ええと？"},
        { "location": "54/TALK"   , "narrator": "ガブリエラ", "text": "何かしら？"},
        { "location": "55/ACT"    , "narrator": "", "text": "すみませんわかりません"},
        { "location": "56/TALK"   , "narrator": "ガブリエラ", "text": "どうしてかしら？"},
        { "location": "57/ACT"    , "narrator": "", "text": "日本語だよね……？"},
        { "location": "58/TALK"   , "narrator": "ガブリエラ", "text": "日本語だわよ！？"},
        { "location": "60/TALK"   , "narrator": "ガブリエラ", "text": "マルザンナったら"},
        { "location": "61/TALK"   , "narrator": "ガブリエラ", "text": "乙女心がわからないのかしら・・・"},
        { "location": "63/SEL"    , "narrator": "", "text": "そういうことなの……？"},
        { "location": "64/SEL"    , "narrator": "", "text": "うーん……"},
        { "location": "65/SEL"    , "narrator": "", "text": "ごめんなさい、努力するわ"},
        { "location": "66/ACT"    , "narrator": "", "text": "そういうことなの……？"},
        { "location": "67/TALK"   , "narrator": "ガブリエラ", "text": "そういうことだと思うわ"},
        { "location": "68/ACT"    , "narrator": "", "text": "うーん……"},
        { "location": "69/TALK"   , "narrator": "ガブリエラ", "text": "難しいかしら・・・？"},
        { "location": "70/ACT"    , "narrator": "", "text": "ごめんなさい、努力するわ"},
        { "location": "80/TALK"   , "narrator": "ガブリエラ", "text": "ええとね"},
        { "location": "82/TALK"   , "narrator": "ガブリエラ", "text": "マルザンナを責めてるわけじゃないのよ"},
        { "location": "83/TALK"   , "narrator": "ガブリエラ", "text": "それはわかってね"},
        { "location": "85/TALK"   , "narrator": "ガブリエラ", "text": "あの子が少し怖いのよ・・・"},
        { "location": "86/TALK"   , "narrator": "ガブリエラ", "text": "もしかしたら何かが憑いていたりするんじゃないかしら？"},
        { "location": "87/TALK"   , "narrator": "ガブリエラ", "text": "あの力とか、そうじゃないかしらって思うの"},
        { "location": "88/TALK"   , "narrator": "ガブリエラ", "text": "そのこと自体より"},
        { "location": "89/TALK"   , "narrator": "ガブリエラ", "text": "それを受け入れているってことが怖い、ううん、危険なのよ"},
        { "location": "90/TALK"   , "narrator": "ガブリエラ", "text": "わかる？"},
        { "location": "92/SEL"    , "narrator": "", "text": "わかるようなわからないような"},
        { "location": "93/SEL"    , "narrator": "", "text": "考えすぎじゃない？"},
        { "location": "94/SEL"    , "narrator": "", "text": "危険は排除だね"},
        { "location": "95/ACT"    , "narrator": "", "text": "わかるようなわからないような"},
        { "location": "96/TALK"   , "narrator": "ガブリエラ", "text": "不思議な答えね"},
        { "location": "97/ACT"    , "narrator": "", "text": "考えすぎじゃない？"},
        { "location": "98/TALK"   , "narrator": "ガブリエラ", "text": "そうなのかしら・・・"},
        { "location": "99/ACT"    , "narrator": "", "text": "危険は排除だね"},
        { "location": "100/TALK"  , "narrator": "ガブリエラ", "text": "そういう意味で言ったんじゃないわ！？"},
        { "location": "102/TALK"  , "narrator": "ガブリエラ", "text": "でもね"},
        { "location": "103/TALK"  , "narrator": "ガブリエラ", "text": "あのこの人懐っこさは嫌いじゃないわ"},
        { "location": "104/TALK"  , "narrator": "ガブリエラ", "text": "それにがんばってるのも認める"},
        { "location": "105/TALK"  , "narrator": "ガブリエラ", "text": "でも話しかけられると、つい冷たいことを言ってしまうのよ"},
        { "location": "107/SEL"   , "narrator": "", "text": "ツンデレさんだね"},
        { "location": "108/SEL"   , "narrator": "", "text": "それは恋だね"},
        { "location": "109/SEL"   , "narrator": "", "text": "ガブはかわいいね"},
        { "location": "110/ACT"   , "narrator": "", "text": "ツンデレさんだね"},
        { "location": "111/TALK"  , "narrator": "ガブリエラ", "text": "マルザンナったら"},
        { "location": "112/TALK"  , "narrator": "ガブリエラ", "text": "天使なのに"},
        { "location": "113/TALK"  , "narrator": "ガブリエラ", "text": "変な言葉を知ってるのね！"},
        { "location": "114/ACT"   , "narrator": "", "text": "それは恋だね"},
        { "location": "115/TALK"  , "narrator": "ガブリエラ", "text": "違うわよ！！！！！！！！！！！！"},
        { "location": "117/TALK"  , "narrator": "ガブリエラ", "text": "だって女の子同士じゃないの！！！！"},
        { "location": "118/TALK"  , "narrator": "ガブリエラ", "text": "変なこと言わないで！！！！！"},
        { "location": "119/ACT"   , "narrator": "", "text": "ガブはかわいいね"},
        { "location": "129/TALK"  , "narrator": "ガブリエラ", "text": "そういう話じゃないのよ！！！！！"},
        { "location": "131/TALK"  , "narrator": "ガブリエラ", "text": "もう////////////////////"},
        { "location": "132/TALK"  , "narrator": "ガブリエラ", "text": "マルザンナったら//////////////"},
        { "location": "137/TALK"  , "narrator": "ガブリエラ", "text": "決めたわ"},
        { "location": "138/TALK"  , "narrator": "ガブリエラ", "text": "先輩としてビシビシ鍛えることにするわ"},
        { "location": "139/TALK"  , "narrator": "ガブリエラ", "text": "つばめのこと"},
        { "location": "140/TALK"  , "narrator": "ガブリエラ", "text": "先輩として！"},
        { "location": "76/DIALOG" , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"},
        { "location": "125/DIALOG", "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"}
    ]
}
