    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "ナイチンゲール誓詞"},
        { "location": "34/TALK"   , "narrator": "ガブリエラ", "text": "私わからないの"},
        { "location": "35/TALK"   , "narrator": "ガブリエラ", "text": "神楽がなんで"},
        { "location": "36/TALK"   , "narrator": "ガブリエラ", "text": "私の看病をしたのか"},
        { "location": "38/SEL"    , "narrator": "", "text": "辛そうだったからでしょ"},
        { "location": "39/SEL"    , "narrator": "", "text": "親切は素直に受けようよ"},
        { "location": "40/SEL"    , "narrator": "", "text": "ガブリエラが好きだから"},
        { "location": "41/ACT"    , "narrator": "", "text": "辛そうだったからでしょ"},
        { "location": "42/TALK"   , "narrator": "ガブリエラ", "text": "そうかもしれないけど"},
        { "location": "43/ACT"    , "narrator": "", "text": "親切は素直に受けようよ"},
        { "location": "44/TALK"   , "narrator": "ガブリエラ", "text": "あの時は"},
        { "location": "45/TALK"   , "narrator": "ガブリエラ", "text": "ちゃんと受けたわ"},
        { "location": "46/ACT"    , "narrator": "", "text": "ガブリエラが好きだから"},
        { "location": "47/TALK"   , "narrator": "ガブリエラ", "text": "ないわね"},
        { "location": "48/TALK"   , "narrator": "ガブリエラ", "text": "それは"},
        { "location": "49/TALK"   , "narrator": "ガブリエラ", "text": "絶対にないわ"},
        { "location": "51/TALK"   , "narrator": "ガブリエラ", "text": "神楽は私たちを裏切った"},
        { "location": "52/TALK"   , "narrator": "ガブリエラ", "text": "敵なのよ"},
        { "location": "53/TALK"   , "narrator": "ガブリエラ", "text": "なのにどうしてわざわざ看病なんてしたの？"},
        { "location": "55/SEL"    , "narrator": "", "text": "裏切り者が看病するのかな？"},
        { "location": "56/SEL"    , "narrator": "", "text": "あれは演技に見えなかった"},
        { "location": "57/SEL"    , "narrator": "", "text": "舐められてるってことか"},
        { "location": "58/ACT"    , "narrator": "", "text": "裏切り者が看病するのかな？"},
        { "location": "60/TALK"   , "narrator": "ガブリエラ", "text": "そんなの"},
        { "location": "62/TALK"   , "narrator": "ガブリエラ", "text": "知らないわ"},
        { "location": "65/TALK"   , "narrator": "ガブリエラ", "text": "もしかしたら"},
        { "location": "66/TALK"   , "narrator": "ガブリエラ", "text": "なめられてたのかもしれないし"},
        { "location": "67/TALK"   , "narrator": "ガブリエラ", "text": "あーもう！"},
        { "location": "68/ACT"    , "narrator": "", "text": "あれは演技に見えなかった"},
        { "location": "71/TALK"   , "narrator": "ガブリエラ", "text": "そうは見えなくても"},
        { "location": "72/TALK"   , "narrator": "ガブリエラ", "text": "結局演技よ"},
        { "location": "73/TALK"   , "narrator": "ガブリエラ", "text": "だって神楽は"},
        { "location": "76/TALK"   , "narrator": "ガブリエラ", "text": "ううん"},
        { "location": "77/TALK"   , "narrator": "ガブリエラ", "text": "そんなこと言っても"},
        { "location": "78/TALK"   , "narrator": "ガブリエラ", "text": "仕方ないわよね"},
        { "location": "80/TALK"   , "narrator": "ガブリエラ", "text": "今となっては"},
        { "location": "81/ACT"    , "narrator": "", "text": "舐められてるってことか"},
        { "location": "83/TALK"   , "narrator": "ガブリエラ", "text": "そうなんでしょうね"},
        { "location": "84/TALK"   , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "87/TALK"   , "narrator": "ガブリエラ", "text": "ううん"},
        { "location": "88/TALK"   , "narrator": "ガブリエラ", "text": "甘いことを考えるのは無駄よ"},
        { "location": "89/TALK"   , "narrator": "ガブリエラ", "text": "だって神楽は敵なんだから"},
        { "location": "90/TALK"   , "narrator": "ガブリエラ", "text": "敵なのよ"},
        { "location": "91/TALK"   , "narrator": "ガブリエラ", "text": "神楽は"}
    ]
}
