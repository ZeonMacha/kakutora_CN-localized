        { "location": "8487/SCENARIO", "narrator": "", "text": "パスワードを教えて"},
        { "location": "8512/TALK"    , "narrator": "神楽", "text": "$handle$のココロを開くパスワードを教えてほしいな★"},
        { "location": "8514/SEL"     , "narrator": "", "text": "ソーシャルハッキングだ"},
        { "location": "8515/SEL"     , "narrator": "", "text": "kagura.ai-shiteru"},
        { "location": "8516/SEL"     , "narrator": "", "text": "それは遠慮させて"},
        { "location": "8517/ACT"     , "narrator": "", "text": "ソーシャルハッキングだ"},
        { "location": "8518/TALK"    , "narrator": "神楽", "text": "そういうことになるのかな？？？"},
        { "location": "8519/TALK"    , "narrator": "神楽", "text": "まあ気にしないで教えて？"},
        { "location": "8522/TALK"    , "narrator": "神楽", "text": "ぐふ♪"},
        { "location": "8523/TALK"    , "narrator": "神楽", "text": "そんな本当のことをパスワードになんかしたら"},
        { "location": "8525/TALK"    , "narrator": "神楽", "text": "あっという間にクラックされちゃうんだから"},
        { "location": "8526/TALK"    , "narrator": "神楽", "text": "主にぴょんこが！"},
        { "location": "8527/ACT"     , "narrator": "", "text": "それは遠慮させて"},
        { "location": "8528/TALK"    , "narrator": "神楽", "text": "えーけち"},
        { "location": "8529/TALK"    , "narrator": "神楽", "text": "ケチケチケチケチ！"},
        { "location": "8531/TALK"    , "narrator": "神楽", "text": "なんていうかね、、、？"},
        { "location": "8532/TALK"    , "narrator": "神楽", "text": "二人だけの秘密がほしいぴょん？"},
        { "location": "8534/SEL"     , "narrator": "", "text": "隠し事なんてないよ？"},
        { "location": "8535/SEL"     , "narrator": "", "text": "そういうのもいいね"},
        { "location": "8536/SEL"     , "narrator": "", "text": "もういっぱいあると思うんだけどな"},
        { "location": "8537/ACT"     , "narrator": "", "text": "隠し事なんてないよ？"},
        { "location": "8538/TALK"    , "narrator": "神楽", "text": "$handle$はオープンな人なんだ"},
        { "location": "8539/TALK"    , "narrator": "神楽", "text": "なるほどねー"},
        { "location": "8540/ACT"     , "narrator": "", "text": "そういうのもいいね"},
        { "location": "8541/TALK"    , "narrator": "神楽", "text": "可能性の一つってところなのかな？"},
        { "location": "8542/TALK"    , "narrator": "神楽", "text": "わかったー"},
        { "location": "8543/ACT"     , "narrator": "", "text": "もういっぱいあると思うんだけどな"},
        { "location": "8545/TALK"    , "narrator": "神楽", "text": "そんなことないぴょん！"},
        { "location": "8546/TALK"    , "narrator": "神楽", "text": "全然足りないぴょん！！！"},
        { "location": "8547/TALK"    , "narrator": "神楽", "text": "もっといっぱいほしいんだぴょん！！！"},
        { "location": "8548/TALK"    , "narrator": "神楽", "text": "そういうもんでしょー"},
        { "location": "8549/TALK"    , "narrator": "神楽", "text": "もーもーもーもー！"},
        { "location": "8550/TALK"    , "narrator": "神楽", "text": "乙女心わかってよ$handle$！"}
