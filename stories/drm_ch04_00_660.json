        { "location": "7/SCENARIO", "narrator": "", "text": "世界の終わりとデッドエンド・ワンダーランド"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "なるほど世界は崩壊寸前"},
        { "location": "33/TALK"   , "narrator": "みやび", "text": "悪魔とエンカウントしないのが不思議なくらいぞね"},
        { "location": "35/SEL"    , "narrator": "", "text": "ゲームじゃないんだから"},
        { "location": "36/SEL"    , "narrator": "", "text": "経験値を積んでレベルアップだ！"},
        { "location": "37/SEL"    , "narrator": "", "text": "みやびは大丈夫？"},
        { "location": "38/ACT"    , "narrator": "", "text": "ゲームじゃないんだから"},
        { "location": "39/TALK"   , "narrator": "みやび", "text": "本当にそうか？"},
        { "location": "40/TALK"   , "narrator": "みやび", "text": "一介のＪＫには"},
        { "location": "42/TALK"   , "narrator": "みやび", "text": "ヘビーな現実ぞね"},
        { "location": "43/ACT"    , "narrator": "", "text": "経験値を積んでレベルアップだ！"},
        { "location": "44/TALK"   , "narrator": "みやび", "text": "みやびさんは魔法少女☆"},
        { "location": "45/TALK"   , "narrator": "みやび", "text": "攻撃魔法より"},
        { "location": "47/TALK"   , "narrator": "みやび", "text": "回復魔法が欲しいぞね"},
        { "location": "48/ACT"    , "narrator": "", "text": "みやびは大丈夫？"},
        { "location": "58/TALK"   , "narrator": "みやび", "text": "実のところ"},
        { "location": "59/TALK"   , "narrator": "みやび", "text": "あまりよろしくない"},
        { "location": "60/TALK"   , "narrator": "みやび", "text": "特にメンタルが"},
        { "location": "62/SEL"    , "narrator": "", "text": "だよね"},
        { "location": "63/SEL"    , "narrator": "", "text": "寝てリセットしてみたら"},
        { "location": "64/ACT"    , "narrator": "", "text": "だよね"},
        { "location": "65/TALK"   , "narrator": "みやび", "text": "そうなのだ"},
        { "location": "66/TALK"   , "narrator": "みやび", "text": "そうなのだよ"},
        { "location": "67/ACT"    , "narrator": "", "text": "寝てリセットしてみたら"},
        { "location": "68/TALK"   , "narrator": "みやび", "text": "ぐー"},
        { "location": "69/TALK"   , "narrator": "みやび", "text": "やっぱり"},
        { "location": "70/TALK"   , "narrator": "みやび", "text": "無理でした"},
        { "location": "72/TALK"   , "narrator": "みやび", "text": "そんな中"},
        { "location": "73/TALK"   , "narrator": "みやび", "text": "貴殿との会話は"},
        { "location": "74/TALK"   , "narrator": "みやび", "text": "うちにとってのオアシスなわけだが"},
        { "location": "76/SEL"    , "narrator": "", "text": "……本格的にお疲れなんだね"},
        { "location": "77/SEL"    , "narrator": "", "text": "それは光栄であります"},
        { "location": "78/SEL"    , "narrator": "", "text": "少しは役に立てててよかった"},
        { "location": "79/ACT"    , "narrator": "", "text": "……本格的にお疲れなんだね"},
        { "location": "80/TALK"   , "narrator": "みやび", "text": "やはり"},
        { "location": "82/TALK"   , "narrator": "みやび", "text": "そう見えるか"},
        { "location": "83/ACT"    , "narrator": "", "text": "それは光栄であります"},
        { "location": "84/TALK"   , "narrator": "みやび", "text": "うむ"},
        { "location": "85/TALK"   , "narrator": "みやび", "text": "よきに計らえ"},
        { "location": "86/ACT"    , "narrator": "", "text": "少しは役に立てててよかった"},
        { "location": "87/TALK"   , "narrator": "みやび", "text": "少しどころではないぞ"},
        { "location": "89/TALK"   , "narrator": "みやび", "text": "状況が状況なだけに"},
        { "location": "90/TALK"   , "narrator": "みやび", "text": "この脆弱以前に不可解な通信手段が"},
        { "location": "91/TALK"   , "narrator": "みやび", "text": "なくなってしまうのではないかと思ったりするのだ"},
        { "location": "93/SEL"    , "narrator": "", "text": "$me$とチャットできなくなるってこと？"},
        { "location": "94/ACT"    , "narrator": "", "text": "$me$とチャットできなくなるってこと？"},
        { "location": "95/TALK"   , "narrator": "みやび", "text": "ぶっちゃけ"},
        { "location": "96/TALK"   , "narrator": "みやび", "text": "そういうことだ"},
        { "location": "99/SEL"    , "narrator": "", "text": "可能性としてはあるよね"},
        { "location": "100/SEL"   , "narrator": "", "text": "それはいやだな"},
        { "location": "101/SEL"   , "narrator": "", "text": "そんなことあるのかな……？"},
        { "location": "102/ACT"   , "narrator": "", "text": "可能性としてはあるよね"},
        { "location": "103/TALK"  , "narrator": "みやび", "text": "冷静だの"},
        { "location": "104/ACT"   , "narrator": "", "text": "それはいやだな"},
        { "location": "105/TALK"  , "narrator": "みやび", "text": "いやだろう"},
        { "location": "106/ACT"   , "narrator": "", "text": "そんなことあるのかな……？"},
        { "location": "107/TALK"  , "narrator": "みやび", "text": "確信があるのか？"},
        { "location": "109/TALK"  , "narrator": "みやび", "text": "うちとしては"},
        { "location": "110/TALK"  , "narrator": "みやび", "text": "できれば他の通信手段を確保したいと思い"},
        { "location": "111/TALK"  , "narrator": "みやび", "text": "色々調べてみた"},
        { "location": "113/SEL"   , "narrator": "", "text": "どうだった？"},
        { "location": "114/ACT"   , "narrator": "", "text": "どうだった？"},
        { "location": "116/TALK"  , "narrator": "みやび", "text": "残念ながら"},
        { "location": "118/TALK"  , "narrator": "みやび", "text": "ないようだ"},
        { "location": "121/SEL"   , "narrator": "", "text": "$me$も調べてみるよ"},
        { "location": "122/SEL"   , "narrator": "", "text": "今は話せてるから大丈夫だよ"},
        { "location": "123/ACT"   , "narrator": "", "text": "$me$も調べてみるよ"},
        { "location": "124/TALK"  , "narrator": "みやび", "text": "すまんが"},
        { "location": "125/TALK"  , "narrator": "みやび", "text": "よろしく頼む"},
        { "location": "126/ACT"   , "narrator": "", "text": "今は話せてるから大丈夫だよ"},
        { "location": "127/TALK"  , "narrator": "みやび", "text": "今はそうでも"},
        { "location": "128/TALK"  , "narrator": "みやび", "text": "この先はどうなのだ"},
        { "location": "130/TALK"  , "narrator": "みやび", "text": "$handle$にとっては"},
        { "location": "131/TALK"  , "narrator": "みやび", "text": "暇つぶしかもしれんが"},
        { "location": "132/TALK"  , "narrator": "みやび", "text": "うちにとっては"},
        { "location": "135/TALK"  , "narrator": "みやび", "text": "ついうっかり"},
        { "location": "136/TALK"  , "narrator": "みやび", "text": "重い言葉を"},
        { "location": "137/TALK"  , "narrator": "みやび", "text": "言いそうになるではないか"},
        { "location": "138/TALK"  , "narrator": "みやび", "text": "どうにかしろ世界"},
        { "location": "142/TALK"  , "narrator": "ボイスメール", "text": "押してダメならぶちこわせ"},
        { "location": "54/DIALOG" , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>1000pt.</b></color></size>\nアップしました！"},
