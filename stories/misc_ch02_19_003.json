    "entry":
    [
        { "location": "146/SCENARIO", "narrator": "", "text": "030_キッチン・シンク"},
        { "location": "174/TALK"    , "narrator": "アーヤ", "text": "一切合切"},
        { "location": "176/SEL"     , "narrator": "", "text": "日本語でお願いします"},
        { "location": "177/SEL"     , "narrator": "", "text": "成句表現だ"},
        { "location": "178/SEL"     , "narrator": "", "text": "ありとあらゆる物、思い付くもの全部"},
        { "location": "179/ACT"     , "narrator": "", "text": "日本語でお願いします"},
        { "location": "180/TALK"    , "narrator": "アーヤ", "text": "やっぱり？"},
        { "location": "181/ACT"     , "narrator": "", "text": "成句表現だ"},
        { "location": "182/TALK"    , "narrator": "アーヤ", "text": "そうそれ"},
        { "location": "183/ACT"     , "narrator": "", "text": "ありとあらゆる物、思い付くもの全部"},
        { "location": "185/TALK"    , "narrator": "アーヤ", "text": "そうそう"},
        { "location": "187/TALK"    , "narrator": "アーヤ", "text": "ニュアンスとしてはそういう感じ"},
        { "location": "188/TALK"    , "narrator": "アーヤ", "text": "って"},
        { "location": "189/TALK"    , "narrator": "アーヤ", "text": "辞書で読んだだけだけど"},
        { "location": "191/TALK"    , "narrator": "アーヤ", "text": "って"},
        { "location": "192/TALK"    , "narrator": "アーヤ", "text": "成句表現であるけど"},
        { "location": "193/TALK"    , "narrator": "アーヤ", "text": "ほんとはｋっちじゃなくて"},
        { "location": "194/TALK"    , "narrator": "アーヤ", "text": "こっちじゃなくて"},
        { "location": "195/TALK"    , "narrator": "アーヤ", "text": "映画の方のkitchen-sink"},
        { "location": "196/TALK"    , "narrator": "アーヤ", "text": "わからなくて"},
        { "location": "198/TALK"    , "narrator": "アーヤ", "text": "意味を探したのよ"},
        { "location": "200/SEL"     , "narrator": "", "text": "なんだったの"},
        { "location": "201/SEL"     , "narrator": "", "text": "知らなかったんだ"},
        { "location": "202/SEL"     , "narrator": "", "text": "日常をあるがままに、だね"},
        { "location": "203/ACT"     , "narrator": "", "text": "なんだったの"},
        { "location": "204/TALK"    , "narrator": "アーヤ", "text": "どうしようかな"},
        { "location": "205/TALK"    , "narrator": "アーヤ", "text": "やっぱり教えない"},
        { "location": "206/TALK"    , "narrator": "アーヤ", "text": "じゃあね"},
        { "location": "207/ACT"     , "narrator": "", "text": "知らなかったんだ"},
        { "location": "208/TALK"    , "narrator": "アーヤ", "text": "あれ"},
        { "location": "209/TALK"    , "narrator": "アーヤ", "text": "自分だって知らないわよね"},
        { "location": "210/TALK"    , "narrator": "アーヤ", "text": "って"},
        { "location": "211/TALK"    , "narrator": "アーヤ", "text": "知ってるかもしれないけど"},
        { "location": "212/ACT"     , "narrator": "", "text": "日常をあるがままに、だね"},
        { "location": "214/TALK"    , "narrator": "アーヤ", "text": "そうそう"},
        { "location": "216/TALK"    , "narrator": "アーヤ", "text": "派手な話じゃなくてじんわり沁みるみたいな映画とか"},
        { "location": "217/TALK"    , "narrator": "アーヤ", "text": "でもまあ"},
        { "location": "218/TALK"    , "narrator": "アーヤ", "text": "面白くない"},
        { "location": "220/TALK"    , "narrator": "アーヤ", "text": "中々むつかしいわね"}
    ]
}
