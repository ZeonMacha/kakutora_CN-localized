{
    "dir": "chap05/daydra/dd_ch02_05_030.js",
    "type": "MainStory",
    "info": {
        "story_id": "5258",
        "cid": "ayami",
        "title": "Extra008 プレミアムストーリー",
        "sub_title": "捨て猫"
    },
    "entry":
    [
        { "location": "525/SCENARIO", "narrator": "", "text": "捨て猫"},
        { "location": "554/TALK"    , "narrator": "ガブリエラ", "text": "大変、大変よ！"},
        { "location": "558/TALK"    , "narrator": "アーヤ", "text": "どうしたの？\nそんなに慌てて…。"},
        { "location": "560/TALK"    , "narrator": "ガブリエラ", "text": "猫、猫が…！"},
        { "location": "562/TALK"    , "narrator": "ガブリエラ", "text": "劇場の前に子猫が\n捨てられてたの！"},
        { "location": "564/TALK"    , "narrator": "アーヤ", "text": "えぇっ！？"},
        { "location": "565/TALK"    , "narrator": "真幌", "text": "本当か！？"},
        { "location": "566/TALK"    , "narrator": "真幌", "text": "まったく、\nよりにもよって\n何故うちの劇場に…。"},
        { "location": "569/TALK"    , "narrator": "アーヤ", "text": "映画館なら、人の目に\n付きやすいと思ったから\nじゃないですか？"},
        { "location": "572/TALK"    , "narrator": "真幌", "text": "だとしたら捨てる劇場を\n間違えているだろ。"},
        { "location": "573/TALK"    , "narrator": "真幌", "text": "うちみたいな寂れた所\nではなく、もっと大きな\nところに捨てるべきだ。"},
        { "location": "574/TALK"    , "narrator": "アーヤ", "text": "…悲しくなるようなこと\n言わないでください。"},
        { "location": "577/TALK"    , "narrator": "ガブリエラ", "text": "ねえ、まほ。\nうちで飼おうよ。"},
        { "location": "578/TALK"    , "narrator": "ガブリエラ", "text": "看板猫ってことにすれば\nきっと猫目当てで来る\n人も増えると思うし…。"},
        { "location": "581/TALK"    , "narrator": "真幌", "text": "猫一匹で客が増える\nほど劇場運営は\nラクなものじゃない。"},
        { "location": "582/TALK"    , "narrator": "真幌", "text": "元いたところに\n戻して来い！"},
        { "location": "585/TALK"    , "narrator": "ガブリエラ", "text": "それってここだけど、\n飼っていいの？"},
        { "location": "587/TALK"    , "narrator": "真幌", "text": "くそっ、ややこしいな！"},
        { "location": "591/TALK"    , "narrator": "アーヤ", "text": "…どうしよう？"},
        { "location": "603/TALK"    , "narrator": "アーヤ", "text": "大変なことになっちゃった"},
        { "location": "604/TALK"    , "narrator": "アーヤ", "text": "劇場の前に猫が捨てられてたんだけど"},
        { "location": "605/TALK"    , "narrator": "アーヤ", "text": "うちじゃ飼えないし…"},
        { "location": "606/TALK"    , "narrator": "アーヤ", "text": "でも、"},
        { "location": "607/TALK"    , "narrator": "アーヤ", "text": "保健所なんて選択肢は絶対になし！！(｀Д´)"},
        { "location": "608/TALK"    , "narrator": "アーヤ", "text": "ワガママ言ってるのはわかってるけど"},
        { "location": "609/TALK"    , "narrator": "アーヤ", "text": "どうしよう…(-ω-;)"},
        { "location": "611/SEL"     , "narrator": "", "text": "保護団体に連絡しよう"},
        { "location": "612/SEL"     , "narrator": "", "text": "友達に飼えるか聞こう"},
        { "location": "613/SEL"     , "narrator": "", "text": "劇場で飼おう！！"},
        { "location": "614/ACT"     , "narrator": "", "text": "保護団体に連絡しよう"},
        { "location": "624/TALK"    , "narrator": "アーヤ", "text": "それって里親を見つけてくれる団体のことよね？"},
        { "location": "625/TALK"    , "narrator": "アーヤ", "text": "そういうところなら、一つだけ心当たりがあるの(ﾟｰﾟ)"},
        { "location": "638/TALK"    , "narrator": "真幌", "text": "とにかくうちはダメだ！\n劇場でなど\n飼えるわけがない！"},
        { "location": "639/TALK"    , "narrator": "ガブリエラ", "text": "迷惑掛けないように\nするってば！"},
        { "location": "643/TALK"    , "narrator": "アーヤ", "text": "あ、あの！"},
        { "location": "644/TALK"    , "narrator": "アーヤ", "text": "動物の里親を見つけて\nくれる団体を知ってる\nので――"},
        { "location": "645/TALK"    , "narrator": "アーヤ", "text": "そこに引き取りに来て\nもらう、っていうのは\nどうですか？"},
        { "location": "649/TALK"    , "narrator": "ガブリエラ", "text": "えっ！？"},
        { "location": "652/TALK"    , "narrator": "真幌", "text": "そんな団体があるのか？"},
        { "location": "653/TALK"    , "narrator": "アーヤ", "text": "はい。保健所と違って、\nちゃんと里親を見つけて\nくれるところなんです。"},
        { "location": "655/TALK"    , "narrator": "アーヤ", "text": "詳しく説明すると、\nまず――。"},
        { "location": "658/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "664/TALK"    , "narrator": "ガブリエラ", "text": "マルザンナ、どうしよう…"},
        { "location": "665/TALK"    , "narrator": "ガブリエラ", "text": "劇場前に捨てられてた猫、うちで飼いたいのに"},
        { "location": "666/TALK"    , "narrator": "ガブリエラ", "text": "このままじゃ里親に出されてしまいそうなの"},
        { "location": "668/SEL"     , "narrator": "", "text": "その方が猫は幸せだよ"},
        { "location": "669/SEL"     , "narrator": "", "text": "絶対飼うと言い続けろ"},
        { "location": "670/ACT"     , "narrator": "", "text": "その方が猫は幸せだよ"},
        { "location": "671/TALK"    , "narrator": "ガブリエラ", "text": "酷い！"},
        { "location": "672/TALK"    , "narrator": "ガブリエラ", "text": "マルザンナは私の味方してくれると思ったのに！"},
        { "location": "683/TALK"    , "narrator": "アーヤ", "text": "…という団体なんです。\nそこで犬を迎えた友達も\nいるんです。"},
        { "location": "685/TALK"    , "narrator": "真幌", "text": "なるほどな。よし、\nすぐに連絡しよう。"},
        { "location": "687/TALK"    , "narrator": "アーヤ", "text": "わかりました。\nギャヴィも、それなら\n文句ないでしょ？"},
        { "location": "692/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "693/TALK"    , "narrator": "アーヤ", "text": "ギャヴィ？"},
        { "location": "695/TALK"    , "narrator": "ガブリエラ", "text": "そ、そこに行けば…\n絶対幸せになれる？"},
        { "location": "696/TALK"    , "narrator": "アーヤ", "text": "…子猫なら引き取り手も\nすぐ見つかるし、\n可能性は高いと思うわ。"},
        { "location": "698/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "702/TALK"    , "narrator": "ガブリエラ", "text": "わかったわよ。\n飼えないのは\n残念だけど――"},
        { "location": "705/TALK"    , "narrator": "ガブリエラ", "text": "猫が幸せになって\nくれるなら、諦めるわ。"},
        { "location": "707/TALK"    , "narrator": "アーヤ", "text": "じゃあ、\n早速連絡しますね。"},
        { "location": "711/TALK"    , "narrator": "ガブリエラ", "text": "…飼いたかったなぁ。"},
        { "location": "714/TALK"    , "narrator": "アーヤ", "text": "…気持ちは\nわからなくも\nないけどね。"},
        { "location": "715/ACT"     , "narrator": "", "text": "絶対飼うと言い続けろ"},
        { "location": "716/TALK"    , "narrator": "ガブリエラ", "text": "さすがはマルザンナ"},
        { "location": "717/TALK"    , "narrator": "ガブリエラ", "text": "気持ちはいつも一緒ね！"},
        { "location": "728/TALK"    , "narrator": "アーヤ", "text": "…という団体なんです。\nそこで犬を迎えた友達も\nいるんです。"},
        { "location": "730/TALK"    , "narrator": "真幌", "text": "なるほどな。\nよし、すぐに連絡しよう。"},
        { "location": "732/TALK"    , "narrator": "アーヤ", "text": "わかりました。\nギャヴィも、それなら\n文句ないでしょ？"},
        { "location": "737/TALK"    , "narrator": "ガブリエラ", "text": "ある！"},
        { "location": "738/TALK"    , "narrator": "ガブリエラ", "text": "そこから、どんな人に\n引き取られるかは\nわからないでしょ？"},
        { "location": "739/TALK"    , "narrator": "ガブリエラ", "text": "そんな危ないこと\nさせられないわ。"},
        { "location": "741/TALK"    , "narrator": "アーヤ", "text": "引き取るための条件が\nちゃんとあるから、\nその心配はないって。"},
        { "location": "743/TALK"    , "narrator": "ガブリエラ", "text": "でも、相手がウソをつく\nこともあるんだから、\n絶対じゃないでしょ？"},
        { "location": "745/TALK"    , "narrator": "ガブリエラ", "text": "だから絶対に反対よ。"},
        { "location": "746/TALK"    , "narrator": "アーヤ", "text": "まったく、子供じゃ\nないんだから…。"},
        { "location": "750/TALK"    , "narrator": "真幌", "text": "…つまり。"},
        { "location": "751/TALK"    , "narrator": "真幌", "text": "猫を引き取る相手を、\n信頼できる確かな\n証拠があれば――"},
        { "location": "752/TALK"    , "narrator": "真幌", "text": "そのときは\n諦めるんだな？"},
        { "location": "754/TALK"    , "narrator": "ガブリエラ", "text": "ええ、そんな相手が\nいるなら諦めるわ。"},
        { "location": "755/TALK"    , "narrator": "真幌", "text": "なら、情報管理庁に\n一人アテがある。\n連絡してみよう。"},
        { "location": "756/TALK"    , "narrator": "ガブリエラ", "text": "えっ…。"},
        { "location": "757/TALK"    , "narrator": "真幌", "text": "情報管理庁の\n官僚だから身分も\nしっかりしている。"},
        { "location": "758/TALK"    , "narrator": "真幌", "text": "それに、少し前に\n飼い猫を亡くした\nばかりで――"},
        { "location": "759/TALK"    , "narrator": "真幌", "text": "新しい家族を迎えたいと\nぼやいていたからな。"},
        { "location": "760/TALK"    , "narrator": "真幌", "text": "連絡すれば、間違いなく\n引き取ってもらえる\nはずだ。"},
        { "location": "763/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "764/TALK"    , "narrator": "真幌", "text": "文句はないな？"},
        { "location": "765/TALK"    , "narrator": "ガブリエラ", "text": "情報管理庁の官僚…。"},
        { "location": "767/TALK"    , "narrator": "ガブリエラ", "text": "そんな人に\n飼われるなら、\n文句は言えないわ。"},
        { "location": "769/TALK"    , "narrator": "アーヤ", "text": "…そうね。私達が飼う\nよりも、ずっと幸せに\nしてくれそうだし。"},
        { "location": "770/TALK"    , "narrator": "真幌", "text": "確実にな。\nじゃあ、早速連絡しよう。"},
        { "location": "774/TALK"    , "narrator": "アーヤ", "text": "…うちで飼えてたら、\n絶対毎日楽しかった\nだろうなぁ…。"},
        { "location": "777/ACT"     , "narrator": "", "text": "友達に飼えるか聞こう"},
        { "location": "778/TALK"    , "narrator": "アーヤ", "text": "そうね"},
        { "location": "779/TALK"    , "narrator": "アーヤ", "text": "何人かにＷＡＶＥを送ってみるわ"},
        { "location": "783/TALK"    , "narrator": "アーヤ", "text": "えっと、大学関係者の\nアドレスは、っと…。"},
        { "location": "785/TALK"    , "narrator": "真幌", "text": "ギャヴィ、ワガママは\nいい加減にしろ。"},
        { "location": "786/TALK"    , "narrator": "真幌", "text": "うちの劇場で飼うなんて\n絶対に許さんぞ。"},
        { "location": "788/TALK"    , "narrator": "ガブリエラ", "text": "いいじゃない！\n猫の一匹や二匹くらい。"},
        { "location": "789/TALK"    , "narrator": "真幌", "text": "世話はどうする？\nおまえ一人で出来るのか？"},
        { "location": "790/TALK"    , "narrator": "真幌", "text": "エサ代や病院代、\nトイレの砂、他にも\nまだまだ必要だぞ？"},
        { "location": "792/TALK"    , "narrator": "ガブリエラ", "text": "あたしのお給料から\n出すわよ。それくらい\n安いものだし。"},
        { "location": "793/TALK"    , "narrator": "真幌", "text": "…まったく！\n金持ったガキってのは\n面倒だな！"},
        { "location": "798/TALK"    , "narrator": "アーヤ", "text": "二人とも、\nそろそろケンカは\nやめてください。"},
        { "location": "799/TALK"    , "narrator": "アーヤ", "text": "今、猫を飼いたいって\n友達が見つかったので。"},
        { "location": "801/TALK"    , "narrator": "ガブリエラ", "text": "えっ！？"},
        { "location": "803/TALK"    , "narrator": "真幌", "text": "さすがだな。\n驚くほど迅速な対応だ。"},
        { "location": "804/TALK"    , "narrator": "ガブリエラ", "text": "だ、誰なのそれ！？\n変なヤツじゃない\nでしょうね！"},
        { "location": "806/TALK"    , "narrator": "アーヤ", "text": "大学の友達よ。"},
        { "location": "807/TALK"    , "narrator": "アーヤ", "text": "ちょうど、猫を\n飼いたいって家族と\n話していたんですって。"},
        { "location": "808/TALK"    , "narrator": "真幌", "text": "良いタイミングだな。\nよし、その友人宅に\n引き取ってもらおう。"},
        { "location": "810/TALK"    , "narrator": "アーヤ", "text": "ギャヴィも、それでいい？"},
        { "location": "815/TALK"    , "narrator": "ガブリエラ", "text": "…その人って、\n動物のこと\n好きな人？"},
        { "location": "816/TALK"    , "narrator": "アーヤ", "text": "ええ、とってもね。"},
        { "location": "817/TALK"    , "narrator": "アーヤ", "text": "猫を飼うのも初めてじゃ\nないっていうから――"},
        { "location": "818/TALK"    , "narrator": "アーヤ", "text": "きっと、幸せに育てて\nくれるはずよ。"},
        { "location": "823/TALK"    , "narrator": "ガブリエラ", "text": "そっか…それなら、\nあたしも賛成よ。"},
        { "location": "824/TALK"    , "narrator": "ガブリエラ", "text": "そんな人達に飼って\nもらえるなら安心ね。"},
        { "location": "826/TALK"    , "narrator": "アーヤ", "text": "じゃあ、決まりね。\n早速連絡しておくわ。"},
        { "location": "827/ACT"     , "narrator": "", "text": "劇場で飼おう！！"},
        { "location": "838/TALK"    , "narrator": "アーヤ", "text": "そりゃ、私だって出来れば飼いたいけど…"},
        { "location": "839/TALK"    , "narrator": "アーヤ", "text": "…本音言ったら、我慢できなくなってきちゃったじゃない！(＞0＜)"},
        { "location": "840/TALK"    , "narrator": "アーヤ", "text": "ギャヴィだけじゃなくて、私も飼いたいって言えば"},
        { "location": "841/TALK"    , "narrator": "アーヤ", "text": "館長も考え直してくれるかも"},
        { "location": "853/TALK"    , "narrator": "真幌", "text": "ギャヴィ、ワガママは\nいい加減にしろ。"},
        { "location": "854/TALK"    , "narrator": "真幌", "text": "うちの劇場で飼うなんて\n絶対に許さんぞ。"},
        { "location": "857/TALK"    , "narrator": "ガブリエラ", "text": "いいじゃない！\n猫の一匹や二匹くらい。"},
        { "location": "858/TALK"    , "narrator": "真幌", "text": "世話はどうする？\nおまえ一人で出来るのか？"},
        { "location": "859/TALK"    , "narrator": "真幌", "text": "エサ代や病院代、\nトイレの砂、他にも\nまだまだ必要だぞ？"},
        { "location": "861/TALK"    , "narrator": "ガブリエラ", "text": "あたしのお給料から\n出すわよ。それくらい\n安いものだし。"},
        { "location": "865/TALK"    , "narrator": "アーヤ", "text": "私も出すわ。"},
        { "location": "868/TALK"    , "narrator": "真幌", "text": "なっ、アーヤ！？"},
        { "location": "870/TALK"    , "narrator": "アーヤ", "text": "私も猫飼いたいです！\n可愛くて良いじゃない\nですか！"},
        { "location": "871/TALK"    , "narrator": "ガブリエラ", "text": "ほら、アーヤも\nこう言ってるし！"},
        { "location": "873/TALK"    , "narrator": "真幌", "text": "…………。"},
        { "location": "875/TALK"    , "narrator": "真幌", "text": "その猫をおまえ達が\n飼うっていうのか！？"},
        { "location": "876/TALK"    , "narrator": "アーヤ", "text": "そうです！"},
        { "location": "877/TALK"    , "narrator": "ガブリエラ", "text": "そうに\n決まってるじゃん。"},
        { "location": "878/TALK"    , "narrator": "真幌", "text": "なるほど…。"},
        { "location": "879/TALK"    , "narrator": "真幌", "text": "実は、情報管理庁の\n官僚に、猫好きが\n一人いるんだ。"},
        { "location": "881/TALK"    , "narrator": "ガブリエラ", "text": "えっ…。"},
        { "location": "883/TALK"    , "narrator": "真幌", "text": "しかも、少し前に\n飼い猫を亡くした\nばかりで――"},
        { "location": "884/TALK"    , "narrator": "真幌", "text": "新しい家族を迎えたいと\nぼやいていたからな。"},
        { "location": "885/TALK"    , "narrator": "真幌", "text": "連絡すれば、間違いなく\n引き取ってもらえる\nはずだ。"},
        { "location": "886/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "887/TALK"    , "narrator": "真幌", "text": "家族揃って猫好き\nらしく、幸せに\n暮らせることだろう。"},
        { "location": "888/TALK"    , "narrator": "真幌", "text": "…それなら文句はないな？"},
        { "location": "892/TALK"    , "narrator": "ガブリエラ", "text": "…諦めるしかないわね。"},
        { "location": "896/TALK"    , "narrator": "アーヤ", "text": "…そうね。私達が飼う\nよりも、ずっと幸せに\nしてくれそうだし。"},
        { "location": "899/TALK"    , "narrator": "真幌", "text": "決まりだな。\n早速連絡するとしよう。"},
        { "location": "902/TALK"    , "narrator": "ガブリエラ", "text": "グスッ…\n飼いたかったなぁ…。"},
        { "location": "904/TALK"    , "narrator": "アーヤ", "text": "…いつか寮を出たら、\n絶対猫飼おう。"},
        { "location": "534/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>5月14日　3:26 PM</color>\nある日の午後、神楽坂\nトライナリーの楽屋にて。"},
        { "location": "620/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"},
        { "location": "834/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"},
        { "location": "915/DIALOG"  , "narrator": "Dialog_GEThimegoto_ch02", "text": "【いつかモフれる日が来たら】"}
    ]
}
