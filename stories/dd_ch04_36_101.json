    "entry":
    [
        { "location": "8/SCENARIO", "narrator": "", "text": "ないはずの思い出"},
        { "location": "31/TALK"   , "narrator": "みやび", "text": "なごちゃん、しっかり！\nうちはここに居るきね！"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "大丈夫やき、\nしっかりして…！"},
        { "location": "33/TALK"   , "narrator": "七五三　", "text": "いたいいたいいたい！\nあたま、いたい…！\nみや…たすけて…みや…！"},
        { "location": "34/TALK"   , "narrator": "みやび", "text": "なごちゃん！\nなごちゃん！"},
        { "location": "37/TALK"   , "narrator": "みやび", "text": "なごちゃん……。"},
        { "location": "52/TALK"   , "narrator": "みやび", "text": "…なごちゃん…\n…なごちゃん…。"},
        { "location": "53/TALK"   , "narrator": "みやび", "text": "うちが付いちゅうき…。\nなごちゃん……。"},
        { "location": "54/SEL"    , "narrator": "", "text": "みやびは平気？"},
        { "location": "55/SEL"    , "narrator": "", "text": "少し休みなよ"},
        { "location": "56/SEL"    , "narrator": "", "text": "心配だよね"},
        { "location": "57/ACT"    , "narrator": "", "text": "みやびは平気？"},
        { "location": "59/TALK"   , "narrator": "みやび", "text": "うちは平気ぞね。\nそれよりなごちゃんの\nことやき。"},
        { "location": "60/ACT"    , "narrator": "", "text": "少し休みなよ"},
        { "location": "61/TALK"   , "narrator": "みやび", "text": "そんなこと\nできるわけがないろう。"},
        { "location": "62/ACT"    , "narrator": "", "text": "心配だよね"},
        { "location": "63/TALK"   , "narrator": "みやび", "text": "当然ちや。"},
        { "location": "65/TALK"   , "narrator": "みやび", "text": "…ちうか、おんしは\n誰ぞね？"},
        { "location": "66/SEL"    , "narrator": "", "text": "$handle$"},
        { "location": "67/SEL"    , "narrator": "", "text": "$me$だよ"},
        { "location": "68/SEL"    , "narrator": "", "text": "相棒だけど"},
        { "location": "70/TALK"   , "narrator": "みやび", "text": "…わるいけんど\n思い出せん。"},
        { "location": "71/ACT"    , "narrator": "", "text": "$me$だよ"},
        { "location": "72/TALK"   , "narrator": "みやび", "text": "それは答えになはって\nないろう？"},
        { "location": "73/ACT"    , "narrator": "", "text": "相棒だけど"},
        { "location": "74/TALK"   , "narrator": "みやび", "text": "冗談言うちゅう\n場合やないき。"},
        { "location": "76/TALK"   , "narrator": "みやび", "text": "悪いけんど\n今は知らん人の相手を\nしとる余裕はないき。"},
        { "location": "77/SEL"    , "narrator": "", "text": "なごちゃん頭痛なんでしょ"},
        { "location": "78/SEL"    , "narrator": "", "text": "それってあの症状でしょ"},
        { "location": "79/SEL"    , "narrator": "", "text": "似た症例を知ってるんだ"},
        { "location": "80/ACT"    , "narrator": "", "text": "なごちゃん頭痛なんでしょ"},
        { "location": "81/TALK"   , "narrator": "みやび", "text": "…そう。"},
        { "location": "82/ACT"    , "narrator": "", "text": "それってあの症状でしょ"},
        { "location": "83/TALK"   , "narrator": "みやび", "text": "あれ？"},
        { "location": "84/ACT"    , "narrator": "", "text": "似た症例を知ってるんだ"},
        { "location": "87/TALK"   , "narrator": "みやび", "text": "えっ！？"},
        { "location": "89/SEL"    , "narrator": "", "text": "つばめと同じだ"},
        { "location": "90/SEL"    , "narrator": "", "text": "まだつばめのことは知らないんだ"},
        { "location": "91/SEL"    , "narrator": "", "text": "つばめもこうだったんだね"},
        { "location": "92/ACT"    , "narrator": "", "text": "つばめと同じだ"},
        { "location": "95/TALK"   , "narrator": "みやび", "text": "つばめ…？"},
        { "location": "96/ACT"    , "narrator": "", "text": "まだつばめのことは知らないんだ"},
        { "location": "98/TALK"   , "narrator": "みやび", "text": "誰？"},
        { "location": "99/ACT"    , "narrator": "", "text": "つばめもこうだったんだね"},
        { "location": "100/TALK"  , "narrator": "みやび", "text": "そもそも知らんけんど。"},
        { "location": "102/TALK"  , "narrator": "みやび", "text": "つばめ、いう子が\nなごちゃんと似た\n状態になった……。"},
        { "location": "103/TALK"  , "narrator": "みやび", "text": "…ということは……。"},
        { "location": "104/TALK"  , "narrator": "みやび", "text": "そのつばめ、いう子は\n激しい頭痛が出た後\nどうなったぞね？"},
        { "location": "105/SEL"   , "narrator": "", "text": "どうって？"},
        { "location": "106/ACT"   , "narrator": "", "text": "どうって？"},
        { "location": "108/TALK"  , "narrator": "みやび", "text": "まだ病院に居るとか\nそういう…経過に\nついてのことぞね。"},
        { "location": "109/SEL"   , "narrator": "", "text": "治ったよ"},
        { "location": "110/SEL"   , "narrator": "", "text": "新しい力に目覚めた"},
        { "location": "111/SEL"   , "narrator": "", "text": "高校生になったよ"},
        { "location": "112/ACT"   , "narrator": "", "text": "治ったよ"},
        { "location": "114/TALK"  , "narrator": "みやび", "text": "そうなんか……。"},
        { "location": "115/ACT"   , "narrator": "", "text": "新しい力に目覚めた"},
        { "location": "117/TALK"  , "narrator": "みやび", "text": "いや、そういう冗談は\n聞きとうない。"},
        { "location": "118/ACT"   , "narrator": "", "text": "高校生になったよ"},
        { "location": "120/TALK"  , "narrator": "みやび", "text": "…退院した、\nいうことやね。"},
        { "location": "122/TALK"  , "narrator": "みやび", "text": "いうことは、\nなごちゃんも治る\nいうことやね。"},
        { "location": "123/SEL"   , "narrator": "", "text": "うーん…"},
        { "location": "124/SEL"   , "narrator": "", "text": "そればっかりは"},
        { "location": "125/SEL"   , "narrator": "", "text": "$me$には断定できない"},
        { "location": "126/ACT"   , "narrator": "", "text": "うーん…"},
        { "location": "127/TALK"  , "narrator": "みやび", "text": "歯切れが悪いねえ。"},
        { "location": "128/ACT"   , "narrator": "", "text": "そればっかりは"},
        { "location": "129/TALK"  , "narrator": "みやび", "text": "いやいやそう言わず。"},
        { "location": "130/ACT"   , "narrator": "", "text": "$me$には断定できない"},
        { "location": "131/TALK"  , "narrator": "みやび", "text": "何事にも１００パーは\nないけんど。"},
        { "location": "133/TALK"  , "narrator": "みやび", "text": "遠慮せんでえいき。\nなごちゃんを治し。"},
        { "location": "134/SEL"   , "narrator": "", "text": "医者じゃないから…"},
        { "location": "135/SEL"   , "narrator": "", "text": "$me$に言われても"},
        { "location": "136/SEL"   , "narrator": "", "text": "みやびが治せばいいと思う"},
        { "location": "137/ACT"   , "narrator": "", "text": "医者じゃないから…"},
        { "location": "138/TALK"  , "narrator": "みやび", "text": "そうやとは\n思うとった。"},
        { "location": "139/ACT"   , "narrator": "", "text": "$me$に言われても"},
        { "location": "140/TALK"  , "narrator": "みやび", "text": "ゴッドハンドは\n持っとらんか。"},
        { "location": "141/ACT"   , "narrator": "", "text": "みやびが治せばいいと思う"},
        { "location": "142/TALK"  , "narrator": "みやび", "text": "それができたら\nとっくにそうしちゅう。"},
        { "location": "144/TALK"  , "narrator": "みやび", "text": "はぁ……。"},
        { "location": "145/SEL"   , "narrator": "", "text": "ところで"},
        { "location": "146/ACT"   , "narrator": "", "text": "ところで"},
        { "location": "148/TALK"  , "narrator": "みやび", "text": "何ぞね。"},
        { "location": "149/SEL"   , "narrator": "", "text": "なごちゃんはフェノメノンに巻き込まれて死んだのでは？"},
        { "location": "150/ACT"   , "narrator": "", "text": "なごちゃんはフェノメノンに巻き込まれて死んだのでは？"},
        { "location": "153/TALK"  , "narrator": "みやび", "text": "フェノメノン？"},
        { "location": "154/SEL"   , "narrator": "", "text": "そう"},
        { "location": "155/ACT"   , "narrator": "", "text": "そう"},
        { "location": "157/TALK"  , "narrator": "みやび", "text": "フェノメノンか…。"},
        { "location": "159/TALK"  , "narrator": "みやび", "text": "フェノメノンちうのは\n何ぞね？"},
        { "location": "160/SEL"   , "narrator": "", "text": "フェノメノンはフェノメノンだよ"},
        { "location": "161/SEL"   , "narrator": "", "text": "あれ？"},
        { "location": "162/SEL"   , "narrator": "", "text": "冗談で言ってるの？"},
        { "location": "163/ACT"   , "narrator": "", "text": "フェノメノンはフェノメノンだよ"},
        { "location": "164/ACT"   , "narrator": "", "text": "あれ？"},
        { "location": "165/ACT"   , "narrator": "", "text": "冗談で言ってるの？"},
        { "location": "187/TALK"  , "narrator": "みやび", "text": "なごちゃん！"},
        { "location": "188/TALK"  , "narrator": "みやび", "text": "…なごちゃんは！？"},
        { "location": "189/TALK"  , "narrator": "職員Ａ", "text": "予想以上の重体のため\n政府の先進医療病院へ\n緊急搬送をしました。"},
        { "location": "190/TALK"  , "narrator": "みやび", "text": "え…？"},
        { "location": "191/TALK"  , "narrator": "職員Ａ", "text": "申し訳ありません。"},
        { "location": "192/TALK"  , "narrator": "職員Ａ", "text": "君、急がないと…！"},
        { "location": "193/TALK"  , "narrator": "職員Ｂ", "text": "あ、はい…！"},
        { "location": "197/TALK"  , "narrator": "みやび", "text": "ちょ…！"},
        { "location": "198/TALK"  , "narrator": "みやび", "text": "その病院はどこに\nあるがですか！？"},
        { "location": "199/TALK"  , "narrator": "みやび", "text": "…ちょっと待って\n待ちい！！"},
        { "location": "203/TALK"  , "narrator": "みやび", "text": "…待ちい、て…。"},
        { "location": "204/TALK"  , "narrator": "みやび", "text": "何の説明もなしに！？\nどうなっちゅう！？"},
        { "location": "205/TALK"  , "narrator": "みやび", "text": "誰か、返してくれ！\nなごちゃんを、\nなごちゃんを…！"},
        { "location": "245/TALK"  , "narrator": "シンギュラリティ", "text": "ちゅうわけでや。"},
        { "location": "246/TALK"  , "narrator": "四十九夜　", "text": "うちらは\n考えたぞね。"},
        { "location": "247/TALK"  , "narrator": "シンギュラリティ", "text": "題して！"},
        { "location": "251/TALK"  , "narrator": "四十九夜　", "text": "どっちの\nうちでショウ！！"},
        { "location": "252/TALK"  , "narrator": "なご", "text": "なにしゆう……"},
        { "location": "253/SEL"   , "narrator": "", "text": "は…！？"},
        { "location": "254/ACT"   , "narrator": "", "text": "は…！？"},
        { "location": "256/TALK"  , "narrator": "シンギュラリティ", "text": "はいはい本日も\nやってまいりました！"},
        { "location": "257/TALK"  , "narrator": "四十九夜　", "text": "司会は私、\n四十九夜と、"},
        { "location": "258/TALK"  , "narrator": "シンギュラリティ", "text": "シンギュラリティで\nお届けするぞね。"},
        { "location": "259/SEL"   , "narrator": "", "text": "ちょっとまって意味が分かりません"},
        { "location": "260/ACT"   , "narrator": "", "text": "ちょっとまって意味が分かりません"},
        { "location": "262/TALK"  , "narrator": "四十九夜　", "text": "ルールは簡単ちや。"},
        { "location": "263/TALK"  , "narrator": "シンギュラリティ", "text": "今からうちに関する\n問題を五問出題\nしますき。"},
        { "location": "264/TALK"  , "narrator": "四十九夜　", "text": "これぞみやび！　と\n思った方を選択しいや。"},
        { "location": "265/SEL"   , "narrator": "", "text": "ええええ！突然なんで！？"},
        { "location": "266/ACT"   , "narrator": "", "text": "ええええ！突然なんで！？"},
        { "location": "268/TALK"  , "narrator": "シンギュラリティ", "text": "すると\nなんとうちが！"},
        { "location": "269/TALK"  , "narrator": "四十九夜　", "text": "あなた好みの\nうちに大変身！"},
        { "location": "270/TALK"  , "narrator": "シンギュラリティ", "text": "それでは早速\n参りたいと思います！"},
        { "location": "271/TALK"  , "narrator": "四十九夜　", "text": "どっちの\nうちでショウ！！"},
        { "location": "272/TALK"  , "narrator": "なご", "text": "早う、終わらせや。"},
        { "location": "276/TALK"  , "narrator": "シンギュラリティ", "text": "第一問！"},
        { "location": "277/TALK"  , "narrator": "四十九夜　", "text": "寝るときは！"},
        { "location": "278/SEL"   , "narrator": "", "text": "ドテラ"},
        { "location": "279/SEL"   , "narrator": "", "text": "一糸まとわぬ姿"},
        { "location": "280/ACT"   , "narrator": "", "text": "ドテラ"},
        { "location": "282/ACT"   , "narrator": "", "text": "一糸まとわぬ姿"},
        { "location": "284/TALK"  , "narrator": "四十九夜　", "text": "第二問！"},
        { "location": "285/TALK"  , "narrator": "シンギュラリティ", "text": "デート中、\nカフェでは！"},
        { "location": "286/SEL"   , "narrator": "", "text": "ちゅうをしまくる"},
        { "location": "287/SEL"   , "narrator": "", "text": "スマホを見て暇を潰す"},
        { "location": "288/ACT"   , "narrator": "", "text": "ちゅうをしまくる"},
        { "location": "289/ACT"   , "narrator": "", "text": "スマホを見て暇を潰す"},
        { "location": "292/TALK"  , "narrator": "シンギュラリティ", "text": "第三問！"},
        { "location": "293/TALK"  , "narrator": "四十九夜　", "text": "作るなら！"},
        { "location": "294/SEL"   , "narrator": "", "text": "サーバーマシン"},
        { "location": "295/SEL"   , "narrator": "", "text": "子供"},
        { "location": "296/ACT"   , "narrator": "", "text": "サーバーマシン"},
        { "location": "298/ACT"   , "narrator": "", "text": "子供"},
        { "location": "300/TALK"  , "narrator": "四十九夜　", "text": "第四問！"},
        { "location": "301/TALK"  , "narrator": "シンギュラリティ", "text": "なごちゃんは！"},
        { "location": "302/SEL"   , "narrator": "", "text": "イマジナリーシスター"},
        { "location": "303/SEL"   , "narrator": "", "text": "かわいい妹"},
        { "location": "304/ACT"   , "narrator": "", "text": "イマジナリーシスター"},
        { "location": "305/ACT"   , "narrator": "", "text": "かわいい妹"},
        { "location": "309/TALK"  , "narrator": "シンギュラリティ", "text": "第五問！"},
        { "location": "310/TALK"  , "narrator": "四十九夜　", "text": "コイガサキとは！"},
        { "location": "311/SEL"   , "narrator": "", "text": "エンドレスでラッキースケベ日常アニメを続けたい"},
        { "location": "312/SEL"   , "narrator": "", "text": "血湧き肉躍る冒険活劇ラブロマンスをしたい"},
        { "location": "313/ACT"   , "narrator": "", "text": "エンドレスで日常アニメを続けたい"},
        { "location": "315/ACT"   , "narrator": "", "text": "血湧き肉躍る冒険活劇ラブロマンスをしたい"},
        { "location": "321/TALK"  , "narrator": "シンギュラリティ", "text": "終了！！"},
        { "location": "323/TALK"  , "narrator": "シンギュラリティ", "text": "というわけで！"},
        { "location": "324/TALK"  , "narrator": "四十九夜　", "text": "お前さんの理想の\nみやび実現度は！！"},
        { "location": "329/TALK"  , "narrator": "四十九夜　", "text": "まあ…よくここまで\n一貫した回答を\nしたものやね。"},
        { "location": "330/TALK"  , "narrator": "シンギュラリティ", "text": "まっこと、天晴れな程に\n煩悩ダダ漏れや。"},
        { "location": "331/TALK"  , "narrator": "四十九夜　", "text": "おま中イマジナリー\nみやびさんで、存分に\nエンジョイしいや。"},
        { "location": "332/SEL"   , "narrator": "", "text": "あれ！？　選んだとおりのみやびになるんじゃ…"},
        { "location": "333/ACT"   , "narrator": "", "text": "あれ！？　選んだとおりのみやびになるんじゃ…"},
        { "location": "337/TALK"  , "narrator": "四十九夜　", "text": "こじゃんと\n妄想全開やね…。"},
        { "location": "338/TALK"  , "narrator": "シンギュラリティ", "text": "こんなみやびさんいたら\n放送できんぞね。"},
        { "location": "339/SEL"   , "narrator": "", "text": "あれ！？　選んだとおりのみやびになるんじゃ…"},
        { "location": "340/ACT"   , "narrator": "", "text": "あれ！？　選んだとおりのみやびになるんじゃ…"},
        { "location": "344/TALK"  , "narrator": "四十九夜　", "text": "まあ、健康的な\n思春期男児といった\nところかね。"},
        { "location": "345/TALK"  , "narrator": "シンギュラリティ", "text": "相棒が女子でも、\n健康的男児的女子や。"},
        { "location": "346/SEL"   , "narrator": "", "text": "で、そんなみやびになってくれるんでしょ？"},
        { "location": "347/ACT"   , "narrator": "", "text": "で、そんなみやびになってくれるんでしょ？"},
        { "location": "349/TALK"  , "narrator": "四十九夜　", "text": "まあ、これくらいなら\nお前さん次第かね。"},
        { "location": "352/TALK"  , "narrator": "四十九夜　", "text": "ほうほう。\nわりと悪くない\n実現度やね。"},
        { "location": "353/TALK"  , "narrator": "シンギュラリティ", "text": "これくらいになると、\nまあ許してもえいかなと\n思えるレベルや。"},
        { "location": "354/SEL"   , "narrator": "", "text": "やった！"},
        { "location": "355/ACT"   , "narrator": "", "text": "やった！"},
        { "location": "357/TALK"  , "narrator": "四十九夜　", "text": "けんど、\nなるのには１０年を\n要するね。"},
        { "location": "360/TALK"  , "narrator": "四十九夜　", "text": "おおっ！\nなんという健全な！"},
        { "location": "361/TALK"  , "narrator": "シンギュラリティ", "text": "健全の中にも\nちくっと不健全が\n混ざる理想の相棒！"},
        { "location": "362/SEL"   , "narrator": "", "text": "なってくれるの？"},
        { "location": "363/ACT"   , "narrator": "", "text": "なってくれるの？"},
        { "location": "365/TALK"  , "narrator": "四十九夜　", "text": "うむ。\n大いに検討しよう。"},
        { "location": "368/TALK"  , "narrator": "四十九夜　", "text": "なんという健全な！！"},
        { "location": "369/TALK"  , "narrator": "シンギュラリティ", "text": "相棒がこんなに\n健全な全年齢対象\nキャラやったなんて！"},
        { "location": "370/TALK"  , "narrator": "四十九夜　", "text": "これは奇跡とも\n言えようぞ。"},
        { "location": "371/SEL"   , "narrator": "", "text": "で、なってくれるの？"},
        { "location": "372/ACT"   , "narrator": "", "text": "で、なってくれるの？"},
        { "location": "374/TALK"  , "narrator": "シンギュラリティ", "text": "つーか、\n今現在ナウまさに\nその通りのうちやよ。"},
        { "location": "379/TALK"  , "narrator": "四十九夜　", "text": "とまあ、\nそんな余興はさておき。"},
        { "location": "380/TALK"  , "narrator": "シンギュラリティ", "text": "この五つの問題には、\nなごちゃん発症に関する\n重大な仕掛けがあった！"},
        { "location": "382/TALK"  , "narrator": "四十九夜　", "text": "うちらが高度な情報戦を\n仕掛けていたのである。"},
        { "location": "383/TALK"  , "narrator": "シンギュラリティ", "text": "そう。これらの問題に\nよって、お前さんの\n本心がわかる。"},
        { "location": "384/TALK"  , "narrator": "四十九夜　", "text": "うむ。うわべだけの\n打算的な判断ではなく、\n深層でどう思ってるかや。"},
        { "location": "385/TALK"  , "narrator": "シンギュラリティ", "text": "そしてズバリ！\nお前さんは――"},
        { "location": "387/TALK"  , "narrator": "四十九夜　", "text": "確かに宣言どおり、\nうちの発症を\n望んじゅう！！"},
        { "location": "388/TALK"  , "narrator": "シンギュラリティ", "text": "まじかー……"},
        { "location": "390/TALK"  , "narrator": "シンギュラリティ", "text": "言葉とは裏腹に\n本当は発症を\n望んではおらん！"},
        { "location": "391/TALK"  , "narrator": "四十九夜　", "text": "なるほどね……"},
        { "location": "393/SEL"   , "narrator": "", "text": "その通り！"},
        { "location": "394/SEL"   , "narrator": "", "text": "異議申し立てる！"},
        { "location": "395/ACT"   , "narrator": "", "text": "その通り！"},
        { "location": "398/TALK"  , "narrator": "四十九夜　", "text": "よかったね。\n深層心理も\nお前さんの味方で。"},
        { "location": "399/ACT"   , "narrator": "", "text": "異議申し立てる！"},
        { "location": "402/TALK"  , "narrator": "四十九夜　", "text": "なるほど。"},
        { "location": "403/TALK"  , "narrator": "シンギュラリティ", "text": "うむ、その意気や！\n深層心理なぞには負けん\nエラいやつや。"},
        { "location": "405/TALK"  , "narrator": "なご", "text": "そろそろ\n余興は終わったん？"},
        { "location": "409/TALK"  , "narrator": "四十九夜　", "text": "うむ、\n終わったよ。"},
        { "location": "412/TALK"  , "narrator": "シンギュラリティ", "text": "……どうや？"},
        { "location": "413/TALK"  , "narrator": "四十九夜　", "text": "………。"},
        { "location": "414/TALK"  , "narrator": "四十九夜　", "text": "戻っちゅう！！"},
        { "location": "416/TALK"  , "narrator": "シンギュラリティ", "text": "まじかぁぁぁっ！！"},
        { "location": "417/SEL"   , "narrator": "", "text": "え？なになに！？"},
        { "location": "418/ACT"   , "narrator": "", "text": "え？なになに！？"},
        { "location": "420/TALK"  , "narrator": "四十九夜　", "text": "うちがお前さんから\n「種」を取り戻したんよ。"},
        { "location": "421/TALK"  , "narrator": "なご", "text": "おお、さすが\n四十九夜ぞね！"},
        { "location": "422/SEL"   , "narrator": "", "text": "なんで！？"},
        { "location": "423/ACT"   , "narrator": "", "text": "なんで！？"},
        { "location": "425/TALK"  , "narrator": "四十九夜　", "text": "種を奪ったのが\nお前さんなら、\n与えるのもまたお前さん。"},
        { "location": "426/TALK"  , "narrator": "四十九夜　", "text": "さっきの５つの質問の中に\nお前さんが発症を望むなら\n選ぶ質問を用意していた。"},
        { "location": "427/TALK"  , "narrator": "四十九夜　", "text": "そして見事、\nお前さんはそれを\n選んだわけや。"},
        { "location": "428/SEL"   , "narrator": "", "text": "まあ確かに、実は発症に揺らいでいたのはある"},
        { "location": "429/SEL"   , "narrator": "", "text": "断固認めない！"},
        { "location": "430/ACT"   , "narrator": "", "text": "まあ確かに、実は発症に揺らいでいたのはある"},
        { "location": "433/TALK"  , "narrator": "四十九夜　", "text": "やはりそうであったか。"},
        { "location": "434/TALK"  , "narrator": "四十九夜　", "text": "ほれ、今こそ本当に\n種が戻ったぞね。"},
        { "location": "435/TALK"  , "narrator": "シンギュラリティ", "text": "あああぁぁぁ……"},
        { "location": "436/SEL"   , "narrator": "", "text": "何がどうなってるの！？"},
        { "location": "437/ACT"   , "narrator": "", "text": "何がどうなってるの！？"},
        { "location": "439/TALK"  , "narrator": "シンギュラリティ", "text": "お前さん、\n誘導されたんよ。"},
        { "location": "440/TALK"  , "narrator": "シンギュラリティ", "text": "あんなくだらない\nクイズ問題には\n何も仕掛けはない。"},
        { "location": "441/TALK"  , "narrator": "シンギュラリティ", "text": "けんど、結果を聞いて\n確かにそうかも、と\n思うたら――"},
        { "location": "442/TALK"  , "narrator": "四十九夜　", "text": "それは誠になるぞね！"},
        { "location": "443/TALK"  , "narrator": "四十九夜　", "text": "けんどそれは\nお前さんにとっての\n正直な気持ちや。"},
        { "location": "446/TALK"  , "narrator": "四十九夜　", "text": "なごちゃん、\nこれで昇華できるよ。"},
        { "location": "447/TALK"  , "narrator": "なご", "text": "よかったぞね。"},
        { "location": "448/ACT"   , "narrator": "", "text": "断固認めない！"},
        { "location": "451/TALK"  , "narrator": "四十九夜　", "text": "そうか。"},
        { "location": "452/TALK"  , "narrator": "シンギュラリティ", "text": "まあ、所詮は\nインチキやったしね。"},
        { "location": "453/SEL"   , "narrator": "", "text": "え？インチキ？"},
        { "location": "454/ACT"   , "narrator": "", "text": "え？インチキ？"},
        { "location": "456/TALK"  , "narrator": "シンギュラリティ", "text": "そうやよ。\nあんなクイズ問題で\n種が戻るわけがない。"},
        { "location": "457/TALK"  , "narrator": "シンギュラリティ", "text": "それでも、結果を聞いて\n確かにそうかも、と\n思うたら――"},
        { "location": "458/TALK"  , "narrator": "四十九夜　", "text": "それがお前さんの\n本心となって、種が戻る\n可能性はあったがね。"},
        { "location": "459/TALK"  , "narrator": "なご", "text": "なんぞ、\n結局種は戻らんの？"},
        { "location": "463/TALK"  , "narrator": "四十九夜　", "text": "申し訳ない、なごちゃん。\n種は戻せんかったぞね。"},
        { "location": "464/TALK"  , "narrator": "なご", "text": "そうかー。\nなら……"},
        { "location": "465/TALK"  , "narrator": "なご", "text": "なごが$handle$と\n戦って奪い返すのみぞね。"},
        { "location": "466/TALK"  , "narrator": "シンギュラリティ", "text": "なごちゃん、\n無茶なことしたらいかん！"},
        { "location": "469/TALK"  , "narrator": "なご", "text": "ほんだら、\nうちがなんでそないに\n昇華したいか教えるきね。"},
        { "location": "470/TALK"  , "narrator": "なご", "text": "本物のなごちゃんは\n十中八九生きちゅう。"},
        { "location": "471/TALK"  , "narrator": "なご", "text": "けんど――"},
        { "location": "472/TALK"  , "narrator": "なご", "text": "その所業に関しては\nあまり良い噂は\n聞かんぞね。"},
        { "location": "473/TALK"  , "narrator": "なご", "text": "やき。\nうちはなごちゃんの為。"},
        { "location": "474/TALK"  , "narrator": "なご", "text": "なごちゃんと戦うために、\n強くなりたい思っちゅう。"},
        { "location": "475/TALK"  , "narrator": "なご", "text": "それに、フェノメノンで\n世界になれば、色んな\nことが見えてくる。"},
        { "location": "476/TALK"  , "narrator": "なご", "text": "うちが言えることは\nこれだけぞね。"},
        { "location": "477/TALK"  , "narrator": "なご", "text": "まああれや、\n単なる憶測と風の噂やき\n間違っちゅうやもしれん。"},
        { "location": "478/TALK"  , "narrator": "なご", "text": "けんど、\nそれを解明する為にも\n発症はせんといかんき。"},
        { "location": "479/TALK"  , "narrator": "なご", "text": "そうゆうことちや。"},
        { "location": "481/TALK"  , "narrator": "なご", "text": "やき、\nあんたの力を貸しぃや！"},
        { "location": "483/TALK"  , "narrator": "なご", "text": "やき、あんたのエゴに\nつき合ってる暇は\nないぞね！"},
        { "location": "24/DIALOG" , "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:Interrupt】</color>\nSystem Interrupted.\n\n必須選択肢が選ばれていません。\n\n<color=green>『STORY27：シン・カグラ』</color>\nにて、選択を行ってから\n再度アクセスしてください。\n"},
        { "location": "28/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>-月--日　 -:-- --</color>\nNull"},
