{
    "dir": "chap33/daydra/dd_ch04_33_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "33405",
        "cid": "miyabi",
        "title": "005 メインストーリー",
        "sub_title": "パラレルパラレル＜後編＞"
    },
    "entry":
    [
        { "location": "689/SCENARIO", "narrator": "", "text": "パラレルパラレルパラレルパラレル"},
        { "location": "708/TALK"    , "narrator": "みやび", "text": "さっきは\n$handle$に変なこと\n言うてしもた…。"},
        { "location": "709/TALK"    , "narrator": "みやび", "text": "あれでは不思議ちゃんや\nのうて電波ちゃんやき。"},
        { "location": "710/TALK"    , "narrator": "みやび", "text": "弁明しておく\nべきやろうね。"},
        { "location": "723/TALK"    , "narrator": "みやび", "text": "先ほどの話だが"},
        { "location": "724/TALK"    , "narrator": "みやび", "text": "結論から言おう"},
        { "location": "725/TALK"    , "narrator": "みやび", "text": "なごちゃんについては保留"},
        { "location": "726/TALK"    , "narrator": "みやび", "text": "$handle$については存在を確認済み"},
        { "location": "727/TALK"    , "narrator": "みやび", "text": "以上"},
        { "location": "740/SEL"     , "narrator": "", "text": "ちょっと待って"},
        { "location": "741/ACT"     , "narrator": "", "text": "ちょっと待って"},
        { "location": "758/TALK"    , "narrator": "みやび", "text": "ぬ"},
        { "location": "759/SEL"     , "narrator": "", "text": "過程も説明して"},
        { "location": "760/SEL"     , "narrator": "", "text": "$me$の疑惑は晴れたみたいだけど"},
        { "location": "761/SEL"     , "narrator": "", "text": "もう少し詳しく！"},
        { "location": "762/ACT"     , "narrator": "", "text": "過程も説明して"},
        { "location": "763/TALK"    , "narrator": "みやび", "text": "了解した"},
        { "location": "764/ACT"     , "narrator": "", "text": "$me$の疑惑は晴れたみたいだけど"},
        { "location": "766/TALK"    , "narrator": "みやび", "text": "すまんかった"},
        { "location": "767/ACT"     , "narrator": "", "text": "もう少し詳しく！"},
        { "location": "768/TALK"    , "narrator": "みやび", "text": "ふむ"},
        { "location": "770/TALK"    , "narrator": "みやび", "text": "まずはなごちゃんの件"},
        { "location": "771/TALK"    , "narrator": "みやび", "text": "うちはうちの感覚を信じる"},
        { "location": "772/TALK"    , "narrator": "みやび", "text": "五感、プラス魂や"},
        { "location": "773/TALK"    , "narrator": "みやび", "text": "それで確認できたものこそがうちにとっての事実"},
        { "location": "774/TALK"    , "narrator": "みやび", "text": "なごちゃんの死は"},
        { "location": "776/TALK"    , "narrator": "みやび", "text": "そのいずれでも感じ取れておらん"},
        { "location": "777/TALK"    , "narrator": "みやび", "text": "やき"},
        { "location": "778/TALK"    , "narrator": "みやび", "text": "保留ぞね"},
        { "location": "780/SEL"     , "narrator": "", "text": "ふむ"},
        { "location": "781/SEL"     , "narrator": "", "text": "なるほど"},
        { "location": "782/SEL"     , "narrator": "", "text": "そういう理論"},
        { "location": "783/ACT"     , "narrator": "", "text": "ふむ"},
        { "location": "784/TALK"    , "narrator": "みやび", "text": "そういうことだ"},
        { "location": "785/ACT"     , "narrator": "", "text": "なるほど"},
        { "location": "786/TALK"    , "narrator": "みやび", "text": "ご理解いただけたかの"},
        { "location": "787/ACT"     , "narrator": "", "text": "そういう理論"},
        { "location": "788/TALK"    , "narrator": "みやび", "text": "みやびさん理論ぞね"},
        { "location": "790/TALK"    , "narrator": "みやび", "text": "次に$handle$"},
        { "location": "791/TALK"    , "narrator": "みやび", "text": "これは五感で感じたことはない"},
        { "location": "792/TALK"    , "narrator": "みやび", "text": "しかし魂は確認済み"},
        { "location": "793/TALK"    , "narrator": "みやび", "text": "これこそ新しいリアル"},
        { "location": "794/TALK"    , "narrator": "みやび", "text": "魂のシンギュラリティ"},
        { "location": "795/TALK"    , "narrator": "みやび", "text": "ヒト意識上の技術的特異点"},
        { "location": "797/SEL"     , "narrator": "", "text": "はあ"},
        { "location": "798/SEL"     , "narrator": "", "text": "わかるようなわかんないような"},
        { "location": "799/SEL"     , "narrator": "", "text": "なんとなく格好いいからいいか"},
        { "location": "800/ACT"     , "narrator": "", "text": "はあ"},
        { "location": "801/TALK"    , "narrator": "みやび", "text": "なんともまあ"},
        { "location": "802/TALK"    , "narrator": "みやび", "text": "よいお返事だこと"},
        { "location": "803/ACT"     , "narrator": "", "text": "わかるようなわかんないような"},
        { "location": "804/TALK"    , "narrator": "みやび", "text": "理解しようとするな"},
        { "location": "805/TALK"    , "narrator": "みやび", "text": "感じろ"},
        { "location": "806/ACT"     , "narrator": "", "text": "なんとなく格好いいからいいか"},
        { "location": "808/TALK"    , "narrator": "みやび", "text": "それそれ"},
        { "location": "809/TALK"    , "narrator": "みやび", "text": "めっちゃ大事"},
        { "location": "810/TALK"    , "narrator": "みやび", "text": "たぶん"},
        { "location": "812/TALK"    , "narrator": "みやび", "text": "なんというか"},
        { "location": "813/TALK"    , "narrator": "みやび", "text": "相棒は常にうちの側におる"},
        { "location": "814/TALK"    , "narrator": "みやび", "text": "この目には見えなくても"},
        { "location": "815/TALK"    , "narrator": "みやび", "text": "魂では感じておる"},
        { "location": "816/TALK"    , "narrator": "みやび", "text": "つまり$handle$は実在する"},
        { "location": "817/TALK"    , "narrator": "みやび", "text": "そして"},
        { "location": "818/TALK"    , "narrator": "みやび", "text": "今現在まで目視できんのは"},
        { "location": "819/TALK"    , "narrator": "みやび", "text": "この世界がバグっておるからであろう"},
        { "location": "820/TALK"    , "narrator": "みやび", "text": "うちはそう結論づけた"},
        { "location": "832/TALK"    , "narrator": "透明アーヤ", "text": "ギャヴィ、みやび。\n館長から準備完了の\n連絡があったわ。"},
        { "location": "833/TALK"    , "narrator": "透明アーヤ", "text": "サイネージに館長が\n映し出されたら\n救出開始よ。"},
        { "location": "834/TALK"    , "narrator": "透明ガブリエラ", "text": "ふうん。\nまほもやる時はやるわね。"},
        { "location": "836/TALK"    , "narrator": "みやび", "text": "いっつもそうやったら\n肩が凝って\n仕方ないろう。"},
        { "location": "837/TALK"    , "narrator": "みやび", "text": "うちみたいに。"},
        { "location": "838/TALK"    , "narrator": "透明アーヤ", "text": "……スタンバイ。\n各人、構えよ。"},
        { "location": "853/TALK"    , "narrator": "みやび", "text": "これが終わったら"},
        { "location": "854/TALK"    , "narrator": "みやび", "text": "この世界のデバッグをせんといかんね"},
        { "location": "855/TALK"    , "narrator": "みやび", "text": "二人のために"},
        { "location": "866/TALK"    , "narrator": "みやび", "text": "発煙手榴弾の\n安全ロック解除。"},
        { "location": "867/TALK"    , "narrator": "みやび", "text": "いつでも行けるき。"},
        { "location": "868/TALK"    , "narrator": "透明ガブリエラ", "text": "望むところよ。"},
        { "location": "869/TALK"    , "narrator": "透明アーヤ", "text": "…お願い。"},
        { "location": "870/TALK"    , "narrator": "みやび", "text": "オッケー。\n…発破！"},
        { "location": "877/TALK"    , "narrator": "みやび", "text": "相棒を\nあんまり待たせる\nわけにはいかんき。"},
        { "location": "878/TALK"    , "narrator": "みやび", "text": "こじゃんと片付けて\nしまわんとね…！"},
        { "location": "894/DIALOG"  , "narrator": "Dialog_chapter_ch04", "text": "【27 シン・カグラ】"}
    ]
}
