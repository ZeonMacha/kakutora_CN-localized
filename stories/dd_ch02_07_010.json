{
    "dir": "chap07/daydra/dd_ch02_07_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "7252",
        "cid": "ayami",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "真幌との会話"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "真幌との会話"},
        { "location": "23/TALK"   , "narrator": "真幌", "text": "アーヤ、\nバイトの後は暇か？"},
        { "location": "25/TALK"   , "narrator": "アーヤ", "text": "ええ、まあ…。"},
        { "location": "26/TALK"   , "narrator": "真幌", "text": "そうか。\nなら、仕事が終わったら\n一杯どうだ？"},
        { "location": "27/TALK"   , "narrator": "アーヤ", "text": "お酒ですか？"},
        { "location": "28/TALK"   , "narrator": "真幌", "text": "まさか、下戸だなんて\n言わんだろうな？"},
        { "location": "30/TALK"   , "narrator": "アーヤ", "text": "普通に飲めますけど、\nいつ出動がかかるか\nわからないですし…。"},
        { "location": "31/TALK"   , "narrator": "真幌", "text": "硬いことを言うな。\n私が良いと言っているん\nだからな。"},
        { "location": "32/TALK"   , "narrator": "アーヤ", "text": "…それが一番問題な\n気もするんだけど。"},
        { "location": "33/TALK"   , "narrator": "真幌", "text": "たまにはいいだろう。\nおまえはうちで唯一、\n酒の飲める年齢なんだ。"},
        { "location": "34/TALK"   , "narrator": "真幌", "text": "それに、私もたまには\n誰かと飲みたい日が\nあってな。"},
        { "location": "35/TALK"   , "narrator": "アーヤ", "text": "う～ん…確かにお酒に\n付き合えるのは私しか\nいないけど…。"},
        { "location": "47/TALK"   , "narrator": "アーヤ", "text": "どうしよう"},
        { "location": "49/TALK"   , "narrator": "アーヤ", "text": "館長にお酒に誘われちゃったの"},
        { "location": "50/TALK"   , "narrator": "アーヤ", "text": "何だか誰かと飲みたい気分みたい"},
        { "location": "51/TALK"   , "narrator": "アーヤ", "text": "でも"},
        { "location": "52/TALK"   , "narrator": "アーヤ", "text": "出動がかかるかもしれないから"},
        { "location": "53/TALK"   , "narrator": "アーヤ", "text": "ちょっと不安かも…(-ω-;)"},
        { "location": "55/SEL"    , "narrator": "", "text": "付き合ってあげなよ"},
        { "location": "56/SEL"    , "narrator": "", "text": "面倒そうだし断ろう"},
        { "location": "57/SEL"    , "narrator": "", "text": "アーヤは飲まなければいい"},
        { "location": "58/ACT"    , "narrator": "", "text": "付き合ってあげなよ"},
        { "location": "61/TALK"   , "narrator": "アーヤ", "text": "…そうしようかな？"},
        { "location": "62/TALK"   , "narrator": "アーヤ", "text": "それじゃあ"},
        { "location": "63/TALK"   , "narrator": "アーヤ", "text": "飲み過ぎには気をつけて"},
        { "location": "64/TALK"   , "narrator": "アーヤ", "text": "楽しんできます(≧∇≦)b"},
        { "location": "77/TALK"   , "narrator": "アーヤ", "text": "わかりました。\nお付き合いします。"},
        { "location": "78/TALK"   , "narrator": "真幌", "text": "おお、本当か！"},
        { "location": "79/TALK"   , "narrator": "アーヤ", "text": "ただし、私は二杯以上は\n飲みませんよ？"},
        { "location": "80/TALK"   , "narrator": "真幌", "text": "構わん、酔い潰すのが\n目的ではないからな。"},
        { "location": "81/TALK"   , "narrator": "真幌", "text": "店は私に任せろ。\nいい店を\n知っているんだ。"},
        { "location": "82/TALK"   , "narrator": "アーヤ", "text": "館長も飲み過ぎないで\nくださいね。"},
        { "location": "83/TALK"   , "narrator": "真幌", "text": "心配するな。\n私はそう簡単に\n酔い潰れはせん！"},
        { "location": "84/TALK"   , "narrator": "真幌", "text": "それに、\nせっかくアーヤと\n飲めるんだからな。"},
        { "location": "85/TALK"   , "narrator": "真幌", "text": "ガキどもは抜きにして、\n大人同士ゆっくりと\n語り合おうじゃないか。"},
        { "location": "87/TALK"   , "narrator": "アーヤ", "text": "ふふっ、そうですね。"},
        { "location": "89/TALK"   , "narrator": "アーヤ", "text": "凄く喜んでるみたい…\nこれからも、たまには\nこういうのも良いかも。"},
        { "location": "90/ACT"    , "narrator": "", "text": "面倒そうだし断ろう"},
        { "location": "91/TALK"   , "narrator": "アーヤ", "text": "そうね"},
        { "location": "92/TALK"   , "narrator": "アーヤ", "text": "館長には申し訳ないけど、それがいいかも"},
        { "location": "104/TALK"  , "narrator": "アーヤ", "text": "せっかくの\nお誘いですが、\n私は遠慮します。"},
        { "location": "105/TALK"  , "narrator": "真幌", "text": "なんだと！？"},
        { "location": "106/TALK"  , "narrator": "アーヤ", "text": "やっぱり、\nいつ出動がかかるか\nわかりませんし。"},
        { "location": "107/TALK"  , "narrator": "真幌", "text": "別に酔い潰すつもりは\nないんだぞ？"},
        { "location": "108/TALK"  , "narrator": "アーヤ", "text": "わかってますけど、\n緊急事態に備えるのも\nリーダーの仕事なので。"},
        { "location": "109/TALK"  , "narrator": "真幌", "text": "…………。"},
        { "location": "112/TALK"  , "narrator": "真幌", "text": "つまらんヤツだ…。\nなら、私は一人で\n飲んでくるとしよう。"},
        { "location": "115/TALK"  , "narrator": "アーヤ", "text": "…ちょっと、\nかわいそうなこと\nしちゃったかな？"},
        { "location": "116/ACT"   , "narrator": "", "text": "アーヤは飲まなければいい"},
        { "location": "117/TALK"  , "narrator": "アーヤ", "text": "それがいいかも"},
        { "location": "118/TALK"  , "narrator": "アーヤ", "text": "飲むのは館長に任せて"},
        { "location": "119/TALK"  , "narrator": "アーヤ", "text": "私はジュースにするわ"},
        { "location": "131/TALK"  , "narrator": "アーヤ", "text": "せっかくの\nお誘いですし、\nお供します。"},
        { "location": "132/TALK"  , "narrator": "真幌", "text": "おおっ、\n行ってくれるか！"},
        { "location": "133/TALK"  , "narrator": "アーヤ", "text": "はい、お店はどこに\nしますか？"},
        { "location": "134/TALK"  , "narrator": "真幌", "text": "店のことは心配するな。\n私のお薦めの店に\n連れて行ってやる。"},
        { "location": "135/TALK"  , "narrator": "真幌", "text": "あそこは魚介類が\n美味くてなぁ…。"},
        { "location": "136/TALK"  , "narrator": "アーヤ", "text": "それは楽しみです。"},
        { "location": "137/TALK"  , "narrator": "真幌", "text": "それに、中々良い酒も\n揃ってるからな。"},
        { "location": "138/TALK"  , "narrator": "真幌", "text": "…最初の一杯くらいは\n付き合ってもらうぞ？"},
        { "location": "139/TALK"  , "narrator": "アーヤ", "text": "えっ！？"},
        { "location": "140/TALK"  , "narrator": "真幌", "text": "ジュースや\n茶だけなんて\n許さんからな。"},
        { "location": "142/TALK"  , "narrator": "アーヤ", "text": "お見通しでしたか…。"},
        { "location": "145/TALK"  , "narrator": "アーヤ", "text": "この人には、まだまだ\n敵わないなぁ…。"},
        { "location": "15/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>5月7日　6:44 PM</color>\nＧＷ期間、神楽坂トライナリーでのバイトの最中のこと。"}
    ]
}
