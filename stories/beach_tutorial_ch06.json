    "entry":
    [
        { "location": "765/SCENARIO", "narrator": "", "text": "TGS千羽鶴"},
        { "location": "775/TALK"    , "narrator": "千羽鶴", "text": "まさか、私が\nこんな事をする羽目に\nなるとは思わなかった。"},
        { "location": "776/SEL"     , "narrator": "", "text": "嬉しい！"},
        { "location": "777/SEL"     , "narrator": "", "text": "水着は！？"},
        { "location": "778/ACT"     , "narrator": "", "text": "嬉しい！"},
        { "location": "779/TALK"    , "narrator": "千羽鶴", "text": "まあ、\nそう言ってくれるなら\n少しは意義があるかも。"},
        { "location": "780/ACT"     , "narrator": "", "text": "水着は！？"},
        { "location": "781/TALK"    , "narrator": "千羽鶴", "text": "調子に乗らないで。"},
        { "location": "782/TALK"    , "narrator": "千羽鶴", "text": "そもそも私は\n非攻略対象なんだし。"},
        { "location": "783/TALK"    , "narrator": "千羽鶴", "text": "タッチ機能だって、私には\n対応していなかったのを、\n今回この為に対応したし。"},
        { "location": "784/TALK"    , "narrator": "千羽鶴", "text": "それだけでも十分、\n感謝されてもおかしくない\nレベルだと思う。"},
        { "location": "785/SEL"     , "narrator": "", "text": "ありがとうございます！"},
        { "location": "786/SEL"     , "narrator": "", "text": "まだまだ甘いわ！"},
        { "location": "787/ACT"     , "narrator": "", "text": "ありがとうございます！"},
        { "location": "788/TALK"    , "narrator": "千羽鶴", "text": "それでよし。"},
        { "location": "789/ACT"     , "narrator": "", "text": "まだまだ甘いわ！"},
        { "location": "790/TALK"    , "narrator": "千羽鶴", "text": "なるほど。\nよくわかった。"},
        { "location": "791/TALK"    , "narrator": "千羽鶴", "text": "至らない旅行を続けても\n申し訳無いから、\n帰りましょ。"},
        { "location": "795/TALK"    , "narrator": "千羽鶴", "text": "さて。\nハネムーンと言えば\n南国の海。"},
        { "location": "796/TALK"    , "narrator": "千羽鶴", "text": "というわけで、\n早速来てみた。\n感想は？"},
        { "location": "797/SEL"     , "narrator": "", "text": "北欧とか寒い方が好き"},
        { "location": "798/SEL"     , "narrator": "", "text": "いつか本当に結婚して南国旅行に行きたい"},
        { "location": "799/ACT"     , "narrator": "", "text": "北欧とか寒い方が好き"},
        { "location": "800/TALK"    , "narrator": "千羽鶴", "text": "なるほど。それじゃ\nポーランドにする。"},
        { "location": "803/TALK"    , "narrator": "千羽鶴", "text": "はい、到着。"},
        { "location": "804/SEL"     , "narrator": "", "text": "ワルシャワ！素敵！"},
        { "location": "805/SEL"     , "narrator": "", "text": "なんでポーランドなの？"},
        { "location": "806/ACT"     , "narrator": "", "text": "ワルシャワ！素敵！"},
        { "location": "807/TALK"    , "narrator": "千羽鶴", "text": "ええ。\nワルシャワはとても\n素敵な所。"},
        { "location": "808/ACT"     , "narrator": "", "text": "なんでポーランドなの？"},
        { "location": "809/TALK"    , "narrator": "千羽鶴", "text": "それを聞くのは\n愚問と言わざるを得ない。"},
        { "location": "811/TALK"    , "narrator": "千羽鶴", "text": "ポーランドはドイツや\nフランスよりはマイナー\nだけど、見所は沢山ある。"},
        { "location": "812/TALK"    , "narrator": "千羽鶴", "text": "興味が出たなら\nいつか本当に\n行ってみるといい。"},
        { "location": "813/SEL"     , "narrator": "", "text": "その時はちーちゃん案内して！"},
        { "location": "814/ACT"     , "narrator": "", "text": "その時はちーちゃん案内して！"},
        { "location": "816/TALK"    , "narrator": "千羽鶴", "text": "いいけど。"},
        { "location": "817/SEL"     , "narrator": "", "text": "二人きりの旅行だーやったー！"},
        { "location": "818/ACT"     , "narrator": "", "text": "二人きりの旅行だーやったー！"},
        { "location": "821/TALK"    , "narrator": "千羽鶴", "text": "……なるほど。"},
        { "location": "822/TALK"    , "narrator": "千羽鶴", "text": "言葉巧みに二人きりの\nシチュエーションを\n作る才能には恐れ入る。"},
        { "location": "824/TALK"    , "narrator": "千羽鶴", "text": "是非それを\n彼女たちとの交流で\n活用してほしい。"},
        { "location": "825/TALK"    , "narrator": "千羽鶴", "text": "ちなみに、\n私たちの世界では――"},
        { "location": "826/TALK"    , "narrator": "千羽鶴", "text": "ポーランドは今\n内戦状態で、とても\n行ける感じでは無い。"},
        { "location": "827/ACT"     , "narrator": "", "text": "いつか本当に結婚して南国旅行に行きたい"},
        { "location": "828/TALK"    , "narrator": "千羽鶴", "text": "そうね。"},
        { "location": "830/TALK"    , "narrator": "千羽鶴", "text": "……じゃなくて。"},
        { "location": "831/TALK"    , "narrator": "千羽鶴", "text": "私は非攻略対象だから、\nそういう現実は来ない。"},
        { "location": "834/TALK"    , "narrator": "千羽鶴", "text": "さあ、だいぶ時間\n使っちゃったし。"},
        { "location": "835/TALK"    , "narrator": "千羽鶴", "text": "ちゃっちゃと\nやることやって\n戻りましょ。"},
        { "location": "854/TALK"    , "narrator": "千羽鶴", "text": "いたい。"},
        { "location": "856/TALK"    , "narrator": "千羽鶴", "text": "こづかれた。"},
        { "location": "862/TALK"    , "narrator": "千羽鶴", "text": "押さない。"},
        { "location": "863/TALK"    , "narrator": "千羽鶴", "text": "胸は無い。"},
        { "location": "865/TALK"    , "narrator": "千羽鶴", "text": "小さいのが好き？"},
        { "location": "871/TALK"    , "narrator": "千羽鶴", "text": "なるほど。"},
        { "location": "873/TALK"    , "narrator": "千羽鶴", "text": "ちょっと。"},
        { "location": "874/TALK"    , "narrator": "千羽鶴", "text": "強く押しすぎ。"},
        { "location": "880/TALK"    , "narrator": "千羽鶴", "text": "ハネムーンだからって\n踊らされすぎ。"},
        { "location": "882/TALK"    , "narrator": "千羽鶴", "text": "そんなことしても\n株は上がらないから。"},
        { "location": "888/TALK"    , "narrator": "千羽鶴", "text": "おまわりさん、\nこの人です。"},
        { "location": "889/TALK"    , "narrator": "千羽鶴", "text": "通報した。"},
        { "location": "891/TALK"    , "narrator": "千羽鶴", "text": "変態。"},
        { "location": "897/TALK"    , "narrator": "千羽鶴", "text": "私に腹筋はないから\n触っても楽しくない。"},
        { "location": "899/TALK"    , "narrator": "千羽鶴", "text": "くすぐったい。"},
        { "location": "900/TALK"    , "narrator": "千羽鶴", "text": "ばか。"},
        { "location": "840/DIALOG"  , "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "907/DIALOG"  , "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"}
    ]
}
