        { "location": "316/TALK"    , "narrator": "つばめ", "text": "てぃぅか"},
        { "location": "317/TALK"    , "narrator": "つばめ", "text": "ぃつも聞いてばかりだね"},
        { "location": "319/SEL"     , "narrator": "", "text": "せやな"},
        { "location": "320/SEL"     , "narrator": "", "text": "別にいいよ"},
