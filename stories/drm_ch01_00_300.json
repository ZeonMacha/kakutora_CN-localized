        { "location": "322/ACT"     , "narrator": "", "text": "せやな"},
        { "location": "323/TALK"    , "narrator": "つばめ", "text": "ぅん"},
        { "location": "324/TALK"    , "narrator": "つばめ", "text": "そぅなんだ"},
        { "location": "325/ACT"     , "narrator": "", "text": "別にいいよ"},
        { "location": "326/TALK"    , "narrator": "つばめ", "text": "そぅ？"},
        { "location": "328/TALK"    , "narrator": "つばめ", "text": "よかった(*´︶`*)"},
        { "location": "329/ACT"     , "narrator": "", "text": "何でも言って"},
        { "location": "339/TALK"    , "narrator": "つばめ", "text": "ぅん"},
        { "location": "340/TALK"    , "narrator": "つばめ", "text": "ありがとう"},
        { "location": "342/TALK"    , "narrator": "つばめ", "text": "ひなこちゃんとの話"},
        { "location": "343/TALK"    , "narrator": "つばめ", "text": "おぼえてる？"},
        { "location": "345/SEL"     , "narrator": "", "text": "なんだっけ"},
        { "location": "346/SEL"     , "narrator": "", "text": "あー、あれか"},
        { "location": "347/SEL"     , "narrator": "", "text": "たぶん"},
        { "location": "348/ACT"     , "narrator": "", "text": "なんだっけ"},
        { "location": "349/TALK"    , "narrator": "つばめ", "text": "ぁ"},
        { "location": "350/TALK"    , "narrator": "つばめ", "text": "ひどぃ(´・ω・`) "},
        { "location": "351/ACT"     , "narrator": "", "text": "あー、あれか"},
        { "location": "352/TALK"    , "narrator": "つばめ", "text": "ぇと"},
        { "location": "353/TALK"    , "narrator": "つばめ", "text": "わかる？"},
        { "location": "354/ACT"     , "narrator": "", "text": "たぶん"},
        { "location": "355/TALK"    , "narrator": "つばめ", "text": "ぅーん"},
        { "location": "357/TALK"    , "narrator": "つばめ", "text": "わかるかな・・・"},
        { "location": "359/TALK"    , "narrator": "つばめ", "text": "雛ちゃんに真幌さんから借りた漫画の話してて"},
        { "location": "360/TALK"    , "narrator": "つばめ", "text": "なんｋ"},
        { "location": "361/TALK"    , "narrator": "つばめ", "text": "$handle$さんがかわいそうだって(´ｪ｀；)三(；´ｪ｀)"},
        { "location": "362/TALK"    , "narrator": "つばめ", "text": "そんな話になったんだょ"},
        { "location": "365/SEL"     , "narrator": "", "text": "同情はいらない"},
        { "location": "366/SEL"     , "narrator": "", "text": "言わせたいやつには言わせとけ"},
        { "location": "367/SEL"     , "narrator": "", "text": "気にしてないし"},
        { "location": "368/ACT"     , "narrator": "", "text": "同情はいらない"},
        { "location": "369/TALK"    , "narrator": "つばめ", "text": "そうなの？"},
        { "location": "370/TALK"    , "narrator": "つばめ", "text": "やせ我慢とかじゃなくって？"},
        { "location": "371/ACT"     , "narrator": "", "text": "言わせたいやつには言わせとけ"},
        { "location": "372/TALK"    , "narrator": "つばめ", "text": "えっと"},
        { "location": "374/TALK"    , "narrator": "つばめ", "text": "雛ちゃんは悪口言ってないと思うょ・・・？"},
        { "location": "375/ACT"     , "narrator": "", "text": "気にしてないし"},
        { "location": "376/TALK"    , "narrator": "つばめ", "text": "ぁっ"},
        { "location": "377/TALK"    , "narrator": "つばめ", "text": "ちょっと気にしてる風？"},
        { "location": "379/TALK"    , "narrator": "つばめ", "text": "やっぱり"},
        { "location": "380/TALK"    , "narrator": "つばめ", "text": "$handle$さんは"},
        { "location": "381/TALK"    , "narrator": "つばめ", "text": "かわぃそぅじゃないょね"},
        { "location": "386/TALK"    , "narrator": "ボイスメール", "text": "今日も月がきれい"},
        { "location": "335/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>800pt.</b></color></size>\nアップしました！"},
