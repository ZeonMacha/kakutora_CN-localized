        { "location": "48/TALK"   , "narrator": "ガブリエラ", "text": "やっぱりテレビより生の方が迫力があったわ！"},
        { "location": "49/TALK"   , "narrator": "ガブリエラ", "text": "それと"},
        { "location": "50/TALK"   , "narrator": "ガブリエラ", "text": "つばめも楽しんでたみたいね"},
