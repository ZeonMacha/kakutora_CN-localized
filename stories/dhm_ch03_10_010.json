        { "location": "55/ACT"    , "narrator": "", "text": "楽しめたの？"},
        { "location": "56/TALK"   , "narrator": "ガブリエラ", "text": "もちろんよ！"},
        { "location": "57/TALK"   , "narrator": "ガブリエラ", "text": "あそこまでエキサイティングだとは思わなかったわvvvvvvv"},
        { "location": "58/TALK"   , "narrator": "ガブリエラ", "text": "今度はマルザンナも一緒に行きましょうね！"},
        { "location": "59/ACT"    , "narrator": "", "text": "さすがは先輩だね"},
        { "location": "61/TALK"   , "narrator": "ガブリエラ", "text": "あら"},
        { "location": "62/TALK"   , "narrator": "ガブリエラ", "text": "先輩として当然のことをしただけよ"},
        { "location": "64/SEL"    , "narrator": "", "text": "なかなかできないよ"},
        { "location": "65/ACT"    , "narrator": "", "text": "なかなかできないよ"},
        { "location": "67/TALK"   , "narrator": "ガブリエラ", "text": "そうかしら///////////////////"},
        { "location": "68/TALK"   , "narrator": "ガブリエラ", "text": "私は当たり前のことをしただけよ////"},
        { "location": "69/TALK"   , "narrator": "ガブリエラ", "text": "先輩として"},
