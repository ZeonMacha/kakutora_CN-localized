    "entry":
    [
        { "location": "376/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "381/TALK"  , "narrator": "つばめ", "text": "$handle$さん"},
        { "location": "382/TALK"  , "narrator": "つばめ", "text": "神楽ちゃん"},
        { "location": "383/TALK"  , "narrator": "つばめ", "text": "会ってくれるかな？(´･ω･｀) "},
        { "location": "385/SEL"   , "narrator": "", "text": "心配？"},
        { "location": "386/ACT"   , "narrator": "", "text": "心配？"},
        { "location": "388/TALK"  , "narrator": "つばめ", "text": "だって"},
        { "location": "389/TALK"  , "narrator": "つばめ", "text": "ＷＡＶＥに返事くれなぃし(´つω・｀)ｼｭﾝ"},
        { "location": "390/TALK"  , "narrator": "つばめ", "text": "会ってくれるか"},
        { "location": "392/TALK"  , "narrator": "つばめ", "text": "不安でヾ(｡>﹏<｡)ﾉﾞ"},
        { "location": "394/SEL"   , "narrator": "", "text": "行かないで悩むより行ってスッキリしよう"},
        { "location": "395/ACT"   , "narrator": "", "text": "行かないで悩むより行ってスッキリしよう"},
        { "location": "398/TALK"  , "narrator": "つばめ", "text": "ぁりがとぅ(*´︶`*)"},
        { "location": "399/TALK"  , "narrator": "つばめ", "text": "決心付ぃたよ(๑･ㅂ･)و☆"},
        { "location": "400/TALK"  , "narrator": "つばめ", "text": "わたし"},
        { "location": "401/TALK"  , "narrator": "つばめ", "text": "行ってみる"},
        { "location": "415/TALK"  , "narrator": "つばめ", "text": "…じゃあ、明日。"},
        { "location": "417/TALK"  , "narrator": "つばめ", "text": "神楽ちゃんの家に\n行ってみるよ。"},
        { "location": "419/TALK"  , "narrator": "雛", "text": "うん…ごめんねー。\nつばめちゃんに\nお任せしちゃってー。"},
        { "location": "421/TALK"  , "narrator": "つばめ", "text": "ううん…わたしも、\nちょっとお話ししたい\nことあったし。"},
        { "location": "422/TALK"  , "narrator": "雛", "text": "えっへへ、あたしの\n予想的中だねー。"},
        { "location": "423/TALK"  , "narrator": "キリト", "text": "なあ、見舞い行ったら\nすぐにＷＡＶＥで\n教えてくれよ。"},
        { "location": "424/TALK"  , "narrator": "キリト", "text": "寝込んだりしてねぇか\n心配だからな。"},
        { "location": "425/TALK"  , "narrator": "雛", "text": "いや、風邪じゃないん\nだからさ…。"},
        { "location": "426/TALK"  , "narrator": "キリト", "text": "そんなのわかんねぇ\nだろ？"},
        { "location": "428/TALK"  , "narrator": "ヒカル", "text": "お見舞いに行ったら、\n僕にも報告して\nもらえますか？"},
        { "location": "429/TALK"  , "narrator": "つばめ", "text": "うん…でも、まだ\n会ってくれるかは\nわからないけど…。"},
        { "location": "430/TALK"  , "narrator": "雛", "text": "何言ってるの、\nつばめちゃん？"},
        { "location": "431/TALK"  , "narrator": "雛", "text": "つばめちゃんが\n行けば、絶対に会って\nくれるはずだよ。"},
        { "location": "433/TALK"  , "narrator": "つばめ", "text": "ひなこちゃん…。"},
        { "location": "434/TALK"  , "narrator": "雛", "text": "あとさ。"},
        { "location": "435/TALK"  , "narrator": "雛", "text": "急がなくていいから、\nこっちにも連絡してって\n伝えて欲しいな。"},
        { "location": "436/TALK"  , "narrator": "雛", "text": "あたし達だって、\n神楽ちゃんの\nお友達なんだし。"},
        { "location": "437/TALK"  , "narrator": "キリト", "text": "ああ、頼んだからな、\n逢瀬。"},
        { "location": "438/TALK"  , "narrator": "ヒカル", "text": "よろしく\nお願いしますね。"},
        { "location": "440/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "442/TALK"  , "narrator": "つばめ", "text": "うん、任せて！"},
        { "location": "445/TALK"  , "narrator": "つばめ", "text": "…みんなの気持ちを\n聞いたら――"},
        { "location": "446/TALK"  , "narrator": "つばめ", "text": "きっと、神楽ちゃんも\n元気になってくれる\nよね？"},
        { "location": "457/DIALOG", "narrator": "Dialog_chapter_ch01", "text": "【15 弾の数だけ抱きしめて】"}
    ]
}
