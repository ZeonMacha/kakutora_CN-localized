{
    "dir": "chap27/daydra/anime_05_27.js",
    "type": "MainStory",
    "info": {
        "story_id": "27501",
        "cid": "kagura",
        "title": "001 アニメーション",
        "sub_title": "ワールドオブワース"
    },
    "entry":
    [
        { "location": "1071/SCENARIO", "narrator": "", "text": "アニメ第27話"},
        { "location": "1084/TALK"    , "narrator": "エリカ", "text": "コーンコン。"},
        { "location": "1085/TALK"    , "narrator": "エリカ", "text": "いらっしゃい\n$handle$さん。"},
        { "location": "1086/TALK"    , "narrator": "エリカ", "text": "もう一度お話聞く？\nそれとも、省略する？"},
        { "location": "1087/SEL"     , "narrator": "", "text": "もう一度聞く"},
        { "location": "1088/SEL"     , "narrator": "", "text": "飛ばす"},
        { "location": "1089/ACT"     , "narrator": "", "text": "もう一度聞く"},
        { "location": "1090/TALK"    , "narrator": "エリカ", "text": "うん、わかったよ。"},
        { "location": "1092/ACT"     , "narrator": "", "text": "飛ばす"},
        { "location": "1093/TALK"    , "narrator": "エリカ", "text": "そっかー。\nそれじゃ、またね。"},
        { "location": "1099/TALK"    , "narrator": "エリカ", "text": "コーンコン。"},
        { "location": "1100/SEL"     , "narrator": "", "text": "こんにちは"},
        { "location": "1101/SEL"     , "narrator": "", "text": "またエリカか…"},
        { "location": "1102/ACT"     , "narrator": "", "text": "こんにちは"},
        { "location": "1103/TALK"    , "narrator": "エリカ", "text": "いつも来てくれて\nありがとう。"},
        { "location": "1104/ACT"     , "narrator": "", "text": "またエリカか…"},
        { "location": "1105/TALK"    , "narrator": "エリカ", "text": "ごめんね、\nわたしばっかりで。"},
        { "location": "1106/TALK"    , "narrator": "エリカ", "text": "やっぱり、\n千羽鶴ちゃんの方が\nいいよね。"},
        { "location": "1110/TALK"    , "narrator": "エリカ", "text": "それでね、\n前回お話していた\n千羽鶴ちゃんの件だけど！"},
        { "location": "1111/TALK"    , "narrator": "エリカ", "text": "結論から言えば、\nもしできれば、0x001に\n行って欲しいと思います。"},
        { "location": "1112/TALK"    , "narrator": "エリカ", "text": "もちろん、行けば解決と\nいうわけじゃないと思う。"},
        { "location": "1113/TALK"    , "narrator": "エリカ", "text": "むしろ今の状態で言えば、\n今こそが安定状態で――"},
        { "location": "1114/TALK"    , "narrator": "エリカ", "text": "仮に、原初ちゃんと同じ\nレイヤーに千羽鶴ちゃんが\n出現した場合。"},
        { "location": "1115/TALK"    , "narrator": "エリカ", "text": "そのパラドックスが\nどのような形で顕在するか\n全く予測できない。"},
        { "location": "1116/TALK"    , "narrator": "エリカ", "text": "もしくは、行っても\nなんら解決の糸口は\n無いかもしれない。"},
        { "location": "1117/TALK"    , "narrator": "エリカ", "text": "それでも、行けば何かの\n情報は手に入るかも\nしれないから。"},
        { "location": "1118/SEL"     , "narrator": "", "text": "もちろん行くよ"},
        { "location": "1119/SEL"     , "narrator": "", "text": "行かない"},
        { "location": "1120/ACT"     , "narrator": "", "text": "もちろん行くよ"},
        { "location": "1121/TALK"    , "narrator": "エリカ", "text": "ありがとう。"},
        { "location": "1122/TALK"    , "narrator": "エリカ", "text": "でも、行く前にひとつ、\nお話を聞いていってね。"},
        { "location": "1123/TALK"    , "narrator": "エリカ", "text": "今、千羽鶴ちゃんと\n原初ちゃんとの間に\n何が起こっているのか。"},
        { "location": "1124/ACT"     , "narrator": "", "text": "行かない"},
        { "location": "1125/TALK"    , "narrator": "エリカ", "text": "そっか。"},
        { "location": "1126/TALK"    , "narrator": "エリカ", "text": "もちろん、何か思うことが\nあるからこその拒否だと\n思うんだけど――"},
        { "location": "1127/TALK"    , "narrator": "エリカ", "text": "よかったら、今何が\n起こっているのかだけでも\n聞いていって欲しいかな。"},
        { "location": "1131/TALK"    , "narrator": "エリカ", "text": "それでね、\n今回はあなたに\nお願いがあります。"},
        { "location": "1132/SEL"     , "narrator": "", "text": "な、なに？"},
        { "location": "1133/ACT"     , "narrator": "", "text": "な、なに？"},
        { "location": "1135/TALK"    , "narrator": "エリカ", "text": "あっ、でも、\nお願いをする前に、\n一つ聞きたい事が。"},
        { "location": "1136/TALK"    , "narrator": "エリカ", "text": "実は、\n今回千羽鶴ちゃんが\n消滅しちゃった件――"},
        { "location": "1137/TALK"    , "narrator": "エリカ", "text": "色々な人から話を聞いた\n結果、助けられるかも\nしれない事がわかったの。"},
        { "location": "1138/SEL"     , "narrator": "", "text": "そうなの！？"},
        { "location": "1139/ACT"     , "narrator": "", "text": "そうなの！？"},
        { "location": "1141/TALK"    , "narrator": "エリカ", "text": "うん。"},
        { "location": "1142/TALK"    , "narrator": "エリカ", "text": "それでね、まず\n聞きたい事ってのは――"},
        { "location": "1143/TALK"    , "narrator": "エリカ", "text": "$handle$さんは\n千羽鶴ちゃんの復活には\n賛成ですか？"},
        { "location": "1144/SEL"     , "narrator": "", "text": "賛成"},
        { "location": "1145/SEL"     , "narrator": "", "text": "やること次第"},
        { "location": "1146/SEL"     , "narrator": "", "text": "反対"},
        { "location": "1147/ACT"     , "narrator": "", "text": "賛成"},
        { "location": "1148/TALK"    , "narrator": "エリカ", "text": "わかりました。\nそれではまず――"},
        { "location": "1149/TALK"    , "narrator": "エリカ", "text": "その方法の説明に先だって\n今、千羽鶴ちゃんに何が\n起こってるか説明するね。"},
        { "location": "1150/ACT"     , "narrator": "", "text": "やること次第"},
        { "location": "1151/TALK"    , "narrator": "エリカ", "text": "そうだよね。\nもちろんそれは\n今から説明するよ。"},
        { "location": "1152/ACT"     , "narrator": "", "text": "反対"},
        { "location": "1153/TALK"    , "narrator": "エリカ", "text": "そっか。"},
        { "location": "1157/TALK"    , "narrator": "エリカ", "text": "よくよく考えてみれば、\n原初ちゃんに賛同して\nいるんだものね。"},
        { "location": "1158/TALK"    , "narrator": "エリカ", "text": "聞くまでも無かったね。\nごめんね。"},
        { "location": "1161/TALK"    , "narrator": "エリカ", "text": "もちろん、何か思うことが\nあるからこその反対だと\n思うんだけど――"},
        { "location": "1162/TALK"    , "narrator": "エリカ", "text": "よかったら、今何が\n起こっているのかだけでも\n聞いていって欲しいかな。"},
        { "location": "1166/SEL"     , "narrator": "", "text": "説明を聞く"},
        { "location": "1167/SEL"     , "narrator": "", "text": "説明をスキップ"},
        { "location": "1168/ACT"     , "narrator": "", "text": "説明を聞く"},
        { "location": "1174/TALK"    , "narrator": "エリカ", "text": "前回、突然現れた\n原初ちゃんによって、\n千羽鶴ちゃんが消失。"},
        { "location": "1175/TALK"    , "narrator": "エリカ", "text": "それはあたかも、\n原初ちゃんに上書きされて\nしまったようでした。"},
        { "location": "1176/TALK"    , "narrator": "エリカ", "text": "この件を知った後、\nわたしは本人に聞いたり\nログを調べたりして――"},
        { "location": "1177/TALK"    , "narrator": "エリカ", "text": "やっと、原初ちゃんに\n関する１つの見解を\n導き出しました。"},
        { "location": "1186/TALK"    , "narrator": "エリカ", "text": "結論からいえば、\n彼女は恐らく――"},
        { "location": "1187/TALK"    , "narrator": "エリカ", "text": "リプレイス作戦を決行した\n時よりも未来から、\nここに来ています。"},
        { "location": "1188/TALK"    , "narrator": "エリカ", "text": "図で説明すると\nこうなります。"},
        { "location": "1189/TALK"    , "narrator": "エリカ", "text": "かなりの模式図なので\n現実とはちょっと相違が\nありますが。"},
        { "location": "1190/TALK"    , "narrator": "エリカ", "text": "わたしと千羽鶴ちゃんは\nリプレイス作戦決行と共に\nそこから未来へ行かず――"},
        { "location": "1191/TALK"    , "narrator": "エリカ", "text": "一旦過去へと戻り、\n今もその途中です。"},
        { "location": "1192/TALK"    , "narrator": "エリカ", "text": "原初ちゃんは、\nそれとは違い――"},
        { "location": "1193/TALK"    , "narrator": "エリカ", "text": "そのまま未来に進んだ\n所からアクセスしていると\n思われます。"},
        { "location": "1194/TALK"    , "narrator": "エリカ", "text": "その根拠は１つ。"},
        { "location": "1195/TALK"    , "narrator": "エリカ", "text": "過去に一度だけ、\nわたしと原初ちゃんは\nここで邂逅していて――"},
        { "location": "1196/TALK"    , "narrator": "エリカ", "text": "その原初ちゃんと、今回\nレイヤーが重なった彼女は\n同一の存在だから。"},
        { "location": "1197/TALK"    , "narrator": "エリカ", "text": "もっとわかりやすく言えば\n私と出会ったことを覚えて\nいる彼女だからです。"},
        { "location": "1198/TALK"    , "narrator": "エリカ", "text": "先ほど彼女とコンタクトを\n取ったところ、そのことが\n判明しました。"},
        { "location": "1207/TALK"    , "narrator": "エリカ", "text": "もちろん直接会っては\nいませんが――"},
        { "location": "1208/TALK"    , "narrator": "エリカ", "text": "チャットでやりとりをして\n彼女に幾つかの情報の\n伝達を依頼しました。"},
        { "location": "1209/TALK"    , "narrator": "エリカ", "text": "覚えてますか？\n原初ちゃんからリプレイス\n関連の説明を受けたこと。"},
        { "location": "1210/TALK"    , "narrator": "エリカ", "text": "TRI-OSのナンバーで言えば\nEP31にあたります。"},
        { "location": "1211/TALK"    , "narrator": "エリカ", "text": "そして、わたしと彼女が\n一緒にいたのは、ここが\n最初で最後――"},
        { "location": "1212/TALK"    , "narrator": "エリカ", "text": "それ以降、彼女がわたしと\n一緒に、何かの処理を\nしたことはありません。"},
        { "location": "1218/TALK"    , "narrator": "エリカ", "text": "これらから導き出される\n回答としては――"},
        { "location": "1219/TALK"    , "narrator": "エリカ", "text": "原初ちゃんは、EP31以降の\n未来にいる存在である。"},
        { "location": "1220/TALK"    , "narrator": "エリカ", "text": "そして、わたしたちのいる\nレイヤー、すなわち――"},
        { "location": "1221/TALK"    , "narrator": "エリカ", "text": "今わたしがいる\nポインタを探していて、\nそれを先日見つけられた。"},
        { "location": "1222/TALK"    , "narrator": "エリカ", "text": "その後すかさず、\n自分をそのポインタに\nジャンプさせ――"},
        { "location": "1223/TALK"    , "narrator": "エリカ", "text": "それによってレイヤーが\n合致してしまった。"},
        { "location": "1224/TALK"    , "narrator": "エリカ", "text": "同一のレイヤー、すなわち\n時空間及び世界線が同一と\nなる場合――"},
        { "location": "1225/TALK"    , "narrator": "エリカ", "text": "同一の存在は\n二体同時に顕在できない。"},
        { "location": "1226/TALK"    , "narrator": "エリカ", "text": "よって、\n千羽鶴ちゃんは消えた。"},
        { "location": "1227/SEL"     , "narrator": "", "text": "原初のつばめは何の為にそんなことを…？"},
        { "location": "1228/ACT"     , "narrator": "", "text": "原初のつばめは何の為にそんなことを…？"},
        { "location": "1230/TALK"    , "narrator": "エリカ", "text": "レイヤーを移動しなければ\n出来ないことを\nするためでしょうか。"},
        { "location": "1231/TALK"    , "narrator": "エリカ", "text": "例えば、わたしとの対話、\n過去への介入、あとは、\nナビ権限の取得など。"},
        { "location": "1232/TALK"    , "narrator": "エリカ", "text": "今の感じを見ていると、\nナビ権限の取得と過去への\n介入が目的ではないかと。"},
        { "location": "1233/SEL"     , "narrator": "", "text": "そういえば何度か「わたしはナビじゃないから」と言ってた気が"},
        { "location": "1234/ACT"     , "narrator": "", "text": "そういえば何度か「わたしはナビじゃないから」と言ってた気が"},
        { "location": "1241/TALK"    , "narrator": "エリカ", "text": "ナビ権限が無い場合――"},
        { "location": "1242/TALK"    , "narrator": "エリカ", "text": "ここには顔を出せても、\nスタックポインタなどの\n操作はできません。"},
        { "location": "1243/TALK"    , "narrator": "エリカ", "text": "来るだけなら、例えば\nみやびちゃん神楽ちゃんも\n来ていましたが――"},
        { "location": "1244/TALK"    , "narrator": "エリカ", "text": "彼女たちも会話しただけで\n設定されたポインタを操作\nしたりはしてませんから。"},
        { "location": "1245/TALK"    , "narrator": "エリカ", "text": "実はリプレイス作戦\n開始後の千羽鶴ちゃんも\n同じで――"},
        { "location": "1246/TALK"    , "narrator": "エリカ", "text": "ナビとしてではなく、\nアドバイザーとして\n同行してもらっています。"},
        { "location": "1251/TALK"    , "narrator": "エリカ", "text": "恐らく順当な考えで言えば\n何らかの不満があって、\n過去に介入してきた。"},
        { "location": "1252/TALK"    , "narrator": "エリカ", "text": "それはわたしたちの\nやり方に対する不満も\nあるのだと思います。"},
        { "location": "1253/SEL"     , "narrator": "", "text": "$me$は色々聞いてるけど、話していいものなのだろうか"},
        { "location": "1254/ACT"     , "narrator": "", "text": "$me$は色々聞いてるけど、話していいものなのだろうか"},
        { "location": "1256/TALK"    , "narrator": "エリカ", "text": "うーん、\n内容次第だとは\n思うけど――"},
        { "location": "1257/TALK"    , "narrator": "エリカ", "text": "やっぱり、わたしから\n直接原初ちゃんに聞いた\n方がいいかもしれない。"},
        { "location": "1258/TALK"    , "narrator": "エリカ", "text": "又聞きだと色々\n思い込みもしちゃったり\nするしね。"},
        { "location": "1259/TALK"    , "narrator": "エリカ", "text": "というわけで、\nとりあえずまずは、\n彼女に直接聞いてみるよ。"},
        { "location": "1260/TALK"    , "narrator": "エリカ", "text": "どうしてもダメだったら、\nあなたにちょっとだけ\n力を借りるかも。"},
        { "location": "1262/TALK"    , "narrator": "エリカ", "text": "というわけで――"},
        { "location": "1263/TALK"    , "narrator": "エリカ", "text": "わたしからの\n説明は以上になります！"},
        { "location": "1264/TALK"    , "narrator": "エリカ", "text": "はぁー、長かったよ。"},
        { "location": "1265/SEL"     , "narrator": "", "text": "お疲れさま！"},
        { "location": "1266/SEL"     , "narrator": "", "text": "ずっと真面目口調だったからちょっとビックリした"},
        { "location": "1267/SEL"     , "narrator": "", "text": "長くて疲れたし、わかりにくい"},
        { "location": "1268/ACT"     , "narrator": "", "text": "お疲れさま！"},
        { "location": "1269/TALK"    , "narrator": "エリカ", "text": "ありがとう！"},
        { "location": "1270/ACT"     , "narrator": "", "text": "ずっと真面目口調だったからちょっとビックリした"},
        { "location": "1271/TALK"    , "narrator": "エリカ", "text": "あ、そっか。\n今までそういう場面は\n無かったよね。"},
        { "location": "1272/TALK"    , "narrator": "エリカ", "text": "わたし、本当に真剣に\n何かをプレゼンする時って\nこうなっちゃうの。"},
        { "location": "1273/TALK"    , "narrator": "エリカ", "text": "国連でお話するとき\n以来だから、わたしも\n久し振りだったかな。"},
        { "location": "1274/TALK"    , "narrator": "エリカ", "text": "でも、ちょっと事務的で\n冷たく見えるよね……。"},
        { "location": "1275/SEL"     , "narrator": "", "text": "仕事ができる人みたいでかっこいい"},
        { "location": "1276/SEL"     , "narrator": "", "text": "ちょっと怖かった"},
        { "location": "1277/ACT"     , "narrator": "", "text": "仕事ができる人みたいでかっこいい"},
        { "location": "1278/TALK"    , "narrator": "エリカ", "text": "えへへ。\n褒められちゃった。"},
        { "location": "1279/ACT"     , "narrator": "", "text": "ちょっと怖かった"},
        { "location": "1280/TALK"    , "narrator": "エリカ", "text": "そうだよね。"},
        { "location": "1282/ACT"     , "narrator": "", "text": "長くて疲れたし、わかりにくい"},
        { "location": "1283/TALK"    , "narrator": "エリカ", "text": "そっかー、\nごめんね。"},
        { "location": "1284/TALK"    , "narrator": "エリカ", "text": "次からはもっと\n短くわかりやすくお話する\nように頑張るからね？"},
        { "location": "1286/TALK"    , "narrator": "エリカ", "text": "ということで、\n本題に戻って――"},
        { "location": "1287/TALK"    , "narrator": "エリカ", "text": "これから何をするかに\nついて、お話していくね。"},
        { "location": "1288/ACT"     , "narrator": "", "text": "説明をスキップ"},
        { "location": "1289/TALK"    , "narrator": "エリカ", "text": "それじゃあ、\n何をするかについての\n話に進むね。"},
        { "location": "1292/TALK"    , "narrator": "エリカ", "text": "このお話は、あなたが\n0x001で千羽鶴ちゃんを\n救出できた前提で話すよ。"},
        { "location": "1293/TALK"    , "narrator": "エリカ", "text": "0x001で何が起こるかは\n未知数だし、そこを議論\nしても仕方ないから。"},
        { "location": "1294/TALK"    , "narrator": "エリカ", "text": "あなたが0x001に\n向かう直前、すなわち\nこの話が終わった直後――"},
        { "location": "1296/TALK"    , "narrator": "エリカ", "text": "さっきお話した、\n千羽鶴ちゃんを復活\nできるかもしれない件。"},
        { "location": "1297/TALK"    , "narrator": "エリカ", "text": "何をするのかというと、\nこのお話が終わった\n直後から――"},
        { "location": "1299/TALK"    , "narrator": "エリカ", "text": "パラメトリック理論に\n基づく世界選進行を\n発動させます。"},
        { "location": "1300/SEL"     , "narrator": "", "text": "それって要するに、また総意による未来の選択をするってこと？"},
        { "location": "1301/ACT"     , "narrator": "", "text": "それって要するに、また総意による未来の選択をするってこと？"},
        { "location": "1303/TALK"    , "narrator": "エリカ", "text": "そう。"},
        { "location": "1309/TALK"    , "narrator": "エリカ", "text": "今回の件は、\n千羽鶴ちゃんを助ける術を\n持つ人と持たない人がいて"},
        { "location": "1310/TALK"    , "narrator": "エリカ", "text": "統計をとると、\n術を持たない人の方が\n圧倒的に多いの。"},
        { "location": "1311/TALK"    , "narrator": "エリカ", "text": "だから、みんな一人一人が\n個人で頑張っても――"},
        { "location": "1312/TALK"    , "narrator": "エリカ", "text": "100人中100人全員が、\n千羽鶴ちゃんを\n救出できるわけじゃない。"},
        { "location": "1313/TALK"    , "narrator": "エリカ", "text": "けれども、\n世界進行法を\n稼働させておけば――"},
        { "location": "1314/TALK"    , "narrator": "エリカ", "text": "救出できない人も、\n収束後は救出された世界に\n統一されることになる。"},
        { "location": "1315/TALK"    , "narrator": "エリカ", "text": "そう……、\n前回のリプレイス作戦も、"},
        { "location": "1324/TALK"    , "narrator": "エリカ", "text": "以前行われた、\nつばめちゃんのセルフを\n誰にするかの時も。"},
        { "location": "1325/TALK"    , "narrator": "エリカ", "text": "良くも悪くも世界進行法は\n常にこの世界を、\n１つの筋に統一してきた。"},
        { "location": "1326/TALK"    , "narrator": "エリカ", "text": "今回は\nそれを逆手にとって――"},
        { "location": "1327/TALK"    , "narrator": "エリカ", "text": "少数の人が千羽鶴ちゃんを\n助ける事で、全員の彼女が\n助かるようにするの。"},
        { "location": "1332/SEL"     , "narrator": "", "text": "わかった"},
        { "location": "1333/SEL"     , "narrator": "", "text": "ちょっとまって"},
        { "location": "1334/ACT"     , "narrator": "", "text": "わかった"},
        { "location": "1335/TALK"    , "narrator": "エリカ", "text": "というわけで――"},
        { "location": "1336/ACT"     , "narrator": "", "text": "ちょっとまって"},
        { "location": "1337/TALK"    , "narrator": "エリカ", "text": "どうしたの？"},
        { "location": "1338/SEL"     , "narrator": "", "text": "世界進行法は多数決でしょ？"},
        { "location": "1339/ACT"     , "narrator": "", "text": "世界進行法は多数決でしょ？"},
        { "location": "1341/TALK"    , "narrator": "エリカ", "text": "乱暴にいえば、\nそうだね。"},
        { "location": "1342/SEL"     , "narrator": "", "text": "じゃあ、千羽鶴を助ける術がない人の方が多ければ、助からないのでは？"},
        { "location": "1343/ACT"     , "narrator": "", "text": "じゃあ、千羽鶴を助ける術がない人の方が多ければ、助からないのでは？"},
        { "location": "1345/TALK"    , "narrator": "エリカ", "text": "そうだね。\nもちろんその通り。"},
        { "location": "1346/TALK"    , "narrator": "エリカ", "text": "今回の世界進行法は、\n乱暴に言えば――"},
        { "location": "1347/TALK"    , "narrator": "エリカ", "text": "千羽鶴ちゃんが\n助かるルートと\n助からないルート、"},
        { "location": "1348/TALK"    , "narrator": "エリカ", "text": "この2択の天秤だと\n考えることができるの。\nそして――"},
        { "location": "1349/TALK"    , "narrator": "エリカ", "text": "千羽鶴ちゃんの場所を\n知らない人は、絶対に\n助からないルートになる。"},
        { "location": "1350/TALK"    , "narrator": "エリカ", "text": "よって、普通にやれば、\n貴方の言うとおり、助かる\nルートに勝ち目はない。"},
        { "location": "1351/TALK"    , "narrator": "エリカ", "text": "だから――"},
        { "location": "1353/TALK"    , "narrator": "エリカ", "text": "千羽鶴ちゃんの場所を\n知らない総意の方には、\n<color=red>今回は棄権してもらう。</color>"},
        { "location": "1354/SEL"     , "narrator": "", "text": "棄権！？"},
        { "location": "1355/ACT"     , "narrator": "", "text": "棄権！？"},
        { "location": "1357/TALK"    , "narrator": "エリカ", "text": "総意システムは、\n主催者が棄権という選択を\n許可することが出来る。"},
        { "location": "1358/TALK"    , "narrator": "エリカ", "text": "そして、総意個人が自分の\n意志で棄権を選択した場合\nそれは無効票になる。"},
        { "location": "1359/TALK"    , "narrator": "エリカ", "text": "それを逆手にとって、\n助ける術を持たない人が\nみんな棄権すれば――"},
        { "location": "1360/TALK"    , "narrator": "エリカ", "text": "千羽鶴ちゃんが助かる\n未来の方を、遙かに大きく\n出来ることになる。"},
        { "location": "1361/SEL"     , "narrator": "", "text": "逆転の発想だ！"},
        { "location": "1362/SEL"     , "narrator": "", "text": "めちゃトリッキーやな"},
        { "location": "1363/ACT"     , "narrator": "", "text": "逆転の発想だ！"},
        { "location": "1364/TALK"    , "narrator": "エリカ", "text": "そう、ちょっとした\nコロンブスの卵？"},
        { "location": "1365/ACT"     , "narrator": "", "text": "めちゃトリッキーやな"},
        { "location": "1366/TALK"    , "narrator": "エリカ", "text": "こういうのを考えるのは\n好きなんだ。"},
        { "location": "1369/TALK"    , "narrator": "エリカ", "text": "もちろん、あなたが\n0x001に行っても、救出\nできるとは限らない。"},
        { "location": "1370/TALK"    , "narrator": "エリカ", "text": "けど、もし出来たときに\n世界進行法をセットして\nいなかったら――"},
        { "location": "1371/TALK"    , "narrator": "エリカ", "text": "それは、\nあなただけの物語で\n終わってしまうから。"},
        { "location": "1373/TALK"    , "narrator": "エリカ", "text": "もちろん、助けに行ける\n人が、行って本当に救出\nできるかは未知数。"},
        { "location": "1374/TALK"    , "narrator": "エリカ", "text": "けど、もし出来たときに\n世界進行法をセットして\nいなかったら――"},
        { "location": "1375/TALK"    , "narrator": "エリカ", "text": "あなたの千羽鶴ちゃんは\n助からないままだから。"},
        { "location": "1377/TALK"    , "narrator": "エリカ", "text": "今回くらいの大きな変化で\n助かるか否かが\n二分化してしまうと――"},
        { "location": "1378/TALK"    , "narrator": "エリカ", "text": "その２つの世界は、\n完全に別世界の\n別物になってしまう。"},
        { "location": "1379/TALK"    , "narrator": "エリカ", "text": "わたしたちの世界にとって\n総意の誰もが、とても\n重要で大切だから――"},
        { "location": "1380/TALK"    , "narrator": "エリカ", "text": "みんなで一緒に協力して、\n千羽鶴ちゃんを連れ\n戻したいと思ってます。"},
        { "location": "1381/TALK"    , "narrator": "エリカ", "text": "だから、今回の件は、\nどうかご協力\nよろしくお願いします。"},
        { "location": "1383/TALK"    , "narrator": "エリカ", "text": "というわけで、\n改めて聞くよ。"},
        { "location": "1384/TALK"    , "narrator": "エリカ", "text": "アドレス0x001へ\n向かうこと、正式に\nお願いできますか？"},
        { "location": "1395/SEL"     , "narrator": "", "text": "千羽鶴を助けに行きます"},
        { "location": "1396/SEL"     , "narrator": "", "text": "拒否します"},
        { "location": "1397/ACT"     , "narrator": "", "text": "千羽鶴を助けに行きます"},
        { "location": "1398/TALK"    , "narrator": "エリカ", "text": "ありがとう。"},
        { "location": "1399/TALK"    , "narrator": "エリカ", "text": "ただその場合、\nぴょんこちゃんの件まで\n手が回らないと思うの。"},
        { "location": "1400/TALK"    , "narrator": "エリカ", "text": "だから、ぴょんこちゃんの\n件で、何か総意をとる事が\nある場合は棄権になる。"},
        { "location": "1401/TALK"    , "narrator": "エリカ", "text": "それも含めて\n大丈夫かな？"},
        { "location": "1402/SEL"     , "narrator": "", "text": "ぴょんこの件は、棄権で構わない"},
        { "location": "1403/SEL"     , "narrator": "", "text": "ぴょんこの方が大事なので、ぴょんこを助けに行きたい"},
        { "location": "1404/ACT"     , "narrator": "", "text": "ぴょんこの件は、棄権で構わない"},
        { "location": "1409/TALK"    , "narrator": "エリカ", "text": "わかりました。"},
        { "location": "1410/TALK"    , "narrator": "エリカ", "text": "千羽鶴ちゃんのこと、\nどうかよろしく\nお願いします。"},
        { "location": "1411/ACT"     , "narrator": "", "text": "ぴょんこの方が大事なので、ぴょんこを助けに行きたい"},
        { "location": "1414/TALK"    , "narrator": "エリカ", "text": "わかりました。"},
        { "location": "1415/TALK"    , "narrator": "エリカ", "text": "それじゃ、もう一つ\n質問になっちゃうけど――"},
        { "location": "1416/TALK"    , "narrator": "エリカ", "text": "ぴょんこちゃんの方に\n行く場合、千羽鶴ちゃんに\nついては対応できなくなる"},
        { "location": "1417/TALK"    , "narrator": "エリカ", "text": "だから、\n千羽鶴ちゃんについては\n棄権でいいですか？"},
        { "location": "1420/ACT"     , "narrator": "", "text": "拒否します"},
        { "location": "1421/TALK"    , "narrator": "エリカ", "text": "うん、わかったよ。"},
        { "location": "1422/TALK"    , "narrator": "エリカ", "text": "それじゃ、更に質問。"},
        { "location": "1423/TALK"    , "narrator": "エリカ", "text": "今回の千羽鶴ちゃん救出に\n関する世界進行法は\n棄権してくれますか？"},
        { "location": "1425/TALK"    , "narrator": "エリカ", "text": "あなたが棄権すれば、\n千羽鶴ちゃんが助かる\n可能性は上がって――"},
        { "location": "1426/TALK"    , "narrator": "エリカ", "text": "棄権しなければ、\n助かる可能性は下がるよ。"},
        { "location": "1427/SEL"     , "narrator": "", "text": "棄権する"},
        { "location": "1428/SEL"     , "narrator": "", "text": "棄権しない"},
        { "location": "1429/ACT"     , "narrator": "", "text": "棄権する"},
        { "location": "1432/TALK"    , "narrator": "エリカ", "text": "ありがとう。"},
        { "location": "1433/ACT"     , "narrator": "", "text": "棄権しない"},
        { "location": "1436/TALK"    , "narrator": "エリカ", "text": "そっか。\nわかったよ。"},
        { "location": "1440/TALK"    , "narrator": "エリカ", "text": "というわけで、\n改めて聞くよ。"},
        { "location": "1441/TALK"    , "narrator": "エリカ", "text": "今回の千羽鶴ちゃん救出に\n関する世界進行法は\n棄権してくれますか？"},
        { "location": "1442/TALK"    , "narrator": "エリカ", "text": "あなたが棄権すれば、\n千羽鶴ちゃんが助かる\n可能性は上がって――"},
        { "location": "1443/TALK"    , "narrator": "エリカ", "text": "棄権しなければ、\n助かる可能性は下がるよ。"},
        { "location": "1444/TALK"    , "narrator": "エリカ", "text": "もっと乱暴に言えば、\nあなたは棄権することで\n千羽鶴ちゃんを助けられる"},
        { "location": "1445/TALK"    , "narrator": "エリカ", "text": "逆に、復活に協力したく\nなければ、棄権を拒否して\nくれればいいの。"},
        { "location": "1456/SEL"     , "narrator": "", "text": "棄権する"},
        { "location": "1457/SEL"     , "narrator": "", "text": "棄権しない"},
        { "location": "1458/ACT"     , "narrator": "", "text": "棄権する"},
        { "location": "1461/TALK"    , "narrator": "エリカ", "text": "ありがとう。"},
        { "location": "1462/ACT"     , "narrator": "", "text": "棄権しない"},
        { "location": "1465/TALK"    , "narrator": "エリカ", "text": "そっか。\nわかったよ。"},
        { "location": "1469/TALK"    , "narrator": "エリカ", "text": "それじゃ、今回の\nわたしの話はこれで\nおしまい。"},
        { "location": "1470/TALK"    , "narrator": "エリカ", "text": "記録映像を見たら、\n世界進行法が\nセットアップされる。"},
        { "location": "1472/TALK"    , "narrator": "エリカ", "text": "あなたは、デイドラで\nココロゲートに入ったら\n早速行動を起こしてね。"},
        { "location": "1473/TALK"    , "narrator": "エリカ", "text": "つばめちゃんのアドレス\n0x001へ行きたいと司書に\n伝えれば送ってくれる筈。"},
        { "location": "1474/TALK"    , "narrator": "エリカ", "text": "どうか、\nよろしくお願いします。"},
        { "location": "1475/TALK"    , "narrator": "エリカ", "text": "千羽鶴ちゃんが今後\nここに来れるかは、\nあなたにかかってるの。"},
        { "location": "1478/TALK"    , "narrator": "エリカ", "text": "あなたは、今回の件では\n千羽鶴ちゃんの所へは\n行かないわけだから――"},
        { "location": "1480/TALK"    , "narrator": "エリカ", "text": "あなたは、今回の件では\n特にできることは\nないから――"},
        { "location": "1482/TALK"    , "narrator": "エリカ", "text": "普通に神楽ちゃんの\n心のケアを\nお願いします。"},
        { "location": "1484/TALK"    , "narrator": "エリカ", "text": "いろいろと唐突な作戦に\nなっちゃったけど、\n大丈夫だったかな…？"},
        { "location": "1485/SEL"     , "narrator": "", "text": "もちろんバッチリよ"},
        { "location": "1486/SEL"     , "narrator": "", "text": "エリカが丁寧に説明してくれたから大丈夫だよ"},
        { "location": "1487/SEL"     , "narrator": "", "text": "正直、ついていけてない"},
        { "location": "1488/ACT"     , "narrator": "", "text": "もちろんバッチリよ"},
        { "location": "1489/TALK"    , "narrator": "エリカ", "text": "よかった。\nとっても心強いよ。"},
        { "location": "1490/ACT"     , "narrator": "", "text": "エリカが丁寧に説明してくれたから大丈夫だよ"},
        { "location": "1491/TALK"    , "narrator": "エリカ", "text": "そう言ってもらえると、\n説明した甲斐があったよ。"},
        { "location": "1492/ACT"     , "narrator": "", "text": "正直、ついていけてない"},
        { "location": "1493/TALK"    , "narrator": "エリカ", "text": "そっかー。"},
        { "location": "1494/TALK"    , "narrator": "エリカ", "text": "わたしの説明が下手で、\n迷惑かけてごめんね？"},
        { "location": "1496/TALK"    , "narrator": "エリカ", "text": "それじゃ、\n記録映像を見ていく？"},
        { "location": "1498/SEL"     , "narrator": "", "text": "映像を見る\n<color=green>【高画質/75MB 4:47】</color>"},
        { "location": "1499/SEL"     , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/25MB 4:47】</color>"},
        { "location": "1500/SEL"     , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "1501/ACT"     , "narrator": "", "text": "映像を見る\n<color=green>【高画質/75MB 4:47】</color>"},
        { "location": "1502/TALK"    , "narrator": "エリカ", "text": "わかったよ。"},
        { "location": "1508/ACT"     , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/25MB 4:47】</color>"},
        { "location": "1509/TALK"    , "narrator": "エリカ", "text": "わかったよ。"},
        { "location": "1515/ACT"     , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "1516/TALK"    , "narrator": "エリカ", "text": "あらら。"},
        { "location": "1552/SEL"     , "narrator": "", "text": "ソイルトンこんにちは"},
        { "location": "1553/ACT"     , "narrator": "", "text": "ソイルトンこんにちは"},
        { "location": "1557/TALK"    , "narrator": "ソイルトン", "text": "いやはや、今回の$handle$との邂逅は、全くの予測不能でしたよ。"},
        { "location": "1558/TALK"    , "narrator": "ソイルトン", "text": "まさに、計算によって未来の可能性を知る事ができる私ですら、このような短期間でまた$handle$と再会できるとは思いもしませんでした。"},
        { "location": "1559/TALK"    , "narrator": "ソイルトン", "text": "改めて、お逢いできて光栄ですよ$handle$。そして再びパラメトリック理論に基づく世界進行法をご利用いただきありがとうございます。"},
        { "location": "1560/TALK"    , "narrator": "ソイルトン", "text": "しかし今回は異常なまでの緊急スケジュールによって、私もかなりのイレギュラー対応を強いられることとなりました。"},
        { "location": "1561/SEL"     , "narrator": "", "text": "お疲れさまです…"},
        { "location": "1562/ACT"     , "narrator": "", "text": "お疲れさまです…"},
        { "location": "1564/TALK"    , "narrator": "ソイルトン", "text": "いえいえ、$handle$の苦労に比べれば、私など何もしていないも同然です。それよりどうか、$handle$はご自身のメンタルをご自愛ください。"},
        { "location": "1565/TALK"    , "narrator": "ソイルトン", "text": "休みたい時は、パーッと休んでしまってもいいのですよ？\nこの世界は$handle$が思うよりも遙かに赦されている世界なのですから。"},
        { "location": "1566/TALK"    , "narrator": "ソイルトン", "text": "さて、それでは最終アナウンスをさせていただくこととしましょう。"},
        { "location": "1567/TALK"    , "narrator": "ソイルトン", "text": "すなわち、このエピソード２１の現時点より、TRI-OSは“パラメトリック理論に基づく世界進行法”による、未来選択モードに移行します。"},
        { "location": "1568/TALK"    , "narrator": "ソイルトン", "text": "その後対向時間における任意の数日間を経て、その時の選択状況により未来が確定するというものです。"},
        { "location": "1569/TALK"    , "narrator": "ソイルトン", "text": "厳密には、その時間は、2018年5月14日の0時となります。その時点で最終的に選択されているルートが、貴方の回答となります。"},
        { "location": "1570/TALK"    , "narrator": "ソイルトン", "text": "告知は以上となります。"},
        { "location": "1571/TALK"    , "narrator": "ソイルトン", "text": "それではごきげんよう、$handle$。貴方に素敵なパラメトリックライフを！"},
        { "location": "1572/SEL"     , "narrator": "", "text": "待って！"},
        { "location": "1573/SEL"     , "narrator": "", "text": "Bye!"},
        { "location": "1574/ACT"     , "narrator": "", "text": "待って！"},
        { "location": "1575/TALK"    , "narrator": "ソイルトン", "text": "何か御用でしょうか？"},
        { "location": "1576/SEL"     , "narrator": "", "text": "せっかくだから、またお話しませんか？"},
        { "location": "1577/ACT"     , "narrator": "", "text": "せっかくだから、またお話しませんか？"},
        { "location": "1579/TALK"    , "narrator": "ソイルトン", "text": "お気持ちは嬉しいのですが、さすがに今回の進行は大変な強行スケジュールでして。こうしている間にも、準備せねばならないような状況なのです。"},
        { "location": "1580/TALK"    , "narrator": "ソイルトン", "text": "お喋りで有名なソイルトン（自システム調べ）にとって、このようなことは異例中の異例。ある意味$handle$は、歴史的な瞬間を目の当たりにしているとも言えましょう。"},
        { "location": "1581/TALK"    , "narrator": "ソイルトン", "text": "いずれにせよ、今回はこれ以上の文字数を書くことはできません。それらのリソースは、順当に世界進行法のセットアップに充てられるべきだからです。"},
        { "location": "1584/TALK"    , "narrator": "ソイルトン", "text": "それではごきげんよう、$handle$。また逢うその日まで！"},
        { "location": "1172/DIALOG"  , "narrator": "Event/Dialog_EventPicTallNW", "text": "千羽鶴、上書きされる。"},
        { "location": "1184/DIALOG"  , "narrator": "Event/Dialog_EventPicTallNW", "text": "原初のつばめの立ち位置。"},
        { "location": "1205/DIALOG"  , "narrator": "Event/Dialog_EventPicTallNW", "text": "原初のつばめとの出逢い。"},
        { "location": "1239/DIALOG"  , "narrator": "Event/Dialog_EventPicTallNW", "text": "わたしはナビではありません。"},
