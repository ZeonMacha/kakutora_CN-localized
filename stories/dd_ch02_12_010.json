{
    "dir": "chap12/daydra/dd_ch02_12_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "12252",
        "cid": "ayami",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "裁縫上手"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "裁縫上手"},
        { "location": "21/TALK"   , "narrator": "アーヤ", "text": "つばめ、ちょっと待って。"},
        { "location": "23/TALK"   , "narrator": "つばめ", "text": "え、なんですか？"},
        { "location": "24/TALK"   , "narrator": "アーヤ", "text": "ボタン、\n取れかかってるわ。"},
        { "location": "26/TALK"   , "narrator": "雛", "text": "あっ、ほんとだ。\n今にも取れちゃいそう\nだよ。"},
        { "location": "28/TALK"   , "narrator": "アーヤ", "text": "直してあげるから、\nちょっと貸して。"},
        { "location": "37/TALK"   , "narrator": "アーヤ", "text": "ちゃんと直ってる？"},
        { "location": "41/TALK"   , "narrator": "つばめ", "text": "わぁ、アーヤさん\n凄いです！！"},
        { "location": "44/TALK"   , "narrator": "雛", "text": "す、凄い…あっという間に\n直しちゃった…。"},
        { "location": "47/TALK"   , "narrator": "アーヤ", "text": "大げさね。\nボタンを付けただけ\nなのに。"},
        { "location": "54/TALK"   , "narrator": "雛", "text": "っていうか、綾水様って\n凄く裁縫がお上手なん\nですね！"},
        { "location": "55/TALK"   , "narrator": "雛", "text": "なんだかミシンみたいに\n速くて正確だったから、\nビックリしました！"},
        { "location": "57/TALK"   , "narrator": "アーヤ", "text": "褒め過ぎよ。"},
        { "location": "58/TALK"   , "narrator": "アーヤ", "text": "…でも、そんなふうに\n言ってもらえると\n嬉しいわ。"},
        { "location": "61/TALK"   , "narrator": "つばめ", "text": "凄くかっこよかったです！"},
        { "location": "62/TALK"   , "narrator": "つばめ", "text": "やっぱり、小さい頃から\nいっぱい練習してたん\nですか？"},
        { "location": "63/TALK"   , "narrator": "アーヤ", "text": "小さい頃はほとんど\nお裁縫なんてやらな\nかったわ。"},
        { "location": "64/TALK"   , "narrator": "アーヤ", "text": "大学に入ってからは、\n毎日のようにしてるけど。"},
        { "location": "66/TALK"   , "narrator": "雛", "text": "ま、毎日！？\n一体何をそんなに\n縫ってるんですか？"},
        { "location": "68/TALK"   , "narrator": "アーヤ", "text": "えっ！？"},
        { "location": "69/SEL"    , "narrator": "", "text": "座布団とかのカバー"},
        { "location": "70/SEL"    , "narrator": "", "text": "パッチワーク"},
        { "location": "71/SEL"    , "narrator": "", "text": "人形作りって言っちゃえ"},
        { "location": "76/TALK"   , "narrator": "アーヤ", "text": "どうしよう。\n人形サークルのことは\nみんなには秘密だから――"},
        { "location": "77/TALK"   , "narrator": "アーヤ", "text": "毎日人形を作ってる、\nなんて言えないし…。"},
        { "location": "82/TALK"   , "narrator": "アーヤ", "text": "えっと…ごめんなさい。\n毎日は言い過ぎたわ。"},
        { "location": "83/TALK"   , "narrator": "アーヤ", "text": "でも、古着とかを買うと\nたまに傷んだりしている\nことがあるでしょ？"},
        { "location": "84/TALK"   , "narrator": "アーヤ", "text": "そういうのはよく手直し\nしてるからだと思うわ。"},
        { "location": "85/TALK"   , "narrator": "雛", "text": "なるほど…そういうこと\nだったんですね。"},
        { "location": "87/TALK"   , "narrator": "つばめ", "text": "古着かぁ…わたしも今度、\n見に行ってみようかな？"},
        { "location": "89/TALK"   , "narrator": "アーヤ", "text": "掘り出し物が見つかると\nいいわね。"},
        { "location": "91/ACT"    , "narrator": "", "text": "座布団とかのカバー"},
        { "location": "111/TALK"  , "narrator": "アーヤ", "text": "それでいくわ、ありがと！"},
        { "location": "123/TALK"  , "narrator": "アーヤ", "text": "えっと…座布団とか、\n枕とかのカバーを\n作ってるの。"},
        { "location": "125/TALK"  , "narrator": "雛", "text": "えっ…座布団や枕の\nカバー…ですか？"},
        { "location": "127/TALK"  , "narrator": "つばめ", "text": "アーヤさん、そんなに\n毎日作らなきゃいけない\nほど――"},
        { "location": "128/TALK"  , "narrator": "つばめ", "text": "たくさん座布団や枕を\n持ってるんですか？"},
        { "location": "129/TALK"  , "narrator": "アーヤ", "text": "えっ！？"},
        { "location": "133/TALK"  , "narrator": "アーヤ", "text": "そ、そうよ、どう考えても\nおかしいわ！"},
        { "location": "134/TALK"  , "narrator": "アーヤ", "text": "毎日毎日座布団や枕の\nカバーを作ってるなんて。"},
        { "location": "137/TALK"  , "narrator": "雛", "text": "変わったご趣味ですね…。"},
        { "location": "139/TALK"  , "narrator": "雛", "text": "あ、でも綾水様なら\nどんな趣味でも素敵だと\n思いますよ！"},
        { "location": "142/TALK"  , "narrator": "アーヤ", "text": "もっと考えてから\n言うべきだったわ…。"},
        { "location": "143/ACT"   , "narrator": "", "text": "パッチワーク"},
        { "location": "151/TALK"  , "narrator": "アーヤ", "text": "ごめん、ちょっと待って。"},
        { "location": "165/TALK"  , "narrator": "アーヤ", "text": "素敵！"},
        { "location": "166/TALK"  , "narrator": "アーヤ", "text": "とってもいいと思うわ"},
        { "location": "167/TALK"  , "narrator": "アーヤ", "text": "相談してよかった、ありがとヽ(*^^*)ノ"},
        { "location": "179/TALK"  , "narrator": "アーヤ", "text": "おまたせ。\nさっきの話の\n続きだけど――"},
        { "location": "180/TALK"  , "narrator": "アーヤ", "text": "実は、毎日少しずつ\nパッチワークを作って\nるの。"},
        { "location": "182/TALK"  , "narrator": "つばめ", "text": "それって、小さな布を\n縫い合わせて、一枚の\n布にするやつですよね？"},
        { "location": "183/TALK"  , "narrator": "雛", "text": "わぁ、素敵です綾水様！"},
        { "location": "184/TALK"  , "narrator": "雛", "text": "凄くオシャレで、\nすっごくかっこいいです！"},
        { "location": "185/TALK"  , "narrator": "アーヤ", "text": "そ、そう？"},
        { "location": "188/TALK"  , "narrator": "つばめ", "text": "わたしもそう思います！"},
        { "location": "189/TALK"  , "narrator": "雛", "text": "どんな作品なんだろ？\nよろしければ今度\n拝見させてください！"},
        { "location": "190/TALK"  , "narrator": "アーヤ", "text": "え、ええ…わかったわ。"},
        { "location": "193/TALK"  , "narrator": "アーヤ", "text": "本当はやったことも\nないんだけど――"},
        { "location": "194/TALK"  , "narrator": "アーヤ", "text": "でも、ちょっと楽しそう\nだし、これを機に始めて\nみようかしら？"},
        { "location": "211/ACT"   , "narrator": "", "text": "人形作りって言っちゃえ"},
        { "location": "218/TALK"  , "narrator": "アーヤ", "text": "あ、何かしら？\nメールみたいだから\nちょっと待って。"},
        { "location": "232/TALK"  , "narrator": "アーヤ", "text": "言えない！"},
        { "location": "233/TALK"  , "narrator": "アーヤ", "text": "それを隠したいから相談してるのに！"},
        { "location": "234/TALK"  , "narrator": "アーヤ", "text": "もう自分で考える"},
        { "location": "246/TALK"  , "narrator": "アーヤ", "text": "…とは言ったけど、\nなんて言おうかしら？"},
        { "location": "249/TALK"  , "narrator": "つばめ", "text": "やっぱり、自分の服とか\n作ったりしてるのかな？"},
        { "location": "251/TALK"  , "narrator": "雛", "text": "う～ん…綾水様は服より、\nインテリアになりそうな\n物を作りそうだけど…。"},
        { "location": "254/TALK"  , "narrator": "アーヤ", "text": "…もしかして、正直に\n言っても平気かも。"},
        { "location": "256/TALK"  , "narrator": "アーヤ", "text": "冗談だと思われて笑って\nおしまい、ってことに\nなってくれるんじゃ…。"},
        { "location": "257/TALK"  , "narrator": "アーヤ", "text": "…よし、言ってみよう！"},
        { "location": "259/TALK"  , "narrator": "アーヤ", "text": "私が毎日お裁縫をする\n理由は…。"},
        { "location": "263/TALK"  , "narrator": "つばめ", "text": "ワクワク！"},
        { "location": "265/TALK"  , "narrator": "アーヤ", "text": "えっと……。"},
        { "location": "267/TALK"  , "narrator": "雛", "text": "なんですかなんですか？"},
        { "location": "270/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "274/TALK"  , "narrator": "アーヤ", "text": "あっ、そろそろ講義の\n時間だから！\nそれじゃあ！"},
        { "location": "280/TALK"  , "narrator": "つばめ", "text": "あ、アーヤさん！？"},
        { "location": "286/TALK"  , "narrator": "雛", "text": "綾水様、せめてヒントを！\n気になっちゃうからー！！"},
        { "location": "303/TALK"  , "narrator": "アーヤ", "text": "ごめん、二人とも！"},
        { "location": "305/TALK"  , "narrator": "アーヤ", "text": "でも…やっぱり\n恥ずかしくて言えない！"},
        { "location": "18/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>6月29日　4:05 PM</color>\nとある平日の放課後、学園正門前にて。"},
        { "location": "205/DIALOG", "narrator": "Dialog_GEThimegoto_ch02", "text": "【はぎれならあったから】"}
    ]
}
