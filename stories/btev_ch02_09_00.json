        "title": "016 ココロスフィアストーリー【Lv06】",
        "sub_title": "チャプター９＜提起＞"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "姉妹の隔絶・後編１"},
        { "location": "14/DIALOG" , "narrator": "", "text": "<size=40>DOOR-No. 502</size>\nAYAMI - KUNIMASA\n\n<size=45>姉妹の隔絶・前編</size>\n<size=35>～その核心に関する調査～</size>"},
        { "location": "23/TALK"   , "narrator": "潜在アーヤ", "text": "ふふ。\n待ってたわよ。"},
        { "location": "24/TALK"   , "narrator": "潜在アーヤ", "text": "絶対に\n来てくれると\n思ってたわ。"},
        { "location": "25/TALK"   , "narrator": "潜在アーヤ", "text": "さあ、それじゃ今日も\n張り切って、姉と和解\n大作戦始めましょうか。"},
        { "location": "27/TALK"   , "narrator": "表層アーヤ", "text": "残念だけど、\n今回は貴方の思い通り\nにはいかないわよ？"},
        { "location": "29/TALK"   , "narrator": "潜在アーヤ", "text": "現れたわね！\n鉄仮面！"},
        { "location": "30/TALK"   , "narrator": "表層アーヤ", "text": "誰が鉄仮面よ。"},
        { "location": "31/TALK"   , "narrator": "潜在アーヤ", "text": "今回も前回に引き続き\n私の思い通りにいく\nわよ。だって私には―"},
        { "location": "32/TALK"   , "narrator": "潜在アーヤ", "text": "素敵な\n$handle$さんが\nついてるんだもの。"},
        { "location": "34/TALK"   , "narrator": "潜在アーヤ", "text": "ねー？　今回も\n私と一緒に\n頑張りましょうね。"},
        { "location": "35/TALK"   , "narrator": "表層アーヤ", "text": "毎度思うんだけど、\n私のイメージを誤解\nさせる仕草――"},
        { "location": "36/TALK"   , "narrator": "表層アーヤ", "text": "やめてもらえない\nかしら？"},
        { "location": "38/TALK"   , "narrator": "潜在アーヤ", "text": "あら、失礼ね。\n私だって貴方と同じ、\n私の一部なのよ？"},
        { "location": "39/TALK"   , "narrator": "潜在アーヤ", "text": "誤解なんかじゃなく\n正真正銘、私の潜在\n的な欲求の１つなの。"},
        { "location": "40/TALK"   , "narrator": "表層アーヤ", "text": "認めない。"},
        { "location": "41/TALK"   , "narrator": "潜在アーヤ", "text": "認めてくれなくても\nいいわよ。だって――"},
        { "location": "42/TALK"   , "narrator": "潜在アーヤ", "text": "貴方はここで\n消える運命に\nあるんだから！"}
    ]
}
