        { "location": "93/DIALOG" , "narrator": "Dialog_Black", "text": "そして姉は本当に帰って来なかった"},
        { "location": "94/DIALOG" , "narrator": "Dialog_Black", "text": "代わりに一通の手紙が届いた"},
        { "location": "95/DIALOG" , "narrator": "Dialog_Black", "text": "差出人はエヴェレット脳科学研究所。\n姉の勤務先だ"},
        { "location": "96/DIALOG" , "narrator": "Dialog_Black", "text": "その手紙には姉が実験中の事故で\n死亡したことが記されていた"},
