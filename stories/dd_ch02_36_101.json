{
    "dir": "chap36/daydra/dd_ch02_36_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "36202",
        "cid": "ayami",
        "title": "002 メインストーリー",
        "sub_title": "日常の中の約束を＜前編＞"
    },
    "entry":
    [
        { "location": "8/SCENARIO", "narrator": "", "text": "日常の中の約束を"},
        { "location": "24/TALK"   , "narrator": "高校生アーヤ", "text": "ここは…実家？"},
        { "location": "26/TALK"   , "narrator": "高校生アーヤ", "text": "あれ私、\n何してたっけ？"},
        { "location": "30/TALK"   , "narrator": "エリカ", "text": "アヤちゃーん！"},
        { "location": "32/TALK"   , "narrator": "高校生アーヤ", "text": "…何？"},
        { "location": "33/TALK"   , "narrator": "エリカ", "text": "今日暇かな？"},
        { "location": "34/TALK"   , "narrator": "高校生アーヤ", "text": "…暇だけど。\nお姉ちゃんの手伝いなら\nしないからね。"},
        { "location": "35/TALK"   , "narrator": "エリカ", "text": "違う違う。\nすっごいいいもの\n見せたくて。"},
        { "location": "36/TALK"   , "narrator": "エリカ", "text": "アヤちゃん絶対\nびっくりするよ！"},
        { "location": "37/TALK"   , "narrator": "高校生アーヤ", "text": "…どうせまた\nクモ型ロボットとか\nなんじゃないの…？"},
        { "location": "38/TALK"   , "narrator": "エリカ", "text": "あー早く見せたい！\n見せたい！"},
        { "location": "41/TALK"   , "narrator": "高校生アーヤ", "text": "…わかったわよ。"},
        { "location": "56/TALK"   , "narrator": "高校生アーヤ", "text": "何ここ？\n洞窟の中に建物？\nしかも新しい……。"},
        { "location": "58/TALK"   , "narrator": "エリカ", "text": "ねっねっ！\nびっくりしたでしょ？"},
        { "location": "59/TALK"   , "narrator": "高校生アーヤ", "text": "うん、まあ……。"},
        { "location": "60/TALK"   , "narrator": "エリカ", "text": "ここね。\nお姉ちゃんの新しい\n職場なんだ。"},
        { "location": "61/TALK"   , "narrator": "高校生アーヤ", "text": "え？"},
        { "location": "62/TALK"   , "narrator": "エリカ", "text": "うちの会社、\nエンタングルに吸収\nされたでしょ。"},
        { "location": "63/TALK"   , "narrator": "エリカ", "text": "でね、エンタングルは\n日本の会社だから日本にも\n研究所作ろうって。"},
        { "location": "64/TALK"   , "narrator": "エリカ", "text": "どうせ東京とか大阪とか\nだろうなって思ってたら\n松代になったの！"},
        { "location": "65/TALK"   , "narrator": "エリカ", "text": "ここだと家から通えるし\nアヤちゃんも\n嬉しいでしょ？"},
        { "location": "66/TALK"   , "narrator": "高校生アーヤ", "text": "………別に。\n嬉しくないから。"},
        { "location": "68/TALK"   , "narrator": "エリカ", "text": "えー。\nそっかー。\n残念……。"},
        { "location": "69/TALK"   , "narrator": "エリカ", "text": "お姉ちゃんはすっごく\n嬉しかったのにな……。"},
        { "location": "71/TALK"   , "narrator": "高校生アーヤ", "text": "もう少し優しく\n言えばよかったかな…。"},
        { "location": "72/TALK"   , "narrator": "高校生アーヤ", "text": "いつからこっちに来るの？"},
        { "location": "74/TALK"   , "narrator": "エリカ", "text": "一ヶ月後くらいかな。\nまだフランスでの\n仕事が残ってるから。"},
        { "location": "75/TALK"   , "narrator": "エリカ", "text": "その片付けして、\nまとめてそれで晴れて\n松代ラボに移動！"},
        { "location": "76/TALK"   , "narrator": "エリカ", "text": "アヤちゃんは\n待ちきれないだろうけど\nもう少し待っててね。"},
        { "location": "78/TALK"   , "narrator": "高校生アーヤ", "text": "別に気を遣うこと\nなかったみたい。"},
        { "location": "79/TALK"   , "narrator": "高校生アーヤ", "text": "別に帰ってこなくて\nいいから。"},
        { "location": "80/TALK"   , "narrator": "エリカ", "text": "あーもー。\nアヤちゃんって\nいつもそう。"},
        { "location": "81/TALK"   , "narrator": "エリカ", "text": "そんな言い方したら\nお姉ちゃん帰ってくるの\nやめちゃうかもよ？"},
        { "location": "83/TALK"   , "narrator": "高校生アーヤ", "text": "いいわよそれで。"},
        { "location": "84/TALK"   , "narrator": "エリカ", "text": "冷たいなー。\nお姉ちゃん嘘泣き\nしちゃおっかなー。"},
        { "location": "86/TALK"   , "narrator": "エリカ", "text": "くすんくすん。"},
        { "location": "88/TALK"   , "narrator": "高校生アーヤ", "text": "わざとらしすぎるから！"},
        { "location": "104/TALK"  , "narrator": "職員Ａ", "text": "國政博士には色々と\n助けられました。\n本当に。"},
        { "location": "105/TALK"  , "narrator": "高校生アーヤ", "text": "…そんなお姉ちゃん、\nお姉ちゃん\nなんかじゃない。"},
        { "location": "106/TALK"  , "narrator": "高校生アーヤ", "text": "だから死んだのは\n別の人。"},
        { "location": "107/TALK"  , "narrator": "高校生アーヤ", "text": "嘘はいいから\n早く帰ってよ。"},
        { "location": "108/TALK"  , "narrator": "高校生アーヤ", "text": "そうしないと\nお姉ちゃんが帰って\n来れないじゃない。"},
        { "location": "109/SEL"   , "narrator": "", "text": "ちょっと待って！"},
        { "location": "110/ACT"   , "narrator": "", "text": "ちょっと待って！"},
        { "location": "113/TALK"  , "narrator": "高校生アーヤ", "text": "何？"},
        { "location": "114/SEL"   , "narrator": "", "text": "この状況ってさ"},
        { "location": "115/SEL"   , "narrator": "", "text": "何っていうか…"},
        { "location": "116/SEL"   , "narrator": "", "text": "これって本当なの？"},
        { "location": "117/ACT"   , "narrator": "", "text": "この状況ってさ"},
        { "location": "118/TALK"  , "narrator": "高校生アーヤ", "text": "知らない人が\n客間にいるのよ。"},
        { "location": "119/ACT"   , "narrator": "", "text": "何っていうか…"},
        { "location": "120/TALK"  , "narrator": "高校生アーヤ", "text": "ハッキリしない人ね。"},
        { "location": "121/ACT"   , "narrator": "", "text": "これって本当なの？"},
        { "location": "122/TALK"  , "narrator": "高校生アーヤ", "text": "本当なんじゃないの？"},
        { "location": "124/TALK"  , "narrator": "高校生アーヤ", "text": "今、あんまり話したく\nないの。"},
        { "location": "125/TALK"  , "narrator": "高校生アーヤ", "text": "だから手短に言って。"},
        { "location": "126/SEL"   , "narrator": "", "text": "エリカって死んだの？"},
        { "location": "127/SEL"   , "narrator": "", "text": "國政博士事故死って"},
        { "location": "128/SEL"   , "narrator": "", "text": "アーヤのお姉さん死亡？"},
        { "location": "129/ACT"   , "narrator": "", "text": "エリカって死んだの？"},
        { "location": "130/TALK"  , "narrator": "高校生アーヤ", "text": "うるさい。"},
        { "location": "131/ACT"   , "narrator": "", "text": "國政博士事故死って"},
        { "location": "132/TALK"  , "narrator": "高校生アーヤ", "text": "手紙が来たわ。"},
        { "location": "133/ACT"   , "narrator": "", "text": "アーヤのお姉さん死亡？"},
        { "location": "134/TALK"  , "narrator": "高校生アーヤ", "text": "そういうことみたい。"},
        { "location": "136/TALK"  , "narrator": "高校生アーヤ", "text": "聞きたいことは\nそれだけ？\nじゃあね。"},
        { "location": "137/SEL"   , "narrator": "", "text": "えーと"},
        { "location": "138/ACT"   , "narrator": "", "text": "えーと"},
        { "location": "140/TALK"  , "narrator": "高校生アーヤ", "text": "まだあるの！？"},
        { "location": "141/SEL"   , "narrator": "", "text": "アーヤ辛いよね"},
        { "location": "142/SEL"   , "narrator": "", "text": "ご冥福をお祈りします"},
        { "location": "143/SEL"   , "narrator": "", "text": "泣いてもいいと思うよ"},
        { "location": "144/ACT"   , "narrator": "", "text": "アーヤ辛いよね"},
        { "location": "145/TALK"  , "narrator": "高校生アーヤ", "text": "…………。"},
        { "location": "146/ACT"   , "narrator": "", "text": "ご冥福をお祈りします"},
        { "location": "147/TALK"  , "narrator": "高校生アーヤ", "text": "そんなこと\nしなくても……。"},
        { "location": "148/ACT"   , "narrator": "", "text": "泣いてもいいと思うよ"},
        { "location": "149/TALK"  , "narrator": "高校生アーヤ", "text": "それはいや。\n絶対に。"},
        { "location": "151/TALK"  , "narrator": "高校生アーヤ", "text": "あの人は。"},
        { "location": "152/TALK"  , "narrator": "高校生アーヤ", "text": "姉はいつでも勝手に\nいなくなる。"},
        { "location": "153/TALK"  , "narrator": "高校生アーヤ", "text": "いつだってそう。"},
        { "location": "154/TALK"  , "narrator": "高校生アーヤ", "text": "フランスに行く時も\nそうだった。"},
        { "location": "156/TALK"  , "narrator": "高校生アーヤ", "text": "でも今回のが\n一番ひどい。"},
        { "location": "157/SEL"   , "narrator": "", "text": "好きだったんだもんね"},
        { "location": "158/SEL"   , "narrator": "", "text": "帰ってくるって言ってたのにね"},
        { "location": "159/SEL"   , "narrator": "", "text": "姉って本当に勝手だよね！"},
        { "location": "160/ACT"   , "narrator": "", "text": "好きだったんだもんね"},
        { "location": "162/TALK"  , "narrator": "高校生アーヤ", "text": "……好きじゃない。"},
        { "location": "163/TALK"  , "narrator": "高校生アーヤ", "text": "むしろ嫌い。\nだいきらい。"},
        { "location": "164/ACT"   , "narrator": "", "text": "帰ってくるって言ってたのにね"},
        { "location": "167/TALK"  , "narrator": "高校生アーヤ", "text": "いつもそう。"},
        { "location": "168/TALK"  , "narrator": "高校生アーヤ", "text": "できない約束なんて\nしなきゃいいのに。"},
        { "location": "169/ACT"   , "narrator": "", "text": "姉って本当に勝手だよね！"},
        { "location": "171/TALK"  , "narrator": "高校生アーヤ", "text": "本当よ。\nそのせいでいつも妹が\n割を食う。"},
        { "location": "172/TALK"  , "narrator": "高校生アーヤ", "text": "勝手すぎるわよ。"},
        { "location": "174/TALK"  , "narrator": "高校生アーヤ", "text": "お姉ちゃんのバカ。\n変な研究なんて\nしなきゃよかったのに。"},
        { "location": "176/TALK"  , "narrator": "高校生アーヤ", "text": "エヴェレット\n脳科学研究所なんて\n入らなきゃよかったのに。"},
        { "location": "214/TALK"  , "narrator": "水鏡の神子", "text": "さて。"},
        { "location": "216/TALK"  , "narrator": "水鏡の神子", "text": "$handle$さんは、\n私のフェノメノン発症を\n望んでるようですが。"},
        { "location": "217/TALK"  , "narrator": "水鏡の神子", "text": "それはすなわち、客観的な\n世界としての存在が、\nそれを是としていること。"},
        { "location": "218/TALK"  , "narrator": "水鏡の神子", "text": "貴方たち2人が共に\n疑問を抱いていたとしても\n私は実行せねばならない。"},
        { "location": "219/TALK"  , "narrator": "エヴェレット　", "text": "世界が是としていても、\n私たちは非としている。"},
        { "location": "220/TALK"  , "narrator": "白烏", "text": "私は世界である前に、\n國政綾水という個でも\nありますよ。"},
        { "location": "222/TALK"  , "narrator": "水鏡の神子", "text": "種の件については、\n思うところはあれど\nひとまず置いておきます。"},
        { "location": "223/TALK"  , "narrator": "水鏡の神子", "text": "まずは、エヴェレットの\n言う“矛盾”について、\n議論しましょう。"},
        { "location": "224/TALK"  , "narrator": "エヴェレット　", "text": "貴方は、國政綾水という\n個体の想いを体現する\n存在なんです。"},
        { "location": "226/TALK"  , "narrator": "白烏", "text": "その個である総意の大半が\n発症を非としているのに、\n貴方だけが推進している。"},
        { "location": "227/TALK"  , "narrator": "エヴェレット　", "text": "そこに、“私”としての\n疑問を抱かずには\nいられないんです。"},
        { "location": "228/TALK"  , "narrator": "水鏡の神子", "text": "天使としての契約をした\nからには、私を省みず\n公に徹するべきです。"},
        { "location": "229/TALK"  , "narrator": "水鏡の神子", "text": "それこそが、\n天使としての責務。"},
        { "location": "235/SEL"   , "narrator": "", "text": "その通り"},
        { "location": "236/SEL"   , "narrator": "", "text": "ところで天使になるって決めたのはいつからなの？"},
        { "location": "237/ACT"   , "narrator": "", "text": "その通り"},
        { "location": "238/ACT"   , "narrator": "", "text": "ところで天使になるって決めたのはいつからなの？"},
        { "location": "240/TALK"  , "narrator": "水鏡の神子", "text": "潜在的には、姉の訃報を\n受けてからです。"},
        { "location": "241/TALK"  , "narrator": "水鏡の神子", "text": "もちろん、その時にはまだ\n今回の任務などは\n知りませんでしたが。"},
        { "location": "243/TALK"  , "narrator": "エヴェレット　", "text": "え……\nなにその訃報って……"},
        { "location": "244/TALK"  , "narrator": "白烏", "text": "そうだったのね。\n全然知らなかった。"},
        { "location": "248/TALK"  , "narrator": "エヴェレット　", "text": "いやちょっとまって！\n訃報って何！？"},
        { "location": "252/TALK"  , "narrator": "白烏", "text": "現実では姉は\n死んだことになってる。"},
        { "location": "253/TALK"  , "narrator": "エヴェレット　", "text": "嘘よ！！"},
        { "location": "254/TALK"  , "narrator": "白烏", "text": "ホントだってば。\nでも実際には\n死んではいないけど。"},
        { "location": "255/TALK"  , "narrator": "エヴェレット　", "text": "どういうこと？\n全然わからない！"},
        { "location": "256/TALK"  , "narrator": "白烏", "text": "言葉の通り。\n消息は不明。\n勤務先から訃報を受ける。"},
        { "location": "257/TALK"  , "narrator": "白烏", "text": "けど――"},
        { "location": "258/TALK"  , "narrator": "白烏", "text": "逢瀬つばめのフェノメノン\nの中では、何度も連絡を\nしてきている。"},
        { "location": "259/TALK"  , "narrator": "白烏", "text": "だから、少なくとも\n死んではいないと、\n1xの私は踏んでいる。"},
        { "location": "260/TALK"  , "narrator": "エヴェレット　", "text": "そんな……\n全然知らないわよ、\nそんな話！！"},
        { "location": "261/TALK"  , "narrator": "水鏡の神子", "text": "そうでしょうね。"},
        { "location": "262/TALK"  , "narrator": "水鏡の神子", "text": "この記憶は、逢瀬つばめの\nフェノメノンによって\n完全に消されています。"},
        { "location": "263/SEL"   , "narrator": "", "text": "なんで消されたの？"},
        { "location": "264/ACT"   , "narrator": "", "text": "なんで消されたの？"},
        { "location": "266/TALK"  , "narrator": "水鏡の神子", "text": "それは\n私の知るところでは\nありません。"},
        { "location": "267/TALK"  , "narrator": "水鏡の神子", "text": "……。"},
        { "location": "272/TALK"  , "narrator": "水鏡の神子", "text": "さて、\n話を元に戻しますが――"},
        { "location": "273/TALK"  , "narrator": "水鏡の神子", "text": "敢えてここでは、\n“消失”と言いましょう。"},
        { "location": "274/TALK"  , "narrator": "水鏡の神子", "text": "私はこの計画への参加で、\n姉の消失の原因を知る事が\nできると判断しました。"},
        { "location": "275/TALK"  , "narrator": "水鏡の神子", "text": "天使という契約。\nこれはエンタングルによる\nフェノム計画――"},
        { "location": "276/TALK"  , "narrator": "水鏡の神子", "text": "すなわち、世界救済計画に\nよって締結されている\nものです。"},
        { "location": "277/TALK"  , "narrator": "水鏡の神子", "text": "契約当初は単に、内部に\n入り、姉の消失の全貌を\n暴こうとしたまでです。"},
        { "location": "278/TALK"  , "narrator": "水鏡の神子", "text": "しかしその後、千羽鶴\nからのコンタクトがあり、\n1xの契約をしました。"},
        { "location": "279/SEL"   , "narrator": "", "text": "それって最初の契約に対する裏切りでは？"},
        { "location": "280/ACT"   , "narrator": "", "text": "それって最初の契約に対する裏切りでは？"},
        { "location": "282/TALK"  , "narrator": "水鏡の神子", "text": "そうかもしれませんね。"},
        { "location": "283/TALK"  , "narrator": "水鏡の神子", "text": "千羽鶴は、彼らとの契約に\n対する法務上の違反は\n無いと言ってましたが――"},
        { "location": "284/TALK"  , "narrator": "水鏡の神子", "text": "私は不義理ではあると\n思っています。"},
        { "location": "285/TALK"  , "narrator": "水鏡の神子", "text": "ですが、内観しつつ\n出した結論としては、\n現状の通りです。"},
        { "location": "286/TALK"  , "narrator": "水鏡の神子", "text": "その理由は、少なくとも\n“彼ら”は、姉のことに\nついて嘘をついている。"},
        { "location": "287/TALK"  , "narrator": "水鏡の神子", "text": "千羽鶴は実際に、\n生きている姉と現時点で\n交流しているからです。"},
        { "location": "288/TALK"  , "narrator": "水鏡の神子", "text": "私は、より正確に\n姉の真実を確認したいと\n考えています。"},
        { "location": "289/TALK"  , "narrator": "水鏡の神子", "text": "ですから、常にその判断は\n真実に近づくことが\n出来るか否かなのです。"},
        { "location": "290/SEL"   , "narrator": "", "text": "そうか、だから水鏡の神子なのか"},
        { "location": "291/SEL"   , "narrator": "", "text": "それほどまでに姉のことが好きだったんだね"},
        { "location": "292/ACT"   , "narrator": "", "text": "そうか、だから水鏡の神子なのか"},
        { "location": "295/TALK"  , "narrator": "エヴェレット　", "text": "どういうこと？"},
        { "location": "297/TALK"  , "narrator": "白烏", "text": "水鏡。"},
        { "location": "298/TALK"  , "narrator": "白烏", "text": "水がありのままに物事を\n映すように、無心に観察し\n真実を探求すること――"},
        { "location": "299/TALK"  , "narrator": "白烏", "text": "それを第一義として\n存在しているということ。"},
        { "location": "300/TALK"  , "narrator": "エヴェレット　", "text": "そんな！\nそれが第一義なら、\n私という存在は！？"},
        { "location": "305/TALK"  , "narrator": "水鏡の神子", "text": "もちろん、\n真実の世界あっての私。"},
        { "location": "306/TALK"  , "narrator": "水鏡の神子", "text": "うつつが在り、\nそして私が\n存在するのですよ。"},
        { "location": "307/SEL"   , "narrator": "", "text": "やっぱりアーヤの本質はそこなんだね"},
        { "location": "308/ACT"   , "narrator": "", "text": "やっぱりアーヤの本質はそこなんだね"},
        { "location": "312/TALK"  , "narrator": "白烏", "text": "良く言えば無私の奉仕。\n悪く言えば、確固たる\n己の信念がない状態。"},
        { "location": "313/TALK"  , "narrator": "水鏡の神子", "text": "善し悪しは\nここで議論するものでは\nありませんよ。"},
        { "location": "314/ACT"   , "narrator": "", "text": "それほどまでに姉のことが好きだったんだね"},
        { "location": "319/TALK"  , "narrator": "エヴェレット　", "text": "え？　まさか！"},
        { "location": "320/TALK"  , "narrator": "水鏡の神子", "text": "そうですね。\n私は姉のことは、\n内心とても慕っています。"},
        { "location": "323/TALK"  , "narrator": "エヴェレット　", "text": "ええっ！？\nそうなの！？"},
        { "location": "325/TALK"  , "narrator": "白烏", "text": "ああ、そうか。\n0xでは、核心部分が\n伏せられていたから――"},
        { "location": "326/TALK"  , "narrator": "白烏", "text": "姉が嫌いであるという\n感覚が、私という存在の\n“設定”になってた。"},
        { "location": "327/TALK"  , "narrator": "白烏", "text": "いろんな理由を探しては、\nそれが嫌いである理由だと\n思い込んで。"},
        { "location": "328/TALK"  , "narrator": "白烏", "text": "そんな理由で、どうして\n姉が嫌いなのかという\n矛盾も全て見て見ぬフリ。"},
        { "location": "329/TALK"  , "narrator": "白烏", "text": "不自然に感情が高ぶるのも\n全部気のせいにして、\n納得していたのね。"},
        { "location": "331/TALK"  , "narrator": "エヴェレット　", "text": "そんな……"},
        { "location": "333/TALK"  , "narrator": "エヴェレット　", "text": "そんなこと……"},
        { "location": "334/TALK"  , "narrator": "水鏡の神子", "text": "0xは半分作られた人生。\nそういったこともまた\nあるかとは思います。"},
        { "location": "339/TALK"  , "narrator": "水鏡の神子", "text": "さて、そろそろ\n結論を出す時間に\nしましょう。"},
        { "location": "340/TALK"  , "narrator": "水鏡の神子", "text": "國政綾水はこれから\n天使となります。"},
        { "location": "341/TALK"  , "narrator": "水鏡の神子", "text": "その事に対して、\nあなた方の考えは。"},
        { "location": "343/TALK"  , "narrator": "エヴェレット　", "text": "……。"},
        { "location": "345/TALK"  , "narrator": "エヴェレット　", "text": "やっぱり私は\n賛同できない。"},
        { "location": "356/TALK"  , "narrator": "エヴェレット　", "text": "$handle$さん。\n今からでは、考えも\n変わらないでしょうけど―"},
        { "location": "357/TALK"  , "narrator": "エヴェレット　", "text": "私はやっぱり、\nフェノメノンの発症には\n反対です。"},
        { "location": "358/TALK"  , "narrator": "エヴェレット　", "text": "だから私は、その想いを\n込めて、水鏡の神子を\n抑えるべく戦います。"},
        { "location": "361/TALK"  , "narrator": "白烏", "text": "私は$handle$さんを\n信じてるから、\n貴方の意向に協力する。"},
        { "location": "362/TALK"  , "narrator": "白烏", "text": "$handle$さんは？"},
        { "location": "363/SEL"   , "narrator": "", "text": "フェノメノンになって千羽鶴に協力して欲しい"},
        { "location": "364/SEL"   , "narrator": "", "text": "話聞いてて、阻止した方がいいかもと思った"},
        { "location": "365/ACT"   , "narrator": "", "text": "フェノメノンになって千羽鶴に協力して欲しい"},
        { "location": "367/TALK"  , "narrator": "エヴェレット　", "text": "そう…。\n考えは変わらないのね。"},
        { "location": "370/TALK"  , "narrator": "白烏", "text": "そういうことみたいね。"},
        { "location": "371/TALK"  , "narrator": "水鏡の神子", "text": "ご協力感謝いたします。"},
        { "location": "372/TALK"  , "narrator": "水鏡の神子", "text": "それでは、志を同じくする\n者として、より一層の\n高みへと昇華するため――"},
        { "location": "373/TALK"  , "narrator": "水鏡の神子", "text": "ご助力\nお願い申し上げます！"},
        { "location": "374/ACT"   , "narrator": "", "text": "話聞いてて、阻止した方がいいかもと思った"},
        { "location": "376/TALK"  , "narrator": "白烏", "text": "あらら、そうなのね。\nまあいいわ、それなら\n私もそっちを支持する。"},
        { "location": "377/TALK"  , "narrator": "エヴェレット　", "text": "ほんと！？\nそう思ってくれるの！？"},
        { "location": "378/TALK"  , "narrator": "水鏡の神子", "text": "よいでしょう。"},
        { "location": "379/TALK"  , "narrator": "水鏡の神子", "text": "ならば私との\nぶつかり合いによる\n勝負になりますね。"},
        { "location": "380/TALK"  , "narrator": "水鏡の神子", "text": "お互い、\n自らの信念を賭けて\n戦おうではありませんか！"},
        { "location": "385/TALK"  , "narrator": "エヴェレット　", "text": "$handle$さん。\n今でも私と同じで、発症\n阻止に協力してくれる？"},
        { "location": "386/SEL"   , "narrator": "", "text": "もちろん。発症なんてさせない"},
        { "location": "387/SEL"   , "narrator": "", "text": "話聞いてて、発症した方がいいかもと思った"},
        { "location": "388/ACT"   , "narrator": "", "text": "もちろん。発症なんてさせない"},
        { "location": "390/TALK"  , "narrator": "エヴェレット　", "text": "ありがとう。\nそれじゃ、\n共に闘いましょ。"},
        { "location": "393/TALK"  , "narrator": "白烏", "text": "私も$handle$さんを\n信じてるから、\n貴方の意向に協力する。"},
        { "location": "394/TALK"  , "narrator": "水鏡の神子", "text": "よいでしょう。"},
        { "location": "395/TALK"  , "narrator": "水鏡の神子", "text": "試しに……と思い、\n議論をしてみましたが、\n変わりませんでしたか。"},
        { "location": "396/TALK"  , "narrator": "水鏡の神子", "text": "種を奪ったのが\n$handle$さんなら\n逆もまた然り。"},
        { "location": "397/TALK"  , "narrator": "水鏡の神子", "text": "貴方のココロが変われば\n種は戻ると考えました。"},
        { "location": "398/TALK"  , "narrator": "水鏡の神子", "text": "しかし\n考えは変わらなかった。"},
        { "location": "399/TALK"  , "narrator": "水鏡の神子", "text": "ならば私との\nぶつかり合いによる\n勝負になりますね。"},
        { "location": "400/TALK"  , "narrator": "水鏡の神子", "text": "貴方をこの私の中から\n排除すれば、\n奪われた種も戻るはず。"},
        { "location": "401/TALK"  , "narrator": "水鏡の神子", "text": "お互い、\n自らの信念を賭けて\n戦おうではありませんか！"},
        { "location": "402/ACT"   , "narrator": "", "text": "話聞いてて、発症した方がいいかもと思った"},
        { "location": "404/TALK"  , "narrator": "エヴェレット　", "text": "ええっ！？\nどういうこと？？"},
        { "location": "407/TALK"  , "narrator": "白烏", "text": "まあ、色々考えが\nあってのことだと\n思うわよ？"},
        { "location": "410/TALK"  , "narrator": "白烏", "text": "私は$handle$さんを\n信じてるから、\n貴方の意向に協力する。"},
        { "location": "411/TALK"  , "narrator": "水鏡の神子", "text": "ご協力感謝いたします。"},
        { "location": "412/TALK"  , "narrator": "水鏡の神子", "text": "貴方の心意気は、\n白烏が受け取りましたよ。"},
        { "location": "413/TALK"  , "narrator": "白烏", "text": "え？\nどういう――"},
        { "location": "414/TALK"  , "narrator": "白烏", "text": "…っ！？\n種が戻ってる！？"},
        { "location": "415/TALK"  , "narrator": "水鏡の神子", "text": "種を奪ったのが\n$handle$さんなら\n逆もまた然り。"},
        { "location": "416/TALK"  , "narrator": "水鏡の神子", "text": "貴方のココロが変われば\n種は戻ると考えました。"},
        { "location": "417/TALK"  , "narrator": "水鏡の神子", "text": "色々と議論し、\n私の想いを伝えた甲斐が\nあったというもの。"},
        { "location": "418/TALK"  , "narrator": "水鏡の神子", "text": "それでは、志を同じくする\n者として、より一層の\n高みへと昇華するため――"},
        { "location": "419/TALK"  , "narrator": "水鏡の神子", "text": "ご助力\nお願い申し上げます！"},
