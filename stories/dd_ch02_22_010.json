{
    "dir": "chap22/daydra/dd_ch02_22_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "22252",
        "cid": "ayami",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "人形の間での一夜"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "人形の間での一夜"},
        { "location": "19/TALK"   , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "22/TALK"   , "narrator": "アーヤ", "text": "大丈夫、ギャヴィ？"},
        { "location": "25/TALK"   , "narrator": "ガブリエラ", "text": "あたしは平気よ…。\n大丈夫じゃないのは、\nアーヤの方でしょ？"},
        { "location": "26/TALK"   , "narrator": "ガブリエラ", "text": "…やっぱり、怖いよね？"},
        { "location": "29/TALK"   , "narrator": "アーヤ", "text": "…………。"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "…ごめん。\nあたしのせいで、\nこんなことになって…。"},
        { "location": "35/TALK"   , "narrator": "アーヤ", "text": "…いいのよ。"},
        { "location": "36/TALK"   , "narrator": "アーヤ", "text": "私だって、まさかここまで\n大事になるとは、思いも\nしなかったし…。"},
        { "location": "39/TALK"   , "narrator": "ガブリエラ", "text": "…あの話、本当かな？"},
        { "location": "42/TALK"   , "narrator": "アーヤ", "text": "…………。"},
        { "location": "54/TALK"   , "narrator": "ガブリエラ", "text": "…島流し？"},
        { "location": "56/TALK"   , "narrator": "みやび", "text": "そうや。"},
        { "location": "57/TALK"   , "narrator": "みやび", "text": "この土地にはな、\n昔から島流しっちゅう\n神隠しを起こす――"},
        { "location": "58/TALK"   , "narrator": "みやび", "text": "恐ろしい悪霊が\nおったがよ。"},
        { "location": "60/TALK"   , "narrator": "みやび", "text": "そいつはこの土地に住む\n人たちを、大勢攫って\n消してしもうたんや。"},
        { "location": "61/TALK"   , "narrator": "アーヤ", "text": "そ、その悪霊が、\nあの部屋に閉じ込めて\nあった、っていうの！？"},
        { "location": "63/TALK"   , "narrator": "ガブリエラ", "text": "まさか…幽霊なんて\n存在するはず――。"},
        { "location": "65/TALK"   , "narrator": "みやび", "text": "あの部屋に入ってから、\n何かおかしなことが\n起きてないが？"},
        { "location": "66/TALK"   , "narrator": "みやび", "text": "例えば…手紙の入った\nボトルを拾ったりとか…。"},
        { "location": "68/TALK"   , "narrator": "ガブリエラ", "text": "っ！？"},
        { "location": "70/TALK"   , "narrator": "みやび", "text": "寝ちゅう間に、身体に\n手形みたいな痣が\n出来てたりとか…。"},
        { "location": "71/TALK"   , "narrator": "アーヤ", "text": "ひっ！？"},
        { "location": "74/TALK"   , "narrator": "みやび", "text": "…非常に不味い事態や。\n真面目な話、一刻を争う\n事態や。"},
        { "location": "77/TALK"   , "narrator": "みやび", "text": "二人には、今日はあの\n部屋で一夜を明かして\nもらうぞ。"},
        { "location": "79/TALK"   , "narrator": "アーヤ", "text": "えぇっ！？\nど、どうして！？"},
        { "location": "81/TALK"   , "narrator": "みやび", "text": "あの部屋の封印解いたんは\nアーヤ達やろ！？"},
        { "location": "82/TALK"   , "narrator": "みやび", "text": "それに、悪霊に狙われ\nちゅうんもアーヤ達や。"},
        { "location": "83/TALK"   , "narrator": "みやび", "text": "なら、二人が囮になれば\nあの悪霊はもう一度あの\n部屋に戻ってくる。"},
        { "location": "84/TALK"   , "narrator": "みやび", "text": "そうすれば、もう一度\nあの部屋に封印することが\nできるちや。"},
        { "location": "85/TALK"   , "narrator": "ガブリエラ", "text": "はぁ！？\nあたし達に囮になれって\nいうの！？"},
        { "location": "87/TALK"   , "narrator": "みやび", "text": "奴をもう一度封印する\n方法も――"},
        { "location": "88/TALK"   , "narrator": "みやび", "text": "二人を助ける方法も、\nもうそれしかない。"},
        { "location": "92/TALK"   , "narrator": "みやび", "text": "…だから、あれほど\n入るな言うたのに…。"},
        { "location": "93/TALK"   , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "106/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "109/TALK"  , "narrator": "アーヤ", "text": "大丈夫？"},
        { "location": "113/TALK"  , "narrator": "ガブリエラ", "text": "う、うん…なんだか、\n人形たちに見られてる\n気がして来て…。"},
        { "location": "114/TALK"  , "narrator": "アーヤ", "text": "ほら、こっちおいで。"},
        { "location": "117/TALK"  , "narrator": "ガブリエラ", "text": "あっ…。"},
        { "location": "125/TALK"  , "narrator": "アーヤ", "text": "くっついてれば、\n怖くないでしょ？"},
        { "location": "128/TALK"  , "narrator": "ガブリエラ", "text": "な、なによ。\nアーヤの方が\n怖がりのクセに…。"},
        { "location": "129/TALK"  , "narrator": "アーヤ", "text": "ふふっ…そうね…。"},
        { "location": "130/TALK"  , "narrator": "アーヤ", "text": "けど…ギャヴィのことは\n護るから…安心して。"},
        { "location": "134/TALK"  , "narrator": "ガブリエラ", "text": "っ！？"},
        { "location": "137/TALK"  , "narrator": "ガブリエラ", "text": "…アーヤって、こんなに\n凛々しかったっけ？"},
        { "location": "148/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "149/TALK"  , "narrator": "みやび", "text": "二人とも、大人しく\n部屋にいるようやな。"},
        { "location": "161/TALK"  , "narrator": "みやび", "text": "相棒、アーヤ達を驚かす手伝いをしてもらえるか？"},
        { "location": "163/SEL"   , "narrator": "", "text": "驚かす？"},
        { "location": "164/ACT"   , "narrator": "", "text": "驚かす？"},
        { "location": "166/TALK"  , "narrator": "みやび", "text": "そうや"},
        { "location": "167/TALK"  , "narrator": "みやび", "text": "あの二人な、うちが入るな言うた部屋に入ったんよ"},
        { "location": "168/TALK"  , "narrator": "みやび", "text": "やき、ちっくとお仕置きが必要思うてな"},
        { "location": "169/TALK"  , "narrator": "みやび", "text": "相棒には悪霊のフリして、アーヤ達に話しかけてほしいがよ"},
        { "location": "172/SEL"   , "narrator": "", "text": "島流しをする悪霊は？"},
        { "location": "173/ACT"   , "narrator": "", "text": "島流しをする悪霊は？"},
        { "location": "175/TALK"  , "narrator": "みやび", "text": "んなもんいるわけないちや"},
        { "location": "176/TALK"  , "narrator": "みやび", "text": "さあ、頼んだぞ"},
        { "location": "200/TALK"  , "narrator": "ガブリエラ", "text": "そっか…アーヤの実家って\n神社だったんだ…。"},
        { "location": "203/TALK"  , "narrator": "アーヤ", "text": "うん…だから、実際に\nお祓いをするところを\n何度も見ていて――"},
        { "location": "204/TALK"  , "narrator": "アーヤ", "text": "そういう恐ろしい物が\n本当に存在する、って\nいうのを――"},
        { "location": "205/TALK"  , "narrator": "アーヤ", "text": "子供の頃から何度も\n見ているの。"},
        { "location": "208/TALK"  , "narrator": "ガブリエラ", "text": "…ようやくわかった。\nアーヤが人並み以上に、\nオカルト嫌いな理由が。"},
        { "location": "211/TALK"  , "narrator": "ガブリエラ", "text": "…本当、ごめん。\nそんなこととは\n知らなくて、あたし…。"},
        { "location": "214/TALK"  , "narrator": "アーヤ", "text": "ううん、私だって\n悪かったのよ。"},
        { "location": "215/TALK"  , "narrator": "アーヤ", "text": "ギャヴィが幽霊とか、\nオカルトを信じてないの\n知ってるのに――"},
        { "location": "216/TALK"  , "narrator": "アーヤ", "text": "まともに説明もしないで、\nダメとか言っても――"},
        { "location": "218/TALK"  , "narrator": "アーヤ", "text": "そんなの、説得力ないし\n聞いてもらえるわけ\nないもの。"},
        { "location": "220/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "222/TALK"  , "narrator": "アーヤ", "text": "古い家なら、どこでも\nこういう曰く付きの\n部屋や――"},
        { "location": "223/TALK"  , "narrator": "アーヤ", "text": "物がある、ってわけじゃ\nないの。"},
        { "location": "224/TALK"  , "narrator": "アーヤ", "text": "けど、あるところには、\n確かに存在する。"},
        { "location": "225/TALK"  , "narrator": "アーヤ", "text": "その中にも、噂だけで\n実際は何でもないところの\n方が多いと思うけど――"},
        { "location": "226/TALK"  , "narrator": "アーヤ", "text": "噂じゃなくて、\n本当に超常的な何かが\n存在する場合もある。"},
        { "location": "228/TALK"  , "narrator": "アーヤ", "text": "…少なくとも、\nこれくらいの説明は\nしておくべきだったわ。"},
        { "location": "230/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "232/TALK"  , "narrator": "ガブリエラ", "text": "何か、起きるのかな？"},
        { "location": "235/TALK"  , "narrator": "アーヤ", "text": "…起きなければいいん\nだけど…わからないわ。"},
        { "location": "236/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "237/SEL"   , "narrator": "", "text": "ミ　ツ　ケ　タ"},
        { "location": "238/SEL"   , "narrator": "", "text": "$me$だよー、驚いた？"},
        { "location": "239/ACT"   , "narrator": "", "text": "ミ　ツ　ケ　タ"},
        { "location": "247/TALK"  , "narrator": "アーヤ", "text": "っ！？\n何かしら…。"},
        { "location": "261/TALK"  , "narrator": "アーヤ", "text": "は？　何これ！"},
        { "location": "262/TALK"  , "narrator": "アーヤ", "text": "今はイタズラはやめて！"},
        { "location": "264/SEL"   , "narrator": "", "text": "ソノ女ヲ頂ク"},
        { "location": "265/ACT"   , "narrator": "", "text": "ソノ女ヲ頂ク"},
        { "location": "267/TALK"  , "narrator": "アーヤ", "text": "あなた…まさか、Ｂｏｔじゃないの？"},
        { "location": "270/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "272/TALK"  , "narrator": "ガブリエラ", "text": "アーヤ…それ送ってきたの\nって、まさか…。"},
        { "location": "273/TALK"  , "narrator": "アーヤ", "text": "…ソノ女ヲ頂ク…\nその女って！"},
        { "location": "276/TALK"  , "narrator": "アーヤ", "text": "ギャヴィ！！"},
        { "location": "279/TALK"  , "narrator": "ガブリエラ", "text": "きゃっ！？\nちょ、苦しいって！"},
        { "location": "283/TALK"  , "narrator": "アーヤ", "text": "渡さない！"},
        { "location": "285/TALK"  , "narrator": "アーヤ", "text": "この子は、\n絶対に渡さないわ！"},
        { "location": "286/TALK"  , "narrator": "ガブリエラ", "text": "アーヤ…。"},
        { "location": "289/TALK"  , "narrator": "アーヤ", "text": "大丈夫よ、ギャヴィ。\nこうしてしっかり\n抱きしめてるから…。"},
        { "location": "291/TALK"  , "narrator": "アーヤ", "text": "ギャヴィ…あなたは、\n私が護ってみせるから。"},
        { "location": "294/TALK"  , "narrator": "アーヤ", "text": "連れてくなら、\n私を連れて行きなさい！"},
        { "location": "295/TALK"  , "narrator": "ガブリエラ", "text": "な、何言ってるの！？\n狙われてるのはあたし\nなんだから！"},
        { "location": "297/TALK"  , "narrator": "アーヤ", "text": "だから護るの！\nギャヴィはどこにも\n連れて行かせないわ。"},
        { "location": "298/TALK"  , "narrator": "ガブリエラ", "text": "バカ！！\nあたしより、ずっと\n怖がりのクセに！！"},
        { "location": "301/TALK"  , "narrator": "ガブリエラ", "text": "悪霊だかなんだか\n知らないけど、\n狙うのはあたしよ！"},
        { "location": "305/TALK"  , "narrator": "アーヤ", "text": "ギャヴィ！？"},
        { "location": "306/TALK"  , "narrator": "ガブリエラ", "text": "怖がりのアーヤに\n手出ししたら、\nあたしが許さない！"},
        { "location": "307/TALK"  , "narrator": "ガブリエラ", "text": "あたしがアーヤを\n護るんだから！！"},
        { "location": "308/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "314/TALK"  , "narrator": "ガブリエラ", "text": "…………あっ。"},
        { "location": "317/TALK"  , "narrator": "ガブリエラ", "text": "あたしのスマホが…。"},
        { "location": "318/TALK"  , "narrator": "アーヤ", "text": "…何て書いてあるの？"},
        { "location": "319/TALK"  , "narrator": "ガブリエラ", "text": "…え？"},
        { "location": "320/TALK"  , "narrator": "ガブリエラ", "text": "次はない、\n二度と我の部屋に\n入るな…って…。"},
        { "location": "321/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "322/TALK"  , "narrator": "ガブリエラ", "text": "…これ…許されたの？"},
        { "location": "325/TALK"  , "narrator": "アーヤ", "text": "わからない…\nわからないけど――"},
        { "location": "328/TALK"  , "narrator": "アーヤ", "text": "ギャヴィ、なんともない？"},
        { "location": "331/TALK"  , "narrator": "ガブリエラ", "text": "うん…アーヤも平気？"},
        { "location": "334/TALK"  , "narrator": "アーヤ", "text": "ええ…どうやら、\n助かった、ってこと\nかしら？"},
        { "location": "338/TALK"  , "narrator": "ガブリエラ", "text": "よ、よかったぁ…。"},
        { "location": "339/TALK"  , "narrator": "ガブリエラ", "text": "本当、一時はどうなるかと\n思ったわ…。"},
        { "location": "342/TALK"  , "narrator": "アーヤ", "text": "どうなるかと思った、\nじゃないでしょ！"},
        { "location": "343/TALK"  , "narrator": "アーヤ", "text": "自分を狙えだなんて、\nなんてバカなこと\n言うの！？"},
        { "location": "345/TALK"  , "narrator": "ガブリエラ", "text": "えっ！？\nだ、だって…。"},
        { "location": "346/TALK"  , "narrator": "アーヤ", "text": "私が護るって言ったのに、\nどうしていつも勝手に――"},
        { "location": "348/TALK"  , "narrator": "ガブリエラ", "text": "か、勝手なのは\nアーヤの方でしょ！？"},
        { "location": "349/TALK"  , "narrator": "ガブリエラ", "text": "狙われてたのは\nあたしなのに――"},
        { "location": "350/TALK"  , "narrator": "ガブリエラ", "text": "勝手に身代わりになろうと\nしたじゃない！"},
        { "location": "353/TALK"  , "narrator": "アーヤ", "text": "そ、それは…私は神社の\n娘だから、こういうのは\n慣れてるのよ。"},
        { "location": "354/TALK"  , "narrator": "ガブリエラ", "text": "超怖がりじゃん！\n耐性ゼロじゃん！"},
        { "location": "356/TALK"  , "narrator": "アーヤ", "text": "うっ…そ、それは…。"},
        { "location": "357/TALK"  , "narrator": "ガブリエラ", "text": "ほら、やっぱり。"},
        { "location": "358/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "361/TALK"  , "narrator": "ガブリエラ", "text": "…でも、嬉しかった。"},
        { "location": "362/TALK"  , "narrator": "ガブリエラ", "text": "あたしのこと…\n護るって言ってくれて…。"},
        { "location": "363/TALK"  , "narrator": "ガブリエラ", "text": "凄く怖かったのに、\n言ってくれたのよね？"},
        { "location": "366/TALK"  , "narrator": "アーヤ", "text": "…ギャヴィがいなくなる\nことに比べたら、\n何てことないわ。"},
        { "location": "368/TALK"  , "narrator": "アーヤ", "text": "それに、私も嬉しかった。\n護るって言ってもらえて。"},
        { "location": "372/TALK"  , "narrator": "ガブリエラ", "text": "…と、当然じゃない！\nあたしは怖くないん\nだから…。"},
        { "location": "373/TALK"  , "narrator": "アーヤ", "text": "ふふっ、そうね…。"},
        { "location": "374/TALK"  , "narrator": "アーヤ", "text": "…でも、もう二度と\n私の身代わりになろうと\nするようなこと――"},
        { "location": "375/TALK"  , "narrator": "アーヤ", "text": "ギャヴィにはしてほしく\nないわ。"},
        { "location": "378/TALK"  , "narrator": "ガブリエラ", "text": "あたしも同じよ。\nあんなの、全然嬉しく\nないんだから…。"},
        { "location": "379/TALK"  , "narrator": "アーヤ", "text": "たった今嬉しいって\n言ったのは、誰だった\nかしら？"},
        { "location": "381/TALK"  , "narrator": "ガブリエラ", "text": "い、一々そんな\nツッコミ入れないでよ！"},
        { "location": "382/TALK"  , "narrator": "ガブリエラ", "text": "とにかく、もう二度と\n身代わりになろうと\nするのは禁止よ？"},
        { "location": "383/TALK"  , "narrator": "アーヤ", "text": "ギャヴィもしない、って\n約束してくれるなら、\n私も誓うわ。"},
        { "location": "385/TALK"  , "narrator": "ガブリエラ", "text": "しないって。"},
        { "location": "387/TALK"  , "narrator": "ガブリエラ", "text": "…………多分ね。"},
        { "location": "395/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "397/TALK"  , "narrator": "みやび", "text": "乱入するタイミング、\n完全に逃したてしもうた。"},
        { "location": "409/TALK"  , "narrator": "みやび", "text": "相棒の協力のおかげで、バッチリお仕置き完了ちや"},
        { "location": "410/TALK"  , "narrator": "みやび", "text": "お手伝いありがとさん"},
        { "location": "412/SEL"   , "narrator": "", "text": "二人はどうする？"},
        { "location": "413/ACT"   , "narrator": "", "text": "二人はどうする？"},
        { "location": "415/TALK"  , "narrator": "みやび", "text": "えい雰囲気やし、一晩放っておくつもりや"},
        { "location": "416/TALK"  , "narrator": "みやび", "text": "あんな仲のえい二人の姿、初めて見るきね"},
        { "location": "443/ACT"   , "narrator": "", "text": "$me$だよー、驚いた？"},
        { "location": "450/TALK"  , "narrator": "アーヤ", "text": "っ！？\n何かしら…。"},
        { "location": "464/TALK"  , "narrator": "アーヤ", "text": "タイミング悪過ぎ"},
        { "location": "465/TALK"  , "narrator": "アーヤ", "text": "空気読めないおふざけって、本当最低ね"},
        { "location": "477/TALK"  , "narrator": "ガブリエラ", "text": "…なんだったの？"},
        { "location": "479/TALK"  , "narrator": "アーヤ", "text": "迷惑メールみたいなもの\nだったわ。"},
        { "location": "481/TALK"  , "narrator": "アーヤ", "text": "またふざけられるのも\n腹が立つし、電源切って\nおいた方が良さそうね。"},
        { "location": "17/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>8月25日　 11:44 PM</color>\n合宿中、とある雨の日のこと"},
        { "location": "437/DIALOG", "narrator": "Dialog_GEThimegoto_ch02", "text": "【うしろの正面だあれ？】"}
    ]
}
