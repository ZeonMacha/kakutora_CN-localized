{
    "dir": "chap33/daydra/dd_ch05_33_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "33505",
        "cid": "kagura",
        "title": "005 メインストーリー",
        "sub_title": "１年Ａ組珠緒先生＜後編＞"
    },
    "entry":
    [
        { "location": "3354/TALK"  , "narrator": "雛", "text": "…たまちゃん。\n東雲教官から、\nなにか返ってきた？"},
        { "location": "3355/TALK"  , "narrator": "珠緒先生", "text": "なにも…既読すら\nつかないわ。"},
        { "location": "3357/TALK"  , "narrator": "ヒカル", "text": "…やっぱり、\n足が付くのを\n警戒してるのかな？"},
        { "location": "3359/TALK"  , "narrator": "繭", "text": "でも、通知画面で\n見ることはできて\nいるはず。"},
        { "location": "3366/TALK"  , "narrator": "珠緒先生", "text": "ッ！？\n来た！！"},
        { "location": "3368/TALK"  , "narrator": "キリト", "text": "よっしゃ！！\nそれで、なんだって？"},
        { "location": "3369/TALK"  , "narrator": "珠緒先生", "text": "ちょっと待って…。"},
        { "location": "3370/TALK"  , "narrator": "珠緒先生", "text": "…なるほど。\nこれくらいなら、\nどうにかなるかも。"},
        { "location": "3371/TALK"  , "narrator": "キリト", "text": "たまちゃん、\n教官はなんて\n言ってきてるんだよ？"},
        { "location": "3376/TALK"  , "narrator": "珠緒先生", "text": "…劇場にある、\n予備サーバーに\nアクセスして…。"},
        { "location": "3377/TALK"  , "narrator": "珠緒先生", "text": "そこから国交省の\nサーバーにアクセス\nしてほしいみたい。"},
        { "location": "3379/TALK"  , "narrator": "雛", "text": "それって、つまり…。"},
        { "location": "3381/TALK"  , "narrator": "繭", "text": "私の役目。\n国交省にアクセスした\n後は、なにをすれば？"},
        { "location": "3384/TALK"  , "narrator": "珠緒先生", "text": "まず第一に、\n首都圏の交通を\n麻痺させること。"},
        { "location": "3385/TALK"  , "narrator": "珠緒先生", "text": "次に、情報管理庁の\n通信環境の一時的な\n完全遮断。"},
        { "location": "3386/TALK"  , "narrator": "珠緒先生", "text": "更に、文教ドームの\nネットワーク設備の\n完全遮断。"},
        { "location": "3387/TALK"  , "narrator": "珠緒先生", "text": "この三つを、\n早急にやってほしい\nみたい。"},
        { "location": "3388/TALK"  , "narrator": "繭", "text": "わかりました。\nすぐに対応します。"},
        { "location": "3390/TALK"  , "narrator": "雛", "text": "ごめんね、まゆちん。\n専門外だから\n手伝えないけど…。"},
        { "location": "3392/TALK"  , "narrator": "繭", "text": "大丈夫。\n難しいけど、\nどうにかする。"},
        { "location": "3394/TALK"  , "narrator": "珠緒先生", "text": "大丈夫よ。\n二人でやれば、\nそう難しくないわ。"},
        { "location": "3398/TALK"  , "narrator": "ヒカル", "text": "え？　まさか、\n珠緒先生もできるん\nですか？"},
        { "location": "3400/TALK"  , "narrator": "珠緒先生", "text": "ええ、情報系は\n私の専門だもの。"},
        { "location": "3402/TALK"  , "narrator": "キリト", "text": "いや、初耳だから！\nってか、マジなのか？"},
        { "location": "3403/TALK"  , "narrator": "珠緒先生", "text": "マジです！\n資格だってちゃんと\n持ってるのよ？"},
        { "location": "3404/TALK"  , "narrator": "繭", "text": "でも、私の専攻してる\n授業を教えていない\nですよね？"},
        { "location": "3407/TALK"  , "narrator": "珠緒先生", "text": "光月さんが専攻して\nいるのは、電気電算\nでしょう？"},
        { "location": "3408/TALK"  , "narrator": "珠緒先生", "text": "私が専攻しているのは\n機密情報管理だから。"},
        { "location": "3409/TALK"  , "narrator": "珠緒先生", "text": "情報管理庁附属大学に\nいくと、専門の科が\nあるんだけど…。"},
        { "location": "3410/TALK"  , "narrator": "珠緒先生", "text": "高校だと、あんまり\nない授業なの。"},
        { "location": "3411/TALK"  , "narrator": "繭", "text": "…ヤバいですね。"},
        { "location": "3413/TALK"  , "narrator": "キリト", "text": "わかるように\n言ってくれ。"},
        { "location": "3414/TALK"  , "narrator": "繭", "text": "つまり、\n珠緒先生が専門に\nしているのは…。"},
        { "location": "3415/TALK"  , "narrator": "繭", "text": "スパイ活動と\n情報妨害工作を\nメインとする研究科。"},
        { "location": "3417/TALK"  , "narrator": "キリト", "text": "…ヤバいな。"},
        { "location": "3419/TALK"  , "narrator": "ヒカル", "text": "…思いもしなかった。"},
        { "location": "3421/TALK"  , "narrator": "雛", "text": "エージェント\nたまちゃん…。"},
        { "location": "3422/TALK"  , "narrator": "珠緒先生", "text": "そ、そんな驚くこと\nないでしょう！？"},
        { "location": "3423/TALK"  , "narrator": "繭", "text": "もしかして、\n今までも裏で…。"},
        { "location": "3424/TALK"  , "narrator": "繭", "text": "東雲教官達を\nサポートしていたん\nですか？"},
        { "location": "3426/TALK"  , "narrator": "珠緒先生", "text": "…まあ、まほちゃんに\n色々情報を渡しは\nしてたけど。"},
        { "location": "3427/TALK"  , "narrator": "珠緒先生", "text": "みんなが海に合宿に\n行ったときだけど…。"},
        { "location": "3428/TALK"  , "narrator": "珠緒先生", "text": "偶然、管理庁のヘリが\n不自然なフライトを\nしてるのを知って…。"},
        { "location": "3429/TALK"  , "narrator": "珠緒先生", "text": "コッソリそれを\n教えたりとか？"},
        { "location": "3430/TALK"  , "narrator": "珠緒先生", "text": "日向さんと光月さんが\n捕まっているのを教えて、\n対処法を相談したりとか？"},
        { "location": "3432/TALK"  , "narrator": "キリト", "text": "…なんでそんな情報を\nゲットできるんだ？"},
        { "location": "3434/TALK"  , "narrator": "珠緒先生", "text": "…先生の口からは\n話せません。"},
        { "location": "3435/TALK"  , "narrator": "キリト", "text": "…可愛い顔して、\nメッチャヤバいこと\nするんだな…。"},
        { "location": "3436/TALK"  , "narrator": "珠緒先生", "text": "もう、私の話は\nいいから！"},
        { "location": "3437/TALK"  , "narrator": "珠緒先生", "text": "とにかく、今は\nお互いの分担について\n話しますよ！"},
        { "location": "3438/TALK"  , "narrator": "雛", "text": "わ、わかりました、\n珠緒教官！！"},
        { "location": "3440/TALK"  , "narrator": "珠緒先生", "text": "…いつも通りで\nいいから。"},
        { "location": "3454/TALK"  , "narrator": "珠緒先生", "text": "…困ったわ。"},
        { "location": "3455/TALK"  , "narrator": "繭", "text": "ええ…というか、\n万事休す。"},
        { "location": "3457/TALK"  , "narrator": "キリト", "text": "ど、どうしたんだよ？\nなにか問題でも\nあるのか？"},
        { "location": "3459/TALK"  , "narrator": "珠緒先生", "text": "…とんでもない\n大問題よ。"},
        { "location": "3460/TALK"  , "narrator": "珠緒先生", "text": "劇場にあるサーバーに\nアクセスすることが\nできないの…。"},
        { "location": "3462/TALK"  , "narrator": "雛", "text": "えっ、どうして！？\n初っぱなから\n詰んでるじゃん！"},
        { "location": "3464/TALK"  , "narrator": "ヒカル", "text": "セキュリティが\n堅すぎる、とか\nですか？"},
        { "location": "3467/TALK"  , "narrator": "珠緒先生", "text": "そういうことじゃ\nなくて…。"},
        { "location": "3468/TALK"  , "narrator": "繭", "text": "サーバーの電源が、\n大元から切られてる。"},
        { "location": "3469/TALK"  , "narrator": "キリト", "text": "…そりゃ無理だわな。"},
        { "location": "3471/TALK"  , "narrator": "ヒカル", "text": "サーバーが動かなきゃ\nアクセスできるはず\nないよね…。"},
        { "location": "3473/TALK"  , "narrator": "珠緒先生", "text": "盲点だったわ。\n無停電電源装置も\n尽きてるみたいだし。"},
        { "location": "3476/TALK"  , "narrator": "雛", "text": "えーっと、つまり…、\nマジ万事休す？"},
        { "location": "3478/TALK"  , "narrator": "繭", "text": "そういうことになる。"},
        { "location": "3481/TALK"  , "narrator": "キリト", "text": "う～ん…。"},
        { "location": "3483/TALK"  , "narrator": "キリト", "text": "…やるか？"},
        { "location": "3485/TALK"  , "narrator": "ヒカル", "text": "…そうだね。\nどう考えても、\n僕たちの役目だし。"},
        { "location": "3488/TALK"  , "narrator": "雛", "text": "なんのこと？"},
        { "location": "3493/TALK"  , "narrator": "キリト", "text": "大元の電源が\n切られてるのが\n問題なんだろ？"},
        { "location": "3494/TALK"  , "narrator": "キリト", "text": "なら、俺たちが\n劇場に行って、\n電源入れてくるさ。"},
        { "location": "3496/TALK"  , "narrator": "珠緒先生", "text": "だ、ダメよ！！\n劇場は厳重に監視\nされてるのよ！？"},
        { "location": "3497/TALK"  , "narrator": "珠緒先生", "text": "もし見つかったり\nしたら、どうなるか\nわからないわ。"},
        { "location": "3498/TALK"  , "narrator": "雛", "text": "そうだよ！\nてか、二人とも\n謹慎中なんだし…。"},
        { "location": "3499/TALK"  , "narrator": "雛", "text": "捕まったりしたら\nタダじゃすまない\nでしょ？"},
        { "location": "3500/TALK"  , "narrator": "キリト", "text": "捕まんなきゃいい\nだけだろ。"},
        { "location": "3501/TALK"  , "narrator": "雛", "text": "それはそうだけど、\nそんな簡単じゃないと\n思うよ？"},
        { "location": "3503/TALK"  , "narrator": "繭", "text": "…危険すぎる。"},
        { "location": "3504/TALK"  , "narrator": "キリト", "text": "わかってるさ。"},
        { "location": "3505/TALK"  , "narrator": "繭", "text": "…けど、それ以外に\n方法がないのも\n事実。"},
        { "location": "3506/TALK"  , "narrator": "ヒカル", "text": "そうだよね。\nじゃあ、やるのは\n決まりだね。"},
        { "location": "3508/TALK"  , "narrator": "珠緒先生", "text": "ああ、もうっ！\nどんどん悪い方向に\n進んじゃってるわ…。"},
        { "location": "3509/TALK"  , "narrator": "キリト", "text": "大丈夫だって！\n絶対捕まらないように\n気をつけるからさ。"},
        { "location": "3511/TALK"  , "narrator": "珠緒先生", "text": "当たり前です！"},
        { "location": "3512/TALK"  , "narrator": "珠緒先生", "text": "…これだけは\n忘れないで。"},
        { "location": "3513/TALK"  , "narrator": "珠緒先生", "text": "電源は恐らく、\n管理庁に切られた\nわけだから…。"},
        { "location": "3514/TALK"  , "narrator": "珠緒先生", "text": "電源が入った瞬間、\nすぐに気付かれるのは\n確実よ。"},
        { "location": "3515/TALK"  , "narrator": "珠緒先生", "text": "だから、決行は\n必要な日時の\nその瞬間だけ。"},
        { "location": "3516/TALK"  , "narrator": "珠緒先生", "text": "電源が入ったら、\n一瞬で全ての\nミッションをこなす。"},
        { "location": "3517/TALK"  , "narrator": "珠緒先生", "text": "これを成功させるには\n高度な連係プレイが\n必要になるけど…。"},
        { "location": "3518/TALK"  , "narrator": "珠緒先生", "text": "成功させる自信は\nちゃんとある？"},
        { "location": "3519/TALK"  , "narrator": "キリト", "text": "当たり前だろ。\n俺たちを舐めないで\nくれよな。"},
        { "location": "3521/TALK"  , "narrator": "ヒカル", "text": "うん。\n不安はないよ。"},
        { "location": "3525/TALK"  , "narrator": "珠緒先生", "text": "…日向さん達は？"},
        { "location": "3526/TALK"  , "narrator": "雛", "text": "…もちろん。\nやる以上は、\n絶対成功させるよ！"},
        { "location": "3527/TALK"  , "narrator": "繭", "text": "…もう、二度と\n失敗はしません。"},
        { "location": "3529/TALK"  , "narrator": "珠緒先生", "text": "…わかった。\nもう、これ以上は\n止めないわ。"},
        { "location": "3530/TALK"  , "narrator": "珠緒先生", "text": "決行日までに、\nとにかく準備を\n固めましょ。"},
        { "location": "3532/TALK"  , "narrator": "キリト", "text": "よっしゃ！！\nヒカル、まずは装備を\nどうにかしようぜ。"},
        { "location": "3534/TALK"  , "narrator": "雛", "text": "あたしは劇場の\n警備状況を調べて\nくるよ。"},
        { "location": "3536/TALK"  , "narrator": "珠緒先生", "text": "…………。"},
        { "location": "3538/TALK"  , "narrator": "繭", "text": "大丈夫ですよ。\nきっと、上手く\nいきますから。"},
        { "location": "3540/TALK"  , "narrator": "珠緒先生", "text": "…だといいけど。\n光月さんは、\n不安じゃないの？"},
        { "location": "3541/TALK"  , "narrator": "繭", "text": "不安は皆無です。"},
        { "location": "3542/TALK"  , "narrator": "繭", "text": "みんなを、\n信頼してますから。"},
        { "location": "3586/TALK"  , "narrator": "プレイヤー", "text": "こんにちは"},
        { "location": "3587/SEL"   , "narrator": "", "text": "こんにちは"},
        { "location": "3588/ACT"   , "narrator": "", "text": "こんにちは"},
        { "location": "3590/TALK"  , "narrator": "プレイヤー", "text": "そっちは何か妙案出た？"},
        { "location": "3591/SEL"   , "narrator": "", "text": "全然"},
        { "location": "3592/SEL"   , "narrator": "", "text": "まあ、色々動いてはいる"},
        { "location": "3593/ACT"   , "narrator": "", "text": "全然"},
        { "location": "3594/TALK"  , "narrator": "プレイヤー", "text": "同じだね、それで色々考えたんだけど質問していい？"},
        { "location": "3595/ACT"   , "narrator": "", "text": "まあ、色々動いてはいる"},
        { "location": "3596/TALK"  , "narrator": "プレイヤー", "text": "なるほど、ところでちょっと質問していい？"},
        { "location": "3598/SEL"   , "narrator": "", "text": "どうぞ"},
        { "location": "3599/ACT"   , "narrator": "", "text": "どうぞ"},
        { "location": "3601/TALK"  , "narrator": "プレイヤー", "text": "そっちが一番大事なのって、何？"},
        { "location": "3602/SEL"   , "narrator": "", "text": "トライナリーたちの幸せ"},
        { "location": "3603/SEL"   , "narrator": "", "text": "千羽鶴の幸せ"},
        { "location": "3604/SEL"   , "narrator": "", "text": "世界平定"},
        { "location": "3605/ACT"   , "narrator": "", "text": "トライナリーたちの幸せ"},
        { "location": "3606/TALK"  , "narrator": "プレイヤー", "text": "あーやっぱり、$me$と似てるって言うか、世界平和とかじゃないよね"},
        { "location": "3607/ACT"   , "narrator": "", "text": "千羽鶴の幸せ"},
        { "location": "3608/TALK"  , "narrator": "プレイヤー", "text": "あーやっぱり、$me$と似てるって言うか、世界平和とかじゃないよね"},
        { "location": "3609/ACT"   , "narrator": "", "text": "世界平定"},
        { "location": "3610/TALK"  , "narrator": "プレイヤー", "text": "高尚だね、、それだと話が終わってしまう"},
        { "location": "3611/SEL"   , "narrator": "", "text": "とりあえず話してみて"},
        { "location": "3612/ACT"   , "narrator": "", "text": "とりあえず話してみて"},
        { "location": "3616/TALK"  , "narrator": "プレイヤー", "text": "もし護りたい人がいて、その人が幸せなら、ぶっちゃけ世界はそこそこでよくね？"},
        { "location": "3617/SEL"   , "narrator": "", "text": "極論そうだと思う"},
        { "location": "3618/SEL"   , "narrator": "", "text": "世界が平和でなければ幸せにはなれないでしょ"},
        { "location": "3619/ACT"   , "narrator": "", "text": "極論そうだと思う"},
        { "location": "3620/TALK"  , "narrator": "プレイヤー", "text": "ですよねー、世界そのものに愛着があるわけじゃないでしょ、正直"},
        { "location": "3621/ACT"   , "narrator": "", "text": "世界が平和でなければ幸せにはなれないでしょ"},
        { "location": "3622/TALK"  , "narrator": "プレイヤー", "text": "まあそうだけど、一度そこは切り離して考えて！"},
        { "location": "3624/SEL"   , "narrator": "", "text": "そうするとどうなるの？"},
        { "location": "3625/ACT"   , "narrator": "", "text": "そうするとどうなるの？"},
        { "location": "3627/TALK"  , "narrator": "プレイヤー", "text": "$me$も７５３に幸せになって欲しいと思ってる、けど世界全部とかじゃない"},
        { "location": "3628/SEL"   , "narrator": "", "text": "要するに、お互いの利害が一致するところで妥協して線引きしようってこと？"},
        { "location": "3629/ACT"   , "narrator": "", "text": "要するに、お互いの利害が一致するところで妥協して線引きしようってこと？"},
        { "location": "3631/TALK"  , "narrator": "プレイヤー", "text": "そうそう、それ"},
        { "location": "3632/SEL"   , "narrator": "", "text": "けど既にアーヤたちの生死で争ってるわけで、詰んでるのでは…？"},
        { "location": "3633/ACT"   , "narrator": "", "text": "けど既にアーヤたちの生死で争ってるわけで、詰んでるのでは…？"},
        { "location": "3635/TALK"  , "narrator": "プレイヤー", "text": "まあそうなんだけど、こっちは究極的にはここで肉体を消滅させずともよくて"},
        { "location": "3636/SEL"   , "narrator": "", "text": "？？？"},
        { "location": "3637/ACT"   , "narrator": "", "text": "？？？"},
        { "location": "3639/TALK"  , "narrator": "プレイヤー", "text": "信じて正直言うと、ぶっちゃけそっちに妨害される方が面倒なんです"},
        { "location": "3640/SEL"   , "narrator": "", "text": "お互い様やん…"},
        { "location": "3641/ACT"   , "narrator": "", "text": "お互い様やん…"},
        { "location": "3643/TALK"  , "narrator": "プレイヤー", "text": "だからこそ線引きするのはどうですか？ってことです"},
        { "location": "3644/SEL"   , "narrator": "", "text": "具体的には？"},
        { "location": "3645/ACT"   , "narrator": "", "text": "具体的には？"},
        { "location": "3647/TALK"  , "narrator": "プレイヤー", "text": "今回は引き下がります、けど、次は譲歩して欲しい"},
        { "location": "3648/SEL"   , "narrator": "", "text": "いいよ"},
        { "location": "3649/SEL"   , "narrator": "", "text": "次もクリティカルだったらアウトだからダメ"},
        { "location": "3650/ACT"   , "narrator": "", "text": "いいよ"},
        { "location": "3651/TALK"  , "narrator": "プレイヤー", "text": "契約成立だね"},
        { "location": "3652/ACT"   , "narrator": "", "text": "次もクリティカルだったらアウトだからダメ"},
        { "location": "3653/TALK"  , "narrator": "プレイヤー", "text": "もちろん容赦なく差し押さえたりしないよ、あくまで譲歩して欲しいってだけ"},
        { "location": "3655/SEL"   , "narrator": "", "text": "でも、なんでそんなに弱腰外交なの？"},
        { "location": "3656/ACT"   , "narrator": "", "text": "でも、なんでそんなに弱腰外交なの？"},
        { "location": "3658/TALK"  , "narrator": "プレイヤー", "text": "全然弱腰じゃないよ、今回の件はこっちとしては譲歩出来る案件ってだけで"},
        { "location": "3659/TALK"  , "narrator": "プレイヤー", "text": "正直言うと、譲歩できない時にそっちに無理矢理邪魔されるとホント困るんで"},
        { "location": "3660/SEL"   , "narrator": "", "text": "けど、ダメな時はどうしたって邪魔することになると思うけど"},
        { "location": "3661/ACT"   , "narrator": "", "text": "けど、ダメな時はどうしたって邪魔することになると思うけど"},
        { "location": "3663/TALK"  , "narrator": "プレイヤー", "text": "まあそれでも、ハナから敵対してるより和睦してた方が選択肢が増えるよね？"},
        { "location": "3664/SEL"   , "narrator": "", "text": "甘いわその考え、人生は常に戦争だよ"},
        { "location": "3665/SEL"   , "narrator": "", "text": "確かにその通り"},
        { "location": "3666/ACT"   , "narrator": "", "text": "甘いわその考え、人生は常に戦争だよ"},
        { "location": "3667/TALK"  , "narrator": "プレイヤー", "text": "思ったより頭緩い？あまり言いたくないけど、今の状況をよく見てみて"},
        { "location": "3668/SEL"   , "narrator": "", "text": "アーヤたちのこと？"},
        { "location": "3669/ACT"   , "narrator": "", "text": "アーヤたちのこと？"},
        { "location": "3671/TALK"  , "narrator": "プレイヤー", "text": "そう、このまま$me$が妨害し続ければ、彼女らは死んで$me$達の思い通りになる"},
        { "location": "3672/TALK"  , "narrator": "プレイヤー", "text": "申し訳ないけど、現時点においては$me$の方が有利、その中で譲歩してるわけ"},
        { "location": "3673/SEL"   , "narrator": "", "text": "確かにそうだ、さっきの提案呑むわ"},
        { "location": "3674/SEL"   , "narrator": "", "text": "ますます怪しい"},
        { "location": "3675/ACT"   , "narrator": "", "text": "確かにそうだ、さっきの提案呑むわ"},
        { "location": "3676/TALK"  , "narrator": "プレイヤー", "text": "ありがとう、お互い大事な人がいるわけだしね"},
        { "location": "3677/ACT"   , "narrator": "", "text": "ますます怪しい"},
        { "location": "3678/TALK"  , "narrator": "プレイヤー", "text": "結構面倒くさい人だね、、じゃあ、もう決裂でいい？"},
        { "location": "3679/SEL"   , "narrator": "", "text": "いいよ"},
        { "location": "3680/SEL"   , "narrator": "", "text": "いや、さっきの提案呑む"},
        { "location": "3681/ACT"   , "narrator": "", "text": "いいよ"},
        { "location": "3683/TALK"  , "narrator": "プレイヤー", "text": "わかった、じゃあ交渉決裂で"},
        { "location": "3685/ACT"   , "narrator": "", "text": "いや、さっきの提案呑む"},
        { "location": "3686/TALK"  , "narrator": "プレイヤー", "text": "ありがとう、お互い大事な人がいるわけだしね"},
        { "location": "3689/ACT"   , "narrator": "", "text": "確かにその通り"},
        { "location": "3690/TALK"  , "narrator": "プレイヤー", "text": "交渉成立だね、ありがとう。お互い大事な人を護る事に専念しよう"},
        { "location": "3692/SEL"   , "narrator": "", "text": "で、この後は？"},
        { "location": "3693/ACT"   , "narrator": "", "text": "で、この後は？"},
        { "location": "3695/TALK"  , "narrator": "プレイヤー", "text": "もちろん今回は何もしないよ、頑張って助けてください"},
        { "location": "3702/TALK"  , "narrator": "アーヤ", "text": "冷静にならなきゃ…。"},
        { "location": "3703/SEL"   , "narrator": "", "text": "落ち着けば大丈夫"},
        { "location": "3704/ACT"   , "narrator": "", "text": "落ち着けば大丈夫"},
        { "location": "3708/TALK"  , "narrator": "アーヤ", "text": "あ"},
        { "location": "3714/TALK"  , "narrator": "アーヤ", "text": "メッセージ"},
        { "location": "3717/SEL"   , "narrator": "", "text": "何度もしたよ"},
        { "location": "3718/SEL"   , "narrator": "", "text": "気付いてくれてよかった"},
        { "location": "3719/ACT"   , "narrator": "", "text": "何度もしたよ"},
        { "location": "3720/TALK"  , "narrator": "アーヤ", "text": "してたの"},
        { "location": "3721/ACT"   , "narrator": "", "text": "気付いてくれてよかった"},
        { "location": "3722/TALK"  , "narrator": "アーヤ", "text": "今ね"},
        { "location": "3724/TALK"  , "narrator": "アーヤ", "text": "$handle$さんは"},
        { "location": "3725/TALK"  , "narrator": "アーヤ", "text": "味方よね"},
        { "location": "3727/SEL"   , "narrator": "", "text": "当たり前でしょ"},
        { "location": "3728/SEL"   , "narrator": "", "text": "なんで疑うかな"},
        { "location": "3729/SEL"   , "narrator": "", "text": "他のポジションはないよ"},
        { "location": "3730/ACT"   , "narrator": "", "text": "当たり前でしょ"},
        { "location": "3731/TALK"  , "narrator": "アーヤ", "text": "そうよ"},
        { "location": "3732/ACT"   , "narrator": "", "text": "なんで疑うかな"},
        { "location": "3733/TALK"  , "narrator": "アーヤ", "text": "わからない"},
        { "location": "3734/ACT"   , "narrator": "", "text": "他のポジションはないよ"},
        { "location": "3735/TALK"  , "narrator": "アーヤ", "text": "だったわ"},
        { "location": "3737/TALK"  , "narrator": "アーヤ", "text": "たすけて"},
        { "location": "3738/TALK"  , "narrator": "アーヤ", "text": "わたｓ"},
        { "location": "3739/TALK"  , "narrator": "アーヤ", "text": "しにたくない"},
        { "location": "3741/SEL"   , "narrator": "", "text": "死なせない"},
        { "location": "3742/SEL"   , "narrator": "", "text": "落ち着いて"},
        { "location": "3743/SEL"   , "narrator": "", "text": "大丈夫だから"},
        { "location": "3744/ACT"   , "narrator": "", "text": "死なせない"},
        { "location": "3745/TALK"  , "narrator": "アーヤ", "text": "はい"},
        { "location": "3746/ACT"   , "narrator": "", "text": "落ち着いて"},
        { "location": "3747/TALK"  , "narrator": "アーヤ", "text": "おちつくわ"},
        { "location": "3748/ACT"   , "narrator": "", "text": "大丈夫だから"},
        { "location": "3749/TALK"  , "narrator": "アーヤ", "text": "大丈夫よね"},
        { "location": "3752/SEL"   , "narrator": "", "text": "まず車内の装備を確認して"},
        { "location": "3753/ACT"   , "narrator": "", "text": "まず車内の装備を確認して"},
        { "location": "3754/TALK"  , "narrator": "アーヤ", "text": "ｗかったわ"},
        { "location": "3759/TALK"  , "narrator": "アーヤ", "text": "大丈夫。\nおちついて國政綾水。"},
        { "location": "3760/TALK"  , "narrator": "アーヤ", "text": "私はできる。\n$handle$さんも\nついてくれてる。"},
        { "location": "3761/TALK"  , "narrator": "アーヤ", "text": "だから、大丈夫――"},
        { "location": "3764/TALK"  , "narrator": "アーヤ", "text": "二人とも。"},
        { "location": "3765/TALK"  , "narrator": "アーヤ", "text": "アーケロンに\n何を積んだか\n憶えてる？"},
        { "location": "3767/TALK"  , "narrator": "プレイヤー", "text": "カミングアウトするけど、今アーケロンが暴走してるのは$me$の仕業なんだ"},
        { "location": "3768/TALK"  , "narrator": "アーヤ", "text": "え？？？？"},
        { "location": "3770/SEL"   , "narrator": "", "text": "おいやめろ！"},
        { "location": "3771/ACT"   , "narrator": "", "text": "おいやめろ！"},
        { "location": "3773/TALK"  , "narrator": "アーヤ", "text": "なにを！！"},
        { "location": "3775/TALK"  , "narrator": "プレイヤー", "text": "愛しのアーヤ、お願いだから肉体を解脱して魂だけになろう、そして$me$の所へ来て"},
        { "location": "3776/SEL"   , "narrator": "", "text": "やめて、アーヤ聞いちゃダメ！！"},
        { "location": "3777/ACT"   , "narrator": "", "text": "やめて、アーヤ聞いちゃダメ！！"},
        { "location": "3779/TALK"  , "narrator": "アーヤ", "text": "もうないん！！１１"},
        { "location": "3780/TALK"  , "narrator": "アーヤ", "text": "きｒ"},
        { "location": "3785/TALK"  , "narrator": "アーヤ", "text": "なんなの！？\nなんなのなんなの！？"},
        { "location": "3786/TALK"  , "narrator": "アーヤ", "text": "$handle$！！\n$handle$！！\n裏切り者！裏切り者！！"},
        { "location": "3787/TALK"  , "narrator": "アーヤ", "text": "もうダメ……\n何も出来ることがない…\n私、もう"},
        { "location": "3788/TALK"  , "narrator": "アーヤ", "text": "死ぬんだ…。"},
