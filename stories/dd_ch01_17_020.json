{
    "dir": "chap17/daydra/dd_ch01_17_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "17156",
        "cid": "tsubame",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "みやびの弁当"
    },
    "entry":
    [
        { "location": "288/SCENARIO", "narrator": "", "text": "みやびの弁当"},
        { "location": "308/TALK"    , "narrator": "つばめ", "text": "あれ？\n今日ってみんな\nお弁当なんだ？"},
        { "location": "309/TALK"    , "narrator": "つばめ", "text": "じゃあ、今日はわたし、\n一人学食かぁ…。"},
        { "location": "311/TALK"    , "narrator": "雛", "text": "水臭いなぁ。\nあたし達も行くよ。"},
        { "location": "312/TALK"    , "narrator": "キリト", "text": "ああ。\n弁当はどこでだって\n食えるからな。"},
        { "location": "314/TALK"    , "narrator": "つばめ", "text": "嬉しいけど、\n多分混んでると\n思うから――"},
        { "location": "315/TALK"    , "narrator": "つばめ", "text": "わたしだけ行って、\nささっと食べてくるよ。"},
        { "location": "318/TALK"    , "narrator": "つばめ", "text": "みんなはゆっくり\n教室で食べてて。"},
        { "location": "331/TALK"    , "narrator": "みやび", "text": "…失敗した。"},
        { "location": "332/TALK"    , "narrator": "みやび", "text": "これくらい余裕やと\n思うたんやけんど…。"},
        { "location": "344/TALK"    , "narrator": "みやび", "text": "お腹パンパンちや"},
        { "location": "346/SEL"     , "narrator": "", "text": "よかったね"},
        { "location": "347/ACT"     , "narrator": "", "text": "よかったね"},
        { "location": "349/TALK"    , "narrator": "みやび", "text": "あんまし良くないんよ"},
        { "location": "350/TALK"    , "narrator": "みやび", "text": "今日は弁当持って来たんやけんど"},
        { "location": "351/TALK"    , "narrator": "みやび", "text": "急に、購買のパンが食べたくなったがよ"},
        { "location": "352/TALK"    , "narrator": "みやび", "text": "やき、パンを買って食べたんやけんど…"},
        { "location": "353/TALK"    , "narrator": "みやび", "text": "あとはわかるな？"},
        { "location": "355/SEL"     , "narrator": "", "text": "弁当入らなくなった？"},
        { "location": "356/ACT"     , "narrator": "", "text": "弁当入らなくなった？"},
        { "location": "358/TALK"    , "narrator": "みやび", "text": "正解や"},
        { "location": "359/TALK"    , "narrator": "みやび", "text": "賞品はこの哀れな弁当一つ、と言いたいところやけんど"},
        { "location": "360/TALK"    , "narrator": "みやび", "text": "相棒じゃ食べれんき、自動的に辞退やね"},
        { "location": "361/TALK"    , "narrator": "みやび", "text": "…無駄になってしまうけんど、諦めるしかないがか？"},
        { "location": "364/SEL"     , "narrator": "", "text": "明日から気を付けよう"},
        { "location": "365/SEL"     , "narrator": "", "text": "つばめにあげよう"},
        { "location": "366/ACT"     , "narrator": "", "text": "明日から気を付けよう"},
        { "location": "367/TALK"    , "narrator": "みやび", "text": "食べ物無駄にするんは、罰当たりちや"},
        { "location": "368/TALK"    , "narrator": "みやび", "text": "素直に反省して、二度とせんようにするがよ"},
        { "location": "381/ACT"     , "narrator": "", "text": "つばめにあげよう"},
        { "location": "383/TALK"    , "narrator": "みやび", "text": "つばめちゃん、うちの料理美味しい言うてくれるきね"},
        { "location": "384/TALK"    , "narrator": "みやび", "text": "そうするちや"},
        { "location": "395/TALK"    , "narrator": "みやび", "text": "…けんど、つばめちゃんも\n弁当持ってきちゅうかも\nしれんな。"},
        { "location": "396/TALK"    , "narrator": "みやび", "text": "変に気を使わせるんも\n悪いし…。"},
        { "location": "397/SEL"     , "narrator": "", "text": "大丈夫、心配ない"},
        { "location": "398/ACT"     , "narrator": "", "text": "大丈夫、心配ない"},
        { "location": "415/TALK"    , "narrator": "みやび", "text": "相棒、何か知っちゅうな？"},
        { "location": "417/TALK"    , "narrator": "みやび", "text": "まあえいよ"},
        { "location": "418/TALK"    , "narrator": "みやび", "text": "そうまで言うなら、信じて持ってくちや"},
        { "location": "442/TALK"    , "narrator": "みやび", "text": "…そういうわけやき、\n押し付けるみたいで\n申し訳ないんやけんど――"},
        { "location": "443/TALK"    , "narrator": "みやび", "text": "よければこの弁当、\n貰うてくれんか？"},
        { "location": "445/TALK"    , "narrator": "つばめ", "text": "い、いいんですか！？\n本当にいただいちゃって。"},
        { "location": "446/TALK"    , "narrator": "みやび", "text": "そうしてもらえると\nうちも助かるがよ。"},
        { "location": "447/TALK"    , "narrator": "つばめ", "text": "みやびさん…\nありがとうございます！"},
        { "location": "448/TALK"    , "narrator": "つばめ", "text": "今日、お弁当持って\nこなかったこと、\n凄く後悔してたんです。"},
        { "location": "449/TALK"    , "narrator": "みやび", "text": "…何かあったがか？"},
        { "location": "451/TALK"    , "narrator": "つばめ", "text": "はい…今日はわたしだけ\nお弁当持ってきてなかった\nから――"},
        { "location": "452/TALK"    , "narrator": "つばめ", "text": "一人で学食に行こうと\n思ってたんです。"},
        { "location": "453/TALK"    , "narrator": "みやび", "text": "…そういうことやったか。"},
        { "location": "456/TALK"    , "narrator": "みやび", "text": "相棒、このこと知ってて、\nつばめちゃんにあげよう\n言うたんやな。"},
        { "location": "458/TALK"    , "narrator": "つばめ", "text": "みやびさんのお弁当が\nあれば、みんなと一緒に\n食べられます。"},
        { "location": "460/TALK"    , "narrator": "つばめ", "text": "ありがとうございます、\nみやびさん。"},
        { "location": "463/TALK"    , "narrator": "みやび", "text": "気にせんでえいき、\n早くみんなのところ\n行くぞね。"},
        { "location": "464/TALK"    , "narrator": "つばめ", "text": "わかりました。\nお弁当箱は帰ったら\n返しますね。"},
        { "location": "468/TALK"    , "narrator": "みやび", "text": "…まあ、相棒のおかげで\n弁当が無駄にならんで\nすんだんやし――"},
        { "location": "470/TALK"    , "narrator": "みやび", "text": "それで良しとするか。"},
        { "location": "298/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>7月20日　0:05 PM</color>\nとある平日の昼休み、附属学園つばめの教室にて。"}
    ]
}
