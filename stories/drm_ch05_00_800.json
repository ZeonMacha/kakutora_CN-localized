        "title": "らぶとーく 第80話",
        "sub_title": "少なくとも、この瞬間は真実だから"
    },
    "entry":
    [
        { "location": "958/SCENARIO", "narrator": "", "text": "少なくとも、この瞬間は真実だから"},
        { "location": "968/TALK"    , "narrator": "神楽", "text": "じゃあ帰ろうか？"},
        { "location": "969/SEL"     , "narrator": "", "text": "えっもう？"},
        { "location": "970/SEL"     , "narrator": "", "text": "そうだね、二人の愛の巣へ"},
        { "location": "971/SEL"     , "narrator": "", "text": "もう少し景色を楽しもうよ"},
        { "location": "972/ACT"     , "narrator": "", "text": "えっもう？"},
        { "location": "973/TALK"    , "narrator": "神楽", "text": "用事はすんだしー。"},
        { "location": "974/ACT"     , "narrator": "", "text": "そうだね、二人の愛の巣へ"},
        { "location": "975/TALK"    , "narrator": "神楽", "text": "ベタすぎー！"},
        { "location": "977/TALK"    , "narrator": "神楽", "text": "っていうか古い？\nそこがいいんだけど！"},
        { "location": "978/ACT"     , "narrator": "", "text": "もう少し景色を楽しもうよ"},
        { "location": "979/TALK"    , "narrator": "神楽", "text": "……そうね。"},
        { "location": "984/TALK"    , "narrator": "神楽", "text": "やっぱりちょっと\n景色も眺めて\n行こうか。"},
        { "location": "985/TALK"    , "narrator": "神楽", "text": "…………。"},
        { "location": "987/TALK"    , "narrator": "神楽", "text": "……この空が\n本物じゃなくても。"},
        { "location": "988/TALK"    , "narrator": "神楽", "text": "$handle$と\n並んで眺めることが\n今はできなくても。"},
        { "location": "989/TALK"    , "narrator": "神楽", "text": "それでも私は\n忘れないし。"},
        { "location": "990/TALK"    , "narrator": "神楽", "text": "気持ちだけは\n本物だって\n思ってる。"},
        { "location": "991/TALK"    , "narrator": "神楽", "text": "……そう思ってて\nいいんだよね……。"},
        { "location": "992/SEL"     , "narrator": "", "text": "$me$はこの景色を忘れない"},
        { "location": "993/SEL"     , "narrator": "", "text": "また来ようね"},
        { "location": "994/SEL"     , "narrator": "", "text": "きっといつか会おう"},
        { "location": "995/ACT"     , "narrator": "", "text": "$me$はこの景色を忘れない"},
        { "location": "997/TALK"    , "narrator": "神楽", "text": "……うん。\n私も。"},
        { "location": "998/ACT"     , "narrator": "", "text": "また来ようね"},
        { "location": "1000/TALK"   , "narrator": "神楽", "text": "そうね。\nそうしよう！"},
        { "location": "1001/ACT"    , "narrator": "", "text": "きっといつか会おう"},
        { "location": "1002/TALK"   , "narrator": "神楽", "text": "そうね。\nいつかきっと。"},
        { "location": "1004/TALK"   , "narrator": "神楽", "text": "……ねえ\n$handle$。"},
        { "location": "1005/TALK"   , "narrator": "神楽", "text": "さっき掛けた鍵ね。"},
        { "location": "1006/TALK"   , "narrator": "神楽", "text": "外す方法が\n実はあるって\n言ったらどうする？"},
        { "location": "1007/SEL"    , "narrator": "", "text": "忘れてもらう"},
        { "location": "1008/SEL"    , "narrator": "", "text": "嘘はつかないで"},
        { "location": "1009/SEL"    , "narrator": "", "text": "また掛け直せばいい"},
        { "location": "1010/ACT"    , "narrator": "", "text": "忘れてもらう"},
        { "location": "1012/TALK"   , "narrator": "神楽", "text": "まさかの記憶操作！？"},
        { "location": "1013/ACT"    , "narrator": "", "text": "嘘はつかないで"},
        { "location": "1014/TALK"   , "narrator": "神楽", "text": "嘘じゃないからー！"},
        { "location": "1015/ACT"    , "narrator": "", "text": "また掛け直せばいい"},
        { "location": "1016/TALK"   , "narrator": "神楽", "text": "現実的な対処かも…。"},
        { "location": "1019/TALK"   , "narrator": "神楽", "text": "私には鍵を\n外せないけど。"},
        { "location": "1020/TALK"   , "narrator": "神楽", "text": "パパなら何か\n知ってるような\n気がする。"},
        { "location": "1021/SEL"    , "narrator": "", "text": "それって哲学的な話？"},
        { "location": "1022/SEL"    , "narrator": "", "text": "それでも$me$が阻止する！"},
        { "location": "1023/SEL"    , "narrator": "", "text": "そうかもしれないね"},
        { "location": "1024/ACT"    , "narrator": "", "text": "それって哲学的な話？"},
        { "location": "1025/TALK"   , "narrator": "神楽", "text": "そうなのかな？"},
        { "location": "1026/ACT"    , "narrator": "", "text": "それでも$me$が阻止する！"},
        { "location": "1027/TALK"   , "narrator": "神楽", "text": "ちょっと\nカッコいいかも！"},
        { "location": "1028/ACT"    , "narrator": "", "text": "そうかもしれないね"},
        { "location": "1029/TALK"   , "narrator": "神楽", "text": "……もう\n聞けないんだけどね。"},
        { "location": "1033/TALK"   , "narrator": "神楽", "text": "なんて。\nパパの話ばっかりしても\n仕方ないよね。"},
        { "location": "1034/TALK"   , "narrator": "神楽", "text": "今日から私の家族は\n$handle$\nなんだから。"},
        { "location": "1035/SEL"    , "narrator": "", "text": "あっはい！"},
        { "location": "1036/SEL"    , "narrator": "", "text": "デレいただきましたー！！！！"},
        { "location": "1037/SEL"    , "narrator": "", "text": "ありがとう"},
        { "location": "1038/SEL"    , "narrator": "", "text": "思い出も大事にして"},
        { "location": "1039/ACT"    , "narrator": "", "text": "あっはい！"},
        { "location": "1041/TALK"   , "narrator": "神楽", "text": "無自覚だったの？"},
        { "location": "1042/ACT"    , "narrator": "", "text": "デレいただきましたー！！！！"},
        { "location": "1043/TALK"   , "narrator": "神楽", "text": "本当のことを\n言っただけだし。"},
        { "location": "1044/ACT"    , "narrator": "", "text": "ありがとう"},
        { "location": "1045/TALK"   , "narrator": "神楽", "text": "こっちこそ\nありがとう。"},
        { "location": "1046/ACT"    , "narrator": "", "text": "思い出も大事にして"},
        { "location": "1047/TALK"   , "narrator": "神楽", "text": "……そうするね。"},
        { "location": "1050/TALK"   , "narrator": "神楽", "text": "そうだ。"},
        { "location": "1051/TALK"   , "narrator": "神楽", "text": "$handle$は\n今日から\n私の家族……。"},
        { "location": "1062/TALK"   , "narrator": "神楽", "text": "おかえりなさい、\n$handle$。"},
        { "location": "1063/SEL"    , "narrator": "", "text": "ただいま"},
        { "location": "1064/SEL"    , "narrator": "", "text": "神楽もおかえりなさい"},
        { "location": "1065/SEL"    , "narrator": "", "text": "ここが新居？"},
        { "location": "1066/ACT"    , "narrator": "", "text": "ただいま"},
        { "location": "1068/TALK"   , "narrator": "神楽", "text": "おかえりー！"},
        { "location": "1069/ACT"    , "narrator": "", "text": "神楽もおかえりなさい"},
        { "location": "1071/TALK"   , "narrator": "神楽", "text": "うん。\nただいま。"},
        { "location": "1072/ACT"    , "narrator": "", "text": "ここが新居？"},
        { "location": "1074/TALK"   , "narrator": "神楽", "text": "っていうか\n私の部屋だけどね。"},
        { "location": "1076/TALK"   , "narrator": "神楽", "text": "今までと同じ。"},
        { "location": "1077/TALK"   , "narrator": "神楽", "text": "特別なことなんて\n何もないの。"},
        { "location": "1078/TALK"   , "narrator": "神楽", "text": "でもそういうのが\n大事なことだって\n思ってる。"},
        { "location": "1079/TALK"   , "narrator": "神楽", "text": "……どうかな？"},
        { "location": "1080/SEL"    , "narrator": "", "text": "そうかも"},
        { "location": "1081/SEL"    , "narrator": "", "text": "失いたくはないね"},
        { "location": "1082/SEL"    , "narrator": "", "text": "少しは盛り上げたい"},
        { "location": "1083/ACT"    , "narrator": "", "text": "そうかも"},
        { "location": "1084/TALK"   , "narrator": "神楽", "text": "そうだよね。"},
        { "location": "1085/ACT"    , "narrator": "", "text": "失いたくはないね"},
        { "location": "1086/TALK"   , "narrator": "神楽", "text": "うん。"},
        { "location": "1087/ACT"    , "narrator": "", "text": "少しは盛り上げたい"},
        { "location": "1088/TALK"   , "narrator": "神楽", "text": "そう……？"},
        { "location": "1090/SEL"    , "narrator": "", "text": "でも"},
        { "location": "1091/ACT"    , "narrator": "", "text": "でも"},
        { "location": "1093/TALK"   , "narrator": "神楽", "text": "何？"},
        { "location": "1094/SEL"    , "narrator": "", "text": "神楽は派手なことが好きなんだって思ってた"},
        { "location": "1095/SEL"    , "narrator": "", "text": "意外とかわいいなって"},
        { "location": "1096/SEL"    , "narrator": "", "text": "地味すぎるかな…"},
        { "location": "1097/ACT"    , "narrator": "", "text": "神楽は派手なことが好きなんだって思ってた"},
        { "location": "1099/TALK"   , "narrator": "神楽", "text": "仕事には必要だけどね\nそういう要素も。"},
        { "location": "1100/ACT"    , "narrator": "", "text": "意外とかわいいなって"},
        { "location": "1102/TALK"   , "narrator": "神楽", "text": "意外とは余計でしょ！"},
        { "location": "1103/TALK"   , "narrator": "神楽", "text": "許してあげるけど。"},
        { "location": "1104/ACT"    , "narrator": "", "text": "地味すぎるかな…"},
        { "location": "1105/TALK"   , "narrator": "神楽", "text": "あれちょっと\n不満だった？"},
        { "location": "1107/SEL"    , "narrator": "", "text": "意外だったから"},
        { "location": "1108/SEL"    , "narrator": "", "text": "プライベートな神楽はこうなんだなって"},
        { "location": "1109/SEL"    , "narrator": "", "text": "やっぱりもうちょっと…"},
        { "location": "1110/ACT"    , "narrator": "", "text": "意外だったから"},
        { "location": "1111/TALK"   , "narrator": "神楽", "text": "ゲーノージンな\n私のことを\n知ってるから？"},
        { "location": "1112/ACT"    , "narrator": "", "text": "プライベートな神楽はこうなんだなって"},
        { "location": "1114/TALK"   , "narrator": "神楽", "text": "ふふ。"},
        { "location": "1115/TALK"   , "narrator": "神楽", "text": "まあね？"},
        { "location": "1116/ACT"    , "narrator": "", "text": "やっぱりもうちょっと…"},
        { "location": "1117/TALK"   , "narrator": "神楽", "text": "うーん……。\nそっかー。"},
        { "location": "1119/TALK"   , "narrator": "神楽", "text": "えっとねー？"},
        { "location": "1120/TALK"   , "narrator": "神楽", "text": "やろうと思えば\nできなくはないの。"},
        { "location": "1121/TALK"   , "narrator": "神楽", "text": "サプライズを\n仕込みまくった\n派手なお式も。"},
        { "location": "1122/TALK"   , "narrator": "神楽", "text": "でもそれって\n見せる相手がいないと\n始まらないから。"},
        { "location": "1123/TALK"   , "narrator": "神楽", "text": "いつか本当に会えたなら。\nその時にやらない？"},
        { "location": "1124/SEL"    , "narrator": "", "text": "そうだね"},
        { "location": "1125/SEL"    , "narrator": "", "text": "どういうやつ？"},
        { "location": "1126/SEL"    , "narrator": "", "text": "楽しみにしてる"},
        { "location": "1127/ACT"    , "narrator": "", "text": "そうだね"},
        { "location": "1129/TALK"   , "narrator": "神楽", "text": "ね？"},
        { "location": "1130/ACT"    , "narrator": "", "text": "どういうやつ？"},
        { "location": "1131/TALK"   , "narrator": "神楽", "text": "そうね……。"},
        { "location": "1132/ACT"    , "narrator": "", "text": "楽しみにしてる"},
        { "location": "1134/TALK"   , "narrator": "神楽", "text": "期待してて！"},
        { "location": "1150/TALK"   , "narrator": "ボイスメール", "text": "君さえいれば、世界はいらない"},
        { "location": "967/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>某月某日　1:26 PM</color>\nとある休日、江の島でのこと"},
        { "location": "1162/DIALOG" , "narrator": "Dialog_GETVoice", "text": "<color=green>【神楽】</color>のボイスメール\n<color=red>【君さえいれば、世界はいらない】</color>\nをゲットしました！"}
    ]
}
