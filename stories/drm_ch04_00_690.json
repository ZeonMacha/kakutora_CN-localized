    "entry":
    [
        { "location": "144/SCENARIO", "narrator": "", "text": "590_まるでミントアイスのような"},
        { "location": "169/TALK"    , "narrator": "みやび", "text": "ミントアイスは"},
        { "location": "170/TALK"    , "narrator": "みやび", "text": "侮れんぞね"},
        { "location": "172/SEL"     , "narrator": "", "text": "おいしいよね"},
        { "location": "173/SEL"     , "narrator": "", "text": "苦手かな"},
        { "location": "174/SEL"     , "narrator": "", "text": "あの不思議さが癖になるよね"},
        { "location": "175/ACT"     , "narrator": "", "text": "おいしいよね"},
        { "location": "176/TALK"    , "narrator": "みやび", "text": "うむ"},
        { "location": "177/ACT"     , "narrator": "", "text": "苦手かな"},
        { "location": "178/TALK"    , "narrator": "みやび", "text": "それは残念"},
        { "location": "179/ACT"     , "narrator": "", "text": "あの不思議さが癖になるよね"},
        { "location": "189/TALK"    , "narrator": "みやび", "text": "そう"},
        { "location": "191/TALK"    , "narrator": "みやび", "text": "わかっとる"},
        { "location": "192/TALK"    , "narrator": "みやび", "text": "わかっとるね"},
        { "location": "194/TALK"    , "narrator": "みやび", "text": "なんというか"},
        { "location": "195/TALK"    , "narrator": "みやび", "text": "どう考えても甘いものに合わないあの強引な清涼感"},
        { "location": "196/TALK"    , "narrator": "みやび", "text": "どう見ても体に悪そうなあの色"},
        { "location": "197/TALK"    , "narrator": "みやび", "text": "食べた後に残る不思議な後味"},
        { "location": "198/TALK"    , "narrator": "みやび", "text": "しかしいつしか気になってしまうその魔力"},
        { "location": "199/TALK"    , "narrator": "みやび", "text": "何かに似ておると思っておった"},
        { "location": "201/SEL"     , "narrator": "", "text": "何に似てたの？"},
        { "location": "202/SEL"     , "narrator": "", "text": "$me$だよね"},
        { "location": "203/SEL"     , "narrator": "", "text": "ミントアイスはミントアイスでしょ"},
        { "location": "204/ACT"     , "narrator": "", "text": "何に似てたの？"},
        { "location": "205/TALK"    , "narrator": "みやび", "text": "そんなことも"},
        { "location": "206/TALK"    , "narrator": "みやび", "text": "わからんのか"},
        { "location": "207/TALK"    , "narrator": "みやび", "text": "ばかちんが"},
        { "location": "208/ACT"     , "narrator": "", "text": "$me$だよね"},
        { "location": "209/TALK"    , "narrator": "みやび", "text": "よく言った"},
        { "location": "210/TALK"    , "narrator": "みやび", "text": "その通りだ"},
        { "location": "211/TALK"    , "narrator": "みやび", "text": "愛いやつめ"},
        { "location": "212/ACT"     , "narrator": "", "text": "ミントアイスはミントアイスでしょ"},
        { "location": "213/TALK"    , "narrator": "みやび", "text": "行間の読めんやつめ"},
        { "location": "215/TALK"    , "narrator": "みやび", "text": "それでこそ"},
        { "location": "216/TALK"    , "narrator": "みやび", "text": "$handle$だな"},
        { "location": "218/TALK"    , "narrator": "みやび", "text": "なお"},
        { "location": "219/TALK"    , "narrator": "みやび", "text": "うちにとってのミントアイスとは"},
        { "location": "220/TALK"    , "narrator": "みやび", "text": "こういうものぞね"},
        { "location": "223/TALK"    , "narrator": "ボイスメール", "text": "ロッキーロード・チョコレート"},
        { "location": "185/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>1000pt.</b></color></size>\nアップしました！"},
        { "location": "235/DIALOG"  , "narrator": "Dialog_GETVoice", "text": "<color=green>【みやび】</color>のボイスメール\n<color=red>【ロッキーロード・チョコレート】</color>\nをゲットしました！"}
    ]
}
