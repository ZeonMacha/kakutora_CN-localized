{
    "dir": "chap06/daydra/dd_ch05_06_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "6505",
        "cid": "kagura",
        "title": "005 メインストーリー",
        "sub_title": "戦略的サボタージュ＜後編＞"
    },
    "entry":
    [
        { "location": "2770/SEL"   , "narrator": "", "text": "まだ不安？"},
        { "location": "2771/ACT"   , "narrator": "", "text": "まだ不安？"},
        { "location": "2773/TALK"  , "narrator": "神楽", "text": "まだ？"},
        { "location": "2774/TALK"  , "narrator": "神楽", "text": "今不安って話をしてるのに"},
        { "location": "2775/TALK"  , "narrator": "神楽", "text": "変わらず不安でいっぱいですよ"},
        { "location": "2778/TALK"  , "narrator": "神楽", "text": "でも"},
        { "location": "2780/TALK"  , "narrator": "神楽", "text": "やります"},
        { "location": "2781/TALK"  , "narrator": "神楽", "text": "それが私に与えられた任務で"},
        { "location": "2782/TALK"  , "narrator": "神楽", "text": "私自身のためにも"},
        { "location": "2783/TALK"  , "narrator": "神楽", "text": "やらなければならないこと"},
        { "location": "2784/TALK"  , "narrator": "神楽", "text": "なのです"},
        { "location": "2785/TALK"  , "narrator": "神楽", "text": "それに先延ばしにしたところで"},
        { "location": "2786/TALK"  , "narrator": "神楽", "text": "今日中に会うのは避けられません"},
        { "location": "2787/TALK"  , "narrator": "神楽", "text": "ならば少しでも早く会って"},
        { "location": "2788/TALK"  , "narrator": "神楽", "text": "逢瀬つばめに慣れた方がいい"},
        { "location": "2789/TALK"  , "narrator": "神楽", "text": "そう判断したわけで"},
        { "location": "2791/SEL"   , "narrator": "", "text": "神楽は強いね"},
        { "location": "2792/SEL"   , "narrator": "", "text": "警戒しすぎだよ"},
        { "location": "2793/SEL"   , "narrator": "", "text": "つばめはいい子だよ"},
        { "location": "2794/ACT"   , "narrator": "", "text": "神楽は強いね"},
        { "location": "2795/TALK"  , "narrator": "神楽", "text": "そう見えます？"},
        { "location": "2797/TALK"  , "narrator": "神楽", "text": "でもまだまだです"},
        { "location": "2798/TALK"  , "narrator": "神楽", "text": "本当に強いなら"},
        { "location": "2799/TALK"  , "narrator": "神楽", "text": "こんなウジウジしなかったし"},
        { "location": "2800/ACT"   , "narrator": "", "text": "警戒しすぎだよ"},
        { "location": "2801/TALK"  , "narrator": "神楽", "text": "油断して失敗する"},
        { "location": "2802/TALK"  , "narrator": "神楽", "text": "なんてことになるよりはマシ"},
        { "location": "2803/TALK"  , "narrator": "神楽", "text": "そう思ってるだけですよ"},
        { "location": "2804/ACT"   , "narrator": "", "text": "つばめはいい子だよ"},
        { "location": "2805/TALK"  , "narrator": "神楽", "text": "はい？"},
        { "location": "2806/TALK"  , "narrator": "神楽", "text": "いやこの流れで突然なにを言い出すのかと思えば"},
        { "location": "2808/TALK"  , "narrator": "神楽", "text": "ドームでの彼女のことを見ればわかると思うけど？"},
        { "location": "2810/SEL"   , "narrator": "", "text": "神楽を助けようとしてた"},
        { "location": "2811/SEL"   , "narrator": "", "text": "正当防衛だと思うけど？"},
        { "location": "2812/ACT"   , "narrator": "", "text": "神楽を助けようとしてた"},
        { "location": "2814/TALK"  , "narrator": "神楽", "text": "それは"},
        { "location": "2815/TALK"  , "narrator": "神楽", "text": "多分メノウだからであって"},
        { "location": "2816/TALK"  , "narrator": "神楽", "text": "自分が好きなアーティストだから"},
        { "location": "2817/ACT"   , "narrator": "", "text": "正当防衛だと思うけど？"},
        { "location": "2819/TALK"  , "narrator": "神楽", "text": "だとしたら"},
        { "location": "2820/TALK"  , "narrator": "神楽", "text": "彼女の冷徹さは恐るべきモノですよ"},
        { "location": "2821/TALK"  , "narrator": "神楽", "text": "あんなすぐに終わらせられる力を持っていながら"},
        { "location": "2822/TALK"  , "narrator": "神楽", "text": "あれだけ状況を長引かせたのだから"},
        { "location": "2825/TALK"  , "narrator": "神楽", "text": "本当"},
        { "location": "2826/TALK"  , "narrator": "神楽", "text": "遊んでいたのかもしれませんね"},
        { "location": "2828/SEL"   , "narrator": "", "text": "違っても、神楽はつばめを壊せる？"},
        { "location": "2829/ACT"   , "narrator": "", "text": "違っても、神楽はつばめを壊せる？"},
        { "location": "2832/TALK"  , "narrator": "神楽", "text": "やめて"},
        { "location": "2833/TALK"  , "narrator": "神楽", "text": "やっと不安を押さえ込んだのに"},
        { "location": "2836/TALK"  , "narrator": "神楽", "text": "考えさせないで"},
        { "location": "2837/TALK"  , "narrator": "神楽", "text": "そんな"},
        { "location": "2838/TALK"  , "narrator": "神楽", "text": "絶対にあってほしくないことを"},
        { "location": "2849/TALK"  , "narrator": "神楽", "text": "…逢瀬つばめが、\n私の思っているような\n子じゃないなんて――"},
        { "location": "2852/TALK"  , "narrator": "神楽", "text": "ダメ、そんな余計なことを\n今考えたら…。"},
        { "location": "2853/TALK"  , "narrator": "神楽", "text": "事実がどうあれ、\nやらないわけには\nいかないんだから…。"},
        { "location": "2856/TALK"  , "narrator": "神楽", "text": "とはいえ問題はまだあって"},
        { "location": "2857/TALK"  , "narrator": "神楽", "text": "どうやって近づくべきか？"},
        { "location": "2858/TALK"  , "narrator": "神楽", "text": "やはり時間をかけて"},
        { "location": "2859/TALK"  , "narrator": "神楽", "text": "一歩ずつ近づいていくべき？"},
        { "location": "2860/TALK"  , "narrator": "神楽", "text": "それとも"},
        { "location": "2861/TALK"  , "narrator": "神楽", "text": "いきなり超フレンドリーモードとか？"},
        { "location": "2862/SEL"   , "narrator": "", "text": "普通で大丈夫だよ"},
        { "location": "2863/ACT"   , "narrator": "", "text": "普通で大丈夫だよ"},
        { "location": "2865/TALK"  , "narrator": "神楽", "text": "普通って"},
        { "location": "2868/TALK"  , "narrator": "神楽", "text": "まあ"},
        { "location": "2869/TALK"  , "narrator": "神楽", "text": "参考にさせていただきます"},
        { "location": "2870/TALK"  , "narrator": "神楽", "text": "それじゃあそろそろ"},
        { "location": "2871/TALK"  , "narrator": "神楽", "text": "迎えが来るんで"},
        { "location": "2872/TALK"  , "narrator": "神楽", "text": "一度落ちますね"},
        { "location": "2883/TALK"  , "narrator": "神楽", "text": "…まったく。"},
        { "location": "2885/TALK"  , "narrator": "神楽", "text": "普通ってなによ？\n説明下手にもほどがある、\nってものよ。"},
        { "location": "2886/TALK"  , "narrator": "神楽", "text": "まさか、他人事だと\n思われてる…とか？"},
        { "location": "2887/TALK"  , "narrator": "神楽", "text": "…まあ、私以外には\n関係ない話よね。"},
        { "location": "2889/TALK"  , "narrator": "神楽", "text": "ふぅ…気持ち、切り替えて\nいかなきゃ…。"},
        { "location": "2890/TALK"  , "narrator": "神楽", "text": "私の目的――"},
        { "location": "2891/TALK"  , "narrator": "神楽", "text": "逢瀬つばめの、\n心を、破壊するまでは…。"},
        { "location": "2901/DIALOG", "narrator": "Dialog_chapter_ch05", "text": "【04 レッドサイト】"},
        { "location": "2912/DIALOG", "narrator": "Dialog_chapter_ch05", "text": "【04 レッドサイト】"}
    ]
}
