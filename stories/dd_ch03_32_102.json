{
    "dir": "chap32/daydra/dd_ch03_32_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "32305",
        "cid": "gabriella",
        "title": "005 メインストーリー",
        "sub_title": "偶然は運命にも似て＜後編＞"
    },
    "entry":
    [
        { "location": "619/TALK"  , "narrator": "ガブリエラ", "text": "あたし……。"},
        { "location": "620/SEL"   , "narrator": "", "text": "ガブリエラ？"},
        { "location": "621/SEL"   , "narrator": "", "text": "気をしっかり持って"},
        { "location": "622/SEL"   , "narrator": "", "text": "できることがあるはずだよ"},
        { "location": "623/ACT"   , "narrator": "", "text": "ガブリエラ？"},
        { "location": "624/ACT"   , "narrator": "", "text": "気をしっかり持って"},
        { "location": "625/ACT"   , "narrator": "", "text": "できることがあるはずだよ"},
        { "location": "630/TALK"  , "narrator": "みやび", "text": "最初はアレやったけんど\n意外と安全運転やねえ。"},
        { "location": "633/TALK"  , "narrator": "アーヤ", "text": "でもスピード違反よ！"},
        { "location": "635/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "636/SEL"   , "narrator": "", "text": "おーい"},
        { "location": "637/SEL"   , "narrator": "", "text": "しっかりして"},
        { "location": "638/SEL"   , "narrator": "", "text": "聞こえてる？"},
        { "location": "639/ACT"   , "narrator": "", "text": "おーい"},
        { "location": "640/ACT"   , "narrator": "", "text": "しっかりして"},
        { "location": "641/ACT"   , "narrator": "", "text": "聞こえてる？"},
        { "location": "645/TALK"  , "narrator": "みやび", "text": "アーヤの方がよっぽど\n運転荒いきね。"},
        { "location": "647/TALK"  , "narrator": "アーヤ", "text": "そ、そんなこと\nないわよ！"},
        { "location": "648/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "649/SEL"   , "narrator": "", "text": "ガブ！"},
        { "location": "650/SEL"   , "narrator": "", "text": "ガブリエラはできる子だよね"},
        { "location": "651/SEL"   , "narrator": "", "text": "まず現実を把握しよう"},
        { "location": "652/ACT"   , "narrator": "", "text": "ガブ！"},
        { "location": "656/TALK"  , "narrator": "ガブリエラ", "text": "！"},
        { "location": "662/TALK"  , "narrator": "ガブリエラ", "text": "私今ま"},
        { "location": "663/TALK"  , "narrator": "ガブリエラ", "text": "ぼんやらしてて"},
        { "location": "665/ACT"   , "narrator": "", "text": "ガブリエラはできる子だよね"},
        { "location": "669/TALK"  , "narrator": "ガブリエラ", "text": "！"},
        { "location": "675/TALK"  , "narrator": "ガブリエラ", "text": "でも今ま"},
        { "location": "676/TALK"  , "narrator": "ガブリエラ", "text": "何をすればいあかわからなかて"},
        { "location": "678/ACT"   , "narrator": "", "text": "まず現実を把握しよう"},
        { "location": "682/TALK"  , "narrator": "ガブリエラ", "text": "！"},
        { "location": "688/TALK"  , "narrator": "ガブリエラ", "text": "えと"},
        { "location": "689/TALK"  , "narrator": "ガブリエラ", "text": "どうなったる"},
        { "location": "692/TALK"  , "narrator": "ガブリエラ", "text": "私"},
        { "location": "693/TALK"  , "narrator": "ガブリエラ", "text": "みんなよら"},
        { "location": "694/TALK"  , "narrator": "ガブリエラ", "text": "慣れてるたもりななに"},
        { "location": "696/TALK"  , "narrator": "ガブリエラ", "text": "全ぜん"},
        { "location": "697/TALK"  , "narrator": "ガブリエラ", "text": "そんなの"},
        { "location": "698/TALK"  , "narrator": "ガブリエラ", "text": "意味がなくたて"},
        { "location": "700/SEL"   , "narrator": "", "text": "そんなことないよ"},
        { "location": "701/SEL"   , "narrator": "", "text": "誰だって同じだよ"},
        { "location": "702/SEL"   , "narrator": "", "text": "自覚があるならこの先は平気さ"},
        { "location": "703/ACT"   , "narrator": "", "text": "そんなことないよ"},
        { "location": "704/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$は優しいあ"},
        { "location": "705/TALK"  , "narrator": "ガブリエラ", "text": "いつだて"},
        { "location": "707/ACT"   , "narrator": "", "text": "誰だって同じだよ"},
        { "location": "708/TALK"  , "narrator": "ガブリエラ", "text": "みんなそう・！、？"},
        { "location": "709/TALK"  , "narrator": "ガブリエラ", "text": "だったら私もかんはらなき"},
        { "location": "711/ACT"   , "narrator": "", "text": "自覚があるならこの先は平気さ"},
        { "location": "712/TALK"  , "narrator": "ガブリエラ", "text": "厳しいわ"},
        { "location": "713/TALK"  , "narrator": "ガブリエラ", "text": "でも正しいい"},
        { "location": "716/SEL"   , "narrator": "", "text": "ポーランドのこと思い出してみて"},
        { "location": "717/SEL"   , "narrator": "", "text": "向こうではどうやって暮らしてた？"},
        { "location": "718/SEL"   , "narrator": "", "text": "ピンチの時はどうやってかわしてきたっけ"},
        { "location": "719/ACT"   , "narrator": "", "text": "ポーランドのこと思い出してみて"},
        { "location": "720/TALK"  , "narrator": "ガブリエラ", "text": "わかった"},
        { "location": "721/ACT"   , "narrator": "", "text": "向こうではどうやって暮らしてた？"},
        { "location": "722/TALK"  , "narrator": "ガブリエラ", "text": "ポーランドにあたとき？"},
        { "location": "723/ACT"   , "narrator": "", "text": "ピンチの時はどうやってかわしてきたっけ"},
        { "location": "724/TALK"  , "narrator": "ガブリエラ", "text": "戦場でって"},
        { "location": "728/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "729/TALK"  , "narrator": "ガブリエラ", "text": "！！！！"},
        { "location": "731/TALK"  , "narrator": "ガブリエラ", "text": "……ひどいことを\n思い出したわ…。"},
        { "location": "732/SEL"   , "narrator": "", "text": "何かごめん"},
        { "location": "733/ACT"   , "narrator": "", "text": "何かごめん"},
        { "location": "738/TALK"  , "narrator": "ガブリエラ", "text": "え"},
        { "location": "739/TALK"  , "narrator": "ガブリエラ", "text": "どうして謝るの"},
        { "location": "741/SEL"   , "narrator": "", "text": "辛そうだったから"},
        { "location": "742/SEL"   , "narrator": "", "text": "哀しそうな顔になったから"},
        { "location": "743/SEL"   , "narrator": "", "text": "いやなこと思い出させて"},
        { "location": "744/ACT"   , "narrator": "", "text": "辛そうだったから"},
        { "location": "745/TALK"  , "narrator": "ガブリエラ", "text": "それは"},
        { "location": "746/ACT"   , "narrator": "", "text": "哀しそうな顔になったから"},
        { "location": "747/TALK"  , "narrator": "ガブリエラ", "text": "見られちゃったかしら"},
        { "location": "748/ACT"   , "narrator": "", "text": "いやなこと思い出させて"},
        { "location": "749/TALK"  , "narrator": "ガブリエラ", "text": "気にしないで"},
        { "location": "751/TALK"  , "narrator": "ガブリエラ", "text": "お母さんのこと"},
        { "location": "752/TALK"  , "narrator": "ガブリエラ", "text": "一瞬思い出したの"},
        { "location": "753/TALK"  , "narrator": "ガブリエラ", "text": "でもそれは"},
        { "location": "754/TALK"  , "narrator": "ガブリエラ", "text": "終わったこと"},
        { "location": "755/TALK"  , "narrator": "ガブリエラ", "text": "それより私"},
        { "location": "756/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$のおかげで"},
        { "location": "757/TALK"  , "narrator": "ガブリエラ", "text": "思い出せたわ"},
        { "location": "758/TALK"  , "narrator": "ガブリエラ", "text": "戦場での気持ち"},
        { "location": "759/TALK"  , "narrator": "ガブリエラ", "text": "生きるのに大事なこと"},
        { "location": "761/SEL"   , "narrator": "", "text": "それはよかった"},
        { "location": "762/SEL"   , "narrator": "", "text": "役に立てたみたいだ"},
        { "location": "763/SEL"   , "narrator": "", "text": "それでこそガブリエラ"},
        { "location": "764/ACT"   , "narrator": "", "text": "それはよかった"},
        { "location": "765/TALK"  , "narrator": "ガブリエラ", "text": "ええ"},
        { "location": "766/ACT"   , "narrator": "", "text": "役に立てたみたいだ"},
        { "location": "767/TALK"  , "narrator": "ガブリエラ", "text": "もちろんよ"},
        { "location": "768/ACT"   , "narrator": "", "text": "それでこそガブリエラ"},
        { "location": "769/TALK"  , "narrator": "ガブリエラ", "text": "ありがとう"},
        { "location": "771/TALK"  , "narrator": "ガブリエラ", "text": "生き残るには"},
        { "location": "772/TALK"  , "narrator": "ガブリエラ", "text": "全力を傾けないとダメ"},
        { "location": "773/TALK"  , "narrator": "ガブリエラ", "text": "それが一縷の望みでも"},
        { "location": "774/TALK"  , "narrator": "ガブリエラ", "text": "戦うわ私"},
        { "location": "775/TALK"  , "narrator": "ガブリエラ", "text": "私自身と$marzanna$のために"},
        { "location": "782/TALK"  , "narrator": "アーヤ", "text": "二人とも。"},
        { "location": "783/TALK"  , "narrator": "アーヤ", "text": "アーケロンに\n何を積んだか\n憶えてる？"},
        { "location": "784/TALK"  , "narrator": "ガブリエラ", "text": "武器。\n対人用の武器を\n大量に積んだわ。"},
        { "location": "785/TALK"  , "narrator": "みやび", "text": "あとは音羽やね。"},
        { "location": "786/TALK"  , "narrator": "アーヤ", "text": "後は？"},
        { "location": "788/TALK"  , "narrator": "みやび", "text": "あ。"},
        { "location": "789/TALK"  , "narrator": "みやび", "text": "元々の装備に\n脱出用のポッドがある\nはずやけんど。"},
        { "location": "791/TALK"  , "narrator": "ガブリエラ", "text": "それ！\nまさに今\n使うものじゃない！？"},
        { "location": "792/TALK"  , "narrator": "アーヤ", "text": "じゃあポッドで…。"},
        { "location": "794/TALK"  , "narrator": "みやび", "text": "けんど、ポッドも\n乗っ取られとる\n可能性がある。"},
        { "location": "795/TALK"  , "narrator": "アーヤ", "text": "あ…。"},
        { "location": "797/TALK"  , "narrator": "ガブリエラ", "text": "じゃあここから\n脱出するには\n飛び降りるしかないの？"},
        { "location": "800/TALK"  , "narrator": "アーヤ", "text": "１２０キロ出てるのよ？\nそんなことしたら…！"},
        { "location": "802/TALK"  , "narrator": "ガブリエラ", "text": "そんな……。\n$handle$と約束した\nばかりなのに……。"},
        { "location": "803/TALK"  , "narrator": "アーヤ", "text": "あ！"},
        { "location": "806/TALK"  , "narrator": "アーヤ", "text": "トライコネクト！\nこれを脱出の手段に\n使えないかしら？"},
        { "location": "808/TALK"  , "narrator": "ガブリエラ", "text": "え？\nそんなことできるの？"},
        { "location": "809/TALK"  , "narrator": "みやび", "text": "…確かに。\n今ならできるね。"},
        { "location": "810/TALK"  , "narrator": "みやび", "text": "音羽用にシステムを\n改造したき。"},
        { "location": "811/TALK"  , "narrator": "みやび", "text": "けんど、それだけ\nやったら敵の目を\n欺けんかもしれん。"},
        { "location": "813/TALK"  , "narrator": "ガブリエラ", "text": "敵の目を逸らさせれば\nいいのよね。\nだったら……。"},
        { "location": "815/TALK"  , "narrator": "ガブリエラ", "text": "それなら脱出ポッドを\n使うのはどう？"},
        { "location": "817/TALK"  , "narrator": "アーヤ", "text": "…いい手ね。私達が\n乗ってると思わせれば\nいいんじゃない。"},
        { "location": "818/TALK"  , "narrator": "みやび", "text": "さすがに爆発は\nさせられんかね。"},
        { "location": "819/TALK"  , "narrator": "ガブリエラ", "text": "ポッドを？"},
        { "location": "820/TALK"  , "narrator": "みやび", "text": "ただ射出された\nだけやったら\nすぐに鹵獲されるき。"},
        { "location": "822/TALK"  , "narrator": "みやび", "text": "爆発できるなら\n現場の混乱も狙えるし。"},
        { "location": "823/TALK"  , "narrator": "アーヤ", "text": "救命のためのものだから\nそう簡単には\n壊せないわ。"},
        { "location": "825/TALK"  , "narrator": "ガブリエラ", "text": "確かにその通り。\nでも諦めないで。\n考えて、あたし。"},
        { "location": "827/TALK"  , "narrator": "ガブリエラ", "text": "だったら壊れたように\n見せかければいいのよ。"},
        { "location": "828/TALK"  , "narrator": "ガブリエラ", "text": "積み込んだ武器の中に\n発煙手榴弾がある。\nこれを使えばいいわ。"},
        { "location": "830/TALK"  , "narrator": "みやび", "text": "煙はどのくらい\n広がるもんなんかね？"},
        { "location": "832/TALK"  , "narrator": "ガブリエラ", "text": "ここにあるものを\n全部ポッドに\nぶち込んだなら。"},
        { "location": "833/TALK"  , "narrator": "ガブリエラ", "text": "ざっと１００ｍと\nいったところかしら。"},
        { "location": "834/TALK"  , "narrator": "アーヤ", "text": "そんなに！？"},
        { "location": "835/TALK"  , "narrator": "みやび", "text": "派手やねえ。\n気に入った。"},
        { "location": "837/TALK"  , "narrator": "みやび", "text": "じゃ、うちは起爆用の\nリモコンでも\n作ろうかね。"},
        { "location": "840/TALK"  , "narrator": "ガブリエラ", "text": "発煙手榴弾の\n設置は任せて。"},
        { "location": "841/TALK"  , "narrator": "アーヤ", "text": "じゃあ私は\nトライコネクトの\n確認をしておくわね。"},
        { "location": "842/TALK"  , "narrator": "ガブリエラ", "text": "大丈夫。\nあたしはやれる。\nみんなの役に立てる。"},
        { "location": "846/TALK"  , "narrator": "ガブリエラ", "text": "ねえ"},
        { "location": "847/TALK"  , "narrator": "ガブリエラ", "text": "私もうひとつ"},
        { "location": "848/TALK"  , "narrator": "ガブリエラ", "text": "思い出したの"},
        { "location": "849/TALK"  , "narrator": "ガブリエラ", "text": "ポーランドでのこと"},
        { "location": "851/SEL"   , "narrator": "", "text": "どんなこと？"},
        { "location": "852/SEL"   , "narrator": "", "text": "聞いてもいいの？"},
        { "location": "853/SEL"   , "narrator": "", "text": "教えてよ"},
        { "location": "854/ACT"   , "narrator": "", "text": "どんなこと？"},
        { "location": "855/TALK"  , "narrator": "ガブリエラ", "text": "アーヤのこと"},
        { "location": "856/ACT"   , "narrator": "", "text": "聞いてもいいの？"},
        { "location": "857/TALK"  , "narrator": "ガブリエラ", "text": "もちろんよ"},
        { "location": "858/ACT"   , "narrator": "", "text": "教えてよ"},
        { "location": "859/TALK"  , "narrator": "ガブリエラ", "text": "聞いて欲しいわ"},
        { "location": "862/TALK"  , "narrator": "ガブリエラ", "text": "明鏡止水のココロって"},
        { "location": "863/TALK"  , "narrator": "ガブリエラ", "text": "言葉を実感したのは"},
        { "location": "864/TALK"  , "narrator": "ガブリエラ", "text": "決勝戦のアーヤを見た時なの"},
        { "location": "865/TALK"  , "narrator": "ガブリエラ", "text": "本当に強い人間は"},
        { "location": "866/TALK"  , "narrator": "ガブリエラ", "text": "勝ちが絶対に必要な時は"},
        { "location": "867/TALK"  , "narrator": "ガブリエラ", "text": "凪の心で挑むのよ"},
        { "location": "869/SEL"   , "narrator": "", "text": "そうだね"},
        { "location": "870/SEL"   , "narrator": "", "text": "そうなんだ"},
        { "location": "871/SEL"   , "narrator": "", "text": "ガブリエラもその心で挑むんでしょ"},
        { "location": "872/ACT"   , "narrator": "", "text": "そうだね"},
        { "location": "873/TALK"  , "narrator": "ガブリエラ", "text": "思い出させてくれて"},
        { "location": "874/TALK"  , "narrator": "ガブリエラ", "text": "ありがとう$marzanna$"},
        { "location": "875/ACT"   , "narrator": "", "text": "そうなんだ"},
        { "location": "876/TALK"  , "narrator": "ガブリエラ", "text": "そういうものよね"},
        { "location": "877/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$がいなかったら"},
        { "location": "878/TALK"  , "narrator": "ガブリエラ", "text": "思い出せなかったわ"},
        { "location": "879/ACT"   , "narrator": "", "text": "ガブリエラもその心で挑むんでしょ"},
        { "location": "880/TALK"  , "narrator": "ガブリエラ", "text": "当然よ"},
        { "location": "881/TALK"  , "narrator": "ガブリエラ", "text": "まだまだアーヤの境地には"},
        { "location": "883/TALK"  , "narrator": "ガブリエラ", "text": "なれないけど"},
        { "location": "918/TALK"  , "narrator": "ガブリエラ", "text": "みやび、準備は\nどうなのよ？"},
        { "location": "920/TALK"  , "narrator": "みやび", "text": "脱出ポッドの\n射出準備ならとっくに\nできちゅうき。"},
        { "location": "921/TALK"  , "narrator": "みやび", "text": "それより二人は\nコネクトこじゃんと\nせんといかんよ。"},
        { "location": "922/TALK"  , "narrator": "アーヤ", "text": "もちろんよ。"},
        { "location": "923/TALK"  , "narrator": "ガブリエラ", "text": "当たり前でしょ。"},
        { "location": "924/TALK"  , "narrator": "アーヤ", "text": "それよりやっぱり\nスピードを落とす気は\nないみたいよ。"},
        { "location": "925/TALK"  , "narrator": "アーヤ", "text": "このまま文京ドームに\n突っ込ませる気\n満々ね。"},
        { "location": "926/TALK"  , "narrator": "みやび", "text": "脱出のタイミングは\nさっきの打ち合わせ\n通りに頼むちや。"},
        { "location": "927/TALK"  , "narrator": "ガブリエラ", "text": "オッケー。"},
        { "location": "928/TALK"  , "narrator": "アーヤ", "text": "何かあったら\nフォローするわ。"},
        { "location": "929/TALK"  , "narrator": "アーヤ", "text": "でも私、二人のこと\n信じてるから。"},
        { "location": "931/TALK"  , "narrator": "みやび", "text": "…泣かせるね。\nさすがはリーダーやき。"},
        { "location": "932/TALK"  , "narrator": "アーヤ", "text": "からかわないで。"},
        { "location": "938/TALK"  , "narrator": "みやび", "text": "…ＧＰＳ脱出目標まで\n１００ｍ。"},
        { "location": "939/TALK"  , "narrator": "みやび", "text": "５０ｍ。"},
        { "location": "941/TALK"  , "narrator": "ガブリエラ", "text": "絶対にまた\n生きて会いましょう\n$handle$。"},
        { "location": "942/TALK"  , "narrator": "みやび", "text": "３０ｍ。"},
        { "location": "943/TALK"  , "narrator": "みやび", "text": "２０ｍ。"},
        { "location": "944/TALK"  , "narrator": "ガブリエラ", "text": "あたしの神様。\nそれから――"},
        { "location": "945/TALK"  , "narrator": "みやび", "text": "１０ｍ。"},
        { "location": "946/TALK"  , "narrator": "ガブリエラ", "text": "一番大切な人……。"},
