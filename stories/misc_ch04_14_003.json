    "entry":
    [
        { "location": "180/SCENARIO", "narrator": "", "text": "05_000_天気誤報、天気後報"},
        { "location": "205/TALK"    , "narrator": "みやび", "text": "現在の天気予報の的中率は"},
        { "location": "206/TALK"    , "narrator": "みやび", "text": "約86パーセント"},
        { "location": "207/TALK"    , "narrator": "みやび", "text": "ぞね"},
        { "location": "209/SEL"     , "narrator": "", "text": "結構当たるもんだね"},
        { "location": "210/SEL"     , "narrator": "", "text": "意外と低いかも"},
        { "location": "211/SEL"     , "narrator": "", "text": "$me$ならひゃくパーだよ！"},
        { "location": "212/ACT"     , "narrator": "", "text": "結構当たるもんだね"},
        { "location": "213/TALK"    , "narrator": "みやび", "text": "そうかもしらん"},
        { "location": "214/ACT"     , "narrator": "", "text": "意外と低いかも"},
        { "location": "215/TALK"    , "narrator": "みやび", "text": "そうとも言える"},
        { "location": "216/ACT"     , "narrator": "", "text": "$me$ならひゃくパーだよ！"},
        { "location": "218/TALK"    , "narrator": "みやび", "text": "何を根拠に"},
        { "location": "219/TALK"    , "narrator": "みやび", "text": "そんな高水準値を叩きだすのか"},
        { "location": "220/TALK"    , "narrator": "みやび", "text": "言ってみるがいい"},
        { "location": "222/TALK"    , "narrator": "みやび", "text": "100点満点のテストならば"},
        { "location": "223/TALK"    , "narrator": "みやび", "text": "かなりの好成績といえよう"},
        { "location": "224/TALK"    , "narrator": "みやび", "text": "しかしだ"},
        { "location": "225/TALK"    , "narrator": "みやび", "text": "当たりか外れかという視点で見れば"},
        { "location": "226/TALK"    , "narrator": "みやび", "text": "何もしなくても50パーセントには達するのだ"},
        { "location": "228/SEL"     , "narrator": "", "text": "せやな"},
        { "location": "229/SEL"     , "narrator": "", "text": "今気が付いた"},
        { "location": "230/SEL"     , "narrator": "", "text": "統計マジック"},
        { "location": "231/ACT"     , "narrator": "", "text": "せやな"},
        { "location": "232/TALK"    , "narrator": "みやび", "text": "せやで"},
        { "location": "235/ACT"     , "narrator": "", "text": "今気が付いた"},
        { "location": "236/TALK"    , "narrator": "みやび", "text": "さよけ"},
        { "location": "237/ACT"     , "narrator": "", "text": "統計マジック"},
        { "location": "238/TALK"    , "narrator": "みやび", "text": "そこまでの"},
        { "location": "239/TALK"    , "narrator": "みやび", "text": "策は弄してないぞ"},
        { "location": "240/TALK"    , "narrator": "みやび", "text": "残念ながら"},
        { "location": "242/TALK"    , "narrator": "みやび", "text": "しかしここに驚異の100パーセントの秘策がある"},
        { "location": "244/SEL"     , "narrator": "", "text": "へー"},
        { "location": "245/SEL"     , "narrator": "", "text": "またまた"},
        { "location": "246/SEL"     , "narrator": "", "text": "言ってみて"},
        { "location": "247/ACT"     , "narrator": "", "text": "へー"},
        { "location": "248/TALK"    , "narrator": "みやび", "text": "ほうよ"},
        { "location": "249/ACT"     , "narrator": "", "text": "またまた"},
        { "location": "250/TALK"    , "narrator": "みやび", "text": "いやいや"},
        { "location": "251/ACT"     , "narrator": "", "text": "言ってみて"},
        { "location": "252/TALK"    , "narrator": "みやび", "text": "ならば言おう"},
        { "location": "254/TALK"    , "narrator": "みやび", "text": "天気が確定後に"},
        { "location": "255/TALK"    , "narrator": "みやび", "text": "予報を出すのだ"},
        { "location": "258/SEL"     , "narrator": "", "text": "本気で言ってる？"},
        { "location": "259/SEL"     , "narrator": "", "text": "面白い冗談だね"},
        { "location": "260/SEL"     , "narrator": "", "text": "みやびは天才だ！"},
        { "location": "261/ACT"     , "narrator": "", "text": "本気で言ってる？"},
        { "location": "262/TALK"    , "narrator": "みやび", "text": "本気も本気"},
        { "location": "263/TALK"    , "narrator": "みやび", "text": "ということにしておこう"},
        { "location": "264/TALK"    , "narrator": "みやび", "text": "面白いから"},
        { "location": "265/ACT"     , "narrator": "", "text": "面白い冗談だね"},
        { "location": "266/TALK"    , "narrator": "みやび", "text": "冗談ではない"},
        { "location": "267/TALK"    , "narrator": "みやび", "text": "が"},
        { "location": "268/TALK"    , "narrator": "みやび", "text": "面白いならいいであろう"},
        { "location": "269/ACT"     , "narrator": "", "text": "みやびは天才だ！"},
        { "location": "271/TALK"    , "narrator": "みやび", "text": "せやろ"},
        { "location": "273/TALK"    , "narrator": "みやび", "text": "これで常に100％をキープぞね"},
        { "location": "274/TALK"    , "narrator": "みやび", "text": "なんて"},
        { "location": "275/TALK"    , "narrator": "みやび", "text": "わかりやすいおだてに乗ると思うなよ"},
        { "location": "276/TALK"    , "narrator": "みやび", "text": "とはいえ"},
        { "location": "277/TALK"    , "narrator": "みやび", "text": "普通に乗るけどな"}
    ]
}
