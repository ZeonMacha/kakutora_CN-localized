{
    "dir": "chap04/daydra/dd_ch04_04_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "4402",
        "cid": "miyabi",
        "title": "002 メインストーリー",
        "sub_title": "恋ヶ崎みやびという存在＜前編＞"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "みやび導入"},
        { "location": "34/TALK"   , "narrator": "ガブリエラ", "text": "うそっ…。"},
        { "location": "35/TALK"   , "narrator": "アーヤ", "text": "くっ…遅かった…。"},
        { "location": "36/TALK"   , "narrator": "みやび", "text": "…あんだけ見事に\n刺されちゃ、\n確実に死んでるか。"},
        { "location": "37/TALK"   , "narrator": "みやび", "text": "…………。"},
        { "location": "39/TALK"   , "narrator": "みやび", "text": "ああ…誰も抹茶ババロア\nゲットできんかったね。"},
        { "location": "42/TALK"   , "narrator": "ガブリエラ", "text": "っ！？"},
        { "location": "44/TALK"   , "narrator": "ガブリエラ", "text": "ちょっと、みやび！！\nそんなこと言ってる\n場合じゃないでしょ！？"},
        { "location": "45/TALK"   , "narrator": "みやび", "text": "いや、でもあれじゃ、\n確実に死んでるちや。"},
        { "location": "47/TALK"   , "narrator": "アーヤ", "text": "みやび、不謹慎なこと\n言わないで！！"},
        { "location": "53/TALK"   , "narrator": "みやび", "text": "はぁ…。"},
        { "location": "54/TALK"   , "narrator": "アーヤ", "text": "みやび…あなた正気！？"},
        { "location": "55/TALK"   , "narrator": "みやび", "text": "別に、そう慌てることも\nないやろ？"},
        { "location": "56/TALK"   , "narrator": "みやび", "text": "あの女の子も死んで\nしもうたようやし――"},
        { "location": "57/TALK"   , "narrator": "みやび", "text": "ちっくと、一息入れて\nから再開でえいやろ。"},
        { "location": "58/TALK"   , "narrator": "ガブリエラ", "text": "何で平気なの！？\n目の前で、人が――"},
        { "location": "59/TALK"   , "narrator": "ガブリエラ", "text": "あたし達みたいな\n女の子が殺されたのよ！？"},
        { "location": "60/TALK"   , "narrator": "みやび", "text": "いや、そう言われても――"},
        { "location": "61/TALK"   , "narrator": "みやび", "text": "今更人死にの一人二人\n出たところで、驚いたり\nショック受けてたら――"},
        { "location": "62/TALK"   , "narrator": "みやび", "text": "こんな仕事、\nやっちょれんが。\nなあ、まほさん？"},
        { "location": "66/TALK"   , "narrator": "真幌", "text": "…そうかもしれんな。"},
        { "location": "71/TALK"   , "narrator": "アーヤ", "text": "館長！？"},
        { "location": "72/TALK"   , "narrator": "真幌", "text": "どんな想いやスタイルで\nいようと、それはみやびの\n自由だ。"},
        { "location": "73/TALK"   , "narrator": "真幌", "text": "そこまでどうしろ\nこうしろと、命令も\n強制もできん。"},
        { "location": "74/TALK"   , "narrator": "みやび", "text": "そういうことや。"},
        { "location": "76/TALK"   , "narrator": "ガブリエラ", "text": "でも、これじゃ…。"},
        { "location": "77/TALK"   , "narrator": "真幌", "text": "だが！！"},
        { "location": "78/TALK"   , "narrator": "真幌", "text": "これは仕事だ。\nそして今は任務中だ。"},
        { "location": "79/TALK"   , "narrator": "真幌", "text": "想いもスタイルも\n強制はしないが、\n任務には全力で当たれ。"},
        { "location": "80/TALK"   , "narrator": "みやび", "text": "…………。"},
        { "location": "81/TALK"   , "narrator": "真幌", "text": "わかったな！？"},
        { "location": "84/TALK"   , "narrator": "みやび", "text": "らじゃ。"},
        { "location": "85/TALK"   , "narrator": "真幌", "text": "…以上だ。"},
        { "location": "89/TALK"   , "narrator": "みやび", "text": "はぁ…やってられんちや。"},
        { "location": "92/TALK"   , "narrator": "ガブリエラ", "text": "みやび！！\nあんたまだそんなこと！"},
        { "location": "94/TALK"   , "narrator": "アーヤ", "text": "ギャヴィ、作戦変更よ！\nとにかく接近するわ。"},
        { "location": "95/TALK"   , "narrator": "アーヤ", "text": "まだ、運が良ければ\n息があるかもしれない。"},
        { "location": "97/TALK"   , "narrator": "ガブリエラ", "text": "…わかった！！"},
        { "location": "100/TALK"  , "narrator": "みやび", "text": "…気が進まんなぁ。"},
        { "location": "101/TALK"  , "narrator": "みやび", "text": "…なんか、もう何もかも\nどうでもよくなってきた\nちや。"},
        { "location": "102/TALK"  , "narrator": "みやび", "text": "…ちっくと、休憩するか。"},
        { "location": "147/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "156/TALK"  , "narrator": "千羽鶴", "text": "[ココロスフィア]の説明は\n前に私がしてると思うけど\nもう一度聞く？"},
        { "location": "157/SEL"   , "narrator": "", "text": "はい"},
        { "location": "158/SEL"   , "narrator": "", "text": "いいえ"},
        { "location": "159/ACT"   , "narrator": "", "text": "はい"},
        { "location": "160/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "162/ACT"   , "narrator": "", "text": "いいえ"},
        { "location": "170/TALK"  , "narrator": "千羽鶴", "text": "ようこそ。"},
        { "location": "171/SEL"   , "narrator": "", "text": "ここは…精神世界？"},
        { "location": "172/ACT"   , "narrator": "", "text": "ここは…精神世界？"},
        { "location": "174/TALK"  , "narrator": "千羽鶴", "text": "そう。\nバトル説明で入ったのと\n同じ、精神世界。"},
        { "location": "175/TALK"  , "narrator": "千羽鶴", "text": "ここは、後ろにいる\n彼女、恋ヶ崎みやびの\n精神世界の入口――"},
        { "location": "176/TALK"  , "narrator": "千羽鶴", "text": "通称<color=red>【[ココロゲート]】</color>\nと呼ばれている場所。"},
        { "location": "177/TALK"  , "narrator": "千羽鶴", "text": "ここでは彼女は\nあなたと普通に\n対話できる。"},
        { "location": "178/TALK"  , "narrator": "千羽鶴", "text": "彼女の心に直接\n語りかけることで、\n心を動かすの。"},
        { "location": "179/TALK"  , "narrator": "千羽鶴", "text": "早速、\n彼女に話しかけてみて。"},
        { "location": "186/TALK"  , "narrator": "みやび", "text": "……"},
        { "location": "187/SEL"   , "narrator": "", "text": "あのー"},
        { "location": "188/ACT"   , "narrator": "", "text": "あのー"},
        { "location": "190/TALK"  , "narrator": "みやび", "text": "………"},
        { "location": "191/SEL"   , "narrator": "", "text": "すみませーん"},
        { "location": "192/ACT"   , "narrator": "", "text": "すみませーん"},
        { "location": "194/TALK"  , "narrator": "みやび", "text": "……　…"},
        { "location": "208/TALK"  , "narrator": "みやび", "text": "ふわあっ！"},
        { "location": "212/TALK"  , "narrator": "みやび", "text": "ひやぁぁっ！"},
        { "location": "216/TALK"  , "narrator": "みやび", "text": "ふごあぁぁっ！"},
        { "location": "223/TALK"  , "narrator": "みやび", "text": "はあああ……\nこじゃんと\nひせくったで～。"},
        { "location": "224/SEL"   , "narrator": "", "text": "？？？"},
        { "location": "225/ACT"   , "narrator": "", "text": "？？？"},
        { "location": "229/TALK"  , "narrator": "みやび", "text": "超ビックリした～\n…ちゅう意味や。"},
        { "location": "230/TALK"  , "narrator": "みやび", "text": "ふわぁぁ、\nそれにしても、\nあんた誰や？"},
        { "location": "231/SEL"   , "narrator": "", "text": "はじめまして。$handle$です"},
        { "location": "232/ACT"   , "narrator": "", "text": "はじめまして。$handle$です"},
        { "location": "234/TALK"  , "narrator": "みやび", "text": "ほほう、\n$handle$……"},
        { "location": "236/TALK"  , "narrator": "みやび", "text": "ほんなら\nうちはこれで。\nおやすみ…　…"},
        { "location": "237/SEL"   , "narrator": "", "text": "いやいやいやいや"},
        { "location": "238/ACT"   , "narrator": "", "text": "いやいやいやいや"},
        { "location": "241/TALK"  , "narrator": "みやび", "text": "なんぞ、\n何か用か？"},
        { "location": "243/SEL"   , "narrator": "", "text": "ここはどこ？"},
        { "location": "244/SEL"   , "narrator": "", "text": "司書でしょ？　仕事してよ"},
        { "location": "245/ACT"   , "narrator": "", "text": "ここはどこ？"},
        { "location": "247/ACT"   , "narrator": "", "text": "司書でしょ？　仕事してよ"},
        { "location": "251/SEL"   , "narrator": "", "text": "ここはどこ？"},
        { "location": "252/ACT"   , "narrator": "", "text": "ここはどこ？"},
        { "location": "257/TALK"  , "narrator": "みやび", "text": "ああ、バレちょったか。\nしょうがないね。"},
        { "location": "260/TALK"  , "narrator": "みやび", "text": "恋ヶ崎みやびの\n精神世界の入口や。\n[ココロゲート]っちゅう。"},
        { "location": "261/TALK"  , "narrator": "みやび", "text": "ここはなぁ、現実のうちが\n何か物事を決めゆう時に\n使われる場所や。"},
        { "location": "262/TALK"  , "narrator": "みやび", "text": "んで、\nうちは[ココロの司書]\nっちゅう役割の人格。"},
        { "location": "263/TALK"  , "narrator": "みやび", "text": "この幾千もの扉から\n的確に判断して、開ける\nべき扉を指示する人やき。"},
        { "location": "264/TALK"  , "narrator": "みやび", "text": "普段はそんだけ。\n簡単なお仕事や。"},
        { "location": "265/TALK"  , "narrator": "みやび", "text": "指定した扉も\n簡単に開くしね。"},
        { "location": "266/TALK"  , "narrator": "みやび", "text": "けんど、今みたいな時は\nそうはいかん。"},
        { "location": "267/TALK"  , "narrator": "みやび", "text": "何ら心に怯えとか葛藤が\n出来ちゅうと、正しい扉が\n開かんくなるき。"},
        { "location": "268/TALK"  , "narrator": "みやび", "text": "そうなると、うちはもう\nお手上げや。"},
        { "location": "269/TALK"  , "narrator": "みやび", "text": "寝るしかない。"},
        { "location": "270/TALK"  , "narrator": "みやび", "text": "おやすみ。"},
        { "location": "271/SEL"   , "narrator": "", "text": "ちゃんと仕事して"},
        { "location": "272/ACT"   , "narrator": "", "text": "ちゃんと仕事して"},
        { "location": "274/TALK"  , "narrator": "みやび", "text": "そうはゆうても、扉に\n<color=red>【[クラン]】</color>が蔓延ったら\nうちには対処できんよ。"},
        { "location": "275/SEL"   , "narrator": "", "text": "扉にクラン？？"},
        { "location": "276/ACT"   , "narrator": "", "text": "扉にクラン？？"},
        { "location": "279/TALK"  , "narrator": "みやび", "text": "そうやね。"},
        { "location": "280/TALK"  , "narrator": "みやび", "text": "怯えなんかが出ると、\n人生先へ進ませたくない\n気持ちがクランを作る。"},
        { "location": "281/TALK"  , "narrator": "みやび", "text": "そのクランが扉を封鎖して\n本来うちが進むべき道を\n閉ざしてしまうんよ。"},
        { "location": "282/TALK"  , "narrator": "みやび", "text": "今も扉の所では、打破\nしたい頑張り屋のうちが\n戦っちょるけんど……。"},
        { "location": "283/TALK"  , "narrator": "みやび", "text": "どうにも\n勝てそうにないちや。"},
        { "location": "284/TALK"  , "narrator": "みやび", "text": "やき、そうなれば\n寝るしかないっちゅう\nわけなんやが――"},
        { "location": "285/TALK"  , "narrator": "みやび", "text": "誰かさんが手伝って\nくれるちゅうんなら\n話は別や。"},
        { "location": "286/SEL"   , "narrator": "", "text": "クランを倒すってこと？"},
        { "location": "287/ACT"   , "narrator": "", "text": "クランを倒すってこと？"},
        { "location": "289/TALK"  , "narrator": "みやび", "text": "ご名答。"},
        { "location": "291/TALK"  , "narrator": "みやび", "text": "お前さんが、頑張り屋の\nうちを助けてくれるなら、\nあるいは…ぞね。"},
        { "location": "292/SEL"   , "narrator": "", "text": "いいよ"},
        { "location": "293/SEL"   , "narrator": "", "text": "やだ"},
        { "location": "294/ACT"   , "narrator": "", "text": "いいよ"},
        { "location": "296/TALK"  , "narrator": "みやび", "text": "ふむ。\nまあ、そう言って\nもらわんと話が進まん。"},
        { "location": "297/ACT"   , "narrator": "", "text": "やだ"},
        { "location": "299/TALK"  , "narrator": "みやび", "text": "いや、ここは\n是とするとこやろ。"},
        { "location": "300/TALK"  , "narrator": "みやび", "text": "やりなおし。"},
        { "location": "304/SEL"   , "narrator": "", "text": "それで、どうすればいいの？"},
        { "location": "305/ACT"   , "narrator": "", "text": "それで、どうすればいいの？"},
        { "location": "307/TALK"  , "narrator": "みやび", "text": "今からその、<color=red>【[クラン]】</color>が\n塞いじゅう扉を\nここに呼ぶきね。"},
        { "location": "308/TALK"  , "narrator": "みやび", "text": "その扉にアクセスして、\nファイターのうちと一緒に\n頑張ってくれりゃあえい。"},
        { "location": "310/TALK"  , "narrator": "みやび", "text": "ほんだら、いくよ。"},
        { "location": "320/TALK"  , "narrator": "みやび", "text": "オープンプロセス、\n0x884番地から\n0x01C番地へ。"},
        { "location": "335/TALK"  , "narrator": "みやび", "text": "シークおわり。"},
        { "location": "336/TALK"  , "narrator": "みやび", "text": "いてら。"},
        { "location": "337/SEL"   , "narrator": "", "text": "なんでそんなやる気ないの？"},
        { "location": "338/ACT"   , "narrator": "", "text": "なんでそんなやる気ないの？"},
        { "location": "340/TALK"  , "narrator": "みやび", "text": "んー……\n……さてねえ。"},
        { "location": "341/TALK"  , "narrator": "みやび", "text": "まあ、\n一つ言えることは――"},
        { "location": "342/TALK"  , "narrator": "みやび", "text": "こんなやから\nこんな閑職に\n左遷されたちや。"},
        { "location": "343/TALK"  , "narrator": "みやび", "text": "うちって、\n可哀想な人格さんやね。"},
        { "location": "344/SEL"   , "narrator": "", "text": "せめてクランが蔓延ってる理由だけでも教えてよ"},
        { "location": "345/ACT"   , "narrator": "", "text": "せめてクランが蔓延ってる理由だけでも教えてよ"},
        { "location": "347/TALK"  , "narrator": "みやび", "text": "えぇ？\nなんでそんな面倒なこと\nうちがせないかんちや。"},
        { "location": "348/TALK"  , "narrator": "みやび", "text": "とはいえ、今回ばかりは\n仕方ないか。"},
        { "location": "349/TALK"  , "narrator": "みやび", "text": "倒してもらわんと\nいかんしね。"},
        { "location": "353/TALK"  , "narrator": "みやび", "text": "ココロファイルNo.\n04-645-11に、今回の\n件が記載されちょる。"},
        { "location": "354/TALK"  , "narrator": "みやび", "text": "……ふむ。"},
        { "location": "355/TALK"  , "narrator": "みやび", "text": "どうやら意気消沈の\n原因は【なごちゃん】に\nあるみたいやね。"},
        { "location": "356/SEL"   , "narrator": "", "text": "なごちゃん？？"},
        { "location": "357/ACT"   , "narrator": "", "text": "なごちゃん？？"},
        { "location": "359/TALK"  , "narrator": "みやび", "text": "あ。"},
        { "location": "360/TALK"  , "narrator": "みやび", "text": "これ、ゆうてもえい\nことやったっけ…？"},
        { "location": "361/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "362/TALK"  , "narrator": "みやび", "text": "あかん、レベル７\n機密事項やった……。"},
        { "location": "363/SEL"   , "narrator": "", "text": "チョンボした？"},
        { "location": "364/ACT"   , "narrator": "", "text": "チョンボした？"},
        { "location": "367/TALK"  , "narrator": "みやび", "text": "なっ！"},
        { "location": "368/TALK"  , "narrator": "みやび", "text": "うちの心を読んだ！？\nあんた一体何者や！？"},
        { "location": "369/TALK"  , "narrator": "みやび", "text": "とにかく、今回の原因を\n知った以上、もう\n後戻りは出来んぞね！"},
        { "location": "370/SEL"   , "narrator": "", "text": "え？なごちゃんって名前しか聞いてないけど"},
        { "location": "371/ACT"   , "narrator": "", "text": "え？なごちゃんって名前しか聞いてないけど"},
        { "location": "373/TALK"  , "narrator": "みやび", "text": "十分十分！　それだけで\n黒服に連れて行かれる\nレベルの情報やよ。"},
        { "location": "374/TALK"  , "narrator": "みやび", "text": "お駄賃に不足無し！\nさぁ、すっと行くちや！"},
        { "location": "375/SEL"   , "narrator": "", "text": "ちょっとまっ！"},
        { "location": "376/ACT"   , "narrator": "", "text": "ちょっとまっ！"},
        { "location": "379/TALK"  , "narrator": "みやび", "text": "うちと$handle$に\nえいココロの旅を！"},
        { "location": "33/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>5月3日　6:06 PM</color>\nFreyMENOWライブ中に発生した\nフェノメノンドーム戦にて。"},
        { "location": "114/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "199/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "221/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"}
    ]
}
