    "entry":
    [
        { "location": "8/SCENARIO", "narrator": "", "text": "乙女剣士と機械愛ずる姫君"},
        { "location": "28/TALK"   , "narrator": "アーヤ", "text": "館長と\n無事に合流できて\nよかったです。"},
        { "location": "29/TALK"   , "narrator": "アーヤ", "text": "意味深なことを\n言うから\n心配していたんですよ。"},
        { "location": "30/TALK"   , "narrator": "真幌", "text": "それはすまなかった。"},
        { "location": "31/TALK"   , "narrator": "真幌", "text": "…あの時は最悪の事態を\n考えておかないと\nいけなかったからな。"},
        { "location": "32/TALK"   , "narrator": "アーヤ", "text": "…。"},
        { "location": "33/TALK"   , "narrator": "真幌", "text": "だがその状態は\n脱した。"},
        { "location": "34/TALK"   , "narrator": "真幌", "text": "まだまだ油断は\nできないが。"},
        { "location": "35/TALK"   , "narrator": "真幌", "text": "こちらにはエリカがいる。\nこれほど心強い\nことはないだろう。"},
        { "location": "37/TALK"   , "narrator": "アーヤ", "text": "……………。"},
        { "location": "38/TALK"   , "narrator": "真幌", "text": "なあアーヤ。"},
        { "location": "39/TALK"   , "narrator": "真幌", "text": "エリカはいつも\n自慢していたぞ。\nおまえのことを。"},
        { "location": "42/TALK"   , "narrator": "アーヤ", "text": "え？"},
        { "location": "43/TALK"   , "narrator": "真幌", "text": "アヤちゃんは世界で\n一番強いんだ、と。"},
        { "location": "44/TALK"   , "narrator": "真幌", "text": "かっこよくて優しい\n自慢の妹だと。"},
        { "location": "45/SEL"    , "narrator": "", "text": "さすがアーヤ"},
        { "location": "46/SEL"    , "narrator": "", "text": "いいお姉さんだね"},
        { "location": "47/ACT"    , "narrator": "", "text": "さすがアーヤ"},
        { "location": "48/ACT"    , "narrator": "", "text": "いいお姉さんだね"},
        { "location": "66/TALK"   , "narrator": "アーヤ", "text": "そんなこと"},
        { "location": "68/TALK"   , "narrator": "アーヤ", "text": "言われても"},
        { "location": "70/SEL"    , "narrator": "", "text": "素直になりなよ"},
        { "location": "71/SEL"    , "narrator": "", "text": "照れちゃってもー"},
        { "location": "72/SEL"    , "narrator": "", "text": "そんなアーヤもかわいい"},
        { "location": "73/ACT"    , "narrator": "", "text": "素直になりなよ"},
        { "location": "74/TALK"   , "narrator": "アーヤ", "text": "知らないわ"},
        { "location": "75/TALK"   , "narrator": "アーヤ", "text": "そんなこと"},
        { "location": "76/ACT"    , "narrator": "", "text": "照れちゃってもー"},
        { "location": "77/TALK"   , "narrator": "アーヤ", "text": "そういうんじゃ"},
        { "location": "78/TALK"   , "narrator": "アーヤ", "text": "ないわ"},
        { "location": "79/ACT"    , "narrator": "", "text": "そんなアーヤもかわいい"},
        { "location": "80/TALK"   , "narrator": "アーヤ", "text": "$handle$さんは"},
        { "location": "81/TALK"   , "narrator": "アーヤ", "text": "いつもそれね"},
        { "location": "83/TALK"   , "narrator": "アーヤ", "text": "自慢なんか"},
        { "location": "84/TALK"   , "narrator": "アーヤ", "text": "されるような妹じゃない"},
        { "location": "85/TALK"   , "narrator": "アーヤ", "text": "だってお姉ちゃんの方が"},
        { "location": "86/TALK"   , "narrator": "アーヤ", "text": "ずっと頭もよくて"},
        { "location": "87/TALK"   , "narrator": "アーヤ", "text": "それに"},
        { "location": "88/TALK"   , "narrator": "アーヤ", "text": "いつも変なことばかり言うから"},
        { "location": "89/TALK"   , "narrator": "アーヤ", "text": "困ってたのよ私"},
        { "location": "91/SEL"    , "narrator": "", "text": "誤解だったんじゃない"},
        { "location": "92/SEL"    , "narrator": "", "text": "離れてみてわかることもあるよ"},
        { "location": "93/SEL"    , "narrator": "", "text": "姉妹って難しいよね"},
        { "location": "94/ACT"    , "narrator": "", "text": "誤解だったんじゃない"},
        { "location": "95/TALK"   , "narrator": "アーヤ", "text": "そんなこと"},
        { "location": "97/TALK"   , "narrator": "アーヤ", "text": "言いたくないわ"},
        { "location": "98/ACT"    , "narrator": "", "text": "離れてみてわかることもあるよ"},
        { "location": "99/TALK"   , "narrator": "アーヤ", "text": "それは"},
        { "location": "101/TALK"  , "narrator": "アーヤ", "text": "あるかもね"},
        { "location": "102/ACT"   , "narrator": "", "text": "姉妹って難しいよね"},
        { "location": "103/TALK"  , "narrator": "アーヤ", "text": "そう"},
        { "location": "105/TALK"  , "narrator": "アーヤ", "text": "本当そう"},
        { "location": "117/TALK"  , "narrator": "真幌", "text": "それから自分は\n少し肩身が狭いとも。"},
        { "location": "119/TALK"  , "narrator": "アーヤ", "text": "…どうして？"},
        { "location": "120/TALK"  , "narrator": "アーヤ", "text": "そんなこと\nないはずです。"},
        { "location": "121/TALK"  , "narrator": "真幌", "text": "しっかり者の妹と\n比べられるからだと。"},
        { "location": "122/TALK"  , "narrator": "真幌", "text": "同級生や下級生だけでなく\n教師からも頼られる妹。"},
        { "location": "123/TALK"  , "narrator": "真幌", "text": "自分はいつも人の輪から\nはみ出してしまう。でも\n妹はいつも中心にいる。"},
        { "location": "124/TALK"  , "narrator": "真幌", "text": "そんな妹を\n自慢に思いつつも\n辛い時もあると。"},
        { "location": "126/TALK"  , "narrator": "アーヤ", "text": "そんなこと\n私には一度も……。"},
        { "location": "174/TALK"  , "narrator": "アーヤ", "text": "　"},
        { "location": "190/TALK"  , "narrator": "白烏", "text": "[ココロゲート]へ\nいらっしゃい。\n$handle$さん。"},
        { "location": "191/SEL"   , "narrator": "", "text": "どうしたの？怖い顔して"},
        { "location": "192/ACT"   , "narrator": "", "text": "どうしたの？怖い顔して"},
        { "location": "194/TALK"  , "narrator": "白烏", "text": "えっと。\nそれは……"},
        { "location": "195/TALK"  , "narrator": "白烏", "text": "$handle$さんに\n言わなければならない\nことがあります。"},
        { "location": "196/SEL"   , "narrator": "", "text": "告白！？"},
        { "location": "197/SEL"   , "narrator": "", "text": "なに？"},
        { "location": "198/ACT"   , "narrator": "", "text": "告白！？"},
        { "location": "199/TALK"  , "narrator": "白烏", "text": "……。"},
        { "location": "200/TALK"  , "narrator": "白烏", "text": "やっぱりいいわ。"},
        { "location": "201/SEL"   , "narrator": "", "text": "えー、冗談です！"},
        { "location": "202/ACT"   , "narrator": "", "text": "えー、冗談です！"},
        { "location": "204/TALK"  , "narrator": "白烏", "text": "もう…。\n冗談も\n時と場所をを選んでね。"},
        { "location": "205/ACT"   , "narrator": "", "text": "なに？"},
        { "location": "207/TALK"  , "narrator": "白烏", "text": "えと……ね。"},
        { "location": "208/TALK"  , "narrator": "白烏", "text": "実は…"},
        { "location": "209/TALK"  , "narrator": "白烏", "text": "言っておきたいことが\nあるんだけど……"},
        { "location": "210/TALK"  , "narrator": "白烏", "text": "……。"},
        { "location": "211/TALK"  , "narrator": "白烏", "text": "うーん……"},
        { "location": "212/SEL"   , "narrator": "", "text": "……？"},
        { "location": "213/ACT"   , "narrator": "", "text": "……？"},
        { "location": "215/TALK"  , "narrator": "白烏", "text": "……。"},
        { "location": "216/TALK"  , "narrator": "白烏", "text": "ごめんなさい！\nやっぱり今回はナシ！"},
        { "location": "217/SEL"   , "narrator": "", "text": "えー！？"},
        { "location": "218/SEL"   , "narrator": "", "text": "ホントに？\nホントに言わなくていいの？"},
        { "location": "219/ACT"   , "narrator": "", "text": "えー！？"},
        { "location": "220/TALK"  , "narrator": "白烏", "text": "ごめんなさい。\nホントにごめんね。"},
        { "location": "221/ACT"   , "narrator": "", "text": "ホントに？\nホントに言わなくていいの？"},
        { "location": "223/TALK"  , "narrator": "白烏", "text": "え！？\nいや、言いたいけど\n今回はまだ心の準備が。"},
        { "location": "225/TALK"  , "narrator": "白烏", "text": "でも、次回は言う。\n絶対……言うから。"},
        { "location": "226/SEL"   , "narrator": "", "text": "ダメ！\n今言え！"},
        { "location": "227/ACT"   , "narrator": "", "text": "ダメ！\n今言え！"},
        { "location": "229/TALK"  , "narrator": "白烏", "text": "は！？\nなんで！？"},
        { "location": "230/SEL"   , "narrator": "", "text": "それ死亡フラグだから"},
        { "location": "231/ACT"   , "narrator": "", "text": "それ死亡フラグだから"},
        { "location": "233/TALK"  , "narrator": "白烏", "text": "意味が\n分からないんだけど。"},
        { "location": "234/SEL"   , "narrator": "", "text": "前にエヴェレットが同じ事を言って、次の回に失踪した"},
        { "location": "235/ACT"   , "narrator": "", "text": "前にエヴェレットが同じ事を言って、次の回に失踪した"},
        { "location": "237/TALK"  , "narrator": "白烏", "text": "ああ、あのこと。\n私は大丈夫だから――"},
        { "location": "238/SEL"   , "narrator": "", "text": "それも死亡フラグなので、失踪する前に言うだけ言ってって！"},
        { "location": "239/SEL"   , "narrator": "", "text": "白烏を助けたいから、ちゃんと教えて！"},
        { "location": "240/ACT"   , "narrator": "", "text": "それも死亡フラグなので、失踪する前に言うだけ言ってって！"},
        { "location": "242/TALK"  , "narrator": "白烏", "text": "ああ。\n必要なのは\n情報の方なのね。"},
        { "location": "244/ACT"   , "narrator": "", "text": "白烏を助けたいから、ちゃんと教えて！"},
        { "location": "246/TALK"  , "narrator": "白烏", "text": "またそんな事言って。\n情報が欲しいだけでしょ？"},
        { "location": "247/TALK"  , "narrator": "白烏", "text": "……。"},
        { "location": "249/TALK"  , "narrator": "白烏", "text": "まあいいわ。\nそこまで言うなら。"},
        { "location": "250/TALK"  , "narrator": "白烏", "text": "でも、どちらかというと\nこの情報でショックなのは\n貴方の方だと思う。"},
        { "location": "251/SEL"   , "narrator": "", "text": "言ってみて"},
        { "location": "252/SEL"   , "narrator": "", "text": "やっぱ遠慮します！"},
        { "location": "253/ACT"   , "narrator": "", "text": "言ってみて"},
        { "location": "255/ACT"   , "narrator": "", "text": "やっぱ遠慮します！"},
        { "location": "256/TALK"  , "narrator": "白烏", "text": "もうダメ。\n言うって決めたもの。"},
        { "location": "258/TALK"  , "narrator": "白烏", "text": "それじゃ、\n大事な事を伝えます。"},
        { "location": "259/TALK"  , "narrator": "白烏", "text": "セルフクランのことは\n覚えてる？"},
        { "location": "260/SEL"   , "narrator": "", "text": "覚えてる"},
        { "location": "261/SEL"   , "narrator": "", "text": "一応また教えて"},
        { "location": "262/ACT"   , "narrator": "", "text": "覚えてる"},
        { "location": "263/TALK"  , "narrator": "白烏", "text": "さすがね。"},
        { "location": "264/ACT"   , "narrator": "", "text": "一応また教えて"},
        { "location": "265/TALK"  , "narrator": "白烏", "text": "はいはい。"},
        { "location": "266/TALK"  , "narrator": "白烏", "text": "セルフクランは、\n私という存在の主人格と\n言われるクランのこと。"},
        { "location": "267/TALK"  , "narrator": "白烏", "text": "いわば、私を体現する\n人格のことね。"},
        { "location": "268/SEL"   , "narrator": "", "text": "そうだったね"},
        { "location": "269/SEL"   , "narrator": "", "text": "クランと人格の違いがよくわからない"},
        { "location": "270/ACT"   , "narrator": "", "text": "そうだったね"},
        { "location": "271/TALK"  , "narrator": "白烏", "text": "そうよ。"},
        { "location": "272/ACT"   , "narrator": "", "text": "クランと人格の違いがよくわからない"},
        { "location": "273/TALK"  , "narrator": "白烏", "text": "人格が発症したものが\nクランと言われるもの。"},
        { "location": "274/TALK"  , "narrator": "白烏", "text": "人格は、大きな衝撃が\nあったりすると発症する。"},
        { "location": "275/TALK"  , "narrator": "白烏", "text": "それは大抵は、その衝撃の\n主題に近いクランである\n場合が多いのだけど。"},
        { "location": "276/TALK"  , "narrator": "白烏", "text": "でも、わりと誰でも、\n生きていれば一度や二度は\n発症してるものなのよ。"},
        { "location": "277/TALK"  , "narrator": "白烏", "text": "そして、発症は決して\n悪いことじゃない。"},
        { "location": "278/TALK"  , "narrator": "白烏", "text": "それによって\n人格は進化して、\nココロは成長するから。"},
        { "location": "279/TALK"  , "narrator": "白烏", "text": "ただ、セルフクランとも\nなれば、それはまた\n話が変わってくる。"},
        { "location": "280/TALK"  , "narrator": "白烏", "text": "セルフクランが発症する\nくらいの出来事というのは\n全人格激動レベルのこと。"},
        { "location": "281/TALK"  , "narrator": "白烏", "text": "だから、殆どの人は、\n一生に一度も発症しない。"},
        { "location": "282/TALK"  , "narrator": "白烏", "text": "発症すれば、運が良ければ\n全く別人のように\n人が変わるだけで済み――"},
        { "location": "283/TALK"  , "narrator": "白烏", "text": "運が悪ければ、最悪\n廃人になってしまうの。"},
        { "location": "286/TALK"  , "narrator": "白烏", "text": "そのセルフクランが……"},
        { "location": "287/TALK"  , "narrator": "白烏", "text": "……。"},
        { "location": "288/SEL"   , "narrator": "", "text": "…？？"},
        { "location": "289/ACT"   , "narrator": "", "text": "…？？"},
        { "location": "291/TALK"  , "narrator": "白烏", "text": "そのセルフクランが、\n近いうちに発――"},
        { "location": "296/SEL"   , "narrator": "", "text": "！？"},
        { "location": "297/ACT"   , "narrator": "", "text": "！？"},
        { "location": "303/SEL"   , "narrator": "", "text": "おーい"},
        { "location": "304/ACT"   , "narrator": "", "text": "おーい"},
        { "location": "307/SEL"   , "narrator": "", "text": "適当に操作してみる"},
        { "location": "308/ACT"   , "narrator": "", "text": "適当に操作してみる"},
        { "location": "311/SEL"   , "narrator": "", "text": "EXEC_STATUSDUMP/."},
        { "location": "312/SEL"   , "narrator": "", "text": "EXEC_SEEK_SECTOR/."},
        { "location": "313/SEL"   , "narrator": "", "text": "EXEC_SUSPEND/."},
        { "location": "322/SEL"   , "narrator": "", "text": "Type::KokoroError"},
        { "location": "323/SEL"   , "narrator": "", "text": "Type::"},
        { "location": "400/TALK"  , "narrator": "エリカ", "text": "あれ？\nどうしたの！？"},
        { "location": "401/SEL"   , "narrator": "", "text": "エリカさん！？"},
        { "location": "402/ACT"   , "narrator": "", "text": "エリカさん！？"},
        { "location": "404/TALK"  , "narrator": "エリカ", "text": "もしかして、\nバグって飛ばされて\n来ちゃったのかな？"},
        { "location": "405/TALK"  , "narrator": "エリカ", "text": "確かに0x000だから、\nアドレスがnullだと\nここに来る可能性も――"},
        { "location": "406/SEL"   , "narrator": "", "text": "エリカさんはなんでここに！？"},
        { "location": "407/ACT"   , "narrator": "", "text": "エリカさんはなんでここに！？"},
        { "location": "409/TALK"  , "narrator": "エリカ", "text": "あ、えっとね。\n別に不法侵入とかじゃ\nないよ？"},
        { "location": "410/TALK"  , "narrator": "エリカ", "text": "この0x000ってのは、\n外部リンクへの\nフックアドレスなの。"},
        { "location": "412/TALK"  , "narrator": "エリカ", "text": "もっと具体的に言うと、\nトライガジェットを介して\n外部へ接続する場所。"},
        { "location": "413/TALK"  , "narrator": "エリカ", "text": "専門的な言い方すると、\n1xアドレス空間への\nジャンパーってところ？"},
        { "location": "414/SEL"   , "narrator": "", "text": "？？？？？？？？？"},
        { "location": "415/SEL"   , "narrator": "", "text": "そうだったのか！！"},
        { "location": "416/ACT"   , "narrator": "", "text": "？？？？？？？？？"},
        { "location": "418/TALK"  , "narrator": "エリカ", "text": "うーんと、\nえっとね……"},
        { "location": "419/TALK"  , "narrator": "エリカ", "text": "トライガジェットが、\n綾ちゃんを\n強くするでしょ？"},
        { "location": "420/TALK"  , "narrator": "エリカ", "text": "戦闘経験無いのに\nすごい立ち回りが\n上手かったり、"},
        { "location": "421/TALK"  , "narrator": "エリカ", "text": "クランを装備すると、\nそのクランの力を\n自分のものにできたり。"},
        { "location": "422/TALK"  , "narrator": "エリカ", "text": "そういうのは、トライ\nガジェットを介して、脳を\n拡張してるというわけ。"},
        { "location": "423/TALK"  , "narrator": "エリカ", "text": "そして、その拡張ポート、\n例えるならUSB端子が\nこの0x000ってこと。"},
        { "location": "424/TALK"  , "narrator": "エリカ", "text": "USBにHDD挿せば容量\n増えるし、カメラ繋げば\n目が増えるでしょ？"},
        { "location": "425/TALK"  , "narrator": "エリカ", "text": "それと同じ事を\nできるようにする\nポートなの。"},
        { "location": "426/ACT"   , "narrator": "", "text": "そうだったのか！！"},
        { "location": "428/TALK"  , "narrator": "エリカ", "text": "そう。"},
        { "location": "438/SEL"   , "narrator": "", "text": "じゃあ、前に千羽鶴をここで見かけたのも…"},
        { "location": "439/ACT"   , "narrator": "", "text": "じゃあ、前に千羽鶴をここで見かけたのも…"},
        { "location": "441/TALK"  , "narrator": "エリカ", "text": "そうだね。"},
        { "location": "442/TALK"  , "narrator": "エリカ", "text": "彼女がTRI-OSの\nアドミニストレータ\nだったから。"},
        { "location": "444/SEL"   , "narrator": "", "text": "でも、つばめの時はご飯食べてたよ…？"},
        { "location": "445/ACT"   , "narrator": "", "text": "でも、つばめの時はご飯食べてたよ…？"},
        { "location": "447/TALK"  , "narrator": "エリカ", "text": "そうなんだ！"},
        { "location": "448/TALK"  , "narrator": "エリカ", "text": "それは多分、自分の\nホームだから、くつろいで\nいたんじゃないかな？"},
        { "location": "451/TALK"  , "narrator": "エリカ", "text": "それはそうと、\nどうしてここに来たの？"},
        { "location": "452/SEL"   , "narrator": "", "text": "突然白烏が消えたから、自分で飛んできた"},
        { "location": "453/ACT"   , "narrator": "", "text": "突然白烏が消えたから、自分で飛んできた"},
        { "location": "455/TALK"  , "narrator": "エリカ", "text": "突然…消えた？"},
        { "location": "456/TALK"  , "narrator": "エリカ", "text": "うーん……\nそんなことは\nないと思うんだけど……"},
        { "location": "457/TALK"  , "narrator": "エリカ", "text": "ちょっと調べてみるね。"},
        { "location": "458/TALK"  , "narrator": "エリカ", "text": "あなたは、\n綾ちゃんの心の葛藤を\n何とかしてあげて？"},
        { "location": "459/TALK"  , "narrator": "エリカ", "text": "よろしくね。"},
        { "location": "478/SEL"   , "narrator": "", "text": "はい"},
        { "location": "479/SEL"   , "narrator": "", "text": "いいえ"},
        { "location": "480/ACT"   , "narrator": "", "text": "はい"},
        { "location": "488/ACT"   , "narrator": "", "text": "いいえ"},
        { "location": "26/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>9月5日　 1:02 PM</color>\nストライキ３日目、長野県松代アーヤの実家にて"},
        { "location": "139/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "141/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "143/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "145/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "147/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"},
