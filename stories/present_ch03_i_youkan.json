        { "location": "286/TALK", "narrator": "ガブリエラ", "text": "この組み合わせ、私も大好きよ"},
        { "location": "288/TALK", "narrator": "ガブリエラ", "text": "羊羹はポーランドにいた頃に何度か食べたことあるんだけど"},
        { "location": "289/TALK", "narrator": "ガブリエラ", "text": "水羊羹は、日本に来た最初の頃"},
        { "location": "290/TALK", "narrator": "ガブリエラ", "text": "アーヤとお茶しに行った店で、初めて知ったの"},
        { "location": "293/SEL" , "narrator": "", "text": "アーヤとはよく出掛けるの？"},
        { "location": "294/ACT" , "narrator": "", "text": "アーヤとはよく出掛けるの？"},
        { "location": "297/TALK", "narrator": "ガブリエラ", "text": "時々ね"},
        { "location": "298/TALK", "narrator": "ガブリエラ", "text": "学校の帰りが一緒になったり"},
        { "location": "299/TALK", "narrator": "ガブリエラ", "text": "休みの日に何もすることがなかったりすると"},
        { "location": "300/TALK", "narrator": "ガブリエラ", "text": "暇つぶしに、カフェとかに行ったりするの"},
        { "location": "303/SEL" , "narrator": "", "text": "仲良いんだね"},
        { "location": "304/ACT" , "narrator": "", "text": "仲良いんだね"},
        { "location": "307/TALK", "narrator": "ガブリエラ", "text": "ありえないから！"},
        { "location": "308/TALK", "narrator": "ガブリエラ", "text": "昔のアーヤならまだしも"},
        { "location": "309/TALK", "narrator": "ガブリエラ", "text": "今のアーヤは抜け殻でしかないんだし"},
        { "location": "310/TALK", "narrator": "ガブリエラ", "text": "まあ、ただの暇つぶし相手にしか、思ってないわ"},
        { "location": "311/TALK", "narrator": "ガブリエラ", "text": "本当よ？"}
    ]
}
