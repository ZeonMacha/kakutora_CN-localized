        { "location": "7959/SCENARIO", "narrator": "", "text": "第三次大惨事"},
        { "location": "7984/TALK"    , "narrator": "神楽", "text": "だだだだだだだだだ大惨事♪"},
        { "location": "7986/SEL"     , "narrator": "", "text": "何があった！？"},
        { "location": "7987/SEL"     , "narrator": "", "text": "そんなのんきな"},
        { "location": "7988/SEL"     , "narrator": "", "text": "神楽は大丈夫？"},
        { "location": "7989/ACT"     , "narrator": "", "text": "何があった！？"},
        { "location": "7990/TALK"    , "narrator": "神楽", "text": "特にはー"},
        { "location": "7991/ACT"     , "narrator": "", "text": "そんなのんきな"},
        { "location": "7992/TALK"    , "narrator": "神楽", "text": "そうかな？"},
        { "location": "7993/ACT"     , "narrator": "", "text": "神楽は大丈夫？"},
        { "location": "7995/TALK"    , "narrator": "神楽", "text": "うっ、、、、"},
        { "location": "7996/TALK"    , "narrator": "神楽", "text": "今ぴょんこは呼吸困難になりました"},
        { "location": "7997/TALK"    , "narrator": "神楽", "text": "$handlek$がきゅんとさせるから！"},
        { "location": "7999/TALK"    , "narrator": "神楽", "text": "ほんとは大惨事ってこともなく"},
        { "location": "8001/TALK"    , "narrator": "神楽", "text": "ガブちゃんがアーヤさんにやきもち妬いてただけ♪"},
        { "location": "8003/SEL"     , "narrator": "", "text": "いつものことだね"},
        { "location": "8004/SEL"     , "narrator": "", "text": "百合展開キター！"},
        { "location": "8005/SEL"     , "narrator": "", "text": "神楽は$me$を見てくれないの？"},
        { "location": "8006/ACT"     , "narrator": "", "text": "いつものことだね"},
        { "location": "8007/TALK"    , "narrator": "神楽", "text": "面倒くさいけどいつものことなんだぴょん"},
        { "location": "8008/TALK"    , "narrator": "神楽", "text": "女子ってねーもー！"},
        { "location": "8009/ACT"     , "narrator": "", "text": "百合展開キター！"},
        { "location": "8010/TALK"    , "narrator": "神楽", "text": "今さら過ぎ"},
        { "location": "8011/TALK"    , "narrator": "神楽", "text": "いちいちはしゃげるのかえって貴重だわ"},
        { "location": "8012/ACT"     , "narrator": "", "text": "神楽は$me$を見てくれないの？"},
        { "location": "8014/TALK"    , "narrator": "神楽", "text": "おっおっ！？"},
        { "location": "8015/TALK"    , "narrator": "神楽", "text": "ヤンデレ風味な発言ｋｔｋｒ！"},
        { "location": "8017/TALK"    , "narrator": "神楽", "text": "イイネイイネ！"},
        { "location": "8018/TALK"    , "narrator": "神楽", "text": "ぴょんこぞくぞくしちゃう♪"},
        { "location": "8020/TALK"    , "narrator": "神楽", "text": "でもアーヤさんがガブちゃんにココア入れてあげて解決したみたい"},
        { "location": "8021/TALK"    , "narrator": "神楽", "text": "かわいいとこあるよね！"}
