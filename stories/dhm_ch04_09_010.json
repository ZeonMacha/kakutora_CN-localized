    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "012_ご当地方言少女"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "土佐弁がマイナー方言だとは思えんぞね"},
        { "location": "33/TALK"   , "narrator": "みやび", "text": "なんといっても"},
        { "location": "34/TALK"   , "narrator": "みやび", "text": "高知県民はみんな土佐弁なのだからな"},
        { "location": "37/SEL"    , "narrator": "", "text": "それはそうかもしれないけど"},
        { "location": "38/SEL"    , "narrator": "", "text": "マイナーだと思う"},
        { "location": "39/SEL"    , "narrator": "", "text": "方言少女萌えー"},
        { "location": "40/ACT"    , "narrator": "", "text": "それはそうかもしれないけど"},
        { "location": "41/TALK"   , "narrator": "みやび", "text": "けど、とか"},
        { "location": "42/TALK"   , "narrator": "みやび", "text": "相棒のくせに生意気だ"},
        { "location": "43/ACT"    , "narrator": "", "text": "マイナーだと思う"},
        { "location": "44/TALK"   , "narrator": "みやび", "text": "まさか"},
        { "location": "45/TALK"   , "narrator": "みやび", "text": "信じんぞ"},
        { "location": "46/ACT"    , "narrator": "", "text": "方言少女萌えー"},
        { "location": "48/TALK"   , "narrator": "みやび", "text": "萌えとな"},
        { "location": "49/TALK"   , "narrator": "みやび", "text": "いや"},
        { "location": "50/TALK"   , "narrator": "みやび", "text": "萌えちゅうかよ"},
        { "location": "51/TALK"   , "narrator": "みやび", "text": "ふふん"},
        { "location": "53/TALK"   , "narrator": "みやび", "text": "しかしつばめちゃんのことだ"},
        { "location": "54/TALK"   , "narrator": "みやび", "text": "下手したら本気でキャラづくりだと思われている懸念"},
        { "location": "55/TALK"   , "narrator": "みやび", "text": "ぬぬぬ…"},
        { "location": "57/SEL"    , "narrator": "", "text": "一度じっくり話し合おう"},
        { "location": "58/SEL"    , "narrator": "", "text": "さすがにそれはないよ"},
        { "location": "59/SEL"    , "narrator": "", "text": "標準語で話さないの？"},
        { "location": "60/ACT"    , "narrator": "", "text": "一度じっくり話し合おう"},
        { "location": "62/TALK"   , "narrator": "みやび", "text": "話し合いだ？"},
        { "location": "64/TALK"   , "narrator": "みやび", "text": "そこまでして訂正せんでもよい"},
        { "location": "65/TALK"   , "narrator": "みやび", "text": "それはそれで面白そうだし"},
        { "location": "66/ACT"    , "narrator": "", "text": "さすがにそれはないよ"},
        { "location": "67/TALK"   , "narrator": "みやび", "text": "なんだと？"},
        { "location": "68/TALK"   , "narrator": "みやび", "text": "まだまだじゃの、相棒"},
        { "location": "69/TALK"   , "narrator": "みやび", "text": "あの子の天然っぷりを把握できておらぬ"},
        { "location": "70/ACT"    , "narrator": "", "text": "標準語で話さないの？"},
        { "location": "71/TALK"   , "narrator": "みやび", "text": "話せる"},
        { "location": "72/TALK"   , "narrator": "みやび", "text": "が"},
        { "location": "73/TALK"   , "narrator": "みやび", "text": "話さん"},
        { "location": "74/TALK"   , "narrator": "みやび", "text": "全く"},
        { "location": "75/TALK"   , "narrator": "みやび", "text": "土佐弁が標準語になればええのに"}
    ]
}
