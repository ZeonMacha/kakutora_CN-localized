{
    "dir": "tutorial/tutorial_00.js",
    "type": "MainStory",
    "info": {
        "story_id": "1",
        "cid": "all",
        "title": "001 チュートリアル　STEP 1",
        "sub_title": "チュートリアル導入"
    },
    "entry":
    [
        { "location": "5/SCENARIO", "narrator": "", "text": "チュートリアル_導入"},
        { "location": "59/TALK"   , "narrator": "千羽鶴", "text": "……。"},
        { "location": "60/SEL"    , "narrator": "", "text": "…！？"},
        { "location": "61/ACT"    , "narrator": "", "text": "…！？"},
        { "location": "67/TALK"   , "narrator": "千羽鶴", "text": "…っ！？"},
        { "location": "68/TALK"   , "narrator": "千羽鶴", "text": "もしかして……"},
        { "location": "70/TALK"   , "narrator": "千羽鶴", "text": "もしもし？"},
        { "location": "71/SEL"    , "narrator": "", "text": "はい"},
        { "location": "72/ACT"    , "narrator": "", "text": "はい"},
        { "location": "74/TALK"   , "narrator": "千羽鶴", "text": "やっぱり。"},
        { "location": "75/TALK"   , "narrator": "千羽鶴", "text": "私の会話を\n認識できる？"},
        { "location": "76/SEL"    , "narrator": "", "text": "はい"},
        { "location": "77/SEL"    , "narrator": "", "text": "『私の会話を認識出来る？』と言った"},
        { "location": "78/ACT"    , "narrator": "", "text": "はい"},
        { "location": "79/ACT"    , "narrator": "", "text": "『私の会話を認識出来る？』と言った"},
        { "location": "82/TALK"   , "narrator": "千羽鶴", "text": "すごい。\n本当に繋がった。"},
        { "location": "83/TALK"   , "narrator": "千羽鶴", "text": "信じられないかも。"},
        { "location": "84/SEL"    , "narrator": "", "text": "え？どういうこと？"},
        { "location": "85/ACT"    , "narrator": "", "text": "え？どういうこと？"},
        { "location": "88/TALK"   , "narrator": "千羽鶴", "text": "このプログラムを\n起動してくれて\nありがとう。"},
        { "location": "90/TALK"   , "narrator": "千羽鶴", "text": "私は貴方とは違う世界に\nある、このプログラムの\nナビキャラクター[千羽鶴]。"},
        { "location": "91/TALK"   , "narrator": "千羽鶴", "text": "貴方の世界の誰かが、\n私を起動してくれるのを\n待っていた。"},
        { "location": "92/SEL"    , "narrator": "", "text": "てことは、今別世界と繋がってるの？"},
        { "location": "93/ACT"    , "narrator": "", "text": "てことは、今別世界と繋がってるの？"},
        { "location": "95/TALK"   , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "96/TALK"   , "narrator": "千羽鶴", "text": "そして唐突なお願いに\nなってしまうのだけど――"},
        { "location": "97/SEL"    , "narrator": "", "text": "この世界を救って欲しい？"},
        { "location": "98/SEL"    , "narrator": "", "text": "結婚しよう！"},
        { "location": "99/ACT"    , "narrator": "", "text": "この世界を救って欲しい？"},
        { "location": "101/TALK"  , "narrator": "千羽鶴", "text": "惜しいけど違う。"},
        { "location": "102/TALK"  , "narrator": "千羽鶴", "text": "この世界を\n救うために――"},
        { "location": "103/ACT"   , "narrator": "", "text": "結婚しよう！"},
        { "location": "105/TALK"  , "narrator": "千羽鶴", "text": "えっ！"},
        { "location": "106/TALK"  , "narrator": "千羽鶴", "text": "やだ…そんな突然。\n私たち、まだ出逢って\n数ワードなのよ？"},
        { "location": "107/SEL"   , "narrator": "", "text": "冗談です"},
        { "location": "108/SEL"   , "narrator": "", "text": "大事なのは時間じゃない！この気持ちなんだ！"},
        { "location": "109/ACT"   , "narrator": "", "text": "冗談です"},
        { "location": "110/TALK"  , "narrator": "千羽鶴", "text": "…知ってた。"},
        { "location": "111/TALK"  , "narrator": "千羽鶴", "text": "でも、\nちょっと面白かった。"},
        { "location": "112/ACT"   , "narrator": "", "text": "大事なのは時間じゃない！この気持ちなんだ！"},
        { "location": "113/TALK"  , "narrator": "千羽鶴", "text": "なんて情熱的な人なの？\n嬉しい！"},
        { "location": "114/SEL"   , "narrator": "", "text": "千羽鶴！"},
        { "location": "115/ACT"   , "narrator": "", "text": "千羽鶴！"},
        { "location": "117/TALK"  , "narrator": "千羽鶴", "text": "ああっ…\n名無しさんっ！"},
        { "location": "118/SEL"   , "narrator": "", "text": "名無しさん…？"},
        { "location": "119/ACT"   , "narrator": "", "text": "名無しさん…？"},
        { "location": "121/TALK"  , "narrator": "千羽鶴", "text": "ええ。\nだって私、まだあなたの\n名前知らないもの。"},
        { "location": "122/TALK"  , "narrator": "千羽鶴", "text": "それに。\nさっき私のこと何て？"},
        { "location": "123/SEL"   , "narrator": "", "text": "せんばづる…だけど"},
        { "location": "124/ACT"   , "narrator": "", "text": "せんばづる…だけど"},
        { "location": "126/TALK"  , "narrator": "千羽鶴", "text": "誰？　それ。\n私“せんばづる”じゃ\n無いから。"},
        { "location": "127/TALK"  , "narrator": "千羽鶴", "text": "…とまあ、こういう\n事になるから、恋愛は\n相手を知って慎重に。"},
        { "location": "129/TALK"  , "narrator": "千羽鶴", "text": "貴方のせいで、本題から\n逸れてしまった。"},
        { "location": "130/TALK"  , "narrator": "千羽鶴", "text": "私が貴方にしたかった\n唐突なお願いは、実は\n当たらずとも遠からず。"},
        { "location": "131/TALK"  , "narrator": "千羽鶴", "text": "それは、\nこの世界を\n救うために――"},
        { "location": "135/TALK"  , "narrator": "千羽鶴", "text": "<size=30><color=red>ある少女たちと\n結婚して欲しい！</color></size>"},
        { "location": "136/SEL"   , "narrator": "", "text": "えと、お見合いシミュレーションゲーム？"},
        { "location": "137/SEL"   , "narrator": "", "text": "世界を救うために結婚！？！？"},
        { "location": "138/ACT"   , "narrator": "", "text": "えと、お見合いシミュレーションゲーム？"},
        { "location": "139/TALK"  , "narrator": "千羽鶴", "text": "ゲームじゃない。\nこれは現実のお見合い。"},
        { "location": "140/TALK"  , "narrator": "千羽鶴", "text": "住んでる世界が\n違うから、今は現実味が\n無いかもしれないけど――"},
        { "location": "141/TALK"  , "narrator": "千羽鶴", "text": "彼女たちは実在する。\n貴方と同じように。"},
        { "location": "142/ACT"   , "narrator": "", "text": "世界を救うために結婚！？！？"},
        { "location": "143/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "144/TALK"  , "narrator": "千羽鶴", "text": "意味が分からないかも\nしれないけど、その辺は\nおいおい説明していく。"},
        { "location": "146/TALK"  , "narrator": "千羽鶴", "text": "とにかく貴方には、\n彼女たちと結婚して、\n支えてあげて欲しいの。"},
        { "location": "147/SEL"   , "narrator": "", "text": "オーケー"},
        { "location": "148/SEL"   , "narrator": "", "text": "$me$は女なんですけど…"},
        { "location": "149/ACT"   , "narrator": "", "text": "オーケー"},
        { "location": "151/TALK"  , "narrator": "千羽鶴", "text": "よかった。\nありがと。"},
        { "location": "152/ACT"   , "narrator": "", "text": "$me$は女なんですけど…"},
        { "location": "153/TALK"  , "narrator": "千羽鶴", "text": "大丈夫！"},
        { "location": "156/TALK"  , "narrator": "千羽鶴", "text": "女の子でも\n結婚できるから！"},
        { "location": "159/TALK"  , "narrator": "千羽鶴", "text": "…っと、大変。"},
        { "location": "160/TALK"  , "narrator": "千羽鶴", "text": "ここまでに\n時間を掛けすぎた。\n急がないと。"},
        { "location": "161/SEL"   , "narrator": "", "text": "そんなに千羽鶴の世界は危機的状況なの？"},
        { "location": "162/ACT"   , "narrator": "", "text": "そんなに千羽鶴の世界は危機的状況なの？"},
        { "location": "164/TALK"  , "narrator": "千羽鶴", "text": "違う。\nそういう理由じゃない。"},
        { "location": "165/TALK"  , "narrator": "千羽鶴", "text": "私には、この概要を\n５分で説明するという\n使命が課せられてる。"},
        { "location": "166/TALK"  , "narrator": "千羽鶴", "text": "統計的に見て、今から\n５分以内に貴方を彼女と\nイチャコラさせないと――"},
        { "location": "167/TALK"  , "narrator": "千羽鶴", "text": "貴方がこのプログラムを\n終了してしまう確率が\n跳ね上がってしまうから。"},
        { "location": "168/SEL"   , "narrator": "", "text": "ダイレクトだなー…"},
        { "location": "169/ACT"   , "narrator": "", "text": "ダイレクトだなー…"},
        { "location": "171/TALK"  , "narrator": "千羽鶴", "text": "ええ。\n貴方に逃げられたら困る。\nそこに関しては切実。"},
        { "location": "172/SEL"   , "narrator": "", "text": "まあ実際その通り。早く遊ばせて\n<color=blue>（※プロローグを見ない）</color>"},
        { "location": "173/SEL"   , "narrator": "", "text": "心配しなくても大丈夫だから、ちゃんと説明して\n<color=blue>（※プロローグを見る）</color>"},
        { "location": "174/ACT"   , "narrator": "", "text": "まあ実際その通り。早く遊ばせて\n<color=blue>（※プロローグを見ない）</color>"},
        { "location": "181/TALK"  , "narrator": "千羽鶴", "text": "わかった。\nそれじゃすぐに彼女\nたちを紹介した上で――"},
        { "location": "182/TALK"  , "narrator": "千羽鶴", "text": "好きな子と自由に\nイチャコラできるように\nセッティングする。"},
        { "location": "183/TALK"  , "narrator": "千羽鶴", "text": "どんな世界で、\n彼女たちがどんな\n存在なのかは――"},
        { "location": "184/TALK"  , "narrator": "千羽鶴", "text": "存分にイチャコラした\n後に、また改めて\n紹介することにする。"},
        { "location": "186/ACT"   , "narrator": "", "text": "心配しなくても大丈夫だから、ちゃんと説明して\n<color=blue>（※プロローグを見る）</color>"},
        { "location": "188/TALK"  , "narrator": "千羽鶴", "text": "本当に？"},
        { "location": "189/TALK"  , "narrator": "千羽鶴", "text": "先に言っておくけど、\n順を追って説明する\n場合――"},
        { "location": "190/TALK"  , "narrator": "千羽鶴", "text": "私たちの住む世界の\n説明でおよそ5分。"},
        { "location": "191/TALK"  , "narrator": "千羽鶴", "text": "彼女たちがこの世界で\n何をやっているかを\n記録した映像――"},
        { "location": "192/TALK"  , "narrator": "千羽鶴", "text": "いわゆるアニメーション\nを見るので18分。"},
        { "location": "193/TALK"  , "narrator": "千羽鶴", "text": "その後、彼女たちの\nサポートの一環である\nバトル体験で10分。"},
        { "location": "194/TALK"  , "narrator": "千羽鶴", "text": "自由になるまで、\n合計およそ33分\nかかるけど、いい？"},
        { "location": "195/SEL"   , "narrator": "", "text": "オーケー"},
        { "location": "196/SEL"   , "narrator": "", "text": "嫌です"},
        { "location": "197/ACT"   , "narrator": "", "text": "オーケー"},
        { "location": "204/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "205/TALK"  , "narrator": "千羽鶴", "text": "それじゃ早速、\n私たちの事情を\n説明する。"},
        { "location": "206/ACT"   , "narrator": "", "text": "嫌です"},
        { "location": "213/TALK"  , "narrator": "千羽鶴", "text": "正直者。"},
        { "location": "214/TALK"  , "narrator": "千羽鶴", "text": "それじゃすぐに彼女\nたちを紹介した上で――"},
        { "location": "215/TALK"  , "narrator": "千羽鶴", "text": "好きな子と自由に\nイチャコラできるように\nセッティングする。"},
        { "location": "216/TALK"  , "narrator": "千羽鶴", "text": "どんな世界で、\n彼女たちがどんな\n存在なのかは――"},
        { "location": "217/TALK"  , "narrator": "千羽鶴", "text": "存分にイチャコラした\n後に、また改めて\n紹介することにする。"},
        { "location": "228/TALK"  , "narrator": "千羽鶴", "text": "私たちの世界は、\n貴方の住む世界の\nお隣の世界――"},
        { "location": "229/TALK"  , "narrator": "千羽鶴", "text": "いわゆるところの\n『平行世界』。"},
        { "location": "230/TALK"  , "narrator": "千羽鶴", "text": "社会、環境、科学など\nその殆どは、恐らく\n貴方の住む世界と同じ。"},
        { "location": "231/TALK"  , "narrator": "千羽鶴", "text": "ただ、時間的誤差は\n多少ある。"},
        { "location": "232/TALK"  , "narrator": "千羽鶴", "text": "あなたの世界では今\n何年かわからないけど、\nこちらは２０１６年。"},
        { "location": "233/TALK"  , "narrator": "千羽鶴", "text": "そして、それ以上に\n決定的な違いが、\n１つだけある。"},
        { "location": "235/TALK"  , "narrator": "千羽鶴", "text": "それは<color=purple>【[フェノメノン]】</color>と\n呼ばれる災厄が\n存在すること。"},
        { "location": "243/TALK"  , "narrator": "千羽鶴", "text": "突如出現し、人々を\n飲み込んでしまう\n謎の繭。"},
        { "location": "244/TALK"  , "narrator": "千羽鶴", "text": "それが\n<color=purple>【[フェノメノン]】</color>と\n呼ばれるものの実体。"},
        { "location": "245/TALK"  , "narrator": "千羽鶴", "text": "飲み込まれた人たちが、\n何の対処もなしに戻る\nことは、まずない。"},
        { "location": "246/TALK"  , "narrator": "千羽鶴", "text": "今、私たちの世界、\n特に首都圏では、皆\nこの災厄に怯えている。"},
        { "location": "249/TALK"  , "narrator": "千羽鶴", "text": "そんな<color=purple>【[フェノメノン]】</color>\nを対処出来る、\n唯一の存在、それが――"},
        { "location": "254/TALK"  , "narrator": "千羽鶴", "text": "<color=red>【[トライナリー]】</color>と\n呼ばれる、特別な\n少女たち。"},
        { "location": "258/TALK"  , "narrator": "千羽鶴", "text": "[國政綾水]。\nリーダー格の\n武闘派少女。"},
        { "location": "261/TALK"  , "narrator": "千羽鶴", "text": "[ガブリエラ]。\nポーランド出身の\n銃の使い手。"},
        { "location": "264/TALK"  , "narrator": "千羽鶴", "text": "[恋ヶ崎みやび]。\n世界を相手に出来る\nスーパーハッカー。"},
        { "location": "267/TALK"  , "narrator": "千羽鶴", "text": "そして[逢瀬つばめ]。\n彼女は今はまだ\nトライナリーではない。"},
        { "location": "271/TALK"  , "narrator": "千羽鶴", "text": "この少女たちこそが、\n貴方のお嫁さん候補な\nわけだけど――"},
        { "location": "272/TALK"  , "narrator": "千羽鶴", "text": "それぞれの個別の紹介は\nまた後でさせて。"},
        { "location": "280/TALK"  , "narrator": "千羽鶴", "text": "今はそれよりも、\n私たちの世界がどんな\n感じなのか――"},
        { "location": "281/TALK"  , "narrator": "千羽鶴", "text": "そして、\nフェノメノンとは\nどういうものなのか。"},
        { "location": "282/TALK"  , "narrator": "千羽鶴", "text": "それを把握してもらう\n方が先だから。"},
        { "location": "283/TALK"  , "narrator": "千羽鶴", "text": "というわけで、\n百聞は一見にしかず。"},
        { "location": "284/TALK"  , "narrator": "千羽鶴", "text": "分かりやすく私たちの\n世界を紹介する為に、\n記録映像を用意した。"},
        { "location": "285/TALK"  , "narrator": "千羽鶴", "text": "これを見れば、彼女たち\nの活躍や、フェノメノン\nの脅威がよくわかる。"},
        { "location": "286/TALK"  , "narrator": "千羽鶴", "text": "ただ、\n記録映像は動画だから、\nネットワークを逼迫する。"},
        { "location": "287/TALK"  , "narrator": "千羽鶴", "text": "今は動画は無理、という\n人の為に、あらすじも\n用意しておいた。"},
        { "location": "288/TALK"  , "narrator": "千羽鶴", "text": "ネット環境と相談して\n適切な方を選んで欲しい。"},
        { "location": "289/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/246MB 16:10】</color>"},
        { "location": "290/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/78MB 16:10】</color>"},
        { "location": "291/SEL"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "292/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/246MB 16:10】</color>"},
        { "location": "293/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "298/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/78MB 16:10】</color>"},
        { "location": "299/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "304/ACT"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "305/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "306/TALK"  , "narrator": "千羽鶴", "text": "残念だけど、いろいろ\n事情があってのことだと\n思うから。"},
        { "location": "307/TALK"  , "narrator": "千羽鶴", "text": "家に帰ったら、是非\n記録映像の方も\n見てみて欲しい。"},
        { "location": "308/TALK"  , "narrator": "千羽鶴", "text": "それではどうぞ。"},
        { "location": "328/TALK"  , "narrator": "千羽鶴", "text": "――とまあ、\n現状はこんな感じ。"},
        { "location": "329/TALK"  , "narrator": "千羽鶴", "text": "完全なる\nバッドエンドといった\nところね。"},
        { "location": "330/TALK"  , "narrator": "千羽鶴", "text": "何か聞きたいことが\nあれば。"},
        { "location": "332/SEL"   , "narrator": "", "text": "何でこんな中途半端なところで途切れてるの？"},
        { "location": "333/SEL"   , "narrator": "", "text": "つばめは死んだの？"},
        { "location": "334/SEL"   , "narrator": "", "text": "フェノメノンのこと、もうちょっと教えて欲しい"},
        { "location": "335/SEL"   , "narrator": "", "text": "専門用語だらけで全然わからない"},
        { "location": "336/SEL"   , "narrator": "", "text": "特にない\n<color=blue>（※先へ進みます）</color>"},
        { "location": "337/ACT"   , "narrator": "", "text": "何でこんな中途半端なところで途切れてるの？"},
        { "location": "338/TALK"  , "narrator": "千羽鶴", "text": "それは、現時点において\nここから先がまだ\n不確定事象だから。"},
        { "location": "339/TALK"  , "narrator": "千羽鶴", "text": "記録映像を見ても分かる\n通り、彼女たちは現時点\nで割といっぱいいっぱい。"},
        { "location": "340/TALK"  , "narrator": "千羽鶴", "text": "だから、\n精神的にも肉体的にも、\n貴方のサポートが必要。"},
        { "location": "341/SEL"   , "narrator": "", "text": "$me$に何ができるというの？"},
        { "location": "342/ACT"   , "narrator": "", "text": "$me$に何ができるというの？"},
        { "location": "344/TALK"  , "narrator": "千羽鶴", "text": "彼女たちの悩みを聞いて\n相談役になったり――"},
        { "location": "345/TALK"  , "narrator": "千羽鶴", "text": "バトルのイメージ\nトレーニングをして\nあげることができる。"},
        { "location": "346/TALK"  , "narrator": "千羽鶴", "text": "貴方は私の世界とは\n違う世界の人。"},
        { "location": "347/TALK"  , "narrator": "千羽鶴", "text": "だから、時間を遡って\n彼女たちに関わったり、\n心に入ったりできる。"},
        { "location": "348/TALK"  , "narrator": "千羽鶴", "text": "それこそが貴方の強みで\nあって、私が貴方に\n助けを求めている理由。"},
        { "location": "349/TALK"  , "narrator": "千羽鶴", "text": "貴方が彼女たちを\nサポートしてくれるか\n否かによって――"},
        { "location": "350/TALK"  , "narrator": "千羽鶴", "text": "この後の状況が\n良い方向に行くかどうか\n決まるというわけ。"},
        { "location": "351/TALK"  , "narrator": "千羽鶴", "text": "だから、\n心配しなくても大丈夫。"},
        { "location": "352/TALK"  , "narrator": "千羽鶴", "text": "貴方が協力してくれれば、\n彼女たちにとって\n悪い未来にはならない。"},
        { "location": "353/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "355/ACT"   , "narrator": "", "text": "つばめは死んだの？"},
        { "location": "356/TALK"  , "narrator": "千羽鶴", "text": "それはこれからの\nあなたの行動次第。"},
        { "location": "357/SEL"   , "narrator": "", "text": "というか、何が起こってるの？"},
        { "location": "358/ACT"   , "narrator": "", "text": "というか、何が起こってるの？"},
        { "location": "360/TALK"  , "narrator": "千羽鶴", "text": "それはおいおい\n説明する。"},
        { "location": "361/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "363/ACT"   , "narrator": "", "text": "フェノメノンのこと、もうちょっと教えて欲しい"},
        { "location": "364/TALK"  , "narrator": "千羽鶴", "text": "勉強熱心なのね。\nわかった、説明する。"},
        { "location": "372/TALK"  , "narrator": "千羽鶴", "text": "<color=purple>【フェノメノン】</color>は、\n突如この空間上に\n出現する。"},
        { "location": "373/TALK"  , "narrator": "千羽鶴", "text": "予兆は無いわけでは\nないけど、かなり\nぶれるのが現状ね。"},
        { "location": "374/TALK"  , "narrator": "千羽鶴", "text": "そして出現すると、\nそこにいた人たちを\n皆、巻き込んでしまう。"},
        { "location": "375/TALK"  , "narrator": "千羽鶴", "text": "そして巻き込まれた\n人たちは、まるで別人の\nようになってしまうの。"},
        { "location": "380/TALK"  , "narrator": "千羽鶴", "text": "なぜなら彼らは、この\n繭の中に作られた世界\nこそが現実と信じ――"},
        { "location": "381/TALK"  , "narrator": "千羽鶴", "text": "その繭が作り出した\nシナリオに洗脳されて\nしまうから。"},
        { "location": "382/TALK"  , "narrator": "千羽鶴", "text": "けど、繭の中の世界は\n大抵において、狂気に\n満ちあふれている。"},
        { "location": "387/TALK"  , "narrator": "千羽鶴", "text": "使命感を持って\nお互いを殺し合ったり\nすることもある。"},
        { "location": "388/TALK"  , "narrator": "千羽鶴", "text": "だから、<color=purple>【フェノ\nメノン】</color>が出現したら、\n放ってはおけないの。"},
        { "location": "389/TALK"  , "narrator": "千羽鶴", "text": "けど、一般の人が中に\n入れば、たちどころに\n洗脳されてしまう。"},
        { "location": "394/TALK"  , "narrator": "千羽鶴", "text": "そこで彼女たち\n<color=red>【[トライナリー]】</color>の\n出番となる。"},
        { "location": "395/TALK"  , "narrator": "千羽鶴", "text": "彼女たちは、この世界で\n唯一、フェノメノンに\n洗脳されずに戦える。"},
        { "location": "396/TALK"  , "narrator": "千羽鶴", "text": "彼女たちが戦っている\nからこそ、今の日本が\n存在できている。"},
        { "location": "397/TALK"  , "narrator": "千羽鶴", "text": "これは決して、\n大げさな言い方ではない。"},
        { "location": "405/TALK"  , "narrator": "千羽鶴", "text": "――以上。\nこんな感じでOK？"},
        { "location": "406/TALK"  , "narrator": "千羽鶴", "text": "他に何かあれば。"},
        { "location": "408/ACT"   , "narrator": "", "text": "専門用語だらけで全然わからない"},
        { "location": "409/TALK"  , "narrator": "千羽鶴", "text": "私もそう思う。"},
        { "location": "410/TALK"  , "narrator": "千羽鶴", "text": "でも、そういう時は\n考えてはダメ。感じるの！"},
        { "location": "411/SEL"   , "narrator": "", "text": "それってごまかしですよねえ"},
        { "location": "412/ACT"   , "narrator": "", "text": "それってごまかしですよねえ"},
        { "location": "414/TALK"  , "narrator": "千羽鶴", "text": "実際仕方ない。"},
        { "location": "415/TALK"  , "narrator": "千羽鶴", "text": "これはあくまで記録映像\nだから、初心者への\n配慮は十分ではない。"},
        { "location": "416/TALK"  , "narrator": "千羽鶴", "text": "んー、でも、そうね。"},
        { "location": "417/TALK"  , "narrator": "千羽鶴", "text": "近い将来、私が貴方と\nマンツーマンで、動画を\n解説してあげる。"},
        { "location": "418/TALK"  , "narrator": "千羽鶴", "text": "用語や、何が起こってる\nかを見ながら、一緒に\n記録映像を見るの。"},
        { "location": "419/TALK"  , "narrator": "千羽鶴", "text": "準備に少し時間が\nかかるから、もう\nちょっと待って欲しい。"},
        { "location": "420/TALK"  , "narrator": "千羽鶴", "text": "他に何かあれば。"},
        { "location": "422/ACT"   , "narrator": "", "text": "特にない\n<color=blue>（※先へ進みます）</color>"},
        { "location": "423/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "315/DIALOG", "narrator": "Tutorial/Dialog_Anime2", "text": "逢瀬つばめは、大好きなアーティスト\nFreyMENOWのライブを見に\n東京へ向かった。\n\nだが、そこで歌うFreyMENOWの歌を\n聞いた途端、つばめは頭が割れそうな\n程の頭痛に襲われてしまう。\n\n敵（女剣士）は手強く、逢瀬つばめも\n常に近くにいるため、トライナリーは\nなかなか女剣士に手出し出来ない。\n\nやっとのことでつばめを保護するが\nつばめは保護を拒否し、\nFreyMENOWを助けたいと言う。\n\nつばめには何かあると思ったみやびは\nつばめを守りつつメノウを助けに行く。\n\nだがそれが仇となった。\nあと少しでメノウを助けられる、\nそんな時油断したのだ。\n\n<b><color=red>逢瀬つばめは女騎士に一突きされ、\n心臓を貫かれて死亡した。</color></b>\n"}
    ]
}
