{
    "dir": "chap24/daydra/anime_02_24.js",
    "type": "MainStory",
    "info": {
        "story_id": "24201",
        "cid": "ayami",
        "title": "001 アニメーション",
        "sub_title": "三戸浜からの手紙"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "アニメ第24話"},
        { "location": "47/TALK"   , "narrator": "千羽鶴", "text": "ごきげんよう、\n$handle$。"},
        { "location": "49/TALK"   , "narrator": "千羽鶴", "text": "いつも通り、今回も\n逢瀬つばめの解説を\nするだけでいい？"},
        { "location": "51/TALK"   , "narrator": "千羽鶴", "text": "いつも通り、今回も\n國政綾水の解説を\nするだけでいい？"},
        { "location": "53/TALK"   , "narrator": "千羽鶴", "text": "いつも通り、今回も\nガブリエラの解説を\nするだけでいい？"},
        { "location": "55/TALK"   , "narrator": "千羽鶴", "text": "いつも通り、今回も\n恋ヶ崎みやびの解説を\nするだけでいい？"},
        { "location": "57/SEL"    , "narrator": "", "text": "はい"},
        { "location": "58/SEL"    , "narrator": "", "text": "いいえ"},
        { "location": "59/ACT"    , "narrator": "", "text": "はい"},
        { "location": "61/TALK"   , "narrator": "千羽鶴", "text": "よかった。\n私も助かる。\nこれぞWIN-WINね。"},
        { "location": "63/ACT"    , "narrator": "", "text": "いいえ"},
        { "location": "64/TALK"   , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "82/TALK"   , "narrator": "千羽鶴", "text": "おめでとう、私たち。"},
        { "location": "83/SEL"    , "narrator": "", "text": "何この背景！？"},
        { "location": "84/SEL"    , "narrator": "", "text": "ついに千羽鶴と$me$が結婚するの？"},
        { "location": "85/ACT"    , "narrator": "", "text": "何この背景！？"},
        { "location": "86/TALK"   , "narrator": "千羽鶴", "text": "お祝い用の演出。"},
        { "location": "87/ACT"    , "narrator": "", "text": "ついに千羽鶴と$me$が結婚するの？"},
        { "location": "88/TALK"   , "narrator": "千羽鶴", "text": "黙れ。"},
        { "location": "90/TALK"   , "narrator": "千羽鶴", "text": "いよいよ今回の\n記録映像で、\nフェイズⅡが終了する。"},
        { "location": "91/TALK"   , "narrator": "千羽鶴", "text": "途中、バタフライ\nエフェクトが発生し、\n一時実現可能性は急落。"},
        { "location": "92/TALK"   , "narrator": "千羽鶴", "text": "もはや数年は実現不可能\nかと思われたけど。"},
        { "location": "93/TALK"   , "narrator": "千羽鶴", "text": "様々な抜本的改革と、\n筋書きの変更により、\n今回で達成の見込み。"},
        { "location": "94/TALK"   , "narrator": "千羽鶴", "text": "そして次回から\nいよいよフェイズⅢに\n突入する。"},
        { "location": "95/SEL"    , "narrator": "", "text": "おめでとうございます"},
        { "location": "96/ACT"    , "narrator": "", "text": "おめでとうございます"},
        { "location": "98/TALK"   , "narrator": "千羽鶴", "text": "ありがと。"},
        { "location": "99/TALK"   , "narrator": "千羽鶴", "text": "ビックリすると思うから\n先に伝えておくと――"},
        { "location": "100/TALK"  , "narrator": "千羽鶴", "text": "次回以降、\n私の姿は変わる。"},
        { "location": "101/SEL"   , "narrator": "", "text": "変身するの！？"},
        { "location": "102/SEL"   , "narrator": "", "text": "胸が大きくなるの！？"},
        { "location": "103/ACT"   , "narrator": "", "text": "変身するの！？"},
        { "location": "104/TALK"  , "narrator": "千羽鶴", "text": "変身…。"},
        { "location": "105/TALK"  , "narrator": "千羽鶴", "text": "そうね。\n言葉の意味的には\n変身で間違いない。"},
        { "location": "106/ACT"   , "narrator": "", "text": "胸が大きくなるの！？"},
        { "location": "107/TALK"  , "narrator": "千羽鶴", "text": "ならないから。\nオッパイ星人。"},
        { "location": "109/TALK"  , "narrator": "千羽鶴", "text": "まあ、私の姿が変わるのは\nそれ自体に意味がある\nものではないのだけど。"},
        { "location": "110/TALK"  , "narrator": "千羽鶴", "text": "むしろ、今回の\n過程において必然的に\n起こる結果でしかない。"},
        { "location": "111/SEL"   , "narrator": "", "text": "今回何が起こるの？"},
        { "location": "112/SEL"   , "narrator": "", "text": "フェイズⅡは何をもって終了となるの？"},
        { "location": "113/ACT"   , "narrator": "", "text": "今回何が起こるの？"},
        { "location": "114/ACT"   , "narrator": "", "text": "フェイズⅡは何をもって終了となるの？"},
        { "location": "116/TALK"  , "narrator": "千羽鶴", "text": "それは今回の\n記録映像を見て\n自分で確認して欲しい。"},
        { "location": "117/TALK"  , "narrator": "千羽鶴", "text": "未来予測の誤差が\n想定の範囲内なら次回。"},
        { "location": "118/TALK"  , "narrator": "千羽鶴", "text": "少し大きかったとしても、\n恐らくは次々回、\n起こることだから。"},
        { "location": "119/TALK"  , "narrator": "千羽鶴", "text": "さて。"},
        { "location": "121/TALK"  , "narrator": "千羽鶴", "text": "せっかくなので、\n今からフェイズⅢについて\n少し話したいと思う。"},
        { "location": "122/TALK"  , "narrator": "千羽鶴", "text": "フェイズⅢでは、いよいよ\n輝ける未来を私と貴方とで\n創造する為の準備に入る。"},
        { "location": "123/TALK"  , "narrator": "千羽鶴", "text": "その準備を滞りなく進める\nために、まずは貴方の\n認識を聞きたい。"},
        { "location": "124/TALK"  , "narrator": "千羽鶴", "text": "人が億単位で存在する\n社会において、争いのない\n世界を創造するとして。"},
        { "location": "125/TALK"  , "narrator": "千羽鶴", "text": "最もその可能性が高い\n方法とは何だと思う？"},
        { "location": "126/SEL"   , "narrator": "", "text": "民主主義的に市民の声によって方針を決める"},
        { "location": "127/SEL"   , "narrator": "", "text": "一人ないし少数のエリートによって方針を決める"},
        { "location": "128/ACT"   , "narrator": "", "text": "民主主義的に市民の声によって方針を決める"},
        { "location": "131/TALK"  , "narrator": "千羽鶴", "text": "なるほど。"},
        { "location": "132/TALK"  , "narrator": "千羽鶴", "text": "確かに民意を反映するのは\nとても大事。"},
        { "location": "133/TALK"  , "narrator": "千羽鶴", "text": "極端にぶれる事も無いから\n平均的かつ無難な舵取りが\n続く傾向にある。"},
        { "location": "134/TALK"  , "narrator": "千羽鶴", "text": "ただしこの手法をとると、\nほぼ１００％数の暴力に\nよる争いが発生する。"},
        { "location": "135/TALK"  , "narrator": "千羽鶴", "text": "常に多数派と少数派による\n戦争が起こっている状態。"},
        { "location": "136/TALK"  , "narrator": "千羽鶴", "text": "決して平和とは\n言い難い。"},
        { "location": "137/TALK"  , "narrator": "千羽鶴", "text": "それは多数派にいるうちは\nわからないけど、一度\n少数派になれば――"},
        { "location": "138/TALK"  , "narrator": "千羽鶴", "text": "場合によっては\n血の滲むような苦しみを\n強いられることになる。"},
        { "location": "139/ACT"   , "narrator": "", "text": "一人ないし少数のエリートによって方針を決める"},
        { "location": "142/TALK"  , "narrator": "千羽鶴", "text": "なるほど。"},
        { "location": "143/TALK"  , "narrator": "千羽鶴", "text": "少数の人間による多数の\n統率は、確かに歴史的に\n見て最も確実な集団統率。"},
        { "location": "144/TALK"  , "narrator": "千羽鶴", "text": "エリートの資質によっては\n非常に平和な環境が構築\nされることもある。"},
        { "location": "145/TALK"  , "narrator": "千羽鶴", "text": "ただしその部分に委ねる\n割合が非常に大きく、\n得てしてそれは失敗する。"},
        { "location": "146/TALK"  , "narrator": "千羽鶴", "text": "一握りの存在による\n権力の集中は、その存在に\nよる富の集中を起こす。"},
        { "location": "147/TALK"  , "narrator": "千羽鶴", "text": "そしていずれは、それは\nエリートVSその他大勢\nという争いに発展する。"},
        { "location": "148/TALK"  , "narrator": "千羽鶴", "text": "発展しない場合でも、\nエリートが必要以上に\n束縛する場合がある。"},
        { "location": "149/TALK"  , "narrator": "千羽鶴", "text": "結果として、奇跡が\n起こらない限り、多数は\n窮屈な思いをしがち。"},
        { "location": "151/TALK"  , "narrator": "千羽鶴", "text": "というわけで。"},
        { "location": "152/TALK"  , "narrator": "千羽鶴", "text": "その方法では、輝ける\n未来の実現可能性は、相当\n低いと言わざるを得ない。"},
        { "location": "162/SEL"   , "narrator": "", "text": "ちょっと待って！"},
        { "location": "163/ACT"   , "narrator": "", "text": "ちょっと待って！"},
        { "location": "165/TALK"  , "narrator": "千羽鶴", "text": "なに？"},
        { "location": "166/SEL"   , "narrator": "", "text": "どっちを選んでもだめっぽいんだけど"},
        { "location": "167/ACT"   , "narrator": "", "text": "どっちを選んでもだめっぽいんだけど"},
        { "location": "169/TALK"  , "narrator": "千羽鶴", "text": "そうね。"},
        { "location": "170/TALK"  , "narrator": "千羽鶴", "text": "貴方は優秀。"},
        { "location": "171/TALK"  , "narrator": "千羽鶴", "text": "人が無秩序に存在する\n世界において、平和などは\n存在し得ない。"},
        { "location": "172/TALK"  , "narrator": "千羽鶴", "text": "それは人に依らない。\nほ乳類から微生物まで\n全てに該当する。"},
        { "location": "173/TALK"  , "narrator": "千羽鶴", "text": "全ての生物は弱肉強食、\nすなわち争うことを\n世界に宿命とされている。"},
        { "location": "174/TALK"  , "narrator": "千羽鶴", "text": "この世界を誰が創ったのか\n私にはわからないけど――"},
        { "location": "175/TALK"  , "narrator": "千羽鶴", "text": "苦痛によって進化と成長を\n促すこの世界のルールは、\n甚だ常軌を逸している。"},
        { "location": "176/TALK"  , "narrator": "千羽鶴", "text": "その大ルールの中に\n小ルールとしての平和を\n創造するには――"},
        { "location": "177/TALK"  , "narrator": "千羽鶴", "text": "大ルールの外の存在が、\n惨い大ルールを覆い隠す\n小ルールを作るしかない。"},
        { "location": "178/SEL"   , "narrator": "", "text": "大ルール外の存在って何？"},
        { "location": "179/ACT"   , "narrator": "", "text": "大ルール外の存在って何？"},
        { "location": "181/TALK"  , "narrator": "千羽鶴", "text": "大ルールによって\n創造された存在以外の\n存在。"},
        { "location": "182/TALK"  , "narrator": "千羽鶴", "text": "すなわち、全ての生物は\n大ルール外の存在には\nなり得ない。"},
        { "location": "183/SEL"   , "narrator": "", "text": "それって詰んでるじゃん"},
        { "location": "184/ACT"   , "narrator": "", "text": "それって詰んでるじゃん"},
        { "location": "186/TALK"  , "narrator": "千羽鶴", "text": "いいえ。"},
        { "location": "187/TALK"  , "narrator": "千羽鶴", "text": "結論の前に、何故\n大ルールに創造された\n存在ではダメなのか――"},
        { "location": "188/TALK"  , "narrator": "千羽鶴", "text": "それについて\n話をしたいと思う。"},
        { "location": "189/TALK"  , "narrator": "千羽鶴", "text": "大ルールに創造された者、\nすなわち生命は、購えない\nギアスがある。"},
        { "location": "190/TALK"  , "narrator": "千羽鶴", "text": "それは主観視点。"},
        { "location": "191/TALK"  , "narrator": "千羽鶴", "text": "自らを主軸とした\n非常に特異かつ強烈な\nスコープしか持ち得ない。"},
        { "location": "192/TALK"  , "narrator": "千羽鶴", "text": "だから争いが発生するし、\n生命では生命を平和に\n導けない理由でもある。"},
        { "location": "193/TALK"  , "narrator": "千羽鶴", "text": "以前貴方が選んだ選択――"},
        { "location": "195/TALK"  , "narrator": "千羽鶴", "text": "『彼女の為に世界を犠牲に\nする』及び、"},
        { "location": "197/TALK"  , "narrator": "千羽鶴", "text": "『世界の為に彼女を犠牲に\nする』及び、"},
        { "location": "199/TALK"  , "narrator": "千羽鶴", "text": "……。\nいや、貴方は何も\n選んでいなかった。"},
        { "location": "200/TALK"  , "narrator": "千羽鶴", "text": "いずれにせよ、\n例え貴方がいずれかを\n選択していたとしても。"},
        { "location": "201/TALK"  , "narrator": "千羽鶴", "text": "何かを犠牲にするという\n前提は覆せない。"},
        { "location": "204/TALK"  , "narrator": "千羽鶴", "text": "『彼女の為に千羽鶴を\n犠牲にする』という\n選択は、ある意味妥当。"},
        { "location": "206/TALK"  , "narrator": "千羽鶴", "text": "『千羽鶴の為に彼女を\n犠牲にする』という\n選択は、ある意味妥当。"},
        { "location": "209/TALK"  , "narrator": "千羽鶴", "text": "それは、生命という枠の\n中だけで物事を考える際の\n限界ともいえる。"},
        { "location": "210/TALK"  , "narrator": "千羽鶴", "text": "けれども。"},
        { "location": "211/TALK"  , "narrator": "千羽鶴", "text": "弱肉強食のこの世界から\n身を守る存在がいれば、\nこの究極問題は解決する。"},
        { "location": "212/TALK"  , "narrator": "千羽鶴", "text": "そして、貴方と私が\n力を合わせれば、\nそれは実現可能。"},
        { "location": "213/SEL"   , "narrator": "", "text": "どうやって？"},
        { "location": "214/ACT"   , "narrator": "", "text": "どうやって？"},
        { "location": "216/TALK"  , "narrator": "千羽鶴", "text": "それは次回以降、\n具体的な実践と共に\nやっていく。"},
        { "location": "218/TALK"  , "narrator": "千羽鶴", "text": "もっと深く、\n世界の在り方について\n考えて欲しいところ。"},
        { "location": "219/TALK"  , "narrator": "千羽鶴", "text": "表面的な部分だけでなく、\n核心に至るまでじっくり\n考えて、再度回答して。"},
        { "location": "221/TALK"  , "narrator": "千羽鶴", "text": "いずれにせよ、まずは\nフェイズⅡ完了を\n見届けなければならない。"},
        { "location": "222/TALK"  , "narrator": "千羽鶴", "text": "というわけで、\n記録映像を見ましょ。"},
        { "location": "225/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/75MB 4:31】</color>"},
        { "location": "226/SEL"   , "narrator": "", "text": "映像を見\n<color=green>【標準画質/24MB 4:31】</color>"},
        { "location": "227/SEL"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "228/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/75MB 4:31】</color>"},
        { "location": "229/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "235/ACT"   , "narrator": "", "text": "映像を見\n<color=green>【標準画質/24MB 4:31】</color>"},
        { "location": "236/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "242/ACT"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "243/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "276/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "277/TALK"  , "narrator": "千羽鶴", "text": "想定外の存在が\n介入してきてる……？"},
        { "location": "278/TALK"  , "narrator": "千羽鶴", "text": "まさか、“あれ”が？\nずっと監視してきて\nいたはずなんだけど。"},
        { "location": "279/SEL"   , "narrator": "", "text": "何かお困りですか？"},
        { "location": "280/ACT"   , "narrator": "", "text": "何かお困りですか？"},
        { "location": "282/TALK"  , "narrator": "千羽鶴", "text": "甚だしく。"},
        { "location": "283/TALK"  , "narrator": "千羽鶴", "text": "予定が変わった。\nフェイズⅢ移行は\n少し延期になる。"},
        { "location": "284/SEL"   , "narrator": "", "text": "そんなことばかりじゃない？"},
        { "location": "285/SEL"   , "narrator": "", "text": "真幌がストを決行したのがまずかったの？"},
        { "location": "286/SEL"   , "narrator": "", "text": "音羽が歌ってたのがまずかったの？"},
        { "location": "287/ACT"   , "narrator": "", "text": "そんなことばかりじゃない？"},
        { "location": "288/TALK"  , "narrator": "千羽鶴", "text": "そうね。\n世界を動かすって\nそれくらい大変なこと。"},
        { "location": "289/ACT"   , "narrator": "", "text": "真幌がストを決行したのがまずかったの？"},
        { "location": "290/TALK"  , "narrator": "千羽鶴", "text": "それは想定内。\n何の問題もない。"},
        { "location": "291/ACT"   , "narrator": "", "text": "音羽が歌ってたのがまずかったの？"},
        { "location": "292/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "293/TALK"  , "narrator": "千羽鶴", "text": "そうね。貴方はとても\n鋭い。私の右腕として\n申し分ない。"},
        { "location": "294/TALK"  , "narrator": "千羽鶴", "text": "貴方の聡明さに期待して、\n少し説明する。"},
        { "location": "295/TALK"  , "narrator": "千羽鶴", "text": "音羽は既に\nココロが壊れている。"},
        { "location": "296/TALK"  , "narrator": "千羽鶴", "text": "それは、\nクランを引き抜いただけの\n状況よりも、遙かに甚大。"},
        { "location": "297/TALK"  , "narrator": "千羽鶴", "text": "歌を唱うなど、\n本人の意志では\n絶対に無理。"},
        { "location": "298/TALK"  , "narrator": "千羽鶴", "text": "方法はただ１つ。\n他者がココロ経由で\n何らかの支援をした。"},
        { "location": "299/TALK"  , "narrator": "千羽鶴", "text": "それができる存在は\nごくごく限られている。"},
        { "location": "301/TALK"  , "narrator": "千羽鶴", "text": "申し訳無いけど、\n今回は記録映像の質問を\n受けている暇がない。"},
        { "location": "302/TALK"  , "narrator": "千羽鶴", "text": "すぐに準備をして\n実行しないと、後々\n厄介なことになる。"},
        { "location": "303/TALK"  , "narrator": "千羽鶴", "text": "というわけで離席。\n貴方とはまた後ほど。"},
        { "location": "304/TALK"  , "narrator": "千羽鶴", "text": "ココロスフィアで\n逢いましょ。"},
