        "title": "007 ココロスフィアストーリー【Lv03】",
        "sub_title": "敵Ⅲ＜提起＞"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "敵Ⅱ３"},
        { "location": "13/DIALOG" , "narrator": "", "text": "<size=40>KOKORO-Lv. 03</size>\nMIYABI - KOIGASAKI\n\n<size=45>敵Ⅲ</size>\n<size=35>～邂逅編～</size>"},
        { "location": "24/TALK"   , "narrator": "潜在みやび", "text": "ぱぱーん。"},
        { "location": "25/TALK"   , "narrator": "表層みやび", "text": "結果を発表します！"},
        { "location": "26/SEL"    , "narrator": "（選択肢）", "text": "……なんの、ですか？"},
        { "location": "27/ACT"    , "narrator": "", "text": "……なんの、ですか？"},
        { "location": "29/TALK"   , "narrator": "潜在みやび", "text": "決まってるちや。"},
        { "location": "30/TALK"   , "narrator": "表層みやび", "text": "$handle$が\n情報管理庁の\n差し金か否かや。"},
        { "location": "32/TALK"   , "narrator": "潜在みやび", "text": "それでは、\n結果は！？"},
        { "location": "33/DIALOG" , "narrator": "", "text": "結果発表！"},
        { "location": "35/TALK"   , "narrator": "表層みやび", "text": "クックックッ……"},
        { "location": "36/TALK"   , "narrator": "表層みやび", "text": "結果は！！"},
        { "location": "40/TALK"   , "narrator": "表層みやび", "text": "白！！"},
        { "location": "42/TALK"   , "narrator": "潜在みやび", "text": "おめでとう\nございました！"},
        { "location": "43/SEL"    , "narrator": "（選択肢）", "text": "ありがとうございました…"},
        { "location": "44/ACT"    , "narrator": "", "text": "ありがとうございました…"},
        { "location": "46/TALK"   , "narrator": "表層みやび", "text": "というわけで、\nお前さんの疑いは\n晴れたわけやが。"},
        { "location": "47/SEL"    , "narrator": "（選択肢）", "text": "なんで晴れたの？"},
        { "location": "48/ACT"    , "narrator": "", "text": "なんで晴れたの？"},
        { "location": "50/DIALOG" , "narrator": "", "text": "総評。"},
        { "location": "51/TALK"   , "narrator": "潜在みやび", "text": "まあ簡単に言えば、\n釣り針に全く引っか\nからなかったちや。"},
        { "location": "52/TALK"   , "narrator": "表層みやび", "text": "そう。うちらは\n表層世界で沢山罠を\n張っちょったきね。"},
        { "location": "53/TALK"   , "narrator": "潜在みやび", "text": "けんど、お前さんは\n全くトンチンカンな\n反応ばかりやった。"},
        { "location": "54/TALK"   , "narrator": "表層みやび", "text": "フェイクかとも\n思うたが――"},
        { "location": "55/TALK"   , "narrator": "潜在みやび", "text": "スパイならここまでの\nチャンスを棒に振る\n事は無いと判断。"},
        { "location": "56/TALK"   , "narrator": "表層みやび", "text": "よってひとまずは\n白ってことに\nなったちや。"},
        { "location": "59/TALK"   , "narrator": "潜在みやび", "text": "が！　しかし！！"},
        { "location": "62/DIALOG" , "narrator": "", "text": "<size=50>【特報】</size>"},
        { "location": "63/TALK"   , "narrator": "表層みやび", "text": "世界に平和は\n訪れなかった！"},
        { "location": "64/TALK"   , "narrator": "潜在みやび", "text": "いよいよ始まる\n新展開！"},
        { "location": "65/TALK"   , "narrator": "表層みやび", "text": "あの名作、『疑いの\n情報管理庁』を越える\n壮大なスケール！"},
        { "location": "66/SEL"    , "narrator": "（選択肢）", "text": "いや、もういいよ…"},
        { "location": "67/ACT"    , "narrator": "", "text": "いや、もういいよ…"},
        { "location": "69/TALK"   , "narrator": "潜在みやび", "text": "その名も！！"},
        { "location": "71/TALK"   , "narrator": "表層みやび", "text": "『何故に君\n　構うこと早幾年』"},
        { "location": "72/DIALOG" , "narrator": "", "text": "何故に君構うこと早幾年"},
        { "location": "73/SEL"    , "narrator": "（選択肢）", "text": "日本語としておかしくないですか？"},
        { "location": "74/ACT"    , "narrator": "", "text": "日本語としておかしくないですか？"},
        { "location": "77/TALK"   , "narrator": "潜在みやび", "text": "そんなことは\nどうでもえいちや！"},
        { "location": "78/TALK"   , "narrator": "表層みやび", "text": "大事なのは勢い！\nそれとリズム！"},
        { "location": "79/TALK"   , "narrator": "潜在みやび", "text": "…とまあ、タイトルは\nどうでもえいんやが。"},
        { "location": "80/TALK"   , "narrator": "表層みやび", "text": "要は、なんでお前さん\nが、うちに構いゆうか\nが議論になっちょる。"},
        { "location": "81/TALK"   , "narrator": "潜在みやび", "text": "何か裏があるのか？"},
        { "location": "82/TALK"   , "narrator": "表層みやび", "text": "下心があるのか？"},
        { "location": "83/TALK"   , "narrator": "潜在みやび", "text": "そもそもAIなのか？"},
        { "location": "84/TALK"   , "narrator": "表層みやび", "text": "それとも中の人が\nいるのか？"},
        { "location": "85/TALK"   , "narrator": "潜在みやび", "text": "だとしたら、\n何が目的なのか？"},
        { "location": "86/TALK"   , "narrator": "表層みやび", "text": "そして。"},
        { "location": "88/TALK"   , "narrator": "潜在みやび", "text": "それはうちにとって\n利益なのか、\n不利益なのか！"},
        { "location": "89/DIALOG" , "narrator": "", "text": "利益か。不利益か。"},
        { "location": "90/TALK"   , "narrator": "潜在みやび", "text": "まあ、下心や\n不利益な目的がある\nならここでお終いや。"},
        { "location": "91/TALK"   , "narrator": "表層みやび", "text": "そう思いゆう人格と"},
        { "location": "92/TALK"   , "narrator": "潜在みやび", "text": "そうでない人格とで"},
        { "location": "93/TALK"   , "narrator": "表層みやび", "text": "また議論してるちや。"},
        { "location": "94/TALK"   , "narrator": "潜在みやび", "text": "そんなわけやき、"},
        { "location": "95/TALK"   , "narrator": "表層みやび", "text": "懲りてなければ、\nそんなうちらの戦い\nつき合っちょくれや。"},
        { "location": "96/TALK"   , "narrator": "潜在みやび", "text": "とかいいつつ、\n懲りていようが\nいまいが、"},
        { "location": "97/TALK"   , "narrator": "表層みやび", "text": "強制的に\nバトル突入なんや\nけんどな。"},
        { "location": "109/DIALOG", "narrator": "", "text": "<color=black><size=50><b>ココロの戦いに協力し\n立ち位置を明確にせよ！</b></size></color>\n\n\n\n恋ヶ崎みやびは、\n貴方がどのような存在なのかについて\n未だに結論を出せずにいる。\n\n頭では理解しても、\nココロでは納得出来ない感覚。\n\nその気持ちに決着をつけ、\n貴方とみやびの関係を強固なものにしよう。"}
    ]
}
