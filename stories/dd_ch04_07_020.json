{
    "dir": "chap07/daydra/dd_ch04_07_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "7456",
        "cid": "miyabi",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "評判サイト"
    },
    "entry":
    [
        { "location": "169/SCENARIO", "narrator": "", "text": "評判サイト"},
        { "location": "183/TALK"    , "narrator": "みやび", "text": "ふむ…思ってた\nよりかは面白いな。"},
        { "location": "186/TALK"    , "narrator": "ガブリエラ", "text": "何が面白いのよ？"},
        { "location": "188/TALK"    , "narrator": "みやび", "text": "いやな、ちっくと\nネットサーフィン\nしちょったら――"},
        { "location": "190/TALK"    , "narrator": "みやび", "text": "映画館の評判サイトで、\nここのことも書かれ\nとったんよ。"},
        { "location": "191/TALK"    , "narrator": "ガブリエラ", "text": "えっ、どれどれ！？"},
        { "location": "192/TALK"    , "narrator": "みやび", "text": "ほれ、このスレ\n見てみい。"},
        { "location": "199/TALK"    , "narrator": "ガブリエラ", "text": "えっと、なになに…。"},
        { "location": "200/TALK"    , "narrator": "ガブリエラ", "text": "「何故潰れない？」\n「マイナー過ぎだろ！」\n「神楽坂七不思議」"},
        { "location": "202/TALK"    , "narrator": "ガブリエラ", "text": "…まあ、当然ながら\nいい評判じゃないわね。"},
        { "location": "205/TALK"    , "narrator": "みやび", "text": "そらそうや。\n客のほとんど来ない\nマイナー映画館やき――"},
        { "location": "206/TALK"    , "narrator": "みやび", "text": "評判があるだけでも、\n不思議なくらいや。"},
        { "location": "209/TALK"    , "narrator": "ガブリエラ", "text": "そうね…。"},
        { "location": "213/TALK"    , "narrator": "ガブリエラ", "text": "とりあえず、みやび。"},
        { "location": "214/TALK"    , "narrator": "ガブリエラ", "text": "神楽坂トライナリーは\n最高の映画館、って\n書き込みして。"},
        { "location": "216/TALK"    , "narrator": "みやび", "text": "ガブちゃん…\n自演なんかしても\nえいことないんよ。"},
        { "location": "218/TALK"    , "narrator": "みやび", "text": "それに、この流れやと\nどう考えても自演て\nバレバレや。"},
        { "location": "219/TALK"    , "narrator": "ガブリエラ", "text": "でも、働いているとこ\nに悪評があるなんて\n我慢できないわ！"},
        { "location": "222/TALK"    , "narrator": "みやび", "text": "…ワガママやなぁ。"},
        { "location": "228/TALK"    , "narrator": "みやび", "text": "おーい"},
        { "location": "229/TALK"    , "narrator": "みやび", "text": "またガブちゃんのワガママスキルが発動中や"},
        { "location": "230/TALK"    , "narrator": "みやび", "text": "映画館の評判サイトで自演しろ言うてきたが"},
        { "location": "231/TALK"    , "narrator": "みやび", "text": "正直、あまり乗り気がせんちや"},
        { "location": "232/TALK"    , "narrator": "みやび", "text": "バレバレ確実やし"},
        { "location": "233/TALK"    , "narrator": "みやび", "text": "あんたはどう思う？"},
        { "location": "235/SEL"     , "narrator": "", "text": "暇つぶしにはなるよ"},
        { "location": "236/SEL"     , "narrator": "", "text": "ラーメンの話題に逸らそう"},
        { "location": "237/SEL"     , "narrator": "", "text": "バイトの子は可愛いと書け"},
        { "location": "238/ACT"     , "narrator": "", "text": "暇つぶしにはなるよ"},
        { "location": "239/TALK"    , "narrator": "みやび", "text": "確かに"},
        { "location": "240/TALK"    , "narrator": "みやび", "text": "暇つぶしに、おもいっきし自演してみるき"},
        { "location": "241/TALK"    , "narrator": "みやび", "text": "よっしゃー、みやび行きまーす！！"},
        { "location": "243/TALK"    , "narrator": "みやび", "text": "なんてな"},
        { "location": "248/TALK"    , "narrator": "みやび", "text": "やるだけやるけんど、\n責任は持たんぞね？"},
        { "location": "249/TALK"    , "narrator": "ガブリエラ", "text": "いいから、\nおもいっきり\nやっちゃって！"},
        { "location": "251/TALK"    , "narrator": "みやび", "text": "…ラジャー。\n「トライナリーは最高に\nクール」っと…。"},
        { "location": "263/TALK"    , "narrator": "ガブリエラ", "text": "みやび、\nサイトの評判は\nどうなった？"},
        { "location": "265/TALK"    , "narrator": "みやび", "text": "いやー、凄いことに\nなっとるよ。"},
        { "location": "267/TALK"    , "narrator": "みやび", "text": "たった一時間で\nこの有様や。"},
        { "location": "271/TALK"    , "narrator": "ガブリエラ", "text": "えっと…「自演乙」\n「社員キター」\n「暇なんですね」…。"},
        { "location": "273/TALK"    , "narrator": "ガブリエラ", "text": "な、何よこれー！？\nあたし達が書いたって\nバレてるじゃない！"},
        { "location": "276/TALK"    , "narrator": "みやび", "text": "だから\nえいこと無いって\n言うたのに…。"},
        { "location": "277/ACT"     , "narrator": "", "text": "ラーメンの話題に逸らそう"},
        { "location": "278/TALK"    , "narrator": "みやび", "text": "あんたもガブちゃんと同じやね"},
        { "location": "279/TALK"    , "narrator": "みやび", "text": "突然無茶苦茶なこと言いよる"},
        { "location": "280/TALK"    , "narrator": "みやび", "text": "まあ"},
        { "location": "281/TALK"    , "narrator": "みやび", "text": "面白そうやき、花丸満点の答えや"},
        { "location": "286/TALK"    , "narrator": "みやび", "text": "よし、あとはうちが\n何とかしとくき――"},
        { "location": "287/TALK"    , "narrator": "みやび", "text": "ガブちゃんは仕事して\n待っとればえいよ。"},
        { "location": "289/TALK"    , "narrator": "ガブリエラ", "text": "さすがみやびね。\n楽しみにしてるわ。"},
        { "location": "293/TALK"    , "narrator": "みやび", "text": "さて…「そんなことより\n腹減ったから、美味い\nラーメン屋教えて」と。"},
        { "location": "304/TALK"    , "narrator": "みやび", "text": "ほほぅ…えい情報や。\n場所を\nメモッとかんと…。"},
        { "location": "305/TALK"    , "narrator": "ガブリエラ", "text": "みやび、どんな感じ？\n少しはいい評判たった？"},
        { "location": "307/TALK"    , "narrator": "みやび", "text": "ガブちゃん、見てみい。\n悪評は完全に消えたき、\nもう安心や。"},
        { "location": "312/TALK"    , "narrator": "ガブリエラ", "text": "どれどれ…"},
        { "location": "313/TALK"    , "narrator": "ガブリエラ", "text": "「やっぱ醤油は王道」\n「ラーメンは味噌だ！」\n「ニンニクを盛れ」"},
        { "location": "314/TALK"    , "narrator": "ガブリエラ", "text": "…え？\nちょっとこれ、\nどうなってんの？"},
        { "location": "317/TALK"    , "narrator": "みやび", "text": "うちの悪評が出ん\nように、ラーメンの\n話題に誘導したんよ。"},
        { "location": "320/TALK"    , "narrator": "みやび", "text": "今じゃもうラーメンの\n話以外出ないき、\nこれで安心やな。"},
        { "location": "321/TALK"    , "narrator": "ガブリエラ", "text": "悪評は無くなったけど\n結局いい評判が一つも\n無いままじゃない！"},
        { "location": "322/TALK"    , "narrator": "ガブリエラ", "text": "これじゃ\n意味ないじゃん！"},
        { "location": "326/TALK"    , "narrator": "みやび", "text": "…そもそもえい評判が\n出るような映画館や\nないんやけんどね。"},
        { "location": "327/ACT"     , "narrator": "", "text": "バイトの子は可愛いと書け"},
        { "location": "329/TALK"    , "narrator": "みやび", "text": "あんた、いいところに気づいたな"},
        { "location": "331/TALK"    , "narrator": "みやび", "text": "うちの映画館で唯一誇れるところや"},
        { "location": "336/TALK"    , "narrator": "みやび", "text": "よし、あとはうちが\n何とかしとくき――"},
        { "location": "337/TALK"    , "narrator": "みやび", "text": "ガブちゃんは仕事して\n待っとればえいよ。"},
        { "location": "338/TALK"    , "narrator": "ガブリエラ", "text": "さすがみやびね。\n楽しみにしてるわ。"},
        { "location": "341/TALK"    , "narrator": "みやび", "text": "さて…「バイトの\n女の子は可愛い子\nばかりだぞ」と…。"},
        { "location": "353/TALK"    , "narrator": "ガブリエラ", "text": "みやび、評判の方は\nどうなった？"},
        { "location": "355/TALK"    , "narrator": "みやび", "text": "悪評は綺麗さっぱり\nドロンしよったき――"},
        { "location": "357/TALK"    , "narrator": "みやび", "text": "もうこれで安心や。"},
        { "location": "358/TALK"    , "narrator": "ガブリエラ", "text": "やった！\nどれどれ…。"},
        { "location": "362/TALK"    , "narrator": "ガブリエラ", "text": "「ギャヴィたん可愛い\nよ」「ギャヴィたんを\n見に行きたい」"},
        { "location": "363/TALK"    , "narrator": "ガブリエラ", "text": "「ギャヴィたんは俺嫁」\n「ざけんな、ギャヴィ\nたんは俺のママだ！」"},
        { "location": "366/TALK"    , "narrator": "ガブリエラ", "text": "うわキモッ！？\n何この変態の巣窟は！？"},
        { "location": "370/TALK"    , "narrator": "ガブリエラ", "text": "っていうか、どうして\nあたしの名前が出てる\nのよ！？"},
        { "location": "373/TALK"    , "narrator": "みやび", "text": "この劇場に来たこと\nあるヤツが、何人か\nおるらしいんやが――"},
        { "location": "374/TALK"    , "narrator": "みやび", "text": "その時に、ギャヴィ\n呼ばれてるんを聞いた\nらしくてな。"},
        { "location": "375/TALK"    , "narrator": "みやび", "text": "今やガブちゃんは、\nこの映画館で唯一名前の\n発覚した美人バイトで―"},
        { "location": "376/TALK"    , "narrator": "みやび", "text": "このサイト限定では\nアイドル的存在に\nなっちょるんよ。"},
        { "location": "377/TALK"    , "narrator": "ガブリエラ", "text": "なんでそんなことに\nなっちゃうのよ！？"},
        { "location": "378/TALK"    , "narrator": "みやび", "text": "そう怒らんでも。\n劇場の悪い評判は\n綺麗に消えたんや…。"},
        { "location": "380/TALK"    , "narrator": "ガブリエラ", "text": "そういう\n問題じゃない！"},
        { "location": "381/TALK"    , "narrator": "ガブリエラ", "text": "さっさとその気持ち\n悪い流れを、元に\n戻しなさいよ。"},
        { "location": "384/TALK"    , "narrator": "みやび", "text": "…しゃあないなぁ。\nうちが何とか\nしとくきね。"},
        { "location": "385/TALK"    , "narrator": "ガブリエラ", "text": "本当に頼むわよ？\nまったく…。"},
        { "location": "392/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "395/TALK"    , "narrator": "みやび", "text": "「ギャヴィたん\n萌え萌え…」\n送信ぞね！"},
        { "location": "176/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>5月9日　4:31 PM</color>\nある日、神楽坂トライナリーでのバイト中、楽屋にて。"},
        { "location": "406/DIALOG"  , "narrator": "Dialog_GEThimegoto_ch04", "text": "【リアルタイプゆるキャラは存在し得るや否や】"}
    ]
}
