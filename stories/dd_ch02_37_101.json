        "title": "002 メインストーリー",
        "sub_title": "新世界に近いもの＜前編＞"
    },
    "entry":
    [
        { "location": "8/SCENARIO", "narrator": "", "text": "新世界に近いもの"},
        { "location": "37/TALK"   , "narrator": "現実世界のアーヤ", "text": "ここは……？"},
        { "location": "38/TALK"   , "narrator": "現実世界のアーヤ", "text": "私……\n……そうか。"},
        { "location": "39/TALK"   , "narrator": "現実世界のアーヤ", "text": "フェノメノンになる\n準備をして\nいたんだわ。"},
        { "location": "40/TALK"   , "narrator": "現実世界のアーヤ", "text": "だから魂だけで\nここにいた。"},
        { "location": "41/TALK"   , "narrator": "現実世界のアーヤ", "text": "怖い夢を\nいっぱい見た。"},
        { "location": "42/TALK"   , "narrator": "現実世界のアーヤ", "text": "色んな私がたくさん\n怖い目に遭った。"},
        { "location": "43/TALK"   , "narrator": "現実世界のアーヤ", "text": "……でもあれは\n本当に夢だった？"},
        { "location": "45/TALK"   , "narrator": "國政綾水　", "text": "綾水！"},
        { "location": "47/TALK"   , "narrator": "現実世界のアーヤ", "text": "えっ！？"},
        { "location": "49/TALK"   , "narrator": "國政綾水　", "text": "しっかりしてよ、私。"},
        { "location": "51/TALK"   , "narrator": "現実世界のアーヤ", "text": "えっ…と、\nあなたは私？"},
        { "location": "53/TALK"   , "narrator": "國政綾水　", "text": "…そうみたい。\nあなたは私じゃないの？"},
        { "location": "54/TALK"   , "narrator": "現実世界のアーヤ", "text": "私は私。國政綾水。\nあなたは誰なの？"},
        { "location": "55/TALK"   , "narrator": "國政綾水　", "text": "私も私。國政綾水。"},
        { "location": "56/TALK"   , "narrator": "現実世界のアーヤ", "text": "……これって\nどういうことなの？"},
        { "location": "57/TALK"   , "narrator": "國政綾水　", "text": "…実は私にも\nわからない。"},
        { "location": "58/TALK"   , "narrator": "現実世界のアーヤ", "text": "何よそれ！"},
        { "location": "59/TALK"   , "narrator": "つばめ", "text": "國政綾水は分離したの。"},
        { "location": "63/TALK"   , "narrator": "現実世界のアーヤ", "text": "聖女！？"},
        { "location": "64/TALK"   , "narrator": "國政綾水　", "text": "つばめ！？"},
        { "location": "65/TALK"   , "narrator": "つばめ", "text": "正確には別の人格が\n一度融合して\nまた分離したの。"},
        { "location": "66/SEL"    , "narrator": "", "text": "そういうことみたい"},
        { "location": "67/SEL"    , "narrator": "", "text": "そういうことだったんだ"},
        { "location": "68/ACT"    , "narrator": "", "text": "そういうことみたい"},
        { "location": "70/TALK"   , "narrator": "現実世界のアーヤ", "text": "いや、わからないから！"},
        { "location": "72/TALK"   , "narrator": "國政綾水　", "text": "そうよ、ちゃんと\n説明してよ！"},
        { "location": "73/ACT"    , "narrator": "", "text": "そういうことだったんだ"},
        { "location": "75/TALK"   , "narrator": "現実世界のアーヤ", "text": "納得できたの？"},
        { "location": "76/TALK"   , "narrator": "國政綾水　", "text": "私はちょっと\nわからないわ…？"},
        { "location": "78/SEL"    , "narrator": "", "text": "本来なら二人のアーヤは出会わない"},
        { "location": "79/SEL"    , "narrator": "", "text": "アーヤはそれぞれの世界でアーヤだった"},
        { "location": "80/ACT"    , "narrator": "", "text": "本来なら二人のアーヤは出会わない"},
        { "location": "82/TALK"   , "narrator": "現実世界のアーヤ", "text": "どの世界かは一旦\n置いておいて\n國政綾水は一人だけ。"},
        { "location": "83/TALK"   , "narrator": "現実世界のアーヤ", "text": "…そういう理解で\nいいのかしら。"},
        { "location": "85/TALK"   , "narrator": "國政綾水　", "text": "そういうことだと\n思うわ。"},
        { "location": "86/TALK"   , "narrator": "國政綾水　", "text": "そうじゃなきゃ\nドッペルゲンガー\nだものね。"},
        { "location": "87/ACT"    , "narrator": "", "text": "アーヤはそれぞれの世界でアーヤだった"},
        { "location": "89/TALK"   , "narrator": "現実世界のアーヤ", "text": "別世界の國政綾水同士が\n出会ったこと自体が\nイレギュラーってこと？"},
        { "location": "91/TALK"   , "narrator": "國政綾水　", "text": "そりゃそうでしょ。"},
        { "location": "92/TALK"   , "narrator": "國政綾水　", "text": "私以外の私とか\nこの目で確認してても\n飲み込めないし。"},
        { "location": "94/TALK"   , "narrator": "現実世界のアーヤ", "text": "だけど私達\n今現在はこうやって\n二人いる。"},
        { "location": "96/TALK"   , "narrator": "國政綾水　", "text": "…その原因は多分\nつばめのフェノメノン。"},
        { "location": "99/TALK"   , "narrator": "國政綾水　", "text": "違う？"},
        { "location": "101/TALK"  , "narrator": "つばめ", "text": "…その通り。"},
        { "location": "102/TALK"  , "narrator": "國政綾水　", "text": "…神楽の歌は\nどうなったの？"},
        { "location": "103/TALK"  , "narrator": "國政綾水　", "text": "……私達の作戦、\n間に合わなかった？"},
        { "location": "105/TALK"  , "narrator": "つばめ", "text": "現状だけを伝えると\nフェノメノンは\n急速に収束している。"},
        { "location": "106/TALK"  , "narrator": "つばめ", "text": "その理由は千羽鶴との\nリンクが\n切断されたから。"},
        { "location": "108/TALK"  , "narrator": "現実世界のアーヤ", "text": "……。"},
        { "location": "110/TALK"  , "narrator": "國政綾水　", "text": "…それって…。"},
        { "location": "113/TALK"  , "narrator": "現実世界のアーヤ", "text": "作戦失敗って\nことよね。\n認めたくないけど。"},
        { "location": "115/TALK"  , "narrator": "國政綾水　", "text": "こっちはもっとひどい。\nフェノメノンの中の\n私は消失する。"},
        { "location": "117/TALK"  , "narrator": "國政綾水　", "text": "…それ以外の可能性が\nあるなら教えて。"},
        { "location": "119/TALK"  , "narrator": "現実世界のアーヤ", "text": "……。"},
        { "location": "121/TALK"  , "narrator": "つばめ", "text": "この先の可能性。"},
        { "location": "122/TALK"  , "narrator": "國政綾水　", "text": "つばめ……？"},
        { "location": "124/TALK"  , "narrator": "現実世界のアーヤ", "text": "…聖女なら知ってても\nおかしくないわ。"},
        { "location": "125/TALK"  , "narrator": "つばめ", "text": "どちらかの國政綾水が\n顕在意識になり、\nもう一人は眠りに落ちる。"},
        { "location": "126/TALK"  , "narrator": "つばめ", "text": "眠りに落ちた方の綾水は\n表層に現れることは\nまずなくなる。"},
        { "location": "128/TALK"  , "narrator": "現実世界のアーヤ", "text": "えっ！？"},
        { "location": "129/TALK"  , "narrator": "國政綾水　", "text": "そんな……。"},
        { "location": "130/TALK"  , "narrator": "現実世界のアーヤ", "text": "フェノメノンが\n収束すれば、國政綾水は\n一人しか存在できない。"},
        { "location": "131/TALK"  , "narrator": "國政綾水　", "text": "……理屈ではわかるわ。\nでも現状はアンフェア\nすぎる。"},
        { "location": "132/TALK"  , "narrator": "國政綾水　", "text": "そうなったら\nフェノメノンの中の\n國政綾水が絶対的に不利。"},
        { "location": "133/TALK"  , "narrator": "現実世界のアーヤ", "text": "……さすが私。\nわかってるじゃない。"},
        { "location": "134/TALK"  , "narrator": "國政綾水　", "text": "ちょっと…！"},
        { "location": "135/TALK"  , "narrator": "つばめ", "text": "ただし決めるのは\nあなたたちではない。"},
        { "location": "136/TALK"  , "narrator": "國政綾水　", "text": "じゃあ誰が？\nつばめ？"},
        { "location": "137/TALK"  , "narrator": "つばめ", "text": "いいえ。"},
        { "location": "139/TALK"  , "narrator": "つばめ", "text": "決められるのは\n$handle$。"},
        { "location": "140/TALK"  , "narrator": "つばめ", "text": "$handle$以外に\n決めることは\nできない。"},
        { "location": "206/TALK"  , "narrator": "水鏡の神子", "text": "…繋がりました。"},
        { "location": "207/TALK"  , "narrator": "白烏", "text": "いよいよね。"},
        { "location": "208/TALK"  , "narrator": "エヴェレット　", "text": "あぁ……。"},
        { "location": "209/TALK"  , "narrator": "水鏡の神子", "text": "國政綾水に\n素敵なココロの旅を――"},
        { "location": "223/TALK"  , "narrator": "エヴェレット　", "text": "これって……"},
        { "location": "224/TALK"  , "narrator": "白烏", "text": "正当なる昇華ね。"},
        { "location": "225/TALK"  , "narrator": "水鏡の神子", "text": "遂に私は、\n世界になるのですね。"},
        { "location": "226/TALK"  , "narrator": "白烏", "text": "……。"},
        { "location": "227/TALK"  , "narrator": "白烏", "text": "………？"},
        { "location": "230/TALK"  , "narrator": "エヴェレット　", "text": "どうしたの？\n白烏。"},
        { "location": "231/TALK"  , "narrator": "白烏", "text": "…ない。"},
        { "location": "232/TALK"  , "narrator": "水鏡の神子", "text": "何が無いのです？"},
        { "location": "233/TALK"  , "narrator": "白烏", "text": "1xが存在しない。"},
        { "location": "234/TALK"  , "narrator": "エヴェレット　", "text": "どういうこと！？"},
        { "location": "235/SEL"   , "narrator": "", "text": "もしかしてそれって！"},
        { "location": "236/ACT"   , "narrator": "", "text": "もしかしてそれって！"},
        { "location": "243/TALK"  , "narrator": "エヴェレット　", "text": "何か知ってるの！？"},
        { "location": "244/SEL"   , "narrator": "", "text": "千羽鶴が撃たれた"},
        { "location": "245/ACT"   , "narrator": "", "text": "千羽鶴が撃たれた"},
        { "location": "248/TALK"  , "narrator": "白烏", "text": "ええっ！？\nそれじゃ……"},
        { "location": "249/TALK"  , "narrator": "水鏡の神子", "text": "世界全体を昇華する……\nなどと言ってる場合では\nなくなりましたね。"},
        { "location": "250/TALK"  , "narrator": "水鏡の神子", "text": "このままでは、日本を\n包んでいるフェノメノン\nさえも消滅します。"},
        { "location": "251/SEL"   , "narrator": "", "text": "まさに今消滅してる"},
        { "location": "252/ACT"   , "narrator": "", "text": "まさに今消滅してる"},
        { "location": "254/TALK"  , "narrator": "エヴェレット　", "text": "……なんてこと……。"},
        { "location": "255/TALK"  , "narrator": "エヴェレット　", "text": "何か食い止める方法は\n無いの！？"},
        { "location": "256/TALK"  , "narrator": "千羽鶴", "text": "ある。"},
        { "location": "258/TALK"  , "narrator": "水鏡の神子", "text": "…これは…！！"},
        { "location": "264/TALK"  , "narrator": "エヴェレット　", "text": "これって……"},
        { "location": "265/TALK"  , "narrator": "白烏", "text": "フェノメノンは\n展開されず……ね。"},
        { "location": "266/TALK"  , "narrator": "水鏡の神子", "text": "……。"},
        { "location": "267/TALK"  , "narrator": "水鏡の神子", "text": "発症は、\n阻止されたのですね。"},
        { "location": "268/SEL"   , "narrator": "", "text": "それより大変なことが"},
        { "location": "269/ACT"   , "narrator": "", "text": "それより大変なことが"},
        { "location": "279/TALK"  , "narrator": "水鏡の神子", "text": "どうしましたか？"},
        { "location": "280/SEL"   , "narrator": "", "text": "千羽鶴が殺された"},
        { "location": "281/ACT"   , "narrator": "", "text": "千羽鶴が殺された"},
        { "location": "283/TALK"  , "narrator": "水鏡の神子", "text": "……！？\n白烏。"},
        { "location": "286/TALK"  , "narrator": "白烏", "text": "はい！"},
        { "location": "290/TALK"  , "narrator": "白烏", "text": "……。"},
        { "location": "293/TALK"  , "narrator": "白烏", "text": "確かに。\n沈黙しています。"},
        { "location": "294/TALK"  , "narrator": "エヴェレット　", "text": "ええっ……\nそれじゃ……"},
        { "location": "296/SEL"   , "narrator": "", "text": "つばめの日本が消えかかってる"},
        { "location": "297/ACT"   , "narrator": "", "text": "つばめの日本が消えかかってる"},
        { "location": "305/TALK"  , "narrator": "水鏡の神子", "text": "その通りです。"},
        { "location": "306/TALK"  , "narrator": "水鏡の神子", "text": "このままでは、\n全世界規模の理想社会\nどころの話ではない。"},
        { "location": "307/TALK"  , "narrator": "水鏡の神子", "text": "全ては無に喫し、\n終焉を迎えます。"},
        { "location": "308/TALK"  , "narrator": "水鏡の神子", "text": "そして、恐らくは\n私自身にも、何らかの\n措置があるでしょう。"},
        { "location": "309/SEL"   , "narrator": "", "text": "それってアーヤが消されるってこと！？"},
        { "location": "310/ACT"   , "narrator": "", "text": "それってアーヤが消されるってこと！？"},
        { "location": "312/TALK"  , "narrator": "水鏡の神子", "text": "最悪のケースでは\nそれもあり得るかも\nしれません。"},
        { "location": "316/TALK"  , "narrator": "白烏", "text": "まさかここまで\n転落するとはね。"},
        { "location": "319/TALK"  , "narrator": "エヴェレット　", "text": "感心してる場合じゃ\nないでしょ！？"},
        { "location": "320/TALK"  , "narrator": "エヴェレット　", "text": "ああっ……\n何とか出来ないのかしら！"},
        { "location": "321/TALK"  , "narrator": "千羽鶴", "text": "できる。"},
        { "location": "358/TALK"  , "narrator": "エヴェレット　", "text": "貴方は！"},
        { "location": "359/TALK"  , "narrator": "水鏡の神子", "text": "千羽鶴ですか。"},
        { "location": "360/TALK"  , "narrator": "白烏", "text": "お久し振りですね。"},
        { "location": "362/SEL"   , "narrator": "", "text": "来たね"},
        { "location": "363/ACT"   , "narrator": "", "text": "来たね"},
        { "location": "367/SEL"   , "narrator": "", "text": "千羽鶴！\nエリカと話したの？"},
        { "location": "368/ACT"   , "narrator": "", "text": "千羽鶴！\nエリカと話したの？"},
        { "location": "371/TALK"  , "narrator": "千羽鶴", "text": "ごきげんよう、\n$handle$。"},
        { "location": "372/TALK"  , "narrator": "千羽鶴", "text": "エリカとは\nちゃんと話をした。\nその結果――"},
        { "location": "373/TALK"  , "narrator": "千羽鶴", "text": "フェノメノンの存続には\n皆から力をもらう必要が\nあるとの判断に至った。"},
        { "location": "375/SEL"   , "narrator": "", "text": "千羽鶴は死んじゃうの！？"},
        { "location": "376/SEL"   , "narrator": "", "text": "力をもらうってどういうこと？"},
        { "location": "377/ACT"   , "narrator": "", "text": "千羽鶴は死んじゃうの！？"},
        { "location": "378/TALK"  , "narrator": "千羽鶴", "text": "……まだ100％消えると\n決まったわけじゃない。"},
        { "location": "379/TALK"  , "narrator": "千羽鶴", "text": "この作戦が上手くいけば\nあるいは――"},
        { "location": "380/ACT"   , "narrator": "", "text": "力をもらうってどういうこと？"},
        { "location": "381/TALK"  , "narrator": "千羽鶴", "text": "今からそのことを話す。"},
        { "location": "384/SEL"   , "narrator": "", "text": "力をもらうってどういうこと？ "},
        { "location": "385/ACT"   , "narrator": "", "text": "力をもらうってどういうこと？ "},
        { "location": "387/TALK"  , "narrator": "千羽鶴", "text": "今からそのことを話す。"},
        { "location": "390/TALK"  , "narrator": "千羽鶴", "text": "あ、それから。"},
        { "location": "392/TALK"  , "narrator": "千羽鶴", "text": "エリカから、\n貴方が私の死を\n凄く心配してると聞いた。"},
        { "location": "394/TALK"  , "narrator": "千羽鶴", "text": "まあ、現状では\nそれに対する答えは\nどちらともいえないけど。"},
        { "location": "395/TALK"  , "narrator": "千羽鶴", "text": "ひとつだけ\n言わなくちゃいけない\nことがある。"},
        { "location": "398/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "399/TALK"  , "narrator": "千羽鶴", "text": "……ありがと。"},
        { "location": "406/TALK"  , "narrator": "千羽鶴", "text": "言わずともわかると\n思うけど、このままだと\n私は消滅する。"},
        { "location": "407/TALK"  , "narrator": "千羽鶴", "text": "そして、当然\n日本を包むフェノメノンも\n消えて、瓦礫と化す。"},
        { "location": "408/TALK"  , "narrator": "千羽鶴", "text": "もはや、全世界を発症に\nよって包み込むなんて事は\n確実に不可能だけど――"},
        { "location": "409/TALK"  , "narrator": "千羽鶴", "text": "現状のフェノメノンを\n維持する方法は\n１つだけある。"},
        { "location": "410/TALK"  , "narrator": "水鏡の神子", "text": "その方法とは？"},
        { "location": "412/TALK"  , "narrator": "千羽鶴", "text": "今の貴方の状態、\nすなわちフェノメノン\n発症状態を維持すること。"},
        { "location": "413/TALK"  , "narrator": "千羽鶴", "text": "貴方と$handle$は\n共に合意の上で\nフェノメノンを発症した。"},
        { "location": "414/TALK"  , "narrator": "千羽鶴", "text": "だから、そのまま\n維持し続けることに\n異論は無いと思うけど――"},
        { "location": "415/TALK"  , "narrator": "千羽鶴", "text": "心に介入することで、\nその理由が変わった以上\n同意を得る必要がある。"},
        { "location": "416/TALK"  , "narrator": "千羽鶴", "text": "だから、\n改めて聞きます。"},
        { "location": "417/TALK"  , "narrator": "千羽鶴", "text": "水鏡の神子。\n$handle$――。"},
        { "location": "418/TALK"  , "narrator": "千羽鶴", "text": "このまま発症した状態で\n私を受け入れ委ねてもらう\nことは可能か否か。"},
        { "location": "420/TALK"  , "narrator": "千羽鶴", "text": "水鏡の神子。\n貴方の力を\n使わせてもらうこと。"},
        { "location": "421/TALK"  , "narrator": "白烏", "text": "それって要するに\nフェノメノンの発症って\nことかしら？"},
        { "location": "423/TALK"  , "narrator": "千羽鶴", "text": "違う。"},
        { "location": "424/TALK"  , "narrator": "千羽鶴", "text": "ただ単に、\nわたしとココロを\n繋げて欲しいだけ。"},
        { "location": "425/TALK"  , "narrator": "千羽鶴", "text": "1xではなく、\n2xとして。"},
        { "location": "426/TALK"  , "narrator": "エヴェレット　", "text": "2x！？\n何なの、それは……"},
        { "location": "427/TALK"  , "narrator": "千羽鶴", "text": "1xは、単にココロ同士を\n連絡線で繋いでいるだけの\n独立した魂同士だけど――"},
        { "location": "428/TALK"  , "narrator": "千羽鶴", "text": "2xは、完全にココロに\nとけ込む状態。\nすなわち“一心”になる。"},
        { "location": "429/TALK"  , "narrator": "千羽鶴", "text": "単純に言えば――"},
        { "location": "430/TALK"  , "narrator": "千羽鶴", "text": "私、厳密には逢瀬つばめが\n貴方と潜在意識下で\nココロを共有する。"},
        { "location": "431/TALK"  , "narrator": "千羽鶴", "text": "もちろん永久ではない。\nフェノメノンが消えれば\n繋がりも消える。"},
        { "location": "432/TALK"  , "narrator": "千羽鶴", "text": "発症と違い、力も不要で\nココロが壊れるような\nリスクもない。"},
        { "location": "433/TALK"  , "narrator": "千羽鶴", "text": "ただ。"},
        { "location": "434/TALK"  , "narrator": "千羽鶴", "text": "当然他人のココロを繋ぐ\nわけだから、当人の\n承諾無しにはできない。"},
        { "location": "435/TALK"  , "narrator": "千羽鶴", "text": "だから、最終判断は\n貴方たちに委ねる。"},
        { "location": "436/TALK"  , "narrator": "水鏡の神子", "text": "なるほど。\nわかりました。"},
        { "location": "440/TALK"  , "narrator": "水鏡の神子", "text": "私のココロはもう\n決まっていますが――"},
        { "location": "441/TALK"  , "narrator": "水鏡の神子", "text": "$handle$さん。\n貴方はどう思いますか？"},
        { "location": "442/TALK"  , "narrator": "水鏡の神子", "text": "ずっと私たちを\n見守ってきてくれていた\n貴方だから。"},
        { "location": "443/TALK"  , "narrator": "水鏡の神子", "text": "その意見が\n聞きたいのです。"},
        { "location": "445/SEL"   , "narrator": "", "text": "$me$なら千羽鶴を受け入れない"},
        { "location": "446/ACT"   , "narrator": "", "text": "$me$なら千羽鶴を受け入れない"},
        { "location": "451/SEL"   , "narrator": "", "text": "$me$なら千羽鶴を受け入れる"},
        { "location": "452/SEL"   , "narrator": "", "text": "$me$なら千羽鶴を受け入れない "},
        { "location": "453/ACT"   , "narrator": "", "text": "$me$なら千羽鶴を受け入れる"},
        { "location": "456/ACT"   , "narrator": "", "text": "$me$なら千羽鶴を受け入れない "},
        { "location": "461/TALK"  , "narrator": "水鏡の神子", "text": "そうですか。\nわかりました。"},
        { "location": "462/TALK"  , "narrator": "水鏡の神子", "text": "私の答えですが――"},
        { "location": "511/TALK"  , "narrator": "水鏡の神子", "text": "千羽鶴を\n受け入れたいと思います。"},
        { "location": "515/TALK"  , "narrator": "水鏡の神子", "text": "千羽鶴を\n受け入れる事を\n拒否します。"},
        { "location": "517/TALK"  , "narrator": "水鏡の神子", "text": "最後まで悩んでいた\nところではありますが。"},
        { "location": "518/TALK"  , "narrator": "水鏡の神子", "text": "$handle$さんの\n今までの私への支えと\n真剣さを考えると――"},
        { "location": "519/TALK"  , "narrator": "水鏡の神子", "text": "その意見を汲んで\n考えてみても良いかと\n思いました。"},
        { "location": "520/TALK"  , "narrator": "水鏡の神子", "text": "今回もまた、真剣に\n考えてくれたのだと思い、\n信じることにしました。"},
        { "location": "524/TALK"  , "narrator": "水鏡の神子", "text": "千羽鶴を\n受け入れたいと思います。"},
        { "location": "525/TALK"  , "narrator": "水鏡の神子", "text": "$handle$さんの\n意見も参考にしようと\n思いましたが――"},
        { "location": "526/TALK"  , "narrator": "水鏡の神子", "text": "今までの貴方の対応思い\n返し、自分で答えを出した\n方が良いと考えました。"},
        { "location": "527/SEL"   , "narrator": "", "text": "その方がいいと思います"},
        { "location": "528/SEL"   , "narrator": "", "text": "え、なんで！？"},
        { "location": "529/ACT"   , "narrator": "", "text": "その方がいいと思います"},
        { "location": "530/ACT"   , "narrator": "", "text": "え、なんで！？"},
        { "location": "531/TALK"  , "narrator": "水鏡の神子", "text": "自身の過去の選択を\n省みるとよろしいかと\n思います。"},
        { "location": "536/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "537/TALK"  , "narrator": "千羽鶴", "text": "貴方たちの選択のお陰で\nこの世界は継続するかも\nしれない。"},
        { "location": "538/TALK"  , "narrator": "千羽鶴", "text": "ただ、問題はここから。"},
        { "location": "539/TALK"  , "narrator": "千羽鶴", "text": "まず、國政綾水は\nこれから私を受け入れる\nため、戦う必要がある。"},
        { "location": "540/TALK"  , "narrator": "千羽鶴", "text": "それは、私を承認する為に\n必要不可欠なこと。"},
        { "location": "542/TALK"  , "narrator": "千羽鶴", "text": "そして、\n$handle$――"},
        { "location": "544/TALK"  , "narrator": "千羽鶴", "text": "貴方の意志としては私を\n受け入れなかったけど、\n最終結論は総意による。"},
        { "location": "546/TALK"  , "narrator": "千羽鶴", "text": "貴方の意志としては私を\n受け入れてくれたけど、\n最終結論は総意による。"},
        { "location": "550/SEL"   , "narrator": "", "text": "総意が関係するからでしょ？"},
        { "location": "551/SEL"   , "narrator": "", "text": "総意？"},
        { "location": "552/ACT"   , "narrator": "", "text": "総意が関係するからでしょ？"},
        { "location": "554/ACT"   , "narrator": "", "text": "総意？"},
        { "location": "559/SEL"   , "narrator": "", "text": "総意？ "},
        { "location": "560/ACT"   , "narrator": "", "text": "総意？ "},
        { "location": "565/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "568/TALK"  , "narrator": "千羽鶴", "text": "そう。総意。"},
        { "location": "569/TALK"  , "narrator": "千羽鶴", "text": "この問題は、私個人の\n感情や記憶にかかわる\nものではない。"},
        { "location": "570/TALK"  , "narrator": "千羽鶴", "text": "このフェノメノン\n全体という、\n世界としての判断になる。"},
        { "location": "571/TALK"  , "narrator": "千羽鶴", "text": "わかりやすく言えば、\n今の日本は、貴方たちの\n総意が作り出してる。"},
        { "location": "573/TALK"  , "narrator": "千羽鶴", "text": "貴方一人が私を否定しても\n他の協力者が肯定したら、\n継続されることになる。"},
        { "location": "574/TALK"  , "narrator": "千羽鶴", "text": "だから、今の段階では\n100％希望に添えるかは\nわからないということ。"},
        { "location": "576/TALK"  , "narrator": "千羽鶴", "text": "貴方一人が継続を願っても\n他の協力者が否定したら、\nそれは継続不可能になる。"},
        { "location": "577/TALK"  , "narrator": "千羽鶴", "text": "だから、今の段階では\n100％希望に添えるかは\nわからないということ。"},
        { "location": "578/TALK"  , "narrator": "千羽鶴", "text": "それまで貴方は、\n今の想いを変えずに\nいてもらいたい。"},
        { "location": "583/TALK"  , "narrator": "千羽鶴", "text": "それじゃ、準備はいい？"},
        { "location": "585/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "586/TALK"  , "narrator": "千羽鶴", "text": "心と心の問題だから、\n素直な気持ちに忠実な\n選択をするしかない。"},
        { "location": "587/TALK"  , "narrator": "千羽鶴", "text": "ただ、その場合、\n私は貴方を無力化\nしなければならない。"},
        { "location": "588/TALK"  , "narrator": "千羽鶴", "text": "なぜなら、私にとって\nこのフェノメノンは、\nまだ必要なものだから。"},
        { "location": "589/TALK"  , "narrator": "千羽鶴", "text": "私はまだ全然\n諦めていない。"},
        { "location": "590/TALK"  , "narrator": "千羽鶴", "text": "この世界から“彼ら”を\n排除し、理想的社会を\n構築することを。"},
        { "location": "591/TALK"  , "narrator": "千羽鶴", "text": "その最後の牙城である\nこのフェノメノンの維持は\n必要不可欠なの。"},
        { "location": "592/TALK"  , "narrator": "千羽鶴", "text": "だから、貴方には\n恨みがあるわけではない。\nけど――"},
        { "location": "593/TALK"  , "narrator": "千羽鶴", "text": "私には護らねばならない\nものがある。\nだから、戦う。"},
        { "location": "594/TALK"  , "narrator": "水鏡の神子", "text": "……。"},
        { "location": "595/TALK"  , "narrator": "水鏡の神子", "text": "承知した。\n皇千羽鶴。"},
        { "location": "596/TALK"  , "narrator": "水鏡の神子", "text": "私も國政綾水を\n護らねばならない身。"},
        { "location": "597/TALK"  , "narrator": "水鏡の神子", "text": "避けられない戦いなら\n真剣勝負で受けて立つ。"},
        { "location": "598/TALK"  , "narrator": "千羽鶴", "text": "…わかった。"},
        { "location": "600/TALK"  , "narrator": "水鏡の神子", "text": "$handle$さん。"},
        { "location": "602/TALK"  , "narrator": "水鏡の神子", "text": "今まで色々\nありがとうございました。"},
        { "location": "603/SEL"   , "narrator": "", "text": "こちらこそ"},
        { "location": "604/SEL"   , "narrator": "", "text": "そんな死にに行くようなこと言わないで"},
        { "location": "605/ACT"   , "narrator": "", "text": "こちらこそ"},
        { "location": "606/TALK"  , "narrator": "水鏡の神子", "text": "貴方が\n支えてくれたからこそ、\n今の綾水がいます。"},
        { "location": "607/ACT"   , "narrator": "", "text": "そんな死にに行くようなこと言わないで"},
        { "location": "608/TALK"  , "narrator": "水鏡の神子", "text": "そういう意図は\nありませんが……。"},
        { "location": "609/TALK"  , "narrator": "水鏡の神子", "text": "ただ、確かにこの先、\nどんな事が起こるかは\nわかりません。"},
        { "location": "611/TALK"  , "narrator": "水鏡の神子", "text": "私がどのような存在に\nなったとしても、\n綾水は綾水。"},
        { "location": "612/TALK"  , "narrator": "水鏡の神子", "text": "そう信じて、\nこれからもお互いを\n切磋琢磨し合いたい。"},
        { "location": "613/TALK"  , "narrator": "水鏡の神子", "text": "……そう感じています。"},
        { "location": "614/TALK"  , "narrator": "水鏡の神子", "text": "千羽鶴。\n私は構いませんよ。"},
        { "location": "616/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "617/TALK"  , "narrator": "千羽鶴", "text": "それじゃ、\nよろしくお願いします。"},
        { "location": "618/TALK"  , "narrator": "千羽鶴", "text": "國政綾水と\nこのフェノメノンの未来に\n素敵なココロの旅を。"},
        { "location": "31/DIALOG" , "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:Interrupt】</color>\nSystem Interrupted.\n\n必須選択肢が選ばれていません。\n\n<color=green>『STORY27：シン・カグラ』</color>\nにて、選択を行ってから\n再度アクセスしてください。\n"},
        { "location": "35/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>-月--日　 -:-- --</color>\nNull"}
