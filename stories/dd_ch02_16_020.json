{
    "dir": "chap16/daydra/dd_ch02_16_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "16256",
        "cid": "ayami",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "写真の無いメニュー"
    },
    "entry":
    [
        { "location": "345/SCENARIO", "narrator": "", "text": "写真の無いメニュー"},
        { "location": "359/TALK"    , "narrator": "アーヤ", "text": "う～ん…。"},
        { "location": "361/TALK"    , "narrator": "みやび", "text": "どうかしたが？"},
        { "location": "363/TALK"    , "narrator": "アーヤ", "text": "ここのカフェだけど、\nいきなり入ったのは\n間違いだったみたい…。"},
        { "location": "364/TALK"    , "narrator": "みやび", "text": "気に入らないところでも\nあるんか？"},
        { "location": "365/TALK"    , "narrator": "みやび", "text": "うちには問題があるとは\n思えんけんど？"},
        { "location": "366/TALK"    , "narrator": "アーヤ", "text": "メニューを見て。\n写真が載ってないでしょ？"},
        { "location": "367/TALK"    , "narrator": "アーヤ", "text": "こういうカフェはね、\n普通のメニューに見える\nけど――"},
        { "location": "368/TALK"    , "narrator": "アーヤ", "text": "注文すると、店独自の\nアレンジがされた物が\n出てくることがあるのよ。"},
        { "location": "370/TALK"    , "narrator": "みやび", "text": "…ゲテモノか？"},
        { "location": "371/TALK"    , "narrator": "アーヤ", "text": "そこまで酷くはないわ。\n基本的に美味しくは\nあるんだけど――"},
        { "location": "372/TALK"    , "narrator": "アーヤ", "text": "求めてた味とは違うから、\nどうしてもガッカリ\nしちゃうの…。"},
        { "location": "373/TALK"    , "narrator": "みやび", "text": "そんなこともあるんか…。\nさすが、カフェについて\n詳しいんやね。"},
        { "location": "374/TALK"    , "narrator": "アーヤ", "text": "そういうわけだから、\n注文が決まったら教えて。"},
        { "location": "375/TALK"    , "narrator": "アーヤ", "text": "一度店員さんに\n確認するから…。"},
        { "location": "376/TALK"    , "narrator": "みやび", "text": "いや、その必要は\nないちや。"},
        { "location": "377/TALK"    , "narrator": "みやび", "text": "ちょっと面白そうやき、\n今日は確認を取らんで\n注文してみんか？"},
        { "location": "378/TALK"    , "narrator": "アーヤ", "text": "何でそんなことしなきゃ\nならないのよ？"},
        { "location": "379/TALK"    , "narrator": "みやび", "text": "ロシアンルーレット\nみたいで楽しいと\n思わん？"},
        { "location": "380/TALK"    , "narrator": "みやび", "text": "何が出てくるかわからん\n注文なんて、どこでも\nできることやないし。"},
        { "location": "381/TALK"    , "narrator": "アーヤ", "text": "…そんな風に思ったこと、\n一度もなかったわ。"},
        { "location": "382/TALK"    , "narrator": "みやび", "text": "元のより美味しい物が\n出てこんとも言えんの\nやし――"},
        { "location": "384/TALK"    , "narrator": "みやび", "text": "新しい出会いを求めて\n冒険するんも、えいこと\nやと思うんよ。"},
        { "location": "385/TALK"    , "narrator": "アーヤ", "text": "…そうね。\nそういう楽しみも、\nカフェならではだし――"},
        { "location": "386/TALK"    , "narrator": "アーヤ", "text": "今日は聞かないで\n注文してみようかしら？"},
        { "location": "389/TALK"    , "narrator": "みやび", "text": "それがえいよ。\nさてと、うちは何を\n注文しよう…。"},
        { "location": "390/TALK"    , "narrator": "アーヤ", "text": "…私は、何にしよう\nかしら？"},
        { "location": "393/TALK"    , "narrator": "アーヤ", "text": "注文するとは言ったけど、\nいざするとなると、\nやっぱり勇気がいるわね。"},
        { "location": "394/TALK"    , "narrator": "アーヤ", "text": "…どうしよう。\nどれを選べばいいか\nわからなくなってきたわ。"},
        { "location": "403/TALK"    , "narrator": "アーヤ", "text": "相談があるの"},
        { "location": "404/TALK"    , "narrator": "アーヤ", "text": "今、メニューに写真の無いカフェで、何を注文すればいいか悩んでるんだけど"},
        { "location": "405/TALK"    , "narrator": "アーヤ", "text": "どれにしたらいいと思う？"},
        { "location": "407/SEL"     , "narrator": "", "text": "クリームソーダにしよう"},
        { "location": "408/SEL"     , "narrator": "", "text": "ホットケーキかな？"},
        { "location": "409/SEL"     , "narrator": "", "text": "パスタ系は？"},
        { "location": "410/ACT"     , "narrator": "", "text": "クリームソーダにしよう"},
        { "location": "411/TALK"    , "narrator": "アーヤ", "text": "クリームソーダね"},
        { "location": "412/TALK"    , "narrator": "アーヤ", "text": "ちょっとドキドキするけど、それにしてみるわ"},
        { "location": "418/TALK"    , "narrator": "アーヤ", "text": "決めた。\n私はクリームソーダを\n注文するわ。"},
        { "location": "421/TALK"    , "narrator": "みやび", "text": "無難過ぎてつまらんな。"},
        { "location": "422/TALK"    , "narrator": "アーヤ", "text": "そんなことないわ。"},
        { "location": "423/TALK"    , "narrator": "アーヤ", "text": "上に載ってるアイスが\nバニラじゃないかも\nしれないし――"},
        { "location": "424/TALK"    , "narrator": "アーヤ", "text": "ソフトクリームが\n乗ってる可能性も\nあるでしょ？"},
        { "location": "425/TALK"    , "narrator": "みやび", "text": "ソフトクリームの載った\nクリームソーダは、\n珍しくないと思うけんど？"},
        { "location": "427/TALK"    , "narrator": "アーヤ", "text": "私、あれって苦手なの。\n全身がキンと冷えて…。"},
        { "location": "428/TALK"    , "narrator": "みやび", "text": "なるほど…。\nじゃあ、店員さん呼んで\nえいか？"},
        { "location": "429/TALK"    , "narrator": "アーヤ", "text": "ええ、お願い。"},
        { "location": "431/TALK"    , "narrator": "アーヤ", "text": "…さてと、どういうのが\n出てくるやら…。"},
        { "location": "438/TALK"    , "narrator": "ウェイトレス", "text": "注文の品は以上ですね？\nどうぞ、ごゆっくり…。"},
        { "location": "441/TALK"    , "narrator": "アーヤ", "text": "…こう来たかぁ。"},
        { "location": "442/TALK"    , "narrator": "みやび", "text": "メロンソーダやない\nクリームソーダって、\n初めて見たぞね。"},
        { "location": "443/TALK"    , "narrator": "みやび", "text": "薄く赤いみたいやけんど、\nそれ、何のソーダなが？"},
        { "location": "444/TALK"    , "narrator": "アーヤ", "text": "う～ん…香りからすると、\nイチゴじゃないかしら？"},
        { "location": "445/TALK"    , "narrator": "アーヤ", "text": "アイスはバニラアイス\nみたいだけど…。"},
        { "location": "446/TALK"    , "narrator": "みやび", "text": "まあ、許容範囲では\nありそうやね。"},
        { "location": "447/TALK"    , "narrator": "アーヤ", "text": "そうね。\nとりあえず一口…。"},
        { "location": "448/TALK"    , "narrator": "アーヤ", "text": "……あれ？"},
        { "location": "449/TALK"    , "narrator": "アーヤ", "text": "これ、美味しいかも。"},
        { "location": "450/TALK"    , "narrator": "みやび", "text": "おっ、当たりやったか？"},
        { "location": "451/TALK"    , "narrator": "アーヤ", "text": "ええ、ちょっと自分でも\nビックリだけど、\n凄く美味しいわ。"},
        { "location": "452/TALK"    , "narrator": "アーヤ", "text": "ほら、みやびも一口\n飲んでみて。"},
        { "location": "453/TALK"    , "narrator": "みやび", "text": "ん……。"},
        { "location": "455/TALK"    , "narrator": "みやび", "text": "おぉっ！？\nこれは絶品ぞね！"},
        { "location": "456/TALK"    , "narrator": "アーヤ", "text": "ね？　ビックリでしょ？"},
        { "location": "457/TALK"    , "narrator": "アーヤ", "text": "クリームソーダは\nメロンソーダ以外は\n絶対無いと思ったけど――"},
        { "location": "458/TALK"    , "narrator": "アーヤ", "text": "これは新たな発見ね。\nまた飲みに来ないと。"},
        { "location": "459/TALK"    , "narrator": "みやび", "text": "うちの言うた通り、\n冒険して正解やったね。"},
        { "location": "460/TALK"    , "narrator": "アーヤ", "text": "ええ。"},
        { "location": "461/TALK"    , "narrator": "アーヤ", "text": "…ところで、冒険しろと\n言ったあなたは何を\n食べてるのかしら？"},
        { "location": "462/TALK"    , "narrator": "みやび", "text": "ん？　ハムとチーズの\nサンドイッチやけんど？"},
        { "location": "464/TALK"    , "narrator": "アーヤ", "text": "…冒険しなさいよ。"},
        { "location": "481/ACT"     , "narrator": "", "text": "ホットケーキかな？"},
        { "location": "482/TALK"    , "narrator": "アーヤ", "text": "いいわね、それ"},
        { "location": "483/TALK"    , "narrator": "アーヤ", "text": "安心して注文できそう"},
        { "location": "487/TALK"    , "narrator": "アーヤ", "text": "私、ホットケーキと\n紅茶にするわ。"},
        { "location": "489/TALK"    , "narrator": "みやび", "text": "なるほど、それはえい\n考えやね。"},
        { "location": "491/TALK"    , "narrator": "みやび", "text": "ホットケーキなら、\nちっくとアレンジ入っても\nまず間違いはないき。"},
        { "location": "492/TALK"    , "narrator": "アーヤ", "text": "そういうこと。\nみやびも決まったなら、\n注文するわよ？"},
        { "location": "497/TALK"    , "narrator": "ウェイトレス", "text": "注文の品は以上ですね？\nどうぞ、ごゆっくり…。"},
        { "location": "499/TALK"    , "narrator": "みやび", "text": "…甘そうやね。"},
        { "location": "500/TALK"    , "narrator": "アーヤ", "text": "チョコアイスの載った\nホットケーキは、\n初めて見たわ。"},
        { "location": "501/TALK"    , "narrator": "アーヤ", "text": "普通はメープルシロップか\nチョコソース辺りだと\n思うし…。"},
        { "location": "502/TALK"    , "narrator": "みやび", "text": "けんど、そんなに\n驚いてはいないようやね？"},
        { "location": "503/TALK"    , "narrator": "アーヤ", "text": "チョコソースの代わりに\nチョコアイスが載ってると\n思えば、普通でしょ？"},
        { "location": "504/TALK"    , "narrator": "アーヤ", "text": "あむっ…。"},
        { "location": "505/TALK"    , "narrator": "アーヤ", "text": "…うん、美味しいわ。\nこれなら平気よ。"},
        { "location": "507/TALK"    , "narrator": "みやび", "text": "大当たりではないけんど、\n大ハズレでもない、って\nところやね。"},
        { "location": "508/TALK"    , "narrator": "アーヤ", "text": "そんな感じね。\nでも、結構美味しいから\n嫌いじゃないわ。"},
        { "location": "509/TALK"    , "narrator": "アーヤ", "text": "って、話してる間に\nアイス溶けちゃう。\n早く食べないと。"},
        { "location": "513/TALK"    , "narrator": "アーヤ", "text": "…ごちそうさま。"},
        { "location": "514/TALK"    , "narrator": "みやび", "text": "綺麗に食べきったのに、\n不満そうな顔やな。"},
        { "location": "515/TALK"    , "narrator": "みやび", "text": "やっぱり、不味かったん？"},
        { "location": "517/TALK"    , "narrator": "アーヤ", "text": "ううん、けして不味くは\nなかったわ。"},
        { "location": "518/TALK"    , "narrator": "アーヤ", "text": "不味くはなかったけど…\n私、ホットケーキを\n注文したわよね？"},
        { "location": "519/TALK"    , "narrator": "みやび", "text": "うん、ホットケーキやね。"},
        { "location": "520/TALK"    , "narrator": "アーヤ", "text": "けど、ベタ甘なチョコの\n味が強すぎて――"},
        { "location": "521/TALK"    , "narrator": "アーヤ", "text": "ホットケーキそのものの、\n優しい甘さが感じられ\nなかったの…。"},
        { "location": "522/TALK"    , "narrator": "みやび", "text": "あ～…それは致命的な\n欠点やね。"},
        { "location": "523/TALK"    , "narrator": "みやび", "text": "ホットケーキは、\nあのほんのりふわっと\nした甘さがないと――"},
        { "location": "524/TALK"    , "narrator": "みやび", "text": "食べた気にならんちや。"},
        { "location": "525/TALK"    , "narrator": "アーヤ", "text": "うんと甘い物が食べたい、\nって時にはいいけど――"},
        { "location": "526/TALK"    , "narrator": "アーヤ", "text": "ホットケーキを求めて\n注文すると、ガッカリな\n結果になるわね。"},
        { "location": "527/TALK"    , "narrator": "みやび", "text": "まあ、それがわかった\nだけでも、得たものは\nあったやんか。"},
        { "location": "528/TALK"    , "narrator": "アーヤ", "text": "そうね…。"},
        { "location": "529/TALK"    , "narrator": "アーヤ", "text": "…ところで、冒険しろと\n言ったあなたは何を\n飲んでいるのかしら？"},
        { "location": "530/TALK"    , "narrator": "みやび", "text": "コーンスープちや。\nあー、優しい甘さと\n温かさが最高やねぇ。"},
        { "location": "532/TALK"    , "narrator": "アーヤ", "text": "…冒険しなさいよ。"},
        { "location": "533/ACT"     , "narrator": "", "text": "パスタ系は？"},
        { "location": "534/TALK"    , "narrator": "アーヤ", "text": "…まさか、それが来るとは思わなかったわ"},
        { "location": "535/TALK"    , "narrator": "アーヤ", "text": "出来れば避けたいかも、って思ってたけど…"},
        { "location": "536/TALK"    , "narrator": "アーヤ", "text": "でも、冒険も必要よね"},
        { "location": "540/TALK"    , "narrator": "アーヤ", "text": "…私、パスタにしようと\n思うんだけど。"},
        { "location": "542/TALK"    , "narrator": "みやび", "text": "悪いことは言わん。\nそれはやめた方がえい。"},
        { "location": "543/TALK"    , "narrator": "みやび", "text": "パスタ系のアレンジは、\n爆弾になる可能性も\n十分あり得るき――"},
        { "location": "544/TALK"    , "narrator": "みやび", "text": "無難にデザート辺りを\n攻めた方がえいよ。"},
        { "location": "545/TALK"    , "narrator": "アーヤ", "text": "それはわかってるけど、\n今日は冒険してみよう\nかな、って思うの。"},
        { "location": "546/TALK"    , "narrator": "アーヤ", "text": "みやびの言う通り、素敵な\n出会いがあるかもしれない\nでしょ？"},
        { "location": "547/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "548/TALK"    , "narrator": "みやび", "text": "わかった…なら、うちも\n一緒に注文するんよ。"},
        { "location": "549/TALK"    , "narrator": "アーヤ", "text": "みやびまで付き合うこと\nないのに。"},
        { "location": "550/TALK"    , "narrator": "みやび", "text": "言い出しっぺはうちや。\nそのうちが逃げるわけには\nいかんちや。"},
        { "location": "551/TALK"    , "narrator": "みやび", "text": "アーヤはどれにするか\n決めたが？"},
        { "location": "552/TALK"    , "narrator": "アーヤ", "text": "カルボナーラ。\nパスタの中では\n結構好きなのよ。"},
        { "location": "553/TALK"    , "narrator": "みやび", "text": "それやったら、\nうちはイカスミパスタに\nしてみるぞね。"},
        { "location": "554/TALK"    , "narrator": "みやび", "text": "…本当にえいが？\n注文したら後戻りは\nできんがよ？"},
        { "location": "555/TALK"    , "narrator": "アーヤ", "text": "覚悟が鈍るから、\n早く注文しましょ。"},
        { "location": "558/TALK"    , "narrator": "みやび", "text": "わかった…。\nすみません、\n注文お願いします。"},
        { "location": "559/TALK"    , "narrator": "アーヤ", "text": "…どうか、ゲテモノだけは\n出てこないでください！"},
        { "location": "567/TALK"    , "narrator": "アーヤ", "text": "…ごちそうさまでした。"},
        { "location": "568/TALK"    , "narrator": "みやび", "text": "…ごちそうさま。"},
        { "location": "569/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "570/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "571/TALK"    , "narrator": "アーヤ", "text": "…アレンジされた物が\n出てくるって、勝手に\n思った私達も悪いけど――"},
        { "location": "573/TALK"    , "narrator": "アーヤ", "text": "普通だったわね。"},
        { "location": "574/TALK"    , "narrator": "みやび", "text": "うん、ビックリするくらい\n普通のパスタやったね。"},
        { "location": "575/TALK"    , "narrator": "みやび", "text": "どんなアレンジがされ\nちゅうか楽しみに\nしちょったがに――"},
        { "location": "576/TALK"    , "narrator": "みやび", "text": "まっこと普通のが\n出てくるとは…。"},
        { "location": "577/TALK"    , "narrator": "アーヤ", "text": "味も、不味くはないけど\n美味しくもない、普通な\n感じだったしね。"},
        { "location": "578/TALK"    , "narrator": "アーヤ", "text": "普通じゃないところって、\nもしかして値段くらい？"},
        { "location": "579/TALK"    , "narrator": "みやび", "text": "この味で千円札一枚じゃ\n足りないいうんは、\n納得できんわ。"},
        { "location": "580/TALK"    , "narrator": "みやび", "text": "駅前にある、ワンコインで\n食べられるファミレスの\nパスタの方が――"},
        { "location": "581/TALK"    , "narrator": "みやび", "text": "間違いなく美味いな。"},
        { "location": "582/TALK"    , "narrator": "アーヤ", "text": "同感…多分、この店に\n来るのは、今日が最初で\n最後ね。"},
        { "location": "357/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>7月18日　3:53 PM</color>\nとある平日の放課後、某カフェにて。"},
        { "location": "475/DIALOG"  , "narrator": "Dialog_GEThimegoto_ch02", "text": "【ヌーベル・バーグ・カフェ】"}
    ]
}
