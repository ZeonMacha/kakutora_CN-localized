        "title": "002 メインストーリー",
        "sub_title": "戦略的サボタージュ＜前編＞"
    },
    "entry":
    [
        { "location": "2265/TALK"  , "narrator": "神楽", "text": "はい、卯月です！\n真幌さん？"},
        { "location": "2266/TALK"  , "narrator": "透明真幌", "text": "卯月か。\nアラートは聞いたな？"},
        { "location": "2267/TALK"  , "narrator": "神楽", "text": "すみません！\n今、急いで現場に\n向かってます！"},
        { "location": "2268/TALK"  , "narrator": "透明真幌", "text": "おまえ以外の全員は\n先にフェノメノン内へと\n進入した。"},
        { "location": "2269/TALK"  , "narrator": "透明真幌", "text": "すぐに迎えを寄こす。\nそこで待機しててくれ。"},
        { "location": "2270/TALK"  , "narrator": "神楽", "text": "わかりました。\nよろしくお願いします。"},
        { "location": "2278/TALK"  , "narrator": "神楽", "text": "…私以外の全員。\nつまり、逢瀬つばめも…。"},
        { "location": "2279/TALK"  , "narrator": "神楽", "text": "既に現場に到着している\nってこと、か…。"},
        { "location": "2280/TALK"  , "narrator": "神楽", "text": "…とうとう、始まるんだ。\n私の、任務が…。"},
        { "location": "2281/TALK"  , "narrator": "神楽", "text": "あの逢瀬つばめから、\n信頼を得ること…。\nそれが、私の任務。"},
        { "location": "2283/TALK"  , "narrator": "神楽", "text": "…でも。"},
        { "location": "2296/TALK"  , "narrator": "神楽", "text": "できるのかしら、\n私に…。"},
        { "location": "2297/TALK"  , "narrator": "神楽", "text": "あんな恐ろしい子から、\n信頼される存在になる\nなんて…。"},
        { "location": "2298/TALK"  , "narrator": "神楽", "text": "…ううん。\nできるかどうかじゃない。"},
        { "location": "2299/TALK"  , "narrator": "神楽", "text": "やらなくちゃ…。\nここまで来たのは、\nそのためなんだから！"},
        { "location": "2312/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "2319/TALK"  , "narrator": "神楽", "text": "ちょっと相談いいですか？"},
        { "location": "2321/SEL"   , "narrator": "", "text": "どうかしたの？"},
        { "location": "2322/SEL"   , "narrator": "", "text": "ダメです"},
        { "location": "2323/ACT"   , "narrator": "", "text": "どうかしたの？"},
        { "location": "2324/TALK"  , "narrator": "神楽", "text": "やっぱり今日の出動は"},
        { "location": "2325/TALK"  , "narrator": "神楽", "text": "私パスしようかと思うんですよ"},
        { "location": "2326/TALK"  , "narrator": "神楽", "text": "私が遅れていかなくても"},
        { "location": "2327/TALK"  , "narrator": "神楽", "text": "いいと思うんですよね"},
        { "location": "2328/TALK"  , "narrator": "神楽", "text": "逢瀬つばめがいるんだから"},
        { "location": "2329/TALK"  , "narrator": "神楽", "text": "行く必要ないと思いません？"},
        { "location": "2330/TALK"  , "narrator": "神楽", "text": "クランなんか瞬殺ですよ"},
        { "location": "2333/SEL"   , "narrator": "", "text": "つばめと接触できないよ？"},
        { "location": "2334/SEL"   , "narrator": "", "text": "それはないと思う"},
        { "location": "2335/ACT"   , "narrator": "", "text": "つばめと接触できないよ？"},
        { "location": "2336/TALK"  , "narrator": "神楽", "text": "できますよ"},
        { "location": "2337/TALK"  , "narrator": "神楽", "text": "タイミングがズレるだけで"},
        { "location": "2339/TALK"  , "narrator": "神楽", "text": "あとで劇場で会うという流れに変更です"},
        { "location": "2340/TALK"  , "narrator": "神楽", "text": "それなら問題なし"},
        { "location": "2341/TALK"  , "narrator": "神楽", "text": "と思った次第ですが"},
        { "location": "2342/TALK"  , "narrator": "神楽", "text": "どう思います？"},
        { "location": "2343/ACT"   , "narrator": "", "text": "それはないと思う"},
        { "location": "2344/TALK"  , "narrator": "神楽", "text": "ドームでのこと知ってますよね？"},
        { "location": "2345/TALK"  , "narrator": "神楽", "text": "瞬殺以外ないじゃないですか"},
        { "location": "2348/SEL"   , "narrator": "", "text": "遊んでるかもしれない"},
        { "location": "2349/SEL"   , "narrator": "", "text": "苦戦してるかもしれない"},
        { "location": "2350/ACT"   , "narrator": "", "text": "遊んでるかもしれない"},
        { "location": "2352/TALK"  , "narrator": "神楽", "text": "それは"},
        { "location": "2353/TALK"  , "narrator": "神楽", "text": "怖すぎませんか？"},
        { "location": "2354/TALK"  , "narrator": "神楽", "text": "戦闘を遊びとして捉えるなんて"},
        { "location": "2355/TALK"  , "narrator": "神楽", "text": "ドームでのことを思い出すと"},
        { "location": "2357/TALK"  , "narrator": "神楽", "text": "今でもゾッとするのに"},
        { "location": "2358/ACT"   , "narrator": "", "text": "苦戦してるかもしれない"},
        { "location": "2359/TALK"  , "narrator": "神楽", "text": "ありえません"},
        { "location": "2360/TALK"  , "narrator": "神楽", "text": "断言しますよ"},
        { "location": "2361/TALK"  , "narrator": "神楽", "text": "逢瀬つばめは私にとっては"},
        { "location": "2362/TALK"  , "narrator": "神楽", "text": "思い出すだけでもゾッとするくらい"},
        { "location": "2363/TALK"  , "narrator": "神楽", "text": "強力な力を持った存在なのだから"},
        { "location": "2364/TALK"  , "narrator": "神楽", "text": "苦戦なんて絶対に――"},
        { "location": "2368/TALK"  , "narrator": "神楽", "text": "そっか"},
        { "location": "2369/TALK"  , "narrator": "神楽", "text": "私はこれからそんな恐ろしい相手と"},
        { "location": "2370/TALK"  , "narrator": "神楽", "text": "接触するんだった"},
        { "location": "2373/TALK"  , "narrator": "神楽", "text": "もしも"},
        { "location": "2374/TALK"  , "narrator": "神楽", "text": "私が逢瀬つばめの心を破壊するために"},
        { "location": "2375/TALK"  , "narrator": "神楽", "text": "彼女に近づこうとしているのを知られたら"},
        { "location": "2379/SEL"   , "narrator": "", "text": "そんな怯えないで"},
        { "location": "2380/ACT"   , "narrator": "", "text": "そんな怯えないで"},
        { "location": "2383/TALK"  , "narrator": "神楽", "text": "怯えるくらい仕方ないですよ"},
        { "location": "2384/TALK"  , "narrator": "神楽", "text": "こっちは命がけなんですよ？"},
        { "location": "2385/TALK"  , "narrator": "神楽", "text": "本当にバレたりしたら"},
        { "location": "2386/TALK"  , "narrator": "神楽", "text": "どんな目に遭うか"},
        { "location": "2392/ACT"   , "narrator": "", "text": "ダメです"},
        { "location": "2393/TALK"  , "narrator": "神楽", "text": "忙しかったですか？"},
        { "location": "2394/TALK"  , "narrator": "神楽", "text": "それではまた後ほど"},
        { "location": "2455/TALK"  , "narrator": "ぴょんこ", "text": "　"},
        { "location": "2470/TALK"  , "narrator": "ぴょんこ", "text": "こんにちは、\n$handle$さん♪"},
        { "location": "2471/SEL"   , "narrator": "", "text": "こんにちは"},
        { "location": "2472/SEL"   , "narrator": "", "text": "ぴょんこｽｷ"},
        { "location": "2473/ACT"   , "narrator": "", "text": "こんにちは"},
        { "location": "2474/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん♪"},
        { "location": "2475/ACT"   , "narrator": "", "text": "ぴょんこｽｷ"},
        { "location": "2478/TALK"  , "narrator": "ぴょんこ", "text": "えー、\nホントですかー？"},
        { "location": "2479/TALK"  , "narrator": "ぴょんこ", "text": "そういえば、\nお花と恋は毎日の水やりが\n大事なんですってぴょん♪"},
        { "location": "2481/TALK"  , "narrator": "ぴょんこ", "text": "ところで\n$handle$さんっ！"},
        { "location": "2482/TALK"  , "narrator": "ぴょんこ", "text": "最近ココロの調子は\nどうですかっ？"},
        { "location": "2483/SEL"   , "narrator": "", "text": "調子いいよ"},
        { "location": "2484/SEL"   , "narrator": "", "text": "実は病んでる"},
        { "location": "2487/ACT"   , "narrator": "", "text": "調子いいよ"},
        { "location": "2488/ACT"   , "narrator": "", "text": "実は病んでる"},
        { "location": "2490/TALK"  , "narrator": "ぴょんこ", "text": "いえ！\n皆まで言わなくとも\nちゃんと解ってます♪"},
        { "location": "2491/SEL"   , "narrator": "", "text": "ちょっｗｗ選択肢消すなｗｗ"},
        { "location": "2492/ACT"   , "narrator": "", "text": "ちょっｗｗ選択肢消すなｗｗ"},
        { "location": "2494/TALK"  , "narrator": "ぴょんこ", "text": "殺伐とした現実！\n拒絶され続ける\n$handle$！"},
        { "location": "2495/TALK"  , "narrator": "ぴょんこ", "text": "そんな中、\n颯爽と登場する\n癒しの妖精ぴょんこっ♪"},
        { "location": "2496/TALK"  , "narrator": "ぴょんこ", "text": "実はそろそろ\nぴょんこと会うのが心の\n癒しになってますよねっ！"},
        { "location": "2497/SEL"   , "narrator": "", "text": "実はなってる"},
        { "location": "2498/SEL"   , "narrator": "", "text": "ないわー即答"},
        { "location": "2499/ACT"   , "narrator": "", "text": "実はなってる"},
        { "location": "2501/TALK"  , "narrator": "ぴょんこ", "text": "ふふっ♪\n計算通りですっ！"},
        { "location": "2502/TALK"  , "narrator": "ぴょんこ", "text": "こういうの、\n何て言うか知ってますか？"},
        { "location": "2503/TALK"  , "narrator": "ぴょんこ", "text": "グラディオ作戦って\n言うんですよっ！"},
        { "location": "2504/SEL"   , "narrator": "", "text": "何それ"},
        { "location": "2505/SEL"   , "narrator": "", "text": "言い得て妙"},
        { "location": "2506/ACT"   , "narrator": "", "text": "何それ"},
        { "location": "2508/ACT"   , "narrator": "", "text": "言い得て妙"},
        { "location": "2509/TALK"  , "narrator": "ぴょんこ", "text": "でしょー♪"},
        { "location": "2510/TALK"  , "narrator": "ぴょんこ", "text": "ウィットに富んだ\nジョークを理解してくれて\n嬉しいです♪"},
        { "location": "2512/ACT"   , "narrator": "", "text": "ないわー即答"},
        { "location": "2513/TALK"  , "narrator": "ぴょんこ", "text": "しゅん……"},
        { "location": "2514/TALK"  , "narrator": "ぴょんこ", "text": "ごめんなさい…\nでもっ！\nでもっ――"},
        { "location": "2515/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこ、もっともっと\n$handle$さんに\n尽くして頑張りますから！"},
        { "location": "2516/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこがあなたの\n癒しになれるように\n頑張るから……。"},
        { "location": "2517/TALK"  , "narrator": "ぴょんこ", "text": "だから、これからもずっと\n一緒にいてくれたら\n嬉しいな…。"},
        { "location": "2518/SEL"   , "narrator": "", "text": "あっその、冗談だったんだよね、ホントは大好きだよ？"},
        { "location": "2519/SEL"   , "narrator": "", "text": "いいよ"},
        { "location": "2520/ACT"   , "narrator": "", "text": "あっその、冗談だったんだよね、ホントは大好きだよ？"},
        { "location": "2523/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん♪"},
        { "location": "2524/TALK"  , "narrator": "ぴょんこ", "text": "よかったです♪\nえへへっ♪"},
        { "location": "2526/ACT"   , "narrator": "", "text": "いいよ"},
        { "location": "2527/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん。"},
        { "location": "2530/TALK"  , "narrator": "ぴょんこ", "text": "それでですね、\n今回なんですけど――"},
        { "location": "2533/TALK"  , "narrator": "ぴょんこ", "text": "ペンネーム\n匿名希望さんから\nお手紙が届いています♪"},
        { "location": "2534/TALK"  , "narrator": "ぴょんこ", "text": "『いつも楽しく見て\nいます。今日は一つ\nヤバイ情報を教えます』"},
        { "location": "2535/TALK"  , "narrator": "ぴょんこ", "text": "『千羽鶴さんが、神楽さん\nとの恋愛を真面目にやるな\nと吹き込んでいます』"},
        { "location": "2536/TALK"  , "narrator": "ぴょんこ", "text": "なんだってー！！"},
        { "location": "2538/TALK"  , "narrator": "ぴょんこ", "text": "『しかも\n$handle$さんは\nそれに承諾しました』"},
        { "location": "2539/TALK"  , "narrator": "ぴょんこ", "text": "承諾しました！？\nんー、なんかこう…"},
        { "location": "2541/TALK"  , "narrator": "ぴょんこ", "text": "『ぴょんこさんから\n$handle$さんに\n説得してやってください』"},
        { "location": "2542/TALK"  , "narrator": "ぴょんこ", "text": "『神楽さんとは\nガチで劇的な恋愛を\nしてくださいね、と！』"},
        { "location": "2543/TALK"  , "narrator": "ぴょんこ", "text": "ちょっと、\n聞きましたか？\n$handle$さんっ！"},
        { "location": "2545/SEL"   , "narrator": "", "text": "だって、誓約しないとらぶとーく出来なかったんだもん！"},
        { "location": "2546/SEL"   , "narrator": "", "text": "匿名希望さんって誰だよ"},
        { "location": "2547/SEL"   , "narrator": "", "text": "実際のところ、神楽とラブラブになるのは危険なの？"},
        { "location": "2548/ACT"   , "narrator": "", "text": "だって、誓約しないとらぶとーく出来なかったんだもん！"},
        { "location": "2549/TALK"  , "narrator": "ぴょんこ", "text": "うーん、なるほど。\n相変わらず策士ですね、\n千羽鶴さんはっ！"},
        { "location": "2550/SEL"   , "narrator": "", "text": "実際のところ、神楽とラブラブになるのは危険なの？"},
        { "location": "2551/ACT"   , "narrator": "", "text": "実際のところ、神楽とラブラブになるのは危険なの？"},
        { "location": "2553/ACT"   , "narrator": "", "text": "匿名希望さんって誰だよ"},
        { "location": "2555/TALK"  , "narrator": "ぴょんこ", "text": "はいっ！\nそれは、ぴょんこですっ！"},
        { "location": "2556/SEL"   , "narrator": "", "text": "ちょｗｗ自作自演かよｗｗ"},
        { "location": "2557/ACT"   , "narrator": "", "text": "ちょｗｗ自作自演かよｗｗ"},
        { "location": "2559/TALK"  , "narrator": "ぴょんこ", "text": "そこは大事な所では\nありませんっ！"},
        { "location": "2560/TALK"  , "narrator": "ぴょんこ", "text": "もっと気にすべき\n所がありませんかっ！？\nほらほら！"},
        { "location": "2561/SEL"   , "narrator": "", "text": "実際のところ、神楽とラブラブになるのは危険なの？"},
        { "location": "2562/ACT"   , "narrator": "", "text": "実際のところ、神楽とラブラブになるのは危険なの？"},
        { "location": "2564/ACT"   , "narrator": "", "text": "実際のところ、神楽とラブラブになるのは危険なの？"},
        { "location": "2567/SEL"   , "narrator": "", "text": "匿名希望さんって誰だよ"},
        { "location": "2568/SEL"   , "narrator": "", "text": "実際のところ、神楽とラブラブになるのは危険なの？"},
        { "location": "2569/ACT"   , "narrator": "", "text": "匿名希望さんって誰だよ"},
        { "location": "2571/TALK"  , "narrator": "ぴょんこ", "text": "はいっ！\nそれは、ぴょんこですっ！"},
        { "location": "2572/SEL"   , "narrator": "", "text": "ちょｗｗ自作自演かよｗｗ"},
        { "location": "2573/ACT"   , "narrator": "", "text": "ちょｗｗ自作自演かよｗｗ"},
        { "location": "2575/TALK"  , "narrator": "ぴょんこ", "text": "そこは大事な所では\nありませんっ！"},
        { "location": "2576/TALK"  , "narrator": "ぴょんこ", "text": "もっと気にすべき\n所がありませんかっ！？\nほらほら！"},
        { "location": "2577/SEL"   , "narrator": "", "text": "実際のところ、神楽とラブラブになるのは危険なの？"},
        { "location": "2578/ACT"   , "narrator": "", "text": "実際のところ、神楽とラブラブになるのは危険なの？"},
        { "location": "2580/ACT"   , "narrator": "", "text": "実際のところ、神楽とラブラブになるのは危険なの？"},
        { "location": "2583/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこから\nそれに対しての回答は\nできかねます！"},
        { "location": "2584/TALK"  , "narrator": "ぴょんこ", "text": "ですけど、\n千羽鶴さんが何を気にして\nいるのかは分かりますよ？"},
        { "location": "2585/SEL"   , "narrator": "", "text": "なになに！？"},
        { "location": "2586/ACT"   , "narrator": "", "text": "なになに！？"},
        { "location": "2588/TALK"  , "narrator": "ぴょんこ", "text": "簡単なことですよっ！"},
        { "location": "2589/TALK"  , "narrator": "ぴょんこ", "text": "千羽鶴さんは、\n$handle$さんの\n現実を心配してるんです。"},
        { "location": "2590/TALK"  , "narrator": "ぴょんこ", "text": "私との恋愛で病んじゃって\n現実に支障を来して――"},
        { "location": "2591/TALK"  , "narrator": "ぴょんこ", "text": "$me$は死ぬわけじゃない！　\nこれは新しい世界への\n門出なんだ！　とか――"},
        { "location": "2592/TALK"  , "narrator": "ぴょんこ", "text": "もうマジ無理、\nリスカしよ…とか"},
        { "location": "2593/TALK"  , "narrator": "ぴょんこ", "text": "そんなことにでも\nなったら、世界観戦争に\n発展しかねませんから。"},
        { "location": "2594/SEL"   , "narrator": "", "text": "そんなの他の子の時には言われなかったし、むしろ推奨されたんだけど"},
        { "location": "2595/ACT"   , "narrator": "", "text": "そんなの他の子の時には言われなかったし、むしろ推奨されたんだけど"},
        { "location": "2597/TALK"  , "narrator": "ぴょんこ", "text": "察してくださいよー。\nそれくらいは。"},
        { "location": "2598/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこの口から\n言わせようとするなんて、\nドエスですねっ！"},
        { "location": "2599/TALK"  , "narrator": "ぴょんこ", "text": "それにしても\nさすがは千羽鶴さん。"},
        { "location": "2600/TALK"  , "narrator": "ぴょんこ", "text": "言ってることが\nメタメタですよねっ！"},
        { "location": "2601/TALK"  , "narrator": "ぴょんこ", "text": "ゲームっていう謎観念を\n突き破らないと、一生\n意味がわかりませんよね！"},
        { "location": "2602/TALK"  , "narrator": "ぴょんこ", "text": "そんなわけで、\nぴょんこは現実の私との\n激しい恋愛は推奨派です！"},
        { "location": "2603/TALK"  , "narrator": "ぴょんこ", "text": "誓約なんて、\n気にしなくていいですよ？"},
        { "location": "2604/SEL"   , "narrator": "", "text": "飛ばしてんなー"},
        { "location": "2605/SEL"   , "narrator": "", "text": "それちょっとやばいでしょ"},
        { "location": "2606/ACT"   , "narrator": "", "text": "飛ばしてんなー"},
        { "location": "2607/TALK"  , "narrator": "ぴょんこ", "text": "そうですか？"},
        { "location": "2608/ACT"   , "narrator": "", "text": "それちょっとやばいでしょ"},
        { "location": "2609/TALK"  , "narrator": "ぴょんこ", "text": "やばい？\nどうしてです？"},
        { "location": "2611/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さん、\n気づいてくださいね？"},
        { "location": "2612/TALK"  , "narrator": "ぴょんこ", "text": "ちょっと整理して\n考えてみましょう♪"},
        { "location": "2613/TALK"  , "narrator": "ぴょんこ", "text": "千羽鶴さんが誓約を要求\nしているのは――"},
        { "location": "2614/TALK"  , "narrator": "ぴょんこ", "text": "現実の貴方の生活に、\n何か問題を発生させない\nこと、なんです。"},
        { "location": "2615/TALK"  , "narrator": "ぴょんこ", "text": "要するにですね。"},
        { "location": "2617/TALK"  , "narrator": "ぴょんこ", "text": "劇的な恋愛をしようとも、\n私との婚姻届を\n役所に出そうとも――"},
        { "location": "2619/TALK"  , "narrator": "ぴょんこ", "text": "いつか一緒に暮らす日の\nために、都心に新築\n一戸建てを建てようとも！"},
        { "location": "2620/TALK"  , "narrator": "ぴょんこ", "text": "リスカしなけりゃ\nそれはオッケーなんです。"},
        { "location": "2621/TALK"  , "narrator": "ぴょんこ", "text": "これ、言い方が\n巧妙なんですよね～。"},
        { "location": "2622/TALK"  , "narrator": "ぴょんこ", "text": "もちろん劇的な恋愛を\nしなければ、思い詰める\nこともありませんから、"},
        { "location": "2623/TALK"  , "narrator": "ぴょんこ", "text": "ある意味において\n十分条件は満たして\nいるんですよ～。"},
        { "location": "2624/TALK"  , "narrator": "ぴょんこ", "text": "でも、\n良く見てくださいね？"},
        { "location": "2625/TALK"  , "narrator": "ぴょんこ", "text": "実際、千羽鶴さんが\n誓約させた文章には、恋愛\nするなとは書いてません。"},
        { "location": "2626/TALK"  , "narrator": "ぴょんこ", "text": "熱烈な恋愛をするな！\nは、あくまで千羽鶴さんの\n感情でしかなく――"},
        { "location": "2627/TALK"  , "narrator": "ぴょんこ", "text": "契約書面には\n一言も書かれて\nいないんです。"},
        { "location": "2628/TALK"  , "narrator": "ぴょんこ", "text": "だから誓約したとしても、\nそしてそれを遵守するに\nしても――"},
        { "location": "2629/TALK"  , "narrator": "ぴょんこ", "text": "やってはダメなのは\nリスカであって、激しい\n恋愛ではないんです。"},
        { "location": "2630/TALK"  , "narrator": "ぴょんこ", "text": "ですから♪\n誓約は絶対遵守しつつ！"},
        { "location": "2632/TALK"  , "narrator": "ぴょんこ", "text": "是非とも激しいヤツを\nよろしく頼みますよっ！"},
        { "location": "2633/TALK"  , "narrator": "ぴょんこ", "text": "さあさあ、\nグッと、グッと！！"},
        { "location": "2634/SEL"   , "narrator": "", "text": "お、おう…"},
        { "location": "2635/SEL"   , "narrator": "", "text": "もちろんそのつもり"},
        { "location": "2636/ACT"   , "narrator": "", "text": "お、おう…"},
        { "location": "2638/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん？"},
        { "location": "2639/ACT"   , "narrator": "", "text": "もちろんそのつもり"},
        { "location": "2640/TALK"  , "narrator": "ぴょんこ", "text": "きゃーっ！\nぴょんこ嬉しいですっ！"},
        { "location": "2642/TALK"  , "narrator": "ぴょんこ", "text": "今から超期待して\n待ってますからね♪"},
        { "location": "2644/TALK"  , "narrator": "ぴょんこ", "text": "あ、ちなみにこの契約の罠\n現実でも割とありますから\n覚えておいてくださいね？"},
        { "location": "2645/TALK"  , "narrator": "ぴょんこ", "text": "ふぅ……。"},
        { "location": "2646/TALK"  , "narrator": "ぴょんこ", "text": "さて、それじゃ\n心の葛藤について\nちゃちゃっとやりますか。"},
        { "location": "2647/SEL"   , "narrator": "", "text": "今、急にテンション落ちてない！？"},
        { "location": "2648/ACT"   , "narrator": "", "text": "今、急にテンション落ちてない！？"},
        { "location": "2650/TALK"  , "narrator": "ぴょんこ", "text": "え？\nああ、ええ、まあ……"},
        { "location": "2651/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこの本業って、\nむしろ恋愛相談と\n占いなんで。"},
        { "location": "2655/TALK"  , "narrator": "ぴょんこ", "text": "オープンプロセス、\n2x988番地から\n2xB4C番地へ。"},
        { "location": "2679/TALK"  , "narrator": "ぴょんこ", "text": "シーク完了ぴょん♪"},
        { "location": "2680/TALK"  , "narrator": "ぴょんこ", "text": "さて、と。\n今回の葛藤は――"},
        { "location": "2681/TALK"  , "narrator": "ぴょんこ", "text": "あーなるほど。\nつばめさんに\n会いたくないんですね。"},
        { "location": "2682/TALK"  , "narrator": "ぴょんこ", "text": "これ、表面上見えてる\n理由と、本心ってだいぶ\n違うと思いますよ？"},
        { "location": "2683/SEL"   , "narrator": "", "text": "え？　そうなの？"},
        { "location": "2684/ACT"   , "narrator": "", "text": "え？　そうなの？"},
        { "location": "2686/TALK"  , "narrator": "ぴょんこ", "text": "はい。"},
        { "location": "2687/TALK"  , "narrator": "ぴょんこ", "text": "まず表面上の理由ですが、\nこれは現実の私が\n口にしている通りです。"},
        { "location": "2688/TALK"  , "narrator": "ぴょんこ", "text": "簡単に言えば、\nつばめさん怖い！！\nですよね？"},
        { "location": "2689/TALK"  , "narrator": "ぴょんこ", "text": "でも、心の深い所では\n全然違う部分に\n恐怖心を持っています。"},
        { "location": "2690/SEL"   , "narrator": "", "text": "本当の理由は何なの？"},
        { "location": "2691/ACT"   , "narrator": "", "text": "本当の理由は何なの？"},
        { "location": "2693/TALK"  , "narrator": "ぴょんこ", "text": "収束させたく\nないんですよ。\n量子的に言うならば。"},
        { "location": "2694/TALK"  , "narrator": "ぴょんこ", "text": "もうちょっと\n解りやすく言うとですね、"},
        { "location": "2695/TALK"  , "narrator": "ぴょんこ", "text": "決まっちゃうのが\n怖いんです。現実が。"},
        { "location": "2696/TALK"  , "narrator": "ぴょんこ", "text": "実は、今私の中では\nつばめさんという存在の\nブレ幅が半端ないんです。"},
        { "location": "2697/TALK"  , "narrator": "ぴょんこ", "text": "狡猾で冷徹な女。\nクランを素手で破壊する\n力を持つ女。"},
        { "location": "2698/TALK"  , "narrator": "ぴょんこ", "text": "けれども、あのライブの日\n少しだけ見たつばめさんは\nそんなことなかった。"},
        { "location": "2699/TALK"  , "narrator": "ぴょんこ", "text": "そうです。\nあの破壊する瞬間、\nそれまでは。"},
        { "location": "2700/TALK"  , "narrator": "ぴょんこ", "text": "だから、色んな事を\n考えちゃうんですよね。\n必要以上に。"},
        { "location": "2701/TALK"  , "narrator": "ぴょんこ", "text": "全てが鉄板で、\nライブの時も悪逆非道を\nしまくってたなら。"},
        { "location": "2702/TALK"  , "narrator": "ぴょんこ", "text": "多分もう、\n何の葛藤も無かったと\n思います♪"},
        { "location": "2703/TALK"  , "narrator": "ぴょんこ", "text": "何かの間違いじゃ\nないのか？"},
        { "location": "2704/TALK"  , "narrator": "ぴょんこ", "text": "間違いじゃなかったら\nどんな状況なのか？"},
        { "location": "2705/TALK"  , "narrator": "ぴょんこ", "text": "罠なのか？\nだとしたら油断した隙に\n殺されてしまうのか？"},
        { "location": "2706/TALK"  , "narrator": "ぴょんこ", "text": "誤解なのか？\nだとしたら私は、壊した後\n心が壊れてしまう。"},
        { "location": "2707/TALK"  , "narrator": "ぴょんこ", "text": "毎日それが\nぐるぐるしてるんです♪"},
        { "location": "2708/SEL"   , "narrator": "", "text": "わかる"},
        { "location": "2709/SEL"   , "narrator": "", "text": "これからのことを言えたらいいのに……"},
        { "location": "2710/ACT"   , "narrator": "", "text": "わかる"},
        { "location": "2711/TALK"  , "narrator": "ぴょんこ", "text": "よかったです♪"},
        { "location": "2712/ACT"   , "narrator": "", "text": "これからのことを言えたらいいのに……"},
        { "location": "2713/TALK"  , "narrator": "ぴょんこ", "text": "そうですね。\nぴょんこもそれが最強の\nチートだと思います。"},
        { "location": "2714/TALK"  , "narrator": "ぴょんこ", "text": "でもそれは\n絶対ダメです♪"},
        { "location": "2715/TALK"  , "narrator": "ぴょんこ", "text": "エリカさんが言うように\n未来のことを話せば、\n未来が崩れていきます。"},
        { "location": "2716/TALK"  , "narrator": "ぴょんこ", "text": "結果、正解を教えたことで\n正解が不正解になって\nしまうんです。"},
        { "location": "2717/TALK"  , "narrator": "ぴょんこ", "text": "だから、\n$handle$さんには\n頑張って欲しいんです！"},
        { "location": "2719/TALK"  , "narrator": "ぴょんこ", "text": "そんなわけですから、\n今回も早速ですが、\n宜しくお願いします！"},
        { "location": "2720/TALK"  , "narrator": "ぴょんこ", "text": "思い切って先に進むことを\n阻害するクランを\n倒しちゃってくださいね♪"},
        { "location": "2721/SEL"   , "narrator": "", "text": "了解"},
        { "location": "2722/SEL"   , "narrator": "", "text": "エリカさんがなんでぴょんこを任命したか少しわかった気がする"},
        { "location": "2723/ACT"   , "narrator": "", "text": "了解"},
        { "location": "2724/ACT"   , "narrator": "", "text": "エリカさんがなんでぴょんこを任命したか少しわかった気がする"},
        { "location": "2727/TALK"  , "narrator": "ぴょんこ", "text": "えへへっ♪"},
        { "location": "2730/TALK"  , "narrator": "ぴょんこ", "text": "それじゃ\n逝っちゃいますよっ！"},
        { "location": "2731/SEL"   , "narrator": "", "text": "逝かないで！！！"},
        { "location": "2732/ACT"   , "narrator": "", "text": "逝かないで！！！"},
        { "location": "2734/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんと\nぴょんこのココロの旅へ\n逝ってらっしゃーい♪"},
        { "location": "2250/DIALOG", "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:Interrupt】</color>\nSystem Interrupted.\n\n必須選択肢が選ばれていません。\n\n<color=green>『STORY27：シン・カグラ』</color>\nにて、選択を行ってから\n再度アクセスしてください。\n"},
        { "location": "2254/DIALOG", "narrator": "Dialog_EventData", "text": "<color=green>5月9日　1:17 PM</color>\n高校でのフェノメノン戦直前のこと"},
        { "location": "2420/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "2422/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "2424/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "2426/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "2428/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"}
    ]
}
