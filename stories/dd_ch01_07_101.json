        { "location": "351/ACT"   , "narrator": "", "text": "アーヤがいなくなって寂しい？"},
        { "location": "353/TALK"  , "narrator": "つばめ", "text": "寂しそぅだった？(´･ω･｀) "},
        { "location": "355/TALK"  , "narrator": "つばめ", "text": "そんなことなぃよ"},
        { "location": "356/TALK"  , "narrator": "つばめ", "text": "大丈夫(*´︶`*)"},
        { "location": "358/SEL"   , "narrator": "", "text": "それはそうと"},
        { "location": "359/ACT"   , "narrator": "", "text": "それはそうと"},
        { "location": "361/TALK"  , "narrator": "つばめ", "text": "なに？(´･ω･｀) "},
        { "location": "363/SEL"   , "narrator": "", "text": "許してもらえてよかったね"},
        { "location": "364/SEL"   , "narrator": "", "text": "あのお父さんが…信じられない"},
        { "location": "365/ACT"   , "narrator": "", "text": "許してもらえてよかったね"},
        { "location": "367/TALK"  , "narrator": "つばめ", "text": "ぉ父さんのこと？"},
        { "location": "369/TALK"  , "narrator": "つばめ", "text": "ぅん"},
        { "location": "371/TALK"  , "narrator": "つばめ", "text": "まぁね"},
        { "location": "372/TALK"  , "narrator": "つばめ", "text": "本当よかったよ"},
        { "location": "373/ACT"   , "narrator": "", "text": "あのお父さんが…信じられない"},
        { "location": "374/TALK"  , "narrator": "つばめ", "text": "信じられなぃ？"},
        { "location": "376/TALK"  , "narrator": "つばめ", "text": "そぅだよね(o´Д`)=з"},
        { "location": "377/TALK"  , "narrator": "つばめ", "text": "でも"},
        { "location": "378/TALK"  , "narrator": "つばめ", "text": "本当だよ"},
        { "location": "379/TALK"  , "narrator": "つばめ", "text": "本当に許してもらったの"},
        { "location": "381/TALK"  , "narrator": "つばめ", "text": "だから"},
        { "location": "382/TALK"  , "narrator": "つばめ", "text": "大丈夫だよ"},
        { "location": "384/SEL"   , "narrator": "", "text": "何だか元気がないみたい"},
        { "location": "385/ACT"   , "narrator": "", "text": "何だか元気がないみたい"},
        { "location": "388/TALK"  , "narrator": "つばめ", "text": "ぅぅん"},
        { "location": "389/TALK"  , "narrator": "つばめ", "text": "そんなことなぃよ"},
        { "location": "390/TALK"  , "narrator": "つばめ", "text": "わたし"},
        { "location": "392/TALK"  , "narrator": "つばめ", "text": "平気だから"},
        { "location": "441/TALK"  , "narrator": "つばめ", "text": "ようこそ\n[ココロゲート]へ。"},
        { "location": "442/TALK"  , "narrator": "つばめ", "text": "早速【問題の扉】を\nコールしましょうか。"},
        { "location": "449/TALK"  , "narrator": "つばめ", "text": "オープンプロセス、\n0x22D番地から\n0x8A3番地へ。"},
        { "location": "464/TALK"  , "narrator": "つばめ", "text": "シーク完了しました。"},
        { "location": "466/TALK"  , "narrator": "つばめ", "text": "さて、今回は……"},
        { "location": "468/TALK"  , "narrator": "つばめ", "text": "あー、なるほど。"},
        { "location": "469/SEL"   , "narrator": "", "text": "何となく分かってるけど"},
        { "location": "470/ACT"   , "narrator": "", "text": "何となく分かってるけど"},
        { "location": "473/TALK"  , "narrator": "つばめ", "text": "やっぱりですか。"},
        { "location": "474/TALK"  , "narrator": "つばめ", "text": "ココロファイルナンバー\n01-221-21によれば、\n今回の原因はですね――"},
        { "location": "475/TALK"  , "narrator": "つばめ", "text": "『父親と和解できてない\nけど、気まずくて連絡を\n取ることもできない』"},
        { "location": "476/TALK"  , "narrator": "つばめ", "text": "……です。"},
        { "location": "478/TALK"  , "narrator": "つばめ", "text": "ですがこれはもう、\n和解する以外に\n道はありませんよね。"},
        { "location": "479/SEL"   , "narrator": "", "text": "確かに"},
        { "location": "480/ACT"   , "narrator": "", "text": "確かに"},
        { "location": "482/TALK"  , "narrator": "つばめ", "text": "度胸が足りないんですよ、\nわたし。度胸が！"},
        { "location": "483/TALK"  , "narrator": "つばめ", "text": "$handle$さんっ！\n[クラン]を倒して、\nわたしに度胸をください！"},
        { "location": "484/TALK"  , "narrator": "つばめ", "text": "$handle$さんと\nわたしに、\n素敵なココロの旅を！"},
