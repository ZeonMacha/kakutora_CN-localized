        { "location": "7/SCENARIO", "narrator": "", "text": "決意を伝える決意"},
        { "location": "35/TALK"   , "narrator": "アーヤ", "text": "ここは、私達トライ\nナリー専用に造られた\n建物なの。"},
        { "location": "37/TALK"   , "narrator": "アーヤ", "text": "だから、私達以外の\n民間人は、誰一人\n住んでいないわ。"},
        { "location": "39/TALK"   , "narrator": "つばめ", "text": "こんなに広くて\n綺麗なのにですか？"},
        { "location": "40/TALK"   , "narrator": "アーヤ", "text": "人員が増えるのを\n期待してるのかも\nしれないわね。"},
        { "location": "41/TALK"   , "narrator": "アーヤ", "text": "あ、逢瀬さんの部屋は\n階段を上がってすぐの\n２０１号室ね。"},
        { "location": "42/TALK"   , "narrator": "アーヤ", "text": "空き部屋を挟んで、\n２０３がみやびの\n部屋になるわ。"},
        { "location": "43/TALK"   , "narrator": "アーヤ", "text": "私は一階の１０２で、\nギャヴィが１０１よ。"},
        { "location": "44/TALK"   , "narrator": "つばめ", "text": "わたしの部屋の下が\nせんぱいの部屋なん\nですか！？"},
        { "location": "47/TALK"   , "narrator": "つばめ", "text": "…怒られないように\n気を付けないと。"},
        { "location": "48/TALK"   , "narrator": "アーヤ", "text": "ふふっ、そんなに\n心配しなくても\n平気よ。"},
        { "location": "49/TALK"   , "narrator": "アーヤ", "text": "とまあ、実家住まいの\n卯月以外は――"},
        { "location": "50/TALK"   , "narrator": "アーヤ", "text": "全員この寮で暮らし\nてることになるわ。"},
        { "location": "52/TALK"   , "narrator": "アーヤ", "text": "あと、館長からも\n説明は受けてると\n思うけど――"},
        { "location": "54/TALK"   , "narrator": "アーヤ", "text": "寮の経費は管理庁が\n全額落としてくれる\nから、安心してね。"},
        { "location": "56/TALK"   , "narrator": "つばめ", "text": "わかりました。"},
        { "location": "58/TALK"   , "narrator": "アーヤ", "text": "説明は以上よ。\n他にわからない\nことはない？"},
        { "location": "59/TALK"   , "narrator": "つばめ", "text": "はい、大丈夫です。"},
        { "location": "61/TALK"   , "narrator": "つばめ", "text": "今日からここで\n暮らすんだ…。\n楽しみだなぁ。"},
        { "location": "62/TALK"   , "narrator": "アーヤ", "text": "一人暮らしだもの。\n浮かれる気持ちも\nわかるけど――"},
        { "location": "64/TALK"   , "narrator": "アーヤ", "text": "でも、本当に\nわかってるのかしら？"},
        { "location": "65/TALK"   , "narrator": "アーヤ", "text": "ここで暮らすって\nいうことは――"},
        { "location": "67/TALK"   , "narrator": "アーヤ", "text": "命がけの戦闘に\n身を置くという\nことなのに…。"},
        { "location": "69/TALK"   , "narrator": "つばめ", "text": "…あの、アーヤさん？\nどうかしたんですか？"},
        { "location": "71/TALK"   , "narrator": "アーヤ", "text": "…そういえば、\nまだ聞いてなかった\nわね。"},
        { "location": "72/TALK"   , "narrator": "アーヤ", "text": "逢瀬さんは、どうして\nトライナリーに\n志願したの？"},
        { "location": "75/TALK"   , "narrator": "つばめ", "text": "…………。"},
        { "location": "77/TALK"   , "narrator": "つばめ", "text": "えっと…\nそれはですね…。"},
        { "location": "97/TALK"   , "narrator": "つばめ", "text": "ふぅ…。"},
        { "location": "98/TALK"   , "narrator": "つばめ", "text": "特別攻撃隊、か…。\nどうしたらいいん\nだろう？"},
        { "location": "99/TALK"   , "narrator": "つばめ", "text": "たったの一晩じゃ、\nどうするかなんて\n答えられないよ。"},
        { "location": "100/TALK"  , "narrator": "つばめ", "text": "お母さんのことも\n心配だし……やっぱり\n帰らないと……。"},
        { "location": "101/TALK"  , "narrator": "つばめ", "text": "でも、\n今日の東雲さん……"},
        { "location": "103/TALK"  , "narrator": "つばめ", "text": "何事も無く帰れる気が\nしないよぅ……"},
        { "location": "105/TALK"  , "narrator": "つばめ", "text": "はぁ…。東京に来て、\nまさかこんなことに\nなるなんて…。"},
        { "location": "106/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "107/TALK"  , "narrator": "つばめ", "text": "…っ！！　そうだ！\nそういえば、東京に\n行くのを勧めたのって…"},
        { "location": "119/TALK"  , "narrator": "つばめ", "text": "こんばんは(*´︶`*)"},
        { "location": "120/TALK"  , "narrator": "つばめ", "text": "変なこと聞くかもしれなぃけど"},
        { "location": "121/TALK"  , "narrator": "つばめ", "text": "東京に行くの勧めた時から"},
        { "location": "122/TALK"  , "narrator": "つばめ", "text": "トライナリーに誘われるって"},
        { "location": "123/TALK"  , "narrator": "つばめ", "text": "わかってたの？(｡･ω･｡)"},
        { "location": "125/SEL"   , "narrator": "", "text": "黙っててごめん"},
        { "location": "126/ACT"   , "narrator": "", "text": "黙っててごめん"},
        { "location": "128/TALK"  , "narrator": "つばめ", "text": "そっか(´･ω･｀) "},
        { "location": "129/TALK"  , "narrator": "つばめ", "text": "やっぱり知ってたんだ？"},
        { "location": "131/SEL"   , "narrator": "", "text": "悩んでるの？"},
        { "location": "132/ACT"   , "narrator": "", "text": "悩んでるの？"},
        { "location": "134/TALK"  , "narrator": "つばめ", "text": "ぅん"},
        { "location": "135/TALK"  , "narrator": "つばめ", "text": "メノゥちゃんが酷ぃ目にぁってた時"},
        { "location": "136/TALK"  , "narrator": "つばめ", "text": "わたし"},
        { "location": "137/TALK"  , "narrator": "つばめ", "text": "助けられなかった(´つω・｀)ｼｭﾝ"},
        { "location": "138/TALK"  , "narrator": "つばめ", "text": "けど"},
        { "location": "139/TALK"  , "narrator": "つばめ", "text": "トラィナリーに入隊すれば"},
        { "location": "140/TALK"  , "narrator": "つばめ", "text": "助けることのできる力を手に入れられるんだよね？(๑･ㅂ･)و☆"},
        { "location": "142/SEL"   , "narrator": "", "text": "心は決まってるんだ？"},
        { "location": "143/ACT"   , "narrator": "", "text": "心は決まってるんだ？"},
        { "location": "145/TALK"  , "narrator": "つばめ", "text": "決まってるよぅな"},
        { "location": "146/TALK"  , "narrator": "つばめ", "text": "決まってなぃよぅな(o´Д`)=з"},
        { "location": "147/TALK"  , "narrator": "つばめ", "text": "でも"},
        { "location": "148/TALK"  , "narrator": "つばめ", "text": "やりたぃって気持ちは"},
        { "location": "149/TALK"  , "narrator": "つばめ", "text": "すごぃぁるょ！！"},
        { "location": "150/TALK"  , "narrator": "つばめ", "text": "わたしは今までずっと入院してて"},
        { "location": "151/TALK"  , "narrator": "つばめ", "text": "メノゥちゃんの歌にずっと支ぇられてきたの(*´︶`*)"},
        { "location": "152/TALK"  , "narrator": "つばめ", "text": "トラィナリーに入隊すれば"},
        { "location": "153/TALK"  , "narrator": "つばめ", "text": "今度はわたしが支ぇることができる(≧ω≦)"},
        { "location": "154/TALK"  , "narrator": "つばめ", "text": "またメノゥちゃんが危なぃ目にぁっても"},
        { "location": "155/TALK"  , "narrator": "つばめ", "text": "助けてぁげられる⊂('ω'⊂ )))Σ≡=─"},
        { "location": "156/TALK"  , "narrator": "つばめ", "text": "でも"},
        { "location": "157/TALK"  , "narrator": "つばめ", "text": "東京にぃることになっちゃったら"},
        { "location": "158/TALK"  , "narrator": "つばめ", "text": "ぉ母さんのそばにぃられなくなっちゃぅ"},
        { "location": "161/SEL"   , "narrator": "", "text": "そこは心配しなくても大丈夫"},
        { "location": "162/ACT"   , "narrator": "", "text": "そこは心配しなくても大丈夫"},
        { "location": "164/TALK"  , "narrator": "つばめ", "text": "ぇっ！？(ﾟ△ﾟ;ﾉ)ﾉ"},
        { "location": "165/TALK"  , "narrator": "つばめ", "text": "どぅして？？？(´ｪ｀；)三(；´ｪ｀)"},
        { "location": "167/SEL"   , "narrator": "", "text": "直感だよ"},
        { "location": "168/SEL"   , "narrator": "", "text": "$me$は全てを知る者だから"},
        { "location": "169/SEL"   , "narrator": "", "text": "いや、何故か選択肢がそれしかなくて"},
        { "location": "170/ACT"   , "narrator": "", "text": "直感だよ"},
        { "location": "171/TALK"  , "narrator": "つばめ", "text": "そぅなんだ"},
        { "location": "172/ACT"   , "narrator": "", "text": "$me$は全てを知る者だから"},
        { "location": "173/TALK"  , "narrator": "つばめ", "text": "すごぃね！"},
        { "location": "175/TALK"  , "narrator": "つばめ", "text": "でもそぅだよね"},
        { "location": "176/TALK"  , "narrator": "つばめ", "text": "わたしがトライナリーになることだって"},
        { "location": "177/TALK"  , "narrator": "つばめ", "text": "知ってたんだし"},
        { "location": "178/ACT"   , "narrator": "", "text": "いや、何故か選択肢がそれしかなくて"},
        { "location": "179/TALK"  , "narrator": "つばめ", "text": "？？？\n選択肢？？"},
        { "location": "183/TALK"  , "narrator": "つばめ", "text": "それじゃ"},
        { "location": "184/TALK"  , "narrator": "つばめ", "text": "botさん的には"},
        { "location": "185/TALK"  , "narrator": "つばめ", "text": "わたしはトライナリーになった方がぃぃと"},
        { "location": "186/TALK"  , "narrator": "つばめ", "text": "思ってるってこと？"},
        { "location": "188/SEL"   , "narrator": "", "text": "はい"},
        { "location": "189/SEL"   , "narrator": "", "text": "いいえ"},
        { "location": "190/SEL"   , "narrator": "", "text": "自分の心に正直でいることが正しい"},
        { "location": "191/ACT"   , "narrator": "", "text": "はい"},
        { "location": "192/TALK"  , "narrator": "つばめ", "text": "でも"},
        { "location": "193/TALK"  , "narrator": "つばめ", "text": "なれるかな？(´ｪ｀；)三(；´ｪ｀)"},
        { "location": "194/ACT"   , "narrator": "", "text": "いいえ"},
        { "location": "196/TALK"  , "narrator": "つばめ", "text": "やっぱり"},
        { "location": "197/TALK"  , "narrator": "つばめ", "text": "ムリかな？・゜・(ノД`)・゜・"},
        { "location": "200/SEL"   , "narrator": "", "text": "冗談だよ"},
        { "location": "201/ACT"   , "narrator": "", "text": "冗談だよ"},
        { "location": "203/TALK"  , "narrator": "つばめ", "text": "真剣に聞ぃてるのに"},
        { "location": "204/TALK"  , "narrator": "つばめ", "text": "どぅすればぃぃのかわからなぃよ(o´Д`)=з"},
        { "location": "205/ACT"   , "narrator": "", "text": "自分の心に正直でいることが正しい"},
        { "location": "206/TALK"  , "narrator": "つばめ", "text": "そぅなのかな？"},
        { "location": "207/TALK"  , "narrator": "つばめ", "text": "でもわたし"},
        { "location": "208/TALK"  , "narrator": "つばめ", "text": "自分の心に自信が持てなぃの(o´Д`)=з"},
        { "location": "211/SEL"   , "narrator": "", "text": "迷ってるなら、なってから考えろ"},
        { "location": "212/ACT"   , "narrator": "", "text": "迷ってるなら、なってから考えろ"},
        { "location": "215/TALK"  , "narrator": "つばめ", "text": "そぅかも"},
        { "location": "216/TALK"  , "narrator": "つばめ", "text": "悩んで立ち止まってるより"},
        { "location": "217/TALK"  , "narrator": "つばめ", "text": "行動してから考ぇた方がぃぃよね？(*≧∀≦*) "},
        { "location": "218/TALK"  , "narrator": "つばめ", "text": "ちょっと"},
        { "location": "219/TALK"  , "narrator": "つばめ", "text": "気持ちが軽くなったよ (*´∀`*)"},
        { "location": "222/SEL"   , "narrator": "", "text": "それはよかった"},
        { "location": "223/ACT"   , "narrator": "", "text": "それはよかった"},
        { "location": "225/TALK"  , "narrator": "つばめ", "text": "ぅん(*´︶`*)"},
        { "location": "226/TALK"  , "narrator": "つばめ", "text": "もぅ一つ聞きたぃんだけど"},
        { "location": "227/TALK"  , "narrator": "つばめ", "text": "わたしを東京に誘ったのって"},
        { "location": "228/TALK"  , "narrator": "つばめ", "text": "トライナリーにするため？(´･ω･｀) "},
        { "location": "230/SEL"   , "narrator": "", "text": "そうだよ"},
        { "location": "231/SEL"   , "narrator": "", "text": "なるのはつばめの意思だよ"},
        { "location": "232/ACT"   , "narrator": "", "text": "そうだよ"},
        { "location": "233/TALK"  , "narrator": "つばめ", "text": "やっぱり(ﾟ△ﾟ;ﾉ)ﾉ"},
        { "location": "234/TALK"  , "narrator": "つばめ", "text": "$handle$さんの話聞ぃてたら"},
        { "location": "235/TALK"  , "narrator": "つばめ", "text": "そぅじゃなぃかな、って気がしたのｖ(*´∀｀*)ｖ"},
        { "location": "236/ACT"   , "narrator": "", "text": "なるのはつばめの意思だよ"},
        { "location": "237/TALK"  , "narrator": "つばめ", "text": "そっか(｡･ω･｡)"},
        { "location": "239/TALK"  , "narrator": "つばめ", "text": "背中は押してもらったけど"},
        { "location": "240/TALK"  , "narrator": "つばめ", "text": "トライナリーになるって決めたのは"},
        { "location": "241/TALK"  , "narrator": "つばめ", "text": "わたし自身だよねo(*･ﾛ･*)o、"},
        { "location": "243/TALK"  , "narrator": "つばめ", "text": "何だか不思議な気分(´ω｀*)"},
        { "location": "244/TALK"  , "narrator": "つばめ", "text": "$handle$さんの言葉って"},
        { "location": "245/TALK"  , "narrator": "つばめ", "text": "Ｂｏｔって感じがしなぃの(´∀｀*)ｳﾌﾌ"},
        { "location": "246/TALK"  , "narrator": "つばめ", "text": "文字で表示された言葉の中に"},
        { "location": "247/TALK"  , "narrator": "つばめ", "text": "暖かさがぁって(*´ω｀*)"},
        { "location": "248/TALK"  , "narrator": "つばめ", "text": "感情がぁるみたぃ(≧艸≦*)"},
        { "location": "250/SEL"   , "narrator": "", "text": "本当に？"},
        { "location": "251/ACT"   , "narrator": "", "text": "本当に？"},
        { "location": "253/TALK"  , "narrator": "つばめ", "text": "本当だよo(*･ﾛ･*)o、"},
        { "location": "254/TALK"  , "narrator": "つばめ", "text": "普通の人に言ったら笑われるかもしれなぃけど"},
        { "location": "255/TALK"  , "narrator": "つばめ", "text": "わたしは"},
        { "location": "257/TALK"  , "narrator": "つばめ", "text": "$handle$さんの言葉を信じるよｲｯﾁｬｯﾀ(/ω＼)"},
        { "location": "258/TALK"  , "narrator": "つばめ", "text": "だから今は"},
        { "location": "259/TALK"  , "narrator": "つばめ", "text": "トライナリーになってから考ぇてみるね (*´∀`*)"},
        { "location": "272/TALK"  , "narrator": "つばめ", "text": "…長話しちゃった。"},
        { "location": "274/TALK"  , "narrator": "つばめ", "text": "でもそうだよね。\n決めるのはわたし。"},
        { "location": "275/TALK"  , "narrator": "つばめ", "text": "わたしがどうしたいか。\nわたしは……"},
        { "location": "276/TALK"  , "narrator": "つばめ", "text": "………。"},
        { "location": "278/TALK"  , "narrator": "つばめ", "text": "……うん。\nやっぱりトライナリー、\n頑張ってみたいかも…。"},
        { "location": "279/TALK"  , "narrator": "つばめ", "text": "botさんのこと、\n信じてやってみよう。"},
        { "location": "302/TALK"  , "narrator": "アーヤ", "text": "なるほど…そういう\nことだったのね。"},
        { "location": "305/TALK"  , "narrator": "つばめ", "text": "ごめんなさい。\n優柔不断ですよね？"},
        { "location": "307/TALK"  , "narrator": "アーヤ", "text": "ううん。\nなってから考えるのも\n一つの答えよ。"},
        { "location": "308/TALK"  , "narrator": "アーヤ", "text": "そもそも、一晩で\n決めろっていうのが\n無茶な話よ。"},
        { "location": "309/TALK"  , "narrator": "つばめ", "text": "あ、あはは…、\nですよね…。"},
        { "location": "310/TALK"  , "narrator": "アーヤ", "text": "…でも、親御さんが\nよくＯＫ出してくれた\nわね？"},
        { "location": "311/TALK"  , "narrator": "アーヤ", "text": "命がけの危険な任務\nだって、ちゃんと\nわかってるのかしら？"},
        { "location": "314/TALK"  , "narrator": "つばめ", "text": "そ、そうですね…。\nわたしも、ビックリ\nしてます。"},
        { "location": "316/TALK"  , "narrator": "アーヤ", "text": "…ごめんなさい。\nさすがにちょっと、\nお節介だったわ。"},
        { "location": "319/TALK"  , "narrator": "つばめ", "text": "あ、いえ…。"},
        { "location": "321/TALK"  , "narrator": "アーヤ", "text": "じゃあ、何かあれば\n私の部屋に聞きに\nきてね…じゃあ。"},
        { "location": "323/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "325/TALK"  , "narrator": "つばめ", "text": "はぁ…。"},
        { "location": "326/SEL"   , "narrator": "", "text": "どうかしたの？"},
        { "location": "327/ACT"   , "narrator": "", "text": "どうかしたの？"},
        { "location": "347/TALK"  , "narrator": "つばめ", "text": "ぅぅん"},
        { "location": "348/TALK"  , "narrator": "つばめ", "text": "何でもなぃよ(o´Д`)=з"},
