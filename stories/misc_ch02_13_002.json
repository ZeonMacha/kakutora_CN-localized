        { "location": "96/SCENARIO", "narrator": "", "text": "020_甘い甘いカレー"},
        { "location": "121/TALK"   , "narrator": "アーヤ", "text": "子供用のカレーって"},
        { "location": "122/TALK"   , "narrator": "アーヤ", "text": "カレーなのにカレーじゃないわよね"},
        { "location": "124/SEL"    , "narrator": "", "text": "カレーはカレーでしょ"},
        { "location": "125/SEL"    , "narrator": "", "text": "甘いからね"},
        { "location": "126/SEL"    , "narrator": "", "text": "アーヤのカレーが食べたいな"},
        { "location": "127/ACT"    , "narrator": "", "text": "カレーはカレーでしょ"},
        { "location": "128/TALK"   , "narrator": "アーヤ", "text": "そうだけど"},
        { "location": "129/TALK"   , "narrator": "アーヤ", "text": "違うのよ(--#)"},
        { "location": "130/ACT"    , "narrator": "", "text": "甘いからね"},
        { "location": "131/TALK"   , "narrator": "アーヤ", "text": "そうなのよ(￣Д￣ )"},
        { "location": "132/TALK"   , "narrator": "アーヤ", "text": "あまいのよねー"},
        { "location": "133/ACT"    , "narrator": "", "text": "アーヤのカレーが食べたいな"},
        { "location": "135/TALK"   , "narrator": "アーヤ", "text": "そう(^з^)-☆"},
        { "location": "136/TALK"   , "narrator": "アーヤ", "text": "今度は"},
        { "location": "138/TALK"   , "narrator": "アーヤ", "text": "カレーパーティーでもしようかしら＼(^O^)／"},
        { "location": "140/TALK"   , "narrator": "アーヤ", "text": "昔は"},
        { "location": "141/TALK"   , "narrator": "アーヤ", "text": "辛いカレーなんて食べられなかったはずなのに"},
        { "location": "142/TALK"   , "narrator": "アーヤ", "text": "今は辛いのがおいしいって思うのよね"},
        { "location": "144/SEL"    , "narrator": "", "text": "甘いのは甘いのでいい"},
        { "location": "145/SEL"    , "narrator": "", "text": "エスニックカレーもいける"},
        { "location": "146/SEL"    , "narrator": "", "text": "中辛の中辛さがたまらん"},
        { "location": "147/ACT"    , "narrator": "", "text": "甘いのは甘いのでいい"},
        { "location": "150/TALK"   , "narrator": "アーヤ", "text": "まあ"},
        { "location": "151/TALK"   , "narrator": "アーヤ", "text": "ありかもね"},
        { "location": "152/ACT"    , "narrator": "", "text": "エスニックカレーもいける"},
        { "location": "153/TALK"   , "narrator": "アーヤ", "text": "タイカレーとか"},
        { "location": "154/TALK"   , "narrator": "アーヤ", "text": "インドカレーね"},
        { "location": "156/TALK"   , "narrator": "アーヤ", "text": "いいわよね"},
        { "location": "157/ACT"    , "narrator": "", "text": "中辛の中辛さがたまらん"},
        { "location": "158/TALK"   , "narrator": "アーヤ", "text": "あら"},
        { "location": "160/TALK"   , "narrator": "アーヤ", "text": "なかなか深い発現"},
        { "location": "161/TALK"   , "narrator": "アーヤ", "text": "発言"},
        { "location": "163/TALK"   , "narrator": "アーヤ", "text": "移設によると"},
        { "location": "164/TALK"   , "narrator": "アーヤ", "text": "一説によると"},
        { "location": "165/TALK"   , "narrator": "アーヤ", "text": "カレーって幸せ成分を分泌させるんですって＼(◎o◎)／"},
        { "location": "166/TALK"   , "narrator": "アーヤ", "text": "合法ドラッグよ"},
        { "location": "168/TALK"   , "narrator": "アーヤ", "text": "カレーすごい＼(^O^)／"},
        { "location": "171/TALK"   , "narrator": "アーヤ", "text": "でも"},
        { "location": "172/TALK"   , "narrator": "アーヤ", "text": "子供カレーでも"},
        { "location": "173/TALK"   , "narrator": "アーヤ", "text": "そうなのかしらね？"}
    ]
}
