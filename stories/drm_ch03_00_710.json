        { "location": "150/SCENARIO", "narrator": "", "text": "790_足りない時があるの"},
        { "location": "175/TALK"    , "narrator": "ガブリエラ", "text": "足りないことがあるのよ"},
        { "location": "176/TALK"    , "narrator": "ガブリエラ", "text": "どうして気づいてくれないのかしら"},
        { "location": "177/TALK"    , "narrator": "ガブリエラ", "text": "乙女に言わせることじゃないわ"},
        { "location": "178/TALK"    , "narrator": "ガブリエラ", "text": "王子様"},
        { "location": "179/TALK"    , "narrator": "ガブリエラ", "text": "貴方がちゃんとエスコートするべきよ"},
        { "location": "180/TALK"    , "narrator": "ガブリエラ", "text": "そういうものでしょう？"},
        { "location": "182/TALK"    , "narrator": "ガブリエラ", "text": "いないのかしら・・・"},
        { "location": "186/SEL"     , "narrator": "", "text": "ずっといたよ"},
        { "location": "187/SEL"     , "narrator": "", "text": "面白いから黙ってた"},
        { "location": "188/ACT"     , "narrator": "", "text": "ずっといたよ"},
        { "location": "189/TALK"    , "narrator": "ガブリエラ", "text": "もう"},
        { "location": "191/TALK"    , "narrator": "ガブリエラ", "text": "待ってたのに！"},
        { "location": "192/ACT"     , "narrator": "", "text": "面白いから黙ってた"},
        { "location": "193/TALK"    , "narrator": "ガブリエラ", "text": "また"},
        { "location": "194/TALK"    , "narrator": "ガブリエラ", "text": "意地悪ばっかりして！！"},
        { "location": "196/TALK"    , "narrator": "ガブリエラ", "text": "ねえ$handle$"},
        { "location": "197/TALK"    , "narrator": "ガブリエラ", "text": "貴方最近"},
        { "location": "198/TALK"    , "narrator": "ガブリエラ", "text": "私のことを大事にしてないんじゃないかしら？"},
        { "location": "200/SEL"     , "narrator": "", "text": "なんで"},
        { "location": "201/SEL"     , "narrator": "", "text": "ばれたか"},
        { "location": "202/SEL"     , "narrator": "", "text": "ありえません、お姫様"},
        { "location": "203/ACT"     , "narrator": "", "text": "なんで"},
        { "location": "204/TALK"    , "narrator": "ガブリエラ", "text": "なんでって"},
        { "location": "205/TALK"    , "narrator": "ガブリエラ", "text": "なんででもよ"},
        { "location": "206/ACT"     , "narrator": "", "text": "ばれたか"},
        { "location": "207/TALK"    , "narrator": "ガブリエラ", "text": "やっぱり"},
        { "location": "209/TALK"    , "narrator": "ガブリエラ", "text": "そうなのね"},
        { "location": "210/ACT"     , "narrator": "", "text": "ありえません、お姫様"},
        { "location": "220/TALK"    , "narrator": "ガブリエラ", "text": "そういう言い方すればいいと思って"},
        { "location": "221/TALK"    , "narrator": "ガブリエラ", "text": "騙されないんだから"},
        { "location": "222/TALK"    , "narrator": "ガブリエラ", "text": "もう/////////////////"},
        { "location": "224/TALK"    , "narrator": "ガブリエラ", "text": "$handle$が"},
        { "location": "225/TALK"    , "narrator": "ガブリエラ", "text": "ちゃんと"},
        { "location": "226/TALK"    , "narrator": "ガブリエラ", "text": "私を大事にしているって"},
        { "location": "227/TALK"    , "narrator": "ガブリエラ", "text": "証明しなさいよね"},
        { "location": "229/SEL"     , "narrator": "", "text": "好きだよ"},
        { "location": "230/SEL"     , "narrator": "", "text": "愛してる"},
        { "location": "231/SEL"     , "narrator": "", "text": "世界一大事だから"},
        { "location": "232/ACT"     , "narrator": "", "text": "好きだよ"},
        { "location": "233/ACT"     , "narrator": "", "text": "愛してる"},
        { "location": "234/ACT"     , "narrator": "", "text": "世界一大事だから"},
        { "location": "237/TALK"    , "narrator": "ガブリエラ", "text": "もう"},
