    "entry":
    [
        { "location": "81/SCENARIO", "narrator": "", "text": "014_ずっとここは午後３時"},
        { "location": "106/TALK"   , "narrator": "ガブリエラ", "text": "ここにきて"},
        { "location": "107/TALK"   , "narrator": "ガブリエラ", "text": "となりに座って"},
        { "location": "108/TALK"   , "narrator": "ガブリエラ", "text": "そうすれば"},
        { "location": "109/TALK"   , "narrator": "ガブリエラ", "text": "ずっとここは午後３時"},
        { "location": "111/SEL"    , "narrator": "", "text": "お邪魔します"},
        { "location": "112/SEL"    , "narrator": "", "text": "また今度ね"},
        { "location": "113/SEL"    , "narrator": "", "text": "ずっとティータイムだね"},
        { "location": "115/TALK"   , "narrator": "ガブリエラ", "text": "お茶の時間よ、"},
        { "location": "118/TALK"   , "narrator": "ガブリエラ", "text": "マルザンナったら"},
        { "location": "121/ACT"    , "narrator": "", "text": "お邪魔します"},
        { "location": "122/TALK"   , "narrator": "ガブリエラ", "text": "いらっしゃいvvvvvvv"},
        { "location": "123/ACT"    , "narrator": "", "text": "また今度ね"},
        { "location": "124/TALK"   , "narrator": "ガブリエラ", "text": "あら"},
        { "location": "125/TALK"   , "narrator": "ガブリエラ", "text": "そうなの・・・"},
        { "location": "126/TALK"   , "narrator": "ガブリエラ", "text": "残念だわ・・・"},
        { "location": "136/ACT"    , "narrator": "", "text": "ずっとティータイムだね"},
        { "location": "138/TALK"   , "narrator": "ガブリエラ", "text": "そうなのよ♪"},
        { "location": "139/TALK"   , "narrator": "ガブリエラ", "text": "ずっとお茶とお菓子の時間なのｖ"},
        { "location": "140/TALK"   , "narrator": "ガブリエラ", "text": "素敵でしょう？"},
        { "location": "142/TALK"   , "narrator": "ガブリエラ", "text": "楽しい時間がずっと続けばいいのにね？"},
        { "location": "143/TALK"   , "narrator": "ガブリエラ", "text": "そうは思わないこと？"},
        { "location": "145/SEL"    , "narrator": "", "text": "そうだね"},
        { "location": "146/SEL"    , "narrator": "", "text": "辛いことがあったらいつでも聞くよ"},
        { "location": "147/SEL"    , "narrator": "", "text": "毎日が大はしゃぎ！"},
        { "location": "148/ACT"    , "narrator": "", "text": "そうだね"},
        { "location": "149/TALK"   , "narrator": "ガブリエラ", "text": "なんてね"},
        { "location": "150/TALK"   , "narrator": "ガブリエラ", "text": "そんな風に行かないことはちゃんとわかっていてよ？"},
        { "location": "151/ACT"    , "narrator": "", "text": "辛いことがあったらいつでも聞くよ"},
        { "location": "153/TALK"   , "narrator": "ガブリエラ", "text": "もう、マルザンナったら！"},
        { "location": "154/TALK"   , "narrator": "ガブリエラ", "text": "気を使い過ぎだわ！"},
        { "location": "155/TALK"   , "narrator": "ガブリエラ", "text": "人生ってそんな辛いことばかりじゃないわ"},
        { "location": "156/TALK"   , "narrator": "ガブリエラ", "text": "心配させちゃってごめんなさい"},
        { "location": "157/TALK"   , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "158/TALK"   , "narrator": "ガブリエラ", "text": "ありがとう"},
        { "location": "160/ACT"    , "narrator": "", "text": "毎日が大はしゃぎ！"},
        { "location": "161/TALK"   , "narrator": "ガブリエラ", "text": "そこまでテンションを上げる必要があるのかしら・・・"},
        { "location": "163/TALK"   , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "164/TALK"   , "narrator": "ガブリエラ", "text": "甘いお菓子には砂糖の入っていない飲み物が合うみたいに"},
        { "location": "165/TALK"   , "narrator": "ガブリエラ", "text": "甘くない時間も必要なのかもしれないわね"},
        { "location": "167/SEL"    , "narrator": "", "text": "ちょっと大人の意見だね"},
        { "location": "168/SEL"    , "narrator": "", "text": "甘いもの最高！"},
        { "location": "169/ACT"    , "narrator": "", "text": "ちょっと大人の意見だね"},
        { "location": "171/TALK"   , "narrator": "ガブリエラ", "text": "そうかしら？"},
        { "location": "172/TALK"   , "narrator": "ガブリエラ", "text": "私も先輩になったから"},
        { "location": "173/TALK"   , "narrator": "ガブリエラ", "text": "そのせいかもしれないわね♪"},
        { "location": "174/ACT"    , "narrator": "", "text": "甘いもの最高！"},
        { "location": "175/TALK"   , "narrator": "ガブリエラ", "text": "マルザンナはまだまだ子供なのね♪"},
        { "location": "176/TALK"   , "narrator": "ガブリエラ", "text": "かわいいわｖｖｖｖ"}
    ]
}
