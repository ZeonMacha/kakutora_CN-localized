{
    "dir": "chap29/daydra/dd_ch02_29_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "29205",
        "cid": "ayami",
        "title": "005 メインストーリー",
        "sub_title": "背中合わせの＜後編＞"
    },
    "entry":
    [
        { "location": "497/SCENARIO", "narrator": "", "text": "背中合わせの"},
        { "location": "516/TALK"    , "narrator": "アーヤ", "text": "私はずっと\nマイペースな姉に\n腹を立てていました。"},
        { "location": "517/TALK"    , "narrator": "アーヤ", "text": "つい人の望むことを\nしてしまう自分と比べて\n飄々としている姉。"},
        { "location": "518/TALK"    , "narrator": "アーヤ", "text": "自分の好きなことに\n全力投球して\n認めさせてしまう姉に。"},
        { "location": "520/TALK"    , "narrator": "アーヤ", "text": "…でも。"},
        { "location": "521/TALK"    , "narrator": "アーヤ", "text": "お互いどこか\nすれ違っていただけ\nなのかもしれないですね。"},
        { "location": "522/TALK"    , "narrator": "真幌", "text": "……。\nこれは口止め\nされていたんだが。"},
        { "location": "523/TALK"    , "narrator": "真幌", "text": "エリカはワルシャワの\n世界大会に行けなかった\nことを後悔していた。"},
        { "location": "524/TALK"    , "narrator": "真幌", "text": "引退試合になるなら\n仕事を全部投げ捨ても\n行くべきだったと。"},
        { "location": "526/TALK"    , "narrator": "アーヤ", "text": "……。\nたかが学生の試合です。"},
        { "location": "529/TALK"    , "narrator": "アーヤ", "text": "仕事の方が大事に\n決まってるじゃ\nないですか。"},
        { "location": "530/TALK"    , "narrator": "真幌", "text": "たかがじゃないだろう。\n大事な妹の晴れ舞台だ。"},
        { "location": "531/SEL"     , "narrator": "", "text": "そうだよ"},
        { "location": "532/SEL"     , "narrator": "", "text": "$me$も見たかったな"},
        { "location": "533/ACT"     , "narrator": "", "text": "そうだよ"},
        { "location": "550/TALK"    , "narrator": "アーヤ", "text": "昔の話よ"},
        { "location": "551/ACT"     , "narrator": "", "text": "$me$も見たかったな"},
        { "location": "568/TALK"    , "narrator": "アーヤ", "text": "もう無理だけど"},
        { "location": "580/TALK"    , "narrator": "アーヤ", "text": "それにわざわざ\n口止めする必要なんて。"},
        { "location": "581/TALK"    , "narrator": "真幌", "text": "アヤちゃんはきっと\nすごく悩んで引退を\n決めたんだと思う。"},
        { "location": "582/TALK"    , "narrator": "真幌", "text": "アヤちゃんの人生は\nアヤちゃんだけに\n決める権利がある。"},
        { "location": "583/TALK"    , "narrator": "真幌", "text": "だけど私はきっと\nアヤちゃんに聞いて\nしまうだろうから。"},
        { "location": "584/TALK"    , "narrator": "真幌", "text": "どうして辞めたの？\nなんで続けないの？\nって。"},
        { "location": "585/TALK"    , "narrator": "真幌", "text": "そしてアヤちゃんは\nその言葉をずっと\n気にするだろうから。"},
        { "location": "586/TALK"    , "narrator": "真幌", "text": "だから内緒ね。\n見に行きたかったことも\n見に行けなかったことも。"},
        { "location": "587/TALK"    , "narrator": "真幌", "text": "――だ、そうだ。"},
        { "location": "588/SEL"     , "narrator": "", "text": "いいお姉さんだね"},
        { "location": "589/SEL"     , "narrator": "", "text": "続けて欲しかったんだね"},
        { "location": "590/ACT"     , "narrator": "", "text": "いいお姉さんだね"},
        { "location": "591/ACT"     , "narrator": "", "text": "続けて欲しかったんだね"},
        { "location": "622/TALK"    , "narrator": "アーヤ", "text": "私はずっと自分自身に\n挑戦するために\n剣道をしていました。"},
        { "location": "623/TALK"    , "narrator": "アーヤ", "text": "そして世界選手権で\n優勝した時\n何かが切れたんです。"},
        { "location": "626/TALK"    , "narrator": "アーヤ", "text": "聞かれたら確かに\n困ったでしょうね。"},
        { "location": "627/TALK"    , "narrator": "アーヤ", "text": "続けるのが怖いから\nもう剣道を辞めるとしか\n言えなかったですから。"},
        { "location": "628/TALK"    , "narrator": "真幌", "text": "…エリカは答えが\n欲しかったわけじゃ\nないぞ。"},
        { "location": "630/TALK"    , "narrator": "アーヤ", "text": "……それも\nわかってます。"},
        { "location": "631/TALK"    , "narrator": "真幌", "text": "本当に似てるな。\nさすがは姉妹だ。"},
        { "location": "633/TALK"    , "narrator": "アーヤ", "text": "あまりそう\n言ってほしくは\nないですけど…。"},
        { "location": "634/TALK"    , "narrator": "真幌", "text": "あはは。\nそうだろうな。"},
        { "location": "637/TALK"    , "narrator": "アーヤ", "text": "館長…！"},
        { "location": "648/DIALOG"  , "narrator": "Dialog_chapter_ch02", "text": "【MV EXE_MiYABi】"}
    ]
}
