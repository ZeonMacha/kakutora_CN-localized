    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "ホームはスイートであるべきぞね"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "ホームはスイートであるべき"},
        { "location": "33/TALK"   , "narrator": "みやび", "text": "しかしこのスイートは"},
        { "location": "34/TALK"   , "narrator": "みやび", "text": "sweetではなくsuite"},
        { "location": "36/SEL"    , "narrator": "", "text": "ワンルームはダメなんだ"},
        { "location": "37/SEL"    , "narrator": "", "text": "御殿を建てよう！"},
        { "location": "38/SEL"    , "narrator": "", "text": "みやびと甘い夜を過ごしたいのに"},
        { "location": "39/ACT"    , "narrator": "", "text": "ワンルームはダメなんだ"},
        { "location": "40/TALK"   , "narrator": "みやび", "text": "一人暮らしなら"},
        { "location": "42/TALK"   , "narrator": "みやび", "text": "むしろありと思うぞね"},
        { "location": "43/ACT"    , "narrator": "", "text": "御殿を建てよう！"},
        { "location": "44/TALK"   , "narrator": "みやび", "text": "おお"},
        { "location": "45/TALK"   , "narrator": "みやび", "text": "それは無茶な"},
        { "location": "46/ACT"    , "narrator": "", "text": "みやびと甘い夜を過ごしたいのに"},
        { "location": "48/TALK"   , "narrator": "みやび", "text": "そういう意味ではないと"},
        { "location": "49/TALK"   , "narrator": "みやび", "text": "いっておるではないか"},
        { "location": "50/TALK"   , "narrator": "みやび", "text": "仕方ないの"},
        { "location": "52/TALK"   , "narrator": "みやび", "text": "まあ"},
        { "location": "53/TALK"   , "narrator": "みやび", "text": "みやびさん幼少のみぎりは"},
        { "location": "54/TALK"   , "narrator": "みやび", "text": "甘いだと信じていたがの"},
        { "location": "56/SEL"    , "narrator": "", "text": "スイートホームならそっちが正しいよ"},
        { "location": "57/SEL"    , "narrator": "", "text": "スイートルームと混同してる？"},
        { "location": "58/SEL"    , "narrator": "", "text": "ちょっと大人なみやびが見たい"},
        { "location": "59/ACT"    , "narrator": "", "text": "スイートホームならそっちが正しいよ"},
        { "location": "60/TALK"   , "narrator": "みやび", "text": "おお"},
        { "location": "62/TALK"   , "narrator": "みやび", "text": "そうであった"},
        { "location": "63/ACT"    , "narrator": "", "text": "スイートルームと混同してる？"},
        { "location": "64/TALK"   , "narrator": "みやび", "text": "む"},
        { "location": "65/TALK"   , "narrator": "みやび", "text": "しかし正論"},
        { "location": "66/ACT"    , "narrator": "", "text": "ちょっと大人なみやびが見たい"},
        { "location": "68/TALK"   , "narrator": "みやび", "text": "よしよし"},
        { "location": "69/TALK"   , "narrator": "みやび", "text": "ほーれほれほれほーれ"},
        { "location": "71/TALK"   , "narrator": "みやび", "text": "しかし現状は"},
        { "location": "72/TALK"   , "narrator": "みやび", "text": "寮住まい"},
        { "location": "73/TALK"   , "narrator": "みやび", "text": "まあ"},
        { "location": "74/TALK"   , "narrator": "みやび", "text": "それなりに満足はしておるよ"}
    ]
}
