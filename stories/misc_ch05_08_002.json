    "entry":
    [
        { "location": "1577/SCENARIO", "narrator": "", "text": "絶！対！領！域！！！"},
        { "location": "1602/TALK"    , "narrator": "神楽", "text": "この世で一番大事なものは"},
        { "location": "1603/TALK"    , "narrator": "神楽", "text": "絶対領域"},
        { "location": "1605/SEL"     , "narrator": "", "text": "同感だ"},
        { "location": "1606/SEL"     , "narrator": "", "text": "他に色々あると思う"},
        { "location": "1607/SEL"     , "narrator": "", "text": "神楽が一番大事"},
        { "location": "1608/ACT"     , "narrator": "", "text": "同感だ"},
        { "location": "1609/TALK"    , "narrator": "神楽", "text": "本気？"},
        { "location": "1610/ACT"     , "narrator": "", "text": "他に色々あると思う"},
        { "location": "1611/TALK"    , "narrator": "神楽", "text": "それはどうかなー"},
        { "location": "1612/TALK"    , "narrator": "神楽", "text": "ないと思うなー"},
        { "location": "1613/ACT"     , "narrator": "", "text": "神楽が一番大事"},
        { "location": "1615/TALK"    , "narrator": "神楽", "text": "えっ、、、"},
        { "location": "1616/TALK"    , "narrator": "神楽", "text": "ぴょんこ照れちゃいます、、、"},
        { "location": "1618/TALK"    , "narrator": "神楽", "text": "絶対領域はよいものだが"},
        { "location": "1619/TALK"    , "narrator": "神楽", "text": "領域自体より領域を分断する太ももに食い込み気味のソックスのライン"},
        { "location": "1620/TALK"    , "narrator": "神楽", "text": "あれこそが至高なわけで"},
        { "location": "1622/SEL"     , "narrator": "", "text": "ガチ勢の意見だ"},
        { "location": "1623/SEL"     , "narrator": "", "text": "あ、そうなんだ…"},
        { "location": "1624/SEL"     , "narrator": "", "text": "ヘドバン並みに全面同意！！！"},
        { "location": "1625/ACT"     , "narrator": "", "text": "ガチ勢の意見だ"},
        { "location": "1626/TALK"    , "narrator": "神楽", "text": "そうですが"},
        { "location": "1627/TALK"    , "narrator": "神楽", "text": "何か"},
        { "location": "1628/ACT"     , "narrator": "", "text": "あ、そうなんだ…"},
        { "location": "1629/TALK"    , "narrator": "神楽", "text": "あれ"},
        { "location": "1630/TALK"    , "narrator": "神楽", "text": "わからんちんだったか"},
        { "location": "1631/ACT"     , "narrator": "", "text": "ヘドバン並みに全面同意！！！"},
        { "location": "1633/TALK"    , "narrator": "神楽", "text": "だよねだよねだよね！！！"},
        { "location": "1635/TALK"    , "narrator": "神楽", "text": "あれがきちんと描写できてるか否かで絵は評価するし！！！"},
        { "location": "1636/TALK"    , "narrator": "神楽", "text": "あのもっちり感なくしてなんのための絶対領域かと！！！！"},
        { "location": "1638/TALK"    , "narrator": "神楽", "text": "あー理想の絶対領域を妄想しなきゃ、、、"},
        { "location": "1639/TALK"    , "narrator": "神楽", "text": "忙しいからまた後でね"},
        { "location": "1640/TALK"    , "narrator": "神楽", "text": "アデュー★"}
    ]
