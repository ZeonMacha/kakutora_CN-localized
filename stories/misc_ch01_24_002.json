        { "location": "93/SCENARIO", "narrator": "", "text": "035_チェリーのつぶやき"},
        { "location": "118/TALK"   , "narrator": "つばめ", "text": "バタバタしてて"},
        { "location": "119/TALK"   , "narrator": "つばめ", "text": "動けないんだょ"},
        { "location": "121/SEL"    , "narrator": "", "text": "そっか"},
        { "location": "122/SEL"    , "narrator": "", "text": "矛盾してない？"},
        { "location": "123/SEL"    , "narrator": "", "text": "思い詰めすぎないようにね"},
        { "location": "124/ACT"    , "narrator": "", "text": "そっか"},
        { "location": "125/TALK"   , "narrator": "つばめ", "text": "ぅん"},
        { "location": "126/TALK"   , "narrator": "つばめ", "text": "そぅなんだ"},
        { "location": "127/ACT"    , "narrator": "", "text": "矛盾してない？"},
        { "location": "128/TALK"   , "narrator": "つばめ", "text": "ぇ"},
        { "location": "129/TALK"   , "narrator": "つばめ", "text": "そぅかな"},
        { "location": "130/ACT"    , "narrator": "", "text": "思い詰めすぎないようにね"},
        { "location": "132/TALK"   , "narrator": "つばめ", "text": "ぅん"},
        { "location": "133/TALK"   , "narrator": "つばめ", "text": "ぁりがとぅ"},
        { "location": "134/TALK"   , "narrator": "つばめ", "text": "でもぁたし"},
        { "location": "136/TALK"   , "narrator": "つばめ", "text": "$handle1$がぃるから元気だょ"},
        { "location": "138/TALK"   , "narrator": "つばめ", "text": "こぅぃぅ時は"},
        { "location": "139/TALK"   , "narrator": "つばめ", "text": "魔法が使えればぃぃなって思っちゃぅ"},
        { "location": "141/SEL"    , "narrator": "", "text": "あるよね"},
        { "location": "142/SEL"    , "narrator": "", "text": "残念だけど無理だよ"},
        { "location": "143/SEL"    , "narrator": "", "text": "$me$は魔法にかかりっぱなしだよ"},
        { "location": "144/ACT"    , "narrator": "", "text": "あるよね"},
        { "location": "145/TALK"   , "narrator": "つばめ", "text": "だょね"},
        { "location": "146/TALK"   , "narrator": "つばめ", "text": "みんなそんな気持ちになることあるょね"},
        { "location": "147/ACT"    , "narrator": "", "text": "残念だけど無理だよ"},
        { "location": "149/TALK"   , "narrator": "つばめ", "text": "知ってるけど"},
        { "location": "151/TALK"   , "narrator": "つばめ", "text": "そんな気持ちなの"},
        { "location": "152/ACT"    , "narrator": "", "text": "$me$は魔法にかかりっぱなしだよ"},
        { "location": "154/TALK"   , "narrator": "つばめ", "text": "それは"},
        { "location": "155/TALK"   , "narrator": "つばめ", "text": "ぁたしのかけた魔法かな"},
        { "location": "156/TALK"   , "narrator": "つばめ", "text": "なんて"},
        { "location": "159/TALK"   , "narrator": "つばめ", "text": "頑張らなきゃね"}
    ]
}
