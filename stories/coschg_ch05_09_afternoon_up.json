        { "location": "811/TALK", "narrator": "プレイヤー", "text": "お着替えしてみよう"},
        { "location": "813/TALK", "narrator": "プレイヤー", "text": "違う服を着てほしいな"},
        { "location": "815/TALK", "narrator": "プレイヤー", "text": "よし、お着替えタイムだ！"},
        { "location": "821/TALK", "narrator": "プレイヤー", "text": "やあ"},
        { "location": "823/TALK", "narrator": "プレイヤー", "text": "こんにちは"},
        { "location": "825/TALK", "narrator": "プレイヤー", "text": "げんき？"},
        { "location": "828/TALK", "narrator": "神楽", "text": "ぴょんこを呼ぶ声"},
        { "location": "829/TALK", "narrator": "神楽", "text": "あなたはだあれ？"},
        { "location": "831/SEL" , "narrator": "", "text": "$handle$だよ"},
        { "location": "832/ACT" , "narrator": "", "text": "$handle$だよ"},
        { "location": "834/TALK", "narrator": "神楽", "text": "知ってるし"},
        { "location": "835/TALK", "narrator": "神楽", "text": "ぴょんこに用事ぴょん？"},
        { "location": "838/SEL" , "narrator": "", "text": "ちょっと着替えてほしいんだ"},
        { "location": "839/ACT" , "narrator": "", "text": "ちょっと着替えてほしいんだ"},
        { "location": "849/TALK", "narrator": "神楽", "text": "意味不明すぎ"},
        { "location": "850/TALK", "narrator": "神楽", "text": "でもまあ"},
        { "location": "851/TALK", "narrator": "神楽", "text": "優しいぴょんこは聞いてあげるのだった"},
        { "location": "853/TALK", "narrator": "神楽", "text": "は？"},
        { "location": "854/TALK", "narrator": "神楽", "text": "この服変だった？"},
        { "location": "855/TALK", "narrator": "神楽", "text": "なら着替えるけど"},
        { "location": "858/SEL" , "narrator": "", "text": "$me$が選ぶ"},
        { "location": "859/SEL" , "narrator": "", "text": "やっぱやめる"},
        { "location": "861/TALK", "narrator": "神楽", "text": "…………"},
        { "location": "864/TALK", "narrator": "神楽", "text": "リクエストないとか？"},
        { "location": "865/TALK", "narrator": "神楽", "text": "なら着ない"},
        { "location": "867/ACT" , "narrator": "", "text": "$me$が選ぶ"},
        { "location": "868/TALK", "narrator": "神楽", "text": "だと思った"},
        { "location": "869/TALK", "narrator": "神楽", "text": "どれを着てほしいと？"},
        { "location": "876/ACT" , "narrator": "", "text": "やっぱやめる"},
        { "location": "877/TALK", "narrator": "神楽", "text": "ありえネー"}
    ]
