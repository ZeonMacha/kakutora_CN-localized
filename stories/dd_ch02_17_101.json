{
    "dir": "chap17/daydra/dd_ch02_17_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "17202",
        "cid": "ayami",
        "title": "002 メインストーリー",
        "sub_title": "局所的先輩会議＜前編＞"
    },
    "entry":
    [
        { "location": "31/TALK"   , "narrator": "啓介", "text": "すまないね。\nわざわざホームまで\n見送ってもらって。"},
        { "location": "32/TALK"   , "narrator": "アーヤ", "text": "いえ…。"},
        { "location": "34/TALK"   , "narrator": "アーヤ", "text": "もしつばめさんの\nことで気になることが\nありましたら。"},
        { "location": "35/TALK"   , "narrator": "アーヤ", "text": "私か館長へ\n連絡をください。"},
        { "location": "36/TALK"   , "narrator": "アーヤ", "text": "できる限りの\nサポートはします\nから。"},
        { "location": "37/TALK"   , "narrator": "啓介", "text": "そうさせてもらおう。"},
        { "location": "39/TALK"   , "narrator": "啓介", "text": "…みやびさん。\n君も確か、つばめの\n先輩だったかな？"},
        { "location": "41/TALK"   , "narrator": "みやび", "text": "はい。\n一学年ですけんど。"},
        { "location": "42/TALK"   , "narrator": "啓介", "text": "そうか…。"},
        { "location": "44/TALK"   , "narrator": "みやび", "text": "…何か？"},
        { "location": "45/TALK"   , "narrator": "啓介", "text": "…君たち二人に、\n頼みがある。"},
        { "location": "47/TALK"   , "narrator": "啓介", "text": "あの子…\nつばめは……。"},
        { "location": "48/TALK"   , "narrator": "啓介", "text": "親の目から見ても、\nあまり、頼りになる子\nだとは思えない…。"},
        { "location": "49/TALK"   , "narrator": "啓介", "text": "掃除が大好きで、\n綺麗好きだから\n几帳面だと思ったら。"},
        { "location": "50/TALK"   , "narrator": "啓介", "text": "変なところで\n面倒くさがりな\n一面もあるしな。"},
        { "location": "52/TALK"   , "narrator": "アーヤ", "text": "…お父さんへの連絡を\nさぼってたのも、\nそれが理由でしたね。"},
        { "location": "53/TALK"   , "narrator": "啓介", "text": "うん。\n本当に困った子だ…。"},
        { "location": "55/TALK"   , "narrator": "啓介", "text": "…だがな、そんな\n困った子でも\n自慢の娘だ。"},
        { "location": "56/TALK"   , "narrator": "啓介", "text": "私が一生懸命育て、\nこの年まで\n愛してきた。"},
        { "location": "57/TALK"   , "narrator": "啓介", "text": "見所があるなら\n存分にこき使って\nやってくれ。"},
        { "location": "58/TALK"   , "narrator": "啓介", "text": "……。"},
        { "location": "60/TALK"   , "narrator": "啓介", "text": "二人とも。\nどうかつばめのこと、\nよろしく頼みます。"},
        { "location": "63/TALK"   , "narrator": "アーヤ", "text": "…わかりました。"},
        { "location": "64/TALK"   , "narrator": "みやび", "text": "つばめさんのことは、\nうちらがしっかりと\n守ります。"},
        { "location": "85/TALK"   , "narrator": "みやび", "text": "しっかし、まさか\nつばめちゃんの\nお父さんがねえ。"},
        { "location": "86/TALK"   , "narrator": "みやび", "text": "お忍びで\n来ちょったかね。"},
        { "location": "88/TALK"   , "narrator": "アーヤ", "text": "こっちは大変だったん\nだから…。"},
        { "location": "89/TALK"   , "narrator": "アーヤ", "text": "…っていうか、\nどうしてみやびまで\n見送りに来たの？"},
        { "location": "90/TALK"   , "narrator": "みやび", "text": "ん？　まあ、たまには\nこういうのもえいかと\n思うてな…。"},
        { "location": "91/TALK"   , "narrator": "アーヤ", "text": "…………。"},
        { "location": "92/TALK"   , "narrator": "みやび", "text": "…冗談や。"},
        { "location": "93/TALK"   , "narrator": "みやび", "text": "実は\nちっくと話しにくい\n話があってねえ。"},
        { "location": "94/TALK"   , "narrator": "アーヤ", "text": "…他のみんなには\n聞かれたらマズい\nことなの？"},
        { "location": "95/TALK"   , "narrator": "みやび", "text": "…アーヤなら\n信頼できる思うて\n話すことやきね。"},
        { "location": "96/TALK"   , "narrator": "みやび", "text": "他のみんなには\n言わんと約束して\nもらえるか？"},
        { "location": "97/TALK"   , "narrator": "アーヤ", "text": "…………。\nええ。約束するわ。"},
        { "location": "98/TALK"   , "narrator": "みやび", "text": "実はな…フェノメノンに\n関する秘密情報を\n手に入れたんよ。"},
        { "location": "99/TALK"   , "narrator": "みやび", "text": "聞かれる前に言うておく\nけんど…見つけたんは、\n管理庁のサーバー内や。"},
        { "location": "100/TALK"  , "narrator": "アーヤ", "text": "…秘密情報？\nなんで管理庁のサーバーに\nそんなものがあるの？"},
        { "location": "101/TALK"  , "narrator": "みやび", "text": "それはうちにもわからん。"},
        { "location": "102/TALK"  , "narrator": "みやび", "text": "ただ、かなりヤバいもん\nっちゅうことは確かや。"},
        { "location": "103/TALK"  , "narrator": "アーヤ", "text": "…何がわかったの？"},
        { "location": "105/TALK"  , "narrator": "みやび", "text": "…フェノメノンが、\n人為的に起こされちょる\n可能性。"},
        { "location": "106/TALK"  , "narrator": "みやび", "text": "それに関する資料が、\n大量に出てきたがよ。"},
        { "location": "109/TALK"  , "narrator": "アーヤ", "text": "…は！？"},
        { "location": "110/TALK"  , "narrator": "みやび", "text": "やっぱ驚くかぁ…。\nうちも、最初はフェイク\nかと思うたし…。"},
        { "location": "112/TALK"  , "narrator": "アーヤ", "text": "いや、フェイクでしょ？\nあれが人為的に起こせる\nはずないわ。"},
        { "location": "114/TALK"  , "narrator": "みやび", "text": "いや、そうとは\n言い切れんやろ？"},
        { "location": "115/TALK"  , "narrator": "みやび", "text": "実際、フェノメノンに\nついてわかっちゅうことは\n少ないんやし。"},
        { "location": "116/TALK"  , "narrator": "アーヤ", "text": "そうだけど…、でも、\nあれが人為的に起こせる\nものなの？"},
        { "location": "118/TALK"  , "narrator": "みやび", "text": "…わからん。"},
        { "location": "120/TALK"  , "narrator": "みやび", "text": "けんど、これがフェイク\nっちゅう可能性は、\nかなり低いと思うがよ。"},
        { "location": "121/TALK"  , "narrator": "みやび", "text": "普通、ウソならもう少し\n常識的な内容の物を\n作ると思わん？"},
        { "location": "122/TALK"  , "narrator": "みやび", "text": "これは本物や、と相手が\n思わんフェイクなんぞ、\n意味がないやろ。"},
        { "location": "124/TALK"  , "narrator": "アーヤ", "text": "…確かに。"},
        { "location": "125/TALK"  , "narrator": "みやび", "text": "それに、フェノメノンとは\n関係ない重要なデータも、\nごっそり見つかったちや。"},
        { "location": "126/TALK"  , "narrator": "みやび", "text": "そんなデータの中に、\n一つだけフェイク入れても\n仕方ないやろ？"},
        { "location": "128/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "129/TALK"  , "narrator": "みやび", "text": "すまん…こんなこと\n相談されても、\nアーヤも困るやろ？"},
        { "location": "130/TALK"  , "narrator": "みやび", "text": "けんど、うち一人の\nキャパやと対処しきれん\nがよ。"},
        { "location": "131/TALK"  , "narrator": "みやび", "text": "まほさんに相談するんは、\nちくっと怖いし…。"},
        { "location": "133/TALK"  , "narrator": "アーヤ", "text": "…ううん、構わない。"},
        { "location": "134/TALK"  , "narrator": "アーヤ", "text": "一人で抱えられるような\n話じゃないんだし、\n頼ってくれて嬉しいわ。"},
        { "location": "136/TALK"  , "narrator": "みやび", "text": "すまん…。"},
        { "location": "137/TALK"  , "narrator": "アーヤ", "text": "…とは言ったものの、\nどうすればいいのかしら？"},
        { "location": "139/TALK"  , "narrator": "アーヤ", "text": "この問題は、明らかに\n私の力でどうにかできる\n話じゃないわ…。"},
        { "location": "141/TALK"  , "narrator": "アーヤ", "text": "…でも、頼ってくれてる\nみやびを突き放すなんて\nできない。"},
        { "location": "142/TALK"  , "narrator": "アーヤ", "text": "…どうしよう。"},
        { "location": "198/SEL"   , "narrator": "", "text": "おーい"},
        { "location": "199/ACT"   , "narrator": "", "text": "おーい"},
        { "location": "202/SEL"   , "narrator": "", "text": "適当に操作してみる"},
        { "location": "203/ACT"   , "narrator": "", "text": "適当に操作してみる"},
        { "location": "206/SEL"   , "narrator": "", "text": "EXEC_STATUSDUMP/."},
        { "location": "207/SEL"   , "narrator": "", "text": "EXEC_SEEK_SECTOR/."},
        { "location": "208/SEL"   , "narrator": "", "text": "EXEC_SUSPEND/."},
        { "location": "217/SEL"   , "narrator": "", "text": "Type::EternalDreaming"},
        { "location": "218/SEL"   , "narrator": "", "text": "Type::KokoroError"},
        { "location": "219/SEL"   , "narrator": "", "text": "Type::Secret"},
        { "location": "220/SEL"   , "narrator": "", "text": "Type::"},
        { "location": "258/TALK"  , "narrator": "アーヤ", "text": "ふふ。\nこの衣装最高ね♪"},
        { "location": "259/TALK"  , "narrator": "アーヤ", "text": "カッコ良くて可愛くて――"},
        { "location": "261/TALK"  , "narrator": "アーヤ", "text": "ちょっとだけ\n色っぽいところが素敵。"},
        { "location": "262/TALK"  , "narrator": "アーヤ", "text": "谷間見えちゃってるし。\n寄せてるから尚更……。"},
        { "location": "264/TALK"  , "narrator": "アーヤ", "text": "それにしても、卯月が\nこんな衣装を着て舞台に\n出ていたなんて……。"},
        { "location": "265/TALK"  , "narrator": "アーヤ", "text": "にわかに信じられないけど\nでも気持ちはわかるわよ？\nふふ♪"},
        { "location": "266/SEL"   , "narrator": "", "text": "２人とも目立ちたがり屋だもんね"},
        { "location": "267/SEL"   , "narrator": "", "text": "２人とも露出癖があるんだね"},
        { "location": "268/SEL"   , "narrator": "", "text": "２人とも御伽の国大好きだもんね"},
        { "location": "269/ACT"   , "narrator": "", "text": "２人とも目立ちたがり屋だもんね"},
        { "location": "270/TALK"  , "narrator": "アーヤ", "text": "確かにそうねぇ――"},
        { "location": "271/ACT"   , "narrator": "", "text": "２人とも露出癖があるんだね"},
        { "location": "272/TALK"  , "narrator": "アーヤ", "text": "ふふ、バレちゃっ――"},
        { "location": "273/ACT"   , "narrator": "", "text": "２人とも御伽の国大好きだもんね"},
        { "location": "274/TALK"  , "narrator": "アーヤ", "text": "そうなのよね～。\nお姫様みたいな格好って\n憧れ――"},
        { "location": "276/TALK"  , "narrator": "アーヤ", "text": "って、ええええっ！？"},
        { "location": "277/TALK"  , "narrator": "アーヤ", "text": "ちょ、ちょっと！\nなんで貴方が\nこんなところにいるの！"},
        { "location": "278/TALK"  , "narrator": "アーヤ", "text": "即刻出ていって！！"},
        { "location": "365/TALK"  , "narrator": "アーヤ", "text": "はぁ……。"},
        { "location": "366/TALK"  , "narrator": "アーヤ", "text": "ほんと、いつになったら\n来るのかしらね。"},
        { "location": "367/TALK"  , "narrator": "アーヤ", "text": "……私の白馬の王子様は。"},
        { "location": "368/TALK"  , "narrator": "アーヤ", "text": "もちろん、自分から\nアタックしなくちゃ\nいけないのはわかるけど。"},
        { "location": "369/TALK"  , "narrator": "アーヤ", "text": "でも、\nそんなことして\n拒否られちゃったら……。"},
        { "location": "370/TALK"  , "narrator": "アーヤ", "text": "私のドラマが\n台無しになっちゃう。\nそれはいやなの。"},
        { "location": "371/SEL"   , "narrator": "", "text": "ごめんなさいされるのが怖いの？"},
        { "location": "372/SEL"   , "narrator": "", "text": "アーヤにも恋人願望あったんだね"},
        { "location": "373/ACT"   , "narrator": "", "text": "ごめんなさいされるのが怖いの？"},
        { "location": "374/TALK"  , "narrator": "アーヤ", "text": "そりゃそうよ。"},
        { "location": "375/ACT"   , "narrator": "", "text": "アーヤにも恋人願望あったんだね"},
        { "location": "376/TALK"  , "narrator": "アーヤ", "text": "あたりまえでしょ？"},
        { "location": "379/TALK"  , "narrator": "アーヤ", "text": "――って！\nなんで貴方がここに！？"},
        { "location": "380/SEL"   , "narrator": "", "text": "相談にのるよ"},
        { "location": "381/SEL"   , "narrator": "", "text": "ごめんなさい、すぐ退散します"},
        { "location": "382/ACT"   , "narrator": "", "text": "相談にのるよ"},
        { "location": "383/TALK"  , "narrator": "アーヤ", "text": "そ、そうなの？"},
        { "location": "384/TALK"  , "narrator": "アーヤ", "text": "それじゃ相談するけど、\n私、一生独身なんじゃ\nないかってビビってるの。"},
        { "location": "385/TALK"  , "narrator": "アーヤ", "text": "もちろん、いい人が\nできて、お付き合いして\n素敵だったら――"},
        { "location": "386/TALK"  , "narrator": "アーヤ", "text": "け…結婚だって\nしたいと思ってるわ。"},
        { "location": "387/TALK"  , "narrator": "アーヤ", "text": "でも、なんだかいつも\n慎重になっちゃって……"},
        { "location": "388/TALK"  , "narrator": "アーヤ", "text": "石橋を叩いてるうちに\n相手の人が音を上げそうで\n怖いの。"},
        { "location": "389/SEL"   , "narrator": "", "text": "結婚は勢いだ！"},
        { "location": "390/SEL"   , "narrator": "", "text": "$me$はいつまでも待ってるよ"},
        { "location": "391/ACT"   , "narrator": "", "text": "結婚は勢いだ！"},
        { "location": "392/TALK"  , "narrator": "アーヤ", "text": "そ、そうなの？\nでも、自分の一生を決める\nオオゴトなのよ？"},
        { "location": "393/TALK"  , "narrator": "アーヤ", "text": "勢いで決めたら、その事で\n絶対後悔しそう。"},
        { "location": "394/TALK"  , "narrator": "アーヤ", "text": "もちろん、慎重に決めても\n後悔しちゃうことは\nあるかもしれないけど……"},
        { "location": "395/TALK"  , "narrator": "アーヤ", "text": "でも、勢いで決めたら\nそれが原因だって\n自分を責めちゃうから。"},
        { "location": "396/SEL"   , "narrator": "", "text": "それわかる！"},
        { "location": "397/SEL"   , "narrator": "", "text": "アーヤは真面目さんだね"},
        { "location": "398/ACT"   , "narrator": "", "text": "それわかる！"},
        { "location": "399/TALK"  , "narrator": "アーヤ", "text": "わかってくれる？\n嬉しい。"},
        { "location": "400/TALK"  , "narrator": "アーヤ", "text": "貴方にそう言って\nもらえると、少しだけ\n安心できるわ。"},
        { "location": "401/TALK"  , "narrator": "アーヤ", "text": "もし貴方が、私と生涯を\n共にする可能性がある\n人なら――"},
        { "location": "402/TALK"  , "narrator": "アーヤ", "text": "私の事、色々理解して\nくれそうな気がしてる。"},
        { "location": "403/TALK"  , "narrator": "アーヤ", "text": "多分、そういう安心感が\n欲しいのかもしれない。"},
        { "location": "404/ACT"   , "narrator": "", "text": "アーヤは真面目さんだね"},
        { "location": "405/TALK"  , "narrator": "アーヤ", "text": "みんなそう言うわね。"},
        { "location": "406/TALK"  , "narrator": "アーヤ", "text": "でもありがと。\n相談に乗ってくれて。"},
        { "location": "408/ACT"   , "narrator": "", "text": "$me$はいつまでも待ってるよ"},
        { "location": "409/TALK"  , "narrator": "アーヤ", "text": "ふふ、ありがと。\nでも、きっと待ちくたびれ\nちゃうわよ？"},
        { "location": "410/TALK"  , "narrator": "アーヤ", "text": "私ほんとに、\n石橋を壊す勢いで\n慎重だから。"},
        { "location": "411/TALK"  , "narrator": "アーヤ", "text": "それでも、そう言って\nくれる人がいるのって\n幸せなのかもしれない。"},
        { "location": "412/TALK"  , "narrator": "アーヤ", "text": "だって今、少しだけ\n安心できたから。"},
        { "location": "413/TALK"  , "narrator": "アーヤ", "text": "もし貴方が私の伴侶に\nなれるような存在なら――"},
        { "location": "414/TALK"  , "narrator": "アーヤ", "text": "一度おつきあいして\n見たいかも。ふふ。"},
        { "location": "416/TALK"  , "narrator": "アーヤ", "text": "だいぶココロの整理が\nできたから、後は自分で\n考えてみるわね。"},
        { "location": "417/TALK"  , "narrator": "アーヤ", "text": "貴方がここに来たこと、\n本当はルール違反だけど\n秘密にしておいてあげる。"},
        { "location": "418/TALK"  , "narrator": "アーヤ", "text": "私と$handle$の\n２人だけの秘密、ね？"},
        { "location": "419/TALK"  , "narrator": "アーヤ", "text": "それじゃね♪"},
        { "location": "420/ACT"   , "narrator": "", "text": "ごめんなさい、すぐ退散します"},
        { "location": "421/TALK"  , "narrator": "アーヤ", "text": "え？\nそうなの！？"},
        { "location": "422/TALK"  , "narrator": "アーヤ", "text": "わかったわ……。\nそれじゃね。"},
        { "location": "500/SEL"   , "narrator": "", "text": "はい"},
        { "location": "501/SEL"   , "narrator": "", "text": "いいえ"},
        { "location": "502/ACT"   , "narrator": "", "text": "はい"},
        { "location": "510/ACT"   , "narrator": "", "text": "いいえ"},
        { "location": "30/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>7月25日　16:12 PM</color>\nフェノメノン戦終了の翌日。東京駅にて。"},
        { "location": "155/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "157/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "159/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
