    "entry":
    [
        { "location": "307/SCENARIO", "narrator": "", "text": "クラスの実態"},
        { "location": "331/TALK"    , "narrator": "プレイヤー", "text": "そんなに怒らないで"},
        { "location": "332/TALK"    , "narrator": "ガブリエラ", "text": "私のせいじゃないわ"},
        { "location": "333/TALK"    , "narrator": "ガブリエラ", "text": "新人が天然過ぎるのがいけないのよ"},
        { "location": "334/TALK"    , "narrator": "プレイヤー", "text": "天然だから許してあげて"},
        { "location": "335/TALK"    , "narrator": "ガブリエラ", "text": "違うわ"},
        { "location": "336/TALK"    , "narrator": "ガブリエラ", "text": "違うのよ、マルザンナ"},
        { "location": "337/TALK"    , "narrator": "ガブリエラ", "text": "そういうことじゃないのよ"},
        { "location": "341/SEL"     , "narrator": "", "text": "つばめは寧ろ癒しだよね"},
        { "location": "342/SEL"     , "narrator": "", "text": "迷惑なら追い払おうよ"},
        { "location": "343/SEL"     , "narrator": "", "text": "一人になりたい時もあるよね"},
        { "location": "344/ACT"     , "narrator": "", "text": "つばめは寧ろ癒しだよね"},
        { "location": "345/TALK"    , "narrator": "ガブリエラ", "text": "まあ、そうだけど"},
        { "location": "347/TALK"    , "narrator": "ガブリエラ", "text": "今の間違い！"},
        { "location": "349/TALK"    , "narrator": "ガブリエラ", "text": "前言撤回よ！"},
        { "location": "350/TALK"    , "narrator": "ガブリエラ", "text": "新人が癒しなはずないじゃない！"},
        { "location": "351/TALK"    , "narrator": "ガブリエラ", "text": "迷惑なだけよ！"},
        { "location": "353/SEL"     , "narrator": "", "text": "じゃあ追い払えば？"},
        { "location": "354/ACT"     , "narrator": "", "text": "じゃあ追い払えば？"},
        { "location": "357/TALK"    , "narrator": "ガブリエラ", "text": "ちょっと待って"},
        { "location": "358/TALK"    , "narrator": "ガブリエラ", "text": "確かに、新人は迷惑でしかないわ"},
        { "location": "359/TALK"    , "narrator": "ガブリエラ", "text": "けど、追い払うほどってわけでもないし"},
        { "location": "361/SEL"     , "narrator": "", "text": "$me$が代わりに言おう"},
        { "location": "362/ACT"     , "narrator": "", "text": "$me$が代わりに言おう"},
        { "location": "365/TALK"    , "narrator": "ガブリエラ", "text": "やめて！！"},
        { "location": "367/TALK"    , "narrator": "ガブリエラ", "text": "わかった、正直に言うわよ！"},
        { "location": "368/TALK"    , "narrator": "ガブリエラ", "text": "つばめは"},
        { "location": "370/TALK"    , "narrator": "ガブリエラ", "text": "認めたくないけど、私のことを癒してくれてるわ"},
        { "location": "372/TALK"    , "narrator": "ガブリエラ", "text": "ちょっとだけね"},
        { "location": "373/TALK"    , "narrator": "ガブリエラ", "text": "本当にちょっとよ！？"},
        { "location": "375/SEL"     , "narrator": "", "text": "それを聞けて安心した"},
        { "location": "376/ACT"     , "narrator": "", "text": "それを聞けて安心した"},
        { "location": "378/TALK"    , "narrator": "ガブリエラ", "text": "ここだけの話よ？"},
        { "location": "379/TALK"    , "narrator": "ガブリエラ", "text": "今の、他の人に喋ったりしたら"},
        { "location": "380/TALK"    , "narrator": "ガブリエラ", "text": "マルザンナでも許さないから！"},
        { "location": "381/ACT"     , "narrator": "", "text": "迷惑なら追い払おうよ"},
        { "location": "382/TALK"    , "narrator": "ガブリエラ", "text": "ちょっと待って"},
        { "location": "383/TALK"    , "narrator": "ガブリエラ", "text": "確かに、新人は迷惑でしかないわ"},
        { "location": "384/TALK"    , "narrator": "ガブリエラ", "text": "けど、追い払うほどってわけでもないし"},
        { "location": "386/SEL"     , "narrator": "", "text": "やっぱり、つばめは癒しなんだね"},
        { "location": "387/ACT"     , "narrator": "", "text": "やっぱり、つばめは癒しなんだね"},
        { "location": "389/TALK"    , "narrator": "ガブリエラ", "text": "どうしてそうなるのよ！？"},
        { "location": "391/TALK"    , "narrator": "ガブリエラ", "text": "確かに、そんなに迷惑とは思ってないけど"},
        { "location": "392/TALK"    , "narrator": "ガブリエラ", "text": "癒しだなんて思ってないわ！"},
        { "location": "394/SEL"     , "narrator": "", "text": "じゃあ、つばめは迷惑だ、って$me$から言う"},
        { "location": "395/ACT"     , "narrator": "", "text": "じゃあ、つばめは迷惑だ、って$me$から言う"},
        { "location": "398/ACT"     , "narrator": "", "text": "一人になりたい時もあるよね"},
        { "location": "399/TALK"    , "narrator": "ガブリエラ", "text": "そう"},
        { "location": "400/TALK"    , "narrator": "ガブリエラ", "text": "そうなのよ"},
        { "location": "401/TALK"    , "narrator": "ガブリエラ", "text": "わかってもらえて嬉しいわ"},
        { "location": "402/TALK"    , "narrator": "ガブリエラ", "text": "だから、別につばめがどうのこうのいう話じゃないのよ"},
        { "location": "405/SEL"     , "narrator": "", "text": "寧ろつばめは癒しだもんね"},
        { "location": "406/ACT"     , "narrator": "", "text": "寧ろつばめは癒しだもんね"},
        { "location": "408/TALK"    , "narrator": "ガブリエラ", "text": "ちょっと待って！"},
        { "location": "410/TALK"    , "narrator": "ガブリエラ", "text": "別に、癒しだとは言ってないわ"},
        { "location": "411/TALK"    , "narrator": "ガブリエラ", "text": "寧ろ、迷惑に思ってるくらいなんだから"},
        { "location": "413/SEL"     , "narrator": "", "text": "そんなに迷惑なら僕から伝えよう"},
        { "location": "414/ACT"     , "narrator": "", "text": "そんなに迷惑なら僕から伝えよう"},
        { "location": "420/TALK"    , "narrator": "ガブリエラ", "text": "…本当、バラしたら\n絶対許さないん\nだから！"},
        { "location": "424/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "427/TALK"    , "narrator": "つばめ", "text": "気のせぃかな？"},
        { "location": "428/TALK"    , "narrator": "つばめ", "text": "ガブちゃん"},
        { "location": "429/TALK"    , "narrator": "つばめ", "text": "ちょっと変だよね？(´･ω･｀) "},
        { "location": "432/SEL"     , "narrator": "", "text": "変だね"},
        { "location": "433/SEL"     , "narrator": "", "text": "恋だね"},
        { "location": "434/ACT"     , "narrator": "", "text": "変だね"},
        { "location": "435/TALK"    , "narrator": "つばめ", "text": "やっぱりそぅ思ぅ？"},
        { "location": "436/TALK"    , "narrator": "つばめ", "text": "何か"},
        { "location": "437/TALK"    , "narrator": "つばめ", "text": "悩みでもぁるのかな？(´ｪ｀；)三(；´ｪ｀)"},
        { "location": "438/ACT"     , "narrator": "", "text": "恋だね"},
        { "location": "439/TALK"    , "narrator": "つばめ", "text": "ぇっ！？(･Д･｀)"},
        { "location": "441/TALK"    , "narrator": "つばめ", "text": "それはなぃと思ぅなぁ"},
        { "location": "442/TALK"    , "narrator": "つばめ", "text": "だって"},
        { "location": "443/TALK"    , "narrator": "つばめ", "text": "男の人と話してるの"},
        { "location": "444/TALK"    , "narrator": "つばめ", "text": "見たことなぃし(・ω・`)"},
        { "location": "445/TALK"    , "narrator": "つばめ", "text": "もしかして"},
        { "location": "446/TALK"    , "narrator": "つばめ", "text": "『変』"},
        { "location": "447/TALK"    , "narrator": "つばめ", "text": "って漢字と間違ぇた？(≧艸≦*)"},
        { "location": "449/SEL"     , "narrator": "", "text": "変換でそれはないだろ"},
        { "location": "450/ACT"     , "narrator": "", "text": "変換でそれはないだろ"},
        { "location": "452/TALK"    , "narrator": "つばめ", "text": "ぁ"},
        { "location": "453/TALK"    , "narrator": "つばめ", "text": "そぅだよね_(┐「ε:)_"},
        { "location": "455/TALK"    , "narrator": "つばめ", "text": "でも"},
        { "location": "456/TALK"    , "narrator": "つばめ", "text": "恋じゃなぃと思ぅ(･Д･｀)"},
        { "location": "457/TALK"    , "narrator": "つばめ", "text": "でも"},
        { "location": "458/TALK"    , "narrator": "つばめ", "text": "変なのは確かだよo(*･ﾛ･*)o、"},
        { "location": "461/SEL"     , "narrator": "", "text": "友達がいなくて寂しいのかも"},
        { "location": "462/ACT"     , "narrator": "", "text": "友達がいなくて寂しいのかも"},
        { "location": "463/TALK"    , "narrator": "つばめ", "text": "そぅぃぇば"},
        { "location": "464/TALK"    , "narrator": "つばめ", "text": "誰とも話してなかったよね？(´･ω･｀) "},
        { "location": "465/TALK"    , "narrator": "つばめ", "text": "教室にぃた時"},
        { "location": "466/TALK"    , "narrator": "つばめ", "text": "きっとそぅかも！o(*･ﾛ･*)o、"},
        { "location": "467/TALK"    , "narrator": "つばめ", "text": "ぁりがと(*´︶`*)"},
        { "location": "473/TALK"    , "narrator": "つばめ", "text": "…せんぱい、劇場に\n行く前に、カフェに\n寄りませんか？"},
        { "location": "476/TALK"    , "narrator": "ガブリエラ", "text": "なんであんたと？"},
        { "location": "477/TALK"    , "narrator": "つばめ", "text": "あ、あの、わたし、\nせんぱいとお友達に\nなりたくて…。"},
        { "location": "480/TALK"    , "narrator": "ガブリエラ", "text": "は、はあ！？\nあんた、さっきから\n何なのよ？"},
        { "location": "481/TALK"    , "narrator": "ガブリエラ", "text": "突拍子もないこと\nばっかり言って…。\nバカにしてるわけ？"},
        { "location": "482/TALK"    , "narrator": "つばめ", "text": "違います！\nわたし、本気です。"},
        { "location": "483/TALK"    , "narrator": "つばめ", "text": "本当にせんぱいと、\n友達になりたいと\n思ってるんです！"},
        { "location": "486/TALK"    , "narrator": "ガブリエラ", "text": "………………。"},
        { "location": "490/TALK"    , "narrator": "ガブリエラ", "text": "…いや、ないから。\n却下よ、却下。"},
        { "location": "491/TALK"    , "narrator": "ガブリエラ", "text": "あたしとあんたが\n友達なんて、絶対に\nありえないから。"},
        { "location": "494/TALK"    , "narrator": "ガブリエラ", "text": "だいたいあんた、\nもうクラスに沢山\n友達いたじゃない。"},
        { "location": "497/TALK"    , "narrator": "ガブリエラ", "text": "ってか、友達作りに\n励んでる場合じゃない\nと思うんだけど？"},
        { "location": "498/TALK"    , "narrator": "ガブリエラ", "text": "殆ど役に立ってないん\nだから、訓練の一つ\nでもしたらどうなの。"},
        { "location": "500/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "503/TALK"    , "narrator": "ガブリエラ", "text": "……なんて。\nちょっと先輩面\nしすぎたかしらね。"},
        { "location": "504/TALK"    , "narrator": "ガブリエラ", "text": "でも、友達になろう\nなんて言われたの、\n今回が初めてかも…。"},
        { "location": "507/TALK"    , "narrator": "ガブリエラ", "text": "ちょっとうれ……\n……っていうか\n悪くない感じだわ。"},
        { "location": "511/TALK"    , "narrator": "つばめ", "text": "…そう、ですね。"},
        { "location": "518/TALK"    , "narrator": "ガブリエラ", "text": "えっ？"},
        { "location": "520/TALK"    , "narrator": "つばめ", "text": "わたし、また変なこと\n言って、せんぱいを\n困らせちゃいました。"},
        { "location": "524/TALK"    , "narrator": "つばめ", "text": "せんぱいの気持ちも\n知らないで、変なこと\n言ってごめんなさい。"},
        { "location": "531/TALK"    , "narrator": "ガブリエラ", "text": "ちょ、ちょっと、\n新人！？"},
        { "location": "533/TALK"    , "narrator": "つばめ", "text": "……。"},
        { "location": "534/TALK"    , "narrator": "ガブリエラ", "text": "ちょま、待ちなさい！\nこんなところで\nなにやって――っ！"},
        { "location": "535/TALK"    , "narrator": "女子高校生Ａ", "text": "うわぁ…やっぱり\nガブリエラちゃん\nって、凄いわー。"},
        { "location": "536/TALK"    , "narrator": "女子高校生Ｂ", "text": "高等部の先輩に\n頭下げさせてるよ。"},
        { "location": "537/TALK"    , "narrator": "女子高校生Ｂ", "text": "ヨーロッパの子って、\nみんなあんな感じで\n気が強いのかな。"},
        { "location": "538/TALK"    , "narrator": "女子高校生Ａ", "text": "てか、見て見て！\nあの先輩、ちょっと\n涙目じゃない！？"},
        { "location": "540/TALK"    , "narrator": "ガブリエラ", "text": "ぐっ…。"},
        { "location": "542/TALK"    , "narrator": "ガブリエラ", "text": "ああっ、\nあたしのバカバカ！"},
        { "location": "543/TALK"    , "narrator": "ガブリエラ", "text": "つばめが純粋すぎる\nのなんて、わかってた\nはずなのにっ！"},
        { "location": "545/TALK"    , "narrator": "ガブリエラ", "text": "ちょ……\nちょっと、新人？"},
        { "location": "546/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "548/TALK"    , "narrator": "ガブリエラ", "text": "……はぁ。\n何でこんな事に……。"},
        { "location": "550/TALK"    , "narrator": "ガブリエラ", "text": "…ほ、ほら！　もう\n頭上げなさいって。"},
        { "location": "551/TALK"    , "narrator": "ガブリエラ", "text": "もう怒ってないから、\nね、新人…つばめ？\nつばめさーん？"},
        { "location": "553/TALK"    , "narrator": "つばめ", "text": "はい……。"},
        { "location": "555/TALK"    , "narrator": "ガブリエラ", "text": "ああもう！"},
        { "location": "556/TALK"    , "narrator": "ガブリエラ", "text": "怒ってないって\n言ってるんだから、\nしゃんとしなさい！"},
        { "location": "558/TALK"    , "narrator": "つばめ", "text": "は、はい！\nガブリエラせんぱい！\nごめんなさい！"},
        { "location": "559/TALK"    , "narrator": "ガブリエラ", "text": "だから、せんぱいも\nここでは禁止よ！"},
        { "location": "560/TALK"    , "narrator": "つばめ", "text": "はい、せんぱい！"},
        { "location": "561/TALK"    , "narrator": "つばめ", "text": "あっ！！"},
        { "location": "563/TALK"    , "narrator": "ガブリエラ", "text": "ダメだこりゃ……。"},
        { "location": "575/DIALOG"  , "narrator": "Dialog_chapter_ch03", "text": "【07 愛，ロボット】"}
    ]
}
