    "entry":
    [
        { "location": "6014/SCENARIO", "narrator": "", "text": "保健室と眼鏡さん"},
        { "location": "6039/TALK"    , "narrator": "神楽", "text": "保健室って何のためにあるのかな？"},
        { "location": "6041/SEL"     , "narrator": "", "text": "具合の悪い生徒とかのためでしょ？"},
        { "location": "6042/SEL"     , "narrator": "", "text": "神楽の妄想を育てるためだよ"},
        { "location": "6043/SEL"     , "narrator": "", "text": "確かにめったに行かないよね～"},
        { "location": "6044/ACT"     , "narrator": "", "text": "具合の悪い生徒とかのためでしょ？"},
        { "location": "6045/TALK"    , "narrator": "神楽", "text": "それ正解"},
        { "location": "6046/TALK"    , "narrator": "神楽", "text": "でもそんな答えじゃなー"},
        { "location": "6047/ACT"     , "narrator": "", "text": "神楽の妄想を育てるためだよ"},
        { "location": "6049/TALK"    , "narrator": "神楽", "text": "ぐふふ♪"},
        { "location": "6050/TALK"    , "narrator": "神楽", "text": "いいのいいのそれでいいの？"},
        { "location": "6051/TALK"    , "narrator": "神楽", "text": "封印されしぴょんこの妄想を解放するよ！？"},
        { "location": "6052/ACT"     , "narrator": "", "text": "確かにめったに行かないよね～"},
        { "location": "6053/TALK"    , "narrator": "神楽", "text": "$handlek$は健康優良児ダナー"},
        { "location": "6055/TALK"    , "narrator": "神楽", "text": "なんかさー"},
        { "location": "6056/TALK"    , "narrator": "神楽", "text": "漫画とかだと保健の先生って男の人だったりすることあるじゃないですかー"},
        { "location": "6057/TALK"    , "narrator": "神楽", "text": "あれって実在するのかな？"},
        { "location": "6059/SEL"     , "narrator": "", "text": "四万人中二桁らしいよ"},
        { "location": "6060/SEL"     , "narrator": "", "text": "都市伝説だよね"},
        { "location": "6061/SEL"     , "narrator": "", "text": "神楽のためならどうにかして…"},
        { "location": "6062/ACT"     , "narrator": "", "text": "四万人中二桁らしいよ"},
        { "location": "6063/TALK"    , "narrator": "神楽", "text": "少なっ！！！！"},
        { "location": "6064/TALK"    , "narrator": "神楽", "text": "でもいるんだーすげー"},
        { "location": "6065/ACT"     , "narrator": "", "text": "都市伝説だよね"},
        { "location": "6066/TALK"    , "narrator": "神楽", "text": "ダヨネー"},
        { "location": "6068/TALK"    , "narrator": "神楽", "text": "ＵＭＡみたいなもんだよねー"},
        { "location": "6069/ACT"     , "narrator": "", "text": "神楽のためならどうにかして…"},
        { "location": "6071/TALK"    , "narrator": "神楽", "text": "$handlek$がありとあらゆる手を使って男性養護教諭になってくれるぴょん？？？"},
        { "location": "6072/TALK"    , "narrator": "神楽", "text": "それはもしかしたら性別を変更する可能性とかもあるぴょん？"},
        { "location": "6073/TALK"    , "narrator": "神楽", "text": "ぴょんこは$handlek$が養護教諭なら男子でも女子でもどっちでもなくても構わないけど、、、"},
        { "location": "6074/TALK"    , "narrator": "神楽", "text": "それだけの覚悟かー萌えるー！"},
        { "location": "6076/TALK"    , "narrator": "神楽", "text": "そんでもってあれよね"},
        { "location": "6077/TALK"    , "narrator": "神楽", "text": "保健室の先生といえば性別に関わらず白衣に眼鏡、これ鉄則"}
    ]
}
