    "entry":
    [
        { "location": "169/SCENARIO", "narrator": "", "text": "033_飛行機雲"},
        { "location": "196/TALK"    , "narrator": "ガブリエラ", "text": "飛行機雲って"},
        { "location": "197/TALK"    , "narrator": "ガブリエラ", "text": "なんでできるのかしら"},
        { "location": "199/SEL"     , "narrator": "", "text": "水蒸気が冷やされて"},
        { "location": "200/SEL"     , "narrator": "", "text": "検索すれば"},
        { "location": "201/SEL"     , "narrator": "", "text": "遠くを知りたい気持ち"},
        { "location": "202/ACT"     , "narrator": "", "text": "水蒸気が冷やされて"},
        { "location": "203/TALK"    , "narrator": "ガブリエラ", "text": "そうなのね"},
        { "location": "204/TALK"    , "narrator": "ガブリエラ", "text": "それは正しい答えかもしれないわ"},
        { "location": "205/TALK"    , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "207/TALK"    , "narrator": "ガブリエラ", "text": "そういうことが知りたかったんじゃないのよ"},
        { "location": "208/ACT"     , "narrator": "", "text": "検索すれば"},
        { "location": "209/TALK"    , "narrator": "ガブリエラ", "text": "今日の$marzanna$は意地悪ね"},
        { "location": "210/TALK"    , "narrator": "ガブリエラ", "text": "そうすることにするわ"},
        { "location": "211/ACT"     , "narrator": "", "text": "遠くを知りたい気持ち"},
        { "location": "213/TALK"    , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "214/TALK"    , "narrator": "ガブリエラ", "text": "その気持ちが空に残るのね"},
        { "location": "217/SEL"     , "narrator": "", "text": "でも気持ちは消えるけど"},
        { "location": "218/SEL"     , "narrator": "", "text": "ロマンチックでしょ"},
        { "location": "219/ACT"     , "narrator": "", "text": "でも気持ちは消えるけど"},
        { "location": "220/TALK"    , "narrator": "ガブリエラ", "text": "消えるかもね"},
        { "location": "222/TALK"    , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "223/TALK"    , "narrator": "ガブリエラ", "text": "残る気持ちもあるわよ"},
        { "location": "224/ACT"     , "narrator": "", "text": "ロマンチックでしょ"},
        { "location": "225/TALK"    , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "226/TALK"    , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "228/TALK"    , "narrator": "ガブリエラ", "text": "もっとロマンチックになるわよ"}
    ]
}
