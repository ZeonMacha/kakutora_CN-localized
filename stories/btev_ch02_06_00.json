        "title": "007 ココロスフィアストーリー【Lv03】",
        "sub_title": "姉妹の隔絶Ⅰ＜提起＞"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "姉妹の隔絶・前編１"},
        { "location": "13/DIALOG" , "narrator": "", "text": "<size=40>KOKORO-Lv. 03</size>\nAYAMI - KUNIMASA\n\n<size=45>姉妹の隔絶Ⅰ</size>\n<size=35>～その始まりに関する告白～</size>"},
        { "location": "23/TALK"   , "narrator": "潜在アーヤ", "text": "おーい！\nこっちよ！"},
        { "location": "24/TALK"   , "narrator": "潜在アーヤ", "text": "また会えて嬉しいわ。"},
        { "location": "25/SEL"    , "narrator": "（選択肢）", "text": "あ、欲求人格のアーヤさん、こんにちは"},
        { "location": "26/SEL"    , "narrator": "（選択肢）", "text": "あ、欲望人格のアーヤさん、こんにちは"},
        { "location": "27/ACT"    , "narrator": "", "text": "あ、欲求人格のアーヤさん、こんにちは"},
        { "location": "30/TALK"   , "narrator": "潜在アーヤ", "text": "ふふ。\n覚えていてくれて\nありがと。"},
        { "location": "31/ACT"    , "narrator": "", "text": "あ、欲望人格のアーヤさん、こんにちは"},
        { "location": "33/TALK"   , "narrator": "潜在アーヤ", "text": "えー、\n欲望じゃないわよ？\n欲求人格。"},
        { "location": "34/TALK"   , "narrator": "潜在アーヤ", "text": "まあ、\nどっちでもいいか。"},
        { "location": "35/TALK"   , "narrator": "潜在アーヤ", "text": "貴方に興味あったり、\nお近づきになりたい\nのは欲望だものね。"},
        { "location": "37/SEL"    , "narrator": "（選択肢）", "text": "で、こんどは欲求人格さんを支援するってこと？"},
        { "location": "38/ACT"    , "narrator": "", "text": "で、こんどは欲求人格さんを支援するってこと？"},
        { "location": "41/TALK"   , "narrator": "潜在アーヤ", "text": "あら、頭いいのね。\n私が誘ったんだもの、\nそういう事になるわ。"},
        { "location": "42/TALK"   , "narrator": "潜在アーヤ", "text": "実は今回、どうしても\n打ち負かしたい相手が\nいるの。"},
        { "location": "43/TALK"   , "narrator": "潜在アーヤ", "text": "だから、貴方の力を\n借りたくて。"},
        { "location": "44/SEL"    , "narrator": "（選択肢）", "text": "どんな相手？"},
        { "location": "45/ACT"    , "narrator": "", "text": "どんな相手？"},
        { "location": "47/TALK"   , "narrator": "潜在アーヤ", "text": "私の姉を、姉と\n思っていない相手。"},
        { "location": "48/TALK"   , "narrator": "潜在アーヤ", "text": "貴方は現実で\n見ているはずよ。"},
        { "location": "49/TALK"   , "narrator": "潜在アーヤ", "text": "現実世界で私が\n「あんなの姉じゃない」\nって言ってるところ。"},
        { "location": "50/TALK"   , "narrator": "潜在アーヤ", "text": "正直、もう和解したい\nのよね、姉とは。"},
        { "location": "51/TALK"   , "narrator": "潜在アーヤ", "text": "いや、和解するって\nいうより、私が一方\n的に嫌ってるだけか。"},
        { "location": "52/SEL"    , "narrator": "（選択肢）", "text": "何があったのか知りたい。"},
        { "location": "53/SEL"    , "narrator": "（選択肢）", "text": "酷いお姉さんなんだね！"},
        { "location": "54/ACT"    , "narrator": "", "text": "何があったのか知りたい。"},
        { "location": "55/TALK"   , "narrator": "潜在アーヤ", "text": "そうね。一緒に戦って\nくれるんだから、教え\nておいた方が――"},
        { "location": "56/ACT"    , "narrator": "", "text": "酷いお姉さんなんだね！"},
        { "location": "57/TALK"   , "narrator": "潜在アーヤ", "text": "あら、失礼ね。\n酷くなんてないわよ。"},
        { "location": "58/TALK"   , "narrator": "潜在アーヤ", "text": "まあ、そうね、\n強いて言うなら、\n変人？"},
        { "location": "59/TALK"   , "narrator": "潜在アーヤ", "text": "うーん…。"},
        { "location": "60/TALK"   , "narrator": "潜在アーヤ", "text": "一緒に戦ってもらう\nのに、姉を誤解された\nままってのも嫌だし―"},
        { "location": "61/TALK"   , "narrator": "潜在アーヤ", "text": "先に教えて\nおこうかしら――"},
        { "location": "64/TALK"   , "narrator": "表層アーヤ", "text": "貴方ね！\n私を倒そうなんて\n画策しているのは！"},
        { "location": "67/TALK"   , "narrator": "潜在アーヤ", "text": "あら、貴方は\nもしかして……"},
        { "location": "68/TALK"   , "narrator": "表層アーヤ", "text": "そう。\n姉を許さない私よ。"},
        { "location": "69/TALK"   , "narrator": "表層アーヤ", "text": "私を倒すということは\n姉を許すということ。\nそんなの言語道断よ。"},
        { "location": "70/TALK"   , "narrator": "表層アーヤ", "text": "貴方のような人格は\n私の方から積極的に\n消しにいく。"},
        { "location": "71/TALK"   , "narrator": "潜在アーヤ", "text": "はぁ、血の気が多い\n人格さんね。\n望む所よ。"},
        { "location": "72/TALK"   , "narrator": "表層アーヤ", "text": "私の所持するクランを\n甘く見ると、痛い目を\n見るわよ？"},
        { "location": "73/TALK"   , "narrator": "潜在アーヤ", "text": "はいはい。\nお手柔らかに。"},
        { "location": "75/TALK"   , "narrator": "潜在アーヤ", "text": "ごめんなさいね。\nどうやら説明は\n後になりそう。"},
        { "location": "76/TALK"   , "narrator": "潜在アーヤ", "text": "まずは一緒に\n戦ってくれないかしら。"},
        { "location": "77/TALK"   , "narrator": "潜在アーヤ", "text": "勝ったら\n姉のこと、色々\n教えてあげるし……"},
        { "location": "79/TALK"   , "narrator": "潜在アーヤ", "text": "あと、ご希望であれば\nお礼にデートなんかも\nいかが？"},
        { "location": "80/SEL"    , "narrator": "（選択肢）", "text": "是非！"},
        { "location": "81/SEL"    , "narrator": "（選択肢）", "text": "自分がデートしたいだけでは……？"},
        { "location": "82/ACT"    , "narrator": "", "text": "是非！"},
        { "location": "83/TALK"   , "narrator": "潜在アーヤ", "text": "ふふっ、\n嬉しい。"},
        { "location": "85/TALK"   , "narrator": "潜在アーヤ", "text": "それじゃ行くわよ。\n戦いは真剣勝負！"},
        { "location": "92/ACT"    , "narrator": "", "text": "自分がデートしたいだけでは……？"},
        { "location": "93/TALK"   , "narrator": "潜在アーヤ", "text": "あら、酷いツッコミ。\nデリカシーないのね。"},
        { "location": "94/TALK"   , "narrator": "潜在アーヤ", "text": "いいわ。\nお望み通り、\nデートは無しで。"},
        { "location": "96/TALK"   , "narrator": "潜在アーヤ", "text": "それじゃ行くわよ！"},
        { "location": "104/TALK"  , "narrator": "表層アーヤ", "text": "私を消そうとしたこと、\n後悔させてあげるわ。"},
        { "location": "116/DIALOG", "narrator": "", "text": "<color=black><size=50><b>姉を絶対的に排除する人格を倒し\n姉との和解を進展させよ！</b></size></color>\n\n\n\nアーヤと彼女の姉の確執は、\n相当なもののようだ。\nそれでも、もう和解したいと思う気持ちと、\n絶対に許したくないという気持ちが\n交錯している。\n\n強烈な思い出に対抗するには、\nあなたの力が必要。\n\n姉との和解を進展し、彼女を成長させよう！\n\n\n\n\n"}
    ]
}
