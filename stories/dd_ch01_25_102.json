    "entry":
    [
        { "location": "509/SCENARIO", "narrator": "", "text": "逃げるも時には役に立つ"},
        { "location": "524/TALK"    , "narrator": "つばめ", "text": "…うん。"},
        { "location": "537/TALK"    , "narrator": "つばめ", "text": "ぁたし決めた"},
        { "location": "538/TALK"    , "narrator": "つばめ", "text": "掃除用具入れに隠れることにする"},
        { "location": "540/SEL"     , "narrator": "", "text": "やめて"},
        { "location": "541/SEL"     , "narrator": "", "text": "すぐにそこを出て"},
        { "location": "542/SEL"     , "narrator": "", "text": "デバッグしてないよこれ"},
        { "location": "543/SEL"     , "narrator": "", "text": "自分で選択肢作りたい！！！！！"},
        { "location": "544/SEL"     , "narrator": "", "text": "それが正解"},
        { "location": "545/ACT"     , "narrator": "", "text": "つばめはかわいいなあ"},
        { "location": "546/TALK"    , "narrator": "つばめ", "text": "もう"},
        { "location": "548/TALK"    , "narrator": "つばめ", "text": "なんでそうなるの"},
        { "location": "549/ACT"     , "narrator": "", "text": "今度イチゴ狩りに行こうよ"},
        { "location": "550/TALK"    , "narrator": "つばめ", "text": "ぇ"},
        { "location": "552/TALK"    , "narrator": "つばめ", "text": "もぅ夏だし"},
        { "location": "553/TALK"    , "narrator": "つばめ", "text": "やってなぃょ？"},
        { "location": "554/ACT"     , "narrator": "", "text": "カプドラどこまで進んだ？"},
        { "location": "555/TALK"    , "narrator": "つばめ", "text": "最近は"},
        { "location": "556/TALK"    , "narrator": "つばめ", "text": "ちょとお休みしてるんだ"},
        { "location": "557/ACT"     , "narrator": "", "text": "髪飾りずれてるよ"},
        { "location": "558/TALK"    , "narrator": "つばめ", "text": "ぁ"},
        { "location": "559/TALK"    , "narrator": "つばめ", "text": "走ったからかな？"},
        { "location": "561/TALK"    , "narrator": "つばめ", "text": "直さなきゃ"},
        { "location": "562/ACT"     , "narrator": "", "text": "それが正解"},
        { "location": "563/TALK"    , "narrator": "つばめ", "text": "ぅん"},
        { "location": "564/TALK"    , "narrator": "つばめ", "text": "$handle1$に"},
        { "location": "565/TALK"    , "narrator": "つばめ", "text": "聞いてよかった"},
        { "location": "580/TALK"    , "narrator": "つばめ", "text": "……狭いなあ…。"},
        { "location": "581/TALK"    , "narrator": "つばめ", "text": "でもここだったら\n人が隠れてるって\n思わないよね？"},
        { "location": "582/SEL"     , "narrator": "", "text": "絶対バレるって"},
        { "location": "583/SEL"     , "narrator": "", "text": "さっきから選択肢がおかしいんだ"},
        { "location": "584/SEL"     , "narrator": "", "text": "大丈夫、安心して"},
        { "location": "585/ACT"     , "narrator": "", "text": "絶対バレるって"},
        { "location": "586/ACT"     , "narrator": "", "text": "さっきから選択肢がおかしいんだ"},
        { "location": "587/ACT"     , "narrator": "", "text": "大丈夫、安心して"},
        { "location": "602/TALK"    , "narrator": "プレイヤー", "text": "大丈夫、安心して"},
        { "location": "604/TALK"    , "narrator": "つばめ", "text": "ぅん"},
        { "location": "605/TALK"    , "narrator": "つばめ", "text": "そうだね"},
        { "location": "606/TALK"    , "narrator": "つばめ", "text": "通常攻撃隊の人たちがいなくなるまで"},
        { "location": "607/TALK"    , "narrator": "つばめ", "text": "じっとしておくね"},
        { "location": "609/SEL"     , "narrator": "", "text": "すぐ逃げて！"},
        { "location": "610/SEL"     , "narrator": "", "text": "さっきから何なんだ"},
        { "location": "611/SEL"     , "narrator": "", "text": "運営に報告する"},
        { "location": "612/SEL"     , "narrator": "", "text": "じっとしておこう"},
        { "location": "613/ACT"     , "narrator": "", "text": "卵焼きって塩？　砂糖？"},
        { "location": "614/TALK"    , "narrator": "つばめ", "text": "こんな時に何？"},
        { "location": "618/TALK"    , "narrator": "つばめ", "text": "砂糖だけど"},
        { "location": "619/ACT"     , "narrator": "", "text": "汗ばんだつばめ…"},
        { "location": "620/TALK"    , "narrator": "つばめ", "text": "ぇ"},
        { "location": "621/TALK"    , "narrator": "つばめ", "text": "やだ"},
        { "location": "622/TALK"    , "narrator": "つばめ", "text": "なにそれ"},
        { "location": "623/TALK"    , "narrator": "つばめ", "text": "変なこと"},
        { "location": "624/TALK"    , "narrator": "つばめ", "text": "言わないで"},
        { "location": "625/TALK"    , "narrator": "つばめ", "text": "こんな時に"},
        { "location": "626/ACT"     , "narrator": "", "text": "しりとりでもしようか"},
        { "location": "627/TALK"    , "narrator": "つばめ", "text": "そんな余裕ないよ"},
        { "location": "628/TALK"    , "narrator": "つばめ", "text": "もう！"},
        { "location": "629/ACT"     , "narrator": "", "text": "じっとしておこう"},
        { "location": "630/TALK"    , "narrator": "つばめ", "text": "はい"},
        { "location": "631/TALK"    , "narrator": "つばめ", "text": "そうします"},
        { "location": "644/TALK"    , "narrator": "つばめ", "text": "どうか見つかりません\nように……。"},
        { "location": "645/TALK"    , "narrator": "つばめ", "text": "無事にみんなと\n合流できます\nように…。"},
        { "location": "646/SEL"     , "narrator": "", "text": "いいから逃げろ！"},
        { "location": "647/SEL"     , "narrator": "", "text": "どうなってるんだ"},
        { "location": "648/SEL"     , "narrator": "", "text": "動かない方がいい"},
        { "location": "649/ACT"     , "narrator": "", "text": "いいから逃げろ！"},
        { "location": "650/ACT"     , "narrator": "", "text": "どうなってるんだ"},
        { "location": "651/ACT"     , "narrator": "", "text": "動かない方がいい"},
        { "location": "666/TALK"    , "narrator": "プレイヤー", "text": "動かない方がいい"},
        { "location": "668/TALK"    , "narrator": "つばめ", "text": "ぅん"},
        { "location": "669/TALK"    , "narrator": "つばめ", "text": "言うこと聞くょ"},
        { "location": "673/TALK"    , "narrator": "つばめ", "text": "でも……。"},
        { "location": "674/TALK"    , "narrator": "つばめ", "text": "やっぱり……。"},
        { "location": "678/TALK"    , "narrator": "つばめ", "text": "ぇっとね"},
        { "location": "679/TALK"    , "narrator": "つばめ", "text": "もし"},
        { "location": "680/TALK"    , "narrator": "つばめ", "text": "もしもだょ"},
        { "location": "681/TALK"    , "narrator": "つばめ", "text": "みつかっちゃったら"},
        { "location": "682/TALK"    , "narrator": "つばめ", "text": "どうしょう"},
        { "location": "684/SEL"     , "narrator": "", "text": "絶対見つかるって！"},
        { "location": "685/SEL"     , "narrator": "", "text": "だから逃げようよ"},
        { "location": "686/SEL"     , "narrator": "", "text": "卯月に会えるかも"},
        { "location": "687/ACT"     , "narrator": "", "text": "卯月に会えるかも"},
        { "location": "688/ACT"     , "narrator": "", "text": "卯月に会えるかも"},
        { "location": "689/ACT"     , "narrator": "", "text": "卯月に会えるかも"},
        { "location": "690/TALK"    , "narrator": "つばめ", "text": "え"},
        { "location": "691/TALK"    , "narrator": "つばめ", "text": "神楽ちゃんに"},
        { "location": "694/SEL"     , "narrator": "", "text": "そういう問題か！"},
        { "location": "695/SEL"     , "narrator": "", "text": "会いたくない？"},
        { "location": "696/ACT"     , "narrator": "", "text": "会いたくない？"},
        { "location": "697/ACT"     , "narrator": "", "text": "会いたくない？"},
        { "location": "699/TALK"    , "narrator": "つばめ", "text": "会いたい"},
        { "location": "702/TALK"    , "narrator": "つばめ", "text": "けど"},
        { "location": "705/TALK"    , "narrator": "つばめ", "text": "会いたくない"},
        { "location": "706/TALK"    , "narrator": "つばめ", "text": "かも"},
        { "location": "709/SEL"     , "narrator": "", "text": "ああ…そうだよね…"},
        { "location": "710/SEL"     , "narrator": "", "text": "もう友達じゃないの？"},
        { "location": "711/SEL"     , "narrator": "", "text": "会えないままかもしれないけど"},
        { "location": "712/ACT"     , "narrator": "", "text": "ああ…そうだよね…"},
        { "location": "713/TALK"    , "narrator": "つばめ", "text": "ぁたし"},
        { "location": "714/TALK"    , "narrator": "つばめ", "text": "神楽ちゃんのこと"},
        { "location": "715/TALK"    , "narrator": "つばめ", "text": "わかりたいけど"},
        { "location": "717/TALK"    , "narrator": "つばめ", "text": "わからないから"},
        { "location": "718/ACT"     , "narrator": "", "text": "もう友達じゃないの？"},
        { "location": "719/TALK"    , "narrator": "つばめ", "text": "友達だよ！"},
        { "location": "720/TALK"    , "narrator": "つばめ", "text": "ぁたしはそう思ってる"},
        { "location": "721/TALK"    , "narrator": "つばめ", "text": "神楽ちゃんのこと"},
        { "location": "724/TALK"    , "narrator": "つばめ", "text": "神楽ちゃんは"},
        { "location": "725/TALK"    , "narrator": "つばめ", "text": "どう思ってるか"},
        { "location": "726/TALK"    , "narrator": "つばめ", "text": "わからないけど"},
        { "location": "727/ACT"     , "narrator": "", "text": "会えないままかもしれないけど"},
        { "location": "729/TALK"    , "narrator": "つばめ", "text": "それは"},
        { "location": "731/TALK"    , "narrator": "つばめ", "text": "それならそれで"},
        { "location": "732/TALK"    , "narrator": "つばめ", "text": "ちょっとホッとするかも"},
        { "location": "735/TALK"    , "narrator": "つばめ", "text": "友達の"},
        { "location": "736/TALK"    , "narrator": "つばめ", "text": "つもりなのにね"},
        { "location": "748/TALK"    , "narrator": "つばめ", "text": "……はあ……。"},
