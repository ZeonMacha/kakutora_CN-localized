        "title": "スペシャルエピソード",
        "sub_title": "繋いだ手"
    },
    "entry":
    [
        { "location": "16/TALK" , "narrator": "透明ガブリエラ", "text": "…………。"},
        { "location": "17/SEL"  , "narrator": "（選択肢）", "text": "えっと…どうしたの？"},
        { "location": "18/ACT"  , "narrator": "", "text": "えっと…どうしたの？"},
        { "location": "22/TALK" , "narrator": "透明ガブリエラ", "text": "ちょ、聞かないでよ！\nわかるでしょ！？"},
        { "location": "23/TALK" , "narrator": "透明ガブリエラ", "text": "今、デート中なのよ？\n忘れたの？"},
        { "location": "24/TALK" , "narrator": "透明ガブリエラ", "text": "デートなら、ほら…、\n当然やらなくちゃいけない\nことがあるでしょ？"},
        { "location": "26/TALK" , "narrator": "透明ガブリエラ", "text": "それをやれって\n言ってるのよ…。"},
        { "location": "27/SEL"  , "narrator": "（選択肢）", "text": "ごめん、慣れてないからわからない"},
        { "location": "28/SEL"  , "narrator": "（選択肢）", "text": "ぷ、プロポーズはまだ早いよ！？"},
        { "location": "29/ACT"  , "narrator": "", "text": "ごめん、慣れてないからわからない"},
        { "location": "31/TALK" , "narrator": "透明ガブリエラ", "text": "あのね…、\n今のは問題発言よ？"},
        { "location": "32/TALK" , "narrator": "透明ガブリエラ", "text": "それだと、まるであたしが\nデート慣れしてるみたいに\n聞こえるじゃない。"},
        { "location": "34/TALK" , "narrator": "透明ガブリエラ", "text": "あたしだって…、\nは、は…初めて…、\nだから…。"},
        { "location": "35/SEL"  , "narrator": "（選択肢）", "text": "嬉しいな"},
        { "location": "36/ACT"  , "narrator": "", "text": "嬉しいな"},
        { "location": "39/TALK" , "narrator": "透明ガブリエラ", "text": "別に、$handle$を\n喜ばせようと思ってじゃ\nないけど…。"},
        { "location": "40/TALK" , "narrator": "透明ガブリエラ", "text": "…………。"},
        { "location": "43/TALK" , "narrator": "透明ガブリエラ", "text": "ねえ…$handle$はさ、\n今楽しい？"},
        { "location": "44/TALK" , "narrator": "透明ガブリエラ", "text": "あたしとデートしてて…、\nあんまり、ちゃんと\n話せてないし…。"},
        { "location": "45/SEL"  , "narrator": "（選択肢）", "text": "緊張してるガブリエラは可愛くて"},
        { "location": "46/SEL"  , "narrator": "（選択肢）", "text": "ガブリエラはどうなの？"},
        { "location": "47/ACT"  , "narrator": "", "text": "緊張してるガブリエラは可愛くて"},
        { "location": "49/TALK" , "narrator": "透明ガブリエラ", "text": "だ、だから！\nそうやって恥ずかしいこと\n言わないで！"},
        { "location": "50/TALK" , "narrator": "透明ガブリエラ", "text": "っていうか、緊張してるの\nわかってるなら、\n気遣いなさいよ…。"},
        { "location": "52/TALK" , "narrator": "透明ガブリエラ", "text": "…まあ、楽しんでくれは\nいるみたいだし…、\nそれならいいんだけど…。"},
        { "location": "54/TALK" , "narrator": "透明ガブリエラ", "text": "あ、でもそれはそれよ！\n無駄に恥ずかしがらせる\nような発言禁止だから！"},
        { "location": "55/ACT"  , "narrator": "", "text": "ガブリエラはどうなの？"},
        { "location": "57/TALK" , "narrator": "透明ガブリエラ", "text": "あたしは…。"},
        { "location": "58/TALK" , "narrator": "透明ガブリエラ", "text": "…………。"},
        { "location": "60/TALK" , "narrator": "透明ガブリエラ", "text": "い、今のままでも…、\nまあ、悪い気持ちは\nしないけど…。"},
        { "location": "62/ACT"  , "narrator": "", "text": "ぷ、プロポーズはまだ早いよ！？"},
        { "location": "65/TALK" , "narrator": "透明ガブリエラ", "text": "ちょ！？　いくらなんでも\nぶっ飛び過ぎよ！"},
        { "location": "66/TALK" , "narrator": "透明ガブリエラ", "text": "大体、まだあたし達\nそこまでの関係じゃ\nないでしょ！？"},
        { "location": "67/TALK" , "narrator": "透明ガブリエラ", "text": "プロポーズするときは、\nもっと、ほら…段階？"},
        { "location": "68/TALK" , "narrator": "透明ガブリエラ", "text": "そう、段階踏んでからじゃ\nなくちゃダメよ！"},
        { "location": "70/TALK" , "narrator": "透明ガブリエラ", "text": "あたし達、キスだって\nまだなんだから…。"},
        { "location": "71/SEL"  , "narrator": "（選択肢）", "text": "キスはまだ早いよ！"},
        { "location": "72/SEL"  , "narrator": "（選択肢）", "text": "…する？"},
        { "location": "73/ACT"  , "narrator": "", "text": "キスはまだ早いよ！"},
        { "location": "75/TALK" , "narrator": "透明ガブリエラ", "text": "わ、わかってるわよ！\nっていうか、あたしが\nしたいわけじゃないから！"},
        { "location": "76/ACT"  , "narrator": "", "text": "…する？"},
        { "location": "78/TALK" , "narrator": "透明ガブリエラ", "text": "え、えぇっ！？"},
        { "location": "79/TALK" , "narrator": "透明ガブリエラ", "text": "いや、しないしない！\n絶対しないから！"},
        { "location": "82/TALK" , "narrator": "透明ガブリエラ", "text": "もう、本当色々\n飛び過ぎよ。"},
        { "location": "83/TALK" , "narrator": "透明ガブリエラ", "text": "もっと、それより\nずーっと前にすることが\nあるんじゃないの？"},
        { "location": "84/TALK" , "narrator": "透明ガブリエラ", "text": "特に今！\nデート中にしなくちゃ\nいけないことがね。"},
        { "location": "88/TALK" , "narrator": "透明ガブリエラ", "text": "これじゃ、ただ普通に\n歩いてるだけじゃない…。"},
        { "location": "89/SEL"  , "narrator": "（選択肢）", "text": "えーっと…"},
        { "location": "90/ACT"  , "narrator": "", "text": "えーっと…"},
        { "location": "93/TALK" , "narrator": "透明ガブリエラ", "text": "…もうっ！\n鈍感、バカ！"},
        { "location": "94/TALK" , "narrator": "透明ガブリエラ", "text": "手よ、手！\nあたしの手、\nがら空きなんだけど？"},
        { "location": "96/TALK" , "narrator": "透明ガブリエラ", "text": "$handle$は…、\nき、気にならないの？"},
        { "location": "97/SEL"  , "narrator": "（選択肢）", "text": "手を繋ぐ"},
        { "location": "98/ACT"  , "narrator": "", "text": "手を繋ぐ"},
        { "location": "104/TALK", "narrator": "透明ガブリエラ", "text": "あっ…。"},
        { "location": "106/TALK", "narrator": "透明ガブリエラ", "text": "…………。"},
        { "location": "107/SEL" , "narrator": "（選択肢）", "text": "ダメだった？"},
        { "location": "108/ACT" , "narrator": "", "text": "ダメだった？"},
        { "location": "111/TALK", "narrator": "透明ガブリエラ", "text": "ダメじゃない！"},
        { "location": "112/TALK", "narrator": "透明ガブリエラ", "text": "あ…べ、別に…、\nあたしはこのままで\n構わないけど…。"},
        { "location": "113/SEL" , "narrator": "（選択肢）", "text": "嫌なら離すけど"},
        { "location": "114/ACT" , "narrator": "", "text": "嫌なら離すけど"},
        { "location": "116/TALK", "narrator": "透明ガブリエラ", "text": "い、嫌じゃない！\n嫌じゃないから！"},
        { "location": "118/TALK", "narrator": "透明ガブリエラ", "text": "ほ…ほら、だって…。"},
        { "location": "119/TALK", "narrator": "透明ガブリエラ", "text": "そう、手握ってないと、\n$handle$が迷子になる\nかもしれないでしょ！？"},
        { "location": "120/TALK", "narrator": "透明ガブリエラ", "text": "だから、あたしが\n手を握っててあげる。"},
        { "location": "122/TALK", "narrator": "透明ガブリエラ", "text": "…………。"},
        { "location": "123/TALK", "narrator": "透明ガブリエラ", "text": "離したら…、\n許さないから…。"},
        { "location": "138/SEL" , "narrator": "（選択肢）", "text": "こんなデートをしたいんだ！"},
        { "location": "139/ACT" , "narrator": "", "text": "こんなデートをしたいんだ！"},
        { "location": "141/TALK", "narrator": "ガブリエラ", "text": "知らないわよ！"},
        { "location": "142/TALK", "narrator": "ガブリエラ", "text": "っていうか何よこれ！？"},
        { "location": "143/TALK", "narrator": "ガブリエラ", "text": "デートしてる感じに聞こえなかったし"},
        { "location": "144/TALK", "narrator": "ガブリエラ", "text": "むしろ"},
        { "location": "145/TALK", "narrator": "ガブリエラ", "text": "あたしが恥ずかしがるとこばかりだったじゃない！"},
        { "location": "147/SEL" , "narrator": "（選択肢）", "text": "そんな姿を見たい"},
        { "location": "148/ACT" , "narrator": "", "text": "そんな姿を見たい"},
        { "location": "150/TALK", "narrator": "ガブリエラ", "text": "マルザンナはデートを理解してないわ"},
        { "location": "151/TALK", "narrator": "ガブリエラ", "text": "そんなんじゃダメよ"},
        { "location": "153/TALK", "narrator": "ガブリエラ", "text": "デートの時は"},
        { "location": "154/TALK", "narrator": "ガブリエラ", "text": "レディをエスコートしないと"},
        { "location": "155/TALK", "narrator": "ガブリエラ", "text": "あたしとデートしたいなら"},
        { "location": "156/TALK", "narrator": "ガブリエラ", "text": "もっと"},
        { "location": "157/TALK", "narrator": "ガブリエラ", "text": "勉強して出直しなさい"},
        { "location": "159/SEL" , "narrator": "（選択肢）", "text": "勉強したらデートしてくれる？"},
        { "location": "160/ACT" , "narrator": "", "text": "勉強したらデートしてくれる？"},
        { "location": "162/TALK", "narrator": "ガブリエラ", "text": "少なくとも"},
        { "location": "163/TALK", "narrator": "ガブリエラ", "text": "そういうこと聞かないくらい"},
        { "location": "164/TALK", "narrator": "ガブリエラ", "text": "デリカシーを学んだら"},
        { "location": "165/TALK", "narrator": "ガブリエラ", "text": "考えないでもないかもね"},
        { "location": "166/TALK", "narrator": "ガブリエラ", "text": "とにかく今は"},
        { "location": "167/TALK", "narrator": "ガブリエラ", "text": "出直しなさい"}
    ]
}
