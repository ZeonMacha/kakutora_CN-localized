        "title": "Extra002 ヒメゴトチャット",
        "sub_title": "異世界転生がチートとか誰に聞いた？"
    },
    "entry":
    [
        { "location": "1502/SCENARIO", "narrator": "", "text": "異世界転生がチートとか誰に聞いた？"},
        { "location": "1527/TALK"    , "narrator": "神楽", "text": "ダメなやつはどこに行ってもダメ"},
        { "location": "1528/TALK"    , "narrator": "神楽", "text": "という身も蓋もない言葉があるわけだが"},
        { "location": "1530/SEL"     , "narrator": "", "text": "ぴょんこさんには関係ないでしょ"},
        { "location": "1531/SEL"     , "narrator": "", "text": "意外と変わるかもよ"},
        { "location": "1532/SEL"     , "narrator": "", "text": "耳が痛い…"},
        { "location": "1533/ACT"     , "narrator": "", "text": "ぴょんこさんには関係ないでしょ"},
        { "location": "1534/TALK"    , "narrator": "神楽", "text": "$handlek$ったらお上手ですね？"},
        { "location": "1536/TALK"    , "narrator": "神楽", "text": "素直に受け取っておくけどね！"},
        { "location": "1537/ACT"     , "narrator": "", "text": "意外と変わるかもよ"},
        { "location": "1538/TALK"    , "narrator": "神楽", "text": "どうかなー"},
        { "location": "1540/TALK"    , "narrator": "神楽", "text": "それは"},
        { "location": "1541/ACT"     , "narrator": "", "text": "耳が痛い…"},
        { "location": "1542/TALK"    , "narrator": "神楽", "text": "あれあれあれあれ"},
        { "location": "1544/TALK"    , "narrator": "神楽", "text": "意外とそうでもないって"},
        { "location": "1546/TALK"    , "narrator": "神楽", "text": "ぴょんこはこう見えても異世界転生自体には興味津々なわけで"},
        { "location": "1548/SEL"     , "narrator": "", "text": "見たままの気もする"},
        { "location": "1549/SEL"     , "narrator": "", "text": "まずはトラックを用意します"},
        { "location": "1550/SEL"     , "narrator": "", "text": "$me$の世界に転生してよ"},
        { "location": "1551/ACT"     , "narrator": "", "text": "見たままの気もする"},
        { "location": "1553/TALK"    , "narrator": "神楽", "text": "それは心外"},
        { "location": "1554/ACT"     , "narrator": "", "text": "まずはトラックを用意します"},
        { "location": "1555/TALK"    , "narrator": "神楽", "text": "その転生方法はさすがに古いような"},
        { "location": "1556/ACT"     , "narrator": "", "text": "$me$の世界に転生してよ"},
        { "location": "1558/TALK"    , "narrator": "神楽", "text": "ナイスアイディア"},
        { "location": "1560/TALK"    , "narrator": "神楽", "text": "方法を教えてくれたらぴょんこ、今すぐにでも行っちゃう！"},
        { "location": "1562/TALK"    , "narrator": "神楽", "text": "ただ思うのはぴょんこは既にこの世界に転生していてかつ記憶を失っているのではないかということ"},
        { "location": "1563/TALK"    , "narrator": "神楽", "text": "それが事実ならちょっとしたホラー！"},
        { "location": "1564/TALK"    , "narrator": "神楽", "text": "やだ怖い！"},
        { "location": "1565/TALK"    , "narrator": "神楽", "text": "もうこの話はおしまい！"}
    ]
}
