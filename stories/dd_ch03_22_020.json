{
    "dir": "chap22/daydra/dd_ch03_22_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "22356",
        "cid": "gabriella",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "ちょっと心配"
    },
    "entry":
    [
        { "location": "291/SCENARIO", "narrator": "", "text": "ちょっと心配"},
        { "location": "307/TALK"    , "narrator": "ガブリエラ", "text": "…お菓子が食べたいわ。"},
        { "location": "309/TALK"    , "narrator": "神楽", "text": "ガブちゃん、\nついさっきお夕飯を\n食べたばかりですよ？"},
        { "location": "311/TALK"    , "narrator": "ガブリエラ", "text": "夕飯は夕飯。\nお菓子はお菓子よ。"},
        { "location": "314/TALK"    , "narrator": "みやび", "text": "すまんけんど、\n我が家の菓子類は\n今のところ品切れや。"},
        { "location": "315/TALK"    , "narrator": "みやび", "text": "うちの親が、\n明日買い出しに行く\n言うてたきね。"},
        { "location": "316/TALK"    , "narrator": "つばめ", "text": "コンビニで買ってきた\nお菓子も、今日のおやつに\n食べきっちゃったし…。"},
        { "location": "320/TALK"    , "narrator": "ガブリエラ", "text": "えーっ、何もないの？"},
        { "location": "322/TALK"    , "narrator": "アーヤ", "text": "ギャヴィもコンビニで\nお菓子買ってなかった？"},
        { "location": "325/TALK"    , "narrator": "ガブリエラ", "text": "もうとっくに\n食べ終わっちゃったわよ。"},
        { "location": "327/TALK"    , "narrator": "神楽", "text": "あまり食べ過ぎると\n太りますよ？"},
        { "location": "329/TALK"    , "narrator": "ガブリエラ", "text": "その分動いてるから\n平気よ。"},
        { "location": "332/TALK"    , "narrator": "アーヤ", "text": "はぁ…まったく…。"},
        { "location": "334/TALK"    , "narrator": "アーヤ", "text": "まあ、丁度暇してた\nところだし、コンビニまで\n買いに行ってくるわ。"},
        { "location": "336/TALK"    , "narrator": "ガブリエラ", "text": "いいの？"},
        { "location": "337/TALK"    , "narrator": "アーヤ", "text": "ええ…みんなも、\n必要な物があったら\nＷＡＶＥに送っといて。"},
        { "location": "339/TALK"    , "narrator": "みやび", "text": "夜道は暗いき、\n気ぃつけや。"},
        { "location": "342/TALK"    , "narrator": "アーヤ", "text": "うん、行ってきます。"},
        { "location": "363/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "365/TALK"    , "narrator": "ガブリエラ", "text": "ねえ、いくらなんでも\nアーヤ、遅過ぎない？"},
        { "location": "369/TALK"    , "narrator": "つばめ", "text": "え？　そうかな？"},
        { "location": "370/TALK"    , "narrator": "ガブリエラ", "text": "だって、出ていってから\n一時間以上経ってるわ。"},
        { "location": "371/TALK"    , "narrator": "ガブリエラ", "text": "ここからコンビニって、\nそこまで遠くないでしょ？"},
        { "location": "373/TALK"    , "narrator": "神楽", "text": "立ち読みでもしてるんじゃ\nないですか？"},
        { "location": "374/TALK"    , "narrator": "神楽", "text": "行くとき、暇してる、って\n言ってたじゃないですか。"},
        { "location": "377/TALK"    , "narrator": "ガブリエラ", "text": "そうだけど…。"},
        { "location": "380/TALK"    , "narrator": "みやび", "text": "この時間は海からの風が\n心地えいき、のんびり散歩\nしちゅうかもしれんよ。"},
        { "location": "381/SEL"     , "narrator": "", "text": "待ってた方が良い"},
        { "location": "382/SEL"     , "narrator": "", "text": "迎えに行こう"},
        { "location": "383/SEL"     , "narrator": "", "text": "ＷＡＶＥ送ってみれば？"},
        { "location": "385/TALK"    , "narrator": "ガブリエラ", "text": "…そうかしら？"},
        { "location": "388/TALK"    , "narrator": "つばめ", "text": "もしかして、お買い物\n頼み過ぎちゃったから――"},
        { "location": "389/TALK"    , "narrator": "つばめ", "text": "重くて休みながら\n歩いてるのかな？"},
        { "location": "391/TALK"    , "narrator": "神楽", "text": "そんなに重い物、\n誰も頼んでませんよ。"},
        { "location": "395/TALK"    , "narrator": "みやび", "text": "心配やったら、\nＷＡＶＥでも送ってみる？"},
        { "location": "399/TALK"    , "narrator": "ガブリエラ", "text": "し、心配じゃないわよ！\nお菓子が食べたいだけ\nなんだから…。"},
        { "location": "401/TALK"    , "narrator": "ガブリエラ", "text": "えっと…今どこ？　っと、\n送信。"},
        { "location": "404/TALK"    , "narrator": "みやび", "text": "送った？"},
        { "location": "406/TALK"    , "narrator": "ガブリエラ", "text": "うん…まったく、\n何やってるのかしら…。"},
        { "location": "428/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "429/TALK"    , "narrator": "つばめ", "text": "アーヤさんからの返信、\nまだないんですか？"},
        { "location": "433/TALK"    , "narrator": "ガブリエラ", "text": "うん…。\n十分くらい経つのに、\n既読も付かないわ。"},
        { "location": "434/TALK"    , "narrator": "神楽", "text": "どうしたんでしょう？\nアーヤさんらしくない\nですね。"},
        { "location": "435/TALK"    , "narrator": "神楽", "text": "いつもならすぐに\n確認して、何かしら\n返してくれるのに…。"},
        { "location": "436/TALK"    , "narrator": "みやび", "text": "律儀なアーヤには\n珍しいことやね。"},
        { "location": "437/TALK"    , "narrator": "ガブリエラ", "text": "やっぱり、\n何かあったんじゃ…。"},
        { "location": "440/TALK"    , "narrator": "アーヤ", "text": "ただいまー。"},
        { "location": "442/TALK"    , "narrator": "ガブリエラ", "text": "あ、アーヤ！？"},
        { "location": "446/TALK"    , "narrator": "アーヤ", "text": "お待たせ。\nはい、頼まれてたお菓子、\n買ってきたわ。"},
        { "location": "448/TALK"    , "narrator": "つばめ", "text": "おかえりなさい。\n遅かったけど、\n何かあったんですか？"},
        { "location": "451/TALK"    , "narrator": "アーヤ", "text": "ううん、何も。"},
        { "location": "452/TALK"    , "narrator": "アーヤ", "text": "ちょっと立ち読みして、\n潮風が気持ちよかったから\n散歩してただけよ。"},
        { "location": "455/TALK"    , "narrator": "みやび", "text": "やっぱりそうやったか。"},
        { "location": "459/TALK"    , "narrator": "神楽", "text": "何もなかったようで…\nガブちゃん、よかった\nですね？"},
        { "location": "462/TALK"    , "narrator": "ガブリエラ", "text": "な、なんであたしに\n振るのよ！？"},
        { "location": "465/TALK"    , "narrator": "ガブリエラ", "text": "っていうか、アーヤ。\nＷＡＶＥ送ったのに\nどうして返事しないのよ？"},
        { "location": "467/TALK"    , "narrator": "アーヤ", "text": "どうって、これ見れば\nわかるでしょ？"},
        { "location": "468/TALK"    , "narrator": "アーヤ", "text": "あなたが大袋のポテチを\n頼むから、両手が塞がって\n取れなかったのよ。"},
        { "location": "470/TALK"    , "narrator": "ガブリエラ", "text": "うっ…。"},
        { "location": "474/TALK"    , "narrator": "みやび", "text": "とにかく、お疲れさん。\nお茶煎れるき、アーヤは\nのんびりしちょれ。"},
        { "location": "476/TALK"    , "narrator": "アーヤ", "text": "ええ…ほら、みんな。\n自分で頼んだの\n持っていって。"},
        { "location": "479/TALK"    , "narrator": "ガブリエラ", "text": "…まったく、心配かけて。"},
        { "location": "480/TALK"    , "narrator": "ガブリエラ", "text": "でも、何もなかった\nみたいで良かった…。"},
        { "location": "481/ACT"     , "narrator": "", "text": "待ってた方が良い"},
        { "location": "499/TALK"    , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "500/TALK"    , "narrator": "ガブリエラ", "text": "私も、行けるものなら行きたいけど"},
        { "location": "501/TALK"    , "narrator": "ガブリエラ", "text": "コンビニまでの道って、まだうろ覚えだし…"},
        { "location": "512/TALK"    , "narrator": "ガブリエラ", "text": "…まったく、\n早く帰ってきなさいよ…。"},
        { "location": "535/TALK"    , "narrator": "アーヤ", "text": "ただいま。"},
        { "location": "537/TALK"    , "narrator": "つばめ", "text": "あ、おかえりなさい。\n随分遅かったですね？"},
        { "location": "541/TALK"    , "narrator": "アーヤ", "text": "ごめんなさい、待たせて。\nはい、頼まれてた\nおつかいよ。"},
        { "location": "542/TALK"    , "narrator": "神楽", "text": "ありがとうございます！"},
        { "location": "545/TALK"    , "narrator": "アーヤ", "text": "ほら、ギャヴィ。\nあんたのお菓子よ。"},
        { "location": "546/TALK"    , "narrator": "ガブリエラ", "text": "う、うん…。"},
        { "location": "548/TALK"    , "narrator": "ガブリエラ", "text": "…でもこんな時間まで\n何やってたの？"},
        { "location": "549/TALK"    , "narrator": "アーヤ", "text": "少し立ち読みしたあと、\n散歩しながら帰って\nきたのよ。"},
        { "location": "551/TALK"    , "narrator": "アーヤ", "text": "そしたら、思ったより\n時間経ってたみたい。"},
        { "location": "552/TALK"    , "narrator": "ガブリエラ", "text": "そう…。\nまあ、それならいいん\nだけど…。"},
        { "location": "553/TALK"    , "narrator": "アーヤ", "text": "？"},
        { "location": "555/TALK"    , "narrator": "ガブリエラ", "text": "何でもない！\nほら、アーヤも\nお菓子食べるでしょ？"},
        { "location": "556/ACT"     , "narrator": "", "text": "迎えに行こう"},
        { "location": "576/TALK"    , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "577/TALK"    , "narrator": "ガブリエラ", "text": "本当に、何かあったのかもしれないし"},
        { "location": "589/TALK"    , "narrator": "ガブリエラ", "text": "あたし、アーヤ迎えに\n行ってくる！"},
        { "location": "608/TALK"    , "narrator": "ガブリエラ", "text": "え、えっと…\nどっちだったかしら？"},
        { "location": "609/TALK"    , "narrator": "ガブリエラ", "text": "ああもう、昼間だったら\n道わかるのに！"},
        { "location": "611/TALK"    , "narrator": "ガブリエラ", "text": "えーっと、確か…。"},
        { "location": "615/TALK"    , "narrator": "アーヤ", "text": "…ギャヴィ？"},
        { "location": "617/TALK"    , "narrator": "ガブリエラ", "text": "きゃぁっ！？\nあ、アーヤ！！"},
        { "location": "618/TALK"    , "narrator": "アーヤ", "text": "何やってるの、\nこんなところで？"},
        { "location": "619/TALK"    , "narrator": "アーヤ", "text": "もう遅いんだから、\n夜遊びはダメよ。"},
        { "location": "620/TALK"    , "narrator": "ガブリエラ", "text": "遊んでなんかないわよ！"},
        { "location": "621/TALK"    , "narrator": "アーヤ", "text": "じゃあ、何してたの？"},
        { "location": "624/TALK"    , "narrator": "ガブリエラ", "text": "そ、それは…。"},
        { "location": "627/TALK"    , "narrator": "ガブリエラ", "text": "…あ、アーヤが遅くて、\nお菓子待ちきれ\nなかったの！"},
        { "location": "629/TALK"    , "narrator": "アーヤ", "text": "何？　そんなにお菓子\n食べたかったの？"},
        { "location": "630/TALK"    , "narrator": "ガブリエラ", "text": "そうよ。\nそれ、貰うわよ。"},
        { "location": "631/TALK"    , "narrator": "アーヤ", "text": "歩きながら食べるつもり？\nお行儀悪いわね。"},
        { "location": "633/TALK"    , "narrator": "ガブリエラ", "text": "いいじゃん、誰が見てる\nわけでもないんだし。"},
        { "location": "634/TALK"    , "narrator": "アーヤ", "text": "まったく、自分勝手\nなんだから…。"},
        { "location": "636/TALK"    , "narrator": "アーヤ", "text": "…っていうか、ウソでも\n心配してたの一言くらい、\n言えないの？"},
        { "location": "638/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "640/TALK"    , "narrator": "ガブリエラ", "text": "全然帰ってくる気配なくて\n心配だったから、こうして\n迎えに来たのよ。"},
        { "location": "642/TALK"    , "narrator": "アーヤ", "text": "はいはい、ありがと。\nほら、帰るわよ。"},
        { "location": "645/TALK"    , "narrator": "ガブリエラ", "text": "何よ、自分で言えって\n言ったくせに…。"},
        { "location": "646/TALK"    , "narrator": "ガブリエラ", "text": "…でも、無事でよかった。"},
        { "location": "663/ACT"     , "narrator": "", "text": "ＷＡＶＥ送ってみれば？"},
        { "location": "682/TALK"    , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "683/TALK"    , "narrator": "ガブリエラ", "text": "アーヤ、ＷＡＶＥにはすぐ返事くれるし"},
        { "location": "686/TALK"    , "narrator": "ガブリエラ", "text": "えっと…今どこ？　っと、\n送信。"},
        { "location": "688/TALK"    , "narrator": "みやび", "text": "ＷＡＶＥ送ったが？"},
        { "location": "689/TALK"    , "narrator": "ガブリエラ", "text": "うん…まったく、\n何やってるのかしら…。"},
        { "location": "306/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>8月22日　 7:53 PM</color>\n合宿中、みやびの実家でのこと"},
        { "location": "657/DIALOG"  , "narrator": "Dialog_GEThimegoto_ch03", "text": "【お姉さんぶっちゃって】"}
    ]
}
