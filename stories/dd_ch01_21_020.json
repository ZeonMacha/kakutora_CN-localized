{
    "dir": "chap21/daydra/dd_ch01_21_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "21156",
        "cid": "tsubame",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "お肌ヒリヒリ"
    },
    "entry":
    [
        { "location": "295/SCENARIO", "narrator": "", "text": "お肌ヒリヒリ"},
        { "location": "310/TALK"    , "narrator": "ガブリエラ", "text": "イタタタ…。"},
        { "location": "313/TALK"    , "narrator": "つばめ", "text": "ガブちゃん、どうしたの？"},
        { "location": "316/TALK"    , "narrator": "ガブリエラ", "text": "ん～…お風呂入ってたら、\n背中がヒリヒリ痛くなって\nきちゃって…。"},
        { "location": "317/TALK"    , "narrator": "みやび", "text": "ちゃんと日焼け止めが\n塗れてなかったんやない？"},
        { "location": "318/TALK"    , "narrator": "つばめ", "text": "そういえば、ガブちゃん\n自分で塗ってなかった？"},
        { "location": "319/TALK"    , "narrator": "ガブリエラ", "text": "うっ…見てたの？"},
        { "location": "321/TALK"    , "narrator": "みやび", "text": "そりゃ塗れなくて当然や。\n横着せんで誰かに塗って\nもらうべきやったね。"},
        { "location": "324/TALK"    , "narrator": "ガブリエラ", "text": "へ、平気よ。\n身体は柔らかい方\nなんだし。"},
        { "location": "325/TALK"    , "narrator": "みやび", "text": "限度はあると思うけんど？"},
        { "location": "327/TALK"    , "narrator": "ガブリエラ", "text": "塗る量が少なかった\nだけよ。"},
        { "location": "328/TALK"    , "narrator": "つばめ", "text": "…あ、軟膏塗るなら\n手伝うよ。"},
        { "location": "331/TALK"    , "narrator": "ガブリエラ", "text": "いいってば。\n身体は柔らかいって…\nふんっ！　言ったでしょ？"},
        { "location": "332/TALK"    , "narrator": "みやび", "text": "…いや、全然届いて\nないちや。"},
        { "location": "333/TALK"    , "narrator": "つばめ", "text": "ガブちゃん、さすがに\n無理あると思うよ？"},
        { "location": "334/TALK"    , "narrator": "ガブリエラ", "text": "だ、大丈夫だってば！\nも、もうちょっと…\nんっ、ふんっ！"},
        { "location": "335/TALK"    , "narrator": "みやび", "text": "見てられんよ。\nほれ、軟膏貸しぃ。"},
        { "location": "337/TALK"    , "narrator": "ガブリエラ", "text": "だ、だからいいってば！"},
        { "location": "338/TALK"    , "narrator": "みやび", "text": "意固地になっても\nしゃぁないやろ？"},
        { "location": "339/TALK"    , "narrator": "みやび", "text": "それとも、うちじゃ\n嫌なが？"},
        { "location": "341/TALK"    , "narrator": "ガブリエラ", "text": "だ、だから…ああもうっ！"},
        { "location": "344/TALK"    , "narrator": "ガブリエラ", "text": "苦手なのよ…。\n背中、触られると\nムズムズしちゃって…。"},
        { "location": "345/TALK"    , "narrator": "みやび", "text": "…ガブちゃん、\n背中が敏感さんなんやね。"},
        { "location": "347/TALK"    , "narrator": "ガブリエラ", "text": "…わざと恥ずかしがらせ\nようとしてない？"},
        { "location": "348/TALK"    , "narrator": "つばめ", "text": "でも、このままじゃ\n痛いの中々治らないよ？"},
        { "location": "351/TALK"    , "narrator": "ガブリエラ", "text": "だから頑張ってるん\nじゃない。\nもう邪魔しないで。"},
        { "location": "352/TALK"    , "narrator": "みやび", "text": "…こりゃ、明日まで\n痛み持ち越すことに\nなりそうやね。"},
        { "location": "355/TALK"    , "narrator": "つばめ", "text": "う～ん…。"},
        { "location": "367/TALK"    , "narrator": "つばめ", "text": "アドバイスが欲しいの"},
        { "location": "368/TALK"    , "narrator": "つばめ", "text": "背中が敏感な人に、上手く軟膏を塗る方法ってないかな？"},
        { "location": "370/SEL"     , "narrator": "", "text": "コットンを使ったら？"},
        { "location": "371/SEL"     , "narrator": "", "text": "ささっと終わらせよう"},
        { "location": "372/SEL"     , "narrator": "", "text": "指先でそーっと塗ればいい"},
        { "location": "373/ACT"     , "narrator": "", "text": "コットンを使ったら？"},
        { "location": "374/TALK"    , "narrator": "つばめ", "text": "あ、それいいアイデアだよ！"},
        { "location": "375/TALK"    , "narrator": "つばめ", "text": "早速言ってみるね"},
        { "location": "388/TALK"    , "narrator": "つばめ", "text": "ねえ、ガブちゃん。\nそれならコットンで\n塗るのはどうかな？"},
        { "location": "390/TALK"    , "narrator": "ガブリエラ", "text": "コットン？"},
        { "location": "392/TALK"    , "narrator": "みやび", "text": "なるほど、指やないき、\nそこまでくすぐったくは\nなさそうやね。"},
        { "location": "393/TALK"    , "narrator": "つばめ", "text": "どうかな、ガブちゃん？"},
        { "location": "394/TALK"    , "narrator": "ガブリエラ", "text": "そうね…\nそれなら平気かも。"},
        { "location": "395/TALK"    , "narrator": "ガブリエラ", "text": "コットンならそこに\nあるから、\n早速やってみて。"},
        { "location": "399/TALK"    , "narrator": "つばめ", "text": "うん…。"},
        { "location": "405/TALK"    , "narrator": "つばめ", "text": "じゃあ、始めるね。"},
        { "location": "408/TALK"    , "narrator": "ガブリエラ", "text": "服はまくらないで！\n擦れて痛いから…。"},
        { "location": "409/TALK"    , "narrator": "つばめ", "text": "いいよ。\nそれじゃ、塗るねー。"},
        { "location": "414/TALK"    , "narrator": "ガブリエラ", "text": "うん………んっ！"},
        { "location": "415/TALK"    , "narrator": "つばめ", "text": "あっ、ダメだった？"},
        { "location": "417/TALK"    , "narrator": "ガブリエラ", "text": "ううん、平気。\nちょっと軟膏が冷たかった\nだけだから…。"},
        { "location": "418/TALK"    , "narrator": "つばめ", "text": "それじゃ、続けるね。"},
        { "location": "420/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "421/TALK"    , "narrator": "みやび", "text": "どんな感じや？"},
        { "location": "423/TALK"    , "narrator": "ガブリエラ", "text": "うん…これならいいわ。"},
        { "location": "424/TALK"    , "narrator": "ガブリエラ", "text": "くすぐったくないし、\nでもヒリヒリするところに\nしっかり塗れてるし――"},
        { "location": "425/TALK"    , "narrator": "ガブリエラ", "text": "結構気持ちいいかも。"},
        { "location": "426/TALK"    , "narrator": "つばめ", "text": "よかった…。"},
        { "location": "427/TALK"    , "narrator": "つばめ", "text": "今度海に行くときは、\n日焼け止めもこうやって\n塗ってあげるね。"},
        { "location": "429/TALK"    , "narrator": "ガブリエラ", "text": "助かるわ…。\nあー、これ、結構\n気持ちいい…。"},
        { "location": "430/ACT"     , "narrator": "", "text": "ささっと終わらせよう"},
        { "location": "431/TALK"    , "narrator": "つばめ", "text": "ささっと塗って終わらせれば、平気かな？"},
        { "location": "432/TALK"    , "narrator": "つばめ", "text": "ちょっと聞いてみる"},
        { "location": "445/TALK"    , "narrator": "つばめ", "text": "じゃあさ、あんまり\nくすぐったくならない\nように――"},
        { "location": "446/TALK"    , "narrator": "つばめ", "text": "ささっと塗って終わらせる\nっていうのはどうかな？"},
        { "location": "449/TALK"    , "narrator": "ガブリエラ", "text": "ささっとって、\nどれくらいささっと？"},
        { "location": "450/TALK"    , "narrator": "つばめ", "text": "手のひらに軟膏塗って、\nそれでさっと背中を\n一撫でするよ。"},
        { "location": "451/TALK"    , "narrator": "みやび", "text": "手の平ならマシな方やと\n思うけんど？"},
        { "location": "452/TALK"    , "narrator": "みやび", "text": "早く治すためにも、\nその方がえいと思うがよ。"},
        { "location": "453/TALK"    , "narrator": "ガブリエラ", "text": "…わかったわ。\nでも、本当にささっと\n終わらせてよ？"},
        { "location": "458/TALK"    , "narrator": "つばめ", "text": "うん、約束するよ。"},
        { "location": "466/TALK"    , "narrator": "つばめ", "text": "じゃあ、始めるね。"},
        { "location": "469/TALK"    , "narrator": "ガブリエラ", "text": "服はまくらないで！\n擦れて痛いから…。"},
        { "location": "471/TALK"    , "narrator": "つばめ", "text": "いいよ。\nそれじゃ、塗るねー。"},
        { "location": "474/TALK"    , "narrator": "ガブリエラ", "text": "超適当でいいから。\n本当、すぐ終わらせてよ？"},
        { "location": "475/TALK"    , "narrator": "つばめ", "text": "うん…行きまーす。"},
        { "location": "477/TALK"    , "narrator": "ガブリエラ", "text": "うんっ…ひぁっ！？"},
        { "location": "478/TALK"    , "narrator": "つばめ", "text": "大丈夫？\nすぐ終わるからね。"},
        { "location": "481/TALK"    , "narrator": "ガブリエラ", "text": "しゃ、喋ってないで、\n早く塗って！"},
        { "location": "482/TALK"    , "narrator": "つばめ", "text": "もう終わるよ…。"},
        { "location": "483/TALK"    , "narrator": "つばめ", "text": "はい、おしまい。"},
        { "location": "486/TALK"    , "narrator": "ガブリエラ", "text": "ふぅ…ちゃんと塗れた？"},
        { "location": "487/TALK"    , "narrator": "つばめ", "text": "さっ、とだけどね。"},
        { "location": "488/TALK"    , "narrator": "つばめ", "text": "心配だから、\nもう一回くらい\n塗った方が――"},
        { "location": "490/TALK"    , "narrator": "ガブリエラ", "text": "い、いいから！\nもう触らないで！"},
        { "location": "493/TALK"    , "narrator": "ガブリエラ", "text": "とりあえず塗れてるなら\nそれでいいから。\n助かったわ、ありがと。"},
        { "location": "494/TALK"    , "narrator": "つばめ", "text": "う、うん…。"},
        { "location": "495/TALK"    , "narrator": "みやび", "text": "ちょっと警戒し過ぎや\nないが？"},
        { "location": "498/TALK"    , "narrator": "ガブリエラ", "text": "仕方ないでしょ？\n本当に苦手なんだから…。"},
        { "location": "501/TALK"    , "narrator": "ガブリエラ", "text": "…それに、これ以上\n触られたら、また声が\n出ちゃいそうだし。"},
        { "location": "503/TALK"    , "narrator": "ガブリエラ", "text": "やっぱり、自分で塗る\n方法を探さないと\nダメね…。"},
        { "location": "504/ACT"     , "narrator": "", "text": "指先でそーっと塗ればいい"},
        { "location": "506/TALK"    , "narrator": "つばめ", "text": "そーっと塗れば、大丈夫なの？"},
        { "location": "507/TALK"    , "narrator": "つばめ", "text": "わかった、出来る限り優しくやってみるね"},
        { "location": "519/TALK"    , "narrator": "つばめ", "text": "ガブちゃん、やっぱり\nわたしが塗るよ。"},
        { "location": "520/TALK"    , "narrator": "つばめ", "text": "なるべくくすぐったく\nならないように塗るから、\nそれなら大丈夫でしょ？"},
        { "location": "523/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "526/TALK"    , "narrator": "ガブリエラ", "text": "まあ、みやびがやるよりは\n安心できそうね。"},
        { "location": "527/TALK"    , "narrator": "みやび", "text": "本人の前で言うことか？"},
        { "location": "530/TALK"    , "narrator": "ガブリエラ", "text": "だって、絶対わざと\nくすぐったりしそう\nだし。"},
        { "location": "532/TALK"    , "narrator": "みやび", "text": "やりはするけんど、\nちっくとだけやぞ？"},
        { "location": "534/TALK"    , "narrator": "ガブリエラ", "text": "多い少ないの\n問題じゃない！"},
        { "location": "536/TALK"    , "narrator": "ガブリエラ", "text": "…本当、冗談抜きで\n背中弱いから、頼むわよ？"},
        { "location": "540/TALK"    , "narrator": "つばめ", "text": "うん…。"},
        { "location": "545/TALK"    , "narrator": "つばめ", "text": "じゃあ、始めるね。"},
        { "location": "548/TALK"    , "narrator": "ガブリエラ", "text": "服はまくらないで！\n擦れて痛いから…。"},
        { "location": "549/TALK"    , "narrator": "つばめ", "text": "いいよ。\nそれじゃ、始めるね。"},
        { "location": "551/TALK"    , "narrator": "つばめ", "text": "えっと、軟膏を指先に\n付けて、そーっと\n塗っていけば…。"},
        { "location": "555/TALK"    , "narrator": "ガブリエラ", "text": "っひ！？　ひゃぅんっ！"},
        { "location": "556/TALK"    , "narrator": "みやび", "text": "！？"},
        { "location": "561/TALK"    , "narrator": "ガブリエラ", "text": "ば、バカー！！\nなんて塗り方してんのよ？"},
        { "location": "564/TALK"    , "narrator": "つばめ", "text": "あ、あれ？\nくすぐったかった？"},
        { "location": "565/TALK"    , "narrator": "ガブリエラ", "text": "聞くな！"},
        { "location": "568/TALK"    , "narrator": "ガブリエラ", "text": "ああ、もぉ！\nすっごい恥ずかしい声\n出ちゃったし…。"},
        { "location": "569/TALK"    , "narrator": "みやび", "text": "つばめちゃん。\nあれは狙ったが？"},
        { "location": "573/TALK"    , "narrator": "つばめ", "text": "あの、何の話をしてるのか\nさっぱりなんですけど…。"},
        { "location": "577/TALK"    , "narrator": "ガブリエラ", "text": "敏感って言ってるのに、\nどうして指先なんかで\n塗るのよ！？"},
        { "location": "581/TALK"    , "narrator": "ガブリエラ", "text": "ううっ、なんかまだ\n背中にムズムズした\n感じがする…。"},
        { "location": "584/TALK"    , "narrator": "つばめ", "text": "…よくわからないけど、\nゆっくり塗るのって\n失敗だったみたい。"},
        { "location": "586/TALK"    , "narrator": "つばめ", "text": "ごめんね、ガブちゃん。\nわたしの塗り方が\n下手で…。"},
        { "location": "589/TALK"    , "narrator": "ガブリエラ", "text": "もぉ、つばめのバカ！"},
        { "location": "591/TALK"    , "narrator": "ガブリエラ", "text": "悪気がないのはわかってる\nけど、もう少し考えて\nやってよ…。"},
        { "location": "592/TALK"    , "narrator": "みやび", "text": "しっかし、ガブちゃんも\nあんなに色っぽい声が\n出せるお年頃なんやね？"},
        { "location": "594/TALK"    , "narrator": "みやび", "text": "うち、ちっくと\n感動したがよ。"},
        { "location": "595/TALK"    , "narrator": "ガブリエラ", "text": "言わないでってば！\n本当、恥ずかしいのに…。"},
        { "location": "307/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>8月21日　 10:12 PM</color>\n合宿中、みやびの実家でのこと"}
    ]
}
