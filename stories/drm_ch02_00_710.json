    "entry":
    [
        { "location": "138/SCENARIO", "narrator": "", "text": "620_選んでも、選ばなくても"},
        { "location": "163/TALK"    , "narrator": "アーヤ", "text": "こっちと"},
        { "location": "164/TALK"    , "narrator": "アーヤ", "text": "こっちのどっちがいい？"},
        { "location": "166/SEL"     , "narrator": "", "text": "うーん"},
        { "location": "167/SEL"     , "narrator": "", "text": "何これ？"},
        { "location": "168/SEL"     , "narrator": "", "text": "$me$に作ってくれたの？"},
        { "location": "169/ACT"     , "narrator": "", "text": "うーん"},
        { "location": "170/TALK"    , "narrator": "アーヤ", "text": "あれ"},
        { "location": "172/TALK"    , "narrator": "アーヤ", "text": "どっちも気に入らない？"},
        { "location": "173/ACT"     , "narrator": "", "text": "何これ？"},
        { "location": "174/TALK"    , "narrator": "アーヤ", "text": "ミサンガと"},
        { "location": "175/TALK"    , "narrator": "アーヤ", "text": "靴下だけど"},
        { "location": "176/TALK"    , "narrator": "アーヤ", "text": "手編みの"},
        { "location": "177/ACT"     , "narrator": "", "text": "$me$に作ってくれたの？"},
        { "location": "188/TALK"    , "narrator": "アーヤ", "text": "そうよ"},
        { "location": "189/TALK"    , "narrator": "アーヤ", "text": "貴方のために"},
        { "location": "190/TALK"    , "narrator": "アーヤ", "text": "作ったのよ"},
        { "location": "192/TALK"    , "narrator": "アーヤ", "text": "驚かせたくて"},
        { "location": "193/TALK"    , "narrator": "アーヤ", "text": "$handle$さんには"},
        { "location": "194/TALK"    , "narrator": "アーヤ", "text": "内緒にしてたんだけど"},
        { "location": "195/TALK"    , "narrator": "アーヤ", "text": "作るのって時間もかかるし"},
        { "location": "196/TALK"    , "narrator": "アーヤ", "text": "でも"},
        { "location": "197/TALK"    , "narrator": "アーヤ", "text": "何が欲しいか"},
        { "location": "198/TALK"    , "narrator": "アーヤ", "text": "先に聞いた方がよかった？"},
        { "location": "200/SEL"     , "narrator": "", "text": "別に"},
        { "location": "201/SEL"     , "narrator": "", "text": "リクエストしてもいいの？"},
        { "location": "202/SEL"     , "narrator": "", "text": "お構いなく"},
        { "location": "203/ACT"     , "narrator": "", "text": "別に"},
        { "location": "204/TALK"    , "narrator": "アーヤ", "text": "あら"},
        { "location": "205/TALK"    , "narrator": "アーヤ", "text": "そう？"},
        { "location": "206/ACT"     , "narrator": "", "text": "リクエストしてもいいの？"},
        { "location": "207/TALK"    , "narrator": "アーヤ", "text": "もちろん"},
        { "location": "208/TALK"    , "narrator": "アーヤ", "text": "いいわよ"},
        { "location": "209/ACT"     , "narrator": "", "text": "お構いなく"},
        { "location": "210/TALK"    , "narrator": "アーヤ", "text": "もう"},
        { "location": "211/TALK"    , "narrator": "アーヤ", "text": "遠慮しないで"},
        { "location": "213/TALK"    , "narrator": "アーヤ", "text": "色々死体の"},
        { "location": "216/SEL"     , "narrator": "", "text": "え"},
        { "location": "217/SEL"     , "narrator": "", "text": "怖い怖い！"},
        { "location": "218/SEL"     , "narrator": "", "text": "落ち着いて"},
        { "location": "219/ACT"     , "narrator": "", "text": "え"},
        { "location": "220/TALK"    , "narrator": "アーヤ", "text": "うわ"},
        { "location": "221/ACT"     , "narrator": "", "text": "怖い怖い！"},
        { "location": "222/TALK"    , "narrator": "アーヤ", "text": "え"},
        { "location": "223/TALK"    , "narrator": "アーヤ", "text": "ぎゃー"},
        { "location": "224/ACT"     , "narrator": "", "text": "落ち着いて"},
        { "location": "225/TALK"    , "narrator": "アーヤ", "text": "うわわ"},
        { "location": "226/TALK"    , "narrator": "アーヤ", "text": "落ち着いて"},
        { "location": "227/TALK"    , "narrator": "アーヤ", "text": "落ち着くわ"},
        { "location": "229/TALK"    , "narrator": "アーヤ", "text": "色々"},
        { "location": "230/TALK"    , "narrator": "アーヤ", "text": "したいの"},
        { "location": "231/TALK"    , "narrator": "アーヤ", "text": "貴方には"},
        { "location": "233/SEL"     , "narrator": "", "text": "でも"},
        { "location": "234/ACT"     , "narrator": "", "text": "でも"},
        { "location": "235/TALK"    , "narrator": "アーヤ", "text": "なあに？"},
        { "location": "238/SEL"     , "narrator": "", "text": "アーヤは会える日が来ると思う？"},
        { "location": "239/ACT"     , "narrator": "", "text": "アーヤは会える日が来ると思う？"},
        { "location": "241/TALK"    , "narrator": "アーヤ", "text": "それを聞くの？"},
        { "location": "244/SEL"     , "narrator": "", "text": "聞くよ？"},
        { "location": "245/SEL"     , "narrator": "", "text": "聞かない方がいいのかな？"},
        { "location": "246/SEL"     , "narrator": "", "text": "できれば聞きたいんだ"},
        { "location": "247/ACT"     , "narrator": "", "text": "聞くよ？"},
        { "location": "248/TALK"    , "narrator": "アーヤ", "text": "そう"},
        { "location": "249/ACT"     , "narrator": "", "text": "聞かない方がいいのかな？"},
        { "location": "250/TALK"    , "narrator": "アーヤ", "text": "ええと"},
        { "location": "251/ACT"     , "narrator": "", "text": "できれば聞きたいんだ"},
        { "location": "252/TALK"    , "narrator": "アーヤ", "text": "そうよね"},
        { "location": "253/TALK"    , "narrator": "アーヤ", "text": "そうよね、、、"},
        { "location": "256/TALK"    , "narrator": "アーヤ", "text": "いつか会いたいって思ってる"},
        { "location": "259/TALK"    , "narrator": "アーヤ", "text": "でも"},
        { "location": "262/TALK"    , "narrator": "アーヤ", "text": "会えるかどうかはわからない"},
        { "location": "266/TALK"    , "narrator": "アーヤ", "text": "$handle$さんは？"},
        { "location": "268/SEL"     , "narrator": "", "text": "同じ意見かな"},
        { "location": "269/SEL"     , "narrator": "", "text": "どうにかするよ"},
        { "location": "270/SEL"     , "narrator": "", "text": "どうすればいいんだろうね"},
        { "location": "271/ACT"     , "narrator": "", "text": "同じ意見かな"},
        { "location": "272/TALK"    , "narrator": "アーヤ", "text": "そうなのね"},
        { "location": "273/ACT"     , "narrator": "", "text": "どうにかするよ"},
        { "location": "274/TALK"    , "narrator": "アーヤ", "text": "どうにかって？"},
        { "location": "275/ACT"     , "narrator": "", "text": "どうすればいいんだろうね"},
        { "location": "276/TALK"    , "narrator": "アーヤ", "text": "どうすればって、、、"},
        { "location": "278/TALK"    , "narrator": "アーヤ", "text": "私にもわからないけど"},
        { "location": "279/TALK"    , "narrator": "アーヤ", "text": "貴方に何かしたいっていうのは"},
        { "location": "280/TALK"    , "narrator": "アーヤ", "text": "本当の気持ちだわ"},
        { "location": "283/TALK"    , "narrator": "ボイスメール", "text": "その道が見える？"},
        { "location": "183/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>1000pt.</b></color></size>\nアップしました！"},
        { "location": "295/DIALOG"  , "narrator": "Dialog_GETVoice", "text": "<color=green>【アーヤ】</color>のボイスメール\n<color=red>【その道が見える？】</color>\nをゲットしました！"}
    ]
}
