{
    "dir": "chap05/battle/btev_ch02_05_02.js",
    "type": "",
    "info": {
        "story_id": "22006",
        "cid": "",
        "title": "006 ココロスフィアストーリー【Lv02】",
        "sub_title": "ＪＫＡクーデター＜帰結＞"
    },
    "entry":
    [
        { "location": "374/SCENARIO", "narrator": "", "text": "高校時代のクーデター"},
        { "location": "384/TALK"    , "narrator": "高校生アーヤ", "text": "当然の結果ですね。"},
        { "location": "385/TALK"    , "narrator": "潜在アーヤ", "text": "どうして\nこんなことを\nするわけ！？"},
        { "location": "386/TALK"    , "narrator": "高校生アーヤ", "text": "ドームの\nフェノメノン戦前――"},
        { "location": "387/TALK"    , "narrator": "潜在アーヤ", "text": "…？"},
        { "location": "389/TALK"    , "narrator": "高校生アーヤ", "text": "電車が止まって\n閉じこめられた時、\n私は体裁を気にした。"},
        { "location": "390/TALK"    , "narrator": "高校生アーヤ", "text": "もう少し遅かったら\n逢瀬さんはもっと\n大変だったかも。"},
        { "location": "392/TALK"    , "narrator": "潜在アーヤ", "text": "……。"},
        { "location": "393/TALK"    , "narrator": "高校生アーヤ", "text": "そして、劇場で\n皆に厳しく言うことを\n躊躇うのもまた然り。"},
        { "location": "394/TALK"    , "narrator": "高校生アーヤ", "text": "最近の私は\nたるみすぎです。"},
        { "location": "395/TALK"    , "narrator": "高校生アーヤ", "text": "だからその根源である\n貴方を殲滅しに来た。"},
        { "location": "397/TALK"    , "narrator": "高校生アーヤ", "text": "そして今、\nその使命は達成された\nというわけです。"},
        { "location": "400/TALK"    , "narrator": "潜在アーヤ", "text": "……そうね。\n私はもう消えるもの。"},
        { "location": "402/TALK"    , "narrator": "潜在アーヤ", "text": "けど、こんなやり方\n普通じゃない。"},
        { "location": "403/TALK"    , "narrator": "潜在アーヤ", "text": "これからもそうやって\n貴方のような一人格が\n私たちを殲滅したら――"},
        { "location": "406/TALK"    , "narrator": "潜在アーヤ", "text": "私は全く物事の\nバランスの取れない\n酷い私になるわよ？"},
        { "location": "407/TALK"    , "narrator": "高校生アーヤ", "text": "そこはしっかり\nバランスを取って\n調節するから。"},
        { "location": "409/TALK"    , "narrator": "高校生アーヤ", "text": "貴方は心配しなくて\n大丈夫。"},
        { "location": "411/TALK"    , "narrator": "潜在アーヤ", "text": "……。"},
        { "location": "413/TALK"    , "narrator": "潜在アーヤ", "text": "$handle$さん。\nこの子には絶対\n気を許さないでね。"},
        { "location": "415/TALK"    , "narrator": "潜在アーヤ", "text": "確かに“私たち”は\n$handle$さんに\n心を預けている。"},
        { "location": "416/TALK"    , "narrator": "潜在アーヤ", "text": "けど、他にも沢山いる\n綾水の人格たちが貴方を\n危険と感じたら――"},
        { "location": "417/TALK"    , "narrator": "潜在アーヤ", "text": "その時から貴方は\n私の心に\n入れなくなるから。"},
        { "location": "428/TALK"    , "narrator": "高校生アーヤ", "text": "……。"},
        { "location": "439/TALK"    , "narrator": "高校生アーヤ", "text": "改めて、\nありがとうございます。\n助かったわ。"},
        { "location": "441/TALK"    , "narrator": "高校生アーヤ", "text": "それじゃ約束通り、\nえっと……"},
        { "location": "442/TALK"    , "narrator": "高校生アーヤ", "text": "デート？\nしましょうか？"},
        { "location": "443/SEL"     , "narrator": "（選択肢）", "text": "やったー！"},
        { "location": "444/SEL"     , "narrator": "（選択肢）", "text": "照れてる？"},
        { "location": "445/ACT"     , "narrator": "", "text": "やったー！"},
        { "location": "446/ACT"     , "narrator": "", "text": "照れてる？"},
        { "location": "452/DIALOG"  , "narrator": "", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"},
        { "location": "456/TALK"    , "narrator": "高校生アーヤ", "text": "そんなわけ\nないでしょ！"},
        { "location": "457/TALK"    , "narrator": "高校生アーヤ", "text": "ちょっと呆れてるだけ。"},
        { "location": "458/TALK"    , "narrator": "高校生アーヤ", "text": "貴方にとってデートが\nそんな価値がある\nものなんだ…って。"},
        { "location": "459/SEL"     , "narrator": "（選択肢）", "text": "大ありです！"},
        { "location": "460/SEL"     , "narrator": "（選択肢）", "text": "元々ロハだったわけだし価値が０．１でも十分元が取れてる"},
        { "location": "461/ACT"     , "narrator": "", "text": "大ありです！"},
        { "location": "462/TALK"    , "narrator": "高校生アーヤ", "text": "ふーん。\n私にはちょっと\nわからないわ。"},
        { "location": "463/ACT"     , "narrator": "", "text": "元々ロハだったわけだし価値が０．１でも十分元が取れてる"},
        { "location": "469/DIALOG"  , "narrator": "", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"},
        { "location": "473/TALK"    , "narrator": "高校生アーヤ", "text": "あ……。"},
        { "location": "475/TALK"    , "narrator": "高校生アーヤ", "text": "そうね。\nちょっとだけ\n納得した。"},
        { "location": "478/TALK"    , "narrator": "高校生アーヤ", "text": "さて、それじゃ早速\nお待ちかねの\nデートだけど――"},
        { "location": "479/TALK"    , "narrator": "高校生アーヤ", "text": "図書館でいい？"},
        { "location": "480/SEL"     , "narrator": "（選択肢）", "text": "もちろん！"},
        { "location": "481/SEL"     , "narrator": "（選択肢）", "text": "カフェで一緒に甘い物食べたい"},
        { "location": "482/ACT"     , "narrator": "", "text": "もちろん！"},
        { "location": "483/TALK"    , "narrator": "高校生アーヤ", "text": "それじゃ早速\n行きましょう。"},
        { "location": "497/TALK"    , "narrator": "高校生アーヤ", "text": "それじゃ私は\n明日の予習を\nするから。"},
        { "location": "499/TALK"    , "narrator": "高校生アーヤ", "text": "$handle$$yobi$は\nどうする？"},
        { "location": "500/SEL"     , "narrator": "（選択肢）", "text": "アーヤと話をする"},
        { "location": "501/SEL"     , "narrator": "（選択肢）", "text": "アーヤの顔をずっと見てる"},
        { "location": "502/ACT"     , "narrator": "", "text": "アーヤと話をする"},
        { "location": "504/TALK"    , "narrator": "高校生アーヤ", "text": "ダメに\n決まってるでしょ。\nここ図書館よ？"},
        { "location": "505/SEL"     , "narrator": "（選択肢）", "text": "耳元で愛を囁くように話すから"},
        { "location": "506/ACT"     , "narrator": "", "text": "耳元で愛を囁くように話すから"},
        { "location": "509/TALK"    , "narrator": "高校生アーヤ", "text": "ば、バカなこと\n言わないで！"},
        { "location": "510/SEL"     , "narrator": "高校生アーヤ", "text": "それくらいの話し声は普通に聞こえるけど？"},
        { "location": "511/ACT"     , "narrator": "", "text": "それくらいの話し声は普通に聞こえるけど？"},
        { "location": "513/TALK"    , "narrator": "高校生アーヤ", "text": "他の子は\n問題じゃない。"},
        { "location": "514/TALK"    , "narrator": "高校生アーヤ", "text": "私がそういうことを\nするのが問題なのよ！"},
        { "location": "515/SEL"     , "narrator": "（選択肢）", "text": "なんで？"},
        { "location": "516/ACT"     , "narrator": "", "text": "なんで？"},
        { "location": "518/TALK"    , "narrator": "高校生アーヤ", "text": "生徒会長だから！"},
        { "location": "519/TALK"    , "narrator": "高校生アーヤ", "text": "生徒会長が……"},
        { "location": "521/TALK"    , "narrator": "高校生アーヤ", "text": "その…"},
        { "location": "522/TALK"    , "narrator": "高校生アーヤ", "text": "図書館で\n愛を囁いたり\nしてたら……っ…"},
        { "location": "523/TALK"    , "narrator": "高校生アーヤ", "text": "信頼ガタ落ちに\nなっちゃうでしょ！"},
        { "location": "524/SEL"     , "narrator": "（選択肢）", "text": "本当に愛を囁くとは言ってないけど？"},
        { "location": "525/ACT"     , "narrator": "", "text": "本当に愛を囁くとは言ってないけど？"},
        { "location": "527/TALK"    , "narrator": "高校生アーヤ", "text": "…っ！？"},
        { "location": "528/TALK"    , "narrator": "高校生アーヤ", "text": "うーるーさーいーっ！"},
        { "location": "529/TALK"    , "narrator": "高校生アーヤ", "text": "もういい。\n帰る！"},
        { "location": "531/TALK"    , "narrator": "高校生アーヤ", "text": "こんなくだらない事で\n信頼失ったら\n立ち直れないわ。"},
        { "location": "532/TALK"    , "narrator": "高校生アーヤ", "text": "ついてこないでよね？"},
        { "location": "533/ACT"     , "narrator": "", "text": "アーヤの顔をずっと見てる"},
        { "location": "539/DIALOG"  , "narrator": "", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"},
        { "location": "544/TALK"    , "narrator": "高校生アーヤ", "text": "は……"},
        { "location": "545/TALK"    , "narrator": "高校生アーヤ", "text": "はああぁぁ！？\nダメよそんなの！"},
        { "location": "546/SEL"     , "narrator": "（選択肢）", "text": "なんで？"},
        { "location": "547/ACT"     , "narrator": "", "text": "なんで？"},
        { "location": "550/TALK"    , "narrator": "高校生アーヤ", "text": "え、えっとそれは……"},
        { "location": "551/TALK"    , "narrator": "高校生アーヤ", "text": "周りに迷惑……"},
        { "location": "552/SEL"     , "narrator": "（選択肢）", "text": "声出してないです"},
        { "location": "553/ACT"     , "narrator": "", "text": "声出してないです"},
        { "location": "556/TALK"    , "narrator": "高校生アーヤ", "text": "そ、そりゃそうね。"},
        { "location": "557/TALK"    , "narrator": "高校生アーヤ", "text": "えっと、\nそれじゃ……"},
        { "location": "558/TALK"    , "narrator": "高校生アーヤ", "text": "$handle$$yobi$との\n誤解が噂で広まったら\n色々困るのよ！"},
        { "location": "559/SEL"     , "narrator": "（選択肢）", "text": "どんな誤解？"},
        { "location": "560/SEL"     , "narrator": "（選択肢）", "text": "なんで困るの？"},
        { "location": "561/ACT"     , "narrator": "", "text": "どんな誤解？"},
        { "location": "562/TALK"    , "narrator": "高校生アーヤ", "text": "それは！！"},
        { "location": "567/TALK"    , "narrator": "高校生アーヤ", "text": "……。"},
        { "location": "570/TALK"    , "narrator": "高校生アーヤ", "text": "いえ、\nもういいです。"},
        { "location": "572/TALK"    , "narrator": "高校生アーヤ", "text": "私、帰ります。"},
        { "location": "573/TALK"    , "narrator": "高校生アーヤ", "text": "ついてこないで\nくださいね。"},
        { "location": "574/ACT"     , "narrator": "", "text": "なんで困るの？"},
        { "location": "575/TALK"    , "narrator": "高校生アーヤ", "text": "だって私は\n生徒会長なのよ！？"},
        { "location": "576/TALK"    , "narrator": "高校生アーヤ", "text": "しかも剣道部\n主将なの！"},
        { "location": "577/TALK"    , "narrator": "高校生アーヤ", "text": "そんな私が、\nその……"},
        { "location": "580/TALK"    , "narrator": "高校生アーヤ", "text": "……そういう…人が\nいるって誤解されたら、\n色々問題でしょ！？"},
        { "location": "581/SEL"     , "narrator": "（選択肢）", "text": "何が問題なのかわからない"},
        { "location": "582/ACT"     , "narrator": "", "text": "何が問題なのかわからない"},
        { "location": "585/TALK"    , "narrator": "高校生アーヤ", "text": "白い目で\n見られるでしょう！"},
        { "location": "586/SEL"     , "narrator": "（選択肢）", "text": "周り、カップルだらけですけど"},
        { "location": "587/ACT"     , "narrator": "", "text": "周り、カップルだらけですけど"},
        { "location": "589/TALK"    , "narrator": "高校生アーヤ", "text": "普通の人はいいの！"},
        { "location": "590/TALK"    , "narrator": "高校生アーヤ", "text": "もういい。\n私、帰るから！"},
        { "location": "592/TALK"    , "narrator": "高校生アーヤ", "text": "ついてこないで\nくださいね。"},
        { "location": "609/TALK"    , "narrator": "千羽鶴", "text": "……デリカシー\nないのね。"},
        { "location": "610/SEL"     , "narrator": "（選択肢）", "text": "照れ隠し？それとも何かを怖がってる？"},
        { "location": "611/ACT"     , "narrator": "", "text": "照れ隠し？それとも何かを怖がってる？"},
        { "location": "613/TALK"    , "narrator": "千羽鶴", "text": "どっちもかも。"},
        { "location": "614/TALK"    , "narrator": "千羽鶴", "text": "でも、何かを\n怖がってるのは\nあると思う。"},
        { "location": "615/TALK"    , "narrator": "千羽鶴", "text": "そしてそれが\n彼女の脆さでもある。"},
        { "location": "616/TALK"    , "narrator": "千羽鶴", "text": "……まあそれは\nいずれ何かの形で\n噴出するでしょう。"},
        { "location": "617/TALK"    , "narrator": "千羽鶴", "text": "ともあれおつかれさま。\n彼女の心は\nちゃんと固まった。"},
        { "location": "618/TALK"    , "narrator": "千羽鶴", "text": "國政綾水は\n気を引きしめて\nバイトに臨むでしょう。"},
        { "location": "619/TALK"    , "narrator": "千羽鶴", "text": "今回はこれで完了ね。"},
        { "location": "620/SEL"     , "narrator": "（選択肢）", "text": "千羽鶴はリーダーって何が大事だと思う？"},
        { "location": "621/ACT"     , "narrator": "", "text": "千羽鶴はリーダーって何が大事だと思う？"},
        { "location": "623/TALK"    , "narrator": "千羽鶴", "text": "決して揺るがない信念と\nそれをやり通す決意。"},
        { "location": "624/TALK"    , "narrator": "千羽鶴", "text": "……。"},
        { "location": "625/TALK"    , "narrator": "千羽鶴", "text": "それだけ？"},
        { "location": "626/SEL"     , "narrator": "（選択肢）", "text": "あ、はい。"},
        { "location": "627/ACT"     , "narrator": "", "text": "あ、はい。"},
        { "location": "630/TALK"    , "narrator": "千羽鶴", "text": "……そう。"},
        { "location": "632/ACT"     , "narrator": "", "text": "カフェで一緒に甘い物食べたい"},
        { "location": "638/DIALOG"  , "narrator": "", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"},
        { "location": "643/TALK"    , "narrator": "高校生アーヤ", "text": "ええっ！？"},
        { "location": "644/TALK"    , "narrator": "高校生アーヤ", "text": "カフェなんて\n行かないわよ！"},
        { "location": "645/TALK"    , "narrator": "高校生アーヤ", "text": "誰かに見つかったら\nどうするの！"},
        { "location": "646/SEL"     , "narrator": "（選択肢）", "text": "カフェっていかがわしいところだっけ？"},
        { "location": "647/ACT"     , "narrator": "", "text": "カフェっていかがわしいところだっけ？"},
        { "location": "649/TALK"    , "narrator": "高校生アーヤ", "text": "下校時の高校生に\nとってはそうでしょ。"},
        { "location": "650/TALK"    , "narrator": "高校生アーヤ", "text": "部活サボって\n寄り道してるわけだし。"},
        { "location": "651/SEL"     , "narrator": "（選択肢）", "text": "デートしてくれなければ履行違反です！"},
        { "location": "652/ACT"     , "narrator": "", "text": "デートしてくれなければ履行違反です！"},
        { "location": "655/TALK"    , "narrator": "高校生アーヤ", "text": "……っ！"},
        { "location": "656/TALK"    , "narrator": "高校生アーヤ", "text": "わ、わかってます！"},
        { "location": "658/TALK"    , "narrator": "高校生アーヤ", "text": "それじゃ……"},
        { "location": "660/TALK"    , "narrator": "高校生アーヤ", "text": "……。"},
        { "location": "663/TALK"    , "narrator": "高校生アーヤ", "text": "ちょっと遠いところに\nあるカフェでもいい？"},
        { "location": "664/SEL"     , "narrator": "（選択肢）", "text": "もちろん！"},
        { "location": "665/ACT"     , "narrator": "", "text": "もちろん！"},
        { "location": "684/TALK"    , "narrator": "高校生アーヤ", "text": "わぁ……\nやっぱり素敵ね…！"},
        { "location": "686/TALK"    , "narrator": "高校生アーヤ", "text": "前からずっと\n来てみたかったのよね、\nここのお店。"},
        { "location": "689/TALK"    , "narrator": "高校生アーヤ", "text": "…って、いけない！"},
        { "location": "692/TALK"    , "narrator": "高校生アーヤ", "text": "誰かに見られてたら\n大変だわ……。"},
        { "location": "693/SEL"     , "narrator": "（選択肢）", "text": "気にしすぎじゃない？"},
        { "location": "694/ACT"     , "narrator": "", "text": "気にしすぎじゃない？"},
        { "location": "697/TALK"    , "narrator": "高校生アーヤ", "text": "そんなことないから。\n気にしすぎるくらいで\n丁度いいの。"},
        { "location": "699/TALK"    , "narrator": "高校生アーヤ", "text": "こんなところ誰かに\n見られたら全校生徒に\n示しがつかないわ。"},
        { "location": "702/TALK"    , "narrator": "高校生アーヤ", "text": "生徒会長の\n信用がた落ち。"},
        { "location": "703/TALK"    , "narrator": "高校生アーヤ", "text": "しかも剣道部主将\nなのに部活サボって\nこんなところで……"},
        { "location": "705/TALK"    , "narrator": "高校生アーヤ", "text": "で…デートとか……"},
        { "location": "706/SEL"     , "narrator": "（選択肢）", "text": "今くらい楽しもうよ"},
        { "location": "707/ACT"     , "narrator": "", "text": "今くらい楽しもうよ"},
        { "location": "711/TALK"    , "narrator": "高校生アーヤ", "text": "無理よ！"},
        { "location": "712/SEL"     , "narrator": "（選択肢）", "text": "それじゃ自分がしたいこと全然出来ないよ？"},
        { "location": "713/ACT"     , "narrator": "", "text": "それじゃ自分がしたいこと全然出来ないよ？"},
        { "location": "716/TALK"    , "narrator": "高校生アーヤ", "text": "リーダーってのは\nみんなの為に身を粉に\nして頑張るものなの。"},
        { "location": "718/TALK"    , "narrator": "高校生アーヤ", "text": "そうしなければ、\nみんなの期待を\n裏切ることになるわ。"},
        { "location": "719/SEL"     , "narrator": "（選択肢）", "text": "アーヤは何の為にリーダーやってるの？"},
        { "location": "720/ACT"     , "narrator": "", "text": "アーヤは何の為にリーダーやってるの？"},
        { "location": "722/TALK"    , "narrator": "高校生アーヤ", "text": "そりゃ、\nみんなのためよ。"},
        { "location": "723/SEL"     , "narrator": "（選択肢）", "text": "自分がやりたいことを実現したいから、とかじゃなくて？"},
        { "location": "724/ACT"     , "narrator": "", "text": "自分がやりたいことを実現したいから、とかじゃなくて？"},
        { "location": "727/TALK"    , "narrator": "高校生アーヤ", "text": "え……――？"},
        { "location": "729/TALK"    , "narrator": "高校生アーヤ", "text": "……。"},
        { "location": "730/TALK"    , "narrator": "高校生アーヤ", "text": "……もう帰ろう。\nやっぱり部活に\n行かなくちゃ……。"},
        { "location": "755/TALK"    , "narrator": "千羽鶴", "text": "随分と突っ込んでた。\nなかなかいい素質\nあるかも。"},
        { "location": "756/SEL"     , "narrator": "（選択肢）", "text": "そう？"},
        { "location": "757/ACT"     , "narrator": "", "text": "そう？"},
        { "location": "759/TALK"    , "narrator": "千羽鶴", "text": "調子に乗るな。"},
        { "location": "760/TALK"    , "narrator": "千羽鶴", "text": "でも、國政綾水の核心\n近くまで掘り下げた\nのはすごい。"},
        { "location": "761/TALK"    , "narrator": "千羽鶴", "text": "でもここからが大変。"},
        { "location": "762/TALK"    , "narrator": "千羽鶴", "text": "いずれこの問題には\n直面することになる。\n彼女とつき合うなら。"},
        { "location": "763/TALK"    , "narrator": "千羽鶴", "text": "ともあれおつかれさま。\n彼女の心は\nちゃんと固まった。"},
        { "location": "764/TALK"    , "narrator": "千羽鶴", "text": "國政綾水は\n気を引きしめて\nバイトに臨むでしょう。"},
        { "location": "765/TALK"    , "narrator": "千羽鶴", "text": "今回はこれで完了ね。"},
        { "location": "766/SEL"     , "narrator": "（選択肢）", "text": "千羽鶴はリーダーって何が大事だと思う？"},
        { "location": "767/ACT"     , "narrator": "", "text": "千羽鶴はリーダーって何が大事だと思う？"},
        { "location": "769/TALK"    , "narrator": "千羽鶴", "text": "決して揺るがない信念と\nそれをやり通す決意。"},
        { "location": "770/TALK"    , "narrator": "千羽鶴", "text": "……。"},
        { "location": "771/TALK"    , "narrator": "千羽鶴", "text": "それだけ？"},
        { "location": "772/SEL"     , "narrator": "（選択肢）", "text": "あ、はい。"},
        { "location": "773/ACT"     , "narrator": "", "text": "あ、はい。"},
        { "location": "776/TALK"    , "narrator": "千羽鶴", "text": "……そう。"},
        { "location": "782/TALK"    , "narrator": "高校生アーヤ", "text": "それじゃ、また。"},
        { "location": "783/SEL"     , "narrator": "（選択肢）", "text": "はい、さよなら"},
        { "location": "784/SEL"     , "narrator": "（選択肢）", "text": "ちょっと待って"},
        { "location": "785/ACT"     , "narrator": "", "text": "はい、さよなら"},
        { "location": "786/TALK"    , "narrator": "高校生アーヤ", "text": "あ、あの。"},
        { "location": "787/SEL"     , "narrator": "（選択肢）", "text": "はい？"},
        { "location": "788/ACT"     , "narrator": "", "text": "はい？"},
        { "location": "791/TALK"    , "narrator": "高校生アーヤ", "text": "また協力してくれると\n嬉しいです…。"},
        { "location": "793/ACT"     , "narrator": "", "text": "ちょっと待って"},
        { "location": "799/DIALOG"  , "narrator": "", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"},
        { "location": "803/TALK"    , "narrator": "高校生アーヤ", "text": "え？"},
        { "location": "804/SEL"     , "narrator": "（選択肢）", "text": "どうしてそんなに固いの？"},
        { "location": "805/SEL"     , "narrator": "（選択肢）", "text": "いえ、なんでもないです"},
        { "location": "806/ACT"     , "narrator": "", "text": "どうしてそんなに固いの？"},
        { "location": "812/DIALOG"  , "narrator": "", "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！"},
        { "location": "816/TALK"    , "narrator": "高校生アーヤ", "text": "リーダーという\n役務についているから。"},
        { "location": "817/TALK"    , "narrator": "高校生アーヤ", "text": "私は生徒会長と\n剣道部主将に――"},
        { "location": "818/TALK"    , "narrator": "高校生アーヤ", "text": "今の大学３年の私は\nトライナリーの\nリーダーに。"},
        { "location": "819/TALK"    , "narrator": "高校生アーヤ", "text": "リーダーというものは\nチーム全体のお手本に\nならないとダメ。"},
        { "location": "820/TALK"    , "narrator": "高校生アーヤ", "text": "だから、いつも\n気を引きしめて\nいかないと。"},
        { "location": "821/SEL"     , "narrator": "（選択肢）", "text": "大変だね"},
        { "location": "822/ACT"     , "narrator": "", "text": "大変だね"},
        { "location": "824/TALK"    , "narrator": "高校生アーヤ", "text": "そうね。\nでも頑張らなくちゃ。"},
        { "location": "825/SEL"     , "narrator": "（選択肢）", "text": "どうしてそこまでしてリーダーやってるの？"},
        { "location": "826/ACT"     , "narrator": "", "text": "どうしてそこまでしてリーダーやってるの？"},
        { "location": "828/TALK"    , "narrator": "高校生アーヤ", "text": "期待されてるから。"},
        { "location": "829/TALK"    , "narrator": "高校生アーヤ", "text": "リーダーって\nなりたいだけじゃ\nなれないでしょ？"},
        { "location": "830/TALK"    , "narrator": "高校生アーヤ", "text": "みんなの推薦や\n支持があって初めて\nなれるもの。"},
        { "location": "831/TALK"    , "narrator": "高校生アーヤ", "text": "私を推薦してくれた\n人たちの期待を\n裏切らないように――"},
        { "location": "832/TALK"    , "narrator": "高校生アーヤ", "text": "いえ、期待以上の\n成果を上げるべく\n頑張るのがリーダー。"},
        { "location": "833/TALK"    , "narrator": "高校生アーヤ", "text": "そうでしょ？"},
        { "location": "844/TALK"    , "narrator": "千羽鶴", "text": "彼女の心が\n固まったみたい。\nおつかれさま。"},
        { "location": "845/TALK"    , "narrator": "千羽鶴", "text": "今回はこれで完了ね。"},
        { "location": "846/SEL"     , "narrator": "（選択肢）", "text": "千羽鶴はリーダーって何が大事だと思う？"},
        { "location": "847/ACT"     , "narrator": "", "text": "千羽鶴はリーダーって何が大事だと思う？"},
        { "location": "849/TALK"    , "narrator": "千羽鶴", "text": "決して揺るがない信念と\nそれをやり通す決意。"},
        { "location": "850/TALK"    , "narrator": "千羽鶴", "text": "……。"},
        { "location": "851/TALK"    , "narrator": "千羽鶴", "text": "それだけ？"},
        { "location": "852/SEL"     , "narrator": "（選択肢）", "text": "あ、はい。"},
        { "location": "853/ACT"     , "narrator": "", "text": "あ、はい。"},
        { "location": "856/TALK"    , "narrator": "千羽鶴", "text": "……そう。"},
        { "location": "857/ACT"     , "narrator": "", "text": "いえ、なんでもないです"},
        { "location": "858/TALK"    , "narrator": "高校生アーヤ", "text": "そう。"},
        { "location": "859/TALK"    , "narrator": "高校生アーヤ", "text": "今回はありがとう。"},
        { "location": "860/TALK"    , "narrator": "高校生アーヤ", "text": "また協力してくれると\n嬉しいです…。"}
    ]
}
