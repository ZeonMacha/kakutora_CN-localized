    "entry":
    [
        { "location": "187/SCENARIO", "narrator": "", "text": "012_電脳上の妄想"},
        { "location": "212/TALK"    , "narrator": "みやび", "text": "全てを電子化してしまえばよいのかも"},
        { "location": "213/TALK"    , "narrator": "みやび", "text": "そうすれば"},
        { "location": "214/TALK"    , "narrator": "みやび", "text": "世界征服も思うがまま"},
        { "location": "215/TALK"    , "narrator": "みやび", "text": "いや"},
        { "location": "216/TALK"    , "narrator": "みやび", "text": "そんなわけないか"},
        { "location": "217/TALK"    , "narrator": "みやび", "text": "ですよねー"},
        { "location": "218/TALK"    , "narrator": "みやび", "text": "すんません"},
        { "location": "220/SEL"     , "narrator": "", "text": "お取り込み中？"},
        { "location": "221/SEL"     , "narrator": "", "text": "暇なの？"},
        { "location": "222/SEL"     , "narrator": "", "text": "出直した方がいい？"},
        { "location": "223/TALK"    , "narrator": "みやび", "text": "大体エネルギー供給はどうすればいいのやら"},
        { "location": "224/TALK"    , "narrator": "みやび", "text": "天然資源は不安定すぎる"},
        { "location": "225/TALK"    , "narrator": "みやび", "text": "プラントにするならメンテナンスは必須"},
        { "location": "238/ACT"     , "narrator": "", "text": "お取り込み中？"},
        { "location": "239/TALK"    , "narrator": "みやび", "text": "特に"},
        { "location": "240/ACT"     , "narrator": "", "text": "暇なの？"},
        { "location": "241/TALK"    , "narrator": "みやび", "text": "大忙し"},
        { "location": "242/ACT"     , "narrator": "", "text": "出直した方がいい？"},
        { "location": "244/TALK"    , "narrator": "みやび", "text": "いやいや"},
        { "location": "245/TALK"    , "narrator": "みやび", "text": "お待ちしておりましたよ"},
        { "location": "246/TALK"    , "narrator": "みやび", "text": "$handle$さまぁ"},
        { "location": "248/TALK"    , "narrator": "みやび", "text": "いやなに"},
        { "location": "249/TALK"    , "narrator": "みやび", "text": "電脳世界の深淵を見るのに有効な手段について模索していただけぞね"},
        { "location": "251/SEL"     , "narrator": "", "text": "何か大変そうだね…"},
        { "location": "252/SEL"     , "narrator": "", "text": "手伝えることがあったら言って"},
        { "location": "253/SEL"     , "narrator": "", "text": "見つかりそう？"},
        { "location": "254/ACT"     , "narrator": "", "text": "何か大変そうだね…"},
        { "location": "255/TALK"    , "narrator": "みやび", "text": "いや"},
        { "location": "256/TALK"    , "narrator": "みやび", "text": "国家予算級のスーパーコンピューターがあればいいだけ"},
        { "location": "257/TALK"    , "narrator": "みやび", "text": "超★簡★単★"},
        { "location": "258/ACT"     , "narrator": "", "text": "手伝えることがあったら言って"},
        { "location": "260/TALK"    , "narrator": "みやび", "text": "$handle$ごときに手伝ってもらっては"},
        { "location": "261/TALK"    , "narrator": "みやび", "text": "みやびさんの出る幕がないぞね"},
        { "location": "262/TALK"    , "narrator": "みやび", "text": "だから手伝わせん"},
        { "location": "263/ACT"     , "narrator": "", "text": "見つかりそう？"},
        { "location": "264/TALK"    , "narrator": "みやび", "text": "いや"},
        { "location": "265/TALK"    , "narrator": "みやび", "text": "それがなかなかしぶとい"},
        { "location": "267/TALK"    , "narrator": "みやび", "text": "だからといって"},
        { "location": "268/TALK"    , "narrator": "みやび", "text": "みなかったことにもできんしね"},
        { "location": "269/TALK"    , "narrator": "みやび", "text": "今さら"},
        { "location": "271/SEL"     , "narrator": "", "text": "何のこと？"},
        { "location": "272/ACT"     , "narrator": "", "text": "何のこと？"},
        { "location": "273/TALK"    , "narrator": "みやび", "text": "いや別に"},
        { "location": "275/TALK"    , "narrator": "みやび", "text": "みやびさんの乙女の純情の話かな"},
        { "location": "276/TALK"    , "narrator": "みやび", "text": "だから見ないでね"}
    ]
}
