        "title": "001 アニメーション",
        "sub_title": "しあわせのパンツ"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "アニメ第21話"},
        { "location": "47/TALK"   , "narrator": "千羽鶴", "text": "ごきげんよう、\n$handle$。"},
        { "location": "49/TALK"   , "narrator": "千羽鶴", "text": "いつも通り、今回も\n逢瀬つばめの解説を\nするだけでいい？"},
        { "location": "51/TALK"   , "narrator": "千羽鶴", "text": "いつも通り、今回も\n國政綾水の解説を\nするだけでいい？"},
        { "location": "53/TALK"   , "narrator": "千羽鶴", "text": "いつも通り、今回も\nガブリエラの解説を\nするだけでいい？"},
        { "location": "55/TALK"   , "narrator": "千羽鶴", "text": "いつも通り、今回も\n恋ヶ崎みやびの解説を\nするだけでいい？"},
        { "location": "57/SEL"    , "narrator": "", "text": "はい"},
        { "location": "58/SEL"    , "narrator": "", "text": "いいえ"},
        { "location": "59/ACT"    , "narrator": "", "text": "はい"},
        { "location": "61/TALK"   , "narrator": "千羽鶴", "text": "よかった。\n私も助かる。\nこれぞWIN-WINね。"},
        { "location": "63/ACT"    , "narrator": "", "text": "いいえ"},
        { "location": "64/TALK"   , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "69/TALK"   , "narrator": "千羽鶴", "text": "ごきげんよう。"},
        { "location": "70/TALK"   , "narrator": "千羽鶴", "text": "唐突ではあるけど、\nおさらいクイズをする。"},
        { "location": "71/TALK"   , "narrator": "千羽鶴", "text": "私が一番最初に\n貴方に伝えた目的は\n何だった？"},
        { "location": "72/SEL"    , "narrator": "", "text": "ある少女たちと結婚して欲しい"},
        { "location": "73/SEL"    , "narrator": "", "text": "千羽鶴と結婚して欲しい"},
        { "location": "74/ACT"    , "narrator": "", "text": "ある少女たちと結婚して欲しい"},
        { "location": "75/TALK"   , "narrator": "千羽鶴", "text": "そう、正解。"},
        { "location": "76/ACT"    , "narrator": "", "text": "千羽鶴と結婚して欲しい"},
        { "location": "77/TALK"   , "narrator": "千羽鶴", "text": "真面目にやって。"},
        { "location": "78/SEL"    , "narrator": "", "text": "ノリが悪くなってない？"},
        { "location": "79/ACT"    , "narrator": "", "text": "ノリが悪くなってない？"},
        { "location": "81/TALK"   , "narrator": "千羽鶴", "text": "フェイズ２だし。\n空気読んで。"},
        { "location": "82/TALK"   , "narrator": "千羽鶴", "text": "TPOを考えないで好き放題\n言ってると、異性に\n嫌われるから気をつけて。"},
        { "location": "83/TALK"   , "narrator": "千羽鶴", "text": "正解は、「ある少女たちと\n結婚して欲しい」だった\nはず。"},
        { "location": "85/TALK"   , "narrator": "千羽鶴", "text": "今回はいよいよ、\nその本当の意図を\n少しだけお話する。"},
        { "location": "86/SEL"    , "narrator": "", "text": "意図って…もしかして「結婚して欲しい」は比喩的表現だったの！？"},
        { "location": "87/ACT"    , "narrator": "", "text": "意図って…もしかして「結婚して欲しい」は比喩的表現だったの！？"},
        { "location": "89/TALK"   , "narrator": "千羽鶴", "text": "いいえ。\nむしろガチ。"},
        { "location": "90/TALK"   , "narrator": "千羽鶴", "text": "彼女たちとは本気で、\n末永く愛を育んで欲しいと\n思っている。"},
        { "location": "91/TALK"   , "narrator": "千羽鶴", "text": "私が今回話したいのは、\nその目的。"},
        { "location": "92/TALK"   , "narrator": "千羽鶴", "text": "私と貴方を繋ぐこの\nTRI-OSは、お見合い\nツールじゃない。"},
        { "location": "93/TALK"   , "narrator": "千羽鶴", "text": "もはやこっちの世界で\n結婚するなんて絶対無理！\nだから異世界結婚を――"},
        { "location": "94/TALK"   , "narrator": "千羽鶴", "text": "…とか憂いで\n異世界間接続をして\nしまったわけでもない。"},
        { "location": "95/SEL"    , "narrator": "", "text": "もしホントにそんな理由で接続してたらウケル！"},
        { "location": "96/SEL"    , "narrator": "", "text": "でもそれってぶっちゃけ「政略恋愛」ってことだよね？"},
        { "location": "97/ACT"    , "narrator": "", "text": "もしホントにそんな理由で接続してたらウケル！"},
        { "location": "98/TALK"   , "narrator": "千羽鶴", "text": "……。\n確かにウケル。"},
        { "location": "99/TALK"   , "narrator": "千羽鶴", "text": "そんなわけだから、\n私が貴方の世界に接触した\nのには明確な理由がある。"},
        { "location": "100/ACT"   , "narrator": "", "text": "でもそれってぶっちゃけ「政略恋愛」ってことだよね？"},
        { "location": "101/TALK"  , "narrator": "千羽鶴", "text": "素晴らしい造語。\n政略結婚ならぬ\n政略恋愛とは。"},
        { "location": "102/TALK"  , "narrator": "千羽鶴", "text": "でも、そうね。\nそこは敢えて否定しない。"},
        { "location": "103/TALK"  , "narrator": "千羽鶴", "text": "とはいえ、世に言う\n政略結婚の問題は、その\n非選択性にあると思う。"},
        { "location": "104/TALK"  , "narrator": "千羽鶴", "text": "翻し、私は付き合いを\n強制もしなければ、一人を\n押し当てることもしない。"},
        { "location": "105/TALK"  , "narrator": "千羽鶴", "text": "確かに意図を持って\n繋いではいるけど、互いの\n意志を一番に尊重する。"},
        { "location": "106/TALK"  , "narrator": "千羽鶴", "text": "だから、政略恋愛\nそれ自体には、問題は\n無いと思っている。"},
        { "location": "107/TALK"  , "narrator": "千羽鶴", "text": "何が言いたいかというと。"},
        { "location": "108/TALK"  , "narrator": "千羽鶴", "text": "好きなら一緒にいて欲しい\nけど、嫌いなら無理にいる\n必要は無いということ。"},
        { "location": "109/TALK"  , "narrator": "千羽鶴", "text": "で、話を戻すと。"},
        { "location": "110/TALK"  , "narrator": "千羽鶴", "text": "私が貴方の世界に接触した\nのには明確な理由がある。"},
        { "location": "112/TALK"  , "narrator": "千羽鶴", "text": "彼女たちと愛を育んで\n欲しいと思ってるのにも、\nちゃんと理由もある。"},
        { "location": "113/TALK"  , "narrator": "千羽鶴", "text": "では、\nその理由とは何か。"},
        { "location": "114/TALK"  , "narrator": "千羽鶴", "text": "それを説明する為に、\n今から一枚の写真を\n披露する。"},
        { "location": "119/TALK"  , "narrator": "千羽鶴", "text": "まずはこれを見て欲しい。"},
        { "location": "120/TALK"  , "narrator": "千羽鶴", "text": "この写真は\n貴方が関与しなくなった\n後の、私たちの日本の姿。"},
        { "location": "121/TALK"  , "narrator": "千羽鶴", "text": "人が住めるレベルを\n超えた崩壊、地獄のような\n生活を強いられる人々。"},
        { "location": "122/TALK"  , "narrator": "千羽鶴", "text": "国家としての機能は\n麻痺し、人々は秩序なき\n街を彷徨い続ける。"},
        { "location": "124/TALK"  , "narrator": "千羽鶴", "text": "私の使命のうちの１つは、\nこの廃墟世界という選択を\n拒否すること。"},
        { "location": "125/TALK"  , "narrator": "千羽鶴", "text": "それは、今の日本が写真の\nような姿にならないよう、\n維持し続ける事でもある。"},
        { "location": "126/TALK"  , "narrator": "千羽鶴", "text": "そして、\nそれ以外の使命もまた、\n全てその延長線上にある。"},
        { "location": "127/TALK"  , "narrator": "千羽鶴", "text": "その使命とは、１つには\n秩序のある、争いのない\n社会を創造すること。"},
        { "location": "128/TALK"  , "narrator": "千羽鶴", "text": "それらの実現には、\n彼女たちトライナリーの\n力が必要不可欠になる。"},
        { "location": "129/TALK"  , "narrator": "千羽鶴", "text": "しかし彼女たちは、\n人であるが故に未熟。"},
        { "location": "130/TALK"  , "narrator": "千羽鶴", "text": "心は大きく揺れるし、\nよく判断も誤る。"},
        { "location": "131/TALK"  , "narrator": "千羽鶴", "text": "その為に、ここでもまた\n貴方の力が必要になる。"},
        { "location": "132/TALK"  , "narrator": "千羽鶴", "text": "この世界を俯瞰して見る\n事ができる、貴方の力が\n必要不可欠。"},
        { "location": "133/SEL"   , "narrator": "", "text": "なるほど"},
        { "location": "134/SEL"   , "narrator": "", "text": "質問があります"},
        { "location": "135/ACT"   , "narrator": "", "text": "なるほど"},
        { "location": "136/ACT"   , "narrator": "", "text": "質問があります"},
        { "location": "137/TALK"  , "narrator": "千羽鶴", "text": "どうぞ。"},
        { "location": "139/SEL"   , "narrator": "", "text": "結局$me$に期待することは、彼女の判断を正しい方へ誘導すること？"},
        { "location": "140/SEL"   , "narrator": "", "text": "俯瞰出来る力ってなに？"},
        { "location": "141/SEL"   , "narrator": "", "text": "$me$は期待に添えてるの？"},
        { "location": "142/SEL"   , "narrator": "", "text": "千羽鶴は本当にどういう存在なの？"},
        { "location": "143/SEL"   , "narrator": "", "text": "特にない \n<color=blue>（※先へ進みます）</color>"},
        { "location": "144/ACT"   , "narrator": "", "text": "結局$me$に期待することは、彼女の判断を正しい方へ誘導すること？"},
        { "location": "145/TALK"  , "narrator": "千羽鶴", "text": "１つにおいては\nそういうことになる。"},
        { "location": "146/TALK"  , "narrator": "千羽鶴", "text": "それは結果として\n彼女にとっての幸せと、\n世界の安寧へ繋がる。"},
        { "location": "147/SEL"   , "narrator": "", "text": "じゃあ、愛を育んで欲しいっていうのは、それとは別の理由？"},
        { "location": "148/ACT"   , "narrator": "", "text": "じゃあ、愛を育んで欲しいっていうのは、それとは別の理由？"},
        { "location": "150/TALK"  , "narrator": "千羽鶴", "text": "別ではない。"},
        { "location": "151/TALK"  , "narrator": "千羽鶴", "text": "彼女のココロを支える\nこともまた、彼女と世界の\n安寧にとって重要なこと。"},
        { "location": "153/TALK"  , "narrator": "千羽鶴", "text": "今はわからなくても、\nいずれわかるときが\n来ると思う。"},
        { "location": "154/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "156/ACT"   , "narrator": "", "text": "俯瞰出来る力ってなに？"},
        { "location": "157/TALK"  , "narrator": "千羽鶴", "text": "私たちの世界を客観的に\n見ることが出来る力。"},
        { "location": "158/TALK"  , "narrator": "千羽鶴", "text": "もっとわかりやすい\n言い方をするならば、\n時間軸に囚われない力。"},
        { "location": "159/TALK"  , "narrator": "千羽鶴", "text": "貴方はこのOSを介して、\nこちらの世界に\n介入している。"},
        { "location": "160/TALK"  , "narrator": "千羽鶴", "text": "その際に貴方は、\n限定的ではあれ\n時間を超越できる。"},
        { "location": "161/TALK"  , "narrator": "千羽鶴", "text": "簡単な一例を挙げると、\n同じエピソードを何度も\n体験することができ――"},
        { "location": "162/TALK"  , "narrator": "千羽鶴", "text": "毎回その体験を\n変えることすらできる。"},
        { "location": "163/TALK"  , "narrator": "千羽鶴", "text": "これがどれくらい\n強い力なのか、\n考えてみて欲しい。"},
        { "location": "164/TALK"  , "narrator": "千羽鶴", "text": "貴方が自分の世界で\nそれと同じ事ができたら、\n貴方の人生はどうなる？"},
        { "location": "165/TALK"  , "narrator": "千羽鶴", "text": "一流のエリートコースも\n億万長者になることも、\n簡単でしょうね。"},
        { "location": "166/TALK"  , "narrator": "千羽鶴", "text": "貴方の人生の一部を\n根気よく周回すれば、\nいずれは叶うのだから。"},
        { "location": "167/TALK"  , "narrator": "千羽鶴", "text": "もちろん、貴方の世界の\n誰もがその力を持って\nいたら話は別だけど。"},
        { "location": "168/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "170/ACT"   , "narrator": "", "text": "$me$は期待に添えてるの？"},
        { "location": "171/TALK"  , "narrator": "千羽鶴", "text": "ええ。"},
        { "location": "172/TALK"  , "narrator": "千羽鶴", "text": "ここまでは\n非常に順調といえる。"},
        { "location": "173/TALK"  , "narrator": "千羽鶴", "text": "貴方は彼女たちを\n的確に導いてくれていると\n思ってる。"},
        { "location": "174/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "176/ACT"   , "narrator": "", "text": "千羽鶴は本当にどういう存在なの？"},
        { "location": "177/TALK"  , "narrator": "千羽鶴", "text": "そうね。"},
        { "location": "178/TALK"  , "narrator": "千羽鶴", "text": "そろそろ少しは\n私の話もしなければ\nならない時期かも。"},
        { "location": "179/TALK"  , "narrator": "千羽鶴", "text": "簡単にいうと――"},
        { "location": "180/TALK"  , "narrator": "千羽鶴", "text": "私は、この世界から\n相対的に未来と言える\n世界を知り得る存在。"},
        { "location": "181/SEL"   , "narrator": "", "text": "簡単…ですか？"},
        { "location": "182/ACT"   , "narrator": "", "text": "簡単…ですか？"},
        { "location": "184/TALK"  , "narrator": "千羽鶴", "text": "ええ。"},
        { "location": "185/TALK"  , "narrator": "千羽鶴", "text": "今言える範囲で、\n最大限に簡単な言い方を\nすると、こうなる。"},
        { "location": "186/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "188/ACT"   , "narrator": "", "text": "特にない \n<color=blue>（※先へ進みます）</color>"},
        { "location": "189/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "195/TALK"  , "narrator": "千羽鶴", "text": "なんにせよ、現時点に\nおいては、世界は理想に\n近い進行をしている。"},
        { "location": "196/TALK"  , "narrator": "千羽鶴", "text": "これも主には貴方のお陰。\nだからお礼を伝えておく。\nありがと。"},
        { "location": "197/SEL"   , "narrator": "", "text": "よかった"},
        { "location": "198/SEL"   , "narrator": "", "text": "お礼に何かちょうだい"},
        { "location": "199/SEL"   , "narrator": "", "text": "お礼に結婚してください"},
        { "location": "200/ACT"   , "narrator": "", "text": "よかった"},
        { "location": "201/TALK"  , "narrator": "千羽鶴", "text": "ええ。ほんとに。\nこの調子でこれからも\nよろしく。"},
        { "location": "202/ACT"   , "narrator": "", "text": "お礼に何かちょうだい"},
        { "location": "203/TALK"  , "narrator": "千羽鶴", "text": "…そうね。"},
        { "location": "204/TALK"  , "narrator": "千羽鶴", "text": "何か考えておく。"},
        { "location": "205/ACT"   , "narrator": "", "text": "お礼に結婚してください"},
        { "location": "206/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "207/TALK"  , "narrator": "千羽鶴", "text": "いずれ――"},
        { "location": "208/TALK"  , "narrator": "千羽鶴", "text": "私が使命を全うする日が\n来たら、その時は不可能\nではないのかもしれない。"},
        { "location": "209/TALK"  , "narrator": "千羽鶴", "text": "でもきっと。"},
        { "location": "210/TALK"  , "narrator": "千羽鶴", "text": "その時貴方は、\nそれを受け入れられない\nのではないかと思ってる。"},
        { "location": "211/TALK"  , "narrator": "千羽鶴", "text": "……んー、でも。"},
        { "location": "212/TALK"  , "narrator": "千羽鶴", "text": "まあ…感性は\n人それぞれだから、\nイケる人もいるのかも。"},
        { "location": "213/TALK"  , "narrator": "千羽鶴", "text": "……。\n私には、そこまでは\nわからない。"},
        { "location": "215/TALK"  , "narrator": "千羽鶴", "text": "それじゃ早速、\n今回も映像記録を\n見ていこうと思う。"},
        { "location": "217/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/67MB 4:18】</color>"},
        { "location": "218/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/22MB 4:18】</color>"},
        { "location": "219/SEL"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "220/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/67MB 4:18】</color>"},
        { "location": "221/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "227/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/22MB 4:18】</color>"},
        { "location": "228/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "234/ACT"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "235/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "268/TALK"  , "narrator": "千羽鶴", "text": "というわけで、\n今回も素敵な海回だった。"},
        { "location": "269/TALK"  , "narrator": "千羽鶴", "text": "感想は？"},
        { "location": "271/SEL"   , "narrator": "", "text": "歌のことを教えて！"},
        { "location": "272/SEL"   , "narrator": "", "text": "確かに幸せのパンツだった"},
        { "location": "273/SEL"   , "narrator": "", "text": "みんながはしゃいでるのが眩しかった"},
        { "location": "274/SEL"   , "narrator": "", "text": "特にない \n<color=blue>（※先へ進みます）</color>"},
        { "location": "275/ACT"   , "narrator": "", "text": "歌のことを教えて！"},
        { "location": "276/TALK"  , "narrator": "千羽鶴", "text": "アースタシア。\nEarthtasiaと書く。"},
        { "location": "277/TALK"  , "narrator": "千羽鶴", "text": "本当はとっても長い\nサブタイトルもあるけど\n面倒だから割愛。"},
        { "location": "278/TALK"  , "narrator": "千羽鶴", "text": "FreyMENOWのデビュー\nアルバム「イシュリール」\nのラストから2曲目。"},
        { "location": "279/TALK"  , "narrator": "千羽鶴", "text": "母を助けるため、\n主人公のカレンが\n想いを込めて歌う唄。"},
        { "location": "280/TALK"  , "narrator": "千羽鶴", "text": "この後物語は\n大団円へと向かっていく。"},
        { "location": "281/TALK"  , "narrator": "千羽鶴", "text": "だからこの曲は、\nアルバムの中で最も\n重要な曲となっている。"},
        { "location": "282/TALK"  , "narrator": "千羽鶴", "text": "逢瀬つばめは\nこの曲がFreyMENOWの\n中で一番好きなのだとか。"},
        { "location": "283/SEL"   , "narrator": "", "text": "いい曲。配信まだー？"},
        { "location": "284/SEL"   , "narrator": "", "text": "あまり好きじゃない"},
        { "location": "285/ACT"   , "narrator": "", "text": "いい曲。配信まだー？"},
        { "location": "286/TALK"  , "narrator": "千羽鶴", "text": "わからない。"},
        { "location": "287/TALK"  , "narrator": "千羽鶴", "text": "私は貴方の世界における\n商業的活動には殆ど\n関与していないから。"},
        { "location": "288/TALK"  , "narrator": "千羽鶴", "text": "けど、貴方たちが望めば\nそれもまた叶う。"},
        { "location": "289/ACT"   , "narrator": "", "text": "あまり好きじゃない"},
        { "location": "290/TALK"  , "narrator": "千羽鶴", "text": "そう。\nわたしと同じね。"},
        { "location": "291/TALK"  , "narrator": "千羽鶴", "text": "唄でセカイは救われない。"},
        { "location": "292/TALK"  , "narrator": "千羽鶴", "text": "百歩譲って\n唄でセカイを救う方法が\nあるとするならば――"},
        { "location": "293/TALK"  , "narrator": "千羽鶴", "text": "その唄の売上を\nチャリティーに回すとか。"},
        { "location": "294/TALK"  , "narrator": "千羽鶴", "text": "歌を聴いて希望に満ち\nあふれた若者に頑張って\n働いてもらうとか。"},
        { "location": "295/TALK"  , "narrator": "千羽鶴", "text": "そんなくらい。"},
        { "location": "296/SEL"   , "narrator": "", "text": "奇跡は信じないの？"},
        { "location": "297/SEL"   , "narrator": "", "text": "現実主義者なんだね"},
        { "location": "298/ACT"   , "narrator": "", "text": "奇跡は信じないの？"},
        { "location": "299/TALK"  , "narrator": "千羽鶴", "text": "全ては因果律によって\n繋がっている。"},
        { "location": "300/TALK"  , "narrator": "千羽鶴", "text": "それはあたかも\nブラウン運動のように。"},
        { "location": "301/TALK"  , "narrator": "千羽鶴", "text": "ホワイトノイズのような\n予測不能な事態は\n発生しない。"},
        { "location": "302/TALK"  , "narrator": "千羽鶴", "text": "もちろん、\n驚くような、目覚ましい\n成果というものはある。"},
        { "location": "303/TALK"  , "narrator": "千羽鶴", "text": "けど、それも全て\n有から有が生まれただけ。"},
        { "location": "304/TALK"  , "narrator": "千羽鶴", "text": "無から有は生まれない。"},
        { "location": "305/ACT"   , "narrator": "", "text": "現実主義者なんだね"},
        { "location": "306/TALK"  , "narrator": "千羽鶴", "text": "何を今更。"},
        { "location": "309/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "311/ACT"   , "narrator": "", "text": "確かに幸せのパンツだった"},
        { "location": "312/TALK"  , "narrator": "千羽鶴", "text": "もちろん。"},
        { "location": "313/TALK"  , "narrator": "千羽鶴", "text": "もしかして、タイトルは\n適当に決めてると\n思っていたりしてる？"},
        { "location": "314/SEL"   , "narrator": "", "text": "え！？\nちがったの？"},
        { "location": "315/SEL"   , "narrator": "", "text": "思ってませんよ！"},
        { "location": "316/ACT"   , "narrator": "", "text": "え！？\nちがったの？"},
        { "location": "317/TALK"  , "narrator": "千羽鶴", "text": "失礼にも程がある。"},
        { "location": "318/ACT"   , "narrator": "", "text": "思ってませんよ！"},
        { "location": "319/TALK"  , "narrator": "千羽鶴", "text": "そう。よかった。"},
        { "location": "321/TALK"  , "narrator": "千羽鶴", "text": "エピソードタイトルは\nちゃんとその物語を\n示唆するものにしてる。"},
        { "location": "322/TALK"  , "narrator": "千羽鶴", "text": "だから、そういう観点から\n改めてタイトルを見ると、\n新しい発見があるかも。"},
        { "location": "323/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "325/ACT"   , "narrator": "", "text": "みんながはしゃいでるのが眩しかった"},
        { "location": "326/TALK"  , "narrator": "千羽鶴", "text": "そうね。"},
        { "location": "327/TALK"  , "narrator": "千羽鶴", "text": "でももしかすると、今が\n彼女たちの最後の笑顔\nかもしれない。"},
        { "location": "328/SEL"   , "narrator": "", "text": "どういうこと！？"},
        { "location": "329/ACT"   , "narrator": "", "text": "どういうこと！？"},
        { "location": "331/TALK"  , "narrator": "千羽鶴", "text": "なんて。"},
        { "location": "332/TALK"  , "narrator": "千羽鶴", "text": "びっくりした？"},
        { "location": "333/SEL"   , "narrator": "", "text": "またか…"},
        { "location": "334/SEL"   , "narrator": "", "text": "ビックリした"},
        { "location": "335/ACT"   , "narrator": "", "text": "またか…"},
        { "location": "336/TALK"  , "narrator": "千羽鶴", "text": "呆れてる？"},
        { "location": "337/TALK"  , "narrator": "千羽鶴", "text": "まあでも、それも\n仕方のないこと。"},
        { "location": "338/TALK"  , "narrator": "千羽鶴", "text": "こうした根拠の無い脅しを\n私はやりすぎた。"},
        { "location": "339/TALK"  , "narrator": "千羽鶴", "text": "だから、貴方のその反応は\n当然のものだと思う。"},
        { "location": "340/ACT"   , "narrator": "", "text": "ビックリした"},
        { "location": "341/TALK"  , "narrator": "千羽鶴", "text": "ありがと。\n仕掛け人として\nとても嬉しい。"},
        { "location": "343/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "345/ACT"   , "narrator": "", "text": "特にない \n<color=blue>（※先へ進みます）</color>"},
        { "location": "346/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "353/TALK"  , "narrator": "千羽鶴", "text": "さて、今回の\n逢瀬つばめだけど。"},
        { "location": "354/TALK"  , "narrator": "千羽鶴", "text": "合宿半ば頃に\nフォーカスを当てる。"},
        { "location": "355/TALK"  , "narrator": "千羽鶴", "text": "場面は彼女と\nクラスメイトとの\n別れ際について。"},
        { "location": "356/TALK"  , "narrator": "千羽鶴", "text": "クラスメイト達は\n合宿前半で東京に戻る事が\n決まっている。"},
        { "location": "357/TALK"  , "narrator": "千羽鶴", "text": "そしてその去り際に、\n逢瀬つばめが関わることは\n今後にとって重要になる。"},
        { "location": "358/TALK"  , "narrator": "千羽鶴", "text": "貴方は彼女が後悔しない\nように、彼女を導いて\nあげてほしい。"},
        { "location": "359/TALK"  , "narrator": "千羽鶴", "text": "健闘を祈ってる。"},
        { "location": "363/TALK"  , "narrator": "千羽鶴", "text": "さて、今回の\n國政綾水だけど。"},
        { "location": "364/TALK"  , "narrator": "千羽鶴", "text": "合宿が始まって３日程度\n経過した頃にスポットを\n当ててみる。"},
        { "location": "365/TALK"  , "narrator": "千羽鶴", "text": "合宿といえば\n夜の楽しみはつきもの。"},
        { "location": "366/TALK"  , "narrator": "千羽鶴", "text": "けど、彼女たちは\n遊びに来たわけではない。"},
        { "location": "367/TALK"  , "narrator": "千羽鶴", "text": "夜遅くまで起きていれば\n翌日の訓練や健康に\n悪影響を与えてしまう。"},
        { "location": "368/TALK"  , "narrator": "千羽鶴", "text": "國政綾水はそのことで\n若干の心の揺れがある。"},
        { "location": "369/TALK"  , "narrator": "千羽鶴", "text": "それを整理し、彼女の\n持っていきたい理想の\n合宿像に導いて欲しい。"},
        { "location": "370/TALK"  , "narrator": "千羽鶴", "text": "健闘を祈ってる。"},
        { "location": "374/TALK"  , "narrator": "千羽鶴", "text": "さて、今回の\nガブリエラだけど。"},
        { "location": "375/TALK"  , "narrator": "千羽鶴", "text": "合宿中のとある自由時間、\nレクリエーションの最中に\nスポットを当ててみる。"},
        { "location": "376/TALK"  , "narrator": "千羽鶴", "text": "それ自体は洞窟探検という\nシンプルなものだけど、\nそこで彼女は葛藤する。"},
        { "location": "377/TALK"  , "narrator": "千羽鶴", "text": "そしてその些細な葛藤は、\n判断次第では、後に大きな\n悩みに発展してしまう。"},
        { "location": "378/TALK"  , "narrator": "千羽鶴", "text": "そうならないように、\n彼女が間違った判断を\nしないよう導いて欲しい。"},
        { "location": "379/TALK"  , "narrator": "千羽鶴", "text": "未来が見えない中では\nなかなか難しいかも\nしれないけど――"},
        { "location": "380/TALK"  , "narrator": "千羽鶴", "text": "最善の方法は、\nその問題が起こりえない\n選択へと導くこと。"},
        { "location": "381/TALK"  , "narrator": "千羽鶴", "text": "それが私にできる\n一番のアドバイスかも\nしれない。"},
        { "location": "382/TALK"  , "narrator": "千羽鶴", "text": "健闘を祈ってる。"},
        { "location": "386/TALK"  , "narrator": "千羽鶴", "text": "さて、今回の\n恋ヶ崎みやびだけど。"},
        { "location": "387/TALK"  , "narrator": "千羽鶴", "text": "合宿中の一幕に\nスポットを当てる。"},
        { "location": "388/TALK"  , "narrator": "千羽鶴", "text": "合宿訓練は彼女たちの\n気力もかなり消耗する。"},
        { "location": "389/TALK"  , "narrator": "千羽鶴", "text": "そんな中で唯一、精神的に\n彼女たちを助けられるのは\n恋ヶ崎みやびただ一人。"},
        { "location": "390/TALK"  , "narrator": "千羽鶴", "text": "彼女の破天荒な判断と\n行動は、時に周囲に大きな\nプラスを生み出す。"},
        { "location": "391/TALK"  , "narrator": "千羽鶴", "text": "今回はまさにその影響を\n使って、彼女たちの精神\n消耗を回復して欲しい。"},
        { "location": "392/TALK"  , "narrator": "千羽鶴", "text": "難しい事を言ってるように\n思うかもしれないけど――"},
        { "location": "393/TALK"  , "narrator": "千羽鶴", "text": "単に彼女が\n本当にしたいことを\nさせてあげるだけでいい。"},
        { "location": "394/TALK"  , "narrator": "千羽鶴", "text": "健闘を祈ってる。"},
        { "location": "245/DIALOG", "narrator": "Tutorial/Dialog_Anime1", "text": "$dialog_word$"},
        { "location": "247/DIALOG", "narrator": "Tutorial/Dialog_Anime2", "text": "$dialog_word$"},
        { "location": "249/DIALOG", "narrator": "Tutorial/Dialog_Anime3", "text": "$dialog_word$"},
        { "location": "251/DIALOG", "narrator": "Tutorial/Dialog_Anime4", "text": "$dialog_word$"},
        { "location": "253/DIALOG", "narrator": "Tutorial/Dialog_Anime5", "text": "$dialog_word$"}
    ]
}
