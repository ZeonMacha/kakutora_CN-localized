{
    "dir": "chap01/himegoto/misc_ch05_01_001.js",
    "type": "MainStory",
    "info": {
        "story_id": "1505",
        "cid": "kagura",
        "title": "005 メインストーリー",
        "sub_title": "残業申請していいですか？"
    },
    "entry":
    [
        { "location": "1139/TALK"  , "narrator": "神楽", "text": "$handle$さん"},
        { "location": "1140/TALK"  , "narrator": "神楽", "text": "夜分遅くにすみません。少しお付き合いいただけませんか？"},
        { "location": "1143/SEL"   , "narrator": "", "text": "もちろん"},
        { "location": "1144/SEL"   , "narrator": "", "text": "まあいいけど"},
        { "location": "1145/SEL"   , "narrator": "", "text": "恋人同士になるの！？喜んで！"},
        { "location": "1146/ACT"   , "narrator": "", "text": "もちろん"},
        { "location": "1147/TALK"  , "narrator": "神楽", "text": "ありがとうございます。仕事熱心なんですね"},
        { "location": "1148/ACT"   , "narrator": "", "text": "まあいいけど"},
        { "location": "1149/TALK"  , "narrator": "神楽", "text": "非常識ですみません"},
        { "location": "1150/ACT"   , "narrator": "", "text": "恋人同士になるの！？喜んで！"},
        { "location": "1151/TALK"  , "narrator": "神楽", "text": "えっと、すみません"},
        { "location": "1152/TALK"  , "narrator": "神楽", "text": "誤爆"},
        { "location": "1153/TALK"  , "narrator": "神楽", "text": "誤送信してませんか？"},
        { "location": "1155/TALK"  , "narrator": "神楽", "text": "今日は色々ありがとうございました。"},
        { "location": "1156/TALK"  , "narrator": "神楽", "text": "一応スタンスを聞いておきたいのですが、$handle$さんは私に何をどこまでサポートするように命じられているのでしょうか？"},
        { "location": "1157/TALK"  , "narrator": "神楽", "text": "いわゆるユーザーサポート的なものだと思うのですが、サービス上限を超える依頼などをして後で取り返しつかなくなると困るので"},
        { "location": "1159/SEL"   , "narrator": "", "text": "文字ベースで回答出来る範囲かな"},
        { "location": "1160/SEL"   , "narrator": "", "text": "神楽への愛は無制限だよ"},
        { "location": "1161/ACT"   , "narrator": "", "text": "文字ベースで回答出来る範囲かな"},
        { "location": "1162/TALK"  , "narrator": "神楽", "text": "まあ、そうですよね"},
        { "location": "1163/TALK"  , "narrator": "神楽", "text": "でもその内容ですよ、例えば唐突に恋愛の悩みなんて打ち明けられても困るじゃないですか"},
        { "location": "1164/ACT"   , "narrator": "", "text": "神楽への愛は無制限だよ"},
        { "location": "1166/TALK"  , "narrator": "神楽", "text": "深夜テンションですか？"},
        { "location": "1167/TALK"  , "narrator": "神楽", "text": "そんなこと言ってると明日の朝後悔しますよ？"},
        { "location": "1168/TALK"  , "narrator": "神楽", "text": "私が「じゃあつき合って」とか言い出したら困りますよね？？"},
        { "location": "1171/SEL"   , "narrator": "", "text": "確かに"},
        { "location": "1172/SEL"   , "narrator": "", "text": "何言ってるのバッチオッケーっす！！"},
        { "location": "1173/ACT"   , "narrator": "", "text": "確かに"},
        { "location": "1174/TALK"  , "narrator": "神楽", "text": "ですから、その辺りを明確にしたいと思いまして"},
        { "location": "1175/TALK"  , "narrator": "神楽", "text": "ナビとしての業務範囲をお教えいただけますと幸いです"},
        { "location": "1176/ACT"   , "narrator": "", "text": "何言ってるのバッチオッケーっす！！"},
        { "location": "1178/TALK"  , "narrator": "神楽", "text": "いや、冗談はいいんで。あまり公私混同するようなら担当変えてもらいますよ"},
        { "location": "1179/TALK"  , "narrator": "神楽", "text": "あーでも、外との回線が止められてるのか"},
        { "location": "1180/TALK"  , "narrator": "神楽", "text": "ていうか、あなたは本当にただのナビですか？"},
        { "location": "1183/SEL"   , "narrator": "", "text": "ナビもするけど、神楽を支えるためにいるんだよ"},
        { "location": "1184/ACT"   , "narrator": "", "text": "ナビもするけど、神楽を支えるためにいるんだよ"},
        { "location": "1186/TALK"  , "narrator": "神楽", "text": "支えるですか？"},
        { "location": "1188/TALK"  , "narrator": "神楽", "text": "例えば？"},
        { "location": "1190/SEL"   , "narrator": "", "text": "辛いときに支えるよ"},
        { "location": "1191/SEL"   , "narrator": "", "text": "選択に困ったとき一緒に考えるよ"},
        { "location": "1192/ACT"   , "narrator": "", "text": "辛いときに支えるよ"},
        { "location": "1193/TALK"  , "narrator": "神楽", "text": "ならば無能ですね"},
        { "location": "1194/TALK"  , "narrator": "神楽", "text": "既に辛いです"},
        { "location": "1196/SEL"   , "narrator": "", "text": "ごめんね…"},
        { "location": "1197/SEL"   , "narrator": "", "text": "まだ初日だしね、最初なんてそんなモノでしょ？"},
        { "location": "1198/ACT"   , "narrator": "", "text": "ごめんね…"},
        { "location": "1199/TALK"  , "narrator": "神楽", "text": "そこで凹まれても"},
        { "location": "1200/TALK"  , "narrator": "神楽", "text": "どっちが支える立場なんですか"},
        { "location": "1201/ACT"   , "narrator": "", "text": "まだ初日だしね、最初なんてそんなモノでしょ？"},
        { "location": "1202/TALK"  , "narrator": "神楽", "text": "まあ、確かにそうですね"},
        { "location": "1203/TALK"  , "narrator": "神楽", "text": "そもそも私に危害を加えるようなものを彼らが"},
        { "location": "1205/TALK"  , "narrator": "神楽", "text": "それはわからないか"},
        { "location": "1206/TALK"  , "narrator": "神楽", "text": "では当面よろしくお願いします"},
        { "location": "1209/SEL"   , "narrator": "", "text": "頑張ります"},
        { "location": "1210/ACT"   , "narrator": "", "text": "頑張ります"},
        { "location": "1212/TALK"  , "narrator": "神楽", "text": "でも、何となくですけど、あまり話すのには抵抗なさそうなので"},
        { "location": "1213/TALK"  , "narrator": "神楽", "text": "異世界間じゃ、何かに発展することも無いでしょうし"},
        { "location": "1214/TALK"  , "narrator": "神楽", "text": "お試し期間で気楽にやってみようかと思いました"},
        { "location": "1215/TALK"  , "narrator": "神楽", "text": "というわけで、お試しで今の悩みを解決してもらってもいいですか？"},
        { "location": "1216/ACT"   , "narrator": "", "text": "選択に困ったとき一緒に考えるよ"},
        { "location": "1218/TALK"  , "narrator": "神楽", "text": "では早速ですけど、今悩んでる事があるんです。解決してください。"},
        { "location": "1221/SEL"   , "narrator": "", "text": "何でも言って！"},
        { "location": "1222/SEL"   , "narrator": "", "text": "まあ、出来ることなら"},
        { "location": "1223/ACT"   , "narrator": "", "text": "何でも言って！"},
        { "location": "1224/TALK"  , "narrator": "神楽", "text": "軽いですね"},
        { "location": "1225/ACT"   , "narrator": "", "text": "まあ、出来ることなら"},
        { "location": "1226/TALK"  , "narrator": "神楽", "text": "現実主義なんですか？"},
        { "location": "1228/TALK"  , "narrator": "神楽", "text": "まあ、大した事じゃないんですけど"},
        { "location": "1229/TALK"  , "narrator": "神楽", "text": "この世界のハイティ"},
        { "location": "1230/TALK"  , "narrator": "神楽", "text": "女子高生のこと、全然わからないんですけど、ひとつだけわかってることがあって"},
        { "location": "1231/TALK"  , "narrator": "神楽", "text": "こんな風な事務的な会話はしないですよね"},
        { "location": "1232/TALK"  , "narrator": "神楽", "text": "どんな会話をすればいいのか、教えてもらえませんか？"},
        { "location": "1234/SEL"   , "narrator": "", "text": "好きな食べ物とか、服とかの会話だよ"},
        { "location": "1235/SEL"   , "narrator": "", "text": "会話そのものが遊びになってるよ"},
        { "location": "1236/ACT"   , "narrator": "", "text": "好きな食べ物とか、服とかの会話だよ"},
        { "location": "1237/TALK"  , "narrator": "神楽", "text": "普通ですよね"},
        { "location": "1238/TALK"  , "narrator": "神楽", "text": "そんなのメモパッドでやりとりすればいいのに"},
        { "location": "1240/SEL"   , "narrator": "", "text": "それじゃ楽しくないじゃん"},
        { "location": "1241/ACT"   , "narrator": "", "text": "それじゃ楽しくないじゃん"},
        { "location": "1243/TALK"  , "narrator": "神楽", "text": "ではWAVEで楽しく食べ物や服の会話をするには？"},
        { "location": "1244/ACT"   , "narrator": "", "text": "会話そのものが遊びになってるよ"},
        { "location": "1245/TALK"  , "narrator": "神楽", "text": "どんな？"},
        { "location": "1248/SEL"   , "narrator": "", "text": "キャラを作ったりするよ"},
        { "location": "1249/SEL"   , "narrator": "", "text": "語尾をヘンな風にしたりする"},
        { "location": "1250/ACT"   , "narrator": "", "text": "キャラを作ったりするよ"},
        { "location": "1251/TALK"  , "narrator": "神楽", "text": "なるほど"},
        { "location": "1252/TALK"  , "narrator": "神楽", "text": "もしかして「にゃんにゃんはにゃんにゃんしちゃうにゃー」みたいなヤツですか？"},
        { "location": "1254/SEL"   , "narrator": "", "text": "だいたい合ってる"},
        { "location": "1255/SEL"   , "narrator": "", "text": "ちょっと古い気がするけど"},
        { "location": "1256/ACT"   , "narrator": "", "text": "だいたい合ってる"},
        { "location": "1257/TALK"  , "narrator": "神楽", "text": "なるほど"},
        { "location": "1258/ACT"   , "narrator": "", "text": "ちょっと古い気がするけど"},
        { "location": "1259/TALK"  , "narrator": "神楽", "text": "時代考証は後でちゃんと調べます。何となくの方向性でいいんです"},
        { "location": "1260/TALK"  , "narrator": "神楽", "text": "まあ、間違ってはいないということですよね"},
        { "location": "1262/ACT"   , "narrator": "", "text": "語尾をヘンな風にしたりする"},
        { "location": "1263/TALK"  , "narrator": "神楽", "text": "「そうだょ」とか「そうだお！」みたいなやつですよね"},
        { "location": "1264/TALK"  , "narrator": "神楽", "text": "なるほど"},
        { "location": "1265/TALK"  , "narrator": "神楽", "text": "割とキャラを作る感じなんですね、流行としては"},
        { "location": "1267/TALK"  , "narrator": "神楽", "text": "何となくですが、感覚が掴めてきた気がします。"},
        { "location": "1268/TALK"  , "narrator": "神楽", "text": "ちょっとキャラの方向で考えてみますね"},
        { "location": "1269/TALK"  , "narrator": "神楽", "text": "夜遅いのに、真摯に答えてくれてありがとうございました！"},
        { "location": "1271/SEL"   , "narrator": "", "text": "どう致しまして"},
        { "location": "1272/SEL"   , "narrator": "", "text": "$me$は24時間体制だから気にしないで！"},
        { "location": "1273/ACT"   , "narrator": "", "text": "どう致しまして"},
        { "location": "1274/TALK"  , "narrator": "神楽", "text": "それじゃ、おやすみなさい"},
        { "location": "1275/ACT"   , "narrator": "", "text": "$me$は24時間体制だから気にしないで！"},
        { "location": "1277/TALK"  , "narrator": "神楽", "text": "仕事熱心なんですね"},
        { "location": "1278/TALK"  , "narrator": "神楽", "text": "って、私もそういう意味では24時間体制ですよね、これ"},
        { "location": "1279/TALK"  , "narrator": "神楽", "text": "お互い大変ですね"},
        { "location": "1280/TALK"  , "narrator": "神楽", "text": "(ﾟ∀ﾟ)人(ﾟ∀ﾟ)ﾅｶｰﾏ"},
        { "location": "1281/TALK"  , "narrator": "神楽", "text": "こんなの見つけました。使い方合ってます？"},
        { "location": "1283/SEL"   , "narrator": "", "text": "合ってるよ！"},
        { "location": "1284/SEL"   , "narrator": "", "text": "ちょっと古いかな！"},
        { "location": "1285/ACT"   , "narrator": "", "text": "合ってるよ！"},
        { "location": "1286/TALK"  , "narrator": "神楽", "text": "よかった♪"},
        { "location": "1287/ACT"   , "narrator": "", "text": "ちょっと古いかな！"},
        { "location": "1288/TALK"  , "narrator": "神楽", "text": "あらら"},
        { "location": "1289/TALK"  , "narrator": "神楽", "text": "参考になります♪"},
        { "location": "1291/TALK"  , "narrator": "神楽", "text": "それじゃこの辺で失礼します"},
        { "location": "1292/TALK"  , "narrator": "神楽", "text": "$handle$さんも、お仕事は程々にして休んでくださいね"},
        { "location": "1294/SEL"   , "narrator": "", "text": "ありがとう"},
        { "location": "1295/SEL"   , "narrator": "", "text": "神楽優しい！"},
        { "location": "1296/ACT"   , "narrator": "", "text": "ありがとう"},
        { "location": "1297/ACT"   , "narrator": "", "text": "神楽優しい！"},
        { "location": "1299/TALK"  , "narrator": "神楽", "text": "また相談乗ってください♪"},
        { "location": "1322/DIALOG", "narrator": "Dialog_chapter_ch05", "text": "【02 PrisMATRIX.】"},
        { "location": "1333/DIALOG", "narrator": "Dialog_chapter_ch05", "text": "【02 PrisMATRIX.】"}
    ]
}
