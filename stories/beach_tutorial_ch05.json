        { "location": "617/SCENARIO", "narrator": "", "text": "TGS神楽"},
        { "location": "634/TALK"    , "narrator": "神楽", "text": "ふふっ…なんだか、\n夢みたいです。"},
        { "location": "635/TALK"    , "narrator": "神楽", "text": "あなたと二人っきりで\n海に来てるなんて…。"},
        { "location": "636/SEL"     , "narrator": "", "text": "楽しそうだね"},
        { "location": "637/ACT"     , "narrator": "", "text": "楽しそうだね"},
        { "location": "639/TALK"    , "narrator": "神楽", "text": "あら？　あなたの方は\n楽しくないんですか？"},
        { "location": "640/SEL"     , "narrator": "", "text": "楽しいに決まってるじゃないか"},
        { "location": "641/SEL"     , "narrator": "", "text": "楽しいっていうか、嬉しい"},
        { "location": "642/ACT"     , "narrator": "", "text": "楽しいに決まってるじゃないか"},
        { "location": "643/TALK"    , "narrator": "神楽", "text": "ふふっ、気が合いますね。"},
        { "location": "645/TALK"    , "narrator": "神楽", "text": "まあ、だからデートを\nするような関係にも\nなれたんでしょうけど…。"},
        { "location": "646/ACT"     , "narrator": "", "text": "楽しいっていうか、嬉しい"},
        { "location": "648/TALK"    , "narrator": "神楽", "text": "…そんな風に言われると、\nなんだか照れちゃいます。"},
        { "location": "649/TALK"    , "narrator": "神楽", "text": "私とのデートを、\nそんなに嬉しいと\n思ってもらえるなんて…。"},
        { "location": "650/TALK"    , "narrator": "神楽", "text": "始まったばかりなのに、\n嬉しくて胸がいっぱいな\n感じです。"},
        { "location": "653/TALK"    , "narrator": "神楽", "text": "でも、まさかこんなに\n静かな海に来るとは\n思いませんでした。"},
        { "location": "654/TALK"    , "narrator": "神楽", "text": "見てくださいよ。\n私たち以外、誰もいない\n貸し切り状態ですよ！"},
        { "location": "655/TALK"    , "narrator": "神楽", "text": "つまり、ここであなたが\n私に何かしたとしても、\n証人がいないんです。"},
        { "location": "656/TALK"    , "narrator": "神楽", "text": "…なんて言ったら、\n変な気起こしそうに\nなっちゃいますか？"},
        { "location": "657/SEL"     , "narrator": "", "text": "神楽が悲しむようなことはしない"},
        { "location": "658/SEL"     , "narrator": "", "text": "ずっとそんな気持ちを抑えてる"},
        { "location": "659/ACT"     , "narrator": "", "text": "神楽が悲しむようなことはしない"},
        { "location": "660/TALK"    , "narrator": "神楽", "text": "…ごめんなさい。\nちょっと、悪ふざけが\n過ぎちゃいましたね。"},
        { "location": "661/TALK"    , "narrator": "神楽", "text": "でも…ちょっとだけ\n誤解してます。"},
        { "location": "662/TALK"    , "narrator": "神楽", "text": "変な気起こしたとしても、\nそれで私が悲しんだりは\nしませんよ。"},
        { "location": "664/TALK"    , "narrator": "神楽", "text": "ふふっ…なんてね。\n冗談なのか本気なのかの\n判断は、お任せします。"},
        { "location": "665/ACT"     , "narrator": "", "text": "ずっとそんな気持ちを抑えてる"},
        { "location": "666/TALK"    , "narrator": "神楽", "text": "そ、そうだったん\nですか！？"},
        { "location": "667/TALK"    , "narrator": "神楽", "text": "…あなたは、そういうこと\n考えるような人じゃないと\n思っていました。"},
        { "location": "668/TALK"    , "narrator": "神楽", "text": "あ、別に悲しんだり\n軽蔑してるわけじゃ\nないんです！"},
        { "location": "670/TALK"    , "narrator": "神楽", "text": "ただ…私に対しても、\nそんな気持ちになって\nくれるんだなぁ、って…。"},
        { "location": "671/TALK"    , "narrator": "神楽", "text": "ちょっと嬉しいな…。\nなんて、思っちゃったり\nして…。"},
        { "location": "673/SEL"     , "narrator": "", "text": "神楽に触りたい"},
        { "location": "674/ACT"     , "narrator": "", "text": "神楽に触りたい"},
        { "location": "676/TALK"    , "narrator": "神楽", "text": "…だ、大胆なんですね。"},
        { "location": "677/TALK"    , "narrator": "神楽", "text": "ふふっ、でも正直に\nお願いしてくれたから、\n許可しちゃいます。"},
        { "location": "696/TALK"    , "narrator": "神楽", "text": "あんっ、ツンツンする\nイタズラしてるの、\n誰ですかぁ？"},
        { "location": "698/TALK"    , "narrator": "神楽", "text": "…こうされるのって、\n嬉しいんですね。"},
        { "location": "704/TALK"    , "narrator": "神楽", "text": "きゃぁっ！？"},
        { "location": "705/TALK"    , "narrator": "神楽", "text": "…今の、事故じゃ\nないですよね？"},
        { "location": "707/TALK"    , "narrator": "神楽", "text": "…誰かのと、\n比べてませんよね？"},
        { "location": "713/TALK"    , "narrator": "神楽", "text": "なんか…お腹の方が、\n胸より恥ずかしいです…。"},
        { "location": "715/TALK"    , "narrator": "神楽", "text": "ひゃわっ！？"},
        { "location": "716/TALK"    , "narrator": "神楽", "text": "お、お腹は弱いんです！\n変な声出ちゃったじゃ\nないですかぁ…。"},
        { "location": "722/TALK"    , "narrator": "神楽", "text": "ふふっ、\n褒めてくれてるんですか？"},
        { "location": "724/TALK"    , "narrator": "神楽", "text": "…こうされるのって、\n嬉しいんですね。"},
        { "location": "730/TALK"    , "narrator": "神楽", "text": "きゃぁっ！？"},
        { "location": "731/TALK"    , "narrator": "神楽", "text": "…今の、事故じゃ\nないですよね？"},
        { "location": "733/TALK"    , "narrator": "神楽", "text": "…誰かのと、\n比べてませんよね？"},
        { "location": "739/TALK"    , "narrator": "神楽", "text": "なんか…お腹の方が、\n胸より恥ずかしいです…。"},
        { "location": "741/TALK"    , "narrator": "神楽", "text": "ひゃわっ！？"},
        { "location": "742/TALK"    , "narrator": "神楽", "text": "お、お腹は弱いんです！\n変な声出ちゃったじゃ\nないですかぁ…。"},
