        { "location": "317/SCENARIO", "narrator": "", "text": "アーヤＭＶ回２"},
        { "location": "332/TALK"    , "narrator": "真幌", "text": "もうこんな時間か…。\nすまんな、遅くまで\n付き合わせて。"},
        { "location": "334/TALK"    , "narrator": "アーヤ", "text": "いえ、報告書の作成も\n職務の内ですから。"},
        { "location": "335/TALK"    , "narrator": "真幌", "text": "そうなんだが…。\nこの時間に一人で\n帰らせるのは――"},
        { "location": "336/TALK"    , "narrator": "真幌", "text": "ちと物騒な気も\nするからな…。\n劇場に泊まってくか？"},
        { "location": "337/TALK"    , "narrator": "アーヤ", "text": "今日はバイクで\n来てるから\n大丈夫ですよ。"},
        { "location": "339/TALK"    , "narrator": "アーヤ", "text": "では、館長。\n私はこれで。"},
        { "location": "341/TALK"    , "narrator": "真幌", "text": "ん、お疲れさん。\nおやすみ。"},
        { "location": "342/TALK"    , "narrator": "アーヤ", "text": "おやすみなさい。"},
        { "location": "352/TALK"    , "narrator": "アーヤ", "text": "ふぅ…疲れた…。"},
        { "location": "353/SEL"     , "narrator": "", "text": "お疲れさま"},
        { "location": "354/TALK"    , "narrator": "アーヤ", "text": "日付が変わる前には\n終わったけど、\nもうこんな時間か…。"},
        { "location": "355/TALK"    , "narrator": "アーヤ", "text": "今から帰っても、\n夕飯の準備する気に\nなれないし――"},
        { "location": "356/TALK"    , "narrator": "アーヤ", "text": "今夜はコンビニで\nすませるしかない\nわね…。"},
        { "location": "358/TALK"    , "narrator": "アーヤ", "text": "…ご飯食べて、\nシャワー浴びたら――"},
        { "location": "359/TALK"    , "narrator": "アーヤ", "text": "今日はさっさと\n寝ちゃおう…。"},
        { "location": "361/ACT"     , "narrator": "", "text": "お疲れさま"},
        { "location": "380/TALK"    , "narrator": "アーヤ", "text": "おつかれ(^^"},
        { "location": "381/TALK"    , "narrator": "アーヤ", "text": "まだ起きてたの？"},
        { "location": "383/SEL"     , "narrator": "", "text": "アーヤを待ってた"},
        { "location": "384/ACT"     , "narrator": "", "text": "アーヤを待ってた"},
        { "location": "386/TALK"    , "narrator": "アーヤ", "text": "そうなの？(*^.^*)"},
        { "location": "387/TALK"    , "narrator": "アーヤ", "text": "今バイトが終わって"},
        { "location": "388/TALK"    , "narrator": "アーヤ", "text": "これから帰るとこ(￣∇￣)"},
        { "location": "389/TALK"    , "narrator": "アーヤ", "text": "もう疲れた"},
        { "location": "390/TALK"    , "narrator": "アーヤ", "text": "早く帰って休みたいわ(-.-;)"},
        { "location": "392/SEL"     , "narrator": "", "text": "気分転換に出掛けようよ"},
        { "location": "393/ACT"     , "narrator": "", "text": "気分転換に出掛けようよ"},
        { "location": "395/TALK"    , "narrator": "アーヤ", "text": "工ｴｴｪｪ(´д｀)ｪｪｴｴ工"},
        { "location": "397/TALK"    , "narrator": "アーヤ", "text": "急すぎるから"},
        { "location": "398/TALK"    , "narrator": "アーヤ", "text": "今日は帰るわ(￣Д￣ )"},
        { "location": "400/SEL"     , "narrator": "", "text": "明日も大学？"},
        { "location": "401/SEL"     , "narrator": "", "text": "残念…"},
        { "location": "402/ACT"     , "narrator": "", "text": "明日も大学？"},
        { "location": "403/TALK"    , "narrator": "アーヤ", "text": "午後からね"},
        { "location": "405/SEL"     , "narrator": "", "text": "ならいいじゃん"},
        { "location": "406/ACT"     , "narrator": "", "text": "ならいいじゃん"},
        { "location": "408/TALK"    , "narrator": "アーヤ", "text": "そういう問題じゃないし"},
        { "location": "409/TALK"    , "narrator": "アーヤ", "text": "それに"},
        { "location": "410/TALK"    , "narrator": "アーヤ", "text": "疲れてるの(>_<)"},
        { "location": "412/SEL"     , "narrator": "", "text": "だからこそリフレッシュ"},
        { "location": "413/SEL"     , "narrator": "", "text": "すぐに忘れるよ"},
        { "location": "414/ACT"     , "narrator": "", "text": "だからこそリフレッシュ"},
        { "location": "415/TALK"    , "narrator": "アーヤ", "text": "リフレッシュなら"},
        { "location": "417/TALK"    , "narrator": "アーヤ", "text": "帰ってお風呂に入るし"},
        { "location": "418/TALK"    , "narrator": "アーヤ", "text": "お出かけはまた今度ね(^ε^)-☆!!"},
        { "location": "429/TALK"    , "narrator": "アーヤ", "text": "…コンビニ、\nいいお弁当残ってると\nいいな…。"},
        { "location": "431/ACT"     , "narrator": "", "text": "すぐに忘れるよ"},
        { "location": "432/TALK"    , "narrator": "アーヤ", "text": "まあ"},
        { "location": "433/TALK"    , "narrator": "アーヤ", "text": "バイク乗ってると"},
        { "location": "434/TALK"    , "narrator": "アーヤ", "text": "忘れられそうだけど(｡-_-｡)"},
        { "location": "435/TALK"    , "narrator": "アーヤ", "text": "さすがに"},
        { "location": "436/TALK"    , "narrator": "アーヤ", "text": "急すぎるわ(´o｀；"},
        { "location": "438/SEL"     , "narrator": "", "text": "急な方が楽しいでしょ？"},
        { "location": "439/SEL"     , "narrator": "", "text": "計画立ててからがいいかな？"},
        { "location": "440/ACT"     , "narrator": "", "text": "急な方が楽しいでしょ？"},
        { "location": "442/TALK"    , "narrator": "アーヤ", "text": "そうね"},
        { "location": "443/TALK"    , "narrator": "アーヤ", "text": "確かに"},
        { "location": "444/TALK"    , "narrator": "アーヤ", "text": "その方が楽しいかも(￣∇￣)"},
        { "location": "445/TALK"    , "narrator": "アーヤ", "text": "わかったわ"},
        { "location": "447/TALK"    , "narrator": "アーヤ", "text": "それじゃ"},
        { "location": "448/TALK"    , "narrator": "アーヤ", "text": "夜のツーリングに付き合ってくれる？(^^"},
        { "location": "450/SEL"     , "narrator": "", "text": "喜んで！"},
        { "location": "451/ACT"     , "narrator": "", "text": "喜んで！"},
        { "location": "453/TALK"    , "narrator": "アーヤ", "text": "決まりね(*^o^*)"},
        { "location": "464/TALK"    , "narrator": "アーヤ", "text": "…それじゃあ、\n夜景でも見に行こう\nかしら。"},
        { "location": "479/TALK"    , "narrator": "アーヤ", "text": "…綺麗。"},
        { "location": "480/TALK"    , "narrator": "アーヤ", "text": "レインボーブリッジは\nやっぱり夜見てこそ\nよね。"},
        { "location": "482/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "483/TALK"    , "narrator": "アーヤ", "text": "来てよかった。"},
        { "location": "484/SEL"     , "narrator": "", "text": "楽しんでる？"},
        { "location": "485/ACT"     , "narrator": "", "text": "楽しんでる？"},
        { "location": "505/TALK"    , "narrator": "アーヤ", "text": "まあね(^^"},
        { "location": "506/TALK"    , "narrator": "アーヤ", "text": "元々"},
        { "location": "507/TALK"    , "narrator": "アーヤ", "text": "夜のツーリングは好きだし"},
        { "location": "508/TALK"    , "narrator": "アーヤ", "text": "時々やってるの(￣∇￣)"},
        { "location": "510/SEL"     , "narrator": "", "text": "そうだったの？"},
        { "location": "511/ACT"     , "narrator": "", "text": "そうだったの？"},
        { "location": "513/TALK"    , "narrator": "アーヤ", "text": "夜景見ながら走るの"},
        { "location": "514/TALK"    , "narrator": "アーヤ", "text": "好きなのよ(*^.^*)"},
        { "location": "517/TALK"    , "narrator": "アーヤ", "text": "まだ眠くない？( ・_・)σﾞ"},
        { "location": "519/SEL"     , "narrator": "", "text": "平気"},
        { "location": "520/ACT"     , "narrator": "", "text": "平気"},
        { "location": "522/TALK"    , "narrator": "アーヤ", "text": "じゃあ"},
        { "location": "523/TALK"    , "narrator": "アーヤ", "text": "もう少し付き合って(^^"},
        { "location": "534/TALK"    , "narrator": "アーヤ", "text": "…さてと、次はどこ\n行こうかしら？"},
        { "location": "547/TALK"    , "narrator": "アーヤ", "text": "…さすがの秋葉原も、\nこの時間になると\n静かね。"},
        { "location": "548/TALK"    , "narrator": "アーヤ", "text": "人通りも少ないし、\nお店もほとんど\n閉まってるし…。"},
        { "location": "549/TALK"    , "narrator": "アーヤ", "text": "…みんな見たこと\nないと思うし――"},
        { "location": "550/TALK"    , "narrator": "アーヤ", "text": "ＷＡＶＥで写真\n送ろうかしら？"},
        { "location": "551/SEL"     , "narrator": "", "text": "秋葉原に来たの？"},
        { "location": "552/ACT"     , "narrator": "", "text": "秋葉原に来たの？"},
        { "location": "571/TALK"    , "narrator": "アーヤ", "text": "ええ"},
        { "location": "572/TALK"    , "narrator": "アーヤ", "text": "ちょっと"},
        { "location": "573/TALK"    , "narrator": "アーヤ", "text": "行きたいところがあって(￣∇￣)"},
        { "location": "574/TALK"    , "narrator": "アーヤ", "text": "その通り道だから"},
        { "location": "575/TALK"    , "narrator": "アーヤ", "text": "ちょっと寄り道"},
        { "location": "577/SEL"     , "narrator": "", "text": "もうだいぶ遅いでしょ？"},
        { "location": "578/ACT"     , "narrator": "", "text": "もうだいぶ遅いでしょ？"},
        { "location": "580/TALK"    , "narrator": "アーヤ", "text": "もうすぐ２時（；￢＿￢）"},
        { "location": "582/TALK"    , "narrator": "アーヤ", "text": "でも"},
        { "location": "583/TALK"    , "narrator": "アーヤ", "text": "夜はまだまだこれから＼(^O^)／"},
        { "location": "584/TALK"    , "narrator": "アーヤ", "text": "せっかく出てきたんだし"},
        { "location": "585/TALK"    , "narrator": "アーヤ", "text": "満足するまで走るから(=^0^=)"},
        { "location": "587/SEL"     , "narrator": "", "text": "お付き合いするよ"},
        { "location": "588/ACT"     , "narrator": "", "text": "お付き合いするよ"},
        { "location": "590/TALK"    , "narrator": "アーヤ", "text": "そうこなくちゃ(^ε^)-☆!!"},
        { "location": "592/TALK"    , "narrator": "アーヤ", "text": "じゃあ"},
        { "location": "593/TALK"    , "narrator": "アーヤ", "text": "そろそろ移動するわ"},
        { "location": "604/TALK"    , "narrator": "アーヤ", "text": "っと、その前に…。"},
        { "location": "620/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "621/TALK"    , "narrator": "アーヤ", "text": "ここに来るのも、\nあの時以来か…。"},
        { "location": "623/TALK"    , "narrator": "アーヤ", "text": "…なんか、もうずっと\n前のことみたいに\n感じる。"},
        { "location": "624/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "636/TALK"    , "narrator": "アーヤ", "text": "覚えてる？"},
        { "location": "637/TALK"    , "narrator": "アーヤ", "text": "$handle$と初めて会ったのって"},
        { "location": "638/TALK"    , "narrator": "アーヤ", "text": "出撃で"},
        { "location": "639/TALK"    , "narrator": "アーヤ", "text": "ここに来る途中の電車の中だったの(^^"},
        { "location": "641/SEL"     , "narrator": "", "text": "覚えてるよ"},
        { "location": "642/ACT"     , "narrator": "", "text": "覚えてるよ"},
        { "location": "644/TALK"    , "narrator": "アーヤ", "text": "あの時は"},
        { "location": "645/TALK"    , "narrator": "アーヤ", "text": "ビックリしたわ(´o｀；"},
        { "location": "646/TALK"    , "narrator": "アーヤ", "text": "Ｂｏｔ機能なんて"},
        { "location": "647/TALK"    , "narrator": "アーヤ", "text": "あると思わなかったし"},
        { "location": "650/TALK"    , "narrator": "アーヤ", "text": "でも"},
        { "location": "652/TALK"    , "narrator": "アーヤ", "text": "まさかＢｏｔじゃなくて"},
        { "location": "653/TALK"    , "narrator": "アーヤ", "text": "人間だったとはね(｡-_-｡)"},
        { "location": "655/SEL"     , "narrator": "", "text": "ごめんなさい"},
        { "location": "656/SEL"     , "narrator": "", "text": "怒ってる？"},
        { "location": "657/SEL"     , "narrator": "", "text": "ビックリしたでしょ？"},
        { "location": "658/ACT"     , "narrator": "", "text": "ごめんなさい"},
        { "location": "659/TALK"    , "narrator": "アーヤ", "text": "ううん"},
        { "location": "660/TALK"    , "narrator": "アーヤ", "text": "別にいいから"},
        { "location": "661/TALK"    , "narrator": "アーヤ", "text": "謝らないで(^з^)-☆"},
        { "location": "662/ACT"     , "narrator": "", "text": "怒ってる？"},
        { "location": "663/TALK"    , "narrator": "アーヤ", "text": "怒ってたら"},
        { "location": "664/TALK"    , "narrator": "アーヤ", "text": "こんな風に"},
        { "location": "665/TALK"    , "narrator": "アーヤ", "text": "話したりしないから(>_<)"},
        { "location": "666/ACT"     , "narrator": "", "text": "ビックリしたでしょ？"},
        { "location": "667/TALK"    , "narrator": "アーヤ", "text": "しない方がおかしいから(-ω-;)"},
        { "location": "668/TALK"    , "narrator": "アーヤ", "text": "本当"},
        { "location": "669/TALK"    , "narrator": "アーヤ", "text": "ビックリしたわ"},
        { "location": "671/TALK"    , "narrator": "アーヤ", "text": "あの"},
        { "location": "672/TALK"    , "narrator": "アーヤ", "text": "$handle$って"},
        { "location": "673/TALK"    , "narrator": "アーヤ", "text": "本当に人間よね？( ・_・)σﾞ"},
        { "location": "675/SEL"     , "narrator": "", "text": "まあね"},
        { "location": "676/ACT"     , "narrator": "", "text": "まあね"},
        { "location": "678/TALK"    , "narrator": "アーヤ", "text": "正直"},
        { "location": "679/TALK"    , "narrator": "アーヤ", "text": "今でもちょっと疑わしい(￣Д￣ )"},
        { "location": "680/TALK"    , "narrator": "アーヤ", "text": "ううん"},
        { "location": "681/TALK"    , "narrator": "アーヤ", "text": "人間なのわかってるけど"},
        { "location": "682/TALK"    , "narrator": "アーヤ", "text": "なんか"},
        { "location": "683/TALK"    , "narrator": "アーヤ", "text": "時々それ忘れる(>_<)"},
        { "location": "685/TALK"    , "narrator": "アーヤ", "text": "こうやって"},
        { "location": "686/TALK"    , "narrator": "アーヤ", "text": "文字でばかり話すから(￣Д￣ )"},
        { "location": "688/SEL"     , "narrator": "", "text": "信じられない？"},
        { "location": "689/ACT"     , "narrator": "", "text": "信じられない？"},
        { "location": "692/TALK"    , "narrator": "アーヤ", "text": "私ね"},
        { "location": "693/TALK"    , "narrator": "アーヤ", "text": "最初は$handle$のこと"},
        { "location": "694/TALK"    , "narrator": "アーヤ", "text": "凄く警戒してた"},
        { "location": "695/TALK"    , "narrator": "アーヤ", "text": "だって"},
        { "location": "696/TALK"    , "narrator": "アーヤ", "text": "よくわからなかったし"},
        { "location": "697/TALK"    , "narrator": "アーヤ", "text": "でも"},
        { "location": "698/TALK"    , "narrator": "アーヤ", "text": "今は違う"},
        { "location": "699/TALK"    , "narrator": "アーヤ", "text": "いい人ってわかったし(^^"},
        { "location": "701/TALK"    , "narrator": "アーヤ", "text": "それに"},
        { "location": "702/TALK"    , "narrator": "アーヤ", "text": "私を気遣ってくれるし(・・。)ゞ"},
        { "location": "706/TALK"    , "narrator": "アーヤ", "text": "周りが年下ばかりだから"},
        { "location": "707/TALK"    , "narrator": "アーヤ", "text": "$handle$にしか"},
        { "location": "708/TALK"    , "narrator": "アーヤ", "text": "そういう扱いされないから"},
        { "location": "709/TALK"    , "narrator": "アーヤ", "text": "結構信頼してる(*^.^*)"},
        { "location": "710/TALK"    , "narrator": "アーヤ", "text": "これ"},
        { "location": "711/TALK"    , "narrator": "アーヤ", "text": "質問の答えになってる？( ・_・)σﾞ"},
        { "location": "713/SEL"     , "narrator": "", "text": "十分すぎるくらいだよ"},
        { "location": "714/ACT"     , "narrator": "", "text": "十分すぎるくらいだよ"},
        { "location": "716/TALK"    , "narrator": "アーヤ", "text": "よかった(*^^*)"},
        { "location": "718/TALK"    , "narrator": "アーヤ", "text": "実はね"},
        { "location": "719/TALK"    , "narrator": "アーヤ", "text": "これ言いたくて"},
        { "location": "720/TALK"    , "narrator": "アーヤ", "text": "ここに来たの(・・。)ゞ"},
        { "location": "722/SEL"     , "narrator": "", "text": "そうだったの？"},
        { "location": "723/ACT"     , "narrator": "", "text": "そうだったの？"},
        { "location": "726/TALK"    , "narrator": "アーヤ", "text": "うん"},
        { "location": "727/TALK"    , "narrator": "アーヤ", "text": "照れくさかったから(*ﾉ∀`*) "},
        { "location": "728/TALK"    , "narrator": "アーヤ", "text": "この場所に"},
        { "location": "729/TALK"    , "narrator": "アーヤ", "text": "助けてもらおうと思って"},
        { "location": "730/TALK"    , "narrator": "アーヤ", "text": "でも"},
        { "location": "731/TALK"    , "narrator": "アーヤ", "text": "やっぱり照れくさいけど(｡-_-｡)"},
        { "location": "733/SEL"     , "narrator": "", "text": "嬉しいよ、ありがとう"},
        { "location": "734/ACT"     , "narrator": "", "text": "嬉しいよ、ありがとう"},
        { "location": "737/TALK"    , "narrator": "アーヤ", "text": "(￣∇￣*)ゞ"},
        { "location": "738/TALK"    , "narrator": "アーヤ", "text": "これからも"},
        { "location": "739/TALK"    , "narrator": "アーヤ", "text": "お付き合いよろしくね"},
        { "location": "751/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "752/TALK"    , "narrator": "アーヤ", "text": "さて、と。\nもうひとっ走りして\nこよう。"},
        { "location": "767/TALK"    , "narrator": "つばめ", "text": "おはよ、ガブちゃん。"},
        { "location": "769/TALK"    , "narrator": "ガブリエラ", "text": "おはよ…。\nねえ、アーヤから\n連絡あった？"},
        { "location": "770/TALK"    , "narrator": "つばめ", "text": "え？　無いけど…、\nどうして？"},
        { "location": "771/TALK"    , "narrator": "ガブリエラ", "text": "昨日、劇場から\n帰ってきてない\nみたいなのよ。"},
        { "location": "773/TALK"    , "narrator": "ガブリエラ", "text": "ほら、バイクも\nないでしょ？"},
        { "location": "775/TALK"    , "narrator": "つばめ", "text": "本当だ…。\n昨日は誰も宿直じゃ\nなかったはずだし…。"},
        { "location": "777/TALK"    , "narrator": "ガブリエラ", "text": "どこ行ったのかしら？\nまったく…。"},
        { "location": "781/TALK"    , "narrator": "ガブリエラ", "text": "この音は…。"},
        { "location": "786/TALK"    , "narrator": "アーヤ", "text": "ふぅ…。"},
        { "location": "790/TALK"    , "narrator": "つばめ", "text": "アーヤさん！"},
        { "location": "793/TALK"    , "narrator": "アーヤ", "text": "あら、二人とも\nおはよう。\n今から学校？"},
        { "location": "794/TALK"    , "narrator": "つばめ", "text": "あ、はい…。\nアーヤさんは？"},
        { "location": "795/TALK"    , "narrator": "アーヤ", "text": "見てのとおり、\n今帰ったところよ。"},
        { "location": "797/TALK"    , "narrator": "ガブリエラ", "text": "一晩中どこ行ってた\nのよ？"},
        { "location": "799/TALK"    , "narrator": "アーヤ", "text": "どこって…あちこち\n走ってたから、\n話せば長くなるわ。"},
        { "location": "801/TALK"    , "narrator": "つばめ", "text": "一晩中！？"},
        { "location": "803/TALK"    , "narrator": "アーヤ", "text": "ええ。やっぱり、\n夜のツーリングは\n楽しいわ。"},
        { "location": "806/TALK"    , "narrator": "ガブリエラ", "text": "…まあ、そんなこと\nだろうとは思った\nけど。"},
        { "location": "807/TALK"    , "narrator": "ガブリエラ", "text": "そんなんで、\n大学の講義\nちゃんと聞けるの？"},
        { "location": "808/TALK"    , "narrator": "アーヤ", "text": "平気よ。\n今日は午後から\nだから――"},
        { "location": "809/TALK"    , "narrator": "アーヤ", "text": "とりあえずシャワー\n浴びて、時間までは\n仮眠もとるし。"},
        { "location": "811/TALK"    , "narrator": "アーヤ", "text": "そういうわけだから、\nまた夕方に劇場でね。"},
        { "location": "815/TALK"    , "narrator": "ガブリエラ", "text": "…一晩中走ってた\nようには見えなかった\nわね…。"},
        { "location": "816/TALK"    , "narrator": "つばめ", "text": "うん…アーヤさん、\nほんとパワフル\nだなぁ…。"},
        { "location": "818/TALK"    , "narrator": "ガブリエラ", "text": "体育系だし、無駄に\n体力有り余ってる\nだけよ。"},
        { "location": "819/TALK"    , "narrator": "ガブリエラ", "text": "それより、急がないと\n遅刻するわよ。"},
        { "location": "822/TALK"    , "narrator": "つばめ", "text": "あ、ガブちゃん\n待ってー！"},
        { "location": "823/ACT"     , "narrator": "", "text": "残念…"},
        { "location": "824/TALK"    , "narrator": "アーヤ", "text": "出かけるのは"},
        { "location": "825/TALK"    , "narrator": "アーヤ", "text": "また今度ね(￣∇￣)"},
        { "location": "836/TALK"    , "narrator": "アーヤ", "text": "…コンビニ、\nいいお弁当残ってると\nいいな…。"},
        { "location": "845/ACT"     , "narrator": "", "text": "計画立ててからがいいかな？"},
        { "location": "846/TALK"    , "narrator": "アーヤ", "text": "そうね(｡-_-｡)"},
        { "location": "847/TALK"    , "narrator": "アーヤ", "text": "せっかく出かけるなら"},
        { "location": "848/TALK"    , "narrator": "アーヤ", "text": "そっちの方がいいし(￣Д￣ )"},
        { "location": "849/TALK"    , "narrator": "アーヤ", "text": "だから"},
        { "location": "850/TALK"    , "narrator": "アーヤ", "text": "出かけるのは"},
        { "location": "851/TALK"    , "narrator": "アーヤ", "text": "また今度ね(￣∇￣)"},
        { "location": "862/TALK"    , "narrator": "アーヤ", "text": "…コンビニ、\nいいお弁当残ってると\nいいな…。"},
        { "location": "325/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>6月30日　9:43 PM</color>\nとある平日、バイト終了後の神楽坂トライナリーにて。"}
    ]
}
