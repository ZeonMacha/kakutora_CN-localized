    [
        { "location": "7/SCENARIO", "narrator": "", "text": "030_新人ちゃん"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "ずるいわよね・・・"},
        { "location": "34/TALK"   , "narrator": "ガブリエラ", "text": "ああいうのって・・・"},
        { "location": "37/SEL"    , "narrator": "", "text": "何がずるいの？"},
        { "location": "40/TALK"   , "narrator": "ガブリエラ", "text": "だって・・・"},
        { "location": "43/TALK"   , "narrator": "ガブリエラ", "text": "後輩のくせに年上とか・・・"},
        { "location": "46/TALK"   , "narrator": "ガブリエラ", "text": "どうやって相手すればいいかわからないわよ・・・"},
        { "location": "58/ACT"    , "narrator": "", "text": "何がずるいの？"},
        { "location": "60/TALK"   , "narrator": "ガブリエラ", "text": "つばめのことよ！"},
        { "location": "61/TALK"   , "narrator": "ガブリエラ", "text": "つばめって、新人の後輩がいるのよ、話したことがあるかしら？"},
        { "location": "63/SEL"    , "narrator": "", "text": "あるよ"},
        { "location": "64/SEL"    , "narrator": "", "text": "ないよ"},
        { "location": "65/ACT"    , "narrator": "", "text": "あるよ"},
        { "location": "66/TALK"   , "narrator": "ガブリエラ", "text": "あるわよね"},
        { "location": "67/TALK"   , "narrator": "ガブリエラ", "text": "そうなの、あの子よ"},
        { "location": "68/TALK"   , "narrator": "ガブリエラ", "text": "新人なのに年上なのよ"},
        { "location": "69/TALK"   , "narrator": "ガブリエラ", "text": "新人なのによ？"},
        { "location": "71/ACT"    , "narrator": "", "text": "ないよ"},
        { "location": "73/TALK"   , "narrator": "ガブリエラ", "text": "そうだったの？"},
        { "location": "74/TALK"   , "narrator": "ガブリエラ", "text": "つばめはね、ついこの間入ってきたばかりなんだけど、高等部１年なの"},
        { "location": "75/TALK"   , "narrator": "ガブリエラ", "text": "そのせいかなんだか私のことを年下扱いするの"},
        { "location": "78/SEL"    , "narrator": "", "text": "実際に年は下だよね？"},
        { "location": "79/SEL"    , "narrator": "", "text": "それはよくないね"},
        { "location": "80/SEL"    , "narrator": "", "text": "先輩の余裕を見せればいいよ"},
        { "location": "81/ACT"    , "narrator": "", "text": "実際に年は下だよね？"},
        { "location": "82/TALK"   , "narrator": "ガブリエラ", "text": "確かにそうなんだけど！"},
        { "location": "83/TALK"   , "narrator": "ガブリエラ", "text": "そういうのって良くないと思うのよ！"},
        { "location": "84/ACT"    , "narrator": "", "text": "それはよくないね"},
        { "location": "85/TALK"   , "narrator": "ガブリエラ", "text": "そうでしょう？"},
        { "location": "86/TALK"   , "narrator": "ガブリエラ", "text": "そう思うわよね？"},
        { "location": "87/ACT"    , "narrator": "", "text": "先輩の余裕を見せればいいよ"},
        { "location": "89/TALK"   , "narrator": "ガブリエラ", "text": "そうね・・・"},
        { "location": "90/TALK"   , "narrator": "ガブリエラ", "text": "先輩の余裕v"},
        { "location": "92/TALK"   , "narrator": "ガブリエラ", "text": "うんうん、いい言葉ね♪"},
        { "location": "94/TALK"   , "narrator": "ガブリエラ", "text": "でもね"},
        { "location": "95/TALK"   , "narrator": "ガブリエラ", "text": "優しくしたいなって思ったりするんだけど・・・"},
        { "location": "96/TALK"   , "narrator": "ガブリエラ", "text": "みんなが、特にアーヤがつばめに優しくしてたりすると、ちょっとね、悔しいっていうか"},
        { "location": "98/TALK"   , "narrator": "ガブリエラ", "text": "わかるでしょ？"},
        { "location": "100/SEL"   , "narrator": "", "text": "わかるよ"},
        { "location": "101/SEL"   , "narrator": "", "text": "わからないなあ"},
        { "location": "102/ACT"   , "narrator": "", "text": "わかるよ"},
        { "location": "103/TALK"  , "narrator": "ガブリエラ", "text": "うん・・・"},
        { "location": "104/TALK"  , "narrator": "ガブリエラ", "text": "ありがとう"},
        { "location": "107/ACT"   , "narrator": "", "text": "わからないなあ"},
        { "location": "108/TALK"  , "narrator": "ガブリエラ", "text": "冷たいのね・・・"},
        { "location": "110/TALK"  , "narrator": "ガブリエラ", "text": "うん"},
        { "location": "111/TALK"  , "narrator": "ガブリエラ", "text": "決めた"},
        { "location": "112/TALK"  , "narrator": "ガブリエラ", "text": "先輩の威厳を見せつつ、優しくする"},
        { "location": "114/SEL"   , "narrator": "", "text": "がんばって"},
        { "location": "115/ACT"   , "narrator": "", "text": "がんばって"},
        { "location": "117/TALK"  , "narrator": "ガブリエラ", "text": "うん♪"},
        { "location": "118/TALK"  , "narrator": "ガブリエラ", "text": "それに新人は私より年上かもしれないけどまだ子供っぽいところがあるわ"},
        { "location": "119/TALK"  , "narrator": "ガブリエラ", "text": "私はマルザンナと大人の話をするわ♪"},
        { "location": "121/TALK"  , "narrator": "ガブリエラ", "text": "こんな話よ"},
        { "location": "125/TALK"  , "narrator": "ボイスメール", "text": "さてそのほかは、みな狂気の沙汰"},
        { "location": "137/DIALOG", "narrator": "Dialog_GETVoice", "text": "<color=green>【ガブリエラ】</color>のボイスメール\n<color=red>【さてそのほかは、みな狂気の沙汰】</color>\nをゲットしました！"}
    ]
