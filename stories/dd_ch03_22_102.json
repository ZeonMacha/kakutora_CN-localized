        "title": "005 メインストーリー",
        "sub_title": "疑念＜後編＞"
    },
    "entry":
    [
        { "location": "562/TALK"  , "narrator": "ガブリエラ", "text": "っていうか"},
        { "location": "563/TALK"  , "narrator": "ガブリエラ", "text": "さすがに考え過ぎよね"},
        { "location": "564/TALK"  , "narrator": "ガブリエラ", "text": "だって"},
        { "location": "565/TALK"  , "narrator": "ガブリエラ", "text": "本当につばめを壊そうとしてるなら"},
        { "location": "566/TALK"  , "narrator": "ガブリエラ", "text": "本人に言うはずないわ"},
        { "location": "567/TALK"  , "narrator": "ガブリエラ", "text": "最近色々あったし"},
        { "location": "568/TALK"  , "narrator": "ガブリエラ", "text": "口喧嘩の時にでも"},
        { "location": "569/TALK"  , "narrator": "ガブリエラ", "text": "神楽が爆発しちゃっただけ"},
        { "location": "570/TALK"  , "narrator": "ガブリエラ", "text": "きっとそうよ"},
        { "location": "572/SEL"   , "narrator": "", "text": "そうなのかな？"},
        { "location": "573/ACT"   , "narrator": "", "text": "そうなのかな？"},
        { "location": "575/TALK"  , "narrator": "ガブリエラ", "text": "そうに決まってるわ"},
        { "location": "576/TALK"  , "narrator": "ガブリエラ", "text": "じゃなきゃ"},
        { "location": "579/TALK"  , "narrator": "ガブリエラ", "text": "ううん"},
        { "location": "580/TALK"  , "narrator": "ガブリエラ", "text": "絶対そうよ"},
        { "location": "592/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "593/TALK"  , "narrator": "ガブリエラ", "text": "あの二人も、\nそんな喧嘩すること\nあるのね…。"},
        { "location": "595/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "596/TALK"  , "narrator": "ガブリエラ", "text": "もうちょっと、\n散歩して帰ろう…。"},
        { "location": "615/TALK"  , "narrator": "ガブリエラ", "text": "…静かね。\n昼間とは違う場所\nみたい…。"},
        { "location": "618/SEL"   , "narrator": "", "text": "こうしてると、デートみたい"},
        { "location": "619/ACT"   , "narrator": "", "text": "こうしてると、デートみたい"},
        { "location": "637/TALK"  , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "638/TALK"  , "narrator": "ガブリエラ", "text": "夜の砂浜"},
        { "location": "639/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$と私の二人だけ"},
        { "location": "640/TALK"  , "narrator": "ガブリエラ", "text": "シチュエーション的にはデートよね"},
        { "location": "642/TALK"  , "narrator": "ガブリエラ", "text": "けど"},
        { "location": "643/TALK"  , "narrator": "ガブリエラ", "text": "複雑よ"},
        { "location": "644/TALK"  , "narrator": "ガブリエラ", "text": "デートなのに"},
        { "location": "645/TALK"  , "narrator": "ガブリエラ", "text": "スマホに文字打ってるんだもの"},
        { "location": "647/SEL"   , "narrator": "", "text": "そうだよね、ごめん"},
        { "location": "648/ACT"   , "narrator": "", "text": "そうだよね、ごめん"},
        { "location": "650/TALK"  , "narrator": "ガブリエラ", "text": "謝るなら"},
        { "location": "651/TALK"  , "narrator": "ガブリエラ", "text": "いつでも電話できるようになりなさいよ"},
        { "location": "652/TALK"  , "narrator": "ガブリエラ", "text": "私だって"},
        { "location": "653/TALK"  , "narrator": "ガブリエラ", "text": "声で話したいんだから/////"},
        { "location": "656/TALK"  , "narrator": "ガブリエラ", "text": "まあ"},
        { "location": "657/TALK"  , "narrator": "ガブリエラ", "text": "無理言っても仕方ないし"},
        { "location": "658/TALK"  , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "660/TALK"  , "narrator": "ガブリエラ", "text": "エスコートもないデートは"},
        { "location": "661/TALK"  , "narrator": "ガブリエラ", "text": "ちょっと寂しいわね"},
        { "location": "663/SEL"   , "narrator": "", "text": "どんな感じがお好み？"},
        { "location": "664/ACT"   , "narrator": "", "text": "どんな感じがお好み？"},
        { "location": "666/TALK"  , "narrator": "ガブリエラ", "text": "そういうの"},
        { "location": "667/TALK"  , "narrator": "ガブリエラ", "text": "レディに問うのは失礼よ"},
        { "location": "668/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$が自分で考えて"},
        { "location": "669/TALK"  , "narrator": "ガブリエラ", "text": "レディに喜ばれる"},
        { "location": "670/TALK"  , "narrator": "ガブリエラ", "text": "最高のもてなしをしなくちゃね"},
        { "location": "672/SEL"   , "narrator": "", "text": "かしこまりました、お嬢様"},
        { "location": "673/SEL"   , "narrator": "", "text": "わかりました、お姫様"},
        { "location": "674/SEL"   , "narrator": "", "text": "ラジャー、ガブちゃん！"},
        { "location": "675/ACT"   , "narrator": "", "text": "かしこまりました、お嬢様"},
        { "location": "676/TALK"  , "narrator": "ガブリエラ", "text": "そうそう"},
        { "location": "677/TALK"  , "narrator": "ガブリエラ", "text": "悪くないわ"},
        { "location": "678/TALK"  , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "679/TALK"  , "narrator": "ガブリエラ", "text": "もう一歩ってところね"},
        { "location": "680/TALK"  , "narrator": "ガブリエラ", "text": "やっぱりデートの時は"},
        { "location": "681/TALK"  , "narrator": "ガブリエラ", "text": "お姫様として扱ってもらいたいわ"},
        { "location": "682/ACT"   , "narrator": "", "text": "わかりました、お姫様"},
        { "location": "683/TALK"  , "narrator": "ガブリエラ", "text": "よろしい"},
        { "location": "685/TALK"  , "narrator": "ガブリエラ", "text": "デートの時は"},
        { "location": "686/TALK"  , "narrator": "ガブリエラ", "text": "お姫様扱いすること"},
        { "location": "687/TALK"  , "narrator": "ガブリエラ", "text": "これは基本中の基本よ"},
        { "location": "690/TALK"  , "narrator": "ガブリエラ", "text": "でもただのお姫様扱いだけじゃダメ"},
        { "location": "691/TALK"  , "narrator": "ガブリエラ", "text": "あくまでもデートであることを忘れないこと"},
        { "location": "692/TALK"  , "narrator": "ガブリエラ", "text": "わかるかしら？"},
        { "location": "694/SEL"   , "narrator": "", "text": "恋人であることも忘れるな、ってこと？"},
        { "location": "695/ACT"   , "narrator": "", "text": "恋人であることも忘れるな、ってこと？"},
        { "location": "697/TALK"  , "narrator": "ガブリエラ", "text": "そういうこと"},
        { "location": "698/TALK"  , "narrator": "ガブリエラ", "text": "甘やかさせたり楽しませたり"},
        { "location": "699/TALK"  , "narrator": "ガブリエラ", "text": "危ないことからは護ってあげたり"},
        { "location": "700/TALK"  , "narrator": "ガブリエラ", "text": "でも接待にはならないように扱うこと"},
        { "location": "701/TALK"  , "narrator": "ガブリエラ", "text": "わかった？"},
        { "location": "703/SEL"   , "narrator": "", "text": "難しくなってきたぞ！？"},
        { "location": "704/ACT"   , "narrator": "", "text": "難しくなってきたぞ！？"},
        { "location": "706/TALK"  , "narrator": "ガブリエラ", "text": "普通のことでしょ"},
        { "location": "709/TALK"  , "narrator": "ガブリエラ", "text": "もしかして間違ってる？"},
        { "location": "712/TALK"  , "narrator": "ガブリエラ", "text": "でも雑誌とか漫画にはそう書いてあったし"},
        { "location": "713/TALK"  , "narrator": "ガブリエラ", "text": "間違ってはないと思うけど"},
        { "location": "715/SEL"   , "narrator": "", "text": "任せてください、姫！"},
        { "location": "716/ACT"   , "narrator": "", "text": "任せてください、姫！"},
        { "location": "718/TALK"  , "narrator": "ガブリエラ", "text": "自信あるみたいね"},
        { "location": "719/TALK"  , "narrator": "ガブリエラ", "text": "さすがよ$marzanna$"},
        { "location": "720/ACT"   , "narrator": "", "text": "ラジャー、ガブちゃん"},
        { "location": "721/TALK"  , "narrator": "ガブリエラ", "text": "あのね"},
        { "location": "722/TALK"  , "narrator": "ガブリエラ", "text": "私の話聞いてなかったでしょ？"},
        { "location": "725/TALK"  , "narrator": "ガブリエラ", "text": "まあ$marzanna$らしいといえばらしいけど"},
        { "location": "727/TALK"  , "narrator": "ガブリエラ", "text": "でもガブちゃんって呼ぶのはダメ"},
        { "location": "728/TALK"  , "narrator": "ガブリエラ", "text": "ＮＧよ"},
        { "location": "729/TALK"  , "narrator": "ガブリエラ", "text": "そんな軽々しい呼び方されたら"},
        { "location": "730/TALK"  , "narrator": "ガブリエラ", "text": "雰囲気ぶち壊しよ"},
        { "location": "732/TALK"  , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "733/TALK"  , "narrator": "ガブリエラ", "text": "いつかは本当に"},
        { "location": "734/TALK"  , "narrator": "ガブリエラ", "text": "好きな人とデートしたいわ"},
        { "location": "736/TALK"  , "narrator": "ガブリエラ", "text": "チャットじゃなくて"},
        { "location": "737/TALK"  , "narrator": "ガブリエラ", "text": "ちゃんと一緒に並んでね"},
        { "location": "739/SEL"   , "narrator": "", "text": "$me$で練習すればいい"},
        { "location": "740/ACT"   , "narrator": "", "text": "$me$で練習すればいい"},
        { "location": "744/TALK"  , "narrator": "ガブリエラ", "text": "やっぱりあなたは頼りになる使用人ね"},
        { "location": "747/TALK"  , "narrator": "ガブリエラ", "text": "なんだか"},
        { "location": "748/TALK"  , "narrator": "ガブリエラ", "text": "少し気持ちが落ち着いたかも"},
        { "location": "749/TALK"  , "narrator": "ガブリエラ", "text": "$marzanna$とお話ししてたからかしら？"},
        { "location": "750/TALK"  , "narrator": "ガブリエラ", "text": "まあ"},
        { "location": "752/TALK"  , "narrator": "ガブリエラ", "text": "ちょっとカッコ悪いところ見せちゃったけど/////"},
        { "location": "755/TALK"  , "narrator": "ガブリエラ", "text": "$handle$がいてくれてよかった"},
        { "location": "756/TALK"  , "narrator": "ガブリエラ", "text": "感謝してるわ"},
        { "location": "757/TALK"  , "narrator": "ガブリエラ", "text": "ありがと//////"},
        { "location": "759/TALK"  , "narrator": "ガブリエラ", "text": "そろそろ家に戻るわ"},
        { "location": "761/SEL"   , "narrator": "", "text": "またデートしようね"},
        { "location": "762/ACT"   , "narrator": "", "text": "またデートしようね"},
        { "location": "765/TALK"  , "narrator": "ガブリエラ", "text": "調子に乗らないで？"},
        { "location": "766/TALK"  , "narrator": "ガブリエラ", "text": "なんて"},
        { "location": "767/TALK"  , "narrator": "ガブリエラ", "text": "今日だけは許してあげるわ/////////"},
        { "location": "778/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "779/TALK"  , "narrator": "ガブリエラ", "text": "ふふっ…、\n誘ってもらえるの\nかしら？"},
        { "location": "790/DIALOG", "narrator": "Dialog_chapter_ch03", "text": "【18 ブラック・クラン】"}
    ]
}
