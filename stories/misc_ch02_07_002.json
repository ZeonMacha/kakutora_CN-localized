    "entry":
    [
        { "location": "91/SCENARIO", "narrator": "", "text": "05-07_神楽坂にて"},
        { "location": "116/TALK"   , "narrator": "アーヤ", "text": "東京と地方じゃ"},
        { "location": "117/TALK"   , "narrator": "アーヤ", "text": "時間の流れが10年くらい違うって"},
        { "location": "118/TALK"   , "narrator": "アーヤ", "text": "聞いたことない？"},
        { "location": "121/SEL"    , "narrator": "", "text": "あるようなないような"},
        { "location": "122/SEL"    , "narrator": "", "text": "よく聞くね"},
        { "location": "123/SEL"    , "narrator": "", "text": "実際住んでみてどう？"},
        { "location": "124/ACT"    , "narrator": "", "text": "あるようなないような"},
        { "location": "125/TALK"   , "narrator": "アーヤ", "text": "そうなの"},
        { "location": "126/ACT"    , "narrator": "", "text": "よく聞くね"},
        { "location": "127/TALK"   , "narrator": "アーヤ", "text": "地方に住んでると"},
        { "location": "129/TALK"   , "narrator": "アーヤ", "text": "聞くわよね"},
        { "location": "130/ACT"    , "narrator": "", "text": "実際住んでみてどう？"},
        { "location": "132/TALK"   , "narrator": "アーヤ", "text": "分かるような気もするけど"},
        { "location": "133/TALK"   , "narrator": "アーヤ", "text": "だからって"},
        { "location": "134/TALK"   , "narrator": "アーヤ", "text": "遅れてるというのとは違うと思うのよね"},
        { "location": "136/TALK"   , "narrator": "アーヤ", "text": "10年っていっても"},
        { "location": "138/TALK"   , "narrator": "アーヤ", "text": "何が基準なのかしら"},
        { "location": "140/SEL"    , "narrator": "", "text": "設備とか環境とか"},
        { "location": "141/SEL"    , "narrator": "", "text": "人の意識"},
        { "location": "142/SEL"    , "narrator": "", "text": "技術かな"},
        { "location": "143/ACT"    , "narrator": "", "text": "設備とか環境とか"},
        { "location": "144/TALK"   , "narrator": "アーヤ", "text": "設備なんて"},
        { "location": "145/TALK"   , "narrator": "アーヤ", "text": "変えようがない気もするわ"},
        { "location": "146/ACT"    , "narrator": "", "text": "人の意識"},
        { "location": "148/TALK"   , "narrator": "アーヤ", "text": "それはちょっと"},
        { "location": "149/TALK"   , "narrator": "アーヤ", "text": "思うわね"},
        { "location": "150/ACT"    , "narrator": "", "text": "技術かな"},
        { "location": "151/TALK"   , "narrator": "アーヤ", "text": "伝統工芸とかは"},
        { "location": "152/TALK"   , "narrator": "アーヤ", "text": "除外なのかしら"},
        { "location": "154/TALK"   , "narrator": "アーヤ", "text": "卯月なんかはやっぱり"},
        { "location": "155/TALK"   , "narrator": "アーヤ", "text": "都会っ子って感じするのよね"},
        { "location": "157/SEL"    , "narrator": "", "text": "やーい田舎もん"},
        { "location": "158/SEL"    , "narrator": "", "text": "アーヤもかっこいいよ"},
        { "location": "159/ACT"    , "narrator": "", "text": "やーい田舎もん"},
        { "location": "160/TALK"   , "narrator": "アーヤ", "text": "ひど"},
        { "location": "161/TALK"   , "narrator": "アーヤ", "text": "それでいいわよ"},
        { "location": "162/TALK"   , "narrator": "アーヤ", "text": "もー！"},
        { "location": "163/ACT"    , "narrator": "", "text": "アーヤもかっこいいよ"},
        { "location": "165/TALK"   , "narrator": "アーヤ", "text": "そういうことじゃないわ"},
        { "location": "166/TALK"   , "narrator": "アーヤ", "text": "でも"},
        { "location": "167/TALK"   , "narrator": "アーヤ", "text": "それはそれでうれしいわ"}
    ]
}
