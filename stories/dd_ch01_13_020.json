{
    "dir": "chap13/daydra/dd_ch01_13_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "13156",
        "cid": "tsubame",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "研修旅行"
    },
    "entry":
    [
        { "location": "149/SCENARIO", "narrator": "", "text": "研修旅行"},
        { "location": "175/TALK"    , "narrator": "つばめ", "text": "研修旅行？"},
        { "location": "179/TALK"    , "narrator": "キリト", "text": "知らなかったのか？"},
        { "location": "180/TALK"    , "narrator": "キリト", "text": "校外学習の一環で、\n夏休みに一週間行くことに\nなってるんだよ。"},
        { "location": "181/TALK"    , "narrator": "つばめ", "text": "そんなのがあったんだ？\nでも、どこに行くの？"},
        { "location": "184/TALK"    , "narrator": "雛", "text": "行き先は三つあって、\n沖縄、グアム、京都の\n中から選べるんだよ。"},
        { "location": "187/TALK"    , "narrator": "つばめ", "text": "わぁ、凄いね！\n三つとも行ったことない\nから、迷っちゃうよ…。"},
        { "location": "188/TALK"    , "narrator": "キリト", "text": "そういや、みんなは\nどこ行くか決まったのか？"},
        { "location": "190/TALK"    , "narrator": "ヒカル", "text": "僕は京都にしようと\n思っています。"},
        { "location": "192/TALK"    , "narrator": "繭", "text": "同じく。"},
        { "location": "195/TALK"    , "narrator": "雛", "text": "あたしは沖縄一択！！\n今から楽しみなんだー。"},
        { "location": "198/TALK"    , "narrator": "キリト", "text": "俺はもちろん、グアムだ！\nせっかく行くなら、やっぱ\n海外旅行だろ？"},
        { "location": "203/TALK"    , "narrator": "つばめ", "text": "そっかぁ…\nみんな、行きたいところ\nバラバラなんだね？"},
        { "location": "205/TALK"    , "narrator": "つばめ", "text": "みんなと一緒だったら\n良かったんだけどなぁ。"},
        { "location": "206/TALK"    , "narrator": "ヒカル", "text": "そうですね。\n僕も、ちょっとだけ\n残念です。"},
        { "location": "207/TALK"    , "narrator": "雛", "text": "絶対みんな沖縄に行くと\n思ったんだけどなー。"},
        { "location": "208/TALK"    , "narrator": "ヒカル", "text": "実は、ちょっとだけ\n悩みました。"},
        { "location": "211/TALK"    , "narrator": "キリト", "text": "てか、普通海外旅行が\nあるなら、それ以外ねぇと\n思うけどなぁ…。"},
        { "location": "212/TALK"    , "narrator": "つばめ", "text": "…どうしよう。\nわたしもどこに行くか、\n早く決めないと。"},
        { "location": "216/TALK"    , "narrator": "つばめ", "text": "でも、行ったことない場所\nばかりだから、全部行って\nみたい気がするし…。"},
        { "location": "228/TALK"    , "narrator": "つばめ", "text": "相談でーす"},
        { "location": "229/TALK"    , "narrator": "つばめ", "text": "夏休みに研修旅行があるんだけど、どこに行くかで悩んでるの"},
        { "location": "230/TALK"    , "narrator": "つばめ", "text": "京都、グアム、沖縄の中だったら、どこがいいかな？"},
        { "location": "232/SEL"     , "narrator": "", "text": "グアム"},
        { "location": "233/SEL"     , "narrator": "", "text": "沖縄"},
        { "location": "234/SEL"     , "narrator": "", "text": "京都"},
        { "location": "235/ACT"     , "narrator": "", "text": "グアム"},
        { "location": "237/TALK"    , "narrator": "つばめ", "text": "グアムかぁ"},
        { "location": "238/TALK"    , "narrator": "つばめ", "text": "やっぱり、せっかく行くなら海外が良いかな？"},
        { "location": "250/TALK"    , "narrator": "つばめ", "text": "…わたしも、\nグアムにしようかな？"},
        { "location": "252/TALK"    , "narrator": "キリト", "text": "おっ、やっぱりこの中なら\nグアムしかねぇよな？"},
        { "location": "253/TALK"    , "narrator": "キリト", "text": "なんたって、海外旅行！\n国内旅行なんて超ショボく\n感じられるぜ。"},
        { "location": "255/TALK"    , "narrator": "繭", "text": "グアムも相当ショボい。\nナマコだらけのキモい海で\n泳ぐとか、正気じゃない。"},
        { "location": "257/TALK"    , "narrator": "キリト", "text": "常夏の楽園に対して、\nなんてことを…。"},
        { "location": "260/TALK"    , "narrator": "雛", "text": "グアムは常夏なだけで、\n楽園とまでは言わないと\n思うけど？"},
        { "location": "262/TALK"    , "narrator": "繭", "text": "せめてバリ島レベルじゃ\nないと、楽園ではない。"},
        { "location": "264/TALK"    , "narrator": "雛", "text": "っていうか、グアムって\n海外って感じしなくない？"},
        { "location": "267/TALK"    , "narrator": "ヒカル", "text": "日本からそう離れていない\nから、そう思うのかも\nしれませんね。"},
        { "location": "270/TALK"    , "narrator": "キリト", "text": "グアムをバカにすんな！！\n楽しみ過ぎて、パスポート\nもう取ったんだぞ！？"},
        { "location": "272/TALK"    , "narrator": "繭", "text": "うわバカだ、バカがいる！"},
        { "location": "277/TALK"    , "narrator": "つばめ", "text": "あ、そっか。\n海外旅行だから\nパスポートがいるんだ？"},
        { "location": "279/TALK"    , "narrator": "つばめ", "text": "キリト君、パスポートの\n取り方ってどうやるのか、\n今度教えてくれる？"},
        { "location": "281/TALK"    , "narrator": "キリト", "text": "おう、任せとけ。\n俺と逢瀬は\nグアムフレンドだからな。"},
        { "location": "282/TALK"    , "narrator": "つばめ", "text": "えへへ、わたしも海外って\n初めてだから、今から\n楽しみだよ。"},
        { "location": "285/TALK"    , "narrator": "繭", "text": "グアム程度でここまで\n盛り上がれるなんて…。"},
        { "location": "289/TALK"    , "narrator": "キリト", "text": "何とでも言え。\nおまえ達が京都や沖縄で\n大汗かいてる頃――"},
        { "location": "290/TALK"    , "narrator": "キリト", "text": "俺と逢瀬は常夏の海で、\n優雅に海水浴だぜ。"},
        { "location": "293/TALK"    , "narrator": "つばめ", "text": "…ナマコだらけの海には、\nあまり入りたくないんだ\nけどなぁ…。"},
        { "location": "294/ACT"     , "narrator": "", "text": "沖縄"},
        { "location": "296/TALK"    , "narrator": "つばめ", "text": "やっぱり、沖縄くらいにしようかな？"},
        { "location": "297/TALK"    , "narrator": "つばめ", "text": "グアムも気になるけど、英語ができないから、ちょっと不安だし"},
        { "location": "308/TALK"    , "narrator": "つばめ", "text": "わたし、沖縄にするよ。"},
        { "location": "311/TALK"    , "narrator": "雛", "text": "本当！？\nすっごく嬉しいよー！"},
        { "location": "312/TALK"    , "narrator": "雛", "text": "せっかく沖縄行くのに\n一人なのは寂しいな、\nって思ってたんだ。"},
        { "location": "316/TALK"    , "narrator": "つばめ", "text": "わたしも、ひなこちゃんが\n一緒で嬉しいよ。"},
        { "location": "319/TALK"    , "narrator": "キリト", "text": "沖縄だったらグアムの方が\nいいんじゃねぇか？"},
        { "location": "323/TALK"    , "narrator": "つばめ", "text": "わたし、旅行自体あまり\n慣れてないから、今は\n国内だけで十分だよ。"},
        { "location": "326/TALK"    , "narrator": "雛", "text": "あたしは目的があるから\n沖縄に行くんだー。"},
        { "location": "329/TALK"    , "narrator": "つばめ", "text": "見たい観光地でもあるの？"},
        { "location": "332/TALK"    , "narrator": "雛", "text": "うーん…ゆいレールって\n観光地とは言わないかな？"},
        { "location": "335/TALK"    , "narrator": "繭", "text": "…沖縄限定の電車？"},
        { "location": "338/TALK"    , "narrator": "雛", "text": "モノレールだよ。\n那覇空港駅から首里駅間を\n走ってるんだけど――"},
        { "location": "339/TALK"    , "narrator": "雛", "text": "７００円で一日中\n乗り放題なの！"},
        { "location": "340/TALK"    , "narrator": "ヒカル", "text": "ま、待ってください。\nまさか一日中乗り続ける\nつもりですか？"},
        { "location": "343/TALK"    , "narrator": "雛", "text": "…いくらあたしでも、\nさすがにそこまでは\nしないよ。"},
        { "location": "344/TALK"    , "narrator": "ヒカル", "text": "あ、すみません…。"},
        { "location": "346/TALK"    , "narrator": "雛", "text": "三往復くらいしかしない\nから、まあ、三時間程度\nだと思うよ。"},
        { "location": "350/TALK"    , "narrator": "キリト", "text": "せめて一往復にしろよ…。"},
        { "location": "351/TALK"    , "narrator": "つばめ", "text": "ふーん、ゆいレールかぁ。\nそんなのがあるなんて\n知らなかったよ。"},
        { "location": "354/TALK"    , "narrator": "つばめ", "text": "わたしも、ひなこちゃんと\n一緒にゆいレールに\n乗ってみたいな。"},
        { "location": "357/TALK"    , "narrator": "雛", "text": "おおっ、つばめちゃんが\nとうとうあたしの趣味に\n興味を持った！？"},
        { "location": "358/TALK"    , "narrator": "雛", "text": "それじゃ、車両をバックに\n記念写真も撮ろうね。"},
        { "location": "361/TALK"    , "narrator": "繭", "text": "…どこに行っても、\nやること一緒ね。"},
        { "location": "364/TALK"    , "narrator": "雛", "text": "あたしにとっては\n沖縄でしかできない\nことなの！"},
        { "location": "367/TALK"    , "narrator": "つばめ", "text": "ふふっ…ひなこちゃん、\n本当に電車が好きなん\nだなぁ。"},
        { "location": "368/ACT"     , "narrator": "", "text": "京都"},
        { "location": "371/TALK"    , "narrator": "つばめ", "text": "京都かぁ…"},
        { "location": "372/TALK"    , "narrator": "つばめ", "text": "そういえば、去年行けなかったんだっけ…"},
        { "location": "384/TALK"    , "narrator": "つばめ", "text": "…わたしも、\n京都にしようかな？"},
        { "location": "386/TALK"    , "narrator": "キリト", "text": "京都人気凄いな。\n三人も行くのかよ？"},
        { "location": "388/TALK"    , "narrator": "雛", "text": "去年、修学旅行で\n行かなかったの？"},
        { "location": "389/TALK"    , "narrator": "ヒカル", "text": "その時に見た場所を、\nもう一度時間を掛けて、\nゆっくり見たいんです。"},
        { "location": "390/TALK"    , "narrator": "ヒカル", "text": "修学旅行は団体行動で、\n落ち着いて見ることが\nできませんでしたから…。"},
        { "location": "392/TALK"    , "narrator": "キリト", "text": "真面目な奴。"},
        { "location": "395/TALK"    , "narrator": "つばめ", "text": "わたしは…実は去年、\n修学旅行行ってないんだ。"},
        { "location": "397/TALK"    , "narrator": "雛", "text": "えぇっ、そうだったの！？"},
        { "location": "400/TALK"    , "narrator": "つばめ", "text": "うん…あの時、ちょっと\n入院してたから――"},
        { "location": "401/TALK"    , "narrator": "つばめ", "text": "一年遅れだけど、\n京都を見て回りたいの。"},
        { "location": "402/TALK"    , "narrator": "雛", "text": "そうだったんだ…。\n面白いところ見て回れると\nいいね。"},
        { "location": "404/TALK"    , "narrator": "つばめ", "text": "うん。"},
        { "location": "406/TALK"    , "narrator": "ヒカル", "text": "そういえば、繭さんは\nどうして京都に？"},
        { "location": "407/TALK"    , "narrator": "繭", "text": "移動時間短いから。\nさっさとホテルに入って、\n最終日まで閉じこもるわ。"},
        { "location": "410/TALK"    , "narrator": "キリト", "text": "もったいねぇなぁ…。"},
        { "location": "415/TALK"    , "narrator": "つばめ", "text": "でも、一日くらいは\n一緒にどこか見ようよ。"},
        { "location": "416/TALK"    , "narrator": "繭", "text": "寺や神社を見て回るのは、\n六十過ぎてからで十分。"},
        { "location": "417/TALK"    , "narrator": "繭", "text": "どうせ歴史文化財だから、\nそれくらい経っても\n残ってると思うし。"},
        { "location": "420/TALK"    , "narrator": "つばめ", "text": "…じゃあ、ヒカルくん。\n京都見学、わたしも一緒に\n行っていいかな？"},
        { "location": "422/TALK"    , "narrator": "ヒカル", "text": "ええ、もちろん。\n修学旅行で行ったところを\n案内しますよ。"},
        { "location": "424/TALK"    , "narrator": "つばめ", "text": "わぁ、嬉しい！"},
        { "location": "444/TALK"    , "narrator": "真幌", "text": "盛り上がっているな。\n何か楽しいことでも\nあったのか？"},
        { "location": "447/TALK"    , "narrator": "つばめ", "text": "あっ、真幌さん。\n今、研修旅行の話を\nしていたんです。"},
        { "location": "448/TALK"    , "narrator": "真幌", "text": "…夏休みに行く、\nあれのことか？"},
        { "location": "451/TALK"    , "narrator": "キリト", "text": "それ以外にないじゃない\nっすか。"},
        { "location": "454/TALK"    , "narrator": "雛", "text": "夏休みの学校行事も、\nこういうのだったら\n大歓迎です。"},
        { "location": "457/TALK"    , "narrator": "繭", "text": "私は全然だけど。"},
        { "location": "460/TALK"    , "narrator": "ヒカル", "text": "行ってみれば、\nきっと楽しめると\n思いますよ。"},
        { "location": "461/TALK"    , "narrator": "真幌", "text": "…………。"},
        { "location": "462/TALK"    , "narrator": "つばめ", "text": "そういえば、真幌さんも\n同行するんですか？"},
        { "location": "464/TALK"    , "narrator": "真幌", "text": "いや、私は劇場もあるから\n行かないんだが…。"},
        { "location": "466/TALK"    , "narrator": "真幌", "text": "…というか、\n非常に言い難いことでは\nあるのだが――"},
        { "location": "468/TALK"    , "narrator": "真幌", "text": "逢瀬、小金井、安茂里の\n三人は、研修旅行には\n参加できんぞ。"},
        { "location": "469/TALK"    , "narrator": "つばめ", "text": "…え？"},
        { "location": "471/TALK"    , "narrator": "ヒカル", "text": "…はい？"},
        { "location": "473/TALK"    , "narrator": "キリト", "text": "…冗談でしょ？"},
        { "location": "474/TALK"    , "narrator": "真幌", "text": "夏休み研修旅行は、\n特別攻撃隊、通常攻撃隊\n養成科の生徒は――"},
        { "location": "475/TALK"    , "narrator": "真幌", "text": "参加対象外になっている。"},
        { "location": "476/TALK"    , "narrator": "つばめ", "text": "そ、そんな！\n何でですか！？"},
        { "location": "477/TALK"    , "narrator": "真幌", "text": "フェノメノンが\nいつ発生するか\nわからんからだ。"},
        { "location": "478/TALK"    , "narrator": "真幌", "text": "一週間も東京を離れる\nことなど、許されるはずが\nないだろう？"},
        { "location": "479/TALK"    , "narrator": "ヒカル", "text": "…なるほど。\n確かにそうですね。"},
        { "location": "482/TALK"    , "narrator": "キリト", "text": "納得すんなよ！\nどう考えても理不尽じゃ\nねぇか！？"},
        { "location": "483/TALK"    , "narrator": "真幌", "text": "フェノメノンと戦うと\nいうのは、多かれ少なかれ\n犠牲が出るものだ。"},
        { "location": "484/TALK"    , "narrator": "真幌", "text": "これも小さな犠牲だと\n思って、諦めろ。"},
        { "location": "485/TALK"    , "narrator": "キリト", "text": "お、俺の、グアムが…。"},
        { "location": "486/TALK"    , "narrator": "真幌", "text": "…まあ、どの場所も\n行こうと思えば行けない\n場所ではないからな。"},
        { "location": "487/TALK"    , "narrator": "真幌", "text": "そう落ち込むな。\n将来的に行く予定でも\n立てておくんだな。"},
        { "location": "492/TALK"    , "narrator": "つばめ", "text": "…将来的には行けても、\n学校行事で行けるのは\n今回しかないのに…。"},
        { "location": "494/TALK"    , "narrator": "ヒカル", "text": "そうですよね。\n僕も、友達とみんなで\n出かけたかったです。"},
        { "location": "497/TALK"    , "narrator": "キリト", "text": "俺たちに取っちゃ、\n結構デカい犠牲だよな…。"},
        { "location": "500/TALK"    , "narrator": "繭", "text": "…ひなこ、\n早くフォロー。"},
        { "location": "503/TALK"    , "narrator": "雛", "text": "ちょ！？\n無茶ぶり過ぎるって！！"},
        { "location": "505/TALK"    , "narrator": "キリト", "text": "…研修旅行ってさ、\n確か、二年と三年でも\nあったよな？"},
        { "location": "507/TALK"    , "narrator": "ヒカル", "text": "ええ、場所は違う\nみたいですが…。"},
        { "location": "509/TALK"    , "narrator": "キリト", "text": "東雲教官は将来的に、って\n言ってたけど――"},
        { "location": "510/TALK"    , "narrator": "キリト", "text": "二年、三年のどっちかは、\nさすがに参加してぇよな。"},
        { "location": "511/TALK"    , "narrator": "つばめ", "text": "うん…三回もあるのに\n全部参加できないなんて、\n悲し過ぎるもん。"},
        { "location": "512/TALK"    , "narrator": "つばめ", "text": "それまでに、フェノメノン\n被害をどうにか収束させ\nたいね。"},
        { "location": "514/TALK"    , "narrator": "ヒカル", "text": "そうですね…そうなれば、\n僕たちもみんなと旅行に\n行けると思いますし。"},
        { "location": "515/TALK"    , "narrator": "キリト", "text": "この悔しさと恨みを、\n全部フェノメノンに\nぶつけてやるぜ。"},
        { "location": "516/TALK"    , "narrator": "つばめ", "text": "次の研修旅行は、\n五人全員行けるように\n頑張ろ！"},
        { "location": "517/TALK"    , "narrator": "雛", "text": "…なんか、すっごい\nやる気になっちゃってる\nみたいだね？"},
        { "location": "518/TALK"    , "narrator": "繭", "text": "まあ、一応元気出た\nみたいだし、結果オーライ\nってことで良し。"},
        { "location": "521/TALK"    , "narrator": "繭", "text": "…多分、来年も同じこと\n繰り返すと思うけど…。"},
        { "location": "161/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>7月12日　10:06 AM</color>\nとある平日の休み時間、教室でのこと。"},
        { "location": "435/DIALOG"  , "narrator": "Dialog_GEThimegoto_ch01", "text": "【バケーションじゃなくても】"}
    ]
}
