    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "016_饒舌なるサイレントムービー"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "私ね"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "白黒の無声映画なんてなんでわざわざ観るのかしらって不思議だったわ"},
        { "location": "34/TALK"   , "narrator": "ガブリエラ", "text": "でも観てみたら意外と面白かったし"},
        { "location": "35/TALK"   , "narrator": "ガブリエラ", "text": "迫力もあったわ"},
        { "location": "38/SEL"    , "narrator": "", "text": "渋い趣味が増えるね"},
        { "location": "39/SEL"    , "narrator": "", "text": "時代劇好きなの？"},
        { "location": "40/SEL"    , "narrator": "", "text": "忍者は出てきた？"},
        { "location": "41/ACT"    , "narrator": "", "text": "渋い趣味が増えるね"},
        { "location": "42/TALK"   , "narrator": "ガブリエラ", "text": "趣味にするほどは観ないと思うわ"},
        { "location": "43/TALK"   , "narrator": "ガブリエラ", "text": "たまに観るから面白いような気もするし"},
        { "location": "44/ACT"    , "narrator": "", "text": "時代劇好きなの？"},
        { "location": "46/TALK"   , "narrator": "ガブリエラ", "text": "テレビで放送してる時代劇は時々観るわよ"},
        { "location": "47/TALK"   , "narrator": "ガブリエラ", "text": "武士道って感じがして格好いいわ"},
        { "location": "50/TALK"   , "narrator": "ガブリエラ", "text": "えっとね"},
        { "location": "51/TALK"   , "narrator": "ガブリエラ", "text": "アーヤをはじめて見たのは"},
        { "location": "52/TALK"   , "narrator": "ガブリエラ", "text": "剣道の試合でポーランドに来てる時だったの"},
        { "location": "53/TALK"   , "narrator": "ガブリエラ", "text": "なんかその時のことを思い出しちゃった"},
        { "location": "54/ACT"    , "narrator": "", "text": "忍者は出てきた？"},
        { "location": "55/TALK"   , "narrator": "ガブリエラ", "text": "出てきてないわよ、、、"},
        { "location": "56/TALK"   , "narrator": "ガブリエラ", "text": "外国人といったら忍者好きって思ってるのね"},
        { "location": "57/TALK"   , "narrator": "ガブリエラ", "text": "実際嫌いじゃないけど"},
        { "location": "58/TALK"   , "narrator": "ガブリエラ", "text": "って"},
        { "location": "59/TALK"   , "narrator": "ガブリエラ", "text": "やっぱりそう思われちゃうわね"}
    ]
}
