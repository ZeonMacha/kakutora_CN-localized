        "title": "らぶとーく 第54話",
        "sub_title": "ふりがうまいのね"
    },
    "entry":
    [
        { "location": "1382/SCENARIO", "narrator": "", "text": "ふりがうまいのね"},
        { "location": "1407/TALK"    , "narrator": "神楽", "text": "なんにもなれないぴょんこなのでした"},
        { "location": "1409/SEL"     , "narrator": "", "text": "$me$の恋人でしょ！"},
        { "location": "1410/SEL"     , "narrator": "", "text": "神楽は神楽ってだけで十分だよ"},
        { "location": "1411/SEL"     , "narrator": "", "text": "一人称がぴょんこって時点でｗｗｗ"},
        { "location": "1412/ACT"     , "narrator": "", "text": "$me$の恋人でしょ！"},
        { "location": "1413/TALK"    , "narrator": "神楽", "text": "うん"},
        { "location": "1414/TALK"    , "narrator": "神楽", "text": "そうだけど"},
        { "location": "1415/TALK"    , "narrator": "神楽", "text": "そうだけど"},
        { "location": "1416/ACT"     , "narrator": "", "text": "神楽は神楽ってだけで十分だよ"},
        { "location": "1417/TALK"    , "narrator": "神楽", "text": "そっかな？"},
        { "location": "1418/TALK"    , "narrator": "神楽", "text": "それだけで"},
        { "location": "1419/TALK"    , "narrator": "神楽", "text": "いいのかな？"},
        { "location": "1420/ACT"     , "narrator": "", "text": "一人称がぴょんこって時点でｗｗｗ"},
        { "location": "1421/TALK"    , "narrator": "神楽", "text": "は？"},
        { "location": "1422/TALK"    , "narrator": "神楽", "text": "ぴょんこはぴょんこだし！！！！"},
        { "location": "1424/TALK"    , "narrator": "神楽", "text": "なんかさ"},
        { "location": "1425/TALK"    , "narrator": "神楽", "text": "あれなんでしょ"},
        { "location": "1426/TALK"    , "narrator": "神楽", "text": "適当に楽しげなウソばっかり並べてれば"},
        { "location": "1427/TALK"    , "narrator": "神楽", "text": "ぴょんこのイライラも見なくてすむし"},
        { "location": "1428/TALK"    , "narrator": "神楽", "text": "$handle$はそれでいいんでしょ"},
        { "location": "1429/TALK"    , "narrator": "神楽", "text": "むしろそれがいいんでしょ？？？"},
        { "location": "1430/TALK"    , "narrator": "神楽", "text": "めんどくさくなくて"},
        { "location": "1433/SEL"     , "narrator": "", "text": "そんなこと思ってない"},
        { "location": "1434/SEL"     , "narrator": "", "text": "なんでそうなるの？"},
        { "location": "1435/SEL"     , "narrator": "", "text": "よしよしいい子いい子"},
        { "location": "1436/ACT"     , "narrator": "", "text": "そんなこと思ってない"},
        { "location": "1437/TALK"    , "narrator": "神楽", "text": "またまた"},
        { "location": "1438/TALK"    , "narrator": "神楽", "text": "上手いんだから"},
        { "location": "1439/ACT"     , "narrator": "", "text": "なんでそうなるの？"},
        { "location": "1440/TALK"    , "narrator": "神楽", "text": "なんでって"},
        { "location": "1441/TALK"    , "narrator": "神楽", "text": "本当のことでしょ"},
        { "location": "1442/ACT"     , "narrator": "", "text": "よしよしいい子いい子"},
        { "location": "1443/TALK"    , "narrator": "神楽", "text": "あ？？？？"},
        { "location": "1444/TALK"    , "narrator": "神楽", "text": "ふざけんな"},
        { "location": "1446/TALK"    , "narrator": "神楽", "text": "ぴょんこもう機嫌がいいふりするのも疲れたから"},
        { "location": "1447/TALK"    , "narrator": "神楽", "text": "そういうことしたくない"},
        { "location": "1449/SEL"     , "narrator": "", "text": "今までそうだったんだ…？"},
        { "location": "1450/SEL"     , "narrator": "", "text": "ごめんね無理させて"},
        { "location": "1451/SEL"     , "narrator": "", "text": "今日はずいぶん機嫌が悪いね"},
        { "location": "1452/ACT"     , "narrator": "", "text": "今までそうだったんだ…？"},
        { "location": "1453/TALK"    , "narrator": "神楽", "text": "気付いてなかったんだ？？？"},
        { "location": "1454/ACT"     , "narrator": "", "text": "ごめんね無理させて"},
        { "location": "1455/TALK"    , "narrator": "神楽", "text": "無理っていうか"},
        { "location": "1456/TALK"    , "narrator": "神楽", "text": "ぴょんこが勝手にそういう気分になってるだけだけどー"},
        { "location": "1457/TALK"    , "narrator": "神楽", "text": "でもー"},
        { "location": "1458/ACT"     , "narrator": "", "text": "今日はずいぶん機嫌が悪いね"},
        { "location": "1459/TALK"    , "narrator": "神楽", "text": "今日はじゃないし"},
        { "location": "1461/TALK"    , "narrator": "神楽", "text": "なんだろねこういうの"},
        { "location": "1463/TALK"    , "narrator": "神楽", "text": "ムシャクシャしてやった？？？"},
        { "location": "1465/SEL"     , "narrator": "", "text": "じゃあ今は反省してるの？"},
        { "location": "1466/SEL"     , "narrator": "", "text": "ご機嫌斜めだな～"},
        { "location": "1467/SEL"     , "narrator": "", "text": "全部吐き出せば楽になれるかも"},
        { "location": "1468/ACT"     , "narrator": "", "text": "じゃあ今は反省してるの？"},
        { "location": "1469/TALK"    , "narrator": "神楽", "text": "なんでよ"},
        { "location": "1470/TALK"    , "narrator": "神楽", "text": "なんでそんなことしなきゃいけないの"},
        { "location": "1471/ACT"     , "narrator": "", "text": "ご機嫌斜めだな～"},
        { "location": "1472/TALK"    , "narrator": "神楽", "text": "当たり前でしょ"},
        { "location": "1473/TALK"    , "narrator": "神楽", "text": "そんなの"},
        { "location": "1474/ACT"     , "narrator": "", "text": "全部吐き出せば楽になれるかも"},
        { "location": "1475/TALK"    , "narrator": "神楽", "text": "かもね～～～～？"},
        { "location": "1476/TALK"    , "narrator": "神楽", "text": "そうしたい！！！"},
        { "location": "1478/TALK"    , "narrator": "神楽", "text": "何もかも面倒くさいし"},
        { "location": "1479/TALK"    , "narrator": "神楽", "text": "それなのに$handle$はそういう態度で"},
        { "location": "1480/TALK"    , "narrator": "神楽", "text": "もうどうしようもないっていうか"},
        { "location": "1481/TALK"    , "narrator": "神楽", "text": "あーあーあーあー！"},
        { "location": "1483/SEL"     , "narrator": "", "text": "大変なんだよね…"},
        { "location": "1484/SEL"     , "narrator": "", "text": "代わってあげたいけど"},
        { "location": "1485/SEL"     , "narrator": "", "text": "なんかごめん"},
        { "location": "1486/SEL"     , "narrator": "", "text": "プップクプー！"},
        { "location": "1487/ACT"     , "narrator": "", "text": "大変なんだよね…"},
        { "location": "1488/TALK"    , "narrator": "神楽", "text": "ですよですよdeathよ！？！？"},
        { "location": "1489/ACT"     , "narrator": "", "text": "代わってあげたいけど"},
        { "location": "1490/TALK"    , "narrator": "神楽", "text": "けどとか言ってもそんなの無理だし！！！"},
        { "location": "1491/TALK"    , "narrator": "神楽", "text": "高みの見物ってやつ！？！？！？！？"},
        { "location": "1492/ACT"     , "narrator": "", "text": "なんかごめん"},
        { "location": "1493/TALK"    , "narrator": "神楽", "text": "謝ればいいと思ってる？"},
        { "location": "1494/TALK"    , "narrator": "神楽", "text": "そういうのどうなのかな～～～！"},
        { "location": "1495/ACT"     , "narrator": "", "text": "プップクプー！"},
        { "location": "1496/TALK"    , "narrator": "神楽", "text": "何それ"},
        { "location": "1498/TALK"    , "narrator": "神楽", "text": "パンパカパーン！！！"},
        { "location": "1502/TALK"    , "narrator": "神楽", "text": "なんて"},
        { "location": "1503/TALK"    , "narrator": "神楽", "text": "ほんとは"},
        { "location": "1504/TALK"    , "narrator": "神楽", "text": "たのしくしたいし"},
        { "location": "1505/TALK"    , "narrator": "神楽", "text": "笑っていたいの"},
        { "location": "1506/TALK"    , "narrator": "神楽", "text": "$handle$とは"},
        { "location": "1510/TALK"    , "narrator": "ボイスメール", "text": "元気とか勇気とかその類いのもの"},
        { "location": "1522/DIALOG"  , "narrator": "Dialog_GETVoice", "text": "<color=green>【神楽】</color>のボイスメール\n<color=red>【元気とか勇気とかその類いのもの】</color>\nをゲットしました！"}
    ]
}
