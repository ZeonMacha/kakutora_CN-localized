    "entry":
    [
        { "location": "165/SCENARIO", "narrator": "", "text": "05_000_教室を開くほどでもないが"},
        { "location": "190/TALK"    , "narrator": "みやび", "text": "何事にも慣れは必要ぞね"},
        { "location": "191/TALK"    , "narrator": "みやび", "text": "たとえそれが伝統に基づくものであっても"},
        { "location": "192/TALK"    , "narrator": "みやび", "text": "普段触れていなければ"},
        { "location": "193/TALK"    , "narrator": "みやび", "text": "その伝統は"},
        { "location": "194/TALK"    , "narrator": "みやび", "text": "継承されぬ"},
        { "location": "196/SEL"     , "narrator": "", "text": "何の話？"},
        { "location": "197/ACT"     , "narrator": "", "text": "何の話？"},
        { "location": "199/TALK"    , "narrator": "みやび", "text": "ああ"},
        { "location": "200/TALK"    , "narrator": "みやび", "text": "着付けの話ぞね"},
        { "location": "201/TALK"    , "narrator": "みやび", "text": "浴衣の"},
        { "location": "203/SEL"     , "narrator": "", "text": "確かに伝統だね"},
        { "location": "204/SEL"     , "narrator": "", "text": "習わないと無理だよね"},
        { "location": "205/SEL"     , "narrator": "", "text": "みやびなら人に教えられるよね"},
        { "location": "206/ACT"     , "narrator": "", "text": "確かに伝統だね"},
        { "location": "207/TALK"    , "narrator": "みやび", "text": "うむ"},
        { "location": "208/ACT"     , "narrator": "", "text": "習わないと無理だよね"},
        { "location": "209/TALK"    , "narrator": "みやび", "text": "習うより慣れよ"},
        { "location": "210/ACT"     , "narrator": "", "text": "みやびなら人に教えられるよね"},
        { "location": "212/TALK"    , "narrator": "みやび", "text": "まあ"},
        { "location": "213/TALK"    , "narrator": "みやび", "text": "一応な"},
        { "location": "215/TALK"    , "narrator": "みやび", "text": "そんなわけで"},
        { "location": "216/TALK"    , "narrator": "みやび", "text": "つばめちゃんとガブちゃんに着付けを施した"},
        { "location": "218/SEL"     , "narrator": "", "text": "施すものなの？"},
        { "location": "219/SEL"     , "narrator": "", "text": "着付けてあげたんだ"},
        { "location": "220/SEL"     , "narrator": "", "text": "アーヤは？"},
        { "location": "221/ACT"     , "narrator": "", "text": "施すものなの？"},
        { "location": "222/TALK"    , "narrator": "みやび", "text": "違うかの"},
        { "location": "223/ACT"     , "narrator": "", "text": "着付けてあげたんだ"},
        { "location": "224/TALK"    , "narrator": "みやび", "text": "そうとも言う"},
        { "location": "225/ACT"     , "narrator": "", "text": "アーヤは？"},
        { "location": "226/TALK"    , "narrator": "みやび", "text": "着付ける側ぞね"},
        { "location": "228/TALK"    , "narrator": "みやび", "text": "なかなか華やかだったぞね"},
        { "location": "229/TALK"    , "narrator": "みやび", "text": "これぞ浴衣の醍醐味"},
        { "location": "231/SEL"     , "narrator": "", "text": "楽しそう"},
        { "location": "232/SEL"     , "narrator": "", "text": "大変だったんじゃない"},
        { "location": "233/SEL"     , "narrator": "", "text": "みやびが一番華やかだよ"},
        { "location": "234/ACT"     , "narrator": "", "text": "楽しそう"},
        { "location": "235/TALK"    , "narrator": "みやび", "text": "うむ"},
        { "location": "236/TALK"    , "narrator": "みやび", "text": "あれはいいものだ"},
        { "location": "237/ACT"     , "narrator": "", "text": "大変だったんじゃない"},
        { "location": "238/TALK"    , "narrator": "みやび", "text": "なあに"},
        { "location": "239/TALK"    , "narrator": "みやび", "text": "そうでもない"},
        { "location": "240/TALK"    , "narrator": "みやび", "text": "仕上がりを見れば苦労も報われるぞね"},
        { "location": "241/ACT"     , "narrator": "", "text": "みやびが一番華やかだよ"},
        { "location": "244/TALK"    , "narrator": "みやび", "text": "まあまあ"},
        { "location": "245/TALK"    , "narrator": "みやび", "text": "そんなわかりきったことを"},
        { "location": "246/TALK"    , "narrator": "みやび", "text": "言うでない"},
        { "location": "250/TALK"    , "narrator": "みやび", "text": "今度は正月にでも"},
        { "location": "251/TALK"    , "narrator": "みやび", "text": "晴着を着せたい"},
        { "location": "252/TALK"    , "narrator": "みやび", "text": "が"},
        { "location": "253/TALK"    , "narrator": "みやび", "text": "ちっくと難易度が高いちや"},
        { "location": "254/TALK"    , "narrator": "みやび", "text": "要検討ぞね"}
    ]
}
