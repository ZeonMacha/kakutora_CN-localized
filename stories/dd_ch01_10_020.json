{
    "dir": "chap10/daydra/dd_ch01_10_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "10156",
        "cid": "tsubame",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "クラスメイトからの頼み"
    },
    "entry":
    [
        { "location": "253/SCENARIO", "narrator": "", "text": "クラスメイトからの頼み"},
        { "location": "269/TALK"    , "narrator": "女子高校生Ａ", "text": "逢瀬さん。"},
        { "location": "271/TALK"    , "narrator": "つばめ", "text": "え？"},
        { "location": "272/TALK"    , "narrator": "つばめ", "text": "あ…この人たちって、\n確か同じクラスの…。"},
        { "location": "273/TALK"    , "narrator": "つばめ", "text": "え、えっと…なんですか？"},
        { "location": "275/TALK"    , "narrator": "女子高校生Ａ", "text": "うん…急で驚かせちゃう\nかもしれないんだけど――"},
        { "location": "276/TALK"    , "narrator": "女子高校生Ａ", "text": "今度さ、一緒にどこか\n遊びに行かない？"},
        { "location": "278/TALK"    , "narrator": "つばめ", "text": "えっ！？"},
        { "location": "279/TALK"    , "narrator": "女子高校生Ｂ", "text": "やっぱ驚かせちゃった？\nてか、急だもんね。"},
        { "location": "280/TALK"    , "narrator": "女子高校生Ａ", "text": "ごめん！\nでも、ずっと声かけたい\nって思ってたんだ。"},
        { "location": "282/TALK"    , "narrator": "女子高校生Ａ", "text": "ただ、その…。"},
        { "location": "283/TALK"    , "narrator": "女子高校生Ｂ", "text": "特別攻撃隊の人だから、\n気軽に声掛けていいの\nかな、って思ってさ。"},
        { "location": "284/TALK"    , "narrator": "女子高校生Ｂ", "text": "ほら、なんとなくだけど、\n声掛けづらい人達が多い\nイメージあるし。"},
        { "location": "286/TALK"    , "narrator": "つばめ", "text": "えっと…誰のことかは\n聞かないでおくけど…。"},
        { "location": "288/TALK"    , "narrator": "つばめ", "text": "わたしも、みんなと同じ\n普通の高校生ですから…。"},
        { "location": "290/TALK"    , "narrator": "女子高校生Ａ", "text": "うん。\n日向さん達と一緒にいるの\n見て、やっとわかったの。"},
        { "location": "291/TALK"    , "narrator": "女子高校生Ａ", "text": "だから、今更ではある\nけど、逢瀬さんと仲良く\nなりたいなぁ、って…。"},
        { "location": "292/TALK"    , "narrator": "女子高校生Ａ", "text": "…ダメかな？"},
        { "location": "294/TALK"    , "narrator": "つばめ", "text": "そんな、ダメじゃないよ！"},
        { "location": "295/TALK"    , "narrator": "つばめ", "text": "わたしだって、その…\nお友達いっぱい作りたい、\nって思ってたし…。"},
        { "location": "296/TALK"    , "narrator": "女子高校生Ｂ", "text": "やった！\nじゃあ、決まりだね。"},
        { "location": "298/TALK"    , "narrator": "つばめ", "text": "う、うん。\nよろしくお願いします。"},
        { "location": "299/TALK"    , "narrator": "女子高校生Ａ", "text": "ありがとう、逢瀬さん。"},
        { "location": "300/TALK"    , "narrator": "女子高校生Ａ", "text": "それで、逢瀬さんは\nどういうところに\n行きたい？"},
        { "location": "303/TALK"    , "narrator": "つばめ", "text": "えっと…実はまだ、\nあまり東京のことには\n詳しくなくて…。"},
        { "location": "304/TALK"    , "narrator": "女子高校生Ｂ", "text": "じゃあ、こっちで適当に\n決めとくから、決まったら\n伝える感じでいい？"},
        { "location": "306/TALK"    , "narrator": "つばめ", "text": "うん、お任せします。"},
        { "location": "307/TALK"    , "narrator": "女子高校生Ａ", "text": "オッケー。\n楽しいとこ選んどくから、\n楽しみにしててね。"},
        { "location": "314/TALK"    , "narrator": "つばめ", "text": "…えへへ。"},
        { "location": "326/TALK"    , "narrator": "つばめ", "text": "聞いて聞いて、今凄く嬉しいことがあったの！"},
        { "location": "327/TALK"    , "narrator": "つばめ", "text": "クラスの女の子に話しかけられて、お友達になろう、って言われちゃった"},
        { "location": "328/TALK"    , "narrator": "つばめ", "text": "今度一緒に出掛ける約束もしたんだよ"},
        { "location": "329/TALK"    , "narrator": "つばめ", "text": "今から楽しみだなぁ"},
        { "location": "331/SEL"     , "narrator": "", "text": "放課後早速、はダメなの？"},
        { "location": "332/SEL"     , "narrator": "", "text": "新しいお友達、おめでとう"},
        { "location": "333/ACT"     , "narrator": "", "text": "放課後早速、はダメなの？"},
        { "location": "335/TALK"    , "narrator": "つばめ", "text": "あ、それいいかも、ナイスアイデア！"},
        { "location": "347/TALK"    , "narrator": "つばめ", "text": "…まだ、よく知らない人に\n声かけるのって緊張する\nけど――"},
        { "location": "348/TALK"    , "narrator": "つばめ", "text": "でも、あの子達はわたしに\n声かけてくれたんだもん。\nわたしも、頑張らなきゃ！"},
        { "location": "361/TALK"    , "narrator": "つばめ", "text": "…ちょ、ちょっと待って！"},
        { "location": "363/TALK"    , "narrator": "女子高校生Ｂ", "text": "ん？"},
        { "location": "365/TALK"    , "narrator": "女子高校生Ａ", "text": "どうしたの？"},
        { "location": "366/TALK"    , "narrator": "つばめ", "text": "あのね…もし、今日時間が\n空いてるなら――"},
        { "location": "367/TALK"    , "narrator": "つばめ", "text": "一緒に、カフェに\n行きませんか？"},
        { "location": "368/TALK"    , "narrator": "つばめ", "text": "わたしも、二人のこと\n早く知りたいし――"},
        { "location": "369/TALK"    , "narrator": "つばめ", "text": "どこへ行くのかも、\n一緒に話し合えたら\n楽しいかな、って…。"},
        { "location": "370/TALK"    , "narrator": "女子高校生Ｂ", "text": "あ、いいねそれ。"},
        { "location": "371/TALK"    , "narrator": "女子高校生Ｂ", "text": "あたしはオッケーだよ。\nてか、早ければ早いだけ\n嬉しいし。"},
        { "location": "372/TALK"    , "narrator": "女子高校生Ａ", "text": "私も！\nどこのカフェにする？"},
        { "location": "373/TALK"    , "narrator": "つばめ", "text": "あ、あの――"},
        { "location": "375/TALK"    , "narrator": "つばめ", "text": "帰りに、よく行くカフェが\nあるから、よかったら\nそこはどうかな？"},
        { "location": "376/TALK"    , "narrator": "女子高校生Ａ", "text": "お茶とケーキが\n美味しければ文句なし！"},
        { "location": "377/TALK"    , "narrator": "女子高校生Ｂ", "text": "同じく！\n放課後が楽しみだなぁ。"},
        { "location": "379/TALK"    , "narrator": "つばめ", "text": "わたしもです。\n早く放課後にならない\nかなぁ…。"},
        { "location": "397/ACT"     , "narrator": "", "text": "新しいお友達、おめでとう"},
        { "location": "398/TALK"    , "narrator": "つばめ", "text": "ありがとう！"},
        { "location": "399/TALK"    , "narrator": "つばめ", "text": "東京に出てきてから、ビックリするくらいお友達ができてるよ"},
        { "location": "400/TALK"    , "narrator": "つばめ", "text": "ひなこちゃん達もそうだし、今の子達もそうだし"},
        { "location": "401/TALK"    , "narrator": "つばめ", "text": "お友達になりたい、って言ってくれる人がいるのって、凄く幸せだよ"},
        { "location": "412/TALK"    , "narrator": "つばめ", "text": "…あっ！"},
        { "location": "413/TALK"    , "narrator": "つばめ", "text": "そうだ、今日の放課後、\nバイトおやすみだった\nんだ！"},
        { "location": "414/TALK"    , "narrator": "つばめ", "text": "お茶しに行こう、って\n誘えばよかったかも…\n失敗しちゃったなぁ…。"},
        { "location": "416/TALK"    , "narrator": "つばめ", "text": "っていうかわたし、\n完全に受け身になってる？"},
        { "location": "417/TALK"    , "narrator": "つばめ", "text": "反省しよう…。\n今度、わたしの方から\nどこか誘ってみようかな？"},
        { "location": "264/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>6月10日　10:06 AM</color>\n平日午前中の休み時間、教室にて。"},
        { "location": "391/DIALOG"  , "narrator": "Dialog_GEThimegoto_ch01", "text": "【百人までの第一歩】"}
    ]
}
