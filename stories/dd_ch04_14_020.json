{
    "dir": "chap14/daydra/dd_ch04_14_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "14456",
        "cid": "miyabi",
        "title": "Extra005 プレミアムストーリー",
        "sub_title": "國政綾水と逝くPC"
    },
    "entry":
    [
        { "location": "470/SCENARIO", "narrator": "", "text": "アーヤＭＶ回２"},
        { "location": "481/TALK"    , "narrator": "アーヤ", "text": "さて、と。\n夕飯も終わったし――"},
        { "location": "482/TALK"    , "narrator": "アーヤ", "text": "次の劇の台本でも\n読み直そうかしら？"},
        { "location": "485/TALK"    , "narrator": "透明みやび", "text": "うわああああああああ\nああああああああああ\nああああああああ！！"},
        { "location": "489/TALK"    , "narrator": "アーヤ", "text": "っ！？\nこの声、みやび！？"},
        { "location": "503/TALK"    , "narrator": "つばめ", "text": "みやびさん！\nどうしたんですか！？\nみやびさん！！"},
        { "location": "509/TALK"    , "narrator": "アーヤ", "text": "つばめ！"},
        { "location": "511/TALK"    , "narrator": "つばめ", "text": "あ、アーヤさん！\nみやびさんが…。"},
        { "location": "512/TALK"    , "narrator": "アーヤ", "text": "わかってる。\n返事はないの？"},
        { "location": "514/TALK"    , "narrator": "つばめ", "text": "はい。\nみやびさん、\nみやびさん！"},
        { "location": "521/TALK"    , "narrator": "ガブリエラ", "text": "ちょっと、さっきの\n声ってみやびよね？\n何かあったの？"},
        { "location": "522/TALK"    , "narrator": "アーヤ", "text": "わからないわ。\n返事もないし…。"},
        { "location": "523/TALK"    , "narrator": "つばめ", "text": "みやびさーん！！"},
        { "location": "537/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "538/TALK"    , "narrator": "みやび", "text": "終わった…。\nさらば、相棒よ…。"},
        { "location": "550/TALK"    , "narrator": "みやび", "text": "相棒"},
        { "location": "551/TALK"    , "narrator": "みやび", "text": "死去なう"},
        { "location": "553/SEL"     , "narrator": "", "text": "生きてるよ！？"},
        { "location": "554/ACT"     , "narrator": "", "text": "生きてるよ！？"},
        { "location": "556/TALK"    , "narrator": "みやび", "text": "相棒ゆうても"},
        { "location": "557/TALK"    , "narrator": "みやび", "text": "うちのＰＣの方や"},
        { "location": "558/TALK"    , "narrator": "みやび", "text": "たった今"},
        { "location": "559/TALK"    , "narrator": "みやび", "text": "逝ってしまわれた"},
        { "location": "560/TALK"    , "narrator": "みやび", "text": "雲の向こう"},
        { "location": "561/TALK"    , "narrator": "みやび", "text": "機械の天国へ"},
        { "location": "562/TALK"    , "narrator": "みやび", "text": "煙りとともに"},
        { "location": "564/SEL"     , "narrator": "", "text": "修理不能っぽい？"},
        { "location": "565/ACT"     , "narrator": "", "text": "修理不能っぽい？"},
        { "location": "567/TALK"    , "narrator": "みやび", "text": "焦げ臭さマックス"},
        { "location": "568/TALK"    , "narrator": "みやび", "text": "無理やね"},
        { "location": "570/TALK"    , "narrator": "みやび", "text": "ちゅうか"},
        { "location": "572/TALK"    , "narrator": "みやび", "text": "ドアうるさいき"},
        { "location": "573/TALK"    , "narrator": "みやび", "text": "相棒から連絡よろ"},
        { "location": "576/SEL"     , "narrator": "", "text": "声掛けないの？"},
        { "location": "577/ACT"     , "narrator": "", "text": "声掛けないの？"},
        { "location": "579/TALK"    , "narrator": "みやび", "text": "気力なし"},
        { "location": "580/TALK"    , "narrator": "みやび", "text": "大切な物を失った人の気持ち"},
        { "location": "581/TALK"    , "narrator": "みやび", "text": "察せよ"},
        { "location": "592/TALK"    , "narrator": "みやび", "text": "…バックアップは\n取っちょるけんど――"},
        { "location": "593/TALK"    , "narrator": "みやび", "text": "やはり、精神に\nドカンと大ダメージ\nくるなぁ…。"},
        { "location": "595/TALK"    , "narrator": "みやび", "text": "はぁ…。"},
        { "location": "610/TALK"    , "narrator": "つばめ", "text": "みやびさん！！\n大丈夫ですか！？\n何があったんですか！"},
        { "location": "612/TALK"    , "narrator": "ガブリエラ", "text": "…ねえ、これって\nヤバいんじゃない？"},
        { "location": "614/TALK"    , "narrator": "アーヤ", "text": "そうね…。\n部屋で倒れてたり\nしたら大変だし。"},
        { "location": "617/TALK"    , "narrator": "つばめ", "text": "えぇっ！？"},
        { "location": "619/TALK"    , "narrator": "アーヤ", "text": "館長に連絡するわ。"},
        { "location": "621/SEL"     , "narrator": "", "text": "おーい"},
        { "location": "622/ACT"     , "narrator": "", "text": "おーい"},
        { "location": "628/TALK"    , "narrator": "アーヤ", "text": "ごめんなさい"},
        { "location": "629/TALK"    , "narrator": "アーヤ", "text": "今は話せないから"},
        { "location": "631/SEL"     , "narrator": "", "text": "みやびは無事だよ"},
        { "location": "632/SEL"     , "narrator": "", "text": "みやびが死んじゃう！！"},
        { "location": "633/ACT"     , "narrator": "", "text": "みやびは無事だよ"},
        { "location": "634/TALK"    , "narrator": "アーヤ", "text": "そうなの？工ｴｴｪｪ(´д｀)ｪｪｴｴ工"},
        { "location": "635/TALK"    , "narrator": "アーヤ", "text": "じゃあ"},
        { "location": "636/TALK"    , "narrator": "アーヤ", "text": "さっきの声はなに？"},
        { "location": "638/SEL"     , "narrator": "", "text": "ＰＣが壊れて、今は放心状態"},
        { "location": "639/ACT"     , "narrator": "", "text": "ＰＣが壊れて、今は放心状態"},
        { "location": "643/TALK"    , "narrator": "アーヤ", "text": "ああ"},
        { "location": "644/TALK"    , "narrator": "アーヤ", "text": "そういうこと"},
        { "location": "645/TALK"    , "narrator": "アーヤ", "text": "なんか"},
        { "location": "647/TALK"    , "narrator": "アーヤ", "text": "納得だわ(-.-;)"},
        { "location": "659/TALK"    , "narrator": "アーヤ", "text": "…二人とも。\nみやびは無事みたい。"},
        { "location": "661/TALK"    , "narrator": "ガブリエラ", "text": "どう考えても\n無事っぽくない\n声だったけど？"},
        { "location": "662/TALK"    , "narrator": "アーヤ", "text": "なんか、みやびの\nＰＣが壊れちゃった\nみたいなの。"},
        { "location": "663/TALK"    , "narrator": "アーヤ", "text": "さっきの声は\nそれが原因らしいわ。"},
        { "location": "665/TALK"    , "narrator": "つばめ", "text": "じゃあ、みやびさんは\n無事なんですね？"},
        { "location": "667/TALK"    , "narrator": "アーヤ", "text": "ショックは受けてる\nみたいだけどね。"},
        { "location": "669/TALK"    , "narrator": "ガブリエラ", "text": "何よそれ！？\n人騒がせなん\nだから…。"},
        { "location": "670/TALK"    , "narrator": "つばめ", "text": "で、でも、無事で\nよかったよ。"},
        { "location": "672/TALK"    , "narrator": "ガブリエラ", "text": "バカバカしい…。\n部屋戻るわ。"},
        { "location": "675/TALK"    , "narrator": "つばめ", "text": "あ、ガブちゃん！"},
        { "location": "676/TALK"    , "narrator": "つばめ", "text": "…みやびさん、\n本当に大丈夫なん\nですか？"},
        { "location": "677/TALK"    , "narrator": "アーヤ", "text": "ん～、多分ね。"},
        { "location": "679/TALK"    , "narrator": "アーヤ", "text": "とにかく、つばめも\n部屋に戻って。"},
        { "location": "680/TALK"    , "narrator": "つばめ", "text": "わかりました。\nそれじゃあ…。"},
        { "location": "685/TALK"    , "narrator": "アーヤ", "text": "…まったく、\n人騒がせなん\nだから…。"},
        { "location": "697/TALK"    , "narrator": "アーヤ", "text": "確認するけど"},
        { "location": "698/TALK"    , "narrator": "アーヤ", "text": "本当にみやびは大丈夫？"},
        { "location": "700/SEL"     , "narrator": "", "text": "ショック受けてるから、大丈夫じゃないかも"},
        { "location": "701/ACT"     , "narrator": "", "text": "ショック受けてるから、大丈夫じゃないかも"},
        { "location": "703/TALK"    , "narrator": "アーヤ", "text": "そう"},
        { "location": "704/TALK"    , "narrator": "アーヤ", "text": "まったく"},
        { "location": "705/TALK"    , "narrator": "アーヤ", "text": "大袈裟過ぎるわ(｀ヘ´)"},
        { "location": "707/TALK"    , "narrator": "アーヤ", "text": "何台もＰＣ持ってるのに"},
        { "location": "708/TALK"    , "narrator": "アーヤ", "text": "一台壊れたくらいで"},
        { "location": "709/TALK"    , "narrator": "アーヤ", "text": "困ったものね(-ω-;)"},
        { "location": "711/SEL"     , "narrator": "", "text": "アーヤにとってのバイクみたいなもの"},
        { "location": "712/ACT"     , "narrator": "", "text": "アーヤにとってのバイクみたいなもの"},
        { "location": "715/TALK"    , "narrator": "アーヤ", "text": "前言撤回するわ"},
        { "location": "716/TALK"    , "narrator": "アーヤ", "text": "それ"},
        { "location": "717/TALK"    , "narrator": "アーヤ", "text": "凄いショックよ(；´Д｀)"},
        { "location": "718/TALK"    , "narrator": "アーヤ", "text": "落ち込んで当然よね"},
        { "location": "719/TALK"    , "narrator": "アーヤ", "text": "ううん"},
        { "location": "720/TALK"    , "narrator": "アーヤ", "text": "大泣きしてもいいレベルよ(; ;)"},
        { "location": "731/TALK"    , "narrator": "アーヤ", "text": "…今日は、\nそっとしておいた方が\nよさそうね。"},
        { "location": "732/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "734/TALK"    , "narrator": "アーヤ", "text": "でも、それは少し\n薄情かしら…？"},
        { "location": "744/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "746/TALK"    , "narrator": "みやび", "text": "…いかん。\n立ち直れん…。"},
        { "location": "747/TALK"    , "narrator": "みやび", "text": "マジ、ショックが\nデカすぎて…。"},
        { "location": "751/TALK"    , "narrator": "みやび", "text": "…相棒か？"},
        { "location": "763/TALK"    , "narrator": "アーヤ", "text": "みやび"},
        { "location": "764/TALK"    , "narrator": "アーヤ", "text": "平気？"},
        { "location": "768/TALK"    , "narrator": "アーヤ", "text": "そう"},
        { "location": "769/TALK"    , "narrator": "アーヤ", "text": "気の済むまで"},
        { "location": "770/TALK"    , "narrator": "アーヤ", "text": "暴れていいし"},
        { "location": "771/TALK"    , "narrator": "アーヤ", "text": "泣いてもいいから"},
        { "location": "772/TALK"    , "narrator": "アーヤ", "text": "落ち着いたら"},
        { "location": "773/TALK"    , "narrator": "アーヤ", "text": "部屋にきて"},
        { "location": "774/TALK"    , "narrator": "アーヤ", "text": "ご飯くらい作るから(^^"},
        { "location": "786/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "788/TALK"    , "narrator": "みやび", "text": "…アホやねぇ。"},
        { "location": "790/TALK"    , "narrator": "みやび", "text": "こんな精密機械\nだらけの部屋で――"},
        { "location": "791/TALK"    , "narrator": "みやび", "text": "暴れられるわけ、\nないやないか…。\nぐすっ、うっ…。"},
        { "location": "792/ACT"     , "narrator": "", "text": "みやびが死んじゃう！！"},
        { "location": "793/TALK"    , "narrator": "アーヤ", "text": "死んじゃう！？"},
        { "location": "795/TALK"    , "narrator": "アーヤ", "text": "何で！？"},
        { "location": "807/TALK"    , "narrator": "アーヤ", "text": "みやび！？\nみやび、返事して！！\nみやびってば！！"},
        { "location": "814/TALK"    , "narrator": "ガブリエラ", "text": "ちょ、アーヤ！？\nどうしたのよ急に！！"},
        { "location": "816/TALK"    , "narrator": "アーヤ", "text": "わからないけど、\nみやび、死んじゃう\nかもしれないのよ！"},
        { "location": "818/TALK"    , "narrator": "ガブリエラ", "text": "えぇっ！？"},
        { "location": "819/TALK"    , "narrator": "つばめ", "text": "そ、そんな…。\nみやびさん！！\nみやびさん！！"},
        { "location": "825/TALK"    , "narrator": "アーヤ", "text": "みやび！！\n死んじゃダメよ！！\n聞こえてる！？"},
        { "location": "826/TALK"    , "narrator": "アーヤ", "text": "すぐ開けるから、\n死なないで！！"},
        { "location": "828/TALK"    , "narrator": "つばめ", "text": "アーヤさん！\n合鍵とかって\nないんですか？"},
        { "location": "830/TALK"    , "narrator": "アーヤ", "text": "館長が持ってるから、\n劇場に行かないと…。"},
        { "location": "833/TALK"    , "narrator": "ガブリエラ", "text": "アーヤ、緊急事態よ！\nこうなったら――"},
        { "location": "834/TALK"    , "narrator": "ガブリエラ", "text": "ドアをぶち破るしか\nないわ！"},
        { "location": "836/TALK"    , "narrator": "つばめ", "text": "えぇっ！？"},
        { "location": "838/TALK"    , "narrator": "ガブリエラ", "text": "みやびが死ぬかも\nしれないのよ！？"},
        { "location": "839/TALK"    , "narrator": "ガブリエラ", "text": "人命に比べたら\nドア一枚くらい\nなによ！？"},
        { "location": "841/TALK"    , "narrator": "アーヤ", "text": "…そうね。"},
        { "location": "842/TALK"    , "narrator": "アーヤ", "text": "ギャヴィは\nドアを壊せそうな物を\n探して――"},
        { "location": "843/TALK"    , "narrator": "アーヤ", "text": "つばめは館長から\n合鍵を貰ってきて。"},
        { "location": "845/TALK"    , "narrator": "つばめ", "text": "は、はい！"},
        { "location": "847/TALK"    , "narrator": "ガブリエラ", "text": "わかったわ。"},
        { "location": "848/TALK"    , "narrator": "アーヤ", "text": "それじゃ、急いで――"},
        { "location": "854/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "856/TALK"    , "narrator": "アーヤ", "text": "み、みやび！？"},
        { "location": "858/TALK"    , "narrator": "つばめ", "text": "みやびさん！！\n大丈夫ですか！？"},
        { "location": "861/TALK"    , "narrator": "みやび", "text": "…あんたら、\n人の部屋の前で\n何を騒いどるが？"},
        { "location": "863/TALK"    , "narrator": "ガブリエラ", "text": "あんた、平気なの？\n死にそうなんじゃ…。"},
        { "location": "865/TALK"    , "narrator": "みやび", "text": "…うちが？"},
        { "location": "867/TALK"    , "narrator": "みやび", "text": "この通り、ピンピン\nしちゅうがよ。"},
        { "location": "868/TALK"    , "narrator": "つばめ", "text": "そ、そうですか？\n元気ないように\n見えますけど…。"},
        { "location": "871/TALK"    , "narrator": "みやび", "text": "…相棒がな。"},
        { "location": "873/TALK"    , "narrator": "みやび", "text": "大切な相棒が…、\n死んでしもうてな…。"},
        { "location": "874/TALK"    , "narrator": "ガブリエラ", "text": "えっ…死んだ？"},
        { "location": "877/TALK"    , "narrator": "みやび", "text": "うむ…まあ、\nそういうわけや。"},
        { "location": "878/TALK"    , "narrator": "みやび", "text": "やき、うちのハートは\n今、喪中ながよ。"},
        { "location": "882/TALK"    , "narrator": "みやび", "text": "悪いけんど、\nそっとしといて\nもらえんか？"},
        { "location": "883/TALK"    , "narrator": "アーヤ", "text": "そ、そっか…。\nわかったわ。"},
        { "location": "885/TALK"    , "narrator": "ガブリエラ", "text": "まあ、相棒ってのが\n誰かは知らない\nけど――"},
        { "location": "886/TALK"    , "narrator": "ガブリエラ", "text": "元気出しなさいよ？"},
        { "location": "887/TALK"    , "narrator": "つばめ", "text": "何かあったら、\nいつでも声かけて\nくださいね！"},
        { "location": "890/TALK"    , "narrator": "みやび", "text": "ん…じゃあ。"},
        { "location": "905/TALK"    , "narrator": "みやび", "text": "…はぁ。"},
        { "location": "917/TALK"    , "narrator": "みやび", "text": "おい相棒"},
        { "location": "918/TALK"    , "narrator": "みやび", "text": "どんなデマ流しよった？"},
        { "location": "920/SEL"     , "narrator": "", "text": "みやびが死んじゃう、って"},
        { "location": "921/ACT"     , "narrator": "", "text": "みやびが死んじゃう、って"},
        { "location": "923/TALK"    , "narrator": "みやび", "text": "なぜそんなことを！？"},
        { "location": "924/TALK"    , "narrator": "みやび", "text": "そんなこと言うたらどうなるか"},
        { "location": "925/TALK"    , "narrator": "みやび", "text": "察せなかったが？"},
        { "location": "926/TALK"    , "narrator": "みやび", "text": "ちゅうか"},
        { "location": "927/TALK"    , "narrator": "みやび", "text": "うちの気持ちも察せてなかった？"},
        { "location": "928/TALK"    , "narrator": "みやび", "text": "やはり"},
        { "location": "930/TALK"    , "narrator": "みやび", "text": "人は言葉を交わさんとわかりあえん"},
        { "location": "931/TALK"    , "narrator": "みやび", "text": "そういうことなのかもしれん"},
        { "location": "932/TALK"    , "narrator": "みやび", "text": "悲しい発見をした夏の夜"},
        { "location": "933/TALK"    , "narrator": "みやび", "text": "Ｂｙみやび"},
        { "location": "944/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "945/TALK"    , "narrator": "みやび", "text": "怒ったからか？\nびみょ～にやけんど、\n気持ち軽くなったな。"},
        { "location": "947/TALK"    , "narrator": "みやび", "text": "…新しいＰＣでも、\nのんびり組むか…。"},
        { "location": "480/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>6月28日　7:48 PM</color>\nとある平日の夜、寮「とらいあんぐる」アーヤの部屋。"}
    ]
}
