{
    "dir": "chap00/daydra/spev_ch04_014.js",
    "type": "",
    "info": {
        "story_id": "4014",
        "cid": "",
        "title": "スペシャルエピソード",
        "sub_title": "とうちゃんどんちゃん騒ぎ"
    },
    "entry":
    [
        { "location": "29/TALK" , "narrator": "とうちゃん", "text": "ガーッハハハハハ！！\nいやー、チキンもビールも\n最高だなぁ！"},
        { "location": "31/TALK" , "narrator": "透明みやび", "text": "ぶはっ、あははははは！！\nと、とうちゃん、\nそれ面白過ぎや！"},
        { "location": "32/TALK" , "narrator": "とうちゃん", "text": "なんだなんだ？\n俺の食いっぷりが\nそんなにおかしいのか？"},
        { "location": "35/TALK" , "narrator": "透明みやび", "text": "頭や、頭！\nなんやそれ、\nトナカイ角やろ？"},
        { "location": "36/TALK" , "narrator": "とうちゃん", "text": "よくわかったな。\nどうだ、可愛いだろ？"},
        { "location": "39/TALK" , "narrator": "透明みやび", "text": "や、やめぃ、うちのこと\n笑い殺す気か！？"},
        { "location": "40/TALK" , "narrator": "透明みやび", "text": "とうちゃんみたいな\n怖い顔したトナカイなんぞ\nいたら堪らんぞね。"},
        { "location": "41/TALK" , "narrator": "とうちゃん", "text": "いいじゃねぇか。\n怖いトナカイってのも\n可愛いもんだろうが。"},
        { "location": "43/TALK" , "narrator": "透明みやび", "text": "ふむ…まあ、確かに\n見慣れてくると、\nありな感じするぞね。"},
        { "location": "44/TALK" , "narrator": "透明みやび", "text": "ゆうても、角しか\nトナカイ要素\nないけんどな。"},
        { "location": "45/TALK" , "narrator": "とうちゃん", "text": "鼻くらい赤くした方が\nよかったか？"},
        { "location": "46/TALK" , "narrator": "透明みやび", "text": "お、塗るか？\nマジックあるぞね。"},
        { "location": "47/TALK" , "narrator": "とうちゃん", "text": "ガハハハ、いらねぇよ。\nなんたって俺は――"},
        { "location": "53/TALK" , "narrator": "とうちゃん", "text": "鼻の代わりに\n目が赤いからな！"},
        { "location": "55/TALK" , "narrator": "透明みやび", "text": "ぶはっ！？\nあははははは！！"},
        { "location": "56/TALK" , "narrator": "透明みやび", "text": "そ、それじゃトナカイ\nじゃなくて、ウサギちや！"},
        { "location": "57/TALK" , "narrator": "とうちゃん", "text": "おーい、誰か！\nうさ耳持ってるヤツ\nいねぇかぁ！？"},
        { "location": "58/TALK" , "narrator": "透明みやび", "text": "ひーっ、とうちゃんに\n笑い殺されるがよー！"},
        { "location": "59/SEL"  , "narrator": "（選択肢）", "text": "酔っ払ってるの？"},
        { "location": "60/ACT"  , "narrator": "", "text": "酔っ払ってるの？"},
        { "location": "68/TALK" , "narrator": "みやび", "text": "失礼な"},
        { "location": "70/TALK" , "narrator": "みやび", "text": "うちは不真面目ではあっても"},
        { "location": "71/TALK" , "narrator": "みやび", "text": "不良ではない"},
        { "location": "72/TALK" , "narrator": "みやび", "text": "まあ"},
        { "location": "73/TALK" , "narrator": "みやび", "text": "不真面目でもないのだが"},
        { "location": "74/TALK" , "narrator": "みやび", "text": "酔ってると思ったか？"},
        { "location": "75/SEL"  , "narrator": "（選択肢）", "text": "テンション高かったから、つい…"},
        { "location": "76/SEL"  , "narrator": "（選択肢）", "text": "酔ってる人ほど酔ってないという"},
        { "location": "77/ACT"  , "narrator": "", "text": "テンション高かったから、つい…"},
        { "location": "78/TALK" , "narrator": "みやび", "text": "単純過ぎないか？"},
        { "location": "79/TALK" , "narrator": "みやび", "text": "楽しい楽しいクリスマスパーティー"},
        { "location": "80/TALK" , "narrator": "みやび", "text": "テンション低く祝うバカはいない"},
        { "location": "81/TALK" , "narrator": "みやび", "text": "そうであろう？"},
        { "location": "82/ACT"  , "narrator": "", "text": "酔ってる人ほど酔ってないという"},
        { "location": "83/TALK" , "narrator": "みやび", "text": "うちは飲んでない"},
        { "location": "84/TALK" , "narrator": "みやび", "text": "$handle$こそ"},
        { "location": "85/TALK" , "narrator": "みやび", "text": "自分の判断に酔っているのだ"},
        { "location": "86/TALK" , "narrator": "みやび", "text": "まあ酒ではないが"},
        { "location": "87/TALK" , "narrator": "みやび", "text": "この場の雰囲気には"},
        { "location": "88/TALK" , "narrator": "みやび", "text": "若干酔っておる"},
        { "location": "89/TALK" , "narrator": "みやび", "text": "かもしれん"},
        { "location": "91/TALK" , "narrator": "みやび", "text": "しかし"},
        { "location": "92/TALK" , "narrator": "みやび", "text": "こうしてクラン達と"},
        { "location": "93/TALK" , "narrator": "みやび", "text": "飲んで食べてのどんちゃん騒ぎ"},
        { "location": "94/TALK" , "narrator": "みやび", "text": "楽しくて堪らん"},
        { "location": "96/TALK" , "narrator": "みやび", "text": "こういうの"},
        { "location": "97/TALK" , "narrator": "みやび", "text": "嫌いではないぞね"},
        { "location": "98/SEL"  , "narrator": "（選択肢）", "text": "楽しそうだと思う"},
        { "location": "99/SEL"  , "narrator": "（選択肢）", "text": "みやびもこういうの好きなんだ？"},
        { "location": "100/ACT" , "narrator": "", "text": "楽しそうだと思う"},
        { "location": "101/TALK", "narrator": "みやび", "text": "羨ましいか？"},
        { "location": "102/TALK", "narrator": "みやび", "text": "できることなら"},
        { "location": "103/TALK", "narrator": "みやび", "text": "誘ってやりたいが"},
        { "location": "104/TALK", "narrator": "みやび", "text": "誘っても来れないだろう？"},
        { "location": "106/TALK", "narrator": "みやび", "text": "というか"},
        { "location": "107/TALK", "narrator": "みやび", "text": "来れるならもっと早く来いと"},
        { "location": "108/TALK", "narrator": "みやび", "text": "うちの長時間文句の餌食になるわけなのだが"},
        { "location": "109/ACT" , "narrator": "", "text": "みやびもこういうの好きなんだ？"},
        { "location": "110/TALK", "narrator": "みやび", "text": "仲間内でわいわい"},
        { "location": "111/TALK", "narrator": "みやび", "text": "嫌いじゃない"},
        { "location": "112/TALK", "narrator": "みやび", "text": "というか好ましい"},
        { "location": "114/TALK", "narrator": "みやび", "text": "人混みは嫌いだがな"},
        { "location": "115/TALK", "narrator": "みやび", "text": "好みうるさいと思うか？"},
        { "location": "116/TALK", "narrator": "みやび", "text": "ほっとけ"},
        { "location": "118/TALK", "narrator": "みやび", "text": "まあとにかく"},
        { "location": "119/TALK", "narrator": "みやび", "text": "話しかけてもらえてよかった"},
        { "location": "120/TALK", "narrator": "みやび", "text": "楽しすぎてうっかりだったが"},
        { "location": "121/TALK", "narrator": "みやび", "text": "言うことがあったのだ"},
        { "location": "122/TALK", "narrator": "みやび", "text": "聞く準備は？"},
        { "location": "123/SEL" , "narrator": "（選択肢）", "text": "ＯＫ！！"},
        { "location": "124/SEL" , "narrator": "（選択肢）", "text": "あ、その前にトイレ"},
        { "location": "125/ACT" , "narrator": "", "text": "ＯＫ！！"},
        { "location": "126/TALK", "narrator": "みやび", "text": "まあ"},
        { "location": "127/TALK", "narrator": "みやび", "text": "簡単なことなのだが"},
        { "location": "129/TALK", "narrator": "みやび", "text": "メリークリスマス"},
        { "location": "130/TALK", "narrator": "みやび", "text": "来年は"},
        { "location": "131/TALK", "narrator": "みやび", "text": "一緒だとえいな"},
        { "location": "133/TALK", "narrator": "みやび", "text": "なんてな"},
        { "location": "134/TALK", "narrator": "みやび", "text": "以上"},
        { "location": "135/TALK", "narrator": "みやび", "text": "さらば"},
        { "location": "136/ACT" , "narrator": "", "text": "あ、その前にトイレ"},
        { "location": "137/TALK", "narrator": "みやび", "text": "ガラガラバリーン"},
        { "location": "138/TALK", "narrator": "みやび", "text": "今のは"},
        { "location": "140/TALK", "narrator": "みやび", "text": "空気の壊れる音"},
        { "location": "141/TALK", "narrator": "みやび", "text": "来年言おう"},
        { "location": "142/TALK", "narrator": "みやび", "text": "覚えていたら"},
        { "location": "146/TALK", "narrator": "透明みやび", "text": "ふぅ…。"},
        { "location": "147/TALK", "narrator": "とうちゃん", "text": "ん？　なんだ？\n顔が赤いじゃねぇか…。"},
        { "location": "148/TALK", "narrator": "とうちゃん", "text": "おい、まさか！\n酒飲んだんじゃねぇ\nだろうな！？"},
        { "location": "150/TALK", "narrator": "透明みやび", "text": "アホか！"},
        { "location": "151/TALK", "narrator": "透明みやび", "text": "ずっととーちゃんの隣で\nジュース飲んじょった\nやろ？"},
        { "location": "152/TALK", "narrator": "とうちゃん", "text": "あぁん？\nそういやぁそうか…。"},
        { "location": "153/TALK", "narrator": "透明みやび", "text": "まったく…、\nどいつもこいつも\nうちが酔っちゅうとか…。"},
        { "location": "154/TALK", "narrator": "透明みやび", "text": "失礼な話ぞね。"},
        { "location": "155/TALK", "narrator": "とうちゃん", "text": "あはははは、冗談だ冗談。\nそんな怖い顔しなくても\nいいじゃねぇか？"},
        { "location": "157/TALK", "narrator": "透明みやび", "text": "なに言うが？\nとーちゃんの顔の方が\nよっぽど怖いぞね。"},
        { "location": "158/TALK", "narrator": "とうちゃん", "text": "顔つきはそうだけどなぁ、\n意外と性格は、臆病で\n小心者なんだぜ？"},
        { "location": "159/TALK", "narrator": "透明みやび", "text": "笑えん冗談乙ぞねー。"},
        { "location": "160/TALK", "narrator": "とうちゃん", "text": "証拠だってあるぞ。\nなんたって、俺はおまえが\n言ったとおり――"},
        { "location": "164/TALK", "narrator": "とうちゃん", "text": "臆病な赤い目の\nウサギちゃんだからな！"},
        { "location": "166/TALK", "narrator": "透明みやび", "text": "ぶはっ、あははははは！！\nきゅ、急に目を見せるのは\n卑怯ちやぁ！！"}
    ]
}
