        { "location": "1194/SEL" , "narrator": "", "text": "同じにはならないよね"},
        { "location": "1195/SEL" , "narrator": "", "text": "$me$は今よりもっと\nうれしいけどな"},
        { "location": "1196/ACT" , "narrator": "", "text": "自信とか必要？"},
        { "location": "1197/TALK", "narrator": "みやび", "text": "あるいは確信？"},
        { "location": "1198/ACT" , "narrator": "", "text": "同じにはならないよね"},
