{
    "dir": "dramatics/daydra/drm_ch04_00_820.js",
    "type": "Episode",
    "info": {
        "story_id": "4086",
        "cid": "miyabi",
        "title": "らぶとーく 第87話",
        "sub_title": "ゆめゆめ夢忘れるな"
    },
    "entry":
    [
        { "location": "665/TALK" , "narrator": "みやび", "text": "ふむ。\nここから３０分か…。"},
        { "location": "669/TALK" , "narrator": "みやび", "text": "$handle$よ"},
        { "location": "670/TALK" , "narrator": "みやび", "text": "妄想しろ"},
        { "location": "671/TALK" , "narrator": "みやび", "text": "ここは首都圏の電車などではなく"},
        { "location": "672/TALK" , "narrator": "みやび", "text": "プレミアム感あふるる豪華列車だと"},
        { "location": "674/SEL"  , "narrator": "", "text": "オリエント急行的な？"},
        { "location": "675/SEL"  , "narrator": "", "text": "お召し列車だ"},
        { "location": "676/SEL"  , "narrator": "", "text": "流行ってるよね"},
        { "location": "677/ACT"  , "narrator": "", "text": "オリエント急行的な？"},
        { "location": "678/TALK" , "narrator": "みやび", "text": "なんとゴージャスな"},
        { "location": "679/TALK" , "narrator": "みやび", "text": "しかしそれは"},
        { "location": "680/TALK" , "narrator": "みやび", "text": "殺人事件が起こるやつだ"},
        { "location": "681/ACT"  , "narrator": "", "text": "お召し列車だ"},
        { "location": "682/TALK" , "narrator": "みやび", "text": "宮家ゆかりの人物なのは"},
        { "location": "683/TALK" , "narrator": "みやび", "text": "うちなのか"},
        { "location": "684/TALK" , "narrator": "みやび", "text": "$handle$なのか"},
        { "location": "685/ACT"  , "narrator": "", "text": "流行ってるよね"},
        { "location": "686/TALK" , "narrator": "みやび", "text": "うむ"},
        { "location": "688/TALK" , "narrator": "みやび", "text": "どちらかというと"},
        { "location": "689/TALK" , "narrator": "みやび", "text": "年配向けだがの"},
        { "location": "692/SEL"  , "narrator": "", "text": "ところで"},
        { "location": "693/SEL"  , "narrator": "", "text": "ええと"},
        { "location": "694/SEL"  , "narrator": "", "text": "ちょっと聞きたい"},
        { "location": "695/ACT"  , "narrator": "", "text": "ところで"},
        { "location": "696/TALK" , "narrator": "みやび", "text": "うむ"},
        { "location": "697/ACT"  , "narrator": "", "text": "ええと"},
        { "location": "698/TALK" , "narrator": "みやび", "text": "何か思い出したか"},
        { "location": "699/ACT"  , "narrator": "", "text": "ちょっと聞きたい"},
        { "location": "700/TALK" , "narrator": "みやび", "text": "答えられることなら何でも"},
        { "location": "703/SEL"  , "narrator": "", "text": "直接話そうよ"},
        { "location": "704/SEL"  , "narrator": "", "text": "何でチャットなの"},
        { "location": "705/SEL"  , "narrator": "", "text": "意外と応用利かないタイプ？"},
        { "location": "706/ACT"  , "narrator": "", "text": "直接話そうよ"},
        { "location": "707/TALK" , "narrator": "みやび", "text": "まあそういう"},
        { "location": "708/TALK" , "narrator": "みやび", "text": "意見もあるな"},
        { "location": "709/ACT"  , "narrator": "", "text": "何でチャットなの"},
        { "location": "711/TALK" , "narrator": "みやび", "text": "なんでと"},
        { "location": "712/TALK" , "narrator": "みやび", "text": "聞かれても"},
        { "location": "713/ACT"  , "narrator": "", "text": "意外と応用利かないタイプ？"},
        { "location": "714/TALK" , "narrator": "みやび", "text": "なんと"},
        { "location": "715/TALK" , "narrator": "みやび", "text": "それは"},
        { "location": "716/TALK" , "narrator": "みやび", "text": "聞き捨てならん"},
        { "location": "717/TALK" , "narrator": "みやび", "text": "うちに対して"},
        { "location": "718/TALK" , "narrator": "みやび", "text": "なんということを"},
        { "location": "719/TALK" , "narrator": "みやび", "text": "不敬である"},
        { "location": "720/TALK" , "narrator": "みやび", "text": "その考えは"},
        { "location": "721/TALK" , "narrator": "みやび", "text": "早急に改めるべきだぞ"},
        { "location": "722/TALK" , "narrator": "みやび", "text": "$handle$め"},
        { "location": "729/TALK" , "narrator": "みやび", "text": "こうやって話したら\n満足なんかね？\n$handle$は。"},
        { "location": "730/SEL"  , "narrator": "", "text": "一応は"},
        { "location": "731/SEL"  , "narrator": "", "text": "本当はどっちでもいい"},
        { "location": "732/SEL"  , "narrator": "", "text": "大満足！"},
        { "location": "733/ACT"  , "narrator": "", "text": "一応は"},
        { "location": "734/TALK" , "narrator": "みやび", "text": "その程度の話かね。"},
        { "location": "735/ACT"  , "narrator": "", "text": "本当はどっちでもいい"},
        { "location": "736/TALK" , "narrator": "みやび", "text": "心が広いと言えなくは\nないかもしれん。"},
        { "location": "737/TALK" , "narrator": "みやび", "text": "…結局どっちぞね？"},
        { "location": "738/ACT"  , "narrator": "", "text": "大満足！"},
        { "location": "739/TALK" , "narrator": "みやび", "text": "妙な評価サイトの\n評価みたいに…。"},
        { "location": "741/TALK" , "narrator": "みやび", "text": "そういうのもどうかと\n思うちや。"},
        { "location": "743/TALK" , "narrator": "みやび", "text": "それはそれとして。"},
        { "location": "744/TALK" , "narrator": "みやび", "text": "$handle$は\n水族館で\nよかったんかね？"},
        { "location": "745/SEL"  , "narrator": "", "text": "いいも悪いもないよ"},
        { "location": "746/SEL"  , "narrator": "", "text": "もっと遠いところのに\n行きたかった"},
        { "location": "747/SEL"  , "narrator": "", "text": "すごく楽しみにしてる"},
        { "location": "748/ACT"  , "narrator": "", "text": "いいも悪いもないよ"},
        { "location": "749/TALK" , "narrator": "みやび", "text": "嫌も応もという風には\n話してないつもりや\nけんど。"},
        { "location": "750/TALK" , "narrator": "みやび", "text": "見解の相違ちう\nやつかねえ。"},
        { "location": "751/ACT"  , "narrator": "", "text": "もっと遠い水族館に\n行きたかった"},
        { "location": "752/TALK" , "narrator": "みやび", "text": "それは今度\n行けばいいぞね。"},
        { "location": "753/TALK" , "narrator": "みやび", "text": "それではいかんかね？"},
        { "location": "754/ACT"  , "narrator": "", "text": "すごく楽しみにしてる"},
        { "location": "755/TALK" , "narrator": "みやび", "text": "$handle$は\n意外とマニアぞね。"},
        { "location": "756/TALK" , "narrator": "みやび", "text": "あそこのよさが\nわかるとは。"},
        { "location": "758/TALK" , "narrator": "みやび", "text": "東京湾に注ぐ川の\n展示は地味すぎて\nむしろ楽しいし。"},
        { "location": "759/TALK" , "narrator": "みやび", "text": "ブーム初期に導入した\nクラゲ水槽たちは\n納得の地味さ。"},
        { "location": "760/TALK" , "narrator": "みやび", "text": "ベタにアマゾンの\n魚たちもおるが\nやはり地味。"},
        { "location": "762/TALK" , "narrator": "みやび", "text": "うち的には地味さが\n大変に好ましいぞね。"},
        { "location": "763/SEL"  , "narrator": "", "text": "えと…ディスってる？"},
        { "location": "764/SEL"  , "narrator": "", "text": "ふれあうのも\n難しそうだしね"},
        { "location": "765/SEL"  , "narrator": "", "text": "そんなところに\nなんでわざわざ…"},
        { "location": "766/ACT"  , "narrator": "", "text": "えと…ディスってる？"},
        { "location": "767/TALK" , "narrator": "みやび", "text": "まさか。"},
        { "location": "768/TALK" , "narrator": "みやび", "text": "$handle$は\n悪い風にとりすぎぞね。"},
        { "location": "769/ACT"  , "narrator": "", "text": "ふれあうのも\n難しそうだしね"},
        { "location": "770/TALK" , "narrator": "みやび", "text": "それが実は\nふれあいコーナーも\nあるきね。"},
        { "location": "771/TALK" , "narrator": "みやび", "text": "地味ながらポイントは\n押さえた展示を\nしちゅう。"},
        { "location": "772/ACT"  , "narrator": "", "text": "そんなところに\nなんでわざわざ…"},
        { "location": "773/TALK" , "narrator": "みやび", "text": "わびとさびと風流が\nあるきね。"},
        { "location": "774/TALK" , "narrator": "みやび", "text": "しみじみとした\nよさを味わいに\n行くぞね。"},
        { "location": "792/TALK" , "narrator": "みやび", "text": "見てみい、\n$handle$。"},
        { "location": "793/TALK" , "narrator": "みやび", "text": "東京湾に注ぐ\n吃水域が見事に\n再現されとるろう。"},
        { "location": "794/SEL"  , "narrator": "", "text": "お、おう"},
        { "location": "795/SEL"  , "narrator": "", "text": "予想以上に地味…"},
        { "location": "796/SEL"  , "narrator": "", "text": "もう実際東京湾に\n見に行った方が\nよくない？"},
        { "location": "797/ACT"  , "narrator": "", "text": "お、おう"},
        { "location": "799/TALK" , "narrator": "みやび", "text": "盛り上がりに欠ける\n反応やねえ。"},
        { "location": "800/ACT"  , "narrator": "", "text": "予想以上に地味…"},
        { "location": "801/TALK" , "narrator": "みやび", "text": "これがリアルぞね。"},
        { "location": "802/ACT"  , "narrator": "", "text": "もう実際東京湾に\n見に行った方が\nよくない？"},
        { "location": "803/TALK" , "narrator": "みやび", "text": "そういうわけには\nいかんき。"},
        { "location": "804/TALK" , "narrator": "みやび", "text": "素人が適当に\nウロウロしても。"},
        { "location": "805/TALK" , "narrator": "みやび", "text": "ここまで色々は\n生き物を\n見つけられん。"},
        { "location": "806/TALK" , "narrator": "みやび", "text": "それに生き物を\n見つけても。"},
        { "location": "807/TALK" , "narrator": "みやび", "text": "その先の解説は\n自力で検索する\n必要があるろう。"},
        { "location": "808/TALK" , "narrator": "みやび", "text": "素人にとって\n種の同定は意外と\n難問ぞね。"},
        { "location": "809/TALK" , "narrator": "みやび", "text": "そう考えると\nやはりここがベストと\n言えんかねえ。"},
        { "location": "810/SEL"  , "narrator": "", "text": "そういう趣味が\nあったんだ？"},
        { "location": "811/SEL"  , "narrator": "", "text": "なんか意外すぎる"},
        { "location": "812/SEL"  , "narrator": "", "text": "本当は焼けるのが\n嫌なだけでしょ"},
        { "location": "813/ACT"  , "narrator": "", "text": "そういう趣味が\nあったんだ？"},
        { "location": "814/TALK" , "narrator": "みやび", "text": "そうみたいぞね。"},
        { "location": "815/ACT"  , "narrator": "", "text": "なんか意外すぎる"},
        { "location": "816/TALK" , "narrator": "みやび", "text": "そうでもないろう。"},
        { "location": "817/ACT"  , "narrator": "", "text": "本当は焼けるのが\n嫌なだけでしょ"},
        { "location": "818/TALK" , "narrator": "みやび", "text": "…ばれたか。"},
        { "location": "821/TALK" , "narrator": "みやび", "text": "東京湾はあんまり\n波が立たんろう。"},
        { "location": "822/TALK" , "narrator": "みやび", "text": "やき、本当に海かと\n疑うてしまうけんど。"},
        { "location": "824/TALK" , "narrator": "みやび", "text": "ここに来ると\n本当に海なんやねえと\n軽く感動するちや。"},
        { "location": "825/SEL"  , "narrator": "", "text": "高知の海は荒波だもんね"},
        { "location": "826/SEL"  , "narrator": "", "text": "三戸浜と\n比べてってこと？"},
        { "location": "827/SEL"  , "narrator": "", "text": "海は広いな大きいな"},
        { "location": "828/ACT"  , "narrator": "", "text": "高知の海は荒波だもんね"},
        { "location": "829/TALK" , "narrator": "みやび", "text": "太平洋やき。"},
        { "location": "830/ACT"  , "narrator": "", "text": "三戸浜と\n比べてってこと？"},
        { "location": "831/TALK" , "narrator": "みやび", "text": "…それもあるね。"},
        { "location": "832/ACT"  , "narrator": "", "text": "海は広いな大きいな"},
        { "location": "835/TALK" , "narrator": "みやび", "text": "歌わんでもええろう。"},
        { "location": "839/TALK" , "narrator": "みやび", "text": "次は干潟と磯ぞね。"},
        { "location": "840/SEL"  , "narrator": "", "text": "また東京湾？"},
        { "location": "841/SEL"  , "narrator": "", "text": "夏休みの自由研究みたい"},
        { "location": "842/SEL"  , "narrator": "", "text": "潮干狩りとかできないの"},
        { "location": "843/ACT"  , "narrator": "", "text": "また東京湾？"},
        { "location": "844/TALK" , "narrator": "みやび", "text": "他に何が必要かいね。"},
        { "location": "845/ACT"  , "narrator": "", "text": "夏休みの自由研究みたい"},
        { "location": "848/TALK" , "narrator": "みやび", "text": "それは否定できんねえ。"},
        { "location": "849/ACT"  , "narrator": "", "text": "潮干狩りとかできないの"},
        { "location": "853/TALK" , "narrator": "みやび", "text": "それはまた\nスケールの大きい\n話ぞね。"},
        { "location": "857/TALK" , "narrator": "みやび", "text": "それに干潟は\nふれあいコーナーも\nあるぞね。"},
        { "location": "858/TALK" , "narrator": "みやび", "text": "$handle$は\nふれあいを希望\nしちょったろう。"},
        { "location": "859/SEL"  , "narrator": "", "text": "みやびとのふれあい希望"},
        { "location": "860/SEL"  , "narrator": "", "text": "そんな子供じゃないし"},
        { "location": "861/SEL"  , "narrator": "", "text": "だってせっかくだし"},
        { "location": "862/ACT"  , "narrator": "", "text": "みやびとのふれあい希望"},
        { "location": "863/TALK" , "narrator": "みやび", "text": "これだけしても\n足りんと言うか\n$handle$は。"},
        { "location": "866/TALK" , "narrator": "みやび", "text": "甘えん坊さんやねえ。"},
        { "location": "867/ACT"  , "narrator": "", "text": "そんな子供じゃないし"},
        { "location": "868/TALK" , "narrator": "みやび", "text": "それ、ガブちゃんも\nよう言っちゅう。"},
        { "location": "871/TALK" , "narrator": "みやび", "text": "子供はそういう\n言い方をするちゅう\nことやろうねえ。"},
        { "location": "872/ACT"  , "narrator": "", "text": "だってせっかくだし"},
        { "location": "874/TALK" , "narrator": "みやび", "text": "せっかくだからは\n本末転倒に\nなりがちぞね。"},
        { "location": "875/TALK" , "narrator": "みやび", "text": "気をつけんとねえ。"},
        { "location": "879/TALK" , "narrator": "みやび", "text": "…この水は本物の\n海水を使うとる\nいうけんど。"},
        { "location": "880/TALK" , "narrator": "みやび", "text": "砂も磯の生き物も\n東京湾から捕ってきた\nらしいけんど。"},
        { "location": "881/TALK" , "narrator": "みやび", "text": "水槽に入ったら\nやっぱりもう\n海には見えんね。"},
        { "location": "882/TALK" , "narrator": "みやび", "text": "どこまでが天然で\nどこからが人工物か。"},
        { "location": "883/TALK" , "narrator": "みやび", "text": "その問いは\n$handle$との\n関係にも似とる。"},
        { "location": "884/TALK" , "narrator": "みやび", "text": "…というのはちっくと\nセンチメンタルに\nすぎるか。"},
        { "location": "886/TALK" , "narrator": "みやび", "text": "$handle$は\n触りたい生き物は\nおらんのかね？"},
        { "location": "887/SEL"  , "narrator": "", "text": "やっぱりカニだよね！"},
        { "location": "888/SEL"  , "narrator": "", "text": "ウニ！　ウニ！"},
        { "location": "889/SEL"  , "narrator": "", "text": "ヒトデかな～"},
        { "location": "890/ACT"  , "narrator": "", "text": "やっぱりカニだよね！"},
        { "location": "891/TALK" , "narrator": "みやび", "text": "定番やきね。"},
        { "location": "892/ACT"  , "narrator": "", "text": "ウニ！　ウニ！"},
        { "location": "896/TALK" , "narrator": "みやび", "text": "言っておくけんど\nここのは食べられんよ？"},
        { "location": "897/ACT"  , "narrator": "", "text": "ヒトデかな～"},
        { "location": "898/TALK" , "narrator": "みやび", "text": "意外と軟体動物な\nあいつに目を\n付けるとは侮れん。"},
        { "location": "902/TALK" , "narrator": "みやび", "text": "けんど触れあって\n喜んどるのは子供\nばっかりぞね。"},
        { "location": "903/TALK" , "narrator": "みやび", "text": "…誰もいない時に\n改めて来ることに\nして。"},
        { "location": "905/TALK" , "narrator": "みやび", "text": "次はクラゲでも\n愛でようかね？"},
        { "location": "906/SEL"  , "narrator": "", "text": "ペンギンがいいよ"},
        { "location": "907/SEL"  , "narrator": "", "text": "やっぱサメ！"},
        { "location": "908/SEL"  , "narrator": "", "text": "イルカショー\nあるみたいだよ"},
        { "location": "909/ACT"  , "narrator": "", "text": "ペンギンがいいよ"},
        { "location": "910/TALK" , "narrator": "みやび", "text": "ペンギンか。"},
        { "location": "911/SEL"  , "narrator": "", "text": "かわいいし"},
        { "location": "912/SEL"  , "narrator": "", "text": "和むし"},
        { "location": "913/SEL"  , "narrator": "", "text": "嫌いだった？"},
        { "location": "914/ACT"  , "narrator": "", "text": "かわいいし"},
        { "location": "915/TALK" , "narrator": "みやび", "text": "確かにかわいいねえ。"},
        { "location": "916/ACT"  , "narrator": "", "text": "和むし"},
        { "location": "917/TALK" , "narrator": "みやび", "text": "鳥らしくないフォルムは\n癒やし系ぞね。"},
        { "location": "918/ACT"  , "narrator": "", "text": "嫌いだった？"},
        { "location": "919/TALK" , "narrator": "みやび", "text": "いや。\nむしろ好きやき。"},
        { "location": "921/TALK" , "narrator": "みやび", "text": "知っちゅうかよ？"},
        { "location": "922/TALK" , "narrator": "みやび", "text": "ペンギンは\n生涯伴侶を\n変えないらしい。"},
        { "location": "923/SEL"  , "narrator": "", "text": "みやびと$me$\nみたいだね"},
        { "location": "924/SEL"  , "narrator": "", "text": "愛に生きる\nけものなんだね"},
        { "location": "925/SEL"  , "narrator": "", "text": "非効率的じゃない？"},
        { "location": "926/ACT"  , "narrator": "", "text": "みやびと$me$\nみたいだね"},
        { "location": "928/TALK" , "narrator": "みやび", "text": "…よう言うた。"},
        { "location": "931/TALK" , "narrator": "みやび", "text": "一生かけて\n証明してもらおうかね。"},
        { "location": "934/ACT"  , "narrator": "", "text": "愛に生きる\nけものなんだね"},
        { "location": "937/TALK" , "narrator": "みやび", "text": "けものだって\nそういうことが\nできるちや。"},
        { "location": "938/TALK" , "narrator": "みやび", "text": "うちらにできんわけは\nないろう…？"},
        { "location": "939/ACT"  , "narrator": "", "text": "非効率的じゃない？"},
        { "location": "940/TALK" , "narrator": "みやび", "text": "そこで言うのは\nそんな台詞では\nないろう。"},
        { "location": "941/TALK" , "narrator": "みやび", "text": "ばかちんの\nにぶちんやね。\n$handle$は。"},
        { "location": "943/ACT"  , "narrator": "", "text": "やっぱサメ！"},
        { "location": "945/TALK" , "narrator": "みやび", "text": "どう猛さがポイント\nなんかね？"},
        { "location": "946/SEL"  , "narrator": "", "text": "格好いいでしょ！"},
        { "location": "947/SEL"  , "narrator": "", "text": "意外と美味いし"},
        { "location": "948/SEL"  , "narrator": "", "text": "頭もいいんだよ"},
        { "location": "949/ACT"  , "narrator": "", "text": "格好いいでしょ！"},
        { "location": "950/TALK" , "narrator": "みやび", "text": "…まあ確かに。"},
        { "location": "951/ACT"  , "narrator": "", "text": "意外と美味いし"},
        { "location": "952/TALK" , "narrator": "みやび", "text": "カマボコなら\nうちも好きやき。"},
        { "location": "953/ACT"  , "narrator": "", "text": "頭もいいんだよ"},
        { "location": "954/TALK" , "narrator": "みやび", "text": "それは知らなんだ。"},
        { "location": "957/TALK" , "narrator": "みやび", "text": "…仮にもハネムーンで\nどうにも色っぽい\n会話にならんのは。"},
        { "location": "958/TALK" , "narrator": "みやび", "text": "どういうこと\nなんやろうねえ…。"},
        { "location": "959/ACT"  , "narrator": "", "text": "イルカショー\nあるみたいだよ"},
        { "location": "960/TALK" , "narrator": "みやび", "text": "人馬一体ならぬ\nヒトとイルカの\nコラボレーションか。"},
        { "location": "961/SEL"  , "narrator": "", "text": "あれ？　いまいち？"},
        { "location": "962/SEL"  , "narrator": "", "text": "イルカ嫌い？"},
        { "location": "963/SEL"  , "narrator": "", "text": "背中とか乗りたく\nならない派？"},
        { "location": "964/ACT"  , "narrator": "", "text": "あれ？　いまいち？"},
        { "location": "965/TALK" , "narrator": "みやび", "text": "そういうわけでは\nないけんど…。"},
        { "location": "966/ACT"  , "narrator": "", "text": "イルカ嫌い？"},
        { "location": "967/TALK" , "narrator": "みやび", "text": "嫌いちゅうのとは\nちっくと違うて。"},
        { "location": "968/ACT"  , "narrator": "", "text": "背中とか乗りたく\nならない派？"},
        { "location": "970/TALK" , "narrator": "みやび", "text": "ならんねえ。"},
        { "location": "972/TALK" , "narrator": "みやび", "text": "動物に芸をさせるんが\nうちはいまいち\n苦手ながよ。"},
        { "location": "973/SEL"  , "narrator": "", "text": "あっ…そうなんだ…"},
        { "location": "974/SEL"  , "narrator": "", "text": "だったら別のを見よう"},
        { "location": "975/SEL"  , "narrator": "", "text": "そういうの\n苦手な話は聞く"},
        { "location": "976/ACT"  , "narrator": "", "text": "あっ…そうなんだ…"},
        { "location": "977/TALK" , "narrator": "みやび", "text": "悪いけんど\n素直に楽しめんきね。"},
        { "location": "978/ACT"  , "narrator": "", "text": "だったら別のを見よう"},
        { "location": "979/TALK" , "narrator": "みやび", "text": "そう言ってくれると\n助かるぞね。"},
        { "location": "980/ACT"  , "narrator": "", "text": "そういうの\n苦手な話は聞く"},
        { "location": "981/TALK" , "narrator": "みやび", "text": "…意外と多いんかも\nしれんねえ。"},
        { "location": "984/TALK" , "narrator": "みやび", "text": "…多分ここで素直に\nイルカさんすごい！と\n言える女子の方が。"},
        { "location": "985/TALK" , "narrator": "みやび", "text": "一般的に女子力が\n高いと思われる。"},
        { "location": "986/TALK" , "narrator": "みやび", "text": "けんど…それをするのは\nうちのキャラではないし。"},
        { "location": "987/TALK" , "narrator": "みやび", "text": "$handle$も\nうちにそれは\n望んでおらんろう。"},
        { "location": "988/SEL"  , "narrator": "", "text": "えっと"},
        { "location": "989/ACT"  , "narrator": "", "text": "えっと"},
        { "location": "992/TALK" , "narrator": "みやび", "text": "どういた？"},
        { "location": "993/SEL"  , "narrator": "", "text": "実は$me$も\n動物のショーは\n苦手なんだ"},
        { "location": "994/SEL"  , "narrator": "", "text": "世間に合わせること\nないよ"},
        { "location": "995/SEL"  , "narrator": "", "text": "$me$は\nみやびがみやびな\nところが好きだから"},
        { "location": "996/ACT"  , "narrator": "", "text": "実は$me$も\n動物のショーは\n苦手なんだ"},
        { "location": "997/TALK" , "narrator": "みやび", "text": "…$handle$は\n優しいきね。"},
        { "location": "999/TALK" , "narrator": "みやび", "text": "でもそう言って\nもらえて気が\n楽になった。"},
        { "location": "1000/ACT" , "narrator": "", "text": "世間に合わせること\nないよ"},
        { "location": "1001/TALK", "narrator": "みやび", "text": "合わせる気も\n反発する気も\nないけんど。"},
        { "location": "1002/ACT" , "narrator": "", "text": "$me$は\nみやびがみやびな\nところが好きだから"},
        { "location": "1003/TALK", "narrator": "みやび", "text": "ドヤ顔は少し隠せ、\n$handle$。"},
        { "location": "1010/TALK", "narrator": "みやび", "text": "あ。そういえば。"},
        { "location": "1011/TALK", "narrator": "みやび", "text": "ここには今となっては\n標準装備の仕掛けが\nあるぞね。"},
        { "location": "1012/TALK", "narrator": "みやび", "text": "それをゆっくり\n眺めるとしようかね。"},
        { "location": "1013/SEL" , "narrator": "", "text": "それって何？"},
        { "location": "1014/SEL" , "narrator": "", "text": "技術の進歩は\n日進月歩"},
        { "location": "1015/SEL" , "narrator": "", "text": "ロストテクノロジーは\n人類のロマンだ"},
        { "location": "1016/ACT" , "narrator": "", "text": "それって何？"},
        { "location": "1017/TALK", "narrator": "みやび", "text": "着いたら説明するき。"},
        { "location": "1018/ACT" , "narrator": "", "text": "技術の進歩は\n日進月歩"},
        { "location": "1019/TALK", "narrator": "みやび", "text": "まさにその言葉通り。"},
        { "location": "1020/ACT" , "narrator": "", "text": "ロストテクノロジーは\n人類のロマンだ"},
        { "location": "1023/TALK", "narrator": "みやび", "text": "現存する技術ぞね。\n…たぶん。"},
        { "location": "1033/TALK", "narrator": "透明みやび", "text": "…ここからや。\nこの通路。"},
        { "location": "1034/TALK", "narrator": "透明みやび", "text": "海の底から海を\n眺めとる気に\nならんかね？"},
        { "location": "1035/SEL" , "narrator": "", "text": "海底トンネルかー"},
        { "location": "1036/SEL" , "narrator": "", "text": "魚がいっぱいいるね"},
        { "location": "1037/SEL" , "narrator": "", "text": "いかにも水族館らしい"},
        { "location": "1038/ACT" , "narrator": "", "text": "海底トンネルかー"},
        { "location": "1040/TALK", "narrator": "透明みやび", "text": "そうやね。"},
        { "location": "1041/ACT" , "narrator": "", "text": "魚がいっぱいいるね"},
        { "location": "1043/TALK", "narrator": "透明みやび", "text": "こじゃんとおるねえ。"},
        { "location": "1044/ACT" , "narrator": "", "text": "いかにも水族館らしい"},
        { "location": "1047/TALK", "narrator": "透明みやび", "text": "これがないと\n水族館の魅力は\n半減ぞね。"},
        { "location": "1049/TALK", "narrator": "透明みやび", "text": "こういう展示が\nできるようになったのは\n以外と最近ぞね。"},
        { "location": "1050/TALK", "narrator": "透明みやび", "text": "ミレニアム以前は\n存在すらしなかった\nらしい。"},
        { "location": "1051/SEL" , "narrator": "", "text": "そうなんだ"},
        { "location": "1052/SEL" , "narrator": "", "text": "２０００年問題\nがらみなの？"},
        { "location": "1053/SEL" , "narrator": "", "text": "結構昔のような\n気もするけど"},
        { "location": "1054/ACT" , "narrator": "", "text": "そうなんだ"},
        { "location": "1055/TALK", "narrator": "透明みやび", "text": "それ以前の水族館を\nうちはよう想像できん。"},
        { "location": "1056/ACT" , "narrator": "", "text": "２０００年問題\nがらみなの？"},
        { "location": "1057/TALK", "narrator": "透明みやび", "text": "いやそれは全く\n関係がないき。"},
        { "location": "1058/ACT" , "narrator": "", "text": "結構昔のような\n気もするけど"},
        { "location": "1059/TALK", "narrator": "透明みやび", "text": "うちも昔とは\n思うけんど。"},
        { "location": "1061/TALK", "narrator": "透明みやび", "text": "今は当たり前と\n思うものも、\n実はそうではない。"},
        { "location": "1062/TALK", "narrator": "透明みやび", "text": "あっという間に\n何もかもが\n変わってしまう。"},
        { "location": "1063/TALK", "narrator": "透明みやび", "text": "永遠に続くものなど\n人の世には存在\nせんのやろうね。"},
        { "location": "1064/TALK", "narrator": "透明みやび", "text": "それは技術だけの\n話ではのうて、\n人と人についても。"},
        { "location": "1067/TALK", "narrator": "透明みやび", "text": "$handle$。"},
        { "location": "1068/TALK", "narrator": "透明みやび", "text": "うちは永遠なんて\nいうものは信じとらん。"},
        { "location": "1069/TALK", "narrator": "透明みやび", "text": "けんど、これまでの\n$handle$との\n日々と。"},
        { "location": "1070/TALK", "narrator": "透明みやび", "text": "この先の\n$handle$との\n日々は。"},
        { "location": "1071/TALK", "narrator": "透明みやび", "text": "意思が続く限り\n続けていきたいと\n思っちゅう。"},
        { "location": "1072/SEL" , "narrator": "", "text": "ありがとう"},
        { "location": "1073/SEL" , "narrator": "", "text": "それが永遠\nなんじゃないかな"},
        { "location": "1074/SEL" , "narrator": "", "text": "$me$もそう思ってる"},
        { "location": "1075/ACT" , "narrator": "", "text": "ありがとう"},
        { "location": "1077/TALK", "narrator": "透明みやび", "text": "うちこそ\nありがとうやき。"},
        { "location": "1078/ACT" , "narrator": "", "text": "それが永遠\nなんじゃないかな"},
        { "location": "1080/TALK", "narrator": "透明みやび", "text": "…そうなるとええね。"},
        { "location": "1081/ACT" , "narrator": "", "text": "$me$もそう思ってる"},
        { "location": "1083/TALK", "narrator": "透明みやび", "text": "それは今さら\n疑ってはおらん。"},
        { "location": "1087/TALK", "narrator": "透明みやび", "text": "ほいたら、帰ろうか。"},
        { "location": "1088/SEL" , "narrator": "", "text": "二人の愛の巣に"},
        { "location": "1089/SEL" , "narrator": "", "text": "まだ遊ぶー！"},
        { "location": "1090/SEL" , "narrator": "", "text": "お腹空いたんだ？"},
        { "location": "1091/ACT" , "narrator": "", "text": "二人の愛の巣に"},
        { "location": "1092/TALK", "narrator": "透明みやび", "text": "巣というより\n寝床かね…。"},
        { "location": "1093/TALK", "narrator": "透明みやび", "text": "あそこまで散らかすと\n片付ける気が\n起きんようになるね…。"},
        { "location": "1094/ACT" , "narrator": "", "text": "まだ遊ぶー！"},
        { "location": "1095/TALK", "narrator": "透明みやび", "text": "$handle$とは\nいつでもどこでも\n遊べるき。"},
        { "location": "1096/TALK", "narrator": "透明みやび", "text": "…いやそもそも\n遊びではのうて\nハネムーンやけんど。"},
        { "location": "1097/ACT" , "narrator": "", "text": "お腹空いたんだ？"},
        { "location": "1098/TALK", "narrator": "透明みやび", "text": "なんでそうなる。"},
        { "location": "1099/TALK", "narrator": "透明みやび", "text": "日も暮れてきたし\nちゅうことかね…。"},
        { "location": "1102/TALK", "narrator": "透明みやび", "text": "♪カラスが鳴くから\nか～えろ～♪"},
        { "location": "1103/TALK", "narrator": "透明みやび", "text": "♪お手々つないで\nか～えろ～♪"},
        { "location": "1118/TALK", "narrator": "みやび", "text": "ということで一件落着。"},
        { "location": "1119/TALK", "narrator": "みやび", "text": "みやびさんと\n$handle$は末永く\n幸せに暮らしました。"},
        { "location": "1121/TALK", "narrator": "みやび", "text": "めでたし、めでたし。"},
        { "location": "1122/SEL" , "narrator": "", "text": "あれ？　夢オチ？"},
        { "location": "1123/SEL" , "narrator": "", "text": "今日のことは現実に\nあったことだよね！？"},
        { "location": "1124/SEL" , "narrator": "", "text": "誰に向かって\n話してるの！？"},
        { "location": "1125/ACT" , "narrator": "", "text": "あれ？　夢オチ？"},
        { "location": "1126/TALK", "narrator": "みやび", "text": "だったらどうする\nつもりぞね？"},
        { "location": "1127/SEL" , "narrator": "", "text": "いやまさか"},
        { "location": "1128/SEL" , "narrator": "", "text": "タイムリープする"},
        { "location": "1129/SEL" , "narrator": "", "text": "いい夢を見たよ…"},
        { "location": "1130/SEL" , "narrator": "", "text": "夢を夢で諦めない"},
        { "location": "1131/ACT" , "narrator": "", "text": "いやまさか"},
        { "location": "1132/TALK", "narrator": "みやび", "text": "そう思っておるのは…。"},
        { "location": "1133/ACT" , "narrator": "", "text": "タイムリープする"},
        { "location": "1134/TALK", "narrator": "みやび", "text": "ＳＦの王道ぞね。"},
        { "location": "1135/ACT" , "narrator": "", "text": "いい夢を見たよ…"},
        { "location": "1136/TALK", "narrator": "みやび", "text": "夢はいつか醒めるもの\nやきね…。"},
        { "location": "1137/SEL" , "narrator": "", "text": "いつまで続けるの"},
        { "location": "1138/SEL" , "narrator": "", "text": "ノリよすぎでしょ"},
        { "location": "1139/SEL" , "narrator": "", "text": "さようなら…"},
        { "location": "1140/ACT" , "narrator": "", "text": "いつまで続けるの"},
        { "location": "1141/TALK", "narrator": "みやび", "text": "どちらかが飽きるまで。"},
        { "location": "1142/ACT" , "narrator": "", "text": "ノリよすぎでしょ"},
        { "location": "1143/TALK", "narrator": "みやび", "text": "いやつい。"},
        { "location": "1144/ACT" , "narrator": "", "text": "さようなら…"},
        { "location": "1145/TALK", "narrator": "みやび", "text": "いやいや。"},
        { "location": "1147/TALK", "narrator": "みやび", "text": "仮初めの永遠を\n誓い合ったろう。"},
        { "location": "1148/TALK", "narrator": "みやび", "text": "もう忘れたかよ。\nばかちんが。"},
        { "location": "1150/ACT" , "narrator": "", "text": "夢を夢で諦めない"},
        { "location": "1151/TALK", "narrator": "みやび", "text": "その言葉に胡散臭さを\n感じるのは\nうちだけかね？"},
        { "location": "1153/ACT" , "narrator": "", "text": "今日のことは現実に\nあったことだよね！？"},
        { "location": "1154/TALK", "narrator": "みやび", "text": "それはどうかな？"},
        { "location": "1155/SEL" , "narrator": "", "text": "確かに現実だった！"},
        { "location": "1156/SEL" , "narrator": "", "text": "現実というより\nバーチャルリアル？"},
        { "location": "1157/SEL" , "narrator": "", "text": "胡蝶の夢だったのかも"},
        { "location": "1158/ACT" , "narrator": "", "text": "確かに現実だった！"},
        { "location": "1159/TALK", "narrator": "みやび", "text": "そうと確信があるなら\nそれで十分ぞね。"},
        { "location": "1160/ACT" , "narrator": "", "text": "現実というより\nバーチャルリアル？"},
        { "location": "1161/TALK", "narrator": "みやび", "text": "なかなか厳しいところを\n突いてくるねえ。"},
        { "location": "1162/ACT" , "narrator": "", "text": "胡蝶の夢だったのかも"},
        { "location": "1163/TALK", "narrator": "みやび", "text": "あるいは邯鄲の夢\nだったか。"},
        { "location": "1165/ACT" , "narrator": "", "text": "誰に向かって\n話してるの！？"},
        { "location": "1166/TALK", "narrator": "みやび", "text": "さあ？"},
        { "location": "1167/SEL" , "narrator": "", "text": "ひょっとして怖い話？"},
