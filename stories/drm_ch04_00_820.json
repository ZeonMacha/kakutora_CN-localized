        { "location": "1169/SEL" , "narrator": "", "text": "実は監視されてるの？"},
        { "location": "1170/ACT" , "narrator": "", "text": "ひょっとして怖い話？"},
        { "location": "1171/TALK", "narrator": "みやび", "text": "ハートフルヒューマン\nストーリーぞね。"},
        { "location": "1172/ACT" , "narrator": "", "text": "冗談がうまいんだから"},
        { "location": "1173/TALK", "narrator": "みやび", "text": "褒めても何も出んき。"},
