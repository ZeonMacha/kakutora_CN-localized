        { "location": "1175/TALK", "narrator": "みやび", "text": "ビッグブラザーは\n実在するきね。"},
        { "location": "1176/SEL" , "narrator": "", "text": "やめてやめてやめて"},
        { "location": "1177/SEL" , "narrator": "", "text": "運営さんのことかな…"},
        { "location": "1178/SEL" , "narrator": "", "text": "暗号化して\n会話を続けよう"},
        { "location": "1179/ACT" , "narrator": "", "text": "やめてやめてやめて"},
        { "location": "1181/TALK", "narrator": "みやび", "text": "そこまで拒否反応を\n示すとは思わん\nかったぞね。"},
        { "location": "1182/ACT" , "narrator": "", "text": "運営さんのことかな…"},
