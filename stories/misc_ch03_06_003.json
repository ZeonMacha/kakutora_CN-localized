    "entry":
    [
        { "location": "182/SCENARIO", "narrator": "", "text": "05_005_三つ編みと乙女草"},
        { "location": "207/TALK"    , "narrator": "ガブリエラ", "text": "日本の花にね"},
        { "location": "208/TALK"    , "narrator": "ガブリエラ", "text": "乙女草って呼ばれてる花があるんですって"},
        { "location": "209/TALK"    , "narrator": "ガブリエラ", "text": "素敵よね"},
        { "location": "212/SEL"     , "narrator": "", "text": "菊の別名みたいだけど"},
        { "location": "213/SEL"     , "narrator": "", "text": "へー"},
        { "location": "214/SEL"     , "narrator": "", "text": "確かに素敵な呼び名ね"},
        { "location": "215/ACT"     , "narrator": "", "text": "菊の別名みたいだけど"},
        { "location": "216/TALK"    , "narrator": "ガブリエラ", "text": "ええ"},
        { "location": "217/TALK"    , "narrator": "ガブリエラ", "text": "それがどうかして？"},
        { "location": "220/SEL"     , "narrator": "", "text": "地味な花だけどいいの"},
        { "location": "221/SEL"     , "narrator": "", "text": "お年寄り向けの花だけどいいの"},
        { "location": "222/ACT"     , "narrator": "", "text": "地味な花だけどいいの"},
        { "location": "223/TALK"    , "narrator": "ガブリエラ", "text": "そうなのかしら？"},
        { "location": "224/TALK"    , "narrator": "ガブリエラ", "text": "そういうところも乙女らしくていいんじゃないかしら"},
        { "location": "225/ACT"     , "narrator": "", "text": "お年寄り向けの花だけどいいの"},
        { "location": "226/TALK"    , "narrator": "ガブリエラ", "text": "そうなの？"},
        { "location": "227/TALK"    , "narrator": "ガブリエラ", "text": "でもお花にお年寄り向けとかあるのかしら？"},
        { "location": "228/TALK"    , "narrator": "ガブリエラ", "text": "不思議ね"},
        { "location": "230/ACT"     , "narrator": "", "text": "へー"},
        { "location": "231/TALK"    , "narrator": "ガブリエラ", "text": "あら"},
        { "location": "232/TALK"    , "narrator": "ガブリエラ", "text": "マルザンナは知らないのね"},
        { "location": "233/TALK"    , "narrator": "ガブリエラ", "text": "でも今日で乙女草がわかったから"},
        { "location": "234/TALK"    , "narrator": "ガブリエラ", "text": "少し人生が楽しくなったわね"},
        { "location": "237/ACT"     , "narrator": "", "text": "確かに素敵な呼び名ね"},
        { "location": "239/TALK"    , "narrator": "ガブリエラ", "text": "そうでしょう？"},
        { "location": "240/TALK"    , "narrator": "ガブリエラ", "text": "とても素敵よね"},
        { "location": "242/SEL"     , "narrator": "", "text": "三つ編みの女学生って感じ"},
        { "location": "243/SEL"     , "narrator": "", "text": "詩集とか読んでそう"},
        { "location": "244/ACT"     , "narrator": "", "text": "三つ編みの女学生って感じ"},
        { "location": "245/TALK"    , "narrator": "ガブリエラ", "text": "ふうん？"},
        { "location": "246/TALK"    , "narrator": "ガブリエラ", "text": "そんな感じなのね"},
        { "location": "247/ACT"     , "narrator": "", "text": "詩集とか読んでそう"},
        { "location": "248/TALK"    , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "249/TALK"    , "narrator": "ガブリエラ", "text": "ますます素敵だわ"}
    ]
}
