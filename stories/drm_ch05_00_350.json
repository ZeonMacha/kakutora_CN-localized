        { "location": "5/SCENARIO", "narrator": "", "text": "わたしはうづきかぐら"},
        { "location": "14/TALK"   , "narrator": "神楽", "text": "京急線って\n初めて乗った…。"},
        { "location": "26/TALK"   , "narrator": "神楽", "text": "発進音？が音階みたいになってたぴょん"},
        { "location": "27/TALK"   , "narrator": "神楽", "text": "変な電車～～～～～～！！！！！"},
        { "location": "30/SEL"    , "narrator": "", "text": "そこがいいのになー"},
        { "location": "31/SEL"    , "narrator": "", "text": "想像つかないな…"},
        { "location": "32/SEL"    , "narrator": "", "text": "マニアックだよね"},
        { "location": "33/ACT"    , "narrator": "", "text": "そこがいいのになー"},
        { "location": "34/TALK"   , "narrator": "神楽", "text": "鉄なの$handle$！？"},
        { "location": "35/TALK"   , "narrator": "神楽", "text": "うわーそーなんだー"},
        { "location": "36/ACT"    , "narrator": "", "text": "想像つかないな…"},
        { "location": "37/TALK"   , "narrator": "神楽", "text": "いやこれはどう説明していいのか、、、"},
        { "location": "39/TALK"   , "narrator": "神楽", "text": "実際乗らないと無理ぴょん！"},
        { "location": "40/ACT"    , "narrator": "", "text": "マニアックだよね"},
        { "location": "41/TALK"   , "narrator": "神楽", "text": "あーうーんそーねー"},
        { "location": "42/TALK"   , "narrator": "神楽", "text": "そういう言い方するしかないぴょん"},
        { "location": "54/TALK"   , "narrator": "神楽", "text": "景色もちょっと\n違うみたい…。"},
        { "location": "55/TALK"   , "narrator": "神楽", "text": "でも旅行って\n雰囲気の人はいない…。\n生活沿線だもんね。"},
        { "location": "56/SEL"    , "narrator": "", "text": "どこ行くの？"},
        { "location": "57/ACT"    , "narrator": "", "text": "どこ行くの？"},
        { "location": "72/TALK"   , "narrator": "神楽", "text": "言ってなかったぴょん"},
        { "location": "73/TALK"   , "narrator": "神楽", "text": "みやびさんの実家"},
        { "location": "74/TALK"   , "narrator": "神楽", "text": "トライナリー全員で合宿する"},
        { "location": "76/SEL"    , "narrator": "", "text": "了解"},
        { "location": "77/SEL"    , "narrator": "", "text": "頑張って"},
        { "location": "78/SEL"    , "narrator": "", "text": "楽しく過ごせるといいね"},
        { "location": "79/ACT"    , "narrator": "", "text": "了解"},
        { "location": "80/TALK"   , "narrator": "神楽", "text": "ぎょーむれんらくっぽい！"},
        { "location": "81/ACT"    , "narrator": "", "text": "頑張って"},
        { "location": "82/TALK"   , "narrator": "神楽", "text": "そうだよね～"},
        { "location": "84/TALK"   , "narrator": "神楽", "text": "がんばるしかないぴょん、、、"},
        { "location": "85/ACT"    , "narrator": "", "text": "楽しく過ごせるといいね"},
        { "location": "86/TALK"   , "narrator": "神楽", "text": "楽しくか～～～"},
        { "location": "87/TALK"   , "narrator": "神楽", "text": "簡単そうで一番難しいことさらっと言うね、、、"},
        { "location": "99/TALK"   , "narrator": "神楽", "text": "ふう……。"},
        { "location": "100/TALK"  , "narrator": "神楽", "text": "もう合宿でしか\nチャンスはないし\n時間もない。"},
        { "location": "101/TALK"  , "narrator": "神楽", "text": "…覚悟を決めなきゃ…。"},
        { "location": "114/TALK"  , "narrator": "神楽", "text": "$handle$は"},
        { "location": "115/TALK"  , "narrator": "神楽", "text": "ぴょんこの何だったっけ？"},
        { "location": "117/SEL"   , "narrator": "", "text": "恋人"},
        { "location": "118/SEL"   , "narrator": "", "text": "スイートハート"},
        { "location": "119/SEL"   , "narrator": "", "text": "ツレ"},
        { "location": "120/SEL"   , "narrator": "", "text": "最愛の人"},
        { "location": "121/SEL"   , "narrator": "", "text": "ダーリン"},
        { "location": "122/ACT"   , "narrator": "", "text": "恋人"},
        { "location": "123/TALK"  , "narrator": "神楽", "text": "そうそうそれそれ！"},
        { "location": "124/ACT"   , "narrator": "", "text": "スイートハート"},
        { "location": "125/TALK"  , "narrator": "神楽", "text": "甘い響き～♪"},
        { "location": "126/ACT"   , "narrator": "", "text": "ツレ"},
        { "location": "127/TALK"  , "narrator": "神楽", "text": "熟年みを感じる"},
        { "location": "128/TALK"  , "narrator": "神楽", "text": "それはそれでありか～"},
        { "location": "129/ACT"   , "narrator": "", "text": "最愛の人"},
        { "location": "130/TALK"  , "narrator": "神楽", "text": "おっおっ？"},
        { "location": "132/ACT"   , "narrator": "", "text": "ダーリン"},
        { "location": "133/TALK"  , "narrator": "神楽", "text": "昔の洋ドラみたいぴょん♪"},
        { "location": "135/TALK"  , "narrator": "神楽", "text": "そんな$handle$がいるから"},
        { "location": "136/TALK"  , "narrator": "神楽", "text": "ぴょんこは合宿にも参加する気になれたぴょん"},
        { "location": "138/TALK"  , "narrator": "神楽", "text": "、、、ﾎﾝﾄｳﾀﾞﾖ？？？"},
        { "location": "140/SEL"   , "narrator": "", "text": "だったらいいんだけど"},
        { "location": "141/SEL"   , "narrator": "", "text": "がんばって！"},
        { "location": "142/SEL"   , "narrator": "", "text": "よしよしいい子だ"},
        { "location": "143/ACT"   , "narrator": "", "text": "だったらいいんだけど"},
        { "location": "144/TALK"  , "narrator": "神楽", "text": "んーんーんーんー"},
        { "location": "145/TALK"  , "narrator": "神楽", "text": "あっさりな回答ぴょん、、、"},
        { "location": "146/ACT"   , "narrator": "", "text": "がんばって！"},
        { "location": "147/TALK"  , "narrator": "神楽", "text": "そりゃそうするけど～～～"},
        { "location": "148/TALK"  , "narrator": "神楽", "text": "なんだかな～～～"},
        { "location": "149/ACT"   , "narrator": "", "text": "よしよしいい子だ"},
        { "location": "150/TALK"  , "narrator": "神楽", "text": "おっおっ？"},
        { "location": "151/TALK"  , "narrator": "神楽", "text": "上から目線いただきました～～"},
        { "location": "163/TALK"  , "narrator": "神楽", "text": "チャットしてると\n少しは気が\n紛れるけど…。"},
        { "location": "165/TALK"  , "narrator": "神楽", "text": "…こういうのって\n逃げなのかな…。"},
        { "location": "166/SEL"   , "narrator": "", "text": "そっちの天気はどう？"},
        { "location": "167/ACT"   , "narrator": "", "text": "そっちの天気はどう？"},
        { "location": "182/TALK"  , "narrator": "神楽", "text": "いい天気ぴょん"},
        { "location": "183/TALK"  , "narrator": "神楽", "text": "日焼け止めしてなかったら危険すぎるレベル"},
        { "location": "185/SEL"   , "narrator": "", "text": "しっかり日焼け止め対策してね"},
        { "location": "186/SEL"   , "narrator": "", "text": "こんがり神楽もかわいいかも"},
        { "location": "187/SEL"   , "narrator": "", "text": "いい天気でよかった"},
        { "location": "188/ACT"   , "narrator": "", "text": "しっかり日焼け止め対策してね"},
        { "location": "189/TALK"  , "narrator": "神楽", "text": "そうするー"},
        { "location": "190/TALK"  , "narrator": "神楽", "text": "赤くなっちゃうからー"},
        { "location": "191/ACT"   , "narrator": "", "text": "こんがり神楽もかわいいかも"},
        { "location": "192/TALK"  , "narrator": "神楽", "text": "ぴょんこは焼けなくて赤くなるヒトなんだぴょん"},
        { "location": "193/TALK"  , "narrator": "神楽", "text": "ちょっとｸﾔｼｰ"},
        { "location": "194/ACT"   , "narrator": "", "text": "いい天気でよかった"},
        { "location": "195/TALK"  , "narrator": "神楽", "text": "それはそう"},
        { "location": "196/TALK"  , "narrator": "神楽", "text": "雨だと気持ちもﾄﾞﾝﾖﾘしちゃうしね♪"},
        { "location": "208/TALK"  , "narrator": "神楽", "text": "…三崎ってマグロが\n有名なんだっけ。"},
        { "location": "209/TALK"  , "narrator": "神楽", "text": "後は何があるんだろ…。"},
        { "location": "210/TALK"  , "narrator": "神楽", "text": "なんて、観光なんて\nしてる余裕ないか…。"},
        { "location": "211/SEL"   , "narrator": "", "text": "$me$は神楽の味方だからね！"},
        { "location": "212/ACT"   , "narrator": "", "text": "$me$は神楽の味方だからね！"},
