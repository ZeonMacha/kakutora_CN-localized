{
    "dir": "chap32/daydra/dd_ch02_32_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "32202",
        "cid": "ayami",
        "title": "002 メインストーリー",
        "sub_title": "偶然は運命にも似て＜前編＞"
    },
    "entry":
    [
        { "location": "8/SCENARIO", "narrator": "", "text": "一路東京へ"},
        { "location": "47/TALK"   , "narrator": "アーヤ", "text": "都内に入ったわよ。"},
        { "location": "48/TALK"   , "narrator": "アーヤ", "text": "後は首都高で一直線。\n文京ドームにも\nもうすぐ着くわ。"},
        { "location": "49/TALK"   , "narrator": "ガブリエラ", "text": "意外と早かったわね。\nもう少しドンパチが\nあるかと思ったけど。"},
        { "location": "51/TALK"   , "narrator": "みやび", "text": "そこはほれ。\nキリト君たちが\nがんばってくれたきね。"},
        { "location": "52/TALK"   , "narrator": "みやび", "text": "なかなか将来有望ちや。"},
        { "location": "54/TALK"   , "narrator": "アーヤ", "text": "…本当は褒められた\nことじゃないけど。"},
        { "location": "55/TALK"   , "narrator": "アーヤ", "text": "助けられたのは\n事実ね。"},
        { "location": "56/TALK"   , "narrator": "アーヤ", "text": "……だけど……。"},
        { "location": "57/TALK"   , "narrator": "アーヤ", "text": "さすがに何も\nなさすぎるような\n気がする。"},
        { "location": "58/TALK"   , "narrator": "アーヤ", "text": "監視システムが\n無効化されたせいで\n混乱しているとしても。"},
        { "location": "59/TALK"   , "narrator": "アーヤ", "text": "人海戦術を取るだけの\n人員はいるはず。"},
        { "location": "60/TALK"   , "narrator": "アーヤ", "text": "なぜその手段を\n取ってないの…？"},
        { "location": "61/SEL"    , "narrator": "", "text": "一言いい？"},
        { "location": "62/ACT"    , "narrator": "", "text": "一言いい？"},
        { "location": "66/TALK"   , "narrator": "みやび", "text": "お。"},
        { "location": "69/TALK"   , "narrator": "みやび", "text": "ラブメッセージが\n来たぞね。"},
        { "location": "73/TALK"   , "narrator": "みやび", "text": "どういた？"},
        { "location": "75/SEL"    , "narrator": "", "text": "油断しないで"},
        { "location": "76/SEL"    , "narrator": "", "text": "ここからが正念場"},
        { "location": "77/SEL"    , "narrator": "", "text": "仕掛けはまだ解除されてない"},
        { "location": "78/ACT"    , "narrator": "", "text": "油断しないで"},
        { "location": "79/TALK"   , "narrator": "みやび", "text": "当然"},
        { "location": "80/TALK"   , "narrator": "みやび", "text": "承知の助"},
        { "location": "82/ACT"    , "narrator": "", "text": "ここからが正念場"},
        { "location": "83/TALK"   , "narrator": "みやび", "text": "そんなことは"},
        { "location": "84/TALK"   , "narrator": "みやび", "text": "わかっちゅう"},
        { "location": "86/ACT"    , "narrator": "", "text": "仕掛けはまだ解除されてない"},
        { "location": "87/TALK"   , "narrator": "みやび", "text": "そうでないと"},
        { "location": "88/TALK"   , "narrator": "みやび", "text": "面白くない"},
        { "location": "95/TALK"   , "narrator": "みやび", "text": "$handle$から\n伝言やき。\n気を付けろって。"},
        { "location": "98/TALK"   , "narrator": "ガブリエラ", "text": "それだけ？"},
        { "location": "99/TALK"   , "narrator": "ガブリエラ", "text": "そんなこと\nわかりきってる。"},
        { "location": "100/TALK"  , "narrator": "アーヤ", "text": "他にも何か\nあるんじゃないの？"},
        { "location": "104/TALK"  , "narrator": "みやび", "text": "他に"},
        { "location": "105/TALK"  , "narrator": "みやび", "text": "言いたいことは？"},
        { "location": "107/SEL"   , "narrator": "", "text": "このままだと死ぬ"},
        { "location": "108/SEL"   , "narrator": "", "text": "とにかく気を抜いちゃダメ"},
        { "location": "109/SEL"   , "narrator": "", "text": "生きることを第一に考えて"},
        { "location": "110/ACT"   , "narrator": "", "text": "このままだと死ぬ"},
        { "location": "115/TALK"  , "narrator": "みやび", "text": "$handle$が\nろくでもないことを\n言うてきた。"},
        { "location": "116/TALK"  , "narrator": "アーヤ", "text": "何？"},
        { "location": "118/TALK"  , "narrator": "みやび", "text": "このままやと\n死ぬらしい。\nうちらは。"},
        { "location": "119/TALK"  , "narrator": "アーヤ", "text": "ふざけないでって\n伝えておいて。"},
        { "location": "120/TALK"  , "narrator": "ガブリエラ", "text": "本当にそうよ。\n縁起でもない。"},
        { "location": "121/ACT"   , "narrator": "", "text": "とにかく気を抜いちゃダメ"},
        { "location": "122/TALK"  , "narrator": "みやび", "text": "それはそう"},
        { "location": "123/TALK"  , "narrator": "みやび", "text": "どうも"},
        { "location": "129/TALK"  , "narrator": "みやび", "text": "$handle$は\nＢＯＴらしいＢＯＴに\n成り下がったぞね。"},
        { "location": "131/TALK"  , "narrator": "ガブリエラ", "text": "どういうこと？"},
        { "location": "133/TALK"  , "narrator": "みやび", "text": "とにかく気を抜くなと。\n汎用的で凡庸な台詞は\n心に響かんねえ。"},
        { "location": "134/ACT"   , "narrator": "", "text": "生きることを第一に考えて"},
        { "location": "135/TALK"  , "narrator": "みやび", "text": "常に考えておる"},
        { "location": "136/TALK"  , "narrator": "みやび", "text": "安心しろ"},
        { "location": "141/TALK"  , "narrator": "みやび", "text": "$handle$は\nおかんキャラを\n目指し始めたみたいぞね。"},
        { "location": "142/TALK"  , "narrator": "アーヤ", "text": "おかんって？"},
        { "location": "143/TALK"  , "narrator": "みやび", "text": "「生きることを\n第一に考えて」\nだそうや。"},
        { "location": "145/TALK"  , "narrator": "アーヤ", "text": "この状況で言ってくる\nこととしてはそんなに\n不思議じゃないけど…。"},
        { "location": "146/TALK"  , "narrator": "アーヤ", "text": "深読みすれば\nまるで未来が\n見えてるみたいな…。"},
        { "location": "147/TALK"  , "narrator": "アーヤ", "text": "じゃあどうして\n未来を知ってるの…？"},
        { "location": "148/TALK"  , "narrator": "アーヤ", "text": "もしかして\n人海戦術を\n取ってないのは。"},
        { "location": "150/TALK"  , "narrator": "アーヤ", "text": "私たちがどこにいるかを\n把握しているから\nだとしたら…？"},
        { "location": "151/TALK"  , "narrator": "アーヤ", "text": "そしてその情報を\n伝えているのは…。"},
        { "location": "157/TALK"  , "narrator": "アーヤ", "text": "っ！？"},
        { "location": "162/TALK"  , "narrator": "ガブリエラ", "text": "ちょっとアーヤ！\n急ハンドルとか\n危ないわよ！"},
        { "location": "164/TALK"  , "narrator": "みやび", "text": "…安全運転で\nオナシャス…！"},
        { "location": "165/TALK"  , "narrator": "アーヤ", "text": "違う、違うのよ！"},
        { "location": "166/TALK"  , "narrator": "ガブリエラ", "text": "何が違うの？"},
        { "location": "167/TALK"  , "narrator": "ガブリエラ", "text": "元々運転が荒いのは\n知ってるけど！"},
        { "location": "168/TALK"  , "narrator": "ガブリエラ", "text": "それにしても\nひどすぎるわよ！"},
        { "location": "169/TALK"  , "narrator": "みやび", "text": "もう少し淑女な走りを\n期待したいちや…。"},
        { "location": "171/TALK"  , "narrator": "ガブリエラ", "text": "首都高だからって\nスピード出しすぎ\nでしょ！"},
        { "location": "172/TALK"  , "narrator": "アーヤ", "text": "私じゃない！\nコントロールが\n利かないの！"},
        { "location": "173/TALK"  , "narrator": "アーヤ", "text": "ハンドルもブレーキも\n利かないのよ！"},
        { "location": "174/TALK"  , "narrator": "ガブリエラ", "text": "えっ！？"},
        { "location": "175/TALK"  , "narrator": "アーヤ", "text": "止められないわ！"},
        { "location": "186/TALK"  , "narrator": "アーヤ", "text": "ちょと"},
        { "location": "187/TALK"  , "narrator": "アーヤ", "text": "どうにかして"},
        { "location": "189/SEL"   , "narrator": "", "text": "ごめん無理"},
        { "location": "190/SEL"   , "narrator": "", "text": "$me$が？"},
        { "location": "191/SEL"   , "narrator": "", "text": "こっちにもわからないし"},
        { "location": "192/ACT"   , "narrator": "", "text": "ごめん無理"},
        { "location": "194/TALK"  , "narrator": "アーヤ", "text": "むりとか"},
        { "location": "195/ACT"   , "narrator": "", "text": "$me$が？"},
        { "location": "196/TALK"  , "narrator": "アーヤ", "text": "そうよ"},
        { "location": "197/ACT"   , "narrator": "", "text": "こっちにもわからないし"},
        { "location": "198/TALK"  , "narrator": "アーヤ", "text": "なんで"},
        { "location": "200/TALK"  , "narrator": "アーヤ", "text": "さっきわざわざ"},
        { "location": "201/TALK"  , "narrator": "アーヤ", "text": "言ってきたのに？"},
        { "location": "203/SEL"   , "narrator": "", "text": "それはそうだけど"},
        { "location": "204/SEL"   , "narrator": "", "text": "詳しくは$me$もわからなくて"},
        { "location": "205/SEL"   , "narrator": "", "text": "わかったらどうにかする"},
        { "location": "206/ACT"   , "narrator": "", "text": "それはそうだけど"},
        { "location": "207/TALK"  , "narrator": "アーヤ", "text": "そうって"},
        { "location": "208/ACT"   , "narrator": "", "text": "詳しくは$me$もわからなくて"},
        { "location": "209/TALK"  , "narrator": "アーヤ", "text": "そんな"},
        { "location": "210/ACT"   , "narrator": "", "text": "わかったらどうにかする"},
        { "location": "211/TALK"  , "narrator": "アーヤ", "text": "わかって"},
        { "location": "213/TALK"  , "narrator": "アーヤ", "text": "ねえ"},
        { "location": "214/TALK"  , "narrator": "アーヤ", "text": "$handle$さんは本当に"},
        { "location": "215/TALK"  , "narrator": "アーヤ", "text": "味方なの？"},
        { "location": "217/SEL"   , "narrator": "", "text": "当たり前でしょ！？"},
        { "location": "218/SEL"   , "narrator": "", "text": "ちょっとちょっと"},
        { "location": "219/SEL"   , "narrator": "", "text": "疑ってるの？"},
        { "location": "220/ACT"   , "narrator": "", "text": "当たり前でしょ！？"},
        { "location": "221/ACT"   , "narrator": "", "text": "ちょっとちょっと"},
        { "location": "222/ACT"   , "narrator": "", "text": "疑ってるの？"},
        { "location": "227/TALK"  , "narrator": "アーヤ", "text": "もう死ぬの…！？\n死ぬしかないの…！？"},
        { "location": "228/TALK"  , "narrator": "アーヤ", "text": "助けて…！\n誰か…助けて…！"},
        { "location": "230/TALK"  , "narrator": "アーヤ", "text": "助けて、\nお姉ちゃん…！"},
        { "location": "279/TALK"  , "narrator": "アーヤ", "text": "　"},
        { "location": "328/TALK"  , "narrator": "昇華エヴェレット", "text": "$handle$さん……\nお久し振り。"},
        { "location": "329/SEL"   , "narrator": "", "text": "エヴェレット…"},
        { "location": "330/ACT"   , "narrator": "", "text": "エヴェレット…"},
        { "location": "332/TALK"  , "narrator": "昇華エヴェレット", "text": "…どうしたの？"},
        { "location": "333/SEL"   , "narrator": "", "text": "発症しちゃうなんて…"},
        { "location": "334/SEL"   , "narrator": "", "text": "カッコイイ！！"},
        { "location": "335/ACT"   , "narrator": "", "text": "発症しちゃうなんて…"},
        { "location": "336/TALK"  , "narrator": "昇華エヴェレット", "text": "そんな\n悲観的にならないで。"},
        { "location": "337/TALK"  , "narrator": "昇華エヴェレット", "text": "事が終わって\n私自身の整理がついたら\n元に戻れるから。"},
        { "location": "338/ACT"   , "narrator": "", "text": "カッコイイ！！"},
        { "location": "339/TALK"  , "narrator": "昇華エヴェレット", "text": "ありがとう。"},
        { "location": "341/TALK"  , "narrator": "昇華エヴェレット", "text": "でも、今は\nそれどころじゃ\nなくなってる。"},
        { "location": "342/SEL"   , "narrator": "", "text": "どうしたの？"},
        { "location": "343/ACT"   , "narrator": "", "text": "どうしたの？"},
        { "location": "345/TALK"  , "narrator": "昇華エヴェレット", "text": "セルフクランが\n本気で発症しかかってる。"},
        { "location": "346/TALK"  , "narrator": "昇華エヴェレット", "text": "このままだと私は\nフェノメノンを生み出して\nしまうことになる。"},
        { "location": "347/SEL"   , "narrator": "", "text": "どういうこと！？"},
        { "location": "348/ACT"   , "narrator": "", "text": "どういうこと！？"},
        { "location": "350/TALK"  , "narrator": "昇華エヴェレット", "text": "外部因子である千羽鶴が\n私の人格の1人、白烏を\n媒介として種を植えた。"},
        { "location": "351/TALK"  , "narrator": "昇華エヴェレット", "text": "それによって\n発症時にフェノメノンを\n生成できるようになる。"},
        { "location": "352/SEL"   , "narrator": "", "text": "セルフクランが発症したら、必ずフェノメノンが出るわけじゃないのか"},
        { "location": "353/ACT"   , "narrator": "", "text": "セルフクランが発症したら、必ずフェノメノンが出るわけじゃないのか"},
        { "location": "355/TALK"  , "narrator": "昇華エヴェレット", "text": "そう。\nフェノメノンを発症する\n為には種が必要なの。"},
        { "location": "356/TALK"  , "narrator": "昇華エヴェレット", "text": "そうでなければ、\n今頃全国フェノメノン\nだらけになってる。"},
        { "location": "357/TALK"  , "narrator": "昇華エヴェレット", "text": "そして、それにプラスして\n私はもう１つの衝撃的な\n事実を知った。"},
        { "location": "358/SEL"   , "narrator": "", "text": "凄くいやな予感がするんだけど"},
        { "location": "359/ACT"   , "narrator": "", "text": "凄くいやな予感がするんだけど"},
        { "location": "361/TALK"  , "narrator": "昇華エヴェレット", "text": "多分、貴方にとっては\n大した問題じゃない。"},
        { "location": "362/TALK"  , "narrator": "昇華エヴェレット", "text": "でも、私にとっては\n世界がひっくり返るほどの\nことだった。"},
        { "location": "363/TALK"  , "narrator": "昇華エヴェレット", "text": "それは……"},
        { "location": "364/TALK"  , "narrator": "昇華エヴェレット", "text": "私のセルフクラン、\n水鏡の神子は、ずっと\n発症を覗っていた。"},
        { "location": "365/TALK"  , "narrator": "昇華エヴェレット", "text": "発症し、フェノメノンを\n展開することを悲願と\nしていたの。…ずっと。"},
        { "location": "366/SEL"   , "narrator": "", "text": "それって現実のアーヤがフェノメノンになりたがってるってこと？"},
        { "location": "367/ACT"   , "narrator": "", "text": "それって現実のアーヤがフェノメノンになりたがってるってこと？"},
        { "location": "369/TALK"  , "narrator": "昇華エヴェレット", "text": "普通に考えれば\nそういう事になるわね。"},
        { "location": "370/TALK"  , "narrator": "昇華エヴェレット", "text": "百歩譲っても、\n潜在意識としては\n発症願望があるってこと。"},
        { "location": "371/TALK"  , "narrator": "昇華エヴェレット", "text": "けど、私は\nそうは思えない。"},
        { "location": "372/TALK"  , "narrator": "昇華エヴェレット", "text": "私の日常を思い返して\nみても、発症願望を疑える\nところなんて無い。"},
        { "location": "373/SEL"   , "narrator": "", "text": "確かに、$me$から見ても無いね"},
        { "location": "374/SEL"   , "narrator": "", "text": "神楽が裏切った時とか？"},
        { "location": "375/ACT"   , "narrator": "", "text": "確かに、$me$から見ても無いね"},
        { "location": "376/TALK"  , "narrator": "昇華エヴェレット", "text": "そうよね。\nだからとても怪しいの。"},
        { "location": "377/ACT"   , "narrator": "", "text": "神楽が裏切った時とか？"},
        { "location": "378/TALK"  , "narrator": "昇華エヴェレット", "text": "いいえ。\nあの時は\nそこまでではないわね。"},
        { "location": "379/TALK"  , "narrator": "昇華エヴェレット", "text": "あと、１つ間違えやすい\nのは、普通フェノメノンは\n発症願望で発症しない。"},
        { "location": "380/TALK"  , "narrator": "昇華エヴェレット", "text": "何か別のことで\n想い極まった結果、本人も\n訳が解らず発症する。"},
        { "location": "381/TALK"  , "narrator": "昇華エヴェレット", "text": "セルフクランが思っている\nのは『フェノメノンに\nなりたい』という想い。"},
        { "location": "382/SEL"   , "narrator": "", "text": "なんでそんなことを…？"},
        { "location": "383/ACT"   , "narrator": "", "text": "なんでそんなことを…？"},
        { "location": "385/TALK"  , "narrator": "昇華エヴェレット", "text": "わからない。"},
        { "location": "388/TALK"  , "narrator": "昇華エヴェレット", "text": "とにかく、それを知った\n私は、命がけで止める\n決意をした。"},
        { "location": "389/TALK"  , "narrator": "昇華エヴェレット", "text": "そして、その為には\n発症…すなわち私が\n昇華する他無いと思った。"},
        { "location": "390/TALK"  , "narrator": "昇華エヴェレット", "text": "けど、それに危機感を\n覚えた千羽鶴は、私を\n無力化しに来たの。"},
        { "location": "391/TALK"  , "narrator": "昇華エヴェレット", "text": "結果として私は、人格と\nして本人への影響を与える\nことが出来なくなった。"},
        { "location": "392/SEL"   , "narrator": "", "text": "それで姿を見せられないって事になったんだね"},
        { "location": "393/ACT"   , "narrator": "", "text": "それで姿を見せられないって事になったんだね"},
        { "location": "395/TALK"  , "narrator": "昇華エヴェレット", "text": "そういうこと。"},
        { "location": "397/TALK"  , "narrator": "昇華エヴェレット", "text": "いくら彼女といえど、\n他人の人格を完全に消す\nことはできないから。"},
        { "location": "398/TALK"  , "narrator": "昇華エヴェレット", "text": "それに、千羽鶴が私を\nアーヤ本体に影響できなく\nしたのは失策だったわね。"},
        { "location": "399/TALK"  , "narrator": "昇華エヴェレット", "text": "それによって私は、\n迷わずに昇華できる\nようになったんだから。"},
        { "location": "400/TALK"  , "narrator": "昇華エヴェレット", "text": "人格の昇華は本体に\n影響を与えるから、普段は\nかなり慎重になる。"},
        { "location": "401/TALK"  , "narrator": "昇華エヴェレット", "text": "けど今回は、切り離されて\nいたことで、影響を与えず\n昇華できた。"},
        { "location": "403/TALK"  , "narrator": "昇華エヴェレット", "text": "…とまあ、そんな感じで\n今の私があるというわけ。"},
        { "location": "404/SEL"   , "narrator": "", "text": "色々わかってよかった"},
        { "location": "405/SEL"   , "narrator": "", "text": "アーヤ発症しちゃうの？"},
        { "location": "406/ACT"   , "narrator": "", "text": "色々わかってよかった"},
        { "location": "407/TALK"  , "narrator": "昇華エヴェレット", "text": "私も、やっと\n全部話せてよかった。"},
        { "location": "408/TALK"  , "narrator": "昇華エヴェレット", "text": "それでね、今の\nアーヤの状況だけど――"},
        { "location": "409/TALK"  , "narrator": "昇華エヴェレット", "text": "現状だと、非常に\n発症する可能性が高い。"},
        { "location": "410/ACT"   , "narrator": "", "text": "アーヤ発症しちゃうの？"},
        { "location": "411/TALK"  , "narrator": "昇華エヴェレット", "text": "今のままだと、\nかなり可能性は高い。"},
        { "location": "413/TALK"  , "narrator": "昇華エヴェレット", "text": "判ってると思うけど、\n今、過去に類を見ない\n危機的状況にある。"},
        { "location": "414/TALK"  , "narrator": "昇華エヴェレット", "text": "なぜ車が暴走しているのか\nそこは一旦\n置いておいてく。"},
        { "location": "415/TALK"  , "narrator": "昇華エヴェレット", "text": "１つハッキリしているのは\n私の精神状態はもはや\n限界ということ。"},
        { "location": "416/TALK"  , "narrator": "昇華エヴェレット", "text": "それはセルフクランと\n様々な人格たちに、\n発症を促すことになる。"},
        { "location": "417/TALK"  , "narrator": "昇華エヴェレット", "text": "そして水鏡の神子は、\n今こそと発症を試みて\nいるというわけ。"},
        { "location": "418/SEL"   , "narrator": "", "text": "止めに行かなくちゃ"},
        { "location": "419/SEL"   , "narrator": "", "text": "発症しちゃえば？"},
        { "location": "420/ACT"   , "narrator": "", "text": "止めに行かなくちゃ"},
        { "location": "423/TALK"  , "narrator": "昇華エヴェレット", "text": "ありがとう。"},
        { "location": "424/TALK"  , "narrator": "昇華エヴェレット", "text": "貴方にそう言って\nもらえるのを待ってた。"},
        { "location": "425/ACT"   , "narrator": "", "text": "発症しちゃえば？"},
        { "location": "428/TALK"  , "narrator": "昇華エヴェレット", "text": "え…？\n貴方何を――"},
        { "location": "433/TALK"  , "narrator": "千羽鶴", "text": "発症を止めに行くのは\n待って欲しい。"},
        { "location": "435/TALK"  , "narrator": "昇華エヴェレット", "text": "…！？\n千羽鶴……"},
        { "location": "436/TALK"  , "narrator": "千羽鶴", "text": "お久し振り。\nエヴェレット。"},
        { "location": "437/TALK"  , "narrator": "千羽鶴", "text": "しばらく追い出されて\nいたから来れなかったけど\nやっと戻ってこれた。"},
        { "location": "441/SEL"   , "narrator": "", "text": "千羽鶴…"},
        { "location": "442/ACT"   , "narrator": "", "text": "千羽鶴…"},
        { "location": "445/TALK"  , "narrator": "千羽鶴", "text": "こんにちは。\nまた会ったわね。"},
        { "location": "446/SEL"   , "narrator": "", "text": "また発症させに来たのか？"},
        { "location": "447/SEL"   , "narrator": "", "text": "一応、どういうことかもう一度説明してもらってもいい？"},
        { "location": "448/ACT"   , "narrator": "", "text": "また発症させに来たのか？"},
        { "location": "449/TALK"  , "narrator": "千羽鶴", "text": "その通り。\n話が早くて助かる。"},
        { "location": "451/TALK"  , "narrator": "千羽鶴", "text": "貴方のセルフクランは、\n発症によりフェノメノンを\n展開する事を望んでいる。"},
        { "location": "452/TALK"  , "narrator": "千羽鶴", "text": "それは、逢瀬つばめに\n洗脳された$ev32_fullname$\nのことではない。"},
        { "location": "453/TALK"  , "narrator": "千羽鶴", "text": "日本を覆うフェノメノンの\n外側、現実における\n$ev32_fullname$のこと。"},
        { "location": "454/TALK"  , "narrator": "千羽鶴", "text": "彼女と私とは\n誓いを立てている。"},
        { "location": "455/TALK"  , "narrator": "千羽鶴", "text": "だから私には、\n彼女を発症させる\n義務がある。"},
        { "location": "456/ACT"   , "narrator": "", "text": "一応、どういうことかもう一度説明してもらってもいい？"},
        { "location": "457/TALK"  , "narrator": "千羽鶴", "text": "わかった。\n大事な事なので\n何度でも説明する。"},
        { "location": "458/TALK"  , "narrator": "千羽鶴", "text": "私はセルフクランを\n発症させたいと思ってる。"},
        { "location": "459/TALK"  , "narrator": "千羽鶴", "text": "そして、発症させるのに\n貴方の力は\nとても役にたつ。"},
        { "location": "464/SEL"   , "narrator": "", "text": "どうしてここに！？"},
        { "location": "465/ACT"   , "narrator": "", "text": "どうしてここに！？"},
        { "location": "468/TALK"  , "narrator": "千羽鶴", "text": "こんにちは。"},
        { "location": "469/TALK"  , "narrator": "千羽鶴", "text": "貴方こそ、\nどうしてここに？"},
        { "location": "470/TALK"  , "narrator": "千羽鶴", "text": "まあでも、\n貴方が今ここにいて\nくれたのは好都合。"},
        { "location": "471/TALK"  , "narrator": "千羽鶴", "text": "発症には貴方がいて\nくれた方がよりスムーズ。"},
        { "location": "473/TALK"  , "narrator": "千羽鶴", "text": "手伝ってもらえる？"},
        { "location": "474/SEL"   , "narrator": "", "text": "もちろん"},
        { "location": "475/SEL"   , "narrator": "", "text": "まさか"},
        { "location": "476/ACT"   , "narrator": "", "text": "もちろん"},
        { "location": "478/TALK"  , "narrator": "千羽鶴", "text": "ありがと。"},
        { "location": "479/ACT"   , "narrator": "", "text": "まさか"},
        { "location": "482/TALK"  , "narrator": "千羽鶴", "text": "まさか？"},
        { "location": "483/TALK"  , "narrator": "千羽鶴", "text": "まさか、\nそんなはずはない。"},
        { "location": "484/TALK"  , "narrator": "千羽鶴", "text": "貴方は確かに言った。\n『千羽鶴の為、彼女に\n犠牲になってもらう』と。"},
        { "location": "485/SEL"   , "narrator": "", "text": "言いましたね"},
        { "location": "486/SEL"   , "narrator": "", "text": "身に覚えがありません"},
        { "location": "487/ACT"   , "narrator": "", "text": "言いましたね"},
        { "location": "488/ACT"   , "narrator": "", "text": "身に覚えがありません"},
        { "location": "489/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "490/TALK"  , "narrator": "千羽鶴", "text": "ならばOSのシステムバグ\nということになる。"},
        { "location": "491/TALK"  , "narrator": "千羽鶴", "text": "OSの製造元に問い合わせて\n修正してもらったら？"},
        { "location": "494/TALK"  , "narrator": "千羽鶴", "text": "ちなみに、このツッコミは\n彼女を不幸にする事を肯定\nするものではない。"},
        { "location": "495/TALK"  , "narrator": "千羽鶴", "text": "発症に関しては、目先だけ\n見れば不幸を強いている\nように見えるかもだけど、"},
        { "location": "496/TALK"  , "narrator": "千羽鶴", "text": "彼女の本質的な\n見方をすれば、彼女の\n幸せに繋がること。"},
        { "location": "497/TALK"  , "narrator": "千羽鶴", "text": "問題はそこではなく。"},
        { "location": "498/TALK"  , "narrator": "千羽鶴", "text": "貴方が彼女を不幸にすると\n『思い込んだ』事に対して\n私の協力を拒んだこと。"},
        { "location": "499/TALK"  , "narrator": "千羽鶴", "text": "私を犠牲にしても彼女を\n護る、の方を選んだのなら\n全く問題無いのだけど。"},
        { "location": "500/TALK"  , "narrator": "千羽鶴", "text": "……まあ、\nこの事については、もう\nこれくらいにしておく。"},
        { "location": "501/TALK"  , "narrator": "千羽鶴", "text": "口頭質問だったし、\n貴方もさほど考えて回答\nしてないのでしょうし。"},
        { "location": "502/TALK"  , "narrator": "千羽鶴", "text": "そんなことより、\nセルフクランの発症の話。"},
        { "location": "503/TALK"  , "narrator": "千羽鶴", "text": "発症は彼女にとっては\n寧ろ幸せに繋がること。"},
        { "location": "506/TALK"  , "narrator": "千羽鶴", "text": "まあ、\n予想はしていた。"},
        { "location": "507/TALK"  , "narrator": "千羽鶴", "text": "確かに、イメージとして\n発症はかなり印象悪い。"},
        { "location": "508/TALK"  , "narrator": "千羽鶴", "text": "協力するのは殺人に手を\n貸すのと同じ、くらいの\n印象なんでしょう？"},
        { "location": "509/SEL"   , "narrator": "", "text": "実際そうでしょ"},
        { "location": "510/SEL"   , "narrator": "", "text": "そこまでは言ってない"},
        { "location": "511/ACT"   , "narrator": "", "text": "実際そうでしょ"},
        { "location": "512/TALK"  , "narrator": "千羽鶴", "text": "発症は殺人ではない。"},
        { "location": "513/TALK"  , "narrator": "千羽鶴", "text": "それは、量子学とケーキが\n同じものだと言うくらい\n意味が分からない。"},
        { "location": "514/ACT"   , "narrator": "", "text": "そこまでは言ってない"},
        { "location": "515/TALK"  , "narrator": "千羽鶴", "text": "そう？\nでも、いやなことだと\n思ったのでしょう？"},
        { "location": "517/TALK"  , "narrator": "千羽鶴", "text": "結論から言えば、\n発症は彼女を\n不幸にするものではない。"},
        { "location": "518/TALK"  , "narrator": "千羽鶴", "text": "目先だけを見れば\n不幸を強いているように\n見えるかもだけど――"},
        { "location": "519/TALK"  , "narrator": "千羽鶴", "text": "彼女の本質的な\n見方をすれば、彼女の\n幸せに繋がること。"},
        { "location": "523/SEL"   , "narrator": "", "text": "何故！？"},
        { "location": "524/ACT"   , "narrator": "", "text": "何故！？"},
        { "location": "526/TALK"  , "narrator": "千羽鶴", "text": "さっき\n$ev32_lib$が\n言ったとおり。"},
        { "location": "527/TALK"  , "narrator": "千羽鶴", "text": "セルフクランは発症による\nフェノメノン化を\n望んでいる――。"},
        { "location": "528/SEL"   , "narrator": "", "text": "いやいやいや、なぜそう言い切れる！？"},
        { "location": "529/ACT"   , "narrator": "", "text": "いやいやいや、なぜそう言い切れる！？"},
        { "location": "531/TALK"  , "narrator": "千羽鶴", "text": "彼女と私とは\n誓いを立てているから。"},
        { "location": "532/TALK"  , "narrator": "千羽鶴", "text": "忘れてない？\n今の日本が巨大な\nフェノメノンであること。"},
        { "location": "533/TALK"  , "narrator": "千羽鶴", "text": "そして、フェノメノンより\n前の$ev32_fullname$には\n別の人生があったことを。"},
        { "location": "534/SEL"   , "narrator": "", "text": "あ"},
        { "location": "535/ACT"   , "narrator": "", "text": "あ"},
        { "location": "540/TALK"  , "narrator": "昇華エヴェレット", "text": "それでも私は、\n発症を食い止める！"},
        { "location": "541/TALK"  , "narrator": "千羽鶴", "text": "どうやって？"},
        { "location": "542/TALK"  , "narrator": "昇華エヴェレット", "text": "セルフクランのココロの\nざわめきは、私たち人格の\n総意によるもの。"},
        { "location": "543/TALK"  , "narrator": "昇華エヴェレット", "text": "私が働きかけて、\n不必要にざわめくクランを\n消滅させていけば――"},
        { "location": "544/TALK"  , "narrator": "昇華エヴェレット", "text": "この状況下においても\n平静を保つことができ、\n発症を防げるはず。"},
        { "location": "545/TALK"  , "narrator": "昇華エヴェレット", "text": "それは、今までもずっと\nやってきたこと。"},
        { "location": "546/TALK"  , "narrator": "昇華エヴェレット", "text": "$handle$さんと\n私とで、このココロ\nゲートでずっと！"},
        { "location": "548/SEL"   , "narrator": "", "text": "ダメだ落ち着け！\n千羽鶴に支配される！"},
        { "location": "549/ACT"   , "narrator": "", "text": "ダメだ落ち着け！\n千羽鶴に支配される！"},
        { "location": "551/TALK"  , "narrator": "昇華エヴェレット", "text": "え？"},
        { "location": "552/TALK"  , "narrator": "千羽鶴", "text": "もう遅い。"},
        { "location": "554/TALK"  , "narrator": "昇華エヴェレット", "text": "お願い、\n$handle$さん。"},
        { "location": "555/TALK"  , "narrator": "昇華エヴェレット", "text": "私と一緒に、心を\nざわめかせているクランを\n消滅させて。"},
        { "location": "556/TALK"  , "narrator": "昇華エヴェレット", "text": "そうすれば、\nセルフクランは\n発症を回避できる！"},
        { "location": "557/SEL"   , "narrator": "", "text": "もちろん"},
        { "location": "558/SEL"   , "narrator": "", "text": "だが断る"},
        { "location": "559/ACT"   , "narrator": "", "text": "もちろん"},
        { "location": "561/TALK"  , "narrator": "昇華エヴェレット", "text": "ありがとう！"},
        { "location": "562/ACT"   , "narrator": "", "text": "だが断る"},
        { "location": "564/TALK"  , "narrator": "昇華エヴェレット", "text": "そんな！"},
        { "location": "566/TALK"  , "narrator": "千羽鶴", "text": "残念だけど、\nそれは出来ないと思う。"},
        { "location": "567/TALK"  , "narrator": "昇華エヴェレット", "text": "出来るわよ！"},
        { "location": "568/TALK"  , "narrator": "千羽鶴", "text": "無理よ。\nだって私が――"},
        { "location": "569/TALK"  , "narrator": "千羽鶴", "text": "貴方を破壊するから。"},
        { "location": "576/TALK"  , "narrator": "昇華エヴェレット", "text": "きゃあああああっ！！"},
        { "location": "581/SEL"   , "narrator": "", "text": "エヴェレット！？"},
        { "location": "582/SEL"   , "narrator": "", "text": "何やってる千羽鶴！！"},
        { "location": "583/ACT"   , "narrator": "", "text": "エヴェレット！？"},
        { "location": "588/TALK"  , "narrator": "昇華エヴェレット", "text": "たす…けて……\nココロの……内側から…\nなにかが……っ！！"},
        { "location": "593/TALK"  , "narrator": "昇華エヴェレット", "text": "何かが\n操ってる…っ！！"},
        { "location": "594/ACT"   , "narrator": "", "text": "何やってる千羽鶴！！"},
        { "location": "596/TALK"  , "narrator": "千羽鶴", "text": "さっきと同じで、\n一時的に人格の変化を\n促してるだけ。"},
        { "location": "597/TALK"  , "narrator": "千羽鶴", "text": "事が終われば\n元に戻すから\n心配しないで。"},
        { "location": "599/TALK"  , "narrator": "千羽鶴", "text": "この子の心を\n一時的に、擬似的に\n変化させてるだけ。"},
        { "location": "600/TALK"  , "narrator": "千羽鶴", "text": "フェノメノンに洗脳された\n人と同じ状態を、人格に\n作り出してるだけだから。"},
        { "location": "601/TALK"  , "narrator": "千羽鶴", "text": "心配しないで。"},
        { "location": "608/TALK"  , "narrator": "昇華エヴェレット", "text": "お願いっ……\n$handle$さんっ！！"},
        { "location": "613/TALK"  , "narrator": "昇華エヴェレット", "text": "私を壊して！！"},
        { "location": "616/SEL"   , "narrator": "", "text": "出来るか！！"},
        { "location": "617/ACT"   , "narrator": "", "text": "出来るか！！"},
        { "location": "619/TALK"  , "narrator": "昇華エヴェレット", "text": "大丈夫！！\nクランの…収束と…っ…\n同じことだから…っ…"},
        { "location": "625/TALK"  , "narrator": "昇華エヴェレット", "text": "死にはしないから…っ！\n早く！！！"},
        { "location": "46/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>9月11日　 5:12 PM</color>\n長野から東京へ戻る途中、アーケロン車内にて。"},
        { "location": "244/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "246/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "248/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "250/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "252/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"}
    ]
}
