    "entry":
    [
        { "location": "148/SCENARIO", "narrator": "", "text": "490_未来計算"},
        { "location": "173/TALK"    , "narrator": "みやび", "text": "うちもそのうち"},
        { "location": "174/TALK"    , "narrator": "みやび", "text": "高校生じゃなくなるぞね"},
        { "location": "176/SEL"     , "narrator": "", "text": "そうだね？"},
        { "location": "177/SEL"     , "narrator": "", "text": "留年すればいいよ"},
        { "location": "178/SEL"     , "narrator": "", "text": "将来のこととか考えてるの？"},
        { "location": "179/ACT"     , "narrator": "", "text": "そうだね？"},
        { "location": "180/TALK"    , "narrator": "みやび", "text": "そうなのだよ"},
        { "location": "182/TALK"    , "narrator": "みやび", "text": "全くもって"},
        { "location": "183/TALK"    , "narrator": "みやび", "text": "信じられぬ"},
        { "location": "184/ACT"     , "narrator": "", "text": "留年すればいいよ"},
        { "location": "185/TALK"    , "narrator": "みやび", "text": "なるほど！"},
        { "location": "186/TALK"    , "narrator": "みやび", "text": "って"},
        { "location": "187/TALK"    , "narrator": "みやび", "text": "それでは解決にならんぞね"},
        { "location": "188/ACT"     , "narrator": "", "text": "将来のこととか考えてるの？"},
        { "location": "198/TALK"    , "narrator": "みやび", "text": "うむ"},
        { "location": "199/TALK"    , "narrator": "みやび", "text": "実はそうなのだ"},
        { "location": "201/SEL"     , "narrator": "", "text": "大学には行くんでしょ？"},
        { "location": "202/SEL"     , "narrator": "", "text": "シリコンバレーで起業"},
        { "location": "203/SEL"     , "narrator": "", "text": "$me$のおよめさん"},
        { "location": "204/ACT"     , "narrator": "", "text": "大学には行くんでしょ？"},
        { "location": "205/TALK"    , "narrator": "みやび", "text": "左様"},
        { "location": "206/TALK"    , "narrator": "みやび", "text": "まずはそっちか"},
        { "location": "207/TALK"    , "narrator": "みやび", "text": "ぬぬぬぬぬ"},
        { "location": "208/ACT"     , "narrator": "", "text": "シリコンバレーで起業"},
        { "location": "209/TALK"    , "narrator": "みやび", "text": "それは夢があるの"},
        { "location": "211/TALK"    , "narrator": "みやび", "text": "格好いいし"},
        { "location": "212/TALK"    , "narrator": "みやび", "text": "うまくいけばだが"},
        { "location": "213/ACT"     , "narrator": "", "text": "$me$のおよめさん"},
        { "location": "215/TALK"    , "narrator": "みやび", "text": "あ"},
        { "location": "216/TALK"    , "narrator": "みやび", "text": "なんだそれは"},
        { "location": "217/TALK"    , "narrator": "みやび", "text": "なんなんだそれは"},
        { "location": "220/SEL"     , "narrator": "", "text": "配偶者"},
        { "location": "221/SEL"     , "narrator": "", "text": "ヨメ"},
        { "location": "222/SEL"     , "narrator": "", "text": "人生のパートナー"},
        { "location": "223/ACT"     , "narrator": "", "text": "配偶者"},
        { "location": "224/TALK"    , "narrator": "みやび", "text": "堅い言い方をすればいいというものではない"},
        { "location": "225/ACT"     , "narrator": "", "text": "ヨメ"},
        { "location": "226/TALK"    , "narrator": "みやび", "text": "なんと生活感に溢れた言葉か"},
        { "location": "227/ACT"     , "narrator": "", "text": "人生のパートナー"},
        { "location": "228/TALK"    , "narrator": "みやび", "text": "なんとかシンポジウムなどで聞くような言い方を"},
        { "location": "230/TALK"    , "narrator": "みやび", "text": "なんということを言い出すのだ"},
        { "location": "232/SEL"     , "narrator": "", "text": "前々から考えてた"},
        { "location": "233/SEL"     , "narrator": "", "text": "この機会に考えて"},
        { "location": "234/ACT"     , "narrator": "", "text": "前々から考えてた"},
        { "location": "235/TALK"    , "narrator": "みやび", "text": "前々から"},
        { "location": "236/TALK"    , "narrator": "みやび", "text": "だと"},
        { "location": "237/ACT"     , "narrator": "", "text": "この機会に考えて"},
        { "location": "238/TALK"    , "narrator": "みやび", "text": "この機会に"},
        { "location": "239/TALK"    , "narrator": "みやび", "text": "だと"},
        { "location": "241/TALK"    , "narrator": "みやび", "text": "無茶を言うな"},
        { "location": "242/TALK"    , "narrator": "みやび", "text": "それは無茶だ"},
        { "location": "244/SEL"     , "narrator": "", "text": "何で？"},
        { "location": "245/SEL"     , "narrator": "", "text": "そんなことないでしょ"},
        { "location": "246/SEL"     , "narrator": "", "text": "悲しいな"},
        { "location": "247/ACT"     , "narrator": "", "text": "何で？"},
        { "location": "248/TALK"    , "narrator": "みやび", "text": "いやいやいやいや"},
        { "location": "249/ACT"     , "narrator": "", "text": "そんなことないでしょ"},
        { "location": "250/TALK"    , "narrator": "みやび", "text": "まさかまさかまさか"},
        { "location": "251/ACT"     , "narrator": "", "text": "悲しいな"},
        { "location": "252/TALK"    , "narrator": "みやび", "text": "それは"},
        { "location": "254/TALK"    , "narrator": "みやび", "text": "それは"},
        { "location": "255/TALK"    , "narrator": "みやび", "text": "悪かった"},
        { "location": "257/TALK"    , "narrator": "みやび", "text": "色々あるろう"},
        { "location": "259/SEL"     , "narrator": "", "text": "あるだろうけどさ"},
        { "location": "260/SEL"     , "narrator": "", "text": "だからちゃんと考えようよ"},
        { "location": "261/SEL"     , "narrator": "", "text": "考えたくなかった？"},
        { "location": "262/ACT"     , "narrator": "", "text": "あるだろうけどさ"},
        { "location": "263/TALK"    , "narrator": "みやび", "text": "うむ"},
        { "location": "264/ACT"     , "narrator": "", "text": "だからちゃんと考えようよ"},
        { "location": "265/TALK"    , "narrator": "みやび", "text": "だからて"},
        { "location": "266/ACT"     , "narrator": "", "text": "考えたくなかった？"},
        { "location": "267/TALK"    , "narrator": "みやび", "text": "いや"},
        { "location": "269/TALK"    , "narrator": "みやび", "text": "まさかそんなことを"},
        { "location": "270/TALK"    , "narrator": "みやび", "text": "$handle$から言われるとは"},
        { "location": "272/SEL"     , "narrator": "", "text": "なんで？"},
        { "location": "273/ACT"     , "narrator": "", "text": "なんで？"},
        { "location": "274/TALK"    , "narrator": "みやび", "text": "なんでって"},
        { "location": "275/TALK"    , "narrator": "みやび", "text": "なんでって"},
        { "location": "277/TALK"    , "narrator": "みやび", "text": "そんなこと言えるものか！"},
        { "location": "279/TALK"    , "narrator": "みやび", "text": "何を言わせるつもりだ！！！！！！！！！"},
        { "location": "282/TALK"    , "narrator": "みやび", "text": "全くもう"},
        { "location": "283/TALK"    , "narrator": "みやび", "text": "ふざけおってからに！"},
        { "location": "286/TALK"    , "narrator": "ボイスメール", "text": "未来予想図はまだ白紙"},
        { "location": "194/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>1000pt.</b></color></size>\nアップしました！"},
        { "location": "298/DIALOG"  , "narrator": "Dialog_GETVoice", "text": "<color=green>【みやび】</color>のボイスメール\n<color=red>【未来予想図はまだ白紙】</color>\nをゲットしました！"}
    ]
}
