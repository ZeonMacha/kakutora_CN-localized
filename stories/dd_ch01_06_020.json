{
    "dir": "chap06/daydra/dd_ch01_06_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "6156",
        "cid": "tsubame",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "心配されるつばめ"
    },
    "entry":
    [
        { "location": "197/SCENARIO", "narrator": "", "text": "心配されるつばめ"},
        { "location": "208/TALK"    , "narrator": "ガブリエラ", "text": "…アーヤ、遅いわね。\n車取りに行くのに\n何分掛かってるのよ？"},
        { "location": "209/TALK"    , "narrator": "ガブリエラ", "text": "一刻を争う事態なの、\nわかってるのかしら？"},
        { "location": "210/TALK"    , "narrator": "みやび", "text": "出撃前で気分高まっ\nちょるなぁ。"},
        { "location": "211/TALK"    , "narrator": "ガブリエラ", "text": "みやびもちょっとは\nヤル気見せなさいよ。"},
        { "location": "213/TALK"    , "narrator": "ガブリエラ", "text": "てか、つばめ。"},
        { "location": "215/TALK"    , "narrator": "つばめ", "text": "は、はい！"},
        { "location": "217/TALK"    , "narrator": "ガブリエラ", "text": "一番ヤル気出さなきゃ\nいけないのは\nあんたでしょ？"},
        { "location": "218/TALK"    , "narrator": "ガブリエラ", "text": "中途半端な気持ちだと\n簡単に死ぬわよ？"},
        { "location": "221/TALK"    , "narrator": "つばめ", "text": "ご、ごめんなさい…。"},
        { "location": "223/TALK"    , "narrator": "みやび", "text": "まあ、死ぬほど痛い\n思いはするかも\nしれんけんど――"},
        { "location": "224/TALK"    , "narrator": "みやび", "text": "コネクトしとけば、\nそう簡単に死ぬことは\nないちや。"},
        { "location": "226/TALK"    , "narrator": "つばめ", "text": "そ、そうですか…。\n少し安心しました。"},
        { "location": "229/TALK"    , "narrator": "ガブリエラ", "text": "はぁ…そういうのが\n半端な気持ち、って\n言ってるのに…。"},
        { "location": "231/TALK"    , "narrator": "みやび", "text": "まあ、緊張するんは\n仕方ないことやき――"},
        { "location": "232/TALK"    , "narrator": "みやび", "text": "ここは先輩として、\nちくっと緊張を\nやわらげちゃる。"},
        { "location": "234/TALK"    , "narrator": "ガブリエラ", "text": "どうする気よ？"},
        { "location": "236/TALK"    , "narrator": "みやび", "text": "まあ、こんな時は\n雑談が一番やろ。"},
        { "location": "238/TALK"    , "narrator": "みやび", "text": "つばめちゃん、\nこっちでの生活には\n慣れたかね？"},
        { "location": "240/TALK"    , "narrator": "つばめ", "text": "あの、まだ６日目\nなんですけど…。"},
        { "location": "241/TALK"    , "narrator": "みやび", "text": "６日暮らした感想は？"},
        { "location": "242/TALK"    , "narrator": "つばめ", "text": "う、うーん…。\nちょっと不安が強い、\nかなぁ…？"},
        { "location": "243/TALK"    , "narrator": "つばめ", "text": "でも、新しい学校は\nちょっと楽しみです。"},
        { "location": "244/TALK"    , "narrator": "みやび", "text": "学校が楽しみとか、\nつばめちゃんは\n真面目さんやね。"},
        { "location": "245/TALK"    , "narrator": "つばめ", "text": "そ、そうですか？"},
        { "location": "246/TALK"    , "narrator": "みやび", "text": "うん…これなら、\n学校でえい友達も\n沢山できそうやね。"},
        { "location": "247/TALK"    , "narrator": "ガブリエラ", "text": "どうかしらねぇ？\nどんくさそうだから\n無理なんじゃない？"},
        { "location": "248/TALK"    , "narrator": "みやび", "text": "それだと、うちらも\nどんくさいゆうことに\nなるがよ？"},
        { "location": "252/TALK"    , "narrator": "ガブリエラ", "text": "余計なこと言わなくて\nいいから！"},
        { "location": "253/TALK"    , "narrator": "みやび", "text": "まあ、とりあえず\nつばめちゃんの\n当面の目標は――"},
        { "location": "254/TALK"    , "narrator": "みやび", "text": "友達１００人作りで\n決まりゆうことで。"},
        { "location": "257/TALK"    , "narrator": "つばめ", "text": "ええっ！？\nさすがにそれは\nムリなんじゃ…。"},
        { "location": "258/TALK"    , "narrator": "みやび", "text": "とりあえずＷＡＶＥの\n連絡先交換すれば、\nどうにかなるがよ。"},
        { "location": "260/TALK"    , "narrator": "つばめ", "text": "１００人かぁ…。"},
        { "location": "261/TALK"    , "narrator": "つばめ", "text": "いてくれたら嬉しい\nけど、ちょっと想像\nできない数字かも。"},
        { "location": "262/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "274/TALK"    , "narrator": "つばめ", "text": "変なこと聞くけど、答えてくれると嬉しいな"},
        { "location": "275/TALK"    , "narrator": "つばめ", "text": "わたし、友達１００人作れると思う？"},
        { "location": "277/SEL"     , "narrator": "", "text": "きっとできるさ"},
        { "location": "278/SEL"     , "narrator": "", "text": "どうだろう？"},
        { "location": "279/SEL"     , "narrator": "", "text": "１人の恋人を作ろう"},
        { "location": "280/ACT"     , "narrator": "", "text": "きっとできるさ"},
        { "location": "292/TALK"    , "narrator": "つばめ", "text": "…………。"},
        { "location": "293/TALK"    , "narrator": "つばめ", "text": "…なんて返せばいいのか\nわからなくて、無言で\n切っちゃった。"},
        { "location": "294/TALK"    , "narrator": "つばめ", "text": "でも、友達１００人も\nいたら、きっと毎日\n楽しいよね。"},
        { "location": "296/TALK"    , "narrator": "つばめ", "text": "よーし！"},
        { "location": "298/TALK"    , "narrator": "つばめ", "text": "わたし、東京にいる間に\n友達１００人作るのを\n目標に、頑張ります！"},
        { "location": "299/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "300/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "301/TALK"    , "narrator": "つばめ", "text": "あ、あれ？\nどうして黙っちゃうん\nですか？"},
        { "location": "302/TALK"    , "narrator": "みやび", "text": "いや…つばめちゃんは\nまっことえい子やと\n思うただけちや。"},
        { "location": "304/TALK"    , "narrator": "ガブリエラ", "text": "いい子っていうか、\n冗談の通じない\nド天然なだけじゃ…。"},
        { "location": "306/TALK"    , "narrator": "みやび", "text": "うちらにはない\n純真さやぞね。"},
        { "location": "307/ACT"     , "narrator": "", "text": "どうだろう？"},
        { "location": "308/TALK"    , "narrator": "つばめ", "text": "やっぱり、現実味ないよね？"},
        { "location": "320/TALK"    , "narrator": "つばめ", "text": "さすがに１００人は\nハードルが高いから――"},
        { "location": "321/TALK"    , "narrator": "つばめ", "text": "２０人くらいを目標に\n頑張ってみます！"},
        { "location": "323/TALK"    , "narrator": "みやび", "text": "２０人っちゅのも、\nそこそこ多い数やと\n思うんやけんど…。"},
        { "location": "324/ACT"     , "narrator": "", "text": "一人の恋人を作ろう"},
        { "location": "327/TALK"    , "narrator": "つばめ", "text": "１００人の友達より、１人の恋人がいいの？"},
        { "location": "328/TALK"    , "narrator": "つばめ", "text": "う～ん…そうなのかな？"},
        { "location": "340/TALK"    , "narrator": "つばめ", "text": "…あの、\n１００人の友達と\n１人の恋人なら――"},
        { "location": "341/TALK"    , "narrator": "つばめ", "text": "どっちがいいもの\nなんですか？"},
        { "location": "344/TALK"    , "narrator": "みやび", "text": "…つばめちゃん、\nその質問にはうちらは\n答えられんよ。"},
        { "location": "346/TALK"    , "narrator": "みやび", "text": "恋人のおるメンバーは\n一人もおらんきな。"},
        { "location": "348/TALK"    , "narrator": "つばめ", "text": "そうですか…。"},
        { "location": "349/TALK"    , "narrator": "つばめ", "text": "みんなにも恋人って\nいないんだ…。"},
        { "location": "350/TALK"    , "narrator": "つばめ", "text": "恋人って、友達よりも\n作るの難しいんだなぁ。"},
        { "location": "368/TALK"    , "narrator": "ガブリエラ", "text": "…あ、車来たわ。\n二人とも準備はいい？"},
        { "location": "369/TALK"    , "narrator": "つばめ", "text": "は、はい！"},
        { "location": "371/TALK"    , "narrator": "みやび", "text": "ふむ…１００人の\n友達を作る方が\n先か――"},
        { "location": "372/TALK"    , "narrator": "みやび", "text": "１００人のクランを\n退治する方が先か…。"},
        { "location": "373/TALK"    , "narrator": "ガブリエラ", "text": "…不吉なこと\n言わないでよ。"},
        { "location": "375/TALK"    , "narrator": "つばめ", "text": "うーん、できれば\nお友達の方を先に\n作りたいです…。"},
        { "location": "376/TALK"    , "narrator": "ガブリエラ", "text": "ああ、はいはい！\n話はここまで。"},
        { "location": "377/TALK"    , "narrator": "ガブリエラ", "text": "仕事モードに\n切り替えなさい。\nほら、行くわよ。"},
        { "location": "207/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>5月9日　9:32 AM</color>\n高校でのフェノメノン発生時の\n出動前。"},
        { "location": "361/DIALOG"  , "narrator": "Dialog_GEThimegoto_ch01", "text": "【まだ恋も知らず】"}
    ]
}
