{
    "dir": "chap31/daydra/dd_ch05_31_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "31502",
        "cid": "kagura",
        "title": "002 メインストーリー",
        "sub_title": "完璧な交渉術＜前編＞"
    },
    "entry":
    [
        { "location": "26/TALK"   , "narrator": "神楽", "text": "…これで、\n本当にいいの？"},
        { "location": "27/TALK"   , "narrator": "神楽", "text": "私がしてることって、\n正しいことなの？"},
        { "location": "28/TALK"   , "narrator": "神楽", "text": "もしかしたら、\n私は自分から\n破局に向かって…。"},
        { "location": "29/TALK"   , "narrator": "神楽", "text": "進んでるだけ\nなんじゃ…？"},
        { "location": "30/SEL"    , "narrator": "", "text": "$me$も気持ちわかるよ"},
        { "location": "31/SEL"    , "narrator": "", "text": "大変だね"},
        { "location": "32/ACT"    , "narrator": "", "text": "$me$も気持ちわかるよ"},
        { "location": "35/TALK"   , "narrator": "神楽", "text": "$handle$さん…。"},
        { "location": "36/TALK"   , "narrator": "神楽", "text": "やっぱり、\n疲れちゃいますよね？"},
        { "location": "37/SEL"    , "narrator": "", "text": "選択に次ぐ選択だからね"},
        { "location": "38/SEL"    , "narrator": "", "text": "神楽に比べればなんてことないよ"},
        { "location": "39/ACT"    , "narrator": "", "text": "選択に次ぐ選択だからね"},
        { "location": "41/TALK"   , "narrator": "神楽", "text": "ですよね。"},
        { "location": "42/TALK"   , "narrator": "神楽", "text": "その気持ち、\nよくわかりますよ。"},
        { "location": "43/TALK"   , "narrator": "神楽", "text": "私も、気持ちに力が\n入りませんし…。"},
        { "location": "44/ACT"    , "narrator": "", "text": "神楽に比べればなんてことないよ"},
        { "location": "45/TALK"   , "narrator": "神楽", "text": "強い人ですね。"},
        { "location": "47/TALK"   , "narrator": "神楽", "text": "そういうところ、\n見習えたら\nいいんですけど…。"},
        { "location": "48/TALK"   , "narrator": "神楽", "text": "さすがに、\nもう気持ちに力が\n入りません…。"},
        { "location": "50/ACT"    , "narrator": "", "text": "大変だね"},
        { "location": "51/TALK"   , "narrator": "神楽", "text": "そうですよ。\nほんと、大変です！"},
        { "location": "52/TALK"   , "narrator": "神楽", "text": "っていうか、\nそんな他人事みたいに\n言われると…。"},
        { "location": "54/TALK"   , "narrator": "神楽", "text": "ムッときて\n余計疲れるじゃ\nないですか。"},
        { "location": "55/TALK"   , "narrator": "神楽", "text": "あ～あ、こんな私を\n誰か白馬の王子様か\nジャンヌよろしく…。"},
        { "location": "56/TALK"   , "narrator": "神楽", "text": "純血のお姫様が\n助けに来て\nくれないかしら…？"},
        { "location": "57/SEL"    , "narrator": "", "text": "純血のお姫様といったら、つばめかな？"},
        { "location": "58/SEL"    , "narrator": "", "text": "$me$が行けなくてごめん…"},
        { "location": "59/ACT"    , "narrator": "", "text": "純血のお姫様といったら、つばめかな？"},
        { "location": "60/TALK"   , "narrator": "神楽", "text": "そうですね。\n純血のお姫様といえば\nつばめさんですね！"},
        { "location": "61/TALK"   , "narrator": "神楽", "text": "でも、ムリですよ…。"},
        { "location": "62/TALK"   , "narrator": "神楽", "text": "もう、完全にロック\nされちゃってますし。"},
        { "location": "63/ACT"    , "narrator": "", "text": "$me$が行けなくてごめん…"},
        { "location": "66/TALK"   , "narrator": "神楽", "text": "大丈夫ですよ。"},
        { "location": "67/TALK"   , "narrator": "神楽", "text": "それくらいのこと、\nわかってますから。"},
        { "location": "68/TALK"   , "narrator": "神楽", "text": "ただ…。"},
        { "location": "69/TALK"   , "narrator": "神楽", "text": "ちょっと、愚痴りたい\n気分なだけです。"},
        { "location": "71/TALK"   , "narrator": "神楽", "text": "ごめんなさい…。"},
        { "location": "72/TALK"   , "narrator": "神楽", "text": "いつも、こんなふうに\n不快な気持ちに\nさせてしまって…。"},
        { "location": "73/SEL"    , "narrator": "", "text": "元気になってくれるなら、沢山言ってほしい"},
        { "location": "74/SEL"    , "narrator": "", "text": "いや、むしろご褒美だ"},
        { "location": "75/SEL"    , "narrator": "", "text": "ちゃんと謝ってくれるから平気だよ"},
        { "location": "76/ACT"    , "narrator": "", "text": "元気になってくれるなら、沢山言ってほしい"},
        { "location": "77/TALK"   , "narrator": "神楽", "text": "そんなふうに\n甘やかされたら…。"},
        { "location": "78/TALK"   , "narrator": "神楽", "text": "これからも、\n沢山愚痴っちゃい\nますよ？"},
        { "location": "79/SEL"    , "narrator": "", "text": "神楽のためなら、全部聞くよ"},
        { "location": "80/SEL"    , "narrator": "", "text": "沢山は困るかも…"},
        { "location": "81/ACT"    , "narrator": "", "text": "神楽のためなら、全部聞くよ"},
        { "location": "82/TALK"   , "narrator": "神楽", "text": "本当に、優しい人…。"},
        { "location": "83/TALK"   , "narrator": "神楽", "text": "$handle$さん、\n好きになっちゃい\nそうです…。"},
        { "location": "84/ACT"    , "narrator": "", "text": "沢山は困るかも…"},
        { "location": "85/TALK"   , "narrator": "神楽", "text": "もう！\nここはかっこよく…。"},
        { "location": "86/TALK"   , "narrator": "神楽", "text": "全部聞いてあげるよ、\nくらい言って\nほしかったなぁ…。"},
        { "location": "88/ACT"    , "narrator": "", "text": "いや、むしろご褒美だ"},
        { "location": "89/TALK"   , "narrator": "神楽", "text": "…今って、そういう\n冗談を言う状況じゃ\nないんですけど？"},
        { "location": "91/TALK"   , "narrator": "神楽", "text": "まあ、不快になって\nいないのなら、\nいいんですけどね。"},
        { "location": "92/ACT"    , "narrator": "", "text": "ちゃんと謝ってくれるから平気だよ"},
        { "location": "93/TALK"   , "narrator": "神楽", "text": "本当にごめんなさい。"},
        { "location": "94/TALK"   , "narrator": "神楽", "text": "でも、本当に感謝も\nしてるんです。"},
        { "location": "96/TALK"   , "narrator": "神楽", "text": "溜まっている気持ちを\n聞いてくれる人が\nいるから…。"},
        { "location": "97/TALK"   , "narrator": "神楽", "text": "私は、壊れることなく\nこられたんだと\n思ってますから。"},
        { "location": "106/TALK"  , "narrator": "千羽鶴", "text": "…こんばんは。"},
        { "location": "108/TALK"  , "narrator": "神楽", "text": "…わざわざ夜に\n会いに来なくても\nいいのに。"},
        { "location": "109/TALK"  , "narrator": "千羽鶴", "text": "冗談。\nまだお昼を過ぎた\nところよ。"},
        { "location": "110/TALK"  , "narrator": "千羽鶴", "text": "窓のないこの場所に、\nピッタリの挨拶だと\n思っただけ。"},
        { "location": "111/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "113/SEL"   , "narrator": "", "text": "神楽、いよいよ正念場だ！"},
        { "location": "114/ACT"   , "narrator": "", "text": "神楽、いよいよ正念場だ！"},
        { "location": "117/TALK"  , "narrator": "神楽", "text": "え？"},
        { "location": "118/SEL"   , "narrator": "", "text": "トライコネクトして！"},
        { "location": "119/ACT"   , "narrator": "", "text": "トライコネクトして！"},
        { "location": "122/TALK"  , "narrator": "神楽", "text": "ど、どういうこと？\nそんなの、\nムリですよ…。"},
        { "location": "123/TALK"  , "narrator": "神楽", "text": "こんなところで\nできるわけないし。"},
        { "location": "125/TALK"  , "narrator": "千羽鶴", "text": "時間もないから、\n話を進めるわ。"},
        { "location": "126/TALK"  , "narrator": "千羽鶴", "text": "卯月神楽。\nこれから貴方には\n発症してもらう。"},
        { "location": "127/TALK"  , "narrator": "千羽鶴", "text": "これは、契約違反による\n共同作戦義務とは関係無い"},
        { "location": "128/TALK"  , "narrator": "千羽鶴", "text": "情報管理庁長官として、\n危険人物であると判断した\n結果によるものだから。"},
        { "location": "130/SEL"   , "narrator": "", "text": "SIMが変わってるでしょ、そのSIMならできる"},
        { "location": "131/ACT"   , "narrator": "", "text": "SIMが変わってるでしょ、そのSIMならできる"},
        { "location": "133/TALK"  , "narrator": "神楽", "text": "いや、意味が\nわかりませんから…。"},
        { "location": "135/TALK"  , "narrator": "千羽鶴", "text": "発症後、貴方には、\nスピネルを中心として――"},
        { "location": "136/TALK"  , "narrator": "千羽鶴", "text": "フュージョンクランを\n作り出してもらう\nことになる。"},
        { "location": "137/TALK"  , "narrator": "千羽鶴", "text": "そのフュージョン\nクランを作り出す\n過程で…。"},
        { "location": "138/TALK"  , "narrator": "千羽鶴", "text": "きっと、貴方の\n心は乱れると思う。"},
        { "location": "139/TALK"  , "narrator": "千羽鶴", "text": "だから、前準備として、\n今から少しだけ心のタガを\n外させてもらう。"},
        { "location": "141/SEL"   , "narrator": "", "text": "忘れてるかもしれないけど、今神楽がいる場所もまたフェノメノンだよね"},
        { "location": "142/ACT"   , "narrator": "", "text": "忘れてるかもしれないけど、今神楽がいる場所もまたフェノメノンだよね"},
        { "location": "144/TALK"  , "narrator": "神楽", "text": "忘れてませんよ。"},
        { "location": "145/TALK"  , "narrator": "神楽", "text": "ここがフェノメノンの\n中だというのは、\nわかってますよ。"},
        { "location": "146/TALK"  , "narrator": "千羽鶴", "text": "…聞いてる？\n私の話したこと、\nちゃんとわかってる？"},
        { "location": "149/TALK"  , "narrator": "神楽", "text": "…あ、はい？\nなんですか？"},
        { "location": "151/TALK"  , "narrator": "千羽鶴", "text": "…………。"},
        { "location": "152/TALK"  , "narrator": "千羽鶴", "text": "まあ、どちらにせよ、\n貴方に拒否権は\nないのは事実。"},
        { "location": "153/TALK"  , "narrator": "千羽鶴", "text": "拒否をする場合は、\n死ぬことになる。"},
        { "location": "154/SEL"   , "narrator": "", "text": "単に使えないという例外設定がついてただけ"},
        { "location": "155/ACT"   , "narrator": "", "text": "単に使えないという例外設定がついてただけ"},
        { "location": "158/TALK"  , "narrator": "神楽", "text": "ん～、なんとなく\nわかるような気がして\nきたような…。"},
        { "location": "159/TALK"  , "narrator": "千羽鶴", "text": "…それとも、\n拒否してみる？"},
        { "location": "160/TALK"  , "narrator": "神楽", "text": "あ、はい…。\nそうします…。"},
        { "location": "161/TALK"  , "narrator": "千羽鶴", "text": "…え？\n本気？"},
        { "location": "164/TALK"  , "narrator": "神楽", "text": "……？\nはい？\nなにがですか？"},
        { "location": "166/TALK"  , "narrator": "千羽鶴", "text": "…………。"},
        { "location": "168/TALK"  , "narrator": "千羽鶴", "text": "もう一度だけ\n話してあげる。"},
        { "location": "169/TALK"  , "narrator": "千羽鶴", "text": "これから貴方には\n発症してもらい――"},
        { "location": "170/SEL"   , "narrator": "", "text": "そのSIMはその例外が解除されてる"},
        { "location": "171/ACT"   , "narrator": "", "text": "そのSIMはその例外が解除されてる"},
        { "location": "174/TALK"  , "narrator": "神楽", "text": "使えない例外設定が\n解除されてるって\nことは…。"},
        { "location": "175/TALK"  , "narrator": "神楽", "text": "トライガジェットが\n使えるってこと\nですよね！"},
        { "location": "176/SEL"   , "narrator": "", "text": "そういうこと、トライコネクトしたら、後は$me$に任せて"},
        { "location": "177/ACT"   , "narrator": "", "text": "そういうこと、トライコネクトしたら、後は$me$に任せて"},
        { "location": "180/TALK"  , "narrator": "神楽", "text": "わ、わかりました。"},
        { "location": "181/TALK"  , "narrator": "神楽", "text": "ここまで来たら、\nもう信じる以外\nありませんよね！"},
        { "location": "182/TALK"  , "narrator": "千羽鶴", "text": "――というわけで、\nもしも拒否したら…。"},
        { "location": "184/TALK"  , "narrator": "千羽鶴", "text": "もしそれを拒否すると\n言うのであれば…。"},
        { "location": "186/TALK"  , "narrator": "千羽鶴", "text": "貴方に待つのは、\n死だけということ。"},
        { "location": "188/TALK"  , "narrator": "千羽鶴", "text": "…理解した？"},
        { "location": "189/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "190/TALK"  , "narrator": "千羽鶴", "text": "…それは、\n承諾ととっても\nいいのかしら？"},
        { "location": "194/TALK"  , "narrator": "神楽", "text": "…トライコネクト。"},
        { "location": "197/TALK"  , "narrator": "千羽鶴", "text": "ッ！？"},
        { "location": "199/TALK"  , "narrator": "神楽", "text": "……。\nそれは――"},
        { "location": "231/SEL"   , "narrator": "", "text": "$me$は月神楽様に身も心も捧げた僕です、何でもお申し付けください！"},
        { "location": "232/SEL"   , "narrator": "", "text": "$me$は月神楽様の犬ですから何でも喜んでご奉仕致します！"},
        { "location": "233/SEL"   , "narrator": "", "text": "$me$は月神楽様の前に立つのも畏れ多いゴミですから足で扱ってください！"},
        { "location": "234/ACT"   , "narrator": "", "text": "$me$は月神楽様に身も心も捧げた僕です、何でもお申し付けください！"},
        { "location": "241/ACT"   , "narrator": "", "text": "$me$は月神楽様の犬ですから何でも喜んでご奉仕致します！"},
        { "location": "248/ACT"   , "narrator": "", "text": "$me$は月神楽様の前に立つのも畏れ多いゴミですから足で扱ってください！"},
        { "location": "269/TALK"  , "narrator": "月神楽", "text": "いらっしゃいませ～、\n$handle31$♪"},
        { "location": "270/SEL"   , "narrator": "", "text": "なんすかそれ！"},
        { "location": "271/SEL"   , "narrator": "", "text": "はいっ♪"},
        { "location": "272/ACT"   , "narrator": "", "text": "なんすかそれ！"},
        { "location": "273/TALK"  , "narrator": "月神楽", "text": "え？"},
        { "location": "274/TALK"  , "narrator": "月神楽", "text": "だって～。\nさっき自分で言ってたじゃ\nないですか～。"},
        { "location": "275/TALK"  , "narrator": "月神楽", "text": "ココロゲート全体に\n響き渡る程の\n大きな声でっ♪"},
        { "location": "276/TALK"  , "narrator": "月神楽", "text": "ほんと、\n恥ずかしい$handle31$。"},
        { "location": "278/TALK"  , "narrator": "月神楽", "text": "ふふっ♪"},
        { "location": "279/ACT"   , "narrator": "", "text": "はいっ♪"},
        { "location": "281/TALK"  , "narrator": "月神楽", "text": "大変よい\nお返事ですねっ♪"},
        { "location": "282/TALK"  , "narrator": "月神楽", "text": "それでこそ、\n$handle31$！"},
        { "location": "284/TALK"  , "narrator": "月神楽", "text": "ココロゲート全体に\n響き渡る程大声で宣言する\nだけのことはありますね。"},
        { "location": "285/TALK"  , "narrator": "月神楽", "text": "なんて恥ずかしい\n$handle31$なんでしょう。"},
        { "location": "286/TALK"  , "narrator": "月神楽", "text": "躾のし甲斐が\nありそうです…ふふっ。"},
        { "location": "289/TALK"  , "narrator": "月神楽", "text": "それはそうと、\n今日はどうしましたか？"},
        { "location": "290/TALK"  , "narrator": "月神楽", "text": "特にココロの葛藤は\n起きていないようですが。"},
        { "location": "292/TALK"  , "narrator": "月神楽", "text": "もしかして、\n自分から率先して\n調教されに――"},
        { "location": "295/SEL"   , "narrator": "", "text": "いえ、神楽がトライコネクトした瞬間に飛ばされてきただけです"},
        { "location": "296/SEL"   , "narrator": "", "text": "もちろんです！！"},
        { "location": "297/ACT"   , "narrator": "", "text": "いえ、神楽がトライコネクトした瞬間に飛ばされてきただけです"},
        { "location": "299/TALK"  , "narrator": "月神楽", "text": "トライコネクトですか？"},
        { "location": "302/TALK"  , "narrator": "月神楽", "text": "……。"},
        { "location": "303/TALK"  , "narrator": "月神楽", "text": "ほんと――"},
        { "location": "304/TALK"  , "narrator": "月神楽", "text": "ていうか、\n発症してるし！！"},
        { "location": "305/SEL"   , "narrator": "", "text": "そうなの！？"},
        { "location": "306/ACT"   , "narrator": "", "text": "そうなの！？"},
        { "location": "308/TALK"  , "narrator": "月神楽", "text": "大変、\nすぐにアースタシアの所へ\n報告しに行かなくちゃ！"},
        { "location": "313/ACT"   , "narrator": "", "text": "もちろんです！！"},
        { "location": "343/TALK"  , "narrator": "月神楽", "text": "威勢がいいですね。\nさすがは$handle31$。"},
        { "location": "344/TALK"  , "narrator": "月神楽", "text": "それじゃ、\n今日はどんな躾を\nしましょうか♪"},
        { "location": "347/TALK"  , "narrator": "月神楽", "text": "……。"},
        { "location": "350/TALK"  , "narrator": "月神楽", "text": "…は？\nなにこれ。"},
        { "location": "351/SEL"   , "narrator": "", "text": "どうしたの！？"},
        { "location": "352/ACT"   , "narrator": "", "text": "どうしたの！？"},
        { "location": "354/TALK"  , "narrator": "月神楽", "text": "マジで！？\n発症してるし！！"},
        { "location": "355/SEL"   , "narrator": "", "text": "そうなの！？"},
        { "location": "356/ACT"   , "narrator": "", "text": "そうなの！？"},
        { "location": "358/TALK"  , "narrator": "月神楽", "text": "っていうか、\n$handle31$は\nどうやってここへ？"},
        { "location": "359/SEL"   , "narrator": "", "text": "トライコネクトしたら飛ばされてきたんだけど"},
        { "location": "360/ACT"   , "narrator": "", "text": "トライコネクトしたら飛ばされてきたんだけど"},
        { "location": "362/TALK"  , "narrator": "月神楽", "text": "どうしてそれを\n早く言わないかなぁ！"},
        { "location": "363/TALK"  , "narrator": "月神楽", "text": "とにかく、\nすぐにアースタシアの所へ\n報告しに行かなくちゃ！"},
        { "location": "391/TALK"  , "narrator": "アースタシア", "text": "どうしたのですか、\n月神楽。"},
        { "location": "392/TALK"  , "narrator": "月神楽　", "text": "トライガジェットによる\n1x接続が確立し、\n発症要求が来ています。"},
        { "location": "393/TALK"  , "narrator": "アースタシア", "text": "発症――"},
        { "location": "394/TALK"  , "narrator": "アースタシア", "text": "そうですか。"},
        { "location": "395/TALK"  , "narrator": "アースタシア", "text": "それは、\n1xからの指令による\n発症なのですね？"},
        { "location": "396/TALK"  , "narrator": "月神楽　", "text": "はい、そうです。"},
        { "location": "397/TALK"  , "narrator": "アースタシア", "text": "であれば、有志による\n発症を認めます。"},
        { "location": "398/TALK"  , "narrator": "月神楽　", "text": "有志……。"},
        { "location": "399/SEL"   , "narrator": "", "text": "有志による発症って？"},
        { "location": "400/ACT"   , "narrator": "", "text": "有志による発症って？"},
        { "location": "403/TALK"  , "narrator": "アースタシア", "text": "すなわち、発症したい\n人格が立候補し、その\n人格の色で発症すること。"},
        { "location": "404/TALK"  , "narrator": "アースタシア", "text": "感情高揚によるオーバー\nキャパシティ発症とは違い\nセルフは関与しません。"},
        { "location": "405/TALK"  , "narrator": "アースタシア", "text": "1xからの発症ラインを\n任意の人格に割り当てて、\nその者が担当するのです。"},
        { "location": "407/TALK"  , "narrator": "月神楽　", "text": "アースタシア！"},
        { "location": "408/TALK"  , "narrator": "アースタシア", "text": "なんでしょうか。"},
        { "location": "409/TALK"  , "narrator": "月神楽　", "text": "もしよければ今回の発症、\n私に担当させて\nいただけないでしょうか。"},
        { "location": "410/TALK"  , "narrator": "アースタシア", "text": "それは構いませんが、\n他にも立候補する\n人格がいれば――"},
        { "location": "412/TALK"  , "narrator": "ぴょんこ", "text": "ちょーっとまったああぁ！"},
        { "location": "414/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこも\n立候補しまーすっ！"},
        { "location": "415/SEL"   , "narrator": "", "text": "ぴょんこ！？"},
        { "location": "416/ACT"   , "narrator": "", "text": "ぴょんこ！？"},
        { "location": "419/TALK"  , "narrator": "月神楽　", "text": "はぁっ！？\nおまっ――"},
        { "location": "420/TALK"  , "narrator": "月神楽　", "text": "いえ、ぴょんこ。\n貴方は量子サーバーの\n奥地に行ったのでは！？"},
        { "location": "422/TALK"  , "narrator": "ぴょんこ", "text": "1xによる\n任意発症が要求されたと\n聞きまして！！"},
        { "location": "423/TALK"  , "narrator": "月神楽　", "text": "この地獄耳が…っ。"},
        { "location": "424/TALK"  , "narrator": "ぴょんこ", "text": "ふっふ～ん♪"},
        { "location": "426/TALK"  , "narrator": "ぴょんこ", "text": "というわけで、\nアースタシア様！"},
        { "location": "428/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこも\nばっち候補に\n入れて下さいっ！"},
        { "location": "430/TALK"  , "narrator": "アースタシア", "text": "それは構いませんよ。\nただ――"},
        { "location": "432/TALK"  , "narrator": "アースタシア", "text": "最終的に誰が発症するかは\nあなた方で\n決めてください。"},
        { "location": "433/TALK"  , "narrator": "月神楽　", "text": "え？"},
        { "location": "434/TALK"  , "narrator": "ぴょんこ", "text": "そうなんですか？"},
        { "location": "435/TALK"  , "narrator": "アースタシア", "text": "さっきもお話しましたが、\n私は任意発症には\n関与しませんから。"},
        { "location": "436/TALK"  , "narrator": "アースタシア", "text": "立候補者みんなで\n話し合って\n決めて下さいね。"},
        { "location": "438/TALK"  , "narrator": "月神楽　", "text": "あ、はい…。"},
        { "location": "439/TALK"  , "narrator": "アースタシア", "text": "あ、それから。\nケンカはダメですよ？"},
        { "location": "440/TALK"  , "narrator": "アースタシア", "text": "とは言っても、\n貴方たちは絶対\nケンカしますよね……。"},
        { "location": "442/TALK"  , "narrator": "ぴょんこ", "text": "まあ、月ちゃんは\nバイオレンス属性を\n持ってますし～。"},
        { "location": "444/TALK"  , "narrator": "月神楽　", "text": "お前が無神経だからです。\n火のない所に\n煙は立ちません。"},
        { "location": "445/TALK"  , "narrator": "アースタシア", "text": "あっ、そうです！\nせっかくですから――"},
        { "location": "446/TALK"  , "narrator": "アースタシア", "text": "$handle$さんに\n決めてもらったら\n如何でしょうか。"},
        { "location": "448/TALK"  , "narrator": "月神楽　", "text": "え？"},
        { "location": "450/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん！"},
        { "location": "451/SEL"   , "narrator": "", "text": "はい？"},
        { "location": "452/ACT"   , "narrator": "", "text": "はい？"},
        { "location": "454/TALK"  , "narrator": "アースタシア", "text": "それでは、後は\nよろしくお願いしますね！"},
        { "location": "460/TALK"  , "narrator": "月神楽　", "text": "……。"},
        { "location": "461/TALK"  , "narrator": "ぴょんこ", "text": "………。"},
        { "location": "462/SEL"   , "narrator": "", "text": "逃げられた…"},
        { "location": "463/ACT"   , "narrator": "", "text": "逃げられた…"},
        { "location": "466/TALK"  , "narrator": "ぴょんこ", "text": "月ちゃん、\n昇華したこと\nありませんよね？"},
        { "location": "468/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこ、\n無駄に昇華\nしまくってるんで！"},
        { "location": "469/TALK"  , "narrator": "月神楽　", "text": "ホント、やっばいくらい\n無駄に昇華してるよなー、\nコイツ……。"},
        { "location": "470/TALK"  , "narrator": "ぴょんこ", "text": "今こそ、その無駄を\n有効活用すべきですっ！"},
        { "location": "471/TALK"  , "narrator": "月神楽　", "text": "マテマテ。\n無駄なものは最後まで\n無駄なままなのですよ。"},
        { "location": "472/TALK"  , "narrator": "月神楽　", "text": "私がどうしてそう簡単に\n昇華しないか\n知ってますか？"},
        { "location": "473/TALK"  , "narrator": "月神楽　", "text": "私が昇華するときは、\nこの世界が終焉を迎える\n刻だからなんですよ？"},
        { "location": "474/TALK"  , "narrator": "ぴょんこ", "text": "そんな事言っちゃって～、\n昇華したこと無いから\n怖いだけなんでしょ？"},
        { "location": "475/TALK"  , "narrator": "月神楽　", "text": "へー、そういうこと\n言うんですか。\n死にたいようですね。"},
        { "location": "476/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん？"},
        { "location": "477/TALK"  , "narrator": "月神楽　", "text": "……。"},
        { "location": "478/TALK"  , "narrator": "月神楽　", "text": "解ってないようですし、\nわからせる為に、いっぺん\n昇華してやりましょうか？"},
        { "location": "479/TALK"  , "narrator": "ぴょんこ", "text": "ホントですかっ！\n楽しみぴょん！"},
        { "location": "480/TALK"  , "narrator": "月神楽　", "text": "………。"},
        { "location": "482/TALK"  , "narrator": "月神楽　", "text": "でも！"},
        { "location": "483/TALK"  , "narrator": "月神楽　", "text": "$handle31$の前では\nダメです。\nあっちに行きましょう！"},
        { "location": "485/SEL"   , "narrator": "", "text": "ちょっとまって！"},
        { "location": "486/ACT"   , "narrator": "", "text": "ちょっとまって！"},
        { "location": "490/TALK"  , "narrator": "月神楽　", "text": "何ですか？"},
        { "location": "491/SEL"   , "narrator": "", "text": "昇華できるところを$me$にも見せてくれなければ、指名は出来ないなあ"},
        { "location": "492/SEL"   , "narrator": "", "text": "月神楽の美しくも可愛い昇華姿を、$me$もどうしても見たくて！"},
        { "location": "493/ACT"   , "narrator": "", "text": "昇華できるところを$me$にも見せてくれなければ、指名は出来ないなあ"},
        { "location": "496/TALK"  , "narrator": "月神楽　", "text": "くっ……\n脅迫ですか！？"},
        { "location": "497/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこなら、また\nチュッチュしてくれたら\nいくらでも昇華します！"},
        { "location": "498/ACT"   , "narrator": "", "text": "月神楽の美しくも可愛い昇華姿を、$me$もどうしても見たくて！"},
        { "location": "500/TALK"  , "narrator": "月神楽　", "text": "は――"},
        { "location": "501/TALK"  , "narrator": "月神楽　", "text": "はあっ！？\nな、何をいきなり\nいいだすのかとっ！！"},
        { "location": "504/TALK"  , "narrator": "月神楽　", "text": "も、もう、\n仕方ありませんね、"},
        { "location": "505/TALK"  , "narrator": "月神楽　", "text": "ホント、これだから\n$handle31$はっ……。"},
        { "location": "506/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこにも、また\nチュッチュして昇華させて\nくださいっ！"},
        { "location": "511/TALK"  , "narrator": "月神楽　", "text": "お前は黙ってろ！"},
        { "location": "512/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん……。"},
        { "location": "514/TALK"  , "narrator": "月神楽　", "text": "わ、わかりました。"},
        { "location": "515/TALK"  , "narrator": "月神楽　", "text": "そこまで言うなら、\n力を解放して見せようじゃ\nありませんか。"},
        { "location": "517/TALK"  , "narrator": "月神楽　", "text": "けれども、私の真の姿を\n見ることとは、どういう\n事なのかについて――"},
        { "location": "518/TALK"  , "narrator": "月神楽　", "text": "$handle31$には全く\n自覚が無いようですから、\nしっかり伝えておきます。"},
        { "location": "519/TALK"  , "narrator": "月神楽　", "text": "見た瞬間から\n一生地獄の業火に焼かれる\nような苦しみを味わい――"},
        { "location": "521/TALK"  , "narrator": "ぴょんこ", "text": "月ちゃん長い！\nはい昇華昇華！！"},
        { "location": "522/TALK"  , "narrator": "ぴょんこ", "text": "ぴょ～～～～～ん！！"},
        { "location": "528/TALK"  , "narrator": "月神楽　", "text": "<size=40>うっせええええええ！！</size>"},
        { "location": "535/TALK"  , "narrator": "月神楽　", "text": "うわ、やばっ！\nまだ心の準備が\n全然出来てないのにっ！"},
        { "location": "536/TALK"  , "narrator": "ぴょんこ", "text": "月ちゃん\nがんばれ～～～っ♪"},
        { "location": "541/TALK"  , "narrator": "月神楽　", "text": "<size=40>だあああかああらああ！</size>"},
        { "location": "560/TALK"  , "narrator": "昇華月神楽", "text": "ああああ……\nは……はずっ……"},
        { "location": "561/TALK"  , "narrator": "ぴょんこ", "text": "月ちゃん\nかわいいいいいっ！！"},
        { "location": "562/SEL"   , "narrator": "", "text": "ほんとに可愛いよ！"},
        { "location": "563/SEL"   , "narrator": "", "text": "か、かわいいですね（棒）"},
        { "location": "564/ACT"   , "narrator": "", "text": "ほんとに可愛いよ！"},
        { "location": "566/TALK"  , "narrator": "昇華月神楽", "text": "そ、そんな、\nノリだけで言ってると\nホントに呪いますよっ！！"},
        { "location": "567/TALK"  , "narrator": "昇華月神楽", "text": "で、でも、\nちょっと安心した――"},
        { "location": "568/TALK"  , "narrator": "昇華月神楽", "text": "って私何言って！"},
        { "location": "570/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこも！\n$handle$さんに\n可愛いって！"},
        { "location": "571/TALK"  , "narrator": "ぴょんこ", "text": "言ってもらうべく！\n昇華しちゃいますっ！"},
        { "location": "572/ACT"   , "narrator": "", "text": "か、かわいいですね（棒）"},
        { "location": "573/TALK"  , "narrator": "昇華月神楽", "text": "あーあーあーあーっ！\nウソウソウソ！\nそれ絶対嘘でしょっ！"},
        { "location": "574/TALK"  , "narrator": "昇華月神楽", "text": "どうせ本心では、\n光の速さで呪いそうとか\nリスカしそうとか！"},
        { "location": "575/TALK"  , "narrator": "昇華月神楽", "text": "絶対そんな事\n思ってますよね！"},
        { "location": "576/TALK"  , "narrator": "昇華月神楽", "text": "はあぁぁぁっ……\nだから嫌だったのに…。"},
        { "location": "577/TALK"  , "narrator": "ぴょんこ", "text": "大丈夫です、月ちゃん！"},
        { "location": "578/TALK"  , "narrator": "昇華月神楽", "text": "…何が。"},
        { "location": "579/TALK"  , "narrator": "ぴょんこ", "text": "私もこれから、\n月ちゃんと一緒に\n昇華しちゃいますから！"},
        { "location": "580/TALK"  , "narrator": "昇華月神楽", "text": "はぁ！？\nそれなんの問題解決にも\nなってねえ――"},
        { "location": "584/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さん\nラブラブパワー\nハレーション～～～♪♪"},
        { "location": "585/TALK"  , "narrator": "昇華月神楽", "text": "うわなにそれ、はずっ！\nめちゃ恥ずかしっ！"},
        { "location": "604/TALK"  , "narrator": "昇華ぴょんこ", "text": "ぴょ～～～～～ん♪"},
        { "location": "605/TALK"  , "narrator": "昇華月神楽", "text": "はぁ～～……。"},
        { "location": "606/TALK"  , "narrator": "昇華ぴょんこ", "text": "というわけで、\n$handle$さんっ！"},
        { "location": "607/TALK"  , "narrator": "昇華ぴょんこ", "text": "次の発症には是非\nぴょんこに投票を！"},
        { "location": "608/TALK"  , "narrator": "昇華月神楽", "text": "ちゃっかり唐突に\n発症活動するな！"},
        { "location": "609/TALK"  , "narrator": "昇華月神楽", "text": "月の方が先なんですから、\n月に決まってますよね？"},
        { "location": "610/SEL"   , "narrator": "", "text": "月神楽に発症を依頼する"},
        { "location": "611/SEL"   , "narrator": "", "text": "ぴょんこに発症を依頼する"},
        { "location": "612/SEL"   , "narrator": "", "text": "どんな世界にしたいのか語ってください"},
        { "location": "613/ACT"   , "narrator": "", "text": "月神楽に発症を依頼する"},
        { "location": "616/ACT"   , "narrator": "", "text": "ぴょんこに発症を依頼する"},
        { "location": "619/ACT"   , "narrator": "", "text": "どんな世界にしたいのか語ってください"},
        { "location": "621/TALK"  , "narrator": "昇華ぴょんこ", "text": "はいはーい！"},
        { "location": "622/TALK"  , "narrator": "昇華ぴょんこ", "text": "ぴょんこはっ！\n可愛い魔法少女がっ！"},
        { "location": "623/TALK"  , "narrator": "昇華ぴょんこ", "text": "$handle$さんの\nラブラブパワーでっ！"},
        { "location": "624/TALK"  , "narrator": "昇華ぴょんこ", "text": "世界の諸悪に立ち向かい\n駆逐する世界を\n創造しますっ！！"},
        { "location": "625/TALK"  , "narrator": "昇華月神楽", "text": "私は…そうですね。"},
        { "location": "626/TALK"  , "narrator": "昇華月神楽", "text": "麗しくも艶やかな、\nあの女子校生活を\nご披露しましょうか。"},
        { "location": "627/SEL"   , "narrator": "", "text": "月神楽に発症を依頼する"},
        { "location": "628/SEL"   , "narrator": "", "text": "ぴょんこに発症を依頼する"},
        { "location": "629/ACT"   , "narrator": "", "text": "月神楽に発症を依頼する"},
        { "location": "632/TALK"  , "narrator": "昇華月神楽", "text": "当然ですよね。\n貴方は私の$handle31$\nなんですから。"},
        { "location": "633/TALK"  , "narrator": "昇華ぴょんこ", "text": "ぴょん……。"},
        { "location": "634/TALK"  , "narrator": "昇華月神楽", "text": "それでは\n発症しちゃいますよ？\nふふっ……"},
        { "location": "635/TALK"  , "narrator": "昇華月神楽", "text": "この呪われた世界に、\n素敵なココロの旅を♪"},
        { "location": "636/ACT"   , "narrator": "", "text": "ぴょんこに発症を依頼する"},
        { "location": "639/TALK"  , "narrator": "昇華ぴょんこ", "text": "ぴょ～～～～～ん！"},
        { "location": "640/TALK"  , "narrator": "昇華月神楽", "text": "くっ……\nそうですか。"},
        { "location": "641/TALK"  , "narrator": "昇華月神楽", "text": "わかりました、\nもういいです。"},
        { "location": "642/TALK"  , "narrator": "昇華月神楽", "text": "ぴょんこと\nお好きなだけ\n発症なさい。"},
        { "location": "643/TALK"  , "narrator": "昇華ぴょんこ", "text": "それでは\nお言葉に甘えましてっ！"},
        { "location": "644/TALK"  , "narrator": "昇華ぴょんこ", "text": "ぴょんこ、\nいっきま～～～す♪"},
        { "location": "653/SEL"   , "narrator": "", "text": "いえ、そうではなく、理由はわからないんだけど…"},
        { "location": "654/SEL"   , "narrator": "", "text": "もちろんです！！"},
        { "location": "655/ACT"   , "narrator": "", "text": "いえ、そうではなく、理由はわからないんだけど…"},
        { "location": "656/TALK"  , "narrator": "月神楽", "text": "言い訳なんて\nしなくていいんですよ？"},
        { "location": "657/ACT"   , "narrator": "", "text": "もちろんです！！"},
        { "location": "659/TALK"  , "narrator": "月神楽", "text": "そうですか。\nではお望み通りに。"},
        { "location": "691/TALK"  , "narrator": "月神楽", "text": "私のかわいい\n$handle31$。"},
        { "location": "692/TALK"  , "narrator": "月神楽", "text": "月のためなら、\n何でもして\nくれるんですよね？"},
        { "location": "693/TALK"  , "narrator": "月神楽", "text": "では、丁度いいので――"},
        { "location": "694/TALK"  , "narrator": "月神楽", "text": "ココロスフィアの\n美化にご協力お願い\nできますか？"},
        { "location": "695/SEL"   , "narrator": "", "text": "な、なにをするんですか？"},
        { "location": "696/ACT"   , "narrator": "", "text": "な、なにをするんですか？"},
        { "location": "698/TALK"  , "narrator": "月神楽", "text": "暴れクランを\nすこしばかり\n駆除してもらえれば。"},
        { "location": "699/TALK"  , "narrator": "月神楽", "text": "ガベージコレクションも\n司書の仕事の１つでは\nあるのですけど――"},
        { "location": "700/TALK"  , "narrator": "月神楽", "text": "わりと面倒なんですよね。"},
        { "location": "701/TALK"  , "narrator": "月神楽", "text": "だから、\nおねがいします♪"},
