{
    "dir": "chap34/daydra/dd_ch05_34_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "34502",
        "cid": "kagura",
        "title": "002 メインストーリー",
        "sub_title": "Lifegathering."
    },
    "entry":
    [
        { "location": "24/SEL"    , "narrator": "", "text": "神楽！？"},
        { "location": "25/SEL"    , "narrator": "", "text": "ぴょんこ！？"},
        { "location": "26/SEL"    , "narrator": "", "text": "月神楽！？"},
        { "location": "27/ACT"    , "narrator": "", "text": "神楽！？"},
        { "location": "28/TALK"   , "narrator": "神楽", "text": "？"},
        { "location": "29/TALK"   , "narrator": "神楽", "text": "はい。\n私は神楽ですけど。"},
        { "location": "30/TALK"   , "narrator": "神楽", "text": "どちら様ですか？"},
        { "location": "31/ACT"    , "narrator": "", "text": "ぴょんこ！？"},
        { "location": "32/TALK"   , "narrator": "神楽", "text": "えっ！"},
        { "location": "33/TALK"   , "narrator": "神楽", "text": "ぴょんこって、\nママが昔言ってた……"},
        { "location": "34/TALK"   , "narrator": "神楽", "text": "どちら様ですか？"},
        { "location": "35/ACT"    , "narrator": "", "text": "月神楽！？"},
        { "location": "36/TALK"   , "narrator": "神楽", "text": "？"},
        { "location": "37/TALK"   , "narrator": "神楽", "text": "私は\n卯月神楽ですが…"},
        { "location": "38/TALK"   , "narrator": "神楽", "text": "どちら様ですか？"},
        { "location": "40/SEL"    , "narrator": "", "text": "$me$だよ、$handle$だよ！"},
        { "location": "41/SEL"    , "narrator": "", "text": "貴方の婚約者、$handle$です(ｷﾘｯ"},
        { "location": "42/SEL"    , "narrator": "", "text": "名乗る程の者ではありませんが$handle$です"},
        { "location": "43/ACT"    , "narrator": "", "text": "$me$だよ、$handle$だよ！"},
        { "location": "45/TALK"   , "narrator": "神楽", "text": "$handle$…\nさんですか？"},
        { "location": "46/TALK"   , "narrator": "神楽", "text": "以前どこかで\nお逢いしました\nでしょうか？"},
        { "location": "47/ACT"    , "narrator": "", "text": "貴方の婚約者、$handle$です(ｷﾘｯ"},
        { "location": "49/TALK"   , "narrator": "神楽", "text": "ふふっ。\n冗談がお好きなんですね♪"},
        { "location": "50/TALK"   , "narrator": "神楽", "text": "とてもユーモアに\n満ちあふれた方。"},
        { "location": "51/ACT"    , "narrator": "", "text": "名乗る程の者ではありませんが$handle$です"},
        { "location": "53/TALK"   , "narrator": "神楽", "text": "そうですか…。\nそれは残念です。"},
        { "location": "54/TALK"   , "narrator": "神楽", "text": "ですが、\nお名前は教えて\nくださるのですね。"},
        { "location": "55/TALK"   , "narrator": "神楽", "text": "なんて\n慈悲深いお方。"},
        { "location": "57/TALK"   , "narrator": "神楽", "text": "っと、\nこんな事してる場合では\nありませんでした！"},
        { "location": "58/SEL"    , "narrator": "", "text": "どうしたの？"},
        { "location": "59/ACT"    , "narrator": "", "text": "どうしたの？"},
        { "location": "61/TALK"   , "narrator": "神楽", "text": "これから、\nお父様と一緒に\n星を見に行くんです。"},
        { "location": "62/TALK"   , "narrator": "神楽", "text": "お父様は、\n時間にお厳しい\n方ですから――"},
        { "location": "63/TALK"   , "narrator": "神楽", "text": "あ、そうです♪"},
        { "location": "64/TALK"   , "narrator": "神楽", "text": "せっかくですから、\n$handle$さんも、\nご一緒しませんか？"},
        { "location": "65/TALK"   , "narrator": "神楽", "text": "とっても素敵な\n星空なんです。"},
        { "location": "66/SEL"    , "narrator": "", "text": "是非ご一緒させてください"},
        { "location": "67/SEL"    , "narrator": "", "text": "遠慮します"},
        { "location": "68/ACT"    , "narrator": "", "text": "是非ご一緒させてください"},
        { "location": "69/TALK"   , "narrator": "神楽", "text": "はい♪\nそれでは参りましょう。"},
        { "location": "70/TALK"   , "narrator": "神楽", "text": "少しばかり\n遠いところですけど、\nご辛抱くださいね♪"},
        { "location": "84/TALK"   , "narrator": "神楽", "text": "到着しました♪"},
        { "location": "85/TALK"   , "narrator": "神楽", "text": "素敵なところでしょう？"},
        { "location": "86/SEL"    , "narrator": "", "text": "神楽とこんな所に来れるなんて嬉しい"},
        { "location": "87/SEL"    , "narrator": "", "text": "お父さんとは、よくここに来ていたの？"},
        { "location": "88/ACT"    , "narrator": "", "text": "神楽とこんな所に来れるなんて嬉しい"},
        { "location": "89/TALK"   , "narrator": "神楽", "text": "まあ、お上手ですね。"},
        { "location": "90/TALK"   , "narrator": "神楽", "text": "まるで、もう何年も\n連れ添っている仲のような\nことを言って。"},
        { "location": "91/ACT"    , "narrator": "", "text": "お父さんとは、よくここに来ていたの？"},
        { "location": "92/TALK"   , "narrator": "神楽", "text": "いいえ。"},
        { "location": "93/TALK"   , "narrator": "神楽", "text": "生前の父は仕事一筋で、\n週に一度会えるかどうか\nくらいの人でしたから。"},
        { "location": "95/TALK"   , "narrator": "神楽", "text": "この場所は――"},
        { "location": "96/TALK"   , "narrator": "神楽", "text": "この場所は。"},
        { "location": "97/TALK"   , "narrator": "文雄", "text": "神楽。"},
        { "location": "99/TALK"   , "narrator": "神楽", "text": "あっ、"},
        { "location": "107/TALK"  , "narrator": "神楽", "text": "お父様、\nいらしてたんですね。"},
        { "location": "108/TALK"  , "narrator": "文雄", "text": "ついさっき\n来たばかりだ。"},
        { "location": "109/TALK"  , "narrator": "神楽", "text": "ふふっ、\nそんな事言って。"},
        { "location": "110/TALK"  , "narrator": "神楽", "text": "ついさっきとは、\n１時間前のことでは\nありませんか？"},
        { "location": "111/TALK"  , "narrator": "文雄", "text": "父親を\nからかうものじゃない。"},
        { "location": "112/TALK"  , "narrator": "神楽", "text": "あら、ごめんなさい。"},
        { "location": "115/TALK"  , "narrator": "神楽", "text": "それにしても、\n今日も素敵な\n星空ですね♪"},
        { "location": "116/TALK"  , "narrator": "文雄", "text": "水瓶座の時代に\n入ったからね。"},
        { "location": "117/TALK"  , "narrator": "文雄", "text": "星はより一層の\n輝きを増し――"},
        { "location": "118/TALK"  , "narrator": "文雄", "text": "世界はより一層の\n激動と変革を享受する。"},
        { "location": "121/TALK"  , "narrator": "神楽", "text": "……。"},
        { "location": "122/TALK"  , "narrator": "文雄", "text": "ところで、神楽。\nそこの人は。"},
        { "location": "124/TALK"  , "narrator": "神楽", "text": "ああっ、そうでした。\nお父様、紹介しますね。"},
        { "location": "125/TALK"  , "narrator": "神楽", "text": "あの方は\n$handle$さん。"},
        { "location": "127/TALK"  , "narrator": "神楽", "text": "私の友人です。"},
        { "location": "128/SEL"   , "narrator": "", "text": "初めまして"},
        { "location": "129/ACT"   , "narrator": "", "text": "初めまして"},
        { "location": "131/TALK"  , "narrator": "文雄", "text": "ふむ。"},
        { "location": "133/TALK"  , "narrator": "神楽", "text": "私の\nフィアンセだそうですよ？"},
        { "location": "134/SEL"   , "narrator": "", "text": "お父様、$me$はお嬢様を幸せにすると誓います、よろしくお願いします"},
        { "location": "135/SEL"   , "narrator": "", "text": "いや、すみません、ちょっとした冗談だったんで…"},
        { "location": "136/ACT"   , "narrator": "", "text": "お父様、$me$はお嬢様を幸せにすると誓います、よろしくお願いします"},
        { "location": "138/TALK"  , "narrator": "文雄", "text": "……ふむ。"},
        { "location": "140/ACT"   , "narrator": "", "text": "いや、すみません、ちょっとした冗談だったんで…"},
        { "location": "141/TALK"  , "narrator": "文雄", "text": "…くだらない人間だ。"},
        { "location": "145/TALK"  , "narrator": "神楽", "text": "名乗るような方ではない\nとのことですけど…。"},
        { "location": "146/SEL"   , "narrator": "", "text": "初めまして"},
        { "location": "147/ACT"   , "narrator": "", "text": "初めまして"},
        { "location": "149/TALK"  , "narrator": "文雄", "text": "ふむ。"},
        { "location": "152/TALK"  , "narrator": "文雄", "text": "$handle$君。\n初対面でこう言うのも\n申し訳ないのだが――"},
        { "location": "153/TALK"  , "narrator": "文雄", "text": "今は少々、状況が\n立て込んでいる。"},
        { "location": "154/TALK"  , "narrator": "文雄", "text": "すまないが、少し\n神楽と二人で話をさせて\nもらえないだろうか。"},
        { "location": "155/SEL"   , "narrator": "", "text": "どうぞどうぞ"},
        { "location": "156/SEL"   , "narrator": "", "text": "見ててもいいですか？"},
        { "location": "157/ACT"   , "narrator": "", "text": "どうぞどうぞ"},
        { "location": "158/TALK"  , "narrator": "文雄", "text": "ありがとう。"},
        { "location": "159/ACT"   , "narrator": "", "text": "見ててもいいですか？"},
        { "location": "160/TALK"  , "narrator": "文雄", "text": "ああ、構わない。"},
        { "location": "162/TALK"  , "narrator": "文雄", "text": "神楽。"},
        { "location": "164/TALK"  , "narrator": "神楽", "text": "はい。"},
        { "location": "165/TALK"  , "narrator": "文雄", "text": "ここからだと\nオリオンが良く見えるね。"},
        { "location": "166/TALK"  , "narrator": "神楽", "text": "本当ですね。\nとっても綺麗です！"},
        { "location": "167/TALK"  , "narrator": "文雄", "text": "オリオンは\nまだ生きているが、\nあと何年の命か。"},
        { "location": "168/TALK"  , "narrator": "文雄", "text": "神楽。\n昔、僕がα星の話を\nしたことを覚えてるかい？"},
        { "location": "169/TALK"  , "narrator": "神楽", "text": "もちろんです！\nベテルギウスの\nお話ですね？"},
        { "location": "170/TALK"  , "narrator": "文雄", "text": "うむ。"},
        { "location": "171/TALK"  , "narrator": "文雄", "text": "ベテルギウスは既に\nこの世界には存在しない\n恒星かもしれない。"},
        { "location": "172/TALK"  , "narrator": "文雄", "text": "すなわちオリオンは\n既にその形を失い、\n死んでいるかもしれん。"},
        { "location": "173/TALK"  , "narrator": "神楽", "text": "はい。"},
        { "location": "174/TALK"  , "narrator": "神楽", "text": "今見えているそれは、\n６００年以上も前の姿…。"},
        { "location": "175/TALK"  , "narrator": "神楽", "text": "ジャンヌダルクが\n生きていた時代ですもの。"},
        { "location": "176/TALK"  , "narrator": "文雄", "text": "その通り。"},
        { "location": "177/TALK"  , "narrator": "神楽", "text": "とても\nロマンチックなお話です。"},
        { "location": "178/TALK"  , "narrator": "文雄", "text": "いや。\n至極現実的な話だ。"},
        { "location": "179/TALK"  , "narrator": "文雄", "text": "いつだって、\n目に見えるものが\n本質とは限らない。"},
        { "location": "180/TALK"  , "narrator": "文雄", "text": "五感だけでは、\n到底わかり得ない事が、\n世の中には沢山ある。"},
        { "location": "181/TALK"  , "narrator": "文雄", "text": "例えばそれは、\n人の心、魂の存在。"},
        { "location": "182/TALK"  , "narrator": "文雄", "text": "人がこの世を\n去る刻のこと、そして――"},
        { "location": "183/TALK"  , "narrator": "文雄", "text": "我が子の想い。"},
        { "location": "184/TALK"  , "narrator": "神楽", "text": "……はい。"},
        { "location": "185/TALK"  , "narrator": "文雄", "text": "同じ遺伝子から生まれた\n君は、なのに僕とも\n美佐子とも違う。"},
        { "location": "186/TALK"  , "narrator": "文雄", "text": "僕が良かれと思うことも、\n神楽にとっては\nそうでない事がままある。"},
        { "location": "187/TALK"  , "narrator": "神楽", "text": "……お父様。"},
        { "location": "188/TALK"  , "narrator": "文雄", "text": "神楽。\n僕は君に何も残して\nあげられなかった。"},
        { "location": "189/TALK"  , "narrator": "文雄", "text": "あれだけの資産を\n蓄積しながらも、\n何一つ……だ。"},
        { "location": "190/TALK"  , "narrator": "文雄", "text": "だが、今日君がここに\n来てくれたお陰で、\nその憂いは終わる。"},
        { "location": "191/TALK"  , "narrator": "神楽", "text": "どういうことですか？\nお父様。"},
        { "location": "192/TALK"  , "narrator": "文雄", "text": "ここには僕が最後まで\n持ち続けていた、\n１つの資産がある。"},
        { "location": "193/TALK"  , "narrator": "文雄", "text": "全てを奪われ、\n失った後も、ただ１つ\n持っていたものだ。"},
        { "location": "194/TALK"  , "narrator": "文雄", "text": "そして、これはいつの日か\n君に託そうと思っていた\nものでもあるんだよ。"},
        { "location": "195/TALK"  , "narrator": "神楽", "text": "私に…託す？"},
        { "location": "196/TALK"  , "narrator": "文雄", "text": "そうだ。"},
        { "location": "197/TALK"  , "narrator": "文雄", "text": "この、たった１つの\n小さな資産は、数十文字の\n文字列でしかない。"},
        { "location": "198/TALK"  , "narrator": "文雄", "text": "だがこれは、世界の\nすべてを手に入れる事さえ\n可能な資産でもある。"},
        { "location": "199/TALK"  , "narrator": "文雄", "text": "その価値を上手く使うか、\nただの文字列で終わらせる\nかは、君次第だ。"},
        { "location": "200/TALK"  , "narrator": "神楽", "text": "……はい、お父様。\nありがとうございます。"},
        { "location": "201/TALK"  , "narrator": "文雄", "text": "うむ。"},
        { "location": "202/TALK"  , "narrator": "文雄", "text": "ところで――"},
        { "location": "203/TALK"  , "narrator": "文雄", "text": "君は、\n僕との想い出といえば、\n何が印象深い？"},
        { "location": "204/TALK"  , "narrator": "神楽", "text": "え？\nえっと、そうですね――"},
        { "location": "205/TALK"  , "narrator": "神楽", "text": "やっぱり、あの\n国際展示場での\n産業展の事でしょうか。"},
        { "location": "206/TALK"  , "narrator": "文雄", "text": "うむ、そうだろうね。"},
        { "location": "207/TALK"  , "narrator": "神楽", "text": "私の記憶の中にある、\n唯一の、お父様との\nおでかけの思い出です。"},
        { "location": "208/TALK"  , "narrator": "文雄", "text": "今からそれを、\nライフギャザーで\n追体験しよう。"},
        { "location": "209/TALK"  , "narrator": "神楽", "text": "ライフギャザーで？"},
        { "location": "210/TALK"  , "narrator": "文雄", "text": "そうだ。\nただし、これは\nただの追体験ではない。"},
        { "location": "211/TALK"  , "narrator": "文雄", "text": "君が、資産を受け取るに\n相応しい本物の娘なのかを\n確認するものだ。"},
        { "location": "212/TALK"  , "narrator": "神楽", "text": "え…？"},
        { "location": "213/TALK"  , "narrator": "文雄", "text": "あぁ、\n心配することはないよ。"},
        { "location": "214/TALK"  , "narrator": "文雄", "text": "君が本物であれば、\n何も考えなくとも\n確認は完了する。"},
        { "location": "215/TALK"  , "narrator": "文雄", "text": "君はただ、\n追体験をすればいいんだ。"},
        { "location": "216/TALK"  , "narrator": "神楽", "text": "…わかりました。"},
        { "location": "217/TALK"  , "narrator": "文雄", "text": "では、早速行こう。"},
        { "location": "240/TALK"  , "narrator": "神楽", "text": "はあー"},
        { "location": "241/TALK"  , "narrator": "神楽", "text": "おとうさまー\nひまですー"},
        { "location": "242/TALK"  , "narrator": "神楽", "text": "……。"},
        { "location": "243/TALK"  , "narrator": "神楽", "text": "えらそうな人と\n夢中でお話して\nいらっしゃるわ。"},
        { "location": "244/TALK"  , "narrator": "神楽", "text": "あーあ……。"},
        { "location": "245/TALK"  , "narrator": "神楽", "text": "ここが、マジカル\nスウィーティーエキスポ\nだったらよかったのに。"},
        { "location": "246/TALK"  , "narrator": "神楽", "text": "そうしたら！\nかぐらはっ！"},
        { "location": "247/TALK"  , "narrator": "神楽", "text": "おとうさまに\nストロベリーステッキを\nおねだりします！"},
        { "location": "248/TALK"  , "narrator": "神楽", "text": "うーん……"},
        { "location": "249/TALK"  , "narrator": "神楽", "text": "こうしょうざいりょうは、\nつぎの中学受験模試で\nＡ判定とりますから！"},
        { "location": "250/TALK"  , "narrator": "神楽", "text": "…で、いいですかね？"},
        { "location": "251/TALK"  , "narrator": "神楽", "text": "そんなのじゃ、\nだめかしら。"},
        { "location": "252/TALK"  , "narrator": "文雄", "text": "神楽！"},
        { "location": "253/TALK"  , "narrator": "神楽", "text": "あっ、\nはい、おとうさま！"},
        { "location": "258/TALK"  , "narrator": "文雄", "text": "今度一緒に仕事をする\nことになる――"},
        { "location": "259/TALK"  , "narrator": "文雄", "text": "エンタングルのCEO\n一之宮北斎さんだ。"},
        { "location": "260/TALK"  , "narrator": "神楽", "text": "お初にお目に掛かります。\n卯月神楽と申します。"},
        { "location": "261/TALK"  , "narrator": "神楽", "text": "エンタングルって、あの\nスマホのエンタングル！？"},
        { "location": "262/TALK"  , "narrator": "神楽", "text": "おとうさま、すごい人と\nお知り合いなのね。"},
        { "location": "263/TALK"  , "narrator": "北斎", "text": "はじめまして。\nいやはや、\nしっかりしたお嬢さんだ。"},
        { "location": "264/TALK"  , "narrator": "文雄", "text": "いやいや、とんでもない。\n未だにアニメを見て喜んで\nいる子供ですよ。"},
        { "location": "265/TALK"  , "narrator": "神楽", "text": "むっ…。"},
        { "location": "266/TALK"  , "narrator": "文雄", "text": "では一之宮CEO、\n来週にでも弊社幹部と共に\nご挨拶に――"},
        { "location": "267/TALK"  , "narrator": "神楽", "text": "あーもう、\nなんだかとっても\n腹立たしいですね！"},
        { "location": "270/TALK"  , "narrator": "文雄", "text": "神楽。\nそろそろ帰るよ。"},
        { "location": "271/TALK"  , "narrator": "神楽", "text": "……。"},
        { "location": "272/TALK"  , "narrator": "文雄", "text": "どうしたんだ、\nそんな怖い顔して。"},
        { "location": "273/TALK"  , "narrator": "文雄", "text": "早く来なければ、\n置いていくだけだ。"},
        { "location": "274/TALK"  , "narrator": "神楽", "text": "どうぞ、\n置いていって\nくださいまし。"},
        { "location": "275/TALK"  , "narrator": "文雄", "text": "なんだ、こんな所で\n演劇の練習か。"},
        { "location": "276/TALK"  , "narrator": "文雄", "text": "僕はこれからまだ\n予定があるんだ。"},
        { "location": "277/TALK"  , "narrator": "文雄", "text": "君の我が侭に\nつき合ってるヒマは無い。"},
        { "location": "278/TALK"  , "narrator": "神楽", "text": "……私は\nおとうさまのワガママに\nお付き合いしました。"},
        { "location": "279/TALK"  , "narrator": "文雄", "text": "我が侭！？"},
        { "location": "280/TALK"  , "narrator": "文雄", "text": "いいか、神楽。\nこれは将来のための\n勉強なんだ。"},
        { "location": "281/TALK"  , "narrator": "文雄", "text": "権威のある人や、財界、\n政界の方々との交流は\n価値のあるものなのだ。"},
        { "location": "282/TALK"  , "narrator": "文雄", "text": "我が侭ではない。\n君の将来のためを思って、\n忙しい中時間を割いてる。"},
        { "location": "283/TALK"  , "narrator": "神楽", "text": "…はい、おとうさま。"},
        { "location": "284/TALK"  , "narrator": "神楽", "text": "わかっています。"},
        { "location": "285/TALK"  , "narrator": "神楽", "text": "ですが……"},
        { "location": "286/TALK"  , "narrator": "神楽", "text": "ですが、かぐらは……"},
        { "location": "287/TALK"  , "narrator": "神楽", "text": "おとうさまと、\n少しでいいから、楽しい\nことをしたかったです。"},
        { "location": "288/TALK"  , "narrator": "神楽", "text": "おしょくじとか、\nおちゃとか、そんな事で\nよいのです…っ……。"},
        { "location": "289/TALK"  , "narrator": "文雄", "text": "……神楽。"},
        { "location": "290/TALK"  , "narrator": "神楽", "text": "せっかくおとうさまと\nおでかけだから、\nたのしみにしてたです。"},
        { "location": "291/TALK"  , "narrator": "神楽", "text": "……ぐすっ…ぐすっ。"},
        { "location": "292/TALK"  , "narrator": "文雄", "text": "こんな所で\n泣くのはやめなさい。"},
        { "location": "293/TALK"  , "narrator": "文雄", "text": "……。"},
        { "location": "294/TALK"  , "narrator": "文雄", "text": "仕方ない。\n少しここで\n待っているように。"},
        { "location": "300/TALK"  , "narrator": "神楽", "text": "…えっ…えぐっ……"},
        { "location": "301/SEL"   , "narrator": "", "text": "酷いお父さんだね"},
        { "location": "302/SEL"   , "narrator": "", "text": "お父さんのことが好きなんだね"},
        { "location": "303/ACT"   , "narrator": "", "text": "酷いお父さんだね"},
        { "location": "304/TALK"  , "narrator": "神楽", "text": "そんなことないです！"},
        { "location": "305/TALK"  , "narrator": "神楽", "text": "かぐらのおとうさまは、\n世界中からひつようと\nされてるすごい人です！"},
        { "location": "306/TALK"  , "narrator": "神楽", "text": "だから、おとうさまの\nことを悪く言ったら\nゆるしません！"},
        { "location": "307/SEL"   , "narrator": "", "text": "ごめんね"},
        { "location": "308/SEL"   , "narrator": "", "text": "神楽は優しいね"},
        { "location": "309/ACT"   , "narrator": "", "text": "ごめんね"},
        { "location": "310/TALK"  , "narrator": "神楽", "text": "わかってくれれば\nそれでいいんです。"},
        { "location": "311/ACT"   , "narrator": "", "text": "神楽は優しいね"},
        { "location": "312/TALK"  , "narrator": "神楽", "text": "…っ、うっ…\nぐすっ……"},
        { "location": "314/ACT"   , "narrator": "", "text": "お父さんのことが好きなんだね"},
        { "location": "315/TALK"  , "narrator": "神楽", "text": "よくわからないです。"},
        { "location": "316/TALK"  , "narrator": "神楽", "text": "かぐらは、おとうさまに\n好きも嫌いもありません。"},
        { "location": "317/TALK"  , "narrator": "神楽", "text": "ただ、とてもいだいな\n人だって知ってます。\nだからそんけいしてます！"},
        { "location": "319/TALK"  , "narrator": "文雄", "text": "神楽。"},
        { "location": "326/TALK"  , "narrator": "文雄", "text": "後ろの予定を１時間\n遅らせてもらった。"},
        { "location": "327/TALK"  , "narrator": "文雄", "text": "そこのカフェテリアで\n少し休憩するか。"},
        { "location": "328/TALK"  , "narrator": "神楽", "text": "はいっ、おとうさま！\nありがとうございますっ！"},
        { "location": "338/TALK"  , "narrator": "神楽", "text": "うーん、\nどれにしようかしら！"},
        { "location": "339/TALK"  , "narrator": "神楽", "text": "みんなおいしそうで\n迷っちゃいますっ！"},
        { "location": "340/TALK"  , "narrator": "文雄", "text": "神楽、\n早く決めなさい。"},
        { "location": "341/TALK"  , "narrator": "神楽", "text": "は、はいっ！"},
        { "location": "342/TALK"  , "narrator": "文雄", "text": "時間は待ってくれない。\n物事は瞬間的に判断\nできるようになりなさい。"},
        { "location": "343/TALK"  , "narrator": "神楽", "text": "はい、おとうさま。"},
        { "location": "344/TALK"  , "narrator": "神楽", "text": "でも、ごめんなさい。\nこれだけは、かぐら\nすぐに決められないです。"},
        { "location": "345/TALK"  , "narrator": "神楽", "text": "でも、あまりおとうさまを\nガッカリさせないように\nしなくちゃです！"},
        { "location": "347/TALK"  , "narrator": "神楽", "text": "えーっと、\nえーーっと……"},
        { "location": "348/TALK"  , "narrator": "神楽", "text": "……あっ！！"},
        { "location": "350/TALK"  , "narrator": "神楽", "text": "おとうさま！\n決まりましたっ！"},
        { "location": "351/TALK"  , "narrator": "文雄", "text": "何にしたんだ？"},
        { "location": "352/TALK"  , "narrator": "神楽", "text": "わたし――"},
        { "location": "377/SEL"   , "narrator": "", "text": "拘束されし者！？"},
        { "location": "378/ACT"   , "narrator": "", "text": "拘束されし者！？"},
        { "location": "380/TALK"  , "narrator": "拘束されし者", "text": "…出来ることなら、\nこのような形での追跡は\n避けたかったのだが。"},
        { "location": "381/TALK"  , "narrator": "拘束されし者", "text": "頼みがある。\nライフギャザーの量子\n暗号鍵を譲ってもらいたい"},
        { "location": "382/SEL"   , "narrator": "", "text": "それ以前にまだ$me$も暗号鍵教えてもらって無いんですけど"},
        { "location": "383/SEL"   , "narrator": "", "text": "ダメに決まってる"},
        { "location": "384/SEL"   , "narrator": "", "text": "やはり何か裏があると思ってた"},
        { "location": "385/ACT"   , "narrator": "", "text": "それ以前にまだ$me$も暗号鍵教えてもらって無いんですけど"},
        { "location": "386/TALK"  , "narrator": "拘束されし者", "text": "その点については\n心配する必要はない。"},
        { "location": "387/TALK"  , "narrator": "拘束されし者", "text": "ここまで到達できれば、\n量子暗号鍵は解ったも\n同然だからだ。"},
        { "location": "388/ACT"   , "narrator": "", "text": "ダメに決まってる"},
        { "location": "389/TALK"  , "narrator": "拘束されし者", "text": "何も説明しないうちから\nダメとは、お前は心の内を\n見通せるのか？"},
        { "location": "390/ACT"   , "narrator": "", "text": "やはり何か裏があると思ってた"},
        { "location": "391/TALK"  , "narrator": "拘束されし者", "text": "裏という意味では\n確かに否定はできない。"},
        { "location": "392/TALK"  , "narrator": "拘束されし者", "text": "だが、ハナからお前を\n嵌める作戦だったという\nわけではない。"},
        { "location": "393/TALK"  , "narrator": "拘束されし者", "text": "我々は共通意識野を彷徨い\nあらゆる手段を用いて\nライフギャザーを求めた。"},
        { "location": "394/TALK"  , "narrator": "拘束されし者", "text": "その結果、お前がそこに\n到達し、我々は交渉をする\nことにしただけだ。"},
        { "location": "395/TALK"  , "narrator": "拘束されし者", "text": "故に、だまし討ちなどを\nするつもりはない。\nそれだけは理解頂きたい。"},
        { "location": "398/SEL"   , "narrator": "", "text": "だいたい、何故お前がライフギャザーの中に介入できるんだ！？"},
        { "location": "399/ACT"   , "narrator": "", "text": "だいたい、何故お前がライフギャザーの中に介入できるんだ！？"},
        { "location": "401/TALK"  , "narrator": "月神楽", "text": "私がアクセスキーを\n変えたからです。"},
        { "location": "404/SEL"   , "narrator": "", "text": "月神楽……？"},
        { "location": "405/ACT"   , "narrator": "", "text": "月神楽……？"},
        { "location": "407/TALK"  , "narrator": "月神楽", "text": "ごめんなさい、\n$handle$さん。"},
        { "location": "408/TALK"  , "narrator": "月神楽", "text": "お願いがあるんです。"},
        { "location": "409/TALK"  , "narrator": "月神楽", "text": "どうか、今すぐに\nライフギャザーから\n退室してください。"},
        { "location": "410/SEL"   , "narrator": "", "text": "どうして！？"},
        { "location": "411/ACT"   , "narrator": "", "text": "どうして！？"},
        { "location": "413/TALK"  , "narrator": "月神楽", "text": "ライフギャザーの\n暗号鍵が何なのかが、\n解ったからです。"},
        { "location": "414/TALK"  , "narrator": "月神楽", "text": "父が設定した暗号鍵は、\nあの後私が注文したもの。"},
        { "location": "415/TALK"  , "narrator": "月神楽", "text": "当然、私はそれを\n知っています。"},
        { "location": "416/TALK"  , "narrator": "月神楽", "text": "ですから、もう――"},
        { "location": "417/TALK"  , "narrator": "月神楽", "text": "もう\n$handle$さんの\n役目は終わったんです。"},
        { "location": "418/TALK"  , "narrator": "月神楽", "text": "ここまで導いてくださって\nありがとうございました。"},
        { "location": "419/SEL"   , "narrator": "", "text": "どういう事情なのかちゃんと教えて！"},
        { "location": "420/ACT"   , "narrator": "", "text": "どういう事情なのかちゃんと教えて！"},
        { "location": "422/TALK"  , "narrator": "月神楽", "text": "事情…ですか。"},
        { "location": "423/TALK"  , "narrator": "月神楽", "text": "私は。"},
        { "location": "424/TALK"  , "narrator": "月神楽", "text": "私の父が引き起こした\n全世界規模の災厄に\n終止符を打つため――"},
        { "location": "426/TALK"  , "narrator": "月神楽", "text": "父の直系親族として、\nそのカルマを浄化したいと\n思っているだけです。"},
        { "location": "427/TALK"  , "narrator": "月神楽", "text": "父がライフギャザーなんて\n作らなければ、私はこんな\n辛い目に遭わなかった。"},
        { "location": "428/TALK"  , "narrator": "月神楽", "text": "一之宮に\n家をズタボロに\nされて！"},
        { "location": "429/TALK"  , "narrator": "月神楽", "text": "人身売買の如く\n養子縁組をさせられて！"},
        { "location": "430/TALK"  , "narrator": "月神楽", "text": "母は魂を抜かれて\n廃人同然！！"},
        { "location": "432/TALK"  , "narrator": "月神楽", "text": "ただ一人の親友までも\nクランを発症して、更に\n破壊されてしまった……"},
        { "location": "433/TALK"  , "narrator": "月神楽", "text": "もとはと言えば全部、\n父がライフギャザーを\n作ったからなんです。"},
        { "location": "434/TALK"  , "narrator": "月神楽", "text": "私、なんか\n変なこと言ってますか？"},
        { "location": "435/SEL"   , "narrator": "", "text": "言ってる"},
        { "location": "436/SEL"   , "narrator": "", "text": "言ってない"},
        { "location": "437/ACT"   , "narrator": "", "text": "言ってる"},
        { "location": "438/TALK"  , "narrator": "月神楽", "text": "そうですか。\nまあいいです。"},
        { "location": "440/TALK"  , "narrator": "月神楽", "text": "なら、これだけでも\n十分ですよね。"},
        { "location": "441/ACT"   , "narrator": "", "text": "言ってない"},
        { "location": "443/TALK"  , "narrator": "月神楽", "text": "ですよね。\n貴方が常識人で\n安心しました。"},
        { "location": "445/TALK"  , "narrator": "月神楽", "text": "父は、私や母を顧みずに\nただ自分の好きなことを\nやってただけ！"},
        { "location": "446/TALK"  , "narrator": "月神楽", "text": "最後の最後の最後まで。\n結局そのまま自殺して！"},
        { "location": "447/TALK"  , "narrator": "月神楽", "text": "負の資産は全部\n私に押しつけて！"},
        { "location": "449/TALK"  , "narrator": "月神楽", "text": "どんだけ私のことが\n嫌いなの！？"},
        { "location": "450/TALK"  , "narrator": "月神楽", "text": "どんだけ私を\n憎んでいたの！？"},
        { "location": "451/TALK"  , "narrator": "月神楽", "text": "貴方が私を憎んでいた\nそれ以上に、私も\n貴方を憎んでいた！！"},
        { "location": "452/TALK"  , "narrator": "月神楽", "text": "私は父が大嫌い！！"},
        { "location": "453/TALK"  , "narrator": "月神楽", "text": "自分の価値観ばかり\n押しつけて、私のしたい\nことは全部否定して！"},
        { "location": "454/TALK"  , "narrator": "月神楽", "text": "自分は好きな\n仕事ばっかりやって！！"},
        { "location": "455/TALK"  , "narrator": "月神楽", "text": "こんなモン作ってないで\n週末ぐらい家族と一緒に\n過ごしてみろよ……"},
        { "location": "456/TALK"  , "narrator": "月神楽", "text": "それだけで！\nそれだけで、\n全然よかったのに……っ！"},
        { "location": "457/SEL"   , "narrator": "", "text": "辛かったんだね"},
        { "location": "458/SEL"   , "narrator": "", "text": "で、どうしたいの？"},
        { "location": "459/ACT"   , "narrator": "", "text": "辛かったんだね"},
        { "location": "462/TALK"  , "narrator": "月神楽", "text": "そんなことは\n別にいいんです。"},
        { "location": "463/TALK"  , "narrator": "月神楽", "text": "私はただ、そのカルマを\n浄化できればそれで\n万事オッケーですから。"},
        { "location": "464/SEL"   , "narrator": "", "text": "なにをするの？"},
        { "location": "465/ACT"   , "narrator": "", "text": "なにをするの？"},
        { "location": "467/ACT"   , "narrator": "", "text": "で、どうしたいの？"},
        { "location": "471/TALK"  , "narrator": "月神楽", "text": "具体的には、\nライフギャザーの\n破壊です。"},
        { "location": "472/SEL"   , "narrator": "", "text": "そんなことやめて！"},
        { "location": "473/SEL"   , "narrator": "", "text": "$me$もそれがいいと思う"},
        { "location": "474/ACT"   , "narrator": "", "text": "そんなことやめて！"},
        { "location": "476/TALK"  , "narrator": "月神楽", "text": "あー、そうですよね。"},
        { "location": "477/TALK"  , "narrator": "月神楽", "text": "ライフギャザーが\n無くなったら、私達とは\nお別れになりますもんね。"},
        { "location": "478/SEL"   , "narrator": "", "text": "えっ、そうなの！？"},
        { "location": "479/SEL"   , "narrator": "", "text": "えっ、それだけ！？"},
        { "location": "480/ACT"   , "narrator": "", "text": "えっ、そうなの！？"},
        { "location": "481/TALK"  , "narrator": "月神楽", "text": "そりゃそうですよ、\nRedinessのコアですよ？"},
        { "location": "482/TALK"  , "narrator": "月神楽", "text": "世界を繋げている\nシステムのCPUが壊れて\n接続を維持出来るとでも？"},
        { "location": "483/SEL"   , "narrator": "", "text": "と、とにかく一度落ち着こうよ！"},
        { "location": "484/ACT"   , "narrator": "", "text": "と、とにかく一度落ち着こうよ！"},
        { "location": "486/ACT"   , "narrator": "", "text": "えっ、それだけ！？"},
        { "location": "488/TALK"  , "narrator": "月神楽", "text": "……。\n何が言いたいんですか？"},
        { "location": "489/SEL"   , "narrator": "", "text": "$me$と会えなくなっても寂しくないの！？"},
        { "location": "490/ACT"   , "narrator": "", "text": "$me$と会えなくなっても寂しくないの！？"},
        { "location": "493/TALK"  , "narrator": "月神楽", "text": "………。"},
        { "location": "495/TALK"  , "narrator": "月神楽", "text": "…全然。"},
        { "location": "496/TALK"  , "narrator": "月神楽", "text": "そういう貴方だって\nたいして寂しくも\nないんでしょう？"},
        { "location": "497/SEL"   , "narrator": "", "text": "メチャクチャ寂しいよ！！別れたくないよ！！"},
        { "location": "498/SEL"   , "narrator": "", "text": "特に寂しくない"},
        { "location": "501/ACT"   , "narrator": "", "text": "メチャクチャ寂しいよ！！別れたくないよ！！"},
        { "location": "502/ACT"   , "narrator": "", "text": "特に寂しくない"},
        { "location": "504/TALK"  , "narrator": "月神楽", "text": "な～んて！\n聞くまでも無いですよね！"},
        { "location": "505/TALK"  , "narrator": "月神楽", "text": "別に寂しくも何とも\n無いですもんね～♪"},
        { "location": "506/SEL"   , "narrator": "", "text": "だからメチャクチャ寂しいんだって！"},
        { "location": "507/SEL"   , "narrator": "", "text": "いやほんとに"},
        { "location": "510/ACT"   , "narrator": "", "text": "だからメチャクチャ寂しいんだって！"},
        { "location": "511/ACT"   , "narrator": "", "text": "いやほんとに"},
        { "location": "513/TALK"  , "narrator": "月神楽", "text": "そうやって\n無駄な選択肢を\n開かないでください！"},
        { "location": "514/SEL"   , "narrator": "", "text": "月神楽！別れたくないよ！！"},
        { "location": "515/SEL"   , "narrator": "", "text": "今までありがとう"},
        { "location": "518/ACT"   , "narrator": "", "text": "月神楽！別れたくないよ！！"},
        { "location": "519/ACT"   , "narrator": "", "text": "今までありがとう"},
        { "location": "523/TALK"  , "narrator": "月神楽", "text": "うるさいうるさい！"},
        { "location": "525/TALK"  , "narrator": "月神楽", "text": "私が幸せに暮らせるように\nなる方が、よっぽど\n大事なんですから！"},
        { "location": "526/TALK"  , "narrator": "月神楽", "text": "それに！"},
        { "location": "528/TALK"  , "narrator": "月神楽", "text": "この子達だって、\nライフギャザーの\n犠牲者なんですよ？"},
        { "location": "529/ACT"   , "narrator": "", "text": "$me$もそれがいいと思う"},
        { "location": "530/TALK"  , "narrator": "月神楽", "text": "賛同してくれて\nありがとうございます♪"},
        { "location": "532/TALK"  , "narrator": "月神楽", "text": "一番の犠牲者だった\nこの子達も、これでやっと\n救われます。"},
        { "location": "535/SEL"   , "narrator": "", "text": "この子達って…拘束されし者のこと…？"},
        { "location": "536/ACT"   , "narrator": "", "text": "この子達って…拘束されし者のこと…？"},
        { "location": "539/TALK"  , "narrator": "月神楽", "text": "そうです。"},
        { "location": "540/TALK"  , "narrator": "月神楽", "text": "ライフギャザーさえ\n無ければ、こんな\n惨い未来は無いんです。"},
        { "location": "541/TALK"  , "narrator": "月神楽", "text": "ですから、どうか\nライフギャザーの後始末は\n私達に任せてください。"},
        { "location": "542/SEL"   , "narrator": "", "text": "落ち着いて、壊す以外にも方法あるかもしれないし！"},
        { "location": "543/SEL"   , "narrator": "", "text": "どうせやるなら$me$も参加する！"},
        { "location": "544/ACT"   , "narrator": "", "text": "落ち着いて、壊す以外にも方法あるかもしれないし！"},
        { "location": "545/TALK"  , "narrator": "月神楽", "text": "逆の立場になったら、\nそんな事言えませんよ？"},
        { "location": "546/ACT"   , "narrator": "", "text": "どうせやるなら$me$も参加する！"},
        { "location": "547/TALK"  , "narrator": "月神楽", "text": "私がやるって\n言ってるじゃないですか！"},
        { "location": "550/TALK"  , "narrator": "月神楽", "text": "もーっ！\nいいから早く消えろよ！\n邪魔なんだよ！！"},
        { "location": "551/TALK"  , "narrator": "拘束されし者", "text": "$handle$の相手は\n私がしておこう。"},
        { "location": "552/TALK"  , "narrator": "拘束されし者", "text": "その間に早く、\n月神楽は\n量子暗号鍵を。"},
        { "location": "553/SEL"   , "narrator": "", "text": "待って！"},
        { "location": "554/ACT"   , "narrator": "", "text": "待って！"},
        { "location": "558/TALK"  , "narrator": "月神楽", "text": "ありがとうございます！"},
        { "location": "559/TALK"  , "narrator": "月神楽", "text": "月神楽、\n量子暗号鍵を\nゲットしてきますっ！"},
        { "location": "563/SEL"   , "narrator": "", "text": "月！！"},
        { "location": "564/ACT"   , "narrator": "", "text": "月！！"},
        { "location": "567/TALK"  , "narrator": "拘束されし者", "text": "申し訳ない、\n$handle$。"},
        { "location": "568/TALK"  , "narrator": "拘束されし者", "text": "我々はもう、\nこれ以上邪魔される\nわけにはいかない。"},
        { "location": "569/TALK"  , "narrator": "拘束されし者", "text": "そして、お前に\n迷惑を掛けるわけにも\nいかないのだ。"},
        { "location": "570/TALK"  , "narrator": "拘束されし者", "text": "なぜだかわかるか？"},
        { "location": "571/TALK"  , "narrator": "拘束されし者", "text": "我々は――"},
        { "location": "572/TALK"  , "narrator": "拘束されし者", "text": "我々は、こんな姿を\nしていても、もとは\n独立した５人だ。"},
        { "location": "573/TALK"  , "narrator": "拘束されし者", "text": "皆、お前にとても\n感謝してるんだよ。"},
        { "location": "574/TALK"  , "narrator": "拘束されし者", "text": "ずっと、我々を\n支えてきて\nくれたのだから……。"},
        { "location": "575/SEL"   , "narrator": "", "text": "つばめーーーっ！！"},
        { "location": "576/SEL"   , "narrator": "", "text": "アーヤあああっ！！"},
        { "location": "577/SEL"   , "narrator": "", "text": "ガブリエラぁぁぁっ！"},
        { "location": "578/SEL"   , "narrator": "", "text": "みやびぃぃぃっ！！"},
        { "location": "579/SEL"   , "narrator": "", "text": "神楽ーーーーっ！！"},
        { "location": "580/ACT"   , "narrator": "", "text": "つばめーーーっ！！"},
        { "location": "582/ACT"   , "narrator": "", "text": "アーヤあああっ！！"},
        { "location": "584/ACT"   , "narrator": "", "text": "ガブリエラぁぁぁっ！"},
        { "location": "586/ACT"   , "narrator": "", "text": "みやびぃぃぃっ！！"},
        { "location": "588/ACT"   , "narrator": "", "text": "神楽ーーーーっ！！"},
        { "location": "591/TALK"  , "narrator": "拘束されし者", "text": "月神楽が暗号鍵を\n取得すれば、後は\n破壊するだけになる。"},
        { "location": "592/TALK"  , "narrator": "拘束されし者", "text": "そうすれば、少なくとも\n今この可能性世界に\n共にいるお前とも――"},
        { "location": "593/TALK"  , "narrator": "拘束されし者", "text": "別れの時になる。"},
        { "location": "594/TALK"  , "narrator": "拘束されし者", "text": "けれども、\nそれが互いにとって、\n一番の幸せなのだ。"},
        { "location": "595/TALK"  , "narrator": "拘束されし者", "text": "ライフギャザーが生きてる\n以上、真の平穏など、\n訪れないのだから。"},
        { "location": "596/TALK"  , "narrator": "拘束されし者", "text": "今までずっと、\n支えてくれてありがとう。\n$handle$……"},
        { "location": "603/ACT"   , "narrator": "", "text": "遠慮します"},
        { "location": "604/TALK"  , "narrator": "神楽", "text": "そうですか。\nそれは残念です。"},
        { "location": "605/TALK"  , "narrator": "神楽", "text": "それでは、\nまた機会があれば\nご一緒しましょう♪"},
        { "location": "606/TALK"  , "narrator": "神楽", "text": "ごきげんよう――"},
        { "location": "22/DIALOG" , "narrator": "INFO", "text": "<color=green>【TRI-OS Information:0x03】</color>\nココロスフィアとの通信を\n復元しました。(101)"},
        { "location": "234/DIALOG", "narrator": "dialog_black", "text": "それは、まだ私が\n小学校高学年だった頃のこと。"},
        { "location": "235/DIALOG", "narrator": "dialog_black", "text": "今まで一度も、\n何処へも連れて行って\nくれなかった父が、\n\n突然私と一緒に\n出かけると言いだした。"},
        { "location": "236/DIALOG", "narrator": "dialog_black", "text": "その場所は、国際展示場。\n\nそしてその時に催されていたものは、\n量子情報産業とイノベーションEXPO。"},
        { "location": "237/DIALOG", "narrator": "dialog_black", "text": "父が何を思って、\n私をそこに連れてきたのか\nそれは今も解らない。\n\nただ１つ言えることは――"},
        { "location": "238/DIALOG", "narrator": "dialog_black", "text": "この時の私は、\n今でも鮮明に当時を思い出せるほど\n“退屈だった”ということだ。"},
        { "location": "335/DIALOG", "narrator": "dialog_black", "text": "国際展示場のカフェテリア。\n\n洒落たところでもなく、\n特別なところでもないこの場所が、\n私と父との、\nただ一つの思い出の場所だった。\n\nそして――"},
        { "location": "357/DIALOG", "narrator": "NOTICE", "text": "<color=red>【TRI-OS Notice:0x8F】</color>\n\n【Lifegazer認証】\n秘密鍵が変更されました。\n\nゲート暗号鍵\n3fa340bb_91\nによってゲートは\n入出力共に封鎖されました。\n(499)\n"},
        { "location": "359/DIALOG", "narrator": "Dialog_Alert", "text": "<color=red>【TRI-OS Notice:0x10】</color>\n\n【Lifegazer認証】\n<color=red>ゲート暗号鍵が一致しません。</color>\n\nサインアウトします。\n(991)\n"},
        { "location": "611/DIALOG", "narrator": "NOTICE", "text": "<color=red>【TRI-OS Error:0x99】</color>\nココロスフィアとの回線が\n切断されました。(981)"}
    ]
}
