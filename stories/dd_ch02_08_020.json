{
    "dir": "chap08/daydra/dd_ch02_08_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "8256",
        "cid": "ayami",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "柔軟体操"
    },
    "entry":
    [
        { "location": "174/SCENARIO", "narrator": "", "text": "柔軟体操"},
        { "location": "185/TALK"    , "narrator": "みやび", "text": "ふぅ…。"},
        { "location": "188/TALK"    , "narrator": "アーヤ", "text": "どうかしたの？\n溜め息なんか\n吐いちゃって。"},
        { "location": "190/TALK"    , "narrator": "みやび", "text": "大したことやない。"},
        { "location": "191/TALK"    , "narrator": "みやび", "text": "ちっくと運動不足過ぎ\nやき、身体が固まって\n痛いだけぞね。"},
        { "location": "193/TALK"    , "narrator": "アーヤ", "text": "…だけ、で済ませる辺り、\nさすがみやびね。"},
        { "location": "194/TALK"    , "narrator": "アーヤ", "text": "でも、柔軟運動くらいは\nした方が良いわよ？"},
        { "location": "195/TALK"    , "narrator": "アーヤ", "text": "身体が柔らかくなれば\nケガもしにくくなるし、\n健康にも良いんだから。"},
        { "location": "196/TALK"    , "narrator": "みやび", "text": "ふむ…まあ、それくらい\nやったらえいかもしれん。"},
        { "location": "197/TALK"    , "narrator": "みやび", "text": "柔軟やったら、\n座ったままでもできる\n運動やし。"},
        { "location": "198/TALK"    , "narrator": "アーヤ", "text": "そうね。足を伸ばして\n座った状態で、足の指に\n手で触れたり――"},
        { "location": "199/TALK"    , "narrator": "アーヤ", "text": "その状態から足を開いて、\n身体を前に倒したりすると\n良いと思うわ。"},
        { "location": "200/TALK"    , "narrator": "みやび", "text": "アーヤ、うちにそんなん\nできると思うがか？"},
        { "location": "201/TALK"    , "narrator": "みやび", "text": "足開いて座るだけでも、\n腿が突っ張った感じに\nなるぞね。"},
        { "location": "203/TALK"    , "narrator": "アーヤ", "text": "そんなに！？"},
        { "location": "205/TALK"    , "narrator": "アーヤ", "text": "う～ん…それだと無理に\n柔軟運動させるのは、\n逆に危ないかしら？"},
        { "location": "207/TALK"    , "narrator": "アーヤ", "text": "あなたでも出来そうな\n運動を調べるわ。"},
        { "location": "208/TALK"    , "narrator": "みやび", "text": "激しいのは勘弁やぞ。"},
        { "location": "209/TALK"    , "narrator": "アーヤ", "text": "わかってるわよ。"},
        { "location": "224/TALK"    , "narrator": "アーヤ", "text": "ちょっと困ってるの(-ω-;)"},
        { "location": "225/TALK"    , "narrator": "アーヤ", "text": "一緒に考えてもらえる？"},
        { "location": "227/SEL"     , "narrator": "", "text": "みやびのこと？"},
        { "location": "228/ACT"     , "narrator": "", "text": "みやびのこと？"},
        { "location": "230/TALK"    , "narrator": "アーヤ", "text": "そう"},
        { "location": "231/TALK"    , "narrator": "アーヤ", "text": "見てたの？(*ﾉωﾉ)"},
        { "location": "232/TALK"    , "narrator": "アーヤ", "text": "まあいいけど"},
        { "location": "233/TALK"    , "narrator": "アーヤ", "text": "思った以上に身体が硬いから"},
        { "location": "234/TALK"    , "narrator": "アーヤ", "text": "柔軟運動でも筋とか変にしちゃいそうなの"},
        { "location": "235/TALK"    , "narrator": "アーヤ", "text": "不健康過ぎー(＞0＜)"},
        { "location": "236/TALK"    , "narrator": "アーヤ", "text": "柔軟よりも、簡単な運動から始めるべきかしら？"},
        { "location": "238/SEL"     , "narrator": "", "text": "できるとこまで頑張らせる"},
        { "location": "239/SEL"     , "narrator": "", "text": "ストレッチから始めよう"},
        { "location": "240/ACT"     , "narrator": "", "text": "できるとこまで頑張らせる"},
        { "location": "241/TALK"    , "narrator": "アーヤ", "text": "ちょっと心配かも(-ω-;)"},
        { "location": "242/TALK"    , "narrator": "アーヤ", "text": "でも、激しくない運動って言ったら、それくらいよね？"},
        { "location": "243/TALK"    , "narrator": "アーヤ", "text": "それに、みやびは人一倍運動と縁のない子なんだから"},
        { "location": "244/TALK"    , "narrator": "アーヤ", "text": "それくらいやらないと"},
        { "location": "257/TALK"    , "narrator": "アーヤ", "text": "…一応調べてみたけど、\nやっぱり柔軟運動が\n良さそうね。"},
        { "location": "258/TALK"    , "narrator": "みやび", "text": "やけんど、足を開いて\nするやつはできんがよ。"},
        { "location": "259/TALK"    , "narrator": "アーヤ", "text": "いきなりは無理よ。"},
        { "location": "260/TALK"    , "narrator": "アーヤ", "text": "毎日続けて、少しずつ\n柔らかくしていくのが\n柔軟運動なんだから――"},
        { "location": "261/TALK"    , "narrator": "アーヤ", "text": "最初は痛いと思うけど、\n限界までやった方が\n良いわ。"},
        { "location": "262/TALK"    , "narrator": "みやび", "text": "本気で言ってるがか？\nうちに拷問に耐えろ\n言うんと同じやぞ？"},
        { "location": "263/TALK"    , "narrator": "アーヤ", "text": "汗かいたり疲れたりする\n運動じゃないんだから、\n文句言わないの。"},
        { "location": "264/TALK"    , "narrator": "アーヤ", "text": "少し痛いの我慢して\n続ければ――"},
        { "location": "265/TALK"    , "narrator": "アーヤ", "text": "一週間後には痛みを\n感じないくらいには\nなるはずよ。"},
        { "location": "267/TALK"    , "narrator": "みやび", "text": "…柔軟って、そんなに\n根性出さんといかん\n運動やったか？"},
        { "location": "268/TALK"    , "narrator": "アーヤ", "text": "恨むんなら、不健康な\n生活を送っていた自分を\n恨みなさい。"},
        { "location": "269/TALK"    , "narrator": "アーヤ", "text": "とにかく、一週間は\n続けること。\nわかった？"},
        { "location": "270/TALK"    , "narrator": "みやび", "text": "…何だか、無性に面倒臭く\nなってきたぞね。"},
        { "location": "271/TALK"    , "narrator": "みやび", "text": "はぁ…憂鬱やね。"},
        { "location": "272/TALK"    , "narrator": "アーヤ", "text": "…こりゃ、やったとしても\n三日坊主で終わりそうね。"},
        { "location": "273/ACT"     , "narrator": "", "text": "ストレッチから始めよう"},
        { "location": "275/TALK"    , "narrator": "アーヤ", "text": "そうね"},
        { "location": "276/TALK"    , "narrator": "アーヤ", "text": "筋でも痛めて動けなくなったら大変だし"},
        { "location": "277/TALK"    , "narrator": "アーヤ", "text": "それでいくわ"},
        { "location": "290/TALK"    , "narrator": "アーヤ", "text": "ＯＫ、良いのがあったわ。"},
        { "location": "291/TALK"    , "narrator": "アーヤ", "text": "今のみやびに柔軟運動は\n危険そうだから――"},
        { "location": "292/TALK"    , "narrator": "アーヤ", "text": "ストレッチから\n始めた方が良さそうね。"},
        { "location": "293/TALK"    , "narrator": "みやび", "text": "ストレッチ？\nやり方知らんけんど、\n難しいん？"},
        { "location": "294/TALK"    , "narrator": "アーヤ", "text": "簡単なのだと、\n腰や腕を回す運動かしら。"},
        { "location": "295/TALK"    , "narrator": "アーヤ", "text": "軽く足を開いて立って、\n腰を左右に回すの。"},
        { "location": "296/TALK"    , "narrator": "みやび", "text": "…そんなもんでえいが？"},
        { "location": "297/TALK"    , "narrator": "アーヤ", "text": "ええ。腕の方も同じで、\n前後に回したり、伸ばして\n回したりするの。"},
        { "location": "298/TALK"    , "narrator": "アーヤ", "text": "簡単そうに見えるけど、\nやってみると結構疲れる\n運動よ。"},
        { "location": "299/TALK"    , "narrator": "みやび", "text": "そんなもんでえいがか…\nなるほど、それなら\n続けられそうちや。"},
        { "location": "300/TALK"    , "narrator": "みやび", "text": "正直、うちも自分が\n運動不足なんを、\nちくっと気にしちょったき。"},
        { "location": "302/TALK"    , "narrator": "みやび", "text": "けんど、今のを続ければ\n少しはマシになるかも\nしれんね。"},
        { "location": "303/TALK"    , "narrator": "アーヤ", "text": "…驚いたわ。\nみやびがこんなに\n喜んでくれるなんて…。"},
        { "location": "304/TALK"    , "narrator": "アーヤ", "text": "これを機に、少しは\n運動を日課にしてくれる\nかしら？"},
        { "location": "184/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>5月15日　8:53 PM</color>\nＷＡＶＥ戦の翌週末、アーヤの部屋にて。"},
        { "location": "315/DIALOG"  , "narrator": "Dialog_GEThimegoto_ch02", "text": "【コミットしちゃう？】"}
    ]
}
