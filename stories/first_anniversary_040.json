    "entry":
    [
        { "location": "663/TALK"   , "narrator": "神楽", "text": "あんまり\n焦らしすぎるのも\nアレだし。"},
        { "location": "664/TALK"   , "narrator": "神楽", "text": "そろそろ見せても\nいいかな？"},
        { "location": "677/TALK"   , "narrator": "神楽", "text": "ではでは覚悟はいいですか？"},
        { "location": "679/SEL"    , "narrator": "（選択肢）", "text": "ちょっと違うような"},
        { "location": "680/SEL"    , "narrator": "（選択肢）", "text": "準備万端だよ！"},
        { "location": "681/SEL"    , "narrator": "（選択肢）", "text": "いいから早く見せて"},
        { "location": "682/ACT"    , "narrator": "", "text": "ちょっと違うような"},
        { "location": "683/TALK"   , "narrator": "神楽", "text": "そうかも？"},
        { "location": "684/ACT"    , "narrator": "", "text": "準備万端だよ！"},
        { "location": "685/TALK"   , "narrator": "神楽", "text": "イイネイイネ"},
        { "location": "686/ACT"    , "narrator": "", "text": "いいから早く見せて"},
        { "location": "687/TALK"   , "narrator": "神楽", "text": "わかってます～"},
        { "location": "708/TALK"   , "narrator": "神楽", "text": "いいですよね"},
        { "location": "710/TALK"   , "narrator": "神楽", "text": "こっちの方が"},
        { "location": "711/TALK"   , "narrator": "神楽", "text": "みんなの考えが"},
        { "location": "712/TALK"   , "narrator": "神楽", "text": "わかりませんぴょんこは"},
        { "location": "713/SEL"    , "narrator": "（選択肢）", "text": "刺激が強すぎるからかも…"},
        { "location": "714/SEL"    , "narrator": "（選択肢）", "text": "恥ずかしがる気持ちはわかる"},
        { "location": "715/SEL"    , "narrator": "（選択肢）", "text": "いいものをありがとう！！！！"},
        { "location": "716/ACT"    , "narrator": "", "text": "刺激が強すぎるからかも…"},
        { "location": "717/TALK"   , "narrator": "神楽", "text": "そうでないと思うけどﾅｰ"},
        { "location": "718/ACT"    , "narrator": "", "text": "恥ずかしがる気持ちはわかる"},
        { "location": "719/TALK"   , "narrator": "神楽", "text": "違いのわかる$handle$♪"},
        { "location": "720/ACT"    , "narrator": "", "text": "いいものをありがとう！！！！"},
        { "location": "721/TALK"   , "narrator": "神楽", "text": "いえいえ♪"},
        { "location": "723/TALK"   , "narrator": "神楽", "text": "よしよし♪"},
        { "location": "731/TALK"   , "narrator": "透明つばめ", "text": "神楽ちゃん？\n何やってるの？"},
        { "location": "732/TALK"   , "narrator": "透明神楽", "text": "ちょっとした\n内緒話です♪"},
        { "location": "733/TALK"   , "narrator": "透明つばめ", "text": "あっそれ…\nみんなが反対したっていう\n温泉のイラスト！"},
        { "location": "735/TALK"   , "narrator": "透明神楽", "text": "ばれちゃいましたか。"},
        { "location": "736/TALK"   , "narrator": "透明神楽", "text": "$handle$さんにも\nやっぱり見て欲しくて。"},
        { "location": "737/TALK"   , "narrator": "透明つばめ", "text": "そうだよね、\nせっかく描いたん\nだもん。"},
        { "location": "738/TALK"   , "narrator": "透明神楽", "text": "じゃあ後は\nゆっくり話して\nください。"},
        { "location": "740/TALK"   , "narrator": "透明つばめ", "text": "へ？"},
        { "location": "741/TALK"   , "narrator": "透明神楽", "text": "$handle$さんと。\n私はもう寝ます。\nおやすみなさい。"},
        { "location": "744/TALK"   , "narrator": "透明つばめ", "text": "行っちゃった…。"},
        { "location": "748/TALK"   , "narrator": "つばめ", "text": "$handle$さん$handle$さん"},
        { "location": "749/SEL"    , "narrator": "（選択肢）", "text": "はいはい$me$だよ"},
        { "location": "750/SEL"    , "narrator": "（選択肢）", "text": "別に何も見てないから！"},
        { "location": "751/ACT"    , "narrator": "", "text": "はいはい$me$だよ"},
        { "location": "752/TALK"   , "narrator": "つばめ", "text": "$handle$さんだー(´I `*)"},
        { "location": "753/ACT"    , "narrator": "", "text": "別に何も見てないから！"},
        { "location": "754/TALK"   , "narrator": "つばめ", "text": "ぇっそうなの"},
        { "location": "755/TALK"   , "narrator": "つばめ", "text": "それはちょっとさみしぃかも(´・ω・｀)"},
        { "location": "759/TALK"   , "narrator": "つばめ", "text": "神楽ちゃんのイラストかわぃぃから大好き"},
        { "location": "760/TALK"   , "narrator": "つばめ", "text": "だから自分を描いてもらえると嬉しいんだ(*´︶`*)"},
        { "location": "761/SEL"    , "narrator": "（選択肢）", "text": "萌えるよね"},
        { "location": "762/SEL"    , "narrator": "（選択肢）", "text": "そうなんだ"},
        { "location": "763/ACT"    , "narrator": "", "text": "萌えるよね"},
        { "location": "764/TALK"   , "narrator": "つばめ", "text": "そぅだょね"},
        { "location": "765/ACT"    , "narrator": "", "text": "そうなんだ"},
        { "location": "766/TALK"   , "narrator": "つばめ", "text": "キューンってなっちゃぅ"},
        { "location": "768/TALK"   , "narrator": "つばめ", "text": "今回のは$handle$さんにメッセージ贈るって目的があるでしょ"},
        { "location": "769/TALK"   , "narrator": "つばめ", "text": "だから特別だし"},
        { "location": "770/SEL"    , "narrator": "（選択肢）", "text": "$me$が特別だから？"},
        { "location": "771/SEL"    , "narrator": "（選択肢）", "text": "うれしいな"},
        { "location": "772/ACT"    , "narrator": "", "text": "$me$が特別だから？"},
        { "location": "773/TALK"   , "narrator": "つばめ", "text": "特別に決まってるでしょｖ(*´∀｀*)ｖ"},
        { "location": "774/TALK"   , "narrator": "つばめ", "text": "$handle$さんなんだから"},
        { "location": "775/ACT"    , "narrator": "", "text": "うれしいな"},
        { "location": "776/TALK"   , "narrator": "つばめ", "text": "本当？"},
        { "location": "777/TALK"   , "narrator": "つばめ", "text": "ぁたしもうれしぃんだ(*´ω｀*)"},
        { "location": "779/TALK"   , "narrator": "つばめ", "text": "$handle$さんは本当に特別"},
        { "location": "780/TALK"   , "narrator": "つばめ", "text": "お父さんとかお母さんとか友達とかそれより全然特別"},
        { "location": "781/TALK"   , "narrator": "つばめ", "text": "本当だょヽ(･ω･ )ゝ☆"},
        { "location": "784/SEL"    , "narrator": "（選択肢）", "text": "ありがとう"},
        { "location": "785/SEL"    , "narrator": "（選択肢）", "text": "$me$もだよ"},
        { "location": "786/SEL"    , "narrator": "（選択肢）", "text": "もっと言って！"},
        { "location": "787/ACT"    , "narrator": "", "text": "ありがとう"},
        { "location": "788/TALK"   , "narrator": "つばめ", "text": "それを言うのはぁたしの方"},
        { "location": "789/TALK"   , "narrator": "つばめ", "text": "いつもありがとう"},
        { "location": "790/TALK"   , "narrator": "つばめ", "text": "だいすき"},
        { "location": "791/ACT"    , "narrator": "", "text": "$me$もだよ"},
        { "location": "792/TALK"   , "narrator": "つばめ", "text": "知ってるょそんなこと"},
        { "location": "793/TALK"   , "narrator": "つばめ", "text": "だからすごく特別なの"},
        { "location": "794/TALK"   , "narrator": "つばめ", "text": "だいすき"},
        { "location": "795/ACT"    , "narrator": "", "text": "もっと言って！"},
        { "location": "796/TALK"   , "narrator": "つばめ", "text": "いつもあんまり言えてないから"},
        { "location": "797/TALK"   , "narrator": "つばめ", "text": "改めて言うね(*´︶`*)"},
        { "location": "798/TALK"   , "narrator": "つばめ", "text": "$handle$さんのことは特別"},
        { "location": "803/TALK"   , "narrator": "透明つばめ", "text": "ふふ……。"},
        { "location": "805/DIALOG" , "narrator": "", "text": "$handle$さん。\n\n今までずっと一緒にいてくれて\n本当にありがとう。\n\nどうか、これからも\nずっとわたしの傍にいてください。"},
        { "location": "813/TALK"   , "narrator": "透明アーヤ", "text": "眠れないの？"},
        { "location": "815/TALK"   , "narrator": "透明神楽", "text": "…あ、ちょっと…。"},
        { "location": "816/TALK"   , "narrator": "透明アーヤ", "text": "でもスマホなんて\n触ってたらもっと\n目が覚めるわよ。"},
        { "location": "818/TALK"   , "narrator": "透明アーヤ", "text": "って！\nこのイラスト\nひょっとして…。"},
        { "location": "819/TALK"   , "narrator": "透明神楽", "text": "ばれちゃいましたか。"},
        { "location": "820/TALK"   , "narrator": "透明神楽", "text": "あとはお任せしますね。\nおやすみなさい！"},
        { "location": "822/TALK"   , "narrator": "透明アーヤ", "text": "卯月！？"},
        { "location": "824/TALK"   , "narrator": "透明アーヤ", "text": "…もう…。"},
        { "location": "827/SEL"    , "narrator": "（選択肢）", "text": "何も見てないよ！"},
        { "location": "828/SEL"    , "narrator": "（選択肢）", "text": "アーヤかわいかったよ"},
        { "location": "829/SEL"    , "narrator": "（選択肢）", "text": "照れなくていいのに"},
        { "location": "830/ACT"    , "narrator": "", "text": "何も見てないよ！"},
        { "location": "831/TALK"   , "narrator": "アーヤ", "text": "誤魔化さなくていいわよ"},
        { "location": "833/TALK"   , "narrator": "アーヤ", "text": "バレバレだし(--*;"},
        { "location": "834/ACT"    , "narrator": "", "text": "アーヤかわいかったよ"},
        { "location": "835/TALK"   , "narrator": "アーヤ", "text": "そういう問題じゃないのよ"},
        { "location": "836/TALK"   , "narrator": "アーヤ", "text": "もう(--#)"},
        { "location": "837/ACT"    , "narrator": "", "text": "照れなくていいのに"},
        { "location": "838/TALK"   , "narrator": "アーヤ", "text": "照れてるっていうか"},
        { "location": "839/TALK"   , "narrator": "アーヤ", "text": "恥ずかしいのよ！"},
        { "location": "841/TALK"   , "narrator": "アーヤ", "text": "温泉はさすがにやりすぎだと思うの"},
        { "location": "842/TALK"   , "narrator": "アーヤ", "text": "いくら$handle$さんにでも"},
        { "location": "843/SEL"    , "narrator": "（選択肢）", "text": "そうなの？"},
        { "location": "844/SEL"    , "narrator": "（選択肢）", "text": "そんなことないよ"},
        { "location": "845/SEL"    , "narrator": "（選択肢）", "text": "それは残念"},
        { "location": "846/ACT"    , "narrator": "", "text": "そうなの？"},
        { "location": "847/TALK"   , "narrator": "アーヤ", "text": "そうよ"},
        { "location": "848/ACT"    , "narrator": "", "text": "そんなことないよ"},
        { "location": "849/TALK"   , "narrator": "アーヤ", "text": "そうかしら、、、"},
        { "location": "850/ACT"    , "narrator": "", "text": "それは残念"},
        { "location": "851/TALK"   , "narrator": "アーヤ", "text": "そんなこと言わないで"},
        { "location": "853/TALK"   , "narrator": "アーヤ", "text": "ねえ$handle$さん"},
        { "location": "854/TALK"   , "narrator": "アーヤ", "text": "私すごく感謝してるの"},
        { "location": "855/TALK"   , "narrator": "アーヤ", "text": "$handle$さんに出会えたこと"},
        { "location": "856/SEL"    , "narrator": "（選択肢）", "text": "$me$も"},
        { "location": "857/SEL"    , "narrator": "（選択肢）", "text": "それって本心？"},
        { "location": "858/SEL"    , "narrator": "（選択肢）", "text": "それはうれしいな"},
        { "location": "859/ACT"    , "narrator": "", "text": "$me$も"},
        { "location": "860/TALK"   , "narrator": "アーヤ", "text": "そう？"},
        { "location": "862/TALK"   , "narrator": "アーヤ", "text": "照れちゃうわ"},
        { "location": "863/ACT"    , "narrator": "", "text": "それって本心？"},
        { "location": "864/TALK"   , "narrator": "アーヤ", "text": "当たり前じゃない"},
        { "location": "865/TALK"   , "narrator": "アーヤ", "text": "わかってて言ってるんでしょ？"},
        { "location": "866/ACT"    , "narrator": "", "text": "それはうれしいな"},
        { "location": "867/TALK"   , "narrator": "アーヤ", "text": "余裕綽々って感じで"},
        { "location": "868/TALK"   , "narrator": "アーヤ", "text": "でもそこも好き(*^.^*)"},
        { "location": "870/TALK"   , "narrator": "アーヤ", "text": "私すぐ周りが見えなくなるけど"},
        { "location": "871/TALK"   , "narrator": "アーヤ", "text": "そういう時に$handle$さんはリラックスさせてくれるでしょ"},
        { "location": "872/TALK"   , "narrator": "アーヤ", "text": "できそうでなかなかできないことだし"},
        { "location": "873/TALK"   , "narrator": "アーヤ", "text": "わかってくれてるんだって安心できるの"},
        { "location": "874/SEL"    , "narrator": "（選択肢）", "text": "そうだったっけ"},
        { "location": "875/SEL"    , "narrator": "（選択肢）", "text": "大したことないよ"},
        { "location": "876/SEL"    , "narrator": "（選択肢）", "text": "アーヤが一番大事だから"},
        { "location": "877/ACT"    , "narrator": "", "text": "そうだったっけ"},
        { "location": "878/TALK"   , "narrator": "アーヤ", "text": "そうでしょ？"},
        { "location": "879/TALK"   , "narrator": "アーヤ", "text": "ちゃんと気づいてるんだから私だって"},
        { "location": "880/ACT"    , "narrator": "", "text": "大したことないよ"},
        { "location": "881/TALK"   , "narrator": "アーヤ", "text": "そんなことない"},
        { "location": "882/TALK"   , "narrator": "アーヤ", "text": "なかなかできないことなんだから"},
        { "location": "883/ACT"    , "narrator": "", "text": "アーヤが一番大事だから"},
        { "location": "884/TALK"   , "narrator": "アーヤ", "text": "私もそう"},
        { "location": "885/TALK"   , "narrator": "アーヤ", "text": "世界で一番大事"},
        { "location": "887/TALK"   , "narrator": "アーヤ", "text": "だから"},
        { "location": "888/TALK"   , "narrator": "アーヤ", "text": "これからもよろしくね"},
        { "location": "890/TALK"   , "narrator": "アーヤ", "text": "$handle$さん(￣∇￣*)ゞ"},
        { "location": "893/TALK"   , "narrator": "透明アーヤ", "text": "イラストは忘れてって\n言うのを忘れてた……。"},
        { "location": "894/TALK"   , "narrator": "透明アーヤ", "text": "…$handle$さん\nならいいか……。"},
        { "location": "896/TALK"   , "narrator": "透明アーヤ", "text": "本当はちょっと\n恥ずかしいけど…。"},
        { "location": "898/DIALOG" , "narrator": "", "text": "$handle$さん。\n\nいつも傍にいてくれて\nありがとうございます。\n\nこれからも末永く\n共に歩んで行きましょうね(^^*"},
        { "location": "906/TALK"   , "narrator": "透明ガブリエラ", "text": "こんなところに\nいたの？"},
        { "location": "907/TALK"   , "narrator": "透明ガブリエラ", "text": "部屋にいないと\n思ったら……。"},
        { "location": "909/TALK"   , "narrator": "透明ガブリエラ", "text": "って、ちょっと\nその絵って…！"},
        { "location": "910/TALK"   , "narrator": "透明神楽", "text": "やっぱりせっかく\n描いたからって\n思って。"},
        { "location": "911/TALK"   , "narrator": "透明神楽", "text": "$handle$さんに\n見せちゃいました。"},
        { "location": "912/TALK"   , "narrator": "透明ガブリエラ", "text": "もー！！！！"},
        { "location": "913/TALK"   , "narrator": "透明ガブリエラ", "text": "ありえない……。"},
        { "location": "914/TALK"   , "narrator": "透明神楽", "text": "あとはごゆっくり。"},
        { "location": "916/TALK"   , "narrator": "透明ガブリエラ", "text": "えっちょっと！"},
        { "location": "917/SEL"    , "narrator": "（選択肢）", "text": "見ちゃダメだった？"},
        { "location": "918/ACT"    , "narrator": "", "text": "見ちゃダメだった？"},
        { "location": "925/TALK"   , "narrator": "ガブリエラ", "text": "ダメっていうか"},
        { "location": "926/TALK"   , "narrator": "ガブリエラ", "text": "それは"},
        { "location": "928/TALK"   , "narrator": "ガブリエラ", "text": "ダメはダメだけど"},
        { "location": "929/SEL"    , "narrator": "（選択肢）", "text": "ごめんね"},
        { "location": "930/SEL"    , "narrator": "（選択肢）", "text": "残念すぎる"},
        { "location": "931/SEL"    , "narrator": "（選択肢）", "text": "かわいかったのになー"},
        { "location": "932/ACT"    , "narrator": "", "text": "ごめんね"},
        { "location": "933/TALK"   , "narrator": "ガブリエラ", "text": "謝らなくていいわよ"},
        { "location": "934/TALK"   , "narrator": "ガブリエラ", "text": "卯月のやったことだし"},
        { "location": "935/ACT"    , "narrator": "", "text": "残念すぎる"},
        { "location": "936/TALK"   , "narrator": "ガブリエラ", "text": "そうなのかしら？"},
        { "location": "937/TALK"   , "narrator": "ガブリエラ", "text": "なんて"},
        { "location": "938/TALK"   , "narrator": "ガブリエラ", "text": "やっぱりダメダメ！"},
        { "location": "939/ACT"    , "narrator": "", "text": "かわいかったのになー"},
        { "location": "940/TALK"   , "narrator": "ガブリエラ", "text": "そうかしら////////////////////////////"},
        { "location": "941/TALK"   , "narrator": "ガブリエラ", "text": "そうじゃなくて！！！！！！"},
        { "location": "943/TALK"   , "narrator": "ガブリエラ", "text": "こういうのじゃなくても"},
        { "location": "945/TALK"   , "narrator": "ガブリエラ", "text": "$handle$には気持ちを伝えられると思ってるのよ私"},
        { "location": "946/SEL"    , "narrator": "（選択肢）", "text": "愛のことかな？"},
        { "location": "947/SEL"    , "narrator": "（選択肢）", "text": "こういうのも欲しいなー"},
        { "location": "948/SEL"    , "narrator": "（選択肢）", "text": "そんなことはわかってるけど…"},
        { "location": "949/ACT"    , "narrator": "", "text": "愛のことかな？"},
        { "location": "950/TALK"   , "narrator": "ガブリエラ", "text": "愛////////////////////////"},
        { "location": "952/TALK"   , "narrator": "ガブリエラ", "text": "そうなのよｖｖｖｖｖｖ"},
        { "location": "953/ACT"    , "narrator": "", "text": "こういうのも欲しいなー"},
        { "location": "954/TALK"   , "narrator": "ガブリエラ", "text": "やっぱりそうなのね？"},
        { "location": "955/TALK"   , "narrator": "ガブリエラ", "text": "$handle$ったらもう！"},
        { "location": "956/ACT"    , "narrator": "", "text": "そんなことはわかってるけど…"},
        { "location": "957/TALK"   , "narrator": "ガブリエラ", "text": "だけどやっぱりってことなの？"},
        { "location": "958/TALK"   , "narrator": "ガブリエラ", "text": "そういうものなのかしら・・・"},
        { "location": "960/TALK"   , "narrator": "ガブリエラ", "text": "からかわないで聞いて$handle$"},
        { "location": "961/TALK"   , "narrator": "ガブリエラ", "text": "私ね"},
