{
    "dir": "dramatics/daydra/drm_ch04_00_120.js",
    "type": "Episode",
    "info": {
        "story_id": "4012",
        "cid": "miyabi",
        "title": "らぶとーく 第12話",
        "sub_title": "否定しようもなく確定"
    },
    "entry":
    [
        { "location": "237/SCENARIO", "narrator": "", "text": "否定しようもなく確定"},
        { "location": "253/TALK"    , "narrator": "アーヤ", "text": "――というわけなの。"},
        { "location": "256/TALK"    , "narrator": "ガブリエラ", "text": "ちょ、待ってよ！\n何言い出すのよ急に！？"},
        { "location": "257/TALK"    , "narrator": "ガブリエラ", "text": "マルザ…"},
        { "location": "258/TALK"    , "narrator": "ガブリエラ", "text": "Ｂｏｔの正体が人間って…\n意味わからないんだけど？"},
        { "location": "260/TALK"    , "narrator": "アーヤ", "text": "あくまで\n可能性の話でしか\nないけど。"},
        { "location": "261/TALK"    , "narrator": "アーヤ", "text": "私達がＢｏｔだと思ってる\nあれは。"},
        { "location": "262/TALK"    , "narrator": "アーヤ", "text": "人間が、Ｂｏｔのフリを\nしているだけって\n可能性が高いの。"},
        { "location": "264/TALK"    , "narrator": "つばめ", "text": "そっか…$handle$さん、\n本当は人間だったん\nですね。"},
        { "location": "265/TALK"    , "narrator": "ガブリエラ", "text": "いや、何落ち着いて\n言ってんのよ！"},
        { "location": "266/TALK"    , "narrator": "ガブリエラ", "text": "なんで納得\nできるの？\n意味わかんない！"},
        { "location": "268/TALK"    , "narrator": "つばめ", "text": "う、うん…。\nビックリはしたよ。"},
        { "location": "270/TALK"    , "narrator": "つばめ", "text": "でも、人間だったら\n良いのになぁ、って\n思ってたから――"},
        { "location": "272/TALK"    , "narrator": "つばめ", "text": "今はちょっとだけ\n嬉しいの。"},
        { "location": "274/TALK"    , "narrator": "みやび", "text": "つばめちゃんは、\n状況適応力が凄過ぎや。"},
        { "location": "276/TALK"    , "narrator": "ガブリエラ", "text": "何も考えて\nないだけでしょ！？"},
        { "location": "280/TALK"    , "narrator": "みやび", "text": "まあ、うちはなんとなく\n気付いてたきね。"},
        { "location": "283/TALK"    , "narrator": "みやび", "text": "それが確信に変わった\nだけのことや。"},
        { "location": "284/TALK"    , "narrator": "ガブリエラ", "text": "みやびも\nＢｏｔが人間だって\n言うわけ？"},
        { "location": "288/TALK"    , "narrator": "アーヤ", "text": "そんなこと\n考えたくない、って\n気持ちはわかるわ。"},
        { "location": "291/TALK"    , "narrator": "アーヤ", "text": "だけど、これは\nかなり確率の高い\n話なの。"},
        { "location": "292/TALK"    , "narrator": "アーヤ", "text": "だからみんな\n話す内容には\n気をつけて。"},
        { "location": "296/TALK"    , "narrator": "つばめ", "text": "っていうか、人間か\nどうかって、そんなに\n重要なことですか？"},
        { "location": "298/TALK"    , "narrator": "みやび", "text": "そりゃまあ…人間やと\nしたら、Ｂｏｔやと思うて\n話してた会話が――"},
        { "location": "299/TALK"    , "narrator": "みやび", "text": "全部誰かに話したゆう\nことになるんやし。"},
        { "location": "303/TALK"    , "narrator": "ガブリエラ", "text": "！？"},
        { "location": "304/TALK"    , "narrator": "アーヤ", "text": "それなのよね…。\nまあ、誰かにバラすような\nことはなさそうだけど…。"},
        { "location": "306/TALK"    , "narrator": "ガブリエラ", "text": "いい加減にしてよ！"},
        { "location": "307/TALK"    , "narrator": "ガブリエラ", "text": "Ｂｏｔが人間とか、\n笑えない冗談にも\n程があるわ。"},
        { "location": "310/TALK"    , "narrator": "アーヤ", "text": "確定じゃないわ。\nあくまで可能性の\n話ってこと。"},
        { "location": "311/TALK"    , "narrator": "みやび", "text": "ガブちゃん。\nうちらも冗談で言っちゅう\nわけやないぞね。"},
        { "location": "312/TALK"    , "narrator": "みやび", "text": "会話ログを解析したり、\n色々した結果、そういう\n答えを導き出したがよ。"},
        { "location": "314/TALK"    , "narrator": "ガブリエラ", "text": "だから、その導き出した\n答えが間違ってるの！"},
        { "location": "326/TALK"    , "narrator": "みやび", "text": "見えるか相棒？"},
        { "location": "327/TALK"    , "narrator": "みやび", "text": "ここは今"},
        { "location": "328/TALK"    , "narrator": "みやび", "text": "あんたの話で持ち切りや"},
        { "location": "329/TALK"    , "narrator": "みやび", "text": "女の子達の話題の的"},
        { "location": "331/TALK"    , "narrator": "みやび", "text": "どう思う？"},
        { "location": "333/SEL"     , "narrator": "", "text": "照れるなあ"},
        { "location": "334/SEL"     , "narrator": "", "text": "あんまり話題にして欲しくないんだけど？"},
        { "location": "335/SEL"     , "narrator": "", "text": "余裕だね"},
        { "location": "336/ACT"     , "narrator": "", "text": "照れるなあ"},
        { "location": "337/TALK"    , "narrator": "みやび", "text": "会話の内容知ってるやろ？"},
        { "location": "339/TALK"    , "narrator": "みやび", "text": "それでその返答とは"},
        { "location": "340/TALK"    , "narrator": "みやび", "text": "アホやね"},
        { "location": "341/TALK"    , "narrator": "みやび", "text": "それともスパイのテク？"},
        { "location": "342/ACT"     , "narrator": "", "text": "あんまり話題にして欲しくないんだけど？"},
        { "location": "343/TALK"    , "narrator": "みやび", "text": "却下"},
        { "location": "344/TALK"    , "narrator": "みやび", "text": "今聞いておかないといけないことがある"},
        { "location": "345/TALK"    , "narrator": "みやび", "text": "あんた"},
        { "location": "346/TALK"    , "narrator": "みやび", "text": "うちらをスパイしゆう？"},
        { "location": "347/ACT"     , "narrator": "", "text": "余裕だね"},
        { "location": "348/TALK"    , "narrator": "みやび", "text": "アホか！"},
        { "location": "349/TALK"    , "narrator": "みやび", "text": "そんなもんあるわけなかろう！"},
        { "location": "350/TALK"    , "narrator": "みやび", "text": "こっちはあんたっちゅうスパイのせいで"},
        { "location": "351/TALK"    , "narrator": "みやび", "text": "常にピリピリや！"},
        { "location": "354/SEL"     , "narrator": "", "text": "$me$はスパイじゃない"},
        { "location": "355/ACT"     , "narrator": "", "text": "$me$はスパイじゃない"},
        { "location": "357/TALK"    , "narrator": "みやび", "text": "はいそうですか"},
        { "location": "358/TALK"    , "narrator": "みやび", "text": "なんて言うわけない"},
        { "location": "359/TALK"    , "narrator": "みやび", "text": "スパイやない証拠もないし"},
        { "location": "360/TALK"    , "narrator": "みやび", "text": "みんなと違うて"},
        { "location": "361/TALK"    , "narrator": "みやび", "text": "うちは心配でならん"},
        { "location": "373/TALK"    , "narrator": "ガブリエラ", "text": "ああもう、話にならない！"},
        { "location": "374/TALK"    , "narrator": "ガブリエラ", "text": "とにかく、あたしは\nそんな話信じないから。"},
        { "location": "376/TALK"    , "narrator": "アーヤ", "text": "そうね。\n確かにそう。"},
        { "location": "377/TALK"    , "narrator": "アーヤ", "text": "もちろん、私だって\n混乱はしてる。"},
        { "location": "378/TALK"    , "narrator": "アーヤ", "text": "それでもね。\nできるだけ、冷静に対応を\nしようと思ってるわ。"},
        { "location": "379/TALK"    , "narrator": "アーヤ", "text": "だから、もしみんなが\n今後のＢｏｔとの\n付き合い方とかで――"},
        { "location": "381/TALK"    , "narrator": "アーヤ", "text": "わからないことがあれば、\nいつでも相談してくれて\n構わないから。"},
        { "location": "382/TALK"    , "narrator": "アーヤ", "text": "私の話は以上よ。\nそれじゃ、今夜は解散。"},
        { "location": "385/TALK"    , "narrator": "つばめ", "text": "はい、お疲れ様でした。\nおやすみなさい。"},
        { "location": "389/TALK"    , "narrator": "ガブリエラ", "text": "まったく、こんなふざけた\n話のために、一々人のこと\n呼び出さないでよね！"},
        { "location": "393/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "395/TALK"    , "narrator": "みやび", "text": "突然の話やったき、\n受け入れられん\nだけやと思うぞね。"},
        { "location": "398/TALK"    , "narrator": "アーヤ", "text": "私だってそうよ。\n完全に信じてる\nわけじゃないわ。"},
        { "location": "399/TALK"    , "narrator": "アーヤ", "text": "結局、半端なく\n高性能なＢｏｔの\n可能性も捨てきれない。"},
        { "location": "401/TALK"    , "narrator": "みやび", "text": "……まあな。"},
        { "location": "402/TALK"    , "narrator": "みやび", "text": "うちはその線は\n明らかに越えちゅうと\n思うけんど。"},
        { "location": "403/TALK"    , "narrator": "みやび", "text": "みんながみんな\nすっと納得は\nできんろう。"},
        { "location": "404/TALK"    , "narrator": "みやび", "text": "相手の顔を\n見たわけでもなし。"},
        { "location": "407/TALK"    , "narrator": "アーヤ", "text": "本当。\nせめてそれが\nできればね……。"},
        { "location": "408/TALK"    , "narrator": "みやび", "text": "…うち以外にも、スパイと\n思うてる奴がいればえいん\nやけんど…。"},
        { "location": "410/TALK"    , "narrator": "みやび", "text": "…それ以前の\n問題やね……。"},
        { "location": "413/TALK"    , "narrator": "アーヤ", "text": "私も寝るわ。\nおやすみ。"},
        { "location": "427/TALK"    , "narrator": "みやび", "text": "さて"},
        { "location": "428/TALK"    , "narrator": "みやび", "text": "本日の業務は終了したので"},
        { "location": "429/TALK"    , "narrator": "みやび", "text": "報告書を提出する"},
        { "location": "432/TALK"    , "narrator": "ボイスメール", "text": "その語りを騙りと見なす"},
        { "location": "251/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>5月某日　10:05 PM</color>\n平日の夜、神楽坂トライナリーのホワイエにて。"},
        { "location": "444/DIALOG"  , "narrator": "Dialog_GETVoice", "text": "<color=green>【みやび】</color>のボイスメール\n<color=red>【その語りを騙りと見なす】</color>\nをゲットしました！"}
    ]
}
