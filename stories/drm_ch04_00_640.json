    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "OSが違うのだ"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "互換性がないのだ"},
        { "location": "33/TALK"   , "narrator": "みやび", "text": "互換性が"},
        { "location": "35/SEL"    , "narrator": "", "text": "マルチブートさせれば？"},
        { "location": "36/SEL"    , "narrator": "", "text": "何の話？"},
        { "location": "37/SEL"    , "narrator": "", "text": "デジュリスタンダードかデファクトスタンダードか"},
        { "location": "38/ACT"    , "narrator": "", "text": "マルチブートさせれば？"},
        { "location": "39/TALK"   , "narrator": "みやび", "text": "ＯＳならば"},
        { "location": "40/TALK"   , "narrator": "みやび", "text": "そうするところだ"},
        { "location": "41/ACT"    , "narrator": "", "text": "何の話？"},
        { "location": "42/TALK"   , "narrator": "みやび", "text": "例え話"},
        { "location": "43/ACT"    , "narrator": "", "text": "デジュリスタンダードかデファクトスタンダードか"},
        { "location": "44/TALK"   , "narrator": "みやび", "text": "どちらでもないが"},
        { "location": "45/TALK"   , "narrator": "みやび", "text": "あえて言うならデファクトだな"},
        { "location": "47/TALK"   , "narrator": "みやび", "text": "同じ言語を操っているはずなのに"},
        { "location": "48/TALK"   , "narrator": "みやび", "text": "どうにも話がかみ合わないことがあろう"},
        { "location": "49/TALK"   , "narrator": "みやび", "text": "そういう時に思うのだ"},
        { "location": "50/TALK"   , "narrator": "みやび", "text": "目の前の人物とは"},
        { "location": "51/TALK"   , "narrator": "みやび", "text": "違うＯＳが搭載されているのではないかと"},
        { "location": "53/SEL"    , "narrator": "", "text": "そういう話か"},
        { "location": "54/SEL"    , "narrator": "", "text": "ふうん？"},
        { "location": "55/SEL"    , "narrator": "", "text": "互換性確保したいよね"},
        { "location": "56/ACT"    , "narrator": "", "text": "そういう話か"},
        { "location": "57/TALK"   , "narrator": "みやび", "text": "そう"},
        { "location": "59/TALK"   , "narrator": "みやび", "text": "現実とはなかなか厄介ぞね"},
        { "location": "60/ACT"    , "narrator": "", "text": "ふうん？"},
        { "location": "61/TALK"   , "narrator": "みやび", "text": "おや"},
        { "location": "62/TALK"   , "narrator": "みやび", "text": "ピンとこんとは"},
        { "location": "64/TALK"   , "narrator": "みやび", "text": "逆に羨ましいぞ"},
        { "location": "65/ACT"    , "narrator": "", "text": "互換性確保したいよね"},
        { "location": "75/TALK"   , "narrator": "みやび", "text": "そう"},
        { "location": "76/TALK"   , "narrator": "みやび", "text": "その気持ちはあるのだ"},
        { "location": "77/TALK"   , "narrator": "みやび", "text": "だからせめてＯＳの種類を特定できればと"},
        { "location": "78/TALK"   , "narrator": "みやび", "text": "思うことが多々ある"},
        { "location": "80/TALK"   , "narrator": "みやび", "text": "どこを確認すれば"},
        { "location": "81/TALK"   , "narrator": "みやび", "text": "互換性が確保できるのかと探ってみたり"},
        { "location": "83/SEL"    , "narrator": "", "text": "人付き合いって難しいよね"},
        { "location": "84/SEL"    , "narrator": "", "text": "お互い歩み寄れるといいね"},
        { "location": "85/SEL"    , "narrator": "", "text": "ほっといてもいいんじゃない"},
        { "location": "86/ACT"    , "narrator": "", "text": "人付き合いって難しいよね"},
        { "location": "87/TALK"   , "narrator": "みやび", "text": "ほんに"},
        { "location": "88/ACT"    , "narrator": "", "text": "お互い歩み寄れるといいね"},
        { "location": "89/TALK"   , "narrator": "みやび", "text": "ああ"},
        { "location": "91/TALK"   , "narrator": "みやび", "text": "確かに"},
        { "location": "92/ACT"    , "narrator": "", "text": "ほっといてもいいんじゃない"},
        { "location": "93/TALK"   , "narrator": "みやび", "text": "それも"},
        { "location": "95/TALK"   , "narrator": "みやび", "text": "ありか"},
        { "location": "98/SEL"    , "narrator": "", "text": "最初から話が合わないって思うのも手だよ"},
        { "location": "99/SEL"    , "narrator": "", "text": "無理する必要もないんじゃない"},
        { "location": "100/ACT"   , "narrator": "", "text": "最初から話が合わないって思うのも手だよ"},
        { "location": "101/TALK"  , "narrator": "みやび", "text": "逆転の発想というやつか"},
        { "location": "102/ACT"   , "narrator": "", "text": "無理する必要もないんじゃない"},
        { "location": "103/TALK"  , "narrator": "みやび", "text": "無理をしとるつもりはなかったが"},
        { "location": "105/TALK"  , "narrator": "みやび", "text": "最悪の状況を考えておけば"},
        { "location": "106/TALK"  , "narrator": "みやび", "text": "気の持ちようが違うのかもということか"},
        { "location": "108/SEL"   , "narrator": "", "text": "そういうこと"},
        { "location": "109/SEL"   , "narrator": "", "text": "もっと気楽になってってこと"},
        { "location": "110/ACT"   , "narrator": "", "text": "そういうこと"},
        { "location": "111/TALK"  , "narrator": "みやび", "text": "それも手ぞね"},
        { "location": "112/ACT"   , "narrator": "", "text": "もっと気楽になってってこと"},
        { "location": "113/TALK"  , "narrator": "みやび", "text": "うちはまじめやきね"},
        { "location": "115/TALK"  , "narrator": "みやび", "text": "どうにか解決策をと思っていたが"},
        { "location": "116/TALK"  , "narrator": "みやび", "text": "あえて解決しないのもありかと思えた"},
        { "location": "117/TALK"  , "narrator": "みやび", "text": "$handle$は以外と"},
        { "location": "119/TALK"  , "narrator": "みやび", "text": "面白いことを考えとるの"},
        { "location": "122/TALK"  , "narrator": "ボイスメール", "text": "バターフライ・エフェクト"},
        { "location": "71/DIALOG" , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>1000pt.</b></color></size>\nアップしました！"},
        { "location": "134/DIALOG", "narrator": "Dialog_GETVoice", "text": "<color=green>【みやび】</color>のボイスメール\n<color=red>【バターフライ・エフェクト】</color>\nをゲットしました！"}
    ]
}
