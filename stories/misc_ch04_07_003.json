    "entry":
    [
        { "location": "172/SCENARIO", "narrator": "", "text": "05_000_背後も見ずにパスワードを打ち込むやつがあるか"},
        { "location": "197/TALK"    , "narrator": "みやび", "text": "実は"},
        { "location": "198/TALK"    , "narrator": "みやび", "text": "ネットワーク経由のハッキングより"},
        { "location": "199/TALK"    , "narrator": "みやび", "text": "確実なハッキング方法があるのだ"},
        { "location": "202/SEL"     , "narrator": "", "text": "そうなの？"},
        { "location": "203/SEL"     , "narrator": "", "text": "やってみたいから教えて"},
        { "location": "204/SEL"     , "narrator": "", "text": "ソーシャル・エンジニアリングだ"},
        { "location": "205/ACT"     , "narrator": "", "text": "そうなの？"},
        { "location": "206/TALK"    , "narrator": "みやび", "text": "そうなのだ"},
        { "location": "208/TALK"    , "narrator": "みやび", "text": "気付いておらぬのか"},
        { "location": "209/ACT"     , "narrator": "", "text": "やってみたいから教えて"},
        { "location": "210/TALK"    , "narrator": "みやび", "text": "それは"},
        { "location": "212/TALK"    , "narrator": "みやび", "text": "せられんよ"},
        { "location": "213/TALK"    , "narrator": "みやび", "text": "教えられない"},
        { "location": "214/ACT"     , "narrator": "", "text": "ソーシャル・エンジニアリングだ"},
        { "location": "216/TALK"    , "narrator": "みやび", "text": "さすがだの相棒"},
        { "location": "218/TALK"    , "narrator": "みやび", "text": "模範解答だ"},
        { "location": "220/TALK"    , "narrator": "みやび", "text": "まあ"},
        { "location": "221/TALK"    , "narrator": "みやび", "text": "そんな手段もあるので"},
        { "location": "222/TALK"    , "narrator": "みやび", "text": "背後には気を付けるべき"},
        { "location": "225/SEL"     , "narrator": "", "text": "俺の背中に立つな……"},
        { "location": "226/SEL"     , "narrator": "", "text": "それってバレバレじゃない？"},
        { "location": "227/SEL"     , "narrator": "", "text": "明日から気を付けるね"},
        { "location": "228/ACT"     , "narrator": "", "text": "俺の背中に立つな……"},
        { "location": "229/TALK"    , "narrator": "みやび", "text": "ちょっと違うような"},
        { "location": "230/TALK"    , "narrator": "みやび", "text": "まあ"},
        { "location": "231/TALK"    , "narrator": "みやび", "text": "その気持ちで望んでくれ給え"},
        { "location": "232/ACT"     , "narrator": "", "text": "それってバレバレじゃない？"},
        { "location": "233/TALK"    , "narrator": "みやび", "text": "甘いな"},
        { "location": "234/TALK"    , "narrator": "みやび", "text": "そう思ってる奴ほど"},
        { "location": "235/TALK"    , "narrator": "みやび", "text": "引っかかるのだ"},
        { "location": "236/TALK"    , "narrator": "みやび", "text": "気を付けろ"},
        { "location": "237/ACT"     , "narrator": "", "text": "明日から気を付けるね"},
        { "location": "238/TALK"    , "narrator": "みやび", "text": "いやいや"},
        { "location": "239/TALK"    , "narrator": "みやび", "text": "今日から気を付けろ"},
        { "location": "240/TALK"    , "narrator": "みやび", "text": "今すぐだ"}
    ]
}
