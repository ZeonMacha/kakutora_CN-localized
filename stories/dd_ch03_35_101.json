    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "天使の役割"},
        { "location": "28/TALK"   , "narrator": "ガブリエラ", "text": "ここは…どこなの…。"},
        { "location": "29/SEL"    , "narrator": "", "text": "あなたは死にました"},
        { "location": "30/ACT"    , "narrator": "", "text": "あなたは死にました"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "誰？"},
        { "location": "33/SEL"    , "narrator": "", "text": "$me$だよ"},
        { "location": "34/SEL"    , "narrator": "", "text": "$handle$"},
        { "location": "35/SEL"    , "narrator": "", "text": "わからない？"},
        { "location": "36/ACT"    , "narrator": "", "text": "$me$だよ"},
        { "location": "37/TALK"   , "narrator": "ガブリエラ", "text": "知らないわ。"},
        { "location": "39/TALK"   , "narrator": "ガブリエラ", "text": "そう。"},
        { "location": "40/ACT"    , "narrator": "", "text": "わからない？"},
        { "location": "41/TALK"   , "narrator": "ガブリエラ", "text": "だから聞いてるの。"},
        { "location": "44/TALK"   , "narrator": "ガブリエラ", "text": "どうしてあたしが\n死んだって\n知ってるの。"},
        { "location": "45/SEL"    , "narrator": "", "text": "選択肢に出たから"},
        { "location": "46/SEL"    , "narrator": "", "text": "いや…わかるでしょ…"},
        { "location": "47/SEL"    , "narrator": "", "text": "そういうもんだから"},
        { "location": "48/ACT"    , "narrator": "", "text": "選択肢に出たから"},
        { "location": "49/TALK"   , "narrator": "ガブリエラ", "text": "何それ。"},
        { "location": "50/ACT"    , "narrator": "", "text": "いや…わかるでしょ…"},
        { "location": "51/TALK"   , "narrator": "ガブリエラ", "text": "わからないわよ。"},
        { "location": "52/ACT"    , "narrator": "", "text": "そういうもんだから"},
        { "location": "53/TALK"   , "narrator": "ガブリエラ", "text": "どういうことなの。"},
        { "location": "56/TALK"   , "narrator": "ガブリエラ", "text": "まあいいわ。\n嘘ならいずれわかる。\nそれからあなたの正体も。"},
        { "location": "57/TALK"   , "narrator": "ガブリエラ", "text": "判定ならその時で\n十分だわ。"},
        { "location": "58/TALK"   , "narrator": "ガブリエラ", "text": "ところで。"},
        { "location": "59/TALK"   , "narrator": "ガブリエラ", "text": "結局フェノメノンは\nどうなったの。\n蒸着できたの？"},
        { "location": "60/SEL"    , "narrator": "", "text": "ええと？"},
        { "location": "61/SEL"    , "narrator": "", "text": "言ってる意味がわからない"},
        { "location": "62/SEL"    , "narrator": "", "text": "できてないと思うよ"},
        { "location": "63/ACT"    , "narrator": "", "text": "ええと？"},
        { "location": "64/TALK"   , "narrator": "ガブリエラ", "text": "どっちなの。"},
        { "location": "65/ACT"    , "narrator": "", "text": "言ってる意味がわからない"},
        { "location": "66/TALK"   , "narrator": "ガブリエラ", "text": "どうしてよ。"},
        { "location": "67/ACT"    , "narrator": "", "text": "できてないと思うよ"},
        { "location": "68/TALK"   , "narrator": "ガブリエラ", "text": "憶測なの？"},
        { "location": "71/TALK"   , "narrator": "ガブリエラ", "text": "あまり考えたくないけど\nミイラ取りがミイラに\nなってたわけよね。"},
        { "location": "72/TALK"   , "narrator": "ガブリエラ", "text": "あたしの今の状態。"},
        { "location": "73/TALK"   , "narrator": "ガブリエラ", "text": "我ながら情けないわ。"},
        { "location": "74/TALK"   , "narrator": "ガブリエラ", "text": "というかあなた、\n本部から言われてた\nナビよね。"},
        { "location": "75/TALK"   , "narrator": "ガブリエラ", "text": "早くナビしなさいよ。"},
        { "location": "76/SEL"    , "narrator": "", "text": "$me$はナビじゃなくて\nガブリエラの恋人"},
        { "location": "77/SEL"    , "narrator": "", "text": "本部なんて知らない"},
        { "location": "78/SEL"    , "narrator": "", "text": "頼まれたことは\nそれじゃない"},
        { "location": "79/ACT"    , "narrator": "", "text": "$me$はナビじゃなくて\nガブリエラの恋人"},
        { "location": "80/TALK"   , "narrator": "ガブリエラ", "text": "わかったわ。"},
        { "location": "86/ACT"    , "narrator": "", "text": "本部なんて知らない"},
        { "location": "87/TALK"   , "narrator": "ガブリエラ", "text": "じゃあどうして\nここにいるの。"},
        { "location": "88/ACT"    , "narrator": "", "text": "頼まれたのは\n本部じゃない"},
        { "location": "89/TALK"   , "narrator": "ガブリエラ", "text": "おかしいわね。"},
        { "location": "91/SEL"    , "narrator": "", "text": "$me$は千羽鶴に\n頼まれた"},
        { "location": "92/ACT"    , "narrator": "", "text": "$me$は千羽鶴に\n頼まれた"},
        { "location": "95/TALK"   , "narrator": "ガブリエラ", "text": "誰それ？"},
        { "location": "96/SEL"    , "narrator": "", "text": "逢瀬つばめのクラン"},
        { "location": "97/ACT"    , "narrator": "", "text": "逢瀬つばめのクラン"},
        { "location": "99/TALK"   , "narrator": "ガブリエラ", "text": "…何よそれ。"},
        { "location": "100/TALK"  , "narrator": "ガブリエラ", "text": "完全に出し抜かれてる\nじゃないの。"},
        { "location": "101/TALK"  , "narrator": "ガブリエラ", "text": "…聞きたくないけど\n聞くしかないわね。"},
        { "location": "102/TALK"  , "narrator": "ガブリエラ", "text": "あたしは\nフェノメノンの中で\n何をしていたの？"},
        { "location": "103/SEL"   , "narrator": "", "text": "フェノメノンの収束"},
        { "location": "104/SEL"   , "narrator": "", "text": "甘酸っぱく儚い恋と\n青春を謳歌してた"},
        { "location": "105/SEL"   , "narrator": "", "text": "アーヤが大好きすぎて\nやばい状態に"},
        { "location": "106/SEL"   , "narrator": "", "text": "$me$といちゃラブ"},
        { "location": "107/ACT"   , "narrator": "", "text": "フェノメノンの収束"},
        { "location": "108/TALK"  , "narrator": "ガブリエラ", "text": "フェノメノンの中で？\n何をしているんだか。"},
        { "location": "109/ACT"   , "narrator": "", "text": "甘酸っぱく儚い恋と\n青春を謳歌してた"},
        { "location": "110/TALK"  , "narrator": "ガブリエラ", "text": "あたしが？\nありえないわ。"},
        { "location": "111/ACT"   , "narrator": "", "text": "アーヤが大好きすぎて\nやばい状態に"},
        { "location": "112/TALK"  , "narrator": "ガブリエラ", "text": "…尊敬はしてるわ。\nでもそんなこと\n言われる筋合いはない。"},
        { "location": "113/ACT"   , "narrator": "", "text": "$me$といちゃラブ"},
        { "location": "114/TALK"  , "narrator": "ガブリエラ", "text": "本気で撃ち抜いて\nほしいみたいね。"},
        { "location": "116/TALK"  , "narrator": "ガブリエラ", "text": "あなた本部と関係ない\nみたいだから説明\nしておくわ。"},
        { "location": "117/TALK"  , "narrator": "ガブリエラ", "text": "あたし達は\nフェノム計画における\nキーパーソンなの。"},
        { "location": "118/TALK"  , "narrator": "ガブリエラ", "text": "ただし現時点では\n詳細は公に\nされていないわ。"},
        { "location": "119/TALK"  , "narrator": "ガブリエラ", "text": "あたし達、\n本部からは天使と\n呼ばれているけど。"},
        { "location": "120/TALK"  , "narrator": "ガブリエラ", "text": "その呼び名は\n皮肉なまでに\n正確すぎるわ。"},
        { "location": "121/TALK"  , "narrator": "ガブリエラ", "text": "あたし達に\n求められているのは\n天使の役割。"},
        { "location": "122/TALK"  , "narrator": "ガブリエラ", "text": "ただし聖書のままの\n無慈悲な天使\nそのままだけど。"},
        { "location": "123/TALK"  , "narrator": "ガブリエラ", "text": "法と秩序を守れない者は\n力を使って叩きつぶす。"},
        { "location": "124/TALK"  , "narrator": "ガブリエラ", "text": "どんな手を使っても\n秩序を乱す者を\n排除する。"},
        { "location": "125/TALK"  , "narrator": "ガブリエラ", "text": "忠実に正確に計画を\n推し進めることだけを\n考えるの。"},
        { "location": "126/TALK"  , "narrator": "ガブリエラ", "text": "フェノム計画自体は\n救済のための計画だと\nいうけれど。"},
        { "location": "127/TALK"  , "narrator": "ガブリエラ", "text": "それを実行する\nあたし達にそんな感情は\n不必要なものなの。"},
        { "location": "128/TALK"  , "narrator": "ガブリエラ", "text": "ただあたし達の\n存在なくして\nセカイに愛は訪れない。"},
        { "location": "129/TALK"  , "narrator": "ガブリエラ", "text": "だからあなたは\nあたしに協力すべき。"},
        { "location": "130/SEL"   , "narrator": "", "text": "ガブリエラのために\n協力する"},
        { "location": "131/SEL"   , "narrator": "", "text": "あなたは$me$の契る\nガブリエラではない"},
        { "location": "132/ACT"   , "narrator": "", "text": "ガブリエラのために\n協力する"},
        { "location": "134/ACT"   , "narrator": "", "text": "あなたは$me$の契る\nガブリエラではない"},
        { "location": "169/TALK"  , "narrator": "マルザンナ　", "text": "あっ！\n$handle$！！"},
        { "location": "170/TALK"  , "narrator": "マルザンナ　", "text": "よかった、来てくれて！"},
        { "location": "171/SEL"   , "narrator": "", "text": "どうしたの？"},
        { "location": "172/SEL"   , "narrator": "", "text": "リヴォルカは大丈夫？"},
        { "location": "173/ACT"   , "narrator": "", "text": "どうしたの？"},
        { "location": "174/TALK"  , "narrator": "マルザンナ　", "text": "それが、ちょっと\nリヴォルカのことで\nまた頼みがあって……"},
        { "location": "175/ACT"   , "narrator": "", "text": "リヴォルカは大丈夫？"},
        { "location": "176/TALK"  , "narrator": "マルザンナ　", "text": "ええ、お陰様で、\nいい感じに収束して\n元に戻りはしたわ。"},
        { "location": "177/TALK"  , "narrator": "マルザンナ　", "text": "けど、実はもう１つ\nあの子のことで\nして欲しいことがあって。"},
        { "location": "179/SEL"   , "narrator": "", "text": "また何か暴れてるの？"},
        { "location": "180/ACT"   , "narrator": "", "text": "また何か暴れてるの？"},
        { "location": "182/TALK"  , "narrator": "マルザンナ　", "text": "ううん。\nそういうわけじゃないの。"},
        { "location": "183/TALK"  , "narrator": "マルザンナ　", "text": "ていうか、むしろ逆？"},
        { "location": "184/TALK"  , "narrator": "マルザンナ　", "text": "この前リヴォルカを\n沈静化させてくれた\nでしょう？"},
        { "location": "185/TALK"  , "narrator": "マルザンナ　", "text": "あの後ずっと、\n泣いちゃってて。"},
        { "location": "186/SEL"   , "narrator": "", "text": "なんで？"},
        { "location": "187/SEL"   , "narrator": "", "text": "フッ…また泣かせてしまったか"},
        { "location": "188/ACT"   , "narrator": "", "text": "なんで？"},
        { "location": "189/TALK"  , "narrator": "マルザンナ　", "text": "あんたが\n泣かせたのよ。"},
        { "location": "190/ACT"   , "narrator": "", "text": "フッ…また泣かせてしまったか"},
        { "location": "191/TALK"  , "narrator": "マルザンナ　", "text": "また…って。\nあんた、あたし以外にも\n誰か泣かせてるわけ？"},
        { "location": "193/TALK"  , "narrator": "マルザンナ　", "text": "まあそんなわけだから\n最後まで責任もって\n慰めなさいよね。"},
        { "location": "194/SEL"   , "narrator": "", "text": "で、どんな理由なの"},
        { "location": "195/ACT"   , "narrator": "", "text": "で、どんな理由なの"},
        { "location": "197/TALK"  , "narrator": "マルザンナ　", "text": "前にも話してるけど、\nそもそもリヴォルカが\n暴れた原因はあんたなの。"},
        { "location": "198/TALK"  , "narrator": "マルザンナ　", "text": "急にWAVEアカウント\n消して音信不通に\nなっちゃうから。"},
        { "location": "199/SEL"   , "narrator": "", "text": "それ、$me$がやったわけじゃ……"},
        { "location": "200/SEL"   , "narrator": "", "text": "でも何でリヴォルカが？"},
        { "location": "201/ACT"   , "narrator": "", "text": "それ、$me$がやったわけじゃ……"},
        { "location": "202/TALK"  , "narrator": "マルザンナ　", "text": "乙女心が解らないのね。\n問題はそこじゃなくて、\nいなくなったことなの！"},
        { "location": "203/TALK"  , "narrator": "マルザンナ　", "text": "今から簡単に、彼女が\n何を司っている人格なのか\nお話するから。"},
        { "location": "204/ACT"   , "narrator": "", "text": "でも何でリヴォルカが？"},
        { "location": "205/TALK"  , "narrator": "マルザンナ　", "text": "前も言ったとおり、\n何か事件が起こったとき、\n特定人格が影響を受ける。"},
        { "location": "206/TALK"  , "narrator": "マルザンナ　", "text": "何故今回、彼女が\n影響を受けたのか、\n簡単に話すわね。"},
        { "location": "208/TALK"  , "narrator": "マルザンナ　", "text": "あの子はプライドと\n自信を司る人格よ。"},
        { "location": "209/TALK"  , "narrator": "マルザンナ　", "text": "でも、大昔にあった\nある事件で、少し\n歪んでしまったの。"},
        { "location": "210/TALK"  , "narrator": "マルザンナ　", "text": "本来はそのプライドや\n自信が、自分を高める\n事に役立ってたわ。"},
        { "location": "211/TALK"  , "narrator": "マルザンナ　", "text": "例えば、銃の命中率の\n高さは、その絶大なる\n自信のお陰。"},
        { "location": "212/TALK"  , "narrator": "マルザンナ　", "text": "けど、今は違う。"},
        { "location": "213/TALK"  , "narrator": "マルザンナ　", "text": "彼女のプライドと自信は\n高慢を演出するための\n大きな武器となっている。"},
        { "location": "214/TALK"  , "narrator": "マルザンナ　", "text": "自分は完璧で最高だという\n想いを武器にして、敢えて\n人を見下してみる。"},
        { "location": "215/TALK"  , "narrator": "マルザンナ　", "text": "そうすると相手も\n寄りつかず、自分も\n納得して一人になれる。"},
        { "location": "216/TALK"  , "narrator": "マルザンナ　", "text": "あたしは自分一人で\nやっていける。釣り合う\n人なんていない、って。"},
        { "location": "217/TALK"  , "narrator": "マルザンナ　", "text": "けどそれは、\n他人に対して傷つけて\nしまう事への怯え。"},
        { "location": "218/TALK"  , "narrator": "マルザンナ　", "text": "他人を傷つけてしまう\nという強迫観念は、\nあの事件で作られた。"},
        { "location": "219/SEL"   , "narrator": "", "text": "あの事件って…"},
        { "location": "220/ACT"   , "narrator": "", "text": "あの事件って…"},
        { "location": "222/TALK"  , "narrator": "マルザンナ　", "text": "……強盗事件よ。"},
        { "location": "223/TALK"  , "narrator": "マルザンナ　", "text": "さあ、これで\nわかったでしょう？"},
        { "location": "224/SEL"   , "narrator": "", "text": "いや、それと$me$との関係が全然わからないんですけど"},
        { "location": "225/ACT"   , "narrator": "", "text": "いや、それと$me$との関係が全然わからないんですけど"},
        { "location": "227/TALK"  , "narrator": "マルザンナ　", "text": "もうっ！\n鈍いわね！"},
        { "location": "228/TALK"  , "narrator": "マルザンナ　", "text": "だから、アレよ。"},
        { "location": "229/TALK"  , "narrator": "マルザンナ　", "text": "リヴォルカがあんたの\nことを豚だとか、飼うとか\n言ってたのは――"},
        { "location": "230/TALK"  , "narrator": "マルザンナ　", "text": "誰も寄せ付けないと決めた\n自分を騙しつつ、あんたと\n一緒にいる為の口実よ。"},
        { "location": "231/SEL"   , "narrator": "", "text": "合点がいった"},
        { "location": "232/SEL"   , "narrator": "", "text": "感動した！"},
        { "location": "233/SEL"   , "narrator": "", "text": "でもかなり拒絶されてたけど？"},
        { "location": "234/ACT"   , "narrator": "", "text": "合点がいった"},
        { "location": "235/TALK"  , "narrator": "マルザンナ　", "text": "よかったわ。"},
        { "location": "236/ACT"   , "narrator": "", "text": "感動した！"},
        { "location": "237/TALK"  , "narrator": "マルザンナ　", "text": "なんで！？"},
        { "location": "238/ACT"   , "narrator": "", "text": "でもかなり拒絶されてたけど？"},
        { "location": "239/TALK"  , "narrator": "マルザンナ　", "text": "だからそれは、あんたが\n何やっても離れないか\nどうか、試してたのよ。"},
        { "location": "241/TALK"  , "narrator": "マルザンナ　", "text": "ま、そんなわけだから、\nリヴォルカを元気づけ\nられるのはあんただけ。"},
        { "location": "242/TALK"  , "narrator": "マルザンナ　", "text": "さっさと\n行ってきて頂戴。"},
        { "location": "243/SEL"   , "narrator": "", "text": "なんか塩対応じゃない？"},
        { "location": "244/SEL"   , "narrator": "", "text": "もしかして嫉妬してる？"},
        { "location": "245/ACT"   , "narrator": "", "text": "なんか塩対応じゃない？"},
        { "location": "247/TALK"  , "narrator": "マルザンナ　", "text": "いいえ、普通よ。"},
        { "location": "250/TALK"  , "narrator": "マルザンナ　", "text": "き、気のせいよ！"},
        { "location": "252/TALK"  , "narrator": "マルザンナ　", "text": "さあ、早く\n行ってきて！"},
        { "location": "253/ACT"   , "narrator": "", "text": "もしかして嫉妬してる？"},
        { "location": "255/TALK"  , "narrator": "マルザンナ　", "text": "まさか。"},
        { "location": "256/TALK"  , "narrator": "マルザンナ　", "text": "ていうか、\nあんたあたしのこと\n侮辱したでしょ。"},
        { "location": "257/TALK"  , "narrator": "マルザンナ　", "text": "今更嫉妬とか\nないから。"},
        { "location": "258/TALK"  , "narrator": "マルザンナ　", "text": "はいはい、\n早く行ってきて。"},
        { "location": "260/TALK"  , "narrator": "マルザンナ　", "text": "そ、そんなわけ――"},
        { "location": "262/TALK"  , "narrator": "マルザンナ　", "text": "……。"},
        { "location": "263/TALK"  , "narrator": "マルザンナ　", "text": "……ある"},
        { "location": "264/TALK"  , "narrator": "マルザンナ　", "text": "から！\nだから早く解決して！"},
        { "location": "265/TALK"  , "narrator": "マルザンナ　", "text": "…そんで、\nあたしのところに\n戻って来てよね……もう！"},
        { "location": "282/TALK"  , "narrator": "リヴォルカ", "text": "…っ…えっ…\nえぐっ……"},
        { "location": "283/SEL"   , "narrator": "", "text": "リヴォルカ？"},
        { "location": "284/ACT"   , "narrator": "", "text": "リヴォルカ？"},
        { "location": "286/TALK"  , "narrator": "リヴォルカ", "text": "…っ！！"},
        { "location": "287/TALK"  , "narrator": "リヴォルカ", "text": "ちょ、ちょっと何よ！\n豚だからって勝手に\n入ってこないでよ！！"},
        { "location": "288/SEL"   , "narrator": "", "text": "ごめんね、急にいなくなったりして"},
        { "location": "289/SEL"   , "narrator": "", "text": "好きだ、結婚しよう！！"},
        { "location": "290/ACT"   , "narrator": "", "text": "ごめんね、急にいなくなったりして"},
        { "location": "291/TALK"  , "narrator": "リヴォルカ", "text": "はぁ？\n別に豚の一匹二匹いなく\nなったって何でもないわ。"},
        { "location": "292/ACT"   , "narrator": "", "text": "好きだ、結婚しよう！！"},
        { "location": "294/TALK"  , "narrator": "リヴォルカ", "text": "はぁぁぁ！？\nいきなり何\n言っちゃってるの！？"},
        { "location": "295/TALK"  , "narrator": "リヴォルカ", "text": "コミュ障なの！？"},
        { "location": "296/SEL"   , "narrator": "", "text": "あ、はい…実は……"},
        { "location": "297/SEL"   , "narrator": "", "text": "いや違うから"},
        { "location": "298/ACT"   , "narrator": "", "text": "あ、はい…実は……"},
        { "location": "299/TALK"  , "narrator": "リヴォルカ", "text": "はぁ……\nバカ正直過ぎでしょ。"},
        { "location": "300/TALK"  , "narrator": "リヴォルカ", "text": "もう、いいわよ。\nその正直さに免じて\n今回は許してやるわ。"},
        { "location": "302/ACT"   , "narrator": "", "text": "いや違うから"},
        { "location": "303/TALK"  , "narrator": "リヴォルカ", "text": "ふーん……\nまあいいけど。"},
        { "location": "304/TALK"  , "narrator": "リヴォルカ", "text": "ていうか！\n豚に求愛されたところで\n全然嬉しくないし。"},
        { "location": "308/SEL"   , "narrator": "", "text": "$me$は寂しかったです"},
        { "location": "309/SEL"   , "narrator": "", "text": "そんなこと言って寂しかったくせに。色々聞いたよ？"},
        { "location": "310/ACT"   , "narrator": "", "text": "$me$は寂しかったです"},
        { "location": "312/TALK"  , "narrator": "リヴォルカ", "text": "ばっ……"},
        { "location": "313/TALK"  , "narrator": "リヴォルカ", "text": "バッカじゃないの！？"},
        { "location": "314/TALK"  , "narrator": "リヴォルカ", "text": "前にも言ったでしょ。\n豚と人間は\n一緒になれないって。"},
        { "location": "315/ACT"   , "narrator": "", "text": "そんなこと言って寂しかったくせに。色々聞いたよ？"},
        { "location": "316/TALK"  , "narrator": "リヴォルカ", "text": "なにそれ！？\nふざけんな！"},
        { "location": "317/TALK"  , "narrator": "リヴォルカ", "text": "もうあんたなんて\n豚でも何でもないわ。\n塵以下の存在よ！"},
        { "location": "321/SEL"   , "narrator": "", "text": "素直になれよ"},
        { "location": "322/SEL"   , "narrator": "", "text": "じゃあ飼って"},
        { "location": "323/ACT"   , "narrator": "", "text": "素直になれよ"},
        { "location": "325/TALK"  , "narrator": "リヴォルカ", "text": "はぁ！？"},
        { "location": "327/ACT"   , "narrator": "", "text": "じゃあ飼って"},
        { "location": "328/TALK"  , "narrator": "リヴォルカ", "text": "自分から飼ってなんて\n言ってくるとか、\n頭おかしいんじゃない？"},
        { "location": "329/SEL"   , "narrator": "", "text": "それでリヴォルカが幸せになれるなら"},
        { "location": "330/SEL"   , "narrator": "", "text": "ブヒィィィィ！！"},
        { "location": "331/ACT"   , "narrator": "", "text": "それでリヴォルカが幸せになれるなら"},
        { "location": "333/TALK"  , "narrator": "リヴォルカ", "text": "……。\nなにそれ。\nあたしへの憐れみ！？"},
        { "location": "334/TALK"  , "narrator": "リヴォルカ", "text": "もういいわ。\nあんたなんか要らない！"},
        { "location": "336/ACT"   , "narrator": "", "text": "ブヒィィィィ！！"},
        { "location": "338/TALK"  , "narrator": "リヴォルカ", "text": "きゃああああ！！\n近寄るな！！"},
        { "location": "343/TALK"  , "narrator": "リヴォルカ", "text": "はぁ…はぁ…　…"},
        { "location": "344/TALK"  , "narrator": "リヴォルカ", "text": "いい加減にしないと、\n本気で怒るわよ！"},
        { "location": "345/SEL"   , "narrator": "", "text": "ご褒美です！！"},
        { "location": "346/SEL"   , "narrator": "", "text": "どうしてそんなに怒ってるの？"},
        { "location": "347/ACT"   , "narrator": "", "text": "ご褒美です！！"},
        { "location": "348/TALK"  , "narrator": "リヴォルカ", "text": "はぁぁ……\nだめだこりゃ。"},
        { "location": "349/TALK"  , "narrator": "リヴォルカ", "text": "もういいわ。\nあんたがあまりに滑稽で、\nどうでもよくなってきた。"},
        { "location": "350/TALK"  , "narrator": "リヴォルカ", "text": "丸焼きにするその日まで\n豚舎でブヒブヒ\n言ってなさい。"},
        { "location": "352/ACT"   , "narrator": "", "text": "どうしてそんなに怒ってるの？"},
        { "location": "353/TALK"  , "narrator": "リヴォルカ", "text": "……。\nあんたがあまりにも\n愚かな豚だからよ。"},
        { "location": "354/SEL"   , "narrator": "", "text": "リヴォルカだけの豚だよ"},
        { "location": "355/SEL"   , "narrator": "", "text": "タダの豚じゃないよ。リヴォルカのナイトだよ"},
        { "location": "356/ACT"   , "narrator": "", "text": "リヴォルカだけの豚だよ"},
        { "location": "357/TALK"  , "narrator": "リヴォルカ", "text": "そんなことは\nわかってるわよ。"},
        { "location": "358/TALK"  , "narrator": "リヴォルカ", "text": "あたし以外の豚やってたら\n即刻蜂の巣にして\n丸焼きにしてやるわ。"},
        { "location": "359/TALK"  , "narrator": "リヴォルカ", "text": "で？\nどうやって証明するわけ？"},
        { "location": "360/TALK"  , "narrator": "リヴォルカ", "text": "あたしだけの\n豚だってことを。"},
        { "location": "361/SEL"   , "narrator": "", "text": "忠誠を誓います！"},
        { "location": "362/ACT"   , "narrator": "", "text": "忠誠を誓います！"},
        { "location": "364/TALK"  , "narrator": "リヴォルカ", "text": "ちゅ…忠誠ですって！？"},
        { "location": "365/TALK"  , "narrator": "リヴォルカ", "text": "ええっと……\n忠誠を誓わせるのって\nどうすればいいのかしら。"},
        { "location": "367/ACT"   , "narrator": "", "text": "タダの豚じゃないよ。リヴォルカのナイトだよ"},
        { "location": "368/TALK"  , "narrator": "リヴォルカ", "text": "ナイトぉぉぉ！？"},
        { "location": "369/TALK"  , "narrator": "リヴォルカ", "text": "酷い寝言ね。\nぶん殴って\nあげましょうか？"},
        { "location": "370/SEL"   , "narrator": "", "text": "本気だって！"},
        { "location": "371/SEL"   , "narrator": "", "text": "豚のナイトだけに“ぶたないと！”！なんちゃってｗｗ"},
        { "location": "372/ACT"   , "narrator": "", "text": "本気だって！"},
        { "location": "373/TALK"  , "narrator": "リヴォルカ", "text": "ふーん……"},
        { "location": "374/TALK"  , "narrator": "リヴォルカ", "text": "それじゃ、その証を\n見せてみなさいよ。"},
        { "location": "375/TALK"  , "narrator": "リヴォルカ", "text": "ナイトなら、\n主人に対して忠誠を誓った\n証があるはずよ。"},
        { "location": "376/ACT"   , "narrator": "", "text": "豚のナイトだけに“ぶたないと！”！なんちゃってｗｗ"},
        { "location": "378/TALK"  , "narrator": "リヴォルカ", "text": "ぶっ………"},
        { "location": "379/TALK"  , "narrator": "リヴォルカ", "text": "……。"},
        { "location": "380/TALK"  , "narrator": "リヴォルカ", "text": "な、なによ。\n全然面白くなんか\nないんだから―――"},
        { "location": "381/TALK"  , "narrator": "リヴォルカ", "text": "ぶぶっ……"},
        { "location": "382/SEL"   , "narrator": "", "text": "笑った！\nリヴォルカが笑った！"},
        { "location": "383/SEL"   , "narrator": "", "text": "フッ…豚の冴え渡るギャグがお気に召したようだね"},
        { "location": "384/ACT"   , "narrator": "", "text": "笑った！\nリヴォルカが笑った！"},
        { "location": "385/TALK"  , "narrator": "リヴォルカ", "text": "いや、\n笑ってなんかないし！"},
        { "location": "386/ACT"   , "narrator": "", "text": "フッ…豚の冴え渡るギャグがお気に召したようだね"},
        { "location": "387/TALK"  , "narrator": "リヴォルカ", "text": "なんかキザなのか\n豚なのかわからなくて、\n頭おかしくなってくるわ。"},
        { "location": "389/TALK"  , "narrator": "リヴォルカ", "text": "……。"},
        { "location": "390/TALK"  , "narrator": "リヴォルカ", "text": "はぁ。もういい。"},
        { "location": "391/TALK"  , "narrator": "リヴォルカ", "text": "あんたが馬鹿なことばっか\n言ってるから、色々\nどうでも良くなってきた。"},
        { "location": "392/TALK"  , "narrator": "リヴォルカ", "text": "あんたがあたしの\nナイトになりたいなら、\n勝手になればいいわ。"},
        { "location": "393/TALK"  , "narrator": "リヴォルカ", "text": "でも、\n忠誠の誓いはしっかり\n立ててもらうから。"},
        { "location": "394/SEL"   , "narrator": "", "text": "どうやって？"},
        { "location": "395/ACT"   , "narrator": "", "text": "どうやって？"},
        { "location": "397/TALK"  , "narrator": "リヴォルカ", "text": "えっ！？"},
        { "location": "398/TALK"  , "narrator": "リヴォルカ", "text": "…う、ううん……\nそうね……。"},
        { "location": "401/SEL"   , "narrator": "", "text": "ココロの中にあるよ、お見せできなくて残念！"},
        { "location": "402/SEL"   , "narrator": "", "text": "今こそ忠誠の誓いを立てます"},
        { "location": "403/ACT"   , "narrator": "", "text": "ココロの中にあるよ、お見せできなくて残念！"},
        { "location": "404/TALK"  , "narrator": "リヴォルカ", "text": "ふざけんな！"},
        { "location": "406/ACT"   , "narrator": "", "text": "今こそ忠誠の誓いを立てます"},
        { "location": "407/TALK"  , "narrator": "リヴォルカ", "text": "どうやって？"},
        { "location": "409/SEL"   , "narrator": "", "text": "キスで"},
        { "location": "410/SEL"   , "narrator": "", "text": "踏みつけていただくことで"},
        { "location": "411/ACT"   , "narrator": "", "text": "キスで"},
        { "location": "412/TALK"  , "narrator": "リヴォルカ", "text": "自惚れるな！！"},
        { "location": "414/ACT"   , "narrator": "", "text": "踏みつけていただくことで"},
        { "location": "415/TALK"  , "narrator": "リヴォルカ", "text": "はぁぁ……。\n頭痛くなってきたわ。"},
        { "location": "417/SEL"   , "narrator": "", "text": "本気だブヒ！"},
        { "location": "418/ACT"   , "narrator": "", "text": "本気だブヒ！"},
        { "location": "420/TALK"  , "narrator": "リヴォルカ", "text": "もういい、\nわかった、わかったわよ。"},
        { "location": "421/TALK"  , "narrator": "リヴォルカ", "text": "けど、踏んづけるなんて\n生ぬるいし、ちっとも\nエレガントじゃないわ。"},
        { "location": "422/SEL"   , "narrator": "", "text": "では、仰せのままに"},
        { "location": "423/ACT"   , "narrator": "", "text": "では、仰せのままに"},
        { "location": "425/TALK"  , "narrator": "リヴォルカ", "text": "そ、そうね……。"},
        { "location": "427/TALK"  , "narrator": "リヴォルカ", "text": "やっぱり\nお姫様への忠誠といえば\n手の甲にキス……？"},
        { "location": "428/TALK"  , "narrator": "リヴォルカ", "text": "いやぁぁぁ……\n恥ずかしくて\nそんなの無理よ……。"},
        { "location": "429/TALK"  , "narrator": "リヴォルカ", "text": "けどやっぱり、\nキス以外じゃ全然\nエレガントじゃないし……"},
        { "location": "430/TALK"  , "narrator": "リヴォルカ", "text": "そ、そうだわ！"},
        { "location": "431/TALK"  , "narrator": "リヴォルカ", "text": "豚ごときに手の甲なんて\n贅沢すぎるのよ。"},
        { "location": "432/TALK"  , "narrator": "リヴォルカ", "text": "豚なんて、お腹で十分！\nさあ、あたしのお腹に\n忠誠のキスをなさい！"},
        { "location": "433/SEL"   , "narrator": "", "text": "ブ…ヒ……"},
        { "location": "434/SEL"   , "narrator": "", "text": "え！？　…ちょっと、それマジなの？"},
        { "location": "435/ACT"   , "narrator": "", "text": "ブ…ヒ……"},
        { "location": "436/ACT"   , "narrator": "", "text": "え！？　…ちょっと、それマジなの？"},
        { "location": "438/TALK"  , "narrator": "リヴォルカ", "text": "あら、なあに？\nやっぱり屈辱的過ぎて\n出来ないのかしら？"},
        { "location": "439/TALK"  , "narrator": "リヴォルカ", "text": "そんなことで、\nよくあたしに忠――"},
        { "location": "440/SEL"   , "narrator": "", "text": "ブヒィィィィィィィィィィィィィィィィィィィィィィィィ！！"},
        { "location": "441/ACT"   , "narrator": "", "text": "ブヒィィィィィィィィィィィィィィィィィィィィィィィィ！！"},
        { "location": "444/TALK"  , "narrator": "リヴォルカ", "text": "きゃあああああっ！！"},
        { "location": "459/TALK"  , "narrator": "リヴォルカ", "text": "ひゃあああああっ！！\nちょっとあんた！\n今舐めたでしょ！！"},
        { "location": "464/TALK"  , "narrator": "リヴォルカ", "text": "やあああっ！\nそ、そんなに\nがっつかないで！！"},
        { "location": "469/TALK"  , "narrator": "リヴォルカ", "text": "ひゃあああああっ！！\nちょっとあんた！\n今舐めたでしょ！！"},
        { "location": "474/TALK"  , "narrator": "リヴォルカ", "text": "やあああっ！\nそ、そんなに\nがっつかないで！！"},
        { "location": "481/TALK"  , "narrator": "リヴォルカ", "text": "はぁ……はぁ……"},
        { "location": "482/SEL"   , "narrator": "", "text": "もう１回いっとく"},
        { "location": "483/SEL"   , "narrator": "", "text": "誓いは立てた"},
        { "location": "484/ACT"   , "narrator": "", "text": "もう１回いっとく"},
        { "location": "489/TALK"  , "narrator": "リヴォルカ", "text": "ちょっ！！！"},
        { "location": "491/ACT"   , "narrator": "", "text": "誓いは立てた"},
        { "location": "493/TALK"  , "narrator": "リヴォルカ", "text": "もーっ！！\nやりすぎよ！！"},
        { "location": "494/TALK"  , "narrator": "リヴォルカ", "text": "もっとエレガントに\nやりなさいよ！！\nバカバカバカ！！"},
        { "location": "495/SEL"   , "narrator": "", "text": "リヴォルカがあまりに可愛かったので"},
        { "location": "496/SEL"   , "narrator": "", "text": "濃厚な誓いを立てるべく精進いたしました"},
        { "location": "497/ACT"   , "narrator": "", "text": "リヴォルカがあまりに可愛かったので"},
        { "location": "498/TALK"  , "narrator": "リヴォルカ", "text": "うぅぅ……っ…"},
        { "location": "499/ACT"   , "narrator": "", "text": "濃厚な誓いを立てるべく精進いたしました"},
        { "location": "500/TALK"  , "narrator": "リヴォルカ", "text": "な、なによ、\n濃厚な誓いって！！"},
        { "location": "502/TALK"  , "narrator": "リヴォルカ", "text": "はぁ…まったく。\n所詮豚は豚ってことよね。"},
        { "location": "503/TALK"  , "narrator": "リヴォルカ", "text": "まあいいわ。\nこれで忠誠の儀は\n終わったわけだし。"},
        { "location": "504/TALK"  , "narrator": "リヴォルカ", "text": "あんたは\nあたしだけの豚よ。\nわかってる？"},
        { "location": "505/SEL"   , "narrator": "", "text": "ブヒ！"},
        { "location": "506/SEL"   , "narrator": "", "text": "もちろんですよ姫"},
        { "location": "507/ACT"   , "narrator": "", "text": "ブヒ！"},
        { "location": "508/TALK"  , "narrator": "リヴォルカ", "text": "……。"},
        { "location": "509/TALK"  , "narrator": "リヴォルカ", "text": "ホントに\nわかってるのかしら。"},
        { "location": "510/ACT"   , "narrator": "", "text": "もちろんですよ姫"},
        { "location": "511/TALK"  , "narrator": "リヴォルカ", "text": "……。"},
        { "location": "512/TALK"  , "narrator": "リヴォルカ", "text": "何よ、\n急にカッコつけちゃって。"},
        { "location": "514/TALK"  , "narrator": "リヴォルカ", "text": "まあいいわ。"},
        { "location": "516/TALK"  , "narrator": "リヴォルカ", "text": "出会い頭に\n$chap31_ch03_buhi$回もブヒった奴に\n期待しても仕方ないし。"},
        { "location": "518/TALK"  , "narrator": "リヴォルカ", "text": "あんたがあまりに\nバカすぎて、色々\nどうでもよくなってきた。"},
        { "location": "519/SEL"   , "narrator": "", "text": "元気になってよかった"},
        { "location": "520/SEL"   , "narrator": "", "text": "だろ～～"},
        { "location": "521/ACT"   , "narrator": "", "text": "元気になってよかった"},
        { "location": "522/TALK"  , "narrator": "リヴォルカ", "text": "あ、あたしは元々\n元気だったから……。"},
        { "location": "523/ACT"   , "narrator": "", "text": "だろ～～"},
        { "location": "524/TALK"  , "narrator": "リヴォルカ", "text": "なによ、その\nバカにしたような\n口ぶりは……。"},
        { "location": "526/TALK"  , "narrator": "リヴォルカ", "text": "……で、も………"},
        { "location": "527/TALK"  , "narrator": "リヴォルカ", "text": "……"},
        { "location": "528/TALK"  , "narrator": "リヴォルカ", "text": "あ"},
        { "location": "529/TALK"  , "narrator": "リヴォルカ", "text": "……あり…がと。"},
        { "location": "534/TALK"  , "narrator": "リヴォルカ", "text": "ほら！\nあたしの豚！！"},
        { "location": "535/TALK"  , "narrator": "リヴォルカ", "text": "とっとと行くわよ！！"},
        { "location": "536/SEL"   , "narrator": "", "text": "どこへ？"},
        { "location": "537/SEL"   , "narrator": "", "text": "ブヒ？"},
        { "location": "538/ACT"   , "narrator": "", "text": "どこへ？"},
        { "location": "539/ACT"   , "narrator": "", "text": "ブヒ？"},
        { "location": "541/TALK"  , "narrator": "リヴォルカ", "text": "マークスマンの所よ。\n今大変なことに\nなっちゃってるんだから！"},
        { "location": "542/TALK"  , "narrator": "リヴォルカ", "text": "まったく。\nあんたがドン臭いお陰で\n時間使っちゃったわ。"},
        { "location": "543/SEL"   , "narrator": "", "text": "リヴォルカ"},
        { "location": "544/ACT"   , "narrator": "", "text": "リヴォルカ"},
        { "location": "547/TALK"  , "narrator": "リヴォルカ", "text": "……なによ。"},
        { "location": "548/SEL"   , "narrator": "", "text": "元気になって良かった"},
        { "location": "549/SEL"   , "narrator": "", "text": "愛してるよ"},
        { "location": "550/ACT"   , "narrator": "", "text": "元気になって良かった"},
        { "location": "551/TALK"  , "narrator": "リヴォルカ", "text": "……。"},
        { "location": "552/TALK"  , "narrator": "リヴォルカ", "text": "あんたに呆れて\n泣く気力も\n無くなっただけよ……。"},
        { "location": "553/ACT"   , "narrator": "", "text": "愛してるよ"},
        { "location": "555/TALK"  , "narrator": "リヴォルカ", "text": "ばっ………"},
        { "location": "556/TALK"  , "narrator": "リヴォルカ", "text": "バッカじゃないの！？"},
        { "location": "557/TALK"  , "narrator": "リヴォルカ", "text": "ほら！！\nさっさと行くわよ豚！！"},
        { "location": "582/TALK"  , "narrator": "マルザンナ　", "text": "マークスマン。"},
        { "location": "583/TALK"  , "narrator": "リヴォルカ", "text": "ちょっと大変なの！"},
        { "location": "584/TALK"  , "narrator": "マークスマン", "text": "どうした、\n二人して騒々しい。"},
        { "location": "585/TALK"  , "narrator": "マルザンナ　", "text": "知ってるかもしれないけど\n現実とフェノメノンの\n記憶が入り乱れてるの。"},
        { "location": "586/TALK"  , "narrator": "リヴォルカ", "text": "このままだと、\n気が変になっちゃうかも\nしれないわね。"},
        { "location": "587/TALK"  , "narrator": "マークスマン", "text": "その事か、\n案ずるな。"},
        { "location": "588/TALK"  , "narrator": "マークスマン", "text": "昇華しフェノメノンを\n発症すれば、それは\n問題にはならなくなる。"},
        { "location": "589/TALK"  , "narrator": "マルザンナ　", "text": "……。"},
        { "location": "590/TALK"  , "narrator": "リヴォルカ", "text": "ま、やっぱりそうよね。\n早くフェノメノンを\n生み出すのが一番なのよ。"},
        { "location": "592/SEL"   , "narrator": "", "text": "マークスマンが発症すれば、記憶の混濁は無くなるの？"},
        { "location": "593/ACT"   , "narrator": "", "text": "マークスマンが発症すれば、記憶の混濁は無くなるの？"},
        { "location": "595/TALK"  , "narrator": "マークスマン", "text": "その通り。"},
        { "location": "596/TALK"  , "narrator": "マークスマン", "text": "フェノメノンを纏い、\n世界となることが出来れば\n全てを俯瞰出来る。"},
        { "location": "597/TALK"  , "narrator": "マークスマン", "text": "すなわち、自らの置かれた\n２つの世界も、それを\n超越した視点で傍観可能。"},
        { "location": "598/TALK"  , "narrator": "マークスマン", "text": "よって、まったく\n問題は生じなくなる。"},
        { "location": "599/TALK"  , "narrator": "リヴォルカ", "text": "やっぱり\n発症を急ぐ必要が\nあるわね。"},
        { "location": "601/TALK"  , "narrator": "マルザンナ　", "text": "ちょっ…\nちょっと待って！！"},
        { "location": "602/TALK"  , "narrator": "マルザンナ　", "text": "発症してフェノメノンに\nなってしまったら、\n失う物だってあるのよ。"},
        { "location": "603/TALK"  , "narrator": "マルザンナ　", "text": "あたしは断固\n阻止するから！！"},
        { "location": "605/TALK"  , "narrator": "リヴォルカ", "text": "でも多分、この場にいる\n中では、あんただけが\n反対派なのよね。"},
        { "location": "607/TALK"  , "narrator": "マルザンナ　", "text": "うっ……"},
        { "location": "610/TALK"  , "narrator": "マルザンナ　", "text": "$handle$も……？"},
        { "location": "611/SEL"   , "narrator": "", "text": "もちろん発症推進派です"},
        { "location": "612/SEL"   , "narrator": "", "text": "まあ、強いて言えば……"},
        { "location": "613/ACT"   , "narrator": "", "text": "もちろん発症推進派です"},
        { "location": "615/TALK"  , "narrator": "マルザンナ　", "text": "そう……。\n前とは考え方が\n変わっちゃったのね。"},
        { "location": "617/TALK"  , "narrator": "マルザンナ　", "text": "そういえば、\nあんたはそうだったわね。"},
        { "location": "619/ACT"   , "narrator": "", "text": "まあ、強いて言えば……"},
        { "location": "620/TALK"  , "narrator": "マルザンナ　", "text": "強いて言わなければ\n発症反対の気持ちも\nあるってことよね！？"},
        { "location": "622/TALK"  , "narrator": "マルザンナ　", "text": "……ねえ、\nもう少し落ち着いて\n考えましょうよ。"},
        { "location": "624/TALK"  , "narrator": "マルザンナ　", "text": "ねえ――"},
        { "location": "625/TALK"  , "narrator": "マークスマン", "text": "観念しろ、マルザンナ。"},
        { "location": "627/TALK"  , "narrator": "マークスマン", "text": "これはお前が知らない\n本当の私が約束した\nことなんだ。"},
        { "location": "628/TALK"  , "narrator": "マークスマン", "text": "例え今、私が心変わり\nしたとしても、止めるべき\nことではない。"},
        { "location": "629/TALK"  , "narrator": "リヴォルカ", "text": "ま、そういうことね！"},
        { "location": "630/TALK"  , "narrator": "マルザンナ　", "text": "……。"},
        { "location": "631/TALK"  , "narrator": "マルザンナ　", "text": "それでも。"},
        { "location": "632/TALK"  , "narrator": "マルザンナ　", "text": "それでもあたしは、\n今の自分が好き。"},
        { "location": "633/TALK"  , "narrator": "マルザンナ　", "text": "だから、最後まで――"},
        { "location": "634/TALK"  , "narrator": "マルザンナ　", "text": "命を賭けても\n今のあたしを守り抜く！"},
        { "location": "635/TALK"  , "narrator": "マークスマン", "text": "！？"},
        { "location": "636/TALK"  , "narrator": "リヴォルカ", "text": "ちょ、ちょっと！\nなんか嫌な予感が\nするんですけど！！"},
        { "location": "638/TALK"  , "narrator": "マークスマン", "text": "……。"},
        { "location": "639/TALK"  , "narrator": "マークスマン", "text": "ちょっと待て。\n種はどうした。"},
        { "location": "640/TALK"  , "narrator": "リヴォルカ", "text": "え？\n種……？"},
        { "location": "641/TALK"  , "narrator": "リヴォルカ", "text": "………。"},
        { "location": "642/TALK"  , "narrator": "リヴォルカ", "text": "ああああっ！！！\nない！！"},
        { "location": "643/TALK"  , "narrator": "リヴォルカ", "text": "ない！！"},
        { "location": "644/TALK"  , "narrator": "リヴォルカ", "text": "種が無くなってる！！"},
        { "location": "645/TALK"  , "narrator": "マルザンナ　", "text": "え？\nなに？\nどういうこと！？"},
        { "location": "647/TALK"  , "narrator": "リヴォルカ", "text": "おいちょっと豚！！\nあたしに何したのよ！"},
        { "location": "649/SEL"   , "narrator": "", "text": "何もしてないし"},
        { "location": "650/ACT"   , "narrator": "", "text": "何もしてないし"},
        { "location": "652/TALK"  , "narrator": "リヴォルカ", "text": "前回あたしと\n戦ったでしょ！"},
        { "location": "653/TALK"  , "narrator": "リヴォルカ", "text": "その時に\n種壊してない！？"},
        { "location": "654/TALK"  , "narrator": "マークスマン", "text": "あり得るな。"},
        { "location": "655/TALK"  , "narrator": "マークスマン", "text": "$handle$よ。\nお前の意見は。"},
        { "location": "656/SEL"   , "narrator": "", "text": "ガブリエラのフェノメノン発症は賛同できません"},
        { "location": "657/ACT"   , "narrator": "", "text": "ガブリエラのフェノメノン発症は賛同できません"},
        { "location": "660/TALK"  , "narrator": "マルザンナ　", "text": "あ、あら？\n前もそうだったかしら？\nまあいいわ……。"},
        { "location": "662/TALK"  , "narrator": "マークスマン", "text": "であれば、\nその想いが種を\n叩きつぶしたのだろう。"},
        { "location": "663/TALK"  , "narrator": "リヴォルカ", "text": "何て事を！！\nあんた、一生恨むから！"},
        { "location": "664/TALK"  , "narrator": "マルザンナ　", "text": "ま、まあまあ。\nでも…た、種がなくちゃ\n仕方ないわよね！"},
        { "location": "665/TALK"  , "narrator": "マルザンナ　", "text": "フェノメノンを\n生成するのは、もう少し\n落ち着いて考えれば――"},
        { "location": "666/TALK"  , "narrator": "マークスマン", "text": "いや、その必要は無い。"},
        { "location": "669/TALK"  , "narrator": "マルザンナ　", "text": "えっ！？"},
        { "location": "670/TALK"  , "narrator": "マークスマン", "text": "種の代わりに、私の\n精神力をより一層\n研ぎ澄ませばいいだけ。"},
        { "location": "671/TALK"  , "narrator": "リヴォルカ", "text": "そうよ！\nマークスマンは\n誇れるあたしそのもの！"},
        { "location": "672/TALK"  , "narrator": "リヴォルカ", "text": "種なんてなくたって\nフェノメノンを\n展開できるわよね！"},
        { "location": "673/TALK"  , "narrator": "マルザンナ　", "text": "ちょ、ちょっと待って！\nそれ本気なの！？"},
        { "location": "674/TALK"  , "narrator": "マルザンナ　", "text": "もうちょっと落ち着いて\n考えましょうよ、ね？"},
        { "location": "675/TALK"  , "narrator": "マークスマン", "text": "ああ、うるさい。\n集中できないではないか。"},
        { "location": "676/TALK"  , "narrator": "マークスマン", "text": "実現性について\n少し考えたい。"},
        { "location": "677/TALK"  , "narrator": "マークスマン", "text": "時間をくれないか。"},
        { "location": "678/TALK"  , "narrator": "マルザンナ　", "text": "あ、はい！"},
        { "location": "679/TALK"  , "narrator": "リヴォルカ", "text": "もちろんよ！"},
        { "location": "680/TALK"  , "narrator": "マークスマン", "text": "$handle$もな。\nしばしの休息だ。"},
        { "location": "707/TALK"  , "narrator": "マルザンナ　", "text": "……もう、\n何やってるのよ。"},
        { "location": "708/TALK"  , "narrator": "マルザンナ　", "text": "ちゃんと真面目に\nやってよね！！"},
        { "location": "709/TALK"  , "narrator": "マルザンナ　", "text": "はい、もう一度\n行ってきて頂戴！"},
        { "location": "22/DIALOG" , "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:Interrupt】</color>\nSystem Interrupted.\n\n必須選択肢が選ばれていません。\n\n<color=green>『STORY27：シン・カグラ』</color>\nにて、選択を行ってから\n再度アクセスしてください。\n"},
        { "location": "26/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>-月--日　 -:-- --</color>\nNull"},
