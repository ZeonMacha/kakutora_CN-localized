    "entry":
    [
        { "location": "88/SCENARIO", "narrator": "", "text": "012_クライシス・クライシス"},
        { "location": "114/TALK"   , "narrator": "ガブリエラ", "text": "ねえマルザンナ"},
        { "location": "115/TALK"   , "narrator": "ガブリエラ", "text": "私、ついに観てしまったのよ"},
        { "location": "116/TALK"   , "narrator": "ガブリエラ", "text": "クライシス・ジュピターを！"},
        { "location": "118/SEL"    , "narrator": "", "text": "楽しかった？"},
        { "location": "119/SEL"    , "narrator": "", "text": "過激なシーンあった？"},
        { "location": "120/SEL"    , "narrator": "", "text": "悪いことした気分？"},
        { "location": "121/ACT"    , "narrator": "", "text": "楽しかった？"},
        { "location": "122/TALK"   , "narrator": "ガブリエラ", "text": "それがね"},
        { "location": "123/TALK"   , "narrator": "ガブリエラ", "text": "ドキドキしてしまってあんまり頭に入らなかったの"},
        { "location": "124/TALK"   , "narrator": "ガブリエラ", "text": "あ"},
        { "location": "125/TALK"   , "narrator": "ガブリエラ", "text": "その、えっちなシーンとかじゃなくて/////"},
        { "location": "126/TALK"   , "narrator": "ガブリエラ", "text": "悪いことしてるって意味でよ/////////////////"},
        { "location": "127/TALK"   , "narrator": "ガブリエラ", "text": "勘違いしないで頂戴ね！"},
        { "location": "128/ACT"    , "narrator": "", "text": "過激なシーンあった？"},
        { "location": "129/TALK"   , "narrator": "ガブリエラ", "text": "過激ってえっちなのとかって意味よね////////////////"},
        { "location": "130/TALK"   , "narrator": "ガブリエラ", "text": "そういうのはなかったわよ！？！？！"},
        { "location": "132/TALK"   , "narrator": "ガブリエラ", "text": "でも本当にそういうのもなくて"},
        { "location": "134/TALK"   , "narrator": "ガブリエラ", "text": "時々夜中のアニメでびっくりするのとか見るけど"},
        { "location": "135/TALK"   , "narrator": "ガブリエラ", "text": "あっちの方がよくないと思うのよ"},
        { "location": "136/TALK"   , "narrator": "ガブリエラ", "text": "どうしてポーランドではレイティングされてたのかしらね？"},
        { "location": "137/ACT"    , "narrator": "", "text": "悪いことした気分？"},
        { "location": "139/TALK"   , "narrator": "ガブリエラ", "text": "悪いことなんてしてないわ"},
        { "location": "140/TALK"   , "narrator": "ガブリエラ", "text": "だって日本じゃレイティングの指定はないもの"},
        { "location": "142/TALK"   , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "143/TALK"   , "narrator": "ガブリエラ", "text": "ちょっとだけ"},
        { "location": "144/TALK"   , "narrator": "ガブリエラ", "text": "悪い子になった気分よ"},
        { "location": "146/SEL"    , "narrator": "", "text": "ガブは不良だね"},
        { "location": "147/SEL"    , "narrator": "", "text": "よしよし、いい子いい子"},
        { "location": "148/ACT"    , "narrator": "", "text": "ガブは不良だね"},
        { "location": "149/TALK"   , "narrator": "ガブリエラ", "text": "不良なんかじゃないわ"},
        { "location": "150/TALK"   , "narrator": "ガブリエラ", "text": "ないったら！"},
        { "location": "151/ACT"    , "narrator": "", "text": "よしよし、いい子いい子"},
        { "location": "153/TALK"   , "narrator": "ガブリエラ", "text": "うん"},
        { "location": "154/TALK"   , "narrator": "ガブリエラ", "text": "やっぱり私悪いことしてないわよね"},
        { "location": "155/TALK"   , "narrator": "ガブリエラ", "text": "よかったわ"}
    ]
}
