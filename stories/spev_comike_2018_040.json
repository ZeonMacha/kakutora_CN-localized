{
    "dir": "chap00/daydra/spev_comike_2018_040.js",
    "type": "",
    "info": {
        "story_id": "91074",
        "cid": "",
        "title": "がすとちゃんサマー大作戦♪",
        "sub_title": "作戦４：オモテウラ拡張のご案内"
    },
    "entry":
    [
        { "location": "969/SCENARIO", "narrator": "", "text": "ウラオモテ"},
        { "location": "1018/TALK"   , "narrator": "がすとちゃん", "text": "アイルビーバック！\nですの！"},
        { "location": "1023/TALK"   , "narrator": "がすとちゃん", "text": "皆さんの声に応えて\nまたしても登場する\nがすとちゃんですの。"},
        { "location": "1028/TALK"   , "narrator": "がすとちゃん", "text": "今回もまた、\n夏の一大イベント情報を\nお届けするですのー！"},
        { "location": "1030/TALK"   , "narrator": "がすとちゃん", "text": "$handle$も、\n全力でレジに並ぶ準備は\nできてるですの？"},
        { "location": "1031/SEL"    , "narrator": "（選択肢）", "text": "言われなくとも"},
        { "location": "1032/SEL"    , "narrator": "（選択肢）", "text": "出たな守銭奴！"},
        { "location": "1033/SEL"    , "narrator": "（選択肢）", "text": "レジに行くとお前ボコれるの？"},
        { "location": "1034/ACT"    , "narrator": "", "text": "言われなくとも"},
        { "location": "1036/TALK"   , "narrator": "がすとちゃん", "text": "それでこそ\nがすとが見込んだ\n$handle$ですの。"},
        { "location": "1037/TALK"   , "narrator": "がすとちゃん", "text": "こちらも全力で\n$handle$の\nお越しを待ってるですの！"},
        { "location": "1038/ACT"    , "narrator": "", "text": "出たな守銭奴！"},
        { "location": "1056/TALK"   , "narrator": "がすとちゃん", "text": "だーかーらー！\n純粋な商売人に向かって\n守銭奴とは何ですの！！"},
        { "location": "1057/TALK"   , "narrator": "がすとちゃん", "text": "がすとは皆さんの\nハッピーな散財を\n願っているだけですの。"},
        { "location": "1058/ACT"    , "narrator": "", "text": "レジに行くとお前ボコれるの？"},
        { "location": "1068/TALK"   , "narrator": "がすとちゃん", "text": "おっ、やるですの？"},
        { "location": "1069/TALK"   , "narrator": "がすとちゃん", "text": "$handle$は\nもしかしたら\n知らないかもですけど──"},
        { "location": "1070/TALK"   , "narrator": "がすとちゃん", "text": "じつは超ド級の強さを誇る\nがすとちゃんに向かって\nいい度胸してるですの。"},
        { "location": "1072/TALK"   , "narrator": "がすとちゃん", "text": "レジで会えたら\n真心込めてお相手する\nですの！！"},
        { "location": "1075/TALK"   , "narrator": "がすとちゃん", "text": "…というわけで、\nさっそく今回の商品を\n紹介するですの。"},
        { "location": "1078/DIALOG" , "narrator": "", "text": "オモテウラ拡張グッズセット"},
        { "location": "1081/TALK"   , "narrator": "がすとちゃん", "text": "はい、ジャジャーン！"},
        { "location": "1082/TALK"   , "narrator": "がすとちゃん", "text": "「トライナリーの\nオモテウラ拡張グッズ\nセット」ですの！！"},
        { "location": "1084/TALK"   , "narrator": "がすとちゃん", "text": "これも、前回紹介した\n『ソラノキヲク』の\n異世界限定版と同様──"},
        { "location": "1085/TALK"   , "narrator": "がすとちゃん", "text": "KADOKAWAブースで\n販売される新商品ですの。"},
        { "location": "1086/TALK"   , "narrator": "がすとちゃん", "text": "コーエーテクモゲームスの\nブースでは売ってないから\n注意してほしいですの。"},
        { "location": "1087/TALK"   , "narrator": "がすとちゃん", "text": "内容は、\nオモテウラ拡張グッズ\nという名前の通り…"},
        { "location": "1089/TALK"   , "narrator": "がすとちゃん", "text": "トライナリーの\n表と裏が見れちゃう\nグッズのセットですの。"},
        { "location": "1095/DIALOG" , "narrator": "", "text": "日めくりカレンダー"},
        { "location": "1097/TALK"   , "narrator": "がすとちゃん", "text": "表のグッズは、\nヒロインのコメント入り\n日めくりカレンダー！"},
        { "location": "1098/TALK"   , "narrator": "がすとちゃん", "text": "月の始まりから終わりまで\nヒロインのメッセージや\nイラストが拝めるですの。"},
        { "location": "1100/TALK"   , "narrator": "がすとちゃん", "text": "これを毎日めくって、\n日々の元気を貰うですの♪"},
        { "location": "1101/TALK"   , "narrator": "がすとちゃん", "text": "表紙と、締めくくりの\n31日のイラストも\n描き下ろしですから──"},
        { "location": "1102/TALK"   , "narrator": "がすとちゃん", "text": "そこに書かれている\nメッセージとあわせて\n現物を要チェックですの！"},
        { "location": "1108/SEL"    , "narrator": "（選択肢）", "text": "ちょっと見せてよ"},
        { "location": "1109/ACT"    , "narrator": "", "text": "ちょっと見せてよ"},
        { "location": "1119/TALK"   , "narrator": "がすとちゃん", "text": "ダメですの。"},
        { "location": "1120/TALK"   , "narrator": "がすとちゃん", "text": "がすとはそういう\n無益なネタバレは\nしないですの。"},
        { "location": "1123/TALK"   , "narrator": "がすとちゃん", "text": "そして、\n裏側のグッズがこちら！"},
        { "location": "1129/DIALOG" , "narrator": "", "text": "初期設定内部資料・裏"},
        { "location": "1131/TALK"   , "narrator": "がすとちゃん", "text": "ジャジャーン！！"},
        { "location": "1132/TALK"   , "narrator": "がすとちゃん", "text": "拡張少女系トライナリー\n初期設定内部資料・裏\nですの♪"},
        { "location": "1134/TALK"   , "narrator": "がすとちゃん", "text": "トライナリーの裏情報が\nたっぷり入ってる\n1冊ですから──"},
        { "location": "1135/TALK"   , "narrator": "がすとちゃん", "text": "読めば更なる深淵に\n引き込まれること\n必至らしいですの！"},
        { "location": "1141/SEL"    , "narrator": "（選択肢）", "text": "中身を見せて！"},
        { "location": "1142/SEL"    , "narrator": "（選択肢）", "text": "「必至らしい」って適当だな…"},
        { "location": "1143/ACT"    , "narrator": "", "text": "中身を見せて！"},
        { "location": "1157/TALK"   , "narrator": "がすとちゃん", "text": "だからダメですの。"},
        { "location": "1158/TALK"   , "narrator": "がすとちゃん", "text": "どのページを見ても\nがすとには難しくて理解\nできなかったですけど…"},
        { "location": "1159/TALK"   , "narrator": "がすとちゃん", "text": "どのページも\n迂闊に晒すとヤバそうな\n雰囲気を感じたですの。"},
        { "location": "1160/ACT"    , "narrator": "", "text": "「必至らしい」って適当だな…"},
        { "location": "1162/TALK"   , "narrator": "がすとちゃん", "text": "仕方ないですの。"},
        { "location": "1163/TALK"   , "narrator": "がすとちゃん", "text": "がすとには\n詳しいことは分からない\nですけど…"},
        { "location": "1164/TALK"   , "narrator": "がすとちゃん", "text": "普段はbotをやっている\nとある関係者さんが\n裏の資料を見て、"},
        { "location": "1186/TALK"   , "narrator": "がすとちゃん", "text": "フギャァアーーー！！！"},
        { "location": "1188/TALK"   , "narrator": "がすとちゃん", "text": "…って\n叫んでたらしいですの。"},
        { "location": "1191/TALK"   , "narrator": "がすとちゃん", "text": "あー怖いコワい、ですの。"},
        { "location": "1192/TALK"   , "narrator": "がすとちゃん", "text": "あ、でも。"},
        { "location": "1194/TALK"   , "narrator": "がすとちゃん", "text": "いちおう補足しておくと、\n裏情報とは言っても\n「初期設定」ですから…"},
        { "location": "1195/TALK"   , "narrator": "がすとちゃん", "text": "実際にbotさんが観測した\n世界や彼女たちとは\n異なる部分も多いですの。"},
        { "location": "1196/TALK"   , "narrator": "がすとちゃん", "text": "だから、これを読んで\n「答え」を知るのが怖い\nとか思っている人も──"},
        { "location": "1197/TALK"   , "narrator": "がすとちゃん", "text": "むしろ考察や想像の幅が\nいっそう膨らむ資料として\n読んでみるといいですの。"},
        { "location": "1199/TALK"   , "narrator": "がすとちゃん", "text": "…みたいなことが\nこの本の前置きから\n読み取れたですの！"},
        { "location": "1200/TALK"   , "narrator": "がすとちゃん", "text": "だから安心して\nゲットするですのー！"},
        { "location": "1201/SEL"    , "narrator": "（選択肢）", "text": "はいはい"},
        { "location": "1202/ACT"    , "narrator": "", "text": "はいはい"},
        { "location": "1208/TALK"   , "narrator": "がすとちゃん", "text": "うむ。いい返事ですの。"},
        { "location": "1210/TALK"   , "narrator": "がすとちゃん", "text": "それでは\n$handle$よ、\n戦場でシーユーアゲイン！"},
        { "location": "1224/TALK"   , "narrator": "がすとちゃん", "text": "…。"},
        { "location": "1225/TALK"   , "narrator": "がすとちゃん", "text": "……。"},
        { "location": "1227/TALK"   , "narrator": "がすとちゃん", "text": "……あれ？"},
        { "location": "1228/TALK"   , "narrator": "がすとちゃん", "text": "まだ続くですの？"},
        { "location": "1229/TALK"   , "narrator": "がすとちゃん", "text": "というか、\nこの背景は何ですの？"},
        { "location": "1230/TALK"   , "narrator": "がすとちゃん", "text": "しかも何処からか\n真面目な感じのBGMが\n流れてきたですの…！？"},
        { "location": "1232/TALK"   , "narrator": "がすとちゃん", "text": "何ですの！\nがすとにはこういうの\n似合わないですのー！"},
        { "location": "1233/TALK"   , "narrator": "がすとちゃん", "text": "もしかして\nバグって……。"},
        { "location": "1234/TALK"   , "narrator": "がすとちゃん", "text": "……。"},
        { "location": "1241/TALK"   , "narrator": "がすとちゃん", "text": "…。"},
        { "location": "1243/TALK"   , "narrator": "がすとちゃん", "text": "……。"},
        { "location": "1244/TALK"   , "narrator": "がすとちゃん", "text": "こんにちは。"},
        { "location": "1245/TALK"   , "narrator": "がすとちゃん", "text": "唐突に失礼いたします。"},
        { "location": "1246/TALK"   , "narrator": "がすとちゃん", "text": "この一連のイベントは\n今回が最後となります\nので──"},
        { "location": "1247/TALK"   , "narrator": "がすとちゃん", "text": "この場を借りて、\n地下室からご挨拶を\nさせていただきます。"},
        { "location": "1249/TALK"   , "narrator": "がすとちゃん", "text": "今日に至るまで、\nトライナリーへのご支援\n誠に有難うございます。"},
        { "location": "1250/TALK"   , "narrator": "がすとちゃん", "text": "この夏は、\n皆さんとともに最後まで\n駆け抜けられますよう──"},
        { "location": "1251/TALK"   , "narrator": "がすとちゃん", "text": "グッズやイベントなど、\nさまざまなものを用意\nさせていただきました。"},
        { "location": "1252/TALK"   , "narrator": "がすとちゃん", "text": "願わくば、\n来たる日まで皆さんと\nともに歩み続け──"},
        { "location": "1253/TALK"   , "narrator": "がすとちゃん", "text": "見届けてもらえたら、\nとても嬉しく思います。"},
        { "location": "1255/TALK"   , "narrator": "がすとちゃん", "text": "さて、まずグッズに関して\nですが、今回は全ての\nグッズに想いがあります。"},
        { "location": "1256/TALK"   , "narrator": "がすとちゃん", "text": "それらの想いは、どれ１つ\n重なるものはなく、\n存在する目的があります。"},
        { "location": "1257/TALK"   , "narrator": "がすとちゃん", "text": "ココロの旅チャームは、\n皆さんと共に選んだ、\n皆さんが主役のアイテム。"},
        { "location": "1258/TALK"   , "narrator": "がすとちゃん", "text": "タペストリーは、大判の\n記念写真。ずっと彼女たち\nと共にいられるように。"},
        { "location": "1259/TALK"   , "narrator": "がすとちゃん", "text": "ソラノキヲクは、\nずっと彼女たちの心に\n寄り添っていられるよう。"},
        { "location": "1260/TALK"   , "narrator": "がすとちゃん", "text": "タペストリーが姿で\nソラノキヲクが心。\n対極を成す作りです。"},
        { "location": "1261/TALK"   , "narrator": "がすとちゃん", "text": "そして最後に\nウラオモテセット。"},
        { "location": "1262/TALK"   , "narrator": "がすとちゃん", "text": "表は毎日彼女たちから\n今日の言葉をもらえる\n日めくりカレンダー。"},
        { "location": "1263/TALK"   , "narrator": "がすとちゃん", "text": "そして裏は、あちらの\n世界の全貌を、余すこと\nなく描ききった文書です。"},
        { "location": "1264/TALK"   , "narrator": "がすとちゃん", "text": "どれ一つとっても、\n無駄なものはないと\n考えて制作致しました。"},
        { "location": "1266/TALK"   , "narrator": "がすとちゃん", "text": "また、今回はコミケ会場\n購入特典として、世界観\nステッカーを用意しました"},
        { "location": "1267/TALK"   , "narrator": "がすとちゃん", "text": "実は今回、世界観ロゴは\nかなり予算を使って本気で\n作っているのですが――"},
        { "location": "1268/TALK"   , "narrator": "がすとちゃん", "text": "それは、このステッカーを\n作りたかったから、という\n理由もあったりします。"},
        { "location": "1270/TALK"   , "narrator": "がすとちゃん", "text": "是非、ノートPCや\nスマートフォンに\n貼っていただければ。"},
        { "location": "1283/TALK"   , "narrator": "がすとちゃん", "text": "PowerdByRedinessの\n端末なんて、最高じゃ\nありませんか！？"},
        { "location": "1285/TALK"   , "narrator": "がすとちゃん", "text": "と、すみません。\n一人熱くなって\nしまいました。"},
        { "location": "1286/TALK"   , "narrator": "がすとちゃん", "text": "……先を続けますね。"},
        { "location": "1288/TALK"   , "narrator": "がすとちゃん", "text": "コミケの後ですが、\nラストストーリーの\nリリースが控えています。"},
        { "location": "1289/TALK"   , "narrator": "がすとちゃん", "text": "……一応念のため。\nアプリ更新の話ですよ？"},
        { "location": "1290/TALK"   , "narrator": "がすとちゃん", "text": "こちらは、全6本の構成で\nトライナリー一人ずつ＋\nナビたちのイベントです。"},
        { "location": "1291/TALK"   , "narrator": "がすとちゃん", "text": "このラストストーリーは、\n誰でもお楽しみいただける\n作りではありますが――"},
        { "location": "1293/TALK"   , "narrator": "がすとちゃん", "text": "実は神楽チャンネルの\nEP31をクリアしているか\n否かで内容が変わります。"},
        { "location": "1294/TALK"   , "narrator": "がすとちゃん", "text": "具体的には、神楽EP31を\nクリアしている方なら\n誰でも――"},
        { "location": "1295/TALK"   , "narrator": "がすとちゃん", "text": "その到達未来のうち、\n最大多数の未来１つの\n続きを見られるのです。"},
        { "location": "1296/TALK"   , "narrator": "がすとちゃん", "text": "ソイルトンが言っていた\n通りですから、クリアした\n方はご存知かと思います。"},
        { "location": "1297/TALK"   , "narrator": "がすとちゃん", "text": "そうで無い方も、彼女との\n一時を過ごし、ブロマイド\nまでゲット出来るという―"},
        { "location": "1298/TALK"   , "narrator": "がすとちゃん", "text": "かなり大サービスな\nイベントなのですが。"},
        { "location": "1299/TALK"   , "narrator": "がすとちゃん", "text": "EP31をクリアしていると\nそこに更にプラスして、"},
        { "location": "1300/TALK"   , "narrator": "がすとちゃん", "text": "１つの未来のエピローグが\n見られる、そんな作りに\nなっているんですね。"},
        { "location": "1302/TALK"   , "narrator": "がすとちゃん", "text": "ですから是非、まだ\nクリアしていない方は、\n最後まで到達してください"},
        { "location": "1303/TALK"   , "narrator": "がすとちゃん", "text": "もちろん、到達して\nいなくても、十分彼女達と\n交流はできます。"},
        { "location": "1304/TALK"   , "narrator": "がすとちゃん", "text": "ですが、EP31をクリア\nしていれば――"},
        { "location": "1306/TALK"   , "narrator": "がすとちゃん", "text": "貴方が彼女に対して\n抱いている、幾つかの\n心配事は解決する筈です。"},
        { "location": "1307/TALK"   , "narrator": "がすとちゃん", "text": "どうか、彼女たちの\n頑張りを、最後まで\n見届けてあげてください。"},
        { "location": "1308/TALK"   , "narrator": "がすとちゃん", "text": "そして、貴方と彼女とで\n最高の思い出を、\n作り上げて欲しいのです。"},
        { "location": "1310/TALK"   , "narrator": "がすとちゃん", "text": "突然の乱入にて\n失礼いたしました。"},
        { "location": "1311/TALK"   , "narrator": "がすとちゃん", "text": "また、長話に最後まで\nお付き合いくださり\n有難うございました。"},
        { "location": "1312/TALK"   , "narrator": "がすとちゃん", "text": "猛暑が予想されますから、\n会場にお越しの場合は\n何卒お気をつけください。"},
        { "location": "1314/TALK"   , "narrator": "がすとちゃん", "text": "これからも、皆さんに、\n素敵なココロの旅を！"},
        { "location": "1327/TALK"   , "narrator": "がすとちゃん", "text": "…。"},
        { "location": "1329/TALK"   , "narrator": "がすとちゃん", "text": "……。"},
        { "location": "1330/TALK"   , "narrator": "がすとちゃん", "text": "……はっ！"},
        { "location": "1331/TALK"   , "narrator": "がすとちゃん", "text": "今のは何ですの？"},
        { "location": "1332/TALK"   , "narrator": "がすとちゃん", "text": "がすとは一体何を\n喋っていたですの…？"},
        { "location": "1334/TALK"   , "narrator": "がすとちゃん", "text": "まるで自分が\n自分じゃなかった\nみたいですの！"},
        { "location": "1335/TALK"   , "narrator": "がすとちゃん", "text": "もしや、これが噂の\nインターなんちゃら…！？"},
        { "location": "1352/TALK"   , "narrator": "がすとちゃん", "text": "がすとを何だと\n思ってるですのー！！"},
        { "location": "1357/DIALOG" , "narrator": "", "text": "KADOKAWAブース\nオモテウラ拡張グッズセットの\n詳細情報を見ますか？"}
    ]
}
