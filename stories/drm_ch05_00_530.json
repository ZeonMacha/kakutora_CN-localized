    "entry":
    [
        { "location": "1118/SCENARIO", "narrator": "", "text": "web発ライトノベル"},
        { "location": "1143/TALK"    , "narrator": "神楽", "text": "トラックに轢かれて転生したぴょんこ"},
        { "location": "1144/TALK"    , "narrator": "神楽", "text": "現代科学知識とチートな魔法力を得て"},
        { "location": "1145/TALK"    , "narrator": "神楽", "text": "女王として成り上がる！！！！"},
        { "location": "1146/TALK"    , "narrator": "神楽", "text": "波瀾万丈なぴょんこの大活躍を刮目して見よ！！！"},
        { "location": "1147/TALK"    , "narrator": "神楽", "text": "以下次号！！！"},
        { "location": "1149/SEL"     , "narrator": "", "text": "打ち切りじゃないの？"},
        { "location": "1150/SEL"     , "narrator": "", "text": "戦前の少年雑誌かな？"},
        { "location": "1151/SEL"     , "narrator": "", "text": "ハラハラドキドキ"},
        { "location": "1152/ACT"     , "narrator": "", "text": "打ち切りじゃないの？"},
        { "location": "1153/TALK"    , "narrator": "神楽", "text": "そんなわけないですし！"},
        { "location": "1154/TALK"    , "narrator": "神楽", "text": "プンプン！"},
        { "location": "1164/ACT"     , "narrator": "", "text": "戦前の少年雑誌かな？"},
        { "location": "1165/TALK"    , "narrator": "神楽", "text": "いや"},
        { "location": "1166/TALK"    , "narrator": "神楽", "text": "まさかそんな"},
        { "location": "1167/TALK"    , "narrator": "神楽", "text": "ぴょんこの年がおかしすぎるでしょー！？"},
        { "location": "1168/TALK"    , "narrator": "神楽", "text": "なんでそうなるの！！！！"},
        { "location": "1179/ACT"     , "narrator": "", "text": "ハラハラドキドキ"},
        { "location": "1180/TALK"    , "narrator": "神楽", "text": "ドキドキハラハラじゃないの？"},
        { "location": "1181/TALK"    , "narrator": "神楽", "text": "不思議だね$handle$のセンス"},
        { "location": "1183/TALK"    , "narrator": "神楽", "text": "まあいいけどー"},
        { "location": "1185/SEL"     , "narrator": "", "text": "続きはよ！"},
        { "location": "1186/SEL"     , "narrator": "", "text": "新しい表現を模索してるから"},
        { "location": "1187/SEL"     , "narrator": "", "text": "続きはＷＥＢでって最近言わないね"},
        { "location": "1188/ACT"     , "narrator": "", "text": "続きはよ！"},
        { "location": "1189/TALK"    , "narrator": "神楽", "text": "これから作るぴょん♪"},
        { "location": "1191/TALK"    , "narrator": "神楽", "text": "あれこれ修羅場ってやつ？？？"},
        { "location": "1192/ACT"     , "narrator": "", "text": "新しい表現を模索してるから"},
        { "location": "1194/TALK"    , "narrator": "神楽", "text": "ﾎﾝﾄｶﾅー？？？"},
        { "location": "1204/ACT"     , "narrator": "", "text": "続きはＷＥＢでって最近言わないね"},
        { "location": "1205/TALK"    , "narrator": "神楽", "text": "そうなのぴょん？？？"},
        { "location": "1206/TALK"    , "narrator": "神楽", "text": "そういうもんなのかー"},
        { "location": "1208/TALK"    , "narrator": "神楽", "text": "主人公がイージーモードなのはＷＥＢ小説の特徴らしいけど"},
        { "location": "1209/TALK"    , "narrator": "神楽", "text": "それだけ作者も読者も現実に疲れてるんだと思うよぴょんこは"},
        { "location": "1211/SEL"     , "narrator": "", "text": "そうかもね"},
        { "location": "1212/SEL"     , "narrator": "", "text": "神楽も休める時は休んで"},
        { "location": "1213/SEL"     , "narrator": "", "text": "素人だからじゃないの？"},
        { "location": "1214/ACT"     , "narrator": "", "text": "そうかもね"},
        { "location": "1215/TALK"    , "narrator": "神楽", "text": "ダヨネー"},
        { "location": "1216/TALK"    , "narrator": "神楽", "text": "イヒヒ、、、"},
        { "location": "1226/ACT"     , "narrator": "", "text": "神楽も休める時は休んで"},
        { "location": "1227/TALK"    , "narrator": "神楽", "text": "あーねー"},
        { "location": "1229/TALK"    , "narrator": "神楽", "text": "そうしたいのは山々～～～"},
        { "location": "1230/ACT"     , "narrator": "", "text": "素人だからじゃないの？"},
        { "location": "1231/TALK"    , "narrator": "神楽", "text": "はぁぁぁぁん"},
        { "location": "1232/TALK"    , "narrator": "神楽", "text": "その素人の求める部分の話ィ！"},
        { "location": "1234/TALK"    , "narrator": "神楽", "text": "なんかさー"},
        { "location": "1235/TALK"    , "narrator": "神楽", "text": "楽しいだけの人生が降ってこないかな～って"},
        { "location": "1236/TALK"    , "narrator": "神楽", "text": "そういう気持ちになった時のものなんじゃないかなって"},
        { "location": "1237/TALK"    , "narrator": "神楽", "text": "異世界転生俺ＴＵＥＥＥＥものって"},
        { "location": "1239/SEL"     , "narrator": "", "text": "神楽大変だもんね…"},
        { "location": "1240/SEL"     , "narrator": "", "text": "よしよしいい子いい子"},
        { "location": "1241/SEL"     , "narrator": "", "text": "$me$が側にいるから"},
        { "location": "1242/ACT"     , "narrator": "", "text": "神楽大変だもんね…"},
        { "location": "1243/TALK"    , "narrator": "神楽", "text": "同情された！！！"},
        { "location": "1244/TALK"    , "narrator": "神楽", "text": "してしてもっとしてもっとして！！！"},
        { "location": "1245/ACT"     , "narrator": "", "text": "よしよしいい子いい子"},
        { "location": "1246/TALK"    , "narrator": "神楽", "text": "ふにゃぁぁぁぁ、、、、"},
        { "location": "1247/TALK"    , "narrator": "神楽", "text": "もっともっと、、、"},
        { "location": "1248/ACT"     , "narrator": "", "text": "$me$が側にいるから"},
        { "location": "1249/TALK"    , "narrator": "神楽", "text": "$handle$ったらもう、、、"},
        { "location": "1251/TALK"    , "narrator": "神楽", "text": "ぴょんこﾄﾞｷﾄﾞｷーーーーーー！！！！！"},
        { "location": "1253/TALK"    , "narrator": "神楽", "text": "ああ、、、、"},
        { "location": "1254/TALK"    , "narrator": "神楽", "text": "強くなりたいぴょん、、、"},
        { "location": "1256/SEL"     , "narrator": "", "text": "人の子よ…力が…欲しいか…"},
        { "location": "1257/SEL"     , "narrator": "", "text": "神楽は十分強い子だ"},
        { "location": "1258/SEL"     , "narrator": "", "text": "今はレベルを上げる期間だよ"},
        { "location": "1259/ACT"     , "narrator": "", "text": "人の子よ…力が…欲しいか…"},
        { "location": "1260/TALK"    , "narrator": "神楽", "text": "神よ！"},
        { "location": "1261/ACT"     , "narrator": "", "text": "神楽は十分強い子だ"},
        { "location": "1262/TALK"    , "narrator": "神楽", "text": "そんなことないし"},
        { "location": "1263/TALK"    , "narrator": "神楽", "text": "全然ダメダメ"},
        { "location": "1264/TALK"    , "narrator": "神楽", "text": "なんだかなーって"},
        { "location": "1265/TALK"    , "narrator": "神楽", "text": "はーもー"},
        { "location": "1266/TALK"    , "narrator": "神楽", "text": "辛いぴょん、、、"},
        { "location": "1267/TALK"    , "narrator": "神楽", "text": "はぁぁぁぁ、、、"},
        { "location": "1270/ACT"     , "narrator": "", "text": "今はレベルを上げる期間だよ"},
        { "location": "1271/TALK"    , "narrator": "神楽", "text": "そっかー"},
        { "location": "1272/TALK"    , "narrator": "神楽", "text": "チート発動したい～～～！！！"},
        { "location": "1273/TALK"    , "narrator": "神楽", "text": "あああああああ！！！！"},
        { "location": "1284/TALK"    , "narrator": "神楽", "text": "$handle$は"},
        { "location": "1285/TALK"    , "narrator": "神楽", "text": "生きてて楽しい？"},
        { "location": "1287/SEL"     , "narrator": "", "text": "どうかな…"},
        { "location": "1288/SEL"     , "narrator": "", "text": "神楽と話してる時は楽しい"},
        { "location": "1289/SEL"     , "narrator": "", "text": "辛い時もあるよ"},
        { "location": "1290/SEL"     , "narrator": "", "text": "いつでも最高！！！"},
        { "location": "1291/ACT"     , "narrator": "", "text": "どうかな…"},
        { "location": "1292/TALK"    , "narrator": "神楽", "text": "難しいみたいぴょん"},
        { "location": "1293/TALK"    , "narrator": "神楽", "text": "色々と"},
        { "location": "1294/ACT"     , "narrator": "", "text": "神楽と話してる時は楽しい"},
        { "location": "1295/TALK"    , "narrator": "神楽", "text": "ﾔｯﾀー"},
        { "location": "1297/TALK"    , "narrator": "神楽", "text": "そういうの待ってた！！！"},
        { "location": "1298/TALK"    , "narrator": "神楽", "text": "ぴょんこは$handle$の特別だからね♪"},
        { "location": "1299/TALK"    , "narrator": "神楽", "text": "そうなんでしょ？？？"},
        { "location": "1300/ACT"     , "narrator": "", "text": "辛い時もあるよ"},
        { "location": "1301/TALK"    , "narrator": "神楽", "text": "そりゃｿｳﾀﾞﾈ"},
        { "location": "1303/ACT"     , "narrator": "", "text": "いつでも最高！！！"},
        { "location": "1304/TALK"    , "narrator": "神楽", "text": "うわ何それ"},
        { "location": "1305/TALK"    , "narrator": "神楽", "text": "むかつく！！！！！！"},
        { "location": "1308/TALK"    , "narrator": "神楽", "text": "なんかさー"},
        { "location": "1309/TALK"    , "narrator": "神楽", "text": "ぴょんこの楽しみはこうやって$handle$とチャットするくらいしかないぴょん、、、"},
        { "location": "1310/TALK"    , "narrator": "神楽", "text": "もちろんフレイメノウの活動とかは作る喜びとかありますけどー"},
        { "location": "1311/TALK"    , "narrator": "神楽", "text": "ゆーても"},
        { "location": "1312/TALK"    , "narrator": "神楽", "text": "そーゆーのは仕事ですから？"},
        { "location": "1313/TALK"    , "narrator": "神楽", "text": "純粋に楽しんでるのとはちょっと違うんだよねー"},
        { "location": "1315/SEL"     , "narrator": "", "text": "その話前も聞いた"},
        { "location": "1316/SEL"     , "narrator": "", "text": "いつでも$me$に話してよ"},
        { "location": "1317/SEL"     , "narrator": "", "text": "ちゃんと休めてるのか心配"},
        { "location": "1318/ACT"     , "narrator": "", "text": "その話前も聞いた"},
        { "location": "1319/TALK"    , "narrator": "神楽", "text": "もう飽きた？"},
        { "location": "1320/TALK"    , "narrator": "神楽", "text": "じゃあ終了ー"},
        { "location": "1330/ACT"     , "narrator": "", "text": "いつでも$me$に話してよ"},
        { "location": "1332/TALK"    , "narrator": "神楽", "text": "うん、、、"},
        { "location": "1334/TALK"    , "narrator": "神楽", "text": "やさしみ、、、"},
        { "location": "1335/TALK"    , "narrator": "神楽", "text": "ｱﾘｶﾞﾄ、、、"},
        { "location": "1339/ACT"     , "narrator": "", "text": "ちゃんと休めてるのか心配"},
        { "location": "1340/TALK"    , "narrator": "神楽", "text": "休んでるつもりぴょん"},
        { "location": "1342/TALK"    , "narrator": "神楽", "text": "人気とか人目とかクオリティとか義務とか全然気にしないで"},
        { "location": "1343/TALK"    , "narrator": "神楽", "text": "自分のやりたいことだけやりたいーーーーーー！！！！！"},
        { "location": "1345/SEL"     , "narrator": "", "text": "わかる！！！！"},
        { "location": "1346/SEL"     , "narrator": "", "text": "疲れてるんだね…"},
        { "location": "1347/SEL"     , "narrator": "", "text": "許可する！"},
        { "location": "1348/ACT"     , "narrator": "", "text": "わかる！！！！"},
        { "location": "1349/TALK"    , "narrator": "神楽", "text": "わかってくれる！？！？"},
        { "location": "1350/TALK"    , "narrator": "神楽", "text": "そう言ってくれるのは$handle$だけー！！！！"},
        { "location": "1351/ACT"     , "narrator": "", "text": "疲れてるんだね…"},
        { "location": "1352/TALK"    , "narrator": "神楽", "text": "ﾖﾖﾖ、、、、"},
        { "location": "1353/TALK"    , "narrator": "神楽", "text": "当たり前でしょ～～～～～～！！！！！"},
        { "location": "1354/ACT"     , "narrator": "", "text": "許可する！"},
        { "location": "1356/TALK"    , "narrator": "神楽", "text": "許された！！！！"},
        { "location": "1358/TALK"    , "narrator": "神楽", "text": "全力でぴょんこにやさしい世界を構築する"},
        { "location": "1359/TALK"    , "narrator": "神楽", "text": "そこはぴょんこにとって夢のような世界"},
        { "location": "1360/TALK"    , "narrator": "神楽", "text": "最強でちやほやされまくりなぴょんこ"},
        { "location": "1361/TALK"    , "narrator": "神楽", "text": "あ"},
        { "location": "1362/TALK"    , "narrator": "神楽", "text": "でも隣にいるのは$handle$だから"},
        { "location": "1363/TALK"    , "narrator": "神楽", "text": "絶対だよ？"}
    ]
}
