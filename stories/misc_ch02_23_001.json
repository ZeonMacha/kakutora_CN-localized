    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "神楽坂パースペクティブ"},
        { "location": "32/TALK"   , "narrator": "アーヤ", "text": "東京って"},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "場所によって全然違うわ"},
        { "location": "35/SEL"    , "narrator": "", "text": "そうなの？"},
        { "location": "36/SEL"    , "narrator": "", "text": "そうだよね"},
        { "location": "37/SEL"    , "narrator": "", "text": "長野もそうじゃない？"},
        { "location": "38/ACT"    , "narrator": "", "text": "そうなの？"},
        { "location": "39/TALK"   , "narrator": "アーヤ", "text": "そうなのよ"},
        { "location": "41/TALK"   , "narrator": "アーヤ", "text": "びっくりするわよ"},
        { "location": "42/ACT"    , "narrator": "", "text": "そうだよね"},
        { "location": "43/TALK"   , "narrator": "アーヤ", "text": "そうなのよね"},
        { "location": "45/TALK"   , "narrator": "アーヤ", "text": "本当に"},
        { "location": "46/ACT"    , "narrator": "", "text": "長野もそうじゃない？"},
        { "location": "48/TALK"   , "narrator": "アーヤ", "text": "まあね"},
        { "location": "49/TALK"   , "narrator": "アーヤ", "text": "でも"},
        { "location": "50/TALK"   , "narrator": "アーヤ", "text": "やっぱり建物からして違うのよ"},
        { "location": "51/TALK"   , "narrator": "アーヤ", "text": "こっちはね"},
        { "location": "53/TALK"   , "narrator": "アーヤ", "text": "神楽坂は戦前から繁華街だったし"},
        { "location": "54/TALK"   , "narrator": "アーヤ", "text": "歴史もあって"},
        { "location": "55/TALK"   , "narrator": "アーヤ", "text": "でも新しいところもあるのよね"},
        { "location": "57/SEL"    , "narrator": "", "text": "戦前とか"},
        { "location": "58/SEL"    , "narrator": "", "text": "そういうところなんだ"},
        { "location": "59/SEL"    , "narrator": "", "text": "今度案内してよ"},
        { "location": "60/ACT"    , "narrator": "", "text": "戦前とか"},
        { "location": "61/TALK"   , "narrator": "アーヤ", "text": "戦前は戦前でしょ"},
        { "location": "62/TALK"   , "narrator": "アーヤ", "text": "可笑しいことなんて言ってないわよ"},
        { "location": "63/TALK"   , "narrator": "アーヤ", "text": "もう"},
        { "location": "64/ACT"    , "narrator": "", "text": "そういうところなんだ"},
        { "location": "65/TALK"   , "narrator": "アーヤ", "text": "そうなのよ"},
        { "location": "67/TALK"   , "narrator": "アーヤ", "text": "とてもいいところよ"},
        { "location": "68/ACT"    , "narrator": "", "text": "今度案内してよ"},
        { "location": "70/TALK"   , "narrator": "アーヤ", "text": "そうね"},
        { "location": "71/TALK"   , "narrator": "アーヤ", "text": "今度とっておきのところを"},
        { "location": "72/TALK"   , "narrator": "アーヤ", "text": "案内するわ"},
        { "location": "73/TALK"   , "narrator": "アーヤ", "text": "楽しみにしてて"}
    ]
}
