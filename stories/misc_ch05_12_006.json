        "title": "Extra008 ヒメゴトチャット",
        "sub_title": "ぽいのぽいのぽい"
    },
    "entry":
    [
        { "location": "3726/SCENARIO", "narrator": "", "text": "ぽいのぽいのぽい"},
        { "location": "3751/TALK"    , "narrator": "神楽", "text": "真幌さんもみやびさんもハウスキーパー頼めばいいのに！"},
        { "location": "3753/SEL"     , "narrator": "", "text": "片づけるの苦手なんだよ…"},
        { "location": "3754/SEL"     , "narrator": "", "text": "神楽は頼んでるんだ"},
        { "location": "3755/SEL"     , "narrator": "", "text": "人の勝手じゃないかな"},
        { "location": "3756/ACT"     , "narrator": "", "text": "片づけるの苦手なんだよ…"},
        { "location": "3757/TALK"    , "narrator": "神楽", "text": "だから人の手を借りるんだってば"},
        { "location": "3758/ACT"     , "narrator": "", "text": "神楽は頼んでるんだ"},
        { "location": "3760/TALK"    , "narrator": "神楽", "text": "当然"},
        { "location": "3762/TALK"    , "narrator": "神楽", "text": "片付けと掃除はぴょんこしたことないから頼むの"},
        { "location": "3763/TALK"    , "narrator": "神楽", "text": "そういうもんだよね"},
        { "location": "3764/ACT"     , "narrator": "", "text": "人の勝手じゃないかな"},
        { "location": "3765/TALK"    , "narrator": "神楽", "text": "そうかもしれないけど、、、"},
        { "location": "3767/TALK"    , "narrator": "神楽", "text": "とにかくすごいから二人の部屋"},
        { "location": "3769/TALK"    , "narrator": "神楽", "text": "自分でできないならやってもらえばいいのに"},
        { "location": "3770/TALK"    , "narrator": "神楽", "text": "なんであんなんで平気なの？"},
        { "location": "3772/SEL"     , "narrator": "", "text": "慣れてるんだよ"},
        { "location": "3773/SEL"     , "narrator": "", "text": "代わりにやってあげれば？"},
        { "location": "3774/SEL"     , "narrator": "", "text": "神楽結構優しいよね"},
        { "location": "3775/ACT"     , "narrator": "", "text": "慣れてるんだよ"},
        { "location": "3776/TALK"    , "narrator": "神楽", "text": "それがまずわかんない"},
        { "location": "3777/ACT"     , "narrator": "", "text": "代わりにやってあげれば？"},
        { "location": "3778/TALK"    , "narrator": "神楽", "text": "そういうことじゃなくて"},
        { "location": "3779/ACT"     , "narrator": "", "text": "神楽結構優しいよね"},
        { "location": "3781/TALK"    , "narrator": "神楽", "text": "いや"},
        { "location": "3782/TALK"    , "narrator": "神楽", "text": "そういうわけじゃないと思う"},
        { "location": "3783/TALK"    , "narrator": "神楽", "text": "ただちょっとイラっとしたっていうか"},
        { "location": "3784/TALK"    , "narrator": "神楽", "text": "そんな感じだから"},
        { "location": "3785/TALK"    , "narrator": "神楽", "text": "それだけだぴょん"},
        { "location": "3787/TALK"    , "narrator": "神楽", "text": "あーもー気になる！！"},
        { "location": "3788/TALK"    , "narrator": "神楽", "text": "どうにかしてほしい！"}
    ]
}
