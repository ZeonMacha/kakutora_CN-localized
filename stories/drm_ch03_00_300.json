        "title": "らぶとーく  第30話",
        "sub_title": "幼い恋"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "幼い恋"},
        { "location": "19/TALK"   , "narrator": "ガブリエラ", "text": "えっと、買い物は\nこれで全部だった\nかしら？"},
        { "location": "20/TALK"   , "narrator": "ガブリエラ", "text": "他に必要なものは…。"},
        { "location": "22/TALK"   , "narrator": "ガブリエラ", "text": "っ！？"},
        { "location": "29/TALK"   , "narrator": "ヒカル", "text": "…………。"},
        { "location": "39/TALK"   , "narrator": "ガブリエラ", "text": "うそっ！？\nまたヒカルくんだ…。"},
        { "location": "40/TALK"   , "narrator": "ガブリエラ", "text": "それも、この前\n会った場所で\nまた会うなんて…。"},
        { "location": "42/TALK"   , "narrator": "ガブリエラ", "text": "これって、やっぱり…。"},
        { "location": "55/TALK"   , "narrator": "ガブリエラ", "text": "運命よね/////////"},
        { "location": "57/SEL"    , "narrator": "", "text": "なにが？"},
        { "location": "58/ACT"    , "narrator": "", "text": "なにが？"},
        { "location": "60/TALK"   , "narrator": "ガブリエラ", "text": "あそこにヒカルくんがいるの"},
        { "location": "61/TALK"   , "narrator": "ガブリエラ", "text": "この前会った場所でまたヒカルくんと会えたの"},
        { "location": "62/TALK"   , "narrator": "ガブリエラ", "text": "これって運命よね？"},
        { "location": "63/TALK"   , "narrator": "ガブリエラ", "text": "映画やドラマであるような"},
        { "location": "65/TALK"   , "narrator": "ガブリエラ", "text": "超ロマンチックな/////////"},
        { "location": "67/SEL"    , "narrator": "", "text": "ただの偶然"},
        { "location": "68/SEL"    , "narrator": "", "text": "うん、運命じゃない"},
        { "location": "69/SEL"    , "narrator": "", "text": "仕込んでおきました"},
        { "location": "70/ACT"    , "narrator": "", "text": "ただの偶然"},
        { "location": "72/TALK"   , "narrator": "ガブリエラ", "text": "わかってないのね"},
        { "location": "73/TALK"   , "narrator": "ガブリエラ", "text": "一度だけなら偶然だけど"},
        { "location": "74/TALK"   , "narrator": "ガブリエラ", "text": "重なれば運命よ"},
        { "location": "75/ACT"    , "narrator": "", "text": "うん、運命じゃない"},
        { "location": "77/TALK"   , "narrator": "ガブリエラ", "text": "だとしたら必然ってやつね"},
        { "location": "78/ACT"    , "narrator": "", "text": "仕込んでおきました"},
        { "location": "80/TALK"   , "narrator": "ガブリエラ", "text": "気が利くじゃない、$handle$"},
        { "location": "81/TALK"   , "narrator": "ガブリエラ", "text": "流石は私の使用人ね"},
        { "location": "83/TALK"   , "narrator": "ガブリエラ", "text": "ちょっと挨拶してくるわ"},
        { "location": "94/TALK"   , "narrator": "ガブリエラ", "text": "…この前みたいに、\nまた服の裾を引っ張って\nみようかしら？"},
        { "location": "97/TALK"   , "narrator": "ヒカル", "text": "……あれ？"},
        { "location": "98/TALK"   , "narrator": "ヒカル", "text": "あ、ガブリエラさん。"},
        { "location": "101/TALK"  , "narrator": "ガブリエラ", "text": "っ！？"},
        { "location": "102/TALK"  , "narrator": "ガブリエラ", "text": "うそっ！？\nヒカルくんの方から\n気付いてくれた！？"},
        { "location": "103/TALK"  , "narrator": "ヒカル", "text": "こんにちは。\nお買い物ですか？"},
        { "location": "105/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "106/TALK"  , "narrator": "ガブリエラ", "text": "い、いけない！\n早く答えないと。"},
        { "location": "108/TALK"  , "narrator": "ガブリエラ", "text": "えっと…そうです。\nヒカルくんもですか？\nっと…。"},
        { "location": "109/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "110/TALK"  , "narrator": "ヒカル", "text": "はい。\nいつも買ってる雑誌を\n買いに来たんです。"},
        { "location": "111/TALK"  , "narrator": "ヒカル", "text": "今は買い忘れがないかを\nチェックしてて…。"},
        { "location": "113/TALK"  , "narrator": "ガブリエラ", "text": "そうだったんだ…。"},
        { "location": "114/TALK"  , "narrator": "ヒカル", "text": "それにしても、\n本当に奇遇ですね。"},
        { "location": "115/TALK"  , "narrator": "ヒカル", "text": "確か、この前会ったのも\nこの場所でしたし――"},
        { "location": "116/TALK"  , "narrator": "ヒカル", "text": "こんな偶然が二回も\n続くなんて、ちょっと\n驚きです。"},
        { "location": "119/TALK"  , "narrator": "ガブリエラ", "text": "えっ！？"},
        { "location": "120/TALK"  , "narrator": "ガブリエラ", "text": "私も同じことを\n考えていました、っと。"},
        { "location": "121/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "122/TALK"  , "narrator": "ヒカル", "text": "あはは、そうですよね。"},
        { "location": "123/TALK"  , "narrator": "ヒカル", "text": "この様子だと、そんなに\n遠くないうちに――"},
        { "location": "124/TALK"  , "narrator": "ヒカル", "text": "三回目の偶然が\nありそうですね。"},
        { "location": "126/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "127/TALK"  , "narrator": "ガブリエラ", "text": "…私もそう思います。"},
        { "location": "128/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "129/TALK"  , "narrator": "ヒカル", "text": "ですよね。"},
        { "location": "131/TALK"  , "narrator": "ヒカル", "text": "そうだ。\n三回目はどっちが先に\n見つけるか――"},
        { "location": "132/TALK"  , "narrator": "ヒカル", "text": "競争とかしたら\n面白そうですね。"},
        { "location": "134/TALK"  , "narrator": "ガブリエラ", "text": "負けません！"},
        { "location": "135/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "136/TALK"  , "narrator": "ヒカル", "text": "僕も楽しみです。"},
        { "location": "137/TALK"  , "narrator": "ガブリエラ", "text": "ヒカルくんも、\nあたしと会うのが\n楽しみなんて――"},
        { "location": "138/TALK"  , "narrator": "ガブリエラ", "text": "凄く嬉しい！"},
        { "location": "140/TALK"  , "narrator": "ヒカル", "text": "あっ、いけない。\nそろそろ帰らないと…。"},
        { "location": "141/TALK"  , "narrator": "ヒカル", "text": "それじゃ、\nガブリエラさん。\nまた学校で。"},
        { "location": "142/TALK"  , "narrator": "ガブリエラ", "text": "はい、それじゃあ。"},
        { "location": "144/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "145/TALK"  , "narrator": "ヒカル", "text": "ガブリエラさんも、\n気を付けて帰って\nくださいね。"},
        { "location": "149/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "161/TALK"  , "narrator": "ガブリエラ", "text": "聞いた、$handle$？"},
        { "location": "162/TALK"  , "narrator": "ガブリエラ", "text": "ヒカルくんも"},
        { "location": "163/TALK"  , "narrator": "ガブリエラ", "text": "また私と会うのが楽しみって言ってたわ///////////"},
        { "location": "164/TALK"  , "narrator": "ガブリエラ", "text": "やっぱり運命だったのよ！"},
        { "location": "165/TALK"  , "narrator": "ガブリエラ", "text": "これからはこの道を通る度にドキドキしちゃいそう"},
        { "location": "177/TALK"  , "narrator": "ガブリエラ", "text": "ふふっ、早く三回目が\n来るといいな…。"},
        { "location": "17/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>某月某日　3:18 PM</color>\nとある休日の午後、町中にて。"}
    ]
}
