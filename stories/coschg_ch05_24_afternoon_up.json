        { "location": "2671/TALK", "narrator": "プレイヤー", "text": "お着替えしてみよう"},
        { "location": "2673/TALK", "narrator": "プレイヤー", "text": "違う服を着てほしいな"},
        { "location": "2675/TALK", "narrator": "プレイヤー", "text": "よし、お着替えタイムだ！"},
        { "location": "2681/TALK", "narrator": "プレイヤー", "text": "やあ"},
        { "location": "2683/TALK", "narrator": "プレイヤー", "text": "こんにちは"},
        { "location": "2685/TALK", "narrator": "プレイヤー", "text": "げんき？"},
        { "location": "2688/TALK", "narrator": "神楽", "text": "ぴょんこを呼ぶ声"},
        { "location": "2689/TALK", "narrator": "神楽", "text": "あなたはだあれ？"},
        { "location": "2691/SEL" , "narrator": "", "text": "$handle$だよ"},
        { "location": "2692/ACT" , "narrator": "", "text": "$handle$だよ"},
        { "location": "2694/TALK", "narrator": "神楽", "text": "知ってるし"},
        { "location": "2695/TALK", "narrator": "神楽", "text": "ぴょんこに用事ぴょん？"},
        { "location": "2698/SEL" , "narrator": "", "text": "ちょっと着替えてほしいんだ"},
        { "location": "2699/ACT" , "narrator": "", "text": "ちょっと着替えてほしいんだ"},
        { "location": "2709/TALK", "narrator": "神楽", "text": "意味不明すぎ"},
        { "location": "2710/TALK", "narrator": "神楽", "text": "でもまあ"},
        { "location": "2711/TALK", "narrator": "神楽", "text": "優しいぴょんこは聞いてあげるのだった"},
        { "location": "2713/TALK", "narrator": "神楽", "text": "は？"},
        { "location": "2714/TALK", "narrator": "神楽", "text": "この服変だった？"},
        { "location": "2715/TALK", "narrator": "神楽", "text": "なら着替えるけど"},
        { "location": "2718/SEL" , "narrator": "", "text": "$me$が選ぶ"},
        { "location": "2719/SEL" , "narrator": "", "text": "やっぱやめる"},
        { "location": "2721/TALK", "narrator": "神楽", "text": "…………"},
        { "location": "2724/TALK", "narrator": "神楽", "text": "リクエストないとか？"},
        { "location": "2725/TALK", "narrator": "神楽", "text": "なら着ない"},
        { "location": "2727/ACT" , "narrator": "", "text": "$me$が選ぶ"},
        { "location": "2728/TALK", "narrator": "神楽", "text": "だと思った"},
        { "location": "2729/TALK", "narrator": "神楽", "text": "どれを着てほしいと？"},
        { "location": "2736/ACT" , "narrator": "", "text": "やっぱやめる"},
        { "location": "2737/TALK", "narrator": "神楽", "text": "ありえネー"}
    ]
