    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "古いのかもしれないけど"},
        { "location": "25/TALK"   , "narrator": "つばめ", "text": "きゃっ！"},
        { "location": "27/TALK"   , "narrator": "アーヤ", "text": "雷？\nまだ遠いみたいだけど、\n一雨来そうね。"},
        { "location": "31/TALK"   , "narrator": "つばめ", "text": "きゃっ！"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "いや、さすがにちょっと\n怖がり過ぎでしょ？"},
        { "location": "34/TALK"   , "narrator": "つばめ", "text": "だ、だって、雷って\n怖いじゃないですか。"},
        { "location": "37/TALK"   , "narrator": "ガブリエラ", "text": "別に怖くないわよ。\nただ空が光って音がする\nだけじゃない。"},
        { "location": "42/TALK"   , "narrator": "ガブリエラ", "text": "きゃぁっ！！"},
        { "location": "44/TALK"   , "narrator": "つばめ", "text": "…ガブちゃんも\n怖がってるよね？"},
        { "location": "48/TALK"   , "narrator": "ガブリエラ", "text": "ち、違う！\n怖かったんじゃないわ！"},
        { "location": "49/TALK"   , "narrator": "ガブリエラ", "text": "急に大きな音がしたから、\nビックリしただけよ。"},
        { "location": "50/TALK"   , "narrator": "つばめ", "text": "本当かなぁ？"},
        { "location": "52/TALK"   , "narrator": "ガブリエラ", "text": "雷なんて怖くないわよ！"},
        { "location": "54/TALK"   , "narrator": "みやび", "text": "うちも、雷はもうちっくと\n大きい方が好きやね。"},
        { "location": "56/TALK"   , "narrator": "アーヤ", "text": "あら、みやびは\n雷って平気なの？"},
        { "location": "58/TALK"   , "narrator": "みやび", "text": "ど派手で好きちや。"},
        { "location": "59/TALK"   , "narrator": "みやび", "text": "どうせなら、寮にでも\n直撃してくれたら\n派手でえいんやけんど。"},
        { "location": "60/TALK"   , "narrator": "つばめ", "text": "えぇっ！？"},
        { "location": "62/TALK"   , "narrator": "ガブリエラ", "text": "ちょ、冗談でもそういう\nこと言わないでよ！"},
        { "location": "64/TALK"   , "narrator": "みやび", "text": "いや、冗談やなくて、\n身体が震えるくらい\nド派手な音を――"},
        { "location": "65/TALK"   , "narrator": "みやび", "text": "…………。"},
        { "location": "67/TALK"   , "narrator": "みやび", "text": "いや、前言撤回や。"},
        { "location": "68/TALK"   , "narrator": "みやび", "text": "そんなんでＰＣに不調が\n出たら、面倒なことに\nなるきね。"},
        { "location": "71/TALK"   , "narrator": "アーヤ", "text": "みやびらしいわね。"},
        { "location": "73/TALK"   , "narrator": "ガブリエラ", "text": "そういうアーヤは\n怖くないの？"},
        { "location": "76/TALK"   , "narrator": "アーヤ", "text": "怖いわよ。\n急に近くで音がしたら\nビクッとするし。"},
        { "location": "77/TALK"   , "narrator": "ガブリエラ", "text": "…全然怖がってないわね。"},
        { "location": "79/TALK"   , "narrator": "つばめ", "text": "やっぱり、アーヤさんは\n凄いなぁ…。"},
        { "location": "80/TALK"   , "narrator": "アーヤ", "text": "昔は怖かったけど、\nさすがにこの年に\nなるとね…。"},
        { "location": "82/TALK"   , "narrator": "アーヤ", "text": "…そういえば、\n$handle$さんの方は\nどうなのかしら？"},
        { "location": "95/TALK"   , "narrator": "アーヤ", "text": "$handle$さん"},
        { "location": "96/TALK"   , "narrator": "アーヤ", "text": "こっちは凄い天気(>_<)"},
        { "location": "97/TALK"   , "narrator": "アーヤ", "text": "雷！"},
        { "location": "99/SEL"    , "narrator": "", "text": "大丈夫！？"},
        { "location": "100/ACT"   , "narrator": "", "text": "大丈夫！？"},
        { "location": "102/TALK"  , "narrator": "アーヤ", "text": "大丈夫"},
        { "location": "103/TALK"  , "narrator": "アーヤ", "text": "今日は出掛ける予定ないし"},
        { "location": "104/TALK"  , "narrator": "アーヤ", "text": "明日までずっと屋内だから(^^"},
        { "location": "105/TALK"  , "narrator": "アーヤ", "text": "そっちの天気はどう？"},
        { "location": "107/SEL"   , "narrator": "", "text": "いい天気だよ"},
        { "location": "108/SEL"   , "narrator": "", "text": "あんまりよくないな"},
        { "location": "109/SEL"   , "narrator": "", "text": "アーヤのおかげで気持ちは晴天"},
        { "location": "110/ACT"   , "narrator": "", "text": "いい天気だよ"},
        { "location": "111/TALK"  , "narrator": "アーヤ", "text": "それならよかった"},
        { "location": "112/TALK"  , "narrator": "アーヤ", "text": "天候悪くなると"},
        { "location": "113/TALK"  , "narrator": "アーヤ", "text": "気温も下がるし"},
        { "location": "114/TALK"  , "narrator": "アーヤ", "text": "低気圧で頭も痛くなるから"},
        { "location": "116/TALK"  , "narrator": "アーヤ", "text": "最悪よね(T_T)"},
        { "location": "118/SEL"   , "narrator": "", "text": "体調に気を付けてね"},
        { "location": "119/ACT"   , "narrator": "", "text": "体調に気を付けてね"},
        { "location": "121/TALK"  , "narrator": "アーヤ", "text": "うん"},
        { "location": "122/TALK"  , "narrator": "アーヤ", "text": "ありがと(*^.^*)"},
        { "location": "123/ACT"   , "narrator": "", "text": "あんまりよくないな"},
        { "location": "124/TALK"  , "narrator": "アーヤ", "text": "そうなんだ"},
        { "location": "125/TALK"  , "narrator": "アーヤ", "text": "ちょっとだけ嬉しいかも"},
        { "location": "127/SEL"   , "narrator": "", "text": "どうして？"},
        { "location": "128/ACT"   , "narrator": "", "text": "どうして？"},
        { "location": "130/TALK"  , "narrator": "アーヤ", "text": "だって"},
        { "location": "131/TALK"  , "narrator": "アーヤ", "text": "離れてるのに"},
        { "location": "132/TALK"  , "narrator": "アーヤ", "text": "すぐ近くにいるみたいだし"},
        { "location": "135/SEL"   , "narrator": "", "text": "なんか、照れる"},
        { "location": "136/ACT"   , "narrator": "", "text": "なんか、照れる"},
        { "location": "138/TALK"  , "narrator": "アーヤ", "text": "$handle$さんの"},
        { "location": "140/TALK"  , "narrator": "アーヤ", "text": "可愛い一面発見"},
        { "location": "142/ACT"   , "narrator": "", "text": "アーヤのおかげで気持ちは晴天"},
        { "location": "143/TALK"  , "narrator": "アーヤ", "text": "口が上手いのね"},
        { "location": "144/TALK"  , "narrator": "アーヤ", "text": "そういうことばかり言ってると"},
        { "location": "145/TALK"  , "narrator": "アーヤ", "text": "遊び人に見えるわよ？(￣Д￣ )"},
        { "location": "146/TALK"  , "narrator": "アーヤ", "text": "色んな女の人に言ってるんでしょ？"},
        { "location": "148/SEL"   , "narrator": "", "text": "生まれて初めて言った"},
        { "location": "149/ACT"   , "narrator": "", "text": "生まれて初めて言った"},
        { "location": "151/TALK"  , "narrator": "アーヤ", "text": "そうなの？＼(◎o◎)／"},
        { "location": "152/TALK"  , "narrator": "アーヤ", "text": "それならいいわ"},
        { "location": "153/TALK"  , "narrator": "アーヤ", "text": "他の人には言ったらダメよ( ・_・)σﾞ"},
        { "location": "155/TALK"  , "narrator": "アーヤ", "text": "そういえば今日ね"},
        { "location": "160/TALK"  , "narrator": "アーヤ", "text": "あ"},
        { "location": "161/TALK"  , "narrator": "アーヤ", "text": "待って"},
        { "location": "165/TALK"  , "narrator": "アーヤ", "text": "ごめん"},
        { "location": "167/TALK"  , "narrator": "アーヤ", "text": "また後で"},
        { "location": "168/TALK"  , "narrator": "アーヤ", "text": "どこかに落ちたみたいで停電"},
        { "location": "169/TALK"  , "narrator": "アーヤ", "text": "真っ暗で"},
        { "location": "170/TALK"  , "narrator": "アーヤ", "text": "つばめ達が怖がってる"},
        { "location": "172/SEL"   , "narrator": "", "text": "わかった、近くにいれなくてごめん"},
        { "location": "173/ACT"   , "narrator": "", "text": "わかった、近くにいれなくてごめん"},
        { "location": "175/TALK"  , "narrator": "アーヤ", "text": "スマホ越しでも"},
        { "location": "176/TALK"  , "narrator": "アーヤ", "text": "いてくれるだけで嬉しい"},
        { "location": "177/TALK"  , "narrator": "アーヤ", "text": "ちゃんと伝わってるから(*^^*)"},
        { "location": "178/TALK"  , "narrator": "アーヤ", "text": "また夜にね"},
        { "location": "181/TALK"  , "narrator": "アーヤ", "text": "でもやっぱり"},
        { "location": "182/TALK"  , "narrator": "アーヤ", "text": "少しだけ"},
        { "location": "185/TALK"  , "narrator": "ボイスメール", "text": "熱冷ましにアイスクリーム"},
        { "location": "203/TALK"  , "narrator": "アーヤ", "text": "今はこんな感じ"},
        { "location": "205/TALK"  , "narrator": "アーヤ", "text": "じゃあまたね"},
        { "location": "20/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>某月某日　 4:27 PM</color>\nとある雨の日、神楽坂トライナリーにて"},
