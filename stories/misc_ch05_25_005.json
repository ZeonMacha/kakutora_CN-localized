    [
        { "location": "8735/SCENARIO", "narrator": "", "text": "アンダーライン、ボーダーライン"},
        { "location": "8760/TALK"    , "narrator": "神楽", "text": "どうしても譲れない線ってあるわけでしょ"},
        { "location": "8761/TALK"    , "narrator": "神楽", "text": "それはお互い踏み越えないのがマナーだと思うわけ"},
        { "location": "8763/SEL"     , "narrator": "", "text": "だねえ"},
        { "location": "8764/SEL"     , "narrator": "", "text": "鈍い人いるよね"},
        { "location": "8765/SEL"     , "narrator": "", "text": "$me$は神楽になら何されてもいいよ"},
        { "location": "8766/ACT"     , "narrator": "", "text": "だねえ"},
        { "location": "8767/TALK"    , "narrator": "神楽", "text": "でしょー！！！！！"},
        { "location": "8768/ACT"     , "narrator": "", "text": "鈍い人いるよね"},
        { "location": "8769/TALK"    , "narrator": "神楽", "text": "そうなの！！！"},
        { "location": "8770/TALK"    , "narrator": "神楽", "text": "マジョリティの数の暴力大きらい！！！！"},
        { "location": "8771/ACT"     , "narrator": "", "text": "$me$は神楽になら何されてもいいよ"},
        { "location": "8773/TALK"    , "narrator": "神楽", "text": "よちよち$handle$"},
        { "location": "8775/TALK"    , "narrator": "神楽", "text": "その気持ちだけで充分ぴょん"},
        { "location": "8776/TALK"    , "narrator": "神楽", "text": "だってぴょんこが本気を出したらそんなこと言ってられなくなっちゃうからね★"},
        { "location": "8777/TALK"    , "narrator": "神楽", "text": "（暗黒微笑"},
        { "location": "8779/TALK"    , "narrator": "神楽", "text": "そんなこんなで"},
        { "location": "8780/TALK"    , "narrator": "神楽", "text": "本日はぴょんこ大変不愉快なことがあり大変におかんむりなわけです"},
        { "location": "8781/TALK"    , "narrator": "神楽", "text": "別にさーいいと思うのよ？"},
        { "location": "8782/TALK"    , "narrator": "神楽", "text": "趣味はどんな趣味持ってても"},
        { "location": "8783/TALK"    , "narrator": "神楽", "text": "それをわざわざ覗きに来て馬鹿にするの、そっちの方が全然悪趣味だと思う"},
        { "location": "8785/SEL"     , "narrator": "", "text": "おたく趣味は珍獣扱いされがちだからね…"},
        { "location": "8786/SEL"     , "narrator": "", "text": "品のない人いるよね"},
        { "location": "8787/SEL"     , "narrator": "", "text": "神楽がまともで$me$はうれしい"},
        { "location": "8788/ACT"     , "narrator": "", "text": "おたく趣味は珍獣扱いされがちだからね…"},
        { "location": "8789/TALK"    , "narrator": "神楽", "text": "珍獣っていうか害獣扱いじゃない！？"},
        { "location": "8790/TALK"    , "narrator": "神楽", "text": "そっちこそ保護区域に勝手に入ってくんな！！！"},
        { "location": "8791/ACT"     , "narrator": "", "text": "品のない人いるよね"},
        { "location": "8792/TALK"    , "narrator": "神楽", "text": "ほんとそう！！！"},
        { "location": "8793/TALK"    , "narrator": "神楽", "text": "人生貧しすぎだよね！"},
        { "location": "8794/ACT"     , "narrator": "", "text": "神楽がまともで$me$はうれしい"},
        { "location": "8796/TALK"    , "narrator": "神楽", "text": "、、、、まともっていうか"},
        { "location": "8798/TALK"    , "narrator": "神楽", "text": "仁義ない人が多すぎるだけぴょん"},
        { "location": "8799/TALK"    , "narrator": "神楽", "text": "ぴょんこは普通のことしか言ってないぴょん"},
        { "location": "8800/TALK"    , "narrator": "神楽", "text": "でもそう言われると調子に乗っちゃう！"},
        { "location": "8801/TALK"    , "narrator": "神楽", "text": "偉いぴょんこ偉い！！！"},
        { "location": "8802/TALK"    , "narrator": "神楽", "text": "うふふふふふふ～♪"}
