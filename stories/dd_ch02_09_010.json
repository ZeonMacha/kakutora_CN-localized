{
    "dir": "chap09/daydra/dd_ch02_09_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "9252",
        "cid": "ayami",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "読書はしますか？"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "読書はしますか？"},
        { "location": "25/TALK"   , "narrator": "アーヤ", "text": "へぇ、卯月は一ヶ月に\n十冊も本を読むんだ？"},
        { "location": "28/TALK"   , "narrator": "神楽", "text": "小説とはいっても\nライトノベルですよ。"},
        { "location": "29/TALK"   , "narrator": "神楽", "text": "だから集中して読めば、\n二時間か三時間くらいで\n読めちゃうんです。"},
        { "location": "30/TALK"   , "narrator": "神楽", "text": "…まあ、恐ろしく長いのは\n別ですけど。"},
        { "location": "31/TALK"   , "narrator": "アーヤ", "text": "それにしたって凄いわ。"},
        { "location": "32/TALK"   , "narrator": "アーヤ", "text": "私も高校くらいまでは\n結構読んでたけど――"},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "最近は全然よ。"},
        { "location": "34/TALK"   , "narrator": "神楽", "text": "そうなんですか。"},
        { "location": "35/TALK"   , "narrator": "神楽", "text": "ちなみに、今はどれくらい\n読むんですか？"},
        { "location": "37/TALK"   , "narrator": "アーヤ", "text": "え？　そうね…。"},
        { "location": "39/TALK"   , "narrator": "アーヤ", "text": "こういう場合って、\n漫画は抜きにしても――"},
        { "location": "40/TALK"   , "narrator": "アーヤ", "text": "どこまで読んだ数に\n入れていいのかしら？"},
        { "location": "43/TALK"   , "narrator": "アーヤ", "text": "…ちょっと待って。\n今、調べるから。"},
        { "location": "58/TALK"   , "narrator": "アーヤ", "text": "質問！"},
        { "location": "59/TALK"   , "narrator": "アーヤ", "text": "今月何冊本を読みましたか？"},
        { "location": "60/TALK"   , "narrator": "アーヤ", "text": "って聞かれた時に"},
        { "location": "61/TALK"   , "narrator": "アーヤ", "text": "小説以外に絵本も数えていいと思う(？＿？)"},
        { "location": "63/SEL"    , "narrator": "", "text": "もちろん"},
        { "location": "64/SEL"    , "narrator": "", "text": "いや、ダメだと思う"},
        { "location": "65/SEL"    , "narrator": "", "text": "雑誌も加えてＯＫ"},
        { "location": "66/ACT"    , "narrator": "", "text": "もちろん"},
        { "location": "67/TALK"   , "narrator": "アーヤ", "text": "なるほど"},
        { "location": "68/TALK"   , "narrator": "アーヤ", "text": "わかったわ"},
        { "location": "80/TALK"   , "narrator": "アーヤ", "text": "お待たせ。\n今月読んだのは――"},
        { "location": "82/TALK"   , "narrator": "アーヤ", "text": "三十冊、ってとこかしら。"},
        { "location": "84/TALK"   , "narrator": "神楽", "text": "…アーヤさんって、\nそんなに速読なんですか？"},
        { "location": "85/TALK"   , "narrator": "アーヤ", "text": "え？　もしかして、\n数えていいのは小説だけ\nだった？"},
        { "location": "86/TALK"   , "narrator": "アーヤ", "text": "それなら三冊か四冊、\nってところかしら。"},
        { "location": "87/TALK"   , "narrator": "神楽", "text": "もぉ、驚かさないで\nくださいよ。"},
        { "location": "90/TALK"   , "narrator": "アーヤ", "text": "ごめんごめん。\nどこまで入れていいのか、\n悩んじゃって…。"},
        { "location": "91/TALK"   , "narrator": "神楽", "text": "でも、アーヤさんなら\nそれくらい読んでたと\nしても――"},
        { "location": "93/TALK"   , "narrator": "神楽", "text": "あんまり不思議じゃない\n感じもしますけどね。"},
        { "location": "96/TALK"   , "narrator": "アーヤ", "text": "そんな風に見える？"},
        { "location": "98/TALK"   , "narrator": "アーヤ", "text": "けど、読みたい小説は\n沢山あるから――"},
        { "location": "99/TALK"   , "narrator": "アーヤ", "text": "それくらい読めるように\nなれたらいいなぁ、とは\n思うわ。"},
        { "location": "100/TALK"  , "narrator": "神楽", "text": "本が好きな人なら、\nみんなそう思いますよ。"},
        { "location": "103/TALK"  , "narrator": "アーヤ", "text": "そうね…。"},
        { "location": "104/TALK"  , "narrator": "アーヤ", "text": "来月は今月よりも\n多く読むのを目標に\nしようかしら？"},
        { "location": "105/ACT"   , "narrator": "", "text": "いや、ダメだと思う"},
        { "location": "106/TALK"  , "narrator": "アーヤ", "text": "やっぱりダメか(￣×￣)"},
        { "location": "107/TALK"  , "narrator": "アーヤ", "text": "ごめん、確認しただけだから"},
        { "location": "120/TALK"  , "narrator": "アーヤ", "text": "えっと…今月は四冊くらい\nしか読めてないわ。"},
        { "location": "121/TALK"  , "narrator": "神楽", "text": "なんだ、結構読んでるじゃ\nないですか。"},
        { "location": "122/TALK"  , "narrator": "アーヤ", "text": "そんなことないわ。\n一週間に一冊読めてるか\nどうかくらいじゃない。"},
        { "location": "123/TALK"  , "narrator": "神楽", "text": "でも、大学にバイト、\nトライナリーと忙しい\n生活の中で――"},
        { "location": "124/TALK"  , "narrator": "神楽", "text": "四冊も読んでるんだから\n凄いと思いますよ。"},
        { "location": "126/TALK"  , "narrator": "アーヤ", "text": "そっか…。\nそう言ってもらえると\n嬉しいわ。"},
        { "location": "127/TALK"  , "narrator": "アーヤ", "text": "…考えてみれば、\n時間がなくて読めない本、\n結構あるかも。"},
        { "location": "128/TALK"  , "narrator": "アーヤ", "text": "そのうち、ゆっくりと\n本だけを読む日を\n作りたいな。"},
        { "location": "129/ACT"   , "narrator": "", "text": "雑誌も加えてＯＫ"},
        { "location": "132/TALK"  , "narrator": "アーヤ", "text": "えっ！？"},
        { "location": "133/TALK"  , "narrator": "アーヤ", "text": "雑誌まで入れていいの？"},
        { "location": "134/TALK"  , "narrator": "アーヤ", "text": "それならそうするけど…"},
        { "location": "145/TALK"  , "narrator": "アーヤ", "text": "…本当にいいのかしら？"},
        { "location": "146/TALK"  , "narrator": "神楽", "text": "アーヤさん、何冊読んだか\nわかりましたか？"},
        { "location": "148/TALK"  , "narrator": "アーヤ", "text": "え、ええ…えっとね…。"},
        { "location": "152/TALK"  , "narrator": "アーヤ", "text": "五十冊くらい…かな。"},
        { "location": "154/TALK"  , "narrator": "神楽", "text": "ご、五十冊って…。"},
        { "location": "155/TALK"  , "narrator": "神楽", "text": "それ、雑誌とか漫画とかも\n入れてませんか？"},
        { "location": "157/TALK"  , "narrator": "アーヤ", "text": "あっ、小説だけだった？"},
        { "location": "159/TALK"  , "narrator": "神楽", "text": "やっぱり…\nさすがに変だと\n思いましたよ。"},
        { "location": "160/TALK"  , "narrator": "神楽", "text": "…でも、小説以外を\n足したとしても――"},
        { "location": "161/TALK"  , "narrator": "神楽", "text": "五十冊はかなり多い\nような…。"},
        { "location": "163/TALK"  , "narrator": "アーヤ", "text": "う～ん…そういえば、\n今月はいつもよりも\n少しだけ――"},
        { "location": "164/TALK"  , "narrator": "アーヤ", "text": "読んだ数が多いかも\nしれないわ。"},
        { "location": "165/TALK"  , "narrator": "神楽", "text": "読むの早いんですね。"},
        { "location": "166/TALK"  , "narrator": "神楽", "text": "そうだ！　アーヤさん\nって、ラノベを読んだ\nことありますか？"},
        { "location": "167/TALK"  , "narrator": "アーヤ", "text": "多分ないと思うわ。"},
        { "location": "168/TALK"  , "narrator": "神楽", "text": "それなら、この機会に\n一度読んでみませんか？"},
        { "location": "169/TALK"  , "narrator": "神楽", "text": "アーヤさんなら、私より\n早く読み終えることが\nできそうですし。"},
        { "location": "170/TALK"  , "narrator": "神楽", "text": "どれくらいの速さで\n読めるのか、見てみたいん\nです。"},
        { "location": "171/TALK"  , "narrator": "アーヤ", "text": "そうね…一度くらいは\n読んでみてもいいかも\nしれないわね。"},
        { "location": "172/TALK"  , "narrator": "アーヤ", "text": "お薦めの本があったら、\n今度貸してもらえる？"},
        { "location": "174/TALK"  , "narrator": "神楽", "text": "わかりました。"},
        { "location": "175/TALK"  , "narrator": "神楽", "text": "アーヤさんの趣味に\n合いそうなジャンルを、\n厳選してきますね！"},
        { "location": "177/TALK"  , "narrator": "アーヤ", "text": "ええ、よろしく。"},
        { "location": "179/TALK"  , "narrator": "神楽", "text": "…ちなみに、異世界召還\nとか、俺ＴＵＥＥＥとか\nってわかります？"},
        { "location": "182/TALK"  , "narrator": "アーヤ", "text": "…よくわからないから、\nそれ以外でお願いするわ。"},
        { "location": "15/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>5月22日　4:11 PM</color>\nとある平日、神楽坂トライナリーでのバイト中のこと。"},
        { "location": "193/DIALOG", "narrator": "Dialog_GEThimegoto_ch02", "text": "【軽さはりんご3個分】"}
    ]
}
