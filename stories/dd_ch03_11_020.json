{
    "dir": "chap11/daydra/dd_ch03_11_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "11356",
        "cid": "gabriella",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "片づけようか"
    },
    "entry":
    [
        { "location": "295/SCENARIO", "narrator": "", "text": "片付けようか"},
        { "location": "315/TALK"    , "narrator": "神楽", "text": "楽屋の小物、\nかなり増えてきましたね。"},
        { "location": "318/TALK"    , "narrator": "つばめ", "text": "卯月さんもそう思う？"},
        { "location": "319/TALK"    , "narrator": "つばめ", "text": "最近ね、小物が多過ぎて\n掃除するのが大変なの。"},
        { "location": "323/TALK"    , "narrator": "ガブリエラ", "text": "つばめ、文句ばっか\n言ってないで\n手を動かしなさい。"},
        { "location": "325/TALK"    , "narrator": "つばめ", "text": "動かしたいけど、\nガブちゃんの小物が\n多過ぎて…。"},
        { "location": "326/TALK"    , "narrator": "ガブリエラ", "text": "だから、文句を…！"},
        { "location": "329/TALK"    , "narrator": "神楽", "text": "仕方ないですよ、\nつばめさん。"},
        { "location": "331/TALK"    , "narrator": "神楽", "text": "だってガブちゃんは、\n片付けられない女、\nっていうやつですから。"},
        { "location": "334/TALK"    , "narrator": "ガブリエラ", "text": "誰が片付けられない\n女よ！？"},
        { "location": "337/TALK"    , "narrator": "神楽", "text": "だって、何でもかんでも\n置きっぱなしになってる\nじゃないですか。"},
        { "location": "338/TALK"    , "narrator": "神楽", "text": "これじゃどう見ても\n片付けられない女です。"},
        { "location": "340/TALK"    , "narrator": "神楽", "text": "ね、つばめさん？"},
        { "location": "344/TALK"    , "narrator": "つばめ", "text": "えっ！？　う、うん…\nちょっと、そう思われても\n仕方ないかも。"},
        { "location": "347/TALK"    , "narrator": "ガブリエラ", "text": "…言ってくれるじゃない。"},
        { "location": "351/TALK"    , "narrator": "ガブリエラ", "text": "そんなに言うなら、\nあんた達が驚くくらい\n綺麗に片付けてやるわ。"},
        { "location": "352/TALK"    , "narrator": "ガブリエラ", "text": "こう見えても、整理整頓は\n得意なんだから。"},
        { "location": "355/TALK"    , "narrator": "つばめ", "text": "本当！？\nそれ、凄く助かるよ！"},
        { "location": "358/TALK"    , "narrator": "ガブリエラ", "text": "ふん、これくらい…。"},
        { "location": "359/TALK"    , "narrator": "ガブリエラ", "text": "って、冷静に見てみると\nかなり多いかも…。"},
        { "location": "360/TALK"    , "narrator": "ガブリエラ", "text": "こんなに沢山の小物、\n部屋に飾れないわ。"},
        { "location": "372/TALK"    , "narrator": "ガブリエラ", "text": "どうしましょう、マルザンナ"},
        { "location": "374/TALK"    , "narrator": "ガブリエラ", "text": "楽屋の小物を片付けるって言ったんだけど"},
        { "location": "375/TALK"    , "narrator": "ガブリエラ", "text": "思ったより置いてある小物が多かったの"},
        { "location": "376/TALK"    , "narrator": "ガブリエラ", "text": "これじゃ、私の部屋に飾りきれないわ"},
        { "location": "378/SEL"     , "narrator": "", "text": "ダンボールに仕舞っておこう"},
        { "location": "379/SEL"     , "narrator": "", "text": "少し捨てるのは？"},
        { "location": "380/SEL"     , "narrator": "", "text": "映画館中に飾ろう"},
        { "location": "381/ACT"     , "narrator": "", "text": "ダンボールに仕舞っておこう"},
        { "location": "382/TALK"    , "narrator": "ガブリエラ", "text": "ダメよ！"},
        { "location": "383/TALK"    , "narrator": "ガブリエラ", "text": "インテリアとして置いて\nあるんだから"},
        { "location": "384/TALK"    , "narrator": "ガブリエラ", "text": "箱に入れたら意味がないじゃない！"},
        { "location": "385/TALK"    , "narrator": "ガブリエラ", "text": "もう、マルザンナってば\nわかってないんだから…"},
        { "location": "386/TALK"    , "narrator": "ガブリエラ", "text": "自分で考えるわ"},
        { "location": "398/TALK"    , "narrator": "ガブリエラ", "text": "…とはいったものの、\n本当にこれだけの小物を\nどうするか…。"},
        { "location": "399/TALK"    , "narrator": "つばめ", "text": "ガブちゃん、\nこれ用意したから\n使ってみて。"},
        { "location": "402/TALK"    , "narrator": "ガブリエラ", "text": "ちょ、やめてよ！\nダンボールになんて\n入れたくないわ。"},
        { "location": "405/TALK"    , "narrator": "つばめ", "text": "でも、いっぱいあるから\n手で部屋に持ってくのは\n無理じゃないかな？"},
        { "location": "408/TALK"    , "narrator": "ガブリエラ", "text": "そ、それはそうだけど…。"},
        { "location": "409/TALK"    , "narrator": "神楽", "text": "まあ、持って行く方法は\n何でもいいですけど――"},
        { "location": "410/TALK"    , "narrator": "神楽", "text": "片付けられると言ったん\nですから、ちゃんと\n片付けてくださいね。"},
        { "location": "413/TALK"    , "narrator": "ガブリエラ", "text": "くっ…わ、わかったわよ。\nダンボールに入れるわよ。"},
        { "location": "416/TALK"    , "narrator": "ガブリエラ", "text": "今だけは我慢するしか\nなさそう…。"},
        { "location": "417/TALK"    , "narrator": "ガブリエラ", "text": "ごめんね、ほとぼりが\n冷めたらまたこの部屋に\n戻してあげるからね。"},
        { "location": "418/ACT"     , "narrator": "", "text": "少し捨てるのは？"},
        { "location": "429/TALK"    , "narrator": "ガブリエラ", "text": "ダメよ、捨てるなんて！"},
        { "location": "431/TALK"    , "narrator": "ガブリエラ", "text": "どれもこれも素敵なものなんだから"},
        { "location": "432/TALK"    , "narrator": "ガブリエラ", "text": "捨てられるものなんて存在しないの！"},
        { "location": "443/TALK"    , "narrator": "ガブリエラ", "text": "失礼しちゃうわ、\nまったく…。"},
        { "location": "445/TALK"    , "narrator": "つばめ", "text": "ガブちゃん、これって\n本当に取っておく\n必要あるの？"},
        { "location": "446/TALK"    , "narrator": "つばめ", "text": "萎みきった水風船とか\n見つけたんですけど…。"},
        { "location": "449/TALK"    , "narrator": "ガブリエラ", "text": "えっ？"},
        { "location": "451/TALK"    , "narrator": "神楽", "text": "この棒って…あ、風車の\n羽根が取れちゃってる\nみたいですね。"},
        { "location": "452/TALK"    , "narrator": "つばめ", "text": "プラスチックの\n割れたお面は危ないと\n思うよ？"},
        { "location": "455/TALK"    , "narrator": "ガブリエラ", "text": "…こんなもの、あたし\n拾ってきたっけ？"},
        { "location": "456/TALK"    , "narrator": "ガブリエラ", "text": "でも、なんとなくだけど\n見覚えがあるような…。"},
        { "location": "457/TALK"    , "narrator": "つばめ", "text": "あの、どうする？\n部屋に持ってくなら\n手伝うけど…。"},
        { "location": "459/TALK"    , "narrator": "ガブリエラ", "text": "…よくわからないものは、\nおもいきって捨てるわ。"},
        { "location": "462/TALK"    , "narrator": "ガブリエラ", "text": "何でもかんでも持ってくる\nのは、少し控えよう。"},
        { "location": "479/ACT"     , "narrator": "", "text": "映画館中に飾ろう"},
        { "location": "481/TALK"    , "narrator": "ガブリエラ", "text": "それよ！！"},
        { "location": "482/TALK"    , "narrator": "ガブリエラ", "text": "それなら置き場所に困らないわ"},
        { "location": "483/TALK"    , "narrator": "ガブリエラ", "text": "さすがだわ、マルザンナ！"},
        { "location": "496/TALK"    , "narrator": "ガブリエラ", "text": "それじゃあ、映画館中に\n配置してくるわ。"},
        { "location": "499/TALK"    , "narrator": "つばめ", "text": "えっ！？\n片づけるんじゃ\nないの？"},
        { "location": "500/TALK"    , "narrator": "ガブリエラ", "text": "散らかって見えるのは、\n楽屋が小さいからよ。"},
        { "location": "501/TALK"    , "narrator": "ガブリエラ", "text": "広い映画館のあちこちに\n配置すれば、そんな風には\n見えないはずよ！"},
        { "location": "502/TALK"    , "narrator": "ガブリエラ", "text": "きっと見た人達から、\n素敵なインテリアね、って\n思われるわ。"},
        { "location": "504/TALK"    , "narrator": "つばめ", "text": "…そ、そうかなぁ？"},
        { "location": "505/TALK"    , "narrator": "神楽", "text": "ボロボロ過ぎて、わけの\nわからなくなった物も\nあるんですけど…。"},
        { "location": "506/TALK"    , "narrator": "ガブリエラ", "text": "大丈夫だってば。\nあたしを信じなさい！"},
        { "location": "509/TALK"    , "narrator": "神楽", "text": "…お客さんに、\nゴミと間違われなければ\nいいけど。"},
        { "location": "511/TALK"    , "narrator": "つばめ", "text": "それより、アーヤさんや\n真幌さんが怒るのが先だと\n思うなぁ…。"},
        { "location": "304/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>6月24日　4:48 PM</color>\nとある平日、神楽坂トライナリー劇場でのバイト中のこと。"},
        { "location": "424/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>500pt.</b></color></size>\nアップしました！"},
        { "location": "473/DIALOG"  , "narrator": "Dialog_GEThimegoto_ch03", "text": "【季節外れのサンタを希望】"}
    ]
}
