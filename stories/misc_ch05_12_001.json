    "entry":
    [
        { "location": "3350/SCENARIO", "narrator": "", "text": "帝都レコーズ配信開始"},
        { "location": "3375/TALK"    , "narrator": "神楽", "text": "我が帝都レコーズは本日より楽曲を配信する！！！"},
        { "location": "3376/TALK"    , "narrator": "神楽", "text": "心して聞くように！"},
        { "location": "3378/SEL"     , "narrator": "", "text": "本当なの？"},
        { "location": "3379/SEL"     , "narrator": "", "text": "ごめん言ってる意味がわかんない"},
        { "location": "3380/SEL"     , "narrator": "", "text": "平身低頭して聞き入ります閣下！"},
        { "location": "3381/ACT"     , "narrator": "", "text": "本当なの？"},
        { "location": "3382/TALK"    , "narrator": "神楽", "text": "うそですすみません"},
        { "location": "3383/ACT"     , "narrator": "", "text": "ごめん言ってる意味がわかんない"},
        { "location": "3384/TALK"    , "narrator": "神楽", "text": "なんですと！？"},
        { "location": "3386/TALK"    , "narrator": "神楽", "text": "アナログしかわからない子ちゃん？"},
        { "location": "3387/ACT"     , "narrator": "", "text": "平身低頭して聞き入ります閣下！"},
        { "location": "3389/TALK"    , "narrator": "神楽", "text": "そこまでせんでもよろしい"},
        { "location": "3390/TALK"    , "narrator": "神楽", "text": "１００００００回ダウンロードしてくれればそれでよい"},
        { "location": "3391/TALK"    , "narrator": "神楽", "text": "もちろん都度課金で"},
        { "location": "3392/TALK"    , "narrator": "神楽", "text": "$handlek$ならできるよね？"},
        { "location": "3393/TALK"    , "narrator": "神楽", "text": "ぴょんこ期待して待ってるぴょん♪"},
        { "location": "3395/TALK"    , "narrator": "神楽", "text": "レコーズとか言いながらレコード盤なんてマニアのための音源でしかないって現実はどうすればいいんだろうねー"},
        { "location": "3396/TALK"    , "narrator": "神楽", "text": "なんてことをぴょんこは考えたりもする"},
        { "location": "3398/SEL"     , "narrator": "", "text": "様式美ってやつだよ"},
        { "location": "3399/SEL"     , "narrator": "", "text": "わかりやすさ大事"},
        { "location": "3400/SEL"     , "narrator": "", "text": "神楽さえいれば$me$は満足"},
        { "location": "3401/ACT"     , "narrator": "", "text": "様式美ってやつだよ"},
        { "location": "3402/TALK"    , "narrator": "神楽", "text": "まあね"},
        { "location": "3403/ACT"     , "narrator": "", "text": "わかりやすさ大事"},
        { "location": "3404/TALK"    , "narrator": "神楽", "text": "なんとなくは伝わるけどさー"},
        { "location": "3405/ACT"     , "narrator": "", "text": "神楽さえいれば$me$は満足"},
        { "location": "3407/TALK"    , "narrator": "神楽", "text": "そんな話してないですけどー？"},
        { "location": "3409/TALK"    , "narrator": "神楽", "text": "でもまあいっかー"},
        { "location": "3410/TALK"    , "narrator": "神楽", "text": "よちよちいい子ですね～$handlek$～"},
        { "location": "3412/TALK"    , "narrator": "神楽", "text": "そのうちレコードだけじゃなくて"},
        { "location": "3413/TALK"    , "narrator": "神楽", "text": "雑誌とか本なんかも全部データになるのかな？"},
        { "location": "3414/TALK"    , "narrator": "神楽", "text": "なんて思ったり思ったりなのでした"},
        { "location": "3415/TALK"    , "narrator": "神楽", "text": "おしまい"}
    ]
}
