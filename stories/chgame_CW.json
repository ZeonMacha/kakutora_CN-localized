        { "location": "820/TALK"    , "narrator": "神楽", "text": "ようこそ月の泉へ\nいらっしゃいました\n旅のお方。"},
        { "location": "822/TALK"    , "narrator": "神楽", "text": "あ、でもあなた方は\n前に来てますよね。"},
        { "location": "823/TALK"    , "narrator": "神楽", "text": "プレゼントは初回限定で\nどちらか一つですよ♪"},
        { "location": "824/SEL"     , "narrator": "", "text": "残念"},
