        { "location": "842/TALK"    , "narrator": "神楽", "text": "あなた方が求めているのは\nこの『早婚の杖』ですか？\nそれとも――"},
        { "location": "843/TALK"    , "narrator": "神楽", "text": "こちらの\n『ジャンプリモコン』\nですか？"},
        { "location": "845/TALK"    , "narrator": "千羽鶴", "text": "どっちだと思う？"},
        { "location": "846/SEL"     , "narrator": "", "text": "早婚の杖"},
