{
    "dir": "chap36/daydra/dd_ch03_36_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "36302",
        "cid": "gabriella",
        "title": "002 メインストーリー",
        "sub_title": "完全封印事項＜前編＞"
    },
    "entry":
    [
        { "location": "40/TALK"   , "narrator": "ガブリエラ", "text": "…手が震えるわ…。"},
        { "location": "41/TALK"   , "narrator": "ガブリエラ", "text": "集中して、あたし。\n相手は強盗よ。"},
        { "location": "43/TALK"   , "narrator": "男Ａ", "text": "手を後ろに回して\n伏せろ！"},
        { "location": "44/TALK"   , "narrator": "ガブリエラ", "text": "気付かれる前に\n強盗に照準を\n合わせて…。"},
        { "location": "45/TALK"   , "narrator": "男Ｂ", "text": "さすがポーランド正規軍を\n束ねる方は\n堂々としておられる。"},
        { "location": "46/TALK"   , "narrator": "男Ｂ", "text": "陸軍参謀総長\nフランチシェク・\nロタルィンスカ中佐。"},
        { "location": "47/TALK"   , "narrator": "ガブリエラ", "text": "……え？"},
        { "location": "48/TALK"   , "narrator": "男Ｃ", "text": "しかし貴殿は国家を\n疲弊させ、おびただしい\n損害を与えた。"},
        { "location": "49/TALK"   , "narrator": "男Ｃ", "text": "この罪は重い。"},
        { "location": "50/TALK"   , "narrator": "男Ｂ", "text": "よって、我々解放戦線が\n制裁を与えるものとする。\n神に代わって。"},
        { "location": "53/TALK"   , "narrator": "ガブリエラ", "text": "違う、こいつら\n強盗なんかじゃない…！"},
        { "location": "54/TALK"   , "narrator": "男Ａ", "text": "我々の処罰はむしろ\n救済だ。"},
        { "location": "55/TALK"   , "narrator": "男Ａ", "text": "神の元へ寿命より少し\n早く導くための手引きを\nするだけだ。"},
        { "location": "56/TALK"   , "narrator": "男Ｂ", "text": "安心して旅立つがいい。\nロタルィンスカ中佐。"},
        { "location": "59/TALK"   , "narrator": "ガブリエラ", "text": "お父様が殺される！"},
        { "location": "60/TALK"   , "narrator": "ガブリエラ", "text": "殺される殺される殺される\n殺される殺される殺される\n殺される殺される殺される"},
        { "location": "62/TALK"   , "narrator": "ガブリエラ", "text": "銃を構えて！　あたし！\n照準を！　誰に！？"},
        { "location": "64/TALK"   , "narrator": "ガブリエラ", "text": "でないと殺される\n殺される殺される殺される\n殺される殺されるお父様！"},
        { "location": "68/TALK"   , "narrator": "男Ｂ", "text": "ポーランドに神の祝福を！\nポーランドに解放を！"},
        { "location": "69/TALK"   , "narrator": "ガブリエラ", "text": "殺される！！！！！"},
        { "location": "81/TALK"   , "narrator": "ガブリエラ", "text": "…っ…！"},
        { "location": "82/TALK"   , "narrator": "ガブリエラ", "text": "撃った！？\nあたし、今、撃った！？"},
        { "location": "83/TALK"   , "narrator": "男Ａ", "text": "おい！　大丈夫か！"},
        { "location": "84/TALK"   , "narrator": "男Ｃ", "text": "ダメだ、死んでる！"},
        { "location": "87/TALK"   , "narrator": "男Ａ", "text": "この家にはまだ\n誰かいるぞ！"},
        { "location": "88/TALK"   , "narrator": "男Ａ", "text": "２階だ！\n２階を攻撃しろ！"},
        { "location": "102/TALK"  , "narrator": "ガブリエラ", "text": "っ！！"},
        { "location": "103/TALK"  , "narrator": "ガブリエラ", "text": "死ぬ、死んじゃう…！\nあたし、あたし…\nこのままじゃ殺される！"},
        { "location": "104/TALK"  , "narrator": "男Ａ", "text": "行け！　２階だ！"},
        { "location": "108/TALK"  , "narrator": "ガブリエラ", "text": "あたし、あたし……"},
        { "location": "109/TALK"  , "narrator": "ガブリエラ", "text": "いやああああああああああ\nああああああああ！"},
        { "location": "112/TALK"  , "narrator": "男Ｃ", "text": "うわあぁあっ！"},
        { "location": "117/TALK"  , "narrator": "ガブリエラ", "text": "ああああああああああ\nああああああああ！"},
        { "location": "122/TALK"  , "narrator": "男Ａ", "text": "はぁあぁっ！"},
        { "location": "123/TALK"  , "narrator": "ガブリエラ", "text": "あああああああああ！"},
        { "location": "126/TALK"  , "narrator": "ガブリエラ", "text": "殺される殺される\n殺される殺される\n殺される殺される"},
        { "location": "142/SEL"   , "narrator": "", "text": "落ち着いて"},
        { "location": "143/ACT"   , "narrator": "", "text": "落ち着いて"},
        { "location": "147/TALK"  , "narrator": "ガブリエラ", "text": "殺される殺される\n殺される殺される\n殺される殺される"},
        { "location": "155/SEL"   , "narrator": "", "text": "落ち着け！"},
        { "location": "156/ACT"   , "narrator": "", "text": "落ち着け！"},
        { "location": "158/TALK"  , "narrator": "ガブリエラ", "text": "……！"},
        { "location": "178/TALK"  , "narrator": "ガブリエラの父", "text": "ヨアンナ！　ヨアンナ！"},
        { "location": "179/TALK"  , "narrator": "ガブリエラ", "text": "お父様…なんでそんなに\n必死にお母様の\n名前を……。"},
        { "location": "180/TALK"  , "narrator": "ガブリエラの父", "text": "ヨアンナ！\nヨアンナ…！"},
        { "location": "181/TALK"  , "narrator": "ガブリエラ", "text": "………………\n…ねえ、あたし……\n…お母様を…？"},
        { "location": "182/TALK"  , "narrator": "ガブリエラの父", "text": "ヨアンナ……っ！"},
        { "location": "221/TALK"  , "narrator": "マルザンナ　", "text": "命を賭けても\n今のあたしを守り抜く！"},
        { "location": "222/TALK"  , "narrator": "マークスマン", "text": "！？"},
        { "location": "223/TALK"  , "narrator": "リヴォルカ", "text": "ちょ、ちょっと！\nなんか嫌な予感が\nするんですけど！！"},
        { "location": "224/SEL"   , "narrator": "", "text": "ちょっと待て、落ち着け！"},
        { "location": "225/SEL"   , "narrator": "", "text": "マルザンナの本気を見た！加勢する！"},
        { "location": "226/ACT"   , "narrator": "", "text": "ちょっと待て、落ち着け！"},
        { "location": "229/TALK"  , "narrator": "マルザンナ　", "text": "なあに！？\nあんたと話すことなんて\nもう何も無いわ。"},
        { "location": "230/SEL"   , "narrator": "", "text": "$me$はガブリエラの事を思って選択してるんだよ"},
        { "location": "231/ACT"   , "narrator": "", "text": "$me$はガブリエラの事を思って選択してるんだよ"},
        { "location": "233/TALK"  , "narrator": "マルザンナ　", "text": "わからない。"},
        { "location": "234/TALK"  , "narrator": "リヴォルカ", "text": "いい加減にしたら？\nあんたとの思い出が\n消えるわけじゃないし。"},
        { "location": "236/ACT"   , "narrator": "", "text": "マルザンナの本気を見た！加勢する！"},
        { "location": "240/TALK"  , "narrator": "リヴォルカ", "text": "豚！？"},
        { "location": "241/TALK"  , "narrator": "マークスマン", "text": "……。"},
        { "location": "242/TALK"  , "narrator": "マルザンナ　", "text": "ありがとう、\n$handle$！"},
        { "location": "243/TALK"  , "narrator": "マルザンナ　", "text": "どうか、あたしと一緒に\nあたしの暴走を\n食い止めて！"},
        { "location": "244/TALK"  , "narrator": "リヴォルカ", "text": "おいちょとまて！！"},
        { "location": "254/TALK"  , "narrator": "マークスマン", "text": "前回時間をもらって\n色々考えてみたが。"},
        { "location": "255/TALK"  , "narrator": "マークスマン", "text": "種を失ったことについては\n１つの結論に達した。"},
        { "location": "256/TALK"  , "narrator": "マークスマン", "text": "だが、その前に――"},
        { "location": "257/TALK"  , "narrator": "マークスマン", "text": "$handle$よ、\n１つ質問したい。"},
        { "location": "260/TALK"  , "narrator": "マークスマン", "text": "何故そこまで頑なに\n発症を案ずる？"},
        { "location": "261/SEL"   , "narrator": "", "text": "ガブリエラが$me$の知ってるガブリエラではなくなってしまうから"},
        { "location": "262/SEL"   , "narrator": "", "text": "千羽鶴の考え方に賛同できないから"},
        { "location": "263/ACT"   , "narrator": "", "text": "ガブリエラが$me$の知ってるガブリエラではなくなってしまうから"},
        { "location": "264/TALK"  , "narrator": "リヴォルカ", "text": "だから、それは\nあんたの問題でしょ？"},
        { "location": "265/TALK"  , "narrator": "リヴォルカ", "text": "あたしの問題じゃないし。\nこれだから豚は……"},
        { "location": "266/TALK"  , "narrator": "マルザンナ　", "text": "ううん。\nそれはあたしの問題よ。"},
        { "location": "269/TALK"  , "narrator": "マルザンナ　", "text": "だって、あたしも\n$handle$と\n同じことを思ってるもの。"},
        { "location": "270/TALK"  , "narrator": "リヴォルカ", "text": "いい加減にしたら？\nあんたとの思い出が\n消えるわけじゃないし。"},
        { "location": "271/ACT"   , "narrator": "", "text": "千羽鶴の考え方に賛同できないから"},
        { "location": "272/TALK"  , "narrator": "マークスマン", "text": "なるほど。\nその気持ちに関しては\n分からなくもない。"},
        { "location": "273/TALK"  , "narrator": "マークスマン", "text": "だがこれは、千羽鶴との\n約束の為だけではない。\n己の想いも関係する。"},
        { "location": "274/TALK"  , "narrator": "マークスマン", "text": "故に、千羽鶴を信用\nできないのだとしても、\n私にとっては必要なのだ。"},
        { "location": "277/TALK"  , "narrator": "マルザンナ　", "text": "でも、そうしたら\nフェノメノンの中で\n作ってきた色んな想いは？"},
        { "location": "280/TALK"  , "narrator": "マークスマン", "text": "フェノメノンの中で\n培ってきた記憶や想いは\nすべて温存される。"},
        { "location": "281/TALK"  , "narrator": "マルザンナ　", "text": "そうじゃないの！"},
        { "location": "282/TALK"  , "narrator": "マルザンナ　", "text": "たとえそれが消えなくても\nそれはもう、\n“あたし”じゃないのよ！"},
        { "location": "283/TALK"  , "narrator": "マルザンナ　", "text": "マークスマンが\n言っていた通りよ。"},
        { "location": "284/TALK"  , "narrator": "マルザンナ　", "text": "あたしはあたしを\n“超越した視点で傍観”\nするしかできなくなる。"},
        { "location": "285/TALK"  , "narrator": "マルザンナ　", "text": "そこに、\n何の喜びがあるの？\n何の感動があるの？？"},
        { "location": "286/TALK"  , "narrator": "マルザンナ　", "text": "それはもう、\nあたしとは呼べない。"},
        { "location": "287/TALK"  , "narrator": "マルザンナ　", "text": "小説やゲームの主人公に\nなったあたしを、あたしが\n見ているだけに過ぎない。"},
        { "location": "288/TALK"  , "narrator": "リヴォルカ", "text": "あのさあ。\nそれじゃあたしは\nどうなるの？"},
        { "location": "289/TALK"  , "narrator": "リヴォルカ", "text": "あたしから見れば、\nあんたはあたしの皮を\n被った他人なのよ。"},
        { "location": "290/TALK"  , "narrator": "リヴォルカ", "text": "あたしという身体を使って\n勝手な物語を紡いでる。"},
        { "location": "291/TALK"  , "narrator": "リヴォルカ", "text": "それをずっと\n見せられてきた\nあたしの立場は？"},
        { "location": "296/SEL"   , "narrator": "", "text": "やっぱりガブリエラ総体でみたら発症して均一化するしかないんだよ！"},
        { "location": "297/SEL"   , "narrator": "", "text": "ちょっと！！\n重すぎるでしょこれ！！"},
        { "location": "298/ACT"   , "narrator": "", "text": "やっぱりガブリエラ総体でみたら発症して均一化するしかないんだよ！"},
        { "location": "299/TALK"  , "narrator": "マルザンナ　", "text": "わかった。\nもう何も言わない。"},
        { "location": "300/TALK"  , "narrator": "マルザンナ　", "text": "でも$handle$、\n誤解はしないでね？"},
        { "location": "301/TALK"  , "narrator": "マルザンナ　", "text": "あたしはあんたに対して\n負の感情は抱いてない。"},
        { "location": "302/TALK"  , "narrator": "マルザンナ　", "text": "むしろ、そこまで\nあたしのことを考えてる\nことに感謝してるのよ。"},
        { "location": "303/TALK"  , "narrator": "マルザンナ　", "text": "あたしだって、\nそうするのが公平かもって\n思ったりはする。"},
        { "location": "304/TALK"  , "narrator": "マルザンナ　", "text": "けど、それを肯定するのは\n今までのあたしの人生を…"},
        { "location": "305/TALK"  , "narrator": "マルザンナ　", "text": "フェノメノンの中だけの\n偽りの人生かも\nしれないけど――"},
        { "location": "306/TALK"  , "narrator": "マルザンナ　", "text": "それを、あたし自身が\n否定してしまうことに\nなるから。"},
        { "location": "307/TALK"  , "narrator": "マルザンナ　", "text": "だからあたしは、\nフェノメノンの中の\nあたしの為に戦う。"},
        { "location": "308/TALK"  , "narrator": "マルザンナ　", "text": "……最後まで戦う。"},
        { "location": "309/TALK"  , "narrator": "マルザンナ　", "text": "だから、\n$handle$にも\nお願いがあるの。"},
        { "location": "310/TALK"  , "narrator": "マルザンナ　", "text": "$handle$も、\nあなたの想いを妥協せず\n戦って欲しい。"},
        { "location": "311/TALK"  , "narrator": "マルザンナ　", "text": "それが今のあんたの、\nあたしに対する最大の\n愛情になるんだから。"},
        { "location": "313/ACT"   , "narrator": "", "text": "ちょっと！！\n重すぎるでしょこれ！！"},
        { "location": "317/SEL"   , "narrator": "", "text": "何かをとるには何かが犠牲になる。$me$は繭の中のガブリエラが好きなんだ"},
        { "location": "318/SEL"   , "narrator": "", "text": "ちょっと！！\n重すぎるでしょこれ！！"},
        { "location": "319/ACT"   , "narrator": "", "text": "何かをとるには何かが犠牲になる。$me$は繭の中のガブリエラが好きなんだ"},
        { "location": "320/TALK"  , "narrator": "リヴォルカ", "text": "……なるほどね。"},
        { "location": "321/TALK"  , "narrator": "リヴォルカ", "text": "豚にしては\nカッコイイ答えじゃない。"},
        { "location": "322/TALK"  , "narrator": "リヴォルカ", "text": "けど、あたしからは\n一言言わせてもらうわ。"},
        { "location": "323/TALK"  , "narrator": "リヴォルカ", "text": "あんたが護ってるその\nフェノメノンの中の\nあたしは、とても脆い。"},
        { "location": "324/TALK"  , "narrator": "リヴォルカ", "text": "針一本で風船がはじけ飛ぶ\nように、何かの拍子に\n消えてしまうもの。"},
        { "location": "325/TALK"  , "narrator": "リヴォルカ", "text": "それでも\n護ろうと思うわけ？"},
        { "location": "326/SEL"   , "narrator": "", "text": "そんなのは生きてたって同じ、死んだら終わりだし"},
        { "location": "327/SEL"   , "narrator": "", "text": "脆さは問題じゃない。$me$のガブリエラは繭の中だけってこと"},
        { "location": "328/ACT"   , "narrator": "", "text": "そんなのは生きてたって同じ、死んだら終わりだし"},
        { "location": "329/TALK"  , "narrator": "リヴォルカ", "text": "違うわよ。\nバカね、豚は。"},
        { "location": "330/TALK"  , "narrator": "リヴォルカ", "text": "現実のあたしも\n確かに死にはする。"},
        { "location": "331/TALK"  , "narrator": "リヴォルカ", "text": "けど、あたしが死ななく\nても世界が破裂して終わる\nなんてことはない。"},
        { "location": "332/TALK"  , "narrator": "リヴォルカ", "text": "そこに大きな\n差があるのよ。"},
        { "location": "333/TALK"  , "narrator": "リヴォルカ", "text": "……って。\nまあいいわ。"},
        { "location": "334/TALK"  , "narrator": "リヴォルカ", "text": "恐らく想いの問題だし、\nあんたに何言っても\nもう変わらないでしょ。"},
        { "location": "335/ACT"   , "narrator": "", "text": "脆さは問題じゃない。$me$のガブリエラは繭の中だけってこと"},
        { "location": "336/TALK"  , "narrator": "リヴォルカ", "text": "そこまで言い切るなら\nもう何も言わないわ。"},
        { "location": "337/TALK"  , "narrator": "リヴォルカ", "text": "あんたはあんたの\n信念を貫けばいい。"},
        { "location": "338/TALK"  , "narrator": "リヴォルカ", "text": "あたしはあたしの\n信念を貫く。\nただそれだけよ。"},
        { "location": "341/ACT"   , "narrator": "", "text": "ちょっと！！\n重すぎるでしょこれ！！"},
        { "location": "346/TALK"  , "narrator": "リヴォルカ", "text": "あらら、\n豚には荷が重すぎたか。"},
        { "location": "347/TALK"  , "narrator": "マルザンナ　", "text": "ごめんなさい、\nあたしのことで、大変な\n思いをさせちゃって。"},
        { "location": "348/SEL"   , "narrator": "", "text": "$me$には選択できません…"},
        { "location": "349/SEL"   , "narrator": "", "text": "もうちょっと先延ばしにできないのでしょうか？"},
        { "location": "350/ACT"   , "narrator": "", "text": "$me$には選択できません…"},
        { "location": "351/ACT"   , "narrator": "", "text": "もうちょっと先延ばしにできないのでしょうか？"},
        { "location": "353/TALK"  , "narrator": "リヴォルカ", "text": "まあまあ。別にそんな\n重く考えなくても\nいいのよ？"},
        { "location": "354/TALK"  , "narrator": "リヴォルカ", "text": "豚はあたしじゃ\nないんだし。"},
        { "location": "355/TALK"  , "narrator": "リヴォルカ", "text": "あんたは選択しなくても\n何の問題も無いんだから、\nそんなことで命削るな。"},
        { "location": "356/TALK"  , "narrator": "リヴォルカ", "text": "あたしたちは、\nあたし自身だから\nそうはいかないけど。"},
        { "location": "357/TALK"  , "narrator": "リヴォルカ", "text": "わかる？　ここに\n真の“重みの違い”が\nあるのよ。"},
        { "location": "358/TALK"  , "narrator": "リヴォルカ", "text": "それを分かった上で、\nあたしの今後に\n関わるか、関わらないか。"},
        { "location": "359/TALK"  , "narrator": "リヴォルカ", "text": "それはあんたが\n決めればいいこと。"},
        { "location": "360/TALK"  , "narrator": "リヴォルカ", "text": "あたしたちがあんたに\nお願いしたいことは、\nたったそれだけ。"},
        { "location": "361/SEL"   , "narrator": "", "text": "これからもガブリエラと共にいたいから、関わります"},
        { "location": "362/SEL"   , "narrator": "", "text": "適切な手段を使ってこの問題を先延ばし回避しつつ考える"},
        { "location": "363/ACT"   , "narrator": "", "text": "これからもガブリエラと共にいたいから、関わります"},
        { "location": "365/TALK"  , "narrator": "リヴォルカ", "text": "オーケー、良く言った。"},
        { "location": "366/TALK"  , "narrator": "リヴォルカ", "text": "あんたをタダの豚から\n金華豚に昇格してやるわ。"},
        { "location": "367/TALK"  , "narrator": "マルザンナ　", "text": "ありがとう、\n$handle$……。"},
        { "location": "368/ACT"   , "narrator": "", "text": "適切な手段を使ってこの問題を先延ばし回避する"},
        { "location": "379/TALK"  , "narrator": "マークスマン", "text": "１つだけ、\n戦う前に伝えておこう。"},
        { "location": "380/TALK"  , "narrator": "マークスマン", "text": "私という存在は、\nガブリエラの最も根幹に\n位置する存在。"},
        { "location": "381/TALK"  , "narrator": "マークスマン", "text": "私がセルフクランとして\nこの姿で顕在したのは、\n銃撃事件の時。"},
        { "location": "382/TALK"  , "narrator": "マークスマン", "text": "その日以来、ずっと\n私の眼は閉じたままだ。"},
        { "location": "383/TALK"  , "narrator": "マークスマン", "text": "何故かわかるか？\n眼を開く必要が\nないからだよ。"},
        { "location": "384/TALK"  , "narrator": "マークスマン", "text": "眼を開けば\n様々なものが網膜を通じ、\n脳に焼き付く。"},
        { "location": "385/TALK"  , "narrator": "マークスマン", "text": "そして、ココロに\n沢山の傷を\n作ることになる。"},
        { "location": "386/TALK"  , "narrator": "マークスマン", "text": "私は悟ったのだ。\n最も安全な生き方とは\nどうあるべきかを。"},
        { "location": "387/TALK"  , "narrator": "マークスマン", "text": "目を瞑り、\n全ての存在に銃口を\n向けていればいい。"},
        { "location": "388/SEL"   , "narrator": "", "text": "そんなの悲しすぎる"},
        { "location": "389/SEL"   , "narrator": "", "text": "完全に同意"},
        { "location": "390/ACT"   , "narrator": "", "text": "そんなの悲しすぎる"},
        { "location": "392/TALK"  , "narrator": "マークスマン", "text": "何故？\n安全に生きることは、\n生存の必須要件。"},
        { "location": "393/ACT"   , "narrator": "", "text": "完全に同意"},
        { "location": "395/TALK"  , "narrator": "マークスマン", "text": "とはいえ、たまには\n眼を開いてみたいと\n思うこともある。"},
        { "location": "396/TALK"  , "narrator": "マークスマン", "text": "その為には\n世界を変えなければ\nならない。わかるな？"},
        { "location": "397/TALK"  , "narrator": "マークスマン", "text": "最後にもう一度だけ、\nお前の想いを聞く。"},
        { "location": "398/TALK"  , "narrator": "マークスマン", "text": "我の昇華と\nフェノメノン発症は\n是か非か。"},
        { "location": "400/SEL"   , "narrator": "", "text": "変わらず、発症は是である"},
        { "location": "401/SEL"   , "narrator": "", "text": "やっぱり発症は非だと思う"},
        { "location": "402/ACT"   , "narrator": "", "text": "変わらず、発症は是である"},
        { "location": "404/TALK"  , "narrator": "マークスマン", "text": "わかった。"},
        { "location": "405/TALK"  , "narrator": "マークスマン", "text": "それでは、お前の想いも\n汲みつつ、フェノメノンを\n創造しようではないか。"},
        { "location": "406/TALK"  , "narrator": "マークスマン", "text": "より一層の高みに向かい、\n支援を頼んだぞ。"},
        { "location": "407/ACT"   , "narrator": "", "text": "やっぱり発症は非だと思う"},
        { "location": "409/TALK"  , "narrator": "リヴォルカ", "text": "はあ！？\nふざけないでよ！\nこの豚！！"},
        { "location": "411/TALK"  , "narrator": "マークスマン", "text": "そうか……。\nわかった。"},
        { "location": "412/TALK"  , "narrator": "マークスマン", "text": "お前の決断については\n私がとやかく言うべき\nことではない。"},
        { "location": "413/TALK"  , "narrator": "マークスマン", "text": "ただ、私は私を護る為に、\nお前に抵抗せねば\nならないようだ。"},
        { "location": "414/TALK"  , "narrator": "マークスマン", "text": "だが。\nその想いが誠なら、\n妥協せず立ち向かえ。"},
        { "location": "415/TALK"  , "narrator": "マークスマン", "text": "それが私に対する\n最高の愛情に\nなるのだから！"},
        { "location": "418/SEL"   , "narrator": "", "text": "変わらず、発症は非である"},
        { "location": "419/SEL"   , "narrator": "", "text": "やっぱり発症は是だと思う"},
        { "location": "420/ACT"   , "narrator": "", "text": "変わらず、発症は非である"},
        { "location": "422/TALK"  , "narrator": "マークスマン", "text": "そうか……。\nわかった。"},
        { "location": "423/TALK"  , "narrator": "マークスマン", "text": "お前の決断については\n私がとやかく言うべき\nことではない。"},
        { "location": "424/TALK"  , "narrator": "マークスマン", "text": "ただ、私は私を護る為に、\nお前に抵抗せねば\nならないようだ。"},
        { "location": "425/TALK"  , "narrator": "マークスマン", "text": "種はお前が無意識に\nリヴォルカから奪った。"},
        { "location": "426/TALK"  , "narrator": "マークスマン", "text": "すなわち、お前が\n私を昇華させまいとする\n影響を発しているのだ。"},
        { "location": "427/TALK"  , "narrator": "マークスマン", "text": "ならば、お前をここから\n永久排除すれば、\n種もまた戻るということ。"},
        { "location": "428/TALK"  , "narrator": "マークスマン", "text": "私はその為に\n戦わねばならないだろう。"},
        { "location": "429/TALK"  , "narrator": "マークスマン", "text": "だが。"},
        { "location": "430/TALK"  , "narrator": "マークスマン", "text": "お前もその想いが誠なら、\n妥協せず立ち向かえ。"},
        { "location": "431/TALK"  , "narrator": "マークスマン", "text": "それが私に対する\n最高の愛情に\nなるのだから。"},
        { "location": "432/ACT"   , "narrator": "", "text": "やっぱり発症は是だと思う"},
        { "location": "434/TALK"  , "narrator": "マルザンナ　", "text": "ええっ！！\n…そんな……。"},
        { "location": "435/TALK"  , "narrator": "リヴォルカ", "text": "どうしちゃったの急に！？\nちょっと引くわ……。"},
        { "location": "436/TALK"  , "narrator": "マークスマン", "text": "……。"},
        { "location": "437/TALK"  , "narrator": "マークスマン", "text": "リヴォルカ。\n種はどうだ。"},
        { "location": "438/TALK"  , "narrator": "リヴォルカ", "text": "え？"},
        { "location": "439/TALK"  , "narrator": "リヴォルカ", "text": "あああっ！\n種が戻ってるわ！"},
        { "location": "440/TALK"  , "narrator": "マークスマン", "text": "やはりそうか。"},
        { "location": "441/TALK"  , "narrator": "マークスマン", "text": "種はお前が無意識に\nリヴォルカから奪った。"},
        { "location": "442/TALK"  , "narrator": "マークスマン", "text": "すなわち、お前が\n私を昇華させまいとする\n影響を発しているのだ。"},
        { "location": "443/TALK"  , "narrator": "マークスマン", "text": "ならば、お前の考えが\n変わればまた、戻る\n可能性があったのだ。"},
        { "location": "444/TALK"  , "narrator": "マークスマン", "text": "それでは、お前の想いも\n汲みつつ、フェノメノンを\n創造しようではないか。"},
        { "location": "445/TALK"  , "narrator": "マークスマン", "text": "より一層の高みに向かい、\n支援を頼んだぞ。"},
