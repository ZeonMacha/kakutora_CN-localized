{
    "dir": "chap19/daydra/dd_ch02_19_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "19205",
        "cid": "ayami",
        "title": "005 メインストーリー",
        "sub_title": "気にしすぎの湯＜後編＞"
    },
    "entry":
    [
        { "location": "467/TALK"  , "narrator": "アーヤ", "text": "…でも、やっぱり\n仲直りした方が\nいいかも。"},
        { "location": "468/TALK"  , "narrator": "アーヤ", "text": "私がギャヴィ達の話を\n聞いてなかったのは\n事実なんだし。"},
        { "location": "469/TALK"  , "narrator": "アーヤ", "text": "それに…三人で\n気持ちよくお風呂にも\n入りたいし。"},
        { "location": "471/TALK"  , "narrator": "アーヤ", "text": "…まあ、卯月の件は\n正直不安ではあるけど。"},
        { "location": "473/TALK"  , "narrator": "アーヤ", "text": "でも、ギャヴィ達が\n一緒なんだから\n大丈夫よね。"},
        { "location": "474/TALK"  , "narrator": "みやび", "text": "お？　なんやなんや？\nうちら信頼されちょる\nっちゅうことか？"},
        { "location": "475/TALK"  , "narrator": "アーヤ", "text": "当然でしょ？"},
        { "location": "476/TALK"  , "narrator": "アーヤ", "text": "つばめ達が入隊する\nまではずっと三人で\n頑張ってきたんだし。"},
        { "location": "477/TALK"  , "narrator": "アーヤ", "text": "それに、今回の件は\n私だけで手に負えない\nもの。"},
        { "location": "478/TALK"  , "narrator": "アーヤ", "text": "二人にも手伝って\nもらわなきゃ。"},
        { "location": "479/TALK"  , "narrator": "アーヤ", "text": "だから、その時は\nお願いしていい？"},
        { "location": "480/TALK"  , "narrator": "みやび", "text": "まあ、これも先輩\nとしての仕事の一つ\nやきね。"},
        { "location": "482/TALK"  , "narrator": "アーヤ", "text": "ありがと。"},
        { "location": "483/TALK"  , "narrator": "アーヤ", "text": "ギャヴィは？"},
        { "location": "485/TALK"  , "narrator": "ガブリエラ", "text": "…一応あたし、\n最年少なんだけど？"},
        { "location": "486/TALK"  , "narrator": "アーヤ", "text": "最年少だったら\n頼りにならないの？"},
        { "location": "487/TALK"  , "narrator": "アーヤ", "text": "そんなことないでしょ？\nだから\n信頼してるのよ。"},
        { "location": "488/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "489/TALK"  , "narrator": "ガブリエラ", "text": "ま、まあ…、\nそうまで言うなら\n仕方ないわね。"},
        { "location": "490/TALK"  , "narrator": "ガブリエラ", "text": "正直、すっっっごく\n面倒よ。\nそれは間違いない。"},
        { "location": "491/TALK"  , "narrator": "ガブリエラ", "text": "でも、困ったときは\nちゃんとフォローして\nあげるわ。"},
        { "location": "493/TALK"  , "narrator": "アーヤ", "text": "ありがと…。\nおかげで、ちょっと\n気が軽くなったわ。"},
        { "location": "494/TALK"  , "narrator": "みやび", "text": "礼はハワイ旅行か\n最新型のタブレットで\nよろしく。"},
        { "location": "496/TALK"  , "narrator": "アーヤ", "text": "両方とも無理だから、\n心を込めて背中を\n流させてもらうわ。"},
        { "location": "497/TALK"  , "narrator": "ガブリエラ", "text": "えっ！？\nい、いいわよ。\n別にそんなこと…。"},
        { "location": "498/TALK"  , "narrator": "みやび", "text": "おっ、それもえいな。\nそれじゃ遠慮なく\n頼むとするがよ。"},
        { "location": "499/TALK"  , "narrator": "ガブリエラ", "text": "ちょ、本気！？"},
        { "location": "500/TALK"  , "narrator": "みやび", "text": "人の親切は素直に\n受けるもんや。"},
        { "location": "501/TALK"  , "narrator": "みやび", "text": "ほれ、早く脱ぎぃ。\nちんたらしゆうと、\nうちが脱がすぞね？"},
        { "location": "503/TALK"  , "narrator": "ガブリエラ", "text": "わ、わかったわよ！\nもう…。"},
        { "location": "530/TALK"  , "narrator": "アーヤ", "text": "さっぱりしたわぁ…。"},
        { "location": "531/TALK"  , "narrator": "アーヤ", "text": "やっぱり、訓練の後の\nお風呂って、最高ね。"},
        { "location": "532/TALK"  , "narrator": "みやび", "text": "うむ…ちっくと\nうとうとしてしもうた\nがよ。"},
        { "location": "533/TALK"  , "narrator": "アーヤ", "text": "実際、何度かお湯に\n顔浸かって、慌てて\n起きてたわね。"},
        { "location": "535/TALK"  , "narrator": "みやび", "text": "一回、鼻にお湯入って\n最悪だったぞね。"},
        { "location": "536/TALK"  , "narrator": "ガブリエラ", "text": "っていうかさー、\nそんな大きな浮き輪\n二つもあるじゃない！"},
        { "location": "537/TALK"  , "narrator": "ガブリエラ", "text": "それでどうして\n溺れそうに\nなるのよ？"},
        { "location": "538/TALK"  , "narrator": "みやび", "text": "浮き輪として使う\n目的で付いとるわけや\nないきね。"},
        { "location": "540/TALK"  , "narrator": "アーヤ", "text": "もう、バカなこと\n言ってるんじゃ\nないの。"},
        { "location": "541/SEL"   , "narrator": "", "text": "背中、ちゃんと流してあげた？"},
        { "location": "542/SEL"   , "narrator": "", "text": "随分労ったみたいだね"},
        { "location": "543/ACT"   , "narrator": "", "text": "背中、ちゃんと流してあげた？"},
        { "location": "560/TALK"  , "narrator": "アーヤ", "text": "もちろん(^^"},
        { "location": "562/TALK"  , "narrator": "アーヤ", "text": "でも"},
        { "location": "563/TALK"  , "narrator": "アーヤ", "text": "お返しって言われて"},
        { "location": "564/TALK"  , "narrator": "アーヤ", "text": "私も流してもらった(*^^*)"},
        { "location": "565/TALK"  , "narrator": "アーヤ", "text": "気持ちよかったわ(￣∇￣)"},
        { "location": "567/SEL"   , "narrator": "", "text": "$me$も見たかった"},
        { "location": "568/SEL"   , "narrator": "", "text": "明日は今日以上に頑張れるね"},
        { "location": "569/ACT"   , "narrator": "", "text": "$me$も見たかった"},
        { "location": "571/TALK"  , "narrator": "アーヤ", "text": "浴場にスマホ持ち込めないし(-ω-;)"},
        { "location": "572/TALK"  , "narrator": "アーヤ", "text": "っていうか"},
        { "location": "573/TALK"  , "narrator": "アーヤ", "text": "エッチなこと言わないの（｀皿´ )"},
        { "location": "576/TALK"  , "narrator": "アーヤ", "text": "バカ"},
        { "location": "577/ACT"   , "narrator": "", "text": "明日は今日以上に頑張れるね"},
        { "location": "578/TALK"  , "narrator": "アーヤ", "text": "そうね(^^"},
        { "location": "579/TALK"  , "narrator": "アーヤ", "text": "二人から"},
        { "location": "580/TALK"  , "narrator": "アーヤ", "text": "やる気もらったんだし(>_<)"},
        { "location": "581/TALK"  , "narrator": "アーヤ", "text": "明日が楽しみ(=^0^=)"},
        { "location": "583/ACT"   , "narrator": "", "text": "随分労ったみたいだね"},
        { "location": "600/TALK"  , "narrator": "アーヤ", "text": "そのつもりよ(^^"},
        { "location": "602/TALK"  , "narrator": "アーヤ", "text": "卯月がメノウってわかってから"},
        { "location": "603/TALK"  , "narrator": "アーヤ", "text": "他の子のこと"},
        { "location": "604/TALK"  , "narrator": "アーヤ", "text": "なんとなく"},
        { "location": "605/TALK"  , "narrator": "アーヤ", "text": "疎かにしちゃってたし(・・。)ゞ"},
        { "location": "606/TALK"  , "narrator": "アーヤ", "text": "二人のこと"},
        { "location": "607/TALK"  , "narrator": "アーヤ", "text": "ちゃんと信頼してるって"},
        { "location": "608/TALK"  , "narrator": "アーヤ", "text": "伝わったかしら(>_<)"},
        { "location": "610/SEL"   , "narrator": "", "text": "背中流すのって関係あったの？"},
        { "location": "611/ACT"   , "narrator": "", "text": "背中流すのって関係あったの？"},
        { "location": "614/TALK"  , "narrator": "アーヤ", "text": "まあ"},
        { "location": "615/TALK"  , "narrator": "アーヤ", "text": "あれよ"},
        { "location": "618/TALK"  , "narrator": "アーヤ", "text": "謝罪と反省の気持ち(｡-_-｡)"},
        { "location": "620/TALK"  , "narrator": "アーヤ", "text": "頼りにしてますって"},
        { "location": "621/TALK"  , "narrator": "アーヤ", "text": "行動で示してみた"},
        { "location": "622/TALK"  , "narrator": "アーヤ", "text": "わかった？( ・_・)σﾞ"},
        { "location": "644/DIALOG", "narrator": "Dialog_chapter_ch02", "text": "【MV EXE_GARBiELa】"}
    ]
}
