        { "location": "1183/TALK", "narrator": "プレイヤー", "text": "お着替えしてみよう"},
        { "location": "1185/TALK", "narrator": "プレイヤー", "text": "違う服を着てほしいな"},
        { "location": "1187/TALK", "narrator": "プレイヤー", "text": "よし、お着替えタイムだ！"},
        { "location": "1193/TALK", "narrator": "プレイヤー", "text": "やあ"},
        { "location": "1195/TALK", "narrator": "プレイヤー", "text": "こんにちは"},
        { "location": "1197/TALK", "narrator": "プレイヤー", "text": "げんき？"},
        { "location": "1200/TALK", "narrator": "神楽", "text": "ぴょんこを呼ぶ声"},
        { "location": "1201/TALK", "narrator": "神楽", "text": "あなたはだあれ？"},
        { "location": "1203/SEL" , "narrator": "", "text": "$handle$だよ"},
        { "location": "1204/ACT" , "narrator": "", "text": "$handle$だよ"},
        { "location": "1206/TALK", "narrator": "神楽", "text": "知ってるし"},
        { "location": "1207/TALK", "narrator": "神楽", "text": "ぴょんこに用事ぴょん？"},
        { "location": "1210/SEL" , "narrator": "", "text": "ちょっと着替えてほしいんだ"},
        { "location": "1211/ACT" , "narrator": "", "text": "ちょっと着替えてほしいんだ"},
        { "location": "1221/TALK", "narrator": "神楽", "text": "意味不明すぎ"},
        { "location": "1222/TALK", "narrator": "神楽", "text": "でもまあ"},
        { "location": "1223/TALK", "narrator": "神楽", "text": "優しいぴょんこは聞いてあげるのだった"},
        { "location": "1225/TALK", "narrator": "神楽", "text": "は？"},
        { "location": "1226/TALK", "narrator": "神楽", "text": "この服変だった？"},
        { "location": "1227/TALK", "narrator": "神楽", "text": "なら着替えるけど"},
        { "location": "1230/SEL" , "narrator": "", "text": "$me$が選ぶ"},
        { "location": "1231/SEL" , "narrator": "", "text": "やっぱやめる"},
        { "location": "1233/TALK", "narrator": "神楽", "text": "…………"},
        { "location": "1236/TALK", "narrator": "神楽", "text": "リクエストないとか？"},
        { "location": "1237/TALK", "narrator": "神楽", "text": "なら着ない"},
        { "location": "1239/ACT" , "narrator": "", "text": "$me$が選ぶ"},
        { "location": "1240/TALK", "narrator": "神楽", "text": "だと思った"},
        { "location": "1241/TALK", "narrator": "神楽", "text": "どれを着てほしいと？"},
        { "location": "1248/ACT" , "narrator": "", "text": "やっぱやめる"},
        { "location": "1249/TALK", "narrator": "神楽", "text": "ありえネー"}
    ]
