{
    "dir": "chap31/daydra/anime_04_31.js",
    "type": "MainStory",
    "info": {
        "story_id": "31401",
        "cid": "miyabi",
        "title": "001 アニメーション",
        "sub_title": "K THE METAL IDOL"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "アニメ第31話"},
        { "location": "48/TALK"   , "narrator": "エリカ", "text": "こんにちは、\n$handle$さん。"},
        { "location": "50/TALK"   , "narrator": "エリカ", "text": "前に色々話したから、\n今回はつばめちゃんの\nお話をするだけでもいい？"},
        { "location": "52/TALK"   , "narrator": "エリカ", "text": "前に色々話したから、\n今回は綾ちゃんの\nお話をするだけでもいい？"},
        { "location": "54/TALK"   , "narrator": "エリカ", "text": "前に色々話したから、\n今回はガブリエラちゃんの\nお話をするだけでもいい？"},
        { "location": "56/TALK"   , "narrator": "エリカ", "text": "前に色々話したから、\n今回はみやびちゃんの\nお話をするだけでもいい？"},
        { "location": "58/SEL"    , "narrator": "", "text": "はい"},
        { "location": "59/SEL"    , "narrator": "", "text": "いいえ"},
        { "location": "60/ACT"    , "narrator": "", "text": "はい"},
        { "location": "62/TALK"   , "narrator": "エリカ", "text": "うん、わかった。"},
        { "location": "64/ACT"    , "narrator": "", "text": "いいえ"},
        { "location": "66/TALK"   , "narrator": "エリカ", "text": "はーい。\nそれじゃ、少しだけ\n巻き戻しするね？"},
        { "location": "72/TALK"   , "narrator": "エリカ", "text": "コーンコン。"},
        { "location": "73/TALK"   , "narrator": "エリカ", "text": "前回はまた１回お休み\nしちゃってごめんね！"},
        { "location": "74/TALK"   , "narrator": "エリカ", "text": "どうかな？\n元気でやってたかな？"},
        { "location": "75/SEL"    , "narrator": "", "text": "息災でした"},
        { "location": "76/SEL"    , "narrator": "", "text": "エリカに会えなくて寂しかった"},
        { "location": "77/SEL"    , "narrator": "", "text": "そろそろ千羽鶴に替わって欲しい"},
        { "location": "78/ACT"    , "narrator": "", "text": "息災でした"},
        { "location": "81/TALK"   , "narrator": "エリカ", "text": "よかった！"},
        { "location": "82/TALK"   , "narrator": "エリカ", "text": "元気で無事故が\n一番だよね。"},
        { "location": "83/TALK"   , "narrator": "エリカ", "text": "それでね、前回休んだ\n理由の、千羽鶴ちゃんの\nことなんだけど――"},
        { "location": "84/ACT"    , "narrator": "", "text": "エリカに会えなくて寂しかった"},
        { "location": "87/TALK"   , "narrator": "エリカ", "text": "ああっ！\nご、ごめんね！"},
        { "location": "88/TALK"   , "narrator": "エリカ", "text": "これからは、何かあっても\nなるべく休まないように\n気をつけるからね？"},
        { "location": "89/TALK"   , "narrator": "エリカ", "text": "それでね、前回休んだ\n理由の、千羽鶴ちゃんの\nことなんだけど――"},
        { "location": "90/ACT"    , "narrator": "", "text": "そろそろ千羽鶴に替わって欲しい"},
        { "location": "93/TALK"   , "narrator": "エリカ", "text": "そっかー。"},
        { "location": "94/TALK"   , "narrator": "エリカ", "text": "$handle$さんは\n千羽鶴ちゃんが\n大好きなんだね。"},
        { "location": "95/TALK"   , "narrator": "エリカ", "text": "まあ確かに、\nこんなオバサンが相手\nするより全然いいよね！"},
        { "location": "96/TALK"   , "narrator": "エリカ", "text": "それとも、\nあれかな…？"},
        { "location": "97/TALK"   , "narrator": "エリカ", "text": "あなたは、\n千羽鶴ちゃんの考えを\n支持してるのかな？"},
        { "location": "98/SEL"    , "narrator": "", "text": "そうです"},
        { "location": "99/SEL"    , "narrator": "", "text": "それはないかな"},
        { "location": "100/ACT"   , "narrator": "", "text": "そうです"},
        { "location": "101/TALK"  , "narrator": "エリカ", "text": "そっかそっか！\n人それぞれだもんね。"},
        { "location": "102/TALK"  , "narrator": "エリカ", "text": "でも困ったな。"},
        { "location": "103/TALK"  , "narrator": "エリカ", "text": "そうは言っても、私は\n綾ちゃんたちを危険な目に\n遭わせられないから。"},
        { "location": "104/TALK"  , "narrator": "エリカ", "text": "あなたも\nそう思うでしょ？"},
        { "location": "105/SEL"   , "narrator": "", "text": "そりゃそうだ"},
        { "location": "106/SEL"   , "narrator": "", "text": "千羽鶴の為ならアーヤの命だって厭わない"},
        { "location": "107/ACT"   , "narrator": "", "text": "そりゃそうだ"},
        { "location": "109/TALK"  , "narrator": "エリカ", "text": "だよね。"},
        { "location": "110/TALK"  , "narrator": "エリカ", "text": "だから、少なくとも\n千羽鶴ちゃんが具体的に\n何をするつもりか――"},
        { "location": "111/TALK"  , "narrator": "エリカ", "text": "それがわかるまでは、\nわたしで我慢して\nくれないかな…？"},
        { "location": "112/TALK"  , "narrator": "エリカ", "text": "無理言っちゃって\nごめんね？"},
        { "location": "113/ACT"   , "narrator": "", "text": "千羽鶴の為ならアーヤの命だって厭わない"},
        { "location": "116/TALK"  , "narrator": "エリカ", "text": "ええっ！！\nそうなの！？"},
        { "location": "117/TALK"  , "narrator": "エリカ", "text": "うーん、それは……"},
        { "location": "118/TALK"  , "narrator": "エリカ", "text": "身内だからという事を\n抜きにしても、かなり\n心配になる発言だね。"},
        { "location": "119/TALK"  , "narrator": "エリカ", "text": "まあでも……"},
        { "location": "120/TALK"  , "narrator": "エリカ", "text": "綾ちゃんといえども、\n他の誰とも変わらない、\n１人の人間でしかない。"},
        { "location": "121/TALK"  , "narrator": "エリカ", "text": "だから、大勢と１人\nもしくは数人と考えると\n解らなくはないかな。"},
        { "location": "122/TALK"  , "narrator": "エリカ", "text": "ただ、わたしが\n気になってるのはね――"},
        { "location": "123/TALK"  , "narrator": "エリカ", "text": "あなたが、千羽鶴ちゃんの\n思想と今後の方針を\nどれだけ共有してるか。"},
        { "location": "124/TALK"  , "narrator": "エリカ", "text": "もしそれが、彼女自身と\n同じくらい細かく共有\nしているならば……"},
        { "location": "125/TALK"  , "narrator": "エリカ", "text": "その上で、彼女の思想に\n賛成して、綾ちゃんの命も\n厭わないなら仕方ない。"},
        { "location": "126/TALK"  , "narrator": "エリカ", "text": "もちろんわたしは、\n綾ちゃんを守ることに\n最善を尽くすけどね。"},
        { "location": "127/TALK"  , "narrator": "エリカ", "text": "でも、それと\nあなたの思想の自由とは、\n全く別の問題だもん。"},
        { "location": "129/ACT"   , "narrator": "", "text": "それはないかな"},
        { "location": "130/TALK"  , "narrator": "エリカ", "text": "そっか！\nよかった！"},
        { "location": "131/TALK"  , "narrator": "エリカ", "text": "うーん、でも\nそうだとすると……"},
        { "location": "132/TALK"  , "narrator": "エリカ", "text": "容姿が好みってこと？\nそれとも性格？"},
        { "location": "133/SEL"   , "narrator": "", "text": "容姿"},
        { "location": "134/SEL"   , "narrator": "", "text": "性格"},
        { "location": "135/SEL"   , "narrator": "", "text": "もっと深遠なもの"},
        { "location": "136/ACT"   , "narrator": "", "text": "容姿"},
        { "location": "137/TALK"  , "narrator": "エリカ", "text": "なるほど！\nそれはわかるよ。"},
        { "location": "138/ACT"   , "narrator": "", "text": "性格"},
        { "location": "139/TALK"  , "narrator": "エリカ", "text": "そうなんだ！"},
        { "location": "140/TALK"  , "narrator": "エリカ", "text": "千羽鶴ちゃんの性格は\nあなたにとって\nかわいいんだね！"},
        { "location": "141/ACT"   , "narrator": "", "text": "もっと深遠なもの"},
        { "location": "142/TALK"  , "narrator": "エリカ", "text": "ええっ！\nそうなんだ…。"},
        { "location": "143/TALK"  , "narrator": "エリカ", "text": "うーん、どんな\n事なのかな……？"},
        { "location": "144/TALK"  , "narrator": "エリカ", "text": "でも、それは貴方にも\nわからないのかも\nしれないね。"},
        { "location": "146/TALK"  , "narrator": "エリカ", "text": "でもね、やっぱり\n彼女の何かが好みって\nいうだけで――"},
        { "location": "147/TALK"  , "narrator": "エリカ", "text": "綾ちゃんたちの命を\n危険に晒しちゃうのは、\nやっぱり怖いかな。"},
        { "location": "148/TALK"  , "narrator": "エリカ", "text": "だから、少なくとも\n千羽鶴ちゃんが具体的に\n何をするつもりか――"},
        { "location": "149/TALK"  , "narrator": "エリカ", "text": "それがわかるまでは、\nわたしで我慢して\nくれないかな…？"},
        { "location": "150/TALK"  , "narrator": "エリカ", "text": "無理言っちゃって\nごめんね？"},
        { "location": "152/TALK"  , "narrator": "エリカ", "text": "それでね、\nその千羽鶴ちゃん\nなんだけど――"},
        { "location": "154/TALK"  , "narrator": "エリカ", "text": "現在の所在が\n特定出来たの。"},
        { "location": "155/TALK"  , "narrator": "エリカ", "text": "地下鉄後楽園駅付近、\n東京砲兵工廠跡内にある\n施設にいたんだよ。"},
        { "location": "156/SEL"   , "narrator": "", "text": "どこそれ"},
        { "location": "157/SEL"   , "narrator": "", "text": "ああ、あそこね"},
        { "location": "158/ACT"   , "narrator": "", "text": "どこそれ"},
        { "location": "159/TALK"  , "narrator": "エリカ", "text": "文京ドームの真下かな。"},
        { "location": "160/TALK"  , "narrator": "エリカ", "text": "昔の兵器工場の\n地下射撃実験場だね。"},
        { "location": "161/TALK"  , "narrator": "エリカ", "text": "あそこの地下鉄駅が\n深い理由のひとつだって\n言われてる。"},
        { "location": "162/TALK"  , "narrator": "エリカ", "text": "地下の浅いところを\n沢山の地下壕が占め\nちゃってるんだろうね。"},
        { "location": "163/TALK"  , "narrator": "エリカ", "text": "もちろん、\n大規模共同溝のことも\nあるんだろうけど。"},
        { "location": "164/TALK"  , "narrator": "エリカ", "text": "それにしても、こんな所に\nラボがあるなんて\n知らなかったよ。"},
        { "location": "165/TALK"  , "narrator": "エリカ", "text": "状況改変で\n作ったのかな？\n彼女のフェノメノンだし。"},
        { "location": "166/ACT"   , "narrator": "", "text": "ああ、あそこね"},
        { "location": "168/TALK"  , "narrator": "エリカ", "text": "ええっ！？\nなんで知ってるの！？"},
        { "location": "169/TALK"  , "narrator": "エリカ", "text": "まあいいか、今は\nそれどころじゃないし。"},
        { "location": "170/TALK"  , "narrator": "エリカ", "text": "その辺は今度ゆっくりと\n教えてもらおうかな。"},
        { "location": "172/TALK"  , "narrator": "エリカ", "text": "それでね、\n中まで追跡できれば\n良かったんだけど――"},
        { "location": "173/TALK"  , "narrator": "エリカ", "text": "かなり複雑で大きな\n施設みたいで、ちょっと\nそれは出来なかったの。"},
        { "location": "174/TALK"  , "narrator": "エリカ", "text": "でも、今後の動向想定は\nだいたい掴むことが\n出来たんだ。"},
        { "location": "175/TALK"  , "narrator": "エリカ", "text": "だから、つばめちゃんや\n神楽ちゃんを助けるため\n先回りしようと思う。"},
        { "location": "176/TALK"  , "narrator": "エリカ", "text": "今、綾ちゃんたちには、\nあなたを通じて色んな\n準備をしてもらってる。"},
        { "location": "177/TALK"  , "narrator": "エリカ", "text": "その準備は、\n今回をもってだいたい\n終わると思うの。"},
        { "location": "178/TALK"  , "narrator": "エリカ", "text": "そうしたら、いよいよ\nつばめちゃんを救出しに\n行くからね。"},
        { "location": "180/TALK"  , "narrator": "エリカ", "text": "色々協力してくれて\n助かってるよ。この後も\nよろしくお願いします！"},
        { "location": "181/SEL"   , "narrator": "", "text": "こちらこそ"},
        { "location": "182/SEL"   , "narrator": "", "text": "エリカの目的は何なの？"},
        { "location": "183/ACT"   , "narrator": "", "text": "こちらこそ"},
        { "location": "184/TALK"  , "narrator": "エリカ", "text": "うん。"},
        { "location": "185/ACT"   , "narrator": "", "text": "エリカの目的は何なの？"},
        { "location": "187/TALK"  , "narrator": "エリカ", "text": "目的…かぁ。"},
        { "location": "188/TALK"  , "narrator": "エリカ", "text": "わたしは単に、\n綾ちゃんや、まほちゃん\nたちを助けたいだけ。"},
        { "location": "189/TALK"  , "narrator": "エリカ", "text": "過去に自分がしてしまった\n過ちは、もはや無かった\nことにはできないけど――"},
        { "location": "190/TALK"  , "narrator": "エリカ", "text": "だったら、\n全力で償いはしなくちゃ\nいけないと思うから。"},
        { "location": "191/TALK"  , "narrator": "エリカ", "text": "それだけだから、\nわたしには千羽鶴ちゃんと\n違って何もないの。"},
        { "location": "192/TALK"  , "narrator": "エリカ", "text": "大きな理想も、\n未来のビジョンも、\n野望なんかも何も無い。"},
        { "location": "193/TALK"  , "narrator": "エリカ", "text": "わたしはただの\nいち技術者であって、\n統率者じゃないから。"},
        { "location": "194/TALK"  , "narrator": "エリカ", "text": "でも、それでも\n一市民として、ううん、\nそれ以上に……"},
        { "location": "195/TALK"  , "narrator": "エリカ", "text": "それ以上に、いろんな\n思想や計画、国家政策を\n目の当たりにしてきた。"},
        { "location": "196/TALK"  , "narrator": "エリカ", "text": "だから、その見地からの\n自分なりの考えや、\nなって欲しい形はある。"},
        { "location": "197/TALK"  , "narrator": "エリカ", "text": "わたしはいち科学者として\nその知識だけを頼りに、\nそこに向かってるだけ。"},
        { "location": "198/TALK"  , "narrator": "エリカ", "text": "……なんて言っても、\n結局は身近な人の幸せを\n守りたいだけなんだけど。"},
        { "location": "200/TALK"  , "narrator": "エリカ", "text": "あなたのことも\n含めてね。"},
        { "location": "202/TALK"  , "narrator": "エリカ", "text": "こんな感じで、\n答えになってるかな？"},
        { "location": "204/TALK"  , "narrator": "エリカ", "text": "それじゃ今回も、\nまずは記録映像を\n見よっか。"},
        { "location": "206/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/82MB 5:14】</color>"},
        { "location": "207/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/27MB 5:14】</color>"},
        { "location": "208/SEL"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "209/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/82MB 5:14】</color>"},
        { "location": "210/TALK"  , "narrator": "エリカ", "text": "わかった。"},
        { "location": "216/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/27MB 5:14】</color>"},
        { "location": "217/TALK"  , "narrator": "エリカ", "text": "わかった。"},
        { "location": "223/ACT"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "224/TALK"  , "narrator": "エリカ", "text": "あらら。"},
        { "location": "257/TALK"  , "narrator": "エリカ", "text": "順調順調。"},
        { "location": "258/TALK"  , "narrator": "エリカ", "text": "まほちゃんがちゃんと\n理解してくれて\n安心したよ。"},
        { "location": "260/SEL"   , "narrator": "", "text": "メノウの歌が、つばめのココロを洗脳から防いだの？"},
        { "location": "261/SEL"   , "narrator": "", "text": "エリカの個人ラボって、そんなの持ってたの！？"},
        { "location": "262/SEL"   , "narrator": "", "text": "もう大丈夫 \n<color=blue>（※先へ進みます）</color>"},
        { "location": "263/ACT"   , "narrator": "", "text": "メノウの歌が、つばめのココロを洗脳から防いだの？"},
        { "location": "264/TALK"  , "narrator": "エリカ", "text": "そうだよ。"},
        { "location": "265/TALK"  , "narrator": "エリカ", "text": "でも、そう聞いてくる\n気持ちはよくわかるよ。"},
        { "location": "266/TALK"  , "narrator": "エリカ", "text": "メノウちゃんの歌が、\nこの世界の危機を\n防いでる…なんて。"},
        { "location": "267/TALK"  , "narrator": "エリカ", "text": "なんだか地に足が\nついてない、非科学的な\n感じだよね。"},
        { "location": "268/TALK"  , "narrator": "エリカ", "text": "でも、これも\n日常的に起こってることに\n過ぎないんだよ？"},
        { "location": "269/TALK"  , "narrator": "エリカ", "text": "洗脳っていうのは、\n脳に無理矢理色んな事を\n思い込ませること。"},
        { "location": "270/TALK"  , "narrator": "エリカ", "text": "でも、脳内で起こってる\nことは、思い出の積み\n重ねとなんら変わりない。"},
        { "location": "271/TALK"  , "narrator": "エリカ", "text": "だから、洗脳で得た知識と\n相反する思い出があった\n場合、どちらが勝つか――"},
        { "location": "272/TALK"  , "narrator": "エリカ", "text": "それは単純に、\n双方の想いの強さによって\n決まるだけ。"},
        { "location": "273/TALK"  , "narrator": "エリカ", "text": "乱暴な言い方をすれば、\n歌もまた洗脳の１つと\n言えるかも。"},
        { "location": "274/TALK"  , "narrator": "エリカ", "text": "そして、歌っていうのは\n不思議な力を持ってる。"},
        { "location": "275/SEL"   , "narrator": "", "text": "不思議な力って、もしかして魔法とかですか？"},
        { "location": "276/ACT"   , "narrator": "", "text": "不思議な力って、もしかして魔法とかですか？"},
        { "location": "278/TALK"  , "narrator": "エリカ", "text": "ごめんね。\nそういうのじゃないんだ。"},
        { "location": "279/TALK"  , "narrator": "エリカ", "text": "もっと身近な、\nきっと貴方にも\n経験があること。"},
        { "location": "280/TALK"  , "narrator": "エリカ", "text": "ふと昔聞いてた音楽が\n耳に入ったり、思い\n出したりしたとき――"},
        { "location": "281/TALK"  , "narrator": "エリカ", "text": "その当時の感覚や空気、\n感情、思考に支配された\nことはない？"},
        { "location": "282/TALK"  , "narrator": "エリカ", "text": "例えば、受験の頃に\n聞いていた音楽を、\n何年後かに聴いてみる。"},
        { "location": "283/TALK"  , "narrator": "エリカ", "text": "すると、その時の思い出が\n記憶としてではなく、\n感覚として蘇る。"},
        { "location": "284/TALK"  , "narrator": "エリカ", "text": "あの時の想い、景色、\n考えていたこと、気持ち、\n空気、音――"},
        { "location": "285/TALK"  , "narrator": "エリカ", "text": "そう、あなたの頭の\n中には、一瞬にして、\n当時の世界が広がる。"},
        { "location": "286/SEL"   , "narrator": "", "text": "それ、わかる！"},
        { "location": "287/SEL"   , "narrator": "", "text": "そういう感覚になったことはないな"},
        { "location": "288/ACT"   , "narrator": "", "text": "それ、わかる！"},
        { "location": "290/TALK"  , "narrator": "エリカ", "text": "でしょ？"},
        { "location": "291/ACT"   , "narrator": "", "text": "そういう感覚になったことはないな"},
        { "location": "293/TALK"  , "narrator": "エリカ", "text": "そっかー。"},
        { "location": "295/TALK"  , "narrator": "エリカ", "text": "人によって\n感覚は違うものね。"},
        { "location": "297/TALK"  , "narrator": "エリカ", "text": "音楽は、そういった\n思い出の引き出しを\n保存する力を持ってる。"},
        { "location": "298/TALK"  , "narrator": "エリカ", "text": "ましてや、メノウちゃんの\n曲には明確な世界があって\nイメージがしやすい。"},
        { "location": "299/TALK"  , "narrator": "エリカ", "text": "更に、つばめちゃんが\nそれを聞いていたのは、\n生死の狭間の時期。"},
        { "location": "300/TALK"  , "narrator": "エリカ", "text": "これだけの条件が\n整っていたら、音楽は\n心の奥底に焼き付く。"},
        { "location": "301/TALK"  , "narrator": "エリカ", "text": "しかもそれは、本人に\nとっては『希望』という\n強烈な観念となって――"},
        { "location": "302/TALK"  , "narrator": "エリカ", "text": "洗脳工作によっても\n否定することは\nできなかった。"},
        { "location": "303/TALK"  , "narrator": "エリカ", "text": "洗脳に打ち勝てるだけの\n力を持つ観念って、\n凄いものなんだよ？"},
        { "location": "304/TALK"  , "narrator": "エリカ", "text": "それだけつばめちゃんの\n中で、メノウちゃんの\n曲は特別ってことなの。"},
        { "location": "306/TALK"  , "narrator": "エリカ", "text": "他はどうかな？"},
        { "location": "308/ACT"   , "narrator": "", "text": "エリカの個人ラボって、そんなの持ってたの！？"},
        { "location": "309/TALK"  , "narrator": "エリカ", "text": "わたしが個人で\n作ったものじゃないよ。"},
        { "location": "310/TALK"  , "narrator": "エリカ", "text": "エヴェレット研究所が\n松代にある広大な地下洞に\n可能性を見いだして。"},
        { "location": "311/TALK"  , "narrator": "エリカ", "text": "そこに研究所が\n作られることになったの。"},
        { "location": "312/TALK"  , "narrator": "エリカ", "text": "その存在を紹介したのは\nわたしだけどね。"},
        { "location": "313/SEL"   , "narrator": "", "text": "つばめのフェノメノンって、そんな施設まで再現されてるの！？"},
        { "location": "314/SEL"   , "narrator": "", "text": "エリカも千羽鶴と似たようなことをやってるね"},
        { "location": "315/ACT"   , "narrator": "", "text": "つばめのフェノメノンって、そんな施設まで再現されてるの！？"},
        { "location": "316/TALK"  , "narrator": "エリカ", "text": "実は、これだけは\nわたしが混ぜ込んだ\n情報なの。"},
        { "location": "317/TALK"  , "narrator": "エリカ", "text": "秘密の研究施設だから、\nつばめちゃんは知らないし\nあなたの世界にもない。"},
        { "location": "318/TALK"  , "narrator": "エリカ", "text": "だから当然、そのままだと\nフェノメノンの中には\n再現されない。"},
        { "location": "319/TALK"  , "narrator": "エリカ", "text": "けど、ここだけは\nどうしても必要になる、\n重要な施設だったから――"},
        { "location": "320/TALK"  , "narrator": "エリカ", "text": "レディネスを介して\n送られて来ている貴方の\n世界情報にマージしてる。"},
        { "location": "321/TALK"  , "narrator": "エリカ", "text": "なんて大げさなことを\n言ってるけど、やってる\nことはあなたと同じ。"},
        { "location": "322/TALK"  , "narrator": "エリカ", "text": "TRI-OSの\n１ユーザーとして\n情報を与えてるだけだよ。"},
        { "location": "323/ACT"   , "narrator": "", "text": "エリカも千羽鶴と似たようなことをやってるね"},
        { "location": "325/TALK"  , "narrator": "エリカ", "text": "確かにそうかも。"},
        { "location": "328/TALK"  , "narrator": "エリカ", "text": "他はどうかな？"},
        { "location": "330/ACT"   , "narrator": "", "text": "もう大丈夫 \n<color=blue>（※先へ進みます）</color>"},
        { "location": "332/TALK"  , "narrator": "エリカ", "text": "わかった。"},
        { "location": "334/TALK"  , "narrator": "エリカ", "text": "それでね、\n今回なんだけど――"},
        { "location": "335/TALK"  , "narrator": "エリカ", "text": "記録映像でも少し出ていた\n音羽ちゃんの修復について\n手伝って欲しいの。"},
        { "location": "336/TALK"  , "narrator": "エリカ", "text": "音羽ちゃんの修復には\n精神世界の中にダイブする\n必要がある。"},
        { "location": "337/TALK"  , "narrator": "エリカ", "text": "それを松代の\n小型サイクロトロンで\nやるんだけど……"},
        { "location": "338/TALK"  , "narrator": "エリカ", "text": "顕在意識が精神世界に\n入り込むのって、実は\nちょっとリスクがあるの。"},
        { "location": "339/TALK"  , "narrator": "エリカ", "text": "だから、あなたにも\n彼女たちに同行して、\n見守って欲しいんだ。"},
        { "location": "340/TALK"  , "narrator": "エリカ", "text": "その為に前回、\nちょっと準備を\nしておいたの。"},
        { "location": "341/TALK"  , "narrator": "エリカ", "text": "心の葛藤が無くても、\n強制的にココロスフィアへ\nダイブ出来るようにした。"},
        { "location": "342/TALK"  , "narrator": "エリカ", "text": "決め打ちでココロ\nアドレスを指定するから\n使い勝手は良くないけど。"},
        { "location": "343/TALK"  , "narrator": "エリカ", "text": "あと、葛藤がない状態で\nココロに入るから、\n悩みの解決は不要だよ。"},
        { "location": "344/TALK"  , "narrator": "エリカ", "text": "ただ、それ以外にも\nちょっと気になってる\nことがあって。"},
        { "location": "345/TALK"  , "narrator": "エリカ", "text": "最近、なんだか彼女たちの\nココロの中が、ざわついて\nいるような兆候があるの。"},
        { "location": "346/TALK"  , "narrator": "エリカ", "text": "何か心当たりはある？"},
        { "location": "347/SEL"   , "narrator": "", "text": "セルフクランに何か起きそう"},
        { "location": "348/SEL"   , "narrator": "", "text": "司書たちが可愛すぎる"},
        { "location": "349/ACT"   , "narrator": "", "text": "セルフクランに何か起きそう"},
        { "location": "350/TALK"  , "narrator": "エリカ", "text": "やっぱり……。"},
        { "location": "351/TALK"  , "narrator": "エリカ", "text": "わたしは、具体的に\nこの目でその様子を\n見ることができないの。"},
        { "location": "352/TALK"  , "narrator": "エリカ", "text": "ココロの中には、入れる\nところもあれば入れない\nところもあって。"},
        { "location": "354/TALK"  , "narrator": "エリカ", "text": "だから、ココロの中の\nことはあなたにお任せ\nするしか無いけど――"},
        { "location": "355/TALK"  , "narrator": "エリカ", "text": "なにかあったら、\nすぐに報告してね。"},
        { "location": "356/TALK"  , "narrator": "エリカ", "text": "わたしも外側から、\nココロに干渉するものが\nないか探ってみるね。"},
        { "location": "357/TALK"  , "narrator": "エリカ", "text": "千羽鶴ちゃんは、\n今はもう何もできない\nはずなんだけど……"},
        { "location": "358/TALK"  , "narrator": "エリカ", "text": "もしかしたら、もっと\n違う所からの干渉が\nあるかもしれないから。"},
        { "location": "359/ACT"   , "narrator": "", "text": "司書たちが可愛すぎる"},
        { "location": "360/TALK"  , "narrator": "エリカ", "text": "そっかー。\nそれはとっても\nいいことだと思うよ？"},
        { "location": "361/TALK"  , "narrator": "エリカ", "text": "司書が可愛いのは、\n彼女たちが輝いてる\n証拠だから。"},
        { "location": "362/TALK"  , "narrator": "エリカ", "text": "司書っていうのは、\n外向的な性格に対して\n干渉する行為なの。"},
        { "location": "363/TALK"  , "narrator": "エリカ", "text": "だから、そこに登場する\n彼女たちは、最も社交的で\n人なつっこい筈なんだ。"},
        { "location": "364/TALK"  , "narrator": "エリカ", "text": "これからも、\n司書ちゃんたちと\n仲良くしてあげてね？"},
        { "location": "373/TALK"  , "narrator": "エリカ", "text": "それで、今回の\nつばめちゃんだけど……"},
        { "location": "374/TALK"  , "narrator": "エリカ", "text": "特に状況が進展して\nいないから、あまり\nやることは無くて。"},
        { "location": "375/TALK"  , "narrator": "エリカ", "text": "ただ、精神的に辛いと\n思うから、話し相手に\nなってあげて欲しいかな。"},
        { "location": "376/TALK"  , "narrator": "エリカ", "text": "心の葛藤が起きなければ\nココロスフィアにも\n行く必要はないし。"},
        { "location": "377/TALK"  , "narrator": "エリカ", "text": "宜しくお願いします！"},
        { "location": "381/TALK"  , "narrator": "エリカ", "text": "さて、それでね、\n今回の綾ちゃんにして\n欲しいことだけど――"},
        { "location": "382/TALK"  , "narrator": "エリカ", "text": "綾ちゃんの場合、\n特に重要な役割があるの。"},
        { "location": "383/TALK"  , "narrator": "エリカ", "text": "松代のラボにある装置は\n基本、起動するために\n生体認証を使ってるんだ。"},
        { "location": "384/TALK"  , "narrator": "エリカ", "text": "それが遺伝子認証を\n利用してるから、綾ちゃん\nにしか起動できないの。"},
        { "location": "385/TALK"  , "narrator": "エリカ", "text": "だから、綾ちゃんには\n真っ先にダイブをして\nもらわないといけない。"},
        { "location": "386/TALK"  , "narrator": "エリカ", "text": "それは精神的にかなり\n不安も大きいと思うから、\n支えてあげて欲しいかな。"},
        { "location": "387/TALK"  , "narrator": "エリカ", "text": "ココロの大きな揺れは、\nダイブを失敗させて\nしまう事もあるから。"},
        { "location": "391/TALK"  , "narrator": "エリカ", "text": "さて、それでね、\n今回のガブリエラちゃんに\nお願いしたいことは――"},
        { "location": "392/TALK"  , "narrator": "エリカ", "text": "やっぱり綾ちゃんの\nサポートを\nしてもらいたいかな。"},
        { "location": "393/TALK"  , "narrator": "エリカ", "text": "今回、音羽ちゃんを\n治すのにラボを使って\nもらうわけだけど。"},
        { "location": "394/TALK"  , "narrator": "エリカ", "text": "その装置は、國政家の\n遺伝子認証によって\n起動するようになってる。"},
        { "location": "395/TALK"  , "narrator": "エリカ", "text": "だから綾ちゃんには\n真っ先にダイブして\nもらう事になるわけで。"},
        { "location": "396/TALK"  , "narrator": "エリカ", "text": "それをサポートして\nもらったり、万が一には\nダイブしてもらったり。"},
        { "location": "397/TALK"  , "narrator": "エリカ", "text": "そういったことを\nしてもらいたいんだよね。"},
        { "location": "398/TALK"  , "narrator": "エリカ", "text": "何だかんだで\n一番綾ちゃんのことを\n大切にしてくれてるし。"},
        { "location": "399/TALK"  , "narrator": "エリカ", "text": "わたしも、\nガブリエラちゃんなら\n安心できるかなって。"},
        { "location": "400/TALK"  , "narrator": "エリカ", "text": "もし、ガブリエラちゃんが\nダイブするようなことが\nあったら――"},
        { "location": "401/TALK"  , "narrator": "エリカ", "text": "ちょっとご挨拶がてら、\n逢いに行くかもしれない。"},
        { "location": "402/TALK"  , "narrator": "エリカ", "text": "その時はよろしくね。"},
        { "location": "406/TALK"  , "narrator": "エリカ", "text": "さて、それでね。\n今回のみやびちゃんに\nお願いしたいことは――"},
        { "location": "407/TALK"  , "narrator": "エリカ", "text": "音羽ちゃんのココロ\nアドレスの取得と、\nその繋ぎ込みかな。"},
        { "location": "408/TALK"  , "narrator": "エリカ", "text": "簡単に言えば、\n音羽ちゃんを治して\nもらうんだけど……"},
        { "location": "409/TALK"  , "narrator": "エリカ", "text": "上手くいくかどうかは、\n音羽ちゃんの気分次第って\nところもあって。"},
        { "location": "410/TALK"  , "narrator": "エリカ", "text": "どう転ぶかは\n正直わからないの。"},
        { "location": "411/TALK"  , "narrator": "エリカ", "text": "あなたには、\nそのあたりでサポートを\nお願いしたいかも。"},
        { "location": "415/TALK"  , "narrator": "エリカ", "text": "毎回いろいろお\n願いしちゃって\nごめんね？"},
        { "location": "417/TALK"  , "narrator": "エリカ", "text": "でも、手伝ってくれて\nありがとう。"},
        { "location": "418/TALK"  , "narrator": "エリカ", "text": "今回のが成功すれば、\nかなり状況が改善されると\n思うから。"},
        { "location": "420/TALK"  , "narrator": "エリカ", "text": "それじゃ、\n今回もよろしくね！"},
        { "location": "234/DIALOG", "narrator": "Tutorial/Dialog_Anime1", "text": "$dialog_word$"},
        { "location": "236/DIALOG", "narrator": "Tutorial/Dialog_Anime2", "text": "$dialog_word$"},
        { "location": "238/DIALOG", "narrator": "Tutorial/Dialog_Anime3", "text": "$dialog_word$"},
        { "location": "240/DIALOG", "narrator": "Tutorial/Dialog_Anime4", "text": "$dialog_word$"},
        { "location": "242/DIALOG", "narrator": "Tutorial/Dialog_Anime5", "text": "$dialog_word$"}
    ]
}
