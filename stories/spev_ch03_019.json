{
    "dir": "chap00/daydra/spev_ch03_019.js",
    "type": "EventQuest",
    "info": {
        "story_id": "91014",
        "cid": "gabriella",
        "title": "【期間限定】誕生日イベント",
        "sub_title": "ガブリエラの誕生日"
    },
    "entry":
    [
        { "location": "8/SCENARIO", "narrator": "", "text": "ガブリエラの誕生日（復元）"},
        { "location": "20/TALK"   , "narrator": "ガブリエラ", "text": "どうしたの？\nなにか用事？"},
        { "location": "22/SEL"    , "narrator": "", "text": "お誕生日おめでとう！"},
        { "location": "23/ACT"    , "narrator": "", "text": "お誕生日おめでとう！"},
        { "location": "25/TALK"   , "narrator": "ガブリエラ", "text": "えっ？"},
        { "location": "26/TALK"   , "narrator": "ガブリエラ", "text": "あ、あたしの誕生日、\n覚えてたの…？"},
        { "location": "27/TALK"   , "narrator": "ガブリエラ", "text": "そっか…。\nふふっ、さすがは\nマルサンナね！"},
        { "location": "28/TALK"   , "narrator": "ガブリエラ", "text": "あたしの誕生日を\n忘れずに覚えてるなんて\n思わなかったわ。"},
        { "location": "29/TALK"   , "narrator": "ガブリエラ", "text": "あ、えっと……\n一応、ありがと…。"},
        { "location": "30/SEL"    , "narrator": "", "text": "プレゼントもあるよ"},
        { "location": "31/ACT"    , "narrator": "", "text": "プレゼントもあるよ"},
        { "location": "33/TALK"   , "narrator": "ガブリエラ", "text": "ぷ、プレゼントまで\n用意してくれてたの！？"},
        { "location": "36/TALK"   , "narrator": "ガブリエラ", "text": "これ、\n開けていいのよね？"},
        { "location": "37/SEL"    , "narrator": "", "text": "もちろんだよ"},
        { "location": "38/ACT"    , "narrator": "", "text": "もちろんだよ"},
        { "location": "40/TALK"   , "narrator": "ガブリエラ", "text": "そ、そうよね。\nあたしへのプレゼント\nなんだし。"},
        { "location": "41/TALK"   , "narrator": "ガブリエラ", "text": "ふふっ、なにが\n入ってるのかしら？"},
        { "location": "50/DIALOG" , "narrator": "", "text": "ガブリエラのコスチューム\n<size=40><color=red><b>カプクラＴシャツ</b></color></size>\nをゲットしました！"},
        { "location": "53/TALK"   , "narrator": "ガブリエラ", "text": "えっ！？\nこれって…。"},
        { "location": "55/TALK"   , "narrator": "ガブリエラ", "text": "これ、ジオンちゃん？\nカプクラのジオンちゃん\nＴシャツよね！？"},
        { "location": "56/TALK"   , "narrator": "ガブリエラ", "text": "スゴいわ！\nあたし、この子が\n一番大好きなの。"},
        { "location": "57/TALK"   , "narrator": "ガブリエラ", "text": "それに…こういう絵の\n描いてあるシャツ、\n前から欲しかったし。"},
        { "location": "58/TALK"   , "narrator": "ガブリエラ", "text": "だって、ザ・日本！\nって感じじゃない？"},
        { "location": "59/TALK"   , "narrator": "ガブリエラ", "text": "でも…自分で買いに\n行くのはちょっと、\n恥ずかしくて…。"},
        { "location": "60/TALK"   , "narrator": "ガブリエラ", "text": "まさか、こんな形で\n手に入れるとは\n思わなかったわ。"},
        { "location": "61/TALK"   , "narrator": "ガブリエラ", "text": "まあ、誕生日プレゼント\nとしては、ムードに欠け\nる"},
        { "location": "62/TALK"   , "narrator": "ガブリエラ", "text": "気がするけど…。"},
        { "location": "63/TALK"   , "narrator": "ガブリエラ", "text": "…ありがと、\nマルサンナ。\n大切にするわ。"},
        { "location": "69/DIALOG" , "narrator": "", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。"},
        { "location": "87/TALK"   , "narrator": "ガブリエラ", "text": "んっ！？"},
        { "location": "88/TALK"   , "narrator": "ガブリエラ", "text": "きゅ、急だったから、\nちょっとドキッと\nしちゃったわ…。"},
        { "location": "91/DIALOG" , "narrator": "", "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。"},
        { "location": "92/TALK"   , "narrator": "ガブリエラ", "text": "は、はいはい！\n触るのはここまで！"},
        { "location": "93/TALK"   , "narrator": "ガブリエラ", "text": "恥ずかしくって、\n暑くなって来ちゃった…。"},
        { "location": "94/SEL"    , "narrator": "", "text": "イヤだった？"},
        { "location": "95/ACT"    , "narrator": "", "text": "イヤだった？"},
        { "location": "97/TALK"   , "narrator": "ガブリエラ", "text": "そんなこと――"},
        { "location": "98/TALK"   , "narrator": "ガブリエラ", "text": "…ば、バカ。\n本当にイヤだったら、\nとっくに怒ってるわよ。"},
        { "location": "99/TALK"   , "narrator": "ガブリエラ", "text": "それくらい、言わなくて\nも\nわかるでしょ？"},
        { "location": "100/TALK"  , "narrator": "ガブリエラ", "text": "…マルサンナが\nくれたシャツ、\n大切に着るわ。"},
        { "location": "101/TALK"  , "narrator": "ガブリエラ", "text": "本当、ありがとね…。\n祝ってもらえて、\nとっても嬉しかったわ。"},
        { "location": "102/TALK"  , "narrator": "ガブリエラ", "text": "今から来年の誕生日を\n楽しみにしてるわね、\nふふっ…。"},
        { "location": "105/DIALOG", "narrator": "", "text": "コスチューム\n<color=green>【カプクラＴシャツ】</color>は、\n夜時間にパジャマとして\n着せることができます。"}
    ]
}
