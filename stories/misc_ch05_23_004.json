    "entry":
    [
        { "location": "7719/SCENARIO", "narrator": "", "text": "紺碧の嘘"},
        { "location": "7746/TALK"    , "narrator": "神楽", "text": "行く先も決めないまま"},
        { "location": "7747/TALK"    , "narrator": "神楽", "text": "どこまでも続く青空みたいに"},
        { "location": "7748/TALK"    , "narrator": "神楽", "text": "僕らはちいさな嘘を重ねてく"},
        { "location": "7750/SEL"     , "narrator": "", "text": "神楽の嘘も本当も全部受け止める"},
        { "location": "7751/SEL"     , "narrator": "", "text": "ポエム？？？"},
        { "location": "7752/SEL"     , "narrator": "", "text": "疲れてるのかな？"},
        { "location": "7753/ACT"     , "narrator": "", "text": "きみの嘘も本当も全部受け止める"},
        { "location": "7755/TALK"    , "narrator": "神楽", "text": "そんな言葉すら"},
        { "location": "7756/TALK"    , "narrator": "神楽", "text": "この手をすり抜けて"},
        { "location": "7758/SEL"     , "narrator": "", "text": "本気なんだけどな…"},
        { "location": "7759/SEL"     , "narrator": "", "text": "信じてよー"},
        { "location": "7760/SEL"     , "narrator": "", "text": "(´・ω・｀)"},
        { "location": "7761/ACT"     , "narrator": "", "text": "本気なんだけどな…"},
        { "location": "7762/TALK"    , "narrator": "神楽", "text": "そりゃどうも"},
        { "location": "7763/ACT"     , "narrator": "", "text": "信じてよー"},
        { "location": "7764/TALK"    , "narrator": "神楽", "text": "どうしよっかな、、、"},
        { "location": "7765/ACT"     , "narrator": "", "text": "(´・ω・｀)"},
        { "location": "7768/TALK"    , "narrator": "神楽", "text": "ぴょんこは青春の甘酸っぱさを表現したい気持ちだったぴょん"},
        { "location": "7770/SEL"     , "narrator": "", "text": "そういうことかー"},
        { "location": "7771/SEL"     , "narrator": "", "text": "$me$との青春だよね"},
        { "location": "7772/SEL"     , "narrator": "", "text": "若いなーｗ"},
        { "location": "7773/ACT"     , "narrator": "", "text": "そういうことかー"},
        { "location": "7774/TALK"    , "narrator": "神楽", "text": "ですですー"},
        { "location": "7777/ACT"     , "narrator": "", "text": "$me$との青春だよね"},
        { "location": "7779/TALK"    , "narrator": "神楽", "text": "うーん、、、"},
        { "location": "7780/TALK"    , "narrator": "神楽", "text": "それもありかな？"},
        { "location": "7781/TALK"    , "narrator": "神楽", "text": "そういうことにしてあげる"},
        { "location": "7782/TALK"    , "narrator": "神楽", "text": "べっ別にツンデレなんかじゃないんだからね！"},
        { "location": "7783/ACT"     , "narrator": "", "text": "若いなーｗ"},
        { "location": "7784/TALK"    , "narrator": "神楽", "text": "若いからね"},
        { "location": "7786/TALK"    , "narrator": "神楽", "text": "そして分かり合えやしないことを分かり合った僕たちは"},
        { "location": "7787/TALK"    , "narrator": "神楽", "text": "半泣きの笑顔を作るのさ"},
        { "location": "7788/TALK"    , "narrator": "神楽", "text": "せーしゅーん"},
        { "location": "7789/ACT"     , "narrator": "", "text": "ポエム？？？"},
        { "location": "7790/TALK"    , "narrator": "神楽", "text": "そう言うならそう言え"},
        { "location": "7791/ACT"     , "narrator": "", "text": "疲れてるのかな？"},
        { "location": "7792/TALK"    , "narrator": "神楽", "text": "かもね"}
    ]
}
