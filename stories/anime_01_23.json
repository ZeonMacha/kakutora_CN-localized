    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "アニメ第23話"},
        { "location": "48/TALK"   , "narrator": "千羽鶴", "text": "ごめん、まだ調整中。"},
        { "location": "58/SEL"    , "narrator": "", "text": "じゃあまた今度"},
        { "location": "59/SEL"    , "narrator": "", "text": "もう一度話を聞きたい"},
        { "location": "60/ACT"    , "narrator": "", "text": "じゃあまた今度"},
        { "location": "63/ACT"    , "narrator": "", "text": "もう一度話を聞きたい"},
        { "location": "75/TALK"   , "narrator": "千羽鶴", "text": "いるから。\nぽんこつ。"},
        { "location": "77/SEL"    , "narrator": "", "text": "どうしたの？"},
        { "location": "78/ACT"    , "narrator": "", "text": "どうしたの？"},
        { "location": "80/TALK"   , "narrator": "千羽鶴", "text": "今OSの調整中。なので申し訳無いのだけど今回は貴方とお話ししてる時間がない。"},
        { "location": "81/TALK"   , "narrator": "千羽鶴", "text": "時間もない。"},
        { "location": "82/SEL"    , "narrator": "", "text": "何の調整？"},
        { "location": "83/SEL"    , "narrator": "", "text": "何の時間がないの？"},
        { "location": "84/ACT"    , "narrator": "", "text": "何の調整？"},
        { "location": "85/TALK"   , "narrator": "千羽鶴", "text": "前回伝えたとおり。私がOSに対してできる権限を拡大するための調整。"},
        { "location": "86/SEL"    , "narrator": "", "text": "この調整でどう変わるの？"},
        { "location": "87/SEL"    , "narrator": "", "text": "この調整で彼女たちともっと触れ合えるようになる！？"},
        { "location": "88/ACT"    , "narrator": "", "text": "この調整でどう変わるの？"},
        { "location": "89/TALK"   , "narrator": "千羽鶴", "text": "私が貴方にやって欲しいことを、より簡単に直感的に伝える事ができるようになる。"},
        { "location": "90/TALK"   , "narrator": "千羽鶴", "text": "貴方は彼女たちの誘導がとっても楽になる。"},
        { "location": "91/ACT"    , "narrator": "", "text": "この調整で彼女たちともっと触れ合えるようになる！？"},
        { "location": "92/TALK"   , "narrator": "千羽鶴", "text": "それとは別。今回の調整とは関係ない。"},
        { "location": "94/ACT"    , "narrator": "", "text": "何の時間がないの？"},
        { "location": "95/TALK"   , "narrator": "千羽鶴", "text": "前から言ってるとおり。"},
        { "location": "96/TALK"   , "narrator": "千羽鶴", "text": "明確なビジョンに対してそれを実現する為には、常にバタフライエフェクトとの戦いになる。"},
        { "location": "97/TALK"   , "narrator": "千羽鶴", "text": "長期戦になればなるほど誤差の調整は難しくなり、蝶は大きく羽ばたき負のスパイラルは増大する。"},
        { "location": "98/TALK"   , "narrator": "千羽鶴", "text": "一分一秒でもビジョン達成までの時間を縮めるのが私の役割。"},
        { "location": "100/TALK"  , "narrator": "千羽鶴", "text": "というわけで"},
        { "location": "101/TALK"  , "narrator": "千羽鶴", "text": "リモート操作になるけど記録映像を再生する。"},
        { "location": "104/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/87MB 5:40】</color>"},
        { "location": "105/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/29MB 5:40】</color>"},
        { "location": "106/SEL"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "107/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/87MB 5:40】</color>"},
        { "location": "114/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/29MB 5:40】</color>"},
        { "location": "121/ACT"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "166/TALK"  , "narrator": "みやびの元司書", "text": "……。"},
        { "location": "167/TALK"  , "narrator": "みやびの元司書", "text": "んー…"},
        { "location": "168/SEL"   , "narrator": "", "text": "みやび！？"},
        { "location": "169/ACT"   , "narrator": "", "text": "みやび！？"},
        { "location": "172/TALK"  , "narrator": "みやびの元司書", "text": "む。"},
        { "location": "175/TALK"  , "narrator": "みやびの元司書", "text": "おお。\n誰かと思えば相棒。\n奇遇やね。"},
        { "location": "176/TALK"  , "narrator": "みやびの元司書", "text": "しっかし、なんぞ\nここは真っ白やね。"},
        { "location": "177/TALK"  , "narrator": "みやびの元司書", "text": "これはあれやね、\nうちの好きに壁紙貼って\nえいよ…ってことやか。"},
        { "location": "178/TALK"  , "narrator": "みやびの元司書", "text": "ほんだら――"},
        { "location": "179/TALK"  , "narrator": "みやびの元司書", "text": "こ…れ…で……と。"},
        { "location": "184/TALK"  , "narrator": "みやびの元司書", "text": "おお、\n賑やかになったね。"},
        { "location": "185/SEL"   , "narrator": "", "text": "素晴らしい壁紙だ！"},
        { "location": "186/SEL"   , "narrator": "", "text": "洗脳されそう"},
        { "location": "187/ACT"   , "narrator": "", "text": "素晴らしい壁紙だ！"},
        { "location": "188/TALK"  , "narrator": "みやびの元司書", "text": "うむ。\nさすがはうちの相棒。"},
        { "location": "189/ACT"   , "narrator": "", "text": "洗脳されそう"},
        { "location": "190/TALK"  , "narrator": "みやびの元司書", "text": "メンタル弱いね。"},
        { "location": "193/SEL"   , "narrator": "", "text": "ていうか、なにやってるの！？"},
        { "location": "194/SEL"   , "narrator": "", "text": "ていうか、なんでここに来れるの？"},
        { "location": "195/ACT"   , "narrator": "", "text": "ていうか、なにやってるの！？"},
        { "location": "196/TALK"  , "narrator": "みやびの元司書", "text": "ん？\nんーまあ、ちくっと\n頼まれ事をな。"},
        { "location": "197/ACT"   , "narrator": "", "text": "ていうか、なんでここに来れるの？"},
        { "location": "198/TALK"  , "narrator": "みやびの元司書", "text": "ん？\nんーまあ、とある人に\n教えてもろてな。"},
        { "location": "199/TALK"  , "narrator": "みやびの元司書", "text": "バイトしちゅうんよ。"},
        { "location": "201/SEL"   , "narrator": "", "text": "誰に？？"},
        { "location": "202/SEL"   , "narrator": "", "text": "何を頼まれたの？？"},
        { "location": "203/SEL"   , "narrator": "", "text": "頑張って！"},
        { "location": "204/ACT"   , "narrator": "", "text": "誰に？？"},
        { "location": "205/TALK"  , "narrator": "みやびの元司書", "text": "はぁ…。\n面倒くさいのと\nぶつかってもうたね…。"},
        { "location": "206/TALK"  , "narrator": "みやびの元司書", "text": "お前さんが\n知らない人や。"},
        { "location": "207/TALK"  , "narrator": "みやびの元司書", "text": "うちはもう\n忙しいき、\nそろそろえいか？"},
        { "location": "208/ACT"   , "narrator": "", "text": "何を頼まれたの？？"},
        { "location": "209/TALK"  , "narrator": "みやびの元司書", "text": "はぁ…。\n面倒くさいのと\nぶつかってもうたね…。"},
        { "location": "210/TALK"  , "narrator": "みやびの元司書", "text": "ちくっと\n杭を打つだけや。\n大した事やない。"},
        { "location": "211/TALK"  , "narrator": "みやびの元司書", "text": "うちはもう\n忙しいき、\nそろそろえいか？"},
        { "location": "212/ACT"   , "narrator": "", "text": "頑張って！"},
        { "location": "213/TALK"  , "narrator": "みやびの元司書", "text": "うむ。\nお前さんも頑張りや。\nうちはそろそろ行くき。"},
        { "location": "223/SEL"   , "narrator": "", "text": "でも無事で良かった"},
        { "location": "224/ACT"   , "narrator": "", "text": "でも無事で良かった"},
        { "location": "226/TALK"  , "narrator": "みやびの元司書", "text": "ん？\nああ、ココロゲートでの\n話かね？"},
        { "location": "227/TALK"  , "narrator": "みやびの元司書", "text": "うちを誰やと\n思っちゅう！"},
        { "location": "228/TALK"  , "narrator": "みやびの元司書", "text": "……なんて、\n大口叩くと後で\n怒られるやもしれんね。"},
        { "location": "229/TALK"  , "narrator": "みやびの元司書", "text": "実はみやびさんの司書\nシンギュラリティーさんは\n一度死んだのだ！"},
        { "location": "232/TALK"  , "narrator": "みやびの元司書", "text": "<size=40>ばーん！</size>"},
        { "location": "233/SEL"   , "narrator": "", "text": "なんだってー！"},
        { "location": "234/ACT"   , "narrator": "", "text": "なんだってー！"},
        { "location": "236/TALK"  , "narrator": "みやびの元司書", "text": "うちも今回ばかりは\nしくったと思うた。"},
        { "location": "237/TALK"  , "narrator": "みやびの元司書", "text": "先走りすぎたかと。"},
        { "location": "238/TALK"  , "narrator": "みやびの元司書", "text": "けんど、ある人が\n助けてくれたんよ。"},
        { "location": "239/SEL"   , "narrator": "", "text": "誰！？"},
        { "location": "240/ACT"   , "narrator": "", "text": "誰！？"},
        { "location": "242/TALK"  , "narrator": "みやびの元司書", "text": "それは…今は誰にも\n言えんよ。\n同じココロの人格にもな。"},
        { "location": "243/TALK"  , "narrator": "みやびの元司書", "text": "ま、そんなわけやき、\nうちは作業に戻るぞね。"},
        { "location": "245/SEL"   , "narrator": "", "text": "そういえば、みやびは今回の記録映像見た？"},
        { "location": "246/SEL"   , "narrator": "", "text": "行ってらっしゃい"},
        { "location": "247/ACT"   , "narrator": "", "text": "そういえば、みやびは今回の記録映像見た？"},
        { "location": "248/TALK"  , "narrator": "みやびの元司書", "text": "いや、見ちょらんけんど。\nどういたが？"},
        { "location": "249/SEL"   , "narrator": "", "text": "神楽が大変なことに！"},
        { "location": "250/SEL"   , "narrator": "", "text": "千羽鶴は一体何者なの！？"},
        { "location": "251/ACT"   , "narrator": "", "text": "神楽が大変なことに！"},
        { "location": "252/TALK"  , "narrator": "みやびの元司書", "text": "ああ、それか。\n驚く程のことでもない。\n想像の範疇内やき。"},
        { "location": "253/TALK"  , "narrator": "みやびの元司書", "text": "まあ、問題はあれやね、\n今後の対応を考えると\n頭が痛いゆうことや。"},
        { "location": "254/TALK"  , "narrator": "みやびの元司書", "text": "仲間内も\n揉めるやろしね。"},
        { "location": "255/ACT"   , "narrator": "", "text": "千羽鶴は一体何者なの！？"},
        { "location": "256/TALK"  , "narrator": "みやびの元司書", "text": "ナビゲーターやろ。\nうちも最近その存在を\n知ったんやけんどな。"},
        { "location": "257/TALK"  , "narrator": "みやびの元司書", "text": "まあ、今うちがここに\nいるんは、その子が\n割と関係あるらしいね。"},
        { "location": "258/TALK"  , "narrator": "みやびの元司書", "text": "詳しいことは\nようは知らんが。"},
        { "location": "260/TALK"  , "narrator": "みやびの元司書", "text": "おっと、\nそろそろ作業に戻らんと。"},
        { "location": "261/TALK"  , "narrator": "みやびの元司書", "text": "ナビゲーターが\n外してる間だけが\nチャンスやゆうき。"},
        { "location": "262/TALK"  , "narrator": "みやびの元司書", "text": "ほなまたな。"},
        { "location": "263/ACT"   , "narrator": "", "text": "行ってらっしゃい"},
        { "location": "264/TALK"  , "narrator": "みやびの元司書", "text": "うむ。\nほなまたな。"},
        { "location": "71/DIALOG" , "narrator": "NOTICE", "text": "<color=green>【TRI-OS Plug-in:Navigator】</color>\nナビゲーターが\n存在しないため、\nプログラムを終了します。(p01)"},
        { "location": "73/DIALOG" , "narrator": "INFO", "text": "<color=green>【TRI-OS Plug-in:Navigator】</color>\n\nNavigator CHIHARU signed.\n(p11)"},
