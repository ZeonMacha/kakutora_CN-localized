        "title": "002 メインストーリー",
        "sub_title": "気にしすぎの夏＜前編＞"
    },
    "entry":
    [
        { "location": "22/TALK"   , "narrator": "真幌", "text": "よーし、全員よく\n頑張ったな。"},
        { "location": "23/TALK"   , "narrator": "真幌", "text": "これで午前の訓練は\n終わりにするが、\n昼食後に再開だ。"},
        { "location": "24/TALK"   , "narrator": "真幌", "text": "とにかく今は休め。\n以上、一時解散！"},
        { "location": "61/TALK"   , "narrator": "アーヤ", "text": "さて、と。\nそれじゃお昼ご飯\n食べちゃいましょ。"},
        { "location": "62/TALK"   , "narrator": "つばめ", "text": "そうですね。\nもうお腹ペコペコ\nです。"},
        { "location": "64/TALK"   , "narrator": "神楽", "text": "私もです…。\nでも、お腹いっぱいは\n食べられませんね。"},
        { "location": "65/TALK"   , "narrator": "みやび", "text": "午後もこれやろ？\n腹いっぱい食うたら\n動けなくなるがよ。"},
        { "location": "67/TALK"   , "narrator": "ガブリエラ", "text": "情けないわねぇ。\n胃が弱いんじゃ\nないの？"},
        { "location": "68/TALK"   , "narrator": "アーヤ", "text": "とにかく、まずは\nみやびの家に\n戻りましょ。"},
        { "location": "109/TALK"  , "narrator": "雛", "text": "美味しかったー！\nやっぱ夏の素麺は\n最高だねー。"},
        { "location": "110/TALK"  , "narrator": "キリト", "text": "ああ、満腹になった\nところで、少し昼寝\nでもするか。"},
        { "location": "112/TALK"  , "narrator": "ヒカル", "text": "そんな暇ないよ。\n少し休んだら、\nすぐに行かないと。"},
        { "location": "113/TALK"  , "narrator": "キリト", "text": "ちょっと遅れたって\n平気だっての。\n学校じゃあるまいし。"},
        { "location": "114/TALK"  , "narrator": "雛", "text": "逆でしょ？"},
        { "location": "115/TALK"  , "narrator": "雛", "text": "東雲教官を待たせたり\nしたらさ。"},
        { "location": "116/TALK"  , "narrator": "雛", "text": "学校遅刻するより\nヤバいことになると\n思うけどねー。"},
        { "location": "117/TALK"  , "narrator": "つばめ", "text": "お昼ごはん、\n楽しみだなー。"},
        { "location": "119/TALK"  , "narrator": "雛", "text": "あ、この声は！"},
        { "location": "120/TALK"  , "narrator": "みやび", "text": "ま、昼やし素麺\nだと思うけんどな。"},
        { "location": "121/TALK"  , "narrator": "つばめ", "text": "暑いし疲れてるから、\nそっちの方が嬉しい\nです。"},
        { "location": "122/TALK"  , "narrator": "雛", "text": "つばめちゃーん！\nこっちこっちー！"},
        { "location": "132/TALK"  , "narrator": "つばめ", "text": "あ、あれ！？"},
        { "location": "134/TALK"  , "narrator": "キリト", "text": "よっ、逢瀬。\n訓練ご苦労さん。"},
        { "location": "135/TALK"  , "narrator": "ヒカル", "text": "お疲れ様です。\n暑い中、ごくろうさま\nでした。"},
        { "location": "136/TALK"  , "narrator": "つばめ", "text": "みんな、どうして\nここにいるの！？"},
        { "location": "139/TALK"  , "narrator": "みやび", "text": "…お？　もう到着し\nちょったが？"},
        { "location": "140/TALK"  , "narrator": "ヒカル", "text": "お邪魔してます、\nみやび先輩。"},
        { "location": "143/TALK"  , "narrator": "つばめ", "text": "あの、みやびさん。\nどうしてみんなが\nここにいるんですか？"},
        { "location": "145/TALK"  , "narrator": "みやび", "text": "なんや？　まほさんに\n聞いてなかったが？"},
        { "location": "146/TALK"  , "narrator": "つばめ", "text": "はい…なんで？"},
        { "location": "148/TALK"  , "narrator": "キリト", "text": "逢瀬達の手伝い兼、\n東雲教官の手伝い。"},
        { "location": "149/TALK"  , "narrator": "キリト", "text": "それだったら\n合宿についてきても\nいいって東雲教官が。"},
        { "location": "150/TALK"  , "narrator": "キリト", "text": "そうすりゃ、逢瀬達が\n訓練に集中できる\nから、ってな。"},
        { "location": "152/TALK"  , "narrator": "雛", "text": "ま、つばめちゃん達の\n手伝いはおまけだよね。"},
        { "location": "153/TALK"  , "narrator": "雛", "text": "教官は自分の手伝いが\n欲しかったみたい\nだから。"},
        { "location": "154/TALK"  , "narrator": "ヒカル", "text": "逢瀬さん達の訓練は、\n僕達じゃ手伝えません\nからね。"},
        { "location": "158/TALK"  , "narrator": "つばめ", "text": "そうなんだ…。\n全然知らなかったよ。"},
        { "location": "159/TALK"  , "narrator": "つばめ", "text": "でもさ。\nそれだったら。"},
        { "location": "160/TALK"  , "narrator": "つばめ", "text": "一緒に遊びに行ったり\nできるよね！"},
        { "location": "161/TALK"  , "narrator": "雛", "text": "うーん…そうだったら\nよかったんだけど…。"},
        { "location": "163/TALK"  , "narrator": "雛", "text": "ほら、基本的に教官の\n手伝いが多い、って\n言ったでしょ？"},
        { "location": "165/TALK"  , "narrator": "つばめ", "text": "う、うん…。"},
        { "location": "166/TALK"  , "narrator": "雛", "text": "だから、昼間は\nほとんどこっちには\nいないんだよー。"},
        { "location": "167/TALK"  , "narrator": "キリト", "text": "泊まるのも、俺たちは\n近くの旅館だしな。"},
        { "location": "170/TALK"  , "narrator": "つばめ", "text": "えーっ！？"},
        { "location": "172/TALK"  , "narrator": "ヒカル", "text": "逢瀬さん達は、\n政府の秘密部隊\nだからね。"},
        { "location": "173/TALK"  , "narrator": "ヒカル", "text": "一緒に行動するのは\nまずい、ってことなの\nかもしれないね。"},
        { "location": "174/TALK"  , "narrator": "キリト", "text": "おまけに、こっちに\nいる期間も逢瀬達より\n全然短いしな。"},
        { "location": "176/TALK"  , "narrator": "雛", "text": "うん…もしかしたら、\n遊びに行ったりとかは\nできないかも。"},
        { "location": "177/TALK"  , "narrator": "つばめ", "text": "そうなんだ…。"},
        { "location": "179/TALK"  , "narrator": "雛", "text": "ただ、\n東京ではできない\n作業みたいだから。"},
        { "location": "180/TALK"  , "narrator": "雛", "text": "ちょっと楽しみでは\nあるんだ。"},
        { "location": "181/TALK"  , "narrator": "つばめ", "text": "…そっかぁ。"},
        { "location": "182/TALK"  , "narrator": "つばめ", "text": "なんか、やること\n沢山あって大変だね。"},
        { "location": "246/TALK"  , "narrator": "つばめ", "text": "　"},
        { "location": "260/TALK"  , "narrator": "つばめ", "text": "こんにちは、\n$handle$さん。"},
        { "location": "261/SEL"   , "narrator": "", "text": "ちょ！！　水着！？"},
        { "location": "262/ACT"   , "narrator": "", "text": "ちょ！！　水着！？"},
        { "location": "264/TALK"  , "narrator": "つばめ", "text": "はい。"},
        { "location": "265/TALK"  , "narrator": "つばめ", "text": "…ダメでしたか？\nまあそりゃダメですよね。\nわたしみたいなのじゃ。"},
        { "location": "266/SEL"   , "narrator": "", "text": "そんなことないよ、\nかわいいよ！"},
        { "location": "267/SEL"   , "narrator": "", "text": "なんで急にまた…"},
        { "location": "268/ACT"   , "narrator": "", "text": "そんなことないよ、\nかわいいよ！"},
        { "location": "270/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "273/TALK"  , "narrator": "つばめ", "text": "………。"},
        { "location": "274/SEL"   , "narrator": "", "text": "…？"},
        { "location": "275/ACT"   , "narrator": "", "text": "…？"},
        { "location": "277/TALK"  , "narrator": "つばめ", "text": "いえ。\nお気になさらず。"},
        { "location": "278/TALK"  , "narrator": "つばめ", "text": "どう反応したらいいか\nわからなくなった\nだけです。"},
        { "location": "279/TALK"  , "narrator": "つばめ", "text": "とまあ、\nそれはそれとして。"},
        { "location": "280/ACT"   , "narrator": "", "text": "なんで急にまた…"},
        { "location": "281/TALK"  , "narrator": "つばめ", "text": "いえ、\n現実のわたしが水着なので\nそれに対抗しようかと。"},
        { "location": "282/SEL"   , "narrator": "", "text": "自分自身と競い合ってどうするの！？"},
        { "location": "283/ACT"   , "narrator": "", "text": "自分自身と競い合ってどうするの！？"},
        { "location": "287/TALK"  , "narrator": "つばめ", "text": "シィィィット！！"},
        { "location": "288/SEL"   , "narrator": "", "text": "座れってこと？"},
        { "location": "289/SEL"   , "narrator": "", "text": "嫉妬？"},
        { "location": "290/ACT"   , "narrator": "", "text": "座れってこと？"},
        { "location": "291/TALK"  , "narrator": "つばめ", "text": "アホですか？\nそうですか。"},
        { "location": "292/TALK"  , "narrator": "つばめ", "text": "なぜ「自分と競い合って\nどうする？」の返答が\n「座れ！」なのか。"},
        { "location": "293/TALK"  , "narrator": "つばめ", "text": "その理由を\n１５文字以内で\n述べてください。"},
        { "location": "294/SEL"   , "narrator": "", "text": "度肝を抜く超展開を狙ったからかと"},
        { "location": "295/SEL"   , "narrator": "", "text": "正座させられて折檻されるＳＭ的な罰では？"},
        { "location": "296/ACT"   , "narrator": "", "text": "度肝を抜く超展開を狙ったからかと"},
        { "location": "297/TALK"  , "narrator": "つばめ", "text": "システムがバグるので\nそういうことは\nやめてください。"},
        { "location": "298/SEL"   , "narrator": "", "text": "……？\nどういうこと？"},
        { "location": "299/ACT"   , "narrator": "", "text": "……？\nどういうこと？"},
        { "location": "301/TALK"  , "narrator": "つばめ", "text": "……？\nエラーが\n出ませんでしたか？"},
        { "location": "302/SEL"   , "narrator": "", "text": "いえ、なにも……"},
        { "location": "303/ACT"   , "narrator": "", "text": "いえ、なにも……"},
        { "location": "305/TALK"  , "narrator": "つばめ", "text": "おかしいですね。"},
        { "location": "306/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "307/TALK"  , "narrator": "つばめ", "text": "………。"},
        { "location": "308/TALK"  , "narrator": "つばめ", "text": "あー。\nMoji>=16 とする所を\nMoji>16になってます。"},
        { "location": "309/TALK"  , "narrator": "つばめ", "text": "バグらせる為の仕掛けが\nバグってました。\n失敗です……。"},
        { "location": "310/SEL"   , "narrator": "", "text": "バグらせる為の仕掛けってなに！？！？"},
        { "location": "311/SEL"   , "narrator": "", "text": "もしかしてわざと！？"},
        { "location": "312/ACT"   , "narrator": "", "text": "バグらせる為の仕掛けってなに！？！？"},
        { "location": "314/ACT"   , "narrator": "", "text": "もしかしてわざと！？"},
        { "location": "317/TALK"  , "narrator": "つばめ", "text": "ほら、アレですよ。"},
        { "location": "318/TALK"  , "narrator": "つばめ", "text": "好意を持った相手を\nいじめたくなるって\nいいますよね。"},
        { "location": "319/TALK"  , "narrator": "つばめ", "text": "ソレです。"},
        { "location": "320/SEL"   , "narrator": "", "text": "小学生ですか！"},
        { "location": "321/SEL"   , "narrator": "", "text": "$me$に好意持ってるの！？"},
        { "location": "322/SEL"   , "narrator": "", "text": "遠慮します！！"},
        { "location": "323/ACT"   , "narrator": "", "text": "小学生ですか！"},
        { "location": "324/TALK"  , "narrator": "つばめ", "text": "高校生です。\n見てわかりませんか？"},
        { "location": "325/ACT"   , "narrator": "", "text": "$me$に好意持ってるの！？"},
        { "location": "327/TALK"  , "narrator": "つばめ", "text": "秘密です。"},
        { "location": "328/TALK"  , "narrator": "つばめ", "text": "そう思わせるための\nフェイク仕掛けかも\nしれませんよ。"},
        { "location": "329/SEL"   , "narrator": "", "text": "それって裏の裏の裏くらい掻いてますよね"},
        { "location": "330/ACT"   , "narrator": "", "text": "それって裏の裏の裏くらい掻いてますよね"},
        { "location": "332/TALK"  , "narrator": "つばめ", "text": "そうですか……？"},
        { "location": "333/TALK"  , "narrator": "つばめ", "text": "裏の裏の裏っていうと、\nすき、きらい、すき、\nなので、あってますね。"},
        { "location": "334/ACT"   , "narrator": "", "text": "遠慮します！！"},
        { "location": "335/TALK"  , "narrator": "つばめ", "text": "……そうですか。"},
        { "location": "340/TALK"  , "narrator": "つばめ", "text": "こっちから願い下げだわ\n■■野郎！！"},
        { "location": "344/ACT"   , "narrator": "", "text": "正座させられて折檻されるＳＭ的な罰では？"},
        { "location": "346/TALK"  , "narrator": "つばめ", "text": "システムがバグるので\nそういうことは\nやめてください。"},
        { "location": "347/SEL"   , "narrator": "", "text": "文字数オーバー如きで、ちょっとシステム弱すぎじゃない！？"},
        { "location": "348/ACT"   , "narrator": "", "text": "文字数オーバー如きで、ちょっとシステム弱すぎじゃない！？"},
        { "location": "350/TALK"  , "narrator": "つばめ", "text": "普通ですよ。\nバグったら\n賠償請求ものです。"},
        { "location": "351/TALK"  , "narrator": "つばめ", "text": "というわけで、\n賠償を要求します。"},
        { "location": "352/SEL"   , "narrator": "", "text": "なんでしょうか"},
        { "location": "353/ACT"   , "narrator": "", "text": "なんでしょうか"},
        { "location": "356/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "357/TALK"  , "narrator": "つばめ", "text": "また今度考えておきます。"},
        { "location": "359/TALK"  , "narrator": "つばめ", "text": "とまあ、そんなことは\nどうでもいいんです。"},
        { "location": "360/TALK"  , "narrator": "つばめ", "text": "早く仕事をしましょう！\n仕事を！"},
        { "location": "361/SEL"   , "narrator": "", "text": "あ、はい"},
        { "location": "362/ACT"   , "narrator": "", "text": "あ、はい"},
        { "location": "364/TALK"  , "narrator": "つばめ", "text": "というわけで。"},
        { "location": "365/ACT"   , "narrator": "", "text": "嫉妬？"},
        { "location": "367/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "368/TALK"  , "narrator": "つばめ", "text": "…。"},
        { "location": "369/TALK"  , "narrator": "つばめ", "text": "まさか。"},
        { "location": "370/SEL"   , "narrator": "", "text": "なんです今の間は"},
        { "location": "371/ACT"   , "narrator": "", "text": "なんです今の間は"},
        { "location": "373/TALK"  , "narrator": "つばめ", "text": "処理落ちです。"},
        { "location": "374/SEL"   , "narrator": "", "text": "素直になれよ"},
        { "location": "375/SEL"   , "narrator": "", "text": "いつからプログラムになったの？"},
        { "location": "376/ACT"   , "narrator": "", "text": "素直になれよ"},
        { "location": "378/TALK"  , "narrator": "つばめ", "text": "わかりました、\n素直になります。"},
        { "location": "379/TALK"  , "narrator": "つばめ", "text": "それじゃ聞きますけど\nわたしとわたし、\nどっちがいいんですか？"},
        { "location": "380/TALK"  , "narrator": "つばめ", "text": "はっきりしてください。"},
        { "location": "381/SEL"   , "narrator": "", "text": "わたし"},
        { "location": "382/SEL"   , "narrator": "", "text": "わたし"},
        { "location": "383/ACT"   , "narrator": "", "text": "わたし"},
        { "location": "384/ACT"   , "narrator": "", "text": "わたし"},
        { "location": "386/TALK"  , "narrator": "つばめ", "text": "やっぱりわたしでしたか。\nそうだと思ってました。"},
        { "location": "387/SEL"   , "narrator": "", "text": "いや、どっちがどっちかわからないです"},
        { "location": "388/ACT"   , "narrator": "", "text": "いや、どっちがどっちかわからないです"},
        { "location": "390/TALK"  , "narrator": "つばめ", "text": "どっちでもいいんです。\n貴方が選んだ方が\nわたしですから。"},
        { "location": "391/SEL"   , "narrator": "", "text": "今とても酷い発言を聞いた"},
        { "location": "392/ACT"   , "narrator": "", "text": "今とても酷い発言を聞いた"},
        { "location": "394/TALK"  , "narrator": "つばめ", "text": "ここはわたしの\nココロの中です。"},
        { "location": "395/TALK"  , "narrator": "つばめ", "text": "わたしこそが\n法であり秩序であるのは\n当然のことです。"},
        { "location": "396/ACT"   , "narrator": "", "text": "いつからプログラムになったの？"},
        { "location": "397/TALK"  , "narrator": "つばめ", "text": "いつからでしょうか。\nあまり記憶がありません。"},
        { "location": "399/TALK"  , "narrator": "つばめ", "text": "…なんていう冗談は\nさておき。"},
        { "location": "402/TALK"  , "narrator": "つばめ", "text": "普段は拳で語り合う\n貴方とわたしですが。"},
        { "location": "403/TALK"  , "narrator": "つばめ", "text": "今日はちょっとばかり\n休戦しようでは\nありませんか。"},
        { "location": "404/SEL"   , "narrator": "", "text": "どういう風の吹き回しですか？"},
        { "location": "405/SEL"   , "narrator": "", "text": "既に十分和みました"},
        { "location": "406/ACT"   , "narrator": "", "text": "どういう風の吹き回しですか？"},
        { "location": "407/TALK"  , "narrator": "つばめ", "text": "いや。\nせっかくの水着回なんで。"},
        { "location": "408/TALK"  , "narrator": "つばめ", "text": "というわけで、お互い\n積極的に協力し合い\n問題解決に挑みましょう。"},
        { "location": "409/ACT"   , "narrator": "", "text": "既に十分和みました"},
        { "location": "410/TALK"  , "narrator": "つばめ", "text": "それは番狂わせですね。"},
        { "location": "411/TALK"  , "narrator": "つばめ", "text": "とにかく、お互い\n積極的に協力し合い\n問題解決に挑みましょう。"},
        { "location": "413/SEL"   , "narrator": "", "text": "それっていつもと同じでは？"},
        { "location": "414/ACT"   , "narrator": "", "text": "それっていつもと同じでは？"},
        { "location": "416/TALK"  , "narrator": "つばめ", "text": "だとしたら\nとっても素敵なことです。"},
        { "location": "417/TALK"  , "narrator": "つばめ", "text": "それじゃ\n早速仕事をします。"},
        { "location": "425/TALK"  , "narrator": "つばめ", "text": "オープンプロセス、\n0x41F番地から\n0x5BA番地へ。"},
        { "location": "445/TALK"  , "narrator": "つばめ", "text": "シーク完了しました。"},
        { "location": "448/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "450/TALK"  , "narrator": "つばめ", "text": "……なるほど。"},
        { "location": "451/TALK"  , "narrator": "つばめ", "text": "ていうかですね。"},
        { "location": "452/TALK"  , "narrator": "つばめ", "text": "今回の案件って、\n何で悩んでるのか\n意味が分かりません。"},
        { "location": "453/SEL"   , "narrator": "", "text": "自分の悩みにダメ出しするの！？"},
        { "location": "454/ACT"   , "narrator": "", "text": "自分の悩みにダメ出しするの！？"},
        { "location": "456/TALK"  , "narrator": "つばめ", "text": "もちろんです。"},
        { "location": "457/TALK"  , "narrator": "つばめ", "text": "みんな、自分で選択して\n来ているのですから、\nそれでいいと思うんです。"},
        { "location": "458/SEL"   , "narrator": "", "text": "本当につばめ本人なの？"},
        { "location": "459/ACT"   , "narrator": "", "text": "本当につばめ本人なの？"},
        { "location": "461/TALK"  , "narrator": "つばめ", "text": "もちろんでし…す。"},
        { "location": "462/TALK"  , "narrator": "つばめ", "text": "わたしのような人格は、\n$handle$さんにも\nいるはずです。"},
        { "location": "463/TALK"  , "narrator": "つばめ", "text": "何かを悩んでいるとき、\nそれを第三者視点から\n冷静に見ている人格です。"},
        { "location": "464/TALK"  , "narrator": "つばめ", "text": "ものすごく深刻な事態でも\n突如冷静に自分ツッコミ\nいれたりしませんか？"},
        { "location": "465/TALK"  , "narrator": "つばめ", "text": "まさにそれがわたしです。"},
        { "location": "466/TALK"  , "narrator": "つばめ", "text": "今回の件は、わたしの\nココロの中の引っかかりを\n整理するものなんですが。"},
        { "location": "467/TALK"  , "narrator": "つばめ", "text": "その引っかかりというのは\n雛たちが連行されたのは\n自分の責任だというもの。"},
        { "location": "468/SEL"   , "narrator": "", "text": "なんで？"},
        { "location": "469/ACT"   , "narrator": "", "text": "なんで？"},
        { "location": "471/TALK"  , "narrator": "つばめ", "text": "自分がトライナリーやって\nいて、雛たちが友達だから\n連れてこられたのだと。"},
        { "location": "472/TALK"  , "narrator": "つばめ", "text": "自分たちトライナリーの\nサポートをさせられてる\n事に罪悪感を感じてます。"},
        { "location": "473/TALK"  , "narrator": "つばめ", "text": "正直、そんな罪悪感は\n抱く理由がわかりません。"},
        { "location": "474/TALK"  , "narrator": "つばめ", "text": "見ていたらわかりますけど\n彼女たちも、この長旅を\n楽しんでますから。"},
        { "location": "475/SEL"   , "narrator": "", "text": "確かに"},
        { "location": "476/SEL"   , "narrator": "", "text": "いや、やっぱり自分も申し訳無いと思っちゃう"},
        { "location": "477/ACT"   , "narrator": "", "text": "確かに"},
        { "location": "478/TALK"  , "narrator": "つばめ", "text": "ですよね。"},
        { "location": "479/ACT"   , "narrator": "", "text": "いや、やっぱり自分も申し訳無いと思っちゃう"},
        { "location": "480/TALK"  , "narrator": "つばめ", "text": "$handle$さんは\n自虐癖がありそうなので\n注意した方がいいです。"},
        { "location": "481/TALK"  , "narrator": "つばめ", "text": "なんでもかんでも自分の\nせいにすれば丸く収まる\nなんてことはないです。"},
        { "location": "482/TALK"  , "narrator": "つばめ", "text": "ただ、もしそういう\n自己罪悪感ではない\n理由によるものなら――"},
        { "location": "483/TALK"  , "narrator": "つばめ", "text": "先に謝ります。わたしには\nその事例が思い当たらず\n共感できませんので。"},
        { "location": "484/TALK"  , "narrator": "つばめ", "text": "何にしても、です。"},
        { "location": "486/TALK"  , "narrator": "つばめ", "text": "今回は、さっさとココロの\n整理をつける為、曖昧に\nしてるクランを倒します。"},
        { "location": "487/SEL"   , "narrator": "", "text": "りょうかい"},
        { "location": "488/SEL"   , "narrator": "", "text": "やっぱり何か違和感を感じる"},
        { "location": "489/ACT"   , "narrator": "", "text": "りょうかい"},
        { "location": "490/ACT"   , "narrator": "", "text": "やっぱり何か違和感を感じる"},
        { "location": "491/TALK"  , "narrator": "つばめ", "text": "おおっと。\n今日はタブーです。"},
        { "location": "492/SEL"   , "narrator": "", "text": "？？？"},
        { "location": "493/ACT"   , "narrator": "", "text": "？？？"},
        { "location": "495/TALK"  , "narrator": "つばめ", "text": "二人で契りましたよね？"},
        { "location": "496/TALK"  , "narrator": "つばめ", "text": "『お互い積極的に\n協力し合い』ましょうと。"},
        { "location": "498/TALK"  , "narrator": "つばめ", "text": "それでは早速、\nおねがいします。"},
        { "location": "499/TALK"  , "narrator": "つばめ", "text": "わたしと\n$handle$さんに\n素敵なココロの旅を。"},
        { "location": "21/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>8月18日　 0:04 PM</color>\n合宿二日目、午前の訓練終了時のこと"},
        { "location": "211/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "213/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "215/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "217/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "219/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "345/DIALOG", "narrator": "Dialog_Notice", "text": "<color=red>不正な処理エラー</color>\n文字数がオーバーフローしました"}
    ]
