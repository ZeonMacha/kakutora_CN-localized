    "type": "MainStory",
    "info": {
        "story_id": "17402",
        "cid": "miyabi",
        "title": "002 メインストーリー",
        "sub_title": "相対的情報漏洩＜前編＞"
    },
    "entry":
    [
        { "location": "25/TALK"   , "narrator": "みやび", "text": "あ～、終わったぁ…。\n戦闘終了お疲れさん\nでしたー、と。"},
        { "location": "26/TALK"   , "narrator": "みやび", "text": "後方支援ゆうても、\nやること多くて\nしんどかったぞね。"},
        { "location": "27/TALK"   , "narrator": "みやび", "text": "これまでの活躍も\nこじゃんと報告\nしちゅうき。"},
        { "location": "29/TALK"   , "narrator": "みやび", "text": "特別手当として\nハワイ旅行くらい\nもらいたいねえ。"},
        { "location": "36/TALK"   , "narrator": "みやび", "text": "ん？　光月さんか。"},
        { "location": "41/TALK"   , "narrator": "繭", "text": "無事に収束したようですが"},
        { "location": "42/TALK"   , "narrator": "繭", "text": "他に何か作業はありますか？"},
        { "location": "44/TALK"   , "narrator": "みやび", "text": "いや"},
        { "location": "45/TALK"   , "narrator": "みやび", "text": "ナッシング"},
        { "location": "46/TALK"   , "narrator": "みやび", "text": "ミッションコンプリート"},
        { "location": "47/TALK"   , "narrator": "みやび", "text": "ゲームクリア"},
        { "location": "48/TALK"   , "narrator": "みやび", "text": "というわけなので"},
        { "location": "49/TALK"   , "narrator": "みやび", "text": "お疲れさまでした"},
        { "location": "51/TALK"   , "narrator": "繭", "text": "お疲れさまでした"},
        { "location": "57/TALK"   , "narrator": "みやび", "text": "…光月さんには、\n改めてお礼せんと\nいかんね。"},
        { "location": "66/TALK"   , "narrator": "みやび", "text": "ん…ウサギ？\nメッセの方に送れば\nえいのに…。"},
        { "location": "69/TALK"   , "narrator": "ラビットアニマ", "text": "状況終了ですね"},
        { "location": "72/TALK"   , "narrator": "フェイタルクイーン", "text": "うむ"},
        { "location": "73/TALK"   , "narrator": "フェイタルクイーン", "text": "今回もご苦労だった"},
        { "location": "75/TALK"   , "narrator": "ラビットアニマ", "text": "お気になさらず"},
        { "location": "76/TALK"   , "narrator": "ラビットアニマ", "text": "お疲れさまでした"},
        { "location": "78/TALK"   , "narrator": "ラビットアニマ", "text": "恋ヶ崎みやび"},
        { "location": "80/TALK"   , "narrator": "システム", "text": "『ＲＡＢＢＩＴＡＮＩＭＡが退室しました』"},
        { "location": "84/TALK"   , "narrator": "みやび", "text": "…………。"},
        { "location": "89/TALK"   , "narrator": "みやび", "text": "は？"},
        { "location": "91/TALK"   , "narrator": "みやび", "text": "今の！？"},
        { "location": "92/TALK"   , "narrator": "みやび", "text": "どういうことや？"},
        { "location": "93/TALK"   , "narrator": "みやび", "text": "どうしてウサギが\nうちの名前を…。"},
        { "location": "94/TALK"   , "narrator": "みやび", "text": "…まさか！！"},
        { "location": "111/TALK"  , "narrator": "みやび", "text": "…侵入された形跡は\n見当たらんな。"},
        { "location": "112/TALK"  , "narrator": "みやび", "text": "ちゅうことは、\nＰＣから個人情報\n抜かれたわけやない。"},
        { "location": "113/TALK"  , "narrator": "みやび", "text": "…どういうことや？\nなら、どうやって\nうちの名前を知った？"},
        { "location": "114/TALK"  , "narrator": "みやび", "text": "うちが自分の名前を\n言うなんてことは、\n絶対にありえん。"},
        { "location": "115/TALK"  , "narrator": "みやび", "text": "だとすると、\n他に考えられる\n可能性は…。"},
        { "location": "116/TALK"  , "narrator": "みやび", "text": "いや、まさか…。\nウサギが、管理庁の\nスパイ…？"},
        { "location": "117/SEL"   , "narrator": "", "text": "ならバラすのは変じゃない？"},
        { "location": "118/ACT"   , "narrator": "", "text": "ならバラすのは変じゃない？"},
        { "location": "127/TALK"  , "narrator": "みやび", "text": "なるほど確かに"},
        { "location": "128/TALK"  , "narrator": "みやび", "text": "スパイだとしたら"},
        { "location": "129/TALK"  , "narrator": "みやび", "text": "素性がバレるようなことするはずがない"},
        { "location": "130/TALK"  , "narrator": "みやび", "text": "だが"},
        { "location": "131/TALK"  , "narrator": "みやび", "text": "そうなると"},
        { "location": "132/TALK"  , "narrator": "みやび", "text": "どういうことなのか？"},
        { "location": "134/SEL"   , "narrator": "", "text": "とりあえず敵ではないと思う"},
        { "location": "135/ACT"   , "narrator": "", "text": "とりあえず敵ではないと思う"},
        { "location": "137/TALK"  , "narrator": "みやび", "text": "それはわからない"},
        { "location": "139/TALK"  , "narrator": "みやび", "text": "理由がわからん以上"},
        { "location": "140/TALK"  , "narrator": "みやび", "text": "楽観はできない"},
        { "location": "143/TALK"  , "narrator": "みやび", "text": "なんにせよ"},
        { "location": "144/TALK"  , "narrator": "みやび", "text": "今は警戒する以外できんな"},
        { "location": "148/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "149/TALK"  , "narrator": "みやび", "text": "いかん…。\n頭が混乱しちょる。"},
        { "location": "150/TALK"  , "narrator": "みやび", "text": "けんど、まっこと\nこの状況、どう対応\nしたらえいか…。"},
        { "location": "152/TALK"  , "narrator": "みやび", "text": "…ダメや。\nとりあえず今は\n保留やな。"},
        { "location": "153/TALK"  , "narrator": "みやび", "text": "頭が働かん以上、\n何もしようがない。"},
        { "location": "154/TALK"  , "narrator": "みやび", "text": "…もう一つの方を、\n先に片づけるか。"},
        { "location": "174/TALK"  , "narrator": "みやび", "text": "まほさん、\nちっくとえいですか？"},
        { "location": "175/TALK"  , "narrator": "真幌", "text": "わかっている。\n卯月の件だろう？"},
        { "location": "176/TALK"  , "narrator": "みやび", "text": "…さすがですね。\nその通りです。"},
        { "location": "177/TALK"  , "narrator": "みやび", "text": "まほさん、正直に\n答えてください。"},
        { "location": "178/TALK"  , "narrator": "みやび", "text": "卯月があのメノウ\nだっちゅうことに\nついてですけんど。"},
        { "location": "179/TALK"  , "narrator": "みやび", "text": "まほさんは知ってて、\nうちらに黙っちょった\nがですか？"},
        { "location": "180/TALK"  , "narrator": "真幌", "text": "…おまえはどう思う？"},
        { "location": "181/TALK"  , "narrator": "みやび", "text": "半々ですね。\nメノウは一応アイドル\nですきね。"},
        { "location": "182/TALK"  , "narrator": "みやび", "text": "うちらが騒がんよう、\n黙っていたとも\n考えられます。"},
        { "location": "185/TALK"  , "narrator": "みやび", "text": "けんど、うちは。"},
        { "location": "187/TALK"  , "narrator": "みやび", "text": "まほさんも知らされて\nなかった、と思うて\nますけんど…。"},
        { "location": "189/TALK"  , "narrator": "真幌", "text": "…………。"},
        { "location": "190/TALK"  , "narrator": "みやび", "text": "どうながですか？"},
        { "location": "192/TALK"  , "narrator": "真幌", "text": "…その通りだよ。"},
        { "location": "193/TALK"  , "narrator": "真幌", "text": "私も、今日初めて、\n卯月がメノウだと\n知ったんだ。"},
        { "location": "194/TALK"  , "narrator": "みやび", "text": "やっぱり…。"},
        { "location": "195/TALK"  , "narrator": "真幌", "text": "まったく、\nおかしな話だ。"},
        { "location": "196/TALK"  , "narrator": "真幌", "text": "管理庁から渡された\n卯月の資料。"},
        { "location": "197/TALK"  , "narrator": "真幌", "text": "これには\nメノウに関する\n記述はなかった。"},
        { "location": "198/TALK"  , "narrator": "みやび", "text": "…故意に情報を\n隠されたっちゅう\nことですか？"},
        { "location": "199/TALK"  , "narrator": "真幌", "text": "管理庁がメノウの\n正体を知らなかった。"},
        { "location": "200/TALK"  , "narrator": "真幌", "text": "なんて、バカな話が\nない限りはな。"},
        { "location": "202/TALK"  , "narrator": "みやび", "text": "…どういうこと\nですか？"},
        { "location": "203/TALK"  , "narrator": "みやび", "text": "管理庁は、どうして\nうちらに情報を\n隠したがです？"},
        { "location": "204/TALK"  , "narrator": "真幌", "text": "さあな。\n私にも、さっぱりだ。"},
        { "location": "205/TALK"  , "narrator": "真幌", "text": "卯月がメノウだという\n事実を、何故管理庁は\n隠そうとしたのか…。"},
        { "location": "206/TALK"  , "narrator": "みやび", "text": "そうですね。"},
        { "location": "207/TALK"  , "narrator": "みやび", "text": "確かに驚きは\nしましたけんど。"},
        { "location": "208/TALK"  , "narrator": "みやび", "text": "それ以上何かって\nわけでもなさそう\nですし。"},
        { "location": "210/TALK"  , "narrator": "みやび", "text": "…今のところは、\nですけんど。"},
        { "location": "211/TALK"  , "narrator": "真幌", "text": "うむ…管理庁め、\nいったい何を考えて\nいるのか…。"},
        { "location": "212/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "214/TALK"  , "narrator": "真幌", "text": "…まあ、いいさ。\nこれで一つだけ\nハッキリしたんだ。"},
        { "location": "216/TALK"  , "narrator": "真幌", "text": "私の持っている\n卯月の情報。"},
        { "location": "217/TALK"  , "narrator": "真幌", "text": "これは\n管理庁の手が入り、\nねつ造されたものだ。"},
        { "location": "218/TALK"  , "narrator": "真幌", "text": "その理由を探る\n必要がある。"},
        { "location": "219/TALK"  , "narrator": "みやび", "text": "なるほど…。"},
        { "location": "220/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "221/TALK"  , "narrator": "みやび", "text": "ん？"},
        { "location": "222/TALK"  , "narrator": "みやび", "text": "もしかして。"},
        { "location": "223/TALK"  , "narrator": "みやび", "text": "うちに卯月のことを、\n徹底的に調べろ、\n言うてますが？"},
        { "location": "224/TALK"  , "narrator": "真幌", "text": "そういうことだ。\n頼めるか？"},
        { "location": "226/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "227/TALK"  , "narrator": "真幌", "text": "不満か？"},
        { "location": "229/TALK"  , "narrator": "みやび", "text": "いえ、そういうわけ\nではないがですよ。"},
        { "location": "230/TALK"  , "narrator": "みやび", "text": "うちも、卯月のことは\nスパイと思うてた\n時期がありますき。"},
        { "location": "231/TALK"  , "narrator": "真幌", "text": "では、任せていいな？"},
        { "location": "232/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "296/TALK"  , "narrator": "みやび", "text": "　"},
        { "location": "305/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "325/TALK"  , "narrator": "みやび", "text": "ふむ。"},
        { "location": "328/TALK"  , "narrator": "みやび", "text": "なるほど。"},
        { "location": "331/TALK"  , "narrator": "みやび", "text": "あいかわらずやね。"},
        { "location": "335/TALK"  , "narrator": "みやび", "text": "なんかアレやね。\n何されても何とも\n思わんくなってきた。"},
        { "location": "336/TALK"  , "narrator": "みやび", "text": "そうか！　これが\n倦怠期ちゅうやつか！"},
        { "location": "337/SEL"   , "narrator": "", "text": "まだつき合ってもいないのに！"},
        { "location": "338/SEL"   , "narrator": "", "text": "だいたいあってる"},
        { "location": "339/ACT"   , "narrator": "", "text": "まだつき合ってもいないのに！"},
        { "location": "342/TALK"  , "narrator": "みやび", "text": "けんど、ちゅうは\nしちょるぞね。"},
        { "location": "344/TALK"  , "narrator": "みやび", "text": "付き合いをすっ飛ばして\nちゅうと倦怠期は経験済み\nとか、斬新な関係やね！"},
        { "location": "346/TALK"  , "narrator": "みやび", "text": "ふむ、確かに。"},
        { "location": "347/TALK"  , "narrator": "みやび", "text": "付き合いをすっ飛ばして\n倦怠期とか、うちらは\n斬新な関係やね！"},
        { "location": "349/ACT"   , "narrator": "", "text": "だいたいあってる"},
        { "location": "350/TALK"  , "narrator": "みやび", "text": "ふむ。\n共通の見解が持てて\n何よりやね。"},
        { "location": "351/TALK"  , "narrator": "みやび", "text": "しかしあれやね。"},
        { "location": "352/TALK"  , "narrator": "みやび", "text": "つき合う前に倦怠期とか\nつき合ってからは一体\nどうなることやら。"},
        { "location": "353/SEL"   , "narrator": "", "text": "脈有り発言ですか？"},
        { "location": "354/SEL"   , "narrator": "", "text": "倦怠期は終わってるからずっとラブラブ期"},
        { "location": "355/ACT"   , "narrator": "", "text": "脈有り発言ですか？"},
        { "location": "356/TALK"  , "narrator": "みやび", "text": "うむ。"},
        { "location": "357/ACT"   , "narrator": "", "text": "倦怠期は終わってるからずっとラブラブ期"},
        { "location": "358/TALK"  , "narrator": "みやび", "text": "おめでたい頭やね。"},
        { "location": "359/TALK"  , "narrator": "みやび", "text": "だがしかし、まあ\nそうありたいものやね。"},
        { "location": "362/TALK"  , "narrator": "みやび", "text": "とまあ、挨拶は\nこれくらいにして。"},
        { "location": "363/TALK"  , "narrator": "みやび", "text": "早速今日のMKCC活動を\n開始する！"},
        { "location": "364/SEL"   , "narrator": "", "text": "元気ですね…"},
        { "location": "365/ACT"   , "narrator": "", "text": "元気ですね…"},
        { "location": "367/TALK"  , "narrator": "みやび", "text": "当然や。この活動が\n今のうちの生きる目的\nみたいなもんやき。"},
        { "location": "368/TALK"  , "narrator": "みやび", "text": "とゆうわけで、\n早速やけんど……、\n宿題はやってきたかね。"},
        { "location": "369/TALK"  , "narrator": "みやび", "text": "つばめちゃんの司書の\n名前を調べてくるちゅう\nやつや。"},
        { "location": "370/SEL"   , "narrator": "", "text": "もちろんです！"},
        { "location": "371/SEL"   , "narrator": "", "text": "まだです…"},
        { "location": "372/ACT"   , "narrator": "", "text": "もちろんです！"},
        { "location": "373/TALK"  , "narrator": "みやび", "text": "さすがは相棒や。\nで、何て名前やったか？"},
        { "location": "374/SEL"   , "narrator": "", "text": "リース"},
        { "location": "375/SEL"   , "narrator": "", "text": "フリル"},
        { "location": "376/SEL"   , "narrator": "", "text": "エリア"},
        { "location": "377/SEL"   , "narrator": "", "text": "アーリア"},
        { "location": "378/SEL"   , "narrator": "", "text": "フィル"},
        { "location": "379/SEL"   , "narrator": "", "text": "ネイ"},
        { "location": "380/SEL"   , "narrator": "", "text": "カレン"},
        { "location": "381/SEL"   , "narrator": "", "text": "クリス"},
        { "location": "382/SEL"   , "narrator": "", "text": "ソフィア"},
        { "location": "383/SEL"   , "narrator": "", "text": "クルーソー"},
        { "location": "384/SEL"   , "narrator": "", "text": "アリア"},
        { "location": "385/SEL"   , "narrator": "", "text": "権左衛門"},
        { "location": "386/ACT"   , "narrator": "", "text": "リース"},
        { "location": "388/ACT"   , "narrator": "", "text": "フリル"},
        { "location": "390/ACT"   , "narrator": "", "text": "エリア"},
        { "location": "392/ACT"   , "narrator": "", "text": "アーリア"},
        { "location": "394/ACT"   , "narrator": "", "text": "フィル"},
        { "location": "396/ACT"   , "narrator": "", "text": "ネイ"},
        { "location": "398/ACT"   , "narrator": "", "text": "カレン"},
        { "location": "400/ACT"   , "narrator": "", "text": "クリス"},
        { "location": "402/ACT"   , "narrator": "", "text": "ソフィア"},
        { "location": "404/ACT"   , "narrator": "", "text": "クルーソー"},
        { "location": "406/ACT"   , "narrator": "", "text": "アリア"},
        { "location": "408/ACT"   , "narrator": "", "text": "権左衛門"},
        { "location": "411/TALK"  , "narrator": "みやび", "text": "ふむ、なるほど。\nでは早速サーチを\nかけてみるか。"},
        { "location": "414/TALK"  , "narrator": "みやび", "text": "…。"},
        { "location": "415/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "417/TALK"  , "narrator": "みやび", "text": "む。\n出てきよった。"},
        { "location": "418/TALK"  , "narrator": "みやび", "text": "でかしたぞ、相棒！！\nやはりお前さんは、\nうちの相棒や！"},
        { "location": "419/TALK"  , "narrator": "みやび", "text": "もしうちが\nつばめちゃんだったら――"},
        { "location": "420/TALK"  , "narrator": "みやび", "text": "『しゅきしゅき！\n$handle$さん\nだーいしゅき（はあと）』"},
        { "location": "421/TALK"  , "narrator": "みやび", "text": "――ちゅうとって\nいたとこや！"},
        { "location": "422/SEL"   , "narrator": "", "text": "それはつばめに対する偏見では？"},
        { "location": "423/SEL"   , "narrator": "", "text": "みやびにも言って欲しい"},
        { "location": "424/ACT"   , "narrator": "", "text": "それはつばめに対する偏見では？"},
        { "location": "425/TALK"  , "narrator": "みやび", "text": "うむ。\nその通り。"},
        { "location": "426/TALK"  , "narrator": "みやび", "text": "だがしかし！\n世の中全て偏見や。"},
        { "location": "427/TALK"  , "narrator": "みやび", "text": "どんな些細なことでも\n偏見なしに他人を見る\nことはできん。"},
        { "location": "428/TALK"  , "narrator": "みやび", "text": "やき、偏見ではあるけんど\n咎められることでもない。"},
        { "location": "429/ACT"   , "narrator": "", "text": "みやびにも言って欲しい"},
        { "location": "430/TALK"  , "narrator": "みやび", "text": "否！"},
        { "location": "431/TALK"  , "narrator": "みやび", "text": "ゆうておくが、うち、\nMKCカンパニーの\n代表取締役やぞ？"},
        { "location": "432/TALK"  , "narrator": "みやび", "text": "そして、\nお前さんは単なる\n平社員や。"},
        { "location": "433/TALK"  , "narrator": "みやび", "text": "社長が平社員に\nしゅきしゅき！なんて\n言うか？　答えは否や！"},
        { "location": "435/SEL"   , "narrator": "", "text": "けど$me$は出資者でもあるんだけど"},
        { "location": "436/ACT"   , "narrator": "", "text": "けど$me$は出資者でもあるんだけど"},
        { "location": "438/TALK"  , "narrator": "みやび", "text": "うぐぅ。\n痛いところを突かれたな。"},
        { "location": "439/SEL"   , "narrator": "", "text": "出資者の希望は優先的に聞かないと"},
        { "location": "440/ACT"   , "narrator": "", "text": "出資者の希望は優先的に聞かないと"},
        { "location": "442/TALK"  , "narrator": "みやび", "text": "へいへい、\nわかりましたよ。"},
        { "location": "443/TALK"  , "narrator": "みやび", "text": "しゅきしゅき。"},
        { "location": "444/SEL"   , "narrator": "", "text": "ココロがこもってなくない？"},
        { "location": "445/SEL"   , "narrator": "", "text": "それじゃ次は脱ごうか"},
        { "location": "446/ACT"   , "narrator": "", "text": "ココロがこもってなくない？"},
        { "location": "447/TALK"  , "narrator": "みやび", "text": "贅沢なヤツやね。"},
        { "location": "448/TALK"  , "narrator": "みやび", "text": "…しゅきしゅき♪"},
        { "location": "449/TALK"  , "narrator": "みやび", "text": "ほい、これでお終いや。"},
        { "location": "450/ACT"   , "narrator": "", "text": "それじゃ次は脱ごうか"},
        { "location": "452/TALK"  , "narrator": "みやび", "text": "……。\n注文の多い\n出資者やね。"},
        { "location": "462/TALK"  , "narrator": "みやび", "text": "ほれ、\nご要望通り脱いだぞね。"},
        { "location": "466/TALK"  , "narrator": "みやび", "text": "とゆうわけで、\nちゃんと出資者の希望は\n聞いたちや。"},
        { "location": "467/TALK"  , "narrator": "みやび", "text": "けんど、出資額的に\n言うことを聞くのは\nこれでお終いな。"},
        { "location": "470/TALK"  , "narrator": "みやび", "text": "だいぶ脱線したが\n話を戻すと――"},
        { "location": "471/TALK"  , "narrator": "みやび", "text": "相棒が見つけて来た\nつばめちゃんの司書の\n名前は適合した。"},
        { "location": "472/TALK"  , "narrator": "みやび", "text": "よって、次回はいよいよ\nそこへ殴り込みをかける。"},
        { "location": "473/TALK"  , "narrator": "みやび", "text": "しっかりココロの準備を\nしてきいや。"},
        { "location": "476/TALK"  , "narrator": "みやび", "text": "む。\nNotFound…。"},
        { "location": "477/TALK"  , "narrator": "みやび", "text": "「そんなやついない」と\n言われちょるんやが。"},
        { "location": "478/TALK"  , "narrator": "みやび", "text": "失望した。\nまっこと使えん\n相棒やね。"},
        { "location": "479/TALK"  , "narrator": "みやび", "text": "まあえい。時間もないし、\nあとはうちが適当に\nハッキングして見つける。"},
        { "location": "480/TALK"  , "narrator": "みやび", "text": "ほんで、次回はいよいよ\nつばめちゃんのココロの\n中に殴り込みをかける。"},
        { "location": "481/TALK"  , "narrator": "みやび", "text": "しっかりココロの準備を\nしてきいや。"},
        { "location": "483/ACT"   , "narrator": "", "text": "まだです…"},
        { "location": "484/TALK"  , "narrator": "みやび", "text": "なんぞ、まだやったか！"},
        { "location": "485/TALK"  , "narrator": "みやび", "text": "失望した。\nまっこと使えん\n相棒やね。"},
        { "location": "486/TALK"  , "narrator": "みやび", "text": "まあえい。時間もないし、\nあとはうちが適当に\nハッキングして見つける。"},
        { "location": "487/TALK"  , "narrator": "みやび", "text": "ほんで、次回はいよいよ\nつばめちゃんのココロの\n中に殴り込みをかける。"},
        { "location": "488/TALK"  , "narrator": "みやび", "text": "しっかりココロの準備を\nしてきいや。"},
        { "location": "490/SEL"   , "narrator": "", "text": "承知しました！"},
        { "location": "491/SEL"   , "narrator": "", "text": "目的変わってない？"},
        { "location": "492/ACT"   , "narrator": "", "text": "承知しました！"},
        { "location": "493/TALK"  , "narrator": "みやび", "text": "うむ。"},
        { "location": "494/ACT"   , "narrator": "", "text": "目的変わってない？"},
        { "location": "495/TALK"  , "narrator": "みやび", "text": "変わっちょらんが？"},
        { "location": "496/TALK"  , "narrator": "みやび", "text": "つばめちゃんの司書が\n閉架におるなら、そこへ\n行きデータを採取する。"},
        { "location": "497/TALK"  , "narrator": "みやび", "text": "そのデータを元に、\nうちの閉架の所在を\n見つけ出すんよ。"},
        { "location": "498/TALK"  , "narrator": "みやび", "text": "わかったかね、相棒。"},
        { "location": "500/TALK"  , "narrator": "みやび", "text": "さて、ほんだらこれで\nMKCCの活動はお終いや。"},
        { "location": "501/TALK"  , "narrator": "みやび", "text": "後はとっとと\nココロの悩みを\n解決するとしようかね。"},
        { "location": "504/TALK"  , "narrator": "みやび", "text": "オープンプロセス、\n0x228番地から\n0x5FC番地へ。"},
        { "location": "519/TALK"  , "narrator": "みやび", "text": "完了。"},
        { "location": "522/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "523/TALK"  , "narrator": "みやび", "text": "なるほど。\nわりと真面目な問題やね。\n今回は。"},
        { "location": "524/TALK"  , "narrator": "みやび", "text": "まあ、ココロの中では\n答えは決まっちゅう。"},
        { "location": "525/TALK"  , "narrator": "みやび", "text": "卯月は仲間や。悪と\n決めつけて探りを入れる\nなんぞ、できんよ。"},
        { "location": "526/SEL"   , "narrator": "", "text": "みやびも神楽のことは疑ってなかったっけ？"},
        { "location": "527/ACT"   , "narrator": "", "text": "みやびも神楽のことは疑ってなかったっけ？"},
        { "location": "529/TALK"  , "narrator": "みやび", "text": "もちろん疑っちゅう。\nけんどな――"},
        { "location": "530/TALK"  , "narrator": "みやび", "text": "それだけの理由で人の\nプライバシーを根こそぎ\n暴くなんぞは時代逆行や。"},
        { "location": "531/TALK"  , "narrator": "みやび", "text": "惨たらしい魔女裁判を\nやっていた時代と\n変わらんぞね。"},
        { "location": "532/TALK"  , "narrator": "みやび", "text": "まあもちろん、\n警戒はし続けることに\n変わりは無い。"},
        { "location": "533/TALK"  , "narrator": "みやび", "text": "やき、もし何か尻尾を\n出したときは――"},
        { "location": "534/TALK"  , "narrator": "みやび", "text": "その周辺情報については\n容赦なく暴きにかかる。"},
        { "location": "535/TALK"  , "narrator": "みやび", "text": "それだけぞね。"},
        { "location": "536/SEL"   , "narrator": "", "text": "わかった"},
        { "location": "537/SEL"   , "narrator": "", "text": "甘いな"},
        { "location": "538/SEL"   , "narrator": "", "text": "惚れた"},
        { "location": "539/ACT"   , "narrator": "", "text": "わかった"},
        { "location": "540/TALK"  , "narrator": "みやび", "text": "うむ。"},
        { "location": "541/ACT"   , "narrator": "", "text": "甘いな"},
        { "location": "542/TALK"  , "narrator": "みやび", "text": "うむ、スイーツで結構。"},
        { "location": "543/TALK"  , "narrator": "みやび", "text": "可能なら洋菓子認定より\n和菓子認定して\nいただけると嬉しいが。"},
        { "location": "544/TALK"  , "narrator": "みやび", "text": "そこは人それぞれや。\n譲れないところはある。\nお前さんもそうやろ？"},
        { "location": "545/ACT"   , "narrator": "", "text": "惚れた"},
        { "location": "547/TALK"  , "narrator": "みやび", "text": "なんも惚れられるような\nことはしちょらんよ。"},
        { "location": "549/TALK"  , "narrator": "みやび", "text": "卯月やて、好きで今の\n状況になっちゅうかすら\nわかっちょらんきね。"},
        { "location": "550/TALK"  , "narrator": "みやび", "text": "人をジャッジするには\nそれ相当の確定情報が\n必要なんよ。"},
        { "location": "551/TALK"  , "narrator": "みやび", "text": "それまでは絶対に\n実力行使はいかんちや。"},
        { "location": "553/TALK"  , "narrator": "みやび", "text": "つーわけで、うちに\n上司に逆らう勇気を\n与えてくりや。"},
        { "location": "555/TALK"  , "narrator": "みやび", "text": "うちと$handle$に\nえいココロの旅を。"},
        { "location": "23/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>7月24日　9:32 PM</color>\nフェノメノン戦の後片付け全終了後、神楽坂トライナリー劇場にて。"},
        { "location": "261/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "263/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "265/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "267/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "269/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"},
