{
    "dir": "chap24/daydra/dd_ch03_24_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "24356",
        "cid": "gabriella",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "放課後のサプライズ"
    },
    "entry":
    [
        { "location": "320/SCENARIO", "narrator": "", "text": "放課後のサプライズ"},
        { "location": "338/TALK"    , "narrator": "ガブリエラ", "text": "さてと…バイトもないし、\n放課後は何しようかしら？"},
        { "location": "341/TALK"    , "narrator": "雛", "text": "ガブリエラちゃん、いる？"},
        { "location": "343/TALK"    , "narrator": "ガブリエラ", "text": "ちょ、ひなこ！？\n何で教室に来て――"},
        { "location": "347/TALK"    , "narrator": "つばめ", "text": "よかった、\nまだ帰ってなくて…。"},
        { "location": "348/TALK"    , "narrator": "ガブリエラ", "text": "いや、待って待って！\n何なのよいったい！？"},
        { "location": "349/TALK"    , "narrator": "ガブリエラ", "text": "っていうか、目立つから\n静かにしてよ！"},
        { "location": "350/TALK"    , "narrator": "雛", "text": "それどころじゃないよ！\nガブリエラちゃん、\nもう時間がないの。"},
        { "location": "351/TALK"    , "narrator": "雛", "text": "あたし達と一緒に来て！"},
        { "location": "352/TALK"    , "narrator": "ガブリエラ", "text": "えっ？"},
        { "location": "353/TALK"    , "narrator": "つばめ", "text": "大変なことになったの！"},
        { "location": "354/TALK"    , "narrator": "つばめ", "text": "もう時間もなくて…、\nだからお願い！\n一緒に来て！"},
        { "location": "355/TALK"    , "narrator": "ガブリエラ", "text": "こんなに慌てて…、\n何かあったのかしら？"},
        { "location": "356/TALK"    , "narrator": "ガブリエラ", "text": "…わかった。\n案内して。"},
        { "location": "357/TALK"    , "narrator": "つばめ", "text": "やった！"},
        { "location": "359/TALK"    , "narrator": "雛", "text": "遅くなっちゃうし、\n急ぐよー。"},
        { "location": "360/TALK"    , "narrator": "ガブリエラ", "text": "それで、場所はどこ？"},
        { "location": "361/TALK"    , "narrator": "つばめ", "text": "うん、えっとね――"},
        { "location": "376/TALK"    , "narrator": "つばめ", "text": "よ、よかったぁ。\n何とか時間ぎりぎり\n間に合ったね。"},
        { "location": "378/TALK"    , "narrator": "つばめ", "text": "これも全部\nひなこちゃんの\nおかげだよ。"},
        { "location": "379/TALK"    , "narrator": "雛", "text": "ふふん、鉄道を極める者は\n時間を制す、ってねー。"},
        { "location": "381/TALK"    , "narrator": "繭", "text": "…その趣味、初めて人の\n役に立ったんじゃない？"},
        { "location": "383/TALK"    , "narrator": "雛", "text": "じゃあ普段から頼ってよ。\nそしたらもっともっと\n役に立てるんだからさー。"},
        { "location": "385/TALK"    , "narrator": "ガブリエラ", "text": "…ちょっと。"},
        { "location": "387/TALK"    , "narrator": "繭", "text": "あ、忘れてた。\nチケットね。"},
        { "location": "388/TALK"    , "narrator": "ガブリエラ", "text": "そうじゃなくて。"},
        { "location": "390/TALK"    , "narrator": "ガブリエラ", "text": "何よこれ！？\nどうして遊園地に\n連れてきたのよ！？"},
        { "location": "391/TALK"    , "narrator": "雛", "text": "遊ぶためだよー。\nねー？"},
        { "location": "392/TALK"    , "narrator": "つばめ", "text": "ねー。"},
        { "location": "393/TALK"    , "narrator": "ガブリエラ", "text": "あ、あのねぇ…。"},
        { "location": "394/TALK"    , "narrator": "繭", "text": "気まぐれでやった\nネットのくじで当てたの。"},
        { "location": "395/TALK"    , "narrator": "繭", "text": "夕方から入場できる\nパスポート券…四人分。"},
        { "location": "396/TALK"    , "narrator": "ガブリエラ", "text": "…なるほどね。"},
        { "location": "397/TALK"    , "narrator": "繭", "text": "興味ないから忘れてて、\n気づいたら有効期限が\n今日だった。"},
        { "location": "398/TALK"    , "narrator": "ガブリエラ", "text": "…で？　一人分余ったから\nあたしを連れてきたわけ？"},
        { "location": "399/TALK"    , "narrator": "雛", "text": "そういうこと。"},
        { "location": "401/TALK"    , "narrator": "雛", "text": "ガブリエラちゃん、\n最近すっごいピリピリ\nしてるでしょ？"},
        { "location": "402/TALK"    , "narrator": "雛", "text": "だから、ちょっと遊んで\n気分転換してほしいな、\nって思ったんだー。"},
        { "location": "404/TALK"    , "narrator": "繭", "text": "…並ばなくていいの？\n急いできた意味なくなる\nわよ？"},
        { "location": "405/TALK"    , "narrator": "雛", "text": "うん。とりあえず\nなに乗ろっか？"},
        { "location": "406/TALK"    , "narrator": "ガブリエラ", "text": "ちょっと、あたしは\n遊んでる暇なんか――"},
        { "location": "409/TALK"    , "narrator": "つばめ", "text": "メリーゴーランドとか、\nガブちゃん好きそうかも。"},
        { "location": "410/TALK"    , "narrator": "ガブリエラ", "text": "いや、好きじゃないし！\nっていうか乗らないから！"},
        { "location": "412/TALK"    , "narrator": "雛", "text": "まゆちん、最初は\nどれから攻める？"},
        { "location": "414/TALK"    , "narrator": "繭", "text": "…ジェットコースター。\n景気づけに最適だと思う。"},
        { "location": "416/TALK"    , "narrator": "雛", "text": "じゃ、決まりね。\nほら行くよー。"},
        { "location": "417/TALK"    , "narrator": "ガブリエラ", "text": "ちょ、引っ張らないで！"},
        { "location": "433/TALK"    , "narrator": "つばめ", "text": "はぁ～…すごかったねぇ。"},
        { "location": "434/TALK"    , "narrator": "雛", "text": "うん…久々に乗ったけど、\nあんな速かったっけ？"},
        { "location": "435/TALK"    , "narrator": "繭", "text": "…………。"},
        { "location": "438/TALK"    , "narrator": "つばめ", "text": "あれ、まゆちん？"},
        { "location": "439/TALK"    , "narrator": "繭", "text": "…ちょっと酔った。\nすぐよくなるから平気。"},
        { "location": "440/TALK"    , "narrator": "ガブリエラ", "text": "…だらしないわねぇ。\nみんなボロボロじゃない。"},
        { "location": "442/TALK"    , "narrator": "つばめ", "text": "あ、あはは…。"},
        { "location": "444/TALK"    , "narrator": "雛", "text": "ガブリエラちゃんは\n平気そうだねー？"},
        { "location": "447/TALK"    , "narrator": "ガブリエラ", "text": "当然よ。\nジェットコースターで\nへばる鍛え方してないわ。"},
        { "location": "449/TALK"    , "narrator": "つばめ", "text": "すごいなぁ…。\nわたしも見習わなくちゃ。"},
        { "location": "452/TALK"    , "narrator": "ガブリエラ", "text": "あのね…三戸浜での\n訓練の成果は\nどこ行っちゃったのよ？"},
        { "location": "453/TALK"    , "narrator": "雛", "text": "まあまあ。\nじゃ、次はゆったりできる\n乗り物にしよ。"},
        { "location": "455/TALK"    , "narrator": "繭", "text": "…ショーがいい。\nちょうど、始まるところ\nだから…。"},
        { "location": "457/TALK"    , "narrator": "雛", "text": "じゃ、休憩がてら\nショーを見るってことで。"},
        { "location": "460/TALK"    , "narrator": "ガブリエラ", "text": "乗り物、まだ一つしか\n乗ってないんだけど？"},
        { "location": "462/TALK"    , "narrator": "つばめ", "text": "でも、ショーだって\n楽しいと思うよ？"},
        { "location": "463/TALK"    , "narrator": "ガブリエラ", "text": "そうかしら？\n屋内のショーなんて、\n大したことは――"},
        { "location": "479/TALK"    , "narrator": "ガブリエラ", "text": "は～…ダンスも歌も、\nとっても素敵で最高の\nショーだったわ！"},
        { "location": "480/TALK"    , "narrator": "つばめ", "text": "うん！　あの主役の人、\nとっても素敵だったね。"},
        { "location": "481/TALK"    , "narrator": "雛", "text": "あたし、感動して\nちょっと泣いちゃいそう\nだったよー。"},
        { "location": "483/TALK"    , "narrator": "つばめ", "text": "あ、ちょっと涙出てる。\nハンカチ使う？"},
        { "location": "485/TALK"    , "narrator": "雛", "text": "あ、大丈夫大丈夫。\nえへへ、恥ずかしいな…。"},
        { "location": "487/TALK"    , "narrator": "ガブリエラ", "text": "恥じることないって。\n他にも泣いてる人、\n結構いたわよ？"},
        { "location": "490/TALK"    , "narrator": "雛", "text": "そうなの？\n気づかなかったよー。"},
        { "location": "492/TALK"    , "narrator": "つばめ", "text": "そういえば、\nまゆちん、具合は？"},
        { "location": "494/TALK"    , "narrator": "繭", "text": "仮眠取って完全回復。\nもう平気。"},
        { "location": "496/TALK"    , "narrator": "ガブリエラ", "text": "寝てたの！？\n勿体ないわね…。"},
        { "location": "498/TALK"    , "narrator": "繭", "text": "で、次は？\nお化け屋敷？\nフリーフォール？"},
        { "location": "499/TALK"    , "narrator": "ガブリエラ", "text": "フリーフォールなんて\nあるの？"},
        { "location": "501/TALK"    , "narrator": "繭", "text": "ある。\nこの前できたばかりの\n新しいヤツ。"},
        { "location": "503/TALK"    , "narrator": "ガブリエラ", "text": "楽しそうね、それ。\nあたしは賛成よ。"},
        { "location": "506/TALK"    , "narrator": "雛", "text": "フリーフォールかぁ…。\n楽しいけど、あれ結構\nキツいんだよねー。"},
        { "location": "508/TALK"    , "narrator": "繭", "text": "それがいい。"},
        { "location": "509/TALK"    , "narrator": "ガブリエラ", "text": "ジェットコースターで\nグロッキーしてたのは\n誰だったかしら？"},
        { "location": "510/TALK"    , "narrator": "繭", "text": "授業で疲れてただけ。\nもう平気。"},
        { "location": "513/TALK"    , "narrator": "雛", "text": "ってことらしいけど、\nどうするー？"},
        { "location": "516/TALK"    , "narrator": "つばめ", "text": "わたしも賛成。\n乗ったことないから\n楽しみだよ。"},
        { "location": "519/TALK"    , "narrator": "ガブリエラ", "text": "じゃ、急ぎましょ。\nあれって人気だから、\n結構並ぶはずよ。"},
        { "location": "524/TALK"    , "narrator": "つばめ", "text": "あっ、待ってガブちゃん！"},
        { "location": "530/TALK"    , "narrator": "雛", "text": "…よかったねー。\n作戦通り！"},
        { "location": "532/TALK"    , "narrator": "繭", "text": "…チケットのこと\n思い出してよかった。"},
        { "location": "533/TALK"    , "narrator": "ガブリエラ", "text": "何やってんのー！？\n早く来ないと\nはぐれるわよ！"},
        { "location": "553/TALK"    , "narrator": "雛", "text": "んーっっっっ！！！\n遊んだねーっ！"},
        { "location": "554/TALK"    , "narrator": "つばめ", "text": "楽しかったぁ…。"},
        { "location": "556/TALK"    , "narrator": "つばめ", "text": "でも、フリーフォールは\nもういいかな…。"},
        { "location": "558/TALK"    , "narrator": "ガブリエラ", "text": "あの時のつばめ、\n本気で叫んでたでしょ？"},
        { "location": "560/TALK"    , "narrator": "つばめ", "text": "さ、叫んでないよ。\nビックリはしたけど…。"},
        { "location": "561/TALK"    , "narrator": "ガブリエラ", "text": "ウソよ。\n隣で凄い声したもの。"},
        { "location": "563/TALK"    , "narrator": "雛", "text": "あたしも聞いたよー。\nはひぇぇぇぇ、だっけ？"},
        { "location": "565/TALK"    , "narrator": "繭", "text": "ひゃぃぃぃぃ、に\n聞こえたけど？"},
        { "location": "567/TALK"    , "narrator": "つばめ", "text": "お、思い出さないでよぉ。"},
        { "location": "569/TALK"    , "narrator": "ガブリエラ", "text": "あはは…。"},
        { "location": "571/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "572/TALK"    , "narrator": "ガブリエラ", "text": "結局…閉園間際まで\n楽しんじゃってる…。"},
        { "location": "575/TALK"    , "narrator": "ガブリエラ", "text": "こんなことしてる\n状況じゃないって、\nわかってたのに…。"},
        { "location": "576/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "591/TALK"    , "narrator": "ガブリエラ", "text": "ダメね"},
        { "location": "593/TALK"    , "narrator": "ガブリエラ", "text": "私ったら"},
        { "location": "594/TALK"    , "narrator": "ガブリエラ", "text": "おもいっきり遊んじゃったわ"},
        { "location": "596/SEL"     , "narrator": "", "text": "すごく楽しそうだった"},
        { "location": "597/ACT"     , "narrator": "", "text": "すごく楽しそうだった"},
        { "location": "599/TALK"    , "narrator": "ガブリエラ", "text": "うん"},
        { "location": "600/TALK"    , "narrator": "ガブリエラ", "text": "とっても楽しかったわ"},
        { "location": "601/TALK"    , "narrator": "ガブリエラ", "text": "楽し過ぎて"},
        { "location": "602/TALK"    , "narrator": "ガブリエラ", "text": "遊んでる間"},
        { "location": "603/TALK"    , "narrator": "ガブリエラ", "text": "一度も神楽のこと考えなかった"},
        { "location": "606/TALK"    , "narrator": "ガブリエラ", "text": "なんか"},
        { "location": "607/TALK"    , "narrator": "ガブリエラ", "text": "スッキリしたわ"},
        { "location": "609/SEL"     , "narrator": "", "text": "それはよかった"},
        { "location": "610/ACT"     , "narrator": "", "text": "それはよかった"},
        { "location": "612/TALK"    , "narrator": "ガブリエラ", "text": "ええ"},
        { "location": "614/TALK"    , "narrator": "ガブリエラ", "text": "雛達にも"},
        { "location": "615/TALK"    , "narrator": "ガブリエラ", "text": "感謝しないとね"},
        { "location": "616/TALK"    , "narrator": "ガブリエラ", "text": "多分"},
        { "location": "617/TALK"    , "narrator": "ガブリエラ", "text": "最近の私や"},
        { "location": "618/TALK"    , "narrator": "ガブリエラ", "text": "つばめの様子を見て"},
        { "location": "619/TALK"    , "narrator": "ガブリエラ", "text": "気を使ってくれたんだと思うの"},
        { "location": "622/TALK"    , "narrator": "ガブリエラ", "text": "ちゃんとお礼言わないと"},
        { "location": "623/TALK"    , "narrator": "ガブリエラ", "text": "気を使わせたって"},
        { "location": "624/SEL"     , "narrator": "", "text": "楽しかった、の一言でいい"},
        { "location": "625/TALK"    , "narrator": "ガブリエラ", "text": "本当"},
        { "location": "626/TALK"    , "narrator": "ガブリエラ", "text": "二人のおかげで"},
        { "location": "627/TALK"    , "narrator": "ガブリエラ", "text": "スッキリできたから"},
        { "location": "640/TALK"    , "narrator": "ガブリエラ", "text": "…気を使わせたわね。"},
        { "location": "641/TALK"    , "narrator": "雛", "text": "え？"},
        { "location": "644/TALK"    , "narrator": "ガブリエラ", "text": "今日のこと…、\nこれ、あたし達のために\n誘ってくれたんでしょ？"},
        { "location": "645/TALK"    , "narrator": "繭", "text": "…………。"},
        { "location": "648/TALK"    , "narrator": "つばめ", "text": "何のこと？"},
        { "location": "652/TALK"    , "narrator": "ガブリエラ", "text": "あのね…普通に考えれば\nわかるでしょ？"},
        { "location": "653/TALK"    , "narrator": "ガブリエラ", "text": "あたし達が大変で、\nピリピリしてる時に――"},
        { "location": "654/TALK"    , "narrator": "ガブリエラ", "text": "都合よく遊園地の\nチケットが手に入った、\nなんてあると思う？"},
        { "location": "656/TALK"    , "narrator": "つばめ", "text": "…え？"},
        { "location": "659/TALK"    , "narrator": "つばめ", "text": "じゃ、じゃあ、\nもしかして！"},
        { "location": "661/TALK"    , "narrator": "雛", "text": "あははー…さすがは\nガブリエラちゃんだね。"},
        { "location": "663/TALK"    , "narrator": "繭", "text": "あからさま過ぎたみたい。"},
        { "location": "664/TALK"    , "narrator": "つばめ", "text": "えーっ！\nそうだったの！？"},
        { "location": "666/TALK"    , "narrator": "ガブリエラ", "text": "あんたは…ほんっとう、\n天然なんだから…。"},
        { "location": "669/TALK"    , "narrator": "つばめ", "text": "うう、ごめんなさい…。"},
        { "location": "671/TALK"    , "narrator": "雛", "text": "ああ、いいのいいの。\nそれが目的だったんだし。"},
        { "location": "672/TALK"    , "narrator": "雛", "text": "色んなこと考えて、\nずっとモヤモヤしてた\nみたいだから――"},
        { "location": "673/TALK"    , "narrator": "雛", "text": "今日くらい、二人には\n嫌なこと忘れて\nほしかったんだー。"},
        { "location": "675/TALK"    , "narrator": "ガブリエラ", "text": "やっぱりね…。"},
        { "location": "676/TALK"    , "narrator": "ガブリエラ", "text": "…って、あれ？\nじゃあもしかして…。"},
        { "location": "677/TALK"    , "narrator": "雛", "text": "けど、そうだよね…。\nガブリエラちゃんには\nさすがに気づかれるかー。"},
        { "location": "680/TALK"    , "narrator": "ガブリエラ", "text": "しまった…。\n気づいてないフリして\nおくべきだったわ…。"},
        { "location": "682/TALK"    , "narrator": "繭", "text": "でも、楽しんでもらえた\nならそれでいい。"},
        { "location": "683/TALK"    , "narrator": "繭", "text": "チケットが余ってたのは\n事実だから、有益に使えて\nこっちも満足だし。"},
        { "location": "684/TALK"    , "narrator": "ガブリエラ", "text": "え、ええ…もちろん、\n今日はとっても\n楽しかったわ。"},
        { "location": "686/TALK"    , "narrator": "つばめ", "text": "二人とも、\n今日はありがと。"},
        { "location": "687/TALK"    , "narrator": "雛", "text": "喜んでもらえたなら、\nこっちも嬉しいよー。"},
        { "location": "689/TALK"    , "narrator": "ガブリエラ", "text": "…今だけは、つばめの\n天然が羨ましいわ…。"},
        { "location": "690/ACT"     , "narrator": "", "text": "楽しかった、の一言でいい"},
        { "location": "692/TALK"    , "narrator": "ガブリエラ", "text": "どうしてよ？"},
        { "location": "693/TALK"    , "narrator": "ガブリエラ", "text": "お礼を言うのって変？"},
        { "location": "694/TALK"    , "narrator": "ガブリエラ", "text": "礼儀でしょ？"},
        { "location": "696/SEL"     , "narrator": "", "text": "気を使ったと気づかれたくないはず"},
        { "location": "697/ACT"     , "narrator": "", "text": "気を使ったと気づかれたくないはず"},
        { "location": "701/TALK"    , "narrator": "ガブリエラ", "text": "そっか"},
        { "location": "705/TALK"    , "narrator": "ガブリエラ", "text": "気を使ってるって"},
        { "location": "706/TALK"    , "narrator": "ガブリエラ", "text": "バレないようにしてくれてるんだから"},
        { "location": "707/TALK"    , "narrator": "ガブリエラ", "text": "私が言ったら"},
        { "location": "708/TALK"    , "narrator": "ガブリエラ", "text": "台無しだものね"},
        { "location": "709/TALK"    , "narrator": "ガブリエラ", "text": "ありがと"},
        { "location": "710/TALK"    , "narrator": "ガブリエラ", "text": "あとはこっちでやるわ"},
        { "location": "722/TALK"    , "narrator": "ガブリエラ", "text": "…とっても楽しかったわ。"},
        { "location": "724/TALK"    , "narrator": "雛", "text": "ほんと？"},
        { "location": "725/TALK"    , "narrator": "ガブリエラ", "text": "ええ…最初はどこに\n連れてかれるのかと\n思ったけどね。"},
        { "location": "726/TALK"    , "narrator": "ガブリエラ", "text": "でも、来てよかったわ。"},
        { "location": "728/TALK"    , "narrator": "つばめ", "text": "わたしも、\nほんと楽しかった！"},
        { "location": "730/TALK"    , "narrator": "つばめ", "text": "まゆちん、\nチケットありがと！"},
        { "location": "732/TALK"    , "narrator": "繭", "text": "…気にしないで。\n余りものだから。"},
        { "location": "734/TALK"    , "narrator": "雛", "text": "…えへへ。"},
        { "location": "736/TALK"    , "narrator": "つばめ", "text": "ん？　どうしたの？"},
        { "location": "737/TALK"    , "narrator": "雛", "text": "あ、ううん。\nなんでもないよー。"},
        { "location": "739/TALK"    , "narrator": "繭", "text": "…………。"},
        { "location": "741/TALK"    , "narrator": "ガブリエラ", "text": "…ほんと、感謝するわ。"},
        { "location": "329/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>9月1日　 4:03 PM</color>\nとある平日の放課後、付属学園ガブリエラの教室にて"},
        { "location": "752/DIALOG"  , "narrator": "Dialog_GEThimegoto_ch03", "text": "【野暮でもいいのに】"}
    ]
}
