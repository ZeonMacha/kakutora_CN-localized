{
    "dir": "chap11/daydra/dd_ch04_11_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "11402",
        "cid": "miyabi",
        "title": "002 メインストーリー",
        "sub_title": "ガブちゃんの真実は＜前編＞"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "ガブちゃんの真実は"},
        { "location": "25/TALK"   , "narrator": "みやび", "text": "…身体が重い。"},
        { "location": "26/TALK"   , "narrator": "みやび", "text": "昨日、七夕祭りで\n遊び過ぎたか…。"},
        { "location": "27/TALK"   , "narrator": "みやび", "text": "…ちくっと座って\n身体休めるか。"},
        { "location": "29/TALK"   , "narrator": "みやび", "text": "二度寝こそ\nこの世の至福。"},
        { "location": "30/TALK"   , "narrator": "みやび", "text": "…他人を信じさせる\nには――"},
        { "location": "31/TALK"   , "narrator": "みやび", "text": "たまに本当のことも\n交えんとな。"},
        { "location": "32/TALK"   , "narrator": "みやび", "text": "さて、少しの間\nおやすみ…。"},
        { "location": "33/TALK"   , "narrator": "雛", "text": "あっ、やっぱそうだ。"},
        { "location": "35/TALK"   , "narrator": "雛", "text": "おはようございます、\nみやび先輩！"},
        { "location": "38/TALK"   , "narrator": "みやび", "text": "…ん？"},
        { "location": "39/TALK"   , "narrator": "雛", "text": "ほら、まゆちん。\n早く早く！"},
        { "location": "42/TALK"   , "narrator": "繭", "text": "…みやび先輩、\nおはようございます。"},
        { "location": "44/TALK"   , "narrator": "繭", "text": "お疲れのところ、\n朝から騒がしくして\n申し訳ありません。"},
        { "location": "45/TALK"   , "narrator": "みやび", "text": "…あんたらは。"},
        { "location": "47/TALK"   , "narrator": "みやび", "text": "…誰やったっけか？\n見覚えはあるんや\nけんど――"},
        { "location": "69/TALK"   , "narrator": "みやび", "text": "ところで…あんたら、\nつばめちゃん達の\nお友達かの？"},
        { "location": "70/TALK"   , "narrator": "雛", "text": "いえす！"},
        { "location": "72/TALK"   , "narrator": "繭", "text": "…………。"},
        { "location": "73/TALK"   , "narrator": "みやび", "text": "そうか。"},
        { "location": "74/TALK"   , "narrator": "みやび", "text": "うちの新人さんの\nこと、今後とも\nよろしゅうな。"},
        { "location": "75/TALK"   , "narrator": "ヒカル", "text": "わかりました。"},
        { "location": "76/TALK"   , "narrator": "キリト", "text": "了解っす！"},
        { "location": "77/TALK"   , "narrator": "みやび", "text": "うん…。"},
        { "location": "79/TALK"   , "narrator": "みやび", "text": "…そっちの子も、\nよろしゅう頼むがよ。"},
        { "location": "82/TALK"   , "narrator": "繭", "text": "っ！？\nあ、は、はい！！\nお任せください！！"},
        { "location": "83/TALK"   , "narrator": "キリト", "text": "あはは、何だよ？\n何テンパッて――"},
        { "location": "85/TALK"   , "narrator": "繭", "text": "ふんっ！"},
        { "location": "89/TALK"   , "narrator": "キリト", "text": "ぐはっ！？"},
        { "location": "106/TALK"  , "narrator": "みやび", "text": "…ああ、思い出した。\nつばめちゃんの\nお友達の――"},
        { "location": "107/TALK"  , "narrator": "みやび", "text": "元気な女の子と、\nちくっと変わった\nのか…。"},
        { "location": "110/TALK"  , "narrator": "みやび", "text": "おはよう。\nえぇっと、確か…。"},
        { "location": "112/TALK"  , "narrator": "雛", "text": "ひなこと\nまゆちんです！"},
        { "location": "114/TALK"  , "narrator": "繭", "text": "光月繭です…。\nこっちはひなこで\nいいです。"},
        { "location": "116/TALK"  , "narrator": "みやび", "text": "なるほど、覚えた。"},
        { "location": "117/TALK"  , "narrator": "雛", "text": "みやび先輩、\n大丈夫ですか？"},
        { "location": "118/TALK"  , "narrator": "雛", "text": "何だかいつも以上に\n元気がないですよー？"},
        { "location": "121/TALK"  , "narrator": "みやび", "text": "朝起きたらな、\n昨日の疲れがドッと\n押し寄せてきたがよ。"},
        { "location": "122/TALK"  , "narrator": "繭", "text": "…昨夜は、\n何かあったのですか？"},
        { "location": "123/TALK"  , "narrator": "みやび", "text": "七夕祭りや。\nうちらのメンバーと、\nほれ、あの子ら…。"},
        { "location": "124/TALK"  , "narrator": "繭", "text": "…キリトとヒカル\nですか？"},
        { "location": "125/TALK"  , "narrator": "みやび", "text": "そうそう、あの二人と\n一緒に行ったがよ。"},
        { "location": "126/TALK"  , "narrator": "雛", "text": "あー、そういえば\nキリト達がそんなこと\n言ってたっけ？"},
        { "location": "128/TALK"  , "narrator": "みやび", "text": "二人は\n行かんかったが？"},
        { "location": "129/TALK"  , "narrator": "雛", "text": "行こうかなぁ、とは\n思ってたんです。"},
        { "location": "130/TALK"  , "narrator": "雛", "text": "でも、テレビで\n世界の鉄道特集が\nやってて、つい…。"},
        { "location": "131/TALK"  , "narrator": "みやび", "text": "祭りよりテレビを\n取ったっちゅう\nことか？"},
        { "location": "132/TALK"  , "narrator": "雛", "text": "お祭りも好きだけど、\n電車はもっと好き\nなんです！"},
        { "location": "134/TALK"  , "narrator": "みやび", "text": "…面白い子やね。"},
        { "location": "135/TALK"  , "narrator": "みやび", "text": "光月さんは？"},
        { "location": "136/TALK"  , "narrator": "繭", "text": "あ、は、はい…。\n昨日の夜は、\nバイトでした…。"},
        { "location": "137/TALK"  , "narrator": "雛", "text": "よく働くねぇ。\nシフト入れ過ぎて\n疲れないのー？"},
        { "location": "139/TALK"  , "narrator": "繭", "text": "別に…。"},
        { "location": "140/TALK"  , "narrator": "みやび", "text": "いや、でも偉いと\n思うがよ。"},
        { "location": "141/TALK"  , "narrator": "みやび", "text": "うちも劇場のバイト\nしちょるけんど――"},
        { "location": "142/TALK"  , "narrator": "みやび", "text": "正直、シフトが\n少ない方が嬉しいと\n思うちょるきね。"},
        { "location": "144/TALK"  , "narrator": "みやび", "text": "光月さんは働き者や。\n関心関心。"},
        { "location": "147/TALK"  , "narrator": "繭", "text": "っ！？　お、お褒めに\nあずかり、光栄です！"},
        { "location": "148/TALK"  , "narrator": "みやび", "text": "大袈裟やねぇ…。"},
        { "location": "149/TALK"  , "narrator": "みやび", "text": "で？　光月さんは\n何のアルバイト\nしちょるが？"},
        { "location": "152/TALK"  , "narrator": "繭", "text": "あっ…そ、それは…。"},
        { "location": "153/TALK"  , "narrator": "雛", "text": "まゆちん、バイトの\n話はしてくれないん\nですよー。"},
        { "location": "154/TALK"  , "narrator": "みやび", "text": "そうなが？"},
        { "location": "155/TALK"  , "narrator": "雛", "text": "あたし達も、今まで\n何度も聞いてるん\nですけど――"},
        { "location": "156/TALK"  , "narrator": "雛", "text": "ヒントも\nくれないんです。"},
        { "location": "157/TALK"  , "narrator": "みやび", "text": "そうやったか…。"},
        { "location": "159/TALK"  , "narrator": "繭", "text": "いえ！　ですが\nみやび先輩が\n知りたいなら――"},
        { "location": "160/TALK"  , "narrator": "繭", "text": "あ…でも、やっぱり\n知られるのは…。"},
        { "location": "161/TALK"  , "narrator": "みやび", "text": "ああ、えいよえいよ。\n無理に聞き出す気は\nないちや。"},
        { "location": "162/TALK"  , "narrator": "みやび", "text": "誰にも、一つや二つ\n秘密はあるきね。"},
        { "location": "164/TALK"  , "narrator": "繭", "text": "あ…、\nそ、そうですか…。"},
        { "location": "166/TALK"  , "narrator": "みやび", "text": "…落ち込んどる？\n相変わらず、\nよくわからん子や。"},
        { "location": "167/TALK"  , "narrator": "みやび", "text": "…しっかし、折角の\nお祭りなんちゅう\nシチュやのに――"},
        { "location": "168/TALK"  , "narrator": "みやび", "text": "テレビやバイトを\n優先するっちゅうんは\nどうなが？"},
        { "location": "169/TALK"  , "narrator": "みやび", "text": "お年頃なんやし、\n祭りにときめかんと\nもったいないちや。"},
        { "location": "170/TALK"  , "narrator": "雛", "text": "電車はときめきの\n塊です！"},
        { "location": "172/TALK"  , "narrator": "繭", "text": "申し訳ありません。\nときめきは現在、\n品切れ中でして…。"},
        { "location": "173/TALK"  , "narrator": "みやび", "text": "…好きな男の子の\n一人もおらんが？"},
        { "location": "174/TALK"  , "narrator": "雛", "text": "おらんです。"},
        { "location": "176/TALK"  , "narrator": "繭", "text": "わ、私は…その…、\n素敵な人が、その…。"},
        { "location": "177/TALK"  , "narrator": "雛", "text": "えっ！？\n好きな男の子\nいるの！？"},
        { "location": "178/TALK"  , "narrator": "繭", "text": "お、男じゃなくて！"},
        { "location": "179/TALK"  , "narrator": "繭", "text": "あ、そ、尊敬という\n意味で、その…。"},
        { "location": "180/TALK"  , "narrator": "みやび", "text": "ほぅ…気が合うなぁ。"},
        { "location": "181/TALK"  , "narrator": "みやび", "text": "うちも、尊敬しちょる\n女の人がおるがよ。"},
        { "location": "182/TALK"  , "narrator": "みやび", "text": "やき、光月さんの\n気持ちはわかるちや。"},
        { "location": "184/TALK"  , "narrator": "繭", "text": "…………。"},
        { "location": "187/TALK"  , "narrator": "みやび", "text": "…しっかし、\nうちが言えたことや\nないけんど――"},
        { "location": "188/TALK"  , "narrator": "みやび", "text": "思春期女子としては\nかなり問題ありや\nないか？"},
        { "location": "189/TALK"  , "narrator": "みやび", "text": "…多分、恋愛関係の\n話題に関しては――"},
        { "location": "190/TALK"  , "narrator": "みやび", "text": "うちらより、\nガブちゃんの方が\n遥か先におるようや。"},
        { "location": "191/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "192/TALK"  , "narrator": "みやび", "text": "そういえば、\n昨日のガブちゃん――"},
        { "location": "193/TALK"  , "narrator": "みやび", "text": "ちくっと様子が\nおかしかったような\n気がするな。"},
        { "location": "194/TALK"  , "narrator": "みやび", "text": "いつもやったら、\nもっと激おこ状態で\n否定するやろうに――"},
        { "location": "195/TALK"  , "narrator": "みやび", "text": "何となく、元気が\nなかったような…。"},
        { "location": "197/TALK"  , "narrator": "みやび", "text": "何か、引っかかる\nようなことでも\nあったんやろか？"},
        { "location": "198/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "241/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "254/TALK"  , "narrator": "みやび", "text": "うむ。\n今日もえい挨拶やね。"},
        { "location": "257/TALK"  , "narrator": "みやび", "text": "酷い挨拶をされたちや。"},
        { "location": "260/TALK"  , "narrator": "みやび", "text": "マニアックな挨拶やね。"},
        { "location": "266/TALK"  , "narrator": "みやび", "text": "みやびさん\n４ポイントゲット。"},
        { "location": "267/SEL"   , "narrator": "", "text": "まだやってるんだ"},
        { "location": "268/ACT"   , "narrator": "", "text": "まだやってるんだ"},
        { "location": "270/TALK"  , "narrator": "みやび", "text": "当然や。\nやめるなぞ一言も\n言っちょらんが？"},
        { "location": "271/TALK"  , "narrator": "みやび", "text": "いつか、うちがやりたい\n時にお前さんにポイント\nボーナスをねだるぞね。"},
        { "location": "272/TALK"  , "narrator": "みやび", "text": "それこそが\n今の生きがいやき。"},
        { "location": "273/SEL"   , "narrator": "", "text": "それが生きがいなんて…"},
        { "location": "274/ACT"   , "narrator": "", "text": "それが生きがいなんて…"},
        { "location": "277/TALK"  , "narrator": "みやび", "text": "まあ、ココロの司書なんて\nそんな事くらいしか\n娯楽がないんよ。"},
        { "location": "278/TALK"  , "narrator": "みやび", "text": "ほんだら今日も元気に\n仕事しますかー。"},
        { "location": "285/TALK"  , "narrator": "みやび", "text": "オープンプロセス、\n0x773番地から\n0x102番地へ。"},
        { "location": "300/TALK"  , "narrator": "みやび", "text": "完了。"},
        { "location": "302/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "304/TALK"  , "narrator": "みやび", "text": "………。"},
        { "location": "306/TALK"  , "narrator": "みやび", "text": "なるほどなぁ。\n今回は複雑やね。"},
        { "location": "307/SEL"   , "narrator": "", "text": "どんな内容？"},
        { "location": "308/ACT"   , "narrator": "", "text": "どんな内容？"},
        { "location": "310/TALK"  , "narrator": "みやび", "text": "結論から言えば、\n繭と雛に対してどこまで\n心を開くか悩んじゅう。"},
        { "location": "311/SEL"   , "narrator": "", "text": "あれ？ガブリエラの事じゃないんだ"},
        { "location": "312/ACT"   , "narrator": "", "text": "あれ？ガブリエラの事じゃないんだ"},
        { "location": "314/TALK"  , "narrator": "みやび", "text": "まあ、そこが今回の\n引っ掛け問題よ。"},
        { "location": "315/TALK"  , "narrator": "みやび", "text": "どれくらいの難易度かと\nゆうと、現実のうちも多分\n最後まで気づかんくらい。"},
        { "location": "316/SEL"   , "narrator": "", "text": "そこまで！"},
        { "location": "317/ACT"   , "narrator": "", "text": "そこまで！"},
        { "location": "319/TALK"  , "narrator": "みやび", "text": "今から順を追って\n説明しちゃろう。"},
        { "location": "320/TALK"  , "narrator": "みやび", "text": "１．ガブちゃんに違和感を\n感じているが、その理由が\nわからない。"},
        { "location": "321/TALK"  , "narrator": "みやび", "text": "２．そもそも自分が人に\n壁を作ってるから解らない\nと一人反省する。"},
        { "location": "322/TALK"  , "narrator": "みやび", "text": "３．なら他人なら解るかも\nと思うが、目の前にいる\n二人じゃな、と諦める。"},
        { "location": "323/TALK"  , "narrator": "みやび", "text": "４．だがその諦めこそが\n自身の奢りと観念の賜物\nだと思わなくもない。"},
        { "location": "324/TALK"  , "narrator": "みやび", "text": "５．とはいえ今回の件は\nコイバナとも取れる故に\nキャラに反する。"},
        { "location": "325/TALK"  , "narrator": "みやび", "text": "６．だが有機物の思考回路\nにおける例外を突き止める\nのは、うちは苦手である。"},
        { "location": "326/TALK"  , "narrator": "みやび", "text": "７．そもそも苦手やから\n他人のCPUを使わせて\nもらうわけやけんど……"},
        { "location": "327/TALK"  , "narrator": "みやび", "text": "８．それは自身のファイア\nウォールに穴を開ける\nことになるわけやき……"},
        { "location": "328/TALK"  , "narrator": "みやび", "text": "９．そこまで信用して\nいいものなのか、及び\nそれに値する問題なのか。"},
        { "location": "329/TALK"  , "narrator": "みやび", "text": "１０．いや、それこそが\nうちのブレイクスルーを\n妨げる要因である。"},
        { "location": "330/TALK"  , "narrator": "みやび", "text": "１１．分散コンピュー\nティングの時代に逆行する\n自分らしくない発想。"},
        { "location": "331/TALK"  , "narrator": "みやび", "text": "１２．しかし目の前の\n２つのCPUは本当に信頼に\n値する――（永久ループ）"},
        { "location": "332/TALK"  , "narrator": "みやび", "text": "１３．うちのココロに\n例外が発生し、お前さんが\nここに飛ばされる。"},
        { "location": "334/TALK"  , "narrator": "みやび", "text": "――ちゅうことを、\n最後の「…………。」の\n間に思うちょったわけや。"},
        { "location": "335/SEL"   , "narrator": "", "text": "あの「…………。」がそこまで深いものだったなんて！"},
        { "location": "336/SEL"   , "narrator": "", "text": "天才脳故の複雑な思考回路だね"},
        { "location": "337/ACT"   , "narrator": "", "text": "あの「…………。」がそこまで深いものだったなんて！"},
        { "location": "338/TALK"  , "narrator": "みやび", "text": "まあ、特別なことやない。"},
        { "location": "339/TALK"  , "narrator": "みやび", "text": "だれやって、\n考えるときは一瞬やき。"},
        { "location": "340/TALK"  , "narrator": "みやび", "text": "それを言葉にしたり\nする事が、面倒かつ\n時間がかかるだけぞね。"},
        { "location": "341/TALK"  , "narrator": "みやび", "text": "脳信号を言語として\nまとめる自己翻訳こそが、\n脳で最も高負荷の処理や。"},
        { "location": "342/ACT"   , "narrator": "", "text": "天才脳故の複雑な思考回路だね"},
        { "location": "343/TALK"  , "narrator": "みやび", "text": "うちをおちょくるのも\n大概にしいや。"},
        { "location": "344/SEL"   , "narrator": "", "text": "本当に天才だと思う"},
        { "location": "345/ACT"   , "narrator": "", "text": "本当に天才だと思う"},
        { "location": "348/TALK"  , "narrator": "みやび", "text": "単に偏屈なだけやよ。"},
        { "location": "349/TALK"  , "narrator": "みやび", "text": "まあでも、他人にそう\n言われて嬉しくないか、\nちゅうたら――"},
        { "location": "351/TALK"  , "narrator": "みやび", "text": "ちくっとは、\n嬉しいけんどな。"},
        { "location": "352/TALK"  , "narrator": "みやび", "text": "やき、ダメなんよ！"},
        { "location": "354/TALK"  , "narrator": "みやび", "text": "以後それ禁止な。"},
        { "location": "356/TALK"  , "narrator": "みやび", "text": "ちなみに、顕在意識たる\n現実のうちは、２までしか\nわかっちょらん。"},
        { "location": "357/TALK"  , "narrator": "みやび", "text": "けんど、クランが湧いてる\nちゅうことは、相談するか\n否かで悩んでるのは事実。"},
        { "location": "359/TALK"  , "narrator": "みやび", "text": "「他人に相談する」ちゅう\n一般人には簡単なことが、\nうちには世紀の大問題や。"},
        { "location": "360/TALK"  , "narrator": "みやび", "text": "やき、このクランを撃退\nすると、現実のうちも\nビックリするやもしれん。"},
        { "location": "361/TALK"  , "narrator": "みやび", "text": "自分の行動にな。"},
        { "location": "362/TALK"  , "narrator": "みやび", "text": "けんど、うちはそろそろ\n変わらんといかんちや。"},
        { "location": "363/TALK"  , "narrator": "みやび", "text": "そうせんと、\n全てが膠着状態に\nなり始めちゅう。"},
        { "location": "364/TALK"  , "narrator": "みやび", "text": "これは、うちの今後に\nとって、重要なことや。\n協力せい。"},
        { "location": "365/SEL"   , "narrator": "", "text": "本当に？\n精神操作じゃなくて？"},
        { "location": "366/ACT"   , "narrator": "", "text": "本当に？\n精神操作じゃなくて？"},
        { "location": "367/TALK"  , "narrator": "みやび", "text": "まあ、そう思うのも\n無理はないか。"},
        { "location": "368/TALK"  , "narrator": "みやび", "text": "お前さんも今はココロの\n中にいるけんど、現実を\n生きる存在やきね。"},
        { "location": "369/TALK"  , "narrator": "みやび", "text": "目に見えているものだけが\n本当のことだとゆう観念が\nどうしてもこびりつく。"},
        { "location": "370/TALK"  , "narrator": "みやび", "text": "うちがお前さんに頼んでる\nのは、背中を一押しして\nもらうことだけや。"},
        { "location": "371/TALK"  , "narrator": "みやび", "text": "別に、精神操作をして、\nココロにも無いことを\nさせようってわけやない。"},
        { "location": "372/TALK"  , "narrator": "みやび", "text": "あくまで、\n源はうちの想いや。"},
        { "location": "373/TALK"  , "narrator": "みやび", "text": "そこに一言支えるのが\nお前さんの役割。"},
        { "location": "374/TALK"  , "narrator": "みやび", "text": "現実でも普通にやっちょる\nと思うけんど、ココロの中\nやと警戒するんやろな。"},
        { "location": "375/TALK"  , "narrator": "みやび", "text": "もしどうしても\n気が進まんゆうなら、\n無理にやらんでもえいよ？"},
        { "location": "376/TALK"  , "narrator": "みやび", "text": "うちから言えることは\nこれだけやね。"},
        { "location": "379/TALK"  , "narrator": "みやび", "text": "ほんだら早速行くぞね。"},
        { "location": "380/TALK"  , "narrator": "みやび", "text": "うちと$handle$に\nえいココロの旅を。"},
        { "location": "23/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>6月6日　7:11 AM</color>\n平日の朝、通学中の有楽町線車内にて。"},
        { "location": "210/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
