        { "location": "405/SCENARIO", "narrator": "", "text": "2016年のエチュード"},
        { "location": "435/TALK"    , "narrator": "神楽", "text": "$handle$さんに付き合って欲しいことがあるぴょん"},
        { "location": "437/SEL"     , "narrator": "", "text": "恋人同士になろう！"},
        { "location": "438/SEL"     , "narrator": "", "text": "何かなー"},
        { "location": "439/SEL"     , "narrator": "", "text": "だが断る"},
        { "location": "440/ACT"     , "narrator": "", "text": "恋人同士になろう！"},
        { "location": "441/TALK"    , "narrator": "神楽", "text": "いやそれは"},
        { "location": "443/TALK"    , "narrator": "神楽", "text": "まだ早いと思うんです♪"},
        { "location": "444/ACT"     , "narrator": "", "text": "何かなー"},
        { "location": "445/TALK"    , "narrator": "神楽", "text": "超期待して！"},
        { "location": "446/TALK"    , "narrator": "神楽", "text": "でいいのかなー？？？"},
        { "location": "447/ACT"     , "narrator": "", "text": "だが断る"},
        { "location": "448/TALK"    , "narrator": "神楽", "text": "なんだそれ"},
        { "location": "449/TALK"    , "narrator": "神楽", "text": "ありえなし！！！！"},
        { "location": "451/TALK"    , "narrator": "神楽", "text": "ぴょんこは未来人だから2016年をよく知らないぴょん"},
        { "location": "452/TALK"    , "narrator": "神楽", "text": "2016年っぽい言い回しとか教えて欲しいんですっ★"},
        { "location": "455/SEL"     , "narrator": "", "text": "得意分野ｷﾀ―――(ﾟ∀ﾟ)―――― !!"},
        { "location": "456/SEL"     , "narrator": "", "text": "神楽は神楽のままが一番いいよ"},
        { "location": "457/SEL"     , "narrator": "", "text": "神ってる"},
        { "location": "458/ACT"     , "narrator": "", "text": "得意分野ｷﾀ―――(ﾟ∀ﾟ)―――― !!"},
        { "location": "460/TALK"    , "narrator": "神楽", "text": "ってちょっと古くないですか？"},
        { "location": "461/TALK"    , "narrator": "神楽", "text": "本当にありなんですかっ？"},
        { "location": "462/ACT"     , "narrator": "", "text": "神楽は神楽のままが一番いいよ"},
        { "location": "463/TALK"    , "narrator": "神楽", "text": "おっおっ？"},
        { "location": "464/TALK"    , "narrator": "神楽", "text": "これはいわゆるひとつの口説き文句ですね$handle$さんってば♪"},
        { "location": "465/TALK"    , "narrator": "神楽", "text": "照れちゃいます♪"},
        { "location": "466/ACT"     , "narrator": "", "text": "神ってる"},
        { "location": "467/TALK"    , "narrator": "神楽", "text": "神ってる？"},
        { "location": "468/TALK"    , "narrator": "神楽", "text": "なんて言い方があるんですね？"},
        { "location": "469/TALK"    , "narrator": "神楽", "text": "神降臨とかそういうやつの一種なんでしょうか？"},
        { "location": "471/TALK"    , "narrator": "神楽", "text": "ぴょんこはですね"},
        { "location": "472/TALK"    , "narrator": "神楽", "text": "アーティストだからやっぱりこういうところも手を抜きたくないんですっ♪"},
        { "location": "473/TALK"    , "narrator": "神楽", "text": "日常生活は適度に力を抜けってマネージャーにも言われちゃうんですけど、ね★"},
        { "location": "476/SEL"     , "narrator": "", "text": "$me$との会話でリラックスしてよ"},
        { "location": "477/SEL"     , "narrator": "", "text": "神楽は完璧主義だよね"},
        { "location": "478/SEL"     , "narrator": "", "text": "心配してくれてるんだよ"},
        { "location": "479/ACT"     , "narrator": "", "text": "$me$との会話でリラックスしてよ"},
        { "location": "480/TALK"    , "narrator": "神楽", "text": "うんそうですね♪"},
        { "location": "481/TALK"    , "narrator": "神楽", "text": "そういう側面もありますぴょん"},
        { "location": "482/ACT"     , "narrator": "", "text": "神楽は完璧主義だよね"},
        { "location": "483/TALK"    , "narrator": "神楽", "text": "まあそうなんですけどねっ"},
        { "location": "484/TALK"    , "narrator": "神楽", "text": "それって悪いわけじゃないとおもうんですよ？"},
        { "location": "485/ACT"     , "narrator": "", "text": "心配してくれてるんだよ"},
        { "location": "486/TALK"    , "narrator": "神楽", "text": "それはわかってるんですけどね？"},
        { "location": "487/TALK"    , "narrator": "神楽", "text": "リミッター外したくなっちゃうんですっ★"},
        { "location": "489/TALK"    , "narrator": "神楽", "text": "あとはですね～～"},
        { "location": "490/TALK"    , "narrator": "神楽", "text": "違う自分を演じる快感っていう感じでしょうか？"},
        { "location": "491/TALK"    , "narrator": "神楽", "text": "うまくハマるとぞくぞくしちゃうぴょん"},
        { "location": "493/SEL"     , "narrator": "", "text": "官能的表現"},
        { "location": "494/SEL"     , "narrator": "", "text": "わかる気がする"},
        { "location": "495/SEL"     , "narrator": "", "text": "$me$には本音で話してよ"},
        { "location": "496/ACT"     , "narrator": "", "text": "官能的表現"},
        { "location": "497/TALK"    , "narrator": "神楽", "text": "エロいの湾曲表現ですね？"},
        { "location": "498/TALK"    , "narrator": "神楽", "text": "あ、違いますね、婉曲的表現です♪"},
        { "location": "499/ACT"     , "narrator": "", "text": "わかる気がする"},
        { "location": "500/TALK"    , "narrator": "神楽", "text": "ですよね～～～～"},
        { "location": "502/TALK"    , "narrator": "神楽", "text": "そこがたまらないんですっ♪"},
        { "location": "503/ACT"     , "narrator": "", "text": "$me$には本音で話してよ"},
        { "location": "505/TALK"    , "narrator": "神楽", "text": "そういうのも大事ですよねっ♪"},
        { "location": "507/TALK"    , "narrator": "神楽", "text": "ネットスラングって元ネタなんかもうどうでもよくなって言葉だけ残ってたりしますよね"},
        { "location": "508/TALK"    , "narrator": "神楽", "text": "それはそれでそういうもんだと思っていますけど、、、"},
        { "location": "509/TALK"    , "narrator": "神楽", "text": "ええと、、、ぴょんこのぴょんってありだと思いますか？"},
        { "location": "511/SEL"     , "narrator": "", "text": "今さらすぎない？"},
        { "location": "512/SEL"     , "narrator": "", "text": "正直ちょっとなー…"},
        { "location": "513/SEL"     , "narrator": "", "text": "超アリ！！！"},
        { "location": "514/ACT"     , "narrator": "", "text": "今さらすぎない？"},
        { "location": "515/TALK"    , "narrator": "神楽", "text": "そうなんですけどね、、、"},
        { "location": "516/TALK"    , "narrator": "神楽", "text": "もちろんぴょんこはぴょんが気に入ってるぴょん"},
        { "location": "517/ACT"     , "narrator": "", "text": "正直ちょっとなー…"},
        { "location": "518/TALK"    , "narrator": "神楽", "text": "あれあれあれあれ？？？"},
        { "location": "519/TALK"    , "narrator": "神楽", "text": "そうだったんですね、、、ｼｮﾎﾞｰﾝ、、、"},
        { "location": "520/ACT"     , "narrator": "", "text": "超アリ！！！"},
        { "location": "521/TALK"    , "narrator": "神楽", "text": "ですよねですよねですよね～～～～～！！！"},
        { "location": "522/TALK"    , "narrator": "神楽", "text": "$handle$さんさすがですーーーーー！"},
        { "location": "524/TALK"    , "narrator": "神楽", "text": "ぴょんこのぴょんこな顔は$handle$さんにだけ限定ぴょん"},
        { "location": "525/TALK"    , "narrator": "神楽", "text": "本当ですからね★"},
        { "location": "526/TALK"    , "narrator": "神楽", "text": "声で証明します～～～～～～！！！！！"},
        { "location": "529/TALK"    , "narrator": "ボイスメール", "text": "こういうのはいかがですかぴょん？"},
