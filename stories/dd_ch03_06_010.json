{
    "dir": "chap06/daydra/dd_ch03_06_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "6352",
        "cid": "gabriella",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "告白"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "告白"},
        { "location": "24/TALK"   , "narrator": "ガブリエラ", "text": "さてと、\nお昼休みもそろそろ\nお終いだし――"},
        { "location": "25/TALK"   , "narrator": "ガブリエラ", "text": "教室に帰って\n準備しなくちゃだわ。"},
        { "location": "29/TALK"   , "narrator": "男子高校生Ａ", "text": "あの、\nちょっといいかな？"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "っ！？"},
        { "location": "33/TALK"   , "narrator": "男子高校生Ａ", "text": "君さ、中等部の\nガブリエラだよね？"},
        { "location": "34/TALK"   , "narrator": "ガブリエラ", "text": "えっ！？\n何、こいつ？\nっていうか誰なの！？"},
        { "location": "35/TALK"   , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "37/TALK"   , "narrator": "男子高校生Ａ", "text": "えっと…\n警戒されてる？"},
        { "location": "38/SEL"    , "narrator": "", "text": "電話で話すフリをして"},
        { "location": "40/TALK"   , "narrator": "男子高校生Ａ", "text": "ごめんね、\n急に声掛けて。"},
        { "location": "41/TALK"   , "narrator": "男子高校生Ａ", "text": "ただ、ちょっと\n二人きりで話したい\nことがあって…。"},
        { "location": "42/TALK"   , "narrator": "男子高校生Ａ", "text": "今って時間あるかな？"},
        { "location": "46/TALK"   , "narrator": "ガブリエラ", "text": "ど、どうしよう、断ら\nないと。知らない人と\n二人きりなんて嫌よ！"},
        { "location": "47/TALK"   , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "48/TALK"   , "narrator": "ガブリエラ", "text": "ああもうっ！\nどうしていつも声が\n出なくなっちゃうの！"},
        { "location": "49/TALK"   , "narrator": "男子高校生Ａ", "text": "…逃げないってことは、\nＯＫってことかな？"},
        { "location": "50/TALK"   , "narrator": "男子高校生Ａ", "text": "とりあえず、\n場所移そう。\n俺に付いてきて。"},
        { "location": "52/TALK"   , "narrator": "ガブリエラ", "text": "どうしよう…。\n誰か、助けて…。"},
        { "location": "67/TALK"   , "narrator": "男子高校生Ａ", "text": "ありがとう。\n急に無理な\nお願い聞いてくれて。"},
        { "location": "69/TALK"   , "narrator": "ガブリエラ", "text": "聞いたんじゃない！\n断れなかった\nだけなのに！"},
        { "location": "70/TALK"   , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "71/TALK"   , "narrator": "男子高校生Ａ", "text": "あっ、警戒しないで。\n本当少し話があるだけ\nなんだよ。"},
        { "location": "72/TALK"   , "narrator": "男子高校生Ａ", "text": "実はさ…その――"},
        { "location": "73/TALK"   , "narrator": "男子高校生Ａ", "text": "ガブリエラって、\n今、お付き合いしてる\n人いない…よね？"},
        { "location": "74/TALK"   , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "75/TALK"   , "narrator": "男子高校生Ａ", "text": "気になってる人とかも\nもしいないなら――"},
        { "location": "76/TALK"   , "narrator": "男子高校生Ａ", "text": "良ければ…\n俺と付き合って\nほしいんだ。"},
        { "location": "78/TALK"   , "narrator": "ガブリエラ", "text": "…えっ！？"},
        { "location": "79/TALK"   , "narrator": "男子高校生Ａ", "text": "…俺さ、\nずっと君のことが\n好きだったんだ。"},
        { "location": "80/TALK"   , "narrator": "男子高校生Ａ", "text": "正確には、数ヶ月前に\n校庭で見かけてから\nなんだけど――"},
        { "location": "81/TALK"   , "narrator": "男子高校生Ａ", "text": "一目惚れなんだ。"},
        { "location": "82/SEL"    , "narrator": "", "text": "端末操作：着信音"},
        { "location": "83/SEL"    , "narrator": "", "text": "端末操作：アーヤ呼び出し"},
        { "location": "84/SEL"    , "narrator": "", "text": "代わりに応えるよ"},
        { "location": "87/TALK"   , "narrator": "ガブリエラ", "text": "うそっ！？\nあたし、本当に告白され\nちゃってるの！？"},
        { "location": "88/TALK"   , "narrator": "ガブリエラ", "text": "それも年上の\n男の子に…。"},
        { "location": "90/TALK"   , "narrator": "ガブリエラ", "text": "…でも、よく知らない\nどころか初めて見る人\nとは付き合えないし…。"},
        { "location": "91/TALK"   , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "94/TALK"   , "narrator": "男子高校生Ａ", "text": "別に、今って相手は\nいないんだろ？"},
        { "location": "95/TALK"   , "narrator": "男子高校生Ａ", "text": "俺、ずっと君のことを\n見てたから知ってる\nけど――"},
        { "location": "96/TALK"   , "narrator": "男子高校生Ａ", "text": "フリーだよね？"},
        { "location": "100/TALK"  , "narrator": "ガブリエラ", "text": "…見てた？\n今、この人見てたって\n言った？"},
        { "location": "101/TALK"  , "narrator": "男子高校生Ａ", "text": "お昼ご飯も、帰る時も、\nいつも女の子とばかり\nいたの、見てるから。"},
        { "location": "102/TALK"  , "narrator": "男子高校生Ａ", "text": "寮にもまっすぐ帰って、\n寄り道も男の二人きりで\nすることはないし…。"},
        { "location": "103/TALK"  , "narrator": "ガブリエラ", "text": "っ！？"},
        { "location": "105/TALK"  , "narrator": "ガブリエラ", "text": "やだ、何この人！？\n怖い！"},
        { "location": "106/TALK"  , "narrator": "ガブリエラ", "text": "ていうか、\nあたしのこと\n寮までつけてたの！？"},
        { "location": "107/TALK"  , "narrator": "男子高校生Ａ", "text": "…そろそろさ、\nいい加減返事が\n欲しいんだけど？"},
        { "location": "108/TALK"  , "narrator": "ガブリエラ", "text": "返事って…この人、\n本気で言ってるの？"},
        { "location": "109/TALK"  , "narrator": "ガブリエラ", "text": "絶対に嫌よ。\n嫌だって…一言、\n嫌って言えれば…。"},
        { "location": "110/TALK"  , "narrator": "ガブリエラ", "text": "っ！　…っ！"},
        { "location": "111/TALK"  , "narrator": "男子高校生Ａ", "text": "…どうしたの？\nもしかして、\n具合でも悪いとか？"},
        { "location": "114/TALK"  , "narrator": "男子高校生Ａ", "text": "保健室に行く？\nほら、手を貸して。"},
        { "location": "116/TALK"  , "narrator": "ガブリエラ", "text": "っ！？"},
        { "location": "118/TALK"  , "narrator": "ガブリエラ", "text": "っ！！"},
        { "location": "127/TALK"  , "narrator": "男子高校生Ａ", "text": "あっ、待って！"},
        { "location": "128/TALK"  , "narrator": "男子高校生Ａ", "text": "…まだ、返事もらって\nないんだけど…。"},
        { "location": "130/ACT"   , "narrator": "", "text": "端末操作：着信音"},
        { "location": "158/TALK"  , "narrator": "ガブリエラ", "text": "ナイスよマルザンナ！\n話すフリをして\n部屋から出ていけば…。"},
        { "location": "159/TALK"  , "narrator": "男子高校生Ａ", "text": "電話、切ってくれる？\n真面目な話だからさ。"},
        { "location": "162/TALK"  , "narrator": "ガブリエラ", "text": "っ！？"},
        { "location": "163/TALK"  , "narrator": "ガブリエラ", "text": "…この人、怖い。\n言う通りにしておいた\n方が良いかも…。"},
        { "location": "164/TALK"  , "narrator": "男子高校生Ａ", "text": "別に、今って相手は\nいないんだろ？"},
        { "location": "165/TALK"  , "narrator": "男子高校生Ａ", "text": "俺、ずっと君のことを\n見てたから知ってる\nけど――"},
        { "location": "167/TALK"  , "narrator": "男子高校生Ａ", "text": "フリーだよね？"},
        { "location": "170/TALK"  , "narrator": "ガブリエラ", "text": "…見てた？\n今、この人見てたって\n言った？"},
        { "location": "171/TALK"  , "narrator": "男子高校生Ａ", "text": "お昼ご飯も、帰る時も、\nいつも女の子とばかり\nいたの、見てるから。"},
        { "location": "172/TALK"  , "narrator": "男子高校生Ａ", "text": "寮にもまっすぐ帰って、\n寄り道も男との二人きり\nですることはないし…。"},
        { "location": "175/TALK"  , "narrator": "ガブリエラ", "text": "っ！？"},
        { "location": "176/TALK"  , "narrator": "ガブリエラ", "text": "やだ、何この人！？\n怖い！"},
        { "location": "179/TALK"  , "narrator": "ガブリエラ", "text": "ていうか、\nあたしのこと\n寮までつけてたの！？"},
        { "location": "180/TALK"  , "narrator": "男子高校生Ａ", "text": "…そろそろさ、\nいい加減に返事が\n欲しいんだけど？"},
        { "location": "183/TALK"  , "narrator": "ガブリエラ", "text": "返事って…この人、\n本気で言ってるの？"},
        { "location": "185/TALK"  , "narrator": "ガブリエラ", "text": "絶対に嫌よ。\n嫌だって…一言、\n嫌って言えれば…。"},
        { "location": "186/TALK"  , "narrator": "ガブリエラ", "text": "っ！　…っ！"},
        { "location": "187/TALK"  , "narrator": "男子高校生Ａ", "text": "…どうしたの？\nもしかして、具合でも\n悪いとか？"},
        { "location": "189/TALK"  , "narrator": "男子高校生Ａ", "text": "保健室に行く？\nほら、手を貸して。"},
        { "location": "191/TALK"  , "narrator": "ガブリエラ", "text": "っ！？"},
        { "location": "193/TALK"  , "narrator": "ガブリエラ", "text": "っ！！"},
        { "location": "202/TALK"  , "narrator": "男子高校生Ａ", "text": "あっ、待って！"},
        { "location": "203/TALK"  , "narrator": "男子高校生Ａ", "text": "…まだ、返事もらって\nないんだけど…。"},
        { "location": "205/ACT"   , "narrator": "", "text": "端末操作：アーヤ呼び出し"},
        { "location": "208/TALK"  , "narrator": "ガブリエラ", "text": "ありがと、マルザンナ。"},
        { "location": "209/TALK"  , "narrator": "ガブリエラ", "text": "アーヤ、早く来て！"},
        { "location": "210/TALK"  , "narrator": "男子高校生Ａ", "text": "…そんなに怖いかな？"},
        { "location": "212/TALK"  , "narrator": "ガブリエラ", "text": "っ？"},
        { "location": "213/TALK"  , "narrator": "男子高校生Ａ", "text": "いや…まあそうだよね？\nいきなり話しかけられた\nだけじゃなくて――"},
        { "location": "214/TALK"  , "narrator": "男子高校生Ａ", "text": "こんなところに\n連れ込んでるんだし…。"},
        { "location": "215/TALK"  , "narrator": "男子高校生Ａ", "text": "けど…さすがに廊下じゃ、\n告白する勇気がなくてさ。"},
        { "location": "216/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "217/TALK"  , "narrator": "ガブリエラ", "text": "…悪い人じゃない、\nのかな？"},
        { "location": "218/TALK"  , "narrator": "ガブリエラ", "text": "強引に変なこととかして\nくるわけでもないし…。"},
        { "location": "220/TALK"  , "narrator": "ガブリエラ", "text": "でも…。"},
        { "location": "222/TALK"  , "narrator": "男子高校生Ａ", "text": "…そろそろ、\n一言くらい何か言って\nほしいんだけど？"},
        { "location": "223/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "224/TALK"  , "narrator": "男子高校生Ａ", "text": "…いや、好きか嫌いか\nだけでもいいからさ、\n頼むよ。"},
        { "location": "225/TALK"  , "narrator": "男子高校生Ａ", "text": "じゃなきゃ、\n俺の立場も\nないっていうかさ…。"},
        { "location": "226/TALK"  , "narrator": "男子高校生Ａ", "text": "何も言わないなら、\nＯＫ、ってことだと\n思うけど、いいの？"},
        { "location": "229/TALK"  , "narrator": "ガブリエラ", "text": "っ！？"},
        { "location": "230/TALK"  , "narrator": "ガブリエラ", "text": "ヤダ、そんなのズルい！"},
        { "location": "231/TALK"  , "narrator": "ガブリエラ", "text": "知らない男の人と\n付き合うとか、\n普通にありえないし！"},
        { "location": "232/TALK"  , "narrator": "男子高校生Ａ", "text": "…本当にいいの？\n俺、ＯＫもらったと\n思っちゃうよ？"},
        { "location": "233/TALK"  , "narrator": "ガブリエラ", "text": "もうイヤ…。\nお願い、誰か助けて！"},
        { "location": "239/TALK"  , "narrator": "アーヤ", "text": "ギャヴィ、いるの？"},
        { "location": "241/TALK"  , "narrator": "ガブリエラ", "text": "っ！？　アーヤ！！"},
        { "location": "242/TALK"  , "narrator": "男子高校生Ａ", "text": "うわっ！？\nえっ、どうしてここに…。"},
        { "location": "244/TALK"  , "narrator": "アーヤ", "text": "…え？　男の子も一緒？\n誰か知らないけど…。"},
        { "location": "246/TALK"  , "narrator": "アーヤ", "text": "…あっ、もしかして！"},
        { "location": "248/TALK"  , "narrator": "アーヤ", "text": "えっと…\nお邪魔だったかしら？"},
        { "location": "249/TALK"  , "narrator": "男子高校生Ａ", "text": "い、いえ、大丈夫です！"},
        { "location": "250/TALK"  , "narrator": "男子高校生Ａ", "text": "っていうか、俺用事が\nあるから…それじゃ！！"},
        { "location": "259/TALK"  , "narrator": "アーヤ", "text": "…ほら、もう大丈夫よ。"},
        { "location": "261/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "263/TALK"  , "narrator": "アーヤ", "text": "ふふっ…告白されたの？\nギャヴィも隅に置けない\nわね。"},
        { "location": "267/TALK"  , "narrator": "ガブリエラ", "text": "うっ…。"},
        { "location": "268/TALK"  , "narrator": "ガブリエラ", "text": "ぐすっ、ううっ…。"},
        { "location": "269/TALK"  , "narrator": "アーヤ", "text": "…そんなに怖かったの？\nでももう大丈夫だから。"},
        { "location": "271/TALK"  , "narrator": "ガブリエラ", "text": "うぅっ…もぉっ！\n全然大丈夫じゃ\nないわよ！"},
        { "location": "272/TALK"  , "narrator": "ガブリエラ", "text": "もっと早く来て\nくれてもいいのに、\nばかー！！"},
        { "location": "273/TALK"  , "narrator": "アーヤ", "text": "あのね…これでも\n十分急いで――"},
        { "location": "275/TALK"  , "narrator": "ガブリエラ", "text": "ひっ、うぅっ…\nぐすっ…。"},
        { "location": "276/TALK"  , "narrator": "アーヤ", "text": "…ごめんね。\n早く来て\nあげられなくて。"},
        { "location": "277/TALK"  , "narrator": "アーヤ", "text": "落ち着くまで\n一緒にいるから、\n泣き止んで？"},
        { "location": "278/TALK"  , "narrator": "ガブリエラ", "text": "…………うん。\nあの…。"},
        { "location": "279/TALK"  , "narrator": "アーヤ", "text": "なに？"},
        { "location": "281/TALK"  , "narrator": "ガブリエラ", "text": "…何でもない。"},
        { "location": "283/TALK"  , "narrator": "ガブリエラ", "text": "…ありがと、アーヤ。"},
        { "location": "285/ACT"   , "narrator": "", "text": "代わりに応えるよ"},
        { "location": "290/TALK"  , "narrator": "ガブリエラ", "text": "えっ…やだ！！"},
        { "location": "304/TALK"  , "narrator": "ガブリエラ", "text": "お願い、マルザンナ！"},
        { "location": "306/SEL"   , "narrator": "", "text": "恋人いるからごめんなさい"},
        { "location": "307/SEL"   , "narrator": "", "text": "急だし強引過ぎ、嫌だ"},
        { "location": "308/ACT"   , "narrator": "", "text": "恋人いるからごめんなさい"},
        { "location": "319/TALK"  , "narrator": "男子高校生Ａ", "text": "ん？　なに、それ？"},
        { "location": "320/TALK"  , "narrator": "男子高校生Ａ", "text": "えっと…えっ！？"},
        { "location": "321/TALK"  , "narrator": "男子高校生Ａ", "text": "恋人がいるって…\nウソだろ！？"},
        { "location": "322/TALK"  , "narrator": "男子高校生Ａ", "text": "だって俺、見てたし！\n付き合ってるような\n男なんていないじゃん！"},
        { "location": "323/TALK"  , "narrator": "ガブリエラ", "text": "えっ？\nど、どうしたの？\n急に興奮しだして…。"},
        { "location": "324/TALK"  , "narrator": "男子高校生Ａ", "text": "…そいつ、誰？\nガブリエラの恋人って、\nどこの誰なの？"},
        { "location": "326/TALK"  , "narrator": "ガブリエラ", "text": "っ！？"},
        { "location": "327/TALK"  , "narrator": "男子高校生Ａ", "text": "同級生じゃないよね？\nだって、ガブリエラは\n友達いないもんね？"},
        { "location": "328/TALK"  , "narrator": "ガブリエラ", "text": "や、やだ…\nこの人、ちょっと変！"},
        { "location": "329/TALK"  , "narrator": "男子高校生Ａ", "text": "あっ、年上かな？\nそれなら俺にもチャンス\nはまだあるんじゃ…。"},
        { "location": "331/TALK"  , "narrator": "男子高校生Ａ", "text": "ね？　そいつと別れて\n俺と付き合おうよ、\nね！？"},
        { "location": "332/TALK"  , "narrator": "ガブリエラ", "text": "っ！？"},
        { "location": "338/TALK"  , "narrator": "男子高校生Ａ", "text": "あっ、待って！！"},
        { "location": "339/TALK"  , "narrator": "男子高校生Ａ", "text": "…もうちょっとだった\nのになぁ。"},
        { "location": "349/TALK"  , "narrator": "ガブリエラ", "text": "はぁ…はぁ…。"},
        { "location": "352/TALK"  , "narrator": "ガブリエラ", "text": "うっ、\nぐすっ…ううっ…。"},
        { "location": "353/TALK"  , "narrator": "ガブリエラ", "text": "怖かった…\n凄く怖かったよぉ…。"},
        { "location": "355/ACT"   , "narrator": "", "text": "急だし強引過ぎ、嫌だ"},
        { "location": "366/TALK"  , "narrator": "男子高校生Ａ", "text": "ん？　なに、それ？"},
        { "location": "367/TALK"  , "narrator": "男子高校生Ａ", "text": "えっと…えっ！？"},
        { "location": "368/TALK"  , "narrator": "男子高校生Ａ", "text": "あ～…いや、まあその…\n確かにそうだよね…。"},
        { "location": "370/TALK"  , "narrator": "男子高校生Ａ", "text": "いきなり初対面なのに\n空き教室に連れ込んで、\n告白なんて…。"},
        { "location": "372/TALK"  , "narrator": "ガブリエラ", "text": "？　動揺してる？\nマルザンナったら、\n何を言ったのかしら？"},
        { "location": "374/TALK"  , "narrator": "男子高校生Ａ", "text": "いや、でもね！\n俺も自分の気持ちを\n伝えたくて…。"},
        { "location": "375/TALK"  , "narrator": "男子高校生Ａ", "text": "…でも、嫌な気持ちに\nさせちゃったなら\n意味がないし…。"},
        { "location": "376/TALK"  , "narrator": "男子高校生Ａ", "text": "…あれ？\n俺、どこで何を\n間違ったんだ？"},
        { "location": "378/TALK"  , "narrator": "ガブリエラ", "text": "チャンスかも。\n今なら逃げられる！"},
        { "location": "380/TALK"  , "narrator": "ガブリエラ", "text": "っ！！"},
        { "location": "384/TALK"  , "narrator": "男子高校生Ａ", "text": "あっ、待って！！"},
        { "location": "396/TALK"  , "narrator": "ガブリエラ", "text": "はぁ、はぁ…。"},
        { "location": "398/TALK"  , "narrator": "ガブリエラ", "text": "お、追ってこない\nみたい。\nよかったぁ…。"},
        { "location": "399/TALK"  , "narrator": "ガブリエラ", "text": "でも、今日は怖いから、\nずっと教室にいよう…。"},
        { "location": "403/ACT"   , "narrator": "", "text": "電話で話すフリをして"},
        { "location": "421/TALK"  , "narrator": "ガブリエラ", "text": "わかったわ、マルザンナ"},
        { "location": "429/TALK"  , "narrator": "ガブリエラ", "text": "もしもし…ううん、\n平気。今、そっちに\n行くから。"},
        { "location": "430/TALK"  , "narrator": "男子高校生Ａ", "text": "あっ…。"},
        { "location": "434/TALK"  , "narrator": "ガブリエラ", "text": "…ほっ、よかった。\n諦めてくれたみたい。"},
        { "location": "436/TALK"  , "narrator": "ガブリエラ", "text": "でも、なんだったの\nかしら？"},
        { "location": "15/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>5月16日　0:51 PM</color>\nとある昼休み中、\n学園廊下にて。"}
