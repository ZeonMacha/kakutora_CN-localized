    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "プランツ・ドール"},
        { "location": "32/TALK"   , "narrator": "神楽", "text": "この世界にだけ存在する病"},
        { "location": "33/TALK"   , "narrator": "神楽", "text": "それは人が花を吐く病"},
        { "location": "34/TALK"   , "narrator": "神楽", "text": "人は花を吐くたびに、植物に近づいてゆく"},
        { "location": "36/SEL"    , "narrator": "", "text": "光合成できたら便利だよね！"},
        { "location": "37/SEL"    , "narrator": "", "text": "うたかたの日々だ"},
        { "location": "38/SEL"    , "narrator": "", "text": "オオゲツヒメノカミの話かな？"},
        { "location": "39/ACT"    , "narrator": "", "text": "光合成できたら便利だよね！"},
        { "location": "40/TALK"   , "narrator": "神楽", "text": "$handle$さんったらポジティブすぎです～～～！"},
        { "location": "41/ACT"    , "narrator": "", "text": "うたかたの日々だ"},
        { "location": "42/TALK"   , "narrator": "神楽", "text": "あれは蓮のつぼみが肺にできる病いぴょん"},
        { "location": "43/TALK"   , "narrator": "神楽", "text": "そして蓮コラとは無関係なのですよ～～～"},
        { "location": "44/ACT"    , "narrator": "", "text": "オオゲツヒメノカミの話かな？"},
        { "location": "45/TALK"   , "narrator": "神楽", "text": "日本神話ｷﾀｺﾚ!!"},
        { "location": "46/TALK"   , "narrator": "神楽", "text": "ぴょんこがしたいのは豊穣じゃなくて退廃の物語ぴょん"},
        { "location": "48/TALK"   , "narrator": "神楽", "text": "その病に罹患した者は日の光を避けて暮らす"},
        { "location": "49/TALK"   , "narrator": "神楽", "text": "日光は花を育ててしまうから"},
        { "location": "50/TALK"   , "narrator": "神楽", "text": "そしてまれに月明りや星の光、暖炉の火に反応する花もある"},
        { "location": "52/SEL"    , "narrator": "", "text": "どんな花が咲くの？"},
        { "location": "53/SEL"    , "narrator": "", "text": "幻想的だ"},
        { "location": "54/SEL"    , "narrator": "", "text": "いやそれはありえない"},
        { "location": "55/ACT"    , "narrator": "", "text": "どんな花が咲くの？"},
        { "location": "56/TALK"   , "narrator": "神楽", "text": "患者によるのです"},
        { "location": "57/ACT"    , "narrator": "", "text": "幻想的だ"},
        { "location": "58/TALK"   , "narrator": "神楽", "text": "ええ"},
        { "location": "60/TALK"   , "narrator": "神楽", "text": "それはとても"},
        { "location": "61/ACT"    , "narrator": "", "text": "いやそれはありえない"},
        { "location": "62/TALK"   , "narrator": "神楽", "text": "そうなんですけどね？"},
        { "location": "63/TALK"   , "narrator": "神楽", "text": "これはあくまでお話ですから♪"},
        { "location": "65/TALK"   , "narrator": "神楽", "text": "花を吐かずに飲み込めば"},
        { "location": "66/TALK"   , "narrator": "神楽", "text": "植物にならなくてよいかもしれない"},
        { "location": "67/TALK"   , "narrator": "神楽", "text": "そう考えた一人の患者は"},
        { "location": "68/TALK"   , "narrator": "神楽", "text": "花を吐きそうになるたび飲み込んで抑えつけた"},
        { "location": "69/TALK"   , "narrator": "神楽", "text": "病院にはかからずに"},
        { "location": "71/SEL"    , "narrator": "", "text": "それでどうなったの？"},
        { "location": "72/SEL"    , "narrator": "", "text": "そんなことできるの？"},
        { "location": "73/ACT"    , "narrator": "", "text": "それでどうなったの？"},
        { "location": "74/TALK"   , "narrator": "神楽", "text": "患者の最後を知りたいですか？"},
        { "location": "75/ACT"    , "narrator": "", "text": "そんなことできるの？"},
        { "location": "76/TALK"   , "narrator": "神楽", "text": "できるわけありませんよね"},
        { "location": "78/TALK"   , "narrator": "神楽", "text": "ある日花たちは患者の胸を突き破り"},
        { "location": "79/TALK"   , "narrator": "神楽", "text": "色とりどりの花々を咲かせた"},
        { "location": "80/TALK"   , "narrator": "神楽", "text": "その花たちは胸に抱えた花束のように見えた"},
        { "location": "81/TALK"   , "narrator": "神楽", "text": "そして枯れることはなかった"},
        { "location": "83/SEL"    , "narrator": "", "text": "死んじゃったの？"},
        { "location": "84/SEL"    , "narrator": "", "text": "痛い痛い痛い！"},
        { "location": "85/SEL"    , "narrator": "", "text": "シュール…"},
        { "location": "86/ACT"    , "narrator": "", "text": "死んじゃったの？"},
        { "location": "87/TALK"   , "narrator": "神楽", "text": "人としては死と言えるかもしれませんが"},
        { "location": "88/TALK"   , "narrator": "神楽", "text": "花は咲き続けているのです"},
        { "location": "89/ACT"    , "narrator": "", "text": "痛い痛い痛い！"},
        { "location": "90/TALK"   , "narrator": "神楽", "text": "植物になってしまえば痛みはもうないのです"},
        { "location": "91/ACT"    , "narrator": "", "text": "シュール…"},
        { "location": "92/TALK"   , "narrator": "神楽", "text": "幻想的だと言ってほしいです♪"},
        { "location": "95/SEL"    , "narrator": "", "text": "病院に行けばよかったのに"},
        { "location": "96/SEL"    , "narrator": "", "text": "治療法はなかったの？"},
        { "location": "97/SEL"    , "narrator": "", "text": "戸籍とかどうなるんだろうね？"},
        { "location": "98/ACT"    , "narrator": "", "text": "病院に行けばよかったのに"},
        { "location": "99/TALK"   , "narrator": "神楽", "text": "行けなかったんです"},
        { "location": "102/SEL"   , "narrator": "", "text": "なんで？"},
        { "location": "103/SEL"   , "narrator": "", "text": "お金がなかったのかな"},
        { "location": "104/SEL"   , "narrator": "", "text": "保険証持ってなかったとか？"},
        { "location": "105/ACT"   , "narrator": "", "text": "なんで？"},
        { "location": "106/TALK"  , "narrator": "神楽", "text": "どうしても"},
        { "location": "107/TALK"  , "narrator": "神楽", "text": "どうしても行けなかったんです"},
        { "location": "108/ACT"   , "narrator": "", "text": "お金がなかったのかな"},
        { "location": "109/TALK"  , "narrator": "神楽", "text": "そういうのとはちょっと違うんですけど、、、"},
        { "location": "110/TALK"  , "narrator": "神楽", "text": "行く気になれなかったんですよ、、、"},
        { "location": "111/ACT"   , "narrator": "", "text": "保険証持ってなかったとか？"},
        { "location": "112/TALK"  , "narrator": "神楽", "text": "これファンタジーですからー！？"},
        { "location": "113/TALK"  , "narrator": "神楽", "text": "現代医療制度は適用されませんからねっ★"},
        { "location": "115/ACT"   , "narrator": "", "text": "治療法はなかったの？"},
        { "location": "116/TALK"  , "narrator": "神楽", "text": "不確定要素はありますが"},
        { "location": "117/TALK"  , "narrator": "神楽", "text": "なかったわけではありません"},
        { "location": "119/SEL"   , "narrator": "", "text": "じゃあ治療すればよかったのに"},
        { "location": "120/SEL"   , "narrator": "", "text": "病気になりたかったのかな？"},
        { "location": "121/SEL"   , "narrator": "", "text": "治す努力は必要だよね…"},
        { "location": "122/ACT"   , "narrator": "", "text": "じゃあ治療すればよかったのに"},
        { "location": "123/TALK"  , "narrator": "神楽", "text": "そんな気にはなれなかったんですよ"},
        { "location": "124/TALK"  , "narrator": "神楽", "text": "その患者は"},
        { "location": "125/ACT"   , "narrator": "", "text": "病気になりたかったのかな？"},
        { "location": "126/TALK"  , "narrator": "神楽", "text": "ある意味そうだったのかもしれませんね"},
        { "location": "127/ACT"   , "narrator": "", "text": "治す努力は必要だよね…"},
        { "location": "128/TALK"  , "narrator": "神楽", "text": "治療を受けない権利"},
        { "location": "129/TALK"  , "narrator": "神楽", "text": "そういうものもあると思うんですよ"},
        { "location": "130/TALK"  , "narrator": "神楽", "text": "ぴょんこ個人としては"},
        { "location": "132/ACT"   , "narrator": "", "text": "戸籍とかどうなるんだろうね？"},
        { "location": "133/TALK"  , "narrator": "神楽", "text": "日本ほどしっかりした戸籍がある国は珍しいそうですよ♪"},
        { "location": "134/TALK"  , "narrator": "神楽", "text": "ファンタジーならなおさらないんじゃないでしょうか？"},
        { "location": "136/SEL"   , "narrator": "", "text": "いや行政関係はきっちり構築しないと"},
        { "location": "137/SEL"   , "narrator": "", "text": "生きてるのか死んでるのかわかんないよね？"},
        { "location": "138/SEL"   , "narrator": "", "text": "まあいいかそこは"},
        { "location": "139/ACT"   , "narrator": "", "text": "いや行政関係はきっちり構築しないと"},
        { "location": "140/TALK"  , "narrator": "神楽", "text": "そういうリアリティの出し方もありですよね♪"},
        { "location": "141/ACT"   , "narrator": "", "text": "生きてるのか死んでるのかわかんないよね？"},
        { "location": "142/TALK"  , "narrator": "神楽", "text": "そこがキモなんですよ"},
        { "location": "143/TALK"  , "narrator": "神楽", "text": "このお話は"},
        { "location": "144/TALK"  , "narrator": "神楽", "text": "哲学的ですよねっ♪"},
        { "location": "145/ACT"   , "narrator": "", "text": "まあいいかそこは"},
        { "location": "146/TALK"  , "narrator": "神楽", "text": "軽く流されるのもﾋﾞﾐｮｳ、、、、"},
        { "location": "148/TALK"  , "narrator": "神楽", "text": "難しいですね♪"},
        { "location": "151/TALK"  , "narrator": "神楽", "text": "そしてこれはその後の物語"},
        { "location": "154/TALK"  , "narrator": "ボイスメール", "text": "その後の物語"},
        { "location": "166/DIALOG", "narrator": "Dialog_GETVoice", "text": "<color=green>【神楽】</color>のボイスメール\n<color=red>【その後の物語】</color>\nをゲットしました！"}
    ]
}
