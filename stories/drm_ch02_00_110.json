{
    "dir": "dramatics/daydra/drm_ch02_00_110.js",
    "type": "Episode",
    "info": {
        "story_id": "2011",
        "cid": "ayami",
        "title": "らぶとーく 第11話",
        "sub_title": "わかってしまった"
    },
    "entry":
    [
        { "location": "103/SCENARIO", "narrator": "", "text": "わかってしまった"},
        { "location": "117/TALK"    , "narrator": "みやび", "text": "呼び出してすまんね。"},
        { "location": "119/TALK"    , "narrator": "アーヤ", "text": "気にしないで。\nそれより、話って何？"},
        { "location": "120/TALK"    , "narrator": "みやび", "text": "Ｂｏｔのことや。"},
        { "location": "121/TALK"    , "narrator": "みやび", "text": "あれから、まあ、うちも\n色々調べたり、話しかけ\nたりしたんやけんど――"},
        { "location": "122/TALK"    , "narrator": "みやび", "text": "やっと確証を持てたちや。"},
        { "location": "124/TALK"    , "narrator": "アーヤ", "text": "そう…。"},
        { "location": "126/TALK"    , "narrator": "アーヤ", "text": "それで、その答えって？"},
        { "location": "128/TALK"    , "narrator": "みやび", "text": "あのＢｏｔ。\nあいつの正体は――"},
        { "location": "129/TALK"    , "narrator": "みやび", "text": "人間や。"},
        { "location": "130/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "131/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "133/TALK"    , "narrator": "アーヤ", "text": "…そう。\nやっぱりね。"},
        { "location": "135/TALK"    , "narrator": "みやび", "text": "…なんや、あんまし\n驚かんようやな？"},
        { "location": "136/TALK"    , "narrator": "アーヤ", "text": "可能性はある、って\n最初から思ってたもの。"},
        { "location": "138/TALK"    , "narrator": "アーヤ", "text": "まったく驚いてない\nわけじゃないけど――"},
        { "location": "140/TALK"    , "narrator": "アーヤ", "text": "ああ、やっぱりね…。\nって気持ちの方が強いわ。"},
        { "location": "141/TALK"    , "narrator": "みやび", "text": "なるほど。\nまあ、それもそうやな。"},
        { "location": "143/TALK"    , "narrator": "みやび", "text": "うちも、Ｂｏｔが人間と\nわかったからゆうて――"},
        { "location": "145/TALK"    , "narrator": "みやび", "text": "叫ぶほど驚いたわけや\nないし。"},
        { "location": "146/TALK"    , "narrator": "アーヤ", "text": "でしょうね…。"},
        { "location": "149/TALK"    , "narrator": "アーヤ", "text": "はぁ…でも、まさか本当に\n人間だったなんて…。"},
        { "location": "151/TALK"    , "narrator": "みやび", "text": "ビックリちや。\nうちら五人を一人で\n相手していたんやし…。"},
        { "location": "152/TALK"    , "narrator": "アーヤ", "text": "そうね。"},
        { "location": "153/TALK"    , "narrator": "アーヤ", "text": "とりあえず…このことは\nみんなにも、ちゃんと\n話さないといけないわね。"},
        { "location": "154/TALK"    , "narrator": "みやび", "text": "そうやね。\n話すなら、なるべく\n早いうちがえいよ。"},
        { "location": "155/TALK"    , "narrator": "アーヤ", "text": "そうね。\nそれじゃあ――"},
        { "location": "156/TALK"    , "narrator": "アーヤ", "text": "っと、その前に。\nＢｏｔにも聞いておくわ。"},
        { "location": "168/TALK"    , "narrator": "アーヤ", "text": "全部聞いてたんでしょ？"},
        { "location": "170/SEL"     , "narrator": "", "text": "聞いてた"},
        { "location": "171/ACT"     , "narrator": "", "text": "聞いてた"},
        { "location": "173/TALK"    , "narrator": "アーヤ", "text": "やっぱり…"},
        { "location": "174/TALK"    , "narrator": "アーヤ", "text": "貴方のことみんなに言うけど"},
        { "location": "175/TALK"    , "narrator": "アーヤ", "text": "良い？"},
        { "location": "177/SEL"     , "narrator": "", "text": "大歓迎"},
        { "location": "178/SEL"     , "narrator": "", "text": "二人の秘密にしようよ"},
        { "location": "179/SEL"     , "narrator": "", "text": "好きにして"},
        { "location": "180/ACT"     , "narrator": "", "text": "大歓迎"},
        { "location": "183/TALK"    , "narrator": "アーヤ", "text": "能天気な答えね"},
        { "location": "184/ACT"     , "narrator": "", "text": "二人の秘密にしようよ"},
        { "location": "185/TALK"    , "narrator": "アーヤ", "text": "いや"},
        { "location": "186/TALK"    , "narrator": "アーヤ", "text": "みやびも知ってるんだから"},
        { "location": "187/TALK"    , "narrator": "アーヤ", "text": "二人の秘密にならないでしょ？(-.-;)"},
        { "location": "188/TALK"    , "narrator": "アーヤ", "text": "隠してる理由にならないわ"},
        { "location": "189/ACT"     , "narrator": "", "text": "好きにして"},
        { "location": "190/TALK"    , "narrator": "アーヤ", "text": "随分聞き訳が良いのね"},
        { "location": "191/TALK"    , "narrator": "アーヤ", "text": "良過ぎて、少し不気味かも"},
        { "location": "192/TALK"    , "narrator": "アーヤ", "text": "まあ"},
        { "location": "193/TALK"    , "narrator": "アーヤ", "text": "それなら良いんだけど"},
        { "location": "207/TALK"    , "narrator": "みやび", "text": "…何か言うてた？"},
        { "location": "208/TALK"    , "narrator": "アーヤ", "text": "ううん、大丈夫そうよ。"},
        { "location": "210/TALK"    , "narrator": "アーヤ", "text": "あとは、いつみんなに\n言うのか、よね…。"},
        { "location": "212/TALK"    , "narrator": "みやび", "text": "早い方がえいけんど、\n慌てることもないき。"},
        { "location": "214/TALK"    , "narrator": "みやび", "text": "明日の夜、みんな集めて\n話せばえいと思うちや。"},
        { "location": "216/TALK"    , "narrator": "アーヤ", "text": "わかったわ。\nそれじゃ、明日の夜で\n決まりね。"},
        { "location": "217/TALK"    , "narrator": "アーヤ", "text": "…きっと、みんな驚くわ\nよね？"},
        { "location": "219/TALK"    , "narrator": "みやび", "text": "そうやろうね…。"},
        { "location": "221/TALK"    , "narrator": "みやび", "text": "まあ、早く言うか\n遅く言うかだけの\n違いやし――"},
        { "location": "222/TALK"    , "narrator": "みやび", "text": "気にすることないちや。"},
        { "location": "225/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "237/TALK"    , "narrator": "アーヤ", "text": "やっぱりちょっと伝えておくわね"},
        { "location": "240/TALK"    , "narrator": "ボイスメール", "text": "淑女による紳士協定"},
        { "location": "114/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>5月某日　10:44 PM</color>\n平日の夜、みやびの部屋にて。"},
        { "location": "252/DIALOG"  , "narrator": "Dialog_GETVoice", "text": "<color=green>【アーヤ】</color>のボイスメール\n<color=red>【淑女による紳士協定】</color>\nをゲットしました！"}
    ]
}
