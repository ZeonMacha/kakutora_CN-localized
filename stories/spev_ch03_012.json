        "title": "スペシャルエピソード",
        "sub_title": "雪女、あたためますか"
    },
    "entry":
    [
        { "location": "22/TALK" , "narrator": "透明ガブリエラ", "text": "…逃がさない。"},
        { "location": "23/TALK" , "narrator": "透明ガブリエラ", "text": "絶対に、あんたを\n帰したりしないわ。"},
        { "location": "30/TALK" , "narrator": "透明ガブリエラ", "text": "あたしを置いて、\n山を下りるなんて…。"},
        { "location": "31/TALK" , "narrator": "透明ガブリエラ", "text": "そんなの、\n絶対に許さない。"},
        { "location": "32/SEL"  , "narrator": "（選択肢）", "text": "雪女！？"},
        { "location": "33/ACT"  , "narrator": "", "text": "雪女！？"},
        { "location": "35/TALK" , "narrator": "透明ガブリエラ", "text": "…ええ、そうよ。"},
        { "location": "36/TALK" , "narrator": "透明ガブリエラ", "text": "あたしはこの山に住む、\nたった一人の雪女…。"},
        { "location": "37/TALK" , "narrator": "透明ガブリエラ", "text": "だからあんたも、\nこの山から帰したりは\nしないわ。"},
        { "location": "38/SEL"  , "narrator": "（選択肢）", "text": "$me$をどうするつもりだ！？"},
        { "location": "39/ACT"  , "narrator": "", "text": "$me$をどうするつもりだ！？"},
        { "location": "41/TALK" , "narrator": "透明ガブリエラ", "text": "もう二度と、あたしを\n一人にしようと思えない\nようにするわ。"},
        { "location": "42/TALK" , "narrator": "透明ガブリエラ", "text": "今まであたしを置いて\n山を下りようとした\n奴らと同じように…。"},
        { "location": "43/TALK" , "narrator": "透明ガブリエラ", "text": "あんたも、カチカチの\n氷に閉じ込める！"},
        { "location": "44/SEL"  , "narrator": "（選択肢）", "text": "死んじゃうよ！！"},
        { "location": "45/SEL"  , "narrator": "（選択肢）", "text": "とっても寒そうだ"},
        { "location": "46/ACT"  , "narrator": "", "text": "死んじゃうよ！！"},
        { "location": "49/TALK" , "narrator": "透明ガブリエラ", "text": "え…、もしかして\n通じてなかった？"},
        { "location": "50/TALK" , "narrator": "透明ガブリエラ", "text": "氷に閉じ込めるってのは\n殺すってことだったん\nだけど…。"},
        { "location": "51/TALK" , "narrator": "透明ガブリエラ", "text": "…意外と鈍感なのね？"},
        { "location": "52/ACT"  , "narrator": "", "text": "死んじゃうよ！！"},
        { "location": "54/TALK" , "narrator": "透明ガブリエラ", "text": "大丈夫よ。\n無闇に苦しめるような\nことは好きじゃないから。"},
        { "location": "58/TALK" , "narrator": "透明ガブリエラ", "text": "一瞬でカチコチにして\nあげるから、苦しんだりは\nしないはずよ。"},
        { "location": "59/TALK" , "narrator": "透明ガブリエラ", "text": "だから、安心して\n凍りづけになっちゃい\nなさい。"},
        { "location": "61/TALK" , "narrator": "透明ガブリエラ", "text": "それじゃ…いくわよ！"},
        { "location": "62/SEL"  , "narrator": "（選択肢）", "text": "なんでこんなことするの？"},
        { "location": "63/ACT"  , "narrator": "", "text": "なんでこんなことするの？"},
        { "location": "66/TALK" , "narrator": "透明ガブリエラ", "text": "あんたが山を下りようと\nするからよ。"},
        { "location": "67/TALK" , "narrator": "透明ガブリエラ", "text": "みんなと同じで、\nあたしをまた一人だけ\nここに残して…。"},
        { "location": "68/TALK" , "narrator": "透明ガブリエラ", "text": "だから、あんたのことも\n氷付けにするの。"},
        { "location": "69/TALK" , "narrator": "透明ガブリエラ", "text": "そして、他のみんなと\n一緒に保管するわ。"},
        { "location": "70/TALK" , "narrator": "透明ガブリエラ", "text": "そうすれば、あたしは\n独りぼっちじゃないから。"},
        { "location": "71/SEL"  , "narrator": "（選択肢）", "text": "意味がないよ、そんなの"},
        { "location": "72/SEL"  , "narrator": "（選択肢）", "text": "それで満足するの？"},
        { "location": "73/ACT"  , "narrator": "", "text": "意味がないよ、そんなの"},
        { "location": "75/TALK" , "narrator": "透明ガブリエラ", "text": "ふん、なによそれ？\nそういえばあたしの\n考えが変わると思った？"},
        { "location": "76/TALK" , "narrator": "透明ガブリエラ", "text": "だとしたら無駄よ。\n今更命乞いしたって\n遅いんだから。"},
        { "location": "77/ACT"  , "narrator": "", "text": "それで満足するの？"},
        { "location": "78/TALK" , "narrator": "透明ガブリエラ", "text": "当然でしょ。\nそんなこと聞いて、\n時間稼ぎのつもり？"},
        { "location": "80/SEL"  , "narrator": "（選択肢）", "text": "何人氷付けにしても解決しないよ"},
        { "location": "81/ACT"  , "narrator": "", "text": "何人氷付けにしても解決しないよ"},
        { "location": "84/TALK" , "narrator": "透明ガブリエラ", "text": "…そ、そんなの、\nわからないじゃない！"},
        { "location": "85/TALK" , "narrator": "透明ガブリエラ", "text": "あんたが増えたら、\nもしかしたら寂しくは\nなくなるかもしれない。"},
        { "location": "86/TALK" , "narrator": "透明ガブリエラ", "text": "もう、独りぼっちって\n思わなくてすむように\nなるかもしれないでしょ？"},
        { "location": "87/SEL"  , "narrator": "（選択肢）", "text": "本気でそう思ってるわけ？"},
        { "location": "88/ACT"  , "narrator": "", "text": "本気でそう思ってるわけ？"},
        { "location": "90/TALK" , "narrator": "透明ガブリエラ", "text": "それは…。"},
        { "location": "91/SEL"  , "narrator": "（選択肢）", "text": "そんなの、一緒にいるとは言えない"},
        { "location": "92/ACT"  , "narrator": "", "text": "そんなの、一緒にいるとは言えない"},
        { "location": "94/TALK" , "narrator": "透明ガブリエラ", "text": "…でも――"},
        { "location": "95/TALK" , "narrator": "透明ガブリエラ", "text": "仕方ないじゃない！"},
        { "location": "96/TALK" , "narrator": "透明ガブリエラ", "text": "あたしは雪女で、\nあんたは人間なんだから！"},
        { "location": "97/TALK" , "narrator": "透明ガブリエラ", "text": "こうでもしないと、\nあんたは一緒にいては\nくれないでしょ！？"},
        { "location": "98/SEL"  , "narrator": "（選択肢）", "text": "こんなやり方じゃ当然だ"},
        { "location": "99/SEL"  , "narrator": "（選択肢）", "text": "雪女と人間は住む世界が違う"},
        { "location": "100/ACT" , "narrator": "", "text": "こんなやり方じゃ当然だ"},
        { "location": "103/TALK", "narrator": "透明ガブリエラ", "text": "え？"},
        { "location": "105/TALK", "narrator": "透明ガブリエラ", "text": "じゃ、じゃあ…あんたは\nあたしみたいな雪女と、\n一緒にいてくれるの？"},
        { "location": "106/TALK", "narrator": "透明ガブリエラ", "text": "家に帰りたいとか、\nもう言わない？"},
        { "location": "107/SEL" , "narrator": "（選択肢）", "text": "絶対戻ってくるよ"},
        { "location": "108/SEL" , "narrator": "（選択肢）", "text": "いや、帰れないのは困る"},
        { "location": "109/ACT" , "narrator": "", "text": "絶対戻ってくるよ"},
        { "location": "111/TALK", "narrator": "透明ガブリエラ", "text": "ウソ！\nそんなこと言って、\nどうせ――"},
        { "location": "112/SEL" , "narrator": "（選択肢）", "text": "人を信じられなければ一生孤独のままだ"},
        { "location": "113/ACT" , "narrator": "", "text": "人を信じられなければ一生孤独のままだ"},
        { "location": "116/TALK", "narrator": "透明ガブリエラ", "text": "…でも、もし信じて、\n裏切られたらって\n思うと…。"},
        { "location": "117/TALK", "narrator": "透明ガブリエラ", "text": "不安でたまらないの！\nもう、寂しい想いは\nしたくないのよ！"},
        { "location": "118/SEL" , "narrator": "（選択肢）", "text": "$me$はそんな想いさせない"},
        { "location": "119/ACT" , "narrator": "", "text": "$me$はそんな想いさせない"},
        { "location": "121/TALK", "narrator": "透明ガブリエラ", "text": "…………。"},
        { "location": "122/SEL" , "narrator": "（選択肢）", "text": "もっと君のことを知りたいから"},
        { "location": "123/SEL" , "narrator": "（選択肢）", "text": "だから家に帰して"},
        { "location": "124/ACT" , "narrator": "", "text": "もっと君のことを知りたいから"},
        { "location": "126/TALK", "narrator": "透明ガブリエラ", "text": "…あたしも。"},
        { "location": "128/TALK", "narrator": "透明ガブリエラ", "text": "あんたと沢山話して、\n沢山、色んなことを\n知りたい…。"},
        { "location": "129/TALK", "narrator": "透明ガブリエラ", "text": "…わかった。\n山を下りて、家に帰っても\nいいわ…。"},
        { "location": "130/TALK", "narrator": "透明ガブリエラ", "text": "あんたのこと知る前に、\n氷付けにしちゃいたく\nないから…。"},
        { "location": "131/SEL" , "narrator": "（選択肢）", "text": "$me$はそんな想いさせない"},
        { "location": "132/ACT" , "narrator": "", "text": "$me$はそんな想いさせない"},
        { "location": "134/TALK", "narrator": "透明ガブリエラ", "text": "…信じるわ。"},
        { "location": "135/TALK", "narrator": "透明ガブリエラ", "text": "あたしは、あんたを\n氷付けにしようとした\nっていうのに…。"},
        { "location": "136/TALK", "narrator": "透明ガブリエラ", "text": "そんな風に言ってくれる\nあんたを…あたしも、\n信じたいから…。"},
        { "location": "137/TALK", "narrator": "透明ガブリエラ", "text": "絶対、またこの山に\n帰ってきてね…。"},
        { "location": "138/TALK", "narrator": "透明ガブリエラ", "text": "その時は――"},
        { "location": "139/TALK", "narrator": "透明ガブリエラ", "text": "吹雪が止むまで、\n沢山、あなたのお話\n聞かせてね…。"},
        { "location": "145/ACT" , "narrator": "", "text": "だから家に帰して"},
        { "location": "147/TALK", "narrator": "透明ガブリエラ", "text": "…ダメ。"},
        { "location": "148/TALK", "narrator": "透明ガブリエラ", "text": "あんたの言葉は、\n信じられない！"},
        { "location": "151/ACT" , "narrator": "", "text": "いや、帰れないのは困る"},
        { "location": "153/TALK", "narrator": "透明ガブリエラ", "text": "…なによそれ？"},
        { "location": "154/TALK", "narrator": "透明ガブリエラ", "text": "結局、あんたは家に\n帰りたいだけじゃない！"},
        { "location": "157/ACT" , "narrator": "", "text": "雪女と人間は住む世界が違う"},
        { "location": "160/TALK", "narrator": "透明ガブリエラ", "text": "…そうよね。"},
        { "location": "161/TALK", "narrator": "透明ガブリエラ", "text": "結局、そういうこと\nなのよね…。"},
        { "location": "165/TALK", "narrator": "透明ガブリエラ", "text": "やっぱり、あんたには\nここで凍り付けになって\nもらう。"},
        { "location": "166/TALK", "narrator": "透明ガブリエラ", "text": "大丈夫よ、痛くないし、\n苦しくもないから…。"},
        { "location": "167/TALK", "narrator": "透明ガブリエラ", "text": "さあ、目をつむって…。\nゆっくり、穏やかに\nおやすみなさい…。"}
    ]
}
