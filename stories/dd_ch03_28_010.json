    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "東京編７話"},
        { "location": "16/DIALOG" , "narrator": "", "text": "<color=green>9月5日　 9:13 AM</color>\nとある平日の放課後、神楽坂トライナリー劇場前にて"},
        { "location": "17/TALK"   , "narrator": "雛", "text": "う～ん…思った以上に\n警備がすごいなぁ…。"},
        { "location": "18/TALK"   , "narrator": "雛", "text": "こっそり入れないかと\n思ったけど、簡単には\nいかないかも…。"},
        { "location": "19/TALK"   , "narrator": "雛", "text": "…どこか、ちょっとでも\nチャンスがあれば\nいいんだけど…。"},
        { "location": "20/TALK"   , "narrator": "ヒカル", "text": "…ひなこさん。"},
        { "location": "21/TALK"   , "narrator": "雛", "text": "っ！？"},
        { "location": "24/TALK"   , "narrator": "ヒカル", "text": "すみません。\n驚かせちゃいました？"},
        { "location": "26/TALK"   , "narrator": "雛", "text": "ヒカルくん！\nどうしてここにいるの！？"},
        { "location": "27/TALK"   , "narrator": "ヒカル", "text": "…とりあえず、\n場所を変えよう。\nここにいるのは危険だよ。"},
        { "location": "28/TALK"   , "narrator": "雛", "text": "…………。"},
        { "location": "40/TALK"   , "narrator": "雛", "text": "…どうしてわかったの？\nあたしが劇場にいるって。"},
        { "location": "41/TALK"   , "narrator": "ヒカル", "text": "ひなこさんは\n簡単に引き下がるような\nタイプじゃないから…。"},
        { "location": "42/TALK"   , "narrator": "ヒカル", "text": "あれで納得して、\n大人しく家に帰るなんて\n思わないよ。"},
        { "location": "43/TALK"   , "narrator": "雛", "text": "バレバレだったの！？"},
        { "location": "44/TALK"   , "narrator": "雛", "text": "そんなぁ…。\n帰るフリまでして\n行ったのにー…。"},
        { "location": "45/TALK"   , "narrator": "ヒカル", "text": "…それより、劇場で\n何をしようとしてたの？"},
        { "location": "46/TALK"   , "narrator": "ヒカル", "text": "わかってるだろうけど、\n劇場は今、管理庁が\n厳重警備していて…。"},
        { "location": "47/TALK"   , "narrator": "ヒカル", "text": "入るのはもちろん、\n近づくだけでも\n危険なの、知ってるよね？"},
        { "location": "48/TALK"   , "narrator": "ヒカル", "text": "それなのに、\nどうして行ったの？"},
        { "location": "49/TALK"   , "narrator": "雛", "text": "…あ、あれ？\nヒカルくん、\nちょっと怒ってない？"},
        { "location": "50/TALK"   , "narrator": "ヒカル", "text": "…………。"},
        { "location": "52/TALK"   , "narrator": "雛", "text": "えと…ちょっと、\n劇場に入ろうかなぁ、\nって…。"},
        { "location": "53/TALK"   , "narrator": "ヒカル", "text": "やっぱり…どうして\nそんな危ないことを…。"},
        { "location": "54/TALK"   , "narrator": "雛", "text": "…ヒカルくん達、\nあたし達が勝手に動くのは\n危険、って言ったでしょ？"},
        { "location": "55/TALK"   , "narrator": "雛", "text": "だから、綾水様達と\n連絡を取る方法を\n探そうと思って…。"},
        { "location": "56/TALK"   , "narrator": "ヒカル", "text": "…なるほど。\n綾水先輩達に連絡が\n取れれば…。"},
        { "location": "57/TALK"   , "narrator": "ヒカル", "text": "僕達がどう動けば\n手助けができるか、\n聞けると思ったんだね？"},
        { "location": "59/TALK"   , "narrator": "雛", "text": "うん…それなら、\n自殺行為じゃないでしょ？"},
        { "location": "60/TALK"   , "narrator": "ヒカル", "text": "でも、無謀だよ。"},
        { "location": "61/TALK"   , "narrator": "ヒカル", "text": "厳重警備の劇場に\n不法侵入しようだ\nなんて…。"},
        { "location": "62/TALK"   , "narrator": "雛", "text": "…わかってるよ。\n無謀ってことくらい…。"},
        { "location": "64/TALK"   , "narrator": "雛", "text": "それでも、何もしない\nなんてできないよ！"},
        { "location": "65/TALK"   , "narrator": "ヒカル", "text": "ひなこさん…。"},
        { "location": "66/TALK"   , "narrator": "雛", "text": "みんなには迷惑かけない。\nあたしが一人で勝手に\nやろうとしてるだけ。"},
        { "location": "68/TALK"   , "narrator": "雛", "text": "だからお願い。\n何も見なかった\nことにして！"},
        { "location": "69/TALK"   , "narrator": "ヒカル", "text": "…………。"},
        { "location": "70/TALK"   , "narrator": "雛", "text": "…だめ？"},
        { "location": "71/TALK"   , "narrator": "ヒカル", "text": "…当然、ダメだよ。"},
        { "location": "72/TALK"   , "narrator": "雛", "text": "やっぱり…。"},
        { "location": "73/TALK"   , "narrator": "ヒカル", "text": "そんな危険なこと、\nひなこさん一人だけに\nさせられないよ。"},
        { "location": "74/TALK"   , "narrator": "雛", "text": "…え？"},
        { "location": "75/TALK"   , "narrator": "ヒカル", "text": "僕も協力する。\nだから、一緒にどうするか\n考えよう。"},
        { "location": "76/TALK"   , "narrator": "雛", "text": "で、でも、いいの！？\nヒカルくんはあたしに\n反対してたのに…。"},
        { "location": "77/TALK"   , "narrator": "ヒカル", "text": "今だって、手放しで\n賛成はできないけど…。"},
        { "location": "78/TALK"   , "narrator": "ヒカル", "text": "一人で突っ走ろうと\nしてるひなこさんを、\n放っておけないよ。"},
        { "location": "79/TALK"   , "narrator": "雛", "text": "ヒカルくん…。"},
        { "location": "80/TALK"   , "narrator": "ヒカル", "text": "それに、キリトだって\n言ってたでしょ？"},
        { "location": "81/TALK"   , "narrator": "ヒカル", "text": "僕達だって、逢瀬さんを\n助けたいって気持ちは\n一緒だ、って…。"},
        { "location": "82/TALK"   , "narrator": "ヒカル", "text": "だから…自分の気持ちに\nまっすぐなひなこさんを\n見てたら…。"},
        { "location": "83/TALK"   , "narrator": "ヒカル", "text": "ちょっと、羨ましいって\n思っちゃって…。"},
        { "location": "84/TALK"   , "narrator": "雛", "text": "…………。"},
        { "location": "85/TALK"   , "narrator": "ヒカル", "text": "一緒に考えよう。\nこれから、二人だけで\nなにが出来るか…。"},
        { "location": "86/TALK"   , "narrator": "雛", "text": "…うん！"},
        { "location": "95/TALK"   , "narrator": "ガブリエラ", "text": "…本当、素敵な場所。"},
        { "location": "96/TALK"   , "narrator": "ガブリエラ", "text": "できれば、\nもっと普通の時に\n来たかったな…。"},
        { "location": "100/TALK"  , "narrator": "ガブリエラ", "text": "…なんとなくわかるけど。"},
        { "location": "104/TALK"  , "narrator": "ガブリエラ", "text": "…やっぱり雛からだわ。\n既読つかないように\n確認しないと…。"},
        { "location": "109/TALK"  , "narrator": "雛", "text": "見てるかどうかわからないけど"},
        { "location": "110/TALK"  , "narrator": "雛", "text": "報告するよ"},
        { "location": "111/TALK"  , "narrator": "雛", "text": "あたし"},
        { "location": "112/TALK"  , "narrator": "雛", "text": "つばめちゃんを助けるの諦めないから"},
        { "location": "113/TALK"  , "narrator": "雛", "text": "ガブリエラちゃん達と連絡を取るのも"},
        { "location": "115/TALK"  , "narrator": "雛", "text": "さいしょはね"},
        { "location": "116/TALK"  , "narrator": "雛", "text": "みんなに反対されたの"},
        { "location": "117/TALK"  , "narrator": "雛", "text": "危ないって"},
        { "location": "118/TALK"  , "narrator": "雛", "text": "自殺行為だって"},
        { "location": "119/TALK"  , "narrator": "雛", "text": "でも諦められなくて"},
        { "location": "120/TALK"  , "narrator": "雛", "text": "そしたら"},
        { "location": "121/TALK"  , "narrator": "雛", "text": "ヒカルくんが手伝ってくれることになって"},
        { "location": "123/TALK"  , "narrator": "雛", "text": "あたしは諦めないからね？"},
        { "location": "124/TALK"  , "narrator": "雛", "text": "ガブリエラちゃん達や"},
        { "location": "125/TALK"  , "narrator": "雛", "text": "つばめちゃんに会いたいから"},
        { "location": "127/TALK"  , "narrator": "雛", "text": "ヒカルくんも"},
        { "location": "128/TALK"  , "narrator": "雛", "text": "ガブリエラちゃんに会いたがってるよ"},
        { "location": "139/TALK"  , "narrator": "ガブリエラ", "text": "…ヒカルくんが一緒って、\nそれって手伝いじゃ\nなくて…。"},
        { "location": "140/TALK"  , "narrator": "ガブリエラ", "text": "手伝うふりして、\n止められてるんじゃ\nないのかしら？"},
        { "location": "141/TALK"  , "narrator": "ガブリエラ", "text": "自殺行為とわかってて、\n手伝ったりするような\n人じゃないし…。"},
        { "location": "142/TALK"  , "narrator": "ガブリエラ", "text": "…それにしても。"},
        { "location": "143/TALK"  , "narrator": "ガブリエラ", "text": "ひなこってば、\nまたあの話を\nぶり返すなんて…！"},
        { "location": "144/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "156/TALK"  , "narrator": "ガブリエラ", "text": "さすがにちょっと呆れたわ"},
        { "location": "157/TALK"  , "narrator": "ガブリエラ", "text": "ひなこってば"},
        { "location": "158/TALK"  , "narrator": "ガブリエラ", "text": "あたしがヒカルくんに思ってる気持ち"},
        { "location": "159/TALK"  , "narrator": "ガブリエラ", "text": "まだ勘違いしてるの"},
        { "location": "161/SEL"   , "narrator": "（選択肢）", "text": "恋してると思われてる、ってこと？"},
        { "location": "162/SEL"   , "narrator": "（選択肢）", "text": "煽ってるだけじゃない？"},
        { "location": "163/ACT"   , "narrator": "", "text": "恋してると思われてる、ってこと？"},
        { "location": "164/TALK"  , "narrator": "ガブリエラ", "text": "そうなの"},
        { "location": "165/TALK"  , "narrator": "ガブリエラ", "text": "何度違うって言ったか"},
        { "location": "166/TALK"  , "narrator": "ガブリエラ", "text": "自分でも忘れたわ"},
        { "location": "167/ACT"   , "narrator": "", "text": "煽ってるだけじゃない？"},
        { "location": "168/TALK"  , "narrator": "ガブリエラ", "text": "そういうこと？"},
        { "location": "169/TALK"  , "narrator": "ガブリエラ", "text": "それならいいけど"},
        { "location": "170/TALK"  , "narrator": "ガブリエラ", "text": "まだ勘違いしてるんだとしたら"},
        { "location": "171/TALK"  , "narrator": "ガブリエラ", "text": "さすがに頭痛いかも"},
        { "location": "176/SEL"   , "narrator": "（選択肢）", "text": "でも気になってはいたよね？"},
        { "location": "177/ACT"   , "narrator": "", "text": "でも気になってはいたよね？"},
        { "location": "180/TALK"  , "narrator": "ガブリエラ", "text": "マルザンナだから"},
        { "location": "181/TALK"  , "narrator": "ガブリエラ", "text": "正直に話すわ"},
        { "location": "182/TALK"  , "narrator": "ガブリエラ", "text": "確かに気になってたし"},
        { "location": "185/TALK"  , "narrator": "ガブリエラ", "text": "恋人になりたい"},
        { "location": "186/TALK"  , "narrator": "ガブリエラ", "text": "そう思ったこともあったわ///////"},
        { "location": "187/TALK"  , "narrator": "ガブリエラ", "text": "ヒカルくんは素敵でかっこよくて優しいから"},
        { "location": "188/TALK"  , "narrator": "ガブリエラ", "text": "いいなって思ってた"},
        { "location": "189/TALK"  , "narrator": "ガブリエラ", "text": "けど"},
        { "location": "192/TALK"  , "narrator": "ガブリエラ", "text": "気づいたの"},
        { "location": "193/TALK"  , "narrator": "ガブリエラ", "text": "あの時の気持ちは"},
        { "location": "195/TALK"  , "narrator": "ガブリエラ", "text": "好きって気持ちじゃなくて"},
        { "location": "197/TALK"  , "narrator": "ガブリエラ", "text": "憧れの気持ちだったと思う"},
        { "location": "198/TALK"  , "narrator": "ガブリエラ", "text": "ヒカルくんの恋人になりたいじゃなくて"},
        { "location": "199/TALK"  , "narrator": "ガブリエラ", "text": "ヒカルくんみたいな人になりたい"},
        { "location": "200/TALK"  , "narrator": "ガブリエラ", "text": "素敵でかっこよくて優しい"},
        { "location": "201/TALK"  , "narrator": "ガブリエラ", "text": "彼みたいな人になりたいって"},
        { "location": "204/TALK"  , "narrator": "ガブリエラ", "text": "文字にして話してるから？"},
        { "location": "206/TALK"  , "narrator": "ガブリエラ", "text": "改めて"},
        { "location": "207/TALK"  , "narrator": "ガブリエラ", "text": "気持ちの整理ができてる気がする"},
        { "location": "208/TALK"  , "narrator": "ガブリエラ", "text": "きっとこれが"},
        { "location": "209/TALK"  , "narrator": "ガブリエラ", "text": "私の本当の気持ち"},
        { "location": "212/TALK"  , "narrator": "ガブリエラ", "text": "ちょっと寂しいけど"},
        { "location": "214/SEL"   , "narrator": "（選択肢）", "text": "人間的に成長した証拠だよ"},
        { "location": "215/SEL"   , "narrator": "（選択肢）", "text": "これも失恋になるのかな？"},
        { "location": "216/ACT"   , "narrator": "", "text": "人間的に成長した証拠だよ"},
        { "location": "217/TALK"  , "narrator": "ガブリエラ", "text": "だといいんだけれど"},
        { "location": "218/TALK"  , "narrator": "ガブリエラ", "text": "どうなのかしら？"},
        { "location": "221/TALK"  , "narrator": "ガブリエラ", "text": "わからないけど"},
        { "location": "222/TALK"  , "narrator": "ガブリエラ", "text": "聞いてもらってよかった"},
        { "location": "223/ACT"   , "narrator": "", "text": "これも失恋になるのかな？"},
        { "location": "224/TALK"  , "narrator": "ガブリエラ", "text": "なるのかしら？"},
        { "location": "225/TALK"  , "narrator": "ガブリエラ", "text": "私ね"},
        { "location": "228/TALK"  , "narrator": "ガブリエラ", "text": "恋に恋してた"},
        { "location": "229/TALK"  , "narrator": "ガブリエラ", "text": "多分ね"},
        { "location": "232/TALK"  , "narrator": "ガブリエラ", "text": "それも恋のうちなら"},
        { "location": "233/TALK"  , "narrator": "ガブリエラ", "text": "失恋なのよね"},
        { "location": "234/TALK"  , "narrator": "ガブリエラ", "text": "あんまりそうは"},
        { "location": "235/TALK"  , "narrator": "ガブリエラ", "text": "思いたくないけど"},
        { "location": "247/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "248/TALK"  , "narrator": "ガブリエラ", "text": "話したからかしら？\n気持ちがスッキリした\nような気がする…。"},
        { "location": "249/TALK"  , "narrator": "ガブリエラ", "text": "…でもやっぱり、\nちょっと寂しいな…。"},
        { "location": "252/SEL"   , "narrator": "（選択肢）", "text": "実際好きだったでしょ？"},
        { "location": "253/ACT"   , "narrator": "", "text": "実際好きだったでしょ？"},
        { "location": "256/TALK"  , "narrator": "ガブリエラ", "text": "確かに"},
        { "location": "257/TALK"  , "narrator": "ガブリエラ", "text": "ヒカルくんのこと好きだって"},
        { "location": "258/TALK"  , "narrator": "ガブリエラ", "text": "そんな気持ちになってた"},
        { "location": "259/TALK"  , "narrator": "ガブリエラ", "text": "それは事実よ"},
        { "location": "260/TALK"  , "narrator": "ガブリエラ", "text": "ヒカルくんは素敵でかっこよくて優しいから"},
        { "location": "261/TALK"  , "narrator": "ガブリエラ", "text": "いいなって思ってた"},
        { "location": "262/TALK"  , "narrator": "ガブリエラ", "text": "けど"},
        { "location": "265/TALK"  , "narrator": "ガブリエラ", "text": "気づいたの"},
        { "location": "266/TALK"  , "narrator": "ガブリエラ", "text": "あの時の私の気持ちは"},
        { "location": "267/TALK"  , "narrator": "ガブリエラ", "text": "恋愛感情じゃないって"},
        { "location": "268/TALK"  , "narrator": "ガブリエラ", "text": "好きって気持ちじゃなくて"},
