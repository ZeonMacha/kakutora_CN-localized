{
    "dir": "chap24/daydra/dd_ch05_24_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "24505",
        "cid": "kagura",
        "title": "005 メインストーリー",
        "sub_title": "再交渉＜後編＞"
    },
    "entry":
    [
        { "location": "3478/TALK"  , "narrator": "千羽鶴", "text": "結局、\n何故こんなところに…？"},
        { "location": "3479/SEL"   , "narrator": "", "text": "慰安と言えば温泉でしょ！"},
        { "location": "3480/SEL"   , "narrator": "", "text": "次のフェノメノンはここで発生すると見たのだ！"},
        { "location": "3481/ACT"   , "narrator": "", "text": "慰安と言えば温泉でしょ！"},
        { "location": "3490/TALK"  , "narrator": "千羽鶴", "text": "そもそも実地調査という話だったはず"},
        { "location": "3491/TALK"  , "narrator": "千羽鶴", "text": "このログを見られたらちーは懲戒免職確定"},
        { "location": "3493/TALK"  , "narrator": "千羽鶴", "text": "その時は$handle$に責任とってもらうことにする"},
        { "location": "3495/SEL"   , "narrator": "", "text": "違うんだ！次はこの駒込の温泉で発症する気がするから仕方ないんだ！"},
        { "location": "3496/SEL"   , "narrator": "", "text": "自発的にリークしておきます"},
        { "location": "3497/ACT"   , "narrator": "", "text": "違うんだ！次はこの駒込の温泉で発症する気がするから仕方ないんだ！"},
        { "location": "3499/TALK"  , "narrator": "千羽鶴", "text": "なんだか無理矢理ごまかされてる気がするけど"},
        { "location": "3500/TALK"  , "narrator": "千羽鶴", "text": "温泉の香りに包まれているとそんな気持ちになってくるから不思議"},
        { "location": "3501/ACT"   , "narrator": "", "text": "自発的にリークしておきます"},
        { "location": "3502/TALK"  , "narrator": "千羽鶴", "text": "やったら絶交だから"},
        { "location": "3504/TALK"  , "narrator": "千羽鶴", "text": "でも絶交したら責任とってもらえない"},
        { "location": "3506/TALK"  , "narrator": "千羽鶴", "text": "これは難しい問題"},
        { "location": "3508/ACT"   , "narrator": "", "text": "次のフェノメノンはここで発生すると見たのだ！"},
        { "location": "3517/TALK"  , "narrator": "千羽鶴", "text": "誰が聞いても嘘としか思えないけど開き直るよりマシなような気がする"},
        { "location": "3518/TALK"  , "narrator": "千羽鶴", "text": "世の中シラを切ったもの勝ちだし"},
        { "location": "3520/SEL"   , "narrator": "", "text": "世知辛すぎ"},
        { "location": "3521/ACT"   , "narrator": "", "text": "世知辛すぎ"},
        { "location": "3523/TALK"  , "narrator": "千羽鶴", "text": "ザ・政治の世界ね"},
        { "location": "3526/SEL"   , "narrator": "", "text": "温泉入ろうよ"},
        { "location": "3527/ACT"   , "narrator": "", "text": "温泉入ろうよ"},
        { "location": "3529/TALK"  , "narrator": "千羽鶴", "text": "それもいいけど、ちーは足湯で十分"},
        { "location": "3530/TALK"  , "narrator": "千羽鶴", "text": "足湯はとても健康にいいから、$handle$も習慣化するといい"},
        { "location": "3533/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "3534/TALK"  , "narrator": "千羽鶴", "text": "落ち着く。"},
        { "location": "3535/TALK"  , "narrator": "千羽鶴", "text": "そういえば、\nこんなにマッタリしたのは\n初めてかもしれない。"},
        { "location": "3536/TALK"  , "narrator": "千羽鶴", "text": "足湯も、\n桶でやるのとは全然違う。"},
        { "location": "3537/TALK"  , "narrator": "千羽鶴", "text": "やっぱり――"},
        { "location": "3538/TALK"  , "narrator": "千羽鶴", "text": "もう少し精神的なゆとりを\n持たなければならないか。"},
        { "location": "3539/TALK"  , "narrator": "千羽鶴", "text": "けど。\n今の状況では\nそれも無理。"},
        { "location": "3540/TALK"  , "narrator": "千羽鶴", "text": "もう少しまともな\n進行であれば、\nあるいは……。"},
        { "location": "3542/SEL"   , "narrator": "", "text": "気分転換に、近くのアミューズメントパークに行かない？"},
        { "location": "3543/SEL"   , "narrator": "", "text": "愚痴とか聞くよ？"},
        { "location": "3544/ACT"   , "narrator": "", "text": "気分転換に、近くのアミューズメントパークに行かない？"},
        { "location": "3553/TALK"  , "narrator": "千羽鶴", "text": "それこそ職務怠慢"},
        { "location": "3555/SEL"   , "narrator": "", "text": "アミューズメント施設は無防備にネットを使う機械が多い、とてもけしからん場所"},
        { "location": "3556/ACT"   , "narrator": "", "text": "アミューズメント施設は無防備にネットを使う機械が多い、とてもけしからん場所"},
        { "location": "3560/TALK"  , "narrator": "千羽鶴", "text": "なるほど"},
        { "location": "3561/TALK"  , "narrator": "千羽鶴", "text": "それなら仕方ない"},
        { "location": "3564/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "3565/TALK"  , "narrator": "千羽鶴", "text": "仕方ない。"},
        { "location": "3573/TALK"  , "narrator": "千羽鶴", "text": "後もう少し！\nひっかかる――"},
        { "location": "3574/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "3575/TALK"  , "narrator": "千羽鶴", "text": "あ……\n落ちた。"},
        { "location": "3576/TALK"  , "narrator": "千羽鶴", "text": "難しい。"},
        { "location": "3577/SEL"   , "narrator": "", "text": "自分の世界なんだから自分で願えばとれるのでは？"},
        { "location": "3578/ACT"   , "narrator": "", "text": "自分の世界なんだから自分で願えばとれるのでは？"},
        { "location": "3588/TALK"  , "narrator": "千羽鶴", "text": "それじゃつまらない"},
        { "location": "3589/TALK"  , "narrator": "千羽鶴", "text": "ゲームは先が読めないから面白いのであって"},
        { "location": "3590/TALK"  , "narrator": "千羽鶴", "text": "１００％とれるものはゲームではない"},
        { "location": "3591/TALK"  , "narrator": "千羽鶴", "text": "よって面白くも何ともない"},
        { "location": "3594/TALK"  , "narrator": "千羽鶴", "text": "それに"},
        { "location": "3595/TALK"  , "narrator": "千羽鶴", "text": "貴方にとってもらったり甘えたりする喜びも感じることができない！"},
        { "location": "3597/SEL"   , "narrator": "", "text": "とる？"},
        { "location": "3598/ACT"   , "narrator": "", "text": "とる？"},
        { "location": "3600/TALK"  , "narrator": "千羽鶴", "text": "とる"},
        { "location": "3602/TALK"  , "narrator": "千羽鶴", "text": "右端にあるくまさん"},
        { "location": "3603/TALK"  , "narrator": "千羽鶴", "text": "とって"},
        { "location": "3605/SEL"   , "narrator": "", "text": "機器操作：レバー"},
        { "location": "3606/ACT"   , "narrator": "", "text": "機器操作：レバー"},
        { "location": "3619/TALK"  , "narrator": "千羽鶴", "text": "すごい！\nとれた！！"},
        { "location": "3620/SEL"   , "narrator": "", "text": "よかったね"},
        { "location": "3621/ACT"   , "narrator": "", "text": "よかったね"},
        { "location": "3631/TALK"  , "narrator": "千羽鶴", "text": "いっぱいとってもらった"},
        { "location": "3633/SEL"   , "narrator": "", "text": "もしかして、世界の情報改ざんした？"},
        { "location": "3634/ACT"   , "narrator": "", "text": "もしかして、世界の情報改ざんした？"},
        { "location": "3636/TALK"  , "narrator": "千羽鶴", "text": "まさか"},
        { "location": "3638/TALK"  , "narrator": "千羽鶴", "text": "$handle$がちーのことを想ってとったから成功したんだとおもう"},
        { "location": "3639/TALK"  , "narrator": "千羽鶴", "text": "ありがと"},
        { "location": "3640/TALK"  , "narrator": "千羽鶴", "text": "あと"},
        { "location": "3642/TALK"  , "narrator": "千羽鶴", "text": "好き"},
        { "location": "3644/SEL"   , "narrator": "", "text": "$me$もちーのこと好きだよ"},
        { "location": "3645/ACT"   , "narrator": "", "text": "$me$もちーのこと好きだよ"},
        { "location": "3647/TALK"  , "narrator": "千羽鶴", "text": "むー"},
        { "location": "3648/TALK"  , "narrator": "千羽鶴", "text": "どーんしたい"},
        { "location": "3650/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "3651/TALK"  , "narrator": "千羽鶴", "text": "貴方はとてもいい人"},
        { "location": "3652/TALK"  , "narrator": "千羽鶴", "text": "だから、悲しませたくない"},
        { "location": "3654/SEL"   , "narrator": "", "text": "悲しんだりしないよ"},
        { "location": "3655/ACT"   , "narrator": "", "text": "悲しんだりしないよ"},
        { "location": "3657/TALK"  , "narrator": "千羽鶴", "text": "そうでもない、実は悲しむ未来が来る確率はさほど低くない"},
        { "location": "3658/TALK"  , "narrator": "千羽鶴", "text": "だってちーはクランであって、総意である人間じゃないもの"},
        { "location": "3659/TALK"  , "narrator": "千羽鶴", "text": "だから総意である逢瀬つばめが私を否定した場合、私は取り込まれて考えを是正されたり、消去されたりするかも"},
        { "location": "3660/TALK"  , "narrator": "千羽鶴", "text": "貴方が本当に未来から来たなら、他の子でそんな事例も見ているはず"},
        { "location": "3663/TALK"  , "narrator": "千羽鶴", "text": "だから、もしちーがちーじゃなくなったとき、貴方がそれを悲しむなら、逢瀬つばめのココロアドレス0x001に迎えに来て"},
        { "location": "3664/TALK"  , "narrator": "千羽鶴", "text": "そこには私が生まれる所以となった、私の誕生にまつわる記憶がある"},
        { "location": "3665/TALK"  , "narrator": "千羽鶴", "text": "そこで貴方は、私と再会することができる"},
        { "location": "3667/SEL"   , "narrator": "", "text": "それって、言っていいことなの？"},
        { "location": "3668/ACT"   , "narrator": "", "text": "それって、言っていいことなの？"},
        { "location": "3671/TALK"  , "narrator": "千羽鶴", "text": "クランの心臓を渡すのと同じくらいの行為"},
        { "location": "3673/TALK"  , "narrator": "千羽鶴", "text": "だから、他の誰にも絶対に喋ったらダメだから"},
        { "location": "3675/SEL"   , "narrator": "", "text": "もちろんだよ"},
        { "location": "3676/ACT"   , "narrator": "", "text": "もちろんだよ"},
        { "location": "3678/TALK"  , "narrator": "千羽鶴", "text": "ありがと"},
        { "location": "3679/TALK"  , "narrator": "千羽鶴", "text": "なんかスッキリした"},
        { "location": "3682/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "3684/TALK"  , "narrator": "千羽鶴", "text": "なんだろ。\nこんな感覚\n初めてだけど。"},
        { "location": "3685/TALK"  , "narrator": "千羽鶴", "text": "すごく元気になった\n気がする！"},
        { "location": "3686/TALK"  , "narrator": "千羽鶴", "text": "ここから正念場だけど、\nこれなら頑張れそう。"},
        { "location": "3687/TALK"  , "narrator": "千羽鶴", "text": "どーん！"},
        { "location": "3688/ACT"   , "narrator": "", "text": "愚痴とか聞くよ？"},
        { "location": "3697/TALK"  , "narrator": "千羽鶴", "text": "ありがと"},
        { "location": "3698/TALK"  , "narrator": "千羽鶴", "text": "でも困ったことにWAVEはログが残るから、そういうのはできない"},
        { "location": "3699/TALK"  , "narrator": "千羽鶴", "text": "きっと遠くない未来にまずいご飯を食べてる気がする"},
        { "location": "3701/SEL"   , "narrator": "", "text": "あれ？でも千羽鶴と$me$は直接会話が出来たはずだけど……"},
        { "location": "3702/ACT"   , "narrator": "", "text": "あれ？でも千羽鶴と$me$は直接会話が出来たはずだけど……"},
        { "location": "3704/TALK"  , "narrator": "千羽鶴", "text": "え？"},
        { "location": "3709/TALK"  , "narrator": "千羽鶴", "text": "じゃあ、ちょっと\n話してみて。"},
        { "location": "3710/SEL"   , "narrator": "", "text": "てすとてすと"},
        { "location": "3711/ACT"   , "narrator": "", "text": "てすとてすと"},
        { "location": "3713/TALK"  , "narrator": "千羽鶴", "text": "ほんと！\n現実でもできる！"},
        { "location": "3714/TALK"  , "narrator": "千羽鶴", "text": "もしかして、これは\nおいおい使えるかも……。"},
        { "location": "3715/SEL"   , "narrator": "", "text": "心の声も聞こえてますよ"},
        { "location": "3716/ACT"   , "narrator": "", "text": "心の声も聞こえてますよ"},
        { "location": "3718/TALK"  , "narrator": "千羽鶴", "text": "あ、それもか。"},
        { "location": "3719/TALK"  , "narrator": "千羽鶴", "text": "でもそれなら、\nそれを逆手にとって――"},
        { "location": "3720/TALK"  , "narrator": "千羽鶴", "text": "ちーがこうやって\n心の声で喋れば、\n尚いいかも。"},
        { "location": "3721/TALK"  , "narrator": "千羽鶴", "text": "温泉で一人ブツブツ\n言ってる変な子にも\nならないし――"},
        { "location": "3722/TALK"  , "narrator": "千羽鶴", "text": "WAVEのログにも\n残らない！"},
        { "location": "3723/TALK"  , "narrator": "千羽鶴", "text": "ちーは頭がいい！"},
        { "location": "3724/SEL"   , "narrator": "", "text": "さすがちー！"},
        { "location": "3725/SEL"   , "narrator": "", "text": "遠慮なく愚痴っていいんだよ？"},
        { "location": "3726/ACT"   , "narrator": "", "text": "さすがちー！"},
        { "location": "3727/TALK"  , "narrator": "千羽鶴", "text": "うむ！"},
        { "location": "3728/ACT"   , "narrator": "", "text": "遠慮なく愚痴っていいんだよ？"},
        { "location": "3729/TALK"  , "narrator": "千羽鶴", "text": "それじゃ遠慮なく。"},
        { "location": "3731/TALK"  , "narrator": "千羽鶴", "text": "とりあえず今の\n情報管理庁は\n構造改革が必要。"},
        { "location": "3732/TALK"  , "narrator": "千羽鶴", "text": "本当に効率が悪いし、\n人手もかかりすぎる。"},
        { "location": "3733/TALK"  , "narrator": "千羽鶴", "text": "特に通常攻撃隊は\n四角ダルマを始めとする\n全人事改変が必要！"},
        { "location": "3734/SEL"   , "narrator": "", "text": "大きく出たね"},
        { "location": "3735/ACT"   , "narrator": "", "text": "大きく出たね"},
        { "location": "3737/TALK"  , "narrator": "千羽鶴", "text": "そうね。"},
        { "location": "3738/TALK"  , "narrator": "千羽鶴", "text": "ここから先、\n彼らの任務は、\n今までとは全く変わる。"},
        { "location": "3739/TALK"  , "narrator": "千羽鶴", "text": "今までが\nディフェンシヴ\nミッションならば――"},
        { "location": "3740/TALK"  , "narrator": "千羽鶴", "text": "ここからは\nオフェンシヴ\nミッションになる。"},
        { "location": "3741/SEL"   , "narrator": "", "text": "襲撃するの？"},
        { "location": "3742/ACT"   , "narrator": "", "text": "襲撃するの？"},
        { "location": "3744/TALK"  , "narrator": "千羽鶴", "text": "まあ、ちょっとした\n作戦をかけねばならない。"},
        { "location": "3745/TALK"  , "narrator": "千羽鶴", "text": "ただ、正直言うと、\n絶対やりたくなかった。"},
        { "location": "3746/TALK"  , "narrator": "千羽鶴", "text": "けど、こうしないと\nこの日本が崩壊する\n所まで来てしまった。"},
        { "location": "3747/TALK"  , "narrator": "千羽鶴", "text": "ちーは頑張ったけど、\nだめだった。"},
        { "location": "3748/TALK"  , "narrator": "千羽鶴", "text": "世の中そういうことも\nあるのはわかってる。"},
        { "location": "3749/TALK"  , "narrator": "千羽鶴", "text": "けど……。"},
        { "location": "3750/TALK"  , "narrator": "千羽鶴", "text": "頑張っても\n結果が伴わないのって\nどうしたって凹む。"},
        { "location": "3751/TALK"  , "narrator": "千羽鶴", "text": "つらい……。"},
        { "location": "3752/SEL"   , "narrator": "", "text": "$me$が一緒にいるよ"},
        { "location": "3753/SEL"   , "narrator": "", "text": "ごめんね……"},
        { "location": "3754/ACT"   , "narrator": "", "text": "$me$が一緒にいるよ"},
        { "location": "3755/TALK"  , "narrator": "千羽鶴", "text": "そこは\n唯一の救いだと思ってる。"},
        { "location": "3756/ACT"   , "narrator": "", "text": "ごめんね……"},
        { "location": "3757/TALK"  , "narrator": "千羽鶴", "text": "どうして謝るの？"},
        { "location": "3758/SEL"   , "narrator": "", "text": "$me$が千羽鶴の邪魔をしてしまった"},
        { "location": "3759/SEL"   , "narrator": "", "text": "$me$がもっと力があれば"},
        { "location": "3760/ACT"   , "narrator": "", "text": "$me$が千羽鶴の邪魔をしてしまった"},
        { "location": "3761/TALK"  , "narrator": "千羽鶴", "text": "貴方は私の邪魔を\nしたりなんかしていない。"},
        { "location": "3762/TALK"  , "narrator": "千羽鶴", "text": "どうしてそんなこと\n思うのか不思議。"},
        { "location": "3763/ACT"   , "narrator": "", "text": "$me$がもっと力があれば"},
        { "location": "3764/TALK"  , "narrator": "千羽鶴", "text": "貴方の力は\n素晴らしい。"},
        { "location": "3765/TALK"  , "narrator": "千羽鶴", "text": "だから、そこは\n気にするところじゃない。"},
        { "location": "3768/TALK"  , "narrator": "千羽鶴", "text": "貴方にはいっぱい\n助けられてる。"},
        { "location": "3769/TALK"  , "narrator": "千羽鶴", "text": "今も、私に\nいっぱい元気と勇気を\n与えてくれてる。"},
        { "location": "3771/TALK"  , "narrator": "千羽鶴", "text": "だから……"},
        { "location": "3772/TALK"  , "narrator": "千羽鶴", "text": "ありがと。"},
        { "location": "3773/SEL"   , "narrator": "", "text": "そういってもらえたら嬉しいよ"},
        { "location": "3774/SEL"   , "narrator": "", "text": "ちーのこと愛してるから"},
        { "location": "3775/ACT"   , "narrator": "", "text": "そういってもらえたら嬉しいよ"},
        { "location": "3776/ACT"   , "narrator": "", "text": "ちーのこと愛してるから"},
        { "location": "3779/TALK"  , "narrator": "千羽鶴", "text": "<size=50>どーん！！</size>"},
        { "location": "3782/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "3783/TALK"  , "narrator": "千羽鶴", "text": "貴方はとてもいい人。"},
        { "location": "3784/TALK"  , "narrator": "千羽鶴", "text": "だから、\n悲しませたくない。"},
        { "location": "3785/SEL"   , "narrator": "", "text": "悲しんだりしないよ"},
        { "location": "3786/ACT"   , "narrator": "", "text": "悲しんだりしないよ"},
        { "location": "3788/TALK"  , "narrator": "千羽鶴", "text": "そうでもない。\n悲しむ未来が来る確率は\nさほど低くない。"},
        { "location": "3789/TALK"  , "narrator": "千羽鶴", "text": "私はクランであって、\n総意である\n人間じゃないから。"},
        { "location": "3790/TALK"  , "narrator": "千羽鶴", "text": "だから、\n総意である逢瀬つばめが\n私を否定した場合――"},
        { "location": "3791/TALK"  , "narrator": "千羽鶴", "text": "私は簡単に取り込まれて\n考えを是正されるか、\n消去されるかもしれない。"},
        { "location": "3792/TALK"  , "narrator": "千羽鶴", "text": "貴方が本当に未来から\n来たなら、他の子でそんな\n事例も見ているはず。"},
        { "location": "3794/TALK"  , "narrator": "千羽鶴", "text": "だから、もし私が\n私じゃなくなったとき、\n貴方がそれを悲しむなら、"},
        { "location": "3795/TALK"  , "narrator": "千羽鶴", "text": "逢瀬つばめの\nココロアドレス\n0x001に迎えに来て。"},
        { "location": "3796/TALK"  , "narrator": "千羽鶴", "text": "そこには私が生まれる\n所以となった、私の誕生に\nまつわる記憶がある。"},
        { "location": "3797/TALK"  , "narrator": "千羽鶴", "text": "そこで貴方は、\n私と再会することが\nできる。"},
        { "location": "3798/SEL"   , "narrator": "", "text": "それって、言っていいことなの？"},
        { "location": "3799/ACT"   , "narrator": "", "text": "それって、言っていいことなの？"},
        { "location": "3802/TALK"  , "narrator": "千羽鶴", "text": "クランの心臓を\n渡すのと\n同じくらいの行為。"},
        { "location": "3804/TALK"  , "narrator": "千羽鶴", "text": "だから、\n他の誰にも絶対に\n喋ったらダメだから。"},
        { "location": "3805/SEL"   , "narrator": "", "text": "千羽鶴…"},
        { "location": "3806/ACT"   , "narrator": "", "text": "千羽鶴…"},
        { "location": "3809/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "3812/TALK"  , "narrator": "千羽鶴", "text": "あっ。"},
        { "location": "3813/TALK"  , "narrator": "千羽鶴", "text": "そういえばもう一つ、\n愚痴りたいことがあった。"},
        { "location": "3814/SEL"   , "narrator": "", "text": "なに！？"},
        { "location": "3815/ACT"   , "narrator": "", "text": "なに！？"},
        { "location": "3817/TALK"  , "narrator": "千羽鶴", "text": "管理庁の食堂で出る\nデザートは美味しすぎる。"},
        { "location": "3818/TALK"  , "narrator": "千羽鶴", "text": "もっとグレードを\n落とさないとダメね。"},
        { "location": "3819/SEL"   , "narrator": "", "text": "なんで？"},
        { "location": "3820/ACT"   , "narrator": "", "text": "なんで？"},
        { "location": "3822/TALK"  , "narrator": "千羽鶴", "text": "……肥るから。"},
        { "location": "3823/TALK"  , "narrator": "千羽鶴", "text": "でぶーん千羽鶴になったら\n貴方に逃げられるかも。"},
        { "location": "3824/TALK"  , "narrator": "千羽鶴", "text": "だから食堂に言って、\n明日からカッププリン\nだけにしてもらう。"},
        { "location": "3827/TALK"  , "narrator": "千羽鶴", "text": "<size=50>どーん！！</size>"},
        { "location": "3862/SEL"   , "narrator": "", "text": "千羽鶴はつばめのクランではないとシラを切った"},
        { "location": "3863/ACT"   , "narrator": "", "text": "千羽鶴はつばめのクランではないとシラを切った"},
        { "location": "3866/SEL"   , "narrator": "", "text": "千羽鶴は自分が管理庁長官ではなくエージェントであると嘘をついていた"},
        { "location": "3867/ACT"   , "narrator": "", "text": "千羽鶴は自分が管理庁長官ではなくエージェントであると嘘をついていた"},
        { "location": "3869/TALK"  , "narrator": "神楽", "text": "そうですね"},
        { "location": "3872/SEL"   , "narrator": "", "text": "契約した当日から既に、違反していたってことだ"},
        { "location": "3873/ACT"   , "narrator": "", "text": "契約した当日から既に、違反していたってことだ"},
        { "location": "3876/TALK"  , "narrator": "神楽", "text": "それはわかってる"},
        { "location": "3879/TALK"  , "narrator": "神楽", "text": "けど"},
        { "location": "3880/TALK"  , "narrator": "神楽", "text": "だからどうすればいいか"},
        { "location": "3882/SEL"   , "narrator": "", "text": "とりあえず、契約違反したことを伝えよう"},
        { "location": "3883/ACT"   , "narrator": "", "text": "とりあえず、契約違反したことを伝えよう"},
        { "location": "3885/TALK"  , "narrator": "神楽", "text": "その後は？"},
        { "location": "3887/SEL"   , "narrator": "", "text": "頷くようなら、都度$me$から回答を出すから、その通りに言って"},
        { "location": "3888/ACT"   , "narrator": "", "text": "頷くようなら、都度$me$から回答を出すから、その通りに言って"},
        { "location": "3890/TALK"  , "narrator": "神楽", "text": "簡単に言いますけど"},
        { "location": "3891/TALK"  , "narrator": "神楽", "text": "一々画面見てたら"},
        { "location": "3893/TALK"  , "narrator": "神楽", "text": "私の言葉じゃないってバレバレのような・・・"},
        { "location": "3895/SEL"   , "narrator": "", "text": "直接心の中にイメージを送るから平気"},
        { "location": "3896/ACT"   , "narrator": "", "text": "直接心の中にイメージを送るから平気"},
        { "location": "3898/TALK"  , "narrator": "神楽", "text": "心の中にイメージを！？"},
        { "location": "3899/TALK"  , "narrator": "神楽", "text": "それってライフぎゃざー"},
        { "location": "3902/TALK"  , "narrator": "神楽", "text": "いえ"},
        { "location": "3903/TALK"  , "narrator": "神楽", "text": "なんでもありません"},
        { "location": "3914/TALK"  , "narrator": "神楽", "text": "…本当に\n大丈夫なのかしら？"},
        { "location": "3916/TALK"  , "narrator": "神楽", "text": "…あの、私が契約を\n違反したと\n言いましたよね？"},
        { "location": "3918/TALK"  , "narrator": "千羽鶴", "text": "ええ…事実。"},
        { "location": "3919/TALK"  , "narrator": "神楽", "text": "だとしたら、\n貴方はもっと前に\n違反してますよね？"},
        { "location": "3922/TALK"  , "narrator": "神楽", "text": "知ってるんですよ？\nあなたが人間では\nなくて…。"},
        { "location": "3923/TALK"  , "narrator": "神楽", "text": "つばめさんの、\nセルフクランだと\nいうことを。"},
        { "location": "3926/TALK"  , "narrator": "神楽", "text": "あなたは管理庁の\nエージェントでは\nなくて…。"},
        { "location": "3927/TALK"  , "narrator": "神楽", "text": "本当は、情報管理庁の\n長官ですよね？"},
        { "location": "3930/TALK"  , "narrator": "神楽", "text": "ウソをつかない…。\nこれは契約時の\n条件でしたよね？"},
        { "location": "3931/TALK"  , "narrator": "神楽", "text": "なので、そもそも\n契約自体が\n既に無効なんです。"},
        { "location": "3932/TALK"  , "narrator": "神楽", "text": "まあ、百歩譲って\n私がつばめさんを\nあの短時間の間に…。"},
        { "location": "3933/TALK"  , "narrator": "神楽", "text": "破壊しなかったことが\n契約違反であると\nしても。"},
        { "location": "3934/TALK"  , "narrator": "神楽", "text": "それより前に、\n契約は反故にされて\nいたんです。"},
        { "location": "3935/TALK"  , "narrator": "神楽", "text": "貴方の手によってね。"},
        { "location": "3936/TALK"  , "narrator": "千羽鶴", "text": "…………。"},
        { "location": "3937/TALK"  , "narrator": "神楽", "text": "どうですか？"},
        { "location": "3939/TALK"  , "narrator": "千羽鶴", "text": "…確証は？"},
        { "location": "3940/TALK"  , "narrator": "千羽鶴", "text": "私が、逢瀬つばめの\nセルフクランだと\nいうのなら…。"},
        { "location": "3941/TALK"  , "narrator": "千羽鶴", "text": "それを決定づける\n裏付けは？"},
        { "location": "3942/TALK"  , "narrator": "神楽", "text": "そ、それは…。"},
        { "location": "3943/TALK"  , "narrator": "神楽", "text": "…どうしよう。"},
        { "location": "3944/SEL"   , "narrator": "", "text": "今はありません"},
        { "location": "3945/ACT"   , "narrator": "", "text": "今はありません"},
        { "location": "3954/TALK"  , "narrator": "神楽", "text": "――ッ！？"},
        { "location": "3955/TALK"  , "narrator": "神楽", "text": "なに、今の…。\n心の中にイメージって\nこれのこと？"},
        { "location": "3956/TALK"  , "narrator": "千羽鶴", "text": "…裏付けは？"},
        { "location": "3957/TALK"  , "narrator": "神楽", "text": "い、今はありません。"},
        { "location": "3958/TALK"  , "narrator": "千羽鶴", "text": "裏付けもないのに、\n私が逢瀬つばめの\nセルフクランだと？"},
        { "location": "3959/SEL"   , "narrator": "", "text": "それでも尚、裏付けが必要ならば"},
        { "location": "3960/ACT"   , "narrator": "", "text": "それでも尚、裏付けが必要ならば"},
        { "location": "3963/TALK"  , "narrator": "神楽", "text": "それでも尚、\n裏付けが\n必要ならば…。"},
        { "location": "3964/SEL"   , "narrator": "", "text": "ウソだと証明された時に倍返しするという契約に再契約するのも有りですが？"},
        { "location": "3965/ACT"   , "narrator": "", "text": "ウソだと証明された時に倍返しするという契約に再契約するのも有りですが？"},
        { "location": "3968/TALK"  , "narrator": "神楽", "text": "ウソだと\n証明された時に…。"},
        { "location": "3969/TALK"  , "narrator": "神楽", "text": "倍返しするという\n契約に再契約するのも\n有りですが？"},
        { "location": "3971/TALK"  , "narrator": "千羽鶴", "text": "…東雲隊長あたりから\n聞いたのね。"},
        { "location": "3972/TALK"  , "narrator": "千羽鶴", "text": "正直、その点について\nツッコまれるとは\n思わなかった…。"},
        { "location": "3973/TALK"  , "narrator": "神楽", "text": "…契約違反ですね。"},
        { "location": "3974/TALK"  , "narrator": "千羽鶴", "text": "貴方のいうとおり\n書面通りに捉えれば、\nそういうことになる。"},
        { "location": "3975/TALK"  , "narrator": "千羽鶴", "text": "けれども実際は、\n貴方は私の力が必要。"},
        { "location": "3976/TALK"  , "narrator": "千羽鶴", "text": "母を元に戻すために、\n私の力は絶対に\n必要なはず…・。"},
        { "location": "3977/TALK"  , "narrator": "千羽鶴", "text": "だから、契約を\n破棄して困るのは…。"},
        { "location": "3978/TALK"  , "narrator": "千羽鶴", "text": "卯月神楽、\n貴方の方でしょう？"},
        { "location": "3979/TALK"  , "narrator": "神楽", "text": "そ、それは…。"},
        { "location": "3980/TALK"  , "narrator": "神楽", "text": "…どうしよう。"},
        { "location": "3981/SEL"   , "narrator": "", "text": "困るのは貴方も同じですよね"},
        { "location": "3982/ACT"   , "narrator": "", "text": "困るのは貴方も同じですよね"},
        { "location": "3991/TALK"  , "narrator": "神楽", "text": "――ッ！？"},
        { "location": "3992/TALK"  , "narrator": "神楽", "text": "なに、今の…。\n心の中にイメージって\nこれのこと？"},
        { "location": "3993/TALK"  , "narrator": "千羽鶴", "text": "…図星のようね。"},
        { "location": "3994/TALK"  , "narrator": "神楽", "text": "…困るのはあなたも\n同じですよね？"},
        { "location": "3996/TALK"  , "narrator": "千羽鶴", "text": "…………。"},
        { "location": "3997/SEL"   , "narrator": "", "text": "どちらにせよ、貴方は私が動かなければ困る"},
        { "location": "3998/ACT"   , "narrator": "", "text": "どちらにせよ、貴方は私が動かなければ困る"},
        { "location": "4002/TALK"  , "narrator": "神楽", "text": "どちらにせよ、\nあなたは私が動かな\nければ困る。"},
        { "location": "4003/SEL"   , "narrator": "", "text": "私も母を人質に取られているようなものですが"},
        { "location": "4004/ACT"   , "narrator": "", "text": "私も母を人質に取られているようなものですが"},
        { "location": "4007/TALK"  , "narrator": "神楽", "text": "私も母を人質に\n取られているような\nものですが…。"},
        { "location": "4008/SEL"   , "narrator": "", "text": "それは最悪、彼らであっても"},
        { "location": "4009/ACT"   , "narrator": "", "text": "それは最悪、彼らであっても"},
        { "location": "4012/TALK"  , "narrator": "神楽", "text": "それは最悪、\n彼らであっても。"},
        { "location": "4013/SEL"   , "narrator": "", "text": "果ては第三者であっても"},
        { "location": "4014/ACT"   , "narrator": "", "text": "果ては第三者であっても"},
        { "location": "4017/TALK"  , "narrator": "神楽", "text": "果ては第三者で\nあっても…。"},
        { "location": "4018/SEL"   , "narrator": "", "text": "技術的要件を満たせば対処は可能なんです"},
        { "location": "4019/ACT"   , "narrator": "", "text": "技術的要件を満たせば対処は可能なんです"},
        { "location": "4022/TALK"  , "narrator": "神楽", "text": "技術的要件を満たせば\n対処は可能なんです。"},
        { "location": "4024/TALK"  , "narrator": "千羽鶴", "text": "えっ！？"},
        { "location": "4025/SEL"   , "narrator": "", "text": "わかりますか？貴方が私に望むものは、オンリーワンであり"},
        { "location": "4026/ACT"   , "narrator": "", "text": "わかりますか？貴方が私に望むものは、オンリーワンであり"},
        { "location": "4029/TALK"  , "narrator": "神楽", "text": "わかりますか？"},
        { "location": "4030/TALK"  , "narrator": "神楽", "text": "あなたが私に\n望むものは\nオンリーワンであり。"},
        { "location": "4031/SEL"   , "narrator": "", "text": "私が貴方に望む物は、より技術的で普遍的なもの"},
        { "location": "4032/ACT"   , "narrator": "", "text": "私が貴方に望む物は、より技術的で普遍的なもの"},
        { "location": "4035/TALK"  , "narrator": "神楽", "text": "私があなたに\n望むモノは…。"},
        { "location": "4036/TALK"  , "narrator": "神楽", "text": "より技術的で\n普遍的な物なのです。"},
        { "location": "4037/SEL"   , "narrator": "", "text": "私には代替する解決策がある"},
        { "location": "4038/ACT"   , "narrator": "", "text": "私には代替する解決策がある"},
        { "location": "4041/TALK"  , "narrator": "神楽", "text": "私には代替する\n解決策がある。"},
        { "location": "4042/SEL"   , "narrator": "", "text": "よって、契約が無効となった今、"},
        { "location": "4043/ACT"   , "narrator": "", "text": "よって、契約が無効となった今、"},
        { "location": "4046/TALK"  , "narrator": "神楽", "text": "よって、契約が\n無効となった今…。"},
        { "location": "4047/SEL"   , "narrator": "", "text": "私の方が立場は強いことになります"},
        { "location": "4048/ACT"   , "narrator": "", "text": "私の方が立場は強いことになります"},
        { "location": "4051/TALK"  , "narrator": "神楽", "text": "私の方が立場は\n強いことになります。"},
        { "location": "4053/TALK"  , "narrator": "神楽", "text": "…えっ！？"},
        { "location": "4054/TALK"  , "narrator": "神楽", "text": "対処可能？\n技術的要件を\n満たせばって…。"},
        { "location": "4055/TALK"  , "narrator": "神楽", "text": "…本当なの？\n千羽鶴でも、\n彼らでもない人が――"},
        { "location": "4056/TALK"  , "narrator": "神楽", "text": "母を直せるなんて…。\nそんなこと、\n本当にできるの？"},
        { "location": "4057/SEL"   , "narrator": "", "text": "神楽、信じて！"},
        { "location": "4058/ACT"   , "narrator": "", "text": "神楽、信じて！"},
        { "location": "4061/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "4062/TALK"  , "narrator": "神楽", "text": "わかりました。\n覚悟を決めます。"},
        { "location": "4063/TALK"  , "narrator": "神楽", "text": "乗りかかった船だし、\nもう破れかぶれです！"},
        { "location": "4064/TALK"  , "narrator": "神楽", "text": "あとは、私が\n押し通します！"},
        { "location": "4065/TALK"  , "narrator": "神楽", "text": "いえ、正確には\n最初から私の方が\n立場は上でした。"},
        { "location": "4066/TALK"  , "narrator": "神楽", "text": "けど、私もより\nベストな解決を\n目指していました。"},
        { "location": "4067/TALK"  , "narrator": "神楽", "text": "なので、貴方の契約に\n同意したまでです。"},
        { "location": "4068/TALK"  , "narrator": "神楽", "text": "…けど、クオリティを\n問わなければ…。"},
        { "location": "4070/TALK"  , "narrator": "神楽", "text": "私には、他にも\n選択肢があるんです。"},
        { "location": "4071/SEL"   , "narrator": "", "text": "だから千羽鶴、$me$と結婚してください"},
        { "location": "4072/SEL"   , "narrator": "", "text": "私は$handlek$を愛していますから"},
        { "location": "4074/TALK"  , "narrator": "千羽鶴", "text": "…………。"},
        { "location": "4075/TALK"  , "narrator": "千羽鶴", "text": "確かに…。"},
        { "location": "4078/TALK"  , "narrator": "千羽鶴", "text": "貴方の言うことは、\nだいたい正しい。"},
        { "location": "4079/TALK"  , "narrator": "神楽", "text": "…随分と素直に\n認めるんですね。"},
        { "location": "4080/TALK"  , "narrator": "千羽鶴", "text": "事実だから…。"},
        { "location": "4081/TALK"  , "narrator": "千羽鶴", "text": "で？\nそれは誰の入れ知恵？"},
        { "location": "4082/TALK"  , "narrator": "神楽", "text": "そ、そこは関係無い\nでしょう？"},
        { "location": "4083/TALK"  , "narrator": "神楽", "text": "私は自分が納得して\n言ってるんだし。"},
        { "location": "4084/TALK"  , "narrator": "神楽", "text": "あなたも、\n正しいと言った。"},
        { "location": "4085/TALK"  , "narrator": "神楽", "text": "なら、もうこれは\n私達の問題です。"},
        { "location": "4086/TALK"  , "narrator": "千羽鶴", "text": "…………。"},
        { "location": "4087/SEL"   , "narrator": "", "text": "$me$だよ"},
        { "location": "4088/ACT"   , "narrator": "", "text": "$me$だよ"},
        { "location": "4091/ACT"   , "narrator": "", "text": "だから千羽鶴、私と結婚してください"},
        { "location": "4093/TALK"  , "narrator": "神楽", "text": "だから千羽鶴、\n$me$と結婚して\nください…。"},
        { "location": "4097/TALK"  , "narrator": "神楽", "text": "って、えぇっ！？"},
        { "location": "4100/TALK"  , "narrator": "千羽鶴", "text": "…………。"},
        { "location": "4102/TALK"  , "narrator": "神楽", "text": "あ、あのバカ…。\nどういうつもりよ！？"},
        { "location": "4103/TALK"  , "narrator": "千羽鶴", "text": "…やっぱりね。\nそんなことだろうとは\n思ってた。"},
        { "location": "4105/TALK"  , "narrator": "千羽鶴", "text": "手綱を引いてるのは、\n彼の世界の人ね。"},
        { "location": "4106/SEL"   , "narrator": "", "text": "そうだよ"},
        { "location": "4107/ACT"   , "narrator": "", "text": "そうだよ"},
        { "location": "4110/ACT"   , "narrator": "", "text": "私は$handlek$を愛していますから"},
        { "location": "4112/TALK"  , "narrator": "神楽", "text": "私は\n$handlek$を\n愛していますから！"},
        { "location": "4113/TALK"  , "narrator": "千羽鶴", "text": "…………。"},
        { "location": "4115/TALK"  , "narrator": "神楽", "text": "え…は！？"},
        { "location": "4117/TALK"  , "narrator": "神楽", "text": "あ、あのクソバカ！\nなに送ってるんだよ！"},
        { "location": "4118/TALK"  , "narrator": "千羽鶴", "text": "…やっぱりね。\nそんなことだろうとは\n思ってた。"},
        { "location": "4119/TALK"  , "narrator": "千羽鶴", "text": "手綱を引いてるのは、\n彼の世界の人ね。"},
        { "location": "4120/SEL"   , "narrator": "", "text": "そうだよ"},
        { "location": "4121/ACT"   , "narrator": "", "text": "そうだよ"},
        { "location": "4129/TALK"  , "narrator": "神楽", "text": "！？"},
        { "location": "4130/TALK"  , "narrator": "千羽鶴", "text": "…貴方のスマホ、\n貸して。"},
        { "location": "4131/TALK"  , "narrator": "千羽鶴", "text": "私が話したい\nことがある。"},
        { "location": "4133/TALK"  , "narrator": "神楽", "text": "…どうして\nそんな必要が？"},
        { "location": "4134/TALK"  , "narrator": "千羽鶴", "text": "安心して。\n貴方に不利益になる\nようなことはしない。"},
        { "location": "4135/TALK"  , "narrator": "千羽鶴", "text": "それと、ログは全部\n残した状態で返す。"},
        { "location": "4136/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "4137/TALK"  , "narrator": "千羽鶴", "text": "ウソじゃない。\nこれは約束する。"},
        { "location": "4140/TALK"  , "narrator": "神楽", "text": "…わかりました。\n今回は信じます。"},
        { "location": "4142/TALK"  , "narrator": "千羽鶴", "text": "ありがと…。"},
        { "location": "4151/TALK"  , "narrator": "神楽", "text": "また。本当に貴方はどこの$handle$？"},
        { "location": "4153/SEL"   , "narrator": "", "text": "千羽鶴が知ってる$handle$です"},
        { "location": "4154/ACT"   , "narrator": "", "text": "千羽鶴が知ってる$handle$です"},
        { "location": "4158/TALK"  , "narrator": "神楽", "text": "いえ、貴方は私の知らない$handle$"},
        { "location": "4159/TALK"  , "narrator": "神楽", "text": "だって"},
        { "location": "4160/TALK"  , "narrator": "神楽", "text": "私がコンタクトを取った$handle$ではない"},
        { "location": "4162/SEL"   , "narrator": "", "text": "いや、千羽鶴が繋げた$handle$だよ"},
        { "location": "4163/ACT"   , "narrator": "", "text": "いや、千羽鶴が繋げた$handle$だよ"},
        { "location": "4167/TALK"  , "narrator": "神楽", "text": "証拠は？"},
        { "location": "4169/SEL"   , "narrator": "", "text": "心の中にちーすけが住んでるの知ってるよ"},
        { "location": "4170/SEL"   , "narrator": "", "text": "逆バブ属性なの知ってるよ"},
        { "location": "4171/SEL"   , "narrator": "", "text": "非攻略対象さんでしょ？"},
        { "location": "4172/ACT"   , "narrator": "", "text": "心の中にちーすけが住んでるの知ってるよ"},
        { "location": "4173/ACT"   , "narrator": "", "text": "逆バブ属性なの知ってるよ"},
        { "location": "4174/ACT"   , "narrator": "", "text": "非攻略対象さんでしょ？"},
        { "location": "4178/TALK"  , "narrator": "神楽", "text": "なるほど"},
        { "location": "4179/TALK"  , "narrator": "神楽", "text": "私の遙か先を行く観測者の$handle$であると"},
        { "location": "4181/SEL"   , "narrator": "", "text": "ご想像にお任せします"},
        { "location": "4182/ACT"   , "narrator": "", "text": "ご想像にお任せします"},
        { "location": "4191/TALK"  , "narrator": "千羽鶴", "text": "…………。"},
        { "location": "4192/TALK"  , "narrator": "神楽", "text": "…終わったんですか？"},
        { "location": "4194/TALK"  , "narrator": "千羽鶴", "text": "ええ…。\n貴方の条件は\n把握した。"},
        { "location": "4195/TALK"  , "narrator": "千羽鶴", "text": "少し考えるから、\n時間がほしい…。"},
        { "location": "4196/TALK"  , "narrator": "神楽", "text": "…まあ、いいですよ。"},
        { "location": "4197/TALK"  , "narrator": "神楽", "text": "けど、それまでずっと\nここにいろとは、\n言いませんよね？"},
        { "location": "4198/TALK"  , "narrator": "千羽鶴", "text": "…わかった。\n家に戻っていい。"},
        { "location": "4199/TALK"  , "narrator": "千羽鶴", "text": "答えが決まったら、\nまた連絡する。"},
        { "location": "4204/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "4206/TALK"  , "narrator": "千羽鶴", "text": "貴方には、\n契約不履行の\n罰則として…。"},
        { "location": "4207/TALK"  , "narrator": "千羽鶴", "text": "ずっと、\n管理庁にいてもらう。"},
        { "location": "4208/TALK"  , "narrator": "千羽鶴", "text": "逢瀬つばめ\n破壊への協力が\n完了するまで…。"},
        { "location": "4209/TALK"  , "narrator": "千羽鶴", "text": "……以上。"},
        { "location": "4214/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "4226/DIALOG", "narrator": "Dialog_chapter_ch05", "text": "【20 ２０１６】"},
        { "location": "4238/DIALOG", "narrator": "Dialog_chapter_ch05", "text": "【20 ２０１６】"}
    ]
}
