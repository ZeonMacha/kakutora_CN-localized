    [
        { "location": "7488/SCENARIO", "narrator": "", "text": "歌えぬ小鳥"},
        { "location": "7515/TALK"    , "narrator": "神楽", "text": "ぴょんこがもし歌を忘れたら"},
        { "location": "7516/TALK"    , "narrator": "神楽", "text": "月夜の海に象牙のボードで浮かべて欲しいぴょん"},
        { "location": "7518/SEL"     , "narrator": "", "text": "わかった"},
        { "location": "7519/SEL"     , "narrator": "", "text": "そうしたらまた歌えるんだね"},
        { "location": "7520/SEL"     , "narrator": "", "text": "歌えなくても神楽は神楽だよ"},
        { "location": "7521/ACT"     , "narrator": "", "text": "わかった"},
        { "location": "7522/TALK"    , "narrator": "神楽", "text": "絶対だからなー"},
        { "location": "7523/ACT"     , "narrator": "", "text": "そうしたらまた歌えるんだね"},
        { "location": "7524/TALK"    , "narrator": "神楽", "text": "そうぴょん"},
        { "location": "7525/TALK"    , "narrator": "神楽", "text": "忘れた歌を思い出すんだぴょん"},
        { "location": "7526/ACT"     , "narrator": "", "text": "歌えなくても神楽は神楽だよ"},
        { "location": "7528/TALK"    , "narrator": "神楽", "text": "本当？"},
        { "location": "7530/TALK"    , "narrator": "神楽", "text": "ぴょんこが歌えなくなっても$handlek$はぴょんこの側にいてくれるぴょん？"},
        { "location": "7532/SEL"     , "narrator": "", "text": "もちろん"},
        { "location": "7533/SEL"     , "narrator": "", "text": "それ以外の選択肢はない"},
        { "location": "7534/SEL"     , "narrator": "", "text": "一応そのつもり"},
        { "location": "7535/ACT"     , "narrator": "", "text": "もちろん"},
        { "location": "7536/TALK"    , "narrator": "神楽", "text": "よっしゃー！"},
        { "location": "7537/ACT"     , "narrator": "", "text": "それ以外の選択肢はない"},
        { "location": "7539/ACT"     , "narrator": "", "text": "一応そのつもり"},
        { "location": "7540/TALK"    , "narrator": "神楽", "text": "意外と軽かった、、、"},
        { "location": "7543/TALK"    , "narrator": "神楽", "text": "ただ音を繋げるだけなら誰でもできるぴょん"},
        { "location": "7544/TALK"    , "narrator": "神楽", "text": "だけど評価されるレベルになるのは別問題"},
        { "location": "7546/SEL"     , "narrator": "", "text": "なんでもそうじゃない？"},
        { "location": "7547/SEL"     , "narrator": "", "text": "歌なんて楽しければそれでいい"},
        { "location": "7548/SEL"     , "narrator": "", "text": "神楽を$me$は評価してるよ"},
        { "location": "7549/ACT"     , "narrator": "", "text": "なんでもそうじゃない？"},
        { "location": "7550/TALK"    , "narrator": "神楽", "text": "かもね"},
        { "location": "7551/ACT"     , "narrator": "", "text": "歌なんて楽しければそれでいい"},
        { "location": "7552/TALK"    , "narrator": "神楽", "text": "あ―――――！！！！！！"},
        { "location": "7553/TALK"    , "narrator": "神楽", "text": "だよね―――！！！！"},
        { "location": "7554/ACT"     , "narrator": "", "text": "神楽を$me$は評価してるよ"},
        { "location": "7556/TALK"    , "narrator": "神楽", "text": "またまた★"},
        { "location": "7558/TALK"    , "narrator": "神楽", "text": "適当なことばかりぴょん"},
        { "location": "7559/TALK"    , "narrator": "神楽", "text": "ぴょんこはそういうの"},
        { "location": "7560/TALK"    , "narrator": "神楽", "text": "騙されちゃうんだからー！！"},
        { "location": "7562/TALK"    , "narrator": "神楽", "text": "ぴょんこがもし歌を忘れたなら"},
        { "location": "7563/TALK"    , "narrator": "神楽", "text": "それは本当に歌いたくないからだと思うぴょん"},
        { "location": "7564/TALK"    , "narrator": "神楽", "text": "でも本当は歌いたいのかな？"},
        { "location": "7565/TALK"    , "narrator": "神楽", "text": "自分でもわからないぴょん"}
    ]
}
