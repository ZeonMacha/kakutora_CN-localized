{
    "dir": "chap00/daydra/spev_ch01_091_02.js",
    "type": "",
    "info": {
        "story_id": "91022",
        "cid": "",
        "title": "シャッツキステリンク",
        "sub_title": "彼女がメイドに着替えたら"
    },
    "entry":
    [
        { "location": "238/SCENARIO", "narrator": "", "text": "トライナリー×シャッツキステ"},
        { "location": "259/TALK"    , "narrator": "メイド", "text": "――ご注文、承りました。\n少々お待ちください。"},
        { "location": "261/TALK"    , "narrator": "神楽", "text": "はい、\nありがとうございます。"},
        { "location": "265/TALK"    , "narrator": "神楽", "text": "…素敵だなぁ。"},
        { "location": "267/TALK"    , "narrator": "神楽", "text": "もし、みんなで\nこのお店で働けたら、\nとっても楽しいかも！"},
        { "location": "268/TALK"    , "narrator": "神楽", "text": "例えば――"},
        { "location": "273/DIALOG"  , "narrator": "", "text": "<size=35>シャッツキステ・お給仕レッスン①</size>\n\n\n<size=50>- 逢瀬つばめのCase. -</size>\n"},
        { "location": "293/TALK"    , "narrator": "メイド", "text": "それじゃあつばめちゃん。\nこれをテーブルまで\n運んでもらえるかしら？"},
        { "location": "295/TALK"    , "narrator": "つばめ", "text": "わかりました！"},
        { "location": "296/TALK"    , "narrator": "メイド", "text": "ちょっと重いから、\nくれぐれも気を付けて――"},
        { "location": "304/TALK"    , "narrator": "つばめ", "text": "わわっ！？"},
        { "location": "305/TALK"    , "narrator": "メイド", "text": "つばめちゃん、危ない！"},
        { "location": "306/TALK"    , "narrator": "つばめ", "text": "あっ、とっ、とっ…。"},
        { "location": "309/TALK"    , "narrator": "つばめ", "text": "…ふぅー。\nだ、大丈夫です、\n転びませんでした！"},
        { "location": "310/TALK"    , "narrator": "メイド", "text": "よかった…。\n足元に気を付けて\n運んでね？"},
        { "location": "312/TALK"    , "narrator": "つばめ", "text": "わ、わかりました…。"},
        { "location": "316/TALK"    , "narrator": "メイド", "text": "ほっ…今度はちゃんと\n運べたみたい…。"},
        { "location": "317/TALK"    , "narrator": "メイド", "text": "って、あら？"},
        { "location": "320/TALK"    , "narrator": "つばめ", "text": "あ、あの…。"},
        { "location": "322/TALK"    , "narrator": "つばめ", "text": "どのテーブルに\n運ぶか聞き忘れてて…。"},
        { "location": "324/TALK"    , "narrator": "メイド", "text": "…………。"},
        { "location": "344/TALK"    , "narrator": "神楽", "text": "…つ、つばめさんには、\nお給仕のお仕事は\n合わないかも…。"},
        { "location": "345/TALK"    , "narrator": "神楽", "text": "…他の人達だったら、\nどうなるかなぁ…？"},
        { "location": "346/TALK"    , "narrator": "神楽", "text": "う～ん…。"},
        { "location": "347/TALK"    , "narrator": "神楽", "text": "もし、アーヤさんが\nシャッツキステで\n働いてたら――"},
        { "location": "353/DIALOG"  , "narrator": "", "text": "<size=35>シャッツキステ・お給仕レッスン②</size>\n\n\n<size=50>- 國政綾水のCase. -</size>\n"},
        { "location": "369/TALK"    , "narrator": "メイド", "text": "ふう…今日は大勢の\n旅人さまがいらっしゃい\nますね…。"},
        { "location": "371/TALK"    , "narrator": "アーヤ", "text": "いつも、こんなに\n忙しいんですか？"},
        { "location": "373/TALK"    , "narrator": "メイド", "text": "日によりますね。\n賑やかな時もあれば、\n静かな時もありますし。"},
        { "location": "374/TALK"    , "narrator": "メイド", "text": "それより、大丈夫？\nアーヤさん、まだ\n入ったばかりなのに…。"},
        { "location": "376/TALK"    , "narrator": "アーヤ", "text": "はい、平気です。\n部活で鍛えられたので、\n体力には自信あるんです。"},
        { "location": "377/TALK"    , "narrator": "メイド", "text": "頼もしいわ。"},
        { "location": "379/TALK"    , "narrator": "メイド", "text": "あっ、旅人さまが\nお呼びですね。\nお願いできますか？"},
        { "location": "380/TALK"    , "narrator": "アーヤ", "text": "はい、わかり――"},
        { "location": "389/TALK"    , "narrator": "アーヤ", "text": "っ！？"},
        { "location": "391/TALK"    , "narrator": "メイド", "text": "あ、アーヤさん。\n仕事中はスマホの電源は\n切っておいてください。"},
        { "location": "392/TALK"    , "narrator": "アーヤ", "text": "…………。"},
        { "location": "393/TALK"    , "narrator": "メイド", "text": "あ、あの…。"},
        { "location": "397/TALK"    , "narrator": "アーヤ", "text": "すみません。\n一身上の都合により、\n早退させていただきます。"},
        { "location": "398/TALK"    , "narrator": "メイド", "text": "えぇっ！？\nそ、そんな急に困ります！"},
        { "location": "399/TALK"    , "narrator": "アーヤ", "text": "本当にごめんなさい。\nでも、公務なんです。\n失礼します！"},
        { "location": "407/TALK"    , "narrator": "メイド", "text": "こ、公務って！？\n意味がわかりませんよー！"},
        { "location": "426/TALK"    , "narrator": "神楽", "text": "…………。"},
        { "location": "428/TALK"    , "narrator": "神楽", "text": "…アーヤさんの\n真面目さから考えて、\n確実にそうなるなぁ…。"},
        { "location": "429/TALK"    , "narrator": "神楽", "text": "う～ん…もしかしたら、\nみんなメイド喫茶には\n向いてないのかも…。"},
        { "location": "430/TALK"    , "narrator": "神楽", "text": "あっ、でもガブちゃんなら\n喜びそう！"},
        { "location": "431/TALK"    , "narrator": "神楽", "text": "それに、メイド姿も\n絶対に似合うと思うし――"},
        { "location": "437/DIALOG"  , "narrator": "", "text": "<size=35>シャッツキステ・お給仕レッスン③</size>\n\n\n<size=50>- ガブリエラのCase. -</size>\n"},
        { "location": "457/TALK"    , "narrator": "ガブリエラ", "text": "ようこそ\nおいでくださいました。\nありがとうございました。"},
        { "location": "458/TALK"    , "narrator": "メイド", "text": "じゃあ、ご注文を\n受けた時は？"},
        { "location": "460/TALK"    , "narrator": "ガブリエラ", "text": "承りました。\n少々お待ちください。"},
        { "location": "462/TALK"    , "narrator": "ガブリエラ", "text": "…ちゃんと\nできてるかしら？"},
        { "location": "463/TALK"    , "narrator": "メイド", "text": "完璧です。\n百点満点の受け答えよ。"},
        { "location": "465/TALK"    , "narrator": "ガブリエラ", "text": "そう…まあ、これくらい\nマニュアル読めば簡単に\nできることだけど。"},
        { "location": "466/TALK"    , "narrator": "メイド", "text": "最初のうちは旅人さまの\n前で実際に言うの、\n結構緊張するものよ？"},
        { "location": "467/TALK"    , "narrator": "メイド", "text": "…でも、せっかくだから\n次に入ってくる旅人さまの\n案内、任せていいかしら？"},
        { "location": "470/TALK"    , "narrator": "ガブリエラ", "text": "えっ、いきなり！？"},
        { "location": "471/TALK"    , "narrator": "メイド", "text": "ふふっ、やっぱり\n緊張しちゃってる？"},
        { "location": "473/TALK"    , "narrator": "ガブリエラ", "text": "へ、平気よ！\nそれじゃ、次に誰か\n入ってきたら…。"},
        { "location": "481/TALK"    , "narrator": "ガブリエラ", "text": "あ、ようこそおいで――"},
        { "location": "483/TALK"    , "narrator": "男子高校生", "text": "どうも。\nあの、一人なんですけど。"},
        { "location": "485/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "487/TALK"    , "narrator": "メイド", "text": "やっぱり緊張してる…。\nガブリエラちゃん、\n挨拶して。"},
        { "location": "488/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "489/TALK"    , "narrator": "男子高校生", "text": "あ、あの…すみません。\n一名なんですけど…。"},
        { "location": "491/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "493/TALK"    , "narrator": "メイド", "text": "こ、ここまで\n緊張しちゃうなんて…。"},
        { "location": "513/TALK"    , "narrator": "神楽", "text": "…………。"},
        { "location": "514/TALK"    , "narrator": "神楽", "text": "男の人相手っていうのを\n考えると…ダメかなぁ…。"},
        { "location": "515/TALK"    , "narrator": "神楽", "text": "あとは、みやびさんかぁ。\n妄想でも浮かんでこない\nけど…。"},
        { "location": "516/TALK"    , "narrator": "神楽", "text": "う～ん…みやびさんが\nお給仕…シャッツキステで\nお給仕…。"},
        { "location": "522/DIALOG"  , "narrator": "", "text": "<size=35>シャッツキステ・お給仕レッスン④</size>\n\n\n<size=50>- 恋ヶ崎みやびのCase. -</size>\n"},
        { "location": "539/TALK"    , "narrator": "みやび", "text": "ご注文承りました。\n少々お待ちください。"},
        { "location": "542/TALK"    , "narrator": "みやび", "text": "メイドさーん。\n注文受けてきたがですよ。"},
        { "location": "544/TALK"    , "narrator": "メイド", "text": "ありがとう。\nこっちで見てたけど、\n完璧なお給仕だったわ。"},
        { "location": "545/TALK"    , "narrator": "みやび", "text": "安心しました。\nうち、お給仕なんて\nやったことないですき。"},
        { "location": "546/TALK"    , "narrator": "みやび", "text": "滑って転んで皿割って、\n宙を舞ったケーキが\n旅人さまの頭に直撃。"},
        { "location": "547/TALK"    , "narrator": "みやび", "text": "なんてことにならんよう、\n頑張った甲斐があるって\nもんですよ。"},
        { "location": "548/TALK"    , "narrator": "メイド", "text": "あ、あはは…。\n本当、そうならなくて\n安心したわ…。"},
        { "location": "550/TALK"    , "narrator": "みやび", "text": "…ところで、\nそろそろうちもアレやって\nえいですか？"},
        { "location": "551/TALK"    , "narrator": "メイド", "text": "アレ？\nアレって、なに？"},
        { "location": "554/TALK"    , "narrator": "みやび", "text": "ゾンビですよ。"},
        { "location": "556/TALK"    , "narrator": "メイド", "text": "…………はい？"},
        { "location": "557/TALK"    , "narrator": "みやび", "text": "ブログで見かけてから、\nずーっと面白そうやと\n思うてたがですよ。"},
        { "location": "558/TALK"    , "narrator": "みやび", "text": "ゾンビになった\nメイドさんっちゅう\n格好でお給仕…。"},
        { "location": "559/TALK"    , "narrator": "みやび", "text": "それ楽しみにしてたき、\nお給仕頑張れたんですよ。"},
        { "location": "560/TALK"    , "narrator": "メイド", "text": "え、えっと…残念だけど、\nアレはいつもなってる\nわけじゃなくて…。"},
        { "location": "561/TALK"    , "narrator": "みやび", "text": "…………。"},
        { "location": "562/TALK"    , "narrator": "メイド", "text": "楽しみにしてたのに\n申し訳ないけど、\nそういうことだから…。"},
        { "location": "565/TALK"    , "narrator": "みやび", "text": "…今、うちの心が\nゾンビになったぞね。"},
        { "location": "566/TALK"    , "narrator": "メイド", "text": "そもそも、うちは\nそういうコンセプトの\nカフェじゃありません！"},
        { "location": "584/TALK"    , "narrator": "神楽", "text": "…かなりぶっ飛んだ\n妄想になっちゃったけど、\nありそうかも…。"},
        { "location": "586/TALK"    , "narrator": "神楽", "text": "はぁ…妄想とはいえ、\nみんなダメダメだなぁ…。"},
        { "location": "587/TALK"    , "narrator": "神楽", "text": "多分、私一人で\nお給仕した方が、\n四人以上に働けそうだし。"},
        { "location": "589/TALK"    , "narrator": "神楽", "text": "…でも、せっかく\nメイド服を着るなら、\nやっぱり――"},
        { "location": "595/DIALOG"  , "narrator": "", "text": "<size=35>シャッツキステ・お給仕レッスン⑤</size>\n\n\n<size=50>- 卯月神楽のCase. -</size>\n"},
        { "location": "612/TALK"    , "narrator": "神楽", "text": "お紅茶、\nお待たせいたしましたぁ。"},
        { "location": "613/TALK"    , "narrator": "神楽", "text": "――はい。\nありがとうございます！"},
        { "location": "614/TALK"    , "narrator": "神楽", "text": "では、ごゆっくりどうぞ。"},
        { "location": "616/TALK"    , "narrator": "神楽", "text": "えっと、次は…。"},
        { "location": "618/TALK"    , "narrator": "メイド", "text": "さすがは神楽ちゃん。"},
        { "location": "619/TALK"    , "narrator": "メイド", "text": "よく来てくれていた\nだけあって、\n完璧なお給仕よ。"},
        { "location": "622/TALK"    , "narrator": "神楽", "text": "ふふっ、このお店は\nお客として来てた時から、\n大好きなお店なんです。"},
        { "location": "625/TALK"    , "narrator": "神楽", "text": "だから、他の旅人さまにも\nこのお店をたくさん好きに\nなってもらいたいんです。"},
        { "location": "626/TALK"    , "narrator": "メイド", "text": "神楽ちゃん…。"},
        { "location": "627/TALK"    , "narrator": "神楽", "text": "ふふっ…、\n大好きな場所で働けて、\n本当に嬉しくて――"},
        { "location": "634/TALK"    , "narrator": "メイド", "text": "え？"},
        { "location": "637/TALK"    , "narrator": "神楽", "text": "あっ！"},
        { "location": "640/TALK"    , "narrator": "メイド", "text": "ちょ、神楽ちゃん！\nどうしてスカートの中から\n銃が落ちてくるの！？"},
        { "location": "642/TALK"    , "narrator": "神楽", "text": "ご、ごめんなさい！\nでもほら、ラノベとかで\nあるじゃないですか。"},
        { "location": "644/TALK"    , "narrator": "神楽", "text": "メイドさんはスカートの\n内側に銃やナイフを\n沢山隠し持ってて…。"},
        { "location": "645/TALK"    , "narrator": "神楽", "text": "…皆さんも、\nなにか持っては\nいるんですよね？"},
        { "location": "646/TALK"    , "narrator": "メイド", "text": "そうそう！\nスカートの中に――"},
        { "location": "647/TALK"    , "narrator": "メイド", "text": "って！\nこのカフェに戦う相手\nなんていませんから！"},
        { "location": "648/TALK"    , "narrator": "神楽", "text": "そ、そんなぁ…。"},
        { "location": "668/TALK"    , "narrator": "神楽", "text": "…………。"},
        { "location": "671/TALK"    , "narrator": "メイド", "text": "お待たせいたしました。\nお紅茶とスコーンです。"},
        { "location": "674/TALK"    , "narrator": "神楽", "text": "あ、はい…。"},
        { "location": "675/TALK"    , "narrator": "メイド", "text": "以上でよろしいですか？"},
        { "location": "676/TALK"    , "narrator": "神楽", "text": "はい…それと…。"},
        { "location": "677/TALK"    , "narrator": "神楽", "text": "私の妄想の中とはいえ、\nメイドさんや館内を\n騒がしくしてしまい…。"},
        { "location": "681/TALK"    , "narrator": "神楽", "text": "…すみませんでした。"},
        { "location": "682/TALK"    , "narrator": "メイド", "text": "…はい？"}
    ]
}
