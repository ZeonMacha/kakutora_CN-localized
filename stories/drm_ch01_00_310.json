    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "答えがあるなら"},
        { "location": "32/TALK"   , "narrator": "つばめ", "text": "相談に乗って欲しいです(´つω・｀)"},
        { "location": "33/TALK"   , "narrator": "つばめ", "text": "ぁたしのすごく大事なお友達に嫌われたかもしれません。(＠´,,・ω・,,｀＠)\nでもぁたしは、とてもその子のことが心配なんです。"},
        { "location": "34/TALK"   , "narrator": "つばめ", "text": "元気を出してもらうにはどうすればいいのかなヽ(；▽；)ノ？"},
        { "location": "36/SEL"    , "narrator": "", "text": "もう少し詳しく話して"},
        { "location": "37/TALK"   , "narrator": "つばめ", "text": "最後に会った時はその子はすごく怒ってた"},
        { "location": "38/TALK"   , "narrator": "つばめ", "text": "でもそれは、ぁたしにじゃないような気もするの"},
        { "location": "40/TALK"   , "narrator": "つばめ", "text": "でもそんな風にぁたしが思いたいだけじゃないのかなっても思ってるの"},
        { "location": "41/TALK"   , "narrator": "つばめ", "text": "どっちなのかな"},
        { "location": "43/ACT"    , "narrator": "", "text": "もう少し詳しく話して"},
        { "location": "45/TALK"   , "narrator": "つばめ", "text": "ぇっと"},
        { "location": "49/TALK"   , "narrator": "つばめ", "text": "その子のこと？"},
        { "location": "51/SEL"    , "narrator": "", "text": "その子が怒る前に何があったの？"},
        { "location": "52/SEL"    , "narrator": "", "text": "誰の話をしているの？"},
        { "location": "53/ACT"    , "narrator": "", "text": "その子が怒る前に何があったの？"},
        { "location": "55/TALK"   , "narrator": "つばめ", "text": "トライナリーに来なくなったの"},
        { "location": "56/TALK"   , "narrator": "つばめ", "text": "だからぁたし、卯月さんのおうちに迎えに行ったの"},
        { "location": "57/ACT"    , "narrator": "", "text": "誰の話をしているの？"},
        { "location": "58/TALK"   , "narrator": "つばめ", "text": "卯月さん"},
        { "location": "60/TALK"   , "narrator": "つばめ", "text": "卯月さん、トライナリーに来なくなったから"},
        { "location": "61/TALK"   , "narrator": "つばめ", "text": "だからぁたし、卯月さんのおうちに迎えに行ったの"},
        { "location": "63/TALK"   , "narrator": "つばめ", "text": "でもおかあさんがちょっと変だったの(´・ω・｀)"},
        { "location": "64/TALK"   , "narrator": "つばめ", "text": "その話はしないでって言われたから気にしないようにしたけど"},
        { "location": "65/TALK"   , "narrator": "つばめ", "text": "やっぱりちょっとおかしぃ・・・"},
        { "location": "68/SEL"    , "narrator": "", "text": "指摘すればよかったのに"},
        { "location": "69/SEL"    , "narrator": "", "text": "触れられたくないことってあるよ"},
        { "location": "70/ACT"    , "narrator": "", "text": "指摘すればよかったのに"},
        { "location": "71/TALK"   , "narrator": "つばめ", "text": "それは・・・"},
        { "location": "72/TALK"   , "narrator": "つばめ", "text": "触れちゃいけないことだって"},
        { "location": "73/TALK"   , "narrator": "つばめ", "text": "ぁたしにだってわかるよヾ(｡>﹏<｡)ﾉﾞ"},
        { "location": "74/ACT"    , "narrator": "", "text": "触れられたくないことってあるよ"},
        { "location": "75/TALK"   , "narrator": "つばめ", "text": "うん・・・"},
        { "location": "76/TALK"   , "narrator": "つばめ", "text": "そうなんだけど・・・"},
        { "location": "77/TALK"   , "narrator": "つばめ", "text": "ゃっぱりょくなかったよね(´・ω・｀)"},
        { "location": "79/TALK"   , "narrator": "つばめ", "text": "それで"},
        { "location": "80/TALK"   , "narrator": "つばめ", "text": "ぁたしは卯月さんが隠したかったこととか知っちゃったのかもしれなぃんだ"},
        { "location": "81/TALK"   , "narrator": "つばめ", "text": "それがダメなのかもしれないし"},
        { "location": "82/TALK"   , "narrator": "つばめ", "text": "ぁたしのことが単純に嫌いなのかもしれなぃなって思ってるのヽ(；▽；)ノ"},
        { "location": "84/SEL"    , "narrator": "", "text": "嫌いなのかもね"},
        { "location": "85/SEL"    , "narrator": "", "text": "そんなことないよ"},
        { "location": "86/SEL"    , "narrator": "", "text": "落ち着くまで待ってあげよう"},
        { "location": "87/TALK"   , "narrator": "つばめ", "text": "そぅ思うと"},
        { "location": "88/TALK"   , "narrator": "つばめ", "text": "なんか"},
        { "location": "89/TALK"   , "narrator": "つばめ", "text": "すごく"},
        { "location": "91/TALK"   , "narrator": "つばめ", "text": "辛ぃの"},
        { "location": "92/ACT"    , "narrator": "", "text": "嫌いなのかもね"},
        { "location": "94/TALK"   , "narrator": "つばめ", "text": "でも"},
        { "location": "95/TALK"   , "narrator": "つばめ", "text": "しかたないのかもね(´つω・｀)"},
        { "location": "96/ACT"    , "narrator": "", "text": "そんなことないよ"},
        { "location": "97/TALK"   , "narrator": "つばめ", "text": "だったら"},
        { "location": "98/TALK"   , "narrator": "つばめ", "text": "ぃぃよね(´･ω･｀) "},
        { "location": "99/ACT"    , "narrator": "", "text": "落ち着くまで待ってあげよう"},
        { "location": "109/TALK"  , "narrator": "つばめ", "text": "待ってあげるの・・・？"},
        { "location": "110/TALK"  , "narrator": "つばめ", "text": "そうしたら"},
        { "location": "111/TALK"  , "narrator": "つばめ", "text": "また"},
        { "location": "112/TALK"  , "narrator": "つばめ", "text": "話してくれるかな・・・？"},
        { "location": "114/SEL"   , "narrator": "", "text": "大丈夫"},
        { "location": "115/SEL"   , "narrator": "", "text": "$handle$を信じて"},
        { "location": "116/ACT"   , "narrator": "", "text": "大丈夫"},
        { "location": "117/ACT"   , "narrator": "", "text": "$handle$を信じて"},
        { "location": "120/TALK"  , "narrator": "つばめ", "text": "うん"},
        { "location": "121/TALK"  , "narrator": "つばめ", "text": "そうだね"},
        { "location": "122/TALK"  , "narrator": "つばめ", "text": "そうしてみるヽ(･ω･ )ゝ"},
        { "location": "124/TALK"  , "narrator": "つばめ", "text": "話したらちょっと落ち着いたみたい"},
        { "location": "125/TALK"  , "narrator": "つばめ", "text": "ありがとう(*´︶`*)"},
        { "location": "127/TALK"  , "narrator": "つばめ", "text": ":.ﾟヽ(´∀`｡)ﾉﾟ.:｡ ゜"},
