{
    "dir": "chap00/daydra/spev_ch04_006.js",
    "type": "",
    "info": {
        "story_id": "4006",
        "cid": "",
        "title": "スペシャルエピソード",
        "sub_title": "溶けてしまうほどに"
    },
    "entry":
    [
        { "location": "28/TALK" , "narrator": "透明アーヤ", "text": "みんな、休まないで！\nあと砂浜一往復！！"},
        { "location": "30/TALK" , "narrator": "透明つばめ", "text": "は、はいぃ…。\n頑張りますぅ…。"},
        { "location": "31/TALK" , "narrator": "透明神楽", "text": "つばめさん、頑張って！\n足を止めたら動けなく\nなっちゃいますよ。"},
        { "location": "32/TALK" , "narrator": "透明ガブリエラ", "text": "ペース落とさないで、\n最後まで気合入れなさい！"},
        { "location": "33/TALK" , "narrator": "透明みやび", "text": "…みんな、\nまっこと元気やなぁ。"},
        { "location": "34/TALK" , "narrator": "透明みやび", "text": "こんな炎天下に\n砂浜で走りこみとか、\nついて行けんがよ。"},
        { "location": "35/TALK" , "narrator": "透明ガブリエラ", "text": "ほら、つばめ！\nペース落ちてる！！"},
        { "location": "36/TALK" , "narrator": "透明つばめ", "text": "ご、ごめーん！！"},
        { "location": "39/TALK" , "narrator": "透明みやび", "text": "…ひゃっ！？"},
        { "location": "43/TALK" , "narrator": "透明みやび", "text": "あちゃぁ…アイス、\n落ちてしもうた…。"},
        { "location": "44/TALK" , "narrator": "透明みやび", "text": "みんなの暑苦しさに\n耐えられんかったん\nやろうなぁ…。"},
        { "location": "46/TALK" , "narrator": "透明みやび", "text": "…………。"},
        { "location": "49/TALK" , "narrator": "みやび", "text": "さてどうしたものか"},
        { "location": "50/TALK" , "narrator": "みやび", "text": "胸に落ちたアイス"},
        { "location": "51/TALK" , "narrator": "みやび", "text": "この処理方法"},
        { "location": "52/SEL"  , "narrator": "（選択肢）", "text": "食べたい！！"},
        { "location": "53/SEL"  , "narrator": "（選択肢）", "text": "食べちゃえ"},
        { "location": "54/ACT"  , "narrator": "", "text": "食べたい！！"},
        { "location": "55/TALK" , "narrator": "みやび", "text": "相棒がここにいたら"},
        { "location": "56/TALK" , "narrator": "みやび", "text": "即頼んでただろう"},
        { "location": "58/TALK" , "narrator": "みやび", "text": "胸のアイス"},
        { "location": "60/TALK" , "narrator": "みやび", "text": "染みてきている"},
        { "location": "61/TALK" , "narrator": "みやび", "text": "冷たい"},
        { "location": "62/ACT"  , "narrator": "", "text": "食べちゃえ"},
        { "location": "63/TALK" , "narrator": "みやび", "text": "無理だろう"},
        { "location": "64/TALK" , "narrator": "みやび", "text": "触れたら溶ける"},
        { "location": "65/TALK" , "narrator": "みやび", "text": "万事休す"},
        { "location": "66/TALK" , "narrator": "みやび", "text": "もうこのまま"},
        { "location": "67/TALK" , "narrator": "みやび", "text": "見守るしかないのだ"},
        { "location": "70/TALK" , "narrator": "みやび", "text": "だが"},
        { "location": "71/TALK" , "narrator": "みやび", "text": "まだアイスはある"},
        { "location": "73/TALK" , "narrator": "みやび", "text": "それが救い"},
        { "location": "74/TALK" , "narrator": "みやび", "text": "溶ける前に食べねば"},
        { "location": "75/SEL"  , "narrator": "（選択肢）", "text": "ていうか、みやびはサボり？"},
        { "location": "76/ACT"  , "narrator": "", "text": "ていうか、みやびはサボり？"},
        { "location": "80/TALK" , "narrator": "みやび", "text": "サボりではない"},
        { "location": "81/TALK" , "narrator": "みやび", "text": "自主的辞退である"},
        { "location": "82/TALK" , "narrator": "みやび", "text": "肉体労働は専門外"},
        { "location": "83/TALK" , "narrator": "みやび", "text": "うちは頭脳派なのだ"},
        { "location": "86/SEL"  , "narrator": "（選択肢）", "text": "なにか訓練しなくていいの？"},
        { "location": "87/SEL"  , "narrator": "（選択肢）", "text": "脳みそクールダウン中か"},
        { "location": "88/ACT"  , "narrator": "", "text": "なにか訓練しなくていいの？"},
        { "location": "91/TALK" , "narrator": "みやび", "text": "えいのだよ"},
        { "location": "93/TALK" , "narrator": "みやび", "text": "うちは普段から"},
        { "location": "94/TALK" , "narrator": "みやび", "text": "何時間もＰＣ前で鍛えてるのだ"},
        { "location": "95/TALK" , "narrator": "みやび", "text": "故にみんなの訓練中は"},
        { "location": "96/TALK" , "narrator": "みやび", "text": "休息タイムと決めた"},
        { "location": "97/ACT"  , "narrator": "", "text": "脳みそクールダウン中か"},
        { "location": "98/TALK" , "narrator": "みやび", "text": "理解が早くて素晴らしい"},
        { "location": "99/TALK" , "narrator": "みやび", "text": "ＰＣと同じ"},
        { "location": "101/TALK", "narrator": "みやび", "text": "脳みそ熱暴走は怖い"},
        { "location": "102/TALK", "narrator": "みやび", "text": "アイスは冷却液代わりなのだ"},
        { "location": "104/TALK", "narrator": "みやび", "text": "しかし"},
        { "location": "105/TALK", "narrator": "みやび", "text": "地元の海で"},
        { "location": "106/TALK", "narrator": "みやび", "text": "こんなにのんびりしたの"},
        { "location": "107/TALK", "narrator": "みやび", "text": "初めてかもしれん"},
        { "location": "108/TALK", "narrator": "みやび", "text": "散歩はしても"},
        { "location": "109/TALK", "narrator": "みやび", "text": "のんびりはしない"},
        { "location": "110/TALK", "narrator": "みやび", "text": "暑いだけだから"},
        { "location": "111/SEL" , "narrator": "（選択肢）", "text": "一人じゃつまらないよ"},
        { "location": "112/SEL" , "narrator": "（選択肢）", "text": "冷房効いた部屋でＰＣが一番"},
        { "location": "113/ACT" , "narrator": "", "text": "一人じゃつまらないよ"},
        { "location": "114/TALK", "narrator": "みやび", "text": "今も一人だが？"},
        { "location": "116/TALK", "narrator": "みやび", "text": "訓練してるみんなを"},
        { "location": "117/TALK", "narrator": "みやび", "text": "遠くから眺めて"},
        { "location": "120/TALK", "narrator": "みやび", "text": "いや"},
        { "location": "121/TALK", "narrator": "みやび", "text": "違うな"},
        { "location": "122/TALK", "narrator": "みやび", "text": "そういうことではない"},
        { "location": "123/TALK", "narrator": "みやび", "text": "多分"},
        { "location": "125/ACT" , "narrator": "", "text": "冷房効いた部屋でＰＣが一番"},
        { "location": "126/TALK", "narrator": "みやび", "text": "その通りだ"},
        { "location": "127/TALK", "narrator": "みやび", "text": "理解あり過ぎて怖い"},
        { "location": "128/TALK", "narrator": "みやび", "text": "浜辺に来なくても"},
        { "location": "129/TALK", "narrator": "みやび", "text": "部屋から海見えるし"},
        { "location": "131/TALK", "narrator": "みやび", "text": "話に夢中になり過ぎた"},
        { "location": "132/TALK", "narrator": "みやび", "text": "残りのアイスを食べなければ"},
        { "location": "133/TALK", "narrator": "みやび", "text": "また胸が冷たくなる前に"},
        { "location": "137/TALK", "narrator": "透明みやび", "text": "さてと、これ食べたら\n違う味のを…。"},
        { "location": "138/TALK", "narrator": "透明真幌", "text": "随分と優雅だな。"},
        { "location": "140/TALK", "narrator": "透明みやび", "text": "ああ、まほさん。\nお疲れさんです。"},
        { "location": "141/TALK", "narrator": "透明真幌", "text": "おまえ…ここまで\n堂々とサボられると、\n怒る気にもなれん…。"},
        { "location": "142/TALK", "narrator": "透明みやび", "text": "自主的辞退ながですよ。\nまほさんも、\nアイス食べます？"},
        { "location": "143/TALK", "narrator": "透明真幌", "text": "…よし、わかった。\nそのアイスを食べきる\nまでは待ってやる。"},
        { "location": "144/TALK", "narrator": "透明真幌", "text": "だから、早く食って、\nおまえも訓練に戻れ！"},
        { "location": "147/TALK", "narrator": "透明みやび", "text": "はぁ…堂々としてれば\n平気かと思うたけんど、\n無理やったか…。"}
    ]
}
