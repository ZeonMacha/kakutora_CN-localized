    [
        { "location": "7/SCENARIO", "narrator": "", "text": "010_虫さされ"},
        { "location": "32/TALK"   , "narrator": "アーヤ", "text": "ちょっと油断してたわ(｀ヘ´) "},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "やられた"},
        { "location": "36/SEL"    , "narrator": "", "text": "大丈夫？"},
        { "location": "37/ACT"    , "narrator": "", "text": "大丈夫？"},
        { "location": "39/TALK"   , "narrator": "アーヤ", "text": "平気"},
        { "location": "40/TALK"   , "narrator": "アーヤ", "text": "だけど跡が残るかも"},
        { "location": "42/SEL"    , "narrator": "", "text": "跡？"},
        { "location": "43/SEL"    , "narrator": "", "text": "傷は浅いぞ、しっかりしろ"},
        { "location": "44/ACT"    , "narrator": "", "text": "跡？"},
        { "location": "45/TALK"   , "narrator": "アーヤ", "text": "そう"},
        { "location": "46/TALK"   , "narrator": "アーヤ", "text": "かっこわるいわ(´o｀；"},
        { "location": "47/ACT"    , "narrator": "", "text": "傷は浅いぞ、しっかりしろ"},
        { "location": "48/TALK"   , "narrator": "アーヤ", "text": "まあ浅いけど(￣Д￣ )"},
        { "location": "49/TALK"   , "narrator": "アーヤ", "text": "何か若手る？"},
        { "location": "50/TALK"   , "narrator": "アーヤ", "text": "わかってる？"},
        { "location": "52/TALK"   , "narrator": "アーヤ", "text": "可に噛まれたの"},
        { "location": "53/TALK"   , "narrator": "アーヤ", "text": "カニ"},
        { "location": "55/TALK"   , "narrator": "アーヤ", "text": "蚊"},
        { "location": "56/TALK"   , "narrator": "アーヤ", "text": "に"},
        { "location": "60/TALK"   , "narrator": "アーヤ", "text": "あれってすごく刺される人と全然刺されない人がいるのよね"},
        { "location": "62/SEL"    , "narrator": "", "text": "いるよねー"},
        { "location": "63/SEL"    , "narrator": "", "text": "虫にモテるんだね"},
        { "location": "64/SEL"    , "narrator": "", "text": "悪い虫は追い払ってやる"},
        { "location": "65/ACT"    , "narrator": "", "text": "いるよねー"},
        { "location": "66/TALK"   , "narrator": "アーヤ", "text": "ほんと"},
        { "location": "67/TALK"   , "narrator": "アーヤ", "text": "やんなっちゃう(；´Д｀)"},
        { "location": "68/ACT"    , "narrator": "", "text": "虫にモテるんだね"},
        { "location": "69/TALK"   , "narrator": "アーヤ", "text": "うれしくないし（｀皿´ )"},
        { "location": "70/TALK"   , "narrator": "アーヤ", "text": "もてても"},
        { "location": "71/ACT"    , "narrator": "", "text": "悪い虫は追い払ってやる"},
        { "location": "73/TALK"   , "narrator": "アーヤ", "text": "そういう意味じゃなかったんだけど(・・。)ゞ"},
        { "location": "74/TALK"   , "narrator": "アーヤ", "text": "その時はお願いするわ(*^.^*)"},
        { "location": "77/TALK"   , "narrator": "アーヤ", "text": "これからは"},
        { "location": "78/TALK"   , "narrator": "アーヤ", "text": "虫よけと虫刺されの薬持ち歩かなきゃ"},
        { "location": "79/TALK"   , "narrator": "アーヤ", "text": "また荷物増えちゃう(´o｀；"},
        { "location": "81/SEL"    , "narrator": "", "text": "心配しすぎ"},
        { "location": "82/SEL"    , "narrator": "", "text": "荷物多くなって大変だね"},
        { "location": "83/SEL"    , "narrator": "", "text": "虫のいるところに行かなきゃいい"},
        { "location": "84/ACT"    , "narrator": "", "text": "心配しすぎ"},
        { "location": "85/TALK"   , "narrator": "アーヤ", "text": "心配しすぎなんかじゃないわよ（｀皿´ )"},
        { "location": "86/TALK"   , "narrator": "アーヤ", "text": "実際に刺されたんだから"},
        { "location": "87/ACT"    , "narrator": "", "text": "荷物多くなって大変だね"},
        { "location": "89/TALK"   , "narrator": "アーヤ", "text": "ねー(;^_^A"},
        { "location": "90/TALK"   , "narrator": "アーヤ", "text": "でも持ってると安心できるし"},
        { "location": "91/TALK"   , "narrator": "アーヤ", "text": "誰かが刺されても大丈夫だから＼(^O^)／"},
        { "location": "92/ACT"    , "narrator": "", "text": "虫のいるところに行かなきゃいい"},
        { "location": "93/TALK"   , "narrator": "アーヤ", "text": "どこにでもいるのよ虫って"},
        { "location": "94/TALK"   , "narrator": "アーヤ", "text": "もー！！！！！！"}
    ]
}
