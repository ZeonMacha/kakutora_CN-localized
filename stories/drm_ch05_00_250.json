        "title": "らぶとーく 第25話",
        "sub_title": "ネットスラングバトル"
    },
    "entry":
    [
        { "location": "2208/SCENARIO", "narrator": "", "text": "ネットスラングバトル"},
        { "location": "2223/TALK"    , "narrator": "みやび", "text": "…卯月、\nあれ見てみい。"},
        { "location": "2224/TALK"    , "narrator": "神楽", "text": "死んだ目をした\nサラリーマンが\n優先席に座ってますね。"},
        { "location": "2225/TALK"    , "narrator": "みやび", "text": "今は席も空いちゅう。\nけんどこの先は\n乗換駅や。"},
        { "location": "2226/TALK"    , "narrator": "みやび", "text": "満席になり\n目の前に優先すべき\n人が立った時。"},
        { "location": "2229/TALK"    , "narrator": "みやび", "text": "あのサラリーマンは\nどうするか\n予想してみんか？"},
        { "location": "2230/SEL"     , "narrator": "", "text": "$me$も参加する～！"},
        { "location": "2231/ACT"     , "narrator": "", "text": "$me$も参加する～！"},
        { "location": "2248/TALK"    , "narrator": "神楽", "text": "それなら直接みやびさんにﾄﾞｿﾞｰ"},
        { "location": "2250/SEL"     , "narrator": "", "text": "神楽と話したいんだよ"},
        { "location": "2251/SEL"     , "narrator": "", "text": "実際そうしたら妬くくせに"},
        { "location": "2252/SEL"     , "narrator": "", "text": "それじゃ意味ないんだよ"},
        { "location": "2253/ACT"     , "narrator": "", "text": "神楽と話したいんだよ"},
        { "location": "2254/TALK"    , "narrator": "神楽", "text": "ぴょんことか～"},
        { "location": "2255/TALK"    , "narrator": "神楽", "text": "また後でね♪"},
        { "location": "2257/ACT"     , "narrator": "", "text": "実際そうしたら妬くくせに"},
        { "location": "2259/TALK"    , "narrator": "神楽", "text": "はぁぁぁぁぁぁぁぁぁぁぁぁぁぁ！？"},
        { "location": "2260/TALK"    , "narrator": "神楽", "text": "べ、別にそんなわけないじゃない！！！！"},
        { "location": "2261/TALK"    , "narrator": "神楽", "text": "うぬぼれないでよねっ！"},
        { "location": "2266/ACT"     , "narrator": "", "text": "それじゃ意味ないんだよ"},
        { "location": "2267/TALK"    , "narrator": "神楽", "text": "ほんとうにそうかな？"},
        { "location": "2268/TALK"    , "narrator": "神楽", "text": "証明できないでしょ♪"},
        { "location": "2282/TALK"    , "narrator": "神楽", "text": "…相当疲れた顔を\nしていますからね…。"},
        { "location": "2283/TALK"    , "narrator": "神楽", "text": "寝たふり、ですかね…。"},
        { "location": "2285/TALK"    , "narrator": "みやび", "text": "なかなかえい線やと\n思うぞね。"},
        { "location": "2286/TALK"    , "narrator": "みやび", "text": "一番確実かつ\n簡単な方法やし。"},
        { "location": "2289/TALK"    , "narrator": "神楽", "text": "ＤＱＮ扱いも\nされにくい\nですしね。"},
        { "location": "2290/TALK"    , "narrator": "みやび", "text": "ＤＱＮ……。"},
        { "location": "2291/TALK"    , "narrator": "神楽", "text": "…私、何か変なこと\n言いました？"},
        { "location": "2292/TALK"    , "narrator": "みやび", "text": "そうでのうて…\nちっくと古い表現\nするねえと思うて。"},
        { "location": "2294/TALK"    , "narrator": "みやび", "text": "香ばしい、並みに\n懐かしい\nネットスラングやき。"},
        { "location": "2308/TALK"    , "narrator": "神楽", "text": "ちょ"},
        { "location": "2309/TALK"    , "narrator": "神楽", "text": "香ばしいって何？"},
        { "location": "2311/SEL"     , "narrator": "", "text": "焙煎時のかぐわしい香りとか"},
        { "location": "2312/SEL"     , "narrator": "", "text": "ヤバい人の比喩表現"},
        { "location": "2313/SEL"     , "narrator": "", "text": "ネットスラングには疎くて"},
        { "location": "2314/ACT"     , "narrator": "", "text": "焙煎時のかぐわしい香りとか"},
        { "location": "2315/TALK"    , "narrator": "神楽", "text": "あ゛あ゛あ゛あ゛あ゛あ゛"},
        { "location": "2316/TALK"    , "narrator": "神楽", "text": "絶対違うし"},
        { "location": "2318/ACT"     , "narrator": "", "text": "ヤバい人の比喩表現"},
        { "location": "2319/TALK"    , "narrator": "神楽", "text": "なる"},
        { "location": "2320/TALK"    , "narrator": "神楽", "text": "理解"},
        { "location": "2322/ACT"     , "narrator": "", "text": "ネットスラングには疎くて"},
        { "location": "2323/TALK"    , "narrator": "神楽", "text": "頃す"},
        { "location": "2326/SEL"     , "narrator": "", "text": "最近言葉遣い乱暴だよね？"},
        { "location": "2327/SEL"     , "narrator": "", "text": "素の神楽いただきました！"},
        { "location": "2328/SEL"     , "narrator": "", "text": "現代っ子のふりがんばって"},
        { "location": "2329/ACT"     , "narrator": "", "text": "最近言葉遣い乱暴だよね？"},
        { "location": "2330/TALK"    , "narrator": "神楽", "text": "気のせいですよ♪"},
        { "location": "2332/ACT"     , "narrator": "", "text": "素の神楽いただきました！"},
        { "location": "2333/TALK"    , "narrator": "神楽", "text": "違いますよ～～～？"},
        { "location": "2334/TALK"    , "narrator": "神楽", "text": "でもそうかもぴょん♪"},
        { "location": "2336/ACT"     , "narrator": "", "text": "現代っ子のふりがんばって"},
        { "location": "2337/TALK"    , "narrator": "神楽", "text": "言われなくてもやってるし！"},
        { "location": "2353/TALK"    , "narrator": "神楽", "text": "…その方がわかり\nやすいかなって\n思ってですね。"},
        { "location": "2355/TALK"    , "narrator": "みやび", "text": "確かに。\nうちにはこじゃんと\n伝わったき。"},
        { "location": "2356/TALK"    , "narrator": "みやび", "text": "それに懐かしい\n気持ちにも\nなれたしねえ。"},
        { "location": "2358/TALK"    , "narrator": "神楽", "text": "…年はほとんど\n変わらないじゃ\nないですか。"},
        { "location": "2361/TALK"    , "narrator": "神楽", "text": "なのにそんな\nおばあちゃんと\n話すみたいな。"},
        { "location": "2362/TALK"    , "narrator": "みやび", "text": "いやいや\nそういうつもりや\nのうて……。"},
        { "location": "2364/TALK"    , "narrator": "神楽", "text": "別に怒ってる\nつもりはない\nですけど…。"},
        { "location": "2367/TALK"    , "narrator": "神楽", "text": "あ。\n駅に着きましたね。"},
        { "location": "2368/TALK"    , "narrator": "神楽", "text": "どうするかちょっと\n観察しましょうか…？"},
        { "location": "2222/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>某月某日　5:37 PM</color>\nとある平日の放課後のこと"}
    ]
}
