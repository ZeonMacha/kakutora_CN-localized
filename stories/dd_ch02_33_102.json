{
    "dir": "chap33/daydra/dd_ch02_33_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "33205",
        "cid": "ayami",
        "title": "005 メインストーリー",
        "sub_title": "少女の器＜後編＞"
    },
    "entry":
    [
        { "location": "731/SCENARIO", "narrator": "", "text": "ずっと、奥底に、あった"},
        { "location": "749/TALK"    , "narrator": "アーヤ", "text": "……変なの。"},
        { "location": "750/TALK"    , "narrator": "アーヤ", "text": "私、すごく落ち着いてる。"},
        { "location": "751/TALK"    , "narrator": "アーヤ", "text": "それから、確信がある。\n私は死なない。"},
        { "location": "752/SEL"     , "narrator": "", "text": "アーヤ？"},
        { "location": "753/ACT"     , "narrator": "", "text": "アーヤ？"},
        { "location": "770/TALK"    , "narrator": "アーヤ", "text": "$handle$さん"},
        { "location": "772/SEL"     , "narrator": "", "text": "元気？"},
        { "location": "773/SEL"     , "narrator": "", "text": "ボーッとしてた？"},
        { "location": "774/ACT"     , "narrator": "", "text": "元気？"},
        { "location": "775/TALK"    , "narrator": "アーヤ", "text": "元気よ"},
        { "location": "776/ACT"     , "narrator": "", "text": "ボーッとしてた？"},
        { "location": "777/TALK"    , "narrator": "アーヤ", "text": "そうかもしれないわ"},
        { "location": "779/TALK"    , "narrator": "アーヤ", "text": "ねえ"},
        { "location": "780/TALK"    , "narrator": "アーヤ", "text": "これから"},
        { "location": "781/TALK"    , "narrator": "アーヤ", "text": "はいしか答えられないことを言うから"},
        { "location": "782/TALK"    , "narrator": "アーヤ", "text": "はいって言って"},
        { "location": "784/SEL"     , "narrator": "", "text": "強制なの？"},
        { "location": "785/SEL"     , "narrator": "", "text": "いいえの準備だ"},
        { "location": "786/SEL"     , "narrator": "", "text": "聞いてみないとわからない"},
        { "location": "787/ACT"     , "narrator": "", "text": "強制なの？"},
        { "location": "788/TALK"    , "narrator": "アーヤ", "text": "違うわ"},
        { "location": "789/ACT"     , "narrator": "", "text": "いいえの準備だ"},
        { "location": "790/TALK"    , "narrator": "アーヤ", "text": "無駄になるわよ"},
        { "location": "791/ACT"     , "narrator": "", "text": "聞いてみないとわからない"},
        { "location": "792/TALK"    , "narrator": "アーヤ", "text": "聞いたらはいって言うことになるわ"},
        { "location": "794/TALK"    , "narrator": "アーヤ", "text": "ずっと側にいて"},
        { "location": "795/TALK"    , "narrator": "アーヤ", "text": "私のことを見守っていて"},
        { "location": "797/SEL"     , "narrator": "", "text": "はい"},
        { "location": "798/SEL"     , "narrator": "", "text": "結婚するしかないね"},
        { "location": "799/SEL"     , "narrator": "", "text": "ずっと一緒にいるよ"},
        { "location": "800/ACT"     , "narrator": "", "text": "はい"},
        { "location": "801/TALK"    , "narrator": "アーヤ", "text": "ありがとう"},
        { "location": "802/ACT"     , "narrator": "", "text": "結婚するしかないね"},
        { "location": "803/TALK"    , "narrator": "アーヤ", "text": "結婚？"},
        { "location": "804/TALK"    , "narrator": "アーヤ", "text": "いいけどちょっと"},
        { "location": "805/TALK"    , "narrator": "アーヤ", "text": "不思議な感じ"},
        { "location": "807/SEL"     , "narrator": "", "text": "そんなことないでしょ"},
        { "location": "808/SEL"     , "narrator": "", "text": "それこそ運命なのに"},
        { "location": "809/SEL"     , "narrator": "", "text": "どこが不思議なの"},
        { "location": "810/ACT"     , "narrator": "", "text": "そんなことないでしょ"},
        { "location": "811/TALK"    , "narrator": "アーヤ", "text": "そうかしら"},
        { "location": "812/ACT"     , "narrator": "", "text": "それこそ運命なのに"},
        { "location": "813/TALK"    , "narrator": "アーヤ", "text": "そうかもしれないけど"},
        { "location": "814/ACT"     , "narrator": "", "text": "どこが不思議なの"},
        { "location": "815/TALK"    , "narrator": "アーヤ", "text": "うまく言えないけど"},
        { "location": "817/TALK"    , "narrator": "アーヤ", "text": "結婚って"},
        { "location": "818/TALK"    , "narrator": "アーヤ", "text": "恋愛の先にあるものだって"},
        { "location": "819/TALK"    , "narrator": "アーヤ", "text": "そう思ってた"},
        { "location": "820/TALK"    , "narrator": "アーヤ", "text": "でも"},
        { "location": "821/TALK"    , "narrator": "アーヤ", "text": "今$handle$さんとの間にあるのは"},
        { "location": "822/TALK"    , "narrator": "アーヤ", "text": "そういう感情より"},
        { "location": "823/TALK"    , "narrator": "アーヤ", "text": "もっと深いものだから"},
        { "location": "825/TALK"    , "narrator": "アーヤ", "text": "恋心みたいに消えるものじゃなくて"},
        { "location": "826/TALK"    , "narrator": "アーヤ", "text": "ずっと魂で結びついてるみたいな"},
        { "location": "827/TALK"    , "narrator": "アーヤ", "text": "そんな気持ちだから"},
        { "location": "829/SEL"     , "narrator": "", "text": "なんかすごいね？"},
        { "location": "830/SEL"     , "narrator": "", "text": "$me$もそう思ってた"},
        { "location": "831/SEL"     , "narrator": "", "text": "ラブもほしい！"},
        { "location": "832/ACT"     , "narrator": "", "text": "なんかすごいね？"},
        { "location": "833/TALK"    , "narrator": "アーヤ", "text": "どうしても大げさになるわね"},
        { "location": "834/TALK"    , "narrator": "アーヤ", "text": "言葉で伝えようとすると"},
        { "location": "835/TALK"    , "narrator": "アーヤ", "text": "難しいわ"},
        { "location": "836/TALK"    , "narrator": "アーヤ", "text": "説明が"},
        { "location": "837/ACT"     , "narrator": "", "text": "$me$もそう思ってた"},
        { "location": "838/TALK"    , "narrator": "アーヤ", "text": "本当？"},
        { "location": "839/TALK"    , "narrator": "アーヤ", "text": "やっぱり"},
        { "location": "840/TALK"    , "narrator": "アーヤ", "text": "私と$handle$さんは"},
        { "location": "841/TALK"    , "narrator": "アーヤ", "text": "そういうことなのね"},
        { "location": "842/ACT"     , "narrator": "", "text": "ラブもほしい！"},
        { "location": "843/TALK"    , "narrator": "アーヤ", "text": "どう言えばいいのかしら"},
        { "location": "844/TALK"    , "narrator": "アーヤ", "text": "ないわけじゃないの"},
        { "location": "845/TALK"    , "narrator": "アーヤ", "text": "でも少し違うの"},
        { "location": "846/TALK"    , "narrator": "アーヤ", "text": "難しいわ"},
        { "location": "848/TALK"    , "narrator": "アーヤ", "text": "$handle$さんは$handle$さん"},
        { "location": "849/TALK"    , "narrator": "アーヤ", "text": "それからすごくだいじなひと"},
        { "location": "850/TALK"    , "narrator": "アーヤ", "text": "うまく伝えられないけど"},
        { "location": "851/TALK"    , "narrator": "アーヤ", "text": "そういう人なの"},
        { "location": "852/TALK"    , "narrator": "アーヤ", "text": "私にとっては"},
        { "location": "853/ACT"     , "narrator": "", "text": "ずっと一緒にいるよ"},
        { "location": "854/TALK"    , "narrator": "アーヤ", "text": "うれしいわ"},
        { "location": "869/TALK"    , "narrator": "アーヤ", "text": "！"},
        { "location": "871/TALK"    , "narrator": "アーヤ", "text": "ギャヴィ、みやび。\n館長から準備完了の\n連絡があったわ。"},
        { "location": "872/TALK"    , "narrator": "アーヤ", "text": "サイネージに館長が\n映し出されたら\n救出開始よ。"},
        { "location": "873/TALK"    , "narrator": "透明ガブリエラ", "text": "ふうん。\nまほもやる時はやるわね。"},
        { "location": "874/TALK"    , "narrator": "透明みやび", "text": "いっつもそうやったら\n肩が凝って\n仕方ないろう。"},
        { "location": "875/TALK"    , "narrator": "アーヤ", "text": "……スタンバイ。\n各人、構えよ。"},
        { "location": "876/TALK"    , "narrator": "透明みやび", "text": "発煙手榴弾の\n安全ロック解除。"},
        { "location": "877/TALK"    , "narrator": "透明みやび", "text": "いつでも行けるき。"},
        { "location": "878/TALK"    , "narrator": "透明ガブリエラ", "text": "望むところよ。"},
        { "location": "879/TALK"    , "narrator": "アーヤ", "text": "…お願い。"},
        { "location": "880/TALK"    , "narrator": "透明みやび", "text": "オッケー。\n…発破！"},
        { "location": "888/TALK"    , "narrator": "アーヤ", "text": "絶対に成功させる！\n見守ってて、\n$handle$さん…！"},
        { "location": "905/DIALOG"  , "narrator": "Dialog_chapter_ch02", "text": "【27 シン・カグラ】"}
    ]
}
