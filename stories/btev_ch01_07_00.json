        "title": "010 ココロスフィアストーリー【Lv04】",
        "sub_title": "仁王門＜提起＞"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "仁王門"},
        { "location": "13/DIALOG" , "narrator": "", "text": "<size=40>KOKORO-Lv. 04</size>\nTSUBAME - OHSE\n\n<size=45>仁王門</size>\n<size=35>～彼女が抱える家庭の事情～</size>"},
        { "location": "25/TALK"   , "narrator": "啓介", "text": "おい、貴様！"},
        { "location": "26/SEL"    , "narrator": "（選択肢）", "text": "はい"},
        { "location": "27/SEL"    , "narrator": "（選択肢）", "text": "はい！お義父さん！"},
        { "location": "28/SEL"    , "narrator": "（選択肢）", "text": "どちら様でしょうか？"},
        { "location": "29/ACT"    , "narrator": "", "text": "はい"},
        { "location": "30/TALK"   , "narrator": "啓介", "text": "なぜここにいる！？"},
        { "location": "31/ACT"    , "narrator": "", "text": "はい！お義父さん！"},
        { "location": "33/TALK"   , "narrator": "啓介", "text": "貴様なぞに\nお義父さん呼ばわり\nされる覚えは無い！"},
        { "location": "34/TALK"   , "narrator": "啓介", "text": "なぜここにいる！？"},
        { "location": "35/ACT"    , "narrator": "", "text": "どちら様でしょうか？"},
        { "location": "36/TALK"   , "narrator": "啓介", "text": "貴様は知らなくても\nいいことだ。"},
        { "location": "37/TALK"   , "narrator": "啓介", "text": "それより、\nなぜここにいる！？"},
        { "location": "39/SEL"    , "narrator": "（選択肢）", "text": "す、すみません！来るところを間違えました！"},
        { "location": "40/SEL"    , "narrator": "（選択肢）", "text": "つばめさんの友だちです！から"},
        { "location": "41/SEL"    , "narrator": "（選択肢）", "text": "つばめさんのフィアンセですから"},
        { "location": "42/ACT"    , "narrator": "", "text": "す、すみません間違えました！"},
        { "location": "43/TALK"   , "narrator": "啓介", "text": "早くここから出ていけ！"},
        { "location": "45/ACT"    , "narrator": "", "text": "つばめさんの友だちです！"},
        { "location": "46/TALK"   , "narrator": "啓介", "text": "友だちだと？"},
        { "location": "47/TALK"   , "narrator": "啓介", "text": "ここは友だち如きが\n立ち入って良い場所\nではない！！"},
        { "location": "48/SEL"    , "narrator": "（選択肢）", "text": "すみません…"},
        { "location": "49/ACT"    , "narrator": "", "text": "すみません…"},
        { "location": "51/ACT"    , "narrator": "", "text": "つばめさんのフィアンセですから"},
        { "location": "53/TALK"   , "narrator": "啓介", "text": "…っ！？\n貴様正気か！？"},
        { "location": "54/SEL"    , "narrator": "（選択肢）", "text": "つばめさんをくださいとお父さんにお願いしに来ました"},
        { "location": "55/ACT"    , "narrator": "", "text": "つばめさんをくださいとお父さんにお願いしに来ました"},
        { "location": "57/TALK"   , "narrator": "啓介", "text": "……なんだと！？"},
        { "location": "58/TALK"   , "narrator": "啓介", "text": "どこの馬の骨かも\n分からんヤツに\nつばめをやるなど――"},
        { "location": "60/TALK"   , "narrator": "つばめ", "text": "ちょっと！\nお父さんっ！！"},
        { "location": "66/TALK"   , "narrator": "啓介", "text": "つばめか。\nお前には関係無い。\n向こうへ行きなさい。"},
        { "location": "67/TALK"   , "narrator": "つばめ", "text": "関係無くないよ！"},
        { "location": "68/TALK"   , "narrator": "つばめ", "text": "なんでお父さんが\nわたしの心の中に\nいるわけ！？"},
        { "location": "69/TALK"   , "narrator": "啓介", "text": "コイツに確かめたい\nことがあったからだ。"},
        { "location": "74/TALK"   , "narrator": "啓介", "text": "つばめを\nあの手この手で\n東京に誘い――"},
        { "location": "75/TALK"   , "narrator": "啓介", "text": "それでも飽き足らず\n東京に住むよう仕組ん\nだのは貴様だろう！"},
        { "location": "78/TALK"   , "narrator": "つばめ", "text": "ちょっ！\nちょっと待ってよ！"},
        { "location": "80/TALK"   , "narrator": "啓介", "text": "かあぁぁっ！！"},
        { "location": "93/TALK"   , "narrator": "啓介", "text": "何のマネだ！"},
        { "location": "95/TALK"   , "narrator": "つばめ", "text": "勝手に\n攻撃しないでよ！"},
        { "location": "96/SEL"    , "narrator": "（選択肢）", "text": "どうなってるの！？"},
        { "location": "97/ACT"    , "narrator": "", "text": "どうなってるの！？"},
        { "location": "105/TALK"  , "narrator": "つばめ", "text": "ごめんなさい。"},
        { "location": "106/TALK"  , "narrator": "つばめ", "text": "なんか心の中で\nお父さんのイメージが\n暴走してるみたい。"},
        { "location": "107/SEL"   , "narrator": "（選択肢）", "text": "イメージ？暴走？？"},
        { "location": "108/ACT"   , "narrator": "", "text": "イメージ？暴走？？"},
        { "location": "110/TALK"  , "narrator": "つばめ", "text": "え、えっと！！"},
        { "location": "111/TALK"  , "narrator": "つばめ", "text": "後でちゃんと\n説明するから\nとにかく――"},
        { "location": "112/TALK"  , "narrator": "つばめ", "text": "今はこの暴走しちゃっ\nてるお父さんを\n止めるの手伝って！"},
        { "location": "113/SEL"   , "narrator": "（選択肢）", "text": "えええっ！！"},
        { "location": "114/ACT"   , "narrator": "", "text": "えええっ！！"},
        { "location": "121/TALK"  , "narrator": "つばめ", "text": "いくよっ！！"},
        { "location": "122/TALK"  , "narrator": "啓介", "text": "悪あがきしても\n無駄だ！！"},
        { "location": "124/TALK"  , "narrator": "啓介", "text": "出でよクラン！！\nこの不定な輩を\nたたき出せ！"},
        { "location": "139/DIALOG", "narrator": "", "text": "<color=black><size=50><b>暴走する父を倒し、\nつばめのココロを落ち着かせよ！</b></size></color>\n\n\n\n本心では納得していない父を\n静岡に置いてきたまま\n東京に滞在しているつばめ。\n\n普段全く気にしていないつもりでも\n心の中では大波乱。\n\nつばめの心の中で暴れる父を倒し、\n気持ちを落ち着かせてあげよう。"}
    ]
}
