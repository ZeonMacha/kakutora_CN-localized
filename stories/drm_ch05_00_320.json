    "entry":
    [
        { "location": "644/SCENARIO", "narrator": "", "text": "報道関係者各位"},
        { "location": "657/TALK"    , "narrator": "神楽", "text": "「情報管理庁\n　フェノメノン概況」"},
        { "location": "658/TALK"    , "narrator": "神楽", "text": "「現在フェノメノンに関する\n　緊急告知はありません」"},
        { "location": "659/TALK"    , "narrator": "神楽", "text": "「皆様の日頃のご理解、\n　ご協力に感謝いたします」"},
        { "location": "661/TALK"    , "narrator": "神楽", "text": "…ふうん…。"},
        { "location": "667/TALK"    , "narrator": "神楽", "text": "フェノメノンがこのまま発生しなくなったりしないかな？"},
        { "location": "668/TALK"    , "narrator": "神楽", "text": "どう思う？"},
        { "location": "670/SEL"     , "narrator": "", "text": "それはないんじゃないかな…"},
        { "location": "671/SEL"     , "narrator": "", "text": "そう思いたい気持ちはわかる"},
        { "location": "672/SEL"     , "narrator": "", "text": "どうだろう"},
        { "location": "673/ACT"     , "narrator": "", "text": "それはないんじゃないかな…"},
        { "location": "675/TALK"    , "narrator": "神楽", "text": "知ってたぴょん"},
        { "location": "678/ACT"     , "narrator": "", "text": "そう思いたい気持ちはわかる"},
        { "location": "679/TALK"    , "narrator": "神楽", "text": "そうでしょ"},
        { "location": "680/TALK"    , "narrator": "神楽", "text": "ﾊｧｧｧｧ、、、、"},
        { "location": "683/ACT"     , "narrator": "", "text": "どうだろう"},
        { "location": "684/TALK"    , "narrator": "神楽", "text": "優柔不断！"},
        { "location": "685/TALK"    , "narrator": "神楽", "text": "ﾑｩｩｩｩ、、、"},
        { "location": "693/TALK"    , "narrator": "神楽", "text": "この世界は\nフェノメノンが\n発生するのが当たり前。"},
        { "location": "694/TALK"    , "narrator": "神楽", "text": "そういう前提で\n動いてる。"},
        { "location": "695/TALK"    , "narrator": "神楽", "text": "それを受け入れて\n日常生活を\n送ってる。"},
        { "location": "696/SEL"     , "narrator": "", "text": "神楽"},
        { "location": "698/TALK"    , "narrator": "神楽", "text": "この状況に\n慣れてしまってるのは\n時間が経ったせい？"},
        { "location": "699/TALK"    , "narrator": "神楽", "text": "それとも……。"},
        { "location": "701/ACT"     , "narrator": "", "text": "神楽"},
        { "location": "712/TALK"    , "narrator": "神楽", "text": "はいはい"},
        { "location": "713/TALK"    , "narrator": "神楽", "text": "ぴょんこだけど"},
        { "location": "715/SEL"     , "narrator": "", "text": "難しいこと考えてる？"},
        { "location": "716/SEL"     , "narrator": "", "text": "あんまり思い詰めないで"},
        { "location": "717/SEL"     , "narrator": "", "text": "$me$と楽しい話をしようよ"},
        { "location": "718/ACT"     , "narrator": "", "text": "難しいこと考えてる？"},
        { "location": "719/TALK"    , "narrator": "神楽", "text": "そういうわけじゃないぴょん"},
        { "location": "720/ACT"     , "narrator": "", "text": "あんまり思い詰めないで"},
        { "location": "721/TALK"    , "narrator": "神楽", "text": "そう見えた？"},
        { "location": "722/ACT"     , "narrator": "", "text": "$me$と楽しい話をしようよ"},
        { "location": "723/TALK"    , "narrator": "神楽", "text": "楽しい話か～～～～"},
        { "location": "725/TALK"    , "narrator": "神楽", "text": "もしかしたらなんだけどさ"},
        { "location": "726/TALK"    , "narrator": "神楽", "text": "ぴょんこがこの世界にいるから"},
        { "location": "727/TALK"    , "narrator": "神楽", "text": "この世界でもフェノメノンが発生してるって可能性が微レ存"},
        { "location": "729/SEL"     , "narrator": "", "text": "うーん…"},
        { "location": "730/SEL"     , "narrator": "", "text": "それはないでしょ"},
        { "location": "731/SEL"     , "narrator": "", "text": "微レ存って何？！"},
        { "location": "732/ACT"     , "narrator": "", "text": "うーん…"},
        { "location": "733/TALK"    , "narrator": "神楽", "text": "どっちとも言い切れないぴょん？"},
        { "location": "734/ACT"     , "narrator": "", "text": "それはないでしょ"},
        { "location": "735/TALK"    , "narrator": "神楽", "text": "おっおっ？"},
        { "location": "736/TALK"    , "narrator": "神楽", "text": "断定した！"},
        { "location": "738/TALK"    , "narrator": "神楽", "text": "っていうか"},
        { "location": "739/TALK"    , "narrator": "神楽", "text": "考えなし？"},
        { "location": "742/ACT"     , "narrator": "", "text": "微レ存って何？！"},
        { "location": "743/TALK"    , "narrator": "神楽", "text": "微粒子レベルで存在している"},
        { "location": "744/TALK"    , "narrator": "神楽", "text": "の略だぴょん♪"},
        { "location": "746/TALK"    , "narrator": "神楽", "text": "こういうの考え出したらきりがないけど"},
        { "location": "747/TALK"    , "narrator": "神楽", "text": "一度思いついちゃったらそのことで頭の中がｸﾞﾙｸﾞﾙｸﾞﾙｸﾞﾙｸﾞﾙになっちゃうぴょん"},
        { "location": "749/SEL"     , "narrator": "", "text": "あんまり思い詰めないで"},
        { "location": "750/SEL"     , "narrator": "", "text": "一旦リセットしよう！"},
        { "location": "751/SEL"     , "narrator": "", "text": "$me$は神楽の周りをｸﾞﾙｸﾞﾙｸﾞﾙｸﾞﾙｸﾞﾙ"},
        { "location": "752/ACT"     , "narrator": "", "text": "あんまり思い詰めないで"},
        { "location": "754/TALK"    , "narrator": "神楽", "text": "ﾄｩﾝｸ、、、"},
        { "location": "756/ACT"     , "narrator": "", "text": "一旦リセットしよう！"},
        { "location": "757/TALK"    , "narrator": "神楽", "text": "なるほど！"},
        { "location": "758/TALK"    , "narrator": "神楽", "text": "それがいいぴょん"},
        { "location": "759/ACT"     , "narrator": "", "text": "$me$は神楽の周りをｸﾞﾙｸﾞﾙｸﾞﾙｸﾞﾙｸﾞﾙ"},
        { "location": "760/TALK"    , "narrator": "神楽", "text": "じゃあ一緒にｸﾞﾙｸﾞﾙｸﾞﾙｸﾞﾙｸﾞﾙ"},
        { "location": "767/TALK"    , "narrator": "神楽", "text": "ふふ……。"},
        { "location": "768/SEL"     , "narrator": "", "text": "一言いい？"},
        { "location": "769/ACT"     , "narrator": "", "text": "一言いい？"},
        { "location": "781/SEL"     , "narrator": "", "text": "$me$は神楽の味方だから"},
        { "location": "782/SEL"     , "narrator": "", "text": "最後はきっとうまくいくから"},
        { "location": "783/SEL"     , "narrator": "", "text": "側にずっといるからね"},
        { "location": "784/ACT"     , "narrator": "", "text": "$me$は神楽の味方だから"},
        { "location": "785/TALK"    , "narrator": "神楽", "text": "そんなの知ってるぴょん♪"},
        { "location": "787/ACT"     , "narrator": "", "text": "最後はきっとうまくいくから"},
        { "location": "788/TALK"    , "narrator": "神楽", "text": "ハッピーエンドでハッピーフォーエバー！"},
        { "location": "789/ACT"     , "narrator": "", "text": "側にずっといるからね"},
        { "location": "790/TALK"    , "narrator": "神楽", "text": "一万年と二千年超えても？"},
        { "location": "791/TALK"    , "narrator": "神楽", "text": "ずっとずっといてくれる？？？"},
        { "location": "798/TALK"    , "narrator": "神楽", "text": "…なんて…。"},
        { "location": "799/TALK"    , "narrator": "神楽", "text": "そんなこと\n言ってても…。"},
        { "location": "655/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>某月某日　4:42 PM</color>\nとある平日の放課後のこと"}
    ]
}
