{
    "dir": "chap05/daydra/dd_ch02_05_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "5202",
        "cid": "ayami",
        "title": "002 メインストーリー",
        "sub_title": "劇場の日常＜前編＞"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "幽霊の出る指令本部"},
        { "location": "37/TALK"   , "narrator": "アーヤ", "text": "状況完了。\nこれより帰還します。"},
        { "location": "38/TALK"   , "narrator": "真幌", "text": "了解。\n任務ご苦労だった。"},
        { "location": "45/TALK"   , "narrator": "アーヤ", "text": "さてと、\n顔バレする前に\n劇場に戻りましょ。"},
        { "location": "47/TALK"   , "narrator": "ガブリエラ", "text": "っていうかさー、\n顔バレ対策なのは\nわかるけど――"},
        { "location": "48/TALK"   , "narrator": "ガブリエラ", "text": "指令室が場末の\n映画館、って、\n納得いかなくない？"},
        { "location": "50/TALK"   , "narrator": "アーヤ", "text": "まあ、館長の趣味も\n多少入ってるとは\n思うから――"},
        { "location": "52/TALK"   , "narrator": "アーヤ", "text": "そっとしておいた\n方がいいと思うわ。\nさ、行きましょ。"},
        { "location": "86/TALK"   , "narrator": "みやび", "text": "…まあ、まほさんの\n趣味でも、隠れ蓑と\nしては最高やね。"},
        { "location": "87/TALK"   , "narrator": "みやび", "text": "トライナリーの\nアジトがこんな\nレトロな劇場とは――"},
        { "location": "89/TALK"   , "narrator": "みやび", "text": "誰も、夢にも\n思わんやろ。"},
        { "location": "91/TALK"   , "narrator": "ガブリエラ", "text": "あたしだって、\n最初は冗談かと\n思ったわ。"},
        { "location": "94/TALK"   , "narrator": "アーヤ", "text": "私達がそう思えるなら\nこれからもバレる\n心配はなさそうね。"},
        { "location": "124/TALK"  , "narrator": "真幌", "text": "三人とも、\nご苦労だったな。"},
        { "location": "126/TALK"  , "narrator": "ガブリエラ", "text": "まったくよ。\n今日は本当に\n大変だったわ。"},
        { "location": "128/TALK"  , "narrator": "真幌", "text": "わかっている。\n劇場のスクリーンで\n見てたからな。"},
        { "location": "131/TALK"  , "narrator": "真幌", "text": "今回はイレギュラーな\nことも多かったが――"},
        { "location": "132/TALK"  , "narrator": "真幌", "text": "そっちは管理庁の方で\n対応する。\nおまえ等は休め。"},
        { "location": "135/TALK"  , "narrator": "アーヤ", "text": "わかりました。\nあ、でもバイトは\nどうします？"},
        { "location": "138/TALK"  , "narrator": "真幌", "text": "ん？　そういえば、\n今日も営業日\nだったか…。"},
        { "location": "140/TALK"  , "narrator": "真幌", "text": "まあ、どうせ客なんぞ\n来ないだろうし――"},
        { "location": "141/TALK"  , "narrator": "真幌", "text": "適当にやってるフリを\nしておいてくれ。"},
        { "location": "144/TALK"  , "narrator": "真幌", "text": "では、私は管理庁に\n報告書を置きに行く。\nあとは任せたぞ。"},
        { "location": "149/TALK"  , "narrator": "みやび", "text": "…映画館がアジト\nっちゅうのは\nえいとして――"},
        { "location": "150/TALK"  , "narrator": "みやび", "text": "実際に、うちらに\nバイトさせる\n必要あるか？"},
        { "location": "152/TALK"  , "narrator": "アーヤ", "text": "はいはい、ぼやくのは\nそこまで。"},
        { "location": "153/TALK"  , "narrator": "アーヤ", "text": "もう劇場開ける時間\nだから、持ち場に\nついて。"},
        { "location": "155/TALK"  , "narrator": "ガブリエラ", "text": "まだ早いわよ。\nもう少しのんびり\nしてもいいでしょ？"},
        { "location": "158/TALK"  , "narrator": "みやび", "text": "ガブちゃんに賛成。\n世界を救ったばかりの\nうちらには――"},
        { "location": "161/TALK"  , "narrator": "みやび", "text": "のんびり身体を休める\n権利があるがよ。"},
        { "location": "164/TALK"  , "narrator": "アーヤ", "text": "バイトも私達の\n仕事なんだから――"},
        { "location": "166/TALK"  , "narrator": "アーヤ", "text": "文句言わずに\n持ち場について。"},
        { "location": "167/TALK"  , "narrator": "ガブリエラ", "text": "はぁ…アーヤって、\n本当カタブツよね…。"},
        { "location": "168/TALK"  , "narrator": "アーヤ", "text": "ちょっと、何よそれ？"},
        { "location": "170/TALK"  , "narrator": "ガブリエラ", "text": "そんな急がなくても、\nお客なんて来ない\nわよ。"},
        { "location": "171/TALK"  , "narrator": "みやび", "text": "客が来ないのに\n急ぐ必要なんぞ\nないちや。"},
        { "location": "173/TALK"  , "narrator": "みやび", "text": "早く開けて無理に\nバイトしよう\n思うんは――"},
        { "location": "175/TALK"  , "narrator": "みやび", "text": "人生を無駄にするんも\n同然の行為ぞね。"},
        { "location": "176/TALK"  , "narrator": "アーヤ", "text": "バイトだって\n仕事なんだから、\n責任感持ちなさいよ。"},
        { "location": "178/TALK"  , "narrator": "みやび", "text": "うちの責任感は\n戦闘で使いつくして\nしもうたき――"},
        { "location": "179/TALK"  , "narrator": "みやび", "text": "今はエンプティ状態で\nスッカラカンやぞ。"},
        { "location": "180/TALK"  , "narrator": "アーヤ", "text": "あのね…。"},
        { "location": "181/TALK"  , "narrator": "ガブリエラ", "text": "アーヤはさ、\nあれよね？"},
        { "location": "182/TALK"  , "narrator": "ガブリエラ", "text": "まほにとっての\nいい子でいたい、\nってだけでしょ？"},
        { "location": "183/TALK"  , "narrator": "アーヤ", "text": "ちょ、何よそれ？\n私は別に…。"},
        { "location": "185/TALK"  , "narrator": "みやび", "text": "いや、ガブちゃん。\nアーヤはそうでないと\nうちらが困るがよ。"},
        { "location": "186/TALK"  , "narrator": "みやび", "text": "アーヤがえい子で\nいようと頑張って\nくれちょるき――"},
        { "location": "187/TALK"  , "narrator": "みやび", "text": "うちらが不真面目でも\n許されるがよ。"},
        { "location": "188/TALK"  , "narrator": "アーヤ", "text": "…………。"},
        { "location": "189/TALK"  , "narrator": "アーヤ", "text": "全部が本気、って\nわけじゃないだろう\nけど――"},
        { "location": "190/TALK"  , "narrator": "アーヤ", "text": "ある程度本音が\n混じってそうね…。"},
        { "location": "191/TALK"  , "narrator": "アーヤ", "text": "そんな風に思われてた\nなんて…ちょっと\nショック…。"},
        { "location": "192/SEL"   , "narrator": "", "text": "先輩だしリーダーなんだから、ガツンと言ってやれ！"},
        { "location": "193/SEL"   , "narrator": "", "text": "このままだと嫌われちゃうね"},
        { "location": "195/TALK"  , "narrator": "アーヤ", "text": "…いい加減、劇場を\n開けないといけない\n時間なのに。"},
        { "location": "196/TALK"  , "narrator": "アーヤ", "text": "このままだと、\n館長にも怒られるの、\nわからないのかしら？"},
        { "location": "200/TALK"  , "narrator": "アーヤ", "text": "…困ったわ。"},
        { "location": "202/ACT"   , "narrator": "", "text": "先輩だしリーダーなんだから、ガツンと言ってやれ！"},
        { "location": "227/TALK"  , "narrator": "アーヤ", "text": "結構言ってるつもりなんだけど？"},
        { "location": "228/TALK"  , "narrator": "アーヤ", "text": "もっと言わないとダメ？"},
        { "location": "229/TALK"  , "narrator": "アーヤ", "text": "でも"},
        { "location": "230/TALK"  , "narrator": "アーヤ", "text": "出撃の後なのは確かだし"},
        { "location": "231/TALK"  , "narrator": "アーヤ", "text": "それに"},
        { "location": "232/TALK"  , "narrator": "アーヤ", "text": "あまり強く言ったら"},
        { "location": "233/TALK"  , "narrator": "アーヤ", "text": "嫌われちゃうかもしれないし"},
        { "location": "244/ACT"   , "narrator": "", "text": "このままだと嫌われちゃうね"},
        { "location": "269/TALK"  , "narrator": "アーヤ", "text": "なんか"},
        { "location": "270/TALK"  , "narrator": "アーヤ", "text": "もう嫌われてるのかも"},
        { "location": "271/TALK"  , "narrator": "アーヤ", "text": "館長の前でだけ"},
        { "location": "272/TALK"  , "narrator": "アーヤ", "text": "いい子にしてると思われてるみたいだし"},
        { "location": "284/TALK"  , "narrator": "アーヤ", "text": "もう時間がないのに、\nどうしよう…。"},
        { "location": "330/TALK"  , "narrator": "アーヤ", "text": "あら、[ココロゲート]へ\nようこそ。\nお早いお着きね。"},
        { "location": "331/TALK"  , "narrator": "アーヤ", "text": "ごめんなさいね。\nまたココロにロックが\nかかっちゃったみたい。"},
        { "location": "332/TALK"  , "narrator": "アーヤ", "text": "早速その【問題の扉】を\n呼び出すわね。"},
        { "location": "339/TALK"  , "narrator": "アーヤ", "text": "オープンプロセス、\n0x992番地から\n0x044番地へ。"},
        { "location": "354/TALK"  , "narrator": "アーヤ", "text": "シーク完了。"},
        { "location": "357/TALK"  , "narrator": "アーヤ", "text": "さて、今回の\nロックの原因は……？"},
        { "location": "358/TALK"  , "narrator": "アーヤ", "text": "…。"},
        { "location": "359/TALK"  , "narrator": "アーヤ", "text": "……。"},
        { "location": "360/TALK"  , "narrator": "アーヤ", "text": "なるほど。\n前回と大して変わらない\n理由なのね。"},
        { "location": "361/TALK"  , "narrator": "アーヤ", "text": "自分の事ながら\n苦笑するしかないわ。"},
        { "location": "362/SEL"   , "narrator": "", "text": "なに？"},
        { "location": "363/ACT"   , "narrator": "", "text": "なに？"},
        { "location": "365/TALK"  , "narrator": "アーヤ", "text": "また体裁を気にする\n自分と、責務を果たす\n自分が葛藤してる。"},
        { "location": "366/TALK"  , "narrator": "アーヤ", "text": "まあ今回の件は、\n現実世界で見たことが\n全てだと思うわよ？"},
        { "location": "367/SEL"   , "narrator": "", "text": "確かに"},
        { "location": "368/ACT"   , "narrator": "", "text": "確かに"},
        { "location": "370/TALK"  , "narrator": "アーヤ", "text": "こんな不甲斐ない\n私ですけど、また\n協力してくれないかしら。"},
        { "location": "371/SEL"   , "narrator": "", "text": "もちろん"},
        { "location": "372/SEL"   , "narrator": "", "text": "人とはそういう生き物"},
        { "location": "373/ACT"   , "narrator": "", "text": "もちろん"},
        { "location": "374/TALK"  , "narrator": "アーヤ", "text": "ふふ、ありがと。\n恩にきるわ。"},
        { "location": "375/ACT"   , "narrator": "", "text": "人とはそういう生き物"},
        { "location": "376/TALK"  , "narrator": "アーヤ", "text": "そうね、ホントに。"},
        { "location": "377/TALK"  , "narrator": "アーヤ", "text": "何が正しいって\n自分でわかってるのに、\nそれを選択できない。"},
        { "location": "378/TALK"  , "narrator": "アーヤ", "text": "自分にとって正しい選択を\n阻止する[クラン]は、\n誰の心にもいるものね。"},
        { "location": "380/TALK"  , "narrator": "アーヤ", "text": "それじゃ、この扉のこと\n宜しくお願いします。"},
        { "location": "382/TALK"  , "narrator": "アーヤ", "text": "$handle$さんと\n國政綾水にとって、\n素敵なココロの旅を！"},
        { "location": "36/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>5月3日　7:22 PM</color>\nFreyMENOWライブ戦でのフェノメノン収束直後、現場にて。"},
        { "location": "296/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"}
    ]
}
