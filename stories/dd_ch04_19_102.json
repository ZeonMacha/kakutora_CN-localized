{
    "dir": "chap19/daydra/dd_ch04_19_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "19405",
        "cid": "miyabi",
        "title": "005 メインストーリー",
        "sub_title": "気にしすぎのHACK＜後編＞"
    },
    "entry":
    [
        { "location": "393/TALK"  , "narrator": "みやび", "text": "情けない"},
        { "location": "394/TALK"  , "narrator": "みやび", "text": "土壇場で怖気づくとは"},
        { "location": "395/TALK"  , "narrator": "みやび", "text": "まったく"},
        { "location": "396/TALK"  , "narrator": "みやび", "text": "悩む必要などない"},
        { "location": "397/TALK"  , "narrator": "みやび", "text": "うちの心は決まっちょる"},
        { "location": "404/TALK"  , "narrator": "みやび", "text": "…ウサギ。\n心配はいらんがよ。"},
        { "location": "405/TALK"  , "narrator": "みやび", "text": "うちの覚悟はもう\n決まっちょるぞね。"},
        { "location": "406/TALK"  , "narrator": "繭", "text": "…本気なんですね？"},
        { "location": "407/TALK"  , "narrator": "みやび", "text": "もちろんや。"},
        { "location": "409/TALK"  , "narrator": "みやび", "text": "管理庁が隠している\n秘密を暴くと\n最初から決めちょった。"},
        { "location": "410/TALK"  , "narrator": "みやび", "text": "最初はうちだけの\n事情やった。\nけんど、今は違う。"},
        { "location": "411/TALK"  , "narrator": "みやび", "text": "うちだけやのうて、\n仲間たちにも関係の\nあることになった。"},
        { "location": "413/TALK"  , "narrator": "繭", "text": "…トライナリーは、\n管理庁管轄の部隊\nですからね。"},
        { "location": "414/TALK"  , "narrator": "みやび", "text": "そうや。"},
        { "location": "416/TALK"  , "narrator": "みやび", "text": "騙されたまま、\nっちゅうのは\n気に入らんし。"},
        { "location": "417/TALK"  , "narrator": "みやび", "text": "それに、仲間内で\n調べるスキルが\nあるんはうちだけや。"},
        { "location": "418/TALK"  , "narrator": "繭", "text": "…………。"},
        { "location": "419/TALK"  , "narrator": "みやび", "text": "うちはやるがよ、\nウサギ。"},
        { "location": "421/TALK"  , "narrator": "みやび", "text": "管理庁相手に、\n真っ向から戦争\n吹っかけてやるちや。"},
        { "location": "422/TALK"  , "narrator": "繭", "text": "…それを聞いて、\n安心しました。"},
        { "location": "424/TALK"  , "narrator": "繭", "text": "みやび先輩の覚悟が\n決まっているなら。"},
        { "location": "426/TALK"  , "narrator": "繭", "text": "私も、安心して\nついていけます。"},
        { "location": "427/TALK"  , "narrator": "みやび", "text": "…いや。"},
        { "location": "428/TALK"  , "narrator": "みやび", "text": "ウサギはもう、\nここで降りた方が\nえいと思う。"},
        { "location": "429/TALK"  , "narrator": "繭", "text": "…何故ですか？"},
        { "location": "430/TALK"  , "narrator": "みやび", "text": "管理庁のことは\nウサギ個人には\nメリットはないろう？"},
        { "location": "431/TALK"  , "narrator": "みやび", "text": "それに、ここから先は\nまっことデンジャー\nゾーンやし…。"},
        { "location": "433/TALK"  , "narrator": "繭", "text": "…何を言うかと\n思えば。"},
        { "location": "435/TALK"  , "narrator": "繭", "text": "私は最初から\n覚悟していました。"},
        { "location": "436/TALK"  , "narrator": "繭", "text": "そしてそれを\n望んでいました。"},
        { "location": "438/TALK"  , "narrator": "繭", "text": "ＦａｔａｌＱｕｅｅｎ。\nあなたに出会った\nその時から。"},
        { "location": "439/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "440/TALK"  , "narrator": "繭", "text": "今更、そんな理由で\n引けと言われても\n従えません。"},
        { "location": "441/TALK"  , "narrator": "繭", "text": "第一、ここで\n戦力を低下させるなんて\n下策すぎます。"},
        { "location": "442/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "443/TALK"  , "narrator": "繭", "text": "そうでしょう？"},
        { "location": "444/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "445/TALK"  , "narrator": "繭", "text": "Ｒａｂｂｉｔ\nＡｎｉｍａを\nなめないでください。"},
        { "location": "447/TALK"  , "narrator": "みやび", "text": "……プッ。"},
        { "location": "449/TALK"  , "narrator": "繭", "text": "何で\n笑うんですか！？"},
        { "location": "451/TALK"  , "narrator": "みやび", "text": "……いや……。"},
        { "location": "453/TALK"  , "narrator": "みやび", "text": "…ウサギの中身は\nオッサンやと思うてた\nのになあって。"},
        { "location": "455/TALK"  , "narrator": "繭", "text": "！？"},
        { "location": "456/TALK"  , "narrator": "みやび", "text": "うちもまだまだ\nやったねえ。"},
        { "location": "457/TALK"  , "narrator": "繭", "text": "お、オッサンって…。"},
        { "location": "458/TALK"  , "narrator": "繭", "text": "何が！？　何が原因で\nそう思わせてしまった\nのですか！？"},
        { "location": "459/TALK"  , "narrator": "繭", "text": "私の発言がオッサン\n臭かったということ\nですか！？"},
        { "location": "462/TALK"  , "narrator": "みやび", "text": "いや、そうやない。"},
        { "location": "463/TALK"  , "narrator": "繭", "text": "では、私の作成した\nコードが原因ですか？"},
        { "location": "464/TALK"  , "narrator": "みやび", "text": "あ、それはちっくと\n関係あるな。"},
        { "location": "465/TALK"  , "narrator": "みやび", "text": "あんな渋いコードを\n書いちょるのが年下の\n女子高生とは思わん。"},
        { "location": "466/TALK"  , "narrator": "繭", "text": "なっ…。"},
        { "location": "467/TALK"  , "narrator": "みやび", "text": "こんなことがある\nなんて、夢にも\n思わんかったがよ。"},
        { "location": "468/TALK"  , "narrator": "繭", "text": "ど、どこが問題\nですか！？"},
        { "location": "469/TALK"  , "narrator": "繭", "text": "そのオッサン臭さを\n感じる部分はどの辺り\nなのですか！？"},
        { "location": "470/TALK"  , "narrator": "みやび", "text": "あー、落ち着け\nウサギ。\n別に気にせんでも…。"},
        { "location": "471/TALK"  , "narrator": "繭", "text": "気になります！"},
        { "location": "472/TALK"  , "narrator": "繭", "text": "渋いまでは許容範囲\nですが、オッサン臭い\nのは耐えられません！"},
        { "location": "474/TALK"  , "narrator": "みやび", "text": "ちょ、落ち着け\nウサギ。"},
        { "location": "476/TALK"  , "narrator": "みやび", "text": "――うわっ！？"},
        { "location": "494/TALK"  , "narrator": "繭", "text": "きゃあっ！"},
        { "location": "500/TALK"  , "narrator": "繭", "text": "…イタタタ。"},
        { "location": "501/TALK"  , "narrator": "みやび", "text": "…大丈夫か、ウサギ？"},
        { "location": "502/TALK"  , "narrator": "繭", "text": "え？"},
        { "location": "503/TALK"  , "narrator": "繭", "text": "な、なんてことを！\n私、みやび先輩を\n押し倒して…！！"},
        { "location": "504/TALK"  , "narrator": "繭", "text": "す、すみません！\nすぐに退きますから！"},
        { "location": "508/TALK"  , "narrator": "繭", "text": "も、もも！\n申し訳ありません！"},
        { "location": "511/TALK"  , "narrator": "みやび", "text": "あ～、構わん構わん。\n別に痛かったわけや\nないんやし。"},
        { "location": "512/TALK"  , "narrator": "繭", "text": "ですが…。"},
        { "location": "514/TALK"  , "narrator": "みやび", "text": "気にせんでえいって。\nオッサン臭い言うた\nうちのせいなんやし。"},
        { "location": "515/TALK"  , "narrator": "繭", "text": "…………。"},
        { "location": "517/TALK"  , "narrator": "みやび", "text": "まあ、とにかく、\nウサギも手伝って\nちゅうことで。"},
        { "location": "518/TALK"  , "narrator": "みやび", "text": "ありがたく協力して\nもらうき。\nよろしく頼むぞね。"},
        { "location": "519/TALK"  , "narrator": "繭", "text": "…………。"},
        { "location": "521/TALK"  , "narrator": "繭", "text": "…お任せください、\nみやび先輩！"},
        { "location": "523/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "524/TALK"  , "narrator": "繭", "text": "…何か？"},
        { "location": "526/TALK"  , "narrator": "みやび", "text": "いや…随分嬉しそうに\nしちょるきねえ。"},
        { "location": "527/TALK"  , "narrator": "みやび", "text": "今度はハグくらい\nしてくるかと思うて\n構えてるがよ。"},
        { "location": "529/TALK"  , "narrator": "繭", "text": "し、しません！\nそんなこと…。"},
        { "location": "530/TALK"  , "narrator": "繭", "text": "…ちょっと待って…！\nせっかく構えていて\nくれたのに…！"},
        { "location": "531/TALK"  , "narrator": "繭", "text": "これは自分で\nフラグ折った…！？"},
        { "location": "532/TALK"  , "narrator": "繭", "text": "…いやきっと冗談…\n冗談だから…。"},
        { "location": "533/TALK"  , "narrator": "繭", "text": "…はぁ…。"},
        { "location": "534/TALK"  , "narrator": "みやび", "text": "…………。"},
        { "location": "535/TALK"  , "narrator": "みやび", "text": "オッサン臭い言われて\nまっことショック\nやったみたいやな…。"},
        { "location": "538/TALK"  , "narrator": "みやび", "text": "もう、なるべく\n言わんようにするか。"},
        { "location": "549/DIALOG", "narrator": "Dialog_chapter_ch04", "text": "【MV EXE_GARBiELa】"}
    ]
}
