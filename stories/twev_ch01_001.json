        { "location": "104/TALK"  , "narrator": "つばめ", "text": "私と一緒だねヾ(o´∀｀o)ﾉ"},
        { "location": "105/SEL"   , "narrator": "（選択肢）", "text": "沢山食べられるからね"},
        { "location": "106/SEL"   , "narrator": "（選択肢）", "text": "ちょっとしか食べれないけど"},
