    "entry":
    [
        { "location": "28/TALK"   , "narrator": "透明ガブリエラ", "text": "う～ん…わからないわね。"},
        { "location": "29/TALK"   , "narrator": "透明ガブリエラ", "text": "回転寿司に行った記念に\n描いた絵が、どうして\nこんな絵になるわけ？"},
        { "location": "30/TALK"   , "narrator": "透明ガブリエラ", "text": "全然お寿司要素\nないじゃない…。"},
        { "location": "32/TALK"   , "narrator": "透明神楽", "text": "それには、つばめさんが\n大きく関係しているん\nです。"},
        { "location": "33/TALK"   , "narrator": "透明つばめ", "text": "えっ、わたし？"},
        { "location": "34/TALK"   , "narrator": "透明神楽", "text": "はい…つばめさん、\nお寿司屋で食べた物を\n覚えていますか？"},
        { "location": "36/TALK"   , "narrator": "透明つばめ", "text": "えっと、お寿司屋だから\nお寿司だと思うんだけど？"},
        { "location": "37/TALK"   , "narrator": "透明ガブリエラ", "text": "つばめ、あんた確か\nデザート二つも\n食べてなかった？"},
        { "location": "38/TALK"   , "narrator": "透明つばめ", "text": "えっ！？　だ、だって、\n食後のデザートは\n普通だよ？"},
        { "location": "39/TALK"   , "narrator": "透明ガブリエラ", "text": "…最後だけじゃなくて、\n二皿目でも食べてたわよ？"},
        { "location": "41/TALK"   , "narrator": "透明つばめ", "text": "あ、あはは…それは、\nえーっと…。"},
        { "location": "42/TALK"   , "narrator": "透明神楽", "text": "ふふっ、まさにそれが\nこの絵を描いた理由です。"},
        { "location": "43/TALK"   , "narrator": "透明神楽", "text": "あの時のつばめさんの\n行動が、あまりにも\n可愛過ぎたので。"},
        { "location": "44/TALK"   , "narrator": "透明神楽", "text": "私の力がオーバーフロー\n起こしてしまったんです。"},
        { "location": "45/TALK"   , "narrator": "透明ガブリエラ", "text": "…それで？"},
        { "location": "46/TALK"   , "narrator": "透明神楽", "text": "溢れた分はどうにかして\n発散しないといけないじゃ\nないですか。"},
        { "location": "47/TALK"   , "narrator": "透明神楽", "text": "なので、こういう時は\n踊るのが一番、という\n結論に至ったわけです。"},
        { "location": "49/TALK"   , "narrator": "透明ガブリエラ", "text": "丁寧な説明ありがと。\nまったく理解は\nできなかったけど。"},
        { "location": "50/TALK"   , "narrator": "透明神楽", "text": "えーっ、\nどうしてですか！？"},
        { "location": "51/TALK"   , "narrator": "透明神楽", "text": "つばめさん、あんなに\n幸せそうな可愛い顔で\n食べてたのに…。"},
        { "location": "53/TALK"   , "narrator": "透明つばめ", "text": "うぅ…。"},
        { "location": "55/TALK"   , "narrator": "つばめ", "text": "食事してるとこ"},
        { "location": "56/TALK"   , "narrator": "つばめ", "text": "ジッと見られてたみたぃヾ(｡>﹏<｡)ﾉﾞ"},
        { "location": "57/TALK"   , "narrator": "つばめ", "text": "恥ずかしぃ(/ω＼)"},
        { "location": "58/SEL"    , "narrator": "（選択肢）", "text": "お寿司屋行ったんだ？"},
        { "location": "59/SEL"    , "narrator": "（選択肢）", "text": "そういえば行ってたね"},
        { "location": "60/ACT"    , "narrator": "", "text": "お寿司屋行ったんだ？"},
