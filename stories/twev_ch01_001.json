        { "location": "76/TALK"   , "narrator": "つばめ", "text": "恥ずかしぃから"},
        { "location": "78/TALK"   , "narrator": "つばめ", "text": "ぁんまり見ちゃダメ(●ﾉωﾉ)"},
        { "location": "80/ACT"    , "narrator": "", "text": "そういえば行ってたね"},
