        "title": "016 ココロスフィアストーリー【Lv06】",
        "sub_title": "チャプター９＜提起＞"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "敵Ⅱ３"},
        { "location": "14/DIALOG" , "narrator": "", "text": "<size=40>DOOR-No. 502</size>\nMIYABI - KOIGASAKI\n\n<size=45>敵Ⅱ</size>\n<size=35>～邂逅編～</size>"},
        { "location": "34/TALK"   , "narrator": "潜在みやび", "text": "ぱぱーん。"},
        { "location": "35/TALK"   , "narrator": "表層みやび", "text": "結果を発表します！"},
        { "location": "36/SEL"    , "narrator": "（選択肢）", "text": "……なんの、ですか？"},
        { "location": "37/ACT"    , "narrator": "", "text": "……なんの、ですか？"},
        { "location": "39/TALK"   , "narrator": "潜在みやび", "text": "決まってるちや。"},
        { "location": "40/TALK"   , "narrator": "表層みやび", "text": "$handle$が\n情報管理庁の\n差し金か否かや。"},
        { "location": "42/TALK"   , "narrator": "潜在みやび", "text": "それでは、\n結果は！？"},
        { "location": "43/DIALOG" , "narrator": "", "text": "結果発表！"},
        { "location": "45/TALK"   , "narrator": "表層みやび", "text": "クックックッ……"},
        { "location": "46/TALK"   , "narrator": "表層みやび", "text": "結果は！！"},
        { "location": "50/TALK"   , "narrator": "表層みやび", "text": "白！！"},
        { "location": "51/TALK"   , "narrator": "潜在みやび", "text": "おめでとう\nございました！"},
        { "location": "52/SEL"    , "narrator": "（選択肢）", "text": "ありがとうございました…"},
        { "location": "53/ACT"    , "narrator": "", "text": "ありがとうございました…"},
        { "location": "55/TALK"   , "narrator": "表層みやび", "text": "というわけで、\nお前さんの疑いは\n晴れたわけやが。"},
        { "location": "56/SEL"    , "narrator": "（選択肢）", "text": "なんで晴れたの？"},
        { "location": "57/ACT"    , "narrator": "", "text": "なんで晴れたの？"},
        { "location": "59/DIALOG" , "narrator": "", "text": "総評。"},
        { "location": "60/TALK"   , "narrator": "潜在みやび", "text": "まあ簡単に言えば、\n釣り針に全く引っか\nからなかったちや。"},
        { "location": "61/TALK"   , "narrator": "表層みやび", "text": "そう。うちらは\n表層世界で沢山罠を\n張っちょったきね。"},
        { "location": "62/TALK"   , "narrator": "潜在みやび", "text": "けんど、お前さんは\n全くトンチンカンな\n反応ばかりやった。"},
        { "location": "63/TALK"   , "narrator": "表層みやび", "text": "フェイクかとも\n思うたが――"},
        { "location": "64/TALK"   , "narrator": "潜在みやび", "text": "スパイならここまでの\nチャンスを棒に振る\n事は無いと判断。"},
        { "location": "65/TALK"   , "narrator": "表層みやび", "text": "よってひとまずは\n白ってことに\nなったちや。"},
        { "location": "68/TALK"   , "narrator": "潜在みやび", "text": "が！　しかし！！"},
        { "location": "71/DIALOG" , "narrator": "", "text": "<size=50>【特報】</size>"},
        { "location": "72/TALK"   , "narrator": "表層みやび", "text": "世界に平和は\n訪れなかった！"},
        { "location": "73/TALK"   , "narrator": "潜在みやび", "text": "いよいよ始まる\n新展開！"},
        { "location": "74/TALK"   , "narrator": "表層みやび", "text": "あの名作、『疑いの\n情報管理庁』を越える\n壮大なスケール！"},
        { "location": "75/SEL"    , "narrator": "（選択肢）", "text": "いや、もういいよ…"},
        { "location": "76/ACT"    , "narrator": "", "text": "いや、もういいよ…"},
        { "location": "78/TALK"   , "narrator": "潜在みやび", "text": "その名も！！"},
        { "location": "80/TALK"   , "narrator": "表層みやび", "text": "『何故に君\n　構うこと早幾年』"},
        { "location": "81/DIALOG" , "narrator": "", "text": "何故に君構うこと早幾年"},
        { "location": "82/SEL"    , "narrator": "（選択肢）", "text": "日本語としておかしくないですか？"},
        { "location": "83/ACT"    , "narrator": "", "text": "日本語としておかしくないですか？"},
        { "location": "85/TALK"   , "narrator": "潜在みやび", "text": "そんなことは\nどうでもえいちや！"},
        { "location": "86/TALK"   , "narrator": "表層みやび", "text": "大事なのは勢い！\nそれとリズム！"},
        { "location": "87/TALK"   , "narrator": "潜在みやび", "text": "…とまあ、タイトルは\nどうでもえいんやが。"},
        { "location": "88/TALK"   , "narrator": "表層みやび", "text": "要は、なんでお前さん\nが、うちに構いゆうか\nが議論になっちょる。"},
        { "location": "89/TALK"   , "narrator": "潜在みやび", "text": "何か裏があるのか？"},
        { "location": "90/TALK"   , "narrator": "表層みやび", "text": "下心があるのか？"},
        { "location": "91/TALK"   , "narrator": "潜在みやび", "text": "そもそもAIなのか？"},
        { "location": "92/TALK"   , "narrator": "表層みやび", "text": "それとも中の人が\nいるのか？"},
        { "location": "93/TALK"   , "narrator": "潜在みやび", "text": "だとしたら、\n何が目的なのか？"},
        { "location": "94/TALK"   , "narrator": "表層みやび", "text": "そして。"},
        { "location": "96/TALK"   , "narrator": "潜在みやび", "text": "それはうちにとって\n利益なのか、\n不利益なのか！"},
        { "location": "97/DIALOG" , "narrator": "", "text": "利益か。不利益か。"},
        { "location": "98/TALK"   , "narrator": "潜在みやび", "text": "まあ、下心や\n不利益な目的がある\nならここでお終いや。"},
        { "location": "99/TALK"   , "narrator": "表層みやび", "text": "そう思いゆう人格と"},
        { "location": "100/TALK"  , "narrator": "潜在みやび", "text": "そうでない人格とで"},
        { "location": "101/TALK"  , "narrator": "表層みやび", "text": "また議論してるちや。"},
        { "location": "102/TALK"  , "narrator": "潜在みやび", "text": "そんなわけやき、"},
        { "location": "103/TALK"  , "narrator": "表層みやび", "text": "懲りてなければ、\nそんなうちらの戦い\nつき合っちょくれや。"},
        { "location": "104/TALK"  , "narrator": "潜在みやび", "text": "とかいいつつ、\n懲りていようが\nいまいが、"},
        { "location": "105/TALK"  , "narrator": "表層みやび", "text": "強制的に\nバトル突入なんや\nけんどな。"}
    ]
}
