{
    "dir": "chap08/daydra/dd_ch05_08_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "8505",
        "cid": "kagura",
        "title": "005 メインストーリー",
        "sub_title": "一触即発＜後編＞"
    },
    "entry":
    [
        { "location": "1327/TALK"  , "narrator": "神楽", "text": "…いけない。\nちょっと熱く\nなりすぎたかも。"},
        { "location": "1329/TALK"  , "narrator": "神楽", "text": "気持ちを\n落ち着けないと…。"},
        { "location": "1330/TALK"  , "narrator": "神楽", "text": "ふぅ…。"},
        { "location": "1342/TALK"  , "narrator": "神楽", "text": "$handle$さん"},
        { "location": "1343/TALK"  , "narrator": "神楽", "text": "今って大丈夫ですか？"},
        { "location": "1345/SEL"   , "narrator": "", "text": "もちろんいいよ"},
        { "location": "1346/SEL"   , "narrator": "", "text": "音羽との話は終わったの？"},
        { "location": "1347/ACT"   , "narrator": "", "text": "もちろんいいよ"},
        { "location": "1348/TALK"  , "narrator": "神楽", "text": "ありがとうございます"},
        { "location": "1349/ACT"   , "narrator": "", "text": "音羽との話は終わったの？"},
        { "location": "1350/TALK"  , "narrator": "神楽", "text": "伝えたいことは一通り話したので"},
        { "location": "1352/TALK"  , "narrator": "神楽", "text": "ちょっと冷静さを欠いていたようなので"},
        { "location": "1354/TALK"  , "narrator": "神楽", "text": "落ち着くためにお話ししたくて"},
        { "location": "1356/SEL"   , "narrator": "", "text": "冷静さを欠く気持ちはわかる"},
        { "location": "1357/SEL"   , "narrator": "", "text": "今は平気なの？"},
        { "location": "1358/ACT"   , "narrator": "", "text": "冷静さを欠く気持ちはわかる"},
        { "location": "1359/TALK"  , "narrator": "神楽", "text": "そう言ってもらえると少し気持ちがラクになります"},
        { "location": "1360/TALK"  , "narrator": "神楽", "text": "でもいけないことですよ"},
        { "location": "1361/TALK"  , "narrator": "神楽", "text": "それが原因で任務失敗なんてことになったら"},
        { "location": "1362/TALK"  , "narrator": "神楽", "text": "意味がなくなっちゃいますし"},
        { "location": "1363/ACT"   , "narrator": "", "text": "今は平気なの？"},
        { "location": "1364/TALK"  , "narrator": "神楽", "text": "とりあえずは"},
        { "location": "1365/TALK"  , "narrator": "神楽", "text": "スッキリとまではいきませんけど"},
        { "location": "1367/TALK"  , "narrator": "神楽", "text": "任務に就く前から色々と準備はしていたけど"},
        { "location": "1368/TALK"  , "narrator": "神楽", "text": "いざとなるとダメなもんですね"},
        { "location": "1369/TALK"  , "narrator": "神楽", "text": "もっと"},
        { "location": "1370/TALK"  , "narrator": "神楽", "text": "心を強く持たないと"},
        { "location": "1372/SEL"   , "narrator": "", "text": "無理はしないでね"},
        { "location": "1373/SEL"   , "narrator": "", "text": "辛くなったら手伝うからね"},
        { "location": "1374/ACT"   , "narrator": "", "text": "無理はしないでね"},
        { "location": "1375/TALK"  , "narrator": "神楽", "text": "しないですめばいいんですけど"},
        { "location": "1377/TALK"  , "narrator": "神楽", "text": "どうなるかわかりませんね"},
        { "location": "1388/TALK"  , "narrator": "神楽", "text": "…無理するな、か。"},
        { "location": "1389/TALK"  , "narrator": "神楽", "text": "本当、甘い人…。"},
        { "location": "1390/ACT"   , "narrator": "", "text": "辛くなったら手伝うからね"},
        { "location": "1391/TALK"  , "narrator": "神楽", "text": "じゃあまた今日みたいなときには"},
        { "location": "1392/TALK"  , "narrator": "神楽", "text": "お話相手になってくださいね"},
        { "location": "1403/TALK"  , "narrator": "神楽", "text": "…$handle$さん、か。"},
        { "location": "1404/TALK"  , "narrator": "神楽", "text": "私の目的を知っていても\n優しくしてくれるし…。"},
        { "location": "1405/TALK"  , "narrator": "神楽", "text": "味方、と思って\nいいのかな…？"},
        { "location": "1411/TALK"  , "narrator": "神楽", "text": "…あっ。"},
        { "location": "1417/TALK"  , "narrator": "神楽", "text": "…はい、卯月です。"},
        { "location": "1419/TALK"  , "narrator": "千羽鶴", "text": "こんばんは。\n初めての出撃、\nお疲れ様。"},
        { "location": "1420/TALK"  , "narrator": "神楽", "text": "…どうも。"},
        { "location": "1421/TALK"  , "narrator": "千羽鶴", "text": "逢瀬つばめとの\n接触についての\n報告を聞きたい。"},
        { "location": "1422/TALK"  , "narrator": "神楽", "text": "はい。フェノメノン内部で\nファーストコンタクトに\n成功し…。"},
        { "location": "1423/TALK"  , "narrator": "神楽", "text": "彼女のピンチを救った\nことで、自然と近づく\nことができました。"},
        { "location": "1424/TALK"  , "narrator": "神楽", "text": "その後の様子から見て、\n上手く友好な関係を\n作っていけそうです。"},
        { "location": "1425/TALK"  , "narrator": "千羽鶴", "text": "なるほど。\nフェノメノン収束後にも、\nなにかあった？"},
        { "location": "1426/TALK"  , "narrator": "神楽", "text": "はい、新人同士なので\n今日はほとんどの時間を\n一緒に過ごし…。"},
        { "location": "1427/TALK"  , "narrator": "神楽", "text": "さっきまで、劇場隣の\nテルマエに\n行っていました。"},
        { "location": "1428/TALK"  , "narrator": "千羽鶴", "text": "…驚いた。\n初日でそこまでの\n接近に成功するなんて。"},
        { "location": "1429/TALK"  , "narrator": "神楽", "text": "ですが――"},
        { "location": "1430/TALK"  , "narrator": "神楽", "text": "一点だけ、わからない\nことがあるんです。"},
        { "location": "1431/TALK"  , "narrator": "神楽", "text": "逢瀬つばめは、\n私が思っていたのとは、\n全くの別人でした。"},
        { "location": "1432/TALK"  , "narrator": "千羽鶴", "text": "と、いうと？"},
        { "location": "1433/TALK"  , "narrator": "神楽", "text": "ドームでの記憶がない。\n本人はそう言って\nいました。"},
        { "location": "1434/TALK"  , "narrator": "神楽", "text": "見たところ演技には\n思えませんでしたし、\nそうなると――"},
        { "location": "1435/TALK"  , "narrator": "千羽鶴", "text": "余計なことは\n考えなくていい。"},
        { "location": "1436/TALK"  , "narrator": "千羽鶴", "text": "あなたが今日会ったのは、\n間違いなく\n逢瀬つばめ本人。"},
        { "location": "1437/TALK"  , "narrator": "千羽鶴", "text": "記憶もなにも関係ない。\nあなたは自分の任務に\n集中すればいいだけ。"},
        { "location": "1438/TALK"  , "narrator": "神楽", "text": "…わかりました。"},
        { "location": "1439/TALK"  , "narrator": "千羽鶴", "text": "健闘を祈る。\n引き続き頑張って。"},
        { "location": "1445/TALK"  , "narrator": "神楽", "text": "…頑張れ、か。\nこっちの気も知らないで、\n簡単に…。"},
        { "location": "1446/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1454/TALK"  , "narrator": "透明神楽", "text": "…でも、やらないと。"},
        { "location": "1455/TALK"  , "narrator": "透明神楽", "text": "そのために、\n私はここまで\n来たんだから…。"},
        { "location": "1456/TALK"  , "narrator": "透明神楽", "text": "音羽…私、頑張るからね。"},
        { "location": "1465/DIALOG", "narrator": "Dialog_chapter_ch05", "text": "【06 史上最愛の作戦】"},
        { "location": "1477/DIALOG", "narrator": "Dialog_chapter_ch05", "text": "【06 史上最愛の作戦】"}
    ]
}
