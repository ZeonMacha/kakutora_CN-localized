    [
        { "location": "124/SCENARIO", "narrator": "", "text": "017_バイクの整備"},
        { "location": "149/TALK"    , "narrator": "アーヤ", "text": "バイクの整備したのよ"},
        { "location": "150/TALK"    , "narrator": "アーヤ", "text": "油まみれになっちゃうわね(￣Д￣ )"},
        { "location": "151/TALK"    , "narrator": "アーヤ", "text": "まあ"},
        { "location": "152/TALK"    , "narrator": "アーヤ", "text": "嫌いじゃないけど"},
        { "location": "154/SEL"     , "narrator": "", "text": "おつかれさま"},
        { "location": "155/SEL"     , "narrator": "", "text": "油まみれのアーヤに萌える"},
        { "location": "156/SEL"     , "narrator": "", "text": "カッコいい"},
        { "location": "157/ACT"     , "narrator": "", "text": "おつかれさま"},
        { "location": "158/TALK"    , "narrator": "アーヤ", "text": "あら"},
        { "location": "159/TALK"    , "narrator": "アーヤ", "text": "ありがとう(=^0^=)"},
        { "location": "160/ACT"     , "narrator": "", "text": "油まみれのアーヤに萌える"},
        { "location": "162/TALK"    , "narrator": "アーヤ", "text": "えーと(´o｀；"},
        { "location": "164/TALK"    , "narrator": "アーヤ", "text": "お断りしますm(_ _)m"},
        { "location": "165/ACT"     , "narrator": "", "text": "カッコいい"},
        { "location": "167/TALK"    , "narrator": "アーヤ", "text": "そう？"},
        { "location": "168/TALK"    , "narrator": "アーヤ", "text": "自分の乗るバイク暗い派ね"},
        { "location": "169/TALK"    , "narrator": "アーヤ", "text": "くらいはね"},
        { "location": "170/TALK"    , "narrator": "アーヤ", "text": "整備できるようになっとかないと"},
        { "location": "171/TALK"    , "narrator": "アーヤ", "text": "当然"},
        { "location": "173/TALK"    , "narrator": "アーヤ", "text": "タイヤ圧とか"},
        { "location": "174/TALK"    , "narrator": "アーヤ", "text": "オイル変えるとか"},
        { "location": "175/TALK"    , "narrator": "アーヤ", "text": "そのくらいはできて当たり前なんだけどね"},
        { "location": "177/SEL"     , "narrator": "", "text": "そうなの？"},
        { "location": "178/SEL"     , "narrator": "", "text": "またまた"},
        { "location": "179/SEL"     , "narrator": "", "text": "$me$も余裕でできるけど"},
        { "location": "180/ACT"     , "narrator": "", "text": "そうなの？"},
        { "location": "181/TALK"    , "narrator": "アーヤ", "text": "そういうものよ"},
        { "location": "182/ACT"     , "narrator": "", "text": "またまた"},
        { "location": "183/TALK"    , "narrator": "アーヤ", "text": "本当よ"},
        { "location": "184/ACT"     , "narrator": "", "text": "$me$も余裕でできるけど"},
        { "location": "185/TALK"    , "narrator": "アーヤ", "text": "へー（；￢＿￢）"},
        { "location": "186/TALK"    , "narrator": "アーヤ", "text": "じゃあ今度やってもらおうかしら(-ω-;)"},
        { "location": "188/TALK"    , "narrator": "アーヤ", "text": "バイク乗るならね"},
        { "location": "189/TALK"    , "narrator": "アーヤ", "text": "ちゃんと責任持たないと"},
        { "location": "191/SEL"     , "narrator": "", "text": "$me$はアーヤに責任持つよ！"},
        { "location": "192/SEL"     , "narrator": "", "text": "義務なんだ"},
        { "location": "193/SEL"     , "narrator": "", "text": "真面目だね"},
        { "location": "194/ACT"     , "narrator": "", "text": "$me$はアーヤに責任持つよ！"},
        { "location": "197/TALK"    , "narrator": "アーヤ", "text": "責任って"},
        { "location": "198/TALK"    , "narrator": "アーヤ", "text": "何を！？"},
        { "location": "201/SEL"     , "narrator": "", "text": "愛してる"},
        { "location": "205/ACT"     , "narrator": "", "text": "愛してる"},
        { "location": "207/TALK"    , "narrator": "アーヤ", "text": "口ばっかりね"},
        { "location": "208/TALK"    , "narrator": "アーヤ", "text": "誰が教えるのかしら"},
        { "location": "210/TALK"    , "narrator": "アーヤ", "text": "こんな言葉。。。"},
        { "location": "212/ACT"     , "narrator": "", "text": "義務なんだ"},
        { "location": "213/TALK"    , "narrator": "アーヤ", "text": "そうね(￣∇￣)"},
        { "location": "214/TALK"    , "narrator": "アーヤ", "text": "義務だわね"},
        { "location": "215/ACT"     , "narrator": "", "text": "真面目だね"},
        { "location": "216/TALK"    , "narrator": "アーヤ", "text": "よく言われる"},
        { "location": "217/TALK"    , "narrator": "アーヤ", "text": "うれしくないし(｀ヘ´) "},
        { "location": "219/TALK"    , "narrator": "アーヤ", "text": "これで明日も会長"},
        { "location": "220/TALK"    , "narrator": "アーヤ", "text": "わ"},
        { "location": "221/TALK"    , "narrator": "アーヤ", "text": "快調！！！！！！"}
    ]
}
