        { "location": "117/SEL" , "narrator": "", "text": "なんでもない"},
        { "location": "120/TALK", "narrator": "みやび", "text": "フリーズか？"},
        { "location": "121/TALK", "narrator": "みやび", "text": "再起動か？"},
        { "location": "123/TALK", "narrator": "みやび", "text": "ダメダメやね"},
        { "location": "197/ACT" , "narrator": "", "text": "プレゼントあるよ"},
        { "location": "199/TALK", "narrator": "みやび", "text": "おお"},
        { "location": "200/TALK", "narrator": "みやび", "text": "何くれるが？"},
