    "entry":
    [
        { "location": "1763/TALK"  , "narrator": "真幌", "text": "…どうしたものか。"},
        { "location": "1764/TALK"  , "narrator": "真幌", "text": "劇場には戻れないが、\nいつまでもこうしては\nいられんし…。"},
        { "location": "1765/TALK"  , "narrator": "真幌", "text": "…………。"},
        { "location": "1766/TALK"  , "narrator": "真幌", "text": "これだけはやりたく\nなかったのだが…。\n仕方がない。"},
        { "location": "1790/TALK"  , "narrator": "繭", "text": "…………。"},
        { "location": "1792/TALK"  , "narrator": "雛", "text": "ん？\nまゆちん、誰から？"},
        { "location": "1793/TALK"  , "narrator": "繭", "text": "…知らない番号。"},
        { "location": "1800/TALK"  , "narrator": "繭", "text": "…もしもし？"},
        { "location": "1801/TALK"  , "narrator": "透明真幌", "text": "光月か？\n東雲だ。"},
        { "location": "1803/TALK"  , "narrator": "繭", "text": "っ、東雲教官！？"},
        { "location": "1806/TALK"  , "narrator": "雛", "text": "え、教官から！？"},
        { "location": "1808/TALK"  , "narrator": "繭", "text": "大丈夫なのですか？\n劇場の方は管理庁が\n完全に抑えてて――"},
        { "location": "1809/TALK"  , "narrator": "透明真幌", "text": "わかっている。\nとりあえず光月、\n落ち着いてくれ。"},
        { "location": "1810/TALK"  , "narrator": "透明真幌", "text": "長話している\n時間はないんだ。"},
        { "location": "1811/TALK"  , "narrator": "繭", "text": "…取り乱しました。"},
        { "location": "1812/TALK"  , "narrator": "繭", "text": "それで、この状況で\n私に連絡だなんて、\nどうしたのですか？"},
        { "location": "1813/TALK"  , "narrator": "透明真幌", "text": "…おまえ達の力が\n必要なんだ。"},
        { "location": "1814/TALK"  , "narrator": "透明真幌", "text": "今から話すことを、\nよく聞いてくれ。"},
        { "location": "1820/TALK"  , "narrator": "繭", "text": "――なるほど。\nそういうこと\nでしたか。"},
        { "location": "1821/TALK"  , "narrator": "透明真幌", "text": "にわかには信じられん\n話だとは思うが、\n今話したのが事実だ。"},
        { "location": "1822/TALK"  , "narrator": "繭", "text": "疑ってはいません。"},
        { "location": "1823/TALK"  , "narrator": "繭", "text": "卯月さんが不自然な\nことには、前々から\n気付いていました。"},
        { "location": "1825/TALK"  , "narrator": "繭", "text": "それを、今回のお話で\nようやく納得する\nことができました。"},
        { "location": "1826/TALK"  , "narrator": "透明真幌", "text": "…理解が早くて\n助かる。"},
        { "location": "1827/TALK"  , "narrator": "繭", "text": "…それで？\n私はなにをすれば\nいいのですか？"},
        { "location": "1828/TALK"  , "narrator": "透明真幌", "text": "…私達に足りないのは\n情報だ。"},
        { "location": "1829/TALK"  , "narrator": "透明真幌", "text": "今、おまえに\n長官のアドレスを\n送っておいた。"},
        { "location": "1830/TALK"  , "narrator": "透明真幌", "text": "それを使って、\n管理庁から情報を\n引き出してほしい。"},
        { "location": "1831/TALK"  , "narrator": "繭", "text": "…腕が鳴ります。"},
        { "location": "1832/TALK"  , "narrator": "透明真幌", "text": "…すまない。"},
        { "location": "1833/TALK"  , "narrator": "透明真幌", "text": "本当は巻き込みたくは\nなかったのだが…。"},
        { "location": "1834/TALK"  , "narrator": "透明真幌", "text": "もう、生徒のおまえを\n頼る以外に方法が\nないんだ…。"},
        { "location": "1835/TALK"  , "narrator": "透明真幌", "text": "私では、アドレスは\n知っていても中には\n入れなくてな。"},
        { "location": "1836/TALK"  , "narrator": "繭", "text": "…教官は、\n最善の判断をされたと――"},
        { "location": "1837/TALK"  , "narrator": "繭", "text": "私は思います。"},
        { "location": "1838/TALK"  , "narrator": "透明真幌", "text": "…ありがとう。"},
        { "location": "1839/TALK"  , "narrator": "透明真幌", "text": "では、頼んだぞ。"},
        { "location": "1844/TALK"  , "narrator": "繭", "text": "…………。"},
        { "location": "1845/TALK"  , "narrator": "雛", "text": "まゆちん、\n教官、なんだって？"},
        { "location": "1847/TALK"  , "narrator": "繭", "text": "…歩きながら話す。\n貴方にも仕事があるから。"},
        { "location": "1865/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1867/TALK"  , "narrator": "神楽", "text": "私…これから先、\nどうなるんだろう？"},
        { "location": "1868/TALK"  , "narrator": "神楽", "text": "…っていうか、\nどうしたらいいの？"},
        { "location": "1869/TALK"  , "narrator": "神楽", "text": "…………。"},
        { "location": "1883/TALK"  , "narrator": "神楽", "text": "これで大丈夫なんですか？"},
        { "location": "1884/TALK"  , "narrator": "神楽", "text": "色々教えてくれたり誘導してくれたりしたけど"},
        { "location": "1885/TALK"  , "narrator": "神楽", "text": "これでいいんですか？"},
        { "location": "1886/TALK"  , "narrator": "神楽", "text": "なにか変わってるようには思えないんですけど"},
        { "location": "1888/SEL"   , "narrator": "", "text": "目覚ましく変わってるよ"},
        { "location": "1889/ACT"   , "narrator": "", "text": "目覚ましく変わってるよ"},
        { "location": "1892/TALK"  , "narrator": "神楽", "text": "目覚ましい？"},
        { "location": "1893/TALK"  , "narrator": "神楽", "text": "これでですか？"},
        { "location": "1894/TALK"  , "narrator": "神楽", "text": "だとすると"},
        { "location": "1895/TALK"  , "narrator": "神楽", "text": "変わらなかった私は"},
        { "location": "1897/TALK"  , "narrator": "神楽", "text": "どうなってたやら"},
        { "location": "1903/TALK"  , "narrator": "神楽", "text": "誰か来たみたいだけど"},
        { "location": "1906/TALK"  , "narrator": "神楽", "text": "また千羽鶴とか？"},
        { "location": "1907/TALK"  , "narrator": "神楽", "text": "なんか"},
        { "location": "1908/TALK"  , "narrator": "神楽", "text": "出たくないんだけど"},
        { "location": "1910/TALK"  , "narrator": "神楽", "text": "出た方がイイですか？"},
        { "location": "1961/TALK"  , "narrator": "月神楽", "text": "　"},
        { "location": "1995/TALK"  , "narrator": "つばめ", "text": "到着しましたっ！"},
        { "location": "1996/TALK"  , "narrator": "つばめ", "text": "この扉の向こうに\nぴょんこちゃんが\nいるのでしょうか！"},
        { "location": "1998/SEL"   , "narrator": "", "text": "あ、えっと、ちょっと待って、実はあの後急用が……"},
        { "location": "1999/ACT"   , "narrator": "", "text": "あ、えっと、ちょっと待って、実はあの後急用が……"},
        { "location": "2001/TALK"  , "narrator": "つばめ", "text": "え！？"},
        { "location": "2002/SEL"   , "narrator": "", "text": "ほんと申し訳ないのだけど、別のココロスフィアに行かねばならなくなり…"},
        { "location": "2003/ACT"   , "narrator": "", "text": "ほんと申し訳ないのだけど、別のココロスフィアに行かねばならなくなり…"},
        { "location": "2005/TALK"  , "narrator": "つばめ", "text": "そうですか……。"},
        { "location": "2006/SEL"   , "narrator": "", "text": "まあでも、つばめも何だかんだで助かったのだから良かったのでは？"},
        { "location": "2007/ACT"   , "narrator": "", "text": "まあでも、つばめも何だかんだで助かったのだから良かったのでは？"},
        { "location": "2009/TALK"  , "narrator": "つばめ", "text": "そうかもしれませんけど、\nスピネルさんの依頼を\n無視したら――"},
        { "location": "2010/TALK"  , "narrator": "つばめ", "text": "$handle$さんが\nスピネルさんに、回線切断\nされちゃいませんか？"},
        { "location": "2011/SEL"   , "narrator": "", "text": "まあ、きっと大丈夫だよ…今回の件は、最終的にはすごく大事なことなんだ"},
        { "location": "2012/ACT"   , "narrator": "", "text": "まあ、きっと大丈夫だよ…今回の件は、最終的にはすごく大事なことなんだ"},
        { "location": "2014/TALK"  , "narrator": "つばめ", "text": "そうですか、\nわかりました。"},
        { "location": "2015/TALK"  , "narrator": "つばめ", "text": "$handle$さんが\nそこまで言うなら、\nきっと大丈夫ですね！"},
        { "location": "2016/TALK"  , "narrator": "つばめ", "text": "それじゃ、\nいってらっしゃい。"},
        { "location": "2017/TALK"  , "narrator": "つばめ", "text": "助けてくれて\nありがとうございました！"},
        { "location": "2018/SEL"   , "narrator": "", "text": "ああっ、待って待って！"},
        { "location": "2019/ACT"   , "narrator": "", "text": "ああっ、待って待って！"},
        { "location": "2021/TALK"  , "narrator": "つばめ", "text": "えっ！\nどうしたんですか？"},
        { "location": "2022/SEL"   , "narrator": "", "text": "つばめのココロスフィアへの行き方、わかる？"},
        { "location": "2023/ACT"   , "narrator": "", "text": "つばめのココロスフィアへの行き方、わかる？"},
        { "location": "2025/TALK"  , "narrator": "つばめ", "text": "えっ、\nどうしてですか？"},
        { "location": "2026/SEL"   , "narrator": "", "text": "実はさっき言ってた用事がある場所って、つばめのココロスフィアなんだ…"},
        { "location": "2027/ACT"   , "narrator": "", "text": "実はさっき言ってた用事がある場所って、つばめのココロスフィアなんだ…"},
        { "location": "2029/TALK"  , "narrator": "つばめ", "text": "アドレスもわからないのに\n行く予定だったんですか？"},
        { "location": "2030/TALK"  , "narrator": "つばめ", "text": "えっと、まあ\nエクスターナルアドレス\nくらいなら知ってますけど"},
        { "location": "2031/TALK"  , "narrator": "つばめ", "text": "【C1:2:28E】です。"},
        { "location": "2032/TALK"  , "narrator": "つばめ", "text": "でも、わたしは\nジャンプもさせて\nあげられませんし――"},
        { "location": "2033/TALK"  , "narrator": "つばめ", "text": "そもそも、もうあと少しで\n消えてしまう身ですから。"},
        { "location": "2034/SEL"   , "narrator": "", "text": "そうなの！？"},
        { "location": "2035/ACT"   , "narrator": "", "text": "そうなの！？"},
        { "location": "2037/TALK"  , "narrator": "つばめ", "text": "はい、\n所詮は残留思念なので。"},
        { "location": "2038/TALK"  , "narrator": "つばめ", "text": "お役に立てず\n申し訳ありません。"},
        { "location": "2040/SEL"   , "narrator": "", "text": "スピネルの言うことが本当ならそうなるね"},
        { "location": "2041/ACT"   , "narrator": "", "text": "スピネルの言うことが本当ならそうなるね"},
        { "location": "2043/TALK"  , "narrator": "つばめ", "text": "なんだか\nドキドキしますね。"},
        { "location": "2044/TALK"  , "narrator": "つばめ", "text": "急ぎましょう！"},
        { "location": "2055/TALK"  , "narrator": "月神楽", "text": "ちょっと$handle$さんっ！？今どこにいるんですかっ！！"},
        { "location": "2056/SEL"   , "narrator": "", "text": "月神楽！？"},
        { "location": "2057/SEL"   , "narrator": "", "text": "いや、だからぴょんこを助けに……"},
        { "location": "2058/ACT"   , "narrator": "", "text": "月神楽！？"},
        { "location": "2059/ACT"   , "narrator": "", "text": "いや、だからぴょんこを助けに……"},
        { "location": "2060/TALK"  , "narrator": "月神楽", "text": "それはわかるんですけども！！！"},
        { "location": "2062/TALK"  , "narrator": "月神楽", "text": "今回はなんでココロゲートに呼ばれたか、わかってるんですかっ！"},
        { "location": "2063/SEL"   , "narrator": "", "text": "葛藤処理ですよね"},
        { "location": "2064/ACT"   , "narrator": "", "text": "葛藤処理ですよね"},
        { "location": "2066/TALK"  , "narrator": "月神楽", "text": "その通りです！！！！！１１１１"},
        { "location": "2067/TALK"  , "narrator": "月神楽", "text": "早く戻って来てください！"},
        { "location": "2068/SEL"   , "narrator": "", "text": "ちょっとそれより大事な案件が出来てしまって！"},
        { "location": "2069/SEL"   , "narrator": "", "text": "戻り方がわかりません！"},
        { "location": "2070/ACT"   , "narrator": "", "text": "ちょっとそれより大事な案件が出来てしまって！"},
        { "location": "2071/ACT"   , "narrator": "", "text": "戻り方がわかりません！"},
        { "location": "2074/TALK"  , "narrator": "月神楽", "text": "はぁぁ～～～～"},
        { "location": "2075/TALK"  , "narrator": "月神楽", "text": "もういいです"},
        { "location": "2076/TALK"  , "narrator": "月神楽", "text": "今回は私が何とかします"},
        { "location": "2077/TALK"  , "narrator": "月神楽", "text": "そのかわり、貸し２ですからね♪"},
        { "location": "2078/TALK"  , "narrator": "月神楽", "text": "ではでは～～"},
        { "location": "2080/SEL"   , "narrator": "", "text": "あ、待って月神楽さん！"},
        { "location": "2081/ACT"   , "narrator": "", "text": "あ、待って月神楽さん！"},
        { "location": "2083/TALK"  , "narrator": "月神楽", "text": "なんですか？"},
        { "location": "2084/SEL"   , "narrator": "", "text": "お怒りの中更にお願いしてしまうこととなり恐縮なのですが"},
        { "location": "2085/ACT"   , "narrator": "", "text": "お怒りの中更にお願いしてしまうこととなり恐縮なのですが"},
        { "location": "2087/TALK"  , "narrator": "月神楽", "text": "なんでしょうか"},
        { "location": "2088/SEL"   , "narrator": "", "text": "つばめさんのココロスフィアに移動させていただくことは可能でしょうか"},
        { "location": "2089/ACT"   , "narrator": "", "text": "つばめさんのココロスフィアに移動させていただくことは可能でしょうか"},
        { "location": "2092/TALK"  , "narrator": "月神楽", "text": "いいですけど"},
        { "location": "2093/TALK"  , "narrator": "月神楽", "text": "貸し３"},
        { "location": "2094/TALK"  , "narrator": "月神楽", "text": "あ、やっぱり４で"},
        { "location": "2095/TALK"  , "narrator": "月神楽", "text": "お引き受け致します♪"},
        { "location": "2096/TALK"  , "narrator": "月神楽", "text": "アドレス教えてください"},
        { "location": "2098/SEL"   , "narrator": "", "text": "【C1:2:28E//0x001】です"},
        { "location": "2099/ACT"   , "narrator": "", "text": "【C1:2:28E//0x001】です"},
        { "location": "2101/TALK"  , "narrator": "月神楽", "text": "オッケーです♪"},
        { "location": "2102/TALK"  , "narrator": "月神楽", "text": "それじゃ、セットアップしますね、あと少ししたら勝手にジャンプしますから！"},
        { "location": "2104/TALK"  , "narrator": "月神楽", "text": "完了ですっ！"},
        { "location": "2105/TALK"  , "narrator": "月神楽", "text": "それでは行ってらっしゃい！"},
        { "location": "2106/TALK"  , "narrator": "月神楽", "text": "$handle$さんとっ"},
        { "location": "2107/TALK"  , "narrator": "月神楽", "text": "つばめさんにっ"},
        { "location": "2108/TALK"  , "narrator": "月神楽", "text": "素敵な呪いの旅を"},
        { "location": "2114/SEL"   , "narrator": "", "text": "えっと…わかりません"},
        { "location": "2115/ACT"   , "narrator": "", "text": "えっと…わかりません"},
        { "location": "2117/TALK"  , "narrator": "月神楽", "text": "それは無理ですって……"},
        { "location": "2118/TALK"  , "narrator": "月神楽", "text": "アドレスわかったらまた教えてくれれば飛ばしますよ"},
        { "location": "2119/TALK"  , "narrator": "月神楽", "text": "貸し４で！！！"},
        { "location": "2120/TALK"  , "narrator": "月神楽", "text": "ではでは～～～～"},
        { "location": "2130/TALK"  , "narrator": "つばめ", "text": "$handle$さん、\n大丈夫ですか？"},
        { "location": "2131/SEL"   , "narrator": "", "text": "だ、大丈夫です…"},
        { "location": "2132/ACT"   , "narrator": "", "text": "だ、大丈夫です…"},
        { "location": "2134/TALK"  , "narrator": "つばめ", "text": "もしかしてこれって――"},
        { "location": "2137/TALK"  , "narrator": "つばめ", "text": "<size=35>モテモテですか！？</size>"},
        { "location": "2138/SEL"   , "narrator": "", "text": "ラノベの主人公のような気分です"},
        { "location": "2139/SEL"   , "narrator": "", "text": "モテるのはつらいねえ～"},
        { "location": "2140/ACT"   , "narrator": "", "text": "ラノベの主人公のような気分です"},
        { "location": "2141/TALK"  , "narrator": "つばめ", "text": "あはは……\nそういうものですか。"},
        { "location": "2142/ACT"   , "narrator": "", "text": "モテるのはつらいねえ～"},
        { "location": "2143/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "2145/TALK"  , "narrator": "つばめ", "text": "さあ、\nそんなことより\n早く行きましょう！"},
        { "location": "2146/SEL"   , "narrator": "", "text": "どうしてそんなにせかすの？"},
        { "location": "2147/ACT"   , "narrator": "", "text": "どうしてそんなにせかすの？"},
        { "location": "2149/TALK"  , "narrator": "つばめ", "text": "わたし、そろそろ\n消えちゃいそうなんです。"},
        { "location": "2150/TALK"  , "narrator": "つばめ", "text": "所詮は残留思念なので…。"},
        { "location": "2151/SEL"   , "narrator": "", "text": "急ぐ"},
        { "location": "2152/SEL"   , "narrator": "", "text": "敢えて遅らせる"},
        { "location": "2153/ACT"   , "narrator": "", "text": "急ぐ"},
        { "location": "2157/ACT"   , "narrator": "", "text": "敢えて遅らせる"},
        { "location": "2160/SEL"   , "narrator": "", "text": "つばめ"},
        { "location": "2161/ACT"   , "narrator": "", "text": "つばめ"},
        { "location": "2163/TALK"  , "narrator": "つばめ", "text": "はいっ！"},
        { "location": "2164/SEL"   , "narrator": "", "text": "喉が渇いたからコンビニでジュース買ってきて"},
        { "location": "2165/ACT"   , "narrator": "", "text": "喉が渇いたからコンビニでジュース買ってきて"},
        { "location": "2167/TALK"  , "narrator": "つばめ", "text": "えええっ！\n今ですかっ！"},
        { "location": "2168/TALK"  , "narrator": "つばめ", "text": "ここはわたしの\nココロスフィアでは\nないので――"},
        { "location": "2169/TALK"  , "narrator": "つばめ", "text": "最寄りのコンビニでも\nわたしの世界まで戻って\nその最初にある１号店……"},
        { "location": "2170/TALK"  , "narrator": "つばめ", "text": "あ…"},
        { "location": "2171/TALK"  , "narrator": "つばめ", "text": "わたし、もう\n消えちゃうみたいです……"},
        { "location": "2172/SEL"   , "narrator": "", "text": "つばめ…ごめんね"},
        { "location": "2173/ACT"   , "narrator": "", "text": "つばめ…ごめんね"},
        { "location": "2175/TALK"  , "narrator": "つばめ", "text": "$handle$さん……"},
        { "location": "2181/SEL"   , "narrator": "", "text": "扉に入る"},
        { "location": "2182/ACT"   , "narrator": "", "text": "扉に入る"},
        { "location": "2189/SEL"   , "narrator": "", "text": "扉に入る"},
        { "location": "2190/ACT"   , "narrator": "", "text": "扉に入る"},
        { "location": "2228/SEL"   , "narrator": "", "text": "ぴょんこ！"},
        { "location": "2229/ACT"   , "narrator": "", "text": "ぴょんこ！"},
        { "location": "2232/TALK"  , "narrator": "ぴょんこ", "text": "え……？"},
        { "location": "2235/TALK"  , "narrator": "ぴょんこ", "text": "<size=60>$handle$さんっ！</size>"},
        { "location": "2236/SEL"   , "narrator": "", "text": "相変わらずでかいでかい"},
        { "location": "2237/ACT"   , "narrator": "", "text": "相変わらずでかいでかい"},
        { "location": "2240/TALK"  , "narrator": "ぴょんこ", "text": "もしかして、\nぴょんこを追いかけて\nきてくれたんですかっ！"},
        { "location": "2244/TALK"  , "narrator": "ぴょんこ", "text": "やっぱり\n$handle$さんは\nぴょんこに――"},
        { "location": "2247/TALK"  , "narrator": "ぴょんこ", "text": "<size=40>ゾッコンLOVE!</size>"},
        { "location": "2251/TALK"  , "narrator": "ぴょんこ", "text": "そうでしょ？\nね、そうでしょ？"},
        { "location": "2252/TALK"  , "narrator": "ぴょんこ", "text": "よーし、\nぴょんこ気合い\n入ってきたぞーっ！"},
        { "location": "2253/TALK"  , "narrator": "ぴょんこ", "text": "早速\nキスチケジャンケンを――"},
        { "location": "2254/SEL"   , "narrator": "", "text": "まてまて！それより、本当に大丈夫なの！？"},
        { "location": "2255/ACT"   , "narrator": "", "text": "まてまて！それより、本当に大丈夫なの！？"},
        { "location": "2258/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん？"},
        { "location": "2259/SEL"   , "narrator": "", "text": "この前メールが「なんかいｔｔｔｔ」で終わってて心配したよ？"},
        { "location": "2260/ACT"   , "narrator": "", "text": "この前メールが「なんかいｔｔｔｔ」で終わってて心配したよ？"},
        { "location": "2263/TALK"  , "narrator": "ぴょんこ", "text": "ああっ……\nごめんなさいぴょん…。"},
        { "location": "2264/TALK"  , "narrator": "ぴょんこ", "text": "うっかりスマホを\nドブに落としちゃって！"},
        { "location": "2265/TALK"  , "narrator": "ぴょんこ", "text": "特に何かあったわけじゃ\n無いんですよ…あはは……"},
        { "location": "2266/SEL"   , "narrator": "", "text": "でも、“何かいた”んでは？"},
        { "location": "2267/ACT"   , "narrator": "", "text": "でも、“何かいた”んでは？"},
        { "location": "2273/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん？"},
        { "location": "2274/TALK"  , "narrator": "ぴょんこ", "text": "書きたかったのは、"},
        { "location": "2275/TALK"  , "narrator": "ぴょんこ", "text": "“あと少しなのに、何か\nいつもの調子が出ないから\nキスしに来てください！”"},
        { "location": "2276/TALK"  , "narrator": "ぴょんこ", "text": "……ということだった\nぴょん。"},
        { "location": "2277/TALK"  , "narrator": "ぴょんこ", "text": "だから、最後まで書いて\nないのに来てくれたから、\n運命の糸を感じたぴょん♪"},
        { "location": "2278/SEL"   , "narrator": "", "text": "なんだそれ……"},
        { "location": "2279/SEL"   , "narrator": "", "text": "ぴょんこかわいい"},
        { "location": "2280/SEL"   , "narrator": "", "text": "ぴょんこｽｷ"},
        { "location": "2281/ACT"   , "narrator": "", "text": "なんだそれ……"},
        { "location": "2282/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん……"},
        { "location": "2283/ACT"   , "narrator": "", "text": "ぴょんこかわいい"},
        { "location": "2284/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん♪"},
        { "location": "2285/ACT"   , "narrator": "", "text": "ぴょんこｽｷ"},
        { "location": "2291/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこは今回のことで、\nより一層あなたとの絆を\n強く感じたぴょん♪"},
        { "location": "2294/TALK"  , "narrator": "ぴょんこ", "text": "とにかく！"},
        { "location": "2295/TALK"  , "narrator": "ぴょんこ", "text": "エリカさんのお陰で、\nライフギャザーに潜入\n出来るようになりました！"},
        { "location": "2296/TALK"  , "narrator": "ぴょんこ", "text": "そしてぴょんこは\n$handle$さんを\n迎えて百人力！"},
        { "location": "2297/TALK"  , "narrator": "ぴょんこ", "text": "さあ、さあ！\nとっとと行きますよ！"},
        { "location": "2298/TALK"  , "narrator": "ぴょんこ", "text": "回線の切り替えをして、\n司書に返り咲き！"},
        { "location": "2299/TALK"  , "narrator": "ぴょんこ", "text": "毎日$handle$さんと\nちゅっちゅしながら\n夢の暮らしをするぴょん！"},
        { "location": "2301/TALK"  , "narrator": "つばめ", "text": "ちょっと待ってください！\nそれはダメですよ！"},
        { "location": "2303/TALK"  , "narrator": "ぴょんこ", "text": "……そういえば何か\nいたぴょん。"},
        { "location": "2304/TALK"  , "narrator": "ぴょんこ", "text": "$handle$さんは\n絶対あげませんよっ！"},
        { "location": "2305/TALK"  , "narrator": "つばめ", "text": "え！？　あ、えっと、\nそうじゃなくてですね！"},
        { "location": "2306/TALK"  , "narrator": "つばめ", "text": "回線を切り替えるのは\n危険なんです！！"},
        { "location": "2307/TALK"  , "narrator": "つばめ", "text": "“彼ら”にライフギャザー\n関連の情報が筒抜けに\nなるかもしれません！"},
        { "location": "2308/TALK"  , "narrator": "ぴょんこ", "text": "ぴょん。"},
        { "location": "2309/TALK"  , "narrator": "ぴょんこ", "text": "でもその理屈だと、\n今まで既に情報が筒抜け\nだったって事ですよね？"},
        { "location": "2310/TALK"  , "narrator": "ぴょんこ", "text": "はい論破ー。"},
        { "location": "2311/TALK"  , "narrator": "つばめ", "text": "いえ、そうじゃなくて\nですね、わたしやぴょんこ\nさんが――"},
        { "location": "2312/TALK"  , "narrator": "つばめ", "text": "ライフギャザー付近に\nいたり、それを操作すると\nまずいんですよ。"},
        { "location": "2313/SEL"   , "narrator": "", "text": "なるほど"},
        { "location": "2314/SEL"   , "narrator": "", "text": "つばめはなんでそんなに詳しいの？"},
        { "location": "2315/ACT"   , "narrator": "", "text": "なるほど"},
        { "location": "2318/ACT"   , "narrator": "", "text": "つばめはなんでそんなに詳しいの？"},
        { "location": "2321/TALK"  , "narrator": "つばめ", "text": "よくわかりません！"},
        { "location": "2322/SEL"   , "narrator": "", "text": "そんなドヤ顔で言われても"},
        { "location": "2323/ACT"   , "narrator": "", "text": "そんなドヤ顔で言われても"},
        { "location": "2326/TALK"  , "narrator": "つばめ", "text": "なんて言いつつも、\nわたし、\nそろそろ限界みたいです。"},
        { "location": "2327/TALK"  , "narrator": "つばめ", "text": "でも伝えたいことは\n伝えられましたし――"},
        { "location": "2328/TALK"  , "narrator": "つばめ", "text": "$handle$さん\nありがとうございました。"},
        { "location": "2329/TALK"  , "narrator": "ぴょんこ", "text": "……消える…ぴょん？"},
        { "location": "2331/TALK"  , "narrator": "つばめ", "text": "あっ、わたし\n残留思念なんで！\nお気になさらずです！"},
        { "location": "2332/TALK"  , "narrator": "つばめ", "text": "とにかく、\nそのことだけは――"},
        { "location": "2337/TALK"  , "narrator": "ぴょんこ", "text": "つばめさんっ！"},
        { "location": "2338/SEL"   , "narrator": "", "text": "つばめ！"},
        { "location": "2339/ACT"   , "narrator": "", "text": "つばめ！"},
        { "location": "2341/TALK"  , "narrator": "ぴょんこ", "text": "……ぴょん。"},
        { "location": "2342/SEL"   , "narrator": "", "text": "気にしないで、元々もう消える時間だったんだ"},
        { "location": "2343/ACT"   , "narrator": "", "text": "気にしないで、元々もう消える時間だったんだ"},
        { "location": "2346/TALK"  , "narrator": "ぴょんこ", "text": "……。"},
        { "location": "2347/TALK"  , "narrator": "ぴょんこ", "text": "いえ、そうではなく。"},
        { "location": "2348/SEL"   , "narrator": "", "text": "どうしたの？"},
        { "location": "2349/ACT"   , "narrator": "", "text": "どうしたの？"},
        { "location": "2351/TALK"  , "narrator": "ぴょんこ", "text": "ライフギャザーの件、\nもっと慎重に作戦を\n練った方がいいかなと。"},
        { "location": "2352/TALK"  , "narrator": "ぴょんこ", "text": "つばめさんが\nお話していたことは\nもっともだと思います。"},
        { "location": "2353/TALK"  , "narrator": "ぴょんこ", "text": "もちろん、\n取り越し苦労という\n可能性もありますけど――"},
        { "location": "2354/TALK"  , "narrator": "ぴょんこ", "text": "迂闊に回線を切り替えて\n彼らに乗っ取られたら、\n後悔しまくりですから。"},
        { "location": "2355/SEL"   , "narrator": "", "text": "ぴょんこが真面目になってる！！"},
        { "location": "2356/SEL"   , "narrator": "", "text": "ていうかライフギャザーなのはもう確定なの？"},
        { "location": "2357/ACT"   , "narrator": "", "text": "ぴょんこが真面目になってる！！"},
        { "location": "2358/TALK"  , "narrator": "ぴょんこ", "text": "ぴょんこだって、\nやるときはやるんです！"},
        { "location": "2359/ACT"   , "narrator": "", "text": "ていうかライフギャザーなのはもう確定なの？"},
        { "location": "2360/TALK"  , "narrator": "ぴょんこ", "text": "昔から確定ですよ？"},
        { "location": "2361/TALK"  , "narrator": "ぴょんこ", "text": "まさか『エンタングルが\nライフギャザーをパクった\nなんてのはデマだ！』――"},
        { "location": "2362/TALK"  , "narrator": "ぴょんこ", "text": "などという都市伝説、\n信じてないですよね？"},
        { "location": "2364/TALK"  , "narrator": "ぴょんこ", "text": "んー……"},
        { "location": "2365/TALK"  , "narrator": "ぴょんこ", "text": "まあいいです！\nとにかく、まだ回線は\n切り替えていませんし！"},
        { "location": "2366/TALK"  , "narrator": "ぴょんこ", "text": "回線を切り替える直前に、\n何かいい方法が無いか\n考えてみましょう♪"},
        { "location": "2367/SEL"   , "narrator": "", "text": "確かにそれがいいかもしれない"},
        { "location": "2368/ACT"   , "narrator": "", "text": "確かにそれがいいかもしれない"},
        { "location": "2370/TALK"  , "narrator": "ぴょんこ", "text": "つばめさんに\n感謝ですねっ♪"},
        { "location": "2372/SEL"   , "narrator": "", "text": "推進力は煩悩か"},
        { "location": "2373/SEL"   , "narrator": "", "text": "チュッチュする～！"},
        { "location": "2374/ACT"   , "narrator": "", "text": "推進力は煩悩か"},
        { "location": "2375/TALK"  , "narrator": "ぴょんこ", "text": "あたぼうだぜっ！"},
        { "location": "2376/TALK"  , "narrator": "ぴょんこ", "text": "それこそが生命活動の\n源泉ですよっ！"},
        { "location": "2377/ACT"   , "narrator": "", "text": "チュッチュする～！"},
        { "location": "2378/TALK"  , "narrator": "ぴょんこ", "text": "ぴょ～～～ん♪"},
        { "location": "2379/TALK"  , "narrator": "ぴょんこ", "text": "俄然やる気\n急上昇中のぴょんこ！"},
        { "location": "2381/TALK"  , "narrator": "ぴょんこ", "text": "それじゃ、\nとっとと回線を切り替えに\n行っちゃいましょう♪"},
        { "location": "2383/TALK"  , "narrator": "ぴょんこ", "text": "というわけで、\n$handle$さんっ！"},
        { "location": "2384/TALK"  , "narrator": "ぴょんこ", "text": "またぴょんことの、\n二人きりの人生の旅が\n始まりましたねっ！"},
        { "location": "2385/SEL"   , "narrator": "", "text": "お、おう"},
        { "location": "2386/ACT"   , "narrator": "", "text": "お、おう"},
        { "location": "2388/TALK"  , "narrator": "ぴょんこ", "text": "ついに\nライフギャザー編が\n始まりますよっ！"},
        { "location": "2389/TALK"  , "narrator": "ぴょんこ", "text": "チャンネルは、\nそのままで！"},
        { "location": "2415/SEL"   , "narrator": "", "text": "千羽鶴！！"},
        { "location": "2416/ACT"   , "narrator": "", "text": "千羽鶴！！"},
        { "location": "2420/TALK"  , "narrator": "千羽鶴", "text": "…！？"},
        { "location": "2423/TALK"  , "narrator": "千羽鶴", "text": "<size=40>どーん！</size>"},
        { "location": "2424/TALK"  , "narrator": "千羽鶴", "text": "不法侵入。"},
        { "location": "2425/TALK"  , "narrator": "千羽鶴", "text": "特にご飯を食べてる時は\n罪が重い。"},
        { "location": "2426/TALK"  , "narrator": "千羽鶴", "text": "例えそれが、\n臭いご飯だとしても。"},
        { "location": "2427/SEL"   , "narrator": "", "text": "会えて良かった！"},
        { "location": "2428/SEL"   , "narrator": "", "text": "何食べてたの？"},
        { "location": "2429/ACT"   , "narrator": "", "text": "会えて良かった！"},
        { "location": "2430/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "2431/TALK"  , "narrator": "千羽鶴", "text": "その様子だと、\n私に何かあった？"},
        { "location": "2432/ACT"   , "narrator": "", "text": "何食べてたの？"},
        { "location": "2434/TALK"  , "narrator": "千羽鶴", "text": "…焼き鮭と\nふりかけごはん。"},
        { "location": "2436/TALK"  , "narrator": "千羽鶴", "text": "ところで、\n何だか慌ててる\nみたいだけど。"},
        { "location": "2438/SEL"   , "narrator": "", "text": "原初のつばめにレイヤーが上書きされて千羽鶴が消えた"},
        { "location": "2439/ACT"   , "narrator": "", "text": "原初のつばめにレイヤーが上書きされて千羽鶴が消えた"},
        { "location": "2441/TALK"  , "narrator": "千羽鶴", "text": "なるほど。"},
        { "location": "2442/TALK"  , "narrator": "千羽鶴", "text": "それは確かに、\n貴方の知る千羽鶴は\n困っていると思う。"},
        { "location": "2443/SEL"   , "narrator": "", "text": "一応、消えたちーと目の前のちーの違いを教えてください"},
        { "location": "2444/ACT"   , "narrator": "", "text": "一応、消えたちーと目の前のちーの違いを教えてください"},
        { "location": "2446/TALK"  , "narrator": "千羽鶴", "text": "今、貴方と話してる私は、\n私が生まれた時の、\n原点たる私の記憶。"},
        { "location": "2447/TALK"  , "narrator": "千羽鶴", "text": "私が何かを見失ったとき、\n原点回帰をするために\nこの場所は使われる。"},
        { "location": "2448/TALK"  , "narrator": "千羽鶴", "text": "そして、消えた千羽鶴……\nいえ、厳密には消えては\nいないのだけど――"},
        { "location": "2449/TALK"  , "narrator": "千羽鶴", "text": "正確に言えば、\n別のつばめ総体によって\n上書きされてしまった私は"},
        { "location": "2450/TALK"  , "narrator": "千羽鶴", "text": "とある一経過における\n私の状態。"},
        { "location": "2451/TALK"  , "narrator": "千羽鶴", "text": "だから、上書きとは、\n客観的に見れば単に経過が\n変わっただけに過ぎない。"},
        { "location": "2452/TALK"  , "narrator": "千羽鶴", "text": "それ故に、\n必ずしも不都合なことと\n決めつける事はできない。"},
        { "location": "2453/TALK"  , "narrator": "千羽鶴", "text": "ただ、少なくとも、\n今のあなたにとっては\n不都合なのでしょうし――"},
        { "location": "2454/TALK"  , "narrator": "千羽鶴", "text": "他にも不都合を被ってる\n人がいるのかもしれない\nから、協力してもいい。"},
        { "location": "2455/TALK"  , "narrator": "千羽鶴", "text": "貴方が私の為に、\n尽力してくれてること\nだけは知ってるから。"},
        { "location": "2456/SEL"   , "narrator": "", "text": "ありがとう"},
        { "location": "2457/ACT"   , "narrator": "", "text": "ありがとう"},
        { "location": "2459/TALK"  , "narrator": "千羽鶴", "text": "ただし、\n解決するためには――"},
        { "location": "2460/TALK"  , "narrator": "千羽鶴", "text": "上書きしてきた側の\nつばめの総体を、別の所に\n飛ばさなければならない。"},
        { "location": "2461/TALK"  , "narrator": "千羽鶴", "text": "双方の都合がぶつかりあう\nコンフリクト状態だから、\n両方ともとるのは難しい。"},
        { "location": "2462/TALK"  , "narrator": "千羽鶴", "text": "故に、\n貴方がそれを望まないなら\n今回の問題は解決不可能。"},
        { "location": "2463/SEL"   , "narrator": "", "text": "飛ばした場合、どこに飛ばされるの？"},
        { "location": "2464/ACT"   , "narrator": "", "text": "飛ばした場合、どこに飛ばされるの？"},
        { "location": "2466/TALK"  , "narrator": "千羽鶴", "text": "元いたレイヤーかもしくは\nコンフリクトしない\n別のレイヤー。"},
        { "location": "2467/TALK"  , "narrator": "千羽鶴", "text": "それは、１日後の\nレイヤーかもしれないし、\n１年後かもしれない。"},
        { "location": "2468/SEL"   , "narrator": "", "text": "飛ばす以外に解決方法は無いの？"},
        { "location": "2469/ACT"   , "narrator": "", "text": "飛ばす以外に解決方法は無いの？"},
        { "location": "2471/TALK"  , "narrator": "千羽鶴", "text": "本人同士による\n話し合い解決も可能。"},
        { "location": "2472/TALK"  , "narrator": "千羽鶴", "text": "その場合は、\n私が仲介者として、\n間に入ることになる。"},
        { "location": "2473/TALK"  , "narrator": "千羽鶴", "text": "というわけで、\n早速だけど――"},
        { "location": "2474/TALK"  , "narrator": "千羽鶴", "text": "上書きしたつばめ総体を\n追い出すか、それとも\n現状維持にするか。"},
        { "location": "2475/TALK"  , "narrator": "千羽鶴", "text": "それを選んで。"},
        { "location": "2476/SEL"   , "narrator": "", "text": "原初のつばめを飛ばす"},
        { "location": "2477/SEL"   , "narrator": "", "text": "仲介してもらって話し合う"},
        { "location": "2478/SEL"   , "narrator": "", "text": "千羽鶴の復活を諦める"},
        { "location": "2479/ACT"   , "narrator": "", "text": "原初のつばめを飛ばす"},
        { "location": "2481/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "2482/ACT"   , "narrator": "", "text": "仲介してもらって話し合う"},
        { "location": "2484/TALK"  , "narrator": "千羽鶴", "text": "わかった。でも、\n必ずしも解決できるとは\n限らない。"},
        { "location": "2485/TALK"  , "narrator": "千羽鶴", "text": "この場合、私は\nどちら側の味方も\nするつもりは無いから。"},
        { "location": "2486/ACT"   , "narrator": "", "text": "千羽鶴の復活を諦める"},
        { "location": "2488/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "2489/TALK"  , "narrator": "千羽鶴", "text": "その場合、私は\n何の役にも立てない。"},
        { "location": "2490/TALK"  , "narrator": "千羽鶴", "text": "というわけで、\n今回はさようなら。"},
        { "location": "2491/TALK"  , "narrator": "千羽鶴", "text": "また気が変わったら\nいつでも来て。"},
        { "location": "2494/TALK"  , "narrator": "千羽鶴", "text": "というわけで、\n早速だけど\n執行を開始する。"},
        { "location": "2495/TALK"  , "narrator": "千羽鶴", "text": "私と一緒に来て。"},
        { "location": "1762/DIALOG", "narrator": "Dialog_EventData", "text": "<color=green>9月3日　5:06 PM</color>\n東京・真幌の隠れ家にて"},
        { "location": "1926/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch01", "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "1928/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch02", "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "1930/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "1932/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch04", "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n"},
        { "location": "1934/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch05", "text": "<color=black><size=50><b>卯月神楽のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n卯月神楽の心の葛藤を解消してください。\n\n\n\n"},
        { "location": "1993/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Information:0x03】</color>\nココロスフィアとの通信を\n復元しました。(101)"},
        { "location": "2394/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Information:0x11】</color>\n\nKokoro-Gate\n<color=blue>[Address:1x100]</color>\nsave succeed !\nAnd hibernation a gate.\n\n時空間整合性維持のため、\nココロゲートを一旦停止し\n現実世界に戻ります。\n(102)\n"},
        { "location": "2395/DIALOG", "narrator": "Dialog_InfoOS", "text": "\n\nなお、EP20～21における選択は “パラメトリック理論による世界進行法”による収束対象となっています。テーマは<color=green>【つばめを連れて行くか否か】</color>です。\n\n<color=red>未来確定日は、\n対向時間における\n2018年5月14日0:00\nになります。\n\nその時点で最終的に貴方が選択しているルートが、貴方の回答になります。\n</color>\n"},
        { "location": "2508/DIALOG", "narrator": "INFO", "text": "<color=green>【TRI-OS Information:0x11】</color>\n\nKokoro-Gate\n<color=blue>[Address:1x100]</color>\nsave succeed !\nAnd hibernation a gate.\n\n時空間整合性維持のため、\nココロゲートを一旦停止し\n現実世界に戻ります。\n(102)\n"}
