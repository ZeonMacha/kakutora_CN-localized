{
    "dir": "chap18/daydra/dd_ch03_18_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "18356",
        "cid": "gabriella",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "言えるかな？"
    },
    "entry":
    [
        { "location": "187/SCENARIO", "narrator": "", "text": "言えるかな？"},
        { "location": "203/TALK"    , "narrator": "ガブリエラ", "text": "まほ、映写機の交換用\nパーツって届いてない？"},
        { "location": "205/TALK"    , "narrator": "真幌", "text": "ああ、それなら劇場の方に\n置いてあるが…。"},
        { "location": "206/TALK"    , "narrator": "ガブリエラ", "text": "ん、ありがと。"},
        { "location": "207/TALK"    , "narrator": "真幌", "text": "かなり重そうだから\n一人で運ぶのは…ん？"},
        { "location": "209/TALK"    , "narrator": "真幌", "text": "…人の話を最後まで\n聞かないヤツだ。"},
        { "location": "227/TALK"    , "narrator": "ガブリエラ", "text": "ぐっ、くぬ～～～っ！！"},
        { "location": "235/TALK"    , "narrator": "ガブリエラ", "text": "はぁ、はぁ…\nな、何よこれ…\nバカみたいに重いわ！"},
        { "location": "237/TALK"    , "narrator": "ガブリエラ", "text": "アーヤかつばめでも呼んで\n手伝ってもらわないと。"},
        { "location": "241/TALK"    , "narrator": "ヒカル", "text": "大丈夫ですか？"},
        { "location": "244/TALK"    , "narrator": "ガブリエラ", "text": "っ！？"},
        { "location": "247/TALK"    , "narrator": "キリト", "text": "よっ！　なんかスッゲェ\n重たそうだな。"},
        { "location": "249/TALK"    , "narrator": "ヒカル", "text": "これって…ああ、映写機の\n交換用パーツですか。"},
        { "location": "251/TALK"    , "narrator": "ヒカル", "text": "ガブリエラさんだけで\n運ぶのは無茶ですよ。"},
        { "location": "253/TALK"    , "narrator": "キリト", "text": "だな。よっしゃ、ヒカル！\n俺が前持つから、おまえは\n後ろ頼んだぜ！"},
        { "location": "256/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "272/TALK"    , "narrator": "ガブリエラ", "text": "もぉ、どうしていつもこうなの！？"},
        { "location": "274/TALK"    , "narrator": "ガブリエラ", "text": "これじゃまるで、礼儀知らずの最低女じゃない！"},
        { "location": "275/TALK"    , "narrator": "ガブリエラ", "text": "バカバカ、私のバカ！！"},
        { "location": "277/SEL"     , "narrator": "", "text": "落ち着いて、どうしたの？"},
        { "location": "278/ACT"     , "narrator": "", "text": "落ち着いて、どうしたの？"},
        { "location": "281/TALK"    , "narrator": "ガブリエラ", "text": "凄く重い映写機の交換用パーツなんだけど"},
        { "location": "282/TALK"    , "narrator": "ガブリエラ", "text": "私の代わりに、キリトとヒカルくんが運んでくれてるの"},
        { "location": "283/TALK"    , "narrator": "ガブリエラ", "text": "なのに、私、お礼が言えなくて…"},
        { "location": "284/TALK"    , "narrator": "ガブリエラ", "text": "凄く嬉しいし、感謝もしてるのよ！？"},
        { "location": "285/TALK"    , "narrator": "ガブリエラ", "text": "でも、どうしても男の人相手だと声が出なくなっちゃうの"},
        { "location": "286/TALK"    , "narrator": "ガブリエラ", "text": "$marzanna$、私はどうしたら良いの？"},
        { "location": "288/SEL"     , "narrator": "", "text": "頑張って！"},
        { "location": "289/SEL"     , "narrator": "", "text": "何も言わなくて良いよ"},
        { "location": "290/SEL"     , "narrator": "", "text": "$marzanna$にお任せあれ"},
        { "location": "291/ACT"     , "narrator": "", "text": "頑張って！"},
        { "location": "292/TALK"    , "narrator": "ガブリエラ", "text": "…やっぱり、お礼を言わないのは失礼よね"},
        { "location": "293/TALK"    , "narrator": "ガブリエラ", "text": "わかったわ、$marzanna$"},
        { "location": "294/TALK"    , "narrator": "ガブリエラ", "text": "私、頑張ってみる！"},
        { "location": "305/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "308/TALK"    , "narrator": "キリト", "text": "ふんぬっ！　くぅ～…\nえ、映写室、どこだった\nっけかぁ？"},
        { "location": "311/TALK"    , "narrator": "ヒカル", "text": "に、二階です、二階！\n場所もわからないのに\n前になったんですか！？"},
        { "location": "312/TALK"    , "narrator": "キリト", "text": "今わかったから良いだろ！\nほれ、力入れろぉ！"},
        { "location": "313/TALK"    , "narrator": "ガブリエラ", "text": "ああ、こんなに頑張って\nくれてるのに！"},
        { "location": "314/TALK"    , "narrator": "ガブリエラ", "text": "どうして出ないのよ！？\nありがとう、の一言くらい\n簡単なはずなのに！！"},
        { "location": "315/TALK"    , "narrator": "ヒカル", "text": "き、キリト！？\n階段上るときは上るって\n一声掛けてください！"},
        { "location": "316/TALK"    , "narrator": "キリト", "text": "わ、わりぃ…余裕なくて。"},
        { "location": "317/TALK"    , "narrator": "キリト", "text": "けど、もう一踏ん張りだ！\n行くぜぇ！！"},
        { "location": "318/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "320/TALK"    , "narrator": "ガブリエラ", "text": "…やっぱりダメだわ。\n声、全然出てくれない。"},
        { "location": "321/TALK"    , "narrator": "ガブリエラ", "text": "あとで手紙でお礼言おう。"},
        { "location": "322/ACT"     , "narrator": "", "text": "何も言わなくて良いよ"},
        { "location": "323/TALK"    , "narrator": "ガブリエラ", "text": "…二人も、わかってるよね？"},
        { "location": "324/TALK"    , "narrator": "ガブリエラ", "text": "私が何も言えなくなっちゃう、ってこと…"},
        { "location": "336/TALK"    , "narrator": "ヒカル", "text": "キリト、もっとしっかり\n持ってください！\n落ちそうです！"},
        { "location": "338/TALK"    , "narrator": "キリト", "text": "お、おうっ！\nっしゃぁー！！"},
        { "location": "339/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "360/TALK"    , "narrator": "キリト", "text": "ぜーっ、ぜーっ…\nき、キツかったぜ…。"},
        { "location": "363/TALK"    , "narrator": "ヒカル", "text": "ほ、本当、ですね…。\n男二人でもこんなに\n疲れるなんて――"},
        { "location": "364/TALK"    , "narrator": "ヒカル", "text": "ガブリエラさん一人じゃ、\n絶対に無理でしたよ。"},
        { "location": "365/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "369/TALK"    , "narrator": "キリト", "text": "ふぅ…まあ、男手が\n必要なときはいつでも\n呼んでくれよ。"},
        { "location": "370/TALK"    , "narrator": "キリト", "text": "俺とヒカルでどうにか\nなることなら、何でも\nやってやるからさ。"},
        { "location": "371/TALK"    , "narrator": "ヒカル", "text": "じゃあ、僕達は向こうに\n戻りますね。"},
        { "location": "372/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "378/TALK"    , "narrator": "ガブリエラ", "text": "…あたし、最低だわ。"},
        { "location": "380/TALK"    , "narrator": "ガブリエラ", "text": "後で手紙を書いて\n謝らないと…。"},
        { "location": "381/ACT"     , "narrator": "", "text": "$marzanna$にお任せあれ"},
        { "location": "383/TALK"    , "narrator": "ガブリエラ", "text": "ああ、なんて頼りになるの$marzanna$！"},
        { "location": "384/TALK"    , "narrator": "ガブリエラ", "text": "あなたがいてくれて、私は本当に幸せ者よ"},
        { "location": "385/TALK"    , "narrator": "ガブリエラ", "text": "じゃあ画面を二人に見せるから、お礼のメッセージを表示してね"},
        { "location": "387/SEL"     , "narrator": "", "text": "手伝ってくれてありがと"},
        { "location": "388/SEL"     , "narrator": "", "text": "うむ、ご苦労である！"},
        { "location": "389/SEL"     , "narrator": "", "text": "素敵！　かっこいい！！"},
        { "location": "390/ACT"     , "narrator": "", "text": "手伝ってくれてありがと"},
        { "location": "414/TALK"    , "narrator": "キリト", "text": "ぜーっ、ぜーっ…\nき、キツかったぜ…。"},
        { "location": "417/TALK"    , "narrator": "ヒカル", "text": "ほ、本当、ですね…。\n男二人でもこんなに\n疲れるなんて――"},
        { "location": "418/TALK"    , "narrator": "ヒカル", "text": "ガブリエラさん一人じゃ、\n絶対に無理でしたよ。"},
        { "location": "420/TALK"    , "narrator": "ガブリエラ", "text": "よし、今よ！"},
        { "location": "422/TALK"    , "narrator": "ガブリエラ", "text": "…………っ！！"},
        { "location": "426/TALK"    , "narrator": "ヒカル", "text": "え？　…キリト。\nガブリエラさんが…。"},
        { "location": "430/TALK"    , "narrator": "キリト", "text": "…ん？"},
        { "location": "431/TALK"    , "narrator": "キリト", "text": "…ははっ、別に良いって。\nこんくらい平気だっての。"},
        { "location": "433/TALK"    , "narrator": "ヒカル", "text": "どういたしまして。\nまた何かあれば、いつでも\n言ってくださいね。"},
        { "location": "434/TALK"    , "narrator": "キリト", "text": "遠慮はいらねぇからな。\nそんじゃ、俺達は向こうに\n戻るぜ。"},
        { "location": "441/TALK"    , "narrator": "ガブリエラ", "text": "ほっ…よかった。\nちゃんと伝わったみたい。"},
        { "location": "444/TALK"    , "narrator": "ガブリエラ", "text": "$marzanna$のおかげね。"},
        { "location": "461/ACT"     , "narrator": "", "text": "うむ、ご苦労である！"},
        { "location": "482/TALK"    , "narrator": "キリト", "text": "ぜーっ、ぜーっ…\nき、キツかったぜ…。"},
        { "location": "485/TALK"    , "narrator": "ヒカル", "text": "ほ、本当、ですね…。\n男二人でもこんなに\n疲れるなんて――"},
        { "location": "486/TALK"    , "narrator": "ヒカル", "text": "ガブリエラさん一人じゃ、\n絶対に無理でしたよ。"},
        { "location": "489/TALK"    , "narrator": "ガブリエラ", "text": "よし、今よ！"},
        { "location": "493/TALK"    , "narrator": "キリト", "text": "…んあ？\n何だこれ？"},
        { "location": "496/TALK"    , "narrator": "ヒカル", "text": "えーっと…これは多分、\nＢｏｔでしょうか？"},
        { "location": "497/TALK"    , "narrator": "キリト", "text": "ガブリエラ、Ｂｏｔが\n変なこと言ってるぞ。"},
        { "location": "499/TALK"    , "narrator": "ガブリエラ", "text": "…………っ！？"},
        { "location": "500/TALK"    , "narrator": "ガブリエラ", "text": "ま、$marzanna$！！\nこれはお礼じゃないわ！"},
        { "location": "502/TALK"    , "narrator": "キリト", "text": "ぷっ…おまえ、いつも\nこんな面白いＢｏｔと\n話してんのかよ。"},
        { "location": "503/TALK"    , "narrator": "ヒカル", "text": "一応、僕達に労いの\n言葉をかけてくれている\nみたいですね。"},
        { "location": "504/TALK"    , "narrator": "キリト", "text": "だな。まあ、こんくらい\n礼言われるまでもねぇ\nからさ――"},
        { "location": "505/TALK"    , "narrator": "キリト", "text": "何かあったらまた呼びな。\nじゃあな。"},
        { "location": "506/TALK"    , "narrator": "ヒカル", "text": "それじゃあ。"},
        { "location": "513/TALK"    , "narrator": "ガブリエラ", "text": "ほっ…怒ってはいない\nみたいで安心したけど――"},
        { "location": "515/TALK"    , "narrator": "ガブリエラ", "text": "$marzanna$ったらもう、\n困った子なんだから！"},
        { "location": "516/ACT"     , "narrator": "", "text": "素敵！　かっこいい！！"},
        { "location": "538/TALK"    , "narrator": "キリト", "text": "ぜーっ、ぜーっ…\nき、キツかったぜ…。"},
        { "location": "541/TALK"    , "narrator": "ヒカル", "text": "ほ、本当、ですね…。\n男二人でもこんなに\n疲れるなんて――"},
        { "location": "542/TALK"    , "narrator": "ヒカル", "text": "ガブリエラさん一人じゃ、\n絶対に無理でしたよ。"},
        { "location": "545/TALK"    , "narrator": "ガブリエラ", "text": "よし、今よ！"},
        { "location": "549/TALK"    , "narrator": "キリト", "text": "…ん？"},
        { "location": "551/TALK"    , "narrator": "キリト", "text": "…あ～、ガブリエラ？\nこれはちょっとキャラが\n変わり過ぎじゃねぇか？"},
        { "location": "552/TALK"    , "narrator": "ガブリエラ", "text": "え？"},
        { "location": "554/TALK"    , "narrator": "ヒカル", "text": "褒めては貰えているみたい\nですけど…。"},
        { "location": "556/TALK"    , "narrator": "ガブリエラ", "text": "な、なに？\n何が表示されて…。"},
        { "location": "558/TALK"    , "narrator": "ガブリエラ", "text": "っ！？"},
        { "location": "560/TALK"    , "narrator": "ガブリエラ", "text": "なっ、何よこれー！？"},
        { "location": "562/TALK"    , "narrator": "キリト", "text": "はははっ、ガブリエラが\nそんなに驚いたとこ、\n初めて見たぜ。"},
        { "location": "563/TALK"    , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "566/TALK"    , "narrator": "ヒカル", "text": "キリト！"},
        { "location": "567/TALK"    , "narrator": "キリト", "text": "っと、ごめんな。\nつい…。"},
        { "location": "570/TALK"    , "narrator": "ヒカル", "text": "それじゃあ、僕達は\n戻りますね。"},
        { "location": "571/TALK"    , "narrator": "キリト", "text": "力仕事が必要なときは、\n素敵な俺達が手伝って\nやるからなー！"},
        { "location": "579/TALK"    , "narrator": "ガブリエラ", "text": "くっ…ぐぬぬぬ…！"},
        { "location": "581/TALK"    , "narrator": "ガブリエラ", "text": "もぉ、$marzanna$の\nバカバカバカーッ！！"},
        { "location": "195/DIALOG"  , "narrator": "Dialog_EventData", "text": "<color=green>7月17日　1:23 PM</color>\nとある休日の午後、神楽坂トライナリー劇場でのバイト中のこと。"},
        { "location": "455/DIALOG"  , "narrator": "Dialog_GEThimegoto_ch03", "text": "【口にする日を】"}
    ]
}
