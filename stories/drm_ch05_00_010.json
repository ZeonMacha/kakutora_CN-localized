    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "一枚多くカードを持ってる"},
        { "location": "32/TALK"   , "narrator": "神楽", "text": "$handle$さんに質問です"},
        { "location": "33/TALK"   , "narrator": "神楽", "text": "あなたは何者なんでしょうか？"},
        { "location": "35/SEL"    , "narrator": "", "text": "神楽の味方"},
        { "location": "36/SEL"    , "narrator": "", "text": "恋人候補"},
        { "location": "37/SEL"    , "narrator": "", "text": "$me$は$me$だよ？"},
        { "location": "38/ACT"    , "narrator": "", "text": "神楽の味方"},
        { "location": "39/TALK"   , "narrator": "神楽", "text": "そうなんですね"},
        { "location": "40/TALK"   , "narrator": "神楽", "text": "なんて"},
        { "location": "41/TALK"   , "narrator": "神楽", "text": "あっさり信じられると思いますか？"},
        { "location": "42/ACT"    , "narrator": "", "text": "恋人候補"},
        { "location": "43/TALK"   , "narrator": "神楽", "text": "なんでそうなるんですか？"},
        { "location": "45/TALK"   , "narrator": "神楽", "text": "わけがわかりません"},
        { "location": "46/ACT"    , "narrator": "", "text": "$me$は$me$だよ？"},
        { "location": "47/TALK"   , "narrator": "神楽", "text": "全く答えになってないですね"},
        { "location": "49/TALK"   , "narrator": "神楽", "text": "私はこの世界に理由があって送り込まれました"},
        { "location": "50/TALK"   , "narrator": "神楽", "text": "それなのに"},
        { "location": "51/TALK"   , "narrator": "神楽", "text": "この世界でまた面倒な人間に会いました"},
        { "location": "53/SEL"    , "narrator": "", "text": "千羽鶴のこと？"},
        { "location": "54/SEL"    , "narrator": "", "text": "つばめのことかな？"},
        { "location": "55/SEL"    , "narrator": "", "text": "$me$は神楽のことが好きなだけだよ"},
        { "location": "56/ACT"    , "narrator": "", "text": "千羽鶴のこと？"},
        { "location": "57/TALK"   , "narrator": "神楽", "text": "そうですね"},
        { "location": "58/ACT"    , "narrator": "", "text": "つばめのことかな？"},
        { "location": "59/TALK"   , "narrator": "神楽", "text": "いずれ会うことになっていますが"},
        { "location": "60/TALK"   , "narrator": "神楽", "text": "現段階では接触していません"},
        { "location": "61/ACT"    , "narrator": "", "text": "$me$は神楽のことが好きなだけだよ"},
        { "location": "62/TALK"   , "narrator": "神楽", "text": "あなたの話はしていません"},
        { "location": "63/TALK"   , "narrator": "神楽", "text": "千羽鶴の話をしています"},
        { "location": "65/TALK"   , "narrator": "神楽", "text": "千羽鶴は面倒ではありますが"},
        { "location": "66/TALK"   , "narrator": "神楽", "text": "私に接触した理由ははっきりしています"},
        { "location": "67/TALK"   , "narrator": "神楽", "text": "だからそれは構わない"},
        { "location": "68/TALK"   , "narrator": "神楽", "text": "でも"},
        { "location": "69/TALK"   , "narrator": "神楽", "text": "あなたはなぜ私と関わりを持とうとするんですか？"},
        { "location": "71/SEL"    , "narrator": "", "text": "あなたじゃなくて$handle$って呼んでよ"},
        { "location": "72/SEL"    , "narrator": "", "text": "神楽が好きだから"},
        { "location": "73/SEL"    , "narrator": "", "text": "神楽とラブラブになりたいから（ｷﾘｯ"},
        { "location": "74/ACT"    , "narrator": "", "text": "あなたじゃなくて$handle$って呼んでよ"},
        { "location": "75/TALK"   , "narrator": "神楽", "text": "いや"},
        { "location": "76/TALK"   , "narrator": "神楽", "text": "だから"},
        { "location": "77/ACT"    , "narrator": "", "text": "神楽が好きだから"},
        { "location": "78/TALK"   , "narrator": "神楽", "text": "そんなのは"},
        { "location": "79/TALK"   , "narrator": "神楽", "text": "理由とは認めない"},
        { "location": "80/ACT"    , "narrator": "", "text": "神楽とラブラブになりたいから（ｷﾘｯ"},
        { "location": "81/TALK"   , "narrator": "神楽", "text": "は？"},
        { "location": "82/TALK"   , "narrator": "神楽", "text": "寝言にもほどがありますね"},
        { "location": "84/TALK"   , "narrator": "神楽", "text": "この世界を作り直したいからとか"},
        { "location": "85/TALK"   , "narrator": "神楽", "text": "自分の望む世界に改変したいならまだわかります"},
        { "location": "86/TALK"   , "narrator": "神楽", "text": "でもあなたの理由は個人的すぎるし意味もない"},
        { "location": "88/SEL"    , "narrator": "", "text": "だって個人的な理由なんだもん"},
        { "location": "89/SEL"    , "narrator": "", "text": "意味はあるよ！"},
        { "location": "90/SEL"    , "narrator": "", "text": "$me$と神楽でこの世界を満たしたいだけ"},
        { "location": "91/ACT"    , "narrator": "", "text": "だって個人的な理由なんだもん"},
        { "location": "92/TALK"   , "narrator": "神楽", "text": "この話をしても平行線のままみたいですね"},
        { "location": "93/TALK"   , "narrator": "神楽", "text": "もういいです"},
        { "location": "94/ACT"    , "narrator": "", "text": "意味はあるよ！"},
        { "location": "95/TALK"   , "narrator": "神楽", "text": "私にとってはないです"},
        { "location": "96/ACT"    , "narrator": "", "text": "$me$と神楽でこの世界を満たしたいだけ"},
        { "location": "97/TALK"   , "narrator": "神楽", "text": "はぁぁぁぁぁ！？"},
        { "location": "98/TALK"   , "narrator": "神楽", "text": "何それ"},
        { "location": "100/TALK"  , "narrator": "神楽", "text": "ぶっちゃけキモいですあなた"},
        { "location": "101/TALK"  , "narrator": "神楽", "text": "ちゃんと私に納得のいく説明もできないのにそんなことばかり言って"},
        { "location": "102/TALK"  , "narrator": "神楽", "text": "こうやって私はちゃんとあなたと会話しようとしているのに"},
        { "location": "103/TALK"  , "narrator": "神楽", "text": "もういいです"}
    ]
}
