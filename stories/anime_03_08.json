{
    "dir": "chap08/daydra/anime_03_08.js",
    "type": "MainStory",
    "info": {
        "story_id": "8301",
        "cid": "gabriella",
        "title": "001 アニメーション",
        "sub_title": "金色の髪のカグラ"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "アニメ第08話"},
        { "location": "48/TALK"   , "narrator": "千羽鶴", "text": "ごきげんよう、\n$handle$様。"},
        { "location": "49/SEL"    , "narrator": "", "text": "様！？"},
        { "location": "50/SEL"    , "narrator": "", "text": "よきにはからえ"},
        { "location": "52/ACT"    , "narrator": "", "text": "様！？"},
        { "location": "53/TALK"   , "narrator": "千羽鶴", "text": "そう。\n今日のこの瞬間だけは\n貴方はお客様。"},
        { "location": "54/TALK"   , "narrator": "千羽鶴", "text": "なぜなら、ご愛用者様\nアンケートをすることに\nなったから。"},
        { "location": "55/ACT"    , "narrator": "", "text": "よきにはからえ"},
        { "location": "57/TALK"   , "narrator": "千羽鶴", "text": "調子に乗らないで。"},
        { "location": "58/TALK"   , "narrator": "千羽鶴", "text": "単に今回は、ご愛用者様\nアンケートをすることに\nなったから――"},
        { "location": "59/TALK"   , "narrator": "千羽鶴", "text": "形式的に、お客様向けの\n定型文に当てはめて「様」\nがついてしまっただけ。"},
        { "location": "61/TALK"   , "narrator": "千羽鶴", "text": "それじゃ本題に入る。"},
        { "location": "63/TALK"   , "narrator": "千羽鶴", "text": "この異世界間接続チャット\nアプリは如何ですか？"},
        { "location": "65/SEL"    , "narrator": "", "text": "想像より濃いね"},
        { "location": "66/SEL"    , "narrator": "", "text": "これって本当に恋愛できるアプリなんですか？"},
        { "location": "67/SEL"    , "narrator": "", "text": "早く恋愛させろ"},
        { "location": "68/SEL"    , "narrator": "", "text": "もっと戦闘させろ"},
        { "location": "69/SEL"    , "narrator": "", "text": "千羽鶴ちゃんとゴールしたい"},
        { "location": "70/SEL"    , "narrator": "", "text": "チュートリアルのパネルのデコ、うるさくね？"},
        { "location": "71/SEL"    , "narrator": "", "text": "特にない\n<color=blue>（※先へ進みます）</color>"},
        { "location": "72/ACT"    , "narrator": "", "text": "想像より濃いね"},
        { "location": "73/TALK"   , "narrator": "千羽鶴", "text": "その感想には\n納得出来る。"},
        { "location": "74/TALK"   , "narrator": "千羽鶴", "text": "でも、その辺りはあまり\n気にしなくても大丈夫。"},
        { "location": "75/TALK"   , "narrator": "千羽鶴", "text": "全然意味が分からない！\nという場合でも彼女との\nイチャコラは出来るし――"},
        { "location": "76/TALK"   , "narrator": "千羽鶴", "text": "もっとディープに！という\n場合はいくら掘り下げても\n答えが存在する。"},
        { "location": "77/TALK"   , "narrator": "千羽鶴", "text": "あなたはどっち？"},
        { "location": "78/SEL"    , "narrator": "千羽鶴", "text": "イチャコラだけでいい"},
        { "location": "79/SEL"    , "narrator": "千羽鶴", "text": "もっとディープに"},
        { "location": "80/ACT"    , "narrator": "千羽鶴", "text": "イチャコラだけでいい"},
        { "location": "81/TALK"   , "narrator": "千羽鶴", "text": "とてもいい答え。"},
        { "location": "82/TALK"   , "narrator": "千羽鶴", "text": "私が説明する手間が\n省けてとてもいい。"},
        { "location": "83/TALK"   , "narrator": "千羽鶴", "text": "これからも是非、彼女の\n戦いを応援しながら、夜は\nイチャコラしまくって。"},
        { "location": "84/TALK"   , "narrator": "千羽鶴", "text": "それだけでも十分\n私の世界の為になるから。"},
        { "location": "85/ACT"    , "narrator": "", "text": "もっとディープに"},
        { "location": "86/TALK"   , "narrator": "千羽鶴", "text": "理系の人？\n哲学の人？"},
        { "location": "87/TALK"   , "narrator": "千羽鶴", "text": "突き詰めるタイプは\n嫌いじゃない。"},
        { "location": "88/TALK"   , "narrator": "千羽鶴", "text": "また時間があるときにでも\n色々語り合いましょ。"},
        { "location": "90/TALK"   , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "92/ACT"    , "narrator": "", "text": "これって本当に恋愛できるアプリなんですか？"},
        { "location": "93/TALK"   , "narrator": "千羽鶴", "text": "とても良い質問。"},
        { "location": "95/TALK"   , "narrator": "千羽鶴", "text": "実は私も\n自信が無くなってきた。"},
        { "location": "96/SEL"    , "narrator": "", "text": "え！？"},
        { "location": "97/SEL"    , "narrator": "", "text": "ちょｗｗ"},
        { "location": "98/ACT"    , "narrator": "", "text": "え！？"},
        { "location": "99/ACT"    , "narrator": "", "text": "ちょｗｗ"},
        { "location": "102/TALK"  , "narrator": "千羽鶴", "text": "というのは冗談。"},
        { "location": "103/TALK"  , "narrator": "千羽鶴", "text": "もちろん、\nガチで恋愛できる。"},
        { "location": "104/TALK"  , "narrator": "千羽鶴", "text": "どれくらいガチかと\nいうと、他の恋愛アプリを\n１とした場合――"},
        { "location": "107/TALK"  , "narrator": "千羽鶴", "text": "……んと、"},
        { "location": "111/TALK"  , "narrator": "千羽鶴", "text": "1.593くらい？"},
        { "location": "112/SEL"   , "narrator": "", "text": "微妙な数字ですね…"},
        { "location": "113/ACT"   , "narrator": "", "text": "微妙な数字ですね…"},
        { "location": "116/TALK"  , "narrator": "千羽鶴", "text": "まあ、適当な数字だから\nあまり気にしないで。"},
        { "location": "117/TALK"  , "narrator": "千羽鶴", "text": "とにかく、「実は恋愛\nなんてできませんでした」\nということは絶対ない。"},
        { "location": "118/TALK"  , "narrator": "千羽鶴", "text": "だから、心配しないで。"},
        { "location": "119/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "121/ACT"   , "narrator": "", "text": "早く恋愛させろ"},
        { "location": "122/TALK"  , "narrator": "千羽鶴", "text": "横着者。"},
        { "location": "123/TALK"  , "narrator": "千羽鶴", "text": "まだ彼女とは\n付き合い始めた\nばかりなのに。"},
        { "location": "124/TALK"  , "narrator": "千羽鶴", "text": "世の中には、\n出逢った瞬間から"},
        { "location": "126/TALK"  , "narrator": "千羽鶴", "text": "す、好きですっ！\nつき合ってください！"},
        { "location": "128/TALK"  , "narrator": "千羽鶴", "text": "なんて言ってくる子が\n大量投下されるゲーム\nが山ほどあるけど――"},
        { "location": "129/TALK"  , "narrator": "千羽鶴", "text": "このアプリは\nそういうことはしない。"},
        { "location": "130/TALK"  , "narrator": "千羽鶴", "text": "本当の恋愛は、相手を\n知り、受け入れて、\n少しずつ進展するもの。"},
        { "location": "131/TALK"  , "narrator": "千羽鶴", "text": "焦らなくても、あなた\nがその気なら、絶対に\n恋愛はできる。"},
        { "location": "132/TALK"  , "narrator": "千羽鶴", "text": "だから焦らずじっくりと\n彼女の今を\n受けとめてあげて。"},
        { "location": "133/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "135/ACT"   , "narrator": "", "text": "もっと戦闘させろ"},
        { "location": "137/TALK"  , "narrator": "千羽鶴", "text": "貴方は前途有望ね。"},
        { "location": "138/TALK"  , "narrator": "千羽鶴", "text": "貴方の希望に添えるよう、\nもっと戦いのフィールドを\n増やせるか検討してみる。"},
        { "location": "139/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "141/ACT"   , "narrator": "", "text": "千羽鶴ちゃんとゴールしたい"},
        { "location": "142/TALK"  , "narrator": "千羽鶴", "text": "はい、\nゴーーーール！"},
        { "location": "144/TALK"  , "narrator": "千羽鶴", "text": "これでいい？"},
        { "location": "145/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "147/ACT"   , "narrator": "", "text": "チュートリアルのパネルのデコ、うるさくね？"},
        { "location": "148/TALK"  , "narrator": "千羽鶴", "text": "うるさい黙れ。"},
        { "location": "149/TALK"  , "narrator": "千羽鶴", "text": "少しでも\n和むと思ひて\n夜なべれど"},
        { "location": "150/TALK"  , "narrator": "千羽鶴", "text": "後に聞こゆは\n文句ばかり。\n読み人知らず。"},
        { "location": "151/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "153/ACT"   , "narrator": "", "text": "特にない\n<color=blue>（※先へ進みます）</color>"},
        { "location": "155/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "156/TALK"  , "narrator": "千羽鶴", "text": "ご回答ありがとう\nございました。"},
        { "location": "160/TALK"  , "narrator": "千羽鶴", "text": "いつも通り、今回も\n逢瀬つばめの解説を\nするだけでいい？"},
        { "location": "162/TALK"  , "narrator": "千羽鶴", "text": "いつも通り、今回も\n國政綾水の解説を\nするだけでいい？"},
        { "location": "164/TALK"  , "narrator": "千羽鶴", "text": "いつも通り、今回も\nガブリエラの解説を\nするだけでいい？"},
        { "location": "166/TALK"  , "narrator": "千羽鶴", "text": "いつも通り、今回も\n恋ヶ崎みやびの解説を\nするだけでいい？"},
        { "location": "168/TALK"  , "narrator": "千羽鶴", "text": "それで？\n恋ヶ崎みやびの\n解説だけでいい？"},
        { "location": "170/SEL"   , "narrator": "", "text": "はい"},
        { "location": "171/SEL"   , "narrator": "", "text": "いいえ"},
        { "location": "172/ACT"   , "narrator": "", "text": "はい"},
        { "location": "174/TALK"  , "narrator": "千羽鶴", "text": "よかった。\n私も助かる。\nこれぞWIN-WINね。"},
        { "location": "176/ACT"   , "narrator": "", "text": "いいえ"},
        { "location": "177/TALK"  , "narrator": "千羽鶴", "text": "わかった。\nそれじゃもう１回\n同じ話をする。"},
        { "location": "182/TALK"  , "narrator": "千羽鶴", "text": "前回もお疲れさま。"},
        { "location": "184/TALK"  , "narrator": "千羽鶴", "text": "貴方の頑張りのお陰で、\n今回も時間を先へと\n進めることができる。"},
        { "location": "185/TALK"  , "narrator": "千羽鶴", "text": "そして今回はいよいよ、\nフェノメノン戦の\n決着がつきそう。"},
        { "location": "186/TALK"  , "narrator": "千羽鶴", "text": "貴方の頑張りが\n生きていれば、彼女たちは\n良い結果をもたらす。"},
        { "location": "188/TALK"  , "narrator": "千羽鶴", "text": "というわけで、早速\n記録映像の続きを\n再生しようと思う。"},
        { "location": "189/TALK"  , "narrator": "千羽鶴", "text": "準備はいい？"},
        { "location": "191/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/95MB 6:14】</color>"},
        { "location": "192/SEL"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/30MB 6:14】</color>"},
        { "location": "193/SEL"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "194/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【高画質/95MB 6:14】</color>"},
        { "location": "195/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "201/ACT"   , "narrator": "", "text": "映像を見る\n<color=green>【標準画質/30MB 6:14】</color>"},
        { "location": "202/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "208/ACT"   , "narrator": "", "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>"},
        { "location": "209/TALK"  , "narrator": "千羽鶴", "text": "わかった。"},
        { "location": "210/TALK"  , "narrator": "千羽鶴", "text": "残念だけど、いろいろ\n事情があってのことだと\n思うから。"},
        { "location": "211/TALK"  , "narrator": "千羽鶴", "text": "家に帰ったら、是非\n映像記録の方も\n見てみて欲しい。"},
        { "location": "212/TALK"  , "narrator": "千羽鶴", "text": "それではどうぞ。"},
        { "location": "245/TALK"  , "narrator": "千羽鶴", "text": "めでたしめでたし。"},
        { "location": "247/SEL"   , "narrator": "", "text": "クランってどうやれば捕獲なの？"},
        { "location": "248/SEL"   , "narrator": "", "text": "クランたちは何で畳部屋でくつろいでるの？"},
        { "location": "249/SEL"   , "narrator": "", "text": "お風呂シーンキター！！"},
        { "location": "250/SEL"   , "narrator": "", "text": "はだかのクランの子キター！！"},
        { "location": "251/SEL"   , "narrator": "", "text": "特にない\n<color=blue>（※先へ進みます）</color>"},
        { "location": "252/ACT"   , "narrator": "", "text": "クランってどうやれば捕獲なの？"},
        { "location": "253/TALK"  , "narrator": "千羽鶴", "text": "いい質問。"},
        { "location": "254/TALK"  , "narrator": "千羽鶴", "text": "クランは自らの周りに\n【鎧】と言われる何かを\n身にまとっている。"},
        { "location": "255/TALK"  , "narrator": "千羽鶴", "text": "その【鎧】の外に、\nクラン本体を引きずり\n出せばゴール！　になる。"},
        { "location": "259/TALK"  , "narrator": "千羽鶴", "text": "例えば今回の場合は、\n携帯型のガジェットが\n【鎧】となっていて――"},
        { "location": "261/TALK"  , "narrator": "千羽鶴", "text": "そして前回のドーム戦の\nクラン「テルプシコラ」は\n女剣士自体が【鎧】だった。"},
        { "location": "264/TALK"  , "narrator": "千羽鶴", "text": "【鎧】とはすなわち、その\nクランが自らの目的を達成\nするための城。"},
        { "location": "266/TALK"  , "narrator": "千羽鶴", "text": "そしてその【鎧】こそが、\nクランが暴走して世界を\n構築する原因でもある。"},
        { "location": "267/TALK"  , "narrator": "千羽鶴", "text": "ちょっと難しい精神的な\n話になるから、これ以上は\n割愛するけど――"},
        { "location": "268/TALK"  , "narrator": "千羽鶴", "text": "トライナリーはその【鎧】\nを断定し、何らかの方法で\n本体を引っ張り出す。"},
        { "location": "269/TALK"  , "narrator": "千羽鶴", "text": "それが\n任務ということになる。"},
        { "location": "270/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "272/ACT"   , "narrator": "", "text": "クランたちは何で畳部屋でくつろいでるの？"},
        { "location": "273/TALK"  , "narrator": "千羽鶴", "text": "保護されたクランは、\n全部神楽坂トライナリー\n劇場に送られる。"},
        { "location": "274/TALK"  , "narrator": "千羽鶴", "text": "クランとは人の心の一部。\nけど、一度離れたらもう\nその人の心には戻れない。"},
        { "location": "275/TALK"  , "narrator": "千羽鶴", "text": "けどその状態は魂だけの\nようなものだから、その\nままでは長く存在できない。"},
        { "location": "276/TALK"  , "narrator": "千羽鶴", "text": "そう、クランは発症者の\n身体にある、大元の状態か\nもしくは――"},
        { "location": "277/TALK"  , "narrator": "千羽鶴", "text": "フェノメノンを展開した、\nすなわち【鎧】を纏ってる\n状態でないと生きられない。"},
        { "location": "278/TALK"  , "narrator": "千羽鶴", "text": "では【鎧】を剥いで、\nかつ本人の心にも戻れない\n状態は、死あるのみか？"},
        { "location": "282/TALK"  , "narrator": "千羽鶴", "text": "その問題を解決できるのが\n神楽坂トライナリーという\n映画館になる。"},
        { "location": "283/TALK"  , "narrator": "千羽鶴", "text": "どういう仕組みかは割愛\nするけど、あの施設は\nクランの仮の鎧になる。"},
        { "location": "285/TALK"  , "narrator": "千羽鶴", "text": "だから、あの建物の中に\nいる間は、彼らは普通の\n人間のように生活できる。"},
        { "location": "286/TALK"  , "narrator": "千羽鶴", "text": "もちろん物理体は無いから\n幽霊みたいな感じでは\nあるけれども。"},
        { "location": "290/TALK"  , "narrator": "千羽鶴", "text": "ちゃんと理解出来た？"},
        { "location": "292/TALK"  , "narrator": "千羽鶴", "text": "他にも何かあれば。"},
        { "location": "294/ACT"   , "narrator": "", "text": "お風呂シーンキター！！"},
        { "location": "296/TALK"  , "narrator": "千羽鶴", "text": "ええ、その反応は、\n来ると思ってた。"},
        { "location": "297/TALK"  , "narrator": "千羽鶴", "text": "良かったわね。"},
        { "location": "298/SEL"   , "narrator": "", "text": "神楽と代わりたい！"},
        { "location": "299/SEL"   , "narrator": "", "text": "つばめと代わりたい！"},
        { "location": "300/SEL"   , "narrator": "", "text": "千羽鶴はお風呂に入らないの？"},
        { "location": "301/SEL"   , "narrator": "", "text": "神楽の洗い残し攻撃の本当の目的は何？"},
        { "location": "302/ACT"   , "narrator": "", "text": "神楽と代わりたい！"},
        { "location": "303/TALK"  , "narrator": "千羽鶴", "text": "ああ、洗い残しを\n洗ったりしたいのね。"},
        { "location": "304/TALK"  , "narrator": "千羽鶴", "text": "卯月神楽曰く、\n逢瀬つばめは思いの外\n大きくてやわらかいらしい。"},
        { "location": "306/TALK"  , "narrator": "千羽鶴", "text": "貴方も逢瀬つばめと交流を\n続ければ、いずれは同じ\nことができるかも。"},
        { "location": "307/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "308/TALK"  , "narrator": "千羽鶴", "text": "もちろん冗談だけど。"},
        { "location": "309/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "310/ACT"   , "narrator": "", "text": "つばめと代わりたい！"},
        { "location": "312/TALK"  , "narrator": "千羽鶴", "text": "ああ、それって要するに\n揉まれたいってこと？"},
        { "location": "313/TALK"  , "narrator": "千羽鶴", "text": "こうして話してると、\n貴方の深層心理が垣間\n見えてとても面白い。"},
        { "location": "314/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "315/ACT"   , "narrator": "", "text": "千羽鶴はお風呂に入らないの？"},
        { "location": "316/TALK"  , "narrator": "千羽鶴", "text": "デジタルコンテンツの\nチュートリアルキャラが\nお風呂に？"},
        { "location": "317/TALK"  , "narrator": "千羽鶴", "text": "冗談にしては\n面白くない。"},
        { "location": "318/SEL"   , "narrator": "", "text": "生身でも出演してたよね？"},
        { "location": "319/ACT"   , "narrator": "", "text": "生身でも出演してたよね？"},
        { "location": "321/TALK"  , "narrator": "千羽鶴", "text": "だからあれは、従兄弟の\n姪の友だちの姉だから。"},
        { "location": "322/SEL"   , "narrator": "", "text": "身内ですら無くなってるし！"},
        { "location": "323/ACT"   , "narrator": "", "text": "身内ですら無くなってるし！"},
        { "location": "324/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "326/ACT"   , "narrator": "", "text": "神楽の洗い残し攻撃の本当の目的は何？"},
        { "location": "327/TALK"  , "narrator": "千羽鶴", "text": "……？　意味が\n分からないのだけど？"},
        { "location": "328/TALK"  , "narrator": "千羽鶴", "text": "何となくあったから\n適当に選んだだけでしょ？"},
        { "location": "329/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "332/TALK"  , "narrator": "千羽鶴", "text": "なんでそんな選択肢が\nあったのかしら。"},
        { "location": "334/TALK"  , "narrator": "千羽鶴", "text": "このアプリは\nちょっと危険かも……。"},
        { "location": "337/ACT"   , "narrator": "", "text": "はだかのクランの子キター！！"},
        { "location": "339/TALK"  , "narrator": "千羽鶴", "text": "ああ、そこ。\nちょっと盲点だった。"},
        { "location": "340/TALK"  , "narrator": "千羽鶴", "text": "よかったわね。"},
        { "location": "341/SEL"   , "narrator": "", "text": "何で裸だったんですか！"},
        { "location": "342/ACT"   , "narrator": "", "text": "何で裸だったんですか！"},
        { "location": "344/TALK"  , "narrator": "千羽鶴", "text": "クランの容姿や仕草、\n状態には大抵何らかの\n意味がある。"},
        { "location": "345/TALK"  , "narrator": "千羽鶴", "text": "それは、クランが人の\n心から生まれた存在で\nあり――"},
        { "location": "346/TALK"  , "narrator": "千羽鶴", "text": "その為潜在意識の願望や\n束縛をそのまま具現化\nしてしまったものだから。"},
        { "location": "347/TALK"  , "narrator": "千羽鶴", "text": "だから恐らくは、今回の\nクラン「ちとせ」が裸\nだったのにも意味がある。"},
        { "location": "348/TALK"  , "narrator": "千羽鶴", "text": "何らかの束縛からの解放、\n社会的な常識からの逸脱、\n快感の享受など――"},
        { "location": "349/TALK"  , "narrator": "千羽鶴", "text": "クランを発症するだけの\nエネルギーの源が、そこに\n関係していると思う。"},
        { "location": "351/TALK"  , "narrator": "千羽鶴", "text": "まあ、単に……"},
        { "location": "353/TALK"  , "narrator": "千羽鶴", "text": "潜在的に露出癖が\nあっただけかも\nしれないけど。"},
        { "location": "355/TALK"  , "narrator": "千羽鶴", "text": "他は？"},
        { "location": "357/ACT"   , "narrator": "", "text": "特にない\n<color=blue>（※先へ進みます）</color>"},
        { "location": "358/TALK"  , "narrator": "千羽鶴", "text": "そう。"},
        { "location": "365/TALK"  , "narrator": "千羽鶴", "text": "さて、今回の\n逢瀬つばめについて\nなんだけども。"},
        { "location": "366/TALK"  , "narrator": "千羽鶴", "text": "彼女と卯月神楽が\nお風呂から上がってからの\n続きにスポットを当てた。"},
        { "location": "367/TALK"  , "narrator": "千羽鶴", "text": "今までほど深刻な話では\n無いけど、彼女がちょっと\n悩んでるから助けてあげて。"},
        { "location": "368/TALK"  , "narrator": "千羽鶴", "text": "まあ今回は、そうね。\nちょっと閑話休題といった\nところかも。"},
        { "location": "369/TALK"  , "narrator": "千羽鶴", "text": "引越騒動も落ち着き、\nクラン戦も一段落して、\n同期の子も出来た。"},
        { "location": "370/TALK"  , "narrator": "千羽鶴", "text": "そんな\nちょっと一息つける\n時間だってある。"},
        { "location": "372/TALK"  , "narrator": "千羽鶴", "text": "貴方も今回は\n肩の力を抜いて、\n気楽に相手をしてあげて。"},
        { "location": "376/TALK"  , "narrator": "千羽鶴", "text": "さて、今回の\n國政綾水について\nなんだけども。"},
        { "location": "377/TALK"  , "narrator": "千羽鶴", "text": "今回の戦闘が\nあった日の翌日――"},
        { "location": "378/TALK"  , "narrator": "千羽鶴", "text": "ガブリエラと恋ヶ崎みやび\nとの、３人でのお茶会に\nスポットを当ててみる。"},
        { "location": "379/TALK"  , "narrator": "千羽鶴", "text": "今までと違い、生死を\n分かつようなものではない\nけど、これはこれで面白い。"},
        { "location": "380/TALK"  , "narrator": "千羽鶴", "text": "なぜなら、普段ドラマの\n表舞台には登ってこない\n彼女達の本音トーク――"},
        { "location": "381/TALK"  , "narrator": "千羽鶴", "text": "いわゆる楽屋話的な\nものを話しているから。"},
        { "location": "382/SEL"   , "narrator": "", "text": "それって新人２人の悪口とか！？"},
        { "location": "383/ACT"   , "narrator": "", "text": "それって新人２人の悪口とか！？"},
        { "location": "386/TALK"  , "narrator": "千羽鶴", "text": "流石にそれはない。\nけど――"},
        { "location": "387/TALK"  , "narrator": "千羽鶴", "text": "今回の新人２人は、先輩\n３人にはちょっと色々\n気になることがあるみたい。"},
        { "location": "388/TALK"  , "narrator": "千羽鶴", "text": "まあ、ヒソヒソ話を盗み\n聞きするのは気がひける\n人もいるかもだけど――"},
        { "location": "389/TALK"  , "narrator": "千羽鶴", "text": "彼女達も色々悩みながらの\nお茶会のようだから、適切に\nアドバイスしてあげて。"},
        { "location": "390/TALK"  , "narrator": "千羽鶴", "text": "それじゃ、\n良い結果を期待してる。"},
        { "location": "394/TALK"  , "narrator": "千羽鶴", "text": "さて、今回の\nガブリエラについて\nなんだけども。"},
        { "location": "395/TALK"  , "narrator": "千羽鶴", "text": "前回、戦闘中に彼女が\n抱いていた、もやっとした\nものを解決したわけだけど。"},
        { "location": "396/TALK"  , "narrator": "千羽鶴", "text": "まだ根源的な部分では\nしっかり解消できて\nいなかったみたい。"},
        { "location": "397/TALK"  , "narrator": "千羽鶴", "text": "だから今回も引き続き、\nそこのフォローアップを\nお願いしたいと思う。"},
        { "location": "398/TALK"  , "narrator": "千羽鶴", "text": "２回連続でグズった\n話は嫌、という人も\nいるかもしれない。"},
        { "location": "399/TALK"  , "narrator": "千羽鶴", "text": "けど今回は\nそれだけじゃないから\n安心して！"},
        { "location": "400/TALK"  , "narrator": "千羽鶴", "text": "何せシチュエーションは、\nガブリエラ、かける\n國政綾水の――"},
        { "location": "401/TALK"  , "narrator": "千羽鶴", "text": "お風呂！"},
        { "location": "404/TALK"  , "narrator": "千羽鶴", "text": "どーん！"},
        { "location": "405/SEL"   , "narrator": "", "text": "毎回いちいち暑苦しいです"},
        { "location": "406/ACT"   , "narrator": "", "text": "毎回いちいち暑苦しいです"},
        { "location": "409/TALK"  , "narrator": "千羽鶴", "text": "お風呂なだけに？"},
        { "location": "410/SEL"   , "narrator": "", "text": "さ、寒い……"},
        { "location": "411/SEL"   , "narrator": "", "text": "シャキーン！（凍結）"},
        { "location": "412/ACT"   , "narrator": "", "text": "さ、寒い……"},
        { "location": "413/ACT"   , "narrator": "", "text": "シャキーン！（凍結）"},
        { "location": "415/TALK"  , "narrator": "千羽鶴", "text": "これで\nプラスマイナスゼロに\nなったみたい。"},
        { "location": "416/TALK"  , "narrator": "千羽鶴", "text": "そんなわけだから、\n寧ろそっちを楽しんで！"},
        { "location": "417/TALK"  , "narrator": "千羽鶴", "text": "そしてついでに彼女を\n安心させてあげて！"},
        { "location": "418/SEL"   , "narrator": "", "text": "千羽鶴のテンションちょっと変？"},
        { "location": "419/ACT"   , "narrator": "", "text": "千羽鶴のテンションちょっと変？"},
        { "location": "422/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "424/TALK"  , "narrator": "千羽鶴", "text": "たまには私も、\nこんな風に羽目を外して\nみたいときもある。"},
        { "location": "425/SEL"   , "narrator": "", "text": "いつもお疲れさま。よしよし"},
        { "location": "426/SEL"   , "narrator": "", "text": "割といつもだと思います"},
        { "location": "427/ACT"   , "narrator": "", "text": "いつもお疲れさま。よしよし"},
        { "location": "429/TALK"  , "narrator": "千羽鶴", "text": "分かってくれればいいの。"},
        { "location": "430/ACT"   , "narrator": "", "text": "割といつもだと思います"},
        { "location": "431/TALK"  , "narrator": "千羽鶴", "text": "むー！"},
        { "location": "436/TALK"  , "narrator": "千羽鶴", "text": "さて、今回の\n恋ヶ崎みやびについて\nなんだけども。"},
        { "location": "437/TALK"  , "narrator": "千羽鶴", "text": "彼女は少し要注意人物の\nような気がしている。"},
        { "location": "438/TALK"  , "narrator": "千羽鶴", "text": "だから今回も、是非貴方に\n彼女を監視してもらいたい。"},
        { "location": "439/SEL"   , "narrator": "", "text": "「も」って…そんな任務は初めてですが"},
        { "location": "440/ACT"   , "narrator": "", "text": "「も」って…そんな任務は初めてですが"},
        { "location": "442/TALK"  , "narrator": "千羽鶴", "text": "今までそう言ってなかった\nだけ。やってたことは\n同じだから大丈夫。"},
        { "location": "443/TALK"  , "narrator": "千羽鶴", "text": "とにかく貴方には、この\n世界の平和の為に、彼女を\n監視し続けねばならない。"},
        { "location": "444/TALK"  , "narrator": "千羽鶴", "text": "例え火の中水の中、\nお風呂の中であっても。"},
        { "location": "445/TALK"  , "narrator": "千羽鶴", "text": "……。"},
        { "location": "446/SEL"   , "narrator": "", "text": "察し（期待）"},
        { "location": "447/ACT"   , "narrator": "", "text": "察し（期待）"},
        { "location": "450/TALK"  , "narrator": "千羽鶴", "text": "そう。今回は何と、\n恋ヶ崎みやびのお風呂回に\nしておいた。"},
        { "location": "453/TALK"  , "narrator": "千羽鶴", "text": "どーん！"},
        { "location": "454/TALK"  , "narrator": "千羽鶴", "text": "とはいえ、本業は彼女の\n心の内を把握し、今後の\n動向を見守ること。"},
        { "location": "455/TALK"  , "narrator": "千羽鶴", "text": "その事をゆめゆめ\n忘れないように。"},
        { "location": "456/TALK"  , "narrator": "千羽鶴", "text": "それさえ忘れなければ、\n目はどこに注目しても\n構わない。"},
        { "location": "457/TALK"  , "narrator": "千羽鶴", "text": "彼女の胸とか、胸とか、\nその揺れ方とか。"},
        { "location": "458/TALK"  , "narrator": "千羽鶴", "text": "アイボールは\n貴方の意志に忠実に、\n自由に動かして。"},
        { "location": "459/TALK"  , "narrator": "千羽鶴", "text": "それでは、\n健闘を祈ってる。"},
        { "location": "222/DIALOG", "narrator": "Tutorial/Dialog_Anime1", "text": "$dialog_word$"},
        { "location": "224/DIALOG", "narrator": "Tutorial/Dialog_Anime2", "text": "$dialog_word$"},
        { "location": "226/DIALOG", "narrator": "Tutorial/Dialog_Anime3", "text": "$dialog_word$"},
        { "location": "228/DIALOG", "narrator": "Tutorial/Dialog_Anime4", "text": "$dialog_word$"},
        { "location": "230/DIALOG", "narrator": "Tutorial/Dialog_Anime5", "text": "$dialog_word$"}
    ]
}
