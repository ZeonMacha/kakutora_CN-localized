{
    "dir": "chap39/daydra/dd_ch03_39_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "39305",
        "cid": "gabriella",
        "title": "005 メインストーリー",
        "sub_title": "羽ばたき征く蒼い空に＜後編＞"
    },
    "entry":
    [
        { "location": "742/TALK"  , "narrator": "ガブリエラ", "text": "ふう……。"},
        { "location": "744/TALK"  , "narrator": "ガブリエラ", "text": "結構写真も\n撮れたし……。"},
        { "location": "756/TALK"  , "narrator": "ガブリエラ", "text": "どう？"},
        { "location": "757/TALK"  , "narrator": "ガブリエラ", "text": "かわいいでしょ？"},
        { "location": "759/SEL"   , "narrator": "", "text": "かわいいね"},
        { "location": "760/SEL"   , "narrator": "", "text": "その写真見たことある！！！"},
        { "location": "761/SEL"   , "narrator": "", "text": "ガブリエラの方が可愛いよ"},
        { "location": "762/ACT"   , "narrator": "", "text": "かわいいね"},
        { "location": "763/TALK"  , "narrator": "ガブリエラ", "text": "ね"},
        { "location": "764/TALK"  , "narrator": "ガブリエラ", "text": "フクロウ素敵よねｖｖｖ"},
        { "location": "765/ACT"   , "narrator": "", "text": "その写真見たことある！！！"},
        { "location": "766/TALK"  , "narrator": "ガブリエラ", "text": "え？"},
        { "location": "768/TALK"  , "narrator": "ガブリエラ", "text": "気のせいじゃない？"},
        { "location": "770/SEL"   , "narrator": "", "text": "絶対あるよ！"},
        { "location": "771/SEL"   , "narrator": "", "text": "そうか時間がずれてるからか"},
        { "location": "772/SEL"   , "narrator": "", "text": "どういうこと？"},
        { "location": "773/ACT"   , "narrator": "", "text": "絶対あるよ！"},
        { "location": "774/TALK"  , "narrator": "ガブリエラ", "text": "でもさっき撮ったばかりだし"},
        { "location": "775/TALK"  , "narrator": "ガブリエラ", "text": "見せるのは$handle$が初めてよ？"},
        { "location": "778/ACT"   , "narrator": "", "text": "そうか時間がずれてるからか"},
        { "location": "779/TALK"  , "narrator": "ガブリエラ", "text": "時間？"},
        { "location": "781/TALK"  , "narrator": "ガブリエラ", "text": "今さっき撮った写真なのに？"},
        { "location": "783/ACT"   , "narrator": "", "text": "どういうこと？"},
        { "location": "784/TALK"  , "narrator": "ガブリエラ", "text": "こっちが聞きたいわ？"},
        { "location": "788/TALK"  , "narrator": "ガブリエラ", "text": "$handle$は似た写真をどこかで見ただけじゃないかしら？"},
        { "location": "790/SEL"   , "narrator": "", "text": "そうかもね…"},
        { "location": "791/SEL"   , "narrator": "", "text": "ガブリエラもそのうち気づくよ"},
        { "location": "792/SEL"   , "narrator": "", "text": "それって運命だよね"},
        { "location": "793/ACT"   , "narrator": "", "text": "そうかもね…"},
        { "location": "794/TALK"  , "narrator": "ガブリエラ", "text": "花鳥園は人気の施設だし"},
        { "location": "796/TALK"  , "narrator": "ガブリエラ", "text": "似た写真もいっぱいあると思うわ？"},
        { "location": "798/ACT"   , "narrator": "", "text": "ガブリエラもそのうち気づくよ"},
        { "location": "799/TALK"  , "narrator": "ガブリエラ", "text": "何それ？？？"},
        { "location": "800/TALK"  , "narrator": "ガブリエラ", "text": "不思議なこと言うのね"},
        { "location": "802/ACT"   , "narrator": "", "text": "それって運命だよね"},
        { "location": "803/TALK"  , "narrator": "ガブリエラ", "text": "運命////////////////////"},
        { "location": "804/TALK"  , "narrator": "ガブリエラ", "text": "$handle$はすぐそういうことばっかり言うんだから////////////"},
        { "location": "807/ACT"   , "narrator": "", "text": "ガブリエラの方が可愛いよ"},
        { "location": "808/TALK"  , "narrator": "ガブリエラ", "text": "もう////////////////////////"},
        { "location": "821/TALK"  , "narrator": "ガブリエラ", "text": "そろそろ合流した方が\nいいかしら…。"},
        { "location": "822/SEL"   , "narrator": "", "text": "落ち着いた？"},
        { "location": "823/ACT"   , "narrator": "", "text": "落ち着いた？"},
        { "location": "841/TALK"  , "narrator": "ガブリエラ", "text": "もしかして"},
        { "location": "843/TALK"  , "narrator": "ガブリエラ", "text": "気付いてたのかしら？"},
        { "location": "845/SEL"   , "narrator": "", "text": "なんとなくだけど"},
        { "location": "846/SEL"   , "narrator": "", "text": "すぐわかるよ"},
        { "location": "847/ACT"   , "narrator": "", "text": "なんとなくだけど"},
        { "location": "848/TALK"  , "narrator": "ガブリエラ", "text": "そうなのね・・・"},
        { "location": "849/ACT"   , "narrator": "", "text": "すぐわかるよ"},
        { "location": "850/TALK"  , "narrator": "ガブリエラ", "text": "$handle$には隠し事なんてできないわね"},
        { "location": "852/TALK"  , "narrator": "ガブリエラ", "text": "つばめのケンカを見たらお父様のことを思い出したの"},
        { "location": "853/TALK"  , "narrator": "ガブリエラ", "text": "もう何年も会ってないけど"},
        { "location": "855/SEL"   , "narrator": "", "text": "さみしい？"},
        { "location": "856/SEL"   , "narrator": "", "text": "清々するよね"},
        { "location": "857/SEL"   , "narrator": "", "text": "そっか"},
        { "location": "858/ACT"   , "narrator": "", "text": "さみしい？"},
        { "location": "860/TALK"  , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "862/TALK"  , "narrator": "ガブリエラ", "text": "少しだけ"},
        { "location": "863/ACT"   , "narrator": "", "text": "清々するよね"},
        { "location": "865/TALK"  , "narrator": "ガブリエラ", "text": "そこまで割り切れたらいいんだけど"},
        { "location": "866/ACT"   , "narrator": "", "text": "そっか"},
        { "location": "867/TALK"  , "narrator": "ガブリエラ", "text": "そうなのよ"},
        { "location": "869/TALK"  , "narrator": "ガブリエラ", "text": "でも仕方ないわよね"},
        { "location": "871/TALK"  , "narrator": "ガブリエラ", "text": "勘当されてるんだから"},
        { "location": "873/SEL"   , "narrator": "", "text": "マジで？"},
        { "location": "874/SEL"   , "narrator": "", "text": "知ってたよ"},
        { "location": "875/SEL"   , "narrator": "", "text": "厳しすぎるよね"},
        { "location": "876/ACT"   , "narrator": "", "text": "マジで？"},
        { "location": "877/TALK"  , "narrator": "ガブリエラ", "text": "本当よ"},
        { "location": "878/ACT"   , "narrator": "", "text": "知ってたよ"},
        { "location": "879/TALK"  , "narrator": "ガブリエラ", "text": "そうよね"},
        { "location": "880/ACT"   , "narrator": "", "text": "厳しすぎるよね"},
        { "location": "881/TALK"  , "narrator": "ガブリエラ", "text": "そうかもしれないわね"},
        { "location": "884/TALK"  , "narrator": "ガブリエラ", "text": "お父様はポーランド軍の高官で"},
        { "location": "885/TALK"  , "narrator": "ガブリエラ", "text": "とても厳しい人だったわ"},
        { "location": "886/TALK"  , "narrator": "ガブリエラ", "text": "でも私に射撃の才能があるってわかった時"},
        { "location": "887/TALK"  , "narrator": "ガブリエラ", "text": "すごく誉めてくれたの"},
        { "location": "888/TALK"  , "narrator": "ガブリエラ", "text": "だから私、お父様を越えるのを目標にしてた"},
        { "location": "889/TALK"  , "narrator": "ガブリエラ", "text": "お父様もそれを楽しみだって言ってくれてた"},
        { "location": "890/TALK"  , "narrator": "ガブリエラ", "text": "でもあの事件以来"},
        { "location": "893/TALK"  , "narrator": "ガブリエラ", "text": "お父様は銃を持つ私から目を逸らすようになったわ"},
        { "location": "894/TALK"  , "narrator": "ガブリエラ", "text": "射撃を教えたことを後悔しているって言われたこともある"},
        { "location": "895/TALK"  , "narrator": "ガブリエラ", "text": "私がお母様を殺したから"},
        { "location": "897/SEL"   , "narrator": "", "text": "あれは事故だよ"},
        { "location": "898/SEL"   , "narrator": "", "text": "ガブリエラのせいじゃない"},
        { "location": "899/SEL"   , "narrator": "", "text": "辛かったよね"},
        { "location": "900/ACT"   , "narrator": "", "text": "あれは事故だよ"},
        { "location": "901/TALK"  , "narrator": "ガブリエラ", "text": "そうかもしれないけど"},
        { "location": "902/ACT"   , "narrator": "", "text": "ガブリエラのせいじゃない"},
        { "location": "903/TALK"  , "narrator": "ガブリエラ", "text": "$handle$は優しいのね"},
        { "location": "904/TALK"  , "narrator": "ガブリエラ", "text": "いつも"},
        { "location": "905/ACT"   , "narrator": "", "text": "辛かったよね"},
        { "location": "906/TALK"  , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "907/TALK"  , "narrator": "ガブリエラ", "text": "でも"},
        { "location": "908/TALK"  , "narrator": "ガブリエラ", "text": "お父様も辛かったはずよ"},
        { "location": "910/TALK"  , "narrator": "ガブリエラ", "text": "お父様がいい顔をしないのは知っていたけれど"},
        { "location": "911/TALK"  , "narrator": "ガブリエラ", "text": "私は銃を握り続けたわ"},
        { "location": "912/TALK"  , "narrator": "ガブリエラ", "text": "色んな大会に出た"},
        { "location": "913/TALK"  , "narrator": "ガブリエラ", "text": "私以外大人しかいない大会で優勝したことも何度もある"},
        { "location": "914/TALK"  , "narrator": "ガブリエラ", "text": "でもお父様は絶対に私を誉めてくれなかったの"},
        { "location": "917/TALK"  , "narrator": "ガブリエラ", "text": "軍から入隊の話もあったの"},
        { "location": "918/TALK"  , "narrator": "ガブリエラ", "text": "でもそれはお父様が断ってから知った話"},
        { "location": "919/TALK"  , "narrator": "ガブリエラ", "text": "だから私、大喧嘩したわ"},
        { "location": "920/TALK"  , "narrator": "ガブリエラ", "text": "ありえないくらいの大喧嘩よ"},
        { "location": "921/TALK"  , "narrator": "ガブリエラ", "text": "その直後に日本への条件付き入学の話があって、仲直りしないままポーランドを出たの"},
        { "location": "924/SEL"   , "narrator": "", "text": "そうだったんだ"},
        { "location": "925/SEL"   , "narrator": "", "text": "今も同じ気持ち？"},
        { "location": "926/ACT"   , "narrator": "", "text": "そうだったんだ"},
        { "location": "927/TALK"  , "narrator": "ガブリエラ", "text": "バカよね"},
        { "location": "928/ACT"   , "narrator": "", "text": "今も同じ気持ち？"},
        { "location": "929/TALK"  , "narrator": "ガブリエラ", "text": "今は・・・"},
        { "location": "931/TALK"  , "narrator": "ガブリエラ", "text": "今ならわかるわ"},
        { "location": "932/TALK"  , "narrator": "ガブリエラ", "text": "お父様は私に危ない目に遭って欲しくなかったんだって"},
        { "location": "935/TALK"  , "narrator": "ガブリエラ", "text": "ねえ$handle$"},
        { "location": "936/TALK"  , "narrator": "ガブリエラ", "text": "私子供じゃないわ"},
        { "location": "937/TALK"  , "narrator": "ガブリエラ", "text": "もうすぐ結婚だってできる年よ"},
        { "location": "939/SEL"   , "narrator": "", "text": "お、おう"},
        { "location": "940/SEL"   , "narrator": "", "text": "そういうところが子供だな"},
        { "location": "941/SEL"   , "narrator": "", "text": "最初よりうんと大人になったよ"},
        { "location": "942/ACT"   , "narrator": "", "text": "お、おう"},
        { "location": "943/TALK"  , "narrator": "ガブリエラ", "text": "雑なお返事ね"},
        { "location": "944/ACT"   , "narrator": "", "text": "そういうところが子供だな"},
        { "location": "945/TALK"  , "narrator": "ガブリエラ", "text": "子供なんかじゃないわよ！"},
        { "location": "946/ACT"   , "narrator": "", "text": "最初よりうんと大人になったよ"},
        { "location": "947/TALK"  , "narrator": "ガブリエラ", "text": "え///////////////////"},
        { "location": "948/TALK"  , "narrator": "ガブリエラ", "text": "そう？"},
        { "location": "949/TALK"  , "narrator": "ガブリエラ", "text": "ありがとうｖｖｖｖ"},
        { "location": "951/TALK"  , "narrator": "ガブリエラ", "text": "それでね・・・"},
        { "location": "952/TALK"  , "narrator": "ガブリエラ", "text": "私いつか$handle$に見て欲しいの"},
        { "location": "953/TALK"  , "narrator": "ガブリエラ", "text": "お父様を"},
        { "location": "954/TALK"  , "narrator": "ガブリエラ", "text": "どうしようもなく頑固で融通が利かないけど"},
        { "location": "956/TALK"  , "narrator": "ガブリエラ", "text": "私の自慢の父を"},
        { "location": "959/SEL"   , "narrator": "", "text": "どうにかしよう"},
        { "location": "960/SEL"   , "narrator": "", "text": "向こうも同じこと思ってそう"},
        { "location": "961/ACT"   , "narrator": "", "text": "どうにかしよう"},
        { "location": "962/TALK"  , "narrator": "ガブリエラ", "text": "本当に？"},
        { "location": "963/TALK"  , "narrator": "ガブリエラ", "text": "どうにかなるかしら？"},
        { "location": "964/ACT"   , "narrator": "", "text": "向こうも同じこと思ってそう"},
        { "location": "965/TALK"  , "narrator": "ガブリエラ", "text": "それは"},
        { "location": "966/TALK"  , "narrator": "ガブリエラ", "text": "否定できないわ"},
        { "location": "967/TALK"  , "narrator": "ガブリエラ", "text": "仕方ないわよ親子だもの"},
        { "location": "970/SEL"   , "narrator": "", "text": "どうにかしよう"},
        { "location": "971/SEL"   , "narrator": "", "text": "結婚の挨拶に行かないとだしね"},
        { "location": "972/SEL"   , "narrator": "", "text": "向こうも同じこと思ってそう"},
        { "location": "973/ACT"   , "narrator": "", "text": "どうにかしよう"},
        { "location": "974/TALK"  , "narrator": "ガブリエラ", "text": "本当に？"},
        { "location": "975/TALK"  , "narrator": "ガブリエラ", "text": "どうにかなるかしら？"},
        { "location": "976/ACT"   , "narrator": "", "text": "結婚の挨拶に行かないとだしね"},
        { "location": "978/TALK"  , "narrator": "ガブリエラ", "text": "結婚の挨拶//////////////////////////"},
        { "location": "980/SEL"   , "narrator": "", "text": "お嬢さんを$me$にください"},
        { "location": "981/SEL"   , "narrator": "", "text": "必ずガブリエラを幸せにします"},
        { "location": "982/SEL"   , "narrator": "", "text": "二人の未来を見ていてください"},
        { "location": "983/ACT"   , "narrator": "", "text": "お嬢さんを$me$にください"},
        { "location": "985/TALK"  , "narrator": "ガブリエラ", "text": "すごく日本の挨拶っぽいわｖｖｖｖ"},
        { "location": "986/TALK"  , "narrator": "ガブリエラ", "text": "ステキｖｖｖｖ"},
        { "location": "987/ACT"   , "narrator": "", "text": "必ずガブリエラを幸せにします"},
        { "location": "989/TALK"  , "narrator": "ガブリエラ", "text": "絶対絶対絶対だからね！！！"},
        { "location": "990/TALK"  , "narrator": "ガブリエラ", "text": "私も$handle$を幸せにするから////////////////"},
        { "location": "991/ACT"   , "narrator": "", "text": "二人の未来を見ていてください"},
        { "location": "993/TALK"  , "narrator": "ガブリエラ", "text": "二人の未来ｖｖｖｖｖｖｖ"},
        { "location": "994/TALK"  , "narrator": "ガブリエラ", "text": "いい言葉ね///////////////"},
        { "location": "996/ACT"   , "narrator": "", "text": "向こうも同じこと思ってそう"},
        { "location": "997/TALK"  , "narrator": "ガブリエラ", "text": "それは"},
        { "location": "998/TALK"  , "narrator": "ガブリエラ", "text": "否定できないわ"},
        { "location": "999/TALK"  , "narrator": "ガブリエラ", "text": "仕方ないわよ親子だもの"},
        { "location": "1042/TALK" , "narrator": "アーヤ", "text": "ギャヴィ！"},
        { "location": "1049/TALK" , "narrator": "ガブリエラ", "text": "ごめん。\nもしかしてあたしを\n探してた？"},
        { "location": "1051/TALK" , "narrator": "つばめ", "text": "こっちこそごめんね。\n変なとこ\n見せちゃって。"},
        { "location": "1052/TALK" , "narrator": "啓介", "text": "すまんな。\n恥ずかしいところを\n見せてしまった。"},
        { "location": "1053/TALK" , "narrator": "ガブリエラ", "text": "えっいえ、そんな。"},
        { "location": "1056/TALK" , "narrator": "つばめ", "text": "もー。お父さんが\nいつまでも子供扱い\nするから……。"},
        { "location": "1057/TALK" , "narrator": "ガブリエラ", "text": "子供よ、子供。\nそういうところ\n全然子供。"},
        { "location": "1059/TALK" , "narrator": "つばめ", "text": "あっ！"},
        { "location": "1060/TALK" , "narrator": "つばめ", "text": "……そうかも……。"},
        { "location": "1061/TALK" , "narrator": "啓介", "text": "それより、どうだ。\nそこに最近できた\n喫茶店があるんだが――"},
        { "location": "1062/TALK" , "narrator": "つばめ", "text": "抹茶ケーキが\nおすすめみたいだよ。"},
        { "location": "1064/TALK" , "narrator": "ガブリエラ", "text": "抹茶！"},
        { "location": "1065/TALK" , "narrator": "ガブリエラ", "text": "大好きです。\nご馳走になります。"},
        { "location": "1102/TALK" , "narrator": "ガブリエラ", "text": "おいしい！"},
        { "location": "1104/TALK" , "narrator": "つばめ", "text": "本当だね。\nわたしも抹茶にして\nよかったよ。"},
        { "location": "1106/TALK" , "narrator": "アーヤ", "text": "普通のお茶も\n美味しいわ。"},
        { "location": "1107/TALK" , "narrator": "啓介", "text": "…そうか。\nよかった。"},
        { "location": "1112/TALK" , "narrator": "ガブリエラ", "text": "つばめはお父さんと本当に仲がいいのね"},
        { "location": "1114/SEL"  , "narrator": "", "text": "そう？"},
        { "location": "1115/SEL"  , "narrator": "", "text": "そうだね"},
        { "location": "1116/SEL"  , "narrator": "", "text": "うらやましい？"},
        { "location": "1117/ACT"  , "narrator": "", "text": "そう？"},
        { "location": "1118/TALK" , "narrator": "ガブリエラ", "text": "そうよ"},
        { "location": "1119/ACT"  , "narrator": "", "text": "そうだね"},
        { "location": "1120/TALK" , "narrator": "ガブリエラ", "text": "そうでしょう？"},
        { "location": "1121/ACT"  , "narrator": "", "text": "うらやましい？"},
        { "location": "1122/TALK" , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "1123/TALK" , "narrator": "ガブリエラ", "text": "そういうことなのよね"},
        { "location": "1125/TALK" , "narrator": "ガブリエラ", "text": "それでね"},
        { "location": "1126/TALK" , "narrator": "ガブリエラ", "text": "私もがんばってお父様と仲直りしようって思うの"},
        { "location": "1129/SEL"  , "narrator": "", "text": "いいことだ"},
        { "location": "1130/SEL"  , "narrator": "", "text": "手伝うよ"},
        { "location": "1131/ACT"  , "narrator": "", "text": "いいことだ"},
        { "location": "1132/TALK" , "narrator": "ガブリエラ", "text": "うん"},
        { "location": "1133/TALK" , "narrator": "ガブリエラ", "text": "いいことよね"},
        { "location": "1134/ACT"  , "narrator": "", "text": "手伝うよ"},
        { "location": "1135/TALK" , "narrator": "ガブリエラ", "text": "ありがとう"},
        { "location": "1136/TALK" , "narrator": "ガブリエラ", "text": "そう言ってくれるって信じてた"},
        { "location": "1139/SEL"  , "narrator": "", "text": "いいことだ"},
        { "location": "1140/SEL"  , "narrator": "", "text": "手伝うよ"},
        { "location": "1141/SEL"  , "narrator": "", "text": "$me$も挨拶しなきゃだしね"},
        { "location": "1142/ACT"  , "narrator": "", "text": "いいことだ"},
        { "location": "1143/TALK" , "narrator": "ガブリエラ", "text": "うん"},
        { "location": "1144/TALK" , "narrator": "ガブリエラ", "text": "いいことよね"},
        { "location": "1145/ACT"  , "narrator": "", "text": "手伝うよ"},
        { "location": "1146/TALK" , "narrator": "ガブリエラ", "text": "ありがとう"},
        { "location": "1147/TALK" , "narrator": "ガブリエラ", "text": "そう言ってくれるって信じてた"},
        { "location": "1148/ACT"  , "narrator": "", "text": "$me$も挨拶しなきゃだしね"},
        { "location": "1149/TALK" , "narrator": "ガブリエラ", "text": "挨拶//////////////////"},
        { "location": "1150/TALK" , "narrator": "ガブリエラ", "text": "そうよねｖｖｖ"},
        { "location": "1151/TALK" , "narrator": "ガブリエラ", "text": "絶対よ？"},
        { "location": "1154/TALK" , "narrator": "ガブリエラ", "text": "色々相談に乗ってねｖｖｖ"},
        { "location": "1155/TALK" , "narrator": "ガブリエラ", "text": "期待してるからｖｖｖ"},
        { "location": "1163/TALK" , "narrator": "つばめ", "text": "イチゴのも気に\nなるんだよね…。\n追加しちゃおうかな？"},
        { "location": "1165/TALK" , "narrator": "啓介", "text": "足りないのか？"},
        { "location": "1167/TALK" , "narrator": "つばめ", "text": "そういうわけじゃ\nないんだけど…。"},
        { "location": "1169/TALK" , "narrator": "ガブリエラ", "text": "じゃあ一つ頼んで\nシェアするのはどう？\nアーヤはどうする？"},
        { "location": "1171/TALK" , "narrator": "アーヤ", "text": "私はいいわ。\nごちそうさま。"},
        { "location": "1173/TALK" , "narrator": "つばめ", "text": "ガブちゃんも頼むなら\nこのチョコのも…。"},
        { "location": "1175/TALK" , "narrator": "ガブリエラ", "text": "さすがに食べ過ぎ\nじゃない？"},
        { "location": "1177/TALK" , "narrator": "つばめ", "text": "そっかな？"},
        { "location": "1179/TALK" , "narrator": "啓介", "text": "やめとけ。\n晩飯食えなくなるぞ。"},
        { "location": "1181/TALK" , "narrator": "つばめ", "text": "お父さんはまた\nそうやって！"},
        { "location": "1183/TALK" , "narrator": "ガブリエラ", "text": "ふふふ。"},
        { "location": "1185/TALK" , "narrator": "ガブリエラ", "text": "いつかお父様が日本に\n来ることがあったら。"},
        { "location": "1186/TALK" , "narrator": "ガブリエラ", "text": "色んな所を案内するの。\nあたしの大好きな日本を。"},
        { "location": "1187/TALK" , "narrator": "ガブリエラ", "text": "大好きなお父様に\n案内するの。"},
        { "location": "1188/TALK" , "narrator": "ガブリエラ", "text": "その為に何すればいいかは\n$handle$に\n色々聞いてみよっと。"},
        { "location": "1189/TALK" , "narrator": "ガブリエラ", "text": "大丈夫よ。\nきっと仲直りできる。"},
        { "location": "1190/TALK" , "narrator": "ガブリエラ", "text": "だって$handle$が\nいるんだから――。"},
