        { "location": "171/SCENARIO", "narrator": "", "text": "027_ファンブル、かつクリティカル"},
        { "location": "196/TALK"    , "narrator": "みやび", "text": "致命的な失敗"},
        { "location": "197/TALK"    , "narrator": "みやび", "text": "かつ"},
        { "location": "198/TALK"    , "narrator": "みやび", "text": "最上級の成功"},
        { "location": "200/SEL"     , "narrator": "", "text": "両立できないよね"},
        { "location": "201/SEL"     , "narrator": "", "text": "ダブルバインドだ"},
        { "location": "202/SEL"     , "narrator": "", "text": "そういうこともあるよね"},
        { "location": "203/TALK"    , "narrator": "みやび", "text": "両方を一度に満たす条件は存在するかね"},
        { "location": "205/ACT"     , "narrator": "", "text": "両立できないよね"},
        { "location": "206/TALK"    , "narrator": "みやび", "text": "そうかな"},
        { "location": "207/ACT"     , "narrator": "", "text": "ダブルバインドだ"},
        { "location": "208/TALK"    , "narrator": "みやび", "text": "そうだな"},
        { "location": "209/TALK"    , "narrator": "みやび", "text": "そうとも言う"},
        { "location": "210/ACT"     , "narrator": "", "text": "そういうこともあるよね"},
        { "location": "212/TALK"    , "narrator": "みやび", "text": "なるほど"},
        { "location": "214/TALK"    , "narrator": "みやび", "text": "素晴らしい"},
        { "location": "215/TALK"    , "narrator": "みやび", "text": "では"},
        { "location": "216/TALK"    , "narrator": "みやび", "text": "詳細を聞こうか"},
        { "location": "218/TALK"    , "narrator": "みやび", "text": "つまりだ"},
        { "location": "219/TALK"    , "narrator": "みやび", "text": "この世は常に矛盾をはらんでいるということぞね"},
        { "location": "220/TALK"    , "narrator": "みやび", "text": "わかるかの？"},
        { "location": "222/SEL"     , "narrator": "", "text": "なるほど"},
        { "location": "223/SEL"     , "narrator": "", "text": "真実は常に一つ"},
        { "location": "224/SEL"     , "narrator": "", "text": "$me$とみやびの関係みたいにね"},
        { "location": "225/ACT"     , "narrator": "", "text": "なるほど"},
        { "location": "226/TALK"    , "narrator": "みやび", "text": "ぬ"},
        { "location": "227/TALK"    , "narrator": "みやび", "text": "ちゃんと自分の頭で考えておらぬだろ"},
        { "location": "229/TALK"    , "narrator": "みやび", "text": "思考を惜しむと馬鹿になるぞね"},
        { "location": "230/TALK"    , "narrator": "みやび", "text": "気ぃつけゆう"},
        { "location": "231/ACT"     , "narrator": "", "text": "真実は常に一つ"},
        { "location": "232/TALK"    , "narrator": "みやび", "text": "ほほう"},
        { "location": "233/TALK"    , "narrator": "みやび", "text": "どこぞの少年探偵かね"},
        { "location": "234/TALK"    , "narrator": "みやび", "text": "真実はいろんな角度から覗くべし"},
        { "location": "235/ACT"     , "narrator": "", "text": "$me$とみやびの関係みたいにね"},
        { "location": "237/TALK"    , "narrator": "みやび", "text": "恋愛学的事象と定義するか"},
        { "location": "238/TALK"    , "narrator": "みやび", "text": "相棒は口が上手いの"},
        { "location": "239/TALK"    , "narrator": "みやび", "text": "まあ"},
        { "location": "240/TALK"    , "narrator": "みやび", "text": "それも"},
        { "location": "241/TALK"    , "narrator": "みやび", "text": "ひとつの真実"},
        { "location": "243/TALK"    , "narrator": "みやび", "text": "ち"},
        { "location": "244/TALK"    , "narrator": "みやび", "text": "言うといちゃろう"},
        { "location": "245/TALK"    , "narrator": "みやび", "text": "一応な"}
    ]
}
