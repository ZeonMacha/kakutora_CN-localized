    "entry":
    [
        { "location": "623/SCENARIO", "narrator": "", "text": "純情ロップイヤー"},
        { "location": "648/TALK"    , "narrator": "神楽", "text": "垂れ耳ウサギは草を食む"},
        { "location": "649/TALK"    , "narrator": "神楽", "text": "日がな一日草を食む"},
        { "location": "651/SEL"     , "narrator": "", "text": "神楽のこと？"},
        { "location": "652/SEL"     , "narrator": "", "text": "ウサギ肉って美味しいらしいね"},
        { "location": "653/SEL"     , "narrator": "", "text": "ほのぼの系？"},
        { "location": "654/ACT"     , "narrator": "", "text": "神楽のこと？"},
        { "location": "656/TALK"    , "narrator": "神楽", "text": "暗喩かつ隠喩"},
        { "location": "657/TALK"    , "narrator": "神楽", "text": "なんてわけじゃないけど"},
        { "location": "659/TALK"    , "narrator": "神楽", "text": "退屈な一日を望む日だってありますからねぴょんこにだって"},
        { "location": "660/ACT"     , "narrator": "", "text": "ウサギ肉って美味しいらしいね"},
        { "location": "661/TALK"    , "narrator": "神楽", "text": "食うなよ！！！！"},
        { "location": "663/TALK"    , "narrator": "神楽", "text": "でも旨いのはガチ"},
        { "location": "664/ACT"     , "narrator": "", "text": "ほのぼの系？"},
        { "location": "665/TALK"    , "narrator": "神楽", "text": "そういうことにしておいて"},
        { "location": "667/TALK"    , "narrator": "神楽", "text": "本物の動物って何考えてるかわかんない"},
        { "location": "668/TALK"    , "narrator": "神楽", "text": "意思疎通ってできなくない？"},
        { "location": "669/TALK"    , "narrator": "神楽", "text": "なんなんだろうなあれ"},
        { "location": "670/TALK"    , "narrator": "神楽", "text": "$handlek$とだったらそれなりに話ができるのにそれ以下"},
        { "location": "671/TALK"    , "narrator": "神楽", "text": "でも創作のモチーフとしては全然アリ"},
        { "location": "672/TALK"    , "narrator": "神楽", "text": "生き物を飼うのは空想の中だけでいいな"}
    ]
}
