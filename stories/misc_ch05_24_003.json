        { "location": "8106/SCENARIO", "narrator": "", "text": "フランネル"},
        { "location": "8131/TALK"    , "narrator": "神楽", "text": "ぴょんこはフランネルの手触りが好き"},
        { "location": "8132/TALK"    , "narrator": "神楽", "text": "でもネルシャツは気を付けないといけないぴょん"},
        { "location": "8134/SEL"     , "narrator": "", "text": "汚したりしないように？"},
        { "location": "8135/SEL"     , "narrator": "", "text": "何で？？？？"},
        { "location": "8136/SEL"     , "narrator": "", "text": "オタバレするよね！"},
        { "location": "8137/ACT"     , "narrator": "", "text": "汚したりしないように？"},
        { "location": "8138/TALK"    , "narrator": "神楽", "text": "確かに大事かも"},
        { "location": "8139/TALK"    , "narrator": "神楽", "text": "でもそれじゃないから"},
        { "location": "8140/ACT"     , "narrator": "", "text": "何で？？？？"},
        { "location": "8141/TALK"    , "narrator": "神楽", "text": "幸せなのか鈍いのか"},
        { "location": "8143/TALK"    , "narrator": "神楽", "text": "それならそれで大丈夫だから"},
        { "location": "8144/ACT"     , "narrator": "", "text": "オタバレするよね！"},
        { "location": "8146/TALK"    , "narrator": "神楽", "text": "ね！"},
        { "location": "8147/TALK"    , "narrator": "神楽", "text": "なんて言ってはみたものの、ぴょんこは頭にバンダナの人とか指ぬきグローブの人とか見たことないぴょん、、、"},
        { "location": "8149/SEL"     , "narrator": "", "text": "$me$の私服だけど…"},
        { "location": "8150/SEL"     , "narrator": "", "text": "昔はリアルにいたんだよ"},
        { "location": "8151/SEL"     , "narrator": "", "text": "確かに見ないね"},
        { "location": "8152/ACT"     , "narrator": "", "text": "$me$の私服だけど…"},
        { "location": "8154/TALK"    , "narrator": "神楽", "text": "見たい見たい見たい！"},
        { "location": "8155/ACT"     , "narrator": "", "text": "昔はリアルにいたんだよ"},
        { "location": "8156/TALK"    , "narrator": "神楽", "text": "そうみたいだけど、、、"},
        { "location": "8157/TALK"    , "narrator": "神楽", "text": "今もいる風に言われてたりするぴょん？？？"},
        { "location": "8158/TALK"    , "narrator": "神楽", "text": "時代錯誤だよね！"},
        { "location": "8159/ACT"     , "narrator": "", "text": "確かに見ないね"},
        { "location": "8160/TALK"    , "narrator": "神楽", "text": "昔はいたらしいぴょん"},
        { "location": "8162/TALK"    , "narrator": "神楽", "text": "でも今のアキバでそんな人見ないぴょん"},
        { "location": "8163/TALK"    , "narrator": "神楽", "text": "それともぴょんこがディープなエリアを知らないだけ？？？"},
        { "location": "8165/TALK"    , "narrator": "神楽", "text": "アキバスタイルは奥が深いぴょん♪"},
        { "location": "8166/TALK"    , "narrator": "神楽", "text": "そういえば女子はどんなスタイルなんだろうね？"},
        { "location": "8167/TALK"    , "narrator": "神楽", "text": "謎が深まったー！！！"}
    ]
