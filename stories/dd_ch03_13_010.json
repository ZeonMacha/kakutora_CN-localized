{
    "dir": "chap13/daydra/dd_ch03_13_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "13352",
        "cid": "gabriella",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "図書館で勉強"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "図書館で勉強"},
        { "location": "29/TALK"   , "narrator": "雛", "text": "そっかぁ…。\nそれはショックだねー。"},
        { "location": "31/TALK"   , "narrator": "ガブリエラ", "text": "はぁ…本当にショックよ。"},
        { "location": "32/TALK"   , "narrator": "ガブリエラ", "text": "テストで７０点台なんて、\n生まれて初めてだわ。"},
        { "location": "34/TALK"   , "narrator": "繭", "text": "平均点より上だけど、\n良くも悪くもない\n微妙な点ね。"},
        { "location": "36/TALK"   , "narrator": "ガブリエラ", "text": "微妙言うな！\n普段は９０点より下は\n絶対取らないんだから！"},
        { "location": "38/TALK"   , "narrator": "つばめ", "text": "具合でも悪かったの？"},
        { "location": "39/TALK"   , "narrator": "ガブリエラ", "text": "…そうじゃないわ。"},
        { "location": "40/TALK"   , "narrator": "ガブリエラ", "text": "ただ…とっくに勉強した\nところだから、甘く見て\n勉強しなかったのよ。"},
        { "location": "41/TALK"   , "narrator": "雛", "text": "テスト前に勉強しな\nかったの！？\n勇気あるなぁ…。"},
        { "location": "42/TALK"   , "narrator": "繭", "text": "復習くらいはしておく\nべきだったと思う。"},
        { "location": "46/TALK"   , "narrator": "ガブリエラ", "text": "ぐっ…そ、そうね…。"},
        { "location": "47/TALK"   , "narrator": "ガブリエラ", "text": "甘く見過ぎてたのは\n事実なんだし…。"},
        { "location": "49/TALK"   , "narrator": "つばめ", "text": "ガブちゃん…。"},
        { "location": "50/TALK"   , "narrator": "つばめ", "text": "そうだ！\nそれならわたしが\n勉強を教えるよ。"},
        { "location": "53/TALK"   , "narrator": "ガブリエラ", "text": "えっ！？\nいや、別にいいって。"},
        { "location": "55/TALK"   , "narrator": "つばめ", "text": "遠慮しなくていいのに。"},
        { "location": "57/TALK"   , "narrator": "ガブリエラ", "text": "そうじゃなくてさ…\nつばめじゃ頼りない、って\nいうか…。"},
        { "location": "62/TALK"   , "narrator": "つばめ", "text": "ガーンッ！"},
        { "location": "64/TALK"   , "narrator": "ガブリエラ", "text": "そ、そんなショック\n受けないでよ！\n冗談だってば…。"},
        { "location": "65/TALK"   , "narrator": "ガブリエラ", "text": "それに、軽く復習する程度\nだから、教わるようなこと\nでもないし…。"},
        { "location": "66/TALK"   , "narrator": "ガブリエラ", "text": "っていうか、つばめの\n成績はどうなの？"},
        { "location": "69/TALK"   , "narrator": "つばめ", "text": "え、えっと…\nどうにか平均点は\nキープしてる感じ、かな？"},
        { "location": "70/TALK"   , "narrator": "ガブリエラ", "text": "…前言撤回。\nやっぱ頼りないわ。"},
        { "location": "72/TALK"   , "narrator": "つばめ", "text": "二回も言われた！？"},
        { "location": "73/TALK"   , "narrator": "雛", "text": "あはは…でも、あたしも\n正直、数学で心配な\nところがあるんだよねー。"},
        { "location": "75/TALK"   , "narrator": "雛", "text": "だからさ、提案！"},
        { "location": "76/TALK"   , "narrator": "雛", "text": "今日の放課後、みんなで\n勉強会しない？"},
        { "location": "78/TALK"   , "narrator": "つばめ", "text": "わぁ、それ賛成！\nみんなとならお勉強も\n捗りそうだよ。"},
        { "location": "79/TALK"   , "narrator": "繭", "text": "勉強会って、集まる名目で\n実際に勉強するための\nものじゃないと思ってた。"},
        { "location": "81/TALK"   , "narrator": "雛", "text": "そんなことないよー。"},
        { "location": "83/TALK"   , "narrator": "雛", "text": "だからさ、今日の放課後は\nみんな時間作っといてね！"},
        { "location": "84/TALK"   , "narrator": "つばめ", "text": "うん。\nガブちゃんも来れるよね？"},
        { "location": "86/TALK"   , "narrator": "ガブリエラ", "text": "そ、そうね…。\nまあ、マジメにやるって\n約束するなら――"},
        { "location": "87/TALK"   , "narrator": "ガブリエラ", "text": "行ってもいいかも。"},
        { "location": "88/TALK"   , "narrator": "つばめ", "text": "じゃあ、決まりだね！"},
        { "location": "90/TALK"   , "narrator": "ガブリエラ", "text": "…ふふっ、勉強会かぁ。"},
        { "location": "91/TALK"   , "narrator": "ガブリエラ", "text": "一度もしたことないから、\nずっと憧れてたのよね。"},
        { "location": "93/TALK"   , "narrator": "つばめ", "text": "あ、でも場所は\nどこにする？"},
        { "location": "94/TALK"   , "narrator": "つばめ", "text": "教室は、遅くまで残って\n遊んでる人達がいると\n思うし…。"},
        { "location": "95/SEL"    , "narrator": "", "text": "誰かの家でやろう"},
        { "location": "96/SEL"    , "narrator": "", "text": "カフェじゃない？"},
        { "location": "97/SEL"    , "narrator": "", "text": "図書室こそ王道！"},
        { "location": "101/TALK"  , "narrator": "雛", "text": "う～ん…どこにしよっか？"},
        { "location": "102/TALK"  , "narrator": "雛", "text": "あたしの家は、\n狭いから無理だし…。"},
        { "location": "104/TALK"  , "narrator": "雛", "text": "そうだ、まゆちんの家は？"},
        { "location": "105/TALK"  , "narrator": "繭", "text": "うるさい兄弟達が\n乱入して大騒ぎになること\n確実だけど？"},
        { "location": "109/TALK"  , "narrator": "つばめ", "text": "それじゃあ、わたしの\n部屋はどうかな？"},
        { "location": "110/TALK"  , "narrator": "つばめ", "text": "静かだし、十分広いから、\nお勉強するのには\n困らないと思うの。"},
        { "location": "111/TALK"  , "narrator": "雛", "text": "えっ、いいの？"},
        { "location": "113/TALK"  , "narrator": "つばめ", "text": "もちろん。\nひなこちゃんとまゆちんが\n良ければだけど。"},
        { "location": "114/TALK"  , "narrator": "雛", "text": "ないない、問題なしだよ。\nあたしもまゆちんもね。"},
        { "location": "115/TALK"  , "narrator": "繭", "text": "まだ何も言ってないけど？"},
        { "location": "116/TALK"  , "narrator": "雛", "text": "言わなくたってわかるよ。\nあたし達の仲じゃん。"},
        { "location": "118/TALK"  , "narrator": "繭", "text": "…うざっ。\nでも、私もそれでいいわ。"},
        { "location": "119/TALK"  , "narrator": "雛", "text": "じゃあ、お菓子買って\nつばめちゃんの部屋に\n集合だね。"},
        { "location": "121/TALK"  , "narrator": "つばめ", "text": "ガブちゃんも、\nわたしの部屋でいい？"},
        { "location": "123/TALK"  , "narrator": "ガブリエラ", "text": "え、ええ…\nそれで構わないわ。"},
        { "location": "125/TALK"  , "narrator": "ガブリエラ", "text": "うわぁ、お菓子持ち寄る\n勉強会って、アニメとかで\n見たことあるわ。"},
        { "location": "127/TALK"  , "narrator": "ガブリエラ", "text": "何だか凄く楽しく\n勉強できそう！"},
        { "location": "128/TALK"  , "narrator": "ガブリエラ", "text": "早く放課後に\nならないかなぁ？"},
        { "location": "149/TALK"  , "narrator": "雛", "text": "…うわっ！？\nもう八時過ぎてる！"},
        { "location": "151/TALK"  , "narrator": "ガブリエラ", "text": "えっ、もうそんな時間？"},
        { "location": "153/TALK"  , "narrator": "つばめ", "text": "まだ問題集、一ページも\nやれてないのに…。"},
        { "location": "154/TALK"  , "narrator": "繭", "text": "…わかりきった結果\n過ぎて、呆れるわ。"},
        { "location": "156/TALK"  , "narrator": "雛", "text": "もぉ、またそういうこと\n言ってー！"},
        { "location": "157/TALK"  , "narrator": "雛", "text": "まゆちんだって、\n全然問題集進めて\nないじゃん！"},
        { "location": "158/TALK"  , "narrator": "つばめ", "text": "…勉強会で集まったはず\nなのに、つい遊んじゃった\nもんね。"},
        { "location": "160/TALK"  , "narrator": "ガブリエラ", "text": "はぁ…全然復習できな\nかったわ。"},
        { "location": "162/TALK"  , "narrator": "つばめ", "text": "ごめんね、ガブちゃん。\n勉強教えられなくて…。"},
        { "location": "165/TALK"  , "narrator": "ガブリエラ", "text": "…別に、謝らなくても\nいいわよ。"},
        { "location": "166/TALK"  , "narrator": "ガブリエラ", "text": "あたしも、お喋りしたり\n遊んだりしちゃったし――"},
        { "location": "168/TALK"  , "narrator": "ガブリエラ", "text": "それに…勉強会って、\n一度してみたかったから、\n嬉しかったし…。"},
        { "location": "170/TALK"  , "narrator": "つばめ", "text": "…そうだったんだ？"},
        { "location": "171/TALK"  , "narrator": "雛", "text": "お勉強会は失敗しちゃった\nけど、ガブリエラちゃんが\n喜んでくれたし――"},
        { "location": "172/TALK"  , "narrator": "雛", "text": "今回は、それでＯＫ、って\nことでいいんじゃない？"},
        { "location": "174/TALK"  , "narrator": "繭", "text": "貴方が言うのには\n納得できないけど――"},
        { "location": "175/TALK"  , "narrator": "繭", "text": "まあ、今日くらいは\nそれでいいと思う。"},
        { "location": "177/TALK"  , "narrator": "つばめ", "text": "よかったね、ガブちゃん。"},
        { "location": "179/TALK"  , "narrator": "ガブリエラ", "text": "ええ…いい気分転換にも\nなったし――"},
        { "location": "180/TALK"  , "narrator": "ガブリエラ", "text": "今夜は、いつもより\n集中して勉強できそう\nだわ。"},
        { "location": "181/TALK"  , "narrator": "つばめ", "text": "えぇっ！？\nまだやるの！？"},
        { "location": "182/TALK"  , "narrator": "ガブリエラ", "text": "まだも何も、遊んじゃって\nほとんどやってないじゃ\nない。"},
        { "location": "183/TALK"  , "narrator": "ガブリエラ", "text": "勉強会で遊んだ以上、\nその分ちゃんと勉強\nしなきゃダメでしょ？"},
        { "location": "184/TALK"  , "narrator": "繭", "text": "…こういうところで、\n優秀かそうでないかの\n違いが出るのか…。"},
        { "location": "187/TALK"  , "narrator": "つばめ", "text": "…わたしも、今夜は\nちょっと遅くまで\n勉強しようかな？"},
        { "location": "189/TALK"  , "narrator": "雛", "text": "うん…一応あたし達、\nガブリエラちゃんより\n先輩なんだから――"},
        { "location": "190/TALK"  , "narrator": "雛", "text": "負けてられないもんね。"},
        { "location": "192/ACT"   , "narrator": "", "text": "誰かの家でやろう"},
        { "location": "211/TALK"  , "narrator": "ガブリエラ", "text": "さすがはマルザンナ、わかってるわね"},
        { "location": "212/TALK"  , "narrator": "ガブリエラ", "text": "お勉強会といえば、誰かの家にお菓子を持ち寄って\nするものよ"},
        { "location": "213/TALK"  , "narrator": "ガブリエラ", "text": "そうじゃなかったら、\n面白くないわ"},
        { "location": "225/TALK"  , "narrator": "ガブリエラ", "text": "それじゃ、誰かの家に――"},
        { "location": "226/TALK"  , "narrator": "雛", "text": "そうだ！\nガブリエラちゃんの\n部屋ってダメかな？"},
        { "location": "228/TALK"  , "narrator": "ガブリエラ", "text": "あ、あたしの部屋！？"},
        { "location": "229/TALK"  , "narrator": "雛", "text": "うん。"},
        { "location": "230/TALK"  , "narrator": "雛", "text": "ガブリエラちゃんが\nどんな部屋で暮らしてる\nのか――"},
        { "location": "231/TALK"  , "narrator": "雛", "text": "ちょっと気になるんだー。"},
        { "location": "233/TALK"  , "narrator": "ガブリエラ", "text": "だ、ダメよ！\nあたしの部屋は…。"},
        { "location": "234/TALK"  , "narrator": "雛", "text": "どうして？"},
        { "location": "236/TALK"  , "narrator": "ガブリエラ", "text": "ど、どうしても！\n第一、急に言われても\n困るし…。"},
        { "location": "237/TALK"  , "narrator": "つばめ", "text": "でも、わたしもちょっと\n入ってみたいな。"},
        { "location": "238/TALK"  , "narrator": "つばめ", "text": "ガブちゃんの部屋って、\nわたしも入ったこと\nなかったし。"},
        { "location": "240/TALK"  , "narrator": "ガブリエラ", "text": "で、でも…。"},
        { "location": "241/TALK"  , "narrator": "ガブリエラ", "text": "あの部屋見たら、\n絶対引かれるか、\nからかわれるわ…。"},
        { "location": "242/TALK"  , "narrator": "ガブリエラ", "text": "メルヘン趣味、とか、\n似合わない、って…。"},
        { "location": "243/TALK"  , "narrator": "雛", "text": "あ、もしかして、\n結構散らかってたり\nするのかなー？"},
        { "location": "245/TALK"  , "narrator": "ガブリエラ", "text": "そんなわけないでしょ？\n整理整頓された部屋が\n好きなんだから。"},
        { "location": "246/TALK"  , "narrator": "繭", "text": "…あっ。"},
        { "location": "247/TALK"  , "narrator": "つばめ", "text": "どうしたの、まゆちん？"},
        { "location": "249/TALK"  , "narrator": "繭", "text": "…もしかして、見られたら\nマズいようなものが\n置いてある…とか？"},
        { "location": "251/TALK"  , "narrator": "雛", "text": "…はっ！？"},
        { "location": "252/TALK"  , "narrator": "雛", "text": "ガブリエラちゃん！\nまさか銃の不法所持とか\nしてるんじゃ…！？"},
        { "location": "254/TALK"  , "narrator": "ガブリエラ", "text": "してない！\n法律に触れるような物、\n持ってないわよ。"},
        { "location": "255/TALK"  , "narrator": "繭", "text": "…だとすると――"},
        { "location": "256/TALK"  , "narrator": "繭", "text": "あまり、他人を部屋に\n上げたくないタイプなの\nかも。"},
        { "location": "258/TALK"  , "narrator": "つばめ", "text": "そうなの？"},
        { "location": "260/TALK"  , "narrator": "ガブリエラ", "text": "あ、えと、別にそういう\nわけじゃないけど…。"},
        { "location": "261/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "263/TALK"  , "narrator": "ガブリエラ", "text": "…笑わない？"},
        { "location": "264/TALK"  , "narrator": "雛", "text": "何が？"},
        { "location": "267/TALK"  , "narrator": "ガブリエラ", "text": "あたしの部屋…\n見ても笑わない？"},
        { "location": "268/TALK"  , "narrator": "雛", "text": "うーん…面白い物が\n置いてあったら、\n笑うかもしれないけど――"},
        { "location": "269/TALK"  , "narrator": "雛", "text": "そうじゃないなら、\n笑ったりしないよ。"},
        { "location": "270/TALK"  , "narrator": "ガブリエラ", "text": "…本当？"},
        { "location": "271/TALK"  , "narrator": "つばめ", "text": "約束するよ。\nガブちゃんの部屋見て、\n笑ったりしないから。"},
        { "location": "272/TALK"  , "narrator": "繭", "text": "私を笑わせたいなら、\n全力で笑わせに来た方が\nいい。"},
        { "location": "274/TALK"  , "narrator": "ガブリエラ", "text": "笑ってもらいたい\nわけじゃないんだけど…。"},
        { "location": "275/TALK"  , "narrator": "ガブリエラ", "text": "…それじゃあ、うちで\nしてもいいわ。"},
        { "location": "277/TALK"  , "narrator": "つばめ", "text": "やった！\nありがと、ガブちゃん！"},
        { "location": "278/TALK"  , "narrator": "雛", "text": "どんな部屋なんだろー？\nすっごく楽しみだよ！"},
        { "location": "279/TALK"  , "narrator": "ガブリエラ", "text": "目的間違えないでよ？"},
        { "location": "299/TALK"  , "narrator": "ガブリエラ", "text": "…どうぞ、上がって。"},
        { "location": "300/TALK"  , "narrator": "雛", "text": "お邪魔しまーす。"},
        { "location": "301/TALK"  , "narrator": "つばめ", "text": "わぁ、ここがガブちゃんの\n部屋かぁ…。"},
        { "location": "302/TALK"  , "narrator": "雛", "text": "うわっ、凄い！！\nあんなに人形があるよ。"},
        { "location": "303/TALK"  , "narrator": "繭", "text": "フランス人形？\n結構良い物みたいね。"},
        { "location": "304/TALK"  , "narrator": "雛", "text": "ガブリエラちゃんって、\n意外とお人形が\n好きなんだ？"},
        { "location": "306/TALK"  , "narrator": "ガブリエラ", "text": "…悪かったわね、\n似合わなくて。"},
        { "location": "309/TALK"  , "narrator": "雛", "text": "え？\n全然そんなことなくない？"},
        { "location": "311/TALK"  , "narrator": "つばめ", "text": "うん、全然変じゃないよ。"},
        { "location": "312/TALK"  , "narrator": "つばめ", "text": "わたしだって、こういう\nお人形は可愛くて\n好きだし。"},
        { "location": "313/TALK"  , "narrator": "雛", "text": "あたしもこういう部屋に\n住みたいなー。"},
        { "location": "315/TALK"  , "narrator": "ガブリエラ", "text": "…あ、あれ？"},
        { "location": "317/TALK"  , "narrator": "ガブリエラ", "text": "…笑わないんだ？"},
        { "location": "318/TALK"  , "narrator": "つばめ", "text": "笑うところ、あるかな？"},
        { "location": "320/TALK"  , "narrator": "繭", "text": "むしろ、どこが笑われると\n思ったのか知りたい。"},
        { "location": "321/TALK"  , "narrator": "繭", "text": "メルヘンな感じだけど、\nオシャレで良い部屋だと\n思う。"},
        { "location": "324/TALK"  , "narrator": "ガブリエラ", "text": "…そっか。"},
        { "location": "325/TALK"  , "narrator": "ガブリエラ", "text": "可愛い、か…。\nそんな部屋であたしが\n暮らしてても――"},
        { "location": "326/TALK"  , "narrator": "ガブリエラ", "text": "変だとは思われないんだ。"},
        { "location": "328/TALK"  , "narrator": "ガブリエラ", "text": "…なんか、ちょっとだけ\n気が軽くなったかも。"},
        { "location": "331/TALK"  , "narrator": "ガブリエラ", "text": "…さ、さあ、ほら！\nさっさと勉強始めるわよ！"},
        { "location": "332/TALK"  , "narrator": "つばめ", "text": "ま、まだ到着したばかり\nなんだし、もう少しして\nからにしようよ…？"},
        { "location": "335/TALK"  , "narrator": "ガブリエラ", "text": "ダメよ。"},
        { "location": "336/TALK"  , "narrator": "ガブリエラ", "text": "やる以上はすぐにでも\n始めないと――"},
        { "location": "337/TALK"  , "narrator": "ガブリエラ", "text": "どんどん面倒になって、\n勉強する気なくなっ\nちゃうわ。"},
        { "location": "338/TALK"  , "narrator": "雛", "text": "はぁ…真面目だねー。"},
        { "location": "339/TALK"  , "narrator": "繭", "text": "だからこそ、\n優秀なんじゃない？"},
        { "location": "340/ACT"   , "narrator": "", "text": "カフェじゃない？"},
        { "location": "359/TALK"  , "narrator": "ガブリエラ", "text": "放課後のカフェで勉強なんて、凄く素敵！"},
        { "location": "360/TALK"  , "narrator": "ガブリエラ", "text": "みんなに提案してみるわ"},
        { "location": "372/TALK"  , "narrator": "ガブリエラ", "text": "いつも行くカフェはどう？"},
        { "location": "373/TALK"  , "narrator": "ガブリエラ", "text": "あそこなら、お茶しながら\n勉強できるし。"},
        { "location": "374/TALK"  , "narrator": "雛", "text": "おっ、それいいかも。"},
        { "location": "375/TALK"  , "narrator": "雛", "text": "お茶だけじゃなくて、\nケーキで糖分補給も\nできるし。"},
        { "location": "376/TALK"  , "narrator": "つばめ", "text": "わぁ、カフェで勉強なんて\nオシャレだよぉ！"},
        { "location": "377/TALK"  , "narrator": "つばめ", "text": "ちょっとドキドキして\nきちゃった。"},
        { "location": "379/TALK"  , "narrator": "ガブリエラ", "text": "じゃあ、決まりね。\n繭はどう？"},
        { "location": "380/TALK"  , "narrator": "繭", "text": "…ケーキは食べたいから、\nとりあえず賛成。"},
        { "location": "381/TALK"  , "narrator": "繭", "text": "けど…。"},
        { "location": "382/TALK"  , "narrator": "雛", "text": "じゃあ、決まりだね。"},
        { "location": "383/TALK"  , "narrator": "つばめ", "text": "うん、早く放課後に\nならないかなぁ？"},
        { "location": "385/TALK"  , "narrator": "繭", "text": "…あそこのカフェで、\n勉強できるのかしら？"},
        { "location": "406/TALK"  , "narrator": "ガブリエラ", "text": "はぁ…ぜんっぜん\n勉強なんてできな\nかったわ。"},
        { "location": "409/TALK"  , "narrator": "つばめ", "text": "うん…そういう雰囲気じゃ\nなかったもんね？"},
        { "location": "411/TALK"  , "narrator": "繭", "text": "っていうか、明らかに\n選んだ店が間違い。"},
        { "location": "412/TALK"  , "narrator": "繭", "text": "あのカフェは、\n騒がしいし人の出入りも\n激しいから――"},
        { "location": "413/TALK"  , "narrator": "繭", "text": "勉強で長時間居座るのは、\nまず無理。"},
        { "location": "416/TALK"  , "narrator": "雛", "text": "それ、もっと早く\n言ってよ！"},
        { "location": "417/TALK"  , "narrator": "繭", "text": "言おうとしたけど\n遮られたのよ。"},
        { "location": "420/TALK"  , "narrator": "ガブリエラ", "text": "よく通ってるのに、\nそんな店だとはまったく\n気づかなかったわ。"},
        { "location": "423/TALK"  , "narrator": "つばめ", "text": "いつもは勉強じゃなくて、\nお喋りしに行ってるから\nかもしれないね。"},
        { "location": "424/TALK"  , "narrator": "繭", "text": "…もう少し、静かで\n長時間いても大丈夫な\n店を探した方が良い。"},
        { "location": "425/TALK"  , "narrator": "繭", "text": "店によっては、\n勉強ＮＧなところも\nあるみたいだけど…。"},
        { "location": "426/TALK"  , "narrator": "雛", "text": "そっかぁ…。\nそういうのダメな\nお店もあるのか…。"},
        { "location": "427/TALK"  , "narrator": "繭", "text": "長時間居座られても、\n儲けにならなきゃ\n店側もやってられない。"},
        { "location": "430/TALK"  , "narrator": "ガブリエラ", "text": "外で勉強するのって、\n意外と難しいのね…。"},
        { "location": "432/TALK"  , "narrator": "つばめ", "text": "じゃあ、今度の勉強会は\nわたしの部屋でやろうよ。"},
        { "location": "433/TALK"  , "narrator": "つばめ", "text": "それなら静かだし、\n時間も気にしないで、\nじっくり勉強できるよ。"},
        { "location": "434/TALK"  , "narrator": "雛", "text": "いいね、そうしようよ！\nお菓子とかジュース、\n一杯買っていってさー！"},
        { "location": "437/TALK"  , "narrator": "ガブリエラ", "text": "勉強より、飲み食いが\nメインになりそうで\n心配だわ。"},
        { "location": "438/TALK"  , "narrator": "ガブリエラ", "text": "…でも、それもちょっと\n楽しそうかも。"},
        { "location": "439/ACT"   , "narrator": "", "text": "図書室こそ王道"},
        { "location": "459/TALK"  , "narrator": "ガブリエラ", "text": "マルザンナ、それじゃ５０点よ"},
        { "location": "460/TALK"  , "narrator": "ガブリエラ", "text": "図書室での勉強会は、ラブコメ漫画の王道だから、私達にとってはそうじゃないわ"},
        { "location": "461/TALK"  , "narrator": "ガブリエラ", "text": "でも、静かで集中できそうではあるわね"},
        { "location": "472/TALK"  , "narrator": "ガブリエラ", "text": "図書室でいいじゃない。"},
        { "location": "473/TALK"  , "narrator": "ガブリエラ", "text": "あそこなら無駄話も\nできないから――"},
        { "location": "474/TALK"  , "narrator": "ガブリエラ", "text": "勉強に集中できそうだし。"},
        { "location": "475/TALK"  , "narrator": "雛", "text": "えーっ、カフェとか\n誰かの家の方が\nお喋りできるのにー…。"},
        { "location": "476/TALK"  , "narrator": "繭", "text": "…勉強する気ないでしょ？"},
        { "location": "479/TALK"  , "narrator": "つばめ", "text": "ま、まあまあ…"},
        { "location": "480/TALK"  , "narrator": "つばめ", "text": "でも、図書室なら\nどこよりも集中できそう\nだし、賛成だよ。"},
        { "location": "482/TALK"  , "narrator": "ガブリエラ", "text": "んじゃ、決まりね。\n放課後になったら\n図書室に集合よ。"},
        { "location": "484/TALK"  , "narrator": "ガブリエラ", "text": "ふふっ、楽しみだなぁ…。"},
        { "location": "507/TALK"  , "narrator": "ガブリエラ", "text": "じーーーーっ。"},
        { "location": "509/TALK"  , "narrator": "女子高校生Ｂ", "text": "ねぇねぇ、コウくん。\nこの問題わからないぃー。"},
        { "location": "511/TALK"  , "narrator": "男子高校生Ａ", "text": "またか？　チィは本当に\n数学が苦手なんだな。"},
        { "location": "512/TALK"  , "narrator": "女子高校生Ｂ", "text": "だって、方程式とか\n苦手なんだもん。"},
        { "location": "513/TALK"  , "narrator": "ガブリエラ", "text": "じーーーーっ。"},
        { "location": "516/TALK"  , "narrator": "つばめ", "text": "ガブちゃん。\n今は勉強中だから、\n教科書見よう？"},
        { "location": "519/TALK"  , "narrator": "ガブリエラ", "text": "わ、わかってるわよ。"},
        { "location": "521/TALK"  , "narrator": "ガブリエラ", "text": "うわぁ…前に座ってるの、\n絶対カップルよね？"},
        { "location": "522/TALK"  , "narrator": "ガブリエラ", "text": "本当に図書室で勉強する\nカップルっていたんだ…\nビックリかも。"},
        { "location": "525/TALK"  , "narrator": "女子高校生Ｂ", "text": "あーん、コウくーん。\nこの問題わからないー。"},
        { "location": "528/TALK"  , "narrator": "男子高校生Ａ", "text": "ん？　今度はどこが\nわからないんだ？"},
        { "location": "529/TALK"  , "narrator": "女子高校生Ｂ", "text": "ここだよぉ…。\nちゃんと教えてもらった\n方程式使ってるのに…。"},
        { "location": "530/TALK"  , "narrator": "男子高校生Ａ", "text": "…ははっ、\nこのおっちょこちょい。"},
        { "location": "531/TALK"  , "narrator": "女子高校生Ｂ", "text": "アンッ！\nもぉ、オデコツンツン\n禁止ー。"},
        { "location": "534/TALK"  , "narrator": "ガブリエラ", "text": "おっちょこちょいからの\nデコツン！？"},
        { "location": "535/TALK"  , "narrator": "ガブリエラ", "text": "えっ？　何この二人凄い！\nラブコメみたいなこと\n本当にやってる！"},
        { "location": "537/TALK"  , "narrator": "雛", "text": "ガブリエラちゃん、\n見ちゃいけません！"},
        { "location": "541/TALK"  , "narrator": "ガブリエラ", "text": "み、見てないわよ。"},
        { "location": "542/TALK"  , "narrator": "男子高校生Ａ", "text": "計算する順番が違うぞ。\nほら、足し算と掛け算は、\nどっちを最初にする？"},
        { "location": "543/TALK"  , "narrator": "女子高校生Ｂ", "text": "えっとぉ…えっとぉ…。"},
        { "location": "544/TALK"  , "narrator": "女子高校生Ｂ", "text": "あっ、掛け算だ！"},
        { "location": "545/TALK"  , "narrator": "男子高校生Ａ", "text": "そう、だから答えが\n違ってるんだよ。"},
        { "location": "546/TALK"  , "narrator": "女子高校生Ｂ", "text": "てへっ、失敗失敗。"},
        { "location": "549/TALK"  , "narrator": "ガブリエラ", "text": "てへっ！？\nてへって本当に言うの！？"},
        { "location": "550/TALK"  , "narrator": "ガブリエラ", "text": "アニメの世界だけかと\n思ったけど…日本人の\nカップルって凄い！"},
        { "location": "552/TALK"  , "narrator": "ガブリエラ", "text": "勉強会を図書館にして\n正解だったわ。"},
        { "location": "554/TALK"  , "narrator": "つばめ", "text": "…席移るか、もう帰るか\nした方が良いかな？"},
        { "location": "556/TALK"  , "narrator": "雛", "text": "うん、それがいいと思う。\nガブリエラちゃんの\n教育に良くないし…。"},
        { "location": "557/TALK"  , "narrator": "つばめ", "text": "…図書館での勉強会は、\nもうやらない方が\nいいかも…。"},
        { "location": "17/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>6月29日　2:04 PM</color>\n初夏の平日、高等部廊下にて。"},
        { "location": "568/DIALOG", "narrator": "Dialog_GEThimegoto_ch03", "text": "【リアリティとリアリズム】"}
    ]
}
