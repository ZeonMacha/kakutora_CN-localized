{
    "dir": "chap09/daydra/dd_ch03_09_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "9302",
        "cid": "gabriella",
        "title": "002 メインストーリー",
        "sub_title": "クラスの実態＜前編＞"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "クラスの実態"},
        { "location": "30/TALK"   , "narrator": "ガブリエラ", "text": "…さてと。\n今日もバイトだし、\nさっさと帰って――"},
        { "location": "32/TALK"   , "narrator": "つばめ", "text": "えーっと…。"},
        { "location": "41/TALK"   , "narrator": "つばめ", "text": "あっ、せんぱーい！"},
        { "location": "44/TALK"   , "narrator": "ガブリエラ", "text": "っ！？　し、新人！？"},
        { "location": "45/TALK"   , "narrator": "つばめ", "text": "よかったぁ…。\n先に帰ってたら\nどうしようかと――"},
        { "location": "47/TALK"   , "narrator": "ガブリエラ", "text": "ば、バカ！\n声が大きいから！"},
        { "location": "48/TALK"   , "narrator": "つばめ", "text": "あっ…。"},
        { "location": "52/TALK"   , "narrator": "つばめ", "text": "えへへ…。\n目立っちゃった…。"},
        { "location": "54/TALK"   , "narrator": "ガブリエラ", "text": "まったく…。"},
        { "location": "57/TALK"   , "narrator": "つばめ", "text": "ごめんなさい、\nガブリエラせんぱい。"},
        { "location": "59/TALK"   , "narrator": "ガブリエラ", "text": "ちょ！？\nここでせんぱいって\n言うな！"},
        { "location": "60/TALK"   , "narrator": "つばめ", "text": "えっ！？　でも、\nせんぱいがそう呼べ、\nって言ったのに…。"},
        { "location": "61/TALK"   , "narrator": "ガブリエラ", "text": "だ、だから、声も\nもう少し抑えて…。"},
        { "location": "65/TALK"   , "narrator": "ガブリエラ", "text": "…ううん。\nもう遅いか…。。"},
        { "location": "66/TALK"   , "narrator": "男子高校生Ａ", "text": "なあ、あの人って\n特別攻撃隊に入った\n高等部の先輩だろ？"},
        { "location": "67/TALK"   , "narrator": "女子高校生Ａ", "text": "そうそう。\nこの間転校して\nきたんだって。"},
        { "location": "68/TALK"   , "narrator": "男子高校生Ｂ", "text": "年上の人に先輩って\n呼ばせてるとか、\nすげーな……。"},
        { "location": "69/TALK"   , "narrator": "女子高校生Ａ", "text": "うん…度胸あるよね。"},
        { "location": "72/TALK"   , "narrator": "ガブリエラ", "text": "はぁ…またあたしの\nイメージが…。"},
        { "location": "73/TALK"   , "narrator": "ガブリエラ", "text": "タダでさえ浮き\nまくってるって\nいうのに……。"},
        { "location": "75/TALK"   , "narrator": "つばめ", "text": "えっと…怒ってる？"},
        { "location": "78/TALK"   , "narrator": "ガブリエラ", "text": "…怒ってなんか\nないから。ほら、\nさっさと出るわよ！"},
        { "location": "81/TALK"   , "narrator": "つばめ", "text": "あ、待ってください、\nせんぱい！"},
        { "location": "85/TALK"   , "narrator": "ガブリエラ", "text": "せんぱいは\nやめなさいって！"},
        { "location": "107/TALK"  , "narrator": "ガブリエラ", "text": "まったく…高等部の\n人が中等部の教室に\n来たら――"},
        { "location": "108/TALK"  , "narrator": "ガブリエラ", "text": "それだけで目立つって\nわかんないの！？"},
        { "location": "110/TALK"  , "narrator": "つばめ", "text": "そ、そうだよね…。"},
        { "location": "113/TALK"  , "narrator": "ガブリエラ", "text": "それで、何の用？\nなんか話すことでも\nあるわけ？"},
        { "location": "115/TALK"  , "narrator": "つばめ", "text": "あ、はい…せんぱい、\n昼休みにわたしの\n教室に来ましたよね？"},
        { "location": "117/TALK"  , "narrator": "ガブリエラ", "text": "っ！？\nき、気付かれてた！？"},
        { "location": "118/TALK"  , "narrator": "つばめ", "text": "でも、教室覗いて、\nそのまま帰っちゃった\nから――"},
        { "location": "119/TALK"  , "narrator": "つばめ", "text": "ちょっと心配で、\n様子を見に来たん\nです。"},
        { "location": "122/TALK"  , "narrator": "ガブリエラ", "text": "別に…心配するような\nことじゃないでしょ？"},
        { "location": "124/TALK"  , "narrator": "つばめ", "text": "わたしがまた何か\nやっちゃったのかな、\nって…。えへへ。"},
        { "location": "128/TALK"  , "narrator": "ガブリエラ", "text": "はぁ……"},
        { "location": "130/TALK"  , "narrator": "ガブリエラ", "text": "それってちょっと\n自意識過剰なんじゃ\nない？"},
        { "location": "132/TALK"  , "narrator": "つばめ", "text": "え？"},
        { "location": "134/TALK"  , "narrator": "ガブリエラ", "text": "べ、べつにあんたの\n様子を見に行った\nわけじゃないの！"},
        { "location": "135/TALK"  , "narrator": "ガブリエラ", "text": "変に勘違いしないで。"},
        { "location": "137/TALK"  , "narrator": "つばめ", "text": "あ、あはは。\nそうですよね。\nごめんなさい。"},
        { "location": "140/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "142/TALK"  , "narrator": "つばめ", "text": "…やっぱり、\nいつもと比べて\n元気がないかも…。"},
        { "location": "145/TALK"  , "narrator": "つばめ", "text": "あ、あの…相談したい\nこととかあったら、\n言ってくださいね？"},
        { "location": "147/TALK"  , "narrator": "ガブリエラ", "text": "うるさい！\n何もないって\n言ってるでしょ！？"},
        { "location": "150/TALK"  , "narrator": "つばめ", "text": "…ごめんなさい。"},
        { "location": "151/TALK"  , "narrator": "ガブリエラ", "text": "まったく…。"},
        { "location": "152/TALK"  , "narrator": "つばめ", "text": "…………。"},
        { "location": "153/SEL"   , "narrator": "", "text": "そんなに怒らないで"},
        { "location": "154/ACT"   , "narrator": "", "text": "そんなに怒らないで"},
        { "location": "165/TALK"  , "narrator": "ガブリエラ", "text": "私のせいじゃないわ"},
        { "location": "166/TALK"  , "narrator": "ガブリエラ", "text": "新人が天然過ぎるのがいけないのよ"},
        { "location": "168/SEL"   , "narrator": "", "text": "天然だから許してあげて"},
        { "location": "169/ACT"   , "narrator": "", "text": "天然だから許してあげて"},
        { "location": "171/TALK"  , "narrator": "ガブリエラ", "text": "違うわ"},
        { "location": "174/TALK"  , "narrator": "ガブリエラ", "text": "違うのよ、マルザンナ"},
        { "location": "175/TALK"  , "narrator": "ガブリエラ", "text": "そういうことじゃないのよ"},
        { "location": "222/SEL"   , "narrator": "", "text": "そういうことじゃないなら、どういうことなんだろうか"},
        { "location": "223/ACT"   , "narrator": "", "text": "そういうことじゃないなら、どういうことなんだろうか"},
        { "location": "226/TALK"  , "narrator": "ガブリエラ", "text": "あら、どうしたの？"},
        { "location": "227/SEL"   , "narrator": "", "text": "現実のガブリエラが「そういうことじゃないのよ」って"},
        { "location": "228/ACT"   , "narrator": "", "text": "現実のガブリエラが「そういうことじゃないのよ」って"},
        { "location": "230/TALK"  , "narrator": "ガブリエラ", "text": "なるほどね♪"},
        { "location": "231/TALK"  , "narrator": "ガブリエラ", "text": "答えは簡単！"},
        { "location": "232/SEL"   , "narrator": "", "text": "流石本人の一人格！"},
        { "location": "233/ACT"   , "narrator": "", "text": "流石本人の一人格！"},
        { "location": "236/TALK"  , "narrator": "ガブリエラ", "text": "扉をコールすれば\nどんな事でも全部\n判っちゃうの♪"},
        { "location": "237/SEL"   , "narrator": "", "text": "あ、はい…"},
        { "location": "238/ACT"   , "narrator": "", "text": "あ、はい…"},
        { "location": "240/TALK"  , "narrator": "ガブリエラ", "text": "それじゃ早速！\n今回も頑張って扉を\nコールしちゃうわね！"},
        { "location": "247/TALK"  , "narrator": "ガブリエラ", "text": "オープンプロセス、\n0x578番地から\n0x19D番地へ。"},
        { "location": "262/TALK"  , "narrator": "ガブリエラ", "text": "シーク完了っ♪"},
        { "location": "264/TALK"  , "narrator": "ガブリエラ", "text": "で…っと、\n何が「そういうことじゃ\nない」のかしらね。"},
        { "location": "266/TALK"  , "narrator": "ガブリエラ", "text": "……。"},
        { "location": "267/TALK"  , "narrator": "ガブリエラ", "text": "………。"},
        { "location": "268/TALK"  , "narrator": "ガブリエラ", "text": "あー、なるほど。"},
        { "location": "269/TALK"  , "narrator": "ガブリエラ", "text": "結構混乱\nしちゃってるわね。"},
        { "location": "270/TALK"  , "narrator": "ガブリエラ", "text": "$handle$の助けが\n必要みたいよ？"},
        { "location": "271/TALK"  , "narrator": "ガブリエラ", "text": "ココロファイルナンバー\n03-596-15を見る限り、\nもうあたしは限界っぽい。"},
        { "location": "272/TALK"  , "narrator": "ガブリエラ", "text": "つばめと仲良くなりたくて\n仕方ないのに、どうしても\n素直になれない。"},
        { "location": "273/TALK"  , "narrator": "ガブリエラ", "text": "それでも今までは\nクランを産むほどじゃ\nなかったんだけど。"},
        { "location": "274/TALK"  , "narrator": "ガブリエラ", "text": "今回はこのままクランを\n放っておくと、つばめとの\n関係に亀裂が入りそうね。"},
        { "location": "275/SEL"   , "narrator": "", "text": "それってかなり大変じゃない？"},
        { "location": "276/ACT"   , "narrator": "", "text": "それってかなり大変じゃない？"},
        { "location": "278/TALK"  , "narrator": "ガブリエラ", "text": "そうよ！"},
        { "location": "279/TALK"  , "narrator": "ガブリエラ", "text": "そんな事になったら、\nあたしここに閉じこもって\nもう出てこないから！"},
        { "location": "280/SEL"   , "narrator": "", "text": "逆ギレ！？"},
        { "location": "281/ACT"   , "narrator": "", "text": "逆ギレ！？"},
        { "location": "284/TALK"  , "narrator": "ガブリエラ", "text": "いや、そういうわけじゃ\nないんだけど！"},
        { "location": "285/TALK"  , "narrator": "ガブリエラ", "text": "はぁ…、それにしても\nほんとに…あたしってば\n不器用なんだから！"},
        { "location": "286/TALK"  , "narrator": "ガブリエラ", "text": "だから早く、つばめと\n仲良くなっておけば\n良かったのに。"},
        { "location": "287/TALK"  , "narrator": "ガブリエラ", "text": "お願い！　毎度助けて\nもらってるのに、こんな事\n言うのも変だけど！"},
        { "location": "288/TALK"  , "narrator": "ガブリエラ", "text": "今回ばかりは、\nあたしたちのために\n力を貸して！"},
        { "location": "289/SEL"   , "narrator": "", "text": "もちろん"},
        { "location": "290/ACT"   , "narrator": "", "text": "もちろん"},
        { "location": "293/TALK"  , "narrator": "ガブリエラ", "text": "ありがとう。\n本当にありがとう！"},
        { "location": "294/TALK"  , "narrator": "ガブリエラ", "text": "あたしのこと\n宜しくお願いね。"},
        { "location": "295/TALK"  , "narrator": "ガブリエラ", "text": "あたしと\n$handle$にとって\n素敵なココロの旅を！"},
        { "location": "29/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>5月11日　3:31 PM</color>\nとある平日の放課後、中等部教室にて。"},
        { "location": "190/DIALOG", "narrator": "BattleInit/Dialog_BATTLE_ch03", "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n"}
    ]
}
