    [
        { "location": "102/SCENARIO", "narrator": "", "text": "023_かなしいことり"},
        { "location": "127/TALK"    , "narrator": "ガブリエラ", "text": "$marzanna$はアキバに行ったことがあるかしら？"},
        { "location": "129/SEL"     , "narrator": "", "text": "ある"},
        { "location": "130/SEL"     , "narrator": "", "text": "ないなあ"},
        { "location": "131/SEL"     , "narrator": "", "text": "むしろ庭"},
        { "location": "132/ACT"     , "narrator": "", "text": "ある"},
        { "location": "133/TALK"    , "narrator": "ガブリエラ", "text": "あるのねｖ"},
        { "location": "134/ACT"     , "narrator": "", "text": "ないなあ"},
        { "location": "135/TALK"    , "narrator": "ガブリエラ", "text": "そうなの・・・"},
        { "location": "136/ACT"     , "narrator": "", "text": "むしろ庭"},
        { "location": "138/TALK"    , "narrator": "ガブリエラ", "text": "そうなのねｖｖｖｖ"},
        { "location": "140/TALK"    , "narrator": "ガブリエラ", "text": "すごいわ$marzanna$ったら！"},
        { "location": "142/TALK"    , "narrator": "ガブリエラ", "text": "みんなと行ったことはあるけど"},
        { "location": "143/TALK"    , "narrator": "ガブリエラ", "text": "一人で行ったことはないの"},
        { "location": "144/TALK"    , "narrator": "ガブリエラ", "text": "$marzanna$のおすすめはどこかしら？"},
        { "location": "146/SEL"     , "narrator": "", "text": "メイドカフェ"},
        { "location": "147/SEL"     , "narrator": "", "text": "執事カフェ"},
        { "location": "148/SEL"     , "narrator": "", "text": "おすすめできないな"},
        { "location": "149/ACT"     , "narrator": "", "text": "メイドカフェ"},
        { "location": "150/TALK"    , "narrator": "ガブリエラ", "text": "アキバっぽい響きね"},
        { "location": "151/TALK"    , "narrator": "ガブリエラ", "text": "行ってみようかしら"},
        { "location": "152/ACT"     , "narrator": "", "text": "執事カフェ"},
        { "location": "153/TALK"    , "narrator": "ガブリエラ", "text": "そんなものがあるのね！"},
        { "location": "154/TALK"    , "narrator": "ガブリエラ", "text": "とても気になるわ"},
        { "location": "155/ACT"     , "narrator": "", "text": "おすすめできないな"},
        { "location": "157/TALK"    , "narrator": "ガブリエラ", "text": "あら"},
        { "location": "158/TALK"    , "narrator": "ガブリエラ", "text": "どうしてかしら？"},
        { "location": "161/SEL"     , "narrator": "", "text": "おしゃれじゃないから"},
        { "location": "162/SEL"     , "narrator": "", "text": "ガブにはまだ早いから"},
        { "location": "163/ACT"     , "narrator": "", "text": "おしゃれじゃないから"},
        { "location": "165/TALK"    , "narrator": "ガブリエラ", "text": "そんな理由なの？"},
        { "location": "166/TALK"    , "narrator": "ガブリエラ", "text": "不思議なこと言うのね"},
        { "location": "167/TALK"    , "narrator": "ガブリエラ", "text": "それなら"},
        { "location": "168/TALK"    , "narrator": "ガブリエラ", "text": "今度おしゃれな場所に行きましょうね"},
        { "location": "169/TALK"    , "narrator": "ガブリエラ", "text": "二人で"},
        { "location": "170/ACT"     , "narrator": "", "text": "ガブにはまだ早いから"},
        { "location": "171/TALK"    , "narrator": "ガブリエラ", "text": "何なのかしらそれは"},
        { "location": "173/TALK"    , "narrator": "ガブリエラ", "text": "早いとか遅いとかないと思うわ"},
        { "location": "174/TALK"    , "narrator": "ガブリエラ", "text": "そういうのは"}
    ]
}
