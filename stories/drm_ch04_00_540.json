        "title": "らぶとーく 第59話",
        "sub_title": "金剛石など呉れぬかよ"
    },
    "entry":
    [
        { "location": "337/SCENARIO", "narrator": "", "text": "460_金剛石など呉れぬかよ"},
        { "location": "362/TALK"    , "narrator": "みやび", "text": "みやび"},
        { "location": "363/TALK"    , "narrator": "みやび", "text": "金剛石が欲しいな☆彡"},
        { "location": "365/SEL"     , "narrator": "", "text": "熱でもあるの"},
        { "location": "366/SEL"     , "narrator": "", "text": "ダイヤモンドのことでいいの？"},
        { "location": "367/SEL"     , "narrator": "", "text": "真実の愛ならいつでもあげる"},
        { "location": "368/ACT"     , "narrator": "", "text": "熱でもあるの"},
        { "location": "369/TALK"    , "narrator": "みやび", "text": "ない"},
        { "location": "370/TALK"    , "narrator": "みやび", "text": "が"},
        { "location": "371/TALK"    , "narrator": "みやび", "text": "その言い方に熱が出てきたぞね"},
        { "location": "372/TALK"    , "narrator": "みやび", "text": "故に"},
        { "location": "373/TALK"    , "narrator": "みやび", "text": "寝る"},
        { "location": "374/ACT"     , "narrator": "", "text": "ダイヤモンドのことでいいの？"},
        { "location": "375/TALK"    , "narrator": "みやび", "text": "そう"},
        { "location": "377/TALK"    , "narrator": "みやび", "text": "永遠の輝きを持つ天然石のことぞね"},
        { "location": "379/SEL"     , "narrator": "", "text": "今度一緒に買いに行こう"},
        { "location": "380/SEL"     , "narrator": "", "text": "そのうちね"},
        { "location": "381/ACT"     , "narrator": "", "text": "今度一緒に買いに行こう"},
        { "location": "382/TALK"    , "narrator": "みやび", "text": "うむ"},
        { "location": "383/TALK"    , "narrator": "みやび", "text": "絶対だぞ"},
        { "location": "384/TALK"    , "narrator": "みやび", "text": "期待しておく"},
        { "location": "385/ACT"     , "narrator": "", "text": "そのうちね"},
        { "location": "386/TALK"    , "narrator": "みやび", "text": "そのうちとか"},
        { "location": "387/TALK"    , "narrator": "みやび", "text": "曖昧すぎるな"},
        { "location": "389/ACT"     , "narrator": "", "text": "真実の愛ならいつでもあげる"},
        { "location": "399/TALK"    , "narrator": "みやび", "text": "ほほう"},
        { "location": "400/TALK"    , "narrator": "みやび", "text": "言葉だけならなんとでも言えるろう"},
        { "location": "403/SEL"     , "narrator": "", "text": "本気なのに"},
        { "location": "404/SEL"     , "narrator": "", "text": "言葉はタダだからね"},
        { "location": "405/SEL"     , "narrator": "", "text": "本当は嬉しいくせに"},
        { "location": "406/ACT"     , "narrator": "", "text": "本気なのに"},
        { "location": "407/TALK"    , "narrator": "みやび", "text": "その言い方が"},
        { "location": "408/TALK"    , "narrator": "みやび", "text": "軽いというのだ"},
        { "location": "409/TALK"    , "narrator": "みやび", "text": "もっとちゃんと言うのだ"},
        { "location": "410/TALK"    , "narrator": "みやび", "text": "ばかもんが"},
        { "location": "411/ACT"     , "narrator": "", "text": "言葉はタダだからね"},
        { "location": "412/TALK"    , "narrator": "みやび", "text": "そういう理由か"},
        { "location": "413/TALK"    , "narrator": "みやび", "text": "全く"},
        { "location": "414/TALK"    , "narrator": "みやび", "text": "現金とはまさにこのこと"},
        { "location": "415/ACT"     , "narrator": "", "text": "本当は嬉しいくせに"},
        { "location": "417/TALK"    , "narrator": "みやび", "text": "そんなわけあるか"},
        { "location": "418/TALK"    , "narrator": "みやび", "text": "図々しいぞ"},
        { "location": "419/TALK"    , "narrator": "みやび", "text": "$handle$め"},
        { "location": "420/TALK"    , "narrator": "みやび", "text": "$handle$のくせに"},
        { "location": "422/TALK"    , "narrator": "みやび", "text": "なんということを言うのだ"},
        { "location": "424/SEL"     , "narrator": "", "text": "照れなくても"},
        { "location": "425/SEL"     , "narrator": "", "text": "違った？"},
        { "location": "426/ACT"     , "narrator": "", "text": "照れなくても"},
        { "location": "427/TALK"    , "narrator": "みやび", "text": "照れなくてもとか"},
        { "location": "428/TALK"    , "narrator": "みやび", "text": "照れるに決まっておる"},
        { "location": "429/TALK"    , "narrator": "みやび", "text": "ばかもんが"},
        { "location": "430/ACT"     , "narrator": "", "text": "違った？"},
        { "location": "431/TALK"    , "narrator": "みやび", "text": "違うとか違わぬとかではない"},
        { "location": "432/TALK"    , "narrator": "みやび", "text": "何でそういうことを言うのか"},
        { "location": "433/TALK"    , "narrator": "みやび", "text": "照れるに決まっておるわ"},
        { "location": "395/DIALOG"  , "narrator": "Dialog_GETGokigen", "text": "ゴキゲンポイントが\n<size=40><color=red><b>1000pt.</b></color></size>\nアップしました！"}
    ]
}
