{
    "dir": "chap09/daydra/dd_ch04_09_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "9452",
        "cid": "miyabi",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "今更！？"
    },
    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "今更！？"},
        { "location": "25/TALK"   , "narrator": "みやび", "text": "つばめちゃん、ちっくと\nこっち手伝ってくれんか？"},
        { "location": "27/TALK"   , "narrator": "つばめ", "text": "はーい、今行きまーす！"},
        { "location": "41/TALK"   , "narrator": "みやび", "text": "ありがとな。\nまっこと助かったわ。"},
        { "location": "44/TALK"   , "narrator": "つばめ", "text": "いえ、また何かあったら\n言ってください…。"},
        { "location": "46/TALK"   , "narrator": "みやび", "text": "…？\n何か聞きたいことでも\nありそうな顔やね。"},
        { "location": "47/TALK"   , "narrator": "つばめ", "text": "はい…あの、今更かって\n言われちゃいそうなん\nですけど――。"},
        { "location": "48/TALK"   , "narrator": "つばめ", "text": "みやびさんの方言って、\n何弁になるんですか？"},
        { "location": "49/TALK"   , "narrator": "みやび", "text": "…ま、まっこと、\n今更過ぎる質問やね。"},
        { "location": "52/TALK"   , "narrator": "つばめ", "text": "す、すみません…。"},
        { "location": "53/TALK"   , "narrator": "みやび", "text": "いや、えいよえいよ。\nつばめちゃんのそういう\nところ、結構好きやし。"},
        { "location": "54/SEL"    , "narrator": "", "text": "普通に土佐弁と言おう"},
        { "location": "55/SEL"    , "narrator": "", "text": "古代ジャンガリヤ語"},
        { "location": "56/SEL"    , "narrator": "", "text": "キャラ作りと言え"},
        { "location": "59/TALK"   , "narrator": "みやび", "text": "けんど、うちの方言って\nそんなにマイナーながか？"},
        { "location": "61/TALK"   , "narrator": "つばめ", "text": "どうなんでしょう？\nわたし、方言とかって\n詳しくなくて…。"},
        { "location": "62/TALK"   , "narrator": "つばめ", "text": "聞いたことはあるけど、\nそれがどこの方言なのかは\nわからない――"},
        { "location": "63/TALK"   , "narrator": "つばめ", "text": "って感じなんです。"},
        { "location": "65/TALK"   , "narrator": "みやび", "text": "…なるほど。\nえいよ、別に隠すことでも\nないき。"},
        { "location": "68/TALK"   , "narrator": "みやび", "text": "うちが使っちゅうんは、\n土佐弁や。"},
        { "location": "69/TALK"   , "narrator": "みやび", "text": "まあかなり崩しちょるき、\nほぼ標準語に近くは\nなっちょるけんどな。"},
        { "location": "71/TALK"   , "narrator": "つばめ", "text": "土佐、ですか？"},
        { "location": "74/TALK"   , "narrator": "神楽", "text": "坂本竜馬も使っていた\nやつですよ。"},
        { "location": "77/TALK"   , "narrator": "つばめ", "text": "ああ、わかった！"},
        { "location": "80/TALK"   , "narrator": "つばめ", "text": "ぜよ、ですね！"},
        { "location": "81/TALK"   , "narrator": "みやび", "text": "そうやね…まあ、女は\nぜよを使わんし、今は\n男も使わんけんどな…。"},
        { "location": "84/TALK"   , "narrator": "みやび", "text": "しかし、土佐弁イコール\n竜馬のイメージは、\nやっぱり強いよなぁ…。"},
        { "location": "86/ACT"    , "narrator": "", "text": "普通に土佐弁と言おう"},
        { "location": "106/TALK"  , "narrator": "みやび", "text": "なんや、つまらんヤツやな"},
        { "location": "107/TALK"  , "narrator": "みやび", "text": "ここはありもしない言語の名前の一つも言うところやのに…"},
        { "location": "118/TALK"  , "narrator": "みやび", "text": "まあ、つばめちゃんは純粋やき"},
        { "location": "119/TALK"  , "narrator": "みやび", "text": "下手なウソ言うて信じられても"},
        { "location": "121/TALK"  , "narrator": "みやび", "text": "後々面倒なことになりそうやが…"},
        { "location": "123/TALK"  , "narrator": "みやび", "text": "うちが使っちゅうんは、\n土佐弁や。"},
        { "location": "124/TALK"  , "narrator": "みやび", "text": "まあ、かなり崩してるき、\nほぼ標準語に近くは\nなっちょるけんどな。"},
        { "location": "125/TALK"  , "narrator": "つばめ", "text": "土佐、ですか？"},
        { "location": "128/TALK"  , "narrator": "神楽", "text": "坂本竜馬も使っていた\nやつですよ。"},
        { "location": "131/TALK"  , "narrator": "つばめ", "text": "ああ、わかった！"},
        { "location": "134/TALK"  , "narrator": "つばめ", "text": "ぜよ、ですね！"},
        { "location": "135/TALK"  , "narrator": "みやび", "text": "そうやね…まあ、女は\nぜよを使わんし、今は\n男も使わんけんどな…。"},
        { "location": "138/TALK"  , "narrator": "みやび", "text": "しかし、土佐弁イコール\n竜馬のイメージは、\nやっぱり強いよなぁ…。"},
        { "location": "139/ACT"   , "narrator": "", "text": "古代ジャンガリヤ語"},
        { "location": "160/TALK"  , "narrator": "みやび", "text": "それや！"},
        { "location": "161/TALK"  , "narrator": "みやび", "text": "そういうのを期待してたんよ"},
        { "location": "162/TALK"  , "narrator": "みやび", "text": "相棒は最高やな、うちの部屋にあるお菓子食べてもえいぞ"},
        { "location": "174/TALK"  , "narrator": "みやび", "text": "古代ジャンガリヤ語や。"},
        { "location": "177/TALK"  , "narrator": "つばめ", "text": "…はい？"},
        { "location": "178/TALK"  , "narrator": "みやび", "text": "古代ジャンガリヤ語。\nなんや、知らんのか？"},
        { "location": "181/TALK"  , "narrator": "つばめ", "text": "えっ！？　えっと…\nそれ、冗談ですよね？"},
        { "location": "184/TALK"  , "narrator": "ガブリエラ", "text": "何言ってんのよ？\n超メジャーじゃない。"},
        { "location": "187/TALK"  , "narrator": "みやび", "text": "おっ、ナイスタイミング\nやないか、ガブちゃん！"},
        { "location": "190/TALK"  , "narrator": "ガブリエラ", "text": "古代ジャンガリヤ語は\nその昔、邪馬台国の隣に\nあったという――"},
        { "location": "191/TALK"  , "narrator": "ガブリエラ", "text": "雀狩耶ノ国で使われていた\n言語で、今も一部地域に\n残ってる方言よ。"},
        { "location": "194/TALK"  , "narrator": "つばめ", "text": "えぇーっ！？\n初めて知りました！"},
        { "location": "196/TALK"  , "narrator": "みやび", "text": "ガブちゃん、よくもまあ\nそんなデタラメをペラペラ\n言えるもんやなぁ…。"},
        { "location": "199/TALK"  , "narrator": "みやび", "text": "まあ、そういうことやき。\nわかってもらえたがか？"},
        { "location": "201/TALK"  , "narrator": "つばめ", "text": "は、はい。\n勉強になりました。"},
        { "location": "202/TALK"  , "narrator": "ガブリエラ", "text": "うんうん、また一つ\n賢くなったわねぇ。"},
        { "location": "206/TALK"  , "narrator": "みやび", "text": "ガブちゃん、悪そうな\n笑顔やなぁ…。"},
        { "location": "208/TALK"  , "narrator": "つばめ", "text": "…わたし、まだまだ\n知らないことが沢山\nあるんだなぁ。"},
        { "location": "209/TALK"  , "narrator": "つばめ", "text": "今度、お母さんにも\n教えてあげよっと。"},
        { "location": "212/TALK"  , "narrator": "みやび", "text": "…なんやろう、\nこの嫌な予感は？"},
        { "location": "213/ACT"   , "narrator": "", "text": "キャラ作りと言え"},
        { "location": "234/TALK"  , "narrator": "みやび", "text": "予想外やけんど、えいな"},
        { "location": "235/TALK"  , "narrator": "みやび", "text": "よし、キャラ崩壊覚悟でいってやるき！"},
        { "location": "247/TALK"  , "narrator": "みやび", "text": "実はな、つばめちゃん…\nこの話し方はただの\nキャラ作りなんよ。"},
        { "location": "250/TALK"  , "narrator": "つばめ", "text": "えっ、キャラですか！？"},
        { "location": "252/TALK"  , "narrator": "みやび", "text": "そうや。\nその証拠に、私は標準語も\n話せるんだから。"},
        { "location": "253/TALK"  , "narrator": "つばめ", "text": "わわっ、本当だ！"},
        { "location": "254/TALK"  , "narrator": "みやび", "text": "今は方言キャラやき、\n標準語はここまでや。"},
        { "location": "256/TALK"  , "narrator": "みやび", "text": "ちなみに方言キャラの\n前は、超ぶりっ子キャラ\nだったんよ。"},
        { "location": "257/TALK"  , "narrator": "つばめ", "text": "ぶりっ子！？\nみやびさんが！？"},
        { "location": "259/TALK"  , "narrator": "みやび", "text": "その前はござる口調やった\nっけか…もう忘れてしも\nうたがな。"},
        { "location": "262/TALK"  , "narrator": "みやび", "text": "って、さすがにこれは\n言い過ぎたかもしれんな。"},
        { "location": "264/TALK"  , "narrator": "みやび", "text": "いくらつばめちゃんでも、\n冗談と気づいて…。"},
        { "location": "265/TALK"  , "narrator": "つばめ", "text": "そうだったんですかぁ…。"},
        { "location": "266/TALK"  , "narrator": "つばめ", "text": "次のキャラがどんなのに\nなるのか、楽しみにして\nいますね。"},
        { "location": "269/TALK"  , "narrator": "みやび", "text": "…つばめちゃん、\nうちの方言は、土佐弁や。"},
        { "location": "272/TALK"  , "narrator": "つばめ", "text": "土佐弁キャラ、って\nことですか？"},
        { "location": "274/TALK"  , "narrator": "みやび", "text": "…つばめちゃんがうちを\nどういう眼で見ちゅうか、\nちっくと気になるわ。"},
        { "location": "16/DIALOG" , "narrator": "Dialog_EventData", "text": "<color=green>5月24日　5:20 PM</color>\n5月も半ばを過ぎた頃、神楽坂トライナリーのバイト中。"},
        { "location": "285/DIALOG", "narrator": "Dialog_GEThimegoto_ch04", "text": "【ご当地方言少女】"}
    ]
}
