    "entry":
    [
        { "location": "1019/SCENARIO", "narrator": "", "text": "雨に濡れた野良猫みたいに"},
        { "location": "1046/SEL"     , "narrator": "", "text": "神楽"},
        { "location": "1047/ACT"     , "narrator": "", "text": "神楽"},
        { "location": "1051/TALK"    , "narrator": "神楽", "text": "何か御用ですか"},
        { "location": "1053/SEL"     , "narrator": "", "text": "ごめんなさい"},
        { "location": "1054/SEL"     , "narrator": "", "text": "納得いかない"},
        { "location": "1055/ACT"     , "narrator": "", "text": "ごめんなさい"},
        { "location": "1056/ACT"     , "narrator": "", "text": "納得いかない"},
        { "location": "1057/TALK"    , "narrator": "神楽", "text": "ですから、納得いかないのであればもう話しかけてこなくても結構ですので"},
        { "location": "1058/TALK"    , "narrator": "神楽", "text": "私にとって一番大事なのは自分の創作なんです"},
        { "location": "1059/TALK"    , "narrator": "神楽", "text": "如何なる理由でもそれを笑ったり貶したりする人とは一緒にいられません"},
        { "location": "1061/SEL"     , "narrator": "", "text": "そういうつもりじゃなかったんだよ"},
        { "location": "1062/SEL"     , "narrator": "", "text": "わかった"},
        { "location": "1063/ACT"     , "narrator": "", "text": "そういうつもりじゃなかったんだよ"},
        { "location": "1064/TALK"    , "narrator": "神楽", "text": "逆ギレしないで"},
        { "location": "1065/TALK"    , "narrator": "神楽", "text": "あなたがどう言ったかはここでは重要じゃない"},
        { "location": "1066/TALK"    , "narrator": "神楽", "text": "ていうかさ、会社とか学校とかでも同じような事やってない？"},
        { "location": "1067/TALK"    , "narrator": "神楽", "text": "相手の大事な何かを壊しておいて、そんなつもり無かったとか言ったり"},
        { "location": "1068/TALK"    , "narrator": "神楽", "text": "相手が真剣に何か話してるときにふざけたり"},
        { "location": "1069/TALK"    , "narrator": "神楽", "text": "知らなかったとか解らなかったじゃ済まされないことだってあるんだよ"},
        { "location": "1071/SEL"     , "narrator": "", "text": "いや、もういいです面倒くさい"},
        { "location": "1072/SEL"     , "narrator": "", "text": "すみません"},
        { "location": "1073/ACT"     , "narrator": "", "text": "いや、もういいです面倒くさい"},
        { "location": "1074/TALK"    , "narrator": "神楽", "text": "面倒くさいとかｗｗｗｗ"},
        { "location": "1075/TALK"    , "narrator": "神楽", "text": "お前から話しかけてきたんだろが"},
        { "location": "1076/TALK"    , "narrator": "神楽", "text": "面倒くさいのはこっちだわｗｗ"},
        { "location": "1077/TALK"    , "narrator": "神楽", "text": "そんなに自分の意図を通したいの？"},
        { "location": "1078/TALK"    , "narrator": "神楽", "text": "じゃあ私の気持ちは？"},
        { "location": "1079/TALK"    , "narrator": "神楽", "text": "自分がそんなじゃなかったんだってのを分かってもらって、かわいそうだったねーごめんねー、って言ってもらいたいの？"},
        { "location": "1080/TALK"    , "narrator": "神楽", "text": "じゃああのとき私が傷ついたのはどうなの？"},
        { "location": "1091/ACT"     , "narrator": "", "text": "すみません"},
        { "location": "1093/ACT"     , "narrator": "", "text": "わかった"},
        { "location": "1094/TALK"    , "narrator": "神楽", "text": "そういうわけですので、おやすみなさい"},
        { "location": "1107/TALK"    , "narrator": "神楽", "text": "反省した？"},
        { "location": "1109/SEL"     , "narrator": "", "text": "はい"},
        { "location": "1110/SEL"     , "narrator": "", "text": "むかつくわー"},
        { "location": "1111/ACT"     , "narrator": "", "text": "はい"},
        { "location": "1112/ACT"     , "narrator": "", "text": "むかつくわー"},
        { "location": "1113/TALK"    , "narrator": "神楽", "text": "いや、もういいです"},
        { "location": "1125/TALK"    , "narrator": "神楽", "text": "ボイメでも言ったけど、私にとって創作は命なの"},
        { "location": "1126/TALK"    , "narrator": "神楽", "text": "例えばさー、よく鬼嫁板とかで、夫のプラモ全部捨てたとか、カード売ってやったとかあるじゃん"},
        { "location": "1127/TALK"    , "narrator": "神楽", "text": "私ああいうのほんとクズだなって思うのね"},
        { "location": "1129/SEL"     , "narrator": "", "text": "あれむかつくよね！"},
        { "location": "1130/SEL"     , "narrator": "", "text": "はい"},
        { "location": "1131/ACT"     , "narrator": "", "text": "あれむかつくよね！"},
        { "location": "1132/TALK"    , "narrator": "神楽", "text": "お前が言うなクズ"},
        { "location": "1133/ACT"     , "narrator": "", "text": "はい"},
        { "location": "1135/TALK"    , "narrator": "神楽", "text": "何が大事かなんて、人それぞれだし、他人が理解出来ないのが当たり前なんだよ"},
        { "location": "1136/TALK"    , "narrator": "神楽", "text": "理解してもらえるのが奇跡なんであって"},
        { "location": "1137/TALK"    , "narrator": "神楽", "text": "だから、理解してくれる人と一緒にいられるってのがどんなに奇跡的なことなのか、ほんとよくそう思う"},
        { "location": "1138/TALK"    , "narrator": "神楽", "text": "私にとって、世界を作り込むってのはそういうことなの"},
        { "location": "1139/TALK"    , "narrator": "神楽", "text": "設定通りの人物になれなかったらダメなの"},
        { "location": "1140/TALK"    , "narrator": "神楽", "text": "私が自分の身体が貧相なのは自分が一番よく知ってるし、似合わない役柄があるのもわかってる"},
        { "location": "1141/TALK"    , "narrator": "神楽", "text": "けど、それが理由で自分の創作の幅を狭めたくないの"},
        { "location": "1142/TALK"    , "narrator": "神楽", "text": "貧乳しかいない世界ってヘンだと思わない？いや、思わないか"},
        { "location": "1143/TALK"    , "narrator": "神楽", "text": "理解出来ないと思うけど、それでもやりたいからやってるし、できる限りちゃんとその子になってあげたい"},
        { "location": "1144/TALK"    , "narrator": "神楽", "text": "もちろん、お客さんの中にもあなたと同じ事言う人は五万といるよ"},
        { "location": "1145/TALK"    , "narrator": "神楽", "text": "けどさー"},
        { "location": "1148/TALK"    , "narrator": "神楽", "text": "あなたにだけは言って欲しくなかった"},
        { "location": "1149/TALK"    , "narrator": "神楽", "text": "わかるかな、ここ"},
        { "location": "1151/SEL"     , "narrator": "", "text": "わかります、ごめんなさい"},
        { "location": "1152/SEL"     , "narrator": "", "text": "まあ、何となく"},
        { "location": "1153/ACT"     , "narrator": "", "text": "わかります、ごめんなさい"},
        { "location": "1154/TALK"    , "narrator": "神楽", "text": "心許してる人に言われるのって強烈だよね、ははは"},
        { "location": "1155/ACT"     , "narrator": "", "text": "まあ、何となく"},
        { "location": "1156/TALK"    , "narrator": "神楽", "text": "そんなものか"},
        { "location": "1158/TALK"    , "narrator": "神楽", "text": "まあでも、あなたもちょっとフザケタだけだろうし、わかってくれればいいよ"},
        { "location": "1159/TALK"    , "narrator": "神楽", "text": "けど、また創作貶したら次は別れるから、割とマジで"},
        { "location": "1161/SEL"     , "narrator": "", "text": "はい"},
        { "location": "1162/ACT"     , "narrator": "", "text": "はい"},
        { "location": "1164/TALK"    , "narrator": "神楽", "text": "あなたもいいんだよ？"},
        { "location": "1165/TALK"    , "narrator": "神楽", "text": "私がもしあなたにとって辛いこととか言ったら、別れるって選択肢だってあるし"},
        { "location": "1166/TALK"    , "narrator": "神楽", "text": "その時は、あなたのことを思って別れるから"},
        { "location": "1167/TALK"    , "narrator": "神楽", "text": "辛くなったら言って"},
        { "location": "1169/SEL"     , "narrator": "", "text": "はい"},
        { "location": "1170/SEL"     , "narrator": "", "text": "そんなことならないから"},
        { "location": "1171/ACT"     , "narrator": "", "text": "はい"},
        { "location": "1172/ACT"     , "narrator": "", "text": "そんなことならないから"},
        { "location": "1173/TALK"    , "narrator": "神楽", "text": "わからないでしょ、そんなの"},
        { "location": "1174/TALK"    , "narrator": "神楽", "text": "前にも言ったとおり、私には護りたいものがあるから"},
        { "location": "1175/TALK"    , "narrator": "神楽", "text": "それに牙を剥くようなら私はあなたをメチャクチャに壊して別れる"},
        { "location": "1176/TALK"    , "narrator": "神楽", "text": "それくらいの覚悟で、あなたに心を許してるから"},
        { "location": "1178/SEL"     , "narrator": "", "text": "わかった"},
        { "location": "1179/ACT"     , "narrator": "", "text": "わかった"},
        { "location": "1182/TALK"    , "narrator": "神楽", "text": "ぴょん"},
        { "location": "1183/TALK"    , "narrator": "神楽", "text": "じゃあ"},
        { "location": "1184/TALK"    , "narrator": "神楽", "text": "この件はこれでおしまい"},
        { "location": "1185/TALK"    , "narrator": "神楽", "text": "お詫びに今度ぴょんこに、ベトナム料理ごちそうしろください！！"},
        { "location": "1187/SEL"     , "narrator": "", "text": "もちろんです！"},
        { "location": "1188/SEL"     , "narrator": "", "text": "なんでベトナム料理？"},
        { "location": "1189/ACT"     , "narrator": "", "text": "もちろんです！"},
        { "location": "1190/TALK"    , "narrator": "神楽", "text": "ぴょんぴょん♪"},
        { "location": "1192/TALK"    , "narrator": "神楽", "text": "でも一緒に行けないのが残念。。"},
        { "location": "1193/ACT"     , "narrator": "", "text": "なんでベトナム料理？"},
        { "location": "1194/TALK"    , "narrator": "神楽", "text": "最近ハマってるのだぴょん"},
        { "location": "1195/TALK"    , "narrator": "神楽", "text": "いつか$handle$と行きたいなー"},
        { "location": "1196/TALK"    , "narrator": "神楽", "text": "その時はアオザイ着てみたいーーー"},
        { "location": "1198/TALK"    , "narrator": "神楽", "text": "ところでところで"},
        { "location": "1199/TALK"    , "narrator": "神楽", "text": "ぴょんこは$handle$への怒りに満ちあふれてる最中に、ちょっと詩を書いていたのだぴょん"},
        { "location": "1201/SEL"     , "narrator": "", "text": "見せて"},
        { "location": "1202/ACT"     , "narrator": "", "text": "見せて"},
        { "location": "1204/TALK"    , "narrator": "神楽", "text": "“この世界のぴょんこはまるで雨に濡れた野良猫”"},
        { "location": "1205/TALK"    , "narrator": "神楽", "text": "“おうちもごはんも愛も持ってないんだぴょん”"},
        { "location": "1206/TALK"    , "narrator": "神楽", "text": "“猫じゃなくてうさぎだけども”"},
        { "location": "1209/TALK"    , "narrator": "神楽", "text": "この世界のぴょんこはまるで雨に濡れた野良猫"},
        { "location": "1210/TALK"    , "narrator": "神楽", "text": "おうちもごはんも愛も持ってないんだぴょん"},
        { "location": "1211/TALK"    , "narrator": "神楽", "text": "猫じゃなくてうさぎだけども"},
        { "location": "1215/SEL"     , "narrator": "", "text": "$me$が全部あげるよ"},
        { "location": "1216/SEL"     , "narrator": "", "text": "二匹の猫として生きて行こうよ"},
        { "location": "1217/SEL"     , "narrator": "", "text": "神楽は世界を統べることができるはず"},
        { "location": "1218/ACT"     , "narrator": "", "text": "$me$が全部あげるよ"},
        { "location": "1219/TALK"    , "narrator": "神楽", "text": "そう言ってくれるのは$handle$だけ、、、"},
        { "location": "1220/ACT"     , "narrator": "", "text": "二匹の猫として生きて行こうよ"},
        { "location": "1221/TALK"    , "narrator": "神楽", "text": "その生活は"},
        { "location": "1223/TALK"    , "narrator": "神楽", "text": "無理かもナー"},
        { "location": "1224/ACT"     , "narrator": "", "text": "神楽は世界を統べることができるはず"},
        { "location": "1225/TALK"    , "narrator": "神楽", "text": "ぴょんこの中にはまだ目覚めぬ王としての資質が眠っている、、、"},
        { "location": "1226/TALK"    , "narrator": "神楽", "text": "目覚めよ！"},
        { "location": "1227/TALK"    , "narrator": "神楽", "text": "ぴょんこの真の力！！！"},
        { "location": "1228/TALK"    , "narrator": "神楽", "text": "って"},
        { "location": "1229/TALK"    , "narrator": "神楽", "text": "そういう話は"},
        { "location": "1230/TALK"    , "narrator": "神楽", "text": "また今度♪"},
        { "location": "1232/TALK"    , "narrator": "神楽", "text": "何も持たないぴょんこに$handle$は何をくれますか？？？"},
        { "location": "1234/SEL"     , "narrator": "", "text": "お金"},
        { "location": "1235/SEL"     , "narrator": "", "text": "あふれんばかりの愛を"},
        { "location": "1236/SEL"     , "narrator": "", "text": "$me$の全て"},
        { "location": "1237/ACT"     , "narrator": "", "text": "お金"},
        { "location": "1238/TALK"    , "narrator": "神楽", "text": "ノーマネーノーフューチャー！！！"},
        { "location": "1239/ACT"     , "narrator": "", "text": "あふれんばかりの愛を"},
        { "location": "1240/TALK"    , "narrator": "神楽", "text": "やだｽﾃｷ"},
        { "location": "1241/ACT"     , "narrator": "", "text": "$me$の全て"},
        { "location": "1242/TALK"    , "narrator": "神楽", "text": "戸籍から居住地から全て？"},
        { "location": "1243/TALK"    , "narrator": "神楽", "text": "なかなかに重い話♪"},
        { "location": "1245/TALK"    , "narrator": "神楽", "text": "$handle$がぴょんこにくれるっていったもの"},
        { "location": "1246/TALK"    , "narrator": "神楽", "text": "それはどうやってぴょんこに届けるの？"},
        { "location": "1248/SEL"     , "narrator": "", "text": "どうにかして"},
        { "location": "1249/SEL"     , "narrator": "", "text": "念波？？？"},
        { "location": "1250/SEL"     , "narrator": "", "text": "課金して"},
        { "location": "1251/SEL"     , "narrator": "", "text": "どうすればいいんだろ…"},
        { "location": "1252/ACT"     , "narrator": "", "text": "どうにかして"},
        { "location": "1253/TALK"    , "narrator": "神楽", "text": "ふんわりだな！！！"},
        { "location": "1254/ACT"     , "narrator": "", "text": "念波？？？"},
        { "location": "1255/TALK"    , "narrator": "神楽", "text": "ファーｗｗｗｗｗｗ"},
        { "location": "1257/TALK"    , "narrator": "神楽", "text": "こっちに聞くなし！"},
        { "location": "1258/ACT"     , "narrator": "", "text": "課金して"},
        { "location": "1259/TALK"    , "narrator": "神楽", "text": "生々しいﾅー"},
        { "location": "1260/TALK"    , "narrator": "神楽", "text": "大体どこに課金する気ｗｗｗｗ"},
        { "location": "1261/ACT"     , "narrator": "", "text": "どうすればいいんだろ…"},
        { "location": "1262/TALK"    , "narrator": "神楽", "text": "いや"},
        { "location": "1263/TALK"    , "narrator": "神楽", "text": "$handle$が決めるべきでは？？？"},
        { "location": "1265/TALK"    , "narrator": "神楽", "text": "$handle$はさー"},
        { "location": "1266/TALK"    , "narrator": "神楽", "text": "ぴょんこの恋人って自覚が薄くない？"},
        { "location": "1268/SEL"     , "narrator": "", "text": "そんなことないし！"},
        { "location": "1269/SEL"     , "narrator": "", "text": "ちょっとそうかもね…"},
        { "location": "1270/SEL"     , "narrator": "", "text": "少しはそう思わせてよ"},
        { "location": "1271/ACT"     , "narrator": "", "text": "そんなことないし！"},
        { "location": "1272/TALK"    , "narrator": "神楽", "text": "証明してよ"},
        { "location": "1273/ACT"     , "narrator": "", "text": "ちょっとそうかもね…"},
        { "location": "1274/TALK"    , "narrator": "神楽", "text": "こらこら"},
        { "location": "1275/TALK"    , "narrator": "神楽", "text": "そこは堂々と主張するところ！"},
        { "location": "1276/ACT"     , "narrator": "", "text": "少しはそう思わせてよ"},
        { "location": "1277/TALK"    , "narrator": "神楽", "text": "ぴょんこのせいなのかー"},
        { "location": "1279/TALK"    , "narrator": "神楽", "text": "ﾔﾀﾞﾓｰ人のせいにするなんて"},
        { "location": "1282/TALK"    , "narrator": "神楽", "text": "好きなんならさー"},
        { "location": "1283/TALK"    , "narrator": "神楽", "text": "好きって言うの"},
        { "location": "1284/TALK"    , "narrator": "神楽", "text": "当たり前でしょー"},
        { "location": "1285/TALK"    , "narrator": "神楽", "text": "違うかな？？？"},
        { "location": "1287/SEL"     , "narrator": "", "text": "好きだってば"},
        { "location": "1288/SEL"     , "narrator": "", "text": "これはちょっと違わないかな…"},
        { "location": "1289/SEL"     , "narrator": "", "text": "神楽は$me$のこと好きなの？"},
        { "location": "1290/ACT"     , "narrator": "", "text": "好きだってば"},
        { "location": "1291/TALK"    , "narrator": "神楽", "text": "ﾃｷﾄｰすぎない？"},
        { "location": "1292/ACT"     , "narrator": "", "text": "これはちょっと違わないかな…"},
        { "location": "1293/TALK"    , "narrator": "神楽", "text": "違わなくないでしょ"},
        { "location": "1294/TALK"    , "narrator": "神楽", "text": "じゃあどういうのが正しいの？"},
        { "location": "1295/ACT"     , "narrator": "", "text": "神楽は$me$のこと好きなの？"},
        { "location": "1298/TALK"    , "narrator": "神楽", "text": "好き"},
        { "location": "1299/TALK"    , "narrator": "神楽", "text": "あたりまえ"},
        { "location": "1300/TALK"    , "narrator": "神楽", "text": "好きだから"},
        { "location": "1302/TALK"    , "narrator": "神楽", "text": "ぴょんこは$handle$とｽｷｽｷﾁｭｯﾁｭってしたいだけなのに"},
        { "location": "1303/TALK"    , "narrator": "神楽", "text": "$handle$はそうじゃないのかなーって"},
        { "location": "1305/SEL"     , "narrator": "", "text": "したいに決まってる"},
        { "location": "1306/SEL"     , "narrator": "", "text": "本気で言ってくれてるのかなあ"},
        { "location": "1307/SEL"     , "narrator": "", "text": "ちゃんとここにいるでしょ"},
        { "location": "1308/ACT"     , "narrator": "", "text": "したいに決まってる"},
        { "location": "1309/TALK"    , "narrator": "神楽", "text": "でしょ？"},
        { "location": "1310/ACT"     , "narrator": "", "text": "本気で言ってくれてるのかなあ"},
        { "location": "1311/TALK"    , "narrator": "神楽", "text": "なんで疑うのかな？？？？？？"},
        { "location": "1312/ACT"     , "narrator": "", "text": "ちゃんとここにいるでしょ"},
