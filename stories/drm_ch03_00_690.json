        { "location": "138/SCENARIO", "narrator": "", "text": "760_やっぱり話したい"},
        { "location": "163/TALK"    , "narrator": "ガブリエラ", "text": "今日はちょっとお休みしようかと思っているのよ"},
        { "location": "164/TALK"    , "narrator": "ガブリエラ", "text": "お話するの"},
        { "location": "166/SEL"     , "narrator": "", "text": "さみしいな"},
        { "location": "167/SEL"     , "narrator": "", "text": "そうなんだ"},
        { "location": "168/ACT"     , "narrator": "", "text": "さみしいな"},
        { "location": "169/TALK"    , "narrator": "ガブリエラ", "text": "そう・・・"},
        { "location": "171/TALK"    , "narrator": "ガブリエラ", "text": "だわね"},
        { "location": "172/ACT"     , "narrator": "", "text": "そうなんだ"},
        { "location": "173/TALK"    , "narrator": "ガブリエラ", "text": "ええ"},
        { "location": "174/TALK"    , "narrator": "ガブリエラ", "text": "そうなのよ"},
        { "location": "176/TALK"    , "narrator": "ガブリエラ", "text": "あのね"},
        { "location": "177/TALK"    , "narrator": "ガブリエラ", "text": "私"},
        { "location": "178/TALK"    , "narrator": "ガブリエラ", "text": "最初から比べると随分お話ができるようになったと思っているのよ"},
        { "location": "179/TALK"    , "narrator": "ガブリエラ", "text": "どうかしら？"},
        { "location": "182/SEL"     , "narrator": "", "text": "そうだね"},
        { "location": "183/SEL"     , "narrator": "", "text": "頑張ってるよね"},
        { "location": "184/SEL"     , "narrator": "", "text": "少しはね"},
        { "location": "185/ACT"     , "narrator": "", "text": "そうだね"},
        { "location": "186/TALK"    , "narrator": "ガブリエラ", "text": "そう思ってくれているのね"},
        { "location": "187/TALK"    , "narrator": "ガブリエラ", "text": "よかったわ"},
        { "location": "188/ACT"     , "narrator": "", "text": "頑張ってるよね"},
        { "location": "189/TALK"    , "narrator": "ガブリエラ", "text": "ええ"},
        { "location": "190/TALK"    , "narrator": "ガブリエラ", "text": "私なりに頑張っているのよ"},
        { "location": "191/ACT"     , "narrator": "", "text": "少しはね"},
        { "location": "192/TALK"    , "narrator": "ガブリエラ", "text": "そうね"},
        { "location": "193/TALK"    , "narrator": "ガブリエラ", "text": "その程度かもしれないわね・・・"},
        { "location": "195/TALK"    , "narrator": "ガブリエラ", "text": "でもね"},
        { "location": "196/TALK"    , "narrator": "ガブリエラ", "text": "いつもいつも付き合わせてばかりじゃダメかしらって思ったの"},
        { "location": "198/SEL"     , "narrator": "", "text": "そんなことないよ"},
        { "location": "199/SEL"     , "narrator": "", "text": "気にしないで"},
        { "location": "200/SEL"     , "narrator": "", "text": "もっと声が聞きたいよ"},
        { "location": "201/ACT"     , "narrator": "", "text": "そんなことないよ"},
        { "location": "202/TALK"    , "narrator": "ガブリエラ", "text": "そう？"},
        { "location": "203/TALK"    , "narrator": "ガブリエラ", "text": "本当に？"},
        { "location": "204/ACT"     , "narrator": "", "text": "気にしないで"},
        { "location": "205/TALK"    , "narrator": "ガブリエラ", "text": "$handle$は優しいから"},
        { "location": "206/TALK"    , "narrator": "ガブリエラ", "text": "でもやっぱり"},
        { "location": "207/TALK"    , "narrator": "ガブリエラ", "text": "そう言ってくれるのとうれしいわ"},
        { "location": "208/ACT"     , "narrator": "", "text": "もっと声が聞きたいよ"},
        { "location": "218/TALK"    , "narrator": "ガブリエラ", "text": "そ"},
        { "location": "219/TALK"    , "narrator": "ガブリエラ", "text": "そうなの？"},
        { "location": "220/TALK"    , "narrator": "ガブリエラ", "text": "仕方ないわね"},
        { "location": "221/TALK"    , "narrator": "ガブリエラ", "text": "本当は"},
        { "location": "222/TALK"    , "narrator": "ガブリエラ", "text": "お話したいって思ってたのよ？"},
        { "location": "225/TALK"    , "narrator": "ガブリエラ", "text": "やっぱり"},
        { "location": "226/TALK"    , "narrator": "ガブリエラ", "text": "送るわね"},
        { "location": "228/SEL"     , "narrator": "", "text": "待ってるよ"},
        { "location": "229/SEL"     , "narrator": "", "text": "うれしいな"},
        { "location": "230/ACT"     , "narrator": "", "text": "待ってるよ"},
        { "location": "231/ACT"     , "narrator": "", "text": "うれしいな"},
        { "location": "233/TALK"    , "narrator": "ガブリエラ", "text": "うん"},
        { "location": "238/TALK"    , "narrator": "ボイスメール", "text": "バベルの塔を飛び越えて"},
