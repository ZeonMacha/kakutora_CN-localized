        { "location": "130/TALK"  , "narrator": "ガブリエラ", "text": "じゃあ取りなさいよ。\n止まらなくてうるさいし。"},
        { "location": "132/TALK"  , "narrator": "アーヤ", "text": "はぁ…。"},
