    "entry":
    [
        { "location": "7/SCENARIO", "narrator": "", "text": "サークルぐるぐる"},
        { "location": "18/TALK"   , "narrator": "ガブリエラ", "text": "…そういえば、\n次はいつなの？"},
        { "location": "20/TALK"   , "narrator": "アーヤ", "text": "？　何の話？"},
        { "location": "21/TALK"   , "narrator": "ガブリエラ", "text": "ボランティアよ。\nほら、アーヤの人形劇。"},
        { "location": "22/TALK"   , "narrator": "アーヤ", "text": "何？　もしかして、\nまた手伝ってくれるの\nかしら？"},
        { "location": "23/TALK"   , "narrator": "ガブリエラ", "text": "それはお断り。"},
        { "location": "24/TALK"   , "narrator": "ガブリエラ", "text": "前はタダ働きさせられたん\nだから、次は観客として\n行くつもりよ。"},
        { "location": "25/TALK"   , "narrator": "アーヤ", "text": "園児に混ざってまで\n見る必要ないでしょ？"},
        { "location": "26/TALK"   , "narrator": "アーヤ", "text": "っていうか、そんなに\n興味あるの？"},
        { "location": "27/TALK"   , "narrator": "ガブリエラ", "text": "きょ、興味があるから、\nってわけじゃないわ。"},
        { "location": "28/TALK"   , "narrator": "ガブリエラ", "text": "ただ、どんな感じの\n劇なのか、見てみようと\n思っただけよ。"},
        { "location": "29/TALK"   , "narrator": "アーヤ", "text": "…興味がある、ってこと\nじゃないの、それ？"},
        { "location": "30/TALK"   , "narrator": "ガブリエラ", "text": "とにかく、働いたんだから\n一回は見せてもらうわ。"},
        { "location": "31/TALK"   , "narrator": "ガブリエラ", "text": "だから、次の劇の予定を\n教えなさいよ。"},
        { "location": "33/TALK"   , "narrator": "アーヤ", "text": "…………。"},
        { "location": "35/TALK"   , "narrator": "ガブリエラ", "text": "何よ、言えないの？"},
        { "location": "36/TALK"   , "narrator": "アーヤ", "text": "…仕方ないでしょ。\n決まってないんだし。"},
        { "location": "37/TALK"   , "narrator": "ガブリエラ", "text": "え？　そうなの？"},
        { "location": "38/TALK"   , "narrator": "アーヤ", "text": "ええ…。"},
        { "location": "40/TALK"   , "narrator": "アーヤ", "text": "もしかしたら、\nもうやらないかも\nしれないし…。"},
        { "location": "41/TALK"   , "narrator": "ガブリエラ", "text": "えっ！？\nど、どうしてよ？"},
        { "location": "42/TALK"   , "narrator": "アーヤ", "text": "どうしても何も、\nわかるでしょ？"},
        { "location": "43/TALK"   , "narrator": "アーヤ", "text": "ここ最近、トライナリーの\n仕事も忙しくなってきて、\n時間が取れないのよ。"},
        { "location": "45/TALK"   , "narrator": "アーヤ", "text": "このままじゃ、せっかくの\n劇も中途半端なものに\nなっちゃうし――"},
        { "location": "47/TALK"   , "narrator": "アーヤ", "text": "そうなるくらいなら、\nやめた方がいいかも、\nって考え中なのよ…。"},
        { "location": "48/TALK"   , "narrator": "ガブリエラ", "text": "…そうなんだ。"},
        { "location": "49/TALK"   , "narrator": "アーヤ", "text": "…まあ、それだけが\n理由じゃないけど、\n色々あるのよ。"},
        { "location": "50/TALK"   , "narrator": "ガブリエラ", "text": "…ちょっと残念かも。"},
        { "location": "51/TALK"   , "narrator": "アーヤ", "text": "悪いわね。\nちゃんと見せてあげられ\nなくて。"},
        { "location": "52/TALK"   , "narrator": "ガブリエラ", "text": "それはいいんだけど、\nアーヤが…。"},
        { "location": "53/TALK"   , "narrator": "アーヤ", "text": "？"},
        { "location": "54/TALK"   , "narrator": "ガブリエラ", "text": "…何でもない。"},
        { "location": "55/TALK"   , "narrator": "ガブリエラ", "text": "まあ、続けられそうなら\n続ければいいんじゃない？"},
        { "location": "56/TALK"   , "narrator": "アーヤ", "text": "…そうね。"},
        { "location": "57/SEL"    , "narrator": "", "text": "忙しいんだね"},
        { "location": "58/SEL"    , "narrator": "", "text": "何かあったの？"},
        { "location": "59/SEL"    , "narrator": "", "text": "その分$me$と遊ぼうよ"},
        { "location": "60/ACT"    , "narrator": "", "text": "忙しいんだね"},
        { "location": "64/TALK"   , "narrator": "アーヤ", "text": "…………。"},
        { "location": "65/SEL"    , "narrator": "", "text": "アーヤ？"},
        { "location": "66/ACT"    , "narrator": "", "text": "アーヤ？"},
        { "location": "71/TALK"   , "narrator": "アーヤ", "text": "…………。"},
        { "location": "72/SEL"    , "narrator": "", "text": "おーい"},
        { "location": "73/ACT"    , "narrator": "", "text": "おーい"},
        { "location": "78/TALK"   , "narrator": "ガブリエラ", "text": "…アーヤ。\n鳴ってるわよ。"},
        { "location": "79/TALK"   , "narrator": "アーヤ", "text": "…わかってるわよ。"},
        { "location": "80/TALK"   , "narrator": "ガブリエラ", "text": "じゃあ取りなさいよ。\n止まらなくてうるさいし。"},
        { "location": "82/TALK"   , "narrator": "アーヤ", "text": "はぁ…。"},
        { "location": "91/TALK"   , "narrator": "アーヤ", "text": "なに？"},
        { "location": "92/TALK"   , "narrator": "アーヤ", "text": "今外なんだけど？"},
        { "location": "94/SEL"    , "narrator": "", "text": "忙しいんだね"},
        { "location": "95/ACT"    , "narrator": "", "text": "忙しいんだね"},
        { "location": "97/TALK"   , "narrator": "アーヤ", "text": "そうね"},
        { "location": "98/TALK"   , "narrator": "アーヤ", "text": "じゃあ"},
        { "location": "105/TALK"  , "narrator": "ガブリエラ", "text": "…え？\nもう終わりなの？"},
        { "location": "106/TALK"  , "narrator": "アーヤ", "text": "ええ…大した用事じゃ\nなかったし。"},
        { "location": "107/TALK"  , "narrator": "ガブリエラ", "text": "…………。"},
        { "location": "109/TALK"  , "narrator": "ガブリエラ", "text": "…やっぱり、\n落ち込んでるのかしら？"},
        { "location": "110/ACT"   , "narrator": "", "text": "何かあったの？"},
