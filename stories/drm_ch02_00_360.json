        { "location": "142/TALK"  , "narrator": "アーヤ", "text": "今外なんだけど？"},
        { "location": "144/SEL"   , "narrator": "", "text": "何かあったの？"},
        { "location": "145/ACT"   , "narrator": "", "text": "何かあったの？"},
        { "location": "147/TALK"  , "narrator": "アーヤ", "text": "別に"},
        { "location": "148/TALK"  , "narrator": "アーヤ", "text": "何もないわ"},
        { "location": "149/TALK"  , "narrator": "アーヤ", "text": "ギャヴィに言った通りよ"},
        { "location": "150/TALK"  , "narrator": "アーヤ", "text": "それだけだから"},
        { "location": "152/SEL"   , "narrator": "", "text": "彼氏じゃないと言えない？"},
        { "location": "153/ACT"   , "narrator": "", "text": "彼氏じゃないと言えない？"},
        { "location": "156/TALK"  , "narrator": "アーヤ", "text": "違う"},
        { "location": "157/TALK"  , "narrator": "アーヤ", "text": "そういうんじゃないけど"},
        { "location": "159/TALK"  , "narrator": "アーヤ", "text": "本当"},
        { "location": "160/TALK"  , "narrator": "アーヤ", "text": "何でもないから"},
        { "location": "169/TALK"  , "narrator": "アーヤ", "text": "はぁ…。"},
        { "location": "170/TALK"  , "narrator": "ガブリエラ", "text": "…こんなに落ち込んでる\nアーヤ、初めて見たわ。"},
        { "location": "171/TALK"  , "narrator": "ガブリエラ", "text": "何とかいい形で、解決して\nくれればいいんだけど…。"},
        { "location": "172/ACT"   , "narrator": "", "text": "その分$me$と遊ぼうよ"},
