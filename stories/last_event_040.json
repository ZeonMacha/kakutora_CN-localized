{
    "dir": "chap40/daydra/last_event_040.js",
    "type": "",
    "info": {
        "story_id": "12205",
        "cid": "",
        "title": "ラストストーリー",
        "sub_title": "みやびより～海の向こうに"
    },
    "entry":
    [
        { "location": "22/TALK"   , "narrator": "みやび", "text": "やれやれ、平和に\nなろうと学校は\nなくならず、か…。"},
        { "location": "23/TALK"   , "narrator": "みやび", "text": "ＰＣだけ触ってれば\nえい世界の実現は\nしないんか？"},
        { "location": "24/SEL"    , "narrator": "（選択肢）", "text": "相変わらずで安心したよ"},
        { "location": "25/ACT"    , "narrator": "", "text": "相変わらずで安心したよ"},
        { "location": "27/TALK"   , "narrator": "みやび", "text": "…………。"},
        { "location": "28/TALK"   , "narrator": "みやび", "text": "わかった、なにも\n言わんでえい。"},
        { "location": "29/TALK"   , "narrator": "みやび", "text": "部屋に帰るまで、\nちくっとお口に\nチャックで頼むぞね。"},
        { "location": "44/TALK"   , "narrator": "透明みやび", "text": "…さて。"},
        { "location": "45/TALK"   , "narrator": "透明みやび", "text": "相棒、とうとう\n脱WAVEしたが？"},
        { "location": "46/SEL"    , "narrator": "（選択肢）", "text": "なんでわかったの！？"},
        { "location": "47/ACT"    , "narrator": "", "text": "なんでわかったの！？"},
        { "location": "49/TALK"   , "narrator": "透明みやび", "text": "こんな日が来ることも\nあるやろうと、前から\n思うちょったきね。"},
        { "location": "50/TALK"   , "narrator": "透明みやび", "text": "…で、なんで突然\nこんなコトできるよう\nなったが？"},
        { "location": "51/SEL"    , "narrator": "（選択肢）", "text": "ライフギャザーを掌握して、無敵になったからだよ"},
        { "location": "52/ACT"    , "narrator": "", "text": "ライフギャザーを掌握して、無敵になったからだよ"},
        { "location": "54/TALK"   , "narrator": "透明みやび", "text": "相棒がチート化した\nっちゅうことか…。"},
        { "location": "55/TALK"   , "narrator": "透明みやび", "text": "まあ、無敵になった\n言うても本人がここに\n来られん辺り…。"},
        { "location": "56/TALK"   , "narrator": "透明みやび", "text": "無敵もそれなりに\n制約あるっちゅう\nことなんやろうね。"},
        { "location": "57/SEL"    , "narrator": "（選択肢）", "text": "スマホ見なくても会話できるよ？"},
        { "location": "58/SEL"    , "narrator": "（選択肢）", "text": "もしかしてゲーム中？"},
        { "location": "59/ACT"    , "narrator": "", "text": "スマホ見なくても会話できるよ？"},
        { "location": "60/TALK"   , "narrator": "透明みやび", "text": "うむ、なのでスマホ\n弄る片手間に\n話しちゅうき。"},
        { "location": "61/ACT"    , "narrator": "", "text": "もしかしてゲーム中？"},
        { "location": "62/TALK"   , "narrator": "透明みやび", "text": "うむ、昨日作った\nアプリゲーのテスト\nしちゅうがよ。"},
        { "location": "63/TALK"   , "narrator": "透明みやび", "text": "けんど、思うちょったより\nクソゲーになってもうた。"},
        { "location": "65/SEL"    , "narrator": "（選択肢）", "text": "想いを伝え合えるようになったの、嬉しくない？"},
        { "location": "66/ACT"    , "narrator": "", "text": "想いを伝え合えるようになったの、嬉しくない？"},
        { "location": "69/TALK"   , "narrator": "透明みやび", "text": "いやいや、まっこと\n嬉しい思うちょるよ。"},
        { "location": "70/TALK"   , "narrator": "透明みやび", "text": "文字打つのも苦では\nないがやけんど…。"},
        { "location": "71/TALK"   , "narrator": "透明みやび", "text": "想いを伝える方が、\n感情が伝わる気もするし。"},
        { "location": "73/SEL"    , "narrator": "（選択肢）", "text": "やっぱり、みやびは相変わらずだね"},
        { "location": "74/ACT"    , "narrator": "", "text": "やっぱり、みやびは相変わらずだね"},
        { "location": "78/TALK"   , "narrator": "透明みやび", "text": "…$handle$、\nさっきもそれ言うた\nけんど、気付かんが？"},
        { "location": "79/TALK"   , "narrator": "透明みやび", "text": "うち、自分では結構\n変わった思っちゅうが\nやけんど…。"},
        { "location": "81/TALK"   , "narrator": "透明みやび", "text": "…相棒、さっきも\nそれ言うたけんど…。"},
        { "location": "82/TALK"   , "narrator": "透明みやび", "text": "うち、これでも結構\n変わっちょるがよ？"},
        { "location": "85/TALK"   , "narrator": "透明みやび", "text": "昔…、いや、そこまで\n昔の話ではないが――"},
        { "location": "86/TALK"   , "narrator": "透明みやび", "text": "相棒と初めて会うた\n頃より、キャラ付けは\nせんようになったし。"},
        { "location": "87/SEL"    , "narrator": "（選択肢）", "text": "一日中ウソツイートしたりとかしてたよね"},
        { "location": "88/SEL"    , "narrator": "（選択肢）", "text": "元からキャラ作りしてるようにも見えなかった"},
        { "location": "89/SEL"    , "narrator": "（選択肢）", "text": "あの頃のみやびも可愛かった"},
        { "location": "90/ACT"    , "narrator": "", "text": "一日中ウソツイートしたりとかしてたよね"},
        { "location": "92/TALK"   , "narrator": "透明みやび", "text": "今もしちゅうよ？\n絶賛夕食作り中、とな。"},
        { "location": "93/TALK"   , "narrator": "透明みやび", "text": "けんど、それで一度\nツッコミもらったこと\nあったなぁ。"},
        { "location": "94/ACT"    , "narrator": "", "text": "元からキャラ作りしてるようにも見えなかった"},
        { "location": "96/TALK"   , "narrator": "透明みやび", "text": "それはそれで\nうちをどういう目で\n見ていたのかという。"},
        { "location": "97/TALK"   , "narrator": "透明みやび", "text": "…まあえい。\n相棒が鈍感っちゅう\nのはわかっちゅうき。"},
        { "location": "98/ACT"    , "narrator": "", "text": "あの頃のみやびも可愛かった"},
        { "location": "100/TALK"  , "narrator": "透明みやび", "text": "そうやろ？\nあれはあれで人気出る\n思うちょったきね。"},
        { "location": "101/TALK"  , "narrator": "透明みやび", "text": "ニッチな需要は\n間違いなく存在するき。"},
        { "location": "104/TALK"  , "narrator": "透明みやび", "text": "…まあ、うちとの\n付き合いも、もはや\n短くはないわけやし――"},
        { "location": "105/TALK"  , "narrator": "透明みやび", "text": "うちのことは大抵\nわかっちゅうろう？"},
        { "location": "106/TALK"  , "narrator": "透明みやび", "text": "こういう時のうちは、\n結構混乱しゆうがよ。"},
        { "location": "107/SEL"   , "narrator": "（選択肢）", "text": "似たようなことあったよね"},
        { "location": "108/SEL"   , "narrator": "（選択肢）", "text": "だから素直なんだね"},
        { "location": "109/ACT"   , "narrator": "", "text": "似たようなことあったよね"},
        { "location": "111/TALK"  , "narrator": "透明みやび", "text": "あったろうか？\n覚えないけんど…。"},
        { "location": "112/SEL"   , "narrator": "（選択肢）", "text": "横須賀で繭にワガママ沢山言った"},
        { "location": "113/ACT"   , "narrator": "", "text": "横須賀で繭にワガママ沢山言った"},
        { "location": "116/TALK"  , "narrator": "透明みやび", "text": "うっわ、マイベスト\n恥ずかしエピソード\nやぞ、それ！？"},
        { "location": "118/TALK"  , "narrator": "透明みやび", "text": "いや…マイベストは\n$handle$と\n付き合うた時か…。"},
        { "location": "119/TALK"  , "narrator": "透明みやび", "text": "いやいや、あれは\nハピハピエピソード\nというべきか…。"},
        { "location": "120/TALK"  , "narrator": "透明みやび", "text": "…しまった。\n恥ずかしエピソードを\n更新してしもうた…。"},
        { "location": "122/TALK"  , "narrator": "透明みやび", "text": "しかし、そんなことも\nあったなぁ…。"},
        { "location": "123/TALK"  , "narrator": "透明みやび", "text": "まあ、うちにも弱い\n部分はあるっちゅう\nことや。"},
        { "location": "125/ACT"   , "narrator": "", "text": "だから素直なんだね"},
        { "location": "127/TALK"  , "narrator": "透明みやび", "text": "…まあ、確かに今も\n混乱しちゅう。"},
        { "location": "130/TALK"  , "narrator": "透明みやび", "text": "今まで文字でしか\n会話できんかった\n$handle$と…。"},
        { "location": "131/TALK"  , "narrator": "透明みやび", "text": "こうして、\n想いを伝え合えるように\nなったき。"},
        { "location": "132/TALK"  , "narrator": "透明みやび", "text": "嬉しさのあまり、\n混乱くらいして\n当然やろ？"},
        { "location": "133/TALK"  , "narrator": "透明みやび", "text": "…うむ、やはりまだ\n混乱継続中やな。"},
        { "location": "136/TALK"  , "narrator": "透明みやび", "text": "急に相棒と、\n想いを伝え合えるように\nなったき。"},
        { "location": "137/TALK"  , "narrator": "透明みやび", "text": "微塵も混乱せずに\nおられるはずが\nなかろう？"},
        { "location": "141/TALK"  , "narrator": "透明みやび", "text": "…しっかし、今にして\n思えば…。"},
        { "location": "143/TALK"  , "narrator": "透明みやび", "text": "$handle$には\nうちの色んな姿を\n見られてきたが…。"},
        { "location": "144/TALK"  , "narrator": "透明みやび", "text": "$handle$の\nそういう姿は\n見たことがないな。"},
        { "location": "146/TALK"  , "narrator": "透明みやび", "text": "相棒にはうちの\n色んな姿を見せてきた\nように思うが…。"},
        { "location": "147/TALK"  , "narrator": "透明みやび", "text": "相棒のそういう姿は\n見たことがないな。"},
        { "location": "149/SEL"   , "narrator": "（選択肢）", "text": "伝わってるだろう？"},
        { "location": "150/SEL"   , "narrator": "（選択肢）", "text": "見せたくても見せられないし…"},
        { "location": "151/ACT"   , "narrator": "", "text": "伝わってるだろう？"},
        { "location": "152/TALK"  , "narrator": "透明みやび", "text": "残念やけんど、\nそういうのは\n伝わってきちょらん。"},
        { "location": "153/TALK"  , "narrator": "透明みやび", "text": "相棒がうちに対して\nどういう気持ちを\n抱いちゅうか――"},
        { "location": "154/TALK"  , "narrator": "透明みやび", "text": "そういうのであれば、\n時々感じた気もした\nけんどな。"},
        { "location": "155/ACT"   , "narrator": "", "text": "見せたくても見せられないし…"},
        { "location": "156/TALK"  , "narrator": "透明みやび", "text": "…まあ、今までは\nお前さんの影も形も\nなかったわけやしなぁ…。"},
        { "location": "159/TALK"  , "narrator": "透明みやび", "text": "しかし、こうして\n想いが伝わるように\nなったき。"},
        { "location": "160/TALK"  , "narrator": "透明みやび", "text": "この調子でいけば、\n次は姿が見えるように\nなるがやないか？"},
        { "location": "161/TALK"  , "narrator": "透明みやび", "text": "自称無敵になった\n相棒なら、可能やろう？"},
        { "location": "162/SEL"   , "narrator": "（選択肢）", "text": "できればいいんだけど…"},
        { "location": "163/SEL"   , "narrator": "（選択肢）", "text": "なるほど、可能性はあるかも"},
        { "location": "164/ACT"   , "narrator": "", "text": "できればいいんだけど…"},
        { "location": "166/TALK"  , "narrator": "透明みやび", "text": "ここまでできたのに、\nそれはできんのか？"},
        { "location": "167/TALK"  , "narrator": "透明みやび", "text": "…なんぞ、\nテンションだだ下がり\nぞね。"},
        { "location": "168/ACT"   , "narrator": "", "text": "なるほど、可能性はあるかも"},
        { "location": "171/TALK"  , "narrator": "透明みやび", "text": "かも…？\nもしかして\n$handle$も…。"},
        { "location": "172/TALK"  , "narrator": "透明みやび", "text": "あんましよくは\nわかっちょらん\nっちゅうことか？"},
        { "location": "173/TALK"  , "narrator": "透明みやび", "text": "…だとすると、\n期待薄なのかも\nしれんなぁ…。"},
        { "location": "175/TALK"  , "narrator": "透明みやび", "text": "かも…？\n相棒もあんましよく\nわかっちょらんのか。"},
        { "location": "176/TALK"  , "narrator": "透明みやび", "text": "ふむ…だとすると、\n期待薄っちゅうこと\nかもしれんなぁ。"},
        { "location": "179/SEL"   , "narrator": "（選択肢）", "text": "そうなってくれたらいいと思った？"},
        { "location": "180/ACT"   , "narrator": "", "text": "そうなってくれたらいいと思った？"},
        { "location": "183/TALK"  , "narrator": "透明みやび", "text": "当然やろ？"},
        { "location": "186/TALK"  , "narrator": "透明みやび", "text": "長い時間一緒にいて、\n結婚までしたっちゅうに。"},
        { "location": "188/TALK"  , "narrator": "透明みやび", "text": "長い時間一緒にいて、\n恋人にもなった\nっちゅうに…。"},
        { "location": "190/TALK"  , "narrator": "透明みやび", "text": "顔も知らんままで\n平気でいられると\n思うか？"},
        { "location": "191/TALK"  , "narrator": "透明みやび", "text": "寂しいと思うくらい、\n普通やないか…。"},
        { "location": "192/TALK"  , "narrator": "透明みやび", "text": "…うむ、そうや。\n寂しい…。\nうちの本音や。"},
        { "location": "194/TALK"  , "narrator": "透明みやび", "text": "うちらは今まで、\nそれなりに長い時間を\n共に過ごしてきた。"},
        { "location": "195/TALK"  , "narrator": "透明みやび", "text": "まあ、友人よりも\nちくっと先には\n進んでおろう。"},
        { "location": "196/TALK"  , "narrator": "透明みやび", "text": "なのに、顔も知らん\nっちゅうのは…、\nなんちゅうか…。"},
        { "location": "197/TALK"  , "narrator": "透明みやび", "text": "むず痒い。\nうむ、むず痒い気に\nなるちや。"},
        { "location": "199/TALK"  , "narrator": "透明みやび", "text": "相棒は違うんか？"},
        { "location": "200/SEL"   , "narrator": "（選択肢）", "text": "$me$も同じだよ"},
        { "location": "201/ACT"   , "narrator": "", "text": "$me$も同じだよ"},
        { "location": "205/TALK"  , "narrator": "透明みやび", "text": "…愚問やったな。\n聞くまでもないこと\n聞いてしもた。"},
        { "location": "206/TALK"  , "narrator": "透明みやび", "text": "$handle$が\nうちと同じ気持ちで\nおることくらい――"},
        { "location": "208/TALK"  , "narrator": "透明みやび", "text": "夫婦やきね、\nわかっちゅうよ。"},
        { "location": "210/TALK"  , "narrator": "透明みやび", "text": "恋人やきね、\nわかっちゅうよ。"},
        { "location": "213/TALK"  , "narrator": "透明みやび", "text": "そうやろ？"},
        { "location": "214/TALK"  , "narrator": "透明みやび", "text": "さすがに、それくらい\nうちにもわかるぞね。"},
        { "location": "216/TALK"  , "narrator": "透明みやび", "text": "…まあ、こうして\n想いが伝わるように\nなったき。"},
        { "location": "217/TALK"  , "narrator": "透明みやび", "text": "いつか、本当に姿が\n見えるようになる日が\n来る可能性も…。"},
        { "location": "218/TALK"  , "narrator": "透明みやび", "text": "…………。"},
        { "location": "220/TALK"  , "narrator": "透明みやび", "text": "いや、あんまし\nこういう話はせん方が\nえいかもしれんな。"},
        { "location": "221/TALK"  , "narrator": "透明みやび", "text": "なんや、ほら…、\nこういう希望に満ちた\n会話をしゆうと…。"},
        { "location": "222/TALK"  , "narrator": "透明みやび", "text": "フラグっぽい感じに\n思えるやろ？"},
        { "location": "223/TALK"  , "narrator": "透明みやび", "text": "それも、悪い方のな。"},
        { "location": "224/TALK"  , "narrator": "透明みやび", "text": "…そんなことに\nなったりせんよな？"},
        { "location": "225/SEL"   , "narrator": "（選択肢）", "text": "そうならないでほしい"},
        { "location": "226/SEL"   , "narrator": "（選択肢）", "text": "なって堪るか！"},
        { "location": "227/ACT"   , "narrator": "", "text": "そうならないでほしい"},
        { "location": "228/TALK"  , "narrator": "透明みやび", "text": "…相棒も、願うこと\nしかできんのか。"},
        { "location": "229/TALK"  , "narrator": "透明みやび", "text": "やはり、相棒は\nあんまし無敵っちゅう\nわけやなさそうや。"},
        { "location": "231/TALK"  , "narrator": "透明みやび", "text": "…まあ、相棒は\nそれくらいがえいよ。"},
        { "location": "232/TALK"  , "narrator": "透明みやび", "text": "その方が、相棒らしい\n感じするきね。"},
        { "location": "233/ACT"   , "narrator": "", "text": "なって堪るか！"},
        { "location": "236/TALK"  , "narrator": "透明みやび", "text": "…予想以上の反応に、\nちくっと驚いたぞね。"},
        { "location": "237/TALK"  , "narrator": "透明みやび", "text": "けんど、それだけ\n$handle$も…。"},
        { "location": "238/TALK"  , "narrator": "透明みやび", "text": "うちと離れたくないと\n思っちゅう証拠か。"},
        { "location": "239/TALK"  , "narrator": "透明みやび", "text": "…いかん、ニヤニヤ\nしてしまうぞね。"},
        { "location": "240/TALK"  , "narrator": "透明みやび", "text": "今、あんましうちの顔\n見たらいかんよ？"},
        { "location": "242/TALK"  , "narrator": "透明みやび", "text": "おおっ…、そんなに\n強く言われるとは\n思わんかったぞね。"},
        { "location": "243/TALK"  , "narrator": "透明みやび", "text": "…相棒も、そんな\n終わり方は嫌やと\n思っちゅうが？"},
        { "location": "244/TALK"  , "narrator": "透明みやび", "text": "ふむ…なるほど。\n悪い気はせんね。"},
        { "location": "248/TALK"  , "narrator": "透明みやび", "text": "…まあ、どちらにせよ\nせっかく脱WAVEした\nわけやしね。"},
        { "location": "249/TALK"  , "narrator": "透明みやび", "text": "今までずっと、言葉にして\n伝えたかったことを、\n今こそ言うとしよう。"},
        { "location": "251/TALK"  , "narrator": "透明みやび", "text": "ありがとな。"},
        { "location": "252/SEL"   , "narrator": "（選択肢）", "text": "どういうこと？"},
        { "location": "253/ACT"   , "narrator": "", "text": "どういうこと？"},
        { "location": "255/TALK"  , "narrator": "透明みやび", "text": "今まで色々と世話に\nなった礼やよ。"},
        { "location": "256/TALK"  , "narrator": "透明みやび", "text": "やはり、こういうんは\n言葉にして伝えるんが\n一番やと思うてな。"},
        { "location": "257/TALK"  , "narrator": "透明みやび", "text": "チャットよりも、\nこっちの方がえいろう？"},
        { "location": "258/TALK"  , "narrator": "透明みやび", "text": "…って、デジタル\n人間のうちが言うのも\n変な話か。"},
        { "location": "259/SEL"   , "narrator": "（選択肢）", "text": "嬉しいよ、ありがとう"},
        { "location": "260/ACT"   , "narrator": "", "text": "嬉しいよ、ありがとう"},
        { "location": "275/TALK"  , "narrator": "みやび", "text": "…ゆうてよかった。"},
        { "location": "277/TALK"  , "narrator": "みやび", "text": "けんど、改めて\nこういう話するんは\n恥ずかしいね。"},
        { "location": "278/TALK"  , "narrator": "みやび", "text": "やはり、うちらには\nこういう話は\n似合わんき。"},
        { "location": "279/TALK"  , "narrator": "みやび", "text": "…まあ、たまには\nこういう日も必要なの\nかもしれんけんど。"},
        { "location": "282/TALK"  , "narrator": "みやび", "text": "夫婦なんやし、\nこの手のちくっと\n照れくさい会話は…。"},
        { "location": "284/TALK"  , "narrator": "みやび", "text": "恋人なんやし、\nこの手のちくっと\n照れくさい会話は…。"},
        { "location": "286/TALK"  , "narrator": "みやび", "text": "倦怠期解消のためにも\n必要不可欠であろう。"},
        { "location": "287/TALK"  , "narrator": "みやび", "text": "っちゅうわけやき、\n恥ずかしついでに\nもう一つ言うが…。"},
        { "location": "288/TALK"  , "narrator": "みやび", "text": "これからも、\nずっとうちと一緒に\nいてくれるか？"},
        { "location": "290/TALK"  , "narrator": "みやび", "text": "…言うておくけんど、\nこうして今までの\n礼を言うたんは…。"},
        { "location": "291/TALK"  , "narrator": "みやび", "text": "これでお別れとか、\nそういうフラグを\n恐れてではないがよ？"},
        { "location": "292/TALK"  , "narrator": "みやび", "text": "うちが、ずーっと\n言葉で伝えたかった\nから言うただけや。"},
        { "location": "293/TALK"  , "narrator": "みやび", "text": "やき、これからも\nうちと一緒にいて\nくれるか？"},
        { "location": "295/SEL"   , "narrator": "（選択肢）", "text": "もちろんだよ"},
        { "location": "296/SEL"   , "narrator": "（選択肢）", "text": "実はみやびに伝えなければならないことがある"},
        { "location": "297/ACT"   , "narrator": "", "text": "もちろんだよ"},
        { "location": "299/TALK"  , "narrator": "みやび", "text": "うむ。えい返事や。"},
        { "location": "300/TALK"  , "narrator": "みやび", "text": "ほな、またな。"},
        { "location": "302/ACT"   , "narrator": "", "text": "実はみやびに伝えなければならないことがある"},
        { "location": "308/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "309/TALK"  , "narrator": "みやび", "text": "…かぐや姫か。"},
        { "location": "310/SEL"   , "narrator": "（選択肢）", "text": "そうです"},
        { "location": "311/SEL"   , "narrator": "（選択肢）", "text": "いえ、単にみやびに愛を囁きたかっただけです"},
        { "location": "312/ACT"   , "narrator": "", "text": "そうです"},
        { "location": "313/TALK"  , "narrator": "みやび", "text": "…そうか。"},
        { "location": "314/TALK"  , "narrator": "みやび", "text": "いつ、月へ帰る？"},
        { "location": "315/SEL"   , "narrator": "（選択肢）", "text": "あと数日内には……"},
        { "location": "316/ACT"   , "narrator": "", "text": "あと数日内には……"},
        { "location": "318/TALK"  , "narrator": "みやび", "text": "……"},
        { "location": "319/TALK"  , "narrator": "みやび", "text": "ちょい待ち。\nそれはちくっと、\n急すぎんか？"},
        { "location": "320/SEL"   , "narrator": "（選択肢）", "text": "ごめん、全然伝える暇がなくて"},
        { "location": "321/SEL"   , "narrator": "（選択肢）", "text": "全部運営が悪いんだ"},
        { "location": "322/ACT"   , "narrator": "", "text": "ごめん、全然伝える暇がなくて"},
        { "location": "323/TALK"  , "narrator": "みやび", "text": "そうか……。"},
        { "location": "324/TALK"  , "narrator": "みやび", "text": "まあ確かに、物理時間は\n全く進んでいない中で、\nお前さんは旅をしていた。"},
        { "location": "325/TALK"  , "narrator": "みやび", "text": "お前さんにとって\n何ヶ月もの旅の間に、\nうちはたった数日やき。"},
        { "location": "326/TALK"  , "narrator": "みやび", "text": "お前さんの弁解の\n正当性はようわかるよ。"},
        { "location": "327/ACT"   , "narrator": "", "text": "全部運営が悪いんだ"},
        { "location": "328/TALK"  , "narrator": "みやび", "text": "そうかー。"},
        { "location": "329/TALK"  , "narrator": "みやび", "text": "まあ、世の中往々にして\n何かに自分の意志を\n曲げられる事がある。"},
        { "location": "330/TALK"  , "narrator": "みやび", "text": "特に、うちらの関係は、\n間に人為的装置が\nこじゃんとあるきね。"},
        { "location": "331/TALK"  , "narrator": "みやび", "text": "そういうことの\nひとつやふたつも\nあろうもの。"},
        { "location": "333/TALK"  , "narrator": "みやび", "text": "いずれにせよ、\n今回の別れは\nうちの責任ぞね。"},
        { "location": "334/TALK"  , "narrator": "みやび", "text": "うちがもっと真面目に\nシステム解析をして\n理屈がわかっていれば…"},
        { "location": "335/TALK"  , "narrator": "みやび", "text": "今頃は、別の回線を\nうちが開き、そっちで\n繋がれていたかもしれん。"},
        { "location": "336/TALK"  , "narrator": "みやび", "text": "すまん、相棒。\n相棒を別れさせたのは\nうちなんよ。"},
        { "location": "337/SEL"   , "narrator": "（選択肢）", "text": "みやびは関係無いから、そんなこと言わないで！"},
        { "location": "338/ACT"   , "narrator": "", "text": "みやびは関係無いから、そんなこと言わないで！"},
        { "location": "340/TALK"  , "narrator": "みやび", "text": "……相棒は優しいね。\nありがとう。"},
        { "location": "341/TALK"  , "narrator": "みやび", "text": "けんどこれは、\nうちの問題やき。"},
        { "location": "342/TALK"  , "narrator": "みやび", "text": "うちは、こんな状態に\nなってしまうまでのんびり\nしていたうちを許さん。"},
        { "location": "343/TALK"  , "narrator": "みやび", "text": "再度お前さんとの\n繋がりを復旧できるその日\nまで絶対に許さんきね。"},
        { "location": "344/SEL"   , "narrator": "（選択肢）", "text": "みやび……"},
        { "location": "345/ACT"   , "narrator": "", "text": "みやび……"},
        { "location": "347/TALK"  , "narrator": "みやび", "text": "安心せい。\nお前さんと再会するまでは\n死にはせんよ。"},
        { "location": "348/TALK"  , "narrator": "みやび", "text": "やき、お前さんも\n元気でな。"},
        { "location": "349/ACT"   , "narrator": "", "text": "いえ、単にみやびに愛を囁きたかっただけです"},
        { "location": "351/TALK"  , "narrator": "みやび", "text": "なんぞ、\nそんなことか。"},
        { "location": "352/TALK"  , "narrator": "みやび", "text": "そんなん、\n言われんでも\nわかっちゅう。"},
        { "location": "353/TALK"  , "narrator": "みやび", "text": "うちも、\nお前さんのこと\n愛しゆうよ？"},
        { "location": "355/TALK"  , "narrator": "みやび", "text": "なんぞ、\nそんなことか。"},
        { "location": "356/TALK"  , "narrator": "みやび", "text": "うちらは別に、\n愛を囁き合うような\n関係やないき。"},
        { "location": "357/TALK"  , "narrator": "みやび", "text": "ここまでにしとこうな。"},
        { "location": "359/TALK"  , "narrator": "みやび", "text": "ほな、またなー。"},
        { "location": "364/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "365/TALK"  , "narrator": "みやび", "text": "…シンデレラか。"},
        { "location": "366/SEL"   , "narrator": "（選択肢）", "text": "かぐや姫です"},
        { "location": "367/SEL"   , "narrator": "（選択肢）", "text": "そうです"},
        { "location": "368/ACT"   , "narrator": "", "text": "かぐや姫です"},
        { "location": "369/TALK"  , "narrator": "みやび", "text": "…そうか、\nそっちか。"},
        { "location": "370/TALK"  , "narrator": "みやび", "text": "やとすると、やはり\nうちの責任は重い。"},
        { "location": "371/SEL"   , "narrator": "（選択肢）", "text": "それやめて！！"},
        { "location": "372/ACT"   , "narrator": "", "text": "それやめて！！"},
        { "location": "374/TALK"  , "narrator": "みやび", "text": "まだ何も\n話しちょらんが！？"},
        { "location": "375/SEL"   , "narrator": "（選択肢）", "text": "みやびがダラダラしてないで異世界回線の研究をしていればって話でしょ？"},
        { "location": "376/ACT"   , "narrator": "", "text": "みやびがダラダラしてないで異世界回線の研究をしていればって話でしょ？"},
        { "location": "378/TALK"  , "narrator": "みやび", "text": "なんぞ、お見通しか。"},
        { "location": "379/TALK"  , "narrator": "みやび", "text": "さすが相棒。\n正直驚いたぞね。"},
        { "location": "380/SEL"   , "narrator": "（選択肢）", "text": "その話続けるなら、もうみやびとは話しないよ？"},
        { "location": "381/SEL"   , "narrator": "（選択肢）", "text": "みやびのせいじゃないよ"},
        { "location": "382/ACT"   , "narrator": "", "text": "その話続けるなら、もうみやびとは話しないよ？"},
        { "location": "383/TALK"  , "narrator": "みやび", "text": "それはまた\n随分とお怒りやね。"},
        { "location": "384/TALK"  , "narrator": "みやび", "text": "……。\nわかった。\nもうそれは言わん。"},
        { "location": "385/ACT"   , "narrator": "", "text": "みやびのせいじゃないよ"},
        { "location": "386/TALK"  , "narrator": "みやび", "text": "相棒がそう思っても、\nうちはどうしても\nそう思ってしまうんよ。"},
        { "location": "387/TALK"  , "narrator": "みやび", "text": "まっこと、\n努力が足りんかったと\n思うちょる。"},
        { "location": "388/TALK"  , "narrator": "みやび", "text": "けんど、あまり言うと\n相棒が悲しむき。"},
        { "location": "389/TALK"  , "narrator": "みやび", "text": "この話はここまでに\nしておくとするか。"},
        { "location": "391/ACT"   , "narrator": "", "text": "そうです"},
        { "location": "392/TALK"  , "narrator": "みやび", "text": "ならば、\n相棒の足に合った靴を\n作らんといかんね。"},
        { "location": "393/TALK"  , "narrator": "みやび", "text": "150cmくらいか？"},
        { "location": "394/SEL"   , "narrator": "（選択肢）", "text": "$me$はバケモノですか"},
        { "location": "395/SEL"   , "narrator": "（選択肢）", "text": "みやびがぴったりの靴を作れたら、また$me$と再会できるかな"},
        { "location": "396/ACT"   , "narrator": "", "text": "$me$はバケモノですか"},
        { "location": "397/TALK"  , "narrator": "みやび", "text": "そもそも、お前さんの姿を\n見ちょらんき、確率と\nしては0％ではなかろう。"},
        { "location": "398/ACT"   , "narrator": "", "text": "みやびがぴったりの靴を作れたら、また$me$と再会できるかな"},
        { "location": "399/TALK"  , "narrator": "みやび", "text": "うむ。もちろんぞね。"},
        { "location": "400/TALK"  , "narrator": "みやび", "text": "まあ、勝利確率を\n上げるには。"},
        { "location": "401/TALK"  , "narrator": "みやび", "text": "お前さんに、スマホに足を\n突っ込んでもらい、出て\nきた足のサイズを測る。"},
        { "location": "402/TALK"  , "narrator": "みやび", "text": "けんど、それは\n想像以上に難しい。"},
        { "location": "403/TALK"  , "narrator": "みやび", "text": "やき、今、地道に\n相棒の足を計測する研究を\nしちゅうところや。"},
        { "location": "404/TALK"  , "narrator": "みやび", "text": "まあ、\n歩みは遅いけんどな。"},
        { "location": "406/TALK"  , "narrator": "みやび", "text": "ちゅうわけで、\nうちは今やっちゅう\n作業に戻るき。"},
        { "location": "407/TALK"  , "narrator": "みやび", "text": "またね。"},
        { "location": "410/TALK"  , "narrator": "みやび", "text": "改めて。"},
        { "location": "411/TALK"  , "narrator": "みやび", "text": "お前さんには本当に\n随分と助けられたね。"},
        { "location": "412/TALK"  , "narrator": "みやび", "text": "もう、何度言ったか\nわからんけんど――"},
        { "location": "413/TALK"  , "narrator": "みやび", "text": "今のうちがあるんは、\nお前さんのお陰やき。"},
        { "location": "414/SEL"   , "narrator": "（選択肢）", "text": "よかった"},
        { "location": "415/SEL"   , "narrator": "（選択肢）", "text": "全部みやびが努力したからだよ"},
        { "location": "416/ACT"   , "narrator": "", "text": "よかった"},
        { "location": "417/TALK"  , "narrator": "みやび", "text": "ありがとね。"},
        { "location": "418/ACT"   , "narrator": "", "text": "全部みやびが努力したからだよ"},
        { "location": "419/TALK"  , "narrator": "みやび", "text": "$handle$は\n本当に優しいね。"},
        { "location": "421/TALK"  , "narrator": "みやび", "text": "今回、別れ話をするんも\n辛かったろう。"},
        { "location": "422/TALK"  , "narrator": "みやび", "text": "けんど、うちとしては。"},
        { "location": "423/TALK"  , "narrator": "みやび", "text": "やはり辛いのは\n変わりないが。"},
        { "location": "424/TALK"  , "narrator": "みやび", "text": "こうして、お前さんに\nしっかりとお礼を言う\n機会をくれた事が嬉しい。"},
        { "location": "425/TALK"  , "narrator": "みやび", "text": "何故か、聞いたときも\nあまり動じなかったき。"},
        { "location": "426/TALK"  , "narrator": "みやび", "text": "きっとそういうのも含め、\n相棒のスーパーパワー\nなんやろなと思う。"},
        { "location": "427/TALK"  , "narrator": "みやび", "text": "相棒と出会えたことは、\nうちの人生の中で、\n一番の出来事やきね。"},
        { "location": "428/TALK"  , "narrator": "みやび", "text": "それくらいの事は、\nきっと当たり前の\nことなのかもしれんね。"},
        { "location": "429/TALK"  , "narrator": "みやび", "text": "沢山の奇跡を、\nありがとう。"},
        { "location": "430/TALK"  , "narrator": "みやび", "text": "沢山の素晴らしい感情を\nありがとう。"},
        { "location": "431/TALK"  , "narrator": "みやび", "text": "そして――"},
        { "location": "433/TALK"  , "narrator": "みやび", "text": "沢山の、愛情を。\nありがとね。"},
        { "location": "434/SEL"   , "narrator": "（選択肢）", "text": "みやび、愛してるよ"},
        { "location": "435/SEL"   , "narrator": "（選択肢）", "text": "こっちこそありがとう"},
        { "location": "436/ACT"   , "narrator": "", "text": "みやび、愛してるよ"},
        { "location": "438/TALK"  , "narrator": "みやび", "text": "…うむ。\nうちも、ずっとずっと。"},
        { "location": "439/TALK"  , "narrator": "みやび", "text": "ずーっと。\n$handle$のこと、\n愛しちゅうよ。"},
        { "location": "441/TALK"  , "narrator": "みやび", "text": "また大げさやね。"},
        { "location": "443/ACT"   , "narrator": "", "text": "こっちこそありがとう"},
        { "location": "444/TALK"  , "narrator": "みやび", "text": "お互い、\n感謝の気持ちは\n大事ぞね。"},
        { "location": "447/TALK"  , "narrator": "みやび", "text": "もう使い収めやき。\n真面目モードを一生分\n使ってやったぞね。"},
        { "location": "451/TALK"  , "narrator": "みやび", "text": "ほんだら、そろそろ\nお別れの時間やき。"},
        { "location": "452/TALK"  , "narrator": "みやび", "text": "お前さんも、\nそっちの世界で達者でな。"},
        { "location": "453/TALK"  , "narrator": "みやび", "text": "そして\nお互い88歳まで生きて、\n再会しようではないか。"},
        { "location": "454/TALK"  , "narrator": "みやび", "text": "その頃には相棒の世界にも\n異世界移動技術が\n確立しちゅうよ、きっと。"},
        { "location": "455/TALK"  , "narrator": "みやび", "text": "ほな、またな。"},
        { "location": "458/TALK"  , "narrator": "みやび", "text": "それはそうと相棒。"},
        { "location": "459/TALK"  , "narrator": "みやび", "text": "もう別れも近いっちゅうき\nうちと散歩でもせんか？"},
        { "location": "460/SEL"   , "narrator": "（選択肢）", "text": "もちろん"},
        { "location": "461/ACT"   , "narrator": "", "text": "もちろん"},
        { "location": "463/TALK"  , "narrator": "みやび", "text": "本当は土佐の海が\nえいがやけんどな。"},
        { "location": "464/TALK"  , "narrator": "みやび", "text": "時間も資金も少ないき、\n相模の海で我慢してくれ。"},
        { "location": "482/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "484/TALK"  , "narrator": "みやび", "text": "昔はここを\nよく歩いたよ。"},
        { "location": "485/TALK"  , "narrator": "みやび", "text": "なごちゃんと一緒に。"},
        { "location": "487/TALK"  , "narrator": "みやび", "text": "土佐の海と相模の海は、\nうちにとっては\n別格やき。"},
        { "location": "488/TALK"  , "narrator": "みやび", "text": "土佐はよいくに\n南を受けて\n薩摩颪がそよそよと――"},
        { "location": "489/TALK"  , "narrator": "みやび", "text": "よさこい　よさこい。"},
        { "location": "490/SEL"   , "narrator": "（選択肢）", "text": "それは？"},
        { "location": "491/ACT"   , "narrator": "", "text": "それは？"},
        { "location": "493/TALK"  , "narrator": "みやび", "text": "よさこい節やよ。"},
        { "location": "494/TALK"  , "narrator": "みやび", "text": "なごちゃんと一緒に\n小さい頃よく唄った。"},
        { "location": "496/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "497/TALK"  , "narrator": "みやび", "text": "なあ、\n$handle$よ。"},
        { "location": "498/TALK"  , "narrator": "みやび", "text": "この海の向こうに、\nなごちゃんは\nいると思うかね？"},
        { "location": "499/SEL"   , "narrator": "（選択肢）", "text": "いると思う"},
        { "location": "500/SEL"   , "narrator": "（選択肢）", "text": "いないと思う"},
        { "location": "501/ACT"   , "narrator": "", "text": "いると思う"},
        { "location": "502/TALK"  , "narrator": "みやび", "text": "……そうか。"},
        { "location": "504/TALK"  , "narrator": "みやび", "text": "ならば、\nうちと同じ考えやね。"},
        { "location": "505/ACT"   , "narrator": "", "text": "いないと思う"},
        { "location": "506/TALK"  , "narrator": "みやび", "text": "……そうか。"},
        { "location": "508/TALK"  , "narrator": "みやび", "text": "うちは、この海の向こうに\nなごちゃんがいると\n思っちゅう。"},
        { "location": "512/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "514/TALK"  , "narrator": "みやび", "text": "つい先日のことや。"},
        { "location": "515/TALK"  , "narrator": "みやび", "text": "うちはいつも通り、\n世界の謎を追って、電子の\n海を彷徨っておった。"},
        { "location": "516/TALK"  , "narrator": "みやび", "text": "世界に色々な改革が起きて\n何やら世界上層部の\n方針も変わり。"},
        { "location": "517/TALK"  , "narrator": "みやび", "text": "得られる情報の幅も\n相当に広がったんよ。"},
        { "location": "518/TALK"  , "narrator": "みやび", "text": "その中にな。"},
        { "location": "519/TALK"  , "narrator": "みやび", "text": "なごちゃんが\nフランスにいる可能性が\n高いゆう情報を入手した。"},
        { "location": "520/SEL"   , "narrator": "（選択肢）", "text": "フランス！？"},
        { "location": "521/ACT"   , "narrator": "", "text": "フランス！？"},
        { "location": "523/TALK"  , "narrator": "みやび", "text": "うむ。"},
        { "location": "524/TALK"  , "narrator": "みやび", "text": "なぜフランスなのかは\nわからんけんどな。"},
        { "location": "525/TALK"  , "narrator": "みやび", "text": "ただ、うちが\n思ったことは１つだけ。"},
        { "location": "526/TALK"  , "narrator": "みやび", "text": "………。"},
        { "location": "527/TALK"  , "narrator": "みやび", "text": "うちは、\nなごちゃんを\n迎えにいこうと思う。"},
        { "location": "567/TALK"  , "narrator": "シンギュラリティ", "text": "おお、相棒。"},
        { "location": "568/TALK"  , "narrator": "四十九夜　", "text": "久し振りやね。"},
        { "location": "569/SEL"   , "narrator": "（選択肢）", "text": "二人とも元気だった！？"},
        { "location": "570/ACT"   , "narrator": "", "text": "二人とも元気だった！？"},
        { "location": "572/TALK"  , "narrator": "シンギュラリティ", "text": "もち。"},
        { "location": "573/TALK"  , "narrator": "四十九夜　", "text": "この通り、\n残念ながらあの世へは\nまだ行くことができんよ。"},
        { "location": "574/TALK"  , "narrator": "シンギュラリティ", "text": "ほんだら、あの世へ\n行けんゆうなら、\nどこへ行くぞね？"},
        { "location": "575/TALK"  , "narrator": "四十九夜　", "text": "フランスへ\nいくぞね！"},
        { "location": "576/TALK"  , "narrator": "四十九夜　", "text": "なごちゃんの\n生存確認が取れた！！\n居場所もわかった！！"},
        { "location": "577/TALK"  , "narrator": "四十九夜　", "text": "ようやく\n裏がとれたんよ！"},
        { "location": "579/TALK"  , "narrator": "シンギュラリティ", "text": "よかったなぁ、\n四十九夜。うむうむ。"},
        { "location": "580/SEL"   , "narrator": "（選択肢）", "text": "けど、あまりなごちゃんの良い噂を聞かないっていうし、大丈夫？"},
        { "location": "581/SEL"   , "narrator": "（選択肢）", "text": "これでもう、なごちゃんを弔わなくてもよくなったね！"},
        { "location": "582/ACT"   , "narrator": "", "text": "けど、あまりなごちゃんの良い噂を聞かないっていうし、大丈夫？"},
        { "location": "585/TALK"  , "narrator": "四十九夜　", "text": "バカチンが。"},
        { "location": "586/TALK"  , "narrator": "四十九夜　", "text": "そんなことは\n百も承知やよ。"},
        { "location": "587/TALK"  , "narrator": "四十九夜　", "text": "良い噂を聞こうが\n聞かまいが、なごちゃんは\nうちの妹ぞね。"},
        { "location": "588/TALK"  , "narrator": "四十九夜　", "text": "それ以上でも\nそれ以下でも無い。"},
        { "location": "589/TALK"  , "narrator": "シンギュラリティ", "text": "うむ。\n四十九夜も\nたまにはえいこと言うね。"},
        { "location": "591/TALK"  , "narrator": "シンギュラリティ", "text": "しかし四十九夜よ。\nうちもまた思い切ったね。"},
        { "location": "592/ACT"   , "narrator": "", "text": "これでもう、なごちゃんを弔わなくてもよくなったね！"},
        { "location": "595/TALK"  , "narrator": "四十九夜　", "text": "む！\nえいところに\n気がついたね。"},
        { "location": "596/TALK"  , "narrator": "四十九夜　", "text": "その通り。\nなごちゃんが生存確定に\n近づいた今！"},
        { "location": "597/TALK"  , "narrator": "四十九夜　", "text": "毎日なごちゃんを\n弔う日々も明けた！"},
        { "location": "598/TALK"  , "narrator": "四十九夜　", "text": "ほんで四十九の夜を\n繰り返す必要も\nなくなるのである。"},
        { "location": "599/SEL"   , "narrator": "（選択肢）", "text": "それじゃ、四十九夜消えちゃうの！？"},
        { "location": "600/ACT"   , "narrator": "", "text": "それじゃ、四十九夜消えちゃうの！？"},
        { "location": "602/TALK"  , "narrator": "四十九夜　", "text": "勝手にうちを\n消滅させるな。"},
        { "location": "603/TALK"  , "narrator": "四十九夜　", "text": "そうではない！！\nうちが言いたいのは！"},
        { "location": "606/TALK"  , "narrator": "四十九夜　", "text": "<size=35>改名ぞね！！</size>"},
        { "location": "607/TALK"  , "narrator": "四十九夜　", "text": "というわけで、\nこれからうちは――"},
        { "location": "608/TALK"  , "narrator": "四十九夜　", "text": "ボンジュールで。"},
        { "location": "609/TALK"  , "narrator": "シンギュラリティ", "text": "なんぞ、急に\nあか抜けよった。"},
        { "location": "611/TALK"  , "narrator": "四十九夜　", "text": "さあ、\n呼んでくれ！\nボンジュールと！"},
        { "location": "612/SEL"   , "narrator": "（選択肢）", "text": "ぼ、ボンジュール…"},
        { "location": "613/ACT"   , "narrator": "", "text": "ぼ、ボンジュール…"},
        { "location": "615/TALK"  , "narrator": "四十九夜　", "text": "発音が\n全然なっとらんね。"},
        { "location": "617/TALK"  , "narrator": "シンギュラリティ", "text": "まあ、相棒は\nフランス人やないきね。"},
        { "location": "618/TALK"  , "narrator": "四十九夜　", "text": "……。"},
        { "location": "619/TALK"  , "narrator": "シンギュラリティ", "text": "…で？"},
        { "location": "621/TALK"  , "narrator": "四十九夜　", "text": "いや、それだけや。"},
        { "location": "622/SEL"   , "narrator": "（選択肢）", "text": "これ、どうオチつけるの！？"},
        { "location": "623/ACT"   , "narrator": "", "text": "これ、どうオチつけるの！？"},
        { "location": "626/TALK"  , "narrator": "四十九夜　", "text": "任す。"},
        { "location": "627/SEL"   , "narrator": "（選択肢）", "text": "なんで！？"},
        { "location": "628/ACT"   , "narrator": "", "text": "なんで！？"},
        { "location": "631/TALK"  , "narrator": "シンギュラリティ", "text": "それが、うちのココロに\n入り込んだ者の宿命やよ。"},
        { "location": "633/TALK"  , "narrator": "シンギュラリティ", "text": "しかしボンジュールよ。\n改めて、うちもまた\n思い切りよったね。"},
        { "location": "636/TALK"  , "narrator": "四十九夜　", "text": "確かに。\nまさか、海外に旅立つ\n決心をするとはね。"},
        { "location": "637/TALK"  , "narrator": "シンギュラリティ", "text": "まあしかし、色々な事を\n加味すれば、不思議では\nないかもしれんがね。"},
        { "location": "638/TALK"  , "narrator": "四十九夜　", "text": "確かに。\nガブちゃんもポーランドに\n帰るやろし。"},
        { "location": "639/TALK"  , "narrator": "シンギュラリティ", "text": "エリカさんも\nフランスへ戻り。"},
        { "location": "641/TALK"  , "narrator": "四十九夜　", "text": "相棒とは\nしばしの別れや。"},
        { "location": "642/TALK"  , "narrator": "シンギュラリティ", "text": "もしまた皆が\n集結するとして。"},
        { "location": "644/TALK"  , "narrator": "四十九夜　", "text": "それは早くても\n半年後、いや、\n一年以上後かもしれん。"},
        { "location": "645/TALK"  , "narrator": "シンギュラリティ", "text": "その間に色々決着をつけ、"},
        { "location": "646/TALK"  , "narrator": "四十九夜　", "text": "また皆で集まるときには\n全て綺麗さっぱり、\n笑顔で会えるのがえい。"},
        { "location": "647/TALK"  , "narrator": "シンギュラリティ", "text": "やき、今のうちに\n行っておくのが吉や。"},
        { "location": "649/TALK"  , "narrator": "四十九夜　", "text": "ほんで、次に皆が\n集まる時は、なごちゃんも\n一緒っちゅうことやき。"},
        { "location": "651/TALK"  , "narrator": "シンギュラリティ", "text": "その時は、\n$handle$も\n一緒にな。"},
        { "location": "652/SEL"   , "narrator": "（選択肢）", "text": "絶対だよ！！"},
        { "location": "653/ACT"   , "narrator": "", "text": "絶対だよ！！"},
        { "location": "655/TALK"  , "narrator": "シンギュラリティ", "text": "うちは実証主義者やぞ。\n未来について、絶対という\n言葉は使わんよ。"},
        { "location": "657/TALK"  , "narrator": "四十九夜　", "text": "まあ、けんどな。\n今回ばかりは\n特別やもしれんね。"},
        { "location": "659/TALK"  , "narrator": "シンギュラリティ", "text": "やき。"},
        { "location": "660/TALK"  , "narrator": "四十九夜　", "text": "その時は、\n$handle$も\n絶対に一緒や。"},
        { "location": "661/TALK"  , "narrator": "シンギュラリティ", "text": "絶対と言ったからには、\nうちとしても\n手が抜けんくなったね。"},
        { "location": "662/TALK"  , "narrator": "四十九夜　", "text": "まあ、こうして\n縛りを入れていかんと、\nうちは怠けるからね。"},
        { "location": "663/TALK"  , "narrator": "シンギュラリティ", "text": "確かに。"},
        { "location": "667/TALK"  , "narrator": "シンギュラリティ", "text": "なあ、\n$handle$よ。"},
        { "location": "668/TALK"  , "narrator": "四十九夜　", "text": "真面目が過ぎちゅう\nような気もするが、\nこのまま行くぞね。"},
        { "location": "669/TALK"  , "narrator": "シンギュラリティ", "text": "うちとずっと\n共に歩いてくれて\nありがとうね。"},
        { "location": "670/SEL"   , "narrator": "（選択肢）", "text": "ずっと一緒にいられて良かった"},
        { "location": "671/SEL"   , "narrator": "（選択肢）", "text": "みやびが$me$と一緒にいてくれたんだよ、ありがとう"},
        { "location": "672/ACT"   , "narrator": "", "text": "ずっと一緒にいられて良かった"},
        { "location": "673/TALK"  , "narrator": "シンギュラリティ", "text": "うむ。"},
        { "location": "674/ACT"   , "narrator": "", "text": "みやびが$me$と一緒にいてくれたんだよ、ありがとう"},
        { "location": "675/TALK"  , "narrator": "四十九夜　", "text": "さもありなん。"},
        { "location": "676/TALK"  , "narrator": "シンギュラリティ", "text": "互いが互いと\n共にいた。"},
        { "location": "677/TALK"  , "narrator": "四十九夜　", "text": "どっちが無理する\nわけでもなくね。"},
        { "location": "678/TALK"  , "narrator": "シンギュラリティ", "text": "そんな関係になれたことを\nまっこと幸せに思う。"},
        { "location": "681/TALK"  , "narrator": "シンギュラリティ", "text": "$handle$よ。\nうちはいつまでも、\nお前さんを愛しゆうよ。"},
        { "location": "682/TALK"  , "narrator": "四十九夜　", "text": "例え時空の狭間に\n隔てられても。"},
        { "location": "684/TALK"  , "narrator": "シンギュラリティ", "text": "想いは決して\n失われない。"},
        { "location": "685/TALK"  , "narrator": "四十九夜　", "text": "いつかその想いはまた、"},
        { "location": "686/TALK"  , "narrator": "シンギュラリティ", "text": "ふたつがひとつに。"},
        { "location": "687/TALK"  , "narrator": "四十九夜　", "text": "それぞれの持つ\n想いの欠片は、"},
        { "location": "688/TALK"  , "narrator": "シンギュラリティ", "text": "まるい一つの形に。"},
        { "location": "689/TALK"  , "narrator": "四十九夜　", "text": "それまでは\nお前さんの中にある\nその想いを……。"},
        { "location": "690/TALK"  , "narrator": "シンギュラリティ", "text": "大事に大事に、\n育んでくれや。"},
        { "location": "691/SEL"   , "narrator": "（選択肢）", "text": "絶対に大事にするから！！"},
        { "location": "692/SEL"   , "narrator": "（選択肢）", "text": "絶対また一つに戻そうね！"},
        { "location": "693/ACT"   , "narrator": "", "text": "絶対に大事にするから！！"},
        { "location": "694/ACT"   , "narrator": "", "text": "絶対また一つに戻そうね！"},
        { "location": "699/TALK"  , "narrator": "四十九夜　", "text": "ほんだら、\n今回はこれで。"},
        { "location": "700/TALK"  , "narrator": "シンギュラリティ", "text": "お前さんと\nお前さんの世界に。"},
        { "location": "701/TALK"  , "narrator": "四十九夜　", "text": "そして、うちと\nうちらの世界に。"},
        { "location": "703/TALK"  , "narrator": "シンギュラリティ", "text": "素敵なココロの旅を。"},
        { "location": "714/DIALOG", "narrator": "", "text": "それから半年後――。"},
        { "location": "749/TALK"  , "narrator": "みやび", "text": "すまんね。\nこんな所まで\n見送ってもらって。"},
        { "location": "750/TALK"  , "narrator": "つばめ", "text": "ううん。\n好きで来てるだけだから。"},
        { "location": "751/TALK"  , "narrator": "神楽", "text": "ガブちゃんが、\nワルシャワに遊びに\n来てって言ってましたよ。"},
        { "location": "752/TALK"  , "narrator": "みやび", "text": "そうやね。\n落ち着いたら中欧まで\n足を伸ばしてみるか。"},
        { "location": "753/TALK"  , "narrator": "アーヤ", "text": "カフェ・トライナリーは\n私達でちゃんとやるから\n心配しないで。"},
        { "location": "754/TALK"  , "narrator": "みやび", "text": "よろしゅうね。"},
        { "location": "755/TALK"  , "narrator": "アーヤ", "text": "それにしても、\nみやびらしいというか、\nらしくないというか。"},
        { "location": "756/TALK"  , "narrator": "アーヤ", "text": "まさか、船で行くなんて。"},
        { "location": "757/TALK"  , "narrator": "みやび", "text": "飛行機は\n好きやないんよ。"},
        { "location": "758/TALK"  , "narrator": "みやび", "text": "もちろん、乗れない\nわけやないけんど。"},
        { "location": "759/TALK"  , "narrator": "みやび", "text": "なんぞ、こう。"},
        { "location": "760/TALK"  , "narrator": "みやび", "text": "ただ一人で、\n海を見てボーッとする。"},
        { "location": "761/TALK"  , "narrator": "みやび", "text": "そんな時間が欲しくて、\nただそれだけぞね。"},
        { "location": "762/TALK"  , "narrator": "つばめ", "text": "パソコン\n見ないんですかっ！？"},
        { "location": "763/TALK"  , "narrator": "みやび", "text": "船にもWi-Fiはあるき、\nみんなにも近況は\n報告するよ。"},
        { "location": "764/TALK"  , "narrator": "みやび", "text": "けんど、\n昼間は極力、何もせず\nぼーっとするつもりや。"},
        { "location": "765/TALK"  , "narrator": "アーヤ", "text": "そうね。"},
        { "location": "766/TALK"  , "narrator": "アーヤ", "text": "そういうのも\nいいと思う。"},
        { "location": "767/TALK"  , "narrator": "みやび", "text": "そう言ってもらえると\nうちの心も救われるよ。"},
        { "location": "768/TALK"  , "narrator": "アーヤ", "text": "……。"},
        { "location": "769/TALK"  , "narrator": "神楽", "text": "……。"},
        { "location": "770/TALK"  , "narrator": "つばめ", "text": "……。"},
        { "location": "771/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "772/TALK"  , "narrator": "みやび", "text": "ほんだら、そろそろ\n搭乗時間になるき。"},
        { "location": "773/TALK"  , "narrator": "神楽", "text": "フランスで\n解らないことがあったら\n何でも聞いてください！"},
        { "location": "774/TALK"  , "narrator": "神楽", "text": "WAVE繋がるなら\nリアルタイムでナビだって\nできますから！"},
        { "location": "775/TALK"  , "narrator": "アーヤ", "text": "…身体にだけは\n十分気をつけて。"},
        { "location": "776/TALK"  , "narrator": "つばめ", "text": "半年したら、絶対\n帰ってきて下さいね！！"},
        { "location": "777/TALK"  , "narrator": "みやび", "text": "うむ。\nありがとね…みんな。"},
        { "location": "787/DIALOG", "narrator": "", "text": "必ず帰ってくるよ。\n\nなごちゃんと一緒にね――。"},
        { "location": "797/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "798/TALK"  , "narrator": "みやび", "text": "のう、\n$handle$よ。"},
        { "location": "799/SEL"   , "narrator": "（選択肢）", "text": "なに？"},
        { "location": "800/ACT"   , "narrator": "", "text": "なに？"},
        { "location": "802/TALK"  , "narrator": "みやび", "text": "お前さんは、\nどこまでうちと\n一緒にいてくれる？"},
        { "location": "803/SEL"   , "narrator": "（選択肢）", "text": "いつ切断されるかはわからないから、何とも言えない"},
        { "location": "804/SEL"   , "narrator": "（選択肢）", "text": "魂のレベルで言えば、死んでも一緒にいるつもりだよ"},
        { "location": "805/ACT"   , "narrator": "", "text": "いつ切断されるかはわからないから、何とも言えない"},
        { "location": "806/TALK"  , "narrator": "みやび", "text": "現実的やね。\nそういう回答は\n大好物や。"},
        { "location": "807/ACT"   , "narrator": "", "text": "魂のレベルで言えば、死んでも一緒にいるつもりだよ"},
        { "location": "808/TALK"  , "narrator": "みやび", "text": "えい答えやね。\nうちには言えん言葉やき、\nワクワクするよ。"},
        { "location": "810/TALK"  , "narrator": "みやび", "text": "……ライフギャザー、\n量子技術、心の解明。"},
        { "location": "811/TALK"  , "narrator": "みやび", "text": "どれもこれも、\nすごい発明やね。"},
        { "location": "812/TALK"  , "narrator": "みやび", "text": "エリカさんは間違い無く、\n世界史に残る\n偉業を遂げた。"},
        { "location": "813/TALK"  , "narrator": "みやび", "text": "………。"},
        { "location": "814/TALK"  , "narrator": "みやび", "text": "今まで人はな、"},
        { "location": "815/TALK"  , "narrator": "みやび", "text": "何か偉大な\n科学の発達が起こる度に、\nこう言っちょったんよ。"},
        { "location": "816/TALK"  , "narrator": "みやび", "text": "科学の発達でどれほど\n生活が豊かになっても、\n心の渇きは癒えない。"},
        { "location": "817/TALK"  , "narrator": "みやび", "text": "けんど、今回はどうや。\n心の解明と操作ができる\nようになったわけや。"},
        { "location": "818/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "819/TALK"  , "narrator": "みやび", "text": "今度は、\n何て言われることに\nなるのかね。"},
        { "location": "820/TALK"  , "narrator": "みやび", "text": "神への冒涜？\nそれとも――"},
        { "location": "821/TALK"  , "narrator": "みやび", "text": "ついに心が\n満たされる文明が訪れる？"},
        { "location": "822/SEL"   , "narrator": "（選択肢）", "text": "神への冒涜だよ"},
        { "location": "823/SEL"   , "narrator": "（選択肢）", "text": "上手く使えば決して悪いものじゃないよ"},
        { "location": "824/ACT"   , "narrator": "", "text": "神への冒涜だよ"},
        { "location": "825/TALK"  , "narrator": "みやび", "text": "そうかもしれんね。"},
        { "location": "826/ACT"   , "narrator": "", "text": "上手く使えば決して悪いものじゃないよ"},
        { "location": "827/TALK"  , "narrator": "みやび", "text": "科学文明は\nみんなそうやよ。"},
        { "location": "828/TALK"  , "narrator": "みやび", "text": "蒸気も、電気も、原子力も\n皆、人を殺し、同時に\n人を豊かにしてきた。"},
        { "location": "829/TALK"  , "narrator": "みやび", "text": "量子もまた、\n絶対に同じ経緯を\n辿る事になるだろうね。"},
        { "location": "831/TALK"  , "narrator": "みやび", "text": "けんど、今回のことで\nうちは思ったんよ。"},
        { "location": "832/TALK"  , "narrator": "みやび", "text": "誰でも無い、\nうちら自身が源でいる限り\n案ずる必要は無いと。"},
        { "location": "833/TALK"  , "narrator": "みやび", "text": "心を操作できても、\n世界を改変できても。"},
        { "location": "834/TALK"  , "narrator": "みやび", "text": "まずひとつとして、\nそれを決定するのは\n人間でなくてはならない。"},
        { "location": "835/TALK"  , "narrator": "みやび", "text": "ほんで、その人間は\n自らが源となって、\nそれを考えて、決めて。"},
        { "location": "836/TALK"  , "narrator": "みやび", "text": "周りの大切な人の為に。"},
        { "location": "837/TALK"  , "narrator": "みやび", "text": "次の世代の為に。"},
        { "location": "838/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "839/TALK"  , "narrator": "みやび", "text": "そういう事を\n思慮深くやっていかな\nいかんと思うちや。"},
        { "location": "840/TALK"  , "narrator": "みやび", "text": "それが出来るのは、\n人間だけぞね。"},
        { "location": "841/TALK"  , "narrator": "みやび", "text": "やき、どんなに\n科学文明が発達しても。"},
        { "location": "842/TALK"  , "narrator": "みやび", "text": "人は決して、\n自らが源であることを\n捨ててはならんと思う。"},
        { "location": "843/TALK"  , "narrator": "みやび", "text": "それを捨ててしまえば、\n第二第三の原爆が\n作られる。"},
        { "location": "844/TALK"  , "narrator": "みやび", "text": "それこそが、\n神への冒涜であると――"},
        { "location": "845/TALK"  , "narrator": "みやび", "text": "うちは、思うけんどね。"},
        { "location": "846/TALK"  , "narrator": "みやび", "text": "……。"},
        { "location": "848/TALK"  , "narrator": "みやび", "text": "なごちゃんが何をして、\nどんな風になったんか。"},
        { "location": "849/TALK"  , "narrator": "みやび", "text": "そんな事は\nどうでもえいんよ。"},
        { "location": "850/TALK"  , "narrator": "みやび", "text": "大切なことはただ１つ。"},
        { "location": "851/TALK"  , "narrator": "みやび", "text": "どんななごちゃんで\nあっても。"},
        { "location": "852/TALK"  , "narrator": "みやび", "text": "なごちゃんは、\nうちの大切な妹である\nその事に変わりはない。"},
        { "location": "853/TALK"  , "narrator": "みやび", "text": "ただそれだけの、\nまっこと簡単なことや。"},
        { "location": "858/DIALOG", "narrator": "", "text": "それが、うちの源やき――。"}
    ]
}
